module

public import Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms.ExceptionalGraph.Parabolics
public import Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms.OuterOrder

/-!
# Cyclicity of the outer group of the actual Sp₄(F)

The exceptional automorphism is constructed on symplectic matrices in
`ExceptionalGraph.Construction`; it squares to entrywise Frobenius and
exchanges the two distinct parabolic types by `ExceptionalGraph.Parabolics`.
Every automorphism of the finite coefficient field is a power of Frobenius,
so its action on Sp₄(F) is an even power of the exceptional automorphism.

Assume explicitly that every diagram-preserving automorphism is inner times
an entrywise field automorphism. The kernel of the action of Out(Sp₄(F)) on
the two parabolic classes is then contained in the cyclic subgroup generated
by the exceptional outer class. That class acts nontrivially on the two
types, so the entire outer group is generated by it.

The semilinear coverage premise remains explicit; this module discharges
the exceptional-map and cyclic-extension parts of the argument.

Source: GLS3, Theorems 2.5.1 and 2.5.12(e),
`refs/KGroup/GLS3/chapter2.tex`; Aschbacher--Smith, Proposition 1.3.4,
printed p.511 of `refs/quasithin.pdf`.
-/

@[expose] public section

namespace Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms.ExceptionalGraph
variable {F : Type*} [Field F] [Finite F] [CharP F 2]

private theorem finiteFieldAut_eq_frobenius_pow (σ : F ≃+* F) :
    ∃ k : ℕ, σ = frobeniusEquiv F 2 ^ k := by
  let := ZMod.algebra F 2
  let σ' : F ≃ₐ[ZMod 2] F := AlgEquiv.ofRingEquiv (f := σ) (fun t =>
    DFunLike.congr_fun (Subsingleton.elim
      (σ.toRingHom.comp (algebraMap (ZMod 2) F))
      (algebraMap (ZMod 2) F)) t)
  obtain ⟨k, hk⟩ :=
    (FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow (ZMod 2) F).surjective σ'
  let forget : (F ≃ₐ[ZMod 2] F) →* (F ≃+* F) := {
    toFun := AlgEquiv.toRingEquiv
    map_one' := rfl
    map_mul' := fun _ _ => rfl }
  have hf : forget (FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) F) =
      frobeniusEquiv F 2 := by
    apply RingEquiv.ext
    intro t
    change t ^ Fintype.card (ZMod 2) = t ^ 2
    rw [ZMod.card]
  have hσ : forget σ' = σ := rfl
  refine ⟨k.val, ?_⟩
  rw [← hσ, ← hk, map_pow, hf]

/-- Every entrywise field automorphism is an even power of the exceptional map. -/
lemma fieldAutomorphism_eq_graphAut_pow (σ : F ≃+* F) :
    ∃ k : ℕ, fieldAutomorphism σ = graphAut ^ (2*k) := by
  obtain ⟨k, rfl⟩ := finiteFieldAut_eq_frobenius_pow σ
  refine ⟨k, ?_⟩
  change fieldAutomorphismHom (frobeniusEquiv F 2 ^ k) = _
  rw [map_pow, pow_mul, graphAut_square]
  rfl

private lemma eq_one_or_eq_of_card_le_two {G : Type*} [Group G] [Finite G]
    (hc : Nat.card G ≤ 2) {t : G} (ht : t ≠ 1) (x : G) : x = 1 ∨ x = t := by
  classical
  let f : Bool → G := fun b => cond b t 1
  have hf : Function.Injective f := by
    intro a b hab
    cases a <;> cases b <;> simp_all [f]
  have hs := (hf.bijective_of_nat_card_le (by simpa using hc)).2
  obtain ⟨b, rfl⟩ := hs x
  cases b <;> simp [f]

/-- The exceptional outer class generates the whole actual outer group under semilinear coverage. -/
lemma outerGraph_zpowers_eq_top (hF : 2 < Nat.card F)
    (hclass : ∀ a : MulAut (Sp F), PreservesDiagram a →
      ∃ g : Sp F, ∃ σ : F ≃+* F, a = MulAut.conj g * fieldAutomorphism σ) :
    Subgroup.zpowers (QuotientGroup.mk' (MulAut.innerSubgroup (Sp F)) graphAut) = ⊤ := by
  let π : MulAut (Sp F) →* MulAut.Outer (Sp F) :=
    QuotientGroup.mk' (MulAut.innerSubgroup (Sp F))
  let t := π graphAut
  let ρ := outerDiagramAction hF
  have hk : ρ.ker ≤ Subgroup.zpowers t := by
    rw [show ρ.ker = (outerFieldHom (F := F)).range from outerDiagramAction_ker hF hclass]
    rintro _ ⟨σ, rfl⟩
    obtain ⟨k, hσ⟩ := fieldAutomorphism_eq_graphAut_pow σ
    change π (fieldAutomorphism σ) ∈ _
    rw [hσ, map_pow]
    exact Subgroup.npow_mem_zpowers t (2*k)
  have ht : ρ t ≠ 1 := by
    intro he
    apply graphAut_not_preservesDiagram (F := F)
    apply (mem_parabolicClassAction_ker_iff hF graphAut).mp
    exact he
  have hc : Nat.card (Equiv.Perm (parabolicClasses hF)) ≤ 2 := by
    let := Fintype.ofFinite (parabolicClasses hF)
    rw [Nat.card_eq_fintype_card, Fintype.card_perm]
    have hp : Fintype.card (parabolicClasses hF) ≤ 2 := by
      simpa only [Nat.card_eq_fintype_card] using card_parabolicClasses_le_two hF
    exact (Nat.factorial_le hp).trans (by decide)
  apply top_unique
  intro x _
  rcases eq_one_or_eq_of_card_le_two hc ht (ρ x) with hx | hx
  · exact hk hx
  · have hm : x * t⁻¹ ∈ ρ.ker := by
      change ρ (x * t⁻¹) = 1
      rw [map_mul, map_inv, hx, mul_inv_cancel]
    exact ((Subgroup.zpowers t).mul_mem_cancel_right
      ((Subgroup.zpowers t).inv_mem (Subgroup.mem_zpowers t))).mp (hk hm)

/-- Cyclicity of the actual outer group, conditional only on diagram-preserving coverage. -/
lemma outer_isCyclic (hF : 2 < Nat.card F)
    (hclass : ∀ a : MulAut (Sp F), PreservesDiagram a →
      ∃ g : Sp F, ∃ σ : F ≃+* F, a = MulAut.conj g * fieldAutomorphism σ) :
    IsCyclic (MulAut.Outer (Sp F)) :=
  isCyclic_iff_exists_zpowers_eq_top.mpr ⟨_, outerGraph_zpowers_eq_top hF hclass⟩

/-- The field-order formulation used for Sp₄(2ⁿ), with `n > 1`. -/
lemma outer_isCyclic_of_card {n : ℕ} (hcard : Nat.card F = 2^n) (hn : 1 < n)
    (hclass : ∀ a : MulAut (Sp F), PreservesDiagram a →
      ∃ g : Sp F, ∃ σ : F ≃+* F, a = MulAut.conj g * fieldAutomorphism σ) :
    IsCyclic (MulAut.Outer (Sp F)) := by
  apply outer_isCyclic (hclass := hclass)
  rw [hcard]
  exact (by norm_num : 2 = 2^1) ▸ Nat.pow_lt_pow_right (by decide : 1 < 2) hn

end Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms.ExceptionalGraph
