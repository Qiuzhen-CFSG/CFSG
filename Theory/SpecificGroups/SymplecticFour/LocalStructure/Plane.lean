module

public import Theory.SpecificGroups.SymplecticFour.LocalStructure.Plane.Extension
public import Theory.SpecificGroups.SymplecticFour.LocalStructure.Plane.CentralModule
public import Theory.SpecificGroups.SymplecticFour.LocalStructure.Plane.Commutator

/-!
# Plane-local structure in symplectic four-space

The determinant-one plane stabilizer maps onto SL₂ through restriction to the
plane. Its elementary abelian radical is identified with symmetric matrices,
with conjugation given by congruence. Over a finite field of characteristic two
and order greater than two, this radical is generated by its commutators with
the local group. Its central fixed subgroup consists of the alternating
matrices, and inverse Frobenius on the diagonal identifies the central quotient
with the literal natural SL₂ module.

`extension_spec` assembles these assertions for the explicit maps on the
published determinant kernel. The proofs use block matrices, elementary Levi
lifts, and the first isomorphism theorem. Two-core recognition, perfectness,
and the resulting block and residual assertions are left to the consumers of
this extension; they are not hypotheses of this calculation.

Source: Aschbacher--Smith F.1.12(I)(2), printed pp.262--264.
-/

public section
open Matrix
namespace Theory.SpecificGroups.SymplecticFour.Plane

variable {F : Type*} [Field F] [Finite F] [CharP F 2]

/-- The explicit plane-local extension and its untwisted central quotient,
assembled without any recognition or perfectness assumption. -/
theorem extension_spec {n : ℕ} (hcard : Nat.card F = 2 ^ n) (hn : 1 < n) :
    (radical (F := F)).Normal ∧
    Function.Surjective (quotientMap (F := F)) ∧
    (quotientMap (F := F)).ker = radical ∧
    IsElementaryAbelian 2 (radical (F := F)) ∧
    Monoid.exponent (radical (F := F)) = 2 ∧
    ⁅radical (F := F), (⊤ : Subgroup (planeLocal (F := F)))⁆ = radical ∧
    (∀ q : radical (F := F),
      q ∈ (Subgroup.center (planeLocal (F := F))).subgroupOf radical ↔
        ∃ z : F, (radicalEquiv q).toAdd.val = !![0, z; z, 0]) ∧
    (∀ (g : planeLocal (F := F)) (q : radical (F := F)),
      centralQuotientEquiv (QuotientGroup.mk (conjugate g q)) =
        Multiplicative.ofAdd ((quotientMap g).val *ᵥ
          (centralQuotientEquiv (QuotientGroup.mk q)).toAdd)) := by
  exact ⟨inferInstance, quotientMap_surjective, quotientMap_ker, inferInstance,
    radical_exponent, radical_commutator_eq hcard hn,
    mem_center_subgroupOf_iff_alternating, centralQuotientEquiv_conjugate⟩

end Theory.SpecificGroups.SymplecticFour.Plane
