module

public import Theory.SpecificGroups.SymplecticFour.LocalStructure
public import Theory.SpecificGroups.SymplecticFour.LocalStructure.Point.NaturalExtension
public import Theory.SpecificGroups.SymplecticFour.LocalStructure.Plane
public import Theory.SpecificGroups.SymplecticFour.LocalStructure.Recognition

/-!
# Nonbinary symplectic local factors

For a finite field of characteristic two and order `2 ^ n`, `n > 1`, the
explicit radicals of the point and plane determinant kernels are their full
two-cores. Their core quotients are the actual SL₂ matrix group, and both
radicals are generated by commutators with their local group. The central
quotient coordinates are those constructed in `Point.FixedQuotient` and
`Plane.CentralModule`; the latter use inverse Frobenius on the diagonal.

Applying natural-extension recognition proves perfectness. The determinant
characters have abelian image, so the perfect kernels are exactly the embedded
solvable residuals of the parabolics. All subgroup comparisons use the original
matrix embeddings or subgroups inside their respective parabolics.

Source: Aschbacher--Smith F.1.12(I)(2) and the residual and core assertions on
printed p.264 of `refs/quasithin.pdf` (1 March 2004 manuscript).
-/

public section
noncomputable section
namespace Theory.SpecificGroups.SymplecticFour

variable {F : Type*} [Field F] [Finite F] [CharP F 2]
variable {n : ℕ} (hcard : Nat.card F = 2 ^ n) (hn : 1 < n)
include hcard hn

/-- The actual plane-local extension, with inverse Frobenius already incorporated
in its central-quotient coordinates. -/
def planeNaturalExtension : NaturalExtension (F := F) (Plane.radical (F := F)) where
  elementary := Plane.radical_elementaryAbelian
  projection := Plane.quotientMap
  surjective := Plane.quotientMap_surjective
  kernel := Plane.quotientMap_ker
  commutator_eq := Plane.radical_commutator_eq hcard hn
  moduleIso := Plane.centralQuotientEquiv
  intertwining l q := congrArg Multiplicative.toAdd
    (Plane.centralQuotientEquiv_conjugate l q)

@[simp] theorem planeNaturalExtension_projection :
    (planeNaturalExtension hcard hn).projection = Plane.quotientMap := by rfl

@[simp] theorem planeNaturalExtension_moduleIso :
    (planeNaturalExtension hcard hn).moduleIso = Plane.centralQuotientEquiv := by rfl

omit [Field F] [Finite F] [CharP F 2] in
private theorem card_gt_two : 2 < Nat.card F := by
  rw [hcard]
  calc
    2 = 2 ^ 1 := by decide
    _ < 2 ^ n := Nat.pow_lt_pow_right (by decide) hn

/-- The explicit point radical is the full two-core of the determinant kernel. -/
theorem pointLocal_core_eq : pCore 2 (pointLocal (F := F)) = pointRadical :=
  (pointNaturalExtension hcard hn).core_eq (card_gt_two hcard hn)

/-- The symmetric-matrix plane radical is the full two-core. -/
theorem planeLocal_core_eq : pCore 2 (planeLocal (F := F)) = Plane.radical :=
  (planeNaturalExtension hcard hn).core_eq (card_gt_two hcard hn)

/-- The actual point-local core quotient, induced by the middle-block action. -/
def pointLocalCoreQuotientEquiv :
    (pointLocal (F := F) ⧸ pCore 2 (pointLocal (F := F))) ≃*
      Matrix.SpecialLinearGroup (Fin 2) F :=
  (pointNaturalExtension hcard hn).quotientIso (card_gt_two hcard hn)

/-- The actual plane-local core quotient, induced by restriction to the plane. -/
def planeLocalCoreQuotientEquiv :
    (planeLocal (F := F) ⧸ pCore 2 (planeLocal (F := F))) ≃*
      Matrix.SpecialLinearGroup (Fin 2) F :=
  (planeNaturalExtension hcard hn).quotientIso (card_gt_two hcard hn)

@[simp] theorem pointLocalCoreQuotientEquiv_mk (l : pointLocal (F := F)) :
    pointLocalCoreQuotientEquiv hcard hn (QuotientGroup.mk l) = pointQuotient l := by
  change (pointNaturalExtension hcard hn).quotientIso _ _ = _
  simpa only [pointNaturalExtension_projection, QuotientGroup.mk'_apply] using
    (pointNaturalExtension hcard hn).quotientIso_mk (card_gt_two hcard hn) l

@[simp] theorem planeLocalCoreQuotientEquiv_mk (l : planeLocal (F := F)) :
    planeLocalCoreQuotientEquiv hcard hn (QuotientGroup.mk l) = Plane.quotientMap l := by
  change (planeNaturalExtension hcard hn).quotientIso _ _ = _
  simpa only [planeNaturalExtension_projection, QuotientGroup.mk'_apply] using
    (planeNaturalExtension hcard hn).quotientIso_mk (card_gt_two hcard hn) l

/-- The point commutator layer is the entire explicit radical. -/
theorem pointLocal_core_commutator :
    ⁅pCore 2 (pointLocal (F := F)), (⊤ : Subgroup (pointLocal (F := F)))⁆ =
      pointRadical := by
  rw [pointLocal_core_eq hcard hn, pointRadical_commutator_eq hcard hn]

/-- The plane commutator layer is the entire symmetric-matrix radical. -/
theorem planeLocal_core_commutator :
    ⁅pCore 2 (planeLocal (F := F)), (⊤ : Subgroup (planeLocal (F := F)))⁆ =
      Plane.radical := by
  rw [planeLocal_core_eq hcard hn, Plane.radical_commutator_eq hcard hn]

/-- Perfectness of the actual point determinant kernel for `n > 1`. -/
theorem pointLocal_perfect : Group.IsPerfect (pointLocal (F := F)) :=
  (pointNaturalExtension hcard hn).perfect (card_gt_two hcard hn)

/-- Perfectness of the actual plane determinant kernel for `n > 1`. -/
theorem planeLocal_perfect : Group.IsPerfect (planeLocal (F := F)) :=
  (planeNaturalExtension hcard hn).perfect (card_gt_two hcard hn)

/-- The point local equals its own solvable residual. -/
theorem pointLocal_solvableResidual_eq_top :
    Subgroup.solvableResidual (pointLocal (F := F)) = ⊤ := by
  let := pointLocal_perfect hcard hn
  exact Subgroup.solvableResidual_eq_top

/-- The plane local equals its own solvable residual. -/
theorem planeLocal_solvableResidual_eq_top :
    Subgroup.solvableResidual (planeLocal (F := F)) = ⊤ := by
  let := planeLocal_perfect hcard hn
  exact Subgroup.solvableResidual_eq_top

/-- The embedded point-parabolic solvable residual is the point local. -/
theorem pointParabolic_solvableResidual_eq :
    (Subgroup.solvableResidual (pointParabolic (F := F))).map pointParabolic.subtype =
      pointLocal := by
  let := pointLocal_perfect hcard hn
  exact pointParabolic_solvableResidual_eq_of_perfect

/-- The embedded plane-parabolic solvable residual is the plane local. -/
theorem planeParabolic_solvableResidual_eq :
    (Subgroup.solvableResidual (planeParabolic (F := F))).map planeParabolic.subtype =
      planeLocal := by
  let := planeLocal_perfect hcard hn
  exact planeParabolic_solvableResidual_eq_of_perfect

/-- The residual identity inside the point parabolic. -/
theorem pointParabolic_solvableResidual_relative :
    Subgroup.solvableResidual (pointParabolic (F := F)) =
      (pointLocal (F := F)).subgroupOf pointParabolic := by
  let : Group.IsPerfect (determinantKernel (point F)) := pointLocal_perfect hcard hn
  exact determinantKernel_solvableResidual_relative_of_perfect (point F)

/-- The residual identity inside the plane parabolic. -/
theorem planeParabolic_solvableResidual_relative :
    Subgroup.solvableResidual (planeParabolic (F := F)) =
      (planeLocal (F := F)).subgroupOf planeParabolic := by
  let : Group.IsPerfect (determinantKernel (plane F)) := planeLocal_perfect hcard hn
  exact determinantKernel_solvableResidual_relative_of_perfect (plane F)

/-- The point-parabolic core is the same explicit radical in the matrix group. -/
theorem pointParabolic_core_map_eq_radical :
    (pCore 2 (pointParabolic (F := F))).map pointParabolic.subtype =
      (pointRadical (F := F)).map pointLocal.subtype := by
  rw [← pointLocal_core_map, pointLocal_core_eq hcard hn]

/-- The plane-parabolic core is the same explicit radical in the matrix group. -/
theorem planeParabolic_core_map_eq_radical :
    (pCore 2 (planeParabolic (F := F))).map planeParabolic.subtype =
      (Plane.radical (F := F)).map planeLocal.subtype := by
  rw [← planeLocal_core_map, planeLocal_core_eq hcard hn]

end Theory.SpecificGroups.SymplecticFour
