module

public import Theory.SpecificGroups.SymplecticFour.LocalStructure.Point.Coordinates
public import Mathlib.GroupTheory.Commutator.Basic
import Mathlib.Tactic.Ring

/-!
# Commutators of the symplectic point-local radical

Over a finite field of characteristic two with more than two elements, the
actual point radical is generated by its commutators with the point local.
Upper transvections give coordinates `(t * v, 0, t * v ^ 2)`. Choosing
`a ≠ 0, 1`, the product for parameters `(t, a)` and `(t * a, 1)` gives
`(0, 0, t * (a ^ 2 + a))`, so every central coordinate occurs. Upper and
lower transvections then give the two remaining coordinates.

This is the concrete radical commutator calculation used in the block assertion
of Aschbacher--Smith, F.1.12(I)(2), `refs/quasithin.pdf`, printed pp.262--264
(1 March 2004 manuscript).
-/

public section
noncomputable section
open Matrix
open scoped Matrix commutatorElement CharTwo
namespace Theory.SpecificGroups.SymplecticFour

variable {F : Type*} [Field F] [CharP F 2]

private def upper (t : F) : Matrix.SpecialLinearGroup (Fin 2) F :=
  ⟨!![1, t; 0, 1], by simp [Matrix.det_fin_two]⟩

private def lower (t : F) : Matrix.SpecialLinearGroup (Fin 2) F :=
  ⟨!![1, 0; t, 1], by simp [Matrix.det_fin_two]⟩

private theorem upper_commutator (t v : F) :
    ⁅pointLevi (upper t), pointRadicalElement 0 v 0⁆ =
      pointRadicalElement (t * v) 0 (t * v ^ 2) := by
  have hi : (pointRadicalElement (0 : F) v 0)⁻¹ = pointRadicalElement 0 v 0 := by
    apply inv_eq_of_mul_eq_one_right
    simpa only [← pow_two] using pointRadicalElement_sq (0 : F) v 0
  rw [commutatorElement_def, pointLevi_conj_radical, hi, pointRadicalElement_mul]
  congr 1 <;> simp [upper, pow_two, mul_assoc]

private theorem lower_commutator (t u : F) :
    ⁅pointLevi (lower t), pointRadicalElement u 0 0⁆ =
      pointRadicalElement 0 (t * u) (t * u ^ 2) := by
  have hi : (pointRadicalElement u (0 : F) 0)⁻¹ = pointRadicalElement u 0 0 := by
    apply inv_eq_of_mul_eq_one_right
    simpa only [← pow_two] using pointRadicalElement_sq u (0 : F) 0
  rw [commutatorElement_def, pointLevi_conj_radical, hi, pointRadicalElement_mul]
  congr 1 <;> simp [lower, pow_two, mul_assoc]

private theorem upper_commutator_mem (t v : F) :
    pointRadicalElement (t * v) 0 (t * v ^ 2) ∈
      ⁅pointRadical (F := F), (⊤ : Subgroup (pointLocal (F := F)))⁆ := by
  rw [Subgroup.commutator_comm, ← upper_commutator]
  exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _)
    (pointRadicalElement_mem 0 v 0)

private theorem lower_commutator_mem (t u : F) :
    pointRadicalElement 0 (t * u) (t * u ^ 2) ∈
      ⁅pointRadical (F := F), (⊤ : Subgroup (pointLocal (F := F)))⁆ := by
  rw [Subgroup.commutator_comm, ← lower_commutator]
  exact Subgroup.commutator_mem_commutator (Subgroup.mem_top _)
    (pointRadicalElement_mem u 0 0)

omit [CharP F 2] in
private theorem field_parameter [Finite F] {n : ℕ}
    (hcard : Nat.card F = 2 ^ n) (hn : 1 < n) :
    ∃ a : F, a ≠ 0 ∧ a ≠ 1 := by
  have hF : 2 < Nat.card F := by
    rw [hcard]
    have hpow : 4 ≤ 2 ^ n := by
      calc
        4 = 2 ^ 2 := by norm_num
        _ ≤ 2 ^ n := Nat.pow_le_pow_right (by omega) (by omega)
    omega
  let := Fintype.ofFinite F
  classical
  by_contra h
  push Not at h
  have hs : (Finset.univ : Finset F) ⊆ {0, 1} := by
    intro a _
    by_cases ha : a = 0
    · simp [ha]
    · have ha1 : a = 1 := by simpa [ha] using h a
      simp [ha1]
  have hc := Finset.card_le_card hs
  have hb : ({0, 1} : Finset F).card ≤ 2 := Finset.card_le_two
  have : Nat.card F ≤ 2 := by simpa using hc.trans hb
  omega

/-- Over a nonbinary finite field, the point radical equals its commutator
subgroup with the whole point local. -/
theorem pointRadical_commutator_eq [Finite F] {n : ℕ}
    (hcard : Nat.card F = 2 ^ n) (hn : 1 < n) :
    ⁅pointRadical (F := F), (⊤ : Subgroup (pointLocal (F := F)))⁆ = pointRadical := by
  apply le_antisymm (Subgroup.commutator_le_left _ _)
  let C : Subgroup (pointLocal (F := F)) :=
    ⁅pointRadical (F := F), (⊤ : Subgroup (pointLocal (F := F)))⁆
  obtain ⟨a, ha0, ha1⟩ := field_parameter hcard hn
  have hd : a ^ 2 + a ≠ 0 := by
    rw [show a ^ 2 + a = a * (a + 1) by ring]
    exact mul_ne_zero ha0 (fun h => ha1 (CharTwo.add_eq_zero.mp h))
  have hcentral : ∀ w : F, pointRadicalElement 0 0 w ∈ C := by
    intro w
    let s : F := w / (a ^ 2 + a)
    have hz : s * a ^ 2 + s * a = w := by
      rw [← mul_add]
      exact div_mul_cancel₀ w hd
    have hm := C.mul_mem (upper_commutator_mem s a) (upper_commutator_mem (s * a) 1)
    simpa only [pointRadicalElement_mul, mul_one, one_pow, add_zero, zero_add,
      mul_zero, zero_mul, CharTwo.add_self_eq_zero, hz] using hm
  have hu : ∀ u : F, pointRadicalElement u 0 0 ∈ C := by
    intro u
    have hm := C.mul_mem (upper_commutator_mem u 1) (hcentral u)
    simpa only [pointRadicalElement_mul, mul_one, one_pow, add_zero, zero_add,
      mul_zero, zero_mul, CharTwo.add_self_eq_zero] using hm
  have hv : ∀ v : F, pointRadicalElement 0 v 0 ∈ C := by
    intro v
    have hm := C.mul_mem (lower_commutator_mem v 1) (hcentral v)
    simpa only [pointRadicalElement_mul, mul_one, one_pow, add_zero, zero_add,
      mul_zero, zero_mul, CharTwo.add_self_eq_zero] using hm
  have hcoordinates : ∀ u v z : F, pointRadicalElement u v z ∈ C := by
    intro u v z
    have hm := C.mul_mem (C.mul_mem (hu u) (hv v)) (hcentral (u * v + z))
    simpa only [pointRadicalElement_mul, add_zero, zero_add, mul_zero, zero_mul,
      CharTwo.add_cancel_left] using hm
  intro g hg
  rw [pointRadical_eq_element g hg]
  exact hcoordinates _ _ _

end Theory.SpecificGroups.SymplecticFour
