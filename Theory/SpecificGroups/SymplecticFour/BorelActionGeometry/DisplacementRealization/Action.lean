module

public import Theory.SpecificGroups.SymplecticFour.Sylow.DerivedNormalizerSolvable.FullGroup
public import Theory.GroupAction.ModelConjugation
public import Mathlib.Algebra.Group.Subgroup.Pointwise

/-!
# Conjugation by the moving factor

If V is generated by W and a subgroup centralizing L, with W contained in
L, then its action in any actual model of L is exactly the inner image of
W. For nonbinary Sp₄, transport this equality to the actual derived group
using its inclusion equivalence; conjugation becomes `MulAut.conjNormal`.

This supplies the literal root-action transfer in Aschbacher–Smith E.6.8(2),
printed pp.247–248 (PDF pp.258–259 of refs/quasithin.pdf).
-/

public section

open Subgroup
open scoped Pointwise
open Theory.GroupAction.ModelConjugation
namespace Theory.SpecificGroups.SymplecticFour.BorelActionGeometry.DisplacementRealization
variable {G D : Type*} [Group G] [Group D]

theorem action_range_of_central_factor {V L W C : Subgroup G}
    (hN : V ≤ normalizer (L : Set G)) (e : L ≃* D)
    (hgen : W ⊔ C = V) (hWL : W ≤ L) (hCL : C ≤ centralizer (L : Set G)) :
    (action V L hN e).range = ((W.subgroupOf L).map e.toMonoidHom).map MulAut.conj := by
  have hWV : W ≤ V := le_sup_left.trans hgen.le
  have hCV : C ≤ V := le_sup_right.trans hgen.le
  have hCW : C ≤ normalizer (W : Set G) :=
    (hCL.trans (centralizer_le hWL)).trans (Subgroup.centralizer_le_normalizer (W : Set G))
  ext a
  constructor
  · rintro ⟨v, rfl⟩
    have hv : (v : G) ∈ (W : Set G) * (C : Set G) := by
      rw [← coe_mul_of_right_le_normalizer_left W C hCW, hgen]
      exact v.property
    obtain ⟨w, hw, c, hc, he⟩ := hv
    let wV : V := ⟨w, hWV hw⟩
    let cV : V := ⟨c, hCV hc⟩
    have hc1 : action V L hN e cV = 1 := by
      rw [← MonoidHom.mem_ker, action_ker]
      exact hCL hc
    refine ⟨e ⟨w, hWL hw⟩, ⟨⟨w, hWL hw⟩, hw, rfl⟩, ?_⟩
    have hv' : v = wV * cV := Subtype.ext he.symm
    rw [hv', map_mul, hc1, mul_one]
    exact (action_conj V L hN e ⟨w, hWL hw⟩ (hWV hw)).symm
  · rintro ⟨x, ⟨w, hw, rfl⟩, rfl⟩
    exact ⟨⟨w, hWV hw⟩, action_conj V L hN e w (hWV hw)⟩

variable {F : Type*} [Field F] [Finite F] [CharP F 2]
theorem congr_conj_derived (hF : 2 < Nat.card F) (x : Sp F) :
    MulAut.congr (derivedEquivFull_of_card_gt_two hF).symm (MulAut.conj x) =
      MulAut.conjNormal (H := commutator (Sp F)) x := by
  apply MulEquiv.ext
  intro z
  apply (derivedEquivFull_of_card_gt_two hF).injective
  change derivedEquivFull_of_card_gt_two hF
    ((derivedEquivFull_of_card_gt_two hF).symm (x *
      derivedEquivFull_of_card_gt_two hF z * x⁻¹)) = _
  rw [MulEquiv.apply_symm_apply]
  simp only [derivedEquivFull_of_card_gt_two_apply]
  rfl

end Theory.SpecificGroups.SymplecticFour.BorelActionGeometry.DisplacementRealization
