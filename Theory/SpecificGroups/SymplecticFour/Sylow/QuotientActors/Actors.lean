module

public import Theory.SpecificGroups.SymplecticFour.Sylow.QuotientActors.Quadratic
public import Mathlib.Algebra.Ring.AddAut

/-!
# Cyclic two-groups acting compatibly with the Sylow square map

The additive rigidity theorem places every compatible plane automorphism
in the group generated by odd-order diagonal maps and the graph-field map.
The diagonals are normal, and the quotient is generated by one element.
A faithful two-group action therefore embeds in this cyclic quotient.

This is the intrinsic actor-group step in the noncentral argument of
Aschbacher–Smith, 2.4.24. No extension to symplectic automorphisms is used.
-/

@[expose] public section

noncomputable section
namespace Theory.SpecificGroups.SymplecticFour.QuotientActors
open Subgroup
variable {F : Type*} [Field F] [Finite F] [CharP F 2]

abbrev PlaneAut (F : Type*) [Field F] := MulAut (Multiplicative (F × F))

def diagonal : (Fˣ × Fˣ) →* PlaneAut F where
  toFun cd := (((AddAut.mulLeft cd.1).toAdd).prodCongr
    ((AddAut.mulLeft cd.2).toAdd)).toMultiplicative
  map_one' := by
    ext x
    · change (1:F)*x.toAdd.1=x.toAdd.1
      rw [one_mul]
    · change (1:F)*x.toAdd.2=x.toAdd.2
      rw [one_mul]
  map_mul' cd ef := by
    ext x
    change ((cd.1*ef.1:Fˣ):F)*x.toAdd.1=cd.1*(ef.1*x.toAdd.1)
    simp only [Units.val_mul,mul_assoc]
    change ((cd.2*ef.2:Fˣ):F)*x.toAdd.2=cd.2*(ef.2*x.toAdd.2)
    simp only [Units.val_mul,mul_assoc]

omit [Finite F] [CharP F 2] in
lemma diagonal_apply (cd : Fˣ × Fˣ) (x : F × F) :
    (diagonal cd (Multiplicative.ofAdd x)).toAdd=(cd.1*x.1,cd.2*x.2) := rfl

def graph : PlaneAut F := (graphPlane (F:=F)).toMultiplicative

lemma graph_apply (x : F × F) :
    (graph (Multiplicative.ofAdd x)).toAdd=(x.2,x.1^2) := rfl

def fieldPlane : (F ≃+* F) →* PlaneAut F where
  toFun σ := (σ.toAddEquiv.prodCongr σ.toAddEquiv).toMultiplicative
  map_one' := rfl
  map_mul' _ _ := rfl

omit [Finite F] [CharP F 2] in
lemma fieldPlane_apply (σ : F ≃+* F) (x : F × F) :
    (fieldPlane σ (Multiplicative.ofAdd x)).toAdd=(σ x.1,σ x.2) := rfl

lemma graph_sq : graph (F:=F)^2=fieldPlane (frobeniusEquiv F 2) := by
  ext x <;> rfl

lemma graph_diagonal (cd : Fˣ × Fˣ) :
    graph*diagonal cd=diagonal (cd.2,cd.1^2)*graph (F:=F) := by
  ext x
  · rfl
  · change (cd.1*x.toAdd.1)^2=(cd.1^2:Fˣ)*x.toAdd.1^2
    simp only [mul_pow,Units.val_pow_eq_pow_val]

private lemma finiteFieldAut_eq_frobenius_pow (σ : F ≃+* F) :
    ∃ k : ℕ, σ=frobeniusEquiv F 2^k := by
  let := ZMod.algebra F 2
  let σ' : F ≃ₐ[ZMod 2] F := AlgEquiv.ofRingEquiv (f:=σ) (fun t =>
    DFunLike.congr_fun (Subsingleton.elim
      (σ.toRingHom.comp (algebraMap (ZMod 2) F)) (algebraMap (ZMod 2) F)) t)
  obtain ⟨k,hk⟩ := (FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow (ZMod 2) F).surjective σ'
  let forget : (F ≃ₐ[ZMod 2] F) →* (F ≃+* F) :=
    { toFun := AlgEquiv.toRingEquiv, map_one' := rfl, map_mul' := fun _ _ => rfl }
  have hf : forget (FiniteField.frobeniusAlgEquivOfAlgebraic (ZMod 2) F)=frobeniusEquiv F 2 := by
    ext t
    change t^Fintype.card (ZMod 2)=t^2
    rw [ZMod.card]
  have hσ : forget σ'=σ := rfl
  refine ⟨k.val,?_⟩
  rw [←hσ,←hk,map_pow,hf]

lemma quadratic_actor_mem {n : ℕ} (hF : Nat.card F=2^n) (hn : 2<n)
    (a : PlaneAut F) (b : (F × F) ≃+ (F × F))
    (h : ∀ x,squareMap ((a (Multiplicative.ofAdd x)).toAdd)=b (squareMap x)) :
    a ∈ diagonal.range ⊔ zpowers (graph (F:=F)) := by
  let aa : (F × F) ≃+ (F × F) := a.toAdditive
  obtain ⟨c,d,σ,he⟩ := normal_form hF hn aa b h
  obtain ⟨k,rfl⟩ := finiteFieldAut_eq_frobenius_pow σ
  have hf : fieldPlane (frobeniusEquiv F 2^k)=graph^ (2*k) := by
    rw [map_pow,←graph_sq,pow_mul]
  have hd : diagonal (c,d) ∈ diagonal.range ⊔ zpowers (graph (F:=F)) :=
    (show diagonal.range ≤ diagonal.range ⊔ zpowers (graph (F:=F)) from le_sup_left) ⟨(c,d),rfl⟩
  have hg : graph (F:=F) ∈ diagonal.range ⊔ zpowers graph :=
    (show zpowers (graph (F:=F)) ≤ diagonal.range ⊔ zpowers graph from le_sup_right) (mem_zpowers _)
  rcases he with he|he
  · have ha : a=diagonal (c,d)*fieldPlane (frobeniusEquiv F 2^k) := by
      ext x
      · exact congrArg Prod.fst (he x.toAdd)
      · exact congrArg Prod.snd (he x.toAdd)
    rw [ha,hf]
    exact mul_mem hd (pow_mem hg _)
  · have ha : a=diagonal (c,d)*fieldPlane (frobeniusEquiv F 2^k)*graph := by
      ext x
      · change (aa x.toAdd).1=c*(frobeniusEquiv F 2^k) x.toAdd.2
        exact congrArg Prod.fst (he x.toAdd)
      · change (aa x.toAdd).2=d*(frobeniusEquiv F 2^k) (x.toAdd.1^2)
        simpa only [map_pow] using congrArg Prod.snd (he x.toAdd)
    rw [ha,hf]
    exact mul_mem (mul_mem hd (pow_mem hg _)) hg

lemma graph_normalizes_diagonal :
    graph (F:=F) ∈ normalizer ((diagonal (F:=F)).range : Set (PlaneAut F)) := by
  apply mem_normalizer_iff.mpr
  intro a
  constructor
  · rintro ⟨cd,rfl⟩
    exact ⟨(cd.2,cd.1^2),by rw [graph_diagonal,mul_inv_cancel_right]⟩
  · intro ha
    obtain ⟨cd,hcd⟩ := ha
    let c : Fˣ := Units.map (frobeniusEquiv F 2).symm.toMonoidHom cd.2
    have hc : c^2=cd.2 := by
      apply Units.ext
      exact (frobeniusEquiv F 2).apply_symm_apply cd.2
    have hh := graph_diagonal (c,cd.1)
    rw [hc] at hh
    have he : graph*diagonal (c,cd.1)=graph*a := by
      rw [hh]
      change diagonal cd*graph=graph*a
      rw [hcd]; group
    exact ⟨(c,cd.1),mul_left_cancel he⟩

lemma actor_quotient_cyclic :
    let H : Subgroup (PlaneAut F) := diagonal.range ⊔ zpowers graph
    let D := diagonal.range.subgroupOf H
    ∃ _ : D.Normal, IsCyclic (H ⧸ D) := by
  let H : Subgroup (PlaneAut F) := diagonal.range ⊔ zpowers graph
  let D := diagonal.range.subgroupOf H
  have hn : zpowers (graph (F:=F)) ≤ normalizer ((diagonal (F:=F)).range : Set (PlaneAut F)) :=
    zpowers_le.mpr graph_normalizes_diagonal
  have hD : D.Normal := (normal_subgroupOf_iff_le_normalizer le_sup_left).mpr
    (sup_le diagonal.range.le_normalizer hn)
  let := hD
  refine ⟨hD,?_⟩
  let J := (zpowers (graph (F:=F))).subgroupOf H
  have hJ : IsCyclic J := isCyclic_of_injective
    (subgroupOfEquivOfLe (show zpowers graph ≤ H from le_sup_right)).toMonoidHom
    (subgroupOfEquivOfLe (show zpowers graph ≤ H from le_sup_right)).injective
  let := hJ
  have hs : D ⊔ J=⊤ := by
    rw [←subgroupOf_sup (show diagonal.range ≤ H from le_sup_left)
      (show zpowers graph ≤ H from le_sup_right)]
    change H.subgroupOf H=⊤
    exact Subgroup.subgroupOf_self H
  let q := QuotientGroup.mk' D
  have hDmap : D.map q=⊥ := by
    rw [Subgroup.map_eq_bot_iff,QuotientGroup.ker_mk']
  have hJmap : J.map q=⊤ := by
    have hh := congrArg (fun S : Subgroup H => S.map q) hs
    simpa [Subgroup.map_sup,hDmap,q,map_top_of_surjective _ (QuotientGroup.mk'_surjective _)] using hh
  apply isCyclic_of_surjective (q.comp J.subtype)
  apply MonoidHom.range_eq_top.mp
  simpa only [MonoidHom.range_comp,range_subtype] using hJmap

omit [Finite F] [CharP F 2] in
lemma diagonal_pow (cd : Fˣ × Fˣ) : diagonal cd ^ (Nat.card F-1)=1 := by
  have hu (c : Fˣ) : c^(Nat.card F-1)=1 := by
    rw [←Nat.card_units (α:=F)]
    exact pow_card_eq_one'
  rw [←map_pow]
  have he : cd^(Nat.card F-1)=1 := Prod.ext (hu cd.1) (hu cd.2)
  rw [he,map_one]

lemma isCyclic_of_faithful_quadratic_action {n : ℕ} (hF : Nat.card F=2^n) (hn : 2<n)
    {A : Type*} [Group A] [Finite A] (hA : IsPGroup 2 A)
    (ρ : A →* PlaneAut F) (hfaithful : Function.Injective ρ)
    (hq : ∀ a : A, ∃ b : (F × F) ≃+ (F × F),
      ∀ x,squareMap ((ρ a (Multiplicative.ofAdd x)).toAdd)=b (squareMap x)) :
    IsCyclic A := by
  let H : Subgroup (PlaneAut F) := diagonal.range ⊔ zpowers graph
  let D := diagonal.range.subgroupOf H
  obtain ⟨hD,hC⟩ := actor_quotient_cyclic (F:=F)
  let := hD
  let := hC
  let f : A →* H := ρ.codRestrict H (fun a => by
    obtain ⟨b,hb⟩ := hq a
    exact quadratic_actor_mem hF hn (ρ a) b hb)
  let ψ : A →* H ⧸ D := (QuotientGroup.mk' D).comp f
  apply isCyclic_of_injective ψ
  apply (MonoidHom.ker_eq_bot_iff ψ).mp
  apply eq_bot_iff.mpr
  intro a ha
  have hd : f a ∈ D := (QuotientGroup.eq_one_iff _).mp ha
  obtain ⟨cd,hcd⟩ := hd
  have hp : ρ a^(Nat.card F-1)=1 := by
    change diagonal cd=ρ a at hcd
    rw [←hcd]
    exact diagonal_pow cd
  have hp' : a^(Nat.card F-1)=1 := hfaithful (by rw [map_pow,hp,map_one])
  have ho : Nat.Coprime 2 (Nat.card F-1) := by
    rw [hF]
    apply Nat.coprime_two_left.mpr
    have hpow : Even (2^n) := Even.pow_of_ne_zero (by decide) (by omega)
    exact (Nat.odd_sub' (Nat.one_le_two_pow)).mpr ⟨fun _ => hpow,fun _ => by decide⟩
  exact (hA.powEquiv ho).injective (hp'.trans (one_pow _).symm)

end Theory.SpecificGroups.SymplecticFour.QuotientActors
