module

public import Theory.SpecificGroups.SymplecticFour.Sylow.SolvableParabolic
public import Theory.SpecificGroups.SymplecticFour.Sylow.ThreeResidualPlacement.OvergroupGeometry
public import Theory.GroupTheory.PResidual.PrimeToTransport

/-!
# Solvable prime-to-three residuals in symplectic Sylow overgroups

Let F be a nonbinary finite field of characteristic two and let H contain
an ambient Sylow two-subgroup T of the full matrix group Sp₄(F). If H is
proper and O^{3′}(H) is solvable, then H normalizes T. The residual here has
quotient of order prime to three; it is not the residual with three-group
quotient.

Root extraction and the invariant isotropic orbit span place H in a conjugate
of a full point or plane parabolic. The proof then intersects H with the
determinant-one local factor, whose actual matrix projection onto SL₂(F) has
a two-group kernel. Nonbinary SL₂(F) is
simple and perfect. The matrix [[0,1],[1,1]] lies in its prime-to-three
residual, so that residual is the whole group. Functoriality of residuals
therefore prevents the projected intersection from being all of SL₂(F).
The rank-one Sylow-overgroup theorem gives normalization in the intersection.
Its now normal Sylow subgroup is characteristic, so H normalizes it as well.
All normality assertions about local factors are relative to their parabolics.

This proves the intrinsic normalization step required for the symplectic case of
Aschbacher–Smith, combined manuscript of 1 March 2004, Lemma 15.3.28,
printed p.1131 (PDF p.1148), with the model list from B.5.5–6, pp.104–105.
The final theorem retains the chapter consumer's assumptions that three
divides |H| and nine does not; the intrinsic argument does not need them.
-/

public section

open Matrix Subgroup
namespace Theory.SpecificGroups.SymplecticFour.ThreeResidualPlacement
variable {F : Type*} [Field F] [Finite F] [CharP F 2]

/-- Nonbinary characteristic-two SL₂ is generated by its three-elements. -/
theorem sl2_primeToThreeResidual_eq_top (hF : 2 < Nat.card F) :
    primeToResidual 3 (SpecialLinearGroup (Fin 2) F) = ⊤ := by
  let _ := NaturalExtension.model_simple hF
  let x : SpecialLinearGroup (Fin 2) F := ⟨!![0,1;1,1], by simp [CharTwo.neg_eq]⟩
  have hx : x ^ 3 = 1 := by
    apply Subtype.ext
    change (!![0,1;1,1] : Matrix (Fin 2) (Fin 2) F) ^ 3 = 1
    ext i j
    fin_cases i <;> fin_cases j <;>
      norm_num [pow_succ, Matrix.mul_apply, Fin.sum_univ_two, CharTwo.add_self_eq_zero]
  have hm : x ∈ primeToResidual 3 (SpecialLinearGroup (Fin 2) F) :=
    mem_primeToResidual_of_pow (p := 3) (n := 1) (by simpa using hx)
  rcases (inferInstance : (primeToResidual 3
    (SpecialLinearGroup (Fin 2) F)).Normal).eq_bot_or_eq_top with hb | ht
  · rw [hb, mem_bot] at hm
    have he := congrArg (fun g : SpecialLinearGroup (Fin 2) F => g.val 0 1) hm
    simp [x] at he
  · exact ht

private theorem residual_solvable_of_injective {A B : Type*} [Group A] [Group B]
    (f : A →* B) (hf : Function.Injective f)
    (hsol : Group.IsSolvable (primeToResidual 3 B)) :
    Group.IsSolvable (primeToResidual 3 A) := by
  let _ := hsol
  let j : primeToResidual 3 A →* primeToResidual 3 B :=
    (f.comp (primeToResidual 3 A).subtype).codRestrict _ (fun x =>
      map_primeToResidual_le_of_hom 3 f (mem_map_of_mem _ x.property))
  exact Group.isSolvable_of_isSolvable_injective (f := j)
    (fun a b h => Subtype.ext (hf (congrArg Subtype.val h)))

private theorem not_surjective_of_residual_solvable {A : Type*} [Group A] [Finite A]
    (hF : 2 < Nat.card F) (f : A →* SpecialLinearGroup (Fin 2) F)
    (hsol : Group.IsSolvable (primeToResidual 3 A)) : ¬ Function.Surjective f := by
  intro hf
  let _ := hsol
  have hs : Group.IsSolvable ((primeToResidual 3 A).map f) :=
    Group.isSolvable_of_surjective (f.subgroupMap_surjective _)
  rw [map_primeToResidual_of_surjective 3 f hf, sl2_primeToThreeResidual_eq_top hF] at hs
  let _ := hs
  let _ := NaturalExtension.model_perfect hF
  let _ := NaturalExtension.model_simple hF
  exact Group.IsPerfect.not_isSolvable (SpecialLinearGroup (Fin 2) F)
    (Group.isSolvable_of_surjective
      (f := (topEquiv : (⊤ : Subgroup (SpecialLinearGroup (Fin 2) F)) ≃*
        SpecialLinearGroup (Fin 2) F).toMonoidHom) topEquiv.surjective)

private theorem normalizes_of_projection {G : Type*} [Group G] [Finite G]
    (hF : 2 < Nat.card F) (f : G →* SpecialLinearGroup (Fin 2) F)
    (hf : Function.Surjective f) (hk : IsPGroup 2 f.ker)
    (S : Sylow 2 G) (H : Subgroup G)
    (hsol : Group.IsSolvable (primeToResidual 3 H))
    (hSH : (S : Subgroup G) ≤ H) : H ≤ normalizer (S : Set G) := by
  let T := S.mapSurjective hf
  have hproper : H.map f ≠ ⊤ := by
    intro ht
    apply not_surjective_of_residual_solvable hF (f.comp H.subtype) hsol
    intro x
    obtain ⟨y, hy, he⟩ := (show x ∈ H.map f from ht ▸ mem_top x)
    exact ⟨⟨y, hy⟩, he⟩
  have hnorm := SolvableParabolic.proper_sylow_overgroup T (H.map f) hproper
    (map_mono hSH)
  have hker : f.ker ≤ (S : Subgroup G) := hk.le_sylow_of_normal S
  have hpre := (map_le_iff_le_comap.mp hnorm).trans
    ((T : Subgroup (SpecialLinearGroup (Fin 2) F)).le_normalizer_comap f)
  simpa only [T, Sylow.coe_mapSurjective, comap_map_eq_self hker, Sylow.coe_coe] using hpre

private theorem normalizes_of_intermediate {G : Type*} [Group G] [Finite G]
    (T : Sylow 2 G) (L H : Subgroup G) (hTL : (T : Subgroup G) ≤ L)
    (hLN : L ≤ normalizer (T : Set G)) (hHL : H ≤ normalizer (L : Set G)) :
    H ≤ normalizer (T : Set G) := by
  let S := T.subtype hTL
  have hSN : S.Normal := (normal_subgroupOf_iff_le_normalizer hTL).mpr hLN
  let _ : S.Characteristic := S.characteristic_of_normal hSN
  have hn := normalizer_le_normalizer_characteristic_image L (S : Subgroup L)
  have he : (S : Subgroup L).map L.subtype = (T : Subgroup G) :=
    map_subgroupOf_eq_of_le hTL
  rw [he] at hn
  exact hHL.trans hn

private theorem normalizes_of_local_factor {G : Type*} [Group G] [Finite G]
    (hF : 2 < Nat.card F) (K H : Subgroup G)
    (f : K →* SpecialLinearGroup (Fin 2) F)
    (hf : Function.Surjective f) (hk : IsPGroup 2 f.ker)
    (T : Sylow 2 G) (hsol : Group.IsSolvable (primeToResidual 3 H))
    (hTH : (T : Subgroup G) ≤ H) (hTK : (T : Subgroup G) ≤ K)
    (hHK : H ≤ normalizer (K : Set G)) : H ≤ normalizer (T : Set G) := by
  let j : H.subgroupOf K →* H :=
    { toFun := fun x => ⟨x.val.val, x.property⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl }
  have hs := residual_solvable_of_injective j
    (fun a b h => Subtype.ext (Subtype.ext (congrArg (fun x : H => (x : G)) h))) hsol
  have hlocal := normalizes_of_projection hF f hf hk (T.subtype hTK)
    (H.subgroupOf K) hs (fun _ hx => hTH hx)
  have hLN : H ⊓ K ≤ normalizer (T : Set G) := by
    intro x hx
    have hh := hlocal (show (⟨x, hx.2⟩ : K) ∈ H.subgroupOf K from hx.1)
    change (⟨x, hx.2⟩ : K) ∈ normalizer ((T : Subgroup G).subgroupOf K) at hh
    rw [← subgroupOf_normalizer_eq hTK] at hh
    exact hh
  exact normalizes_of_intermediate T (H ⊓ K) H (le_inf hTH hTK) hLN
    ((le_inf H.le_normalizer hHK).trans inf_normalizer_le_normalizer_inf)

omit [Finite F] in
private theorem two_subgroup_le_determinantKernel
    (W : Submodule F (Vector F)) (T : Sylow 2 (Sp F))
    (hT : (T : Subgroup (Sp F)) ≤ stabilizer W) :
    (T : Subgroup (Sp F)) ≤ determinantKernel W := by
  intro t ht
  let x : stabilizer W := ⟨t, hT ht⟩
  obtain ⟨n, hn⟩ := T.isPGroup'.exists_pow_pow_eq_one ⟨t, ht⟩
  have hx : x ^ (2 ^ n) = 1 := Subtype.ext (congrArg (fun y : T => (y : Sp F)) hn)
  have hp : ((determinantCharacter W x : Fˣ) : F) ^ (2 ^ n) = 1 := by
    have he := congrArg (fun u : Fˣ => (u : F)) (congrArg (determinantCharacter W) hx)
    simpa only [map_pow, map_one, Units.val_pow_eq_pow_val, Units.val_one] using he
  have hchar : determinantCharacter W x = 1 := by
    apply Units.ext
    simpa only [pow_one, Units.val_one] using
      (ExpChar.pow_prime_pow_mul_eq_one_iff 2 n 1
      ((determinantCharacter W x : Fˣ) : F)).mp (by simpa using hp)
  exact ⟨x, hchar, rfl⟩

/-- In the full point parabolic, a Sylow overgroup with solvable O^{3′}
normalizes its Sylow two-subgroup. Whole-group solvability is not assumed. -/
theorem pointParabolic_le_normalizer
    (hF : 2 < Nat.card F) (T : Sylow 2 (Sp F)) (H : Subgroup (Sp F))
    (hsol : Group.IsSolvable (primeToResidual 3 H)) (hTH : (T : Subgroup (Sp F)) ≤ H)
    (hHP : H ≤ pointParabolic) : H ≤ normalizer (T : Set (Sp F)) := by
  exact normalizes_of_local_factor hF pointLocal H pointQuotient pointQuotient_surjective
    (IsElementaryAbelian.isPGroup 2 (pointRadical (F := F))) T hsol hTH
    (two_subgroup_le_determinantKernel (point F) T (hTH.trans hHP))
    (hHP.trans (le_normalizer_of_normal_subgroupOf pointLocal_le))

/-- In the full plane parabolic, solvability of O^{3′} suffices for
normalization of the contained ambient Sylow two-subgroup. -/
theorem planeParabolic_le_normalizer
    (hF : 2 < Nat.card F) (T : Sylow 2 (Sp F)) (H : Subgroup (Sp F))
    (hsol : Group.IsSolvable (primeToResidual 3 H)) (hTH : (T : Subgroup (Sp F)) ≤ H)
    (hHP : H ≤ planeParabolic) : H ≤ normalizer (T : Set (Sp F)) := by
  exact normalizes_of_local_factor hF planeLocal H Plane.quotientMap Plane.quotientMap_surjective
    (IsElementaryAbelian.isPGroup 2 (Plane.radical (F := F))) T hsol hTH
    (two_subgroup_le_determinantKernel (plane F) T (hTH.trans hHP))
    (hHP.trans (le_normalizer_of_normal_subgroupOf planeLocal_le))

/-- The residual normalization theorem in either full standard parabolic. -/
theorem parabolic_le_normalizer
    (hF : 2 < Nat.card F) (T : Sylow 2 (Sp F)) (H : Subgroup (Sp F))
    (hsol : Group.IsSolvable (primeToResidual 3 H)) (hTH : (T : Subgroup (Sp F)) ≤ H)
    (hpar : H ≤ pointParabolic ∨ H ≤ planeParabolic) :
    H ≤ normalizer (T : Set (Sp F)) := by
  rcases hpar with hp | hp
  · exact pointParabolic_le_normalizer hF T H hsol hTH hp
  · exact planeParabolic_le_normalizer hF T H hsol hTH hp

/-- The residual normalization theorem with actual conjugate-parabolic
containment. The containment must be supplied independently. -/
theorem conjugate_parabolic_le_normalizer
    (hF : 2 < Nat.card F) (T : Sylow 2 (Sp F)) (H : Subgroup (Sp F))
    (hsol : Group.IsSolvable (primeToResidual 3 H)) (hTH : (T : Subgroup (Sp F)) ≤ H)
    (hpar : ∃ g : Sp F, H.map (MulAut.conj g).toMonoidHom ≤ pointParabolic ∨
      H.map (MulAut.conj g).toMonoidHom ≤ planeParabolic) :
    H ≤ normalizer (T : Set (Sp F)) := by
  obtain ⟨g, hg⟩ := hpar
  let e := MulAut.conj g
  let _ := hsol
  have hs : Group.IsSolvable (primeToResidual 3 (H.map e.toMonoidHom)) :=
    Group.isSolvable_of_surjective
      (f := (primeToResidualEquiv 3 (e.subgroupMap H)).toMonoidHom)
      (primeToResidualEquiv 3 (e.subgroupMap H)).surjective
  have hn := parabolic_le_normalizer hF (T.mapSurjective e.surjective)
    (H.map e.toMonoidHom) hs (map_mono hTH) hg
  apply (map_le_map_iff_of_injective (f := e.toMonoidHom) e.injective).mp
  exact hn.trans_eq (map_equiv_normalizer_eq (T : Subgroup (Sp F)) e).symm

/-- A proper ambient Sylow overgroup with solvable O^{3′} normalizes that
Sylow subgroup. The geometric containment is proved, not assumed. -/
theorem proper_sylow_overgroup_le_normalizer
    (hF : 2 < Nat.card F) (Q : Sylow 2 (Sp F)) (H : Subgroup (Sp F))
    (hQH : (Q : Subgroup (Sp F)) ≤ H) (hH : H ≠ ⊤)
    (hsol : Group.IsSolvable (primeToResidual 3 H)) :
    H ≤ normalizer (Q : Set (Sp F)) :=
  conjugate_parabolic_le_normalizer hF Q H hsol hQH
    (proper_sylow_overgroup_parabolic_cover hF Q H hQH hH)

/-- The intrinsic full-matrix contract used in the symplectic case of 15.3.28.
The source three-part assumptions are retained, although the stronger
normalization theorem only needs properness and solvability of O^{3′}(H). -/
theorem sylow_overgroup_le_normalizer
    (hF : 2 < Nat.card F) (Q : Sylow 2 (Matrix.symplecticGroup (Fin 2) F))
    (H : Subgroup (Matrix.symplecticGroup (Fin 2) F))
    (hQH : (Q : Subgroup _) ≤ H) (hH : H ≠ ⊤)
    (_hthree : 3 ∣ Nat.card H) (_hnine : ¬ 9 ∣ Nat.card H)
    (hsol : Group.IsSolvable (Subgroup.primeToResidual 3 H)) :
    H ≤ Subgroup.normalizer (Q : Set _) :=
  proper_sylow_overgroup_le_normalizer hF Q H hQH hH hsol

end Theory.SpecificGroups.SymplecticFour.ThreeResidualPlacement
