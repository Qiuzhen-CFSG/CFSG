module
public import Theory.SpecificGroups.SymplecticFour.RootPresentation.Relations
public import Theory.SpecificGroups.SymplecticFour.Sylow.CentralRootGeometry.Coordinates

/-!
# Positive collection in the C₂ presentation

The five commuting pairs and crossing equation collect any product into
x₆(b)x₀(k)x₄(w)x₂(v). The multiplication law is
(b,k,w,v)(c,l,t,a)=(b+c,k+l+c²v,w+t+cv,v+a).
Using the actual matrix coordinates, these relations construct a homomorphism
from the concrete unipotent subgroup into any group carrying such root maps.
Its image is exactly the positive-root closure. No map from the whole matrix
group, or projection back to it, is assumed.

The collection calculation adapts `CentralCovers/TwoPrimary/PositiveRoots`,
removing that file's pre-existing projection and section hypotheses.
Source: Steinberg §6, Lemma 36, printed p.69.
-/

@[expose] public section
open Subgroup
open Representation.OneCohomology.SymplecticFour
namespace Theory.SpecificGroups.SymplecticFour.RootPresentation
variable {F E : Type*} [Field F] [Group E]
namespace PositiveRelations
variable {x : Fin 8 → F → E} (h : PositiveRelations x)
include h

/-- Ordered product in the positive roots (6,0,4,2). -/
def product (x : Fin 8 → F → E) (b k w v : F) : E := x 6 b * x 0 k * x 4 w * x 2 v

private theorem add_left (r : Fin 8) (s t : F) (z : E) :
    x r s * (x r t * z) = x r (s+t) * z := by rw [← mul_assoc, h.add]

theorem product_mul (b k w v c l t a : F) :
    product x b k w v * product x c l t a =
      product x (b+c) (k+l+c^2*v) (w+t+c*v) (v+a) := by
  have h0 (s t : F) : Commute (x 6 s) (x 0 t) := h.commuting 0 s t
  have h1 (s t : F) : Commute (x 6 s) (x 4 t) := h.commuting 1 s t
  have h2 (s t : F) : Commute (x 0 s) (x 4 t) := h.commuting 2 s t
  have h3 (s t : F) : Commute (x 0 s) (x 2 t) := h.commuting 3 s t
  have h4 (s t : F) : Commute (x 4 s) (x 2 t) := h.commuting 4 s t
  simp only [product, mul_assoc]
  rw [← mul_assoc (x 2 v) (x 6 c), h.crossing]
  simp only [mul_assoc]
  rw [(h1 c w).symm.left_comm, (h0 c k).symm.left_comm]
  rw [(h3 l v).symm.left_comm, (h4 t v).symm.left_comm]
  rw [(h2 (c^2*v) w).symm.left_comm]
  rw [(h2 l (c*v)).symm.left_comm, (h2 l w).symm.left_comm]
  rw [h.add_left, h.add_left, h.add_left, h.add_left, h.add_left, h.add]
  simp only [add_assoc, add_left_comm, add_comm]

/-- The subgroup generated by the four positive root ranges. -/
def positiveSubgroup (x : Fin 8 → F → E) : Subgroup E :=
  closure {g | ∃ r ∈ ({6,0,4,2} : Set (Fin 8)), ∃ t, x r t = g}

variable [Finite F] [CharP F 2]

/-- The proved four-coordinate parametrization of the literal matrix U. -/
noncomputable def coordinates : (F × F × F × F) ≃ unipotent (F := F) :=
  Equiv.ofBijective (fun p => CentralRootGeometry.element p.1 p.2.1 p.2.2.1 p.2.2.2)
    ⟨CentralRootGeometry.element_injective, CentralRootGeometry.element_surjective⟩

/-- Positive collection constructs a homomorphism FROM the concrete U to any
root system satisfying the relations; no ambient model map is assumed. -/
noncomputable def unipotentMap : unipotent (F := F) →* E := by
  let j : unipotent (F := F) → E := fun g =>
    let p := coordinates.symm g
    product x p.1 (p.2.1 + p.1*p.2.2.1) p.2.2.1 p.2.2.2
  have hj (b u w v : F) : j (CentralRootGeometry.element b u w v) =
      product x b (u+b*w) w v := by
    change product x (coordinates.symm (coordinates (b,u,w,v))).1
      ((coordinates.symm (coordinates (b,u,w,v))).2.1 +
        (coordinates.symm (coordinates (b,u,w,v))).1 *
        (coordinates.symm (coordinates (b,u,w,v))).2.2.1)
      (coordinates.symm (coordinates (b,u,w,v))).2.2.1
      (coordinates.symm (coordinates (b,u,w,v))).2.2.2 = _
    rw [Equiv.symm_apply_apply]
  refine {toFun := j, map_one' := ?_, map_mul' := ?_}
  · rw [← CentralRootGeometry.element_zero, hj]
    simp [product, h.zero]
  · intro g g'
    obtain ⟨⟨b,u,w,v⟩, rfl⟩ := CentralRootGeometry.element_surjective g
    obtain ⟨⟨c,z,t,a⟩, rfl⟩ := CentralRootGeometry.element_surjective g'
    rw [CentralRootGeometry.element_mul, hj, hj, hj, h.product_mul]
    congr 1 <;> ring_nf
    simp [CharTwo.two_eq_zero]

theorem unipotentMap_element (b u w v : F) :
    h.unipotentMap (CentralRootGeometry.element b u w v) = product x b (u+b*w) w v := by
  change product x (coordinates.symm (coordinates (b,u,w,v))).1
    ((coordinates.symm (coordinates (b,u,w,v))).2.1 +
      (coordinates.symm (coordinates (b,u,w,v))).1 *
      (coordinates.symm (coordinates (b,u,w,v))).2.2.1)
    (coordinates.symm (coordinates (b,u,w,v))).2.2.1
    (coordinates.symm (coordinates (b,u,w,v))).2.2.2 = _
  rw [Equiv.symm_apply_apply]

theorem unipotentMap_root (r : Fin 8) (t : F) (hr : r ∈ ({6,0,4,2} : Set (Fin 8))) :
    h.unipotentMap ⟨rootElement r t, positive_root_mem_unipotent r t (by
      simpa only [Set.mem_insert_iff, Set.mem_singleton_iff, or_comm, or_left_comm, or_assoc] using hr)⟩ = x r t := by
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hr
  rcases hr with rfl | rfl | rfl | rfl
  · have he : (⟨rootElement 6 t, positive_root_mem_unipotent 6 t (by simp)⟩ : unipotent (F := F)) =
        CentralRootGeometry.element t 0 0 0 := by
      apply Subtype.ext
      simp [CentralRootGeometry.element, RootSubgroup.element_zero]
    rw [he, h.unipotentMap_element]
    simp [product, h.zero]
  · have he : (⟨rootElement 0 t, positive_root_mem_unipotent 0 t (by simp)⟩ : unipotent (F := F)) =
        CentralRootGeometry.element 0 t 0 0 := by
      apply Subtype.ext
      simp [CentralRootGeometry.element, RootSubgroup.element_zero]
    rw [he, h.unipotentMap_element]
    simp [product, h.zero]
  · have he : (⟨rootElement 4 t, positive_root_mem_unipotent 4 t (by simp)⟩ : unipotent (F := F)) =
        CentralRootGeometry.element 0 0 t 0 := by
      apply Subtype.ext
      simp [CentralRootGeometry.element, RootSubgroup.element_zero]
    rw [he, h.unipotentMap_element]
    simp [product, h.zero]
  · have he : (⟨rootElement 2 t, positive_root_mem_unipotent 2 t (by simp)⟩ : unipotent (F := F)) =
        CentralRootGeometry.element 0 0 0 t := by
      apply Subtype.ext
      simp [CentralRootGeometry.element, RootSubgroup.element_zero]
    rw [he, h.unipotentMap_element]
    simp [product, h.zero]

theorem unipotentMap_range : h.unipotentMap.range = positiveSubgroup x := by
  apply le_antisymm
  · rintro _ ⟨g,rfl⟩
    obtain ⟨⟨b,u,w,v⟩,rfl⟩ := CentralRootGeometry.element_surjective g
    rw [h.unipotentMap_element]
    have hr (r : Fin 8) (t : F) (hr : r ∈ ({6,0,4,2} : Set (Fin 8))) :
        x r t ∈ positiveSubgroup x := subset_closure ⟨r,hr,t,rfl⟩
    exact mul_mem (mul_mem (mul_mem (hr 6 b (by simp))
      (hr 0 _ (by simp))) (hr 4 w (by simp))) (hr 2 v (by simp))
  · apply (closure_le _).mpr
    rintro _ ⟨r,hr,t,rfl⟩
    exact ⟨⟨rootElement r t, positive_root_mem_unipotent r t (by
      simpa only [Set.mem_insert_iff, Set.mem_singleton_iff, or_comm, or_left_comm, or_assoc] using hr)⟩,
      h.unipotentMap_root r t hr⟩

/-- Every element of the positive closure has an ordered four-root expression. -/
theorem positive_normal_form (g : E) (hg : g ∈ positiveSubgroup x) :
    ∃ b k w v : F, product x b k w v = g := by
  rw [← h.unipotentMap_range] at hg
  obtain ⟨u,rfl⟩ := hg
  obtain ⟨⟨b,k,w,v⟩,rfl⟩ := CentralRootGeometry.element_surjective u
  exact ⟨b,k+b*w,w,v,(h.unipotentMap_element b k w v).symm⟩
end PositiveRelations
end Theory.SpecificGroups.SymplecticFour.RootPresentation
