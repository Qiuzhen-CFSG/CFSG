module
public import Mathlib.Algebra.Field.Defs
public import Mathlib.Algebra.Group.Subgroup.Basic
public import Mathlib.GroupTheory.Perm.Basic
public import Mathlib.Data.Fin.VecNotation
public import Mathlib.Algebra.Group.TypeTags.Basic

/-!
# The characteristic-two C₂ root relations

The root numbering is 0=2e₀, 1=−2e₀, 2=2e₁, 3=−2e₁,
4=e₀+e₁, 5=−e₀−e₁, 6=e₀−e₁, 7=−e₀+e₁. The positive
order is (6,0,4,2). We specify the five commuting pairs and the remaining
crossing equation in every chamber of the group generated by the two
explicit simple reflections. Additivity supplies the root homomorphisms.
In particular this interface does not assume any opposite-root relation,
model homomorphism, or equality of arbitrary words with equal matrices.

Source: Steinberg, *Lectures on Chevalley Groups*, §6, Theorems 8–9,
printed pp.68–74 (`refs/KGroup/GLS3/Chapter2St1.tex`).
-/

@[expose] public section
open Subgroup
namespace Theory.SpecificGroups.SymplecticFour.RootPresentation
variable {F E : Type*} [Field F] [Group E]

def shortReflection : Equiv.Perm (Fin 8) :=
  Equiv.swap 0 2 * Equiv.swap 1 3 * Equiv.swap 6 7

def longReflection : Equiv.Perm (Fin 8) :=
  Equiv.swap 2 3 * Equiv.swap 4 6 * Equiv.swap 5 7

def weyl : Subgroup (Equiv.Perm (Fin 8)) :=
  closure {shortReflection, longReflection}

def commutingPairs : Fin 5 → Fin 8 × Fin 8 := ![(6,0),(6,4),(0,4),(0,2),(4,2)]

/-- The positive C₂ collection relations, with all root maps additive. -/
structure PositiveRelations (x : Fin 8 → F → E) : Prop where
  add : ∀ r s t, x r s * x r t = x r (s+t)
  commuting : ∀ i s t, Commute (x (commutingPairs i).1 s) (x (commutingPairs i).2 t)
  crossing : ∀ v c, x 2 v * x 6 c = x 6 c * x 0 (c^2*v) * x 4 (c*v) * x 2 v

/-- Additivity and exactly the nonopposite characteristic-two Chevalley relations.
No relation between opposite roots is included. -/
def Relations (x : Fin 8 → F → E) : Prop :=
  ∀ σ ∈ weyl, PositiveRelations (fun r t => x (σ r) t)

theorem Relations.positive {x : Fin 8 → F → E} (h : Relations x) :
    PositiveRelations x := h 1 weyl.one_mem

namespace PositiveRelations
variable {x : Fin 8 → F → E} (h : PositiveRelations x)
include h

theorem zero (r : Fin 8) : x r 0 = 1 := by
  have hh := h.add r 0 0
  simpa only [add_zero, mul_eq_left] using hh

def rootHom (r : Fin 8) : Multiplicative F →* E where
  toFun t := x r t.toAdd
  map_one' := h.zero r
  map_mul' s t := (h.add r s.toAdd t.toAdd).symm

theorem map {H : Type*} [Group H] (f : E →* H) :
    PositiveRelations (fun r t => f (x r t)) where
  add r s t := by rw [← map_mul, h.add]
  commuting i s t := by
    change f (x (commutingPairs i).1 s) * f (x (commutingPairs i).2 t) = _
    simpa only [map_mul] using congrArg f (h.commuting i s t)
  crossing v c := by simpa only [map_mul] using congrArg f (h.crossing v c)

end PositiveRelations
end Theory.SpecificGroups.SymplecticFour.RootPresentation
