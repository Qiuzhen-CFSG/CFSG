module
public import Theory.SpecificGroups.SymplecticFour.RootPresentation.Faithfulness
public import Theory.SpecificGroups.SymplecticFour.SimpleQuotients
public import Theory.SpecificGroups.SymplecticFour.EvenProjective
public import Theory.SpecificGroups.SymplecticFour.Binary.ProjectiveDerived
public import Theory.SpecificGroups.SymplecticFour.Binary.FieldTransport
public import Mathlib.GroupTheory.SpecificGroups.Alternating.Simple

/-!
# Recognition from the proved C₂ presentation, including field two

Presentation faithfulness constructs a surjection from concrete Sp₄ to
any group generated by the specified eight roots. If its target has more
than two elements this map is injective. For field size at least four,
use simplicity of the known concrete projective model and its trivial
scalar center. For field two, transport the map through the actual S₆
isomorphism: any nontrivial normal kernel contains A₆, forcing a quotient
of order at most two. No simplicity of the unknown target is assumed.

Source: Steinberg §6, Theorems 8–9, pp.68–74; the standard Sp₄(2)=S₆
exception used in DGS row II(a), printed pp.209 and 224.
-/

@[expose] public noncomputable section
open Subgroup
open Representation.OneCohomology.SymplecticFour
namespace Theory.SpecificGroups.SymplecticFour.RootPresentation
variable {F Y : Type*} [Field F] [Group Y] [Finite F] [CharP F 2]

/-- A nontrivial kernel from S₆ has quotient of order at most two. -/
private theorem perm_six_injective [Finite Y] (hY : 2 < Nat.card Y)
    (f : Equiv.Perm (Fin 6) →* Y) (hf : Function.Surjective f) : Function.Injective f := by
  apply (MonoidHom.ker_eq_bot_iff _).mp
  by_contra hn
  have hN : Nontrivial f.ker := (nontrivial_iff_ne_bot _).mpr hn
  have hA : alternatingGroup (Fin 6) ≤ f.ker :=
    Equiv.Perm.alternatingGroup_le_of_normal (by simp) hN
  have hd : f.ker.index ∣ 2 :=
    (alternatingGroup.index_eq_two (α := Fin 6)) ▸ index_dvd_of_le hA
  have hc : Nat.card Y = f.ker.index :=
    (Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective f hf).toEquiv).symm
  rw [← hc] at hd
  exact (not_le_of_gt hY) (Nat.le_of_dvd (by decide) hd)

/-- Every quotient of the whole even Sp₄ having order greater than two is
faithful. The binary case uses the whole S₆ and its normal subgroups. -/
theorem surjective_injective [Finite Y] (hY : 2 < Nat.card Y)
    (f : Sp F →* Y) (hf : Function.Surjective f) : Function.Injective f := by
  let : Nontrivial Y := Finite.one_lt_card_iff_nontrivial.mp (lt_trans (by decide) hY)
  by_cases hF : Nat.card F = 2
  · let e : Equiv.Perm (Fin 6) ≃* Sp F := Binary.symmetricSixEquiv.trans
      (Binary.fieldEquivSp (Binary.fieldEquivZModTwo F hF).symm)
    have hi := perm_six_injective hY (f.comp e.toMonoidHom) (hf.comp e.surjective)
    intro a b hab
    obtain ⟨a,rfl⟩ := e.surjective a
    obtain ⟨b,rfl⟩ := e.surjective b
    exact congrArg e (hi hab)
  · have hq : 3 < Nat.card F := by
      let := Fintype.ofFinite F
      obtain ⟨n,_,hn⟩ := FiniteField.card F 2
      have hn' : Nat.card F = 2^(n : ℕ) := by simpa only [Nat.card_eq_fintype_card] using hn
      have hn2 : 2 ≤ (n : ℕ) := by
        have hne : (n : ℕ) ≠ 1 := by intro he; simp only [he,pow_one] at hn'; exact hF hn'
        exact Nat.succ_le_of_lt (lt_of_le_of_ne (show 1 ≤ (n : ℕ) from n.property) hne.symm)
      rw [hn']
      exact lt_of_lt_of_le (by decide : 3 < 2^2) (Nat.pow_le_pow_right (by decide) hn2)
    let := SimpleQuotients.isSimpleGroup (F := F) hq
    let e := EvenProjective.equiv (F := F)
    have hi := (f.comp e.symm.toMonoidHom).injective_of_surjective_of_simple
      (hf.comp e.symm.surjective)
    intro a b hab
    apply e.injective
    apply hi
    simpa using hab

namespace Relations
variable {x : Fin 8 → F → Y} (h : Relations x)

/-- The proved presentation constructs the required reverse map from matrices. -/
def modelMap : Sp F →* Y := (lift h).comp matrixEquiv.symm.toMonoidHom

@[simp] theorem modelMap_root (r : Fin 8) (t : F) : h.modelMap (rootElement r t) = x r t := by
  change lift h (matrixEquiv.symm (rootElement r t)) = _
  rw [← matrixEquiv_generator,matrixEquiv.symm_apply_apply,lift_generator]

theorem modelMap_surjective (hgen : closure {g | ∃ r t, x r t = g} = ⊤) :
    Function.Surjective h.modelMap := (lift_surjective h hgen).comp matrixEquiv.symm.surjective

/-- Recognition retains the root parameters and the full model at field two. -/
def modelEquiv [Finite Y] (hgen : closure {g | ∃ r t, x r t = g} = ⊤)
    (hY : 2 < Nat.card Y) : Y ≃* Sp F :=
  (MulEquiv.ofBijective h.modelMap
    ⟨surjective_injective hY h.modelMap (h.modelMap_surjective hgen),h.modelMap_surjective hgen⟩).symm

@[simp] theorem modelEquiv_root [Finite Y] (hgen : closure {g | ∃ r t, x r t = g} = ⊤)
    (hY : 2 < Nat.card Y) (r : Fin 8) (t : F) :
    h.modelEquiv hgen hY (x r t) = rootElement r t := by
  apply (h.modelEquiv hgen hY).symm.injective
  simp only [MulEquiv.symm_apply_apply]
  exact (h.modelMap_root r t).symm

end Relations
end Theory.SpecificGroups.SymplecticFour.RootPresentation
