module
public import Theory.SpecificGroups.SymplecticFour.TwoConjugate.Geometry
public import Theory.ElementaryAbelian.Basic

/-!
# Involution generation of the literal opposite pair

Both generators of the opposition pair are elementary abelian. Their
square-one elements therefore generate the entire intrinsic pair. This
retains the original pair for the outer-extension step of
Aschbacher--Smith E.2.7, printed p.220.
-/

public section
open Subgroup
namespace Theory.SpecificGroups.SymplecticFour.TwoConjugate
variable {F : Type*} [Field F] [CharP F 2]

/-- The literal opposite pair is generated by its involutions. -/
theorem oppositePair_involution_generated
    (V : Subgroup (Sp F)) [IsElementaryAbelian 2 V] :
    closure {g : oppositePair V | g ^ 2 = 1} = ⊤ := by
  let P := oppositePair V
  let A := closure {g : P | g ^ 2 = 1}
  have hP : P ≤ A.map P.subtype := by
    apply sup_le
    · intro x hx
      let y : P := ⟨x, (show V ≤ P from le_sup_left) hx⟩
      refine ⟨y, subset_closure ?_, rfl⟩
      exact Subtype.ext (elemPow_eq_one_of_isElementaryAbelian x hx)
    · rintro _ ⟨x,hx,rfl⟩
      let y : P := ⟨MulAut.conj opposition x,
        (show V.map (MulAut.conj opposition).toMonoidHom ≤ P from le_sup_right)
          (mem_map_of_mem (MulAut.conj opposition).toMonoidHom hx)⟩
      refine ⟨y, subset_closure ?_,rfl⟩
      apply Subtype.ext
      change (MulAut.conj opposition x) ^ 2 = 1
      rw [←map_pow, elemPow_eq_one_of_isElementaryAbelian x hx, map_one]
  apply top_unique
  intro x _
  obtain ⟨y,hy,he⟩ := hP x.property
  exact (Subtype.ext he : y = x) ▸ hy

end Theory.SpecificGroups.SymplecticFour.TwoConjugate
