module
public import Theory.SpecificGroups.SymplecticFour.TransvectionRecognition.CoefficientNormalizer
public import Theory.SpecificGroups.SymplecticFour.TwoConjugate.Geometry

/-!
# Internal opposition in a recognized coefficient pair

Opposition exchanges the two generators of the literal opposite pair, so
it normalizes that pair. A conjugate coefficient copy of Sp4(K) is
self-normalizing inside Sp4(F). Recognizing the same pair as this copy
therefore makes opposition internal, without a root element in the original V.

Source: Aschbacher--Smith E.2.7, printed pp.219--220.
-/

public noncomputable section
open Subgroup
namespace Theory.SpecificGroups.SymplecticFour.TwoConjugate
open TransvectionRecognition DiagramAutomorphisms.FieldFixedResidual
variable {F : Type*} [Field F] [Finite F] [CharP F 2]

omit [Finite F] in
/-- Opposition normalizes the actual subgroup generated by V and its opposite. -/
theorem opposition_mem_normalizer_oppositePair (V : Subgroup (Sp F)) :
    opposition ∈ normalizer (oppositePair V : Set (Sp F)) := by
  apply mem_normalizer_iff_map_conj_eq.mpr
  change (oppositePair V).map (MulAut.conj (opposition (F := F))).toMonoidHom = oppositePair V
  rw [oppositePair, Subgroup.map_sup, map_map]
  have he : (MulAut.conj (opposition (F := F))).toMonoidHom.comp
      (MulAut.conj opposition).toMonoidHom = MonoidHom.id _ := by
    apply MonoidHom.ext
    intro x
    simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
      MulAut.conj_apply, MonoidHom.id_apply,opposition_inv]
    have hs : (opposition (F := F)) * opposition = 1 := by
      nth_rw 1 [←opposition_inv]
      exact inv_mul_cancel _
    calc
      opposition * (opposition * x * opposition) * opposition =
          (opposition * opposition) * x * (opposition * opposition) := by group
      _ = x := by rw [hs]; simp
  rw [he, map_id, sup_comm]

/-- A recognized coefficient copy supplies the original internal conjugator. -/
theorem opposition_mem_of_coefficient_copy (V : Subgroup (Sp F))
    (K : Subfield F) (c : Sp F)
    (he : oppositePair V = (coefficientInclusion K).range.map
      (MulAut.conj c).toMonoidHom) : opposition ∈ oppositePair V := by
  have hn := opposition_mem_normalizer_oppositePair V
  rw [he, conjugate_coefficient_range_normalizer] at hn
  simpa only [he] using hn

end Theory.SpecificGroups.SymplecticFour.TwoConjugate
