module
public import Theory.SpecificGroups.SymplecticFour.NormalQuadratic
public import Theory.ElementaryAbelian.Injective

/-!
# Elementary groups generated by normal quadratic symplectic subgroups

The existing Sylow-coordinate theorem places the complete generated group in
one elementary wing. Transport through Sylow conjugation gives elementary
abelianness, strengthening its existing order bound. The original radius
application is `Sp4Four.DistanceReduction.RadiusFour`.

Source: Meierfrankenfeld--Stellmacher (1993), (5.2), printed p.914.
-/

public noncomputable section
open Subgroup Matrix
namespace Theory.SpecificGroups.SymplecticFour.NormalQuadratic
open CentralRootGeometry
variable {F : Type*} [Field F] [CharP F 2] [Finite F]
/-- A two-subgroup generated by normal quadratic elementary subgroups is elementary. -/
theorem generated_elementary {n : ℕ} (hF : Nat.card F = 2^n) (hn : 0 < n)
    (P : Subgroup (Sp F)) (hP : IsPGroup 2 P) {I : Sort*}
    (A : I → Subgroup (Sp F)) (hgen : P = ⨆ i, A i)
    (helem : ∀ i, IsElementaryAbelian 2 (A i))
    (hnorm : ∀ i, P ≤ normalizer (A i : Set (Sp F)))
    (hquad : ∀ i, ∀ x ∈ A i, ∀ y ∈ A i, ∀ v : Vector F,
      x • (y • v-v)=y • v-v) : IsElementaryAbelian 2 P := by
  obtain ⟨S,hS⟩ := hP.exists_le_sylow
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq (Sp F) S (unipotentSylow hF hn)
  let f := (MulAut.conj g).toMonoidHom
  have ht : P.map f ≤ unipotent := by
    have hh : (S : Subgroup (Sp F)).map f = unipotent :=
      congrArg (fun T : Sylow 2 (Sp F) => (T : Subgroup (Sp F))) hg
    exact hh ▸ map_mono hS
  let B := (P.map f).subgroupOf unipotent
  let C (i : I) := ((A i).map f).subgroupOf unipotent
  have hAi (i : I) : A i ≤ P := hgen ▸ le_iSup A i
  have hCt (i : I) : (A i).map f ≤ unipotent := (map_mono (hAi i)).trans ht
  have hCm (i : I) : (C i).map (unipotent (F := F)).subtype = (A i).map f :=
    map_subgroupOf_eq_of_le (hCt i)
  have hBm : B.map (unipotent (F := F)).subtype = P.map f :=
    map_subgroupOf_eq_of_le ht
  have hgen' : B = ⨆ i, C i := by
    apply Subgroup.map_injective (unipotent (F := F)).subtype_injective
    rw [hBm,Subgroup.map_iSup]
    simp only [hCm]
    rw [hgen,Subgroup.map_iSup]
  have hnorm' (i : I) : B ≤ normalizer (C i : Set (unipotent (F := F))) := by
    apply (comap_mono ((map_mono (hnorm i)).trans (le_normalizer_map f))).trans
    exact le_normalizer_comap (unipotent (F := F)).subtype
  have helem' (i : I) : IsElementaryAbelian 2 (C i) := by
    let := helem i
    let := IsElementaryAbelian.map (p := 2) (A := A i) f
    exact IsElementaryAbelian.subgroupOf (hCt i)
  have hquad' (i : I) (x : unipotent (F := F)) (hx : x ∈ C i)
      (y : unipotent (F := F)) (hy : y ∈ C i) (v : Vector F) :
      x.val • (y.val • v-v)=y.val • v-v := by
    obtain ⟨x₀,hx₀,hxe⟩ := hx
    obtain ⟨y₀,hy₀,hye⟩ := hy
    have hh := congrArg (fun w : Vector F => g • w) (hquad i x₀ hx₀ y₀ hy₀ (g⁻¹ • v))
    change g*x₀*g⁻¹=x.val at hxe
    change g*y₀*g⁻¹=y.val at hye
    rw [←hxe,←hye]
    simpa only [mul_smul,smul_sub,inv_smul_smul,smul_inv_smul] using hh
  have hB : IsElementaryAbelian 2 B := by
    rcases sylow_generated_le_wing B C hgen' helem' hnorm' hquad' with hh | hh
    · let := wing_elementary (F := F) true
      exact IsElementaryAbelian.of_injective (inclusion hh) (inclusion_injective hh)
    · let := wing_elementary (F := F) false
      exact IsElementaryAbelian.of_injective (inclusion hh) (inclusion_injective hh)
  let := hB
  let e : P ≃* B := (P.equivMapOfInjective f (MulAut.conj g).injective).trans
    (subgroupOfEquivOfLe ht).symm
  exact IsElementaryAbelian.of_injective e.toMonoidHom e.injective

end Theory.SpecificGroups.SymplecticFour.NormalQuadratic
