module

public import Theory.SpecificGroups.SymplecticFour.RootSubgroup
public import Mathlib.LinearAlgebra.Matrix.SpecialLinearGroup
import Mathlib.Tactic.FinCases

/-!
# The opposite long-root pair on the first hyperbolic plane

The literal first-plane embedding identifies the subgroup generated by roots
0 and 1 with SL₂, retaining all matrix entries. In characteristic two, the
full upper root and any nonidentity lower root element generate this pair:
a three-factor Weyl word carries the full upper root to the full lower root.

The embedding calculation is adapted from
`SymplecticFour/Sylow/SolvableRootOrbit.lean`.
Source: Aschbacher–Smith, 11.5.7, printed p.783.
-/

@[expose] public section
open Matrix Subgroup
open Representation.OneCohomology.SymplecticFour
namespace Theory.SpecificGroups.SymplecticFour.OppositeLongRootPair
variable {F : Type*} [Field F]
local notation "a" => (Sum.inl (0 : Fin 2) : Fin 2 ⊕ Fin 2)
local notation "c" => (Sum.inr (0 : Fin 2) : Fin 2 ⊕ Fin 2)
local notation "SL" => SpecialLinearGroup (Fin 2) F

/-- The actual join of the two opposite first-plane long roots. -/
def pair : Subgroup (Sp F) := RootSubgroup.group 0 ⊔ RootSubgroup.group 1

def matrix (A : SL) : Matrix (Fin 2 ⊕ Fin 2) (Fin 2 ⊕ Fin 2) F :=
  fromBlocks !![A 0 0, 0; 0, 1] !![A 0 1, 0; 0, 0]
    !![A 1 0, 0; 0, 0] !![A 1 1, 0; 0, 1]

theorem matrix_mem (A : SL) :
    matrix A ∈ Matrix.symplecticGroup (Fin 2) F := by
  have hA : A 0 0 * A 1 1 - A 0 1 * A 1 0 = 1 := by
    simpa only [det_fin_two] using A.property
  rw [matrix, SymplecticGroup.fromBlocks_mem_iff]
  refine ⟨?_, ?_, ?_⟩ <;> ext i j <;> fin_cases i <;> fin_cases j <;>
    simp [mul_apply, Fin.sum_univ_two, mul_comm, hA]

def embedding : SL →* Sp F where
  toFun A := ⟨matrix A, matrix_mem A⟩
  map_one' := by
    apply Subtype.ext
    ext i j
    fin_cases i <;> fin_cases j <;> simp [matrix]
  map_mul' A B := by
    apply Subtype.ext
    change matrix (A * B) = matrix A * matrix B
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [matrix, mul_apply, Fintype.sum_sum_type, Fin.sum_univ_two]

theorem embedding_injective : Function.Injective (embedding (F := F)) := by
  intro A B h
  apply Subtype.ext
  ext i j
  have he (x y : Fin 2 ⊕ Fin 2) := congrArg (fun g : Sp F => g.val x y) h
  fin_cases i <;> fin_cases j
  · exact he a a
  · exact he a c
  · exact he c a
  · exact he c c

theorem embedding_upper (t : F) :
    embedding (SpecialLinearGroup.transvection zero_ne_one t) = rootElement 0 t := by
  apply Subtype.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [embedding, matrix, SpecialLinearGroup.transvection_coe,
      rootElement, rootMatrix, single, fromBlocks]

theorem embedding_lower (t : F) :
    embedding (SpecialLinearGroup.transvection (i := (1 : Fin 2)) (j := 0) one_ne_zero t) =
      rootElement 1 t := by
  apply Subtype.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [embedding, matrix, SpecialLinearGroup.transvection_coe,
      rootElement, rootMatrix, single, fromBlocks]

/-- The image is precisely the two-root join, by elementary SL₂ generation. -/
theorem embedding_range : (embedding (F := F)).range = pair := by
  apply le_antisymm
  · rintro _ ⟨A, rfl⟩
    apply Matrix.SL2.transvection_induction (fun A => embedding A ∈ pair) ?_ ?_ A
    · intro i j hij t
      fin_cases i <;> fin_cases j
      · exact (hij rfl).elim
      · rw [embedding_upper]
        exact mem_sup_left (subset_closure ⟨t, rfl⟩)
      · rw [embedding_lower]
        exact mem_sup_right (subset_closure ⟨t, rfl⟩)
      · exact (hij rfl).elim
    · intro A B hA hB
      simpa only [map_mul] using pair.mul_mem hA hB
  · apply sup_le <;> apply (closure_le _).mpr
    · rintro _ ⟨t, rfl⟩
      exact ⟨SpecialLinearGroup.transvection zero_ne_one t, embedding_upper t⟩
    · rintro _ ⟨t, rfl⟩
      exact ⟨SpecialLinearGroup.transvection one_ne_zero t, embedding_lower t⟩

/-- Recognition preserves the original first-hyperbolic-plane matrices. -/
noncomputable def equiv : pair (F := F) ≃* SL :=
  ((MonoidHom.ofInjective (embedding_injective (F := F))).trans
    (MulEquiv.subgroupCongr embedding_range)).symm

/-- Under this isomorphism the original four-space matrix is the first-plane
embedding of its SL₂ actor. -/
theorem embedding_equiv (x : pair (F := F)) : embedding (equiv x) = (x : Sp F) :=
  congrArg Subtype.val (equiv.symm_apply_apply x)

variable [CharP F 2]

private def weylWord (t : F) : Sp F :=
  rootElement 0 t⁻¹ * rootElement 1 t * rootElement 0 t⁻¹

private theorem weylWord_upper {t : F} (ht : t ≠ 0) (s : F) :
    weylWord t * rootElement 0 s * (weylWord t)⁻¹ = rootElement 1 (t^2*s) := by
  rw [mul_inv_eq_iff_eq_mul]
  apply Subtype.ext
  change (rootMatrix 0 t⁻¹ * rootMatrix 1 t * rootMatrix 0 t⁻¹) * rootMatrix 0 s =
    rootMatrix 1 (t^2*s) * (rootMatrix 0 t⁻¹ * rootMatrix 1 t * rootMatrix 0 t⁻¹)
  ext i j
  rcases i with i | i <;> rcases j with j | j <;> fin_cases i <;> fin_cases j <;>
    simp [rootMatrix, mul_apply, Fintype.sum_sum_type, Fin.sum_univ_two,
      single, fromBlocks, ht, CharTwo.add_self_eq_zero, pow_two, mul_assoc]
  rw [mul_left_comm t s, mul_inv_cancel₀ ht, mul_one]

/-- One nonidentity opposite root element suffices, with the full original root. -/
theorem pair_eq_sup_zpowers {w : Sp F} (hw : w ∈ RootSubgroup.group 1) (hne : w ≠ 1) :
    pair = RootSubgroup.group 0 ⊔ zpowers w := by
  obtain ⟨t, rfl⟩ := (RootSubgroup.mem_group_iff 1 w).mp hw
  have ht : t ≠ 0 := by
    intro h
    exact hne (h ▸ RootSubgroup.element_zero 1)
  let H : Subgroup (Sp F) := RootSubgroup.group 0 ⊔ zpowers (rootElement 1 t)
  have hu (s : F) : rootElement 0 s ∈ H := mem_sup_left (subset_closure ⟨s, rfl⟩)
  have hl : rootElement 1 t ∈ H := mem_sup_right (mem_zpowers _)
  have hn : weylWord t ∈ H := H.mul_mem (H.mul_mem (hu _) hl) (hu _)
  have hlow : RootSubgroup.group 1 ≤ H := by
    apply (closure_le _).mpr
    rintro _ ⟨s, rfl⟩
    have hh := H.mul_mem (H.mul_mem hn (hu (s/t^2))) (H.inv_mem hn)
    rw [weylWord_upper ht, mul_div_cancel₀ _ (pow_ne_zero 2 ht)] at hh
    exact hh
  apply le_antisymm
  · exact sup_le le_sup_left hlow
  · exact sup_le le_sup_left (zpowers_le.mpr (mem_sup_right hw))

end Theory.SpecificGroups.SymplecticFour.OppositeLongRootPair
