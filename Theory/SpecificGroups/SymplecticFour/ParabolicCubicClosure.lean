module
public import Theory.GroupTheory.CubicClosureTwoKernel
public import Theory.SpecificGroups.SymplecticFour.LocalStructure.Recognition.Basic
public import Theory.SpecificGroups.SymplecticFour.LocalStructure.Point.Coordinates
public import Theory.SpecificGroups.SymplecticFour.LocalStructure.Plane.Extension
import Mathlib.Tactic.FinCases

/-!
# Cubic generation in symplectic parabolics

A nontrivial cubic matrix normally generates simple SL₂ over a nonbinary
field of characteristic two. Each determinant-one local factor of Sp₄
maps onto SL₂ with elementary abelian kernel. Consequently the subgroup
generated by cubic elements of either full parabolic is nonsolvable.
This is the model obstruction used in Aschbacher–Smith 15.3.20.
-/

public section
open Subgroup Theory.GroupTheory Matrix
namespace Theory.SpecificGroups.SymplecticFour
variable {F : Type*} [Field F] [Finite F] [CharP F 2]

/-- Nonbinary SL₂ is generated by its cubic elements. -/
theorem sl2_cubic_closure_eq_top (hF : 2 < Nat.card F) :
    closure {x : SpecialLinearGroup (Fin 2) F | orderOf x = 3} = ⊤ := by
  let : IsSimpleGroup (SpecialLinearGroup (Fin 2) F) := NaturalExtension.model_simple hF
  let C : Subgroup (SpecialLinearGroup (Fin 2) F) := closure {x | orderOf x = 3}
  have hn : (⊤ : Subgroup (SpecialLinearGroup (Fin 2) F)) ≤ normalizer (C : Set _) := by
    apply le_normalizer_closure_iff.mpr
    intro g _ x hx
    exact subset_closure ((MulAut.conj g).orderOf_eq x |>.trans hx)
  let : C.Normal := normalizer_eq_top_iff.mp (top_unique hn)
  rcases (inferInstance : C.Normal).eq_bot_or_eq_top with hb | ht
  · let c : SpecialLinearGroup (Fin 2) F := ⟨!![0,-1;1,-1],by simp [det_fin_two]⟩
    have hc3 : c^3 = 1 := by
      apply Subtype.ext
      change (!![0,-1;1,-1] : Matrix (Fin 2) (Fin 2) F)^3 = 1
      ext i j
      fin_cases i <;> fin_cases j <;>
        simp [pow_succ,Matrix.mul_apply,Fin.sum_univ_two]
    have hcne : c ≠ 1 := by
      intro hh
      have hv := congrArg (fun x : SpecialLinearGroup (Fin 2) F => x.val 1 0) hh
      simp [c] at hv
    have hcm : c ∈ C := subset_closure (orderOf_eq_prime hc3 hcne)
    rw [hb,mem_bot] at hcm
    exact (hcne hcm).elim
  · exact ht

/-- Every even-field point parabolic has a nonsolvable cubic-generated subgroup. -/
theorem pointParabolic_cubic_not_solvable (hF : 2 < Nat.card F) :
    ¬ Group.IsSolvable (closure {x : pointParabolic (F := F) | orderOf x = 3}) := by
  intro hs
  have hsLocal := solvable_cubic_closure_of_injective (inclusion pointLocal_le)
    (inclusion_injective pointLocal_le) hs
  have hsModel := solvable_cubic_closure_of_two_kernel pointQuotient pointQuotient_surjective
    (IsElementaryAbelian.isPGroup 2 (pointRadical (F := F))) hsLocal
  rw [sl2_cubic_closure_eq_top hF] at hsModel
  let := hsModel
  let : Group.IsSolvable (SpecialLinearGroup (Fin 2) F) :=
    Group.isSolvable_of_surjective (f := (⊤ : Subgroup (SpecialLinearGroup (Fin 2) F)).subtype)
      topEquiv.surjective
  let := NaturalExtension.model_perfect hF
  let := NaturalExtension.model_simple hF
  exact Group.IsPerfect.not_isSolvable (SpecialLinearGroup (Fin 2) F) inferInstance

/-- Every even-field plane parabolic has a nonsolvable cubic-generated subgroup. -/
theorem planeParabolic_cubic_not_solvable (hF : 2 < Nat.card F) :
    ¬ Group.IsSolvable (closure {x : planeParabolic (F := F) | orderOf x = 3}) := by
  intro hs
  have hsLocal := solvable_cubic_closure_of_injective (inclusion planeLocal_le)
    (inclusion_injective planeLocal_le) hs
  have hsModel := solvable_cubic_closure_of_two_kernel Plane.quotientMap Plane.quotientMap_surjective
    (IsElementaryAbelian.isPGroup 2 (Plane.radical (F := F))) hsLocal
  rw [sl2_cubic_closure_eq_top hF] at hsModel
  let := hsModel
  let : Group.IsSolvable (SpecialLinearGroup (Fin 2) F) :=
    Group.isSolvable_of_surjective (f := (⊤ : Subgroup (SpecialLinearGroup (Fin 2) F)).subtype)
      topEquiv.surjective
  let := NaturalExtension.model_perfect hF
  let := NaturalExtension.model_simple hF
  exact Group.IsPerfect.not_isSolvable (SpecialLinearGroup (Fin 2) F) inferInstance
end Theory.SpecificGroups.SymplecticFour
