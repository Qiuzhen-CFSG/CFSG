module
public import Theory.SpecificGroups.SymplecticFour.TransvectionRecognition.FieldExtraction.TraceField
public import Theory.Representation.InjectiveDescent

/-!
# Minimal coefficient-field symplectic models

The trace-field coordinates construct an actual representation over the
subfield generated by the original group traces, with an explicit equivalence
after coefficient extension. The normalized Gram matrix descends to an
invariant nondegenerate alternating form. Absolute irreducibility descends
through the same equivalence. Conversely, trace invariance places the trace
field inside every subfield admitting a coefficient model, so the constructed
field is minimal.

This supplies the coefficient-model and symplectic-form portion of
Aschbacher--Smith G.4.8, printed pp.340--341, for the actual irreducible
transvection-containing action. It does not classify the image subgroup.
-/

@[expose] public noncomputable section
open Module Matrix
open scoped TensorProduct
namespace Representation.TraceFieldDescent
variable {F G V : Type*} [Field F] [Group G] [AddCommGroup V] [Module F V]
  [FiniteDimensional F V]

/-- The intrinsic candidate for the smallest coefficient subfield. -/
def traceField (ρ : Representation F G V) : Subfield F :=
  Subfield.closure (Set.range (fun g => LinearMap.trace F V (ρ g)))

omit [FiniteDimensional F V] in
theorem trace_mem_traceField (ρ : Representation F G V) (g : G) :
    LinearMap.trace F V (ρ g) ∈ traceField ρ := Subfield.subset_closure (Set.mem_range_self g)

omit [FiniteDimensional F V] in
private theorem absolutelyIrreducible_of_equiv {W : Type*}
    [AddCommGroup W] [Module F W] {ρ : Representation F G V} {σ : Representation F G W}
    (e : ρ ≃ₗ σ) (h : IsAbsolutelyIrreducible ρ) : IsAbsolutelyIrreducible σ := by
  let E := AlgebraicClosure F
  let eE : extendScalars E ρ ≃ₗ extendScalars E σ :=
    .mk (e.toLinearEquiv.baseChange F E V W) (by
      intro g
      simpa only [LinearEquiv.coe_baseChange, extendScalars_apply,
        ←LinearMap.baseChange_comp] using congrArg (LinearMap.baseChange E) (e.isIntertwining' g))
  exact ⟨eE.irreducible_euqiv.mp h.irreducible_of_closure⟩

private theorem mapCoefficients_apply_subfield {ι : Type*} [Fintype ι] [DecidableEq ι]
    (K : Subfield F) (σ : Representation K G (ι → K)) (g : G) (v : ι → K) :
    mapCoefficients K.subtype σ g (fun i => (v i : F)) = (fun i => (σ g v i : F)) := by
  rw [←LinearMap.toMatrix'_mulVec (mapCoefficients K.subtype σ g)]
  rw [mapCoefficients_toMatrix]
  ext i
  exact (K.subtype.map_mulVec (LinearMap.toMatrix' (σ g)) v i).symm.trans
    (congrArg K.subtype (congrFun (LinearMap.toMatrix'_mulVec (σ g) v) i))

/-- A coefficient model together with an actual compatible alternating form. -/
structure Model (ρ : Representation F G V) (B : LinearMap.BilinForm F V) (K : Subfield F) where
  action : Representation K G (Fin (finrank F V) → K)
  equiv : (mapCoefficients K.subtype action).Equiv ρ
  absolute : action.IsAbsolutelyIrreducible
  form : LinearMap.BilinForm K (Fin (finrank F V) → K)
  alternating : form.IsAlt
  nondegenerate : form.Nondegenerate
  invariant : ∀ g v w, form (action g v) (action g w) = form v w
  scale : F
  scale_ne_zero : scale ≠ 0
  compatible : ∀ v w,
    (form v w : F) = scale * B (equiv (fun i => (v i : F))) (equiv (fun i => (w i : F)))

/-- Scalar extension of the returned model is the literal original action. -/
def Model.tensorEquiv {ρ : Representation F G V} {B : LinearMap.BilinForm F V}
    {K : Subfield F} (M : Model ρ B K) : extendScalars F M.action ≃ₗ ρ :=
  (extendScalarsMapCoefficientsEquiv (E := F) M.action).trans
    (RepEquiv.ofRepresentationEquiv M.equiv)

omit [FiniteDimensional F V] in
/-- Matrix-entry and compatible-form descent in a specified basis. -/
theorem model_of_basis_entries (ρ : Representation F G V) [ρ.IsIrreducible]
    (ha : ρ.IsAbsolutelyIrreducible) (B : LinearMap.BilinForm F V)
    (halt : B.IsAlt) (hB : B.Nondegenerate)
    (hp : ∀ g x y, B (ρ g x) (ρ g y) = B x y)
    (K : Subfield F) (b : Basis (Fin (finrank F V)) F V) (c : F) (hc : c ≠ 0)
    (hform : ∀ i j, (c • B) (b i) (b j) ∈ K)
    (hact : ∀ g i j, LinearMap.toMatrix b b (ρ g) i j ∈ K) :
    Nonempty (Model ρ B K) := by
  classical
  let τ : Representation F G (Fin (finrank F V) → F) :=
    b.equivFun.conjRingEquiv.toMonoidHom.comp ρ
  have hτ (g : G) : LinearMap.toMatrix' (τ g) = LinearMap.toMatrix b b (ρ g) := by
    ext i j
    change b.equivFun (ρ g (b.equivFun.symm (Pi.single j 1))) i = _
    have hbj : b.equivFun.symm (Pi.single j 1) = b j := by
      apply b.equivFun.injective
      simp
    rw [hbj,LinearMap.toMatrix_apply]
    rfl
  obtain ⟨σ,hσ⟩ := exists_mapCoefficients_eq_of_entries K.subtype K.subtype.injective τ
    (fun g i j => ⟨⟨LinearMap.toMatrix b b (ρ g) i j,hact g i j⟩,
      by rw [hτ]; rfl⟩)
  let e : (mapCoefficients K.subtype σ).Equiv ρ := .mk b.equivFun.symm (by
    intro g
    rw [hσ]
    apply LinearMap.ext
    intro v
    exact b.equivFun.symm_apply_apply (ρ g (b.equivFun.symm v)))
  have he (v : Fin (finrank F V) → F) : e v = b.equivFun.symm v := rfl
  let M : Matrix (Fin (finrank F V)) (Fin (finrank F V)) K :=
    fun i j => ⟨(c • B) (b i) (b j),hform i j⟩
  let C : LinearMap.BilinForm K (Fin (finrank F V) → K) := M.toBilin'
  have hM : M.map K.subtype = LinearMap.BilinForm.toMatrix b (c • B) := by
    ext i j
    simp only [Matrix.map_apply, LinearMap.BilinForm.toMatrix_apply]
    rfl
  have hcomp (v w : Fin (finrank F V) → K) :
      (C v w : F) = c * B (e (fun i => (v i : F))) (e (fun i => (w i : F))) := by
    rw [he,he]
    change K.subtype (M.toBilin' v w) = (c • B) (b.equivFun.symm _) (b.equivFun.symm _)
    rw [←LinearMap.BilinForm.dotProduct_toMatrix_mulVec, ←hM]
    simp only [Matrix.toBilin'_apply, dotProduct, Matrix.mulVec, map_sum, map_mul,
      Matrix.map_apply, Finset.mul_sum, mul_assoc]
    rfl
  have hnondeg : (c • B).Nondegenerate := by
    constructor
    · intro x hx
      exact hB.1 x (fun y => (mul_eq_zero.mp (hx y)).resolve_left hc)
    · intro y hy
      exact hB.2 y (fun x => (mul_eq_zero.mp (hy x)).resolve_left hc)
  have hdet : M.det ≠ 0 := by
    intro hz
    have hh := (LinearMap.BilinForm.nondegenerate_iff_det_ne_zero b).mp hnondeg
    apply hh
    rw [←hM]
    change (K.subtype.mapMatrix M).det = 0
    rw [←K.subtype.map_det,hz,map_zero]
  have habs : σ.IsAbsolutelyIrreducible := by
    let er := RepEquiv.ofRepresentationEquiv e
    have hext := (extendScalarsMapCoefficientsEquiv (E := F) σ).trans er
    have habsext : (extendScalars F σ).IsAbsolutelyIrreducible :=
      absolutelyIrreducible_of_equiv hext.symm ha
    exact (IsAbsolutelyIrreducible.isAbsolutelyIrreducible_iff_extendScalars σ F).mp habsext
  refine ⟨{
    action := σ
    equiv := e
    absolute := habs
    form := C
    alternating := ?_
    nondegenerate := (LinearMap.BilinForm.nondegenerate_toBilin'_iff_det_ne_zero).mpr hdet
    invariant := ?_
    scale := c
    scale_ne_zero := hc
    compatible := hcomp }⟩
  · intro v
    apply K.subtype.injective
    change (C v v : F) = 0
    rw [hcomp,halt.self_eq_zero,mul_zero]
  · intro g v w
    apply K.subtype.injective
    change (C (σ g v) (σ g w) : F) = (C v w : F)
    rw [hcomp,hcomp,←mapCoefficients_apply_subfield K σ g v,
      ←mapCoefficients_apply_subfield K σ g w]
    have hi (x) : e (mapCoefficients K.subtype σ g x) = ρ g (e x) :=
      LinearMap.congr_fun (e.isIntertwining' g) x
    rw [hi,hi,hp]

/-- An irreducible rank-one-containing symplectic action descends to every
subfield containing its traces, with a compatible alternating form. -/
theorem exists_model_over_trace_subfield
    (ρ : Representation F G V) [ρ.IsIrreducible] (t : G)
    (hr : finrank F (LinearMap.range (ρ t-1)) = 1)
    (B : LinearMap.BilinForm F V) (halt : B.IsAlt) (hB : B.Nondegenerate)
    (hp : ∀ g x y, B (ρ g x) (ρ g y) = B x y)
    (K : Subfield F) (hK : ∀ g, LinearMap.trace F V (ρ g) ∈ K) :
    Nonempty (Model ρ B K) := by
  obtain ⟨b,c,hc,hform,hact⟩ := exists_basis_over_trace_subfield ρ t hr B halt hB hp K hK
  exact model_of_basis_entries ρ (RankOneSchur.absolutelyIrreducible_of_rank_one ρ t hr)
    B halt hB hp K b c hc hform hact

/-- The generated trace subfield itself is a coefficient field, with an actual
scalar-extension equivalence and compatible symplectic form. -/
theorem exists_traceField_model
    (ρ : Representation F G V) [ρ.IsIrreducible] (t : G)
    (hr : finrank F (LinearMap.range (ρ t-1)) = 1)
    (B : LinearMap.BilinForm F V) (halt : B.IsAlt) (hB : B.Nondegenerate)
    (hp : ∀ g x y, B (ρ g x) (ρ g y) = B x y) :
    Nonempty (Model ρ B (traceField ρ)) :=
  exists_model_over_trace_subfield ρ t hr B halt hB hp (traceField ρ) (trace_mem_traceField ρ)

omit [FiniteDimensional F V] in
/-- Every coefficient model contains the intrinsic trace field. -/
theorem traceField_le_of_equiv {ι : Type*} [Fintype ι] [DecidableEq ι]
    (ρ : Representation F G V) (K : Subfield F)
    (σ : Representation K G (ι → K)) (e : (mapCoefficients K.subtype σ).Equiv ρ) :
    traceField ρ ≤ K := by
  apply Subfield.closure_le.mpr
  rintro x ⟨g,rfl⟩
  have he : e.toLinearEquiv.conj (mapCoefficients K.subtype σ g) = ρ g := by
    apply LinearMap.ext
    intro v
    have h := LinearMap.congr_fun (e.isIntertwining' g) (e.toLinearEquiv.symm v)
    change e.toLinearEquiv (mapCoefficients K.subtype σ g (e.toLinearEquiv.symm v)) =
      ρ g (e.toLinearEquiv (e.toLinearEquiv.symm v)) at h
    rw [e.toLinearEquiv.apply_symm_apply] at h
    exact h
  change LinearMap.trace F V (ρ g) ∈ K
  rw [←he, LinearMap.trace_conj',mapCoefficients_trace]
  exact (LinearMap.trace K _ (σ g)).property

omit [FiniteDimensional F V] in
/-- A returned compatible model contains the same minimal trace field. -/
theorem Model.minimal {ρ : Representation F G V} {B : LinearMap.BilinForm F V}
    {K : Subfield F} (M : Model ρ B K) : traceField ρ ≤ K :=
  traceField_le_of_equiv ρ K M.action M.equiv

end Representation.TraceFieldDescent
