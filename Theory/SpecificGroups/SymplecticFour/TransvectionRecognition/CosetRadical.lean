module
public import Theory.SpecificGroups.SymplecticFour.TransvectionRecognition.ThreeCenters
public import Theory.SpecificGroups.SymplecticFour.TransvectionRecognition.PointRadicalRoots
import Mathlib.Tactic.Group

/-!
# The radical branch of the commuting transvection coset argument

A characteristic-two involution preserving a transvection's moved line
centralizes the transvection. In the elementary abelian point radical,
every conjugate of a transvection commutes with that transvection; a
noncentral radical element therefore supplies a different moved line.
Conjugation by the subgroup generated by a normalizing coset preserves
that coset, giving the literal c₂ product in the original subgroup.

The final application retains the original three-center frame and the
actual point radical, with no assumption that its chosen element already
lies in X. It discharges the noncentral radical branch of the preliminary
claim in Aschbacher--Smith G.4.9, printed p.341. Existence in the remaining
central-radical case is a separate Dickson and Sylow argument.
-/

public noncomputable section
open Subgroup Module
namespace Theory.SpecificGroups.SymplecticFour.TransvectionRecognition
open InvolutionTypes InvolutionCentralizers
variable {F : Type*} [Field F] [CharP F 2]

omit [CharP F 2] in
private theorem commute_of_fixes_rank_one_center (a q : Sp F) (u : Vector F) (c : F)
    (ha : ∀ v, a • v=v+(c*form F u v) • u) (hqu : q • u=u) : Commute q a := by
  have he : q*a*q⁻¹=a := by
    apply FaithfulSMul.eq_of_smul_eq_smul (α := Vector F)
    intro v
    rw [rank_one_formula_conjugate a q u c ha,hqu,ha]
  have hh := congrArg (fun g : Sp F => g*q) he
  change q*a=a*q
  simpa only [mul_assoc,inv_mul_cancel,mul_one] using hh

/-- An involution preserving a transvection's moved line centralizes that
transvection in characteristic two. -/
theorem commute_of_sq_eq_one_movedSpace_conjugate (a q : Sp F)
    (ha : IsB1 a) (hq : q^2=1)
    (hm : movedSpace (q*a*q⁻¹)=movedSpace a) : Commute q a := by
  obtain ⟨u,c,hu,hc,haform⟩ := rank_one_formula a ha
  have hline := movedSpace_eq_span_center a u c hu hc haform
  have huM : u∈movedSpace a := by
    rw [hline]
    exact Submodule.subset_span (Set.mem_singleton u)
  have hquM : q • u∈movedSpace a := by
    rw [←hm,movedSpace_conj]
    exact ⟨u,huM,rfl⟩
  rw [hline] at hquM
  obtain ⟨k,hk⟩ := Submodule.mem_span_singleton.mp hquM
  have hksq : k^2=1 := by
    have he : q • (q • u)=u := by rw [←mul_smul,←pow_two,hq,one_smul]
    rw [←hk] at he
    have hlin : q • (k • u)=k • (q • u) := (toLinear q).map_smul k u
    rw [hlin,←hk,smul_smul] at he
    exact smul_left_injective F hu (by simpa only [pow_two,one_smul] using he)
  have hk1 : k=1 := CharTwo.sq_injective (hksq.trans (one_pow 2).symm)
  have hqu : q • u=u := by simpa only [hk1,one_smul] using hk.symm
  exact commute_of_fixes_rank_one_center a q u c haform hqu

/-- A transvection commutes with each conjugate by the elementary point radical. -/
theorem commute_pointRadical_conjugate (a q : pointLocal (F:=F))
    (ha : IsB1 a.val) (hq : q∈pointRadical) : Commute a (q*a*q⁻¹) := by
  have has : a*a=1 := Subtype.ext (by
    change a.val*a.val=1
    simpa only [ha.1,pow_two] using pow_orderOf_eq_one a.val)
  have hai : a⁻¹=a := inv_eq_iff_mul_eq_one.mpr has
  have hprod : a*(q*a*q⁻¹)∈pointRadical := by
    have h := pointRadical.mul_mem (pointRadical_normal.conj_mem q hq a)
      (pointRadical.inv_mem hq)
    simpa only [hai,mul_assoc] using h
  have hsq : (a*(q*a*q⁻¹))^2=1 :=
    congrArg Subtype.val (pointRadical_pow_two ⟨_,hprod⟩)
  have hi : (a*(q*a*q⁻¹))⁻¹=a*(q*a*q⁻¹) :=
    inv_eq_iff_mul_eq_one.mpr (by simpa only [pow_two] using hsq)
  change a*(q*a*q⁻¹)=(q*a*q⁻¹)*a
  simpa only [mul_inv_rev,inv_inv,hai,mul_assoc] using hi.symm

/-- A noncentral radical conjugate has a genuinely different transvection center. -/
theorem pointRadical_conjugate_movedSpace_ne (a q : pointLocal (F:=F))
    (ha : IsB1 a.val) (hq : q∈pointRadical) (hnc : ¬Commute q a) :
    movedSpace a.val≠movedSpace (q.val*a.val*q.val⁻¹) := by
  intro hm
  have hqs : q.val^2=1 := congrArg (fun t : pointLocal (F:=F) => t.val)
    (congrArg Subtype.val (pointRadical_pow_two ⟨q,hq⟩))
  have h := commute_of_sq_eq_one_movedSpace_conjugate a.val q.val ha hqs hm.symm
  exact hnc (Subtype.ext h.eq)

omit [CharP F 2] in
/-- A subgroup generated by elements of a normalizing coset preserves that
same coset under conjugation. -/
theorem conjugate_in_coset_of_mem_closure (X : Subgroup (Sp F)) (a : Sp F)
    (han : a∈normalizer (X : Set (Sp F))) (S : Set (Sp F))
    (hS : ∀ s∈S, a⁻¹*s∈X) (q : Sp F) (hq : q∈closure S) :
    a⁻¹*(q*a*q⁻¹)∈X := by
  have hn : ∀ g∈normalizer (X : Set (Sp F)), ∀ x∈X, g*x*g⁻¹∈X :=
    fun g hg x hx => (mem_normalizer_iff.mp hg x).mp hx
  have hmain : a⁻¹*q*a*q⁻¹∈X ∧ q∈normalizer (X : Set (Sp F)) := by
    induction hq using Subgroup.closure_induction with
    | mem g hg =>
      have hx := hS g hg
      have hg' : g=a*(a⁻¹*g) := by simp
      constructor
      · have hm := X.mul_mem hx (hn a han (a⁻¹*g)⁻¹ (X.inv_mem hx))
        convert hm using 1
        group
      · rw [hg']
        exact (normalizer (X : Set (Sp F))).mul_mem han (X.le_normalizer hx)
    | one => exact ⟨by simp,(normalizer (X : Set (Sp F))).one_mem⟩
    | mul g h _ _ hg hh =>
      constructor
      · have hm := X.mul_mem hg.1 (hn g hg.2 (a⁻¹*h*a*h⁻¹) hh.1)
        convert hm using 1
        group
      · exact (normalizer (X : Set (Sp F))).mul_mem hg.2 hh.2
    | inv g _ hg =>
      constructor
      · have hm := hn g⁻¹ ((normalizer (X : Set (Sp F))).inv_mem hg.2)
          (a⁻¹*g*a*g⁻¹)⁻¹ (X.inv_mem hg.1)
        convert hm using 1
        group
      · exact (normalizer (X : Set (Sp F))).inv_mem hg.2
  simpa only [mul_assoc] using hmain.1

/-- A radical element in the subgroup generated by aX gives the required
commuting coset witness whenever it moves a. -/
theorem exists_commuting_coset_of_generated_pointRadical (X : Subgroup (Sp F))
    (a q : pointLocal (F:=F)) (ha : IsB1 a.val)
    (han : a.val∈normalizer (X : Set (Sp F)))
    (S : Set (Sp F)) (hS : ∀ s∈S, a.val⁻¹*s∈X)
    (hqR : q∈pointRadical) (hqL : q.val∈closure S) (hnc : ¬Commute q a) :
    ∃ b : Sp F, IsB1 b ∧ a.val⁻¹*b∈X ∧ Commute a.val b ∧
      movedSpace a.val≠movedSpace b := by
  exact ⟨q.val*a.val*q.val⁻¹,(isB1_conj_iff q.val a.val).mpr ha,
    conjugate_in_coset_of_mem_closure X a.val han S hS q.val hqL,
    (commute_pointRadical_conjugate a q ha hqR).map pointLocal.subtype,
    pointRadical_conjugate_movedSpace_ne a q ha hqR hnc⟩

/-- The radical branch of the G.4.9 coset claim, in literal ambient matrices. -/
theorem exists_commuting_coset_of_pointRadical (X : Subgroup (Sp F))
    (a q : pointLocal (F:=F)) (ha : IsB1 a.val)
    (han : a.val∈normalizer (X : Set (Sp F)))
    (hqR : q∈pointRadical) (hqX : q.val∈X) (hnc : ¬Commute q a) :
    ∃ b : Sp F, IsB1 b ∧ a.val⁻¹*b∈X ∧ Commute a.val b ∧
      movedSpace a.val≠movedSpace b := by
  have hqa : a.val⁻¹*q.val*a.val∈X := by
    have h := (mem_normalizer_iff.mp ((normalizer (X : Set (Sp F))).inv_mem han)
      q.val).mp hqX
    simpa only [inv_inv] using h
  refine ⟨q.val*a.val*q.val⁻¹,(isB1_conj_iff q.val a.val).mpr ha,?_,?_,
    pointRadical_conjugate_movedSpace_ne a q ha hqR hnc⟩
  · simpa only [mul_assoc] using X.mul_mem hqa (X.inv_mem hqX)
  · exact (commute_pointRadical_conjugate a q ha hqR).map pointLocal.subtype

/-- The literal radical witness produces the c₂ member of X used by G.4.9. -/
theorem exists_isC2_mem_of_pointRadical (X : Subgroup (Sp F))
    (a q : pointLocal (F:=F)) (ha : IsB1 a.val)
    (han : a.val∈normalizer (X : Set (Sp F)))
    (hqR : q∈pointRadical) (hqX : q.val∈X) (hnc : ¬Commute q a) :
    ∃ b : Sp F, IsB1 b ∧ a.val⁻¹*b∈X ∧ Commute a.val b ∧
      a.val*b∈X ∧ IsC2 (a.val*b) := by
  obtain ⟨b,hb,hcoset,hcomm,hm⟩ :=
    exists_commuting_coset_of_pointRadical X a q ha han hqR hqX hnc
  exact ⟨b,hb,hcoset,hcomm,isC2_mem_of_commuting_coset X a.val b ha hb hcomm hm hcoset⟩

/-- In the original three-center frame, a radical element of the generated
subgroup that moves a supplies the source claim's literal c₂ element of X. -/
theorem ThreeCenterConfiguration.exists_isC2_of_radical
    {X : Subgroup (Sp F)} {a : Sp F} (D : ThreeCenterConfiguration X a)
    (ha : IsB1 a) (han : a∈normalizer (X : Set (Sp F))) (q : Sp F)
    (hq : q∈closure {a,(D.x : Sp F)*a*(D.x : Sp F)⁻¹,
      (D.y : Sp F)*a*(D.y : Sp F)⁻¹})
    (hqR : (⟨D.frame*q*D.frame⁻¹,
      D.local_containment ⟨q,hq,rfl⟩⟩ : pointLocal (F:=F))∈pointRadical)
    (hnc : ¬Commute q a) :
    ∃ b : Sp F, IsB1 b ∧ a⁻¹*b∈X ∧ Commute a b ∧ a*b∈X ∧ IsC2 (a*b) := by
  let f := (MulAut.conj D.frame).toMonoidHom
  have haL : f a∈pointLocal := D.local_containment ⟨a,subset_closure (by simp),rfl⟩
  let aL : pointLocal (F:=F) := ⟨f a,haL⟩
  let qL : pointLocal (F:=F) := ⟨f q,D.local_containment ⟨q,hq,rfl⟩⟩
  have haB : IsB1 aL.val := (isB1_conj_iff D.frame a).mpr ha
  have hqB : qL∈pointRadical := hqR
  have hcoset : a⁻¹*(q*a*q⁻¹)∈X :=
    conjugate_in_coset_of_mem_closure X a han _ (by
      intro s hs
      rcases hs with rfl | rfl | rfl
      · simp
      · exact D.conjugate_in_coset han D.x
      · exact D.conjugate_in_coset han D.y) q hq
  have hcomm : Commute a (q*a*q⁻¹) := by
    have h := (commute_pointRadical_conjugate aL qL haB hqB).map pointLocal.subtype
    change f a * (f q * f a * (f q)⁻¹)=(f q * f a * (f q)⁻¹)*f a at h
    change a*(q*a*q⁻¹)=(q*a*q⁻¹)*a
    apply (MulAut.conj D.frame).injective
    simpa only [f,MulEquiv.coe_toMonoidHom,map_mul,map_inv] using h
  have hqs : q^2=1 := by
    have hs : (f q)^2=1 := congrArg (fun t : pointLocal (F:=F) => t.val)
      (congrArg Subtype.val (pointRadical_pow_two ⟨qL,hqB⟩))
    apply (MulAut.conj D.frame).injective
    simpa only [f,MulEquiv.coe_toMonoidHom,map_pow,map_one] using hs
  have hm : movedSpace a≠movedSpace (q*a*q⁻¹) := fun he =>
    hnc (commute_of_sq_eq_one_movedSpace_conjugate a q ha hqs he.symm)
  have hb : IsB1 (q*a*q⁻¹) := (isB1_conj_iff q a).mpr ha
  exact ⟨q*a*q⁻¹,hb,hcoset,hcomm,
    isC2_mem_of_commuting_coset X a _ ha hb hcomm hm hcoset⟩

end Theory.SpecificGroups.SymplecticFour.TransvectionRecognition
