module
public import Theory.SpecificGroups.SymplecticFour.TransvectionRecognition.PerfectLayer
public import Theory.SpecificGroups.SymplecticFour.TransvectionRecognition.IrreducibleComponent
public import Theory.GroupTheory.GeneralizedFitting.PerfectLayerAlternative
public import Theory.Representation.Quotient
public import Theory.SpecificGroups.SymplecticFour.TransvectionRecognition.ComponentTensor.Ambient
public import Mathlib.GroupTheory.GroupAction.ConjAct
/-!
# The simple socle under the actual orthogonal exclusion

The layer of the literal transvection closure is a nontrivial perfect normal
subgroup, hence acts irreducibly by rank-one generation. A nonsimple layer
is generated by two commuting nontrivial perfect factors. Their constructed
tensor determinant gives a compatible quadratic form preserved by the full
symplectic normalizer, including the original pair. The actual quadratic
exclusion therefore forces a simple layer. The same irreducible component
is the generalized Fitting subgroup of the whole pair.

All statements retain the original field, action and literal subgroup maps.
This proves the simple-socle part of Aschbacher--Smith G.4.9, pp.341--342,
in the branch where the original geometry excludes an orthogonal group.
The c2 witness and subsequent model inspection are separate arguments.
-/

public noncomputable section
open Subgroup
namespace Theory.SpecificGroups.SymplecticFour.TransvectionRecognition
variable {F : Type*} [Field F]
variable {G : Type*} [Group G]

private theorem irreducible_image (f : G→*Sp F) (hf : Function.Injective f)
    (N : Subgroup G)
    (hi : Representation.IsIrreducible ((Representation.symplecticNatural 2).comp
      (f.comp N.subtype))) :
    Representation.IsIrreducible ((Representation.symplecticNatural 2).comp (N.map f).subtype) := by
  let e := N.equivMapOfInjective f hf
  apply (Representation.irreducible_comp_surjective_iff e.toMonoidHom e.surjective
    ((Representation.symplecticNatural 2).comp (N.map f).subtype)).mp
  exact hi

private theorem embedded_perfect_factors (f : G→*Sp F) (hf : Function.Injective f)
    (E A B : Subgroup G) [Group.IsPerfect A] [Group.IsPerfect B]
    (ha : A≠⊥) (hb : B≠⊥) (hgen : A⊔B=E) (hc : A≤centralizer (B:Set G)) :
    ∃ A₀ B₀ : Subgroup (E.map f),
      Group.IsPerfect A₀ ∧ Group.IsPerfect B₀ ∧ Nontrivial A₀ ∧ Nontrivial B₀ ∧
      A₀⊔B₀=⊤ ∧ ∀x:A₀,∀y:B₀,Commute (x:E.map f) (y:E.map f) := by
  have hAE : A≤E := hgen ▸ le_sup_left
  have hBE : B≤E := hgen ▸ le_sup_right
  let A' := A.subgroupOf E
  let B' := B.subgroupOf E
  let eA := (subgroupOfEquivOfLe hAE).symm
  let eB := (subgroupOfEquivOfLe hBE).symm
  let : Group.IsPerfect A' := Group.IsPerfect.ofSurjective (f:=eA.toMonoidHom) eA.surjective
  let : Group.IsPerfect B' := Group.IsPerfect.ofSurjective (f:=eB.toMonoidHom) eB.surjective
  let e := E.equivMapOfInjective f hf
  let A₀ := A'.map e.toMonoidHom
  let B₀ := B'.map e.toMonoidHom
  have hAp : Group.IsPerfect A₀ := Group.IsPerfect.map e.toMonoidHom
  have hBp : Group.IsPerfect B₀ := Group.IsPerfect.map e.toMonoidHom
  let : Nontrivial A := (nontrivial_iff_ne_bot A).mpr ha
  let : Nontrivial B := (nontrivial_iff_ne_bot B).mpr hb
  let : Nontrivial A' := eA.injective.nontrivial
  let : Nontrivial B' := eB.injective.nontrivial
  have hAn : Nontrivial A₀ := (A'.equivMapOfInjective e.toMonoidHom e.injective).injective.nontrivial
  have hBn : Nontrivial B₀ := (B'.equivMapOfInjective e.toMonoidHom e.injective).injective.nontrivial
  have hgen' : A'⊔B'=⊤ := by
    rw [←subgroupOf_sup hAE hBE,hgen,subgroupOf_self]
  have hgen₀ : A₀⊔B₀=⊤ := by
    rw [←Subgroup.map_sup,hgen',map_top_of_surjective _ e.surjective]
  refine ⟨A₀,B₀,hAp,hBp,hAn,hBn,hgen₀,?_⟩
  intro x y
  obtain ⟨a,ha,heA⟩ := x.property
  obtain ⟨b,hb,heB⟩ := y.property
  rw [←heA,←heB]
  exact (show Commute a b from Subtype.ext ((hc ha b hb).symm)).map e.toMonoidHom

open Theory.GroupTheory
variable [Finite F]

/-- The literal transvection closure has a simple irreducible generalized
Fitting subgroup once the actual ambient quadratic-form exclusion holds. -/
theorem transvectionClosure_simple_generalizedFitting
    (H : Subgroup (Sp F))
    (hi : Representation.IsIrreducible (((Representation.symplecticNatural 2).comp H.subtype).comp
      (transvectionClosure H).subtype))
    (hex : ∃h∈H,InvolutionTypes.IsB1 h)
    (hfit : fittingSubgroup (transvectionClosure H)=⊥)
    (hno : ∀Q:QuadraticForm F (Vector F),Q.polarBilin=form F →
      ¬∀g∈H,∀v:Vector F,Q (g•v)=Q v) :
    IsComponent (transvectionClosure H) (generalizedFitting (transvectionClosure H)) ∧
    IsSimpleGroup (generalizedFitting (transvectionClosure H)) ∧
    Representation.IsIrreducible
      ((((Representation.symplecticNatural 2).comp H.subtype).comp
        (transvectionClosure H).subtype).comp
          (generalizedFitting (transvectionClosure H)).subtype) := by
  let C := transvectionClosure H
  let E := componentLayer C
  let : Nontrivial C := (nontrivial_iff_ne_bot C).mpr (transvectionClosure_ne_bot H hex)
  let : Group.IsPerfect E := componentLayer_isPerfect
  have hEn : E≠⊥ := componentLayer_ne_bot_of_fitting_eq_bot hfit
  have hiE := closure_perfect_normal_irreducible H hi E hEn
  have hFE : generalizedFitting C=E := by
    rw [generalizedFitting,show fittingSubgroup C=⊥ from hfit,bot_sup_eq]
  suffices hs : IsComponent C E ∧ IsSimpleGroup E by
    rw [hFE]
    exact ⟨hs.1,hs.2,hiE⟩
  rcases componentLayer_simple_or_commuting_perfect hfit with hs | ⟨A,B,hA,hB,ha,hb,hgen,hc⟩
  · exact hs
  let : Group.IsPerfect A := hA
  let : Group.IsPerfect B := hB
  let f : C→*Sp F := H.subtype.comp C.subtype
  have hf : Function.Injective f := H.subtype_injective.comp C.subtype_injective
  let N := E.map f
  have hiN : Representation.IsIrreducible ((Representation.symplecticNatural 2).comp N.subtype) :=
    irreducible_image f hf E hiE
  obtain ⟨A₀,B₀,hA₀,hB₀,ha₀,hb₀,hgen₀,hc₀⟩ :=
    embedded_perfect_factors f hf E A B ha hb hgen hc
  let : Group.IsPerfect A₀ := hA₀
  let : Group.IsPerfect B₀ := hB₀
  let : Nontrivial A₀ := ha₀
  let : Nontrivial B₀ := hb₀
  obtain ⟨Q,hQ,hQI⟩ :=
    ComponentTensor.exists_normalizer_quadratic_of_commuting_perfect_factors N hiN A₀ B₀ hc₀ hgen₀
  let E' := E.map C.subtype
  let : E'.Normal := ConjAct.normal_of_characteristic_of_normal
  have hn : H≤normalizer (N:Set (Sp F)) := by
    have hh := E'.le_normalizer_map H.subtype
    rw [E'.normalizer_eq_top,←MonoidHom.range_eq_map,range_subtype] at hh
    simpa only [E',N,f,map_map] using hh
  exact (hno Q hQ (fun g hg=>hQI g (hn hg))).elim

/-- The simple socle is retained as its actual image in the original
symplectic group, including irreducibility and the full pair normalizer. -/
theorem transvectionClosure_simple_socle_image
    (H : Subgroup (Sp F))
    (hi : Representation.IsIrreducible (((Representation.symplecticNatural 2).comp H.subtype).comp
      (transvectionClosure H).subtype))
    (hex : ∃h∈H,InvolutionTypes.IsB1 h)
    (hfit : fittingSubgroup (transvectionClosure H)=⊥)
    (hno : ∀Q:QuadraticForm F (Vector F),Q.polarBilin=form F →
      ¬∀g∈H,∀v:Vector F,Q (g•v)=Q v) :
    let C := transvectionClosure H
    let N := (generalizedFitting C).map (H.subtype.comp C.subtype)
    IsSimpleGroup N ∧
      Representation.IsIrreducible ((Representation.symplecticNatural 2).comp N.subtype) ∧
      H≤normalizer (N:Set (Sp F)) := by
  dsimp only
  let C := transvectionClosure H
  let E := generalizedFitting C
  let f : C→*Sp F := H.subtype.comp C.subtype
  have hf : Function.Injective f := H.subtype_injective.comp C.subtype_injective
  obtain ⟨_,hs,hiE⟩ := transvectionClosure_simple_generalizedFitting H hi hex hfit hno
  let : IsSimpleGroup E := hs
  have hsN : IsSimpleGroup (E.map f) := (E.equivMapOfInjective f hf).symm.isSimpleGroup
  have hiN := irreducible_image f hf E hiE
  have hE : E=componentLayer C := by
    change generalizedFitting C=componentLayer C
    rw [generalizedFitting,show fittingSubgroup C=⊥ from hfit,bot_sup_eq]
  have hn : H≤normalizer (E.map f:Set (Sp F)) := by
    rw [hE]
    let E' := (componentLayer C).map C.subtype
    let : E'.Normal := ConjAct.normal_of_characteristic_of_normal
    have hh := E'.le_normalizer_map H.subtype
    rw [E'.normalizer_eq_top,←MonoidHom.range_eq_map,range_subtype] at hh
    simpa only [E',f,map_map] using hh
  exact ⟨hsN,hiN,hn⟩

/-- The same embedded simple socle is also F*(H), without adjoining a
transvection or adding a quotient premise. -/
theorem ambient_simple_generalizedFitting_of_transvections
    (H : Subgroup (Sp F))
    (hi : Representation.IsIrreducible (((Representation.symplecticNatural 2).comp H.subtype).comp
      (transvectionClosure H).subtype))
    (hex : ∃h∈H,InvolutionTypes.IsB1 h)
    (hfit : fittingSubgroup H=⊥)
    (hfitC : fittingSubgroup (transvectionClosure H)=⊥)
    (hno : ∀Q:QuadraticForm F (Vector F),Q.polarBilin=form F →
      ¬∀g∈H,∀v:Vector F,Q (g•v)=Q v) :
    generalizedFitting H=(generalizedFitting (transvectionClosure H)).map
      (transvectionClosure H).subtype ∧
    IsSimpleGroup (generalizedFitting H) ∧
    Representation.IsIrreducible (((Representation.symplecticNatural 2).comp H.subtype).comp
      (generalizedFitting H).subtype) := by
  let C := transvectionClosure H
  let E := generalizedFitting C
  let K := E.map C.subtype
  obtain ⟨hE,hs,hiE⟩ := transvectionClosure_simple_generalizedFitting H hi hex hfitC hno
  let : IsQuasisimple E := hE.2
  have hK : IsComponent H K :=
    ⟨hE.1.trans' (inferInstance : C.Normal).isSubnormal,
      IsQuasisimple.of_mulEquiv (E.equivMapOfInjective C.subtype C.subtype_injective)⟩
  let e := E.equivMapOfInjective C.subtype C.subtype_injective
  have hiK : Representation.IsIrreducible (((Representation.symplecticNatural 2).comp H.subtype).comp
      K.subtype) := by
    apply (Representation.irreducible_comp_surjective_iff e.toMonoidHom e.surjective
      (((Representation.symplecticNatural 2).comp H.subtype).comp K.subtype)).mp
    exact hiE
  have heq := generalizedFitting_eq_of_irreducible_component H K hK hiK hfit
  refine ⟨heq,?_,?_⟩
  · rw [heq]
    let : IsSimpleGroup E := hs
    exact e.symm.isSimpleGroup
  · rwa [heq]

end Theory.SpecificGroups.SymplecticFour.TransvectionRecognition
