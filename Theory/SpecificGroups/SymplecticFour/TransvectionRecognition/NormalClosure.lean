module
public import Theory.Representation.RankOneSymplectic.NormalFour
public import Theory.SpecificGroups.SymplecticFour.TwoConjugate.ImprimitiveExclusion

/-!
# The actual F-transvection normal closure

Inside an F-linearly irreducible subgroup of Sp4(F), generate the normal
subgroup by its literal rank-one involutions. The generic Clifford constituent
argument gives either irreducibility of that same normal subgroup or an actual
permuted orthogonal pair of planes. For the genuine moving opposite pair, the
proved imprimitive exclusion rules out the latter alternative.

This supplies the normal-closure reduction of Aschbacher--Smith G.4.6--7,
printed pp.339--340, to the original coefficient field. It identifies no
coefficient subfield or final recognized group.
-/

@[expose] public noncomputable section
open Subgroup Module Matrix
namespace Theory.SpecificGroups.SymplecticFour.TransvectionRecognition
open InvolutionTypes InvolutionCentralizers TwoConjugate
variable {F : Type*} [Field F]

/-- The actual subgroup generated by F-transvections inside H. -/
def transvectionClosure (H : Subgroup (Sp F)) : Subgroup H :=
  closure {h | IsB1 (h : Sp F)}

instance transvectionClosure_normal (H : Subgroup (Sp F)) : (transvectionClosure H).Normal := by
  apply normalizer_eq_top_iff.mp
  apply top_unique
  change (⊤ : Subgroup H) ≤ normalizer (↑(closure {h : H | IsB1 (h : Sp F)}))
  rw [le_normalizer_closure_iff]
  intro g _ d hd
  exact subset_closure ((isB1_conj_iff (g : Sp F) (d : Sp F)).mpr hd)

theorem transvectionClosure_ne_bot (H : Subgroup (Sp F))
    (hex : ∃ h∈H, IsB1 h) : transvectionClosure H≠⊥ := by
  obtain ⟨d,hd,hb⟩ := hex
  intro hbot
  have hm : (⟨d,hd⟩ : H)∈transvectionClosure H := subset_closure hb
  rw [hbot,mem_bot] at hm
  have he : d=1 := congrArg (fun x:H => (x:Sp F)) hm
  have ho := hb.1
  norm_num [he] at ho

/-- Marked transvections still generate after restricting to their closure. -/
theorem transvectionClosure_generated (H : Subgroup (Sp F)) :
    closure {d : transvectionClosure H | IsB1 ((d : H) : Sp F)}=⊤ := by
  apply (Subgroup.map_injective (transvectionClosure H).subtype_injective)
  rw [←MonoidHom.range_eq_map,range_subtype,MonoidHom.map_closure]
  have he : (transvectionClosure H).subtype ''
      {d : transvectionClosure H | IsB1 ((d : H) : Sp F)} =
        {d : H | IsB1 (d : Sp F)} := by
    ext d
    constructor
    · rintro ⟨x,hx,rfl⟩; exact hx
    · intro hd
      exact ⟨⟨d,subset_closure hd⟩,hd,rfl⟩
  rw [he]
  rfl

private theorem subgroup_action_faithful (H : Subgroup (Sp F)) :
    Function.Injective ((Representation.symplecticNatural 2).comp H.subtype) := by
  intro g h he
  apply Subtype.ext
  apply Subtype.ext
  ext i j
  have hh := congrArg (fun f : Module.End F (Vector F) => f (Pi.single j 1) i) he
  change ((g : Sp F).val *ᵥ Pi.single j 1) i = ((h : Sp F).val *ᵥ Pi.single j 1) i at hh
  simpa using hh

/-- The original F-transvection normal closure acts irreducibly unless H
permutes two literal orthogonal nondegenerate planes. -/
theorem transvectionClosure_irreducible_or_orthogonal_two
    (H : Subgroup (Sp F))
    (hi : Representation.IsIrreducible ((Representation.symplecticNatural 2).comp H.subtype))
    (hex : ∃ h∈H, IsB1 h) :
    Representation.IsIrreducible (((Representation.symplecticNatural 2).comp H.subtype).comp
      (transvectionClosure H).subtype) ∨
      ∃ D : OrthogonalTwoDecomposition F, ∀ h∈H, D.Permutes h := by
  let ρ : Representation F H (Vector F) := (Representation.symplecticNatural 2).comp H.subtype
  let : ρ.IsIrreducible := hi
  have hd : finrank F (Vector F)=4 := by simp [Vector]
  have hf : Function.Injective ρ := subgroup_action_faithful H
  have hp : ∀ h x y, form F (ρ h x) (ρ h y)=form F x y := by
    intro h x y
    exact preserves_form (F:=F) (h:Sp F) x y
  have hn := transvectionClosure_ne_bot H hex
  have hgen := transvectionClosure_generated H
  have hrank : ∀ d : transvectionClosure H, IsB1 ((d : H) : Sp F) →
      finrank F (LinearMap.range (ρ d-LinearMap.id))=1 := by
    intro d hd
    change finrank F (movedSpace ((d : H) : Sp F))=1
    exact hd.2
  have hfour := Representation.RankOneSymplectic.normal_four_dichotomy ρ
    hf (form F) TwoLocalCover.form_alternating TwoLocalCover.form_nondegenerate hp hd
    (transvectionClosure H) hn
    {d : transvectionClosure H | IsB1 ((d : H) : Sp F)} hgen hrank
  rcases hfour with hr | hd
  · exact Or.inl hr
  · right
    obtain ⟨U,hc,hu,hv,hperm⟩ := hd
    let D : OrthogonalTwoDecomposition F := {
      left := U
      right := (form F).orthogonal U
      isCompl := hc
      finrank_left := hu
      finrank_right := hv
      orthogonal := fun x hx y hy => hy x hx }
    refine ⟨D,fun h hh => ?_⟩
    apply (OrthogonalTwoDecomposition.permutes_iff D h).mpr
    rcases hperm ⟨h,hh⟩ with hp | hp
    · left
      constructor
      · intro x hx
        change ρ ⟨h,hh⟩ x∈U
        rw [←hp.1]
        exact ⟨x,hx,rfl⟩
      · intro x hx
        change ρ ⟨h,hh⟩ x∈(form F).orthogonal U
        rw [←hp.2]
        exact ⟨x,hx,rfl⟩
    · right
      constructor
      · intro x hx
        change ρ ⟨h,hh⟩ x∈(form F).orthogonal U
        rw [←hp.1]
        exact ⟨x,hx,rfl⟩
      · intro x hx
        change ρ ⟨h,hh⟩ x∈U
        rw [←hp.2]
        exact ⟨x,hx,rfl⟩

/-- In the genuine moving-actor pair, the transvections generate an
F-irreducible normal subgroup of the SAME pair. -/
theorem moving_pair_transvectionClosure_irreducible [CharP F 2] [Finite F]
    (hq : 2<Nat.card F) (a : EvenBorelTorus.ActorReduction.stabilizer (F:=F))
    (ha : ¬DiagramAutomorphisms.PreservesDiagram a.val)
    (V : Subgroup (Sp F)) [IsElementaryAbelian 2 V]
    (hV : V.map a.val.toMonoidHom=V)
    (hc : V≤(center (unipotent (F:=F))).map (unipotent (F:=F)).subtype)
    (hr : 2<Nat.card V) (hex : ∃ h∈oppositePair V, IsB1 h) :
    Representation.IsIrreducible ((pairAction V).comp (transvectionClosure (oppositePair V)).subtype) := by
  rcases transvectionClosure_irreducible_or_orthogonal_two (oppositePair V)
    (pairAction_irreducible_of_moving_actor hq a ha V hV hc hr) hex with hi | ⟨D,hD⟩
  · exact hi
  · exact (moving_pair_not_permute_orthogonal_two hq a ha V hV hc hr D hD).elim

end Theory.SpecificGroups.SymplecticFour.TransvectionRecognition
