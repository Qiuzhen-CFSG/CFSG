module
public import Theory.SpecificGroups.SymplecticFour.Sylow.CentralRootGeometry.TransvectionCommutator
public import Theory.SpecificGroups.SymplecticFour.Sylow.CentralRootGeometry.Thompson

/-!
# Normal quadratic generators in a symplectic two-subgroup

In the standard Sylow coordinates, a quadratic elementary generator with
nonzero first outside coordinate forces every normalizing element to have
zero second outside coordinate: apply quadraticity to its commutator with
that element. Otherwise every generator has zero first outside coordinate.
Thus the generated subgroup lies in one of the two elementary wings, each
of order q³. Sylow conjugation preserves the literal natural action and
transports the bound to every two-subgroup of Sp₄(q).

The radius-image application is
`NonbinarySymplectic.CriticalReduction.RadiusFour`.
Source: Meierfrankenfeld--Stellmacher (1993), (5.2), printed p.914.
-/

public noncomputable section
open Matrix Subgroup
open scoped commutatorElement
namespace Theory.SpecificGroups.SymplecticFour.NormalQuadratic
open CentralRootGeometry
variable {F : Type*} [Field F] [CharP F 2] [Finite F]

omit [Finite F] in
private theorem coordinate_constraint
    (A P : Subgroup (unipotent (F := F))) [IsElementaryAbelian 2 A]
    (hn : P ≤ normalizer (A : Set (unipotent (F := F))))
    (hq : ∀ x ∈ A, ∀ y ∈ A, ∀ v : Vector F,
      x.val • (y.val • v-v)=y.val • v-v)
    {b u w v : F} (hg : element b u w v ∈ A) (hb : b ≠ 0)
    {c z t a : F} (hh : element c z t a ∈ P) : a = 0 := by
  have hs := elemPow_eq_one_of_isElementaryAbelian (p := 2) _ hg
  rw [element_square,theta,←element_zero,element_eq_iff] at hs
  have hv : v = 0 := (mul_eq_zero.mp hs.2.2.1).resolve_left hb
  subst v
  have hc : ⁅element c z t a,element b u w 0⁆ ∈ A :=
    le_normalizer_iff_commutator_le_right.mp hn (commutator_mem_commutator hh hg)
  rw [element_commutator] at hc
  simp only [mul_zero,add_zero] at hc
  have he := congrFun (hq _ hg _ hc (Pi.single (.inr 0) 1)) (.inl 0)
  simp only [theta,smul_eq_mulVec,element_matrix] at he
  simp [Matrix.mulVec,dotProduct,Fintype.sum_sum_type,Fin.sum_univ_two,
    Matrix.fromBlocks,Pi.single_apply] at he
  exact he.resolve_left hb

/-- Normal quadratic generators of a subgroup of the standard Sylow lie
collectively in one elementary wing. -/
theorem sylow_generated_le_wing
    (P : Subgroup (unipotent (F := F))) {I : Sort*}
    (A : I → Subgroup (unipotent (F := F))) (hgen : P = ⨆ i, A i)
    (helem : ∀ i, IsElementaryAbelian 2 (A i))
    (hnorm : ∀ i, P ≤ normalizer (A i : Set (unipotent (F := F))))
    (hquad : ∀ i, ∀ x ∈ A i, ∀ y ∈ A i, ∀ v : Vector F,
      x.val • (y.val • v-v)=y.val • v-v) :
    P ≤ wing true ∨ P ≤ wing false := by
  by_cases hleft : ∀ i, A i ≤ wing true
  · left
    rw [hgen]
    exact iSup_le hleft
  · push Not at hleft
    obtain ⟨i,hi⟩ := hleft
    obtain ⟨g,hg,hgn⟩ := SetLike.not_le_iff_exists.mp hi
    obtain ⟨⟨b,u,w,v⟩,rfl⟩ := element_surjective g
    have hb : b ≠ 0 := by simpa only [element_mem_wing,ite_true] using hgn
    let := helem i
    right
    intro x hx
    obtain ⟨⟨c,z,t,a⟩,rfl⟩ := element_surjective x
    apply (element_mem_wing _ _ _ _ _).mpr
    exact coordinate_constraint (A i) P (hnorm i) (hquad i) hg hb hx

/-- Every two-subgroup of Sp₄ generated by normal quadratic elementary
subgroups has order at most q³. -/
theorem generated_card_le_cube {n : ℕ} (hF : Nat.card F = 2^n) (hn : 0 < n)
    (P : Subgroup (Sp F)) (hP : IsPGroup 2 P) {I : Sort*}
    (A : I → Subgroup (Sp F)) (hgen : P = ⨆ i, A i)
    (helem : ∀ i, IsElementaryAbelian 2 (A i))
    (hnorm : ∀ i, P ≤ normalizer (A i : Set (Sp F)))
    (hquad : ∀ i, ∀ x ∈ A i, ∀ y ∈ A i, ∀ v : Vector F,
      x • (y • v-v)=y • v-v) : Nat.card P ≤ Nat.card F ^ 3 := by
  obtain ⟨S,hS⟩ := hP.exists_le_sylow
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq (Sp F) S (unipotentSylow hF hn)
  let f := (MulAut.conj g).toMonoidHom
  have ht : P.map f ≤ unipotent := by
    have hh : (S : Subgroup (Sp F)).map f = unipotent :=
      congrArg (fun T : Sylow 2 (Sp F) => (T : Subgroup (Sp F))) hg
    exact hh ▸ map_mono hS
  let B := (P.map f).subgroupOf unipotent
  let C (i : I) := ((A i).map f).subgroupOf unipotent
  have hAi (i : I) : A i ≤ P := hgen ▸ le_iSup A i
  have hCt (i : I) : (A i).map f ≤ unipotent := (map_mono (hAi i)).trans ht
  have hCm (i : I) : (C i).map (unipotent (F := F)).subtype = (A i).map f :=
    map_subgroupOf_eq_of_le (hCt i)
  have hBm : B.map (unipotent (F := F)).subtype = P.map f :=
    map_subgroupOf_eq_of_le ht
  have hgen' : B = ⨆ i, C i := by
    apply Subgroup.map_injective (unipotent (F := F)).subtype_injective
    rw [hBm,Subgroup.map_iSup]
    simp only [hCm]
    rw [hgen,Subgroup.map_iSup]
  have hnorm' (i : I) : B ≤ normalizer (C i : Set (unipotent (F := F))) := by
    apply (comap_mono ((map_mono (hnorm i)).trans (le_normalizer_map f))).trans
    exact le_normalizer_comap (unipotent (F := F)).subtype
  have helem' (i : I) : IsElementaryAbelian 2 (C i) := by
    let := helem i
    let := IsElementaryAbelian.map (p := 2) (A := A i) f
    exact IsElementaryAbelian.subgroupOf (hCt i)
  have hquad' (i : I) (x : unipotent (F := F)) (hx : x ∈ C i)
      (y : unipotent (F := F)) (hy : y ∈ C i) (v : Vector F) :
      x.val • (y.val • v-v)=y.val • v-v := by
    obtain ⟨x₀,hx₀,hxe⟩ := hx
    obtain ⟨y₀,hy₀,hye⟩ := hy
    have hh := congrArg (fun w : Vector F => g • w) (hquad i x₀ hx₀ y₀ hy₀ (g⁻¹ • v))
    change g*x₀*g⁻¹=x.val at hxe
    change g*y₀*g⁻¹=y.val at hye
    rw [←hxe,←hye]
    simpa only [mul_smul,smul_sub,inv_smul_smul,smul_inv_smul] using hh
  have hbnd : Nat.card B ≤ Nat.card F^3 := by
    rcases sylow_generated_le_wing B C hgen' helem' hnorm' hquad' with hh | hh
    · exact (card_le_of_le hh).trans_eq (card_wing true)
    · exact (card_le_of_le hh).trans_eq (card_wing false)
  have hc : Nat.card B = Nat.card P := by
    rw [←card_map_of_injective (K := B) (unipotent (F := F)).subtype_injective,
      hBm,card_map_of_injective (MulAut.conj g).injective]
  rwa [hc] at hbnd

end Theory.SpecificGroups.SymplecticFour.NormalQuadratic
