module
public import Theory.SpecificGroups.SmallRankTwoPointMotion
public import Theory.GroupTheory.AbelianConjugateSpan
public import Theory.GroupTheory.SymmetricThreeThompsonSeed

/-!
# Point stabilizers through central covers of A₆

A local group with two-core quotient S₃ is normally generated by its Sylow
subgroup. Hence a central-kernel projection cannot conceal its containment
in a Sylow overgroup. The ordinary A₆ parabolic interval therefore descends
and lifts a point stabilizer avoiding both generating local groups.

For the action on the full conjugate span of a point, its stabilizer meets
the center of the faithful quotient trivially: a normal subgroup fixing the
point fixes its entire span. This supplies the precise lift condition without
assuming that a cubic cover has trivial center.

Consumer: the original point action in Aschbacher--Smith 13.2.12, p.882.
-/

public section
open Subgroup Stellmacher Theory.GroupTheory
open scoped IsMulCommutative
namespace Theory.SpecificGroups.SmallRankTwoPointMotion.CentralCover
variable {D Q : Type*} [Group D] [Finite D] [Group Q]

/-- Local Sylow normal generation lifts containment through a central kernel. -/
theorem map_le_of_central_kernel (q : D →* Q) (hk : q.ker ≤ center D)
    (S : Sylow 2 D) (A C : Subgroup D) (hSA : (S : Subgroup D) ≤ A)
    (hSC : (S : Subgroup D) ≤ C)
    (eA : (A ⧸ pCore 2 A) ≃* Equiv.Perm (Fin 3))
    (hAC : A.map q ≤ C.map q) : A ≤ C := by
  have hAn : A ≤ normalizer (C : Set D) := by
    have hh : A ≤ C ⊔ q.ker := by
      rw [←comap_map_eq]
      exact map_le_iff_le_comap.mp hAC
    exact hh.trans (sup_le C.le_normalizer (hk.trans (center_le_normalizer _)))
  let : (C.subgroupOf A).Normal := normal_subgroupOf_iff_le_normalizer_inf.mpr
    ((le_inf hAn A.le_normalizer).trans inf_normalizer_le_normalizer_inf)
  have ht : (⊤ : Subgroup A) ≤ C.subgroupOf A := by
    rw [←SymmetricThreeSeed.sylow_normally_generates (S.subtype hSA) eA]
    exact normalClosure_le_normal (fun x hx => hSC hx)
  exact fun a ha => ht (mem_top (⟨a,ha⟩ : A))

/-- A core-free point stabilizer avoiding both local generators is Sylow in a central A₆ cover. -/
theorem central_cover_point_stabilizer
    (q : D →* alternatingGroup (Fin 6)) (hq : Function.Surjective q)
    (hk : q.ker ≤ center D) (S : Sylow 2 D) (A B C : Subgroup D)
    (hSA : (S : Subgroup D) ≤ A) (hSB : (S : Subgroup D) ≤ B)
    (hgen : A ⊔ B = ⊤) (ha : Group.IsSolvable A) (hb : Group.IsSolvable B)
    (ea : (A ⧸ pCore 2 A) ≃* Equiv.Perm (Fin 3))
    (eb : (B ⧸ pCore 2 B) ≃* Equiv.Perm (Fin 3))
    (hSC : (S : Subgroup D) ≤ C) (hAC : ¬ A ≤ C) (hBC : ¬ B ≤ C)
    (hfaith : C ⊓ q.ker = ⊥) : C = (S : Subgroup D) := by
  let := ha
  let := hb
  have hproper (P : Subgroup D) [Group.IsSolvable P] : P.map q ≠ ⊤ := by
    intro ht
    let : Group.IsSolvable (alternatingGroup (Fin 6)) := Group.isSolvable_of_surjective
      (f := q.comp P.subtype) (MonoidHom.range_eq_top.mp (by
        rwa [MonoidHom.range_comp,range_subtype]))
    let : Group.IsPerfect (alternatingGroup (Fin 6)) :=
      ⟨commutator_alternatingGroup_eq_top (by simp)⟩
    exact Group.IsPerfect.not_isSolvable (alternatingGroup (Fin 6)) inferInstance
  have he := Theory.SpecificGroups.SmallRankTwoPointMotion.sylow_overgroup_eq_of_avoids_generators
    (Or.inr (Or.inl ⟨MulEquiv.refl _⟩)) (S.mapSurjective hq)
    (A.map q) (B.map q) (C.map q) (map_mono hSA) (map_mono hSB)
    (by rw [←Subgroup.map_sup,hgen,map_top_of_surjective _ hq])
    (hproper A) (hproper B) (map_mono hSC)
    (fun h => hAC (map_le_of_central_kernel q hk S A C hSA hSC ea h))
    (fun h => hBC (map_le_of_central_kernel q hk S B C hSB hSC eb h))
  apply le_antisymm ?_ hSC
  intro c hc
  obtain ⟨s,hs,heq⟩ := he.le (mem_map_of_mem q hc)
  have hk' : c * s⁻¹ ∈ C ⊓ q.ker :=
    ⟨C.mul_mem hc (C.inv_mem (hSC hs)), by
      change q (c * s⁻¹) = 1
      rw [map_mul,map_inv,heq, mul_inv_cancel]⟩
  have hcs : c = s := mul_inv_eq_one.mp (mem_bot.mp (hfaith ▸ hk'))
  exact hcs ▸ hs

omit [Finite D] in
/-- A point stabilizer meets the center of its full-span action quotient trivially. -/
theorem centralizer_seed_image_inf_center_eq_bot
    {J : Type*} [Group J] (x : J) (f : J →* D) (hf : Function.Surjective f)
    (hk : f.ker = centralizer (conjugateSpanBy (zpowers x) ⊤ : Set J)) :
    (centralizer ({x} : Set J)).map f ⊓ center D = ⊥ := by
  let C := centralizer ({x} : Set J)
  let N := C.map f ⊓ center D
  let : N.Normal := ⟨fun n hn g => by
    rw [(mem_center_iff.mp hn.2 g),mul_assoc,mul_inv_cancel,mul_one]
    exact hn⟩
  have hker : f.ker ≤ C := by
    rw [hk]
    exact centralizer_le (Set.singleton_subset_iff.mpr
      (le_conjugateSpanBy _ _ (mem_zpowers x)))
  have hn : N.comap f ≤ C := by
    have hh := comap_mono (f := f) (show N ≤ C.map f from inf_le_left)
    rwa [comap_map_eq_self hker] at hh
  have hspan : N.comap f ≤ centralizer (conjugateSpanBy (zpowers x) ⊤ : Set J) := by
    apply le_centralizer_conjugateSpanBy_of_normalizes _ _ _ le_normalizer_of_normal
    simpa only [zpowers_eq_closure,centralizer_closure] using hn
  rw [←hk] at hspan
  have hh := map_mono (f := f) hspan
  rw [map_comap_eq_self_of_surjective hf,map_ker_self] at hh
  exact le_bot_iff.mp hh
end Theory.SpecificGroups.SmallRankTwoPointMotion.CentralCover
