module
public import Theory.AtlasPort.LinearGroups.G2.HigherFieldResiduals
public import Theory.AtlasPort.LinearGroups.G2.SylowParabolicInvariance
public import Theory.AtlasPort.LinearGroups.G2.EvenLocal.ShortCore
public import Theory.AtlasPort.LinearGroups.G2.EvenLocal.LongCore
public import Theory.GroupTheory.GeneralizedFitting.SylowOvergroup
public import Theory.GroupTheory.GeneralizedFitting.CentralCoverLift
public import Theory.GroupTheory.PerfectCenterFrattini

/-!
# Invariant parabolic residuals in central covers of even G₂

The two root parabolics are intrinsic normalizers of characteristic subgroups
of the positive-root Sylow group. Their local residuals have characteristic
two. These properties lift along a surjection with two-group kernel; if the
source is perfect and the kernel central, the two lifted residuals generate
the source itself. The literal two-core quotients and nonzero core triple
commutators are retained from HigherFieldResiduals.

These are the model inputs for Aschbacher--Smith 15.1.20(3), printed p.1096,
including central two-covers of G₂(4). The underlying octonion calculations
are from the licensed ATLAS port, LICENSES/ATLAS.txt and
LICENSES/ATLAS-CITATION.cff.
-/

public section
open Subgroup Theory.GroupTheory
namespace Atlas.G2.HigherFieldResiduals
open LieParabolicSetup SylowParabolicInvariance
variable {F : Type*} [Field F] [CharP F 2]

/-- Every Sylow-preserving automorphism fixes each full root parabolic. -/
theorem parabolicAt_invariant (a : MulAut (Model F))
    (ha : unipotent.map a.toMonoidHom = unipotent) (i : Fin 2) :
    (parabolicAt (F := F) i).map a.toMonoidHom = parabolicAt i := by
  have hA := map_eq_of_centralInvolutions unipotent highestRoot
    highestRoot_iff_centralInvolution a ha
  have hB := map_eq_of_secondCentralInvolutions unipotent longRootLocal
    longRootLocal_iff_secondCentralInvolution a ha
  fin_cases i
  · change parabolic₁.map a.toMonoidHom = parabolic₁
    rw [← normalizer_highestRoot, map_equiv_normalizer_eq, hA]
  · change parabolic₂.map a.toMonoidHom = parabolic₂
    rw [← normalizer_longRootLocal, map_equiv_normalizer_eq, hB]

/-- The genuine rank-one local residuals have generalized Fitting subgroup O₂. -/
theorem localAt_generalizedFitting [Finite F] (i : Fin 2) :
    generalizedFitting (localAt (F := F) i) = pCore 2 (localAt (F := F) i) := by
  fin_cases i
  · exact generalizedFitting_eq_pCore_of_sylow_overgroup sylow local₁ parabolic₁
      unipotent_le_local₁ (by rw [←local₁_sup_borel]; exact le_sup_left)
      EvenLocal.parabolic₁_centralizer_pCore
  · exact generalizedFitting_eq_pCore_of_sylow_overgroup sylow local₂ parabolic₂
      unipotent_le_local₂ local₂_le_parabolic₂ EvenLocal.parabolic₂_centralizer_pCore

variable {X : Type*} [Group X] [Finite X] [Finite F]

/-- Characteristic two lifts to each actual preimage residual through its two-group kernel. -/
theorem preimage_residual_generalizedFitting
    (f : X →* Model F) (hf : Function.Surjective f) (hq : 2 < Nat.card F)
    (hk : IsPGroup 2 f.ker) (i : Fin 2) :
    let R := solvableResidual ((parabolicAt i).comap f)
    generalizedFitting R = pCore 2 R := by
  dsimp only
  let g := preimageResidualMap f hf hq i
  have hg := preimageResidualMap_surjective f hf hq i
  have hker := preimageResidualMap_ker_isTwoGroup f hf hq i hk
  apply le_antisymm _ ((pCore_le_fitting _ 2).trans (fitting_le_generalizedFitting _))
  have hh := map_generalizedFitting_le_of_surjective g hg
  rw [localAt_generalizedFitting] at hh
  have he := map_le_iff_le_comap.mp hh
  rwa [g.comap_pCore_of_ker_isPGroup hg hker] at he

/-- A perfect central cover is generated by the two literal lifted solvable residuals. -/
theorem preimage_residuals_generate [Group.IsPerfect X]
    (f : X →* Model F) (hf : Function.Surjective f) (hq : 2 < Nat.card F)
    (hc : f.ker ≤ center X) :
    (solvableResidual ((parabolicAt 0).comap f)).map ((parabolicAt 0).comap f).subtype ⊔
      (solvableResidual ((parabolicAt 1).comap f)).map ((parabolicAt 1).comap f).subtype = ⊤ := by
  let R := fun i : Fin 2 =>
    (solvableResidual ((parabolicAt i).comap f)).map ((parabolicAt i).comap f).subtype
  have hm : (R 0 ⊔ R 1).map f = ⊤ := by
    rw [Subgroup.map_sup,preimage_residual_image f hf hq 0,preimage_residual_image f hf hq 1]
    exact locals_generate
  have he := congrArg (Subgroup.comap f) hm
  rw [comap_map_eq,comap_top] at he
  exact eq_top_of_sup_center_eq_top (R 0 ⊔ R 1)
    (top_unique (he ▸ sup_le_sup_left hc _))

end Atlas.G2.HigherFieldResiduals
