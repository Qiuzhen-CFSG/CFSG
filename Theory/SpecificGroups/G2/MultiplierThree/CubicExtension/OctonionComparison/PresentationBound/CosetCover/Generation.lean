module

public import Theory.SpecificGroups.G2.MultiplierThree.CubicExtension.OctonionComparison.PresentationBound.CosetCover.Generation.Facts
public import Theory.SpecificGroups.G2.MultiplierThree.CubicExtension.OctonionComparison.PresentationBound.CosetCover.Generation.Outputs
public import Theory.SpecificGroups.G2.MultiplierThree.CubicExtension.OctonionComparison.PresentationBound.CosetCover.Lifting

/-!
# The protected max3 generators generate the literal Schreier presentation

Every one of the 367 raw labels lies in the subgroup generated by the two
protected labels. A recorded enumeration supplies paths; their translated
76,703 deductions are checked from the literal `RawRelations`, using free
identities and signed cyclic relator scans. Neither a permutation-image order
nor an ambient order bound is used.

The concrete application uses the already proved actual Schreier equations
in `Presentation.Presented` and identifies the protected labels with the
original max3 words. The parent coset-cover module owns the final cover assembly.

Source: ATLAS G23G1-P1 and G23G1-max3W1; see `Generation/source/README.md`
for the untrusted producer, kernel checks, and resource measurements.
-/

public section
namespace Atlas.G2.FiniteCover.MultiplierThree.CubicExtension.OctonionComparison.PresentationBound.SchreierCover

/-- The two literal protected words generate every raw Schreier label. -/
theorem generates_of_rawRelations {G : Type*} [Group G] (x : Label → G)
    (h : RawRelations x) :
    ∀ k, x k ∈ Subgroup.closure (Set.range fun b => x (protectedLabel b)) := by
  intro k
  obtain ⟨hp, hw⟩ := GenerationCertificate.output_spec k
  exact GenerationCertificate.output_mem x GenerationCertificate.representatives
    GenerationCertificate.representatives_zero GenerationCertificate.facts 76703
    (GenerationCertificate.all_facts x h) k (GenerationCertificate.outputs k.val) hp hw

/-- The actual Schreier elements lie in the actual max3 subgroup. This supplies
exactly the membership premise consumed by `coverOfMembership`. -/
theorem rawGenerator_mem_boundSubgroup (k : Label) : rawGenerator k ∈ boundSubgroup := by
  have h := generates_of_rawRelations rawGenerator rawRelations k
  have he : (fun b => rawGenerator (protectedLabel b)) = boundGenerator :=
    funext rawGenerator_protected
  simpa only [he, boundSubgroup] using h

end Atlas.G2.FiniteCover.MultiplierThree.CubicExtension.OctonionComparison.PresentationBound.SchreierCover
