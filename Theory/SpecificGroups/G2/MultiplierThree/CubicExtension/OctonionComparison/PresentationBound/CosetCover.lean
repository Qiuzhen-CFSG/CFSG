module

public import Theory.SpecificGroups.G2.MultiplierThree.CubicExtension.OctonionComparison.PresentationBound.Alphabet
public import Theory.SpecificGroups.G2.MultiplierThree.CubicExtension.OctonionComparison.PresentationBound.CosetCover.Generation
public import Theory.SpecificGroups.G2.MultiplierThree.CubicExtension.OctonionComparison.PresentationBound.CosetCover.Lifting

/-!
# The literal 364-coset cover

The checked generation theorem for the explicit 367-label Schreier presentation
places every label in the subgroup generated by its two protected max3 words.
Applying it to the actual Schreier elements in the original six-relator group
supplies the subgroup witnesses for all signed transitions among the 364
representatives. Thus `boundCosetCover` has no additional hypotheses.

The conditional constructor is retained for alternate generation proofs.
Source: the ATLAS presentation and max3 words documented in `Subgroup`.
-/

public section
namespace Atlas.G2.FiniteCover.MultiplierThree.CubicExtension.OctonionComparison.PresentationBound
open SchreierCover

/-- Apply an abstract Schreier-generation proof to the original presented group.
All source equations and both marked subgroup words are discharged here. -/
def boundCosetCoverOfSchreierGeneration
    (generate : ∀ {G : Type} [Group G] (x : Label → G), RawRelations x →
      ∀ k, x k ∈ Subgroup.closure (Set.range fun b => x (protectedLabel b))) :
    Subgroup.GeneratorCosetCover boundSubgroup Presentation.generator (Fin 364) :=
  coverOfMembership (by
    simpa only [rawGenerator_protected, boundSubgroup] using
      generate rawGenerator rawRelations)

/-- A 364-coset cover of the literal six-relator group by the fixed max3 subgroup.
The checked Schreier-generation theorem discharges the final transition premise. -/
def boundCosetCover :
    Subgroup.GeneratorCosetCover boundSubgroup Presentation.generator (Fin 364) :=
  boundCosetCoverOfSchreierGeneration generates_of_rawRelations

end Atlas.G2.FiniteCover.MultiplierThree.CubicExtension.OctonionComparison.PresentationBound
