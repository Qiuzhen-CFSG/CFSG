module

public import Theory.SpecificGroups.G2.MultiplierThree.CubicExtension.OctonionComparison.PresentationBound.LocalPresentation
public import Theory.SpecificGroups.G2.MultiplierThree.CubicExtension.OctonionComparison.PresentationBound.LocalOrder.Cover

/-!
# Order bound for the literal seven-relator local presentation

The kernel-checked coset certificate covers this presented group by 1,296 cosets
of the cyclic subgroup generated by `y`. The literal relation `y⁹ = 1` bounds
that subgroup by nine, giving finiteness and the bound `9 * 1296 = 11664`.
The final transfer theorem applies this unconditional local bound to the marked
ambient subgroup, retaining precisely the separately required lifted relations.

Source: the seven signed words in `LocalPresentation.lean` and the reproducible
coset trace `source/local_cover.json`. Its checker and soundness assembly are in
`LocalOrder/`; the untrusted producer alone supplies no mathematical conclusion.
-/

namespace Atlas.G2.FiniteCover.MultiplierThree.CubicExtension.OctonionComparison.PresentationBound

open Subgroup.CosetWordCertificate

/-- The fixed seven-relator presentation is finite of order at most 11,664. -/
public theorem finite_card_localPresented_le :
    Finite LocalPresented ∧ Nat.card LocalPresented ≤ 11664 := by
  let : Finite LocalOrder.cyclicSubgroup := LocalOrder.cyclicSubgroup_finite_card_le.1
  have h := LocalOrder.cover.finite_card_le
    (PresentedGroup.closure_range_of (Set.range localRelator))
  refine ⟨h.1, h.2.trans ?_⟩
  simpa using Nat.mul_le_mul_right 1296 LocalOrder.cyclicSubgroup_finite_card_le.2

/-- The local-order premise of the actual marked-subgroup consumer is discharged.
The remaining premise consists of identities in the original presentation. -/
public theorem finite_card_boundSubgroup_le_of_local_relators
    (hrel : ∀ i, eval boundGenerator (localRelatorLetters i) = 1) :
    Finite boundSubgroup ∧ Nat.card boundSubgroup ≤ 11664 :=
  finite_card_boundSubgroup_le_of_local hrel finite_card_localPresented_le

end Atlas.G2.FiniteCover.MultiplierThree.CubicExtension.OctonionComparison.PresentationBound
