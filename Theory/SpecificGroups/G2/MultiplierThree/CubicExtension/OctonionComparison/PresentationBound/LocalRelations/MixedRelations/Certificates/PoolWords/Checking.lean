@[expose] public section
namespace Atlas.G2.FiniteCover.MultiplierThree.CubicExtension.OctonionComparison.PresentationBound.LocalRelations.MixedRelations.Certificates.PoolWords
open Subgroup.CosetWordCertificate


def checkRange (f : Nat → Bool) (start count : Nat) : Bool :=
  (List.range count).all fun i => f (start + i)

theorem checkRange_sound {f : Nat → Bool} {start count : Nat}
    (h : checkRange f start count = true) (n : Nat)
    (hlo : start ≤ n) (hhi : n < start + count) : f n = true := by
  have hm : n - start ∈ List.range count := by simp only [List.mem_range]; omega
  have hn : start + (n - start) = n := by omega
  have hc := List.all_eq_true.mp h (n - start) hm
  rwa [hn] at hc

theorem joinRanges {f : Nat → Bool} {lo mid hi : Nat}
    (h₁ : ∀ n, lo ≤ n → n < mid → f n = true)
    (h₂ : ∀ n, mid ≤ n → n < hi → f n = true) :
    ∀ n, lo ≤ n → n < hi → f n = true := by
  intro n hlo hhi
  by_cases hn : n < mid
  · exact h₁ n hlo hn
  · exact h₂ n (by omega) hhi

def sourceCheck (k : Nat) : Bool :=
  let r := (pool word).source k
  word r.word == Replay.variant (sourceLetters r.relator) r.inverse r.offset

def reversalCheck (k : Nat) : Bool :=
  let r := (pool word).reversal k
  word r.2 == FreeGroup.invRev (word r.1)

def compositionCheck (k : Nat) : Bool :=
  let r := (pool word).composition k
  word r.2.2 == reduce (word r.1 ++ word r.2.1)

