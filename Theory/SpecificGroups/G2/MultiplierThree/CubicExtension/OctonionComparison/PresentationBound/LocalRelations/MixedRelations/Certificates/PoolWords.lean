/-!
# The literal word pool for the G₂(3) cyclic trace

All 164 source variants, 2,965 reversals and 14,812 reduced compositions
are checked as signed-list equalities. Shared literal segments keep the
kernel computation small. The exports `valid` and `outputs` supply the
word premises of the existing pooled cyclic-replay consumer; numeric trace
certification remains independent.

Source: the pinned ATLAS G23G1-P1 cyclic trace in
`Certificates/source/Pool.json`; see its accompanying README.
Generated by `PoolWords/source/Generate.py`. All computations are checked
by the ordinary Lean kernel.
-/

@[expose] public section
namespace Atlas.G2.FiniteCover.MultiplierThree.CubicExtension.OctonionComparison.PresentationBound.LocalRelations.MixedRelations.Certificates.PoolWords
open Subgroup.CosetWordCertificate

theorem sourceChecked : ∀ n, n < 164 → sourceCheck n = true :=
  fun n hn => sourceRange0 n (Nat.zero_le n) hn

theorem reversalChecked : ∀ n, n < 2965 → reversalCheck n = true :=
  fun n hn => (joinRanges reversalRange0 reversalRange2048) n (Nat.zero_le n) hn

theorem compositionChecked : ∀ n, n < 14812 → compositionCheck n = true :=
  fun n hn => (joinRanges (joinRanges (joinRanges compositionRange0 compositionRange2048) (joinRanges compositionRange4096 compositionRange6144)) (joinRanges (joinRanges compositionRange8192 compositionRange10240) (joinRanges compositionRange12288 compositionRange14336))) n (Nat.zero_le n) hn

/-- Every pooled rule is a literal identity of signed lists. -/
theorem valid : Pooled.Valid (pool word) where
  empty := by decide +kernel
  singleton := by
    have h : ∀ a : Fin 4, word ((pool word).singleton a) = [Pooled.letter a] := by
      decide +kernel
    exact fun a ha => h ⟨a, ha⟩
  cyclic := by decide +kernel
  source k hk := beq_iff_eq.mp (sourceChecked k hk)
  reversal k hk := beq_iff_eq.mp (reversalChecked k hk)
  composition k hk := beq_iff_eq.mp (compositionChecked k hk)

/-- The three output indices are the literal expansions of local words 3, 5 and 6. -/
theorem outputs : ∀ j : Fin 3, word (outputWordIndex j) =
    reduce (Replay.expand boundLetters (localRelatorLetters (![3, 5, 6] j))) := by
  intro j
  fin_cases j <;> apply beq_iff_eq.mp <;> decide +kernel

end Atlas.G2.FiniteCover.MultiplierThree.CubicExtension.OctonionComparison.PresentationBound.LocalRelations.MixedRelations.Certificates.PoolWords
