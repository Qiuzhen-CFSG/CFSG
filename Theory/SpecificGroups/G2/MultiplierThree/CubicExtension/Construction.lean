module

public import Theory.SpecificGroups.G2.MultiplierThree.CubicExtension.Presentation
public import Mathlib.GroupTheory.OrderOfElement

/-!
# A central extension from the six projective relations

Pair evaluation in an arbitrary group with the literal quotient of the free
group by the six source relations. The image projects onto the presented
group. If evaluation makes all six relations central, the projection has
central kernel. The corrected last relator lies in the derived subgroup;
its order is precisely its order under evaluation.

This supplies the assembly for the independent matrix calculation and
octonion comparison. It assumes neither a faithful projective representation
nor a group-order calculation for the group generated by the matrices.
Source: the ATLAS presentation cited in `Presentation.lean`.
-/

@[expose] public section
namespace Atlas.G2.FiniteCover.MultiplierThree.CubicExtension
open Presentation

universe u
variable {H : Type u} [Group H]

def paired (f : Free →* H) : Free →* H × Presented := f.prod toPresented

/-- The subgroup generated by paired evaluation and quotient images. -/
abbrev Extension (f : Free →* H) := (paired f).range

def liftWord (f : Free →* H) : Free →* Extension f := (paired f).rangeRestrict

def projection (f : Free →* H) : Extension f →* Presented :=
  (MonoidHom.snd H Presented).comp (paired f).range.subtype

@[simp] theorem projection_liftWord (f : Free →* H) (x : Free) :
    projection f (liftWord f x) = toPresented x := rfl

theorem projection_surjective (f : Free →* H) : Function.Surjective (projection f) := by
  intro x
  obtain ⟨w, rfl⟩ := toPresented_surjective x
  exact ⟨liftWord f w, rfl⟩

theorem projection_ker_le_center (f : Free →* H)
    (hc : ∀ i, f (relator i) ∈ Subgroup.center H) :
    (projection f).ker ≤ Subgroup.center (Extension f) := by
  have hR : Subgroup.normalClosure (Set.range relator) ≤ (Subgroup.center H).comap f := by
    apply Subgroup.normalClosure_le_normal
    rintro _ ⟨i, rfl⟩
    exact hc i
  intro x hx
  obtain ⟨w, rfl⟩ := (paired f).rangeRestrict_surjective x
  have hw : w ∈ Subgroup.normalClosure (Set.range relator) :=
    PresentedGroup.mk_eq_one_iff.mp hx
  apply Subgroup.mem_center_iff.mpr
  intro y
  apply Subtype.ext
  apply Prod.ext
  · exact Subgroup.mem_center_iff.mp (hR hw) y.val.1
  · change y.val.2 * toPresented w = toPresented w * y.val.2
    change toPresented w = 1 at hx
    simp only [hx, mul_one, one_mul]

def liftedDefect (f : Free →* H) : Extension f := liftWord f defect

theorem liftedDefect_mem_kernel (f : Free →* H) :
    liftedDefect f ∈ (projection f).ker := toPresented_defect

theorem liftedDefect_mem_commutator (f : Free →* H) :
    liftedDefect f ∈ commutator (Extension f) := by
  have hmap : (commutator Free).map (liftWord f) ≤ commutator (Extension f) := by
    rw [map_commutator_eq]
    exact Subgroup.commutator_mono le_top le_top
  exact hmap ⟨defect, defect_mem_commutator, rfl⟩

theorem orderOf_liftedDefect (f : Free →* H) :
    orderOf (liftedDefect f) = orderOf (f defect) := by
  rw [← Subgroup.orderOf_coe]
  change orderOf (f defect, toPresented defect) = orderOf (f defect)
  simp only [toPresented_defect, Prod.orderOf_mk, orderOf_one, Nat.lcm_one_right]

end Atlas.G2.FiniteCover.MultiplierThree.CubicExtension
