module

public import Theory.SpecificGroups.G2.MultiplierThree.UpperBound.OrthogonalDefect
public import Theory.SpecificGroups.G2.MultiplierThree.UpperBound.CubicRelations.Collection

/-!
# The three-primary upper bound for the actual G₂(3) universal kernel

Choose torus-equivariant additive root sections and quotient the covering
group by the cyclic subgroup generated by their B/D commutator. The quotient
remains a central extension, its induced sections remain equivariant, and
its orthogonal defect is trivial. The collection theorem therefore gives
the exact A–F product law in the quotient, so every original product error
belongs to the specified cyclic subgroup.

The defect has cube one by `OrthogonalDefect`. The existing local unipotent
lift and transfer consumer consequently exclude divisibility by nine in the
literal universal kernel. No nontriviality of the defect is needed.

Source: Aschbacher–Smith I.1.4(2), printed p.408 (PDF p.419); GLS3 §§6.1,
6.3 and its reference [Gr1]. The concrete octonion root coordinates are the
attributed ATLAS port (LICENSES/ATLAS.txt and LICENSES/ATLAS-CITATION.cff).
-/

@[expose] public section
open scoped commutatorElement
namespace Atlas.G2.FiniteCover.MultiplierThree.CubicRelations
open MultiplierOrdinary MultiplierOrdinary.RootSections
variable {E : Type*} [Group E] {f : E →* Model (ZMod 3)}

/-- All multiplication errors of normalized sections belong to the cyclic
subgroup generated by the literal B/D commutator. -/
theorem productCompatibleModulo (L : RootSections f) (hL : L.TorusEquivariant)
    (hf : Function.Surjective f) (hk : f.ker ≤ Subgroup.center E) :
    L.ProductCompatibleModulo (Subgroup.zpowers (orthogonalDefect L)) := by
  let N := Subgroup.zpowers (orthogonalDefect L)
  have hN : N ≤ f.ker := Subgroup.zpowers_le.mpr (orthogonalDefect_mem_kernel L)
  let : N.Normal := ⟨fun x hx y => by
    rw [Subgroup.mem_center_iff.mp (hk (hN hx)) y, mul_inv_cancel_right]
    exact hx⟩
  let q := QuotientGroup.mk' N
  let g := QuotientGroup.lift N f hN
  have hg (x : E) : g (q x) = f x := rfl
  have hgs : Function.Surjective g := by
    intro x
    obtain ⟨y, hy⟩ := hf x
    exact ⟨q y, hy⟩
  have hgk : g.ker ≤ Subgroup.center (E ⧸ N) := by
    intro x hx
    obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective N x
    have ha : a ∈ f.ker := hx
    rw [Subgroup.mem_center_iff]
    intro y
    obtain ⟨b, rfl⟩ := QuotientGroup.mk'_surjective N y
    simpa only [map_mul] using congrArg q (Subgroup.mem_center_iff.mp (hk ha) b)
  let M : RootSections g := {
    root := fun i => q.comp (L.root i)
    project := fun i => MonoidHom.ext (fun t => DFunLike.congr_fun (L.project i) t) }
  have hx (i : Fin 6) (t : ZMod 3) : M.x i t = q (L.x i t) := rfl
  have hM : M.TorusEquivariant := by
    intro l m z hz i t
    obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective N z
    rw [hx, hx, ← map_inv, ← map_mul, ← map_mul]
    exact congrArg q (hL l m a hz i t)
  have hd : orthogonalDefect M = 1 := by
    change ⁅q (L.x 1 1), q (L.x 3 1)⁆ = 1
    rw [← map_commutatorElement]
    exact (QuotientGroup.eq_one_iff _).mpr (Subgroup.mem_zpowers _)
  have hprod (t : Fin 6 → ZMod 3) : M.product t = q (L.product t) := by
    simp only [product, M, MonoidHom.comp_apply, map_mul]
  have hcomp := (collection_of_defect_one M hM hgs hgk hd).productCompatible M
  intro t u
  apply (QuotientGroup.eq_one_iff _).mp
  change q (L.product t * L.product u * (L.product (unipotentProductParameters t u))⁻¹) = 1
  rw [map_mul, map_mul, map_inv, ← hprod, ← hprod, ← hprod, hcomp, mul_inv_cancel]

/-- Construct compatible-modulo-defect sections in any central extension
of the actual ternary octonion group. -/
theorem exists_sections (f : E →* Model (ZMod 3)) (hf : Function.Surjective f)
    (hk : f.ker ≤ Subgroup.center E) :
    ∃ L : RootSections f,
      L.ProductCompatibleModulo (Subgroup.zpowers (orthogonalDefect L)) := by
  obtain ⟨L, hL⟩ := prime_torusEquivariant_sections (p := 3) (by simp) (by decide) f hf hk
  exact ⟨L, productCompatibleModulo L hL hf hk⟩

/-- The constructed sections on the prescribed universal projection. -/
theorem universal_sections :
    ∃ L : RootSections (PerfectCentralCovering.universalProjection (Model (ZMod 3))),
      L.ProductCompatibleModulo (Subgroup.zpowers (orthogonalDefect L)) :=
  exists_sections _ (PerfectCentralCovering.universalProjection_surjective _)
    (PerfectCentralCovering.universalProjection_ker_le_center _)

/-- The unconditional three-primary upper bound on the literal universal kernel. -/
theorem not_nine_dvd_kernel : ¬ 9 ∣ Nat.card (Kernel (ZMod 3)) := by
  obtain ⟨L, hL⟩ := universal_sections
  exact not_nine_dvd_kernel_of_orthogonal_defect (PerfectCentralCovering.universalCover _) L hL

end Atlas.G2.FiniteCover.MultiplierThree.CubicRelations
end
