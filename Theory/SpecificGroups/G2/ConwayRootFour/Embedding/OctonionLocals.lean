module

public import Theory.Representation.FirstCohomologyG2Natural.BinaryPair
public import Theory.SpecificGroups.G2.PRegularClasses.RationalFusion.CentralizerLang.ConnectedNoFixedWeight.BlockRealization.Algebra
public import Theory.SpecificGroups.G2.FiniteUniversalCover


/-!
# Concrete local generators for the octonion G₂ model

In characteristic two, the off-diagonal coordinates identify the natural
trace-zero quotient with six-tuples. We record the actions of the determinant-one
Peirce blocks, the short-root family C(t), and its Weyl reflection. The blocks
and reflection generate one local subgroup; C(t) and the same reflection
generate the other. Together they generate every octonion automorphism: the
blocks supply the long roots and torus, and Weyl conjugation supplies the
remaining short roots. Over GF(4) the six-dimensional action is faithful.

This proves the octonion side of the local comparison in Aschbacher,
*Sporadic Groups* (1994), Lemma 49.5, printed pp.283–284/PDF147–148.
No Leech subgroup or identification with the source root-four class is asserted.
The Conway consumer is `Embedding.LocalGeometry` and the range comparison in
`Embedding`. The octonion constructions are existing attributed ATLAS ports;
no new upstream source is copied here.
-/

@[expose] public section

open Atlas.SplitOctonion Atlas.G2.Explicit Matrix
open scoped MatrixGroups
namespace Atlas.G2.ConwayRootFour.OctonionLocals
open Natural
open PRegularClasses.RationalFusion.CentralizerLang.NoFixedWeight
variable {F : Type*} [Field F] [CharP F 2]

/-- Coordinates 0, 1, 2, 5, 6, 7 of a trace-zero octonion. -/
abbrev Six (F : Type*) := Fin 6 → F

def liftSix (v : Six F) : TraceZero F :=
  ⟨![v 0,v 1,v 2,0,0,v 3,v 4,v 5], by simp [mem_traceZero, SplitOctonion.trace]⟩

/-- The literal natural quotient, with its off-diagonal coordinates. -/
noncomputable def coordinates : Space F ≃ₗ[F] Six F :=
  LinearEquiv.ofBijective (binaryCoordinates F) ⟨binaryCoordinates_injective F, by
    intro v
    refine ⟨mk F (liftSix v), ?_⟩
    ext i
    fin_cases i <;> rfl⟩

theorem coordinates_mk (x : TraceZero F) :
    coordinates (mk F x) = ![x.val 0,x.val 1,x.val 2,x.val 5,x.val 6,x.val 7] := rfl

theorem coordinates_symm (v : Six F) :
    coordinates.symm v = mk F (liftSix v) := by
  apply coordinates.injective
  rw [LinearEquiv.apply_symm_apply, coordinates_mk]
  ext i
  fin_cases i <;> rfl

/-- The actual octonion action in six coordinates. -/
noncomputable def action : Model F →* (Six F ≃ₗ[F] Six F) :=
  (LinearMap.GeneralLinearGroup.generalLinearEquiv F (Six F)).toMonoidHom.comp
    (Representation.asGroupHom (coordinates.conjRingEquiv.toMonoidHom.comp (Natural.action F)))

theorem action_apply (g : Model F) (v : Six F) :
    action g v = coordinates (Natural.action F g (coordinates.symm v)) := rfl

theorem action_lift (g : Model F) (v : Six F) :
    action g v = binaryOffDiagonal F (g.val (liftSix v).val) := by
  rw [action_apply, coordinates_symm, Natural.action_mk, coordinates_mk]
  rfl

theorem action_rootC (a : F) (v : Six F) :
    action (rootC a) v = ![v 0+a^2*v 5,v 1+a*v 3,v 2+a*v 4,v 3,v 4,v 5] := by
  rw [action_lift]
  ext i
  fin_cases i <;> simp [binaryOffDiagonal, liftSix, rootC, rootCEquiv, rootCLinear,
    rootCApply, CharTwo.sub_eq_add]

/-- The short-root Weyl reflection, interchanging the two Peirce spaces. -/
noncomputable def graph : Model F := weylS * weylR * weylS * weylR * weylS

theorem graph_apply (x : Carrier F) :
    (graph : Model F).val x = ![x 7,x 5,x 6,x 4,x 3,x 1,x 2,x 0] := by
  ext i
  fin_cases i <;> simp [graph, weylS, weylSEquiv, weylSLinear, weylSApply,
    weylR, weylREquiv, weylRLinear, weylRApply, CharTwo.neg_eq]

theorem action_graph (v : Six F) :
    action graph v = ![v 5,v 3,v 4,v 1,v 2,v 0] := by
  rw [action_lift, graph_apply]
  ext i
  fin_cases i <;> rfl

theorem action_block (A : SL(3,F)) (v : Six F) :
    action (BlockRealization.blockHom A) v =
      let u := A.val *ᵥ ![v 0,v 3,v 4]
      let w := BlockRealization.cofactor A.val *ᵥ ![v 5,v 2,v 1]
      ![u 0,w 2,w 1,u 1,u 2,w 0] := by
  rw [action_lift]
  rfl

/-- The canonical GF(4) octonion model acts faithfully on these six coordinates. -/
theorem action_four_injective : Function.Injective (action (F := FiniteCover.FourField)) := by
  apply (MonoidHom.ker_eq_bot_iff _).mp
  rcases (inferInstance : (action (F := FiniteCover.FourField)).ker.Normal).eq_bot_or_eq_top
      with h | h
  · exact h
  · have hc : rootC (1 : FiniteCover.FourField) ∈ (action (F := FiniteCover.FourField)).ker := by
      rw [h]
      trivial
    have he := congrArg (fun g : Six FiniteCover.FourField ≃ₗ[FiniteCover.FourField]
      Six FiniteCover.FourField => g ![0,0,0,0,0,1] 0) (MonoidHom.mem_ker.mp hc)
    rw [action_rootC] at he
    simp at he

/-- The subgroup generated by the Peirce SL₃ and the graph involution. -/
noncomputable def longLocal : Subgroup (Model F) :=
  BlockRealization.blockHom.range ⊔ Subgroup.zpowers graph

/-- The subgroup generated by C(t) and its Weyl reflection. -/
noncomputable def shortLocal : Subgroup (Model F) :=
  Subgroup.closure (Set.range (rootC (K := F))) ⊔ Subgroup.zpowers graph

private def flipMatrix : SL(3,F) :=
  ⟨!![1,0,0;0,0,1;0,1,0], by simp [Matrix.det_fin_three, CharTwo.neg_eq]⟩

private def cycleMatrix : SL(3,F) :=
  ⟨!![0,1,0;0,0,1;1,0,0], by simp [Matrix.det_fin_three]⟩

private theorem block_flip : BlockRealization.blockHom (flipMatrix (F := F)) = weylR := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro x
  ext i
  fin_cases i <;> simp [BlockRealization.blockHom, BlockRealization.blockEquiv,
    BlockRealization.blockLinear, BlockRealization.pack, BlockRealization.cofactor,
    flipMatrix, Matrix.adjugate_fin_three, Matrix.mulVec, dotProduct, Fin.sum_univ_three,
    weylR, weylREquiv, weylRLinear, weylRApply, CharTwo.neg_eq]

private theorem block_cycle_graph :
    BlockRealization.blockHom (cycleMatrix (F := F)) * graph = weylS := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro x
  change (BlockRealization.blockHom _).val (graph.val x) = _
  rw [graph_apply]
  ext i
  fin_cases i <;> simp [BlockRealization.blockHom, BlockRealization.blockEquiv,
    BlockRealization.blockLinear, BlockRealization.pack, BlockRealization.cofactor,
    cycleMatrix, Matrix.adjugate_fin_three, Matrix.mulVec, dotProduct, Fin.sum_univ_three,
    weylS, weylSEquiv, weylSLinear, weylSApply, CharTwo.neg_eq]

private theorem block_rootA (a : F) :
    BlockRealization.blockHom (Matrix.SpecialLinearGroup.transvection
      (by decide : (0 : Fin 3) ≠ 2) a) = rootA a := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro x
  ext i
  fin_cases i <;> simp [BlockRealization.blockHom, BlockRealization.blockEquiv,
    BlockRealization.blockLinear, BlockRealization.pack, BlockRealization.cofactor,
    Matrix.SpecialLinearGroup.transvection, Matrix.transvection,
    Matrix.adjugate_fin_three, Matrix.mulVec, dotProduct, Fin.sum_univ_three,
    rootA, rootAEquiv, rootALinear, rootAApply, CharTwo.neg_eq, CharTwo.sub_eq_add]
  ring

private theorem block_rootB (a : F) :
    BlockRealization.blockHom (Matrix.SpecialLinearGroup.transvection
      (by decide : (0 : Fin 3) ≠ 1) a) = rootB a := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro x
  ext i
  fin_cases i <;> simp [BlockRealization.blockHom, BlockRealization.blockEquiv,
    BlockRealization.blockLinear, BlockRealization.pack, BlockRealization.cofactor,
    Matrix.SpecialLinearGroup.transvection, Matrix.transvection,
    Matrix.adjugate_fin_three, Matrix.mulVec, dotProduct, Fin.sum_univ_three,
    rootB, rootBEquiv, rootBLinear, rootBApply, CharTwo.neg_eq, CharTwo.sub_eq_add]
  ring

private theorem block_rootE (a : F) :
    BlockRealization.blockHom (Matrix.SpecialLinearGroup.transvection
      (by decide : (1 : Fin 3) ≠ 2) a) = rootE a := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro x
  ext i
  fin_cases i <;> simp [BlockRealization.blockHom, BlockRealization.blockEquiv,
    BlockRealization.blockLinear, BlockRealization.pack, BlockRealization.cofactor,
    Matrix.SpecialLinearGroup.transvection, Matrix.transvection,
    Matrix.adjugate_fin_three, Matrix.mulVec, dotProduct, Fin.sum_univ_three,
    rootE, rootEEquiv, rootELinear, rootEApply, CharTwo.neg_eq, CharTwo.sub_eq_add]
  ring

private theorem rootD_conjugate (a : F) : weylS * rootC a * weylS⁻¹ = rootD a := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro x
  ext i
  fin_cases i <;> simp [weylS, weylSEquiv, weylSLinear, weylSApply,
    rootC, rootCEquiv, rootCLinear, rootCApply,
    rootD, rootDEquiv, rootDLinear, rootDApply, CharTwo.neg_eq, CharTwo.sub_eq_add]
  ring

private theorem rootF_conjugate (a : F) : weylR * rootD a * weylR⁻¹ = rootF a := by
  apply Subtype.ext
  apply LinearEquiv.ext
  intro x
  ext i
  fin_cases i <;> simp [weylR, weylREquiv, weylRLinear, weylRApply,
    rootD, rootDEquiv, rootDLinear, rootDApply,
    rootF, rootFEquiv, rootFLinear, rootFApply, CharTwo.neg_eq, CharTwo.sub_eq_add]

/-- These concrete local subgroups generate the full octonion group. -/
theorem locals_generate : longLocal (F := F) ⊔ shortLocal = ⊤ := by
  let H : Subgroup (Model F) := longLocal ⊔ shortLocal
  have hblock (A : SL(3,F)) : BlockRealization.blockHom A ∈ H :=
    (show BlockRealization.blockHom.range ≤ H from le_trans le_sup_left le_sup_left) ⟨A, rfl⟩
  have hgraph : (graph : Model F) ∈ H :=
    (show Subgroup.zpowers graph ≤ H from le_trans le_sup_right le_sup_left) (Subgroup.mem_zpowers _)
  have hC (a : F) : rootC a ∈ H :=
    (show Subgroup.closure (Set.range (rootC (K := F))) ≤ H from
      le_trans le_sup_left le_sup_right) (Subgroup.subset_closure ⟨a, rfl⟩)
  have hR : (weylR : Model F) ∈ H := by
    rw [← block_flip]
    exact hblock _
  have hS : (weylS : Model F) ∈ H := by
    rw [← block_cycle_graph]
    exact H.mul_mem (hblock _) hgraph
  have hA (a : F) : rootA a ∈ H := by rw [← block_rootA]; exact hblock _
  have hB (a : F) : rootB a ∈ H := by rw [← block_rootB]; exact hblock _
  have hE (a : F) : rootE a ∈ H := by rw [← block_rootE]; exact hblock _
  have hD (a : F) : rootD a ∈ H := by
    rw [← rootD_conjugate]
    exact H.mul_mem (H.mul_mem hS (hC a)) (H.inv_mem hS)
  have hF (a : F) : rootF a ∈ H := by
    rw [← rootF_conjugate]
    exact H.mul_mem (H.mul_mem hR (hD a)) (H.inv_mem hR)
  have hU : unipotent (K := F) ≤ H := by
    apply (Subgroup.closure_le H).mpr
    simp only [Set.union_subset_iff, Set.range_subset_iff]
    exact ⟨⟨⟨⟨⟨hA, hB⟩, hC⟩, hD⟩, hE⟩, hF⟩
  have hW : rootWeylSubgroup (K := F) ≤ H := by
    apply (Subgroup.closure_le H).mpr
    rw [Set.union_subset_iff]
    refine ⟨hU, ?_⟩
    rw [Set.insert_subset_iff, Set.singleton_subset_iff]
    exact ⟨hR, hS⟩
  have hT : splitTorus (K := F) ≤ H := by
    rintro _ ⟨⟨l,m⟩, rfl⟩
    change torus l m ∈ H
    rw [← BlockRealization.blockHom_diagonal]
    exact hblock _
  have hgen : generated (F := F) ≤ H := sup_le hW hT
  rw [generated_eq_top] at hgen
  exact top_unique hgen

/-- Indices for the SL₃ elements, short roots, and reflection. -/
abbrev Generator (F : Type*) [Field F] := (SL(3,F) ⊕ F) ⊕ Unit

noncomputable def generator : Generator F → Model F :=
  Sum.elim (Sum.elim BlockRealization.blockHom rootC) (fun _ => graph)

/-- The indexed family generates; this is used by the Conway range comparison. -/
theorem generators_generate : Subgroup.closure (Set.range (generator (F := F))) = ⊤ := by
  rw [generator, Set.Sum.elim_range, Set.Sum.elim_range, Set.range_const,
    Subgroup.closure_union, Subgroup.closure_union]
  rw [← MonoidHom.coe_range (BlockRealization.blockHom (K := F)),
    Subgroup.closure_eq, ← Subgroup.zpowers_eq_closure]
  simpa [longLocal, shortLocal, sup_assoc, sup_comm, sup_left_comm] using
    (locals_generate (F := F))

end Atlas.G2.ConwayRootFour.OctonionLocals
