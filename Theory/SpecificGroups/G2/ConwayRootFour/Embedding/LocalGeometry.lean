module

public import Theory.SpecificGroups.G2.ConwayRootFour.Embedding.OctonionLocals
public import Theory.SpecificGroups.G2.ConwayRootFour.MarkedLift

/-!
# The local Leech action required for the marked G₂ embedding

The source construction in Aschbacher, *Sporadic Groups* (1994), Lemma 49.5,
printed pp.283–284/PDF147–148, uses an SL₃(4) local group, a short-root
local group, and their common graph involution. Their generated subgroup
acts on a six-dimensional GF(4) space obtained from the Leech lattice modulo
two. The three exact actions are specified by `OctonionLocals.action_block`,
`action_rootC`, and `action_graph`.

`CoordinateGeometry` records the missing construction in the actual quotient
of the Leech isometry group. In particular its faithfulness and marking are
obligations, not consequences of matching group orders or of a lift's square.
The marking is conjugacy in the full Conway quotient; the embedding assembly
uses that conjugator to obtain equality with the prescribed marked involution.
No instance of this structure is constructed in this module.

The consumer `Embedding.CoordinateGeometry.exists_marked_embedding` compares
the generated action images with the genuine octonion group. All underlying
Leech and octonion models are existing attributed ATLAS ports.
-/

@[expose] public noncomputable section

open Matrix Atlas.Conway
open scoped MatrixGroups
namespace Atlas.G2.ConwayRootFour.Embedding
open OctonionLocals

/-- The canonical four-element field, shared with the universal-cover model. -/
abbrev F := FiniteCover.FourField
abbrev LinearGroup := Six F ≃ₗ[F] Six F

/-- The SL₃, short-root, and graph generators in the actual Conway quotient. -/
def localGenerator (long : SL(3,F) →* LeechCentralQuotient)
    (short : F → LeechCentralQuotient) (swap : LeechCentralQuotient) :
    Generator F → LeechCentralQuotient := Sum.elim (Sum.elim long short) (fun _ => swap)

/-- The literal subgroup generated by these Leech elements. -/
def localGroup (long : SL(3,F) →* LeechCentralQuotient)
    (short : F → LeechCentralQuotient) (swap : LeechCentralQuotient) :
    Subgroup LeechCentralQuotient := Subgroup.closure (Set.range (localGenerator long short swap))

/-- The same generators, with their membership in the generated subgroup. -/
def localGeneratorIn (long : SL(3,F) →* LeechCentralQuotient)
    (short : F → LeechCentralQuotient) (swap : LeechCentralQuotient) (i : Generator F) :
    localGroup long short swap :=
  ⟨localGenerator long short swap i, Subgroup.subset_closure ⟨i, rfl⟩⟩

theorem localGeneratorIn_generate (long : SL(3,F) →* LeechCentralQuotient)
    (short : F → LeechCentralQuotient) (swap : LeechCentralQuotient) :
    Subgroup.closure (Set.range (localGeneratorIn long short swap)) = ⊤ := by
  apply Subgroup.map_injective (localGroup long short swap).subtype_injective
  rw [MonoidHom.map_closure, ← Set.range_comp', ← MonoidHom.range_eq_map, Subgroup.range_subtype]
  rfl

/-- The still-required local Leech construction. No map from G₂ is a field:
its comparison is derived from the explicit generator actions and faithfulness.
This structure is an input contract, not a constructed geometry. -/
structure CoordinateGeometry where
  long : SL(3,F) →* LeechCentralQuotient
  short : F → LeechCentralQuotient
  swap : LeechCentralQuotient
  representation : localGroup long short swap →* LinearGroup
  faithful : Function.Injective representation
  on_generators : ∀ i : Generator F,
    representation (localGeneratorIn long short swap i) = action (generator i)
  marked : IsConj (short 1) markedInvolution

end Atlas.G2.ConwayRootFour.Embedding
