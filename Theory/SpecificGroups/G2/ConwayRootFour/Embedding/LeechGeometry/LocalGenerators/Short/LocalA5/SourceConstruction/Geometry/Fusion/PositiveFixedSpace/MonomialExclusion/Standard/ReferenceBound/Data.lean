def candidateData (r : Fin 512) : ℕ × Fin 61 :=
  (candidateChunks.get ⟨r.val / 32, by omega⟩).get ⟨r.val % 32, by omega⟩

def candidateSign (r : Fin 512) : Fin 24 → Bit := maskBit (candidateData r).1

def candidatePull (r : Fin 512) : Fin 24 → Fin 24 := pullData.get (candidateData r).2

/-- Reconstruct both literal parameters of an actual signed monomial. -/
def CandidateMatches (m : GolayMonomialGroup) (r : Fin 512) : Prop :=
  (∀ i, m.left.toAdd.val (StandardCoordinates.flat.symm i) = candidateSign r i) ∧
  (∀ i, StandardCoordinates.flat (monomialPull m (StandardCoordinates.flat.symm i)) =
    candidatePull r i)

/-- The reciprocal-basis formula, without requiring a group element as input.
For arbitrary input the division is only a definition; its application to a
monomial is justified by `rawMatrix_eq_monomialMatrix`. -/
def rawMatrix (s : Fin 24 → Bit) (p : Fin 24 → Fin 24) :
    Matrix (Fin 24) (Fin 24) Bit := fun i j =>
  ((∑ k : Fin 24, StandardCoordinates.dualMatrix i k *
    (if s k = 0 then StandardCoordinates.basisMatrix (p k) j else
      -StandardCoordinates.basisMatrix (p k) j)) / 8 : ℤ)

def referenceMatrix : Matrix (Fin 24) (Fin 24) Bit :=
  rawMatrix (fun i => jWord referenceHexB (StandardCoordinates.flat.symm i))
    (fun i => StandardCoordinates.flat (referencePullA (StandardCoordinates.flat.symm i)))

def candidateMatrix (r : Fin 512) : Matrix (Fin 24) (Fin 24) Bit :=
  rawMatrix (candidateSign r) (candidatePull r)

