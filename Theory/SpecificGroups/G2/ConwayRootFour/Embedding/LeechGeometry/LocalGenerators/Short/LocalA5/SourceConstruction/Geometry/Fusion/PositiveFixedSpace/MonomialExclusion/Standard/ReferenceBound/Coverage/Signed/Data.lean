def Admitted (q : Fin 16) : Prop := ∀ h : Fin 64,
  TranslationChecks (columnCandidate q) (decodeHex h) →
  ∃ a : Fin 4, h = ((translationData.get q).get a).1
instance (q) : Decidable (Admitted q) := by unfold Admitted; infer_instance

def Coordinates (q : Fin 16) (a : Fin 4) : Prop :=
  let row := (translationData.get q).get a
  (∀ i, signWord (columnCandidate q) (hexEncoder (decodeHex row.1))
    (StandardCoordinates.flat.symm i) = maskBit row.2.1 i) ∧
  (∀ i, StandardCoordinates.flat (markedPull (columnCandidate q) (hexEncoder (decodeHex row.1))
    (StandardCoordinates.flat.symm i)) = pullData.get row.2.2 i)
instance (q a) : Decidable (Coordinates q a) := by unfold Coordinates; infer_instance

def PackedCheck (q : Fin 16) (a : Fin 4) : Prop :=
  let row := (translationData.get q).get a
  ∀ r : Fin 32,
    (∀ i, maskBit (row.2.1 ^^^ parityMasks.get r) i +
      maskBit (row.2.1 ^^^ parityMasks.get r) (pullData.get row.2.2 i) = 0) →
    candidateData (((witnessData.get q).get a).get r) =
      (row.2.1 ^^^ parityMasks.get r, row.2.2)
instance (q a) : Decidable (PackedCheck q a) := by unfold PackedCheck; infer_instance

