module

public import Theory.SpecificGroups.G2.ConwayRootFour.Embedding.LeechGeometry.Faithfulness.NegativeSquare.Geometry

/-!
# Simultaneous monomial reduction for positive-square lifts

Centralization of the scalar A₄ supplies two independent quaternion scalar
lifts commuting integrally with the given isometry. To obtain the second,
conjugate a commuting lift by the scalar three-cycle; the possible central
sign in projective commutation cancels in this conjugation.

The two-group generated by U and the projected involution fixes a Leech cross
because the cross set has odd cardinality. Cross transitivity and monomial
recovery put both scalars and the involution in the signed Golay group at once.
The long frame identifies the scalar kernels with the actual U-fixed space;
a linear equivalence transports its fixed-space dimension. `ScalarOrigin`
retains the original scalar subgroups and centralization of all of I under
the same literal conjugation.

`MonomialQuaternionExclusion` is the remaining finite lattice calculation,
kept explicit. Quaternion relations alone do not establish it for an arbitrary
integral lattice. This module proves the reduction, not that exclusion.

Source context: Aschbacher, *Sporadic Groups* (1994), Lemma 49.5,
pp.283–284, Lemma 47.2, p.261, and the root-four conventions on p.269.
This is an independent lattice reduction for the source's fusion step.
The literal lattice, scalar and cross APIs are the existing attributed ATLAS
ports; no new ATLAS source is copied here.
-/

open Atlas.Conway Atlas.Codes Atlas.Lattices
public noncomputable section
namespace Atlas.G2.ConwayRootFour.Embedding.LeechGeometry.LocalGenerators.LocalA5.SourceConstruction.Fusion

private theorem y_moves_U (u : LeechCentralQuotient) (hu : u ∈ U) (hne : u ≠ 1) :
    y * u * y⁻¹ ≠ u := by
  obtain ⟨v, hv, rfl⟩ := hu
  have hvne : v ≠ 1 := fun he => hne (by rw [he, map_one])
  intro he
  have hc : threeCycle * v * threeCycle⁻¹ = v := scalarFour_injective (by
    simpa only [map_mul, map_inv, y] using he)
  have hv2 : v * v = 1 := by
    apply scalarFour_injective
    rw [map_mul, map_one]
    exact congrArg Subtype.val (IsKleinFour.mul_self
      (⟨scalarFour v, Subgroup.mem_map_of_mem _ hv⟩ : U))
  have hf : ∀ v : alternatingGroup fourPoints, v * v = 1 → v ≠ 1 →
      threeCycle * v * threeCycle⁻¹ ≠ v := by decide
  exact hf v hv2 hvne hc

private theorem commute_conjugate_of_projective
    (h a t : LeechIsometryGroup) (ha : Commute h a)
    (ht : Commute (leechCentralProjection h) (leechCentralProjection t)) :
    Commute h (t * a * t⁻¹) := by
  obtain ht | ht := eq_or_mul_negation_of_projection_eq
    (show leechCentralProjection (h * t) = leechCentralProjection (t * h) by
      simpa only [map_mul] using ht.eq)
  · exact (show Commute h t from ht).mul_right ha |>.mul_right
      (show Commute h t⁻¹ from (show Commute h t from ht).inv_right)
  · have hz : ∀ x : LeechIsometryGroup, x * negationIsometry = negationIsometry * x :=
      fun x => Subgroup.mem_center_iff.mp negation_mem_center x
    have hi : t⁻¹ * h = h * t⁻¹ * negationIsometry := by
      calc
        t⁻¹ * h = t⁻¹ * (h * t) * t⁻¹ := by group
        _ = t⁻¹ * (t * h * negationIsometry) * t⁻¹ := by rw [ht]
        _ = h * (negationIsometry * t⁻¹) := by group
        _ = h * t⁻¹ * negationIsometry := by rw [← hz t⁻¹]; group
    change h * (t * a * t⁻¹) = (t * a * t⁻¹) * h
    calc
      h * (t * a * t⁻¹) = (t * h * negationIsometry) * a * t⁻¹ := by rw [← mul_assoc, ← mul_assoc, ht]
      _ = t * h * (negationIsometry * a) * t⁻¹ := by group
      _ = t * h * (a * negationIsometry) * t⁻¹ := by rw [hz a]
      _ = t * (h * a) * (negationIsometry * t⁻¹) := by group
      _ = t * (a * h) * (t⁻¹ * negationIsometry) := by rw [ha.eq, hz t⁻¹]
      _ = t * a * (h * t⁻¹ * negationIsometry) := by group
      _ = (t * a * t⁻¹) * h := by rw [← hi]; group

/-- The scalar three-cycle supplies an independent commuting lift. -/
theorem exists_scalar_quaternion_pair (h : LeechIsometryGroup)
    (hc : leechCentralProjection h ∈ centralizerI) :
    ∃ a b : LeechIsometryGroup,
      leechCentralProjection a ∈ U ∧ leechCentralProjection b ∈ U ∧
      a ^ 2 = negationIsometry ∧ b ^ 2 = negationIsometry ∧
      (a * b) ^ 2 = negationIsometry ∧ Commute h a ∧ Commute h b := by
  obtain ⟨a, haU, hane, ha2, hca⟩ := NegativeSquare.exists_commuting_U_lift h hc
  obtain ⟨t, ht⟩ := leechCentralProjection_surjective y
  let b := t * a * t⁻¹
  have hb : leechCentralProjection b = y * leechCentralProjection a * y⁻¹ := by
    simp only [b, map_mul, map_inv, ht]
  have hy : y ∈ I := ⟨threeCycle, rfl⟩
  have hbU : leechCentralProjection b ∈ U := by
    rw [hb]
    exact ((Subgroup.mem_normalizer_iff.mp (I_le_normalizer_U hy)) _).mp haU
  have hbne : leechCentralProjection b ≠ 1 := by
    rw [hb]
    intro he
    apply hane
    have he' := congrArg (fun g : LeechCentralQuotient => y⁻¹ * g * y) he
    simpa only [mul_assoc, inv_mul_cancel_left, inv_mul_cancel, mul_one, mul_inv_cancel,
      one_mul] using he'
  have habU : leechCentralProjection (a * b) ∈ U := by
    rw [map_mul]
    exact U.mul_mem haU hbU
  have habne : leechCentralProjection (a * b) ≠ 1 := by
    intro he
    have haa : leechCentralProjection a * leechCentralProjection a = 1 := by
      rw [← map_mul, ← pow_two, ha2, projection_negation]
    rw [map_mul] at he
    exact y_moves_U _ haU hane (hb.symm.trans (mul_left_cancel (he.trans haa.symm)))
  refine ⟨a, b, haU, hbU, ha2,
    NegativeSquare.square_negation_of_U hbU hbne,
    NegativeSquare.square_negation_of_U habU habne, hca, ?_⟩
  exact commute_conjugate_of_projective h a t hca (by
    rw [ht]
    exact (show Commute y (leechCentralProjection h) from hc y hy).symm)

/-- A single cross fixed by both U and the given positive-square lift. -/
theorem exists_common_fixedCross (h : LeechIsometryGroup)
    (hc : leechCentralProjection h ∈ centralizerI) (hsq : h ^ 2 = 1) :
    ∃ X : LeechCross, X.val ∈ fixedSpace ∧ crossAction h X = X := by
  let q := leechCentralProjection h
  let Z := Subgroup.zpowers q
  have hq : q ^ 2 = 1 := by rw [← map_pow, hsq, map_one]
  have hz2 (z : Z) : z ^ 2 = 1 := by
    apply Subtype.ext
    obtain ⟨n, hn⟩ := z.property
    change z.val ^ 2 = 1
    rw [← hn, ← zpow_natCast, ← zpow_mul, mul_comm n, zpow_mul,
      zpow_natCast, hq, one_zpow]
  have comm (u : U) (z : Z) : Commute u.val z.val := by
    obtain ⟨n, hn⟩ := z.property
    rw [← hn]
    exact (show Commute u.val q from hc _ (U_le_I u.property)).zpow_right n
  let f : U × Z →* LeechCentralQuotient := U.subtype.noncommCoprod Z.subtype comm
  let : MulAction (U × Z) LeechCross :=
    MulAction.compHom LeechCross (quotientCrossRepresentation.comp f)
  have htwo : IsPGroup 2 (U × Z) := by
    intro p
    refine ⟨1, Prod.ext ?_ ?_⟩
    · simpa only [pow_one, Prod.pow_fst, Prod.fst_one, pow_two, Prod.fst_mul] using IsKleinFour.mul_self p.1
    · exact hz2 p.2
  obtain ⟨X, hX⟩ := htwo.nonempty_fixed_point_of_prime_not_dvd_card LeechCross (by
    rw [leechCross_card]
    decide)
  have hfix (p : U × Z) : quotientCrossRepresentation (f p) X = X :=
    MulAction.mem_fixedPoints.mp hX p
  refine ⟨X, ?_, ?_⟩
  · intro u hu
    have he := hfix (⟨u, hu⟩, 1)
    change quotientCrossRepresentation (u * 1) X = X at he
    rw [mul_one] at he
    have hv := congrArg Subtype.val he
    rwa [quotientCross_modTwo_equivariant] at hv
  · have he := hfix (1, ⟨q, Subgroup.mem_zpowers q⟩)
    change quotientCrossRepresentation (1 * q) X = X at he
    rw [one_mul] at he
    exact he

/-- Fixed vectors of a literal integral lift in the binary Leech quotient. -/
@[expose] def binaryFixed (a : LeechIsometryGroup) : Submodule Bit LeechModTwo :=
  LinearMap.ker (difference (leechCentralProjection a))

private theorem mem_binaryFixed (a : LeechIsometryGroup) (v : LeechModTwo) :
    v ∈ binaryFixed a ↔ leechModTwoRepresentation a v = v := by
  change leechModTwoRepresentation a v - v = 0 ↔ _
  exact sub_eq_zero

private theorem conjugate_fixed (s a : LeechIsometryGroup) (v : LeechModTwo) :
    leechModTwoRepresentation (s⁻¹) v ∈ binaryFixed (s⁻¹ * a * s) ↔
      v ∈ binaryFixed a := by
  rw [mem_binaryFixed, mem_binaryFixed]
  simp only [map_mul, map_inv, LinearEquiv.mul_apply, LinearEquiv.coe_inv]
  rw [LinearEquiv.apply_symm_apply, (leechModTwoRepresentation s).symm.injective.eq_iff]

/-- Change of lattice frame on the simultaneous binary fixed space. -/
def commonFixedConjugate (s a h : LeechIsometryGroup) :
    ↥(binaryFixed a ⊓ binaryFixed h) ≃ₗ[Bit]
      ↥(binaryFixed (s⁻¹ * a * s) ⊓ binaryFixed (s⁻¹ * h * s)) where
  toFun v := ⟨leechModTwoRepresentation (s⁻¹) v.val,
    (conjugate_fixed s a v.val).mpr v.property.1,
    (conjugate_fixed s h v.val).mpr v.property.2⟩
  invFun v := ⟨leechModTwoRepresentation s v.val, by
    have he : leechModTwoRepresentation s⁻¹
        (leechModTwoRepresentation s v.val) = v.val := by simp
    exact ⟨(conjugate_fixed s a _).mp (he.symm ▸ v.property.1),
      (conjugate_fixed s h _).mp (he.symm ▸ v.property.2)⟩⟩
  left_inv v := by apply Subtype.ext; simp
  right_inv v := by apply Subtype.ext; simp
  map_add' v w := by apply Subtype.ext; exact map_add _ _ _
  map_smul' c v := by apply Subtype.ext; exact map_smul _ _ _

/-- Equality of scalar fixed spaces survives the same frame change. -/
theorem binaryFixed_conjugate_eq (s a b : LeechIsometryGroup)
    (he : binaryFixed a = binaryFixed b) :
    binaryFixed (s⁻¹ * a * s) = binaryFixed (s⁻¹ * b * s) := by
  ext v
  obtain ⟨w, rfl⟩ := (leechModTwoRepresentation (s⁻¹)).surjective v
  rw [conjugate_fixed, conjugate_fixed, he]

/-- The simultaneous monomial frame comes from the published scalar subgroup.
This retains centralization of the whole I, including its order-three element,
as an actual conjugation condition rather than only centralization of U. -/
@[expose] def ScalarOrigin (a b m : GolayMonomialGroup) : Prop :=
  ∃ s : LeechIsometryGroup,
    leechCentralProjection (s * monomialEmbedding a * s⁻¹) ∈ U ∧
    leechCentralProjection (s * monomialEmbedding b * s⁻¹) ∈ U ∧
    leechCentralProjection (s * monomialEmbedding m * s⁻¹) ∈ centralizerI

/-- Every positive-square lift in the scalar tetrahedral centralizer has a
simultaneous signed Golay model with its two commuting quaternion scalars.
The final equality transports the literal fixed-space dimension. -/
theorem exists_monomial_quaternion_frame (L : LongFrame) (h : LeechIsometryGroup)
    (hc : leechCentralProjection h ∈ centralizerI) (hsq : h ^ 2 = 1) :
    ∃ a b m : GolayMonomialGroup,
      (monomialEmbedding a) ^ 2 = negationIsometry ∧
      (monomialEmbedding b) ^ 2 = negationIsometry ∧
      (monomialEmbedding a * monomialEmbedding b) ^ 2 = negationIsometry ∧
      (monomialEmbedding m) ^ 2 = 1 ∧
      Commute (monomialEmbedding m) (monomialEmbedding a) ∧
      Commute (monomialEmbedding m) (monomialEmbedding b) ∧
      binaryFixed (monomialEmbedding a) = binaryFixed (monomialEmbedding b) ∧
      ScalarOrigin a b m ∧
      Module.finrank Bit ↥(fixedSpace ⊓ binaryFixed h) =
        Module.finrank Bit ↥(binaryFixed (monomialEmbedding a) ⊓
          binaryFixed (monomialEmbedding m)) := by
  obtain ⟨a, b, haU, hbU, ha2, hb2, hab2, hca, hcb⟩ := exists_scalar_quaternion_pair h hc
  have hw := PositiveSquare.scalarFixedSpaceWitness_of_longFrame L
  have hva : fixedSpace = binaryFixed a :=
    NegativeSquare.fixedSpace_eq_scalar_kernel hw a ha2 haU
  have hvb : fixedSpace = binaryFixed b :=
    NegativeSquare.fixedSpace_eq_scalar_kernel hw b hb2 hbU
  obtain ⟨X, hXU, hXh⟩ := exists_common_fixedCross h hc hsq
  have hXa : crossAction a X = X := Subtype.ext (hXU _ haU)
  have hXb : crossAction b X = X := Subtype.ext (hXU _ hbU)
  let _ := full_cross_transitive
  obtain ⟨s, hs⟩ := MulAction.exists_smul_eq LeechIsometryGroup standardCross X
  change crossAction s standardCross = X at hs
  let e : MulAut LeechIsometryGroup := MulAut.conj s⁻¹
  have e_apply (g : LeechIsometryGroup) : e g = s⁻¹ * g * s := by simp [e]
  have ez : e negationIsometry = negationIsometry := by
    rw [e_apply, Subgroup.mem_center_iff.mp negation_mem_center s⁻¹]
    simp only [mul_assoc, inv_mul_cancel, mul_one]
  have efixed (g : LeechIsometryGroup) (hg : crossAction g X = X) :
      crossAction (e g) standardCross = standardCross := by
    rw [e_apply, mul_assoc, crossAction_mul, crossAction_mul, hs, hg,
      ← hs, ← crossAction_mul, inv_mul_cancel]
    rfl
  let ma := recoverMonomial (e a) (efixed a hXa)
  let mb := recoverMonomial (e b) (efixed b hXb)
  let mh := recoverMonomial (e h) (efixed h hXh)
  have hma : monomialEmbedding ma = e a := recoverMonomial_spec _ _
  have hmb : monomialEmbedding mb = e b := recoverMonomial_spec _ _
  have hmh : monomialEmbedding mh = e h := recoverMonomial_spec _ _
  refine ⟨ma, mb, mh, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [hma, ← map_pow, ha2, ez]
  · rw [hmb, ← map_pow, hb2, ez]
  · rw [hma, hmb, ← map_mul, ← map_pow, hab2, ez]
  · rw [hmh, ← map_pow, hsq, map_one]
  · rw [hmh, hma]
    exact hca.map e
  · rw [hmh, hmb]
    exact hcb.map e
  · rw [hma, hmb, e_apply, e_apply]
    exact binaryFixed_conjugate_eq s a b (hva.symm.trans hvb)
  · refine ⟨s, ?_⟩
    have restore (g : LeechIsometryGroup) : s * e g * s⁻¹ = g := by
      rw [e_apply]
      group
    rw [hma, hmb, hmh, restore, restore, restore]
    exact ⟨haU, hbU, hc⟩
  · rw [hva, hma, hmh, e_apply, e_apply]
    exact (commonFixedConjugate s a h).finrank_eq

/-- The finite calculation needed after simultaneous monomial recovery.
All square, commutation and fixed-space conditions concern actual lattice
isometries. This predicate is an open input, not an asserted classification. -/
@[expose] def MonomialQuaternionExclusion : Prop :=
  ∀ a b m : GolayMonomialGroup,
    (monomialEmbedding a) ^ 2 = negationIsometry →
    (monomialEmbedding b) ^ 2 = negationIsometry →
    (monomialEmbedding a * monomialEmbedding b) ^ 2 = negationIsometry →
    (monomialEmbedding m) ^ 2 = 1 →
    Commute (monomialEmbedding m) (monomialEmbedding a) →
    Commute (monomialEmbedding m) (monomialEmbedding b) →
    binaryFixed (monomialEmbedding a) = binaryFixed (monomialEmbedding b) →
    ScalarOrigin a b m →
    Module.finrank Bit ↥(binaryFixed (monomialEmbedding a) ⊓
      binaryFixed (monomialEmbedding m)) ≠ 6

end Atlas.G2.ConwayRootFour.Embedding.LeechGeometry.LocalGenerators.LocalA5.SourceConstruction.Fusion
