module

public import Theory.SpecificGroups.G2.ConwayRootFour.Embedding.LeechGeometry.LocalGenerators.Long.Subgroup.Lattice.Block.MatrixData
public import Theory.SpecificGroups.G2.ConwayRootFour.Embedding.LeechGeometry.LocalGenerators.Long.Subgroup.Lattice.Block.Quotient.Restriction
public import Theory.SpecificGroups.G2.ConwayRootFour.Embedding.LeechGeometry.LocalGenerators.Long.Subgroup.Lattice.Block.Quotient.IntegralKernel.Certificates
/-!
# The integral reduction kernel consists of scalar signs

For the subgroup of GL₆(Z[omega]) generated by the literal ATLAS matrices,
entrywise reduction modulo two has kernel exactly its scalar signs. A finite
row certificate contains the six standard basis rows and is invariant under
the generators and their inverses. Each standard-basis reduction fibre is
contained in the corresponding opposite pair. Consequently every kernel
element is diagonal with signs.
The row Hermitian form is preserved by the whole generated subgroup, and
its connected nonzero-entry graph forces those six signs to agree.

The finite checks use only row vectors and 64 diagonal sign patterns, without
any group-order computation, faithfulness assumption, or Leech identification.
Numerical source: John Bray's ATLAS `6L34G1-Ar6aB0.M`, recorded in
`MatrixData`. The reproducible vector search is in `IntegralKernel/source/`;
all facts used from its output are separately checked by Lean's kernel.
-/

public section
open Atlas.Algebra Matrix
open scoped MatrixGroups
namespace Atlas.G2.ConwayRootFour.Embedding.LeechGeometry.LocalGenerators.Long.Block
private theorem form_mul {g h : GL (Fin 6) Eisenstein}
    (hg : g.val * hermitianMatrix * g.valᴴ = hermitianMatrix)
    (hh : h.val * hermitianMatrix * h.valᴴ = hermitianMatrix) :
    (g * h).val * hermitianMatrix * (g * h).valᴴ = hermitianMatrix := by
  change (g.val * h.val) * hermitianMatrix * (g.val * h.val)ᴴ = _
  rw [conjTranspose_mul]
  calc
    _ = g.val * (h.val * hermitianMatrix * h.valᴴ) * g.valᴴ := by simp only [mul_assoc]
    _ = hermitianMatrix := by rw [hh, hg]
private theorem form_inv {g : GL (Fin 6) Eisenstein}
    (hg : g.val * hermitianMatrix * g.valᴴ = hermitianMatrix) :
    g⁻¹.val * hermitianMatrix * g⁻¹.valᴴ = hermitianMatrix := by
  have hr : g.valᴴ * g⁻¹.valᴴ = 1 := by rw [← conjTranspose_mul, g.inv_mul, conjTranspose_one]
  calc
    _ = g⁻¹.val * (g.val * hermitianMatrix * g.valᴴ) * g⁻¹.valᴴ := by rw [hg]
    _ = (g⁻¹.val * g.val) * hermitianMatrix * (g.valᴴ * g⁻¹.valᴴ) := by simp only [mul_assoc]
    _ = hermitianMatrix := by rw [g.inv_mul, hr, one_mul, mul_one]

/-- The literal row Hermitian form is invariant under the generated integral group. -/
theorem matrixGroup_form (g : matrixGroup) :
    g.val.val * hermitianMatrix * g.val.valᴴ = hermitianMatrix := by
  obtain ⟨g, hg⟩ := g
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with rfl | rfl
    · exact matrixA_form
    · exact matrixB_form
  | one => simp
  | mul g h _ _ hg hh => exact form_mul hg hh
  | inv g _ hg => exact form_inv hg

private def rowStabilizer (S : Set (Fin 6 → Eisenstein)) : Subgroup (GL (Fin 6) Eisenstein) where
  carrier := {g | ∀ v, v ∈ S ↔ v ᵥ* g.val ∈ S}
  one_mem' := by simp
  mul_mem' := by
    intro g h hg hh v
    change v ∈ S ↔ v ᵥ* (g.val * h.val) ∈ S
    rw [← vecMul_vecMul]
    exact (hg v).trans (hh _)
  inv_mem' := by
    intro g hg v
    have h := hg (v ᵥ* g⁻¹.val)
    rw [vecMul_vecMul, g.inv_mul, vecMul_one] at h
    exact h.symm

open IntegralKernel
attribute [local irreducible] rows

private def rowSet : Set Row := {v | ∃ c i, v = rows c i}

private theorem maps_A (v : Row) (hv : v ∈ rowSet) : v ᵥ* matrixA ∈ rowSet := by
  obtain ⟨c, i, rfl⟩ := hv
  exact rows_mul_A c i
private theorem maps_B (v : Row) (hv : v ∈ rowSet) : v ᵥ* matrixB ∈ rowSet := by
  obtain ⟨c, i, rfl⟩ := hv
  exact rows_mul_B c i
private theorem maps_BInv (v : Row) (hv : v ∈ rowSet) : v ᵥ* matrixBInv ∈ rowSet := by
  obtain ⟨c, i, rfl⟩ := hv
  exact rows_mul_BInv c i

private theorem mem_rowStabilizer_of_maps (g : GL (Fin 6) Eisenstein)
    (h : ∀ v ∈ rowSet, v ᵥ* g.val ∈ rowSet)
    (hi : ∀ v ∈ rowSet, v ᵥ* g⁻¹.val ∈ rowSet) : g ∈ rowStabilizer rowSet := by
  intro v
  constructor
  · exact h v
  · intro hv
    have hh := hi _ hv
    simpa only [vecMul_vecMul, g.mul_inv, vecMul_one] using hh

private theorem matrixGroup_le_rowStabilizer : matrixGroup ≤ rowStabilizer rowSet := by
  apply (Subgroup.closure_le _).mpr
  rintro g (rfl | rfl)
  · exact mem_rowStabilizer_of_maps generatorA maps_A maps_A
  · exact mem_rowStabilizer_of_maps generatorB maps_B maps_BInv

private theorem row_mem_rowSet (g : matrixGroup) (i : Fin 6) : g.val.val i ∈ rowSet := by
  have h := (matrixGroup_le_rowStabilizer g.property (basisRow i)).mp
    ⟨(basisIndex i).1, (basisIndex i).2, basisRow_eq_rows i⟩
  have he : basisRow i ᵥ* g.val.val = g.val.val i := by
    funext j
    change ((1 : SixMatrix) * g.val.val) i j = _
    rw [one_mul]
  rwa [he] at h

private theorem kernel_rows (g : matrixGroup) (hg : reduction g = 1) (j : Fin 6) :
    g.val.val j = basisRow j ∨ g.val.val j = -basisRow j := by
  have hm : g.val.val.map reductionScalars = (1 : Matrix (Fin 6) (Fin 6) GoldenFour) :=
    congrArg (fun x : GL (Fin 6) GoldenFour => x.val) hg
  have hb : (fun k => reductionScalars (basisRow j k)) =
      (1 : Matrix (Fin 6) (Fin 6) GoldenFour) j := by
    change (reductionScalars.mapMatrix (1 : SixMatrix)) j = _
    rw [map_one]
  obtain ⟨c, i, hrow⟩ := row_mem_rowSet g j
  have hf : (fun k => reductionScalars (rows c i k)) =
      (fun k => reductionScalars (basisRow j k)) := by
    rw [← hrow, hb]
    exact congrFun hm j
  exact (rows_basis_fibre c i j hf).imp (hrow.trans ·) (hrow.trans ·)

private def signMatrix (s : Fin 6 → Bool) : SixMatrix :=
  fun i => if s i then basisRow i else -basisRow i

-- The nonzero entries of the Hermitian form connect all six coordinates.
-- This small check exhausts only the 64 diagonal sign patterns.
private theorem signMatrix_form : ∀ s : Fin 6 → Bool,
    signMatrix s * hermitianMatrix * (signMatrix s)ᴴ = hermitianMatrix →
      signMatrix s = 1 ∨ signMatrix s = -1 := by decide +kernel

/-- An integral matrix in the concrete generated group that reduces to the
identity modulo two is one of the two scalar signs. -/
theorem reduction_ker_le_matrixSigns : reduction.ker ≤ matrixSigns := by
  intro g hg
  have hh : ∀ i, ∃ b : Bool, g.val.val i = if b then basisRow i else -basisRow i := by
    intro i
    rcases kernel_rows g (MonoidHom.mem_ker.mp hg) i with h | h
    · exact ⟨true, h⟩
    · exact ⟨false, h⟩
  choose s hs using hh
  have he : g.val.val = signMatrix s := funext hs
  have hf := matrixGroup_form g
  rw [he] at hf
  rcases signMatrix_form s hf with h | h
  · exact (mem_matrixSigns g).mpr (Or.inl (Units.ext (he.trans h)))
  · exact (mem_matrixSigns g).mpr (Or.inr (Units.ext (he.trans h)))

/-- Exactness for full six-dimensional reduction, independent of restriction
of that reduction to the three-dimensional invariant row space. -/
theorem reduction_ker_eq_matrixSigns : reduction.ker = matrixSigns :=
  le_antisymm reduction_ker_le_matrixSigns matrixSigns_le_reduction_ker

end Atlas.G2.ConwayRootFour.Embedding.LeechGeometry.LocalGenerators.Long.Block
