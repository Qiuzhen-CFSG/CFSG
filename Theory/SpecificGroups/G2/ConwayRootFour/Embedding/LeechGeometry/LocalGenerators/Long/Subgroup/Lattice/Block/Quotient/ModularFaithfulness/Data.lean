instance (v : Row) : Decidable (admissible v) := inferInstanceAs (Decidable (_ = _))

def seed : Fin 3 → Row := ![Pi.single 2 1, Pi.single 4 1, Pi.single 5 1]

def coefficients (i : Fin 3) : Matrix (Fin 3) (Fin 3) GoldenFour :=
  let w := goldenFourTau
