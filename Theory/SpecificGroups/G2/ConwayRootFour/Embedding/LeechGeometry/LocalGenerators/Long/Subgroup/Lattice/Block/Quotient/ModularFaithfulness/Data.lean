    !![0,1,1; 1,1,w; 1,w+1,0],
    !![0,0,1; 0,1,0; 0,1,w]] i

def shift (i k : Fin 3) : Row :=
  let w := goldenFourTau
  ![
    ![![0, 0, 0, w, w, w+1],
      ![w, w, 1, 1, w+1, w+1],
      ![w, w, 1, w, 0, w]],
    ![![0, 1, 1, 1, 1, w+1],
      ![1, 1, w+1, w, w+1, 0],
      ![1, w+1, 1, 0, 1, 1]],
    ![![0, 0, 0, 1, 1, w],
      ![0, 1, 1, 0, 0, 1],
      ![0, 1, 1, w, w, w]]] i k

