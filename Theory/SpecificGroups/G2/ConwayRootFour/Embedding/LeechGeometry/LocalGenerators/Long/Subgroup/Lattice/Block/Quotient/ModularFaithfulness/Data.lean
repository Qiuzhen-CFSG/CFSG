def actA (v : Row) : Row := ![v 0, v 2, v 1, v 4, v 3, v 5]

def actB (v : Row) : Row :=
  let z := goldenFourTau + 1
  ![v 4, v 0 + v 1 + v 4, v 2 + v 3 * z, v 4 * z + v 5, v 1, v 1 * z + v 3]

def encode (v : Row) : ℕ :=
  ∑ j : Fin 6, ((v j).re.val * 4^j.val + (v j).im.val * 2 * 4^j.val)

/-- A checked superset suffices for the three distinguishing tests. -/
