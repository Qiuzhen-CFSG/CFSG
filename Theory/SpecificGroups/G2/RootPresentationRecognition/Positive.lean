module
public import Theory.AtlasPort.LinearGroups.G2.Unipotent
public import Mathlib.Algebra.CharP.Two

/-!
# Collection without a pre-existing G₂ homomorphism

The fifteen A–F interchange relations collect all positive words in any group.
The ordered product therefore induces a homomorphism from the actual octonion
unipotent subgroup, and its image is exactly the subgroup generated by the
six roots. No projection to the model or injectivity is assumed.

This is the positive collection step for the finite Borel–Weyl presentation
used in the G₂ row of DGS, Groups and Graphs, Theorem D, p.224. The product
polynomials are those of the licensed ATLAS octonion model (LICENSES/ATLAS.txt).
The algebraic collection proof adapts the existing CFSG proof in
`MultiplierOrdinary/PositiveRelations/Collection`, removing its unused projection.
-/

@[expose] public noncomputable section
namespace Atlas.G2.RootPresentationRecognition
variable (F G : Type*) [Field F] [Group G]

/-- Six additive root maps, in the literal A,B,C,D,E,F order. -/
structure PositiveRoots where
  root : Fin 6 → Multiplicative F →* G

namespace PositiveRoots
variable {F G}
abbrev x (L : PositiveRoots F G) (i : Fin 6) (t : F) : G := L.root i (.ofAdd t)

@[simp] theorem x_zero (L : PositiveRoots F G) (i : Fin 6) : L.x i 0 = 1 :=
  (L.root i).map_one

theorem x_add (L : PositiveRoots F G) (i : Fin 6) (s t : F) :
    L.x i (s + t) = L.x i s * L.x i t := (L.root i).map_mul _ _

/-- Literal ordered product of the six positive roots. -/
def product (L : PositiveRoots F G) (t : Fin 6 → F) : G :=
  L.x 0 (t 0) * L.x 1 (t 1) * L.x 2 (t 2) * L.x 3 (t 3) *
    L.x 4 (t 4) * L.x 5 (t 5)

@[simp] theorem product_zero (L : PositiveRoots F G) : L.product 0 = 1 := by
  simp [product]

/-- The ten pairs whose sums are not roots in this ordering. -/
structure CommutingRelations (L : PositiveRoots F G) : Prop where
  ba : ∀ b a, L.x 1 b * L.x 0 a = L.x 0 a * L.x 1 b
  ca : ∀ c a, L.x 2 c * L.x 0 a = L.x 0 a * L.x 2 c
  cb : ∀ c b, L.x 2 c * L.x 1 b = L.x 1 b * L.x 2 c
  da : ∀ d a, L.x 3 d * L.x 0 a = L.x 0 a * L.x 3 d
  db : ∀ d b, L.x 3 d * L.x 1 b = L.x 1 b * L.x 3 d
  ea : ∀ e a, L.x 4 e * L.x 0 a = L.x 0 a * L.x 4 e
  ec : ∀ e c, L.x 4 e * L.x 2 c = L.x 2 c * L.x 4 e
  ed : ∀ e d, L.x 4 e * L.x 3 d = L.x 3 d * L.x 4 e
  fa : ∀ z a, L.x 5 z * L.x 0 a = L.x 0 a * L.x 5 z
  fb : ∀ z b, L.x 5 z * L.x 1 b = L.x 1 b * L.x 5 z

/-- The five noncommuting pairs, with the coefficients of the literal
A–F octonion root maps. -/
structure PolynomialRelations (L : PositiveRoots F G) : Prop where
  dc : ∀ d c, L.x 3 d * L.x 2 c = L.x 0 (3*c*d) * L.x 2 c * L.x 3 d
  eb : ∀ e b, L.x 4 e * L.x 1 b = L.x 0 (-b*e) * L.x 1 b * L.x 4 e
  fc : ∀ z c, L.x 5 z * L.x 2 c = L.x 1 (-3*c*z) * L.x 2 c * L.x 5 z
  fd : ∀ z d, L.x 5 z * L.x 3 d =
    L.x 0 (-3*d^2*z) * L.x 1 (3*d*z^2) * L.x 2 (-2*d*z) * L.x 3 d * L.x 5 z
  fe : ∀ z e, L.x 5 z * L.x 4 e =
    L.x 0 (-e^2*z^3) * L.x 1 (-e*z^3) * L.x 2 (e*z^2) * L.x 3 (-e*z) *
      L.x 4 e * L.x 5 z

/-- Pairwise relations sufficient for collection in A–F order. -/
structure CollectionRelations (L : PositiveRoots F G) : Prop
    extends L.CommutingRelations, L.PolynomialRelations

private theorem append_relation {a b c : G} (h : a * b = c) (z : G) :
    a * (b * z) = c * z := by rw [← mul_assoc, h]

private theorem collect_same (L : PositiveRoots F G) (i : Fin 6) (s t : F) (z : G) :
    L.x i s * (L.x i t * z) = L.x i (s + t) * z := by
  rw [← mul_assoc, ← x_add]

theorem CollectionRelations.product_mul (L : PositiveRoots F G)
    (R : L.CollectionRelations) : ∀ t u, L.product t * L.product u = L.product (unipotentProductParameters t u) := by
  intro t u
  change L.x 0 (t 0) * L.x 1 (t 1) * L.x 2 (t 2) * L.x 3 (t 3) *
    L.x 4 (t 4) * L.x 5 (t 5) *
    (L.x 0 (u 0) * L.x 1 (u 1) * L.x 2 (u 2) * L.x 3 (u 3) *
      L.x 4 (u 4) * L.x 5 (u 5)) = _
  simp only [mul_assoc, append_relation (R.ba _ _), append_relation (R.ca _ _),
    append_relation (R.cb _ _), append_relation (R.da _ _), append_relation (R.db _ _),
    append_relation (R.dc _ _), append_relation (R.ea _ _), append_relation (R.eb _ _),
    append_relation (R.ec _ _), append_relation (R.ed _ _), append_relation (R.fa _ _),
    append_relation (R.fb _ _), append_relation (R.fc _ _), append_relation (R.fd _ _),
    append_relation (R.fe _ _), collect_same, ← x_add]
  simp only [product, mul_assoc]
  change _ = L.x 0 (unipotentProductParameters t u 0) *
    (L.x 1 (unipotentProductParameters t u 1) *
      (L.x 2 (unipotentProductParameters t u 2) *
        (L.x 3 (unipotentProductParameters t u 3) *
          (L.x 4 (unipotentProductParameters t u 4) *
            L.x 5 (unipotentProductParameters t u 5)))))
  repeat' first
    | apply congrArg₂ (fun a b : G => a * b)
    | apply congrArg (L.x _)
  all_goals dsimp [unipotentProductParameters]
  all_goals ring

/-- The five noncommuting equations exactly as used in characteristic two. -/
structure CharTwoRelations (L : PositiveRoots F G) : Prop extends L.CommutingRelations where
  dc : ∀ d c, L.x 3 d * L.x 2 c = L.x 0 (c*d) * L.x 2 c * L.x 3 d
  eb : ∀ e b, L.x 4 e * L.x 1 b = L.x 0 (b*e) * L.x 1 b * L.x 4 e
  fc : ∀ z c, L.x 5 z * L.x 2 c = L.x 1 (c*z) * L.x 2 c * L.x 5 z
  fd : ∀ z d, L.x 5 z * L.x 3 d =
    L.x 0 (d^2*z) * L.x 1 (d*z^2) * L.x 3 d * L.x 5 z
  fe : ∀ z e, L.x 5 z * L.x 4 e =
    L.x 0 (e^2*z^3) * L.x 1 (e*z^3) * L.x 2 (e*z^2) * L.x 3 (e*z) *
      L.x 4 e * L.x 5 z

/-- The characteristic-two contract has the same collection polynomial. -/
theorem CharTwoRelations.collection [CharP F 2] {L : PositiveRoots F G}
    (R : L.CharTwoRelations) : L.CollectionRelations := by
  have htwo : (2 : F) = 0 := CharP.cast_eq_zero F 2
  have hthree : (3 : F) = 1 := by
    calc
      (3 : F) = 2 + 1 := by norm_num
      _ = 1 := by rw [htwo, zero_add]
  refine ⟨R.toCommutingRelations, ?_⟩
  constructor
  · simpa [hthree] using R.dc
  · simpa [CharTwo.neg_eq] using R.eb
  · simpa [hthree, CharTwo.neg_eq] using R.fc
  · simpa [hthree, htwo, CharTwo.neg_eq] using R.fd
  · simpa [CharTwo.neg_eq] using R.fe

/-- Specializing the integral equations retains their literal factor order. -/
theorem CollectionRelations.charTwo [CharP F 2] {L : PositiveRoots F G}
    (R : L.CollectionRelations) : L.CharTwoRelations := by
  have htwo : (2 : F) = 0 := CharP.cast_eq_zero F 2
  have hthree : (3 : F) = 1 := by
    calc
      (3 : F) = 2 + 1 := by norm_num
      _ = 1 := by rw [htwo, zero_add]
  refine ⟨R.toCommutingRelations, ?_, ?_, ?_, ?_, ?_⟩
  · simpa [hthree] using R.dc
  · simpa [CharTwo.neg_eq] using R.eb
  · simpa [hthree, CharTwo.neg_eq] using R.fc
  · simpa [hthree, htwo, CharTwo.neg_eq] using R.fd
  · simpa [CharTwo.neg_eq] using R.fe

@[simp] theorem product_single (L : PositiveRoots F G) (i : Fin 6) (a : F) :
    L.product (Pi.single i a) = L.x i a := by
  fin_cases i <;> simp [product]

/-- The subgroup generated by the six actual maps, without any model tag. -/
def generated (L : PositiveRoots F G) : Subgroup G :=
  Subgroup.closure (Set.range (fun p : Fin 6 × F => L.x p.1 p.2))

theorem root_mem_generated (L : PositiveRoots F G) (i : Fin 6) (a : F) :
    L.x i a ∈ L.generated := Subgroup.subset_closure ⟨(i,a), rfl⟩

theorem product_mem_generated (L : PositiveRoots F G) (t : Fin 6 → F) :
    L.product t ∈ L.generated := by
  unfold product
  exact L.generated.mul_mem (L.generated.mul_mem (L.generated.mul_mem
    (L.generated.mul_mem (L.generated.mul_mem (L.root_mem_generated 0 _)
      (L.root_mem_generated 1 _)) (L.root_mem_generated 2 _))
        (L.root_mem_generated 3 _)) (L.root_mem_generated 4 _))
          (L.root_mem_generated 5 _)

/-- Equations alone construct the map from the concrete positive group. -/
def unipotentHom (L : PositiveRoots F G) (R : L.CollectionRelations) :
    unipotent (K := F) →* G where
  toFun g := L.product (unipotentEquiv.symm g)
  map_one' := by
    have hz : unipotentEquiv (K := F) 0 = 1 := Subtype.ext unipotentProduct_zero
    rw [← hz, Equiv.symm_apply_apply, L.product_zero]
  map_mul' a b := by
    obtain ⟨t, rfl⟩ := unipotentEquiv.surjective a
    obtain ⟨u, rfl⟩ := unipotentEquiv.surjective b
    have hm : unipotentEquiv t * unipotentEquiv u =
        unipotentEquiv (unipotentProductParameters t u) :=
      Subtype.ext (unipotentProduct_mul t u)
    rw [hm, Equiv.symm_apply_apply, Equiv.symm_apply_apply, Equiv.symm_apply_apply,
      R.product_mul]

@[simp] theorem unipotentHom_product (L : PositiveRoots F G) (R : L.CollectionRelations)
    (t : Fin 6 → F) : L.unipotentHom R (unipotentEquiv t) = L.product t := by
  change L.product (unipotentEquiv.symm (unipotentEquiv t)) = _
  rw [Equiv.symm_apply_apply]

/-- The six root markings of the constructed homomorphism. -/
@[simp] theorem unipotentHom_root (L : PositiveRoots F G) (R : L.CollectionRelations)
    (i : Fin 6) (a : F) :
    L.unipotentHom R (unipotentEquiv (Pi.single i a)) = L.x i a := by
  rw [unipotentHom_product, product_single]

theorem unipotentHom_range (L : PositiveRoots F G) (R : L.CollectionRelations) :
    (L.unipotentHom R).range = L.generated := by
  apply le_antisymm
  · rintro g ⟨u, rfl⟩
    exact L.product_mem_generated _
  · apply (Subgroup.closure_le _).mpr
    rintro g ⟨⟨i,a⟩, rfl⟩
    exact ⟨unipotentEquiv (Pi.single i a), L.unipotentHom_root R i a⟩

/-- Every word in the positive generators has a six-root ordered form. -/
theorem mem_generated_iff (L : PositiveRoots F G) (R : L.CollectionRelations) (g : G) :
    g ∈ L.generated ↔ ∃ t, L.product t = g := by
  rw [← L.unipotentHom_range R]
  constructor
  · rintro ⟨u,rfl⟩
    exact ⟨unipotentEquiv.symm u, rfl⟩
  · rintro ⟨t,rfl⟩
    exact ⟨unipotentEquiv t, L.unipotentHom_product R t⟩

/-- The positive-word bound does not presume any ambient group order. -/
theorem card_generated_le [Finite F] (L : PositiveRoots F G)
    (R : L.CollectionRelations) : Nat.card L.generated ≤ Nat.card F ^ 6 := by
  rw [← L.unipotentHom_range R, ← card_unipotent]
  exact Nat.card_le_card_of_surjective (L.unipotentHom R).rangeRestrict
    (L.unipotentHom R).rangeRestrict_surjective

end PositiveRoots
end Atlas.G2.RootPresentationRecognition
