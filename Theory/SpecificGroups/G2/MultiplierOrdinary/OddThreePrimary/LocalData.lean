module

public import Theory.AtlasPort.LinearGroups.G2.Torus
public import Mathlib.GroupTheory.Sylow

/-!
# The local normalizer data for the ordinary G₂ three-primary calculation

A Sylow three-subgroup is generated by a two-generator abelian torus and
one normalizing element. One ambient element exchanges the torus generators;
another inverts the torus and centralizes the cyclic supplement. These are
literal elements and subgroups of the split-octonion automorphism model.

The configuration permits arbitrary orders of the torus generators. Its
construction for both congruence classes of the field order remains separate
from the central-cover argument in `OddThreePrimary`. No covering or multiplier
property is part of this data.

Source: the ordinary G₂ entry underlying Aschbacher–Smith I.1.1–I.1.4,
printed pp.407–408, and GLS III §6.1. The octonion model is an attributed
ATLAS port; see LICENSES/ATLAS.txt and LICENSES/ATLAS-CITATION.cff.
-/

public section

namespace Atlas.G2.MultiplierOrdinary.OddThreePrimary

open Subgroup

variable (F : Type*) [Field F]

/-- Concrete torus and normalizer witnesses for the three-primary argument.
The torus need not have exponent three, and no central commutator is assumed. -/
structure LocalData where
  sylow : Sylow 3 (Model F)
  torus : Subgroup (Model F)
  first : Model F
  second : Model F
  cycle : Model F
  swap : Model F
  inverter : Model F
  torus_generated : closure ({first, second} : Set (Model F)) = torus
  generators_commute : Commute first second
  swap_first : swap * first * swap⁻¹ = second
  swap_second : swap * second * swap⁻¹ = first
  sylow_generated : torus ⊔ zpowers cycle = (sylow : Subgroup (Model F))
  cycle_normalizes : cycle ∈ normalizer (torus : Set (Model F))
  inverts_torus : ∀ t ∈ torus, inverter * t * inverter⁻¹ = t⁻¹
  fixes_cycle : Commute inverter cycle

end Atlas.G2.MultiplierOrdinary.OddThreePrimary

end
