module

public import Theory.SpecificGroups.G2.MultiplierOrdinary.OddQuadraticTorus.OrthogonalRankOne
public import Theory.SpecificGroups.G2.MultiplierOrdinary.OddQuadraticTorus.Transfer

/-!
# Nonsplit quadratic primes in the G₂ universal kernel

For a finite field of order q, every prime r>3 dividing q+1 is absent from
the literal universal-cover kernel of G₂(q), provided q>2. In particular
this proves the required ordinary prime-field branch for p>3.

The actual octonion model contains the central product of two SL₂ factors:
on a split quaternion decomposition their action is (a,b) ↦ (AaA⁻¹,BbA⁻¹).
Its kernel consists of the two common scalar signs. Norm-one tori in the
two factors give a quadratic torus image of index prime to r. The first
factor's determinant-corrected Frobenius inverts one cyclic factor and
fixes the other. This forces all lifts of a generating Sylow pair to
commute, and perfect central Sylow transfer excludes r from the kernel.

The central-product kernel is retained throughout; no faithful product
embedding or symplectic-to-G₂ identification is assumed. All geometric
premises of the transfer calculation are discharged by the actual action.

Source: the covering calculation underlying Aschbacher–Smith I.1.1–I.1.4,
printed pp.407–408 (PDF pp.418–419), and GLS III §6.1. The octonion model
and order formula are licensed ATLAS ports; see LICENSES/ATLAS.txt and
LICENSES/ATLAS-CITATION.cff.
-/

public section

open Subgroup
namespace Atlas.G2.MultiplierOrdinary.OddQuadraticTorus

variable {F : Type*} [Field F] [Finite F]

/-- The two actual norm-one factors in the octonion model, with independent
inversion and their central-product kernel retained. -/
theorem exists_nonsplit_torus (p : ℕ) [Fact p.Prime] [CharP F p] :
    ∃ (ι : normOne F p × normOne F p →* Model F) (w : Model F),
      (∀ a, ι a = 1 → a ^ 2 = 1) ∧
      (∀ c, w * ι (c,1) * w⁻¹ = ι (c⁻¹,1)) ∧
      (∀ c, w * ι (1,c) * w⁻¹ = ι (1,c)) :=
  exists_quadratic_torus_of_rankOne_product p OrthogonalRankOne.productHom
    OrthogonalRankOne.productHom_kernel_square

/-- An actual full Sylow r-subgroup generated by the quadratic torus pair,
with its ambient partial inverter. -/
theorem exists_nonsplit_sylow (p : ℕ) [Fact p.Prime] [CharP F p]
    {r : ℕ} [Fact r.Prime] (hr : 3 < r) (hd : r ∣ Nat.card F + 1) :
    ∃ (ι : normOne F p × normOne F p →* Model F)
      (Q : Sylow r (Model F)) (x y w : Model F) (n : ℕ),
      (Q : Subgroup (Model F)) ≤ ι.range ∧
      closure ({x, y} : Set (Model F)) = (Q : Subgroup (Model F)) ∧
      n.Coprime 2 ∧ x ^ n = 1 ∧ Commute x y ∧
      w * x * w⁻¹ = x⁻¹ ∧ Commute w y := by
  obtain ⟨ι,w,hk,hinv,hfix⟩ := exists_nonsplit_torus (F := F) p
  obtain ⟨Q,x,y,n,hQ,hn,hx,hxy,hwx,hwy,hcontain⟩ := exists_quadratic_configuration ι hr
    (not_dvd_quadratic_index ι (card_normOne F p) hk hr hd) w hinv hfix
  exact ⟨ι,Q,x,y,w,n,hcontain,hQ,hn,hx,hxy,hwx,hwy⟩

/-- The quadratic exclusion for any finite perfect central cover of the model. -/
theorem not_dvd_kernel_of_quadratic_torus
    (p : ℕ) [Fact p.Prime] [CharP F p]
    {E : Type*} [Group E] [Finite E] [Group.IsPerfect E]
    (f : E →* Model F) (hf : Function.Surjective f) (hc : f.ker ≤ center E)
    {r : ℕ} [Fact r.Prime] (hr : 3 < r) (hd : r ∣ Nat.card F + 1) :
    ¬ r ∣ Nat.card f.ker :=
  not_dvd_kernel_of_rankOne_product p OrthogonalRankOne.productHom
    OrthogonalRankOne.productHom_kernel_square f hf hc hr hd

/-- The quadratic exclusion for the literal canonical universal-cover kernel. -/
theorem universal_not_dvd_kernel_of_quadratic
    (p : ℕ) [Fact p.Prime] [CharP F p] (hF : 2 < Nat.card F)
    {r : ℕ} [Fact r.Prime] (hr : 3 < r) (hd : r ∣ Nat.card F + 1) :
    ¬ r ∣ Nat.card (PerfectCentralCovering.universalProjection (Model F)).ker :=
  universal_not_dvd_kernel_of_rankOne_product p hF OrthogonalRankOne.productHom
    OrthogonalRankOne.productHom_kernel_square hr hd

/-- The requested ordinary prime-field branch, with no extra geometric premise. -/
theorem prime_universal_not_dvd_kernel_of_quadratic
    {p : ℕ} [Fact p.Prime] (hF : Nat.card F = p) (hp : 3 < p)
    {r : ℕ} [Fact r.Prime] (hr : 3 < r) (hd : r ∣ p + 1) :
    ¬ r ∣ Nat.card (PerfectCentralCovering.universalProjection (Model F)).ker := by
  let := Fintype.ofFinite F
  let : CharP F p := charP_of_card_eq_prime (by simpa only [← Nat.card_eq_fintype_card] using hF)
  exact universal_not_dvd_kernel_of_quadratic p (by omega) hr (hF ▸ hd)

end Atlas.G2.MultiplierOrdinary.OddQuadraticTorus
end
