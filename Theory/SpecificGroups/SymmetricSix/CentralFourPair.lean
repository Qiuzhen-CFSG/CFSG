module
public import Theory.SpecificGroups.SymplecticFour.Binary.ProjectiveDerived
public import Theory.SpecificGroups.AlternatingSix.ShadowLocal.Identification
public import Mathlib.GroupTheory.Perm.Sign
/-!
# Two conjugates of the marked central four generate S6

The four-group generated by (45) and (02)(13), and its conjugate by (234),
generate the full symmetric group. Five short word identities recover the
adjacent transpositions. No subgroup enumeration or recognition by order
is used. This is the explicit binary symplectic pair in E.2.7, p.219.
-/

public section
open Subgroup
namespace Theory.SpecificGroups.SymmetricSix.CentralFourPair
abbrev S6 := Equiv.Perm (Fin 6)
def transposition : S6 := Equiv.swap 4 5
def doubleTransposition : S6 := Equiv.swap 0 2 * Equiv.swap 1 3
def four : Subgroup S6 := closure {transposition,doubleTransposition}
def opposite : S6 := Equiv.swap 2 3 * Equiv.swap 3 4
theorem transposition_eq : transposition = Equiv.swap 4 5 := by rfl
theorem doubleTransposition_eq : doubleTransposition = Equiv.swap 0 2 * Equiv.swap 1 3 := by rfl
theorem four_eq_zpowers : four = zpowers transposition ⊔ zpowers doubleTransposition := by
  change closure {transposition,doubleTransposition} = _
  rw [zpowers_eq_closure,zpowers_eq_closure,←Subgroup.closure_union]
  congr 1

private def generators : Fin 4 → S6 :=
  ![transposition,doubleTransposition,
    opposite*transposition*opposite⁻¹,opposite*doubleTransposition*opposite⁻¹]
private def words : Fin 5 → List (Fin 4) :=
  ![[0,1,3,1,3,0,1,2],[2,3,0,2,3],[2,1,3,0,3,1,2],[0,1,3,0,3,0,1],[0]]
private theorem words_eval (i : Fin 5) :
    ((words i).map generators).prod = Equiv.swap i.castSucc i.succ := by
  fin_cases i <;> decide +kernel

/-- The two literal four-groups generate the full natural S6. -/
theorem pair_generates : four ⊔ four.map (MulAut.conj opposite).toMonoidHom = ⊤ := by
  let I := four ⊔ four.map (MulAut.conj opposite).toMonoidHom
  have hgens (i:Fin 4) : generators i ∈ I := by
    fin_cases i
    · change transposition ∈ I
      exact (show four ≤ I from le_sup_left) (subset_closure (by simp))
    · change doubleTransposition ∈ I
      exact (show four ≤ I from le_sup_left) (subset_closure (by simp))
    · exact (show four.map (MulAut.conj opposite).toMonoidHom ≤ I from le_sup_right) (mem_map_of_mem _ (subset_closure (by simp)))
    · exact (show four.map (MulAut.conj opposite).toMonoidHom ≤ I from le_sup_right) (mem_map_of_mem _ (subset_closure (by simp)))
  have hadj (i:Fin 5) : Equiv.swap i.castSucc i.succ ∈ I := by
    rw [← words_eval]
    exact I.list_prod_mem (by intro x hx; obtain ⟨j,_,rfl⟩ := List.mem_map.mp hx; exact hgens j)
  have htop : (⊤ : Submonoid S6) ≤ I.toSubmonoid := by
    rw [← Equiv.Perm.mclosure_swap_castSucc_succ 5]
    exact Submonoid.closure_le.mpr (by rintro _ ⟨i,rfl⟩; exact hadj i)
  exact top_unique (show (⊤ : Subgroup S6) ≤ I from htop)
end Theory.SpecificGroups.SymmetricSix.CentralFourPair
