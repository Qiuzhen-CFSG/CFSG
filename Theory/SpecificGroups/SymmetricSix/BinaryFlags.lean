module

public import Theory.SpecificGroups.SymmetricSix.Parabolics
public import Theory.GroupTheory.PResidual.FiniteImage

/-!
# Canonical six-letter flag groups

The point flag is the pair `{4,5}` and the plane flag is the partition
`{{0,1},{2,3},{4,5}}`, using zero-based indices. Their stabilizers are `H1`
and `H2`; `L1` and `L2` are their intersections with the alternating group.
The residual of `H1` and of `L1` is the embedded alternating group `K` on
`{0,1,2,3}`, strictly smaller than `L1`.

Two explicit 3-cycles generate `K`. Squares in `H1` lie in `K`, and the
quotient is a two-group; the 3-cycles survive in no two-group quotient.
Commuting each generator's square with `(01)(45)` gives that generator.
The finite generating certificate is checked by kernel reduction over the
24 permutations supported on the first four letters.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, §B.3,
Lemma B.3.4, printed pp.83–85; Notation 13.2.1, printed p.877. The latter
uses residuals, whereas the former uses intersections. The false printed
claim that the intersection itself equals its commutator is excluded.
-/

@[expose] public section

namespace Theory.SpecificGroups.SymmetricSix.BinaryFlags

open Equiv Subgroup
open scoped commutatorElement

abbrev S := Equiv.Perm (Fin 6)

/-- Stabilizer of the pair called `{5,6}` in the source. -/
def H1 : Subgroup S := MulAction.stabilizer S (pair 4 5)

/-- Stabilizer of the partition called `{{1,2},{3,4},{5,6}}` in the source. -/
def H2 : Subgroup S := synthemeStabilizer

def L1 : Subgroup S := H1 ⊓ alternatingGroup (Fin 6)
def L2 : Subgroup S := H2 ⊓ alternatingGroup (Fin 6)

/-- Even permutations fixing each of the last two letters: the embedded `A₄`. -/
def K : Subgroup S := (MulAction.stabilizer S (4 : Fin 6) ⊓
  MulAction.stabilizer S (5 : Fin 6)) ⊓ alternatingGroup (Fin 6)

def swap01 : S := Equiv.swap 0 1
def swap23 : S := Equiv.swap 2 3
def swap45 : S := Equiv.swap 4 5

/-- The subgroup generated by the three independent pair swaps. -/
def D : Subgroup S := closure {swap01, swap23, swap45}

def D0 : Subgroup S := D ⊓ alternatingGroup (Fin 6)
def cycle012 : S := Equiv.swap 0 1 * Equiv.swap 1 2
def cycle013 : S := Equiv.swap 0 1 * Equiv.swap 1 3

instance (g : S) : Decidable (g ∈ K) := by
  change Decidable ((g 4 = 4 ∧ g 5 = 5) ∧ Equiv.Perm.sign g = 1)
  infer_instance
instance (g : S) : Decidable (g ∈ H1) := by
  change Decidable ((pair 4 5).image g = pair 4 5)
  infer_instance
instance (g : S) : Decidable (g ∈ L1) := by
  change Decidable (g ∈ H1 ∧ Equiv.Perm.sign g = 1)
  infer_instance

instance (g : S) : Decidable (g ∈ H2) := by
  change Decidable (baseSyntheme.image (fun t => t.image g) = baseSyntheme)
  infer_instance

theorem mem_K {g : S} : g ∈ K ↔ (g 4 = 4 ∧ g 5 = 5) ∧ Equiv.Perm.sign g = 1 := Iff.rfl

private def fourPerms : List S := permsOfList [0, 1, 2, 3]
private def h1Perms : List S := fourPerms ++ fourPerms.map (fun g => swap45 * g)

private theorem mem_fourPerms {g : S} (h4 : g 4 = 4) (h5 : g 5 = 5) : g ∈ fourPerms := by
  apply mem_permsOfList_of_mem
  intro x hx
  fin_cases x <;> simp_all

theorem mem_H1_cases {g : S} (h : g ∈ H1) :
    (g 4 = 4 ∧ g 5 = 5) ∨ (g 4 = 5 ∧ g 5 = 4) := by
  change (pair 4 5).image g = pair 4 5 at h
  have h4 : g 4 = 4 ∨ g 4 = 5 := by
    have : g 4 ∈ (pair 4 5).image g := Finset.mem_image.mpr ⟨4, by decide, rfl⟩
    rw [h] at this
    simpa only [pair, Finset.mem_insert, Finset.mem_singleton] using this
  have h5 : g 5 = 4 ∨ g 5 = 5 := by
    have : g 5 ∈ (pair 4 5).image g := Finset.mem_image.mpr ⟨5, by decide, rfl⟩
    rw [h] at this
    simpa only [pair, Finset.mem_insert, Finset.mem_singleton] using this
  have hn : g 4 ≠ g 5 := g.injective.ne (by decide)
  rcases h4 with h4 | h4 <;> rcases h5 with h5 | h5 <;> simp_all

private theorem mem_h1Perms {g : S} (h : g ∈ H1) : g ∈ h1Perms := by
  rcases mem_H1_cases h with h | h
  · exact List.mem_append_left _ (mem_fourPerms h.1 h.2)
  · apply List.mem_append_right
    apply List.mem_map.mpr
    refine ⟨swap45 * g, mem_fourPerms ?_ ?_, ?_⟩
    · simp [swap45, Equiv.Perm.mul_apply, h.1]
    · simp [swap45, Equiv.Perm.mul_apply, h.2]
    · simp [swap45, ← mul_assoc]

theorem K_le_L1 : K ≤ L1 := by
  intro g hg
  refine ⟨?_, hg.2⟩
  change (pair 4 5).image g = pair 4 5
  simp [pair, (mem_K.mp hg).1.1, (mem_K.mp hg).1.2]

theorem K_le_H1 : K ≤ H1 := K_le_L1.trans inf_le_left

private def kWords : List S :=
  [1, cycle012, cycle012 ^ 2, cycle013, cycle013 ^ 2,
   cycle012 * cycle013, cycle012 * cycle013 ^ 2, cycle012 ^ 2 * cycle013,
   cycle012 ^ 2 * cycle013 ^ 2, cycle013 * cycle012 ^ 2,
   cycle013 ^ 2 * cycle012, cycle012 * cycle013 ^ 2 * cycle012]

set_option maxRecDepth 4096 in
private theorem kWords_cert :
    fourPerms.all (fun g => decide (Equiv.Perm.sign g = 1 → g ∈ kWords)) = true := by decide

set_option maxRecDepth 4096 in
private theorem square_cert : h1Perms.all (fun g => decide (g ^ 2 ∈ K)) = true := by decide

theorem commutator_H1_le_K : ⁅H1, H1⁆ ≤ K := by
  rw [commutator_le]
  intro g hg h hh
  have ig4 : g⁻¹ (g 4) = 4 := g.symm_apply_apply 4
  have ig5 : g⁻¹ (g 5) = 5 := g.symm_apply_apply 5
  have ih4 : h⁻¹ (h 4) = 4 := h.symm_apply_apply 4
  have ih5 : h⁻¹ (h 5) = 5 := h.symm_apply_apply 5
  apply mem_K.mpr
  constructor
  · rcases mem_H1_cases hg with ⟨hg4, hg5⟩ | ⟨hg4, hg5⟩ <;>
      rcases mem_H1_cases hh with ⟨hh4, hh5⟩ | ⟨hh4, hh5⟩ <;>
      simp_all [commutatorElement_def, Equiv.Perm.mul_apply]
  · simp [commutatorElement_def, mul_assoc, mul_left_comm, mul_comm]

theorem K_eq_closure : K = closure {cycle012, cycle013} := by
  apply le_antisymm
  · intro g hg
    have hcert : ∀ g ∈ fourPerms, Equiv.Perm.sign g = 1 → g ∈ kWords := by
      simpa only [List.all_eq_true, decide_eq_true_eq] using kWords_cert
    have hw := hcert g (mem_fourPerms hg.1.1 hg.1.2) hg.2
    have ha : cycle012 ∈ closure ({cycle012, cycle013} : Set S) := subset_closure (by simp)
    have hb : cycle013 ∈ closure ({cycle012, cycle013} : Set S) := subset_closure (by simp)
    simp only [kWords, List.mem_cons, List.not_mem_nil, or_false] at hw
    rcases hw with rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl | rfl
    · exact one_mem _
    · exact ha
    · exact pow_mem ha 2
    · exact hb
    · exact pow_mem hb 2
    · exact mul_mem ha hb
    · exact mul_mem ha (pow_mem hb 2)
    · exact mul_mem (pow_mem ha 2) hb
    · exact mul_mem (pow_mem ha 2) (pow_mem hb 2)
    · exact mul_mem hb (pow_mem ha 2)
    · exact mul_mem (pow_mem hb 2) ha
    · exact mul_mem (mul_mem ha (pow_mem hb 2)) ha
  · rw [closure_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    change cycle012 ∈ K ∧ cycle013 ∈ K
    exact ⟨by decide, by decide⟩

theorem L1_ne_K : L1 ≠ K := by
  intro heq
  have h : swap01 * swap45 ∈ L1 := by decide
  rw [heq] at h
  exact (by decide : swap01 * swap45 ∉ K) h

theorem D_le_H1 : D ≤ H1 := by
  rw [D, closure_le]
  intro g hg
  rcases hg with rfl | rfl | rfl <;> change _ ∈ H1 <;> decide

theorem swap01_mem_D : swap01 ∈ D := subset_closure (by simp)
theorem swap23_mem_D : swap23 ∈ D := subset_closure (by simp)
theorem swap45_mem_D : swap45 ∈ D := subset_closure (by simp)
theorem swap01_swap45_mem_D0 : swap01 * swap45 ∈ D0 :=
  ⟨D.mul_mem swap01_mem_D swap45_mem_D,
    by change Equiv.Perm.sign (swap01 * swap45) = 1; decide⟩

theorem K_le_commutator_K_D0 : K ≤ ⁅K, D0⁆ := by
  apply K_eq_closure.le.trans
  rw [closure_le, Set.insert_subset_iff, Set.singleton_subset_iff]
  constructor
  · have heq : ⁅cycle012 ^ 2, swap01 * swap45⁆ = cycle012 := by decide
    rw [← heq]
    exact commutator_mem_commutator (K.pow_mem (by decide : cycle012 ∈ K) 2)
      swap01_swap45_mem_D0
  · have heq : ⁅cycle013 ^ 2, swap01 * swap45⁆ = cycle013 := by decide
    rw [← heq]
    exact commutator_mem_commutator (K.pow_mem (by decide : cycle013 ∈ K) 2)
      swap01_swap45_mem_D0

theorem commutator_eq_K_of_between (M J : Subgroup S)
    (hKM : K ≤ M) (hM : M ≤ H1) (hD : D0 ≤ J) (hJ : J ≤ H1) :
    ⁅M, J⁆ = K :=
  le_antisymm ((commutator_mono hM hJ).trans commutator_H1_le_K)
    (K_le_commutator_K_D0.trans (commutator_mono hKM hD))

theorem residual_eq_K_of_between (M : Subgroup S) (hKM : K ≤ M) (hM : M ≤ H1) :
    (pResidual 2 M).map M.subtype = K := by
  let N := K.subgroupOf M
  have hnormal : N.Normal := by
    constructor
    intro n hn g
    change (n : S) ∈ K at hn
    change (g : S) * (n : S) * (g : S)⁻¹ ∈ K
    have hc : ⁅(g : S), (n : S)⁆ ∈ K := commutator_H1_le_K
      (commutator_mem_commutator (hM g.property) (hM n.property))
    simpa only [commutatorElement_def, mul_assoc, inv_mul_cancel, mul_one]
      using K.mul_mem hc hn
  let := hnormal
  have hp : IsPGroup 2 (M ⧸ N) := by
    intro x
    obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective N x
    refine ⟨1, ?_⟩
    rw [pow_one, ← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    change (g : S) ^ 2 ∈ K
    have hcert : ∀ g ∈ h1Perms, g ^ 2 ∈ K := by
      simpa only [List.all_eq_true, decide_eq_true_eq] using square_cert
    exact hcert g (mem_h1Perms (hM g.property))
  apply le_antisymm
  · have hr : pResidual 2 M ≤ N := sInf_le ⟨hnormal, hp⟩
    exact (map_mono hr).trans_eq (map_subgroupOf_eq_of_le hKM)
  · rw [K_eq_closure, closure_le, Set.insert_subset_iff, Set.singleton_subset_iff]
    have hgen (x : S) (hx : x ∈ K) (hx3 : x ^ 3 = 1) :
        x ∈ (pResidual 2 M).map M.subtype := by
      let y : M := ⟨x, hKM hx⟩
      have hy3 : y ^ 3 = 1 := Subtype.ext hx3
      have hc : Nat.Coprime 2 (orderOf y) :=
        Nat.Coprime.of_dvd_right (orderOf_dvd_of_pow_eq_one hy3) (by decide)
      exact ⟨y, mem_pResidual_of_orderOf_coprime hc, rfl⟩
    exact ⟨hgen cycle012 (by decide) (by decide), hgen cycle013 (by decide) (by decide)⟩

/-- The elementary abelian group generated by the three pair swaps preserves
both members of the canonical flag. -/
theorem D_le_H2 : D ≤ H2 := by
  rw [D, closure_le]
  intro g hg
  rcases hg with rfl | rfl | rfl <;> change _ ∈ H2 <;> decide

theorem D0_le_L1 : D0 ≤ L1 := inf_le_inf D_le_H1 le_rfl

theorem D0_le_L2 : D0 ≤ L2 := inf_le_inf D_le_H2 le_rfl

/-- The ambient residual image of the full pair stabilizer. -/
theorem residual_H1 : (pResidual 2 H1).map H1.subtype = K :=
  residual_eq_K_of_between H1 K_le_H1 le_rfl

/-- The ambient residual image of its alternating intersection. -/
theorem residual_L1 : (pResidual 2 L1).map L1.subtype = K :=
  residual_eq_K_of_between L1 K_le_L1 inf_le_left

theorem commutator_L1_D : ⁅L1, D⁆ = K :=
  commutator_eq_K_of_between L1 D K_le_L1 inf_le_left inf_le_left D_le_H1

theorem commutator_L1_D0 : ⁅L1, D0⁆ = K :=
  commutator_eq_K_of_between L1 D0 K_le_L1 inf_le_left le_rfl
    (inf_le_left.trans D_le_H1)

theorem commutator_K_D : ⁅K, D⁆ = K :=
  commutator_eq_K_of_between K D le_rfl K_le_H1 inf_le_left D_le_H1

theorem commutator_K_D0 : ⁅K, D0⁆ = K :=
  commutator_eq_K_of_between K D0 le_rfl K_le_H1 le_rfl
    (inf_le_left.trans D_le_H1)

/-- The intersection appearing in B.3.4 is strictly larger than the residual
used in Notation 13.2.1. -/
theorem K_lt_L1 : K < L1 := lt_of_le_of_ne K_le_L1 L1_ne_K.symm

/-- In particular, the literal intersection version of the printed
commutator assertion cannot hold. -/
theorem L1_ne_commutator_L1_D : L1 ≠ ⁅L1, D⁆ := by
  rw [commutator_L1_D]
  exact L1_ne_K

end Theory.SpecificGroups.SymmetricSix.BinaryFlags
