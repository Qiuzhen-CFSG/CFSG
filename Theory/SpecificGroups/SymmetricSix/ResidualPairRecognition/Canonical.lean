module

public import Theory.SpecificGroups.SymmetricSix.ResidualPairRecognition.Models
public import Theory.GroupTheory.PResidual.FiniteImage
public import Mathlib.GroupTheory.SpecificGroups.Dihedral
/-!
# The canonical residual pair in S₆

Each tetrahedral image is the two-residual of its parabolic: all squares
belong to the image, so its quotient is an elementary abelian two-group,
while the image is generated by elements of order dividing three. Transport
of the Klein four core of A₄ then gives the two embedded cores. Their join
is the image of an explicit injective dihedral action; the double
transposition `(23)(45)` belongs to both cores.

Source: Aschbacher–Smith, the paragraph following 15.4.23, printed p.1165
(combined manuscript, 1 March 2004).
-/

@[expose] public section

open Subgroup Equiv
namespace Theory.SpecificGroups.SymmetricSix.ResidualPairRecognition
set_option maxRecDepth 100000
local instance : Fintype (Equiv.Perm (Fin 4)) := fintypePerm
local instance : Fintype S6 := fintypePerm
local instance : Fintype A := Subtype.fintype _
theorem duadHom_le : duadHom.range ≤ duadStabilizer := by
  rintro g ⟨a, rfl⟩
  exact duadProductHom_mem _

theorem synthemeHom_le : synthemeHom.range ≤ synthemeStabilizer := by
  rintro g ⟨a, rfl⟩
  exact (show ∀ a : A, synthemeHom a ∈ synthemeStabilizer by decide +kernel) a


theorem residual_range (H : Subgroup S6) (f : A →* S6)
    (hle : f.range ≤ H) (hsq : ∀ g : H, g.val ^ 2 ∈ f.range) :
    (pResidual 2 H).map H.subtype = f.range := by
  let N := f.range.subgroupOf H
  have hn : N.Normal := by
    constructor
    intro n hn g
    change (n : S6) ∈ f.range at hn
    change (g : S6) * (n : S6) * (g : S6)⁻¹ ∈ f.range
    have hh := f.range.mul_mem (f.range.mul_mem (hsq (g * n)) (f.range.inv_mem hn))
      (hsq g⁻¹)
    convert hh using 1
    simp [pow_two, mul_assoc]
  let _ := hn
  have hp : IsPGroup 2 (H ⧸ N) := by
    intro x
    obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective N x
    refine ⟨1, ?_⟩
    rw [pow_one, ← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact hsq g
  apply le_antisymm
  · exact (map_mono (show pResidual 2 H ≤ N from sInf_le ⟨hn, hp⟩)).trans_eq
      (map_subgroupOf_eq_of_le hle)
  · rintro x ⟨a, rfl⟩
    obtain ⟨b, c, hb, hc, rfl⟩ := odd_factorization a
    have hm (b : A) (hb : b ^ 3 = 1) : f b ∈ (pResidual 2 H).map H.subtype := by
      let y : H := ⟨f b, hle (⟨b, rfl⟩)⟩
      have hy : y ^ 3 = 1 := Subtype.ext (by
        change f b ^ 3 = 1
        rw [← map_pow, hb, map_one])
      have ho : Nat.Coprime 2 (orderOf y) :=
        Nat.Coprime.of_dvd_right (orderOf_dvd_of_pow_eq_one hy) (by decide)
      exact ⟨y, mem_pResidual_of_orderOf_coprime ho, rfl⟩
    rw [map_mul]
    exact mul_mem (hm b hb) (hm c hc)

theorem core_range (f : A →* S6) (hf : Function.Injective f) :
    f.range.pCoreIn 2 = klein.map f := by
  rw [pCoreIn, ← pCore_map_iso 2 (MonoidHom.ofInjective hf), map_map, klein_core]
  rfl

def rotation : S6 :=
  (Equiv.swap 2 4 * Equiv.swap 3 5) * (Equiv.swap 0 1 * Equiv.swap 2 3)
def reflection : S6 := Equiv.swap 2 4 * Equiv.swap 3 5

def dihedralHom : DihedralGroup 4 →* S6 where
  toFun d := match d with
    | .r i => rotation ^ i.val
    | .sr i => reflection * rotation ^ i.val
  map_one' := by decide +kernel
  map_mul' := by decide +kernel

theorem dihedralHom_injective : Function.Injective dihedralHom := by decide +kernel

instance (g : S6) : Decidable (g ∈ dihedralHom.range) :=
  inferInstanceAs (Decidable (∃ d : DihedralGroup 4, dihedralHom d = g))
instance (g : S6) : Decidable (g ∈ klein.map duadHom) :=
  inferInstanceAs (Decidable (∃ a : A, a ∈ klein ∧ duadHom a = g))
instance (g : S6) : Decidable (g ∈ klein.map synthemeHom) :=
  inferInstanceAs (Decidable (∃ a : A, a ∈ klein ∧ synthemeHom a = g))

theorem core_join : klein.map duadHom ⊔ klein.map synthemeHom = dihedralHom.range := by
  apply le_antisymm
  · apply sup_le
    · rintro g ⟨a, ha, rfl⟩
      exact (show ∀ a : A, a ∈ klein → duadHom a ∈ dihedralHom.range by decide +kernel) a ha
    · rintro g ⟨a, ha, rfl⟩
      exact (show ∀ a : A, a ∈ klein → synthemeHom a ∈ dihedralHom.range by decide +kernel) a ha
  · let J := klein.map duadHom ⊔ klein.map synthemeHom
    have hs : reflection ∈ J := (show klein.map duadHom ≤ J from le_sup_left) (by decide : reflection ∈ klein.map duadHom)
    have ht : Equiv.swap 0 1 * Equiv.swap 2 3 ∈ J :=
      (show klein.map synthemeHom ≤ J from le_sup_right)
        (by decide : Equiv.swap 0 1 * Equiv.swap 2 3 ∈ klein.map synthemeHom)
    have hr : rotation ∈ J := J.mul_mem hs ht
    rintro g ⟨d, rfl⟩
    cases d with
    | r i => exact J.pow_mem hr i.val
    | sr i => exact J.mul_mem hs (J.pow_mem hr i.val)

theorem core_intersection : klein.map duadHom ⊓ klein.map synthemeHom ≠ ⊥ := by
  intro h
  have hm : Equiv.swap 2 3 * Equiv.swap 4 5 ∈ klein.map duadHom ⊓ klein.map synthemeHom :=
    ⟨by change _ ∈ klein.map duadHom; decide,
      by change _ ∈ klein.map synthemeHom; decide⟩
  rw [h] at hm
  exact (by decide : (Equiv.swap 2 3 * Equiv.swap 4 5 : S6) ≠ 1) hm

theorem duad_square : ∀ g : duadStabilizer, g.val ^ 2 ∈ duadHom.range := by decide +kernel

theorem syntheme_square : ∀ g : synthemeStabilizer, g.val ^ 2 ∈ synthemeHom.range := by decide +kernel

/-- The full duad parabolic has precisely the complementary A₄ as two-residual. -/
theorem residual_duad : (pResidual 2 duadStabilizer).map duadStabilizer.subtype =
    duadHom.range := residual_range _ _ duadHom_le duad_square

/-- The full syntheme parabolic has precisely the tetrahedral edge image as two-residual. -/
theorem residual_syntheme : (pResidual 2 synthemeStabilizer).map synthemeStabilizer.subtype =
    synthemeHom.range := residual_range _ _ synthemeHom_le syntheme_square

end Theory.SpecificGroups.SymmetricSix.ResidualPairRecognition
