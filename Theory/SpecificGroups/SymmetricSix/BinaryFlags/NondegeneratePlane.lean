module

public import Theory.SpecificGroups.SymmetricSix.BinaryFlags.NaturalPairing
public import Mathlib.GroupTheory.Perm.Cycle.Type
public import Mathlib.GroupTheory.SpecificGroups.Cyclic
/-!
# Pointwise fixers of the canonical nondegenerate plane

The span of the duads 01 and 02 has pointwise fixer the permutations of
the complementary three letters. Its six explicit words compute its
order without enumerating all permutations of six letters. Every
nontrivial two-subgroup of this fixer is generated by a transposition.
The proof retains the actual binary augmentation quotient and action.

Source: Aschbacher--Smith, 13.5.6, printed p.917; the extraction of
Q₀'s transposition image before C.1.24(c).
-/

@[expose] public section
open Subgroup BinaryPermutation Equiv Equiv.Perm
namespace Theory.SpecificGroups.SymmetricSix.BinaryFlags.NondegeneratePlane
open NaturalGeometry NaturalPairing Representation.BinaryOffender
noncomputable def plane : Submodule (ZMod 2) V :=
  Submodule.span (ZMod 2) {pairVector 0 1,pairVector 0 2}

def complementFixer : Subgroup S where
  carrier:={g|g 0=0 ∧ g 1=1 ∧ g 2=2}
  one_mem':=⟨rfl,rfl,rfl⟩
  mul_mem':=by
    rintro g h ⟨g0,g1,g2⟩ ⟨h0,h1,h2⟩
    exact ⟨by simpa only [Perm.mul_apply,h0] using g0,
      by simpa only [Perm.mul_apply,h1] using g1,
      by simpa only [Perm.mul_apply,h2] using g2⟩
  inv_mem':=by
    rintro g ⟨g0,g1,g2⟩
    exact ⟨g.symm_apply_eq.mpr g0.symm,g.symm_apply_eq.mpr g1.symm,g.symm_apply_eq.mpr g2.symm⟩

private theorem two_pairs_fix_three (a b c:Fin 6)
    (h:pair a b=pair 0 1) (h':pair a c=pair 0 2) : a=0 ∧ b=1 ∧ c=2 := by
  decide +revert

theorem fixes_plane_iff (g:S) :
    (∀v∈plane,naturalRepresentation Ω g v=v) ↔ g∈complementFixer := by
  constructor
  · intro h
    have h1:=h (pairVector 0 1) (Submodule.subset_span (by simp))
    have h2:=h (pairVector 0 2) (Submodule.subset_span (by simp))
    rw [pairVector_map] at h1 h2
    exact two_pairs_fix_three _ _ _
      ((pairVector_eq_iff (g.injective.ne (by decide)) (by decide)).mp h1)
      ((pairVector_eq_iff (g.injective.ne (by decide)) (by decide)).mp h2)
  · rintro ⟨h0,h1,h2⟩ v hv
    change v∈Submodule.span (ZMod 2) {pairVector 0 1,pairVector 0 2} at hv
    induction hv using Submodule.span_induction with
    | mem x hx =>
      rcases Set.mem_insert_iff.mp hx with rfl|hx
      · rw [pairVector_map,h0,h1]
      · have hx':x=pairVector 0 2:=Set.mem_singleton_iff.mp hx
        rw [hx',pairVector_map,h0,h2]
    | zero => exact map_zero _
    | add x y _ _ hx hy => rw [map_add,hx,hy]
    | smul c x _ hx => rw [map_smul,hx]

private def word (i:Fin 6):S :=
  ![1,swap 3 4,swap 3 5,swap 4 5,swap 3 4*swap 4 5,swap 4 5*swap 3 4] i

private theorem words_mem (i:Fin 6):word i 0=0 ∧ word i 1=1 ∧ word i 2=2 := by decide +revert

private theorem triple_words (a b c:Fin 3) (hab:a≠b) (hac:a≠c) (hbc:b≠c) :
    ∃i:Fin 6,word i 3=⟨a.val+3,by omega⟩ ∧
      word i 4=⟨b.val+3,by omega⟩ ∧ word i 5=⟨c.val+3,by omega⟩ := by
  decide +revert

private theorem words (g:S):g∈complementFixer ↔ ∃i:Fin 6,word i=g := by
  constructor
  · rintro ⟨h0,h1,h2⟩
    have hge (j:Fin 6) (hj:3≤j.val):3≤(g j).val := by
      have ha:g j≠0 := by intro he;have hh:=g.injective (he.trans h0.symm);have:=congrArg Fin.val hh;omega
      have hb:g j≠1 := by intro he;have hh:=g.injective (he.trans h1.symm);have:=congrArg Fin.val hh;omega
      have hc:g j≠2 := by intro he;have hh:=g.injective (he.trans h2.symm);have:=congrArg Fin.val hh;omega
      have ha':(g j).val≠0:=fun h=>ha (Fin.ext h)
      have hb':(g j).val≠1:=fun h=>hb (Fin.ext h)
      have hc':(g j).val≠2:=fun h=>hc (Fin.ext h)
      omega
    let f:Fin 3→Fin 3:=fun j=>⟨(g ⟨j.val+3,by omega⟩).val-3,by have:=hge ⟨j.val+3,by omega⟩ (by change 3≤j.val+3;omega);omega⟩
    have hf:Function.Injective f := by
      intro a b he
      have he':(g ⟨a.val+3,by omega⟩).val-3=(g ⟨b.val+3,by omega⟩).val-3:=congrArg Fin.val he
      have ha:=hge ⟨a.val+3,by omega⟩ (by change 3≤a.val+3;omega)
      have hb:=hge ⟨b.val+3,by omega⟩ (by change 3≤b.val+3;omega)
      have hx:g ⟨a.val+3,by omega⟩=g ⟨b.val+3,by omega⟩:=Fin.ext (by omega)
      have hi:=congrArg Fin.val (g.injective hx)
      change a.val+3=b.val+3 at hi
      exact Fin.ext (by omega)
    obtain ⟨i,hi3,hi4,hi5⟩:=triple_words (f 0) (f 1) (f 2)
      (hf.ne (by decide)) (hf.ne (by decide)) (hf.ne (by decide))
    refine ⟨i,?_⟩
    ext j : 1
    fin_cases j
    · exact (words_mem i).1.trans h0.symm
    · exact (words_mem i).2.1.trans h1.symm
    · exact (words_mem i).2.2.trans h2.symm
    · change word i 3=g 3
      rw [hi3];apply Fin.ext;change (g 3).val-3+3=(g 3).val;have:=hge 3 (by decide);omega
    · change word i 4=g 4
      rw [hi4];apply Fin.ext;change (g 4).val-3+3=(g 4).val;have:=hge 4 (by decide);omega
    · change word i 5=g 5
      rw [hi5];apply Fin.ext;change (g 5).val-3+3=(g 5).val;have:=hge 5 (by decide);omega
  · rintro ⟨i,rfl⟩
    exact words_mem i

private theorem word_injective:Function.Injective word := by decide

theorem complementFixer_card : Nat.card complementFixer=6 := by
  let e:Fin 6≃complementFixer:=Equiv.ofBijective
    (fun i=>⟨word i,(words _).mpr ⟨i,rfl⟩⟩)
    ⟨fun i j h=>word_injective (congrArg Subtype.val h),fun g=>by
      obtain ⟨i,hi⟩:=(words g).mp g.property
      exact ⟨i,Subtype.ext hi⟩⟩
  exact (Nat.card_congr e.symm).trans (by simp)

private theorem word_two_swap (i:Fin 6) (hi:orderOf (word i)=2) : (word i).IsSwap := by
  fin_cases i
  · change orderOf (1:S)=2 at hi
    rw [orderOf_one] at hi
    contradiction
  · exact ⟨3,4,by decide,rfl⟩
  · exact ⟨3,5,by decide,rfl⟩
  · exact ⟨4,5,by decide,rfl⟩
  · have hp:(word 4)^3=1 := by decide
    have hi':orderOf (word 4)=2:=hi
    have hd:=orderOf_dvd_of_pow_eq_one hp
    rw [hi'] at hd
    norm_num at hd
  · have hp:(word 5)^3=1 := by decide
    have hi':orderOf (word 5)=2:=hi
    have hd:=orderOf_dvd_of_pow_eq_one hp
    rw [hi'] at hd
    norm_num at hd

theorem twoGroup_fixer (A:Subgroup S) (hA:IsPGroup 2 A) (hle:A≤complementFixer) :
    A=⊥ ∨ ∃r:S,r.IsSwap ∧ A=zpowers r := by
  have hd:Nat.card A∣6 := by simpa only [complementFixer_card] using card_dvd_of_le hle
  obtain ⟨n,hn⟩:=hA.exists_card_eq
  have htwo:Nat.card A∣2 := by
    rw [hn] at hd ⊢
    have hnle:n≤1 := by
      by_contra hb
      have hh:4∣6:=(pow_dvd_pow 2 (by omega : 2≤n)).trans hd
      norm_num at hh
    exact pow_dvd_pow 2 hnle
  rcases Nat.prime_two.eq_one_or_self_of_dvd _ htwo with hone|htwo
  · exact Or.inl (card_eq_one.mp hone)
  · obtain ⟨a,ha⟩:=exists_prime_orderOf_dvd_card' (G:=A) 2 (by rw [htwo])
    have har:orderOf a.val=2:=(orderOf_injective A.subtype A.subtype_injective a).trans ha
    obtain ⟨i,hi⟩:=(words a.val).mp (hle a.property)
    refine Or.inr ⟨a.val,hi ▸ word_two_swap i (hi.symm ▸ har),?_⟩
    apply (eq_of_le_of_card_ge (zpowers_le.mpr a.property) ?_).symm
    rw [Nat.card_zpowers,har,htwo]
end Theory.SpecificGroups.SymmetricSix.BinaryFlags.NondegeneratePlane
