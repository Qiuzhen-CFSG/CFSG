module

public import Theory.SpecificGroups.SymmetricSix.BinaryFlags.PointCoreNormal
public import Theory.SpecificGroups.SymmetricSix.BinaryFlags.TransvectionPair
public import Mathlib.GroupTheory.Perm.Sign

/-!
# A point core and a crossing transposition generate S₆

The elementary point core is transitive on the eight transpositions crossing
its distinguished duad. Conjugating one of them by its Klein four gives
all four transpositions joining the complementary letters to that duad.
These and the duad transposition generate the symmetric group. Transport
along the actual binary natural action proves the statement for every point.

Source: Aschbacher–Smith, 13.7.17, printed p.944: the subgroup generated by
the original local core and the two conjugate spans surjects onto S₆.
-/

@[expose] public section
open Subgroup BinaryPermutation
namespace Theory.SpecificGroups.SymmetricSix.BinaryFlags.PointCoreGeneration
open NaturalGeometry NaturalPairing Representation.BinaryOffender

private abbrev lineA : S := swap01 * swap23
private abbrev lineB : S := Equiv.swap 0 2 * Equiv.swap 1 3

private def coreWords : List S :=
  [1,lineA,lineB,lineA*lineB,swap45,swap45*lineA,swap45*lineB,swap45*(lineA*lineB)]

private theorem core_word_mem {x : S} (hx : x ∈ coreWords) : x ∈ pointCore := by
  have hs : swap45 ∈ pointCore := by
    rw [pointCore_eq_closure]
    exact subset_closure (by simp)
  have ha : lineA ∈ pointCore := by
    rw [pointCore_eq_closure]
    exact subset_closure (by simp)
  have hb : lineB ∈ pointCore := by
    rw [pointCore_eq_closure]
    exact subset_closure (by simp)
  simp only [coreWords,List.mem_cons,List.not_mem_nil,or_false] at hx
  rcases hx with rfl|rfl|rfl|rfl|rfl|rfl|rfl|rfl
  · exact one_mem _
  · exact ha
  · exact hb
  · exact mul_mem ha hb
  · exact hs
  · exact mul_mem hs ha
  · exact mul_mem hs hb
  · exact mul_mem hs (mul_mem ha hb)

private theorem crossing_relabel : ∀ i j : Fin 6,
    ¬ Commute swap45 (Equiv.swap i j) →
      ∃ k ∈ coreWords, k * Equiv.swap i j * k⁻¹ = Equiv.swap 3 5 := by
  simp only [coreWords,List.mem_cons,List.not_mem_nil,or_false,exists_eq_or_imp,
    exists_eq_left]
  change ∀i j:Fin 6, swap45*Equiv.swap i j ≠ Equiv.swap i j*swap45 → _
  decide +kernel

private theorem canonical_generate : pointCore ⊔ zpowers (Equiv.swap (3:Fin 6) 5) = ⊤ := by
  let N := pointCore ⊔ zpowers (Equiv.swap (3:Fin 6) 5)
  have hs : swap45 ∈ N := mem_sup_left (core_word_mem (by simp [coreWords]))
  have ha : lineA ∈ N := mem_sup_left (core_word_mem (by simp [coreWords]))
  have hb : lineB ∈ N := mem_sup_left (core_word_mem (by simp [coreWords]))
  have ht : Equiv.swap (3:Fin 6) 5 ∈ N := mem_sup_right (mem_zpowers _)
  have hconj (k : S) (hk : k ∈ N) : k * Equiv.swap (3:Fin 6) 5 * k⁻¹ ∈ N :=
    N.mul_mem (N.mul_mem hk ht) (N.inv_mem hk)
  have hstar : ∀ i : Fin 5, Equiv.swap i.castSucc (5:Fin 6) ∈ N := by
    intro i
    fin_cases i
    · have he : (lineA*lineB)*Equiv.swap (3:Fin 6) 5*(lineA*lineB)⁻¹=Equiv.swap (0:Fin 6) 5 := by decide +kernel
      exact he ▸ hconj (lineA*lineB) (N.mul_mem ha hb)
    · have he : lineB*Equiv.swap (3:Fin 6) 5*lineB⁻¹=Equiv.swap (1:Fin 6) 5 := by decide +kernel
      exact he ▸ hconj lineB hb
    · have he : lineA*Equiv.swap (3:Fin 6) 5*lineA⁻¹=Equiv.swap (2:Fin 6) 5 := by decide +kernel
      exact he ▸ hconj lineA ha
    · exact ht
    · exact hs
  apply top_unique
  rw [←Subgroup.closure_eq_top_of_mclosure_eq_top (Equiv.Perm.mclosure_swap_castSucc_succ 5)]
  apply (closure_le _).mpr
  rintro _ ⟨i,rfl⟩
  fin_cases i
  · change Equiv.swap (0:Fin 6) 1∈N
    have he : Equiv.swap (0:Fin 6) 1=Equiv.swap (0:Fin 6) 5*Equiv.swap 1 5*Equiv.swap 0 5 := by decide +kernel
    rw [he]
    exact N.mul_mem (N.mul_mem (hstar 0) (hstar 1)) (hstar 0)
  · change Equiv.swap (1:Fin 6) 2∈N
    have he : Equiv.swap (1:Fin 6) 2=Equiv.swap (1:Fin 6) 5*Equiv.swap 2 5*Equiv.swap 1 5 := by decide +kernel
    rw [he]
    exact N.mul_mem (N.mul_mem (hstar 1) (hstar 2)) (hstar 1)
  · change Equiv.swap (2:Fin 6) 3∈N
    have he : Equiv.swap (2:Fin 6) 3=Equiv.swap (2:Fin 6) 5*Equiv.swap 3 5*Equiv.swap 2 5 := by decide +kernel
    rw [he]
    exact N.mul_mem (N.mul_mem (hstar 2) (hstar 3)) (hstar 2)
  · change Equiv.swap (3:Fin 6) 4∈N
    have he : Equiv.swap (3:Fin 6) 4=Equiv.swap (3:Fin 6) 5*Equiv.swap 4 5*Equiv.swap 3 5 := by decide +kernel
    rw [he]
    exact N.mul_mem (N.mul_mem (hstar 3) (hstar 4)) (hstar 3)
  · exact hstar 4

private theorem canonical_crossing_generate (s:S) (hs:s.IsSwap) (hn:¬Commute swap45 s) :
    pointCore ⊔ zpowers s=⊤ := by
  obtain ⟨i,j,_,rfl⟩:=hs
  obtain ⟨k,hk,he⟩:=crossing_relabel i j hn
  have hkm:k∈pointCore⊔zpowers (Equiv.swap i j):=mem_sup_left (core_word_mem hk)
  have hsm:Equiv.swap i j∈pointCore⊔zpowers (Equiv.swap i j):=mem_sup_right (mem_zpowers _)
  apply top_unique
  rw [←canonical_generate]
  exact sup_le le_sup_left (zpowers_le.mpr (he ▸ mul_mem (mul_mem hkm hsm) (inv_mem hkm)))

private theorem swap_in_core {t:S} (ht:t.IsSwap) (hm:t∈pointCore) : t=swap45 := by
  have hc : ∀x:DuadProduct, x∈DuadCalculation.productCore →
      (MulAut.conj flagRelabel) (duadProductHom x) ∈ coreWords := by
    simp only [DuadCalculation.productCore,mem_prod,mem_top,true_and,DuadCalculation.core_mem_iff]
    decide +kernel
  obtain ⟨x,hx,rfl⟩:=hm
  change ((MulAut.conj flagRelabel) (duadProductHom x)).IsSwap at ht
  change (MulAut.conj flagRelabel) (duadProductHom x)=swap45
  have hw:=hc x hx
  simp only [coreWords,List.mem_cons,List.not_mem_nil,or_false] at hw
  rcases hw with he|he|he|he|he|he|he|he
  all_goals rw [he] at ht ⊢
  all_goals first | rfl | (exfalso; have hh:=Equiv.Perm.isSwap_iff_cycleType.mp ht; revert hh; decide +kernel)

private theorem conjugate_stabilizes (P : Submodule (ZMod 2) V) (g h : S)
    (hh : h ∈ subspaceStabilizer (naturalRepresentation Ω) P) :
    g*h*g⁻¹ ∈ subspaceStabilizer (naturalRepresentation Ω) (P.map (naturalRepresentation Ω g)) := by
  apply (mem_stabilizer_iff_map _ _).mpr
  have hh' := (mem_stabilizer_iff_map _ _).mp hh
  simp only [map_mul,Module.End.mul_eq_comp,Submodule.map_comp]
  rw [←Submodule.map_comp (naturalRepresentation Ω g) (naturalRepresentation Ω g⁻¹),
    ←Module.End.mul_eq_comp,←map_mul,inv_mul_cancel,map_one,
    Module.End.one_eq_id,Submodule.map_id,hh']

/-- The full point core and any transposition crossing its point transposition
 generate the actual symmetric group on six letters. -/
theorem point_core_generate (P:Submodule (ZMod 2) V)
    (hP:Module.finrank (ZMod 2) P=1) (t s:S) (ht:t.IsSwap) (hs:s.IsSwap)
    (htC:t∈(subspaceStabilizer (naturalRepresentation Ω) P).pCoreIn 2)
    (hn:¬Commute t s) :
    (subspaceStabilizer (naturalRepresentation Ω) P).pCoreIn 2 ⊔ zpowers s=⊤ := by
  have hP0:P≠⊥:=by intro he;rw [he,finrank_bot] at hP;contradiction
  obtain ⟨v,hv,hv0⟩:=(Submodule.ne_bot_iff P).mp hP0
  obtain ⟨a,ha⟩:=NaturalTransport.exists_even_image v hv0
  let g:S:=a.val
  have hPg:canonicalLine.map (naturalRepresentation Ω g)=P := by
    rw [canonicalLine,Submodule.map_span,Set.image_singleton,ha]
    exact (eq_span_singleton_of_mem_of_finrank_eq_one hP hv hv0).symm
  let c: S→*S := (MulAut.conj g⁻¹).toMonoidHom
  have hback:P.map (naturalRepresentation Ω g⁻¹)=canonicalLine := by
    rw [←hPg,←Submodule.map_comp,←Module.End.mul_eq_comp,←map_mul,inv_mul_cancel,
      map_one,Module.End.one_eq_id,Submodule.map_id]
  have he:(subspaceStabilizer (naturalRepresentation Ω) P).map c=H1 := by
    apply le_antisymm
    · rintro _ ⟨x,hx,rfl⟩
      have hh:=conjugate_stabilizes P g⁻¹ x hx
      rw [hback] at hh
      exact (canonicalLine_stabilizer _).mp ((mem_stabilizer_iff_map _ _).mp hh)
    · intro x hx
      refine ⟨g*x*g⁻¹,?_,?_⟩
      · rw [←hPg]
        exact conjugate_stabilizes _ g x
          ((mem_stabilizer_iff_map _ _).mpr (canonicalLine_map_of_mem hx))
      · change g⁻¹*(g*x*g⁻¹)*(g⁻¹)⁻¹=x
        simp [mul_assoc]
  have hec:((subspaceStabilizer (naturalRepresentation Ω) P).pCoreIn 2).map c=pointCore := by
    rw [map_pCoreIn_of_injective 2 _ _ (MulAut.conj g⁻¹).injective,he,H1_core_eq_pointCore]
  have isSwap_map (r:S) (hr:r.IsSwap):(c r).IsSwap := by
    obtain ⟨i,j,hij,rfl⟩:=hr
    change (g⁻¹*Equiv.swap i j*(g⁻¹)⁻¹).IsSwap
    rw [←Equiv.swap_apply_apply]
    exact ⟨_,_,g.symm.injective.ne hij,rfl⟩
  have hct:c t=swap45:=swap_in_core (isSwap_map t ht) (hec ▸ mem_map_of_mem c htC)
  have hnc:¬Commute swap45 (c s) := by
    intro hc
    apply hn
    apply (MulAut.conj g⁻¹).injective
    change c (t*s)=c (s*t)
    simpa only [map_mul,hct] using hc.eq
  apply (map_injective (f:=c) (MulAut.conj g⁻¹).injective)
  rw [Subgroup.map_sup,hec,MonoidHom.map_zpowers,map_top_of_surjective _ (MulAut.conj g⁻¹).surjective]
  exact canonical_crossing_generate _ (isSwap_map s hs) hnc

end Theory.SpecificGroups.SymmetricSix.BinaryFlags.PointCoreGeneration
