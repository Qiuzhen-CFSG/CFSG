module
public import Theory.SpecificGroups.SymmetricSix.BinaryFlags.LargeMovementFixer
import all Theory.SpecificGroups.SymmetricSix.BinaryFlags.RestrictedMovement

/-!
# Movement controlled by two transpositions

For an elementary subgroup of S₆ containing two distinct transpositions,
the entire movement of either marked six-letter cover is generated by the
first transposition's displacement and the actor's displacement on its full
fixed hyperplane. The augmentation cover and its central line are retained.

Inside a Sylow subgroup, the two transpositions are disjoint. Correcting a
vector by a word supported on their two pairs puts it in the first fixed
hyperplane. The correction's movement is the sum of the two transposition
lines; the second line is already moved from the first fixed hyperplane.
A small checked coordinate identity proves this on the augmentation core.
Conjugation, the natural quotient, and the original cover marking transport it.

The natural replacement's Terminal/FullCoverMovement uses the theorem when
the edge moves a small critical line, supplying the second transposition
from the same normal midpoint-core actor.
Source: MS93 (3.3)(ii) and (5.12)(1), printed pp.867 and 924–925.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender BinaryPermutation
open Theory.SpecificGroups.SymmetricSix Theory.SpecificGroups.SymmetricSix.BinaryFlags
open BinaryPermutation.SixCover
open scoped IsMulCommutative
namespace Theory.SpecificGroups.SymmetricSix.BinaryFlags.PairedTranspositionMovement
local notation "ρ" => coreRepresentation (Fin 6)
local notation "σ" => naturalRepresentation (Fin 6)
local notation "w" => BorelKernel.words
private def transposition (i : Fin 3) : S := ![swap01,swap23,swap45] i
private def left (i : Fin 3) : Fin 6 := ⟨2*i.val,by omega⟩
private def right (i : Fin 3) : Fin 6 := ⟨2*i.val+1,by omega⟩
private def cross (i j : Fin 3) : Full (Fin 6) :=
  fun k => if k=left i ∨ k=left j then 1 else 0
private def third (i j : Fin 3) : Fin 3 := ⟨(3-i.val-j.val)%3,Nat.mod_lt _ (by decide)⟩

private theorem swap_complete : ∀ i : Fin 16, (w i).cycleType={2} →
    ∃ j : Fin 3, w i=transposition j := by decide +kernel

private theorem certificate : ∀ i j : Fin 3, i≠j → ∀ k : Fin 16,
    w k * transposition i = transposition i * w k →
    w k * transposition j = transposition j * w k →
    ∀ v : Full (Fin 6), (∑ k,v k)=0 →
    let c := v (left i)+v (right i)
    let x := v+c • cross i j
    let u := (c * (representation (Fin 6) (w k) (cross i j)-cross i j) (left i)) • cross i j
    let y := (c * (representation (Fin 6) (w k) (cross i j)-cross i j) (left j)) • cross j (third i j)
    (∑ k,x k)=0 ∧ (∑ k,u k)=0 ∧ (∑ k,y k)=0 ∧
    representation (Fin 6) (transposition i) x=x ∧
    representation (Fin 6) (transposition i) y=y ∧
    representation (Fin 6) (w k) v-v = (representation (Fin 6) (w k) x-x) +
      (representation (Fin 6) (transposition i) u-u) +
      (representation (Fin 6) (transposition j) y-y) := by
  decide +kernel

private theorem core_borel_decompose (P : Subgroup S) [IsElementaryAbelian 2 P]
    (hP : P ≤ borel) (t t' g : S) (ht : t∈P) (ht' : t'∈P) (hg : g∈P)
    (hs : t.IsSwap) (hs' : t'.IsSwap) (hne : t≠t') (v : core (Fin 6)) :
    ∃ x u y : core (Fin 6), ρ t x=x ∧ ρ t y=y ∧
      ρ g v-v = (ρ g x-x)+(ρ t u-u)+(ρ t' y-y) := by
  obtain ⟨a,rfl⟩ := BorelKernel.words_complete t (hP ht)
  obtain ⟨i,hi⟩ := swap_complete a (Equiv.Perm.isSwap_iff_cycleType.mp hs)
  obtain ⟨b,rfl⟩ := BorelKernel.words_complete t' (hP ht')
  obtain ⟨j,hj⟩ := swap_complete b (Equiv.Perm.isSwap_iff_cycleType.mp hs')
  obtain ⟨k,rfl⟩ := BorelKernel.words_complete g (hP hg)
  have hij : i≠j := fun he => hne (hi.trans (he ▸ hj.symm))
  have hgi : w k * transposition i = transposition i * w k :=
    hi ▸ setLike_mul_comm hg ht
  have hgj : w k * transposition j = transposition j * w k :=
    hj ▸ setLike_mul_comm hg ht'
  obtain ⟨hx,hu,hy,hxt,hyt,he⟩ := certificate i j hij k hgi hgj v.val v.property
  refine ⟨⟨_,hx⟩,⟨_,hu⟩,⟨_,hy⟩,?_,?_,?_⟩
  · rw [hi]; exact Subtype.ext hxt
  · rw [hi]; exact Subtype.ext hyt
  · rw [hi,hj]; exact Subtype.ext he

private theorem core_decompose (P : Subgroup S) [IsElementaryAbelian 2 P]
    (t t' g : S) (ht : t∈P) (ht' : t'∈P) (hg : g∈P)
    (hs : t.IsSwap) (hs' : t'.IsSwap) (hne : t≠t') (v : core (Fin 6)) :
    ∃ x u y : core (Fin 6), ρ t x=x ∧ ρ t y=y ∧
      ρ g v-v = (ρ g x-x)+(ρ t u-u)+(ρ t' y-y) := by
  have hp : IsPGroup 2 P := IsElementaryAbelian.isPGroup 2 P
  obtain ⟨P₀,hPP₀⟩ := hp.exists_le_sylow
  obtain ⟨a,ha⟩ := MulAction.exists_smul_eq S borelSylow P₀
  have hPa : (P₀ : Subgroup S) = borel.map (MulAut.conj a).toMonoidHom :=
    (congrArg (fun P : Sylow 2 S => (P : Subgroup S)) ha).symm
  let f := (MulAut.conj a⁻¹).toMonoidHom
  let P' := P.map f
  let : IsElementaryAbelian 2 P' := IsElementaryAbelian.map f
  have hP' : P' ≤ borel := by
    have hh := map_mono (f := f) (hPP₀.trans_eq hPa)
    exact hh.trans_eq (conjBy_inv borel a)
  have hswap (k : S) (hk : k.IsSwap) : (f k).IsSwap := by
    apply Equiv.Perm.isSwap_iff_cycleType.mpr
    change (a⁻¹*k*(a⁻¹)⁻¹).cycleType={2}
    rw [Equiv.Perm.cycleType_conj]
    exact Equiv.Perm.isSwap_iff_cycleType.mp hk
  have he (k : S) (z : core (Fin 6)) : ρ a (ρ (f k) z)=ρ k (ρ a z) := by
    change ρ a (ρ (a⁻¹*k*a) z)=_
    simp only [map_mul,Module.End.mul_apply,(coreRepresentation (Fin 6)).self_inv_apply]
  obtain ⟨x,u,y,hx,hy,hd⟩ := core_borel_decompose P' hP' (f t) (f t') (f g)
    (mem_map_of_mem f ht) (mem_map_of_mem f ht') (mem_map_of_mem f hg)
    (hswap t hs) (hswap t' hs') ((MulAut.conj a⁻¹).injective.ne hne) (ρ a⁻¹ v)
  refine ⟨ρ a x,ρ a u,ρ a y,?_,?_,?_⟩
  · exact (he t x).symm.trans (congrArg (ρ a) hx)
  · exact (he t y).symm.trans (congrArg (ρ a) hy)
  · have hh := congrArg (ρ a) hd
    simpa only [map_add,map_sub,he,(coreRepresentation (Fin 6)).self_inv_apply] using hh

/-- Two distinct transpositions in one elementary actor decompose its full
movement using the first transposition and its full fixed hyperplane. -/
theorem cover_decompose {Y : Type*} [AddCommGroup Y] [Module (ZMod 2) Y]
    (τ : Representation (ZMod 2) S Y) (hm : IsNaturalOrCore τ (MonoidHom.id S))
    (P : Subgroup S) [IsElementaryAbelian 2 P]
    (t t' g : S) (ht : t∈P) (ht' : t'∈P) (hg : g∈P)
    (hs : t.IsSwap) (hs' : t'.IsSwap) (hne : t≠t') (v : Y) :
    ∃ x u y : Y, τ t x=x ∧ τ t y=y ∧
      τ g v-v = (τ g x-x)+(τ t u-u)+(τ t' y-y) := by
  have hn (v : natural (Fin 6)) : ∃ x u y : natural (Fin 6), σ t x=x ∧ σ t y=y ∧
      σ g v-v = (σ g x-x)+(σ t u-u)+(σ t' y-y) := by
    obtain ⟨v,rfl⟩ := coreToNatural_surjective v
    obtain ⟨x,u,y,hx,hy,he⟩ := core_decompose P t t' g ht ht' hg hs hs' hne v
    refine ⟨coreToNatural (Fin 6) x,coreToNatural (Fin 6) u,coreToNatural (Fin 6) y,?_,?_,?_⟩
    · simpa only [coreToNatural_equivariant] using congrArg (coreToNatural (Fin 6)) hx
    · simpa only [coreToNatural_equivariant] using congrArg (coreToNatural (Fin 6)) hy
    · simpa only [map_add,map_sub,coreToNatural_equivariant] using congrArg (coreToNatural (Fin 6)) he
  rcases hm with ⟨E,hE⟩ | ⟨E,hE⟩
  · obtain ⟨x,u,y,hx,hy,he⟩ := hn (E v)
    refine ⟨E.symm x,E.symm u,E.symm y,?_,?_,?_⟩
    · apply E.injective
      simpa only [hE,MonoidHom.id_apply,LinearEquiv.apply_symm_apply] using hx
    · apply E.injective
      simpa only [hE,MonoidHom.id_apply,LinearEquiv.apply_symm_apply] using hy
    · apply E.injective
      simpa only [hE,MonoidHom.id_apply,map_add,map_sub,LinearEquiv.apply_symm_apply] using he
  · obtain ⟨x,u,y,hx,hy,he⟩ := core_decompose P t t' g ht ht' hg hs hs' hne (E v)
    refine ⟨E.symm x,E.symm u,E.symm y,?_,?_,?_⟩
    · apply E.injective
      simpa only [hE,MonoidHom.id_apply,LinearEquiv.apply_symm_apply] using hx
    · apply E.injective
      simpa only [hE,MonoidHom.id_apply,LinearEquiv.apply_symm_apply] using hy
    · apply E.injective
      simpa only [hE,MonoidHom.id_apply,map_add,map_sub,LinearEquiv.apply_symm_apply] using he

theorem cover_movement_le {Y : Type*} [AddCommGroup Y] [Module (ZMod 2) Y]
    (τ : Representation (ZMod 2) S Y) (hm : IsNaturalOrCore τ (MonoidHom.id S))
    (P : Subgroup S) [IsElementaryAbelian 2 P]
    (t t' : S) (ht : t∈P) (ht' : t'∈P)
    (hs : t.IsSwap) (hs' : t'.IsSwap) (hne : t≠t') :
    subspaceCommutator τ ⊤ P ≤ subspaceCommutator τ ⊤ (zpowers t) ⊔
      subspaceCommutator τ (fixedSpace τ (zpowers t)) P := by
  apply Submodule.span_le.mpr
  rintro _ ⟨g,hg,v,_,rfl⟩
  obtain ⟨x,u,y,hx,hy,he⟩ := cover_decompose τ hm P t t' g ht ht' hg hs hs' hne v
  rw [he]
  apply Submodule.add_mem
  · apply Submodule.add_mem
    · exact Submodule.mem_sup_right (Submodule.subset_span
        ⟨g,hg,x,(mem_fixedSpace_zpowers_iff _ _ _).mpr hx,rfl⟩)
    · exact Submodule.mem_sup_left (Submodule.subset_span
        ⟨t,mem_zpowers t,u,Submodule.mem_top,rfl⟩)
  · exact Submodule.mem_sup_right (Submodule.subset_span
      ⟨t',ht',y,(mem_fixedSpace_zpowers_iff _ _ _).mpr hy,rfl⟩)

end Theory.SpecificGroups.SymmetricSix.BinaryFlags.PairedTranspositionMovement
