module
public import Theory.SpecificGroups.SymmetricSix.BinaryFlags.CoreGeometry
public import Theory.SpecificGroups.SymmetricSix.BinaryFlags.NaturalGeometry
public import Theory.Representation.BinaryOffender.CommutatorRank
public import Theory.Representation.CyclicFixedRank

/-!
# The fixed hyperplane of the point-core transposition

In the natural four-dimensional binary S₆-module, the elementary point core
moves the fixed hyperplane of its unique transposition into that
transposition's moved line. Its pointwise fixer on that hyperplane is exactly
the cyclic group generated by the transposition. The moved line has two
elements and the fixed hyperplane has dimension three.

The canonical calculation uses the eight explicit point-core permutations
and the fifteen duad vectors. Small kernel-checked certificates compare
binary representatives modulo the constant vector; no enumeration of
subgroups or quotient vector spaces is needed. The actual natural action
transports both calculations to every conjugate point core.

Source application: Meierfrankenfeld--Stellmacher, *Pushing up weak BN-pairs
of rank two* (1993), (5.7), printed p.919. The source consumer applies these
facts to Z_e intersect Q_alpha. They do not assert the corresponding
quadratic-only statement for an extended deleted module or the full X_e.
-/

public section
open Subgroup BinaryPermutation Representation.BinaryOffender
namespace Theory.SpecificGroups.SymmetricSix.BinaryFlags.PointCoreTranspositionFixed
open NaturalGeometry

private abbrev a : S := swap01 * swap23
private abbrev b : S := Equiv.swap 0 2 * Equiv.swap 1 3
private def eight : List S := [1,a,b,a*b,swap45,swap45*a,swap45*b,swap45*(a*b)]
private theorem eight_closed : ∀ x ∈ eight, ∀ y ∈ eight, x*y ∈ eight := by
  have h : eight.all (fun x => eight.all (fun y => decide (x*y ∈ eight))) = true := by
    decide +kernel
  simpa only [List.all_eq_true, decide_eq_true_eq] using h
private theorem eight_inverses : ∀ x ∈ eight, x⁻¹ ∈ eight := by
  have h : eight.all (fun x => decide (x⁻¹ ∈ eight)) = true := by decide +kernel
  simpa only [List.all_eq_true, decide_eq_true_eq] using h
private def certificate : Subgroup S where
  carrier := {x | x ∈ eight}
  one_mem' := by decide +kernel
  mul_mem' := fun hx hy => eight_closed _ hx _ hy
  inv_mem' := eight_inverses _
private theorem core_in_certificate : pointCore ≤ certificate := by
  rw [pointCore_eq_closure, closure_le]
  intro x hx
  rcases hx with rfl | rfl | rfl <;> change _ ∈ eight <;> decide +kernel

private def rawPair (i j : Ω) : Ω → ZMod 2 := Pi.single i 1 + Pi.single j 1

private theorem pair_sub_line {g : S} {i j : Ω}
    (hc : ∃ c d : ZMod 2, rawPair (g i) (g j) - rawPair i j =
      c • rawPair 4 5 + d • allOne Ω) :
    pairVector (g i) (g j) - pairVector i j ∈ canonicalLine := by
  obtain ⟨c,d,hc⟩ := hc
  apply Submodule.mem_span_singleton.mpr
  refine ⟨c, ?_⟩
  apply Subtype.ext
  change c • (constants Ω).mkQ (rawPair 4 5) =
    (constants Ω).mkQ (rawPair (g i) (g j)) - (constants Ω).mkQ (rawPair i j)
  rw [←map_sub,hc,map_add,map_smul,map_smul]
  have hz : (constants Ω).mkQ (allOne Ω) = 0 :=
    (Submodule.Quotient.mk_eq_zero _).mpr (Submodule.subset_span (by simp))
  rw [hz,smul_zero,add_zero]

private theorem fixed_displacement_certificate (g : S) (hg : g ∈ pointCore)
    (i j : Ω) (hfix : pair (swap45 i) (swap45 j) = pair i j) :
    ∃ c d : ZMod 2, rawPair (g i) (g j) - rawPair i j =
      c • rawPair 4 5 + d • allOne Ω := by
  have hc : eight.all (fun g => decide (∀ i j : Ω,
      pair (swap45 i) (swap45 j) = pair i j →
      ∃ c d : ZMod 2, rawPair (g i) (g j) - rawPair i j =
        c • rawPair 4 5 + d • allOne Ω)) = true := by decide +kernel
  have hh : ∀g∈eight, ∀i j:Ω, pair (swap45 i) (swap45 j) = pair i j →
      ∃ c d : ZMod 2, rawPair (g i) (g j) - rawPair i j =
        c • rawPair 4 5 + d • allOne Ω := by
    simpa only [List.all_eq_true,decide_eq_true_eq] using hc
  exact hh g (core_in_certificate hg) i j hfix

private theorem canonical_fixed_displacement (g : S) (hg : g ∈ pointCore)
    (v : V) (hv : naturalRepresentation Ω swap45 v = v) :
    naturalRepresentation Ω g v - v ∈ canonicalLine := by
  rcases vector_cases v with rfl | ⟨d,rfl⟩
  · simp
  · change naturalRepresentation Ω swap45 (pairVector d.val.1 d.val.2) = pairVector d.val.1 d.val.2 at hv
    change naturalRepresentation Ω g (pairVector d.val.1 d.val.2) - pairVector d.val.1 d.val.2 ∈ canonicalLine
    rw [pairVector_map] at hv ⊢
    have hp := (pairVector_eq_iff (swap45.injective.ne (ne_of_lt d.property))
      (ne_of_lt d.property)).mp hv
    exact pair_sub_line (fixed_displacement_certificate g hg _ _ hp)

private theorem canonical_displacement (v : V) :
    naturalRepresentation Ω swap45 v - v ∈ canonicalLine := by
  rcases vector_cases v with rfl | ⟨d,rfl⟩
  · simp
  · change naturalRepresentation Ω swap45 (pairVector d.val.1 d.val.2) - pairVector d.val.1 d.val.2 ∈ canonicalLine
    rw [pairVector_map]
    apply pair_sub_line
    have hc : ∀i j:Ω, ∃c d:ZMod 2,
      rawPair (swap45 i) (swap45 j) - rawPair i j =
        c • rawPair 4 5 + d • allOne Ω := by decide +kernel
    exact hc _ _

private theorem canonical_displacement_generator :
    naturalRepresentation Ω swap45 (pairVector 0 4) - pairVector 0 4 = pairVector 4 5 := by
  rw [pairVector_map]
  apply Subtype.ext
  change (constants Ω).mkQ (rawPair 0 5) - (constants Ω).mkQ (rawPair 0 4) =
    (constants Ω).mkQ (rawPair 4 5)
  rw [←map_sub]
  congr 1
  ext i
  fin_cases i <;> decide

private theorem canonical_moved :
    subspaceCommutator (naturalRepresentation Ω) ⊤ (zpowers swap45) = canonicalLine := by
  rw [Representation.CyclicFixedRank.commutator_eq_range]
  apply le_antisymm
  · rintro _ ⟨v,rfl⟩
    exact canonical_displacement v
  · apply Submodule.span_le.mpr
    rintro _ rfl
    exact ⟨pairVector 0 4, canonical_displacement_generator⟩

private theorem canonical_fixer (g : S) (hg : g ∈ pointCore)
    (hfix : ∀v:V, naturalRepresentation Ω swap45 v = v → naturalRepresentation Ω g v = v) :
    g = 1 ∨ g = swap45 := by
  have hv (i j : Ω) (hi : swap45 i=i) (hj : swap45 j=j) (hne : i≠j) :
      pair (g i) (g j) = pair i j := by
    have he := hfix (pairVector i j) (by rw [pairVector_map,hi,hj])
    rw [pairVector_map] at he
    exact (pairVector_eq_iff (g.injective.ne hne) hne).mp he
  have hc : eight.all (fun g => decide (pair (g 0) (g 1) = pair 0 1 →
      pair (g 0) (g 2) = pair 0 2 → pair (g 0) (g 3) = pair 0 3 →
      g=1 ∨ g=swap45)) = true := by decide +kernel
  have hh : ∀g∈eight, pair (g 0) (g 1) = pair 0 1 →
      pair (g 0) (g 2) = pair 0 2 → pair (g 0) (g 3) = pair 0 3 →
      g=1 ∨ g=swap45 := by
    simpa only [List.all_eq_true,decide_eq_true_eq] using hc
  exact hh g (core_in_certificate hg) (hv 0 1 rfl rfl (by decide))
    (hv 0 2 rfl rfl (by decide)) (hv 0 3 rfl rfl (by decide))

/-- The canonical point core has a unique transposition. -/
theorem swap_eq (t:S) (ht:t∈pointCore) (hs:t.IsSwap) : t=swap45 := by
  have hc : eight.all (fun t => decide (∀i j:Ω, i≠j → t=Equiv.swap i j → t=swap45)) = true := by decide +kernel
  have hh : ∀t∈eight, ∀i j:Ω, i≠j → t=Equiv.swap i j → t=swap45 := by
    simpa only [List.all_eq_true,decide_eq_true_eq] using hc
  obtain ⟨i,j,hij,he⟩ := hs
  exact hh t (core_in_certificate ht) i j hij he

private theorem isSwap_conjugate (u t:S) (ht:t.IsSwap) : (u*t*u⁻¹).IsSwap := by
  obtain ⟨i,j,hij,rfl⟩ := ht
  rw [←Equiv.swap_apply_apply]
  exact ⟨_,_,u.injective.ne hij,rfl⟩

/-- The same unique transposition in the supplied conjugate marking. -/
theorem swap_eq_conjugate (u t:S)
    (ht:t∈pointCore.map (MulAut.conj u).toMonoidHom) (hs:t.IsSwap) :
    t=u*swap45*u⁻¹ := by
  obtain ⟨k,hk,he⟩ := ht
  change u*k*u⁻¹=t at he
  have hs' := isSwap_conjugate u⁻¹ t hs
  have he' : u⁻¹*t*(u⁻¹)⁻¹=k := by rw [←he]; group
  rw [he'] at hs'
  exact he.symm.trans (congrArg (fun k:S => u*k*u⁻¹) (swap_eq k hk hs'))

private theorem moved_conjugate_le (K:Subgroup S) (u:S) :
    (subspaceCommutator (naturalRepresentation Ω) ⊤ K).map (naturalRepresentation Ω u) ≤
    subspaceCommutator (naturalRepresentation Ω) ⊤ (K.map (MulAut.conj u).toMonoidHom) := by
  rw [subspaceCommutator,Submodule.map_span]
  apply Submodule.span_le.mpr
  rintro _ ⟨_,⟨k,hk,v,_,rfl⟩,rfl⟩
  have he : naturalRepresentation Ω u (naturalRepresentation Ω k v-v) =
      naturalRepresentation Ω (u*k*u⁻¹) (naturalRepresentation Ω u v)-
        naturalRepresentation Ω u v := by
    simp only [map_sub,map_mul,Module.End.mul_apply,
      (naturalRepresentation Ω).inv_self_apply]
  rw [he]
  exact Submodule.subset_span ⟨u*k*u⁻¹, mem_map_of_mem _ hk,
    naturalRepresentation Ω u v, Submodule.mem_top, rfl⟩

/-- Every point-core actor moves a transposition-fixed vector into its
literal moved line. -/
theorem displacement_mem (u t g:S)
    (ht:t∈pointCore.map (MulAut.conj u).toMonoidHom) (hs:t.IsSwap)
    (hg:g∈pointCore.map (MulAut.conj u).toMonoidHom)
    (v:V) (hv:v∈fixedSpace (naturalRepresentation Ω) (zpowers t)) :
    naturalRepresentation Ω g v-v ∈
      subspaceCommutator (naturalRepresentation Ω) ⊤ (zpowers t) := by
  have ht' := swap_eq_conjugate u t ht hs
  rw [ht'] at hv ⊢
  obtain ⟨k,hk,he⟩ := hg
  change u*k*u⁻¹=g at he
  rw [←he]
  let w := naturalRepresentation Ω u⁻¹ v
  have hw : naturalRepresentation Ω swap45 w=w := by
    have hh := (mem_fixedSpace_zpowers_iff _ _ _).mp hv
    have hh' := congrArg (naturalRepresentation Ω u⁻¹) hh
    simpa only [map_mul,Module.End.mul_apply,
      (naturalRepresentation Ω).inv_self_apply] using hh'
  have hm : naturalRepresentation Ω k w-w ∈
      subspaceCommutator (naturalRepresentation Ω) ⊤ (zpowers swap45) :=
    canonical_moved.symm ▸ canonical_fixed_displacement k hk w hw
  have hmap := moved_conjugate_le (zpowers swap45) u
    (Submodule.mem_map_of_mem hm)
  rw [MonoidHom.map_zpowers] at hmap
  change naturalRepresentation Ω u (naturalRepresentation Ω k w-w) ∈
    subspaceCommutator (naturalRepresentation Ω) ⊤ (zpowers (u*swap45*u⁻¹)) at hmap
  have heval : naturalRepresentation Ω u (naturalRepresentation Ω k w-w) =
      naturalRepresentation Ω (u*k*u⁻¹) v-v := by
    dsimp only [w]
    simp only [map_sub,map_mul,Module.End.mul_apply,
      (naturalRepresentation Ω).self_inv_apply]
  rwa [heval] at hmap

/-- The whole point core moves the fixed hyperplane into the same line. -/
theorem fixed_displacement_le (u t:S)
    (ht:t∈pointCore.map (MulAut.conj u).toMonoidHom) (hs:t.IsSwap) :
    subspaceCommutator (naturalRepresentation Ω)
      (fixedSpace (naturalRepresentation Ω) (zpowers t))
      (pointCore.map (MulAut.conj u).toMonoidHom) ≤
        subspaceCommutator (naturalRepresentation Ω) ⊤ (zpowers t) := by
  apply Submodule.span_le.mpr
  rintro _ ⟨g,hg,v,hv,rfl⟩
  exact displacement_mem u t g ht hs hg v hv

/-- Inside the supplied point core, the pointwise hyperplane fixer is
exactly the cyclic subgroup of the supplied transposition. -/
theorem fixes_fixedSpace_iff (u t g:S)
    (ht:t∈pointCore.map (MulAut.conj u).toMonoidHom) (hs:t.IsSwap)
    (hg:g∈pointCore.map (MulAut.conj u).toMonoidHom) :
    (∀v∈fixedSpace (naturalRepresentation Ω) (zpowers t),
      naturalRepresentation Ω g v=v) ↔ g∈zpowers t := by
  constructor
  · intro hfix
    have ht' := swap_eq_conjugate u t ht hs
    obtain ⟨k,hk,he⟩ := hg
    change u*k*u⁻¹=g at he
    have hfix' : ∀v:V, naturalRepresentation Ω swap45 v=v → naturalRepresentation Ω k v=v := by
      intro v hv
      have hmem : naturalRepresentation Ω u v ∈ fixedSpace (naturalRepresentation Ω) (zpowers t) := by
        rw [ht',mem_fixedSpace_zpowers_iff]
        simp only [map_mul,Module.End.mul_apply,(naturalRepresentation Ω).inv_self_apply,hv]
      have hh := hfix _ hmem
      rw [←he] at hh
      simp only [map_mul,Module.End.mul_apply,(naturalRepresentation Ω).inv_self_apply] at hh
      exact (naturalRepresentation Ω).apply_bijective u |>.injective hh
    rcases canonical_fixer k hk hfix' with hk1 | hks
    · have hg1 : g=1 := by rw [←he,hk1]; group
      rw [hg1]
      exact one_mem _
    · have hgt : g=t := by rw [←he,hks,ht']
      rw [hgt]
      exact mem_zpowers t
  · intro hg v hv
    exact hv ⟨g,hg⟩

/-- The transposition has a one-dimensional moved space. -/
theorem moved_finrank (u t:S)
    (ht:t∈pointCore.map (MulAut.conj u).toMonoidHom) (hs:t.IsSwap) :
    Module.finrank (ZMod 2)
      (subspaceCommutator (naturalRepresentation Ω) ⊤ (zpowers t)) = 1 := by
  have hc : fixedCodim (naturalRepresentation Ω) (zpowers t) =
      fixedCodim (naturalRepresentation Ω) (zpowers swap45) := by
    have hh := fixedCodim_map_conj (naturalRepresentation Ω) (zpowers swap45) u
    rw [MonoidHom.map_zpowers] at hh
    rw [swap_eq_conjugate u t ht hs]
    exact hh
  rw [Representation.CyclicFixedRank.commutator_eq_range,
    ←fixedCodim_zpowers_eq_displacement_rank,hc,
    fixedCodim_zpowers_eq_displacement_rank,
    ←Representation.CyclicFixedRank.commutator_eq_range,canonical_moved,canonicalLine_finrank]

/-- Its literal moved space has two elements. -/
theorem moved_card (u t:S)
    (ht:t∈pointCore.map (MulAut.conj u).toMonoidHom) (hs:t.IsSwap) :
    Nat.card (subspaceCommutator (naturalRepresentation Ω) ⊤ (zpowers t)) = 2 := by
  rw [Module.natCard_eq_pow_finrank (K:=ZMod 2),Nat.card_zmod,moved_finrank u t ht hs,pow_one]

/-- Its fixed space is a hyperplane in the four-dimensional natural module. -/
theorem fixed_finrank (u t:S)
    (ht:t∈pointCore.map (MulAut.conj u).toMonoidHom) (hs:t.IsSwap) :
    Module.finrank (ZMod 2) (fixedSpace (naturalRepresentation Ω) (zpowers t)) = 3 := by
  have hm := moved_finrank u t ht hs
  rw [Representation.CyclicFixedRank.commutator_eq_range,
    ←fixedCodim_zpowers_eq_displacement_rank] at hm
  have hh := fixedCodim_add_finrank (naturalRepresentation Ω) (zpowers t)
  rw [hm,finrank_natural_even Ω (by decide)] at hh
  change 1 + Module.finrank (ZMod 2) (fixedSpace (naturalRepresentation Ω) (zpowers t)) = 4 at hh
  omega

end Theory.SpecificGroups.SymmetricSix.BinaryFlags.PointCoreTranspositionFixed
