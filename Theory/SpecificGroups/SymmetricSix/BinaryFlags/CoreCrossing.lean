module
public import Theory.SpecificGroups.SymmetricSix.BinaryFlags.NaturalGeometry
public import Theory.Representation.BinaryPermutationAlternatingActions
public import Theory.Representation.BinaryOffender.Homogeneous.Embedding
public import Theory.Representation.CyclicFixedRank
/-!
# Crossing hyperplanes in the six-letter augmentation core

The source plane is spanned by the characteristic vectors of `{0,1,2,3}`
and `{0,1,4,5}`. Its orbit under the even stabilizer of the first word is
the hyperplane whose last two coordinates agree. Three pair vectors show
that its pointwise fixer is the cyclic group generated by `(45)`. The
second point produces the conjugate hyperplane with fixer `(23)`; these
hyperplanes span the full five-dimensional core.

Conjugation by `(02)(13)` excludes `(23)` from a normal crossing image,
leaving only `(45)`. Finally, fixing either source hyperplane modulo the
constant line already means fixing it pointwise: its pair-word generators
have distinct images in the natural quotient. These are the exact finite
module calculations used in the terminal rank-five contradiction.

Source: Aschbacher–Smith, 14.6.10(5), printed pp.1029–1030.
-/

@[expose] public section
open BinaryPermutation Subgroup Module Representation.BinaryOffender
namespace Theory.SpecificGroups.SymmetricSix.BinaryFlags.CoreCrossing
open NaturalGeometry
abbrev C := BinaryPermutation.core (Fin 6)
def pairWord (i j : Fin 6) : C := ⟨Pi.single i 1 + Pi.single j 1, by
  simp [mem_core, Finset.sum_add_distrib, CharTwo.add_self_eq_zero]⟩
def oneWord : C := ⟨allOne (Fin 6), by change augmentation (Fin 6) (allOne (Fin 6)) = 0; rw [augmentation_allOne]; decide⟩
def z : C := pairWord 0 1 + pairWord 2 3
def w : C := pairWord 0 1 + pairWord 4 5
def plane : Submodule (ZMod 2) C := Submodule.span (ZMod 2) {z,w}
def hyperplane : Submodule (ZMod 2) C :=
  (LinearMap.proj (R := ZMod 2) (φ := fun _ : Fin 6 => ZMod 2) 4 -
    LinearMap.proj (R := ZMod 2) (φ := fun _ : Fin 6 => ZMod 2) 5).comp
      (core (Fin 6)).subtype |>.ker
@[simp] theorem mem_hyperplane (v : C) : v ∈ hyperplane ↔ v.val 4 = v.val 5 := by
  change v.val 4 - v.val 5 = 0 ↔ _
  exact sub_eq_zero

theorem hyperplane_finrank : finrank (ZMod 2) hyperplane = 4 := by
  let f : C →ₗ[ZMod 2] ZMod 2 :=
    (LinearMap.proj (R := ZMod 2) (φ := fun _ : Fin 6 => ZMod 2) 4 -
      LinearMap.proj (R := ZMod 2) (φ := fun _ : Fin 6 => ZMod 2) 5).comp
        (core (Fin 6)).subtype
  have hs : Function.Surjective f := by
    intro a
    refine ⟨a • pairWord 0 4,?_⟩
    rw [map_smul]
    change a * 1 = a
    exact mul_one a
  have hd := f.finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr hs,finrank_top,finrank_self,finrank_core] at hd
  change 1 + finrank (ZMod 2) hyperplane = 6 - 1 at hd
  omega

private theorem pairWord_toNatural (i j : Fin 6) :
    coreToNatural (Fin 6) (pairWord i j) = pairVector i j := rfl
private theorem fixed_pair {g : S} {i j : Fin 6} (hij : i ≠ j)
    (h : coreRepresentation (Fin 6) g (pairWord i j) = pairWord i j) :
    ({g i,g j} : Finset (Fin 6)) = {i,j} := by
  have he := congrArg (coreToNatural (Fin 6)) h
  change naturalRepresentation (Fin 6) g (pairVector i j) = pairVector i j at he
  rw [pairVector_map] at he
  exact (pairVector_eq_iff (g.injective.ne hij) hij).mp he

/-- The pointwise fixer of the rank-four source hyperplane consists of the
identity and the swap of the complementary duad. -/
theorem hyperplane_fixer (g : S)
    (hg : ∀ v ∈ hyperplane, coreRepresentation (Fin 6) g v = v) :
    g = 1 ∨ g = swap45 := by
  have h01 := fixed_pair (by decide : (0 : Fin 6) ≠ 1) (hg (pairWord 0 1) (by rw [mem_hyperplane]; decide))
  have h02 := fixed_pair (by decide : (0 : Fin 6) ≠ 2) (hg (pairWord 0 2) (by rw [mem_hyperplane]; decide))
  have h03 := fixed_pair (by decide : (0 : Fin 6) ≠ 3) (hg (pairWord 0 3) (by rw [mem_hyperplane]; decide))
  have h0 : g 0 = 0 := by
    have h1 : g 0 = 0 ∨ g 0 = 1 := by
      have hm : g 0 ∈ ({g 0,g 1} : Finset (Fin 6)) := by simp
      rw [h01] at hm
      simpa only [Finset.mem_insert,Finset.mem_singleton] using hm
    have h2 : g 0 = 0 ∨ g 0 = 2 := by
      have hm : g 0 ∈ ({g 0,g 2} : Finset (Fin 6)) := by simp
      rw [h02] at hm
      simpa only [Finset.mem_insert,Finset.mem_singleton] using hm
    omega
  have hfix {i : Fin 6} (hi : i ≠ 0)
      (hh : ({g 0,g i} : Finset (Fin 6)) = {0,i}) : g i = i := by
    have hm : g i ∈ ({g 0,g i} : Finset (Fin 6)) := by simp
    rw [hh] at hm
    simp only [Finset.mem_insert,Finset.mem_singleton] at hm
    exact hm.resolve_left (by intro he; exact hi (g.injective (he.trans h0.symm)))
  have h1 := hfix (by decide : (1 : Fin 6) ≠ 0) h01
  have h2 := hfix (by decide : (2 : Fin 6) ≠ 0) h02
  have h3 := hfix (by decide : (3 : Fin 6) ≠ 0) h03
  have h4 : g 4 = 4 ∨ g 4 = 5 := by
    have hn0 := g.injective.ne (show (4 : Fin 6) ≠ 0 by decide)
    have hn1 := g.injective.ne (show (4 : Fin 6) ≠ 1 by decide)
    have hn2 := g.injective.ne (show (4 : Fin 6) ≠ 2 by decide)
    have hn3 := g.injective.ne (show (4 : Fin 6) ≠ 3 by decide)
    rw [h0] at hn0
    rw [h1] at hn1
    rw [h2] at hn2
    rw [h3] at hn3
    omega
  have h5 : g 5 = 4 ∨ g 5 = 5 := by
    have hn0 := g.injective.ne (show (5 : Fin 6) ≠ 0 by decide)
    have hn1 := g.injective.ne (show (5 : Fin 6) ≠ 1 by decide)
    have hn2 := g.injective.ne (show (5 : Fin 6) ≠ 2 by decide)
    have hn3 := g.injective.ne (show (5 : Fin 6) ≠ 3 by decide)
    rw [h0] at hn0
    rw [h1] at hn1
    rw [h2] at hn2
    rw [h3] at hn3
    omega
  rcases h4 with h4 | h4
  · have h5 : g 5 = 5 := h5.resolve_left (by intro h; have := g.injective (h.trans h4.symm); contradiction)
    left
    apply Equiv.ext
    intro i
    fin_cases i <;> assumption
  · have h5 : g 5 = 4 := h5.resolve_right (by intro h; have := g.injective (h.trans h4.symm); contradiction)
    right
    apply Equiv.ext
    intro i
    fin_cases i <;> assumption


private theorem hyperplane_decomposition (v : C) (hv : v ∈ hyperplane) :
    v = v.val 1 • pairWord 0 1 + v.val 2 • pairWord 0 2 +
      v.val 3 • pairWord 0 3 + v.val 4 • pairWord 4 5 := by
  have hc := v.property
  change ∑ i : Fin 6, v.val i = 0 at hc
  simp only [Fin.sum_univ_succ,Fin.sum_univ_zero,add_zero] at hc
  have h45 := mem_hyperplane v |>.mp hv
  apply Subtype.ext
  funext i
  fin_cases i <;> simp [pairWord]
  · change v.val 0 = v.val 1 + v.val 2 + v.val 3
    change v.val 0 + (v.val 1 + (v.val 2 + (v.val 3 + (v.val 4 + v.val 5)))) = 0 at hc
    rw [← h45] at hc
    simpa [CharTwo.add_self_eq_zero,add_assoc,add_comm,add_left_comm] using (eq_neg_of_add_eq_zero_left hc)
  · exact h45.symm

/-- The source hyperplane is generated by three edges of the complementary
four-set and the complementary duad itself. -/
theorem hyperplane_eq_span : hyperplane = Submodule.span (ZMod 2)
    {pairWord 0 1,pairWord 0 2,pairWord 0 3,pairWord 4 5} := by
  apply le_antisymm
  · intro v hv
    rw [hyperplane_decomposition v hv]
    apply Submodule.add_mem
    · apply Submodule.add_mem
      · apply Submodule.add_mem
        · exact Submodule.smul_mem _ _ (Submodule.subset_span (by simp))
        · exact Submodule.smul_mem _ _ (Submodule.subset_span (by simp))
      · exact Submodule.smul_mem _ _ (Submodule.subset_span (by simp))
    · exact Submodule.smul_mem _ _ (Submodule.subset_span (by simp))
  · rw [Submodule.span_le]
    intro v hv
    rcases hv with rfl | rfl | rfl | rfl <;> apply (mem_hyperplane _).mpr <;> decide

private theorem plane_le_hyperplane : plane ≤ hyperplane := by
  rw [plane,Submodule.span_le]
  intro v hv
  rcases hv with rfl | rfl <;> apply (mem_hyperplane _).mpr <;> decide

private theorem hyperplane_invariant :
    L1 ≤ subspaceStabilizer (coreRepresentation (Fin 6)) hyperplane := by
  apply le_subspaceStabilizer
  intro g hg v hv
  have hgi : g⁻¹ ∈ H1 := H1.inv_mem hg.1
  have hh := mem_hyperplane v |>.mp hv
  rw [mem_hyperplane]
  rcases mem_H1_cases hgi with h | h
  · change v.val (g⁻¹ 4) = v.val (g⁻¹ 5)
    rw [h.1,h.2]
    exact hh
  · change v.val (g⁻¹ 4) = v.val (g⁻¹ 5)
    rw [h.1,h.2]
    exact hh.symm

/-- The orbit span of the original plane under the even point centralizer is
exactly the indicated hyperplane of the five-dimensional augmentation core. -/
theorem orbitSpan_eq_hyperplane :
    Homogeneous.orbitSpan (coreRepresentation (Fin 6)) L1 plane = hyperplane := by
  let U := Homogeneous.orbitSpan (coreRepresentation (Fin 6)) L1 plane
  have hz : z ∈ U := Homogeneous.le_orbitSpan _ _ _ (Submodule.subset_span (by simp))
  have hw : w ∈ U := Homogeneous.le_orbitSpan _ _ _ (Submodule.subset_span (by simp))
  have himg (g : S) (hg : g ∈ L1) : coreRepresentation (Fin 6) g w ∈ U :=
    (le_iSup (fun t : L1 => plane.map (coreRepresentation (Fin 6) t)) ⟨g,hg⟩) ⟨w,
      Submodule.subset_span (by simp),rfl⟩
  have h02 : pairWord 0 2 ∈ U := by
    have he : w + coreRepresentation (Fin 6) cycle012 w = pairWord 0 2 := by decide
    exact he ▸ U.add_mem hw (himg cycle012 (K_le_L1 (by decide)))
  have h03 : pairWord 0 3 ∈ U := by
    have he : w + coreRepresentation (Fin 6) cycle013 w = pairWord 0 3 := by decide
    exact he ▸ U.add_mem hw (himg cycle013 (K_le_L1 (by decide)))
  have h01 : pairWord 0 1 ∈ U := by
    have he : z + pairWord 0 2 + pairWord 0 3 = pairWord 0 1 := by decide
    exact he ▸ U.add_mem (U.add_mem hz h02) h03
  have h45 : pairWord 4 5 ∈ U := by
    have he : w + pairWord 0 1 = pairWord 4 5 := by decide
    exact he ▸ U.add_mem hw h01
  apply le_antisymm (Homogeneous.orbitSpan_le _ plane_le_hyperplane hyperplane_invariant)
  rw [hyperplane_eq_span,Submodule.span_le]
  intro v hv
  rcases hv with rfl | rfl | rfl | rfl <;> assumption


/-- The complementary transposition fixes the hyperplane pointwise. -/
theorem swap45_fixes_hyperplane (v : C) (hv : v ∈ hyperplane) :
    coreRepresentation (Fin 6) swap45 v = v := by
  have hh := (mem_hyperplane v).mp hv
  apply Subtype.ext
  funext i
  fin_cases i <;> first | rfl | exact hh | exact hh.symm

/-- The pointwise fixer of the actual orbit span is precisely the cyclic
transposition subgroup. -/
theorem fixes_orbitSpan_iff (g : S) :
    (∀ v ∈ Homogeneous.orbitSpan (coreRepresentation (Fin 6)) L1 plane,
      coreRepresentation (Fin 6) g v = v) ↔ g ∈ zpowers swap45 := by
  rw [orbitSpan_eq_hyperplane]
  constructor
  · intro hg
    rcases hyperplane_fixer g hg with rfl | rfl
    · exact one_mem _
    · exact mem_zpowers _
  · intro hg v hv
    rw [mem_zpowers_iff_mem_range_orderOf,
      show orderOf swap45 = 2 from (show swap45.IsSwap from ⟨4,5,by decide,rfl⟩).orderOf] at hg
    obtain ⟨n,hn,he⟩ := Finset.mem_image.mp hg
    have hnlt := Finset.mem_range.mp hn
    interval_cases n
    · rw [← he,pow_zero,map_one,Module.End.one_apply]
    · rw [← he,pow_one]
      exact swap45_fixes_hyperplane v hv

/-- The transposition moves the full core onto the complementary pair line. -/
theorem swap45_displacement (v : C) :
    coreRepresentation (Fin 6) swap45 v - v =
      (v.val 4 + v.val 5) • pairWord 4 5 := by
  apply Subtype.ext
  funext i
  fin_cases i
  · change v.val 0 - v.val 0 = (v.val 4 + v.val 5) * 0
    simp
  · change v.val 1 - v.val 1 = (v.val 4 + v.val 5) * 0
    simp
  · change v.val 2 - v.val 2 = (v.val 4 + v.val 5) * 0
    simp
  · change v.val 3 - v.val 3 = (v.val 4 + v.val 5) * 0
    simp
  · change v.val 5 - v.val 4 = (v.val 4 + v.val 5) * 1
    simp [CharTwo.sub_eq_add,add_comm]
  · change v.val 4 - v.val 5 = (v.val 4 + v.val 5) * 1
    simp [CharTwo.sub_eq_add]

/-- The core displacement line is nonconstant and is generated by the duad. -/
theorem swap45_moved : subspaceCommutator (coreRepresentation (Fin 6)) ⊤
    (zpowers swap45) = Submodule.span (ZMod 2) {pairWord 4 5} := by
  rw [Representation.CyclicFixedRank.commutator_eq_range]
  apply le_antisymm
  · rintro _ ⟨v,rfl⟩
    change coreRepresentation (Fin 6) swap45 v - v ∈ _
    rw [swap45_displacement]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (by simp))
  · rw [Submodule.span_le]
    rintro _ rfl
    refine ⟨pairWord 0 4,?_⟩
    change coreRepresentation (Fin 6) swap45 (pairWord 0 4) - pairWord 0 4 = pairWord 4 5
    decide

private def twoSwapWords : Set S := {1,swap23,swap45,swap23*swap45}
private instance (x : S) : Decidable (x ∈ twoSwapWords) :=
  inferInstanceAs (Decidable (x = 1 ∨ x = swap23 ∨ x = swap45 ∨ x = swap23 * swap45))
private def twoSwapGroup : Subgroup S where
  carrier := twoSwapWords
  one_mem' := by simp [twoSwapWords]
  mul_mem' := by
    intro a b ha hb
    rcases ha with rfl | rfl | rfl | rfl <;>
      rcases hb with rfl | rfl | rfl | rfl <;>
      decide
  inv_mem' := by
    intro a ha
    rcases ha with rfl | rfl | rfl | rfl <;>
      decide

private theorem twoSwap_le : zpowers swap23 ⊔ zpowers swap45 ≤ twoSwapGroup := by
  apply sup_le <;> apply zpowers_le.mpr <;> change _ ∈ twoSwapWords <;> decide

/-- A subgroup generated inside the two crossing transpositions and normalized
by the actual alternating Sylow flag group can contain only `(45)`. -/
theorem normal_crossing_le (B : Subgroup S)
    (hB : B ≤ zpowers swap23 ⊔ zpowers swap45)
    (hn : T0 ≤ normalizer (B : Set S)) : B ≤ zpowers swap45 := by
  intro b hb
  have hm := twoSwap_le (hB hb)
  have hc := twoSwap_le (hB ((le_normalizer_iff.mp hn) genC genC_mem_T0 b hb))
  change b ∈ twoSwapWords at hm
  rcases hm with rfl | rfl | rfl | rfl
  · exact one_mem _
  · exact False.elim ((by decide : genC * swap23 * genC⁻¹ ∉ twoSwapWords) hc)
  · exact mem_zpowers _
  · exact False.elim ((by decide : genC * (swap23*swap45) * genC⁻¹ ∉ twoSwapWords) hc)

/-- In particular a nontrivial crossing image has order two and is the source
complementary transposition subgroup. -/
theorem normal_crossing_eq (B : Subgroup S)
    (hB : B ≤ zpowers swap23 ⊔ zpowers swap45)
    (hn : T0 ≤ normalizer (B : Set S)) (hne : B ≠ ⊥) : B = zpowers swap45 := by
  have hle := normal_crossing_le B hB hn
  obtain ⟨b,hb,hb1⟩ := B.bot_or_exists_ne_one |>.resolve_left hne
  have hb' := hle hb
  rw [mem_zpowers_iff_mem_range_orderOf,show orderOf swap45 = 2 from (show swap45.IsSwap from ⟨4,5,by decide,rfl⟩).orderOf] at hb'
  obtain ⟨n,hn',he⟩ := Finset.mem_image.mp hb'
  have hnlt := Finset.mem_range.mp hn'
  interval_cases n
  · exact False.elim (hb1 (by simpa using he.symm))
  · have hs : swap45 ∈ B := by rw [pow_one] at he; exact he.symm ▸ hb
    exact le_antisymm hle (zpowers_le.mpr hs)


/-- Relabel the complementary duad `(45)` as `(23)`, interchanging the two
selected nonzero source-plane vectors. -/
def crossingRelabel : S := Equiv.swap 2 4 * Equiv.swap 3 5

def crossingHyperplane : Submodule (ZMod 2) C :=
  hyperplane.map (coreRepresentation (Fin 6) crossingRelabel)

/-- The exact pointwise fixer transports through any literal permutation
marking of the five-dimensional source module. -/
theorem fixes_map_hyperplane_iff (a g : S) :
    (∀ v ∈ hyperplane.map (coreRepresentation (Fin 6) a),
      coreRepresentation (Fin 6) g v = v) ↔
      g ∈ (zpowers swap45).map (MulAut.conj a).toMonoidHom := by
  constructor
  · intro hg
    have hf : ∀ v ∈ hyperplane,
        coreRepresentation (Fin 6) (a⁻¹ * g * a) v = v := by
      intro v hv
      have hh := congrArg (coreRepresentation (Fin 6) a⁻¹)
        (hg _ ⟨v,hv,rfl⟩)
      simpa only [← Module.End.mul_apply,← map_mul,mul_assoc,inv_mul_cancel,map_one,
        Module.End.one_apply] using hh
    have hz : a⁻¹ * g * a ∈ zpowers swap45 :=
      (fixes_orbitSpan_iff _).mp (orbitSpan_eq_hyperplane ▸ hf)
    exact ⟨a⁻¹ * g * a,hz,by simp [MulAut.conj_apply,mul_assoc]⟩
  · rintro ⟨h,hh,rfl⟩ v ⟨u,hu,rfl⟩
    have hf := (fixes_orbitSpan_iff h).mpr hh u (orbitSpan_eq_hyperplane.symm ▸ hu)
    have he := congrArg (coreRepresentation (Fin 6) a) hf
    change coreRepresentation (Fin 6) (a*h*a⁻¹) (coreRepresentation (Fin 6) a u) =
      coreRepresentation (Fin 6) a u
    simpa only [← Module.End.mul_apply,← map_mul,
      mul_assoc,inv_mul_cancel,mul_one] using he

/-- The second source hyperplane has the other complementary transposition
as its unique possible nonidentity fixer. -/
theorem fixes_crossingHyperplane_iff (g : S) :
    (∀ v ∈ crossingHyperplane, coreRepresentation (Fin 6) g v = v) ↔
      g ∈ zpowers swap23 := by
  rw [crossingHyperplane,fixes_map_hyperplane_iff,MonoidHom.map_zpowers]
  have he : (MulAut.conj crossingRelabel) swap45 = swap23 := by decide
  change g ∈ zpowers ((MulAut.conj crossingRelabel) swap45) ↔ _
  rw [he]

/-- The two source hyperplanes generate the full five-dimensional core. -/
theorem hyperplane_sup_crossing : hyperplane ⊔ crossingHyperplane = ⊤ := by
  apply top_unique
  intro v _
  let a : ZMod 2 := v.val 4 + v.val 5
  let y := a • pairWord 0 4
  have hy : y ∈ crossingHyperplane := by
    apply Submodule.smul_mem
    refine ⟨pairWord 0 2,(mem_hyperplane _).mpr (by decide),?_⟩
    decide
  have hx : v - y ∈ hyperplane := by
    rw [mem_hyperplane]
    change v.val 4 - a * 1 = v.val 5 - a * 0
    dsimp only [a]
    simp [CharTwo.sub_eq_add,← add_assoc,CharTwo.add_self_eq_zero]
  exact Submodule.mem_sup.mpr ⟨v-y,hx,y,hy,sub_add_cancel _ _⟩

/-- Applied crossing-image calculation from the rank-five argument. The images
of the two conjugate hyperplanes centralize their original hyperplanes; the
normality of their generated image in the actual Sylow group leaves only the
complementary transposition. -/
theorem crossing_image_eq (A B : Subgroup S)
    (hA : ∀ a ∈ A, ∀ v ∈ hyperplane, coreRepresentation (Fin 6) a v = v)
    (hB : ∀ b ∈ B, ∀ v ∈ crossingHyperplane, coreRepresentation (Fin 6) b v = v)
    (hn : T0 ≤ normalizer ((A ⊔ B : Subgroup S) : Set S))
    (hne : A ⊔ B ≠ ⊥) : A ⊔ B = zpowers swap45 := by
  apply normal_crossing_eq _ ?_ hn hne
  apply sup_le
  · intro a ha
    exact mem_sup_right ((fixes_orbitSpan_iff a).mp
      (orbitSpan_eq_hyperplane ▸ hA a ha))
  · intro b hb
    exact mem_sup_left ((fixes_crossingHyperplane_iff b).mp (hB b hb))


/-- The constant vector belongs to the actual source hyperplane. -/
theorem oneWord_mem_hyperplane : oneWord ∈ hyperplane :=
  (mem_hyperplane _).mpr rfl

private theorem pairWord_perm (g : S) (i j : Fin 6) :
    coreRepresentation (Fin 6) g (pairWord i j) = pairWord (g i) (g j) := by
  apply Subtype.ext
  funext k
  simp [pairWord,representation,Pi.single_apply,Equiv.symm_apply_eq]

private theorem pairWord_eq_of_pair_eq {i j k l : Fin 6}
    (h : ({i,j} : Finset (Fin 6)) = {k,l}) : pairWord i j = pairWord k l := by
  have hh := congrArg (fun A : Finset (Fin 6) => (A : Set (Fin 6))) h
  simp only [Finset.coe_insert,Finset.coe_singleton] at hh
  rcases Set.pair_eq_pair_iff.mp hh with ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩
  · rfl
  · apply Subtype.ext
    exact add_comm _ _

/-- On the source hyperplane, trivial action modulo its constant line already
means trivial action. This is the exact section-kernel equality in the final
rank-five contradiction. -/
theorem fixes_hyperplane_of_constant_displacement (g : S)
    (hg : ∀ v ∈ hyperplane, coreRepresentation (Fin 6) g v - v ∈
      Submodule.span (ZMod 2) {oneWord}) :
    ∀ v ∈ hyperplane, coreRepresentation (Fin 6) g v = v := by
  have hf (i j : Fin 6) (hij : i ≠ j) (hv : pairWord i j ∈ hyperplane) :
      coreRepresentation (Fin 6) g (pairWord i j) = pairWord i j := by
    obtain ⟨a,ha⟩ := Submodule.mem_span_singleton.mp (hg _ hv)
    have hp : coreToNatural (Fin 6) (coreRepresentation (Fin 6) g (pairWord i j)) =
        coreToNatural (Fin 6) (pairWord i j) := by
      apply sub_eq_zero.mp
      rw [← map_sub,← ha,map_smul]
      have hz : coreToNatural (Fin 6) oneWord = 0 := by
        apply Subtype.ext
        exact (Submodule.Quotient.mk_eq_zero _).mpr (Submodule.subset_span (by simp [oneWord]))
      rw [hz,smul_zero]
    rw [pairWord_perm,pairWord_toNatural,pairWord_toNatural] at hp
    rw [pairWord_perm]
    exact pairWord_eq_of_pair_eq ((pairVector_eq_iff (g.injective.ne hij) hij).mp hp)
  have h01 := hf 0 1 (by decide) ((mem_hyperplane _).mpr (by decide))
  have h02 := hf 0 2 (by decide) ((mem_hyperplane _).mpr (by decide))
  have h03 := hf 0 3 (by decide) ((mem_hyperplane _).mpr (by decide))
  have h45 := hf 4 5 (by decide) ((mem_hyperplane _).mpr (by decide))
  intro v hv
  rw [hyperplane_decomposition v hv]
  simp only [map_add,map_smul,h01,h02,h03,h45]

/-- The quotient-hyperplane fixer is the same transposition subgroup as the
pointwise fixer of the unquotiented hyperplane. -/
theorem constant_displacement_iff (g : S) :
    (∀ v ∈ hyperplane, coreRepresentation (Fin 6) g v - v ∈
      Submodule.span (ZMod 2) {oneWord}) ↔ g ∈ zpowers swap45 := by
  constructor
  · intro hg
    exact (fixes_orbitSpan_iff g).mp
      (orbitSpan_eq_hyperplane ▸ fixes_hyperplane_of_constant_displacement g hg)
  · intro hg v hv
    have he := (fixes_orbitSpan_iff g).mpr hg v (orbitSpan_eq_hyperplane.symm ▸ hv)
    rw [he,sub_self]
    exact Submodule.zero_mem _


/-- The stabilizer of the original weight-four source point is the literal
duad stabilizer. Intersecting with A6 gives `L1`. -/
theorem fixes_z_iff (g : S) : coreRepresentation (Fin 6) g z = z ↔ g ∈ H1 := by
  have hz : z = oneWord + pairWord 4 5 := by decide
  have ho : coreRepresentation (Fin 6) g oneWord = oneWord := by
    apply Subtype.ext
    rfl
  rw [hz,map_add,ho,add_left_cancel_iff,pairWord_perm]
  have hH : g ∈ H1 ↔ ({g 4,g 5} : Finset (Fin 6)) = {4,5} := by
    change (pair 4 5).image g = pair 4 5 ↔ _
    simp only [pair,Finset.image_insert,Finset.image_singleton]
  rw [hH]
  constructor
  · intro he
    have hn := congrArg (coreToNatural (Fin 6)) he
    exact (pairVector_eq_iff (g.injective.ne (by decide)) (by decide)).mp hn
  · exact pairWord_eq_of_pair_eq

/-- Membership in the even source point centralizer uses the original
weight-four point, with the ambient even-permutation condition retained. -/
theorem mem_L1_iff (g : S) : g ∈ L1 ↔
    coreRepresentation (Fin 6) g z = z ∧ g ∈ alternatingGroup (Fin 6) := by
  change (g ∈ H1 ∧ g ∈ alternatingGroup (Fin 6)) ↔ _
  rw [fixes_z_iff]

/-- The relabeling exchanges the two selected source-plane points and
preserves their original plane. -/
theorem crossingRelabel_plane : plane.map (coreRepresentation (Fin 6) crossingRelabel) = plane := by
  have hz : coreRepresentation (Fin 6) crossingRelabel z = w := by decide
  have hw : coreRepresentation (Fin 6) crossingRelabel w = z := by decide
  rw [plane,Submodule.map_span,Set.image_pair,hz,hw,Set.pair_comm]

/-- The second hyperplane is the orbit of the same original plane under the
literal conjugate point centralizer, with no independent plane coordinates. -/
theorem crossing_orbitSpan :
    Homogeneous.orbitSpan (coreRepresentation (Fin 6))
      (L1.map (MulAut.conj crossingRelabel).toMonoidHom) plane = crossingHyperplane := by
  have hh := Homogeneous.orbitSpan_map_equivariant (coreRepresentation (Fin 6))
    (coreRepresentation (Fin 6)) (MulAut.conj crossingRelabel).toMonoidHom
    (coreRepresentation (Fin 6) crossingRelabel) (fun g v => ?_) L1 plane
  · rw [crossingRelabel_plane,orbitSpan_eq_hyperplane] at hh
    exact hh.symm
  · change coreRepresentation (Fin 6) crossingRelabel (coreRepresentation (Fin 6) g v) =
      coreRepresentation (Fin 6) (crossingRelabel*g*crossingRelabel⁻¹)
        (coreRepresentation (Fin 6) crossingRelabel v)
    simp only [← Module.End.mul_apply,← map_mul,mul_assoc,inv_mul_cancel,mul_one]

end Theory.SpecificGroups.SymmetricSix.BinaryFlags.CoreCrossing
