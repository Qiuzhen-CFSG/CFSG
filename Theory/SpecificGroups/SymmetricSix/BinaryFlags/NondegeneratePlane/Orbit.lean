module

public import Theory.SpecificGroups.SymmetricSix.BinaryFlags.NondegeneratePlane
public import Theory.SpecificGroups.SymmetricSix.BinaryFlags.SylowGeometry
public import Mathlib.Logic.Equiv.Fintype
public import Theory.GroupTheory.SubgroupConjugation
/-!
# Nondegenerate planes in the actual six-letter module

The duad description identifies a nonorthogonal pair with two pairs
sharing exactly one letter. Extend that three-letter injection to a
permutation; dimension two then identifies the whole plane. Transporting
the canonical pointwise fixer proves that every nontrivial two-group
fixing any nondegenerate plane is generated by a transposition.

Only the 225 pairs of duads are checked for the overlap identity; group
and vector-space transports are structural. Source: Aschbacher--Smith
13.5.6, printed p.917, before the C.1.24(c) application.
-/

@[expose] public section
open Subgroup BinaryPermutation Equiv Equiv.Perm
namespace Theory.SpecificGroups.SymmetricSix.BinaryFlags.NondegeneratePlane
open NaturalGeometry NaturalPairing Representation.BinaryOffender

def rawPair (i j:Ω) : Full Ω:=Pi.single i 1+Pi.single j 1

theorem pair_form (i j k l:Ω) :
    form (pairVector i j) (pairVector k l)=∑a,rawPair i j a*rawPair k l a := by
  let p:core Ω:=⟨rawPair i j,by simp [rawPair,mem_core];decide +revert⟩
  let q:core Ω:=⟨rawPair k l,by simp [rawPair,mem_core];decide +revert⟩
  exact naturalPairing_apply_core Ω p q

private theorem overlap_cases (d e:NaturalGeometry.Duad)
    (h:(∑a,rawPair d.val.1 d.val.2 a*rawPair e.val.1 e.val.2 a)≠0) :
    (d.val.1=e.val.1 ∧ d.val.2≠e.val.2) ∨
    (d.val.1=e.val.2 ∧ d.val.2≠e.val.1) ∨
    (d.val.2=e.val.1 ∧ d.val.1≠e.val.2) ∨
    (d.val.2=e.val.2 ∧ d.val.1≠e.val.1) := by decide +revert

theorem nonorthogonal_pair_indices (x y:V) (h:form x y≠0) :
    ∃i j k:Ω,i≠j ∧ i≠k ∧ j≠k ∧ x=pairVector i j ∧ y=pairVector i k := by
  have hx:x≠0:=by intro he;subst x;simp at h
  have hy:y≠0:=by intro he;subst y;simp at h
  obtain ⟨d,rfl⟩:=(vector_cases x).resolve_left hx
  obtain ⟨e,rfl⟩:=(vector_cases y).resolve_left hy
  rw [duadVector,duadVector,pair_form] at h
  rcases overlap_cases d e h with ⟨he,hne⟩|⟨he,hne⟩|⟨he,hne⟩|⟨he,hne⟩
  · refine ⟨d.val.1,d.val.2,e.val.2,ne_of_lt d.property,?_,hne,rfl,?_⟩
    · rw [he];exact ne_of_lt e.property
    · change pairVector e.val.1 e.val.2=pairVector d.val.1 e.val.2
      rw [he]
  · refine ⟨d.val.1,d.val.2,e.val.1,ne_of_lt d.property,?_,hne,rfl,?_⟩
    · rw [he];exact (ne_of_lt e.property).symm
    · change pairVector e.val.1 e.val.2=pairVector d.val.1 e.val.1
      rw [he,pairVector_comm]
  · refine ⟨d.val.2,d.val.1,e.val.2,(ne_of_lt d.property).symm,?_,hne,?_,?_⟩
    · rw [he];exact ne_of_lt e.property
    · exact pairVector_comm _ _
    · change pairVector e.val.1 e.val.2=pairVector d.val.2 e.val.2
      rw [he]
  · refine ⟨d.val.2,d.val.1,e.val.1,(ne_of_lt d.property).symm,?_,hne,?_,?_⟩
    · rw [he];exact (ne_of_lt e.property).symm
    · exact pairVector_comm _ _
    · change pairVector e.val.1 e.val.2=pairVector d.val.2 e.val.1
      rw [he,pairVector_comm]

theorem nonorthogonal_pair_mover (x y:V) (h:form x y≠0) :
    ∃g:S,naturalRepresentation Ω g (pairVector 0 1)=x ∧
      naturalRepresentation Ω g (pairVector 0 2)=y := by
  obtain ⟨i,j,k,hij,hik,hjk,rfl,rfl⟩:=nonorthogonal_pair_indices x y h
  let f:Fin 3→Ω:=![i,j,k]
  have hf:Function.Injective f := by
    intro a b hab
    fin_cases a <;> fin_cases b <;> simp_all [f]
  obtain ⟨g,hg⟩:=Perm.exists_extending_pair (fun j:Fin 3=>(j.castLE (by decide):Fin 6)) f
    (by intro a b he;exact Fin.ext (congrArg (fun x:Fin 6=>x.val) he)) hf
  refine ⟨g,?_,?_⟩
  · rw [pairVector_map]
    have h0:g 0=i:=hg 0
    have h1:g 1=j:=hg 1
    rw [h0,h1]
  · rw [pairVector_map]
    have h0:g 0=i:=hg 0
    have h2:g 2=k:=hg 2
    rw [h0,h2]
theorem plane_finrank : Module.finrank (ZMod 2) plane=2 := by
  let b:Fin 2→V:=fun i=>if i=0 then pairVector 0 1 else pairVector 0 2
  have hb:LinearIndependent (ZMod 2) b := by
    rw [linearIndependent_fin2]
    constructor
    · exact pairVector_ne_zero (by decide)
    · intro a ha
      fin_cases a
      · apply pairVector01_ne_zero
        change (0:ZMod 2) • pairVector 0 2=pairVector 0 1 at ha
        simpa using ha.symm
      · change (1:ZMod 2) • pairVector 0 2=pairVector 0 1 at ha
        have he:pairVector 0 2=pairVector 0 1 := by simpa only [one_smul] using ha
        have hh:pair 0 2=pair 0 1 := (pairVector_eq_iff (by decide) (by decide)).mp he
        exact (by decide : pair 0 2≠pair 0 1) hh
  have hrange:Set.range b=({pairVector 0 1,pairVector 0 2}:Set V) := by
    ext x
    constructor
    · rintro ⟨i,rfl⟩
      fin_cases i <;> simp [b]
    · rintro (hx|hx)
      · exact ⟨0,hx.symm⟩
      · exact ⟨1,hx.symm⟩
  rw [show plane=Submodule.span (ZMod 2) (Set.range b) by rw [hrange];rfl,
    finrank_span_eq_card hb]
  decide

/-- Every nonisotropic plane is the actual permutation image of the
canonical nondegenerate plane. -/
theorem exists_plane_marking (W:Submodule (ZMod 2) V)
    (hd:Module.finrank (ZMod 2) W=2)
    (hn:¬∀x∈W,∀y∈W,form x y=0) : ∃g:S,W=move g plane := by
  push Not at hn
  obtain ⟨x,hx,y,hy,hxy⟩:=hn
  obtain ⟨g,hgx,hgy⟩:=nonorthogonal_pair_mover x y hxy
  refine ⟨g,?_⟩
  apply (Submodule.eq_of_le_of_finrank_eq ?_ ((move_finrank g plane).trans (plane_finrank.trans hd.symm))).symm
  rw [move,plane,Submodule.map_span,Set.image_insert_eq,Set.image_singleton,hgx,hgy]
  exact Submodule.span_le.mpr (by rintro v (rfl|rfl);exact hx;exact hy)

/-- A two-group fixing any genuine nondegenerate plane is trivial or
is generated by one literal transposition. -/
theorem twoGroup_fixing_plane (W:Submodule (ZMod 2) V)
    (hd:Module.finrank (ZMod 2) W=2)
    (hn:¬∀x∈W,∀y∈W,form x y=0)
    (A:Subgroup S) (hA:IsPGroup 2 A)
    (hfix:∀a∈A,∀v∈W,naturalRepresentation Ω a v=v) :
    A=⊥ ∨ ∃r:S,r.IsSwap ∧ A=zpowers r := by
  obtain ⟨g,hW⟩:=exists_plane_marking W hd hn
  let B:=A.map (MulAut.conj g⁻¹).toMonoidHom
  have hB:B≤complementFixer := by
    rintro _ ⟨a,ha,rfl⟩
    apply (fixes_plane_iff _).mp
    intro v hv
    have hvg:naturalRepresentation Ω g v∈W := hW ▸ Submodule.mem_map_of_mem hv
    have he:=hfix a ha _ hvg
    change naturalRepresentation Ω (g⁻¹*a*(g⁻¹)⁻¹) v=v
    rw [inv_inv,map_mul,map_mul]
    change naturalRepresentation Ω g⁻¹ (naturalRepresentation Ω a (naturalRepresentation Ω g v))=v
    rw [he,Representation.inv_self_apply]
  rcases twoGroup_fixer B (hA.map _) hB with hb|⟨r,hr,hb⟩
  · exact Or.inl ((A.map_eq_bot_iff_of_injective (MulAut.conj g⁻¹).injective).mp hb)
  · right
    have he:B.map (MulAut.conj g).toMonoidHom=A := by
      change (A.conjBy g⁻¹).conjBy g=A
      exact conjBy_inv' A g
    refine ⟨(MulAut.conj g) r,?_,?_⟩
    · obtain ⟨i,j,hij,rfl⟩:=hr
      change (g*swap i j*g⁻¹).IsSwap
      rw [mul_swap_eq_swap_mul,mul_inv_cancel_right]
      exact ⟨g i,g j,g.injective.ne hij,rfl⟩
    · rw [←he,hb,MonoidHom.map_zpowers]
      rfl
end Theory.SpecificGroups.SymmetricSix.BinaryFlags.NondegeneratePlane

