module

public import Theory.SpecificGroups.Janko4.Model.LocalStructure.Mathieu
public import Theory.SpecificGroups.Janko4.Model.GeneratorCertificates.MatrixResults
public import Theory.GroupTheory.PerfectCentralCover

/-!
# The literal Mathieu local group for the J4 two-primary calculation

The local group is the subgroup of the binary matrix carrier generated by the
ATLAS `J4G1-max1W1` words. Its normal elementary subgroup has order 2048,
and its actual quotient is M24. Restricting a perfect central cover to this
subgroup retains its whole kernel, with an explicit equivalence.

The two remaining calculations are stated separately: a central double
extension has elementary core preimage, and such an elementary preimage
has an invariant complement to the central line. These are proof obligations,
not assumptions of an asserted J4 multiplier theorem. `JankoReduction`
uses both to eliminate the original covering kernel by central transfer.

Source: Aschbacher--Smith I.1.1--I.1.3, printed p.407, referring to GLS3
Section 6.1. The model data retain their ATLAS attribution through
`Janko4.Model.Cardinality.Subgroup` and `LocalStructure.Mathieu`.
-/

@[expose] public section
open Subgroup PerfectCentralCovering
namespace Janko4.TwoPrimary
universe u

/-- The subgroup defined by the literal ATLAS max1 words. -/
abbrev Local : Subgroup Model :=
  Cardinality.max1Subgroup matrixA_mul_self matrixB_pow_four

/-- Its certified elementary normal subgroup of order 2048. -/
abbrev Core : Subgroup Local :=
  Cardinality.localKernel matrixA_mul_self matrixB_pow_four

/-- The actual M24 quotient map, retaining the original core. -/
noncomputable def mathieuProjection : Local →* Sporadic.Mathieu.M24 :=
  (LocalStructure.localQuotientEquivM24 matrixA_mul_self matrixB_pow_four).toMonoidHom.comp
    (QuotientGroup.mk' Core)

theorem mathieuProjection_surjective : Function.Surjective mathieuProjection :=
  (LocalStructure.localQuotientEquivM24 _ _).surjective.comp
    (QuotientGroup.mk'_surjective _)

theorem mathieuProjection_ker : mathieuProjection.ker = Core := by
  rw [mathieuProjection, MonoidHom.ker_comp_of_injective _ _
    (LocalStructure.localQuotientEquivM24 _ _).injective, QuotientGroup.ker_mk']

/-- The first local calculation needed in central double extensions. -/
def ElementaryPreimage {L : Type*} [Group L] (q : L →* Local) : Prop :=
  ∀ x : L, q x ∈ Core → x ^ 2 = 1

/-- Local restriction of the original covering map. -/
abbrev localProjection {E : Type*} [Group E] (f : Cover E Model) :
    Local.comap f.toMonoidHom →* Local := f.toMonoidHom.subgroupComap Local

/-- The restriction has exactly the original kernel, with the subtype maps retained. -/
def localKernelEquiv {E : Type*} [Group E] (f : Cover E Model) :
    (localProjection f).ker ≃* f.toMonoidHom.ker where
  toFun x := ⟨x.val.val, congrArg Subtype.val x.property⟩
  invFun z := ⟨⟨z.val, by
    change f.toMonoidHom z.val ∈ Local
    rw [z.property]
    exact Local.one_mem⟩, Subtype.ext z.property⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl

/-- Exact degree of the restricted cover. -/
theorem localProjection_kernel_card {E : Type*} [Group E] (f : Cover E Model) :
    Nat.card (localProjection f).ker = Nat.card f.toMonoidHom.ker :=
  Nat.card_congr (localKernelEquiv f).toEquiv

/-- The invariant quadratic-form calculation, stated on the actual local group. -/
def ElementaryPreimageCalculation : Prop :=
  ∀ (L : Type u) [Group L] [Finite L] (q : L →* Local),
    Function.Surjective q → q.ker ≤ center L → Nat.card q.ker = 2 →
      ElementaryPreimage q

/-- The independent module-extension calculation. It assumes only the
exponent-two conclusion of the preceding calculation, not its proof. -/
def InvariantComplementCalculation : Prop :=
  ∀ (L : Type u) [Group L] [Finite L] (q : L →* Local),
    Function.Surjective q → q.ker ≤ center L → Nat.card q.ker = 2 →
      ElementaryPreimage q →
        ∃ T : Subgroup L, T.Normal ∧ Disjoint q.ker T ∧ T.map q = Core


end Janko4.TwoPrimary
