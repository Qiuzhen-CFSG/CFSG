    ![2, 5, 16, 32] ] : Fin 32 → Fin 4 → ℕ) i j)

public theorem centricCandidateGenerator_mem : ∀ i : Fin 32, ∀ j : Fin 4,
    centricCandidateGenerator i j ∈ centricCandidate i := by decide +kernel

