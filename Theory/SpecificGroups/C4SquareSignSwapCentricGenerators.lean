/-- A positive word for a member of a candidate subgroup. -/
@[expose] public def centricCandidateWord (i : Fin 32) (g : Model) : List (Fin 4) :=
  (centricCandidateWordTable i).getD (coordinateCode g) []

set_option maxRecDepth 100000 in
public theorem centricCandidate_normal_form : ∀ i : Fin 32, ∀ g : Model,
    g ∈ centricCandidate i →
      evalWord (centricCandidateGenerator i) (centricCandidateWord i g) = g := by
  decide +kernel

/-- The masks and the listed generators define the same subgroups. -/
public theorem centricCandidate_eq_closure (i : Fin 32) :
    centricCandidate i = Subgroup.closure (Set.range (centricCandidateGenerator i)) := by
  apply le_antisymm
  · intro g hg
    rw [← centricCandidate_normal_form i g hg]
    exact SubgroupEnumeration.evalWord_mem (centricCandidateGenerator i)
      (Subgroup.closure (Set.range (centricCandidateGenerator i)))
      (fun j => Subgroup.subset_closure ⟨j, rfl⟩) _
  · apply (Subgroup.closure_le _).mpr
    rintro g ⟨j, rfl⟩
    exact centricCandidateGenerator_mem i j

/-- The generators regarded as elements of the candidate subgroup. -/
@[expose] public def centricCandidateGeneratorIn (i : Fin 32) (j : Fin 4) :
    centricCandidate i := ⟨centricCandidateGenerator i j, centricCandidateGenerator_mem i j⟩

/-- Homomorphisms out of a candidate are determined by the four generators. -/
public theorem centricCandidate_hom_ext {A : Type*} [Group A] (i : Fin 32)
    (f h : centricCandidate i →* A)
    (heq : ∀ j : Fin 4, f (centricCandidateGeneratorIn i j) = h (centricCandidateGeneratorIn i j)) :
    f = h := by
  have hw (w : List (Fin 4)) :
      f ⟨evalWord (centricCandidateGenerator i) w,
        SubgroupEnumeration.evalWord_mem _ _ (centricCandidateGenerator_mem i) w⟩ =
      h ⟨evalWord (centricCandidateGenerator i) w,
        SubgroupEnumeration.evalWord_mem _ _ (centricCandidateGenerator_mem i) w⟩ := by
    induction w with
    | nil => exact f.map_one.trans h.map_one.symm
    | cons j w ih =>
      let y : centricCandidate i := ⟨evalWord (centricCandidateGenerator i) w,
        SubgroupEnumeration.evalWord_mem _ _ (centricCandidateGenerator_mem i) w⟩
      change f (centricCandidateGeneratorIn i j * y) = h (centricCandidateGeneratorIn i j * y)
      rw [map_mul, map_mul, heq j, ih]
  ext g
  have he := centricCandidate_normal_form i g g.property
  have hg : (⟨evalWord (centricCandidateGenerator i) (centricCandidateWord i g),
      SubgroupEnumeration.evalWord_mem _ _ (centricCandidateGenerator_mem i) _⟩ :
      centricCandidate i) = g := Subtype.ext he
  exact hg ▸ hw (centricCandidateWord i g)

end C4SquareSignSwap
