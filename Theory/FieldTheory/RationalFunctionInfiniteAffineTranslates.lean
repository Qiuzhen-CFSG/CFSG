module

public import Theory.FieldTheory.RationalFunctionInfiniteAffineTranslatesCore

/-!
# Cross-universe infinite affine translates

This module transports the rational-function one-place argument from `RatFunc k`
to an arbitrary field `K` generated by a transcendental element `z : K`.
The imported core is the rational completion step from Borel, *Linear Algebraic
Groups*, Theorem 10.9 (`refs/KGroup/Bor1/Chapter3.tex`): the projective pole
support of a rational function is invariant under the affine-translate
symmetries, supports of at least two points have finite stabilizer, and a
singleton support gives a fractional-linear coordinate in which the function is
polynomial.  Here the supplied generator identifies `K` with `RatFunc k`; the
proof conjugates every witnessing automorphism, transports transcendence and
the infinite set of constants, and maps the resulting coordinate back.  The
adjoin equality is transported through `IntermediateField.adjoin_map` and the
field-range API, while polynomial membership is transported by
`Polynomial.aeval_algHom_apply`.

No algebraic-group module or pre-existing affine-line classification is used.
-/

universe u v

open Polynomial

public theorem rational_function_infinite_affine_translates_exists_one_place_parameter
    {k : Type u} {K : Type v}
    [Field k] [IsAlgClosed k] [Field K] [Algebra k K]
    (z t : K) (hz : Transcendental k z)
    (hzgen : IntermediateField.adjoin k {z} = ⊤)
    (ht : Transcendental k t)
    (hinfinite : Set.Infinite {c : k | ∃ sigma : K ≃ₐ[k] K,
      sigma t = t + algebraMap k K c}) :
    ∃ s : K, Transcendental k s ∧
      IntermediateField.adjoin k {s} = ⊤ ∧ t ∈ Algebra.adjoin k {s} := by
  classical
  let e : RatFunc k ≃ₐ[k] K :=
    (RatFunc.algEquivOfTranscendental z hz).trans
      ((IntermediateField.equivOfEq hzgen).trans IntermediateField.topEquiv)
  let tR : RatFunc k := e.symm t
  have htR : Transcendental k tR := by
    intro halg
    apply ht
    simpa [tR] using halg.algHom e.toAlgHom
  have hinfiniteR : Set.Infinite {c : k |
      ∃ sigma : RatFunc k ≃ₐ[k] RatFunc k,
        sigma tR = tR + algebraMap k (RatFunc k) c} := by
    apply hinfinite.mono
    intro c hc
    obtain ⟨sigma, hsigma⟩ := hc
    refine ⟨(e.trans sigma).trans e.symm, ?_⟩
    simp [tR, hsigma]
  obtain ⟨sR, hsR, hsRgen, htpoly⟩ :=
    RatFunc.infinite_affine_translates_exists_one_place_parameter_core
      tR htR hinfiniteR
  refine ⟨e sR, ?_, ?_, ?_⟩
  · intro halg
    apply hsR
    simpa using halg.algHom e.symm.toAlgHom
  · calc
      IntermediateField.adjoin k {e sR} =
          (IntermediateField.adjoin k {sR}).map e.toAlgHom := by
        change IntermediateField.adjoin k {e.toAlgHom sR} = _
        rw [IntermediateField.adjoin_map, Set.image_singleton]
      _ = (⊤ : IntermediateField k (RatFunc k)).map e.toAlgHom :=
        congrArg (fun E : IntermediateField k (RatFunc k) => E.map e.toAlgHom) hsRgen
      _ = e.toAlgHom.fieldRange := (AlgHom.fieldRange_eq_map e.toAlgHom).symm
      _ = ⊤ := e.fieldRange_eq_top
  · rw [Algebra.adjoin_singleton_eq_range_aeval] at htpoly ⊢
    obtain ⟨p, hp⟩ := htpoly
    refine ⟨p, ?_⟩
    calc
      Polynomial.aeval (e sR) p = e (Polynomial.aeval sR p) := by
        exact Polynomial.aeval_algHom_apply e.toAlgHom sR p
      _ = e tR := congrArg e hp
      _ = t := e.apply_symm_apply t
