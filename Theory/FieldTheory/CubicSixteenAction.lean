module
public import Theory.FieldTheory.QuadraticFrobenius
public import Theory.FieldTheory.RootsOfUnityCard
public import Theory.Frattini.PGroup

/-!
# The cubic torus detects the Frattini quotient of GF(16) automorphisms

Restrict actual field automorphisms to the cube roots of unity. Frobenius
acts nontrivially, so this is the full order-two automorphism group of the
cubic torus. Its kernel is generated by squared Frobenius and therefore
lies in the Frattini subgroup of the order-four field automorphism group.

The binary wreath lift uses this concrete action to recover the complete
outer group from its cubic torus action; no abstract family label is used.
Source: Aschbacher--Smith 14.6.14(4), printed p.1033.
-/

public noncomputable section
open Subgroup
namespace FiniteField.CubicSixteen
variable (F : Type*) [Field F] [Finite F] [CharP F 2]

/-- Restriction of the actual field automorphism to the cube roots of unity. -/
@[expose] def action : (F ≃+* F) →* MulAut (rootsOfUnity 3 F) where
  toFun σ := {
    toFun x := ⟨Units.map σ.toMonoidHom x, by
      rw [mem_rootsOfUnity,←map_pow]
      exact (congrArg (Units.map σ.toMonoidHom) x.property).trans (map_one _)⟩
    invFun x := ⟨Units.map σ.symm.toMonoidHom x, by
      rw [mem_rootsOfUnity,←map_pow]
      exact (congrArg (Units.map σ.symm.toMonoidHom) x.property).trans (map_one _)⟩
    left_inv x := by apply Subtype.ext; apply Units.ext; exact σ.symm_apply_apply _
    right_inv x := by apply Subtype.ext; apply Units.ext; exact σ.apply_symm_apply _
    map_mul' x y := by apply Subtype.ext; exact map_mul _ _ _ }
  map_one' := by ext x; rfl
  map_mul' σ τ := by ext x; rfl

omit [CharP F 2] in
theorem roots_card (hF : Nat.card F = 16) : Nat.card (rootsOfUnity 3 F) = 3 :=
  card_rootsOfUnity_of_dvd F 3 (by rw [hF]; decide)

omit [CharP F 2] in
theorem action_target_card (hF : Nat.card F = 16) :
    Nat.card (MulAut (rootsOfUnity 3 F)) = 2 := by
  let : IsCyclic (rootsOfUnity 3 F) := isCyclic_of_prime_card (roots_card F hF)
  rw [IsCyclic.card_mulAut,roots_card F hF]
  rfl

theorem frobenius_action_ne_one (hF : Nat.card F = 16) :
    action F (frobeniusEquiv F 2) ≠ 1 := by
  have hc := roots_card F hF
  let : Nontrivial (rootsOfUnity 3 F) := Finite.one_lt_card_iff_nontrivial.mp (by omega)
  obtain ⟨x,hx⟩ := exists_ne (1 : rootsOfUnity 3 F)
  intro he
  have hh := congrArg (fun f : MulAut (rootsOfUnity 3 F) => (((f x : rootsOfUnity 3 F) : Fˣ) : F)) he
  change (x : Fˣ).val ^ 2 = (x : Fˣ).val at hh
  have hu : (x : Fˣ) ^ 2 = (x : Fˣ) := Units.ext hh
  apply hx
  apply Subtype.ext
  exact mul_left_cancel (show (x : Fˣ) * (x : Fˣ) = (x : Fˣ) * 1 by
    simpa only [pow_two,mul_one] using hu)

/-- The field action on the actual cubic torus is the full order-two action. -/
theorem action_surjective (hF : Nat.card F = 16) : Function.Surjective (action F) := by
  have hc := action_target_card F hF
  have hr : (action F).range = ⊤ := by
    apply eq_of_le_of_card_ge le_top
    rw [card_top,hc]
    have hd := (action F).range.card_subgroup_dvd_card
    rw [hc] at hd
    rcases (Nat.dvd_prime Nat.prime_two).mp hd with h | h
    · have hb : (action F).range = ⊥ := (card_eq_one.mp h)
      exact False.elim (frobenius_action_ne_one F hF (show action F (frobeniusEquiv F 2) = 1 from
        mem_bot.mp (hb ▸ (show action F (frobeniusEquiv F 2) ∈ (action F).range from ⟨_,rfl⟩))))
    · omega
  exact MonoidHom.range_eq_top.mp hr

/-- The invisible field involution lies in the Frattini subgroup of C₄. -/
theorem action_ker_le_frattini (hF : Nat.card F = 16) :
    (action F).ker ≤ frattini (F ≃+* F) := by
  let : Finite (F ≃+* F) := Finite.of_injective
    (fun σ : F ≃+* F => (σ : F → F)) DFunLike.coe_injective
  have hc : Nat.card (F ≃+* F) = 4 :=
    card_ringAut_of_card_prime_pow Nat.prime_two (by simpa using hF)
  have hp : IsPGroup 2 (F ≃+* F) := IsPGroup.of_card (n := 2) hc
  let : Fact (IsPGroup 2 (F ≃+* F)) := ⟨hp⟩
  let σ := frobeniusEquiv F 2
  have ho : orderOf σ = 4 := frobeniusEquiv_orderOf_of_card (by simpa using hF)
  have hkcard : Nat.card (action F).ker = 2 := by
    have hh := (action F).ker.card_mul_index
    rw [index_ker,MonoidHom.range_eq_top.mpr (action_surjective F hF),card_top,
      action_target_card F hF,hc] at hh
    omega
  have hzcard : Nat.card (zpowers (σ^2)) = 2 := by
    rw [Nat.card_zpowers,orderOf_pow,ho]
    decide
  have hle : zpowers (σ^2) ≤ (action F).ker := by
    apply zpowers_le.mpr
    change action F (σ^2) = 1
    rw [map_pow]
    have hh := pow_card_eq_one' (x := action F σ)
    rwa [action_target_card F hF] at hh
  have he := eq_of_le_of_card_ge hle (by rw [hkcard,hzcard])
  rw [←he]
  exact zpowers_le.mpr (pth_power_mem_frattini_of_isPGroup (p := 2) σ)

end FiniteField.CubicSixteen
