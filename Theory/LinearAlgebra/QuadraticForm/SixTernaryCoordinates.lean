module

public import Mathlib.Data.ZMod.Basic
public import Mathlib.LinearAlgebra.Pi
public import Mathlib.GroupTheory.Commutator.Basic
public import Mathlib.Tactic.FinCases

/-!
# Coordinates for the six-dimensional ternary orthogonal space

The diagonal form has coefficients `(1, 1, 1, 1, 1, -1)`. Its sign changes and
its isometry interchanging the first two coordinates and negating the last
coordinate give the concrete calculations used in Aschbacher–Smith,
*The Classification of Quasithin Groups*, combined manuscript (1 March 2004),
§F.5, Lemmas F.5.1(3) and F.5.3(2),(6), printed pp. 300–301.

The proofs compute coordinates. In particular, a sign change commutes with
this isometry precisely when its first two signs agree. This includes sign
changes with neither of the first two coordinates in their support; the
printed display in F.5.3(2), requiring both coordinates, omits these elements.
Among even sign changes fixing the last coordinate, the commutators generate
exactly the subgroup generated by the sign change on the first two coordinates.
Indices in this module are zero-based.
-/

@[expose] public section

namespace SixTernaryCoordinates
/-- The natural six-dimensional vector space over the field of three elements. -/
abbrev Space := Fin 6 → ZMod 3

/-- Negate exactly the coordinates in `J`. -/
def signChange (J : Finset (Fin 6)) : Space ≃ₗ[ZMod 3] Space where
  toFun v i := if i ∈ J then -v i else v i
  invFun v i := if i ∈ J then -v i else v i
  left_inv v := by funext i; by_cases h : i ∈ J <;> simp [h]
  right_inv v := by funext i; by_cases h : i ∈ J <;> simp [h]
  map_add' v w := by funext i; by_cases h : i ∈ J <;> simp [h, add_comm]
  map_smul' c v := by funext i; by_cases h : i ∈ J <;> simp [h]

/-- Swap coordinates 0 and 1, and negate coordinate 5. -/
def graphInvolution : Space ≃ₗ[ZMod 3] Space where
  toFun v := ![v 1, v 0, v 2, v 3, v 4, -v 5]
  invFun v := ![v 1, v 0, v 2, v 3, v 4, -v 5]
  left_inv v := by funext i; fin_cases i <;> simp
  right_inv v := by funext i; fin_cases i <;> simp
  map_add' v w := by funext i; fin_cases i <;> simp [add_comm]
  map_smul' c v := by funext i; fin_cases i <;> simp

@[simp] theorem signChange_apply (J : Finset (Fin 6)) (v : Space) (i : Fin 6) :
    signChange J v i = if i ∈ J then -v i else v i := rfl
@[simp] theorem graphInvolution_apply (v : Space) : graphInvolution v = ![v 1, v 0, v 2, v 3, v 4, -v 5] := rfl
@[simp] theorem signChange_inv (J : Finset (Fin 6)) : (signChange J)⁻¹ = signChange J := rfl
@[simp] theorem graphInvolution_inv : graphInvolution⁻¹ = graphInvolution := rfl

open scoped commutatorElement

theorem commutator_signChange_graphInvolution (J : Finset (Fin 6)) :
    ⁅signChange J, graphInvolution⁆ = if (0 ∈ J ↔ 1 ∈ J) then 1 else signChange {0, 1} := by
  by_cases h0 : 0 ∈ J <;> by_cases h1 : 1 ∈ J <;>
    ext v i <;> fin_cases i <;>
    simp [commutatorElement_def, h0, h1, LinearEquiv.mul_apply, graphInvolution_apply] <;>
    split_ifs <;> simp_all

theorem pairSignChange_ne_one : signChange {0, 1} ≠ 1 := by
  intro h
  have := congrArg (fun e : Space ≃ₗ[ZMod 3] Space => e (fun _ => 1) 0) h
  have hn : (-1 : ZMod 3) ≠ 1 := by decide
  exact hn (by simpa using this)

theorem commute_signChange_graphInvolution_iff (J : Finset (Fin 6)) :
    Commute (signChange J) graphInvolution ↔ (0 ∈ J ↔ 1 ∈ J) := by
  rw [← commutatorElement_eq_one_iff_commute, commutator_signChange_graphInvolution]
  split_ifs with h
  · exact iff_of_true rfl h
  · exact iff_of_false pairSignChange_ne_one h

/-- The diagonal quadratic form of plus type in dimension six over `ZMod 3`. -/
def quadratic (v : Space) : ZMod 3 :=
  v 0 ^ 2 + v 1 ^ 2 + v 2 ^ 2 + v 3 ^ 2 + v 4 ^ 2 - v 5 ^ 2

theorem quadratic_signChange (J : Finset (Fin 6)) (v : Space) :
    quadratic (signChange J v) = quadratic v := by
  simp [quadratic, ite_pow]

theorem quadratic_graphInvolution (v : Space) : quadratic (graphInvolution v) = quadratic v := by
  simp [quadratic, add_comm]

theorem commutator_values :
    {g : Space ≃ₗ[ZMod 3] Space | ∃ J : Finset (Fin 6),
      5 ∉ J ∧ Even J.card ∧ ⁅signChange J, graphInvolution⁆ = g} = {1, signChange {0, 1}} := by
  ext g
  constructor
  · rintro ⟨J, _, _, rfl⟩
    rw [commutator_signChange_graphInvolution]
    split_ifs <;> simp
  · intro hg
    rcases hg with rfl | rfl
    · refine ⟨∅, by decide, by decide, ?_⟩
      simp [commutator_signChange_graphInvolution]
    · refine ⟨{0, 2}, by decide, by decide, ?_⟩
      simp [commutator_signChange_graphInvolution]

theorem commutator_closure :
    Subgroup.closure {g : Space ≃ₗ[ZMod 3] Space | ∃ J : Finset (Fin 6),
      5 ∉ J ∧ Even J.card ∧ ⁅signChange J, graphInvolution⁆ = g} =
      Subgroup.closure {signChange {0, 1}} := by
  rw [commutator_values, Subgroup.closure_insert_one]

private theorem neg_eq_self_iff (a : ZMod 3) : -a = a ↔ a = 0 := by
  revert a
  decide

theorem graphInvolution_fixed_iff (v : Space) : graphInvolution v = v ↔ v 0 = v 1 ∧ v 5 = 0 := by
  constructor
  · intro h
    constructor
    · exact (congrFun h 0).symm
    · apply (neg_eq_self_iff _).mp
      exact congrFun h 5
  · rintro ⟨h01, h5⟩
    funext i
    fin_cases i <;> simp [h01, h5]

theorem graphInvolution_neg_iff (v : Space) :
    graphInvolution v = -v ↔ v 1 = -v 0 ∧ v 2 = 0 ∧ v 3 = 0 ∧ v 4 = 0 := by
  constructor
  · intro h
    refine ⟨congrFun h 0, ?_, ?_, ?_⟩
    · exact (neg_eq_self_iff _).mp (congrFun h 2).symm
    · exact (neg_eq_self_iff _).mp (congrFun h 3).symm
    · exact (neg_eq_self_iff _).mp (congrFun h 4).symm
  · rintro ⟨h01, h2, h3, h4⟩
    funext i
    fin_cases i <;> simp [h01, h2, h3, h4]

end SixTernaryCoordinates
