module
public import Theory.LinearAlgebra.QuadraticForm.BinaryFourPlus.CubicNormalizer
public import Theory.GroupTheory.WreathTwoThreeCore
public import Theory.GroupTheory.SpecificGroups.SLTwoPermThree
public import Mathlib.LinearAlgebra.Dimension.Finite
import all Theory.LinearAlgebra.QuadraticForm.BinaryFourPlus.CubicNormalizer
import all Theory.LinearAlgebra.QuadraticForm.BinaryFourPlus.Plane

/-!
# Singular planes and the cubic base of the binary plus orthogonal group

A singular plane determines one of the two full-support cubic lines. Its
stabilizer normalizes that line, as a calculation on sixteen vectors and
seventy-two actors verifies. A subgroup containing the order-nine cubic
base is generated by that base and any Sylow two-subgroup. Consequently
an invariant singular plane supplies a normal cubic subgroup.

The same cubic base determines the nondegenerate invariant quadratic form:
its two independent plane rotations kill cross-pairings, and each plane
has a constant nonzero value on its three nonzero vectors. This retains
the original quadratic form when an action is transported into the model.

Source application: Aschbacher--Smith 14.3.15, printed p.994, degree four.
-/

open Subgroup
open scoped IsMulCommutative
namespace BinaryFourPlus
private instance : DecidableEq Wreath := (RegularWreathProduct.equivProd (Equiv.Perm (Fin 3)) C2).injective.decidableEq
private instance : Fintype Wreath := Fintype.ofEquiv _ (RegularWreathProduct.equivProd (Equiv.Perm (Fin 3)) C2).symm
private def eval (w : Wreath) (v : V) : V :=
  if w.right=1 then (planeLinear (w.left 1) v.1,planeLinear (w.left swapIndex) v.2)
  else (planeLinear (w.left 1) v.2,planeLinear (w.left swapIndex) v.1)
private theorem eval_eq (w : Wreath) (v : V) : eval w v=(wreathToIsometry w).val v :=
  (wreathToIsometry_apply w v).symm
private def independentSingular (v w : V) : Prop :=
  v≠0 ∧ w≠0 ∧ v≠w ∧ q v=0 ∧ q w=0 ∧ q (v+w)=0
private instance (v w : V) : Decidable (independentSingular v w) :=
  inferInstanceAs (Decidable (_ ∧ _ ∧ _ ∧ _ ∧ _ ∧ _))
private def preservesPair (a : Wreath) (v w : V) : Prop :=
  q (v+eval a v)=0 ∧ q (w+eval a v)=0 ∧ q (v+eval a w)=0 ∧ q (w+eval a w)=0
private instance (a : Wreath) (v w : V) : Decidable (preservesPair a v w) :=
  inferInstanceAs (Decidable (_ ∧ _ ∧ _ ∧ _))
set_option maxRecDepth 10000 in
set_option maxHeartbeats 1000000 in
private theorem plane_cubic_certificate : ∀ v w : V,
    independentSingular v w → ∃ side : Bool, ∀ a : Wreath,
      preservesPair a v w →
        a*CubicNormalizer.rotation side*a⁻¹=CubicNormalizer.rotation side ∨
        a*CubicNormalizer.rotation side*a⁻¹=(CubicNormalizer.rotation side)⁻¹ := by
  decide +kernel

private theorem core_card : Nat.card (pCore 3 Wreath)=9 := by
  obtain ⟨eSL⟩ := SLTwoPermThree.sl2Two_equiv_perm_three
  let e := RegularWreathProduct.congr eSL (MulEquiv.refl C2)
  rw [← pCore_map_iso 3 e,card_map_of_injective e.injective]
  exact Theory.GroupTheory.WreathTwoResidual.threeCore_card
private theorem core_elementary : IsElementaryAbelian 3 (pCore 3 Wreath) := by
  obtain ⟨eSL⟩ := SLTwoPermThree.sl2Two_equiv_perm_three
  let e := RegularWreathProduct.congr eSL (MulEquiv.refl C2)
  rw [← pCore_map_iso 3 e]
  let := Theory.GroupTheory.WreathTwoResidual.threeCore_elementary
  exact IsElementaryAbelian.map e.toMonoidHom
private theorem core_quotient_two : IsPGroup 2 (Wreath⧸pCore 3 Wreath) := by
  apply IsPGroup.of_card (n:=3)
  have h := (pCore 3 Wreath).card_mul_index
  have hc : Nat.card Wreath=72 :=
    (Nat.card_congr isometryEquivWreath.toEquiv).symm.trans card_isometrySubgroup
  rw [core_card,index_eq_card,hc] at h
  omega
private theorem cube_mem_core (w : Wreath) (hw : w^3=1) : w∈pCore 3 Wreath := by
  let f := QuotientGroup.mk' (pCore 3 Wreath)
  have hd : orderOf (f w)∣3 := orderOf_dvd_of_pow_eq_one (by rw [← map_pow,hw,map_one])
  have hc := core_quotient_two.orderOf_coprime (by decide : Nat.Coprime 2 3) (f w)
  exact (QuotientGroup.eq_one_iff w).mp (orderOf_eq_one_iff.mp
    (Nat.eq_one_of_dvd_coprimes hc (dvd_refl _) hd))

private theorem core_sup_sylow (H : Subgroup Wreath) (hcore : pCore 3 Wreath≤H)
    (P : Sylow 2 H) : (pCore 3 Wreath).subgroupOf H ⊔ (P : Subgroup H)=⊤ := by
  let B := (pCore 3 Wreath).subgroupOf H
  let D := B⊔(P : Subgroup H)
  have hB : Nat.card B=9 :=
    (Nat.card_congr (subgroupOfEquivOfLe hcore).toEquiv).trans core_card
  have hH : Nat.card H∣72 := by
    have hc : Nat.card Wreath=72 :=
      (Nat.card_congr isometryEquivWreath.toEquiv).symm.trans card_isometrySubgroup
    exact hc ▸ H.card_subgroup_dvd_card
  have hBi : B.index∣8 := by
    have hc := B.card_mul_index
    rw [hB] at hc
    exact (Nat.mul_dvd_mul_iff_left (by decide : 0<9)).mp (hc ▸ hH)
  have hd : D.index∣8 := (index_dvd_of_le (le_sup_left : B≤D)).trans hBi
  have hn : ¬2∣D.index := fun hh => P.not_dvd_index
    (hh.trans (index_dvd_of_le (le_sup_right : (P:Subgroup H)≤D)))
  have he : D.index=1 := by
    have hh := Nat.mem_divisors.mpr ⟨hd,by decide⟩
    rw [show (8:ℕ).divisors={1,2,4,8} by decide] at hh
    simp only [Finset.mem_insert,Finset.mem_singleton] at hh
    rcases hh with hh|hh|hh|hh <;> omega
  exact index_eq_one.mp he

/-- An invariant singular plane forces a normal cubic whenever the subgroup
contains the cubic base. The Sylow subgroup and action remain literal. -/
private theorem sylow_normalizes_cubic
    (H : Subgroup Wreath) (P : Sylow 2 H)
    (S : Submodule (ZMod 2) V) (hd : 2≤Module.finrank (ZMod 2) S)
    (hs : ∀ v∈S, q v=0)
    (hi : ∀ a : P, ∀ v∈S, (wreathToIsometry a.val.val).val v∈S) :
    ∃ L : Subgroup Wreath, Nat.card L=3 ∧ L≤pCore 3 Wreath ∧
      (P:Subgroup H)≤(normalizer (L:Set Wreath)).comap H.subtype := by
  classical
  have hS : S≠⊥ := by intro he; rw [he,finrank_bot] at hd; omega
  obtain ⟨v,hv,hv0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hS
  have hw : ∃ w∈S, w≠0 ∧ v≠w := by
    by_contra! hh
    have hle : Module.finrank (ZMod 2) S≤1 := by
      apply finrank_le_one (⟨v,hv⟩ : S)
      intro w
      by_cases hw0 : (w:V)=0
      · exact ⟨0,Subtype.ext (by simpa using hw0.symm)⟩
      · exact ⟨1,Subtype.ext (by simpa using hh w w.property hw0)⟩
    omega
  obtain ⟨w,hw,hw0,hvw⟩ := hw
  obtain ⟨side,hside⟩ := plane_cubic_certificate v w
    ⟨hv0,hw0,hvw,hs v hv,hs w hw,hs _ (S.add_mem hv hw)⟩
  let L := zpowers (CubicNormalizer.rotation side)
  have hc : Nat.card L=3 := (Nat.card_zpowers _).trans (CubicNormalizer.rotation_order side)
  have hL : L≤pCore 3 Wreath := zpowers_le.mpr (cube_mem_core _ (by
    rw [← orderOf_dvd_iff_pow_eq_one,CubicNormalizer.rotation_order]))
  have hPn : (P:Subgroup H)≤(normalizer (L:Set Wreath)).comap H.subtype := by
    intro a ha
    have hpair : preservesPair a.val v w := by
      change q (v+eval a.val v)=0 ∧ q (w+eval a.val v)=0 ∧
        q (v+eval a.val w)=0 ∧ q (w+eval a.val w)=0
      simp only [eval_eq]
      exact ⟨hs _ (S.add_mem hv (hi ⟨a,ha⟩ v hv)),
        hs _ (S.add_mem hw (hi ⟨a,ha⟩ v hv)),
        hs _ (S.add_mem hv (hi ⟨a,ha⟩ w hw)),
        hs _ (S.add_mem hw (hi ⟨a,ha⟩ w hw))⟩
    change a.val∈normalizer (zpowers (CubicNormalizer.rotation side):Set Wreath)
    rw [mem_normalizer_iff_map_conj_eq,MonoidHom.map_zpowers]
    change zpowers (a.val*CubicNormalizer.rotation side*a.val⁻¹)=_
    rcases hside a.val hpair with he|he
    · rw [he]
    · rw [he,zpowers_inv]
  exact ⟨L,hc,hL,hPn⟩

public theorem normal_cubic_of_sylow_invariant_singular_plane
    (H : Subgroup Wreath) (hcore : pCore 3 Wreath≤H) (P : Sylow 2 H)
    (S : Submodule (ZMod 2) V) (hd : 2≤Module.finrank (ZMod 2) S)
    (hs : ∀ v∈S, q v=0)
    (hi : ∀ a : P, ∀ v∈S, (wreathToIsometry a.val.val).val v∈S) :
    ∃ C : Subgroup H, C.Normal ∧ Nat.card C=3 := by
  obtain ⟨L,hc,hL,hPn⟩ := sylow_normalizes_cubic H P S hd hs hi
  have hLH := hL.trans hcore
  have hBn : (pCore 3 Wreath).subgroupOf H≤(normalizer (L:Set Wreath)).comap H.subtype := by
    intro a ha
    apply centralizer_le_normalizer
    let := core_elementary
    intro l hl
    exact congrArg Subtype.val (mul_comm (⟨l,hL hl⟩:pCore 3 Wreath) ⟨a.val,ha⟩)
  have hHn : H≤normalizer (L:Set Wreath) := by
    intro a ha
    have htop : (⊤:Subgroup H)≤(normalizer (L:Set Wreath)).comap H.subtype :=
      (core_sup_sylow H hcore P).symm ▸ sup_le hBn hPn
    change (⟨a,ha⟩:H)∈(normalizer (L:Set Wreath)).comap H.subtype
    exact htop (mem_top _)
  exact ⟨L.subgroupOf H,(normal_subgroupOf_iff_le_normalizer hLH).mpr hHn,
    (Nat.card_congr (subgroupOfEquivOfLe hLH).toEquiv).trans hc⟩
end BinaryFourPlus

open Subgroup
namespace BinaryFourPlus
private def c : Equiv.Perm (Fin 3) := Equiv.swap 0 1 * Equiv.swap 1 2
private def leftCycle : Wreath := ⟨fun i=>if i=1 then c else 1,1⟩
private def rightCycle : Wreath := ⟨fun i=>if i=1 then 1 else c,1⟩
private abbrev act (w : Wreath) : V ≃ₗ[ZMod 2] V := (wreathToIsometry w).val
private theorem left_eval (v : V) : act leftCycle v=(planeLinear c v.1,v.2) := by
  simp [act,wreathToIsometry_apply,leftCycle,swapIndex]
private theorem right_eval (v : V) : act rightCycle v=(v.1,planeLinear c v.2) := by
  simp [act,wreathToIsometry_apply,rightCycle,swapIndex]
private theorem cycle_sum : ∀ x : Plane, x+planeLinear c x=planeLinear c (planeLinear c x) := by decide +kernel
private theorem cycle_orbit : ∀ x : Plane, x≠0 →
    x=nonzeroVector 0 ∨ x=planeLinear c (nonzeroVector 0) ∨
      x=planeLinear c (planeLinear c (nonzeroVector 0)) := by decide +kernel
private theorem quadratic_polar_invariant (Q : QuadraticForm (ZMod 2) V)
    (a : V ≃ₗ[ZMod 2] V) (ha : ∀ v, Q (a v)=Q v) (v w : V) :
    Q.polarBilin (a v) (a w)=Q.polarBilin v w := by
  simp only [QuadraticMap.polarBilin_apply_apply,QuadraticMap.polar,← a.map_add,ha]
private theorem cross_zero (Q : QuadraticForm (ZMod 2) V)
    (hl : ∀ v, Q (act leftCycle v)=Q v) (x y : Plane) :
    Q.polarBilin (x,0) (0,y)=0 := by
  have h1 := quadratic_polar_invariant Q (act leftCycle) hl (x,0) (0,y)
  have h2 := quadratic_polar_invariant Q (act leftCycle) hl (planeLinear c x,0) (0,y)
  simp only [left_eval,map_zero] at h1 h2
  have hsum : ((x,0):V)+(planeLinear c x,0)=((planeLinear c (planeLinear c x)),0) :=
    Prod.ext (cycle_sum x) (zero_add 0)
  have h := LinearMap.map_add Q.polarBilin (x,0) (planeLinear c x,0)
  have hh := LinearMap.congr_fun h (0,y)
  change Q.polarBilin ((x,0)+(planeLinear c x,0)) (0,y)=
    Q.polarBilin (x,0) (0,y)+Q.polarBilin (planeLinear c x,0) (0,y) at hh
  rw [hsum,h2,h1] at hh
  have h₃ : Q.polarBilin (x,0) (0,y)=
      Q.polarBilin (x,0) (0,y)+Q.polarBilin (x,0) (0,y) := hh
  exact (by decide : ∀ a : ZMod 2, a=a+a → a=0) _ h₃

private theorem axis_values (Q : QuadraticForm (ZMod 2) V)
    (hl : ∀ v, Q (act leftCycle v)=Q v)
    (hr : ∀ v, Q (act rightCycle v)=Q v) :
    (∀ x, Q (x,0)=planeQ x*Q (nonzeroVector 0,0)) ∧
      (∀ y, Q (0,y)=planeQ y*Q (0,nonzeroVector 0)) := by
  constructor
  · intro x
    by_cases hx : x=0
    · subst x; change Q (0:V)=0*_; rw [Q.map_zero,zero_mul]
    have hq : planeQ x=1 := (by decide +kernel : ∀ x : Plane, x≠0 → planeQ x=1) x hx
    rw [hq,one_mul]
    have h (x : Plane) : Q (planeLinear c x,0)=Q (x,0) := by simpa only [left_eval] using hl (x,0)
    rcases cycle_orbit x hx with h0|h1|h2
    · rw [h0]
    · rw [h1,h]
    · rw [h2,h,h]
  · intro y
    by_cases hy : y=0
    · subst y; change Q (0:V)=0*_; rw [Q.map_zero,zero_mul]
    have hq : planeQ y=1 := (by decide +kernel : ∀ y : Plane, y≠0 → planeQ y=1) y hy
    rw [hq,one_mul]
    have h (y : Plane) : Q (0,planeLinear c y)=Q (0,y) := by simpa only [right_eval] using hr (0,y)
    rcases cycle_orbit y hy with h0|h1|h2
    · rw [h0]
    · rw [h1,h]
    · rw [h2,h,h]

private theorem quadratic_formula (Q : QuadraticForm (ZMod 2) V)
    (hl : ∀ v, Q (act leftCycle v)=Q v)
    (hr : ∀ v, Q (act rightCycle v)=Q v) (v : V) :
    Q v=planeQ v.1*Q (nonzeroVector 0,0)+planeQ v.2*Q (0,nonzeroVector 0) := by
  have h := cross_zero Q hl v.1 v.2
  rw [QuadraticMap.polarBilin_apply_apply,QuadraticMap.polar] at h
  have he : (v.1,0)+(0,v.2)=v := by simp
  rw [he] at h
  have hv : Q v=Q (v.1,0)+Q (0,v.2) := by linear_combination h
  rw [hv,(axis_values Q hl hr).1,(axis_values Q hl hr).2]

private theorem quadratic_unique (Q : QuadraticForm (ZMod 2) V)
    (hl : ∀ v, Q (act leftCycle v)=Q v)
    (hr : ∀ v, Q (act rightCycle v)=Q v)
    (hnd : Q.polarBilin.Nondegenerate) : Q=q := by
  have hleft : Q (nonzeroVector 0,0)≠0 := by
    intro he
    have hz : ∀ w, Q.polarBilin (nonzeroVector 0,0) w=0 := by
      intro w
      rw [QuadraticMap.polarBilin_apply_apply,QuadraticMap.polar]
      rw [quadratic_formula Q hl hr (((nonzeroVector 0,0):V)+w),he,quadratic_formula Q hl hr w]
      simp only [he,mul_zero,zero_add,Prod.snd_add]
      ring
    have hh := hnd.1 (nonzeroVector 0,0) hz
    exact (by decide : (nonzeroVector 0,(0:Plane))≠0) hh
  have hright : Q (0,nonzeroVector 0)≠0 := by
    intro he
    have hz : ∀ w, Q.polarBilin (0,nonzeroVector 0) w=0 := by
      intro w
      rw [QuadraticMap.polarBilin_apply_apply,QuadraticMap.polar]
      rw [quadratic_formula Q hl hr (((0,nonzeroVector 0):V)+w),he,quadratic_formula Q hl hr w]
      simp only [he,mul_zero,add_zero,Prod.fst_add]
      ring
    have hh := hnd.1 (0,nonzeroVector 0) hz
    exact (by decide : ((0:Plane),nonzeroVector 0)≠0) hh
  have h1 : Q (nonzeroVector 0,0)=1 := (by decide : ∀ a : ZMod 2, a≠0→a=1) _ hleft
  have h2 : Q (0,nonzeroVector 0)=1 := (by decide : ∀ a : ZMod 2, a≠0→a=1) _ hright
  ext v
  rw [quadratic_formula Q hl hr,h1,h2,mul_one,mul_one,q_split]
end BinaryFourPlus

namespace BinaryFourPlus
/-- The original quadratic form is fixed by the literal cubic base, so
nondegeneracy identifies it with the standard plus form. -/
public theorem eq_q_of_threeCore_invariant (Q : QuadraticForm (ZMod 2) V)
    (hQ : ∀ a∈pCore 3 Wreath, ∀ v, Q ((wreathToIsometry a).val v)=Q v)
    (hnd : Q.polarBilin.Nondegenerate) : Q=q := by
  apply quadratic_unique Q
  · exact hQ leftCycle (cube_mem_core _ (by decide +kernel))
  · exact hQ rightCycle (cube_mem_core _ (by decide +kernel))
  · exact hnd
end BinaryFourPlus
