module
public import Theory.LinearAlgebra.QuadraticForm.BinaryFourPlus.SingularInvolutionPairs
public import Mathlib.GroupTheory.NoncommCoprod
public import Mathlib.Tactic

/-!
# The factor-sign character of the binary orthogonal square

The product of the two S3 signs is invariant under exchanging the two
anisotropic planes. Its kernel is the embedded S3 × S3 generated by the
balanced cubic rotations and the two simultaneous reflections. An involution
outside this kernel preserves the two planes. The finite checks use the
literal 72-element wreath action.

Source: Aschbacher--Smith 2.4.29, printed p.546. This character identifies
I S inside the full square action; it is distinct from the factor-swap map.
-/
public section
namespace BinaryFourPlus
private instance : DecidableEq Wreath := (RegularWreathProduct.equivProd (Equiv.Perm (Fin 3)) C2).injective.decidableEq
private instance : Fintype Wreath := Fintype.ofEquiv _ (RegularWreathProduct.equivProd (Equiv.Perm (Fin 3)) C2).symm

@[expose] def factorSign : Wreath →* Units ℤ where
  toFun w := Equiv.Perm.sign (w.left 1) * Equiv.Perm.sign (w.left swapIndex)
  map_one' := by decide +kernel
  map_mul' := by decide +kernel

@[expose] def balancedRotation (side : Bool) : Wreath :=
  ⟨fun i => if i=1 then Equiv.swap 0 1 * Equiv.swap 1 2
    else if side then (Equiv.swap 0 1 * Equiv.swap 1 2)⁻¹
    else Equiv.swap 0 1 * Equiv.swap 1 2,1⟩
@[expose] def balancedFlip (side : Bool) : Wreath :=
  ⟨fun _ => if side then 1 else Equiv.swap 1 2,swapIndex⟩
@[expose] def balancedFactor (side : Bool) : Equiv.Perm (Fin 3) →* Wreath where
  toFun p := balancedRotation side ^ (p 0).val * (if Equiv.Perm.sign p=1 then 1 else balancedFlip side)
  map_one' := by cases side <;> decide +kernel
  map_mul' := by cases side <;> decide +kernel
theorem balancedFactor_commute (a b : Equiv.Perm (Fin 3)) :
    Commute (balancedFactor false a) (balancedFactor true b) := by
  change balancedFactor false a * balancedFactor true b = balancedFactor true b * balancedFactor false a
  revert a b
  decide +kernel
@[expose] def balancedProduct : Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3) →* Wreath :=
  MonoidHom.noncommCoprod (balancedFactor false) (balancedFactor true) balancedFactor_commute

theorem balancedProduct_injective : Function.Injective balancedProduct := by decide +kernel

@[simp] theorem factorSign_apply (w : Wreath) :
    factorSign w = Equiv.Perm.sign (w.left 1) * Equiv.Perm.sign (w.left swapIndex) := by rfl

theorem balancedProduct_range : balancedProduct.range = factorSign.ker := by
  ext w
  change (∃ p, balancedProduct p = w) ↔ factorSign w = 1
  have h : ∀ w : Wreath, (∃ p, balancedProduct p = w) ↔ factorSign w = 1 := by
    decide +kernel
  exact h w

theorem factorSign_odd_involution_preserves_factors (w : Wreath)
    (hs : factorSign w ≠ 1) (h2 : w^2 = 1) : w.right = 1 := by
  have h : ∀ w : Wreath, factorSign w ≠ 1 → w^2=1 → w.right=1 := by decide +kernel
  exact h w hs h2
end BinaryFourPlus
