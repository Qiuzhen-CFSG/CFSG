module

public import Mathlib.Data.ZMod.Basic
public import Mathlib.LinearAlgebra.Quotient.Bilinear
public import Mathlib.LinearAlgebra.BilinearForm.Orthogonal
public import Mathlib.LinearAlgebra.Dual.Lemmas
public import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas
public import Mathlib.Tactic

/-!
# Independence of the three radicals of a binary alternating pencil

In dimension five, two alternating forms with disjoint one-dimensional
radicals, whose sum also has a one-dimensional radical, have a radical span
of dimension at least three.

If the third radical lay in the plane generated by the first two, its nonzero
vector would be a sum `r + s` of nonzero radical vectors. The common functional
`B s = C r` cuts out a hyperplane. Both forms descend there through the radical
plane to a binary plane. An alternating form on a plane is determined by one
value, so one of the three restrictions vanishes. The resulting isotropic
hyperplane contradicts the one-dimensional radical bound.

Source: MacWilliams, Trans. AMS 150 (1970), §4; JT 1.4(c), p.386.
-/

namespace BinaryAlternatingPencil
open Module

private theorem alt_zero_of_finrank_two {H : Type*} [AddCommGroup H] [Module (ZMod 2) H]
    [FiniteDimensional (ZMod 2) H] (hH : finrank (ZMod 2) H = 2)
    (B : LinearMap.BilinForm (ZMod 2) H) (hB : B.IsAlt)
    (hq : B (Module.finBasisOfFinrankEq (ZMod 2) H hH 0)
      (Module.finBasisOfFinrankEq (ZMod 2) H hH 1) = 0) : B = 0 := by
  let e := Module.finBasisOfFinrankEq (ZMod 2) H hH
  apply LinearMap.BilinForm.ext_iff.mpr
  intro x y
  rw [← e.sum_repr x, ← e.sum_repr y]
  simp only [map_sum, LinearMap.sum_apply]
  rw [Fin.sum_univ_two, Fin.sum_univ_two]
  have hq' : B (e 0) (e 1) = 0 := hq
  have hq'' : B (e 1) (e 0) = 0 := by
    rw [← neg_eq_zero, ← hB.neg_eq]
    simp [hq']
  simp [e, hB.self_eq_zero, hq', hq'']

private theorem one_zero_common {H : Type*} [AddCommGroup H] [Module (ZMod 2) H]
    [FiniteDimensional (ZMod 2) H] (hH : finrank (ZMod 2) H = 4)
    (U : Submodule (ZMod 2) H) (hU : finrank (ZMod 2) U = 2)
    (B₁ B₂ B₃ : LinearMap.BilinForm (ZMod 2) H)
    (h₁ : U ≤ B₁.ker) (h₂ : U ≤ B₂.ker) (h₃ : U ≤ B₃.ker)
    (h₁' : U ≤ B₁.flip.ker) (h₂' : U ≤ B₂.flip.ker) (h₃' : U ≤ B₃.flip.ker)
    (hsum : B₃ = B₁ + B₂) (ha₁ : B₁.IsAlt) (ha₂ : B₂.IsAlt) (ha₃ : B₃.IsAlt) :
    B₁ = 0 ∨ B₂ = 0 ∨ B₃ = 0 := by
  let Q := H ⧸ U
  have hQ : finrank (ZMod 2) Q = 2 := by
    dsimp [Q]
    have hd := Submodule.finrank_quotient_add_finrank U
    rw [hH, hU] at hd
    omega
  let C₁ := LinearMap.liftQ₂ U U B₁ h₁ h₁'
  let C₂ := LinearMap.liftQ₂ U U B₂ h₂ h₂'
  let C₃ := LinearMap.liftQ₂ U U B₃ h₃ h₃'
  have hc₁ : C₁.IsAlt := by
    intro x
    refine Submodule.Quotient.induction_on U x ?_
    intro x
    exact LinearMap.liftQ₂_mk h₁ h₁' x x ▸ ha₁.self_eq_zero x
  have hc₂ : C₂.IsAlt := by
    intro x
    refine Submodule.Quotient.induction_on U x ?_
    intro x
    exact LinearMap.liftQ₂_mk h₂ h₂' x x ▸ ha₂.self_eq_zero x
  have hc₃ : C₃.IsAlt := by
    intro x
    refine Submodule.Quotient.induction_on U x ?_
    intro x
    exact LinearMap.liftQ₂_mk h₃ h₃' x x ▸ ha₃.self_eq_zero x
  let e := Module.finBasisOfFinrankEq (ZMod 2) Q hQ
  have hrel : C₃ (e 0) (e 1) = C₁ (e 0) (e 1) + C₂ (e 0) (e 1) := by
    obtain ⟨x, hx⟩ := (Submodule.Quotient.mk_surjective U) (e 0)
    obtain ⟨y, hy⟩ := (Submodule.Quotient.mk_surjective U) (e 1)
    rw [← hx, ← hy]
    change B₃ x y = B₁ x y + B₂ x y
    exact congrArg (fun B => B x y) hsum
  have lift_zero₁ (hz : C₁ = 0) : B₁ = 0 := by
    apply LinearMap.BilinForm.ext_iff.mpr
    intro x y
    have hz' := congrArg (fun C => C (Submodule.Quotient.mk x) (Submodule.Quotient.mk y)) hz
    change C₁ (Submodule.Quotient.mk x) (Submodule.Quotient.mk y) = 0 at hz'
    exact hz'
  have lift_zero₂ (hz : C₂ = 0) : B₂ = 0 := by
    apply LinearMap.BilinForm.ext_iff.mpr
    intro x y
    have hz' := congrArg (fun C => C (Submodule.Quotient.mk x) (Submodule.Quotient.mk y)) hz
    change C₂ (Submodule.Quotient.mk x) (Submodule.Quotient.mk y) = 0 at hz'
    exact hz'
  have lift_zero₃ (hz : C₃ = 0) : B₃ = 0 := by
    apply LinearMap.BilinForm.ext_iff.mpr
    intro x y
    have hz' := congrArg (fun C => C (Submodule.Quotient.mk x) (Submodule.Quotient.mk y)) hz
    change C₃ (Submodule.Quotient.mk x) (Submodule.Quotient.mk y) = 0 at hz'
    exact hz'
  let a₁ := C₁ (e 0) (e 1)
  let a₂ := C₂ (e 0) (e 1)
  have hac : C₃ (e 0) (e 1) = a₁ + a₂ := by exact hrel
  have hcases : a₁ = 0 ∨ a₂ = 0 ∨ a₁ + a₂ = 0 :=
    (by decide : ∀ x y : ZMod 2, x = 0 ∨ y = 0 ∨ x + y = 0) a₁ a₂
  rcases hcases with h | h | h
  · exact Or.inl (lift_zero₁ (alt_zero_of_finrank_two hQ C₁ hc₁ h))
  · exact Or.inr (Or.inl (lift_zero₂ (alt_zero_of_finrank_two hQ C₂ hc₂ h)))
  · exact Or.inr (Or.inr (lift_zero₃ (alt_zero_of_finrank_two hQ C₃ hc₃ (hac.trans h))))

private theorem isotropic_finrank_bound {V : Type*} [AddCommGroup V]
    [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (B : LinearMap.BilinForm (ZMod 2) V) (H : Submodule (ZMod 2) V)
    (h : ∀ x ∈ H, ∀ y ∈ H, B x y = 0) :
    2 * finrank (ZMod 2) H ≤ finrank (ZMod 2) V + finrank (ZMod 2) B.ker := by
  have hle : H ≤ B.orthogonal H := by
    intro y hy x hx
    exact h x hx y hy
  have hd := LinearMap.BilinForm.finrank_add_finrank_orthogonal' (B := B) H
  have h₁ := Submodule.finrank_mono hle
  have h₂ := Submodule.finrank_mono (inf_le_right : H ⊓ B.ker ≤ B.ker)
  omega

private theorem radical_sum_ne_zero {V : Type*} [AddCommGroup V]
    [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (hV : finrank (ZMod 2) V = 5)
    (B C : LinearMap.BilinForm (ZMod 2) V) (hB : B.IsAlt) (hC : C.IsAlt)
    (hdB : finrank (ZMod 2) B.ker = 1)
    (hdC : finrank (ZMod 2) C.ker = 1)
    (hdBC : finrank (ZMod 2) (B+C).ker = 1)
    (hsep : Disjoint B.ker C.ker)
    (r s : V) (hr : r ∈ B.ker) (hs : s ∈ C.ker) (hrn : r ≠ 0) (hsn : s ≠ 0) :
    r + s ∉ (B+C).ker := by
  intro hsum
  have hr0 : B r = 0 := hr
  have hs0 : C s = 0 := hs
  have heq : C r = B s := by
    ext x
    have hh := LinearMap.congr_fun (show (B+C) (r+s) = 0 from hsum) x
    simp only [map_add, LinearMap.add_apply, hr0, hs0, LinearMap.zero_apply,
      zero_add, add_zero] at hh
    simpa only [ZMod.neg_eq_self_mod_two] using eq_neg_of_add_eq_zero_left hh
  have hn : B s ≠ 0 := by
    intro hz
    apply hsn
    exact (Submodule.disjoint_def.mp hsep) s hz hs
  let H := (B s).ker
  have hdH : finrank (ZMod 2) H = 4 := by
    have hh := Module.Dual.finrank_ker_add_one_of_ne_zero hn
    dsimp [H]
    omega
  let U := B.ker ⊔ C.ker
  have hdU : finrank (ZMod 2) U = 2 := by
    have hh := Submodule.finrank_sup_add_finrank_inf_eq B.ker C.ker
    rw [hsep.eq_bot, finrank_bot, hdB, hdC] at hh
    dsimp [U]
    omega
  have hBr : B.ker = Submodule.span (ZMod 2) {r} :=
    eq_span_singleton_of_mem_of_finrank_eq_one hdB hr hrn
  have hCs : C.ker = Submodule.span (ZMod 2) {s} :=
    eq_span_singleton_of_mem_of_finrank_eq_one hdC hs hsn
  have hrH : r ∈ H := by
    change B s r = 0
    exact hB.isRefl r s (by simp [hr0])
  have hsH : s ∈ H := hB s
  have hUH : U ≤ H := by
    rw [show U = B.ker ⊔ C.ker from rfl, hBr, hCs]
    exact sup_le ((Submodule.span_le.mpr ∘ Set.singleton_subset_iff.mpr) hrH)
      ((Submodule.span_le.mpr ∘ Set.singleton_subset_iff.mpr) hsH)
  let P := U.comap H.subtype
  have hdP : finrank (ZMod 2) P = 2 :=
    (Submodule.comapSubtypeEquivOfLe hUH).finrank_eq.trans hdU
  have hUP (D : LinearMap.BilinForm (ZMod 2) V)
      (hDr : ∀ y ∈ H, D r y = 0) (hDs : ∀ y ∈ H, D s y = 0) :
      P ≤ (D.restrict H).ker := by
    intro x hx
    ext y
    have hle : U ≤ (D.flip y).ker := by
      rw [show U = B.ker ⊔ C.ker from rfl, hBr, hCs]
      exact sup_le ((Submodule.span_le.mpr ∘ Set.singleton_subset_iff.mpr) (hDr y y.property))
        ((Submodule.span_le.mpr ∘ Set.singleton_subset_iff.mpr) (hDs y y.property))
    exact hle hx
  have hPB : P ≤ (B.restrict H).ker := hUP B (by simp [hr0]) (fun _ hy => hy)
  have hPC : P ≤ (C.restrict H).ker := hUP C (by intro y hy; rw [heq]; exact hy)
    (by simp [hs0])
  have hPBC : P ≤ ((B+C).restrict H).ker := by
    intro x hx
    ext y
    change B x y + C x y = 0
    have hb' : B x y = 0 := LinearMap.congr_fun (hPB hx) y
    have hc' : C x y = 0 := LinearMap.congr_fun (hPC hx) y
    rw [hb', hc', add_zero]
  have hb : (B.restrict H).IsAlt := fun x => hB x
  have hc : (C.restrict H).IsAlt := fun x => hC x
  have hbc : ((B+C).restrict H).IsAlt := fun x => (hB.add hC) x
  have hnzero (D : LinearMap.BilinForm (ZMod 2) V)
      (hd : finrank (ZMod 2) D.ker = 1) : D.restrict H ≠ 0 := by
    intro hz
    have hh := isotropic_finrank_bound D H (by
      intro x hx y hy
      exact congrArg (fun E : LinearMap.BilinForm (ZMod 2) H => E ⟨x,hx⟩ ⟨y,hy⟩) hz)
    rw [hdH, hV, hd] at hh
    omega
  have hone := one_zero_common hdH P hdP (B.restrict H) (C.restrict H)
    ((B+C).restrict H) hPB hPC hPBC
    (hb.isRefl.ker_flip ▸ hPB) (hc.isRefl.ker_flip ▸ hPC) (hbc.isRefl.ker_flip ▸ hPBC)
    (by ext x y; rfl) hb hc hbc
  exact hone.elim (hnzero B hdB) (fun h => h.elim (hnzero C hdC) (hnzero (B+C) hdBC))

/-- The three line radicals of a separating binary alternating pencil in dimension five
span at least three dimensions. -/
public theorem three_le_finrank_radical_span {V : Type*} [AddCommGroup V]
    [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (hV : finrank (ZMod 2) V = 5)
    (B C : LinearMap.BilinForm (ZMod 2) V) (hB : B.IsAlt) (hC : C.IsAlt)
    (hdB : finrank (ZMod 2) B.ker = 1)
    (hdC : finrank (ZMod 2) C.ker = 1)
    (hdBC : finrank (ZMod 2) (B+C).ker = 1)
    (hsep : Disjoint B.ker C.ker) :
    3 ≤ finrank (ZMod 2) (B.ker ⊔ C.ker ⊔ (B+C).ker : Submodule (ZMod 2) V) := by
  have hdU : finrank (ZMod 2) (B.ker ⊔ C.ker : Submodule (ZMod 2) V) = 2 := by
    have hh := Submodule.finrank_sup_add_finrank_inf_eq B.ker C.ker
    rw [hsep.eq_bot, finrank_bot, hdB, hdC] at hh
    omega
  have hn : ¬ (B+C).ker ≤ B.ker ⊔ C.ker := by
    intro hle
    have hnker : (B+C).ker ≠ ⊥ := by
      intro hh
      rw [hh, finrank_bot] at hdBC
      omega
    obtain ⟨t, ht, htn⟩ := (B+C).ker.ne_bot_iff.mp hnker
    obtain ⟨r, hr, s, hs, hrs⟩ := Submodule.mem_sup.mp (hle ht)
    have hsum : r+s ∈ (B+C).ker := hrs ▸ ht
    have hrn : r ≠ 0 := by
      intro hz
      subst r
      have hs' : s = t := by simpa using hrs
      have hBt : B t = 0 := by
        have hCt : C t = 0 := hs' ▸ hs
        have hh : B t + C t = 0 := ht
        simpa [hCt] using hh
      exact htn ((Submodule.disjoint_def.mp hsep) t hBt (hs' ▸ hs))
    have hsn : s ≠ 0 := by
      intro hz
      subst s
      have hr' : r = t := by simpa using hrs
      have hCt : C t = 0 := by
        have hBt : B t = 0 := hr' ▸ hr
        have hh : B t + C t = 0 := ht
        simpa [hBt] using hh
      exact htn ((Submodule.disjoint_def.mp hsep) t (hr' ▸ hr) hCt)
    exact radical_sum_ne_zero hV B C hB hC hdB hdC hdBC hsep r s hr hs hrn hsn hsum
  have hlt : B.ker ⊔ C.ker < B.ker ⊔ C.ker ⊔ (B+C).ker :=
    left_lt_sup.mpr hn
  have hh := Submodule.finrank_lt_finrank_of_lt hlt
  omega

end BinaryAlternatingPencil
