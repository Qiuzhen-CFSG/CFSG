/-!
# Minimal coprime actions with cyclic center

For a nonabelian group in a faithful minimal coprime action, the image of
its center in the abelianization is fixed. The whole abelianization is
generated by action commutators, so the coprime fixed-point decomposition
kills that image. Thus the center equals the derived subgroup. The elementary
central quotient forces every commutator to have order dividing q; cyclicity
then forces the nontrivial center to have order q.

The resulting extraspecial group's commutator pairing on its central quotient
is a nondegenerate alternating form over `ZMod q`. Even dimension gives order
`q ^ (2 * n + 1)`. Combined with the existing fixed-center theorem, this proves
the structural alternative on the odd-prime domain needed by the representation
consumer. That consumer supplies cyclicity from its faithful irreducible module.

Source: Aschbacher, *Finite Group Theory*, second edition, Exercise 8.10,
printed p.116 (PDF p.126), and its application in 36.2, printed p.194.
The exercise's group-only conclusion is special; the cyclic-center input here
retains the additional information supplied by its representation hypothesis.
-/

open Subgroup
open scoped IsMulCommutative commutatorElement
namespace Representation.PrimeFixedPointCentralization

private theorem center_le_commutator_of_minimal_action {P A : Type*} [Group P] [Finite P] [Group A] [Finite A] [Nontrivial A]
    (φ : A →* MulAut P) (hφ : Function.Injective φ)
    (hmin : IsMinimalAction φ) (hcop : (Nat.card A).Coprime (Nat.card P))
    (hproper : center P ≠ ⊤) : center P ≤ _root_.commutator P := by
  let D := _root_.commutator P
  let π := QuotientGroup.mk' D
  let B := P ⧸ D
  let : IsMulCommutative B := Normal.quotient_commutative_iff_commutator_le.mpr le_rfl
  let ψ : A →* MulAut B := (quotientAut D).comp φ
  let _ := MulDistribMulAction.compHom P φ
  let _ := MulDistribMulAction.compHom B ψ
  have hfull := commutatorAction_eq_top_of_minimal_action φ hφ hmin hcop
  have hle : commutatorAction A P ≤ (commutatorAction A B).comap π := by
    rw [commutatorAction_eq_closure, closure_le]
    rintro z ⟨a, x, rfl⟩
    change π (x⁻¹ * φ a x) ∈ commutatorAction A B
    rw [map_mul, map_inv]
    have he : π (φ a x) = ψ a (π x) := (quotientAut_apply_mk D (φ a) x).symm
    rw [he, commutatorAction_eq_closure]
    exact subset_closure ⟨a, π x, rfl⟩
  have hfullB : commutatorAction A B = ⊤ := by
    apply top_unique
    intro x _
    obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective D x
    exact hle (hfull.symm ▸ mem_top y)
  have hsplit := isCompl_fixedPointSubgroup_commutatorAction_of_solvable_coprime_of_isMulCommutative
    (G := B) (A := A) (Group.isSolvable_of_comm fun x y => mul_comm x y)
    (hcop.of_dvd_right (card_quotient_dvd_card (s := D))) inferInstance
  intro z hz
  apply (QuotientGroup.eq_one_iff (N := D) z).mp
  apply hsplit.disjoint.le_bot
  refine ⟨?_, hfullB.symm ▸ mem_top (π z)⟩
  intro a
  change ψ a (π z) = π z
  change quotientAut D (φ a) (π z) = π z
  rw [quotientAut_apply_mk]
  exact congrArg π (hmin (center P)
    (fun b x hx => characteristic_iff_le_comap.mp inferInstance (φ b) hx)
    hproper a z hz)


private def centralCommutatorHom {P : Type*} [Group P]
    (hc : _root_.commutator P ≤ center P) (x : P) : P →* center P where
  toFun y := ⟨⁅x,y⁆, hc (commutator_mem_commutator (mem_top x) (mem_top y))⟩
  map_one' := by apply Subtype.ext; simp
  map_mul' a b := by
    apply Subtype.ext
    change ⁅x,a*b⁆ = ⁅x,a⁆ * ⁅x,b⁆
    rw [commutatorElement_mul_right_eq_mul_conj,
      mul_assoc ⁅x,a⁆ a ⁅x,b⁆,
      mem_center_iff.mp (hc (commutator_mem_commutator (mem_top x) (mem_top b))) a]
    simp only [← mul_assoc, mul_inv_cancel_right]

private theorem commutator_pow_eq_one {q : ℕ} {P : Type*} [Group P]
    (hq : IsElementaryAbelian q (P ⧸ center P)) (x y : P) : ⁅x,y⁆ ^ q = 1 := by
  let _ := hq
  have hc : _root_.commutator P ≤ center P :=
    Normal.quotient_commutative_iff_commutator_le.mp inferInstance
  have hy : y ^ q ∈ center P := by
    apply (QuotientGroup.eq_one_iff (N := center P) _).mp
    exact Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
      (IsElementaryAbelian.exponent_dvd_p q (P ⧸ center P)) (QuotientGroup.mk' (center P) y)
  have he := congrArg Subtype.val (map_pow (centralCommutatorHom hc x) y q)
  change ⁅x, y ^ q⁆ = ⁅x, y⁆ ^ q at he
  rw [← he]
  exact commutatorElement_eq_one_iff_mul_comm.mpr (mem_center_iff.mp hy x)

private theorem center_card_eq_prime {q : ℕ} [Fact q.Prime]
    {P : Type*} [Group P] [Finite P] [IsCyclic (center P)]
    (hq : IsElementaryAbelian q (P ⧸ center P))
    (heq : center P = _root_.commutator P) (hne : center P ≠ ⊤) :
    Nat.card (center P) = q := by
  let power : center P →* center P := powMonoidHom q
  let K : Subgroup P := power.ker.map (center P).subtype
  have hle : _root_.commutator P ≤ K := by
    apply commutator_le.mpr
    intro x _ y _
    refine ⟨⟨⁅x,y⁆, heq.symm ▸ commutator_mem_commutator (mem_top x) (mem_top y)⟩, ?_, rfl⟩
    change (⟨⁅x,y⁆, _⟩ : center P) ^ q = 1
    exact Subtype.ext (commutator_pow_eq_one hq x y)
  have hexp : Monoid.exponent (center P) ∣ q := by
    apply Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr
    intro z
    obtain ⟨w, hw, he⟩ := hle (heq.le z.property)
    have he' : w = z := Subtype.ext he
    subst w
    exact hw
  rw [IsCyclic.exponent_eq_card] at hexp
  rcases (Nat.dvd_prime (Fact.out : q.Prime)).mp hexp with h | h
  · have hbot : center P = ⊥ := card_eq_one.mp h
    exact (hne ((commutator_eq_bot_iff_center_eq_top P).mp (heq.symm.trans hbot))).elim
  · exact h


private theorem extraspecial_order {q : ℕ} [Fact q.Prime]
    {P : Type*} [Group P] [Finite P] [IsExtraspecial q P] :
    ∃ n : ℕ, Nat.card P = q ^ (2 * n + 1) := by
  classical
  let V := P ⧸ center P
  let π := QuotientGroup.mk' (center P)
  let _ : IsElementaryAbelian q V := IsExtraspecial.quotient_elementary_abelian q P
  have hc : _root_.commutator P ≤ center P :=
    Normal.quotient_commutative_iff_commutator_le.mp inferInstance
  let e : center P ≃* Multiplicative (ZMod q) := by
    have hcard := IsExtraspecial.center_order_p q P
    exact (zmodCyclicMulEquiv (isCyclic_of_prime_card hcard)).symm.trans
      (ZMod.ringEquivCongr hcard).toAddEquiv.toMultiplicative
  have hkill (x : P) : center P ≤ (centralCommutatorHom hc x).ker := by
    intro z hz
    apply Subtype.ext
    exact commutatorElement_eq_one_iff_mul_comm.mpr (mem_center_iff.mp hz x)
  let pairing : P →* (V →* center P) := {
    toFun x := QuotientGroup.lift (center P) (centralCommutatorHom hc x) (hkill x)
    map_one' := by
      apply MonoidHom.ext
      intro v
      obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective (center P) v
      apply Subtype.ext
      change ⁅(1 : P), y⁆ = 1
      simp
    map_mul' x y := by
      apply MonoidHom.ext
      intro v
      obtain ⟨z, rfl⟩ := QuotientGroup.mk'_surjective (center P) v
      apply Subtype.ext
      change ⁅x * y, z⁆ = ⁅x, z⁆ * ⁅y, z⁆
      rw [commutatorElement_mul_left_eq_conj_mul,
        mem_center_iff.mp (hc (commutator_mem_commutator (mem_top y) (mem_top z))) x]
      simp only [mul_inv_cancel_right]
      exact (mem_center_iff.mp
        (hc (commutator_mem_commutator (mem_top y) (mem_top z))) ⁅x, z⁆).symm }
  have hker : center P ≤ pairing.ker := by
    intro x hx
    apply MonoidHom.ext
    intro v
    obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective (center P) v
    apply Subtype.ext
    change ⁅x,y⁆ = 1
    exact commutatorElement_eq_one_iff_mul_comm.mpr (mem_center_iff.mp hx y).symm
  let qp : V →* (V →* center P) := QuotientGroup.lift (center P) pairing hker
  let F : Additive V →+ (Additive V →ₗ[ZMod q] ZMod q) := {
    toFun x := ((e.toMonoidHom.comp (qp x.toMul)).toAdditiveLeft).toZModLinearMap q
    map_zero' := by
      ext y
      change Multiplicative.toAdd (e (qp 1 y.toMul)) = 0
      simp
    map_add' x y := by
      ext z
      change Multiplicative.toAdd (e (qp (x.toMul * y.toMul) z.toMul)) =
        Multiplicative.toAdd (e (qp x.toMul z.toMul)) +
        Multiplicative.toAdd (e (qp y.toMul z.toMul))
      rw [map_mul, MonoidHom.mul_apply, map_mul]
      rfl }
  let B : LinearMap.BilinForm (ZMod q) (Additive V) := F.toZModLinearMap q
  have hB (x y : P) : B (Additive.ofMul (π x)) (Additive.ofMul (π y)) =
      Multiplicative.toAdd (e ⟨⁅x,y⁆,
        hc (commutator_mem_commutator (mem_top x) (mem_top y))⟩) := rfl
  have hzero (x y : P) : B (Additive.ofMul (π x)) (Additive.ofMul (π y)) = 0 ↔
      ⁅x,y⁆ = 1 := by
    rw [hB]
    change e ⟨⁅x,y⁆, _⟩ = 1 ↔ _
    rw [map_eq_one_iff e e.injective]
    exact Subgroup.mk_eq_one (center P)
  have hAlt : B.IsAlt := by
    intro v
    obtain ⟨x, hx⟩ := QuotientGroup.mk'_surjective (center P) v.toMul
    have hv : v = Additive.ofMul (π x) := congrArg Additive.ofMul hx.symm
    rw [hv, hzero]
    exact commutatorElement_self x
  have hLeft : B.SeparatingLeft := by
    intro v hv
    obtain ⟨x, hx⟩ := QuotientGroup.mk'_surjective (center P) v.toMul
    have hvx : v = Additive.ofMul (π x) := congrArg Additive.ofMul hx.symm
    rw [hvx]
    change π x = 1
    apply (QuotientGroup.eq_one_iff (N := center P) x).mpr
    apply mem_center_iff.mpr
    intro y
    have hh := hv (Additive.ofMul (π y))
    rw [hvx, hzero] at hh
    exact (commutatorElement_eq_one_iff_mul_comm.mp hh).symm
  have hNondeg : B.Nondegenerate :=
    ⟨hLeft, fun v hv => hLeft v (fun w => hAlt.isRefl w v (hv w))⟩
  obtain ⟨n, hn⟩ := AlternatingForm.even_finrank B hAlt hNondeg
  let : Fintype V := Fintype.ofFinite V
  have hV : Nat.card V = q ^ (2 * n) := by
    have hh := Module.natCard_eq_pow_finrank (K := ZMod q) (V := Additive V)
    simpa only [Nat.card_eq_fintype_card, Fintype.card_additive, ZMod.card, hn, two_mul] using hh
  refine ⟨n, ?_⟩
  have hh := (center P).card_mul_index
  rw [index_eq_card, IsExtraspecial.center_order_p q P] at hh
  rw [← hh, hV, pow_succ, Nat.mul_comm]


/-- The minimal odd-prime action has the abelian or extraspecial structure
once its center is cyclic. The representation theorem supplies this cyclicity
in the nonabelian case. -/
public theorem hasMinimalActionStructure_of_cyclic_center
    {q r : ℕ} [Fact q.Prime] [Fact r.Prime] (_hqodd : Odd q)
    {P A : Type*} [Group P] [Finite P] [Group A] [Finite A]
    [IsCyclic (center P)]
    (hP : IsPGroup q P) (hA : Nat.card A = r) (hqr : q ≠ r)
    (φ : A →* MulAut P) (hφ : Function.Injective φ) (hmin : IsMinimalAction φ) :
    HasMinimalActionStructure q φ := by
  by_cases hproper : center P = ⊤
  · let : IsMulCommutative P := (center_eq_top_iff (G := P)).mp hproper
    exact hasMinimalActionStructure_of_commutative hP hA hqr φ hφ hmin
  · let : Nontrivial A := Finite.one_lt_card_iff_nontrivial.mp
      (hA ▸ (Fact.out : r.Prime).one_lt)
    have hcop : (Nat.card A).Coprime (Nat.card P) := by
      obtain ⟨n, hn⟩ := hP.exists_card_eq
      rw [hA, hn]
      exact ((Nat.coprime_primes Fact.out Fact.out).mpr hqr.symm).pow_right n
    have hquot := central_quotient_elementary_of_minimal_action hP φ hφ hmin hcop
    have hderived : center P = _root_.commutator P := by
      apply le_antisymm (center_le_commutator_of_minimal_action φ hφ hmin hcop hproper)
      let _ := hquot
      exact Normal.quotient_commutative_iff_commutator_le.mp inferInstance
    let : IsExtraspecial q P := {
      center_order_p := center_card_eq_prime hquot hderived hproper
      quotient_elementary_abelian := hquot
      quotient_nontrivial := QuotientGroup.nontrivial_iff.mpr hproper }
    obtain ⟨n, hn⟩ := extraspecial_order (q := q) (P := P)
    exact Or.inr ⟨n, inferInstance, hn,
      fixed_set_eq_center_of_minimal_prime_action hP hA hqr φ hφ hmin hproper⟩

end Representation.PrimeFixedPointCentralization
