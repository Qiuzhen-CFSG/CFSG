module

public import Theory.Representation.Triality.BinaryDegree.CarrierTransport.FiniteField
public import Theory.SpecificGroups.Triality.StandardModel

/-!
# Rational root words and the literal Spin graph-field comparison

The rational simple subgroup is generated by the eight actual signed simple
Spin curves with parameters in the embedded GF(2^(3*n)). It lies in the ordinary
cubic Frobenius fixed group. A homomorphism from the finite Geck group matching
these curves has exactly this image and automatically intertwines the actual
Geck and Spin graph-field automorphisms. Generation of the finite Geck group
proves these statements from the eight root equations.

Together with the coordinate descent in `FiniteField`, rational root generation
supplies coverage of every Spin graph-field fixed point. This module does not
construct the Geck-to-Spin homomorphism or prove rational root generation; both
remain explicit in the conditional coverage theorem. No equality between the
full fixed group and its two-generated subgroup is assumed.

Sources: GLS3, Remarks 2.2.5, Theorem 2.2.6 and §2.7
(`refs/KGroup/GLS3/chapter2.tex`).
-/

@[expose] public section

noncomputable section
namespace Triality.BinaryDegree.CarrierTransport
open Triality.Standard Triality.SimplyConnected Triality.SimplyConnected.Pinning
open Theory.AlgebraicGroup.StandardRootSystem RootPairing.SimpleGeckGroup

variable {k : Type*} [Field k] [IsAlgClosed k] [CharP k 2]

/-- Words in the literal signed Spin simple roots with cubic-field parameters. -/
def rationalSimpleSubgroup {n : ℕ} {hn : 0 < n}
    (f : ExtensionField (binaryParameters n hn) →+* k) : Subgroup (Points k) :=
  Subgroup.closure
    (Set.range (fun p : Fin 4 × ExtensionField (binaryParameters n hn) =>
      positiveSimplePoint k p.1 (f p.2)) ∪
    Set.range (fun p : Fin 4 × ExtensionField (binaryParameters n hn) =>
      negativeSimplePoint k p.1 (f p.2)))

/-- Every rational root word is fixed by the ordinary cubic Frobenius. -/
theorem rationalSimpleSubgroup_le_frobeniusFixedSubgroup {n : ℕ} {hn : 0 < n}
    (f : ExtensionField (binaryParameters n hn) →+* k) :
    rationalSimpleSubgroup f ≤ frobeniusFixedSubgroup k (3 * n) := by
  apply (Subgroup.closure_le _).mpr
  rintro g (⟨⟨i, t⟩, rfl⟩ | ⟨⟨i, t⟩, rfl⟩)
  · change frobeniusPointAut k (3 * n) (positiveSimplePoint k i (f t)) = _
    rw [GraphField.frobenius_positiveSimple, (coefficient_mem_range_iff f _).mp ⟨t, rfl⟩]
  · change frobeniusPointAut k (3 * n) (negativeSimplePoint k i (f t)) = _
    rw [GraphField.frobenius_negativeSimple, (coefficient_mem_range_iff f _).mp ⟨t, rfl⟩]

/-- The actual numbered Geck curves must map to the prescribed Spin curves. -/
def HasRootFormula {n : ℕ} {hn : 0 < n}
    (f : ExtensionField (binaryParameters n hn) →+* k)
    (e : SplitGroup (binaryParameters n hn) →* Points k) : Prop :=
  (∀ i t, e (positive (typeDRootPairing_baseEquiv 2 i) t) =
    positiveSimplePoint k i (f t)) ∧
  (∀ i t, e (negative (typeDRootPairing_baseEquiv 2 i) t) =
    negativeSimplePoint k i (f t))

private theorem geck_induction (P : Parameters) {p : SplitGroup P → Prop}
    (hp : ∀ i t, p (positive (typeDRootPairing_baseEquiv 2 i) t))
    (hn : ∀ i t, p (negative (typeDRootPairing_baseEquiv 2 i) t))
    (h1 : p 1) (hm : ∀ g h, p g → p h → p (g * h))
    (hi : ∀ g, p g → p g⁻¹) (g : SplitGroup P) : p g := by
  rcases g with ⟨g, hg⟩
  induction hg using Subgroup.closure_induction with
  | mem x hx =>
      obtain ⟨⟨s, j⟩, t, rfl⟩ := hx
      obtain ⟨i, rfl⟩ := (typeDRootPairing_baseEquiv 2).surjective j
      cases s
      · exact hn i t
      · exact hp i t
  | one => exact h1
  | mul x y hx hy ihx ihy => exact hm ⟨x, hx⟩ ⟨y, hy⟩ ihx ihy
  | inv x hx ih => exact hi ⟨x, hx⟩ ih

/-- The literal root formulas identify the image with the rational root words. -/
theorem HasRootFormula.range_eq {n : ℕ} {hn : 0 < n}
    {f : ExtensionField (binaryParameters n hn) →+* k}
    {e : SplitGroup (binaryParameters n hn) →* Points k} (he : HasRootFormula f e) :
    e.range = rationalSimpleSubgroup f := by
  apply le_antisymm
  · rintro x ⟨g, rfl⟩
    apply geck_induction (binaryParameters n hn) (p := fun g => e g ∈ rationalSimpleSubgroup f)
    · intro i t
      rw [he.1]
      exact Subgroup.subset_closure (Or.inl ⟨(i, t), rfl⟩)
    · intro i t
      rw [he.2]
      exact Subgroup.subset_closure (Or.inr ⟨(i, t), rfl⟩)
    · rw [map_one]
      exact Subgroup.one_mem _
    · intro g h hg hh
      rw [map_mul]
      exact Subgroup.mul_mem _ hg hh
    · intro g hg
      rw [map_inv]
      exact Subgroup.inv_mem _ hg
  · apply (Subgroup.closure_le _).mpr
    rintro g (⟨⟨i, t⟩, rfl⟩ | ⟨⟨i, t⟩, rfl⟩)
    · exact ⟨positive (typeDRootPairing_baseEquiv 2 i) t, he.1 i t⟩
    · exact ⟨negative (typeDRootPairing_baseEquiv 2 i) t, he.2 i t⟩

/-- The signed root formulas discharge graph-then-field equivariance. -/
theorem HasRootFormula.graphField_intertwines {n : ℕ} {hn : 0 < n}
    {f : ExtensionField (binaryParameters n hn) →+* k}
    {e : SplitGroup (binaryParameters n hn) →* Points k} (he : HasRootFormula f e)
    (g : SplitGroup (binaryParameters n hn)) :
    e (graphFieldAutomorphism (binaryParameters n hn) g) = GraphField.sigma k n (e g) := by
  apply geck_induction (binaryParameters n hn)
    (p := fun x => e (graphFieldAutomorphism (binaryParameters n hn) x) =
      GraphField.sigma k n (e x))
  · intro i t
    simp only [graphFieldAutomorphism_positive, typeD4DiagramBasePermutation_numbered,
      binaryParameters_q, he.1, GraphField.sigma_apply, Diagram.pinnedAut_positiveSimple,
      GraphField.frobenius_positiveSimple, map_pow]
  · intro i t
    simp only [graphFieldAutomorphism_negative, typeD4DiagramBasePermutation_numbered,
      binaryParameters_q, he.2, GraphField.sigma_apply, Diagram.pinnedAut_negativeSimple,
      GraphField.frobenius_negativeSimple, map_pow]
  · simp only [map_one]
  · intro g h hg hh
    simp only [map_mul, hg, hh]
  · intro g hg
    simp only [map_inv, hg]

/-- Rational root generation supplies coverage of the full fixed group. -/
theorem HasRootFormula.fixed_coverage {n : ℕ} {hn : 0 < n}
    {f : ExtensionField (binaryParameters n hn) →+* k}
    {e : SplitGroup (binaryParameters n hn) →* Points k} (he : HasRootFormula f e)
    (hgen : ∀ g : Points k, (∀ i j, naturalMatrix k g i j ∈ f.range) →
      g ∈ rationalSimpleSubgroup f)
    (g : Points k) (hg : GraphField.sigma k n g = g) : ∃ x, e x = g := by
  have hmem : g ∈ rationalSimpleSubgroup f :=
    hgen g (fixed_coordinates_mem_range f ⟨g, hg⟩)
  rwa [← he.range_eq] at hmem

end Triality.BinaryDegree.CarrierTransport
