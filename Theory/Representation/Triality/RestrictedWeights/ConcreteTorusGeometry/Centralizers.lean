/-!
# Connected actual triality semisimple centralizers

Supported opposite-root representatives and the proved D4 stabilizer
factorizations put the centralizing torus normalizer in the connected subgroup
generated by the torus and its centralizing roots. Conjugacy of maximal tori
inside the closed point centralizer then proves connectedness. Actual
semisimple torus placement transports the result to odd-order fixed points.
No global Bruhat-form uniqueness premise remains.
Source: Steinberg 8.3(c), 8.5 and 12.5.
-/
public noncomputable section
namespace Triality.RestrictedWeights.Concrete.TorusGeometrySource
universe u
variable (k:Type u) [Field k] [IsAlgClosed k] [CharP k 2]
variable (hu:IsUniversalVersion (groupVariety k))

def normalizerLifts (n:ℕ) : Realization (finiteGeometry k hu) (torusData k hu n) where
  toLiftAction := liftAction_of_normalizerRealization_of_oppositeReflectionLifts
    (finiteGeometry k hu) (torusData k hu n) (normalizerRealization k hu)
    (oppositeReflectionLifts_of_normalizerRealization_of_simpleCorootWords_of_unique
      (finiteGeometry k hu) (torusData k hu n) (normalizerRealization k hu)
      (FixedOpposition.AmbientNormalizer.CorootRealization.simpleCorootWordData_of_charts
        (finiteGeometry k hu) (fun i=>Classical.choice (RankOne.simpleCharts k hu i)))
      (rootSubgroupUniqueness k hu))
  ker_le := fun g hg=>normalizerRealization_ker_le k hu g hg

theorem toral_normalizer_le (n:ℕ) (t:(finiteGeometry k hu).torus.carrierVariety.Point) :
    toralNormalizerCentralizer (finiteGeometry k hu) t ≤ toralRootSubgroup (finiteGeometry k hu) t :=
  toralNormalizerCentralizer_le_of_realization_of_reflectionGeneration (finiteGeometry k hu)
    (torusData k hu n) t (normalizerLifts k hu n)
    (Stabilizer.reflectionGeneration (finiteGeometry k hu) (torusData k hu n) t)

theorem toral_centralizer_connected (n:ℕ)
    (t:(finiteGeometry k hu).torus.carrierVariety.Point) :
    _root_.IsConnected (Subgroup.centralizer {(finiteGeometry k hu).torus.includePoint t} :
      Set (groupVariety k).Point) := by
  let S := finiteGeometry k hu
  let C := semisimpleCommutatorPointCentralizer (S.torus.includePoint t)
  let R := subgroupZariskiClosure (groupVariety k) (toralRootSubgroup S t)
  have hRC : R ≤ C := by
    change closure (toralRootSubgroup S t : Set (groupVariety k).Point) ⊆ (C:Set (groupVariety k).Point)
    exact closure_minimal (toralRootSubgroup_le_centralizer S t) (Variety.isClosed_iff_isZariskiClosed.mpr C.isZariskiClosed)
  have hconn : _root_.IsConnected (R:Set (groupVariety k).Point) :=
    (toralRootSubgroup_isConnected S t).closure
  have hRI := connected_closedSubgroup_le_identityComponentAmbient R C hconn hRC
  apply SemisimpleCentralizerTori.connected_of_normalizer_le_component C S.torus S.maximalTorus
  · exact (show S.torus.toSubgroup ≤ toralRootSubgroup S t from le_sup_left).trans
      (toralRootSubgroup_le_centralizer S t)
  · intro g hg hn
    apply hRI
    exact subset_closure (toral_normalizer_le k hu n t ⟨hn,hg⟩)

theorem fixedCentralizer_connected (n:ℕ) (hn:0<n)
    (x:graphFieldFixedSubgroup (finiteGeometry k hu).diagram.toMulEquiv
      (finiteGeometry k hu).frobenius.onPoints n) (hx:¬2∣orderOf x) :
    Variety.IsConnected (fixedCentralizer (finiteGeometry k hu) n x).carrierVariety := by
  obtain ⟨t,ht⟩ := semisimple_conjugate_geometry k (finiteGeometry k hu) x.val
    (fixed_odd_isSemisimple (finiteGeometry k hu) n hn x hx)
  apply carrier_isConnected
  exact centralizer_isConnected_of_isConj ht (toral_centralizer_connected k hu n t)
end Triality.RestrictedWeights.Concrete.TorusGeometrySource
