module

public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.AlgebraicTensor.RestrictedStep.RootDensity.NegativeCyclicityLeft.Cyclic
public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.AlgebraicTensor.RestrictedStep.RootDensity.NegativeCyclicityLeft.Conjugation.FirstCoefficient

/-!
# Normalization of the actual D4 root-operator algebra

Every element of the point group conjugates the algebra generated by the
first coefficients of the actual root curves into itself. Conjugation is an
algebra automorphism, so containment on root coefficients extends to their
generated algebra. The elements preserving this algebra in both directions
form a subgroup. It contains the torus by the raw inverse-conjugation root
character equation, and every root group by the characteristic-two
first-coefficient identities, including the opposite-root quadratic formula.
Generation by the torus and signed simple roots therefore finishes the proof.

This works for any finite-dimensional rational representation of the given
D4 geometry; no highest-weight or irreducibility hypothesis is needed.
Source: GLS3 Chapter 1, §§1.11–1.12; Steinberg, *Representations of Algebraic
Groups* (1963), §§2 and 4. This is the normalization input used in the
infinitesimal argument underlying GLS3 Theorem 2.8.5 and Corollary 2.8.6(a).
-/

open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
namespace Triality.RestrictedWeights.SteinbergTensors.AlgebraicTensor.RestrictedStep.RootDensity.NegativeCyclicityLeft
public noncomputable section
universe u v
variable {k : Type u} [Field k] [IsAlgClosed k]
variable {K : Variety k} [AlgebraicGroup K]
variable {V : Type v} [AddCommGroup V] [Module k V] [FiniteDimensional k V]

private def algebraConjugation (ρ : RationalRepresentation K V) (g : K.Point) :
    Module.End k V ≃ₐ[k] Module.End k V :=
  (ρ.action g).toLinearEquiv.conjAlgEquiv k

omit [IsAlgClosed k] [FiniteDimensional k V] in
private theorem algebraConjugation_apply (ρ : RationalRepresentation K V) (g : K.Point)
    (A : Module.End k V) :
    algebraConjugation ρ g A = (ρ.action g).val * A * (ρ.action g⁻¹).val := by
  ext w
  change (ρ.action g).val (A (((ρ.action g)⁻¹).val w)) = _
  rw [map_inv]
  rfl

omit [IsAlgClosed k] [FiniteDimensional k V] in
private theorem algebraConjugation_mul (ρ : RationalRepresentation K V) (g h : K.Point)
    (A : Module.End k V) :
    algebraConjugation ρ (g * h) A =
      algebraConjugation ρ g (algebraConjugation ρ h A) := by
  rw [algebraConjugation_apply, algebraConjugation_apply, algebraConjugation_apply]
  simp only [map_mul, Units.val_mul, mul_inv_rev, mul_assoc]

private theorem algebraConjugation_mem_of_roots (S : D4Geometry K)
    (ρ : RationalRepresentation K V) (hρ : IsRationalRepresentation ρ) (g : K.Point)
    (hg : ∀ α, (ρ.action g).val * rootOperator S ρ hρ α * (ρ.action g⁻¹).val ∈
      rootOperatorAlgebra S ρ hρ)
    {A : Module.End k V} (hA : A ∈ rootOperatorAlgebra S ρ hρ) :
    algebraConjugation ρ g A ∈ rootOperatorAlgebra S ρ hρ := by
  have h : rootOperatorAlgebra S ρ hρ ≤
      (rootOperatorAlgebra S ρ hρ).comap (algebraConjugation ρ g).toAlgHom := by
    apply Algebra.adjoin_le
    rintro _ ⟨α, rfl⟩
    change algebraConjugation ρ g (rootOperator S ρ hρ α) ∈ rootOperatorAlgebra S ρ hρ
    rw [algebraConjugation_apply]
    exact hg α
  exact h hA

private def rootAlgebraNormalizer (S : D4Geometry K) (ρ : RationalRepresentation K V)
    (hρ : IsRationalRepresentation ρ) : Subgroup K.Point where
  carrier := {g | (∀ A ∈ rootOperatorAlgebra S ρ hρ,
      algebraConjugation ρ g A ∈ rootOperatorAlgebra S ρ hρ) ∧
    ∀ A ∈ rootOperatorAlgebra S ρ hρ,
      algebraConjugation ρ g⁻¹ A ∈ rootOperatorAlgebra S ρ hρ}
  one_mem' := by
    constructor <;> intro A hA <;>
      simpa only [inv_one, algebraConjugation_apply, map_one, Units.val_one,
        one_mul, mul_one] using hA
  mul_mem' {g h} hg hh := by
    constructor
    · intro A hA
      rw [algebraConjugation_mul]
      exact hg.1 _ (hh.1 A hA)
    · intro A hA
      rw [mul_inv_rev, algebraConjugation_mul]
      exact hh.2 _ (hg.2 A hA)
  inv_mem' {g} hg := ⟨hg.2, by simpa only [inv_inv] using hg.1⟩

private theorem torus_conjugation_mem (S : D4Geometry K)
    (ρ : RationalRepresentation K V) (hρ : IsRationalRepresentation ρ)
    (g : K.Point) (hg : g ∈ S.torus.toSubgroup) (α : S.roots.Root) :
    (ρ.action g).val * rootOperator S ρ hρ α * (ρ.action g⁻¹).val ∈
      rootOperatorAlgebra S ρ hρ := by
  have hg' : g ∈ Set.range S.torus.inclusion.onPoints := by
    rw [S.torus.range_inclusion]
    exact hg
  obtain ⟨s, rfl⟩ := hg'
  have he : ∀ t, S.torus.inclusion.onPoints s * S.chevalley.x α t *
      (S.torus.inclusion.onPoints s)⁻¹ =
        S.chevalley.x α ((S.roots.rootWeight α).pointCharacter s⁻¹ * t) := by
    intro t
    have h := (S.realized.2.2.1 α).2 (S.rootParam α) t s⁻¹
    rw [S.rootParam_spec, S.rootParam_spec] at h
    change (S.torus.inclusion.onPoints s⁻¹)⁻¹ * _ * S.torus.inclusion.onPoints s⁻¹ = _ at h
    simpa only [map_inv, inv_inv] using h
  rw [rootOperator_conjugation_of_curve S ρ hρ _ α α _ he]
  exact (rootOperatorAlgebra S ρ hρ).smul_mem (Algebra.subset_adjoin ⟨α, rfl⟩) _

omit [IsAlgClosed k] in
private theorem root_inverse_normalizer [CharP k 2] (S : D4Geometry K)
    (α : S.roots.Root) (t : k) : (S.chevalley.x α t)⁻¹ = S.chevalley.x α t := by
  apply inv_eq_of_mul_eq_one_right
  rw [S.chevalley_spec.2.2.2.1, CharTwo.add_self_eq_zero]
  have h := S.chevalley_spec.2.2.2.1 α 0 0
  simpa using h

/-- Every group element conjugates every first root coefficient into the
actual root-operator algebra, for an arbitrary rational representation. -/
theorem root_conjugation_stable [CharP k 2] (S : D4Geometry K)
    (ρ : RationalRepresentation K V) (hρ : IsRationalRepresentation ρ) :
    RootConjugationStable S ρ hρ := by
  have hroot (β : S.roots.Root) (t : k) :
      S.chevalley.x β t ∈ rootAlgebraNormalizer S ρ hρ := by
    have h : ∀ A ∈ rootOperatorAlgebra S ρ hρ,
        algebraConjugation ρ (S.chevalley.x β t) A ∈ rootOperatorAlgebra S ρ hρ := by
      intro A hA
      exact algebraConjugation_mem_of_roots S ρ hρ _
        (fun α => rootOperator_conjugation_mem S ρ hρ α β t) hA
    exact ⟨h, by simpa only [root_inverse_normalizer] using h⟩
  have htop : rootAlgebraNormalizer S ρ hρ = ⊤ := by
    apply subgroup_eq_top_of_torus_and_simple_roots S
    · intro g hg
      constructor
      · intro A hA
        exact algebraConjugation_mem_of_roots S ρ hρ g
          (torus_conjugation_mem S ρ hρ g hg) hA
      · intro A hA
        exact algebraConjugation_mem_of_roots S ρ hρ g⁻¹
          (torus_conjugation_mem S ρ hρ g⁻¹ (S.torus.inv_mem hg)) hA
    · intro i t
      exact hroot (simpleRoot S i) t
    · intro i t
      exact hroot (S.roots.neg (simpleRoot S i)) t
  intro g α
  have hg : g ∈ rootAlgebraNormalizer S ρ hρ := by rw [htop]; trivial
  have h := hg.1 _ (Algebra.subset_adjoin ⟨α, rfl⟩)
  rwa [algebraConjugation_apply] at h

end
end Triality.RestrictedWeights.SteinbergTensors.AlgebraicTensor.RestrictedStep.RootDensity.NegativeCyclicityLeft
