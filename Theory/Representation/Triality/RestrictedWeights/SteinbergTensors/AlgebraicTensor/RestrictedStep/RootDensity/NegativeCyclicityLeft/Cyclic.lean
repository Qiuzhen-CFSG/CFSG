module

public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.AlgebraicTensor.RestrictedStep.RootDensity.HighestLine
public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.AlgebraicTensor.RestrictedStep.RootDensity.NegativeCyclicityLeft.Generation
/-!
# Group invariance of the root-algebra cyclic submodule

If the actual group action normalizes the algebra generated by first root
coefficients, an element preserves its cyclic submodule as soon as it sends
the initial vector into that submodule. The torus acts on the highest line,
positive simple roots fix it, and restricted negative simple strings have
only their constant and linear terms. The proved signed-simple generation
then gives group invariance; irreducibility makes the cyclic submodule full.

Normalization remains an explicit coefficient-level premise. The result does
not assert differential irreducibility or negative-word spanning.
Source: Steinberg, *Representations of Algebraic Groups* (1963), §§2 and 4;
GLS3 Theorem 2.8.5 and Corollary 2.8.6(a).
-/

open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
open D4RestrictedWeight
namespace Triality.RestrictedWeights.SteinbergTensors.AlgebraicTensor.RestrictedStep.RootDensity.NegativeCyclicityLeft
@[expose] public noncomputable section
universe u v
variable {k : Type u} [Field k] [IsAlgClosed k]
variable {K : Variety k} [AlgebraicGroup K]
variable {V : Type v} [AddCommGroup V] [Module k V] [FiniteDimensional k V]

/-- The actual group conjugates every first root coefficient into the root algebra. -/
def RootConjugationStable (S : D4Geometry K) (ρ : RationalRepresentation K V)
    (hρ : IsRationalRepresentation ρ) : Prop :=
  ∀ (g : K.Point) (α : S.roots.Root),
    (ρ.action g).val * rootOperator S ρ hρ α * (ρ.action g⁻¹).val ∈
      rootOperatorAlgebra S ρ hρ

/-- The cyclic submodule of the actual root-operator algebra. -/
def cyclicRootSpan (S : D4Geometry K) (ρ : RationalRepresentation K V)
    (hρ : IsRationalRepresentation ρ) (v : V) : Submodule k V :=
  (rootOperatorAlgebra S ρ hρ).toSubmodule.map (LinearMap.applyₗ v)

/-- The identity operator puts the initial vector in its cyclic submodule. -/
theorem mem_cyclicRootSpan (S : D4Geometry K) (ρ : RationalRepresentation K V)
    (hρ : IsRationalRepresentation ρ) (v : V) : v ∈ cyclicRootSpan S ρ hρ v :=
  Submodule.mem_map.mpr ⟨1, (rootOperatorAlgebra S ρ hρ).one_mem, rfl⟩

/-- Every element of the root algebra preserves its cyclic submodule. -/
theorem algebra_apply_mem_cyclicRootSpan (S : D4Geometry K) (ρ : RationalRepresentation K V)
    (hρ : IsRationalRepresentation ρ) (v : V) {A : Module.End k V}
    (hA : A ∈ rootOperatorAlgebra S ρ hρ) {w : V} (hw : w ∈ cyclicRootSpan S ρ hρ v) :
    A w ∈ cyclicRootSpan S ρ hρ v := by
  obtain ⟨B, hB, rfl⟩ := Submodule.mem_map.mp hw
  exact Submodule.mem_map.mpr ⟨A * B, (rootOperatorAlgebra S ρ hρ).mul_mem hA hB, rfl⟩

private def conjugation (ρ : RationalRepresentation K V) (g : K.Point) :
    Module.End k V ≃ₐ[k] Module.End k V :=
  (ρ.action g).toLinearEquiv.conjAlgEquiv k

omit [IsAlgClosed k] [FiniteDimensional k V] in
private theorem conjugation_apply (ρ : RationalRepresentation K V) (g : K.Point)
    (A : Module.End k V) : conjugation ρ g A = (ρ.action g).val * A * (ρ.action g⁻¹).val := by
  ext w
  change (ρ.action g).val (A (((ρ.action g)⁻¹).val w)) = _
  rw [map_inv]
  rfl

private theorem conjugation_mem (S : D4Geometry K) (ρ : RationalRepresentation K V)
    (hρ : IsRationalRepresentation ρ) (hnorm : RootConjugationStable S ρ hρ)
    (g : K.Point) {A : Module.End k V} (hA : A ∈ rootOperatorAlgebra S ρ hρ) :
    conjugation ρ g A ∈ rootOperatorAlgebra S ρ hρ := by
  have h : rootOperatorAlgebra S ρ hρ ≤
      (rootOperatorAlgebra S ρ hρ).comap (conjugation ρ g).toAlgHom := by
    apply Algebra.adjoin_le
    rintro _ ⟨α, rfl⟩
    change conjugation ρ g (rootOperator S ρ hρ α) ∈ rootOperatorAlgebra S ρ hρ
    rw [conjugation_apply]
    exact hnorm g α
  exact h hA

/-- Normalization propagates initial-vector membership to the entire cyclic submodule. -/
theorem action_stable_of_generator_mem (S : D4Geometry K) (ρ : RationalRepresentation K V)
    (hρ : IsRationalRepresentation ρ) (hnorm : RootConjugationStable S ρ hρ)
    (v : V) (g : K.Point) (hg : (ρ.action g).val v ∈ cyclicRootSpan S ρ hρ v) :
    ∀ w ∈ cyclicRootSpan S ρ hρ v, (ρ.action g).val w ∈ cyclicRootSpan S ρ hρ v := by
  intro w hw
  obtain ⟨A, hA, rfl⟩ := Submodule.mem_map.mp hw
  have h := algebra_apply_mem_cyclicRootSpan S ρ hρ v (conjugation_mem S ρ hρ hnorm g hA) hg
  have he : conjugation ρ g A ((ρ.action g).val v) = (ρ.action g).val (A v) := by
    change (ρ.action g).toLinearEquiv
      (A ((ρ.action g).toLinearEquiv.symm ((ρ.action g).toLinearEquiv v))) = _
    rw [LinearEquiv.symm_apply_apply]
    rfl
  rwa [he] at h

omit [IsAlgClosed k] [FiniteDimensional k V] in
private def actionStabilizer (ρ : RationalRepresentation K V) (U : Submodule k V) :
    Subgroup K.Point where
  carrier := {g | (∀ w ∈ U, (ρ.action g).val w ∈ U) ∧
    ∀ w ∈ U, (ρ.action g⁻¹).val w ∈ U}
  one_mem' := by constructor <;> intro w hw <;> simpa using hw
  mul_mem' {g h} hg hh := by
    constructor
    · intro w hw
      simpa only [map_mul, Units.val_mul, Module.End.mul_apply] using hg.1 _ (hh.1 _ hw)
    · intro w hw
      simpa only [mul_inv_rev, map_mul, Units.val_mul, Module.End.mul_apply] using hh.2 _ (hg.2 _ hw)
  inv_mem' {g} hg := by
    exact ⟨hg.2, by simpa only [inv_inv] using hg.1⟩

omit [IsAlgClosed k] in
private theorem root_inv [CharP k 2] (S : D4Geometry K) (α : S.roots.Root) (t : k) :
    (S.chevalley.x α t)⁻¹ = S.chevalley.x α t := by
  apply inv_eq_of_mul_eq_one_right
  rw [S.chevalley_spec.2.2.2.1, CharTwo.add_self_eq_zero, ← rootMorphism_apply]
  have hzero : kPlusPoint (0 : k) = 1 := by
    apply (additiveGroupPointEquiv k).injective
    rfl
  rw [hzero, map_one]

/-- Normalization and the restricted simple strings make the root-algebra
cyclic submodule invariant under the actual point group, hence all of V. -/
theorem cyclicRootSpan_eq_top_of_conjugation [CharP k 2] (S : D4Geometry K)
    (ρ : RationalRepresentation K V) (hρ : IsIrreducibleRepresentation ρ)
    {a : BasicWeight} {v : V}
    (hv : HasHighWeight ρ S.borel S.torus v (S.leftWeightEmbedding (coefficient a)))
    (hnorm : RootConjugationStable S ρ hρ.1) :
    cyclicRootSpan S ρ hρ.1 v = ⊤ := by
  let U := cyclicRootSpan S ρ hρ.1 v
  have hvU : v ∈ U := mem_cyclicRootSpan S ρ hρ.1 v
  have hpos (i : Fin 4) (t : k) :
      (ρ.action (S.chevalley.x (simpleRoot S i) t)).val v ∈ U := by
    rw [positive_root_fixed_of_highWeight S ρ hρ.1 hv _ (simpleRoot_positive S i)]
    exact hvU
  have hneg (i : Fin 4) (t : k) :
      (ρ.action (S.chevalley.x (S.roots.neg (simpleRoot S i)) t)).val v ∈ U := by
    rw [simpleRoot, negative_simple_action_of_left_basic S ρ hρ.1 hv i t]
    apply U.add_mem hvU
    apply U.smul_mem
    exact algebra_apply_mem_cyclicRootSpan S ρ hρ.1 v (Algebra.subset_adjoin ⟨_, rfl⟩) hvU
  have htop : actionStabilizer ρ U = ⊤ := by
    apply subgroup_eq_top_of_torus_and_simple_roots S
    · intro g hg
      have hT (x : K.Point) (hx : x ∈ S.torus.toSubgroup) : (ρ.action x).val v ∈ U := by
        obtain ⟨c, hc⟩ := hv.1.2 x (S.bigCell.torus_le_positive hx)
        rw [hc]
        exact U.smul_mem c hvU
      exact ⟨action_stable_of_generator_mem S ρ hρ.1 hnorm v g (hT g hg),
        action_stable_of_generator_mem S ρ hρ.1 hnorm v g⁻¹ (hT g⁻¹ (S.torus.inv_mem hg))⟩
    · intro i t
      constructor
      · exact action_stable_of_generator_mem S ρ hρ.1 hnorm v _ (hpos i t)
      · rw [root_inv]
        exact action_stable_of_generator_mem S ρ hρ.1 hnorm v _ (hpos i t)
    · intro i t
      constructor
      · exact action_stable_of_generator_mem S ρ hρ.1 hnorm v _ (hneg i t)
      · rw [root_inv]
        exact action_stable_of_generator_mem S ρ hρ.1 hnorm v _ (hneg i t)
  have hU : IsInvariantSubmodule ρ U := by
    intro g w hw
    have hg : g ∈ actionStabilizer ρ U := by rw [htop]; trivial
    exact hg.1 w hw
  rcases hρ.2 U hU with hbot | htop
  · exact (hv.1.1 (by simpa only [hbot, Submodule.mem_bot] using hvU)).elim
  · exact htop

/-- Root-operator invariance extends to the algebra they generate. -/
theorem algebra_apply_mem_of_rootInvariant (S : D4Geometry K)
    (ρ : RationalRepresentation K V) (hρ : IsRationalRepresentation ρ)
    (U : Submodule k V) (hU : IsRootOperatorInvariant S ρ hρ U)
    {A : Module.End k V} (hA : A ∈ rootOperatorAlgebra S ρ hρ) :
    ∀ w ∈ U, A w ∈ U := by
  induction hA using Algebra.adjoin_induction with
  | mem A hA =>
    obtain ⟨α, rfl⟩ := hA
    exact hU α
  | algebraMap c =>
    intro w hw
    exact U.smul_mem c hw
  | add A B hA hB ihA ihB =>
    intro w hw
    exact U.add_mem (ihA w hw) (ihB w hw)
  | mul A B hA hB ihA ihB =>
    intro w hw
    exact ihA _ (ihB w hw)

/-- The cyclic root algebra is contained in any root-invariant subspace
containing its initial vector. -/
theorem cyclicRootSpan_le (S : D4Geometry K) (ρ : RationalRepresentation K V)
    (hρ : IsRationalRepresentation ρ) (v : V) (U : Submodule k V)
    (hU : IsRootOperatorInvariant S ρ hρ U) (hv : v ∈ U) :
    cyclicRootSpan S ρ hρ v ≤ U := by
  intro w hw
  obtain ⟨A, hA, rfl⟩ := Submodule.mem_map.mp hw
  exact algebra_apply_mem_of_rootInvariant S ρ hρ U hU hA v hv
end
end Triality.RestrictedWeights.SteinbergTensors.AlgebraicTensor.RestrictedStep.RootDensity.NegativeCyclicityLeft
