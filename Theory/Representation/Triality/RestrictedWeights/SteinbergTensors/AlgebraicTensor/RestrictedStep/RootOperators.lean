module

public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.AlgebraicTensor.Geometry
public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.AlgebraicTensor.RestrictedStep.Coefficients

/-!
# Actual pinned root operators on a rational D4 module

The regular pinned root parametrizations and rational action give degree-one
coefficient endomorphisms. Their generated algebra is the common interface
between restricted highest-weight theory and Frobenius tensor separation.
The ordinary-Frobenius root formula identifies the tensor root operators
with the original operators acting on the left tensor factor alone.

This supplies the geometric coefficient step toward GLS3, Theorem 2.8.5 and
Corollary 2.8.6(a) / [St2, Theorem 13.1]. No density assertion is included.
-/

@[expose] public noncomputable section

open Theory.AlgebraicGroup
open scoped TensorProduct
namespace Triality.RestrictedWeights.SteinbergTensors.AlgebraicTensor.RestrictedStep
universe u v w
variable {k : Type u} [Field k] [IsAlgClosed k]
variable {K : Variety k} [AlgebraicGroup K]

/-- The actual regular morphism for a pinned root subgroup. -/
def rootMorphism (S : D4Geometry K) (α : S.roots.Root) :
    Theory.AlgebraicGroup.Morphism (KPlus k) K :=
  (S.roots.rootSubgroup α).inclusion.comp (S.rootParam α).hom

omit [IsAlgClosed k] in
theorem rootMorphism_apply (S : D4Geometry K) (α : S.roots.Root) (t : k) :
    (rootMorphism S α).onPoints (kPlusPoint t) = S.chevalley.x α t :=
  S.rootParam_spec α t

variable {V : Type v} [AddCommGroup V] [Module k V] [FiniteDimensional k V]
variable {W : Type w} [AddCommGroup W] [Module k W] [FiniteDimensional k W]

/-- The degree-one coefficient of the representation along a pinned root. -/
def rootOperator (S : D4Geometry K)
    (ρ : RationalRepresentation K V) (hρ : IsRationalRepresentation ρ)
    (α : S.roots.Root) : Module.End k V :=
  curveOperator ρ hρ (rootMorphism S α)

/-- The algebra generated by the actual first root coefficients. -/
def rootOperatorAlgebra (S : D4Geometry K)
    (ρ : RationalRepresentation K V) (hρ : IsRationalRepresentation ρ) :
    Subalgebra k (Module.End k V) :=
  Algebra.adjoin k (Set.range (rootOperator S ρ hρ))

/-- The pinned Frobenius formula removes the second factor from the first root coefficient. -/
theorem rootOperator_tensorPullback (S : D4Geometry K) (F : OrdinaryFrobenius S)
    (ρ : RationalRepresentation K V) (σ : RationalRepresentation K W)
    (hρ : IsRationalRepresentation ρ) (hσ : IsRationalRepresentation σ)
    (α : S.roots.Root) :
    rootOperator S (tensorPullback F.morphism ρ σ)
        (tensorPullback_rational F.morphism ρ σ hρ hσ) α =
      (rootOperator S ρ hρ α).rTensor W := by
  apply curveOperator_tensorPullback F.morphism ρ σ hρ hσ
  intro t
  rw [rootMorphism_apply, rootMorphism_apply, F.root_formula]

end Triality.RestrictedWeights.SteinbergTensors.AlgebraicTensor.RestrictedStep
