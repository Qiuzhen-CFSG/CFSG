module

public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.Exhaustivity.ClassBound.Fusion.ConnectedCentralizer.Reduction
public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.Exhaustivity.ClassBound.Fusion.ConnectedCentralizer.Bruhat.Basic

/-!
# Bruhat coverage of toral centralizers

Unique positive-root coordinates and a unique Bruhat form imply that an
actual toral centralizer is generated by its torus, its root groups of weight
one, and its intersection with the torus normalizer. Conjugate a Bruhat form
by the torus point; uniqueness fixes each factor, and coordinate uniqueness
then restricts the two unipotent factors to roots of weight one.

The two geometric parametrizations remain explicit premises. This module
does not yet prove their existence from `Geometry`, so the unconditional
coverage inclusion is still an assembly obligation. The deduction itself
works for every torus point and needs no odd-order assumption.

Source: `refs/KGroup/GLS3/Chapter2St2.tex`, 6.2(b), 6.3(b), and 8.3(c).
-/

public noncomputable section

namespace Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound
open Theory.AlgebraicGroup
namespace ConnectedCentralizer
universe u
variable {k : Type u} [Field k] [CharP k 2]
  {K : Variety k} [AlgebraicGroup K]

/-- Steinberg 8.3(c), conditional on the geometric coordinate and Bruhat
parametrization theorems. Both hypotheses concern the entire actual group
and are independent of the centralizing torus point. -/
theorem centralizer_le_toralRootSubgroup_sup_normalizer_of_bruhat
    (S : Geometry K) (C : Bruhat.PositiveCoordinates S)
    (hbruhat : Function.Bijective (Bruhat.value S))
    (t : Variety.Point S.torus.carrierVariety) :
    Subgroup.centralizer {S.torus.includePoint t} ≤
      toralRootSubgroup S t ⊔ toralNormalizerCentralizer S t := by
  intro g hg
  obtain ⟨f, rfl⟩ := hbruhat.2 g
  have ht : S.torus.includePoint t ∈ S.torus.toSubgroup :=
    (S.torus.pointEquiv t).property
  have htN : S.torus.includePoint t ∈ S.torus.normalizer.toSubgroup :=
    Subgroup.le_normalizer ht
  have h := ToralBruhatForm.factors_centralize hbruhat.1 f
    (S.torus.includePoint t) htN
    ((torus_le_rootSubgroupGenerated_normalizer S.roots S.realized _) ht)
    ((torus_le_rootSubgroupGenerated_normalizer S.roots S.realized _) ht) hg
  have hleft : f.left ∈ toralRootSubgroup S t :=
    Subgroup.mem_sup_right
      (C.centralizer_le S.roots S.realized S.rootParameter t ⟨f.left_mem, h.1⟩)
  have hright : f.right ∈ toralRootSubgroup S t :=
    Subgroup.mem_sup_right
      (C.centralizer_le S.roots S.realized S.rootParameter t ⟨f.right_mem, h.2.2⟩)
  have hmiddle : f.middle ∈ toralNormalizerCentralizer S t :=
    ⟨f.middle_mem, h.2.1⟩
  exact Subgroup.mul_mem _
    (Subgroup.mul_mem _ (Subgroup.mem_sup_left hleft) (Subgroup.mem_sup_right hmiddle))
    (Subgroup.mem_sup_left hright)

end ConnectedCentralizer
end Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound
