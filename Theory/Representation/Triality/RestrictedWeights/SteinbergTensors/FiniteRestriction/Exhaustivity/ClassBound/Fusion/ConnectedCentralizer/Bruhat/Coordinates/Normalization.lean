module

public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.Exhaustivity.ClassBound.Fusion.ConnectedCentralizer.Bruhat.Basic
public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.Exhaustivity.ClassBound.Fusion.ConnectedCentralizer.Bruhat.Coordinates.Chain
public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.Exhaustivity.ClassBound.Fusion.ConnectedCentralizer.Bruhat.Coordinates.Normalization.Basic

/-!
# Relative normalization from positive D4 root commutators

The linear functional `3v₀ + 2v₁ + v₂` computes standard root height.
The published positive-root order has nondecreasing heights. Every positive
integral combination of two positive roots has strictly larger height than
each input, so all commutator correction roots remain in the relevant suffix.
Conjugation preserves the group generated by the suffix once it preserves its
root generators; this uses no ambient normality assumption.

The geometric pairwise commutator containment is an explicit premise. Neither
coordinates nor a Chevalley system are assumed to exist by this module.

Source: GLS3, Chapter 1, Theorem 1.12.7(b,c), and Steinberg 6.2(b),
`refs/KGroup/GLS3/Chapter1.tex`, `refs/KGroup/GLS3/Chapter2St2.tex`.
-/

open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
open scoped commutatorElement

namespace Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound
namespace ConnectedCentralizer.Bruhat
noncomputable section
universe u
variable {k : Type u} [Field k] [CharP k 2]
  {K : Variety k} [AlgebraicGroup K]

namespace Coordinates.Normalization

private def standardHeight (v : Fin 4 → ℝ) : ℝ := 3 * v 0 + 2 * v 1 + v 2

private def height (S : Geometry K) (a : S.roots.Root) : ℝ :=
  standardHeight ((typeDRootPairing 2).root (S.rootIndex a)).val

private def positionHeight (i : Fin 12) : ℕ :=
  if i.val < 4 then 1 else if i.val < 7 then 2 else if i.val < 10 then 3
  else if i.val < 11 then 4 else 5

private theorem height_positiveRoot (S : Geometry K) (i : Fin 12) :
    height S (positiveRoot S i) = positionHeight i := by
  simp only [height, positiveRoot, Equiv.apply_symm_apply]
  fin_cases i <;>
    norm_num [standardHeight, positionHeight,
      Triality.Standard.PositiveCoordinates.rootIndex,
      Triality.Standard.PositiveCoordinates.difference,
      Triality.Standard.PositiveCoordinates.sumRoot,
      typeDRootPairing_root_val, typeDRootEmbedding, typeDRootVector,
      basisVector, Pi.single_apply, Fin.ext_iff]

private theorem positionHeight_pos (i : Fin 12) : 0 < positionHeight i := by
  unfold positionHeight
  split_ifs <;> omega

private theorem positionHeight_mono : Monotone positionHeight := by
  intro i j hij
  unfold positionHeight
  split_ifs <;> simp_all only [Fin.le_def] <;> omega

private theorem positiveOrder_sorted (S : Geometry K) :
    (positiveOrder S).Pairwise (fun a b => height S a ≤ height S b) := by
  apply List.pairwise_ofFn.mpr
  intro i j hij
  rw [height_positiveRoot, height_positiveRoot]
  exact_mod_cast positionHeight_mono (le_of_lt hij)

private theorem height_pos (S : Geometry K) {a : S.roots.Root}
    (ha : a ∈ S.roots.positive) : 0 < height S a := by
  have hm := (mem_positiveOrder S a).mpr ha
  rw [positiveOrder, List.mem_ofFn] at hm
  obtain ⟨i, rfl⟩ := hm
  rw [height_positiveRoot]
  exact_mod_cast positionHeight_pos i

private theorem mem_tail_of_height_lt (S : Geometry K) {a c : S.roots.Root}
    {rs : List S.roots.Root} (hs : (a :: rs).IsSuffix (positiveOrder S))
    (hc : c ∈ S.roots.positive) (hlt : height S a < height S c) : c ∈ rs := by
  obtain ⟨pre, hpre⟩ := hs
  have hsorted := positiveOrder_sorted S
  rw [← hpre, List.pairwise_append] at hsorted
  have hmem := (mem_positiveOrder S c).mpr hc
  rw [← hpre, List.mem_append, List.mem_cons] at hmem
  rcases hmem with hpreMem | rfl | hrs
  · have hle := hsorted.2.2 c hpreMem a (List.mem_cons_self)
    exact False.elim (not_lt_of_ge hle hlt)
  · exact False.elim (lt_irrefl _ hlt)
  · exact hrs

private theorem height_combination (S : Geometry K) {a b c : S.roots.Root} {i j : ℕ}
    (hroot : (typeDRootPairing 2).root (S.rootIndex c) =
      (i : ℝ) • (typeDRootPairing 2).root (S.rootIndex a) +
      (j : ℝ) • (typeDRootPairing 2).root (S.rootIndex b)) :
    height S c = (i : ℝ) * height S a + (j : ℝ) * height S b := by
  have h := congrArg (fun v : typeDRootSpan 4 => standardHeight v.val) hroot
  change height S c = _ at h
  rw [h]
  simp only [standardHeight, Submodule.coe_add, Submodule.coe_smul_of_tower,
    Pi.add_apply, Pi.smul_apply, smul_eq_mul, height]
  ring

/-- A positive integral commutator correction lies after the leading root. -/
public theorem positiveCommutatorRoots_subset_tail (S : Geometry K)
    {a b : S.roots.Root} {rs : List S.roots.Root}
    (hs : (a :: rs).IsSuffix (positiveOrder S)) (hb : b ∈ rs) :
    positiveCommutatorRoots S a b ⊆ {c | c ∈ rs} := by
  have haPos := (mem_positiveOrder S a).mp (hs.subset List.mem_cons_self)
  have hbPos := (mem_positiveOrder S b).mp (hs.subset (List.mem_cons_of_mem _ hb))
  intro c hc
  obtain ⟨hcPos, i, j, hi, hj, hroot⟩ := hc
  apply mem_tail_of_height_lt S hs hcPos
  have haHeight := height_pos S haPos
  have hbHeight := height_pos S hbPos
  have hi' : (1 : ℝ) ≤ i := by exact_mod_cast hi
  have hj' : (1 : ℝ) ≤ j := by exact_mod_cast hj
  rw [height_combination S hroot]
  nlinarith

end Coordinates.Normalization

open Coordinates Coordinates.Normalization

/-- Pairwise positive-root commutator containment gives relative normalization
of every nonempty suffix in the published D4 order. The geometric containment
premise must still be established from `Geometry` for unconditional assembly. -/
public theorem tailNormalizes_of_positiveCommutatorContainment (S : Geometry K)
    (hcomm : PositiveCommutatorContainment S) : TailNormalizes S := by
  intro a rs hs
  change (S.roots.rootSubgroup a).toSubgroup ≤ Subgroup.normalizer
    (Subgroup.closure (⋃ b ∈ {b | b ∈ rs},
      (S.roots.rootSubgroup b : Set (Variety.Point K))) : Set (Variety.Point K))
  rw [Subgroup.le_normalizer_closure_iff]
  intro x hx y hy
  simp only [Set.mem_iUnion] at hy
  obtain ⟨b, hb, hy⟩ := hy
  have haPos := (mem_positiveOrder S a).mp (hs.subset List.mem_cons_self)
  have hbPos := (mem_positiveOrder S b).mp (hs.subset (List.mem_cons_of_mem _ hb))
  have hab : a ≠ b := by
    intro hab
    have hn := List.nodup_cons.mp (hs.sublist.nodup (positiveOrder_nodup S))
    exact hn.1 (hab ▸ hb)
  have hxy : ⁅x, y⁆ ∈ tailGroup S rs :=
    RootSubgroupGenerated_mono S.roots (positiveCommutatorRoots_subset_tail S hs hb)
      (hcomm a haPos b hbPos hab (Subgroup.commutator_mem_commutator hx hy))
  have hyTail : y ∈ tailGroup S rs := rootSubgroup_le_RootSubgroupGenerated S.roots hb hy
  change x * y * x⁻¹ ∈ tailGroup S rs
  simpa only [commutatorElement_def, mul_assoc, inv_mul_cancel, mul_one] using
    (tailGroup S rs).mul_mem hxy hyTail

end
end ConnectedCentralizer.Bruhat
end Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound
