module

public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.Exhaustivity.ClassBound.Generation.FixedOpposition.AmbientNormalizer.SimpleReflections.CorootRealization.Geometry.PointHom
public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.Exhaustivity.ClassBound.Generation.FixedOpposition.AmbientNormalizer.SimpleReflections.CorootRealization.Geometry.PointExistence.Presentation

/-!
# Intrinsic relations for a chosen simple-root pair

The two parametrizations below are actual additive-group isomorphisms onto
the opposite root subgroups. Their values lie in the canonical subgroup
generated by that pair. Put `w = x(1)y(1)x(1)` and
`d(t) = x(t)y(t⁻¹)x(t)w`. We separate the geometric assertion that `w` swaps
the parametrized curves from multiplicativity and square scaling for `d`.
These are proof obligations, not fields of the original D4 geometry.

The normalization of `d` is on the right: in standard SL₂ it is
`diag(t,t⁻¹)`. This is the inverse of the raw GLS coroot word
`n(1)⁻¹n(t)`; characteristic two does not change that exponent convention.
The involution and Bruhat identities are then proved from these three
relations and the additive curve laws.

Sources: GLS3, Theorem 1.9.5(d), Remarks 1.9.6 and §1.12,
`refs/KGroup/GLS3/Chapter1.tex`; Steinberg §6,
`refs/KGroup/GLS3/Chapter2St2.tex`.
-/

open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
namespace Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound.FixedOpposition.AmbientNormalizer.CorootRealization
universe u
variable {k : Type u} [Field k] [IsAlgClosed k] [CharP k 2]
variable {K : Variety k} [AlgebraicGroup K]

/-- Choices of the two actual root parametrizations, with no compatibility assumed. -/
public structure SimpleRootSL2Parameters (S : Geometry K) (i : Fin 4) where
  plus : OneParameterParametrization
    (S.roots.rootSubgroup (S.simpleRoot i).val).carrierVariety
  minus : OneParameterParametrization
    (S.roots.rootSubgroup (S.roots.neg (S.simpleRoot i).val)).carrierVariety

namespace SimpleRootSL2Parameters
variable {S : Geometry K} {i : Fin 4} (P : SimpleRootSL2Parameters S i)

/-- Points of the canonical closed subgroup generated by the opposite pair. -/
public abbrev Target := Variety.Point (oppositePairGeneratedSubgroup
  (S.roots.rootSubgroup (S.simpleRoot i).val)
  (S.roots.rootSubgroup (S.roots.neg (S.simpleRoot i).val))).carrierVariety

private noncomputable def parameterHom : Multiplicative k →* Variety.Point (KPlus k) where
  toFun := (additiveGroupPointEquiv k).symm
  map_one' := rfl
  map_mul' _ _ := rfl

private noncomputable def upperHom : Multiplicative k →* Target (S := S) (i := i) :=
  (oppositePairPlusMorphism _ _).onPoints.comp
    (P.plus.hom.onPoints.comp parameterHom)

private noncomputable def lowerHom : Multiplicative k →* Target (S := S) (i := i) :=
  (oppositePairMinusMorphism _ _).onPoints.comp
    (P.minus.hom.onPoints.comp parameterHom)

/-- The positive root curve in the generated subgroup. -/
public noncomputable def upper (t : k) : Target (S := S) (i := i) :=
  P.upperHom (Multiplicative.ofAdd t)

/-- The negative root curve in the generated subgroup. -/
public noncomputable def lower (t : k) : Target (S := S) (i := i) :=
  P.lowerHom (Multiplicative.ofAdd t)

omit [IsAlgClosed k] in
public lemma upper_eq (t : k) : P.upper t = (oppositePairPlusMorphism _ _).onPoints
    (P.plus.hom.onPoints (kPlusPoint t)) := by rfl

omit [IsAlgClosed k] in
public lemma lower_eq (t : k) : P.lower t = (oppositePairMinusMorphism _ _).onPoints
    (P.minus.hom.onPoints (kPlusPoint t)) := by rfl

/-- The three-factor word at parameter one; no normalization property is assumed. -/
@[expose] public noncomputable def weyl : Target (S := S) (i := i) :=
  P.upper 1 * P.lower 1 * P.upper 1

/-- The right-normalized word, with standard diagonal entries `t,t⁻¹`. -/
@[expose] public noncomputable def diagonal (t : k) : Target (S := S) (i := i) :=
  P.upper t * P.lower t⁻¹ * P.upper t * P.weyl

/-- Conjugation by the three-factor word swaps the two curves with the same parameter. -/
@[expose] public def WeylSwaps : Prop :=
  ∀ a : k, P.weyl * P.upper a * P.weyl = P.lower a

/-- Multiplicativity and square scaling for the actual diagonal words. -/
@[expose] public def DiagonalRelations : Prop :=
  (∀ a b : k, a ≠ 0 → b ≠ 0 → P.diagonal (a * b) = P.diagonal a * P.diagonal b) ∧
  (∀ a : k, a ≠ 0 → ∀ b : k,
    P.diagonal a * P.upper b = P.upper (a ^ 2 * b) * P.diagonal a)

/-- All geometric identities required by the characteristic-two presentation. -/
@[expose] public def Relations : Prop := P.DiagonalRelations ∧ P.WeylSwaps

omit [IsAlgClosed k] in
public lemma upper_zero : P.upper 0 = 1 := P.upperHom.map_one
omit [IsAlgClosed k] in
public lemma lower_zero : P.lower 0 = 1 := P.lowerHom.map_one
omit [IsAlgClosed k] in
public lemma upper_add (a b : k) : P.upper (a + b) = P.upper a * P.upper b :=
  P.upperHom.map_mul (Multiplicative.ofAdd a) (Multiplicative.ofAdd b)
omit [IsAlgClosed k] in
public lemma lower_add (a b : k) : P.lower (a + b) = P.lower a * P.lower b :=
  P.lowerHom.map_mul (Multiplicative.ofAdd a) (Multiplicative.ofAdd b)

omit [IsAlgClosed k] in
public lemma upper_sq (a : k) : P.upper a * P.upper a = 1 := by
  rw [← P.upper_add, CharTwo.add_self_eq_zero, P.upper_zero]
omit [IsAlgClosed k] in
public lemma lower_sq (a : k) : P.lower a * P.lower a = 1 := by
  rw [← P.lower_add, CharTwo.add_self_eq_zero, P.lower_zero]
omit [IsAlgClosed k] in
public lemma weyl_sq : P.weyl * P.weyl = 1 := by
  unfold weyl
  calc
    _ = P.upper 1 * P.lower 1 * (P.upper 1 * P.upper 1) * P.lower 1 * P.upper 1 := by group
    _ = 1 := by rw [P.upper_sq, mul_one, mul_assoc (P.upper 1), P.lower_sq, mul_one, P.upper_sq]

omit [IsAlgClosed k] in
public lemma diagonal_one : P.diagonal 1 = 1 := by
  change P.upper 1 * P.lower (1 : k)⁻¹ * P.upper 1 * P.weyl = 1
  rw [inv_one]
  exact P.weyl_sq

omit [IsAlgClosed k] in
/-- The additive laws and the three geometric identities give the full matrix presentation. -/
public lemma presentation_of_relations (hP : P.Relations) :
    BinaryRankOne.Relations P.upper P.diagonal P.weyl := by
  refine ⟨P.upper_zero, P.upper_add, P.diagonal_one, hP.1.1, hP.1.2, P.weyl_sq, ?_⟩
  intro a _ha
  rw [hP.2]
  symm
  unfold diagonal
  rw [inv_inv]
  calc
    _ = (P.upper a⁻¹ * P.upper a⁻¹) * P.lower a *
        (P.upper a⁻¹ * (P.weyl * P.weyl) * P.upper a⁻¹) := by group
    _ = P.lower a := by rw [P.upper_sq, P.weyl_sq, mul_one, P.upper_sq, one_mul, mul_one]

end SimpleRootSL2Parameters
end Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound.FixedOpposition.AmbientNormalizer.CorootRealization
