module

public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.Exhaustivity.ClassBound.Fusion.ConnectedCentralizer.Bruhat.Coordinates.Normalization.Basic
public import Theory.AlgebraicGroup.ClosedSubgroup.FiniteGeneration
public import Theory.AlgebraicGroup.RootSubgroups.TorusGeneratedNormalizer

/-!
# The closed subgroup generated by contained actual roots

For an ambient closed subgroup `X`, the subgroup generated by the actual root
subgroups contained in `X` is already Zariski closed and connected. This follows
from finite-word generation by connected closed subgroups, without root-product
coordinates or commutator relations. The realizing torus normalizes it.

Consequently the missing one-parameter escape step for invariant unipotent root
generation concerns a proper connected closed subgroup, not an arbitrary
abstract subgroup. No normality inside `X` is asserted or used.

Source: GLS3, Proposition 1.1.4(e), applied to the generation step of
Theorem 1.9.5(i), `refs/KGroup/GLS3/Chapter1.tex`.
-/

open Theory.AlgebraicGroup
namespace Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound
namespace ConnectedCentralizer.Bruhat.Coordinates.Normalization
noncomputable section
universe u
variable {k : Type u} [Field k] [IsAlgClosed k] [CharP k 2]
  {K : Variety k} [AlgebraicGroup K]

private theorem actualRoot_connected (S : Geometry K) (a : S.roots.Root) :
    IsConnected (S.roots.rootSubgroup a : Set (Variety.Point K)) := by
  let : ConnectedSpace (Variety.Point (S.roots.rootSubgroup a).carrierVariety) :=
    connectedSpace_iff_univ.mpr (S.realized.2.2.1 a).1.2.isConnected
  change IsConnected ((S.roots.rootSubgroup a).toSubgroup : Set (Variety.Point K))
  rw [← (S.roots.rootSubgroup a).range_inclusion]
  exact isConnected_range (S.roots.rootSubgroup a).inclusion.toVariety.continuous

omit [IsAlgClosed k] in
private theorem rootUnion_eq (S : Geometry K) (A : Set S.roots.Root) :
    (⋃ a : A, (S.roots.rootSubgroup a.1 : Set (Variety.Point K))) =
      ⋃ a ∈ A, (S.roots.rootSubgroup a : Set (Variety.Point K)) :=
  Set.iUnion_subtype (fun a : S.roots.Root => a ∈ A)
    (fun a => (S.roots.rootSubgroup a.1 : Set (Variety.Point K)))

private theorem generatedRoots_closed (S : Geometry K) (A : Set S.roots.Root) :
    IsZariskiClosed K (RootSubgroupGenerated S.roots A : Set (Variety.Point K)) := by
  have h := closure_iUnion_connected_closedSubgroup_isZariskiClosed
    (fun a : A => S.roots.rootSubgroup a.1) (fun a => actualRoot_connected S a.1)
  rw [rootUnion_eq S A] at h
  exact h

/-- The closed subgroup whose points are generated by the actual root subgroups
contained in `X`. This is the abstract generated subgroup itself. -/
@[expose] public def containedRootSubgroup (S : Geometry K) (X : ClosedSubgroup K) :
    ClosedSubgroup K :=
  ClosedSubgroup.ofSubgroup
    (RootSubgroupGenerated S.roots
      {a | (S.roots.rootSubgroup a).toSubgroup ≤ X.toSubgroup})
    (by exact generatedRoots_closed S _)

/-- Packaging the generated roots as a closed subgroup preserves its points. -/
public theorem containedRootSubgroup_toSubgroup (S : Geometry K) (X : ClosedSubgroup K) :
    (containedRootSubgroup S X).toSubgroup = RootSubgroupGenerated S.roots
      {a | (S.roots.rootSubgroup a).toSubgroup ≤ X.toSubgroup} := rfl

/-- The subgroup generated by contained roots is contained in `X`. -/
public theorem containedRootSubgroup_le (S : Geometry K) (X : ClosedSubgroup K) :
    containedRootSubgroup S X ≤ X :=
  RootSubgroupGenerated_le_of_rootSubgroup_le S.roots _ X.toSubgroup
    (fun _ ha => ha)

/-- The actual contained roots generate a connected closed subgroup. -/
public theorem containedRootSubgroup_connected (S : Geometry K) (X : ClosedSubgroup K) :
    IsConnected (containedRootSubgroup S X : Set (Variety.Point K)) := by
  let A : Set S.roots.Root :=
    {a | (S.roots.rootSubgroup a).toSubgroup ≤ X.toSubgroup}
  have h := closure_iUnion_connected_closedSubgroup_isConnected
    (fun a : A => S.roots.rootSubgroup a.1) (fun a => actualRoot_connected S a.1)
  rw [rootUnion_eq S A] at h
  exact h

/-- The actual torus preserves the subgroup generated by the contained roots. -/
public theorem containedRootSubgroup_invariant (S : Geometry K) (X : ClosedSubgroup K) :
    IsClosedSubgroupInvariant S.torus (containedRootSubgroup S X) := by
  intro t ht x hx
  have hnorm := torus_le_rootSubgroupGenerated_normalizer S.roots S.realized
    {a | (S.roots.rootSubgroup a).toSubgroup ≤ X.toSubgroup}
    (S.torus.inv_mem ht)
  change t⁻¹ * x * t ∈ (containedRootSubgroup S X).toSubgroup
  rw [containedRootSubgroup_toSubgroup]
  simpa only [inv_inv] using (Subgroup.mem_normalizer_iff.mp hnorm x).mp hx

/-- If the contained roots do not generate `X`, the closed subgroup they do
generate is proper. -/
public theorem containedRootSubgroup_lt_of_ne (S : Geometry K) (X : ClosedSubgroup K)
    (hne : X.toSubgroup ≠ RootSubgroupGenerated S.roots
      {a | (S.roots.rootSubgroup a).toSubgroup ≤ X.toSubgroup}) :
    (containedRootSubgroup S X).toSubgroup < X.toSubgroup := by
  refine lt_of_le_of_ne (containedRootSubgroup_le S X) ?_
  intro heq
  exact hne heq.symm

/-- Failure of generation strictly lowers dimension, since both subgroups
are connected and the contained-root subgroup is closed. -/
public theorem containedRootSubgroup_dimension_lt_of_ne (S : Geometry K)
    (X : ClosedSubgroup K) (hX : IsConnected (X : Set (Variety.Point K)))
    (hne : X.toSubgroup ≠ RootSubgroupGenerated S.roots
      {a | (S.roots.rootSubgroup a).toSubgroup ≤ X.toSubgroup}) :
    Variety.dimension (containedRootSubgroup S X).carrierVariety <
      Variety.dimension X.carrierVariety := by
  apply connected_closedSubgroup_dimension_lt_of_le_of_ne
    (containedRootSubgroup S X) X (containedRootSubgroup_le S X) ?_
    (containedRootSubgroup_connected S X) hX
  intro heq
  exact (containedRootSubgroup_lt_of_ne S X hne).ne
    (congrArg (fun H : ClosedSubgroup K => H.toSubgroup) heq)

end
end ConnectedCentralizer.Bruhat.Coordinates.Normalization
end Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound
