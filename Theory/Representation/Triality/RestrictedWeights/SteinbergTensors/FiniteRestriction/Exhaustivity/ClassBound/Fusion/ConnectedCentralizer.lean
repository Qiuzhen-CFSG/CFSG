module

public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.Exhaustivity.ClassBound.Fusion.Restriction
public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.Exhaustivity.ClassBound.Fusion.ConnectedCentralizer.Reduction
public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.Exhaustivity.ClassBound.AmbientCount.TorusData

/-!
# Reduction of odd-order centralizer connectedness

An odd-order graph-field fixed point is semisimple. A conjugate in the chosen
torus has the same order. Bruhat coverage and a normalizer calculation then
identify its centralizer with the connected subgroup generated by the torus
and the root groups whose weights are one. Algebraic conjugation transports
connectedness back to the literal closed subgroup `fixedCentralizer`.

The three remaining geometric inputs are explicit in the theorem below. This
module does not yet assert unconditional connectedness. The torus-conjugacy
input is shared with the ambient class-count development; the two inclusions
are independent obligations in Steinberg 8.3(c). The full weight lattice in
`Geometry` is essential for the normalizer calculation, as in Steinberg
6.4(b), 8.2(6)--(7), and 8.5. The consumer is Steinberg 12.5.

Source: `refs/KGroup/GLS3/Chapter2St2.tex`.
-/

public section

namespace Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound

open Theory.AlgebraicGroup ConnectedCentralizer

universe u
variable {k : Type u} [Field k] [IsAlgClosed k] [CharP k 2]
variable {K : Variety k} [AlgebraicGroup K]

/-- Conditional assembly on the actual closed centralizer, including exponent
one. Each geometric premise still needs to be established from `S`. -/
theorem odd_fixedCentralizer_connected_of_torusData_of_bruhat_of_normalizer
    (S : Geometry K) (n : ℕ) (hn : 0 < n) (D : AmbientCount.TorusData S n)
    (hbruhat : ∀ t : Variety.Point S.torus.carrierVariety,
      ¬ 2 ∣ orderOf (S.torus.includePoint t) →
      Subgroup.centralizer {S.torus.includePoint t} ≤
        toralRootSubgroup S t ⊔ toralNormalizerCentralizer S t)
    (hnormalizer : ∀ t : Variety.Point S.torus.carrierVariety,
      ¬ 2 ∣ orderOf (S.torus.includePoint t) →
      toralNormalizerCentralizer S t ≤ toralRootSubgroup S t)
    (x : graphFieldFixedSubgroup S.diagram.toMulEquiv S.frobenius.onPoints n)
    (hx : ¬ 2 ∣ orderOf x) : Variety.IsConnected (fixedCentralizer S n x).carrierVariety := by
  obtain ⟨t, hxt⟩ := D.semisimple_conjugate (x : Variety.Point K)
    (fixed_odd_isSemisimple S n hn x hx)
  have htOrder : orderOf (S.torus.includePoint t) = orderOf x := by
    obtain ⟨g, hg⟩ := isConj_iff.mp hxt
    calc
      _ = orderOf ((MulAut.conj g) (x : Variety.Point K)) := congrArg orderOf hg.symm
      _ = orderOf (x : Variety.Point K) := (MulAut.conj g).orderOf_eq _
      _ = orderOf x := Subgroup.orderOf_coe x
  have htOdd : ¬ 2 ∣ orderOf (S.torus.includePoint t) := by rwa [htOrder]
  apply carrier_isConnected
  exact centralizer_isConnected_of_isConj hxt
    (toral_centralizer_isConnected S t (hbruhat t htOdd) (hnormalizer t htOdd))

end Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound
