module

public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.Exhaustivity.ClassBound.Fusion.ConnectedCentralizer.Reduction
public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.Exhaustivity.ClassBound.AmbientCount.TorusData

/-!
# Inputs for the D4 centralizing-normalizer calculation

The torus-point stabilizer must be generated by reflections at roots whose
characters have value one. Independently, the actual torus normalizer must map
to the D4 Weyl group with toral kernel and with reflection representatives in
the corresponding pairs of opposite root groups. These are geometric proof
obligations, not consequences asserted here from `TorusData`.

The action equation uses left conjugation, so the normalizer map is a group
homomorphism. The inverse-conjugation convention for root parameters does not
change a root reflection, which is an involution.

Source: Steinberg, `refs/KGroup/GLS3/Chapter2St2.tex`, 4.10', 5.3, 6.4(b),
8.2(4)--(7), and 8.3(c).
-/

@[expose] public noncomputable section

namespace Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound

open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem

namespace ConnectedCentralizer.Normalizer

universe u
variable {k : Type u} [Field k] [CharP k 2]
variable {K : Variety k} [AlgebraicGroup K]

/-- The reflection at an actual root, in the specified standard D4 pairing. -/
def rootReflection (S : Geometry K) (a : S.roots.Root) : AmbientCount.Weyl :=
  RootPairing.weylGroup.ofIdx (typeDRootPairing 2) (S.rootIndex a)

/-- The reflection subgroup supported on actual roots centralizing `t`. -/
def toralReflectionSubgroup (S : Geometry K)
    (t : Variety.Point S.torus.carrierVariety) : Subgroup AmbientCount.Weyl :=
  Subgroup.closure (rootReflection S ''
    {a | (S.roots.rootWeight a).pointCharacter t = 1})

/-- The lattice-theoretic obligation. It does not refer to ambient normalizer
representatives or to connectedness of the centralizer. -/
def ReflectionGeneration {S : Geometry K} {n : ℕ} (D : AmbientCount.TorusData S n)
    (t : Variety.Point S.torus.carrierVariety) : Prop :=
  letI := D.action
  MulAction.stabilizer AmbientCount.Weyl t ≤ toralReflectionSubgroup S t

/-- The normalizer action together with representatives in opposite root
groups. Neither the map nor its representatives are supplied by `TorusData`.
The kernel is handled separately by the centralizer of the whole torus. -/
structure LiftAction (S : Geometry K) {n : ℕ} (D : AmbientCount.TorusData S n) where
  toWeyl : S.torus.normalizer.toSubgroup →* AmbientCount.Weyl
  conjugation : letI := D.action
    ∀ (g : S.torus.normalizer.toSubgroup) (t : Variety.Point S.torus.carrierVariety),
      S.torus.includePoint (toWeyl g • t) =
        (g : Variety.Point K) * S.torus.includePoint t * (g : Variety.Point K)⁻¹
  reflection_lift : ∀ a : S.roots.Root, ∃ g : S.torus.normalizer.toSubgroup,
    toWeyl g = rootReflection S a ∧
      (g : Variety.Point K) ∈ (S.roots.rootSubgroup a).toSubgroup ⊔
        (S.roots.rootSubgroup (S.roots.neg a)).toSubgroup

/-- The complete lifting input, including the direction of the kernel
identification used by the centralizing-normalizer argument. -/
structure Realization (S : Geometry K) {n : ℕ} (D : AmbientCount.TorusData S n)
    extends LiftAction S D where
  ker_le : ∀ g, toWeyl g = 1 → (g : Variety.Point K) ∈ S.torus

/-- A faithful ambient torus centralizer supplies the kernel clause. This
allows the centralizer theorem and the root-group lift construction to be
proved independently. -/
def LiftAction.toRealization {S : Geometry K} {n : ℕ}
    {D : AmbientCount.TorusData S n} (A : LiftAction S D)
    (hT : Subgroup.centralizer (S.torus.toSubgroup : Set (Variety.Point K)) ≤
      S.torus.toSubgroup) : Realization S D where
  toLiftAction := A
  ker_le := by
    let := D.action
    intro g hg
    apply hT
    apply Subgroup.mem_centralizer_iff.mpr
    intro y hy
    let t := S.torus.pointEquiv.symm ⟨y, hy⟩
    have ht : S.torus.includePoint t = y :=
      congrArg Subtype.val (S.torus.pointEquiv.apply_symm_apply ⟨y, hy⟩)
    have hc := A.conjugation g t
    rw [hg, one_smul, ht] at hc
    simpa only [mul_assoc, inv_mul_cancel, mul_one] using
      congrArg (fun z => z * (g : Variety.Point K)) hc

end ConnectedCentralizer.Normalizer

end Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound
