module

public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.Exhaustivity.ClassBound.Fusion.ConnectedCentralizer.Normalizer.Inputs

/-!
# Opposite-root representatives for the actual D4 torus

This isolates the rank-one geometric obligation from the construction of a
normalizer-to-Weyl homomorphism. A representative must lie in the subgroup
generated by the two actual opposite root groups and act on every torus point
as the corresponding reflection of the supplied action. Pointwise ambient
conjugacy does not supply such a representative.

The assembly in `Lifts` uses faithfulness of the torus action to identify the
Weyl image of these representatives. Existence of the representatives remains
a separate theorem to prove from the actual root-group geometry.

Source: Steinberg, `refs/KGroup/GLS3/Chapter2St2.tex`, 6.1--6.4, 8.2(4)--(5),
and 8.3(c); GLS3, Chapter 1, Theorem 1.9.5(f).
-/

@[expose] public noncomputable section
namespace Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound
open Theory.AlgebraicGroup
namespace ConnectedCentralizer.Normalizer

universe u
variable {k : Type u} [Field k] [CharP k 2]
variable {K : Variety k} [AlgebraicGroup K]

/-- The geometric rank-one obligation, independent of any choice of a
normalizer-to-Weyl map. The action equation is left conjugation. -/
def OppositeReflectionLifts (S : Geometry K) {n : ℕ}
    (D : AmbientCount.TorusData S n) : Prop :=
  letI := D.action
  ∀ a : S.roots.Root, ∃ g : S.torus.normalizer.toSubgroup,
    (g : Variety.Point K) ∈ (S.roots.rootSubgroup a).toSubgroup ⊔
      (S.roots.rootSubgroup (S.roots.neg a)).toSubgroup ∧
    ∀ t : Variety.Point S.torus.carrierVariety,
      S.torus.includePoint (rootReflection S a • t) =
        (g : Variety.Point K) * S.torus.includePoint t * (g : Variety.Point K)⁻¹

end ConnectedCentralizer.Normalizer
end Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound
