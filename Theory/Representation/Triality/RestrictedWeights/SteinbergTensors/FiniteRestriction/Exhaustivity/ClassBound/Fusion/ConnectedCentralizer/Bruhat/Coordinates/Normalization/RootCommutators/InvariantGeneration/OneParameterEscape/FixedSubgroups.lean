module

public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.Exhaustivity.ClassBound.Fusion.ConnectedCentralizer.Bruhat.Coordinates.Normalization.RootCommutators.InvariantGeneration.ClosedRoots
public import Theory.AlgebraicGroup.Tori.SemisimpleCenterContainment.RadicalGeometry.IntersectionNormality.FixedSubgroups.ExternalWeights
public import Theory.AlgebraicGroup.Tori.SemisimpleCenterContainment.RadicalGeometry.IntersectionNormality.FixedSubgroups.ExternalFixedTangent
public import Theory.AlgebraicGroup.Tori.SemisimpleCenterContainment.RadicalGeometry.IntersectionNormality.FixedSubgroups.Connected

/-!
# Escape by an actual subtorus fixed subgroup

A torus-normalized connected group is generated by its fixed subgroups for the
full torus and its codimension-one subtori. Thus a proper contained-root
subgroup misses one of these fixed subgroups. When the group is unipotent,
that fixed subgroup is connected, unipotent and invariant under the full torus.
This constructs an ambient closed subgroup, without a quotient or normality
assumption on the subgroup being escaped.

The separate dimension and additive-parametrization steps are still needed to
make the constructed subgroup one-parameter. This argument uses external-torus
weight decomposition, not spanning by chosen root tangents.

Source: Borel, III, 9.4--9.5 (`refs/KGroup/Bor1/Chapter3.tex`), in the
one-parameter generation argument of GLS3, Theorem 1.9.5(i).
-/

open Theory.AlgebraicGroup
open Theory.AlgebraicGroup.SemisimpleCenterContainment.RadicalGeometry.IntersectionNormality

namespace Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound
namespace ConnectedCentralizer.Bruhat.Coordinates.Normalization
noncomputable section
universe u
variable {k : Type u} [Field k] [IsAlgClosed k] [CharP k 2]
  {K : Variety k} [AlgebraicGroup K]

namespace OneParameterEscape

/-- The full torus, together with its actual codimension-one subtori. -/
public abbrev FixedIndex (S : Geometry K) := Option (CodimensionOneSubtorus S.torus)

/-- The acting subtorus indexed by `q`; `none` denotes the full torus. -/
@[expose] public def actingTorus (S : Geometry K) : FixedIndex S → ClosedSubgroup K
  | none => S.torus
  | some q => q.1

/-- The ambient closed subgroup fixed by the specified subtorus. -/
@[expose] public def fixedSubgroup (S : Geometry K) (X : ClosedSubgroup K)
    (q : FixedIndex S) : ClosedSubgroup K := X.pointwiseCentralizer (actingTorus S q)

omit [IsAlgClosed k] in
private theorem actingTorus_isSubtorus (S : Geometry K) (q : FixedIndex S) :
    IsSubtorus (actingTorus S q) := by
  cases q with
  | none => exact S.maximalTorus.1
  | some q => exact q.2.1

omit [IsAlgClosed k] in
private theorem actingTorus_le (S : Geometry K) (q : FixedIndex S) :
    actingTorus S q ≤ S.torus := by
  cases q with
  | none => exact fun _ hx => hx
  | some q => exact q.2.2.1

omit [IsAlgClosed k] in
private theorem torus_normalizes (S : Geometry K) (X : ClosedSubgroup K)
    (hX : IsClosedSubgroupInvariant S.torus X) : S.torus ≤ X.normalizer := by
  apply Subgroup.le_normalizer_iff.mpr
  intro t ht x hx
  change t * x * t⁻¹ ∈ X
  simpa only [inv_inv] using hX t⁻¹ (S.torus.inv_mem ht) x hx

omit [IsAlgClosed k] in
/-- Every fixed subgroup lies in the original subgroup. -/
public theorem fixedSubgroup_le (S : Geometry K) (X : ClosedSubgroup K)
    (q : FixedIndex S) : fixedSubgroup S X q ≤ X := fun _ hx => hx.1

omit [IsAlgClosed k] in
/-- Commutativity of the torus preserves each of its subtorus fixed subgroups. -/
public theorem fixedSubgroup_invariant (S : Geometry K) (X : ClosedSubgroup K)
    (hX : IsClosedSubgroupInvariant S.torus X) (q : FixedIndex S) :
    IsClosedSubgroupInvariant S.torus (fixedSubgroup S X q) := by
  intro t ht x hx
  refine ⟨hX t ht x hx.1, ?_⟩
  change t⁻¹ * x * t ∈ Subgroup.centralizer
    ((actingTorus S q).toSubgroup : Set (Variety.Point K))
  rw [Subgroup.mem_centralizer_iff]
  intro s hs
  have hst : s * t = t * s := by
    let sT : Variety.Point S.torus.carrierVariety :=
      S.torus.pointEquiv.symm ⟨s, actingTorus_le S q hs⟩
    let tT : Variety.Point S.torus.carrierVariety := S.torus.pointEquiv.symm ⟨t, ht⟩
    have h := congrArg S.torus.inclusion.onPoints
      (isMulCommutative_iff.mp S.maximalTorus.1.isMulCommutative sT tT)
    exact h
  have hsx : s * x = x * s := Subgroup.mem_centralizer_iff.mp hx.2 s hs
  have hsti : s * t⁻¹ = t⁻¹ * s := (Commute.inv_right hst)
  calc
    s * (t⁻¹ * x * t) = (s * t⁻¹) * x * t := by group
    _ = (t⁻¹ * s) * x * t := by rw [hsti]
    _ = t⁻¹ * (s * x) * t := by group
    _ = t⁻¹ * (x * s) * t := by rw [hsx]
    _ = t⁻¹ * x * (s * t) := by group
    _ = t⁻¹ * x * (t * s) := by rw [hst]
    _ = (t⁻¹ * x * t) * s := by group

/-- Subtorus fixed subgroups of the given connected unipotent group are connected. -/
public theorem fixedSubgroup_connected (S : Geometry K) (X : ClosedSubgroup K)
    (hXc : IsConnected (X : Set (Variety.Point K)))
    (hXt : IsClosedSubgroupInvariant S.torus X)
    (hXu : IsUnipotentAlgebraicGroup X.carrierVariety) (q : FixedIndex S) :
    IsConnected (fixedSubgroup S X q : Set (Variety.Point K)) :=
  externalTorusFixed_isConnected_set X (actingTorus S q) hXc hXu
    (actingTorus_isSubtorus S q)
    (fun _ hx => torus_normalizes S X hXt (actingTorus_le S q hx))

/-- Unipotence passes to the actual fixed subgroup through its ambient inclusion. -/
public theorem fixedSubgroup_unipotent (S : Geometry K) (X : ClosedSubgroup K)
    (hXu : IsUnipotentAlgebraicGroup X.carrierVariety) (q : FixedIndex S) :
    IsUnipotentAlgebraicGroup (fixedSubgroup S X q).carrierVariety :=
  unipotent_of_le (fixedSubgroup_le S X q) hXu

/-- The actual fixed subgroups generate `X`, independently of root commutators. -/
public theorem fixedSubgroups_generate (S : Geometry K) (X : ClosedSubgroup K)
    (hXc : IsConnected (X : Set (Variety.Point K)))
    (hXt : IsClosedSubgroupInvariant S.torus X) :
    Subgroup.closure (⋃ q : FixedIndex S,
      (fixedSubgroup S X q : Set (Variety.Point K))) = X.toSubgroup := by
  have hN := torus_normalizes S X hXt
  have h := externalTorusFixed_generation_of_tangent_inputs X S.torus hXc
    S.maximalTorus.1
    (hasExternalTangentWeightDecomposition_of_normalizes X S.torus S.maximalTorus.1 hN)
    (hasExternalFixedTangentLifting_of_normalizes X S.torus hN)
  rw [← h]
  congr 1
  ext x
  simp only [Set.mem_iUnion, Set.mem_union]
  constructor
  · rintro ⟨q, hx⟩
    cases q with
    | none => exact Or.inl hx
    | some q => exact Or.inr ⟨q, hx⟩
  · rintro (hx | ⟨q, hx⟩)
    · exact ⟨none, hx⟩
    · exact ⟨some q, hx⟩

/-- A proper canonical contained-root subgroup misses an actual fixed subgroup. -/
public theorem exists_fixedSubgroup_not_le (S : Geometry K) (X : ClosedSubgroup K)
    (hXc : IsConnected (X : Set (Variety.Point K)))
    (hXt : IsClosedSubgroupInvariant S.torus X)
    (hproper : (containedRootSubgroup S X).toSubgroup < X.toSubgroup) :
    ∃ q : FixedIndex S,
      ¬ (fixedSubgroup S X q).toSubgroup ≤ (containedRootSubgroup S X).toSubgroup := by
  by_contra! h
  apply hproper.not_ge
  rw [← fixedSubgroups_generate S X hXc hXt]
  apply (Subgroup.closure_le _).mpr
  intro x hx
  obtain ⟨q, hx⟩ := Set.mem_iUnion.mp hx
  exact h q hx

/-- An escaping fixed subgroup has positive dimension. -/
public theorem escaping_fixedSubgroup_dimension_pos (S : Geometry K)
    (X : ClosedSubgroup K)
    (hXc : IsConnected (X : Set (Variety.Point K)))
    (hXt : IsClosedSubgroupInvariant S.torus X)
    (hXu : IsUnipotentAlgebraicGroup X.carrierVariety) (q : FixedIndex S)
    (hq : ¬ (fixedSubgroup S X q).toSubgroup ≤ (containedRootSubgroup S X).toSubgroup) :
    0 < Variety.dimension (fixedSubgroup S X q).carrierVariety := by
  apply connected_closedSubgroup_dimension_pos_of_ne_bot _
    (fixedSubgroup_connected S X hXc hXt hXu q)
  intro hbot
  exact hq (hbot ▸ bot_le)

end OneParameterEscape
end
end ConnectedCentralizer.Bruhat.Coordinates.Normalization
end Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound
