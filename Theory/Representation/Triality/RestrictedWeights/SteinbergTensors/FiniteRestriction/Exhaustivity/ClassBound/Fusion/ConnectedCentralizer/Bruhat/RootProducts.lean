module

public import Theory.AlgebraicGroup.RootSubgroups.TorusGeneratedNormalizer

/-!
# Torus-fixed products in unique root coordinates

Conjugation scales each parameter by its actual root character. Injectivity
of the ordered multiplication map therefore makes every nonzero parameter
have weight one. This proves the root-generated containment used in Steinberg
8.3(c) from the coordinate theorem of 6.2(b).

`ToralRootCoordinates` records that separate geometric theorem; its existence
is not asserted here. These lemmas use arbitrary realized root data and do not
require a D4 model or any assertion about connected centralizers.

Source: `refs/KGroup/GLS3/Chapter2St2.tex`, 6.1, 6.2(b), and 8.3(c).
-/

universe u
@[expose] public noncomputable section
namespace Theory.AlgebraicGroup
variable {k : Type u} [Field k] {K : Variety k} [AlgebraicGroup K]
  {T : ClosedSubgroup K}

/-- A product in a specified order of actual parametrized root groups. -/
def toralOrderedRootProduct (D : RootGroupData K T)
    (p : ∀ a, OneParameterParametrization (D.rootSubgroup a).carrierVariety)
    (rs : List D.Root) (c : Fin rs.length → k) : Variety.Point K :=
  (List.ofFn fun i => (D.rootSubgroup (rs.get i)).includePoint
    ((p (rs.get i)).value (c i))).prod

private theorem parameter_zero {X : Variety k} [AlgebraicGroup X]
    (p : OneParameterParametrization X) : p.value 0 = 1 := by
  have h : kPlusPoint (0 : k) = 1 := by
    apply (additiveGroupPointEquiv k).injective
    rfl
  change p.hom.onPoints (kPlusPoint 0) = 1
  rw [h, map_one]

/-- The torus acts diagonally on an ordered product of root parameters. -/
theorem toralOrderedRootProduct_conjugation (D : RootGroupData K T)
    (hD : D.IsRealization)
    (p : ∀ a, OneParameterParametrization (D.rootSubgroup a).carrierVariety)
    (rs : List D.Root) (c : Fin rs.length → k)
    (t : Variety.Point T.carrierVariety) :
    (T.includePoint t)⁻¹ * toralOrderedRootProduct D p rs c * T.includePoint t =
      toralOrderedRootProduct D p rs
        (fun i => (D.rootWeight (rs.get i)).pointCharacter t * c i) := by
  let f := MulAut.conj (T.includePoint t)⁻¹
  change _ = toralOrderedRootProduct D p rs _
  rw [show (T.includePoint t)⁻¹ * toralOrderedRootProduct D p rs c * T.includePoint t =
    f (toralOrderedRootProduct D p rs c) by simp [f]]
  simp only [toralOrderedRootProduct, map_list_prod, List.map_ofFn]
  congr 2
  funext i
  change (T.includePoint t)⁻¹ * _ * ((T.includePoint t)⁻¹)⁻¹ = _
  rw [inv_inv]
  exact (hD.2.2.1 (rs.get i)).2 (p (rs.get i)) (c i) t

/-- Unique coordinates of a torus-fixed product have weight one wherever
its parameter is nonzero. Consequently the product is generated by exactly
those root groups centralizing the torus point. -/
theorem toralOrderedRootProduct_mem_fixedRoots (D : RootGroupData K T)
    (hD : D.IsRealization)
    (p : ∀ a, OneParameterParametrization (D.rootSubgroup a).carrierVariety)
    (rs : List D.Root)
    (hinj : Function.Injective (toralOrderedRootProduct D p rs))
    (c : Fin rs.length → k) (t : Variety.Point T.carrierVariety)
    (hfixed : toralOrderedRootProduct D p rs c ∈
      Subgroup.centralizer {T.includePoint t}) :
    toralOrderedRootProduct D p rs c ∈
      RootSubgroupGenerated D {a | (D.rootWeight a).pointCharacter t = 1} := by
  have hcomm := Subgroup.mem_centralizer_singleton_iff.mp hfixed
  have hc : (fun i => (D.rootWeight (rs.get i)).pointCharacter t * c i) = c := by
    apply hinj
    rw [← toralOrderedRootProduct_conjugation D hD p rs c t]
    rw [mul_assoc, hcomm]
    group
  apply Subgroup.list_prod_mem
  intro z hz
  obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hz
  by_cases hi : c i = 0
  · simp only [hi, parameter_zero]
    change (D.rootSubgroup (rs.get i)).inclusion.onPoints 1 ∈ _
    rw [map_one]
    exact Subgroup.one_mem _
  · apply rootSubgroup_le_RootSubgroupGenerated D (show
        (D.rootWeight (rs.get i)).pointCharacter t = 1 from ?_)
    · exact (D.rootSubgroup (rs.get i)).pointEquiv
        ((p (rs.get i)).value (c i)) |>.property
    · apply mul_right_cancel₀ hi
      simpa only [one_mul] using congrFun hc i

/-- The geometric coordinate theorem required here is independent of the
centralizing torus point. It is the pointwise part of Steinberg 6.2(b). -/
structure ToralRootCoordinates (D : RootGroupData K T)
    (p : ∀ a, OneParameterParametrization (D.rootSubgroup a).carrierVariety)
    (P : Set D.Root) where
  roots : List D.Root
  nodup : roots.Nodup
  mem_roots : ∀ a, a ∈ roots ↔ a ∈ P
  injective : Function.Injective (toralOrderedRootProduct D p roots)
  covers : ∀ x ∈ RootSubgroupGenerated D P,
    ∃ c, toralOrderedRootProduct D p roots c = x

/-- The fixed subgroup in any uniquely parametrized root product is
contained in the group generated by the roots of weight one. -/
theorem ToralRootCoordinates.centralizer_le (D : RootGroupData K T)
    (hD : D.IsRealization)
    (p : ∀ a, OneParameterParametrization (D.rootSubgroup a).carrierVariety)
    {P : Set D.Root} (C : ToralRootCoordinates D p P)
    (t : Variety.Point T.carrierVariety) :
    RootSubgroupGenerated D P ⊓ Subgroup.centralizer {T.includePoint t} ≤
      RootSubgroupGenerated D {a | (D.rootWeight a).pointCharacter t = 1} := by
  intro x hx
  obtain ⟨c, rfl⟩ := C.covers x hx.1
  exact toralOrderedRootProduct_mem_fixedRoots D hD p C.roots C.injective c t hx.2

end Theory.AlgebraicGroup
