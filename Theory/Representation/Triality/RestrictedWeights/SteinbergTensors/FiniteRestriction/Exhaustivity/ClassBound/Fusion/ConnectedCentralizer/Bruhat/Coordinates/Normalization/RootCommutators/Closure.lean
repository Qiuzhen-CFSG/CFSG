module

public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.Exhaustivity.ClassBound.Fusion.ConnectedCentralizer.Bruhat.Coordinates.Normalization.Basic
public import Theory.AlgebraicGroup.ClosedSubgroup.CentralSeries

/-!
# Geometry of the actual root-pair commutator closure

The Zariski closure of a commutator of two actual root subgroups is connected
and invariant under the realizing torus. For positive roots it lies in the
unipotent radical already supplied by the Borel geometry, hence is unipotent.
These facts use only continuity, the realized torus action, and the supplied
Borel radical; no Chevalley relations or root coordinates enter the proof.

This supplies the geometric hypotheses for applying invariant-unipotent root
generation to the commutator closure. Root generation and the mixed-character
support calculation remain separate obligations.

Source: GLS3, Chapter 1, Theorems 1.9.5(i) and 1.12.7(b),
`refs/KGroup/GLS3/Chapter1.tex`.
-/

open Theory.AlgebraicGroup
open scoped commutatorElement
namespace Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound
namespace ConnectedCentralizer.Bruhat.Coordinates.Normalization
noncomputable section
universe u
variable {k : Type u} [Field k] [IsAlgClosed k] [CharP k 2]
  {K : Variety k} [AlgebraicGroup K]

/-- The actual Zariski-closed subgroup generated by the root-pair commutators. -/
@[expose] public def closedPairCommutator (S : Geometry K) (a b : S.roots.Root) : ClosedSubgroup K :=
  subgroupZariskiClosure K
    ⁅(S.roots.rootSubgroup a).toSubgroup, (S.roots.rootSubgroup b).toSubgroup⁆

/-- The root-pair commutator closure is connected. -/
public theorem closedPairCommutator_connected (S : Geometry K) (a b : S.roots.Root) :
    IsConnected (closedPairCommutator S a b : Set (Variety.Point K)) := by
  apply subgroupZariskiClosure_commutator_closedSubgroups_isConnected
  have hconn := (S.realized.2.2.1 a).1.2.isConnected
  let : ConnectedSpace (Variety.Point (S.roots.rootSubgroup a).carrierVariety) :=
    connectedSpace_iff_univ.mpr hconn
  change IsConnected ((S.roots.rootSubgroup a).toSubgroup : Set (Variety.Point K))
  rw [← (S.roots.rootSubgroup a).range_inclusion]
  exact isConnected_range (S.roots.rootSubgroup a).inclusion.toVariety.continuous

omit [IsAlgClosed k] in
/-- The realizing torus preserves the root-pair commutator closure. -/
public theorem closedPairCommutator_invariant (S : Geometry K) (a b : S.roots.Root) :
    IsClosedSubgroupInvariant S.torus (closedPairCommutator S a b) := by
  intro t ht x hx
  let f : Variety.Point K →* Variety.Point K := (MulAut.conj t⁻¹).toMonoidHom
  have hf (d : S.roots.Root) :
      Subgroup.map f (S.roots.rootSubgroup d).toSubgroup ≤
        (S.roots.rootSubgroup d).toSubgroup := by
    rw [Subgroup.map_le_iff_le_comap]
    intro y hy
    change t⁻¹ * y * (t⁻¹)⁻¹ ∈ S.roots.rootSubgroup d
    simpa only [inv_inv] using (S.realized.2.2.1 d).1.1 t ht y hy
  have hfcomm : Subgroup.map f
      ⁅(S.roots.rootSubgroup a).toSubgroup, (S.roots.rootSubgroup b).toSubgroup⁆ ≤
      ⁅(S.roots.rootSubgroup a).toSubgroup, (S.roots.rootSubgroup b).toSubgroup⁆ := by
    rw [Subgroup.map_commutator]
    exact Subgroup.commutator_mono (hf a) (hf b)
  have hcontinuous : Continuous f := by
    have heq : (f : Variety.Point K → Variety.Point K) =
        (conjugationByMorphism K t⁻¹).toFun := by
      funext y
      simp only [conjugationByMorphism_apply]
      rfl
    rw [heq]
    exact (conjugationByMorphism K t⁻¹).continuous
  have hclosure := map_mem_closure hcontinuous hx
    (fun y hy => hfcomm (Subgroup.mem_map.mpr ⟨y, hy, rfl⟩))
  change t⁻¹ * x * (t⁻¹)⁻¹ ∈ closedPairCommutator S a b at hclosure
  simpa only [inv_inv] using hclosure

omit [IsAlgClosed k] in
/-- For positive roots, the commutator closure lies in the supplied Borel radical. -/
public theorem closedPairCommutator_le_positive (S : Geometry K)
    {a b : S.roots.Root} (ha : a ∈ S.roots.positive) (hb : b ∈ S.roots.positive) :
    closedPairCommutator S a b ≤ S.bigCell.data.positive_witness.unipotent := by
  apply closure_minimal ?_
    (Variety.isClosed_iff_isZariskiClosed.mpr
      S.bigCell.data.positive_witness.unipotent.isZariskiClosed)
  change ⁅(S.roots.rootSubgroup a).toSubgroup, (S.roots.rootSubgroup b).toSubgroup⁆ ≤ _
  rw [S.bigCell.data.positive_witness.root_generated]
  apply Subgroup.commutator_le.mpr
  intro x hx y hy
  let U := RootSubgroupGenerated S.roots S.roots.positive
  have hxU : x ∈ U := rootSubgroup_le_RootSubgroupGenerated S.roots ha hx
  have hyU : y ∈ U := rootSubgroup_le_RootSubgroupGenerated S.roots hb hy
  exact U.mul_mem (U.mul_mem (U.mul_mem hxU hyU) (U.inv_mem hxU)) (U.inv_mem hyU)

/-- The positive root-pair commutator closure is a unipotent algebraic group. -/
public theorem closedPairCommutator_unipotent (S : Geometry K)
    {a b : S.roots.Root} (ha : a ∈ S.roots.positive) (hb : b ∈ S.roots.positive) :
    IsUnipotentAlgebraicGroup (closedPairCommutator S a b).carrierVariety := by
  let V := closedPairCommutator S a b
  let U := S.bigCell.data.positive_witness.unipotent
  have hVU : V ≤ U := closedPairCommutator_le_positive S ha hb
  have hU : IsUnipotentAlgebraicGroup U.carrierVariety :=
    S.bigCell.data.positive_witness.radical.2.1
  intro v
  let x := V.inclusion.onPoints v
  have hxV : x ∈ V.toSubgroup := (V.pointEquiv v).property
  have hxU : x ∈ U.toSubgroup := hVU hxV
  let u : Variety.Point U.carrierVariety := U.pointEquiv.symm ⟨x, hxU⟩
  have huAmbient := morphism_preserves_unipotentElement U.inclusion u (hU u)
  have huval : U.inclusion.onPoints u = x := by
    change (U.pointEquiv u).val = x
    simp [u]
  rw [huval] at huAmbient
  have hv := closedSubgroup_unipotent_of_ambient V hxV huAmbient
  have hveq : V.pointEquiv.symm ⟨x, hxV⟩ = v := by
    apply V.pointEquiv.injective
    apply Subtype.ext
    rfl
  rwa [hveq] at hv

end
end ConnectedCentralizer.Bruhat.Coordinates.Normalization
end Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound
