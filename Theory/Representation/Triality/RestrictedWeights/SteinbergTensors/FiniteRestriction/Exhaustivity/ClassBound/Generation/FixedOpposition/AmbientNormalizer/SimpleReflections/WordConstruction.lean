module

public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.Exhaustivity.ClassBound.Generation.FixedOpposition.AmbientNormalizer.ReflectionWords

/-!
# Opposite-root words for the four marked D4 roots

The root-weight equations show that inverse conjugation of `n(1)` by a
point of the supplied torus gives `n(alpha(t))`. This works for any choices
of the two root parametrizations. The additional geometric identity
`h(z) = n(1)⁻¹ n(z)` is recorded separately in `SimpleCorootWordData`;
its existence is not asserted here.

This isolates the rank-one input needed for the simultaneous ambient
reflection lifts, without a Weyl quotient or a full Chevalley system.
Sources: GLS3, `refs/KGroup/GLS3/Chapter1.tex`, Definitions 1.9.1--1.9.3,
Remarks 1.9.6 and the defining words in Theorem 1.12.1.
-/

@[expose] public noncomputable section

namespace Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound.FixedOpposition.AmbientNormalizer

open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem

universe u
variable {k : Type u} [Field k] [IsAlgClosed k] [CharP k 2]
variable {K : Variety k} [AlgebraicGroup K]

/-- Chosen parametrizations of one actual simple-root subgroup and its opposite.
No compatibility between the two parametrizations is assumed here. -/
structure SimpleRootParameters (S : Geometry K) (i : Fin 4) where
  plus : OneParameterParametrization
    (S.roots.rootSubgroup (S.simpleRoot i).val).carrierVariety
  minus : OneParameterParametrization
    (S.roots.rootSubgroup (S.roots.neg (S.simpleRoot i).val)).carrierVariety

/-- The source word `n(z) = x(z) y(-z⁻¹) x(z)` in the ambient group. -/
def SimpleRootParameters.word {S : Geometry K} {i : Fin 4}
    (P : SimpleRootParameters S i) (z : kˣ) : Variety.Point K :=
  (S.roots.rootSubgroup (S.simpleRoot i).val).includePoint (P.plus.value z) *
    (S.roots.rootSubgroup (S.roots.neg (S.simpleRoot i).val)).includePoint
      (P.minus.value (-(z⁻¹ : kˣ) : k)) *
    (S.roots.rootSubgroup (S.simpleRoot i).val).includePoint (P.plus.value z)

omit [IsAlgClosed k] in
/-- Inverse conjugation by a torus point scales the word parameter by the
actual root character. This needs no opposite-root exchange relation. -/
theorem SimpleRootParameters.word_conjugation {S : Geometry K} {i : Fin 4}
    (P : SimpleRootParameters S i)
    (t : Variety.Point S.torus.carrierVariety) :
    (S.torus.includePoint t)⁻¹ * P.word 1 * S.torus.includePoint t =
      P.word (dPointEquiv 1 ((S.roots.rootWeight (S.simpleRoot i).val).onPoints t) 0) := by
  let a := (S.simpleRoot i).val
  let Tt := S.torus.includePoint t
  have hp := (S.realized.2.2.1 a).2 P.plus 1 t
  have hm := (S.realized.2.2.1 (S.roots.neg a)).2 P.minus (-1) t
  have hneg := S.realized.2.2.2.1 a
  have hinv : (S.roots.rootWeight (S.roots.neg a)).pointCharacter t =
      ((S.roots.rootWeight a).pointCharacter t)⁻¹ := by
    rw [hneg]
    change ((torusPointEval _ t ((S.roots.rootWeight a)⁻¹)) : k) = _
    rw [map_inv, Units.val_inv_eq_inv_val]
    rfl
  rw [hinv] at hm
  dsimp only [SimpleRootParameters.word]
  simp only [inv_one, Units.val_one] at *
  calc
    _ = (Tt⁻¹ * (S.roots.rootSubgroup a).includePoint (P.plus.value 1) * Tt) *
      (Tt⁻¹ * (S.roots.rootSubgroup (S.roots.neg a)).includePoint (P.minus.value (-1)) * Tt) *
      (Tt⁻¹ * (S.roots.rootSubgroup a).includePoint (P.plus.value 1) * Tt) := by
        dsimp [Tt, a]; group
    _ = _ := by
      rw [hp, hm]
      simp only [mul_one, mul_neg, Units.val_inv_eq_inv_val]
      rfl

/-- Four normalized opposite-root pairs whose source words recover the
supplied simple coroots. Existence is a geometric obligation: arbitrary
independent root parametrizations do not supply this identity. -/
structure SimpleCorootWordData (S : Geometry K) where
  parameters : ∀ i, SimpleRootParameters S i
  coroot_eq : ∀ i (z : Variety.Point (KMult k)),
    S.torus.includePoint ((S.roots.rootCocharacter (S.simpleRoot i).val).onPoints z) =
      ((parameters i).word 1)⁻¹ * (parameters i).word (dPointEquiv 1 z 0)

omit [IsAlgClosed k] in
/-- The source word belongs to the subgroup generated by its two actual
opposite root subgroups. -/
theorem SimpleRootParameters.word_mem {S : Geometry K} {i : Fin 4}
    (P : SimpleRootParameters S i) (z : kˣ) :
    P.word z ∈ (S.roots.rootSubgroup (S.simpleRoot i).val).toSubgroup ⊔
      (S.roots.rootSubgroup (S.roots.neg (S.simpleRoot i).val)).toSubgroup := by
  apply Subgroup.mul_mem
  · apply Subgroup.mul_mem
    · exact Subgroup.mem_sup_left ((S.roots.rootSubgroup _).pointEquiv _).property
    · exact Subgroup.mem_sup_right ((S.roots.rootSubgroup _).pointEquiv _).property
  · exact Subgroup.mem_sup_left ((S.roots.rootSubgroup _).pointEquiv _).property

end Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound.FixedOpposition.AmbientNormalizer
