module

public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.Exhaustivity.ClassBound.Fusion.ConnectedCentralizer.Bruhat.Basic
public import Theory.SpecificGroups.Triality.PositiveRootCoordinates.Roots

/-!
# The actual positive D4 root chain

Transport the twelve standard positive roots through the root-index equivalence
of `Geometry`. This uses the abstract D4 root enumeration, with no identification
of the ambient algebraic group with a matrix model. The resulting list is
duplicate-free and enumerates exactly the supplied positive roots.

The two separate geometric inputs below concern a root subgroup and the group
generated by the roots after it. Normalization gives existence of coordinates;
trivial intersection gives uniqueness. Their conjunction is used by the
coordinate assembly, but neither input is asserted here.

Source: GLS3, Chapter 1, 1.12.7(a)--(c), and Steinberg 6.2(b),
`refs/KGroup/GLS3/Chapter1.tex`, `refs/KGroup/GLS3/Chapter2St2.tex`.
-/

@[expose] public noncomputable section

namespace Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound
open Theory.AlgebraicGroup
namespace ConnectedCentralizer.Bruhat.Coordinates

universe u
variable {k : Type u} [Field k] [CharP k 2]
  {K : Variety k} [AlgebraicGroup K]

/-- The actual positive root at a position in the increasing-height D4 order. -/
def positiveRoot (S : Geometry K) (i : Fin 12) : S.roots.Root :=
  S.rootIndex.symm (Triality.Standard.PositiveCoordinates.rootIndex i)

theorem positiveRoot_injective (S : Geometry K) :
    Function.Injective (positiveRoot S) :=
  S.rootIndex.symm.injective.comp
    Triality.Standard.PositiveCoordinates.rootIndex_injective

/-- An explicit order of all twelve actual positive roots. -/
def positiveOrder (S : Geometry K) : List S.roots.Root :=
  List.ofFn (positiveRoot S)

theorem positiveOrder_nodup (S : Geometry K) : (positiveOrder S).Nodup :=
  List.nodup_ofFn.mpr (positiveRoot_injective S)

theorem positiveOrder_length (S : Geometry K) : (positiveOrder S).length = 12 :=
  List.length_ofFn

/-- The enumeration has the actual positive set, not an independent label set. -/
theorem mem_positiveOrder (S : Geometry K) (a : S.roots.Root) :
    a ∈ positiveOrder S ↔ a ∈ S.roots.positive := by
  rw [positiveOrder, List.mem_ofFn, S.positive]
  constructor
  · rintro ⟨i, rfl⟩
    simpa only [positiveRoot, Equiv.apply_symm_apply] using
      Triality.Standard.PositiveCoordinates.rootIndex_positive i
  · intro ha
    have hmem : S.rootIndex a ∈
        Set.range Triality.Standard.PositiveCoordinates.rootIndex := by
      rw [Triality.Standard.PositiveCoordinates.range_rootIndex]
      exact ha
    obtain ⟨i, hi⟩ := hmem
    exact ⟨i, by simp only [positiveRoot, hi, Equiv.symm_apply_apply]⟩

/-- The group generated by a tail of the actual root list. -/
def tailGroup (S : Geometry K) (rs : List S.roots.Root) :
    Subgroup (Variety.Point K) :=
  RootSubgroupGenerated S.roots {a | a ∈ rs}

/-- Each root normalizes the group generated by all roots after it.
Normality is relative to the preceding root group, not to the ambient group. -/
def TailNormalizes (S : Geometry K) : Prop :=
  ∀ a rs, (a :: rs).IsSuffix (positiveOrder S) →
    (S.roots.rootSubgroup a).toSubgroup ≤
      Subgroup.normalizer (tailGroup S rs : Set (Variety.Point K))

/-- Each root meets the group generated by all later roots trivially. -/
def TailDisjoint (S : Geometry K) : Prop :=
  ∀ a rs, (a :: rs).IsSuffix (positiveOrder S) →
    (S.roots.rootSubgroup a).toSubgroup ⊓ tailGroup S rs = ⊥

end ConnectedCentralizer.Bruhat.Coordinates
end Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound
