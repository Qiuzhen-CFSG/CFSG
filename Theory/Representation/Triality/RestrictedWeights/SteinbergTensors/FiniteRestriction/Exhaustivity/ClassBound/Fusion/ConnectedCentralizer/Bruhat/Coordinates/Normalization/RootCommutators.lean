module

public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.Exhaustivity.ClassBound.Fusion.ConnectedCentralizer.Bruhat.Coordinates.Normalization.Basic
public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.Exhaustivity.ClassBound.Fusion.ConnectedCentralizer.Bruhat.Coordinates.Normalization.RootCommutators.Closure
public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.Exhaustivity.ClassBound.Fusion.ConnectedCentralizer.Bruhat.Coordinates.Normalization.RootCommutators.RootWeights

/-!
# Reduction of positive D4 root commutators to geometric root support

Take the Zariski closure of the actual subgroup commutator. It is connected,
normalized by the actual torus, and lies in the supplied positive unipotent
radical. If invariant unipotent subgroups are generated by their contained root
subgroups, it remains to identify the weights of those root subgroups. A
mixed-character support theorem supplies positive powers of both input
characters; the realized coroot pairings convert these to the exact positive
D4 correction roots required by `PositiveCommutatorContainment`.

The two geometric inputs are explicit and are not asserted by this module.
This conditional assembly does not establish the unconditional source theorem.
It imports `Normalization.Basic` directly, leaving the tail-normalization
consumer free to import the eventual unconditional result.

Source: GLS3, Chapter 1, Theorems 1.9.5(i) and 1.12.7(b), with the
root-commutator geometry of 1.12.1, `refs/KGroup/GLS3/Chapter1.tex`.
-/

open Theory.AlgebraicGroup
namespace Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound
namespace ConnectedCentralizer.Bruhat.Coordinates.Normalization
noncomputable section
universe u
variable {k : Type u} [Field k] [IsAlgClosed k] [CharP k 2]
  {K : Variety k} [AlgebraicGroup K]

/-- Combine invariant-unipotent root generation and mixed-character support.
Both geometric premises must still be proved before this gives the unconditional
positive-root commutator theorem. All closure and character/root compatibility
hypotheses needed for their combination are discharged here. -/
public theorem positiveCommutatorContainment_of_geometric_inputs (S : Geometry K)
    (hgen : ∀ X : ClosedSubgroup K,
      X ≤ S.bigCell.data.positive_witness.unipotent →
      IsConnected (X : Set (Variety.Point K)) →
      IsClosedSubgroupInvariant S.torus X →
      IsUnipotentAlgebraicGroup X.carrierVariety →
      X.toSubgroup = RootSubgroupGenerated S.roots
        {c | (S.roots.rootSubgroup c).toSubgroup ≤ X.toSubgroup})
    (hsupport : ∀ a ∈ S.roots.positive, ∀ b ∈ S.roots.positive, a ≠ b →
      ∀ c, (S.roots.rootSubgroup c).toSubgroup ≤ (closedPairCommutator S a b).toSubgroup →
      ∃ i j : ℕ, 0 < i ∧ 0 < j ∧
        S.roots.rootWeight c = S.roots.rootWeight a ^ i * S.roots.rootWeight b ^ j) :
    PositiveCommutatorContainment S := by
  intro a ha b hb hab x hx
  have hx' : x ∈ (closedPairCommutator S a b).toSubgroup := subset_closure hx
  rw [hgen (closedPairCommutator S a b) (closedPairCommutator_le_positive S ha hb)
    (closedPairCommutator_connected S a b) (closedPairCommutator_invariant S a b)
    (closedPairCommutator_unipotent S ha hb)] at hx'
  refine RootSubgroupGenerated_mono S.roots ?_ hx'
  intro c hc
  obtain ⟨i, j, hi, hj, hweight⟩ := hsupport a ha b hb hab c hc
  exact positiveCommutatorRoots_of_weight_eq S ha hb hi hj hweight

end
end ConnectedCentralizer.Bruhat.Coordinates.Normalization
end Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ClassBound
