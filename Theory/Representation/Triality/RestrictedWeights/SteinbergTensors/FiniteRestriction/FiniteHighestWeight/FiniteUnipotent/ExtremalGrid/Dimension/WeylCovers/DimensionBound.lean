module

public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.FiniteHighestWeight.FiniteUnipotent.ExtremalGrid.Dimension.WeylCovers.Cyclic
public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.LeftContracts.Extremal
public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.FiniteHighestWeight.FiniteUnipotent.ExtremalGrid.Dimension.WeylCovers.DimensionBound.RootOperators

/-!+# Cyclic dimension bounds from truncated root coefficients

Let A be the algebra generated by root coefficients of orders below q. If
the group normalizes A, and the signed simple-root orbits of the highest
vector lie in A v, then A v is group-invariant: move an operator past each
generating group element. Cyclicity forces A v to be the whole module. A
triangular spanning theorem by the twelve opposite-root coefficients then
gives the dimension bound q^12.

This module proves that deduction for arbitrary cyclic modules, including
reducible modules, with both left-character conventions. The normalization,
rank-one orbit containment, point generation, and triangular spanning
theorems are still explicit premises. Thus the unconditional extremal cyclic
dimension bound is not yet asserted.

Source: Steinberg, *Representations of algebraic groups* (1963), the root
monomials of §2, and GLS3/St2 13.2(d). The infinitesimal argument uses higher
polynomial coefficients instead of factorial division or finite evaluation.
-/

public noncomputable section
namespace Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ExtremalGrid
open Theory.AlgebraicGroup
universe u v
variable {k : Type u} [Field k] [IsAlgClosed k] [CharP k 2]
variable {K : Variety k} [AlgebraicGroup K]
variable {V : Type v} [AddCommGroup V] [Module k V] [FiniteDimensional k V]

namespace CyclicDimension

omit [IsAlgClosed k] [CharP k 2] [FiniteDimensional k V] in
/-- Move an operator through a group element using normalization. -/
theorem action_mem_operatorOrbit (rho : RationalRepresentation K V)
    (A : Subalgebra k (Module.End k V)) (hnorm : Normalizes rho A)
    (v : V) (g : Variety.Point K)
    (hgv : (rho.action g).val v ∈ operatorOrbit A v)
    (w : V) (hw : w ∈ operatorOrbit A v) :
    (rho.action g).val w ∈ operatorOrbit A v := by
  induction hw using Submodule.span_induction with
  | mem w hw =>
      obtain ⟨a, rfl⟩ := hw
      obtain ⟨b, hb, he⟩ := hnorm g a.val a.property
      have he' := LinearMap.congr_fun he v
      exact he'.symm ▸ operatorOrbit_stable A v b hb _ hgv
  | zero => simpa only [map_zero] using (operatorOrbit A v).zero_mem
  | add w z _ _ hw hz => simpa only [map_add] using (operatorOrbit A v).add_mem hw hz
  | smul c w _ hw => simpa only [map_smul] using (operatorOrbit A v).smul_mem c hw

omit [IsAlgClosed k] [CharP k 2] [FiniteDimensional k V] in
/-- Normalization and the generator orbits suffice for invariance of A v. -/
theorem operatorOrbit_invariant (rho : RationalRepresentation K V)
    (A : Subalgebra k (Module.End k V)) (hnorm : Normalizes rho A)
    (v : V) (X : Set (Variety.Point K)) (hgen : Submonoid.closure X = ⊤)
    (hX : ∀ g ∈ X, (rho.action g).val v ∈ operatorOrbit A v) :
    IsInvariantSubmodule rho (operatorOrbit A v) := by
  intro g w hw
  have hg : g ∈ Submonoid.closure X := hgen ▸ Submonoid.mem_top g
  have hi : ∀ z ∈ operatorOrbit A v, (rho.action g).val z ∈ operatorOrbit A v := by
    induction hg using Submonoid.closure_induction with
    | mem g hg => exact fun z hz => action_mem_operatorOrbit rho A hnorm v g (hX g hg) z hz
    | one => intro z hz; simpa using hz
    | mul g h _ _ hg hh =>
        intro z hz
        simpa only [map_mul, Units.val_mul, Module.End.mul_apply] using hg _ (hh z hz)
  exact hi w hw

omit [IsAlgClosed k] [CharP k 2] [FiniteDimensional k V] in
/-- Cyclicity now applies to a subspace proved invariant by the preceding argument. -/
theorem operatorOrbit_eq_top (rho : RationalRepresentation K V)
    (A : Subalgebra k (Module.End k V)) (hnorm : Normalizes rho A)
    (v : V) (hcyc : IsCyclicRepresentation rho v)
    (X : Set (Variety.Point K)) (hgen : Submonoid.closure X = ⊤)
    (hX : ∀ g ∈ X, (rho.action g).val v ∈ operatorOrbit A v) :
    operatorOrbit A v = ⊤ :=
  hcyc _ (operatorOrbit_invariant rho A hnorm v X hgen hX) (mem_operatorOrbit A v)

/-- Conditional dimension deduction from actual coefficient-algebra mathematics.
The spanning premise concerns the algebra orbit, not the whole representation. -/
theorem finrank_le_of_rootCoefficients (S : Geometry K)
    (rho : RationalRepresentation K V) (hr : IsRationalRepresentation rho)
    (q : ℕ) (v : V) (hcyc : IsCyclicRepresentation rho v)
    (r : Fin 12 → S.roots.Root)
    (hnorm : Normalizes rho (coefficientAlgebra S rho hr q))
    (hgen : Submonoid.closure (simpleRootPoints S) = ⊤)
    (hroot : ∀ g ∈ simpleRootPoints S,
      (rho.action g).val v ∈ operatorOrbit (coefficientAlgebra S rho hr q) v)
    (htri : operatorOrbit (coefficientAlgebra S rho hr q) v ≤
      orderedCoefficientSpan S rho hr r q v) :
    Module.finrank k V ≤ q ^ 12 := by
  have htop := operatorOrbit_eq_top rho _ hnorm v hcyc _ hgen hroot
  have hspan : orderedCoefficientSpan S rho hr r q v = ⊤ :=
    top_unique (htop ▸ htri)
  calc
    Module.finrank k V = Module.finrank k (⊤ : Submodule k V) := (finrank_top k V).symm
    _ = Module.finrank k (orderedCoefficientSpan S rho hr r q v) :=
      congrArg (fun U : Submodule k V => Module.finrank k U) hspan.symm
    _ ≤ q ^ 12 := finrank_orderedCoefficientSpan_le S rho hr r q v

end CyclicDimension

open CyclicDimension

/-- The positive-Borel conclusion, conditional on the distribution inputs for
every actual cyclic highest-weight module. No irreducibility is required. -/
theorem positive_cyclicDimensionBound_of_rootCoefficients (S : Geometry K) (n : ℕ)
    (hgen : Submonoid.closure (simpleRootPoints S) = ⊤)
    (hnorm : ∀ C : CyclicHighestWeightModule S S.bigCell.data.B
        (S.leftWeightEmbedding (maximalRestrictedWeight n)),
      Normalizes C.action (coefficientAlgebra S C.action C.rational (2 ^ n)))
    (hroot : ∀ C : CyclicHighestWeightModule S S.bigCell.data.B
        (S.leftWeightEmbedding (maximalRestrictedWeight n)),
      ∀ g ∈ simpleRootPoints S, (C.action.action g).val C.vector ∈
        operatorOrbit (coefficientAlgebra S C.action C.rational (2 ^ n)) C.vector)
    (htri : ∀ C : CyclicHighestWeightModule S S.bigCell.data.B
        (S.leftWeightEmbedding (maximalRestrictedWeight n)),
      operatorOrbit (coefficientAlgebra S C.action C.rational (2 ^ n)) C.vector ≤
        orderedCoefficientSpan S C.action C.rational (negativeCoordinateRoot S)
          (2 ^ n) C.vector) :
    CyclicHighestWeightDimensionBound S S.bigCell.data.B
      (S.leftWeightEmbedding (maximalRestrictedWeight n)) ((2 ^ n) ^ 12) := by
  intro C
  exact finrank_le_of_rootCoefficients S C.action C.rational (2 ^ n) C.vector
    C.cyclic _ (hnorm C) hgen (hroot C) (htri C)

/-- The opposite-Borel conclusion uses the inverse left character and the
positive-root ordered coefficients. The hypotheses include n=1. -/
theorem opposite_cyclicDimensionBound_of_rootCoefficients (S : Geometry K) (n : ℕ)
    (hgen : Submonoid.closure (simpleRootPoints S) = ⊤)
    (hnorm : ∀ C : CyclicHighestWeightModule S S.bigCell.data.Bopp
        (S.leftWeightEmbedding (maximalRestrictedWeight n))⁻¹,
      Normalizes C.action (coefficientAlgebra S C.action C.rational (2 ^ n)))
    (hroot : ∀ C : CyclicHighestWeightModule S S.bigCell.data.Bopp
        (S.leftWeightEmbedding (maximalRestrictedWeight n))⁻¹,
      ∀ g ∈ simpleRootPoints S, (C.action.action g).val C.vector ∈
        operatorOrbit (coefficientAlgebra S C.action C.rational (2 ^ n)) C.vector)
    (htri : ∀ C : CyclicHighestWeightModule S S.bigCell.data.Bopp
        (S.leftWeightEmbedding (maximalRestrictedWeight n))⁻¹,
      operatorOrbit (coefficientAlgebra S C.action C.rational (2 ^ n)) C.vector ≤
        orderedCoefficientSpan S C.action C.rational (positiveCoordinateRoot S)
          (2 ^ n) C.vector) :
    CyclicHighestWeightDimensionBound S S.bigCell.data.Bopp
      (S.leftWeightEmbedding (maximalRestrictedWeight n))⁻¹ ((2 ^ n) ^ 12) := by
  intro C
  exact finrank_le_of_rootCoefficients S C.action C.rational (2 ^ n) C.vector
    C.cyclic _ (hnorm C) hgen (hroot C) (htri C)

end Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ExtremalGrid
