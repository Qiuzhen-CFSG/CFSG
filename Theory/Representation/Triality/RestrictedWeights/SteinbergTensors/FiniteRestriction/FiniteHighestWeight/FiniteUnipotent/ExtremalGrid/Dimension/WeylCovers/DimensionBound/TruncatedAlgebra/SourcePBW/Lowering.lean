module

public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.FiniteHighestWeight.FiniteUnipotent.ExtremalGrid.Dimension.WeylCovers.DimensionBound.TruncatedAlgebra.SourcePBW.RootFamily
public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.FiniteHighestWeight.FiniteUnipotent.ExtremalGrid.Dimension.WeylCovers.DimensionBound.TruncatedAlgebra.SourcePBW.Signs

/-!
# The ordered span of the actual lowering algebra orbit

For either source root sign, the closed-family PBW theorem applies to the
literal twelve coordinate roots. Evaluating its endomorphism span on the
original vector gives the ordered coefficient span used by DimensionBound.
Wordwise stability suffices to act on the full algebra orbit, by the
standard span description of an algebra generated by a family.
-/

open Theory.AlgebraicGroup CoefficientPBW
namespace Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ExtremalGrid.CyclicDimension.SourcePBW
@[expose] public noncomputable section
universe u v
variable {k : Type u} [Field k] [IsAlgClosed k] [CharP k 2]
variable {K : Variety k} [AlgebraicGroup K]
variable {V : Type v} [AddCommGroup V] [Module k V] [FiniteDimensional k V]
def sideCoefficient (S:Geometry K) (rho:RationalRepresentation K V) (hr:IsRationalRepresentation rho)
    (negative:Bool) (q:ℕ) (p:Fin 12 × Fin q) : Module.End k V :=
  rootCoefficient S rho hr (sideRoot S negative p.1) p.2
def sideAlgebra (S:Geometry K) (rho:RationalRepresentation K V) (hr:IsRationalRepresentation rho)
    (negative:Bool) (q:ℕ) : Subalgebra k (Module.End k V) :=
  Algebra.adjoin k (Set.range (sideCoefficient S rho hr negative q))
lemma sideCoefficient_mem (S:Geometry K) (rho:RationalRepresentation K V) (hr:IsRationalRepresentation rho)
    (negative:Bool) (q:ℕ) (i:Fin 12) (j:ℕ) (hj:j<q) :
    rootCoefficient S rho hr (sideRoot S negative i) j∈sideAlgebra S rho hr negative q :=
  Algebra.subset_adjoin ⟨(i,⟨j,hj⟩),rfl⟩
lemma sideOrbit_le_ordered (S:Geometry K) (hrel:RootPairParameterRelations S)
    (rho:RationalRepresentation K V) (hr:IsRationalRepresentation rho)
    (negative:Bool) (n:ℕ) (v:V) :
    operatorOrbit (sideAlgebra S rho hr negative (2^n)) v ≤
      orderedCoefficientSpan S rho hr (sideRoot S negative) (2^n) v := by
  apply Submodule.span_le.mpr
  rintro _ ⟨a,rfl⟩
  have ha:=rootFamily_algebra_spanned S hrel rho hr (sideRoot S negative) n
    (sideRoot_no_opposite S negative) (sideRoot_sum_closed S negative) a.property
  change a.val v∈_
  generalize he : a.val = x at ha ⊢
  clear he
  induction ha using Submodule.span_induction with
  | mem a ha =>
    obtain ⟨f,rfl⟩ := ha
    exact Submodule.subset_span ⟨f,rfl⟩
  | zero => exact (orderedCoefficientSpan S rho hr (sideRoot S negative) (2^n) v).zero_mem
  | add a b _ _ ha hb => exact (orderedCoefficientSpan S rho hr (sideRoot S negative) (2^n) v).add_mem ha hb
  | smul c a _ ha => exact (orderedCoefficientSpan S rho hr (sideRoot S negative) (2^n) v).smul_mem c ha

omit [IsAlgClosed k] [CharP k 2] [FiniteDimensional k V] in
lemma operatorOrbit_le_of_words {I:Type*} (X:I→Module.End k V) (v:V) (U:Submodule k V)
    (hw:∀w:List I,wordValue X w v∈U) :
    operatorOrbit (Algebra.adjoin k (Set.range X)) v≤U := by
  let ev:Module.End k V→ₗ[k]V := {
    toFun:=fun f=>f v
    map_add':=fun _ _=>rfl
    map_smul':=fun _ _=>rfl}
  have hU: (Algebra.adjoin k (Set.range X)).toSubmodule≤U.comap ev :=
    adjoin_le_of_words X (U.comap ev) hw
  apply Submodule.span_le.mpr
  rintro _ ⟨a,rfl⟩
  exact hU a.property

omit [IsAlgClosed k] [CharP k 2] [FiniteDimensional k V] in
lemma map_operatorOrbit_mem_of_words {I:Type*} (X:I→Module.End k V) (v:V)
    (U:Submodule k V) (E:Module.End k V) (hw:∀w:List I,E (wordValue X w v)∈U)
    (z:V) (hz:z∈operatorOrbit (Algebra.adjoin k (Set.range X)) v) : E z∈U :=
  operatorOrbit_le_of_words X v (U.comap E) hw hz
end
end Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ExtremalGrid.CyclicDimension.SourcePBW
