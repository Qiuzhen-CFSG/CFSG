module

public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.FiniteHighestWeight.FiniteUnipotent.ExtremalGrid.Dimension.WeylCovers.DimensionBound.RootOperators
public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.FiniteHighestWeight.FiniteUnipotent.ExtremalGrid.Dimension.WeylCovers.DimensionBound.SimpleRootOrbits.ChartTransport
public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.FiniteHighestWeight.FiniteUnipotent.ExtremalGrid.Dimension.WeylCovers.DimensionBound.SimpleRootOrbits.PointGeneration

/-!
# Simple-root orbits of cyclic extremal highest-weight modules

The compatible rank-one charts give the degree bound `2^n - 1` for each
lowering simple-root orbit. The raising root fixes the highest vector.
Scalar reparametrization transports both conclusions to `Geometry.rootParameter`.
For the opposite Borel the character is inverted and the root directions swap.
Thus every signed simple-root point sends the highest vector into the orbit
of the actual algebra generated by coefficients of order less than `2^n`.

These are local rank-one bounds. The imported point-generation reduction still
requires actual root-subgroup uniqueness. Its unconditional discharge, and the
normalization of the coefficient algebra, are separate obligations.
Sources: GLS3 §§1.9, 1.12, 1.14; Steinberg (6.1), 13.2(d).
-/

public noncomputable section
namespace Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ExtremalGrid.CyclicDimension
open Theory.AlgebraicGroup
open ClassBound.FixedOpposition.AmbientNormalizer.CorootRealization
universe u
variable {k : Type u} [Field k] [IsAlgClosed k] [CharP k 2]
variable {K : Variety k} [AlgebraicGroup K]

private theorem maximalRestrictedWeight_coordinate (n : ℕ) (i : Fin 4) :
    maximalRestrictedWeight n i = ((2 ^ n - 1 : ℕ) : ℤ) := by
  have hp : 0 < (2 : ℕ) ^ n := pow_pos (by decide) _
  dsimp [maximalRestrictedWeight]
  rw [Nat.cast_sub (by omega), Nat.cast_pow]
  norm_num

/-- All signed simple-root coefficients of order at least `2^n` kill the
positive extremal highest vector, for every actual cyclic module. -/
theorem cyclicHighest_simpleRootCoefficient_eq_zero (S : Geometry K)
    (hcharts : ∀ i : Fin 4, Nonempty (SimpleRootSL2Chart S i)) (n : ℕ)
    (C : CyclicHighestWeightModule S S.bigCell.data.B
      (S.leftWeightEmbedding (maximalRestrictedWeight n)))
    (i : Fin 4) (r : S.roots.Root)
    (hr : r = (S.simpleRoot i).val ∨ r = S.roots.neg (S.simpleRoot i).val)
    (j : ℕ) (hj : 2 ^ n ≤ j) : rootCoefficient S C.action C.rational r j C.vector = 0 := by
  have hp : 0 < (2 : ℕ) ^ n := pow_pos (by decide) _
  rcases hr with rfl | rfl
  · apply rootCoefficient_eq_zero_of_positive_highest S C.action C.rational C.vector C.highest
      _ ?_ j (by omega)
    exact ((S.realized.2.2.2.2.2.2.2.2.2.2.2.1 _).mp (S.simpleRoot i).property).1
  · exact negative_simple_rootCoefficient_eq_zero S i (Classical.choice (hcharts i))
      C.action C.rational C.vector (maximalRestrictedWeight n) (2 ^ n - 1)
      (maximalRestrictedWeight_coordinate n i) C.highest j (by omega)

/-- The opposite extremal highest vector has the same bound, with the literal
opposite Borel and inverse highest character. -/
theorem cyclicOppositeHighest_simpleRootCoefficient_eq_zero (S : Geometry K)
    (hcharts : ∀ i : Fin 4, Nonempty (SimpleRootSL2Chart S i)) (n : ℕ)
    (C : CyclicHighestWeightModule S S.bigCell.data.Bopp
      (S.leftWeightEmbedding (maximalRestrictedWeight n))⁻¹)
    (i : Fin 4) (r : S.roots.Root)
    (hr : r = (S.simpleRoot i).val ∨ r = S.roots.neg (S.simpleRoot i).val)
    (j : ℕ) (hj : 2 ^ n ≤ j) : rootCoefficient S C.action C.rational r j C.vector = 0 := by
  have hp : 0 < (2 : ℕ) ^ n := pow_pos (by decide) _
  rcases hr with rfl | rfl
  · exact positive_simple_rootCoefficient_eq_zero_of_opposite S i
      (Classical.choice (hcharts i)) C.action C.rational C.vector
      (maximalRestrictedWeight n) (2 ^ n - 1)
      (maximalRestrictedWeight_coordinate n i) C.highest j (by omega)
  · apply rootCoefficient_eq_zero_of_negative_highest S C.action C.rational C.vector C.highest
      _ ?_ j (by omega)
    rw [S.realized.neg_neg]
    exact ((S.realized.2.2.2.2.2.2.2.2.2.2.2.1 _).mp (S.simpleRoot i).property).1

/-- Each actual signed simple-root point preserves the positive highest vector's
membership in the truncated coefficient-algebra orbit. -/
theorem cyclicHighest_simpleRootAction_mem (S : Geometry K)
    (hcharts : ∀ i : Fin 4, Nonempty (SimpleRootSL2Chart S i)) (n : ℕ)
    (C : CyclicHighestWeightModule S S.bigCell.data.B
      (S.leftWeightEmbedding (maximalRestrictedWeight n)))
    (g : Variety.Point K) (hg : g ∈ simpleRootPoints S) :
    (C.action.action g).val C.vector ∈
      operatorOrbit (coefficientAlgebra S C.action C.rational (2 ^ n)) C.vector := by
  obtain ⟨⟨i, b, t⟩, rfl⟩ := hg
  apply rootAction_mem_of_highCoefficients_zero
  intro j hj
  exact cyclicHighest_simpleRootCoefficient_eq_zero S hcharts n C i _
    (by cases b <;> simp) j hj

/-- The same conclusion for the opposite highest vector, without changing its
character or replacing the ambient group. -/
theorem cyclicOppositeHighest_simpleRootAction_mem (S : Geometry K)
    (hcharts : ∀ i : Fin 4, Nonempty (SimpleRootSL2Chart S i)) (n : ℕ)
    (C : CyclicHighestWeightModule S S.bigCell.data.Bopp
      (S.leftWeightEmbedding (maximalRestrictedWeight n))⁻¹)
    (g : Variety.Point K) (hg : g ∈ simpleRootPoints S) :
    (C.action.action g).val C.vector ∈
      operatorOrbit (coefficientAlgebra S C.action C.rational (2 ^ n)) C.vector := by
  obtain ⟨⟨i, b, t⟩, rfl⟩ := hg
  apply rootAction_mem_of_highCoefficients_zero
  intro j hj
  exact cyclicOppositeHighest_simpleRootCoefficient_eq_zero S hcharts n C i _
    (by cases b <;> simp) j hj

end Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ExtremalGrid.CyclicDimension
