module

public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.FiniteHighestWeight.FiniteUnipotent.ExtremalGrid.NormSections.PolynomialBounds.DividedPowerEndpoint.Operators
public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.FiniteHighestWeight.FiniteUnipotent.ExtremalGrid.NormSections.PolynomialBounds.WeightCone.RootActions

/-!
# Highest torus weight spaces in cyclic D4 modules

A finite-dimensional rational representation generated by a highest vector
has a one-dimensional space of its highest torus weight. This holds for both
actual Borels and for any highest character, without irreducibility. The
extremal specializations use the corrected left character and its inverse;
they include `n = 1` and require no finite-restriction or dimension formula.

The raw character coordinates define an integral height with coefficients
`(3,5,3,3)`. The actual D4 Cartan pairing gives height one on every simple
root, and induction on positive roots proves strict positivity. Reverse its
sign for the positive highest-weight argument. Polynomial coefficients of
opposite-root actions then lower height strictly in every positive degree;
the degree-zero coefficient is the identity. Thus the highest line plus all
strictly lower weight spaces is opposite-Borel stable. Big-cell density and
cyclicity make this sum the whole module, and independence of torus weight
spaces gives the asserted line equality.

Source: GLS3 §1.14, especially Definitions 1.14.3 and 1.14.5 and the cyclic
highest-weight setting of 1.14.6(d); Steinberg, *Representations of algebraic
groups* (1963), §§2 and 4. The raw GLS inverse-conjugation characters and the
actual root subgroups are unchanged, in accordance with the triality coroot
convention audit. Higher coefficients avoid factorial division in
characteristic two.
-/

open Theory.AlgebraicGroup
namespace Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ExtremalGrid.DividedPowerEndpoint
open WeightCone
public noncomputable section
universe u v
variable {k : Type u} [Field k] [IsAlgClosed k]
variable {K : Variety k} [AlgebraicGroup K] {T : ClosedSubgroup K}
variable {V : Type v} [AddCommGroup V] [Module k V] [FiniteDimensional k V]

omit [IsAlgClosed k] in
private theorem height_shift (h : TorusWeight T → ℤ)
    (hmul : ∀ a b, h (a * b) = h a + h b) (mu beta : TorusWeight T) (n : ℕ) :
    h (mu * (beta⁻¹) ^ n) = h mu - (n : ℤ) * h beta := by
  have h1 : h 1 = 0 := by have := hmul 1 1; simp only [one_mul] at this; omega
  have hinv : h beta⁻¹ = -h beta := by
    have := hmul beta beta⁻¹
    rw [mul_inv_cancel, h1] at this
    omega
  have hpow : h ((beta⁻¹) ^ n) = -(n : ℤ) * h beta := by
    induction n with
    | zero => simp [h1]
    | succ n ih => rw [pow_succ, hmul, ih, hinv]; push_cast; ring
  rw [hmul, hpow]
  ring

private def strictSpace (rho : RationalRepresentation K V)
    (h : TorusWeight T → ℤ) (chi : TorusWeight T) : Submodule k V :=
  ⨆ mu ∈ {mu | h mu < h chi}, weightSpace rho T mu

private def lineLower (rho : RationalRepresentation K V)
    (h : TorusWeight T → ℤ) (chi : TorusWeight T) (v : V) : Submodule k V :=
  Submodule.span k {v} ⊔ strictSpace rho h chi

omit [IsAlgClosed k] [FiniteDimensional k V] in
private theorem weight_le_strict (rho : RationalRepresentation K V)
    (h : TorusWeight T → ℤ) (chi mu : TorusWeight T) (hm : h mu < h chi) :
    weightSpace rho T mu ≤ strictSpace rho h chi :=
  le_iSup_of_le mu (le_iSup_of_le hm le_rfl)

omit [IsAlgClosed k] [FiniteDimensional k V] in
private theorem lineLower_map (rho : RationalRepresentation K V)
    (h : TorusWeight T → ℤ) (chi : TorusWeight T) (v : V) (A : Module.End k V)
    (hv : A v ∈ lineLower rho h chi v)
    (hmu : ∀ mu, h mu < h chi → ∀ w ∈ weightSpace rho T mu,
      A w ∈ lineLower rho h chi v) :
    ∀ w ∈ lineLower rho h chi v, A w ∈ lineLower rho h chi v := by
  intro w hw
  obtain ⟨x, hx, y, hy, rfl⟩ := Submodule.mem_sup.mp hw
  have hx' : A x ∈ lineLower rho h chi v := by
    obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hx
    simpa only [map_smul] using (lineLower rho h chi v).smul_mem c hv
  have hy' : A y ∈ lineLower rho h chi v := by
    refine Submodule.iSup_induction _ (motive := fun y => A y ∈ lineLower rho h chi v)
      hy ?_ ?_ ?_
    · intro mu y hy
      refine Submodule.iSup_induction _ (motive := fun y => A y ∈ lineLower rho h chi v)
        hy ?_ ?_ ?_
      · intro hm y hy
        exact hmu mu hm y hy
      · simp
      · intro y z hy hz
        simpa only [map_add] using (lineLower rho h chi v).add_mem hy hz
    · simp
    · intro y z hy hz
      simpa only [map_add] using (lineLower rho h chi v).add_mem hy hz
  simpa only [map_add] using (lineLower rho h chi v).add_mem hx' hy'

omit [IsAlgClosed k] [FiniteDimensional k V] in
private theorem lineLower_torus (rho : RationalRepresentation K V)
    (h : TorusWeight T → ℤ) (chi : TorusWeight T) (v : V)
    (hv : v ∈ weightSpace rho T chi) (t : Variety.Point T.carrierVariety) :
    ∀ w ∈ lineLower rho h chi v,
      (rho.action (T.includePoint t)).1 w ∈ lineLower rho h chi v := by
  apply lineLower_map
  · rw [hv t]
    exact (lineLower rho h chi v).smul_mem _
      (show v ∈ lineLower rho h chi v from Submodule.mem_sup_left (Submodule.subset_span (by simp)))
  · intro mu hm w hw
    rw [hw t]
    exact (lineLower rho h chi v).smul_mem _
      (Submodule.mem_sup_right (weight_le_strict rho h chi mu hm hw))

private theorem lineLower_root (D : RootGroupData K T) (hD : D.IsRealization)
    (rho : RationalRepresentation K V) (hr : IsRationalRepresentation rho)
    (h : TorusWeight T → ℤ) (hmul : ∀ a b, h (a * b) = h a + h b)
    (chi : TorusWeight T) (v : V) (hv : v ∈ weightSpace rho T chi)
    (a : D.Root) (ha : 0 < h (D.rootWeight a))
    (x : OneParameterParametrization (D.rootSubgroup a).carrierVariety)
    (g : Variety.Point K) (hg : g ∈ D.rootSubgroup a) :
    ∀ w ∈ lineLower rho h chi v, (rho.action g).1 w ∈ lineLower rho h chi v := by
  let y := (D.rootSubgroup a).pointEquiv.symm ⟨g, hg⟩
  let z := x.inv.onPoints y
  let c := Multiplicative.toAdd (additiveGroupPointEquiv k z)
  have hcz : kPlusPoint c = z := by
    apply (additiveGroupPointEquiv k).injective
    simp [kPlusPoint, c]
  have hxg : (WeightCone.rootCurve D a x).onPoints (kPlusPoint c) = g := by
    change (D.rootSubgroup a).includePoint (x.hom.onPoints (kPlusPoint c)) = g
    rw [hcz, x.inv_hom_id]
    exact congrArg Subtype.val ((D.rootSubgroup a).pointEquiv.apply_symm_apply ⟨g, hg⟩)
  rw [← hxg]
  intro w hw
  apply curve_action_mem_of_coefficients rho hr (WeightCone.rootCurve D a x)
  intro n
  apply lineLower_map rho h chi v (WeightCone.curveCoefficient rho hr _ n) ?_ ?_ w hw
  · by_cases hn : n = 0
    · subst n
      have hz : WeightCone.curveCoefficient rho hr (WeightCone.rootCurve D a x) 0 = 1 :=
        CyclicDimension.curveCoefficient_zero rho hr _
      rw [hz, Module.End.one_apply]
      exact Submodule.mem_sup_left (Submodule.subset_span (by simp))
    · apply Submodule.mem_sup_right
      apply weight_le_strict rho h chi _ _ (root_coefficient_weight D hD rho hr a x n hv)
      rw [height_shift h hmul]
      have : 0 < (n : ℤ) * h (D.rootWeight a) := mul_pos (by omega) ha
      omega
  · intro mu hm z hz
    apply Submodule.mem_sup_right
    apply weight_le_strict rho h chi _ _ (root_coefficient_weight D hD rho hr a x n hz)
    rw [height_shift h hmul]
    have : 0 ≤ (n : ℤ) * h (D.rootWeight a) := mul_nonneg (by omega) (le_of_lt ha)
    omega

private theorem lineLower_borel (D : RootGroupData K T) (hD : D.IsRealization)
    (rho : RationalRepresentation K V) (hr : IsRationalRepresentation rho)
    (h : TorusWeight T → ℤ) (hmul : ∀ a b, h (a * b) = h a + h b)
    (chi : TorusWeight T) (v : V) (hv : v ∈ weightSpace rho T chi)
    {P : Set D.Root} {B : ClosedSubgroup K} (hB : IsBorelOfPositiveSystem D P B)
    (hP : ∀ a ∈ P, 0 < h (D.rootWeight a))
    (x : ∀ a, OneParameterParametrization (D.rootSubgroup a).carrierVariety)
    (g : Variety.Point K) (hg : g ∈ B) :
    ∀ w ∈ lineLower rho h chi v, (rho.action g).1 w ∈ lineLower rho h chi v := by
  let W := lineLower rho h chi v
  have hgen (g : Variety.Point K) (hg : g ∈ RootSubgroupGenerated D P) :
      (∀ w ∈ W, (rho.action g).1 w ∈ W) ∧
      (∀ w ∈ W, (rho.action g⁻¹).1 w ∈ W) := by
    apply Subgroup.closure_induction (p := fun g _ =>
      (∀ w ∈ W, (rho.action g).1 w ∈ W) ∧
      (∀ w ∈ W, (rho.action g⁻¹).1 w ∈ W)) ?_ ?_ ?_ ?_ hg
    · intro g hg
      simp only [Set.mem_iUnion] at hg
      obtain ⟨a, ha, hg⟩ := hg
      exact ⟨lineLower_root D hD rho hr h hmul chi v hv a (hP a ha) (x a) g hg,
        lineLower_root D hD rho hr h hmul chi v hv a (hP a ha) (x a) g⁻¹
          ((D.rootSubgroup a).inv_mem hg)⟩
    · constructor <;> intro w hw <;> simpa using hw
    · intro g f hg hf hgw hfw
      constructor
      · intro w hw
        simpa only [map_mul, Units.val_mul, Module.End.mul_apply] using hgw.1 _ (hfw.1 w hw)
      · intro w hw
        simpa only [mul_inv_rev, map_mul, Units.val_mul, Module.End.mul_apply] using
          hfw.2 _ (hgw.2 w hw)
    · intro g hg hgw
      simpa only [inv_inv] using hgw.symm
  obtain ⟨t, u, ht, hu, rfl⟩ := (BorelOfPositiveSystem.pointwise_decomposition hB g).mp hg
  let t' := T.pointEquiv.symm ⟨t, ht⟩
  have ht' : T.includePoint t' = t := congrArg Subtype.val (T.pointEquiv.apply_symm_apply ⟨t, ht⟩)
  intro w hw
  rw [← ht', map_mul]
  exact lineLower_torus rho h chi v hv t' _ ((hgen u hu).1 w hw)

open scoped Pointwise in
private theorem cyclic_highestLine (D : RootGroupData K T) (hD : D.IsRealization)
    (rho : RationalRepresentation K V) (hr : IsRationalRepresentation rho)
    (B C : ClosedSubgroup K)
    (hdense : Dense ((C.toSubgroup : Set (Variety.Point K)) *
      (B.toSubgroup : Set (Variety.Point K))))
    {P : Set D.Root} (hC : IsBorelOfPositiveSystem D P C)
    (h : TorusWeight T → ℤ) (hmul : ∀ a b, h (a * b) = h a + h b)
    (hP : ∀ a ∈ P, 0 < h (D.rootWeight a))
    (x : ∀ a, OneParameterParametrization (D.rootSubgroup a).carrierVariety)
    (chi : TorusWeight T) (v : V) (hv : HasHighWeight rho B T v chi)
    (hcyc : IsCyclicRepresentation rho v) :
    weightSpace rho T chi = Submodule.span k {v} := by
  let W := lineLower rho h chi v
  have htop : W = ⊤ := by
    apply submodule_eq_top_of_dense_product rho hr B C hdense v hv.1 hcyc W
      (Submodule.mem_sup_left (Submodule.subset_span (by simp)))
    intro g hg
    exact lineLower_borel D hD rho hr h hmul chi v hv.2.2 hC hP x g hg
  have hline : Submodule.span k {v} ≤ weightSpace rho T chi :=
    Submodule.span_le.mpr (by intro w hw; simpa using Set.mem_singleton_iff.mp hw ▸ hv.2.2)
  apply le_antisymm ?_ hline
  intro w hw
  have hwW : w ∈ W := htop ▸ Submodule.mem_top
  obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp hwW
  have hbweight : b ∈ weightSpace rho T chi := by
    have he : b = w - a := by rw [← hab]; abel
    rw [he]
    exact (weightSpace rho T chi).sub_mem hw (hline ha)
  have hdis : Disjoint (weightSpace rho T chi) (strictSpace rho h chi) :=
    (weightSpace_iSupIndep rho T).disjoint_biSup (y := {mu | h mu < h chi}) (by simp)
  have hb0 : b = 0 := (Submodule.disjoint_def.mp hdis) b hbweight hb
  rw [hb0, add_zero] at hab
  exact hab ▸ ha


variable [CharP k 2]
open Theory.AlgebraicGroup.StandardRootSystem D4RestrictedWeight

private def rawHeight (S : Geometry K) (chi : TorusWeight S.torus) : ℤ :=
  let a := (S.weight.symm chi).toAdd
  3 * a 0 + 5 * a 1 + 3 * a 2 + 3 * a 3

omit [IsAlgClosed k] in
private theorem rawHeight_mul (S : Geometry K) (a b : TorusWeight S.torus) :
    rawHeight S (a * b) = rawHeight S a + rawHeight S b := by
  simp only [rawHeight, map_mul]
  change 3 * ((S.weight.symm a).toAdd 0 + (S.weight.symm b).toAdd 0) +
      5 * ((S.weight.symm a).toAdd 1 + (S.weight.symm b).toAdd 1) +
      3 * ((S.weight.symm a).toAdd 2 + (S.weight.symm b).toAdd 2) +
      3 * ((S.weight.symm a).toAdd 3 + (S.weight.symm b).toAdd 3) = _
  ring

omit [IsAlgClosed k] in
private theorem rawHeight_inv (S : Geometry K) (a : TorusWeight S.torus) :
    rawHeight S a⁻¹ = -rawHeight S a := by
  simp only [rawHeight, map_inv]
  change 3 * -(S.weight.symm a).toAdd 0 + 5 * -(S.weight.symm a).toAdd 1 +
    3 * -(S.weight.symm a).toAdd 2 + 3 * -(S.weight.symm a).toAdd 3 = _
  ring

omit [IsAlgClosed k] in
private theorem rawHeight_root (S : Geometry K) (a : S.roots.Root) :
    rawHeight S (S.roots.rootWeight a) =
      3 * S.roots.pairing a (S.simpleRoot 0).val +
      5 * S.roots.pairing a (S.simpleRoot 1).val +
      3 * S.roots.pairing a (S.simpleRoot 2).val +
      3 * S.roots.pairing a (S.simpleRoot 3).val := by
  have hc := rootWeight_character S a
  rw [S.leftWeightEmbedding_eq_inv] at hc
  have he : S.weight (Multiplicative.ofAdd (rootWeight S a)) = S.roots.rootWeight a :=
    inv_injective hc
  rw [rawHeight, ← he, S.weight.symm_apply_apply]
  rfl

omit [IsAlgClosed k] in
private theorem rawHeight_simple (S : Geometry K) (i : Fin 4) :
    rawHeight S (S.roots.rootWeight (S.simpleRoot i).val) = 1 := by
  have hp (j : Fin 4) : S.roots.pairing (S.simpleRoot i).val (S.simpleRoot j).val =
      typeDCartanMatrix 2 i j := by
    apply Int.cast_injective (α := ℝ)
    simpa only [S.simpleRoot_index, typeDRootPairing_simpleIndex_pairing] using
      S.based.1 (S.simpleRoot i).val (S.simpleRoot j).val
  rw [rawHeight_root]
  simp only [hp]
  fin_cases i <;> norm_num [typeDCartanMatrix] <;> decide

omit [IsAlgClosed k] in
private theorem rawHeight_positive (S : Geometry K) (a : S.roots.Root)
    (ha : a ∈ S.roots.positive) : 0 < rawHeight S (S.roots.rootWeight a) := by
  obtain ⟨_, _, _, _, hadd, _, _, _, _, hheight, hpositive, hsimpleIff, _⟩ := S.realized
  have aux : ∀ n (a : S.roots.Root), (S.roots.height a).toNat = n → a ∈ S.roots.positive →
      0 < rawHeight S (S.roots.rootWeight a) := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro a han ha
      by_cases hs : a ∈ S.roots.simple
      · obtain ⟨i, hi⟩ := S.simpleRoot.surjective ⟨a, hs⟩
        have hi' : (S.simpleRoot i).val = a := congrArg Subtype.val hi
        rw [← hi', rawHeight_simple]
        decide
      have hsplit : ∃ b c, S.roots.add b c = some a ∧ b ∈ S.roots.positive ∧
          c ∈ S.roots.positive := by
        by_contra hn
        apply hs
        refine (hsimpleIff a).mpr ⟨ha, ?_⟩
        intro b c hbc hpos
        exact hn ⟨b, c, hbc, hpos⟩
      obtain ⟨b, c, hbc, hb, hc⟩ := hsplit
      have hbpos : 0 < S.roots.height b := by simpa [hpositive] using hb
      have hcpos : 0 < S.roots.height c := by simpa [hpositive] using hc
      have habc := hheight b c a hbc
      have hbM := ih (S.roots.height b).toNat (by omega) b rfl hb
      have hcM := ih (S.roots.height c).toNat (by omega) c rfl hc
      rw [hadd b c a hbc, rawHeight_mul]
      omega
  exact aux _ a rfl ha

/-- The whole highest torus weight space of a cyclic positive highest-weight module is a line. -/
theorem positive_highest_weightSpace (S : Geometry K)
    (rho : RationalRepresentation K V) (hr : IsRationalRepresentation rho)
    {chi : TorusWeight S.torus} {v : V}
    (hv : HasHighWeight rho S.bigCell.data.B S.torus v chi)
    (hcyc : IsCyclicRepresentation rho v) :
    weightSpace rho S.torus chi = Submodule.span k {v} := by
  apply cyclic_highestLine S.roots S.realized rho hr
    S.bigCell.data.B S.bigCell.data.Bopp (reverse_product_dense S.bigCell)
    S.bigCell.data.opposite_witness (fun mu => -rawHeight S mu)
    (fun a b => by rw [rawHeight_mul]; omega) ?_ S.rootParameter chi v hv hcyc
  intro a ha
  have hp := rawHeight_positive S (S.roots.neg a) ha
  rw [S.realized.2.2.2.1, rawHeight_inv] at hp
  exact hp

/-- The same cyclic theorem for the actual opposite Borel, with arbitrary highest character. -/
theorem opposite_highest_weightSpace (S : Geometry K)
    (rho : RationalRepresentation K V) (hr : IsRationalRepresentation rho)
    {chi : TorusWeight S.torus} {v : V}
    (hv : HasHighWeight rho S.bigCell.data.Bopp S.torus v chi)
    (hcyc : IsCyclicRepresentation rho v) :
    weightSpace rho S.torus chi = Submodule.span k {v} := by
  exact cyclic_highestLine S.roots S.realized rho hr
    S.bigCell.data.Bopp S.bigCell.data.B S.bigCell.product_dense
    S.bigCell.data.positive_witness (rawHeight S) (rawHeight_mul S)
    (rawHeight_positive S) S.rootParameter chi v hv hcyc


/-- The cyclic extremal module for the positive Borel has its highest torus
weight space equal to the given highest line, for every `n`, including one. -/
theorem positive_extremal_highest_weightSpace (S : Geometry K) (n : ℕ)
    (rho : RationalRepresentation K V) (hr : IsRationalRepresentation rho)
    {v : V}
    (hv : HasHighWeight rho S.bigCell.data.B S.torus v
      (S.leftWeightEmbedding (maximalRestrictedWeight n)))
    (hcyc : IsCyclicRepresentation rho v) :
    weightSpace rho S.torus (S.leftWeightEmbedding (maximalRestrictedWeight n)) =
      Submodule.span k {v} :=
  positive_highest_weightSpace S rho hr hv hcyc

/-- The opposite cyclic extremal module has highest character `chi⁻¹` and
its entire torus weight space is the given opposite highest line. -/
theorem opposite_extremal_highest_weightSpace (S : Geometry K) (n : ℕ)
    (rho : RationalRepresentation K V) (hr : IsRationalRepresentation rho)
    {v : V}
    (hv : HasHighWeight rho S.bigCell.data.Bopp S.torus v
      (S.leftWeightEmbedding (maximalRestrictedWeight n))⁻¹)
    (hcyc : IsCyclicRepresentation rho v) :
    weightSpace rho S.torus (S.leftWeightEmbedding (maximalRestrictedWeight n))⁻¹ =
      Submodule.span k {v} :=
  opposite_highest_weightSpace S rho hr hv hcyc

end
end Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ExtremalGrid.DividedPowerEndpoint
