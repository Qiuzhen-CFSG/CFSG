module

public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.FiniteHighestWeight.FiniteUnipotent.ExtremalGrid.Dimension.Realization

/-!
# Universal covers from bounded cyclic highest-weight modules

Choose a cyclic rational highest-weight module of largest possible dimension.
For any other highest vector, form the cyclic submodule generated by the pair
of distinguished vectors in their direct sum. Its projection to the maximal
module is surjective by cyclicity and injective by maximality of dimension.
The other projection, composed with its inverse, is the required intertwiner.
Thus a uniform dimension bound and nonempty highest-weight existence construct
an actual `HighestWeightCover`, including its universal mapping property.

The dimension bound remains explicit and applies to every cyclic module,
including reducible ones. An irreducible dimension formula alone is insufficient.
This is the elementary maximal-dimension construction of a Weyl cover used for
the highest-weight setup in GLS3 §1.14 and Steinberg's extremal calculation,
`refs/KGroup/GLS3/Chapter2St2.tex`, 13.2(d). It does not assert that calculation.
-/

public noncomputable section
namespace Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ExtremalGrid
open Theory.AlgebraicGroup
universe u
variable {k : Type u} [Field k] [IsAlgClosed k] [CharP k 2]
variable {K : Variety k} [AlgebraicGroup K]

/-- An actual rational module generated by one highest vector. This record
asserts neither a dimension bound nor a universal mapping property. -/
structure CyclicHighestWeightModule (S : Geometry K) (B : ClosedSubgroup K)
    (chi : TorusWeight S.torus) where
  Space : Type u
  [addCommGroup : AddCommGroup Space]
  [module : Module k Space]
  [finiteDimensional : FiniteDimensional k Space]
  action : RationalRepresentation K Space
  rational : IsRationalRepresentation action
  vector : Space
  highest : HasHighWeight action B S.torus vector chi
  cyclic : IsCyclicRepresentation action vector

attribute [instance] CyclicHighestWeightModule.addCommGroup
  CyclicHighestWeightModule.module CyclicHighestWeightModule.finiteDimensional

variable {S : Geometry K} {B : ClosedSubgroup K} {chi : TorusWeight S.torus}

/-- The invariant span of a highest vector is an actual cyclic rational module. -/
theorem exists_cyclicHighestWeightModule
    {V : Type u} [AddCommGroup V] [Module k V] [FiniteDimensional k V]
    (rho : RationalRepresentation K V) (hr : IsRationalRepresentation rho)
    (v : V) (hv : HasHighWeight rho B S.torus v chi) :
    ∃ C : CyclicHighestWeightModule S B chi, ∃ F : C.Space →ₗ[k] V,
      Function.Injective F ∧ Intertwines C.action rho F ∧ F C.vector = v := by
  let U : Submodule k V :=
    sInf {W : Submodule k V | IsInvariantSubmodule rho W ∧ v ∈ W}
  have hU : IsInvariantSubmodule rho U := by
    intro g x hx
    exact Submodule.mem_sInf.2 fun W hW =>
      hW.1 g x (Submodule.mem_sInf.1 hx W hW)
  have hvU : v ∈ U := Submodule.mem_sInf.2 fun _ hW => hW.2
  obtain ⟨tau, ht, htr⟩ := rationalRepresentation_restriction_exists rho hr U hU
  let vU : U := ⟨v, hvU⟩
  have hh : HasHighWeight tau B S.torus vU chi := by
    have hn : vU ≠ 0 := fun h => hv.1.1 (congrArg Subtype.val h)
    refine ⟨⟨hn, ?_⟩, hn, ?_⟩
    · intro b hb
      obtain ⟨c, hc⟩ := hv.1.2 b hb
      exact ⟨c, Subtype.ext ((ht b vU).trans hc)⟩
    · intro t
      exact Subtype.ext ((ht (S.torus.includePoint t) vU).trans (hv.2.2 t))
  have hc : IsCyclicRepresentation tau vU := by
    intro Q hQ hvQ
    apply top_unique
    intro y _
    have hi : IsInvariantSubmodule rho (Q.map U.subtype) := by
      intro g x hx
      obtain ⟨z, hz, rfl⟩ := hx
      exact ⟨(tau.action g).1 z, hQ g z hz, ht g z⟩
    have hle : U ≤ Q.map U.subtype := sInf_le ⟨hi, vU, hvQ, rfl⟩
    obtain ⟨z, hz, hzy⟩ := hle y.property
    have he : z = y := Subtype.ext hzy
    simpa [he] using hz
  exact ⟨⟨U, tau, htr, vU, hh, hc⟩, U.subtype, U.subtype_injective, ht, rfl⟩

private theorem highWeight_borel_scalar
    {P : Set S.roots.Root} (hB : IsBorelOfPositiveSystem S.roots P B)
    {V : Type u} [AddCommGroup V] [Module k V]
    (rho : RationalRepresentation K V) (hr : IsRationalRepresentation rho)
    (v : V) (hv : HasHighWeight rho B S.torus v chi)
    (t w : Variety.Point K) (ht : t ∈ S.torus)
    (hw : w ∈ RootSubgroupGenerated S.roots P) :
    (rho.action (t * w)).1 v =
      chi.pointCharacter (S.torus.pointEquiv.symm ⟨t, ht⟩) • v := by
  have hfix := invariantLine_fixed_of_unipotent_subgroup rho hr B hB.unipotent v
    hv.1 hB.radical.1 hB.radical.2.1 w
  have hw' : w ∈ hB.unipotent := by
    change w ∈ hB.unipotent.toSubgroup
    rwa [hB.root_generated]
  let t' := S.torus.pointEquiv.symm ⟨t, ht⟩
  have ht' : S.torus.includePoint t' = t :=
    congrArg Subtype.val (S.torus.pointEquiv.apply_symm_apply ⟨t, ht⟩)
  rw [map_mul]
  change (rho.action t).1 ((rho.action w).1 v) = _
  rw [hfix hw']
  change (rho.action t).1 v = chi.pointCharacter t' • v
  rw [← ht']
  exact hv.2.2 t'

private theorem directSum_highest
    {P : Set S.roots.Root} (hB : IsBorelOfPositiveSystem S.roots P B)
    {V W : Type u} [AddCommGroup V] [Module k V]
    [AddCommGroup W] [Module k W]
    (rho : RationalRepresentation K V) (sigma : RationalRepresentation K W)
    (hr : IsRationalRepresentation rho) (hs : IsRationalRepresentation sigma)
    (tau : RationalRepresentation K (V × W)) (ht : IsDirectSumRepresentation rho sigma tau)
    (v : V) (w : W) (hv : HasHighWeight rho B S.torus v chi)
    (hw : HasHighWeight sigma B S.torus w chi) :
    HasHighWeight tau B S.torus (v, w) chi := by
  have hn : (v, w) ≠ 0 := fun h => hv.1.1 (congrArg Prod.fst h)
  refine ⟨⟨hn, ?_⟩, hn, ?_⟩
  · intro b hb
    obtain ⟨t, x, htT, hx, rfl⟩ := (BorelOfPositiveSystem.pointwise_decomposition hB b).mp hb
    refine ⟨chi.pointCharacter (S.torus.pointEquiv.symm ⟨t, htT⟩), ?_⟩
    rw [ht, highWeight_borel_scalar hB rho hr v hv t x htT hx,
      highWeight_borel_scalar hB sigma hs w hw t x htT hx]
    rfl
  · intro t
    rw [ht, hv.2.2, hw.2.2]
    rfl

private theorem cyclic_range_surjective (C : CyclicHighestWeightModule S B chi)
    {V : Type u} [AddCommGroup V] [Module k V]
    (rho : RationalRepresentation K V) (F : V →ₗ[k] C.Space)
    (hF : Intertwines rho C.action F) (v : V) (hv : F v = C.vector) :
    Function.Surjective F := by
  apply LinearMap.range_eq_top.mp
  apply C.cyclic
  · intro g x hx
    obtain ⟨y, rfl⟩ := hx
    exact ⟨(rho.action g).1 y, hF g y⟩
  · exact ⟨v, hv⟩

/-- The cyclic span of a pair of highest vectors projects onto the first
cyclic module, and into the second representation, preserving both vectors. -/
private theorem common_cyclicHighestWeightModule
    {P : Set S.roots.Root} (hB : IsBorelOfPositiveSystem S.roots P B)
    (C : CyclicHighestWeightModule S B chi)
    {V : Type u} [AddCommGroup V] [Module k V] [FiniteDimensional k V]
    (rho : RationalRepresentation K V) (hr : IsRationalRepresentation rho)
    (v : V) (hv : HasHighWeight rho B S.torus v chi) :
    ∃ D : CyclicHighestWeightModule S B chi,
      ∃ p : D.Space →ₗ[k] C.Space, ∃ q : D.Space →ₗ[k] V,
        Function.Surjective p ∧ Intertwines D.action C.action p ∧
          Intertwines D.action rho q ∧ p D.vector = C.vector ∧ q D.vector = v := by
  obtain ⟨tau, ht, htr⟩ := rationalRepresentation_directSum_exists C.action rho C.rational hr
  have hh := directSum_highest hB C.action rho C.rational hr tau ht C.vector v C.highest hv
  obtain ⟨D, F, _, hF, hFv⟩ := exists_cyclicHighestWeightModule tau htr (C.vector, v) hh
  let p : D.Space →ₗ[k] C.Space := (LinearMap.fst k C.Space V).comp F
  let q : D.Space →ₗ[k] V := (LinearMap.snd k C.Space V).comp F
  have hp : Intertwines D.action C.action p := by
    intro g x
    change (F ((D.action.action g).1 x)).1 = _
    rw [hF, ht g (F x).1 (F x).2]
    rfl
  have hq : Intertwines D.action rho q := by
    intro g x
    change (F ((D.action.action g).1 x)).2 = _
    rw [hF, ht g (F x).1 (F x).2]
    rfl
  have hpv : p D.vector = C.vector := congrArg Prod.fst hFv
  have hqv : q D.vector = v := congrArg Prod.snd hFv
  exact ⟨D, p, q, cyclic_range_surjective C D.action p hp D.vector hpv, hp, hq, hpv, hqv⟩

/-- The dimension estimate needed for the maximal cyclic-module construction.
It concerns every actual cyclic highest-weight module, including reducible ones. -/
@[expose] def CyclicHighestWeightDimensionBound (S : Geometry K) (B : ClosedSubgroup K)
    (chi : TorusWeight S.torus) (d : ℕ) : Prop :=
  ∀ C : CyclicHighestWeightModule S B chi, Module.finrank k C.Space ≤ d

/-- A uniform bound and one nonzero highest module construct an actual
universal highest-weight cover: maximize the dimension and use the cyclic
span of a pair to lift every highest vector. -/
theorem exists_highestWeightCover_of_cyclicBound
    {P : Set S.roots.Root} (hB : IsBorelOfPositiveSystem S.roots P B)
    (d : ℕ) (hbound : CyclicHighestWeightDimensionBound S B chi d)
    (hex : Nonempty (CyclicHighestWeightModule S B chi)) :
    ∃ C : HighestWeightCover S B chi, Module.finrank k C.Space ≤ d := by
  classical
  let p : ℕ → Prop := fun m => ∃ C : CyclicHighestWeightModule S B chi,
    Module.finrank k C.Space = m
  obtain ⟨C₀⟩ := hex
  obtain ⟨C, hC⟩ := Nat.findGreatest_spec (hbound C₀)
    (show p (Module.finrank k C₀.Space) from ⟨C₀, rfl⟩)
  have hmax (D : CyclicHighestWeightModule S B chi) :
      Module.finrank k D.Space ≤ Module.finrank k C.Space := by
    rw [hC]
    exact Nat.le_findGreatest (hbound D) (show p _ from ⟨D, rfl⟩)
  have hlift : ∀ {V : Type u} [AddCommGroup V] [Module k V] [FiniteDimensional k V]
      (rho : RationalRepresentation K V), IsRationalRepresentation rho →
      ∀ v, HasHighWeight rho B S.torus v chi →
        ∃ F : C.Space →ₗ[k] V, Intertwines C.action rho F ∧ F C.vector = v := by
    intro V _ _ _ rho hr v hv
    obtain ⟨D, p, q, hp, hpi, hqi, hpv, hqv⟩ :=
      common_cyclicHighestWeightModule hB C rho hr v hv
    have hdim : Module.finrank k D.Space = Module.finrank k C.Space :=
      le_antisymm (hmax D) (LinearMap.finrank_le_finrank_of_surjective hp)
    have hinj : Function.Injective p := by
      exact (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdim).mpr hp
    let e := LinearEquiv.ofBijective p ⟨hinj, hp⟩
    refine ⟨q.comp e.symm.toLinearMap, ?_, ?_⟩
    · intro g x
      change q (e.symm ((C.action.action g).1 x)) = (rho.action g).1 (q (e.symm x))
      have he : e.symm ((C.action.action g).1 x) = (D.action.action g).1 (e.symm x) := by
        apply e.injective
        change p (e.symm ((C.action.action g).1 x)) = p ((D.action.action g).1 (e.symm x))
        rw [hpi]
        change e (e.symm ((C.action.action g).1 x)) = (C.action.action g).1 (e (e.symm x))
        simp only [e.apply_symm_apply]
      rw [he, hqi]
    · change q (e.symm C.vector) = v
      have he : e.symm C.vector = D.vector := by
        apply e.injective
        exact (e.apply_symm_apply C.vector).trans hpv.symm
      rw [he, hqv]
  exact ⟨⟨C.Space, C.action, C.rational, C.vector, C.highest, hlift⟩, hbound C⟩

end Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ExtremalGrid
