module
public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.FiniteHighestWeight.FiniteUnipotent.ExtremalGrid.Dimension.WeylCovers.DimensionBound.TruncatedAlgebra.RootPairs.Basic
public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.FiniteHighestWeight.FiniteUnipotent.ExtremalGrid.Dimension.WeylCovers.DimensionBound.TruncatedAlgebra.RootPairs.PolynomialTransfer

/-!
# Generation of the coefficient algebra by signed simple roots

Root-system addition induction reduces to positive and negative simple roots.
At each sum-root step, the diagonal coefficient identity expresses its degree-j
coefficient, up to a nonzero scalar, using the two input roots and smaller
degrees on the sum root. This proves generation for every truncation q,
including q = 0. It uses the parameter relations explicitly and does not use
point-group generation or a highest-weight hypothesis.

Source: GLS3 1.12.1(b), 1.12.7(d); Steinberg (1963), §2.
-/

open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
namespace Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ExtremalGrid.CyclicDimension
public noncomputable section
universe u v
variable {k : Type u} [Field k] [IsAlgClosed k] [CharP k 2]
variable {K : Variety k} [AlgebraicGroup K]
variable {V : Type v} [AddCommGroup V] [Module k V] [FiniteDimensional k V]

/-- Every truncated root coefficient is generated by the eight signed simple roots.
The proof inducts on root sums and coefficient degrees, using nonzero exchange constants. -/
theorem coefficientAlgebra_eq_simpleCoefficientAlgebra_of_parameterRelations (S : Geometry K)
    (hrel : RootPairParameterRelations S) (rho : RationalRepresentation K V)
    (hr : IsRationalRepresentation rho) (q : ℕ) :
    coefficientAlgebra S rho hr q = simpleCoefficientAlgebra S rho hr q := by
  classical
  let A := simpleCoefficientAlgebra S rho hr q
  let P := typeDRootPairing 2
  let rootPairsIndexNeg := P.indexNeg
  have hn (r : TypeDRootIndex 4) :
      S.roots.neg (S.rootIndex.symm r) = S.rootIndex.symm (-r) := by
    apply S.rootIndex.injective
    rw [S.based.2.2.1, Equiv.apply_symm_apply, Equiv.apply_symm_apply]
    rfl
  let good (r : TypeDRootIndex 4) : Prop :=
    ∀ j < q, rootCoefficient S rho hr (S.rootIndex.symm r) j ∈ A
  have hbase (r : TypeDRootIndex 4) (hbase : r ∈ (typeDRootPairing_base 2).support) :
      good r ∧ good (-r) := by
    have hr : S.rootIndex.symm r ∈ S.roots.simple :=
      (S.based.2.2.2 _).mpr (by simpa only [Equiv.apply_symm_apply] using hbase)
    obtain ⟨i, hi⟩ := S.simpleRoot.surjective ⟨S.rootIndex.symm r, hr⟩
    have hi' : (S.simpleRoot i).val = S.rootIndex.symm r := congrArg Subtype.val hi
    constructor
    · intro j hj
      apply Algebra.subset_adjoin
      refine ⟨((i, true), ⟨j, hj⟩), ?_⟩
      simp only [↓reduceIte, hi']
    · intro j hj
      apply Algebra.subset_adjoin
      refine ⟨((i, false), ⟨j, hj⟩), ?_⟩
      simp only [Bool.false_eq_true, ↓reduceIte, hi', hn]
  have hstep (a b c : TypeDRootIndex 4)
      (hsum : P.root c = P.root a + P.root b) (ha : good a) (hb : good b) : good c := by
    have hs : RootSum S (S.rootIndex.symm a) (S.rootIndex.symm b) (S.rootIndex.symm c) := by
      simpa only [RootSum, Equiv.apply_symm_apply] using hsum
    obtain ⟨κ, hκ, he⟩ := hrel.exchange _ _ _ hs
    exact curveCoefficient_mem_of_exchange rho hr _ _ _ κ hκ he A q ha hb
  have hall (r : TypeDRootIndex 4) : good r ∧ good (-r) := by
    apply (typeDRootPairing_base 2).induction_add r
    · intro a ha
      change good (-a) ∧ good (-(-a))
      simpa only [neg_neg] using And.intro ha.2 ha.1
    · exact hbase
    · intro a b c hs ha hb
      refine ⟨hstep a b c hs ha.1 (hbase b hb).1, ?_⟩
      apply hstep (-a) (-b) (-c) _ ha.2 (hbase b hb).2
      change P.root (P.reflectionPerm c c) =
        P.root (P.reflectionPerm a a) + P.root (P.reflectionPerm b b)
      rw [P.root_reflectionPerm, P.root_reflectionPerm, P.root_reflectionPerm,
        P.reflection_apply_self, P.reflection_apply_self, P.reflection_apply_self]
      exact (congrArg Neg.neg hs).trans (neg_add _ _)
  apply le_antisymm
  · apply Algebra.adjoin_le
    rintro _ ⟨⟨r, j⟩, rfl⟩
    change rootCoefficient S rho hr r j ∈ A
    have ha := (hall (S.rootIndex r)).1 j j.isLt
    simpa only [Equiv.symm_apply_apply] using ha
  · exact simpleCoefficientAlgebra_le S rho hr q
end
end Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.ExtremalGrid.CyclicDimension
