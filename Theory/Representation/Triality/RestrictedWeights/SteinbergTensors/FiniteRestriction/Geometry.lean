module

public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.Construction
public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.Orientation
public import Theory.AlgebraicGroup.RootData.Realization
public import Theory.AlgebraicGroup.Borel.OppositeBigCell

/-!
# Geometry for restricted D4 graph-field representations

This interface specifies an actual simple universal algebraic group, its root
subgroups and character lattice, and algebraic graph and Frobenius maps. The
root pairing is identified with the standard D4 pairing; weight coordinates
are evaluated on the actual simple coroots. The opposite-Borel big cell and
finiteness of the graph-field fixed points are explicit geometric inputs.

No representation-theoretic restriction, existence, or uniqueness statement
is a field of this structure. In particular, the elementary subgroup remains
the subgroup generated by two-elements inside the fixed group.

Sources: GLS3, Definitions 2.2.1 and 2.8.1, Theorem 2.8.2;
`refs/KGroup/GLS3/Chapter2St2.tex`, Sections 12--13.
-/

@[expose] public noncomputable section

namespace Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction

open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
open D4RestrictedWeight

universe u
variable {k : Type u} [Field k] [IsAlgClosed k]

/-- Geometric hypotheses for the simply connected D4 restriction theorem.
The Frobenius inverse is only an inverse on points, not an algebraic morphism. -/
structure Geometry (K : Variety k) [AlgebraicGroup K] [CharP k 2] where
  simple : IsSimpleAlgebraicGroup K
  universal : IsUniversalVersion K
  torus : ClosedSubgroup K
  maximalTorus : IsMaximalTorus torus
  roots : RootGroupData K torus
  realized : roots.IsRealization
  additionComplete : roots.IsRootAdditionComplete
  rootIndex : roots.Root ≃ TypeDRootIndex 4
  based : IsActualBasedRootPairing roots (typeDRootPairing 2)
    (typeDRootPairing_base 2) rootIndex
  positive : ∀ a, a ∈ roots.positive ↔ (typeDRootPairing_base 2).IsPos (rootIndex a)
  simpleRoot : Fin 4 ≃ {a : roots.Root // a ∈ roots.simple}
  simpleRoot_index : ∀ i, rootIndex (simpleRoot i).val = typeDSimpleRootIndex 2 i
  bigCell : OppositeBorelBigCell torus roots roots.positive
  weight : Multiplicative Weight ≃* TorusWeight torus
  weight_coordinate : ∀ (a : Weight) (i : Fin 4),
    roots.weightPairing (weight (Multiplicative.ofAdd a)) (simpleRoot i).val = a i
  rootParameter : ∀ a, OneParameterParametrization (roots.rootSubgroup a).carrierVariety
  diagram : Theory.AlgebraicGroup.Iso K K
  diagram_three : ∀ g, diagram.toMulEquiv
    (diagram.toMulEquiv (diagram.toMulEquiv g)) = g
  diagram_root : ∀ a t,
    diagram.toMulEquiv ((roots.rootSubgroup a).includePoint ((rootParameter a).value t)) =
      let b := rootIndex.symm (typeD4DiagramEquiv.indexEquiv (rootIndex a))
      (roots.rootSubgroup b).includePoint ((rootParameter b).value t)
  frobenius : Theory.AlgebraicGroup.Morphism K K
  frobenius_bijective : Function.Bijective frobenius.onPoints
  frobenius_root : ∀ a t,
    frobenius.onPoints ((roots.rootSubgroup a).includePoint ((rootParameter a).value t)) =
      (roots.rootSubgroup a).includePoint ((rootParameter a).value (t ^ 2))
  commute : ∀ g, frobenius.onPoints (diagram.toMulEquiv g) =
    diagram.toMulEquiv (frobenius.onPoints g)
  fixed_finite : ∀ n : ℕ, 0 < n →
    Finite (graphFieldFixedSubgroup diagram.toMulEquiv frobenius.onPoints n)

variable {K : Variety k} [AlgebraicGroup K] [CharP k 2]

/-- The integral coordinate embedding used by the shared tensor interface. -/
def Geometry.coordinateEmbedding (S : Geometry K) : Weight ↪ TorusWeight S.torus where
  toFun a := S.weight (Multiplicative.ofAdd a)
  inj' := fun _ _ h => S.weight.injective h

/-- The ordinary Frobenius is bijective on algebraically closed field points.
This definition does not assert an algebraic inverse. -/
def Geometry.pointFrobenius (S : Geometry K) : Variety.Point K ≃* Variety.Point K :=
  MulEquiv.ofBijective S.frobenius.onPoints S.frobenius_bijective

/-- Restriction always uses the literal inclusion published in `Orientation`. -/
abbrev Geometry.inclusion (S : Geometry K) (n : ℕ) :=
  elementaryInclusion S.diagram.toMulEquiv S.frobenius.onPoints n

omit [IsAlgClosed k] in
/-- The subgroup used for restriction is finite for every positive exponent. -/
theorem Geometry.elementary_finite (S : Geometry K) (n : ℕ) (hn : 0 < n) :
    Finite (graphFieldElementarySubgroup S.diagram.toMulEquiv S.frobenius.onPoints n) := by
  let := S.fixed_finite n hn
  infer_instance

/-- GLS3 Definition 2.8.1(a) in integral simple-coroot coordinates. -/
def InRestrictedRange (n : ℕ) (a : Weight) : Prop :=
  ∀ i, 0 ≤ a i ∧ a i < (2 : ℤ) ^ n

omit [IsAlgClosed k] in
/-- The numerical condition is exactly the condition on every actual simple
coroot, rather than on a separate family of labels. -/
theorem Geometry.restrictedRange_iff (S : Geometry K) (n : ℕ) (a : Weight) :
    InRestrictedRange n a ↔ ∀ r ∈ S.roots.simple,
      0 ≤ S.roots.weightPairing (S.coordinateEmbedding a) r ∧
        S.roots.weightPairing (S.coordinateEmbedding a) r < (2 : ℤ) ^ n := by
  constructor
  · intro ha r hr
    obtain ⟨i, hi⟩ := S.simpleRoot.surjective ⟨r, hr⟩
    have hri : (S.simpleRoot i).val = r := congrArg Subtype.val hi
    rw [← hri]
    change 0 ≤ S.roots.weightPairing (S.weight (Multiplicative.ofAdd a))
      (S.simpleRoot i).val ∧ S.roots.weightPairing (S.weight (Multiplicative.ofAdd a))
      (S.simpleRoot i).val < (2 : ℤ) ^ n
    rw [S.weight_coordinate]
    exact ha i
  · intro ha i
    have h := ha (S.simpleRoot i).val (S.simpleRoot i).property
    change 0 ≤ S.roots.weightPairing (S.weight (Multiplicative.ofAdd a))
      (S.simpleRoot i).val ∧ S.roots.weightPairing (S.weight (Multiplicative.ofAdd a))
      (S.simpleRoot i).val < (2 : ℤ) ^ n at h
    rwa [S.weight_coordinate] at h

/-- Highest weight refers to the actual Borel and maximal torus. -/
def HasHighestWeight (S : Geometry K) (A : RationalFactor K) (a : Weight) : Prop :=
  ∃ v, HasHighWeight A.action S.bigCell.data.B S.torus v (S.coordinateEmbedding a)

end Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction
