module

public import Theory.AlgebraicGroup.RootSystems.TypeD4RestrictedWeights
public import Mathlib.Algebra.Group.Subgroup.Ker
public import Mathlib.Algebra.Group.End

/-!
# The inverse graph twist on graph-field fixed points

With the convention of `Triality.Standard.graphFieldAutomorphism`, a fixed
point satisfies `φⁿ(γ(x)) = x`. Commutation gives `φⁿ(x) = γ⁻¹(x)`.
Consequently exponent overflow in a representation pulls back by the inverse
graph automorphism. This is distinct from the *forward* diagram wrap in the
weight sequence used by `Triality.BinaryDegree.TensorData`.

The latter sequence extends a finite word by `a(i+n) = diagramAction(a(i))`.
A forward shift of this sequence corresponds to shifting tensor factors in the
opposite direction to coefficient Frobenius. The exact period test below
reduces equality of the infinite sequences to their first `n` terms.

Source: GLS3, Remark 2.8.8, with composition orientation checked against
`Theory/SpecificGroups/Triality/StandardModel.lean`.
-/

@[expose] public section

namespace Triality.RestrictedWeights.SteinbergTensors
open Theory.AlgebraicGroup.StandardRootSystem
open D4RestrictedWeight

/-- The number of words is the `q^4` count in GLS3 Theorem 2.8.2.
This counts parameters only, before proving the representation classification. -/
theorem card_weightWords (n : ℕ) :
    Fintype.card (Fin n → BasicWeight) = (2 ^ n) ^ 4 := by
  rw [Fintype.card_fun, Fintype.card_fin, card_basicWeight]
  rw [show 16 = 2 ^ 4 by decide, ← pow_mul, ← pow_mul, Nat.mul_comm]

/-- The pullback action of the pinned arm cycle has order dividing three. -/
@[simp] theorem diagramAction_three (a : BasicWeight) :
    diagramAction (diagramAction (diagramAction a)) = a := by
  funext i
  simp only [diagramAction, Function.comp_apply, typeD4DiagramPermutation_three]

/-- Pullback by the inverse graph automorphism. -/
def inverseDiagramAction (a : BasicWeight) : BasicWeight :=
  diagramAction (diagramAction a)

/-- The double forward cycle is pullback by the literal inverse permutation. -/
theorem inverseDiagramAction_eq_pullback (a : BasicWeight) :
    inverseDiagramAction a = a ∘ typeD4DiagramPermutation.symm := by
  funext i
  fin_cases i <;> rfl

@[simp] theorem diagramAction_inverse (a : BasicWeight) :
    diagramAction (inverseDiagramAction a) = a := diagramAction_three a

@[simp] theorem inverseDiagramAction_diagram (a : BasicWeight) :
    inverseDiagramAction (diagramAction a) = a := diagramAction_three a

/-- The full fixed-point group for the standard graph-then-field convention. -/
def graphFieldFixedSubgroup {G : Type*} [Group G]
    (γ : G ≃* G) (φ : Monoid.End G) (n : ℕ) : Subgroup G :=
  MonoidHom.eqLocus ((φ ^ n).comp γ.toMonoidHom) (MonoidHom.id G)

@[simp] theorem mem_graphFieldFixedSubgroup {G : Type*} [Group G]
    (γ : G ≃* G) (φ : Monoid.End G) (n : ℕ) (g : G) :
    g ∈ graphFieldFixedSubgroup γ φ n ↔ (φ ^ n) (γ g) = g := Iff.rfl

/-- The subgroup generated by two-elements, kept distinct from all fixed points.
This is the source's `O^{2′}`, not `O²` or the two-core. -/
def graphFieldElementarySubgroup {G : Type*} [Group G]
    (γ : G ≃* G) (φ : Monoid.End G) (n : ℕ) :
    Subgroup (graphFieldFixedSubgroup γ φ n) :=
  Subgroup.closure {g | ∃ m : ℕ, g ^ (2 ^ m) = 1}

/-- The literal inclusion of the source universal finite group in its ambient
point group; no equality between fixed points and the elementary group is used. -/
def elementaryInclusion {G : Type*} [Group G]
    (γ : G ≃* G) (φ : Monoid.End G) (n : ℕ) :
    graphFieldElementarySubgroup γ φ n →* G :=
  (graphFieldFixedSubgroup γ φ n).subtype.comp
    (graphFieldElementarySubgroup γ φ n).subtype

/-- The graph part is inverted on the fixed points of the graph-field map.
`hfixed` has the same order of composition as `StandardModel`. -/
theorem field_eq_inverse_graph {G : Type*} [Group G]
    (γ : G ≃* G) (φ : Monoid.End G)
    (hcomm : ∀ x, φ (γ x) = γ (φ x))
    {x : G} (hfixed : φ (γ x) = x) : φ x = γ.symm x := by
  apply γ.injective
  rw [← hcomm, hfixed, γ.apply_symm_apply]

/-- The actual linear operators at an exponent boundary agree with inverse
 graph pullback, without making any representation-theoretic assumption. -/
theorem action_field_eq_inverse_graph {G H : Type*} [Group G] [Monoid H]
    (ρ : G →* H) (γ : G ≃* G) (φ : Monoid.End G)
    (hcomm : ∀ x, φ (γ x) = γ (φ x))
    {x : G} (hfixed : φ (γ x) = x) :
    ρ (φ x) = ρ (γ.symm x) :=
  congrArg ρ (field_eq_inverse_graph γ φ hcomm hfixed)

/-- Extend exactly `n` basic weights using the forward diagram wrap. -/
def extendWeights {n : ℕ} (hn : 0 < n) (a : Fin n → BasicWeight)
    (i : ℕ) : BasicWeight :=
  (diagramAction^[i / n]) (a ⟨i % n, Nat.mod_lt i hn⟩)

@[simp] theorem extendWeights_initial {n : ℕ} (hn : 0 < n)
    (a : Fin n → BasicWeight) (i : Fin n) :
    extendWeights hn a i = a i := by
  simp [extendWeights, Nat.div_eq_of_lt i.isLt, Nat.mod_eq_of_lt i.isLt]

/-- This is the exact forward-wrap convention of `TensorData`. -/
theorem extendWeights_wrap {n : ℕ} (hn : 0 < n)
    (a : Fin n → BasicWeight) (i : ℕ) :
    extendWeights hn a (i + n) = diagramAction (extendWeights hn a i) := by
  simp only [extendWeights, Nat.add_div_right _ hn, Nat.add_mod_right,
    Function.iterate_succ_apply']

/-- Any sequence satisfying the wrap equation is determined by its first block. -/
theorem eq_of_initial_of_wrap {n : ℕ} (hn : 0 < n)
    {a b : ℕ → BasicWeight}
    (ha : ∀ i, a (i + n) = diagramAction (a i))
    (hb : ∀ i, b (i + n) = diagramAction (b i))
    (hinit : ∀ i, i < n → a i = b i) : a = b := by
  funext i
  induction i using Nat.strong_induction_on with
  | h i ih =>
    by_cases hi : i < n
    · exact hinit i hi
    · have hnle : n ≤ i := by omega
      have hlt : i - n < i := by omega
      have heq : i - n + n = i := Nat.sub_add_cancel hnle
      rw [← heq, ha, hb, ih (i - n) hlt]

/-- A character-period proof needs to test only the finite tensor labels. -/
theorem periodic_iff_initial {n : ℕ} (hn : 0 < n)
    {a : ℕ → BasicWeight} (ha : ∀ i, a (i + n) = diagramAction (a i)) (r : ℕ) :
    Function.Periodic a r ↔ ∀ i, i < n → a (i + r) = a i := by
  refine ⟨fun h i _ => h i, fun h i => ?_⟩
  have heq : (fun i => a (i + r)) = a := eq_of_initial_of_wrap hn
    (fun i => by simpa [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using ha (i + r))
    ha h
  exact congrFun heq i

/-- Three wraps always give an ordinary period, including `n = 1`. -/
theorem extendWeights_period_three {n : ℕ} (hn : 0 < n)
    (a : Fin n → BasicWeight) : Function.Periodic (extendWeights hn a) (3 * n) := by
  intro i
  rw [show i + 3 * n = ((i + n) + n) + n by omega]
  simp only [extendWeights_wrap, diagramAction_three]

/-- The finite label word after a forward shift of the extended sequence. -/
def shiftWeights {n : ℕ} (hn : 0 < n) (a : Fin n → BasicWeight)
    (r : ℕ) (i : Fin n) : BasicWeight := extendWeights hn a (i + r)

/-- Fixed finite labels are equivalent to the requested infinite-sequence period. -/
theorem shiftWeights_eq_iff {n : ℕ} (hn : 0 < n)
    (a : Fin n → BasicWeight) (r : ℕ) :
    shiftWeights hn a r = a ↔ Function.Periodic (extendWeights hn a) r := by
  rw [periodic_iff_initial hn (extendWeights_wrap hn a)]
  constructor
  · intro h i hi
    have hh := congrFun h ⟨i, hi⟩
    simpa only [shiftWeights, extendWeights_initial hn a ⟨i, hi⟩] using hh
  · intro h
    funext i
    change extendWeights hn a (i + r) = a i
    rw [h i i.isLt, extendWeights_initial]

end Triality.RestrictedWeights.SteinbergTensors
