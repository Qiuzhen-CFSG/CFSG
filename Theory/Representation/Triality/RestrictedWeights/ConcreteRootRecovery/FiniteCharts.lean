module
public import Theory.Representation.Triality.RestrictedWeights.ConcreteRootRecovery.Arms
/-!
# Finite central and arm root charts in the concrete triality subgroup

Finite SL2 transvections are involutions. The explicit central and three-arm
root formulas are fixed by the prescribed graph-field map at their respective
field sizes, so transvection generation places the full finite images in the
literal subgroup generated by two-elements. The resulting charts retain the
actual coefficient inclusions and pointwise compatibility, including n = 1.
Source: GLS3 2.8.2 and Steinberg 13.3(a).
-/

@[expose] public noncomputable section
open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
open Triality.SimplyConnected Triality.SimplyConnected.Pinning
open Triality.RestrictedWeights.SteinbergTensors
open Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction
open RootRecovery
open scoped MatrixGroups
namespace Triality.RestrictedWeights.Concrete.RootCharts
universe u
variable (k : Type u) [Field k] [IsAlgClosed k] [CharP k 2]

omit [CharP k 2] in
theorem finite_upper (F : Subfield k) (t : F) :
    finiteSL2Inclusion F (Matrix.SpecialLinearGroup.transvection (show (0:Fin 2)≠1 by decide) t) =
      standardSL2UpperMorphism.onPoints (kPlusPoint (t:k)) := by
  apply (slPointEquiv 2).injective
  change Matrix.SpecialLinearGroup.map F.subtype
      (Matrix.SpecialLinearGroup.transvection (show (0:Fin 2)≠1 by decide) t) =
    Matrix.SpecialLinearGroup.transvection (show (0:Fin 2)≠1 by decide) (t:k)
  apply Subtype.ext
  ext i j
  change ((Matrix.transvection _ _ t) i j : F) = (Matrix.transvection _ _ (t:k)) i j
  fin_cases i <;> fin_cases j <;>
    norm_num [Matrix.transvection,Matrix.one_apply,Matrix.single_apply]

omit [CharP k 2] in
theorem finite_lower (F : Subfield k) (t : F) :
    finiteSL2Inclusion F (Matrix.SpecialLinearGroup.transvection (show (1:Fin 2)≠0 by decide) t) =
      standardSL2LowerMorphism.onPoints (kPlusPoint (t:k)) := by
  apply (slPointEquiv 2).injective
  change Matrix.SpecialLinearGroup.map F.subtype
      (Matrix.SpecialLinearGroup.transvection (show (1:Fin 2)≠0 by decide) t) =
    Matrix.SpecialLinearGroup.transvection (show (1:Fin 2)≠0 by decide) (t:k)
  apply Subtype.ext
  ext i j
  change ((Matrix.transvection _ _ t) i j : F) = (Matrix.transvection _ _ (t:k)) i j
  fin_cases i <;> fin_cases j <;>
    norm_num [Matrix.transvection,Matrix.one_apply,Matrix.single_apply]

omit [IsAlgClosed k] in
theorem transvection_sq (F : Subfield k) (i j : Fin 2) (hij : i≠j) (t:F) :
    Matrix.SpecialLinearGroup.transvection hij t ^ 2 = 1 := by
  rw [pow_two]
  apply Subtype.ext
  change Matrix.transvection i j t * Matrix.transvection i j t = 1
  have H := Matrix.transvection_mul_transvection_same i j hij t t
  have ht : t+t=0 := CharTwo.add_self_eq_zero t
  rw [ht,Matrix.transvection_zero] at H
  with_reducible exact H

theorem finite_fixed (F : Subfield k) (f : Morphism (slVariety k 2) (groupVariety k))
    (n : ℕ)
    (hp : ∀ t:F, GraphField.sigma k n
      (f.onPoints (standardSL2UpperMorphism.onPoints (kPlusPoint (t:k)))) =
      f.onPoints (standardSL2UpperMorphism.onPoints (kPlusPoint (t:k))))
    (hm : ∀ t:F, GraphField.sigma k n
      (f.onPoints (standardSL2LowerMorphism.onPoints (kPlusPoint (t:k)))) =
      f.onPoints (standardSL2LowerMorphism.onPoints (kPlusPoint (t:k))))
    (g : SL(2,F)) :
    GraphField.sigma k n (f.onPoints (finiteSL2Inclusion F g)) =
      f.onPoints (finiteSL2Inclusion F g) := by
  refine Matrix.SL2.transvection_induction (fun g =>
    GraphField.sigma k n (f.onPoints (finiteSL2Inclusion F g)) =
      f.onPoints (finiteSL2Inclusion F g)) ?_ ?_ g
  · intro i j hij c
    fin_cases i <;> fin_cases j
    · exact (hij rfl).elim
    · rw [finite_upper]; exact hp c
    · rw [finite_lower]; exact hm c
    · exact (hij rfl).elim
  · intro a b ha hb
    simp only [map_mul,ha,hb]

def finiteElementaryMap (F : Subfield k) (f : Morphism (slVariety k 2) (groupVariety k))
    (n : ℕ)
    (hp : ∀ t:F, GraphField.sigma k n
      (f.onPoints (standardSL2UpperMorphism.onPoints (kPlusPoint (t:k)))) =
      f.onPoints (standardSL2UpperMorphism.onPoints (kPlusPoint (t:k))))
    (hm : ∀ t:F, GraphField.sigma k n
      (f.onPoints (standardSL2LowerMorphism.onPoints (kPlusPoint (t:k)))) =
      f.onPoints (standardSL2LowerMorphism.onPoints (kPlusPoint (t:k)))) :
    SL(2,F) →* GraphField.ElementaryGroup k n := by
  let f0 : SL(2,F) →* GraphField.FixedGroup k n :=
    (f.onPoints.comp (finiteSL2Inclusion F)).codRestrict _ (finite_fixed k F f n hp hm)
  refine f0.codRestrict _ ?_
  intro g
  refine Matrix.SL2.transvection_induction (fun g => f0 g ∈ GraphField.elementarySubgroup k n) ?_ ?_ g
  · intro i j hij t
    apply Subgroup.subset_closure
    refine ⟨1,?_⟩
    apply Subtype.ext
    change f.onPoints (finiteSL2Inclusion F (Matrix.SpecialLinearGroup.transvection hij t)) ^2=1
    rw [← map_pow,← map_pow,transvection_sq,map_one,map_one]
  · intro a b ha hb
    rw [map_mul]
    exact Subgroup.mul_mem _ ha hb

end Triality.RestrictedWeights.Concrete.RootCharts

namespace Triality.RestrictedWeights.Concrete.RootCharts
universe u
variable (k : Type u) [Field k] [IsAlgClosed k] [CharP k 2]

private theorem diagram_negative (r : RootIndex) :
    typeD4DiagramEquiv.indexEquiv (negativeRoot r) =
      negativeRoot (typeD4DiagramEquiv.indexEquiv r) := by
  apply (typeDRootPairing 2).root.injective
  rw [← RootPairing.Hom.root_weightMap_apply, root_negativeRoot, map_neg,
    RootPairing.Hom.root_weightMap_apply, root_negativeRoot]

theorem sigma_signedRoot (n : ℕ) (i : Fin 4) (b : Bool) (t : k) :
    GraphField.sigma k n (rootPoint k (signedRoot i b) t) =
      rootPoint k (signedRoot (typeD4DiagramPermutation i) b) (t^(2^n)) := by
  rw [GraphField.sigma_rootPoint]
  cases b
  · change rootPoint k (typeD4DiagramEquiv.indexEquiv (typeDSimpleRootIndex 2 i)) _ = _
    rw [typeD4DiagramEquiv_numbered]
    rfl
  · simp only [signedRoot,↓reduceIte,diagram_negative]
    change rootPoint k (negativeRoot (typeD4DiagramEquiv.indexEquiv (typeDSimpleRootIndex 2 i))) _ = _
    rw [typeD4DiagramEquiv_numbered]

theorem central_fixed (n : ℕ) (hn : 0<n) (b : Bool) (t : finiteSubfield k n) :
    GraphField.sigma k n (rootPoint k (signedRoot 1 b) (t:k)) =
      rootPoint k (signedRoot 1 b) (t:k) := by
  rw [sigma_signedRoot,finiteSubfield_pow k n hn]
  rfl

theorem arms_fixed (n : ℕ) (hn : 0<n) (b : Bool) (t : finiteSubfield k (3*n)) :
    GraphField.sigma k n
      (rootPoint k (signedRoot 0 b) (t:k) *
       rootPoint k (signedRoot 2 b) ((t:k)^(2^n)) *
       rootPoint k (signedRoot 3 b) ((t:k)^((2^n)^2))) =
      rootPoint k (signedRoot 0 b) (t:k) *
       rootPoint k (signedRoot 2 b) ((t:k)^(2^n)) *
       rootPoint k (signedRoot 3 b) ((t:k)^((2^n)^2)) := by
  simp only [map_mul,sigma_signedRoot]
  have he : (((t:k)^((2^n)^2))^(2^n))=(t:k) := by
    rw [← pow_mul,← pow_succ,← pow_mul,Nat.mul_comm n 3]
    exact finiteSubfield_pow k (3*n) (by omega) t
  have he2 : (((t:k)^(2^n))^(2^n))=(t:k)^((2^n)^2) := by rw [pow_two,pow_mul]
  rw [he,he2]
  change (rootPoint k (signedRoot 2 b) _ * rootPoint k (signedRoot 3 b) _) *
    rootPoint k (signedRoot 0 b) _ = _
  exact ((armRoot_commute k 0 1 (by decide) b b _ _).mul_right
    (armRoot_commute k 0 2 (by decide) b b _ _)).eq.symm.trans (mul_assoc _ _ _).symm
end Triality.RestrictedWeights.Concrete.RootCharts

namespace Triality.RestrictedWeights.Concrete.RootCharts
universe u
variable (k : Type u) [Field k] [IsAlgClosed k] [CharP k 2]

theorem geometry_simpleRoot (hu : IsUniversalVersion (groupVariety k)) (i : Fin 4) :
    ((finiteGeometry k hu).simpleRoot i).val.down = simpleRoot i := rfl

theorem geometry_rootPoint (hu : IsUniversalVersion (groupVariety k))
    (r : (finiteGeometry k hu).roots.Root) (t : k) :
    RootRecovery.rootPoint (finiteGeometry k hu) r t = Pinning.rootPoint k r.down t :=
  pinnedRootParametrization_inclusion k r t

def centralChart (hu : IsUniversalVersion (groupVariety k)) (n : ℕ) (hn : 0<n) :
    FiniteRootChart (finiteGeometry k hu) n .central where
  field := finiteSubfield k n
  finite := inferInstance
  card := finiteSubfield_card k n hn
  map := simpleMap k 1
  upper := by
    intro t
    simpa only [RootOrbit.upperPoint,geometry_rootPoint,geometry_simpleRoot] using simpleMap_upper k 1 t
  diagonal := simpleMap_diagonal k hu 1
  finiteMap := (GraphField.orientationElementaryEquiv k n).toMonoidHom.comp
    (finiteElementaryMap k (finiteSubfield k n) (simpleMap k 1) n
      (by intro t; rw [simpleMap_upper]; exact central_fixed k n hn false t)
      (by intro t; rw [simpleMap_lower]; exact central_fixed k n hn true t))
  finite_compat := by intro g; rfl

def armsChart (hu : IsUniversalVersion (groupVariety k)) (n : ℕ) (hn : 0<n) :
    FiniteRootChart (finiteGeometry k hu) n .arms where
  field := finiteSubfield k (3*n)
  finite := inferInstance
  card := finiteSubfield_card k (3*n) (by omega)
  map := armsMap k n
  upper := by
    intro t
    simpa only [RootOrbit.upperPoint,geometry_rootPoint,geometry_simpleRoot] using armsMap_upper k n t
  diagonal := armsMap_diagonal k hu n
  finiteMap := (GraphField.orientationElementaryEquiv k n).toMonoidHom.comp
    (finiteElementaryMap k (finiteSubfield k (3*n)) (armsMap k n) n
      (by intro t; rw [armsMap_upper]; exact arms_fixed k n hn false t)
      (by intro t; rw [armsMap_lower]; exact arms_fixed k n hn true t))
  finite_compat := by intro g; rfl

theorem finiteRootCharts (hu : IsUniversalVersion (groupVariety k)) (n : ℕ) (hn : 0<n) :
    ∀ o : RootOrbit, Nonempty (FiniteRootChart (finiteGeometry k hu) n o)
  | .central => ⟨centralChart k hu n hn⟩
  | .arms => ⟨armsChart k hu n hn⟩
end Triality.RestrictedWeights.Concrete.RootCharts
