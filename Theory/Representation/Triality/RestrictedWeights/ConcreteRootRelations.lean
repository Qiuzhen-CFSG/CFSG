module

public import Theory.SpecificGroups.Triality.SimplyConnectedModel.PinningTorus.RootPairsSource
public import Theory.Representation.Triality.RestrictedWeights.ConcreteRankOne
public import Theory.Representation.Triality.RestrictedWeights.ConcreteRootGeneration
public import Theory.Representation.Triality.RestrictedWeights.SteinbergTensors.FiniteRestriction.FiniteHighestWeight.FiniteUnipotent.ExtremalGrid.Dimension.WeylCovers.DimensionBound.TruncatedAlgebra.Normalization

/-!
# The concrete coefficient algebra for finite triality restriction

The pinned Spin root relations supply the actual nonzero parameter constants.
Together with the proved SL2 charts and point generation, they normalize the
truncated coefficient algebra. Every cyclic extremal highest-weight module is
therefore generated by that algebra, for both Borel conventions. This removes
normalization from the finite cyclic dimension argument; its sole remaining
linear-algebra input is the ordered PBW spanning inclusion.

Only universality of the concrete algebraic group is retained as an earlier
geometric input. No module realization, dimension or spanning conclusion is
assumed. Source: Steinberg §§2--3, 6 and 13.2(d); GLS3 1.12.1.
-/

public noncomputable section
open Theory.AlgebraicGroup
open Triality.SimplyConnected Triality.SimplyConnected.Pinning
open Triality.RestrictedWeights.SteinbergTensors FiniteRestriction
open ExtremalGrid ExtremalGrid.CyclicDimension
namespace Triality.RestrictedWeights.Concrete
universe u v
variable (k : Type u) [Field k] [IsAlgClosed k] [CharP k 2]
variable (hu : IsUniversalVersion (groupVariety k))

theorem rootPairParameterRelations : RootPairParameterRelations (finiteGeometry k hu) := by
  constructor
  · intro a b _ hop hs s t
    simp only [rootCurve_point]
    apply RootPairs.rootPoint_commute k a.down b.down
    · intro he
      apply hop
      apply ULift.ext
      change b.down = ((pinnedRootData k).neg a).down
      exact he.trans (congrArg (fun x : (pinnedRootData k).Root => x.down)
        (pinnedRootData_neg k a.down)).symm
    · rintro ⟨c,hc⟩
      exact hs ⟨ULift.up c,hc⟩
  · intro a b c hs
    refine ⟨1,one_ne_zero,fun s t => ?_⟩
    simp only [one_mul,rootCurve_point]
    exact RootPairs.rootPoint_exchange k a.down b.down c.down hs s t

variable {V : Type v} [AddCommGroup V] [Module k V] [FiniteDimensional k V]
theorem coefficientAlgebra_normalizes
    (rho : RationalRepresentation (groupVariety k) V)
    (hr : IsRationalRepresentation rho) (q : ℕ) :
    Normalizes rho (coefficientAlgebra (finiteGeometry k hu) rho hr q) :=
  coefficientAlgebra_normalizes_of_relations (finiteGeometry k hu)
    (simpleRootPoints_generate k hu) (rootPairParameterRelations k hu)
    (RankOne.simpleCharts k hu) rho hr q

theorem cyclicHighest_operatorOrbit_eq_top (n : ℕ)
    (C : CyclicHighestWeightModule (finiteGeometry k hu) (finiteGeometry k hu).bigCell.data.B
      ((finiteGeometry k hu).leftWeightEmbedding (maximalRestrictedWeight n))) :
    operatorOrbit (coefficientAlgebra (finiteGeometry k hu) C.action C.rational (2^n))
      C.vector = ⊤ :=
  operatorOrbit_eq_top_of_simple_orbits k hu C.action _
    (coefficientAlgebra_normalizes k hu C.action C.rational (2^n)) C.vector C.cyclic
    (RankOne.cyclicHighest_simpleRootAction_mem_source k hu n C)

theorem cyclicOppositeHighest_operatorOrbit_eq_top (n : ℕ)
    (C : CyclicHighestWeightModule (finiteGeometry k hu) (finiteGeometry k hu).bigCell.data.Bopp
      ((finiteGeometry k hu).leftWeightEmbedding (maximalRestrictedWeight n))⁻¹) :
    operatorOrbit (coefficientAlgebra (finiteGeometry k hu) C.action C.rational (2^n))
      C.vector = ⊤ :=
  operatorOrbit_eq_top_of_simple_orbits k hu C.action _
    (coefficientAlgebra_normalizes k hu C.action C.rational (2^n)) C.vector C.cyclic
    (RankOne.cyclicOppositeHighest_simpleRootAction_mem_source k hu n C)
end Triality.RestrictedWeights.Concrete
