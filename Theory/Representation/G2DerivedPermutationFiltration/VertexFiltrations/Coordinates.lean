public import Theory.Representation.G2DerivedPermutationFiltration.Incidence
public import Mathlib.GroupTheory.FreeGroup.Basic

/-!
# Coordinate witnesses for the two binary parabolic modules

The four displayed permutations are checked bijections on `Fin 63`. They
therefore define two genuine permutation representations of the free group
on two generators. No identification with G₂(2)′ is asserted in this file.

The root words and coset words come from the exploratory GAP calculation for
Aschbacher–Smith G.7.2(3), printed p.348. GAP uses right cosets `P r` with
right multiplication by `k`. Inversion sends these to left cosets `r⁻¹ P`,
and sends that action to left multiplication by `k⁻¹`. Accordingly,
`ambientGenerator` is the inverse of the GAP generator word. This preserves
GAP's displayed permutation and its row-vector subspace witnesses.
-/

@[expose] public section

namespace G2DerivedPermutationFiltration.VertexCoordinates
open Atlas.G2

abbrev WordGroup := FreeGroup (Fin 2)
abbrev Space := BinaryPermutation.Full (Fin 63)

/-- The root alphabet, in the order used by the exploratory calculation. -/
def rootGenerator : Fin 8 → FullGroup :=
  ![rootA 1, rootB 1, rootC 1, rootD 1, rootE 1, rootF 1, weylR, weylS]

/-- Evaluate signed powers in the actual split-octonion automorphism group. -/
def evalWord (w : List (Fin 8 × ℤ)) : FullGroup :=
  (w.map fun a => rootGenerator a.1 ^ a.2).prod

/-- GAP's two derived-generator words; their membership requires proof. -/
def generatorWord : Fin 2 → List (Fin 8 × ℤ) :=
  ![[(3, -1), (2, -1), (1, -1), (7, -1), (6, -1), (7, -1), (6, -1), (4, -1)], [(0, 1), (3, 1), (5, 1), (7, -1), (6, -1), (7, -1), (6, -1), (7, -1), (1, -1), (5, -1)]]

/-- Inversion converts the right-coset action to Lean's left-coset action. -/
def ambientGenerator (j : Fin 2) : FullGroup := (evalWord (generatorWord j))⁻¹

/-- The homomorphism defined by the two literal ambient generator words. -/
def ambientWordHom : WordGroup →* FullGroup := FreeGroup.lift ambientGenerator

