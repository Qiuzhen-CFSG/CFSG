theorem inverseTable_left : ∀ i j x,
    inverseTable i j (permutationTable i j x) = x := by decide +kernel

theorem inverseTable_right : ∀ i j x,
    permutationTable i j (inverseTable i j x) = x := by decide +kernel

/-- The listed, kernel-checked coordinate permutations. -/
def generator (i j : Fin 2) : Equiv.Perm (Fin 63) where
  toFun := permutationTable i j
  invFun := inverseTable i j
  left_inv := inverseTable_left i j
  right_inv := inverseTable_right i j

/-- The coordinate action, prior to identifying its acting group. -/
def wordPerm (i : Fin 2) : WordGroup →* Equiv.Perm (Fin 63) :=
  FreeGroup.lift (generator i)

def representation (i : Fin 2) : Representation (ZMod 2) WordGroup Space :=
  (BinaryPermutation.representation (Fin 63)).comp (wordPerm i)

@[simp] theorem wordPerm_of (i j : Fin 2) :
    wordPerm i (FreeGroup.of j) = generator i j := FreeGroup.lift_apply_of

@[simp] theorem representation_of_apply (i j : Fin 2) (v : Space) (x : Fin 63) :
    representation i (FreeGroup.of j) v x = v (inverseTable i j x) := by
  change v ((wordPerm i (FreeGroup.of j)).symm x) = _
  rw [wordPerm_of]
  rfl

