module

public import Theory.Representation.G2DerivedPermutationFiltration.VertexFiltrations.Coordinates

/-!
# Candidate adapted coordinates for the binary vertex actions

These are explicit witness data for the two 63-dimensional permutation modules
used in Aschbacher–Smith G.7.2(3), printed p.348. The columns extend successive
bases from the exploratory GAP series. Coordinates use column vectors: the
published generator sends `v x` to `v (inverseTable i j x)`.

The data do not assert that the basis is invertible, that the generator matrices
are correct, or that the diagonal actions are irreducible. Those identities
require separate kernel-checked certificates. The only results here concern
the finite lists of dimensions and their indices.

The original root-action witness data derive from the ATLAS port described in
`VertexFiltrations.Coordinates`; see LICENSES/ATLAS.txt and
LICENSES/ATLAS-CITATION.cff. Extraction script and original candidates are
retained in the task workspace's `Scratch/G2CoordinateFiltrations/`.
-/

@[expose] public section

namespace G2DerivedPermutationFiltration.VertexCoordinates.CoordinateFiltrations

/-- Number of nonzero successive factors in each candidate flag. -/
def length : Fin 2 → ℕ := ![9, 12]

/-- Candidate dimensions, extended by 63 past the last stage. -/
def cut (i : Fin 2) (t : ℕ) : ℕ :=
  if i = 0 then ([0, 14, 20, 21, 27, 41, 42, 48, 62, 63] : List ℕ)[t]?.getD 63
  else ([0, 6, 20, 21, 27, 28, 34, 48, 49, 55, 56, 62, 63] : List ℕ)[t]?.getD 63

abbrev Factor (i : Fin 2) := Fin (length i)

def degree (i : Fin 2) (t : Factor i) : ℕ := cut i (t.val + 1) - cut i t.val

theorem cut_zero : ∀ i, cut i 0 = 0 := by decide +kernel

theorem cut_last : ∀ i, cut i (length i) = 63 := by decide +kernel

theorem cut_step : ∀ i (t : Factor i),
    cut i t.val < cut i (t.val + 1) ∧ cut i (t.val + 1) ≤ 63 := by decide +kernel

theorem degree_allowed : ∀ i (t : Factor i), degree i t ∈ allowedDegrees := by
  change ∀ i (t : Factor i), degree i t = 1 ∨ degree i t = 6 ∨ 8 < degree i t
  decide +kernel

theorem degree_pos (i : Fin 2) (t : Factor i) : 0 < degree i t := by
  exact Nat.sub_pos_of_lt (cut_step i t).1

/-- Position of a coordinate of the literal successive block. -/
def blockIndex (i : Fin 2) (t : Factor i) (x : Fin (degree i t)) : Fin 63 :=
  ⟨cut i t.val + x.val, by
    have hx := x.isLt
    have ht := cut_step i t
    dsimp [degree] at hx
    omega⟩

/-- Decode a packed binary coefficient. -/
def bit (v : ℕ) (x : ℕ) : ZMod 2 := if v.testBit x then 1 else 0

