/-- Columns are candidate adapted basis vectors in the original coordinates. -/
def basisMatrix (i : Fin 2) : Matrix (Fin 63) (Fin 63) (ZMod 2) :=
  fun x y => bit (basis i y) x.val

/-- Candidate inverse of `basisMatrix`. -/
def inverseMatrix (i : Fin 2) : Matrix (Fin 63) (Fin 63) (ZMod 2) :=
  fun x y => bit (inverseRows i x) y.val

/-- Candidate matrices of the two generators in the adapted basis. -/
def actionMatrix (i j : Fin 2) : Matrix (Fin 63) (Fin 63) (ZMod 2) :=
  fun x y => bit (actionColumns i j y) x.val

/-- Literal diagonal block, with the same column convention as `Matrix.toLin'`. -/
def factorMatrix (i : Fin 2) (t : Factor i) (j : Fin 2) :
    Matrix (Fin (degree i t)) (Fin (degree i t)) (ZMod 2) :=
  fun x y => actionMatrix i j (blockIndex i t x) (blockIndex i t y)

end G2DerivedPermutationFiltration.VertexCoordinates.CoordinateFiltrations
