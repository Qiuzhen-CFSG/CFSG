  fun x y => CycleData.bit (ambientCycleColumns j y) x.val

/-- Column-action matrices of the two actual derived generators. -/
def derivedCycleMatrix (j : Fin 2) : Matrix (Fin 64) (Fin 64) (ZMod 2) :=
  fun x y => CycleData.bit (derivedCycleColumns j y) x.val

