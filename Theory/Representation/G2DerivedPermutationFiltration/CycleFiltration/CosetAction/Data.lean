/-- The candidate map into the actual left cosets, using inversion. -/
def flag (x : Fin 189) : Flag :=
  QuotientGroup.mk (evalWord (representativeWord x))⁻¹

/-- Column-action matrix of each ambient root/Weyl actor on cycle coordinates. -/
