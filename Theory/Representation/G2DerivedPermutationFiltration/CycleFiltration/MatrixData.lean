/-- Proposed factor action matrices, in column-vector convention.
The first index selects submodule (0) or quotient (1); the second selects actor. -/
def factorMatrix (f a : Fin 2) : Matrix (Fin 32) (Fin 32) (ZMod 2) :=
  fun i j => bit (factorRows f a i) j.val

/-- The checked matrix-algebra condition, without any group-theoretic assertion. -/
def FullFactorAlgebra (f : Fin 2) : Prop :=
  ∀ Q : Subalgebra (ZMod 2) (Matrix (Fin 32) (Fin 32) (ZMod 2)),
    factorMatrix f 0 ∈ Q → factorMatrix f 1 ∈ Q → Q = ⊤

