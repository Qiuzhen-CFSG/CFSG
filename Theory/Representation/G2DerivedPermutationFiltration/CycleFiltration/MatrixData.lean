/-- Rows of the proposed adapted cycle basis, expressed in the saved cycle basis. -/
def adaptedBasis : Matrix (Fin 64) (Fin 64) (ZMod 2) :=
  fun i j => bit (adaptedRows i) j.val

/-- Candidate inverse to `adaptedBasis`; its inverse identities require proof. -/
def adaptedInverse : Matrix (Fin 64) (Fin 64) (ZMod 2) :=
  fun i j => bit (adaptedInverseRows i) j.val

/-- The saved cycle vectors as columns in the enumerated 189-flag space. -/
def cycleEmbedding : Matrix (Fin 189) (Fin 64) (ZMod 2) :=
  fun i j => bit (cycleEmbeddingRows j) i.val

