module
public import Theory.Representation.ConjugateSpanOrbit
public import Theory.GroupTheory.InvolutionCentralizerControl
public import Mathlib.GroupTheory.Coset.Basic

/-!
# Permutation quotients generated by a fixed vector

A vector fixed by a subgroup defines an equivariant map from the literal
left-coset permutation module. Its image is the span of the vector's orbit.
The map is constructed on cosets and then extended linearly, preserving the
original actor and every orbit generator.

For a binary conjugate span of a line, the nonidentity generator supplies
the spanning vector. If the actor moves the line, its span has dimension
greater than one: a normal subgroup of order two would be centralized.

These general facts supply the permutation-module step in Aschbacher–Smith
13.4.7, printed p.901. The source application retains the actual parabolics
and uses the seven- and fifteen-point degrees proved separately.
-/

public noncomputable section
open Subgroup
namespace Representation
variable {k G W : Type*} [Field k] [Group G] [AddCommGroup W] [Module k W]

/-- A spanning vector fixed by H is an equivariant quotient of the actual
left-coset permutation module. -/
theorem exists_coset_orbit_map (ρ : Representation k G W) (H : Subgroup G)
    (w : W) (hw : ∀ h : H, ρ h w = w)
    (hs : Submodule.span k (Set.range (fun g : G => ρ g w)) = ⊤) :
    ∃ f : ((G ⧸ H) →₀ k) →ₗ[k] W, Function.Surjective f ∧
      (∀ g : G, f (Finsupp.single (QuotientGroup.mk g) 1) = ρ g w) ∧
      (∀ (g : G) v, f (Finsupp.lmapDomain k k (fun q : G ⧸ H => g • q) v) =
        ρ g (f v)) := by
  classical
  let orbit : G ⧸ H → W := Quotient.lift (fun g : G => ρ g w) (by
    intro a b hab
    have hh := hw ⟨a⁻¹ * b, QuotientGroup.leftRel_apply.mp hab⟩
    have he := congrArg (ρ a) hh
    simpa only [← Module.End.mul_apply, ← ρ.map_mul, mul_inv_cancel_left] using he.symm)
  let f := Finsupp.linearCombination k orbit
  have horbit (g : G) : orbit (QuotientGroup.mk g) = ρ g w := rfl
  have hr : Set.range orbit = Set.range (fun g : G => ρ g w) := by
    ext v
    constructor
    · rintro ⟨q,rfl⟩
      obtain ⟨g,rfl⟩ := Quotient.exists_rep q
      exact ⟨g,rfl⟩
    · rintro ⟨g,rfl⟩
      exact ⟨QuotientGroup.mk g,rfl⟩
  have hf : Function.Surjective f := by
    apply LinearMap.range_eq_top.mp
    rw [Finsupp.range_linearCombination,hr,hs]
  refine ⟨f,hf,?_,?_⟩
  · intro g
    simp only [f,Finsupp.linearCombination_single,one_smul,horbit]
  · intro g v
    have he : f.comp (Finsupp.lmapDomain k k (fun q : G ⧸ H => g • q)) =
        (ρ g).comp f := by
      ext q
      obtain ⟨a,rfl⟩ := Quotient.exists_rep q
      simp only [LinearMap.comp_apply,Finsupp.lsingle_apply,Finsupp.lmapDomain_apply, Finsupp.mapDomain_single,f,
        Finsupp.linearCombination_single]
      change 1 • (ρ (g*a) w) = ρ g (1 • (ρ a w))
      simp only [one_smul,ρ.map_mul,Module.End.mul_apply]
    exact LinearMap.congr_fun he v
end Representation

public noncomputable section
open Subgroup
open scoped IsMulCommutative
namespace Representation
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
/-- The quotient map uses the original conjugate line and original cosets. -/
theorem exists_conjugateLine_coset_map (F H P : Subgroup G)
    [IsElementaryAbelian 2 (conjugateSpanBy F H)]
    (hFP : F ≤ centralizer (P : Set G)) (hcard : Nat.card F = 2)
    (v : F) (hv : v ≠ 1) :
    let U := conjugateSpanBy F H
    let actor := U.normalizerMonoidHom.comp
      (inclusion (le_normalizer_conjugateSpanBy F H))
    let ρ := elementaryRepresentation (p := 2) actor
    let w := Additive.ofMul (inclusion (le_conjugateSpanBy F H) v)
    ∃ f : ((H ⧸ P.subgroupOf H) →₀ ZMod 2) →ₗ[ZMod 2] Additive U,
      Function.Surjective f ∧
      (∀ g : H, f (Finsupp.single (QuotientGroup.mk g) 1) = ρ g w) ∧
      (∀ (g : H) x, f (Finsupp.lmapDomain (ZMod 2) (ZMod 2)
        (fun q : H ⧸ P.subgroupOf H => g • q) x) = ρ g (f x)) := by
  let U := conjugateSpanBy F H
  let actor := U.normalizerMonoidHom.comp
    (inclusion (le_normalizer_conjugateSpanBy F H))
  let ρ := elementaryRepresentation (p := 2) actor
  let w := Additive.ofMul (inclusion (le_conjugateSpanBy F H) v)
  apply exists_coset_orbit_map ρ (P.subgroupOf H) w
  · intro p
    apply Additive.toMul.injective
    apply Subtype.ext
    change (p.val.val * v.val * p.val.val⁻¹) = v.val
    exact mul_inv_eq_iff_eq_mul.mpr (hFP v.property p.val.val p.property)
  · apply conjugateSpan_binary_orbit_span F H U (le_conjugateSpanBy F H) rfl
      (MonoidHom.id U) Function.surjective_id actor
    · intro h x hx
      rfl
    · intro a
      obtain ⟨b,hb,huniq⟩ := (Nat.card_eq_two_iff' (1 : F)).mp hcard
      by_cases ha : a = 1
      · exact Or.inl (by simp [ha])
      · have he : a = v := (huniq a ha).trans (huniq v hv).symm
        exact Or.inr (by rw [he]; rfl)
end Representation

public noncomputable section
open Subgroup
open scoped IsMulCommutative
namespace Representation
variable {G : Type*} [Group G] [Finite G]

/-- An orbit of a line moved by H has dimension greater than one. -/
theorem one_lt_finrank_conjugateLine (F H : Subgroup G)
    [IsElementaryAbelian 2 (conjugateSpanBy F H)] (hcard : Nat.card F = 2)
    (hmove : ¬ F ≤ centralizer (H : Set G)) :
    1 < Module.finrank (ZMod 2) (Additive (conjugateSpanBy F H)) := by
  let U := conjugateSpanBy F H
  have hc : Nat.card U = 2 ^ Module.finrank (ZMod 2) (Additive U) := by
    exact (Module.natCard_eq_pow_finrank (K := ZMod 2) (V := Additive U)).trans
      (by rw [Nat.card_zmod])
  by_contra hn
  have hd : Module.finrank (ZMod 2) (Additive U) ≤ 1 := Nat.le_of_not_gt hn
  have hu : Nat.card U = 2 := by
    have hl := card_le_of_le (le_conjugateSpanBy F H)
    rw [hcard] at hl
    rcases Nat.le_one_iff_eq_zero_or_eq_one.mp hd with hd | hd
    · rw [hc,hd] at hl
      norm_num at hl
    · rw [hc,hd,pow_one]
  apply hmove
  exact (le_conjugateSpanBy F H).trans (le_centralizer_iff.mp
    ((le_normalizer_conjugateSpanBy F H).trans
      (Subgroup.normalizer_le_centralizer_of_card_two U hu)))
end Representation
