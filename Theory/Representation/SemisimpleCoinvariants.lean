module
public import Mathlib.RepresentationTheory.Semisimple
public import Mathlib.RepresentationTheory.Invariants
public import Mathlib.RepresentationTheory.Coinvariants

/-!
# Fixed vectors in a semisimple commutator-generated module

An invariant complement to the fixed space contains every displacement.
When displacements span the module, that complement is the whole module,
so the fixed space vanishes. This applies over any field and actor group.
Source application: Aschbacher–Smith D.3.6 and 10.1.1, pp.196,741.
-/

public noncomputable section
open scoped MonoidAlgebra
open Representation
namespace Representation
variable {k G V : Type*} [Field k] [Group G] [AddCommGroup V] [Module k V]

/-- A semisimple module generated by displacements has zero fixed space. -/
theorem invariants_eq_bot_of_semisimple_of_coinvariants_eq_top
    (ρ : Representation k G V) [IsSemisimpleModule k[G] ρ.asModule]
    (hgen : Coinvariants.ker ρ = ⊤) : ρ.invariants = ⊥ := by
  let : IsSemisimpleRepresentation ρ :=
    (isSemisimpleRepresentation_iff_isSemisimpleModule_asModule ρ).mpr inferInstance
  let I : Subrepresentation ρ := {
    toSubmodule := ρ.invariants
    apply_mem_toSubmodule g v hv := by
      change ρ g v ∈ ρ.invariants
      rw [hv g]
      exact hv }
  obtain ⟨P,hP⟩ := exists_isCompl I
  have hle : Coinvariants.ker ρ ≤ P.toSubmodule := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨g,v⟩,rfl⟩
    have hv : v ∈ I.toSubmodule ⊔ P.toSubmodule := by
      rw [←Subrepresentation.toSubmodule_sup,hP.sup_eq_top]
      trivial
    obtain ⟨x,hx,y,hy,rfl⟩ := Submodule.mem_sup.mp hv
    have h := P.toSubmodule.sub_mem (P.apply_mem_toSubmodule g hy) hy
    change ρ g (x+y) - (x+y) ∈ P.toSubmodule
    simpa only [map_add,show ρ g x = x from hx g,add_sub_add_left_eq_sub] using h
  rw [hgen] at hle
  have ht : P = ⊤ := Subrepresentation.toSubmodule_injective (top_unique hle)
  have hz := hP.inf_eq_bot
  rw [ht,inf_top_eq] at hz
  exact congrArg Subrepresentation.toSubmodule hz
end Representation

