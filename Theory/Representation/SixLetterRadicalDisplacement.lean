module

public import Theory.SpecificGroups.SymmetricSix.BinaryFlags.NaturalGeometry
public import Mathlib.RepresentationTheory.Coinvariants
public import Mathlib.RepresentationTheory.Invariants

/-!
# Six-letter augmentation displacements and an obstruction

Let `U` be the actual five-dimensional binary augmentation module of `S₆`.
The full-group fixed space `F` is its constant line. The weight-four plane `W`
is spanned by `q₀₁ + q₂₃` and `q₀₁ + q₄₅`. Their sum is the three-dimensional
pair space, so `U / (F + W)` has dimension two; the natural module modulo
its canonical plane also has dimension two.

The four-group `coordinateFour = ⟨(01),(23)⟩` lies in the canonical radical
`D` and does not contain `D₀ = D ∩ A₆`. Its augmentation displacement is
exactly `⟨q₀₁,q₂₃⟩`, which has dimension two and omits the constant vector.
Consequently the assertion `[U,E] = F + W` for every `E ≤ D` with
`D₀ ≰ E` and `|E| > 2` is false. The decisive obstruction is evaluation at
coordinate 4, fixed by every element of this four-group. All finite
certificates below use kernel-checked `decide`.

Source context: Aschbacher–Smith, *The Classification of Quasithin Groups*,
combined manuscript (1 March 2004), proof of Lemma 13.8.34, printed p.968
(PDF p.985), second paragraph. This diagnoses the proposed unrestricted
augmentation calculation; it does not refute the lemma with its full ambient
hypotheses or supply its source-theorem assembly.
-/

@[expose] public section

open BinaryPermutation Representation Module
open Theory.SpecificGroups.SymmetricSix.BinaryFlags

namespace Representation.SixLetterRadicalDisplacement

abbrev U := core (Fin 6)

/-- A weight-two vector in the augmentation core (zero if the indices coincide). -/
def q (i j : Fin 6) : U :=
  ⟨Pi.single i 1 + Pi.single j 1, by simp [mem_core]; decide +revert⟩

/-- The all-one vector, which has even weight in degree six. -/
def constant : U := ⟨allOne (Fin 6), by change (∑ _ : Fin 6, (1 : ZMod 2)) = 0; decide⟩

/-- The full symmetric-group fixed subspace in the augmentation action. -/
noncomputable def F : Submodule (ZMod 2) U := (coreRepresentation (Fin 6)).invariants

/-- The canonical weight-four plane in the augmentation action. -/
def W : Submodule (ZMod 2) U :=
  Submodule.span (ZMod 2) {q 0 1 + q 2 3, q 0 1 + q 4 5}

/-- The subgroup generated by the first two independent pair swaps. -/
def coordinateFour : Subgroup S where
  carrier := {g | g = 1 ∨ g = swap01 ∨ g = swap23 ∨ g = swap01 * swap23}
  one_mem' := Or.inl rfl
  mul_mem' := by
    rintro a b (rfl | rfl | rfl | rfl) (rfl | rfl | rfl | rfl) <;> decide
  inv_mem' := by
    rintro a (rfl | rfl | rfl | rfl) <;> decide

instance (g : S) : Decidable (g ∈ coordinateFour) :=
  inferInstanceAs (Decidable (g = 1 ∨ g = swap01 ∨ g = swap23 ∨ g = swap01 * swap23))

private instance : Fintype coordinateFour :=
  Fintype.ofFinset {1, swap01, swap23, swap01 * swap23} (by
    intro g
    simp [coordinateFour])

theorem coordinateFour_card : Nat.card coordinateFour = 4 := by
  rw [Nat.card_eq_fintype_card]
  decide

theorem coordinateFour_eq_closure : coordinateFour = Subgroup.closure {swap01, swap23} := by
  apply le_antisymm
  · rintro g (rfl | rfl | rfl | rfl)
    · exact Subgroup.one_mem _
    · exact Subgroup.subset_closure (by simp)
    · exact Subgroup.subset_closure (by simp)
    · exact Subgroup.mul_mem _ (Subgroup.subset_closure (by simp))
        (Subgroup.subset_closure (by simp))
  · rw [Subgroup.closure_le]
    rintro g (rfl | rfl) <;> change _ ∈ coordinateFour <;> decide

theorem coordinateFour_le_D : coordinateFour ≤ D := by
  rintro g (rfl | rfl | rfl | rfl)
  · exact D.one_mem
  · exact swap01_mem_D
  · exact swap23_mem_D
  · exact D.mul_mem swap01_mem_D swap23_mem_D

theorem D0_not_le_coordinateFour : ¬ D0 ≤ coordinateFour := by
  intro h
  have := h swap01_swap45_mem_D0
  exact (by decide : swap01 * swap45 ∉ coordinateFour) this

theorem constant_mem_F : constant ∈ F := by
  intro g
  apply Subtype.ext
  exact permute_allOne (Fin 6) g

theorem F_eq_constantLine : F = Submodule.span (ZMod 2) {constant} := by
  apply le_antisymm
  · intro v hv
    apply Submodule.mem_span_singleton.mpr
    refine ⟨v.val 0, ?_⟩
    apply Subtype.ext
    funext i
    have h := congrArg (fun x : U => x.val i) (hv (Equiv.swap 0 i))
    simpa [coreRepresentation, representation, constant, allOne] using h
  · exact Submodule.span_le.mpr (Set.singleton_subset_iff.mpr constant_mem_F)

/-- The total commutator subspace for the actual restricted augmentation action. -/
def displacement (E : Subgroup S) : Submodule (ZMod 2) U :=
  Coinvariants.ker ((coreRepresentation (Fin 6)).comp E.subtype)

private def lastCoordinate : U →ₗ[ZMod 2] ZMod 2 :=
  (LinearMap.proj (4 : Fin 6)).comp (core (Fin 6)).subtype

private theorem coordinateFour_fixes_four (g : coordinateFour) : (g : S) 4 = 4 := by
  rcases g.property with h | h | h | h <;> rw [h] <;> decide

private theorem displacement_coordinateFour_le_coordinateKernel :
    displacement coordinateFour ≤ lastCoordinate.ker := by
  apply Submodule.span_le.mpr
  rintro _ ⟨⟨g, v⟩, rfl⟩
  change v.val ((g : S).symm 4) - v.val 4 = 0
  have h : (g : S).symm 4 = 4 := by
    apply (g : S).injective
    simpa using (coordinateFour_fixes_four g).symm
  rw [h, sub_self]

theorem constant_not_mem_displacement_coordinateFour :
    constant ∉ displacement coordinateFour := by
  intro h
  have hc := displacement_coordinateFour_le_coordinateKernel h
  change (1 : ZMod 2) = 0 at hc
  exact one_ne_zero hc

theorem displacement_coordinateFour_ne_F_sup_W :
    displacement coordinateFour ≠ F ⊔ W := by
  intro h
  exact constant_not_mem_displacement_coordinateFour
    (h ▸ (Submodule.mem_sup_left constant_mem_F))

private theorem swap01_difference (v : U) :
    coreRepresentation (Fin 6) swap01 v - v = (v.val 0 + v.val 1) • q 0 1 := by
  apply Subtype.ext
  funext i
  change v.val (Equiv.swap 0 1 i) - v.val i = (v.val 0 + v.val 1) * (q 0 1).val i
  fin_cases i <;> simp [q, Equiv.swap_apply_def, Fin.ext_iff, CharTwo.sub_eq_add,
    CharTwo.add_self_eq_zero, add_comm]
  exact add_comm _ _

private theorem swap23_difference (v : U) :
    coreRepresentation (Fin 6) swap23 v - v = (v.val 2 + v.val 3) • q 2 3 := by
  apply Subtype.ext
  funext i
  change v.val (Equiv.swap 2 3 i) - v.val i = (v.val 2 + v.val 3) * (q 2 3).val i
  fin_cases i <;> simp [q, Equiv.swap_apply_def, Fin.ext_iff, CharTwo.sub_eq_add,
    CharTwo.add_self_eq_zero, add_comm]

private theorem swap01_swap23_difference (v : U) :
    coreRepresentation (Fin 6) (swap01 * swap23) v - v =
      (v.val 0 + v.val 1) • q 0 1 + (v.val 2 + v.val 3) • q 2 3 := by
  apply Subtype.ext
  funext i
  change v.val (Equiv.swap 2 3 (Equiv.swap 0 1 i)) - v.val i =
    (v.val 0 + v.val 1) * (q 0 1).val i + (v.val 2 + v.val 3) * (q 2 3).val i
  fin_cases i <;> simp [q, Equiv.swap_apply_def, Fin.ext_iff, CharTwo.sub_eq_add,
    CharTwo.add_self_eq_zero, add_comm]
  exact add_comm _ _

/-- The exact displacement for the four-group generated by the first two swaps. -/
theorem displacement_coordinateFour :
    displacement coordinateFour = Submodule.span (ZMod 2) {q 0 1, q 2 3} := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨⟨g, v⟩, rfl⟩
    change coreRepresentation (Fin 6) (g : S) v - v ∈ _
    have h01 : q 0 1 ∈ Submodule.span (ZMod 2) {q 0 1, q 2 3} :=
      Submodule.subset_span (by simp)
    have h23 : q 2 3 ∈ Submodule.span (ZMod 2) {q 0 1, q 2 3} :=
      Submodule.subset_span (by simp)
    rcases g.property with h | h | h | h
    · simp [h]
    · rw [h, swap01_difference]
      exact Submodule.smul_mem _ _ h01
    · rw [h, swap23_difference]
      exact Submodule.smul_mem _ _ h23
    · rw [h, swap01_swap23_difference]
      exact Submodule.add_mem _ (Submodule.smul_mem _ _ h01) (Submodule.smul_mem _ _ h23)
  · apply Submodule.span_le.mpr
    rintro v (rfl | rfl)
    · exact Coinvariants.mem_ker_of_eq (ρ := (coreRepresentation (Fin 6)).comp
        coordinateFour.subtype) ⟨swap01, by decide⟩ (q 0 4) (q 0 1) (by decide)
    · exact Coinvariants.mem_ker_of_eq (ρ := (coreRepresentation (Fin 6)).comp
        coordinateFour.subtype) ⟨swap23, by decide⟩ (q 2 4) (q 2 3) (by decide)

/-- The constant line together with the weight-four plane is the full pair space. -/
theorem F_sup_W_eq_pairSpan :
    F ⊔ W = Submodule.span (ZMod 2) {q 0 1, q 2 3, q 4 5} := by
  let P := Submodule.span (ZMod 2) {q 0 1, q 2 3, q 4 5}
  have h01 : q 0 1 ∈ P := Submodule.subset_span (by simp)
  have h23 : q 2 3 ∈ P := Submodule.subset_span (by simp)
  have h45 : q 4 5 ∈ P := Submodule.subset_span (by simp)
  have hsum : constant = q 0 1 + q 2 3 + q 4 5 := by decide
  have ha : q 0 1 + q 2 3 ∈ F ⊔ W :=
    Submodule.mem_sup_right (Submodule.subset_span (by simp))
  have hb : q 0 1 + q 4 5 ∈ F ⊔ W :=
    Submodule.mem_sup_right (Submodule.subset_span (by simp))
  have hc : constant ∈ F ⊔ W := Submodule.mem_sup_left constant_mem_F
  apply le_antisymm
  · apply sup_le
    · rw [F_eq_constantLine]
      apply Submodule.span_le.mpr
      rintro v rfl
      rw [hsum]
      exact P.add_mem (P.add_mem h01 h23) h45
    · apply Submodule.span_le.mpr
      rintro v (rfl | rfl)
      · exact P.add_mem h01 h23
      · exact P.add_mem h01 h45
  · apply Submodule.span_le.mpr
    rintro v (rfl | rfl | rfl)
    · rw [show q 0 1 = constant + (q 0 1 + q 2 3) + (q 0 1 + q 4 5) by decide]
      exact Submodule.add_mem _ (Submodule.add_mem _ hc ha) hb
    · rw [show q 2 3 = constant + (q 0 1 + q 4 5) by decide]
      exact Submodule.add_mem _ hc hb
    · rw [show q 4 5 = constant + (q 0 1 + q 2 3) by decide]
      exact Submodule.add_mem _ hc ha

/-- The proposed augmentation target does have the source codimension two. -/
theorem F_sup_W_finrank : finrank (ZMod 2) ↥(F ⊔ W) = 3 := by
  let b : Fin 3 → U := ![q 0 1, q 2 3, q 4 5]
  have hb : LinearIndependent (ZMod 2) b := by
    rw [Fintype.linearIndependent_iff]
    decide
  have hr : Set.range b = ({q 0 1, q 2 3, q 4 5} : Set U) := by
    simp only [b, Matrix.range_cons, Matrix.range_empty, Set.union_empty, Set.singleton_union]
  rw [F_sup_W_eq_pairSpan, ← hr, finrank_span_eq_card hb]
  decide

theorem augmentation_quotient_finrank : finrank (ZMod 2) (U ⧸ (F ⊔ W)) = 2 := by
  have h := (F ⊔ W).finrank_quotient_add_finrank
  rw [F_sup_W_finrank, finrank_core] at h
  norm_num only [Fintype.card_fin, Nat.reduceSub] at h
  omega

theorem natural_quotient_finrank :
    finrank (ZMod 2) (natural (Fin 6) ⧸
      Theory.SpecificGroups.SymmetricSix.BinaryFlags.NaturalGeometry.canonicalPlane) = 2 := by
  have h := Theory.SpecificGroups.SymmetricSix.BinaryFlags.NaturalGeometry.canonicalPlane.finrank_quotient_add_finrank
  rw [Theory.SpecificGroups.SymmetricSix.BinaryFlags.NaturalGeometry.canonicalPlane_finrank,
    finrank_natural_even (Fin 6) (by decide)] at h
  change finrank (ZMod 2) (natural (Fin 6) ⧸
    Theory.SpecificGroups.SymmetricSix.BinaryFlags.NaturalGeometry.canonicalPlane) + 2 = 4 at h
  omega

theorem displacement_coordinateFour_finrank :
    finrank (ZMod 2) (displacement coordinateFour) = 2 := by
  let b : Fin 2 → U := ![q 0 1, q 2 3]
  have hb : LinearIndependent (ZMod 2) b := by
    rw [Fintype.linearIndependent_iff]
    decide
  have hr : Set.range b = ({q 0 1, q 2 3} : Set U) := by
    simp only [b, Matrix.range_cons, Matrix.range_empty, Set.union_empty, Set.singleton_union]
  rw [displacement_coordinateFour, ← hr, finrank_span_eq_card hb]
  decide

theorem displacement_coordinateFour_quotient_finrank :
    finrank (ZMod 2) (U ⧸ displacement coordinateFour) = 3 := by
  have h := (displacement coordinateFour).finrank_quotient_add_finrank
  rw [displacement_coordinateFour_finrank, finrank_core] at h
  norm_num only [Fintype.card_fin, Nat.reduceSub] at h
  omega

/-- The disputed conclusion fails with all its explicit subgroup hypotheses. -/
theorem augmentation_displacement_counterexample :
    ∃ E : Subgroup S, E ≤ D ∧ ¬ D0 ≤ E ∧ 2 < Nat.card E ∧
      Nat.card E = 4 ∧ displacement E ≠ F ⊔ W :=
  ⟨coordinateFour, coordinateFour_le_D, D0_not_le_coordinateFour,
    by rw [coordinateFour_card]; decide,
    coordinateFour_card, displacement_coordinateFour_ne_F_sup_W⟩

end Representation.SixLetterRadicalDisplacement
