module

public import Theory.Representation.BinaryNaturalDual.AdaptedPair.Geometry
public import Theory.Representation.BinaryNaturalDual.AdaptedPair.Five.FixedSpaces
public import Theory.Representation.BinaryNaturalDual.AdaptedPair.Five.AmbientSylow
public import Theory.Representation.BinaryNaturalDual.AdaptedPair.Five.PointSylow
public import Theory.Representation.BinaryNaturalDual.ModelOrbits.Coordinate

/-!
# The five-dimensional standard adapted pair

The upper group and reversal-twisted graph involution give the standard ambient
Sylow of order 2048. Its intersection with the stabilizer of (e₃,e₃*) has order
128 and contains that outer involution. The proved ambient normal form discharges
the premise of the point-Sylow construction. Both required fixed spaces are the
line generated by (e₁,e₅*), and an inner point stabilizer moves this line.

`standard_coordinates` supplies all standard inputs for adapted-pair transport,
including inner transitivity on nonsingular vectors. Its only inputs are the
coordinate action, inner index two, and point-stabilizer order 40320. Construction
of that action and those two model facts, and transport to arbitrary Sylows and
prescribed two-subgroups, belong to the surrounding assembly.

Source: corrected H.9.1(4), Aschbacher–Smith, printed p.390, and the marked
applications in 12.1.1 and 12.1.3.
-/

public section

open BinaryLinear.OuterCyclic
namespace BinaryNaturalDual.AdaptedPair.Five

/-- The computed inner upper fixer and the marked outer involution generate
the whole standard point stabilizer; its normal-form premise is discharged. -/
theorem standardPointGroup_eq_adjoin_tau (d : CoordinateAction 5) :
    standardGroup 5 ⊓ pointStabilizer (linearAction d) vectorFive =
      innerUpperPointGroup ⊔ Subgroup.zpowers (tau 5) :=
  pointGroup_eq_adjoin_tau d (standardGroup_normalForm d)

theorem standardPointGroup_card (d : CoordinateAction 5) :
    Nat.card ↥(standardGroup 5 ⊓ pointStabilizer (linearAction d) vectorFive) = 128 :=
  pointGroup_card d (standardGroup_normalForm d)

/-- The point-Sylow construction with the ambient normal form already proved. -/
noncomputable def standardPointSylow (d : CoordinateAction 5)
    (hcard : Nat.card (pointStabilizer (linearAction d) vectorFive) = 40320) :
    Sylow 2 (pointStabilizer (linearAction d) vectorFive) :=
  pointSylow d (standardGroup_normalForm d) hcard

theorem standardPointSylow_map (d : CoordinateAction 5)
    (hcard : Nat.card (pointStabilizer (linearAction d) vectorFive) = 40320) :
    (standardPointSylow d hcard : Subgroup _).map
      (pointStabilizer (linearAction d) vectorFive).subtype =
        standardGroup 5 ⊓ pointStabilizer (linearAction d) vectorFive :=
  pointSylow_map d (standardGroup_normalForm d) hcard

theorem outerFive_mem_standardPointSylow (d : CoordinateAction 5)
    (hcard : Nat.card (pointStabilizer (linearAction d) vectorFive) = 40320) :
    (⟨outerFive, tau_fixes_vectorFive d⟩ : pointStabilizer (linearAction d) vectorFive) ∈
      standardPointSylow d hcard :=
  outerFive_mem_pointSylow d (standardGroup_normalForm d) hcard

/-- Every pairing-one vector has an inner transporter to the chosen standard pair. -/
theorem exists_inner_to_vectorFive (d : CoordinateAction 5)
    (v : CoordinateSpace 5) (hv : quadratic v = 1) :
    ∃ l ∈ innerGroup 5, linearAction d l v = vectorFive := by
  obtain ⟨g, hg⟩ := ModelOrbits.exists_inner_eq_of_pairing_one d hv quadratic_vectorFive
  exact ⟨MulAut.conj g, ⟨g, rfl⟩, hg⟩

/-- All standard-coordinate inputs of the corrected adapted-pair transport in
dimension five, with no unproved Sylow, action-comparison or fixed-space premise. -/
theorem standard_coordinates (d : CoordinateAction 5)
    (hindex : (innerGroup 5).index = 2)
    (hcard : Nat.card (pointStabilizer (linearAction d) vectorFive) = 40320) :
    ∃ S : Sylow 2 (MulAut (LinearGroup 5)),
    ∃ P : Sylow 2 (pointStabilizer (linearAction d) vectorFive),
      (S : Subgroup _) = standardGroup 5 ∧
      quadratic vectorFive = 1 ∧
      (∀ v : CoordinateSpace 5, quadratic v = 1 →
        ∃ l ∈ innerGroup 5, linearAction d l v = vectorFive) ∧
      (P : Subgroup _).map (pointStabilizer (linearAction d) vectorFive).subtype =
        (S : Subgroup _) ⊓ pointStabilizer (linearAction d) vectorFive ∧
      (∃ s : pointStabilizer (linearAction d) vectorFive,
        s ∈ (P : Subgroup _) ∧ (s : MulAut (LinearGroup 5)) ∉ innerGroup 5) ∧
      movingSpace vectorFive ⊓ fixedVectors (linearAction d)
        ((S : Subgroup _) ⊓ pointStabilizer (linearAction d) vectorFive) =
          fixedVectors (linearAction d) S ∧
      Module.finrank (ZMod 2) (fixedVectors (linearAction d) S) = 1 ∧
      ∃ a ∈ innerGroup 5, linearAction d a vectorFive = vectorFive ∧
        ∃ z ∈ fixedVectors (linearAction d) S, linearAction d a z ≠ z := by
  refine ⟨ambientSylow d hindex, standardPointSylow d hcard,
    ambientSylow_coe d hindex, quadratic_vectorFive, exists_inner_to_vectorFive d, ?_⟩
  rw [ambientSylow_coe]
  exact ⟨standardPointSylow_map d hcard,
    ⟨⟨outerFive, tau_fixes_vectorFive d⟩,
      outerFive_mem_standardPointSylow d hcard, outerFive_not_inner d⟩,
    fixed_space_equality d, fixed_space_finrank d, inner_stabilizer_moves d⟩

end BinaryNaturalDual.AdaptedPair.Five
