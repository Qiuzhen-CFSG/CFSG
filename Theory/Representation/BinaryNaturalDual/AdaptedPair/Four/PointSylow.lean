module

public import Theory.Representation.BinaryNaturalDual.AdaptedPair.Four.Coordinates
public import Theory.Representation.BinaryNaturalDual.AdaptedPair.Four.FixedSpaces
public import Theory.Representation.BinaryNaturalDual.AdaptedPair.Four.PointSylow.Inner

/-!
# The adapted four-dimensional point-stabilizer Sylow

Under the explicit upper/graph normal form, a point fixer is either inner
or an inner point fixer times the specified outer involution. The computed
inner subgroup therefore has two disjoint cosets in the full intersection,
giving order sixteen. If the point stabilizer has order 336, the intersection
has odd index 21 and is a Sylow two-subgroup containing that outer involution.

The normal form and the point-stabilizer order are explicit inputs to this
conditional calculation, to be discharged in the standard adapted-pair assembly.
The inner action comparison itself has no such inputs.

Source: corrected adapted-pair form of Aschbacher–Smith H.9.1(4), printed p.390.
-/

@[expose] public section

open BinaryNaturalDual BinaryLinear.OuterCyclic
namespace BinaryNaturalDual.AdaptedPair.Four.PointSylow

/-- The actual point intersection inside the full automorphism group. -/
noncomputable def intersection (d : CoordinateAction 4) : Subgroup (MulAut (LinearGroup 4)) :=
  standardGroup 4 ⊓ pointStabilizer (linearAction d) vectorFour

theorem inner_mem_intersection (d : CoordinateAction 4) (g : C) :
    MulAut.conj g.val ∈ intersection d := by
  refine ⟨inner_mem_standard g.property.1, ?_⟩
  change linearAction d (MulAut.conj g.val) vectorFour = vectorFour
  rw [linearAction_inner]
  exact g.property.2

theorem outer_mem_intersection (d : CoordinateAction 4) : outerFour ∈ intersection d :=
  ⟨outerFour_mem_standard, outerFour_fixes_vectorFour d⟩

variable (d : CoordinateAction 4)
variable (hnormal : ∀ a ∈ standardGroup 4, ∃ u ∈ upperGroup 4,
  a = MulAut.conj u ∨ a = MulAut.conj u * tau 4)

include hnormal in
/-- The two cosets of the computed inner point stabilizer. -/
theorem mem_intersection_iff (a : MulAut (LinearGroup 4)) :
    a ∈ intersection d ↔ ∃ g : C, a = MulAut.conj g.val ∨
      a = MulAut.conj g.val * outerFour := by
  constructor
  · intro ha
    obtain ⟨u, hu, he | he⟩ := hnormal a ha.1
    · have hf : BinaryLinear.NaturalDualFlag.action u vectorFour = vectorFour := by
        have h := ha.2
        change linearAction d a vectorFour = vectorFour at h
        simpa only [he, linearAction_inner] using h
      exact ⟨⟨u, hu, hf⟩, Or.inl he⟩
    · let e := elementary (1 : Fin 4) 2 (by decide)
      have hue : u * e⁻¹ ∈ upperGroup 4 :=
        (upperGroup 4).mul_mem hu ((upperGroup 4).inv_mem (elementary_mem_upperGroup _ _ _))
      have heq : a = MulAut.conj (u * e⁻¹) * outerFour := by
        rw [he, outerFour_eq, map_mul, map_inv]
        change MulAut.conj u * tau 4 =
          MulAut.conj u * (MulAut.conj e)⁻¹ * (MulAut.conj e * tau 4)
        group
      have hf : BinaryLinear.NaturalDualFlag.action (u * e⁻¹) vectorFour = vectorFour := by
        have h := (pointStabilizer (linearAction d) vectorFour).mul_mem ha.2
          ((pointStabilizer (linearAction d) vectorFour).inv_mem (outerFour_fixes_vectorFour d))
        have hh : a * outerFour⁻¹ = MulAut.conj (u * e⁻¹) := by rw [heq]; group
        change linearAction d (a * outerFour⁻¹) vectorFour = vectorFour at h
        simpa only [hh, linearAction_inner] using h
      exact ⟨⟨u * e⁻¹, hue, hf⟩, Or.inr heq⟩
  · rintro ⟨g, rfl | rfl⟩
    · exact inner_mem_intersection d g
    · exact (intersection d).mul_mem (inner_mem_intersection d g) (outer_mem_intersection d)

include hnormal in
/-- The full intersection is generated by the inner fixer and the specified outer involution. -/
theorem intersection_eq : intersection d = C.map MulAut.conj ⊔ Subgroup.zpowers outerFour := by
  apply le_antisymm
  · intro a ha
    obtain ⟨g, rfl | rfl⟩ := (mem_intersection_iff d hnormal a).mp ha
    · exact (show C.map MulAut.conj ≤ C.map MulAut.conj ⊔ Subgroup.zpowers outerFour from le_sup_left)
        (Subgroup.mem_map_of_mem MulAut.conj g.property)
    · exact (C.map MulAut.conj ⊔ Subgroup.zpowers outerFour).mul_mem
        ((show C.map MulAut.conj ≤ C.map MulAut.conj ⊔ Subgroup.zpowers outerFour from le_sup_left)
          (Subgroup.mem_map_of_mem MulAut.conj g.property))
        ((show Subgroup.zpowers outerFour ≤ C.map MulAut.conj ⊔ Subgroup.zpowers outerFour from le_sup_right)
          (Subgroup.mem_zpowers outerFour))
  · apply sup_le
    · rintro a ⟨g, hg, rfl⟩
      exact inner_mem_intersection d ⟨g, hg⟩
    · exact Subgroup.zpowers_le.mpr (outer_mem_intersection d)

include d in
private theorem inner_ne_outer (g h : LinearGroup 4) :
    MulAut.conj g ≠ MulAut.conj h * outerFour := by
  intro he
  apply outerFour_not_inner d
  have hh : outerFour = MulAut.conj (h⁻¹ * g) := by
    rw [map_mul, map_inv, he]
    group
  exact hh ▸ ⟨h⁻¹ * g, rfl⟩

private noncomputable def cosetMap (p : C × Bool) : intersection d :=
  if p.2 then ⟨MulAut.conj p.1.val * outerFour,
    (intersection d).mul_mem (inner_mem_intersection d p.1) (outer_mem_intersection d)⟩
  else ⟨MulAut.conj p.1.val, inner_mem_intersection d p.1⟩

private theorem cosetMap_injective : Function.Injective (cosetMap d) := by
  rintro ⟨g, b⟩ ⟨h, c⟩ he
  have he' := congrArg Subtype.val he
  cases b <;> cases c
  · have hgh : g = h := Subtype.ext (conj_injective d he')
    subst h
    rfl
  · exact False.elim (inner_ne_outer d g.val h.val he')
  · exact False.elim (inner_ne_outer d h.val g.val he'.symm)
  · have he'' : MulAut.conj g.val = MulAut.conj h.val :=
      mul_right_cancel (show MulAut.conj g.val * outerFour = MulAut.conj h.val * outerFour from he')
    have hgh : g = h := Subtype.ext (conj_injective d he'')
    subst h
    rfl

include hnormal in
private theorem cosetMap_surjective : Function.Surjective (cosetMap d) := by
  intro a
  obtain ⟨g, hg | hg⟩ := (mem_intersection_iff d hnormal a.val).mp a.property
  · exact ⟨(g, false), Subtype.ext hg.symm⟩
  · exact ⟨(g, true), Subtype.ext hg.symm⟩

include hnormal in
/-- The full point intersection has order sixteen, eight in each coset. -/
theorem card_intersection : Nat.card (intersection d) = 16 := by
  have he := Equiv.ofBijective (cosetMap d)
    ⟨cosetMap_injective d, cosetMap_surjective d hnormal⟩
  rw [← Nat.card_congr he, Nat.card_prod, card_C]
  norm_num [Nat.card_eq_fintype_card]

/-- The point intersection viewed inside the actual point stabilizer. -/
noncomputable def insidePoint : Subgroup (pointStabilizer (linearAction d) vectorFour) :=
  (intersection d).subgroupOf (pointStabilizer (linearAction d) vectorFour)

include hnormal in
theorem card_insidePoint : Nat.card (insidePoint d) = 16 := by
  change Nat.card ((intersection d).subgroupOf (pointStabilizer (linearAction d) vectorFour)) = 16
  rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe
    (show intersection d ≤ pointStabilizer (linearAction d) vectorFour from inf_le_right)).toEquiv]
  exact card_intersection d hnormal

variable (hcard : Nat.card (pointStabilizer (linearAction d) vectorFour) = 336)

include hnormal hcard in
theorem index_insidePoint : (insidePoint d).index = 21 := by
  have h := (insidePoint d).card_mul_index
  rw [card_insidePoint d hnormal, hcard] at h
  omega

/-- The intersection is a Sylow two-subgroup of the point stabilizer. -/
noncomputable def pointSylow : Sylow 2 (pointStabilizer (linearAction d) vectorFour) :=
  IsPGroup.toSylow (P := insidePoint d)
    (IsPGroup.of_card (p := 2) (n := 4) (by
      simpa using card_insidePoint d hnormal)) (by
      rw [index_insidePoint d hnormal hcard]
      decide)

/-- The Sylow's ambient image is exactly the requested standard point intersection. -/
theorem pointSylow_map :
    (pointSylow d hnormal hcard).toSubgroup.map
      (pointStabilizer (linearAction d) vectorFour).subtype =
        standardGroup 4 ⊓ pointStabilizer (linearAction d) vectorFour := by
  change (insidePoint d).map _ = _
  exact Subgroup.map_subgroupOf_eq_of_le
    (show intersection d ≤ pointStabilizer (linearAction d) vectorFour from inf_le_right)

/-- The specified outer involution lies in this actual point-stabilizer Sylow. -/
theorem outerFour_mem_pointSylow :
    (⟨outerFour, outerFour_fixes_vectorFour d⟩ : pointStabilizer (linearAction d) vectorFour) ∈
      pointSylow d hnormal hcard := outer_mem_intersection d

end BinaryNaturalDual.AdaptedPair.Four.PointSylow
