module

public import Theory.Representation.BinaryNaturalDual.AdaptedPair.Five.Basic
public import Theory.SpecificGroups.BinaryLinear.OuterCyclic.RadicalOrientation.Duality
public import Mathlib.GroupTheory.SemidirectProduct
/-!
# The standard Sylow subgroup of Aut(GL₅(2))

The reversal-twisted graph automorphism sends the matrix of an upper actor to
its reversed inverse transpose, so it preserves the upper subgroup. Its inner
image and the cyclic group generated by τ have trivial intersection and generate
`standardGroup 5`. Multiplication gives an explicit semidirect-product
isomorphism, with action given by restriction of the actual automorphisms.
Consequently the standard group has order 1024 · 2 = 2048 and every element is
`conj u` or `conj u * τ` for an upper actor u.

When the inner group has index two, the standard group has the same index as
the existing upper-group Sylow of GL₅(2). Its odd index makes it Sylow in the
full automorphism group. No new flag enumeration is needed.

Source: Aschbacher–Smith, H.9.1(4), printed p.390, with the corrected adapted
choice in the source audit of 6 October 2026; consumers 12.1.1 and 12.1.3.
This module supplies the ambient Sylow, not the vector-stabilizer calculation.
-/

public section

open BinaryLinear.OuterCyclic BinaryLinear.FiveFlagGeometry
open BinaryLinear.FiveFlagGeometry.SylowOvergroups
namespace BinaryNaturalDual.AdaptedPair.Five

/-- Reversing the inverse transpose preserves the upper-triangular orientation. -/
theorem tau_matrix (g : LinearGroup 5) (i j : Fin 5) :
    matrix (tau 5 g) i j = matrix g⁻¹ j.rev i.rev := by
  rw [matrix_apply, matrix_apply]
  simp only [tau, MulAut.mul_apply, MulAut.conj_apply, LinearEquiv.mul_apply]
  simp only [standardBasis, Pi.basisFun_apply]
  change (graphLinear 5 g (reversal 5 (axis j))) i.rev = g⁻¹ (axis i.rev) j.rev
  rw [reversal_axis]
  have h := graphLinear_dotProduct g (axis j.rev) (g⁻¹ (axis i.rev))
  simpa [axis] using h

theorem tau_maps_upper {g : LinearGroup 5} (hg : g ∈ upperGroup 5) :
    tau 5 g ∈ upperGroup 5 := by
  rw [upperGroup_eq_standardBorel, mem_standardBorel_iff]
  intro i j hji
  rw [tau_matrix]
  exact (mem_standardBorel_iff g⁻¹).mp
    (upperGroup_eq_standardBorel ▸ (upperGroup 5).inv_mem hg) (by simpa using hji)

theorem tau_inv (d : CoordinateAction 5) : (tau 5)⁻¹ = tau 5 := by
  apply inv_eq_of_mul_eq_one_left
  exact (pow_two (tau 5)).symm.trans (tau_sq d)

/-- The actual reversal-twisted graph automorphism preserves the upper subgroup. -/
theorem tau_upperGroup (d : CoordinateAction 5) :
    (upperGroup 5).map (tau 5).toMonoidHom = upperGroup 5 := by
  apply le_antisymm
  · rintro _ ⟨g, hg, rfl⟩
    exact tau_maps_upper hg
  · intro g hg
    refine ⟨tau 5 g, tau_maps_upper hg, ?_⟩
    have h := congrArg (fun a : MulAut (LinearGroup 5) => a g) (tau_sq d)
    change tau 5 (tau 5 g) = g
    simpa only [pow_two, MulAut.mul_apply, MulAut.one_apply] using h

private theorem aut_conj (a : MulAut (LinearGroup 5)) (g : LinearGroup 5) :
    a * MulAut.conj g * a⁻¹ = MulAut.conj (a g) := by
  ext x
  simp [MulAut.mul_apply, MulAut.conj_apply]

/-- Conjugation by τ normalizes the inner image of the upper subgroup. -/
theorem tau_normalizes_upperImage (d : CoordinateAction 5) :
    tau 5 ∈ Subgroup.normalizer ((upperGroup 5).map MulAut.conj : Set (MulAut (LinearGroup 5))) := by
  apply Subgroup.mem_normalizer_iff.mpr
  intro a
  constructor
  · rintro ⟨g, hg, rfl⟩
    rw [aut_conj]
    exact Subgroup.mem_map_of_mem _ (tau_maps_upper hg)
  · intro ha
    obtain ⟨g, hg, he⟩ := ha
    refine ⟨tau 5 g, tau_maps_upper hg, ?_⟩
    rw [← aut_conj, he, tau_inv d]
    have ht : tau 5 * tau 5 = 1 := (pow_two _).symm.trans (tau_sq d)
    simp only [mul_assoc, ← mul_assoc (tau 5) (tau 5), ht, one_mul,
      mul_one]

theorem tau_zpowers_normalize_upperImage (d : CoordinateAction 5) :
    Subgroup.zpowers (tau 5) ≤
      Subgroup.normalizer ((upperGroup 5).map MulAut.conj : Set (MulAut (LinearGroup 5))) :=
  Subgroup.zpowers_le.mpr (tau_normalizes_upperImage d)

theorem tau_orderOf (d : CoordinateAction 5) : orderOf (tau 5) = 2 := by
  apply orderOf_eq_prime (tau_sq d)
  intro h
  exact tau_not_inner d (h ▸ (innerGroup 5).one_mem)

theorem mem_tau_zpowers (d : CoordinateAction 5) (a : MulAut (LinearGroup 5)) :
    a ∈ Subgroup.zpowers (tau 5) ↔ a = 1 ∨ a = tau 5 := by
  classical
  rw [(isOfFinOrder_iff_pow_eq_one.mpr ⟨2, by decide, tau_sq d⟩).mem_zpowers_iff_mem_range_orderOf,
    tau_orderOf d]
  simp only [Finset.mem_image, Finset.mem_range]
  constructor
  · rintro ⟨i, hi, rfl⟩
    interval_cases i <;> simp
  · rintro (rfl | rfl)
    · exact ⟨0, by decide, pow_zero _⟩
    · exact ⟨1, by decide, pow_one _⟩

/-- The two actual cosets giving the standard automorphism Sylow. -/
theorem standardGroup_normalForm (d : CoordinateAction 5)
    (a : MulAut (LinearGroup 5)) :
    a ∈ standardGroup 5 ↔ ∃ u ∈ upperGroup 5,
      a = MulAut.conj u ∨ a = MulAut.conj u * tau 5 := by
  change a ∈ ((upperGroup 5).map MulAut.conj ⊔ Subgroup.zpowers (tau 5) :
    Subgroup (MulAut (LinearGroup 5))) ↔ _
  rw [← SetLike.mem_coe, Subgroup.coe_mul_of_right_le_normalizer_left _ _
    (tau_zpowers_normalize_upperImage d)]
  constructor
  · rintro ⟨_, ⟨u, hu, rfl⟩, b, hb, rfl⟩
    refine ⟨u, hu, ?_⟩
    rcases (mem_tau_zpowers d b).mp hb with rfl | rfl
    · exact Or.inl (mul_one _)
    · exact Or.inr rfl
  · rintro ⟨u, hu, rfl | rfl⟩
    · exact ⟨_, Subgroup.mem_map_of_mem _ hu, 1, (Subgroup.zpowers _).one_mem,
        mul_one _⟩
    · exact ⟨_, Subgroup.mem_map_of_mem _ hu, tau 5, Subgroup.mem_zpowers _, rfl⟩

theorem upperImage_disjoint_tau_zpowers (d : CoordinateAction 5) :
    Disjoint ((upperGroup 5).map MulAut.conj) (Subgroup.zpowers (tau 5)) := by
  apply Subgroup.disjoint_def.mpr
  intro a ha hb
  rcases (mem_tau_zpowers d a).mp hb with h | rfl
  · exact h
  · exact (tau_not_inner d (((upperGroup 5).map_le_range _) ha)).elim

/-- Conjugation by powers of τ on the upper inner subgroup. -/
private noncomputable def upperImageAction (d : CoordinateAction 5) :
    Subgroup.zpowers (tau 5) →* MulAut ((upperGroup 5).map MulAut.conj) :=
  ((upperGroup 5).map MulAut.conj).normalizerMonoidHom.comp
    (Subgroup.inclusion (tau_zpowers_normalize_upperImage d))

private noncomputable def upperImageSemidirectHom (d : CoordinateAction 5) :
    ((upperGroup 5).map MulAut.conj) ⋊[upperImageAction d] (Subgroup.zpowers (tau 5)) →*
      standardGroup 5 :=
  (SemidirectProduct.monoidHomSubgroup (tau_zpowers_normalize_upperImage d)).codRestrict
    (standardGroup 5) (fun x => (standardGroup 5).mul_mem
      ((show (upperGroup 5).map MulAut.conj ≤ standardGroup 5 from le_sup_left) x.left.property)
      ((show Subgroup.zpowers (tau 5) ≤ standardGroup 5 from le_sup_right) x.right.property))

/-- Multiplication identifies the internal upper and outer factors with the standard group. -/
private noncomputable def upperImageSemidirectEquiv (d : CoordinateAction 5) :
    ((upperGroup 5).map MulAut.conj) ⋊[upperImageAction d] (Subgroup.zpowers (tau 5)) ≃*
      standardGroup 5 := by
  apply MulEquiv.ofBijective (upperImageSemidirectHom d)
  constructor
  · intro x y he
    have hh : (x.left : MulAut (LinearGroup 5)) * x.right =
        (y.left : MulAut (LinearGroup 5)) * y.right := congrArg Subtype.val he
    have hp := Subgroup.mul_injective_of_disjoint (upperImage_disjoint_tau_zpowers d)
      (a₁ := (x.left, x.right)) (a₂ := (y.left, y.right)) hh
    apply SemidirectProduct.ext
    · exact congrArg Prod.fst hp
    · exact congrArg Prod.snd hp
  · intro a
    obtain ⟨u, hu, ha | ha⟩ := (standardGroup_normalForm d a.val).mp a.property
    · refine ⟨⟨⟨MulAut.conj u, Subgroup.mem_map_of_mem _ hu⟩, 1⟩, ?_⟩
      apply Subtype.ext
      change MulAut.conj u * 1 = a.val
      simpa only [mul_one] using ha.symm
    · refine ⟨⟨⟨MulAut.conj u, Subgroup.mem_map_of_mem _ hu⟩,
        ⟨tau 5, Subgroup.mem_zpowers _⟩⟩, ?_⟩
      exact Subtype.ext ha.symm

/-- The inner embedding is faithful on the actual upper subgroup. -/
private noncomputable def upperInnerEquiv (d : CoordinateAction 5) :
    upperGroup 5 ≃* (upperGroup 5).map MulAut.conj :=
  (upperGroup 5).equivMapOfInjective _ (inner_injective d)

/-- The action of powers of τ on the actual upper subgroup, transported through its inner embedding. -/
noncomputable def upperAction (d : CoordinateAction 5) :
    Subgroup.zpowers (tau 5) →* MulAut (upperGroup 5) :=
  (MulAut.congr (upperInnerEquiv d).symm).toMonoidHom.comp (upperImageAction d)

/-- The semidirect action is restriction of the original automorphism to upper actors. -/
theorem upperAction_apply (d : CoordinateAction 5) (a : Subgroup.zpowers (tau 5))
    (u : upperGroup 5) : (upperAction d a u : LinearGroup 5) = (a : MulAut (LinearGroup 5)) u := by
  apply inner_injective d
  have he : MulAut.conj (upperAction d a u : LinearGroup 5) =
      (a : MulAut (LinearGroup 5)) * MulAut.conj (u : LinearGroup 5) *
        (a : MulAut (LinearGroup 5))⁻¹ := by
    change (upperInnerEquiv d ((upperInnerEquiv d).symm
      (upperImageAction d a (upperInnerEquiv d u))) : MulAut (LinearGroup 5)) = _
    rw [MulEquiv.apply_symm_apply]
    rfl
  exact he.trans (aut_conj _ _)

/-- The genuine semidirect product of the upper subgroup by the cyclic group generated by τ. -/
noncomputable def standardSemidirectEquiv (d : CoordinateAction 5) :
    (upperGroup 5) ⋊[upperAction d] (Subgroup.zpowers (tau 5)) ≃* standardGroup 5 :=
  (SemidirectProduct.congr (upperInnerEquiv d) (MulEquiv.refl _) (by
    intro a
    apply MulEquiv.ext
    intro u
    change upperInnerEquiv d ((upperInnerEquiv d).symm
      (upperImageAction d a (upperInnerEquiv d u))) = _
    exact (upperInnerEquiv d).apply_symm_apply _)).trans (upperImageSemidirectEquiv d)

/-- The comparison sends (u, a) to the automorphism conj(u) · a. -/
theorem standardSemidirectEquiv_apply (d : CoordinateAction 5)
    (x : (upperGroup 5) ⋊[upperAction d] (Subgroup.zpowers (tau 5))) :
    (standardSemidirectEquiv d x : MulAut (LinearGroup 5)) =
      MulAut.conj (x.left : LinearGroup 5) * x.right := by rfl

theorem tau_zpowers_card (d : CoordinateAction 5) : Nat.card (Subgroup.zpowers (tau 5)) = 2 := by
  rw [Nat.card_zpowers, tau_orderOf d]

/-- The upper subgroup contributes 1024 elements and the outer factor contributes two. -/
theorem standardGroup_card (d : CoordinateAction 5) : Nat.card (standardGroup 5) = 2048 := by
  rw [← Nat.card_congr (standardSemidirectEquiv d).toEquiv, SemidirectProduct.card,
    upperGroup_card, tau_zpowers_card d]

/-- The order-two outer extension preserves the upper subgroup’s ambient index. -/
theorem standardGroup_index_eq_upper_index (d : CoordinateAction 5)
    (hindex : (innerGroup 5).index = 2) :
    (standardGroup 5).index = (upperGroup 5).index := by
  have hu : Nat.card ((upperGroup 5).map MulAut.conj) = 1024 :=
    (Nat.card_congr (upperInnerEquiv d).symm.toEquiv).trans upperGroup_card
  have hi : ((upperGroup 5).map MulAut.conj).index = (upperGroup 5).index * 2 := by
    rw [(upperGroup 5).index_map_of_injective (inner_injective d)]
    exact congrArg ((upperGroup 5).index * ·) hindex
  have hs := (standardGroup 5).index_mul_card
  have hm := ((upperGroup 5).map MulAut.conj).index_mul_card
  rw [standardGroup_card d] at hs
  rw [hu, hi] at hm
  apply Nat.eq_of_mul_eq_mul_right (by decide : 0 < 2048)
  calc
    (standardGroup 5).index * 2048 = Nat.card (MulAut (LinearGroup 5)) := hs
    _ = (upperGroup 5).index * 2 * 1024 := hm.symm
    _ = (upperGroup 5).index * 2048 := by rw [Nat.mul_assoc]

theorem standardGroup_index (d : CoordinateAction 5)
    (hindex : (innerGroup 5).index = 2) : (standardGroup 5).index = 9765 := by
  rw [standardGroup_index_eq_upper_index d hindex, upperGroup_eq_standardBorel,
    standardBorel_index]

theorem standardGroup_isPGroup (d : CoordinateAction 5) : IsPGroup 2 (standardGroup 5) :=
  IsPGroup.of_card (n := 11) (standardGroup_card d)

/-- The standard group as an ambient Sylow, using the existing full-flag Sylow theorem. -/
noncomputable def ambientSylow (d : CoordinateAction 5)
    (hindex : (innerGroup 5).index = 2) : Sylow 2 (MulAut (LinearGroup 5)) :=
  (standardGroup_isPGroup d).toSylow (by
    rw [standardGroup_index_eq_upper_index d hindex, upperGroup_eq_standardBorel]
    let : (BinaryLinear.FiveFlagGeometry.SylowOvergroups.standardSylow :
        Subgroup (LinearGroup 5)).FiniteIndex :=
      ⟨by rw [standardSylow_coe, standardBorel_index]; decide⟩
    exact BinaryLinear.FiveFlagGeometry.SylowOvergroups.standardSylow.not_dvd_index)

@[simp] theorem ambientSylow_coe (d : CoordinateAction 5)
    (hindex : (innerGroup 5).index = 2) :
    (ambientSylow d hindex : Subgroup (MulAut (LinearGroup 5))) = standardGroup 5 := by rfl

theorem exists_ambientSylow (d : CoordinateAction 5)
    (hindex : (innerGroup 5).index = 2) :
    ∃ S : Sylow 2 (MulAut (LinearGroup 5)), (S : Subgroup _) = standardGroup 5 :=
  ⟨ambientSylow d hindex, ambientSylow_coe d hindex⟩

end BinaryNaturalDual.AdaptedPair.Five
