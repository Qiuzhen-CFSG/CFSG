module

public import Theory.Representation.BinaryNaturalDual.FourActors.Model
public import Theory.Representation.BinaryNaturalDual.FourActors.Swapping
public import Theory.Representation.BinaryNaturalDual.FourActors.A2Module.Actors
public import Theory.Representation.BinaryNaturalDual.FourActors.A2Module.NaturalGeometry
public import Theory.Representation.BinaryNaturalDual.FourActors.A2Module.CoreReduction

/-!
# The mixed actor on the natural-plus-dual module in dimension four

The mixed actor is the specified eight-point subgroup with orbit lengths
2, 2, and 4, pulled back through the marked exceptional comparison. Its
inner part has order eight and is generated by three actual natural linear
transformations. Under the explicit transvection-marking premise, these are
exactly its three transvections, with distinct hyperplane axes. Their centers
give the common natural fixed plane, whose radical contains the inner actor.
Duality gives the common dual fixed plane. The outer diagonal map therefore
identifies the full actor's fixed module with the natural plane.

The diagonal images of the axes and the inner fixed module supply the lower
corank-two core inclusion. Every subgroup contributing to the core either
contains an outer actor or contains an inner nontransvection; this gives the
upper inclusion. Thus the core is the sum of the inner and outer fixed spaces,
of dimension six, and is the actual displacement span of the whole actor.

Only the universal transvection marking, the universal fixed dimensions, and
the elementary-abelian/order-sixteen facts remain explicit inputs. This module
discharges every geometric premise of CoreReduction at `naturalFixed B2`.
The parent source assembly supplies the permitted universal and actor inputs.

Source: Aschbacher–Smith, H.9.3(6), printed pp.391–392 (PDF pp.402–403).
-/

public section

namespace BinaryNaturalDual.FourActors.A2Module
open BinaryLinear BinaryLinear.OuterCyclic
open Representation.RegularCyclicNormalClosure

variable
  (hmark : ∀ g : G, IsTransvection g ↔
    (linearAlternatingEquiv g).val.cycleType = {2, 2, 2, 2})
  (hT : ∀ g : G, IsTransvection g →
    Module.finrank (ZMod 2) (BinaryNaturalDual.fixedSpace g) = 3)
  (hN : ∀ g : G, g ^ 2 = 1 → g ≠ 1 → ¬ IsTransvection g →
    Module.finrank (ZMod 2) (BinaryNaturalDual.fixedSpace g) = 2)

include hmark hT hN

/-- All the conditional core helper's geometric inputs are proved for the
actual common natural fixed plane. -/
private theorem naturalGeometry : CoreReduction.Geometry (naturalFixed B2) where
  dimension := naturalFixed_B2_finrank hmark hN
  radical := innerPreimage_B2_le_radical hmark
  other_fixed := fun _ hg hg1 hgt => other_fixedSpace_eq_naturalFixed hmark hN hg hg1 hgt
  marking := hmark
  transvection_dimension := hT
  distinct_axes := axisLinear_fixedSpace_injective hmark

/-- The dual common fixed plane is the annihilator of the natural common plane. -/
theorem dualFixed_B2_eq_dualAnnihilator :
    dualFixed B2 = (naturalFixed B2).dualAnnihilator :=
  (naturalGeometry hmark hT hN).dualFixed_eq

theorem dualFixed_B2_finrank : Module.finrank (ZMod 2) (dualFixed B2) = 2 :=
  (naturalGeometry hmark hT hN).dualFixed_dimension

/-- Every nonidentity inner nontransvection fixes precisely the common plane
on both the natural and the actual contragredient summand. -/
theorem other_fixedSpaces_eq_common {g : G} (hg : g ∈ innerPreimage B2)
    (hg1 : g ≠ 1) (hgt : ¬ IsTransvection g) :
    BinaryNaturalDual.fixedSpace g = naturalFixed B2 ∧
      BinaryNaturalDual.fixedSpace g.symm.dualMap = dualFixed B2 :=
  ⟨other_fixedSpace_eq_naturalFixed hmark hN hg hg1 hgt,
    (naturalGeometry hmark hT hN).other_dual_fixed_eq_common hg hg1 hgt⟩

/-- The inner fixed module is the literal product of the two fixed planes. -/
theorem actorFixed_B2_eq (d : CoordinateAction 4) :
    actorFixed d B2 = (naturalFixed B2).prod (naturalFixed B2).dualAnnihilator :=
  (naturalGeometry hmark hT hN).actorFixed_eq d

theorem actorFixed_B2_finrank (d : CoordinateAction 4) :
    Module.finrank (ZMod 2) (actorFixed d B2) = 4 :=
  (naturalGeometry hmark hT hN).actorFixed_dimension d

variable [IsElementaryAbelian 2 A2]

omit hT in
/-- The common fixed module of the full mixed actor has dimension two. -/
theorem actor_fixed_finrank (d : CoordinateAction 4) :
    Module.finrank (ZMod 2) (actorFixed d A2) = 2 := by
  rw [actorFixed_A2_finrank, naturalFixed_B2_finrank hmark hN]

/-- The source's mixed sum has dimension six for every outer actor. -/
theorem mixed_fixed_sum_finrank (d : CoordinateAction 4) {a : M}
    (ha : a ∈ A2) (haB : a ∉ B2) :
    Module.finrank (ZMod 2)
      ↥(actorFixed d B2 ⊔ BinaryNaturalDual.fixedSpace (action d a)) = 6 :=
  (naturalGeometry hmark hT hN).mixed_dimension d ha haB

/-- The displayed sum is the actual module commutator [V,A2]. -/
theorem mixed_fixed_sum_eq_displacement (d : CoordinateAction 4) {a : M}
    (ha : a ∈ A2) (haB : a ∉ B2) :
    actorFixed d B2 ⊔ BinaryNaturalDual.fixedSpace (action d a) =
      displacementSpan d.representation A2 ⊤ :=
  (naturalGeometry hmark hT hN).mixed_eq_displacement d ha haB

/-- The sum is independent of the chosen element outside the inner actor. -/
theorem mixed_fixed_sum_independent (d : CoordinateAction 4) {a a' : M}
    (ha : a ∈ A2) (haB : a ∉ B2) (ha' : a' ∈ A2) (haB' : a' ∉ B2) :
    actorFixed d B2 ⊔ BinaryNaturalDual.fixedSpace (action d a) =
      actorFixed d B2 ⊔ BinaryNaturalDual.fixedSpace (action d a') :=
  (naturalGeometry hmark hT hN).mixed_independent d ha haB ha' haB'

/-- Distinct natural axes supply the whole outer fixed module in the actual
generated core via their diagonal images and the generated four-groups. -/
theorem outer_fixed_le_actorCore (hcard : Nat.card A2 = 16) (d : CoordinateAction 4)
    {a : M} (ha : a ∈ A2) (haB : a ∉ B2) :
    BinaryNaturalDual.fixedSpace (action d a) ≤ actorCore d A2 2 :=
  (naturalGeometry hmark hT hN).outer_fixed_le_core hcard d ha haB

/-- The lower inclusion, retaining both actual fixed-space summands. -/
theorem mixed_fixed_sum_le_actorCore (hcard : Nat.card A2 = 16) (d : CoordinateAction 4)
    {a : M} (ha : a ∈ A2) (haB : a ∉ B2) :
    actorFixed d B2 ⊔ BinaryNaturalDual.fixedSpace (action d a) ≤ actorCore d A2 2 :=
  (naturalGeometry hmark hT hN).mixed_le_core hcard d ha haB

/-- Every subgroup of corank at most two has its fixed space in the mixed sum. -/
theorem actorCore_le_mixed_fixed_sum (hcard : Nat.card A2 = 16) (d : CoordinateAction 4)
    {a : M} (ha : a ∈ A2) (haB : a ∉ B2) :
    actorCore d A2 2 ≤ actorFixed d B2 ⊔ BinaryNaturalDual.fixedSpace (action d a) :=
  (naturalGeometry hmark hT hN).core_le_mixed hcard d ha haB

/-- The corank-two core formula, with all natural geometric premises discharged. -/
theorem actorCore_eq_mixed_fixed_sum (hcard : Nat.card A2 = 16) (d : CoordinateAction 4)
    {a : M} (ha : a ∈ A2) (haB : a ∉ B2) :
    actorCore d A2 2 = actorFixed d B2 ⊔ BinaryNaturalDual.fixedSpace (action d a) :=
  (naturalGeometry hmark hT hN).core_eq_mixed hcard d ha haB

theorem actorCore_eq_displacement (hcard : Nat.card A2 = 16) (d : CoordinateAction 4) :
    actorCore d A2 2 = displacementSpan d.representation A2 ⊤ :=
  (naturalGeometry hmark hT hN).core_eq_displacement hcard d

theorem actorCore_finrank (hcard : Nat.card A2 = 16) (d : CoordinateAction 4) :
    Module.finrank (ZMod 2) (actorCore d A2 2) = 6 :=
  (naturalGeometry hmark hT hN).core_dimension hcard d

/-- The fixed-space and core clauses of H.9.3(6), conditional only on the
permitted universal linear facts and the actor's elementary order. -/
theorem parameters (hcard : Nat.card A2 = 16) (d : CoordinateAction 4)
    {a : M} (ha : a ∈ A2) (haB : a ∉ B2) :
    (∀ v : V, v ∈ actorFixed d A2 ↔ ∃ x ∈ naturalFixed B2,
      (x, 0) + d.representation a (x, 0) = v) ∧
    Module.finrank (ZMod 2) (actorFixed d A2) = 2 ∧
    actorCore d A2 2 = actorFixed d B2 ⊔ BinaryNaturalDual.fixedSpace (action d a) ∧
    Module.finrank (ZMod 2) (actorCore d A2 2) = 6 :=
  ⟨actorFixed_A2_iff d ha haB, actor_fixed_finrank hmark hN d,
    actorCore_eq_mixed_fixed_sum hmark hT hN hcard d ha haB,
    actorCore_finrank hmark hT hN hcard d⟩

end BinaryNaturalDual.FourActors.A2Module
