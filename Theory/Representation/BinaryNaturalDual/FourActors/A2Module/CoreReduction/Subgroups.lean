module

public import Theory.Representation.BinaryNaturalDual.FourActors.A2Module.CoreReduction.Geometry

/-!
# Actor subgroups contributing to the mixed corank-two core

The numerical corank condition is converted using the actual subgroup index
and the order-sixteen actor. The inner subgroup contributes its fixed space,
and each subgroup generated by an outer actor and a marked transvection has
at least four elements. A subgroup of the inner actor with four elements
must contain a nontransvection: two distinct transvections have such a product.

Source: Aschbacher–Smith H.9.3(6), printed pp.391–392 (PDF pp.402–403).
The transvection marking remains a conditional natural input.
-/

@[expose] public section
namespace BinaryNaturalDual.FourActors.A2Module.CoreReduction
open BinaryLinear BinaryLinear.OuterCyclic Subgroup

local instance : Finite M := Finite.of_equiv S permutationEquiv.symm.toEquiv

/-- The numerical corank condition forces an actor subgroup to have at least four elements. -/
theorem four_le_card_of_corank (hcard : Nat.card A2 = 16) (H : Subgroup A2)
    (hH : Nat.log 2 H.index ≤ 2) : 4 ≤ Nat.card H := by
  have hi : H.index < 8 := Nat.lt_pow_of_log_lt (x := 3) (y := H.index) (by decide : 1 < 2) (by omega)
  have hm := H.card_mul_index
  rw [hcard] at hm
  by_contra hn
  have hb : Nat.card H ≤ 3 := by omega
  interval_cases he : Nat.card H <;> omega

/-- At least four elements suffice for the actual corank-two index bound. -/
theorem corank_of_four_le_card (hcard : Nat.card A2 = 16) (H : Subgroup A2)
    (hH : 4 ≤ Nat.card H) : Nat.log 2 H.index ≤ 2 := by
  have hm := H.card_mul_index
  rw [hcard] at hm
  have hi : H.index ≤ 4 := by nlinarith
  exact (Nat.log_mono_right hi).trans (by decide)

private theorem card_four_of_crossing {D : Type*} [Group D] [Finite D]
    (H K : Subgroup D) {a b : D} (ha : a ∈ H) (hb : b ∈ H)
    (haK : a ∉ K) (hbK : b ∈ K) (hb1 : b ≠ 1) : 4 ≤ Nat.card H := by
  classical
  have ha1 : a ≠ 1 := fun he => haK (he ▸ K.one_mem)
  have hab : a ≠ b := fun he => haK (he ▸ hbK)
  have hab1 : a * b ≠ 1 := by
    intro he
    apply haK
    have h : a * b ∈ K := he ▸ K.one_mem
    exact (K.mul_mem_cancel_right hbK).mp h
  let f : Fin 4 → H := ![1, ⟨a, ha⟩, ⟨b, hb⟩, ⟨a * b, H.mul_mem ha hb⟩]
  have hf : Function.Injective f := by
    intro i j he
    have hv := congrArg Subtype.val he
    have ht (k : Fin 4) : (f k : D) = ![1, a, b, a * b] k := by
      fin_cases k <;> rfl
    rw [ht i, ht j] at hv
    clear he ht f
    fin_cases i <;> fin_cases j <;> simp at hv ⊢
    all_goals first
      | exact ha1 hv
      | exact ha1 hv.symm
      | exact hb1 hv
      | exact hb1 hv.symm
      | exact hab hv
      | exact hab hv.symm
      | exact hab1 hv
      | exact hab1 hv.symm
  simpa using Nat.card_le_card_of_injective f hf

/-- The four-group generated by an outer actor and a marked transvection,
inside the actual A2. -/
noncomputable def axisPair (a : A2) (i : Fin 3) : Subgroup A2 :=
  closure ({a, ⟨MulAut.conj (axisLinear i), (conj_axisLinear_mem i).1⟩} : Set A2)

theorem axisPair_corank (hcard : Nat.card A2 = 16) (a : A2) (haB : a.val ∉ B2)
    (i : Fin 3) : Nat.log 2 (axisPair a i).index ≤ 2 := by
  apply corank_of_four_le_card hcard
  apply card_four_of_crossing (axisPair a i) (B2.subgroupOf A2)
    (a := a) (b := ⟨MulAut.conj (axisLinear i), (conj_axisLinear_mem i).1⟩)
  · exact subset_closure (by simp)
  · exact subset_closure (by simp)
  · exact haB
  · exact conj_axisLinear_mem i
  · intro he
    have hv : MulAut.conj (axisLinear i) = MulAut.conj (1 : G) := congrArg Subtype.val he
    exact axisLinear_ne_one i
      (MulAut.conj_injective_of_center_eq_bot center_linear_eq_bot hv)

/-- The inner actor itself is among the subgroups defining the corank-two core. -/
theorem inner_corank (hcard : Nat.card A2 = 16) :
    Nat.log 2 (B2.subgroupOf A2).index ≤ 2 := by
  apply corank_of_four_le_card hcard
  have hc := Nat.card_congr (subgroupOfEquivOfLe (show B2 ≤ A2 from inf_le_left)).toEquiv
  rw [card_B2] at hc
  omega

namespace Geometry
variable {U : Submodule (ZMod 2) X} (h : Geometry U)
include h

/-- A subgroup of the inner actor containing four elements cannot consist
only of the identity and transvections: distinct marked transvections have
nontransvection products. -/
theorem large_inner_contains_other (K : Subgroup M) (hKB : K ≤ B2) (hK : 4 ≤ Nat.card K) :
    ∃ g : G, MulAut.conj g ∈ K ∧ g ≠ 1 ∧ ¬ IsTransvection g := by
  classical
  by_contra hn
  have hall (g : G) (hg : MulAut.conj g ∈ K) (hg1 : g ≠ 1) : IsTransvection g := by
    by_contra hgt
    exact hn ⟨g, hg, hg1, hgt⟩
  have haxis (x : K) (hx : x ≠ 1) : ∃ i : Fin 3, x.val = MulAut.conj (axisLinear i) := by
    obtain ⟨g, hg⟩ := (hKB x.property).2
    have hgK : MulAut.conj g ∈ K := hg.symm ▸ x.property
    have hg1 : g ≠ 1 := by
      intro he
      apply hx
      apply Subtype.ext
      rw [← hg, he, map_one]
      rfl
    obtain ⟨i, rfl⟩ := (isTransvection_iff_axisLinear h.marking (hKB hgK)).mp (hall g hgK hg1)
    exact ⟨i, hg.symm⟩
  obtain ⟨x, hx⟩ : ∃ x : K, x ≠ 1 := by
    by_contra hn1
    push Not at hn1
    let : Subsingleton K := ⟨fun x y => (hn1 x).trans (hn1 y).symm⟩
    have hc := Nat.card_of_subsingleton (1 : K)
    omega
  obtain ⟨i, hi⟩ := haxis x hx
  have hy (y : K) : y = 1 ∨ y = x := by
    by_cases hy1 : y = 1
    · exact Or.inl hy1
    right
    obtain ⟨j, hj⟩ := haxis y hy1
    by_cases hij : i = j
    · apply Subtype.ext
      rw [hi, hj, hij]
    exfalso
    have hp : MulAut.conj (axisLinear i * axisLinear j) ∈ K := by
      rw [map_mul, ← hi, ← hj]
      exact K.mul_mem x.property y.property
    have hp1 : axisLinear i * axisLinear j ≠ 1 := by
      intro he
      have hs : axisLinear j * axisLinear j = 1 := by
        simpa only [pow_two] using axisLinear_square j
      apply hij
      apply axisLinear_injective
      calc
        axisLinear i = axisLinear i * (axisLinear j * axisLinear j) := by rw [hs, mul_one]
        _ = axisLinear i * axisLinear j * axisLinear j := (mul_assoc _ _ _).symm
        _ = axisLinear j := by rw [he, one_mul]
    exact axisLinear_mul_not_transvection h.marking hij (hall _ hp hp1)
  let f : K → Fin 2 := fun y => if y = 1 then 0 else 1
  have hf : Function.Injective f := by
    intro y z he
    rcases hy y with rfl | rfl <;> rcases hy z with rfl | rfl <;> simp_all [f]
  have hc := Nat.card_le_card_of_injective f hf
  have : Nat.card K ≤ 2 := by simpa using hc
  omega

end Geometry
end BinaryNaturalDual.FourActors.A2Module.CoreReduction
