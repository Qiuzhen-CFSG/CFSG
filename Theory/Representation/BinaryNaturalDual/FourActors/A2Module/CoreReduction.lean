module

public import Theory.Representation.BinaryNaturalDual.FourActors.A2Module.Actors
public import Theory.Representation.BinaryNaturalDual.FourActors.Swapping
public import Theory.Representation.BinaryNaturalDual.FourActors.A2Module.CoreReduction.MixedSpace
public import Theory.Representation.BinaryNaturalDual.FourActors.A2Module.CoreReduction.Subgroups

/-!
# The mixed corank-two core from natural geometry

For the actual degree-four coordinate action and mixed actor A2, the natural
geometric inputs force the corank-two core to be C_V(B2) + C_V(a), for every
outer a in A2. This is the literal displacement span [V,A2] and has dimension
six. The two core inclusions are exported separately.

For the lower inclusion, B2 itself contributes its fixed module. Two distinct
three-dimensional natural axes span X; their outer diagonal images are fixed
by the subgroups generated by a and the corresponding marked transvections.
Those subgroups have index at most four in A2. For the upper inclusion, every
subgroup allowed in the core has at least four elements. If it lies in B2 it
contains a nontransvection; otherwise it contains an outer actor. The fixed
spaces in both cases lie in the common mixed displacement space.

This is a conditional helper for Aschbacher–Smith H.9.3(6), printed pp.391–392
(PDF pp.402–403). Geometry contains only the permitted natural-space premises;
the elementary-abelian and order-sixteen premises are explicit. The source
assembly still owns their discharge and is not asserted complete here.
-/

@[expose] public section
namespace BinaryNaturalDual.FourActors.A2Module.CoreReduction
open BinaryLinear BinaryLinear.OuterCyclic Subgroup
open Representation.RegularCyclicNormalClosure

local instance : Finite M := Finite.of_equiv S permutationEquiv.symm.toEquiv

private theorem fixed_of_mem_closure_pair {D W : Type*} [Group D]
    [AddCommGroup W] [Module (ZMod 2) W] (ρ : Representation (ZMod 2) D W)
    (a b : D) (v : W) (ha : ρ a v = v) (hb : ρ b v = v)
    {g : D} (hg : g ∈ closure ({a, b} : Set D)) : ρ g v = v := by
  induction hg using Subgroup.closure_induction with
  | mem c hc =>
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hc
    rcases hc with rfl | rfl
    · exact ha
    · exact hb
  | one => simp
  | mul c e _ _ hc he => rw [map_mul, Module.End.mul_apply, he, hc]
  | inv c _ hc => exact ρ.inv_apply_eq_iff.mpr hc.symm

/-- The inner actor contributes its whole fixed module to the actual core. -/
theorem inner_fixed_le_core (hcard : Nat.card A2 = 16) (d : CoordinateAction 4) :
    actorFixed d B2 ≤ actorCore d A2 2 := by
  intro v hv
  apply fixedSpace_le_generatedCore (d.representation.comp A2.subtype) (inner_corank hcard)
  intro g
  exact (mem_actorFixed d B2 v).mp hv g.val.val g.property

variable [IsElementaryAbelian 2 A2]

/-- The natural axis maps into the fixed space of its genuine generated four-group. -/
theorem diagonal_axis_fixed (d : CoordinateAction 4) (a : A2) (haB : a.val ∉ B2)
    (i : Fin 3) (x : X) (hx : x ∈ BinaryNaturalDual.fixedSpace (axisLinear i)) :
    (outerDiagonalEquiv d a.val (elemPow_eq_one_of_isElementaryAbelian a.val a.property)
      (outer_not_inner a.property haB) x : V) ∈
      Representation.BinaryOffender.fixedSpace (d.representation.comp A2.subtype) (axisPair a i) := by
  let ha := elemPow_eq_one_of_isElementaryAbelian (p := 2) a.val a.property
  let ho := outer_not_inner a.property haB
  let v : V := outerDiagonalEquiv d a.val ha ho x
  have hva : d.representation a.val v = v :=
    (mem_fixedSpace _ _).mp (outerDiagonalEquiv d a.val ha ho x).property
  have hcomm : a.val (axisLinear i) = axisLinear i :=
    (conj_commute_iff_fixed a.val (axisLinear i)).mp
      (show Commute (MulAut.conj (axisLinear i)) a.val from
        A2_commute (conj_axisLinear_mem i).1 a.property)
  have hvb : d.representation (MulAut.conj (axisLinear i)) v = v := by
    have he := outerDiagonalEquiv_equivariant d a.val ha ho (axisLinear i) hcomm x
    rw [(mem_fixedSpace _ _).mp hx] at he
    exact he.symm
  intro g
  exact fixed_of_mem_closure_pair (d.representation.comp A2.subtype) a
    ⟨MulAut.conj (axisLinear i), (conj_axisLinear_mem i).1⟩ v hva hvb g.property

namespace Geometry
variable {U : Submodule (ZMod 2) X} (h : Geometry U)
include h

omit [IsElementaryAbelian 2 A2] in
/-- Two distinct three-dimensional axes already span the natural four-space. -/
theorem axes_span : BinaryNaturalDual.fixedSpace (axisLinear 0) ⊔
    BinaryNaturalDual.fixedSpace (axisLinear 1) = ⊤ := by
  let P := BinaryNaturalDual.fixedSpace (axisLinear 0)
  let Q := BinaryNaturalDual.fixedSpace (axisLinear 1)
  have hp : Module.finrank (ZMod 2) P = 3 :=
    h.transvection_dimension _ (axisLinear_isTransvection h.marking 0)
  have hq : Module.finrank (ZMod 2) Q = 3 :=
    h.transvection_dimension _ (axisLinear_isTransvection h.marking 1)
  have hn : ¬ Q ≤ P := by
    intro hle
    have he := Submodule.eq_of_le_of_finrank_eq hle (hq.trans hp.symm)
    exact (by decide : (1 : Fin 3) ≠ 0) (h.distinct_axes he)
  have hlt : P < P ⊔ Q := lt_of_le_of_ne le_sup_left (by
    intro he
    exact hn (he ▸ (show Q ≤ P ⊔ Q from le_sup_right)))
  have hd := Submodule.finrank_lt_finrank_of_lt hlt
  have hu := Submodule.finrank_le (P ⊔ Q)
  have hX : Module.finrank (ZMod 2) X = 4 := by simp [X, BinaryLinear.OuterCyclic.Space]
  apply Submodule.eq_top_of_finrank_eq
  change Module.finrank (ZMod 2) ↥(P ⊔ Q) = Module.finrank (ZMod 2) X
  rw [hp] at hd
  rw [hX] at hu ⊢
  omega

/-- The diagonal images of the axes supply the whole outer fixed space. -/
theorem outer_fixed_le_core (hcard : Nat.card A2 = 16) (d : CoordinateAction 4)
    {a : M} (ha : a ∈ A2) (haB : a ∉ B2) :
    BinaryNaturalDual.fixedSpace (action d a) ≤ actorCore d A2 2 := by
  let E := outerDiagonalEquiv d a (elemPow_eq_one_of_isElementaryAbelian a ha)
    (outer_not_inner ha haB)
  have hi (i : Fin 3) (x : X) (hx : x ∈ BinaryNaturalDual.fixedSpace (axisLinear i)) :
      (E x : V) ∈ actorCore d A2 2 :=
    fixedSpace_le_generatedCore (d.representation.comp A2.subtype)
      (axisPair_corank hcard ⟨a, ha⟩ haB i) (diagonal_axis_fixed d ⟨a, ha⟩ haB i x hx)
  intro v hv
  obtain ⟨x, hx⟩ := E.surjective ⟨v, hv⟩
  have hxt : x ∈ BinaryNaturalDual.fixedSpace (axisLinear 0) ⊔
      BinaryNaturalDual.fixedSpace (axisLinear 1) := by rw [h.axes_span]; trivial
  obtain ⟨y, hy, z, hz, he⟩ := Submodule.mem_sup.mp hxt
  have hvx : (E x : V) = v := congrArg Subtype.val hx
  rw [← hvx, ← he, map_add]
  exact (actorCore d A2 2).add_mem (hi 0 y hy) (hi 1 z hz)

/-- Both summands occur in the actual corank-two generated core. -/
theorem mixed_le_core (hcard : Nat.card A2 = 16) (d : CoordinateAction 4)
    {a : M} (ha : a ∈ A2) (haB : a ∉ B2) : mixedSpace d a ≤ actorCore d A2 2 :=
  sup_le (inner_fixed_le_core hcard d) (h.outer_fixed_le_core hcard d ha haB)

/-- A large inner subgroup contains a nontransvection; a subgroup crossing
B2 contains an outer actor. In either case its fixed module lies in the same sum. -/
theorem core_le_mixed (hcard : Nat.card A2 = 16) (d : CoordinateAction 4)
    {a : M} (ha : a ∈ A2) (haB : a ∉ B2) : actorCore d A2 2 ≤ mixedSpace d a := by
  apply generatedCore_le
  intro H hH v hv
  let K : Subgroup M := H.map A2.subtype
  have hKA : K ≤ A2 := by
    rintro c ⟨b, _, rfl⟩
    exact b.property
  have hvK : v ∈ actorFixed d K := by
    apply (mem_actorFixed d K v).mpr
    rintro c ⟨b, hb, rfl⟩
    exact hv ⟨b, hb⟩
  by_cases hKB : K ≤ B2
  · have hcK : 4 ≤ Nat.card K := by
      rw [show Nat.card K = Nat.card H from Subgroup.card_subtype A2 H]
      exact four_le_card_of_corank hcard H hH
    obtain ⟨g, hg, hg1, hgt⟩ := h.large_inner_contains_other K hKB hcK
    have hf : v ∈ BinaryNaturalDual.fixedSpace (action d (MulAut.conj g)) :=
      (mem_fixedSpace _ _).mpr ((mem_actorFixed d K v).mp hvK _ hg)
    rw [h.other_actor_fixed_eq d (hKB hg) hg1 hgt] at hf
    exact Submodule.mem_sup_left hf
  · obtain ⟨c, hc, hcB⟩ : ∃ c ∈ K, c ∉ B2 := SetLike.not_le_iff_exists.mp hKB
    have hf : v ∈ BinaryNaturalDual.fixedSpace (action d c) :=
      (mem_fixedSpace _ _).mpr ((mem_actorFixed d K v).mp hvK c hc)
    rw [h.mixed_independent d ha haB (hKA hc) hcB]
    exact Submodule.mem_sup_right hf

/-- Conditional core calculation, retaining both inclusions and the literal mixed sum. -/
theorem core_eq_mixed (hcard : Nat.card A2 = 16) (d : CoordinateAction 4)
    {a : M} (ha : a ∈ A2) (haB : a ∉ B2) :
    actorCore d A2 2 = actorFixed d B2 ⊔ BinaryNaturalDual.fixedSpace (action d a) :=
  le_antisymm (h.core_le_mixed hcard d ha haB) (h.mixed_le_core hcard d ha haB)

/-- The corank-two core is the actual displacement span of the entire actor. -/
theorem core_eq_displacement (hcard : Nat.card A2 = 16) (d : CoordinateAction 4) :
    actorCore d A2 2 = displacementSpan d.representation A2 ⊤ := by
  have htB : transposition ∉ B2 := fun ht => transposition_outer ht.2
  exact (h.core_eq_mixed hcard d transposition_mem_A2 htB).trans
    (h.mixed_eq_displacement d transposition_mem_A2 htB)

/-- The conditional core has dimension six. -/
theorem core_dimension (hcard : Nat.card A2 = 16) (d : CoordinateAction 4) :
    Module.finrank (ZMod 2) (actorCore d A2 2) = 6 := by
  have htB : transposition ∉ B2 := fun ht => transposition_outer ht.2
  rw [h.core_eq_mixed hcard d transposition_mem_A2 htB]
  exact h.mixed_dimension d transposition_mem_A2 htB

end Geometry
end BinaryNaturalDual.FourActors.A2Module.CoreReduction
