module

public import Theory.Representation.BinaryNaturalDual.ModelOrbits.AutomorphismModel
public import Theory.Representation.BinaryNaturalDual.ModelOrbits.SylowTransport
public import Theory.Representation.BinaryNaturalDual.AdaptedPair.Four.UpperSylow
public import Theory.Representation.BinaryNaturalDual.AdaptedPair.Four.FixedSpaces
public import Theory.Representation.BinaryNaturalDual.AdaptedPair.Five.AmbientSylow
public import Theory.Representation.BinaryNaturalDual.AdaptedPair.Five.FixedSpaces

/-!
# The Sylow characterization of singular diagonal vectors

The standard upper-unitriangular and reversal-graph Sylow subgroup fixes
exactly the line generated by (e₁,eₙ*). The checked four- and five-dimensional
calculations supply this line; exact inner index two discharges their remaining
group input. Binary scalar arithmetic and conjugacy then show that the singular
diagonal vectors are precisely the nonzero vectors fixed by some Sylow subgroup.

Source: Aschbacher–Smith, H.9.1(2), printed p.390. The Sylow quantifier is
existential, with no assertion that one fixed Sylow fixes the whole orbit.
-/

public section

open BinaryNaturalDual BinaryNaturalDual.ModelOrbits BinaryNaturalDual.AdaptedPair
open BinaryLinear.OuterCyclic

namespace BinaryNaturalDual.ModelOrbits

private theorem span_binary {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    (z w : V) : w ∈ Submodule.span (ZMod 2) {z} ↔ w = 0 ∨ w = z := by
  rw [Submodule.mem_span_singleton]
  constructor
  · rintro ⟨c, rfl⟩
    have hc : c = 0 ∨ c = 1 := (by decide : ∀ c : ZMod 2, c = 0 ∨ c = 1) c
    rcases hc with rfl | rfl <;> simp
  · rintro (rfl | rfl)
    · exact ⟨0, zero_smul _ _⟩
    · exact ⟨1, one_smul _ _⟩

/-- One actual Sylow fixes exactly zero and a singular diagonal vector. -/
theorem exists_standard_sylow_fixed_line {n : ℕ} (hn : n = 4 ∨ n = 5) (A : CoordinateAction n) :
    ∃ (P : Sylow 2 (MulAut (LinearGroup n))) (z : CoordinateSpace n),
      IsSingularDiagonal z ∧
      ∀ w, (∀ a ∈ P, A.representation a w = w) ↔ w = 0 ∨ w = z := by
  rcases hn with rfl | rfl
  · have hindex : (innerGroup 4).index = 2 := AutomorphismModel.inner_index (Or.inl rfl)
    refine ⟨Four.UpperSylow.standardSylow A hindex,
      fixedVector 4, ?_, ?_⟩
    · refine ⟨?_, ?_, ?_⟩
      · intro h
        have he := congrFun h 0
        simp [fixedVector, axis] at he
      · intro h
        have he := LinearMap.congr_fun h (axis 3)
        simp [fixedVector, axis] at he
      · simp [fixedVector, axis]
    · intro w
      change (∀ a ∈ (Four.UpperSylow.standardSylow A _ : Subgroup (MulAut (LinearGroup 4))),
        A.representation a w = w) ↔ _
      rw [Four.UpperSylow.standardSylow_coe]
      change w ∈ fixedVectors (linearAction A) (standardGroup 4) ↔ _
      rw [Four.fixedVectors_standard, span_binary]
  · have hindex : (innerGroup 5).index = 2 := AutomorphismModel.inner_index (Or.inr rfl)
    refine ⟨Five.ambientSylow A hindex,
      fixedVector 5, ?_, ?_⟩
    · refine ⟨?_, ?_, ?_⟩
      · intro h
        have he := congrFun h 0
        simp [fixedVector, axis] at he
      · intro h
        have he := LinearMap.congr_fun h (axis 4)
        simp [fixedVector, axis] at he
      · simp [fixedVector, axis]
    · intro w
      change (∀ a ∈ (Five.ambientSylow A _ : Subgroup (MulAut (LinearGroup 5))),
        A.representation a w = w) ↔ _
      rw [Five.ambientSylow_coe]
      change w ∈ fixedVectors (linearAction A) (standardGroup 5) ↔ _
      rw [Five.standard_fixedVectors, span_binary]


/-- The complete existential Sylow clause, with the standard fixed-line input discharged. -/
theorem singularDiagonal_iff_exists_sylow_fixed {n : ℕ}
    (hn : n = 4 ∨ n = 5) (A : CoordinateAction n)
    {v : CoordinateSpace n} (hv : v ≠ 0) :
    IsSingularDiagonal v ↔
      ∃ P : Sylow 2 (MulAut (LinearGroup n)), ∀ a ∈ P, A.representation a v = v := by
  obtain ⟨P, z, hz, hP⟩ := exists_standard_sylow_fixed_line hn A
  exact singularDiagonal_iff_exists_sylow_fixed_of_standard hn A P z hz hP hv

end BinaryNaturalDual.ModelOrbits
