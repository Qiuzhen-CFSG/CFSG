module

public import Theory.Representation.BinaryNaturalDual.FiveActors.ModuleGeometry.Commutator
public import Theory.Representation.BinaryNaturalDual.FiveActors.ModuleGeometry.Rank

/-!
# Outer fixed-module geometry and high-rank innerness in degree five

For the explicitly supplied natural-plus-dual coordinate action, an outer
involution has fixed space equal to its displacement image. The literal
map w ↦ (w,0) + t(w,0) is an equivariant equivalence. The fixed space splits
as a nonsingular fixed line plus its actual centralizer commutator module;
the latter is genuinely equivalent to the designated four-dimensional polar
S₆ module. A sharp centralizer rank bound proves that elementary actors of
rank at least five are inner.

The proof transports the existing inverse-transpose coordinates through an
inner conjugator. Transitivity of S₆ on nonzero polar vectors shows that
the four-space is generated by actual displacements. Nonabelian Sylow
subgroups give the sharp rank bound without enumerating S₆ subgroups.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), H.9.2(1–2),
printed p.390 (PDF p.401). Existence of `CoordinateAction 5` and the remaining
clauses of H.9.2 are separate obligations of the source-theorem assembly.
-/

public section

open BinaryNaturalDual.AdaptedPair
open Theory.SpecificGroups.SymmetricSix
namespace BinaryNaturalDual.FiveActors.ModuleGeometry

/-- Every outer involution has the stated nonsingular fixed-line decomposition,
with a genuine intertwining equivalence onto its actual commutator module. -/
theorem outer_fixed_decomposition (d : CoordinateAction 5)
    (t : M) (ht : t ^ 2 = 1) (hout : t ∉ L) :
    ∃ (v : fixedSpace (linearAction d t)) (e : innerCentralizer t ≃* S6)
      (η : NaturalModule ≃ₗ[ZMod 2] centralizerCommutator d t),
      quadratic (v : V) = 1 ∧
      (∀ a : innerCentralizer t, d.representation a.val v = v) ∧
      IsCompl (Submodule.span (ZMod 2) {v}) (centralizerCommutator d t) ∧
      fixedSpace (linearAction d t) =
        Submodule.span (ZMod 2) {(v : V)} ⊔ ambientCommutator d t ∧
      Disjoint (Submodule.span (ZMod 2) {(v : V)}) (ambientCommutator d t) ∧
      Module.finrank (ZMod 2) (Submodule.span (ZMod 2) {(v : V)}) = 1 ∧
      Module.finrank (ZMod 2) (centralizerCommutator d t) = 4 ∧
      ∀ (a : innerCentralizer t) (w : NaturalModule),
        ((η (polarAction (e a) w) : fixedSpace (linearAction d t)) : V) =
          d.representation a.val ((η w : fixedSpace (linearAction d t)) : V) := by
  obtain ⟨g, hg⟩ := outer_conjugate_graph t ht hout
  exact ⟨fixedVector d t g ht hout, centralizerSixEquiv t g hg,
    naturalEquiv d t g hg ht hout, fixedVector_nonsingular d t g hg ht hout,
    fixedVector_centralized d t g hg ht hout, fixed_direct_sum d t g hg ht hout,
    ambient_fixed_sum d t g hg ht hout, ambient_fixed_disjoint d t g hg ht hout,
    fixed_line_finrank d t g hg ht hout, commutator_finrank d t g hg ht hout,
    naturalEquiv_equivariant d t g hg ht hout⟩

/-- The actual commutator subspace in the original ten-space has dimension four. -/
theorem outer_ambient_commutator_finrank (d : CoordinateAction 5)
    (t : M) (ht : t ^ 2 = 1) (hout : t ∉ L) :
    Module.finrank (ZMod 2) (ambientCommutator d t) = 4 := by
  obtain ⟨g, hg⟩ := outer_conjugate_graph t ht hout
  let e := Submodule.equivMapOfInjective (fixedSpace (linearAction d t)).subtype
    (fixedSpace (linearAction d t)).injective_subtype (centralizerCommutator d t)
  exact e.finrank_eq.symm.trans (commutator_finrank d t g hg ht hout)

end BinaryNaturalDual.FiveActors.ModuleGeometry
