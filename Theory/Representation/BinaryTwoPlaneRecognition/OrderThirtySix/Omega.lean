module
public import Theory.SpecificGroups.OrthogonalFourBinary.SylowGeometry.Omega
public import Theory.Representation.BinaryTwoPlaneRecognition.OrderThirtySix
/-!
# Marking the order-36 image as genuine omega

Let a faithful order-36 actor of exponent dividing six act on the original
binary module with cubic ratio greater than one. An intertwining linear
coordinate map to the specified plus-four quadratic space identifies its
isometry image with the subgroup generated by actual Siegel transformations.
The final group isomorphism retains that same coordinate map and the given
homomorphism into the isometry group.

In the existing 72-element isometry coordinates, an element outside omega
has unequal reflection parities. If its sixth power is the identity, its
cube fixes exactly eight of the sixteen vectors. Transporting this fixed
count back to the original module produces an involution of displacement
rank one, contradicting the cubic ratio bound. Thus the image lies in omega;
equality follows from their common order 36.

Source: Aschbacher--Smith, *The Classification of Quasithin Groups*,
D.2.22, printed p.189. In its two-plane branch the previously proved
symmetric-three product identification supplies the exponent-six condition.
The omega subgroup here is the genuine Siegel-generated group identified
by `SylowGeometry.codeMap_mem_omega`.
-/

open OrthogonalFourBinary OrthogonalFourBinary.SylowGeometry
open Subgroup Representation.BinaryOffender
namespace Representation.BinaryTwoPlaneRecognition
set_option synthInstance.maxSize 10000
set_option maxRecDepth 10000 in
private theorem finite_unbalanced_cube_fixed : ∀ i : Code,
    i.1.2 ≠ i.2.1.2 →
    (∀ v : Space, eval i (eval i (eval i (eval i (eval i (eval i v))))) = v) →
    Fintype.card {v : Space // eval i (eval i (eval i v)) = v} = 8 := by
  decide +kernel


private theorem cube_fixed_card_of_sixth_power (g : TerminalLines.IsometryGroup)
    (hg : g ^ 6 = 1) (hne : g ∉ omega) :
    Nat.card {v : Space // (g ^ 3).val v = v} = 8 := by
  obtain ⟨i,rfl⟩ := codeMap_bijective.surjective g
  change Nat.card {v : Space // candidate i (candidate i (candidate i v)) = v} = 8
  simp_rw [candidate_eval]
  rw [Nat.card_eq_fintype_card]
  apply finite_unbalanced_cube_fixed i ((codeMap_mem_omega i).not.mp hne)
  intro v
  have hv := congrArg (fun a : TerminalLines.IsometryGroup => a.val v) hg
  change candidate i (candidate i (candidate i (candidate i (candidate i (candidate i v))))) = v at hv
  simpa only [candidate_eval] using hv

variable {G V : Type*} [Group G] [Finite G]
  [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]

/-- A faithful order-36 isometry image of exponent dividing six and cubic
ratio above one is the genuine Siegel-generated omega subgroup. -/
public theorem range_eq_omega_of_exponent_six
    (ρ : Representation (ZMod 2) G V) (c : V ≃ₗ[ZMod 2] Space)
    (f : G →* TerminalLines.IsometryGroup) (hf : Function.Injective f)
    (hcoord : ∀ g v, c (ρ g v) = (f g).val (c v))
    (hcard : Nat.card G = 36) (h6 : ∀ g : G, g ^ 6 = 1)
    (hlow : 1 < cubicRatio ρ) : f.range = omega := by
  have hV : Module.finrank (ZMod 2) V = 4 :=
    c.finrank_eq.trans (by simp [Space, Plane, F])
  have hle : f.range ≤ omega := by
    rintro _ ⟨g,rfl⟩
    by_contra hg
    have hfg6 : f g ^ 6 = 1 := by rw [← map_pow, h6, map_one]
    have hcube := cube_fixed_card_of_sixth_power (f g) hfg6 hg
    have hfixed : Nat.card (fixedSpace ρ (zpowers (g ^ 3))) = 8 := by
      let e : fixedSpace ρ (zpowers (g ^ 3)) ≃
          {v : Space // (f g ^ 3).val v = v} :=
        c.toEquiv.subtypeEquiv (fun v => by
          rw [mem_fixedSpace_zpowers_iff]
          rw [← c.injective.eq_iff, hcoord, map_pow]
          rfl)
      exact (Nat.card_congr e).trans hcube
    have hpow := Module.natCard_eq_pow_finrank (K := ZMod 2)
      (V := fixedSpace ρ (zpowers (g ^ 3)))
    rw [Nat.card_zmod,hfixed] at hpow
    have hdim : Module.finrank (ZMod 2) (fixedSpace ρ (zpowers (g ^ 3))) = 3 :=
      Nat.pow_right_injective (by decide : 2 ≤ 2) hpow.symm
    have ht : (g ^ 3) ^ 2 = 1 := by rw [← pow_mul]; exact h6 g
    have htne : g ^ 3 ≠ 1 := by
      intro he
      rw [he,zpowers_one_eq_bot,fixedSpace_bot,finrank_top,hV] at hdim
      omega
    have hr : Module.finrank (ZMod 2) (LinearMap.range (ρ (g ^ 3) - LinearMap.id)) ≤ 1 := by
      rw [← fixedCodim_zpowers_eq_displacement_rank]
      have hd := fixedCodim_add_finrank ρ (zpowers (g ^ 3))
      omega
    have hb : cubicRatio ρ ≤ 1 := (isFFModule_iff_cubicRatio_le_one ρ).mp
      ⟨zpowers (g ^ 3),(bestOffender_of_involution_displacement_le_one ρ
        (g ^ 3) ht htne hr).isOffender ρ⟩
    exact not_le_of_gt hlow hb
  apply Subgroup.eq_of_le_of_card_ge hle
  have hr : Nat.card f.range = Nat.card G := Nat.card_range_of_injective hf
  rw [hr,hcard,omega_card]

/-- The marked group isomorphism retains the supplied coordinate equivalence
and the literal original isometry homomorphism. -/
public theorem exists_omega_equiv_of_exponent_six
    (ρ : Representation (ZMod 2) G V) (c : V ≃ₗ[ZMod 2] Space)
    (f : G →* TerminalLines.IsometryGroup) (hf : Function.Injective f)
    (hcoord : ∀ g v, c (ρ g v) = (f g).val (c v))
    (hcard : Nat.card G = 36) (h6 : ∀ g : G, g ^ 6 = 1)
    (hlow : 1 < cubicRatio ρ) :
    ∃ e : G ≃* omega, (∀ g : G, (e g : TerminalLines.IsometryGroup) = f g) ∧
      ∀ g v, c (ρ g v) = (e g).val.val (c v) := by
  have hr := range_eq_omega_of_exponent_six ρ c f hf hcoord hcard h6 hlow
  let a : G →* omega := f.codRestrict omega (fun g => hr ▸ (show f g ∈ f.range from ⟨g,rfl⟩))
  have hai : Function.Injective a := fun x y he => hf (congrArg Subtype.val he)
  have has : Function.Surjective a := by
    intro x
    have hx : (x : TerminalLines.IsometryGroup) ∈ f.range := hr.symm ▸ x.property
    obtain ⟨g,hg⟩ := hx
    exact ⟨g,Subtype.ext hg⟩
  refine ⟨MulEquiv.ofBijective a ⟨hai,has⟩, fun g => rfl, ?_⟩
  exact hcoord

end Representation.BinaryTwoPlaneRecognition
