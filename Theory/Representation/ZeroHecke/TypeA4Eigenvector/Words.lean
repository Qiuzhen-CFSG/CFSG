/-!
# A finite word model for type-A₄ zero-Hecke operators

The 120 words below are reduced expressions for the permutations of five
letters, enumerated by breadth-first search starting at the identity. For each
word and each left generator, a certificate records positions at which to
apply idempotence, distant commutation, or the adjacent braid relation. The
rewriting algorithm is proved sound in every monoid satisfying these relations.
Lean's kernel checks all 480 certificates, together with the assertion that
left multiplication either fixes the word index or strictly increases length.

This is a direct finite calculation from the type-A₄ Coxeter presentation,
with idempotence replacing the involution relations. No classification of
simple zero-Hecke modules, permutation normal-form theorem, or external
certificate checker is assumed. The eigenvector argument only needs this
finite model and its length property; it does not need uniqueness of words.
-/

namespace ZeroHecke

/-- The idempotent Coxeter relations for the four simple roots of type A₄.
The ordered hypotheses state each commutation and braid relation once. -/
public structure TypeA4Relations {M : Type*} [Monoid M] (T : Fin 4 → M) : Prop where
  idem : ∀ i, T i * T i = T i
  comm : ∀ i j, i.val + 1 < j.val → T i * T j = T j * T i
  braid : ∀ i j, i.val + 1 = j.val → T i * T j * T i = T j * T i * T j

private def eval {M : Type*} [Monoid M] (T : Fin 4 → M) (w : List (Fin 4)) : M :=
  (w.map T).prod

private def rewriteHead : List (Fin 4) → List (Fin 4)
  | a :: b :: tail =>
    if a = b then b :: tail
    else if a.val + 1 < b.val ∨ b.val + 1 < a.val then b :: a :: tail
    else match tail with
      | c :: rest => if a = c then b :: a :: b :: rest else a :: b :: c :: rest
      | [] => [a, b]
  | w => w

private def rewriteAt : ℕ → List (Fin 4) → List (Fin 4)
  | 0, w => rewriteHead w
  | n + 1, a :: tail => a :: rewriteAt n tail
  | _ + 1, [] => []

private def run (w : List (Fin 4)) (moves : List ℕ) : List (Fin 4) :=
  moves.foldl (fun w k => rewriteAt k w) w

private theorem eval_rewriteHead {M : Type*} [Monoid M] (T : Fin 4 → M)
    (h : TypeA4Relations T) (w : List (Fin 4)) : eval T (rewriteHead w) = eval T w := by
  cases w with
  | nil => rfl
  | cons a w =>
    cases w with
    | nil => rfl
    | cons b tail =>
      simp only [rewriteHead]
      split
      next hab =>
        subst b
        simp only [eval, List.map_cons, List.prod_cons, ← mul_assoc, h.idem]
      next hab =>
        split
        next hsep =>
          have hc : T b * T a = T a * T b := by
            rcases hsep with hsep | hsep
            · exact (h.comm a b hsep).symm
            · exact h.comm b a hsep
          simp only [eval, List.map_cons, List.prod_cons, ← mul_assoc, hc]
        next hsep =>
          cases tail with
          | nil => rfl
          | cons c rest =>
            simp only
            split
            next hac =>
              subst c
              have hb : T b * T a * T b = T a * T b * T a := by
                have hne : a.val ≠ b.val := fun hh => hab (Fin.ext hh)
                have hadj : a.val + 1 = b.val ∨ b.val + 1 = a.val := by omega
                rcases hadj with hadj | hadj
                · exact (h.braid a b hadj).symm
                · exact h.braid b a hadj
              simp only [eval, List.map_cons, List.prod_cons, ← mul_assoc, hb]
            next => rfl

private theorem eval_rewriteAt {M : Type*} [Monoid M] (T : Fin 4 → M)
    (h : TypeA4Relations T) (k : ℕ) (w : List (Fin 4)) :
    eval T (rewriteAt k w) = eval T w := by
  induction k generalizing w with
  | zero => exact eval_rewriteHead T h w
  | succ k ih =>
    cases w with
    | nil => rfl
    | cons a w =>
      simpa only [rewriteAt, eval, List.map_cons, List.prod_cons] using
        congrArg (T a * ·) (ih w)

private theorem eval_run {M : Type*} [Monoid M] (T : Fin 4 → M)
    (h : TypeA4Relations T) (w : List (Fin 4)) (moves : List ℕ) :
    eval T (run w moves) = eval T w := by
  induction moves generalizing w with
  | nil => rfl
  | cons k ks ih =>
    exact (ih (rewriteAt k w)).trans (eval_rewriteAt T h k w)


