private theorem certificates_valid : ∀ (i : Fin 4) (m : Fin 120),
    run (i :: words m) (certificates i m) = words (steps i m) ∧
      (steps i m = m ∨ (words m).length < (words (steps i m)).length) := by
  decide +kernel

/-- A finite family containing the identity and closed under left multiplication
by the four generators; every nonstationary multiplication increases height. -/
public theorem typeA4_finite_word_model {M : Type*} [Monoid M]
    (T : Fin 4 → M) (h : TypeA4Relations T) :
    ∃ (word : Fin 120 → M) (step : Fin 4 → Fin 120 → Fin 120) (height : Fin 120 → ℕ),
      word 0 = 1 ∧ (∀ i m, T i * word m = word (step i m)) ∧
      (∀ i m, step i m = m ∨ height m < height (step i m)) := by
  refine ⟨fun m => eval T (words m), steps, fun m => (words m).length, rfl, ?_, ?_⟩
  · intro i m
    have hc := congrArg (eval T) (certificates_valid i m).1
    rw [eval_run T h] at hc
    exact hc
  · intro i m
    exact (certificates_valid i m).2

end ZeroHecke
