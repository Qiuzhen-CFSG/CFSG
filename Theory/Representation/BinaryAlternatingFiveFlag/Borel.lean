module
public import Theory.Representation.BinaryAlternatingFiveFlag.Coordinates

/-!
# The full point stabilizer on the standard three-space

The point stabilizer A₄ is generated by elements of order three. Its action
on the three-space has fixed line generated by the all-one four-vector;
the quotient is irreducible. Three explicit commutator differences span the
three-space. These statements retain the actual five-point action for transport
into the original Chapter 13 subgroups.
-/
@[expose] public section
namespace BinaryPermutation.AlternatingFiveFlag
open Subgroup FiveCentralizerGeometry
open AlternatingFiveBorel

local instance : DecidablePred (· ∈ B) := fun g => inferInstanceAs (Decidable (g.val 4=4))
local instance : Fintype B := Subtype.fintype _

def line : Subgroup (Multiplicative Space) where
  carrier := {x | x = 1 ∨ x = Multiplicative.ofAdd z}
  one_mem' := Or.inl rfl
  mul_mem' := by
    rintro x y (rfl | rfl) (rfl | rfl)
    · exact Or.inl rfl
    · exact Or.inr (one_mul _)
    · exact Or.inr (mul_one _)
    · left; decide +kernel
  inv_mem' := by
    rintro x (rfl | rfl)
    · exact Or.inl (inv_one)
    · right; change Multiplicative.ofAdd (-z) = Multiplicative.ofAdd z
      decide +kernel
instance : DecidablePred (· ∈ line) := fun _ => inferInstanceAs (Decidable (_ ∨ _))
instance : Fintype line := Subtype.fintype _

theorem line_eq_zpowers : line = zpowers (Multiplicative.ofAdd z) := by
  apply le_antisymm
  · rintro x (rfl | rfl)
    · exact one_mem _
    · exact mem_zpowers _
  · exact zpowers_le.mpr (Or.inr rfl)

theorem line_card : Nat.card line = 2 := by rw [Nat.card_eq_fintype_card]; decide +kernel

theorem line_le_three : line ≤ three := by
  rintro x (rfl | rfl) <;> rfl

theorem three_invariant (g : B) (x : Multiplicative Space) (hx : x ∈ three) :
    Multiplicative.ofAdd (rho g.val.val x.toAdd) ∈ three := by
  change x.toAdd.val (g.val.val.symm 4) = 0
  rwa [g.val.val.symm_apply_eq.mpr g.property.symm]

private theorem borel_product_cubics : ∀ g : B,
    ∃ h k : B, h^3=1 ∧ k^3=1 ∧ h*k=g := by decide +kernel

theorem borel_twoResidual : pResidual 2 B = ⊤ := by
  apply eq_top_iff.mpr
  intro g _
  obtain ⟨h,k,hh,hk,rfl⟩ := borel_product_cubics g
  have hm (a : B) (ha : a^3=1) : a ∈ pResidual 2 B :=
    mem_pResidual_of_orderOf_coprime ((by decide : Nat.Coprime 2 3).of_dvd_right
      (orderOf_dvd_of_pow_eq_one ha))
  exact (pResidual 2 B).mul_mem (hm h hh) (hm k hk)

private theorem orbit_mod_line : ∀ x y : Space,
    x.val 4=0 → x≠0 → x≠z → y.val 4=0 →
    y=0 ∨ y=z ∨ ∃ g : B, y=rho g.val.val x ∨ y=rho g.val.val x+z := by decide +kernel

/-- Irreducibility on the literal subgroup interval above the fixed line. -/
theorem three_line_irreducible (U : Subgroup (Multiplicative Space))
    (hline : line ≤ U) (hthree : U ≤ three)
    (hi : ∀ g : B, ∀ x ∈ U, Multiplicative.ofAdd (rho g.val.val x.toAdd) ∈ U) :
    U=line ∨ U=three := by
  by_cases hle : U ≤ line
  · exact Or.inl (le_antisymm hle hline)
  · right
    obtain ⟨x,hx,hxn⟩ := SetLike.not_le_iff_exists.mp hle
    have hx0 : x.toAdd≠0 := fun h => hxn (Or.inl h)
    have hxz : x.toAdd≠z := fun h => hxn (Or.inr h)
    apply le_antisymm hthree
    intro y hy
    change Multiplicative.ofAdd y.toAdd ∈ U
    rcases orbit_mod_line x.toAdd y.toAdd (hthree hx) hx0 hxz hy with h | h | ⟨g,h|h⟩
    · rw [h]; exact U.one_mem
    · rw [h]; exact hline (Or.inr rfl)
    · rw [h]; exact hi g x hx
    · rw [h,ofAdd_add]
      exact U.mul_mem (hi g x hx) (hline (Or.inr rfl))

def c₀ : B := ⟨⟨Equiv.swap 0 1 * Equiv.swap 1 2, by rw [Equiv.Perm.mem_alternatingGroup]; decide +kernel⟩, by decide +kernel⟩
def c₁ : B := ⟨⟨Equiv.swap 0 2 * Equiv.swap 2 3, by rw [Equiv.Perm.mem_alternatingGroup]; decide +kernel⟩, by decide +kernel⟩
def c₂ : B := ⟨⟨Equiv.swap 0 3 * Equiv.swap 1 3, by rw [Equiv.Perm.mem_alternatingGroup]; decide +kernel⟩, by decide +kernel⟩
def u : Space := ⟨![1,0,0,0,1], by decide +kernel⟩

private theorem difference_span : ∀ y : Space, y.val 4=0 →
    ∃ a b c : Bool,
      y = (if a then rho c₀.val.val u-u else 0) +
          (if b then rho c₁.val.val u-u else 0) +
          (if c then rho c₂.val.val u-u else 0) := by decide +kernel

/-- Every vector of the three-space is generated by actual Borel differences. -/
theorem three_le_of_differences (U : Subgroup (Multiplicative Space))
    (hd : ∀ g : B, ∀ x : Space, Multiplicative.ofAdd (rho g.val.val x-x) ∈ U) :
    three ≤ U := by
  intro y hy
  obtain ⟨a,b,c,he⟩ := difference_span y.toAdd hy
  have hif (t : Bool) (v : Space) (hv : Multiplicative.ofAdd v ∈ U) :
      Multiplicative.ofAdd (if t then v else 0) ∈ U := by
    cases t
    · exact U.one_mem
    · exact hv
  change Multiplicative.ofAdd y.toAdd ∈ U
  rw [he,ofAdd_add,ofAdd_add]
  exact U.mul_mem (U.mul_mem (hif a _ (hd c₀ u)) (hif b _ (hd c₁ u))) (hif c _ (hd c₂ u))

theorem difference_mem_three (g : B) (x : Space) :
    Multiplicative.ofAdd (rho g.val.val x-x) ∈ three := by
  change x.val (g.val.val.symm 4)-x.val 4=0
  rw [g.val.val.symm_apply_eq.mpr g.property.symm,sub_self]

end BinaryPermutation.AlternatingFiveFlag
