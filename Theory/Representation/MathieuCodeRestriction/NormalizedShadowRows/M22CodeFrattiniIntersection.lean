module
public import Theory.Representation.MathieuCodeRestriction.NormalizedShadowRows.M22CodeFrattiniGeometry
public import Theory.Representation.MathieuCodeRestriction.NormalizedShadowRows.M22CodeFiveSemisimple

/-!
# The normal closure excludes the fifth M22 quintet dimension

The intersection of the seed-generated group E with the original quintet
contains its moved four-space, so it is that four-space or the whole quintet.
The latter would map the whole nonsplit quintet into the semisimple Frattini
module while preserving its moved seed, contradicting the native quintet lemma.
The resulting equality is an equality of the literal subgroups.

Source: Aschbacher--Smith 8.2.9, printed p.721, refs/quasithin.pdf.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender
open scoped IsMulCommutative commutatorElement MonoidAlgebra
namespace MathieuCode.NormalizedShadowRows.M22CodeSection
set_option backward.isDefEq.respectTransparency false

private theorem marked_map_to_semisimple_kills_moved
    {R X V : Type*} [Group R] [AddCommGroup X] [Module (ZMod 2) X]
    [AddCommGroup V] [Module (ZMod 2) V]
    (σ : Representation (ZMod 2) R X)
    (r : R →* alternatingGroup (Fin 5)) (hr : Function.Surjective r)
    (e : X ≃ₗ[ZMod 2] Additive MathieuCode.M22Quintet.K)
    (he : ∀ x v, e (σ x v) =
      MathieuCode.NormalizedShadowRows.M22CodeSection.fiveAction (r x) (e v))
    (τ : Representation (ZMod 2) R V)
    [IsSemisimpleModule (ZMod 2)[R] τ.asModule]
    (F : Representation.IntertwiningMap σ τ) :
    Coinvariants.ker σ ≤ F.toLinearMap.ker := by
  let p : Representation.IntertwiningMap
      (MathieuCode.NormalizedShadowRows.M22CodeSection.fiveAction.comp r) τ := {
    toLinearMap := F.toLinearMap.comp e.symm.toLinearMap
    isIntertwining' x := by
      apply LinearMap.ext
      intro v
      change F (e.symm (MathieuCode.NormalizedShadowRows.M22CodeSection.fiveAction (r x) v)) =
        τ x (F (e.symm v))
      have hh : e.symm (MathieuCode.NormalizedShadowRows.M22CodeSection.fiveAction (r x) v) =
          σ x (e.symm v) := by
        apply e.injective
        rw [e.apply_symm_apply,he,e.apply_symm_apply]
      rw [hh]
      exact LinearMap.congr_fun (F.isIntertwining' x) (e.symm v) }
  obtain ⟨eS,heS⟩ :=
    MathieuCode.NormalizedShadowRows.M22CodeSection.moved_equiv_of_marking σ r hr e he
  have hp := MathieuCode.NormalizedShadowRows.M22CodeSection.five_map_to_semisimple_kills_moved
    r hr τ p
  intro v hv
  have hh := hp (eS ⟨v,hv⟩).property
  change F (e.symm (eS ⟨v,hv⟩).val) = 0 at hh
  rw [heS,e.symm_apply_apply] at hh
  exact hh

/-- A normal closure generated by the moved four-space meets the original
quintet precisely in that four-space. -/
theorem normalClosure_intersection
    {A R X : Type*} [Group A] [Finite A] [Group R] [Group X]
    [IsElementaryAbelian 2 X]
    (σ : Representation (ZMod 2) R (Additive X))
    [FiniteDimensional (ZMod 2) (Additive X)]
    (hd5 : Module.finrank (ZMod 2) (Additive X) = 5)
    (hd4 : Module.finrank (ZMod 2) (Coinvariants.ker σ) = 4)
    (r : R →* alternatingGroup (Fin 5)) (hrs : Function.Surjective r)
    (e : Additive X ≃ₗ[ZMod 2] Additive MathieuCode.M22Quintet.K)
    (he : ∀ x v, e (σ x v) =
      MathieuCode.NormalizedShadowRows.M22CodeSection.fiveAction (r x) (e v))
    (j : X →* A) (a : R →* A)
    (hjσ : ∀ r x, j ((σ r (Additive.ofMul x)).toMul) = a r * j x * (a r)⁻¹)
    (W : Subgroup A)
    (hW : (Coinvariants.ker σ).toAddSubgroup.toSubgroup'.map j = W)
    (hE : IsPGroup 2 (normalClosure (W : Set A)))
    (hphi : ¬ W ≤ (frattini (normalClosure (W : Set A))).map
      (normalClosure (W : Set A)).subtype)
    (hg : M22MovedFrattiniGeometry σ j a W hE) :
    normalClosure (W : Set A) ⊓ j.range = W := by
  let E := normalClosure (W : Set A)
  let : Fact (IsPGroup 2 E) := ⟨hE⟩
  let : IsElementaryAbelian 2 (E ⧸ frattini E) := isElementaryAbelian_quotient_frattini
  let q := QuotientGroup.mk' (frattini E)
  let ρ := elementaryRepresentation (p := 2)
    ((quotientAut (frattini E)).comp (MulAut.conjNormal : A →* MulAut E))
  obtain ⟨c,hci,hcd,hcn,hc,hcq,hcr,hsemi⟩ := hg
  let : IsSemisimpleModule (ZMod 2)[R] (Representation.asModule (ρ.comp a)) := hsemi
  let T := AddSubgroup.toZModSubmodule 2 (E.comap j).toAddSubgroup
  have hMT : Coinvariants.ker σ ≤ T := by
    intro v hv
    apply le_normalClosure
    exact hW.le ⟨v.toMul,hv,rfl⟩
  have hT : T = Coinvariants.ker σ := by
    by_contra hne
    have hlt : Coinvariants.ker σ < T := lt_of_le_of_ne hMT (Ne.symm hne)
    have hdlt := Submodule.finrank_lt_finrank_of_lt hlt
    have hdle := T.finrank_le
    have htop : T = ⊤ := Submodule.eq_top_of_finrank_eq (by omega)
    have hje (x : X) : j x ∈ E := by
      have hh : Additive.ofMul x ∈ T := htop.symm ▸ Submodule.mem_top
      exact hh
    let jE : X →* E := j.codRestrict E hje
    let F : Representation.IntertwiningMap σ (ρ.comp a) := {
      toLinearMap := (q.comp jE).toAdditive.toZModLinearMap 2
      isIntertwining' r' := by
        apply LinearMap.ext
        intro x
        change q (jE (σ r' x).toMul) =
          (quotientAut (frattini E)) (MulAut.conjNormal (a r')) (q (jE x.toMul))
        rw [quotientAut_apply_mk]
        congr 1
        apply Subtype.ext
        exact hjσ r' x.toMul }
    have hkill := marked_map_to_semisimple_kills_moved σ r hrs e he (ρ.comp a) F
    apply hphi
    intro w hw
    have hw' := hW.ge hw
    obtain ⟨x,hx,rfl⟩ := hw'
    have hz : q (jE x) = 1 := congrArg Additive.toMul (hkill hx)
    exact ⟨jE x,(QuotientGroup.eq_one_iff (jE x)).mp hz,rfl⟩
  apply le_antisymm
  · rintro x ⟨hx,y,rfl⟩
    have hy : Additive.ofMul y ∈ T := hx
    rw [hT] at hy
    exact hW.le ⟨y,hy,rfl⟩
  · intro w hw
    refine ⟨le_normalClosure hw,?_⟩
    obtain ⟨x,hx,rfl⟩ := hW.ge hw
    exact ⟨x,rfl⟩

end MathieuCode.NormalizedShadowRows.M22CodeSection
