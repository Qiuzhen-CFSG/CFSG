def vector (k : Fin 8) (j : Fin 9) : Fin 11 → ZMod 2 := fun i => bit (word k j) i.val
def columns (k : Fin 8) : Matrix (Fin 11) (Fin 9) (ZMod 2) := fun i j => vector k j i
def leftInverse (k : Fin 8) : Matrix (Fin 9) (Fin 11) (ZMod 2) := fun j i => bit (leftWord k j) i.val

theorem case_card : ∀ k, (caseSet k).card = 16 := by decide +kernel
theorem bad_card : ∀ a, a ∉ quintet → (badSet a).card < 16 := by decide +kernel

def coverageRow (a : Fin 72) : Prop := ∀ b : Fin 72,
  a ∉ quintet → adjacent a b = true → b ∉ badSet a →
  ∀ c : Fin 72, adjacent a c = true → adjacent b c = true → c ∈ caseSet (caseChoice a b)

theorem coverage : ∀ a, coverageRow a := by
  unfold coverageRow
  decide +kernel

theorem actor_mem : ∀ k j, actor k j ∈ caseSet k ∧ actor k j ≠ 0 := by decide +kernel
theorem vector_zero : ∀ k j, vector k j 0 = 0 := by decide +kernel
theorem fixed_vector : ∀ k j, ∀ i : Fin 11,
    (outerMatrix (actor k j) *ᵥ vector k j) i =
      (outerMatrix (actor k j) *ᵥ vector k j) 0 * pairCoordinate i := by decide +kernel
theorem independent_vectors : ∀ k, leftInverse k * columns k = 1 := by decide +kernel
