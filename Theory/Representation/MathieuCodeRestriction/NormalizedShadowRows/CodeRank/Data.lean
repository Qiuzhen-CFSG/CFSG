def certificateTable (c : Fin 2) : Table Nat 12 :=
  if c = 0 then
    ((certificateChunk0_0,certificateChunk0_2),(certificateChunk0_1,certificateChunk0_3))
  else
    ((certificateChunk1_0,certificateChunk1_2),(certificateChunk1_1,certificateChunk1_3))

def degree (c : Fin 2) : Nat := 6 + c.val
def colorBound (c : Fin 2) : Nat := if c = 0 then 6 else 17
def color (c : Fin 2) (v : Fin 192) : Fin (colorBound c) :=
  ⟨lookup 8 (colorTable c) v.val % colorBound c,
    Nat.mod_lt _ (by unfold colorBound; split <;> decide)⟩
def certificate (c : Fin 2) (v w : Fin 192) : Nat :=
  lookup 12 (certificateTable c) ((lookup 8 (pairTable c) v.val >>> (12*w.val)) % 4096)
def columnIndex (c : Fin 2) (v w : Fin 192) (j : Fin (degree c)) : Nat :=
  (certificate c v w >>> (5*j.val)) % 32

def selected (c : Fin 2) (v w : Fin 192) : Matrix (Fin 11) (Fin (degree c)) (ZMod 2) :=
  fun i j => if columnIndex c v w j < 11 then
    matrix v i ⟨columnIndex c v w j % 11, Nat.mod_lt _ (by decide)⟩
  else matrix w i ⟨columnIndex c v w j % 11, Nat.mod_lt _ (by decide)⟩
def leftInverse (c : Fin 2) (v w : Fin 192) : Matrix (Fin (degree c)) (Fin 11) (ZMod 2) :=
  fun i j => bit (certificate c v w) (5*degree c + 11*i.val+j.val)
def checkRow (c : Fin 2) (v : Fin 192) : Prop := ∀ w : Fin 192,
  v < w → color c v = color c w → compatible v w = true →
    leftInverse c v w * selected c v w = 1
end MathieuCode.NormalizedShadowRows.CodeRank
