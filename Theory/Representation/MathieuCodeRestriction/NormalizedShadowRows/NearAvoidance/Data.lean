def certificate (v w : Fin 72) : Nat :=
  lookup 10 certificateTable ((lookup 7 pairTable v.val >>> (10*w.val)) % 1024)
def point (v w : Fin 72) : Fin 24 :=
  ⟨((certificate v w % 32) % 24),Nat.mod_lt _ (by decide)⟩
def dimension (v w : Fin 72) : Nat := if point v w = 0 then 6 else 5
def col (v w : Fin 72) (j : Fin (dimension v w)) : Fin 11 :=
  ⟨((certificate v w >>> (5+4*j.val)) % 16) % 11,Nat.mod_lt _ (by decide)⟩
def row (v w : Fin 72) (i : Fin (dimension v w)) : Fin 22 :=
  ⟨((certificate v w >>> (29+5*i.val)) % 32) % 22,Nat.mod_lt _ (by decide)⟩
def minor (v w : Fin 72) : Matrix (Fin (dimension v w)) (Fin (dimension v w)) (ZMod 2) :=
  (StrictM22Cocode.pairMatrix v w).submatrix (row v w) (col v w)
def leftInverse (v w : Fin 72) : Matrix (Fin (dimension v w)) (Fin (dimension v w)) (ZMod 2) :=
  fun i j => bit (certificate v w) (59+6*i.val+j.val)
def checkRow (v : Fin 72) : Prop := ∀ w : Fin 72,
  v ≠ 0 → v < w → OuterSpan.adjacent v w = true →
    leftInverse v w * minor v w = 1 ∧
      (point v w ≠ 0 → point v w ≠ 9 ∧
        outerPoint v (point v w) = point v w ∧ outerPoint w (point v w) = point v w)

