def quotientMatrix (v : Fin 72) : Matrix (Fin 11) (Fin 11) (ZMod 2) :=
  fun i j => outerMatrix v i j - outerMatrix v 0 j * pairCoordinate i
def selected (v w : Fin 72) : Matrix (Fin 11) (Fin 6) (ZMod 2) :=
  fun i j => quotientMatrix (if columnIndex v w j < 11 then 27 else
    if columnIndex v w j < 22 then v else w) i
    ⟨columnIndex v w j % 11, Nat.mod_lt _ (by decide)⟩
def leftInverse (v w : Fin 72) : Matrix (Fin 6) (Fin 11) (ZMod 2) :=
  fun i j => bit (certificate v w) (36 + 11*i.val+j.val)
def checkRow (v : Fin 72) : Prop := ∀ w : Fin 72,
  v < w → color v = color w → OuterSpan.adjacent v w = true →
    leftInverse v w * selected v w = 1
end MathieuCode.NormalizedShadowRows.CodeNear
