private def perm (k : Fin 30) : Equiv.Perm (Fin 24) where
  toFun := images k
  invFun := inverses k
  left_inv := by revert k; decide +kernel
  right_inv := by revert k; decide +kernel

private theorem rows (k : Fin 30) (i : Fin 12) :
    m24PermuteMask (perm k) (m24GolayRow i) = m24GolayCode (rowMessages k i) := by
  revert k i
  decide +kernel

noncomputable def transport (k : Fin 30) : M24 :=
  ⟨perm k, mem_M24_of_rows _ (fun i => ⟨rowMessages k i, rows k i⟩)⟩

theorem transport_fixes (k : Fin 30) :
    transport k • standardTrioOctad 0 = standardTrioOctad 0 := by
  change perm k • standardTrioOctad 0 = _
  revert k
  decide +kernel

private theorem coverage : ∀ b : Fin 759,
    Disjoint (standardTrioOctad 0) (m24BlockAt b) →
      ∃ k : Fin 30, perm k • standardTrioOctad 1 = m24BlockAt b := by
  decide +kernel

theorem exists_transport {B : Finset (Fin 24)} (hB : B ∈ m24Blocks)
    (hd : Disjoint (standardTrioOctad 0) B) :
    ∃ g : M24, g • standardTrioOctad 0 = standardTrioOctad 0 ∧
      g • standardTrioOctad 1 = B := by
  obtain ⟨b, _, rfl⟩ := Finset.mem_image.mp hB
  obtain ⟨k, hk⟩ := coverage b hd
  exact ⟨transport k, transport_fixes k, hk⟩

