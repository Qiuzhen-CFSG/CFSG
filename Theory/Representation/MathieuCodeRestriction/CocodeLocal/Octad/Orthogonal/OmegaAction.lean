module

public import Theory.Representation.MathieuCodeRestriction.CocodeLocal.Octad.Orthogonal.OmegaImage

/-!
# The native octad quotient and the natural Omega action

The split action has intrinsic two-core kernel and precisely the subgroup
of the full split isometry group generated by Siegel transformations. The
first isomorphism theorem therefore identifies the actual octad quotient
with Ω⁺₆(2). The split-space isometry intertwines this quotient action with
the action on the supported cocode space; its image there is the transported
Omega subgroup. All identifications retain equations on quotient representatives.

Source: Aschbacher--Smith, H.15.2(2), printed pp.398--399.
-/

@[expose] public section

noncomputable section
open Sporadic.Mathieu Sporadic.Mathieu.M24LocalGeometry
namespace MathieuCode.CocodeOctad

/-- The intrinsic two-core quotient is the actual Siegel-generated Ω⁺₆(2). -/
def quotientOmegaEquiv (O : Octad) :
    (octadStabilizer O ⧸ pCore 2 (octadStabilizer O)) ≃*
      ClassicalOrthogonal.elementarySubgroup (ClassicalOrthogonal.formD 3 (ZMod 2)) :=
  (quotientEquivSplitImage O).trans
    (MulEquiv.subgroupCongr (splitAction_range_eq_elementary O))

/-- The quotient equivalence retains the existing split action. -/
lemma quotientOmegaEquiv_val (O : Octad)
    (q : octadStabilizer O ⧸ pCore 2 (octadStabilizer O)) :
    (quotientOmegaEquiv O q).val = quotientSplitAction O q := rfl

/-- On representatives, the equivalence is the literal native split action. -/
lemma quotientOmegaEquiv_mk (O : Octad) (g : octadStabilizer O) :
    (quotientOmegaEquiv O (QuotientGroup.mk g)).val = splitAction O g := rfl

/-- The split isometry identifies the natural Omega module with the native quotient module. -/
lemma quotientOmegaEquiv_equivariant (O : Octad)
    (q : octadStabilizer O ⧸ pCore 2 (octadStabilizer O))
    (x : ClassicalOrthogonal.VectorD 3 (ZMod 2)) :
    formEquiv O ((quotientOmegaEquiv O q).val.val x) =
      (quotientIsometryAction O q).val (formEquiv O x) := by
  induction q using QuotientGroup.induction_on with
  | H g => rw [quotientOmegaEquiv_mk, quotientIsometryAction_mk, formEquiv_equivariant]

/-- The quotient has the full Omega image in the standard split isometry group. -/
lemma quotientSplitAction_range_eq_elementary (O : Octad) :
    (quotientSplitAction O).range =
      ClassicalOrthogonal.elementarySubgroup (ClassicalOrthogonal.formD 3 (ZMod 2)) := by
  ext g
  constructor
  · rintro ⟨q, rfl⟩
    exact (quotientOmegaEquiv O q).property
  · intro hg
    obtain ⟨q, hq⟩ := (quotientOmegaEquiv O).surjective ⟨g, hg⟩
    exact ⟨q, congrArg Subtype.val hq⟩

/-- The image on the literal supported space is the isometric transport of Omega. -/
lemma quotientIsometryAction_range (O : Octad) :
    (quotientIsometryAction O).range =
      (ClassicalOrthogonal.elementarySubgroup (ClassicalOrthogonal.formD 3 (ZMod 2))).map
        (Atlas.Order20160A8.isometryGroupTransport (formEquiv O)).toMonoidHom := by
  rw [quotientIsometryAction, MonoidHom.range_comp, quotientSplitAction_range_eq_elementary]

/-- The kernel of the literal linear action is exactly the intrinsic two-core. -/
lemma pairRepresentation_ker (O : Octad) :
    (pairRepresentation O).ker = pCore 2 (octadStabilizer O) := by
  ext g
  rw [MonoidHom.mem_ker]
  constructor
  · intro hg
    have hi : quotientIsometryAction O (QuotientGroup.mk g) = 1 := by
      apply Subtype.ext
      apply LinearEquiv.ext
      intro v
      rw [quotientIsometryAction_mk, hg]
      rfl
    have hm : (QuotientGroup.mk g : octadStabilizer O ⧸ pCore 2 _) = 1 :=
      (quotientIsometryAction_injective O) (hi.trans (map_one _).symm)
    exact (QuotientGroup.eq_one_iff g).mp hm
  · intro hg
    apply LinearMap.ext
    intro v
    rw [← quotientIsometryAction_mk O, (QuotientGroup.eq_one_iff g).mpr hg, map_one]
    rfl

end MathieuCode.CocodeOctad
