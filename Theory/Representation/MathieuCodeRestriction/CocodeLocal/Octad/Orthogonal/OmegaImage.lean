module

public import Theory.Representation.MathieuCodeRestriction.CocodeLocal.Octad.Orthogonal.Action
public import Theory.Representation.MathieuCodeRestriction.CocodeLocal.Octad.Orthogonal.OmegaImage.DeletedEightComparison

/-!
# The native octad action has the actual Omega image

The native octad action has the alternating deleted-eight image by `Action`.
The binary comparison identifies that image, inside the full split isometry
group, with the subgroup generated by Siegel transformations. Thus the native
stabilizer acts as the actual Ω⁺₆(2) on its supported quadratic six-space.

Source: Aschbacher--Smith, H.15.2(2), printed pp.398--399.
-/

namespace MathieuCode.CocodeOctad

/-- The native octad action has precisely the Siegel-generated split Omega image. -/
public theorem splitAction_range_eq_elementary (O : Sporadic.Mathieu.M24LocalGeometry.Octad) :
    (splitAction O).range =
      ClassicalOrthogonal.elementarySubgroup (ClassicalOrthogonal.formD 3 (ZMod 2)) := by
  rw [splitAction_range, Atlas.Order20160A8.DeletedEight.alternatingImage_eq_elementary]

end MathieuCode.CocodeOctad
