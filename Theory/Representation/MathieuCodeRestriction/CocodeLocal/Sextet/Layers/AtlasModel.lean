module

public import Theory.Representation.BinaryPermutation
public import Theory.AtlasPort.OtherSporadic.Mathieu.SextetRecovery

/-!
# Shared concrete coordinates for the sextet cocode layers

These are the literal even core and Golay quotient on the ATLAS 24-point
coordinate set. The encoder's common column parity proves that all Golay
words lie in the even core. The affine sextet stabilizer acts through its
existing coordinate permutations; code preservation induces its quotient
representation.

The pair space is the image of words even in every column, and the tetrad
line is generated by the class of one whole column. That line lies in the
pair space. These definitions are shared by coordinate transport and by the
hexacode duality calculation; no dimension, irreducibility, or native-model
identification is built into them.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, H.15.3(1),
printed p.400; the licensed ATLAS Golay and affine hexacode constructions.
-/

@[expose] public section

open scoped BigOperators
namespace MathieuCode.SextetLayers
noncomputable section

abbrev AtlasCore := BinaryPermutation.core Atlas.Codes.Omega

/-- The full ATLAS Golay code lies in the even core, so the pullback is literal Golay. -/
lemma atlasGolay_le_core : Atlas.Codes.golay ≤ AtlasCore := by
  rintro v ⟨⟨h,r,e⟩,rfl⟩
  change (∑ p : Atlas.Codes.Omega, Atlas.Codes.golayEncoder (h,r,e) p) = 0
  rw [Fintype.sum_prod_type]
  change (∑ i, Atlas.Codes.blockParity (Atlas.Codes.golayEncoder (h,r,e)) i) = 0
  simp only [Atlas.Codes.golayEncoder_blockParity, Finset.sum_const, Finset.card_univ]
  change 6 • e = 0
  fin_cases e <;> decide +kernel

def atlasCodeInCore : Submodule (ZMod 2) AtlasCore :=
  Atlas.Codes.golay.comap AtlasCore.subtype

abbrev AtlasCocode := AtlasCore ⧸ atlasCodeInCore

def atlasColumnParity : Atlas.Codes.BinaryWord →ₗ[ZMod 2]
    (Atlas.Codes.HexIndex → ZMod 2) where
  toFun v i := ∑ k, v (i,k)
  map_add' v w := by ext i; exact Finset.sum_add_distrib
  map_smul' c v := by ext i; exact (Finset.mul_sum _ _ _).symm

def atlasPairSpace : Submodule (ZMod 2) AtlasCocode :=
  (atlasColumnParity.ker.comap AtlasCore.subtype).map atlasCodeInCore.mkQ

def atlasTetradCore (i : Atlas.Codes.HexIndex) : AtlasCore :=
  ⟨fun p => if p.1 = i then 1 else 0, by
    change (∑ p : Atlas.Codes.Omega, if p.1 = i then (1 : ZMod 2) else 0) = 0
    revert i
    decide +kernel⟩

def atlasTetradLine : Submodule (ZMod 2) AtlasCocode :=
  Submodule.span (ZMod 2) {atlasCodeInCore.mkQ (atlasTetradCore (0,0))}

def atlasLineInPair : Submodule (ZMod 2) atlasPairSpace :=
  atlasTetradLine.comap atlasPairSpace.subtype

lemma atlasTetradLine_le_pairSpace : atlasTetradLine ≤ atlasPairSpace := by
  apply Submodule.span_le.mpr
  rw [Set.singleton_subset_iff]
  refine ⟨atlasTetradCore (0,0), ?_, rfl⟩
  change atlasColumnParity (atlasTetradCore (0,0)).val = 0
  ext i
  change (∑ k : Fin 4, if i = (0,0) then (1 : ZMod 2) else 0) = 0
  by_cases hi : i = (0,0) <;> simp [hi]

def atlasFullRepresentation : Representation (ZMod 2) Atlas.Codes.SextetStabilizer
    Atlas.Codes.BinaryWord where
  toFun g := (Atlas.Codes.coordinatePermutation g.val.val).toLinearMap
  map_one' := rfl
  map_mul' _ _ := rfl

lemma atlasCore_invariant (g : Atlas.Codes.SextetStabilizer)
    {v : Atlas.Codes.BinaryWord} (hv : v ∈ AtlasCore) :
    atlasFullRepresentation g v ∈ AtlasCore := by
  change (∑ p, v (g.val.val.symm p)) = 0
  rw [Equiv.sum_comp]
  exact hv

def atlasCoreRepresentation : Representation (ZMod 2) Atlas.Codes.SextetStabilizer AtlasCore where
  toFun g := (atlasFullRepresentation g).restrict (fun _ hv => atlasCore_invariant g hv)
  map_one' := by ext v; rfl
  map_mul' _ _ := by ext v; rfl

def atlasCocodeRepresentation : Representation (ZMod 2) Atlas.Codes.SextetStabilizer AtlasCocode where
  toFun g := atlasCodeInCore.mapQ atlasCodeInCore (atlasCoreRepresentation g)
    (fun v hv => (g.val.property v.val).mp hv)
  map_one' := by
    apply LinearMap.ext
    intro v
    induction v using Submodule.Quotient.induction_on with
    | _ v => rfl
  map_mul' _ _ := by
    apply LinearMap.ext
    intro v
    induction v using Submodule.Quotient.induction_on with
    | _ v => rfl

lemma atlasCocodeRepresentation_mk (g : Atlas.Codes.SextetStabilizer) (v : AtlasCore) :
    atlasCocodeRepresentation g (atlasCodeInCore.mkQ v) =
      atlasCodeInCore.mkQ (atlasCoreRepresentation g v) := rfl

end
end MathieuCode.SextetLayers
