/-- Bitwise intersection is intersection of the two message predicates. -/
theorem bitand_true (x y : BitVec 4096) (u : Fin 4096) :
    (x &&& y).getLsb u = true ↔ x.getLsb u = true ∧ y.getLsb u = true := by
  simp

