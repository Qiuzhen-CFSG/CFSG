def select16 (b : Bool) (x : BitVec 16) : BitVec 16 := if b then x else 0

def encode16 (r : Fin 12 → BitVec 16) (u : Fin 4096) : BitVec 16 :=
  select16 (u.val.testBit 0) (r 0) ^^^
  select16 (u.val.testBit 1) (r 1) ^^^
  select16 (u.val.testBit 2) (r 2) ^^^
  select16 (u.val.testBit 3) (r 3) ^^^
  select16 (u.val.testBit 4) (r 4) ^^^
  select16 (u.val.testBit 5) (r 5) ^^^
  select16 (u.val.testBit 6) (r 6) ^^^
  select16 (u.val.testBit 7) (r 7) ^^^
  select16 (u.val.testBit 8) (r 8) ^^^
  select16 (u.val.testBit 9) (r 9) ^^^
  select16 (u.val.testBit 10) (r 10) ^^^
  select16 (u.val.testBit 11) (r 11)

