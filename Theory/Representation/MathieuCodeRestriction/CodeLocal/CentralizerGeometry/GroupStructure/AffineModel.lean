module

public import Theory.ElementaryAbelian.Basic
public import Theory.PGroupCore
public import Mathlib.LinearAlgebra.AffineSpace.AffineEquiv
public import Mathlib.GroupTheory.Subgroup.Centralizer

/-!
# Pair-preserving subgroups of the binary affine four-space

For a vector v, take all affine maps that preserve each pair {x, x + v}.
Their squares are one, so they form an elementary abelian group. The full
centralizer of translation by v normalizes this group, and its intersection
with the translations is precisely the cyclic group generated by v.

This defines the concrete second subgroup used in the affine construction of
Aschbacher (1994), 39.1, applied in Aschbacher--Smith H.16.2(6), printed
pp.402--403. Its order and the intrinsic two-core product are separate
calculations; neither is built into this definition.
-/

@[expose] public section

open scoped Pointwise IsMulCommutative
namespace MathieuCode.OctadAffine

abbrev Space := Fin 4 → ZMod 2
abbrev AffineGroup := Space ≃ᵃ[ZMod 2] Space

instance affineGroup_finite : Finite AffineGroup :=
  Finite.of_injective (fun f : AffineGroup => (f : Space → Space)) DFunLike.coe_injective

/-- All translations of the binary affine four-space. -/
def translations : Subgroup AffineGroup := (AffineEquiv.constVAddHom (ZMod 2) Space).range

/-- Translation by the marked binary vector. -/
def translation (v : Space) : AffineGroup := AffineEquiv.constVAdd (ZMod 2) Space v

private theorem add_self (v : Space) : v + v = 0 := by
  ext i
  exact CharTwo.add_self_eq_zero (v i)

/-- Affine maps preserving every pair parallel to the marked line. -/
def fiberKernel (v : Space) : Subgroup AffineGroup where
  carrier := {f | ∀ x, f x = x ∨ f x = v + x}
  one_mem' := fun _ => Or.inl rfl
  mul_mem' := by
    intro f g hf hg x
    change f (g x) = x ∨ f (g x) = v + x
    rcases hg x with hx | hx
    · rw [hx]
      exact hf x
    · rw [hx]
      rcases hf (v + x) with hy | hy
      · exact Or.inr hy
      · left
        simpa only [← add_assoc, add_self, zero_add] using hy
  inv_mem' := by
    intro f hf x
    rcases hf (f⁻¹ x) with h | h
    · exact Or.inl (by simpa only [AffineEquiv.inv_def, AffineEquiv.apply_symm_apply] using h.symm)
    · right
      have he := congrArg (fun y => v + y) h
      simpa only [AffineEquiv.inv_def, AffineEquiv.apply_symm_apply,
        ← add_assoc, add_self, zero_add] using he.symm

@[simp] theorem mem_fiberKernel (v : Space) (f : AffineGroup) :
    f ∈ fiberKernel v ↔ ∀ x, f x = x ∨ f x = v + x := Iff.rfl

/-- Every pair-preserving affine map has square one. -/
theorem fiberKernel_sq (v : Space) (f : fiberKernel v) : f ^ 2 = 1 := by
  apply Subtype.ext
  apply AffineEquiv.ext
  intro x
  change f.val (f.val x) = x
  rcases f.property x with h | h
  · rw [h, h]
  · rcases f.property (f.val x) with he | he
    · exact (congrArg f.val (f.val.injective he)).trans (f.val.injective he)
    · rw [he, h, ← add_assoc, add_self, zero_add]

/-- The pair-preserving group is genuinely elementary abelian. -/
theorem fiberKernel_elementary (v : Space) : IsElementaryAbelian 2 (fiberKernel v) := by
  have hsq (f : fiberKernel v) : f * f = 1 := by simpa only [pow_two] using fiberKernel_sq v f
  have hi (f : fiberKernel v) : f⁻¹ = f := inv_eq_of_mul_eq_one_left (hsq f)
  let : IsMulCommutative (fiberKernel v) := ⟨⟨fun f g => by
    calc f * g = (f * g)⁻¹ := (hi _).symm
      _ = g * f := by rw [mul_inv_rev, hi, hi]⟩⟩
  exact { exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr (fiberKernel_sq v) }

/-- The distinguished translation preserves each of its own pairs. -/
theorem translation_mem_fiberKernel (v : Space) : translation v ∈ fiberKernel v :=
  fun _ => Or.inr rfl

/-- The pair-preserving group centralizes the marked translation. -/
theorem fiberKernel_le_centralizer (v : Space) :
    fiberKernel v ≤ Subgroup.centralizer ({translation v} : Set AffineGroup) := by
  intro f hf
  let _ := fiberKernel_elementary v
  exact Subgroup.mem_centralizer_singleton_iff.mpr
    (congrArg Subtype.val (mul_comm (⟨f, hf⟩ : fiberKernel v)
      ⟨translation v, translation_mem_fiberKernel v⟩))

/-- The full translation centralizer normalizes the pair-preserving group. -/
theorem fiberKernel_normal (v : Space) :
    ((fiberKernel v).subgroupOf (Subgroup.centralizer ({translation v} : Set AffineGroup))).Normal := by
  apply (Subgroup.normal_subgroupOf_iff_le_normalizer (fiberKernel_le_centralizer v)).mpr
  intro g hg
  apply Subgroup.mem_normalizer_iff.mpr
  intro f
  have hc : ∀ x, g (v + x) = v + g x := by
    intro x
    exact congrArg (fun a : AffineGroup => a x)
      (Subgroup.mem_centralizer_singleton_iff.mp hg)
  constructor
  · intro hf x
    change g (f (g⁻¹ x)) = x ∨ g (f (g⁻¹ x)) = v + x
    rcases hf (g⁻¹ x) with h | h
    · left
      rw [h]
      exact g.apply_symm_apply x
    · right
      rw [h, hc]
      exact congrArg (fun y => v + y) (g.apply_symm_apply x)
  · intro hf x
    have h := hf (g x)
    change g (f (g⁻¹ (g x))) = g x ∨ g (f (g⁻¹ (g x))) = v + g x at h
    simp only [AffineEquiv.inv_def, AffineEquiv.symm_apply_apply] at h
    rcases h with h | h
    · exact Or.inl (g.injective h)
    · exact Or.inr (g.injective (h.trans (hc x).symm))

/-- Translations meeting the pair-preserving group are precisely the marked cyclic subgroup. -/
theorem translations_inf_fiberKernel (v : Space) :
    translations ⊓ fiberKernel v = Subgroup.zpowers (translation v) := by
  apply le_antisymm
  · rintro f ⟨⟨a, rfl⟩, hf⟩
    have h := hf 0
    change a.toAdd + 0 = 0 ∨ a.toAdd + 0 = v + 0 at h
    simp only [add_zero] at h
    rcases h with h | h
    · have he : AffineEquiv.constVAddHom (ZMod 2) Space a = 1 := by
        apply AffineEquiv.ext
        intro x
        change a.toAdd + x = x
        rw [h, zero_add]
      rw [he]
      exact (Subgroup.zpowers _).one_mem
    · have he : AffineEquiv.constVAddHom (ZMod 2) Space a = translation v := by
        apply AffineEquiv.ext
        intro x
        change a.toAdd + x = v + x
        rw [h]
      rw [he]
      exact Subgroup.mem_zpowers _
  · apply Subgroup.zpowers_le.mpr
    exact ⟨⟨Multiplicative.ofAdd v, rfl⟩, translation_mem_fiberKernel v⟩

end MathieuCode.OctadAffine
