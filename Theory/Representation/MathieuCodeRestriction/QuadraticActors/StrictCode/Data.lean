def certificate (v w : Fin 192) : Nat :=
  lookup 9 certificateTable ((lookup 8 pairTable v.val >>> (9 * w.val)) % 512)

def columnIndex (v w : Fin 192) (j : Fin 5) : Nat :=
  (certificate v w >>> (5 * j.val)) % 32

def selected (v w : Fin 192) : Matrix (Fin 11) (Fin 5) (ZMod 2) :=
  fun i j => if columnIndex v w j < 11 then
    matrix v i ⟨columnIndex v w j % 11, Nat.mod_lt _ (by decide)⟩
  else matrix w i ⟨columnIndex v w j % 11, Nat.mod_lt _ (by decide)⟩

def leftInverse (v w : Fin 192) : Matrix (Fin 5) (Fin 11) (ZMod 2) :=
  fun i j => bit (certificate v w) (25 + 11 * i.val + j.val)

def checkRow (v : Fin 192) : Prop := ∀ w : Fin 192,
  v ≠ 0 → w ≠ 0 → v ≠ w → adjacent v w = true → leftInverse v w * selected v w = 1
end MathieuCode.QuadraticActors.StrictCode
