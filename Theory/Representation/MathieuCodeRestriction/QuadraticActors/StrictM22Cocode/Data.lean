def certificate (v w : Fin 72) : Nat :=
  lookup 8 certificateTable ((lookup 7 pairTable v.val >>> (8 * w.val)) % 256)

def columnIndex (v w : Fin 72) (j : Fin 5) : Fin 11 :=
  ⟨((certificate v w >>> (4 * j.val)) % 16) % 11, Nat.mod_lt _ (by decide)⟩

def pairMatrix (v w : Fin 72) : Matrix (Fin 22) (Fin 11) (ZMod 2) :=
  fun i j => let a := if i.val < 11 then v else w
             let r : Fin 11 := ⟨i.val % 11, Nat.mod_lt _ (by decide)⟩
             outerMatrix a r j - outerMatrix a 0 j * pairCoordinate r

def selected (v w : Fin 72) : Matrix (Fin 22) (Fin 5) (ZMod 2) :=
  fun i j => pairMatrix v w i (columnIndex v w j)

def leftInverse (v w : Fin 72) : Matrix (Fin 5) (Fin 22) (ZMod 2) :=
  fun i j => bit (certificate v w) (20 + 22 * i.val + j.val)

def checkRow (v : Fin 72) : Prop := ∀ w : Fin 72,
  v ≠ 0 → w ≠ 0 → v ≠ w → outerAdjacent v w = true → leftInverse v w * selected v w = 1
end MathieuCode.QuadraticActors.StrictM22Cocode
