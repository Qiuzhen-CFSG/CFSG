module
public import Theory.Representation.NormalPSubgroupKernel
public import Theory.Representation.BinaryOffender.SubspaceAction
public import Theory.GroupTheory.AutomorphismTowerSimple
public import Theory.GroupTheory.DoubleCoverCentralizer.Basic
/-!
# An inner involution in a binary irreducible action

For a normal subgroup with cubic center, cube an inner representative of an
involution to obtain an involution in the subgroup. The discrepancy is a
central involution in the group generated by the subgroup and the actor.
It acts trivially in characteristic two, so the subgroup and the whole group
have the same invariant subspaces. Both the actual representative and its
operator equality are retained.

Source application: Aschbacher–Smith, proof of 12.6.26, printed p.832,
the restriction to the cubic Mathieu component.
-/

public section
open Subgroup
namespace Representation.InnerCubicInvolution
variable {G V : Type*} [Group G] [Finite G]
  [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]

/-- Remove the central binary discrepancy without changing the marked actor. -/
theorem restriction_irreducible_and_involution (ρ : Representation (ZMod 2) G V) [ρ.IsIrreducible]
    (K : Subgroup G) [K.Normal] (hc : Nat.card (center K) = 3)
    (t : G) (ht : t ^ 2 = 1) (hgen : K ⊔ zpowers t = ⊤)
    (hi : ∃ b : K, MulAut.conjNormal (H := K) t = MulAut.conj b) :
    IsIrreducible (ρ.comp K.subtype) ∧
      ∃ b : K, b ^ 2 = 1 ∧ MulAut.conjNormal (H := K) t = MulAut.conj b ∧ ρ t = ρ b := by
  obtain ⟨k,hk⟩ := hi
  have hk2 : k ^ 2 ∈ center K := by
    rw [←Theory.GroupTheory.DoubleCoverCentralizer.conj_kernel,MonoidHom.mem_ker,map_pow,←hk,←map_pow,ht,map_one]
  have hk6 : (k ^ 3) ^ 2 = 1 := by
    have hh := pow_card_eq_one' (x := (⟨k^2,hk2⟩ : center K))
    rw [hc] at hh
    have he := congrArg Subtype.val hh
    simpa only [coe_pow,coe_one,←pow_mul] using he
  let b : K := k ^ 3
  have hb : MulAut.conjNormal (H := K) t = MulAut.conj b := by
    change _ = MulAut.conj (k^3)
    rw [map_pow,←hk,←map_pow,pow_succ,ht,one_mul]
  have htb : Commute t (b : G) := by
    have he := congrArg (fun f : MulAut K => (f b : G)) hb
    change t*b*t⁻¹ = b*b*(b : G)⁻¹ at he
    rw [mul_inv_cancel_right] at he
    exact mul_inv_eq_iff_eq_mul.mp he
  let d := t * (b : G)⁻¹
  have hd2 : d ^ 2 = 1 := by
    rw [htb.inv_right.mul_pow,ht,inv_pow,
      show (b : G)^2 = 1 from congrArg K.subtype hk6,inv_one,mul_one]
  have hdK : d ∈ centralizer (K : Set G) := by
    rw [←MulAut.conjNormal_ker_eq_centralizer]
    change MulAut.conjNormal (H := K) (t*(b : G)⁻¹) = 1
    rw [map_mul,map_inv,MulAut.conjNormal_val,hb,mul_inv_cancel]
  have hdt : Commute t d := (Commute.refl t).mul_right htb.inv_right
  have hdZ : d ∈ center G := by
    have hall : (⊤ : Subgroup G) ≤ centralizer ({d} : Set G) := by
      rw [←hgen]
      refine sup_le ?_ (zpowers_le.mpr ?_)
      · intro x hx
        exact mem_centralizer_singleton_iff.mpr (hdK x hx)
      · exact mem_centralizer_singleton_iff.mpr hdt.eq
    exact mem_center_iff.mpr fun x => (mem_centralizer_singleton_iff.mp (hall (mem_top x)))
  have hn : (zpowers d).Normal := by
    refine ⟨fun x hx y => ?_⟩
    rw [(mem_center_iff.mp ((zpowers_le.mpr hdZ) hx) y),mul_inv_cancel_right]
    exact hx
  let := hn
  have hp : IsPGroup 2 (zpowers d) := by
    by_cases hd : d = 1
    · apply IsPGroup.of_card (n := 0)
      simp [hd]
    · apply IsPGroup.of_card (n := 1)
      rw [Nat.card_zpowers,orderOf_eq_prime hd2 hd,pow_one]
  have hdρ : ρ d = 1 := normal_p_subgroup_le_ker ρ (zpowers d) hp (mem_zpowers d)
  have htρ : ρ t = ρ b := by
    calc
      ρ t = ρ (d * (b : G)) := by congr 1; simp [d]
      _ = ρ b := by rw [map_mul,hdρ,one_mul]
  refine ⟨?_,b,hk6,hb,htρ⟩
  let := Subrepresentation.irreducible_module_nontrivial ρ
  rw [IsIrreducible,isSimpleOrder_iff]
  refine ⟨inferInstance,fun J => ?_⟩
  have hK : K ≤ BinaryOffender.subspaceStabilizer ρ J.toSubmodule :=
    BinaryOffender.le_subspaceStabilizer ρ J.toSubmodule
      (fun g hg w hw => J.apply_mem_toSubmodule ⟨g,hg⟩ hw)
  have htJ : t ∈ BinaryOffender.subspaceStabilizer ρ J.toSubmodule := by
    intro w
    rw [htρ]
    exact hK b.property w
  have hall : ⊤ ≤ BinaryOffender.subspaceStabilizer ρ J.toSubmodule :=
    hgen ▸ sup_le hK (zpowers_le.mpr htJ)
  let A : Subrepresentation ρ := {
    toSubmodule := J.toSubmodule
    apply_mem_toSubmodule g w hw := (hall (mem_top g) w).mpr hw }
  rcases IsSimpleOrder.eq_bot_or_eq_top A with hh|hh
  · exact Or.inl (Subrepresentation.toSubmodule_injective
      (congrArg (fun U : Subrepresentation ρ => U.toSubmodule) hh))
  · exact Or.inr (Subrepresentation.toSubmodule_injective
      (congrArg (fun U : Subrepresentation ρ => U.toSubmodule) hh))
end Representation.InnerCubicInvolution
