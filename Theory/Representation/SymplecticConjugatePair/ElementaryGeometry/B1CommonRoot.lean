module

public import Theory.Representation.SymplecticConjugatePair.ElementaryGeometry.Involutions.CentralTypes
public import Theory.Representation.SymplecticConjugatePair.ElementaryGeometry.Placement
public import Theory.GroupTheory.SpecificGroups.KleinFourGenerators
/-!
# Common root groups for b₁ involutions in symplectic four-space

A one-dimensional displacement space makes every two-by-two displacement
minor vanish. In the point radical these equations put each b₁ element
straight into root 0. In the plane radical they give determinant zero for
symmetric shears B, C and B+C. In characteristic two, these three equations
force dependent diagonal pairs. The simultaneous Levi conjugation from
`Placement` therefore puts an all-b₁ subgroup in the Sylow center, where
the b₁ type calculation removes the other root coordinate.

Sylow and elementary-wing placement now put any elementary all-b₁ subgroup
in a conjugate of the literal `RootSubgroup.group 0`. Its order is at most
the field order. Applied to the Klein four subgroup generated by commuting
b₁ involutions with b₁ product, this proves the common-root assertion used
in Aschbacher–Smith, K.3.4.2, printed p.457 (PDF p.468). The tensor actor
application is in the Chapter K module `Equality.B1Actors`.
-/

public section

open scoped Matrix
open Matrix Representation Representation.BinaryOffender
open Theory.SpecificGroups.SymplecticFour
open Representation.OneCohomology.SymplecticFour
open Theory.SpecificGroups.SymplecticFour.InvolutionTypes
open SymplecticConjugatePair SymplecticConjugatePair.Involutions
namespace SymplecticConjugatePair
set_option linter.unusedSectionVars false
variable {F : Type*} [Field F]
private lemma moved_minor {g : Sp F} (hg : IsB1 g) (x y : Vector F)
    (i j : Fin 2 ⊕ Fin 2) :
    (g • x-x) i * (g • y-y) j = (g • x-x) j * (g • y-y) i := by
  obtain ⟨v, _, hv⟩ := finrank_eq_one_iff'.mp hg.2
  obtain ⟨a, ha⟩ := hv ⟨g • x-x, ⟨x,rfl⟩⟩
  obtain ⟨b, hb⟩ := hv ⟨g • y-y, ⟨y,rfl⟩⟩
  have ha' : a • v.val = g • x-x := congrArg Subtype.val ha
  have hb' : b • v.val = g • y-y := congrArg Subtype.val hb
  rw [← ha', ← hb']
  simp only [Pi.smul_apply, smul_eq_mul]
  ring
private lemma matrix_minor {g : Sp F} (hg : IsB1 g) (i j k l : Fin 2 ⊕ Fin 2) :
    (g.val i k - (1 : Matrix _ _ F) i k) * (g.val j l - (1 : Matrix _ _ F) j l) =
    (g.val j k - (1 : Matrix _ _ F) j k) * (g.val i l - (1 : Matrix _ _ F) i l) := by
  have h := moved_minor hg (Pi.single k 1) (Pi.single l 1) i j
  simpa [Theory.SpecificGroups.SymplecticFour.smul_eq_mulVec, Matrix.mulVec_single, Matrix.one_apply, Pi.single_apply, eq_comm] using h
variable [CharP F 2] [Finite F]
private lemma point_b1 {u v z : F} (h : IsB1 (pointRadicalElement u v z).val) : u = 0 ∧ v = 0 := by
  have hu := matrix_minor h (.inl 0) (.inl 1) (.inr 1) (.inr 0)
  have hv := matrix_minor h (.inl 0) (.inr 1) (.inl 1) (.inr 0)
  simp [pointRadicalElement,pointRadicalMatrix,fromBlocks] at hu hv
  exact ⟨hu, hv⟩
private lemma matrix_minor_one_or_b1 {g : Sp F} (hg : g = 1 ∨ IsB1 g)
    (i j k l : Fin 2 ⊕ Fin 2) :
    (g.val i k - (1 : Matrix _ _ F) i k) * (g.val j l - (1 : Matrix _ _ F) j l) =
    (g.val j k - (1 : Matrix _ _ F) j k) * (g.val i l - (1 : Matrix _ _ F) i l) := by
  rcases hg with rfl | hg
  · simp
  · exact matrix_minor hg i j k l
private lemma shear_det {B : Plane.symmetricMatrices F} (h : Plane.shearSp B = 1 ∨ IsB1 (Plane.shearSp B)) :
    B.val 0 0 * B.val 1 1 - B.val 1 0 ^ 2 = 0 := by
  have hm := matrix_minor_one_or_b1 h (.inl 0) (.inl 1) (.inr 0) (.inr 1)
  have hs : B.val 0 1 = B.val 1 0 := B.property.apply 1 0
  simpa [Plane.shearSp,fromBlocks,hs,pow_two,sub_eq_zero] using hm
private lemma shear_dep {B C : Plane.symmetricMatrices F}
    (hb : Plane.shearSp B = 1 ∨ IsB1 (Plane.shearSp B))
    (hc : Plane.shearSp C = 1 ∨ IsB1 (Plane.shearSp C))
    (hbc : Plane.shearSp (B+C) = 1 ∨ IsB1 (Plane.shearSp (B+C))) :
    B.val 0 0*C.val 1 1-B.val 1 1*C.val 0 0 = 0 := by
  have hB := shear_det hb
  have hC := shear_det hc
  have hBC := shear_det hbc
  change (B.val 0 0 + C.val 0 0) * (B.val 1 1 + C.val 1 1) -
    (B.val 1 0 + C.val 1 0)^2 = 0 at hBC
  have hh : B.val 0 0*C.val 1 1 + B.val 1 1*C.val 0 0 = 0 := by
    calc
      _ = ((B.val 0 0 + C.val 0 0) * (B.val 1 1 + C.val 1 1) -
        (B.val 1 0 + C.val 1 0)^2) -
        (B.val 0 0 * B.val 1 1 - B.val 1 0 ^ 2) -
        (C.val 0 0 * C.val 1 1 - C.val 1 0 ^ 2) := by
          ring_nf
          simp [CharTwo.two_eq_zero]
      _ = 0 := by rw [hBC,hB,hC]; simp
  simpa only [sub_eq_add_neg,CharTwo.neg_eq] using hh
private lemma all_b1_conj {A : Subgroup (Sp F)}
    (hA : ∀ x ∈ A, x ≠ 1 → IsB1 x) (g : Sp F) :
    ∀ x ∈ A.map (MulAut.conj g).toMonoidHom, x ≠ 1 → IsB1 x := by
  rintro _ ⟨x,hx,rfl⟩ hne
  apply (isB1_conj_iff g x).mpr
  apply hA x hx
  intro he
  apply hne
  simp [he]
private lemma central_b1_le_root {A : Subgroup (Sp F)} (hA : A ≤ sylowCenter)
    (hb : ∀ x ∈ A, x ≠ 1 → IsB1 x) : A ≤ RootSubgroup.group 0 := by
  let : Algebra (ZMod 2) F := ZMod.algebra F 2
  intro x hx
  by_cases h1 : x = 1
  · exact h1 ▸ (RootSubgroup.group 0).one_mem
  obtain ⟨s,t,he⟩ := (mem_sylowCenter_iff x).mp (hA hx)
  have ht := ((central_isB1_iff s t).mp (he ▸ hb x hx h1)).2
  apply (RootSubgroup.mem_group_iff 0 x).mpr
  exact ⟨s,by simpa only [ht,RootSubgroup.element_zero,mul_one] using he⟩
private lemma point_b1_le_root {A : Subgroup (Sp F)} (hA : A ≤ SymplecticConjugatePair.pointRadical)
    (hb : ∀ x ∈ A, x ≠ 1 → IsB1 x) : A ≤ RootSubgroup.group 0 := by
  let : Algebra (ZMod 2) F := ZMod.algebra F 2
  intro x hx
  by_cases h1 : x = 1
  · exact h1 ▸ (RootSubgroup.group 0).one_mem
  obtain ⟨u,v,z,he⟩ := (mem_pointRadical_iff x).mp (hA hx)
  obtain ⟨hu,hv⟩ := point_b1 (he ▸ hb x hx h1)
  apply (RootSubgroup.mem_group_iff 0 x).mpr
  refine ⟨z,?_⟩
  rw [← he,hu,hv]
  apply Subtype.ext
  ext i j
  rcases i with i | i <;> rcases j with j | j <;> fin_cases i <;> fin_cases j <;>
    simp [rootElement,rootMatrix,Matrix.single,pointRadicalElement,pointRadicalMatrix,fromBlocks]
private lemma plane_b1_conjugate_root {A : Subgroup (Sp F)} (hA : A ≤ planeRadical)
    (hb : ∀ x ∈ A, x ≠ 1 → IsB1 x) :
    ∃ g : Sp F, A.map (MulAut.conj g).toMonoidHom ≤ RootSubgroup.group 0 := by
  classical
  let : Algebra (ZMod 2) F := ZMod.algebra F 2
  have hall (x : Sp F) (hx : x ∈ A) : x = 1 ∨ IsB1 x :=
    (eq_or_ne x 1).imp_right (hb x hx)
  obtain ⟨g,hg⟩ := dependent_shears_conjugate_central hA (by
    intro B C hB hC
    apply shear_dep (hall _ hB) (hall _ hC)
    apply hall
    have he : Plane.shearSp (B+C) = Plane.shearSp B * Plane.shearSp C :=
      congrArg Subtype.val (Plane.shear_add B C)
    rw [he]
    exact A.mul_mem hB hC)
  exact ⟨g,central_b1_le_root hg (all_b1_conj hb g)⟩
/-- Simultaneous conjugation of an elementary all-b₁ subgroup into the
actual root 0 subgroup. No positivity premise on the field exponent is needed. -/
theorem elementary_b1_conjugate_root {n : ℕ} (hF : Nat.card F = 2^n)
    (A : Subgroup (Sp F)) [IsElementaryAbelian 2 A]
    (hb : ∀ x ∈ A, x ≠ 1 → IsB1 x) :
    ∃ g : Sp F, A.map (MulAut.conj g).toMonoidHom ≤ RootSubgroup.group 0 := by
  let : Algebra (ZMod 2) F := ZMod.algebra F 2
  have hn : 0 < n := by
    by_contra hn
    have hn0 : n = 0 := by omega
    have hc : Nat.card F = 1 := by simpa [hn0] using hF
    let : Subsingleton F := (Nat.card_eq_one_iff_unique.mp hc).1
    exact zero_ne_one (Subsingleton.elim (0:F) 1)
  obtain ⟨g,hg | hg⟩ := elementary_conjugate_radical hF hn A
  · exact ⟨g,point_b1_le_root hg (all_b1_conj hb g)⟩
  · obtain ⟨h,hh⟩ := plane_b1_conjugate_root hg (all_b1_conj hb g)
    refine ⟨h*g,?_⟩
    rintro _ ⟨x,hx,rfl⟩
    have hm := hh (Subgroup.mem_map_of_mem (MulAut.conj h).toMonoidHom
      (Subgroup.mem_map_of_mem (MulAut.conj g).toMonoidHom hx))
    simpa only [MulEquiv.coe_toMonoidHom,MulAut.conj_apply,_root_.mul_inv_rev,mul_assoc] using hm
/-- A field of order 2^n has no elementary all-b₁ subgroup of rank greater than n. -/
theorem elementary_b1_rank_le {n : ℕ} (hF : Nat.card F = 2^n)
    (A : Subgroup (Sp F)) [IsElementaryAbelian 2 A]
    (hb : ∀ x ∈ A, x ≠ 1 → IsB1 x) : rank A ≤ n := by
  obtain ⟨g,hg⟩ := elementary_b1_conjugate_root hF A hb
  have hc := Nat.log_mono_right (b := 2) (Subgroup.card_le_of_le hg)
  change rank (A.map (MulAut.conj g).toMonoidHom) ≤ _ at hc
  rwa [rank_map_conj,RootSubgroup.card,hF,Nat.log_pow (by decide : 1 < 2)] at hc

/-- Every elementary all-b₁ subgroup lies in one conjugate of root 0.
This includes the trivial subgroup and requires only a finite binary field. -/
theorem elementary_b1_le_conjugate_root (A : Subgroup (Sp F)) [IsElementaryAbelian 2 A]
    (hb : ∀ x ∈ A, x ≠ 1 → IsB1 x) :
    ∃ g : Sp F, A ≤ (RootSubgroup.group 0).map (MulAut.conj g).toMonoidHom := by
  let : Algebra (ZMod 2) F := ZMod.algebra F 2
  have hF : Nat.card F = 2 ^ Module.finrank (ZMod 2) F := by
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2), Nat.card_eq_fintype_card, ZMod.card]
  obtain ⟨g,hg⟩ := elementary_b1_conjugate_root hF A hb
  refine ⟨g⁻¹,?_⟩
  intro x hx
  refine ⟨(MulAut.conj g) x,hg (Subgroup.mem_map_of_mem _ hx),?_⟩
  simp [MulAut.conj_apply,mul_assoc]
/-- Commuting b₁ involutions whose product is b₁ belong to a common
conjugate of the actual root 0 subgroup. -/
theorem b1_mul_common_root {x y : Sp F} (hx : IsB1 x) (hy : IsB1 y)
    (hxy : Commute x y) (hprod : IsB1 (x*y)) :
    ∃ g : Sp F, x ∈ (RootSubgroup.group 0).map (MulAut.conj g).toMonoidHom ∧
      y ∈ (RootSubgroup.group 0).map (MulAut.conj g).toMonoidHom := by
  have hx2 : x*x = 1 := by simpa only [pow_two] using (orderOf_eq_prime_iff.mp hx.1).1
  have hy2 : y*y = 1 := by simpa only [pow_two] using (orderOf_eq_prime_iff.mp hy.1).1
  have hne : x ≠ y := by
    intro he
    have ho := hprod.1
    rw [← he,hx2,orderOf_one] at ho
    omega
  let A : Subgroup (Sp F) := Subgroup.closure {x,y}
  let : IsKleinFour A := Subgroup.isKleinFour_closure_pair_of_orderOf x y hx.1 hy.1 hne hxy
  let : IsElementaryAbelian 2 A :=
    { toIsMulCommutative := IsKleinFour.isMulCommutative
      exponent_dvd_p := by rw [IsKleinFour.exponent_two] }
  have hb : ∀ z ∈ A, z ≠ 1 → IsB1 z := by
    intro z hz hz1
    rcases (Subgroup.mem_closure_pair_iff x y hx2 hy2 hxy z).mp hz with h | rfl | rfl | rfl
    · exact (hz1 h).elim
    · exact hx
    · exact hy
    · exact hprod
  obtain ⟨g,hg⟩ := elementary_b1_le_conjugate_root A hb
  exact ⟨g,hg (Subgroup.subset_closure (by simp)),hg (Subgroup.subset_closure (by simp))⟩
end SymplecticConjugatePair
