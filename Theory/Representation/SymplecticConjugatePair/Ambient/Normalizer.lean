module

public import Theory.Representation.SymplecticConjugatePair.Ambient.Normalizer.Forms
public import Theory.Representation.SymplecticConjugatePair.Ambient.Normalizer.Commutant
public import Theory.Representation.SymplecticConjugatePair.Ambient.Normalizer.NaturalSemilinear

/-!
# Coverage and transport of the paired symplectic normalizer

The literal binary normalizer of the derived graph pair is exactly the group
generated by independent coefficient scalars, full symplectic operators,
simultaneous field automorphisms and the explicit graph swap. The computed
commutant forces permutation of the two summands. On a preserved summand its
scalar commutant forces semilinearity, and the invariant symplectic form supplies
the inner factor. This discharges both inputs of `Normalizer.Forms`.

The resulting normal forms retain the two coefficient scalars and the genuine
derived group, including over the field of order two. The graph swap has
Frobenius square. Actual conjugation transports coverage and evaluation to any
diagram-moving twist, preserving both marked summands. The earlier conditional
interfaces are retained alongside the unconditional conclusions.

Source: Aschbacher–Smith H.7, printed pp.388–389, with the paired setup on
printed p.696 of `refs/quasithin.pdf`.
-/

@[expose] public section

open Representation Theory.SpecificGroups.SymplecticFour
open Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms
open Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms.ExceptionalGraph
namespace SymplecticConjugatePair.Ambient.Normalizer
variable {F : Type*} [Field F] [Finite F] [CharP F 2] [Algebra (ZMod 2) F]

variable (hcomm : ∀ q : Space F →ₗ[ZMod 2] Space F,
  (∀ (x : commutator (Sp F)) v, q (derivedPair graphAut x v) = derivedPair graphAut x (q v)) →
  ∃ a b : F, q = blockScalar a b)

include hcomm in
/-- A canonical commutant calculation gives summand permutation for every moving twist. -/
theorem permutesSummands_of_inputs (τ : MulAut (Sp F)) (hτ : ¬ PreservesDiagram τ) :
    PermutesSummands (normalizerAction τ) :=
  permutesSummands_of_graph τ hτ (permutesSummands_of_commutant hcomm)

variable (hnatural : ∀ e : Vector F ≃ₗ[ZMod 2] Vector F, e ∈ naturalNormalizer →
  ∃ (a : Fˣ) (g : Sp F) (σ : F ≃+* F), ∀ v, e v = a.val • innerFieldVector g σ v)

include hcomm hnatural in
/-- Actual conjugation coverage of every moving pair, with both inputs explicit. -/
theorem exists_normalizer_conjugation_of_inputs (τ : MulAut (Sp F))
    (hτ : ¬ PreservesDiagram τ) :
    ∃ E : Space F ≃ₗ[ZMod 2] Space F,
      (standardAmbient (F := F)).map (MulAut.conj E).toMonoidHom = pairedNormalizer τ ∧
      (∀ v, E v ∈ firstSummand ↔ v ∈ firstSummand) ∧
      (∀ v, E v ∈ secondSummand ↔ v ∈ secondSummand) := by
  obtain ⟨E, hE, hU, hW⟩ := exists_derivedPair_equiv τ hτ
  refine ⟨E, ?_, hU, hW⟩
  rw [← pairedNormalizer_eq_standardAmbient_of_inputs hcomm hnatural]
  exact pairedNormalizer_map_conj graphAut τ E hE

include hcomm hnatural in
/-- The coverage equivalence intertwines the literal evaluation actions. -/
theorem exists_standardAmbient_equiv_of_inputs (τ : MulAut (Sp F))
    (hτ : ¬ PreservesDiagram τ) :
    ∃ (E : Space F ≃ₗ[ZMod 2] Space F)
      (φ : standardAmbient (F := F) ≃* pairedNormalizer τ),
      (∀ x v, E (standardAction x v) = normalizerAction τ (φ x) (E v)) ∧
      (∀ v, E v ∈ firstSummand ↔ v ∈ firstSummand) ∧
      (∀ v, E v ∈ secondSummand ↔ v ∈ secondSummand) := by
  obtain ⟨E, φ, hE, hU, hW⟩ := exists_pairedNormalizer_equiv τ hτ
  let e := MulEquiv.subgroupCongr
    (pairedNormalizer_eq_standardAmbient_of_inputs hcomm hnatural).symm
  exact ⟨E, e.trans φ, fun x v => hE (e x) v, hU, hW⟩

/-- The natural normalizer is scalar times inner-field, with its scalar-commutant
premise discharged by the actual paired commutant calculation. -/
theorem naturalNormalizer_semilinear (e : Vector F ≃ₗ[ZMod 2] Vector F)
    (he : e ∈ naturalNormalizer) :
    ∃ (a : Fˣ) (g : Sp F) (σ : F ≃+* F), ∀ v, e v = a.val • innerFieldVector g σ v :=
  naturalNormalizer_semilinear_of_scalar_commutant
    (natural_commutant_of_pair centralizer_block_scalars) e he

/-- The full binary normalizer of the genuine derived pair is precisely the
specified generated group, including the full symplectic operators when `|F| = 2`. -/
theorem pairedNormalizer_eq_standardAmbient :
    pairedNormalizer (graphAut (F := F)) = standardAmbient :=
  pairedNormalizer_eq_standardAmbient_of_inputs centralizer_block_scalars
    naturalNormalizer_semilinear

/-- Every summand-preserving normalizer has the same inner-field parameters on
the two graph-conjugate modules, with independent nonzero coefficient scalars. -/
theorem preserving_normalizer_eq_standardPair (f : Space F ≃ₗ[ZMod 2] Space F)
    (hf : f ∈ pairedNormalizer graphAut) (hp : PreservesCoordinates f) :
    ∃ (a b : Fˣ) (g : Sp F) (σ : F ≃+* F), f = standardPair a b g σ :=
  preserving_eq_standardPair centralizer_block_scalars naturalNormalizer_semilinear f hf hp

/-- The coordinate formula for every summand-preserving normalizer. -/
theorem preserving_normalizer_apply (f : Space F ≃ₗ[ZMod 2] Space F)
    (hf : f ∈ pairedNormalizer graphAut) (hp : PreservesCoordinates f) :
    ∃ (a b : Fˣ) (g : Sp F) (σ : F ≃+* F), ∀ v : Space F,
      f v = (a.val • innerFieldVector g σ v.1,
        b.val • innerFieldVector (graphAut g) σ v.2) := by
  obtain ⟨a, b, g, σ, rfl⟩ := preserving_normalizer_eq_standardPair f hf hp
  exact ⟨a, b, g, σ, standardPair_apply a b g σ⟩

/-- A summand-exchanging normalizer is a preserving normal form followed by the
actual graph swap, whose square is Frobenius rather than necessarily the identity. -/
theorem swapping_normalizer_eq_standardPair_mul_graphSwap
    (f : Space F ≃ₗ[ZMod 2] Space F) (hf : f ∈ pairedNormalizer graphAut)
    (hs : SwapsSummands (normalizerAction graphAut) ⟨f, hf⟩) :
    ∃ (a b : Fˣ) (g : Sp F) (σ : F ≃+* F), f = standardPair a b g σ * graphSwap := by
  have hp : PreservesCoordinates (f * graphSwap⁻¹) := by
    constructor
    · intro v
      change (f (graphSwap.symm (v, 0))).2 = 0
      rw [graphSwap_symm_apply]
      have h := (mem_firstSummand _).mp (hs.2 (0, v) ⟨v, rfl⟩)
      change (f (0, v)).2 = 0 at h
      simpa only [map_zero] using h
    · intro v
      change (f (graphSwap.symm (0, v))).1 = 0
      rw [graphSwap_symm_apply]
      exact (mem_secondSummand _).mp
        (hs.1 ((fieldVector (frobeniusEquiv F 2)).symm v, 0) ⟨_, rfl⟩)
  obtain ⟨a, b, g, σ, h⟩ := preserving_normalizer_eq_standardPair (f * graphSwap⁻¹)
    ((pairedNormalizer graphAut).mul_mem hf
      ((pairedNormalizer graphAut).inv_mem graphSwap_mem_pairedNormalizer)) hp
  exact ⟨a, b, g, σ, mul_inv_eq_iff_eq_mul.mp h⟩

/-- The coordinate formula for every summand-exchanging normalizer. -/
theorem swapping_normalizer_apply (f : Space F ≃ₗ[ZMod 2] Space F)
    (hf : f ∈ pairedNormalizer graphAut)
    (hs : SwapsSummands (normalizerAction graphAut) ⟨f, hf⟩) :
    ∃ (a b : Fˣ) (g : Sp F) (σ : F ≃+* F), ∀ v : Space F,
      f v = (a.val • innerFieldVector g σ v.2,
        b.val • innerFieldVector (graphAut g) σ
          (fieldVector (frobeniusEquiv F 2) v.1)) := by
  obtain ⟨a, b, g, σ, rfl⟩ := swapping_normalizer_eq_standardPair_mul_graphSwap f hf hs
  exact ⟨a, b, g, σ, fun _ => rfl⟩

/-- Exact membership in the binary normalizer, in its preserving and exchanging forms. -/
theorem mem_pairedNormalizer_iff (f : Space F ≃ₗ[ZMod 2] Space F) :
    f ∈ pairedNormalizer graphAut ↔
      ∃ (a b : Fˣ) (g : Sp F) (σ : F ≃+* F),
        f = standardPair a b g σ ∨ f = standardPair a b g σ * graphSwap := by
  constructor
  · exact normalizer_forms_forward centralizer_block_scalars naturalNormalizer_semilinear f
  · rintro ⟨a, b, g, σ, rfl | rfl⟩
    · exact standardAmbient_le_pairedNormalizer (standardPair_mem_standardAmbient a b g σ)
    · exact (pairedNormalizer graphAut).mul_mem
        (standardAmbient_le_pairedNormalizer (standardPair_mem_standardAmbient a b g σ))
        graphSwap_mem_pairedNormalizer

/-- The centralizer on invertible binary operators retains exactly the two
independent coefficient scalars; conjugation on the derived image need not be faithful. -/
theorem commutes_iff_scalarPair (f : Space F ≃ₗ[ZMod 2] Space F) :
    (∀ (x : commutator (Sp F)) v,
      f (derivedPair graphAut x v) = derivedPair graphAut x (f v)) ↔
      ∃ a b : Fˣ, f = scalarPair a b := by
  constructor
  · intro hf
    obtain ⟨a, b, h⟩ := centralizer_block_scalars f.toLinearMap hf
    have ha : a ≠ 0 := by
      intro ha
      have hz : f ((Pi.single (Sum.inl 0) 1 : Vector F), 0) = 0 := by
        calc
          f _ = blockScalar a b _ := LinearMap.congr_fun h _
          _ = 0 := by simp [ha]
      have he := congrArg (fun v : Space F => v.1 (Sum.inl 0)) (f.map_eq_zero_iff.mp hz)
      simp at he
    have hb : b ≠ 0 := by
      intro hb
      have hz : f (0, (Pi.single (Sum.inl 0) 1 : Vector F)) = 0 := by
        calc
          f _ = blockScalar a b _ := LinearMap.congr_fun h _
          _ = 0 := by simp [hb]
      have he := congrArg (fun v : Space F => v.2 (Sum.inl 0)) (f.map_eq_zero_iff.mp hz)
      simp at he
    exact ⟨Units.mk0 a ha, Units.mk0 b hb,
      LinearEquiv.ext (fun v => LinearMap.congr_fun h v)⟩
  · rintro ⟨a, b, rfl⟩ x v
    exact scalarPair_intertwines graphAut a b x.val v

/-- Every canonical paired normalizer permutes the two marked summands. -/
theorem permutesSummands_graph :
    PermutesSummands (normalizerAction (graphAut (F := F))) :=
  permutesSummands_of_commutant centralizer_block_scalars

/-- Every diagram-moving paired normalizer permutes the actual marked summands,
without any extra representation or model hypotheses. -/
theorem permutesSummands (τ : MulAut (Sp F)) (hτ : ¬ PreservesDiagram τ) :
    PermutesSummands (normalizerAction τ) :=
  permutesSummands_of_inputs centralizer_block_scalars τ hτ

/-- Actual conjugation identifies the generated canonical model with every
diagram-moving paired normalizer, preserving both marked summands. -/
theorem exists_normalizer_conjugation (τ : MulAut (Sp F)) (hτ : ¬ PreservesDiagram τ) :
    ∃ E : Space F ≃ₗ[ZMod 2] Space F,
      (standardAmbient (F := F)).map (MulAut.conj E).toMonoidHom = pairedNormalizer τ ∧
      (∀ v, E v ∈ firstSummand ↔ v ∈ firstSummand) ∧
      (∀ v, E v ∈ secondSummand ↔ v ∈ secondSummand) :=
  exists_normalizer_conjugation_of_inputs centralizer_block_scalars
    naturalNormalizer_semilinear τ hτ

/-- The unconditional normalizer coverage equivalence intertwines evaluation,
so bounds for actual operators in the standard model transport to every moving pair. -/
theorem exists_standardAmbient_equiv (τ : MulAut (Sp F)) (hτ : ¬ PreservesDiagram τ) :
    ∃ (E : Space F ≃ₗ[ZMod 2] Space F)
      (φ : standardAmbient (F := F) ≃* pairedNormalizer τ),
      (∀ x v, E (standardAction x v) = normalizerAction τ (φ x) (E v)) ∧
      (∀ v, E v ∈ firstSummand ↔ v ∈ firstSummand) ∧
      (∀ v, E v ∈ secondSummand ↔ v ∈ secondSummand) :=
  exists_standardAmbient_equiv_of_inputs centralizer_block_scalars
    naturalNormalizer_semilinear τ hτ

end SymplecticConjugatePair.Ambient.Normalizer
