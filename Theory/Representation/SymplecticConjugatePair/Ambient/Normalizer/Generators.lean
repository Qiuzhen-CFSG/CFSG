module

public import Theory.Representation.SymplecticConjugatePair.Ambient.Normalizer.Transport
public import Theory.Representation.SymplecticConjugatePair.Ambient.Model

/-!
# The standard paired operators normalize the derived image

Independent coefficient scalars commute with the whole paired action. Full
symplectic operators act by inner conjugation, field operators by simultaneous
field automorphisms, and the explicit graph swap by the exceptional graph map.
All these automorphisms preserve the genuine commutator subgroup. Taking the
subgroup generated by these operators proves one containment in the desired
normalizer equality, including the binary case and its full Sp₄(2) enlargement.

Source: Aschbacher–Smith H.7, printed pp.388–389 of `refs/quasithin.pdf`.
-/

@[expose] public section
open Representation BinaryOffender Theory.SpecificGroups.SymplecticFour
open Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms
open Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms.ExceptionalGraph
namespace SymplecticConjugatePair.Ambient.Normalizer
variable {F : Type*} [Field F] [Algebra (ZMod 2) F]

lemma mem_pairedNormalizer_of_intertwines (τ : MulAut (Sp F))
    (E : Space F ≃ₗ[ZMod 2] Space F) (α : MulAut (Sp F))
    (hE : ∀ x v, E (binaryPair τ x v) = binaryPair τ (α x) (E v)) :
    E ∈ pairedNormalizer τ := by
  apply Subgroup.mem_normalizer_iff_map_conj_eq.mpr
  exact range_map_conj_of_intertwines (derivedPair τ) (derivedPair τ)
    (MulAut.characteristic (commutator (Sp F)) α) E (fun x v => hE x.val v)

lemma scalarPair_intertwines (τ : MulAut (Sp F)) (a b : Fˣ) (x : Sp F) (v : Space F) :
    scalarPair a b (binaryPair τ x v) = binaryPair τ x (scalarPair a b v) := by
  change (a.val • symplecticNatural 2 x v.1, b.val • symplecticNatural 2 (τ x) v.2) =
    (symplecticNatural 2 x (a.val • v.1), symplecticNatural 2 (τ x) (b.val • v.2))
  simp only [map_smul]

lemma scalarPair_mem_pairedNormalizer (τ : MulAut (Sp F)) (a b : Fˣ) :
    scalarPair a b ∈ pairedNormalizer τ :=
  mem_pairedNormalizer_of_intertwines τ _ (MulEquiv.refl _) (scalarPair_intertwines τ a b)

lemma fullPair_mem_pairedNormalizer (τ : MulAut (Sp F)) (g : Sp F) :
    linearAction (binaryPair τ) g ∈ pairedNormalizer τ := by
  apply mem_pairedNormalizer_of_intertwines τ _ (MulAut.conj g)
  intro x v
  change binaryPair τ g (binaryPair τ x v) =
    binaryPair τ (g * x * g⁻¹) (binaryPair τ g v)
  simp only [← Module.End.mul_apply, ← map_mul, inv_mul_cancel_right]

variable [Finite F] [CharP F 2]

omit [Algebra (ZMod 2) F] in
lemma graphAut_fieldAutomorphism (σ : F ≃+* F) (g : Sp F) :
    graphAut (fieldAutomorphism σ g) = fieldAutomorphism σ (graphAut g) := by
  apply Subtype.ext
  ext i j
  change minor (fun i j => σ (g.val i j)) (first i) (second i) (first j) (second j) =
    σ (minor g.val (first i) (second i) (first j) (second j))
  simp only [minor, map_add, map_mul]

lemma fieldPair_intertwines (σ : F ≃+* F) (x : Sp F) (v : Space F) :
    fieldPair σ (graphPair x v) = graphPair (fieldAutomorphism σ x) (fieldPair σ v) := by
  apply Prod.ext
  · exact fieldVector_intertwines σ x v.1
  · change fieldVector σ (symplecticNatural 2 (graphAut x) v.2) =
      symplecticNatural 2 (graphAut (fieldAutomorphism σ x)) (fieldVector σ v.2)
    rw [graphAut_fieldAutomorphism]
    exact fieldVector_intertwines σ (graphAut x) v.2

lemma fieldPair_mem_pairedNormalizer (σ : F ≃+* F) :
    fieldPair σ ∈ pairedNormalizer (graphAut (F := F)) :=
  mem_pairedNormalizer_of_intertwines _ _ (fieldAutomorphism σ) (fieldPair_intertwines σ)

lemma graphSwap_mem_pairedNormalizer :
    graphSwap ∈ pairedNormalizer (graphAut (F := F)) :=
  mem_pairedNormalizer_of_intertwines _ _ graphAut graphSwap_intertwines

/-- The generated candidate is contained in the literal binary normalizer. -/
lemma standardAmbient_le_pairedNormalizer :
    standardAmbient (F := F) ≤ pairedNormalizer graphAut := by
  unfold standardAmbient
  apply (Subgroup.closure_le _).2
  intro E hE
  rcases hE with ((⟨p, rfl⟩ | ⟨g, rfl⟩) | ⟨σ, rfl⟩) | hE
  · exact scalarPair_mem_pairedNormalizer _ _ _
  · exact fullPair_mem_pairedNormalizer _ _
  · exact fieldPair_mem_pairedNormalizer _
  · obtain rfl := Set.mem_singleton_iff.mp hE
    exact graphSwap_mem_pairedNormalizer

end SymplecticConjugatePair.Ambient.Normalizer
