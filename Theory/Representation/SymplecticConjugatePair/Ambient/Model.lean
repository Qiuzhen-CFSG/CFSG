module

public import Theory.Representation.SymplecticConjugatePair.Ambient.Transport

/-!
# Explicit candidate ambient group for the canonical symplectic pair

This is a subgroup of actual binary linear operators, generated by separate
coefficient scalars, the full paired symplectic action, simultaneous field
automorphisms, and the operator (v,w) ↦ (w,Frob(v)). The last operator induces
the exceptional graph map on the full paired group. Its square is simultaneous
Frobenius, so it is not declared to be an involution over general fields.

The construction retains the full Sp₄(2) action alongside its genuine derived
subgroup. Equality with the full binary normalizer and the two-subgroup geometry
are separate theorem obligations, not assumptions in this definition.

Source: the overgroup used in Aschbacher–Smith H.7, printed pp.388–389,
with the paired setup before Table 7.1.1, printed p.696.
-/

@[expose] public section

namespace SymplecticConjugatePair.Ambient
open Representation Theory.SpecificGroups.SymplecticFour
open Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms.ExceptionalGraph
variable {F : Type*} [Field F] [Algebra (ZMod 2) F]

/-- Independent nonzero coefficient scalars on the two actual summands. -/
noncomputable def scalarPair (a b : Fˣ) : Space F ≃ₗ[ZMod 2] Space F :=
  ((LinearEquiv.smulOfUnit a : Vector F ≃ₗ[F] Vector F).restrictScalars (ZMod 2)).prodCongr
    ((LinearEquiv.smulOfUnit b : Vector F ≃ₗ[F] Vector F).restrictScalars (ZMod 2))

/-- Apply the same field automorphism to both summands. -/
noncomputable def fieldPair (σ : F ≃+* F) : Space F ≃ₗ[ZMod 2] Space F :=
  (fieldVector σ).prodCongr (fieldVector σ)

variable [Finite F] [CharP F 2]

/-- The graph operator on the pair; its square is simultaneous Frobenius. -/
noncomputable def graphSwap : Space F ≃ₗ[ZMod 2] Space F :=
  (LinearEquiv.prodComm (ZMod 2) (Vector F) (Vector F)).trans
    ((LinearEquiv.refl (ZMod 2) (Vector F)).prodCongr (fieldVector (frobeniusEquiv F 2)))

@[simp] lemma graphSwap_apply (v : Space F) :
    graphSwap v = (v.2, fieldVector (frobeniusEquiv F 2) v.1) := rfl

lemma graphSwap_square : graphSwap (F := F)^2 = fieldPair (frobeniusEquiv F 2) := by
  apply LinearEquiv.ext
  intro v
  apply Prod.ext <;> rfl

lemma graphSwap_intertwines (g : Sp F) (v : Space F) :
    graphSwap (graphPair g v) = graphPair (graphAut g) (graphSwap v) := by
  have hg : graphAut (graphAut g) =
      DiagramAutomorphisms.fieldAutomorphism (frobeniusEquiv F 2) g :=
    congrArg (fun a : MulAut (Sp F) => a g) graphAut_square
  apply Prod.ext
  · rfl
  · change fieldVector (frobeniusEquiv F 2) (symplecticNatural 2 g v.1) =
      symplecticNatural 2 (graphAut (graphAut g)) (fieldVector (frobeniusEquiv F 2) v.1)
    rw [hg]
    exact fieldVector_intertwines _ _ _

/-- The actual image of the full matrix group, including Sp₄(2). -/
noncomputable def fullImage : Subgroup (Space F ≃ₗ[ZMod 2] Space F) :=
  (linearAction (graphPair (F := F))).range

/-- The explicit binary operator group whose normalizer coverage is to be proved. -/
noncomputable def standardAmbient : Subgroup (Space F ≃ₗ[ZMod 2] Space F) :=
  Subgroup.closure (Set.range (fun p : Fˣ × Fˣ => scalarPair p.1 p.2) ∪
    (fullImage (F := F) : Set (Space F ≃ₗ[ZMod 2] Space F)) ∪
    Set.range (fieldPair (F := F)) ∪ {graphSwap})

noncomputable def standardAction : Representation (ZMod 2) (standardAmbient (F := F))
    (Space F) :=
  LinearEquiv.automorphismGroup.toLinearMapMonoidHom.comp standardAmbient.subtype

lemma fullImage_le_standardAmbient : fullImage (F := F) ≤ standardAmbient := by
  intro g hg
  exact Subgroup.subset_closure (Or.inl (Or.inl (Or.inr hg)))

/-- The full symplectic carrier genuinely embeds in the specified enlargement. -/
noncomputable def fullHom : Sp F →* standardAmbient (F := F) :=
  (linearAction graphPair).codRestrict _ (fun g =>
    fullImage_le_standardAmbient ⟨g, rfl⟩)

lemma fullHom_injective : Function.Injective (fullHom (F := F)) := by
  intro g h he
  apply linearAction_injective graphPair (binaryPair_injective graphAut)
  exact congrArg Subtype.val he

@[simp] lemma fullHom_action (g : Sp F) (v : Space F) :
    standardAction (fullHom g) v = graphPair g v := rfl

end SymplecticConjugatePair.Ambient
