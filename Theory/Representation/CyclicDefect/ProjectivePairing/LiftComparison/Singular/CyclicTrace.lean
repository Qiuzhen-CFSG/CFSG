module

public import Theory.Representation.CyclicDefect.ProjectivePairing.LiftComparison.Singular.Inputs
public import Theory.Representation.CyclicDefect.ProjectivePairing.LiftComparison.Singular.CyclicTrace.ProjectiveCover
public import Theory.GroupTheory.PrimeRegularDecomposition
public import Mathlib.RingTheory.LocalRing.ResidueField.Basic

/-!
# Exact integral cyclic trace vanishing

Restrict the supplied projective lift to the cyclic subgroup generated by a
singular element, and split that element into commuting prime-power and regular
parts. The first part is nonidentity; the second has order dividing the chosen
root order. Apply the finite-projective-cover trace theorem with the integral
root and its unit order.

The canonical residue field of the coefficient ring has characteristic `p`,
as follows from the given residue-kernel equality. Its quotient map is
surjective and detects units. No surjectivity of the lift's supplied map to `K`
is required. The requested locality-compatible export is included; the cover
argument proves vanishing without that additional premise.

Source: the singular-vanishing clause of Feit, *The Representation Theory of
Finite Groups*, IV.2.5 (printed p.144), used in IV.3.3 (pp.145–146).
-/

public section
noncomputable section

namespace Representation.CyclicDefect.ProjectivePairing.IntegralLift
attribute [local instance] IntegralLift.coeffRing IntegralLift.coeffLocal
variable {K G V : Type*} [Field K] [Group G] [Finite G]
  [AddCommGroup V] [Module K V] {m : ℕ} {L : CyclicRootLift K m}
  {Q : Representation K G V} (A : IntegralLift L Q)

/-- Exact integral singular trace vanishing, using a finite projective cover. -/
theorem cyclic_trace_eq_zero (p : ℕ) [Fact p.Prime] [CharP K p]
    (horder : ∀ x : G, ¬ p ∣ orderOf x → orderOf x ∣ m)
    (g : G) (hg : p ∣ orderOf g) :
    LinearMap.trace A.Coeff _ (A.cyclicRep g ⟨g, Subgroup.mem_zpowers g⟩) = 0 := by
  classical
  let : IsDomain A.Coeff := Function.Injective.isDomain A.complex A.complex_injective
  let : CharP (IsLocalRing.ResidueField A.Coeff) p := by
    apply (CharP.charP_iff_prime_eq_zero (Fact.out : p.Prime)).mpr
    rw [← map_natCast (IsLocalRing.residue A.Coeff), IsLocalRing.residue_eq_zero_iff]
    exact A.prime_mem_maximalIdeal p
  let : Fintype (Subgroup.zpowers g) := Fintype.ofFinite _
  let : Module.Projective (MonoidAlgebra A.Coeff (Subgroup.zpowers g))
    (A.cyclicRep g).asModule := A.cyclicRep_projective g
  let x : Subgroup.zpowers g := ⟨g, Subgroup.mem_zpowers g⟩
  have hpx : p ∣ orderOf x := by
    rwa [← orderOf_injective (Subgroup.zpowers g).subtype Subtype.val_injective x]
  obtain ⟨t, v, ⟨a, hta⟩, hv, htv, hmul⟩ := exists_commuting_prime_parts p Fact.out x
  have ht : t ≠ 1 := by
    intro ht
    rw [ht, one_mul] at hmul
    exact hv (hmul ▸ hpx)
  have hvm : v ^ m = 1 := by
    apply orderOf_dvd_iff_pow_eq_one.mp
    have hv' : ¬ p ∣ orderOf (v : G) := by
      simpa only [Subgroup.orderOf_coe] using hv
    simpa only [Subgroup.orderOf_coe] using
      horder v hv'
  have hz := Singular.CyclicTrace.trace_mul_eq_zero_of_projective
    (IsLocalRing.residue A.Coeff) IsLocalRing.residue_surjective
    (fun r hr => (IsLocalRing.residue_ne_zero_iff_isUnit r).mp hr)
    (A.cyclicRep g) t v ht hta htv L.positive.ne' hvm
    A.root_order_isUnit A.root A.root_isPrimitiveRoot
  simpa only [hmul] using hz

/-- The cyclic integral trace theorem with the explicit locality interface
used by the singular-character assembly. The projective-cover proof above
establishes the stronger theorem without needing this extra premise. -/
theorem cyclic_trace_eq_zero_of_local_pGroupAlgebras (p : ℕ) [Fact p.Prime] [CharP K p]
    (horder : ∀ x : G, ¬ p ∣ orderOf x → orderOf x ∣ m)
    (g : G) (hg : p ∣ orderOf g)
    (_hlocal : ∀ P : Subgroup (Subgroup.zpowers g),
      IsPGroup p P → IsLocalRing (MonoidAlgebra A.Coeff P)) :
    LinearMap.trace A.Coeff _ (A.cyclicRep g ⟨g, Subgroup.mem_zpowers g⟩) = 0 :=
  A.cyclic_trace_eq_zero p horder g hg

end Representation.CyclicDefect.ProjectivePairing.IntegralLift
