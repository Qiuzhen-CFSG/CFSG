module

public import Theory.Representation.CyclicDefect.ProjectivePairing.LiftComparison.Regular
public import Theory.Representation.CyclicDefect.ProjectivePairing.LiftComparison.Singular.Restriction

/-!
# Integral inputs to singular-character vanishing

An actual integral projective lift remains projective on every subgroup.
Its residue map detects units, so distinct powers of the chosen primitive
root have unit differences. Its ordinary character is the image of the
integral trace of its restriction to the cyclic subgroup generated by the
element in question.

These are the restriction and coefficient inputs to the cyclic proof of
Feit, *The Representation Theory of Finite Groups*, IV.2.5. The remaining
local group-algebra and cyclic trace arguments are separate obligations;
the results here do not yet assert singular vanishing.
-/

public section
noncomputable section

namespace Representation.CyclicDefect.ProjectivePairing.IntegralLift

attribute [local instance] IntegralLift.coeffRing IntegralLift.coeffLocal

variable {K G V : Type*} [Field K] [Group G] [AddCommGroup V] [Module K V]
  {m : ℕ} {L : CyclicRootLift K m}
  {Q : Representation K G V} (A : IntegralLift L Q)

/-- The stated kernel condition detects vanishing of any coefficient in the residue field. -/
theorem residue_eq_zero_iff (r : A.Coeff) :
    A.residue r = 0 ↔ r ∈ IsLocalRing.maximalIdeal A.Coeff := by
  change r ∈ RingHom.ker A.residue ↔ _
  rw [A.residue_ker]

/-- No surjectivity of the residue map is needed to detect units. -/
theorem isUnit_iff_residue_ne_zero (r : A.Coeff) :
    IsUnit r ↔ A.residue r ≠ 0 := by
  rw [ne_eq, A.residue_eq_zero_iff, IsLocalRing.notMem_maximalIdeal]

/-- The characteristic prime lies in the coefficient ring's maximal ideal. -/
theorem prime_mem_maximalIdeal (p : ℕ) [CharP K p] :
    (p : A.Coeff) ∈ IsLocalRing.maximalIdeal A.Coeff := by
  rw [← A.residue_eq_zero_iff, map_natCast]
  exact CharP.cast_eq_zero K p

/-- Prime-to-characteristic integers are precisely the integer units in the coefficient ring. -/
theorem isUnit_natCast_iff (p n : ℕ) [CharP K p] :
    IsUnit (n : A.Coeff) ↔ ¬ p ∣ n := by
  rw [A.isUnit_iff_residue_ne_zero, map_natCast, ne_eq, CharP.cast_eq_zero_iff K p]

/-- The chosen integral root is primitive because its complex image is primitive. -/
theorem root_isPrimitiveRoot : IsPrimitiveRoot A.root m := by
  apply IsPrimitiveRoot.of_map_of_injective (f := A.complex) _ A.complex_injective
  rw [A.root_complex]
  exact L.complex_primitive

/-- The root order is invertible in the coefficient ring. -/
theorem root_order_isUnit : IsUnit (m : A.Coeff) := by
  let : NeZero m := ⟨L.positive.ne'⟩
  let : NeZero (m : K) := L.modular_primitive.neZero'
  rw [A.isUnit_iff_residue_ne_zero, map_natCast]
  exact NeZero.ne _

/-- Distinct chosen roots remain distinct modulo the maximal ideal, so their
differences are units. This is the integral separation needed for eigenspaces. -/
theorem root_pow_sub_pow_isUnit (i j : Fin m) (hij : i ≠ j) :
    IsUnit (A.root ^ (i : ℕ) - A.root ^ (j : ℕ)) := by
  rw [A.isUnit_iff_residue_ne_zero, map_sub, map_pow, map_pow, A.root_residue,
    sub_ne_zero]
  intro h
  exact hij (Fin.ext (L.modular_primitive.pow_inj i.isLt j.isLt h))

/-- Apply integral subgroup restriction to the actual supplied projective action. -/
theorem projective_subgroup [Finite G] (H : Subgroup G) :
    Module.Projective (MonoidAlgebra A.Coeff H)
      (Representation.asModule (A.rep.comp H.subtype)) := by
  let : Fintype G := Fintype.ofFinite G
  let : Module.Projective (MonoidAlgebra A.Coeff G) A.rep.asModule := A.projective
  exact Singular.projective_subgroup A.rep H

/-- The literal integral action of the cyclic subgroup generated by an element. -/
@[expose] def cyclicRep (g : G) :
    Representation A.Coeff (Subgroup.zpowers g) (Fin A.degree → A.Coeff) :=
  A.rep.comp (Subgroup.zpowers g).subtype

/-- The cyclic action needed for singular vanishing is genuinely projective. -/
theorem cyclicRep_projective [Finite G] (g : G) :
    Module.Projective (MonoidAlgebra A.Coeff (Subgroup.zpowers g))
      (A.cyclicRep g).asModule :=
  A.projective_subgroup (Subgroup.zpowers g)

/-- The complex character is the image of the integral cyclic trace. Vanishing
must be proved before applying the complex embedding, not after reduction. -/
theorem character_eq_map_cyclic_trace (g : G) :
    A.complexRep.character g = A.complex
      (LinearMap.trace A.Coeff _ (A.cyclicRep g ⟨g, Subgroup.mem_zpowers g⟩)) := by
  exact mapCoefficients_trace A.complex A.rep g

end Representation.CyclicDefect.ProjectivePairing.IntegralLift
