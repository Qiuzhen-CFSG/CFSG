private theorem decode_check (i : Fin 541) : decode 45 rowData[i.val]! = Packed.matrix 45 data[i.val]! := by
  rw [←Packed.decode_rows]
  ext r c
  change bit (rowData[i.val]!)[r.val]! c.val=bit (Packed.rows 45 data[i.val]!)[r.val]! c.val
  simpa [Packed.rows] using congrArg (fun a => bit a c.val) (rows_check i r).symm

