/-- The explicit spectral operator belongs to every algebra containing
the two literal generator matrices, in this orientation. -/
theorem spectral_true_mem
    (A : Subalgebra (ZMod 2) (Matrix (Fin 45) (Fin 45) (ZMod 2)))
    (hA : ∀ i : Fin 2, generator true i ∈ A) : spectral true ∈ A := by
  have hm (i : ℕ) (hi : i<541) : Packed.matrix 45 data[i]! ∈ A := by
    induction i using Nat.strong_induction_on with
    | h i ih =>
      by_cases hz : i=0
      · subst i; rw [root_check]; exact A.one_mem
      · obtain ⟨hp,hg⟩ := indices ⟨i,hi⟩ hz
        have he : Packed.matrix 45 data[parents[i]!]! * generator true ⟨labels[i]!,hg⟩=
            Packed.matrix 45 data[i]! := by
          rw [←decode_check ⟨i,hi⟩,←decode_check ⟨parents[i]!,hp.trans hi⟩]
          exact decode_mul 45 _ _ _ (product_check ⟨i,hi⟩ hz)
        rw [←he]
        exact A.mul_mem (ih _ hp (hp.trans hi)) (hA _)
  have he : (∑ i : Fin 541, bit coefficients i.val • Packed.matrix 45 data[i.val]!)=spectral true := by
    rw [←final_check]
    ext r c
    simp only [Matrix.sum_apply,Matrix.smul_apply,smul_eq_mul,Packed.matrix]
    rw [Fin.sum_univ_eq_sum_range (fun i => bit coefficients i * bit data[i]! (45*r.val+c.val)),
      ←bit_rowProduct,sum_check]
  rw [←he]
  exact A.sum_mem fun i _ => A.smul_mem (hm i.val i.isLt) _
end BinaryEndpointInduction
