module
public import Theory.Representation.BinaryEndpointInduction.Coordinates
public import Mathlib.LinearAlgebra.Matrix.ToLin

/-!
# Coordinate block selections and parabolic displacement matrices

The mask space consists exactly of vectors supported on the selected
spectral blocks. The displayed four matrices use the same changed basis
as the two group generators; their group interpretation is established
separately by the induction transport.
-/
@[expose] public section
namespace BinaryEndpointInduction
open Thompson.BinaryMatrix

/-- Index of the literal spectral coordinate block. -/
def coordinateBlock (j : Fin 45) : Fin 5 :=
  if j.val<1 then 0 else if j.val<5 then 1 else if j.val<11 then 2 else
    if j.val<25 then 3 else 4

/-- The coordinate subspace selected by five binary mask bits. -/
def maskSubspace (mask : Fin 32) : Submodule (ZMod 2) (Fin 45 → ZMod 2) where
  carrier := {x | ∀ j, mask.val.testBit (coordinateBlock j).val=false → x j=0}
  zero_mem' := by simp
  add_mem' := by intro x y hx hy j hj; simp only [Pi.add_apply,hx j hj,hy j hj,add_zero]
  smul_mem' := by intro c x hx j hj; simp only [Pi.smul_apply,hx j hj,smul_zero]

