private def escapeGenerator (d : Bool) (m : Fin 32) : Fin 2 :=
  ⟨((escapeData d)[m.val]!)[0]! % 2, Nat.mod_lt _ (by decide)⟩
private def escapeRow (d : Bool) (m : Fin 32) : Fin 45 :=
  ⟨((escapeData d)[m.val]!)[1]! % 45, Nat.mod_lt _ (by decide)⟩
private def escapeCol (d : Bool) (m : Fin 32) : Fin 45 :=
  ⟨((escapeData d)[m.val]!)[2]! % 45, Nat.mod_lt _ (by decide)⟩
private def minorGenerator (d : Bool) (m : Fin 32) (i : Fin 8) : Fin 4 :=
  ⟨(((rowData d)[m.val]!)[i.val]!)[0]! % 4, Nat.mod_lt _ (by decide)⟩
private def minorRow (d : Bool) (m : Fin 32) (i : Fin 8) : Fin 45 :=
  ⟨(((rowData d)[m.val]!)[i.val]!)[1]! % 45, Nat.mod_lt _ (by decide)⟩
private def minorCol (d : Bool) (m : Fin 32) (i : Fin 8) : Fin 45 :=
  ⟨((colData d)[m.val]!)[i.val]! % 45, Nat.mod_lt _ (by decide)⟩

private theorem kind_check : ∀ d : Bool, ∀ m : Fin 32, (kind d)[m.val]! ≤ 2 := by
  decide +kernel

private theorem survivor_check : ∀ d : Bool, ∀ m : Fin 32, (kind d)[m.val]! =0 →
    m.val=31 ∨ m.val=(if d then 29 else 27) := by
  decide +kernel

private theorem escape_check : ∀ d : Bool, ∀ m : Fin 32, (kind d)[m.val]! =1 →
    m.val.testBit (coordinateBlock (escapeRow d m)).val=true ∧
    m.val.testBit (coordinateBlock (escapeCol d m)).val=false ∧
    adaptedGenerator d (escapeGenerator d m) (escapeRow d m) (escapeCol d m)=1 := by
  decide +kernel

private theorem minor_packed_check : ∀ d : Bool, ∀ m : Fin 32, (kind d)[m.val]! =2 →
    (∀ j : Fin 8, m.val.testBit (coordinateBlock (minorCol d m j)).val=false) ∧
    (∀ i j : Fin 8, ((minorData d)[m.val]!)[i.val]!.testBit j.val=
      ((((adaptedParabolicRows d)[(minorGenerator d m i).val]!)[(minorRow d m i).val]!
        ^^^ 2^(minorRow d m i).val).testBit (minorCol d m j).val)) ∧
    (∀ i : Fin 8, rowProduct ((minorData d)[m.val]!)[i.val]!
      (inverseData d)[m.val]! 8=2^i.val) := by
  decide +kernel

private theorem minor_check (d : Bool) (m : Fin 32) (hm : (kind d)[m.val]! =2) :
    (∀ j : Fin 8, m.val.testBit (coordinateBlock (minorCol d m j)).val=false) ∧
    (∀ i j : Fin 8, decode 8 (minorData d)[m.val]! i j=
      adaptedParabolic d (minorGenerator d m i) (minorRow d m i) (minorCol d m j) -
        (if minorCol d m j=minorRow d m i then (1 : ZMod 2) else 0)) ∧
    (∀ i : Fin 8, rowProduct ((minorData d)[m.val]!)[i.val]!
      (inverseData d)[m.val]! 8=2^i.val) := by
  obtain ⟨hc,he,hi⟩ := minor_packed_check d m hm
  refine ⟨hc,?_,hi⟩
  intro i j
  have hh := congrArg (fun b : Bool => if b then (1 : ZMod 2) else 0) (he i j)
  change bit ((minorData d)[m.val]!)[i.val]! j.val=
    bit ((((adaptedParabolicRows d)[(minorGenerator d m i).val]!)[(minorRow d m i).val]!
      ^^^ 2^(minorRow d m i).val)) (minorCol d m j).val at hh
  rw [bit_xor] at hh
  have hb : bit (2^(minorRow d m i).val) (minorCol d m j).val=
      (if minorCol d m j=minorRow d m i then (1 : ZMod 2) else 0) := by
    simp [bit,Nat.testBit_two_pow,Fin.ext_iff,eq_comm]
  change bit ((minorData d)[m.val]!)[i.val]! j.val=
    bit (((adaptedParabolicRows d)[(minorGenerator d m i).val]!)[(minorRow d m i).val]!)
      (minorCol d m j).val - _
  rw [ZModModule.sub_eq_add,←hb]
  exact hh

/-- A quotient generated by these coordinates with displacement dimension
at most seven has only the specified nonzero block kernel, or the full kernel. -/
theorem mask_eq_of_small_displacement
    {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]
    (dual : Bool) (mask : Fin 32) (f : (Fin 45 → ZMod 2) →ₗ[ZMod 2] W)
    (hker : f.ker=maskSubspace mask)
    (hinv : ∀ k : Fin 2, ∀ x, x ∈ f.ker → x ᵥ* adaptedGenerator dual k ∈ f.ker)
    (D : Submodule (ZMod 2) W) [FiniteDimensional (ZMod 2) D]
    (hdim : Module.finrank (ZMod 2) D ≤ 7)
    (hmem : ∀ k : Fin 4, ∀ i : Fin 45,
      f (adaptedParabolic dual k i-Pi.single i 1) ∈ D) :
    mask.val=31 ∨ mask.val=(if dual then 29 else 27) := by
  have hk := kind_check dual mask
  by_cases h0 : (kind dual)[mask.val]! =0
  · exact survivor_check dual mask h0
  by_cases h1 : (kind dual)[mask.val]! =1
  · obtain ⟨hr,hc,he⟩ := escape_check dual mask h1
    have hx : Pi.single (escapeRow dual mask) (1 : ZMod 2) ∈ maskSubspace mask := by
      intro j hj
      by_cases h : j=escapeRow dual mask
      · subst j; simp only [hr] at hj; contradiction
      · simp [h]
    rw [←hker] at hx
    have hy := hinv (escapeGenerator dual mask) _ hx
    rw [hker] at hy
    have hz := hy (escapeCol dual mask) hc
    rw [Matrix.single_one_vecMul] at hz
    exact False.elim (one_ne_zero (he.symm.trans hz))
  · have h2 : (kind dual)[mask.val]! =2 := by omega
    obtain ⟨hc,he,hi⟩ := minor_check dual mask h2
    let v : Matrix (Fin 8) (Fin 45) (ZMod 2) := fun i =>
      adaptedParabolic dual (minorGenerator dual mask i) (minorRow dual mask i) -
        Pi.single (minorRow dual mask i) 1
    have hv : v.submatrix id (minorCol dual mask)=decode 8 (minorData dual)[mask.val]! := by
      ext i j
      change adaptedParabolic dual (minorGenerator dual mask i) (minorRow dual mask i) (minorCol dual mask j) -
        (Pi.single (minorRow dual mask i) (1 : ZMod 2) : Fin 45 → ZMod 2) (minorCol dual mask j)=_
      simpa only [Pi.single_apply] using (he i j).symm
    have hbound := card_le_finrank_of_quotient_minor f D v (minorCol dual mask)
      (decode 8 (inverseData dual)[mask.val]!)
      (by rw [hv]; exact decode_mul_one 8 _ _ hi)
      (by intro x hx j; have hx' : x ∈ f.ker := hx; rw [hker] at hx'; exact hx' _ (hc j))
      (fun i => hmem _ _)
    simp only [Fintype.card_fin] at hbound
    omega

end BinaryEndpointInduction
