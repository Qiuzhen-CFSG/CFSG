/-!
# Literal coset coordinates for the binary endpoint modules

The fifteen representatives and six actors retain the exact matrix marking
of the endpoint induction data. Actors zero and one are the generating pair;
the last four fix the row vector e0. All module matrices use right action on
rows. Flag false uses the lower-right Levi block D; flag true uses D inverse
transpose. Their converted left actions are respectively dual and natural.
The transition and module assertions are proved in CosetTransitions.

Source context: Aschbacher--Smith 15.3.23, binary-four carrier.
Reproduction: Scratch/DirectBinaryThreeAmbient/FourInducedBoundary.
-/
@[expose] public section
open Matrix
open scoped MatrixGroups
namespace BinaryEndpointInduction
open Thompson.BinaryMatrix

def cosetRepresentativeRows : Array (Array ℕ) :=
  #[#[1, 2, 4, 8], #[2, 4, 8, 1], #[6, 4, 8, 1], #[4, 8, 1, 2], #[12, 8, 1, 2], #[8, 1, 2, 4], #[9, 1, 2, 4], #[3, 2, 4, 8], #[7, 6, 4, 8], #[14, 12, 8, 1], #[10, 12, 8, 1], #[13, 9, 1, 2], #[5, 9, 1, 2], #[11, 3, 2, 4], #[15, 7, 6, 4]]

theorem cosetRepresentative_det : ∀ i : Fin 15,
    (decode 4 (cosetRepresentativeRows[i.val]!)).det = 1 := by decide +kernel

/-- The original ordered fifteen right-coset representatives. -/
def cosetRepresentative (i : Fin 15) : SL(4, ZMod 2) :=
  ⟨decode 4 (cosetRepresentativeRows[i.val]!), cosetRepresentative_det i⟩

def parabolicGeneratorRows : Array (Array ℕ) :=
  #[#[1, 6, 4, 8], #[1, 2, 12, 8], #[1, 2, 4, 9], #[1, 2, 4, 11]]

theorem parabolicGenerator_det : ∀ i : Fin 4,
    (decode 4 (parabolicGeneratorRows[i.val]!)).det = 1 := by decide +kernel

/-- The four original parabolic actors in their exact order. -/
def parabolicGenerator (i : Fin 4) : SL(4, ZMod 2) :=
  ⟨decode 4 (parabolicGeneratorRows[i.val]!), parabolicGenerator_det i⟩

/-- First the two group generators, then the four parabolic actors. -/
def cosetActor (a : Fin 6) : SL(4, ZMod 2) :=
  ![transvectionGenerator, cycleGenerator, parabolicGenerator 0,
    parabolicGenerator 1, parabolicGenerator 2, parabolicGenerator 3] a

