private theorem forall_chunks {n : ℕ} (P : Fin n → Prop)
    (h : ∀ b : Fin ((n+31)/32), ∀ j : Fin 32,
      ∀ hj : 32*b.val+j.val<n, P ⟨32*b.val+j.val,hj⟩) : ∀ i,P i := by
  intro i
  have hb : i.val/32<(n+31)/32 := by omega
  have hj : 32*(i.val/32)+i.val%32<n := by omega
  have he : (⟨32*(i.val/32)+i.val%32,hj⟩ : Fin n)=i := by apply Fin.ext; dsimp; omega
  exact he ▸ h ⟨i.val/32,hb⟩ ⟨i.val%32,Nat.mod_lt _ (by decide)⟩ hj

