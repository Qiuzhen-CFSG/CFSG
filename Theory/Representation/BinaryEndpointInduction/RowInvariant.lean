module
public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.LinearAlgebra.Matrix.ToLin

/-!
# Row invariance under the generated matrix algebra

Matrices preserving a row subspace form a subalgebra. Consequently the
checked algebra word for the spectral operator preserves every subspace
preserved by the literal generators.
-/
public section
namespace BinaryEndpointInduction
open Matrix

/-- A matrix in the algebra generated by row stabilizers also preserves
the same row subspace. -/
theorem row_invariant_of_mem_adjoin
    {F ι κ : Type*} [Field F] [Fintype ι] [DecidableEq ι]
    (g : κ → Matrix ι ι F) (U : Submodule F (ι → F))
    (hU : ∀ k x, x ∈ U → x ᵥ* g k ∈ U)
    {M : Matrix ι ι F} (hM : M ∈ Algebra.adjoin F (Set.range g)) :
    ∀ x, x ∈ U → x ᵥ* M ∈ U := by
  let A : Subalgebra F (Matrix ι ι F) :=
    { carrier := {M | ∀ x, x ∈ U → x ᵥ* M ∈ U}
      zero_mem' := by intro x _; rw [vecMul_zero]; exact U.zero_mem
      add_mem' := by
        intro M N hM hN x hx
        rw [vecMul_add]
        exact U.add_mem (hM x hx) (hN x hx)
      one_mem' := by intro x hx; rwa [vecMul_one]
      mul_mem' := by
        intro M N hM hN x hx
        rw [←vecMul_vecMul]
        exact hN _ (hM x hx)
      algebraMap_mem' := by
        intro c x hx
        rw [Algebra.algebraMap_eq_smul_one]
        rw [vecMul_smul, vecMul_one]
        exact U.smul_mem c hx }
  have ha : Algebra.adjoin F (Set.range g) ≤ A := by
    apply Algebra.adjoin_le
    rintro M ⟨k,rfl⟩
    exact hU k
  exact ha hM

end BinaryEndpointInduction
