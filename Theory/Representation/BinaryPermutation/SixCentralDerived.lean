module
public import Theory.SpecificGroups.SymmetricSix.BinaryFlags.NaturalGeometry
public import Mathlib.GroupTheory.GroupAction.MultipleTransitivity
public import Theory.GroupTheory.ClassTwoCommutator
public import Theory.GroupTheory.Commutator.CentralExtensionPairing

/-!
# Derived order in a central cover of the natural binary four-module

The natural six-letter module is generated by the duads through one fixed
letter. Alternating-six triple transitivity makes the commutators of lifts
of any two distinct nonzero generators equal a single element when the
alternating actor fixes the derived subgroup. Centrality of the quotient
kernel makes commutator rows homomorphisms, so those generator commutators
contain the entire derived subgroup. Their squares are trivial because the
quotient is binary. The derived subgroup therefore has order at most two.

The actor is retained above its six-letter image: no splitting is required.
Only the alternating image and its fixation of the derived subgroup matter.
The central kernel can be smaller than the whole center, and the proof also
establishes finiteness of the derived subgroup for an infinite central cover.

Source: Meierfrankenfeld--Stellmacher (1993), (3.10)(i), used in (5.12)(2),
printed p.926, specialized to the marked binary natural four-module.
-/

public noncomputable section
open Subgroup
open scoped commutatorElement
namespace BinaryPermutation.SixCentralDerived
open Theory.SpecificGroups.SymmetricSix.BinaryFlags.NaturalGeometry

private theorem pair_triangle (i j : Fin 6) :
    pairVector 0 i+pairVector 0 j=pairVector i j := by
  apply Subtype.ext
  change (constants (Fin 6)).mkQ _+(constants (Fin 6)).mkQ _=(constants (Fin 6)).mkQ _
  rw [←map_add]
  congr 1
  ext k
  simp only [Pi.add_apply,Pi.single_apply]
  split_ifs <;> decide

private theorem binary_double (v : natural (Fin 6)) : v+v=0 := by
  calc
    v+v=(1:ZMod 2) • v+1 • v := by simp
    _=((1:ZMod 2)+1) • v := (add_smul _ _ _).symm
    _=0 := by rw [show (1:ZMod 2)+1=0 by decide,zero_smul]

private theorem pair_zero : pairVector 0 0=0 := by
  have hh := pair_triangle (0:Fin 6) 0
  have hz : pairVector 0 0+pairVector 0 0=0 := binary_double _
  exact hh.symm.trans hz

private theorem star_generates :
    closure (Set.range (fun i : Fin 6 => Multiplicative.ofAdd (pairVector 0 i)))=⊤ := by
  apply top_unique
  intro v _
  rcases vector_cases v.toAdd with hv | ⟨d,hd⟩
  · have hv1 : v=1 := hv
    rw [hv1]
    exact one_mem _
  · have hp := (closure (Set.range (fun i : Fin 6 => Multiplicative.ofAdd (pairVector 0 i)))).mul_mem
      (subset_closure ⟨d.val.1,rfl⟩) (subset_closure ⟨d.val.2,rfl⟩)
    have he : v=Multiplicative.ofAdd (pairVector 0 d.val.1)*Multiplicative.ofAdd (pairVector 0 d.val.2) := by
      apply Multiplicative.toAdd.injective
      change v.toAdd=pairVector 0 d.val.1+pairVector 0 d.val.2
      rw [pair_triangle]
      exact hd
    rwa [he]

private theorem star_pair_transitive {i j : Fin 6} (hi : i≠0) (hj : j≠0) (hij : i≠j) :
    ∃ g : alternatingGroup (Fin 6), g.val 0=0 ∧ g.val 1=i ∧ g.val 2=j := by
  let b : Fin 3 ↪ Fin 6 := ⟨![0,1,2],by decide⟩
  let c : Fin 3 ↪ Fin 6 := ⟨![0,i,j],by
    intro a b he
    fin_cases a <;> fin_cases b <;> simp_all⟩
  have := alternatingGroup.isMultiplyPretransitive (Fin 6)
  let : MulAction.IsMultiplyPretransitive (alternatingGroup (Fin 6)) (Fin 6) 3 :=
    MulAction.isMultiplyPretransitive_of_le (n:=Nat.card (Fin 6)-2) (by simp) (by simp)
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq (alternatingGroup (Fin 6)) b c
  refine ⟨g,?_,?_,?_⟩
  · exact congrArg (fun k : Fin 3 ↪ Fin 6 => k 0) hg
  · exact congrArg (fun k : Fin 3 ↪ Fin 6 => k 1) hg
  · exact congrArg (fun k : Fin 3 ↪ Fin 6 => k 2) hg

private theorem derived_le_of_lift_generators
    {P Q ι : Type*} [Group P] [Group Q] (q : P→*Q)
    (hker : q.ker≤center P) (hd : _root_.commutator P≤center P)
    (v : ι→P) (hgen : closure (Set.range (fun i => q (v i)))=⊤)
    (C : Subgroup P) (hpair : ∀ i j, ⁅v i,v j⁆∈C) : _root_.commutator P≤C := by
  have htop (H : Subgroup P) (hk : q.ker≤H) (hv : ∀ i,v i∈H) : H=⊤ := by
    have hm : H.map q=⊤ := by
      apply top_unique
      rw [←hgen]
      exact (closure_le _).mpr (by rintro _ ⟨i,rfl⟩; exact mem_map_of_mem q (hv i))
    rw [←comap_map_eq_self hk,hm,comap_top]
  have row (x : P) (hx : ∀ i, ⁅x,v i⁆∈C) (y : P) : ⁅x,y⁆∈C := by
    have ht : C.comap (ClassTwo.commutatorHom hd x)=⊤ := by
      apply htop
      · intro n hn
        change ⁅x,n⁆∈C
        rw [commutatorElement_eq_one_iff_mul_comm.mpr (mem_center_iff.mp (hker hn) x)]
        exact C.one_mem
      · exact hx
    exact show y∈C.comap (ClassTwo.commutatorHom hd x) from ht ▸ mem_top y
  apply commutator_le.mpr
  intro x _ y _
  apply row x _ y
  intro i
  have hi := C.inv_mem (row (v i) (hpair i) x)
  simpa only [commutatorElement_inv] using hi

/-- A central extension of the natural binary four-module has at most two
commutators when the alternating actor fixes its derived subgroup. -/
theorem card_derived_le_two
    {P A : Type*} [Group P] [Group A]
    (q : P→*Multiplicative (natural (Fin 6))) (hq : Function.Surjective q)
    (hker : q.ker≤center P) (ρ : A→*MulAut P) (π : A→*Equiv.Perm (Fin 6))
    (hπ : alternatingGroup (Fin 6)≤π.range)
    (haction : ∀ a x, (q (ρ a x)).toAdd=naturalRepresentation (Fin 6) (π a) (q x).toAdd)
    (hfix : ∀ a, π a∈alternatingGroup (Fin 6) →
      ∀ z∈_root_.commutator P, ρ a z=z) : Nat.card (_root_.commutator P)≤2 := by
  have hd : _root_.commutator P≤center P := by
    apply le_trans _ hker
    apply commutator_le.mpr
    intro x _ y _
    rw [MonoidHom.mem_ker,map_commutatorElement]
    exact commutatorElement_eq_one_iff_mul_comm.mpr (mul_comm _ _)
  obtain ⟨v,hv⟩ := Classical.axiomOfChoice
    (fun i : Fin 6 => hq (Multiplicative.ofAdd (pairVector 0 i)))
  have hgen : closure (Set.range (fun i => q (v i)))=⊤ := by
    simpa only [hv] using star_generates
  let z := ⁅v 1,v 2⁆
  have hzsq : z^2=1 := by
    have hsq : (v 2)^2∈center P := hker (by
      rw [MonoidHom.mem_ker,map_pow,hv]
      rw [pow_two]
      change Multiplicative.ofAdd (pairVector 0 2+pairVector 0 2)=1
      rw [binary_double]
      rfl)
    have hp := map_pow (ClassTwo.commutatorHom hd (v 1)) (v 2) 2
    change ⁅v 1,(v 2)^2⁆=z^2 at hp
    rw [←hp]
    exact commutatorElement_eq_one_iff_mul_comm.mpr (mem_center_iff.mp hsq _)
  have hpair (i j : Fin 6) : ⁅v i,v j⁆∈zpowers z := by
    by_cases hi : i=0
    · subst i
      have hc : v 0∈center P := hker (by rw [MonoidHom.mem_ker,hv,pair_zero]; rfl)
      rw [commutatorElement_eq_one_iff_mul_comm.mpr (mem_center_iff.mp hc _).symm]
      exact one_mem _
    by_cases hj : j=0
    · subst j
      have hc : v 0∈center P := hker (by rw [MonoidHom.mem_ker,hv,pair_zero]; rfl)
      rw [commutatorElement_eq_one_iff_mul_comm.mpr (mem_center_iff.mp hc _)]
      exact one_mem _
    by_cases hij : i=j
    · subst j
      simp
    obtain ⟨g,hg0,hg1,hg2⟩ := star_pair_transitive hi hj hij
    obtain ⟨a,ha⟩ := hπ g.property
    have hq1 : q (ρ a (v 1))=q (v i) := by
      apply Multiplicative.toAdd.injective
      rw [haction,hv,hv,ha]
      change naturalRepresentation (Fin 6) g.val (pairVector 0 1)=pairVector 0 i
      rw [pairVector_map,hg0,hg1]
    have hq2 : q (ρ a (v 2))=q (v j) := by
      apply Multiplicative.toAdd.injective
      rw [haction,hv,hv,ha]
      change naturalRepresentation (Fin 6) g.val (pairVector 0 2)=pairVector 0 j
      rw [pairVector_map,hg0,hg2]
    have he := CentralExtension.commutator_eq_of_image_eq q hker hq1 hq2
    rw [←map_commutatorElement] at he
    have hzfix : ρ a z=z := hfix a (ha ▸ g.property)
      z (commutator_mem_commutator (mem_top _) (mem_top _))
    rw [hzfix] at he
    rw [←he]
    exact mem_zpowers z
  have hle := derived_le_of_lift_generators q hker hd v hgen (zpowers z) hpair
  let : Finite (zpowers z) := Finite.of_equiv (Fin (orderOf z))
    (finEquivZPowers (isOfFinOrder_iff_pow_eq_one.mpr ⟨2,by decide,hzsq⟩))
  apply (card_le_of_le hle).trans
  rw [Nat.card_zpowers]
  exact orderOf_le_of_pow_eq_one (by decide : 0<2) hzsq
end BinaryPermutation.SixCentralDerived
