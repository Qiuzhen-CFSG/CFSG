module
public import Theory.Representation.BinaryPermutation.TerminalOrthogonal.PairedBorel.Elementary

/-!
# Conjugating the split elementary eight-subgroup in the paired model

In `(S₅ × S₅) ⋊ C₂`, a swapping involution `(a, a⁻¹)swap` is conjugated to
the literal interchange by `base (1, a)`. Every element of an abelian subgroup
containing that interchange then has equal base coordinates. The source
splitting clause ensures those coordinates belong to A₅.

The first coordinate is consequently a homomorphism to A₅ with two-group
image. Sylow conjugacy places that image in the Klein four generated by the
specified double transpositions. Simultaneous conjugation of both factors
fixes the interchange and places the original subgroup in `elementary`.
Both groups have order eight, so containment is equality. The final theorem
retains the same conjugator on the literal image of an ambient Sylow subgroup.

The splitting hypothesis is essential: a diagonal Klein four in S₅ containing
odd permutations, together with the interchange, also gives an elementary
eight-subgroup, but its base intersection cannot be conjugated into A₅ × A₅.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
G.11.2(12), printed p.364/PDF p.375, and the paired Borel calculation in
12.8.13(7), printed p.856/PDF p.873. Coordinate transport into the faithful
terminal quotient is supplied by the source consumer's assembly.
-/

@[expose] public section
open Subgroup
open scoped IsMulCommutative Pointwise
namespace BinaryPermutation.TerminalOrthogonal.PairedBorel
open BinaryPermutation.CubicFixedSpace.Five

private lemma switch_diagonal (c : C2) (a : S5) : switch S5 c (a, a) = (a, a) := by
  by_cases h : c = 1 <;> simp [switch, h]

/-- Normalize the specified swapping involution by an explicit base element. -/
lemma normalize_swapping_involution (x : Model) (hx : x ^ 2 = 1)
    (hs : x.right ≠ 1) :
    MulAut.conj (base (1, x.left.1)) x = (interchange : Model) := by
  have hr : x.right = Multiplicative.ofAdd 1 := by
    have h : ∀ c : C2, c ≠ 1 → c = Multiplicative.ofAdd 1 := by decide
    exact h x.right hs
  have hab : x.left.1 * x.left.2 = 1 := by
    have h := congrArg (fun g : Model => g.left.1) hx
    simpa [pow_two, SemidirectProduct.mul_left, hr, switch_other] using h
  apply SemidirectProduct.ext
  · simp only [MulAut.conj_apply, SemidirectProduct.mul_left,
      SemidirectProduct.inv_left, SemidirectProduct.mul_right, base, interchange,
      SemidirectProduct.left_inl, SemidirectProduct.right_inl,
      SemidirectProduct.left_inr, inv_one, one_mul, map_one, MulAut.one_apply]
    simp [hr, switch]
    apply Prod.ext <;> simp [hab]
  · simp [MulAut.conj_apply, base, interchange, hr]

private lemma extension_even (g : Model)
    (hg : g ∈ pairedInclusion.range ⊔ Subgroup.zpowers (interchange : Model)) :
    g.left.1 ∈ A5 ∧ g.left.2 ∈ A5 := by
  have hle : pairedInclusion.range ⊔ Subgroup.zpowers (interchange : Model) ≤
      (swappedMap A5.subtype).range := by
    apply sup_le
    · rintro _ ⟨a, rfl⟩
      exact ⟨base a, rfl⟩
    · apply Subgroup.zpowers_le.mpr
      exact ⟨interchange, rfl⟩
  obtain ⟨a, rfl⟩ := hle hg
  exact ⟨a.left.1.property, a.left.2.property⟩

private lemma commuting_interchange_diagonal (g : Model)
    (h : g * interchange = interchange * g) : g.left.1 = g.left.2 := by
  have hf := congrArg (fun z : Model => z.left.1) h
  simpa [SemidirectProduct.mul_left, interchange, switch_other] using hf

private def diagonalProjection (Y : Subgroup Model)
    (hd : ∀ y ∈ Y, y.left.1 = y.left.2)
    (he : ∀ y ∈ Y, y.left.1 ∈ A5) : Y →* A5 where
  toFun y := ⟨y.val.left.1, he y y.property⟩
  map_one' := rfl
  map_mul' a b := by
    apply Subtype.ext
    change (a.val.left * switch S5 a.val.right b.val.left).1 = a.val.left.1 * b.val.left.1
    have hb : b.val.left = (b.val.left.1, b.val.left.1) := Prod.ext rfl (hd b b.property).symm
    rw [hb, switch_diagonal]
    rfl

private abbrev Square := Multiplicative (Fin 2 → ZMod 2)
private def kleinMap : Square →* A5 where
  toFun a := first ^ (a.toAdd 0).val * second ^ (a.toAdd 1).val
  map_one' := by decide +kernel
  map_mul' := by decide +kernel

private lemma kleinMap_injective : Function.Injective kleinMap := by decide +kernel

private lemma kleinMap_card : Nat.card kleinMap.range = 4 := by
  rw [← Nat.card_congr (MonoidHom.ofInjective kleinMap_injective).toEquiv]
  norm_num [Nat.card_eq_fintype_card]

private noncomputable def kleinSylow : Sylow 2 A5 := Sylow.ofCard kleinMap.range (by
  rw [kleinMap_card, nat_card_alternatingGroup]
  norm_num [Nat.factorial]
  rw [show 60 = 2 ^ 2 * 15 by decide, Nat.factorization_mul (by decide) (by decide),
    Finsupp.add_apply, Nat.prime_two.factorization_pow, Finsupp.single_eq_same,
    Nat.factorization_eq_zero_of_not_dvd (by decide : ¬ 2 ∣ 15)]
  rfl)

private lemma diagonal_klein_mem (a : A5) (ha : a ∈ kleinMap.range) (c : C2) :
    (⟨(a.val, a.val), c⟩ : Model) ∈ elementary := by
  obtain ⟨s, rfl⟩ := ha
  refine ⟨Multiplicative.ofAdd ![s.toAdd 0, s.toAdd 1, c.toAdd], ?_⟩
  apply SemidirectProduct.ext
  · rfl
  · rfl

private lemma diagonal_conj (d a : S5) (c : C2) :
    MulAut.conj (base (d, d)) (⟨(a, a), c⟩ : Model) =
      ⟨(d * a * d⁻¹, d * a * d⁻¹), c⟩ := by
  apply SemidirectProduct.ext
  · simp [MulAut.conj_apply, base, SemidirectProduct.mul_left,
      SemidirectProduct.inv_left, switch_diagonal]
  · simp [MulAut.conj_apply, base]

private lemma normalized_conjugacy (Y : Subgroup Model) [IsElementaryAbelian 2 Y]
    (hcard : Nat.card Y = 8) (hs : (interchange : Model) ∈ Y)
    (hext : Y ≤ pairedInclusion.range ⊔ Subgroup.zpowers (interchange : Model)) :
    ∃ d : A5, Y.map (MulAut.conj (base (d.val, d.val))).toMonoidHom = elementary := by
  have hd : ∀ y ∈ Y, y.left.1 = y.left.2 := by
    intro y hy
    apply commuting_interchange_diagonal
    exact congrArg Subtype.val (mul_comm (⟨y, hy⟩ : Y) ⟨interchange, hs⟩)
  have he : ∀ y ∈ Y, y.left.1 ∈ A5 := fun y hy => (extension_even y (hext hy)).1
  let f := diagonalProjection Y hd he
  have hf : IsPGroup 2 f.range :=
    (IsElementaryAbelian.isPGroup 2 Y).of_surjective f.rangeRestrict f.rangeRestrict_surjective
  obtain ⟨P, hP⟩ := hf.exists_le_sylow
  obtain ⟨d, hdP⟩ := MulAction.exists_smul_eq A5 P kleinSylow
  have hmap : (P : Subgroup A5).map (MulAut.conj d).toMonoidHom = kleinMap.range := by
    have h := congrArg (fun S : Sylow 2 A5 => (S : Subgroup A5)) hdP
    rwa [Sylow.coe_subgroup_smul, Subgroup.pointwise_smul_def] at h
  refine ⟨d, Subgroup.eq_of_le_of_card_ge ?_ ?_⟩
  · rintro _ ⟨y, hy, rfl⟩
    have hm : MulAut.conj d (f ⟨y, hy⟩) ∈ kleinMap.range := by
      rw [← hmap]
      exact ⟨f ⟨y, hy⟩, hP ⟨⟨y, hy⟩, rfl⟩, rfl⟩
    have hform : y = ⟨(y.left.1, y.left.1), y.right⟩ :=
      SemidirectProduct.ext (Prod.ext rfl (hd y hy).symm) rfl
    change MulAut.conj (base (d.val, d.val)) y ∈ elementary
    rw [hform, diagonal_conj]
    exact diagonal_klein_mem (MulAut.conj d (f ⟨y, hy⟩)) hm y.right
  · rw [Subgroup.card_map_of_injective (MulAut.conj _).injective, hcard, elementary_card]

/-- The splitting clause in G.11.2(12) puts an elementary eight-subgroup,
with its specified swapping involution, in the standard paired coordinates. -/
theorem exists_elementary_conjugation (X : Subgroup Model) [IsElementaryAbelian 2 X]
    (hcard : Nat.card X = 8) (x : Model) (hx : x ∈ X) (hs : x.right ≠ 1)
    (hsplit : X ≤ pairedInclusion.range ⊔ Subgroup.zpowers x) :
    ∃ t : S5 × S5,
      X.map (MulAut.conj (base t)).toMonoidHom = elementary ∧
      MulAut.conj (base t) x = interchange := by
  let e := MulAut.conj (base (1, x.left.1))
  let Y := X.map e.toMonoidHom
  have hn : e x = interchange := normalize_swapping_involution x
    (elemPow_eq_one_of_isElementaryAbelian x hx) hs
  have : IsElementaryAbelian 2 Y := IsElementaryAbelian.map e.toMonoidHom
  have hYcard : Nat.card Y = 8 := by
    rw [Subgroup.card_map_of_injective e.injective]
    exact hcard
  have hYsplit : Y ≤ pairedInclusion.range ⊔ Subgroup.zpowers (interchange : Model) := by
    have h := Subgroup.map_mono (f := e.toMonoidHom) hsplit
    have hnormal : pairedInclusion.range.map e.toMonoidHom = pairedInclusion.range := by
      simpa only [e, MulEquiv.toMonoidHom_eq_coe] using
        (Subgroup.Normal.map_conj_eq pairedInclusion.range (base (1, x.left.1)))
    rw [Subgroup.map_sup, hnormal, MonoidHom.map_zpowers] at h
    simpa only [MulEquiv.coe_toMonoidHom, hn] using h
  obtain ⟨d, hd⟩ := normalized_conjugacy Y hYcard ⟨x, hx, hn⟩ hYsplit
  let t : S5 × S5 := (d.val, d.val) * (1, x.left.1)
  have hc : (MulAut.conj (base t)).toMonoidHom =
      (MulAut.conj (base (d.val, d.val))).toMonoidHom.comp e.toMonoidHom := by
    apply MonoidHom.ext
    intro y
    change MulAut.conj (base ((d.val, d.val) * (1, x.left.1))) y = _
    rw [map_mul, map_mul]
    rfl
  refine ⟨t, ?_, ?_⟩
  · rw [hc, ← Subgroup.map_map]
    exact hd
  · change (MulAut.conj (base t)).toMonoidHom x = _
    rw [hc, MonoidHom.comp_apply]
    change MulAut.conj (base (d.val, d.val)) (e x) = _
    rw [hn]
    change MulAut.conj (base (d.val, d.val)) (⟨(1, 1), Multiplicative.ofAdd 1⟩ : Model) = _
    rw [diagonal_conj]
    simp only [mul_one, mul_inv_cancel, interchange, SemidirectProduct.inr]
    rfl

/-- Application to the literal image of an ambient Sylow subgroup. The same
base conjugation sends the chosen involution to the interchange and places the
standard elementary group in the transported Sylow. This discharges the
standard-elementary placement premise used by the paired Borel calculation. -/
theorem exists_elementary_sylow_placement {G : Type*} [Group G]
    (Q : Sylow 2 G) (f : G →* Model)
    (X : Subgroup Model) [IsElementaryAbelian 2 X]
    (hcard : Nat.card X = 8) (x : Model) (hx : x ∈ X) (hs : x.right ≠ 1)
    (hsplit : X ≤ pairedInclusion.range ⊔ Subgroup.zpowers x)
    (hXQ : X ≤ (Q : Subgroup G).map f) :
    ∃ t : S5 × S5,
      X.map (MulAut.conj (base t)).toMonoidHom = elementary ∧
      MulAut.conj (base t) x = interchange ∧
      elementary ≤ ((Q : Subgroup G).map f).map (MulAut.conj (base t)).toMonoidHom := by
  obtain ⟨t, ht, hx'⟩ := exists_elementary_conjugation X hcard x hx hs hsplit
  exact ⟨t, ht, hx', ht ▸ Subgroup.map_mono hXQ⟩

end BinaryPermutation.TerminalOrthogonal.PairedBorel
