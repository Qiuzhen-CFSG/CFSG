module
public import Theory.SpecificGroups.SymmetricSix.BinaryFlags.CoreGeometry
public import Theory.Representation.BinaryPermutation.SixCoreOrbits

/-!
# Displacements of the six-letter syntheme radical

The cube generated by the three disjoint swaps fixes exactly the words
constant on each pair. Each such word is a sum of three displacements in
the actual five-dimensional augmentation core. A certificate checks only
the 32 core words; conjugation transports the identity to every syntheme.

The original mixed-pair application is in Chapter13 Section04
FixedCoreSource/Nonsolvable/MixedPlaneAction. This supplies the reverse
fixed-space containment in the commutator calculation of Aschbacher--Smith
13.4.15, printed p.912, refs/quasithin.pdf.
-/

@[expose] public noncomputable section
open Subgroup Representation BinaryPermutation
namespace BinaryPermutation.SixCorePlaneMovement
open Theory.SpecificGroups.SymmetricSix.BinaryFlags
abbrev W := core (Fin 6)
abbrev rho := coreRepresentation (Fin 6)
private local instance : DecidablePred (fun v : Full (Fin 6) => v ∈ core (Fin 6)) :=
  fun v => inferInstanceAs (Decidable ((augmentation (Fin 6)) v = 0))
private local instance : Fintype W :=
  Fintype.ofFinset (Finset.univ.filter fun v => v ∈ core (Fin 6)) (by simp)
private def seed (v : W) (i : Fin 3) : W :=
  match i with
  | 0 => ⟨![v.val 0,0,v.val 0,0,0,0],by rw [mem_core]; decide +revert⟩
  | 1 => ⟨![v.val 2,0,v.val 2,0,0,0],by rw [mem_core]; decide +revert⟩
  | 2 => ⟨![v.val 4,0,0,0,v.val 4,0],by rw [mem_core]; decide +revert⟩

private theorem expansion : ∀ v : W,
    rho swap01 v = v → rho swap23 v = v → rho swap45 v = v →
    v = (rho swap01 (seed v 0) - seed v 0) +
      (rho swap23 (seed v 1) - seed v 1) +
      (rho swap45 (seed v 2) - seed v 2) := by
  decide +kernel

theorem fixed_is_sum_of_displacements (v : W)
    (hv : ∀ a ∈ D, rho a v = v) :
    ∃ x y z : W, v = (rho swap01 x - x) +
      (rho swap23 y - y) + (rho swap45 z - z) :=
  ⟨seed v 0,seed v 1,seed v 2,expansion v (hv _ swap01_mem_D)
    (hv _ swap23_mem_D) (hv _ swap45_mem_D)⟩

private theorem conjugate_apply (g a : Equiv.Perm (Fin 6)) (x : W) :
    rho ((MulAut.conj g) a) (rho g x) = rho g (rho a x) := by
  simp only [MulAut.conj_apply, ←Module.End.mul_apply, ←map_mul]
  congr 2
  group

/-- The displacement expansion respects the actual conjugating permutation. -/
theorem fixed_is_sum_of_conjugate_displacements (g : Equiv.Perm (Fin 6)) (v : W)
    (hv : ∀ a ∈ D.map (MulAut.conj g).toMonoidHom, rho a v = v) :
    ∃ a ∈ D.map (MulAut.conj g).toMonoidHom,
      ∃ b ∈ D.map (MulAut.conj g).toMonoidHom,
      ∃ c ∈ D.map (MulAut.conj g).toMonoidHom,
      ∃ x y z : W, v = (rho a x - x) + (rho b y - y) + (rho c z - z) := by
  let v' := rho g⁻¹ v
  have hg : rho g v' = v := by
    change rho g (rho g⁻¹ v) = v
    rw [←Module.End.mul_apply,←map_mul,mul_inv_cancel,map_one,Module.End.one_apply]
  have hf : ∀ a ∈ D, rho a v' = v' := by
    intro a ha
    apply (rho.apply_bijective g).1
    rw [←conjugate_apply,hg]
    exact hv _ ⟨a,ha,rfl⟩
  obtain ⟨x,y,z,he⟩ := fixed_is_sum_of_displacements v' hf
  refine ⟨(MulAut.conj g) swap01,⟨swap01,swap01_mem_D,rfl⟩,
    (MulAut.conj g) swap23,⟨swap23,swap23_mem_D,rfl⟩,
    (MulAut.conj g) swap45,⟨swap45,swap45_mem_D,rfl⟩,
    rho g x,rho g y,rho g z,?_⟩
  rw [conjugate_apply,conjugate_apply,conjugate_apply,←map_sub,←map_sub,←map_sub,
    ←map_add,←map_add,←he,hg]

end BinaryPermutation.SixCorePlaneMovement
