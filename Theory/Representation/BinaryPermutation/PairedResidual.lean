module

public import Theory.SpecificGroups.AlternatingSeven.ThreeResidualLocals.ModelNormalizers
public import Theory.Representation.BinaryPermutation.SevenParabolic.Ordinary
public import Theory.Representation.BinaryPermutation.SevenMarkedAction

/-!
# The paired A₄ centralizer on the seven-letter natural module

The centralizer of the actual paired A₄ is generated by the triple
transposition. Its fixed vectors in the binary augmentation core are zero
and the six-support vector. The triple transposition itself fixes eight
of the 64 vectors, so an index-two centralizer cannot contain that actor.
The last result transports the count to an actual embedded group module,
retaining its conjugation formula.

Source: Aschbacher--Smith 15.1.25(5), printed p.1102, with §B.3 conventions.
-/

public section
open Subgroup Equiv
namespace AlternatingSeven.ThreeResidualLocals

theorem centralizer_pairedFour_iff (g : Perm7) :
    g ∈ centralizer (pairedFour : Set Perm7) ↔ g = 1 ∨ g = pairing := by
  constructor
  · intro hg
    have hn := centralizer_le_normalizer (pairedFour : Set Perm7) hg
    rw [pairedFour_normalizer_eq] at hn
    obtain ⟨i,rfl⟩ := (mem_centralizer_pairing_iff_word g).mp hn
    have hx := hg pairedThree (subset_closure (by simp))
    have hy := hg fourFlip (subset_closure (by simp))
    exact (by decide +kernel : ∀ i : Fin 12 × Fin 4,
      pairedThree * pairedWord i = pairedWord i * pairedThree →
      fourFlip * pairedWord i = pairedWord i * fourFlip →
      pairedWord i = 1 ∨ pairedWord i = pairing) i hx hy
  · rintro (rfl | rfl)
    · exact one_mem _
    · intro g hg
      exact (mem_centralizer_singleton_iff.mp (pairedFour_le_centralizer_pairing hg))

theorem pairedFour_fixed (v : BinaryPermutation.core (Fin 7))
    (hv : ∀ g ∈ pairedFour, BinaryPermutation.coreRepresentation (Fin 7) g v = v) :
    v = 0 ∨ v = BinaryPermutation.SevenParabolic.Ordinary.firstSix := by
  have hx := hv pairedThree (subset_closure (by simp))
  have hy := hv fourFlip (subset_closure (by simp))
  have h := (by decide +kernel : ∀ w : Fin 7 → ZMod 2,
    (∑ i, w i) = 0 →
    (∀ i, w (pairedThree.symm i) = w i) →
    (∀ i, w (fourFlip.symm i) = w i) →
    w = 0 ∨ w = ![1,1,1,1,1,1,0]) v.val
    ((BinaryPermutation.mem_core _ _).mp v.property)
    (fun i => congrArg (fun w : BinaryPermutation.core (Fin 7) => w.val i) hx)
    (fun i => congrArg (fun w : BinaryPermutation.core (Fin 7) => w.val i) hy)
  rcases h with h | h
  · exact Or.inl (Subtype.ext h)
  · exact Or.inr (Subtype.ext h)

private def pairFixedVector (w : Fin 3 → ZMod 2) : BinaryPermutation.core (Fin 7) :=
  ⟨![w 0,w 0,w 1,w 1,w 2,w 2,0], by
    rw [BinaryPermutation.mem_core]
    exact (by decide +kernel : ∀ w : Fin 3 → ZMod 2,
      (∑ i : Fin 7, (![w 0,w 0,w 1,w 1,w 2,w 2,0] : Fin 7 → ZMod 2) i) = 0) w⟩

private def pairFixedCoordinates :
    {v : BinaryPermutation.core (Fin 7) //
      BinaryPermutation.coreRepresentation (Fin 7) pairing v = v} ≃ (Fin 3 → ZMod 2) where
  toFun v := ![v.val.val 0,v.val.val 2,v.val.val 4]
  invFun w := ⟨pairFixedVector w, by
    apply Subtype.ext
    exact (by decide +kernel : ∀ w : Fin 3 → ZMod 2,
      (BinaryPermutation.coreRepresentation (Fin 7) pairing (pairFixedVector w)).val =
        (pairFixedVector w).val) w⟩
  left_inv v := by
    apply Subtype.ext
    apply Subtype.ext
    exact (by decide +kernel : ∀ w : Fin 7 → ZMod 2,
      (∑ i, w i) = 0 → (∀ i, w (pairing.symm i) = w i) →
      (![w 0,w 0,w 2,w 2,w 4,w 4,0] : Fin 7 → ZMod 2) = w) v.val.val
      ((BinaryPermutation.mem_core _ _).mp v.val.property)
      (fun i => congrArg (fun w : BinaryPermutation.core (Fin 7) => w.val i) v.property)
  right_inv w := by funext i; fin_cases i <;> rfl

theorem pairing_fixed_card : Nat.card {v : BinaryPermutation.core (Fin 7) //
    BinaryPermutation.coreRepresentation (Fin 7) pairing v = v} = 8 := by
  rw [Nat.card_congr pairFixedCoordinates, Nat.card_fun, Nat.card_fin, Nat.card_zmod]
  decide

variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
/-- The triple transposition has fixed index eight on the actual marked module. -/
theorem pairing_centralizer_relIndex (U : Subgroup G) (a : G)
    (e : U ≃* Multiplicative (BinaryPermutation.core (Fin 7)))
    (he : ∀ u : U,
      (e.symm (Multiplicative.ofAdd
        (BinaryPermutation.coreRepresentation (Fin 7) pairing (e u).toAdd)) : G) =
          a * (u : G) * a⁻¹) :
    (centralizer ({a} : Set G)).relIndex U = 8 := by
  let C := (centralizer ({a} : Set G)).subgroupOf U
  have hfix (u : U) : u ∈ C ↔
      BinaryPermutation.coreRepresentation (Fin 7) pairing (e u).toAdd = (e u).toAdd := by
    change (u : G) ∈ centralizer ({a} : Set G) ↔ _
    rw [mem_centralizer_singleton_iff]
    constructor
    · intro hu
      apply Multiplicative.ofAdd.injective
      apply e.symm.injective
      apply Subtype.ext
      rw [ofAdd_toAdd,e.symm_apply_apply,he,← hu,mul_inv_cancel_right]
    · intro hu
      have hh := he u
      rw [hu,ofAdd_toAdd,e.symm_apply_apply] at hh
      exact (mul_inv_eq_iff_eq_mul.mp hh.symm).symm
  let ec : C ≃ {v : BinaryPermutation.core (Fin 7) //
      BinaryPermutation.coreRepresentation (Fin 7) pairing v = v} := {
    toFun := fun u => ⟨(e u.val).toAdd,(hfix u.val).mp u.property⟩
    invFun := fun v => ⟨e.symm (Multiplicative.ofAdd v.val),(hfix _).mpr (by
      simpa only [e.apply_symm_apply,toAdd_ofAdd] using v.property)⟩
    left_inv := fun u => Subtype.ext (e.symm_apply_apply u.val)
    right_inv := fun v => Subtype.ext (congrArg Multiplicative.toAdd
      (e.apply_symm_apply (Multiplicative.ofAdd v.val))) }
  have hC : Nat.card C = 8 := (Nat.card_congr ec).trans pairing_fixed_card
  have hU : Nat.card U = 64 := by
    rw [Nat.card_congr e.toEquiv]
    change Nat.card (BinaryPermutation.core (Fin 7)) = 64
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod,
      BinaryPermutation.finrank_core]
    decide
  have hh := C.card_mul_index
  rw [hC,hU] at hh
  change C.index = 8
  omega

omit [Finite G] in
/-- The original index-two plane control rules out this actual permutation. -/
theorem not_pairing_of_plane_index_two (S W U : Subgroup G)
    (hU : U ≤ S) (hi : (centralizer (W : Set G)).relIndex S = 2)
    (a : G) (ha : a ∈ W)
    (e : U ≃* Multiplicative (BinaryPermutation.core (Fin 7))) :
    ¬ (∀ u : U,
      (e.symm (Multiplicative.ofAdd
        (BinaryPermutation.coreRepresentation (Fin 7) pairing (e u).toAdd)) : G) =
          a * (u : G) * a⁻¹) := by
  intro he
  have hS : (centralizer (W : Set G)).relIndex S ≠ 0 := by omega
  have hCU : (centralizer ({a} : Set G)).relIndex U ≤
      (centralizer (W : Set G)).relIndex U :=
    relIndex_le_of_le_left (centralizer_le (Set.singleton_subset_iff.mpr ha))
      (mt (relIndex_eq_zero_of_le_right hU) hS)
  have hUS : (centralizer (W : Set G)).relIndex U ≤
      (centralizer (W : Set G)).relIndex S :=
    relIndex_le_of_le_right hU hS
  rw [pairing_centralizer_relIndex U a e he] at hCU
  rw [hi] at hUS
  omega



open BinaryPermutation.SevenMarkedAction

omit [Finite G] in
/-- The fixed index remains eight under every coordinate conjugacy. -/
theorem triple_centralizer_relIndex (U : Subgroup G) (a : G) (g : Perm7)
    (hg : g.cycleType = {2,2,2})
    (e : U ≃* Multiplicative (BinaryPermutation.core (Fin 7)))
    (he : ∀ u : U,
      (e.symm (Multiplicative.ofAdd
        (BinaryPermutation.coreRepresentation (Fin 7) g (e u).toAdd)) : G) =
          a * (u : G) * a⁻¹) :
    (centralizer ({a} : Set G)).relIndex U = 8 := by
  obtain ⟨c,hc⟩ := isConj_iff.mp
    (Equiv.Perm.isConj_of_cycleType_eq (pairing_cycleType.trans hg.symm))
  let e' := e.trans (coreAction c⁻¹)
  apply pairing_centralizer_relIndex U a e'
  intro u
  change (e.symm ((coreAction c⁻¹).symm
    (coreAction pairing (coreAction c⁻¹ (e u)))) : G) = _
  have hh := he u
  change (e.symm (coreAction g (e u)) : G) = _ at hh
  rw [←hc,map_mul,map_mul,map_inv] at hh
  simpa only [map_inv, MulAut.inv_symm, MulAut.mul_apply, MulAut.inv_apply, inv_inv] using hh

omit [Finite G] in
/-- Every labeling of a triple transposition violates the plane index bound. -/
theorem not_triple_of_plane_index_two (S W U : Subgroup G)
    (hU : U ≤ S) (hi : (centralizer (W : Set G)).relIndex S = 2)
    (a : G) (ha : a ∈ W) (g : Perm7) (hg : g.cycleType = {2,2,2})
    (e : U ≃* Multiplicative (BinaryPermutation.core (Fin 7))) :
    ¬ (∀ u : U,
      (e.symm (Multiplicative.ofAdd
        (BinaryPermutation.coreRepresentation (Fin 7) g (e u).toAdd)) : G) =
          a * (u : G) * a⁻¹) := by
  intro he
  have hS : (centralizer (W : Set G)).relIndex S ≠ 0 := by omega
  have hCU : (centralizer ({a} : Set G)).relIndex U ≤
      (centralizer (W : Set G)).relIndex U :=
    relIndex_le_of_le_left (centralizer_le (Set.singleton_subset_iff.mpr ha))
      (mt (relIndex_eq_zero_of_le_right hU) hS)
  have hUS := relIndex_le_of_le_right hU hS
  rw [triple_centralizer_relIndex U a g hg e he] at hCU
  rw [hi] at hUS
  omega

end AlternatingSeven.ThreeResidualLocals
