module
public import Theory.Representation.BinaryPermutationNaturalStructure
public import Theory.Representation.BinaryOffender.SubspaceAction

/-!
# Scalar commutant of the binary natural A₇ module

Three explicit three-cycles fixing one letter have a common fixed line in
its augmentation core. Irreducibility propagates a commuting endomorphism's
scalar action on this line to the whole natural module. We also prove that
this module has zero fixed space and is generated by its action differences.
Only small permutations and binary scalar identities are computed.

These intrinsic facts extend prescribed component coordinates to normalizing
actors. Source application: Aschbacher–Smith, combined manuscript of 1 March
2004, B.3.3(1), printed p.84, and 13.6.22, printed p.932.
-/

@[expose] public section
open Representation Equiv
open Representation.BinaryOffender
namespace BinaryPermutation.SevenCommutant
private abbrev Ω := Fin 7
private def a : Perm Ω := swap 1 2 * swap 2 3
private def b : Perm Ω := swap 3 4 * swap 4 5
private def c : Perm Ω := swap 4 5 * swap 5 6
private def t : Perm Ω := swap 0 1 * swap 2 3
private def point : core Ω := ⟨![0,1,1,1,1,1,1], by rw [mem_core]; decide⟩
private noncomputable def e : core Ω ≃ₗ[ZMod 2] natural Ω :=
  coreEquivNatural Ω (by decide)
private noncomputable def p : natural Ω := e point

private theorem equivariant (g : Perm Ω) (v : core Ω) :
    e (coreRepresentation Ω g v) = naturalRepresentation Ω g (e v) :=
  coreEquivNatural_equivariant Ω (by decide) g v

private theorem point_ne : p ≠ 0 := by
  intro h
  have hh : point = 0 := e.injective (h.trans e.map_zero.symm)
  have := congrArg (fun w : core Ω => w.val 1) hh
  exact one_ne_zero this

private theorem even : a ∈ alternatingGroup Ω ∧ b ∈ alternatingGroup Ω ∧
    c ∈ alternatingGroup Ω ∧ t ∈ alternatingGroup Ω := by
  simp only [Equiv.Perm.mem_alternatingGroup]
  decide

private theorem fix : naturalRepresentation Ω a p = p ∧
    naturalRepresentation Ω b p = p ∧ naturalRepresentation Ω c p = p := by
  have ha : coreRepresentation Ω a point = point := by apply Subtype.ext; decide
  have hb : coreRepresentation Ω b point = point := by apply Subtype.ext; decide
  have hc : coreRepresentation Ω c point = point := by apply Subtype.ext; decide
  exact ⟨(equivariant a point).symm.trans (congrArg e ha),
    (equivariant b point).symm.trans (congrArg e hb),
    (equivariant c point).symm.trans (congrArg e hc)⟩

private theorem fixed_core (w : core Ω)
    (ha : coreRepresentation Ω a w = w)
    (hb : coreRepresentation Ω b w = w)
    (hc : coreRepresentation Ω c w = w) : w = w.val 1 • point := by
  have h12 := congrArg (fun u : core Ω => u.val 2) ha
  have h23 := congrArg (fun u : core Ω => u.val 3) ha
  have h34 := congrArg (fun u : core Ω => u.val 4) hb
  have h45 := congrArg (fun u : core Ω => u.val 5) hb
  have h56 := congrArg (fun u : core Ω => u.val 6) hc
  change w.val 1 = w.val 2 at h12
  change w.val 2 = w.val 3 at h23
  change w.val 3 = w.val 4 at h34
  change w.val 4 = w.val 5 at h45
  change w.val 5 = w.val 6 at h56
  have heq : ∀ i : Fin 7, i ≠ 0 → w.val i = w.val 1 := by
    intro i hi
    fin_cases i <;> simp_all
  have hsum := w.property
  change ∑ i : Fin 7, w.val i = 0 at hsum
  simp only [Fin.sum_univ_succ] at hsum
  change w.val 0 + (w.val 1 + (w.val 2 + (w.val 3 + (w.val 4 +
    (w.val 5 + (w.val 6 + 0)))))) = 0 at hsum
  have h0 : w.val 0 = 0 := by
    have hh : ∀ x y : ZMod 2, x + (y + (y + (y + (y + (y + (y + 0)))))) = 0 → x = 0 := by decide
    exact hh (w.val 0) (w.val 1) (by
      simpa only [heq 2 (by decide), heq 3 (by decide),
        heq 4 (by decide), heq 5 (by decide), heq 6 (by decide)] using hsum)
  apply Subtype.ext
  funext i
  fin_cases i <;> simp_all [point]

private theorem fixed_line (x : natural Ω)
    (ha : naturalRepresentation Ω a x = x)
    (hb : naturalRepresentation Ω b x = x)
    (hc : naturalRepresentation Ω c x = x) : ∃ r : ZMod 2, x = r • p := by
  obtain ⟨w, rfl⟩ := e.surjective x
  have lift (g : Perm Ω) (hg : naturalRepresentation Ω g (e w) = e w) :
      coreRepresentation Ω g w = w := e.injective ((equivariant g w).trans hg)
  refine ⟨w.val 1, ?_⟩
  exact (congrArg e (fixed_core w (lift a ha) (lift b hb) (lift c hc))).trans
    (e.map_smul _ _)

/-- Every endomorphism commuting with the natural binary A₇ action is scalar. -/
theorem commuting_scalar (f : natural (Fin 7) →ₗ[ZMod 2] natural (Fin 7))
    (hf : ∀ g : alternatingGroup (Fin 7), ∀ x,
      f (naturalRepresentation (Fin 7) g.val x) = naturalRepresentation (Fin 7) g.val (f x)) :
    ∃ r : ZMod 2, ∀ x, f x = r • x := by
  have ha := (hf ⟨a, even.1⟩ p).symm
  have hb := (hf ⟨b, even.2.1⟩ p).symm
  have hc := (hf ⟨c, even.2.2.1⟩ p).symm
  rw [fix.1] at ha
  rw [fix.2.1] at hb
  rw [fix.2.2] at hc
  obtain ⟨r, hr⟩ := fixed_line (f p) ha hb hc
  let P : Subrepresentation (alternatingNaturalRepresentation (Ω := Fin 7)) :=
    { toSubmodule := LinearMap.ker (f - r • LinearMap.id)
      apply_mem_toSubmodule := by
        intro g x hx
        change f x - r • x = 0 at hx
        change f (naturalRepresentation Ω g.val x) - r • naturalRepresentation Ω g.val x = 0
        rw [hf, sub_eq_zero.mp hx, map_smul, sub_self] }
  let := alternatingNatural_isIrreducible (Ω := Fin 7) (by simp)
  have ht : P = ⊤ := (IsSimpleOrder.eq_bot_or_eq_top P).resolve_left (by
    intro h
    have hm : p ∈ P.toSubmodule := sub_eq_zero.mpr hr
    rw [h] at hm
    exact point_ne hm)
  refine ⟨r, fun x => ?_⟩
  have hx : x ∈ P.toSubmodule := by rw [ht]; exact Submodule.mem_top
  exact sub_eq_zero.mp hx

/-- An injective endomorphism commuting with A₇ is the identity. -/
theorem commuting_eq_id (f : natural (Fin 7) →ₗ[ZMod 2] natural (Fin 7))
    (hinj : Function.Injective f)
    (hf : ∀ g : alternatingGroup (Fin 7), ∀ x,
      f (naturalRepresentation (Fin 7) g.val x) = naturalRepresentation (Fin 7) g.val (f x)) :
    f = LinearMap.id := by
  obtain ⟨r, hr⟩ := commuting_scalar f hf
  have hne : r ≠ 0 := by
    intro h
    have hh : f p = f 0 := by rw [hr, h, zero_smul, map_zero]
    exact point_ne (hinj hh)
  have hone : r = 1 := (show ∀ r : ZMod 2, r ≠ 0 → r = 1 by decide) r hne
  ext x
  simpa [hone] using hr x

/-- The natural A₇ module has no nonzero fixed vectors. -/
theorem fixed_eq_zero (x : natural (Fin 7))
    (hx : ∀ g : alternatingGroup (Fin 7), naturalRepresentation (Fin 7) g.val x = x) : x = 0 := by
  obtain ⟨r, rfl⟩ := fixed_line x (hx ⟨a, even.1⟩) (hx ⟨b, even.2.1⟩) (hx ⟨c, even.2.2.1⟩)
  have ht := hx ⟨t, even.2.2.2⟩
  have ht' : coreRepresentation Ω t (r • point) = r • point := by
    apply e.injective
    rw [equivariant, map_smul]
    exact ht
  have hh := congrArg (fun u : core Ω => u.val 0) ht'
  change r * 1 = r * 0 at hh
  have hr : r = 0 := by simpa using hh
  simp [hr]

/-- The natural A₇ module is generated by its action differences. -/
theorem commutator_eq_top :
    subspaceCommutator (naturalRepresentation (Fin 7)) ⊤ (alternatingGroup (Fin 7)) = ⊤ := by
  let σ := naturalRepresentation (Fin 7)
  let M := subspaceCommutator σ ⊤ (alternatingGroup (Fin 7))
  let P : Subrepresentation (alternatingNaturalRepresentation (Ω := Fin 7)) :=
    { toSubmodule := M
      apply_mem_toSubmodule := by
        intro g
        change M ≤ M.comap (σ g.val)
        apply Submodule.span_le.mpr
        rintro _ ⟨b, hb, w, _, rfl⟩
        change σ g.val (σ b w - w) ∈ M
        have he : σ g.val (σ b w - w) = (σ (g.val * b) w - w) - (σ g.val w - w) := by
          rw [map_sub, map_mul, Module.End.mul_apply]
          abel
        rw [he]
        exact M.sub_mem (Submodule.subset_span ⟨g.val * b,
          (alternatingGroup _).mul_mem g.property hb, w, Submodule.mem_top, rfl⟩)
          (Submodule.subset_span ⟨g.val, g.property, w, Submodule.mem_top, rfl⟩) }
  let := alternatingNatural_isIrreducible (Ω := Fin 7) (by simp)
  have ht : P = ⊤ := (IsSimpleOrder.eq_bot_or_eq_top P).resolve_left (by
    intro h
    have hm : M = ⊥ := congrArg Subrepresentation.toSubmodule h
    have hp := (subspaceCommutator_eq_bot_iff σ ⊤ (alternatingGroup _)).mp hm
      (Submodule.mem_top (x := p))
    exact point_ne (fixed_eq_zero p hp))
  exact congrArg Subrepresentation.toSubmodule ht
end BinaryPermutation.SevenCommutant
