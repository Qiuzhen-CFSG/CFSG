module

public import Theory.Representation.BinaryOffender.CommonFixedSpace
public import Theory.SpecificGroups.SymmetricSix.BinaryFlags.PointCoreTranspositionFixed.SmallImage

/-!
# Excluding rank-three common-fixed-space actors on the natural S₆ module

The displacement embedding forces a group of order at least eight to have
a fixed space of dimension at least three. Faithfulness makes this a
hyperplane, whose pointwise fixer is generated by a single transposition.
Thus no elementary actor of rank three has the fixed-space property used
in the final paragraph of Aschbacher–Smith 13.4.1, printed p.915. The action
here is the literal four-dimensional natural quotient, not the original
five-dimensional augmentation core.
-/

public noncomputable section
open Subgroup Representation.BinaryOffender

namespace BinaryPermutation
open Theory.SpecificGroups.SymmetricSix.BinaryFlags.PointCoreTranspositionFixed

/-- There is no rank-three elementary actor with all nonidentity fixed spaces
contained in its common fixed space on the actual natural S₆ module. -/
theorem natural_six_no_rank_three_common_fixed
    (A : Subgroup (Equiv.Perm (Fin 6))) [IsElementaryAbelian 2 A]
    (hlarge : 8 ≤ Nat.card A)
    (hc : ∀ a ∈ A, a ≠ 1 →
      fixedSpace (naturalRepresentation (Fin 6)) (zpowers a) ≤
        fixedSpace (naturalRepresentation (Fin 6)) A) : False := by
  let ρ := naturalRepresentation (Fin 6)
  have hne : A ≠ ⊥ := by
    intro he
    rw [he, card_bot] at hlarge
    omega
  obtain ⟨a, ha, ha1⟩ := (A.bot_or_exists_ne_one).resolve_left hne
  have hmove : ∃ v, ρ a v ≠ v := by
    by_contra! hh
    apply ha1
    apply naturalRepresentation_injective (Fin 6) (by decide)
    ext v : 1
    simpa only [map_one, Module.End.one_apply] using hh v
  obtain ⟨v, hv⟩ := hmove
  have hv' : v ∉ fixedSpace ρ A := fun hh => hv (hh ⟨a, ha⟩)
  have hb := card_le_fixedSpace_of_common_fixedSpace ρ A hc v hv'
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2) (V := fixedSpace ρ A), Nat.card_zmod] at hb
  have hd : 3 ≤ Module.finrank (ZMod 2) (fixedSpace ρ A) := by
    have hpow : 2 ^ 3 ≤ 2 ^ Module.finrank (ZMod 2) (fixedSpace ρ A) := hlarge.trans hb
    exact (pow_le_pow_iff_right₀ (by decide)).mp hpow
  have hsum := fixedCodim_add_finrank ρ A
  rw [finrank_natural_even (Fin 6) (by decide)] at hsum
  have hsmall : fixedCodim ρ A ≤ 1 := by
    change fixedCodim ρ A + Module.finrank (ZMod 2) (fixedSpace ρ A) = 4 at hsum
    omega
  obtain ⟨t, ht, hswap, hA⟩ := small_image_eq_zpowers A hne hsmall
  rw [hA, Nat.card_zpowers, hswap.orderOf] at hlarge
  omega

end BinaryPermutation
