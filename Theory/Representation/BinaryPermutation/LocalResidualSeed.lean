module

public import Theory.Representation.BinaryPermutation.LocalResidualSeed.Six
public import Theory.Representation.BinaryPermutation.LocalResidualSeed.Seven
public import Theory.SpecificGroups.SymmetricSeven.LocalResidualRecognition

/-!
# Local residual seeds in small binary permutation modules

The natural modules on six and seven letters admit no four-dimensional
subspace fixed by the two-core of the first literal embedded two-residual
and generated by its residual commutators, for a generating pair of
index-three Sylow overgroups.

In degree six the residual core has fixed-space dimension less than four.
In degree seven residual recognition gives two tetrahedral actions, whose
cores fix at most three dimensions, or a three-point cyclic action, whose
commutator space has dimension at most two. The latter has trivial two-core,
so the commutator hypothesis is essential. The seven-point proof needs only
one index-three Sylow overgroup; `seven` retains the generating-pair interface.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), proof of
15.3.1, printed p.1155.
-/

public section

open Subgroup Module Representation.BinaryOffender
namespace BinaryPermutation.LocalResidualSeed

/-- No four-dimensional marked residual seed exists for an index-three Sylow
overgroup in the natural S₇ module. The actual embedded residual is recognized
by its permutation action, with no additional recognition premise. -/
theorem seven_of_index_three (T : Sylow 2 (Equiv.Perm (Fin 7)))
    (P : Subgroup (Equiv.Perm (Fin 7)))
    (hT : (T : Subgroup _) ≤ P) (hi : (T : Subgroup _).relIndex P = 3)
    (U : Submodule (ZMod 2) (natural (Fin 7))) (hdim : finrank (ZMod 2) U = 4)
    (hfix : U ≤ fixedSpace (naturalRepresentation (Fin 7))
      (((pResidual 2 P).map P.subtype).pCoreIn 2))
    (hcomm : subspaceCommutator (naturalRepresentation (Fin 7)) U
      ((pResidual 2 P).map P.subtype) = U) : False :=
  seven_of_residual_conjugacy P
    (Theory.SpecificGroups.SymmetricSeven.LocalResidualRecognition.residual_conjugacy
      T P hT hi) U hdim hfix hcomm

/-- There is no four-dimensional marked residual seed in the natural S₇ module
for a generating pair of index-three Sylow overgroups. -/
theorem seven (T : Sylow 2 (Equiv.Perm (Fin 7)))
    (P₁ P₂ : Subgroup (Equiv.Perm (Fin 7)))
    (h₁ : (T : Subgroup _) ≤ P₁) (_h₂ : (T : Subgroup _) ≤ P₂)
    (hi₁ : (T : Subgroup _).relIndex P₁ = 3)
    (_hi₂ : (T : Subgroup _).relIndex P₂ = 3) (_hgen : P₁ ⊔ P₂ = ⊤)
    (U : Submodule (ZMod 2) (natural (Fin 7))) (hdim : finrank (ZMod 2) U = 4)
    (hfix : U ≤ fixedSpace (naturalRepresentation (Fin 7))
      (((pResidual 2 P₁).map P₁.subtype).pCoreIn 2))
    (hcomm : subspaceCommutator (naturalRepresentation (Fin 7)) U
      ((pResidual 2 P₁).map P₁.subtype) = U) : False :=
  seven_of_index_three T P₁ h₁ hi₁ U hdim hfix hcomm

end BinaryPermutation.LocalResidualSeed
