module

public import Theory.Representation.BinaryPermutation.SixCoreExtension.Residual.Transport
public import Theory.SpecificGroups.SymmetricSix.ResidualPairRecognition.Models

/-!
# The two-residual of the six-letter pair centralizer

In the literal semidirect product of the even binary six-space by A6, the
centralizer of the vector supported on {0,1} has two-residual W:A4. Here W
vanishes at 0 and 1, and A4 fixes those two letters individually.

For the upper bound, this coordinate subgroup is normal in the centralizer,
and every element of the quotient has fourth power one. For the lower bound,
the complementary A4 is generated by elements of order dividing three.
Conjugation by the vector supported on {0,2} then supplies the vectors on
{2,3}, {2,4}, and {2,5}, which span W. Small certificates use only the
S2 × S4 actor model and binary words; the semidirect product is not enumerated.

The final theorem applies this identity to the published unique-square
calculation, with the independent two-core identity still explicit.

Source: Aschbacher–Smith, I.2.2(6b), printed pp.410 and 412, combined
manuscript of 1 March 2004.
-/

public section

open Subgroup Theory.GroupTheory
namespace BinaryPermutation.SixCoreExtension
noncomputable section
private abbrev C := centralizer ({vector (Multiplicative.ofAdd pair)} : Set Model)
private abbrev R := pairResidual.subgroupOf C

private theorem perm_pair_cases (x : C) :
    (x.val.right.val 0 = 0 ∧ x.val.right.val 1 = 1) ∨
    (x.val.right.val 0 = 1 ∧ x.val.right.val 1 = 0) := by
  have h := (mem_centralizer_pair x.val).mp x.property
  have h0 := (h 0).mpr (Or.inl rfl)
  have h1 := (h 1).mpr (Or.inr rfl)
  rcases h0 with h0 | h0 <;> rcases h1 with h1 | h1
  · exact False.elim (by have := x.val.right.val.injective (h0.trans h1.symm); simp at this)
  · exact Or.inl ⟨h0, h1⟩
  · exact Or.inr ⟨h0, h1⟩
  · exact False.elim (by have := x.val.right.val.injective (h0.trans h1.symm); simp at this)

private theorem inverse_pair (x : C) (i : Fin 6) (hi : i = 0 ∨ i = 1) :
    x.val.right.val.symm i = 0 ∨ x.val.right.val.symm i = 1 := by
  exact ((mem_centralizer_pair x.val).mp x.property _).mp (by simpa using hi)

private instance : R.Normal where
  conj_mem x hx g := by
    change x.val.left.toAdd.val 0 = 0 ∧ x.val.left.toAdd.val 1 = 0 ∧
      x.val.right.val 0 = 0 ∧ x.val.right.val 1 = 1 at hx
    have hfix (j : Fin 6) (hj : j = 0 ∨ j = 1) : x.val.right.val j = j := by
      rcases hj with rfl | rfl
      · exact hx.2.2.1
      · exact hx.2.2.2
    have hfixinv (j : Fin 6) (hj : j = 0 ∨ j = 1) : x.val.right.val.symm j = j := by
      exact x.val.right.val.injective (by rw [Equiv.apply_symm_apply, hfix j hj])
    have hzero (j : Fin 6) (hj : j = 0 ∨ j = 1) : x.val.left.toAdd.val j = 0 := by
      rcases hj with rfl | rfl
      · exact hx.1
      · exact hx.2.1
    have hv (i : Fin 6) (hi : i = 0 ∨ i = 1) :
        (g.val * x.val * g.val⁻¹).left.toAdd.val i = 0 := by
      change g.val.left.toAdd.val i + x.val.left.toAdd.val (g.val.right.val.symm i) +
        -g.val.left.toAdd.val (g.val.right.val
          (x.val.right.val.symm (g.val.right.val.symm i))) = 0
      rw [hfixinv _ (inverse_pair g i hi), Equiv.apply_symm_apply,
        hzero _ (inverse_pair g i hi), add_zero, add_neg_cancel]
    have ha (i : Fin 6) (hi : i = 0 ∨ i = 1) :
        (g.val * x.val * g.val⁻¹).right.val i = i := by
      change g.val.right.val (x.val.right.val (g.val.right.val.symm i)) = i
      rw [hfix _ (inverse_pair g i hi), Equiv.apply_symm_apply]
    exact ⟨hv 0 (Or.inl rfl), hv 1 (Or.inr rfl), ha 0 (Or.inl rfl), ha 1 (Or.inr rfl)⟩


private theorem square_mem_of_fixes (x : Model)
    (h0 : x.right.val 0 = 0) (h1 : x.right.val 1 = 1) : x ^ 2 ∈ pairResidual := by
  have hi (i : Fin 6) (h : x.right.val i = i) : x.right.val.symm i = i :=
    x.right.val.injective (by rw [Equiv.apply_symm_apply, h])
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [square_left, hi 0 h0, CharTwo.add_self_eq_zero]
  · rw [square_left, hi 1 h1, CharTwo.add_self_eq_zero]
  · change x.right.val (x.right.val 0) = 0
    rw [h0, h0]
  · change x.right.val (x.right.val 1) = 1
    rw [h1, h1]

private theorem fourth_mem (x : C) : x ^ 4 ∈ R := by
  have h0 : (x.val ^ 2).right.val 0 = 0 := by
    change x.val.right.val (x.val.right.val 0) = 0
    rcases perm_pair_cases x with ⟨h0, h1⟩ | ⟨h0, h1⟩ <;> simp only [h0, h1]
  have h1 : (x.val ^ 2).right.val 1 = 1 := by
    change x.val.right.val (x.val.right.val 1) = 1
    rcases perm_pair_cases x with ⟨h0, h1⟩ | ⟨h0, h1⟩ <;> simp only [h0, h1]
  have h := square_mem_of_fixes (x.val ^ 2) h0 h1
  change x.val ^ 4 ∈ pairResidual
  simpa only [← pow_mul] using h

private theorem quotient_two_group : IsPGroup 2 (C ⧸ R) := by
  intro z
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective R z
  refine ⟨2, ?_⟩
  rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
  exact fourth_mem x

private theorem residual_le : centralizerTwoResidual (vector (Multiplicative.ofAdd pair)) ≤
    pairResidual := by
  exact (map_mono (show pResidual 2 C ≤ R from
    sInf_le ⟨inferInstance, quotient_two_group⟩)).trans_eq
      (map_subgroupOf_eq_of_le pairResidual_le_centralizer_pair)

namespace ActorCertificate
open Theory.SpecificGroups.SymmetricSix
open Theory.SpecificGroups.SymmetricSix.ResidualPairRecognition
local instance : Fintype (Equiv.Perm (Fin 4)) := fintypePerm
local instance : Fintype (Equiv.Perm (Fin 2)) := fintypePerm
local instance : Fintype (alternatingGroup (Fin 4)) := Subtype.fintype _

private theorem duad_even : ∀ a : alternatingGroup (Fin 4),
    duadHom a ∈ alternatingGroup (Fin 6) := by
  change ∀ a : alternatingGroup (Fin 4), (duadHom a).sign = 1
  decide +kernel

private theorem duad_fixes : ∀ a : alternatingGroup (Fin 4),
    duadHom a 0 = 0 ∧ duadHom a 1 = 1 := by decide +kernel

private theorem duad_product_covers : ∀ x : DuadProduct,
    duadProductHom x 0 = 0 → duadProductHom x 1 = 1 → (duadProductHom x).sign = 1 →
      ∃ a : alternatingGroup (Fin 4), duadHom a = duadProductHom x := by decide +kernel

private theorem duad_covers (g : Equiv.Perm (Fin 6))
    (h0 : g 0 = 0) (h1 : g 1 = 1) (hg : g.sign = 1) :
    ∃ a : alternatingGroup (Fin 4), duadHom a = g := by
  have hmem : g ∈ duadStabilizer := by
    change ({0, 1} : Finset (Fin 6)).image g = {0, 1}
    simp [h0, h1]
  obtain ⟨x, hx⟩ := duadProductEquiv.surjective ⟨g, hmem⟩
  have he : duadProductHom x = g := congrArg Subtype.val hx
  obtain ⟨a, ha⟩ := duad_product_covers x (he.symm ▸ h0) (he.symm ▸ h1) (he.symm ▸ hg)
  exact ⟨a, ha.trans he⟩

private def lift : alternatingGroup (Fin 4) →* BinaryPermutation.SixCoreExtension.A :=
  duadHom.codRestrict _ duad_even
end ActorCertificate

private abbrev K := centralizerTwoResidual (vector (Multiplicative.ofAdd pair))

private theorem cubic_mem (x : C) (hx : x ^ 3 = 1) : x.val ∈ K := by
  exact ⟨x, mem_pResidual_of_orderOf_coprime
    ((by decide : Nat.Coprime 2 3).of_dvd_right (orderOf_dvd_of_pow_eq_one hx)), rfl⟩

private theorem actor_mem (g : A) (h0 : g.val 0 = 0) (h1 : g.val 1 = 1) :
    (SemidirectProduct.inr g : Model) ∈ K := by
  obtain ⟨a, ha⟩ := ActorCertificate.duad_covers g.val h0 h1 g.property
  have hg : ActorCertificate.lift a = g := Subtype.ext ha
  rw [← hg]
  let f : alternatingGroup (Fin 4) →* Model := SemidirectProduct.inr.comp ActorCertificate.lift
  have hf (b : alternatingGroup (Fin 4)) : f b ∈ C :=
    pairResidual_le_centralizer_pair ⟨rfl, rfl, (ActorCertificate.duad_fixes b).1,
      (ActorCertificate.duad_fixes b).2⟩
  have hc (b : alternatingGroup (Fin 4)) (hb : b ^ 3 = 1) : f b ∈ K := by
    apply cubic_mem ⟨f b, hf b⟩
    apply Subtype.ext
    change f b ^ 3 = 1
    rw [← map_pow, hb, map_one]
  obtain ⟨b, c, hb, hc', he⟩ :=
    Theory.SpecificGroups.SymmetricSix.ResidualPairRecognition.odd_factorization a
  change f a ∈ K
  rw [← he, map_mul]
  exact K.mul_mem (hc b hb) (hc c hc')

private theorem conj_mem (x : Model) (hx : x ∈ K) (g : C) :
    g.val * x * g.val⁻¹ ∈ K := by
  obtain ⟨y, hy, rfl⟩ := hx
  exact ⟨g * y * g⁻¹, (inferInstance : (pResidual 2 C).Normal).conj_mem y hy g, rfl⟩


private def seed : V := ⟨![1,0,1,0,0,0], by rw [mem_core]; decide⟩

private def tailVector (j : Fin 3) : V := ![
  ⟨![0,0,1,1,0,0], by rw [mem_core]; decide⟩,
  ⟨![0,0,1,0,1,0], by rw [mem_core]; decide⟩,
  ⟨![0,0,1,0,0,1], by rw [mem_core]; decide⟩] j

private def tailActor (j : Fin 3) : A := ![
  ⟨Equiv.swap 2 3 * Equiv.swap 3 4, by simp [Equiv.Perm.mem_alternatingGroup]⟩,
  ⟨Equiv.swap 2 4 * Equiv.swap 4 5, by simp [Equiv.Perm.mem_alternatingGroup]⟩,
  ⟨Equiv.swap 2 5 * Equiv.swap 5 3, by simp [Equiv.Perm.mem_alternatingGroup]⟩] j

private theorem tail_identity (j : Fin 3) :
    vector (Multiplicative.ofAdd seed) * SemidirectProduct.inr (tailActor j) *
      (vector (Multiplicative.ofAdd seed))⁻¹ * (SemidirectProduct.inr (tailActor j))⁻¹ =
        vector (Multiplicative.ofAdd (tailVector j)) := by
  apply SemidirectProduct.ext
  · apply Multiplicative.toAdd.injective
    apply Subtype.ext
    funext i
    fin_cases j <;> fin_cases i <;> rfl
  · simp [vector]

private theorem tail_mem (j : Fin 3) : vector (Multiplicative.ofAdd (tailVector j)) ∈ K := by
  have ha : (SemidirectProduct.inr (tailActor j) : Model) ∈ K := by
    apply actor_mem
    · fin_cases j <;> rfl
    · fin_cases j <;> rfl
  have hs : vector (Multiplicative.ofAdd seed) ∈ C :=
    (mem_centralizer_vector _ _).mpr (by simp [vector])
  rw [← tail_identity j]
  exact K.mul_mem (conj_mem _ ha ⟨_, hs⟩) (K.inv_mem ha)


private theorem tail_span_certificate : ∀ w : Full (Fin 6),
    (∑ i, w i) = 0 → w 0 = 0 → w 1 = 0 →
      w = (if w 3 = 0 then 0 else (tailVector 0).val) +
          (if w 4 = 0 then 0 else (tailVector 1).val) +
          (if w 5 = 0 then 0 else (tailVector 2).val) := by decide

private theorem vector_mem (v : V) (h0 : v.val 0 = 0) (h1 : v.val 1 = 0) :
    vector (Multiplicative.ofAdd v) ∈ K := by
  let select (c : ZMod 2) (j : Fin 3) : V := if c = 0 then 0 else tailVector j
  have hm (c : ZMod 2) (j : Fin 3) : vector (Multiplicative.ofAdd (select c j)) ∈ K := by
    dsimp [select]
    split_ifs
    · exact K.one_mem
    · exact tail_mem j
  have he : v = select (v.val 3) 0 + select (v.val 4) 1 + select (v.val 5) 2 := by
    apply Subtype.ext
    simpa only [select, Submodule.coe_add, Submodule.coe_zero, apply_ite] using
      tail_span_certificate v.val v.property h0 h1
  have hf (a b : V) : vector (Multiplicative.ofAdd (a + b)) =
      vector (Multiplicative.ofAdd a) * vector (Multiplicative.ofAdd b) := map_mul vector _ _
  rw [he, hf, hf]
  exact K.mul_mem (K.mul_mem (hm _ _) (hm _ _)) (hm _ _)

private theorem le_residual : pairResidual ≤ K := by
  intro x hx
  have h := K.mul_mem (vector_mem x.left.toAdd hx.1 hx.2.1)
    (actor_mem x.right hx.2.2.1 hx.2.2.2)
  change SemidirectProduct.inl x.left * SemidirectProduct.inr x.right ∈ K at h
  rwa [SemidirectProduct.inl_left_mul_inr_right] at h

/-- The literal embedded two-residual of the marked vector centralizer. -/
theorem centralizerTwoResidual_pair :
    centralizerTwoResidual (vector (Multiplicative.ofAdd pair)) = pairResidual :=
  le_antisymm residual_le le_residual

/-- Apply the residual identity to the square calculation. Only the independent
two-core identity remains as a premise. -/
theorem unique_square_of_twoCore_identity
    (hcore : pairResidual.pCoreIn 2 = pairCore)
    (v : V) (hv : coreToNatural (Fin 6) v ≠ 0) :
    ∃! w : Model, (vector (Multiplicative.ofAdd v))⁻¹ * w ∈ centralLine ∧
      ∃ x ∈ centralizerResidualCore (vector (Multiplicative.ofAdd v)), x ^ 2 = w :=
  unique_square_of_identities centralizerTwoResidual_pair hcore v hv
end
end BinaryPermutation.SixCoreExtension
