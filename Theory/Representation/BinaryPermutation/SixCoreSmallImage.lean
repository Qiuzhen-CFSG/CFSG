module
public import Theory.SpecificGroups.SymmetricSix.BinaryFlags.PointCoreTranspositionFixed.SmallImage
public import Theory.Representation.BinaryOffender.QuadraticQuotient

/-!
# Hyperplane fixers in the six-letter augmentation core

The natural quotient cannot have larger fixed codimension than the original
five-dimensional core. Its hyperplane-fixer theorem therefore identifies any
nontrivial core actor of fixed codimension one with a single transposition.
In particular the actor has order two. This uses the actual coordinate
permutation action and does not replace the core by its quotient.

The mixed reciprocal application is in Chapter13 Section04
FixedCoreSource/Nonsolvable/MixedLinearIndices. Source: Aschbacher--Smith
13.4.15, the order-two action-image case, printed p.912.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender
namespace BinaryPermutation.SixCoreSmallImage
/-- A nontrivial actor fixing a hyperplane in the augmentation core is generated by a transposition. -/
theorem small_image_eq_zpowers (A : Subgroup (Equiv.Perm (Fin 6))) (hne : A ≠ ⊥)
    (hsmall : fixedCodim (coreRepresentation (Fin 6)) A ≤ 1) :
    ∃ t ∈ A, t.IsSwap ∧ A = zpowers t := by
  apply Theory.SpecificGroups.SymmetricSix.BinaryFlags.PointCoreTranspositionFixed.small_image_eq_zpowers A hne
  exact (fixedCodim_le_of_equivariant_surjection _ _ (coreToNatural (Fin 6))
    coreToNatural_surjective (fun g v => coreToNatural_equivariant g v) A).trans hsmall

/-- Fixing a hyperplane bounds the full actor, including the trivial case. -/
theorem card_le_two_of_fixedCodim_le_one (A : Subgroup (Equiv.Perm (Fin 6)))
    (hsmall : fixedCodim (coreRepresentation (Fin 6)) A ≤ 1) : Nat.card A ≤ 2 := by
  by_cases he : A = ⊥
  · rw [he,card_bot]; decide
  · obtain ⟨t,_,ht,rfl⟩ := small_image_eq_zpowers A he hsmall
    rw [Nat.card_zpowers,ht.orderOf]

end BinaryPermutation.SixCoreSmallImage
