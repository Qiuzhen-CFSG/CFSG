module
public import Theory.Representation.BinaryConjugacyOrbit
public import Theory.Representation.BinaryPrimeDegree

/-!
# Binary modules generated by a point-stabilizer fixed vector

A fixed vector for one point stabilizer in a transitive permutation action
extends to an equivariant family indexed by the points. Its spanning orbit
therefore gives a surjection from the full permutation module. In degree
five, a target of dimension at least four has kernel of dimension at most
one. Transitivity makes that kernel constant, giving a full or deleted
permutation marking for the entire original group action.

The Chapter14 NormalFourModule consumer applies this to the original KT
and its original overlap, retaining its two-core quotient and seed vector.
Source: the standard permutation-module construction used in
Aschbacher--Smith 14.3.6(1) and 14.6.20, printed pp.991,1037.
-/

public noncomputable section
namespace BinaryPermutation
open Representation Subgroup
variable {H Ω W : Type*} [Group H] [Fintype Ω] [DecidableEq Ω] [AddCommGroup W] [Module (ZMod 2) W]

/-- A spanning point-fixed vector gives the actual equivariant permutation quotient. -/
theorem quotient_of_point_fixed
    (ρ : Representation (ZMod 2) H W) (α : H →* Equiv.Perm Ω)
    (ht : ∀ i j : Ω, ∃ g : H, α g i = j)
    (i : Ω) (w : W) (hw : ∀ g : H, α g i = i → ρ g w = w)
    (hs : Submodule.span (ZMod 2) (Set.range (fun g : H => ρ g w)) = ⊤) :
    ∃ F : IntertwiningMap ((representation Ω).comp α) ρ,
      Function.Surjective F ∧ F (Pi.single i 1) = w := by
  classical
  let t (j : Ω) : H := (ht i j).choose
  have htj (j : Ω) : α (t j) i = j := (ht i j).choose_spec
  let v (j : Ω) : W := ρ (t j) w
  have hv (g : H) (j : Ω) : v (α g j) = ρ g (v j) := by
    have hb : α ((t (α g j))⁻¹ * g * t j) i = i := by
      simp only [map_mul, map_inv, Equiv.Perm.coe_mul, Equiv.Perm.coe_inv,
        Function.comp_apply, htj]
      exact (α (t (α g j))).symm_apply_eq.mpr (htj _).symm
    have hh := congrArg (ρ (t (α g j))) (hw _ hb)
    simp only [← Module.End.mul_apply, ← map_mul, mul_assoc, mul_inv_cancel_left] at hh
    simpa only [v,map_mul,Module.End.mul_apply] using hh.symm
  have hvi : v i = w := hw _ (htj i)
  have hr : Set.range v = Set.range (fun g : H => ρ g w) := by
    ext x
    constructor
    · rintro ⟨j,rfl⟩; exact ⟨t j,rfl⟩
    · rintro ⟨g,rfl⟩; exact ⟨α g i,by rw [hv,hvi]⟩
  exact ⟨orbitQuotient ρ α v hv,
    orbitQuotient_surjective ρ α v hv (hr ▸ hs),
    by
      change (∑ j, (Pi.single i (1 : ZMod 2) : Ω → ZMod 2) j • v j) = w
      simpa only [Pi.single_apply,ite_smul,one_smul,zero_smul,Finset.sum_ite_eq',
        Finset.mem_univ,if_true] using hvi⟩


/-- A five-point quotient of dimension at least four has only the constant kernel. -/
theorem five_point_kernel
    (ρ : Representation (ZMod 2) H W) (α : H →* Equiv.Perm (Fin 5))
    (ht : ∀ i j : Fin 5, ∃ g : H, α g i = j)
    (F : IntertwiningMap ((representation (Fin 5)).comp α) ρ)
    (hF : Function.Surjective F) (hd : 4 ≤ Module.finrank (ZMod 2) W) :
    F.toLinearMap.ker = ⊥ ∨ F.toLinearMap.ker = constants (Fin 5) := by
  have hn := F.toLinearMap.finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr hF,finrank_top,finrank_full] at hn
  have hk : Module.finrank (ZMod 2) F.toLinearMap.ker ≤ 1 := by
    simp only [Fintype.card_fin] at hn
    omega
  by_cases hb : F.toLinearMap.ker = ⊥
  · exact Or.inl hb
  · right
    have hdim : Module.finrank (ZMod 2) F.toLinearMap.ker = 1 := by
      have hnz := mt Submodule.finrank_eq_zero.mp hb
      omega
    have hcard : Nat.card F.toLinearMap.ker = 2 := by
      rw [Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod,hdim,pow_one]
    obtain ⟨u,hu,huniq⟩ := (Nat.card_eq_two_iff' (0 : F.toLinearMap.ker)).mp hcard
    have hle : F.toLinearMap.ker ≤ constants (Fin 5) := by
      intro v hv
      by_cases hz : v = 0
      · simpa only [hz] using (constants (Fin 5)).zero_mem
      · have hfix (g : H) : representation (Fin 5) (α g) v = v := by
          have hmem : representation (Fin 5) (α g) v ∈ F.toLinearMap.ker := by
            change F (((representation (Fin 5)).comp α) g v) = 0
            rw [IntertwiningMap.isIntertwining _ _ F g v,show F v = 0 from hv,map_zero]
          have hne : representation (Fin 5) (α g) v ≠ 0 := by
            intro he
            have hh := congrArg (representation (Fin 5) (α g)⁻¹) he
            exact hz (by simpa only [Representation.inv_self_apply,map_zero] using hh)
          exact congrArg Subtype.val ((huniq ⟨_,hmem⟩
            (fun he => hne (congrArg Subtype.val he))).trans
              (huniq ⟨v,hv⟩ (fun he => hz (congrArg Subtype.val he))).symm)
        apply Submodule.mem_span_singleton.mpr
        refine ⟨v 0,?_⟩
        ext j
        obtain ⟨g,hg⟩ := ht 0 j
        have hh := congrFun (hfix g) j
        rw [representation_apply,←hg,Equiv.symm_apply_apply] at hh
        simpa only [Pi.smul_apply,allOne,smul_eq_mul,mul_one,hg] using hh
    exact Submodule.eq_of_le_of_finrank_eq hle (by rw [hdim,finrank_constants])

/-- Full or deleted permutation coordinates retain every original actor and the seed. -/
theorem five_point_marking
    (ρ : Representation (ZMod 2) H W) (α : H →* Equiv.Perm (Fin 5))
    (ht : ∀ i j : Fin 5, ∃ g : H, α g i = j)
    (i : Fin 5) (w : W) (hw : ∀ g : H, α g i = i → ρ g w = w)
    (hs : Submodule.span (ZMod 2) (Set.range (fun g : H => ρ g w)) = ⊤)
    (hd : 4 ≤ Module.finrank (ZMod 2) W) :
    (∃ c : Full (Fin 5) ≃ₗ[ZMod 2] W,
      c (Pi.single i 1) = w ∧ ∀ g v, c (representation (Fin 5) (α g) v) = ρ g (c v)) ∨
    (∃ c : Deleted (Fin 5) ≃ₗ[ZMod 2] W,
      c ((constants (Fin 5)).mkQ (Pi.single i 1)) = w ∧
      ∀ g v, c (deletedRepresentation (Fin 5) (α g) v) = ρ g (c v)) := by
  obtain ⟨F,hF,hi⟩ := quotient_of_point_fixed ρ α ht i w hw hs
  rcases five_point_kernel ρ α ht F hF hd with hk | hk
  · exact Or.inl ⟨LinearEquiv.ofBijective F.toLinearMap
      ⟨LinearMap.ker_eq_bot.mp hk,hF⟩,hi,fun g v => IntertwiningMap.isIntertwining _ _ F g v⟩
  · let c : Deleted (Fin 5) ≃ₗ[ZMod 2] W :=
      (Submodule.quotEquivOfEq (constants (Fin 5)) F.toLinearMap.ker hk.symm).trans
        (F.toLinearMap.quotKerEquivOfSurjective hF)
    have hc (v : Full (Fin 5)) : c ((constants (Fin 5)).mkQ v) = F v := rfl
    refine Or.inr ⟨c,hi,?_⟩
    intro g v
    obtain ⟨v,rfl⟩ := (constants (Fin 5)).mkQ_surjective v
    exact IntertwiningMap.isIntertwining _ _ F g v

end BinaryPermutation
