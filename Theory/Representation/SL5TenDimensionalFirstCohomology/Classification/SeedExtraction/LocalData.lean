module

public import Theory.Representation.SL5TenDimensionalFirstCohomology.Classification.Seeds

/-!
# Rank-one data for binary SL₅ seed extraction

The four adjacent coordinate pairs index the simple roots. A local highest
vector is fixed by all upper transvections. At each adjacent pair it is either
fixed by the coordinate exchange or satisfies the binary three-term relation.
The subset recording the latter alternatives is its support.

For a nonzero such vector the alternatives are disjoint: fixing both the upper
transvection and the exchange also fixes the lower transvection, contradicting
the three-term relation. If the support is a single middle root, the vector is
fixed by the subgroup generated by the upper transvections and the other
adjacent exchanges. Identifying that subgroup with the exterior seed stabilizer
then yields precisely the relations in `Seeds`.

This supplies interfaces for the finite-group highest-vector, dimension, and
parabolic-generation arguments needed in Aschbacher--Smith, *The Classification
of Quasithin Groups*, Lemma I.1.6(7), printed p.408/PDF p.419. Their existence and
dimension conclusions are not assumed as unconditional theorems here.
-/

@[expose] public section

namespace Representation.SL5TenDimensional.Classification

/-- The adjacent lower transvection, adding coordinate `i` to coordinate `i+1`. -/
def simpleLower (i : Fin 4) : Group :=
  Matrix.SpecialLinearGroup.transvection
    (i := i.succ) (j := i.castSucc) (by intro h; have := congrArg Fin.val h; simp at this)
    (1 : ZMod 2)

/-- The adjacent upper transvection. -/
def simpleUpper (i : Fin 4) : Group :=
  Matrix.SpecialLinearGroup.transvection
    (i := i.castSucc) (j := i.succ) (by intro h; have := congrArg Fin.val h; simp at this)
    (1 : ZMod 2)

/-- Exchange the adjacent coordinates `i` and `i+1`. -/
def simpleSwap (i : Fin 4) : Group :=
  simpleLower i * simpleUpper i * simpleLower i

/-- The boundary root for the exterior square or cube. -/
def boundaryRoot (a : Fin 2) : Fin 4 := ⟨a.val + 1, by omega⟩

theorem simpleLower_boundaryRoot (a : Fin 2) : simpleLower (boundaryRoot a) = step a := rfl

theorem simpleSwap_boundaryRoot (a : Fin 2) : simpleSwap (boundaryRoot a) = swap a := rfl

/-- Conjugating the upper transvection by the exchange gives the lower one. -/
theorem simpleLower_eq_swap_upper_swap (i : Fin 4) :
    simpleLower i = simpleSwap i * simpleUpper i * simpleSwap i := by
  revert i
  decide

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]

/-- Fixedness under the positive root groups, stated on their generators. -/
def UpperFixed (ρ : Representation (ZMod 2) Group V) (v : V) : Prop :=
  ∀ (i j : Fin 5) (hij : i < j),
    ρ (Matrix.SpecialLinearGroup.transvection (ne_of_lt hij) (1 : ZMod 2)) v = v

/-- Explicit rank-one alternatives for an upper-fixed vector. The support is
the set of roots with the three-term alternative. Nonzeroness is kept separate. -/
structure LocalHighestVector (ρ : Representation (ZMod 2) Group V)
    (J : Finset (Fin 4)) (v : V) : Prop where
  upper_fixed : UpperFixed ρ v
  inactive_fixed : ∀ i, i ∉ J → ρ (simpleSwap i) v = v
  active_relation : ∀ i, i ∈ J → v + ρ (simpleSwap i) v + ρ (simpleLower i) v = 0

private theorem binary_add_self (v : V) : v + v = 0 := by
  have htwo : (1 : ZMod 2) + 1 = 0 := by decide
  calc
    v + v = ((1 : ZMod 2) + 1) • v := by rw [add_smul, one_smul]
    _ = 0 := by rw [htwo, zero_smul]

/-- An active root necessarily moves a nonzero local highest vector. -/
theorem LocalHighestVector.swap_ne_self
    {ρ : Representation (ZMod 2) Group V} {J : Finset (Fin 4)} {v : V}
    (h : LocalHighestVector ρ J v) (hv : v ≠ 0) {i : Fin 4} (hi : i ∈ J) :
    ρ (simpleSwap i) v ≠ v := by
  intro hswap
  have hu : ρ (simpleUpper i) v = v :=
    h.upper_fixed i.castSucc i.succ (by simp)
  have hl : ρ (simpleLower i) v = v := by
    rw [simpleLower_eq_swap_upper_swap, map_mul, map_mul]
    change ρ (simpleSwap i) (ρ (simpleUpper i) (ρ (simpleSwap i) v)) = v
    rw [hswap, hu, hswap]
  have hr := h.active_relation i hi
  rw [hswap, hl, binary_add_self, zero_add] at hr
  exact hv hr

/-- The support can be recovered from the action on any nonzero local highest
vector; it is not an arbitrary choice of labels. -/
theorem LocalHighestVector.mem_iff_swap_ne_self
    {ρ : Representation (ZMod 2) Group V} {J : Finset (Fin 4)} {v : V}
    (h : LocalHighestVector ρ J v) (hv : v ≠ 0) (i : Fin 4) :
    i ∈ J ↔ ρ (simpleSwap i) v ≠ v := by
  constructor
  · exact h.swap_ne_self hv
  · intro hi
    by_contra hnot
    exact hi (h.inactive_fixed i hnot)

/-- Upper transvections and the adjacent exchanges within the two blocks of
sizes `degree a` and `5 - degree a`. -/
def seedParabolicGenerators (a : Fin 2) : Set Group :=
  {g | (∃ (i j : Fin 5) (hij : i < j),
      g = Matrix.SpecialLinearGroup.transvection (ne_of_lt hij) (1 : ZMod 2)) ∨
    ∃ i : Fin 4, i ≠ boundaryRoot a ∧ g = simpleSwap i}

/-- A singleton-support vector is fixed by the subgroup generated by the
corresponding parabolic generators. No claim about the full stabilizer is used. -/
theorem LocalHighestVector.fixed_of_mem_closure
    {ρ : Representation (ZMod 2) Group V} {a : Fin 2} {v : V}
    (h : LocalHighestVector ρ {boundaryRoot a} v) {g : Group}
    (hg : g ∈ Subgroup.closure (seedParabolicGenerators a)) : ρ g v = v := by
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
    rcases hg with ⟨i, j, hij, rfl⟩ | ⟨i, hi, rfl⟩
    · exact h.upper_fixed i j hij
    · exact h.inactive_fixed i (by simpa using hi)
  | one => simp
  | mul g k _ _ hg hk =>
    rw [map_mul]
    change ρ g (ρ k v) = v
    rw [hk, hg]
  | inv g _ hg => exact ρ.inv_apply_eq_iff.mpr hg.symm

/-- Parabolic generation converts the explicit local data into the precise
exterior-seed contract. Generation is an explicit hypothesis of this bridge. -/
theorem LocalHighestVector.hasExteriorSeed
    {ρ : Representation (ZMod 2) Group V} {a : Fin 2} {v : V}
    (h : LocalHighestVector ρ {boundaryRoot a} v)
    (hgen : ∀ g : Group, exteriorAction (degree a) g (seed a) = seed a →
      g ∈ Subgroup.closure (seedParabolicGenerators a)) : HasExteriorSeed ρ a v := by
  refine ⟨fun g hg => h.fixed_of_mem_closure (hgen g hg), ?_⟩
  have hr := h.active_relation (boundaryRoot a) (Finset.mem_singleton_self _)
  simpa only [simpleLower_boundaryRoot, simpleSwap_boundaryRoot] using hr

end Representation.SL5TenDimensional.Classification
