module

public import Theory.Representation.SL5TenDimensionalFirstCohomology.Classification.SeedExtraction.LocalData
public import Theory.LinearAlgebra.BinaryBlockGeneration
public import Theory.AlgebraicGroup.Representations.Exterior

/-!
# Generation of the binary SL₅ exterior-seed stabilizers

The subgroup generated by upper transvections and adjacent swaps within the
two coordinate blocks contains every matrix preserving the first block.
Reversing coordinates inside each block conjugates its lower transvections
into upper transvections. Binary block elimination then generates every
invertible matrix with zero lower-left block. Preserving the span of the
first `degree a` standard vectors forces precisely those entries to vanish.

Fixing the initial decomposable exterior vector preserves that coordinate
subspace: the mapped top wedge determines the range of its underlying
injection. Thus every exterior-seed stabilizer element belongs to the
explicitly generated block parabolic.

This is the parabolic-generation step for the exterior-seed stabilizers in
Aschbacher--Smith, *The Classification of Quasithin Groups*, I.1.6(7), printed
p.408/PDF p.419. No parabolic or exterior presentation is assumed.
-/

public section

namespace Representation.SL5TenDimensional.Classification

private def blockReverseWord (a : Fin 2) : List (Fin 4) :=
  if a = 0 then [0, 2, 3, 2] else [0, 1, 0, 3]
private def blockReverse (a : Fin 2) : Group :=
  ((blockReverseWord a).map simpleSwap).prod
private def blockReverseIndex (a : Fin 2) (i : Fin 5) : Fin 5 :=
  (if a = 0 then ![1, 0, 4, 3, 2] else ![2, 1, 0, 4, 3]) i

private theorem blockReverseIndex_lt (a : Fin 2) (i j : Fin 5)
    (hij : j < i) (hblock : (i.val < degree a ↔ j.val < degree a)) :
    blockReverseIndex a i < blockReverseIndex a j := by
  revert a i j
  decide

set_option maxRecDepth 4000 in
set_option maxHeartbeats 1000000 in
private theorem blockReverse_transvection : ∀ (a : Fin 2) (i j : Fin 5)
    (hij : i ≠ j) (hrev : blockReverseIndex a i ≠ blockReverseIndex a j),
    Matrix.SpecialLinearGroup.transvection hij (1 : ZMod 2) =
      blockReverse a * Matrix.SpecialLinearGroup.transvection hrev (1 : ZMod 2) *
        blockReverse a := by
  decide

private theorem blockReverse_mem (a : Fin 2) :
    blockReverse a ∈ Subgroup.closure (seedParabolicGenerators a) := by
  have hw : ∀ a : Fin 2, ∀ i ∈ blockReverseWord a, i ≠ boundaryRoot a := by decide
  apply Subgroup.list_prod_mem
  intro g hg
  obtain ⟨i, hi, rfl⟩ := List.mem_map.mp hg
  exact Subgroup.subset_closure (Or.inr ⟨i, hw a i hi, rfl⟩)

/-- All transvections outside the lower-left block lie in the seed parabolic.
Internal lower transvections are conjugates of upper ones by internal swaps. -/
theorem seedParabolic_transvection_mem (a : Fin 2) (i j : Fin 5) (hij : i ≠ j)
    (hblock : j.val < degree a → i.val < degree a) (c : ZMod 2) :
    Matrix.SpecialLinearGroup.transvection hij c ∈
      Subgroup.closure (seedParabolicGenerators a) := by
  have hb : ∀ c : ZMod 2, c = 0 ∨ c = 1 := by decide
  rcases hb c with rfl | rfl
  · simp [Matrix.SpecialLinearGroup.transvection_coeff_zero]
  · rcases lt_or_gt_of_ne hij with hlt | hgt
    · exact Subgroup.subset_closure (Or.inl ⟨i, j, hlt, rfl⟩)
    · have hr := blockReverseIndex_lt a i j hgt ⟨fun hi => by omega, hblock⟩
      rw [blockReverse_transvection a i j hij (ne_of_lt hr)]
      exact Subgroup.mul_mem _ (Subgroup.mul_mem _ (blockReverse_mem a)
        (Subgroup.subset_closure (Or.inl ⟨_, _, hr, rfl⟩))) (blockReverse_mem a)

/-- Every binary SL₅ matrix whose lower-left block vanishes belongs to the
subgroup generated by the upper transvections and the internal adjacent swaps. -/
theorem mem_seedParabolicClosure_of_lowerLeft_zero (a : Fin 2) (g : Group)
    (hzero : ∀ i j : Fin 5, degree a ≤ i.val → j.val < degree a → g.val i j = 0) :
    g ∈ Subgroup.closure (seedParabolicGenerators a) := by
  let H := Subgroup.closure (seedParabolicGenerators a)
  have h : ∃ k : Group, k ∈ H ∧ k.val = g.val := by
    apply Matrix.binary_partition_induction (fun i : Fin 5 => i.val < degree a)
      (fun M => ∃ k : Group, k ∈ H ∧ k.val = M)
    · exact ⟨1, H.one_mem, rfl⟩
    · rintro M N ⟨k, hk, rfl⟩ ⟨l, hl, rfl⟩
      exact ⟨k * l, H.mul_mem hk hl, rfl⟩
    · intro i j hij hp c
      exact ⟨Matrix.SpecialLinearGroup.transvection hij c,
        seedParabolic_transvection_mem a i j hij hp c, rfl⟩
    · rw [g.property]
      exact one_ne_zero
    · intro i j hi hj
      exact hzero i j (Nat.le_of_not_gt hi) hj
  obtain ⟨k, hk, he⟩ := h
  have : k = g := Subtype.ext he
  rwa [← this]

/-- Preserving the span of the first `degree a` coordinate vectors places a
binary SL₅ matrix in the explicitly generated block parabolic. -/
theorem mem_seedParabolicClosure_of_preserves_span (a : Fin 2) (g : Group)
    (hstable : ∀ v ∈ Submodule.span (ZMod 2) (Set.range (frame a)),
      Matrix.mulVec g.val v ∈ Submodule.span (ZMod 2) (Set.range (frame a))) :
    g ∈ Subgroup.closure (seedParabolicGenerators a) := by
  apply mem_seedParabolicClosure_of_lowerLeft_zero a g
  intro i j hi hj
  have vanish (v : Fin 5 → ZMod 2)
      (hv : v ∈ Submodule.span (ZMod 2) (Set.range (frame a))) : v i = 0 := by
    induction hv using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨k, rfl⟩ := hx
      have hne : Fin.castLE (show degree a ≤ 5 by dsimp [degree]; omega) k ≠ i := by
        intro he
        have := congrArg Fin.val he
        simp only [Fin.val_castLE] at this
        omega
      simp [frame, Ne.symm hne]
    | zero => rfl
    | add x y _ _ hx hy => exact show x i + y i = 0 by rw [hx, hy, add_zero]
    | smul c x _ hx => exact show c * x i = 0 by rw [hx, mul_zero]
  have hv := vanish _ (hstable (frame a ⟨j.val, hj⟩)
    (Submodule.subset_span (Set.mem_range_self _)))
  change (Matrix.mulVec g.val (Pi.single j 1)) i = 0 at hv
  simpa only [Matrix.mulVec_single_one, Matrix.col_apply] using hv

open scoped ExteriorAlgebra

private noncomputable def seedSubspaceEmbedding (a : Fin 2) : (Fin (degree a) → ZMod 2) →ₗ[ZMod 2] (Fin 5 → ZMod 2) where
  toFun v i := if h : i.val < degree a then v ⟨i.val, h⟩ else 0
  map_add' _ _ := by ext i; by_cases h : i.val < degree a <;> simp [h]
  map_smul' _ _ := by ext i; by_cases h : i.val < degree a <;> simp [h]
private noncomputable def seedTopWedgeData (a : Fin 2) : Theory.AlgebraicGroup.FiniteSubspaceTopWedgeData (ZMod 2) (Fin (degree a) → ZMod 2) where
 degree := degree a
 basis := Pi.basisFun (ZMod 2) (Fin (degree a))
private theorem seedTopWedgeData_vector (a : Fin 2) :
    exteriorPower.map (degree a) (seedSubspaceEmbedding a) (seedTopWedgeData a).vector = seed a := by
  dsimp [seedTopWedgeData, Theory.AlgebraicGroup.FiniteSubspaceTopWedgeData.vector, seed]
  rw [exteriorPower.map_apply_ιMulti]
  congr 1
  funext i
  ext k
  fin_cases a <;> simp [seedSubspaceEmbedding, frame, Pi.basisFun_apply] <;> decide +revert
private theorem seedSubspaceEmbedding_injective (a : Fin 2) : Function.Injective (seedSubspaceEmbedding a) := by
  intro x y h
  ext i
  have := congrFun (congrArg (fun f => f) h) (Fin.castLE (by dsimp [degree]; omega) i)
  simpa [seedSubspaceEmbedding] using this
private theorem seedSubspace_range_stable (a : Fin 2) (g : Group)
    (hfix : exteriorAction (degree a) g (seed a) = seed a) :
    ∀ u, Matrix.mulVec g.val (seedSubspaceEmbedding a u) ∈ LinearMap.range (seedSubspaceEmbedding a) := by
  have hline : exteriorPower.map (degree a) (Matrix.SpecialLinearGroup.toLin' g).toLinearMap
      ((exteriorPower.map (degree a) (seedSubspaceEmbedding a) (seedTopWedgeData a).vector))
      ∈ (ZMod 2) ∙ (exteriorPower.map (degree a) (seedSubspaceEmbedding a) (seedTopWedgeData a).vector) := by
    rw [seedTopWedgeData_vector]
    change exteriorAction (degree a) g (seed a) ∈ (ZMod 2) ∙ (seed a)
    rw [hfix]
    exact Submodule.mem_span_singleton_self (seed a)
  have hs := (seedTopWedgeData a).map_mem_span_iff_range_stable (seedSubspaceEmbedding a) (seedSubspaceEmbedding_injective a)
    (Matrix.SpecialLinearGroup.toLin' g) |>.mp hline
  intro u
  have hu := hs u
  simpa only [Matrix.SpecialLinearGroup.toLin'_apply, Matrix.toLin'_apply] using hu
private theorem seedSubspaceEmbedding_basis (a : Fin 2) (j : Fin (degree a)) :
    seedSubspaceEmbedding a (Pi.basisFun (ZMod 2) (Fin (degree a)) j) = frame a j := by
  ext k
  fin_cases a <;> simp [seedSubspaceEmbedding, frame, Pi.basisFun_apply] <;> decide +revert

/-- Fixing the initial exterior square or cube seed places a binary SL₅ matrix
in the subgroup generated by upper transvections and adjacent coordinate
exchanges away from the boundary root. -/
theorem mem_seedParabolicClosure_of_fixes_seed (a : Fin 2) (g : Group)
    (hfix : exteriorAction (degree a) g (seed a) = seed a) :
    g ∈ Subgroup.closure (seedParabolicGenerators a) := by
  apply mem_seedParabolicClosure_of_lowerLeft_zero a g
  intro i j hi hj
  have hs := seedSubspace_range_stable a g hfix (Pi.basisFun (ZMod 2) (Fin (degree a)) ⟨j.val, hj⟩)
  rw [seedSubspaceEmbedding_basis] at hs
  obtain ⟨v, hv⟩ := hs
  have he := congrFun hv i
  change (seedSubspaceEmbedding a v) i = (Matrix.mulVec g.val (Pi.single j 1)) i at he
  simpa [seedSubspaceEmbedding, not_lt.mpr hi, Matrix.mulVec_single_one] using he.symm

end Representation.SL5TenDimensional.Classification
