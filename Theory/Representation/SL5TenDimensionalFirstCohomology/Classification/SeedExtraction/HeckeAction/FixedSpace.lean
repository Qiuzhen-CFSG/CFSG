module

public import Theory.Representation.SL5TenDimensionalFirstCohomology.Classification.SeedExtraction.HeckeAction.Basic
public import Theory.Representation.TwoDimensionalOddOrder
public import Mathlib.LinearAlgebra.Matrix.Charpoly.Basic
public import Mathlib.Algebra.CharP.Algebra

/-!
# Nonzero upper-fixed vectors for binary SL₅ modules

The subgroup generated by positive root transvections consists of upper
unitriangular matrices. Cayley–Hamilton gives `(A - 1) ^ 5 = 0`, and the
characteristic-two power identity then gives `A ^ 8 = 1`. Thus this subgroup
is a 2-group. Restricting any nonzero finite-dimensional binary representation
and applying the finite p-group fixed-vector theorem yields a nonzero vector
in its upper-fixed subspace; no irreducibility hypothesis is needed.

This supplies the fixed-space input for the highest-vector route to
Aschbacher–Smith, *The Classification of Quasithin Groups*, Lemma I.1.6(7),
printed p.408/PDF p.419. The Cayley–Hamilton argument follows the existing
`Theory.AlgebraicGroup.uUnipotent_sub_one_pow_eq_zero` proof, with narrow
matrix imports.
-/

@[expose] public section

namespace Representation.SL5TenDimensional.Classification.HeckeAction

private def Unitriangular (A : Matrix (Fin 5) (Fin 5) (ZMod 2)) : Prop :=
  A.BlockTriangular id ∧ ∀ i, A i i = 1

private theorem unitriangular_mul {A B : Matrix (Fin 5) (Fin 5) (ZMod 2)}
    (hA : Unitriangular A) (hB : Unitriangular B) : Unitriangular (A * B) := by
  refine ⟨hA.1.mul hB.1, ?_⟩
  intro i
  rw [Matrix.mul_apply, Finset.sum_eq_single i]
  · rw [hA.2, hB.2, one_mul]
  · intro j _ hji
    by_cases h : j < i
    · rw [hA.1 h, zero_mul]
    · rw [hB.1 (lt_of_le_of_ne (le_of_not_gt h) (Ne.symm hji)), mul_zero]
  · simp

private theorem unitriangular_transvection (i j : Fin 5) (hij : i < j) (c : ZMod 2) :
    Unitriangular (Matrix.SpecialLinearGroup.transvection (ne_of_lt hij) c).1 := by
  refine ⟨Matrix.blockTriangular_transvection (b := id) hij.le c, ?_⟩
  intro k
  simp only [Matrix.SpecialLinearGroup.transvection_coe, Matrix.add_apply, Matrix.one_apply_eq]
  have h : Matrix.single i j c k k = 0 := by
    by_cases hk : k = i
    · subst k; simp [(ne_of_lt hij).symm]
    · simp [Ne.symm hk]
  rw [h, add_zero]

private theorem upperRoot_unitriangular {g : Group} (hg : g ∈ upperRootSubgroup) :
    Unitriangular g.1 := by
  induction hg using Subgroup.closure_induction'' with
  | mem g hg =>
    obtain ⟨i,j,hij,rfl⟩ := hg
    exact unitriangular_transvection i j hij 1
  | inv_mem g hg =>
    obtain ⟨i,j,hij,rfl⟩ := hg
    rw [Matrix.SpecialLinearGroup.transvection_inv]
    exact unitriangular_transvection i j hij (-1)
  | one => exact ⟨Matrix.blockTriangular_one, fun i => Matrix.one_apply_eq i⟩
  | mul g h _ _ hg hh => exact unitriangular_mul hg hh

private theorem unitriangular_pow_eight {A : Matrix (Fin 5) (Fin 5) (ZMod 2)}
    (hA : Unitriangular A) : A ^ 8 = 1 := by
  have hchar : A.charpoly = (Polynomial.X - Polynomial.C 1) ^ 5 := by
    rw [Matrix.charpoly_of_isUpperTriangular A hA.1]
    simp_rw [hA.2]
    simp
  have hnil : (A - 1) ^ 5 = 0 := by
    have h := Matrix.aeval_self_charpoly A
    rw [hchar] at h
    simpa using h
  have hnil' : (A - 1) ^ (2 ^ 3) = 0 := pow_eq_zero_of_le (by decide) hnil
  let : ExpChar (Matrix (Fin 5) (Fin 5) (ZMod 2)) 2 :=
    expChar_of_injective_algebraMap
      (FaithfulSMul.algebraMap_injective (ZMod 2) (Matrix (Fin 5) (Fin 5) (ZMod 2))) 2
  have h := add_pow_expChar_pow_of_commute 2 3 (Commute.one_left (A - 1))
  have hsum : (1 : Matrix (Fin 5) (Fin 5) (ZMod 2)) + (A - 1) = A := by
    rw [add_comm, sub_add_cancel]
  rw [hsum, one_pow, hnil', add_zero] at h
  norm_num only at h
  exact h

/-- The subgroup generated by positive binary root transvections is a 2-group. -/
theorem upperRootSubgroup_isPGroup : IsPGroup 2 upperRootSubgroup := by
  intro g
  refine ⟨3, ?_⟩
  apply Subtype.ext
  apply Subtype.ext
  simpa only [Subgroup.coe_pow, Subgroup.coe_one, Matrix.SpecialLinearGroup.coe_pow,
    Matrix.SpecialLinearGroup.coe_one, show (2 : ℕ) ^ 3 = 8 by decide] using unitriangular_pow_eight (upperRoot_unitriangular g.property)

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] [Nontrivial V]

/-- Every nonzero finite-dimensional binary SL₅ module has a nonzero upper-fixed vector. -/
theorem exists_nonzero_upperFixed (ρ : Representation (ZMod 2) Group V) :
    ∃ v : V, v ≠ 0 ∧ UpperFixed ρ v := by
  obtain ⟨v, hv, hfix⟩ := Representation.pGroup_fix_nonzero_vector
    (F := ZMod 2) (by simp [ZMod.ringChar_zmod_n])
    (by simpa only [ZMod.ringChar_zmod_n] using upperRootSubgroup_isPGroup)
    (ρ.comp upperRootSubgroup.subtype)
  refine ⟨v, hv, (upperFixed_iff_fixed_subgroup ρ v).2 ?_⟩
  intro g hg
  exact hfix ⟨g, hg⟩

/-- The upper-fixed subspace of a nonzero finite-dimensional binary SL₅ module is nonzero. -/
theorem upperFixedSubmodule_ne_bot (ρ : Representation (ZMod 2) Group V) :
    upperFixedSubmodule ρ ≠ ⊥ := by
  obtain ⟨v, hv, hfix⟩ := exists_nonzero_upperFixed ρ
  intro h
  have hmem : v ∈ upperFixedSubmodule ρ := hfix
  rw [h] at hmem
  exact hv hmem

end Representation.SL5TenDimensional.Classification.HeckeAction
