module

public import Mathlib.RepresentationTheory.Irreducible
public import Mathlib.RepresentationTheory.Invariants
public import Mathlib.LinearAlgebra.Dimension.Finrank
public import Mathlib.LinearAlgebra.Dimension.RankNullity
import Mathlib.Tactic.NoncommRing
import Lean.Elab.Tactic.Omega

/-!
# Scott's fixed-space inequality for a generating pair

For endomorphisms A and B with no common fixed vector, the fixed space of
AB embeds in the intersection of their displacement ranges by v ↦ (B−1)v.
If those ranges span the ambient space, rank-nullity gives Scott's bound.
A nontrivial irreducible representation of a group generated by a and b
satisfies both hypotheses. In characteristic two an involution also fixes
at least half the ambient dimension, since its displacement squares to zero.

These general linear-algebra facts are used on the literal J₂ generating
pair in the parent CubicFixedSpace module. Source application:
Guralnick--Malle, Classification of 2F-modules I, Proposition 5.1, p.16.
-/

public section
namespace Representation.FixedSpaceTriangle
variable {K V G : Type*} [Field K] [AddCommGroup V] [Module K V]
  [FiniteDimensional K V] [Group G]

/-- The intersection form of Scott's inequality for two operators. -/
theorem linear_bound (A B : Module.End K V)
    (hker : (A - 1).ker ⊓ (B - 1).ker = ⊥)
    (hrange : (A - 1).range ⊔ (B - 1).range = ⊤) :
    Module.finrank K (A - 1).ker + Module.finrank K (B - 1).ker +
      Module.finrank K (A * B - 1).ker ≤ Module.finrank K V := by
  let f : (A * B - 1).ker →ₗ[K] ↥((A - 1).range ⊓ (B - 1).range) :=
    ((B - 1).comp (A * B - 1).ker.subtype).codRestrict _ (by
      intro v
      have hv : A (B v) = v := sub_eq_zero.mp v.property
      constructor
      · refine ⟨-B v, ?_⟩
        change A (-B v) - -B v = B v - v
        rw [map_neg, hv]
        abel
      · exact ⟨v, rfl⟩)
  have hf : Function.Injective f := by
    apply LinearMap.ker_eq_bot.mp
    apply le_bot_iff.mp
    intro v hv
    have hB : B v = v := by
      have hh := congrArg Subtype.val hv
      exact sub_eq_zero.mp hh
    have hA : A v = v := by
      have hh : A (B v) = v := sub_eq_zero.mp v.property
      rwa [hB] at hh
    apply Subtype.ext
    have hh : (v : V) ∈ (A - 1).ker ⊓ (B - 1).ker :=
      ⟨sub_eq_zero.mpr hA, sub_eq_zero.mpr hB⟩
    rwa [hker] at hh
  have hle := LinearMap.finrank_le_finrank_of_injective hf
  have hsum := Submodule.finrank_sup_add_finrank_inf_eq
    (A - 1).range (B - 1).range
  rw [hrange, finrank_top] at hsum
  have hA := (A - 1).finrank_range_add_finrank_ker
  have hB := (B - 1).finrank_range_add_finrank_ker
  omega

/-- A generating pair satisfies Scott's fixed-space inequality on any
nontrivial irreducible representation. -/
theorem representation_bound (ρ : Representation K G V) (hi : ρ.IsIrreducible)
    (hnt : ∃ g, ρ g ≠ 1) (a b : G)
    (hgen : Subgroup.closure ({a, b} : Set G) = ⊤) :
    Module.finrank K (ρ a - 1).ker + Module.finrank K (ρ b - 1).ker +
      Module.finrank K (ρ (a * b) - 1).ker ≤ Module.finrank K V := by
  have hfix (v : V) (ha : ρ a v = v) (hb : ρ b v = v) : ∀ g, ρ g v = v := by
    intro g
    have hg : g ∈ Subgroup.closure ({a, b} : Set G) := hgen ▸ Subgroup.mem_top g
    induction hg using Subgroup.closure_induction with
    | mem x hx => rcases hx with rfl | hx; exact ha; simpa only [Set.mem_singleton_iff] using hx ▸ hb
    | one => simp
    | mul x y hx hy ihx ihy => simp only [map_mul, Module.End.mul_apply, ihy, ihx]
    | inv x hx ih =>
      have hh := congrArg (ρ x⁻¹) ih
      simpa only [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one,
        Module.End.one_apply] using hh.symm
  have hker : (ρ a - 1).ker ⊓ (ρ b - 1).ker = ⊥ := by
    let S : Subrepresentation ρ := ⟨ρ.invariants, by
      intro g v hv
      simpa only [hv g] using hv⟩
    have hS : S = ⊥ := by
      rcases hi.eq_bot_or_eq_top S with h | h
      · exact h
      · obtain ⟨g, hg⟩ := hnt
        apply False.elim
        apply hg
        ext v
        have hv : v ∈ S.toSubmodule := by rw [h]; trivial
        exact hv g
    apply le_bot_iff.mp
    intro v hv
    have hh : v ∈ S.toSubmodule := hfix v (sub_eq_zero.mp hv.1) (sub_eq_zero.mp hv.2)
    rwa [hS] at hh
  let W := (ρ a - 1).range ⊔ (ρ b - 1).range
  have hmove (g : G) (v : V) : ρ g v - v ∈ W := by
    have hg : g ∈ Subgroup.closure ({a, b} : Set G) := hgen ▸ Subgroup.mem_top g
    induction hg using Subgroup.closure_induction generalizing v with
    | mem x hx =>
      rcases Set.mem_insert_iff.mp hx with hx | hx
      · rw [hx]
        exact (show (ρ a - 1).range ≤ W from le_sup_left) (show ρ a v - v ∈ (ρ a - 1).range from ⟨v, rfl⟩)
      · have hx : x = b := hx
        rw [hx]
        exact (show (ρ b - 1).range ≤ W from le_sup_right) (show ρ b v - v ∈ (ρ b - 1).range from ⟨v, rfl⟩)
    | one => simp
    | mul x y hx hy ihx ihy =>
      have hh := W.add_mem (ihx (ρ y v)) (ihy v)
      simpa only [map_mul, Module.End.mul_apply, sub_add_sub_cancel] using hh
    | inv x hx ih =>
      have hh := W.neg_mem (ih (ρ x⁻¹ v))
      simpa only [← Module.End.mul_apply, ← map_mul, mul_inv_cancel, map_one,
        Module.End.one_apply, neg_sub] using hh
  have hrange : W = ⊤ := by
    let S : Subrepresentation ρ := ⟨W, by
      intro g v hv
      simpa only [sub_add_cancel] using W.add_mem (hmove g v) hv⟩
    rcases hi.eq_bot_or_eq_top S with h | h
    · have hW : W = ⊥ := congrArg Subrepresentation.toSubmodule h
      obtain ⟨g, hg⟩ := hnt
      apply False.elim
      apply hg
      ext v
      have hv := hmove g v
      rw [hW, Submodule.mem_bot] at hv
      exact sub_eq_zero.mp hv
    · exact congrArg Subrepresentation.toSubmodule h
  rw [map_mul]
  exact linear_bound (ρ a) (ρ b) hker hrange

/-- For a binary involution, its displacement lies in its fixed space. -/
theorem involution_half [CharP K 2] (A : Module.End K V) (hA : A ^ 2 = 1) :
    Module.finrank K V ≤ 2 * Module.finrank K (A - 1).ker := by
  have htwice (T : Module.End K V) : T + T = 0 := by
    calc
      T + T = (2 : K) • T := (two_smul K T).symm
      _ = 0 := by rw [show (2 : K) = 0 from CharP.cast_eq_zero K 2, zero_smul]
  have hzero : (A - 1) * (A - 1) = 0 := by
    calc
      (A - 1) * (A - 1) = A ^ 2 - (A + A) + 1 := by noncomm_ring
      _ = 0 := by rw [hA, htwice, sub_zero, htwice]
  have hle : (A - 1).range ≤ (A - 1).ker := by
    rintro v ⟨w, rfl⟩
    change ((A - 1) * (A - 1)) w = 0
    rw [hzero, LinearMap.zero_apply]
  have hdim := Submodule.finrank_mono hle
  have hrank := (A - 1).finrank_range_add_finrank_ker
  omega

end Representation.FixedSpaceTriangle
