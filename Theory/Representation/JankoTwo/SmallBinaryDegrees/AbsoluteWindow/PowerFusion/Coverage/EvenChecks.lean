private theorem block_check (b : Fin 30) : BlockCheck b := by
  fin_cases b
  · exact block00
  · exact block01
  · exact block02
  · exact block03
  · exact block04
  · exact block05
  · exact block06
  · exact block07
  · exact block08
  · exact block09
  · exact block10
  · exact block11
  · exact block12
  · exact block13
  · exact block14
  · exact block15
  · exact block16
  · exact block17
  · exact block18
  · exact block19
  · exact block20
  · exact block21
  · exact block22
  · exact block23
  · exact block24
  · exact block25
  · exact block26
  · exact block27
  · exact block28
  · exact block29

public theorem central_check : ∀ i : Fin 1920, ∀ k : Fin 4,
    normalForm (centralConjugator i)
      (normalForm (representativeIndex (centralClass i)) (k.castLE (by decide))) =
    GeneratorPair.FirstFusion.LocalCertificate.value i
      (normalForm (centralConjugator i) (k.castLE (by decide))) := by
  intro i k
  let b : Fin 30 := ⟨i.val / 64, by omega⟩
  let j : Fin 64 := ⟨i.val % 64, Nat.mod_lt _ (by decide)⟩
  have he : blockIndex b j = i := by
    apply Fin.ext
    simp only [blockIndex, b, j]
    omega
  exact he ▸ block_check b j k

set_option maxRecDepth 10000 in
public theorem noncentral_check : ∀ i : Fin 240, ∀ k : Fin 4,
    normalForm (noncentralConjugator i)
      (normalForm (representativeIndex (noncentralClass i)) (k.castLE (by decide))) =
    conjugatorTable i
      (normalForm (noncentralConjugator i) (k.castLE (by decide))) := by
  apply allFin
  decide +kernel

