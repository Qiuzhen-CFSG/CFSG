module

public import Theory.Representation.JankoTwo.SmallBinaryDegrees.AbsoluteWindow.PowerFusion.Coverage.EvenData
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.GeneratorPair.FirstFusion.LocalFusion.Soundness
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.GeneratorPair.SecondOrbits.OrbitRepresentatives
import Mathlib.Tactic.FinCases

/-!
# Four-point checks for the involution-centralizer conjugators

The literal carrier has a certified base of size four. These checks verify
`c * r = x * c` on that base for each of the 2160 previously enumerated
centralizer elements. `Even` supplies the carrier interpretation and the
coverage application.

A single 1920-row kernel check used 6.6 GB peak memory. The central check is
therefore divided into 30 private 64-row checks, elaborated sequentially;
this bounds the temporary reduction cache without changing the certificate.
Source: retained ATLAS `J2G1-p100B0` data, generated by `source/generate_even.py`.
-/

namespace Sporadic.LeechRelated.J2.PowerFusionCertificate.EvenCertificates
open GeneratorPair.SecondOrbitCertificate

-- The measured monolithic check had excessive transient memory use.
set_option Elab.async false

private def blockIndex (b : Fin 30) (j : Fin 64) : Fin 1920 :=
  ⟨64 * b.val + j.val, by omega⟩

private def BlockCheck (b : Fin 30) : Prop := ∀ j : Fin 64, ∀ k : Fin 4,
  let i := blockIndex b j
  normalForm (centralConjugator i)
    (normalForm (representativeIndex (centralClass i)) (k.castLE (by decide))) =
  GeneratorPair.FirstFusion.LocalCertificate.value i
    (normalForm (centralConjugator i) (k.castLE (by decide)))

set_option maxRecDepth 10000 in
private theorem block00 : BlockCheck 0 := by
  unfold BlockCheck
  apply allFin
  decide +kernel

