def classOfCode (r : Nat) : Fin 21 := ⟨r % 21, Nat.mod_lt _ (by decide)⟩

def conjugatorOfCode (r : Nat) : Index :=
  (⟨r / 21 % 100, Nat.mod_lt _ (by decide)⟩,
   ⟨r / 2100 % 63, Nat.mod_lt _ (by decide)⟩,
   ⟨r / 132300 % 24, Nat.mod_lt _ (by decide)⟩,
   ⟨r / 3175200 % 4, Nat.mod_lt _ (by decide)⟩)

def centralClass (i : Fin 1920) : Fin 21 := classOfCode (centralCode i)
def centralConjugator (i : Fin 1920) : Index := conjugatorOfCode (centralCode i)
def noncentralClass (i : Fin 240) : Fin 21 := classOfCode (noncentralCode i)
def noncentralConjugator (i : Fin 240) : Index := conjugatorOfCode (noncentralCode i)

