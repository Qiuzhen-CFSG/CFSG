variable (F : Type*) [Field F] [CharP F 2]

def generatorA := Binary.eval F 36 aData
def generatorB := Binary.eval F 36 bData

def column : Fin 36 → F := fun k => Binary.eval F 36 vData k 0

def row : Fin 36 → F := Binary.eval F 36 lData 0

def binaryHorner {R : Type*} [Semiring R] (t : R) : List Bool → R
  | [] => 0
  | c :: cs => (if c then 1 else 0) + t * binaryHorner t cs

/-- The recorded algebra element, using displayed-order words. -/
def algebraElement := algebraExpr.eval (generatorA F) (generatorB F)

/-- Evaluation of the recorded constant-first degree-35 polynomial. -/
def polynomialValue := binaryHorner (algebraElement F) coefficients

theorem rankOne_value : rankExpr.eval (generatorA F) (generatorB F) =
    Matrix.vecMulVec (column F) (row F) :=
  (checked097 F).trans (eval_outer F 36 d091 vData lData 0
    (by decide +kernel))

theorem polynomial_rankOne : polynomialValue F = Matrix.vecMulVec (column F) (row F) := by
  rw [← rankOne_value F]
  simp only [polynomialValue, algebraElement, algebraExpr, rankExpr, coefficients,
    binaryHorner, e097, e096, e095, e094, e093, e092, e091, e090, e089, e088, e087, e086, e085, e084, e083, e082, e081, e080, e079, e078, e077, e076, e075, e074, e073, e072, e071, e070, e069, e068, e067, e066, e065, e064, e063, e062, e061, e060, e059, e058, e057, e056, e055, e054, e053, e052, e051, e050, e049, e048, e047, e046, e045, e044, e043, e042, e041, e000, Expr.eval, Bool.false_eq_true, ↓reduceIte, mul_one, mul_zero, add_zero, zero_add]

theorem rankOne_mem : Matrix.vecMulVec (column F) (row F) ∈
    Algebra.adjoin F ({generatorA F, generatorB F} :
      Set (Matrix (Fin 36) (Fin 36) F)) := by
  rw [← rankOne_value F]
  exact Expr.mem _ _ _

