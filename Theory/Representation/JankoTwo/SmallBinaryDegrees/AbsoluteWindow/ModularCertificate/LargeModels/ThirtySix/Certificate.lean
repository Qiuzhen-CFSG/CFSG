theorem left_inverse : Binary.eval F 36 pData * Binary.eval F 36 piData = 1 :=
  Binary.eval_inverse F 36 pData piData
    (Binary.checkInverse_sound 36 pData piData (by decide +kernel))

theorem right_inverse : Binary.eval F 36 qiData * Binary.eval F 36 qData = 1 :=
  Binary.eval_inverse F 36 qiData qData
    (Binary.checkInverse_sound 36 qiData qData (by decide +kernel))

theorem matrix_relator0 : generatorA F * generatorA F = 1 := by
  have h := (checked003 F).trans (identity_value F)
  simpa only [generatorA, generatorB, e003, e001,
    Expr.eval, pow_succ, pow_zero, mul_one, one_mul, mul_assoc] using h

theorem matrix_relator1 : generatorB F * generatorB F * generatorB F = 1 := by
  have h := (checked005 F).trans (identity_value F)
  simpa only [generatorA, generatorB, e005, e004, e002,
    Expr.eval, pow_succ, pow_zero, mul_one, one_mul, mul_assoc] using h

theorem matrix_relator2 : (generatorA F * generatorB F) ^ 7 = 1 := by
  have h := (checked010 F).trans (identity_value F)
  have hw : (generatorA F * generatorB F) = e006.eval (Binary.eval F 36 aData) (Binary.eval F 36 bData) := by
    simp only [generatorA, generatorB, e006, e002, e001, Expr.eval]
  rw [hw]
  simpa only [e010, e009, e008, e007,
    Expr.eval, pow_succ, pow_zero, mul_one, one_mul, mul_assoc] using h

theorem matrix_relator3 : (generatorA F * (generatorB F * generatorB F) * generatorA F * generatorB F) ^ 12 = 1 := by
  have h := (checked017 F).trans (identity_value F)
  have hw : (generatorA F * (generatorB F * generatorB F) * generatorA F * generatorB F) = e013.eval (Binary.eval F 36 aData) (Binary.eval F 36 bData) := by
    simp only [generatorA, generatorB, e013, e012, e011, e004, e002, e001, Expr.eval, mul_assoc]
  rw [hw]
  simpa only [e017, e016, e015, e014,
    Expr.eval, pow_succ, pow_zero, mul_one, one_mul, mul_assoc] using h

theorem matrix_relator4 : (generatorA F * generatorB F * generatorA F * generatorB F * generatorA F *
      (generatorB F * generatorB F) * generatorA F * generatorB F * generatorA F *
      (generatorB F * generatorB F)) ^ 6 = 1 := by
  have h := (checked030 F).trans (identity_value F)
  have hw : (generatorA F * generatorB F * generatorA F * generatorB F * generatorA F *
      (generatorB F * generatorB F) * generatorA F * generatorB F * generatorA F *
      (generatorB F * generatorB F)) = e027.eval (Binary.eval F 36 aData) (Binary.eval F 36 bData) := by
    simp only [generatorA, generatorB, e027, e026, e025, e024, e023, e022, e021, e020, e019, e018, e006, e002, e001, Expr.eval, mul_assoc]
  rw [hw]
  simpa only [e030, e029, e028,
    Expr.eval, pow_succ, pow_zero, mul_one, one_mul, mul_assoc] using h

/-- The literal first ATLAS matrix, with its checked inverse. -/
def unitA : (Matrix (Fin 36) (Fin 36) F)ˣ :=
  ⟨generatorA F, generatorA F, matrix_relator0 F, matrix_relator0 F⟩

/-- The literal second ATLAS matrix, whose inverse is its square. -/
def unitB : (Matrix (Fin 36) (Fin 36) F)ˣ :=
  ⟨generatorB F, generatorB F * generatorB F,
    by simpa only [mul_assoc] using matrix_relator1 F, matrix_relator1 F⟩

theorem relations : Presentation.Relations (unitA F) (unitB F) := by
  intro i
  fin_cases i
  · apply Units.ext
    change generatorA F ^ 2 = 1
    simpa only [pow_two] using matrix_relator0 F
  · apply Units.ext
    change generatorB F ^ 3 = 1
    simpa only [pow_succ, pow_zero, one_mul] using matrix_relator1 F
  · apply Units.ext
    exact matrix_relator2 F
  · apply Units.ext
    exact matrix_relator3 F
  · apply Units.ext
    exact matrix_relator4 F

