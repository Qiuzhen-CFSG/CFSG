def checks : List Check := [
  .transpose Data.A aT,
  .transpose Data.B bT,
  .transpose Data.P pT,
  .inverse Data.P Data.Pi,
  .inverse Data.Qi Data.Q]

theorem checked : checkList 64 checks = true := by decide +kernel


theorem checked_left : checkOrbit 64 aT bT pT leftEdges = true := by decide +kernel

theorem checked_right : checkOrbit 64 Data.A Data.B Data.Q rightEdges = true := by decide +kernel

theorem left_seed : pT[0]! = Data.v := by decide +kernel

theorem right_seed : Data.Q[0]! = Data.lam := by decide +kernel

variable {F : Type*} [Field F] [CharP F 2]

theorem left_orbit (t : F) (ht : t ^ 2 = t + 1)
    (S : Subalgebra F (Matrix (Fin 64) (Fin 64) F))
    (hA : (eval t 64 Data.A) ∈ S) (hB : (eval t 64 Data.B) ∈ S) (i : Fin 64) :
    ∃ W ∈ S, W.mulVec (Packed.evalVector t 64 Data.v) = fun k => (eval t 64 Data.P) k i := by
  have hAt : (eval t 64 Data.A).transpose = (eval t 64 aT) :=
    checkList_sound t ht 64 checks checked 0 (by decide)
  have hBt : (eval t 64 Data.B).transpose = (eval t 64 bT) :=
    checkList_sound t ht 64 checks checked 1 (by decide)
  have hPt : (eval t 64 Data.P).transpose = (eval t 64 pT) :=
    checkList_sound t ht 64 checks checked 2 (by decide)
  have hz : (fun j : Fin 64 => Packed.evalVector t 64 pT[j.val]!) 0 = (Packed.evalVector t 64 Data.v) := by
    change Packed.evalVector t 64 pT[0]! = _
    rw [left_seed]
  have hs : ∀ k : Fin 64, k ≠ 0 → ∃ j : Fin 64, j < k ∧ ∃ M ∈ S,
      M.mulVec (Packed.evalVector t 64 pT[j.val]!) = Packed.evalVector t 64 pT[k.val]! := by
    intro k hk
    obtain ⟨j, hj, s, hs⟩ := orbit_steps t ht aT bT pT leftEdges checked_left k hk
    refine ⟨j, hj, (if s then (eval t 64 Data.B) else (eval t 64 Data.A)), ?_, ?_⟩
    · cases s
      · exact hA
      · exact hB
    · cases s
      · simp only [Bool.false_eq_true, ↓reduceIte] at hs ⊢
        rw [← hAt, Matrix.vecMul_transpose] at hs
        exact hs
      · simp only [↓reduceIte] at hs ⊢
        rw [← hBt, Matrix.vecMul_transpose] at hs
        exact hs
  obtain ⟨W, hW, hw⟩ := left_reachable S (Packed.evalVector t 64 Data.v)
    (fun j => Packed.evalVector t 64 pT[j.val]!) hz hs i
  refine ⟨W, hW, hw.trans ?_⟩
  exact (congrArg (fun M : Matrix (Fin 64) (Fin 64) F => M i) hPt).symm

theorem right_orbit (t : F) (ht : t ^ 2 = t + 1)
    (S : Subalgebra F (Matrix (Fin 64) (Fin 64) F))
    (hA : (eval t 64 Data.A) ∈ S) (hB : (eval t 64 Data.B) ∈ S) (i : Fin 64) :
    ∃ W ∈ S, Matrix.vecMul (Packed.evalVector t 64 Data.lam) W = (eval t 64 Data.Q) i := by
  have hz : (fun j : Fin 64 => Packed.evalVector t 64 Data.Q[j.val]!) 0 = (Packed.evalVector t 64 Data.lam) := by
    change Packed.evalVector t 64 Data.Q[0]! = _
    rw [right_seed]
  have hs : ∀ k : Fin 64, k ≠ 0 → ∃ j : Fin 64, j < k ∧ ∃ M ∈ S,
      Matrix.vecMul (Packed.evalVector t 64 Data.Q[j.val]!) M =
        Packed.evalVector t 64 Data.Q[k.val]! := by
    intro k hk
    obtain ⟨j, hj, s, hs⟩ := orbit_steps t ht Data.A Data.B Data.Q rightEdges checked_right k hk
    refine ⟨j, hj, (if s then (eval t 64 Data.B) else (eval t 64 Data.A)), ?_, hs⟩
    cases s
    · exact hA
    · exact hB
  exact right_reachable S (Packed.evalVector t 64 Data.lam) (fun j => Packed.evalVector t 64 Data.Q[j.val]!) hz hs i

/-- The proposed rank-one matrix and both invertible orbits generate every
matrix over the arbitrary coefficient field. No irreducibility is assumed. -/
theorem density (t : F) (ht : t ^ 2 = t + 1) :
    Algebra.adjoin F ({(eval t 64 Data.A), (eval t 64 Data.B)} : Set (Matrix (Fin 64) (Fin 64) F)) = ⊤ := by
  let S := Algebra.adjoin F ({(eval t 64 Data.A), (eval t 64 Data.B)} : Set (Matrix (Fin 64) (Fin 64) F))
  have hA : (eval t 64 Data.A) ∈ S := Algebra.subset_adjoin (by simp)
  have hB : (eval t 64 Data.B) ∈ S := Algebra.subset_adjoin (by simp)
  have hP : (eval t 64 Data.P) * (eval t 64 Data.Pi) = 1 :=
    checkList_sound t ht 64 checks checked 3 (by decide)
  have hQ : (eval t 64 Data.Qi) * (eval t 64 Data.Q) = 1 :=
    checkList_sound t ht 64 checks checked 4 (by decide)
  exact top_of_rankOne S (Packed.evalVector t 64 Data.v) (Packed.evalVector t 64 Data.lam)
    (eval t 64 Data.P) (eval t 64 Data.Pi) (eval t 64 Data.Q) (eval t 64 Data.Qi)
    (RankOne.rankOne_mem t ht S hA hB)
    (left_orbit t ht S hA hB) (right_orbit t ht S hA hB) hP hQ

