  have h1 : (eval t 64 Data.A) * (eval t 64 Data.B) = (eval t 64 w1) :=
    checkList_sound t ht 64 checks checked 1 (by decide)
  have h2 : (eval t 64 w0) * (eval t 64 w1) = (eval t 64 w2) :=
    checkList_sound t ht 64 checks checked 2 (by decide)
  have h3 : (eval t 64 w0) * (eval t 64 w0) = (eval t 64 w3) :=
