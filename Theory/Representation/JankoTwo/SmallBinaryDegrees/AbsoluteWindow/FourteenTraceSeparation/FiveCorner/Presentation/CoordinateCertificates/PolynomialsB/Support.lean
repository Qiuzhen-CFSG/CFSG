module

public import Theory.Representation.JankoTwo.SmallBinaryDegrees.AbsoluteWindow.FourteenTraceSeparation.FiveCorner.Presentation.CoordinateCertificates.Tables
public import Theory.Representation.JankoTwo.SmallBinaryDegrees.AbsoluteWindow.FourteenTraceSeparation.FiveCorner.MatrixCertificate.NumericalData

/-!
# Batch certificates for the middle coordinate polynomials

A Boolean list scan verifies each action against the fixed nine arrays.
The proved list-to-action bridge supplies the sparse table step equations;
separate checks verify binary parent closure and every relation term.

Source: `Presentation/source/README.md` and the unchanged
`complete-pair-certificates.json`. Generated by `PolynomialsB/source/generate.py`;
all numerical witnesses are checked by Lean's kernel.
-/

@[expose] public section
namespace Representation.JankoTwo.SmallBinaryDegrees.AbsoluteWindow.FiveCorner.Presentation.CoordinateCertificates.PolynomialsB

def stepCheck (i j : Fin 9) (table : ℕ → ℕ) (n : ℕ) : Bool :=
  if n < 2 then true else
    PackedBinaryRows.listProduct (table (n / 2)) 0
      (rows (if n.testBit 0 then j else i)).toList == table n

lemma steps_of_checks (i j : Fin 9) (table : ℕ → ℕ) (codes : List ℕ)
    (h : codes.all (stepCheck i j table) = true) :
    ∀ n ∈ codes.toFinset, 2 ≤ n →
      action (if n.testBit 0 then j else i) (table (n / 2)) = table n := by
  intro n hn hbig
  have hn' := List.all_eq_true.mp h n (List.mem_toFinset.mp hn)
  simp only [stepCheck, show ¬ n < 2 by omega, ↓reduceIte, beq_iff_eq] at hn'
  exact action_of_listProduct hn'

def maskCodes (bound mask : ℕ) : Finset ℕ :=
  (Finset.range bound).filter (fun n => mask.testBit n)

lemma mem_maskCodes {bound mask n : ℕ} :
    n ∈ maskCodes bound mask ↔ n < bound ∧ mask.testBit n = true := by
  simp only [maskCodes, Finset.mem_filter, Finset.mem_range]

lemma mask_steps (i j : Fin 9) (table : ℕ → ℕ) (bound mask : ℕ)
    (codes : List ℕ)
    (hcodes : codes = (List.range bound).filter (fun n => mask.testBit n))
    (h : codes.all (stepCheck i j table) = true) :
    ∀ n ∈ maskCodes bound mask, 2 ≤ n →
      action (if n.testBit 0 then j else i) (table (n / 2)) = table n := by
  intro n hn hbig
  apply steps_of_checks i j table codes h n _ hbig
  apply List.mem_toFinset.mpr
  rw [hcodes, List.mem_filter]
  exact ⟨List.mem_range.mpr (mem_maskCodes.mp hn).1, (mem_maskCodes.mp hn).2⟩

lemma mask_parents (bound mask : ℕ)
    (h : (List.range bound).all (fun n => !mask.testBit n || n < 2 ||
      mask.testBit (n / 2)) = true) :
    ∀ n ∈ maskCodes bound mask, 2 ≤ n → n / 2 ∈ maskCodes bound mask := by
  intro n hn hbig
  obtain ⟨hn, hm⟩ := mem_maskCodes.mp hn
  have h' := List.all_eq_true.mp h n (List.mem_range.mpr hn)
  apply mem_maskCodes.mpr
  refine ⟨by omega, ?_⟩
  simpa only [hm, Bool.not_true, show ¬ n < 2 by omega, decide_false,
    Bool.false_or] using h'

lemma mask_membership (terms : List ℕ) (bound mask : ℕ)
    (h : terms.all (fun n => n < bound && mask.testBit n) = true) :
    ∀ n ∈ terms, n ∈ maskCodes bound mask := by
  intro n hn
  have h' := List.all_eq_true.mp h n hn
  apply mem_maskCodes.mpr
  simpa only [Bool.and_eq_true, decide_eq_true_eq] using h'

end Representation.JankoTwo.SmallBinaryDegrees.AbsoluteWindow.FiveCorner.Presentation.CoordinateCertificates.PolynomialsB
