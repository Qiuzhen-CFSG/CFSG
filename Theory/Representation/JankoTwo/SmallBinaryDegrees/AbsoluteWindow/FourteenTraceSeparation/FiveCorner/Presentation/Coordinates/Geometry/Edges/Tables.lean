def flatLetterBase : Nat := 0x9b585156ebc9d32cd044f6ebc9d3

def flatLookup (w code x : Nat) : Nat := (code >>> (w*x)) % 2^w

def fastMap (code row x : Nat) : Nat := (code >>> (7*(100*row+x))) % 128 % 100

def fastNormal (n x : Nat) : Nat :=
  fastMap flatRep0 (n % 100)
    (fastMap flatRep1 (n / 100 % 63)
      (fastMap flatRep2 (n / 6300 % 24)
        (fastMap flatRep3 (n / 151200 % 4) x)))

def fastAction (l x : Nat) : Nat :=
  flatLookup 15 (if l = 0 then flatactionA else if l = 1 then flatactionB else
    if l = 2 then flatactionA else flatactionBInv) x % 24192

def fastPower (l x : Nat) : Nat :=
  flatLookup 5 (if l = 0 then flatedgePowersA else if l = 1 then flatedgePowersB else
    if l = 2 then flatedgePowersA else flatedgePowersBInv) x

def rawEdge (x l j : Nat) : Prop :=
  fastNormal (flatLookup 20 flatnormalFormCodes x)
    (flatLookup 7 flatLetterBase (4*l+j) % 100) =
  fastMap flatPowerMap ((fastPower l x) % 5 + 5*((fastPower l x)/5%5))
    (fastNormal (flatLookup 20 flatnormalFormCodes (fastAction l x)) j)

instance (x l j : Nat) : Decidable (rawEdge x l j) := by
  unfold rawEdge
  infer_instance

