def packedIndex (p : P) : ℕ := 11 * p.1.val + p.2.val
def packedKernel (k : Fin 44) : ℕ := (kernelPacked[k.val]?).getD 0
def packedExterior (j : Fin 2) (p : P) : ℕ :=
  (((![exteriorA, exteriorB] j)[packedIndex p]?).getD 0)
def selected (k : Fin 44) (p : P) : Bool :=
  if p.1 < p.2 then ((masks[k.val]?).getD 0).testBit (pairIndex p) else false

theorem selected_bit (k : Fin 44) (p : P) :
    (if selected k p then (1 : F) else 0) = coeff k p := by
  dsimp [selected, coeff, Data.bit]
  split_ifs <;> simp_all

theorem decode_kernel : ∀ (k : Fin 44) (p : P),
    Data.bit (packedKernel k) (packedIndex p) = coeff k p := by decide +kernel

theorem decode_exterior : ∀ (j : Fin 2) (p q : P),
    Data.bit (packedExterior j p) (packedIndex q) =
      wedgeCoords (codeColumn j p.1) (codeColumn j p.2) q := by decide +kernel

def rowProduct (p : P) : ℕ :=
  ((m24GolayRow p.1.castSucc) &&& (m24GolayRow p.2.castSucc)).toNat

theorem decode_product : ∀ (p : P) (q : Fin 24),
    Data.bit (rowProduct p) q.val = row p.1.castSucc q * row p.2.castSucc q := by
  decide +kernel


