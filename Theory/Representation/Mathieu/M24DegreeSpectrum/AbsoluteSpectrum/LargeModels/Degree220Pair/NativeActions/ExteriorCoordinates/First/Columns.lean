/-- Every packed input bit is checked against the published native matrix. -/
theorem columnA_bits (i : Fin 11) (k : Fin 5) (j : Fin 462) :
    (columnA i k).testBit j.val = codeBit false i (fiveTuple j k) := by
  fin_cases i
  · exact columnA_bits_0 k j
  · exact columnA_bits_1 k j
  · exact columnA_bits_2 k j
  · exact columnA_bits_3 k j
  · exact columnA_bits_4 k j
  · exact columnA_bits_5 k j
  · exact columnA_bits_6 k j
  · exact columnA_bits_7 k j
  · exact columnA_bits_8 k j
