/-!
# Density reductions for the degree-120 and degree-252 M24 candidates

Starting from the explicit node-19 norm in each candidate algebra, checked
contractions produce a rank-one operator. Checked row and column orbit bases
then produce every matrix unit. These conditional interfaces retain membership of that initial norm in the
algebra generated by the two matrices. The independent norm certificates and
`MatrixDensity.lean` discharge that premise. Keeping the reductions here lets
the norm certificates apply them without importing their final assembly.

The native-action applications retain both the actual native realization and
the norm premise explicitly. Their original public statements and names are
re-exported by `MatrixDensity.lean`.

Sources: the ATLAS matrices M24G1-f2r120B0 and M24G1-f2r252B0, stored in
`source/`; James, J. Algebra 27 (1973), 57–111. Untrusted certificate discovery
is recorded in `source/README.md` and the bounded checker in
`MatrixDensity/source/`.
-/

public section
open Representation.MathieuSmall.M22Recognition.DegreeThirty.NineSubmodule.InducedHeads.HermitianFiltration.FactorAlgebras.Certificate
namespace Representation.Mathieu.M24DegreeSpectrum.AbsoluteSpectrum.LargeModels.Degrees120252

/-- The checked contractions and orbits reduce degree-120 density to its norm. -/
theorem matrix120_full_of_norm
    (Q : Subalgebra (ZMod 2) (Matrix (Fin 120) (Fin 120) (ZMod 2)))
    (hA : ∀ j : Fin 2, matrix120 j ∈ Q)
    (hnorm : matrix (n := 120) MatrixDensity.Degree120.c19 ∈ Q) : Q = ⊤ :=
  MatrixDensity.Degree120.full_of_rankOne Q hA
    (MatrixDensity.Degree120.rankOne_mem Q hA hnorm)

/-- Density proves absolute irreducibility for any actual native realization. -/
theorem NativeRealization.absolute120_of_norm (r : NativeRealization 120 matrix120)
    (hnorm : ∀ Q : Subalgebra (ZMod 2) (Matrix (Fin 120) (Fin 120) (ZMod 2)),
      (∀ j, matrix120 j ∈ Q) → matrix (n := 120) MatrixDensity.Degree120.c19 ∈ Q) :
    r.representation.IsAbsolutelyIrreducible :=
  r.absolute (fun Q hA => matrix120_full_of_norm Q hA (hnorm Q hA))

/-- The checked contractions and orbits reduce degree-252 density to its norm. -/
theorem matrix252_full_of_norm
    (Q : Subalgebra (ZMod 2) (Matrix (Fin 252) (Fin 252) (ZMod 2)))
    (hA : ∀ j : Fin 2, matrix252 j ∈ Q)
    (hnorm : matrix (n := 252) MatrixDensity.Degree252.c19 ∈ Q) : Q = ⊤ :=
  MatrixDensity.Degree252.full_of_rankOne Q hA
    (MatrixDensity.Degree252.rankOne_mem Q hA hnorm)

/-- Density proves absolute irreducibility for any actual native realization. -/
theorem NativeRealization.absolute252_of_norm (r : NativeRealization 252 matrix252)
    (hnorm : ∀ Q : Subalgebra (ZMod 2) (Matrix (Fin 252) (Fin 252) (ZMod 2)),
      (∀ j, matrix252 j ∈ Q) → matrix (n := 252) MatrixDensity.Degree252.c19 ∈ Q) :
    r.representation.IsAbsolutelyIrreducible :=
  r.absolute (fun Q hA => matrix252_full_of_norm Q hA (hnorm Q hA))

end Representation.Mathieu.M24DegreeSpectrum.AbsoluteSpectrum.LargeModels.Degrees120252
