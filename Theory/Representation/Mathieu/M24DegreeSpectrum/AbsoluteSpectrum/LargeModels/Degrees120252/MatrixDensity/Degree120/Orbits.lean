/-- The checked orbits discharge the spanning premises of the rank-one criterion. -/
theorem full_of_rankOne (Q : Subalgebra (ZMod 2) (Mat 120))
    (hA : ∀ j : Fin 2, matrix120 j ∈ Q)
    (huv : vecMulVec (vector (entry colsList 0)) (vector (entry rowsOrbitList 0)) ∈ Q) :
    Q = ⊤ := by
  have hA' : ∀ j : Fin 2, matrix (n := 120) (actors j) ∈ Q := hA
  apply full_of_orbits Q (fun j => matrix (actors j)) hA'
    colsList rowsOrbitList ciList riList cp rp ca ra cparent rparent
  · intro x
    have h := congrArg (vector (n := 120)) (cstep x)
    rw [vector_combine _ (show (transposed (ca x)).length = 120 from by
      generalize ca x = j; revert j; decide +kernel), transpose_checked,
      vecMul_transpose] at h
    exact h
  · intro x
    have h := congrArg (vector (n := 120)) (rstep x)
    rw [vector_combine _ (show (actors (ra x)).length = 120 from by
      generalize ra x = j; revert j; decide +kernel)] at h
    exact h
  · decide +kernel
  · decide +kernel
  · have h := product_rows (n := 120) ciList colsList c0 (by decide +kernel) cinverse
    intro i
    exact (h i).trans (by revert i; decide +kernel)
  · have h := product_rows (n := 120) riList rowsOrbitList c0 (by decide +kernel) rinverse
    intro i
