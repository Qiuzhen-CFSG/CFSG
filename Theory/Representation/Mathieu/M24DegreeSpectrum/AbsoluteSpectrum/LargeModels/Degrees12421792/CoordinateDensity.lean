module

public import Theory.Representation.AbsolutelyIrreducible
public import Mathlib.LinearAlgebra.Matrix.ToLin
public import Mathlib.Algebra.Algebra.Subalgebra.MulOpposite

/-!
# Absolute irreducibility from two coordinate matrices

A dense pair of matrices in the image of a genuine representation makes its
image algebra the full endomorphism algebra. Density survives scalar extension,
so this proves absolute irreducibility, not just binary irreducibility.
Transposition preserves density via the opposite matrix algebra; this accounts
for the row convention of the ATLAS files in the two concrete consumers.

The density argument extends the coordinate proof in
`G2DerivedPermutationFiltration/CycleFiltration/MatrixCriterion.lean`.
Source application: James, J. Algebra 27 (1973), 57–111; Guralnick–Malle,
Classification of 2F-modules I, Proposition 5.1, manuscript p.17.
-/

@[expose] public section
open Matrix
open scoped TensorProduct

namespace Representation.MatrixDensity

/-- The algebra generated by two literal matrices is the full matrix algebra. -/
def DensePair {k n : Type*} [Field k] [Fintype n] [DecidableEq n]
    (A B : Matrix n n k) : Prop :=
  ∀ Q : Subalgebra k (Matrix n n k), A ∈ Q → B ∈ Q → Q = ⊤

/-- Reversing the matrix convention preserves fullness of the generated algebra. -/
theorem DensePair.transpose {k n : Type*} [Field k] [Fintype n] [DecidableEq n]
    {A B : Matrix n n k} (h : DensePair A B) : DensePair Aᵀ Bᵀ := by
  intro Q ha hb
  let P := Q.op.comap (Matrix.transposeAlgEquiv (R := k) (m := n) (α := k)).toAlgHom
  have hp : P = ⊤ := h P ha hb
  apply top_unique
  intro M _
  have hm : Mᵀ ∈ P := by rw [hp]; trivial
  change Mᵀᵀ ∈ Q at hm
  simpa only [transpose_transpose] using hm

/-- Dense coordinate matrices in a genuine action prove absolute irreducibility. -/
theorem absolutelyIrreducible_of_coordinate_matrices
    {k G V n : Type*} [Field k] [Monoid G] [AddCommGroup V] [Module k V]
    [Fintype n] [DecidableEq n] [Nonempty n]
    (ρ : Representation k G V) (e : V ≃ₗ[k] (n → k))
    (a b : G) (A B : Matrix n n k)
    (ha : LinearMap.toMatrix' (e.conj (ρ a)) = A)
    (hb : LinearMap.toMatrix' (e.conj (ρ b)) = B)
    (hd : DensePair A B) : ρ.IsAbsolutelyIrreducible := by
  let : Nontrivial V := e.toEquiv.nontrivial
  let : FiniteDimensional k V := FiniteDimensional.of_injective e.toLinearMap e.injective
  have density : Algebra.adjoin k (Set.range ρ) = ⊤ := by
    let E : Module.End k V ≃ₐ[k] Matrix n n k :=
      (e.conjAlgEquiv k).trans LinearMap.toMatrixAlgEquiv'
    let P := Algebra.adjoin k (Set.range ρ)
    let Q := P.map E.toAlgHom
    have hA : A ∈ Q := by
      rw [← ha]
      exact ⟨ρ a, Algebra.subset_adjoin (Set.mem_range_self a), rfl⟩
    have hB : B ∈ Q := by
      rw [← hb]
      exact ⟨ρ b, Algebra.subset_adjoin (Set.mem_range_self b), rfl⟩
    have hQ := hd Q hA hB
    apply top_unique
    intro f _
    have hf : E f ∈ Q := by rw [hQ]; trivial
    obtain ⟨f', hf', he⟩ := hf
    exact E.injective he ▸ hf'
  refine ⟨?_⟩
  apply irreducible_of_jacobson_density_surjective
  exact (extendScalars_surj_iff (AlgebraicClosure k) ρ).mp density

end Representation.MatrixDensity
