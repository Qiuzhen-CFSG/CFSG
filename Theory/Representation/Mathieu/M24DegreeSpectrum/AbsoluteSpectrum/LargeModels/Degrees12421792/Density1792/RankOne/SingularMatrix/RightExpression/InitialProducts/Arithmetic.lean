module

public import Theory.Representation.Mathieu.M24DegreeSpectrum.AbsoluteSpectrum.LargeModels.Degrees12421792.Density1792.RankOne.SingularMatrix.RightExpression.ExpansionChecks.Arithmetic
/-!
# Checked block multiplication for the initial right products

Selected rows are added as ordinary natural numbers, in 32-row blocks. A
single bit mask keeps exactly the parities of their base-4096 coefficients.
The mask identity implies the original checker, without assuming that the
wide table is a valid expansion. Thus the actual BA, TB and UB consumers can
use the unchanged original tables. See `source/README.md` for attribution.
-/

@[expose] public section
namespace Representation.Mathieu.M24DegreeSpectrum.AbsoluteSpectrum.LargeModels.Degrees12421792.Density1792.RankOneCertificate.SingularMatrix.RightCertificate.InitialProducts
open ExpansionChecks
 theorem sumRow_zero (w : List Nat) : Wide.sumRow 0 w = 0 := by
  induction w with
  | nil => rfl
  | cons y ys ih => simp [Wide.sumRow, ih]

 theorem sumRow_append (x : Nat) (a b : List Nat) :
    Wide.sumRow x (a ++ b) = Wide.sumRow x a + Wide.sumRow (x / 2^a.length) b := by
  induction a generalizing x with
  | nil => simp [Wide.sumRow]
  | cons y ys ih =>
    simp only [List.cons_append, Wide.sumRow, ih, List.length_cons, pow_succ',
      Nat.div_div_eq_div_mul, Nat.add_assoc]

 theorem sumRow_mod (x : Nat) (w : List Nat) :
    Wide.sumRow (x % 2^w.length) w = Wide.sumRow x w := by
  induction w generalizing x with
  | nil => rfl
  | cons y ys ih =>
    simp only [Wide.sumRow, List.length_cons, pow_succ']
    rw [Nat.mod_mul_right_div_self, ih,
      Nat.mod_mod_of_dvd _ (dvd_mul_right 2 (2^ys.length))]

def accum : Nat → List Nat → Nat
  | _, [] => 0
  | x, y :: ys => (x % 2) * y + accum (x / 2) ys

theorem accum_eq_sumRow (x : Nat) (w : List Nat) : accum x w = Wide.sumRow x w := by
  induction w generalizing x with
  | nil => rfl
  | cons y ys ih =>
    simp only [accum, Wide.sumRow, ih]
    have hx : x % 2 < 2 := Nat.mod_lt _ (by decide)
    split_ifs with h
    · have he : x % 2 = 1 := by simpa using h
      simp [he]
    · have he : x % 2 = 0 := by
        have hn : x % 2 ≠ 1 := by simpa using h
        omega
      simp [he]


def accumBlocks (width : Nat) : Nat → List (List Nat) → Nat
  | _, [] => 0
  | x, ys :: yss =>
      (if x % 2^width == 0 then 0 else accum (x % 2^width) ys) +
        accumBlocks width (x / 2^width) yss

theorem accumBlocks_eq (width x : Nat) (ws : List (List Nat))
    (hw : ∀ w ∈ ws, w.length = width) : accumBlocks width x ws = Wide.sumRow x ws.flatten := by
  induction ws generalizing x with
  | nil => rfl
  | cons w ws ih =>
    have hl := hw w (by simp)
    have ht : ∀ u ∈ ws, u.length = width := fun u hu => hw u (by simp [hu])
    simp only [accumBlocks, List.flatten_cons, sumRow_append, hl, ih _ ht]
    congr 1
    have hm := sumRow_mod x w
    rw [hl] at hm
    split
    · next h =>
      have hx : x % 2^width = 0 := by simpa using h
      rw [hx, sumRow_zero] at hm
      exact hm
    · exact (accum_eq_sumRow _ _).trans hm

def mask : Nat → Nat
  | 0 => 0
  | n+1 => 1 + 4096 * mask n

theorem checkParity_of_mask (n x c : Nat) (h : x &&& mask n = expand n c) :
    Wide.checkParity n x c = true := by
  induction n generalizing x c with
  | zero => rfl
  | succ n ih =>
    simp only [Wide.checkParity, Bool.and_eq_true, beq_iff_eq]
    have hm := congrArg (fun z => z % 2) h
    have hd := congrArg (fun z => z / 4096) h
    have htwo : 2^1 = (2 : Nat) := rfl
    have hradix : 2^12 = (4096 : Nat) := rfl
    rw [← htwo, Nat.and_mod_two_pow, htwo] at hm
    simp [mask, expand, Nat.add_mod, Nat.mul_mod] at hm
    rw [← hradix, Nat.and_div_two_pow, hradix] at hd
    simp only [mask, expand] at hd
    have hc : c % 2 < 4096 := lt_trans (Nat.mod_lt _ (by decide)) (by decide)
    rw [Nat.add_mul_div_left _ _ (by decide), Nat.add_mul_div_left _ _ (by decide),
      Nat.div_eq_of_lt hc, Nat.zero_add] at hd
    norm_num at hd
    exact ⟨hm, ih _ _ hd⟩

theorem checkParity_of_mask_tree (k n x c m : Nat) (hm : mask n = m)
    (h : x &&& m = expandTree k n c) : Wide.checkParity n x c = true := by
  apply checkParity_of_mask
  simpa only [hm, expandTree_eq] using h


def checkBlocks (k n width m : Nat) (ws : List (List Nat)) : List Nat → List Nat → Bool
  | [], [] => true
  | a :: as, c :: cs =>
      ((accumBlocks width a ws &&& m) == expandTree k n c) && checkBlocks k n width m ws as cs
  | _, _ => false

theorem checkBlocks_sound (k n width m : Nat) (ws : List (List Nat))
    (a w c : List Nat) (hw : ∀ v ∈ ws, v.length = width) (he : ws.flatten = w)
    (hm : mask n = m) (h : checkBlocks k n width m ws a c = true) :
    Wide.checkRows n a w c = true := by
  induction a generalizing c with
  | nil => cases c <;> simp_all [checkBlocks, Wide.checkRows]
  | cons a as ih =>
    cases c with
    | nil => simp [checkBlocks] at h
    | cons c cs =>
      simp only [checkBlocks, Bool.and_eq_true, beq_iff_eq] at h
      simp only [Wide.checkRows, Bool.and_eq_true]
      refine ⟨?_, ih cs h.2⟩
      rw [← he, ← accumBlocks_eq width a ws hw]
      exact checkParity_of_mask_tree k n _ _ m hm h.1

/-- One bit at the bottom of each of the 1792 base-4096 digits. -/
def parityMask : Nat := nat_lit 

set_option maxRecDepth 8192 in
theorem mask_checked : mask 1792 = parityMask := by decide +kernel

end Representation.Mathieu.M24DegreeSpectrum.AbsoluteSpectrum.LargeModels.Degrees12421792.Density1792.RankOneCertificate.SingularMatrix.RightCertificate.InitialProducts
