  have h : squareWide.flatten = squareRows.flatten.map (expandTree 6 1792) := by
    simp only [squareWide, squareRows, List.map_flatten, List.map_cons, List.map_nil,
      wide00, wide01, wide02, wide03, wide04, wide05, wide06, wide07, wide08, wide09, wide10, wide11, wide12, wide13, wide14, wide15, wide16, wide17, wide18, wide19, wide20, wide21, wide22, wide23, wide24, wide25, wide26, wide27, wide28, wide29, wide30, wide31, wide32, wide33, wide34, wide35, wide36, wide37, wide38, wide39, wide40, wide41, wide42, wide43, wide44, wide45, wide46, wide47, wide48, wide49, wide50, wide51, wide52, wide53, wide54, wide55]
  have hf : expandTree 6 1792 = expand 1792 := funext (expandTree_eq 6 1792)
  simpa only [hf] using h

