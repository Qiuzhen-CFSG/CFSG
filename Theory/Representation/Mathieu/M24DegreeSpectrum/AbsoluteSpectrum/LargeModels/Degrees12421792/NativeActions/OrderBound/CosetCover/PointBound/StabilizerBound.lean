/-!+# Transfer from the bounded eight-generator presentation

A proposed comparison is specified by eight literal words. Proving all 29
source relations makes a homomorphism from the bounded abstract presentation;
proving generation separately makes it surjective. Their conjunction therefore
gives the requested bound for the original 437-relator presentation.

The two word-certificate obligations remain explicit. In particular, this
module does not yet establish the unconditional `presented_bound`.
Source: ATLAS M24G1-P1 and the independent Janko₄ local-order presentation;
see `StabilizerBound/source/README.md` for the precise markings.
-/

public section
namespace Representation.Mathieu.M24DegreeSpectrum.AbsoluteSpectrum.LargeModels.Degrees12421792.NativeActions.Presentation.OrderBound.CosetCover.PointSchreier.PointBound.Stabilizer
open Subgroup.CosetWordCertificate

namespace Comparison
open Janko4.Cardinality.QuotientCount.UpperBound.PresentationBound.StabilizerChain

/-- The map is defined only after every literal source relation has been proved. -/
def toPresented (h : Relations) : SourcePresented →* Presented :=
  PresentedGroup.toGroup (f := generator) (by
    rintro _ ⟨r, rfl⟩
    exact h r)

@[simp] theorem toPresented_generator (h : Relations) (a : Fin 8) :
    toPresented h (PresentedGroup.of a) = generator a := PresentedGroup.toGroup.of _

/-- The image is precisely the subgroup generated by the specified eight words. -/
theorem toPresented_range (h : Relations) : (toPresented h).range = subgroup := by
  rw [MonoidHom.range_eq_map,
    ← PresentedGroup.closure_range_of (Set.range level2RelatorWord),
    MonoidHom.map_closure, ← Set.range_comp]
  congr 1
  apply congrArg Set.range
  funext a
  exact toPresented_generator h a

theorem toPresented_surjective (hr : Relations) (hg : Generation) :
    Function.Surjective (toPresented hr) := by
  apply MonoidHom.range_eq_top.mp
  exact (toPresented_range hr).trans hg

/-- Relation lifting alone bounds the actual generated subgroup. -/
theorem subgroup_bound (hr : Relations) :
    Finite subgroup ∧ Nat.card subgroup ≤ 443520 := by
  let : Finite SourcePresented := source_bound.1
  have hf : Finite (toPresented hr).range :=
    Finite.of_surjective _ (toPresented hr).rangeRestrict_surjective
  have hc : Nat.card (toPresented hr).range ≤ 443520 :=
    (Nat.card_le_card_of_surjective _ (toPresented hr).rangeRestrict_surjective).trans
      source_bound.2
  rw [toPresented_range] at hf hc
  exact ⟨hf, hc⟩

end Comparison

/-- Final transfer; both independent word-certificate obligations must be discharged. -/
theorem presented_bound_of_comparison
    (hr : Comparison.Relations) (hg : Comparison.Generation) :
    Finite Presented ∧ Nat.card Presented ≤ 443520 := by
  let : Finite Comparison.SourcePresented := Comparison.source_bound.1
  have hs := Comparison.toPresented_surjective hr hg
  exact ⟨Finite.of_surjective _ hs,
    (Nat.card_le_card_of_surjective _ hs).trans Comparison.source_bound.2⟩

end Representation.Mathieu.M24DegreeSpectrum.AbsoluteSpectrum.LargeModels.Degrees12421792.NativeActions.Presentation.OrderBound.CosetCover.PointSchreier.PointBound.Stabilizer
