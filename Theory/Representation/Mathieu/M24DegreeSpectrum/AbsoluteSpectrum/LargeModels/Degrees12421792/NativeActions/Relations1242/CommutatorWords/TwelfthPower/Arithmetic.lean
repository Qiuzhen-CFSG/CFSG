module

public import Theory.Representation.Mathieu.M24DegreeSpectrum.AbsoluteSpectrum.LargeModels.Degrees12421792.NativeActions.Relations1792.GeneratorOrders.Checker

/-! Byte-wise widening and block assembly for the fixed twelfth-power certificate.
A checked 256-entry lookup expands eight binary digits at once. Its proof
reduces to the carry-free arithmetic already used by the balanced row checker.
The concrete consumers are the three widened tables and four products below;
see `source/README.md` for the ATLAS source and measured costs. -/

@[expose] public section
namespace Representation.Mathieu.M24DegreeSpectrum.AbsoluteSpectrum.LargeModels.Degrees12421792.NativeActions.Relations1242.CommutatorWords.TwelfthPower.Arithmetic
open Representation.Mathieu.M24DegreeSpectrum.AbsoluteSpectrum.LargeModels.Degrees12421792.NativeActions.Relations1792.Arithmetic
open Representation.Mathieu.M24DegreeSpectrum.AbsoluteSpectrum.LargeModels.Degrees12421792.NativeActions.Relations1792.GeneratorOrders
def byteTable : Nat := (nat_lit )
def byte (a : Nat) : Nat := byteTable / 2^(88*(a%256)) % 2^88
theorem byte_small : ∀ a : Fin 256, byte a.val = expand 8 a.val := by decide +kernel
theorem byte_eq (a : Nat) : byte a = expand 8 a := by
  have h := byte_small ⟨a%256, Nat.mod_lt _ (by decide)⟩
  calc
    byte a = expand 8 (a % 256) := by simpa only [byte, Nat.mod_mod] using h
    _ = expand 8 a := expand_mod 8 a
def expandBytes : Nat → Nat → Nat
  | 0, _ => 0
  | n+1, a => byte a + 2048^8 * expandBytes n (a/256)
theorem expandBytes_eq (n a : Nat) : expandBytes n a = expand (8*n) a := by
  induction n generalizing a with
  | zero => rfl
  | succ n ih =>
    rw [expandBytes, byte_eq, ih]
    change expand 8 a + 2048^8 * expand (8*n) (a/2^8) = _
    rw [← expand_add]
    congr 1
    omega
def expand1242 (a : Nat) : Nat := expandBytes 155 a + 2048^1240 * expand 2 (a/2^1240)
theorem expand1242_eq (a : Nat) : expand1242 a = expand 1242 a := by
  rw [expand1242, expandBytes_eq]
  exact (expand_add 1240 2 a).symm

def Maps {α β : Type} (f : α → β) : List (List α) → List (List β) → Prop
  | [], [] => True
  | a::as, b::bs => a.map f = b ∧ Maps f as bs
  | _, _ => False

theorem Maps.flatten {α β : Type} (f : α → β) (as : List (List α)) (bs : List (List β))
    (h : Maps f as bs) : as.flatten.map f = bs.flatten := by
  induction as generalizing bs with
  | nil => cases bs <;> simp_all [Maps]
  | cons a as ih =>
    cases bs with
    | nil => simp [Maps] at h
    | cons b bs =>
      obtain ⟨hab, ht⟩ := h
      simp only [List.flatten_cons, List.map_append, hab, ih bs ht]

theorem decodeRows_list (n : Nat) (xs : List Nat) :
    decodeRows n xs = Thompson.BinaryMatrix.decode n xs.toArray := by
  simpa only [List.toList_toArray] using decodeRows_array n xs.toArray

end Representation.Mathieu.M24DegreeSpectrum.AbsoluteSpectrum.LargeModels.Degrees12421792.NativeActions.Relations1242.CommutatorWords.TwelfthPower.Arithmetic
