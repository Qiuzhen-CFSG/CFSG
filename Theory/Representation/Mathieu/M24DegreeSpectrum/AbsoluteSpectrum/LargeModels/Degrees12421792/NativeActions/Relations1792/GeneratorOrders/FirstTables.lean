/-- The entire packed table is the proved radix expansion of the binary rows. -/
theorem firstWide_eq : firstWide.flatten = firstRows.flatten.map (expand 1792) := by
  have h : firstWide.flatten = firstRows.flatten.map (expandTree 6 1792) := by
    simp only [firstWide, firstRows, List.map_flatten, List.map_cons, List.map_nil,
      wide00, wide01, wide02, wide03, wide04, wide05, wide06, wide07, wide08, wide09, wide10, wide11, wide12, wide13, wide14, wide15, wide16, wide17, wide18, wide19, wide20, wide21, wide22, wide23, wide24, wide25, wide26, wide27, wide28, wide29, wide30, wide31, wide32, wide33, wide34, wide35, wide36, wide37, wide38, wide39, wide40, wide41, wide42, wide43, wide44, wide45, wide46, wide47, wide48, wide49, wide50, wide51, wide52, wide53, wide54, wide55]
  have hf : expandTree 6 1792 = expand 1792 := funext (expandTree_eq 6 1792)
  simpa only [hf] using h

set_option maxRecDepth 8192 in
/-- Checked bridge to the unchanged original ATLAS array. -/
theorem firstRows_eq : firstRows.flatten = Data1792.firstRows.toList := by
  decide +kernel

set_option maxRecDepth 8192 in
theorem firstRows_length : firstRows.flatten.length = 1792 := by
  decide +kernel

theorem firstRows_width : ∀ r ∈ firstRows, r.length = 32 := by
  have h : firstRows.all (fun r => r.length == 32) = true := by decide +kernel
  intro r hr
  simpa only [beq_iff_eq] using List.all_eq_true.mp h r hr

set_option maxRecDepth 8192 in
theorem firstTagged_eq : firstTagged.flatten.map Prod.fst = firstRows.flatten := by
  decide +kernel

set_option maxRecDepth 8192 in
theorem firstTagged_length : firstTagged.flatten.length = 1792 := by
  decide +kernel

/-- The checked table decodes to the literal untransposed matrix. -/
theorem firstRows_decode : decodeRows 1792 firstRows.flatten = Data1792.first := by
  rw [firstRows_eq, decodeRows_array]
  rfl

