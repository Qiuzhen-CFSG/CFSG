/-!
# Applying finite row certificates to the degree-320 trace test

Ten left multiplications by sparse original generators evaluate each word
`(A*B)^5*B`. The soundness theorem converts the packed row checks into actual
matrix products, and the two final diagonal sums are checked by the kernel.
The product checks remain explicit hypotheses; no external numerical output
is used as a proof. This supplies the literal trace-separation premise of
`pair320_of_certificates` once the finite certificates have been proved.

Generated by `source/generate_trace.py`; data provenance is in `source/README.md`.
-/

@[expose] public section
namespace Representation.Mathieu.M24DegreeSpectrum.AbsoluteSpectrum.LargeModels.Degree320Pair
open Thompson.BinaryMatrix

/-- Twenty finite row-product checks. No representation or irreducibility
conclusion is included in this contract. -/
def TraceRowChecks : Prop :=
  (checkRows Data.BaRows Data.BaRows Data.R2aRows = true ∧
    checkRows Data.AaRows Data.R2aRows Data.R3aRows = true ∧
    checkRows Data.BaRows Data.R3aRows Data.R4aRows = true ∧
    checkRows Data.AaRows Data.R4aRows Data.R5aRows = true ∧
    checkRows Data.BaRows Data.R5aRows Data.R6aRows = true ∧
    checkRows Data.AaRows Data.R6aRows Data.R7aRows = true ∧
    checkRows Data.BaRows Data.R7aRows Data.R8aRows = true ∧
    checkRows Data.AaRows Data.R8aRows Data.R9aRows = true ∧
    checkRows Data.BaRows Data.R9aRows Data.R10aRows = true ∧
    checkRows Data.AaRows Data.R10aRows Data.R11aRows = true) ∧
  (checkRows Data.BbRows Data.BbRows Data.R2bRows = true ∧
    checkRows Data.AbRows Data.R2bRows Data.R3bRows = true ∧
    checkRows Data.BbRows Data.R3bRows Data.R4bRows = true ∧
    checkRows Data.AbRows Data.R4bRows Data.R5bRows = true ∧
    checkRows Data.BbRows Data.R5bRows Data.R6bRows = true ∧
    checkRows Data.AbRows Data.R6bRows Data.R7bRows = true ∧
    checkRows Data.BbRows Data.R7bRows Data.R8bRows = true ∧
    checkRows Data.AbRows Data.R8bRows Data.R9bRows = true ∧
    checkRows Data.BbRows Data.R9bRows Data.R10bRows = true ∧
    checkRows Data.AbRows Data.R10bRows Data.R11bRows = true)

private theorem word_a (h : checkRows Data.BaRows Data.BaRows Data.R2aRows = true ∧
    checkRows Data.AaRows Data.R2aRows Data.R3aRows = true ∧
    checkRows Data.BaRows Data.R3aRows Data.R4aRows = true ∧
    checkRows Data.AaRows Data.R4aRows Data.R5aRows = true ∧
    checkRows Data.BaRows Data.R5aRows Data.R6aRows = true ∧
    checkRows Data.AaRows Data.R6aRows Data.R7aRows = true ∧
    checkRows Data.BaRows Data.R7aRows Data.R8aRows = true ∧
    checkRows Data.AaRows Data.R8aRows Data.R9aRows = true ∧
    checkRows Data.BaRows Data.R9aRows Data.R10aRows = true ∧
    checkRows Data.AaRows Data.R10aRows Data.R11aRows = true) :
    (decode 320 Data.Aa * decode 320 Data.Ba) ^ 5 * decode 320 Data.Ba =
      decode 320 Data.R11a := by
  obtain ⟨h2, h3, h4, h5, h6, h7, h8, h9, h10, h11⟩ := h
  have p2 : decode 320 Data.Ba * decode 320 Data.Ba = decode 320 Data.R2a :=
    product_sound_list 320 Data.BaRows Data.BaRows Data.R2aRows
      (by decide +kernel) (by decide +kernel) h2
  have p3 : decode 320 Data.Aa * decode 320 Data.R2a = decode 320 Data.R3a :=
    product_sound_list 320 Data.AaRows Data.R2aRows Data.R3aRows
      (by decide +kernel) (by decide +kernel) h3
  have p4 : decode 320 Data.Ba * decode 320 Data.R3a = decode 320 Data.R4a :=
    product_sound_list 320 Data.BaRows Data.R3aRows Data.R4aRows
      (by decide +kernel) (by decide +kernel) h4
  have p5 : decode 320 Data.Aa * decode 320 Data.R4a = decode 320 Data.R5a :=
    product_sound_list 320 Data.AaRows Data.R4aRows Data.R5aRows
      (by decide +kernel) (by decide +kernel) h5
  have p6 : decode 320 Data.Ba * decode 320 Data.R5a = decode 320 Data.R6a :=
    product_sound_list 320 Data.BaRows Data.R5aRows Data.R6aRows
      (by decide +kernel) (by decide +kernel) h6
  have p7 : decode 320 Data.Aa * decode 320 Data.R6a = decode 320 Data.R7a :=
    product_sound_list 320 Data.AaRows Data.R6aRows Data.R7aRows
      (by decide +kernel) (by decide +kernel) h7
  have p8 : decode 320 Data.Ba * decode 320 Data.R7a = decode 320 Data.R8a :=
    product_sound_list 320 Data.BaRows Data.R7aRows Data.R8aRows
      (by decide +kernel) (by decide +kernel) h8
  have p9 : decode 320 Data.Aa * decode 320 Data.R8a = decode 320 Data.R9a :=
    product_sound_list 320 Data.AaRows Data.R8aRows Data.R9aRows
      (by decide +kernel) (by decide +kernel) h9
  have p10 : decode 320 Data.Ba * decode 320 Data.R9a = decode 320 Data.R10a :=
    product_sound_list 320 Data.BaRows Data.R9aRows Data.R10aRows
      (by decide +kernel) (by decide +kernel) h10
  have p11 : decode 320 Data.Aa * decode 320 Data.R10a = decode 320 Data.R11a :=
    product_sound_list 320 Data.AaRows Data.R10aRows Data.R11aRows
      (by decide +kernel) (by decide +kernel) h11
  simp only [pow_succ, pow_zero, one_mul, Matrix.mul_assoc]
  rw [p2, p3, p4, p5, p6, p7, p8, p9, p10, p11]

private theorem word_b (h : checkRows Data.BbRows Data.BbRows Data.R2bRows = true ∧
    checkRows Data.AbRows Data.R2bRows Data.R3bRows = true ∧
    checkRows Data.BbRows Data.R3bRows Data.R4bRows = true ∧
    checkRows Data.AbRows Data.R4bRows Data.R5bRows = true ∧
    checkRows Data.BbRows Data.R5bRows Data.R6bRows = true ∧
    checkRows Data.AbRows Data.R6bRows Data.R7bRows = true ∧
    checkRows Data.BbRows Data.R7bRows Data.R8bRows = true ∧
    checkRows Data.AbRows Data.R8bRows Data.R9bRows = true ∧
    checkRows Data.BbRows Data.R9bRows Data.R10bRows = true ∧
    checkRows Data.AbRows Data.R10bRows Data.R11bRows = true) :
    (decode 320 Data.Ab * decode 320 Data.Bb) ^ 5 * decode 320 Data.Bb =
      decode 320 Data.R11b := by
  obtain ⟨h2, h3, h4, h5, h6, h7, h8, h9, h10, h11⟩ := h
  have p2 : decode 320 Data.Bb * decode 320 Data.Bb = decode 320 Data.R2b :=
    product_sound_list 320 Data.BbRows Data.BbRows Data.R2bRows
      (by decide +kernel) (by decide +kernel) h2
  have p3 : decode 320 Data.Ab * decode 320 Data.R2b = decode 320 Data.R3b :=
    product_sound_list 320 Data.AbRows Data.R2bRows Data.R3bRows
      (by decide +kernel) (by decide +kernel) h3
  have p4 : decode 320 Data.Bb * decode 320 Data.R3b = decode 320 Data.R4b :=
    product_sound_list 320 Data.BbRows Data.R3bRows Data.R4bRows
      (by decide +kernel) (by decide +kernel) h4
  have p5 : decode 320 Data.Ab * decode 320 Data.R4b = decode 320 Data.R5b :=
    product_sound_list 320 Data.AbRows Data.R4bRows Data.R5bRows
      (by decide +kernel) (by decide +kernel) h5
  have p6 : decode 320 Data.Bb * decode 320 Data.R5b = decode 320 Data.R6b :=
    product_sound_list 320 Data.BbRows Data.R5bRows Data.R6bRows
      (by decide +kernel) (by decide +kernel) h6
  have p7 : decode 320 Data.Ab * decode 320 Data.R6b = decode 320 Data.R7b :=
    product_sound_list 320 Data.AbRows Data.R6bRows Data.R7bRows
      (by decide +kernel) (by decide +kernel) h7
  have p8 : decode 320 Data.Bb * decode 320 Data.R7b = decode 320 Data.R8b :=
    product_sound_list 320 Data.BbRows Data.R7bRows Data.R8bRows
      (by decide +kernel) (by decide +kernel) h8
  have p9 : decode 320 Data.Ab * decode 320 Data.R8b = decode 320 Data.R9b :=
    product_sound_list 320 Data.AbRows Data.R8bRows Data.R9bRows
      (by decide +kernel) (by decide +kernel) h9
  have p10 : decode 320 Data.Bb * decode 320 Data.R9b = decode 320 Data.R10b :=
    product_sound_list 320 Data.BbRows Data.R9bRows Data.R10bRows
      (by decide +kernel) (by decide +kernel) h10
  have p11 : decode 320 Data.Ab * decode 320 Data.R10b = decode 320 Data.R11b :=
    product_sound_list 320 Data.AbRows Data.R10bRows Data.R11bRows
      (by decide +kernel) (by decide +kernel) h11
  simp only [pow_succ, pow_zero, one_mul, Matrix.mul_assoc]
  rw [p2, p3, p4, p5, p6, p7, p8, p9, p10, p11]

/-- The packed-product obligations imply inequivalence at the specified word;
the diagonal sums themselves are fully kernel-checked here. -/
theorem traceSeparation_of_rowChecks (h : TraceRowChecks) : TraceSeparation := by
  have ha : Matrix.trace ((matrixA false * matrixB false) ^ 5 * matrixB false) = 0 := by
    change Matrix.trace ((decode 320 Data.Aa * decode 320 Data.Ba) ^ 5 * decode 320 Data.Ba) = 0
    rw [word_a h.1]
    change Matrix.trace (decode 320 Data.R11aRows.toArray) = 0
    rw [trace_sound_list 320 Data.R11aRows (by decide +kernel)]
    decide +kernel
  have hb : Matrix.trace ((matrixA true * matrixB true) ^ 5 * matrixB true) = 1 := by
    change Matrix.trace ((decode 320 Data.Ab * decode 320 Data.Bb) ^ 5 * decode 320 Data.Bb) = 1
    rw [word_b h.2]
    change Matrix.trace (decode 320 Data.R11bRows.toArray) = 1
    rw [trace_sound_list 320 Data.R11bRows (by decide +kernel)]
    decide +kernel
  intro he
  exact zero_ne_one (ha.symm.trans (he.trans hb))

end Representation.Mathieu.M24DegreeSpectrum.AbsoluteSpectrum.LargeModels.Degree320Pair
