module

public import Theory.Representation.Mathieu.M24DegreeSpectrum.AbsoluteSpectrum.LargeModels.Degree320Pair.MatrixCertificates.WitnessData
public import Theory.Representation.Mathieu.M24DegreeSpectrum.AbsoluteSpectrum.LargeModels.Degree320Pair.DensityApplication
public import Theory.Representation.JankoTwo.SmallBinaryDegrees.AbsoluteWindow.ModularCertificate.LargeModels.RankOne

/-!
# Rank-one certificate interface for the literal degree-320 matrices

The saved polynomial candidate and its left and right orbit bases give two
independent finite obligations. Membership of the outer product, together with
spanning of both factors, gives every matrix unit and hence the full matrix
algebra. The native-action application below discharges precisely the density
premise of `absolute_of_realizes`; constructing the native action is independent.

The candidate data come from the four ATLAS matrices attributed in
`../source/README.md`. No identity in the discovery record is assumed here:
the two finite obligations remain explicit until their checks are supplied.
-/

@[expose] public noncomputable section
namespace Representation.Mathieu.M24DegreeSpectrum.AbsoluteSpectrum.LargeModels.Degree320Pair
namespace MatrixCertificates
open Thompson.BinaryMatrix

/-- The algebra generated by the two literal matrices. -/
def generated (variant : Bool) : Subalgebra (ZMod 2) Mat :=
  Algebra.adjoin (ZMod 2) ({matrixA variant, matrixB variant} : Set Mat)

def column (variant : Bool) : Space :=
  fun i => bit (if variant then WitnessData.columnB else WitnessData.columnA) i.val

def covector (variant : Bool) : Space :=
  fun i => bit (if variant then WitnessData.covectorB else WitnessData.covectorA) i.val

def leftBasis (variant : Bool) : Mat :=
  decode 320 (if variant then WitnessData.PB else WitnessData.PA)

def leftInverse (variant : Bool) : Mat :=
  decode 320 (if variant then WitnessData.PiB else WitnessData.PiA)

def rightBasis (variant : Bool) : Mat :=
  decode 320 (if variant then WitnessData.QB else WitnessData.QA)

def rightInverse (variant : Bool) : Mat :=
  decode 320 (if variant then WitnessData.QiB else WitnessData.QiA)

/-- The polynomial computation must put this particular outer product in the
literal generated algebra. This does not assume density or irreducibility. -/
def RankOneMembership : Prop :=
  ∀ variant, Matrix.vecMulVec (column variant) (covector variant) ∈ generated variant

/-- Concrete translates and one-sided inverse identities for the stored bases.
These obligations involve neither the rank-one polynomial nor native M24. -/
def OrbitSpanning : Prop :=
  ∀ variant,
    (∀ i, ∃ W ∈ generated variant,
      W.mulVec (column variant) = fun k => leftBasis variant k i) ∧
    (∀ j, ∃ W ∈ generated variant,
      Matrix.vecMul (covector variant) W = rightBasis variant j) ∧
    leftBasis variant * leftInverse variant = 1 ∧
    rightInverse variant * rightBasis variant = 1

end MatrixCertificates

/-- Assemble the two independent finite certificate families. -/
theorem generatorDensity_of_rankOne
    (hr : MatrixCertificates.RankOneMembership)
    (ho : MatrixCertificates.OrbitSpanning) : GeneratorDensity := by
  intro variant
  obtain ⟨hl, hh, hP, hQ⟩ := ho variant
  exact Representation.JankoTwo.SmallBinaryDegrees.AbsoluteWindow.ModularCertificate.LargeModels.top_of_rankOne
    (MatrixCertificates.generated variant)
    (MatrixCertificates.column variant) (MatrixCertificates.covector variant)
    (MatrixCertificates.leftBasis variant) (MatrixCertificates.leftInverse variant)
    (MatrixCertificates.rightBasis variant) (MatrixCertificates.rightInverse variant)
    (hr variant) hl hh hP hQ

/-- Actual native consumer: the finite certificates discharge the density
premise, leaving only the independent marking of the native action. -/
theorem absolute_of_rankOne
    (hr : MatrixCertificates.RankOneMembership)
    (ho : MatrixCertificates.OrbitSpanning) (variant : Bool)
    (ρ : Representation (ZMod 2) Sporadic.Mathieu.M24 Space)
    (hρ : Realizes variant ρ) : ρ.IsAbsolutelyIrreducible :=
  absolute_of_realizes variant ρ hρ (generatorDensity_of_rankOne hr ho variant)

end Representation.Mathieu.M24DegreeSpectrum.AbsoluteSpectrum.LargeModels.Degree320Pair
