module

public import Theory.Representation.Mathieu.M24DegreeSpectrum.AbsoluteSpectrum.LargeModels.Degree320Pair.Contracts

/-!
# Applying matrix density to the native degree-320 actions

The two marked matrices lie in the algebra generated by any action realizing
them. If they generate the full matrix algebra, Jacobson density proves
irreducibility and that every commuting endomorphism is scalar, hence absolute
irreducibility. The finite matrix-density and native-action obligations remain
explicit and independent. This discharges the structural step in the binary
models required by the James/GM02 degree-window argument.
-/

public noncomputable section
namespace Representation.Mathieu.M24DegreeSpectrum.AbsoluteSpectrum.LargeModels.Degree320Pair
open Sporadic.Mathieu

theorem action_dense_of_realizes (variant : Bool)
    (ρ : Representation (ZMod 2) M24 Space) (hρ : Realizes variant ρ)
    (hd : Algebra.adjoin (ZMod 2) ({matrixA variant, matrixB variant} : Set Mat) = ⊤) :
    Algebra.adjoin (ZMod 2) (Set.range ρ) = ⊤ := by
  let S := Algebra.adjoin (ZMod 2) (Set.range ρ)
  have hle : Algebra.adjoin (ZMod 2) ({matrixA variant, matrixB variant} : Set Mat) ≤
      S.comap Matrix.toLinAlgEquiv'.toAlgHom := by
    apply Algebra.adjoin_le
    intro M hM
    rcases hM with rfl | hM
    · change Matrix.toLin' (matrixA variant) ∈ S
      rw [← hρ.1, Matrix.toLin'_toMatrix']
      exact Algebra.subset_adjoin (Set.mem_range_self actorA)
    · have hM' : M = matrixB variant := hM
      subst M
      change Matrix.toLin' (matrixB variant) ∈ S
      rw [← hρ.2, Matrix.toLin'_toMatrix']
      exact Algebra.subset_adjoin (Set.mem_range_self actorB)
  apply top_unique
  intro f _
  have hm : LinearMap.toMatrix' f ∈
      Algebra.adjoin (ZMod 2) ({matrixA variant, matrixB variant} : Set Mat) := by
    rw [hd]
    trivial
  have hf := hle hm
  change Matrix.toLin' (LinearMap.toMatrix' f) ∈ S at hf
  simpa only [Matrix.toLin'_toMatrix'] using hf

/-- Both absolute-irreducibility requirements reduce to the concrete density
certificates; no additional Schur-field premise is needed. -/
theorem absolute_of_realizes (variant : Bool)
    (ρ : Representation (ZMod 2) M24 Space) (hρ : Realizes variant ρ)
    (hd : Algebra.adjoin (ZMod 2) ({matrixA variant, matrixB variant} : Set Mat) = ⊤) :
    ρ.IsAbsolutelyIrreducible := by
  have h := action_dense_of_realizes variant ρ hρ hd
  let : ρ.IsIrreducible := irreducible_of_jacobson_density_surjective ρ h
  exact (isAbsolutelyIrreducible_iff_surjective ρ).mpr
    (surjective_of_jacobson_density_surjective_rep ρ h)

end Representation.Mathieu.M24DegreeSpectrum.AbsoluteSpectrum.LargeModels.Degree320Pair
