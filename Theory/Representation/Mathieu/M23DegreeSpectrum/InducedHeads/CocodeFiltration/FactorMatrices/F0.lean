  have h28 := Certificate.mul_mem Q c27 c2 c28 h27 h2 (by decide +kernel) check28
  have h29 := Certificate.mul_mem Q c28 c2 c29 h28 h2 (by decide +kernel) check29
  have h30 := Certificate.mul_mem Q c29 c25 c30 h29 h25 (by decide +kernel) check30
  have h31 := Certificate.mul_mem Q c30 c2 c31 h30 h2 (by decide +kernel) check31
  have h32 := Certificate.mul_mem Q c31 c1 c32 h31 h1 (by decide +kernel) check32
  have h33 := Certificate.mul_mem Q c32 c2 c33 h32 h2 (by decide +kernel) check33
  have h34 := Certificate.mul_mem Q c33 c1 c34 h33 h1 (by decide +kernel) check34
  have h35 := Certificate.mul_mem Q c34 c2 c35 h34 h2 (by decide +kernel) check35
  have h36 := Certificate.mul_mem Q c35 c2 c36 h35 h2 (by decide +kernel) check36
