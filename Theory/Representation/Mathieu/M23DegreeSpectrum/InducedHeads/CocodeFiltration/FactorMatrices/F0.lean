/-- Density of the literal factor with flag index 0. -/
theorem full (Q : Subalgebra (ZMod 2)
    (Matrix (Fin (degree 0)) (Fin (degree 0)) (ZMod 2)))
    (hA : ∀ j : Fin 2, factorMatrix 0 j ∈ Q) : Q = ⊤ := by
  have hA' : ∀ j : Fin 2, matrix (n := 120) (actors j) ∈ Q := by
    intro j
    rw [actors_checked]
    exact hA j
  apply full_of_orbits (m := 119) Q (fun j => matrix (n := 120) (actors j)) hA'
    colsList rowsOrbitList ciList riList cp rp ca ra cparent rparent
  · intro x
    have h := congrArg (vector (n := 120)) (cstep x)
    rw [vector_combine _ (show (transposed (ca x)).length = 120 from by
      generalize ca x = j; revert j; decide +kernel), transpose_checked,
      vecMul_transpose] at h
    exact h
  · intro x
    have h := congrArg (vector (n := 120)) (rstep x)
    rw [vector_combine _ (show (actors (ra x)).length = 120 from by
      generalize ra x = j; revert j; decide +kernel)] at h
    exact h
  · decide +kernel
  · decide +kernel
  · exact cinverse
  · exact rinverse
  · exact rankOne_mem Q hA'

