/-- Density of the literal factor with flag index 2. -/
theorem full (Q : Subalgebra (ZMod 2)
    (Matrix (Fin (degree 2)) (Fin (degree 2)) (ZMod 2)))
    (hA : ∀ j : Fin 2, factorMatrix 2 j ∈ Q) : Q = ⊤ := by
  have hA' : ∀ j : Fin 2, matrix (n := 44) (actors j) ∈ Q := by
    intro j
    rw [actors_checked]
    exact hA j
  apply full_of_orbits (m := 43) Q (fun j => matrix (n := 44) (actors j)) hA'
    colsList rowsOrbitList ciList riList cp rp ca ra cparent rparent
  · intro x
    have h := congrArg (vector (n := 44)) (cstep x)
    rw [vector_combine _ (show (transposed (ca x)).length = 44 from by
      generalize ca x = j; revert j; decide +kernel), transpose_checked,
      vecMul_transpose] at h
    exact h
  · intro x
    have h := congrArg (vector (n := 44)) (rstep x)
    rw [vector_combine _ (show (actors (ra x)).length = 44 from by
      generalize ra x = j; revert j; decide +kernel)] at h
    exact h
  · decide +kernel
  · decide +kernel
  · exact cinverse
  · exact rinverse
  · exact rankOne_mem Q hA'

