  have h14 := Certificate.mul_mem Q c12 c12 c14 h12 h12 (by decide +kernel) check14
  have h15 := Certificate.add_mem Q c13 c14 c15 h13 h14 check15
  have h16 := Certificate.mul_mem Q c14 c12 c16 h14 h12 (by decide +kernel) check16
  have h17 := Certificate.mul_mem Q c16 c15 c17 h16 h15 (by decide +kernel) check17
  have h18 := Certificate.add_mem Q c15 c17 c18 h15 h17 check18
  have h19 := Certificate.mul_mem Q c16 c16 c19 h16 h16 (by decide +kernel) check19
  have h20 := Certificate.add_mem Q c18 c19 c20 h18 h19 check20
  have h21 := Certificate.mul_mem Q c19 c12 c21 h19 h12 (by decide +kernel) check21
