def generatorColumns (j : Fin 2) (y : Fin 230) : ℕ :=
  (generatorColumnList j)[y.val]?.getD 0

def basis (y : Fin 230) : ℕ := (basisList)[y.val]?.getD 0

def inverseColumns (y : Fin 230) : ℕ :=
  (inverseColumnList)[y.val]?.getD 0

def actionColumns (j : Fin 2) (y : Fin 230) : ℕ :=
  (actionColumnList j)[y.val]?.getD 0

theorem basisList_length : (basisList).length = 230 := by decide +kernel

theorem generatorColumnList_length : ∀ j, (generatorColumnList j).length = 230 :=
  by decide +kernel

/-- Raw GAP right-action rows, transposed to act on columns. -/
def generatorMatrix (j : Fin 2) : Matrix (Fin 230) (Fin 230) (ZMod 2) :=
  fun x y => bit (generatorColumns j y) x.val

def basisMatrix : Matrix (Fin 230) (Fin 230) (ZMod 2) :=
  fun x y => bit (basis y) x.val

def inverseMatrix : Matrix (Fin 230) (Fin 230) (ZMod 2) :=
  fun x y => bit (inverseColumns y) x.val

def actionMatrix (j : Fin 2) : Matrix (Fin 230) (Fin 230) (ZMod 2) :=
  fun x y => bit (actionColumns j y) x.val

def factorMatrix (t : Factor) (j : Fin 2) :
    Matrix (Fin (degree t)) (Fin (degree t)) (ZMod 2) :=
  fun x y => actionMatrix j (blockIndex t x) (blockIndex t y)

/-- The remaining finite algebra obligation, independent of the native comparison.
No assertion of simplicity is made by these data. -/
def SimpleMatrices : Prop :=
  ∀ (t : Factor) (S : Submodule (ZMod 2) (Fin (degree t) → ZMod 2)),
    (∀ (j : Fin 2) v, v ∈ S → (factorMatrix t j).mulVec v ∈ S) →
      S = ⊥ ∨ S = ⊤

end Representation.MathieuSmall.M23DegreeSpectrum.InducedHeads.CocodeFiltration
