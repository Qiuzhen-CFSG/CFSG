module

public import Theory.Representation.Mathieu.M22James.DegreeTwentyFour.ExclusionsTwelve.InducedQuotients.NaturalFiltration.Data
public import Theory.Representation.G2DerivedPermutationFiltration.VertexFiltrations.CoordinateFiltrations.FlagTools

/-!
# The literal invariant flag for the natural induced point module

Take the invariant spans of the first fifteen and sixty saved columns.
These define actual nested subrepresentations even before their dimensions
are certified. `FieldFactor` is each literal successive quotient, including
the quotient of the whole space at the last step.

`FactorCoordinates` asks for equivariant coordinates on those quotients,
with the fixed numerical generator matrices in `Data`. Independently,
`FactorDensity` asks that those matrices generate the full matrix algebra.
The checked assembly turns these two concrete certificates into the field
filtration. Neither existence of the coordinates nor density is asserted here.
Source context: Guralnick–Malle, Classification of 2F-modules I,
Proposition 5.1, pp.15–16 and Theorem 6.6/Table 6.7.
-/

@[expose] public noncomputable section
open Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreLinearModel

namespace Sporadic.Mathieu.M22TripleCover.DegreeTwentyFour.ExclusionsTwelve.InducedCoordinates.NaturalFiltration
open Representation
open G2DerivedPermutationFiltration.VertexCoordinates.CoordinateFiltrations
open Uniqueness.PointRestriction.PointModel

/-- Invariant span of the first `n` candidate columns, without assuming invariance of
    their ordinary field span. -/
def fieldPrefix (n : ℕ) (hn : n ≤ 66) : Subrepresentation (fieldRepresentation .natural) where
  toSubmodule := Submodule.span Field (Set.range (fun p : M22TripleCover × Fin n =>
    fieldRepresentation .natural p.1 (basisVector (Fin.castLE hn p.2))))
  apply_mem_toSubmodule g _ hv := by
    induction hv using Submodule.span_induction with
    | mem x hx =>
      obtain ⟨⟨h, i⟩, rfl⟩ := hx
      apply Submodule.subset_span
      exact ⟨(g*h, i), by simp only [map_mul, Module.End.mul_apply]⟩
    | zero => simpa only [map_zero] using Submodule.zero_mem _
    | add x y _ _ hx hy => simpa only [map_add] using Submodule.add_mem _ hx hy
    | smul c x _ hx => simpa only [map_smul] using Submodule.smul_mem _ c hx

lemma fieldPrefix_mono {n m : ℕ} (hn : n ≤ 66) (hm : m ≤ 66) (h : n ≤ m) :
    fieldPrefix n hn ≤ fieldPrefix m hm := by
  change Submodule.span Field _ ≤ Submodule.span Field _
  apply Submodule.span_mono
  rintro _ ⟨⟨g, i⟩, rfl⟩
  exact ⟨(g, Fin.castLE h i), rfl⟩

/-- The actual invariant flag generated by the saved prefixes. Its dimensions
    are not stipulated by the definition. -/
def fieldFlag : ℕ → Subrepresentation (fieldRepresentation .natural)
  | 0 => ⊥
  | 1 => fieldPrefix 15 (by decide)
  | 2 => fieldPrefix 60 (by decide)
  | _ => ⊤

lemma fieldFlag_zero : fieldFlag 0 = ⊥ := rfl
lemma fieldFlag_last : fieldFlag 3 = ⊤ := rfl
lemma fieldFlag_mono (m : ℕ) (hm : m < 3) : fieldFlag m ≤ fieldFlag (m+1) := by
  interval_cases m
  · exact bot_le
  · exact fieldPrefix_mono (by decide) (by decide) (by decide)
  · exact le_top

/-- The smaller flag term as an actual subrepresentation of the next term. -/
def factorKernel (s : Fin 3) := within (fieldFlag s.val) (fieldFlag (s.val+1))
/-- Carrier of the literal successive quotient. -/
abbrev FieldFactor (s : Fin 3) :=
  (fieldFlag (s.val+1)).toSubmodule ⧸ (factorKernel s).toSubmodule
/-- Action on the literal successive quotient. -/
def factorRepresentation (s : Fin 3) : Representation Field M22TripleCover (FieldFactor s) :=
  (factorKernel s).quotientRepresentation

/-- Coordinates must identify the literal quotient and both actual ambient generators. -/
structure FactorCoordinates (s : Fin 3) where
  equiv : FieldFactor s ≃ₗ[Field] (Fin (factorDegree s) → Field)
  equivariant : ∀ (j : Fin 2) (v : FieldFactor s),
    equiv (factorRepresentation s (ambientGenerator j) v) =
      (factorMatrix s j).mulVec (equiv v)

/-- The precise independent algebra calculation used for each factor. -/
def FactorDensity (s : Fin 3) : Prop :=
  ∀ Q : Subalgebra Field (Matrix (Fin (factorDegree s)) (Fin (factorDegree s)) Field),
    (∀ j : Fin 2, factorMatrix s j ∈ Q) → Q = ⊤

lemma factor_irreducible_of_coordinates (s : Fin 3)
    (c : FactorCoordinates s) (h : FactorDensity s) :
    (factorRepresentation s).IsIrreducible := by
  apply irreducible_of_coordinate_matrices (ρ := factorRepresentation s)
    (g := ambientGenerator) (A := factorMatrix s) ?_ c.equiv c.equivariant h
  fin_cases s <;> decide

lemma factor_finrank_of_coordinates (s : Fin 3) (c : FactorCoordinates s) :
    Module.finrank Field (FieldFactor s) = factorDegree s := by
  rw [c.equiv.finrank_eq, Module.finrank_fin_fun]

/-- Assemble the actual field filtration from coordinate and algebra certificates. -/
lemma field_filtration_of_coordinates (c : ∀ s, FactorCoordinates s)
    (h : ∀ s, FactorDensity s) :
    FactorDegreeFiltration ({6, 15, 45} : Set ℕ) (fieldRepresentation .natural) := by
  apply filtration_of_flag _ 3 fieldFlag fieldFlag_zero fieldFlag_last fieldFlag_mono
  · intro m hm
    exact factor_irreducible_of_coordinates ⟨m, hm⟩ (c ⟨m, hm⟩) (h ⟨m, hm⟩)
  · intro m hm
    change Module.finrank Field (FieldFactor ⟨m, hm⟩) ∈ _
    rw [factor_finrank_of_coordinates ⟨m, hm⟩ (c ⟨m, hm⟩)]
    interval_cases m <;> simp [factorDegree]

end Sporadic.Mathieu.M22TripleCover.DegreeTwentyFour.ExclusionsTwelve.InducedCoordinates.NaturalFiltration
