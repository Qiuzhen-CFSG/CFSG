private lemma transpose_eq (a : Fin 2) :
    matrix (transposedActors a) = (matrix (actors a)).transpose := by
  funext i j
  have h := transpose_bits a i j
  simp only [matrix, vector, value, transpose_apply, h.1, h.2]

