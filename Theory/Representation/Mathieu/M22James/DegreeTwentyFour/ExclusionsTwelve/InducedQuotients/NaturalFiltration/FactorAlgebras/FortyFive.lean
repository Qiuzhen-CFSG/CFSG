private theorem transpose_bits : ∀ (a : Fin 2) (i j : Fin 45),
    (transposedActors a i).1.testBit j.val = (actors a j).1.testBit i.val ∧
    (transposedActors a i).2.testBit j.val = (actors a j).2.testBit i.val := by
