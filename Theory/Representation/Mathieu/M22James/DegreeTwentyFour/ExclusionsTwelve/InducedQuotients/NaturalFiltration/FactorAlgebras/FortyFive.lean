private theorem actor_bits : ∀ (a : Fin 2) (i j : Fin 45),
    (actors a i).1.testBit j.val = (factorRows 1 a i).testBit (2*j.val) ∧
    (actors a i).2.testBit j.val = (factorRows 1 a i).testBit (2*j.val+1) := by
  decide +kernel

private lemma actors_eq (a : Fin 2) : matrix (actors a) = factorMatrix 1 a := by
  funext i j
  have h := actor_bits a i j
  simp only [matrix, vector, value, factorMatrix, digit, h.1, h.2]

