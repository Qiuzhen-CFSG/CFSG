private theorem rankOne_mem (Q : Subalgebra F (Matrix (Fin 45) (Fin 45) F))
    (hA : matrix (actors 0) ∈ Q) (hB : matrix (actors 1) ∈ Q) :
    vecMulVec (vector (cols 0)) (vector (rows 0)) ∈ Q := by

  have hp0 : matrix power0 ∈ Q := by rw [power0, matrix_identity]; exact Q.one_mem
  have hp1 : matrix power1 ∈ Q := t_mem Q hA hB
  have hp2 : matrix power2 ∈ Q := by
    rw [← funext power2_check, matrix_product]
    exact Q.mul_mem hp1 hp1
  have hp3 : matrix power3 ∈ Q := by
    rw [← funext power3_check, matrix_product]
    exact Q.mul_mem hp1 hp2
  have hp4 : matrix power4 ∈ Q := by
    rw [← funext power4_check, matrix_product]
    exact Q.mul_mem hp1 hp3
  have hp5 : matrix power5 ∈ Q := by
    rw [← funext power5_check, matrix_product]
    exact Q.mul_mem hp1 hp4
  have hp6 : matrix power6 ∈ Q := by
    rw [← funext power6_check, matrix_product]
    exact Q.mul_mem hp1 hp5
  have hp7 : matrix power7 ∈ Q := by
    rw [← funext power7_check, matrix_product]
    exact Q.mul_mem hp1 hp6
  have hb0 : matrix block0 ∈ Q := by
    rw [← funext block0_check]
    simp only [matrix_plus, matrix_scaled]
    exact (Q.add_mem (Q.add_mem (Q.add_mem (Q.add_mem (Q.smul_mem hp0 (scalar 1)) (Q.smul_mem hp1 (scalar 2))) (Q.smul_mem hp2 (scalar 3))) (Q.smul_mem hp3 (scalar 2))) (Q.smul_mem hp6 (scalar 1)))
  have hb1 : matrix block1 ∈ Q := by
    rw [← funext block1_check]
    simp only [matrix_plus, matrix_scaled]
    exact (Q.add_mem (Q.smul_mem hp3 (scalar 1)) (Q.smul_mem hp5 (scalar 2)))
  have hb2 : matrix block2 ∈ Q := by
    rw [← funext block2_check]
    simp only [matrix_plus, matrix_scaled]
    exact (Q.add_mem (Q.add_mem (Q.add_mem (Q.add_mem (Q.add_mem (Q.smul_mem hp1 (scalar 2)) (Q.smul_mem hp2 (scalar 1))) (Q.smul_mem hp3 (scalar 3))) (Q.smul_mem hp4 (scalar 3))) (Q.smul_mem hp5 (scalar 3))) (Q.smul_mem hp6 (scalar 2)))
