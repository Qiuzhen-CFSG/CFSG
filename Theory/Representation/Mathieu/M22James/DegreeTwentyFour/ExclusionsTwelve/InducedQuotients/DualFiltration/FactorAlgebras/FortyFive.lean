private theorem t_check : ∀ i, (plus (plus (scaled 1 (identity 45)) (scaled 2 (actors 1))) (scaled 3 (product (actors 1) (actors 0)))) i = t i := by decide +kernel

private theorem t_mem (Q : Subalgebra F (Matrix (Fin 45) (Fin 45) F))
    (hA : matrix (actors 0) ∈ Q) (hB : matrix (actors 1) ∈ Q) : matrix t ∈ Q := by
  rw [← funext t_check]
  simp only [matrix_plus, matrix_scaled, matrix_product, matrix_identity]
  exact (Q.add_mem (Q.add_mem (Q.smul_mem Q.one_mem (scalar 1)) (Q.smul_mem hB (scalar 2))) (Q.smul_mem (Q.mul_mem hB hA) (scalar 3)))

