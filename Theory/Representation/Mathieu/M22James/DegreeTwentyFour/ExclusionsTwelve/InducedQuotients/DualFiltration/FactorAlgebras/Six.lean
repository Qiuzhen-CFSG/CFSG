/-!
# Full matrix algebra for the 6-dimensional dual induced factor

The saved polynomial is evaluated by grouped, checked Horner steps. Its value is the
outer product of the first column and row orbit vectors. Checked predecessor
recurrences and right inverses prove both orbits span the whole space.

All matrices here are literal certificates for `factorMatrix 1`. Source context:
Guralnick–Malle, Classification of 2F-modules I, Proposition 5.1, pp.15–16,
and Theorem 6.6/Table 6.7. See `../source/README.md` for original attribution.
Generated by `source/generate.py`; numerical identities use `decide +kernel`.
-/

@[expose] public section
open Matrix
namespace Sporadic.Mathieu.M22TripleCover.DegreeTwentyFour.ExclusionsTwelve.InducedCoordinates.DualFiltration.FactorAlgebras.Six

private def actors : Fin 2 → Fin 6 → Word :=
  ![![(14, 5), (15, 10), (61, 58), (23, 59), (43, 20), (49, 56)], ![(30, 49), (13, 56), (58, 22), (38, 31), (62, 31), (32, 0)]]

private def actorsT : Fin 2 → Fin 6 → Word :=
  ![![(62, 9), (27, 14), (15, 17), (23, 46), (44, 60), (52, 44)], ![(2, 25), (29, 28), (27, 28), (23, 26), (21, 31), (60, 3)]]

private def t : Fin 6 → Word :=
  ![(55, 34), (33, 21), (44, 44), (41, 45), (3, 50), (31, 7)]

private def cols : Fin 6 → Word :=
  ![(25, 43), (62, 1), (16, 50), (58, 44), (59, 63), (46, 11)]

private def colInverse : Fin 6 → Word :=
  ![(20, 3), (54, 36), (17, 21), (18, 43), (45, 43), (25, 38)]

private def colParent : Fin 5 → Fin 6 :=
  ![0, 0, 1, 3, 4]

private def colActor : Fin 5 → Fin 2 :=
  ![0, 1, 0, 0, 0]

private def rows : Fin 6 → Word :=
  ![(31, 12), (46, 35), (0, 22), (28, 39), (14, 39), (57, 21)]

private def rowInverse : Fin 6 → Word :=
  ![(58, 10), (15, 3), (28, 4), (22, 45), (23, 3), (22, 24)]

private def rowParent : Fin 5 → Fin 6 :=
  ![0, 0, 1, 3, 4]

private def rowActor : Fin 5 → Fin 2 :=
  ![0, 1, 0, 0, 0]

set_option maxRecDepth 4096 in
private theorem actors_check : ∀ (j : Fin 2) (i : Fin 6), split 6 (factorColumns1 j i) = actors j i := by decide +kernel

private theorem actors_eq (j : Fin 2) :
    matrix (m := 6) (actors j) = factorMatrix 1 j := by
  rw [← funext (actors_check j), matrix_split]
  rfl

set_option maxRecDepth 4096 in
private theorem transpose_check : ∀ (j : Fin 2) (i : Fin 6), transpose (m := 6) (actors j) i = actorsT j i := by decide +kernel

private theorem actorsT_eq (j : Fin 2) :
    matrix (m := 6) (actorsT j) = (matrix (actors j))ᵀ := by
  rw [← funext (transpose_check j), matrix_transpose]

set_option maxRecDepth 4096 in
private theorem t_check : ∀ i, (plus (plus (scaled 2 (identity 6)) (scaled 3 (product (actors 0) (actors 1)))) (scaled 2 (product (actors 1) (actors 0)))) i = t i := by decide +kernel

private theorem t_mem (Q : Subalgebra F (Matrix (Fin 6) (Fin 6) F))
    (hA : matrix (actors 0) ∈ Q) (hB : matrix (actors 1) ∈ Q) : matrix t ∈ Q := by
  rw [← funext t_check]
  simp only [matrix_plus, matrix_scaled, matrix_product, matrix_identity]
  exact (Q.add_mem (Q.add_mem (Q.smul_mem Q.one_mem (scalar 2)) (Q.smul_mem (Q.mul_mem hA hB) (scalar 3))) (Q.smul_mem (Q.mul_mem hB hA) (scalar 2)))

set_option maxRecDepth 4096 in
private theorem colParent_check : ∀ i, colParent i < i.succ := by decide +kernel

set_option maxRecDepth 4096 in
private theorem rowParent_check : ∀ i, rowParent i < i.succ := by decide +kernel

set_option maxRecDepth 4096 in
private theorem colOrbit_check : ∀ i, act (actors (colActor i)) (cols (colParent i)) = cols i.succ := by decide +kernel

set_option maxRecDepth 4096 in
private theorem rowOrbit_check : ∀ i, act (actorsT (rowActor i)) (rows (rowParent i)) = rows i.succ := by decide +kernel

set_option maxRecDepth 4096 in
private theorem colInverse_check : ∀ i, product cols colInverse i = identity 6 i := by decide +kernel

set_option maxRecDepth 4096 in
private theorem rowInverse_check : ∀ i, product rows rowInverse i = identity 6 i := by decide +kernel

private def power0 : Fin 6 → Word :=
  identity 6

private def power1 : Fin 6 → Word :=
  t

private def power2 : Fin 6 → Word :=
  ![(52, 2), (20, 1), (28, 26), (37, 1), (54, 42), (11, 37)]

set_option maxRecDepth 4096 in
private theorem power2_check : ∀ j, product power1 power1 j = power2 j := by decide +kernel

private def power3 : Fin 6 → Word :=
  ![(37, 45), (13, 11), (12, 50), (38, 28), (46, 36), (54, 23)]

set_option maxRecDepth 4096 in
private theorem power3_check : ∀ j, product power1 power2 j = power3 j := by decide +kernel

private def block0 : Fin 6 → Word :=
  ![(3, 33), (53, 22), (48, 50), (12, 36), (53, 8), (20, 2)]

set_option maxRecDepth 4096 in
private theorem block0_check : ∀ j, (plus (plus (scaled 2 power0) (scaled 1 power1)) (scaled 1 power2)) j = block0 j := by decide +kernel

private def block1 : Fin 6 → Word :=
  ![(32, 53), (34, 32), (24, 54), (41, 40), (23, 41), (51, 58)]

set_option maxRecDepth 4096 in
private theorem block1_check : ∀ j, (plus (plus (scaled 1 power0) (scaled 3 power1)) (scaled 1 power2)) j = block1 j := by decide +kernel

private def h0 : Fin 6 → Word :=
  block1

private def h1 : Fin 6 → Word :=
  outer (cols 0) (rows 0)

set_option maxRecDepth 4096 in
private theorem horner1 : ∀ j, plus (product power3 h0) block0 j = h1 j := by decide +kernel

private theorem rankOne_mem (Q : Subalgebra F (Matrix (Fin 6) (Fin 6) F))
    (hA : matrix (actors 0) ∈ Q) (hB : matrix (actors 1) ∈ Q) :
    vecMulVec (vector (cols 0)) (vector (rows 0)) ∈ Q := by

  have hp0 : matrix power0 ∈ Q := by rw [power0, matrix_identity]; exact Q.one_mem
  have hp1 : matrix power1 ∈ Q := t_mem Q hA hB
  have hp2 : matrix power2 ∈ Q := by
    rw [← funext power2_check, matrix_product]
    exact Q.mul_mem hp1 hp1
  have hp3 : matrix power3 ∈ Q := by
    rw [← funext power3_check, matrix_product]
    exact Q.mul_mem hp1 hp2
  have hb0 : matrix block0 ∈ Q := by
    rw [← funext block0_check]
    simp only [matrix_plus, matrix_scaled]
    exact (Q.add_mem (Q.add_mem (Q.smul_mem hp0 (scalar 2)) (Q.smul_mem hp1 (scalar 1))) (Q.smul_mem hp2 (scalar 1)))
  have hb1 : matrix block1 ∈ Q := by
    rw [← funext block1_check]
    simp only [matrix_plus, matrix_scaled]
    exact (Q.add_mem (Q.add_mem (Q.smul_mem hp0 (scalar 1)) (Q.smul_mem hp1 (scalar 3))) (Q.smul_mem hp2 (scalar 1)))
  have hm0 : matrix h0 ∈ Q := hb1
  have hm1 : matrix h1 ∈ Q := by
    rw [← funext horner1, matrix_plus, matrix_product]
    exact Q.add_mem (Q.mul_mem hp3 hm0) hb0
  simpa only [h1, matrix_outer] using hm1

/-- Both published generators generate the entire 6-dimensional matrix algebra. -/
theorem algebra_eq_top (Q : Subalgebra F (Matrix (Fin 6) (Fin 6) F))
    (hA : factorMatrix 1 0 ∈ Q) (hB : factorMatrix 1 1 ∈ Q) : Q = ⊤ := by
  rw [← actors_eq] at hA hB
  have ha : ∀ a, matrix (actors a) ∈ Q := by
    intro a; fin_cases a
    · exact hA
    · exact hB
  exact full_of_orbits Q actors actorsT ha actorsT_eq cols rows colInverse rowInverse
    colParent rowParent colActor rowActor colParent_check rowParent_check
    colOrbit_check rowOrbit_check colInverse_check rowInverse_check (rankOne_mem Q hA hB)

