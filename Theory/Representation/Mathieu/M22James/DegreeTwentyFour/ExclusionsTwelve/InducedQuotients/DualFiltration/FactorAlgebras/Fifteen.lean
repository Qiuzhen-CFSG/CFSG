private theorem rankOne_mem (Q : Subalgebra F (Matrix (Fin 15) (Fin 15) F))
    (hA : matrix (actors 0) ∈ Q) (hB : matrix (actors 1) ∈ Q) :
    vecMulVec (vector (cols 0)) (vector (rows 0)) ∈ Q := by

  have hp0 : matrix power0 ∈ Q := by rw [power0, matrix_identity]; exact Q.one_mem
  have hp1 : matrix power1 ∈ Q := t_mem Q hA hB
  have hp2 : matrix power2 ∈ Q := by
    rw [← funext power2_check, matrix_product]
    exact Q.mul_mem hp1 hp1
  have hp3 : matrix power3 ∈ Q := by
    rw [← funext power3_check, matrix_product]
    exact Q.mul_mem hp1 hp2
  have hp4 : matrix power4 ∈ Q := by
    rw [← funext power4_check, matrix_product]
    exact Q.mul_mem hp1 hp3
  have hb0 : matrix block0 ∈ Q := by
    rw [← funext block0_check]
    simp only [matrix_plus, matrix_scaled]
    exact (Q.add_mem (Q.add_mem (Q.smul_mem hp0 (scalar 2)) (Q.smul_mem hp2 (scalar 2))) (Q.smul_mem hp3 (scalar 2)))
  have hb1 : matrix block1 ∈ Q := by
    rw [← funext block1_check]
    simp only [matrix_plus, matrix_scaled]
    exact (Q.add_mem (Q.add_mem (Q.smul_mem hp0 (scalar 2)) (Q.smul_mem hp1 (scalar 2))) (Q.smul_mem hp3 (scalar 1)))
  have hb2 : matrix block2 ∈ Q := by
    rw [← funext block2_check]
    simp only [matrix_plus, matrix_scaled]
    exact (Q.add_mem (Q.add_mem (Q.add_mem (Q.smul_mem hp0 (scalar 2)) (Q.smul_mem hp1 (scalar 3))) (Q.smul_mem hp2 (scalar 1))) (Q.smul_mem hp3 (scalar 3)))
  have hb3 : matrix block3 ∈ Q := by
    rw [← funext block3_check]
    simp only [matrix_plus, matrix_scaled]
    exact (Q.add_mem (Q.add_mem (Q.smul_mem hp0 (scalar 1)) (Q.smul_mem hp1 (scalar 1))) (Q.smul_mem hp2 (scalar 1)))
  have hm0 : matrix h0 ∈ Q := hb3
  have hm1 : matrix h1 ∈ Q := by
    rw [← funext horner1, matrix_plus, matrix_product]
    exact Q.add_mem (Q.mul_mem hp4 hm0) hb2
  have hm2 : matrix h2 ∈ Q := by
    rw [← funext horner2, matrix_plus, matrix_product]
    exact Q.add_mem (Q.mul_mem hp4 hm1) hb1
  have hm3 : matrix h3 ∈ Q := by
    rw [← funext horner3, matrix_plus, matrix_product]
    exact Q.add_mem (Q.mul_mem hp4 hm2) hb0
  simpa only [h3, matrix_outer] using hm3

/-- Both published generators generate the entire 15-dimensional matrix algebra. -/
theorem algebra_eq_top (Q : Subalgebra F (Matrix (Fin 15) (Fin 15) F))
    (hA : factorMatrix 2 0 ∈ Q) (hB : factorMatrix 2 1 ∈ Q) : Q = ⊤ := by
  rw [← actors_eq] at hA hB
  have ha : ∀ a, matrix (actors a) ∈ Q := by
    intro a; fin_cases a
    · exact hA
    · exact hB
  exact full_of_orbits Q actors actorsT ha actorsT_eq cols rows colInverse rowInverse
    colParent rowParent colActor rowActor colParent_check rowParent_check
    colOrbit_check rowOrbit_check colInverse_check rowInverse_check (rankOne_mem Q hA hB)

