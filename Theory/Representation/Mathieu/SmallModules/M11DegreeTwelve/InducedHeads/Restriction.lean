module

public import Theory.Representation.Mathieu.SmallModules.M11DegreeTwelve.InducedHeads.Permutation
public import Theory.Representation.Mathieu.SmallModules.M11DegreeTwelve.InducedHeads.PrimeRestriction

/-!
# Nonsplit restrictions in the M11 degree gap

For a group normally generated by an eleven-subgroup whose order-fifty-five
normalizing subgroup has index twelve, the simple binary degrees through
twelve are one and ten. An eleven- or twelve-dimensional module therefore
has a fixed vector or fixed covector: take a simple quotient, retaining its
possibly nonsplit kernel. Applying the twelve-coset bound in an overgroup
excludes both exceptional degrees there.

Source: the elementary permutation-module route to the James input used in
Aschbacher--Smith K.4, printed p.457; James, J. Algebra 27 (1973), 57--111.
-/

public noncomputable section
namespace Representation.MathieuSmall.M11DegreeTwelve.InducedHeads

variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V]

/-- The local simple-degree gap, proved without a simplicity assumption on G. -/
theorem simple_degree
    (P N : Subgroup G) (hcP : Nat.card P = 11) (hcN : Nat.card N = 55)
    (hn : N ≤ Subgroup.normalizer (P : Set G)) (hi : N.index = 12)
    (hgen : Subgroup.normalClosure (P : Set G) = ⊤)
    (ρ : Representation (ZMod 2) G V) [ρ.IsIrreducible]
    (hd : Module.finrank (ZMod 2) V ≤ 12) :
    Module.finrank (ZMod 2) V = 1 ∨ Module.finrank (ZMod 2) V = 10 := by
  let : Nontrivial V := Subrepresentation.irreducible_module_nontrivial ρ
  have hp : 0 < Module.finrank (ZMod 2) V := Module.finrank_pos
  by_cases h1 : Module.finrank (ZMod 2) V = 1
  · exact Or.inl h1
  have hf := injective_on_eleven_of_irreducible P hcP hgen ρ (by omega)
  have hlo := BinaryPrimeDegree.orderOf_le_finrank (ρ.comp P.subtype) hf
    (by decide : Nat.Prime 11) (by decide) (by rw [hcP])
  rw [BinaryPrimeDegree.orderOf_two_mod_eleven] at hlo
  right
  by_contra h10
  have hdim : Module.finrank (ZMod 2) V = 11 ∨ Module.finrank (ZMod 2) V = 12 := by omega
  have hfix := normalizer_invariants_of_prime_restriction P N hcP hcN hn ρ hf hdim
  have hbound := finrank_le_ten_of_index_twelve_fixed N hi ρ (by omega) hfix
  omega

/-- No semisimplicity is needed: a simple head of degree one gives a fixed
covector; a head of degree ten leaves a nonzero trivial kernel. -/
theorem fixed_or_dual
    (P N : Subgroup G) (hcP : Nat.card P = 11) (hcN : Nat.card N = 55)
    (hn : N ≤ Subgroup.normalizer (P : Set G)) (hi : N.index = 12)
    (hgen : Subgroup.normalClosure (P : Set G) = ⊤)
    (ρ : Representation (ZMod 2) G V)
    (hd : Module.finrank (ZMod 2) V = 11 ∨ Module.finrank (ZMod 2) V = 12) :
    ρ.invariants ≠ ⊥ ∨ ρ.dual.invariants ≠ ⊥ := by
  let : Nontrivial V := Module.nontrivial_of_finrank_pos (by omega :
    0 < Module.finrank (ZMod 2) V)
  let : IsCoatomic (Subrepresentation ρ) := SimpleHeadQuotient.subrepresentation_coatomic ρ
  obtain ⟨S, hS⟩ := IsCoatomic.exists_coatom (Subrepresentation ρ)
  let : S.quotientRepresentation.IsIrreducible :=
    SimpleHeadQuotient.irreducible_quotient_of_isCoatom S hS
  have hsum := S.toSubmodule.finrank_quotient_add_finrank
  rcases simple_degree P N hcP hcN hn hi hgen S.quotientRepresentation (by omega) with hq | hq
  · right
    let : Nontrivial (V ⧸ S.toSubmodule) := Module.nontrivial_of_finrank_eq_succ hq
    obtain ⟨q, hq0⟩ := exists_ne (0 : V ⧸ S.toSubmodule)
    obtain ⟨f, hf⟩ := Module.Projective.exists_dual_eq_one (ZMod 2) hq0
    let l : Module.Dual (ZMod 2) V := f.comp S.toSubmodule.mkQ
    have hact := action_eq_one_of_finrank_lt_ten P hcP hgen S.quotientRepresentation (by omega)
    apply (Submodule.ne_bot_iff _).mpr
    refine ⟨l, ?_, ?_⟩
    · intro g
      ext v
      change f (S.quotientRepresentation g⁻¹ (S.toSubmodule.mkQ v)) =
        f (S.toSubmodule.mkQ v)
      rw [hact]
      rfl
    · intro hz
      obtain ⟨v, hv⟩ := S.toSubmodule.mkQ_surjective q
      have hl : l v = 1 := by change f (S.toSubmodule.mkQ v) = 1; rw [hv, hf]
      rw [hz] at hl
      exact zero_ne_one hl
  · left
    have hpos : 0 < Module.finrank (ZMod 2) S.toSubmodule := by omega
    let : Nontrivial S.toSubmodule := Module.nontrivial_of_finrank_pos hpos
    obtain ⟨v, hv⟩ := exists_ne (0 : S.toSubmodule)
    have hact := action_eq_one_of_finrank_lt_ten P hcP hgen S.toRepresentation (by omega)
    apply (Submodule.ne_bot_iff _).mpr
    refine ⟨v.val, ?_, fun hz => hv (Subtype.ext hz)⟩
    intro g
    exact congrArg Subtype.val (LinearMap.congr_fun (hact g) v)

omit [Finite G] in
private theorem irreducible_dual (ρ : Representation (ZMod 2) G V) [ρ.IsIrreducible] :
    ρ.dual.IsIrreducible := by
  let : Nontrivial V := Subrepresentation.irreducible_module_nontrivial ρ
  refine ⟨fun W => ?_⟩
  let U : Subrepresentation ρ :=
    { toSubmodule := W.toSubmodule.dualCoannihilator
      apply_mem_toSubmodule g v hv := by
        rw [Submodule.mem_dualCoannihilator] at hv ⊢
        intro f hf
        have h := hv (ρ.dual g⁻¹ f) (W.apply_mem_toSubmodule g⁻¹ hf)
        simpa only [dual_apply, Module.Dual.transpose_apply, LinearMap.comp_apply, inv_inv] using h }
  have hd : U.toSubmodule.dualAnnihilator = W.toSubmodule :=
    Subspace.dualCoannihilator_dualAnnihilator_eq
  rcases eq_bot_or_eq_top U with h | h
  · right
    apply Subrepresentation.toSubmodule_injective
    rw [← hd, h]
    exact Submodule.dualAnnihilator_bot
  · left
    apply Subrepresentation.toSubmodule_injective
    rw [← hd, h]
    exact Submodule.dualAnnihilator_top

/-- The two index-twelve actions exclude simple modules of degree eleven or
 twelve. All normal-generation and relative-normalizer hypotheses are explicit. -/
theorem finrank_le_ten_of_two_indices
    (H : Subgroup G) (hH : H.index = 12)
    (P N : Subgroup H) (hcP : Nat.card P = 11) (hcN : Nat.card N = 55)
    (hn : N ≤ Subgroup.normalizer (P : Set H)) (hi : N.index = 12)
    (hgen : Subgroup.normalClosure (P : Set H) = ⊤)
    (ρ : Representation (ZMod 2) G V) [ρ.IsIrreducible]
    (hd : Module.finrank (ZMod 2) V ≤ 12) : Module.finrank (ZMod 2) V ≤ 10 := by
  by_contra h
  have hdim : Module.finrank (ZMod 2) V = 11 ∨ Module.finrank (ZMod 2) V = 12 := by omega
  rcases fixed_or_dual P N hcP hcN hn hi hgen (ρ.comp H.subtype) hdim with hfix | hfix
  · exact h (finrank_le_ten_of_index_twelve_fixed H hH ρ (by omega) hfix)
  · let : ρ.dual.IsIrreducible := irreducible_dual ρ
    have hbound := finrank_le_ten_of_index_twelve_fixed H hH ρ.dual
      (by rw [Subspace.dual_finrank_eq]; omega) hfix
    rw [Subspace.dual_finrank_eq] at hbound
    exact h hbound

end Representation.MathieuSmall.M11DegreeTwelve.InducedHeads
