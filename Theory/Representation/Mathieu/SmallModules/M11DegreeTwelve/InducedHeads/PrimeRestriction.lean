module

public import Theory.Representation.Mathieu.SmallModules.M11DegreeTwelve.FixedVectors
public import Theory.Representation.SimpleHeadQuotient

/-!
# Binary representations of a group normally generated by an eleven-subgroup

Normal generation makes a representation either trivial or faithful on the
prime-order subgroup. Such a faithful restriction moves at least ten dimensions.
Through dimension twelve its fixed space has dimension at most two, and an
order-fifty-five normalizing subgroup acts trivially there. Orbit counting
makes this fixed space nonzero in dimensions eleven and twelve.

This generalizes the native M11 fixed-vector argument to its index-twelve
overgroup, without assuming that overgroup is simple. Source: James,
J. Algebra 27 (1973), 57--111; Aschbacher--Smith K.4, printed p.457.
-/

public noncomputable section
namespace Representation.MathieuSmall.M11DegreeTwelve.InducedHeads
open BinaryOffender
variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V]

omit [Finite G] [FiniteDimensional (ZMod 2) V] in
/-- A trivial irreducible representation has dimension one. -/
theorem finrank_one_of_trivial (ρ : Representation (ZMod 2) G V) [ρ.IsIrreducible]
    (h : ∀ g, ρ g = 1) : Module.finrank (ZMod 2) V = 1 := by
  let : Nontrivial V := Subrepresentation.irreducible_module_nontrivial ρ
  obtain ⟨w, hw⟩ := exists_ne (0 : V)
  let S : Subrepresentation ρ :=
    ⟨Submodule.span (ZMod 2) {w}, fun g v hv => by
      simpa only [h, Module.End.one_apply] using hv⟩
  have hS : S ≠ ⊥ := by
    intro hz
    have hwS : w ∈ S := Submodule.subset_span (Set.mem_singleton w)
    rw [hz] at hwS
    exact hw hwS
  have ht : S = ⊤ := (eq_bot_or_eq_top S).resolve_left hS
  have ht' : Submodule.span (ZMod 2) {w} = ⊤ := congrArg Subrepresentation.toSubmodule ht
  have hd := finrank_span_singleton (K := ZMod 2) hw
  rw [ht', finrank_top] at hd
  exact hd

omit [Finite G] [FiniteDimensional (ZMod 2) V] in
/-- Normal generation upgrades a nonfaithful prime restriction to triviality
of the entire representation. -/
theorem trivial_of_not_injective_on_eleven
    (P : Subgroup G) (hc : Nat.card P = 11)
    (hgen : Subgroup.normalClosure (P : Set G) = ⊤)
    (ρ : Representation (ZMod 2) G V) (hf : ¬ Function.Injective (ρ.comp P.subtype)) :
    ∀ g, ρ g = 1 := by
  let : Fact (Nat.Prime 11) := ⟨by decide⟩
  let : IsSimpleGroup P := isSimpleGroup_of_prime_card hc
  have hk : (ρ.comp P.subtype).ker = ⊤ :=
    ((ρ.comp P.subtype).normal_ker.eq_bot_or_eq_top).resolve_left
      (fun h => hf ((ρ.comp P.subtype).ker_eq_bot_iff.mp h))
  have hPk : (P : Set G) ⊆ (ρ.ker : Set G) := by
    intro g hg
    exact show (⟨g, hg⟩ : P) ∈ (ρ.comp P.subtype).ker from hk ▸ Subgroup.mem_top _
  have hk' := Subgroup.normalClosure_le_normal hPk
  rw [hgen] at hk'
  intro g
  exact hk' (Subgroup.mem_top g)

/-- The low-degree conclusion uses normal generation, not simplicity. -/
theorem action_eq_one_of_finrank_lt_ten
    (P : Subgroup G) (hc : Nat.card P = 11)
    (hgen : Subgroup.normalClosure (P : Set G) = ⊤)
    (ρ : Representation (ZMod 2) G V) (hd : Module.finrank (ZMod 2) V < 10) :
    ∀ g, ρ g = 1 := by
  apply trivial_of_not_injective_on_eleven P hc hgen ρ
  intro hf
  have h := BinaryPrimeDegree.orderOf_le_finrank (ρ.comp P.subtype) hf
    (by decide : Nat.Prime 11) (by decide) (by rw [hc])
  rw [BinaryPrimeDegree.orderOf_two_mod_eleven] at h
  omega

omit [Finite G] [FiniteDimensional (ZMod 2) V] in
/-- Every nontrivial simple module is faithful on the normally generating
subgroup of prime order. -/
theorem injective_on_eleven_of_irreducible
    (P : Subgroup G) (hc : Nat.card P = 11)
    (hgen : Subgroup.normalClosure (P : Set G) = ⊤)
    (ρ : Representation (ZMod 2) G V) [ρ.IsIrreducible]
    (hd : 1 < Module.finrank (ZMod 2) V) : Function.Injective (ρ.comp P.subtype) := by
  by_contra hf
  have h := finrank_one_of_trivial ρ (trivial_of_not_injective_on_eleven P hc hgen ρ hf)
  omega

private theorem action_eq_one_of_card_fiftyfive
    {N W : Type*} [Group N] [Finite N] [AddCommGroup W] [Module (ZMod 2) W]
    [FiniteDimensional (ZMod 2) W] (τ : Representation (ZMod 2) N W)
    (hc : Nat.card N = 55) (hd : Module.finrank (ZMod 2) W ≤ 2) (g : N) :
    τ g = 1 := by
  let b := Module.finBasis (ZMod 2) W
  let e := Matrix.GeneralLinearGroup.toLin' b
  let φ := e.symm.toMonoidHom.comp τ.asGroupHom
  have h₁ : orderOf (φ g) ∣ 55 :=
    (orderOf_map_dvd φ g).trans (hc ▸ orderOf_dvd_natCard g)
  have hGL : Nat.card (Matrix.GeneralLinearGroup
      (Fin (Module.finrank (ZMod 2) W)) (ZMod 2)) ∣ 6 := by
    generalize Module.finrank (ZMod 2) W = d at hd ⊢
    interval_cases d <;> rw [Matrix.card_GL_field] <;> norm_num [Fin.prod_univ_succ]
  have h₂ := (orderOf_dvd_natCard (φ g)).trans hGL
  have ho : orderOf (φ g) = 1 := by
    have h := Nat.dvd_gcd h₁ h₂
    exact Nat.dvd_one.mp (by norm_num only [Nat.reduceGcd] at h ⊢; exact h)
  have he : φ g = 1 := orderOf_eq_one_iff.mp ho
  have hu : τ.asGroupHom g = 1 := e.symm.injective (by simpa [φ] using he)
  exact congrArg Units.val hu

private def fixedRepresentation (ρ : Representation (ZMod 2) G V)
    (P N : Subgroup G) (hn : N ≤ Subgroup.normalizer (P : Set G)) :
    Subrepresentation (ρ.comp N.subtype) where
  toSubmodule := fixedSpace ρ P
  apply_mem_toSubmodule g v hv := by
    intro x
    have hx : (g : G)⁻¹ * x * g ∈ P := by
      simpa only [inv_inv] using
        (Subgroup.mem_normalizer_iff.mp (hn (N.inv_mem g.property)) x).mp x.property
    have h := congrArg (ρ g.val) (hv ⟨g.val⁻¹ * x * g.val, hx⟩)
    change ρ g.val (ρ (g.val⁻¹ * x * g.val) v) = ρ g.val v at h
    change ρ x (ρ g.val v) = ρ g.val v
    simpa only [← Module.End.mul_apply, ← map_mul, mul_assoc, mul_inv_cancel_left] using h

private theorem fixed_finrank_le_two
    (P : Subgroup G) (hc : Nat.card P = 11)
    (ρ : Representation (ZMod 2) G V) (hf : Function.Injective (ρ.comp P.subtype))
    (hd : Module.finrank (ZMod 2) V ≤ 12) :
    Module.finrank (ZMod 2) (fixedSpace ρ P) ≤ 2 := by
  let : Fact (Nat.Prime 11) := ⟨by decide⟩
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := P) 11 (by rw [hc])
  have hz : Subgroup.zpowers x = ⊤ :=
    Subgroup.eq_of_le_of_card_ge le_top (by rw [Nat.card_zpowers, hx, Subgroup.card_top, hc])
  have he : fixedSpace (ρ.comp P.subtype) (⊤ : Subgroup P) = fixedSpace ρ P := by
    ext v
    constructor
    · intro hv g; exact hv ⟨g, Subgroup.mem_top g⟩
    · intro hv g; exact hv g.val
  have hlo := ten_le_fixedCodim_of_order_eleven (ρ.comp P.subtype) hf x hx
  have hsum := fixedCodim_add_finrank (ρ.comp P.subtype) (Subgroup.zpowers x)
  rw [hz, he] at hsum
  rw [hz] at hlo
  omega

/-- The order-fifty-five normalizer fixes a nonzero vector in dimensions eleven
and twelve whenever the prime-order subgroup acts faithfully. -/
theorem normalizer_invariants_of_prime_restriction
    (P N : Subgroup G) (hcP : Nat.card P = 11) (hcN : Nat.card N = 55)
    (hn : N ≤ Subgroup.normalizer (P : Set G))
    (ρ : Representation (ZMod 2) G V) (hf : Function.Injective (ρ.comp P.subtype))
    (hd : Module.finrank (ZMod 2) V = 11 ∨ Module.finrank (ZMod 2) V = 12) :
    invariants (ρ.comp N.subtype) ≠ ⊥ := by
  have hdim := fixed_finrank_le_two P hcP ρ hf (by omega)
  have hle : fixedSpace ρ P ≤ invariants (ρ.comp N.subtype) := by
    intro v hv g
    have h := action_eq_one_of_card_fiftyfive (fixedRepresentation ρ P N hn).toRepresentation
      hcN hdim g
    exact congrArg Subtype.val (LinearMap.congr_fun h ⟨v, hv⟩)
  suffices hpfix : fixedSpace ρ P ≠ ⊥ by
    intro hz
    exact hpfix (le_bot_iff.mp (hz ▸ hle))
  let : MulAction P V := {
    smul g v := ρ g.val v
    one_smul v := by change ρ 1 v = v; rw [map_one]; rfl
    mul_smul g h v := by change ρ (g.val * h.val) v = ρ g.val (ρ h.val v); rw [map_mul]; rfl }
  let : Finite V := Module.finite_of_finite (ZMod 2)
  let : Fact (Nat.Prime 11) := ⟨by decide⟩
  have hp : IsPGroup 11 P := IsPGroup.of_card (n := 1) (by simpa using hcP)
  intro hz
  let : Unique (MulAction.fixedPoints P V) := {
    default := ⟨0, fun g => map_zero (ρ g.val)⟩
    uniq v := by
      apply Subtype.ext
      have hv : v.val ∈ fixedSpace ρ P := v.property
      rw [hz] at hv
      exact hv }
  have h := hp.card_modEq_card_fixedPoints V
  have hcard : Nat.card V = 2 ^ Module.finrank (ZMod 2) V := by
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2)]
    norm_num
  rw [hcard, Nat.card_unique (α := MulAction.fixedPoints P V)] at h
  rcases hd with hd | hd <;> rw [hd] at h <;> norm_num [Nat.ModEq] at h

end Representation.MathieuSmall.M11DegreeTwelve.InducedHeads
