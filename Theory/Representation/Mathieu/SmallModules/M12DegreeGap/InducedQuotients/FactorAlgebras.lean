public import Theory.Representation.Mathieu.SmallModules.M12DegreeGap.InducedQuotients.FactorAlgebras.F0
public import Theory.Representation.Mathieu.SmallModules.M12DegreeGap.InducedQuotients.FactorAlgebras.F1
public import Theory.Representation.Mathieu.SmallModules.M12DegreeGap.InducedQuotients.FactorAlgebras.F2
public import Theory.Representation.Mathieu.SmallModules.M12DegreeGap.InducedQuotients.FactorAlgebras.F3
public import Theory.Representation.Mathieu.SmallModules.M12DegreeGap.InducedQuotients.FactorAlgebras.F4
public import Theory.Representation.Mathieu.SmallModules.M12DegreeGap.InducedQuotients.FactorAlgebras.F5
public import Theory.Representation.Mathieu.SmallModules.M12DegreeGap.InducedQuotients.FactorAlgebras.F6
import Mathlib.Tactic.FinCases

/-!
# Full matrix algebras on the seven induced-heart factors

For each literal diagonal block of the native M₁₂ tensor action, the two
published matrices generate the full binary matrix algebra. Each certificate
constructs a rank-one matrix by checked additions and products, then checks
spanning row and column orbits. Their outer products span all matrix units.
The factors of equal degree have separate certificates in their own coordinates.

The application supplies exactly the density premise of
`filtration_of_flagCoordinates`. Construction of the actual invariant flag
remains with its independent owner; only `FlagCoordinates` is an input here.

Source context: James, J. Algebra 27 (1973), 57–111; the ordinary degree input
to Aschbacher–Smith Chapter K, printed pp.451 and 457. The certificate generator
and its provenance are in `FactorAlgebras/source/`.
-/

public noncomputable section
namespace Representation.MathieuSmall.M12DegreeGap.InducedQuotients
open CertificateData

/-- The two published matrices of every factor generate its full matrix algebra. -/
theorem fullFactorAlgebra (t : Factor)
    (Q : Subalgebra (ZMod 2)
      (Matrix (Fin (degree t)) (Fin (degree t)) (ZMod 2)))
    (hA : ∀ j : Fin 2, factorMatrix t j ∈ Q) : Q = ⊤ := by
  fin_cases t
  · exact FactorAlgebras.F0.full Q hA
  · exact FactorAlgebras.F1.full Q hA
  · exact FactorAlgebras.F2.full Q hA
  · exact FactorAlgebras.F3.full Q hA
  · exact FactorAlgebras.F4.full Q hA
  · exact FactorAlgebras.F5.full Q hA
  · exact FactorAlgebras.F6.full Q hA

/-- In particular the subalgebra generated by the actual two matrices is full. -/
theorem adjoin_factorMatrix_eq_top (t : Factor) :
    Algebra.adjoin (ZMod 2) (Set.range (factorMatrix t)) = ⊤ :=
  fullFactorAlgebra t _ fun j => Algebra.subset_adjoin (Set.mem_range_self j)

/-- Discharge the density input on the literal successive quotients of the flag. -/
theorem factorDegreeFiltration_of_flagCoordinates (C : FlagCoordinates) :
    FactorDegreeFiltration ({1, 10, 44} : Set ℕ) tensorAction :=
  filtration_of_flagCoordinates C fullFactorAlgebra

end Representation.MathieuSmall.M12DegreeGap.InducedQuotients
