def generatorColumns (j : Fin 2) (y : Fin 120) : ℕ := (generatorColumnList j)[y.val]?.getD 0

def basis (y : Fin 120) : ℕ := basisList[y.val]?.getD 0

def inverseColumns (y : Fin 120) : ℕ := inverseColumnList[y.val]?.getD 0

def actionColumns (j : Fin 2) (y : Fin 120) : ℕ := (actionColumnList j)[y.val]?.getD 0

theorem basisList_length : basisList.length = 120 := by decide +kernel

theorem generatorColumnList_length : ∀ j, (generatorColumnList j).length = 120 := by decide +kernel

def generatorMatrix (j : Fin 2) : Matrix (Fin 120) (Fin 120) (ZMod 2) :=
  fun x y => bit (generatorColumns j y) x.val

def basisMatrix : Matrix (Fin 120) (Fin 120) (ZMod 2) := fun x y => bit (basis y) x.val

def inverseMatrix : Matrix (Fin 120) (Fin 120) (ZMod 2) := fun x y => bit (inverseColumns y) x.val

def actionMatrix (j : Fin 2) : Matrix (Fin 120) (Fin 120) (ZMod 2) :=
  fun x y => bit (actionColumns j y) x.val

def factorMatrix (t : Factor) (j : Fin 2) :
    Matrix (Fin (degree t)) (Fin (degree t)) (ZMod 2) :=
  fun x y => actionMatrix j (blockIndex t x) (blockIndex t y)

end Representation.MathieuSmall.M12DegreeGap.InducedQuotients.CertificateData
