/-!
# Candidate binary coordinates for the Hermitian M22 induction

The two saved GAP orientations have flag dimensions
`0,98,108,109,119,153,163,164,198` and
`0,34,35,45,55,89,90,188,198`. We extend their successive row bases.
Treating each GAP row vector as a column transposes every action matrix:
`generatorColumns i j y` is column y of the candidate Lean matrix.

These are witness data, not an identification with the native M22 action.
`MatrixChecks` checks the basis and adapted action identities. The separate
model comparison must handle the actual stabilizer marking and conventions.
In particular i=0 and i=1 do not mean `Models.pointAction false` and `true`.

Source context: Guralnick--Malle I, Proposition 5.1, pp.15--16 and
Aschbacher--Smith Chapter K, pp.451--452,457. The reproducible extractor and
unchanged GAP discovery data are retained in `source/` beside this module.
-/

@[expose] public section
namespace Representation.MathieuSmall.M22Recognition.DegreeThirty.NineSubmodule.InducedHeads.HermitianFiltration

abbrev Space := Fin 198 → ZMod 2
abbrev Factor := Fin 8

def cut (i : Fin 2) (t : ℕ) : ℕ :=
  if i = 0 then ([0,98,108,109,119,153,163,164,198] : List ℕ)[t]?.getD 198
  else ([0,34,35,45,55,89,90,188,198] : List ℕ)[t]?.getD 198

def degree (i : Fin 2) (t : Factor) : ℕ := cut i (t.val + 1) - cut i t.val

theorem cut_zero : ∀ i, cut i 0 = 0 := by decide +kernel

theorem cut_last : ∀ i, cut i 8 = 198 := by decide +kernel

theorem cut_step : ∀ i (t : Factor),
    cut i t.val < cut i (t.val + 1) ∧ cut i (t.val + 1) ≤ 198 := by decide +kernel

theorem degree_allowed : ∀ i (t : Factor), degree i t ∈ ({1, 10, 34, 98} : Set ℕ) := by
  change ∀ i (t : Factor), degree i t = 1 ∨ degree i t = 10 ∨ degree i t = 34 ∨ degree i t = 98
  decide +kernel

theorem degree_pos (i : Fin 2) (t : Factor) : 0 < degree i t :=
  Nat.sub_pos_of_lt (cut_step i t).1

def blockIndex (i : Fin 2) (t : Factor) (x : Fin (degree i t)) : Fin 198 :=
  ⟨cut i t.val + x.val, by
    have hx := x.isLt
    have ht := cut_step i t
    dsimp [degree] at hx
    omega⟩

def bit (v x : ℕ) : ZMod 2 := if v.testBit x then 1 else 0

