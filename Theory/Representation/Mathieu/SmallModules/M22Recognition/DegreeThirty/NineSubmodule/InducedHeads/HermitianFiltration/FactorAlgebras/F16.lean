/-- Density of the literal factor with orientation 1 and flag index 6. -/
theorem full (Q : Subalgebra (ZMod 2)
    (Matrix (Fin (degree 1 6)) (Fin (degree 1 6)) (ZMod 2)))
    (hA : ∀ j : Fin 2, factorMatrix 1 6 j ∈ Q) : Q = ⊤ := by
  have hA' : ∀ j : Fin 2, matrix (n := 98) (actors j) ∈ Q := by
    intro j
    rw [actors_checked]
    exact hA j
  apply full_of_orbits Q (fun j => matrix (actors j)) hA'
    colsList rowsOrbitList ciList riList cp rp ca ra cparent rparent
  · intro x
    have h := congrArg (vector (n := 98)) (cstep x)
    rw [vector_combine _ (show (transposed (ca x)).length = 98 from by
      generalize ca x = j; revert j; decide +kernel), transpose_checked,
      vecMul_transpose] at h
    exact h
  · intro x
    have h := congrArg (vector (n := 98)) (rstep x)
    rw [vector_combine _ (show (actors (ra x)).length = 98 from by
      generalize ra x = j; revert j; decide +kernel)] at h
    exact h
  · decide +kernel
  · decide +kernel
  · exact cinverse
