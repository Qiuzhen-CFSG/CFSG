set_option maxRecDepth 8192 in
private theorem cstep : ∀ x : Fin 33, combineList (transposed (ca x)) (entry colsList (cp x).val) = entry colsList x.succ.val := by decide +kernel

set_option maxRecDepth 8192 in
private theorem cinverse : ∀ x : Fin 34, combineList colsList (entry ciList x.val) = 2 ^ x.val := by decide +kernel

set_option maxRecDepth 8192 in
private theorem rparent : ∀ x : Fin 33, rp x < x.succ := by decide +kernel

set_option maxRecDepth 8192 in
private theorem rstep : ∀ x : Fin 33, combineList (actors (ra x)) (entry rowsOrbitList (rp x).val) = entry rowsOrbitList x.succ.val := by decide +kernel

set_option maxRecDepth 8192 in
private theorem rinverse : ∀ x : Fin 34, combineList rowsOrbitList (entry riList x.val) = 2 ^ x.val := by decide +kernel

set_option maxRecDepth 8192 in
private theorem rankOne_checked : ∀ x : Fin 34, entry c25 x.val = if (entry colsList 0).testBit x.val then entry rowsOrbitList 0 else 0 := by decide +kernel

private theorem rankOne_mem (Q : Subalgebra (ZMod 2) (Mat 34))
    (hA : ∀ j : Fin 2, matrix (actors j) ∈ Q) :
    vecMulVec (vector (entry colsList 0)) (vector (entry rowsOrbitList 0)) ∈ Q := by
  have h0 := Certificate.one_mem Q c0 (by decide +kernel)
  have h1 : matrix c1 ∈ Q := hA 0
  have h2 : matrix c2 ∈ Q := hA 1
  have h3 := Certificate.mul_mem Q c1 c2 c3 h1 h2 (by decide +kernel) check3
  have h4 := Certificate.add_mem Q c0 c3 c4 h0 h3 check4
  have h5 := Certificate.mul_mem Q c3 c3 c5 h3 h3 (by decide +kernel) check5
  have h6 := Certificate.mul_mem Q c5 c4 c6 h5 h4 (by decide +kernel) check6
  have h7 := Certificate.add_mem Q c4 c6 c7 h4 h6 check7
  have h8 := Certificate.mul_mem Q c5 c5 c8 h5 h5 (by decide +kernel) check8
  have h9 := Certificate.add_mem Q c7 c8 c9 h7 h8 check9
  have h10 := Certificate.mul_mem Q c8 c3 c10 h8 h3 (by decide +kernel) check10
  have h11 := Certificate.mul_mem Q c10 c9 c11 h10 h9 (by decide +kernel) check11
  have h12 := Certificate.add_mem Q c9 c11 c12 h9 h11 check12
  have h13 := Certificate.mul_mem Q c10 c10 c13 h10 h10 (by decide +kernel) check13
  have h14 := Certificate.add_mem Q c12 c13 c14 h12 h13 check14
  have h15 := Certificate.mul_mem Q c14 c2 c15 h14 h2 (by decide +kernel) check15
  have h16 := Certificate.mul_mem Q c15 c2 c16 h15 h2 (by decide +kernel) check16
  have h17 := Certificate.mul_mem Q c16 c1 c17 h16 h1 (by decide +kernel) check17
  have h18 := Certificate.mul_mem Q c17 c2 c18 h17 h2 (by decide +kernel) check18
  have h19 := Certificate.mul_mem Q c18 c14 c19 h18 h14 (by decide +kernel) check19
  have h20 := Certificate.add_mem Q c19 c14 c20 h19 h14 check20
  have h21 := Certificate.mul_mem Q c20 c2 c21 h20 h2 (by decide +kernel) check21
  have h22 := Certificate.mul_mem Q c21 c1 c22 h21 h1 (by decide +kernel) check22
  have h23 := Certificate.mul_mem Q c22 c2 c23 h22 h2 (by decide +kernel) check23
  have h24 := Certificate.mul_mem Q c23 c1 c24 h23 h1 (by decide +kernel) check24
  have h25 := Certificate.mul_mem Q c24 c20 c25 h24 h20 (by decide +kernel) check25
  rw [← rankOne_eq c25 _ _ rankOne_checked]
  exact h25

/-- Density of the literal factor with orientation 0 and flag index 4. -/
theorem full (Q : Subalgebra (ZMod 2)
    (Matrix (Fin (degree 0 4)) (Fin (degree 0 4)) (ZMod 2)))
    (hA : ∀ j : Fin 2, factorMatrix 0 4 j ∈ Q) : Q = ⊤ := by
  have hA' : ∀ j : Fin 2, matrix (n := 34) (actors j) ∈ Q := by
    intro j
    rw [actors_checked]
    exact hA j
  apply full_of_orbits (m := 33) Q (fun j => matrix (n := 34) (actors j)) hA'
    colsList rowsOrbitList ciList riList cp rp ca ra cparent rparent
  · intro x
    have h := congrArg (vector (n := 34)) (cstep x)
    rw [vector_combine _ (show (transposed (ca x)).length = 34 from by
      generalize ca x = j; revert j; decide +kernel), transpose_checked,
      vecMul_transpose] at h
    exact h
  · intro x
    have h := congrArg (vector (n := 34)) (rstep x)
    rw [vector_combine _ (show (actors (ra x)).length = 34 from by
      generalize ra x = j; revert j; decide +kernel)] at h
    exact h
  · decide +kernel
  · decide +kernel
  · exact cinverse
  · exact rinverse
  · exact rankOne_mem Q hA'

