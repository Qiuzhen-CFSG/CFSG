private theorem actors_checked (j : Fin 2) :
    matrix (n := 34) (actors j) = factorMatrix 4 j := by
  have h : (matrix (n := 34) (transposed j)).transpose = factorMatrix 4 j := by
    ext x y
    change Representation.MathieuSmall.M22Recognition.DegreeThirty.NineSubmodule.InducedHeads.HermitianFiltration.bit (entry (transposed j) y.val) x.val = _
    rw [packed_columns]
    exact SimpleFactors.factorMatrix_entry_shift 4 j x y
  rw [transpose_checked, transpose_transpose] at h
  exact h

