private theorem element_mem (Q : Subalgebra (ZMod 2) (Mat 34))
    (hA : ∀ j : Fin 2, matrix (actors j) ∈ Q) : matrix c23 ∈ Q := by
  have h0 := Certificate.one_mem Q c0 (by decide +kernel)
  have h1 : matrix c1 ∈ Q := hA 0
  have h2 : matrix c2 ∈ Q := hA 1
