private theorem packed_columns : ∀ (j : Fin 2) (y : Fin 34), entry (transposed j) y.val = (actionColumns j)[(blockIndex 2 y).val]! >>> cut 2 := by decide +kernel

private theorem actors_checked (j : Fin 2) :
    matrix (n := 34) (actors j) = factorMatrix 2 j := by
  have h : (matrix (n := 34) (transposed j)).transpose = factorMatrix 2 j := by
    ext x y
    change Representation.MathieuSmall.M22Recognition.DegreeThirty.NineSubmodule.InducedHeads.HermitianFiltration.bit (entry (transposed j) y.val) x.val = _
    rw [packed_columns]
    exact SimpleFactors.factorMatrix_entry_shift 2 j x y
  rw [transpose_checked, transpose_transpose] at h
  exact h

