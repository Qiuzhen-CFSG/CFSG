module

public import Theory.Representation.Mathieu.SmallModules.M12Recognition.PointClassification.GeneratorReduction
public import Mathlib.RingTheory.TwoSidedIdeal.Operations
public import Mathlib.RingTheory.TwoSidedIdeal.Kernel
/-!
# The order-eleven norm relation for degree-ten binary M₁₁ modules

The norm of the marked eleven-element AB maps into its fixed space. The
order-eleven degree bound makes that fixed space zero in a faithful
binary representation of degree ten. Thus the entire two-sided ideal
generated by this norm annihilates the representation.

The definitions use the actual M₁₁ group algebra and the literal point
representation. They give the shared mathematical interface for a finite
kernel-cube certificate used in the normalized involution problem. The
certificate is not asserted here.

Source application: the James input to Aschbacher--Smith G.7.3(2), printed
p.348 (PDF p.359). The fixed-space argument is G.7.1(1).
-/

public section
open scoped BigOperators MonoidAlgebra
open Sporadic.Mathieu Representation.BinaryOffender
namespace Representation.MathieuSmall.M12Recognition.PointClassification.NormalizedInvolution
/-- The sum of all powers of the marked element AB of order eleven. -/
@[expose] noncomputable def elevenNorm : (ZMod 2)[M11] :=
  ∑ i ∈ Finset.range 11, MonoidAlgebra.single (m11Sylow11Generator ^ i) 1
/-- The two-sided ideal generated by the marked eleven-norm. -/
@[expose] noncomputable def elevenIdeal : TwoSidedIdeal ((ZMod 2)[M11]) :=
  TwoSidedIdeal.span {elevenNorm}
/-- The annihilator of the actual reference module in the binary M₁₁ group algebra. -/
@[expose] noncomputable def referenceKernel : TwoSidedIdeal ((ZMod 2)[M11]) :=
  TwoSidedIdeal.ker pointRepresentation.asAlgebraHom

/-- A faithful action in degree ten annihilates the eleven-norm. -/
theorem elevenNorm_action_eq_zero (τ : Representation (ZMod 2) M11 M12Heart)
    (hf : Function.Injective τ) : τ.asAlgebraHom elevenNorm = 0 := by
  have hfix := eleven_fixedSpace_eq_bot τ hf finrank_m12Heart.le
    m11Sylow11Generator m11Sylow11Generator_order
  have hp : (τ m11Sylow11Generator)^11 = 1 := by
    have hc : m11Sylow11Generator ^ 11 = 1 := by
      simpa only [m11Sylow11Generator_order] using pow_orderOf_eq_one m11Sylow11Generator
    rw [← map_pow, hc, map_one]
  have h := mul_geom_sum (τ m11Sylow11Generator) 11
  rw [hp, sub_self, sub_mul, one_mul, sub_eq_zero] at h
  have hn : τ.asAlgebraHom elevenNorm =
      ∑ i ∈ Finset.range 11, (τ m11Sylow11Generator)^i := by
    simp [elevenNorm, map_pow]
  rw [hn]
  apply LinearMap.ext
  intro v
  have hv : (∑ i ∈ Finset.range 11, (τ m11Sylow11Generator)^i) v ∈
      fixedSpace τ (Subgroup.zpowers m11Sylow11Generator) := by
    rw [mem_fixedSpace_zpowers_iff]
    exact LinearMap.congr_fun h v
  rwa [hfix, Submodule.mem_bot] at hv

/-- Every relation in the norm-generated two-sided ideal acts as zero. -/
theorem elevenIdeal_le_kernel (τ : Representation (ZMod 2) M11 M12Heart)
    (hf : Function.Injective τ) : elevenIdeal ≤ TwoSidedIdeal.ker τ.asAlgebraHom := by
  apply TwoSidedIdeal.span_le.mpr
  intro x hx
  rcases Set.mem_singleton_iff.mp hx with rfl
  change τ.asAlgebraHom elevenNorm = 0
  exact elevenNorm_action_eq_zero τ hf
end Representation.MathieuSmall.M12Recognition.PointClassification.NormalizedInvolution
