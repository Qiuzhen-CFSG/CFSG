/-- Access one small block without unfolding the whole table. -/
def tableEntry (table : Array (Array ℕ)) (i : ℕ) : ℕ :=
  (table[i / 128]!)[i % 128]!

/-- Decode at most 32 letters; all supplied words have at most 27. -/
def decodeWord : ℕ → ℕ → List (Fin 2)
  | 0, _ => []
  | n + 1, c => if c ≤ 1 then [] else decodeWord n (c / 2) ++ [Fin.ofNat 2 c]

def indexWord (i : Index) : List (Fin 2) := decodeWord 32 (tableEntry wordCodes i.val)

noncomputable def indexElement (i : Index) : Sporadic.Mathieu.M11 :=
  CertificateData.evalWord (indexWord i)

def basisIndex (j : Fin 300) : Index := Fin.ofNat 7920 (tableEntry basisIndices j.val)

def leftIndex (s : Fin 2) (j : Fin 300) : Index :=
  Fin.ofNat 7920 ((leftIndices[s.val]!)[j.val]!)

def seedEntry (k : Seed) (t : Fin 11) : Index :=
  Fin.ofNat 7920 (((tableEntry seedCodes k.val) >>> (13 * t.val)) % 8192)

def translateLeft (k : Seed) : Index := Fin.ofNat 7920 ((tableEntry translateCodes k.val) % 8192)

def translateRight (k : Seed) : Index := Fin.ofNat 7920 ((tableEntry translateCodes k.val) / 8192)

def combinationCode (s : Fin 2) (j : Fin 300) : ℕ := (combinationCodes[s.val]!)[j.val]!

/-- Each coefficient is binary, with repeated indices counted modulo two. -/
noncomputable def seedVector (k : Seed) : Coordinates :=
  ∑ t : Fin 11, Pi.single (seedEntry k t) 1

/-- A concrete sum of the original seeds, not of unverified echelon rows. -/
noncomputable def combinationVector (s : Fin 2) (j : Fin 300) : Coordinates :=
  ∑ k : Seed, if (combinationCode s j).testBit k.val then seedVector k else 0

noncomputable def columnVector (s : Fin 2) (j : Fin 300) : Coordinates :=
  Pi.single (leftIndex s j) 1 -
    ∑ i : Fin 300, CertificateData.actionMatrix s i j • Pi.single (basisIndex i) 1

end Representation.MathieuSmall.M12Recognition.PointClassification.NormalizedInvolution.NormReduction.Inputs
