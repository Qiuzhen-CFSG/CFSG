theorem allBelow_spec (n : ℕ) (f : ℕ → Bool) :
    allBelow n f = true ↔ ∀ x < n, f x = true := by
  induction n with
  | zero => simp [allBelow]
  | succ n ih =>
    simp only [allBelow, Bool.and_eq_true, ih]
    constructor
    · rintro ⟨h, hn⟩ x hx
      by_cases he : x = n
      · simpa [he] using hn
      · exact h x (by omega)
    · intro h
      exact ⟨fun x hx => h x (by omega), h n (by omega)⟩

