theorem leftTable_eq : leftIndices = leftTable := by
  have h0 : (leftIndices[0]!).toList = (leftTable[0]!).toList := by decide +kernel
  have h1 : (leftIndices[1]!).toList = (leftTable[1]!).toList := by decide +kernel
  exact congrArg₂ (fun a b : Array Nat => #[a,b])
    ((@Array.toList_inj Nat (leftIndices[0]!) (leftTable[0]!)).mp h0)
    ((@Array.toList_inj Nat (leftIndices[1]!) (leftTable[1]!)).mp h1)

theorem leftIndex_value (s : Fin 2) (j : Fin 300) (l : Index)
    (h : Fin.ofNat 7920 ((leftTable[s.val]!)[j.val]!) = l) : leftIndex s j = l := by
  rw [leftIndex, leftTable_eq]
  exact h

