theorem row_of_values (s : Fin 2) (j : Fin 300) (a w : Nat) (l : Index) (v : Nat)
    (ha : CertificateData.actionColumns s j = a) (hl : leftIndex s j = l)
    (hw : combinationCode s j = w)
    (hc : 2^l.val ^^^ selectRows a 0 basisMasks = v)
    (hr : combinationMask w rowBlocks = v) :
    columnVector s j = combinationVector s j := by
  apply row_of_fast_masks
  rw [fastColumn, ha, hl, hw, hc, hr]

