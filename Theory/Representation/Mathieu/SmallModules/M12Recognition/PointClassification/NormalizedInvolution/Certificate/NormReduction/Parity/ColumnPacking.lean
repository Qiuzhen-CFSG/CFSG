theorem basisMasks_spec : basisMasks =
    (List.range 300).map (fun i => 2^(basisIndex (Fin.ofNat 300 i)).val) := by
  decide +kernel

def fastColumn (s : Fin 2) (j : Fin 300) : Nat :=
  2^(leftIndex s j).val ^^^ selectRows (CertificateData.actionColumns s j) 0 basisMasks

theorem unpack_fastColumn (s : Fin 2) (j : Fin 300) :
    unpack (fastColumn s j) = columnVector s j := by
  rw [fastColumn, unpack_xor, unpack_bit, basisMasks_spec,
    List.range_eq_range', unpack_selectRows_range]
  simp only [Nat.zero_add]
  rw [← Fin.sum_univ_eq_sum_range (fun i =>
    if (CertificateData.actionColumns s j).testBit i then
      unpack (2^(basisIndex (Fin.ofNat 300 i)).val) else 0) 300]
  unfold columnVector CertificateData.actionMatrix
  generalize leftIndex s j = l
  generalize basisIndex = b
  generalize CertificateData.actionColumns s j = c
  have hs : ∀ x : Coordinates, -x = x := by
    intro x
    ext i
    exact CharTwo.neg_eq (x i)
  rw [sub_eq_add_neg, hs]
  have hsum : (∑ i : Fin 300, if c.testBit i.val then
      unpack (2^(b (Fin.ofNat 300 i.val)).val) else 0) =
      ∑ i : Fin 300, (if c.testBit i.val then (1 : ZMod 2) else 0) • Pi.single (b i) 1 := by
    apply Finset.sum_congr rfl
    intro i _
    have hi : Fin.ofNat 300 i.val = i := Fin.ext (Nat.mod_eq_of_lt i.isLt)
    rw [hi]
    split_ifs <;> simp only [unpack_bit, one_smul, zero_smul]
  rw [hsum]

theorem row_of_fast_masks (s : Fin 2) (j : Fin 300)
    (h : fastColumn s j = combinationMask (combinationCode s j) rowBlocks) :
    columnVector s j = combinationVector s j := by
  rw [← unpack_fastColumn, h,
    unpack_combinationMask rowBlocks rowBlocks_lengths rowBlocks_spec]
  rfl

/-- Apply the normalized selector table without reducing the original table again. -/
theorem combinationCode_value (s : Fin 2) (j : Fin 300) (w : Nat)
    (h : (combinationTable[s.val]!)[j.val]! = w) : combinationCode s j = w :=
