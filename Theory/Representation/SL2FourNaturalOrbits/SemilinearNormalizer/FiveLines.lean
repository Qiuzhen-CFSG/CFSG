module

public import Theory.Representation.SL2FourNaturalOrbits.SemilinearNormalizer.Normalizer
public import BenderSuzuki.External.Huppert.II.theorem_6_14
import Mathlib.Tactic.FinCases

/-!
# The marked S₅ on the five F₄-lines

The normalized vectors (1,0), (0,1), (1,1), (ω,1), and (1+ω,1) label
all F₄-lines in the natural plane. Semilinearity induces a permutation of
these labels. In the subgroup generated by SL₂(4) and coordinate Frobenius,
the determinant is one. Fixing the first three lines forces the matrix to
be the identity, and fixing the fourth excludes Frobenius. Thus this action
is faithful. The SL₂ image has index two in S₅ and is A₅, while Frobenius
swaps precisely the last two labels; together they give all of S₅.

The final equivalence has domain the literal binary-linear subgroup
`action.range ⊔ Subgroup.zpowers frobeniusLinear`, and retains both its
relative SL₂ subgroup and its specified field involution. Its equivariance
theorem ties the identification to the original natural action.

Source: Aschbacher--Smith, combined manuscript (1 March 2004), 6.2.2 and
the proof of 6.2.5, printed pp.680--681 (PDF pp.697--698). The ambient
fusion and binary-plane classification remain separate results.
-/

@[expose] public section

open Matrix
namespace Representation.SL2FourNatural.SemilinearNormalizer

/-- Normalized representatives of ∞, 0, 1, ω, and 1+ω. -/
def lineVector : Fin 5 → V := ![![1, 0], ![0, 1], ![1, 1], ![omega, 1], ![1 + omega, 1]]
/-- The projective coordinate of a nonzero vector; zero is assigned label zero. -/
def lineIndex (v : V) : Fin 5 :=
  if v 1 = 0 then 0 else if v 0 = 0 then 1 else if v 0 = v 1 then 2
  else if v 0 = omega * v 1 then 3 else 4

theorem lineVector_ne_zero (i : Fin 5) : lineVector i ≠ 0 := by
  revert i
  decide +kernel
theorem lineIndex_vector (i : Fin 5) : lineIndex (lineVector i) = i := by
  revert i
  decide +kernel
theorem lineIndex_smul (c : F) (hc : c ≠ 0) (v : V) :
    lineIndex (c • v) = lineIndex v := by
  revert c v
  decide +kernel
theorem lineVector_covers (v : V) (hv : v ≠ 0) :
    ∃ c : F, c ≠ 0 ∧ v = c • lineVector (lineIndex v) := by
  revert v
  decide +kernel

private theorem lineIndex_first_three (v : V) :
    (lineIndex v = 0 → v 1 = 0) ∧
    (lineIndex v = 1 → v 0 = 0) ∧
    (lineIndex v = 2 → v 0 = v 1) := by
  revert v
  decide +kernel

private theorem square_one (c : F) (hc : c * c = 1) : c = 1 := by
  revert c
  decide +kernel

private theorem matrix_line_rigidity (A : Matrix (Fin 2) (Fin 2) F)
    (hd : A.det = 1)
    (h0 : lineIndex (A.mulVec (lineVector 0)) = 0)
    (h1 : lineIndex (A.mulVec (lineVector 1)) = 1)
    (h2 : lineIndex (A.mulVec (lineVector 2)) = 2) : A = 1 := by
  have h10 : A 1 0 = 0 := by
    simpa [lineVector, Matrix.mulVec, dotProduct, Fin.sum_univ_two] using
      (lineIndex_first_three _).1 h0
  have h01 : A 0 1 = 0 := by
    simpa [lineVector, Matrix.mulVec, dotProduct, Fin.sum_univ_two] using
      (lineIndex_first_three _).2.1 h1
  have he : A 0 0 = A 1 1 := by
    simpa [lineVector, Matrix.mulVec, dotProduct, Fin.sum_univ_two, h10, h01] using
      (lineIndex_first_three _).2.2 h2
  have h11 : A 1 1 = 1 := square_one _ (by
    simpa [Matrix.det_fin_two, h10, h01, he] using hd)
  funext i j
  fin_cases i <;> fin_cases j <;> simp [h10, h01, he, h11]

private theorem sl_card : Nat.card SL = 60 := by
  rw [BenderSuzuki.External.huppert614_card_specialLinearGroup,
    Nat.card_eq_fintype_card, card_field]
  norm_num

theorem lineIndex_natural (g : Gamma) (v : V) (hv : v ≠ 0) :
    lineIndex (natural g v) = lineIndex (natural g (lineVector (lineIndex v))) := by
  obtain ⟨c, hc, he⟩ := lineVector_covers v hv
  calc
    lineIndex (natural g v) =
        lineIndex (natural g (c • lineVector (lineIndex v))) :=
          congrArg (fun w => lineIndex (natural g w)) he
    _ = lineIndex (natural g (lineVector (lineIndex v))) := by
      rw [natural_smul, lineIndex_smul _ ((map_ne_zero g.right).mpr hc)]

private noncomputable def lineMap (g : Gamma) (i : Fin 5) : Fin 5 :=
  lineIndex (natural g (lineVector i))

private theorem lineMap_one (i : Fin 5) : lineMap 1 i = i := by
  simp [lineMap, lineIndex_vector]

private theorem lineMap_mul (g h : Gamma) (i : Fin 5) :
    lineMap (g * h) i = lineMap g (lineMap h i) := by
  change lineIndex (natural (g * h) (lineVector i)) = _
  rw [map_mul, LinearEquiv.mul_apply]
  exact lineIndex_natural g _ ((natural h).map_ne_zero_iff.mpr (lineVector_ne_zero i))

/-- The permutation action of ΓL₂(4) on the five natural F₄-lines. -/
noncomputable def fiveLines : Gamma →* Equiv.Perm (Fin 5) where
  toFun g :=
    { toFun i := lineIndex (natural g (lineVector i))
      invFun i := lineIndex (natural g⁻¹ (lineVector i))
      left_inv i := by
        change lineMap g⁻¹ (lineMap g i) = i
        rw [← lineMap_mul, inv_mul_cancel, lineMap_one]
      right_inv i := by
        change lineMap g (lineMap g⁻¹ i) = i
        rw [← lineMap_mul, mul_inv_cancel, lineMap_one] }
  map_one' := by apply Equiv.ext; intro i; exact lineMap_one i
  map_mul' g h := by apply Equiv.ext; intro i; exact lineMap_mul g h i

theorem fiveLines_apply (g : Gamma) (i : Fin 5) :
    fiveLines g i = lineIndex (natural g (lineVector i)) := rfl

theorem fiveLines_fieldElement : fiveLines fieldElement = Equiv.swap 3 4 := by
  apply Equiv.ext
  intro i
  rw [fiveLines_apply, natural_fieldElement]
  change lineIndex (fun j => (lineVector i j) ^ 2) = Equiv.swap 3 4 i
  fin_cases i <;> decide +kernel

private theorem specialFieldGamma_det (g : specialFieldGamma) : g.val.left.val.det = 1 := by
  have h := congrArg Units.val (specialFieldGamma_fixes_one g)
  simpa [labels_apply] using h

private theorem fiveLines_faithful (g : specialFieldGamma) (hg : fiveLines g.val = 1) : g = 1 := by
  have hi (i : Fin 5) : lineIndex (natural g.val (lineVector i)) = i :=
    Equiv.congr_fun hg i
  have hvec (i : Fin 5) (hi : i = 0 ∨ i = 1 ∨ i = 2) :
      (fun j => g.val.right (lineVector i j)) = lineVector i := by
    rcases hi with rfl | rfl | rfl <;>
      funext j <;> fin_cases j <;> simp [lineVector]
  have hA : g.val.left.val = 1 := by
    apply matrix_line_rigidity _ (specialFieldGamma_det g)
    · simpa only [natural_apply, hvec 0 (Or.inl rfl)] using hi 0
    · simpa only [natural_apply, hvec 1 (Or.inr (Or.inl rfl))] using hi 1
    · simpa only [natural_apply, hvec 2 (Or.inr (Or.inr rfl))] using hi 2
  have hl : g.val.left = 1 := Units.ext hA
  apply Subtype.ext
  apply SemidirectProduct.ext
  · exact hl
  · rcases fieldAutomorphism_cases g.val.right with h | h
    · exact h
    · have he : g.val = fieldElement := by
        apply SemidirectProduct.ext
        · exact hl
        · exact h
      have hbad := Equiv.congr_fun (he ▸ hg) (3 : Fin 5)
      rw [fiveLines_fieldElement] at hbad
      exact False.elim ((by decide : (Equiv.swap (3 : Fin 5) 4) 3 ≠ 3) hbad)

/-- Restriction of the line action to the SL₂–Frobenius subgroup. -/
noncomputable def specialFieldFiveLines : specialFieldGamma →* Equiv.Perm (Fin 5) :=
  fiveLines.comp specialFieldGamma.subtype

theorem specialFieldFiveLines_injective : Function.Injective specialFieldFiveLines := by
  apply (injective_iff_map_eq_one _).mpr
  exact fiveLines_faithful

/-- The marked SL₂ action on the same five lines. -/
noncomputable def specialFiveLines : SL →* Equiv.Perm (Fin 5) := fiveLines.comp special

theorem specialFiveLines_injective : Function.Injective specialFiveLines := by
  intro A B h
  have hAB : (⟨special A, (show special.range ≤ specialFieldGamma from le_sup_left) ⟨A, rfl⟩⟩ :
      specialFieldGamma) = ⟨special B, (show special.range ≤ specialFieldGamma from le_sup_left) ⟨B, rfl⟩⟩ :=
    specialFieldFiveLines_injective h
  apply action_faithful
  simpa only [natural_special] using congrArg (fun g : specialFieldGamma => natural g.val) hAB

/-- The image of the original determinant-one matrices is exactly A₅. -/
theorem specialFiveLines_range : specialFiveLines.range = alternatingGroup (Fin 5) := by
  apply Equiv.Perm.eq_alternatingGroup_of_index_eq_two
  have hc : Nat.card specialFiveLines.range = 60 :=
    (Nat.card_congr (MonoidHom.ofInjective specialFiveLines_injective).toEquiv).symm.trans sl_card
  have hi := specialFiveLines.range.card_mul_index
  rw [hc, Nat.card_eq_fintype_card, Fintype.card_perm] at hi
  norm_num [Nat.factorial] at hi
  omega

theorem specialFieldFiveLines_surjective : Function.Surjective specialFieldFiveLines := by
  have hle : alternatingGroup (Fin 5) ≤ specialFieldFiveLines.range := by
    rw [← specialFiveLines_range]
    rintro _ ⟨A, rfl⟩
    exact ⟨⟨special A, (show special.range ≤ specialFieldGamma from le_sup_left) ⟨A, rfl⟩⟩, rfl⟩
  have ht : Equiv.swap (3 : Fin 5) 4 ∈ specialFieldFiveLines.range :=
    ⟨⟨fieldElement, (show Subgroup.zpowers fieldElement ≤ specialFieldGamma from le_sup_right)
      (Subgroup.mem_zpowers fieldElement)⟩,
      fiveLines_fieldElement⟩
  have hodd : Equiv.swap (3 : Fin 5) 4 ∉ alternatingGroup (Fin 5) := by
    rw [Equiv.Perm.mem_alternatingGroup, Equiv.Perm.sign_swap (by decide)]
    decide
  intro p
  change p ∈ specialFieldFiveLines.range
  by_cases hp : p ∈ alternatingGroup (Fin 5)
  · exact hle hp
  · have hpt : p * Equiv.swap (3 : Fin 5) 4 ∈ alternatingGroup (Fin 5) :=
      (Subgroup.mul_mem_iff_of_index_two alternatingGroup.index_eq_two).mpr
        (iff_of_false hp hodd)
    simpa only [mul_assoc, Equiv.swap_mul_self, mul_one] using
      specialFieldFiveLines.range.mul_mem (hle hpt) ht

/-- The faithful five-line action identifies the matrix-side subgroup with S₅. -/
noncomputable def specialFieldGammaSymmetricFiveEquiv : specialFieldGamma ≃* Equiv.Perm (Fin 5) :=
  MulEquiv.ofBijective specialFieldFiveLines
    ⟨specialFieldFiveLines_injective, specialFieldFiveLines_surjective⟩

/-- The matrix-side identification retains the relative SL₂ subgroup. -/
theorem specialFieldGammaSymmetricFiveEquiv_special :
    (special.range.subgroupOf specialFieldGamma).map
      specialFieldGammaSymmetricFiveEquiv.toMonoidHom = alternatingGroup (Fin 5) := by
  change (special.range.subgroupOf specialFieldGamma).map
    (fiveLines.comp specialFieldGamma.subtype) = _
  rw [← Subgroup.map_map, Subgroup.map_subgroupOf_eq_of_le (show
    special.range ≤ specialFieldGamma from le_sup_left), MonoidHom.map_range]
  exact specialFiveLines_range

/-- The required S₅ identification of the literal subgroup of binary GL. -/
noncomputable def symmetricFiveEquiv : specialField ≃* Equiv.Perm (Fin 5) :=
  specialFieldEquiv.symm.trans specialFieldGammaSymmetricFiveEquiv

theorem symmetricFiveEquiv_special_apply (A : SL) :
    symmetricFiveEquiv ⟨action A,
      (show action.range ≤ specialField from le_sup_left) ⟨A, rfl⟩⟩ = specialFiveLines A := by
  have he : specialFieldEquiv ⟨special A, (show special.range ≤ specialFieldGamma from le_sup_left) ⟨A, rfl⟩⟩ =
      ⟨action A, (show action.range ≤ specialField from le_sup_left) ⟨A, rfl⟩⟩ := Subtype.ext (natural_special A)
  change specialFieldGammaSymmetricFiveEquiv (specialFieldEquiv.symm _) = _
  rw [← he, specialFieldEquiv.symm_apply_apply]
  rfl

/-- Under this identification the literal relative SL₂ subgroup is A₅. -/
theorem symmetricFiveEquiv_special :
    (action.range.subgroupOf specialField).map symmetricFiveEquiv.toMonoidHom =
      alternatingGroup (Fin 5) := by
  rw [← specialFiveLines_range]
  ext p
  constructor
  · rintro ⟨g, ⟨A, hA⟩, rfl⟩
    refine ⟨A, ?_⟩
    exact (symmetricFiveEquiv_special_apply A).symm.trans
      (congrArg symmetricFiveEquiv (Subtype.ext hA))
  · rintro ⟨A, rfl⟩
    exact ⟨⟨action A, (show action.range ≤ specialField from le_sup_left) ⟨A, rfl⟩⟩, ⟨A, rfl⟩,
      symmetricFiveEquiv_special_apply A⟩

/-- The specified coordinate Frobenius is the transposition of ω and 1+ω. -/
theorem symmetricFiveEquiv_frobenius :
    symmetricFiveEquiv ⟨frobeniusLinear,
      (show Subgroup.zpowers frobeniusLinear ≤ specialField from le_sup_right)
        (Subgroup.mem_zpowers frobeniusLinear)⟩ = Equiv.swap 3 4 := by
  have he : specialFieldEquiv
      ⟨fieldElement, (show Subgroup.zpowers fieldElement ≤ specialFieldGamma from le_sup_right)
        (Subgroup.mem_zpowers fieldElement)⟩ =
      ⟨frobeniusLinear, (show Subgroup.zpowers frobeniusLinear ≤ specialField from le_sup_right)
        (Subgroup.mem_zpowers frobeniusLinear)⟩ :=
    Subtype.ext natural_fieldElement
  change specialFieldGammaSymmetricFiveEquiv (specialFieldEquiv.symm _) = _
  rw [← he, specialFieldEquiv.symm_apply_apply]
  exact fiveLines_fieldElement

/-- The coordinates identify exactly the nonzero vectors on each F₄-line. -/
theorem lineIndex_eq_iff (v : V) (hv : v ≠ 0) (i : Fin 5) :
    lineIndex v = i ↔ ∃ c : F, c ≠ 0 ∧ v = c • lineVector i := by
  constructor
  · rintro rfl
    exact lineVector_covers v hv
  · rintro ⟨c, hc, rfl⟩
    rw [lineIndex_smul c hc, lineIndex_vector]

/-- The permutation is induced by the actual natural semilinear action on lines. -/
theorem fiveLines_equivariant (g : Gamma) (i : Fin 5) :
    ∃ c : F, c ≠ 0 ∧ natural g (lineVector i) = c • lineVector (fiveLines g i) :=
  lineVector_covers _ ((natural g).map_ne_zero_iff.mpr (lineVector_ne_zero i))

/-- The S₅ equivalence for the literal binary subgroup retains its natural action. -/
theorem symmetricFiveEquiv_equivariant (g : specialField) (i : Fin 5) :
    ∃ c : F, c ≠ 0 ∧ g.val (lineVector i) = c • lineVector (symmetricFiveEquiv g i) := by
  obtain ⟨g, rfl⟩ := specialFieldEquiv.surjective g
  have he : symmetricFiveEquiv (specialFieldEquiv g) = fiveLines g.val := by
    change specialFieldGammaSymmetricFiveEquiv
      (specialFieldEquiv.symm (specialFieldEquiv g)) = _
    rw [specialFieldEquiv.symm_apply_apply]
    rfl
  rw [he]
  exact fiveLines_equivariant g.val i

end Representation.SL2FourNatural.SemilinearNormalizer
