module

public import Theory.Representation.SL2FourNaturalOrbits.SemilinearNormalizer.Basic
public import Mathlib.GroupTheory.QuotientGroup.Basic

/-!
# The three determinant labels of ΓL₂(4)

The actual permutation a ↦ det(A) σ(a) defines a surjective homomorphism onto
S₃ with kernel precisely the SL₂ image. Wedge covariance connects this map to
binary-plane determinant labels. The subgroup generated by SL₂ and coordinate
Frobenius has orbits {1} and the other two units; the full group is transitive.
The only finite checks inspect permutations of the three field units.

Source: Aschbacher--Smith, combined manuscript (1 March 2004), proof of 6.2.5,
printed p.681 (PDF p.698). Plane enumeration and ambient-group fusion are
separate conclusions, not asserted here.
-/

@[expose] public section
noncomputable section
namespace Representation.SL2FourNatural.SemilinearNormalizer
open Matrix
open Matrix.GeneralLinearGroup
/-- The determinant label permutation: a ↦ det(A) σ(a). -/
def labels : Gamma →* Equiv.Perm Fˣ where
  toFun g := Equiv.mulLeft (det g.left) * (Units.mapEquiv g.right.toMulEquiv).toEquiv
  map_one' := by apply Equiv.ext; intro a; apply Units.ext; simp
  map_mul' g h := by
    apply Equiv.ext
    intro a
    apply Units.ext
    simp [SemidirectProduct.mul_left, coefficientAction, coefficientEquiv,
      GeneralLinearGroup.map_det, mul_assoc]

theorem labels_apply (g : Gamma) (a : Fˣ) :
    (labels g a : F) = g.left.val.det * g.right a := rfl

theorem wedge_natural (g : Gamma) (u v : V) :
    wedge (natural g u) (natural g v) = g.left.val.det * g.right (wedge u v) := by
  rw [natural_apply, natural_apply, wedge_mulVec]
  congr 1
  simp only [wedge, map_sub, map_mul]

@[simp] theorem labels_special (A : SL) : labels (special A) = 1 := by
  apply Equiv.ext
  intro a
  apply Units.ext
  change A.val.det * (a : F) = (a : F)
  rw [A.property, one_mul]

@[simp] theorem labels_fieldElement (a : Fˣ) :
    (labels fieldElement a : F) = (a : F) ^ 2 := by
  rw [labels_apply]
  change (1 : Matrix (Fin 2) (Fin 2) F).det * fieldFrobenius a = _
  rw [Matrix.det_one, one_mul, fieldFrobenius_apply]

/-- The SL₂ subgroup is precisely the linear determinant-one layer. -/
theorem mem_special_range (g : Gamma) :
    g ∈ special.range ↔ g.right = 1 ∧ det g.left = 1 := by
  constructor
  · rintro ⟨A, rfl⟩
    refine ⟨rfl, ?_⟩
    apply Units.ext
    exact A.property
  · rintro ⟨hr, hd⟩
    let A : SL := ⟨g.left.val, congrArg Units.val hd⟩
    refine ⟨A, ?_⟩
    apply SemidirectProduct.ext
    · apply Units.ext
      rfl
    · exact hr.symm

/-- No scalar or field automorphism is lost by passing to determinant labels. -/
theorem labels_ker : labels.ker = special.range := by
  ext g
  rw [MonoidHom.mem_ker, mem_special_range]
  constructor
  · intro h
    have hd : det g.left = 1 := by
      have he := Equiv.congr_fun h 1
      apply Units.ext
      simpa [labels_apply] using congrArg Units.val he
    refine ⟨?_, hd⟩
    apply RingEquiv.ext
    intro a
    by_cases ha : a = 0
    · simp [ha]
    · have he := congrArg Units.val (Equiv.congr_fun h (Units.mk0 a ha))
      simpa [labels_apply, show g.left.val.det = 1 from congrArg Units.val hd] using he
  · rintro ⟨hr, hd⟩
    apply Equiv.ext
    intro a
    apply Units.ext
    simp [labels_apply, hr, show g.left.val.det = 1 from congrArg Units.val hd]

/-- Each nonzero determinant occurs already in the linear group. -/
def determinantLift (d : Fˣ) : Gamma :=
  SemidirectProduct.inl (Matrix.GeneralLinearGroup.mkOfDetNeZero
    !![(d : F), 0; 0, 1] (by simp [Matrix.det_fin_two]))

theorem labels_determinantLift (d a : Fˣ) : labels (determinantLift d) a = d * a := by
  apply Units.ext
  change ( !![(d : F), 0; 0, 1] : Matrix (Fin 2) (Fin 2) F).det * (a : F) = _
  simp [Matrix.det_fin_two]

/-- The full semilinear group is transitive on the three nonzero labels. -/
theorem labels_transitive (a b : Fˣ) : ∃ g : Gamma, labels g a = b := by
  refine ⟨determinantLift (b * a⁻¹), ?_⟩
  rw [labels_determinantLift]
  simp

private theorem labelPermutation_cases (p : Equiv.Perm Fˣ) :
    (∀ a, p a = p 1 * a) ∨ (∀ a, p a = p 1 * a ^ 2) := by
  revert p
  decide +kernel

/-- The label action is the full permutation group, not just a transitive subgroup. -/
theorem labels_surjective : Function.Surjective labels := by
  intro p
  rcases labelPermutation_cases p with h | h
  · refine ⟨determinantLift (p 1), ?_⟩
    apply Equiv.ext
    intro a
    exact (labels_determinantLift (p 1) a).trans (h a).symm
  · refine ⟨determinantLift (p 1) * fieldElement, ?_⟩
    apply Equiv.ext
    intro a
    rw [map_mul, Equiv.Perm.mul_apply, labels_determinantLift]
    rw [h a]
    congr 1
    apply Units.ext
    exact labels_fieldElement a

/-- On labels the field involution has just the label one as a fixed point. -/
theorem labels_field_fixed (a : Fˣ) : labels fieldElement a = a ↔ a = 1 := by
  rw [Units.ext_iff, labels_fieldElement]
  have h := fieldFrobenius_fixed (a : F)
  change (a : F) ^ 2 = (a : F) ↔ (a : F) = 0 ∨ (a : F) = 1 at h
  rw [h, or_iff_right a.ne_zero, Units.val_eq_one]

theorem labels_field_transitive_nonidentity (a b : Fˣ) (ha : a ≠ 1) (hb : b ≠ 1) :
    b = a ∨ b = labels fieldElement a := by
  have h : ∀ a b : Fˣ, a ≠ 1 → b ≠ 1 → b = a ∨ b = a ^ 2 := by decide +kernel
  have he : labels fieldElement a = a ^ 2 := Units.ext (labels_fieldElement a)
  rw [he]
  exact h a b ha hb

/-- The matrix-side copy of the group generated by SL₂ and coordinate Frobenius. -/
def specialFieldGamma : Subgroup Gamma := special.range ⊔ Subgroup.zpowers fieldElement

theorem specialFieldGamma_map_natural : specialFieldGamma.map natural = specialField := by
  rw [specialFieldGamma, specialField, Subgroup.map_sup, MonoidHom.map_zpowers,
    natural_fieldElement, MonoidHom.map_range]
  congr 1

theorem specialFieldGamma_map_labels :
    specialFieldGamma.map labels = Subgroup.zpowers (labels fieldElement) := by
  have h : special.range.map labels = ⊥ := by
    apply le_antisymm
    · rintro _ ⟨_, ⟨A, rfl⟩, rfl⟩
      simp only [labels_special, Subgroup.one_mem]
    · exact bot_le
  rw [specialFieldGamma, Subgroup.map_sup, MonoidHom.map_zpowers, h, bot_sup_eq]

/-- The specified SL₂–Frobenius subgroup fixes the determinant label one. -/
theorem specialFieldGamma_fixes_one (g : specialFieldGamma) : labels g.val 1 = 1 := by
  have hle : Subgroup.zpowers (labels fieldElement) ≤
      MulAction.stabilizer (Equiv.Perm Fˣ) (1 : Fˣ) := by
    apply Subgroup.zpowers_le.mpr
    change labels fieldElement 1 = 1
    exact (labels_field_fixed 1).mpr rfl
  have hg : labels g.val ∈ specialFieldGamma.map labels := ⟨g.val, g.property, rfl⟩
  rw [specialFieldGamma_map_labels] at hg
  exact hle hg

/-- Exactly two orbits occur for SL₂ with the specified field involution:
the label one, and the other two labels. -/
theorem specialFieldGamma_label_orbit (a b : Fˣ) :
    (∃ g : specialFieldGamma, labels g.val a = b) ↔ (a = 1 ↔ b = 1) := by
  constructor
  · rintro ⟨g, h⟩
    constructor
    · intro ha
      rw [← h, ha]
      exact specialFieldGamma_fixes_one g
    · intro hb
      apply (labels g.val).injective
      rw [h, hb, specialFieldGamma_fixes_one g]
  · intro h
    by_cases ha : a = 1
    · refine ⟨1, ?_⟩
      simpa using ha.trans (h.mp ha).symm
    · have hb : b ≠ 1 := fun hb => ha (h.mpr hb)
      rcases labels_field_transitive_nonidentity a b ha hb with h | h
      · refine ⟨1, ?_⟩
        simpa using h.symm
      · refine ⟨⟨fieldElement, (show Subgroup.zpowers fieldElement ≤ specialFieldGamma from le_sup_right)
          (Subgroup.mem_zpowers fieldElement)⟩, h.symm⟩

theorem card_labels : Fintype.card Fˣ = 3 := by
  rw [Fintype.card_units, card_field]

theorem specialFieldGamma_orbit_card (a : Fˣ) :
    Nat.card {b : Fˣ // ∃ g : specialFieldGamma, labels g.val a = b} =
      if a = 1 then 1 else 2 := by
  have e : {b : Fˣ // ∃ g : specialFieldGamma, labels g.val a = b} ≃
      {b : Fˣ // a = 1 ↔ b = 1} :=
    Equiv.subtypeEquivRight (specialFieldGamma_label_orbit a)
  rw [Nat.card_congr e, Nat.card_eq_fintype_card]
  clear e
  revert a
  decide +kernel

instance special_range_normal : special.range.Normal := labels_ker ▸ inferInstance

/-- The quotient by the literal SL₂ image is the full symmetric group on its
three determinant labels. -/
def labelQuotientEquiv : Gamma ⧸ special.range ≃* Equiv.Perm Fˣ :=
  (QuotientGroup.quotientMulEquivOfEq labels_ker.symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective labels labels_surjective)

/-- Relabeling the three units gives an actual S₃ equivalence. -/
def symmetricThreeEquiv : Gamma ⧸ special.range ≃* Equiv.Perm (Fin 3) :=
  labelQuotientEquiv.trans (Equiv.permCongrHom (Fintype.equivFinOfCardEq card_labels))

end Representation.SL2FourNatural.SemilinearNormalizer
