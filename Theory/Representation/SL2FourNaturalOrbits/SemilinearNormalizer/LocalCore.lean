module
public import Theory.Representation.SL2FourNaturalOrbits.SemilinearNormalizer.SylowNormalizerRank
public import Theory.Representation.SL2FourNaturalOrbits.SemilinearNormalizer.ImageRecognition
public import Theory.GroupTheory.SymmetricThreeTwoCore
public import Theory.GroupTheory.SylowNormalIntersection
public import Theory.GroupTheory.PCoreLocalSetup
public import Theory.GroupTheory.NormalizedSupCard

/-!
# The marked local two-core in ΓL₂(4)

Let S be a specified full Sylow two-subgroup and let J be S-normalized,
commutator-generated by S, and escaping the special linear layer. When
neither five nor nine divides |J|, the join J ∨ S has order 24. Its
surjective determinant-label action has a kernel of order four, equal
to its actual two-core. Normality then identifies this core with
S ∩ SL₂(4), preserving an actual Sylow subgroup of SL₂(4).

The last theorem applies the established scalar-times-Sylow-normalizer
rank witness to this literal core. This supplies the finite-model kernel
marking and normalizer bound in the noncontained branch of
Aschbacher--Smith 13.7.19, printed p.945. Transport from an actual
source quotient to ΓL₂(4) remains explicit in the source consumer.
-/

@[expose] public section
noncomputable section
open Subgroup
namespace Representation.SL2FourNatural.SemilinearNormalizer
local instance : Finite Gamma := Nat.finite_of_card_ne_zero (by rw [gamma_card]; decide)

theorem sylow_gamma_card (S : Sylow 2 Gamma) : Nat.card S = 8 := by
  rw [S.card_eq_multiplicity, gamma_card]
  rw [show 360 = 2 ^ 3 * 45 by decide,
    Nat.factorization_mul (by decide) (by decide), Finsupp.add_apply,
    Nat.prime_two.factorization_pow, Finsupp.single_eq_same,
    Nat.factorization_eq_zero_of_not_dvd (by decide : ¬ 2 ∣ 45)]
  rfl

private theorem labels_card : Nat.card (Equiv.Perm Fˣ) = 6 := by
  rw [Nat.card_eq_fintype_card, Fintype.card_perm, card_labels]
  decide

theorem join_card_twenty_four (S : Sylow 2 Gamma) (J : Subgroup Gamma)
    (hn : (S : Subgroup Gamma) ≤ Subgroup.normalizer (J : Set Gamma))
    (hJS : J = ⁅J, (S : Subgroup Gamma)⁆) (hne : ¬ J ≤ special.range)
    (h5 : ¬ 5 ∣ Nat.card J) (h9 : ¬ 9 ∣ Nat.card J) :
    Nat.card (J ⊔ (S : Subgroup Gamma) : Subgroup Gamma) = 24 := by
  let P := J ⊔ (S : Subgroup Gamma)
  have hd : Nat.card P ∣ 360 := gamma_card ▸ P.card_subgroup_dvd_card
  have h8 : 8 ∣ Nat.card P := sylow_gamma_card S ▸ card_dvd_of_le (show (S : Subgroup Gamma) ≤ P from le_sup_right)
  have hlabel : P.map labels = ⊤ := labels_eq_top_of_commutator_noncontained P J (S : Subgroup Gamma)
    le_sup_left le_sup_right hJS hne
  have h3 : 3 ∣ Nat.card P := by
    have ht : Nat.card (P.map labels) ∣ Nat.card P := Subgroup.card_map_dvd P labels
    have hc : Nat.card (P.map labels) = 6 := by rw [hlabel, card_top, labels_card]
    rw [hc] at ht
    exact dvd_trans (by decide : 3 ∣ 6) ht
  have hm := card_mul_eq_card_inf_mul_card_sup_of_normalizes J (S : Subgroup Gamma) hn
  rw [sylow_gamma_card S] at hm
  have hdiv : Nat.card P ∣ Nat.card J * 8 := by
    rw [hm]
    exact dvd_mul_left _ _
  have h5P : ¬ 5 ∣ Nat.card P := by
    intro hh
    exact (Nat.prime_five.dvd_mul.mp (dvd_trans hh hdiv)).elim h5 (by decide)
  have h9P : ¬ 9 ∣ Nat.card P := by
    intro hh
    have ht : 9 ∣ Nat.card J * 8 := dvd_trans hh hdiv
    exact h9 ((by decide : Nat.Coprime 9 8).dvd_mul_right.mp ht)
  have hb : Nat.card P ≤ 360 := Nat.le_of_dvd (by decide) hd
  generalize Nat.card P = n at *
  interval_cases n <;> norm_num at *

/-- The actual local two-core is the special-linear part of the given full Sylow subgroup. -/
theorem join_twoCore_eq_sylow_special (S : Sylow 2 Gamma) (J : Subgroup Gamma)
    (hn : (S : Subgroup Gamma) ≤ Subgroup.normalizer (J : Set Gamma))
    (hJS : J = ⁅J, (S : Subgroup Gamma)⁆) (hne : ¬ J ≤ special.range)
    (h5 : ¬ 5 ∣ Nat.card J) (h9 : ¬ 9 ∣ Nat.card J) :
    (J ⊔ (S : Subgroup Gamma)).pCoreIn 2 = (S : Subgroup Gamma) ⊓ special.range := by
  let P := J ⊔ (S : Subgroup Gamma)
  have hP : Nat.card P = 24 := join_card_twenty_four S J hn hJS hne h5 h9
  have hlabel : P.map labels = ⊤ := labels_eq_top_of_commutator_noncontained P J (S : Subgroup Gamma)
    le_sup_left le_sup_right hJS hne
  let e := Equiv.permCongrHom (Fintype.equivFinOfCardEq card_labels)
  let f := e.toMonoidHom.comp (labels.comp P.subtype)
  have hf : Function.Surjective f := by
    have hsurj : Function.Surjective (labels.comp P.subtype) := by
      apply MonoidHom.range_eq_top.mp
      rwa [MonoidHom.range_comp, range_subtype]
    exact e.surjective.comp hsurj
  have hrange : Nat.card f.range = 6 := by
    rw [MonoidHom.range_eq_top.mpr hf, card_top]
    simp [Nat.card_eq_fintype_card, Fintype.card_perm, Nat.factorial]
  have hcount : Nat.card f.ker * Nat.card f.range = 24 := by
    rw [← index_ker f, f.ker.card_mul_index, hP]
  have hkcard : Nat.card f.ker = 4 := by rw [hrange] at hcount; omega
  have hk2 : IsPGroup 2 f.ker := IsPGroup.of_card (n := 2) (by simpa using hkcard)
  have hc := ker_eq_twoCore_of_surjective_perm_three f hf hk2
  have hkmap : f.ker.map P.subtype = P ⊓ special.range := by
    ext g
    constructor
    · rintro ⟨x, hx, rfl⟩
      refine ⟨x.property, ?_⟩
      rw [← labels_ker]
      change labels x.val = 1
      have he : e (labels x.val) = 1 := hx
      exact e.injective (by simpa only [map_one] using he)
    · rintro ⟨hgP, hgK⟩
      refine ⟨⟨g, hgP⟩, ?_, rfl⟩
      change e (labels g) = 1
      rw [← labels_ker] at hgK
      change labels g = 1 at hgK
      rw [hgK, map_one]
  have hcore : P.pCoreIn 2 = P ⊓ special.range := by
    change (pCore 2 P).map P.subtype = _
    rw [← hc, hkmap]
  have hCS : P.pCoreIn 2 ≤ (S : Subgroup Gamma) := by
    have he : ((S.subtype (show (S : Subgroup Gamma) ≤ P from le_sup_right)) : Subgroup P).map P.subtype =
        (S : Subgroup Gamma) := by
      rw [Sylow.coe_subtype, Subgroup.map_subgroupOf_eq_of_le le_sup_right]
    exact he ▸ P.pCoreIn_le_sylow (S.subtype le_sup_right)
  have hinter : (S : Subgroup Gamma) ⊓ special.range = P ⊓ special.range := by
    apply le_antisymm (inf_le_inf le_sup_right le_rfl)
    exact le_inf ((hcore ▸ hCS).trans le_rfl) inf_le_right
  change (pCore 2 P).map P.subtype = _
  rw [← hc, hkmap, hinter]

/-- The special-linear part of the specified Sylow subgroup retains its literal embedding. -/
theorem exists_sylow_special_marking (S : Sylow 2 Gamma) :
    ∃ Q : Sylow 2 SL,
      (Q : Subgroup SL).map special = (S : Subgroup Gamma) ⊓ special.range := by
  have hs : Function.Injective special := by
    intro a b hab
    apply Subtype.ext
    exact congrArg (fun g : Gamma => g.left.val) hab
  let e : SL ≃* special.range := MonoidHom.ofInjective hs
  obtain ⟨R, hR⟩ := S.exists_subgroupOf_eq_of_normal special.range
  refine ⟨R.mapSurjective (f := e.symm.toMonoidHom) e.symm.surjective, ?_⟩
  change ((R : Subgroup special.range).map e.symm.toMonoidHom).map special = _
  rw [map_map]
  have he : special.comp e.symm.toMonoidHom = special.range.subtype := by
    apply MonoidHom.ext
    intro x
    exact congrArg Subtype.val (e.apply_symm_apply x)
  rw [he, hR, subgroupOf_map_subtype]

/-- The local two-core is the image of an actual Sylow subgroup of SL₂(4). -/
theorem join_twoCore_sylow_marking (S : Sylow 2 Gamma) (J : Subgroup Gamma)
    (hn : (S : Subgroup Gamma) ≤ Subgroup.normalizer (J : Set Gamma))
    (hJS : J = ⁅J, (S : Subgroup Gamma)⁆) (hne : ¬ J ≤ special.range)
    (h5 : ¬ 5 ∣ Nat.card J) (h9 : ¬ 9 ∣ Nat.card J) :
    ∃ Q : Sylow 2 SL,
      (J ⊔ (S : Subgroup Gamma)).pCoreIn 2 = (Q : Subgroup SL).map special := by
  obtain ⟨Q, hQ⟩ := exists_sylow_special_marking S
  exact ⟨Q, (join_twoCore_eq_sylow_special S J hn hJS hne h5 h9).trans hQ.symm⟩

/-- The marked local core has a normalizer containing an elementary group of order nine. -/
theorem two_le_primeRank_join_twoCore_normalizer (S : Sylow 2 Gamma) (J : Subgroup Gamma)
    (hn : (S : Subgroup Gamma) ≤ Subgroup.normalizer (J : Set Gamma))
    (hJS : J = ⁅J, (S : Subgroup Gamma)⁆) (hne : ¬ J ≤ special.range)
    (h5 : ¬ 5 ∣ Nat.card J) (h9 : ¬ 9 ∣ Nat.card J) :
    2 ≤ primeRank 3 (Subgroup.normalizer
      (((J ⊔ (S : Subgroup Gamma)).pCoreIn 2 : Subgroup Gamma) : Set Gamma)) := by
  obtain ⟨Q, hQ⟩ := join_twoCore_sylow_marking S J hn hJS hne h5 h9
  rw [hQ]
  exact two_le_primeRank_sylow_normalizer Q

end Representation.SL2FourNatural.SemilinearNormalizer
