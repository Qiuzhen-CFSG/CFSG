/-!
# Elementary two-subgroups of S₇ and A₇

A Sylow two-subgroup has the explicit form D₈ × C₂. Its elementary
subgroups lie in one of two groups of order eight: three disjoint swaps,
or a regular four-group on four points times the remaining swap.
Sylow conjugacy gives exhaustive coverage and the bound on binary rank.
The sign kernels give the sharper alternating-group bound. Perfectness of
A₇ identifies it with the solvable residual of S₇.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, H.8,
printed p.389/PDF p.400, with standing hypotheses on printed p.377.
-/

@[expose] public section

open Equiv Subgroup
open scoped Pointwise
namespace Representation.AlternatingSevenConjugatePair.ElementaryGeometry
open BinaryOffender

instance (g : S7) : Decidable (g ∈ pairElementary) :=
  inferInstanceAs (Decidable (∃ v : Triple, firstWord v = g))
instance (g : S7) : Decidable (g ∈ fourTwoElementary) :=
  inferInstanceAs (Decidable (∃ v : Triple, secondWord v = g))
instance (g : S7) : Decidable (g ∈ sylowTwo) :=
  inferInstanceAs (Decidable (∃ v : Quadruple, word v = g))

/-- The group generated by three disjoint swaps lies in the chosen Sylow group. -/
theorem pairElementary_le_sylowTwo : pairElementary ≤ sylowTwo := by
  rintro _ ⟨v, rfl⟩
  exact ⟨(v.1, v.2.1, 0, v.2.2), rfl⟩

/-- The regular four-point group times (45) lies in the same Sylow group. -/
theorem fourTwoElementary_le_sylowTwo : fourTwoElementary ≤ sylowTwo := by
  rintro _ ⟨v, rfl⟩
  exact ⟨(v.1, v.1, v.2.1, v.2.2), rfl⟩

private theorem elementary_of_square (E : Subgroup S7)
    (h : ∀ x ∈ E, x ^ 2 = 1) : IsElementaryAbelian 2 E := by
  have hi (x : E) : x⁻¹ = x := by
    apply inv_eq_of_mul_eq_one_left
    apply Subtype.ext
    change (x : S7) * (x : S7) = 1
    simpa only [pow_two] using h x x.property
  exact {
    toIsMulCommutative := ⟨⟨fun x y => by
      calc x * y = (x * y)⁻¹ := (hi _).symm
           _ = y⁻¹ * x⁻¹ := mul_inv_rev _ _
           _ = y * x := by rw [hi, hi]⟩⟩
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr
      (fun x => Subtype.ext (h x x.property)) }

instance pairElementary_elementary : IsElementaryAbelian 2 pairElementary := by
  apply elementary_of_square
  rintro _ ⟨v, rfl⟩
  exact (by decide +kernel : ∀ v : Triple, firstWord v ^ 2 = 1) v

instance fourTwoElementary_elementary : IsElementaryAbelian 2 fourTwoElementary := by
  apply elementary_of_square
  rintro _ ⟨v, rfl⟩
  exact (by decide +kernel : ∀ v : Triple, secondWord v ^ 2 = 1) v

/-- The three-pair representative is a nontrivial elementary two-group. -/
theorem pairElementary_isElementaryTwo : IsElementaryTwo pairElementary := by
  refine ⟨?_, inferInstance⟩
  intro h
  have := pairElementary_card
  rw [h, Subgroup.card_bot] at this
  omega

/-- The four-plus-two representative is a nontrivial elementary two-group. -/
theorem fourTwoElementary_isElementaryTwo : IsElementaryTwo fourTwoElementary := by
  refine ⟨?_, inferInstance⟩
  intro h
  have := fourTwoElementary_card
  rw [h, Subgroup.card_bot] at this
  omega

/-- The three-pair representative has binary rank three. -/
theorem pairElementary_rank : rank pairElementary = 3 := by
  rw [rank, pairElementary_card]; decide

/-- The four-plus-two representative has binary rank three. -/
theorem fourTwoElementary_rank : rank fourTwoElementary = 3 := by
  rw [rank, fourTwoElementary_card]; decide

private theorem word_square (v : Quadruple) :
    word v ^ 2 = 1 ↔ v.2.2.1 = 0 ∨ v.1 = v.2.1 :=
  (by decide +kernel : ∀ v : Quadruple,
    word v ^ 2 = 1 ↔ v.2.2.1 = 0 ∨ v.1 = v.2.1) v

/-- A Sylow word belongs to the three-pair group precisely when it does not interchange the first two pairs. -/
theorem word_mem_pairElementary (v : Quadruple) :
    word v ∈ pairElementary ↔ v.2.2.1 = 0 := by
  constructor
  · rintro ⟨u, hu⟩
    have hv := word_inj hu
    exact congrArg (fun x : Quadruple => x.2.2.1) hv.symm
  · intro h
    refine ⟨(v.1, v.2.1, v.2.2.2), ?_⟩
    change word (v.1, v.2.1, 0, v.2.2.2) = word (v.1, v.2.1, v.2.2.1, v.2.2.2)
    rw [h]

/-- A Sylow word belongs to the four-plus-two group precisely when its first two swap coordinates agree. -/
theorem word_mem_fourTwoElementary (v : Quadruple) :
    word v ∈ fourTwoElementary ↔ v.1 = v.2.1 := by
  constructor
  · rintro ⟨u, hu⟩
    have hv := word_inj hu
    have h1 := congrArg (fun x : Quadruple => x.1) hv
    have h2 := congrArg (fun x : Quadruple => x.2.1) hv
    exact h1.symm.trans h2
  · intro h
    refine ⟨(v.1, v.2.2.1, v.2.2.2), ?_⟩
    change word (v.1, v.1, v.2.2.1, v.2.2.2) = word (v.1, v.2.1, v.2.2.1, v.2.2.2)
    rw [h]

private theorem compatible_words (v w : Quadruple)
    (hv : word v ^ 2 = 1) (hw : word w ^ 2 = 1)
    (hvw : (word v * word w) ^ 2 = 1) :
    (word v ∈ pairElementary ∧ word w ∈ pairElementary) ∨
    (word v ∈ fourTwoElementary ∧ word w ∈ fourTwoElementary) := by
  rw [← word_mul] at hvw
  rw [word_square] at hv hw hvw
  simp only [word_mem_pairElementary, word_mem_fourTwoElementary]
  exact (by decide : ∀ v w : Quadruple,
    (v.2.2.1 = 0 ∨ v.1 = v.2.1) → (w.2.2.1 = 0 ∨ w.1 = w.2.1) →
    ((mulBits v w).2.2.1 = 0 ∨ (mulBits v w).1 = (mulBits v w).2.1) →
    (v.2.2.1 = 0 ∧ w.2.2.1 = 0) ∨ (v.1 = v.2.1 ∧ w.1 = w.2.1)) v w hv hw hvw

/-- Inside the fixed Sylow group, every elementary subgroup lies in one of these two groups of order eight. -/
theorem elementary_le_representative {A : Subgroup S7}
    (hA : IsElementaryAbelian 2 A) (hAT : A ≤ sylowTwo) :
    A ≤ pairElementary ∨ A ≤ fourTwoElementary := by
  classical
  let _ := hA
  by_cases h : A ≤ pairElementary
  · exact Or.inl h
  · right
    obtain ⟨x, hxA, hx⟩ : ∃ x ∈ A, x ∉ pairElementary := by
      simpa only [SetLike.le_def, not_forall, exists_prop] using h
    obtain ⟨v, rfl⟩ := hAT hxA
    intro y hyA
    obtain ⟨w, rfl⟩ := hAT hyA
    exact ((compatible_words v w
      (elemPow_eq_one_of_isElementaryAbelian _ hxA)
      (elemPow_eq_one_of_isElementaryAbelian _ hyA)
      (elemPow_eq_one_of_isElementaryAbelian _ (A.mul_mem hxA hyA))).resolve_left
        (fun h => hx h.1)).2

/-- The actual Sylow two-subgroup supplied by the sixteen coordinate words. -/
noncomputable def standardSylow : Sylow 2 S7 :=
  (IsPGroup.of_card (show Nat.card sylowTwo = 2 ^ 4 by rw [sylowTwo_card]; decide)).toSylow (by
    have h := sylowTwo.card_mul_index
    have hc : Nat.card S7 = 5040 := by
      norm_num [Nat.card_eq_fintype_card, Fintype.card_perm, Nat.factorial]
    rw [sylowTwo_card, hc] at h
    have hi : sylowTwo.index = 315 := by omega
    rw [hi]; decide)

@[simp] theorem standardSylow_coe : (standardSylow : Subgroup S7) = sylowTwo := rfl

/-- Every elementary two-subgroup is conjugate into one of the two explicit
 maximal elementary subgroups. No order or rank premise is needed. -/
theorem elementary_conjugate_le {A : Subgroup S7} (hA : IsElementaryAbelian 2 A) :
    ∃ g : S7, A.map (MulAut.conj g).toMonoidHom ≤ pairElementary ∨
      A.map (MulAut.conj g).toMonoidHom ≤ fourTwoElementary := by
  let _ := hA
  obtain ⟨P, hAP⟩ := (IsElementaryAbelian.isPGroup 2 A).exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq S7 P standardSylow
  have he : (P : Subgroup S7).map (MulAut.conj g).toMonoidHom = sylowTwo := by
    exact congrArg Sylow.toSubgroup hg
  refine ⟨g, elementary_le_representative (IsElementaryAbelian.map _) ?_⟩
  exact he ▸ Subgroup.map_mono hAP

/-- Every elementary abelian two-subgroup of S₇ has order at most eight. -/
theorem elementary_card_le {A : Subgroup S7} (hA : IsElementaryAbelian 2 A) :
    Nat.card A ≤ 8 := by
  obtain ⟨g, hg | hg⟩ := elementary_conjugate_le hA
  · have h := Subgroup.card_le_of_le hg
    rwa [Subgroup.card_map_of_injective (MulAut.conj g).injective, pairElementary_card] at h
  · have h := Subgroup.card_le_of_le hg
    rwa [Subgroup.card_map_of_injective (MulAut.conj g).injective, fourTwoElementary_card] at h

/-- The exact elementary-rank bound used by the summand-interchange argument of H.8. -/
theorem rank_le_three (A : Subgroup S7) (hA : IsElementaryTwo A) : rank A ≤ 3 := by
  have h := elementary_card_le hA.2
  rw [hA.card_eq_two_pow_rank] at h
  exact (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp h

/-- Every elementary rank-three subgroup of S₇ is conjugate to one of the two named representatives. -/
theorem elementary_rank_three_conjugacy (A : Subgroup S7)
    (hA : IsElementaryTwo A) (hr : rank A = 3) :
    ∃ g : S7, A.map (MulAut.conj g).toMonoidHom = pairElementary ∨
      A.map (MulAut.conj g).toMonoidHom = fourTwoElementary := by
  have hc : Nat.card A = 8 := by rw [hA.card_eq_two_pow_rank, hr]; decide
  obtain ⟨g, hg | hg⟩ := elementary_conjugate_le hA.2
  · exact ⟨g, Or.inl (Subgroup.eq_of_le_of_card_ge hg (by
      rw [pairElementary_card, Subgroup.card_map_of_injective (MulAut.conj g).injective, hc]))⟩
  · exact ⟨g, Or.inr (Subgroup.eq_of_le_of_card_ge hg (by
      rw [fourTwoElementary_card, Subgroup.card_map_of_injective (MulAut.conj g).injective, hc]))⟩

/-- The two-rank of the actual symmetric group on seven letters is three. -/
theorem primeRank_symmetric : primeRank 2 S7 = 3 := by
  apply le_antisymm
  · exact (primeRank_le_iff_elementary_card_le S7).mpr (fun _ h => elementary_card_le h)
  · have h := (primeRank_le_iff_elementary_card_le (n := primeRank 2 S7) S7).mp le_rfl
      pairElementary pairElementary_elementary
    rw [pairElementary_card] at h
    exact (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp h

/-- The standing residual subgroup in H.8 is the literal alternating subgroup. -/
theorem solvableResidual_symmetric : solvableResidual S7 = alternatingGroup (Fin 7) := by
  let _ : Group.IsPerfect (alternatingGroup (Fin 7)) :=
    ⟨commutator_alternatingGroup_eq_top (by simp)⟩
  apply le_antisymm
  · have h := solvableResidual_le_derivedSeries (G := S7) 1
    rw [derivedSeries_one] at h
    exact h.trans_eq (alternatingGroup.commutator_perm_eq (by simp))
  · exact le_solvableResidual_of_isPerfect _


open BinaryOffender

theorem swap45_mem_pairElementary : swap45 ∈ pairElementary := by decide +kernel
theorem swap45_mem_fourTwoElementary : swap45 ∈ fourTwoElementary := by decide +kernel

private theorem even_part_card (E : Subgroup S7) (hE : Nat.card E = 8)
    (h45 : swap45 ∈ E) : Nat.card ↥(E ⊓ alternatingGroup (Fin 7)) = 4 := by
  let f : E →* ℤˣ := Perm.sign.comp E.subtype
  have hf : Function.Surjective f := by
    intro u
    rcases Int.units_eq_one_or u with rfl | rfl
    · exact ⟨1, map_one f⟩
    · exact ⟨⟨swap45, h45⟩, by change Perm.sign swap45 = -1; decide +kernel⟩
  have hi : f.ker.index = 2 := by
    rw [Subgroup.index_ker, MonoidHom.range_eq_top.mpr hf,
      Nat.card_congr (Subgroup.topEquiv (G := ℤˣ)).toEquiv, Nat.card_eq_fintype_card]
    decide
  have hc := f.ker.card_mul_index
  rw [hi, hE] at hc
  let e : ↥(E ⊓ alternatingGroup (Fin 7)) ≃ f.ker := {
    toFun x := ⟨⟨x.val, x.property.1⟩, x.property.2⟩
    invFun x := ⟨x.val.val, x.val.property, x.property⟩
    left_inv _ := rfl
    right_inv _ := rfl }
  rw [Nat.card_congr e]
  omega

/-- The even part of the three-pair group has order four. -/
theorem pairElementary_even_card :
    Nat.card ↥(pairElementary ⊓ alternatingGroup (Fin 7)) = 4 :=
  even_part_card _ pairElementary_card swap45_mem_pairElementary

/-- The even part of the four-plus-two group has order four. -/
theorem fourTwoElementary_even_card :
    Nat.card ↥(fourTwoElementary ⊓ alternatingGroup (Fin 7)) = 4 :=
  even_part_card _ fourTwoElementary_card swap45_mem_fourTwoElementary

/-- An elementary two-subgroup contained in A₇ has order at most four. -/
theorem elementary_even_card_le {A : Subgroup S7}
    (hA : IsElementaryAbelian 2 A) (hAL : A ≤ alternatingGroup (Fin 7)) :
    Nat.card A ≤ 4 := by
  obtain ⟨g, hg⟩ := elementary_conjugate_le hA
  have hL : A.map (MulAut.conj g).toMonoidHom ≤ alternatingGroup (Fin 7) := by
    rintro _ ⟨a, ha, rfl⟩
    exact (inferInstance : (alternatingGroup (Fin 7)).Normal).conj_mem a (hAL ha) g
  rcases hg with hg | hg
  · have h := Subgroup.card_le_of_le (le_inf hg hL)
    rwa [Subgroup.card_map_of_injective (MulAut.conj g).injective, pairElementary_even_card] at h
  · have h := Subgroup.card_le_of_le (le_inf hg hL)
    rwa [Subgroup.card_map_of_injective (MulAut.conj g).injective, fourTwoElementary_even_card] at h

/-- The exact inner elementary-rank bound used in H.8. -/
theorem rank_le_two_of_le_alternating (A : Subgroup S7) (hA : IsElementaryTwo A)
    (hAL : A ≤ alternatingGroup (Fin 7)) : rank A ≤ 2 := by
  have h := elementary_even_card_le hA.2 hAL
  rw [hA.card_eq_two_pow_rank] at h
  exact (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp h

/-- The two-rank of the actual alternating group on seven letters is two. -/
theorem primeRank_alternating : primeRank 2 (alternatingGroup (Fin 7)) = 2 := by
  apply le_antisymm
  · apply (primeRank_le_iff_elementary_card_le _).mpr
    intro A hA
    let _ := hA
    have h := elementary_even_card_le (IsElementaryAbelian.map (alternatingGroup (Fin 7)).subtype
      (A := A)) (show A.map (alternatingGroup (Fin 7)).subtype ≤ alternatingGroup (Fin 7) from
        Subgroup.map_subtype_le _)
    rwa [Subgroup.card_map_of_injective Subtype.val_injective] at h
  · let E := pairElementary ⊓ alternatingGroup (Fin 7)
    have hE : IsElementaryAbelian 2 E := by
      refine (pairElementary_isElementaryTwo.of_le inf_le_left ?_).2
      intro h
      have hc := pairElementary_even_card
      rw [h, Subgroup.card_bot] at hc
      omega
    let _ := hE
    have h := (primeRank_le_iff_elementary_card_le
      (n := primeRank 2 (alternatingGroup (Fin 7))) (alternatingGroup (Fin 7))).mp le_rfl
        (E.subgroupOf (alternatingGroup (Fin 7)))
        (IsElementaryAbelian.subgroupOf (show E ≤ alternatingGroup (Fin 7) from inf_le_right))
    rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe (show E ≤ alternatingGroup (Fin 7) from
      inf_le_right)).toEquiv, pairElementary_even_card] at h
    exact (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp h



/-- The three disjoint transpositions are actual members of the first representative. -/
theorem pairElementary_generators : swap01 ∈ pairElementary ∧ swap23 ∈ pairElementary ∧
    swap45 ∈ pairElementary := by decide +kernel

/-- The two double transpositions and (45) are actual members of the second representative. -/
theorem fourTwoElementary_generators : swap01 * swap23 ∈ fourTwoElementary ∧
    crossSwap ∈ fourTwoElementary ∧ swap45 ∈ fourTwoElementary := by decide +kernel

/-- The first representative is exactly the subgroup generated by (01),(23),(45). -/
theorem pairElementary_eq_closure :
    pairElementary = Subgroup.closure ({swap01, swap23, swap45} : Set S7) := by
  apply le_antisymm
  · rintro _ ⟨v, rfl⟩
    let H := Subgroup.closure ({swap01, swap23, swap45} : Set S7)
    have ha : swap01 ∈ H := Subgroup.subset_closure (by simp)
    have hb : swap23 ∈ H := Subgroup.subset_closure (by simp)
    have hd : swap45 ∈ H := Subgroup.subset_closure (by simp)
    change swap01 ^ v.1.val * swap23 ^ v.2.1.val * crossSwap ^ 0 * swap45 ^ v.2.2.val ∈ H
    simp only [pow_zero, mul_one]
    exact H.mul_mem (H.mul_mem (H.pow_mem ha _) (H.pow_mem hb _)) (H.pow_mem hd _)
  · apply (Subgroup.closure_le _).mpr
    intro g hg
    rcases hg with rfl | rfl | rfl
    · exact pairElementary_generators.1
    · exact pairElementary_generators.2.1
    · exact pairElementary_generators.2.2

/-- The second representative is exactly the subgroup generated by (01)(23),(02)(13),(45). -/
theorem fourTwoElementary_eq_closure :
    fourTwoElementary = Subgroup.closure ({swap01 * swap23, crossSwap, swap45} : Set S7) := by
  apply le_antisymm
  · rintro _ ⟨v, rfl⟩
    let H := Subgroup.closure ({swap01 * swap23, crossSwap, swap45} : Set S7)
    have ha : swap01 * swap23 ∈ H := Subgroup.subset_closure (by simp)
    have hc : crossSwap ∈ H := Subgroup.subset_closure (by simp)
    have hd : swap45 ∈ H := Subgroup.subset_closure (by simp)
    have he : secondWord v = (swap01 * swap23) ^ v.1.val *
        crossSwap ^ v.2.1.val * swap45 ^ v.2.2.val :=
      (by decide +kernel : ∀ v : Triple, secondWord v = (swap01 * swap23) ^ v.1.val *
        crossSwap ^ v.2.1.val * swap45 ^ v.2.2.val) v
    rw [he]
    exact H.mul_mem (H.mul_mem (H.pow_mem ha _) (H.pow_mem hc _)) (H.pow_mem hd _)
  · apply (Subgroup.closure_le _).mpr
    intro g hg
    rcases hg with rfl | rfl | rfl
    · exact fourTwoElementary_generators.1
    · exact fourTwoElementary_generators.2.1
    · exact fourTwoElementary_generators.2.2

private theorem mem_pair_orbit (x y : Fin 7) :
    y ∈ MulAction.orbit pairElementary x ↔ ∃ v : Triple, firstWord v x = y := by
  constructor
  · rintro ⟨g, rfl⟩
    obtain ⟨v, hv⟩ := g.property
    exact ⟨v, congrArg (fun f : S7 => f x) hv⟩
  · rintro ⟨v, rfl⟩
    exact ⟨⟨firstWord v, ⟨v, rfl⟩⟩, rfl⟩

private theorem mem_fourTwo_orbit (x y : Fin 7) :
    y ∈ MulAction.orbit fourTwoElementary x ↔ ∃ v : Triple, secondWord v x = y := by
  constructor
  · rintro ⟨g, rfl⟩
    obtain ⟨v, hv⟩ := g.property
    exact ⟨v, congrArg (fun f : S7 => f x) hv⟩
  · rintro ⟨v, rfl⟩
    exact ⟨⟨secondWord v, ⟨v, rfl⟩⟩, rfl⟩

/-- Labels for the four-point orbit, the two-point orbit, and the singleton. -/
def fourTwoOrbitLabel (x : Fin 7) : Fin 3 :=
  if x.val < 4 then 0 else if x.val < 6 then 1 else 2

/-- The orbits of the first representative are exactly the fibers of the pair label. -/
theorem pairElementary_orbit (x : Fin 7) :
    MulAction.orbit pairElementary x = {y | y.val / 2 = x.val / 2} := by
  ext y
  rw [mem_pair_orbit]
  exact (by decide +kernel : ∀ x y : Fin 7,
    (∃ v : Triple, firstWord v x = y) ↔ y.val / 2 = x.val / 2) x y

/-- The orbits of the second representative are exactly the four-point, two-point and singleton label fibers. -/
theorem fourTwoElementary_orbit (x : Fin 7) :
    MulAction.orbit fourTwoElementary x = {y | fourTwoOrbitLabel y = fourTwoOrbitLabel x} := by
  ext y
  rw [mem_fourTwo_orbit]
  exact (by decide +kernel : ∀ x y : Fin 7,
    (∃ v : Triple, secondWord v x = y) ↔ fourTwoOrbitLabel y = fourTwoOrbitLabel x) x y

/-- The explicit orbit type 2+2+2+1. -/
theorem pairElementary_orbits :
    MulAction.orbit pairElementary (0 : Fin 7) = {0, 1} ∧
    MulAction.orbit pairElementary (2 : Fin 7) = {2, 3} ∧
    MulAction.orbit pairElementary (4 : Fin 7) = {4, 5} ∧
    MulAction.orbit pairElementary (6 : Fin 7) = {6} := by
  simp only [pairElementary_orbit]
  refine ⟨?_, ?_, ?_, ?_⟩ <;> ext i <;> fin_cases i <;> decide

/-- The explicit orbit type 4+2+1. -/
theorem fourTwoElementary_orbits :
    MulAction.orbit fourTwoElementary (0 : Fin 7) = {0, 1, 2, 3} ∧
    MulAction.orbit fourTwoElementary (4 : Fin 7) = {4, 5} ∧
    MulAction.orbit fourTwoElementary (6 : Fin 7) = {6} := by
  simp only [fourTwoElementary_orbit]
  refine ⟨?_, ?_, ?_⟩ <;> ext i <;> fin_cases i <;> decide

private theorem fourTwo_unique_swap {g : S7} (hg : g ∈ fourTwoElementary)
    (hs : g.IsSwap) : g = swap45 := by
  obtain ⟨v, rfl⟩ := hg
  have hc := Perm.card_support_eq_two.mpr hs
  exact (by decide +kernel : ∀ v : Triple,
    (secondWord v).support.card = 2 → secondWord v = swap45) v hc

private theorem conj_swap_isSwap (g : S7) (i j : Fin 7) (h : i ≠ j) :
    ((MulAut.conj g) (swap i j)).IsSwap := by
  refine ⟨g i, g j, fun he => h (g.injective he), ?_⟩
  change g * swap i j * g⁻¹ = swap (g i) (g j)
  simpa only [Perm.mul_def, Perm.inv_def, trans_assoc] using symm_trans_swap_trans i j g

/-- The two representatives are not conjugate as subgroups of S₇: the second has only one transposition. -/
theorem representatives_not_conjugate (g : S7) :
    pairElementary.map (MulAut.conj g).toMonoidHom ≠ fourTwoElementary := by
  intro he
  have hm {x : S7} (hx : x ∈ pairElementary) : (MulAut.conj g) x ∈ fourTwoElementary := by
    rw [← he]
    exact Subgroup.mem_map_of_mem _ hx
  have h1 := fourTwo_unique_swap (hm pairElementary_generators.1)
    (conj_swap_isSwap g 0 1 (by decide))
  have h2 := fourTwo_unique_swap (hm pairElementary_generators.2.1)
    (conj_swap_isSwap g 2 3 (by decide))
  have hx := (MulAut.conj g).injective (h1.trans h2.symm)
  exact (by decide +kernel : swap01 ≠ swap23) hx


end Representation.AlternatingSevenConjugatePair.ElementaryGeometry
