module

public import Theory.Representation.QuadraticFourGroup.CubicSections.SplitAction.Geometry
public import Theory.Representation.QuadraticFourGroup.CubicSections.Swapped
public import Theory.Representation.QuadraticFourGroup.Recognition.OddTranspositions.Linear

/-!
# Cubic fixed vectors in a split component orbit

The actual diagonal centralizer is generated by its commutators with the
four-group. Consequently it fixes all displacements by the swapping
involution. For a cubic element and a square-one inverter in the first
factor, this gives the quadratic identity for the involution and its
conjugate required by the swapped-dihedral calculation.

The fixed space of the cubic element is invariant under the other factor.
Its pointwise fixer in that simple factor is normal and contains a
nonidentity cubic element, hence is the whole factor. Conjugating by the
swapping involution gives the reverse containment. Thus a vector fixed by
any cubic element in either factor is fixed by the complete product.

Source: GLS, volume 2, Theorem 25.14, Steps 3–4,
`refs/KGroup/GLS2/ChapterG.tex`, lines 850–899. The precise local group fact
`HasCubicInverters` remains explicit. No irreducibility, tensor classification,
or finite-dimensionality is needed for this fixed-space containment.
-/

@[expose] public section

open Subgroup Theory.GroupTheory
namespace Representation.QuadraticFourGroup

private theorem simple_fixed_propagation {G H W : Type*} [Group G] [Group H]
    [IsSimpleGroup H] [AddCommGroup W] [Module (ZMod 2) W]
    (ρ : Representation (ZMod 2) G W) (f : H →* G) (z : G)
    (hc : ∀ h, Commute z (f h)) {x : H} (hx : x ≠ 1)
    (hfix : ∀ w, ρ z w = w → ρ (f x) w = w) :
    ∀ w, ρ z w = w → ∀ h, ρ (f h) w = w := by
  let N : Subgroup H := {
    carrier := {h | ∀ w, ρ z w = w → ρ (f h) w = w}
    one_mem' := by intro w _; rw [map_one, map_one]; rfl
    mul_mem' := by
      intro a b ha hb w hw
      rw [map_mul, map_mul, Module.End.mul_apply, hb w hw, ha w hw]
    inv_mem' := by
      intro a ha w hw
      rw [map_inv]
      exact ρ.inv_apply_eq_iff.mpr (ha w hw).symm
  }
  have hn : N.Normal := ⟨by
    intro a ha b w hw
    have hw' : ρ z (ρ (f b⁻¹) w) = ρ (f b⁻¹) w := by
      rw [← Module.End.mul_apply, ← map_mul, (hc b⁻¹).eq, map_mul,
        Module.End.mul_apply, hw]
    change ρ (f (b * a * b⁻¹)) w = w
    simp only [map_mul, Module.End.mul_apply]
    rw [ha _ hw', ← Module.End.mul_apply, ← map_mul, ← map_mul,
      mul_inv_cancel, map_one, map_one]
    rfl⟩
  have htop : N = ⊤ := hn.eq_bot_or_eq_top.resolve_left (by
    intro hbot
    have hmem : x ∈ N := hfix
    rw [hbot, mem_bot] at hmem
    exact hx hmem)
  intro w hw h
  exact (show h ∈ N from htop ▸ mem_top h) w hw

namespace SplitOrbit
variable {Q V : Type*} [Group Q] [Finite Q] [AddCommGroup V] [Module (ZMod 2) V]
  {τ : Representation (ZMod 2) Q V} {n : ℕ} (d : SplitOrbit τ n)

/-- Step 3: the actual diagonal fixes the displacements by the marked involution. -/
lemma diagonal_fixes_displacements : FixesDisplacements τ d.involution d.diagonalHom.range := by
  apply d.hypotheses.quadratic.of_commutator_eq
  · rw [d.diagonalHom_range]
    exact inf_le_right
  · exact d.diagonal_commutator

/-- An inverting involution in the first factor supplies the second quadratic actor. -/
lemma conjugate_fixes_displacements {b : Factor n} (hb : b * b = 1) :
    ∀ v, τ (d.first b * d.involution * (d.first b)⁻¹)
      (τ d.involution v - v) = τ d.involution v - v := by
  have hb' : (d.first b)⁻¹ = d.first b := by
    apply inv_eq_of_mul_eq_one_right
    rw [← map_mul, hb, map_one]
  have hc : d.first b * d.involution * (d.first b)⁻¹ =
      d.diagonalHom b * d.involution := by
    rw [hb']
    change d.first b * d.involution * d.first b =
      (d.first b * (d.involution * d.first b * d.involution⁻¹)) * d.involution
    group
  intro v
  rw [hc, map_mul, Module.End.mul_apply,
    d.hypotheses.quadratic d.involution d.hypotheses.mem v]
  exact d.diagonal_fixes_displacements _ ⟨b,rfl⟩ v

/-- The dihedral calculation transfers cubic fixed vectors to the swapped factor. -/
lemma cubic_fixed_swapped (hInv : HasCubicInverters (Factor n))
    {x : Factor n} (hx : orderOf x = 3) :
    ∀ v, τ (d.first x) v = v → τ (d.swapped x) v = v := by
  obtain ⟨b,hb,hbx⟩ := hInv x hx
  apply swapped_cubic_fixed_imp τ d.involution_mul
    (b := d.first b)
  · rw [← map_mul, hb, map_one]
  · rw [← map_pow, ← hx, pow_orderOf_eq_one, map_one]
  · simpa only [map_mul, map_inv] using congrArg d.first hbx
  · exact d.first_swapped_commute x x
  · exact d.first_swapped_commute b x
  · exact d.conjugate_fixes_displacements hb

/-- Conjugation by the marked involution reverses the fixed-space containment. -/
lemma cubic_fixed_first (hInv : HasCubicInverters (Factor n))
    {x : Factor n} (hx : orderOf x = 3) :
    ∀ v, τ (d.swapped x) v = v → τ (d.first x) v = v := by
  intro v hv
  have hf : τ (d.first x) (τ d.involution v) = τ d.involution v := by
    have he : d.first x * d.involution = d.involution * d.swapped x :=
      (mul_inv_eq_iff_eq_mul.mp (d.swap_twice x)).symm
    rw [← Module.End.mul_apply, ← map_mul, he, map_mul, Module.End.mul_apply, hv]
  have hs := d.cubic_fixed_swapped hInv hx _ hf
  have he : d.swapped x * d.involution = d.involution * d.first x := by
    change (d.involution * d.first x * d.involution⁻¹) * d.involution = _
    group
  rw [← Module.End.mul_apply, ← map_mul, he, map_mul, Module.End.mul_apply] at hs
  exact (τ.apply_bijective d.involution).injective hs

/-- A vector fixed by an order-three element of the first coordinate factor
is fixed by the entire embedded product. -/
lemma cubic_fixed_all_of_first (hInv : HasCubicInverters (Factor n))
    {x : Factor n} (hx : orderOf x = 3) (v : V) (hv : τ (d.embedding (x, 1)) v = v) :
    ∀ g : Factor n × Factor n, τ (d.embedding g) v = v := by
  let := d.factor_simple
  have hxne : x ≠ 1 := by intro he; simp [he] at hx
  have hS := simple_fixed_propagation τ d.swapped (d.first x)
    (d.first_swapped_commute x) hxne (d.cubic_fixed_swapped hInv hx)
  have hF := simple_fixed_propagation τ d.first (d.swapped x)
    (fun y => (d.first_swapped_commute y x).symm) hxne (d.cubic_fixed_first hInv hx)
  intro g
  obtain ⟨y,z,hg⟩ := d.exists_coordinates (show d.embedding g ∈ d.embedding.range from ⟨g,rfl⟩)
  rw [← hg, map_mul, Module.End.mul_apply, hS v hv z,
    hF v (d.cubic_fixed_swapped hInv hx v hv) y]

/-- A vector fixed by an order-three element of the second coordinate factor
is fixed by the entire embedded product. -/
lemma cubic_fixed_all_of_second (hInv : HasCubicInverters (Factor n))
    {x : Factor n} (hx : orderOf x = 3) (v : V) (hv : τ (d.embedding (1, x)) v = v) :
    ∀ g : Factor n × Factor n, τ (d.embedding g) v = v := by
  obtain ⟨y,hy⟩ := show d.second x ∈ d.swapped.range from d.swapped_range.symm ▸ ⟨x,rfl⟩
  have hyorder : orderOf y = 3 := by
    rw [← orderOf_injective d.swapped d.swapped_injective, hy,
      orderOf_injective d.second d.second_injective, hx]
  apply d.cubic_fixed_all_of_first hInv hyorder v
  apply d.cubic_fixed_first hInv hyorder v
  rwa [hy]

end SplitOrbit
end Representation.QuadraticFourGroup

end
