module

public import Theory.Representation.QuadraticFourGroup.Recognition.OddTranspositions.NormCentralizer
public import Theory.Representation.QuadraticFourGroup.Recognition.OddTranspositions.NormLattice

/-!
# The intrinsic diagonal and its generation theorem

For E = ⟨Lᴮ⟩, K = E(C_E(a)) and Y = KB, the intrinsic layer K is the
subgroup generated by the component norms l ↦ l (a l a⁻¹). On the literal
quotient E/Z(E), it is the product of the diagonals on the one or two
component pairs. This identifies K with the explicit norm subgroup whose
invariant maximality, normalizer bound and commutator identity are proved
in `NormLattice`.

Transporting these results discharges every structural premise of the
conditional generation and odd-transposition arguments. Generation outside
Z(E)Y needs only G = ⟨L,B⟩. The even-order version additionally uses O₂(G) = 1
to make Z(E) odd, and the odd-transposition conclusion uses irreducibility.

Source: GLS2, Chapter B, Lemma 3.25 and the diagonal construction in the
proof of Lemma 3.27; Chapter G, Theorem 25.14, Steps 2--3. Here K is the
centralizer's layer, as in those proofs. No odd-core hypothesis or stronger
centre conclusion from Lemma 3.27 is used.
-/

public section

open Subgroup Theory.GroupTheory

namespace Representation.QuadraticFourGroup

variable {G V : Type*} [Group G] [Finite G]
  [AddCommGroup V] [Module (ZMod 2) V]
  {ρ : Representation (ZMod 2) G V} {L B : Subgroup G} {a : G}

/-- The intrinsic layer is a product of pair diagonals under actual
coordinates on E/Z(E), with the transported source action transitive on pairs. -/
theorem Hypotheses.diagonalLayer_pair_coordinates (h : Hypotheses ρ L B a) :
    ∃ n : ℕ, 0 < n ∧ n ≤ 2 ∧
      ∃ e : componentOrbit L B ⧸ center (componentOrbit L B) ≃*
          (Fin n → (L ⧸ center L) × (L ⧸ center L)),
        ((diagonalLayer L B a).subgroupOf (componentOrbit L B)).map
            (e.toMonoidHom.comp (QuotientGroup.mk' (center (componentOrbit L B)))) =
          PairedProduct.diagonal (Fin n) (L ⧸ center L) ∧
        PairedProduct.IsPairTransitive (Fin n) (L ⧸ center L)
          (h.orbitCoordinateAction e) := by
  obtain ⟨d⟩ := h.normPairCoordinates_nonempty
  refine ⟨d.pairCount, d.pairCount_pos, d.pairCount_le_two, d.equiv, ?_, d.pair_transitive⟩
  rw [h.diagonalLayer_eq_normDiagonal]
  exact d.norm_image

/-- Source maximality is among B-invariant subgroups of E. -/
theorem Hypotheses.diagonalLayer_sup_center_maximalInvariant
    (h : Hypotheses ρ L B a) (hgen : L ⊔ B = ⊤) :
    IsMaximalInvariantIn (diagonalLayer L B a ⊔ orbitCenter L B)
      (componentOrbit L B) B := by
  rw [h.diagonalLayer_eq_normDiagonal]
  exact h.normDiagonal_sup_center_maximalInvariant hgen

/-- The normalizer bound for K Z(E), before passing to Y = KB. -/
theorem Hypotheses.diagonalLayer_sup_center_normalizer_le
    (h : Hypotheses ρ L B a) (hgen : L ⊔ B = ⊤) :
    normalizer ((diagonalLayer L B a ⊔ orbitCenter L B : Subgroup G) : Set G) ≤
      orbitCenter L B ⊔ diagonalOvergroup L B a := by
  simpa only [diagonalOvergroup, h.diagonalLayer_eq_normDiagonal] using
    h.normDiagonal_sup_center_normalizer_le hgen

/-- Recovering K as Y′ gives the required normalizer control for Y itself. -/
theorem Hypotheses.diagonalOvergroup_normalizer_control
    (h : Hypotheses ρ L B a) (hgen : L ⊔ B = ⊤) :
    normalizer (diagonalOvergroup L B a : Set G) ≤
      orbitCenter L B ⊔ diagonalOvergroup L B a :=
  h.diagonalOvergroup_normalizer_control_of_diagonal_normalizer hgen
    (h.diagonalLayer_sup_center_normalizer_le hgen)

/-- The faithful source four-group supplies the reverse commutator containment. -/
theorem Hypotheses.diagonalLayer_le_commutator (h : Hypotheses ρ L B a) :
    diagonalLayer L B a ≤ ⁅diagonalLayer L B a, B⁆ := by
  rw [h.diagonalLayer_eq_normDiagonal]
  exact h.normDiagonal_le_commutator

/-- The source identity K = [K,B], with no additional structural premise. -/
theorem Hypotheses.diagonalLayer_commutator (h : Hypotheses ρ L B a) :
    ⁅diagonalLayer L B a, B⁆ = diagonalLayer L B a := by
  rw [h.diagonalLayer_eq_normDiagonal]
  exact h.normDiagonal_commutator

/-- The completed generation assertion from Step 2, using invariant maximality. -/
theorem Hypotheses.diagonal_generation_of_not_mem_exceptional
    (h : Hypotheses ρ L B a) (hgen : L ⊔ B = ⊤)
    {x : G} (hx : x ∉ orbitCenter L B ⊔ diagonalOvergroup L B a) :
    diagonalOvergroup L B a ⊔
      (diagonalOvergroup L B a).map (MulAut.conj x⁻¹).toMonoidHom = ⊤ :=
  h.diagonal_generation_of_invariant_maximality hgen
    (h.diagonalLayer_sup_center_maximalInvariant hgen)
    (h.diagonalLayer_sup_center_normalizer_le hgen) hx

/-- Oddness of the actual orbit center gives generation for even-order
involution products, discharging the group-theoretic input of Step 1. -/
theorem Hypotheses.diagonal_generation_of_even
    (h : Hypotheses ρ L B a) (hgen : L ⊔ B = ⊤) (hcore : pCore 2 G = ⊥)
    {x : G} (hx : Even (orderOf (a * (x⁻¹ * a * x)))) :
    diagonalOvergroup L B a ⊔
      (diagonalOvergroup L B a).map (MulAut.conj x⁻¹).toMonoidHom = ⊤ :=
  h.diagonal_generation_of_even_of_invariant_maximality hgen hcore
    (h.diagonalLayer_sup_center_maximalInvariant hgen)
    (h.diagonalLayer_sup_center_normalizer_le hgen) hx

/-- The source displacement assertion [V,a,Y] = 1, with K = [K,B] proved. -/
theorem Hypotheses.diagonalOvergroup_fixesDisplacements_of_source
    (h : Hypotheses ρ L B a) :
    FixesDisplacements ρ a (diagonalOvergroup L B a) :=
  h.diagonalOvergroup_fixesDisplacements h.diagonalLayer_commutator

/-- In the reduced source setup the marked involution has odd transpositions.
All diagonal, maximality, normalizer and commutator premises are discharged. -/
theorem Hypotheses.hasOddTranspositions_of_sup_eq_top [ρ.IsIrreducible]
    (h : Hypotheses ρ L B a) (hgen : L ⊔ B = ⊤) (hcore : pCore 2 G = ⊥) :
    HasOddTranspositions a := by
  apply h.hasOddTranspositions_of_diagonal_generation h.diagonalLayer_commutator
  intro x hx
  apply h.diagonal_generation_of_even hgen hcore
  rw [hx]
  exact ⟨1, rfl⟩

end Representation.QuadraticFourGroup

end
