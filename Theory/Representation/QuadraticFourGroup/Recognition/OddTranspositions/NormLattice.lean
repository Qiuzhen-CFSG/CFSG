module

public import Theory.Representation.QuadraticFourGroup.Recognition.OddTranspositions.NormLattice.Action
public import Theory.Representation.QuadraticFourGroup.Recognition.OddTranspositions.NormLattice.Coordinates
public import Theory.Representation.QuadraticFourGroup.Recognition.OddTranspositions.NormLattice.Coordinates.Construction
public import Theory.Representation.QuadraticFourGroup.Recognition.OddTranspositions.NormLattice.PairedLattice
public import Theory.Representation.QuadraticFourGroup.Recognition.OddTranspositions.InvariantAssembly

/-!
# Structural properties of the actual norm diagonal

The norm diagonal is generated by its commutators with the source four-group.
Its central saturation is a proper invariant subgroup of the component orbit:
a central supplement of a perfect group is redundant, while the marked
involution moves the original component.

Coordinates on the literal central quotient identify the norm image with the
product of pair diagonals. The paired-product lattice theorem gives invariant
maximality and self-normalization, which lift through the central quotient.
Finally, writing ambient elements in E B gives the ambient normalizer bound.
These structural assertions discharge the corresponding odd-transposition
premises; identifying the norm diagonal with the centralizer layer remains
an independent input.

Source: GLS2, Chapter B, Lemmas 3.25--3.27; Chapter G, Theorem 25.14, Steps 2--3.
-/

@[expose] public section

open Subgroup Theory.GroupTheory
namespace Representation.QuadraticFourGroup

variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  {ρ : Representation (ZMod 2) G V} {L B : Subgroup G} {a : G}

/-- Central saturation of the norm diagonal remains proper in the orbit. -/
theorem Hypotheses.normDiagonal_sup_center_lt (h : Hypotheses ρ L B a) :
    h.normDiagonal ⊔ orbitCenter L B < componentOrbit L B := by
  have hDE : h.normDiagonal ≤ componentOrbit L B :=
    h.normDiagonal_le_orbitCentralizer.trans inf_le_left
  refine lt_of_le_of_ne (sup_le hDE (orbitCenter_le_componentOrbit L B)) ?_
  intro he
  let := h.component.orbit_isPerfect B
  have hED : componentOrbit L B ≤ h.normDiagonal :=
    (commutator_eq_self (H := componentOrbit L B)).symm.le.trans
      ((commutator_eq_of_central_supplement he
        (orbitCenter_le_centralizer_orbit L B)).le.trans h.normDiagonal.commutator_le_self)
  have haC : a ∈ Subgroup.centralizer (L : Set G) := by
    apply mem_centralizer_iff.mpr
    intro x hx
    exact mem_centralizer_singleton_iff.mp
      ((h.normDiagonal_le_orbitCentralizer.trans inf_le_right)
        (hED (le_componentOrbit L B hx)))
  exact h.moves (mem_normalizer_iff_map_conj_eq.mp (centralizer_le_normalizer _ haC))

/-- The actual source four-group normalizes the centrally saturated norm diagonal. -/
theorem Hypotheses.normDiagonal_sup_center_normalized [Finite G]
    (h : Hypotheses ρ L B a) (hgen : L ⊔ B = ⊤) :
    B ≤ normalizer ((h.normDiagonal ⊔ orbitCenter L B : Subgroup G) : Set G) := by
  let : (orbitCenter L B).Normal := orbitCenter_normal_of_sup_eq_top hgen
  exact h.normDiagonal_normalized.trans normalizer_le_normalizer_sup_normal

variable {h : Hypotheses ρ L B a}

private theorem coordinate_comap_diagonal (d : NormPairCoordinates h) :
    (PairedProduct.diagonal (Fin d.pairCount) (L ⧸ center L)).comap
      (d.equiv.toMonoidHom.comp (QuotientGroup.mk' (center (componentOrbit L B)))) =
      (h.normDiagonal ⊔ orbitCenter L B).subgroupOf (componentOrbit L B) := by
  rw [← d.norm_image, comap_map_eq,
    MonoidHom.ker_comp_of_injective _ _ d.equiv.injective, QuotientGroup.ker_mk',
    subgroupOf_sup (h.normDiagonal_le_orbitCentralizer.trans inf_le_left)
      (orbitCenter_le_componentOrbit L B)]
  congr 1
  exact (comap_map_eq_self_of_injective (componentOrbit L B).subtype_injective
    (center (componentOrbit L B))).symm

private theorem coordinate_image_invariant [Finite G] (d : NormPairCoordinates h)
    {M : Subgroup G} (hBM : B ≤ normalizer (M : Set G)) (b : B) :
    ((M.subgroupOf (componentOrbit L B)).map
      (d.equiv.toMonoidHom.comp (QuotientGroup.mk' (center (componentOrbit L B))))).map
        (h.orbitCoordinateAction d.equiv b).toMonoidHom =
    (M.subgroupOf (componentOrbit L B)).map
      (d.equiv.toMonoidHom.comp (QuotientGroup.mk' (center (componentOrbit L B)))) := by
  apply eq_of_le_of_card_ge
  · rintro _ ⟨_, ⟨x, hx, rfl⟩, rfl⟩
    refine ⟨h.orbitConjugation b x, ?_, ?_⟩
    · exact (mem_normalizer_iff.mp (hBM b.property) (x : G)).mp hx
    · exact (h.orbitCoordinateAction_apply d.equiv b x).symm
  · rw [card_map_of_injective
      (f := (h.orbitCoordinateAction d.equiv b).toMonoidHom)
      (h.orbitCoordinateAction d.equiv b).injective]

private theorem coordinate_intermediate [Finite G] (d : NormPairCoordinates h)
    {M : Subgroup G} (hDM : h.normDiagonal ⊔ orbitCenter L B ≤ M)
    (hME : M ≤ componentOrbit L B) (hBM : B ≤ normalizer (M : Set G)) :
    M = h.normDiagonal ⊔ orbitCenter L B ∨ M = componentOrbit L B := by
  let E := componentOrbit L B
  let f := d.equiv.toMonoidHom.comp (QuotientGroup.mk' (center E))
  have hk : f.ker ≤ M.subgroupOf E := by
    rw [MonoidHom.ker_comp_of_injective _ _ d.equiv.injective, QuotientGroup.ker_mk']
    intro x hx
    exact hDM (mem_sup_right (show (x : G) ∈ orbitCenter L B from ⟨x, hx, rfl⟩))
  have hd : PairedProduct.diagonal (Fin d.pairCount) (L ⧸ center L) ≤
      (M.subgroupOf E).map f := by
    rw [← d.norm_image]
    exact map_mono (comap_mono (le_sup_left.trans hDM))
  rcases d.invariant_intermediate_eq_diagonal_or_top hd
    (coordinate_image_invariant d hBM) with he | he
  · left
    have he' := congrArg (Subgroup.comap f) he
    rw [comap_map_eq_self hk, coordinate_comap_diagonal d] at he'
    have he'' := congrArg (Subgroup.map E.subtype) he'
    simpa only [E, map_subgroupOf_eq_of_le hME,
      map_subgroupOf_eq_of_le (sup_le (h.normDiagonal_le_orbitCentralizer.trans inf_le_left)
        (orbitCenter_le_componentOrbit L B))] using he''
  · right
    have he' := congrArg (Subgroup.comap f) he
    rw [comap_map_eq_self hk, comap_top] at he'
    have he'' := congrArg (Subgroup.map E.subtype) he'
    simpa only [E, map_subgroupOf_eq_of_le hME, ← MonoidHom.range_eq_map, range_subtype] using he''

private theorem coordinate_normalizer (d : NormPairCoordinates h) :
    normalizer (((h.normDiagonal ⊔ orbitCenter L B).subgroupOf (componentOrbit L B)) :
      Set (componentOrbit L B)) =
        (h.normDiagonal ⊔ orbitCenter L B).subgroupOf (componentOrbit L B) := by
  let f := d.equiv.toMonoidHom.comp
    (QuotientGroup.mk' (center (componentOrbit L B)))
  have hf : Function.Surjective f :=
    d.equiv.surjective.comp (QuotientGroup.mk'_surjective _)
  rw [← coordinate_comap_diagonal d, ← comap_normalizer_eq_of_surjective _ hf,
    d.diagonal_self_normalizing]

/-- Maximality is in the lattice of B-invariant subgroups of the actual orbit. -/
theorem Hypotheses.normDiagonal_sup_center_maximalInvariant [Finite G]
    (h : Hypotheses ρ L B a) (hgen : L ⊔ B = ⊤) :
    IsMaximalInvariantIn (h.normDiagonal ⊔ orbitCenter L B) (componentOrbit L B) B := by
  obtain ⟨d⟩ := h.normPairCoordinates_nonempty
  exact ⟨h.normDiagonal_sup_center_lt, h.normDiagonal_sup_center_normalized hgen,
    fun _ hDM hME hBM => coordinate_intermediate d hDM hME hBM⟩

/-- Inside E, the central saturation of the norm diagonal is self-normalizing. -/
theorem Hypotheses.normDiagonal_sup_center_normalizer_inf [Finite G]
    (h : Hypotheses ρ L B a) :
    normalizer ((h.normDiagonal ⊔ orbitCenter L B : Subgroup G) : Set G) ⊓
      componentOrbit L B = h.normDiagonal ⊔ orbitCenter L B := by
  obtain ⟨d⟩ := h.normPairCoordinates_nonempty
  have hDE := sup_le (h.normDiagonal_le_orbitCentralizer.trans inf_le_left)
    (orbitCenter_le_componentOrbit L B)
  apply le_antisymm
  · intro x hx
    have hx' : (⟨x, hx.2⟩ : componentOrbit L B) ∈
        normalizer ((h.normDiagonal ⊔ orbitCenter L B).subgroupOf (componentOrbit L B)) := by
      rw [← subgroupOf_normalizer_eq hDE]
      exact hx.1
    rw [coordinate_normalizer d] at hx'
    exact hx'
  · exact le_inf (h.normDiagonal ⊔ orbitCenter L B).le_normalizer hDE

/-- The ambient normalizer has no extra elements beyond the source overgroup
and the actual orbit center. -/
theorem Hypotheses.normDiagonal_sup_center_normalizer_le [Finite G]
    (h : Hypotheses ρ L B a) (hgen : L ⊔ B = ⊤) :
    normalizer ((h.normDiagonal ⊔ orbitCenter L B : Subgroup G) : Set G) ≤
      orbitCenter L B ⊔ (h.normDiagonal ⊔ B) := by
  let E := componentOrbit L B
  let : E.Normal := by
    have hn := (normal_subgroupOf_iff_le_normalizer (componentOrbit_le_sup L B)).mp
      (componentOrbit_normal_subgroupOf_sup L B)
    rw [hgen] at hn
    exact normalizer_eq_top_iff.mp (top_unique hn)
  intro x hx
  have hxEB : x ∈ E ⊔ B := (componentOrbit_sup L B).trans hgen ▸ mem_top x
  obtain ⟨e, he, b, hb, rfl⟩ := mem_sup_of_normal_left.mp hxEB
  have hbN := h.normDiagonal_sup_center_normalized hgen hb
  have heN : e ∈ normalizer ((h.normDiagonal ⊔ orbitCenter L B : Subgroup G) : Set G) := by
    simpa only [mul_inv_cancel_right] using mul_mem hx (inv_mem hbN)
  have heD : e ∈ h.normDiagonal ⊔ orbitCenter L B :=
    h.normDiagonal_sup_center_normalizer_inf ▸ ⟨heN, he⟩
  have hle : h.normDiagonal ⊔ orbitCenter L B ≤
      orbitCenter L B ⊔ (h.normDiagonal ⊔ B) :=
    sup_le (le_sup_left.trans le_sup_right) le_sup_left
  exact (orbitCenter L B ⊔ (h.normDiagonal ⊔ B)).mul_mem
    (hle heD) (mem_sup_right (mem_sup_right hb))

/-- The norm commutator calculation discharges the reverse-commutator premise
of the actual odd-transposition consumer. This interface retains explicit
lattice premises; the assembled consumer below supplies them. -/
theorem Hypotheses.hasOddTranspositions_of_norm_lattice [Finite G] [ρ.IsIrreducible]
    (h : Hypotheses ρ L B a) (hgen : L ⊔ B = ⊤) (hcore : pCore 2 G = ⊥)
    (hident : h.normDiagonal = diagonalLayer L B a)
    (hmax : IsMaximalInvariantIn (h.normDiagonal ⊔ orbitCenter L B)
      (componentOrbit L B) B)
    (hN : normalizer ((h.normDiagonal ⊔ orbitCenter L B : Subgroup G) : Set G) ≤
      orbitCenter L B ⊔ (h.normDiagonal ⊔ B)) : HasOddTranspositions a := by
  apply h.hasOddTranspositions_of_invariant_diagonal hgen hcore
  · simpa only [hident] using hmax
  · simpa only [hident, diagonalOvergroup] using hN
  · simpa only [hident] using h.normDiagonal_le_commutator

/-- The lattice assertions and commutator identity are discharged; only the
independent identification with the intrinsic centralizer layer remains. -/
theorem Hypotheses.hasOddTranspositions_of_norm_identification [Finite G] [ρ.IsIrreducible]
    (h : Hypotheses ρ L B a) (hgen : L ⊔ B = ⊤) (hcore : pCore 2 G = ⊥)
    (hident : h.normDiagonal = diagonalLayer L B a) : HasOddTranspositions a :=
  h.hasOddTranspositions_of_norm_lattice hgen hcore hident
    (h.normDiagonal_sup_center_maximalInvariant hgen)
    (h.normDiagonal_sup_center_normalizer_le hgen)

end Representation.QuadraticFourGroup

end
