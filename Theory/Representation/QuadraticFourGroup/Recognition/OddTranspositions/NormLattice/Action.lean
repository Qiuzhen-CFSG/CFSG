module

public import Theory.Representation.QuadraticFourGroup.Recognition.OddTranspositions.DiagonalModel
public import Theory.GroupTheory.GeneralizedFitting.ComponentSwapNormAction

/-!
# Faithful action on the explicit norm diagonal

The norm image for a component pair is quasisimple and normal in the full
norm diagonal. Conjugation either preserves this image or sends it into a
commuting component pair. Its centralizer in the source four-group is exactly
the subgroup generated by the marked involution: perfectness lifts trivial
action across the norm map's central kernel. The component commutator
dichotomy then gives `D = [D,B]`, without a split-orbit recognition premise.

Source: GLS2, Chapter B, Lemmas 3.26--3.27, and Chapter G, Theorem 25.14,
Step 3. All conjugations and norm maps are those of the original ambient group.
-/

@[expose] public section

open Subgroup Theory.GroupTheory

namespace Representation.QuadraticFourGroup
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  {ρ : Representation (ZMod 2) G V} {L B : Subgroup G} {a : G}

open Theory.GroupTheory.NormPair

private lemma square_one (h : Hypotheses ρ L B a) : a ^ 2 = 1 := by
  rw [← h.involution]
  exact pow_orderOf_eq_one a

private lemma seed_fixed (h : Hypotheses ρ L B a) :
    a ∈ Subgroup.centralizer (normRange h.component h.moves : Set G) :=
  mem_centralizer_iff.mpr fun _ hx => mem_centralizer_singleton_iff.mp
    (componentSwapNorm_range_le_centralizer h.component h.moves (square_one h) hx)

lemma Hypotheses.normSeed_normalized_by_diagonal (h : Hypotheses ρ L B a) :
    h.normDiagonal ≤ normalizer (normRange h.component h.moves : Set G) := by
  apply iSup_le
  intro b
  have hb : Commute (b : G) a := mem_centralizer_singleton_iff.mp
    (h.fourGroup_le_centralizer b.property)
  by_cases hpair : L.map (MulAut.conj (b : G)).toMonoidHom = L ∨
      L.map (MulAut.conj (b : G)).toMonoidHom = L.map (MulAut.conj a).toMonoidHom
  · have hn := normalizes_norm_of_pair h.component h.moves (square_one h) hb hpair
    exact (mem_normalizer_iff_map_conj_eq.mp hn).le.trans (normRange h.component h.moves).le_normalizer
  · push Not at hpair
    exact (conjugate_norm_centralizes_of_outside_pair h.component h.moves
      (square_one h) hb hpair.1 hpair.2).trans (centralizer_le_normalizer _)

lemma Hypotheses.normSeed_component (h : Hypotheses ρ L B a) :
    IsComponent h.normDiagonal ((normRange h.component h.moves).subgroupOf h.normDiagonal) := by
  have hn := normal_subgroupOf_of_le_normalizer h.normSeed_normalized_by_diagonal
  let := componentSwapNorm_range_quasisimple h.component h.moves
  exact ⟨hn.isSubnormal,
    IsQuasisimple.of_mulEquiv
      (subgroupOfEquivOfLe (le_componentOrbit (normRange h.component h.moves) B)).symm⟩

private lemma normalizes_component_of_swap (h : Hypotheses ρ L B a) {b : G}
    (he : L.map (MulAut.conj b).toMonoidHom = L.map (MulAut.conj a).toMonoidHom) :
    a * b ∈ normalizer (L : Set G) := by
  have haa : a * a = 1 := by simpa [pow_two] using square_one h
  apply mem_normalizer_iff_map_conj_eq.mpr
  change L.map (MulAut.conj (a * b)).toMonoidHom = L
  have hmul (J : Subgroup G) (c d : G) :
      J.map (MulAut.conj (c * d)).toMonoidHom =
        (J.map (MulAut.conj d).toMonoidHom).map (MulAut.conj c).toMonoidHom := by
    rw [map_map]
    congr 1
    ext x
    simp [MulAut.conj_apply, mul_assoc]
  rw [hmul, he, ← hmul, haa]
  convert L.map_id using 1
  ext x
  simp

lemma Hypotheses.normSeed_centralizer (h : Hypotheses ρ L B a) :
    B ⊓ Subgroup.centralizer (normRange h.component h.moves : Set G) = zpowers a := by
  apply le_antisymm
  · intro b hb
    have hba : Commute b a := mem_centralizer_singleton_iff.mp
      (h.fourGroup_le_centralizer hb.1)
    have htriv {c : G} (hc : c ∈ B) (hN : c ∈ normalizer (L : Set G))
        (hC : c ∈ Subgroup.centralizer (normRange h.component h.moves : Set G)) : c = 1 := by
      have hca : Commute c a := mem_centralizer_singleton_iff.mp
        (h.fourGroup_le_centralizer hc)
      have hx : c ∈ B ⊓ Subgroup.centralizer (L : Set G) :=
        ⟨hc, centralizes_norm_normalizes_component h.component h.moves hca hN hC⟩
      simpa only [h.centralizer, mem_bot] using hx
    by_cases hL : L.map (MulAut.conj b).toMonoidHom = L
    · rw [htriv hb.1 (mem_normalizer_iff_map_conj_eq.mpr hL) hb.2]
      exact one_mem _
    by_cases hLa : L.map (MulAut.conj b).toMonoidHom = L.map (MulAut.conj a).toMonoidHom
    · have hab : a * b = 1 := htriv (B.mul_mem h.mem hb.1)
        (normalizes_component_of_swap h hLa) (mul_mem (seed_fixed h) hb.2)
      have haa : a * a = 1 := by simpa [pow_two] using square_one h
      have he : b = a := by
        calc b = a * (a * b) := by rw [← mul_assoc, haa, one_mul]
             _ = a := by rw [hab, mul_one]
      rw [he]
      exact mem_zpowers _
    · have hc := conjugate_norm_centralizes_of_outside_pair h.component h.moves
        (square_one h) hba hL hLa
      have he := mem_normalizer_iff_map_conj_eq.mp (centralizer_le_normalizer _ hb.2)
      change (normRange h.component h.moves).map (MulAut.conj b).toMonoidHom =
        normRange h.component h.moves at he
      rw [he] at hc
      let := componentSwapNorm_range_quasisimple h.component h.moves
      let : IsSimpleGroup ((normRange h.component h.moves) ⧸ center (normRange h.component h.moves)) :=
        IsQuasisimple.simple
      let : Nontrivial (normRange h.component h.moves) :=
        (QuotientGroup.mk'_surjective (center (normRange h.component h.moves))).nontrivial
      exact (Group.IsPerfect.not_isMulCommutative (normRange h.component h.moves)
        (le_centralizer_iff_isMulCommutative.mp hc)).elim
  · exact zpowers_le.mpr ⟨h.mem, seed_fixed h⟩

/-- The kernel of the B-action on the entire norm diagonal is precisely the
marked order-two subgroup. -/
lemma Hypotheses.normDiagonal_centralizer (h : Hypotheses ρ L B a) :
    B ⊓ Subgroup.centralizer (h.normDiagonal : Set G) = zpowers a := by
  apply le_antisymm
  · exact (inf_le_inf_left B
      (centralizer_le (le_componentOrbit (normRange h.component h.moves) B))).trans
        h.normSeed_centralizer.le
  · apply zpowers_le.mpr
    refine ⟨h.mem, mem_centralizer_iff.mpr fun _ hx => ?_⟩
    exact mem_centralizer_singleton_iff.mp
      ((h.normDiagonal_le_orbitCentralizer.trans inf_le_right) hx)

variable [Finite G]

lemma Hypotheses.normSeed_not_centralized (h : Hypotheses ρ L B a) :
    ¬ B ≤ Subgroup.centralizer (normRange h.component h.moves : Set G) := by
  intro hc
  have hle : B ≤ zpowers a := h.normSeed_centralizer ▸ le_inf le_rfl hc
  have hcard := card_le_of_le hle
  rw [h.card_four, Nat.card_zpowers, h.involution] at hcard
  omega

lemma Hypotheses.normDiagonal_le_commutator (h : Hypotheses ρ L B a) :
    h.normDiagonal ≤ ⁅h.normDiagonal, B⁆ := by
  let D := h.normDiagonal
  let K₀ := normRange h.component h.moves
  let C := ⁅D, B⁆
  have hKD : K₀ ≤ D := le_componentOrbit K₀ B
  have hCD : C ≤ D := le_normalizer_iff_commutator_le_left.mp h.normDiagonal_normalized
  let : (C.subgroupOf D).Normal := normal_subgroupOf_of_le_normalizer
    (normalizer_commutator_ge_left D B)
  have hcomp : IsComponent D (K₀.subgroupOf D) := h.normSeed_component
  rcases hcomp.normal_dichotomy (C.subgroupOf D) with hle | hc
  · have hKC : K₀ ≤ C := by
      simpa [map_subgroupOf_eq_of_le hKD, map_subgroupOf_eq_of_le hCD] using
        map_mono (f := D.subtype) hle
    exact iSup_conjugates_le_of_le_normalizer K₀ B C hKC
      (normalizer_commutator_ge_right D B)
  · have hc' : ⁅K₀, C⁆ = ⊥ := by
      have he := congrArg (Subgroup.map D.subtype) hc
      simpa [map_commutator, map_subgroupOf_eq_of_le hKD,
        map_subgroupOf_eq_of_le hCD] using he
    let := componentSwapNorm_range_quasisimple h.component h.moves
    have hiter : ⁅⁅B, K₀⁆, K₀⁆ = ⊥ := by
      apply le_bot_iff.mp
      calc
        ⁅⁅B, K₀⁆, K₀⁆ ≤ ⁅C, K₀⁆ := commutator_mono
          ((commutator_comm B K₀).le.trans (commutator_mono hKD le_rfl)) le_rfl
        _ = ⊥ := (commutator_comm _ _).trans hc'
    exact (h.normSeed_not_centralized
      (commutator_eq_bot_iff_le_centralizer.mp
        (commutator_eq_bot_of_iterated_eq_bot B K₀ hiter))).elim

lemma Hypotheses.normDiagonal_commutator (h : Hypotheses ρ L B a) :
    ⁅h.normDiagonal, B⁆ = h.normDiagonal :=
  le_antisymm (le_normalizer_iff_commutator_le_left.mp h.normDiagonal_normalized)
    h.normDiagonal_le_commutator

end Representation.QuadraticFourGroup

end
