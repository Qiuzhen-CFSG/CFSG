module

public import Theory.Representation.QuadraticFourGroup.Recognition.OddTranspositions.NormCentralizer.NormImages
public import Theory.Representation.QuadraticFourGroup.Recognition.OddTranspositions.NormCentralizer.CentralProduct

/-!
# The paired-component centralizer formula

Conjugation by a acts without fixed points on the set of distinct components
in the B-orbit. Choose one component of each two-element orbit, using an
arbitrary finite ordering, and join these components to form P. The remaining
components form Pᵃ. Distinct components commute, so P and Pᵃ commute, without
any assertion that their central intersection is trivial.

The norm homomorphism on P is generated by the component norms, hence its
image lies in D. The swapped-central-product formula now gives
C_E(a) = D C_Z(E)(a). All subgroups retain their ambient embeddings.

Source: GLS2, Chapter B, Lemma 3.27, first paragraph of the proof; Chapter G,
Theorem 25.14, Step 2. Neither O₂(G) = 1 nor O₂′(G) = 1 is needed here.
-/

@[expose] public section

open Subgroup Theory.GroupTheory
namespace Representation.QuadraticFourGroup
variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
  {ρ : Representation (ZMod 2) G V} {L B : Subgroup G} {a : G}

omit [Finite G] in
private theorem conjugate_mul (K : Subgroup G) (a b : G) :
    K.map (MulAut.conj (a*b)).toMonoidHom =
      (K.map (MulAut.conj b).toMonoidHom).map (MulAut.conj a).toMonoidHom := by
  rw [map_map]
  congr 1
  ext x
  simp [MulAut.conj_apply, mul_assoc]

/-- Select one component from each two-element orbit. The two resulting
joins commute, generate E, and the norm of their first half lies in D. -/
theorem Hypotheses.exists_commuting_orbit_half (h : Hypotheses ρ L B a) :
    ∃ (P : Subgroup G)
      (hc : P ≤ Subgroup.centralizer (P.map (MulAut.conj a).toMonoidHom : Set G)),
      P ⊔ P.map (MulAut.conj a).toMonoidHom = componentOrbit L B ∧
      (commutingSwapNorm P a hc).range ≤ h.normDiagonal := by
  classical
  let S : Set (Subgroup G) := Set.range (fun b : B => L.map (MulAut.conj (b : G)).toMonoidHom)
  let T : Subgroup G → Subgroup G := fun K => K.map (MulAut.conj a).toMonoidHom
  have haa : a*a = 1 := by rw [← pow_two, ← h.involution]; exact pow_orderOf_eq_one a
  have hT (K : Subgroup G) : T (T K) = K := by
    dsimp only [T]
    rw [← conjugate_mul, haa]
    have h1 : (MulAut.conj (1 : G)).toMonoidHom = MonoidHom.id G := by ext x; simp
    rw [h1, map_id]
  have hTS {K : Subgroup G} (hK : K ∈ S) : T K ∈ S := by
    obtain ⟨b,rfl⟩ := hK
    refine ⟨⟨a*b,B.mul_mem h.mem b.property⟩, ?_⟩
    exact conjugate_mul L a b
  have hne {K : Subgroup G} (hK : K ∈ S) : T K ≠ K := by
    obtain ⟨b,rfl⟩ := hK
    exact h.conjugate_moved b
  have hcomp {K : Subgroup G} (hK : K ∈ S) : IsComponent G K := by
    obtain ⟨b,rfl⟩ := hK
    exact h.component.map_conj b
  have hKE {K : Subgroup G} (hK : K ∈ S) : K ≤ componentOrbit L B := by
    obtain ⟨b,rfl⟩ := hK
    exact le_iSup (fun b : B => L.map (MulAut.conj (b : G)).toMonoidHom) b
  let : Fintype (Subgroup G) := Fintype.ofFinite _
  let rank := Fintype.equivFin (Subgroup G)
  let R := {K : Subgroup G // K ∈ S ∧ rank K < rank (T K)}
  let P : Subgroup G := ⨆ i : R, i.val
  have hPE : P ≤ componentOrbit L B := iSup_le fun i => hKE i.property.1
  have hPaE : T P ≤ componentOrbit L B := by
    have hAE : T (componentOrbit L B) = componentOrbit L B :=
      mem_normalizer_iff_map_conj_eq.mp ((le_normalizer_componentOrbit L B) h.mem)
    exact (map_mono hPE).trans hAE.le
  have hcover : P ⊔ T P = componentOrbit L B := by
    apply le_antisymm (sup_le hPE hPaE)
    apply iSup_le
    intro b
    let K := L.map (MulAut.conj (b : G)).toMonoidHom
    have hKS : K ∈ S := ⟨b,rfl⟩
    have hrne : rank K ≠ rank (T K) := fun he => hne hKS (rank.injective he).symm
    rcases lt_or_gt_of_ne hrne with hl | hr
    · exact (le_iSup (fun i : R => i.val) ⟨K,hKS,hl⟩).trans le_sup_left
    · have hR : T K ∈ S ∧ rank (T K) < rank (T (T K)) := ⟨hTS hKS, by rwa [hT]⟩
      have hm := map_mono (f := (MulAut.conj a).toMonoidHom)
        (le_iSup (fun i : R => i.val) ⟨T K,hR⟩)
      change T (T K) ≤ T P at hm
      rw [hT] at hm
      exact hm.trans le_sup_right
  have hc : P ≤ Subgroup.centralizer (T P : Set G) := by
    apply iSup_le
    intro i
    apply le_centralizer_iff.mpr
    change P.map (MulAut.conj a).toMonoidHom ≤ _
    rw [show P = ⨆ i : R, i.val from rfl, Subgroup.map_iSup]
    apply iSup_le
    intro j
    have hij : T j.val ≠ i.val := by
      intro he
      have hi : rank (T j.val) < rank j.val := by
        have := i.property.2
        rw [← he, hT] at this
        exact this
      exact (not_lt_of_gt j.property.2) hi
    exact commutator_eq_bot_iff_le_centralizer.mp
      ((hcomp (hTS j.property.1)).commutator_eq_bot_of_ne (hcomp i.property.1) hij)
  refine ⟨P,hc,hcover,?_⟩
  rintro _ ⟨p,rfl⟩
  have hn : ∀ x ∈ P, x * (a*x*a⁻¹) ∈ h.normDiagonal := by
    intro x hx
    have hx' : x ∈ P ∧ x * (a*x*a⁻¹) ∈ h.normDiagonal := by
      refine Subgroup.iSup_induction (fun i : R => i.val)
        (C := fun x => x ∈ P ∧ x * (a*x*a⁻¹) ∈ h.normDiagonal) hx ?_ ?_ ?_
      · intro i y hy
        refine ⟨(le_iSup (fun i : R => i.val) i) hy, ?_⟩
        obtain ⟨b,hb⟩ := i.property.1
        apply h.conjugate_norm_mem b
        change L.map (MulAut.conj (b : G)).toMonoidHom = i.val at hb
        rwa [hb]
      · exact ⟨one_mem P, by simp⟩
      · intro x y hx hy
        refine ⟨mul_mem hx.1 hy.1, ?_⟩
        change commutingSwapNorm P a hc ((⟨x,hx.1⟩ : P) * ⟨y,hy.1⟩) ∈ h.normDiagonal
        rw [map_mul]
        exact mul_mem hx.2 hy.2
    exact hx'.2
  exact hn p p.property

/-- The full relative centralizer is the concrete norm diagonal times its
fixed orbit center. This holds for central products, with no recognition input. -/
theorem Hypotheses.orbitCentralizer_eq_normDiagonal_sup_fixedCenter
    (h : Hypotheses ρ L B a) :
    orbitCentralizer L B a = h.normDiagonal ⊔
      (orbitCenter L B ⊓ Subgroup.centralizer ({a} : Set G)) := by
  obtain ⟨P,hc,hcover,hn⟩ := h.exists_commuting_orbit_half
  have ha : a ^ 2 = 1 := by rw [← h.involution]; exact pow_orderOf_eq_one a
  have he := centralizer_sup_conjugate_eq_norm_sup_center P a hc ha
  dsimp only at he
  rw [hcover] at he
  apply le_antisymm
  · change componentOrbit L B ⊓ Subgroup.centralizer ({a} : Set G) ≤ _
    rw [he]
    exact sup_le_sup_right hn _
  · exact sup_le h.normDiagonal_le_orbitCentralizer
      (le_inf (inf_le_left.trans (orbitCenter_le_componentOrbit L B)) inf_le_right)

end Representation.QuadraticFourGroup

end
