module

public import Theory.Representation.QuadraticFourGroup.Recognition.OddTranspositions.DiagonalGeneration
public import Theory.GroupTheory.GeneralizedFitting.ComponentSwapDiagonal
public import Theory.GroupTheory.InvariantMaximalGeneration

/-!
# Concrete diagonal maps and the invariant-maximality generation step

The diagonal generated by the maps `l ↦ l (a l a⁻¹)` on the B-conjugates
of L is a specific perfect B-invariant subgroup of `C_E(a)`. The remaining
structural assertions are its equality with `E(C_E(a))`, maximality modulo
`Z(E)` among B-invariant subgroups, and the corresponding normalizer bound.

The generation theorem below takes precisely the latter two assertions as
inputs. It applies invariant maximality inside E and removes the central
supplement by perfectness. In particular it does not assume that K B is
maximal in the ambient group. Its even-order consequence consumes the odd
centre calculation from `DiagonalGeneration`.

Source: GLS2, Chapter B, Lemmas 3.25 and 3.27; Chapter G, Theorem 25.14,
Steps 2--3. These conditional deductions do not discharge the remaining
diagonal identification or invariant maximality assertions.
-/

@[expose] public section

open Subgroup Theory.GroupTheory

namespace Representation.QuadraticFourGroup

variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  {ρ : Representation (ZMod 2) G V} {L B : Subgroup G} {a : G}

/-- The subgroup generated by the actual norm diagonals on the component
pairs. Repetitions of a pair in the B-orbit do not add generators. -/
def Hypotheses.normDiagonal (h : Hypotheses ρ L B a) : Subgroup G :=
  componentOrbit (componentSwapNorm h.component h.moves).range B

theorem Hypotheses.normDiagonal_normalized (h : Hypotheses ρ L B a) :
    B ≤ normalizer (h.normDiagonal : Set G) :=
  le_normalizer_componentOrbit _ B

theorem Hypotheses.normDiagonal_perfect (h : Hypotheses ρ L B a) :
    Group.IsPerfect h.normDiagonal := by
  let := componentSwapNorm_range_quasisimple h.component h.moves
  exact isPerfect_iSup_conjugates _ B

/-- The explicit norm diagonals lie in the literal relative centralizer. -/
theorem Hypotheses.normDiagonal_le_orbitCentralizer (h : Hypotheses ρ L B a) :
    h.normDiagonal ≤ orbitCentralizer L B a := by
  have ha : a ^ 2 = 1 := by rw [← h.involution]; exact pow_orderOf_eq_one _
  have hr : (componentSwapNorm h.component h.moves).range ≤ orbitCentralizer L B a :=
    le_inf (componentSwapNorm_range_le_orbit h.component h.moves h.mem)
      (componentSwapNorm_range_le_centralizer h.component h.moves ha)
  have hB : B ≤ normalizer (orbitCentralizer L B a : Set G) :=
    (le_inf (le_normalizer_componentOrbit L B) h.fourGroup_normalizes_centralizer).trans
      inf_normalizer_le_normalizer_inf
  exact iSup_conjugates_le_of_le_normalizer _ B _ hr hB

/-- Every intrinsic component layer, and hence the actual diagonal layer,
is perfect. This uses no identification of its components. -/
theorem diagonalLayer_perfect (L B : Subgroup G) (a : G) :
    Group.IsPerfect (diagonalLayer L B a) := by
  let H := orbitCentralizer L B a
  have hp : Group.IsPerfect (componentLayer H) := by
    rw [isPerfect_iff]
    apply le_antisymm (componentLayer H).commutator_le_self
    apply sSup_le
    intro C hC
    let := hC.2
    exact (commutator_eq_self (H := C)).symm.le.trans
      (commutator_mono (le_sSup hC) (le_sSup hC))
  let := hp
  exact Group.IsPerfect.map H.subtype

/-- The layer is recoverable as the derived subgroup of its actual
overgroup. Consequently every normalizer of Y also normalizes K. -/
theorem Hypotheses.diagonalOvergroup_derived [Finite G]
    (h : Hypotheses ρ L B a) (hgen : L ⊔ B = ⊤) :
    ⁅diagonalOvergroup L B a, diagonalOvergroup L B a⁆ = diagonalLayer L B a := by
  let := h.elementary
  let := diagonalLayer_perfect L B a
  exact commutator_sup_eq_of_perfect_of_commutative (h.diagonalLayer_normalized hgen)

theorem orbitCenter_le_componentOrbit (L B : Subgroup G) :
    orbitCenter L B ≤ componentOrbit L B := map_subtype_le _

theorem orbitCenter_le_centralizer_orbit (L B : Subgroup G) :
    orbitCenter L B ≤ centralizer (componentOrbit L B : Set G) := by
  rintro z ⟨y, hy, rfl⟩
  apply mem_centralizer_iff.mpr
  intro x hx
  exact congrArg Subtype.val (mem_center_iff.mp hy (⟨x, hx⟩ : componentOrbit L B))

/-- Normalizer control for K Z(E) implies the required control for Y.
Normality of the mapped centre is ambient; K need only be normal in Y. -/
theorem Hypotheses.diagonalOvergroup_normalizer_control_of_diagonal_normalizer [Finite G]
    (h : Hypotheses ρ L B a) (hgen : L ⊔ B = ⊤)
    (hN : normalizer ((diagonalLayer L B a ⊔ orbitCenter L B : Subgroup G) : Set G) ≤
      orbitCenter L B ⊔ diagonalOvergroup L B a) :
    normalizer (diagonalOvergroup L B a : Set G) ≤
      orbitCenter L B ⊔ diagonalOvergroup L B a := by
  let : (orbitCenter L B).Normal := orbitCenter_normal_of_sup_eq_top hgen
  have hYK : normalizer (diagonalOvergroup L B a : Set G) ≤
      normalizer (diagonalLayer L B a : Set G) := by
    rw [← h.diagonalOvergroup_derived hgen]
    exact normalizer_le_normalizer_derived _
  exact (hYK.trans normalizer_le_normalizer_sup_normal).trans hN

/-- The source generation step under precisely the missing invariant
maximality and diagonal-normalizer assertions. -/
theorem Hypotheses.diagonal_generation_of_invariant_maximality [Finite G]
    (h : Hypotheses ρ L B a) (hgen : L ⊔ B = ⊤)
    (hmax : IsMaximalInvariantIn (diagonalLayer L B a ⊔ orbitCenter L B)
      (componentOrbit L B) B)
    (hN : normalizer ((diagonalLayer L B a ⊔ orbitCenter L B : Subgroup G) : Set G) ≤
      orbitCenter L B ⊔ diagonalOvergroup L B a)
    {x : G} (hx : x ∉ orbitCenter L B ⊔ diagonalOvergroup L B a) :
    diagonalOvergroup L B a ⊔
      (diagonalOvergroup L B a).map (MulAut.conj x⁻¹).toMonoidHom = ⊤ := by
  let : (componentOrbit L B).Normal := by
    have hn := (normal_subgroupOf_iff_le_normalizer (componentOrbit_le_sup L B)).mp
      (componentOrbit_normal_subgroupOf_sup L B)
    rw [hgen] at hn
    exact normalizer_eq_top_iff.mp (top_unique hn)
  let : (orbitCenter L B).Normal := orbitCenter_normal_of_sup_eq_top hgen
  let := h.component.orbit_isPerfect B
  exact conjugate_sup_eq_top_of_maximalInvariant
    (diagonalLayer_le_componentOrbit L B a) (orbitCenter_le_componentOrbit L B)
    (orbitCenter_le_centralizer_orbit L B) ((componentOrbit_sup L B).trans hgen)
    hmax hN hx

/-- Oddness of the exceptional centre supplies the even-order version
used by Step 1 of the source proof. -/
theorem Hypotheses.diagonal_generation_of_even_of_invariant_maximality [Finite G]
    (h : Hypotheses ρ L B a) (hgen : L ⊔ B = ⊤) (hcore : pCore 2 G = ⊥)
    (hmax : IsMaximalInvariantIn (diagonalLayer L B a ⊔ orbitCenter L B)
      (componentOrbit L B) B)
    (hN : normalizer ((diagonalLayer L B a ⊔ orbitCenter L B : Subgroup G) : Set G) ≤
      orbitCenter L B ⊔ diagonalOvergroup L B a)
    {x : G} (hx : Even (orderOf (a * (x⁻¹ * a * x)))) :
    diagonalOvergroup L B a ⊔
      (diagonalOvergroup L B a).map (MulAut.conj x⁻¹).toMonoidHom = ⊤ := by
  apply h.diagonal_generation_of_invariant_maximality hgen hmax hN
  intro hxin
  exact (Nat.not_even_iff_odd.mpr
    (h.diagonal_product_odd_of_mem_exceptional hgen hcore hxin)) hx

end Representation.QuadraticFourGroup

end
