module

public import Theory.Representation.QuadraticFourGroup.Recognition.OddTranspositions.NormCentralizer.OrbitHalves
public import Theory.Representation.QuadraticFourGroup.Recognition.OddTranspositions.NormCentralizer.QuotientPair

/-!
# Identification of the norm diagonal with the centralizer layer

Write E = ⟨Lᴮ⟩ and D for the subgroup generated by the explicit component
norms l ↦ l lᵃ. The paired-component decomposition proves
C_E(a) = D C_Z(E)(a). Every component norm is quasisimple and normal inside
C_E(a), so D lies in its intrinsic layer. Conversely the centralizer's derived
subgroup is D, and the perfect layer lies in that derived subgroup.

Thus the actual layer equals D. The quotient statements use the literal
map E → E/Z(E); the norm on a component has kernel exactly Z(L), and its
image is the diagonal copy of L/Z(L).

Source: GLS2, Chapter B, Lemma 3.27, first paragraph of its proof; Chapter G,
Theorem 25.14, Steps 2--3. The opening transcription of 3.27 calls K the full
centralizer, but the proof and Chapter G use its layer. The arguments here
require neither generation of G by L and B nor O₂(G) = 1, and do not use the
stronger centre conclusions requiring O₂′(G) = 1.
-/

@[expose] public section

open Subgroup Theory.GroupTheory
namespace Representation.QuadraticFourGroup
variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
  {ρ : Representation (ZMod 2) G V} {L B : Subgroup G} {a : G}

/-- The derived subgroup of the full orbit centralizer is the concrete norm diagonal. -/
theorem Hypotheses.orbitCentralizer_derived_eq_normDiagonal (h : Hypotheses ρ L B a) :
    ⁅orbitCentralizer L B a, orbitCentralizer L B a⁆ = h.normDiagonal := by
  let := h.normDiagonal_perfect
  calc
    _ = ⁅h.normDiagonal,h.normDiagonal⁆ := commutator_eq_of_central_supplement
      h.orbitCentralizer_eq_normDiagonal_sup_fixedCenter.symm
      ((inf_le_left.trans (orbitCenter_le_centralizer_orbit L B)).trans
        (centralizer_le (show orbitCentralizer L B a ≤ componentOrbit L B from inf_le_left)))
    _ = _ := commutator_eq_self

/-- The intrinsic layer of the relative centralizer is exactly the subgroup
generated by the actual norm diagonals on the component pairs. -/
theorem Hypotheses.diagonalLayer_eq_normDiagonal (h : Hypotheses ρ L B a) :
    diagonalLayer L B a = h.normDiagonal := by
  apply le_antisymm _ h.normDiagonal_le_diagonalLayer
  let := diagonalLayer_perfect L B a
  calc
    diagonalLayer L B a = ⁅diagonalLayer L B a,diagonalLayer L B a⁆ := commutator_eq_self.symm
    _ ≤ ⁅orbitCentralizer L B a,orbitCentralizer L B a⁆ := commutator_mono
      (diagonalLayer_le_orbitCentralizer L B a) (diagonalLayer_le_orbitCentralizer L B a)
    _ = h.normDiagonal := h.orbitCentralizer_derived_eq_normDiagonal

/-- The source centralizer decomposition with its actual intrinsic layer. -/
theorem Hypotheses.orbitCentralizer_eq_diagonalLayer_sup_fixedCenter
    (h : Hypotheses ρ L B a) :
    orbitCentralizer L B a = diagonalLayer L B a ⊔
      (orbitCenter L B ⊓ Subgroup.centralizer ({a} : Set G)) := by
  rw [h.diagonalLayer_eq_normDiagonal]
  exact h.orbitCentralizer_eq_normDiagonal_sup_fixedCenter

/-- The literal quotient map E → E/Z(E) sends the actual centralizer and
the explicit norm diagonal onto the same subgroup. -/
theorem Hypotheses.orbitCentralizer_image_mod_center (h : Hypotheses ρ L B a) :
    let E := componentOrbit L B
    ((orbitCentralizer L B a).subgroupOf E).map (QuotientGroup.mk' (center E)) =
      (h.normDiagonal.subgroupOf E).map (QuotientGroup.mk' (center E)) := by
  dsimp only
  let E := componentOrbit L B
  let Z := orbitCenter L B ⊓ Subgroup.centralizer ({a} : Set G)
  have hDE : h.normDiagonal ≤ E := h.normDiagonal_le_orbitCentralizer.trans inf_le_left
  have hZE : Z ≤ E := inf_le_left.trans (orbitCenter_le_componentOrbit L B)
  have hz : (Z.subgroupOf E).map (QuotientGroup.mk' (center E)) = ⊥ := by
    apply (Subgroup.map_eq_bot_iff _).mpr
    intro x hx
    change QuotientGroup.mk' (center E) x = 1
    apply (QuotientGroup.eq_one_iff x).mpr
    obtain ⟨y,hy,he⟩ := hx.1
    have hey : y = x := Subtype.ext he
    exact hey ▸ hy
  rw [h.orbitCentralizer_eq_normDiagonal_sup_fixedCenter,
    subgroupOf_sup hDE hZE, Subgroup.map_sup, hz, sup_bot_eq]

/-- The diagonal copy of L/Z(L) just constructed lies in the image of the
actual centralizer layer under E → E/Z(E). -/
theorem Hypotheses.componentNormModCenter_range_le_layer_image
    (h : Hypotheses ρ L B a) :
    h.componentNormModCenter.range ≤
      ((diagonalLayer L B a).subgroupOf (componentOrbit L B)).map
        (QuotientGroup.mk' (center (componentOrbit L B))) := by
  rintro _ ⟨x,rfl⟩
  refine ⟨h.componentNormIntoOrbit x, ?_, rfl⟩
  change componentSwapNorm h.component h.moves x ∈ diagonalLayer L B a
  rw [h.diagonalLayer_eq_normDiagonal]
  exact le_componentOrbit _ B ⟨x,rfl⟩

end Representation.QuadraticFourGroup

end
