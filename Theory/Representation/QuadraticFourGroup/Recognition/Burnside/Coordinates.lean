module

public import Mathlib.GroupTheory.Sylow
public import Mathlib.Logic.Equiv.Option
public import Mathlib.Algebra.Field.Basic

/-!
# Coordinates for the Sylow action in Burnside recognition

The projective line is `Option K`, with `none` representing infinity. We
define translations and the reciprocal permutation, interchanging zero and
infinity. Their generated permutation group is a concrete intermediate model;
its identification with the matrix group `PSL₂` in characteristic two is a
separate theorem.

`SylowCoordinates` records coordinates on the actual set of Sylow subgroups,
membership of the generating permutations, and containment of the action
image in the generated group. The equivalence below uses faithfulness of that
actual action. Neither the coordinate construction nor matrix recognition is
assumed as an unconditional result here.

Source: W. Burnside, *On a Class of Groups of Finite Order*, Transactions of
the Cambridge Philosophical Society XVIII (1900), 269–276, especially 274–275.
The complete source is saved at `refs/original/burnside-1900.pdf`.
-/

@[expose] public section

namespace Representation.QuadraticFourGroup.Burnside

open Subgroup

variable (K : Type*) [Field K]

/-- Translation of the finite coordinates, fixing infinity. -/
noncomputable def translation (b : K) : Equiv.Perm (Option K) :=
  (Equiv.addLeft b).optionCongr

@[simp] theorem translation_none (b : K) : translation K b none = none := rfl

@[simp] theorem translation_some (b x : K) :
    translation K b (some x) = some (b + x) := rfl

/-- Reciprocal on nonzero coordinates, interchanging zero and infinity. -/
noncomputable def reciprocal : Equiv.Perm (Option K) := by
  classical
  let f : Option K → Option K
    | none => some 0
    | some x => if x = 0 then none else some x⁻¹
  exact ⟨f, f, by
    rintro (_ | x)
    · simp [f]
    · by_cases hx : x = 0 <;> simp [f, hx], by
    rintro (_ | x)
    · simp [f]
    · by_cases hx : x = 0 <;> simp [f, hx]⟩

@[simp] theorem reciprocal_none : reciprocal K none = some 0 := rfl

@[simp] theorem reciprocal_zero : reciprocal K (some 0) = none := by
  simp [reciprocal]

theorem reciprocal_some {x : K} (hx : x ≠ 0) :
    reciprocal K (some x) = some x⁻¹ := by
  simp [reciprocal, hx]

/-- The concrete permutation group generated by translations and reciprocal. -/
noncomputable def projectiveGroup : Subgroup (Equiv.Perm (Option K)) :=
  closure (Set.range (translation K) ∪ {reciprocal K})

variable {G : Type*} [Group G] {K}

/-- Transport the actual conjugation action on Sylow subgroups to coordinates. -/
noncomputable def sylowActionInCoordinates (e : Sylow 2 G ≃ Option K) :
    G →* Equiv.Perm (Option K) :=
  e.permCongrHom.toMonoidHom.comp (MulAction.toPermHom G (Sylow 2 G))

omit [Field K] in
theorem sylowActionInCoordinates_apply (e : Sylow 2 G ≃ Option K)
    (g : G) (x : Option K) :
    sylowActionInCoordinates e g x = e (g • e.symm x) := rfl

/-- Concrete coordinates to be constructed from the Burnside hypotheses.
The group action in every field is the transported Sylow conjugation action. -/
structure SylowCoordinates (G K : Type*) [Group G] [Field K] where
  points : Sylow 2 G ≃ Option K
  translations_mem : ∀ b : K, translation K b ∈ (sylowActionInCoordinates points).range
  reciprocal_mem : reciprocal K ∈ (sylowActionInCoordinates points).range
  range_le : (sylowActionInCoordinates points).range ≤ projectiveGroup K

namespace SylowCoordinates

variable (C : SylowCoordinates G K)

/-- Membership of both kinds of generators supplies the reverse image inclusion. -/
theorem range_eq : (sylowActionInCoordinates C.points).range = projectiveGroup K := by
  apply le_antisymm C.range_le
  apply (closure_le _).mpr
  intro f hf
  rcases hf with ⟨b, rfl⟩ | hf
  · exact C.translations_mem b
  · exact (Set.mem_singleton_iff.mp hf) ▸ C.reciprocal_mem

/-- A faithful Sylow action with these coordinates is the generated permutation
group. This is conditional transport, not the construction of the coordinates. -/
noncomputable def equiv
    (hinj : Function.Injective (MulAction.toPermHom G (Sylow 2 G))) :
    G ≃* projectiveGroup K :=
  (MonoidHom.ofInjective (f := sylowActionInCoordinates C.points)
    (C.points.permCongrHom.injective.comp hinj)).trans (MulEquiv.subgroupCongr C.range_eq)

end SylowCoordinates
end Representation.QuadraticFourGroup.Burnside

end
