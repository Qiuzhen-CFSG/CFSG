module

public import Theory.Representation.QuadraticFourGroup.Recognition.IrreducibleReduction.Section
public import Theory.Representation.QuadraticFourGroup.Recognition.IrreducibleReduction.Orbit
public import Theory.Representation.QuadraticFourGroup.Recognition.IrreducibleReduction.ProductCover

/-!
# Reduction to faithful irreducible images

This is the group-recognition reduction in GLS, volume 2, Theorem 25.14,
Step 2 (Chapter G, lines 834–861). It reduces the original faithful binary
action to a faithful irreducible action of the generated group with trivial
two-core. The remaining recognition theorem for those actions and the cyclic
odd-Sylow facts for the concrete PSL2 factors are explicit inputs.

First restrict to the subgroup generated by L and B, preserving the actual
orbit quotient. A minimal noncentral invariant subspace supplies an
irreducible section on which L survives. The section's faithful action image
preserves the component, its movement, the full four-group and its trivial
component centralizer. Irreducibility eliminates the image's two-core.

The recognized image gives a perfect central cover of two actual PSL2
factors. Transfer eliminates odd kernels separately on the derived preimages
of the two factors. The full cover kernel is therefore precisely the
original orbit's two-core, giving the required actual quotient equivalence.

`Hypotheses.twoFactorModel_of_irreducible` proves this conditional reduction;
it does not assert the remaining irreducible recognition or tensor theorem.
-/

@[expose] public section
open Subgroup Theory.GroupTheory

namespace Representation.QuadraticFourGroup
universe u v

/-- The remaining recognition problem on faithful irreducible binary actions,
with generation and trivial two-core explicitly required. -/
def IrreducibleRecognition : Prop :=
  ∀ (G V : Type v) [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] (ρ : Representation (ZMod 2) G V) [ρ.IsIrreducible]
    (L B : Subgroup G) (a : G),
    Hypotheses ρ L B a → L ⊔ B = ⊤ → pCore 2 G = ⊥ →
      Nonempty (TwoFactorModel (componentOrbit L B))

/-- Lift the actual image-orbit model through its central section kernel,
using cyclic odd Sylow subgroups of each factor separately. -/
noncomputable def TwoFactorModel.liftComponentImage
    {G H : Type*} [Group G] [Group H] [Finite G] [Finite H]
    {L B : Subgroup G} (hL : IsComponent G L) (f : G →* H)
    (hne : L.map f ≠ ⊥) (hgen : L.map f ⊔ B.map f = ⊤)
    (hcore : pCore 2 H = ⊥)
    (M : TwoFactorModel (componentOrbit (L.map f) (B.map f)))
    (hcyclic : ∀ p [Fact p.Prime], p ≠ 2 → ∀ P : Sylow p (Factor M.n), IsCyclic P) :
    TwoFactorModel (componentOrbit L B) := by
  let := componentOrbit_normal_of_sup_eq_top hgen
  have hEcore : pCore 2 (componentOrbit (L.map f) (B.map f)) = ⊥ :=
    normal_subgroup_twoCore_eq_bot hcore
  have hinj : Function.Injective M.projection :=
    (MonoidHom.ker_eq_bot_iff _).mp (M.ker_projection.trans hEcore)
  let e : componentOrbit (L.map f) (B.map f) ≃* Factor M.n × Factor M.n :=
    MulEquiv.ofBijective M.projection ⟨hinj, M.projection_surjective⟩
  have htcore : pCore 2 (Factor M.n × Factor M.n) = ⊥ := by
    rw [← pCore_map_iso 2 e, hEcore, Subgroup.map_bot]
  let c := M.coverOfComponentImage hL f hne hgen hcore
  have hc : IsPGroup 2 c.toMonoidHom.ker := c.kernel_isTwoGroup_prod hcyclic hcyclic
  have hk : c.toMonoidHom.ker = pCore 2 (componentOrbit L B) := by
    have he := c.toMonoidHom.comap_pCore_of_ker_isPGroup c.surjective hc
    rw [htcore] at he
    exact he
  exact {
    n := M.n
    one_lt := M.one_lt
    quotientEquiv := (QuotientGroup.quotientMulEquivOfEq hk.symm).trans
      (QuotientGroup.quotientKerEquivOfSurjective c.toMonoidHom c.surjective)
  }

/-- GLS2 25.14, Step 2: the irreducible generated case implies the original
group conclusion, with only the stated concrete odd-Sylow family input. -/
theorem Hypotheses.twoFactorModel_of_irreducible
    {G : Type u} {V : Type v} [Group G] [Finite G]
    [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    {ρ : Representation (ZMod 2) G V} {L B : Subgroup G} {a : G}
    (h : Hypotheses ρ L B a)
    (hrec : IrreducibleRecognition.{v})
    (hcyclic : ∀ n, 1 < n → ∀ p [Fact p.Prime], p ≠ 2 →
      ∀ P : Sylow p (Factor n), IsCyclic P) :
    Nonempty (TwoFactorModel (componentOrbit L B)) := by
  let H := L ⊔ B
  let LH := L.subgroupOf H
  let BH := B.subgroupOf H
  let ρH := ρ.comp H.subtype
  have hH : Hypotheses ρH LH BH (⟨a, (le_sup_right : B ≤ H) h.mem⟩ : H) :=
    h.restrictOvergroup le_sup_left le_sup_right
  have hgen : LH ⊔ BH = ⊤ := by
    apply Subgroup.map_injective H.subtype_injective
    change (L.subgroupOf H ⊔ B.subgroupOf H).map H.subtype = _
    rw [Subgroup.map_sup, map_subgroupOf_eq_of_le le_sup_left,
      map_subgroupOf_eq_of_le le_sup_right, ← MonoidHom.range_eq_map, H.range_subtype]
  obtain ⟨U, N, hi, hn⟩ := hH.exists_irreducible_section
  let σ := N.quotientRepresentation
  have hs : IsIrreducibleSection ρH σ := ⟨hi, U, N, ⟨Representation.Equiv.refl _⟩⟩
  obtain ⟨hI, hirr⟩ := hH.irreducibleSection_actionImage σ hs hn
  let := hirr
  let f := BinaryOffender.actionHom σ
  have hgenI : LH.map f ⊔ BH.map f = ⊤ := by
    rw [← Subgroup.map_sup, hgen, ← MonoidHom.range_eq_map]
    exact MonoidHom.range_eq_top.mpr σ.asGroupHom.rangeRestrict_surjective
  have hcore := twoCore_eq_bot_of_faithful_irreducible (BinaryOffender.imageRepresentation σ)
    (BinaryOffender.imageRepresentation_injective σ)
  obtain ⟨M⟩ := hrec (BinaryOffender.actionImage σ) _
    (BinaryOffender.imageRepresentation σ) (LH.map f) (BH.map f)
    (f ⟨a, (le_sup_right : B ≤ H) h.mem⟩) hI hgenI hcore
  let M' := M.liftComponentImage hH.component f hn hgenI hcore (hcyclic M.n M.one_lt)
  exact ⟨{
    n := M'.n
    one_lt := M'.one_lt
    quotientEquiv := (componentOrbitQuotientOvergroupEquiv L B H le_sup_left le_sup_right).symm.trans
      M'.quotientEquiv
  }⟩

end Representation.QuadraticFourGroup
end
