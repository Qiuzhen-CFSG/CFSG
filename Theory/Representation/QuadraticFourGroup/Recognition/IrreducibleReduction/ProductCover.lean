module
public import Theory.Representation.QuadraticFourGroup.Recognition.CentralCover
public import Theory.GroupTheory.Commutator.PerfectQuotient

/-!
# Two-group kernels over a product of perfect factors

For a perfect central cover of K × J, take the derived subgroup of the
preimage of each factor. Each gives a perfect central cover of that single
factor. These two normal derived subgroups generate the original cover:
they supplement the central kernel, which cannot supplement a proper normal
subgroup in a perfect group. The full kernel is therefore generated by the
two individual kernels.

Cyclic odd Sylow subgroups in each factor eliminate odd primes from each
individual kernel by transfer. Their central product is a two-group. No
cyclicity assertion is made about Sylow subgroups of the product K × J.

Source: GLS, volume 2, Theorem 25.14, Step 2 and Lemma 15.12(iv).
The elementary derived-extension calculation is adapted from
`Theory.Alternating.proposition_5_2_4`,
`commutator_isPerfect_of_surjective_of_ker_le_center` (A1, 33.3),
without importing that alternating-group development.
-/

@[expose] public section
open Subgroup
open scoped commutatorElement

namespace PerfectCentralCovering

private theorem commutator_mul_central {E : Type*} [Group E] (kx ky dx dy : E)
    (hkx : kx ∈ center E) (hky : ky ∈ center E) :
    ⁅kx * dx, ky * dy⁆ = ⁅dx, dy⁆ := by
  have hx (z : E) : Commute kx z := (mem_center_iff.mp hkx z).symm
  have hy (z : E) : Commute ky z := (mem_center_iff.mp hky z).symm
  calc
    _ = kx * ⁅dx, ky * dy⁆ * kx⁻¹ * ⁅kx, ky * dy⁆ :=
      commutatorElement_mul_left_eq_conj_mul kx dx (ky * dy)
    _ = ⁅dx, ky * dy⁆ := by
      rw [(hx (ky * dy)).commutator_eq]
      simp [(hx ⁅dx, ky * dy⁆).eq, mul_assoc]
    _ = ⁅dx, ky⁆ * ky * ⁅dx, dy⁆ * ky⁻¹ :=
      commutatorElement_mul_right_eq_mul_conj dx ky dy
    _ = _ := by
      rw [(hy dx).symm.commutator_eq]
      simp [(hy ⁅dx, dy⁆).eq, mul_assoc]

private theorem perfect_derived_of_central_extension
    {E K : Type*} [Group E] [Group K] [Group.IsPerfect K]
    (f : E →* K) (hf : Function.Surjective f) (hc : f.ker ≤ center E) :
    Group.IsPerfect (commutator E) := by
  have hmap : (commutator E).map f = ⊤ := by
    rw [map_commutator_eq, MonoidHom.range_eq_top.mpr hf]
    exact Group.IsPerfect.commutator_eq_top
  have hdecomp (x : E) : ∃ k ∈ f.ker, ∃ d ∈ commutator E, x = k * d := by
    obtain ⟨d, hd, he⟩ := (show f x ∈ (commutator E).map f from hmap ▸ mem_top _)
    refine ⟨x * d⁻¹, ?_, d, hd, by simp⟩
    simp [MonoidHom.mem_ker, map_mul, map_inv, he]
  rw [Subgroup.isPerfect_iff]
  apply le_antisymm (commutator_le_left _ _)
  rw [commutator_eq_closure, Subgroup.closure_le]
  rintro z hz
  obtain ⟨x, y, hxy⟩ := mem_commutatorSet_iff.mp hz
  obtain ⟨kx, hkx, dx, hdx, rfl⟩ := hdecomp x
  obtain ⟨ky, hky, dy, hdy, rfl⟩ := hdecomp y
  rw [← hxy, commutator_mul_central kx ky dx dy (hc hkx) (hc hky)]
  have hx' : dx ∈ closure (commutatorSet E) := by rwa [← commutator_eq_closure]
  have hy' : dy ∈ closure (commutatorSet E) := by rwa [← commutator_eq_closure]
  exact commutator_mem_commutator hx' hy'

private theorem exists_left_factor_cover
    {E K J : Type*} [Group E] [Group K] [Group J]
    (f : Cover E (K × J)) :
    ∃ D : Subgroup E, D.Normal ∧ ∃ c : Cover D K,
      ∀ d : D, f.toMonoidHom d = (c.toMonoidHom d, 1) := by
  let := f.isPerfect
  let : Group.IsPerfect K := Group.IsPerfect.ofSurjective
    (f := (MonoidHom.fst K J).comp f.toMonoidHom) (Prod.fst_surjective.comp f.surjective)
  let A := ((MonoidHom.snd K J).comp f.toMonoidHom).ker
  let a : A →* K := ((MonoidHom.fst K J).comp f.toMonoidHom).comp A.subtype
  have ha : Function.Surjective a := by
    intro k
    obtain ⟨x, hx⟩ := f.surjective (k, 1)
    exact ⟨⟨x, by change (f.toMonoidHom x).2 = 1; rw [hx]⟩,
      congrArg Prod.fst hx⟩
  have hc : a.ker ≤ center A := by
    intro x hx
    have hfx : f.toMonoidHom x = 1 := Prod.ext hx x.property
    apply mem_center_iff.mpr
    intro y
    exact Subtype.ext (mem_center_iff.mp (f.ker_le_center hfx) y)
  let : Group.IsPerfect (commutator A) := perfect_derived_of_central_extension a ha hc
  let D := (commutator A).map A.subtype
  let : Group.IsPerfect D := Group.IsPerfect.map A.subtype
  have hDA : D ≤ A := map_subtype_le _
  let c : D →* K := ((MonoidHom.fst K J).comp f.toMonoidHom).comp D.subtype
  have he (d : D) : f.toMonoidHom d = (c d, 1) := Prod.ext rfl (hDA d.property)
  have hsurj : Function.Surjective c := by
    have hmap : (commutator A).map a = ⊤ := by
      rw [map_commutator_eq, MonoidHom.range_eq_top.mpr ha]
      exact Group.IsPerfect.commutator_eq_top
    intro k
    obtain ⟨d, hd, hdk⟩ := (show k ∈ (commutator A).map a from hmap ▸ mem_top _)
    exact ⟨⟨d, ⟨d, hd, rfl⟩⟩, hdk⟩
  refine ⟨D, inferInstance, ?_⟩
  refine ⟨{ toMonoidHom := c
            surjective := hsurj
            isPerfect := inferInstance
            ker_le_center := ?_ }, he⟩
  intro x hx
  have hfx : f.toMonoidHom x = 1 := by
    rw [he x, show c x = 1 from hx]
    rfl
  apply mem_center_iff.mpr
  intro y
  exact Subtype.ext (mem_center_iff.mp (f.ker_le_center hfx) y)

/-- Cyclic odd Sylows in each direct factor force a two-group central kernel. -/
theorem Cover.kernel_isTwoGroup_prod
    {E K J : Type*} [Group E] [Group K] [Group J] [Finite E] [Finite K] [Finite J]
    (f : Cover E (K × J))
    (hK : ∀ p [Fact p.Prime], p ≠ 2 → ∀ P : Sylow p K, IsCyclic P)
    (hJ : ∀ p [Fact p.Prime], p ≠ 2 → ∀ P : Sylow p J, IsCyclic P) :
    IsPGroup 2 f.toMonoidHom.ker := by
  let := f.isPerfect
  obtain ⟨D, hD, c, hc⟩ := exists_left_factor_cover f
  let := hD
  let fs : Cover E (J × K) := {
    toMonoidHom := (MulEquiv.prodComm : K × J ≃* J × K).toMonoidHom.comp f.toMonoidHom
    surjective := (MulEquiv.prodComm : K × J ≃* J × K).surjective.comp f.surjective
    isPerfect := inferInstance
    ker_le_center := by
      intro x hx
      exact f.ker_le_center ((MulEquiv.prodComm : K × J ≃* J × K).injective
        (hx.trans (MulEquiv.prodComm : K × J ≃* J × K).map_one.symm))
  }
  obtain ⟨D', hD', c', hc'⟩ := exists_left_factor_cover fs
  let := hD'
  have hc'' (d : D') : f.toMonoidHom d = (1, c'.toMonoidHom d) := by
    have he := congrArg Prod.swap (hc' d)
    exact he
  have hgen : D ⊔ D' = ⊤ := by
    have hsup : (D ⊔ D') ⊔ center E = ⊤ := by
      apply top_unique
      intro x _
      obtain ⟨d, hd⟩ := c.surjective (f.toMonoidHom x).1
      obtain ⟨d', hd'⟩ := c'.surjective (f.toMonoidHom x).2
      have hfd : f.toMonoidHom ((d : E) * d') = f.toMonoidHom x := by
        rw [map_mul, hc, hc'', hd, hd']
        ext <;> simp
      have hk : x * ((d : E) * d')⁻¹ ∈ center E := by
        apply f.ker_le_center
        change f.toMonoidHom (x * ((d : E) * d')⁻¹) = 1
        rw [map_mul, map_inv, hfd, mul_inv_cancel]
      have hm : (d : E) * d' ∈ D ⊔ D' := mul_mem_sup d.property d'.property
      have hx := ((D ⊔ D') ⊔ center E).mul_mem
        ((le_sup_right : center E ≤ (D ⊔ D') ⊔ center E) hk)
        ((le_sup_left : D ⊔ D' ≤ (D ⊔ D') ⊔ center E) hm)
      simpa only [mul_assoc, inv_mul_cancel, mul_one] using hx
    have hle := Subgroup.Normal.commutator_le_of_self_sup_commutative_eq_top hsup
      (inferInstance : IsMulCommutative (center E))
    rw [Group.IsPerfect.commutator_eq_top] at hle
    exact top_unique hle
  let N := c.toMonoidHom.ker.map D.subtype
  let N' := c'.toMonoidHom.ker.map D'.subtype
  have hN : IsPGroup 2 N := (c.kernel_isTwoGroup hK).map D.subtype
  have hN' : IsPGroup 2 N' := (c'.kernel_isTwoGroup hJ).map D'.subtype
  have hN'central : N' ≤ center E := by
    rintro x ⟨d, hd, rfl⟩
    apply f.ker_le_center
    change f.toMonoidHom d = 1
    rw [hc'' d, show c'.toMonoidHom d = 1 from hd]
    rfl
  let : N'.Normal := ⟨fun x hx g => by
    have he : g * x * g⁻¹ = x := by
      rw [mem_center_iff.mp (hN'central hx) g]
      simp [mul_assoc]
    rwa [he]⟩
  apply (IsPGroup.to_sup_of_normal_right hN hN').to_le
  intro x hx
  obtain ⟨d, hd, d', hd', he⟩ := mem_sup_of_normal_right.mp
    (show x ∈ D ⊔ D' from hgen ▸ mem_top x)
  have hfx : (c.toMonoidHom ⟨d, hd⟩, c'.toMonoidHom ⟨d', hd'⟩) = 1 := by
    have hh := congrArg f.toMonoidHom he
    rw [map_mul, hc ⟨d, hd⟩, hc'' ⟨d', hd'⟩, hx] at hh
    simpa using hh
  have hdN : d ∈ N := ⟨⟨d, hd⟩, congrArg Prod.fst hfx, rfl⟩
  have hdN' : d' ∈ N' := ⟨⟨d', hd'⟩, congrArg Prod.snd hfx, rfl⟩
  exact he ▸ mul_mem_sup hdN hdN'

end PerfectCentralCovering
end
