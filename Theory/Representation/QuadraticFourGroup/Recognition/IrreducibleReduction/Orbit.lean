module
public import Theory.Representation.QuadraticFourGroup.Recognition.IrreducibleReduction.Image
public import Theory.Representation.QuadraticFourGroup.Recognition.CentralCover

/-!
# Central covers of the actual component orbit

A surviving component centralizes a homomorphism's kernel, and so do all its
conjugates. Restricting the homomorphism to the actual component orbit is
therefore a perfect central cover onto the actual image orbit.

When the image is generated by the component and the four-group, its orbit
is normal. A trivial ambient two-core then makes the orbit's intrinsic
two-core trivial. An image model consequently gives a perfect central cover
of the two concrete factors, ready for the factor-by-factor kernel argument.

Source: GLS, volume 2, Theorem 25.14, Step 2. All normality statements used
here are relative to the generated group until generation is established.
-/

@[expose] public section
open Subgroup Theory.GroupTheory

namespace Theory.GroupTheory
variable {G H : Type*} [Group G] [Group H]

/-- The homomorphism induced on the actual orbits by a group homomorphism. -/
noncomputable def componentOrbitHom (L B : Subgroup G) (f : G →* H) :
    componentOrbit L B →* componentOrbit (L.map f) (B.map f) :=
  (MulEquiv.subgroupCongr (componentOrbit_map L B f)).toMonoidHom.comp
    (f.subgroupMap (componentOrbit L B))

/-- The orbit map agrees with the original homomorphism on elements. -/
@[simp] theorem componentOrbitHom_apply (L B : Subgroup G) (f : G →* H)
    (x : componentOrbit L B) : (componentOrbitHom L B f x : H) = f x := rfl

/-- The induced orbit map is onto, even if the original homomorphism is not. -/
theorem componentOrbitHom_surjective (L B : Subgroup G) (f : G →* H) :
    Function.Surjective (componentOrbitHom L B f) :=
  (MulEquiv.subgroupCongr (componentOrbit_map L B f)).surjective.comp
    (f.subgroupMap_surjective _)

/-- A surviving component makes the induced orbit map a perfect central cover. -/
noncomputable def IsComponent.orbitCover {L : Subgroup G} (hL : IsComponent G L)
    (B : Subgroup G) (f : G →* H) (hne : L.map f ≠ ⊥) :
    PerfectCentralCovering.Cover (componentOrbit L B) (componentOrbit (L.map f) (B.map f)) where
  toMonoidHom := componentOrbitHom L B f
  surjective := componentOrbitHom_surjective L B f
  isPerfect := hL.orbit_isPerfect B
  ker_le_center := by
    have hc : ⁅L, f.ker⁆ = ⊥ := (hL.normal_dichotomy f.ker).resolve_left
      (fun hk => hne ((Subgroup.map_eq_bot_iff L).mpr hk))
    have hE : componentOrbit L B ≤ centralizer (f.ker : Set G) :=
      iSup_conjugates_le_centralizer L B f.ker (by rw [normalizer_eq_top]; exact le_top) hc
    intro x hx
    apply mem_center_iff.mpr
    intro y
    apply Subtype.ext
    have hx' : (x : G) ∈ f.ker := congrArg Subtype.val hx
    exact (mem_centralizer_iff.mp (hE y.property) x hx').symm

/-- Generation makes the relatively normal component orbit ambient normal. -/
theorem componentOrbit_normal_of_sup_eq_top {L B : Subgroup G} (hgen : L ⊔ B = ⊤) :
    (componentOrbit L B).Normal := by
  have hn := (normal_subgroupOf_iff_le_normalizer (componentOrbit_le_sup L B)).mp
    (componentOrbit_normal_subgroupOf_sup L B)
  rw [hgen] at hn
  exact normalizer_eq_top_iff.mp (top_unique hn)

/-- A normal subgroup of a group with trivial two-core has trivial two-core. -/
theorem normal_subgroup_twoCore_eq_bot {E : Subgroup G} [E.Normal]
    (hcore : pCore 2 G = ⊥) : pCore 2 E = ⊥ := by
  have hn : ((pCore 2 E).map E.subtype).Normal := inferInstance
  have hle : (pCore 2 E).map E.subtype ≤ pCore 2 G :=
    le_sSup ⟨hn, pCore_isPGroup.map E.subtype⟩
  rw [hcore] at hle
  exact (Subgroup.map_eq_bot_iff _).mp (le_bot_iff.mp hle) |>.trans
    ((MonoidHom.ker_eq_bot_iff E.subtype).mpr E.subtype_injective).le |> le_bot_iff.mp

end Theory.GroupTheory

namespace Representation.QuadraticFourGroup
variable {G H : Type*} [Group G] [Group H]

/-- An image model gives a central cover of its two concrete factors. -/
noncomputable def TwoFactorModel.coverOfComponentImage
    {L B : Subgroup G} (hL : IsComponent G L) (f : G →* H)
    (hne : L.map f ≠ ⊥) (hgen : L.map f ⊔ B.map f = ⊤)
    (hcore : pCore 2 H = ⊥)
    (M : TwoFactorModel (componentOrbit (L.map f) (B.map f))) :
    PerfectCentralCovering.Cover (componentOrbit L B) (Factor M.n × Factor M.n) where
  toMonoidHom := M.projection.comp (componentOrbitHom L B f)
  surjective := M.projection_surjective.comp (componentOrbitHom_surjective L B f)
  isPerfect := hL.orbit_isPerfect B
  ker_le_center := by
    let := componentOrbit_normal_of_sup_eq_top hgen
    have hEcore : pCore 2 (componentOrbit (L.map f) (B.map f)) = ⊥ :=
      normal_subgroup_twoCore_eq_bot hcore
    have hinj : Function.Injective M.projection :=
      (MonoidHom.ker_eq_bot_iff _).mp (M.ker_projection.trans hEcore)
    intro x hx
    apply (hL.orbitCover B f hne).ker_le_center
    exact hinj (hx.trans M.projection.map_one.symm)

end Representation.QuadraticFourGroup
end
