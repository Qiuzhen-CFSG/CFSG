module

public import Theory.Representation.QuadraticFourGroup.Models
public import Theory.Representation.QuadraticFourGroup.Recognition.Burnside.Action
public import Theory.Representation.QuadraticFourGroup.Recognition.Burnside.Coordinates
public import Theory.Representation.QuadraticFourGroup.Recognition.Burnside.FieldCoordinates
public import Theory.Representation.QuadraticFourGroup.Recognition.Burnside.MatrixComparison

/-!
# Burnside recognition of the binary projective special linear groups

The theorem `InvolutionOddSpectrum.recognition` identifies a finite simple perfect group with an
involution, all of whose elements have order two or odd order, as
`PSL(2, GaloisField 2 n)` for `n > 1`.

`Action` proves the faithful doubly transitive Sylow action and its regular
elementary abelian root groups. `FieldCoordinates` constructs concrete field
coordinates on that action, with image generated by translations and reciprocal.
`MatrixComparison` identifies this image with the literal central quotient of
SL₂. Composing these equivalences discharges both inputs of the retained
conditional assembly lemma. The explicit involution hypothesis supplies even
order without invoking odd-order solvability.

Source: Burnside, *On a Class of Groups of Finite Order* (1900), 269–276,
`refs/original/burnside-1900.pdf`, especially the uniqueness argument on
pp. 274–275. This is the recognition cited in GLS2, Theorem 25.14, Step 3,
`refs/KGroup/GLS2/ChapterG.tex`.
-/

namespace Theory.GroupTheory.InvolutionOddSpectrum

open Representation.QuadraticFourGroup

/-- Conditional assembly from coordinates on the actual Sylow action and
the concrete permutation-to-matrix comparison. Both inputs must be constructed
before using this as the Burnside recognition theorem. -/
public theorem recognition_of_coordinates
    {G : Type*} [Group G] [Finite G] [IsSimpleGroup G] [Group.IsPerfect G]
    (hG : InvolutionOddSpectrum G) (t : G) (ht : orderOf t = 2)
    {n : ℕ} (hn : 1 < n) (C : Burnside.SylowCoordinates G (GaloisField 2 n))
    (e : Burnside.projectiveGroup (GaloisField 2 n) ≃* Factor n) :
    ∃ m : ℕ, 1 < m ∧ Nonempty (G ≃* Factor m) :=
  ⟨n, hn, ⟨(C.equiv (hG.sylowAction_faithful t ht)).trans e⟩⟩

/-- Burnside recognition: a finite simple perfect group with an involution
and no other even element orders is a binary projective special linear group.
Both the Sylow-action coordinates and the comparison with the actual matrix
quotient are constructed from the stated hypotheses. -/
public theorem recognition
    {G : Type*} [Group G] [Finite G] [IsSimpleGroup G] [Group.IsPerfect G]
    (hG : InvolutionOddSpectrum G) (t : G) (ht : orderOf t = 2) :
    ∃ n : ℕ, 1 < n ∧ Nonempty (G ≃* Factor n) := by
  obtain ⟨n, hn, ⟨C⟩⟩ := Burnside.exists_sylowCoordinates hG t ht
  exact hG.recognition_of_coordinates t ht hn C (Burnside.projectiveGroupEquivFactor n)

end Theory.GroupTheory.InvolutionOddSpectrum
