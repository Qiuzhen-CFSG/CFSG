module

public import Theory.Representation.RegularCyclicNormalClosure.Defs

/-!
# Displacement spans and conjugation

Displacements commute with simultaneous conjugation of the actor and transport
of the subspace. A decomposition into fixed and moved spaces implies that the
moved space is generated by its own displacements and that its dimension is
the fixed-space codimension. These elementary identities support both branches
of the regular cyclic normal-closure argument used in Aschbacher–Smith E.6.24,
printed p.255, citing Aschbacher, J. Algebra 70 (1981), 10.4.
-/

public section

namespace Representation.RegularCyclicNormalClosure
open Subgroup BinaryOffender
variable {A W : Type*} [Group A] [AddCommGroup W] [Module (ZMod 2) W]
  (ρ : Representation (ZMod 2) A W)

/-- Enlarging the actors and vectors enlarges the displacement span. -/
theorem displacementSpan_mono {C D : Subgroup A} {S T : Submodule (ZMod 2) W}
    (hC : C ≤ D) (hS : S ≤ T) : displacementSpan ρ C S ≤ displacementSpan ρ D T := by
  apply Submodule.span_mono
  rintro _ ⟨c, hc, v, hv, rfl⟩
  exact ⟨c, hC hc, v, hS hv, rfl⟩

/-- A complementary moved space is generated by its own displacements. -/
theorem displacementSpan_self_of_split (C : Subgroup A)
    (h : IsCompl (fixedSpace ρ C) (displacementSpan ρ C ⊤)) :
    displacementSpan ρ C (displacementSpan ρ C ⊤) = displacementSpan ρ C ⊤ := by
  apply le_antisymm (displacementSpan_mono ρ le_rfl le_top)
  apply Submodule.span_le.mpr
  rintro _ ⟨c, hc, v, _, rfl⟩
  obtain ⟨u, hu, w, hw, rfl⟩ := Submodule.mem_sup.mp
    (show v ∈ fixedSpace ρ C ⊔ displacementSpan ρ C ⊤ by rw [h.sup_eq_top]; trivial)
  have he : ρ c (u + w) - (u + w) = ρ c w - w := by
    rw [map_add, show ρ c u = u from hu ⟨c, hc⟩]
    abel
  rw [he]
  exact Submodule.subset_span ⟨c, hc, w, hw, rfl⟩

/-- Conjugating actors and transporting vectors transports their displacement span. -/
theorem displacementSpan_conjugate (C : Subgroup A) (S : Submodule (ZMod 2) W) (a : A) :
    displacementSpan ρ (C.map (MulAut.conj a).toMonoidHom) (S.map (ρ a)) =
      (displacementSpan ρ C S).map (ρ a) := by
  have he (c : A) (v : W) :
      ρ (a * c * a⁻¹) (ρ a v) - ρ a v = ρ a (ρ c v - v) := by
    rw [map_sub]
    congr 1
    simp only [← Module.End.mul_apply, ← map_mul, mul_assoc, inv_mul_cancel, mul_one]
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨_, ⟨c, hc, rfl⟩, _, ⟨v, hv, rfl⟩, rfl⟩
    exact ⟨ρ c v - v, Submodule.subset_span ⟨c, hc, v, hv, rfl⟩, (he c v).symm⟩
  · apply Submodule.map_le_iff_le_comap.mpr
    apply Submodule.span_le.mpr
    rintro _ ⟨c, hc, v, hv, rfl⟩
    change ρ a (ρ c v - v) ∈ displacementSpan ρ (C.map (MulAut.conj a).toMonoidHom) (S.map (ρ a))
    rw [← he]
    exact Submodule.subset_span ⟨a * c * a⁻¹, ⟨c, hc, rfl⟩, ρ a v, ⟨v, hv, rfl⟩, rfl⟩

/-- Every group element acts surjectively on the representation space. -/
theorem map_top_action (a : A) : (⊤ : Submodule (ZMod 2) W).map (ρ a) = ⊤ := by
  apply top_unique
  intro v _
  refine ⟨ρ a⁻¹ v, by trivial, ?_⟩
  simp only [← Module.End.mul_apply, ← map_mul, mul_inv_cancel, map_one, Module.End.one_apply]

/-- The normalizer of the actor preserves its moved space. -/
theorem displacementSpan_map_of_normalized (C : Subgroup A) (a : A)
    (ha : C.map (MulAut.conj a).toMonoidHom = C) :
    (displacementSpan ρ C ⊤).map (ρ a) = displacementSpan ρ C ⊤ := by
  rw [← displacementSpan_conjugate, map_top_action, ha]

/-- Complementarity identifies moved dimension and fixed-space codimension. -/
theorem moved_finrank_eq_fixedCodim [FiniteDimensional (ZMod 2) W]
    {C : Subgroup A} (h : IsCompl (fixedSpace ρ C) (displacementSpan ρ C ⊤)) :
    Module.finrank (ZMod 2) (displacementSpan ρ C ⊤) = fixedCodim ρ C := by
  have hs := Submodule.finrank_add_eq_of_isCompl h
  have hf := fixedCodim_add_finrank ρ C
  omega

end Representation.RegularCyclicNormalClosure
