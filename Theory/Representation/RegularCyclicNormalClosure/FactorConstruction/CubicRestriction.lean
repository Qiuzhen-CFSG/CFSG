module

public import Theory.Representation.RegularCyclicNormalClosure.FactorConstruction.PairSupport

/-!
# Restricting cubic displacements to a supporting space

For an actor q with q³ = 1 in characteristic two, a displacement y has
the preimage qy under q−1. Consequently restricting to any invariant space
containing all displacements preserves the whole displacement range. This
includes nonsplit ambient extensions and avoids assuming complete reducibility
of the group generated by a pair.

Source application: the four-dimensional cubic-pair reduction for
Aschbacher--Smith E.6.24, printed p.255.
-/

public section
open Module Subgroup Representation.BinaryOffender
namespace Representation.RegularCyclicNormalClosure
open FactorConstruction
variable {A W : Type*} [Group A] [AddCommGroup W] [Module (ZMod 2) W]
  {ρ : Representation (ZMod 2) A W}

private theorem binary_neg (v : W) : -v = v := by
  have he : (1 + 1 : ZMod 2) = 0 := by decide
  have hh : v + v = 0 := by
    simpa only [add_smul, one_smul, zero_smul] using congrArg (fun r => r • v) he
  exact neg_eq_iff_add_eq_zero.mpr hh

private theorem cubic_displacement (q : A) (hq : q ^ 3 = 1) (v : W) :
    ρ q (ρ q (ρ q v - v)) - ρ q (ρ q v - v) = ρ q v - v := by
  have hq3 : ρ q (ρ q (ρ q v)) = v := by
    have hh := congrArg (fun a : A => ρ a v) hq
    simpa only [pow_succ, pow_zero, one_mul, map_mul, Module.End.mul_apply,
      map_one, Module.End.one_apply] using hh
  simp only [map_sub, hq3]
  simp only [sub_eq_add_neg, binary_neg]
  have hh : ρ q (ρ q v) + ρ q (ρ q v) = 0 :=
    (neg_eq_iff_add_eq_zero.mp (binary_neg (ρ q (ρ q v))))
  calc
    _ = (ρ q (ρ q v) + ρ q (ρ q v)) + (ρ q v + v) := by abel
    _ = _ := by rw [hh, zero_add]

/-- Restriction to a supporting space preserves the displacement range
of a cubic actor in the actual subgroup acting trivially modulo that space. -/
theorem cubic_range_onQuotientFixer (T : Submodule (ZMod 2) W)
    (q : quotientFixer ρ T) (hq : q ^ 3 = 1) :
    ((onQuotientFixer ρ T q - LinearMap.id).range).map T.subtype =
      (ρ (q : A) - LinearMap.id).range := by
  ext y
  constructor
  · rintro ⟨_, ⟨v, rfl⟩, rfl⟩
    exact ⟨v.val, rfl⟩
  · rintro ⟨v, rfl⟩
    let y : T := ⟨ρ (q : A) v - v, q.property v⟩
    let w : T := onQuotientFixer ρ T q y
    refine ⟨onQuotientFixer ρ T q w - w, ⟨w, rfl⟩, ?_⟩
    change ρ (q : A) (ρ (q : A) (ρ (q : A) v - v)) -
      ρ (q : A) (ρ (q : A) v - v) = ρ (q : A) v - v
    exact cubic_displacement (ρ := ρ) (q : A) (congrArg Subtype.val hq) v

end Representation.RegularCyclicNormalClosure
