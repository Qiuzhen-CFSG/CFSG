module
public import Theory.Representation.BinaryThreeHomSaturation
public import Theory.ElementaryAbelian.VectorSpace
public import Mathlib.LinearAlgebra.Basis.Defs
public import Mathlib.LinearAlgebra.StdBasis
public import Mathlib.Algebra.Group.Subgroup.Lattice
public import Mathlib.GroupTheory.Index

/-!
# Full binary group-valued Hom images from a marked dual action

Every homomorphism from the additive binary three-space to an elementary
two-group is F₂-linear. Transporting its image through this exact equivalence
reduces saturation to the row-isolation theorem. The subgroup generated by
all row evaluations, or equivalently the supremum of their ranges, supplies
the required evaluation span. No commutativity or finiteness assumption on
the group of rows is needed.

The full Hom group has order |T|³. Thus for a target of order four, the
actual row map has kernel index 64. Source application: Meierfrankenfeld–
Stellmacher (1993), (4.5), printed pp.895 and 899, on the literal core
commutator rows into its central H-layer.
-/

@[expose] public section
open scoped IsMulCommutative
namespace Representation.BinaryThreeHom

/-- Every group homomorphism from a binary vector group to an elementary
two-group is linear, compatibly with pointwise multiplication. -/
def homEquivLinear {T : Type*} [Group T] [IsElementaryAbelian 2 T] :
    (Multiplicative W →* T) ≃* Multiplicative (W →ₗ[ZMod 2] Additive T) where
  toFun f := Multiplicative.ofAdd (f.toAdditiveRight.toZModLinearMap 2)
  invFun f := MonoidHom.toAdditiveRight.symm f.toAdd.toAddMonoidHom
  left_inv f := rfl
  right_inv f := by apply Multiplicative.toAdd.injective; apply LinearMap.ext; intro v; rfl
  map_mul' f g := by apply Multiplicative.toAdd.injective; apply LinearMap.ext; intro v; rfl

@[simp] theorem homEquivLinear_apply {T : Type*} [Group T] [IsElementaryAbelian 2 T]
    (f : Multiplicative W →* T) (v : W) :
    ((homEquivLinear (T := T)) f).toAdd v = Additive.ofMul (f (Multiplicative.ofAdd v)) := rfl

/-- The full Hom group has one independent target value for each of the three rows. -/
theorem card_hom {T : Type*} [Group T] [IsElementaryAbelian 2 T] :
    Nat.card (Multiplicative W →* T) = Nat.card T ^ 3 := by
  rw [Nat.card_congr (homEquivLinear (T := T)).toEquiv]
  change Nat.card (W →ₗ[ZMod 2] Additive T) = _
  rw [Nat.card_congr ((Pi.basisFun (ZMod 2) (Fin 3)).constr (ZMod 2)).symm.toEquiv,
    Nat.card_fun, Nat.card_fin]
  rfl

/-- Stability under the dual action and generation by all evaluations force
an actual group-valued row map to be onto the full Hom group. -/
theorem surjective_of_dual_evaluation_closure
    {B T : Type*} [Group B] [Group T] [IsElementaryAbelian 2 T]
    (row : B →* (Multiplicative W →* T))
    (hstable : ∀ (g : S) (b : B), ∃ c : B,
      ∀ v : W, row c (Multiplicative.ofAdd v) = row b (Multiplicative.ofAdd (dualAction g v)))
    (hgen : Subgroup.closure {t | ∃ b : B, ∃ v : W, row b (Multiplicative.ofAdd v) = t} = ⊤) :
    Function.Surjective row := by
  let r := (homEquivLinear (T := T)).toMonoidHom.comp row
  let U : Submodule (ZMod 2) (W →ₗ[ZMod 2] Additive T) :=
    AddSubgroup.toZModSubmodule 2 r.range.toAddSubgroup
  have hU (g : S) (f : W →ₗ[ZMod 2] Additive T) (hf : f ∈ U) : f.comp (dualAction g) ∈ U := by
    obtain ⟨b,hb⟩ := hf
    obtain ⟨c,hc⟩ := hstable g b
    refine ⟨c, ?_⟩
    apply Multiplicative.toAdd.injective
    apply LinearMap.ext
    intro v
    change Additive.ofMul (row c (Multiplicative.ofAdd v)) = f (dualAction g v)
    rw [hc]
    exact congrArg (fun l => l.toAdd (dualAction g v)) hb
  have hspan : Submodule.span (ZMod 2) {t | ∃ f ∈ U, ∃ v : W, f v = t} = ⊤ := by
    let Z := Submodule.span (ZMod 2) {t | ∃ f ∈ U, ∃ v : W, f v = t}
    have hle : Subgroup.closure {t | ∃ b : B, ∃ v : W, row b (Multiplicative.ofAdd v) = t} ≤
        Z.toAddSubgroup.toSubgroup := by
      apply (Subgroup.closure_le _).mpr
      rintro t ⟨b,v,rfl⟩
      change Additive.ofMul (row b (Multiplicative.ofAdd v)) ∈ Z
      exact Submodule.subset_span ⟨(r b).toAdd, ⟨b,rfl⟩,v,rfl⟩
    apply top_unique
    intro t _
    exact hle (hgen ▸ (show t.toMul ∈ (⊤ : Subgroup T) from Subgroup.mem_top _))
  have he : U = ⊤ := eq_top_of_dual_evaluation_span U hU hspan
  intro f
  have hf : ((homEquivLinear (T := T)) f).toAdd ∈ U := by rw [he]; exact Submodule.mem_top
  obtain ⟨b,hb⟩ := hf
  exact ⟨b, (homEquivLinear (T := T)).injective hb⟩

/-- For a central four-group target, the full commutator row has kernel index 64. -/
theorem index_ker_eq_sixtyFour_of_dual_evaluation_closure
    {B T : Type*} [Group B] [Group T] [IsElementaryAbelian 2 T]
    (row : B →* (Multiplicative W →* T)) (hT : Nat.card T = 4)
    (hstable : ∀ (g : S) (b : B), ∃ c : B,
      ∀ v : W, row c (Multiplicative.ofAdd v) = row b (Multiplicative.ofAdd (dualAction g v)))
    (hgen : Subgroup.closure {t | ∃ b : B, ∃ v : W, row b (Multiplicative.ofAdd v) = t} = ⊤) :
    row.ker.index = 64 := by
  rw [Subgroup.index_ker, MonoidHom.range_eq_top.mpr
    (surjective_of_dual_evaluation_closure row hstable hgen), Subgroup.card_top, card_hom, hT]
  norm_num

/-- Generating the target by the row ranges is exactly the evaluation
hypothesis needed for saturation. -/
theorem surjective_of_dual_evaluation_ranges
    {B T : Type*} [Group B] [Group T] [IsElementaryAbelian 2 T]
    (row : B →* (Multiplicative W →* T))
    (hstable : ∀ (g : S) (b : B), ∃ c : B,
      ∀ v : W, row c (Multiplicative.ofAdd v) = row b (Multiplicative.ofAdd (dualAction g v)))
    (hgen : (⨆ b : B, (row b).range) = ⊤) : Function.Surjective row := by
  apply surjective_of_dual_evaluation_closure row hstable
  apply top_unique
  rw [← hgen]
  apply iSup_le
  intro b t ht
  obtain ⟨v,rfl⟩ := ht
  exact Subgroup.subset_closure ⟨b,v.toAdd,rfl⟩

/-- The range-generation formulation of the actual kernel-index calculation. -/
theorem index_ker_eq_sixtyFour_of_dual_evaluation_ranges
    {B T : Type*} [Group B] [Group T] [IsElementaryAbelian 2 T]
    (row : B →* (Multiplicative W →* T)) (hT : Nat.card T = 4)
    (hstable : ∀ (g : S) (b : B), ∃ c : B,
      ∀ v : W, row c (Multiplicative.ofAdd v) = row b (Multiplicative.ofAdd (dualAction g v)))
    (hgen : (⨆ b : B, (row b).range) = ⊤) : row.ker.index = 64 := by
  rw [Subgroup.index_ker, MonoidHom.range_eq_top.mpr
    (surjective_of_dual_evaluation_ranges row hstable hgen), Subgroup.card_top, card_hom, hT]
  norm_num
end Representation.BinaryThreeHom
