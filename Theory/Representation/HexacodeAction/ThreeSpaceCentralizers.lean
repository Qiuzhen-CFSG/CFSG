module

public import Theory.Representation.HexacodeAction.SmallFixedSpace

/-!
# Pointwise stabilizers of binary three-spaces in the hexacode

A three-space fixed by a nonidentity even actor lies in a scalar fixed
four-space. It meets a full-weight field line in that four-space. Thus a
three-space without full-weight words has trivial even pointwise stabilizer.
Any nontrivial full pointwise stabilizer is consequently generated by one
odd involution, whose fixed space is exactly the original three-space.

Source: Aschbacher--Smith, 12.7.10(4--5), printed pp.842--843.
The coordinate-six and full-weight-plane permutation markings are not
identified here.
-/

public noncomputable section
open Atlas.Codes Subgroup Representation.BinaryOffender
namespace Representation.Hexacode

/-- An even actor fixing three binary dimensions fixes a full-weight word
inside the specified three-space. -/
theorem full_weight_mem_of_even_fixed_threeSpace (g : HexAutomorphisms)
    (hg : g ≠ 1) (he : hexSign g = 1) (W : Submodule Bit hexacode)
    (hd : Module.finrank Bit W = 3) (hfix : ∀ w ∈ W, action g w = w) :
    ∃ w ∈ W, hammingNorm (w : HexWord) = 6 := by
  let x : HexEvenAutomorphisms := ⟨g, he⟩
  let V := fixedSpace evenAction (zpowers x)
  have hWV : W ≤ V := by
    intro w hw
    exact (mem_fixedSpace_zpowers_iff evenAction x w).mpr (hfix w hw)
  have hx : zpowers x ≠ ⊥ := by
    intro hh
    have hx1 : x = 1 := mem_bot.mp (hh ▸ mem_zpowers x)
    exact hg (congrArg (fun y : HexEvenAutomorphisms => y.val) hx1)
  have hs := ThompsonOffenders.fixedSpace_scalar_stable (zpowers x)
  have hparity := scalarSubmodule_finrank V hs
  have hcd := ThompsonOffenders.fixedCodim_ge_two (zpowers x) hx
  have hsum := fixedCodim_add_finrank evenAction (zpowers x)
  have hlo := Submodule.finrank_mono hWV
  rw [hexacode_finrank] at hsum
  change fixedCodim evenAction (zpowers x) + Module.finrank Bit V = 6 at hsum
  rw [hd] at hlo
  have hV : Module.finrank Bit V = 4 := by omega
  obtain ⟨v, hv, hw⟩ := full_weight_mem_of_large_fixed_subspace g hg V (by omega)
    (fun w hw => (mem_fixedSpace_zpowers_iff evenAction x w).mp hw)
  have hv0 : v ≠ 0 := by intro hh; simp [hh] at hw
  have hev : 2 ∣ (Set.range fun a : HexEvenAutomorphisms => evenAction a v).ncard := by
    rw [evenAction_orbit_card v hv0]
    norm_num [hw]
  let P := (Submodule.span F {v}).restrictScalars Bit
  have hP : IsFullWeightScalarPlane P :=
    evenAction_full_weight_point_of_even_orbit v hv0 hev
  have hPV : P ≤ V := by
    intro w hw
    obtain ⟨r, rfl⟩ := Submodule.mem_span_singleton.mp hw
    apply (mem_fixedSpace_zpowers_iff evenAction x _).mpr
    change action g (r • v) = r • v
    have hvfix : action g v = v := (mem_fixedSpace_zpowers_iff evenAction x v).mp hv
    rw [action_even_smul g he, hvfix]
  have hne : W ⊓ P ≠ ⊥ := by
    intro hb
    have heq := Submodule.finrank_sup_add_finrank_inf_eq W P
    have hbound := Submodule.finrank_mono (sup_le hWV hPV)
    rw [hb, finrank_bot, add_zero, hd, hP.1] at heq
    rw [hV] at hbound
    omega
  obtain ⟨w, hw, hw0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hne
  exact ⟨w, hw.1, hP.2.2 ⟨w, hw.2⟩ (fun hh => hw0 (congrArg Subtype.val hh))⟩

/-- If a binary three-space has no full-weight words, every nontrivial
pointwise actor generates its entire pointwise stabilizer and is an odd
involution with precisely that fixed space. -/
theorem threeSpace_pointwise_kernel (W : Submodule Bit hexacode)
    (hd : Module.finrank Bit W = 3)
    (hfull : ∀ w ∈ W, hammingNorm (w : HexWord) ≠ 6)
    (g : HexAutomorphisms) (hg : g ≠ 1) (hfix : ∀ w ∈ W, action g w = w) :
    hexSign g = -1 ∧ g ^ 2 = 1 ∧ fixedSpace action (zpowers g) = W ∧
      subspaceKernel action W ⊤ = zpowers g := by
  let I := subspaceKernel action W ⊤
  have heven (x : HexAutomorphisms) (hx : x ∈ I) (he : hexSign x = 1) : x = 1 := by
    by_contra hn
    obtain ⟨w, hw, hh⟩ := full_weight_mem_of_even_fixed_threeSpace x hn he W hd hx.2
    exact hfull w hw hh
  have hgI : g ∈ I := ⟨mem_top _, hfix⟩
  have ho : hexSign g = -1 := by
    rcases Int.units_eq_one_or (hexSign g) with hh | hh
    · exact (hg (heven g hgI hh)).elim
    · exact hh
  have h2 : g ^ 2 = 1 := heven _ (I.pow_mem hgI 2) (by simp [map_pow, ho])
  have hdim : Module.finrank Bit (fixedSpace action (zpowers g)) = 3 := by
    have hh := fixedCodim_add_finrank action (zpowers g)
    rw [ThompsonOffenders.odd_involution_fixedCodim g ho h2, hexacode_finrank] at hh
    change 3 + Module.finrank Bit (fixedSpace action (zpowers g)) = 6 at hh
    omega
  have hW : W = fixedSpace action (zpowers g) :=
    Submodule.eq_of_le_of_finrank_eq
      (fun w hw => (mem_fixedSpace_zpowers_iff action g w).mpr (hfix w hw))
      (hd.trans hdim.symm)
  refine ⟨ho, h2, hW.symm, le_antisymm ?_ (zpowers_le.mpr hgI)⟩
  intro x hx
  rcases Int.units_eq_one_or (hexSign x) with he | he
  · rw [heven x hx he]
    exact one_mem _
  · have hxg : x * g⁻¹ = 1 :=
      heven _ (I.mul_mem hx (I.inv_mem hgI)) (by simp [map_mul, map_inv, he, ho])
    rw [mul_inv_eq_one.mp hxg]
    exact mem_zpowers g

end Representation.Hexacode
