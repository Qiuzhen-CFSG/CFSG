def code (m : M) : Nat :=
  qindex m.a + 4 * (qindex m.b + 4 * (qindex m.c + 4 * (qindex m.d +
  4 * (qindex m.e + 4 * (qindex m.f + 4 * (qindex m.g + 4 * (qindex m.h + 4 * qindex m.i)))))))
def search : Nat → Nat → Nat → Nat → Bool
  | 0, _, _, _ => false
  | n+1, lo, hi, x =>
    if lo < hi then
      let mid := (lo+hi)/2
      let y := (codes[mid / 40]!)[mid % 40]!
      if x = y then true else
      if x < y then search n lo mid x else search n (mid+1) hi x
    else false
def listed (m : M) : Bool := search 11 0 1080 (code m)
def eleventh (m : M) : M :=
  let s := mm m m
  let t := mm s s
  mm (mm (mm t t) s) m
end Representation.Hexacode.SixDimensional.NormalizerData
