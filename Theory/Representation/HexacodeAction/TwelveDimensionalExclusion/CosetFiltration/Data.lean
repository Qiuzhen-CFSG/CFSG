def coefficient (j : Fin 2) (i : Fin 45) : F := entry (coefficientCode j i)

theorem inverseSource_left : ∀ j i, inverseSource j (rowSource j i) = i := by
  decide +kernel

theorem inverseSource_right : ∀ j i, rowSource j (inverseSource j i) = i := by
  decide +kernel

theorem coefficient_ne_zero : ∀ j i, coefficient j i ≠ 0 := by
  decide +kernel

/-- Column-action matrix in the original coset witness coordinates. -/
def generatorMatrix (j : Fin 2) : Matrix (Fin 45) (Fin 45) F :=
  fun r c => if c = rowSource j r then coefficient j r else 0

/-- The dimensions in the proposed nine-step flag, extended constantly. -/
def cut (n : ℕ) : ℕ :=
  if h : n < 10 then (![0,3,12,15,18,21,30,33,42,45] : Fin 10 → ℕ) ⟨n, h⟩ else 45

def degree (t : Factor) : ℕ := cut (t.val + 1) - cut t.val

theorem cut_zero : cut 0 = 0 := by decide +kernel
theorem cut_last : cut 9 = 45 := by decide +kernel
theorem cut_step : ∀ t : Factor, cut t.val < cut (t.val + 1) ∧ cut (t.val + 1) ≤ 45 := by
  decide +kernel

theorem degree_allowed : ∀ t : Factor, degree t ∈ ({3, 9} : Set ℕ) := by
  decide +kernel

theorem degree_pos (t : Factor) : 0 < degree t := by
  have := (cut_step t).1
  change 0 < cut (t.val + 1) - cut t.val
  omega

/-- The position of a coordinate inside a proposed successive factor. -/
def blockIndex (t : Factor) (i : Fin (degree t)) : Fin 45 :=
  ⟨cut t.val + i.val, by
    have := (cut_step t).2
    have := i.isLt
    dsimp [degree] at *
    omega⟩

