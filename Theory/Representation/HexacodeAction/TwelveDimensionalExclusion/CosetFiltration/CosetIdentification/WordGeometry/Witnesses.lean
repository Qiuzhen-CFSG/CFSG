abbrev ProductIndex := (Fin 45 × Fin 3) × Fin 8

/-- Original products, with the subgroup factor on the right. -/
def productMatrix (a : ProductIndex) : M :=
  mm (mm (mpow scalarMatrix a.1.2.val) (representativeMatrix a.1.1))
    (subgroupMatrix a.2)

def symbolKey : Q → ℕ
  | z => 0
  | o => 1
  | w => 2
  | t => 3

/-- Row-major base-four key, used only to distinguish matrices. -/
def matrixKey (m : M) : ℕ :=
  symbolKey m.a + 4 * symbolKey m.b + 16 * symbolKey m.c +
  64 * symbolKey m.d + 256 * symbolKey m.e + 1024 * symbolKey m.f +
  4096 * symbolKey m.g + 16384 * symbolKey m.h + 65536 * symbolKey m.i

