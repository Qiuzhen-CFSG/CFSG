module

public import Theory.Representation.HexacodeAction.TwelveDimensionalExclusion.CosetFiltration.Model

/-!
# Literal words and central left-coset certificates

The subgroup uses all three published Sylow words. The 135 proposed cosets
are `z^k r_i P`, with the published left representatives `r_i`, not their
inverses. An omega-eigenvector has coefficients `omega^(-k) v_i` on these
cosets. Thus the inverse generator transition uses the negative exponent
of the published matrix coefficient.

The two propositions at the end are finite group obligations, with no
representation-theoretic conclusions hidden in their hypotheses.

Source: Aschbacher–Smith K.1.3, printed p.453 / PDF p.464, and the witness
calculation preserved in `../source/`. The underlying ATLAS hexacode is due
to Gerald Höhn and the ATLAS contributors; see `LICENSES/ATLAS.txt` and
`LICENSES/ATLAS-CITATION.cff`.
-/

@[expose] public section
open Atlas.Codes
namespace Representation.Hexacode.TwelveDimensional.CosetCertificate.CosetIdentification

/-- The subgroup generated by the three original witness words. -/
def candidateSubgroup : Subgroup Cover :=
  Subgroup.closure (Set.range fun a : Fin 3 => evalWord (sylowWords a))

/-- The original left representative; GAP's right representative was already inverted. -/
def representative (i : Fin 45) : Cover := evalWord (cosetWords i)

/-- One selected coset in each proposed central orbit. -/
def basepoint (i : Fin 45) : Cover ⧸ candidateSubgroup :=
  QuotientGroup.mk (representative i)

/-- The three central translates of a family of left cosets. -/
def orbitPoint {P : Subgroup Cover} (q : Fin 45 → Cover ⧸ P)
    (a : Fin 45 × Fin 3) : Cover ⧸ P := hexEvenZ ^ a.2.val • q a.1

/-- Coefficient at the k-th translate for the omega, rather than omega², eigenspace. -/
def weight (k : Fin 3) : F := (omega ^ 2) ^ k.val

/-- Negative exponent of the coefficient in the published output row. -/
def phase (j : Fin 2) (i : Fin 45) : Fin 3 :=
  if coefficientCode j i = 1 then 0 else if coefficientCode j i = 2 then 2 else 1

theorem weight_phase : ∀ j i, weight (phase j i) = coefficient j i := by
  decide +kernel

/-- The 135 displayed cosets must be distinct and exhaustive. -/
def CosetTransversal : Prop := Function.Bijective (orbitPoint basepoint)

/-- The literal group element whose membership certifies one inverse-action row. -/
def inverseTransporter (j : Fin 2) (i : Fin 45) : Cover :=
  ((coverGenerator j)⁻¹ * representative i)⁻¹ *
    (hexEvenZ ^ (phase j i).val * representative (rowSource j i))

/-- All ninety concrete transporter words lie in the original subgroup. -/
def WordTransitions : Prop := ∀ j i, inverseTransporter j i ∈ candidateSubgroup

/-- Membership gives equality in the actual left-coset space. -/
theorem inverse_generator_basepoint (h : WordTransitions) (j : Fin 2) (i : Fin 45) :
    (coverGenerator j)⁻¹ • basepoint i =
      orbitPoint basepoint (rowSource j i, phase j i) := by
  apply Quotient.sound
  exact QuotientGroup.leftRel_apply.mpr (h j i)

end Representation.Hexacode.TwelveDimensional.CosetCertificate.CosetIdentification
