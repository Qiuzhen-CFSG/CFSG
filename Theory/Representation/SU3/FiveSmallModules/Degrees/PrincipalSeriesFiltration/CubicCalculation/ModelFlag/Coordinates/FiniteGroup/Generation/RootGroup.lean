module

public import Theory.Representation.SU3.FiveSmallModules.Degrees.PrincipalSeriesFiltration.CubicCalculation.ModelFlag.Coordinates.FiniteGroup.RootWitness

/-!
# The full Borel lies in the subgroup generated by the retained pair

The seed root and its conjugate by the primitive torus element have first
coordinates forming an F₅-basis of F₂₅. Their commutator generates the
trace-zero central layer. The two small finite coverage checks therefore give
every root coordinate, by removing its first coordinate and then its central
remainder. Together with the full torus witness, this proves containment of
the literal special-unitary Borel, without passing to a projective quotient.

The coordinates use ω² = ω − 2, with the seed from `RootWitness.lean` and
`Coordinates/source/upper_group_data.json`. The root multiplication and torus
action are Huppert II.10.12. This supplies Borel containment for the cubic
principal-series certificate motivated by Guralnick–Malle Proposition 4.3 and
Aschbacher–Smith K.2, printed p.453.
-/

@[expose] public noncomputable section
open Matrix BenderSuzuki.MatrixGroups BenderSuzuki.External
open HermitianForm.OddPrimeSylow.NormalizedOuter
open scoped commutatorElement
namespace Representation.SU3.FiveSmallModules.Degrees.CubicCalculation.ModelFlag.FiniteGroup
private abbrev Root := hermitianUnipotentCoord (FormTransport.standardForm fieldForm)
private def secondSeed : Root := ⟨(⟨1,4⟩, ⟨3,2⟩), by decide⟩
private def centralSeed : Root := ⟨(0, ⟨1,3⟩), by decide⟩
private theorem secondSeed_action : hermitianTorusAction (FormTransport.standardForm fieldForm) parameter seed = secondSeed := by
  decide +kernel
private theorem centralSeed_commutator : ⁅seed, secondSeed⁆ = centralSeed := by decide +kernel
private theorem first_spans (u : Field) : ∃ a b : Fin 5, (seed ^ a.val * secondSeed ^ b.val).val.1 = u := by
  revert u
  decide +kernel
private theorem center_spans (z : Root) (hz : z.val.1 = 0) : ∃ c : Fin 5, z = centralSeed ^ c.val := by
  revert z
  decide +kernel

private theorem secondSeed_mem_closure :
    (principalRootIn fieldForm secondSeed : standardGroup fieldForm) ∈
      Subgroup.closure (Set.range generator) := by
  let H := Subgroup.closure (Set.range generator)
  have he : (principalTorusIn fieldForm parameter : standardGroup fieldForm) *
      (principalRootIn fieldForm seed : standardGroup fieldForm) =
      (principalRootIn fieldForm secondSeed : standardGroup fieldForm) *
        (principalTorusIn fieldForm parameter : standardGroup fieldForm) := by
    rw [← secondSeed_action]
    apply Subtype.ext
    exact hermitianTorusGL_mul_unipotent _ _ _
  rw [← mul_inv_eq_iff_eq_mul.mpr he]
  exact H.mul_mem (H.mul_mem (torus_mem_closure parameter) seed_mem_closure)
    (H.inv_mem (torus_mem_closure parameter))

/-- Every element of the full upper root group belongs to the generated subgroup. -/
theorem root_mem_closure
    (z : hermitianUnipotentCoord (FormTransport.standardForm fieldForm)) :
    (principalRootIn fieldForm z : standardGroup fieldForm) ∈
      Subgroup.closure (Set.range generator) := by
  let R : Subgroup Root := (Subgroup.closure (Set.range generator)).comap
    ((standardBorel fieldForm).subtype.comp (principalRootIn fieldForm))
  have hs : seed ∈ R := seed_mem_closure
  have ht : secondSeed ∈ R := secondSeed_mem_closure
  have hc : centralSeed ∈ R := by
    rw [← centralSeed_commutator]
    exact R.mul_mem (R.mul_mem (R.mul_mem hs ht) (R.inv_mem hs)) (R.inv_mem ht)
  obtain ⟨a, b, hab⟩ := first_spans z.val.1
  let w := seed ^ a.val * secondSeed ^ b.val
  have hw : w ∈ R := R.mul_mem (R.pow_mem hs _) (R.pow_mem ht _)
  have hz : (z * w⁻¹).val.1 = 0 := by
    change z.val.1 + -(w.val.1) = 0
    rw [show w.val.1 = z.val.1 from hab, add_neg_cancel]
  obtain ⟨c, hzc⟩ := center_spans (z * w⁻¹) hz
  have hzR : z * w⁻¹ ∈ R := by
    rw [hzc]
    exact R.pow_mem hc _
  have hm := R.mul_mem hzR hw
  change z ∈ R
  simpa only [inv_mul_cancel_right] using hm

/-- Both the full root group and full torus, including the central scalars, are retained. -/
theorem borel_le_closure : standardBorel fieldForm ≤
    Subgroup.closure (Set.range generator) := by
  apply sup_le
  · rintro _ ⟨z, rfl⟩
    exact root_mem_closure z
  · rintro _ ⟨k, rfl⟩
    exact torus_mem_closure k

end Representation.SU3.FiveSmallModules.Degrees.CubicCalculation.ModelFlag.FiniteGroup
