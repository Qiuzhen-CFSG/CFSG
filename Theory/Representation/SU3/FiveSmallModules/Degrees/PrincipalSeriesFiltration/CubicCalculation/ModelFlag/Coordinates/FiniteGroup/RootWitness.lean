module

public import Theory.Representation.SU3.FiveSmallModules.Degrees.PrincipalSeriesFiltration.CubicCalculation.ModelFlag.Coordinates.FiniteGroup.Elements

/-!
# A root element in the subgroup generated by the retained matrices

The first retained generator is the full torus parameter. A short word in the
two retained generators gives a root element with nonzero first coordinate.
The word was found diagnostically in GAP and is proved here by kernel checking
its concrete F₂₅ matrix identity. This is an input to full group generation,
not an assertion that the coset-action image already is the full group.
-/

@[expose] public noncomputable section
open Matrix BenderSuzuki.MatrixGroups BenderSuzuki.External
open HermitianForm.OddPrimeSylow.NormalizedOuter
namespace Representation.SU3.FiveSmallModules.Degrees.CubicCalculation.ModelFlag.FiniteGroup

def seed : hermitianUnipotentCoord (FormTransport.standardForm fieldForm) :=
  ⟨(⟨2, 4⟩, ⟨1, 4⟩), by decide⟩

theorem generator_zero_torus : generator 0 =
    (principalTorusIn fieldForm parameter : standardGroup fieldForm) := by
  apply Subtype.ext
  apply Units.ext
  change rawGenerator 0 = hermitianTorusMatrix _ parameter
  decide +kernel

private theorem raw_seed_word : rootMatrix ⟨2, 4⟩ ⟨1, 4⟩ =
    rawGenerator 1 * rawGenerator 0 * rawGenerator 1 ^ 2 * rawGenerator 0 ^ 3 *
      rawGenerator 1 ^ 3 * rawGenerator 0 ^ 7 := by
  decide +kernel

theorem seed_word :
    (principalRootIn fieldForm seed : standardGroup fieldForm) =
      generator 1 * generator 0 * generator 1 ^ 2 * generator 0 ^ 3 *
        generator 1 ^ 3 * generator 0 ^ 7 := by
  apply Subtype.ext
  apply Units.ext
  change rootMatrix ⟨2, 4⟩ ⟨1, 4⟩ = _
  simpa only [Subgroup.coe_mul, Subgroup.coe_pow, Units.val_mul,
    Units.val_pow_eq_pow_val, generator_val] using raw_seed_word

/-- The word supplies an actual noncentral upper-root element in the closure. -/
theorem seed_mem_closure :
    (principalRootIn fieldForm seed : standardGroup fieldForm) ∈
      Subgroup.closure (Set.range generator) := by
  let H := Subgroup.closure (Set.range generator)
  have h (a : Fin 2) : generator a ∈ H := Subgroup.subset_closure ⟨a, rfl⟩
  rw [seed_word]
  exact H.mul_mem (H.mul_mem (H.mul_mem (H.mul_mem (H.mul_mem (h 1) (h 0))
    (H.pow_mem (h 1) 2)) (H.pow_mem (h 0) 3)) (H.pow_mem (h 1) 3)) (H.pow_mem (h 0) 7)

/-- The primitive-parameter fact already puts the entire full torus in the closure. -/
theorem torus_mem_closure (k : Fieldˣ) :
    (principalTorusIn fieldForm k : standardGroup fieldForm) ∈
      Subgroup.closure (Set.range generator) := by
  obtain ⟨n, rfl⟩ := Subgroup.mem_zpowers_iff.mp (parameter_generates k)
  rw [map_zpow, Subgroup.coe_zpow, ← generator_zero_torus]
  exact (Subgroup.closure (Set.range generator)).zpow_mem
    (Subgroup.subset_closure (Set.mem_range_self 0)) n

end Representation.SU3.FiveSmallModules.Degrees.CubicCalculation.ModelFlag.FiniteGroup
