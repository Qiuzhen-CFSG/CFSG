/-- Root matrix without a subtype, for the small kernel calculations. -/
def rootMatrix (u v : Field) : Matrix (Fin 3) (Fin 3) Field :=
  !![1, u, v; 0, 1, -F25.conjugation u; 0, 0, 1]

/-- Full diagonal torus at the recorded power of ω. -/
def torusMatrix (n : ℕ) : Matrix (Fin 3) (Fin 3) Field :=
  let k := F25.omega ^ n
  !![(F25.conjugation k)⁻¹, 0, 0;
    0, F25.conjugation k * k⁻¹, 0; 0, 0, k]

