public import Theory.SpecificGroups.SU3.InvolutionConjugateBounds.Five.InnerModel.Embedding.Field
public import BenderSuzuki.MatrixGroups.Unitary

/-!
# Concrete upper-Borel matrices for the cubic SU₃(5) calculation

The matrices and root parameters are the unchanged ordering of
`Coordinates/source/upper_group_data.json`, converted from powers of the GAP
parameter to the existing F₂₅ coordinates with ω² = ω − 2. The exponent arrays
are retained literally. No assertion of group generation is part of this data.

The source data were obtained by conjugating all retained matrices by the
antidiagonal matrix; no special-unitary membership of that conjugator is used.
These coordinates support the principal-series calculation motivated by
Guralnick–Malle Proposition 4.3, p.10, and Aschbacher–Smith K.2, p.453.
-/

@[expose] public section
open Matrix BenderSuzuki.MatrixGroups
open HermitianForm.InvolutionConjugateBounds.Five.Embedding
namespace Representation.SU3.FiveSmallModules.Degrees.CubicCalculation.ModelFlag.FiniteGroup

abbrev Field := F25

/-- Antidiagonal form with the explicit fifth-power field involution. -/
def fieldForm : HermitianForm 3 Field where
  conj := F25.conjugation
  conj_involutive := F25.conjugation_involutive
  form := !![0, 0, 1; 0, 1, 0; 1, 0, 0]
  form_hermitian := by intro i j; fin_cases i <;> fin_cases j <;> decide
  form_nondegenerate := by decide

