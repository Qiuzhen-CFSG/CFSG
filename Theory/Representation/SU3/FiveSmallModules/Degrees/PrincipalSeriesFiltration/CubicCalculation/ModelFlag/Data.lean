def rawGenerator (a : Fin 2) : Matrix (Fin 126) (Fin 126) CoefficientField :=
  fun i j => if a = 0 then
    if j = generatorTarget0 i then decode (generatorCode0 i) else 0
  else
    if j = generatorTarget1 i then decode (generatorCode1 i) else 0

def rawNilpotent : Matrix (Fin 126) (Fin 126) CoefficientField :=
  fun i j => decode (nilpotentRows i / 4 ^ j.val % 4)

noncomputable def generatorMatrix {K : Type*} [Field K] [CharP K 2]
    (z : K) (hz : z ^ 2 + z + 1 = 0) (a : Fin 2) : Matrix (Fin 126) (Fin 126) K :=
  ((rawGenerator a).map (evaluate z hz)).transpose

noncomputable def nilpotentMatrix {K : Type*} [Field K] [CharP K 2]
    (z : K) (hz : z ^ 2 + z + 1 = 0) : Matrix (Fin 126) (Fin 126) K :=
  (rawNilpotent.map (evaluate z hz)).transpose

