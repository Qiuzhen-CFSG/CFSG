module

public import Theory.Representation.SU3.FiveSmallModules.Degrees.PrincipalSeriesFiltration.TrivialCalculation.MiddleFactors.Realization.Construction
public import Theory.Representation.SU3.FiveSmallModules.Degrees.PrincipalSeriesFiltration.TrivialCalculation.MiddleFactors.Realization.GenerationFromBorel
public import Theory.Representation.SU3.FiveSmallModules.Degrees.PrincipalSeriesFiltration.TrivialCalculation.MiddleFactors.Realization.Borel
public import Theory.Representation.SU3.FiveSmallModules.Degrees.PrincipalSeriesFiltration.TrivialCalculation.MiddleFactors.Realization.Cosets

/-!
# Assembly of the canonical middle-factor coordinates

The checked literal coset table and containment of the full Borel in the
subgroup generated by the specified two matrix actors give the full coordinate
construction over every finite field of characteristic two. The cardinality
hypothesis makes the point table onto and proves whole-group generation;
the checked adapted basis then gives the invariant subspace and coordinates on
its two literal middle quotients. The full Borel containment is certified by
matrix words, and the coset identification by root–torus multipliers and
distinct normalized bottom rows.

Source motivation: Guralnick–Malle Proposition 4.3, p.10; Aschbacher–Smith K.2,
printed p.453. The independent Borel coset count remains an explicit premise;
the parent middle-flag assembly discharges it.
-/

@[expose] public section

namespace Representation.SU3.FiveSmallModules.Degrees.TrivialCalculation
universe v

/-- Conditional assembly on the literal canonical cosets, over every original
finite characteristic-two coefficient field. The two geometric inputs contain
no submodule or representation-theoretic conclusion. -/
theorem canonical_coordinates_of_geometric_inputs
    (hcard : Nat.card CanonicalPoints = 126)
    (hc : Nonempty MiddleFactors.Realization.CosetEnumeration)
    (hB : MiddleFactors.Realization.tableBorel ≤
      Subgroup.closure (Set.range MiddleFactors.Realization.tableActor)) :
    MiddleFactors.CanonicalCoordinates.{v} := by
  obtain ⟨c⟩ := hc
  intro K _ _ _
  exact ⟨MiddleFactors.Realization.coordinates K c hcard
    (c.generates_of_borel hcard hB)⟩

/-- Borel containment and group generation are discharged. Only identification
of the fixed point table with distinct literal cosets remains explicit. -/
theorem canonical_coordinates_of_coset_enumeration
    (hcard : Nat.card CanonicalPoints = 126)
    (hc : Nonempty MiddleFactors.Realization.CosetEnumeration) :
    MiddleFactors.CanonicalCoordinates.{v} :=
  canonical_coordinates_of_geometric_inputs hcard hc MiddleFactors.Realization.tableBorel_le_generated

/-- The checked coset enumeration realizes both middle-factor coordinate
systems on the literal canonical quotients. Only the independently supplied
Borel coset count remains as a hypothesis. -/
theorem canonical_coordinates_of_card
    (hcard : Nat.card CanonicalPoints = 126) : MiddleFactors.CanonicalCoordinates.{v} :=
  canonical_coordinates_of_coset_enumeration hcard MiddleFactors.Realization.coset_enumeration

end Representation.SU3.FiveSmallModules.Degrees.TrivialCalculation
