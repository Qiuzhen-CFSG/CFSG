module
public import Theory.Representation.SU3.CubicDegree.InnerActors.ThreeRoots.Coordinates

/-!
# The fixed-field block and a connecting root word

The upper and lower central transvection groups contain the fixed-field SL₂
block, by elementary-matrix generation of SL₂. A word in the first and third
centers takes the first coordinate vector to `(b,1,1)`. These are the group
calculations needed to turn the two block orbits on isotropic lines into
transitivity of the subgroup generated by the three marked centers.

Source: the actual matrices of Huppert II.10.12; the transvection geometry
used for Aschbacher--Smith K.3.3, printed p.456.
-/

public section
open Matrix Subgroup BenderSuzuki.MatrixGroups BenderSuzuki.External
namespace Representation.SU3.CubicDegree.InnerActors.ThreeRoots
open HermitianForm.BorelTorus.EvenCenterAction
variable {F : Type*} [Field F] [CharP F 2] (J : HermitianForm 3 F)
  (hJ : J.form = !![0,0,1;0,1,0;1,0,0])

omit [CharP F 2] in
private theorem weyl_inv : (hermitianWeylSU J hJ)⁻¹ = hermitianWeylSU J hJ := by
  apply inv_eq_of_mul_eq_one_left
  apply Subtype.ext
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [hermitianWeylSU, hermitianWeylGL, hermitianWeylMatrix,
      Matrix.mul_apply, Fin.sum_univ_three]

theorem block_range_le_pair : (block J hJ).range ≤
    central J hJ ⊔ (central J hJ).map (MulAut.conj (hermitianWeylSU J hJ)).toMonoidHom := by
  rintro _ ⟨A, rfl⟩
  apply Matrix.SL2.transvection_induction
    (fun A => block J hJ A ∈ central J hJ ⊔
      (central J hJ).map (MulAut.conj (hermitianWeylSU J hJ)).toMonoidHom) _ _ A
  · intro i j hij c
    let z := hermitianUnipotentSU J hJ (centralCoord J (Multiplicative.ofAdd c))
    have hz : z ∈ central J hJ := ⟨Multiplicative.ofAdd c, rfl⟩
    have hzval : z.val.val = !![1,0,(c : F);0,1,0;0,0,1] := by
      change (!![1,0,(c : F);0,1,-J.conj 0;0,0,1] : Matrix (Fin 3) (Fin 3) F) = _
      simp
    fin_cases i <;> fin_cases j
    · exact (hij rfl).elim
    · have he : block J hJ (SpecialLinearGroup.transvection hij c) = z := by
        apply Subtype.ext
        apply Units.ext
        rw [block_val, hzval]
        ext i j
        fin_cases i <;> fin_cases j <;>
          simp [SpecialLinearGroup.transvection_coe]
      rw [he]
      exact (show central J hJ ≤ _ from le_sup_left) hz
    · have he : block J hJ (SpecialLinearGroup.transvection hij c) =
          hermitianWeylSU J hJ * z * (hermitianWeylSU J hJ)⁻¹ := by
        rw [weyl_inv]
        apply Subtype.ext
        apply Units.ext
        change (block J hJ _).val.val =
          ((hermitianWeylSU J hJ).val.val * z.val.val) * (hermitianWeylSU J hJ).val.val
        rw [block_val, hzval]
        ext i j
        fin_cases i <;> fin_cases j <;>
          simp [SpecialLinearGroup.transvection_coe,
            hermitianWeylSU, hermitianWeylGL, hermitianWeylMatrix, Matrix.mul_apply, Fin.sum_univ_three]
      rw [he]
      exact (show (central J hJ).map (MulAut.conj (hermitianWeylSU J hJ)).toMonoidHom ≤ _ from le_sup_right) ⟨z, hz, rfl⟩
    · exact (hij rfl).elim
  · intro A B hA hB
    rw [map_mul]
    exact Subgroup.mul_mem _ hA hB

private theorem seed_inv_val (b : F) (hb : b + J.conj b = 1) :
    (seed J hJ b hb)⁻¹.val.val = !![1,1,J.conj b;0,1,1;0,0,1] := by
  change ((hermitianUnipotentSU J hJ) _)⁻¹.val.val = _
  rw [← map_inv]
  change hermitianUnipotentMatrix J _ = _
  change (!![1,-1,J.conj b;0,1,-J.conj (-1);0,0,1] : Matrix (Fin 3) (Fin 3) F) = _
  simp [CharTwo.neg_eq]

/-- A word in the first and third centers takes the first coordinate vector
to the chosen isotropic vector. -/
theorem exists_connector (b : F) (hb : b + J.conj b = 1) :
    ∃ g ∈ triple J hJ b hb, ∀ i, g.val.val i 0 = (![b,1,1] : Fin 3 → F) i := by
  let z := hermitianUnipotentSU J hJ (centralCoord J (Multiplicative.ofAdd 1))
  let t := thirdConjugator J hJ b hb
  have hz : z ∈ central J hJ := ⟨Multiplicative.ofAdd 1, rfl⟩
  have hzval : z.val.val = !![1,0,1;0,1,0;0,0,1] := by
    change (!![1,0,1;0,1,-J.conj 0;0,0,1] : Matrix (Fin 3) (Fin 3) F) = _
    simp
  refine ⟨z * (t * z * t⁻¹), ?_, ?_⟩
  · apply (triple J hJ b hb).mul_mem
    · exact (show central J hJ ≤ triple J hJ b hb from le_sup_left.trans le_sup_left) hz
    · exact (show (central J hJ).map (MulAut.conj t).toMonoidHom ≤ triple J hJ b hb from le_sup_right)
        ⟨z, hz, rfl⟩
  · have ht : t⁻¹ = (hermitianWeylSU J hJ) * (seed J hJ b hb)⁻¹ := by
      dsimp [t, thirdConjugator]
      rw [_root_.mul_inv_rev, weyl_inv]
    intro i
    rw [ht]
    change (z.val.val * (((seed J hJ b hb).val.val * (hermitianWeylSU J hJ).val.val) *
      z.val.val * ((hermitianWeylSU J hJ).val.val * (seed J hJ b hb)⁻¹.val.val))) i 0 = _
    rw [hzval, seed_val, seed_inv_val]
    fin_cases i <;>
      simp [hermitianWeylSU, hermitianWeylGL, hermitianWeylMatrix, Matrix.mul_apply, Fin.sum_univ_three,
        CharTwo.neg_eq, add_assoc, CharTwo.add_self_eq_zero]

end Representation.SU3.CubicDegree.InnerActors.ThreeRoots
