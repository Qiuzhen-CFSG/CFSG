module

public import Theory.Representation.BinaryIndexThreeDisplacement

/-!
# A binary plane generated by a Sylow-fixed vector

A vector fixed by an index-three subgroup has a displacement space of order
four. A fixed-free cubic operator makes its norm vanish, placing the original
vector in that displacement space. The full orbit span is therefore exactly
that plane. This is the normal-complement construction in J.4.4(2), p.441.
-/

public section
open Subgroup
namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V]

/-- A fixed-free cubic turns the index-three displacement plane into the full orbit span. -/
theorem index_three_orbit_span_card (ρ : Representation (ZMod 2) G V)
    (T : Subgroup G) (hi : T.index=3) (v : V) (hv : v≠0)
    (hT : ∀t∈T,ρ t v=v) (c:G)
    (hc : ∀w,ρ c (ρ c (ρ c w))=w)
    (hf : ∀w,ρ c w=w → w=0) :
    Nat.card (Submodule.span (ZMod 2) (Set.range (fun g:G => ρ g v)))=4 := by
  have hm : ρ c v≠v := fun h => hv (hf v h)
  let D := subspaceCommutator ρ (Submodule.span (ZMod 2) {v}) ⊤
  have hD : Nat.card D=4 := index_three_displacement_card ρ T ⊤
    (by simp) hi v hT ⟨c,mem_top _,hm⟩
  have hn : v+ρ c v+ρ c (ρ c v)=0 := by
    apply hf
    rw [map_add,map_add,hc]
    abel
  have hvv : v+v=0 := by
    have h : (2:ℕ) • v=0 := by
      rw [← Nat.cast_smul_eq_nsmul (ZMod 2),ZMod.natCast_self,zero_smul]
    simpa only [two_nsmul] using h
  have hsum : (ρ c v-v)+(ρ c (ρ c v)-v)=v := by
    have he : (ρ c v-v)+(ρ c (ρ c v)-v)+v=0 := by
      calc
        _ = (v+ρ c v+ρ c (ρ c v))-(v+v) := by abel
        _ = 0 := by rw [hn,hvv,sub_zero]
    exact (eq_neg_of_add_eq_zero_left he).trans (neg_eq_of_add_eq_zero_left hvv)
  have hvD : v∈D := by
    rw [← hsum]
    apply Submodule.add_mem
    · exact Submodule.subset_span ⟨c,mem_top _,v,Submodule.mem_span_singleton_self v,rfl⟩
    · have hh : ρ (c*c) v-v∈D :=
        Submodule.subset_span ⟨c*c,mem_top _,v,Submodule.mem_span_singleton_self v,rfl⟩
      simpa only [map_mul,Module.End.mul_apply] using hh
  let E := Submodule.span (ZMod 2) (Set.range (fun g:G => ρ g v))
  have hvE : v∈E := by
    have h : ρ (1:G) v∈E := Submodule.subset_span (show ρ (1:G) v∈Set.range (fun g:G => ρ g v) from ⟨1,rfl⟩)
    simpa only [map_one,Module.End.one_apply] using h
  have he : E=D := by
    apply le_antisymm
    · apply Submodule.span_le.mpr
      rintro _ ⟨g,rfl⟩
      have hd : ρ g v-v∈D :=
        Submodule.subset_span ⟨g,mem_top _,v,Submodule.mem_span_singleton_self v,rfl⟩
      have hs := D.add_mem hd hvD
      rw [sub_add_cancel] at hs
      exact hs
    · apply Submodule.span_le.mpr
      rintro _ ⟨g,_,w,hw,rfl⟩
      obtain ⟨a,rfl⟩ := Submodule.mem_span_singleton.mp hw
      rw [map_smul,← smul_sub]
      exact E.smul_mem _ (E.sub_mem (Submodule.subset_span ⟨g,rfl⟩) hvE)
  rwa [← he] at hD

end Representation.BinaryOffender
