module
public import Theory.Representation.PSL3Two.ParabolicCyclic.PointRecognition
public import Theory.Representation.ElementaryPerfectSplit
public import Theory.GroupTheory.ConjugateSpanOrder
public import Theory.GroupTheory.ConjugateSpanSylow

/-!
# Natural coordinates on a binary conjugate span

An elementary subgroup generated by the conjugates of a point has the natural
SL₃(2) action when the point parabolic fixes that point and its line-parabolic
span has order four. The proof descends the actual conjugation action through
the supplied surjection, identifies linear orbit spans with literal subgroup
spans, and applies the proved H.5.5 recognition theorem. Its coordinates retain
the supplied quotient map and intertwine ambient conjugation.

Source: Aschbacher–Smith, H.5.5, printed p.386, and its use in 14.5.8,
printed pp.1014–1015, refs/quasithin.pdf.
-/

public noncomputable section
open Subgroup Representation
open scoped IsMulCommutative
namespace Representation.ConjugatePointNatural
open BinaryLinearThree.ParabolicCyclic
variable {G : Type*} [Group G] [Finite G]

private def space (W A : Subgroup G) [IsElementaryAbelian 2 W] :
    Submodule (ZMod 2) (Additive W) :=
  AddSubgroup.toZModSubmodule 2 (A.subgroupOf W).toAddSubgroup

private def spaceEquiv (W A : Subgroup G) [IsElementaryAbelian 2 W]
    (hA : A ≤ W) : space W A ≃ A where
  toFun v := ⟨v.val.toMul.val,v.property⟩
  invFun a := ⟨Additive.ofMul ⟨a.val,hA a.property⟩,a.property⟩
  left_inv _ := rfl
  right_inv _ := rfl

omit [Finite G] in
private theorem orbit_span_eq (H W Z : Subgroup G) [IsElementaryAbelian 2 W]
    (z : G) (hz : Z = zpowers z) (hZW : Z ≤ W)
    (π : H →* Matrix.PSL3Two.SL) (α : Matrix.PSL3Two.SL →* MulAut W)
    (hα : ∀ (g : H) (w : W), (α (π g) w : G) = (g : G) * w * (g : G)⁻¹)
    (A : Subgroup G) (hA : A ≤ H) :
    let m : Additive W := Additive.ofMul ⟨z,hZW (hz ▸ mem_zpowers z)⟩
    orbitSpan (elementaryRepresentation (p := 2) α) ((A.subgroupOf H).map π) m =
      space W (conjugateSpanBy Z A) := by
  let m : Additive W := Additive.ofMul ⟨z,hZW (hz ▸ mem_zpowers z)⟩
  let ρ := elementaryRepresentation (p := 2) α
  have ha (g : H) (v : Additive W) : ((ρ (π g) v).toMul : G) =
      (g : G) * v.toMul * (g : G)⁻¹ := hα g v.toMul
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro v ⟨g,hg,rfl⟩
    obtain ⟨a,ha',rfl⟩ := hg
    change ((ρ (π a) m).toMul : G) ∈ conjugateSpanBy Z A
    rw [ha]
    exact subset_closure ⟨a,ha',z,hz ▸ mem_zpowers z,rfl⟩
  · let O := orbitSpan ρ ((A.subgroupOf H).map π) m
    let S : Subgroup W := O.toAddSubgroup.toSubgroup'
    have hspan : conjugateSpanBy Z A ≤ S.map W.subtype := by
      apply (closure_le _).mpr
      rintro _ ⟨a,ha',x,hx,rfl⟩
      rw [hz] at hx
      obtain ⟨n,rfl⟩ := mem_zpowers_iff.mp hx
      have hm : a * z * a⁻¹ ∈ S.map W.subtype := by
        let aH : H := ⟨a,hA ha'⟩
        refine ⟨(ρ (π aH) m).toMul,?_,?_⟩
        · exact orbit_mem _ _ _ _ (mem_map_of_mem _ ha')
        · exact ha aH m
      change MulAut.conj a (z ^ n) ∈ S.map W.subtype
      rw [map_zpow]
      exact (S.map W.subtype).zpow_mem hm n
    intro v hv
    obtain ⟨w,hw,he⟩ := hspan hv
    have he' : w = v.toMul := Subtype.ext he
    change v.toMul ∈ S
    rwa [he'] at hw

/-- Recognize a literal elementary conjugate span from its marked point and
line parabolics. The resulting coordinates intertwine the given ambient action. -/
theorem exists_natural_coordinates
    (H W Z A B : Subgroup G) [IsElementaryAbelian 2 W]
    (hHW : H ≤ normalizer (W : Set G))
    (hZW : Z ≤ W) (z : G) (hz : Z = zpowers z) (hz1 : z ≠ 1)
    (π : H →* Matrix.PSL3Two.SL) (hπ : Function.Surjective π)
    (hker : π.ker ≤ (centralizer (W : Set G)).subgroupOf H)
    (hA : A ≤ H)
    (hline : (A.subgroupOf H).map π = Matrix.PSL3Two.lineParabolicSL)
    (hpoint : (B.subgroupOf H).map π = Matrix.PSL3Two.pointParabolicSL)
    (hBZ : B ≤ centralizer (Z : Set G))
    (hgen : W = conjugateSpanBy Z H)
    (hplane : Nat.card (conjugateSpanBy Z A) = 4) :
    ∃ e : W ≃* Multiplicative BinaryLinearThree.Vector,
      ∀ (g : H) (w : W),
        (e (W.normalizerMonoidHom (inclusion hHW g) w)).toAdd =
          BinaryLinearThree.W (π g) (e w).toAdd := by
  let a : H →* MulAut W := W.normalizerMonoidHom.comp (inclusion hHW)
  have hk : π.ker ≤ a.ker := by
    intro g hg
    apply MulEquiv.ext
    intro w
    apply Subtype.ext
    change (g : G) * w * (g : G)⁻¹ = w
    have hc := mem_centralizer_iff.mp (hker hg) (w : G) w.property
    change (w : G) * (g : G) = (g : G) * w at hc
    rw [←hc,mul_inv_cancel_right]
  let α : Matrix.PSL3Two.SL →* MulAut W := π.liftOfSurjective hπ ⟨a,hk⟩
  have hα (g : H) (w : W) : (α (π g) w : G) = (g : G) * w * (g : G)⁻¹ := by
    have hh : α (π g) = a g := MonoidHom.liftOfRightInverse_comp_apply _ _ _ _ _
    rw [hh]
    rfl
  let ρ := elementaryRepresentation (p := 2) α
  let m : Additive W := Additive.ofMul ⟨z,hZW (hz ▸ mem_zpowers z)⟩
  have hm : m ≠ 0 := fun he => hz1 (congrArg (fun v : Additive W => (v.toMul : G)) he)
  have hfixed (g : Matrix.PSL3Two.SL) (hg : g ∈ Matrix.PSL3Two.pointParabolicSL) :
      ρ g m = m := by
    rw [←hpoint] at hg
    obtain ⟨a,ha,rfl⟩ := hg
    apply Additive.toMul.injective
    apply Subtype.ext
    change (α (π a) m.toMul : G) = z
    rw [hα]
    have hc := mem_centralizer_iff.mp (hBZ ha) z (hz ▸ mem_zpowers z)
    change z * (a : G) = (a : G) * z at hc
    change (a : G) * z * (a : G)⁻¹ = z
    rw [←hc,mul_inv_cancel_right]
  have hwhole : orbitSpan ρ ⊤ m = ⊤ := by
    have ht : (H.subgroupOf H).map π = ⊤ := by
      rw [subgroupOf_self,map_top_of_surjective π hπ]
    rw [←ht,orbit_span_eq H W Z z hz hZW π α hα H le_rfl,←hgen]
    ext v
    exact iff_true_intro v.toMul.property
  have hdim : Module.finrank (ZMod 2)
      (orbitSpan ρ Matrix.PSL3Two.lineParabolicSL m) = 2 := by
    rw [←hline,orbit_span_eq H W Z z hz hZW π α hα A hA]
    have hpW : conjugateSpanBy Z A ≤ W := by
      rw [hgen]
      exact conjugateSpanBy_mono le_rfl hA
    have hc : Nat.card (space W (conjugateSpanBy Z A)) = 4 :=
      (Nat.card_congr (spaceEquiv W _ hpW)).trans hplane
    have hh := Module.natCard_eq_pow_finrank (K := ZMod 2)
      (V := space W (conjugateSpanBy Z A))
    rw [Nat.card_zmod,hc] at hh
    exact Nat.pow_right_injective (by decide : 2 ≤ 2) hh.symm
  obtain ⟨e⟩ := point_seed_equiv_natural ρ m hm hfixed hwhole hdim
  refine ⟨e.toLinearEquiv.toAddEquiv.toMultiplicativeRight,?_⟩
  intro g w
  have hh := Representation.IntertwiningMap.isIntertwining _ _ e.toIntertwiningMap (π g) (Additive.ofMul w)
  have ha : ρ (π g) (Additive.ofMul w) =
      Additive.ofMul (W.normalizerMonoidHom (inclusion hHW g) w) := by
    apply Additive.toMul.injective
    apply Subtype.ext
    exact hα g w
  rw [ha] at hh
  exact hh

end Representation.ConjugatePointNatural
