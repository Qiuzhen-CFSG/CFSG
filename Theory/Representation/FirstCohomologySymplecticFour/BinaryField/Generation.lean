def table (i : Fin 360) : Mat := decode (codes / 2^(16*i.val) % 65536)
def parent (i : Fin 360) : Fin 360 := ⟨(parents / 2^(9*i.val) % 512) % 360, Nat.mod_lt _ (by decide)⟩
def letter (i : Fin 360) : Fin 3 := ⟨(letters / 2^(2*i.val) % 4) % 3, Nat.mod_lt _ (by decide)⟩
def odd : Sp := symplecticTransvection (Sum.elim ![1, 0] ![0, 0])
def witness (a b c d : Fin 16) : Fin 720 :=
  ⟨((lookup[a.val]!)[16*b.val+c.val]! / 2^(10*d.val) % 1024) % 720,
    Nat.mod_lt _ (by decide)⟩
def representative (i : Fin 720) : Mat :=
  if i.val < 360 then table ⟨i.val % 360, Nat.mod_lt _ (by decide)⟩
  else odd.val * table ⟨i.val % 360, Nat.mod_lt _ (by decide)⟩
theorem table_zero : table 0 = 1 := by decide
set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
theorem table_step : ∀ i : Fin 360, i ≠ 0 → (parent i).val < i.val ∧
    table i = table (parent i) * generatorMatrix (letter i) := by decide +kernel
set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
theorem cover_check : ∀ a b : Fin 16, pairing a b = 0 →
    ∀ c : Fin 16, pairing a c = 1 → pairing b c = 0 →
    ∀ d : Fin 16, pairing a d = 0 → pairing b d = 1 → pairing c d = 0 →
    mat a b c d = representative (witness a b c d) := by
  intro a
  fin_cases a <;> decide +kernel

theorem row_surjective : Function.Surjective row := by
  have h : ∀ v : Ix → ZMod 2, ∃ a : Fin 16, row a = v := by decide
  exact h

theorem mat_surjective (M : Mat) : ∃ a b c d : Fin 16, mat a b c d = M := by
  obtain ⟨a, ha⟩ := row_surjective (M (.inl 0))
  obtain ⟨b, hb⟩ := row_surjective (M (.inl 1))
  obtain ⟨c, hc⟩ := row_surjective (M (.inr 0))
  obtain ⟨d, hd⟩ := row_surjective (M (.inr 1))
  refine ⟨a, b, c, d, ?_⟩
  funext i
  fin_cases i <;> simp_all [mat]

theorem entry_formula (M : Mat) (i j : Ix) :
    (M * Matrix.J (Fin 2) (ZMod 2) * Mᵀ) i j =
    M i (.inl 0) * M j (.inr 0) + M i (.inl 1) * M j (.inr 1) +
    M i (.inr 0) * M j (.inl 0) + M i (.inr 1) * M j (.inl 1) := by
  simp only [Matrix.mul_apply, Fintype.sum_sum_type, Fin.sum_univ_two,
    Matrix.transpose_apply]
  simp [Matrix.J, Matrix.fromBlocks, Matrix.of_apply, add_assoc, add_comm, add_left_comm]

theorem symplectic_pairings (a b c d : Fin 16)
    (h : mat a b c d * Matrix.J (Fin 2) (ZMod 2) * (mat a b c d)ᵀ =
      Matrix.J (Fin 2) (ZMod 2)) :
    pairing a b = 0 ∧ pairing a c = 1 ∧ pairing a d = 0 ∧
      pairing b c = 0 ∧ pairing b d = 1 ∧ pairing c d = 0 := by
  have he (i j : Ix) := congrFun (congrFun h i) j
  simp only [entry_formula] at he
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_⟩
  · simpa [pairing, mat, Matrix.J, Matrix.fromBlocks] using he (.inl 0) (.inl 1)
  · simpa [pairing, mat, Matrix.J, Matrix.fromBlocks] using he (.inl 0) (.inr 0)
  · simpa [pairing, mat, Matrix.J, Matrix.fromBlocks] using he (.inl 0) (.inr 1)
  · simpa [pairing, mat, Matrix.J, Matrix.fromBlocks] using he (.inl 1) (.inr 0)
  · simpa [pairing, mat, Matrix.J, Matrix.fromBlocks] using he (.inl 1) (.inr 1)
  · simpa [pairing, mat, Matrix.J, Matrix.fromBlocks] using he (.inr 0) (.inr 1)

theorem commutator_le_of_two_cosets {G : Type*} [Group G] (H : Subgroup G)
    (t : G) (hcover : ∀ g, g ∈ H ∨ t⁻¹ * g ∈ H) : commutator G ≤ H := by
  have hi : H.index ∣ 2 := Subgroup.index_dvd_two_iff'.mpr
    ⟨t⁻¹, fun g => (hcover g).symm⟩
  rcases (Nat.dvd_prime Nat.prime_two).mp hi with hi | hi
  · rw [Subgroup.index_eq_one] at hi
    rw [hi]
    exact le_top
  rw [commutator_def, Subgroup.commutator_le]
  intro a _ b _
  simp only [commutatorElement_def, Subgroup.mul_mem_iff_of_index_two hi,
    Subgroup.inv_mem_iff]
  tauto


theorem table_mem (H : Subgroup Sp) (hgen : ∀ j, (generator j).val ∈ H) :
    ∀ i : Fin 360, ∃ g : Sp, g ∈ H ∧ g.val = table i := by
  intro i
  induction i using Fin.strong_induction_on with
  | h i ih =>
    by_cases hi : i = 0
    · subst i
      exact ⟨1, H.one_mem, table_zero.symm⟩
    obtain ⟨hp, hm⟩ := table_step i hi
    obtain ⟨g, hg, hgm⟩ := ih (parent i) hp
    refine ⟨g * (generator (letter i)).val, H.mul_mem hg (hgen _), ?_⟩
    change g.val * (generator (letter i)).val.val = table i
    rw [hgm, generator_val, hm]

theorem matrix_cover (g : Sp) :
    ∃ i : Fin 360, g.val = table i ∨ g.val = odd.val * table i := by
  obtain ⟨a, b, c, d, hm⟩ := mat_surjective g.val
  have hs : mat a b c d * Matrix.J (Fin 2) (ZMod 2) * (mat a b c d)ᵀ =
      Matrix.J (Fin 2) (ZMod 2) := by
    rw [hm]
    exact g.property
  obtain ⟨hab, hac, had, hbc, hbd, hcd⟩ := symplectic_pairings a b c d hs
  have hc := cover_check a b hab c hac hbc d had hbd hcd
  refine ⟨⟨(witness a b c d).val % 360, Nat.mod_lt _ (by decide)⟩, ?_⟩
  rw [← hm, hc]
  unfold representative
  split
  · exact Or.inl rfl
  · exact Or.inr rfl

theorem cover_subgroup (H : Subgroup Sp) (hgen : ∀ j, (generator j).val ∈ H) :
    ∀ g, g ∈ H ∨ odd⁻¹ * g ∈ H := by
  intro g
  obtain ⟨i, hi⟩ := matrix_cover g
  obtain ⟨x, hx, hxi⟩ := table_mem H hgen i
  rcases hi with hi | hi
  · left
    have : g = x := Subtype.ext (hi.trans hxi.symm)
    exact this ▸ hx
  · right
    have : g = odd * x := Subtype.ext (by simpa only [Submonoid.coe_mul, hxi] using hi)
    simpa only [this, inv_mul_cancel_left] using hx

/-- The three selected commutators generate the actual derived symplectic group. -/
public theorem closure_range_generator : Subgroup.closure (Set.range generator) = ⊤ := by
  let K := Subgroup.closure (Set.range generator)
  let H := K.map (commutator Sp).subtype
  have hgen : ∀ j, (generator j).val ∈ H := by
    intro j
    exact ⟨generator j, Subgroup.subset_closure ⟨j, rfl⟩, rfl⟩
  have hle := commutator_le_of_two_cosets H odd (cover_subgroup H hgen)
  apply top_unique
  intro g _
  obtain ⟨x, hx, he⟩ := hle g.property
  have he' : x = g := Subtype.ext he
  exact he' ▸ hx
end Representation.OneCohomology.SymplecticFour.BinaryField
