abbrev Ix := Fin 2 ⊕ Fin 2
abbrev Mat := Matrix Ix Ix (ZMod 2)
abbrev Sp := Matrix.symplecticGroup (Fin 2) (ZMod 2)
def row (a : Fin 16) : Ix → ZMod 2 :=
  Sum.elim ![(a.val : ZMod 2), ((a.val / 2 : Nat) : ZMod 2)]
    ![((a.val / 4 : Nat) : ZMod 2), ((a.val / 8 : Nat) : ZMod 2)]
def mat (a b c d : Fin 16) : Mat := Sum.elim ![row a, row b] ![row c, row d]
def decode (n : Nat) : Mat := mat ⟨n % 16, Nat.mod_lt _ (by decide)⟩
  ⟨n / 16 % 16, Nat.mod_lt _ (by decide)⟩
  ⟨n / 256 % 16, Nat.mod_lt _ (by decide)⟩
  ⟨n / 4096 % 16, Nat.mod_lt _ (by decide)⟩
def pairing (a b : Fin 16) : ZMod 2 :=
  row a (.inl 0) * row b (.inr 0) + row a (.inl 1) * row b (.inr 1) +
  row a (.inr 0) * row b (.inl 0) + row a (.inr 1) * row b (.inl 1)
