module

public import Theory.Representation.BinaryPermutationNaturalCover

/-!
# The perfect augmentation cover for A₆

The five-dimensional augmentation core is commutator-generated and its
projection onto the four-dimensional natural module has constant kernel.
Self-duality transfers the proved natural H¹ dimension to the dual module.
These are the concrete inputs to the universal-cover recognition.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), B.3.1–3,
printed pp.83–84, and I.1.5–6, printed p.408.
-/

@[expose] public section

open Module Representation Representation.OneCohomology Equiv
namespace BinaryPermutation

private lemma commutator_stable {k G W : Type*} [Field k] [Group G]
    [AddCommGroup W] [Module k W] (ρ : Representation k G W) (g : G) :
    Coinvariants.ker ρ ≤ (Coinvariants.ker ρ).comap (ρ g) := by
  apply Submodule.span_le.mpr
  rintro _ ⟨⟨h, v⟩, rfl⟩
  change ρ g (ρ h v - v) ∈ Coinvariants.ker ρ
  have he : ρ g (ρ h v - v) = (ρ (g * h) v - v) - (ρ g v - v) := by
    rw [map_sub, map_mul, Module.End.mul_apply]
    abel
  rw [he]
  exact (Coinvariants.ker ρ).sub_mem (Coinvariants.sub_mem_ker _ _)
    (Coinvariants.sub_mem_ker _ _)

/-- The augmentation module of A₆ is generated by its commutators. -/
lemma alternatingSix_core_generated :
    Coinvariants.ker (alternatingCoreRepresentation (Fin 6)) = ⊤ := by
  let ρ := alternatingCoreRepresentation (Fin 6)
  let C := Coinvariants.ker ρ
  let D := C.map (core (Fin 6)).subtype
  have hD : ∀ g : alternatingGroup (Fin 6), ∀ v ∈ D,
      representation (Fin 6) g.val v ∈ D := by
    intro g v hv
    obtain ⟨u, hu, rfl⟩ := hv
    exact ⟨ρ g u, commutator_stable ρ g hu, rfl⟩
  rcases invariant_le_constants_or_core_le (by decide : 5 ≤ Fintype.card (Fin 6)) D hD
      with h | h
  · let g : alternatingGroup (Fin 6) := ⟨swap 0 1 * swap 1 2, by
      simp [Perm.mem_alternatingGroup]⟩
    let v : core (Fin 6) := ⟨Pi.single 0 1 + Pi.single 3 1, by
      simp [mem_core, Finset.sum_add_distrib, CharTwo.add_self_eq_zero]⟩
    have hv : ρ g v - v ∈ C := Coinvariants.sub_mem_ker g v
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (h ⟨ρ g v - v, hv, rfl⟩)
    have hconst : (ρ g v - v).val 0 = (ρ g v - v).val 4 := by
      exact (congrFun hc.symm 0).trans (congrFun hc 4)
    have hne : (ρ g v - v).val 0 ≠ (ρ g v - v).val 4 := by decide
    exact (hne hconst).elim
  · apply top_unique
    intro v _
    obtain ⟨u, hu, he⟩ := h v.property
    have : u = v := Subtype.ext he
    exact this ▸ hu

/-- The five-dimensional augmentation module is a perfect central cover. -/
lemma alternatingSix_coreProjection_isCover :
    IsCover (alternatingCoreProjection (Fin 6)) := by
  refine ⟨coreToNatural_surjective, ?_, alternatingSix_core_generated⟩
  intro v hv g
  have hv' : v.val ∈ constants (Fin 6) := by
    apply (Submodule.Quotient.mk_eq_zero _).mp
    exact congrArg Subtype.val hv
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hv'
  apply Subtype.ext
  change representation (Fin 6) g.val v.val = v.val
  rw [← hc, map_smul, permute_allOne]

/-- Self-duality transfers I.1.6(1) to the coefficients used in I.1.5. -/
lemma alternatingSix_natural_dual_finrank_H1 :
    finrank (ZMod 2) (H1 (alternatingNaturalRepresentation (Fin 6)).dual) = 1 := by
  let E := H1Congr (alternatingNaturalRepresentation (Fin 6))
    (alternatingNaturalRepresentation (Fin 6)).dual
    (MulEquiv.refl (alternatingGroup (Fin 6))) (naturalDualEquiv (Fin 6))
    (fun g v => naturalDualEquiv_equivariant (Fin 6) g.val v)
  rw [← E.finrank_eq]
  exact alternatingSix_natural_finrank_H1

end BinaryPermutation
