module
public import Theory.Representation.SmallBinaryPrimeNormalizer
public import Theory.GroupTheory.PrimeSubgroupInvolution
public import Theory.GroupTheory.DihedralPresentation
public import Theory.GroupTheory.NormalizedSupCard
import Mathlib.Tactic

/-!
# Normal closures in the binary five-normalizer

In a faithful action on an elementary abelian group of order sixteen, a
normal subgroup of order five contains every product of two involutions.
Consequently a nontrivial elementary two-subgroup is generated by one
involution, and its normal closure is the dihedral group of order ten.

The product assertion is reused from `SmallBinaryPrimeNormalizer`. Its
conjugate-involution consequence makes the marked dihedral subgroup normal;
the nontrivial involution commutator recovers the entire five-subgroup.
The presentation then identifies the literal normal closure.

Source: Aschbacher--Smith G.9.4(2), printed pp.354--355, using the small binary
prime-normalizer argument of D.2.23--24.
-/

open Subgroup
open scoped IsMulCommutative
namespace SmallBinaryPrimeNormalizer
variable {G : Type*} [Group G] [Finite G]
private theorem inverts_five (B : Subgroup G) [B.Normal] (hB : Nat.card B = 5)
    (hC : Nat.card (centralizer (B : Set G)) ∣ 15)
    (t : G) (ht : t ^ 2 = 1) (htne : t ≠ 1) :
    ∀ b ∈ B, t * b * t⁻¹ = b⁻¹ := by
  rcases centralizes_or_inverts_prime_subgroup_of_sq_eq_one B (hB ▸ (by decide)) t ht
    (by rw [normalizer_eq_top]; trivial) with hc | hi
  · have hmem : t ∈ centralizer (B : Set G) := fun b hb => (hc b hb).eq.symm
    have ho : orderOf t = 2 := orderOf_eq_prime ht htne
    have hd := orderOf_dvd_natCard (⟨t, hmem⟩ : centralizer (B : Set G))
    rw [← orderOf_coe, ho] at hd
    have := hd.trans hC
    norm_num at this
  · exact hi

variable {V : Type*} [Group V] [Finite V] [IsElementaryAbelian 2 V]
  [MulDistribMulAction G V] [FaithfulSMul G V]

/-- In the order-five normalizer, all nontrivial elementary two-subgroups
have the same dihedral normal-closure geometry. -/
public theorem normalClosure_dihedral (hV : Nat.card V = 16) (B A : Subgroup G) [B.Normal]
    (hB : Nat.card B = 5) [IsElementaryAbelian 2 A] (hA : A ≠ ⊥)
    :
    Nonempty (normalClosure (A : Set G) ≃* DihedralGroup 5) := by
  classical
  have hC := card_centralizer_five_dvd_fifteen (V := V) B hB hV
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  have hex : ∃ t ∈ A, t ≠ (1 : G) := by
    by_contra h
    push Not at h
    exact hA (eq_bot_iff.mpr (fun a ha => mem_bot.mpr (h a ha)))
  obtain ⟨t, htA, htne⟩ := hex
  have ht : t ^ 2 = 1 := elemPow_eq_one_of_isElementaryAbelian t htA
  have hot : orderOf t = 2 := orderOf_eq_prime ht htne
  have hAt : A = zpowers t := by
    apply le_antisymm
    · intro a ha
      by_cases ha1 : a = 1
      · simp [ha1]
      have hat : a * t ∈ B := involution_mul_mem_five (V := V) B hB hV a t
        ⟨ha1, elemPow_eq_one_of_isElementaryAbelian a ha⟩ ⟨htne, ht⟩
      have h5 : orderOf (a * t) ∣ 5 := by
        simpa only [← orderOf_coe, hB] using orderOf_dvd_natCard (⟨a * t, hat⟩ : B)
      have h2 : orderOf (a * t) ∣ 2 := orderOf_dvd_of_pow_eq_one
        (elemPow_eq_one_of_isElementaryAbelian (a * t) (A.mul_mem ha htA))
      have haeq : a * t = 1 := orderOf_eq_one_iff.mp (Nat.eq_one_of_dvd_one (by
        simpa using Nat.dvd_gcd h5 h2))
      have hae : a = t := (eq_inv_of_mul_eq_one_left haeq).trans
        (inv_eq_of_mul_eq_one_right (by simpa [pow_two] using ht))
      exact hae ▸ mem_zpowers t
    · exact zpowers_le.mpr htA
  let J := B ⊔ zpowers t
  have hconj (g : G) : g * t * g⁻¹ ∈ J := by
    have hu : (g * t * g⁻¹) ^ 2 = 1 := by rw [conj_pow, ht]; group
    have hune : g * t * g⁻¹ ≠ 1 := by intro he; apply htne; simpa only [mul_assoc, inv_mul_cancel_left, inv_mul_cancel_right, mul_one, inv_mul_cancel] using congrArg (fun x => g⁻¹ * x * g) he
    have hc := involution_mul_mem_five (V := V) B hB hV (g * t * g⁻¹) t ⟨hune, hu⟩ ⟨htne, ht⟩
    have hm : ((g * t * g⁻¹) * t) * t ∈ J := J.mul_mem
      (mem_sup_left hc) (mem_sup_right (mem_zpowers t))
    simpa only [mul_assoc, show t * t = 1 by simpa [pow_two] using ht, mul_one] using hm
  have hJn : J.Normal := by
    constructor
    intro n hn g
    have hle : J ≤ (J.comap (MulAut.conj g).toMonoidHom) := by
      apply sup_le
      · intro b hb
        exact mem_sup_left ((inferInstance : B.Normal).conj_mem b hb g)
      · exact zpowers_le.mpr (hconj g)
    exact hle hn
  let _ := hJn
  let N := normalClosure (A : Set G)
  have hNJ : N ≤ J := normalClosure_le_normal (by rw [hAt]; exact fun x hx => mem_sup_right hx)
  have htN : t ∈ N := subset_normalClosure htA
  obtain ⟨b, hb⟩ := exists_prime_orderOf_dvd_card' (G := B) 5 (by rw [hB])
  have hob : orderOf (b : G) = 5 := by rw [orderOf_coe, hb]
  have hti := inverts_five B hB hC t ht htne b b.property
  have hb2N : (b : G) ^ 2 ∈ N := by
    have hm : (b : G) * t * (b : G)⁻¹ * t⁻¹ ∈ N :=
      N.mul_mem ((inferInstance : N.Normal).conj_mem t htN b) (N.inv_mem htN)
    convert hm using 1
    calc
      (b : G) ^ 2 = (b : G) * (t * (b : G)⁻¹ * t⁻¹) := by
        rw [inverts_five B hB hC t ht htne b⁻¹ (B.inv_mem b.property), inv_inv, pow_two]
      _ = (b : G) * t * (b : G)⁻¹ * t⁻¹ := by group
  have hb2order : orderOf ((b : G) ^ 2) = 5 := by rw [orderOf_pow, hob]; decide
  have hBpow : B = zpowers ((b : G) ^ 2) := eq_of_le_of_card_ge
    (zpowers_le.mpr (B.pow_mem b.property 2)) (by rw [Nat.card_zpowers, hb2order, hB]) |>.symm
  have hBN : B ≤ N := by rw [hBpow]; exact zpowers_le.mpr hb2N
  have hNJ_eq : N = J := le_antisymm hNJ (sup_le hBN (zpowers_le.mpr htN))
  have hJcard : Nat.card J = 2 * 5 := by
    rw [card_sup_eq_mul_of_normalizes_of_disjoint B (zpowers t) le_normalizer_of_normal
      (disjoint_of_coprime_natCard (by rw [hB, Nat.card_zpowers, hot]; decide)), hB,
      Nat.card_zpowers, hot]
  let bJ : J := ⟨b, mem_sup_left b.property⟩
  let tJ : J := ⟨t, mem_sup_right (mem_zpowers t)⟩
  have hBgen : zpowers (b : G) = B := eq_of_le_of_card_ge (zpowers_le.mpr b.property)
    (by rw [Nat.card_zpowers, hob, hB])
  have hgen : closure ({bJ, tJ} : Set J) = ⊤ := by
    apply (map_injective J.subtype_injective)
    rw [MonoidHom.map_closure, Set.image_pair, ← MonoidHom.range_eq_map, J.range_subtype]
    change closure ({(b : G), t} : Set G) = J
    rw [show ({(b : G), t} : Set G) = {(b : G)} ∪ {t} by ext; simp [or_comm],
      Subgroup.closure_union, ← zpowers_eq_closure, ← zpowers_eq_closure, hBgen]
  obtain ⟨f⟩ := dihedralGroup_equiv_of_presentation (by decide : 0 < 5) bJ tJ
    (by simpa only [← orderOf_coe] using hob)
    (by apply Subtype.ext; exact ht)
    (by apply Subtype.ext; exact hti) hgen hJcard
  exact ⟨(MulEquiv.subgroupCongr hNJ_eq).trans f⟩

end SmallBinaryPrimeNormalizer
