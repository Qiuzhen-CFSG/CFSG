module
public import Theory.Representation.NormalConstituentDisplacement.FixedLine
public import Theory.Representation.BinaryOffender.Homogeneous.Selection.NormalType

/-!
# Homogeneous restriction from a preserved seed and commuting generators

Let R be normal in an irreducible binary actor group. A simple R-submodule
has full type inertia if the actor group is generated by R, operators
commuting with R, and operators preserving that actual submodule. Clifford
semisimplicity then gives finite copy coordinates for the entire restriction.
The coordinate equation retains every original R-operator.

This is the homogeneous-restriction step in Aschbacher–Smith 8.2.9,
printed p.721, refs/quasithin.pdf, using Clifford's theorem (A.1.42).
-/

public noncomputable section
open Subgroup Representation
open scoped MonoidAlgebra

namespace Representation
open BinaryOffender.Homogeneous
variable {Γ W : Type*} [Group Γ] [AddCommGroup W] [Module (ZMod 2) W]
  [FiniteDimensional (ZMod 2) W]
set_option backward.isDefEq.respectTransparency false

/-- A preserved simple seed and commuting generators give actual homogeneous
coordinates, without a homogeneity or semisimplicity premise. -/
theorem homogeneous_coordinates_of_commuting_and_stable
    (ρ : Representation (ZMod 2) Γ W) [ρ.IsIrreducible]
    (R C P : Subgroup Γ) [R.Normal]
    (hgen : (R ⊔ C) ⊔ P = ⊤)
    (S : Subrepresentation (ρ.comp R.subtype)) (hS : S.toRepresentation.IsIrreducible)
    (hC : ∀ c ∈ C, ∀ r : R, Commute (ρ c) (ρ r))
    (hP : ∀ p ∈ P, S.toSubmodule.map (ρ p) = S.toSubmodule) :
    ∃ m : ℕ, ∃ e : W ≃ₗ[ZMod 2] (Fin m → S.toSubmodule),
      ∀ (r : R) w, e (ρ r w) = fun i => S.toRepresentation r (e w i) := by
  let c := normalTypeAction ρ R
  have hCI : C ≤ c.inertia S := by
    intro g hg
    change SameModule S (c.conjugate g S)
    let U := c.conjugate g S
    have hm : S.toSubmodule.map (ρ g) = U.toSubmodule :=
      (conjugateSubrepresentationOrderIso_toSubmodule ρ R g S).symm
    let e : S.toSubmodule ≃ₗ[ZMod 2] U.toSubmodule :=
      (S.toSubmodule.equivMapOfInjective (ρ g) (apply_bijective ρ g).injective).trans
        (LinearEquiv.ofEq _ _ hm)
    refine ⟨e,?_⟩
    intro r w
    apply Subtype.ext
    exact LinearMap.congr_fun (hC g hg r).eq w
  have hPI : P ≤ c.inertia S := by
    intro p hp
    change SameModule S (c.conjugate p S)
    have he : c.conjugate p S = S := by
      apply Subrepresentation.toSubmodule_injective
      exact (conjugateSubrepresentationOrderIso_toSubmodule ρ R p S).trans (hP p hp)
    rw [he]
    exact SameModule.refl S
  have ht : c.inertia S = ⊤ := by
    apply top_unique
    rw [←hgen]
    exact sup_le (sup_le (normal_le_typeInertia ρ R S) hCI) hPI
  have htype := restriction_isotypic_of_typeInertia_top ρ R S hS ht
  let τ : Representation (ZMod 2) R W := ρ.comp R.subtype
  let := NormalConstituentDisplacement.restriction_semisimple ρ inferInstance R
  let := simple_asSubmodule S hS
  let : Module.Finite (ZMod 2) τ.asModule := τ.asModuleEquiv.symm.finiteDimensional
  let : Module.Finite (ZMod 2)[R] τ.asModule := Module.Finite.of_restrictScalars_finite (ZMod 2) _ _
  obtain ⟨m,⟨a⟩⟩ := htype.linearEquiv_fun
  let e : W ≃ₗ[ZMod 2] (Fin m → S.toSubmodule) :=
    τ.asModuleEquiv.symm.trans (a.restrictScalars (ZMod 2))
  refine ⟨m,e,?_⟩
  intro r w
  change a (τ.asModuleEquiv.symm (τ r w)) = _
  rw [τ.asModuleEquiv_symm_map_rho,a.map_smul]
  funext i
  apply Subtype.ext
  change τ.asModuleEquiv ((MonoidAlgebra.of (ZMod 2) R r) •
    (a (τ.asModuleEquiv.symm w) i).val) = _
  rw [τ.asModuleEquiv_map_smul,Representation.asAlgebraHom_of]
  rfl
end Representation
