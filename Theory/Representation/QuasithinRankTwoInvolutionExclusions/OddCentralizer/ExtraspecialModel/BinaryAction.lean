module

public import Theory.Representation.QuasithinRankTwoInvolutionExclusions.OddCentralizer.ExtraspecialModel.BinaryAction.Operators
import Mathlib.Tactic

/-!
# A faithful binary six-dimensional extraspecial-three extension

The explicit Heisenberg and semidihedral operators extend to the published
semidirect product. A kernel element acts trivially on the Heisenberg plane;
faithfulness of the complement on that plane and of the Heisenberg operators
then proves faithfulness of the whole representation.

The resulting equivalence with the subgroup generated by X, Y, C, R and B
preserves the literal Heisenberg kernel and the marked four-group preimage.
The latter image is generated by X, Y, C, R⁴ and B. The binary dimension is six.
In particular, every subgroup inherits an actual faithful representation,
ready for the degree-six cubic-witness and rank-two consumers.

Source: Aschbacher–Smith, G.9.4(5), printed pp.354–355; G.11.2(3), printed
p.364; and the cubic-center argument in 6.2.19, printed p.691. This is the
explicit model representation, not the general normalizer classification.
-/

@[expose] public section

namespace Representation.RankTwo.ExtraspecialModel.BinaryAction
def linearAction : Model →* (V ≃ₗ[ZMod 2] V) :=
  SemidirectProduct.lift heisenberg complement (by
    intro s
    apply MonoidHom.ext
    intro p
    exact compatibility s p)

lemma linearAction_inl (p : P) : linearAction (SemidirectProduct.inl p) = heisenberg p :=
  SemidirectProduct.lift_inl _ _ _ p
lemma linearAction_inr (s : S) : linearAction (SemidirectProduct.inr s) = complement s :=
  SemidirectProduct.lift_inr _ _ _ s

lemma linearAction_injective : Function.Injective linearAction := by
  apply (MonoidHom.ker_eq_bot_iff _).mp
  apply eq_bot_iff.mpr
  intro g hg
  have hker : heisenberg g.left * complement g.right = 1 := hg
  have hc : complement g.right = (heisenberg g.left)⁻¹ :=
    eq_inv_of_mul_eq_one_right hker
  have hs : g.right = 1 := by
    apply complement_eq_one_of_fixes_plane
    intro p
    have hh := compatibility g.right p
    rw [hc, inv_inv, ← map_inv, ← map_mul, ← map_mul] at hh
    have he := heisenberg_injective hh
    constructor
    · have ha := congrArg HeisenbergPrime.a he
      simpa only [HeisenbergPrime.mul_a, HeisenbergPrime.inv_a,
        neg_add_cancel_left, add_neg_cancel_right, add_assoc, add_left_comm, add_comm, add_neg_cancel, add_zero] using ha
    · have hb := congrArg HeisenbergPrime.b he
      simpa only [HeisenbergPrime.mul_b, HeisenbergPrime.inv_b,
        neg_add_cancel_left, add_neg_cancel_right, add_assoc, add_left_comm, add_comm, add_neg_cancel, add_zero] using hb
  rw [hs, map_one, mul_one] at hker
  have hp : g.left = 1 := heisenberg_injective (hker.trans heisenberg.map_one.symm)
  change g = 1
  exact SemidirectProduct.ext hp hs

def representation : Representation (ZMod 2) Model V where
  toFun g := (linearAction g).toLinearMap
  map_one' := by rw [map_one]; rfl
  map_mul' g h := by rw [map_mul]; rfl
lemma representation_injective : Function.Injective representation := by
  intro g h he
  apply linearAction_injective
  exact LinearEquiv.toLinearMap_injective he

lemma finrank_vector : Module.finrank (ZMod 2) V = 6 := by
  have h := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := V)
  have hcard : Fintype.card V = 64 := by
    rw [Fintype.card_fun, SL2FourNatural.card_field, ZMod.card]
    rfl
  rw [Nat.card_eq_fintype_card, hcard, Nat.card_eq_fintype_card, ZMod.card] at h
  exact (Nat.pow_right_injective (by decide : 1 < (2 : ℕ))
    (show 2 ^ 6 = 2 ^ Module.finrank (ZMod 2) V from h)).symm


def X : V ≃ₗ[ZMod 2] V := heisenberg ⟨1, 0, 0⟩
def Y : V ≃ₗ[ZMod 2] V := heisenberg ⟨0, 1, 0⟩
def C : V ≃ₗ[ZMod 2] V := heisenberg ⟨0, 0, 1⟩
lemma X_apply (f : V) (t : ZMod 3) : X f t = f (t + 1) := by
  simp [X, heisenberg_apply, w]
lemma Y_apply (f : V) (t : ZMod 3) : Y f t = w ^ t.val * f t := by
  simp [Y, heisenberg_apply]
lemma C_apply (f : V) (t : ZMod 3) : C f t = w * f t := by
  simp [C, heisenberg_apply, ZMod.val_one]
lemma heisenberg_normal_form (p : P) :
    heisenberg p = Y ^ p.b.val * X ^ p.a.val * C ^ p.c.val := by
  simp only [X, Y, C, ← map_pow, ← map_mul]
  apply congrArg heisenberg
  rcases p with ⟨a, b, c⟩
  fin_cases a <;> fin_cases b <;> fin_cases c <;> apply HeisenbergPrime.ext <;> decide

def heisenbergImage : Subgroup (V ≃ₗ[ZMod 2] V) := Subgroup.closure {X, Y, C}
def complementImage : Subgroup (V ≃ₗ[ZMod 2] V) := Subgroup.closure {R, B}
def binaryImage : Subgroup (V ≃ₗ[ZMod 2] V) := heisenbergImage ⊔ complementImage
def fourImage : Subgroup (V ≃ₗ[ZMod 2] V) := heisenbergImage ⊔ Subgroup.closure {R ^ 4, B}

lemma heisenbergImage_eq_range : heisenbergImage = heisenberg.range := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl
    · exact ⟨⟨1, 0, 0⟩, rfl⟩
    · exact ⟨⟨0, 1, 0⟩, rfl⟩
    · exact ⟨⟨0, 0, 1⟩, rfl⟩
  · rintro _ ⟨p, rfl⟩
    rw [heisenberg_normal_form]
    have hx : X ∈ heisenbergImage := Subgroup.subset_closure (by simp)
    have hy : Y ∈ heisenbergImage := Subgroup.subset_closure (by simp)
    have hc : C ∈ heisenbergImage := Subgroup.subset_closure (by simp)
    exact mul_mem (mul_mem (pow_mem hy _) (pow_mem hx _)) (pow_mem hc _)

lemma complementImage_eq_range : complementImage = complement.range := by
  have h := congrArg (Subgroup.map complement)
    (Semidihedral.standard_generators 4 (Nat.le_refl 4))
  simpa only [complementImage, MonoidHom.map_closure, Set.image_insert_eq, Set.image_singleton,
    complement_rotation, complement_reflection, ← MonoidHom.range_eq_map] using h

lemma map_preimage (H : Subgroup S) :
    (H.comap projection).map linearAction = heisenberg.range ⊔ H.map complement := by
  apply le_antisymm
  · rintro _ ⟨g, hg, rfl⟩
    change heisenberg g.left * complement g.right ∈ _
    have hl : heisenberg.range ≤ heisenberg.range ⊔ H.map complement := le_sup_left
    have hr : H.map complement ≤ heisenberg.range ⊔ H.map complement := le_sup_right
    exact mul_mem (hl ⟨g.left, rfl⟩) (hr ⟨g.right, hg, rfl⟩)
  · apply sup_le
    · rintro _ ⟨p, rfl⟩
      exact ⟨SemidirectProduct.inl p, H.one_mem, linearAction_inl p⟩
    · rintro _ ⟨s, hs, rfl⟩
      exact ⟨SemidirectProduct.inr s, hs, linearAction_inr s⟩

lemma binaryImage_eq_range : binaryImage = linearAction.range := by
  simpa only [Subgroup.comap_top, ← MonoidHom.range_eq_map, heisenbergImage_eq_range,
    complementImage_eq_range, binaryImage] using (map_preimage ⊤).symm
lemma map_core : core.map linearAction = heisenbergImage := by
  have h : core = (SemidirectProduct.inl : P →* Model).range :=
    SemidirectProduct.range_inl_eq_ker_rightHom.symm
  rw [h, MonoidHom.map_range]
  have hh : linearAction.comp SemidirectProduct.inl = heisenberg := by
    apply MonoidHom.ext
    exact linearAction_inl
  rw [hh, ← heisenbergImage_eq_range]
lemma map_fourExtension : fourExtension.map linearAction = fourImage := by
  rw [fourExtension, map_preimage, four, MonoidHom.map_closure]
  simp only [Set.image_insert_eq, Set.image_singleton, map_pow,
    complement_rotation, complement_reflection, fourImage, heisenbergImage_eq_range]

noncomputable def modelEquiv : Model ≃* binaryImage :=
  (MonoidHom.ofInjective linearAction_injective).trans
    (MulEquiv.subgroupCongr binaryImage_eq_range.symm)
lemma modelEquiv_apply (g : Model) : (modelEquiv g : V ≃ₗ[ZMod 2] V) = linearAction g := rfl
lemma modelEquiv_core :
    core.map modelEquiv.toMonoidHom = heisenbergImage.comap binaryImage.subtype := by
  apply Subgroup.map_injective binaryImage.subtype_injective
  rw [Subgroup.map_map]
  change core.map linearAction = _
  rw [Subgroup.map_comap_eq_self, map_core]
  rw [Subgroup.range_subtype]
  exact le_sup_left
lemma modelEquiv_fourExtension :
    fourExtension.map modelEquiv.toMonoidHom = fourImage.comap binaryImage.subtype := by
  apply Subgroup.map_injective binaryImage.subtype_injective
  rw [Subgroup.map_map]
  change fourExtension.map linearAction = _
  rw [Subgroup.map_comap_eq_self, map_fourExtension]
  rw [Subgroup.range_subtype, ← map_fourExtension, binaryImage_eq_range]
  exact Subgroup.map_le_range _ _

lemma representation_inl (p : P) (f : V) (t : ZMod 3) :
    representation (SemidirectProduct.inl p) f t =
      w ^ (p.c + p.b * t).val * f (t + p.a) := by
  change linearAction (SemidirectProduct.inl p) f t = _
  rw [linearAction_inl, heisenberg_apply]
lemma representation_rotation (f : V) :
    representation (SemidirectProduct.inr (Semidihedral.standardRotation 4 (Nat.le_refl 4))) f =
      matrixM.mulVec (fun t => (f t)^2) := by
  change linearAction (SemidirectProduct.inr _) f = _
  rw [linearAction_inr, complement_rotation]
  rfl
lemma representation_reflection (f : V) :
    representation (SemidirectProduct.inr (Semidihedral.standardReflection 4 (Nat.le_refl 4))) f =
      matrixN.mulVec (fun t => (f t)^2) := by
  change linearAction (SemidirectProduct.inr _) f = _
  rw [linearAction_inr, complement_reflection]
  rfl
lemma representation_restrict_injective (H : Subgroup Model) :
    Function.Injective (representation.comp H.subtype) :=
  representation_injective.comp H.subtype_injective

/-- The image equivalence induces exactly the constructed representation. -/
lemma modelEquiv_representation (g : Model) :
    (modelEquiv g : V ≃ₗ[ZMod 2] V).toLinearMap = representation g := rfl

end Representation.RankTwo.ExtraspecialModel.BinaryAction
