module

public import Theory.SpecificGroups.HeisenbergPrime
public import Theory.GroupTheory.SemidihedralStandardModel
-- Internal same-package construction: the canonical generator definitions have
-- private bodies. Only their two action equations below are exported.
import all Theory.GroupTheory.SemidihedralStandardModel
public import Theory.GroupTheory.SemidihedralFourSubgroup
import Mathlib.Tactic
/-!
# A marked extraspecial-by-semidihedral group

On Heisenberg triples over F₃, the two automorphisms below induce the
matrices `[[1,1],[1,0]]` and `[[2,0],[1,1]]` on the first two coordinates.
The corrected third coordinate makes them genuine group automorphisms.
They satisfy the SD₁₆ relations. The sixteen pairs of coordinate images
are distinguished by small kernel-checked calculations, proving faithfulness
on P/Z(P). Their semidirect product with P has order 432.

The preimage of the four-group generated by the central involution and
the reflection is a specified subgroup of order 108, with its actual
semidirect-product equivalence. This is the model construction for the
SD₁₆/3^(1+2) and E₄/3^(1+2) notation in Aschbacher–Smith G.9.4(5),
printed pp.354–355, and G.11.2(3), printed p.364. Identification with the
binary linear normalizer requires a faithful binary representation; this
module does not assume or assert that identification.
-/

public section

open Subgroup
namespace Representation.RankTwo.ExtraspecialModel
abbrev P := HeisenbergPrime 3

@[expose] def rotate : MulAut P where
  toFun x := ⟨x.a+x.b,x.a,2*x.c+2*x.a^2+x.a*x.b⟩
  invFun x := ⟨x.b,x.a-x.b,2*x.c+x.b^2+x.a*x.b⟩
  left_inv x := by
    ext <;> simp
    ring_nf
    reduce_mod_char
  right_inv x := by
    ext <;> simp
    ring_nf
    reduce_mod_char
  map_mul' x y := by
    ext <;> simp
    all_goals ring_nf
    all_goals reduce_mod_char

@[expose] def reflect : MulAut P where
  toFun x := ⟨2*x.a,x.a+x.b,2*x.c+x.a^2⟩
  invFun x := ⟨2*x.a,x.a+x.b,2*x.c+x.a^2⟩
  left_inv x := by ext <;> simp <;> ring_nf <;> reduce_mod_char
  right_inv x := by ext <;> simp <;> ring_nf <;> reduce_mod_char
  map_mul' x y := by ext <;> simp <;> ring

lemma rotate_eight : rotate ^ 8 = 1 := by
  apply MulEquiv.ext
  intro x
  change (rotate ^ 8) x = x
  rcases x with ⟨a,b,c⟩
  simp only [show (8 : ℕ) = 2*2*2 by rfl, pow_mul, pow_two, MulAut.mul_apply,
    rotate, MulEquiv.coe_mk, Equiv.coe_fn_mk]
  ext <;> ring_nf <;> reduce_mod_char

lemma reflect_two : reflect ^ 2 = 1 := by
  apply MulEquiv.ext
  intro x
  change reflect (reflect x) = x
  ext <;> simp [reflect] <;> ring_nf <;> reduce_mod_char

lemma reflect_rotate : reflect * rotate * reflect⁻¹ = rotate ^ 3 := by
  apply MulEquiv.ext
  intro x
  change reflect (rotate (reflect.symm x)) = rotate (rotate (rotate x))
  ext <;> simp [reflect, rotate] <;> ring_nf <;> reduce_mod_char

private def cyclicHom {G : Type*} [Group G] {m : ℕ} [NeZero m]
    (a : G) (ha : a ^ m = 1) : Multiplicative (ZMod m) →* G where
  toFun i := a ^ i.toAdd.val
  map_one' := by simp
  map_mul' i j := by
    change a ^ (i.toAdd + j.toAdd).val = a ^ i.toAdd.val * a ^ j.toAdd.val
    rw [ZMod.val_add, ← pow_add]
    exact (pow_eq_pow_mod _ ha).symm

private theorem cyclicHom_one {G : Type*} [Group G] {m : ℕ} [NeZero m]
    (a : G) (ha : a ^ m = 1) : cyclicHom a ha (.ofAdd 1) = a := by
  change a ^ (1 : ZMod m).val = a
  rw [← Nat.cast_one, ZMod.val_natCast, ← pow_eq_pow_mod 1 ha, pow_one]

abbrev S := Semidihedral.StandardModel 4 (Nat.le_refl 4)

/-- The standard SD16 presentation defines a homomorphism from the fixed
complement, with the generator values retained below. -/
def complementHom {G : Type*} [Group G] (a b : G)
    (ha : a ^ 8 = 1) (hb : b ^ 2 = 1) (hab : b * a * b⁻¹ = a ^ 3) : S →* G :=
  SemidirectProduct.lift (cyclicHom a ha) (cyclicHom b hb) (by
    intro g
    have hg : g = 1 ∨ g = Multiplicative.ofAdd 1 := by
      change g.toAdd = 0 ∨ g.toAdd = 1
      exact (by decide : ∀ k : ZMod 2, k = 0 ∨ k = 1) g.toAdd
    rcases hg with rfl | rfl
    · apply MonoidHom.ext
      intro x
      simp
    · apply MonoidHom.ext
      intro x
      simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
        Semidihedral.standardAction_generator, Semidihedral.standardTwist_apply,
        show (2 ^ (4 - 2) - 1 : ℕ) = 3 from rfl, map_pow,
        cyclicHom_one, MulAut.conj_apply]
      change (a ^ x.toAdd.val) ^ 3 = b * a ^ x.toAdd.val * b⁻¹
      rw [← MulAut.conj_apply, map_pow, MulAut.conj_apply, hab]
      exact pow_right_comm a _ _)

lemma complementHom_rotation {G : Type*} [Group G] (a b : G)
    (ha : a ^ 8 = 1) (hb : b ^ 2 = 1) (hab : b * a * b⁻¹ = a ^ 3) :
    complementHom a b ha hb hab (Semidihedral.standardRotation 4 (Nat.le_refl 4)) = a := by
  simp [complementHom, Semidihedral.standardRotation, cyclicHom_one]

lemma complementHom_reflection {G : Type*} [Group G] (a b : G)
    (ha : a ^ 8 = 1) (hb : b ^ 2 = 1) (hab : b * a * b⁻¹ = a ^ 3) :
    complementHom a b ha hb hab (Semidihedral.standardReflection 4 (Nat.le_refl 4)) = b := by
  simp [complementHom, Semidihedral.standardReflection, cyclicHom_one]

/-- The actual action used for the extraspecial extension. -/
def action : S →* MulAut P := complementHom rotate reflect rotate_eight reflect_two reflect_rotate

lemma action_rotation : action (Semidihedral.standardRotation 4 (Nat.le_refl 4)) = rotate :=
  complementHom_rotation _ _ _ _ _

lemma action_reflection : action (Semidihedral.standardReflection 4 (Nat.le_refl 4)) = reflect :=
  complementHom_reflection _ _ _ _ _

private def planeImages (f : MulAut P) : ZMod 3 × ZMod 3 × ZMod 3 × ZMod 3 :=
  ((f ⟨1,0,0⟩).a, (f ⟨1,0,0⟩).b, (f ⟨0,1,0⟩).a, (f ⟨0,1,0⟩).b)

private lemma rotation_separates : ∀ i : Fin 8,
    planeImages (rotate ^ i.val) = planeImages 1 → i.val = 0 := by decide +kernel

private lemma reflection_separates : ∀ i : Fin 8,
    planeImages (rotate ^ i.val * reflect) ≠ planeImages 1 := by decide +kernel

private lemma eq_one_of_planeImages (x : S)
    (hx1 : planeImages (action x) = planeImages 1) : x = 1 := by
  obtain ⟨i, hi, he | he⟩ := Semidihedral.normal_form
    (Semidihedral.standardRotation 4 (Nat.le_refl 4))
    (Semidihedral.standardReflection 4 (Nat.le_refl 4)) 8 3 (by decide)
    (Semidihedral.standardRotation_order 4 (Nat.le_refl 4))
    (by simpa only [Semidihedral.standardReflection_order] using
      pow_orderOf_eq_one (Semidihedral.standardReflection 4 (Nat.le_refl 4)))
    (Semidihedral.standard_conjugation 4 (Nat.le_refl 4))
    (Semidihedral.standard_generators 4 (Nat.le_refl 4)) x
  · rw [he, map_pow, action_rotation] at hx1
    have hi0 := rotation_separates ⟨i,hi⟩ hx1
    change i = 0 at hi0
    simp [he, hi0]
  · rw [he, map_mul, map_pow, action_rotation, action_reflection] at hx1
    exact False.elim (reflection_separates ⟨i,hi⟩ hx1)

/-- The action is faithful even on the two noncentral coordinates, hence on
P/Z(P), rather than just on the whole Heisenberg group. -/
lemma complement_eq_one_of_fixes_plane (x : S)
    (hx : ∀ p : P, (action x p).a = p.a ∧ (action x p).b = p.b) : x = 1 := by
  apply eq_one_of_planeImages
  obtain ⟨ha,hb⟩ := hx ⟨1,0,0⟩
  obtain ⟨hc,hd⟩ := hx ⟨0,1,0⟩
  exact Prod.ext ha (Prod.ext hb (Prod.ext hc hd))

/-- The concrete action embeds SD16 into the automorphism group. -/
lemma action_injective : Function.Injective action := by
  apply (MonoidHom.ker_eq_bot_iff _).mp
  apply eq_bot_iff.mpr
  intro x hx
  exact eq_one_of_planeImages x (congrArg planeImages (show action x = 1 from hx))

abbrev Model := P ⋊[action] S

instance modelFinite : Finite Model := Finite.of_equiv _ SemidirectProduct.equivProd.symm

lemma model_card : Nat.card Model = 432 := by
  rw [SemidirectProduct.card, HeisenbergPrime.card, Semidihedral.standardModel_card]
  norm_num

/-- The marked elementary four-subgroup in the SD16 complement. -/
@[expose] def four : Subgroup S := closure
  ({Semidihedral.standardRotation 4 (Nat.le_refl 4) ^ 4,
    Semidihedral.standardReflection 4 (Nat.le_refl 4)} : Set S)

lemma four_structure : IsElementaryAbelian 2 four ∧ Nat.card four = 4 := by
  exact Semidihedral.canonical_four (H := S) (n := 4) (Nat.le_refl 4)
    (Semidihedral.standardRotation 4 (Nat.le_refl 4))
    (Semidihedral.standardReflection 4 (Nat.le_refl 4))
    (Semidihedral.standardRotation_order 4 (Nat.le_refl 4))
    (Semidihedral.standardReflection_order 4 (Nat.le_refl 4))
    (Semidihedral.standard_conjugation 4 (Nat.le_refl 4))
    (Semidihedral.standard_generators 4 (Nat.le_refl 4))

/-- The literal projection onto the SD16 complement. -/
@[expose] def projection : Model →* S := SemidirectProduct.rightHom

/-- The specified E4 extension of the Heisenberg subgroup. -/
@[expose] def fourExtension : Subgroup Model := four.comap projection

/-- The normal extraspecial kernel. -/
@[expose] def core : Subgroup Model := projection.ker

lemma core_le_fourExtension : core ≤ fourExtension := by
  intro x hx
  change projection x ∈ four
  change projection x = 1 at hx
  rw [hx]
  exact four.one_mem

/-- The marked preimage is exactly the semidirect extension by the four-group. -/
@[expose] def fourExtensionEquiv : fourExtension ≃* P ⋊[action.comp four.subtype] four where
  toFun x := ⟨x.val.left, ⟨x.val.right, x.property⟩⟩
  invFun x := ⟨⟨x.left, x.right⟩, x.right.property⟩
  left_inv _ := rfl
  right_inv _ := rfl
  map_mul' _ _ := rfl

lemma fourExtension_card : Nat.card fourExtension = 108 := by
  rw [Nat.card_congr fourExtensionEquiv.toEquiv, SemidirectProduct.card,
    HeisenbergPrime.card, four_structure.2]
  norm_num

end Representation.RankTwo.ExtraspecialModel
