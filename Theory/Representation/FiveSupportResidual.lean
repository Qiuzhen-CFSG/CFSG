module
public import Theory.Representation.SmallBinaryPrimeNormalizer
public import Theory.Representation.BinaryOffender.CommutatorRank
public import Theory.Representation.BinaryOffender.RestrictionComparison
public import Theory.Representation.BinaryOffender.InvariantAction
public import Theory.Representation.BinaryOffender.ActionImage
public import Theory.GroupTheory.PResidual.NormalSubgroup
public import Theory.GroupTheory.PResidual.Quotient

/-!
# Quintic residuals detected on binary four-dimensional supports

A faithful binary four-dimensional image with a normal cyclic group of order
five, generated by involutions, is the dihedral group supplied by the small
prime normalizer endpoint. Its two-residual lies in that cyclic group. A
separating family of these images therefore forces fifth powers to vanish on
the two-residual, so it is a five-group. No finiteness of the indexing family
is needed. The invariant-subspace consumer uses the literal action images;
spanning by the supports and the globally fixed space proves separation.

Source application: Aschbacher--Smith D.2.23, printed p.189, and the
original-action odd residual reduction in 15.1.2, printed pp.1084--1085.
-/

public section
open Subgroup Representation Representation.BinaryOffender
namespace Representation.SmallBinaryPrimeNormalizer

private theorem image_involution_generated {N H : Type*} [Group N] [Group H]
    (f : N →* H) (hf : Function.Surjective f)
    (hgen : closure {s : N | IsInvolution s} = ⊤) :
    closure {s : H | IsInvolution s} = ⊤ := by
  apply top_unique
  rw [← map_top_of_surjective f hf, ← hgen, MonoidHom.map_closure]
  apply (closure_le _).2
  rintro _ ⟨s,hs,rfl⟩
  by_cases he : f s = 1
  · exact he ▸ one_mem _
  · apply Subgroup.subset_closure
    exact ⟨he, by rw [← map_pow,hs.2,map_one]⟩

/-- The binary four-dimensional image has quintic two-residual. -/
theorem five_residual_le {G V : Type*} [Group G] [Finite G]
    [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (ρ : Representation (ZMod 2) G V) (hf : Function.Injective ρ)
    (hdim : Module.finrank (ZMod 2) V = 4)
    (D : Subgroup G) [D.Normal] (hD : Nat.card D = 5)
    (hgen : closure {s : G | IsInvolution s} = ⊤) :
    pResidual 2 G ≤ D := by
  classical
  have ht : ∃ t : G, IsInvolution t := by
    by_contra he
    have hb : closure {s : G | IsInvolution s} = ⊥ := by
      apply le_antisymm _ bot_le
      apply (closure_le _).2
      intro s hs
      exact False.elim (he ⟨s,hs⟩)
    have hDb : D = ⊥ := bot_unique (by rw [← hb,hgen]; exact le_top)
    simp [hDb] at hD
  obtain ⟨t,ht⟩ := ht
  have hjoin := (five_generation ρ hf hdim D hD hgen t ht).1
  have htwo : IsPGroup 2 (zpowers t) := IsPGroup.of_card_dvd_pow (n := 1) (by
    simpa only [Nat.card_zpowers,pow_one] using orderOf_dvd_of_pow_eq_one ht.2)
  exact (pResidual_le_iff_isPGroup_quotient 2 D).mpr
    (isPGroup_quotient_of_sup_eq_top D (zpowers t) htwo hjoin)

/-- A separating family of faithful binary four-dimensional images with normal
quintic groups makes the two-residual a five-group. The index set may be infinite. -/
theorem five_residual_of_separating_images {N I : Type*} [Group N] [Finite N]
    (G : I → Type*) [∀ i, Group (G i)]
    (V : I → Type*) [∀ i, AddCommGroup (V i)] [∀ i, Module (ZMod 2) (V i)]
    [∀ i, FiniteDimensional (ZMod 2) (V i)]
    (φ : ∀ i, N →* G i) (hφ : ∀ i, Function.Surjective (φ i))
    (hsep : ∀ x : N, (∀ i, φ i x = 1) → x = 1)
    (hgen : closure {s : N | IsInvolution s} = ⊤)
    (σ : ∀ i, Representation (ZMod 2) (G i) (V i))
    (hfaith : ∀ i, Function.Injective (σ i))
    (hdim : ∀ i, Module.finrank (ZMod 2) (V i) = 4)
    (B : ∀ i, Subgroup (G i)) [∀ i, (B i).Normal]
    (hB : ∀ i, Nat.card (B i) = 5) :
    IsPGroup 5 (pResidual 2 N) := by
  intro x
  refine ⟨1,Subtype.ext ?_⟩
  change (x : N) ^ 5 ^ 1 = 1
  rw [pow_one]
  apply hsep
  intro i
  let : Finite (G i) := Finite.of_surjective (φ i) (hφ i)
  have hm : φ i x ∈ B i :=
    five_residual_le (σ i) (hfaith i) (hdim i) (B i) (hB i)
      (image_involution_generated (φ i) (hφ i) hgen)
      (map_pResidual_le 2 (φ i) (mem_map.mpr ⟨x,x.property,rfl⟩))
  have hp := pow_card_eq_one' (x := (⟨φ i x,hm⟩ : B i))
  rw [hB i] at hp
  have hp' : (φ i x) ^ 5 = 1 := congrArg Subtype.val hp
  simpa only [map_pow] using hp'

/-- The literal invariant-subspace action images give the separating family
when the supports together with the globally fixed space span the module. -/
theorem five_residual_of_subspace_images {N V I : Type*} [Group N] [Finite N]
    [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (ρ : Representation (ZMod 2) N V) (hf : Function.Injective ρ)
    (U : I → Submodule (ZMod 2) V)
    (hU : ∀ i, (⊤ : Subgroup N) ≤ subspaceStabilizer ρ (U i))
    (hspan : (⨆ i, U i) ⊔ fixedSpace ρ ⊤ = ⊤)
    (hgen : closure {s : N | IsInvolution s} = ⊤)
    (hdim : ∀ i, Module.finrank (ZMod 2) (U i) = 4)
    (B : ∀ i, Subgroup (subspaceActionImage ρ (U i))) [∀ i, (B i).Normal]
    (hB : ∀ i, Nat.card (B i) = 5) :
    IsPGroup 5 (pResidual 2 N) := by
  apply five_residual_of_separating_images
    (fun i => subspaceActionImage ρ (U i)) (fun i => U i)
    (fun i => invariantActionHom ρ (U i) (hU i))
    (fun i => invariantActionHom_surjective ρ (U i) (hU i))
    ?_ hgen (fun i => subspaceImageRepresentation ρ (U i))
    (fun i => subspaceImageRepresentation_injective ρ (U i)) hdim B hB
  intro x hx
  have hall : (⨆ i, U i) ⊔ fixedSpace ρ ⊤ ≤ fixedSpace ρ (zpowers x) := by
    apply sup_le
    · apply iSup_le
      intro i v hv
      rw [mem_fixedSpace_zpowers_iff]
      have he := congrArg
        (fun g => (subspaceImageRepresentation ρ (U i) g ⟨v,hv⟩ : V)) (hx i)
      simpa only [invariantActionHom_apply,map_one,Module.End.one_apply] using he
    · exact fixedSpace_antitone ρ le_top
  apply hf
  ext v
  have hv := hall (show v ∈ (⨆ i, U i) ⊔ fixedSpace ρ ⊤ from hspan ▸ Submodule.mem_top)
  exact ((mem_fixedSpace_zpowers_iff ρ x v).mp hv).trans (by simp)

end Representation.SmallBinaryPrimeNormalizer
