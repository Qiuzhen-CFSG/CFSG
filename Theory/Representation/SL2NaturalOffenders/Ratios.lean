module

public import Theory.Representation.SL2NaturalOffenders
public import Theory.Representation.SL2NaturalOffenders.NoStrong
public import Theory.Representation.BinaryOffender.CubicRatio
public import Theory.Representation.BinaryOffender.PermutationConjugacy
public import Theory.GroupTheory.SylowNormalRestriction

/-!
# Ratios and unique Sylow offenders for the natural SL₂ module

The upper unipotent subgroup fixes one field line and has the order of the
field, so it is an offender. Sylow conjugacy and equivariant transport give
this conclusion for every Sylow subgroup of any specified natural SL₂ layer.
Replacement makes these actors quadratic; the existing semilinear exclusion
places every ambient offender in this layer. The absence of strong offenders
then proves both minimum ratios are exactly one. In a supplied ambient Sylow
subgroup, the unique offender and the subgroup generated by best offenders
are its literal intersection with the normal layer.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), K.3.1.1,
printed p.454, and B.4.2(1), printed p.86. Module recognition is separate.
-/

public section

open Representation Representation.BinaryOffender Matrix.SpecialLinearGroup
open scoped ENNReal
namespace Representation.SL2NaturalOffenders.Ratios
variable {F : Type*} [Field F] [Finite F] [Algebra (ZMod 2) F]
local notation "N" => NoStrong.natural (F := F)
local notation "U" => upperUnipotent F

omit [Finite F] in
private theorem upper_mem_fixed_iff (v : Fin 2 → F) :
    v ∈ fixedSpace N U ↔ v 1 = 0 := by
  constructor
  · intro hv
    have h := congrFun (hv ⟨transvection zero_ne_one (1 : F),
      (mem_upperUnipotent F _).mpr ⟨1, rfl⟩⟩) 0
    change (transvection zero_ne_one (1 : F)).val.mulVec v 0 = v 0 at h
    simpa [transvection_coe, Matrix.mulVec, dotProduct, Fin.sum_univ_two] using h
  · intro hv g
    obtain ⟨x, hx⟩ := (mem_upperUnipotent F g.val).mp g.property
    change g.val.val.mulVec v = v
    rw [← hx]
    ext i
    fin_cases i <;>
      simp [transvection_coe, Matrix.mulVec, dotProduct, Fin.sum_univ_two, hv]

private noncomputable def upperFixedEquiv : fixedSpace N U ≃ₗ[ZMod 2] F where
  toFun v := v.val 0
  invFun x := ⟨![x, 0], (upper_mem_fixed_iff _).mpr (by simp)⟩
  left_inv v := by
    apply Subtype.ext
    ext i
    fin_cases i
    · simp
    · simpa using ((upper_mem_fixed_iff v.val).mp v.property).symm
  right_inv _ := by simp
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

omit [Finite F] in
/-- The standard Sylow fixed space is one line over the defining field. -/
theorem upper_fixed_finrank :
    Module.finrank (ZMod 2) (fixedSpace N U) = Module.finrank (ZMod 2) F :=
  upperFixedEquiv.finrank_eq

/-- The standard Sylow actor has binary rank equal to the field degree. -/
theorem upper_rank : rank U = Module.finrank (ZMod 2) F := by
  rw [rank, card_upperUnipotent]
  have hc : Nat.card F = 2 ^ Module.finrank (ZMod 2) F := by
    simpa using (Module.natCard_eq_pow_finrank (K := ZMod 2) (V := F))
  rw [hc, Nat.log_pow (by decide : 1 < 2)]

omit [Finite F] in
/-- The upper unipotent group is nontrivial elementary abelian in characteristic two. -/
theorem upper_elementary : IsElementaryTwo U := by
  let e : Multiplicative F ≃* U := MonoidHom.ofInjective (upperUnipotentHom_injective F)
  let : CharP F 2 := charP_of_injective_algebraMap (algebraMap (ZMod 2) F).injective 2
  refine ⟨?_, ?_⟩
  · intro h
    have hc := card_upperUnipotent F
    have hcF : Nat.card F = 1 := by simpa [h] using hc.symm
    have hs := (Nat.card_eq_one_iff_unique.mp hcF).1
    exact zero_ne_one (@Subsingleton.elim F hs 0 1)
  · exact {
      toIsMulCommutative := ⟨⟨fun x y => e.symm.injective (by simp [mul_comm])⟩⟩
      exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr (fun x => by
        apply e.symm.injective
        rw [map_pow, map_one, pow_two]
        change Multiplicative.ofAdd ((e.symm x).toAdd + (e.symm x).toAdd) = Multiplicative.ofAdd 0
        rw [CharTwo.add_self_eq_zero]) }

/-- The standard Sylow group offends on the natural binary module. -/
theorem upper_offender : IsOffender N U := by
  refine ⟨upper_elementary, ?_⟩
  have h := fixedCodim_add_finrank N U
  rw [upper_fixed_finrank] at h
  have hdim : Module.finrank (ZMod 2) (Fin 2 → F) =
      2 * Module.finrank (ZMod 2) F := by simp [Module.finrank_pi_fintype, two_mul]
  rw [hdim] at h
  rw [upper_rank]
  omega

/-- Every Sylow two-subgroup offends on the natural binary module. -/
theorem sylow_offender (P : Sylow 2 (NoStrong.Actor F)) :
    IsOffender N (P : Subgroup (NoStrong.Actor F)) := by
  let : CharP F 2 := charP_of_injective_algebraMap (algebraMap (ZMod 2) F).injective 2
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq (NoStrong.Actor F)
    (upperUnipotentSylow F 2) P
  have he : (P : Subgroup (NoStrong.Actor F)) = (upperUnipotent F).map (MulAut.conj g).toMonoidHom := by
    rw [← hg]
    rfl
  rw [he]
  refine ⟨upper_elementary.map_conj g, ?_⟩
  rw [fixedCodim_map_conj, rank_map_conj]
  exact upper_offender.2


section Extension
variable {H : Type*} [Group H] [Finite H]
  (L : Subgroup H) (e : L ≃* NoStrong.Actor F)
  (ρ : Representation (ZMod 2) H (Fin 2 → F))
  (hnat : ∀ (g : L) (v : Fin 2 → F), ρ (g : H) v = Matrix.mulVec (e g).val v)

include e hnat

/-- The ambient image of a Sylow subgroup of the specified natural layer is an offender. -/
theorem sylowImage_offender (P : Sylow 2 L) :
    IsOffender ρ ((P : Subgroup L).map L.subtype) := by
  let Q : Sylow 2 (NoStrong.Actor F) := P.mapSurjective (f := e.toMonoidHom) e.surjective
  let f : NoStrong.Actor F →* H := L.subtype.comp e.symm.toMonoidHom
  have hf : Function.Injective f := L.subtype_injective.comp e.symm.injective
  have he : ∀ g v, (LinearEquiv.refl (ZMod 2) (Fin 2 → F)) (N g v) =
      ρ (f g) ((LinearEquiv.refl (ZMod 2) (Fin 2 → F)) v) := by
    intro g v
    change Matrix.mulVec g.val v = ρ ((e.symm g : L) : H) v
    rw [hnat, e.apply_symm_apply]
  have h := (sylow_offender Q).map_equivariant N ρ f hf
    (LinearEquiv.refl (ZMod 2) (Fin 2 → F)) he
  have hm : (Q : Subgroup (NoStrong.Actor F)).map f = (P : Subgroup L).map L.subtype := by
    change ((P : Subgroup L).map e.toMonoidHom).map f = _
    rw [Subgroup.map_map]
    congr 1
    ext g
    exact congrArg Subtype.val (e.symm_apply_apply g)
  rwa [hm] at h

/-- A faithful ambient extension of the natural action has no strong offenders. -/
theorem not_strong [L.Normal] (hF : 2 < Nat.card F) (hfaith : Function.Injective ρ) :
    ¬ IsStrongFFModule ρ := by
  rintro ⟨A, hA⟩
  obtain ⟨P, hP⟩ := exists_sylow hF L e ρ hfaith hnat ⟨hA.1, hA.2.le⟩
  have hAL : A ≤ L := hP ▸ Subgroup.map_subtype_le (P : Subgroup L)
  exact NoStrong.not_strong_of_le L e ρ hnat hAL hA

/-- Every Sylow actor in the natural layer is quadratic. -/
theorem sylowImage_quadratic (P : Sylow 2 L) :
    IsQuadratic ρ ((P : Subgroup L).map L.subtype) := by
  obtain ⟨B, hBA, hB, hquad⟩ :=
    (sylowImage_offender L e ρ hnat P).exists_quadratic_minimalBestOffender ρ
  obtain ⟨Q, hQ⟩ := exists_sylow_of_le L e ρ hnat (hB.1.isOffender ρ)
    (hBA.trans (Subgroup.map_subtype_le _))
  have hQP : (Q : Subgroup L) ≤ P := by
    apply (Subgroup.map_le_map_iff_of_injective L.subtype_injective).mp
    rwa [hQ]
  have heq : Q = P := Sylow.ext (Q.is_maximal' P.isPGroup' hQP).symm
  rw [← hQ, heq] at hquad
  exact hquad.1

/-- Both source infima are exactly one for a faithful extension of the natural action. -/
theorem ratios_eq_one [L.Normal] (hF : 2 < Nat.card F) (hfaith : Function.Injective ρ) :
    quadraticRatio ρ = 1 ∧ cubicRatio ρ = 1 := by
  have hn := not_strong L e ρ hnat hF hfaith
  have hlow : 1 ≤ cubicRatio ρ := by
    apply le_iInf
    intro A
    apply le_iInf
    intro hA
    exact le_of_not_gt (fun hlt => hn ⟨A, hA.1, (actionRatio_lt_one_iff ρ hA.1).mp hlt⟩)
  have hupp : quadraticRatio ρ ≤ 1 :=
    (isFFModule_iff_quadraticRatio_le_one ρ).mp
      ⟨((default : Sylow 2 L) : Subgroup L).map L.subtype,
        sylowImage_offender L e ρ hnat default⟩
  have hc := cubicRatio_le_quadraticRatio ρ
  exact ⟨le_antisymm hupp (hlow.trans hc), le_antisymm (hc.trans hupp) hlow⟩

/-- Inside a specified ambient Sylow subgroup, the literal layer intersection is the unique offender. -/
theorem offender_iff_eq_sylowInf [L.Normal] (hF : 2 < Nat.card F)
    (hfaith : Function.Injective ρ) (T : Sylow 2 H) {A : Subgroup H} (hAT : A ≤ T) :
    IsOffender ρ A ↔ A = (T : Subgroup H) ⊓ L := by
  obtain ⟨P, hP⟩ := T.exists_sylow_map_eq_inf_of_normal L
  constructor
  · intro hA
    obtain ⟨Q, hQ⟩ := exists_sylow hF L e ρ hfaith hnat hA
    have hQP : (Q : Subgroup L) ≤ P := by
      apply (Subgroup.map_le_map_iff_of_injective L.subtype_injective).mp
      rw [hQ, hP]
      exact le_inf hAT (hQ ▸ Subgroup.map_subtype_le _)
    have heq : (Q : Subgroup L) = P := (Q.is_maximal' P.isPGroup' hQP).symm
    rw [← hQ, heq, hP]
  · rintro rfl
    rw [← hP]
    exact sylowImage_offender L e ρ hnat P

omit hnat in
/-- The Sylow actor has exactly the defining field's binary rank. -/
theorem sylowImage_rank (P : Sylow 2 L) :
    rank ((P : Subgroup L).map L.subtype) = Module.finrank (ZMod 2) F := by
  rw [rank, ← Nat.card_congr
    ((P : Subgroup L).equivMapOfInjective L.subtype L.subtype_injective).toEquiv,
    sylow_card L e P]
  have hc : Nat.card F = 2 ^ Module.finrank (ZMod 2) F := by
    simpa using (Module.natCard_eq_pow_finrank (K := ZMod 2) (V := F))
  rw [hc, Nat.log_pow (by decide : 1 < 2)]

/-- Its fixed codimension is equal to its rank, not strictly smaller. -/
theorem sylowImage_fixedCodim (P : Sylow 2 L) :
    fixedCodim ρ ((P : Subgroup L).map L.subtype) = Module.finrank (ZMod 2) F := by
  have hA := sylowImage_offender L e ρ hnat P
  have hn := NoStrong.not_strong_of_le L e ρ hnat (Subgroup.map_subtype_le (P : Subgroup L))
  have he : fixedCodim ρ ((P : Subgroup L).map L.subtype) =
      rank ((P : Subgroup L).map L.subtype) :=
    le_antisymm hA.2 (Nat.le_of_not_gt (fun hlt => hn ⟨hA.1, hlt⟩))
  exact he.trans (sylowImage_rank L e P)

/-- The best offenders inside the specified Sylow subgroup generate its literal
intersection with the natural SL₂ layer. -/
theorem generatedBy_bestOffenders_sylow [L.Normal] (hF : 2 < Nat.card F)
    (hfaith : Function.Injective ρ) (T : Sylow 2 H) :
    generatedBy {A | IsBestOffender ρ A} (T : Subgroup H) = (T : Subgroup H) ⊓ L := by
  have hn := not_strong L e ρ hnat hF hfaith
  have hX : IsOffender ρ ((T : Subgroup H) ⊓ L) :=
    (offender_iff_eq_sylowInf L e ρ hnat hF hfaith T inf_le_left).mpr rfl
  have hb : IsBestOffender ρ ((T : Subgroup H) ⊓ L) :=
    (isBestOffender_iff_of_not_strong ρ hn _).mpr
      ⟨hX.1, le_antisymm hX.2 (Nat.le_of_not_gt (fun hlt => hn ⟨_, hX.1, hlt⟩))⟩
  apply le_antisymm
  · apply iSup_le
    intro A
    apply iSup_le
    rintro ⟨hA, hAT⟩
    exact le_of_eq ((offender_iff_eq_sylowInf L e ρ hnat hF hfaith T hAT).mp
      (hA.isOffender ρ))
  · exact le_iSup_of_le ((T : Subgroup H) ⊓ L)
      (le_iSup_of_le ⟨hb, inf_le_left⟩ le_rfl)

end Extension

end Representation.SL2NaturalOffenders.Ratios
