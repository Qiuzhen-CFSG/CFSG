module
public import Theory.Representation.CliffordRestriction
public import Theory.Representation.NormalSemisimpleSpan
public import Mathlib.GroupTheory.IsSubnormal
public import Mathlib.RepresentationTheory.Coinvariants

/-!
# Subnormal restriction and semisimple subquotients

Clifford restriction iterates along a subnormal chain. If two equivariant
maps have a common domain, the target of a surjective map is a subquotient
of the other target whenever its kernel contains the other map's kernel.
Consequently a semisimple second target makes the first target semisimple.

The intended application is the literal moved central quotient in the
fundamental setup: it is a subquotient of V_M/C_VM(L₀), after restriction
to the original subnormal component L. This preserves the original
conjugation coordinates without assuming a splitting of V_M itself.
Source: Aschbacher–Smith,3.2.2(3) and3.2.6, printed pp.579 and581.
-/

public noncomputable section
open Subgroup
open scoped MonoidAlgebra
namespace Representation
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V] (ρ : Representation (ZMod 2) G V)

/-- A semisimple binary representation restricts semisimply to a subnormal actor. -/
theorem subnormal_restriction_semisimple (H : Subgroup G) (hH : H.IsSubnormal)
    [IsSemisimpleModule (ZMod 2)[G] ρ.asModule] :
    IsSemisimpleModule (ZMod 2)[H] (Representation.asModule (ρ.comp H.subtype)) := by
  induction hH with
  | top =>
      exact comp_semisimple_of_surjective ρ (⊤ : Subgroup G).subtype
        (fun g => ⟨⟨g,mem_top g⟩,rfl⟩)
  | step H K hHK _ hnormal ih =>
      let := hnormal
      let := ih
      let τ := (ρ.comp K.subtype).comp (H.subgroupOf K).subtype
      let : IsSemisimpleModule (ZMod 2)[H.subgroupOf K] (Representation.asModule τ) :=
        normal_restriction_semisimple (ρ.comp K.subtype) (H.subgroupOf K)
      let e := (subgroupOfEquivOfLe hHK).symm
      exact comp_semisimple_of_surjective τ e.toMonoidHom e.surjective

variable {k U W : Type*} [Field k] [AddCommGroup U] [Module k U]
  [AddCommGroup W] [Module k W]

/-- A quotient of a submodule of a semisimple representation is semisimple,
expressed by two maps from the same module and a kernel containment. -/
theorem semisimple_of_shared_cover {V : Type*} [AddCommGroup V] [Module k V]
    (ρ : Representation k G U) (σ : Representation k G V) (τ : Representation k G W)
    (f : ρ.IntertwiningMap σ) (g : ρ.IntertwiningMap τ)
    (hg : Function.Surjective g) (hk : f.toLinearMap.ker ≤ g.toLinearMap.ker)
    [IsSemisimpleModule k[G] σ.asModule] : IsSemisimpleModule k[G] τ.asModule := by
  let a := IntertwiningMap.equivLinearMapAsModule ρ σ f
  let b := IntertwiningMap.equivLinearMapAsModule ρ τ g
  have hab : a.ker ≤ b.ker := by
    intro u hu
    exact hk hu
  let : IsSemisimpleModule k[G] (ρ.asModule ⧸ a.ker) :=
    IsSemisimpleModule.congr a.quotKerEquivRange
  let c := a.ker.liftQ b hab
  apply IsSemisimpleModule.of_surjective c
  intro w
  obtain ⟨u,hu⟩ := hg (τ.asModuleEquiv w)
  exact ⟨a.ker.mkQ (ρ.asModuleEquiv.symm u),congrArg τ.asModuleEquiv.symm hu⟩
end Representation

namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

/-- A semisimple module generated by its displacements has no fixed vectors. -/
theorem fixedSpace_eq_bot_of_semisimple_coinvariants
    [IsSemisimpleRepresentation ρ] (hgen : Coinvariants.ker ρ = ⊤) :
    fixedSpace ρ ⊤ = ⊥ := by
  let F : Subrepresentation ρ := ⟨fixedSpace ρ ⊤, by
    intro g v hv
    have he : ρ g v = v := hv ⟨g,mem_top g⟩
    rw [he]
    exact hv⟩
  obtain ⟨C,hC⟩ := exists_isCompl F
  have hsum : F.toSubmodule ⊔ C.toSubmodule = ⊤ :=
    congrArg Subrepresentation.toSubmodule hC.sup_eq_top
  have hle : Coinvariants.ker ρ ≤ C.toSubmodule := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨g,v⟩,rfl⟩
    obtain ⟨f,hf,c,hc,rfl⟩ := Submodule.mem_sup.mp
      (hsum.symm ▸ (Submodule.mem_top : v ∈ (⊤ : Submodule (ZMod 2) V)))
    have hfix : ρ g f = f := hf ⟨g,mem_top g⟩
    have he : ρ g (f+c) - (f+c) = ρ g c - c := by rw [map_add,hfix]; abel
    change ρ g (f+c) - (f+c) ∈ C.toSubmodule
    rw [he]
    exact C.toSubmodule.sub_mem (C.apply_mem_toSubmodule g hc) hc
  have htop : C.toSubmodule = ⊤ := top_unique (hgen ▸ hle)
  have hzero := congrArg Subrepresentation.toSubmodule hC.inf_eq_bot
  change fixedSpace ρ ⊤ ⊓ C.toSubmodule = ⊥ at hzero
  simpa only [htop,inf_top_eq] using hzero
end Representation.BinaryOffender
