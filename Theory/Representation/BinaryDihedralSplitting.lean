module

public import Theory.Representation.GoldschmidtONan.Basic
public import Theory.Representation.BinaryOffender.SubspaceAction
public import Theory.Representation.BinaryOffender.CommutatorRank

/-!
# Binary dihedral decompositions

For two square-one operators whose product has odd order, the moved space of
that product is the direct sum of the two reflection commutator spaces. On
the moved space, the fixed space of either reflection is its commutator space.

Odd-order averaging first splits off the product's fixed space. Its moved
space is generated by its own displacements and is preserved by both
reflections, which invert the product. Expanding a product displacement gives
the sum of the two reflection commutator spaces. In characteristic two these
commutators are fixed by their reflections. A common fixed vector is fixed
by the product, so averaging makes the required intersections zero.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
1 March 2004 manuscript, Lemma A.1.44, printed p.32 (PDF p.43).
Faithfulness, distinctness and generation of the whole group are unnecessary
for this stronger linear statement.
-/

open Representation Representation.BinaryOffender Representation.RegularCyclicNormalClosure
namespace Representation.BinaryDihedralSplitting
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

private lemma commutator_eq_displacement (W : Submodule (ZMod 2) V) (A : Subgroup G) :
    subspaceCommutator ρ W A = displacementSpan ρ A W := by
  unfold subspaceCommutator displacementSpan
  congr 1
  ext v
  simp only [eq_comm]

private lemma neg_eq_self (v : V) : -v = v := by
  have h : v + v = 0 := by
    have h := @two_smul (ZMod 2) V _ _ _ v
    rw [show (2 : ZMod 2) = 0 by decide, zero_smul] at h
    exact h.symm
  exact neg_eq_of_add_eq_zero_left h

private lemma cyclic_commutator_le [Finite G] (W S : Submodule (ZMod 2) V) (x : G)
    (hW : ∀ v ∈ W, ρ x v ∈ W) (hS : ∀ v ∈ W, ρ x v - v ∈ S) :
    subspaceCommutator ρ W (Subgroup.zpowers x) ≤ S := by
  have hp (n : ℕ) : ∀ v ∈ W, ρ (x ^ n) v - v ∈ S := by
    induction n with
    | zero => intro v hv; simp
    | succ n ih =>
      intro v hv
      have he : ρ (x ^ (n + 1)) v - v =
          (ρ (x ^ n) (ρ x v) - ρ x v) + (ρ x v - v) := by
        rw [pow_succ, map_mul, Module.End.mul_apply]
        abel
      rw [he]
      exact S.add_mem (ih _ (hW v hv)) (hS v hv)
  apply Submodule.span_le.mpr
  rintro _ ⟨a, ha, v, hv, rfl⟩
  obtain ⟨n, rfl⟩ := (Submonoid.mem_powers_iff a x).mp (mem_powers_iff_mem_zpowers.mpr ha)
  exact hp n v hv

private lemma moved_stable_of_inverts (x t : G) (hinv : t * x * t⁻¹ = x⁻¹)
    {v : V} (hv : v ∈ subspaceCommutator ρ ⊤ (Subgroup.zpowers x)) :
    ρ t v ∈ subspaceCommutator ρ ⊤ (Subgroup.zpowers x) := by
  rw [commutator_eq_displacement] at hv ⊢
  have hn : (Subgroup.zpowers x).map (MulAut.conj t).toMonoidHom = Subgroup.zpowers x := by
    rw [MonoidHom.map_zpowers]
    change Subgroup.zpowers (t * x * t⁻¹) = _
    rw [hinv, Subgroup.zpowers_inv]
  have hm := Submodule.mem_map_of_mem (f := ρ t) hv
  rwa [displacementSpan_map_of_normalized ρ (Subgroup.zpowers x) t hn] at hm

private lemma involution_commutator_le_fixed [Finite G] (W : Submodule (ZMod 2) V)
    (t : G) (ht : t * t = 1) (hW : ∀ v ∈ W, ρ t v ∈ W) :
    subspaceCommutator ρ W (Subgroup.zpowers t) ≤ W ⊓ fixedSpace ρ (Subgroup.zpowers t) := by
  apply cyclic_commutator_le ρ W _ t hW
  intro v hv
  refine ⟨W.sub_mem (hW v hv) hv, ?_⟩
  apply (mem_fixedSpace_zpowers_iff ρ t _).mpr
  rw [map_sub]
  have htwice : ρ t (ρ t v) = v := by
    rw [← Module.End.mul_apply, ← map_mul, ht, map_one, Module.End.one_apply]
  rw [htwice]
  simp only [sub_eq_add_neg, neg_eq_self, add_comm]

/-- For a product of two square-one elements of odd order, all three binary
fixed/moved decompositions hold in the original ambient representation. -/
public theorem splitting_of_odd_product [Finite G] (t u : G) (ht : t * t = 1) (hu : u * u = 1)
    (hodd : Odd (orderOf (t * u))) :
    let W := subspaceCommutator ρ ⊤ (Subgroup.zpowers (t * u))
    IsCompl W (fixedSpace ρ (Subgroup.zpowers (t * u))) ∧
      Disjoint (subspaceCommutator ρ W (Subgroup.zpowers t))
        (subspaceCommutator ρ W (Subgroup.zpowers u)) ∧
      subspaceCommutator ρ W (Subgroup.zpowers t) ⊔
        subspaceCommutator ρ W (Subgroup.zpowers u) = W ∧
      W ⊓ fixedSpace ρ (Subgroup.zpowers t) = subspaceCommutator ρ W (Subgroup.zpowers t) := by
  let W := subspaceCommutator ρ ⊤ (Subgroup.zpowers (t * u))
  let A := subspaceCommutator ρ W (Subgroup.zpowers t)
  let B := subspaceCommutator ρ W (Subgroup.zpowers u)
  have hc : IsCompl (fixedSpace ρ (Subgroup.zpowers (t * u))) W := by
    dsimp only [W]
    rw [commutator_eq_displacement]
    exact GoldschmidtONan.isCompl_fixed_moved_of_odd (by simpa using hodd)
  have htinv : t⁻¹ = t := inv_eq_of_mul_eq_one_right ht
  have huinv : u⁻¹ = u := inv_eq_of_mul_eq_one_right hu
  have hti : t * (t * u) * t⁻¹ = (t * u)⁻¹ := by
    rw [mul_inv_rev, htinv, huinv, ← mul_assoc t t, ht, one_mul]
  have hui : u * (t * u) * u⁻¹ = (t * u)⁻¹ := by
    rw [mul_inv_rev, htinv, huinv]
    simp only [mul_assoc, hu, mul_one]
  have htW : ∀ v ∈ W, ρ t v ∈ W := fun _ hv => moved_stable_of_inverts ρ _ t hti hv
  have huW : ∀ v ∈ W, ρ u v ∈ W := fun _ hv => moved_stable_of_inverts ρ _ u hui hv
  have hA : A ≤ W ⊓ fixedSpace ρ (Subgroup.zpowers t) :=
    involution_commutator_le_fixed ρ W t ht htW
  have hB : B ≤ W ⊓ fixedSpace ρ (Subgroup.zpowers u) :=
    involution_commutator_le_fixed ρ W u hu huW
  have hself : subspaceCommutator ρ W (Subgroup.zpowers (t * u)) = W := by
    dsimp only [W] at *
    simp only [commutator_eq_displacement] at hc ⊢
    exact displacementSpan_self_of_split ρ _ hc
  have hsum : A ⊔ B = W := by
    apply le_antisymm (sup_le (hA.trans inf_le_left) (hB.trans inf_le_left))
    rw [← hself]
    apply cyclic_commutator_le ρ W (A ⊔ B) (t * u)
    · intro v hv
      rw [map_mul, Module.End.mul_apply]
      exact htW _ (huW v hv)
    · intro v hv
      have he : ρ (t * u) v - v = (ρ t (ρ u v) - ρ u v) + (ρ u v - v) := by
        rw [map_mul, Module.End.mul_apply]
        abel
      rw [he]
      exact Submodule.add_mem_sup
        (Submodule.subset_span ⟨t, Subgroup.mem_zpowers t, ρ u v, huW v hv, rfl⟩)
        (Submodule.subset_span ⟨u, Subgroup.mem_zpowers u, v, hv, rfl⟩)
  have hd : Disjoint (W ⊓ fixedSpace ρ (Subgroup.zpowers t)) B := by
    apply Submodule.disjoint_def.mpr
    intro v hv hb
    have htv := (mem_fixedSpace_zpowers_iff ρ t v).mp hv.2
    have huv := (mem_fixedSpace_zpowers_iff ρ u v).mp (hB hb).2
    have hxv : v ∈ fixedSpace ρ (Subgroup.zpowers (t * u)) := by
      rw [mem_fixedSpace_zpowers_iff, map_mul, Module.End.mul_apply, huv, htv]
    exact Submodule.disjoint_def.mp hc.disjoint v hxv hv.1
  refine ⟨hc.symm, hd.mono_left hA, hsum, le_antisymm ?_ hA⟩
  intro v hv
  have hvsum : v ∈ A ⊔ B := by rw [hsum]; exact hv.1
  obtain ⟨a, ha, b, hb, hab⟩ := Submodule.mem_sup.mp hvsum
  have hbfix : b ∈ W ⊓ fixedSpace ρ (Subgroup.zpowers t) := by
    have hm := (W ⊓ fixedSpace ρ (Subgroup.zpowers t)).sub_mem hv (hA ha)
    rw [← hab, add_sub_cancel_left] at hm
    exact hm
  have hb0 := Submodule.disjoint_def.mp hd b hbfix hb
  change v ∈ A
  rw [← hab, hb0, add_zero]
  exact ha

end Representation.BinaryDihedralSplitting
