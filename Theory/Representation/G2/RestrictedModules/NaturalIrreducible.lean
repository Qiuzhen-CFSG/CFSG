module

public import Theory.Representation.G2.RestrictedModules.NaturalCoordinates
public import Theory.Representation.AbsolutelyIrreducible

/-!
# Absolute irreducibility of the natural G₂ module in characteristic two

The displacement operators of roots E and F satisfy `E F E = e₁₄`.
A Weyl element cycles the six coordinates; multiplying and conjugating this
rank-one operator produces every matrix unit. Consequently the algebra generated
by the actual action is the full endomorphism algebra. This remains true under
scalar extension, giving absolute irreducibility, including over the binary field.

Source: GLS3, Example 2.8.10(g); the proof here uses the explicit octonion root
maps rather than the dimension-based recognition argument in the source.
-/

@[expose] public section

namespace Atlas.G2.Restricted.NaturalCoordinates

open scoped BigOperators

variable (F : Type*) [Field F] [CharP F 2]

/-- A Weyl element cycling all six natural weight spaces. -/
def cycle : Model F := weylR * weylS

@[simp] theorem action_cycle (v : Space F) :
    action F (cycle F) v = ![v 1, v 3, v 0, v 5, v 2, v 4] := by
  simp [cycle, map_mul, Module.End.mul_apply]

private def leftExponent : Fin 6 → ℕ := ![1, 0, 2, 5, 3, 4]
private def rightExponent : Fin 6 → ℕ := ![5, 0, 4, 1, 3, 2]

private theorem cycle_left (i : Fin 6) (a : F) :
    action F (cycle F ^ leftExponent i) (Pi.single 1 a) = Pi.single i a := by
  fin_cases i <;> ext j <;> fin_cases j <;>
    simp [leftExponent, pow_succ, map_mul, Module.End.mul_apply]

private theorem cycle_right (j : Fin 6) (v : Space F) :
    action F (cycle F ^ rightExponent j) v 1 = v j := by
  fin_cases j <;>
    simp [rightExponent, pow_succ, map_mul, Module.End.mul_apply]

private def projectionOperator : Module.End F (Space F) :=
  (action F (rootE 1) - 1) * (action F (rootF 1) - 1) *
    (action F (rootE 1) - 1) * action F (cycle F ^ 3)

private theorem projectionOperator_apply (v : Space F) :
    projectionOperator F v = Pi.single 1 (v 1) := by
  ext i
  fin_cases i <;>
    simp [projectionOperator, Module.End.mul_apply,
      pow_succ, map_mul, sub_eq_add_neg, CharTwo.neg_eq,
      CharTwo.add_self_eq_zero, add_assoc, add_left_comm]

/-- The matrix unit extracting coordinate `j` and inserting it in coordinate `i`. -/
def matrixUnit (i j : Fin 6) : Module.End F (Space F) :=
  (LinearMap.single F (fun _ : Fin 6 => F) i).comp (LinearMap.proj j)

omit [CharP F 2] in
@[simp] theorem matrixUnit_apply (i j : Fin 6) (v : Space F) :
    matrixUnit F i j v = Pi.single i (v j) := rfl

private theorem matrixUnit_eq (i j : Fin 6) :
    matrixUnit F i j = action F (cycle F ^ leftExponent i) *
      projectionOperator F * action F (cycle F ^ rightExponent j) := by
  apply LinearMap.ext
  intro v
  simp only [matrixUnit_apply, Module.End.mul_apply, projectionOperator_apply,
    cycle_right, cycle_left]

/-- Every matrix unit belongs to the algebra generated by the actual G₂ action. -/
theorem matrixUnit_mem_adjoin (i j : Fin 6) :
    matrixUnit F i j ∈ Algebra.adjoin F (Set.range (action F)) := by
  have h (g : Model F) : action F g ∈ Algebra.adjoin F (Set.range (action F)) :=
    Algebra.subset_adjoin (Set.mem_range_self g)
  have hE := (Algebra.adjoin F (Set.range (action F))).sub_mem (h (rootE 1))
    (Subalgebra.one_mem _)
  have hF := (Algebra.adjoin F (Set.range (action F))).sub_mem (h (rootF 1))
    (Subalgebra.one_mem _)
  have hP : projectionOperator F ∈ Algebra.adjoin F (Set.range (action F)) :=
    Subalgebra.mul_mem _ (Subalgebra.mul_mem _ (Subalgebra.mul_mem _ hE hF) hE) (h _)
  rw [matrixUnit_eq]
  exact Subalgebra.mul_mem _ (Subalgebra.mul_mem _ (h _) hP) (h _)

/-- The natural action generates the full endomorphism algebra over its base field. -/
theorem adjoin_action_eq_top : Algebra.adjoin F (Set.range (action F)) = ⊤ := by
  apply top_unique
  intro f _
  have hf : f = ∑ j : Fin 6, ∑ i : Fin 6,
      (f (Pi.single j 1) i) • matrixUnit F i j := by
    apply LinearMap.ext
    intro v
    conv_lhs => rw [← Finset.univ_sum_single v]
    simp only [map_sum, LinearMap.sum_apply]
    apply Finset.sum_congr rfl
    intro j _
    have hv : Pi.single j (v j) = v j • (Pi.single j 1 : Space F) := by
      ext i
      simp [Pi.single_apply]
    rw [hv, map_smul]
    ext k
    simp [LinearMap.smul_apply, matrixUnit_apply, Pi.single_apply, mul_comm]
  rw [hf]
  exact Subalgebra.sum_mem _ fun j _ => Subalgebra.sum_mem _ fun i _ =>
    Subalgebra.smul_mem _ (matrixUnit_mem_adjoin F i j) _

/-- Absolute irreducibility follows from the explicit full matrix algebra. -/
theorem absolutelyIrreducible : Representation.IsAbsolutelyIrreducible (action F) := by
  constructor
  apply Representation.irreducible_of_jacobson_density_surjective
  exact (Representation.extendScalars_surj_iff (AlgebraicClosure F) (action F)).mp
    (adjoin_action_eq_top F)

/-- The quotient action itself generates its full endomorphism algebra. -/
theorem adjoin_naturalAction_eq_top :
    Algebra.adjoin F (Set.range (Natural.action F)) = ⊤ := by
  let e := LinearEquiv.conjAlgEquiv F (equiv F)
  have he : (Algebra.adjoin F (Set.range (Natural.action F))).map e.toAlgHom =
      Algebra.adjoin F (Set.range (action F)) := by
    rw [AlgHom.map_adjoin, ← Set.range_comp]
    rfl
  apply top_unique
  intro f _
  have hf : e f ∈ (Algebra.adjoin F (Set.range (Natural.action F))).map e.toAlgHom := by
    rw [he, adjoin_action_eq_top]
    trivial
  obtain ⟨x, hx, hxf⟩ := hf
  exact e.injective hxf ▸ hx

/-- Absolute irreducibility of the actual trace-zero quotient action. -/
theorem natural_absolutelyIrreducible :
    Representation.IsAbsolutelyIrreducible (Natural.action F) := by
  let : Nontrivial (Natural.Space F) := (equiv F).symm.injective.nontrivial
  constructor
  apply Representation.irreducible_of_jacobson_density_surjective
  exact (Representation.extendScalars_surj_iff (AlgebraicClosure F) (Natural.action F)).mp
    (adjoin_naturalAction_eq_top F)

end Atlas.G2.Restricted.NaturalCoordinates
