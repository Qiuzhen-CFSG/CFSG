module

public import Theory.Representation.G2.RestrictedModules.Adjoint.Coordinates
public import Theory.Representation.AbsolutelyIrreducible

/-!
# Full matrix algebra and absolute irreducibility of the G₂ adjoint

Write A, B, E, F for the displacements of the corresponding roots at parameter
one, and R, S for the Weyl maps. The small identity A*B*E(v) = v₈e₀ gives a
rank-one operator. Fourteen short insertion words Lᵢ and extraction words Qⱼ
satisfy Lᵢ(e₀)=eᵢ and (Qⱼv)₈=vⱼ. Thus Lᵢ*A*B*E*Qⱼ are all matrix units in
the algebra generated by the actual action. Their linear span is the complete
endomorphism algebra. Coordinate conjugation transfers this equality to actual
octonion derivations; scalar extension and density prove absolute irreducibility.

All calculations are symbolic over any field of characteristic two. No group
order, generating-set assertion, or unchecked finite computation is used.
Source: GLS3, Examples 1.14.9(c) and 2.8.10(g).
-/

@[expose] public section

namespace Atlas.G2.Restricted.Adjoint.Coordinates
variable (F : Type*) [Field F] [CharP F 2]
private abbrev generated := Algebra.adjoin F (Set.range (action F))
private def generator (g : Model F) : generated F :=
  ⟨action F g, Algebra.subset_adjoin (Set.mem_range_self g)⟩
private def dA : generated F := generator F (rootA 1) - 1
private def dB : generated F := generator F (rootB 1) - 1
private def dE : generated F := generator F (rootE 1) - 1
private def dF : generated F := generator F (rootF 1) - 1
private def R : generated F := generator F weylR
private def S : generated F := generator F weylS
private theorem dA_apply (v : Space F) : (dA F).val v =
    ![v 6 + v 8 + v 13, v 5, v 11, v 9, v 10, 0, v 8, 0, 0, 0, 0, 0, 0, v 8] := by
  change action F (rootA 1) v - v = _
  rw [action_rootA]
  ext i
  fin_cases i <;> simp [sub_eq_add_neg, CharTwo.neg_eq, CharTwo.add_self_eq_zero, CharTwo.add_cancel_left, add_assoc, add_left_comm, add_comm]
private theorem dB_apply (v : Space F) : (dB F).val v =
    ![v 3, v 6 + v 9, v 12, 0, 0, v 8, 0, v 10, 0, 0, 0, 0, 0, v 9] := by
  change action F (rootB 1) v - v = _
  rw [action_rootB]
  ext i
  fin_cases i <;> simp [sub_eq_add_neg, CharTwo.neg_eq, CharTwo.add_self_eq_zero, CharTwo.add_cancel_left, add_assoc, add_left_comm, add_comm]
private theorem dE_apply (v : Space F) : (dE F).val v =
    ![v 1, 0, 0, v 5 + v 13, v 7, 0, v 5, 0, 0, v 8, 0, 0, v 11, 0] := by
  change action F (rootE 1) v - v = _
  rw [action_rootE]
  ext i
  fin_cases i <;> simp [sub_eq_add_neg, CharTwo.neg_eq, CharTwo.add_self_eq_zero, CharTwo.add_cancel_left, add_assoc, add_left_comm, add_comm]
private def P : generated F := dA F * dB F * dE F
private theorem P_apply (v : Space F) : (P F).val v = Pi.single 0 (v 8) := by
  change (dA F).val ((dB F).val ((dE F).val v)) = _
  rw [dA_apply, dB_apply, dE_apply]
  ext i
  fin_cases i <;> simp
private theorem dF_apply (v : Space F) : (dF F).val v =
    ![0, v 2 + v 3 + v 4, v 3, 0, v 3, v 9 + v 10 + v 11, v 12,
      v 6 + v 12 + v 13, 0, 0, v 9, v 9, 0, v 12] := by
  change action F (rootF 1) v - v = _
  rw [action_rootF]
  ext i
  fin_cases i <;> simp [sub_eq_add_neg, CharTwo.neg_eq, CharTwo.add_self_eq_zero,
    CharTwo.add_cancel_left, add_assoc, add_left_comm, add_comm]
private theorem R_apply (v : Space F) : (R F).val v =
    ![v 1, v 0, v 2, v 5, v 7, v 3, v 6 + v 13, v 4, v 9, v 8, v 10, v 12, v 11, v 13] :=
  action_weylR F v
private theorem S_apply (v : Space F) : (S F).val v =
    ![v 0, v 3, v 4, v 1, v 2, v 9, v 13, v 12, v 8, v 5, v 11, v 10, v 7, v 6] :=
  action_weylS F v
private def L0 : generated F := 1
private theorem L0_apply (a : F) : (L0 F).val (Pi.single 0 a) = Pi.single 0 a := rfl
private def L1 : generated F := R F * L0 F
private theorem L1_apply (a : F) : (L1 F).val (Pi.single 0 a) = Pi.single 1 a := by
  change (R F).val ((L0 F).val (Pi.single 0 a)) = _
  rw [L0_apply, R_apply]
  ext j
  fin_cases j <;> simp
private def L3 : generated F := S F * L1 F
private theorem L3_apply (a : F) : (L3 F).val (Pi.single 0 a) = Pi.single 3 a := by
  change (S F).val ((L1 F).val (Pi.single 0 a)) = _
  rw [L1_apply, S_apply]
  ext j
  fin_cases j <;> simp
private def L5 : generated F := R F * L3 F
private theorem L5_apply (a : F) : (L5 F).val (Pi.single 0 a) = Pi.single 5 a := by
  change (R F).val ((L3 F).val (Pi.single 0 a)) = _
  rw [L3_apply, R_apply]
  ext j
  fin_cases j <;> simp
private def L9 : generated F := S F * L5 F
private theorem L9_apply (a : F) : (L9 F).val (Pi.single 0 a) = Pi.single 9 a := by
  change (S F).val ((L5 F).val (Pi.single 0 a)) = _
  rw [L5_apply, S_apply]
  ext j
  fin_cases j <;> simp
private def L8 : generated F := R F * L9 F
private theorem L8_apply (a : F) : (L8 F).val (Pi.single 0 a) = Pi.single 8 a := by
  change (R F).val ((L9 F).val (Pi.single 0 a)) = _
  rw [L9_apply, R_apply]
  ext j
  fin_cases j <;> simp
private def L6 : generated F := dE F * L5 F + L3 F
private theorem L6_apply (a : F) : (L6 F).val (Pi.single 0 a) = Pi.single 6 a := by
  change (dE F).val ((L5 F).val (Pi.single 0 a)) + (L3 F).val (Pi.single 0 a) = _
  rw [L5_apply, L3_apply, dE_apply]
  ext j
  fin_cases j <;> simp [CharTwo.add_self_eq_zero]
private def L13 : generated F := S F * L6 F
private theorem L13_apply (a : F) : (L13 F).val (Pi.single 0 a) = Pi.single 13 a := by
  change (S F).val ((L6 F).val (Pi.single 0 a)) = _
  rw [L6_apply, S_apply]
  ext j
  fin_cases j <;> simp
private def L7 : generated F := dF F * L6 F
private theorem L7_apply (a : F) : (L7 F).val (Pi.single 0 a) = Pi.single 7 a := by
  change (dF F).val ((L6 F).val (Pi.single 0 a)) = _
  rw [L6_apply, dF_apply]
  ext j
  fin_cases j <;> simp
private def L4 : generated F := R F * L7 F
private theorem L4_apply (a : F) : (L4 F).val (Pi.single 0 a) = Pi.single 4 a := by
  change (R F).val ((L7 F).val (Pi.single 0 a)) = _
  rw [L7_apply, R_apply]
  ext j
  fin_cases j <;> simp
private def L2 : generated F := S F * L4 F
private theorem L2_apply (a : F) : (L2 F).val (Pi.single 0 a) = Pi.single 2 a := by
  change (S F).val ((L4 F).val (Pi.single 0 a)) = _
  rw [L4_apply, S_apply]
  ext j
  fin_cases j <;> simp
private def L12 : generated F := S F * L7 F
private theorem L12_apply (a : F) : (L12 F).val (Pi.single 0 a) = Pi.single 12 a := by
  change (S F).val ((L7 F).val (Pi.single 0 a)) = _
  rw [L7_apply, S_apply]
  ext j
  fin_cases j <;> simp
private def L11 : generated F := R F * L12 F
private theorem L11_apply (a : F) : (L11 F).val (Pi.single 0 a) = Pi.single 11 a := by
  change (R F).val ((L12 F).val (Pi.single 0 a)) = _
  rw [L12_apply, R_apply]
  ext j
  fin_cases j <;> simp
private def L10 : generated F := S F * L11 F
private theorem L10_apply (a : F) : (L10 F).val (Pi.single 0 a) = Pi.single 10 a := by
  change (S F).val ((L11 F).val (Pi.single 0 a)) = _
  rw [L11_apply, S_apply]
  ext j
  fin_cases j <;> simp
private def Q8 : generated F := 1
private theorem Q8_apply (v : Space F) : (Q8 F).val v 8 = v 8 := rfl
private def Q9 : generated F := Q8 F * R F
private theorem Q9_apply (v : Space F) : (Q9 F).val v 8 = v 9 := by
  change (Q8 F).val ((R F).val v) 8 = _
  rw [Q8_apply, R_apply]
  rfl
private def Q5 : generated F := Q9 F * S F
private theorem Q5_apply (v : Space F) : (Q5 F).val v 8 = v 5 := by
  change (Q9 F).val ((S F).val v) 8 = _
  rw [Q9_apply, S_apply]
  rfl
private def Q3 : generated F := Q5 F * R F
private theorem Q3_apply (v : Space F) : (Q3 F).val v 8 = v 3 := by
  change (Q5 F).val ((R F).val v) 8 = _
  rw [Q5_apply, R_apply]
  rfl
private def Q1 : generated F := Q3 F * S F
private theorem Q1_apply (v : Space F) : (Q1 F).val v 8 = v 1 := by
  change (Q3 F).val ((S F).val v) 8 = _
  rw [Q3_apply, S_apply]
  rfl
private def Q0 : generated F := Q1 F * R F
private theorem Q0_apply (v : Space F) : (Q0 F).val v 8 = v 0 := by
  change (Q1 F).val ((R F).val v) 8 = _
  rw [Q1_apply, R_apply]
  rfl
private def Q13 : generated F := Q3 F * dE F + Q5 F
private theorem Q13_apply (v : Space F) : (Q13 F).val v 8 = v 13 := by
  change (Q3 F).val ((dE F).val v) 8 + (Q5 F).val v 8 = _
  rw [Q3_apply, Q5_apply, dE_apply]
  simp [add_comm, CharTwo.add_cancel_left]
private def Q6 : generated F := Q13 F * S F
private theorem Q6_apply (v : Space F) : (Q6 F).val v 8 = v 6 := by
  change (Q13 F).val ((S F).val v) 8 = _
  rw [Q13_apply, S_apply]
  rfl
private def Q12 : generated F := Q13 F * dF F
private theorem Q12_apply (v : Space F) : (Q12 F).val v 8 = v 12 := by
  change (Q13 F).val ((dF F).val v) 8 = _
  rw [Q13_apply, dF_apply]
  rfl
private def Q11 : generated F := Q12 F * R F
private theorem Q11_apply (v : Space F) : (Q11 F).val v 8 = v 11 := by
  change (Q12 F).val ((R F).val v) 8 = _
  rw [Q12_apply, R_apply]
  rfl
private def Q10 : generated F := Q11 F * S F
private theorem Q10_apply (v : Space F) : (Q10 F).val v 8 = v 10 := by
  change (Q11 F).val ((S F).val v) 8 = _
  rw [Q11_apply, S_apply]
  rfl
private def Q7 : generated F := Q12 F * S F
private theorem Q7_apply (v : Space F) : (Q7 F).val v 8 = v 7 := by
  change (Q12 F).val ((S F).val v) 8 = _
  rw [Q12_apply, S_apply]
  rfl
private def Q4 : generated F := Q7 F * R F
private theorem Q4_apply (v : Space F) : (Q4 F).val v 8 = v 4 := by
  change (Q7 F).val ((R F).val v) 8 = _
  rw [Q7_apply, R_apply]
  rfl
private def Q2 : generated F := Q4 F * S F
private theorem Q2_apply (v : Space F) : (Q2 F).val v 8 = v 2 := by
  change (Q4 F).val ((S F).val v) 8 = _
  rw [Q4_apply, S_apply]
  rfl
private def L : Fin 14 → generated F := ![L0 F, L1 F, L2 F, L3 F, L4 F, L5 F, L6 F, L7 F, L8 F, L9 F, L10 F, L11 F, L12 F, L13 F]
private def Q : Fin 14 → generated F := ![Q0 F, Q1 F, Q2 F, Q3 F, Q4 F, Q5 F, Q6 F, Q7 F, Q8 F, Q9 F, Q10 F, Q11 F, Q12 F, Q13 F]
private theorem L_apply (i : Fin 14) (a : F) : (L F i).val (Pi.single 0 a) = Pi.single i a := by
  fin_cases i
  · exact L0_apply F a
  · exact L1_apply F a
  · exact L2_apply F a
  · exact L3_apply F a
  · exact L4_apply F a
  · exact L5_apply F a
  · exact L6_apply F a
  · exact L7_apply F a
  · exact L8_apply F a
  · exact L9_apply F a
  · exact L10_apply F a
  · exact L11_apply F a
  · exact L12_apply F a
  · exact L13_apply F a
private theorem Q_apply (j : Fin 14) (v : Space F) : (Q F j).val v 8 = v j := by
  fin_cases j
  · exact Q0_apply F v
  · exact Q1_apply F v
  · exact Q2_apply F v
  · exact Q3_apply F v
  · exact Q4_apply F v
  · exact Q5_apply F v
  · exact Q6_apply F v
  · exact Q7_apply F v
  · exact Q8_apply F v
  · exact Q9_apply F v
  · exact Q10_apply F v
  · exact Q11_apply F v
  · exact Q12_apply F v
  · exact Q13_apply F v
/-- Extract one coordinate and insert it in another. -/
def matrixUnit (i j : Fin 14) : Module.End F (Space F) :=
  (LinearMap.single F (fun _ : Fin 14 => F) i).comp (LinearMap.proj j)
omit [CharP F 2] in
@[simp] theorem matrixUnit_apply (i j : Fin 14) (v : Space F) :
    matrixUnit F i j v = Pi.single i (v j) := rfl
/-- A small rank-one certificate produces all matrix units inside the action algebra. -/
theorem matrixUnit_mem_adjoin (i j : Fin 14) :
    matrixUnit F i j ∈ Algebra.adjoin F (Set.range (action F)) := by
  have h : matrixUnit F i j = (L F i * P F * Q F j).val := by
    apply LinearMap.ext
    intro v
    change Pi.single i (v j) = (L F i).val ((P F).val ((Q F j).val v))
    rw [P_apply, Q_apply, L_apply]
  rw [h]
  exact (L F i * P F * Q F j).property
/-- The adjoint action generates the full endomorphism algebra over its base field. -/
theorem adjoin_action_eq_top : Algebra.adjoin F (Set.range (action F)) = ⊤ := by
  apply top_unique
  intro f _
  have hf : f = ∑ j : Fin 14, ∑ i : Fin 14,
      (f (Pi.single j 1) i) • matrixUnit F i j := by
    apply LinearMap.ext
    intro v
    conv_lhs => rw [← Finset.univ_sum_single v]
    simp only [map_sum, LinearMap.sum_apply]
    apply Finset.sum_congr rfl
    intro j _
    have hv : Pi.single j (v j) = v j • (Pi.single j 1 : Space F) := by
      ext i
      simp [Pi.single_apply]
    rw [hv, map_smul]
    ext k
    simp [LinearMap.smul_apply, matrixUnit_apply, Pi.single_apply, mul_comm]
  rw [hf]
  exact Subalgebra.sum_mem _ fun j _ => Subalgebra.sum_mem _ fun i _ =>
    Subalgebra.smul_mem _ (matrixUnit_mem_adjoin F i j) _

/-- Absolute irreducibility follows from the explicit full matrix algebra. -/
theorem absolutelyIrreducible : Representation.IsAbsolutelyIrreducible (action F) := by
  constructor
  apply Representation.irreducible_of_jacobson_density_surjective
  exact (Representation.extendScalars_surj_iff (AlgebraicClosure F) (action F)).mp
    (adjoin_action_eq_top F)

/-- The actual derivation action generates its full endomorphism algebra. -/
theorem adjoin_adjointAction_eq_top :
    Algebra.adjoin F (Set.range (Adjoint.action F)) = ⊤ := by
  let e := LinearEquiv.conjAlgEquiv F (equiv F)
  have he : (Algebra.adjoin F (Set.range (Adjoint.action F))).map e.toAlgHom =
      Algebra.adjoin F (Set.range (action F)) := by
    rw [AlgHom.map_adjoin, ← Set.range_comp]
    rfl
  apply top_unique
  intro f _
  have hf : e f ∈ (Algebra.adjoin F (Set.range (Adjoint.action F))).map e.toAlgHom := by
    rw [he, adjoin_action_eq_top]
    trivial
  obtain ⟨x, hx, hxf⟩ := hf
  exact e.injective hxf ▸ hx

omit [CharP F 2] in
private theorem absolute_of_full {V : Type*} [AddCommGroup V] [Module F V]
    [FiniteDimensional F V] [Nontrivial V] (ρ : Representation F (Model F) V)
    (hρ : Algebra.adjoin F (Set.range ρ) = ⊤) :
    Representation.IsAbsolutelyIrreducible ρ := by
  constructor
  apply Representation.irreducible_of_jacobson_density_surjective
  exact (Representation.extendScalars_surj_iff (AlgebraicClosure F) ρ).mp hρ

/-- Absolute irreducibility of the actual derivation representation. -/
theorem adjoint_absolutelyIrreducible :
    Representation.IsAbsolutelyIrreducible (F := F) (V := Adjoint.Space F) (Adjoint.action F) := by
  let : AddCommGroup (Adjoint.Space F) :=
    Submodule.addCommGroup (R := F) (M := Module.End F (Atlas.SplitOctonion.Carrier F)) (Adjoint.derivations F)
  let : FiniteDimensional F (Adjoint.Space F) := (equiv F).symm.finiteDimensional
  let : Nontrivial (Adjoint.Space F) := (equiv F).symm.injective.nontrivial
  exact absolute_of_full F (V := Adjoint.Space F) (Adjoint.action F)
    (adjoin_adjointAction_eq_top F)
/-- Irreducibility after every field extension, retaining the tensor-product action. -/
theorem adjoint_irreducible_extendScalars (K : Type*) [Field K] [Algebra F K] :
    Representation.IsIrreducible
      (Representation.extendScalars (F := F) (V := Adjoint.Space F) K (Adjoint.action F)) := by
  let : AddCommGroup (Adjoint.Space F) :=
    Submodule.addCommGroup (R := F) (M := Module.End F (Atlas.SplitOctonion.Carrier F)) (Adjoint.derivations F)
  let : FiniteDimensional F (Adjoint.Space F) := (equiv F).symm.finiteDimensional
  let : Representation.IsAbsolutelyIrreducible (F := F) (V := Adjoint.Space F)
      (Adjoint.action F) := adjoint_absolutelyIrreducible F
  exact Representation.IsAbsolutelyIrreducible.irreducible_of_extension
    (F := F) (V := Adjoint.Space F) (Adjoint.action F) K
end Atlas.G2.Restricted.Adjoint.Coordinates
