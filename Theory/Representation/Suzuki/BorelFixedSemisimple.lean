module
public import Theory.Representation.Suzuki.BorelPermutation
public import Theory.Representation.NormalSemisimpleSpan

/-!
# Semisimple cyclic modules generated by Suzuki Borel-fixed vectors

The ovoid permutation action is the proved direct sum of its constant line
and the full Steinberg tensor. A Borel-fixed vector gives a literal orbit
map from that permutation module. Its image is semisimple and contains the
original vector. No faithfulness, irreducibility or algebraic closure is
required of the target.

Consumer: the original V₃ seed in the U_H/V₁ action of Aschbacher–Smith
13.6.27, printed p.934.
-/

@[expose] public noncomputable section
namespace Representation.SuzukiSmallDegree
open BenderSuzuki.MatrixGroups SuzukiNatural

/-- Every vector fixed by the full Suzuki Borel lies in a semisimple cyclic
subrepresentation, over every extension of the defining field. -/
theorem borel_fixed_semisimple_subrepresentation {m : ℕ} (hm : 1 ≤ m)
    {K W : Type*} [Field K] [Algebra (F m) K] [AddCommGroup W] [Module K W]
    (ρ : Representation K (SuzukiMatrixGroup m) W) (v : W)
    (hfix : ∀ g ∈ SuzukiBorelSubgroup m, ρ g v = v) :
    ∃ S : Subrepresentation ρ, S.IsSemisimple ∧ v ∈ S := by
  classical
  let : Fintype (SuzukiOvoid m) := Fintype.ofFinite _
  have hx : ∀ g : SuzukiMatrixGroup m,
      g • suzukiOvoidInfinity m = suzukiOvoidInfinity m → ρ g v = v := by
    intro g hg
    apply hfix g
    rwa [suzukiBorelSubgroup_eq_stabilizer m (by omega), MulAction.mem_stabilizer_iff]
  let f := FixedPointPermutation.orbitMap (suzukiOvoidInfinity m) ρ v hx
  let := ovoid_permutation_semisimple hm K
  refine ⟨f.range, intertwining_range_semisimple _ _ f, ?_⟩
  refine ⟨Pi.single (suzukiOvoidInfinity m) 1, ?_⟩
  exact (FixedPointPermutation.orbitMap_single _ ρ v hx _).trans
    (FixedPointPermutation.value_base _ ρ v hx)

end Representation.SuzukiSmallDegree
