module

public import Theory.Representation.ElementaryAbelianAction
public import Mathlib.RepresentationTheory.Coinvariants
public import Mathlib.GroupTheory.SemidirectProduct
public import Mathlib.GroupTheory.IsPerfect

/-!
# Elementary kernels in perfect split extensions

The projection of a semidirect product to the coinvariants of its elementary
abelian kernel is a group homomorphism to an abelian group. Perfectness kills
this projection. Translating the resulting spanning statement back to groups
proves that the kernel is its commutator with the complement.

Source application: Aschbacher–Smith, I.2.2(6), printed p.412, combined
manuscript of 1 March 2004. The result here is general group theory.
-/

@[expose] public section

open scoped IsMulCommutative
namespace Representation
variable {A R : Type*} [Group A] [Group R] {p : ℕ} [Fact p.Prime]
  [IsElementaryAbelian p R]

/-- The representation belonging to the specified automorphism homomorphism. -/
noncomputable def elementaryRepresentation (φ : A →* MulAut R) :
    Representation (ZMod p) A (Additive R) where
  toFun a := (φ a).toMonoidHom.toAdditive.toZModLinearMap p
  map_one' := by ext v; exact congrArg Additive.ofMul (congrArg (fun f : MulAut R => f v.toMul) φ.map_one)
  map_mul' a b := by ext v; exact congrArg Additive.ofMul (congrArg (fun f : MulAut R => f v.toMul) (φ.map_mul a b))

@[simp] theorem elementaryRepresentation_apply (φ : A →* MulAut R) (a : A) (v : Additive R) :
    elementaryRepresentation (p := p) φ a v = Additive.ofMul (φ a v.toMul) := rfl

/-- In a perfect split extension, the elementary abelian kernel is generated by
its action commutators. The coinvariant quotient is an abelian quotient of the
whole extension. -/
theorem elementary_coinvariants_eq_top_of_perfect (φ : A →* MulAut R)
    [Group.IsPerfect (R ⋊[φ] A)] :
    Coinvariants.ker (elementaryRepresentation (p := p) φ) = ⊤ := by
  let σ := elementaryRepresentation (p := p) φ
  let f : R ⋊[φ] A →* Multiplicative (Coinvariants σ) :=
    { toFun x := Multiplicative.ofAdd (Coinvariants.mk σ (Additive.ofMul x.left))
      map_one' := map_zero (Coinvariants.mk σ)
      map_mul' x y := by
        change Coinvariants.mk σ (Additive.ofMul (x.left * φ x.right y.left)) =
          Coinvariants.mk σ (Additive.ofMul x.left) +
            Coinvariants.mk σ (Additive.ofMul y.left)
        change Coinvariants.mk σ (Additive.ofMul x.left + σ x.right (Additive.ofMul y.left)) = _
        rw [map_add, Coinvariants.mk_self_apply] }
  apply top_unique
  intro v _
  apply (Coinvariants.mk_eq_zero σ).mp
  exact Abelianization.commutator_subset_ker f
    (Group.IsPerfect.mem_commutator (g := SemidirectProduct.inl v.toMul))
include p in
/-- The group commutator statement for the literal two factors of the split extension. -/
theorem elementary_range_eq_commutator_of_perfect (φ : A →* MulAut R)
    [Group.IsPerfect (R ⋊[φ] A)] :
    (SemidirectProduct.inl : R →* R ⋊[φ] A).range =
      ⁅(SemidirectProduct.inl : R →* R ⋊[φ] A).range,
        (SemidirectProduct.inr : A →* R ⋊[φ] A).range⁆ := by
  let D : Subgroup (R ⋊[φ] A) :=
    ⁅(SemidirectProduct.inl : R →* R ⋊[φ] A).range,
      (SemidirectProduct.inr : A →* R ⋊[φ] A).range⁆
  let C : Subgroup R := D.comap SemidirectProduct.inl
  let W : Submodule (ZMod p) (Additive R) :=
    AddSubgroup.toZModSubmodule p C.toAddSubgroup
  have hW : Coinvariants.ker (elementaryRepresentation (p := p) φ) ≤ W := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨a, v⟩, rfl⟩
    change (elementaryRepresentation (p := p) φ a v - v) ∈ W
    change SemidirectProduct.inl ((elementaryRepresentation (p := p) φ a v - v).toMul) ∈ D
    change SemidirectProduct.inl (φ a v.toMul / v.toMul) ∈ D
    rw [div_eq_mul_inv]
    rw [map_mul, map_inv, SemidirectProduct.inl_aut]
    have h := Subgroup.commutator_mem_commutator
      (show SemidirectProduct.inr a ∈ (SemidirectProduct.inr : A →* R ⋊[φ] A).range from ⟨a, rfl⟩)
      (show SemidirectProduct.inl v.toMul ∈ (SemidirectProduct.inl : R →* R ⋊[φ] A).range from ⟨v.toMul, rfl⟩)
    rw [Subgroup.commutator_comm] at h
    simpa only [commutatorElement_def, map_inv] using h
  rw [elementary_coinvariants_eq_top_of_perfect φ] at hW
  apply le_antisymm
  · rintro _ ⟨r, rfl⟩
    exact hW (show Additive.ofMul r ∈ (⊤ : Submodule (ZMod p) (Additive R)) from Submodule.mem_top)
  · rw [SemidirectProduct.range_inl_eq_ker_rightHom]
    exact Subgroup.commutator_le_left _ _
end Representation
