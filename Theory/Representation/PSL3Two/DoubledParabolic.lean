module

public import Theory.Representation.PSL3Two.SmallModules
public import Theory.SpecificGroups.PSL3Two.Parabolics.Subgroups.Coordinates

/-!
# Split points in two natural binary three-spaces

The plane generated by `(x,0)` and `(0,y)` in two copies of the natural
SL₃(2)-module is not invariant under the diagonal line parabolic when x is
a nonzero point of its marked projective line. An explicit cubic in the
parabolic moves x outside its one-dimensional span. Projection onto the
first summand then rules out invariance of the split plane.

The projective line here is the binary plane `x 2 = 0`. Both summands and
the action are the actual natural representations, not dimension tags.
Source: Aschbacher–Smith, combined 1 March 2004 manuscript, proof of
Lemma 13.6.20, printed p.931.
-/

@[expose] public section
open Matrix Representation
namespace BinaryLinearThree.DoubledParabolic

private def cycle : Group := ⟨!![0,1,0;1,1,0;0,0,1], by decide⟩

private theorem cycle_mem : cycle ∈ Matrix.PSL3Two.lineParabolicSL := by decide

private theorem cycle_moves : ∀ x : Vector, x 2 = 0 → x ≠ 0 →
    ∀ a : ZMod 2, W cycle x ≠ a • x := by decide +kernel

/-- The binary plane generated by one point in each of the two actual summands. -/
def splitPlane (x y : Vector) : Submodule (ZMod 2) (Vector × Vector) :=
  Submodule.span (ZMod 2) {((x, 0) : Vector × Vector), (0, y)}

/-- The line parabolic cannot preserve the split-point plane. This already
follows from a nonzero point in its line in the first summand. -/
theorem splitPlane_not_invariant (x y : Vector) (hx : x 2 = 0) (hn : x ≠ 0) :
    ¬ ∀ g ∈ Matrix.PSL3Two.lineParabolicSL, ∀ u ∈ splitPlane x y,
      (W.prod W) g u ∈ splitPlane x y := by
  intro h
  have hm := h cycle cycle_mem (x, 0) (Submodule.subset_span (by simp))
  obtain ⟨a, b, he⟩ := Submodule.mem_span_pair.mp hm
  have he' := congrArg Prod.fst he
  have hc : a • x = W cycle x := by simpa using he'
  exact cycle_moves x hx hn a hc.symm

end BinaryLinearThree.DoubledParabolic
