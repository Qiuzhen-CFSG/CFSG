module

public import Theory.Representation.PSL3Two.DoubledParabolic
public import Theory.GroupTheory.PResidual.FiniteImage

/-!
# The two-residual obstruction on doubled natural modules

The order-three matrix in the marked line parabolic belongs to its
intrinsic two-residual. It moves every nonzero point of the invariant
binary plane outside its span, so the residual cannot preserve a plane
generated by one point in each natural summand. This is the actor needed
when only O²(N_K(S)) normalizes the source commutator subgroup; it does
not require that this residual surject onto the whole S₄ parabolic.

Source: Aschbacher–Smith, combined 1 March 2004 manuscript,
Lemma 13.6.20, printed p.931.
-/

@[expose] public section
open Matrix Representation Subgroup
namespace BinaryLinearThree.DoubledParabolic

private def cubic : Group := ⟨!![0,1,0;1,1,0;0,0,1], by decide⟩

private theorem cubic_mem : cubic ∈ Matrix.PSL3Two.lineParabolicSL := by decide

private theorem cubic_cube : cubic ^ 3 = 1 := by decide +kernel

private theorem cubic_moves : ∀ x : Vector, x 2 = 0 → x ≠ 0 →
    ∀ a : ZMod 2, W cubic x ≠ a • x := by decide +kernel

private theorem cubic_mem_residual :
    cubic ∈ (pResidual 2 Matrix.PSL3Two.lineParabolicSL).map
      Matrix.PSL3Two.lineParabolicSL.subtype := by
  let c : Matrix.PSL3Two.lineParabolicSL := ⟨cubic, cubic_mem⟩
  have hc : c ^ 3 = 1 := Subtype.ext cubic_cube
  exact ⟨c, mem_pResidual_of_orderOf_coprime
    (Nat.Coprime.of_dvd_right (orderOf_dvd_of_pow_eq_one hc) (by decide)), rfl⟩

/-- The split-point plane is already moved by the two-residual of the
line parabolic. The marked projective line is the binary plane x₂ = 0. -/
theorem splitPlane_not_invariant_residual (x y : Vector) (hx : x 2 = 0) (hn : x ≠ 0) :
    ¬ ∀ g ∈ (pResidual 2 Matrix.PSL3Two.lineParabolicSL).map
        Matrix.PSL3Two.lineParabolicSL.subtype, ∀ u ∈ splitPlane x y,
      (W.prod W) g u ∈ splitPlane x y := by
  intro h
  have hm := h cubic cubic_mem_residual (x, 0) (Submodule.subset_span (by simp))
  obtain ⟨a, b, he⟩ := Submodule.mem_span_pair.mp hm
  have he' := congrArg Prod.fst he
  have hc : a • x = W cubic x := by simpa using he'
  exact cubic_moves x hx hn a hc.symm

end BinaryLinearThree.DoubledParabolic
