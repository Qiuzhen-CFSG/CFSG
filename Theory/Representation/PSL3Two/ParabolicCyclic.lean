module

public import Theory.Representation.PSL3Two.ParabolicCyclic.Seed
public import Theory.Representation.PSL3Two.ParabolicCyclic.PointRecognition
public import Theory.Representation.PSL3Two.ParabolicCyclic.QuotientClassification

/-!
# Binary modules generated by parabolic seeds

For a point-parabolic-fixed nonzero cyclic vector whose line-parabolic orbit
spans a plane, `point_seed_equiv_natural` constructs an equivariant linear
isomorphism with the actual natural module `W` (the source's `V`).

For a Borel-fixed cyclic vector with the same plane condition, the flag
permutation module surjects onto the generated module. The seed relation
excludes the trivial and dual-natural heads, so the retained point core and
Steinberg summands still surject. The two images intersect trivially by their
dimensions and Steinberg irreducibility. The point-core submodule lattice then
gives all five alternatives. Cyclic generation supplies finite dimensionality;
the plane condition supplies nontriviality. No additional premises are needed.

`faithful_parabolic_seed_recognition` assembles both conclusions of H.6.5 with
its stated faithfulness hypothesis. `parabolic_seed_alternatives` records the
stronger recognition result that does not require this hypothesis. The quotient
argument uses the corrected simple-head surjectivity lemma, independently of
the false kernel-containment assertion in printed H.6.4.

Source: Aschbacher–Smith H.5.5 and H.6.5, printed pp.386 and 388 of the
1 March 2004 manuscript (PDF pp.397 and 399).
-/

public section

open Representation
namespace BinaryLinearThree.ParabolicCyclic

variable {M : Type*} [AddCommGroup M] [Module (ZMod 2) M]

/-- A Borel-fixed cyclic seed with two-dimensional line-parabolic orbit span
recognizes one of the five actual modules in H.6.5. -/
theorem parabolic_seed_alternatives (ρ : Representation (ZMod 2) Group M) (m : M)
    (hfixed : ∀ g ∈ Matrix.PSL3Two.borelSL, ρ g m = m)
    (hgen : orbitSpan ρ ⊤ m = ⊤)
    (hdim : Module.finrank (ZMod 2) (orbitSpan ρ Matrix.PSL3Two.lineParabolicSL m) = 2) :
    Alternatives ρ := by
  have hm : m ≠ 0 := by
    intro hm
    exact lineCycle_moves_seed ρ m hfixed hdim (by simp [hm])
  let : Nontrivial M := ⟨⟨m, 0, hm⟩⟩
  obtain ⟨q, hq⟩ := quotient_of_parabolic_seed ρ m hfixed hgen hdim
  exact quotient_alternatives ρ q hq

/-- H.6.5 in full: a faithful module generated by the marked Sylow-fixed seed
is a quotient of `U₂.prod S` and is equivalent to one of the five listed modules.
Finite dimensionality follows from cyclic generation and is not an input. -/
theorem faithful_parabolic_seed_recognition (ρ : Representation (ZMod 2) Group M)
    (_hfaith : Function.Injective ρ) (m : M)
    (hfixed : ∀ g ∈ Matrix.PSL3Two.borelSL, ρ g m = m)
    (hgen : orbitSpan ρ ⊤ m = ⊤)
    (hdim : Module.finrank (ZMod 2) (orbitSpan ρ Matrix.PSL3Two.lineParabolicSL m) = 2) :
    (∃ q : (U₂.prod S).IntertwiningMap ρ, Function.Surjective q) ∧ Alternatives ρ :=
  ⟨quotient_of_parabolic_seed ρ m hfixed hgen hdim,
    parabolic_seed_alternatives ρ m hfixed hgen hdim⟩

end BinaryLinearThree.ParabolicCyclic
