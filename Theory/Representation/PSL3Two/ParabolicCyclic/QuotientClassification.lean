module

public import Theory.Representation.PSL3Two.ParabolicCyclic.Basic
public import Theory.Representation.PSL3Two.FanoCoreStructure

/-!
# Quotients of the point core plus Steinberg

Every nonzero quotient of the actual binary SL₃(2) module `U₂.prod S` is
isomorphic to `W`, `U₂`, `S`, `W.prod S`, or `U₂.prod S`.

The point-core image has dimension at most six. A nonzero Steinberg image is
simple of dimension eight, so it meets the point-core image trivially. The
three possible point-core kernels give a zero, natural, or full-core image;
the Steinberg image is zero or isomorphic to Steinberg. The proof constructs
the resulting equivariant linear equivalences, excluding the zero target.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, H.6.5,
printed p.388 (PDF p.399). This proves the quotient-classification step;
the parabolic-seed hypotheses yielding the surjection are handled separately.
-/

public section

open Representation
namespace BinaryLinearThree.ParabolicCyclic

section General
variable {k G X Y M : Type*} [Field k] [Monoid G]
  [AddCommGroup X] [Module k X] [AddCommGroup Y] [Module k Y]
  [AddCommGroup M] [Module k M]
  {α : Representation k G X} {β : Representation k G Y} {ρ : Representation k G M}

/-- An injective image of a larger simple module cannot meet the first image. -/
private theorem separate_images [FiniteDimensional k X] [FiniteDimensional k Y]
    [IsIrreducible β] (hdim : Module.finrank k X < Module.finrank k Y)
    (f : α.IntertwiningMap ρ) (g : β.IntertwiningMap ρ)
    (hg : Function.Injective g) (x : X) (y : Y) (h : f x = g y) : y = 0 := by
  let N : Subrepresentation β := {
    toSubmodule := f.range.toSubmodule.comap g.toLinearMap
    apply_mem_toSubmodule := by
      intro a y hy
      change g (β a y) ∈ f.range
      rw [g.isIntertwining]
      exact f.range.apply_mem_toSubmodule a hy }
  have hy : y ∈ N := ⟨x, h⟩
  rcases eq_bot_or_eq_top N with hN | hN
  · rw [hN] at hy
    exact hy
  · have hmem (z : Y) : g z ∈ f.range.toSubmodule := by
      change z ∈ N
      rw [hN]
      trivial
    let l : Y →ₗ[k] f.range.toSubmodule := g.toLinearMap.codRestrict _ hmem
    have hl : Function.Injective l := by
      intro a b hab
      exact hg (congrArg Subtype.val hab)
    let : FiniteDimensional k f.range.toSubmodule := Module.Finite.range f.toLinearMap
    have hle := LinearMap.finrank_le_finrank_of_injective hl
    have hle' := LinearMap.finrank_range_le f.toLinearMap
    exact False.elim (Nat.not_le_of_lt hdim (hle.trans hle'))

/-- A module generated by two such images is the first image or their direct sum. -/
private theorem equiv_or_product [FiniteDimensional k X] [FiniteDimensional k Y]
    [IsIrreducible β] (hdim : Module.finrank k X < Module.finrank k Y)
    (f : α.IntertwiningMap ρ) (g : β.IntertwiningMap ρ)
    (hf : Function.Injective f)
    (hspan : ∀ m : M, ∃ x y, f x + g y = m) :
    Nonempty (ρ.Equiv α) ∨ Nonempty (ρ.Equiv (α.prod β)) := by
  rcases IsIrreducible.injective_or_eq_zero g with hg | hg
  · let t : (α.prod β).IntertwiningMap ρ :=
      f.comp (IntertwiningMap.fst k α β) + g.comp (IntertwiningMap.snd k α β)
    have hinj : Function.Injective t := by
      apply LinearMap.ker_eq_bot.mp
      apply bot_unique
      intro a ha
      change a = 0
      change f a.1 + g a.2 = 0 at ha
      have hs : f a.1 = g (-a.2) := by rw [map_neg]; exact eq_neg_of_add_eq_zero_left ha
      have hy : a.2 = 0 := neg_eq_zero.mp (separate_images hdim f g hg _ _ hs)
      have hx : a.1 = 0 := hf (by simpa [hy] using ha)
      exact Prod.ext hx hy
    have hsurj : Function.Surjective t := by
      intro m
      obtain ⟨x,y,h⟩ := hspan m
      exact ⟨(x,y),h⟩
    exact Or.inr ⟨(t.ofBijective ⟨hinj,hsurj⟩).symm⟩
  · have hsurj : Function.Surjective f := by
      intro m
      obtain ⟨x,y,h⟩ := hspan m
      exact ⟨x,by simpa [hg] using h⟩
    exact Or.inl ⟨(f.ofBijective ⟨hf,hsurj⟩).symm⟩

/-- Equal kernels give an injective factor through a surjective intertwiner. -/
private theorem factor_of_same_kernel
    (π : α.IntertwiningMap β) (hπ : Function.Surjective π)
    (f : α.IntertwiningMap ρ) (hker : f.ker = π.ker) :
    ∃ j : β.IntertwiningMap ρ, Function.Injective j ∧ j.comp π = f := by
  have hle : LinearMap.ker π.toLinearMap ≤ LinearMap.ker f.toLinearMap := by
    change π.ker.toSubmodule ≤ f.ker.toSubmodule
    rw [hker]
  let e := π.toLinearMap.quotKerEquivOfSurjective hπ
  let l := ((LinearMap.ker π.toLinearMap).liftQ f.toLinearMap hle).comp e.symm.toLinearMap
  have hl (x : X) : l (π x) = f x := by
    change (LinearMap.ker π.toLinearMap).liftQ f.toLinearMap hle (e.symm (π x)) = f x
    have he : e.symm (π x) = Submodule.Quotient.mk x := by
      exact LinearMap.quotKerEquivOfSurjective_symm_apply π.toLinearMap hπ x
    rw [he]
    rfl
  let j : β.IntertwiningMap ρ := {
    toLinearMap := l
    isIntertwining' := by
      intro a
      apply LinearMap.ext
      intro y
      obtain ⟨x,rfl⟩ := hπ y
      change l (β a (π x)) = ρ a (l (π x))
      rw [← π.isIntertwining, hl, f.isIntertwining, hl] }
  have hj : j.comp π = f := IntertwiningMap.ext (LinearMap.ext hl)
  refine ⟨j, ?_, hj⟩
  apply LinearMap.ker_eq_bot.mp
  apply bot_unique
  intro y hy
  change y = 0
  obtain ⟨x,rfl⟩ := hπ y
  have hx : x ∈ f.ker := by
    change f x = 0
    rw [← hl]
    exact hy
  rw [hker] at hx
  exact hx
end General

open FanoCoreStructure FanoDecomposition

variable {M : Type*} [AddCommGroup M] [Module (ZMod 2) M] [Nontrivial M]

/-- Every nonzero quotient of the actual point core plus Steinberg is one of
the five modules in H.6.5. No finiteness assumption on the target is needed. -/
theorem quotient_alternatives (ρ : Representation (ZMod 2) Group M)
    (q : (U₂.prod S).IntertwiningMap ρ) (hq : Function.Surjective q) : Alternatives ρ := by
  let f := q.comp (IntertwiningMap.inl (ZMod 2) U₂ S)
  let g := q.comp (IntertwiningMap.inr (ZMod 2) U₂ S)
  let : IsIrreducible S := IrreducibleCatalogue.steinberg_irreducible
  have hspan : ∀ m : M, ∃ x y, f x + g y = m := by
    intro m
    obtain ⟨⟨x,y⟩,rfl⟩ := hq m
    refine ⟨x,y,?_⟩
    change q (x,0) + q (0,y) = q (x,y)
    rw [← map_add]
    congr 1
    simp
  let : Nonempty Point := ⟨Matrix.PSL3Two.flagPoint⟩
  have hdim : Module.finrank (ZMod 2) Core < Module.finrank (ZMod 2) Steinberg := by
    rw [finrank_steinberg, BinaryPermutation.finrank_core, Matrix.PSL3Two.Fano.card_point]
    decide
  rcases pointCore_subrepresentations f.ker with hk | hk | hk
  · have hf : Function.Injective f :=
      LinearMap.ker_eq_bot.mp (congrArg Subrepresentation.toSubmodule hk)
    rcases equiv_or_product hdim f g hf hspan with h | h
    · exact Or.inr (Or.inl h)
    · exact Or.inr (Or.inr (Or.inr (Or.inr h)))
  · obtain ⟨j,hj,hjf⟩ := factor_of_same_kernel pointWeightedSum pointWeightedSum_surjective f hk
    have hspan' : ∀ m : M, ∃ x y, j x + g y = m := by
      intro m
      obtain ⟨x,y,h⟩ := hspan m
      refine ⟨pointWeightedSum x,y,?_⟩
      have he := congrArg (fun t : U₂.IntertwiningMap ρ => t x) hjf
      exact (congrArg (fun z => z + g y) he).trans h
    have hd : Module.finrank (ZMod 2) Vector < Module.finrank (ZMod 2) Steinberg := by
      rw [finrank_steinberg]
      simp [Vector, Matrix.PSL3Two.Fano.Vector]
    rcases equiv_or_product hd j g hj hspan' with h | h
    · exact Or.inl h
    · exact Or.inr (Or.inr (Or.inr (Or.inl h)))
  · have hf (x : Core) : f x = 0 := by
      change x ∈ f.ker
      rw [hk]
      trivial
    have hgs : Function.Surjective g := by
      intro m
      obtain ⟨x,y,h⟩ := hspan m
      exact ⟨y,by simpa [hf] using h⟩
    have hg : Function.Injective g := by
      rcases IsIrreducible.injective_or_eq_zero g with hi | hz
      · exact hi
      · obtain ⟨m,hm⟩ := exists_ne (0 : M)
        obtain ⟨y,hy⟩ := hgs m
        exact False.elim (hm (hy.symm.trans (by simp [hz])))
    exact Or.inr (Or.inr (Or.inl ⟨(g.ofBijective ⟨hg,hgs⟩).symm⟩))

end BinaryLinearThree.ParabolicCyclic
