module

public import Theory.Representation.FirstCohomologyDuality.Indecomposable
public import Theory.Representation.SLHigherNaturalFirstCohomology.SLThreeBinary
public import Theory.Representation.PSL3Two.AutomorphismAction.NaturalDual

/-!
# Central kernels of indecomposable binary SL₃ extensions

An indecomposable extension of the natural SL₃(2) module by a fixed space is
commutator generated, hence a cover. Its fixed kernel has dimension at most
one by the first cohomology of the dual natural module. Inverse transpose
identifies that cohomology with the already computed natural cohomology.
The argument permits the nonsplit four-dimensional extension.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, I.1.5–6,
printed p.408, applied at the start of Section 12.4, printed pp.812–813.
-/

public section
open Representation Representation.OneCohomology
namespace Representation.OneCohomology.SLThreeCentralExtension

/-- The graph automorphism transports the checked natural H¹ calculation
onto the contragredient natural module. -/
theorem finrank_H1_dual :
    Module.finrank (ZMod 2) (H1 (specialLinearNatural (k := ZMod 2) 3).dual) = 1 := by
  let e := BinaryLinearThree.AutomorphismAction.graphNaturalDual
  let a := BinaryLinearThree.AutomorphismAction.graph
  have he : ∀ g v, e.symm (BinaryLinearThree.W.dual g v) =
      BinaryLinearThree.W (a g) (e.symm v) := by
    intro g v
    change e.symm (BinaryLinearThree.W.dual g v) =
      (BinaryLinearThree.W.comp a.toMonoidHom) g (e.symm v)
    exact LinearMap.congr_fun (e.symm.isIntertwining' g) v
  exact (H1Congr _ _ a e.symm.toLinearEquiv he).finrank_eq.trans
    SLHigherNatural.finrank_H1_sl3_two

/-- The natural module is generated by its displacements. -/
theorem commutator_eq_top :
    Coinvariants.ker (specialLinearNatural (k := ZMod 2) 3) = ⊤ := by
  apply (fixed_dual_eq_bot_iff _).mp
  apply bot_unique
  intro v hv
  let e := BinaryLinearThree.AutomorphismAction.graphNaturalDual
  let a := BinaryLinearThree.AutomorphismAction.graph
  have hh : e.symm v ∈ fixed (specialLinearNatural (k := ZMod 2) 3) := by
    intro g
    obtain ⟨g, rfl⟩ := a.surjective g
    have he := LinearMap.congr_fun (e.symm.isIntertwining' g) v
    change e.symm (BinaryLinearThree.W.dual g v) =
      BinaryLinearThree.W (a g) (e.symm v) at he
    rw [hv g] at he
    exact he.symm
  rw [SLHigherNatural.fixed_eq_bot (by decide : 2 ≤ 3)] at hh
  have he : e.symm v = 0 := hh
  exact e.symm.injective (he.trans e.symm.map_zero.symm)

variable {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]
  [FiniteDimensional (ZMod 2) W]
  {σ : Representation (ZMod 2) (Matrix.SpecialLinearGroup (Fin 3) (ZMod 2)) W}

/-- The fixed kernel of an indecomposable natural extension has dimension at
most one. Neither splitting nor a bound on the original space is assumed. -/
theorem finrank_kernel_le_one
    (p : σ.IntertwiningMap (specialLinearNatural (k := ZMod 2) 3))
    (hp : Function.Surjective p) (hfixed : p.toLinearMap.ker ≤ fixed σ)
    (hind : ∀ A B : Submodule (ZMod 2) W,
      (∀ g v, v ∈ A → σ g v ∈ A) →
      (∀ g v, v ∈ B → σ g v ∈ B) → IsCompl A B → A = ⊥ ∨ B = ⊥) :
    Module.finrank (ZMod 2) p.toLinearMap.ker ≤ 1 := by
  have hc := isCover_of_indecomposable p hp hfixed commutator_eq_top hind
  have hd := finrank_ker_le_H1_of_cover p hc
  rwa [finrank_H1_dual] at hd

/-- The same bound in group-theoretic cardinality form. -/
theorem card_kernel_le_two
    (p : σ.IntertwiningMap (specialLinearNatural (k := ZMod 2) 3))
    (hp : Function.Surjective p) (hfixed : p.toLinearMap.ker ≤ fixed σ)
    (hind : ∀ A B : Submodule (ZMod 2) W,
      (∀ g v, v ∈ A → σ g v ∈ A) →
      (∀ g v, v ∈ B → σ g v ∈ B) → IsCompl A B → A = ⊥ ∨ B = ⊥) :
    Nat.card p.toLinearMap.ker ≤ 2 := by
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2), Nat.card_zmod]
  exact (Nat.pow_le_pow_right (by decide : 0 < 2)
    (finrank_kernel_le_one p hp hfixed hind)).trans_eq (by norm_num)

end Representation.OneCohomology.SLThreeCentralExtension
