module

public import Theory.Representation.BinaryOffender.ConjugateDisplacement
public import Theory.Representation.DualCommutator

/-!
# Moved dimension from conjugate generators

If a group is generated by n conjugates of one element, its entire moved
space has dimension at most n times that element's displacement rank.
Apply the joint displacement map to the dual module: its kernel is contained
in the global fixed space, whose codimension is the original moved dimension.
Unlike the fixed-point-free degree bound, this permits an arbitrary fixed
kernel and so controls the original moved space before an extension splits.

Source application: Aschbacher–Smith, G.6.4, printed pp.345–346.
-/

public section
set_option backward.isDefEq.respectTransparency false
namespace Representation.BinaryOffender
open Subgroup
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V]

/-- Conjugate generation bounds the original moved space, even with fixed vectors. -/
theorem finrank_coinvariants_le_mul_displacement_of_conjugate_generation
    (ρ : Representation (ZMod 2) G V) (t : G) {n : ℕ} (g : Fin n → G)
    (hgen : closure (Set.range fun i => g i * t * (g i)⁻¹) = ⊤) :
    Module.finrank (ZMod 2) (Coinvariants.ker ρ) ≤
      n * Module.finrank (ZMod 2) (LinearMap.range (ρ t - LinearMap.id)) := by
  let σ := ρ.dual
  let δ (i : Fin n) := σ (g i * t * (g i)⁻¹) - LinearMap.id
  let D : Module.Dual (ZMod 2) V →ₗ[ZMod 2] (∀ i : Fin n, LinearMap.range (δ i)) :=
    LinearMap.pi fun i => (δ i).rangeRestrict
  have hker : D.ker ≤ σ.invariants := by
    intro v hv
    have hv' (i : Fin n) : σ (g i * t * (g i)⁻¹) v = v := by
      have he := congrArg (fun f : ∀ i : Fin n, LinearMap.range (δ i) =>
        (f i : Module.Dual (ZMod 2) V)) hv
      exact sub_eq_zero.mp he
    let T : Subgroup G := {
      carrier := {a | σ a v = v}
      one_mem' := by simp
      mul_mem' := by
        intro a b ha hb
        change σ a v = v at ha
        change σ b v = v at hb
        change σ (a * b) v = v
        simpa only [map_mul, Module.End.mul_apply, hb] using ha
      inv_mem' := by
        intro a ha
        have he : σ a⁻¹ (σ a v) = v := by
          rw [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one]
          rfl
        rwa [ha] at he }
    have hT : closure (Set.range fun i => g i * t * (g i)⁻¹) ≤ T := by
      apply (closure_le T).mpr
      rintro _ ⟨i, rfl⟩
      exact hv' i
    intro a
    exact hT (hgen.ge (mem_top a))
  have hk := Submodule.finrank_mono hker
  have hd := LinearMap.finrank_range_add_finrank_ker (K := ZMod 2)
    (V := Module.Dual (ZMod 2) V) (V₂ := ∀ i : Fin n, LinearMap.range (δ i)) D
  have hq := σ.invariants.finrank_quotient_add_finrank
  have hr : Module.finrank (ZMod 2) D.range ≤
      Module.finrank (ZMod 2) (∀ i : Fin n, LinearMap.range (δ i)) :=
    Submodule.finrank_le D.range
  have hδ (i : Fin n) : Module.finrank (ZMod 2) (LinearMap.range (δ i)) =
      Module.finrank (ZMod 2) (LinearMap.range (ρ t - LinearMap.id)) := by
    rw [← fixedCodim_zpowers_eq_displacement_rank, fixedCodim_zpowers_conj,
      fixedCodim_zpowers_dual, fixedCodim_zpowers_eq_displacement_rank]
  let : ∀ i : Fin n, Module.Free (ZMod 2) (LinearMap.range (δ i)) :=
    fun i => Module.Free.of_divisionRing (ZMod 2) (LinearMap.range (δ i))
  have hpi : Module.finrank (ZMod 2) (∀ i : Fin n, LinearMap.range (δ i)) =
      ∑ i : Fin n, Module.finrank (ZMod 2) (LinearMap.range (δ i)) :=
    Module.finrank_pi_fintype (ZMod 2)
  rw [hpi] at hr
  simp only [hδ, Finset.sum_const,
    Finset.card_univ, Fintype.card_fin, smul_eq_mul] at hr
  change Module.finrank (ZMod 2) (Module.Dual (ZMod 2) V ⧸ ρ.dual.invariants) + _ = _ at hq
  rw [ρ.finrank_quotient_dual_invariants_eq_commutator] at hq
  omega

/-- The same bound through a specified isomorphism of the acting group. -/
theorem finrank_coinvariants_le_mul_displacement_of_equiv_conjugate_generation
    {H : Type*} [Group H] (ρ : Representation (ZMod 2) G V)
    (e : G ≃* H) (t : G) {n : ℕ} (g : Fin n → H)
    (hgen : closure (Set.range fun i => g i * e t * (g i)⁻¹) = ⊤) :
    Module.finrank (ZMod 2) (Coinvariants.ker ρ) ≤
      n * Module.finrank (ZMod 2) (LinearMap.range (ρ t - LinearMap.id)) := by
  apply finrank_coinvariants_le_mul_displacement_of_conjugate_generation
    ρ t (fun i => e.symm (g i))
  have hh := congrArg (Subgroup.map e.symm.toMonoidHom) hgen
  simpa only [MonoidHom.map_closure, ← Set.range_comp, Function.comp_def,
    MulEquiv.coe_toMonoidHom, map_mul, map_inv, e.symm_apply_apply,
    Subgroup.map_top_of_surjective e.symm.toMonoidHom e.symm.surjective] using hh

end Representation.BinaryOffender
