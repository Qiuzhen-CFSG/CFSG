module
public import Theory.Representation.BinaryOffender.PermutationConjugacy

/-!
# Stable families of binary offenders

Conjugacy preserves fixed-space dimension and the subgroup lattice, hence best
and minimal best offenders. Equal-weight descent preserves minimality. Together
with finite minimization this proves the stability assertion of Aschbacher–Smith
B.1.7 whenever the representation is an FF-module. A stable family generates a
normal subgroup, as used in B.1.9.

Source: *The Classification of Quasithin Groups*, 1 March 2004, pp. 70–71.
-/

public section
namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

/-- Conjugation preserves offender weight. -/
theorem weight_map_conj (A : Subgroup G) (g : G) :
    weight ρ (A.map (MulAut.conj g).toMonoidHom) = weight ρ A := by
  unfold weight
  rw [rank_map_conj, (fixedSpaceConjEquiv ρ A g).finrank_eq]

/-- Conjugation preserves best offenders. -/
theorem IsBestOffender.map_conj {A : Subgroup G}
    (hA : IsBestOffender ρ A) (g : G) :
    IsBestOffender ρ (A.map (MulAut.conj g).toMonoidHom) := by
  let e := (MulAut.conj g).mapSubgroup
  refine ⟨hA.1.map_conj g, fun B hB => ?_⟩
  have hle : e.symm B ≤ A := e.symm_apply_le.mpr hB
  have hweight : weight ρ B = weight ρ (e.symm B) := by
    have h := weight_map_conj ρ (e.symm B) g
    change weight ρ (e (e.symm B)) = _ at h
    simpa only [e.apply_symm_apply] using h
  rw [weight_map_conj, hweight]
  exact hA.2 _ hle

/-- Equal-weight inclusion is transported by conjugation. -/
theorem EqualWeightLE.map_conj {A B : Subgroup G}
    (h : EqualWeightLE ρ B A) (g : G) :
    EqualWeightLE ρ (B.map (MulAut.conj g).toMonoidHom)
      (A.map (MulAut.conj g).toMonoidHom) := by
  exact ⟨Subgroup.map_mono h.1, by simpa only [weight_map_conj] using h.2⟩

/-- Conjugation preserves minimal best offenders. -/
theorem IsMinimalBestOffender.map_conj {A : Subgroup G}
    (hA : IsMinimalBestOffender ρ A) (g : G) :
    IsMinimalBestOffender ρ (A.map (MulAut.conj g).toMonoidHom) := by
  refine ⟨hA.1.map_conj ρ g, fun B hB hBA => ?_⟩
  have hB' := hB.map_conj ρ g⁻¹
  have hBA' := hBA.map_conj ρ g⁻¹
  have hinv (x : G) :
      (MulAut.conj x⁻¹).toMonoidHom.comp (MulAut.conj x).toMonoidHom =
        MonoidHom.id G := by
    ext y
    simp [MulAut.conj_apply, mul_assoc]
  rw [Subgroup.map_map, hinv, Subgroup.map_id] at hBA'
  have heq := hA.2 _ hB' hBA'
  have heq' := congrArg (fun C : Subgroup G => C.map (MulAut.conj g).toMonoidHom) heq
  have hright := hinv g⁻¹
  simp only [inv_inv] at hright
  simpa only [Subgroup.map_map, hright, Subgroup.map_id] using heq'

/-- Equal-weight nontrivial subgroups of minimal best offenders are minimal. -/
theorem IsMinimalBestOffender.of_equalWeightLE {A B : Subgroup G}
    (hA : IsMinimalBestOffender ρ A) (hB : IsElementaryTwo B)
    (hBA : EqualWeightLE ρ B A) : IsMinimalBestOffender ρ B := by
  have hbest := hA.1.of_equalWeightLE ρ hB hBA
  have heq := hA.2 B hbest hBA
  simpa only [heq] using hA

/-- The best offenders form a stable family whenever the module is FF. -/
theorem isStable_bestOffenders [Finite G] [FiniteDimensional (ZMod 2) V]
    (h : IsFFModule ρ) : IsStable ρ {A | IsBestOffender ρ A} := by
  obtain ⟨A, hA⟩ := (isFFModule_iff_exists_bestOffender ρ).mp h
  exact ⟨⟨A, hA⟩, fun _ hB => hB, fun _ hB g => hB.map_conj ρ g,
    fun _ hB _ hC hCB => hB.of_equalWeightLE ρ hC hCB⟩

/-- B.1.7: minimal best offenders form a stable family for an FF-module. -/
theorem isStable_minimalBestOffenders [Finite G] [FiniteDimensional (ZMod 2) V]
    (h : IsFFModule ρ) : IsStable ρ {A | IsMinimalBestOffender ρ A} := by
  obtain ⟨A, hA⟩ := (isFFModule_iff_exists_bestOffender ρ).mp h
  obtain ⟨B, hB, _⟩ := hA.exists_minimal ρ
  exact ⟨⟨B, hB⟩, fun _ hC => hC.1, fun _ hC g => hC.map_conj ρ g,
    fun _ hC _ hD hDC => hC.of_equalWeightLE ρ hD hDC⟩

/-- A conjugation-invariant family generates a normal subgroup. -/
theorem generatedBy_normal_of_conj (P : Set (Subgroup G))
    (hP : ∀ A ∈ P, ∀ g : G, A.map (MulAut.conj g).toMonoidHom ∈ P) :
    (generatedBy P ⊤).Normal := by
  refine ⟨fun n hn g => ?_⟩
  have hle : (generatedBy P ⊤).map (MulAut.conj g).toMonoidHom ≤ generatedBy P ⊤ := by
    unfold generatedBy
    simp only [Subgroup.map_iSup]
    refine iSup_le fun A => iSup_le fun hA => ?_
    exact le_iSup_of_le (A.map (MulAut.conj g).toMonoidHom)
      (le_iSup_of_le ⟨hP A hA.1 g, le_top⟩ le_rfl)
  exact hle (Subgroup.mem_map_of_mem _ hn)

/-- In particular, a stable family generates a normal subgroup. -/
theorem IsStable.generatedBy_normal {P : Set (Subgroup G)} (hP : IsStable ρ P) :
    (generatedBy P ⊤).Normal :=
  generatedBy_normal_of_conj P hP.2.2.1

/-- The subgroup generated by all best offenders is normal, even when empty. -/
theorem offenderSubgroup_normal : (offenderSubgroup ρ).Normal :=
  generatedBy_normal_of_conj _ (fun _ hA g => hA.map_conj ρ g)

end Representation.BinaryOffender
