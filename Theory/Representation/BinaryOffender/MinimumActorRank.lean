module

public import Theory.Representation.BinaryOffender.Basic
public import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic

/-!
# Involution displacement bounds the rank of small-ratio actors

If every involution moves at least three dimensions, an elementary actor
with action ratio at most two has rank at least two. Indeed a rank-one
actor is the cyclic group generated by an involution, so its action ratio
is exactly that involution's fixed codimension.

Source application: the minimum-rank hypothesis in Aschbacher–Smith,
Proposition 8.2.2(1), printed p.715, using H.14.4 (combined manuscript,
1 March 2004). Quadraticity is not needed for this implication.
-/

public section
namespace Representation.BinaryOffender
open Subgroup
variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]

/-- Involution displacement at least three excludes rank-one actors of
ratio at most two, including all minimizers when the quadratic ratio is two. -/
theorem rank_ge_two_of_involution_displacement
    (ρ : Representation (ZMod 2) G V)
    (hm : ∀ t : G, orderOf t = 2 → 3 ≤ fixedCodim ρ (zpowers t))
    (A : Subgroup G) (hA : IsElementaryTwo A) (hr : actionRatio ρ A ≤ 2) :
    2 ≤ rank A := by
  by_contra! hsmall
  have hrank : rank A = 1 := by have := hA.rank_pos; omega
  have hc : Nat.card A = 2 := by
    simpa only [hrank, pow_one] using hA.card_eq_two_pow_rank
  let _ : IsCyclic A := isCyclic_of_prime_card hc
  obtain ⟨t, ht⟩ := A.isCyclic_iff_exists_zpowers_eq_top.mp inferInstance
  have ho : orderOf t = 2 := by rw [← Nat.card_zpowers, ht, hc]
  have hb := hm t ho
  rw [ht] at hb
  have hu : fixedCodim ρ A ≤ 2 := by
    simpa only [actionRatio, hrank, Nat.cast_one, div_one, Nat.cast_le_ofNat] using hr
  omega

end Representation.BinaryOffender
