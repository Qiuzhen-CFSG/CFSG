module
public import Theory.Representation.BinaryOffender.AlternatingSixCentralCover
public import Theory.Representation.BinaryOffender.IrreducibleCentralSeed
public import Theory.LinearAlgebra.RegularLinearAction

/-!
# The central cover under the full support stabilizer

For a normal component K, its fixed vectors in an invariant support I
are stable under the full stabilizer of I. If their binary dimension is
at most one, that stabilizer fixes them pointwise. The literal projection
I → I/C_I(K) is therefore a central cover for the full stabilizer whenever
I is generated by K-commutators. No splitting of the cover is used.

This supplies the ambient action required by Aschbacher--Smith I.2.3
in the five-dimensional alternative of 14.6.22, printed pp.413 and1038.
-/

public noncomputable section
open Subgroup Representation.OneCohomology
namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V) (K : Subgroup G) [K.Normal]
  (I : Submodule (ZMod 2) V)

@[expose] def stabilizerCentralKernel : Subrepresentation (stabilizerRepresentation ρ I) where
  toSubmodule := (fixedSpace ρ K).comap I.subtype
  apply_mem_toSubmodule g v hv :=
    (fixedSpace_stable_of_normalizes ρ (show (⊤ : Subgroup G) ≤ normalizer (K : Set G)
      from le_normalizer_of_normal) (mem_top g.val) v.val).2 hv

@[expose] def stabilizerCentralAction :
    Representation (ZMod 2) (subspaceStabilizer ρ I) (centralQuotient ρ K I) :=
  (stabilizerCentralKernel ρ K I).quotientRepresentation

@[expose] def stabilizerCentralProjection :
    (stabilizerRepresentation ρ I).IntertwiningMap (stabilizerCentralAction ρ K I) :=
  ((fixedSpace ρ K).comap I.subtype).mkQ.intertwiningMap_of_isIntertwiningMap _ _
    (fun _ _ => rfl)

theorem stabilizerCentralAction_component
    (hI : K ≤ subspaceStabilizer ρ I) (k : K) (v : centralQuotient ρ K I) :
    stabilizerCentralAction ρ K I ⟨k,hI k.property⟩ v =
      centralQuotientRepresentation ρ K I hI k v := rfl

variable [FiniteDimensional (ZMod 2) V]

theorem stabilizerCentralProjection_isCover (hI : IsIrrPlus ρ K I)
    (hd : Module.finrank (ZMod 2) ((fixedSpace ρ K).comap I.subtype) ≤ 1) :
    IsCover (stabilizerCentralProjection ρ K I) := by
  refine ⟨Submodule.mkQ_surjective _, ?_, ?_⟩
  · intro v hv g
    have hv' : v ∈ stabilizerCentralKernel ρ K I :=
      (Submodule.Quotient.mk_eq_zero _).mp hv
    let C := stabilizerCentralKernel ρ K I
    let f := LinearMap.GeneralLinearGroup.toLinearEquiv (C.toRepresentation.asGroupHom g)
    have hf : f = 1 := LinearGroup.eq_one_of_binary_finrank_le_one hd f
    exact congrArg Subtype.val (LinearEquiv.congr_fun hf (⟨v,hv'⟩ : C.toSubmodule))
  · let τ := stabilizerRepresentation ρ I
    have hm : I ≤ (Coinvariants.ker τ).map I.subtype := by
      conv_lhs => rw [← hI.choose_spec.1]
      apply Submodule.span_le.mpr
      rintro _ ⟨g,hg,v,hv,rfl⟩
      exact ⟨τ ⟨g,hI.choose hg⟩ ⟨v,hv⟩ - ⟨v,hv⟩,
        Coinvariants.sub_mem_ker _ _, rfl⟩
    apply top_unique
    intro v _
    obtain ⟨w,hw,heq⟩ := hm v.property
    rwa [show w = v from Subtype.ext heq] at hw

end Representation.BinaryOffender
