module

public import Theory.Representation.BinaryOffender.MarkedCentralQuotient

/-!
# Faithful quotients of modules generated by a normal layer

A faithful action remains faithful after quotienting by the normal layer's
fixed space when that layer generates the whole module and acts faithfully
on the quotient. An equivariant surjection transports the quotient action
onto a specified target module.

The result connects fixed-quotient faithfulness to the literal natural cover
used in Aschbacher–Smith 13.7.21, printed p.945.
-/

public section
open Subgroup Representation

namespace Representation.BinaryOffender
variable {H V W : Type*} [Group H]
  [AddCommGroup V] [Module (ZMod 2) V] [AddCommGroup W] [Module (ZMod 2) W]

theorem exists_faithful_action_of_generated_layer_quotient
    (α : Representation (ZMod 2) H V) (hα : Function.Injective α)
    (L : Subgroup H) [L.Normal]
    (τ : Representation (ZMod 2) L W) (hτ : Function.Injective τ)
    (f : V →ₗ[ZMod 2] W) (hf : Function.Surjective f)
    (hk : f.ker = fixedSpace α L)
    (he : ∀ (g : L) v, f (α (g : H) v) = τ g (f v))
    (hwhole : subspaceCommutator α ⊤ L = ⊤) :
    ∃ ρ : Representation (ZMod 2) H W, Function.Injective ρ ∧
      (∀ g v, f (α g v) = ρ g (f v)) ∧
      ∀ (g : L) v, ρ (g : H) v = τ g v := by
  have hstable (g : H) : f.ker ≤ f.ker.comap (α g) := by
    rw [hk]
    exact fun v hv => (fixedSpace_stable_of_normalizes α
      (le_normalizer_of_normal : (⊤ : Subgroup H) ≤ normalizer (L : Set H))
      (mem_top g) v).mpr hv
  let e := f.quotKerEquivOfSurjective hf
  let ρ : Representation (ZMod 2) H W :=
    e.conjRingEquiv.toMonoidHom.comp (α.quotient f.ker hstable)
  have hρ (g : H) (v : V) : ρ g (f v) = f (α g v) := by
    simp [ρ,e,LinearEquiv.conjRingEquiv,Representation.quotient,Submodule.mapQ_apply]
  have hres (g : L) (v : W) : ρ (g : H) v = τ g v := by
    obtain ⟨v,rfl⟩ := hf v
    exact (hρ g v).trans (he g v)
  have hqL : Function.Injective ((fixedQuotient α L).comp L.subtype) := by
    apply (MonoidHom.ker_eq_bot_iff _).mp
    apply bot_unique
    intro g hg
    change g = 1
    apply hτ
    apply LinearMap.ext
    intro w
    obtain ⟨v,rfl⟩ := hf w
    rw [map_one, Module.End.one_apply, ← he g v]
    have hv := (quotient_kernel_iff α L g).mp hg v
    rw [← hk, LinearMap.mem_ker, map_sub, sub_eq_zero] at hv
    exact hv
  have hq := fixedQuotient_faithful α L hα hqL hwhole
  refine ⟨ρ,?_,fun g v => (hρ g v).symm,hres⟩
  apply (MonoidHom.ker_eq_bot_iff _).mp
  apply bot_unique
  intro g hg
  change g = 1
  apply hq
  rw [map_one]
  apply (quotient_kernel_iff α L g).mpr
  intro v
  rw [← hk, LinearMap.mem_ker, map_sub, sub_eq_zero]
  rw [← hρ, show ρ g = 1 from hg, Module.End.one_apply]

end Representation.BinaryOffender

