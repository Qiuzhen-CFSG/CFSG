module
public import Theory.Representation.NormalClosureDisplacement
public import Theory.Representation.BinaryOffender.IrreducibleTransport
public import Theory.Representation.BinaryOffender.MovedSpaceTransport
public import Theory.PGroupCore
/-!
# Generation inside the actual rank-one displacement orbit

For a faithful binary action with trivial two-core, a nonidentity rank-one
actor cannot fix the orbit of its own displacement pointwise: its normal
closure would then have exponent two and lie in the two-core. Its restricted
displacement is therefore the original line. This proves that the literal
orbit submodule is generated by its own restricted displacement, and retains
rank one there. It does not assert that the orbit is the whole original module.

Source application: Aschbacher–Smith G.6.1–4 and10.2.1, pp.345–346 and743.
-/

public section
open Subgroup
namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

theorem rank_one_generated_restriction
    (hρ : Function.Injective ρ) (hcore : pCore 2 G=⊥) (a : G) (ha : a≠1)
    (hr : Module.finrank (ZMod 2) (LinearMap.range (ρ a-LinearMap.id))=1) :
    ∃ S : Subrepresentation ρ,
      S.toSubmodule=conjugateDisplacementSpan ρ a ⊤ ∧
      conjugateDisplacementSpan S.toRepresentation a ⊤=⊤ ∧
      Module.finrank (ZMod 2) (LinearMap.range (S.toRepresentation a-LinearMap.id))=1 := by
  let K := normalClosure ({a} : Set G)
  let M := conjugateDisplacementSpan ρ a ⊤
  have hm : subspaceCommutator ρ ⊤ K=M := by
    change subspaceCommutator ρ ⊤ (normalClosure ({a} : Set G))=M
    rw [←conjugateSpanBy_zpowers_top,commutator_conjugateSpanBy_zpowers]
  have hstable : (⊤ : Subgroup G) ≤ subspaceStabilizer ρ M := by
    rw [←hm]
    apply subspaceCommutator_invariant_normalizer ρ (le_subspaceStabilizer ρ ⊤ (by simp))
    exact le_normalizer_of_normal
  let S : Subrepresentation ρ := ⟨M,fun g v hv => (hstable (mem_top g) v).2 hv⟩
  have hmove : M.map (ρ a-LinearMap.id)≠⊥ := by
    intro hz
    have hfixa : ∀ v∈M, ρ a v=v := by
      intro v hv
      have hh : ρ a v-v ∈ M.map (ρ a-LinearMap.id) := ⟨v,hv,rfl⟩
      exact sub_eq_zero.mp (by simpa only [hz,Submodule.mem_bot] using hh)
    have hfixK : ∀ k∈K, ∀ v∈M, ρ k v=v := by
      have hh := fixedSpace_conjugateSpanBy ρ a ⊤ M hstable hfixa
      rw [conjugateSpanBy_zpowers_top] at hh
      exact fun k hk v hv => (subspaceCommutator_eq_bot_iff ρ M K).mp hh hv ⟨k,hk⟩
    have htwo : IsPGroup 2 K := by
      intro k
      refine ⟨1,?_⟩
      apply Subtype.ext
      change (k:G)^2=1
      apply hρ
      apply LinearMap.ext
      intro v
      have hd : ρ k v-v∈M := hm ▸ Submodule.subset_span ⟨k,k.property,v,Submodule.mem_top,rfl⟩
      have hh := hfixK k k.property _ hd
      rw [map_sub] at hh
      have he : ρ k (ρ k v)=v := by
        have hadd := sub_eq_sub_iff_add_eq_add.mp hh
        have hzero : ρ k (ρ k v)+v=0 := by simpa only [ZModModule.add_self] using hadd
        calc
          ρ k (ρ k v) = (ρ k (ρ k v)+v)+v := by rw [add_assoc,ZModModule.add_self,add_zero]
          _ = v := by rw [hzero,zero_add]
      simpa only [pow_two,map_mul,map_one,Module.End.mul_apply,Module.End.one_apply] using he
    have hkbot : K=⊥ := le_bot_iff.mp (hcore ▸ le_sSup ⟨inferInstance,htwo⟩)
    exact ha (mem_bot.mp (hkbot ▸ subset_normalClosure (Set.mem_singleton a)))
  have hle : M.map (ρ a-LinearMap.id) ≤ LinearMap.range (ρ a-LinearMap.id) := by
    rintro _ ⟨v,_,rfl⟩
    exact LinearMap.mem_range_self _ v
  have heq : M.map (ρ a-LinearMap.id)=LinearMap.range (ρ a-LinearMap.id) := by
    apply Submodule.eq_of_le_of_finrank_eq hle
    have hupper := Submodule.finrank_mono hle
    have hpos : 0<Module.finrank (ZMod 2) (M.map (ρ a-LinearMap.id)) :=
      Nat.pos_of_ne_zero (fun hz => hmove (Submodule.finrank_eq_zero.mp hz))
    omega
  have hdisp : (LinearMap.range (S.toRepresentation a-LinearMap.id)).map M.subtype=
      LinearMap.range (ρ a-LinearMap.id) := by
    rw [←heq]
    ext v
    constructor
    · rintro ⟨y,⟨x,rfl⟩,rfl⟩
      exact ⟨x,x.property,rfl⟩
    · rintro ⟨x,hx,rfl⟩
      exact ⟨(S.toRepresentation a-(LinearMap.id : S.toSubmodule →ₗ[ZMod 2] S.toSubmodule)) ⟨x,hx⟩,⟨⟨x,hx⟩,rfl⟩,rfl⟩
  have hdim : Module.finrank (ZMod 2) (LinearMap.range (S.toRepresentation a-LinearMap.id))=1 := by
    rw [←hr,←hdisp]
    exact (Submodule.finrank_map_subtype_eq M _).symm
  have hgen : conjugateDisplacementSpan S.toRepresentation a ⊤=⊤ := by
    apply top_unique
    intro x _
    have hupper : M ≤ (conjugateDisplacementSpan S.toRepresentation a ⊤).map M.subtype := by
      apply Submodule.span_le.mpr
      rintro v ⟨g,_,w,rfl⟩
      have hw : ρ a w-w∈(LinearMap.range (S.toRepresentation a-LinearMap.id)).map M.subtype := by
        rw [hdisp]
        exact LinearMap.mem_range_self _ w
      obtain ⟨z,⟨y,rfl⟩,hy⟩ := hw
      refine ⟨S.toRepresentation g (S.toRepresentation a y-y),?_,?_⟩
      · exact Submodule.subset_span ⟨g,mem_top _,y,rfl⟩
      · change ρ g (ρ a (y:V)-(y:V))=ρ g (ρ a w-w)
        exact congrArg (ρ g) hy
    obtain ⟨y,hy,he⟩ := hupper x.property
    exact (Subtype.ext he : y=x) ▸ hy
  exact ⟨S,rfl,hgen,hdim⟩
end Representation.BinaryOffender
