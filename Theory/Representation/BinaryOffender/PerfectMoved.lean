module
public import Theory.Representation.BinaryOffender.IrreducibleExistence
public import Theory.Representation.BinaryOffender.MovedSpaceTransport
public import Theory.Representation.BinaryOffender.IrreducibleMovedGeneration
/-!
# Perfect actors generate their displacement spaces

For a perfect actor A, the quotient by [[V,A],A] has central A-displacements.
Its image is therefore abelian and trivial, proving [[V,A],A]=[V,A]. Any
subspace containing [V,A] consequently has the same A-displacement space.
No finite-dimensionality, ambient normality or semisimplicity is required.

Source application: the actual moved natural section in Aschbacher–Smith
B.5.6(3c) and B.6.9, printed pp.105 and 116.
-/

public section
open Subgroup
namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

/-- The moved module of a perfect actor is generated by its own displacements. -/
theorem subspaceCommutator_idempotent_of_perfect (A : Subgroup G) [Group.IsPerfect A] :
    subspaceCommutator ρ (subspaceCommutator ρ ⊤ A) A = subspaceCommutator ρ ⊤ A := by
  let W := subspaceCommutator ρ ⊤ A
  let D := subspaceCommutator ρ W A
  have hDstab := subspaceCommutator_invariant ρ W A
  let Drep : Subrepresentation (ρ.comp A.subtype) :=
    ⟨D,fun a v hv => (hDstab a.property v).2 hv⟩
  let σ := Drep.quotientRepresentation
  have hcentral : subspaceCommutator σ ⊤ (⊤ : Subgroup A) ≤ fixedSpace σ ⊤ := by
    apply Submodule.span_le.mpr
    rintro _ ⟨a,_,v,_,rfl⟩ b
    induction v using Submodule.Quotient.induction_on with
    | _ v =>
      change σ b (σ a (Drep.toSubmodule.mkQ v) - Drep.toSubmodule.mkQ v) =
        σ a (Drep.toSubmodule.mkQ v) - Drep.toSubmodule.mkQ v
      rw [map_sub, Subrepresentation.quotientRepresentation_mk,
        Subrepresentation.quotientRepresentation_mk]
      apply (Submodule.Quotient.eq D).mpr
      exact Submodule.subset_span ⟨b.val,b.val.property,ρ a.val v - v,
        Submodule.subset_span ⟨a.val,a.property,v,Submodule.mem_top,rfl⟩,by
          simp only [map_sub, ← Module.End.mul_apply]
          rfl⟩
  have hfixed := le_fixedSpace_of_commutator_le_fixedSpace σ (⊤ : Subgroup A) ⊤
    (le_subspaceStabilizer σ ⊤ (by intros; trivial)) hcentral
  apply le_antisymm (subspaceCommutator_mono_left ρ le_top A)
  apply Submodule.span_le.mpr
  rintro _ ⟨a,ha,v,_,rfl⟩
  exact (Submodule.Quotient.eq D).mp (hfixed
    (show Drep.toSubmodule.mkQ v ∈ (⊤ : Submodule (ZMod 2) (V ⧸ D)) from Submodule.mem_top)
    ⟨⟨a,ha⟩,by trivial⟩)

/-- A subspace containing all displacements has the same moved module. -/
theorem subspaceCommutator_eq_moved_of_contains_moved
    (A : Subgroup G) [Group.IsPerfect A] (U : Submodule (ZMod 2) V)
    (hU : subspaceCommutator ρ ⊤ A ≤ U) :
    subspaceCommutator ρ U A = subspaceCommutator ρ ⊤ A := by
  refine le_antisymm (subspaceCommutator_mono_left ρ le_top A) ?_
  rw [← subspaceCommutator_idempotent_of_perfect ρ A]
  exact subspaceCommutator_mono_left ρ hU A
end Representation.BinaryOffender
