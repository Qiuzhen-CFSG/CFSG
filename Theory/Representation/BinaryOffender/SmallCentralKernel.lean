module
public import Theory.Representation.BinaryOffender.PerfectCentralizerDisplacement
public import Theory.GroupTheory.PGroup.AbelianOmegaFrattini
public import Theory.GroupTheory.PrimeRankElementary
public import Theory.ElementaryAbelian.Injective

/-!
# Offender exclusion in a small abelian centralizing subgroup

Let a perfect subgroup act without fixed vectors on a faithful binary module.
An abelian two-subgroup centralizing that perfect subgroup and generated by at
most two elements contains no offender. Its elementary subgroups have order
at most four: first omega and the Frattini quotient have the same order.
A nontrivial centralizing actor, however, moves at least three dimensions.

The application is to the full exceptional covering kernel on the central
omega of an original linear-three MS core, without discarding that kernel.
Source: the elementary Frattini and perfect-displacement arguments, in the
setting of Aschbacher--Smith C.1.34, pp.136--137, and I.1.3(6), p.407.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender
open scoped IsMulCommutative

namespace Representation.BinaryOffender.SmallCentralKernel

/-- Elementary subgroups of an abelian two-group on at most two generators
have order at most four. -/
theorem elementary_card_le {H : Type*} [Group H] [Finite H]
    [IsMulCommutative H] (hp : IsPGroup 2 H) (hr : Group.rank H ≤ 2)
    (A : Subgroup H) [IsElementaryAbelian 2 A] : Nat.card A ≤ 4 := by
  let : Fact (IsPGroup 2 H) := ⟨hp⟩
  let : IsElementaryAbelian 2 (H ⧸ frattini H) :=
    isElementaryAbelian_quotient_frattini (p := 2)
  let : CommGroup (H ⧸ frattini H) := IsMulCommutative.instCommGroup
  have hcard : Nat.card (H ⧸ frattini H) ≤ 4 := by
    have hh := card_dvd_exponent_pow_rank' (H ⧸ frattini H)
      (Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
        (IsElementaryAbelian.exponent_dvd_p 2 (H ⧸ frattini H)))
    have hd : Group.rank (H ⧸ frattini H) ≤ 2 :=
      (Group.rank_le_of_surjective (QuotientGroup.mk' (frattini H))
        (QuotientGroup.mk'_surjective _)).trans hr
    exact (Nat.le_of_dvd (by positivity) hh).trans
      (show 2 ^ Group.rank (H ⧸ frattini H) ≤ 4 from
        (pow_le_pow_right' (by decide : 1 ≤ (2 : ℕ)) hd))
  rw [hp.card_frattini_quotient_eq_card_omega_one] at hcard
  have hA : A ≤ omega₁ H (p := 2) := by
    intro a ha
    exact subset_closure (by
      simpa using elemPow_eq_one_of_isElementaryAbelian a ha (p := 2))
  exact (Nat.card_le_card_of_injective (inclusion hA) (inclusion_injective hA)).trans hcard

/-- A small abelian subgroup centralizing a fixed-free perfect factor
contains no offender in the original faithful representation. -/
theorem not_isOffender {H V : Type*} [Group H] [Finite H]
    [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (rho : Representation (ZMod 2) H V) (S : Subgroup H) [Group.IsPerfect S]
    (hf : Function.Injective rho) (hfix : fixedSpace rho S = ⊥)
    (C : Subgroup H) [IsMulCommutative C] (hc : ⁅S,C⁆ = ⊥) (hp : IsPGroup 2 C)
    (hr : Group.rank C ≤ 2) (A : Subgroup H) (hAC : A ≤ C) :
    ¬ IsOffender rho A := by
  intro hA
  let : IsElementaryAbelian 2 A := hA.1.2
  let e := subgroupOfEquivOfLe hAC
  let : IsElementaryAbelian 2 (A.subgroupOf C) :=
    IsElementaryAbelian.of_injective e.toMonoidHom e.injective
  have hcard : Nat.card A ≤ 4 := by
    rw [← Nat.card_congr e.toEquiv]
    exact elementary_card_le hp hr (A.subgroupOf C)
  have hrA : rank A ≤ 2 := by
    unfold rank
    exact (Nat.log_mono_right hcard).trans (by decide : Nat.log 2 4 ≤ 2)
  have hnon : ¬ A ≤ rho.ker := by
    rw [(MonoidHom.ker_eq_bot_iff rho).mpr hf]
    exact fun hh => hA.1.1 (bot_unique hh)
  have hcomm : ⁅S,A⁆ = ⊥ :=
    bot_unique ((commutator_mono le_rfl hAC).trans_eq hc)
  have hd := three_le_fixedCodim_of_perfect_fixedSpace_eq_bot rho S A
    hfix hnon hcomm
  have hh := hA.2
  omega

end Representation.BinaryOffender.SmallCentralKernel
