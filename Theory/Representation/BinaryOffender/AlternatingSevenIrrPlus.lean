module
public import Theory.Representation.BinaryPrimeDisplacement
public import Theory.Representation.BinaryOffender.SectionLinear
public import Theory.Representation.BinaryOffender.IrreducibleMovedTransport
/-!
# Irr⁺ from a small faithful A₇ section

A faithful simple A₇ actor has an order-five element. If its fixed
codimension on the ambient binary space is below eight, every noncentral
invariant subspace already has faithful order-five displacement at least four;
the quotient cannot also move, by the fixed-codimension section inequality.
Thus full commutator generation implies the Irr⁺ condition without assuming a
split central cover or choosing a composition series.
Source: Aschbacher–Smith C.5.13, p.163, using B.4.7 and A.1.40.
-/
public section
open Subgroup
namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [Finite G] [IsSimpleGroup G]
  [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
omit [Finite G] [IsSimpleGroup G] in
/-- The displacement of one actor is bounded by any subspace containing its
literal commutator space. -/
theorem fixedCodim_zpowers_le_finrank_of_subspaceCommutator_le
    (ρ : Representation (ZMod 2) G V) (a : G) (W : Submodule (ZMod 2) V)
    (hW : subspaceCommutator ρ ⊤ (zpowers a) ≤ W) :
    fixedCodim ρ (zpowers a) ≤ Module.finrank (ZMod 2) W := by
  rw [fixedCodim_zpowers_eq_displacement_rank]
  apply (Submodule.finrank_mono ?_)
  rintro _ ⟨v, rfl⟩
  apply hW
  apply Submodule.subset_span
  exact ⟨a, mem_zpowers a, v, Submodule.mem_top, rfl⟩

/-- A small faithful binary representation of a simple A₇-type actor is an
irreducible section once it is generated by commutators. -/
theorem isIrrPlus_top_of_five_displacement
    (ρ : Representation (ZMod 2) G V) (hf : Function.Injective ρ)
    (hm : subspaceCommutator ρ ⊤ ⊤ = ⊤)
    (a : G) (ha : orderOf a = 5) (hd : fixedCodim ρ (zpowers a) < 8) :
    IsIrrPlus ρ ⊤ ⊤ := by
  apply isIrrPlus_of_minimal ρ (by
    apply le_subspaceStabilizer
    intro g hg v hv
    trivial) hm
  · intro hfix
    have he : ρ a = ρ 1 := by
      rw [map_one]
      ext v
      exact hfix (Submodule.mem_top : v ∈ (⊤ : Submodule (ZMod 2) V)) ⟨a,mem_top a⟩
    have hao := hf he
    rw [hao,orderOf_one] at ha
    norm_num at ha
  · intro J hJ _
    by_cases hj : J ≤ fixedSpace ρ ⊤
    · exact Or.inr hj
    left
    let W : Subrepresentation ρ := ⟨J,fun g v hv => (hJ (mem_top g) v).2 hv⟩
    have hwfaith : Function.Injective W.toRepresentation := by
      rcases W.toRepresentation.normal_ker.eq_bot_or_eq_top with he | he
      · exact W.toRepresentation.ker_eq_bot_iff.mp he
      · have hh : W.toRepresentation = 1 := MonoidHom.ker_eq_top_iff.mp he
        apply False.elim
        apply hj
        intro v hv g
        have hv' := DFunLike.congr_fun (congrArg (fun σ => σ g.val) hh) ⟨v,hv⟩
        exact congrArg Subtype.val hv'
    have hw : 4 ≤ fixedCodim W.toRepresentation (zpowers a) := by
      simpa only [BinaryPrimeDegree.orderOf_two_mod_five] using
        prime_order_le_fixedCodim W.toRepresentation hwfaith (by decide : Nat.Prime 5)
          (by decide : 5 ≠ 2) a ha
    have hbound := fixedCodim_quotient_add_subrepresentation_le ρ W (zpowers a)
    have hq : W.quotientRepresentation = 1 := by
      rcases W.quotientRepresentation.normal_ker.eq_bot_or_eq_top with he | he
      · have hfaith := W.quotientRepresentation.ker_eq_bot_iff.mp he
        have hb := prime_order_le_fixedCodim W.quotientRepresentation hfaith
          (by decide : Nat.Prime 5) (by decide : 5 ≠ 2) a ha
        rw [BinaryPrimeDegree.orderOf_two_mod_five] at hb
        omega
      · exact MonoidHom.ker_eq_top_iff.mp he
    have hle : subspaceCommutator ρ ⊤ ⊤ ≤ J := by
      apply Submodule.span_le.mpr
      rintro _ ⟨g,hg,v,hv,rfl⟩
      have hqv := DFunLike.congr_fun (congrArg (fun σ => σ g) hq) (J.mkQ v)
      have hz : J.mkQ (ρ g v - v) = 0 := by
        rw [map_sub]
        change W.quotientRepresentation g (J.mkQ v) - J.mkQ v = 0
        rw [hqv]
        exact sub_self _
      exact (Submodule.Quotient.mk_eq_zero _).mp hz
    rw [hm] at hle
    exact top_unique hle
end Representation.BinaryOffender
