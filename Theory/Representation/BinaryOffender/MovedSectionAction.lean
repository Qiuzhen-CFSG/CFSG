module
public import Theory.Representation.BinaryOffender.GeneratedLayerQuotient
public import Theory.Representation.BinaryOffender.TwoNoncentralLayers
public import Theory.Representation.BinaryOffender.PerfectMoved

/-!
# Faithful ambient actions on a marked moved section

A faithful quotient generated by a perfect normal layer makes the original
moved submodule faithful. The moved submodule is itself generated by that
layer. Its natural central quotient therefore inherits a faithful action of
the entire ambient group, retaining the supplied layer action.

The original 13.7.19 application uses the raw component section and the
faithful whole plus quotient; no assertion that the raw module is generated
by the component is needed.
Source: Aschbacher–Smith, 13.7.16(3) and 13.7.19, printed pp.944–945.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender
namespace Representation.BinaryOffender
variable {H V W E : Type*} [Group H]
  [AddCommGroup V] [Module (ZMod 2) V]
  [AddCommGroup W] [Module (ZMod 2) W]
  [AddCommGroup E] [Module (ZMod 2) E]

/-- A marked central section of the moved module carries the full faithful action. -/
theorem exists_faithful_action_of_moved_section
    (ρ : Representation (ZMod 2) H V) (σ : Representation (ZMod 2) H W)
    (K : Subgroup H) [K.Normal] [Group.IsPerfect K]
    (f : V →ₗ[ZMod 2] W) (hf : Function.Surjective f)
    (hfe : ∀ g v, f (ρ g v) = σ g (f v))
    (hσ : Function.Injective σ) (hwhole : subspaceCommutator σ ⊤ K = ⊤)
    (τ : Representation (ZMod 2) K E) (hτ : Function.Injective τ)
    (e : (subspaceCommutator ρ ⊤ K ⧸
      (fixedSpace ρ K).comap (subspaceCommutator ρ ⊤ K).subtype) ≃ₗ[ZMod 2] E)
    (he : ∀ (k : K) (v : subspaceCommutator ρ ⊤ K),
      e (Submodule.Quotient.mk ⟨ρ k v,
        ((subspaceCommutator_invariant ρ ⊤ K) k.property v).2 v.property⟩) =
      τ k (e (Submodule.Quotient.mk v))) :
    ∃ γ : Representation (ZMod 2) H E, Function.Injective γ ∧
      ∀ (k : K) v, γ k v = τ k v := by
  let I := subspaceCommutator ρ ⊤ K
  have hI : (⊤ : Subgroup H) ≤ subspaceStabilizer ρ I :=
    subspaceCommutator_invariant_normalizer ρ
      (le_subspaceStabilizer ρ ⊤ (by intros; trivial)) le_normalizer_of_normal
  let S : Subrepresentation ρ := ⟨I,fun g v hv => (hI (mem_top g) v).2 hv⟩
  let α := S.toRepresentation
  have hα : Function.Injective α := by
    apply (MonoidHom.ker_eq_bot_iff α).mp
    apply bot_unique
    intro g hg
    exact eq_one_of_fixes_moved_of_faithful_quotient ρ σ K f hf hfe hσ hwhole g
      (fun v hv => congrArg Subtype.val (LinearMap.congr_fun hg ⟨v,hv⟩))
  have hgen : subspaceCommutator α ⊤ K = ⊤ := by
    apply Submodule.map_injective_of_injective I.subtype_injective
    have hm := subspaceCommutator_map_embedding ρ α (MonoidHom.id H) I.subtype
      (fun _ _ => rfl) K ⊤
    simp only [Submodule.map_top,Submodule.range_subtype,Subgroup.map_id] at hm
    simpa only [Submodule.map_top,Submodule.range_subtype] using
      hm.symm.trans (subspaceCommutator_idempotent_of_perfect ρ K)
  let F := (fixedSpace ρ K).comap I.subtype
  let p : I →ₗ[ZMod 2] E := e.toLinearMap.comp F.mkQ
  have hp : Function.Surjective p := e.surjective.comp F.mkQ_surjective
  have hpk : p.ker = fixedSpace α K := by
    ext v
    change e (Submodule.Quotient.mk v) = 0 ↔ ∀ k : K, α k v = v
    rw [←e.map_zero,e.injective.eq_iff,Submodule.Quotient.mk_eq_zero]
    constructor
    · intro hv k
      exact Subtype.ext (hv k)
    · intro hv k
      exact congrArg Subtype.val (hv k)
  obtain ⟨γ,hγ,_,hres⟩ := exists_faithful_action_of_generated_layer_quotient
    α hα K τ hτ p hp hpk (fun k v => he k v) hgen
  exact ⟨γ,hγ,hres⟩

end Representation.BinaryOffender
