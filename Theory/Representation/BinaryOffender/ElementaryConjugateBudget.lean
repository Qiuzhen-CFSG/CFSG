module

public import Theory.Representation.BinaryOffender.PermutationConjugacy
public import Theory.Representation.BinaryOffender.CubicRatio
public import Theory.Representation.FixedSpaceCodimension
public import Theory.Representation.CentralizerField
public import Theory.Representation.BinaryIrreducibleCentralizer
public import Theory.GroupAction.PerfectCentralQuotient
public import Theory.GroupTheory.SolvableOuterQuotient

/-!
# Elementary actors generated by inner conjugates

A budget `b` means that each nontrivial elementary two-subgroup A of Aut(S)
has n inner conjugates generating over Inn(S), with n rank(A) ≤ b.
For a faithful binary action irreducible on a normal perfect central cover
of S, all these conjugators lift to the original group. The centralizer
kernel is cyclic by Schur's lemma; perfectness recovers the component from
its image. A cubic offender of ratio at most a then gives dim(V) ≤ a b.

This is the subgroup version of the fixed-space argument in GM02,
*Classification of 2F-modules I*, (2.5)--(2.6), manuscript p.4. The
motivation is the PSL₂(11) case of Proposition 4.1, pp.8--9, and
Aschbacher--Smith K.2, printed p.453. Concrete generation budgets remain
explicit inputs; this module does not classify any representation.
-/

@[expose] public section
namespace Representation.BinaryOffender
open Subgroup
open scoped IsMulCommutative commutatorElement

/-- The component is generated over by inner conjugates of each elementary
actor, with the number of conjugates times its binary rank bounded by b. -/
def ElementaryInnerConjugateBudget (S : Type*) [Group S] (b : ℕ) : Prop :=
  ∀ A : Subgroup (MulAut S), IsElementaryTwo A →
    ∃ (n : ℕ) (c : Fin n → S), n * rank A ≤ b ∧
      (MulAut.conj : S →* MulAut S).range ≤
        ⨆ i, A.map (MulAut.conj (MulAut.conj (c i))).toMonoidHom

variable {G V S : Type*} [Group G] [Group S]
  [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]

/-- The intersection of the fixed spaces of n conjugate subgroups bounds
degree by n times the original fixed codimension. -/
theorem finrank_le_mul_fixedCodim_of_subgroup_conjugates
    (ρ : Representation (ZMod 2) G V) (L A : Subgroup G)
    (hfix : fixedSpace ρ L = ⊥) {n : ℕ} (c : Fin n → G)
    (hgen : L ≤ ⨆ i, A.map (MulAut.conj (c i)).toMonoidHom) :
    Module.finrank (ZMod 2) V ≤ n * fixedCodim ρ A := by
  let X (i : Fin n) := A.map (MulAut.conj (c i)).toMonoidHom
  have hz : fixedSpace ρ (⨆ i, X i) = ⊥ := by
    apply le_bot_iff.mp
    rw [← hfix]
    exact ρ.invariants_comp_subtype_antitone hgen
  have he : fixedSpace ρ (⨆ i, X i) = ⨅ i, fixedSpace ρ (X i) :=
    ρ.invariants_comp_iSup X
  have hd := Submodule.finrank_quotient_iInf_le_sum (fun i => fixedSpace ρ (X i))
  rw [← he, hz, Submodule.finrank_quotient] at hd
  simp only [finrank_bot, Nat.sub_zero] at hd
  change Module.finrank (ZMod 2) V ≤ ∑ i, fixedCodim ρ (X i) at hd
  simpa only [X, fixedCodim_map_conj, Finset.sum_const, Finset.card_univ,
    Fintype.card_fin, nsmul_eq_mul, Nat.cast_id] using hd

private theorem lift_perfect_containment {D : Type*} [Group D]
    (f : G →* D) (L J : Subgroup G) [Group.IsPerfect L]
    [IsMulCommutative f.ker]
    (hc : f.ker ≤ centralizer (L : Set G))
    (h : L.map f ≤ J.map f) : L ≤ J := by
  rw [← commutator_eq_self (H := L)]
  apply commutator_le.mpr
  intro x hx y hy
  obtain ⟨a, ha, hfa⟩ := h (mem_map_of_mem f hx)
  obtain ⟨b, hb, hfb⟩ := h (mem_map_of_mem f hy)
  let k := a * x⁻¹
  let l := b * y⁻¹
  have hk : k ∈ f.ker := by
    simp only [k, MonoidHom.mem_ker, map_mul, map_inv, hfa, mul_inv_cancel]
  have hl : l ∈ f.ker := by
    simp only [l, MonoidHom.mem_ker, map_mul, map_inv, hfb, mul_inv_cancel]
  have hkx : Commute k x := (mem_centralizer_iff.mp (hc hk) x hx).symm
  have hky : Commute k y := (mem_centralizer_iff.mp (hc hk) y hy).symm
  have hlx : Commute l x := (mem_centralizer_iff.mp (hc hl) x hx).symm
  have hly : Commute l y := (mem_centralizer_iff.mp (hc hl) y hy).symm
  have hkl : Commute k l := congrArg Subtype.val (mul_comm (⟨k, hk⟩ : f.ker) ⟨l, hl⟩)
  have hkly := hkl.mul_right hky
  have hkcomm : Commute k ⁅x,l*y⁆ := by
    rw [commutatorElement_def]
    exact ((hkx.mul_right hkly).mul_right hkx.inv_right).mul_right hkly.inv_right
  have hlcomm : Commute l ⁅x,y⁆ := by
    rw [commutatorElement_def]
    exact ((hlx.mul_right hly).mul_right hlx.inv_right).mul_right hly.inv_right
  have he : ⁅k*x,l*y⁆ = ⁅x,y⁆ := by
    rw [commutatorElement_mul_left_eq_conj_mul, hkly.commutator_eq,
      mul_one, hkcomm.eq, mul_inv_cancel_right,
      commutatorElement_mul_right_eq_mul_conj, hlx.symm.commutator_eq,
      one_mul, hlcomm.eq, mul_inv_cancel_right]
  have hea : k*x = a := by simp [k]
  have heb : l*y = b := by simp [l]
  rw [hea, heb] at he
  rw [← he, commutatorElement_def]
  exact J.mul_mem (J.mul_mem (J.mul_mem ha hb) (J.inv_mem ha)) (J.inv_mem hb)

/-- Lift the actual inner conjugators through a perfect central cover.
The ambient group need not embed into the quotient's automorphism group:
only its elementary actor must do so, which follows from irreducibility. -/
theorem subgroup_conjugate_budget_of_central_cover
    (ρ : Representation (ZMod 2) G V) (L : Subgroup G) [L.Normal]
    [Group.IsPerfect L] (hf : Function.Injective ρ)
    (hi : IsIrreducible (ρ.comp L.subtype))
    (e : L ⧸ center L ≃* S) {b : ℕ} (hbudget : ElementaryInnerConjugateBudget S b)
    (A : Subgroup G) (hA : IsElementaryTwo A) :
    ∃ (n : ℕ) (c : Fin n → G), n * rank A ≤ b ∧
      L ≤ ⨆ i, A.map (MulAut.conj (c i)).toMonoidHom := by
  let := hi
  let : IsElementaryAbelian 2 A := hA.2
  let σ := ρ.comp L.subtype
  let q := MulAut.centralQuotientAction e
  have hq : Function.Injective q := MulAut.centralQuotientAction_injective e
  let f : G →* MulAut S := q.comp (MulAut.conjNormal (H := L))
  have hker (g : G) : g ∈ f.ker ↔ g ∈ centralizer (L : Set G) := by
    change q (MulAut.conjNormal g) = 1 ↔ _
    rw [← map_one q, hq.eq_iff]
    change g ∈ (MulAut.conjNormal (H := L)).ker ↔ _
    rw [MulAut.conjNormal_ker_eq_centralizer]
  let C := CentralizerField.linearCentralizer σ
  let : IsCyclic (IntertwiningMap σ σ)ˣ := CentralizerField.units_isCyclic σ
  let : IsCyclic C := isCyclic_of_injective (CentralizerField.centralizerUnitsEquiv σ).toMonoidHom
    (CentralizerField.centralizerUnitsEquiv σ).injective
  let j : f.ker →* C := (ρ.asGroupHom.comp f.ker.subtype).codRestrict C (by
    intro g
    apply mem_centralizer_iff.mpr
    rintro _ ⟨l, rfl⟩
    change ρ.asGroupHom (l : G) * ρ.asGroupHom (g : G) =
      ρ.asGroupHom (g : G) * ρ.asGroupHom (l : G)
    rw [← map_mul, ← map_mul]
    exact congrArg ρ.asGroupHom ((hker g).mp g.property l l.property))
  have hj : Function.Injective j := by
    intro x y h
    apply Subtype.ext
    apply hf
    exact congrArg (fun c : C => c.val.val) h
  let : IsCyclic f.ker := isCyclic_of_injective j hj
  have hfA : Function.Injective (f.comp A.subtype) := by
    apply (f.comp A.subtype).ker_eq_bot_iff.mp
    apply le_bot_iff.mp
    intro a ha
    apply Subtype.ext
    apply BinaryIrreducibleCentralizer.centralizing_square_one_eq_one ρ L hf
    · exact elemPow_eq_one_of_isElementaryAbelian (a : G) a.property
    · exact (hker a).mp ha
  let B := A.map f
  let fA : A →* B := (f.comp A.subtype).codRestrict B
    (fun a => mem_map_of_mem f a.property)
  have hAB : Nonempty (A ≃* B) := by
    refine ⟨MulEquiv.ofBijective fA ⟨?_, ?_⟩⟩
    · intro a b hab
      exact hfA (congrArg Subtype.val hab)
    · rintro ⟨b, a, ha, rfl⟩
      exact ⟨⟨a, ha⟩, rfl⟩
  have hB : IsElementaryTwo B := by
    refine ⟨?_, IsElementaryAbelian.map f⟩
    intro hB
    have hc : Nat.card A = Nat.card B := Nat.card_congr hAB.some.toEquiv
    rw [hB] at hc
    exact hA.1 (Subgroup.eq_bot_of_card_eq A (by simpa using hc))
  have hr : rank B = rank A := by
    unfold rank
    rw [Nat.card_congr hAB.some.toEquiv]
  obtain ⟨n, c, hn, hcgen⟩ := hbudget B hB
  have hinc (l : L) : f (l : G) = MulAut.conj (e (QuotientGroup.mk' (center L) l)) := by
    change q (MulAut.conjNormal (l : G)) = _
    rw [MulAut.conjNormal_val]
    exact MulAut.centralQuotientAction_conj e l
  have hsurj : Function.Surjective (fun l : L => e (QuotientGroup.mk' (center L) l)) :=
    e.surjective.comp (QuotientGroup.mk'_surjective (center L))
  choose d hd using fun i => hsurj (c i)
  change ∀ i, e (QuotientGroup.mk' (center L) (d i)) = c i at hd
  refine ⟨n, fun i => (d i : G), by simpa only [hr] using hn, ?_⟩
  let J := ⨆ i, A.map (MulAut.conj (d i : G)).toMonoidHom
  apply lift_perfect_containment f L J (fun g hg => (hker g).mp hg)
  have hmap (i : Fin n) :
      (A.map (MulAut.conj (d i : G)).toMonoidHom).map f =
        B.map (MulAut.conj (MulAut.conj (c i))).toMonoidHom := by
    rw [map_map, map_map]
    congr 1
    apply MonoidHom.ext
    intro a
    change f ((d i : G) * a * (d i : G)⁻¹) =
      MulAut.conj (c i) * f a * (MulAut.conj (c i))⁻¹
    rw [map_mul, map_mul, map_inv, hinc, hd]
  have hJ : J.map f = ⨆ i, B.map (MulAut.conj (MulAut.conj (c i))).toMonoidHom := by
    dsimp only [J]
    rw [Subgroup.map_iSup]
    exact iSup_congr hmap
  rw [hJ]
  apply le_trans _ hcgen
  rintro _ ⟨l, hl, rfl⟩
  exact ⟨e (QuotientGroup.mk' (center L) ⟨l, hl⟩), (hinc ⟨l, hl⟩).symm⟩

/-- Source inequality (2.6), using subgroup conjugates and the original
binary representation, with every central-cover lift discharged. -/
theorem finrank_le_of_cubicRatio_and_elementary_budget [Finite G]
    (ρ : Representation (ZMod 2) G V) (L : Subgroup G) [L.Normal]
    [Group.IsPerfect L] (hf : Function.Injective ρ)
    (hi : IsIrreducible (ρ.comp L.subtype)) (hfix : fixedSpace ρ L = ⊥)
    (e : L ⧸ center L ≃* S) {a b : ℕ}
    (hbudget : ElementaryInnerConjugateBudget S b)
    (hratio : cubicRatio ρ ≤ a) : Module.finrank (ZMod 2) V ≤ a * b := by
  obtain ⟨A, hA, _, hd⟩ := (cubicRatio_le_nat_iff ρ a).mp hratio
  obtain ⟨n, c, hn, hc⟩ :=
    subgroup_conjugate_budget_of_central_cover ρ L hf hi e hbudget A hA
  calc
    Module.finrank (ZMod 2) V ≤ n * fixedCodim ρ A :=
      finrank_le_mul_fixedCodim_of_subgroup_conjugates ρ L A hfix c hc
    _ ≤ n * (a * rank A) := Nat.mul_le_mul_left n hd
    _ = a * (n * rank A) := by ac_rfl
    _ ≤ a * b := Nat.mul_le_mul_left a hn

end Representation.BinaryOffender
