module

public import Theory.Representation.BinaryOffender.CommutatorRank
public import Theory.Representation.BinaryOffender.ComponentPermutationObstruction
public import Theory.Representation.BinaryOffender.QuadraticSection

/-!
# Involutions bound the quadratic ratio in small binary dimension

For an involution t, the actual cyclic subgroup generated by t is an
eligible quadratic actor of rank one. In characteristic two the image of
σ(t) - 1 lies in its kernel, so rank-nullity bounds the fixed codimension
by half the module dimension. Consequently dimension at most four forces
q ≤ 2, with no faithfulness or irreducibility assumption.

This is the linear-algebra step in the constituent reduction for the
terminal paragraph of Aschbacher–Smith §13.6, printed p.935.
-/

public section
open Subgroup Representation
namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V]

/-- The cyclic involution actor has rank one and displaces at most half the space. -/
theorem involution_actor_rank_and_fixedCodim (σ : Representation (ZMod 2) G V) (t : G) (ht : orderOf t = 2) :
    IsElementaryTwo (zpowers t) ∧ rank (zpowers t) = 1 ∧
      IsQuadratic σ (zpowers t) ∧
      2 * fixedCodim σ (zpowers t) ≤ Module.finrank (ZMod 2) V := by
  classical
  have ht2 : t ^ 2 = 1 := ht ▸ pow_orderOf_eq_one t
  have hcases (a : G) (ha : a ∈ zpowers t) : a = 1 ∨ a = t := by
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp ((mem_zpowers_iff_mem_range_orderOf).mp ha)
    have hi := Finset.mem_range.mp hi
    rw [ht] at hi
    interval_cases i <;> simp
  have hquad : IsQuadratic σ (zpowers t) := by
    intro a ha b hb v
    rcases hcases a ha with rfl | rfl
    · simp
    rcases hcases b hb with rfl | rfl
    · simp
    exact involution_fixes_displacement σ (by simpa only [pow_two] using ht2) v
  have hA : IsElementaryTwo (zpowers t) := by
    refine ⟨?_, IsElementaryAbelian.zpowers_of_pow_eq_one ht2⟩
    intro hb
    have ht1 : t = 1 := by simpa only [hb, mem_bot] using mem_zpowers t
    simp [ht1] at ht
  refine ⟨hA, ?_, hquad, ?_⟩
  · rw [rank, Nat.card_zpowers, ht]
    exact Nat.log_pow (by decide : 1 < 2) 1
  · have hle : LinearMap.range (σ t - LinearMap.id) ≤ fixedSpace σ (zpowers t) := by
      rintro _ ⟨v, rfl⟩
      rw [mem_fixedSpace_zpowers_iff]
      exact involution_fixes_displacement σ (by simpa only [pow_two] using ht2) v
    have hr := Submodule.finrank_mono hle
    rw [← fixedCodim_zpowers_eq_displacement_rank] at hr
    have hsum := fixedCodim_add_finrank σ (zpowers t)
    omega

/-- A genuine involution makes every binary action of degree at most four
have quadratic ratio at most two. -/
theorem quadraticRatio_le_two_of_finrank_le_four
    (σ : Representation (ZMod 2) G V) (t : G) (ht : orderOf t = 2)
    (hdim : Module.finrank (ZMod 2) V ≤ 4) : quadraticRatio σ ≤ 2 := by
  obtain ⟨hA, hr, hquad, hbound⟩ := involution_actor_rank_and_fixedCodim σ t ht
  apply (quadraticRatio_le_two_iff σ).mpr
  refine ⟨zpowers t, hA, hquad, ?_⟩
  omega

/-- A strict quadratic ratio bound forces degree greater than four as soon
as the acting group contains an involution. -/
theorem finrank_gt_four_of_two_lt_quadraticRatio
    (σ : Representation (ZMod 2) G V) (t : G) (ht : orderOf t = 2)
    (hq : 2 < quadraticRatio σ) : 4 < Module.finrank (ZMod 2) V := by
  by_contra! hdim
  exact not_le_of_gt hq (quadraticRatio_le_two_of_finrank_le_four σ t ht hdim)

end Representation.BinaryOffender
