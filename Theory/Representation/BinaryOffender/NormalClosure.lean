module
public import Theory.Representation.BinaryOffender.GeneratedCore
public import Theory.GroupTheory.GeneralizedFitting.InternalModuleResidual

/-!
# Normal closures of best offenders

All ambient conjugates of a best offender remain best offenders after
restriction to their normal closure. They therefore generate the actual
offender subgroup of that restricted action. Normality transfers a trivial
two-core, and normal-subgroup Fitting monotonicity shows that an offender
centralizing the ambient Fitting subgroup has normal closure with central
intrinsic Fitting subgroup.

Source: Aschbacher–Smith B.1.2–5 and13.7.14–15, pp.68–69,943.
-/

public section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [Finite G]
  [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

omit [Finite G] [FiniteDimensional (ZMod 2) V] in
/-- The normal closure of an actual best offender is itself generated by
best offenders in its literal restricted representation. -/
theorem normalClosure_offenderSubgroup {B : Subgroup G} (hB : IsBestOffender ρ B) :
    offenderSubgroup (ρ.comp (normalClosure (B : Set G)).subtype) = ⊤ := by
  let N := normalClosure (B : Set G)
  let J := offenderSubgroup (ρ.comp N.subtype)
  have hNJ : N ≤ J.map N.subtype := by
    apply (Subgroup.closure_le (J.map N.subtype)).mpr
    intro x hx
    obtain ⟨y,hy,hxy⟩ := Group.mem_conjugatesOfSet_iff.mp hx
    obtain ⟨g,rfl⟩ := isConj_iff.mp hxy
    let C := B.map (MulAut.conj g).toMonoidHom
    have hCN : C ≤ N := by
      rintro _ ⟨b,hb,rfl⟩
      exact conjugatesOfSet_subset_normalClosure
        (Group.mem_conjugatesOfSet_iff.mpr ⟨b,hb,isConj_iff.mpr ⟨g,rfl⟩⟩)
    have hbest := (hB.map_conj ρ g).subgroupOf ρ hCN
    have hj := hbest.le_offenderSubgroup (ρ.comp N.subtype)
    have hgc : g*y*g⁻¹ ∈ C := mem_map_of_mem _ hy
    exact ⟨⟨_,hCN hgc⟩,hj hgc,rfl⟩
  apply top_unique
  intro n _
  obtain ⟨j,hj,he⟩ := hNJ n.property
  exact (show j = n from Subtype.ext he) ▸ hj

omit ρ [Finite G] [FiniteDimensional (ZMod 2) V] in
/-- A normal subgroup inherits the trivial two-core of the ambient group. -/
theorem normal_subgroup_twoCore_eq_bot (N : Subgroup G) [N.Normal]
    (hcore : pCore 2 G = ⊥) : pCore 2 N = ⊥ := by
  have hle : (pCore 2 N).map N.subtype ≤ pCore 2 G :=
    le_sSup ⟨inferInstance, pCore_isPGroup.map N.subtype⟩
  rw [hcore] at hle
  exact (map_eq_bot_iff_of_injective _ N.subtype_injective).mp (bot_unique hle)

omit ρ [FiniteDimensional (ZMod 2) V] in
/-- Centralization of the ambient Fitting subgroup makes the normal closure
have central intrinsic Fitting subgroup. -/
theorem normalClosure_fitting_le_center (B : Subgroup G)
    (hc : B ≤ centralizer (fittingSubgroup G : Set G)) :
    fittingSubgroup (normalClosure (B : Set G)) ≤ center (normalClosure (B : Set G)) := by
  let N := normalClosure (B : Set G)
  have hNC : N ≤ centralizer (fittingSubgroup G : Set G) :=
    normalClosure_le_normal hc
  have hF := fittingSubgroup_map_subtype_le_of_isSubnormal N
    (inferInstance : N.Normal).isSubnormal
  intro f hf
  apply mem_center_iff.mpr
  intro n
  apply Subtype.ext
  exact (hNC n.property f (hF (mem_map_of_mem N.subtype hf))).symm


end Representation.BinaryOffender
