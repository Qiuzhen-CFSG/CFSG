module
public import Theory.Representation.BinaryOffender.Defs
public import Theory.GroupTheory.GeneralizedFitting.ComponentCalculus

/-!
# Component generation from a binary fixed line

An element centralizing an actor preserves its common fixed space. If that
space is one binary line, it fixes its unique nonzero vector. Consequently a
component moving the vector cannot centralize the actor, and the component
commutator dichotomy puts it inside their commutator. Apply this separately
to the two factors of a normal quasisimple product.

The determinant-module consumer uses this to establish the residual generation
in Aschbacher--Smith 14.4.7, printed p.1009, on the original source action.
-/

public noncomputable section
open Subgroup Module
namespace Representation.BinaryOffender
variable {Q V : Type*} [Group Q] [AddCommGroup V] [Module (ZMod 2) V]

/-- A centralizer preserves the unique nonzero vector in a binary fixed line. -/
theorem fixes_of_centralizes_fixed_line (ρ : Representation (ZMod 2) Q V)
    (X : Subgroup Q) (v : V) (hv : v ≠ 0)
    (hf : fixedSpace ρ X = Submodule.span (ZMod 2) {v})
    (c : Q) (hc : c ∈ centralizer (X : Set Q)) : ρ c v = v := by
  have hfv : v ∈ fixedSpace ρ X := hf ▸ Submodule.mem_span_singleton_self v
  have hcv : ρ c v ∈ fixedSpace ρ X := by
    intro x
    change ρ (x : Q) (ρ c v) = ρ c v
    rw [← Module.End.mul_apply, ← map_mul,
      mem_centralizer_iff.mp hc x x.property, map_mul, Module.End.mul_apply]
    exact congrArg (ρ c) (hfv x)
  obtain ⟨a,ha⟩ := Submodule.mem_span_singleton.mp (hf ▸ hcv)
  rcases (show ∀ a : ZMod 2, a = 0 ∨ a = 1 from by decide) a with h0 | h1
  · have hz : ρ c v = 0 := by simpa only [h0,zero_smul] using ha.symm
    have hh := congrArg (ρ c⁻¹) hz
    rw [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one,
      Module.End.one_apply, map_zero] at hh
    exact (hv hh).elim
  · simpa only [h1,one_smul] using ha.symm

/-- A component moving the fixed line lies in its commutator with the actor. -/
theorem component_le_commutator_of_fixed_line (ρ : Representation (ZMod 2) Q V)
    (X C : Subgroup Q) (hC : Theory.GroupTheory.IsComponent Q C)
    (v : V) (hv : v ≠ 0)
    (hf : fixedSpace ρ X = Submodule.span (ZMod 2) {v})
    (hm : ∃ c ∈ C, ρ c v ≠ v) : C ≤ ⁅C,X⁆ := by
  rcases hC.commutator_dichotomy X with hb | he
  · obtain ⟨c,hc,hm⟩ := hm
    exact (hm (fixes_of_centralizes_fixed_line ρ X v hv hf c
      (commutator_eq_bot_iff_le_centralizer.mp hb hc))).elim
  · rw [he]
    apply le_iSup_of_le (1 : X)
    convert (le_rfl : C ≤ C) using 1
    ext x
    simp

private def firstAxis {A B : Type*} [Group A] [Group B] : Subgroup (A × B) :=
  (⊤ : Subgroup A).prod ⊥
private def firstAxisEquiv {A B : Type*} [Group A] [Group B] :
    firstAxis (A := A) (B := B) ≃* A where
  toFun x := x.val.1
  invFun x := ⟨(x,1),mem_top _,one_mem _⟩
  left_inv x := by
    apply Subtype.ext
    exact Prod.ext rfl (mem_bot.mp x.property.2).symm
  right_inv _ := rfl
  map_mul' _ _ := rfl

private theorem first_axis_component {A B : Type*} [Group A] [Group B]
    [Theory.GroupTheory.IsQuasisimple A]
    (K : Subgroup Q) [K.Normal] (e : K ≃* A × B) :
    Theory.GroupTheory.IsComponent Q
      (((firstAxis (A := A) (B := B)).map e.symm.toMonoidHom).map K.subtype) := by
  let : (firstAxis (A := A) (B := B)).Normal :=
    inferInstanceAs (((⊤ : Subgroup A).prod (⊥ : Subgroup B)).Normal)
  let : ((firstAxis (A := A) (B := B)).map e.symm.toMonoidHom).Normal :=
    Subgroup.Normal.map inferInstance _ e.symm.surjective
  refine ⟨(inferInstance : ((firstAxis (A := A) (B := B)).map e.symm.toMonoidHom).Normal).isSubnormal.trans'
    (inferInstance : K.Normal).isSubnormal, ?_⟩
  exact Theory.GroupTheory.IsQuasisimple.of_mulEquiv (firstAxisEquiv.symm.trans
    (((firstAxis (A := A) (B := B)).equivMapOfInjective e.symm.toMonoidHom e.symm.injective).trans
      (((firstAxis (A := A) (B := B)).map e.symm.toMonoidHom).equivMapOfInjective
        K.subtype K.subtype_injective)))

/-- A normal product of two quasisimple factors is generated by commutators
with an actor whose binary fixed line is moved by both factors. -/
theorem product_commutator_eq_of_fixed_line
    {A B : Type*} [Group A] [Group B]
    [Theory.GroupTheory.IsQuasisimple A] [Theory.GroupTheory.IsQuasisimple B]
    (ρ : Representation (ZMod 2) Q V) (K X : Subgroup Q) [K.Normal]
    (e : K ≃* A × B) (v : V) (hv : v ≠ 0)
    (hf : fixedSpace ρ X = Submodule.span (ZMod 2) {v})
    (hleft : ∃ a : A, ρ (e.symm (a,1) : Q) v ≠ v)
    (hright : ∃ b : B, ρ (e.symm (1,b) : Q) v ≠ v) : ⁅K,X⁆ = K := by
  let C := ((firstAxis (A := A) (B := B)).map e.symm.toMonoidHom).map K.subtype
  let f := e.trans (MulEquiv.prodComm : A × B ≃* B × A)
  let D := ((firstAxis (A := B) (B := A)).map f.symm.toMonoidHom).map K.subtype
  have hCK : C ≤ K := map_subtype_le _
  have hDK : D ≤ K := map_subtype_le _
  have hC : C ≤ ⁅K,X⁆ := by
    apply (component_le_commutator_of_fixed_line ρ X C (first_axis_component K e) v hv hf ?_).trans
      (commutator_mono hCK le_rfl)
    obtain ⟨a,ha⟩ := hleft
    exact ⟨e.symm (a,1),mem_map_of_mem K.subtype
      (mem_map_of_mem e.symm.toMonoidHom ⟨mem_top _,one_mem _⟩),ha⟩
  have hD : D ≤ ⁅K,X⁆ := by
    apply (component_le_commutator_of_fixed_line ρ X D (first_axis_component K f) v hv hf ?_).trans
      (commutator_mono hDK le_rfl)
    obtain ⟨b,hb⟩ := hright
    exact ⟨f.symm (b,1),mem_map_of_mem K.subtype
      (mem_map_of_mem f.symm.toMonoidHom ⟨mem_top _,one_mem _⟩),hb⟩
  apply le_antisymm (commutator_le_left K X)
  intro k hk
  let a := (e ⟨k,hk⟩).1
  let b := (e ⟨k,hk⟩).2
  have h1 : (e.symm (a,1) : Q) ∈ C := mem_map_of_mem K.subtype
    (mem_map_of_mem e.symm.toMonoidHom ⟨mem_top _,one_mem _⟩)
  have h2 : (e.symm (1,b) : Q) ∈ D := by
    change (f.symm (b,1) : Q) ∈ D
    exact mem_map_of_mem K.subtype
      (mem_map_of_mem f.symm.toMonoidHom (show (b,1) ∈ firstAxis from ⟨mem_top _,one_mem _⟩))
  have hh := (⁅K,X⁆).mul_mem (hC h1) (hD h2)
  have he : (e.symm (a,1) : Q) * (e.symm (1,b) : Q) = k := by
    change ((e.symm (a,1) * e.symm (1,b) : K) : Q) = k
    rw [← map_mul]
    simp only [Prod.mk_mul_mk, mul_one, one_mul]
    change ((e.symm (e ⟨k,hk⟩) : K) : Q) = k
    rw [e.symm_apply_apply]
  exact he ▸ hh
end Representation.BinaryOffender
