module

public import Theory.Representation.BinaryOffender.SectionLinear

/-!
# Fixed generators and unique maximal subrepresentations

If a binary representation is generated by the orbit of a fixed vector,
and all its simple quotients are equivariantly isomorphic to one model
whose fixed space is a line, then its maximal subrepresentation is unique.
Indeed, the quotient maps send the generator to the same nonzero fixed
vector and therefore agree on its spanning orbit. Finiteness then rules
out an equivariant section over a nonzero maximal subrepresentation.

This gives the intrinsic uniqueness and nonsplitting arguments used in
Aschbacher–Smith, *The Classification of Quasithin Groups*, 13.8.25,
printed p.961 (combined manuscript, 1 March 2004). Establishing the fixed
generator and the compatible natural quotient identifications is a
separate source obligation.
-/

public section

namespace Representation.BinaryOffender
variable {H U E : Type*} [Group H]
  [AddCommGroup U] [Module (ZMod 2) U]
  [AddCommGroup E] [Module (ZMod 2) E]
  (ρ : Representation (ZMod 2) H U)

private theorem nonzero_eq_of_binary_line (F : Submodule (ZMod 2) E)
    (hF : Module.finrank (ZMod 2) F = 1)
    {x y : E} (hx : x ∈ F) (hy : y ∈ F) (hx0 : x ≠ 0) (hy0 : y ≠ 0) : x = y := by
  have hspan := eq_span_singleton_of_mem_of_finrank_eq_one hF hx hx0
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (hspan ▸ hy)
  have hc0 : c ≠ 0 := by
    intro hz
    exact hy0 (by simpa [hz] using hc.symm)
  have hc1 : c = 1 := (by decide : ∀ c : ZMod 2, c ≠ 0 → c = 1) c hc0
  simpa [hc1] using hc

/-- Two proper quotients with equivariant identifications with the same model
have the same kernel, when a fixed vector generates the original module and
the model has a binary fixed line. -/
theorem eq_of_equivariant_quotients_of_fixed_generator
    (σ : Representation (ZMod 2) H E) (T : Subgroup H) (v : U)
    (hgen : Submodule.span (ZMod 2) (Set.range (fun g : H => ρ g v)) = ⊤)
    (hv : v ∈ fixedSpace ρ T)
    (hfix : Module.finrank (ZMod 2) (fixedSpace σ T) = 1)
    (W₁ W₂ : Subrepresentation ρ) (hW₁ : W₁ ≠ ⊤) (hW₂ : W₂ ≠ ⊤)
    (e₁ : (U ⧸ W₁.toSubmodule) ≃ₗ[ZMod 2] E)
    (e₂ : (U ⧸ W₂.toSubmodule) ≃ₗ[ZMod 2] E)
    (he₁ : ∀ g q, e₁ (W₁.quotientRepresentation g q) = σ g (e₁ q))
    (he₂ : ∀ g q, e₂ (W₂.quotientRepresentation g q) = σ g (e₂ q)) : W₁ = W₂ := by
  have hvW (W : Subrepresentation ρ) (hW : W ≠ ⊤) : v ∉ W := by
    intro hvW
    apply hW
    apply top_unique
    have hle : Submodule.span (ZMod 2) (Set.range (fun g : H => ρ g v)) ≤
        W.toSubmodule := by
      apply Submodule.span_le.mpr
      rintro _ ⟨g, rfl⟩
      exact W.apply_mem_toSubmodule g hvW
    rw [hgen] at hle
    exact hle
  let f₁ := e₁.toLinearMap.comp W₁.toSubmodule.mkQ
  let f₂ := e₂.toLinearMap.comp W₂.toSubmodule.mkQ
  have hf₁ (g : H) (u : U) : f₁ (ρ g u) = σ g (f₁ u) :=
    he₁ g (W₁.toSubmodule.mkQ u)
  have hf₂ (g : H) (u : U) : f₂ (ρ g u) = σ g (f₂ u) :=
    he₂ g (W₂.toSubmodule.mkQ u)
  have hfv : f₁ v = f₂ v := by
    apply nonzero_eq_of_binary_line (fixedSpace σ T) hfix
    · intro t
      exact (hf₁ t v).symm.trans (congrArg f₁ (hv t))
    · intro t
      exact (hf₂ t v).symm.trans (congrArg f₂ (hv t))
    · intro hz
      exact hvW W₁ hW₁ ((Submodule.Quotient.mk_eq_zero _).mp (e₁.map_eq_zero_iff.mp hz))
    · intro hz
      exact hvW W₂ hW₂ ((Submodule.Quotient.mk_eq_zero _).mp (e₂.map_eq_zero_iff.mp hz))
  have heq : f₁ = f₂ := by
    apply LinearMap.ext_on hgen
    rintro _ ⟨g, rfl⟩
    rw [hf₁, hf₂, hfv]
  ext u
  have hu := LinearMap.congr_fun heq u
  constructor
  · intro hw
    apply (Submodule.Quotient.mk_eq_zero _).mp
    apply e₂.map_eq_zero_iff.mp
    change f₂ u = 0
    rw [← hu]
    change e₁ (W₁.toSubmodule.mkQ u) = 0
    exact e₁.map_eq_zero_iff.mpr ((Submodule.Quotient.mk_eq_zero _).mpr hw)
  · intro hw
    apply (Submodule.Quotient.mk_eq_zero _).mp
    apply e₁.map_eq_zero_iff.mp
    change f₁ u = 0
    rw [hu]
    change e₂ (W₂.toSubmodule.mkQ u) = 0
    exact e₂.map_eq_zero_iff.mpr ((Submodule.Quotient.mk_eq_zero _).mpr hw)

/-- The fixed-generator criterion for uniqueness of a maximal subrepresentation.
The quotient identifications are equivariant linear equivalences, not just
dimension equalities. -/
theorem unique_maximal_of_equivariant_quotients
    (σ : Representation (ZMod 2) H E) (T : Subgroup H) (v : U)
    (hgen : Submodule.span (ZMod 2) (Set.range (fun g : H => ρ g v)) = ⊤)
    (hv : v ∈ fixedSpace ρ T)
    (hfix : Module.finrank (ZMod 2) (fixedSpace σ T) = 1)
    (hquot : ∀ W : Subrepresentation ρ, IsCoatom W →
      ∃ e : (U ⧸ W.toSubmodule) ≃ₗ[ZMod 2] E,
        ∀ g q, e (W.quotientRepresentation g q) = σ g (e q))
    (W : Subrepresentation ρ) (hW : IsCoatom W) :
    ∀ X : Subrepresentation ρ, IsCoatom X → X = W := by
  intro X hX
  obtain ⟨eX, heX⟩ := hquot X hX
  obtain ⟨eW, heW⟩ := hquot W hW
  exact eq_of_equivariant_quotients_of_fixed_generator ρ σ T v hgen hv hfix
    X W hX.1 hW.1 eX eW heX heW

variable [FiniteDimensional (ZMod 2) U]

/-- In a finite binary module, every proper subrepresentation lies in the unique
maximal one. -/
theorem proper_le_unique_maximal
    (W : Subrepresentation ρ)
    (hunique : ∀ X : Subrepresentation ρ, IsCoatom X → X = W)
    (X : Subrepresentation ρ) (hX : X ≠ ⊤) : X ≤ W := by
  let : Finite U := Module.finite_of_finite (ZMod 2)
  let : Finite (Subrepresentation ρ) :=
    Finite.of_injective (fun Y : Subrepresentation ρ => (Y : Set U)) SetLike.coe_injective
  obtain ⟨Y, hY, hXY⟩ := (eq_top_or_exists_le_coatom X).resolve_left hX
  exact hunique Y hY ▸ hXY

/-- A nonzero unique maximal subrepresentation admits no equivariant section of
the actual quotient map. -/
theorem not_equivariant_section_of_unique_maximal
    (W : Subrepresentation ρ) (hW : IsCoatom W) (hW0 : W ≠ ⊥)
    (hunique : ∀ X : Subrepresentation ρ, IsCoatom X → X = W) :
    ¬ ∃ s : (U ⧸ W.toSubmodule) →ₗ[ZMod 2] U,
      (∀ g q, s (W.quotientRepresentation g q) = ρ g (s q)) ∧
      Function.RightInverse s W.toSubmodule.mkQ := by
  rintro ⟨s, hs, hsection⟩
  let X : Subrepresentation ρ :=
    { toSubmodule := LinearMap.range s
      apply_mem_toSubmodule := by
        rintro g _ ⟨q, rfl⟩
        exact ⟨W.quotientRepresentation g q, hs g q⟩ }
  have hX : X ≠ ⊤ := by
    intro hXtop
    apply hW0
    apply bot_unique
    intro w hw
    have hwX : w ∈ X := hXtop ▸ Submodule.mem_top
    obtain ⟨q, hq⟩ := hwX
    have hq0 : q = 0 := by
      rw [← hsection q, hq]
      exact (Submodule.Quotient.mk_eq_zero _).mpr hw
    change w = 0
    rw [← hq, hq0, map_zero]
  have hXW := proper_le_unique_maximal ρ W hunique X hX
  have hz (q : U ⧸ W.toSubmodule) : q = 0 := by
    rw [← hsection q]
    exact (Submodule.Quotient.mk_eq_zero _).mpr (hXW ⟨q, rfl⟩)
  apply hW.1
  apply top_unique
  intro u _
  exact (Submodule.Quotient.mk_eq_zero _).mp (hz (W.toSubmodule.mkQ u))

end Representation.BinaryOffender
