module

public import Theory.Representation.BinaryOffender.IrreducibleDiagonal
public import Theory.GroupTheory.PResidual.FiniteImage
public import Theory.GroupTheory.CentralPChiefFactorsQuotient

/-!
# Transport through the action on a moved subspace

The subgroup action map is explicitly corestricted to its image. Commutator
subspaces, group commutators, prime residuals and quadratic action identities
pass to this faithful action. Mapping subspaces back along the inclusion of W
identifies the two summands and their sum exactly.

For two Irr⁺ members, their sum is generated by its X-commutators. If the
separate diagonal-generation argument identifies this sum with [[I,a],X],
normalization by A implies A-invariance. Diagonal generation and transport of
irreducibility are not assumed to follow from these elementary lemmas.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
B.7.2, printed p. 119 (1 March 2004 manuscript).
-/

@[expose] public section

namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

/-- Enlarging the vector subspace enlarges its commutator span. -/
theorem subspaceCommutator_mono_left {U W : Submodule (ZMod 2) V}
    (hUW : U ≤ W) (X : Subgroup G) :
    subspaceCommutator ρ U X ≤ subspaceCommutator ρ W X := by
  apply Submodule.span_mono
  rintro _ ⟨x, hx, v, hv, rfl⟩
  exact ⟨x, hx, v, hUW hv, rfl⟩

/-- An invariant subspace contains its action differences. -/
theorem subspaceCommutator_le_of_invariant {W : Submodule (ZMod 2) V} {X : Subgroup G}
    (hW : X ≤ subspaceStabilizer ρ W) : subspaceCommutator ρ W X ≤ W := by
  apply Submodule.span_le.mpr
  rintro _ ⟨x, hx, v, hv, rfl⟩
  exact W.sub_mem ((hW hx v).2 hv) hv

/-- The sum of invariant subspaces is invariant. -/
theorem subspaceStabilizer_sup {I J : Submodule (ZMod 2) V} {X : Subgroup G}
    (hI : X ≤ subspaceStabilizer ρ I) (hJ : X ≤ subspaceStabilizer ρ J) :
    X ≤ subspaceStabilizer ρ (I ⊔ J) := by
  apply le_subspaceStabilizer
  intro x hx v hv
  obtain ⟨i, hi, j, hj, rfl⟩ := Submodule.mem_sup.mp hv
  rw [map_add]
  exact Submodule.mem_sup.mpr ⟨ρ x i, (hI hx i).2 hi, ρ x j, (hJ hx j).2 hj, rfl⟩

/-- A sum of Irr⁺ members is its own commutator subspace. -/
theorem IsIrrPlus.sup_commutator {I J : Submodule (ZMod 2) V} {X : Subgroup G}
    (hI : IsIrrPlus ρ X I) (hJ : IsIrrPlus ρ X J) :
    subspaceCommutator ρ (I ⊔ J) X = I ⊔ J := by
  apply le_antisymm (subspaceCommutator_le_of_invariant ρ
    (subspaceStabilizer_sup ρ hI.choose hJ.choose))
  apply sup_le
  · exact hI.choose_spec.1.ge.trans (subspaceCommutator_mono_left ρ le_sup_left X)
  · exact hJ.choose_spec.1.ge.trans (subspaceCommutator_mono_left ρ le_sup_right X)

/-- An actor normalizing X and preserving D preserves [D,X]. -/
theorem subspaceCommutator_invariant_normalizer {D : Submodule (ZMod 2) V}
    {X A : Subgroup G} (hD : A ≤ subspaceStabilizer ρ D) (hX : A ≤ Subgroup.normalizer X) :
    A ≤ subspaceStabilizer ρ (subspaceCommutator ρ D X) := by
  apply le_subspaceStabilizer
  intro a ha
  change subspaceCommutator ρ D X ≤ (subspaceCommutator ρ D X).comap (ρ a)
  apply Submodule.span_le.mpr
  rintro _ ⟨x, hx, d, hd, rfl⟩
  have hconj : a * x * a⁻¹ ∈ X := (Subgroup.mem_normalizer_iff.mp (hX ha) x).mp hx
  have he : ρ a (ρ x d - d) = ρ (a * x * a⁻¹) (ρ a d) - ρ a d := by
    rw [map_sub]
    congr 1
    simp only [← Module.End.mul_apply, ← map_mul, inv_mul_cancel_right]
  change ρ a (ρ x d - d) ∈ subspaceCommutator ρ D X
  rw [he]
  exact Submodule.subset_span ⟨a * x * a⁻¹, hconj, ρ a d, (hD ha d).2 hd, rfl⟩

/-- Moving I prevents A from centralizing I + Iᵃ. -/
theorem movedSpace_not_fixed {I : Submodule (ZMod 2) V} {A : Subgroup G} {a : G}
    (ha : a ∈ A) (hne : I ≠ I.map (ρ a)) :
    ¬ I ⊔ I.map (ρ a) ≤ fixedSpace ρ A := by
  intro hfix
  apply hne
  apply le_antisymm
  · intro i hi
    exact ⟨i, hi, hfix (Submodule.mem_sup_left hi) ⟨a, ha⟩⟩
  · rintro _ ⟨i, hi, rfl⟩
    have he : ρ a i = i := hfix (Submodule.mem_sup_left hi) ⟨a, ha⟩
    rw [he]
    exact hi

/-- Diagonal generation implies the required A-invariance. -/
theorem diagonal_generation_invariant {I : Submodule (ZMod 2) V} {X A : Subgroup G} {a : G}
    (hXA : ⁅X, A⁆ = X)
    (hq : ∀ b ∈ A, ∀ v, ρ b (ρ a v - v) = ρ a v - v)
    (hgen : subspaceCommutator ρ (diagonalSubspace ρ I a) X = I ⊔ I.map (ρ a)) :
    A ≤ subspaceStabilizer ρ (I ⊔ I.map (ρ a)) := by
  rw [← hgen]
  apply subspaceCommutator_invariant_normalizer
  · apply le_subspaceStabilizer
    intro b hb d hd
    have he : ρ b d = d := diagonalSubspace_le_fixedSpace ρ hq hd ⟨b, hb⟩
    rw [he]
    exact hd
  · exact Subgroup.le_normalizer_iff_commutator_le_left.mpr hXA.le
end Representation.BinaryOffender

namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V) (W : Submodule (ZMod 2) V)

/-- The actual surjection from X onto its action image on W. -/
def restrictedActionSurjection (X : Subgroup G) (hX : X ≤ subspaceStabilizer ρ W) :
    X →* restrictedSubgroup ρ W X :=
  (subgroupActionHom ρ W X hX).codRestrict _ (by
    intro x
    exact ⟨⟨x, hX x.property⟩, x.property, rfl⟩)

/-- Every restricted actor is the image of an original actor. -/
theorem restrictedActionSurjection_surjective (X : Subgroup G)
    (hX : X ≤ subspaceStabilizer ρ W) :
    Function.Surjective (restrictedActionSurjection ρ W X hX) := by
  rintro ⟨y, x, hx, rfl⟩
  exact ⟨⟨x, hx⟩, rfl⟩

/-- The inclusion of W identifies the restricted and original commutator spans. -/
theorem subspaceCommutator_restricted_map (X : Subgroup G)
    (hX : X ≤ subspaceStabilizer ρ W) (U : Submodule (ZMod 2) W) :
    (subspaceCommutator (subspaceImageRepresentation ρ W) U
      (restrictedSubgroup ρ W X)).map W.subtype =
        subspaceCommutator ρ (U.map W.subtype) X := by
  apply le_antisymm
  · apply Submodule.map_le_iff_le_comap.mpr
    apply Submodule.span_le.mpr
    rintro _ ⟨g, ⟨x, hx, rfl⟩, w, hw, rfl⟩
    exact Submodule.subset_span ⟨x, hx, w, ⟨w, hw, rfl⟩, rfl⟩
  · apply Submodule.span_le.mpr
    rintro _ ⟨x, hx, _, ⟨w, hw, rfl⟩, rfl⟩
    refine ⟨subspaceImageRepresentation ρ W (subspaceActionHom ρ W ⟨x, hX hx⟩) w - w,
      Submodule.subset_span ?_, rfl⟩
    exact ⟨subspaceActionHom ρ W ⟨x, hX hx⟩, ⟨⟨x, hX hx⟩, hx, rfl⟩, w, hw, rfl⟩

/-- Full generation by X survives restriction to W. -/
theorem restricted_commutator_eq_top (X : Subgroup G)
    (hX : X ≤ subspaceStabilizer ρ W) (hfull : subspaceCommutator ρ W X = W) :
    subspaceCommutator (subspaceImageRepresentation ρ W) ⊤
      (restrictedSubgroup ρ W X) = ⊤ := by
  apply Submodule.map_injective_of_injective W.subtype_injective
  simpa only [subspaceCommutator_restricted_map ρ W X hX,
    Submodule.map_top, Submodule.range_subtype] using hfull

/-- The equality [X,A] = X survives passage to the action image. -/
theorem restrictedSubgroup_commutator {X A : Subgroup G}
    (hX : X ≤ subspaceStabilizer ρ W) (hA : A ≤ subspaceStabilizer ρ W)
    (hXA : ⁅X, A⁆ = X) :
    ⁅restrictedSubgroup ρ W X, restrictedSubgroup ρ W A⁆ = restrictedSubgroup ρ W X := by
  have he : ⁅X.subgroupOf (subspaceStabilizer ρ W),
      A.subgroupOf (subspaceStabilizer ρ W)⁆ = X.subgroupOf (subspaceStabilizer ρ W) := by
    apply Subgroup.map_injective (subspaceStabilizer ρ W).subtype_injective
    rw [Subgroup.map_commutator, Subgroup.map_subgroupOf_eq_of_le hX,
      Subgroup.map_subgroupOf_eq_of_le hA, hXA]
  unfold restrictedSubgroup
  rw [← Subgroup.map_commutator, he]

/-- The explicit identity [V,a,A] = 0 restricts to W. -/
theorem restricted_quadratic {A : Subgroup G}
    (hA : A ≤ subspaceStabilizer ρ W) {a : G} (ha : a ∈ A)
    (hq : ∀ b ∈ A, ∀ v, ρ b (ρ a v - v) = ρ a v - v) :
    ∀ b ∈ restrictedSubgroup ρ W A, ∀ v : W,
      subspaceImageRepresentation ρ W b
        (subspaceImageRepresentation ρ W (subspaceActionHom ρ W ⟨a, hA ha⟩) v - v) =
      subspaceImageRepresentation ρ W (subspaceActionHom ρ W ⟨a, hA ha⟩) v - v := by
  rintro b ⟨x, hx, rfl⟩ v
  exact Subtype.ext (hq x hx v)

/-- The inclusion of W intertwines each restricted operator with the original operator. -/
theorem map_restricted_action (U : Submodule (ZMod 2) W)
    (a : subspaceStabilizer ρ W) :
    (U.map (subspaceImageRepresentation ρ W (subspaceActionHom ρ W a))).map W.subtype =
      (U.map W.subtype).map (ρ a) := by
  rw [← Submodule.map_comp, ← Submodule.map_comp]
  rfl

/-- The actual restricted summands remain distinct and span all of W. -/
theorem restricted_pair {I : Submodule (ZMod 2) V} {a : G}
    (ha : a ∈ subspaceStabilizer ρ W) (hIW : I ≤ W)
    (hne : I ≠ I.map (ρ a)) (hsum : I ⊔ I.map (ρ a) = W) :
    let ρw := subspaceImageRepresentation ρ W
    let aw := subspaceActionHom ρ W ⟨a, ha⟩
    let Iw := I.comap W.subtype
    Iw ≠ Iw.map (ρw aw) ∧ Iw ⊔ Iw.map (ρw aw) = ⊤ := by
  dsimp only
  have hmap : (I.comap W.subtype).map W.subtype = I := by
    rw [Submodule.map_comap_subtype, inf_eq_right.mpr hIW]
  constructor
  · intro he
    apply hne
    have he' := congrArg (Submodule.map W.subtype) he
    simpa only [map_restricted_action, hmap] using he'
  · apply Submodule.map_injective_of_injective W.subtype_injective
    rw [Submodule.map_sup, map_restricted_action, hmap,
      Submodule.map_top, Submodule.range_subtype]
    exact hsum

/-- The genuine central-chief-factor property descends to the restricted image. -/
theorem restricted_centralChiefFactors (X : Subgroup G)
    (hX : X ≤ subspaceStabilizer ρ W) (hchief : Subgroup.HasCentralPChiefFactors 2 X) :
    Subgroup.HasCentralPChiefFactors 2 (restrictedSubgroup ρ W X) :=
  hchief.of_surjective (restrictedActionSurjection ρ W X hX)
    (restrictedActionSurjection_surjective ρ W X hX)

variable [Finite G]
/-- The action image of a finite two-residual group is two-residual. -/
theorem restricted_pResidual_eq_top (X : Subgroup G)
    (hX : X ≤ subspaceStabilizer ρ W) (hres : pResidual 2 X = ⊤) :
    pResidual 2 (restrictedSubgroup ρ W X) = ⊤ := by
  rw [← Subgroup.map_pResidual_of_surjective 2 (restrictedActionSurjection ρ W X hX)
    (restrictedActionSurjection_surjective ρ W X hX), hres]
  exact Subgroup.map_top_of_surjective _ (restrictedActionSurjection_surjective ρ W X hX)
end Representation.BinaryOffender
