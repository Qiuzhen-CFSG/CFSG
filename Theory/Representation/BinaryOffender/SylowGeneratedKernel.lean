module
public import Theory.Representation.RankOne.QuadraticRecognition.CentralQuotientBounds
public import Theory.Representation.BinaryOffender.ActionImage
public import Theory.Representation.BinaryOffender.CentralSectionAction
public import Theory.Representation.BinaryOffender.RestrictionComparison

/-!
# Central quotients of modules generated by Sylow fixed vectors

The two-core fixes the Sylow-fixed seed and, by normality, all its
translates. It therefore acts trivially. Passing to the faithful action
image gives a trivial two-core. The kernel on any central quotient is
then already in the original action kernel, since the kernel on the
quotient by global fixed vectors is a normal elementary two-group.

This keeps arbitrary central-quotient coordinates and does not assume
faithfulness of the original representation. The DGS Chapter 7 endpoint
application uses it on Z/Ω₁(Z(L)); source: *Groups and Graphs* (1985),
(7.1), printed pp.126–127, and corrected Sylow generation in (5.12).
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender
open Representation.RankOne.QuadraticRecognition
namespace Representation.BinaryOffender
variable {G V W : Type*} [Group G] [Finite G]
  [AddCommGroup V] [Module (ZMod 2) V] [AddCommGroup W] [Module (ZMod 2) W]

omit [Finite G] in
/-- The two-core fixes every translate of the Sylow-fixed seed. -/
theorem pCore_le_kernel_of_sylow_fixed_generation
    (ρ : Representation (ZMod 2) G V) (S : Sylow 2 G)
    (hg : GeneratedByFixedSpace ρ S) : pCore 2 G ≤ ρ.ker := by
  have hs : fixedSpace ρ (S : Subgroup G) ≤ fixedSpace ρ (pCore 2 G) :=
    fixedSpace_antitone ρ (pCore_isPGroup.le_sylow_of_normal S)
  have hspan : (⨆ g : G, (fixedSpace ρ S).map (ρ g)) ≤ fixedSpace ρ (pCore 2 G) := by
    apply iSup_le
    rintro g _ ⟨v,hv,rfl⟩
    exact (fixedSpace_stable_of_normalizes ρ
      (show (⊤ : Subgroup G) ≤ normalizer (pCore 2 G : Set G) from le_normalizer_of_normal)
      (mem_top g) v).2 (hs hv)
  have htop : fixedSpace ρ (pCore 2 G) = ⊤ := top_unique (hg ▸ hspan)
  intro a ha
  apply LinearMap.ext
  intro v
  exact (show v ∈ fixedSpace ρ (pCore 2 G) from htop.symm ▸ Submodule.mem_top) ⟨a,ha⟩

/-- The actual faithful image of a fixed-generated module is two-reduced. -/
theorem actionImage_pCore_eq_bot_of_sylow_fixed_generation
    (ρ : Representation (ZMod 2) G V) (S : Sylow 2 G)
    (hg : GeneratedByFixedSpace ρ S) : pCore 2 (actionImage ρ) = ⊥ := by
  let T := S.mapSurjective (f := actionHom ρ) ρ.asGroupHom.rangeRestrict_surjective
  have hgen : GeneratedByFixedSpace (imageRepresentation ρ) T :=
    generatedByFixedSpace_of_equivariant_surjection ρ (imageRepresentation ρ)
      (actionHom ρ) LinearMap.id Function.surjective_id (fun _ _ => rfl) S hg
  have hc := pCore_le_kernel_of_sylow_fixed_generation (imageRepresentation ρ) T hgen
  exact bot_unique (hc.trans ((imageRepresentation ρ).ker_eq_bot_iff.mpr
    (imageRepresentation_injective ρ)).le)

/-- Passing through a specified central quotient creates no new action kernel. -/
theorem kernel_le_of_central_quotient_sylow_fixed_generation
    (ρ : Representation (ZMod 2) G V) (σ : Representation (ZMod 2) G W)
    (S : Sylow 2 G) (hg : GeneratedByFixedSpace ρ S)
    (f : V →ₗ[ZMod 2] W) (hk : f.ker ≤ fixedSpace ρ ⊤)
    (he : ∀ g v, f (ρ g v) = σ g (f v)) : σ.ker ≤ ρ.ker := by
  have hc := actionImage_pCore_eq_bot_of_sylow_fixed_generation ρ S hg
  have hf := globalFixedQuotient_faithful (imageRepresentation ρ)
    (imageRepresentation_injective ρ) hc
  intro g hgs
  have hgim : actionHom ρ g = 1 := by
    apply hf
    rw [map_one]
    apply LinearMap.ext
    intro q
    obtain ⟨v,rfl⟩ := (fixedSpace (imageRepresentation ρ) ⊤).mkQ_surjective q
    apply (Submodule.Quotient.eq _).mpr
    have hfix : ρ g v - v ∈ fixedSpace ρ ⊤ := by
      apply hk
      change f (ρ g v - v) = 0
      rw [map_sub,he,show σ g = 1 from hgs,Module.End.one_apply,sub_self]
    intro a
    obtain ⟨b,hb⟩ := ρ.asGroupHom.rangeRestrict_surjective a.val
    change imageRepresentation ρ a.val (imageRepresentation ρ (actionHom ρ g) v - v) = _
    rw [←hb]
    exact hfix ⟨b,mem_top b⟩
  apply LinearMap.ext
  exact (actionHom_eq_one_iff ρ g).mp hgim
end Representation.BinaryOffender
