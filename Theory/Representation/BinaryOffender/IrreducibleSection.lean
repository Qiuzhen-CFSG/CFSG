module

public import Theory.Representation.BinaryOffender.SubspaceAction
public import Theory.Representation.SubrepresentationLattice
public import Theory.Representation.SubspaceQuotient

/-!
# Irreducible sections above fixed vectors

`IsIrrPlus ρ X I` is the source definition: `I` is X-invariant, `I = [I,X]`,
and the actual quotient representation on `I / C_I(X)` is irreducible.
In particular zero and centralized subspaces are excluded. No residual or
chief-factor hypothesis is hidden in the definition.

An irreducible quotient forces a noncentral invariant subspace to supplement
its fixed vectors. Taking commutators removes this central summand, proving
that the members of `Irr⁺` form an antichain. We also prove the elementary
diagonal argument: an operator preserving two disjoint summands and fixing
their diagonal fixes their sum.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
1 March 2004 manuscript, A.1.40 (printed p. 31) and the proof of B.7.2
(printed p. 119). These lemmas are prerequisites, not the B.7.2 theorem.
-/

@[expose] public section

namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

/-- Restrict the original action to an X-invariant subspace. -/
def invariantSubspace (X : Subgroup G) (I : Submodule (ZMod 2) V)
    (hI : X ≤ subspaceStabilizer ρ I) : Subrepresentation (ρ.comp X.subtype) :=
  ⟨I, fun x _ hv => (hI x.property _).2 hv⟩

/-- The subrepresentation of X-fixed vectors inside I, namely C_I(X). -/
noncomputable def centralSubspace (X : Subgroup G) (I : Submodule (ZMod 2) V)
    (hI : X ≤ subspaceStabilizer ρ I) :
    Subrepresentation (invariantSubspace ρ X I hI).toRepresentation where
  toSubmodule := (fixedSpace ρ X).comap I.subtype
  apply_mem_toSubmodule x v hv := by
    change ∀ y : X, ρ y (ρ x v) = ρ x v
    have hx : ρ x v = v := hv x
    rw [hx]
    exact hv

/-- The literal vector-space quotient I / C_I(X). -/
abbrev centralQuotient (X : Subgroup G) (I : Submodule (ZMod 2) V) :=
  I ⧸ (fixedSpace ρ X).comap I.subtype

/-- The original X-action induced on I / C_I(X). -/
noncomputable def centralQuotientRepresentation (X : Subgroup G) (I : Submodule (ZMod 2) V)
    (hI : X ≤ subspaceStabilizer ρ I) : Representation (ZMod 2) X (centralQuotient ρ X I) :=
  (centralSubspace ρ X I hI).quotientRepresentation

/-- The actual family from A.1.40: full commutator subspaces with irreducible
quotient by their X-fixed vectors. -/
def IsIrrPlus (X : Subgroup G) (I : Submodule (ZMod 2) V) : Prop :=
  ∃ hI : X ≤ subspaceStabilizer ρ I,
    subspaceCommutator ρ I X = I ∧
    IsIrreducible (centralQuotientRepresentation ρ X I hI)

/-- An irreducible section in Irr+ has nontrivial X-action. -/
theorem IsIrrPlus.not_le_fixedSpace {X : Subgroup G} {I : Submodule (ZMod 2) V}
    (hI : IsIrrPlus ρ X I) : ¬ I ≤ fixedSpace ρ X := by
  obtain ⟨hstab, _, hirr⟩ := hI
  let := hirr
  have hn := Subrepresentation.irreducible_module_nontrivial
    (centralQuotientRepresentation ρ X I hstab)
  intro h
  have heq : (fixedSpace ρ X).comap I.subtype = ⊤ := by
    apply top_unique
    intro v _
    exact h v.property
  exact (Submodule.Quotient.nontrivial_iff.mp hn) heq

/-- Zero is not a member of Irr+. -/
theorem IsIrrPlus.ne_bot {X : Subgroup G} {I : Submodule (ZMod 2) V}
    (hI : IsIrrPlus ρ X I) : I ≠ ⊥ := by
  intro h
  apply hI.not_le_fixedSpace ρ
  rw [h]
  exact bot_le

/-- If an invariant space is generated by J and fixed vectors, its commutators
are already in J. This removes central summands in the irreducible-section argument. -/
theorem subspaceCommutator_le_of_le_sup_fixedSpace
    {X : Subgroup G} {I J : Submodule (ZMod 2) V}
    (hJ : X ≤ subspaceStabilizer ρ J) (hIJ : I ≤ J ⊔ fixedSpace ρ X) :
    subspaceCommutator ρ I X ≤ J := by
  apply Submodule.span_le.mpr
  rintro _ ⟨x, hx, v, hv, rfl⟩
  obtain ⟨j, hj, z, hz, rfl⟩ := Submodule.mem_sup.mp (hIJ hv)
  have hfix : ρ x z = z := hz ⟨x, hx⟩
  change ρ x (j + z) - (j + z) ∈ J
  rw [map_add, hfix, add_sub_add_right_eq_sub]
  exact J.sub_mem ((hJ hx j).2 hj) hj

set_option backward.isDefEq.respectTransparency false in
/-- Members of Irr+ cannot properly contain another member. -/
theorem IsIrrPlus.eq_of_le {X : Subgroup G} {I J : Submodule (ZMod 2) V}
    (hI : IsIrrPlus ρ X I) (hJ : IsIrrPlus ρ X J) (hIJ : I ≤ J) : I = J := by
  obtain ⟨hsI, hcI, hiI⟩ := hI
  obtain ⟨hsJ, hcJ, hiJ⟩ := hJ
  let S : Subrepresentation (invariantSubspace ρ X J hsJ).toRepresentation :=
    ⟨I.comap J.subtype, fun x v hv => (hsI x.property v).2 hv⟩
  let C := centralSubspace ρ X J hsJ
  let : IsIrreducible C.quotientRepresentation := hiJ
  rcases Subrepresentation.le_or_sup_eq_top_of_irreducible_quotient C S with h | h
  · exfalso
    apply IsIrrPlus.not_le_fixedSpace ρ ⟨hsI, hcI, hiI⟩
    intro v hv
    exact h (show (⟨v, hIJ hv⟩ : J) ∈ S from hv)
  · apply le_antisymm hIJ
    rw [← hcJ]
    apply subspaceCommutator_le_of_le_sup_fixedSpace ρ hsI
    intro v hv
    have hm : (⟨v, hv⟩ : J) ∈ C.toSubmodule ⊔ S.toSubmodule := by rw [h]; trivial
    obtain ⟨c, hc, i, hi, heq⟩ := Submodule.mem_sup.mp hm
    apply Submodule.mem_sup.mpr
    refine ⟨i, hi, c, hc, ?_⟩
    have hv := congrArg (fun j : J => (j : V)) heq
    change (c : V) + (i : V) = v at hv
    exact (add_comm _ _).trans hv
end Representation.BinaryOffender

namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

/-- An operator stabilizing two disjoint summands and fixing their a-diagonal
fixes both summands. This is the linear step in B.7.2's stabilizer argument. -/
theorem fixes_sup_of_fixes_diagonal (I : Submodule (ZMod 2) V) (a b : G)
    (hdis : Disjoint I (I.map (ρ a)))
    (hI : ∀ v ∈ I, ρ b v ∈ I)
    (hJ : ∀ v ∈ I.map (ρ a), ρ b v ∈ I.map (ρ a))
    (hdiag : ∀ v ∈ I, ρ b (ρ a v - v) = ρ a v - v) :
    ∀ v ∈ I ⊔ I.map (ρ a), ρ b v = v := by
  have hsplit (v : V) (hv : v ∈ I) : ρ b v = v ∧ ρ b (ρ a v) = ρ a v := by
    have heq : ρ b (ρ a v) - ρ a v = ρ b v - v := by
      have hd := hdiag v hv
      rw [map_sub] at hd
      exact (sub_eq_sub_iff_sub_eq_sub).mp hd
    have hz : ρ b v - v = 0 := by
      have hm : ρ b v - v ∈ I ⊓ I.map (ρ a) := by
        refine ⟨I.sub_mem (hI v hv) hv, ?_⟩
        rw [← heq]
        have hav : ρ a v ∈ I.map (ρ a) := ⟨v, hv, rfl⟩
        exact (I.map (ρ a)).sub_mem (hJ _ hav) hav
      rw [hdis.eq_bot] at hm
      exact hm
    exact ⟨sub_eq_zero.mp hz, sub_eq_zero.mp (heq.trans hz)⟩
  intro v hv
  obtain ⟨i, hi, j, hj, rfl⟩ := Submodule.mem_sup.mp hv
  obtain ⟨w, hw, rfl⟩ := hj
  rw [map_add, (hsplit i hi).1, (hsplit w hw).2]
end Representation.BinaryOffender
