module

public import Theory.Representation.BinaryOffender.Basic
public import Mathlib.Algebra.Ring.Commute

/-!
# The centralizer used in binary Thompson replacement

We construct `C_A([v,A])` from the linear span of the displacement vectors.
The key cyclic-module fact is that `v` belongs to `[v,A] + C_V(A)` only if
`v` is already fixed. Its proof writes a displacement as `d v`, where `d`
is a linear combination of the commuting square-zero operators `ρ a - 1`.
In characteristic two, such a combination again squares to zero.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
1 March 2004 manuscript, the proof of B.1.4(3), printed pp. 68–69.
-/

@[expose] public section

namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

/-- The subspace `[v,A]` generated by the displacement vectors. -/
noncomputable def displacementSpan (A : Subgroup G) (v : V) : Submodule (ZMod 2) V :=
  Submodule.span (ZMod 2) {w | ∃ a ∈ A, ρ a v - v = w}

/-- The actual centralizer `C_A([v,A])`, inside `A`. -/
def replacementSubgroup (A : Subgroup G) (v : V) : Subgroup G where
  carrier := {a | a ∈ A ∧ ∀ u ∈ displacementSpan ρ A v, ρ a u = u}
  one_mem' := ⟨A.one_mem, by simp⟩
  mul_mem' := by
    rintro a b ⟨ha, ha'⟩ ⟨hb, hb'⟩
    refine ⟨A.mul_mem ha hb, fun u hu => ?_⟩
    simp only [map_mul, Module.End.mul_apply, hb' u hu, ha' u hu]
  inv_mem' := by
    rintro a ⟨ha, ha'⟩
    refine ⟨A.inv_mem ha, fun u hu => ?_⟩
    have h := congrArg (ρ a⁻¹) (ha' u hu)
    simpa only [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one,
      Module.End.one_apply] using h.symm

/-- The replacement centralizer is a subgroup of the original actor. -/
theorem replacementSubgroup_le (A : Subgroup G) (v : V) :
    replacementSubgroup ρ A v ≤ A := fun _ h => h.1

/-- Centralizing the displacement space can be tested on its generators. -/
theorem mem_replacementSubgroup_iff {A : Subgroup G} {v : V} {a : G} :
    a ∈ replacementSubgroup ρ A v ↔
      a ∈ A ∧ ∀ b ∈ A, ρ a (ρ b v - v) = ρ b v - v := by
  constructor
  · rintro ⟨ha, h⟩
    exact ⟨ha, fun b hb => h _ (Submodule.subset_span ⟨b, hb, rfl⟩)⟩
  · rintro ⟨ha, h⟩
    refine ⟨ha, fun u hu => ?_⟩
    induction hu using Submodule.span_induction with
    | mem w hw => obtain ⟨b, hb, rfl⟩ := hw; exact h b hb
    | zero => exact map_zero _
    | add x y _ _ hx hy => simp only [map_add, hx, hy]
    | smul c x _ hx => simp only [map_smul, hx]

/-- The displacement space is fixed by its centralizer. -/
theorem displacementSpan_le_fixedSpace_replacement (A : Subgroup G) (v : V) :
    displacementSpan ρ A v ≤ fixedSpace ρ (replacementSubgroup ρ A v) := by
  intro u hu
  exact (Representation.mem_invariants _ _).mpr (fun a => a.property.2 u hu)

/-- A smaller group fixes a larger space. -/
theorem fixedSpace_antitone {A B : Subgroup G} (h : B ≤ A) :
    fixedSpace ρ A ≤ fixedSpace ρ B := by
  intro v hv
  exact (Representation.mem_invariants _ _).mpr (fun b =>
    (Representation.mem_invariants _ _).mp hv ⟨b, h b.property⟩)

/-- A fixed vector gives the whole actor as replacement centralizer. -/
theorem replacementSubgroup_eq_of_mem_fixedSpace {A : Subgroup G} {v : V}
    (hv : v ∈ fixedSpace ρ A) : replacementSubgroup ρ A v = A := by
  apply le_antisymm (replacementSubgroup_le ρ A v)
  intro a ha
  apply (mem_replacementSubgroup_iff ρ).mpr
  refine ⟨ha, fun b hb => ?_⟩
  have hbv := (Representation.mem_invariants _ _).mp hv (⟨b, hb⟩ : A)
  change ρ b v = v at hbv
  simp [hbv]

private theorem binary_add_self {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]
    (w : W) : w + w = 0 := by
  calc
    w + w = ((1 : ZMod 2) + 1) • w := by rw [add_smul, one_smul]
    _ = 0 := by rw [show (1 : ZMod 2) + 1 = 0 by decide, zero_smul]

private theorem displacementOperators_commute {A : Subgroup G}
    (hA : IsElementaryTwo A) {d e : Module.End (ZMod 2) V}
    (hd : d ∈ Submodule.span (ZMod 2) {f | ∃ a ∈ A, ρ a - 1 = f})
    (he : e ∈ Submodule.span (ZMod 2) {f | ∃ a ∈ A, ρ a - 1 = f}) :
    Commute d e := by
  let _ : IsElementaryAbelian 2 A := hA.2
  apply Commute.span_left (R := ZMod 2) (s := {f | ∃ a ∈ A, ρ a - 1 = f}) ?_ d hd
  rintro _ ⟨a, ha, rfl⟩
  apply Commute.span_right (R := ZMod 2) (s := {f | ∃ a ∈ A, ρ a - 1 = f}) ?_ e he
  rintro _ ⟨b, hb, rfl⟩
  have hab : Commute (ρ a) (ρ b) := by
    change ρ a * ρ b = ρ b * ρ a
    rw [← map_mul, ← map_mul, setLike_mul_comm ha hb]
  exact (hab.sub_right (Commute.one_right _)).sub_left (Commute.one_left _)

/-- Commuting actors interchange the two displacement operators. -/
theorem displacement_commute {A : Subgroup G} (hA : IsElementaryTwo A)
    {a b : G} (ha : a ∈ A) (hb : b ∈ A) (v : V) :
    ρ a (ρ b v - v) - (ρ b v - v) =
      ρ b (ρ a v - v) - (ρ a v - v) := by
  have h := (displacementOperators_commute ρ hA
    (Submodule.subset_span ⟨a, ha, rfl⟩)
    (Submodule.subset_span ⟨b, hb, rfl⟩)).eq
  exact congrArg (fun d : Module.End (ZMod 2) V => d v) h

/-- The centralizer is detected by displacement into the common fixed space. -/
theorem mem_replacementSubgroup_iff_displacement {A : Subgroup G}
    (hA : IsElementaryTwo A) {a : G} (ha : a ∈ A) (v : V) :
    a ∈ replacementSubgroup ρ A v ↔ ρ a v - v ∈ fixedSpace ρ A := by
  rw [mem_replacementSubgroup_iff]
  constructor
  · intro h
    apply (Representation.mem_invariants _ _).mpr
    intro b
    change ρ (b : G) (ρ a v - v) = ρ a v - v
    apply sub_eq_zero.mp
    rw [← displacement_commute ρ hA ha b.property, h.2 b b.property, sub_self]
  · intro h
    refine ⟨ha, fun b hb => ?_⟩
    apply sub_eq_zero.mp
    rw [displacement_commute ρ hA ha hb]
    exact sub_eq_zero.mpr ((Representation.mem_invariants _ _).mp h ⟨b, hb⟩)

private theorem displacementOperator_square_zero {A : Subgroup G}
    (hA : IsElementaryTwo A) {d : Module.End (ZMod 2) V}
    (hd : d ∈ Submodule.span (ZMod 2) {f | ∃ a ∈ A, ρ a - 1 = f}) :
    d * d = 0 := by
  let _ : IsElementaryAbelian 2 A := hA.2
  induction hd using Submodule.span_induction with
  | mem f hf =>
    obtain ⟨a, ha, rfl⟩ := hf
    have ha2 : a * a = 1 := by
      simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) a ha
    have hn (f : Module.End (ZMod 2) V) : -f = f :=
      neg_eq_of_add_eq_zero_left (binary_add_self f)
    simp only [sub_eq_add_neg, hn, add_mul, mul_add, mul_one, one_mul,
      ← map_mul, ha2, map_one]
    have h := binary_add_self (ρ a)
    have h1 := binary_add_self (1 : Module.End (ZMod 2) V)
    calc
      (1 + ρ a) + (ρ a + 1) = (1 + 1) + (ρ a + ρ a) := by abel
      _ = 0 := by rw [h, h1, add_zero]
  | zero => simp
  | add d e hd he hd0 he0 =>
    have hde := (displacementOperators_commute ρ hA hd he).eq
    rw [add_mul, mul_add, mul_add, hd0, he0, zero_add, add_zero, hde]
    exact binary_add_self _
  | smul c d _ hd0 =>
    rw [smul_mul_assoc, mul_smul_comm, hd0, smul_zero, smul_zero]

private theorem displacementOperator_apply_fixed {A : Subgroup G}
    {d : Module.End (ZMod 2) V}
    (hd : d ∈ Submodule.span (ZMod 2) {f | ∃ a ∈ A, ρ a - 1 = f})
    {z : V} (hz : z ∈ fixedSpace ρ A) : d z = 0 := by
  induction hd using Submodule.span_induction with
  | mem f hf =>
    obtain ⟨a, ha, rfl⟩ := hf
    have h := (Representation.mem_invariants _ _).mp hz (⟨a, ha⟩ : A)
    change ρ a z = z at h
    simp [h]
  | zero => rfl
  | add d e _ _ hd he => simp [hd, he]
  | smul c d _ hd => simp [hd]

/-- A cyclic vector cannot belong to its displacement span plus the fixed space
unless it is fixed already. No faithfulness or finiteness is needed. -/
theorem mem_displacementSpan_sup_fixedSpace_iff {A : Subgroup G}
    (hA : IsElementaryTwo A) (v : V) :
    v ∈ displacementSpan ρ A v ⊔ fixedSpace ρ A ↔ v ∈ fixedSpace ρ A := by
  constructor
  · intro hv
    obtain ⟨u, hu, z, hz, huv⟩ := Submodule.mem_sup.mp hv
    have hu' : ∃ d ∈ Submodule.span (ZMod 2) {f | ∃ a ∈ A, ρ a - 1 = f}, d v = u := by
      clear huv
      induction hu using Submodule.span_induction with
      | mem w hw =>
        obtain ⟨a, ha, rfl⟩ := hw
        exact ⟨ρ a - 1, Submodule.subset_span ⟨a, ha, rfl⟩, rfl⟩
      | zero => exact ⟨0, Submodule.zero_mem _, rfl⟩
      | add x y _ _ hx hy =>
        obtain ⟨d, hd, rfl⟩ := hx
        obtain ⟨e, he, rfl⟩ := hy
        exact ⟨d + e, Submodule.add_mem _ hd he, rfl⟩
      | smul c x _ hx =>
        obtain ⟨d, hd, rfl⟩ := hx
        exact ⟨c • d, Submodule.smul_mem _ c hd, rfl⟩
    obtain ⟨d, hd, hdv⟩ := hu'
    have hdu : d u = 0 := by
      rw [← hdv, ← Module.End.mul_apply, displacementOperator_square_zero ρ hA hd]
      rfl
    have hdz := displacementOperator_apply_fixed ρ hd hz
    have hu0 : u = 0 := by
      calc
        u = d v := hdv.symm
        _ = d (u + z) := congrArg d huv.symm
        _ = 0 := by rw [map_add, hdu, hdz, add_zero]
    have hzv : z = v := by simpa only [hu0, zero_add] using huv
    exact hzv ▸ hz
  · exact fun hv => Submodule.mem_sup_right hv
end Representation.BinaryOffender
