module
public import Theory.Representation.BinaryOffender.QuadraticDisjointSummands
public import Theory.Representation.BinaryOffender.QuadraticConstituentStability
public import Mathlib.GroupTheory.OrderOfElement

/-!
# Quadratic actors permuting a faithful pair of summands

A stabilizing member of a commutative quadratic actor fixes a summand that
another member exchanges with a disjoint summand. Commutativity then fixes
the second summand as well. Faithfulness on their sum makes the stabilizer
trivial, so an elementary actor exchanging the pair is generated by that
involution and has order two. A fixed supplement to the sum is allowed.

Source application: Aschbacher--Smith 14.6.13, printed pp.1031--1032.
-/

public section
open Subgroup
namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]

/-- On a faithful sum of two exchanged subspaces, a stabilizing member of a
commutative quadratic actor is the identity. A fixed supplement is permitted. -/
theorem quadratic_pair_stabilizer_eq_one_on_sup
    (ρ : Representation (ZMod 2) G V) (I J : Submodule (ZMod 2) V)
    (hf : ∀ b : G, (∀ v ∈ I ⊔ J, ρ b v = v) → b = 1)
    {A : Subgroup G} [IsMulCommutative A] (hq : IsQuadratic ρ A)
    {t b : G} (ht : t ∈ A) (hb : b ∈ A)
    (hd : Disjoint I J) (hswap : I.map (ρ t) = J)
    (hstable : I.map (ρ b) = I) : b = 1 := by
  have hfix := quadratic_fixes_disjoint_summand ρ I hq ht hb
    (by rwa [hswap]) (fun v hv => hstable ▸ Submodule.mem_map_of_mem hv)
  have hc : Commute b t := congrArg Subtype.val
    ((IsMulCommutative.is_comm (M := A)).comm (⟨b,hb⟩ : A) ⟨t,ht⟩)
  apply hf b
  intro v hv
  obtain ⟨i,hi,j,hj,rfl⟩ := Submodule.mem_sup.mp hv
  rw [← hswap] at hj
  obtain ⟨w,hw,rfl⟩ := hj
  have he : ρ b (ρ t w) = ρ t (ρ b w) := by
    change (ρ b * ρ t) w = (ρ t * ρ b) w
    rw [← map_mul,← map_mul,hc.eq]
  rw [map_add,hfix i hi,he,hfix w hw]

/-- If an elementary quadratic actor permutes two disjoint summands and
exchanges them, its unique nonidentity element is the exchanger. -/
theorem quadratic_swapping_actor_eq_zpowers
    (ρ : Representation (ZMod 2) G V) (I J : Submodule (ZMod 2) V)
    (hf : ∀ b : G, (∀ v ∈ I ⊔ J, ρ b v = v) → b = 1)
    (A : Subgroup G) [IsElementaryAbelian 2 A] (hq : IsQuadratic ρ A)
    (hd : Disjoint I J)
    (hperm : ∀ b ∈ A, I.map (ρ b) = I ∨ I.map (ρ b) = J)
    (t : G) (ht : t ∈ A) (hswap : I.map (ρ t) = J ∧ J.map (ρ t) = I) :
    A = zpowers t := by
  apply le_antisymm
  · intro b hb
    rcases hperm b hb with hs | hs
    · rw [quadratic_pair_stabilizer_eq_one_on_sup ρ I J hf hq ht hb hd hswap.1 hs]
      exact (zpowers t).one_mem
    · have hstable : I.map (ρ (t*b)) = I := by
        rw [map_mul]
        change I.map ((ρ t).comp (ρ b)) = I
        rw [Submodule.map_comp,hs,hswap.2]
      have he := quadratic_pair_stabilizer_eq_one_on_sup ρ I J hf hq ht
        (A.mul_mem ht hb) hd hswap.1 hstable
      have hb' : b = t⁻¹ := eq_inv_of_mul_eq_one_right he
      rw [hb']
      exact (zpowers t).inv_mem (mem_zpowers t)
  · exact zpowers_le.mpr ht

/-- The swapping actor has rank one, so a quadratic-member bound forces each
exchanged summand to have dimension at most two. -/
theorem quadratic_swapping_actor_rank
    (ρ : Representation (ZMod 2) G V) (I J : Submodule (ZMod 2) V)
    (hf : ∀ b : G, (∀ v ∈ I ⊔ J, ρ b v = v) → b = 1)
    (A : Subgroup G) [IsElementaryAbelian 2 A] (hq : IsQuadratic ρ A)
    (hd : Disjoint I J) (hI : I ≠ ⊥)
    (hperm : ∀ b ∈ A, I.map (ρ b) = I ∨ I.map (ρ b) = J)
    (t : G) (ht : t ∈ A) (hswap : I.map (ρ t) = J ∧ J.map (ρ t) = I) :
    Nat.card A = 2 ∧ rank A = 1 := by
  have hne : t ≠ 1 := by
    intro he
    have hIJ := hswap.1
    simp only [he,map_one,Module.End.one_eq_id,Submodule.map_id] at hIJ
    apply hI
    exact disjoint_self.mp (hIJ ▸ hd)
  have horder : orderOf t = 2 :=
    orderOf_eq_prime (elemPow_eq_one_of_isElementaryAbelian t ht) hne
  have hc : Nat.card A = 2 := by
    rw [quadratic_swapping_actor_eq_zpowers ρ I J hf A hq hd hperm t ht hswap,
      Nat.card_zpowers,horder]
  exact ⟨hc,by simp only [rank,hc]; decide⟩
end Representation.BinaryOffender
