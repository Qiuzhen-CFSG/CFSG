/-!
# Separating commuting perfect supports through extensions

For commuting perfect actors, the mixed displacement space is generated by
each actor. If the ambient group permutes the two actors, this space is
ambient invariant. A nonzero mixed space therefore has an irreducible ambient
quotient still generated by both actors. Consequently vanishing of mixed
movement on all irreducible sections implies vanishing on the original module,
without semisimplicity of that module.

On a semisimple restriction, single-factor constituents annihilate mixed
movement. Clifford theory can thus be applied only to the irreducible ambient
sections, where its hypotheses hold. The terminal component application is
Aschbacher--Smith F.9.18(5iii.b) and14.6.22, printed pp.326,1038.
-/

public noncomputable section
open Subgroup Representation
open scoped MonoidAlgebra
namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

theorem subspaceCommutator_swap_of_commute (W : Submodule (ZMod 2) V)
    (A B : Subgroup G) (hc : ∀ a ∈ A, ∀ b ∈ B, Commute a b) :
    subspaceCommutator ρ (subspaceCommutator ρ W A) B =
      subspaceCommutator ρ (subspaceCommutator ρ W B) A := by
  have step (A B : Subgroup G) (hc : ∀ a ∈ A, ∀ b ∈ B, Commute a b) :
      subspaceCommutator ρ (subspaceCommutator ρ W A) B ≤
        subspaceCommutator ρ (subspaceCommutator ρ W B) A := by
    apply Submodule.span_le.mpr
    rintro _ ⟨b,hb,v,hv,rfl⟩
    let D := subspaceCommutator ρ (subspaceCommutator ρ W B) A
    have hl : subspaceCommutator ρ W A ≤ D.comap (ρ b - 1) := by
      apply Submodule.span_le.mpr
      rintro _ ⟨a,ha,w,hw,rfl⟩
      change ρ b (ρ a w-w) - (ρ a w-w) ∈ D
      have he : ρ b (ρ a w) = ρ a (ρ b w) := by
        rw [←Module.End.mul_apply,←map_mul,←Module.End.mul_apply,←map_mul,(hc a ha b hb).eq]
      have hh : ρ b (ρ a w-w) - (ρ a w-w) = ρ a (ρ b w-w) - (ρ b w-w) := by
        rw [map_sub,map_sub,he]
        abel
      rw [hh]
      exact Submodule.subset_span ⟨a,ha,ρ b w-w,Submodule.subset_span ⟨b,hb,w,hw,rfl⟩,rfl⟩
    exact hl hv
  exact le_antisymm (step A B hc) (step B A (fun b hb a ha => (hc a ha b hb).symm))

set_option backward.isDefEq.respectTransparency false in
theorem subspaceCommutator_idempotent_on_invariant
    (W : Submodule (ZMod 2) V) (A : Subgroup G) [Group.IsPerfect A]
    (hW : A ≤ subspaceStabilizer ρ W) :
    subspaceCommutator ρ (subspaceCommutator ρ W A) A = subspaceCommutator ρ W A := by
  let σ := (invariantSubspace ρ A W hW).toRepresentation
  have hm (I : Submodule (ZMod 2) W) :
      (subspaceCommutator σ I ⊤).map W.subtype = subspaceCommutator ρ (I.map W.subtype) A := by
    have hh := subspaceCommutator_map_embedding (ρ.comp A.subtype) σ
      (MonoidHom.id A) W.subtype (fun _ _ => rfl) (⊤ : Subgroup A) I
    rw [Subgroup.map_id,subspaceCommutator_comp_map,←MonoidHom.range_eq_map,A.range_subtype] at hh
    exact hh.symm
  have hh := congrArg (Submodule.map W.subtype) (subspaceCommutator_idempotent_of_perfect σ ⊤)
  rw [hm,hm,Submodule.map_top,Submodule.range_subtype] at hh
  exact hh

theorem subspaceCommutator_map_conj (W : Submodule (ZMod 2) V) (A : Subgroup G) (g : G) :
    (subspaceCommutator ρ W A).map (ρ g) =
      subspaceCommutator ρ (W.map (ρ g)) (A.map (MulAut.conj g).toMonoidHom) := by
  have he (x : G) (v : V) : ρ x (ρ g v) = ρ g (ρ (g⁻¹*x*g) v) := by
    simp only [←Module.End.mul_apply,←map_mul]
    congr 2
    group
  have hh := subspaceCommutator_map_embedding ρ ρ (MulAut.conj g⁻¹).toMonoidHom
    (ρ g) (fun x v => by simpa only [MulEquiv.coe_toMonoidHom,MulAut.conj_apply,inv_inv] using he x v) (A.map (MulAut.conj g).toMonoidHom) W
  have hm : (A.map (MulAut.conj g).toMonoidHom).map (MulAut.conj g⁻¹).toMonoidHom = A := by
    rw [Subgroup.map_map]
    have hi : (MulAut.conj g⁻¹).toMonoidHom.comp (MulAut.conj g).toMonoidHom = MonoidHom.id G := by
      ext x
      simp only [MonoidHom.comp_apply,MulEquiv.coe_toMonoidHom,MulAut.conj_apply,inv_inv,MonoidHom.id_apply]
      group
    rw [hi,Subgroup.map_id]
  rw [hm] at hh
  exact hh.symm

/-- Mixed movement by a pair of commuting perfect actors is generated by each actor. -/
theorem mixed_commutator_generated
    (A B : Subgroup G) [Group.IsPerfect A] [Group.IsPerfect B]
    (hc : ∀ a ∈ A, ∀ b ∈ B, Commute a b) :
    let D := subspaceCommutator ρ (subspaceCommutator ρ ⊤ A) B
    subspaceCommutator ρ D A = D ∧ subspaceCommutator ρ D B = D := by
  have hnorm : B ≤ normalizer (A : Set G) := by
    apply le_trans (b := centralizer (A : Set G)) ?_ (centralizer_le_normalizer _)
    intro b hb
    exact mem_centralizer_iff.mpr (fun a ha => (hc a ha b hb).eq)
  have hW := subspaceCommutator_invariant_normalizer ρ
    (le_subspaceStabilizer ρ ⊤ (by intros; trivial)) hnorm
  constructor
  · rw [subspaceCommutator_swap_of_commute ρ _ B A (fun b hb a ha => (hc a ha b hb).symm),
      subspaceCommutator_idempotent_of_perfect]
  · exact subspaceCommutator_idempotent_on_invariant ρ _ B hW

/-- An ambient group permuting the two factors preserves their mixed movement. -/
theorem mixed_commutator_invariant_of_permuted
    (A B : Subgroup G) (hc : ∀ a ∈ A, ∀ b ∈ B, Commute a b)
    (hp : ∀ g : G,
      (A.map (MulAut.conj g).toMonoidHom = A ∧ B.map (MulAut.conj g).toMonoidHom = B) ∨
      (A.map (MulAut.conj g).toMonoidHom = B ∧ B.map (MulAut.conj g).toMonoidHom = A)) :
    (⊤ : Subgroup G) ≤ subspaceStabilizer ρ
      (subspaceCommutator ρ (subspaceCommutator ρ ⊤ A) B) := by
  apply le_subspaceStabilizer
  intro g _ v hv
  have he : (subspaceCommutator ρ (subspaceCommutator ρ ⊤ A) B).map (ρ g) =
      subspaceCommutator ρ (subspaceCommutator ρ ⊤ A) B := by
    rw [subspaceCommutator_map_conj,subspaceCommutator_map_conj,
      Submodule.map_top,LinearMap.range_eq_top.mpr (ρ.apply_bijective g).surjective]
    rcases hp g with ⟨ha,hb⟩ | ⟨ha,hb⟩
    · rw [ha,hb]
    · rw [ha,hb,subspaceCommutator_swap_of_commute ρ _ B A
        (fun b hb a ha => (hc a ha b hb).symm)]
  exact he ▸ Submodule.mem_map_of_mem (f := ρ g) hv

/-- A fully moved submodule has fully moved quotients, with the literal actions. -/
theorem quotient_moved_eq_top_of_full (S : Subrepresentation ρ)
    (L : Subrepresentation S.toRepresentation) (A : Subgroup G)
    (hfull : subspaceCommutator ρ S.toSubmodule A = S.toSubmodule) :
    subspaceCommutator L.quotientRepresentation ⊤ A = ⊤ := by
  have hs : subspaceCommutator S.toRepresentation ⊤ A = ⊤ := by
    apply Submodule.map_injective_of_injective S.toSubmodule.subtype_injective
    have hm := subspaceCommutator_map_embedding ρ S.toRepresentation (MonoidHom.id G)
      S.toSubmodule.subtype (fun _ _ => rfl) A ⊤
    simpa only [Submodule.map_top,Submodule.range_subtype,Subgroup.map_id] using hm.symm.trans
      (by simpa only [Submodule.map_top,Submodule.range_subtype] using hfull)
  have hm := map_moved_of_surjective_intertwining S.toRepresentation L.quotientRepresentation A
    L.toSubmodule.mkQ L.toSubmodule.mkQ_surjective (fun _ _ => rfl)
  rw [hs,Submodule.map_top,LinearMap.range_eq_top.mpr L.toSubmodule.mkQ_surjective] at hm
  exact hm.symm

/-- Mixed movement on a finite module is detected on an irreducible ambient
section when the two commuting perfect actors are permuted by the ambient group. -/
theorem mixed_commutator_eq_bot_of_irreducible_sections
    [FiniteDimensional (ZMod 2) V]
    (A B : Subgroup G) [Group.IsPerfect A] [Group.IsPerfect B]
    (hc : ∀ a ∈ A, ∀ b ∈ B, Commute a b)
    (hp : ∀ g : G,
      (A.map (MulAut.conj g).toMonoidHom = A ∧ B.map (MulAut.conj g).toMonoidHom = B) ∨
      (A.map (MulAut.conj g).toMonoidHom = B ∧ B.map (MulAut.conj g).toMonoidHom = A))
    (hsections : ∀ (S : Subrepresentation ρ) (L : Subrepresentation S.toRepresentation),
      IsIrreducible L.quotientRepresentation →
      subspaceCommutator L.quotientRepresentation
        (subspaceCommutator L.quotientRepresentation ⊤ A) B = ⊥) :
    subspaceCommutator ρ (subspaceCommutator ρ ⊤ A) B = ⊥ := by
  let D := subspaceCommutator ρ (subspaceCommutator ρ ⊤ A) B
  by_contra hn
  have hd := mixed_commutator_invariant_of_permuted ρ A B hc hp
  let S : Subrepresentation ρ := ⟨D,fun g v hv => (hd (mem_top g) v).2 hv⟩
  let : Nontrivial S.toSubmodule := Submodule.nontrivial_iff_ne_bot.mpr hn
  let : IsCoatomic (Subrepresentation S.toRepresentation) :=
    SimpleHeadQuotient.subrepresentation_coatomic S.toRepresentation
  obtain ⟨L,hL⟩ := IsCoatomic.exists_coatom (Subrepresentation S.toRepresentation)
  have hi := SimpleHeadQuotient.irreducible_quotient_of_isCoatom L hL
  let : Nontrivial (S.toSubmodule ⧸ L.toSubmodule) :=
    Subrepresentation.irreducible_module_nontrivial L.quotientRepresentation
  obtain ⟨hA,hB⟩ := mixed_commutator_generated ρ A B hc
  have hz := hsections S L hi
  rw [quotient_moved_eq_top_of_full ρ S L A hA,
    quotient_moved_eq_top_of_full ρ S L B hB] at hz
  exact top_ne_bot hz

/-- Single-factor simple summands annihilate every mixed displacement. This
uses semisimplicity only on the stated restriction, not on the original module. -/
theorem mixed_commutator_eq_bot_of_semisimple_restriction
    (N A B : Subgroup G) (hAN : A ≤ N) (hBN : B ≤ N)
    [IsSemisimpleModule (ZMod 2)[N] (Representation.asModule (ρ.comp N.subtype))]
    (hsep : ∀ U : Subrepresentation (ρ.comp N.subtype), IsIrreducible U.toRepresentation →
      A.subgroupOf N ≤ U.toRepresentation.ker ∨ B.subgroupOf N ≤ U.toRepresentation.ker) :
    subspaceCommutator ρ (subspaceCommutator ρ ⊤ A) B = ⊥ := by
  let σ := ρ.comp N.subtype
  let e := Subrepresentation.subrepresentationSubmoduleOrderIso (ρ := σ)
  let : IsAtomistic (Subrepresentation σ) := e.symm.isAtomistic_of_isAtomistic inferInstance
  have htop : (⨆ U : Subrepresentation σ, ⨆ (_ : IsIrreducible U.toRepresentation), U) = ⊤ := by
    apply top_unique
    rw [←sSup_atoms_eq_top]
    apply sSup_le
    intro U hU
    exact le_iSup_of_le U (le_iSup_of_le ((Subrepresentation.irreducible_iff_isAtom U).mpr hU) le_rfl)
  have hspan : (⨆ U : Subrepresentation σ, ⨆ (_ : IsIrreducible U.toRepresentation),
      U.toSubmodule) = ⊤ := by
    have hh := congrArg Subrepresentation.toSubmodule htop
    simp only [Homogeneous.toSubmodule_iSup] at hh
    exact hh
  have hkill (a : G) (ha : a ∈ A) (b : G) (hb : b ∈ B) (v : V) :
      ρ b (ρ a v-v) = ρ a v-v := by
    let δ : Module.End (ZMod 2) V := (ρ b-1) * (ρ a-1)
    have hall : (⊤ : Submodule (ZMod 2) V) ≤ δ.ker := by
      rw [←hspan]
      apply iSup_le
      intro U
      apply iSup_le
      intro hi v hv
      let aN : N := ⟨a,hAN ha⟩
      let bN : N := ⟨b,hBN hb⟩
      have fix (x : N) (hx : x ∈ U.toRepresentation.ker) (w : U.toSubmodule) :
          ρ x w = w := congrArg Subtype.val (LinearMap.congr_fun hx w)
      change ρ b (ρ a v-v) - (ρ a v-v) = 0
      rcases hsep U hi with hA | hB
      · have he := fix aN (hA ha) ⟨v,hv⟩
        change ρ a v = v at he
        rw [he,sub_self,map_zero,sub_self]
      · have he := fix bN (hB hb) ⟨v,hv⟩
        have he' := fix bN (hB hb) (U.toRepresentation aN ⟨v,hv⟩)
        change ρ b v = v at he
        change ρ b (ρ a v) = ρ a v at he'
        rw [map_sub,he',he,sub_self]
    exact sub_eq_zero.mp (hall (Submodule.mem_top : v ∈ (⊤ : Submodule (ZMod 2) V)))
  apply bot_unique
  apply Submodule.span_le.mpr
  rintro _ ⟨b,hb,v,hv,rfl⟩
  have hle : subspaceCommutator ρ ⊤ A ≤ (ρ b-1).ker := by
    apply Submodule.span_le.mpr
    rintro _ ⟨a,ha,w,_,rfl⟩
    exact sub_eq_zero.mpr (hkill a ha b hb w)
  exact hle hv

end Representation.BinaryOffender
