module

public import Theory.Representation.BinaryOffender.CentralSectionAction

/-!
# Irreducible seeds in central quotients

Let S be an irreducible P-invariant subspace with S = [S,L], where L ≤ K
and P normalizes K. The intersection S ∩ C_V(K) is P-invariant. If it were
all of S, its L-commutator would vanish; hence the intersection is zero.
Thus S embeds equivariantly into I / C_I(K) for every invariant I containing S.
There is no splitting assumption on I and no identification of I with its quotient.

This supplies the central-quotient version of the fixed-line argument in
Aschbacher–Smith, *The Classification of Quasithin Groups*, 13.8.21(2),
printed p.956 (1 March 2004 manuscript), using A.1.40's literal Irr⁺ convention.
-/

@[expose] public noncomputable section

namespace Representation.BinaryOffender
open Subgroup
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

/-- An irreducible seed generated by L-commutators has no K-fixed vector
when L ≤ K and its actor normalizes K. -/
theorem irreducible_commutator_disjoint_fixedSpace (K L P : Subgroup G)
    (S : Subrepresentation (ρ.comp P.subtype))
    [IsIrreducible S.toRepresentation]
    (hPK : P ≤ normalizer (K : Set G)) (hLK : L ≤ K)
    (hS : S.toSubmodule = subspaceCommutator ρ S.toSubmodule L) :
    Disjoint S.toSubmodule (fixedSpace ρ K) := by
  let C : Subrepresentation S.toRepresentation :=
    ⟨(fixedSpace ρ K).comap S.toSubmodule.subtype, fun p v hv =>
      (fixedSpace_stable_of_normalizes ρ hPK p.property v.val).2 hv⟩
  rcases eq_bot_or_eq_top C with hb | ht
  · rw [Submodule.disjoint_def]
    intro v hv hf
    have hc : (⟨v, hv⟩ : S.toSubmodule) ∈ C := hf
    rw [hb] at hc
    exact congrArg Subtype.val hc
  · have hf : S.toSubmodule ≤ fixedSpace ρ L := by
      intro v hv l
      have hc : (⟨v, hv⟩ : S.toSubmodule) ∈ C := by rw [ht]; trivial
      exact hc ⟨l, hLK l.property⟩
    have hz : S.toSubmodule = ⊥ := hS.trans
      ((subspaceCommutator_eq_bot_iff ρ S.toSubmodule L).mpr hf)
    exact ((Submodule.nontrivial_iff_ne_bot.mp
      (Subrepresentation.irreducible_module_nontrivial S.toRepresentation)) hz).elim

/-- The K-fixed vectors in an ambient invariant space are ambient invariant
when K is normal. -/
def normalCentralSubrepresentation (K : Subgroup G) [K.Normal]
    (I : Subrepresentation ρ) : Subrepresentation I.toRepresentation where
  toSubmodule := (fixedSpace ρ K).comap I.toSubmodule.subtype
  apply_mem_toSubmodule g v hv :=
    (fixedSpace_stable_of_normalizes ρ (show (⊤ : Subgroup G) ≤ normalizer (K : Set G)
      from le_normalizer_of_normal) (mem_top g) v.val).2 hv

/-- The ambient action on the literal quotient I / C_I(K). -/
def normalCentralQuotient (K : Subgroup G) [K.Normal]
    (I : Subrepresentation ρ) :
    Representation (ZMod 2) G (centralQuotient ρ K I.toSubmodule) :=
  (normalCentralSubrepresentation ρ K I).quotientRepresentation

/-- Restriction recovers the existing central-quotient action, on the same carrier. -/
theorem normalCentralQuotient_restrict (K : Subgroup G) [K.Normal]
    (I : Subrepresentation ρ) (hI : K ≤ subspaceStabilizer ρ I.toSubmodule) :
    (normalCentralQuotient ρ K I).comp K.subtype =
      centralQuotientRepresentation ρ K I.toSubmodule hI := rfl

/-- Inclusion of the seed followed by the actual central quotient projection. -/
def centralSeedMap (K : Subgroup G) (I S : Submodule (ZMod 2) V) (hSI : S ≤ I) :
    S →ₗ[ZMod 2] centralQuotient ρ K I :=
  ((fixedSpace ρ K).comap I.subtype).mkQ.comp (Submodule.inclusion hSI)

/-- Only the seed, rather than the whole ambient space, must avoid the center. -/
theorem centralSeedMap_injective (K : Subgroup G) (I S : Submodule (ZMod 2) V)
    (hSI : S ≤ I) (hS : Disjoint S (fixedSpace ρ K)) :
    Function.Injective (centralSeedMap ρ K I S hSI) := by
  apply (injective_iff_map_eq_zero _).mpr
  intro v hv
  apply Subtype.ext
  exact (Submodule.disjoint_def.mp hS) v v.property
    ((Submodule.Quotient.mk_eq_zero ((fixedSpace ρ K).comap I.subtype)).mp hv)

/-- The quotient projection preserves the actual seed action. -/
theorem centralSeedMap_equivariant (K P : Subgroup G) [K.Normal]
    (I : Subrepresentation ρ) (S : Subrepresentation (ρ.comp P.subtype))
    (hSI : S.toSubmodule ≤ I.toSubmodule) (p : P) (v : S.toSubmodule) :
    centralSeedMap ρ K I.toSubmodule S.toSubmodule hSI (S.toRepresentation p v) =
      normalCentralQuotient ρ K I p.val
        (centralSeedMap ρ K I.toSubmodule S.toSubmodule hSI v) := rfl

end Representation.BinaryOffender
