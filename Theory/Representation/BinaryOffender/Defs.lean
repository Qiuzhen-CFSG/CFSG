module

public import Theory.ElementaryAbelian.Basic
public import Mathlib.RepresentationTheory.Invariants
public import Mathlib.LinearAlgebra.Dimension.RankNullity
public import Mathlib.Data.Nat.Log
public import Mathlib.Data.ENNReal.Inv

/-!
# Offenders on binary representations

These are the module-theoretic definitions of Aschbacher–Smith, *The
Classification of Quasithin Groups*, §B.1, Definitions B.1.1–B.1.3 and B.1.6
(1 March 2004 manuscript). The weight is `m(A) + m(C_V(A))`; best offenders
maximize this weight among their subgroups. Minimality compares only subgroups
of equal weight, as in the source, rather than all proper subgroups.

The definitions make sense without faithfulness. Source theorems requiring a
faithful finite-dimensional representation must state those hypotheses.
-/

@[expose] public section

namespace Representation.BinaryOffender

open scoped ENNReal

variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]

/-- The nontrivial elementary abelian 2-subgroups, denoted `A²(G)` in the source. -/
def IsElementaryTwo (A : Subgroup G) : Prop :=
  A ≠ ⊥ ∧ IsElementaryAbelian 2 A

/-- The binary rank; on elementary abelian 2-groups this is their dimension. -/
noncomputable def rank (A : Subgroup G) : ℕ := Nat.log 2 (Nat.card A)

/-- The vectors fixed by the subgroup. -/
noncomputable def fixedSpace (ρ : Representation (ZMod 2) G V) (A : Subgroup G) :
    Submodule (ZMod 2) V :=
  Representation.invariants (ρ.comp A.subtype)

/-- The dimension of `V / C_V(A)`. -/
noncomputable def fixedCodim (ρ : Representation (ZMod 2) G V) (A : Subgroup G) : ℕ :=
  Module.finrank (ZMod 2) (V ⧸ fixedSpace ρ A)

/-- The quantity maximized in the definition of a best offender. -/
noncomputable def weight (ρ : Representation (ZMod 2) G V) (A : Subgroup G) : ℕ :=
  rank A + Module.finrank (ZMod 2) (fixedSpace ρ A)

/-- An offender, using the equivalent dimension inequality in B.1.2. -/
def IsOffender (ρ : Representation (ZMod 2) G V) (A : Subgroup G) : Prop :=
  IsElementaryTwo A ∧ fixedCodim ρ A ≤ rank A

/-- A strong offender has a strict dimension inequality. -/
def IsStrongOffender (ρ : Representation (ZMod 2) G V) (A : Subgroup G) : Prop :=
  IsElementaryTwo A ∧ fixedCodim ρ A < rank A

/-- An FF-module (Definition B.1.1). -/
def IsFFModule (ρ : Representation (ZMod 2) G V) : Prop := ∃ A, IsOffender ρ A

/-- A strong FF-module (Definition B.1.1). -/
def IsStrongFFModule (ρ : Representation (ZMod 2) G V) : Prop :=
  ∃ A, IsStrongOffender ρ A

/-- Membership in `P(G,V)`, called an FF-star offender in B.1.3. -/
def IsBestOffender (ρ : Representation (ZMod 2) G V) (A : Subgroup G) : Prop :=
  IsElementaryTwo A ∧ ∀ B ≤ A, weight ρ B ≤ weight ρ A

/-- The source's partial order: inclusion with equal weight. -/
def EqualWeightLE (ρ : Representation (ZMod 2) G V) (B A : Subgroup G) : Prop :=
  B ≤ A ∧ weight ρ B = weight ρ A

/-- Membership in `P*(G,V)`. -/
def IsMinimalBestOffender (ρ : Representation (ZMod 2) G V) (A : Subgroup G) : Prop :=
  IsBestOffender ρ A ∧
    ∀ B, IsBestOffender ρ B → EqualWeightLE ρ B A → B = A

/-- Quadratic action, that is, `[V,A,A] = 0`. -/
def IsQuadratic (ρ : Representation (ZMod 2) G V) (A : Subgroup G) : Prop :=
  ∀ a ∈ A, ∀ b ∈ A, ∀ v : V, ρ a (ρ b v - v) = ρ b v - v

/-- The action ratio of Definition B.1.1, with extended nonnegative values. -/
noncomputable def actionRatio (ρ : Representation (ZMod 2) G V) (A : Subgroup G) :
    ℝ≥0∞ := (fixedCodim ρ A : ℝ≥0∞) / (rank A : ℝ≥0∞)

/-- The global quadratic action ratio; an empty indexing set gives infinity. -/
noncomputable def quadraticRatio (ρ : Representation (ZMod 2) G V) : ℝ≥0∞ :=
  ⨅ (A : Subgroup G) (_ : IsElementaryTwo A ∧ IsQuadratic ρ A), actionRatio ρ A

/-- `J_P(H)`: the subgroup generated by members of `P` contained in `H`. -/
def generatedBy (P : Set (Subgroup G)) (H : Subgroup G) : Subgroup G :=
  ⨆ (A : Subgroup G) (_ : A ∈ P ∧ A ≤ H), A

/-- `J(G,V)`. -/
def offenderSubgroup (ρ : Representation (ZMod 2) G V) : Subgroup G :=
  generatedBy {A | IsBestOffender ρ A} ⊤

/-- Stability under conjugation and passage to nontrivial equal-weight subgroups. -/
def IsStable (ρ : Representation (ZMod 2) G V) (P : Set (Subgroup G)) : Prop :=
  P.Nonempty ∧ (∀ A ∈ P, IsBestOffender ρ A) ∧
    (∀ A ∈ P, ∀ g : G, A.map (MulAut.conj g).toMonoidHom ∈ P) ∧
    ∀ A ∈ P, ∀ B, IsElementaryTwo B → EqualWeightLE ρ B A → B ∈ P

end Representation.BinaryOffender
