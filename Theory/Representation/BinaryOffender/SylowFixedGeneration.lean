module
public import Theory.Representation.BinaryOffender.MovedSpaceTransport
public import Theory.Representation.BinaryOffender.SectionLinear
public import Theory.Representation.BinarySylowFixedSpace

/-!
# A central supplement for a module generated by Sylow-fixed vectors

Let a finite group be generated by a normal subgroup K and a Sylow two-subgroup P.
If a binary module is generated by translates of a P-fixed seed, it is the sum
of its K-commutator space and its globally fixed space. First the commutator space
and seed generate the module; the factorization G=KP then puts every displacement
in the commutator space. The odd-index Sylow trace supplies fixed lifts.

This is the B.2.14 step on the literal quotient module in Aschbacher--Smith,
15.3.65, printed p.1152 (combined manuscript, 1 March 2004).
-/

@[expose] public section
open Subgroup Representation Representation.BinaryOffender
namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
    (ρ : Representation (ZMod 2) G V)

theorem iSup_maps_invariant (S : Submodule (ZMod 2) V) :
    (⊤ : Subgroup G) ≤ subspaceStabilizer ρ (⨆ g : G, S.map (ρ g)) := by
  apply le_subspaceStabilizer
  intro g _ v hv
  refine Submodule.iSup_induction (fun g : G => S.map (ρ g))
    (motive := fun w => ρ g w ∈ ⨆ g : G, S.map (ρ g)) hv ?_ ?_ ?_
  · rintro h _ ⟨s, hs, rfl⟩
    exact (le_iSup (fun g : G => S.map (ρ g)) (g * h))
      ⟨s, hs, by simp only [map_mul, Module.End.mul_apply]⟩
  · simp
  · intro x y hx hy
    simpa only [map_add] using (⨆ g : G, S.map (ρ g)).add_mem hx hy

theorem le_iSup_maps (S : Submodule (ZMod 2) V) :
    S ≤ ⨆ g : G, S.map (ρ g) := by
  intro v hv
  exact (le_iSup (fun g : G => S.map (ρ g)) 1) ⟨v, hv, by simp⟩

theorem moved_sup_seed_eq_top (K : Subgroup G) [K.Normal] (P : Subgroup G)
    (hKP : K ⊔ P = ⊤) (S : Submodule (ZMod 2) V)
    (hS : S ≤ fixedSpace ρ P) (hgen : (⨆ g : G, S.map (ρ g)) = ⊤) :
    subspaceCommutator ρ ⊤ K ⊔ S = ⊤ := by
  let W := subspaceCommutator ρ ⊤ K
  have hW : (⊤ : Subgroup G) ≤ subspaceStabilizer ρ W :=
    subspaceCommutator_invariant_normalizer ρ
      (le_subspaceStabilizer ρ ⊤ (by intros; trivial)) (le_normalizer_of_normal)
  have hK : K ≤ subspaceStabilizer ρ (W ⊔ S) := by
    apply le_subspaceStabilizer
    intro k hk v hv
    obtain ⟨w, hw, s, hs, rfl⟩ := Submodule.mem_sup.mp hv
    have hd : ρ k s - s ∈ W :=
      Submodule.subset_span ⟨k, hk, s, Submodule.mem_top, rfl⟩
    have hm : ρ k s ∈ W ⊔ S := by
      simpa using (W ⊔ S).add_mem (Submodule.mem_sup_left hd) (Submodule.mem_sup_right hs)
    simpa only [map_add] using (W ⊔ S).add_mem
      (Submodule.mem_sup_left ((hW (mem_top _) w).2 hw)) hm
  have hP : P ≤ subspaceStabilizer ρ (W ⊔ S) :=
    subspaceStabilizer_sup ρ (le_top.trans hW) (le_subspaceStabilizer ρ S (by
      intro p hp s hs
      have he : ρ p s = s := hS hs ⟨p, hp⟩
      rw [he]
      exact hs))
  have hJ : (⊤ : Subgroup G) ≤ subspaceStabilizer ρ (W ⊔ S) :=
    hKP ▸ sup_le hK hP
  apply top_unique
  apply hgen.ge.trans
  apply iSup_le
  rintro g _ ⟨s, hs, rfl⟩
  exact (hJ (mem_top _) s).2 (Submodule.mem_sup_right hs)

theorem moved_sup_fixedSpace_of_sylow_fixed_generators [Finite G]
    (K : Subgroup G) [K.Normal] (P : Sylow 2 G)
    (hKP : K ⊔ (P : Subgroup G) = ⊤) (S : Submodule (ZMod 2) V)
    (hS : S ≤ fixedSpace ρ P) (hgen : (⨆ g : G, S.map (ρ g)) = ⊤) :
    subspaceCommutator ρ ⊤ K ⊔ fixedSpace ρ ⊤ = ⊤ := by
  let W := subspaceCommutator ρ ⊤ K
  have hW : (⊤ : Subgroup G) ≤ subspaceStabilizer ρ W :=
    subspaceCommutator_invariant_normalizer ρ
      (le_subspaceStabilizer ρ ⊤ (by intros; trivial)) le_normalizer_of_normal
  have hWS : W ⊔ S = ⊤ := moved_sup_seed_eq_top ρ K P hKP S hS hgen
  have hseed (g : G) (s : V) (hs : s ∈ S) : ρ g s - s ∈ W := by
    obtain ⟨k, hk, p, hp, rfl⟩ := mem_sup_of_normal_left.mp (hKP.ge (mem_top g))
    have he : ρ p s = s := hS hs ⟨p, hp⟩
    rw [map_mul, Module.End.mul_apply, he]
    exact Submodule.subset_span ⟨k, hk, s, Submodule.mem_top, rfl⟩
  have hdisp (g : G) (v : V) : ρ g v - v ∈ W := by
    obtain ⟨w, hw, s, hs, rfl⟩ := Submodule.mem_sup.mp (hWS.ge (Submodule.mem_top (x := v)))
    have hm : ρ g w - w ∈ W := W.sub_mem ((hW (mem_top g) w).2 hw) hw
    have he : ρ g (w + s) - (w + s) = (ρ g w - w) + (ρ g s - s) := by
      rw [map_add]
      abel
    rw [he]
    exact W.add_mem hm (hseed g s hs)
  have hs : S ≤ W ⊔ fixedSpace ρ ⊤ := by
    intro s hs
    obtain ⟨c, hc, hsc⟩ := BinarySylowFixedSpace.fixed_lift_mod_trivial_quotient
      ρ P W hdisp s (hS hs)
    exact Submodule.mem_sup.mpr ⟨s - c, hsc, c, fun g => hc g, sub_add_cancel s c⟩
  apply top_unique
  exact hWS.ge.trans (sup_le le_sup_left hs)
end Representation.BinaryOffender
