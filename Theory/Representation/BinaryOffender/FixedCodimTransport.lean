module

public import Theory.Representation.BinaryOffender.Stability

/-!
# Transport of stable offender families by fixed codimensions

Equal fixed-space codimensions preserve weight comparisons, even when the two
modules have different dimensions. Injective actor maps therefore preserve
best offenders; actor isomorphisms also transport stability, including its
exact equal-weight descent clause.

Source application: Aschbacher–Smith B.2.9 and B.3.2(4), used for the full
ordinary A₇ block action in Lemma 13.6.22, printed p.932.
-/

public section
open Subgroup
namespace Representation.BinaryOffender
variable {G D V W : Type*} [Group G] [Group D]
  [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
  [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]
  (ρ : Representation (ZMod 2) G V) (σ : Representation (ZMod 2) D W)

theorem weight_le_map_iff_of_fixedCodim (f : G →* D) (hf : Function.Injective f)
    (hc : ∀ A, fixedCodim ρ A = fixedCodim σ (A.map f)) (A B : Subgroup G) :
    weight σ (A.map f) ≤ weight σ (B.map f) ↔ weight ρ A ≤ weight ρ B := by
  have hA := fixedCodim_add_finrank ρ A
  have hB := fixedCodim_add_finrank ρ B
  have hAf := fixedCodim_add_finrank σ (A.map f)
  have hBf := fixedCodim_add_finrank σ (B.map f)
  have hr (C : Subgroup G) : rank (C.map f) = rank C := by
    unfold rank
    rw [card_map_of_injective hf]
  rw [hc A] at hA
  rw [hc B] at hB
  unfold weight
  rw [hr A, hr B]
  omega

theorem IsBestOffender.map_of_fixedCodim (f : G →* D) (hf : Function.Injective f)
    (hc : ∀ A, fixedCodim ρ A = fixedCodim σ (A.map f))
    {A : Subgroup G} (hA : IsBestOffender ρ A) : IsBestOffender σ (A.map f) := by
  let : IsElementaryAbelian 2 A := hA.1.2
  refine ⟨⟨fun hb => hA.1.1 ((map_eq_bot_iff_of_injective A hf).mp hb),
    IsElementaryAbelian.map f⟩, ?_⟩
  intro B hBA
  have hBm : (B.comap f).map f = B := map_comap_eq_self
    (hBA.trans (A.map_le_range f))
  have hB : B.comap f ≤ A := by
    apply (map_le_map_iff_of_injective hf).mp
    rwa [hBm]
  rw [← hBm]
  exact (weight_le_map_iff_of_fixedCodim ρ σ f hf hc _ _).mpr (hA.2 _ hB)

theorem IsStable.map_of_fixedCodim (e : G ≃* D)
    (hc : ∀ A, fixedCodim ρ A = fixedCodim σ (A.map e.toMonoidHom))
    {P : Set (Subgroup G)} (hP : IsStable ρ P) :
    IsStable σ ((Subgroup.map e.toMonoidHom) '' P) := by
  have cancel (B : Subgroup D) :
      (B.map e.symm.toMonoidHom).map e.toMonoidHom = B :=
    e.mapSubgroup.apply_symm_apply B
  refine ⟨hP.1.image _, ?_, ?_, ?_⟩
  · rintro _ ⟨A, hA, rfl⟩
    exact (hP.2.1 A hA).map_of_fixedCodim ρ σ e.toMonoidHom e.injective hc
  · rintro _ ⟨A, hA, rfl⟩ g
    refine ⟨A.map (MulAut.conj (e.symm g)).toMonoidHom,
      hP.2.2.1 A hA (e.symm g), ?_⟩
    rw [map_map, map_map]
    congr 1
    ext a
    simp [MulAut.conj_apply]
  · rintro _ ⟨A, hA, rfl⟩ B hB hBA
    let B' := B.map e.symm.toMonoidHom
    have hm : B'.map e.toMonoidHom = B := cancel B
    have hB' : IsElementaryTwo B' := by
      let : IsElementaryAbelian 2 B := hB.2
      exact ⟨fun hb => hB.1 (by rw [← hm, hb, Subgroup.map_bot]),
        IsElementaryAbelian.map _⟩
    have hle : B' ≤ A := by
      apply (map_le_map_iff_of_injective (f := e.toMonoidHom) e.injective).mp
      rw [hm]
      exact hBA.1
    have hweight : weight ρ B' = weight ρ A := by
      apply le_antisymm
      · apply (weight_le_map_iff_of_fixedCodim ρ σ e.toMonoidHom e.injective hc _ _).mp
        rw [hm, hBA.2]
      · apply (weight_le_map_iff_of_fixedCodim ρ σ e.toMonoidHom e.injective hc _ _).mp
        rw [hm, hBA.2]
    exact ⟨B', hP.2.2.2 A hA B' hB' ⟨hle, hweight⟩, hm⟩
/-- Injective actor maps transport the local subgroup generated by a family. -/
theorem generatedBy_map_injective (f : G →* D) (hf : Function.Injective f)
    (P : Set (Subgroup G)) (R : Subgroup G) :
    (generatedBy P R).map f = generatedBy ((Subgroup.map f) '' P) (R.map f) := by
  apply le_antisymm
  · rw [map_le_iff_le_comap]
    apply iSup_le
    intro A
    apply iSup_le
    rintro ⟨hA, hAR⟩
    apply map_le_iff_le_comap.mp
    exact le_iSup_of_le (A.map f) (le_iSup_of_le
      ⟨⟨A, hA, rfl⟩, map_mono hAR⟩ le_rfl)
  · apply iSup_le
    intro B
    apply iSup_le
    rintro ⟨⟨A, hA, rfl⟩, hAR⟩
    exact map_mono (le_iSup_of_le A (le_iSup_of_le
      ⟨hA, (map_le_map_iff_of_injective hf).mp hAR⟩ le_rfl))

end Representation.BinaryOffender
