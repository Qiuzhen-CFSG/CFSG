module

public import Theory.Representation.BinaryOffender.EquivariantOffender
public import Theory.Representation.BinaryOffender.Stability
public import Theory.GroupTheory.CoprimeQuotientSubgroups

/-!
# The subgroup generated by best offenders

Restriction to the subgroup generated by best offenders is again generated by
best offenders. Strong replacement shows that excluding strong offenders on
this subgroup excludes them on the whole actor. An odd action kernel then
transports this exclusion back from the faithful action image, without
identifying the original actor with that image.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, B.1.2–4,
printed p.68. These are restriction and transport facts, not classification.
-/

public section
open Subgroup
namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

/-- The literal codimension is unchanged when the actor is restricted. -/
theorem fixedCodim_subgroupOf {A H : Subgroup G} (hAH : A ≤ H) :
    fixedCodim (ρ.comp H.subtype) (A.subgroupOf H) = fixedCodim ρ A := by
  unfold fixedCodim
  rw [fixedSpace_comp_map, map_subgroupOf_eq_of_le hAH]

/-- The literal binary rank is unchanged when the actor is restricted. -/
theorem rank_subgroupOf {A H : Subgroup G} (hAH : A ≤ H) :
    rank (A.subgroupOf H) = rank A := by
  rw [← rank_map_injective H.subtype H.subtype_injective,
    map_subgroupOf_eq_of_le hAH]

/-- Restricting the ambient actor preserves ordinary offending. -/
theorem IsOffender.subgroupOf {A H : Subgroup G} (hA : IsOffender ρ A)
    (hAH : A ≤ H) : IsOffender (ρ.comp H.subtype) (A.subgroupOf H) := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let : IsElementaryAbelian 2 A := hA.1.2
  refine ⟨⟨?_, IsElementaryAbelian.subgroupOf hAH⟩, ?_⟩
  · intro hz
    apply hA.1.1
    rw [← map_subgroupOf_eq_of_le hAH, hz, Subgroup.map_bot]
  · rw [fixedCodim_subgroupOf ρ hAH, rank_subgroupOf hAH]
    exact hA.2

/-- Every best offender is contained in the subgroup it helps generate. -/
theorem IsBestOffender.le_offenderSubgroup {A : Subgroup G} (hA : IsBestOffender ρ A) :
    A ≤ offenderSubgroup ρ :=
  le_iSup_of_le A (le_iSup_of_le ⟨hA, le_top⟩ le_rfl)

/-- Bestness on a subgroup is bestness on its ambient image. -/
theorem IsBestOffender.map_subtype {H : Subgroup G} {A : Subgroup H}
    (hA : IsBestOffender (ρ.comp H.subtype) A) :
    IsBestOffender ρ (A.map H.subtype) := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let : IsElementaryAbelian 2 A := hA.1.2
  refine ⟨⟨?_, IsElementaryAbelian.map H.subtype⟩, ?_⟩
  · exact fun hz => hA.1.1
      ((A.map_eq_bot_iff_of_injective H.subtype_injective).mp hz)
  · intro B hB
    have hBH : B ≤ H := hB.trans (map_subtype_le A)
    have hBA : B.subgroupOf H ≤ A := by
      intro b hb
      obtain ⟨a, ha, he⟩ := hB hb
      exact (H.subtype_injective he) ▸ ha
    have hw := hA.2 _ hBA
    rw [weight_comp_map ρ H.subtype H.subtype_injective,
      weight_comp_map ρ H.subtype H.subtype_injective,
      map_subgroupOf_eq_of_le hBH] at hw
    exact hw

/-- Restriction to the actual offender subgroup supplies B.5.3's generation
hypothesis without assuming generation of the ambient actor. -/
theorem offenderSubgroup_restrict_eq_top :
    offenderSubgroup (ρ.comp (offenderSubgroup ρ).subtype) = ⊤ := by
  let N := offenderSubgroup ρ
  have hle : N ≤ (offenderSubgroup (ρ.comp N.subtype)).map N.subtype := by
    apply iSup_le
    intro A
    apply iSup_le
    rintro ⟨hA, _⟩
    have hAN := hA.le_offenderSubgroup ρ
    have hbest := hA.subgroupOf ρ hAN
    exact (map_subgroupOf_eq_of_le hAN).symm.le.trans
      (map_mono (hbest.le_offenderSubgroup (ρ.comp N.subtype)))
  apply top_unique
  intro x _
  obtain ⟨y, hy, he⟩ := hle x.property
  exact (N.subtype_injective he) ▸ hy

/-- An ordinary offender makes the actual offender subgroup nontrivial. -/
theorem offenderSubgroup_ne_bot_of_ff [Finite G] [FiniteDimensional (ZMod 2) V]
    (hff : IsFFModule ρ) : offenderSubgroup ρ ≠ ⊥ := by
  obtain ⟨A, hA⟩ := (isFFModule_iff_exists_bestOffender ρ).mp hff
  intro hz
  exact hA.1.1 (bot_unique (hz ▸ hA.le_offenderSubgroup ρ))

/-- Strong replacement lets a no-strong-offender bound on the actual normal
best-offender subgroup control every subgroup of the original actor. -/
theorem not_strong_of_offenderSubgroup [Finite G] [FiniteDimensional (ZMod 2) V]
    (h : ¬ IsStrongFFModule (ρ.comp (offenderSubgroup ρ).subtype)) :
    ¬ IsStrongFFModule ρ := by
  rintro ⟨A, hA⟩
  obtain ⟨B, _, hB, hstrong⟩ := hA.exists_bestOffender ρ
  have hBN := hB.le_offenderSubgroup ρ
  apply h
  refine ⟨B.subgroupOf (offenderSubgroup ρ), (hB.subgroupOf ρ hBN).1, ?_⟩
  rw [fixedCodim_subgroupOf ρ hBN, rank_subgroupOf hBN]
  exact hstrong.2

/-- Odd kernels are faithful on every elementary two-subgroup, not just on
members of a selected maximum family. -/
theorem faithful_on_elementaryTwo_of_odd_kernel [Finite G]
    (hodd : Odd (Nat.card (actionHom ρ).ker)) (A : Subgroup G)
    [IsElementaryAbelian 2 A] :
    ∀ a ∈ A, (∀ v, ρ a v = v) → a = 1 := by
  have hi := injective_comp_subtype_of_coprime_ker (actionHom ρ)
    hodd.coprime_two_left A (IsElementaryAbelian.isPGroup 2 A)
  intro a ha hfix
  have he : ((actionHom ρ).comp A.subtype) ⟨a, ha⟩ =
      ((actionHom ρ).comp A.subtype) 1 := by
    rw [map_one]
    exact (actionHom_eq_one_iff ρ a).mpr hfix
  exact congrArg Subtype.val (hi he)

/-- Ordinary offending is preserved in the faithful action image when its
kernel has odd order. -/
theorem IsOffender.actionImage_of_odd_kernel [Finite G]
    (hodd : Odd (Nat.card (actionHom ρ).ker)) {A : Subgroup G}
    (hA : IsOffender ρ A) :
    IsOffender (imageRepresentation ρ) (actionSubgroup ρ A) := by
  let : IsElementaryAbelian 2 A := hA.1.2
  have hf := faithful_on_elementaryTwo_of_odd_kernel ρ hodd A
  refine ⟨hA.1.actionSubgroup ρ hf, ?_⟩
  rw [fixedCodim_actionSubgroup, actionSubgroup_rank ρ A hf]
  exact hA.2

/-- No strong offenders on the action image implies the same for the
original actor. The odd kernel is retained, not discarded. -/
theorem not_strong_of_odd_action_kernel [Finite G]
    (hodd : Odd (Nat.card (actionHom ρ).ker))
    (h : ¬ IsStrongFFModule (imageRepresentation ρ)) : ¬ IsStrongFFModule ρ := by
  rintro ⟨A, hA⟩
  let : IsElementaryAbelian 2 A := hA.1.2
  have hf := faithful_on_elementaryTwo_of_odd_kernel ρ hodd A
  apply h
  refine ⟨actionSubgroup ρ A, hA.1.actionSubgroup ρ hf, ?_⟩
  rw [fixedCodim_actionSubgroup, actionSubgroup_rank ρ A hf]
  exact hA.2

/-- The ordinary inequality becomes the full all-subgroups weight comparison
once strong offenders have actually been excluded. -/
theorem IsOffender.isBest_of_not_strong [FiniteDimensional (ZMod 2) V]
    (h : ¬ IsStrongFFModule ρ) {A : Subgroup G} (hA : IsOffender ρ A) :
    IsBestOffender ρ A := by
  apply (isBestOffender_iff_of_not_strong ρ h A).mpr
  exact ⟨hA.1, le_antisymm hA.2 (Nat.le_of_not_gt (fun hlt => h ⟨A, hA.1, hlt⟩))⟩

end Representation.BinaryOffender
