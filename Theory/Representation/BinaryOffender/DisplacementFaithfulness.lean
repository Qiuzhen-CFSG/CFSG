module

public import Theory.Representation.BinaryOffender.ComponentDisplacement
public import Theory.GroupTheory.Commutator.AbelianOrbitCentralizer
public import Mathlib.GroupTheory.Commutator.Basic

/-!
# Faithfulness on a component orbit

If `E = [E,A]` and `V = [V,E]`, an element fixing `[V,A]` and centralizing
`E` fixes all of `V`. Indeed the operator `ρ c - 1` is fixed on the right by
`A`, commutes with `E`, and is therefore fixed by the `E`-conjugates of `A`.
These generate a subgroup containing `[E,A] = E`. The operator consequently
annihilates `[V,E] = V`, and faithfulness makes `c` trivial.

For abelian `A` and `E = ⟨L^A⟩`, centralizing `L` suffices by the orbit
centralizer lemma. This proves the linear-algebra step of GLS vol. 2,
Theorem 26.24, Step 3. The hypotheses `E = [E,A]` and `V = [V,E]` remain
explicit; the reduction to them belongs to the component-normalization proof.
-/

public section
namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

private def rightFixer (f : V →ₗ[ZMod 2] V) : Subgroup G where
  carrier := {g | ∀ v, f (ρ g v) = f v}
  one_mem' := by simp
  mul_mem' := by
    intro a b ha hb v
    rw [map_mul]
    exact (ha (ρ b v)).trans (hb v)
  inv_mem' := by
    intro a ha v
    have h := ha (ρ a⁻¹ v)
    have he : ρ a (ρ a⁻¹ v) = v := by
      change (ρ a * ρ a⁻¹) v = v
      rw [← map_mul, mul_inv_cancel, map_one]
      rfl
    rwa [he, eq_comm] at h

/-- The displacement centralizer meets the centralizer of a commutator-
generated actor trivially on a faithful module generated by its displacements. -/
theorem displacementCentralizer_inf_centralizer_eq_bot {A E : Subgroup G} (hρ : Function.Injective ρ)
    (hEA : ⁅E, A⁆ = E)
    (hV : Submodule.span (ZMod 2)
      (Set.range fun ev : E × V => ρ ev.1 ev.2 - ev.2) = ⊤) :
    displacementCentralizer ρ A ⊓ Subgroup.centralizer (E : Set G) = ⊥ := by
  apply le_antisymm ?_ bot_le
  intro c hc
  let f : V →ₗ[ZMod 2] V := ρ c - LinearMap.id
  have hfA : A ≤ rightFixer ρ f := by
    intro a ha v
    have h := hc.1.2 a ha v
    simp only [map_sub] at h
    change ρ c (ρ a v) - ρ a v = ρ c v - v
    rw [sub_eq_sub_iff_add_eq_add] at h ⊢
    simpa [add_comm] using h
  have hfE (e : G) (he : e ∈ E) (v : V) : f (ρ e v) = ρ e (f v) := by
    change ρ c (ρ e v) - ρ e v = ρ e (ρ c v - v)
    rw [map_sub]
    have hh := congrArg (fun g : G => ρ g v) (hc.2 e he)
    simpa only [map_mul, Module.End.mul_apply] using congrArg (fun w : V => w - ρ e v) hh.symm
  have hconj : (⨆ e : E, A.map (MulAut.conj (e : G)).toMonoidHom : Subgroup G) ≤
      rightFixer ρ f := by
    refine iSup_le fun e => ?_
    rintro _ ⟨a, ha, rfl⟩ v
    change f (ρ ((e : G) * a * (e : G)⁻¹) v) = f v
    simp only [map_mul, Module.End.mul_apply]
    rw [hfE _ e.property, hfA ha, hfE _ (E.inv_mem e.property)]
    change (ρ (e : G) * ρ (e : G)⁻¹) (f v) = f v
    rw [← map_mul, mul_inv_cancel, map_one]
    rfl
  have hAjoin : A ≤ ⨆ e : E, A.map (MulAut.conj (e : G)).toMonoidHom := by
    intro a ha
    apply (le_iSup (fun e : E => A.map (MulAut.conj (e : G)).toMonoidHom) 1)
    exact ⟨a, ha, by simp⟩
  have hEjoin : E ≤ ⨆ e : E, A.map (MulAut.conj (e : G)).toMonoidHom := by
    apply le_trans (le_of_eq hEA.symm)
    apply Subgroup.commutator_le.mpr
    intro e he a ha
    exact Subgroup.mul_mem _
      ((le_iSup (fun e : E => A.map (MulAut.conj (e : G)).toMonoidHom) ⟨e, he⟩)
        (Subgroup.mem_map_of_mem _ ha))
      (Subgroup.inv_mem _ (hAjoin ha))
  have hfker : Submodule.span (ZMod 2)
      (Set.range fun ev : E × V => ρ ev.1 ev.2 - ev.2) ≤ f.ker := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨e, v⟩, rfl⟩
    change f (ρ (e : G) v - v) = 0
    rw [map_sub]
    exact sub_eq_zero.mpr (hconj (hEjoin e.property) v)
  have hfzero : f = 0 := by
    apply LinearMap.ext
    intro v
    exact LinearMap.mem_ker.mp (hfker (hV ▸ Submodule.mem_top))
  apply Subgroup.mem_bot.mpr
  apply hρ
  rw [map_one]
  apply LinearMap.ext
  intro v
  have h := LinearMap.congr_fun hfzero v
  exact sub_eq_zero.mp h

/-- Step 3 specialized to an abelian orbit of `L`. All structural and
module-generation premises are explicit. -/
theorem displacementCentralizer_inf_centralizer_orbit_eq_bot
    (A L : Subgroup G) [IsMulCommutative A] (hρ : Function.Injective ρ)
    (hEA : ⁅(⨆ a : A, L.map (MulAut.conj (a : G)).toMonoidHom), A⁆ =
      ⨆ a : A, L.map (MulAut.conj (a : G)).toMonoidHom)
    (hV : Submodule.span (ZMod 2)
      (Set.range fun ev : (⨆ a : A, L.map (MulAut.conj (a : G)).toMonoidHom :
        Subgroup G) × V => ρ ev.1 ev.2 - ev.2) = ⊤) :
    displacementCentralizer ρ A ⊓ Subgroup.centralizer (L : Set G) = ⊥ := by
  rw [← Subgroup.inf_centralizer_iSup_conjugates_of_abelian A
    (displacementCentralizer ρ A) L (displacementCentralizer_le ρ A)]
  exact displacementCentralizer_inf_centralizer_eq_bot ρ hρ hEA hV

end Representation.BinaryOffender
