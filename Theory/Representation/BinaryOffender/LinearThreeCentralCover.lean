module
public import Theory.Representation.BinaryOffender.Homogeneous.Basic
public import Theory.Representation.SLThreeCentralExtension

/-!
# The size of a natural binary-three central cover

A member of Irr⁺ is generated by its own component commutators. Its
marked natural central quotient is therefore a genuine central cover.
Reindex that original action by the supplied SL₃(2) isomorphism and apply
the computed one-dimensional dual first cohomology. The covering kernel
is the literal fixed subspace; it is retained in the dimension identity.

Source: Aschbacher--Smith I.1.5--6, printed p.408, and the central-cover
step in 14.6.22, printed p.1038. The conclusion permits dimension four;
excluding that extension requires additional ambient information.
-/

public noncomputable section
open Representation Representation.OneCohomology
namespace Representation.BinaryOffender
variable {D V : Type*} [Group D] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) D V) (K : Subgroup D)
  {I : Submodule (ZMod 2) V} (hI : IsIrrPlus ρ K I)
  (j : K ≃* BinaryLinearThree.Group)
  (l : centralQuotient ρ K I ≃ₗ[ZMod 2] (Fin 3 → ZMod 2))
  (he : ∀ k v, l (centralQuotientRepresentation ρ K I hI.choose k v) =
    BinaryLinearThree.W (j k) (l v))

private def linearThreeCoverAction : Representation (ZMod 2) BinaryLinearThree.Group I :=
  (invariantSubspace ρ K I hI.choose).toRepresentation.comp j.symm.toMonoidHom

private def linearThreeCoverProjection :
    (linearThreeCoverAction ρ K hI j).IntertwiningMap BinaryLinearThree.W :=
  (l.toLinearMap.comp ((fixedSpace ρ K).comap I.subtype).mkQ).intertwiningMap_of_isIntertwiningMap
    _ _ (by
      intro g v
      have hh := he (j.symm g) (Submodule.Quotient.mk v)
      exact hh.trans (congrArg
        (fun k => BinaryLinearThree.W k (l (Submodule.Quotient.mk v))) (j.apply_symm_apply g)))

private theorem linearThreeCoverProjection_kernel :
    (linearThreeCoverProjection ρ K hI j l he).toLinearMap.ker =
      (fixedSpace ρ K).comap I.subtype := by
  ext v
  change l (((fixedSpace ρ K).comap I.subtype).mkQ v) = 0 ↔ _
  rw [l.map_eq_zero_iff]
  exact Submodule.Quotient.mk_eq_zero _

private theorem linearThreeCoverProjection_isCover :
    IsCover (linearThreeCoverProjection ρ K hI j l he) := by
  refine ⟨l.surjective.comp (Submodule.mkQ_surjective _), ?_, ?_⟩
  · rw [linearThreeCoverProjection_kernel]
    intro v hv g
    exact Subtype.ext (hv (j.symm g))
  · let τ := linearThreeCoverAction ρ K hI j
    have hm : I ≤ (Coinvariants.ker τ).map I.subtype := by
      conv_lhs => rw [← hI.choose_spec.1]
      apply Submodule.span_le.mpr
      rintro _ ⟨g,hg,v,hv,rfl⟩
      refine ⟨τ (j ⟨g,hg⟩) ⟨v,hv⟩ - ⟨v,hv⟩,
        Coinvariants.sub_mem_ker _ _, ?_⟩
      change ρ (j.symm (j ⟨g,hg⟩)) v - v = ρ g v - v
      rw [j.symm_apply_apply]
    apply top_unique
    intro v _
    obtain ⟨w,hw,heq⟩ := hm v.property
    rwa [show w = v from Subtype.ext heq] at hw

include hI j l he in
/-- A marked natural central quotient has a fixed kernel of dimension at
most one, and the original Irr⁺ space has dimension three or four. -/
theorem IsIrrPlus.finrank_of_linear_three_central_quotient
    [FiniteDimensional (ZMod 2) V] :
    Module.finrank (ZMod 2) ((fixedSpace ρ K).comap I.subtype) ≤ 1 ∧
      Module.finrank (ZMod 2) I =
        3 + Module.finrank (ZMod 2) ((fixedSpace ρ K).comap I.subtype) ∧
      (Module.finrank (ZMod 2) I = 3 ∨ Module.finrank (ZMod 2) I = 4) := by
  let p := linearThreeCoverProjection ρ K hI j l he
  have hk := finrank_ker_le_H1_of_cover p (linearThreeCoverProjection_isCover ρ K hI j l he)
  rw [SLThreeCentralExtension.finrank_H1_dual, linearThreeCoverProjection_kernel] at hk
  have hd := p.toLinearMap.finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr (linearThreeCoverProjection_isCover ρ K hI j l he).1,
    finrank_top, Module.finrank_fin_fun, linearThreeCoverProjection_kernel] at hd
  exact ⟨hk, hd.symm, by omega⟩

end Representation.BinaryOffender
