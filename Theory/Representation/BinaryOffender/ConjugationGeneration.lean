module

public import Theory.Representation.BinaryOffender.SubspaceAction
public import Mathlib.GroupTheory.Commutator.Basic

/-!
# Group commutators generate the literal quotient representation

A surjective map from U onto an abelian group carries conjugation by K to
a specified linear representation. If U=[K,U], the linear representation is
generated by its displacements under the actual image of K. Pull the linear
commutator space back to U and check the generators of [K,U]. No faithful
or irreducible action, and no splitting of the quotient, is required.

This is the group-to-module transport used in Aschbacher–Smith,
13.8.20–21, printed pp.955–957, combined manuscript of 1 March 2004.
-/

public section
open scoped IsMulCommutative commutatorElement
namespace Representation.BinaryOffender
open Subgroup
variable {A D Q : Type*} [Group A] [Group D] [Group Q] [IsMulCommutative Q]
  [Module (ZMod 2) (Additive Q)]

/-- Full group commutator generation descends through a surjective conjugation map. -/
theorem commutator_eq_top_of_conjugation
    (ρ : Representation (ZMod 2) D (Additive Q)) (U K : Subgroup A)
    (hn : K ≤ normalizer (U : Set A))
    (f : K →* D) (q : U →* Q) (hq : Function.Surjective q)
    (hact : ∀ (k : K) (u : U), ρ (f k) (Additive.ofMul (q u)) =
      Additive.ofMul (q ⟨(k : A) * u * (k : A)⁻¹,
        le_normalizer_iff.mp hn k k.property u u.property⟩))
    (hgen : ⁅K, U⁆ = U) : subspaceCommutator ρ ⊤ f.range = ⊤ := by
  let C := subspaceCommutator ρ ⊤ f.range
  let J : Subgroup U := (Subgroup.toAddSubgroup.symm C.toAddSubgroup).comap q
  let B : Subgroup A := J.map U.subtype
  have hcomm : ⁅K, U⁆ ≤ B := by
    apply commutator_le.mpr
    intro k hk u hu
    let kK : K := ⟨k, hk⟩
    let uU : U := ⟨u, hu⟩
    let c : U := ⟨k * u * k⁻¹, le_normalizer_iff.mp hn k hk u hu⟩
    refine ⟨c * uU⁻¹, ?_, rfl⟩
    have hd : ρ (f kK) (Additive.ofMul (q uU)) - Additive.ofMul (q uU) ∈ C :=
      Submodule.subset_span ⟨_, ⟨kK, rfl⟩, _, Submodule.mem_top, rfl⟩
    rw [hact] at hd
    change Additive.ofMul (q (c * uU⁻¹)) ∈ C
    rw [map_mul, map_inv]
    change Additive.ofMul (q c) + -Additive.ofMul (q uU) ∈ C
    simpa only [sub_eq_add_neg] using hd
  have hUB : U ≤ B := hgen ▸ hcomm
  apply top_unique
  intro v _
  obtain ⟨u, hu⟩ := hq v.toMul
  obtain ⟨w, hw, hwu⟩ := hUB u.property
  have he : w = u := Subtype.ext hwu
  subst w
  change Additive.ofMul (q u) ∈ C at hw
  simpa [hu] using hw

end Representation.BinaryOffender
