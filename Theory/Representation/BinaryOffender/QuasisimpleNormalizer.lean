module

public import Theory.Representation.BinaryOffender.NormalizerExtension
public import Theory.Representation.BinaryOffender.GeneratedCore
public import Theory.Representation.NormalPSubgroupKernel
public import Theory.Representation.Quotient
public import Theory.GroupTheory.GeneralizedFitting.QuasisimpleTwoQuotient
public import Theory.GroupTheory.PerfectCentralCoverQuasisimple

/-!
# An offender supplement of a quasisimple action image

Let a quasisimple group act irreducibly on a finite binary vector space with
central kernel. For an elementary two-subgroup A of its full linear normalizer,
form the join of the action image and A inside the actual invertible operators.
The image is normal and quasisimple in this join. Irreducibility kills the
join's two-core; its two-group quotient then identifies its generalized Fitting
subgroup with the image. If A offends, the same operators still offend in the join.

The perfect central cover to the image retains the original representation.
Its induced equivalence of central quotients is the bridge to model catalogues.
No generalized-Fitting assertion about the full linear normalizer, absolute
irreducibility, or representation classification is assumed or proved here.

Source application: Aschbacher–Smith B.1.11–13, printed pp.72–74, and the
quasisimple-F* hypotheses in Guralnick–Malle, *Classification of 2F-modules*, I–II.
-/

@[expose] public section

open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender

namespace Representation.BinaryOffender.QuasisimpleNormalizer

variable {L W : Type*} [Group L] [AddCommGroup W] [Module (ZMod 2) W]

/-- The tautological action of a subgroup of the invertible binary operators. -/
def linearAction (H : Subgroup (Module.End (ZMod 2) W)ˣ) :
    Representation (ZMod 2) H W := (Units.coeHom _).comp H.subtype

/-- The tautological action retains each operator, hence is faithful. -/
theorem linearAction_injective (H : Subgroup (Module.End (ZMod 2) W)ˣ) :
    Function.Injective (linearAction H) := by
  intro x y h
  exact Subtype.ext (Units.ext h)

variable (σ : Representation (ZMod 2) L W)

/-- The subgroup generated by the component image and the chosen normalizer actor. -/
def supplement (A : Subgroup (linearNormalizer σ)) :
    Subgroup (Module.End (ZMod 2) W)ˣ :=
  actionImage σ ⊔ A.map (linearNormalizer σ).subtype

/-- The actual action image inside its offender supplement. -/
def component (A : Subgroup (linearNormalizer σ)) : Subgroup (supplement σ A) :=
  (actionImage σ).subgroupOf (supplement σ A)

/-- The original action homomorphism, with codomain its image in the supplement. -/
def projection (A : Subgroup (linearNormalizer σ)) : L →* component σ A :=
  (subgroupOfEquivOfLe (show actionImage σ ≤ supplement σ A from le_sup_left)).symm.toMonoidHom.comp
    (actionHom σ)

/-- Every operator in the component comes from the original group. -/
theorem projection_surjective (A : Subgroup (linearNormalizer σ)) :
    Function.Surjective (projection σ A) :=
  (subgroupOfEquivOfLe (show actionImage σ ≤ supplement σ A from le_sup_left)).symm.surjective.comp
    σ.asGroupHom.rangeRestrict_surjective

/-- Projection and inclusion recover precisely the original operator. -/
@[simp] theorem projection_action (A : Subgroup (linearNormalizer σ)) (l : L) :
    linearAction (supplement σ A) ((projection σ A l : component σ A) : supplement σ A) =
      σ l := rfl

/-- Normality is relative to the generated supplement. -/
theorem component_normal (A : Subgroup (linearNormalizer σ)) :
    (component σ A).Normal := by
  apply (normal_subgroupOf_iff_le_normalizer le_sup_left).mpr
  exact sup_le le_normalizer (by
    rintro x ⟨a, _, rfl⟩
    exact a.property)

/-- A central action kernel cannot kill a quasisimple group. -/
theorem component_nontrivial [IsQuasisimple L]
    (hk : σ.ker ≤ center L) (A : Subgroup (linearNormalizer σ)) :
    Nontrivial (component σ A) := by
  let : IsSimpleGroup (L ⧸ center L) := IsQuasisimple.simple
  let : Nontrivial L := (QuotientGroup.mk'_surjective (center L)).nontrivial
  by_contra hn
  let : Subsingleton (component σ A) := not_nontrivial_iff_subsingleton.mp hn
  have hc : center L = ⊤ := by
    apply top_unique
    intro l _
    apply hk
    change σ l = 1
    have he := congrArg (fun k : component σ A => linearAction (supplement σ A) k)
      (Subsingleton.elim (projection σ A l) 1)
    simpa only [projection_action, OneMemClass.coe_one, map_one] using he
  exact Group.IsPerfect.not_isMulCommutative L (center_eq_top_iff.mp hc)

/-- The original group perfectly and centrally covers its actual action image. -/
def cover [IsQuasisimple L] (hk : σ.ker ≤ center L)
    (A : Subgroup (linearNormalizer σ)) :
    PerfectCentralCovering.Cover L (component σ A) where
  toMonoidHom := projection σ A
  surjective := projection_surjective σ A
  isPerfect := inferInstance
  ker_le_center := by
    intro l hl
    apply hk
    change σ l = 1
    have he := congrArg (fun k : component σ A => linearAction (supplement σ A) k) hl
    simpa only [projection_action, OneMemClass.coe_one, map_one] using he

/-- The induced central-quotient equivalence uses the original projection. -/
@[simp] theorem cover_quotientCenterEquiv_apply [IsQuasisimple L]
    (hk : σ.ker ≤ center L) (A : Subgroup (linearNormalizer σ)) (l : L) :
    (cover σ hk A).quotientCenterEquiv (QuotientGroup.mk l) =
      QuotientGroup.mk (projection σ A l) := rfl

/-- The nontrivial image remains quasisimple. -/
theorem component_quasisimple [IsQuasisimple L]
    (hk : σ.ker ≤ center L) (A : Subgroup (linearNormalizer σ)) :
    IsQuasisimple (component σ A) := by
  let := component_nontrivial σ hk A
  exact IsQuasisimple.of_surjective (projection σ A) (projection_surjective σ A)

private theorem irreducible_of_pullback {D E : Type*} [Group D] [Group E]
    (τ : Representation (ZMod 2) D W) (f : E →* D)
    [IsIrreducible (τ.comp f)] : IsIrreducible τ := by
  let : Nontrivial W := Subrepresentation.irreducible_module_nontrivial (τ.comp f)
  rw [IsIrreducible, isSimpleOrder_iff]
  refine ⟨inferInstance, fun S => ?_⟩
  let T : Subrepresentation (τ.comp f) :=
    ⟨S.toSubmodule, fun e _ hv => S.apply_mem_toSubmodule (f e) hv⟩
  rcases eq_bot_or_eq_top T with h | h
  · left
    apply Subrepresentation.toSubmodule_injective
    exact congrArg (fun U : Subrepresentation (τ.comp f) => U.toSubmodule) h
  · right
    apply Subrepresentation.toSubmodule_injective
    exact congrArg (fun U : Subrepresentation (τ.comp f) => U.toSubmodule) h

/-- Surjective passage to the image preserves irreducibility on the same space. -/
theorem component_irreducible [IsIrreducible σ] (A : Subgroup (linearNormalizer σ)) :
    IsIrreducible ((linearAction (supplement σ A)).comp (component σ A).subtype) := by
  apply (irreducible_comp_surjective_iff (projection σ A) (projection_surjective σ A) _).mp
  exact (inferInstance : IsIrreducible σ)

/-- Every supplement-invariant subspace is already component-invariant. -/
theorem supplement_irreducible [IsIrreducible σ] (A : Subgroup (linearNormalizer σ)) :
    IsIrreducible (linearAction (supplement σ A)) := by
  let := component_irreducible σ A
  exact irreducible_of_pullback _ (component σ A).subtype

/-- The supplement embeds in the finite set of maps on the binary space. -/
theorem supplement_finite [FiniteDimensional (ZMod 2) W]
    (A : Subgroup (linearNormalizer σ)) : Finite (supplement σ A) := by
  let : Finite W := Module.finite_of_finite (ZMod 2)
  exact Finite.of_injective (fun g : supplement σ A =>
    (linearAction (supplement σ A) g : W → W))
    (DFunLike.coe_injective.comp (linearAction_injective _))

/-- A faithful irreducible binary action has trivial normal two-core. -/
theorem supplement_twoCore [FiniteDimensional (ZMod 2) W] [IsIrreducible σ]
    (A : Subgroup (linearNormalizer σ)) : pCore 2 (supplement σ A) = ⊥ := by
  let := supplement_finite σ A
  let := supplement_irreducible σ A
  exact le_bot_iff.mp ((normal_p_subgroup_le_ker (linearAction (supplement σ A))
    (pCore 2 (supplement σ A)) pCore_isPGroup).trans
      ((MonoidHom.ker_eq_bot_iff _).mpr (linearAction_injective _)).le)

/-- The image is all of F*: the quotient is a two-group and the two-core is trivial. -/
theorem supplement_fitting [FiniteDimensional (ZMod 2) W] [IsIrreducible σ]
    [IsQuasisimple L] (hk : σ.ker ≤ center L)
    (A : Subgroup (linearNormalizer σ)) (hA : IsElementaryAbelian 2 A) :
    generalizedFitting (supplement σ A) = component σ A := by
  let := supplement_finite σ A
  let := component_normal σ A
  let := component_quasisimple σ hk A
  let := hA
  let B := A.map (linearNormalizer σ).subtype
  have hb : IsPGroup 2 (B.subgroupOf (supplement σ A)) := by
    exact (IsElementaryAbelian.isPGroup (p := 2) (G := A)).map _ |>.comap_subtype
  have hq : IsPGroup 2 (supplement σ A ⧸ component σ A) :=
    quotient_isPGroup_of_sup_eq_top (B.subgroupOf (supplement σ A)) (component σ A) hb
      (by rw [sup_comm]; exact (codisjoint_subgroupOf_sup (actionImage σ) B).eq_top)
  exact generalizedFitting_eq_of_quasisimple_two_quotient _ hq (supplement_twoCore σ A)

/-- The same offender operators give the FF property in the generated supplement. -/
theorem supplement_ff (A : Subgroup (linearNormalizer σ))
    (hA : IsOffender (normalizerRepresentation σ) A) :
    IsFFModule (linearAction (supplement σ A)) := by
  let j : A →* supplement σ A :=
    (Subgroup.inclusion (show A.map (linearNormalizer σ).subtype ≤ supplement σ A from
      le_sup_right)).comp ((linearNormalizer σ).subtype.subgroupMap A)
  have hj : Function.Injective j := by
    intro a b he
    apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun x : supplement σ A => (x : (Module.End (ZMod 2) W)ˣ)) he
  have ha : IsOffender ((normalizerRepresentation σ).comp A.subtype) ⊤ := by
    simpa only [subgroupOf_self] using hA.subgroupOf (normalizerRepresentation σ) le_rfl
  exact ⟨(⊤ : Subgroup A).map j,
    ha.map_equivariant _ _ j hj (LinearEquiv.refl _ _) (fun _ _ => rfl)⟩

end Representation.BinaryOffender.QuasisimpleNormalizer
