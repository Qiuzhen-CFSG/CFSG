module
public import Theory.Representation.BinaryOffender.Homogeneous.Basic
public import Theory.Representation.BinaryPermutationSixCover.Facts
public import Theory.Representation.FirstCohomologyDuality.Indecomposable

/-!
# The original natural binary A₆ central cover

An Irr⁺ support is generated by component commutators. Its literal
projection to the quotient by fixed vectors, followed by the supplied
natural marking, is therefore a central cover. The computed dual H¹ has
dimension one: the original support has dimension four or five. The fixed
kernel is retained, and all maps use the supplied A₆ marking.
Source: Aschbacher--Smith I.1.5--6 and14.6.22, printed pp.408,1038.
-/

public noncomputable section
open Representation Representation.OneCohomology
namespace Representation.BinaryOffender
variable {D V : Type*} [Group D] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) D V) (K : Subgroup D)
  {I : Submodule (ZMod 2) V} (hI : IsIrrPlus ρ K I)
  (j : K ≃* alternatingGroup (Fin 6))
  (l : centralQuotient ρ K I ≃ₗ[ZMod 2] BinaryPermutation.natural (Fin 6))
  (he : ∀ k v, l (centralQuotientRepresentation ρ K I hI.choose k v) =
    BinaryPermutation.alternatingNaturalRepresentation (Ω := Fin 6) (j k) (l v))

@[expose] def alternatingSixCoverAction : Representation (ZMod 2) (alternatingGroup (Fin 6)) I :=
  (invariantSubspace ρ K I hI.choose).toRepresentation.comp j.symm.toMonoidHom

@[expose] def alternatingSixCoverProjection :
    (alternatingSixCoverAction ρ K hI j).IntertwiningMap (BinaryPermutation.alternatingNaturalRepresentation (Ω := Fin 6)) :=
  (l.toLinearMap.comp ((fixedSpace ρ K).comap I.subtype).mkQ).intertwiningMap_of_isIntertwiningMap
    _ _ (by
      intro g v
      have hh := he (j.symm g) (Submodule.Quotient.mk v)
      exact hh.trans (congrArg
        (fun k => BinaryPermutation.alternatingNaturalRepresentation (Ω := Fin 6) k (l (Submodule.Quotient.mk v))) (j.apply_symm_apply g)))

theorem alternatingSixCoverProjection_kernel :
    (alternatingSixCoverProjection ρ K hI j l he).toLinearMap.ker =
      (fixedSpace ρ K).comap I.subtype := by
  ext v
  change l (((fixedSpace ρ K).comap I.subtype).mkQ v) = 0 ↔ _
  rw [l.map_eq_zero_iff]
  exact Submodule.Quotient.mk_eq_zero _

theorem alternatingSixCoverProjection_isCover :
    IsCover (alternatingSixCoverProjection ρ K hI j l he) := by
  refine ⟨l.surjective.comp (Submodule.mkQ_surjective _), ?_, ?_⟩
  · rw [alternatingSixCoverProjection_kernel]
    intro v hv g
    exact Subtype.ext (hv (j.symm g))
  · let τ := alternatingSixCoverAction ρ K hI j
    have hm : I ≤ (Coinvariants.ker τ).map I.subtype := by
      conv_lhs => rw [← hI.choose_spec.1]
      apply Submodule.span_le.mpr
      rintro _ ⟨g,hg,v,hv,rfl⟩
      refine ⟨τ (j ⟨g,hg⟩) ⟨v,hv⟩ - ⟨v,hv⟩,
        Coinvariants.sub_mem_ker _ _, ?_⟩
      change ρ (j.symm (j ⟨g,hg⟩)) v - v = ρ g v - v
      rw [j.symm_apply_apply]
    apply top_unique
    intro v _
    obtain ⟨w,hw,heq⟩ := hm v.property
    rwa [show w = v from Subtype.ext heq] at hw

include hI j l he in
/-- A marked natural central quotient has a fixed kernel of dimension at
most one, and the original Irr⁺ space has dimension four or five. -/
theorem IsIrrPlus.finrank_of_alternating_six_central_quotient
    [FiniteDimensional (ZMod 2) V] :
    Module.finrank (ZMod 2) ((fixedSpace ρ K).comap I.subtype) ≤ 1 ∧
      Module.finrank (ZMod 2) I =
        4 + Module.finrank (ZMod 2) ((fixedSpace ρ K).comap I.subtype) ∧
      (Module.finrank (ZMod 2) I = 4 ∨ Module.finrank (ZMod 2) I = 5) := by
  let p := alternatingSixCoverProjection ρ K hI j l he
  have hk := finrank_ker_le_H1_of_cover p (alternatingSixCoverProjection_isCover ρ K hI j l he)
  rw [BinaryPermutation.alternatingSix_natural_dual_finrank_H1, alternatingSixCoverProjection_kernel] at hk
  have hn : Module.finrank (ZMod 2) (BinaryPermutation.natural (Fin 6)) = 4 := by
    rw [BinaryPermutation.finrank_natural_even (Fin 6) (by decide)]
    rfl
  have hd := p.toLinearMap.finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr (alternatingSixCoverProjection_isCover ρ K hI j l he).1,
    finrank_top, hn, alternatingSixCoverProjection_kernel] at hd
  exact ⟨hk, hd.symm, by omega⟩

end Representation.BinaryOffender
