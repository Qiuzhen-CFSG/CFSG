module
public import Theory.Representation.BinaryOffender.Homogeneous.Selection.IsotypicQuotient
public import Theory.Representation.NormalSemisimpleSpan
public import Theory.Representation.Quotient

/-!
# Two invariant copies of an isotypic binary type

A finite two-group fixes a simple copy in a nonzero isotypic binary module.
If that normal-subgroup restriction is reducible, the same selection in the
quotient produces a second simple section. The selected copies extend to
representations of the group generated by the normal subgroup and the
two-group, so the actual elementary actor is retained in both sections.

Source: Aschbacher–Smith A.1.42 and D.3.9(1), printed pp.32 and 199–200.
The source application is the full-quotient local type in
Chapter10.SourceA5FullTensorPassage.FaithfulSections.
-/

@[expose] public noncomputable section
open scoped MonoidAlgebra
namespace Representation.BinaryOffender.Homogeneous
variable {G K V : Type*} [Group G] [Group K] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

theorem isotypic_comp_equiv (e : K ≃* G) (S : Subrepresentation ρ)
    (htype : IsIsotypicOfType (ZMod 2)[G] ρ.asModule S.asSubmodule) :
    IsIsotypicOfType (ZMod 2)[K] (Representation.asModule (ρ.comp e.toMonoidHom))
      (S.compActors e.toMonoidHom).asSubmodule := by
  intro B hB
  let U := Subrepresentation.ofSubmodule' B
  let U0 : Subrepresentation ρ := {
    toSubmodule := U.toSubmodule
    apply_mem_toSubmodule g v hv := by
      simpa only [MonoidHom.comp_apply,MulEquiv.coe_toMonoidHom,e.apply_symm_apply]
        using U.apply_mem_toSubmodule (e.symm g) hv }
  have hU : U.toRepresentation.IsIrreducible := by
    rw [Subrepresentation.irreducible_iff_isAtom]
    exact Subrepresentation.subrepresentationSubmoduleOrderIso.isAtom_iff U |>.mp
      (isSimpleModule_iff_isAtom.mp hB)
  have hU0 : U0.toRepresentation.IsIrreducible :=
    (irreducible_comp_surjective_iff e.toMonoidHom e.surjective U0.toRepresentation).mp hU
  let := simple_asSubmodule U0 hU0
  obtain ⟨f,hf⟩ := (sameModule_iff_linearEquiv U0 S).mpr (htype U0.asSubmodule)
  exact (sameModule_iff_linearEquiv U (S.compActors e.toMonoidHom)).mp
    ⟨f,fun g v => hf (e g) v⟩
end Representation.BinaryOffender.Homogeneous

open scoped MonoidAlgebra
open Subgroup
namespace Representation.BinaryOffender.Homogeneous
variable {G V E : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V) (N : Subgroup G) [N.Normal]
  [AddCommGroup E] [Module (ZMod 2)[N] E]

def extend_fixed_copy (P : Subgroup G) (hgen : N ⊔ P = ⊤)
    (U : Subrepresentation (ρ.comp N.subtype))
    (hfix : ∀ p : P, U.toSubmodule.map (ρ p) = U.toSubmodule) : Subrepresentation ρ where
  toSubmodule := U.toSubmodule
  apply_mem_toSubmodule g v hv := by
    have hN : N ≤ subspaceStabilizer ρ U.toSubmodule := le_subspaceStabilizer ρ _
      (fun n hn v hv => U.apply_mem_toSubmodule ⟨n,hn⟩ hv)
    have hP : P ≤ subspaceStabilizer ρ U.toSubmodule := by
      intro p hp
      exact (subspace_map_eq_iff ρ U.toSubmodule p).mp (hfix ⟨p,hp⟩)
    have hG : (⊤ : Subgroup G) ≤ subspaceStabilizer ρ U.toSubmodule :=
      hgen ▸ sup_le hN hP
    exact (hG (mem_top g) v).mpr hv

theorem exists_simple_section_of_isotypic [Finite V] [Nontrivial V]
    [IsSemisimpleModule (ZMod 2)[N] (Representation.asModule (ρ.comp N.subtype))]
    (htype : IsIsotypicOfType (ZMod 2)[N] (Representation.asModule (ρ.comp N.subtype)) E)
    (P : Subgroup G) (hP : IsPGroup 2 P) (hgen : N ⊔ P = ⊤) :
    ∃ U : Subrepresentation ρ,
      (Representation.IsIrreducible (U.toRepresentation.comp N.subtype)) ∧
      Nonempty ((Subrepresentation.compActors U N.subtype).asSubmodule ≃ₗ[(ZMod 2)[N]] E) := by
  obtain ⟨U,hu,he,hfix⟩ := exists_invariant_simple_of_isotypic ρ N htype P hP
  exact ⟨extend_fixed_copy ρ N P hgen U hfix,hu,he⟩

theorem exists_two_simple_sections_of_isotypic [Finite V] [Nontrivial V]
    [IsSemisimpleModule (ZMod 2)[N] (Representation.asModule (ρ.comp N.subtype))]
    (htype : IsIsotypicOfType (ZMod 2)[N] (Representation.asModule (ρ.comp N.subtype)) E)
    (P : Subgroup G) (hP : IsPGroup 2 P) (hgen : N ⊔ P = ⊤)
    (hred : ¬ Representation.IsIrreducible (ρ.comp N.subtype)) :
    ∃ (U : Subrepresentation ρ) (W : Subrepresentation U.quotientRepresentation),
      Representation.IsIrreducible (U.toRepresentation.comp N.subtype) ∧
      Representation.IsIrreducible (W.toRepresentation.comp N.subtype) ∧
      Nonempty ((U.compActors N.subtype).asSubmodule ≃ₗ[(ZMod 2)[N]] E) ∧
      Nonempty ((W.compActors N.subtype).asSubmodule ≃ₗ[(ZMod 2)[N]] E) := by
  obtain ⟨U,hu,he⟩ := exists_simple_section_of_isotypic ρ N htype P hP hgen
  have hU : U.toSubmodule ≠ ⊤ := by
    intro ht
    apply hred
    apply isSimpleOrder_iff_isAtom_top.mpr
    have ha := (Subrepresentation.irreducible_iff_isAtom (U.compActors N.subtype)).mp hu
    have ht' : U.compActors N.subtype = ⊤ := Subrepresentation.toSubmodule_injective ht
    rwa [ht'] at ha
  let : Finite (V ⧸ U.toSubmodule) := Finite.of_surjective _ U.toSubmodule.mkQ_surjective
  let : Nontrivial (V ⧸ U.toSubmodule) := Submodule.Quotient.nontrivial_iff.mpr hU
  let := quotient_restriction_semisimple ρ N U
  have hq := quotient_restriction_isotypic ρ N U htype
  obtain ⟨W,hw,heW⟩ := exists_simple_section_of_isotypic U.quotientRepresentation N hq P hP hgen
  exact ⟨U,W,hu,hw,he,heW⟩
end Representation.BinaryOffender.Homogeneous
