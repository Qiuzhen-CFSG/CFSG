module

public import Theory.Representation.BinaryOffender.Homogeneous.Existence
public import Mathlib.RepresentationTheory.Semisimple

/-!
# Orbit consequences for a normal actor

If the orbit of an `Irr⁺` section spans a binary module, its quotient by
fixed vectors is semisimple and the orbit group permutes its homogeneous
components transitively. For a normal actor in a finite group, the fixed
space is generated by the fixed parts of the conjugate sections. A section
with no fixed vectors has the TI property.

The fixed-space calculation uses the separation of an `Irr⁺` section from
an invariant subspace modulo fixed vectors, followed by finite-sum
induction. The quotient is spanned by irreducible images; a simple type
absent from that orbit would have its homogeneous component disjoint from
the whole quotient. This gives transitivity without assuming global
irreducibility or a two-group orbit.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
Lemma D.3.4(3),(4),(6), printed pp.193–194.
-/

@[expose] public section
open scoped MonoidAlgebra
namespace Representation.BinaryOffender.Homogeneous
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

private theorem inf_fixedSpace_sup_of_isIrrPlus {X : Subgroup G}
    {I J : Submodule (ZMod 2) V} (hI : IsIrrPlus ρ X I)
    (hJ : X ≤ subspaceStabilizer ρ J) :
    (I ⊔ J) ⊓ fixedSpace ρ X = (I ⊓ fixedSpace ρ X) ⊔ (J ⊓ fixedSpace ρ X) := by
  apply le_antisymm
  · rcases hI.le_or_inf_sup_fixedSpace_le ρ hJ with hle | hsep
    · rw [sup_eq_right.mpr hle]
      exact le_sup_right
    · rintro v ⟨hv, hc⟩
      obtain ⟨i, hi, j, hj, rfl⟩ := Submodule.mem_sup.mp hv
      have hic : i ∈ fixedSpace ρ X :=
        hsep ⟨hi, Submodule.mem_sup.mpr ⟨-j, J.neg_mem hj, i + j, hc, by abel⟩⟩
      have hjc : j ∈ fixedSpace ρ X := by
        simpa only [add_sub_cancel_left] using (fixedSpace ρ X).sub_mem hc hic
      exact Submodule.mem_sup.mpr ⟨i, ⟨hi, hic⟩, j, ⟨hj, hjc⟩, rfl⟩
  · exact sup_le (inf_le_inf le_sup_left le_rfl) (inf_le_inf le_sup_right le_rfl)

private theorem inf_fixedSpace_finset_sup {ι : Type*} {X : Subgroup G}
    (I : ι → Submodule (ZMod 2) V) (hI : ∀ i, IsIrrPlus ρ X (I i)) (s : Finset ι) :
    X ≤ subspaceStabilizer ρ (s.sup I) ∧
      (s.sup I) ⊓ fixedSpace ρ X = s.sup (fun i => I i ⊓ fixedSpace ρ X) := by
  classical
  induction s using Finset.induction_on with
  | empty =>
      constructor
      · apply le_subspaceStabilizer
        intro x hx v hv
        simp only [Finset.sup_empty, Submodule.mem_bot] at hv ⊢
        rw [hv, map_zero]
      · simp
  | @insert i s hi ih =>
      simp only [Finset.sup_insert]
      exact ⟨subspaceStabilizer_sup ρ (hI i).choose ih.1,
        (inf_fixedSpace_sup_of_isIrrPlus ρ (hI i) ih.1).trans (by rw [ih.2])⟩

/-- Fixed vectors are generated by the fixed parts of the orbit of the
chosen `Irr⁺` section, as in D.3.4(4). -/
theorem fixedSpace_eq_orbitSpan_inf [Finite G]
    (X : Subgroup G) [X.Normal] {I : Submodule (ZMod 2) V}
    (hI : IsIrrPlus ρ X I) (hgen : orbitSpan ρ ⊤ I = ⊤) :
    fixedSpace ρ X = orbitSpan ρ ⊤ (I ⊓ fixedSpace ρ X) := by
  classical
  let := Fintype.ofFinite G
  have hN (g : G) : g ∈ Subgroup.normalizer (X : Set G) := by
    rw [Subgroup.normalizer_eq_top]
    exact Subgroup.mem_top g
  have hspan : (Finset.univ : Finset G).sup (fun g => I.map (ρ g)) = ⊤ := by
    rw [Finset.sup_eq_iSup]
    simp only [Finset.mem_univ, iSup_pos]
    have he : (⨆ g : G, I.map (ρ g)) = orbitSpan ρ ⊤ I := by
      apply le_antisymm
      · exact iSup_le fun g => le_iSup (fun g : (⊤ : Subgroup G) => I.map (ρ g)) ⟨g, Subgroup.mem_top g⟩
      · exact iSup_le fun g => le_iSup (fun g : G => I.map (ρ g)) g
    exact he.trans hgen
  have he := (inf_fixedSpace_finset_sup ρ (fun g : G => I.map (ρ g))
    (fun g => hI.map_normalizer ρ (hN g)) Finset.univ).2
  rw [hspan, top_inf_eq] at he
  conv_lhs => rw [he]
  apply le_antisymm
  · apply Finset.sup_le
    intro g hg v hv
    obtain ⟨i, hi, rfl⟩ := hv.1
    have hic : i ∈ fixedSpace ρ X := by
      have := (normalizer_le_fixedSpace_stabilizer ρ X (hN g) i).mp hv.2
      exact this
    exact le_iSup (fun g : (⊤ : Subgroup G) =>
      (I ⊓ fixedSpace ρ X).map (ρ g)) ⟨g, Subgroup.mem_top g⟩ ⟨i, ⟨hi, hic⟩, rfl⟩
  · apply iSup_le
    rintro g v ⟨i, hi, rfl⟩
    exact (Finset.le_sup (f := fun g : G => I.map (ρ g) ⊓ fixedSpace ρ X)
      (Finset.mem_univ (g : G)))
      ⟨⟨i, hi.1, rfl⟩, (normalizer_le_fixedSpace_stabilizer ρ X (hN g) i).mpr hi.2⟩

/-- An `Irr⁺` section with trivial fixed part has the TI property under
all ambient conjugates, as in D.3.4(6). -/
theorem ti_of_inf_fixedSpace_eq_bot (X : Subgroup G) [X.Normal]
    {I : Submodule (ZMod 2) V} (hI : IsIrrPlus ρ X I)
    (hfix : I ⊓ fixedSpace ρ X = ⊥) (g : G) :
    I ⊓ I.map (ρ g) = ⊥ ∨ I.map (ρ g) = I := by
  have hg : g ∈ Subgroup.normalizer (X : Set G) := by
    rw [Subgroup.normalizer_eq_top]
    exact Subgroup.mem_top g
  have hJ := hI.map_normalizer ρ hg
  have hstab : X ≤ subspaceStabilizer ρ (I ⊓ I.map (ρ g)) := by
    apply le_subspaceStabilizer
    intro x hx v hv
    exact ⟨(hI.choose hx v).2 hv.1, (hJ.choose hx v).2 hv.2⟩
  rcases hI.eq_or_le_fixedSpace ρ hstab inf_le_left with he | hc
  · right
    exact (hI.eq_of_le ρ hJ (calc I = I ⊓ I.map (ρ g) := he.symm
      _ ≤ I.map (ρ g) := inf_le_right)).symm
  · left
    apply le_bot_iff.mp
    rw [← hfix]
    exact le_inf inf_le_left hc

private theorem centralTypeAction_span_eq_top
    {X T : Subgroup G} (hT : T ≤ Subgroup.normalizer (X : Set G))
    {I : Submodule (ZMod 2) V} (hI : IsIrrPlus ρ X I)
    (hgen : orbitSpan ρ T I = ⊤) :
    (centralTypeAction ρ X T hT).span (quotientImage ρ X I hI.choose) = ⊤ := by
  apply Subrepresentation.toSubmodule_injective
  rw [centralTypeAction_span]
  change centralOrbitSpan ρ X T hT (I.map (fixedSpace ρ X).mkQ) = ⊤
  rw [← orbitSpan_quotientImage, hgen, Submodule.map_top]
  exact LinearMap.range_eq_top.mpr (Submodule.mkQ_surjective _)

/-- A module spanned by a normalizer orbit of an `Irr⁺` section is generated
by commutators with the actor. -/
theorem full_commutator_of_orbitSpan_eq_top
    {X T : Subgroup G} (hT : T ≤ Subgroup.normalizer (X : Set G))
    {I : Submodule (ZMod 2) V} (hI : IsIrrPlus ρ X I)
    (hgen : orbitSpan ρ T I = ⊤) : subspaceCommutator ρ ⊤ X = ⊤ := by
  simpa only [hgen] using orbitSpan_full_commutator ρ hT hI

/-- The literal quotient by fixed vectors is semisimple for the original
actor; no semisimplicity or irreducibility of the ambient module is assumed. -/
theorem fixedQuotient_semisimple_of_orbitSpan_eq_top
    {X T : Subgroup G} (hT : T ≤ Subgroup.normalizer (X : Set G))
    {I : Submodule (ZMod 2) V} (hI : IsIrrPlus ρ X I)
    (hgen : orbitSpan ρ T I = ⊤) :
    IsSemisimpleRepresentation (fixedQuotientRepresentation ρ X) := by
  let σ := fixedQuotientRepresentation ρ X
  let c := centralTypeAction ρ X T hT
  let S := quotientImage ρ X I hI.choose
  let e : Subrepresentation σ ≃o Submodule (ZMod 2)[X] σ.asModule :=
    Subrepresentation.subrepresentationSubmoduleOrderIso
  apply (isSemisimpleRepresentation_iff_isSemisimpleModule_asModule σ).mpr
  apply IsSemisimpleModule.of_sSup_simples_eq_top
  apply top_unique
  have htop : c.span S = ⊤ := centralTypeAction_span_eq_top ρ hT hI hgen
  have he := congrArg e htop
  change e (⨆ t : T, c.conjugate t S) = e ⊤ at he
  rw [e.map_iSup, e.map_top] at he
  rw [← he]
  exact iSup_le fun t => le_sSup (simple_asSubmodule _
    (c.conjugate_irreducible S (quotientImage_irreducible ρ hI) t))

private theorem TypeAction.exists_sameModule_of_span_eq_top
    {E W P : Type*} [Group E] [AddCommGroup W] [Module (ZMod 2) W] [Group P]
    {σ : Representation (ZMod 2) E W} (c : TypeAction σ P)
    (S : Subrepresentation σ) (hS : IsIrreducible S.toRepresentation)
    (hgen : c.span S = ⊤) (A : Subrepresentation σ)
    (hA : IsIrreducible A.toRepresentation) :
    ∃ t : P, SameModule A (c.conjugate t S) := by
  classical
  by_contra! hn
  have := simple_asSubmodule A hA
  have hdis := component_disjoint_sum A.asSubmodule
    (fun t => (c.conjugate t S).asSubmodule)
    (fun t => simple_asSubmodule _ (c.conjugate_irreducible S hS t))
    (fun t he => hn t ((sameModule_iff_linearEquiv _ _).mpr he))
  have htop : (⨆ t : P, (c.conjugate t S).asSubmodule) = ⊤ := by
    have h := congrArg Subrepresentation.subrepresentationSubmoduleOrderIso hgen
    simpa only [TypeAction.span, OrderIso.map_iSup, OrderIso.map_top,
      Subrepresentation.subrepresentationSubmoduleOrderIso_apply] using h
  rw [htop] at hdis
  have hc := hdis.eq_bot
  rw [inf_top_eq] at hc
  have hbot : A.asSubmodule = ⊥ :=
    le_bot_iff.mp (A.asSubmodule.le_isotypicComponent.trans_eq hc)
  exact ((Subrepresentation.irreducible_iff_isAtom A).mp hA).ne_bot
    (Subrepresentation.subrepresentationSubmoduleOrderIso.injective
      (hbot.trans Subrepresentation.subrepresentationSubmoduleOrderIso.map_bot.symm))

private theorem homogeneousPart_eq_of_sameModule
    {E W : Type*} [Group E] [AddCommGroup W] [Module (ZMod 2) W]
    {σ : Representation (ZMod 2) E W} {A B : Subrepresentation σ}
    (he : SameModule A B) : homogeneousPart A ⊤ = homogeneousPart B ⊤ := by
  apply le_antisymm
  · exact iSup_le fun J => iSup_le fun hJ =>
      le_iSup_of_le J (le_iSup_of_le ⟨hJ.1, he.symm.trans hJ.2⟩ le_rfl)
  · exact iSup_le fun J => iSup_le fun hJ =>
      le_iSup_of_le J (le_iSup_of_le ⟨hJ.1, he.trans hJ.2⟩ le_rfl)

private theorem centralConjugate_homogeneousPart
    (X T : Subgroup G) (hT : T ≤ Subgroup.normalizer (X : Set G)) (t : T)
    (A : Subrepresentation (fixedQuotientRepresentation ρ X)) :
    (homogeneousPart A ⊤).map
        (normalizerQuotientRepresentation ρ X ⟨t, hT t.property⟩) =
      homogeneousPart (centralConjugate ρ X T hT t A) ⊤ := by
  let c := centralTypeAction ρ X T hT
  simp only [homogeneousPart, Submodule.map_iSup]
  apply le_antisymm
  · refine iSup_le fun B => iSup_le fun hB => ?_
    rw [← centralConjugate_toSubmodule ρ X T hT t B]
    exact le_iSup_of_le (c.conjugate t B)
      (le_iSup_of_le ⟨le_top, (c.same t A B).mp hB.2⟩ le_rfl)
  · refine iSup_le fun B => iSup_le fun hB => ?_
    have he : SameModule A (c.conjugate t⁻¹ B) := by
      have h := (c.same t⁻¹ (c.conjugate t A) B).mp hB.2
      rwa [c.inv_conjugate] at h
    refine le_iSup_of_le (c.conjugate t⁻¹ B) (le_iSup_of_le ⟨le_top, he⟩ ?_)
    rw [← centralConjugate_toSubmodule ρ X T hT t]
    change B.toSubmodule ≤ (c.conjugate t (c.conjugate t⁻¹ B)).toSubmodule
    rw [c.conjugate_inv]

/-- The orbit group acts transitively on all homogeneous components of the
literal central quotient, including any choice of simple representatives. -/
theorem homogeneousParts_transitive_of_orbitSpan_eq_top
    {X T : Subgroup G} (hT : T ≤ Subgroup.normalizer (X : Set G))
    {I : Submodule (ZMod 2) V} (hI : IsIrrPlus ρ X I)
    (hgen : orbitSpan ρ T I = ⊤)
    (A B : Subrepresentation (fixedQuotientRepresentation ρ X))
    (hA : IsIrreducible A.toRepresentation) (hB : IsIrreducible B.toRepresentation) :
    ∃ t : T, (homogeneousPart A ⊤).map
        (normalizerQuotientRepresentation ρ X ⟨t, hT t.property⟩) =
      homogeneousPart B ⊤ := by
  let c := centralTypeAction ρ X T hT
  let S := quotientImage ρ X I hI.choose
  have hS : IsIrreducible S.toRepresentation := quotientImage_irreducible ρ hI
  have hs : c.span S = ⊤ := centralTypeAction_span_eq_top ρ hT hI hgen
  obtain ⟨a, ha⟩ := c.exists_sameModule_of_span_eq_top S hS hs A hA
  obtain ⟨b, hb⟩ := c.exists_sameModule_of_span_eq_top S hS hs B hB
  refine ⟨b * a⁻¹, ?_⟩
  rw [centralConjugate_homogeneousPart]
  apply homogeneousPart_eq_of_sameModule
  have he := (c.same (b * a⁻¹) A (c.conjugate a S)).mp ha
  rw [← c.mul, inv_mul_cancel_right] at he
  exact he.trans hb.symm

end Representation.BinaryOffender.Homogeneous
