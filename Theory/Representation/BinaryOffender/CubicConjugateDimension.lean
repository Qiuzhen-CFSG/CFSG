module

public import Theory.Representation.BinaryOffender.NormalizerConjugateDimension
public import Theory.Representation.BinaryOffender.CubicRatio

/-!
# Cubic-ratio degree bounds for the actual ambient actor

An elementary subgroup attaining a cubic ratio bound contains an involution
of no larger fixed codimension. If boundedly many conjugates of that involution
generate a group containing an irreducible normal actor, the usual intersection
of fixed spaces bounds the degree. Automorphism rank descends through the
literal central quotient of a perfect actor.

These are the reductions (2.5)--(2.6) of Guralnick--Malle, *Classification of
2F-modules, I*, used in Aschbacher--Smith K.4, printed p.457. All conjugates
are taken in the given group; no condition on its full linear normalizer is
needed. The generation bound remains an explicit mathematical input.
-/

@[expose] public section
namespace Representation.BinaryOffender
open Subgroup Theory.GroupTheory
open scoped ENNReal

variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]

/-- The actual normal actor is contained in the group generated by at most
`n` conjugates of every nonidentity involution of the ambient group. -/
def InvolutionConjugateGenerationBound (L : Subgroup G) (n : ℕ) : Prop :=
  ∀ t : G, t ≠ 1 → t ^ 2 = 1 →
    ∃ c : Fin n → G, L ≤ closure (Set.range fun i => c i * t * (c i)⁻¹)

/-- A faithful irreducible normal action bounds ambient two-rank by the
automorphism two-rank of its specified perfect central quotient. -/
theorem primeRank_le_central_quotient_automorphisms [Finite G]
    (ρ : Representation (ZMod 2) G V) (L : Subgroup G) [L.Normal]
    [Group.IsPerfect L] (hf : Function.Injective ρ)
    (hi : Representation.IsIrreducible (ρ.comp L.subtype))
    {S : Type*} [Group S] (e : L ⧸ center L ≃* S) :
    primeRank 2 G ≤ primeRank 2 (MulAut S) := by
  let := hi
  let : Finite S := Finite.of_surjective e e.surjective
  have h₁ := BinaryIrreducibleCentralizer.primeRank_le_automorphisms ρ L hf
  have h₂ := automorphism_primeRank_le_quotient_center (E := L) 2
  rw [primeRank_equiv 2 (MulAut.congr e)] at h₂
  exact h₁.trans h₂

/-- Convert the ambient prime-rank bound to the binary rank used in ratios. -/
theorem IsElementaryTwo.rank_le_of_primeRank_le [Finite G] {A : Subgroup G}
    (hA : IsElementaryTwo A) {r : ℕ} (hr : primeRank 2 G ≤ r) : rank A ≤ r := by
  have hc := (primeRank_le_iff_elementary_card_le G).mp hr A hA.2
  have hh := Nat.log_mono_right (b := 2) hc
  simpa only [rank, Nat.log_pow (by decide : 1 < 2)] using hh

/-- An involution from a cubic actor of ratio at most `m` has displacement
at most `m` times the ambient two-rank bound. -/
theorem exists_involution_of_cubicRatio_le [Finite G]
    [FiniteDimensional (ZMod 2) V]
    (ρ : Representation (ZMod 2) G V) {m r : ℕ}
    (hr : primeRank 2 G ≤ r) (hq : cubicRatio ρ ≤ (m : ℝ≥0∞)) :
    ∃ t : G, t ≠ 1 ∧ t ^ 2 = 1 ∧ fixedCodim ρ (zpowers t) ≤ m * r := by
  obtain ⟨A, hA, _, hcodim⟩ := (cubicRatio_le_nat_iff ρ m).mp hq
  let : IsElementaryAbelian 2 A := hA.2
  obtain ⟨t, ht, ht1⟩ := A.bot_or_exists_ne_one.resolve_left hA.1
  refine ⟨t, ht1, elemPow_eq_one_of_isElementaryAbelian t ht, ?_⟩
  have hfix : fixedSpace ρ A ≤ fixedSpace ρ (zpowers t) := by
    intro v hv a
    exact hv ⟨a, (zpowers_le.mpr ht) a.property⟩
  have hd := Submodule.finrank_mono hfix
  have h₁ := fixedCodim_add_finrank ρ A
  have h₂ := fixedCodim_add_finrank ρ (zpowers t)
  have h₃ := hcodim.trans (Nat.mul_le_mul_left m (hA.rank_le_of_primeRank_le hr))
  omega

/-- Fixed-space intersections turn the cubic-ratio witness into a degree bound. -/
theorem finrank_le_of_cubicRatio_le_of_conjugates [Finite G]
    [FiniteDimensional (ZMod 2) V]
    (ρ : Representation (ZMod 2) G V) (L : Subgroup G)
    (hfix : fixedSpace ρ L = ⊥) {n m r : ℕ}
    (hgen : InvolutionConjugateGenerationBound L n)
    (hr : primeRank 2 G ≤ r) (hq : cubicRatio ρ ≤ (m : ℝ≥0∞)) :
    Module.finrank (ZMod 2) V ≤ n * (m * r) := by
  obtain ⟨t, ht, ht2, hd⟩ := exists_involution_of_cubicRatio_le ρ hr hq
  obtain ⟨c, hc⟩ := hgen t ht ht2
  exact (finrank_le_mul_fixedCodim_of_conjugates ρ L hfix t c hc).trans
    (Nat.mul_le_mul_left n hd)

end Representation.BinaryOffender
