module
public import Theory.Representation.BinaryOffender.Homogeneous.Basic
public import Theory.Representation.BinaryOffender.SubspaceAction
public import Theory.Representation.BinaryOffender.MarkedOrbitCore
/-!
# Trivial two-core from a support Sylow seed

A support image generated by the translates of its Sylow fixed space has
trivial two-core. Transporting the fixed space and orbit span through the
literal restriction map preserves the original support action.

Source application: Aschbacher–Smith15.1.7 and15.1.13, pp.1087 and1091.
-/
public noncomputable section
open Subgroup Representation Representation.BinaryOffender
namespace Representation.BinaryOffender
variable {D V : Type*} [Group D] [Finite D] [AddCommGroup V] [Module (ZMod 2) V]

theorem supportImage_twoCore_eq_bot_of_sylow_seed
    (ρ : Representation (ZMod 2) D V) (W : Submodule (ZMod 2) V)
    (S : Sylow 2 (subspaceStabilizer ρ W))
    (hspan : Homogeneous.orbitSpan ρ (subspaceStabilizer ρ W)
      (fixedSpace ρ ((S : Subgroup (subspaceStabilizer ρ W)).map
        (subspaceStabilizer ρ W).subtype) ⊓ W) = W) :
    pCore 2 (subspaceActionImage ρ W) = ⊥ := by
  let N := subspaceStabilizer ρ W
  let q := subspaceActionHom ρ W
  let σ := subspaceImageRepresentation ρ W
  let P := S.mapSurjective (f := q)
    (stabilizerRepresentation ρ W).asGroupHom.rangeRestrict_surjective
  let B := fixedSpace σ (P : Subgroup (subspaceActionImage ρ W))
  have hB : B.map W.subtype =
      fixedSpace ρ ((S : Subgroup N).map N.subtype) ⊓ W := by
    apply le_antisymm
    · rintro v ⟨w,hw,rfl⟩
      refine ⟨?_,w.property⟩
      rintro ⟨g,n,hn,rfl⟩
      exact congrArg W.subtype (hw ⟨q n,mem_map_of_mem q hn⟩)
    · intro v hv
      refine ⟨⟨v,hv.2⟩,?_,rfl⟩
      rintro ⟨g,n,hn,rfl⟩
      apply Subtype.ext
      exact hv.1 ⟨n,mem_map_of_mem N.subtype hn⟩
  apply twoCore_eq_bot_of_sylow_fixed_span σ (subspaceImageRepresentation_injective ρ W) P B le_rfl
  let C := Submodule.span (ZMod 2) {w | ∃ g v, v ∈ B ∧ σ g v = w}
  have hle : Homogeneous.orbitSpan ρ N
      (fixedSpace ρ ((S : Subgroup N).map N.subtype) ⊓ W) ≤ C.map W.subtype := by
    apply iSup_le
    rintro n v ⟨w,hw,rfl⟩
    rw [←hB] at hw
    obtain ⟨x,hx,rfl⟩ := hw
    exact ⟨σ (q n) x,Submodule.subset_span ⟨q n,x,hx,rfl⟩,rfl⟩
  apply top_unique
  intro w _
  have hw' : (w : V) ∈ Homogeneous.orbitSpan ρ N
      (fixedSpace ρ ((S : Subgroup N).map N.subtype) ⊓ W) := by
    rw [hspan]
    exact w.property
  have hw := hle hw'
  obtain ⟨x,hx,he⟩ := hw
  exact (Subtype.ext he : x = w) ▸ hx
end Representation.BinaryOffender
