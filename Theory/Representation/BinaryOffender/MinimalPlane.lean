module
public import Theory.Representation.BinaryOffender.SmallMovedProducts
public import Theory.Representation.BinaryOffender.MovedSpaceTransport
public import Theory.Representation.BinaryOffender.Restriction
public import Theory.Representation.BinaryOffender.IrreducibleExistence

/-!
# The support of a minimal offender moving a plane

If a noncentral invariant subspace does not contain all displacement, its
moved dimension is at most one. Counting displacement maps excludes a strong
offender on its faithful action image. Minimality and B.1.5(2) then give a
fixed-space supplement, which forces the entire displacement into that
subspace. Thus two disjoint invariant spaces cannot both be moved, and a
perfect component generated by the offender contains all its displacement.

Source: Aschbacher–Smith B.1.5(2) and13.7.15, printed pp.69,943–944.
-/

public section
open Subgroup
namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [Finite G]
  [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

omit [Finite G] in
/-- Displacement dimension in the faithful image is bounded by the original span. -/
theorem restricted_moved_finrank_le (W : Submodule (ZMod 2) V) (A : Subgroup G)
    (hs : A ≤ subspaceStabilizer ρ W) :
    Module.finrank (ZMod 2) (subspaceCommutator (subspaceImageRepresentation ρ W) ⊤
      (restrictedSubgroup ρ W A)) ≤ Module.finrank (ZMod 2) (subspaceCommutator ρ W A) := by
  let S := subspaceCommutator (subspaceImageRepresentation ρ W) ⊤ (restrictedSubgroup ρ W A)
  let T := subspaceCommutator ρ W A
  have he : S.map W.subtype = T := by
    simpa only [Submodule.map_top, Submodule.range_subtype] using
      subspaceCommutator_restricted_map ρ W A hs ⊤
  let f : S →ₗ[ZMod 2] T := (W.subtype.comp S.subtype).codRestrict T (by
    intro x
    exact he ▸ (show (x : W).val ∈ S.map W.subtype from ⟨x,x.property,rfl⟩))
  exact LinearMap.finrank_le_finrank_of_injective (f := f) (by
    intro x y h
    exact Subtype.ext (Subtype.ext (congrArg (fun t : T => (t : V)) h)))

/-- At most one moved dimension excludes a strong offender on the faithful image. -/
theorem restricted_not_strong_of_moved_le_one (W : Submodule (ZMod 2) V)
    (A : Subgroup G) (hs : A ≤ subspaceStabilizer ρ W)
    (hd : Module.finrank (ZMod 2) (subspaceCommutator ρ W A) ≤ 1) :
    ¬ IsStrongOffender (subspaceImageRepresentation ρ W) (restrictedSubgroup ρ W A) := by
  let τ := subspaceImageRepresentation ρ W
  let B := restrictedSubgroup ρ W A
  have hm : fixedCodim τ.dual B ≤ 1 := by
    rw [fixedCodim_dual_eq_moved_finrank]
    exact (restricted_moved_finrank_le ρ W A hs).trans hd
  have hr := rank_le_fixedCodim_mul_dual τ (subspaceImageRepresentation_injective ρ W) B
  have hm' : fixedCodim τ B * fixedCodim τ.dual B ≤ fixedCodim τ B := by
    simpa using Nat.mul_le_mul_left (fixedCodim τ B) hm
  intro h
  have hh : fixedCodim τ B < rank B := h.2
  omega

/-- A minimal best offender moving a plane has all its displacement inside
any invariant subspace on which it acts nontrivially. -/
theorem IsMinimalBestOffender.moved_le_of_plane {A : Subgroup G}
    (hA : IsMinimalBestOffender ρ A)
    (hd : Module.finrank (ZMod 2) (subspaceCommutator ρ ⊤ A) ≤ 2)
    (W : Submodule (ZMod 2) V) (hs : A ≤ subspaceStabilizer ρ W)
    (hn : ¬ W ≤ fixedSpace ρ A) : subspaceCommutator ρ ⊤ A ≤ W := by
  by_contra hnot
  have hlt : subspaceCommutator ρ W A < subspaceCommutator ρ ⊤ A := by
    apply lt_of_le_of_ne (subspaceCommutator_mono_left ρ le_top A)
    intro he
    exact hnot (he ▸ subspaceCommutator_le_of_invariant ρ hs)
  have hf := Submodule.finrank_lt_finrank_of_lt hlt
  have hline : Module.finrank (ZMod 2) (subspaceCommutator ρ W A) ≤ 1 := by omega
  have hsum := (hA.faithful_span_of_not_strong ρ W hs hn
    (restricted_not_strong_of_moved_le_one ρ W A hs hline)).2
  exact hnot (subspaceCommutator_le_of_le_sup_fixedSpace ρ hs hsum.ge)
/-- Two disjoint invariant spaces cannot both be moved by a minimal plane offender. -/
theorem IsMinimalBestOffender.fixes_one_of_disjoint {A : Subgroup G}
    (hA : IsMinimalBestOffender ρ A)
    (hd : Module.finrank (ZMod 2) (subspaceCommutator ρ ⊤ A) ≤ 2)
    (I J : Submodule (ZMod 2) V) (hI : A ≤ subspaceStabilizer ρ I)
    (hJ : A ≤ subspaceStabilizer ρ J) (hdis : Disjoint I J) :
    I ≤ fixedSpace ρ A ∨ J ≤ fixedSpace ρ A := by
  by_cases hfix : I ≤ fixedSpace ρ A
  · exact Or.inl hfix
  right
  apply (subspaceCommutator_eq_bot_iff ρ J A).mp
  apply bot_unique
  exact hdis ((subspaceCommutator_mono_left ρ le_top A).trans
    (hA.moved_le_of_plane ρ hd I hI hfix))
    (subspaceCommutator_le_of_invariant ρ hJ)

/-- A component generated by its commutators with the offender contains
all of that offender's displacement. Perfectness is the only group input. -/
theorem IsMinimalBestOffender.moved_le_moved_perfect {A K : Subgroup G}
    [Group.IsPerfect K] (hf : Function.Injective ρ) (hK : K ≠ ⊥)
    (hA : IsMinimalBestOffender ρ A)
    (hd : Module.finrank (ZMod 2) (subspaceCommutator ρ ⊤ A) ≤ 2)
    (hcomm : ⁅K,A⁆ = K) : subspaceCommutator ρ ⊤ A ≤ subspaceCommutator ρ ⊤ K := by
  have hs : A ≤ subspaceStabilizer ρ (subspaceCommutator ρ ⊤ K) :=
    subspaceCommutator_invariant_normalizer ρ (le_subspaceStabilizer ρ ⊤ (by simp))
      (le_normalizer_iff_commutator_le_left.mpr hcomm.le)
  apply hA.moved_le_of_plane ρ hd _ hs
  intro hfix
  have hh := le_fixedSpace_commutator_of_invariant ρ
    (subspaceCommutator_invariant_normalizer ρ
      (le_subspaceStabilizer ρ ⊤ (by simp)) K.le_normalizer) hfix
  rw [hcomm] at hh
  have hall := le_fixedSpace_of_commutator_le_fixedSpace ρ K ⊤
    (le_subspaceStabilizer ρ ⊤ (by simp)) hh
  apply hK
  apply (Subgroup.eq_bot_iff_forall K).mpr
  intro k hk
  apply hf
  apply LinearMap.ext
  intro v
  simpa using hall (Submodule.mem_top : v ∈ (⊤ : Submodule (ZMod 2) V)) ⟨k,hk⟩
/-- When two invariant spaces intersect centrally, the offender centralizes
at least one of their literal quotient images. -/
theorem IsMinimalBestOffender.centralizes_one_quotient {A : Subgroup G}
    (hA : IsMinimalBestOffender ρ A)
    (hd : Module.finrank (ZMod 2) (subspaceCommutator ρ ⊤ A) ≤ 2)
    (I J C : Submodule (ZMod 2) V) (hI : A ≤ subspaceStabilizer ρ I)
    (hJ : A ≤ subspaceStabilizer ρ J) (hdis : I ⊓ J ≤ C) :
    subspaceCommutator ρ I A ≤ C ∨ subspaceCommutator ρ J A ≤ C := by
  by_cases hfix : I ≤ fixedSpace ρ A
  · left
    rw [(subspaceCommutator_eq_bot_iff ρ I A).mpr hfix]
    exact bot_le
  right
  exact (le_inf ((subspaceCommutator_mono_left ρ le_top A).trans
      (hA.moved_le_of_plane ρ hd I hI hfix))
    (subspaceCommutator_le_of_invariant ρ hJ)).trans hdis
end Representation.BinaryOffender
