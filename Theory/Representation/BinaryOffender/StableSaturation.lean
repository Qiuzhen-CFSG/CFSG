module

public import Theory.Representation.BinaryOffender.Stability

/-!
# Saturation of families of best offenders

The saturation of a family consists of all best offenders in the subgroup it
generates. For a family of best offenders this operation preserves the generated
subgroup. For a stable family it also preserves stability, and is the largest
family of best offenders with that generated subgroup.

These facts give a corrected family formulation for Aschbacher–Smith, *The
Classification of Quasithin Groups*, B.1.8(5), printed p. 70. Stability in B.1.6
does not imply that the original family equals its saturation. The proof uses
the universal property of the generated subgroup; conjugation invariance of
the saturation follows from normality of that subgroup.
-/

@[expose] public section

namespace Representation.BinaryOffender

variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

/-- All best offenders in the subgroup generated by `P`. This is an operation
on families, not an additional clause in the definition of stability. -/
def saturation (P : Set (Subgroup G)) : Set (Subgroup G) :=
  {A | IsBestOffender ρ A ∧ A ≤ generatedBy P ⊤}

/-- Each member of a family lies in its generated subgroup. -/
theorem le_generatedBy_top_of_mem {P : Set (Subgroup G)} {A : Subgroup G}
    (hA : A ∈ P) : A ≤ generatedBy P ⊤ :=
  le_iSup_of_le A (le_iSup_of_le ⟨hA, le_top⟩ le_rfl)

/-- A family of best offenders is contained in its saturation. -/
theorem subset_saturation {P : Set (Subgroup G)}
    (hP : ∀ A ∈ P, IsBestOffender ρ A) : P ⊆ saturation ρ P :=
  fun A hA => ⟨hP A hA, le_generatedBy_top_of_mem hA⟩

/-- Saturating a family of best offenders leaves its generated subgroup unchanged. -/
theorem generatedBy_saturation {P : Set (Subgroup G)}
    (hP : ∀ A ∈ P, IsBestOffender ρ A) :
    generatedBy (saturation ρ P) ⊤ = generatedBy P ⊤ := by
  apply le_antisymm
  · exact iSup_le fun A => iSup_le fun hA => hA.1.2
  · exact iSup_le fun A => iSup_le fun hA =>
      le_generatedBy_top_of_mem (subset_saturation ρ hP hA.1)

/-- Saturation is monotone on families. -/
theorem saturation_mono {P Q : Set (Subgroup G)} (hPQ : P ⊆ Q) :
    saturation ρ P ⊆ saturation ρ Q := by
  intro A hA
  refine ⟨hA.1, hA.2.trans ?_⟩
  exact iSup_le fun B => iSup_le fun hB => le_generatedBy_top_of_mem (hPQ hB.1)

/-- A second saturation adds nothing. -/
theorem saturation_idempotent {P : Set (Subgroup G)}
    (hP : ∀ A ∈ P, IsBestOffender ρ A) :
    saturation ρ (saturation ρ P) = saturation ρ P := by
  ext A
  change (IsBestOffender ρ A ∧ A ≤ generatedBy (saturation ρ P) ⊤) ↔ _
  rw [generatedBy_saturation ρ hP]
  rfl

/-- The saturation contains every family of best offenders with the same
generated subgroup. This does not assert that those families are equal. -/
theorem subset_saturation_of_generatedBy_eq {P Q : Set (Subgroup G)}
    (hQ : ∀ A ∈ Q, IsBestOffender ρ A)
    (h : generatedBy Q ⊤ = generatedBy P ⊤) : Q ⊆ saturation ρ P := by
  intro A hA
  refine ⟨hQ A hA, ?_⟩
  rw [← h]
  exact le_generatedBy_top_of_mem hA

/-- Stable families have stable saturations, with the original B.1.6 definition. -/
theorem IsStable.isStable_saturation {P : Set (Subgroup G)} (hP : IsStable ρ P) :
    IsStable ρ (saturation ρ P) := by
  obtain ⟨A, hA⟩ := hP.1
  refine ⟨⟨A, subset_saturation ρ hP.2.1 hA⟩, fun _ hB => hB.1, ?_, ?_⟩
  · intro B hB g
    refine ⟨hB.1.map_conj ρ g, ?_⟩
    intro x hx
    obtain ⟨b, hb, rfl⟩ := hx
    exact hP.generatedBy_normal ρ |>.conj_mem b (hB.2 hb) g
  · intro B hB C hC hCB
    exact ⟨hB.1.of_equalWeightLE ρ hC hCB, hCB.1.trans hB.2⟩

/-- Corrected family conclusion: the stable saturation has exactly the same
generated subgroup as the original stable family. -/
theorem IsStable.saturation_spec {P : Set (Subgroup G)} (hP : IsStable ρ P) :
    P ⊆ saturation ρ P ∧ IsStable ρ (saturation ρ P) ∧
      generatedBy (saturation ρ P) ⊤ = generatedBy P ⊤ :=
  ⟨subset_saturation ρ hP.2.1, hP.isStable_saturation ρ, generatedBy_saturation ρ hP.2.1⟩

end Representation.BinaryOffender
