module

public import Theory.Representation.BinaryOffender.IrreducibleMovedTransport

/-!
# Removing fixed vectors from central sections

For a binary representation, a central operator satisfying the cubic
cyclotomic relation modulo the fixed space satisfies that relation on every
full commutator subspace. The norm operator commutes with the component and
has fixed image, so it kills all commutators. On fixed vectors the same norm
is the identity. Thus the section has no central fixed vectors.

A complementary pair in the quotient by the fixed space then lifts to an
actual complementary pair whenever the ambient module is generated by its
component commutators. This keeps the hatted and unhatted statements separate.

Source: the central-space and saturation steps in Aschbacher–Smith,
combined manuscript of 1 March 2004, F.9.18(4),(7), printed pp.325–326,
and its application in 13.8.20, printed p.955.
-/

@[expose] public noncomputable section
namespace Representation.BinaryOffender
open Subgroup
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

/-- The cubic norm polynomial; no field extension or splitting is assumed. -/
def centralCubicNorm (z : G) : Module.End (ZMod 2) V := ρ z * ρ z + ρ z + 1

lemma centralCubicNorm_apply (z : G) (v : V) :
    centralCubicNorm ρ z v = ρ z (ρ z v) + ρ z v + v := rfl

private lemma binary_add_self (v : V) : v + v = 0 := by
  have h := @two_smul (ZMod 2) V _ _ _ v
  rw [show (2 : ZMod 2) = 0 by decide, zero_smul] at h
  exact h.symm

/-- A central cubic norm with fixed image kills a full commutator section. -/
theorem centralCubicNorm_eq_zero_on_commutator
    (K : Subgroup G) (I : Submodule (ZMod 2) V)
    (hI : subspaceCommutator ρ I K = I)
    (z : G) (hz : ∀ k ∈ K, z * k = k * z)
    (hn : ∀ v ∈ I, centralCubicNorm ρ z v ∈ fixedSpace ρ K) :
    ∀ v ∈ I, centralCubicNorm ρ z v = 0 := by
  have hc (k : G) (hk : k ∈ K) (v : V) :
      ρ z (ρ k v) = ρ k (ρ z v) := by
    change (ρ z * ρ k) v = (ρ k * ρ z) v
    rw [← map_mul, ← map_mul, hz k hk]
  have he (k : G) (hk : k ∈ K) (v : V) :
      centralCubicNorm ρ z (ρ k v) = ρ k (centralCubicNorm ρ z v) := by
    simp only [centralCubicNorm_apply, map_add, hc k hk]
  have hk : I ≤ (centralCubicNorm ρ z).ker := by
    rw [← hI]
    apply Submodule.span_le.mpr
    rintro _ ⟨k, hk, v, hv, rfl⟩
    change centralCubicNorm ρ z (ρ k v - v) = 0
    rw [map_sub, he k hk]
    exact sub_eq_zero.mpr (hn v hv ⟨k, hk⟩)
  exact fun v hv => hk hv

/-- The central norm is the identity on K-fixed vectors in characteristic two. -/
theorem disjoint_fixedSpace_of_centralCubicNorm
    (K : Subgroup G) (I : Submodule (ZMod 2) V)
    (hI : subspaceCommutator ρ I K = I)
    (z : G) (hzK : z ∈ K) (hz : ∀ k ∈ K, z * k = k * z)
    (hn : ∀ v ∈ I, centralCubicNorm ρ z v ∈ fixedSpace ρ K) :
    Disjoint I (fixedSpace ρ K) := by
  rw [Submodule.disjoint_def]
  intro v hv hc
  have h := centralCubicNorm_eq_zero_on_commutator ρ K I hI z hz hn v hv
  have hf : ρ z v = v := hc ⟨z, hzK⟩
  rw [centralCubicNorm_apply, hf, hf, binary_add_self, zero_add] at h
  exact h

/-- The actual projection restricts to an equivalence when its central kernel vanishes. -/
def centralSectionEquiv (K : Subgroup G) (I : Submodule (ZMod 2) V)
    (hI : Disjoint I (fixedSpace ρ K)) : I ≃ₗ[ZMod 2] centralQuotient ρ K I :=
  LinearEquiv.ofBijective ((fixedSpace ρ K).comap I.subtype).mkQ ⟨by
    apply (injective_iff_map_eq_zero _).mpr
    intro v hv
    apply Subtype.ext
    exact (Submodule.disjoint_def.mp hI) v v.property
      ((Submodule.Quotient.mk_eq_zero ((fixedSpace ρ K).comap I.subtype)).mp hv),
    Submodule.mkQ_surjective _⟩

lemma centralSectionEquiv_apply (K : Subgroup G) (I : Submodule (ZMod 2) V)
    (hI : Disjoint I (fixedSpace ρ K)) (v : I) :
    centralSectionEquiv ρ K I hI v = Submodule.Quotient.mk v := rfl

lemma centralSectionEquiv_equivariant (K : Subgroup G) (I : Submodule (ZMod 2) V)
    (hI : Disjoint I (fixedSpace ρ K)) (hs : K ≤ subspaceStabilizer ρ I)
    (k : K) (v : I) :
    centralSectionEquiv ρ K I hI ((invariantSubspace ρ K I hs).toRepresentation k v) =
      centralQuotientRepresentation ρ K I hs k (centralSectionEquiv ρ K I hI v) := rfl

/-- A direct-sum decomposition modulo fixed vectors lifts after commutator saturation.
Only I needs to be known disjoint from the fixed space. -/
theorem isCompl_of_centralQuotient
    (K : Subgroup G) (I J : Submodule (ZMod 2) V)
    (hI : K ≤ subspaceStabilizer ρ I) (hJ : K ≤ subspaceStabilizer ρ J)
    (hmove : subspaceCommutator ρ ⊤ K = ⊤)
    (hfix : Disjoint I (fixedSpace ρ K))
    (hdis : Disjoint (I.map (fixedSpace ρ K).mkQ) (J.map (fixedSpace ρ K).mkQ))
    (hspan : I.map (fixedSpace ρ K).mkQ ⊔ J.map (fixedSpace ρ K).mkQ = ⊤) :
    IsCompl I J := by
  have hd : Disjoint I J := by
    rw [Submodule.disjoint_def]
    intro v hi hj
    have hz := (Submodule.disjoint_def.mp hdis) ((fixedSpace ρ K).mkQ v)
      ⟨v, hi, rfl⟩ ⟨v, hj, rfl⟩
    exact (Submodule.disjoint_def.mp hfix) v hi ((Submodule.Quotient.mk_eq_zero _).mp hz)
  have hs : I ⊔ J = ⊤ := by
    apply top_unique
    rw [← hmove]
    apply subspaceCommutator_le_of_le_sup_fixedSpace ρ (subspaceStabilizer_sup ρ hI hJ)
    intro v _
    have hv : (fixedSpace ρ K).mkQ v ∈ (I ⊔ J).map (fixedSpace ρ K).mkQ := by
      rw [Submodule.map_sup, hspan]
      trivial
    obtain ⟨w, hw, he⟩ := hv
    have hz : v - w ∈ fixedSpace ρ K := by
      apply (Submodule.Quotient.mk_eq_zero _).mp
      change (fixedSpace ρ K).mkQ (v - w) = 0
      rw [map_sub, he, sub_self]
    exact Submodule.mem_sup.mpr ⟨w, hw, v - w, hz, by abel⟩
  exact ⟨hd, codisjoint_iff.mpr hs⟩

end Representation.BinaryOffender
