module
public import Theory.Representation.BinaryOffender.Stability
public import Mathlib.GroupTheory.Subgroup.Simple

/-!
# Simple sections containing offenders

A best offender inside an offender is nontrivial. The normal subgroup
generated by all best offenders therefore meets a simple section
nontrivially and contains it. The actual map of that section is retained.
-/

public section
namespace Representation.BinaryOffender
open Subgroup
variable {G S W : Type*} [Group G] [Finite G] [Group S] [IsSimpleGroup S]
  [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]

/-- A simple section containing an offender lies in the actual offender subgroup. -/
theorem simple_range_le_offenderSubgroup (ρ : Representation (ZMod 2) G W)
    (f : S →* G) (E : Subgroup S) (hE : IsOffender ρ (E.map f)) :
    f.range ≤ offenderSubgroup ρ := by
  let J := offenderSubgroup ρ
  let : J.Normal := offenderSubgroup_normal ρ
  obtain ⟨B,hBE,hB⟩ := hE.exists_bestOffender ρ
  have hBJ : B ≤ J := le_iSup_of_le B (le_iSup_of_le ⟨hB,le_top⟩ le_rfl)
  have htop : J.comap f = ⊤ := by
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (J.comap f) inferInstance with hb | ht
    · exfalso
      apply hB.1.1
      apply bot_unique
      intro b hbB
      obtain ⟨a,ha,he⟩ := hBE hbB
      have haJ : a ∈ J.comap f := by change f a ∈ J; rw [he]; exact hBJ hbB
      have ha1 : a = 1 := mem_bot.mp (hb ▸ haJ)
      rw [← he,ha1,map_one]
      exact mem_bot.mpr rfl
    · exact ht
  rintro _ ⟨s,rfl⟩
  exact (show s ∈ J.comap f from htop ▸ mem_top s)

end Representation.BinaryOffender
