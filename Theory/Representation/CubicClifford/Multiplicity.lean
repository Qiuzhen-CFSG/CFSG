module

public import Theory.Representation.CubicClifford.Dimension
public import Theory.Representation.CubicClifford.TensorPair
public import Theory.Representation.CubicClifford.ActionTransfer
public import Theory.Representation.CubicClifford.Extension.Construction
public import Theory.Representation.CubicClifford.Inertia

/-!
# Cubic Clifford multiplicities

Let `K` and `X` be normal subgroups of a finite group `H`, with `|X| = 3` and
`H/(KX)` a two-group. On a simple binary module generated by its `X`-commutators,
an absolutely irreducible `K`-constituent whose extension to `H` kills `X`
occurs exactly twice. If it extends instead to a normal subgroup `I` of index
two and the other coset exchanges its isomorphism class, each of the two
constituents occurs twice. The two vector-space universes are independent.

For the first assertion, evaluation constructs the tensor decomposition, and
the normal cubic subgroup acts nontrivially on the simple multiplicity space.
The cubic dimension theorem makes that space two-dimensional. For the second,
Clifford theory constructs the irreducible inertia block. The ambient zero
`X`-fixed space passes nontrivial action to this block, and the first assertion
applies there. The inertia decomposition then yields the four factors.
Every conclusion is an actual intertwining equivalence. Neither a splitting
of the group extension nor an assumed multiplicity is used.

These conditional representation-theoretic results supply the multiplicities
in the proof of Aschbacher–Smith, *The Classification of Quasithin Groups*,
13.8.21(1), printed p.956. Identifying the concrete constituents and their
extensions remains with that source theorem's assembly. Although its setting
has commuting `K` and `X`, these two results do not need that extra assumption.
-/

public section

open scoped TensorProduct
namespace Representation.CubicClifford

variable {H V E : Type*} [Group H] [Finite H]
  [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
  [AddCommGroup E] [Module (ZMod 2) E] [FiniteDimensional (ZMod 2) E]

/-- An absolutely irreducible constituent extending to `H`, with trivial `X`
action on the extension, occurs exactly twice. The multiplicity space is
constructed from the occurrence, and its dimension is forced to be two by
the nontrivial normal cubic action. -/
theorem restriction_pair_of_extension
    (ρ : Representation (ZMod 2) H V) [IsIrreducible ρ]
    (K X : Subgroup H) [K.Normal] [X.Normal]
    (hX : Nat.card X = 3) (hQ : IsPGroup 2 (H ⧸ (K ⊔ X)))
    (hact : ¬ X ≤ ρ.ker) (τ : Representation (ZMod 2) H E)
    (habs : IsAbsolutelyIrreducible (τ.comp K.subtype)) (hτ : X ≤ τ.ker)
    (A : Subrepresentation (ρ.comp K.subtype))
    (hA : Nonempty (Representation.Equiv A.toRepresentation (τ.comp K.subtype))) :
    Nonempty (Representation.Equiv (ρ.comp K.subtype)
      (Representation.prod (τ.comp K.subtype) (τ.comp K.subtype))) := by
  obtain ⟨hμirr, hμK, ⟨e⟩⟩ := extension_tensor_decomposition K τ ρ habs A hA
  let μ := homRepresentation K τ ρ
  let : IsIrreducible μ := hμirr
  have hμX : ¬ X ≤ μ.ker := by
    intro hxμ
    apply hact
    intro x hx
    have ht : (τ.tprod μ) x = 1 := by
      apply TensorProduct.ext'
      intro v m
      simp only [Representation.tprod_apply, TensorProduct.map_tmul,
        show τ x = 1 from hτ hx, show μ x = 1 from hxμ hx, Module.End.one_apply]
    apply LinearMap.ext
    intro v
    apply e.injective
    have he := congrArg (fun f : V →ₗ[ZMod 2] (E ⊗[ZMod 2] homSpace K τ ρ) => f v)
      (e.isIntertwining' x)
    change e (ρ x v) = (τ.tprod μ) x (e v) at he
    rw [ht, Module.End.one_apply] at he
    exact he
  have hdim := finrank_eq_two μ K X hX hμK hQ hμX
  let eK : Representation.Equiv (ρ.comp K.subtype) ((τ.tprod μ).comp K.subtype) :=
    .mk e.toLinearEquiv (fun k => e.isIntertwining' (k : H))
  exact ⟨eK.trans (restrictionTensorPair τ μ K hμK hdim)⟩

/-- The extending-constituent multiplicity theorem in the commutator-generation
form used for binary chief factors. -/
theorem restriction_pair_of_extension_of_commutator_eq_top
    (ρ : Representation (ZMod 2) H V) [IsIrreducible ρ]
    (K X : Subgroup H) [K.Normal] [X.Normal]
    (hX : Nat.card X = 3) (hQ : IsPGroup 2 (H ⧸ (K ⊔ X)))
    (hcomm : BinaryOffender.subspaceCommutator ρ ⊤ X = ⊤)
    (τ : Representation (ZMod 2) H E)
    (habs : IsAbsolutelyIrreducible (τ.comp K.subtype)) (hτ : X ≤ τ.ker)
    (A : Subrepresentation (ρ.comp K.subtype))
    (hA : Nonempty (Representation.Equiv A.toRepresentation (τ.comp K.subtype))) :
    Nonempty (Representation.Equiv (ρ.comp K.subtype)
      (Representation.prod (τ.comp K.subtype) (τ.comp K.subtype))) := by
  let : Nontrivial V := Subrepresentation.irreducible_module_nontrivial ρ
  exact restriction_pair_of_extension ρ K X hX hQ
    (not_le_ker_of_commutator_eq_top ρ X hcomm) τ habs hτ A hA

omit [Finite H] in
private theorem quotient_subgroup
    (K X I : Subgroup H) [K.Normal] [X.Normal]
    (hKI : K ≤ I) (hXI : X ≤ I) (hQ : IsPGroup 2 (H ⧸ (K ⊔ X))) :
    IsPGroup 2 (I ⧸ (K.subgroupOf I ⊔ X.subgroupOf I)) := by
  let N := K.subgroupOf I ⊔ X.subgroupOf I
  have hn : N = (K ⊔ X).comap I.subtype :=
    (Subgroup.subgroupOf_sup hKI hXI).symm
  let q : I ⧸ N →* H ⧸ (K ⊔ X) := QuotientGroup.map N (K ⊔ X) I.subtype hn.le
  apply hQ.of_injective q
  rw [← MonoidHom.ker_eq_bot_iff]
  change (QuotientGroup.map N (K ⊔ X) I.subtype hn.le).ker = ⊥
  rw [QuotientGroup.ker_map, ← hn, QuotientGroup.map_mk'_self]

/-- If the constituent extends to a normal subgroup of index two and its other
coset conjugate is inequivalent, the restriction consists of two copies of
each constituent. The displayed grouping is `(σ ⊕ σ) ⊕ (σᵍ ⊕ σᵍ)`.

The irreducible inertia block is constructed from actual occurrence. The cubic
action on that block uses the actual subgroup `X.subgroupOf I`; its multiplicity
is then determined by `restriction_pair_of_extension`. -/
theorem restriction_two_pairs_of_index_two_extension
    (ρ : Representation (ZMod 2) H V) [IsIrreducible ρ]
    (K X : Subgroup H) [K.Normal] [X.Normal]
    (hX : Nat.card X = 3) (hQ : IsPGroup 2 (H ⧸ (K ⊔ X)))
    (hcomm : BinaryOffender.subspaceCommutator ρ ⊤ X = ⊤)
    (I : Subgroup H) [I.Normal] (hKXI : K ⊔ X ≤ I) (hindex : I.index = 2)
    (g : H) (hg : g ∉ I) (τ : Representation (ZMod 2) I E)
    (habs : IsAbsolutelyIrreducible (τ.comp (Subgroup.inclusion (le_sup_left.trans hKXI))))
    (hτ : X.subgroupOf I ≤ τ.ker)
    (A : Subrepresentation (ρ.comp K.subtype))
    (hA : Nonempty (Representation.Equiv A.toRepresentation
      (τ.comp (Subgroup.inclusion (le_sup_left.trans hKXI)))))
    (hne : ¬ Nonempty (Representation.Equiv
      (τ.comp (Subgroup.inclusion (le_sup_left.trans hKXI)))
      (conjugateRep (τ.comp (Subgroup.inclusion (le_sup_left.trans hKXI))) g))) :
    let σ := τ.comp (Subgroup.inclusion (le_sup_left.trans hKXI))
    Nonempty (Representation.Equiv (ρ.comp K.subtype)
      (Representation.prod (Representation.prod σ σ)
        (Representation.prod (conjugateRep σ g) (conjugateRep σ g)))) := by
  let hKI : K ≤ I := le_sup_left.trans hKXI
  let hXI : X ≤ I := le_sup_right.trans hKXI
  let σ := τ.comp (Subgroup.inclusion hKI)
  let : IsAbsolutelyIrreducible σ := habs
  obtain ⟨S, hS, ⟨A', ⟨eA'⟩⟩, ⟨eS⟩⟩ :=
    exists_index_two_inertia_block ρ K I hKI hindex g hg τ A hA hne
  let : IsIrreducible S.toRepresentation := hS
  let : Nontrivial S.toSubmodule :=
    Subrepresentation.irreducible_module_nontrivial S.toRepresentation
  let K' := K.subgroupOf I
  let X' := X.subgroupOf I
  let j : K' ≃* K := Subgroup.subgroupOfEquivOfLe hKI
  have habs' : IsAbsolutelyIrreducible (τ.comp K'.subtype) := by
    constructor
    exact (irreducible_comp_surjective_iff j.toMonoidHom j.surjective
      (extendScalars (AlgebraicClosure (ZMod 2)) σ)).mpr
        habs.irreducible_of_closure
  let B : Subrepresentation (S.toRepresentation.comp K'.subtype) := {
    toSubmodule := A'.toSubmodule
    apply_mem_toSubmodule k v hv := A'.apply_mem_toSubmodule (j k) hv }
  have hB : Nonempty (Representation.Equiv B.toRepresentation (τ.comp K'.subtype)) :=
    ⟨.mk eA'.toLinearEquiv (fun k => eA'.isIntertwining' (j k))⟩
  have hX' : Nat.card X' = 3 :=
    (Nat.card_congr (Subgroup.subgroupOfEquivOfLe hXI).toEquiv).trans hX
  have hQ' := quotient_subgroup K X I hKI hXI hQ
  have hact := not_le_ker_on_subrepresentation ρ I X hXI
    (invariants_eq_bot_of_commutator_eq_top ρ X hcomm) S
  obtain ⟨e⟩ := restriction_pair_of_extension S.toRepresentation K' X'
    hX' hQ' hact τ habs' hτ B hB
  let α := S.toRepresentation.comp (Subgroup.inclusion hKI)
  let eK : Representation.Equiv α (Representation.prod σ σ) :=
    inflationEquiv j.toMonoidHom j.surjective α (Representation.prod σ σ) e
  let eg : Representation.Equiv (conjugateRep α g)
      (Representation.prod (conjugateRep σ g) (conjugateRep σ g)) :=
    (conjugateRepEquiv (RepEquiv.ofRepresentationEquiv eK) g).toRepresentationEquiv
  refine ⟨eS.trans (.mk (eK.toLinearEquiv.prodCongr eg.toLinearEquiv) ?_)⟩
  intro k
  apply LinearMap.ext
  intro v
  exact Prod.ext (congrArg (fun f : S.toSubmodule →ₗ[ZMod 2] (E × E) => f v.1)
      (eK.isIntertwining' k))
    (congrArg (fun f : S.toSubmodule →ₗ[ZMod 2] (E × E) => f v.2)
      (eg.isIntertwining' k))

end Representation.CubicClifford
