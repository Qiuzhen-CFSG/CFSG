private theorem coordinates_zero (m : ℕ) (v : Fin 24 → CoefficientField m)
    (hsq : splitWord m v ^ 2 = 1) : squareCoordinates m v = 0 := by
  have hz : splitWord m (fun _ => 0) = 1 := by simp only [splitWord, xz, mul_one]
  exact splitWord_injective m ((collected m v).symm.trans (hsq.trans hz.symm))

/-- The two initial square coordinates; all 24 split parameters are independent. -/
theorem initial_equations (m : ℕ) (v : Fin 24 → CoefficientField m)
    (hsq : splitWord m v ^ 2 = 1) :
    v 0 * v 22 = 0 ∧ v 1 ^ 2 * v 18 + v 22 * v 3 = 0 := by
  have hv := coordinates_zero m v hsq
  constructor
  · exact congrFun hv 18
  · simpa only [squareCoordinates, poly_269, poly_261, poly_244, poly_7, poly_264, Matrix.cons_val_zero, Matrix.cons_val,
      Fin.reduceFinMk, Pi.zero_apply, mul_comm] using congrFun hv 6

/-- Three square coordinates on the slice with the first B₂ block and the
X₇ and X₃ main parameters removed. No class or conjugacy input is used. -/
theorem normalized_equations (m : ℕ) (v : Fin 24 → CoefficientField m)
    (h0 : v 0 = 0) (h1 : v 1 = 0) (h2 : v 2 = 0) (h3 : v 3 = 0)
    (h18 : v 18 = 0) (h19 : v 19 = 0) (h6 : v 6 = 0) (h7 : v 7 = 0)
    (hsq : splitWord m v ^ 2 = 1) :
    v 12 * v 22 = 0 ∧ v 23 ^ 2 * v 4 = 0 ∧
      v 12 * v 13 ^ 2 + v 12 * v 22 * v 4 + v 21 * v 4 + v 22 * v 9 = 0 := by
  have hv := coordinates_zero m v hsq
  have ha := congrFun hv 21
  have hb := congrFun hv 16
  have hc := congrFun hv 15
  simp only [squareCoordinates, poly_269, poly_261, poly_244, poly_7, poly_264, Matrix.cons_val,
