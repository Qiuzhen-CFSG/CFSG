module

public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor.BasicDensity.PositivePrimitives.Pairing
public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor.BasicDensity.PositivePrimitives.ContravariantForm.Dual
public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor.BasicDensity.PositivePrimitives.ContravariantForm.Opposition
public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor.BasicDensity.PositivePrimitives.ContravariantForm.DualHighestWeight

/-!
# Constructing a contravariant form from rational duality

An equivalence with the actual rational dual supplies an invariant nondegenerate
bilinear form. Precomposing its second variable with an actual representative
of root negation turns invariance into opposite-root adjointness. In
characteristic two root elements are their own inverses, so there is no
parameter sign. Uniqueness of scalar root polynomials gives adjointness of the
first coefficients of the published `RootExpansion`.

For a basic factor generated by negative short-root words, the dual has the
same highest weight, as proved using integral weights and whole root groups
in `ContravariantForm.DualHighestWeight`. Highest-weight uniqueness then
supplies the equivalence with the dual and hence the required pairing.
Neither the primitive-line result nor short-root density is used here.

Source: the rational-duality construction of the contravariant form supporting
Steinberg, *Representations of Algebraic Groups*, Nagoya Math. J. 22 (1963),
§§2, 4, and the primitive-vector argument in 11.1(1),(3),
DOI 10.1017/S0027763000011016.
-/

public section

open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
namespace ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor
noncomputable section
variable {F : Type*} [Field F] [IsAlgClosed F]
local instance shortContravariantRootNeg : InvolutiveNeg F4Chevalley.Root :=
  typeF4RootPairing.indexNeg

/-- Root-group adjointness passes to the actual first polynomial coefficients. -/
theorem RootExpansion.coeff_one_adjoint_of_root_adjoint
    {B : AlgebraicFactor F} (p : RootExpansion B.action)
    (e : B.Space →ₗ[F] Module.Dual F B.Space) (r s : F4Chevalley.Root)
    (h : ∀ (t : F) (x y : B.Space),
      e ((B.action.action (algebraicRootElement r t) : Module.End F B.Space) x) y =
        e x ((B.action.action (algebraicRootElement s t) : Module.End F B.Space) y))
    (x y : B.Space) : e (p.coeff r 1 x) y = e x (p.coeff s 1 y) := by
  have hp : EndNode.Multiplicity.rootPolynomial B r (e.flip y) x =
      EndNode.Multiplicity.rootPolynomial B s (e x) y := by
    apply Polynomial.funext
    intro t
    simpa only [EndNode.Multiplicity.rootPolynomial_eval, LinearMap.flip_apply] using h t x y
  rw [p.coeff_one_eq_rootOperator, p.coeff_one_eq_rootOperator]
  change (e.flip y) (EndNode.Multiplicity.rootOperator B r x) = _
  rw [EndNode.Multiplicity.dual_rootOperator, EndNode.Multiplicity.dual_rootOperator, hp]

namespace ContravariantForm

/-- Actual root elements are involutions in characteristic two. -/
theorem algebraicRootElement_inv [CharP F 2] (r : F4Chevalley.Root) (t : F) :
    (algebraicRootElement r t)⁻¹ = algebraicRootElement r t := by
  have ht : (kPlusPoint t)⁻¹ = kPlusPoint (-t) := by
    apply (additiveGroupPointEquiv F).injective
    rfl
  rw [algebraicRootElement, ← map_inv, ht, CharTwo.neg_eq]

/-- A rational self-duality produces an actual nondegenerate contravariant
pairing after twisting the second argument by opposition. -/
theorem pairing_of_equivalent_dual
    [CharP F 2] {B : AlgebraicFactor F} (p : RootExpansion B.action)
    (τ : RationalRepresentation (F4Chevalley.Carrier (k := F)) (Module.Dual F B.Space))
    (hτ : IsDualRepresentation B.action τ)
    (hself : AreEquivalentRepresentations B.action τ) :
    p.HasShortContravariantPairing := by
  let n : Variety.Point (F4Chevalley.Carrier (k := F)) := oppositionElement
  obtain ⟨e, he⟩ := hself
  let N := LinearMap.GeneralLinearGroup.generalLinearEquiv F B.Space (B.action.action n)
  let E : B.Space ≃ₗ[F] Module.Dual F B.Space := e.trans N.dualMap
  refine ⟨E.toLinearMap, E.injective, ?_⟩
  intro r x y
  apply p.coeff_one_adjoint_of_root_adjoint E.toLinearMap r.val (-r.val) _ x y
  intro t a b
  change e ((B.action.action (algebraicRootElement r.val t) : Module.End F B.Space) a)
    (N b) = e a (N ((B.action.action (algebraicRootElement (-r.val) t) : Module.End F B.Space) b))
  have he' : e ((B.action.action (algebraicRootElement r.val t) : Module.End F B.Space) a) =
      (τ.action (algebraicRootElement r.val t) : Module.End F (Module.Dual F B.Space)) (e a) :=
    he _ a
  rw [he', hτ, algebraicRootElement_inv]
  congr 1
  change (B.action.action (algebraicRootElement r.val t) : Module.End F B.Space)
    ((B.action.action n : Module.End F B.Space) b) =
      (B.action.action n : Module.End F B.Space)
        ((B.action.action (algebraicRootElement (-r.val) t) : Module.End F B.Space) b)
  have hh := congrArg (fun g => (B.action.action g : Module.End F B.Space) b) (root_opposition_commute r.val t)
  simpa only [map_mul, Units.val_mul, Module.End.mul_apply] using hh

end ContravariantForm

/-- Highest-weight uniqueness constructs the form once the rational dual's
highest weight has been identified. The latter is an explicit obligation. -/
theorem RootExpansion.hasShortContravariantPairing_of_dual_highestWeight
    [CharP F 2]
    (hhigh : ∀ (A C : AlgebraicFactor F) (a : Weight),
      HasHighestWeight A a → HasHighestWeight C a →
        AreEquivalentRepresentations A.action C.action)
    {B : AlgebraicFactor F} (p : RootExpansion B.action) {b : BasicWeight} {v : B.Space}
    (hv : B.IsBasicHighestWeightVector b v)
    (hdual : HasHighestWeight (ContravariantForm.dualFactor B) (basicCoefficient b)) :
    p.HasShortContravariantPairing := by
  exact ContravariantForm.pairing_of_equivalent_dual p _
    (ContravariantForm.dualFactor_spec B)
    (hhigh B (ContravariantForm.dualFactor B) (basicCoefficient b) ⟨v, hv⟩ hdual)

/-- A nonzero basic highest weight and negative short-root cyclicity give an
actual nondegenerate contravariant pairing, using highest-weight uniqueness.
The dual highest weight and opposition transport are proved, not assumed. -/
theorem RootExpansion.hasShortContravariantPairing_of_negative_span
    [CharP F 2]
    (hhigh : ∀ (A C : AlgebraicFactor F) (a : Weight),
      HasHighestWeight A a → HasHighestWeight C a →
        AreEquivalentRepresentations A.action C.action)
    {B : AlgebraicFactor F} (p : RootExpansion B.action) {b : BasicWeight} {v : B.Space}
    (hb : b ≠ (0, 0)) (hv : B.IsBasicHighestWeightVector b v)
    (hspan : p.shortNegativeSpan v = ⊤) :
    p.HasShortContravariantPairing :=
  p.hasShortContravariantPairing_of_dual_highestWeight hhigh hv
    (ContravariantForm.dualFactor_hasHighestWeight B b p hb hv hspan)

end
end ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor
