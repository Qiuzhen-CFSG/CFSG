module

public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor.BasicDensity
public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor.BasicDensity.NegativeCyclicity.Basic

public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.BasicMinimum.EndNode.Multiplicity.RankOneCoefficients

/-!
# Simple quotients of the actual infinitesimal highest-vector module

The associative algebra generated by all canonical F₄ root operators acts on
an algebraic factor. The submodule generated by a nonzero highest vector has
a maximal proper submodule, hence a nonzero simple quotient. The original
vector survives in every such quotient. The positive root operators kill its
image, and the simple coroot commutators have the prescribed basic eigenvalues.
All algebra relations are inherited through the surjective module map; these
operators are not an independent family unrelated to the original action.

`SimpleCyclicQuotient.RationalLift` specifies the remaining integration problem:
construct a rational action on that quotient, with these actual degree-one
operators and the integral basic highest weight. Its existence is not asserted
here. A lift is automatically group-irreducible because its differential is
already simple. This separates the elementary simple-quotient construction
from the substantive lifting argument.

Source: Steinberg, *Representations of Algebraic Groups*, Nagoya Math. J.
22 (1963), Curtis 2.7 and §§4.1–4.9; DOI 10.1017/S0027763000011016.
-/

public section

open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
namespace ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor.NegativeCyclicity.RestrictedBridge
noncomputable section
universe u
variable {F : Type u} [Field F] [IsAlgClosed F]

/-- The algebra generated by all canonical first-degree root operators. -/
abbrev rootAlgebra (B : AlgebraicFactor F) :=
  Algebra.adjoin F (Set.range (EndNode.Multiplicity.rootOperator B))

local instance rootAlgebra_ring (B : AlgebraicFactor F) : Ring (rootAlgebra B) :=
  (rootAlgebra B).toRing

/-- A canonical root operator, regarded as an element of the generated algebra. -/
@[expose] def rootGenerator (B : AlgebraicFactor F) (r : F4Chevalley.Root) : rootAlgebra B :=
  ⟨EndNode.Multiplicity.rootOperator B r, Algebra.subset_adjoin ⟨r, rfl⟩⟩

/-- The actual infinitesimal submodule generated by the specified vector. -/
abbrev cyclicSubmodule (B : AlgebraicFactor F) (v : B.Space) :=
  Submodule.span (rootAlgebra B) {v}

local instance cyclicSubmodule_addCommGroup (B : AlgebraicFactor F) (v : B.Space) :
    AddCommGroup (cyclicSubmodule B v) := (cyclicSubmodule B v).addCommGroup

local instance cyclicSubmodule_rootModule (B : AlgebraicFactor F) (v : B.Space) :
    Module (rootAlgebra B) (cyclicSubmodule B v) := (cyclicSubmodule B v).module

/-- The distinguished vector in its infinitesimal cyclic submodule. -/
@[expose] def cyclicVector (B : AlgebraicFactor F) (v : B.Space) : cyclicSubmodule B v :=
  ⟨v, Submodule.mem_span_singleton_self v⟩

/-- The infinitesimal cyclic submodule is finite-dimensional over the ground field. -/
instance cyclicSubmodule_finiteDimensional (B : AlgebraicFactor F) (v : B.Space) :
    FiniteDimensional F (cyclicSubmodule B v) :=
  FiniteDimensional.of_injective ((cyclicSubmodule B v).subtype.restrictScalars F)
    (Submodule.subtype_injective _)

/-- The distinguished vector generates its cyclic submodule over the root algebra. -/
theorem cyclicVector_generates (B : AlgebraicFactor F) (v : B.Space) :
    Submodule.span (rootAlgebra B) {cyclicVector B v} = ⊤ := by
  apply top_unique
  intro w _
  obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp w.property
  have he : a • cyclicVector B v = w := Subtype.ext ha
  exact he ▸ (Submodule.span (rootAlgebra B) {cyclicVector B v}).smul_mem a
    (Submodule.mem_span_singleton_self _)

/-- A simple quotient with its actual surjective module map. Existence is proved below. -/
structure SimpleCyclicQuotient (B : AlgebraicFactor F) (v : B.Space) where
  Space : Type u
  [addCommGroup : AddCommGroup Space]
  [module : Module F Space]
  [rootModule : Module (rootAlgebra B) Space]
  [scalarTower : IsScalarTower F (rootAlgebra B) Space]
  [finiteDimensional : FiniteDimensional F Space]
  [simple : IsSimpleModule (rootAlgebra B) Space]
  projection : cyclicSubmodule B v →ₗ[rootAlgebra B] Space
  surjective : Function.Surjective projection

attribute [instance] SimpleCyclicQuotient.addCommGroup SimpleCyclicQuotient.module
  SimpleCyclicQuotient.rootModule SimpleCyclicQuotient.scalarTower
  SimpleCyclicQuotient.finiteDimensional SimpleCyclicQuotient.simple

/-- A simple module has nonzero underlying vector space. -/
instance SimpleCyclicQuotient.nontrivial {B : AlgebraicFactor F} {v : B.Space}
    (Q : SimpleCyclicQuotient B v) : Nontrivial Q.Space :=
  IsSimpleModule.nontrivial (rootAlgebra B) Q.Space

/-- A maximal proper submodule supplies a simple quotient; no differential simplicity of `B` is used. -/
theorem exists_simpleCyclicQuotient (B : AlgebraicFactor F) {v : B.Space} (hv : v ≠ 0) :
    Nonempty (SimpleCyclicQuotient B v) := by
  have hv' : cyclicVector B v ≠ 0 := fun h => hv (congrArg Subtype.val h)
  let : Nontrivial (cyclicSubmodule B v) := ⟨⟨cyclicVector B v, 0, hv'⟩⟩
  obtain ⟨N, hN⟩ := IsCoatomic.exists_coatom (Submodule (rootAlgebra B) (cyclicSubmodule B v))
  let : IsSimpleModule (rootAlgebra B) ((cyclicSubmodule B v) ⧸ N) :=
    isSimpleModule_iff_isCoatom.mpr hN
  let : FiniteDimensional F ((cyclicSubmodule B v) ⧸ N) :=
    Module.Finite.of_surjective (N.mkQ.restrictScalars F) N.mkQ_surjective
  exact ⟨{ Space := (cyclicSubmodule B v) ⧸ N
           projection := N.mkQ
           surjective := N.mkQ_surjective }⟩

namespace SimpleCyclicQuotient
variable {B : AlgebraicFactor F} {v : B.Space} (Q : SimpleCyclicQuotient B v)

/-- The image of the original highest vector under the quotient map. -/
@[expose] def highestVector : Q.Space := Q.projection (cyclicVector B v)

/-- A surjective map to a nonzero module cannot kill a cyclic generator. -/
theorem highestVector_ne_zero : Q.highestVector ≠ 0 := by
  intro hz
  have hker : LinearMap.ker Q.projection = ⊤ := by
    apply top_unique
    rw [← cyclicVector_generates B v]
    apply Submodule.span_le.mpr
    intro w hw
    rcases Set.mem_singleton_iff.mp hw with rfl
    exact hz
  have hzero : Q.projection = 0 := LinearMap.ker_eq_top.mp hker
  obtain ⟨w, hw⟩ := exists_ne (0 : Q.Space)
  obtain ⟨x, rfl⟩ := Q.surjective w
  exact hw (by rw [hzero]; rfl)

/-- The root operator induced by the original root algebra on the quotient. -/
@[expose] def operator (r : F4Chevalley.Root) : Module.End F Q.Space :=
  Representation.jacobson_density_mapping F (rootAlgebra B) Q.Space (rootGenerator B r)

/-- Root operators commute with the actual quotient map. -/
theorem operator_projection (r : F4Chevalley.Root) (w : cyclicSubmodule B v) :
    Q.operator r (Q.projection w) = Q.projection (rootGenerator B r • w) := by
  exact (Q.projection.map_smul _ _).symm

/-- Root invariance extends to the generated algebra, whose quotient is simple. -/
theorem operatorInvariant_eq_bot_or_top (W : Submodule F Q.Space)
    (hW : ∀ r w, w ∈ W → Q.operator r w ∈ W) : W = ⊥ ∨ W = ⊤ := by
  have hstable (a : rootAlgebra B) : ∀ w ∈ W, a • w ∈ W := by
    obtain ⟨a, ha⟩ := a
    induction ha using Algebra.adjoin_induction with
    | mem x hx =>
      obtain ⟨r, rfl⟩ := hx
      exact hW r
    | algebraMap c =>
      intro w hw
      change (algebraMap F (rootAlgebra B)) c • w ∈ W
      simpa only [algebraMap_smul] using W.smul_mem c hw
    | add x y hx hy ihx ihy =>
      intro w hw
      change ((⟨x, hx⟩ : rootAlgebra B) + ⟨y, hy⟩) • w ∈ W
      rw [add_smul]
      exact W.add_mem (ihx w hw) (ihy w hw)
    | mul x y hx hy ihx ihy =>
      intro w hw
      change ((⟨x, hx⟩ : rootAlgebra B) * ⟨y, hy⟩) • w ∈ W
      rw [mul_smul]
      exact ihx _ (ihy w hw)
  let WA : Submodule (rootAlgebra B) Q.Space :=
    { W.toAddSubmonoid with smul_mem' := fun a w hw => hstable a w hw }
  rcases eq_bot_or_eq_top WA with h | h
  · left
    apply le_bot_iff.mp
    intro w hw
    exact (show w ∈ (⊥ : Submodule (rootAlgebra B) Q.Space) from h ▸ hw)
  · right
    apply top_unique
    intro w _
    exact (show w ∈ WA from h.symm ▸ (show w ∈ (⊤ : Submodule (rootAlgebra B) Q.Space) from trivial))

/-- The quotient root operators generate its full endomorphism algebra. -/
theorem operator_adjoin_eq_top :
    Algebra.adjoin F (Set.range Q.operator) = ⊤ :=
  BasicDensity.adjoin_eq_top_of_irreducible Q.operator Q.operatorInvariant_eq_bot_or_top

/-- The image of a genuine highest vector is infinitesimally primitive. -/
theorem positive_operator_highest_eq_zero {b : BasicWeight}
    (hv : B.IsBasicHighestWeightVector b v) (r : F4Chevalley.Root)
    (hr : typeF4RootPairing_base.IsPos r) : Q.operator r Q.highestVector = 0 := by
  rw [highestVector, operator_projection]
  have he : rootGenerator B r • cyclicVector B v = 0 := by
    apply Subtype.ext
    exact EndNode.Multiplicity.rootOperator_eq_zero_of_fixed B r v (hv.2.1 r hr)
  rw [he, map_zero]


local instance : InvolutiveNeg F4Chevalley.Root := typeF4RootPairing.indexNeg

/-- The simple coroot commutator has the basic eigenvalue; this records only the residue in `F`. -/
theorem simple_commutator_highest [CharP F 2] {b : BasicWeight}
    (hv : B.IsBasicHighestWeightVector b v) (i : Fin 4) :
    (Q.operator (typeF4SimpleRootIndex i) * Q.operator (-typeF4SimpleRootIndex i) -
      Q.operator (-typeF4SimpleRootIndex i) * Q.operator (typeF4SimpleRootIndex i))
        Q.highestVector = (basicCoefficient b i : F) • Q.highestVector := by
  have hpos := hv.2.1 _ (typeF4RootPairing_base.isPos_of_mem_support
    (typeF4RootPairing_baseEquiv i).property)
  have hstring : EndNode.Multiplicity.rootOperator B (typeF4SimpleRootIndex i)
      (EndNode.Multiplicity.rootOperator B (-typeF4SimpleRootIndex i) v) =
        (basicCoefficient b i : F) • v := by
    by_cases h0 : basicCoefficient b i = 0
    · have hl : EndNode.Multiplicity.rootOperator B (-typeF4SimpleRootIndex i) v = 0 :=
        EndNode.Multiplicity.rootOperator_eq_zero_of_fixed B _ v
          (negative_simple_fixed_of_zero B i v hpos
            (fun t => by simpa [h0] using hv.2.2 i t))
      simp only [hl, map_zero, h0, Nat.cast_zero, zero_smul]
    · exact EndNode.Multiplicity.raising_lowering_highest B i _
        (Nat.pos_of_ne_zero h0) v hpos (hv.2.2 i)
  have hstring' : rootGenerator B (typeF4SimpleRootIndex i) •
      (rootGenerator B (-typeF4SimpleRootIndex i) • cyclicVector B v) =
        (basicCoefficient b i : F) • cyclicVector B v := by
    apply Subtype.ext
    exact hstring
  have hk : Q.operator (typeF4SimpleRootIndex i) Q.highestVector = 0 :=
    Q.positive_operator_highest_eq_zero hv _
      (typeF4RootPairing_base.isPos_of_mem_support (typeF4RootPairing_baseEquiv i).property)
  rw [LinearMap.sub_apply, Module.End.mul_apply, Module.End.mul_apply, hk,
    map_zero, sub_zero, highestVector, operator_projection, operator_projection, hstring']
  exact (Q.projection.restrictScalars F).map_smul _ _

/-- An actual rational lift of a simple infinitesimal quotient. The degree-one
coefficients must recover the quotient operators, and the group highest vector
has the specified integral coroot exponents, not merely their residues in `F`.
No existence is asserted by this structure. -/
structure RationalLift (b : BasicWeight) where
  action : RationalRepresentation (F4Chevalley.Carrier (k := F)) Q.Space
  rational : IsRationalRepresentation action
  expansion : RootExpansion action
  coeff_one : ∀ r, expansion.coeff r 1 = Q.operator r
  positive_fixed : ∀ r : F4Chevalley.Root, typeF4RootPairing_base.IsPos r → ∀ t : F,
    (action.action (algebraicRootElement r t) : Module.End F Q.Space) Q.highestVector =
      Q.highestVector
  coroot_weight : ∀ (i : Fin 4) (t : Fˣ),
    (action.action (algebraicCorootElement (typeF4SimpleRootIndex i) t) :
      Module.End F Q.Space) Q.highestVector =
        ((t : F) ^ basicCoefficient b i) • Q.highestVector

namespace RationalLift
variable {Q} {b : BasicWeight} (L : Q.RationalLift b)

/-- Group-invariant subspaces of a rational lift are invariant under its first root coefficients. -/
theorem irreducible : IsIrreducibleRepresentation L.action := by
  refine ⟨L.rational, ?_⟩
  intro W hW
  apply Q.operatorInvariant_eq_bot_or_top W
  intro r w hw
  rw [← L.coeff_one]
  exact L.expansion.coeff_mem W hW r 1 hw

/-- Package a rational lift as an actual algebraic factor. -/
@[expose] def factor : AlgebraicFactor F where
  Space := Q.Space
  action := L.action
  irreducible := L.irreducible

/-- The lift has the specified integral group highest weight. -/
theorem hasHighestWeight : HasHighestWeight L.factor (basicCoefficient b) :=
  ⟨Q.highestVector, Q.highestVector_ne_zero, L.positive_fixed, L.coroot_weight⟩

/-- The canonical operator of the lifted factor is the original quotient operator. -/
theorem rootOperator_eq (r : F4Chevalley.Root) :
    EndNode.Multiplicity.rootOperator L.factor r = Q.operator r := by
  exact (L.expansion.coeff_one_eq_rootOperator (B := L.factor) r).symm.trans (L.coeff_one r)

end RationalLift

end SimpleCyclicQuotient

end
end ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor.NegativeCyclicity.RestrictedBridge
