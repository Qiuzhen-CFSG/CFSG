module

public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor.BasicDensity.NegativeCyclicity.RestrictedBridge.CyclicQuotient

/-!
# The conjugation interface for lifting a simple differential quotient

Steinberg's construction has two separate steps. Curtis's highest-line and
conjugacy results supply intertwiners for the action twisted by group
conjugation. One then normalizes those intertwiners on root groups, proves the
group relations, and establishes rationality of the resulting ordinary action.

The interface below connects conjugation to the original algebraic action on
`B.Space` and intertwines its induced action on the actual simple quotient.
The primitive-line clause concerns all positive roots on that quotient. It
does not assert a primitive-line or irreducibility theorem about `B` itself.
No existence of these data, or of a rational lift, is asserted here.

Source: Steinberg, *Representations of Algebraic Groups*, Nagoya Math. J.
22 (1963), Curtis 2.7 and equations 4.1–4.2;
DOI 10.1017/S0027763000011016.
-/

public section

open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
namespace ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor.NegativeCyclicity.RestrictedBridge
noncomputable section
universe u
variable {F : Type u} [Field F] [IsAlgClosed F]

namespace SimpleCyclicQuotient

/-- The precise infinitesimal inputs to normalization and rational lifting.
The intertwiners are not assumed multiplicative or rational. -/
structure ConjugationData {B : AlgebraicFactor F} {v : B.Space}
    (Q : SimpleCyclicQuotient B v) where
  /-- Conjugation preserves the algebra generated by the actual root operators. -/
  conjugate : PointGroup F → rootAlgebra B ≃ₐ[F] rootAlgebra B
  /-- Its underlying operator is conjugation by the original group action. -/
  conjugate_eq : ∀ (g : PointGroup F) (a : rootAlgebra B),
    (conjugate g a : Module.End F B.Space) =
      (B.action.action g : Module.End F B.Space) * (a : Module.End F B.Space) *
        (B.action.action g⁻¹ : Module.End F B.Space)
  /-- Each conjugate of the simple differential module is equivalent to it. -/
  implementer : ∀ g : PointGroup F, ∃ T : Q.Space ≃ₗ[F] Q.Space,
    ∀ (a : rootAlgebra B) (w : Q.Space), T (a • w) = conjugate g a • T w
  /-- The full positive infinitesimal action has exactly one primitive line. -/
  primitive_line : ∀ w : Q.Space,
    (∀ r : F4Chevalley.Root, typeF4RootPairing_base.IsPos r → Q.operator r w = 0) →
      w ∈ Submodule.span F {Q.highestVector}

end SimpleCyclicQuotient
end
end ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor.NegativeCyclicity.RestrictedBridge
