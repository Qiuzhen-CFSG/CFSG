module
public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor.BasicDensity.NegativeCyclicity.RestrictedBridge.Conjugation.Basic
public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor.BasicDensity.NegativeCyclicity.SpanInvariance.Cartan.Transfer
public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.Geometry.ExceptionalMorphism.ShortTransport
import all Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.BasicMinimum.ZeroAndMiddle.Geometry
import all Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor.BasicDensity.NegativeCyclicity.SpanInvariance.Cartan.Transfer

/-!
# Normalization of the canonical F4 root algebra

The first coefficients of the rational root actions are the images of the
actual root tangents under the representation differential. The injective
differential of the closed matrix inclusion detects tangent identities.
Full adjoint equivariance of the integral F4 realization therefore expresses
every conjugated root tangent as a linear combination of root tangents and
simple Cartan brackets. Applying the representation differential puts the
conjugated operator in the algebra generated by the canonical root operators.

The Cartan coordinates are brackets of opposite simple-root tangents. Thus the
argument includes opposite roots and their Cartan contribution, and uses no
highest-weight or differential-irreducibility premise.

The private implementation imports identify the chosen matrix realization and
its tangent differential, preserving their existing public boundaries. The
coordinate proof of differential equivariance works in characteristic two and
uses only the narrow tangent and rational-matrix interfaces.

Source: Steinberg, *Representations of Algebraic Groups*, Nagoya Math. J.
22 (1963), §§2–4, especially 2.5 and 4.1–4.2;
DOI 10.1017/S0027763000011016.
-/

open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
open RootPairing.IntegralGeckConstruction
open scoped Classical Matrix
namespace ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor.NegativeCyclicity.RestrictedBridge
noncomputable section
set_option backward.isDefEq.respectTransparency false
universe u v
variable {F : Type u} [Field F] [IsAlgClosed F]
attribute [local instance] LieRing.ofAssociativeRing
local instance normalizationNeg : InvolutiveNeg F4Chevalley.Root := typeF4RootPairing.indexNeg
open SpanInvariance.CartanTransfer

private def differential {G : Variety F} [AlgebraicGroup G]
    {V : Type v} [AddCommGroup V] [Module F V] [FiniteDimensional F V]
    (b : Module.Basis (Fin (Module.finrank F V)) F V)
    (f : Theory.AlgebraicGroup.Morphism G (glVarietyOf F V)) :
    IdentityPointDerivation G →ₗ⁅F⁆ Module.End F V :=
  (Bor1.ReeF4CartanDifferential.generalLinearIdentityTangentLieHom b).comp
    (identityTangentMorphismLieHom f)

private theorem differential_linearMatrixCoefficient
    {G : Variety F} [AlgebraicGroup G]
    {V : Type v} [AddCommGroup V] [Module F V] [FiniteDimensional F V]
    (ρ : RationalRepresentation G V)
    (b : Module.Basis (Fin (Module.finrank F V)) F V)
    (f : Theory.AlgebraicGroup.Morphism G (glVarietyOf F V))
    (D : IdentityPointDerivation G) (l : Module.Dual F V) (w : V) :
    l (differential b f D w) = D (rationalRepresentationLinearMatrixCoefficient ρ b f l w) := by
  rw [rationalRepresentationLinearMatrixCoefficient]
  change l ((∑ i, ∑ j,
    D (rationalRepresentationMatrixCoefficient ρ b f i j) • b.end (i, j)) w) = _
  simp only [LinearMap.sum_apply, LinearMap.smul_apply, map_sum]
  have he (i j : Fin (Module.finrank F V)) :
      b.end (i, j) w = b.repr w j • b i := by
    rw [← b.sum_repr w]
    simp only [map_sum]
    rw [Finset.sum_eq_single j]
    · simp [b.end_apply_apply]
    · intro x _ hx
      simp [b.end_apply_apply, Ne.symm hx]
    · simp
  simp_rw [he]
  simp only [map_smul]
  simp_rw [D.leibniz]
  have hsmul (q : G.PolynomialFunction) (a : F) : q • a = q 1 * a := rfl
  simp_rw [hsmul]
  simp only [Derivation.map_algebraMap, mul_zero, add_zero,
    polynomialFunction_algebraMap_apply]
  ring_nf

private theorem differential_conjugation
    {G : Variety F} [AlgebraicGroup G]
    {V : Type v} [AddCommGroup V] [Module F V] [FiniteDimensional F V]
    (ρ : RationalRepresentation G V)
    (b : Module.Basis (Fin (Module.finrank F V)) F V)
    (f : Theory.AlgebraicGroup.Morphism G (glVarietyOf F V))
    (hf : ∀ g, glPointEquivOf F V b (f.onPoints g) = ρ.action g)
    (g : Variety.Point G) (D : IdentityPointDerivation G) :
    differential b f (Bor1.identityTangentConjugationLinearMap G g D) =
      (ρ.action g : Module.End F V) * differential b f D *
        (ρ.action g⁻¹ : Module.End F V) := by
  ext w
  apply b.ext_elem
  intro i
  let l := b.coord i
  let l' := l.comp (ρ.action g : Module.End F V)
  let w' := (ρ.action g⁻¹ : Module.End F V) w
  change l (differential b f (Bor1.identityTangentConjugationLinearMap G g D) w) = _
  rw [differential_linearMatrixCoefficient ρ]
  rw [Bor1.identityTangentConjugationLinearMap_apply]
  have hp : (Theory.AlgebraicGroup.conjugationByMorphism G g).pullbackAlgHom
      (rationalRepresentationLinearMatrixCoefficient ρ b f l w) =
      rationalRepresentationLinearMatrixCoefficient ρ b f l' w' := by
    apply Variety.PolynomialFunction.ext
    intro x
    change rationalRepresentationLinearMatrixCoefficient ρ b f l w (g * x * g⁻¹) = _
    rw [rationalRepresentationLinearMatrixCoefficient_apply ρ b f hf,
      rationalRepresentationLinearMatrixCoefficient_apply ρ b f hf]
    simp only [map_mul, Units.val_mul, Module.End.mul_apply]
    rfl
  rw [hp, ← differential_linearMatrixCoefficient ρ]
  rfl

private theorem differential_root (B : AlgebraicFactor F)
    (b : Module.Basis (Fin (Module.finrank F B.Space)) F B.Space)
    (f : Theory.AlgebraicGroup.Morphism (F4Chevalley.Carrier (k := F)) (glVarietyOf F B.Space))
    (hf : ∀ g, glPointEquivOf F B.Space b (f.onPoints g) = B.action.action g)
    (r : F4Chevalley.Root) :
    differential b f (rootTangent r) = EndNode.Multiplicity.rootOperator B r := by
  ext w
  apply b.ext_elem
  intro i
  change b.coord i (differential b f (rootTangent r) w) =
    b.coord i (EndNode.Multiplicity.rootOperator B r w)
  rw [differential_linearMatrixCoefficient B.action,
    rootTangent_apply_of_polynomial r _ (EndNode.Multiplicity.rootPolynomial B r (b.coord i) w),
    ← EndNode.Multiplicity.dual_rootOperator]
  intro t
  rw [EndNode.Multiplicity.rootPolynomial_eval,
    rationalRepresentationLinearMatrixCoefficient_apply B.action b f hf]

private theorem natural_action (g : PointGroup F) :
    glPointEquivOf F (F4Chevalley.BasisIndex → F)
      (carrierBasis (P := typeF4RootPairing) (b := typeF4RootPairing_base))
      ((F4Chevalley.ambientClosedCarrier (k := F)).inclusion.onPoints g) =
      Matrix.GeneralLinearGroup.toLin (ZeroAndMiddle.carrierMatrix g) := by
  have h := ZeroAndMiddle.matrixAmbientEquiv.apply_symm_apply
    ((F4Chevalley.ambientClosedCarrier (k := F)).inclusion.onPoints g)
  change ZeroAndMiddle.matrixToAmbient (ZeroAndMiddle.carrierMatrix g) = _ at h
  rw [← h]
  exact glPointEquivOf_generalLinearRepresentationPoint _ _

private theorem matrixDifferential_conjugation (g : PointGroup F)
    (D : IdentityPointDerivation (F4Chevalley.Carrier (k := F))) :
    matrixDifferential (Bor1.identityTangentConjugationLinearMap _ g D) =
      (ZeroAndMiddle.carrierMatrix g).val * matrixDifferential D *
        (ZeroAndMiddle.carrierMatrix g⁻¹).val := by
  let ρ : RationalRepresentation (F4Chevalley.Carrier (k := F))
      (F4Chevalley.BasisIndex → F) :=
    ⟨Matrix.GeneralLinearGroup.toLin.toMonoidHom.comp ZeroAndMiddle.carrierMatrix⟩
  have h := differential_conjugation ρ
    (carrierBasis (P := typeF4RootPairing) (b := typeF4RootPairing_base))
    (F4Chevalley.ambientClosedCarrier (k := F)).inclusion natural_action g D
  change naturalDifferential (Bor1.identityTangentConjugationLinearMap _ g D) =
    (Matrix.GeneralLinearGroup.toLin (ZeroAndMiddle.carrierMatrix g)).val *
      naturalDifferential D *
      (Matrix.GeneralLinearGroup.toLin (ZeroAndMiddle.carrierMatrix g⁻¹)).val at h
  have hm := congrArg (LinearMap.toMatrixAlgEquiv' (R := F) (n := F4Chevalley.BasisIndex)) h
  have hmat (A : (Matrix F4Chevalley.BasisIndex F4Chevalley.BasisIndex F)ˣ) :
      LinearMap.toMatrixAlgEquiv' (Matrix.GeneralLinearGroup.toLin A).val = A.val :=
    LinearMap.toMatrixAlgEquiv'_toLinAlgEquiv' A.val
  simp only [map_mul, hmat] at hm
  exact hm

private def coordinateTangent : F4Chevalley.BasisIndex →
    IdentityPointDerivation (F4Chevalley.Carrier (k := F))
  | Sum.inr r => rootTangent r
  | Sum.inl i =>
      ⁅rootTangent (F := F) (i : F4Chevalley.Root), rootTangent (F := F) (-i : F4Chevalley.Root)⁆

private theorem matrixDifferential_coordinateTangent (j : F4Chevalley.BasisIndex) :
    matrixDifferential (coordinateTangent (F := F) j) =
      Geometry.ExceptionalMorphism.coordinateOperator (K := F) j := by
  cases j with
  | inr r =>
    rw [coordinateTangent, matrixDifferential_rootTangent]
    rfl
  | inl i =>
    rw [coordinateTangent, LieHom.map_lie, matrixDifferential_rootTangent,
      matrixDifferential_rootTangent, Ring.lie_def,
      F4Chevalley.integralOperators.operator_simple,
      F4Chevalley.integralOperators.operator_neg_simple]
    rfl

private def tangentLift (w : F4Chevalley.BasisIndex → F) :
    IdentityPointDerivation (F4Chevalley.Carrier (k := F)) :=
  ∑ j, w j • coordinateTangent j

private theorem matrixDifferential_tangentLift (w : F4Chevalley.BasisIndex → F) :
    matrixDifferential (tangentLift w) = Geometry.ExceptionalMorphism.adjointMap w := by
  simp only [tangentLift, map_sum, map_smul, matrixDifferential_coordinateTangent]
  rfl

private theorem carrierMatrix_mem (g : PointGroup F) :
    ZeroAndMiddle.carrierMatrix g ∈ Geometry.ExceptionalMorphism.matrixGroup F := by
  have htop : (⊤ : Subgroup (PointGroup F)) ≤
      (Geometry.ExceptionalMorphism.matrixGroup F).comap ZeroAndMiddle.carrierMatrix := by
    rw [← algebraicRootElements_generate]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨⟨r, t⟩, rfl⟩
    change ZeroAndMiddle.carrierMatrix (algebraicRootElement r t) ∈
      Geometry.ExceptionalMorphism.matrixGroup F
    rw [ZeroAndMiddle.carrierMatrix_root]
    exact Subgroup.subset_closure ⟨(r, t), rfl⟩
  exact htop (Subgroup.mem_top g)

private theorem conjugate_rootTangent [CharP F 2] (g : PointGroup F)
    (r : F4Chevalley.Root) :
    Bor1.identityTangentConjugationLinearMap _ g (rootTangent r) =
      tangentLift ((ZeroAndMiddle.carrierMatrix g).val *ᵥ Pi.single (Sum.inr r) 1) := by
  apply matrixDifferential_injective
  rw [matrixDifferential_conjugation, matrixDifferential_rootTangent,
    matrixDifferential_tangentLift]
  have h := Geometry.ExceptionalMorphism.adjointMap_equivariant
    (ZeroAndMiddle.carrierMatrix g) (carrierMatrix_mem g) (Pi.single (Sum.inr r) 1)
  rw [Geometry.ExceptionalMorphism.adjointMap_root_single] at h
  have he := congrArg (fun A => A * ((ZeroAndMiddle.carrierMatrix g)⁻¹).val) h
  simpa only [specializeMatrix, mul_assoc, Units.val_mul, Units.mul_inv, mul_one, map_inv] using he.symm

private theorem differential_tangentLift_mem (B : AlgebraicFactor F)
    (b : Module.Basis (Fin (Module.finrank F B.Space)) F B.Space)
    (f : Theory.AlgebraicGroup.Morphism (F4Chevalley.Carrier (k := F)) (glVarietyOf F B.Space))
    (hf : ∀ g, glPointEquivOf F B.Space b (f.onPoints g) = B.action.action g)
    (w : F4Chevalley.BasisIndex → F) :
    differential b f (tangentLift w) ∈ rootAlgebra B := by
  have hr (r : F4Chevalley.Root) : EndNode.Multiplicity.rootOperator B r ∈ rootAlgebra B :=
    Algebra.subset_adjoin ⟨r, rfl⟩
  simp only [tangentLift, map_sum, map_smul]
  apply Subalgebra.sum_mem
  intro j _
  apply Subalgebra.smul_mem
  cases j with
  | inr r =>
    simpa only [coordinateTangent, differential_root B b f hf] using hr r
  | inl i =>
    simp only [coordinateTangent, LieHom.map_lie, differential_root B b f hf, Ring.lie_def]
    exact (rootAlgebra B).sub_mem ((rootAlgebra B).mul_mem (hr _) (hr _))
      ((rootAlgebra B).mul_mem (hr _) (hr _))

/-- The algebra generated by the canonical first root coefficients is preserved
by conjugation under the actual rational F4 action, including opposite roots. -/
public theorem rootConjugationStable [CharP F 2] (B : AlgebraicFactor F) :
    RootConjugationStable B := by
  obtain ⟨b, f, hf⟩ := B.irreducible.1
  intro g r
  rw [ambientConjugation_apply, ← differential_root B b f hf r,
    ← differential_conjugation B.action b f hf, conjugate_rootTangent]
  exact differential_tangentLift_mem B b f hf _

end
