module

public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor.BasicDensity.NegativeCyclicity.RestrictedBridge.Conjugation.HighestLine.Nilpotence
public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor.BasicDensity.NegativeCyclicity.RestrictedBridge.Conjugation.HighestLine.Triangular
public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor.BasicDensity.NegativeCyclicity.RestrictedBridge.Conjugation.RestrictedRelations
public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor.BasicDensity.NegativeCyclicity.RestrictedBridge.ProjectiveData

/-!
# The full positive-root highest line on the actual simple quotient

Let `J` be the sum of the negative-root images. Triangular spanning and the
Cartan eigenvalues of the distinguished vector give `Q = F v₊ + J`. For a
positive-primitive vector in `J`, triangular words send it into `J`, provided
Cartan operators preserve `J`. Simplicity then forces this vector to vanish
when `J` is proper. It follows that the entire primitive space is `F v₊`.

The imported integral-weight argument proves joint negative-word vanishing,
and the canonical root commutator relations prove triangular spanning and
Cartan stability. Thus `SimpleCyclicQuotient.primitive_line` discharges every
auxiliary premise of the reduction. It establishes the primitive-line clause
of Curtis 2.7 for this actual simple quotient, without a rational lift,
normalization, or kernel-stability assumption.

Source: Steinberg, *Representations of Algebraic Groups*, Nagoya Math. J.
22 (1963), §2, Curtis 2.7 and (2.8); DOI 10.1017/S0027763000011016.
-/

public section
open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
namespace ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor.NegativeCyclicity.RestrictedBridge
noncomputable section
universe u
variable {F : Type u} [Field F] [IsAlgClosed F]

namespace SimpleCyclicQuotient
open HighestLine
variable {B : AlgebraicFactor F} {v : B.Space} (Q : SimpleCyclicQuotient B v)

private theorem apply_mem_of_triangular (htri : Q.triangularSpan = ⊤)
    (W : Submodule F Q.Space) (w : Q.Space)
    (hword : ∀ l h r, Q.triangularWord l h r w ∈ W)
    (a : Module.End F Q.Space) : a w ∈ W := by
  have ha : a ∈ Q.triangularSpan := by rw [htri]; trivial
  induction ha using Submodule.span_induction with
  | mem a ha =>
    obtain ⟨l, h, r, rfl⟩ := ha
    exact hword l h r
  | zero => simpa only [LinearMap.zero_apply] using W.zero_mem
  | add a b ha hb iha ihb =>
    simpa only [LinearMap.add_apply] using W.add_mem iha ihb
  | smul c a ha ih =>
    simpa only [LinearMap.smul_apply] using W.smul_mem c ih

private theorem positive_word_apply (w : Q.Space)
    (hw : ∀ r : F4Chevalley.Root, typeF4RootPairing_base.IsPos r →
      Q.operator r w = 0) (l : List PositiveRoot) :
    (l.map fun r => Q.operator r.val).prod w = if l = [] then w else 0 := by
  classical
  induction l with
  | nil => simp
  | cons r l ih =>
    simp only [List.map_cons, List.prod_cons, Module.End.mul_apply,
      List.cons_ne_nil, ↓reduceIte, ih]
    split_ifs
    · exact hw r.val r.property
    · exact map_zero _

private theorem cartan_word_highest_mem [CharP F 2] {b : BasicWeight}
    (hv : B.IsBasicHighestWeightVector b v) (l : List (Fin 4)) :
    (l.map Q.cartanOperator).prod Q.highestVector ∈
      Submodule.span F {Q.highestVector} := by
  apply BasicDensity.word_apply_mem Q.cartanOperator _ _ l
    (Submodule.mem_span_singleton_self _)
  intro i w hw
  obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hw
  have he : Q.cartanOperator i Q.highestVector =
      (basicCoefficient b i : F) • Q.highestVector := Q.simple_commutator_highest hv i
  rw [map_smul, he]
  exact Submodule.smul_mem _ c
    (Submodule.smul_mem _ _ (Submodule.mem_span_singleton_self _))

/-- Triangular spanning makes the negative coinvariant space generated by
the class of the actual highest vector. -/
theorem highest_span_sup_negativeImage_eq_top [CharP F 2] {b : BasicWeight}
    (hv : B.IsBasicHighestWeightVector b v) (htri : Q.triangularSpan = ⊤) :
    Submodule.span F {Q.highestVector} ⊔ Q.negativeImage = ⊤ := by
  classical
  apply top_unique
  intro w _
  obtain ⟨a, rfl⟩ := Q.exists_rootAction_highest w
  apply Q.apply_mem_of_triangular htri
  intro l h r
  rw [triangularWord, Module.End.mul_apply, Module.End.mul_apply,
    Q.positive_word_apply _ (Q.positive_operator_highest_eq_zero hv)]
  split_ifs
  · cases l with
    | nil =>
      simp only [List.map_nil, List.prod_nil, Module.End.one_apply]
      exact (show Submodule.span F {Q.highestVector} ≤
        Submodule.span F {Q.highestVector} ⊔ Q.negativeImage from le_sup_left)
        (Q.cartan_word_highest_mem hv h)
    | cons s l =>
      exact (show Q.negativeImage ≤
        Submodule.span F {Q.highestVector} ⊔ Q.negativeImage from le_sup_right)
        (Q.operator_mem_negativeImage s _)
  · simp only [map_zero]
    exact Submodule.zero_mem _

/-- A primitive vector cannot lie in a proper negative image space when
triangular words span and Cartan operators preserve that space. -/
theorem primitive_in_negativeImage_eq_zero
    (htri : Q.triangularSpan = ⊤)
    (hcartan : ∀ (i : Fin 4) w, w ∈ Q.negativeImage →
      Q.cartanOperator i w ∈ Q.negativeImage)
    (hproper : Q.negativeImage ≠ ⊤) (w : Q.Space)
    (hw : ∀ r : F4Chevalley.Root, typeF4RootPairing_base.IsPos r → Q.operator r w = 0)
    (hwJ : w ∈ Q.negativeImage) : w = 0 := by
  classical
  have hact (a : rootAlgebra B) : Q.rootAction a w ∈ Q.negativeImage := by
    apply Q.apply_mem_of_triangular htri
    intro l h r
    rw [triangularWord, Module.End.mul_apply, Module.End.mul_apply,
      Q.positive_word_apply w hw]
    split_ifs
    · apply BasicDensity.word_apply_mem (fun s : NegativeRoot => Q.operator s.val)
        Q.negativeImage (fun s x _ => Q.operator_mem_negativeImage s x) l
      exact BasicDensity.word_apply_mem Q.cartanOperator Q.negativeImage hcartan h hwJ
    · simp only [map_zero]
      exact Submodule.zero_mem _
  let W : Submodule (rootAlgebra B) Q.Space := Submodule.span (rootAlgebra B) {w}
  rcases eq_bot_or_eq_top W with hbot | htop
  · have hm : w ∈ W := Submodule.mem_span_singleton_self _
    simpa only [hbot, Submodule.mem_bot] using hm
  · exfalso
    apply hproper
    apply top_unique
    intro x _
    have hx : x ∈ W := by rw [htop]; trivial
    obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp hx
    exact hact a

/-- The full positive primitive line, conditional on the two triangular
properties and properness of the negative image space. -/
private theorem primitive_line_of_triangular_of_negativeImage_ne_top [CharP F 2] {b : BasicWeight}
    (hv : B.IsBasicHighestWeightVector b v)
    (htri : Q.triangularSpan = ⊤)
    (hcartan : ∀ (i : Fin 4) w, w ∈ Q.negativeImage →
      Q.cartanOperator i w ∈ Q.negativeImage)
    (hproper : Q.negativeImage ≠ ⊤) :
    ∀ w : Q.Space,
      (∀ r : F4Chevalley.Root, typeF4RootPairing_base.IsPos r → Q.operator r w = 0) →
        w ∈ Submodule.span F {Q.highestVector} := by
  intro w hw
  have hmem : w ∈ Submodule.span F {Q.highestVector} ⊔ Q.negativeImage := by
    rw [Q.highest_span_sup_negativeImage_eq_top hv htri]
    trivial
  obtain ⟨x, hx, z, hz, hxz⟩ := Submodule.mem_sup.mp hmem
  obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hx
  have hzprim : ∀ r : F4Chevalley.Root, typeF4RootPairing_base.IsPos r →
      Q.operator r z = 0 := by
    intro r hr
    have he := congrArg (Q.operator r) hxz
    simpa only [map_add, map_smul, Q.positive_operator_highest_eq_zero hv r hr,
      hw r hr, smul_zero, zero_add] using he
  have hz0 := Q.primitive_in_negativeImage_eq_zero htri hcartan hproper z hzprim hz
  rw [hz0, add_zero] at hxz
  exact hxz ▸ Submodule.smul_mem _ c (Submodule.mem_span_singleton_self _)

/-- The full positive primitive line on the actual simple quotient, reduced
only to triangular spanning and Cartan stability. Joint negative nilpotence
has been discharged from the integral weights of the original cyclic module. -/
theorem primitive_line_of_triangular [CharP F 2] {b : BasicWeight}
    (hv : B.IsBasicHighestWeightVector b v)
    (htri : Q.triangularSpan = ⊤)
    (hcartan : ∀ (i : Fin 4) w, w ∈ Q.negativeImage →
      Q.cartanOperator i w ∈ Q.negativeImage) :
    ∀ w : Q.Space,
      (∀ r : F4Chevalley.Root, typeF4RootPairing_base.IsPos r → Q.operator r w = 0) →
        w ∈ Submodule.span F {Q.highestVector} :=
  Q.primitive_line_of_triangular_of_negativeImage_ne_top hv htri hcartan
    (Q.negativeImage_ne_top hv)

/-- Curtis's full positive-root primitive-line assertion on the actual simple
differential quotient of a basic highest-vector cyclic module. The result also
holds for the zero basic weight and requires no universal-version hypothesis. -/
theorem primitive_line [CharP F 2] {b : BasicWeight}
    (hv : B.IsBasicHighestWeightVector b v) :
    ∀ w : Q.Space,
      (∀ r : F4Chevalley.Root, typeF4RootPairing_base.IsPos r → Q.operator r w = 0) →
        w ∈ Submodule.span F {Q.highestVector} :=
  Q.primitive_line_of_triangular hv Q.triangularSpan_eq_top
    Q.cartanOperator_mem_negativeImage

end SimpleCyclicQuotient
end
end ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.AlgebraicTensor.NegativeCyclicity.RestrictedBridge
