module

public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.Geometry.Universal.CharacterSeparation.Generation.RootUniqueness.TangentSpan.DimensionBound.DenseParameters.Words

/-!
# Local contracts for Bruhat collection in the literal F4 carrier

The positive subgroup is generated by the actual positive root curves over the
coefficient field. An ordering enumerates exactly the 24 positive roots. The two
collection contracts concern only this subgroup; negative-simple exchange is a
local multiplication law for a single cell. None asserts coverage of the carrier.

Word induction in `Generation` converts negative-simple exchange into coverage.
The collection and exchange proofs must be supplied before this yields Bruhat
normal forms. These are the root-collection steps in GLS3 1.11.5 and 1.12.1,
`refs/KGroup/GLS3/Chapter1.tex`.
-/

@[expose] public section
noncomputable section

namespace Theory.AlgebraicGroup.F4Chevalley.DenseParameters.CarrierBruhat

open StandardRootSystem

universe u
variable {k : Type u} [Field k] [IsAlgClosed k]
local instance : InvolutiveNeg Root := typeF4RootPairing.indexNeg

/-- Positive roots for the fixed integral F4 base. -/
abbrev PositiveRoot := {r : Root // typeF4RootPairing_base.IsPos r}

/-- An enumeration, with neither omissions nor repetitions. -/
abbrev PositiveOrdering := Fin 24 ≃ PositiveRoot

/-- The subgroup generated by the literal positive root curves. -/
def positiveUnipotent : Subgroup (Variety.Point (Carrier (k := k))) :=
  Subgroup.closure {x | ∃ (r : Root) (t : k),
    typeF4RootPairing_base.IsPos r ∧ x = rootElement r t}

theorem rootElement_mem_positiveUnipotent (r : Root)
    (hr : typeF4RootPairing_base.IsPos r) (t : k) :
    rootElement r t ∈ positiveUnipotent (k := k) :=
  Subgroup.subset_closure ⟨r, t, hr, rfl⟩

theorem rootProduct_mem_positiveUnipotent (p : PositiveOrdering) (a : Fin 24 → k) :
    rootProduct (fun i => (p i).val) a ∈ positiveUnipotent (k := k) := by
  apply Subgroup.list_prod_mem
  intro x hx
  obtain ⟨i, rfl⟩ := List.mem_ofFn.mp hx
  exact rootElement_mem_positiveUnipotent _ (p i).property _

/-- Collection in any prescribed ordering of the positive roots. -/
def OrderedPositiveCoverage : Prop :=
  ∀ (p : PositiveOrdering) (u : Variety.Point (Carrier (k := k))),
    u ∈ positiveUnipotent (k := k) →
    ∃ a : Fin 24 → k, u = rootProduct (fun i => (p i).val) a

/-- Collection with the roots assigned to one subgroup before the remaining
roots. This is needed to isolate a simple-root factor in the exchange proof. -/
def PositiveRootPartition : Prop :=
  ∀ A B : Subgroup (Variety.Point (Carrier (k := k))),
    (∀ r : PositiveRoot,
      (∀ t : k, rootElement r.val t ∈ A) ∨ (∀ t : k, rootElement r.val t ∈ B)) →
    ∀ u ∈ positiveUnipotent (k := k), ∃ a ∈ A, ∃ b ∈ B, u = a * b

/-- Local left multiplication of one normalizer cell by one negative simple
root element. The new middle factor retains all rank-one torus contributions. -/
def NegativeSimpleExchange : Prop :=
  ∀ (i : Fin 4) (t : k) (u : Variety.Point (Carrier (k := k))),
    u ∈ positiveUnipotent (k := k) → ∀ n ∈ normalizerWords (k := k),
      ∃ a ∈ positiveUnipotent (k := k), ∃ n' ∈ normalizerWords (k := k),
        ∃ c ∈ positiveUnipotent (k := k),
          rootElement (-typeF4SimpleRootIndex i) t * u * n = a * n' * c

end Theory.AlgebraicGroup.F4Chevalley.DenseParameters.CarrierBruhat
