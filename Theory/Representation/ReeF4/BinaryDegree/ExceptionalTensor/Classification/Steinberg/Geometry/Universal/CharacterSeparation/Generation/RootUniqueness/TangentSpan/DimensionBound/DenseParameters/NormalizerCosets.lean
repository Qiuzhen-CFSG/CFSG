module

public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.Geometry.Universal.CharacterSeparation.Generation.RootUniqueness.TangentSpan.DimensionBound.DenseParameters.Words
import Mathlib.Algebra.Group.Subgroup.Pointwise
import Mathlib.Algebra.Group.Subgroup.Finite
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairNormalization.OppositionCell.FixedBruhatCover.NormalizerGeometry.RankOneTransport.SimpleConjugation

/-!
# Root transport and finite torus cosets for literal F4 normalizer words

Over an algebraically closed field of characteristic two, every word generated
by the actual nonzero-parameter rank-one elements permutes the 48 root curves,
with unit parameter multipliers. These words also lie in finitely many right
cosets of the actual split torus.

For root transport, simple Tits conjugation is combined with diagonal scaling
and square roots of units. The canonical integral routes handle each positive
root and its negative. This adapts the finite-field argument in
`FixedBruhatCover.NormalizerGeometry.RankOneTransport`, replacing the finite-field
square-root argument by algebraic closedness.

For finiteness, the subgroup generated by the parameter-one simple lifts is
contained in the image of matrix units over `ZMod 2`. The integral Tits grading
shows that these lifts normalize the diagonal torus. Coroot words and the same
signed routes put all nonzero-parameter rank-one elements in the product of
that finite subgroup with the torus. The faithful carrier matrix map and the
literal `splitTorusIso` transfer this product to the closed carrier, with the
torus factor on the right. No normal-form coverage or geometric dimension
statement is used.

The diagonal calculation is adapted from
`ExceptionalTensor.BasicMinimum.ZeroAndMiddle.Geometry` at its narrow matrix
boundary. Source: GLS3 1.12.1(g–k) and 1.12.11,
`refs/KGroup/GLS3/Chapter1.tex`; Steinberg, *Lectures on Chevalley Groups*,
Theorem 1 and Lemmas 5–6.
-/

public section

open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
open RootPairing.IntegralGeckConstruction ReeF4.WordRelations
open ReeF4.LocalBlockInput.PairNormalization.OppositionCell.FixedBruhatCover.NormalizerGeometry.RankOneTransport
open scoped Matrix Pointwise
noncomputable section
namespace Theory.AlgebraicGroup.F4Chevalley.DenseParameters
local instance : InvolutiveNeg Root := typeF4RootPairing.indexNeg

private abbrev MatrixUnit (S : Type*) [CommRing S] :=
  (Matrix F4Chevalley.BasisIndex F4Chevalley.BasisIndex S)ˣ

private structure MatrixTransport {S : Type*} [CommRing S] (n : MatrixUnit S) where
  perm : Equiv.Perm F4Chevalley.Root
  scale : F4Chevalley.Root → Sˣ
  conj_root : ∀ r t, n * F4Chevalley.rootCurve r t * n⁻¹ =
    F4Chevalley.rootCurve (perm r) ((scale r : S) * t)

private def MatrixTransport.one {S : Type*} [CommRing S] :
    MatrixTransport (1 : MatrixUnit S) where
  perm := Equiv.refl _
  scale := fun _ => 1
  conj_root := by intros; simp

private def MatrixTransport.mul {S : Type*} [CommRing S] {n k : MatrixUnit S}
    (a : MatrixTransport n) (b : MatrixTransport k) : MatrixTransport (n * k) where
  perm := a.perm * b.perm
  scale := fun r => a.scale (b.perm r) * b.scale r
  conj_root := by
    intro r t
    calc
      _ = n * (k * F4Chevalley.rootCurve r t * k⁻¹) * n⁻¹ := by group
      _ = _ := by rw [b.conj_root, a.conj_root]; simp [Equiv.Perm.mul_apply, mul_assoc]

private def MatrixTransport.inv {S : Type*} [CommRing S] {n : MatrixUnit S}
    (a : MatrixTransport n) : MatrixTransport n⁻¹ where
  perm := a.perm.symm
  scale := fun r => (a.scale (a.perm.symm r))⁻¹
  conj_root := by
    intro r t
    have he : n * F4Chevalley.rootCurve (a.perm.symm r)
        (((a.scale (a.perm.symm r))⁻¹ : Sˣ) * t) * n⁻¹ =
        F4Chevalley.rootCurve r t := by
      rw [a.conj_root, a.perm.apply_symm_apply]
      simp
    rw [inv_inv, ← he]
    group

private def MatrixTransport.conjugate {S : Type*} [CommRing S] {n k : MatrixUnit S}
    (a : MatrixTransport n) (b : MatrixTransport k) : MatrixTransport (n * k * n⁻¹) :=
  (a.mul b).mul a.inv

private def MatrixTransport.simple {S : Type*} [CommRing S] [CharP S 2]
    (i : typeF4RootPairing_base.support) : MatrixTransport (titsUnit (S := S) [i]) where
  perm := typeF4RootPairing.reflectionPerm i
  scale := fun _ => 1
  conj_root := by intro r t; simpa using simple_conj i r t

private def MatrixTransport.word {S : Type*} [CommRing S] [CharP S 2]
    (w : List typeF4RootPairing_base.support) : MatrixTransport (titsUnit (S := S) w) := by
  induction w with
  | nil => simpa using (MatrixTransport.one (S := S))
  | cons i w ih =>
    have he : titsUnit (S := S) (i :: w) = titsUnit [i] * titsUnit w := by
      rw [titsUnit_cons, titsUnit_cons, titsUnit_nil, mul_one]
    rw [he]
    exact (MatrixTransport.simple i).mul ih

private def MatrixTransport.torus {S : Type*} [CommRing S]
    (u : IntegralChevalleyTorusParameter (b := typeF4RootPairing_base) S) :
    MatrixTransport (F4Chevalley.torusConjugation.torusElement u)⁻¹ where
  perm := Equiv.refl _
  scale := integralChevalleyRootScale (P := typeF4RootPairing) u
  conj_root := by intro r t; simpa using F4Chevalley.rootCurve_torus_conjugation u r t

private def matrixRankOne {S : Type*} [CommRing S] (r : F4Chevalley.Root) (t : Sˣ) :
    MatrixUnit S :=
  F4Chevalley.rootCurve r (t : S) * F4Chevalley.rootCurve (-r) (-((t⁻¹ : Sˣ) : S)) *
    F4Chevalley.rootCurve r (t : S)

private theorem matrixRankOne_simple_one {S : Type*} [CommRing S]
    (i : typeF4RootPairing_base.support) :
    matrixRankOne (S := S) i.val 1 = titsUnit [i] := by
  simp only [matrixRankOne, titsUnit_cons, titsUnit_nil, mul_one, inv_one, Units.val_one]

private theorem exists_unit_sqrt {K : Type*} [Field K] [CharP K 2] [IsAlgClosed K] (t : Kˣ) :
    ∃ u : Kˣ, u ^ 2 = t := by
  obtain ⟨a, ha⟩ := IsAlgClosed.exists_pow_nat_eq (t : K) (by decide : 0 < 2)
  have hane : a ≠ 0 := by
    intro hz
    exact t.ne_zero (by simpa [hz] using ha.symm)
  refine ⟨Units.mk0 a hane, ?_⟩
  apply Units.ext
  exact ha

private theorem matrixRankOne_simple {K : Type*} [Field K] [CharP K 2] [IsAlgClosed K]
    (i : typeF4RootPairing_base.support) (t : Kˣ) :
    Nonempty (MatrixTransport (matrixRankOne i.val t)) := by
  obtain ⟨u, hu⟩ := exists_unit_sqrt t
  let p := integralChevalleySimpleCorootParameter (b := typeF4RootPairing_base) i u
  let d := F4Chevalley.torusConjugation.torusElement p
  have he (a : K) : d⁻¹ * F4Chevalley.rootCurve i.val a * d =
      F4Chevalley.rootCurve i.val ((t : K) * a) := by
    simpa only [RootPairing.pairingIn_same, zpow_ofNat, hu] using
      F4Chevalley.rootCurve_simpleCoroot_conjugation i u i.val a
  have hf (a : K) : d⁻¹ * F4Chevalley.rootCurve (-i.val) a * d =
      F4Chevalley.rootCurve (-i.val) (((t⁻¹ : Kˣ) : K) * a) := by
    simpa only [RootPairing.indexNeg_neg, RootPairing.pairingIn_reflectionPerm_self_left,
      RootPairing.pairingIn_same, zpow_neg, zpow_ofNat, hu] using
      F4Chevalley.rootCurve_simpleCoroot_conjugation i u (-i.val) a
  have hn : matrixRankOne i.val t = d⁻¹ * titsUnit [i] * d := by
    rw [← matrixRankOne_simple_one i]
    calc
      _ = (d⁻¹ * F4Chevalley.rootCurve i.val 1 * d) *
          (d⁻¹ * F4Chevalley.rootCurve (-i.val) (-1) * d) *
          (d⁻¹ * F4Chevalley.rootCurve i.val 1 * d) := by
        rw [he, hf]
        simp only [mul_one, mul_neg, matrixRankOne]
      _ = _ := by simp only [matrixRankOne, inv_one, Units.val_one]; group
  rw [hn]
  have h := (MatrixTransport.torus p).conjugate (MatrixTransport.simple i)
  simpa only [inv_inv] using (Nonempty.intro h)

private theorem matrixRankOne_conjugate {S : Type*} [CommRing S]
    (n : MatrixUnit S) (r s : F4Chevalley.Root)
    (hp : ∀ a, n * F4Chevalley.rootCurve r a * n⁻¹ = F4Chevalley.rootCurve s a)
    (hn : ∀ a, n * F4Chevalley.rootCurve (-r) a * n⁻¹ = F4Chevalley.rootCurve (-s) a)
    (t : Sˣ) : matrixRankOne s t = n * matrixRankOne r t * n⁻¹ := by
  dsimp only [matrixRankOne]
  rw [← hp, ← hn]
  group

private theorem matrixRankOne_neg_simple {K : Type*} [Field K] [CharP K 2] [IsAlgClosed K]
    (i : typeF4RootPairing_base.support) (t : Kˣ) :
    Nonempty (MatrixTransport (matrixRankOne (-i.val) t)) := by
  have hp (a : K) : titsUnit [i] * F4Chevalley.rootCurve i.val a * (titsUnit [i])⁻¹ =
      F4Chevalley.rootCurve (-i.val) a := simple_conj i i.val a
  have hn (a : K) : titsUnit [i] * F4Chevalley.rootCurve (-i.val) a * (titsUnit [i])⁻¹ =
      F4Chevalley.rootCurve (-(-i.val)) a := by
    rw [neg_neg]
    simpa only [RootPairing.indexNeg_neg, RootPairing.reflectionPerm_self] using
      simple_conj i (-i.val) a
  rw [matrixRankOne_conjugate (titsUnit [i]) i.val (-i.val) hp hn t]
  obtain ⟨h⟩ := matrixRankOne_simple i t
  exact ⟨(MatrixTransport.simple i).conjugate h⟩

private theorem matrixRankOne_transport {K : Type*} [Field K] [CharP K 2] [IsAlgClosed K]
    (r : F4Chevalley.Root) (t : Kˣ) :
    Nonempty (MatrixTransport (matrixRankOne r t)) := by
  by_cases hr : typeF4RootPairing_base.IsPos r
  · let D := rootRoute (P := typeF4RootPairing) (b := typeF4RootPairing_base) r
    have hp (a : K) : titsUnit D.word * F4Chevalley.rootCurve D.simple.val a *
        (titsUnit D.word)⁻¹ = F4Chevalley.rootCurve r a :=
      (rootCurve_of_pos_route r hr a).symm
    have hn (a : K) : titsUnit D.word * F4Chevalley.rootCurve (-D.simple.val) a *
        (titsUnit D.word)⁻¹ = F4Chevalley.rootCurve (-r) a :=
      (rootCurve_neg_of_pos_route r hr a).symm
    rw [matrixRankOne_conjugate (titsUnit D.word) D.simple.val r hp hn t]
    obtain ⟨h⟩ := matrixRankOne_simple D.simple t
    exact ⟨(MatrixTransport.word D.word).conjugate h⟩
  · have hneg := (RootPairing.Base.IsPos.neg_iff_not typeF4RootPairing_base r).mpr hr
    let D := rootRoute (P := typeF4RootPairing) (b := typeF4RootPairing_base) (-r)
    have hp (a : K) : titsUnit D.word * F4Chevalley.rootCurve (-D.simple.val) a *
        (titsUnit D.word)⁻¹ = F4Chevalley.rootCurve r a := by
      simpa only [neg_neg] using (rootCurve_neg_of_pos_route (-r) hneg a).symm
    have hn (a : K) : titsUnit D.word * F4Chevalley.rootCurve (-(-D.simple.val)) a *
        (titsUnit D.word)⁻¹ = F4Chevalley.rootCurve (-r) a := by
      simpa only [neg_neg] using (rootCurve_of_pos_route (-r) hneg a).symm
    rw [matrixRankOne_conjugate (titsUnit D.word) (-D.simple.val) r hp hn t]
    obtain ⟨h⟩ := matrixRankOne_neg_simple D.simple t
    exact ⟨(MatrixTransport.word D.word).conjugate h⟩

variable {k : Type*} [Field k] [IsAlgClosed k]

private def carrierMatrix : Variety.Point (Carrier (k := k)) →* MatrixUnit k :=
  matrixAmbientEquiv.symm.toMonoidHom.comp (ambientClosedCarrier (k := k)).inclusion.onPoints

private theorem carrierMatrix_injective : Function.Injective (carrierMatrix (k := k)) :=
  matrixAmbientEquiv.symm.injective.comp (ambientClosedCarrier (k := k)).inclusion_injective

@[simp] private theorem carrierMatrix_root (r : Root) (t : k) :
    carrierMatrix (rootElement r t) = rootCurve r t := by
  apply matrixAmbientEquiv.injective
  change matrixAmbientEquiv (matrixAmbientEquiv.symm _) = _
  rw [MulEquiv.apply_symm_apply]
  exact rootElement_inclusion r t

@[simp] private theorem carrierMatrix_rankOne (r : Root) (t : kˣ) :
    carrierMatrix (rankOne r t) = matrixRankOne r t := by
  simp only [rankOne, map_mul, carrierMatrix_root, matrixRankOne]

variable [CharP k 2]

/-- Every word in the literal nonzero-parameter normalizer subgroup transports
all root curves by a permutation and nonzero parameter multipliers. -/
theorem normalizerWords_rootTransport {n : Variety.Point (Carrier (k := k))}
    (hn : n ∈ normalizerWords (k := k)) : Nonempty (RootTransport n) := by
  have hm : Nonempty (MatrixTransport (carrierMatrix n)) := by
    induction hn using Subgroup.closure_induction with
    | mem n hn =>
      obtain ⟨r, t, rfl⟩ := hn
      rw [carrierMatrix_rankOne]
      exact matrixRankOne_transport r t
    | one => rw [map_one]; exact ⟨MatrixTransport.one⟩
    | mul a b _ _ ha hb =>
      rw [map_mul]
      exact ⟨ha.some.mul hb.some⟩
    | inv a _ ha =>
      rw [map_inv]
      exact ⟨ha.some.inv⟩
  obtain ⟨h⟩ := hm
  refine ⟨{ perm := h.perm, scale := h.scale, conj_root := ?_ }⟩
  intro r t
  apply carrierMatrix_injective
  simpa only [map_mul, map_inv, carrierMatrix_root] using h.conj_root r t


private abbrev matrixTorus : Subgroup (MatrixUnit k) := (torusMatrixHom (F := k)).range

private abbrev matrixTits : Subgroup (MatrixUnit k) :=
  Subgroup.closure (Set.range fun i : typeF4RootPairing_base.support => titsUnit (S := k) [i])

private def binaryMatrixMap : MatrixUnit (ZMod 2) →* MatrixUnit k :=
  Units.map ((ZMod.castHom (dvd_refl 2) k).mapMatrix.toMonoidHom)

omit [IsAlgClosed k] in
private theorem binaryMatrixMap_word (w : List typeF4RootPairing_base.support) :
    binaryMatrixMap (k := k) (titsUnit (S := ZMod 2) w) = titsUnit (S := k) w := by
  apply Units.ext
  ext a b
  change ZMod.castHom (dvd_refl 2) k ((titsWord w a b : ℤ) : ZMod 2) = (titsWord w a b : k)
  simp

omit [IsAlgClosed k] in
private theorem matrixTits_finite : (matrixTits (k := k) : Set (MatrixUnit k)).Finite := by
  have hle : matrixTits (k := k) ≤ (binaryMatrixMap (k := k)).range := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, rfl⟩
    exact ⟨titsUnit (S := ZMod 2) [i], binaryMatrixMap_word [i]⟩
  exact (Set.finite_range (binaryMatrixMap (k := k))).subset hle

private abbrev diag (i : typeF4RootPairing_base.support) (u : kˣ) :=
  integralChevalleyTorusElement (P := typeF4RootPairing)
    (integralChevalleySimpleCorootParameter i u)

omit [IsAlgClosed k] [CharP k 2] in
private theorem diag_mem (i : typeF4RootPairing_base.support) (u : kˣ) :
    diag i u ∈ matrixTorus (k := k) :=
  ⟨integralChevalleySimpleCorootParameter i u, rfl⟩

omit [IsAlgClosed k] [CharP k 2] in
private theorem basisUnit_simple (q : typeF4RootPairing_base.support)
    (u : kˣ) (a : BasisIndex) :
    chevalleyBasisTorusUnit (P := typeF4RootPairing)
      (integralChevalleySimpleCorootParameter q u) a =
      u ^ (-chevalleyBasisWeight (P := typeF4RootPairing) a q) := by
  unfold chevalleyBasisTorusUnit integralChevalleySimpleCorootParameter
  rw [Finset.prod_eq_single q]
  · simp
  · intro j _ hj; simp [hj]
  · simp

omit [IsAlgClosed k] [CharP k 2] in
private theorem weight_reflection (a : BasisIndex)
    (i q : F4Chevalley.Root) :
    chevalleyBasisWeight (P := typeF4RootPairing) a (typeF4RootPairing.reflectionPerm i q) =
      chevalleyBasisWeight (P := typeF4RootPairing) a q -
        typeF4RootPairing.pairingIn ℤ i q * chevalleyBasisWeight (P := typeF4RootPairing) a i := by
  cases a with
  | inl j => simp [chevalleyBasisWeight]
  | inr r =>
    simp only [chevalleyBasisWeight, typeF4RootPairing.pairingIn_reflectionPerm]
    have hr : typeF4RootPairing.root (typeF4RootPairing.reflectionPerm i r) =
        (1 : ℤ) • typeF4RootPairing.root r +
          (-typeF4RootPairing.pairingIn ℤ r i) • typeF4RootPairing.root i := by
      rw [typeF4RootPairing.root_reflectionPerm, typeF4RootPairing.reflection_apply_root]
      simp [sub_eq_add_neg, ← typeF4RootPairing.algebraMap_pairingIn ℤ,
        Int.cast_smul_eq_zsmul]
    simpa [smul_eq_mul, sub_eq_add_neg, mul_comm] using
      (typeF4RootPairing.pairingIn_eq_add_of_root_eq_smul_add_smul (S := ℤ) (j := q) hr)

omit [IsAlgClosed k] [CharP k 2] in
private theorem tits_simple_diag (i q : typeF4RootPairing_base.support)
    (u : kˣ) :
    titsUnit (S := k) [i] * diag q u =
      (diag q u * diag i (u ^ (-typeF4RootPairing.pairingIn ℤ i q))) *
        titsUnit (S := k) [i] := by
  apply Units.ext
  change specializeMatrix (titsWord [i]) * Matrix.diagonal _ =
    (Matrix.diagonal _ * Matrix.diagonal _) * specializeMatrix (titsWord [i])
  simp only [titsWord, Matrix.mul_one, Matrix.diagonal_mul_diagonal]
  ext row col
  simp only [Matrix.mul_diagonal, Matrix.diagonal_mul]
  by_cases hz : titsLift i row col = 0
  · simp [specializeMatrix, hz]
  · have hw := titsLift_respectsChevalleyGrading i row col hz
      (typeF4RootPairing.reflectionPerm i q)
    rw [typeF4RootPairing.reflectionPerm_self, weight_reflection] at hw
    have hu : chevalleyBasisTorusUnit (P := typeF4RootPairing)
        (integralChevalleySimpleCorootParameter q u) col =
        chevalleyBasisTorusUnit (P := typeF4RootPairing)
          (integralChevalleySimpleCorootParameter q u) row *
        chevalleyBasisTorusUnit (P := typeF4RootPairing)
          (integralChevalleySimpleCorootParameter i
            (u ^ (-typeF4RootPairing.pairingIn ℤ i q))) row := by
      rw [basisUnit_simple, basisUnit_simple, basisUnit_simple, ← zpow_mul, ← zpow_add]
      congr 1
      rw [← hw]
      ring
    rw [hu, Units.val_mul]
    exact mul_comm _ _



omit [IsAlgClosed k] in
private theorem simple_lift_inv (i : typeF4RootPairing_base.support) :
    (titsUnit (S := k) [i])⁻¹ = titsUnit [i] := by
  rw [titsUnit_cons, titsUnit_nil, mul_one]
  simp only [mul_inv_rev, rootCurve_inv, CharTwo.neg_eq]
  group

omit [IsAlgClosed k] [CharP k 2] in
private theorem simple_conj_torus_mem (i : typeF4RootPairing_base.support)
    (u : typeF4RootPairing_base.support → kˣ) :
    titsUnit [i] * torusMatrixHom u * (titsUnit [i])⁻¹ ∈ matrixTorus (k := k) := by
  let C := (matrixTorus (k := k)).comap
    ((MulAut.conj (titsUnit [i])).toMonoidHom.comp torusMatrixHom)
  change u ∈ C
  have hu : u = ∏ q, integralChevalleySimpleCorootParameter q (u q) := by
    funext j
    simp [integralChevalleySimpleCorootParameter, Finset.prod_apply]
  rw [hu]
  apply C.prod_mem
  intro q _
  change titsUnit [i] * diag q (u q) * (titsUnit [i])⁻¹ ∈ matrixTorus (k := k)
  rw [tits_simple_diag, mul_assoc, mul_inv_cancel, mul_one]
  exact (matrixTorus (k := k)).mul_mem (diag_mem q (u q)) (diag_mem i _)

omit [IsAlgClosed k] in
private theorem simple_mem_normalizer (i : typeF4RootPairing_base.support) :
    titsUnit (S := k) [i] ∈ Subgroup.normalizer (matrixTorus (k := k) : Set (MatrixUnit k)) := by
  have hconj (x : MatrixUnit k) (hx : x ∈ matrixTorus (k := k)) :
      titsUnit [i] * x * (titsUnit [i])⁻¹ ∈ matrixTorus (k := k) := by
    obtain ⟨u, rfl⟩ := hx
    exact simple_conj_torus_mem i u
  rw [Subgroup.mem_normalizer_iff]
  intro x
  constructor
  · exact hconj x
  · intro hx
    have hh := hconj _ hx
    have he : titsUnit [i] * (titsUnit [i] * x * (titsUnit [i])⁻¹) *
        (titsUnit [i])⁻¹ = x := by
      calc
        _ = (titsUnit [i])⁻¹ * (titsUnit [i] * x * (titsUnit [i])⁻¹) *
            titsUnit [i] := by simp only [simple_lift_inv]
        _ = x := by group
    rwa [he] at hh

omit [IsAlgClosed k] in
private theorem matrixTits_le_normalizer :
    matrixTits (k := k) ≤ Subgroup.normalizer (matrixTorus (k := k) : Set (MatrixUnit k)) := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨i, rfl⟩
  exact simple_mem_normalizer i

omit [IsAlgClosed k] [CharP k 2] in
private theorem word_mem_matrixTits (w : List typeF4RootPairing_base.support) :
    titsUnit (S := k) w ∈ matrixTits (k := k) := by
  induction w with
  | nil => simp only [titsUnit_nil]; exact (matrixTits (k := k)).one_mem
  | cons i w ih =>
    have he : titsUnit (S := k) (i :: w) = titsUnit [i] * titsUnit w := by
      rw [titsUnit_cons, titsUnit_cons, titsUnit_nil, mul_one]
    rw [he]
    exact Subgroup.mul_mem _ (Subgroup.subset_closure ⟨i, rfl⟩) ih

omit [IsAlgClosed k] [CharP k 2] in
private theorem matrixRankOne_eq_matrixN (r : Root) (t : kˣ) :
    matrixRankOne r t = matrixN (F := k) r t := by
  simp only [matrixRankOne, matrixN, Units.val_inv_eq_inv_val]

omit [CharP k 2] in
private theorem matrixRankOne_simple_mem (i : typeF4RootPairing_base.support) (t : kˣ) :
    matrixRankOne i.val t ∈ matrixTits (k := k) ⊔ matrixTorus := by
  have he : matrixRankOne i.val t = diag i t⁻¹ * titsUnit [i] := by
    have h := matrixH_simple (F := k) i t
    rw [matrixH, matrixN_neg_one, matrixN_one] at h
    rw [← matrixRankOne_eq_matrixN] at h
    change matrixRankOne i.val t * (titsUnit [i])⁻¹ = diag i t⁻¹ at h
    calc
      _ = (matrixRankOne i.val t * (titsUnit [i])⁻¹) * titsUnit [i] := by group
      _ = _ := by rw [h]
  rw [he]
  exact Subgroup.mul_mem _ (Subgroup.mem_sup_right (diag_mem i t⁻¹))
    (Subgroup.mem_sup_left (word_mem_matrixTits [i]))

private theorem matrixRankOne_neg_simple_mem (i : typeF4RootPairing_base.support) (t : kˣ) :
    matrixRankOne (-i.val) t ∈ matrixTits (k := k) ⊔ matrixTorus := by
  have hp (a : k) : titsUnit [i] * rootCurve i.val a * (titsUnit [i])⁻¹ =
      rootCurve (-i.val) a := simple_conj i i.val a
  have hn (a : k) : titsUnit [i] * rootCurve (-i.val) a * (titsUnit [i])⁻¹ =
      rootCurve (-(-i.val)) a := by
    rw [neg_neg]
    simpa only [RootPairing.indexNeg_neg, RootPairing.reflectionPerm_self] using
      simple_conj i (-i.val) a
  rw [matrixRankOne_conjugate (titsUnit [i]) i.val (-i.val) hp hn t]
  have hw : titsUnit (S := k) [i] ∈ matrixTits (k := k) ⊔ matrixTorus :=
    Subgroup.mem_sup_left (word_mem_matrixTits [i])
  exact Subgroup.mul_mem _ (Subgroup.mul_mem _ hw (matrixRankOne_simple_mem i t))
    (Subgroup.inv_mem _ hw)

private theorem matrixRankOne_mem_sup (r : Root) (t : kˣ) :
    matrixRankOne r t ∈ matrixTits (k := k) ⊔ matrixTorus := by
  by_cases hr : typeF4RootPairing_base.IsPos r
  · let D := rootRoute (P := typeF4RootPairing) (b := typeF4RootPairing_base) r
    have hp (a : k) : titsUnit D.word * rootCurve D.simple.val a *
        (titsUnit D.word)⁻¹ = rootCurve r a := (rootCurve_of_pos_route r hr a).symm
    have hn (a : k) : titsUnit D.word * rootCurve (-D.simple.val) a *
        (titsUnit D.word)⁻¹ = rootCurve (-r) a := (rootCurve_neg_of_pos_route r hr a).symm
    rw [matrixRankOne_conjugate (titsUnit D.word) D.simple.val r hp hn t]
    have hw : titsUnit (S := k) D.word ∈ matrixTits (k := k) ⊔ matrixTorus :=
      Subgroup.mem_sup_left (word_mem_matrixTits D.word)
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ hw (matrixRankOne_simple_mem D.simple t))
      (Subgroup.inv_mem _ hw)
  · have hneg := (RootPairing.Base.IsPos.neg_iff_not typeF4RootPairing_base r).mpr hr
    let D := rootRoute (P := typeF4RootPairing) (b := typeF4RootPairing_base) (-r)
    have hp (a : k) : titsUnit D.word * rootCurve (-D.simple.val) a *
        (titsUnit D.word)⁻¹ = rootCurve r a := by
      simpa only [neg_neg] using (rootCurve_neg_of_pos_route (-r) hneg a).symm
    have hn (a : k) : titsUnit D.word * rootCurve (-(-D.simple.val)) a *
        (titsUnit D.word)⁻¹ = rootCurve (-r) a := by
      simpa only [neg_neg] using (rootCurve_of_pos_route (-r) hneg a).symm
    rw [matrixRankOne_conjugate (titsUnit D.word) (-D.simple.val) r hp hn t]
    have hw : titsUnit (S := k) D.word ∈ matrixTits (k := k) ⊔ matrixTorus :=
      Subgroup.mem_sup_left (word_mem_matrixTits D.word)
    exact Subgroup.mul_mem _ (Subgroup.mul_mem _ hw (matrixRankOne_neg_simple_mem D.simple t))
      (Subgroup.inv_mem _ hw)


omit [CharP k 2] in
private theorem exists_torus_preimage (u : typeF4RootPairing_base.support → kˣ) :
    letI := (splitTorus (k := k)).carrierAlgebraicGroup
    ∃ s : Variety.Point (splitTorus (k := k)).carrierVariety,
      carrierMatrix ((splitTorus (k := k)).inclusion.onPoints s) = torusMatrixHom u := by
  let _ := (splitTorus (k := k)).carrierAlgebraicGroup
  let v : Fin 4 → kˣ := u ∘ typeF4RootPairing_baseEquiv
  refine ⟨(splitTorusIso (k := k)).hom.onPoints ((dPointEquiv 4).symm v), ?_⟩
  apply matrixAmbientEquiv.injective
  change matrixAmbientEquiv (matrixAmbientEquiv.symm _) = _
  rw [MulEquiv.apply_symm_apply, splitTorusIso_ambient_inclusion_apply,
    torusAmbientMorphism_matrix]
  apply congrArg matrixToAmbient
  change integralChevalleyTorusElement (P := typeF4RootPairing)
    (torusParameter (dPointEquiv 4 ((dPointEquiv 4).symm v))) =
      integralChevalleyTorusElement (P := typeF4RootPairing) u
  rw [Equiv.apply_symm_apply]
  congr 1
  funext i
  simp only [torusParameter, v, Function.comp_apply, Equiv.apply_symm_apply]

/-- The literal normalizer words are covered by finitely many right cosets of
the actual split torus. All nonzero rank-one parameters are retained. -/
theorem normalizerWords_finite_torus_cosets :
    letI := (splitTorus (k := k)).carrierAlgebraicGroup
    ∃ W : Finset (Variety.Point (Carrier (k := k))),
      ∀ n ∈ normalizerWords (k := k), ∃ w ∈ W,
        ∃ s : Variety.Point (splitTorus (k := k)).carrierVariety,
          n = w * (splitTorus (k := k)).inclusion.onPoints s := by
  classical
  let _ := (splitTorus (k := k)).carrierAlgebraicGroup
  have hfinite : (carrierMatrix (k := k) ⁻¹' (matrixTits (k := k) : Set (MatrixUnit k))).Finite :=
    matrixTits_finite.preimage carrierMatrix_injective.injOn
  refine ⟨hfinite.toFinset, ?_⟩
  intro n hn
  have hm : carrierMatrix n ∈ matrixTits (k := k) ⊔ matrixTorus := by
    have hle : normalizerWords (k := k) ≤
        (matrixTits (k := k) ⊔ matrixTorus).comap carrierMatrix := by
      apply (Subgroup.closure_le _).mpr
      rintro _ ⟨r, t, rfl⟩
      change carrierMatrix (rankOne r t) ∈ (matrixTits (k := k) ⊔ matrixTorus)
      rw [carrierMatrix_rankOne]
      exact matrixRankOne_mem_sup r t
    exact hle hn
  have hm' : carrierMatrix n ∈
      (matrixTits (k := k) : Set (MatrixUnit k)) * (matrixTorus (k := k) : Set (MatrixUnit k)) := by
    rw [← Subgroup.coe_mul_of_left_le_normalizer_right _ _ matrixTits_le_normalizer]
    exact hm
  obtain ⟨a, ha, b, ⟨u, rfl⟩, hab⟩ := hm'
  obtain ⟨s, hs⟩ := exists_torus_preimage u
  let w := n * ((splitTorus (k := k)).inclusion.onPoints s)⁻¹
  refine ⟨w, ?_, s, ?_⟩
  · rw [Set.Finite.mem_toFinset]
    change carrierMatrix w ∈ matrixTits (k := k)
    have hw : carrierMatrix w = a := by
      simp only [w, map_mul, map_inv, hs]
      rw [← hab]
      group
    rw [hw]
    exact ha
  · dsimp only [w]
    group

end Theory.AlgebraicGroup.F4Chevalley.DenseParameters
