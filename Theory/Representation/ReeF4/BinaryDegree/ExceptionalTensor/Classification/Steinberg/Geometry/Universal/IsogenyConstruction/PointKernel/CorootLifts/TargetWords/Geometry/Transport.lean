module

public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.Geometry.Universal.IsogenyConstruction.PointKernel.CorootLifts.TargetWords.RankOne
public import Theory.AlgebraicGroup.ClosedSubgroup.Conjugation

/-!
# Restricting and conjugating rank-one charts

A regular SL₂ morphism compatible with two one-parameter subgroups takes
values in their closed generated subgroup, because the two standard curves
generate SL₂. This constructs the chart from an ambient morphism. Applying
it to ambient conjugation transports both parametrizations and the diagonal
containment together, without choosing coroot normalization.

Source: the rank-one geometry behind GLS3 1.9.5(d), torus conjugacy in
1.9.5(c), and the defining words of 1.12.1, `refs/KGroup/GLS3/Chapter1.tex`.
-/

public section
universe u

namespace Theory.AlgebraicGroup
variable {k : Type u} [Field k] [IsAlgClosed k] [CharP k 2]
variable {G : Variety k} [AlgebraicGroup G]

/-- Restrict a curve-compatible ambient SL₂ morphism to the closed subgroup
generated by its two root curves. Generation of SL₂ supplies the codomain
containment; the diagonal containment is retained as an explicit input. -/
noncomputable def BinaryOppositeRootSL2Chart.ofAmbient (T X Y : ClosedSubgroup G)
    (xp : OneParameterParametrization X.carrierVariety)
    (xm : OneParameterParametrization Y.carrierVariety)
    (f : Morphism (slVariety k 2) G)
    (hp : f.comp standardSL2UpperMorphism = X.inclusion.comp xp.hom)
    (hm : f.comp standardSL2LowerMorphism = Y.inclusion.comp xm.hom)
    (hd : ∀ t, f.onPoints (binarySL2Coroot.onPoints t) ∈ T) :
    BinaryOppositeRootSL2Chart T X Y := by
  let H := oppositePairGeneratedSubgroup X Y
  have hmem : ∀ z, f.onPoints z ∈ H := by
    intro z
    have htop : Subgroup.closure
        (Set.range (standardSL2UpperMorphism (k := k)).onPoints ∪
          Set.range (standardSL2LowerMorphism (k := k)).onPoints) ≤
        H.toSubgroup.comap f.onPoints := by
      rw [Subgroup.closure_le]
      rintro _ (⟨s, rfl⟩ | ⟨s, rfl⟩)
      · change (f.comp standardSL2UpperMorphism).onPoints s ∈ H
        rw [hp]
        exact sup_le_oppositePairGeneratedSubgroup X Y
          (Subgroup.mem_sup_left (X.pointEquiv (xp.hom.onPoints s)).property)
      · change (f.comp standardSL2LowerMorphism).onPoints s ∈ H
        rw [hm]
        exact sup_le_oppositePairGeneratedSubgroup X Y
          (Subgroup.mem_sup_right (Y.pointEquiv (xm.hom.onPoints s)).property)
    rw [standardSL2_upper_lower_generate] at htop
    exact htop (Subgroup.mem_top z)
  let f' := f.codRestrictClosedSubgroup H hmem
  have hf (z) : H.inclusion.onPoints (f'.onPoints z) = f.onPoints z :=
    Morphism.codRestrictClosedSubgroup_inclusion_apply f H hmem z
  refine ⟨xp, xm, f', ⟨?_, ?_⟩, ?_⟩
  · apply Morphism.ext
    funext s
    apply H.inclusion_injective
    change H.inclusion.onPoints ((oppositePairPlusMorphism X Y).onPoints
      (xp.hom.onPoints s)) = H.inclusion.onPoints
        (f'.onPoints (standardSL2UpperMorphism.onPoints s))
    rw [oppositePairPlusMorphism_inclusion_apply, hf]
    exact (congrArg (fun q : Morphism (KPlus k) G => q.onPoints s) hp).symm
  · apply Morphism.ext
    funext s
    apply H.inclusion_injective
    change H.inclusion.onPoints ((oppositePairMinusMorphism X Y).onPoints
      (xm.hom.onPoints s)) = H.inclusion.onPoints
        (f'.onPoints (standardSL2LowerMorphism.onPoints s))
    rw [oppositePairMinusMorphism_inclusion_apply, hf]
    exact (congrArg (fun q : Morphism (KPlus k) G => q.onPoints s) hm).symm
  · intro t
    rw [hf]
    exact hd t
end Theory.AlgebraicGroup

namespace Theory.AlgebraicGroup.BinaryOppositeRootSL2Chart
variable {k : Type u} [Field k] [IsAlgClosed k] [CharP k 2]
variable {G : Variety k} [AlgebraicGroup G] {T X Y : ClosedSubgroup G}

/-- Transport an actual rank-one chart by ambient conjugation. -/
noncomputable def conjugate (C : BinaryOppositeRootSL2Chart T X Y)
    (g : Variety.Point G) :
    BinaryOppositeRootSL2Chart (T.conjugate g) (X.conjugate g) (Y.conjugate g) := by
  let c : Morphism G G :=
    { toVariety := conjugationByMorphism G g
      map_one := by simp [conjugationByMorphism_apply]
      map_mul := by
        intro x y
        simp only [conjugationByMorphism_apply]
        group }
  let H := oppositePairGeneratedSubgroup X Y
  let f := c.comp (H.inclusion.comp C.map)
  let xp := (X.conjugateIso g).comp C.plus
  let xm := (Y.conjugateIso g).comp C.minus
  apply ofAmbient (T.conjugate g) (X.conjugate g) (Y.conjugate g) xp xm f
  · apply Morphism.ext
    funext s
    change g * H.inclusion.onPoints
        ((C.map.comp standardSL2UpperMorphism).onPoints s) * g⁻¹ =
      (X.conjugate g).inclusion.onPoints
        ((X.conjugateIso g).hom.onPoints (C.plus.hom.onPoints s))
    rw [← C.compatible.1, ClosedSubgroup.conjugateIso_hom_inclusion_apply]
    change g * H.inclusion.onPoints
      ((oppositePairPlusMorphism X Y).onPoints (C.plus.hom.onPoints s)) * g⁻¹ = _
    rw [oppositePairPlusMorphism_inclusion_apply]
  · apply Morphism.ext
    funext s
    change g * H.inclusion.onPoints
        ((C.map.comp standardSL2LowerMorphism).onPoints s) * g⁻¹ =
      (Y.conjugate g).inclusion.onPoints
        ((Y.conjugateIso g).hom.onPoints (C.minus.hom.onPoints s))
    rw [← C.compatible.2, ClosedSubgroup.conjugateIso_hom_inclusion_apply]
    change g * H.inclusion.onPoints
      ((oppositePairMinusMorphism X Y).onPoints (C.minus.hom.onPoints s)) * g⁻¹ = _
    rw [oppositePairMinusMorphism_inclusion_apply]
  · intro t
    rw [ClosedSubgroup.mem_conjugate_iff]
    change g⁻¹ * (g * H.inclusion.onPoints
      (C.map.onPoints (binarySL2Coroot.onPoints t)) * g⁻¹) * g ∈ T
    simpa only [mul_assoc, inv_mul_cancel_left, mul_inv_cancel_left, inv_mul_cancel,
      mul_one] using
      C.diagonal_mem t

end Theory.AlgebraicGroup.BinaryOppositeRootSL2Chart
