module

public import Theory.AlgebraicGroup.RootSystems.AlgebraicGroups.F4ChevalleySplitTorus

/-!
# Concrete words for the F4 parameter cells

The cell construction uses two ordered products of 24 root elements, separated
by a rank-one normalizer word and a point of the actual split torus. This module
fixes the literal root elements and normalizer-word subgroup so that collection
and reduction of the middle factor can be proved independently. No normal form
or coverage is part of these definitions.

The rank-one word is `x_r(t) x_{-r}(-t⁻¹) x_r(t)`, in the convention of
GLS3 1.12.1; the intended cell coverage is GLS3 1.11.5.
Source: `refs/KGroup/GLS3/Chapter1.tex`.
-/

@[expose] public section

namespace Theory.AlgebraicGroup.F4Chevalley.DenseParameters

open StandardRootSystem

universe u
variable {k : Type u} [Field k] [IsAlgClosed k]

noncomputable section

local instance : InvolutiveNeg Root := typeF4RootPairing.indexNeg

/-- The literal root element in the closed F4 carrier. -/
def rootElement (r : Root) (a : k) : Variety.Point (Carrier (k := k)) :=
  (rootMorphism (k := k) r).onPoints (kPlusPoint a)

@[simp] theorem rootElement_zero (r : Root) : rootElement (k := k) r 0 = 1 := by
  have h : kPlusPoint (0 : k) = 1 := by
    apply (additiveGroupPointEquiv k).injective
    rfl
  simp only [rootElement, h, map_one]

theorem rootElement_add (r : Root) (a b : k) :
    rootElement r (a + b) = rootElement r a * rootElement r b := by
  simp only [rootElement, ← kPlusPoint_mul, map_mul]

theorem rootElement_inv (r : Root) (a : k) :
    (rootElement r a)⁻¹ = rootElement r (-a) := by
  have h : (kPlusPoint a)⁻¹ = kPlusPoint (-a) := by
    apply (additiveGroupPointEquiv k).injective
    rfl
  simp only [rootElement, ← map_inv, h]

/-- Comparison with the integral matrix root curve, through the actual
closed-carrier inclusion. -/
theorem rootElement_inclusion (r : Root) (a : k) :
    (ambientClosedCarrier (k := k)).inclusion.onPoints (rootElement r a) =
      matrixToAmbient (rootCurve r a) := by
  rw [rootElement, rootMorphism_inclusion_apply, matrixToAmbient_root]

/-- A fixed ordered product with 24 independently variable coefficients. -/
def rootProduct (p : Fin 24 → Root) (a : Fin 24 → k) :
    Variety.Point (Carrier (k := k)) :=
  (List.ofFn fun i => rootElement (p i) (a i)).prod

/-- A nonzero-parameter rank-one representative, retaining its torus factor. -/
def rankOne (r : Root) (t : kˣ) : Variety.Point (Carrier (k := k)) :=
  rootElement r (t : k) * rootElement (-r) (-(t⁻¹ : kˣ) : k) * rootElement r (t : k)

/-- The subgroup generated by all literal nonzero-parameter rank-one words. -/
def normalizerWords : Subgroup (Variety.Point (Carrier (k := k))) :=
  Subgroup.closure {n | ∃ (r : Root) (t : kˣ), n = rankOne r t}

theorem rankOne_mem (r : Root) (t : kˣ) :
    rankOne r t ∈ normalizerWords (k := k) :=
  Subgroup.subset_closure ⟨r, t, rfl⟩

/-- Exact left conjugation on the literal root curves. The normalizer-geometry
argument must construct this data; word collection can use it independently
of the reduction to finitely many torus cosets. -/
structure RootTransport (n : Variety.Point (Carrier (k := k))) where
  perm : Equiv.Perm Root
  scale : Root → kˣ
  conj_root : ∀ r a, n * rootElement r a * n⁻¹ =
    rootElement (perm r) ((scale r : k) * a)

end

end Theory.AlgebraicGroup.F4Chevalley.DenseParameters
