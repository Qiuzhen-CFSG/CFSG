module

public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.Geometry.Universal.CharacterSeparation.Generation.RootUniqueness.TangentSpan.DimensionBound.DenseParameters.CarrierBruhat.Basic
public import Theory.AlgebraicGroup.RootSystems.IntegralRootCurveSimpleGeneration

/-!
# Root generation and cell induction over an arbitrary algebraically closed field

The literal closed carrier is the abstract subgroup generated by all root
curves. Integral Tits-word formulas reduce its generators to signed simple
curves. Consequently the positive subgroup and the negative simple curves
generate it. Each negative simple curve is also a word in the positive subgroup
and a nonzero-parameter rank-one representative.

Induction on these generators extends a local negative-simple cell exchange to
unrestricted `U N U` coverage. The exchange premise remains explicit; generation
alone does not assert a normal form. Source: the construction underlying GLS3
1.11.5 and 1.12.1, `refs/KGroup/GLS3/Chapter1.tex`.
-/

public section
noncomputable section

namespace Theory.AlgebraicGroup.F4Chevalley.DenseParameters.CarrierBruhat

open StandardRootSystem Subgroup
open RootPairing.IntegralGeckConstruction

universe u
variable {k : Type u} [Field k] [IsAlgClosed k]
local instance : InvolutiveNeg Root := typeF4RootPairing.indexNeg

/-- The actual faithful matrix representation of the closed carrier. -/
def carrierMatrix : Variety.Point (Carrier (k := k)) →* (Matrix BasisIndex BasisIndex k)ˣ :=
  matrixAmbientEquiv.symm.toMonoidHom.comp (ambientClosedCarrier (k := k)).inclusion.onPoints

theorem carrierMatrix_injective : Function.Injective (carrierMatrix (k := k)) :=
  matrixAmbientEquiv.symm.injective.comp (ambientClosedCarrier (k := k)).inclusion_injective

@[simp] theorem carrierMatrix_root (r : Root) (t : k) :
    carrierMatrix (rootElement r t) = rootCurve r t := by
  apply matrixAmbientEquiv.injective
  change matrixAmbientEquiv (matrixAmbientEquiv.symm _) = _
  rw [MulEquiv.apply_symm_apply]
  exact rootElement_inclusion r t

theorem carrierMatrix_mem_allRootCurveSubgroup (g : Variety.Point (Carrier (k := k))) :
    carrierMatrix g ∈ allRootCurveSubgroup typeF4RootPairing_base k := by
  have hle : ambientCarrierSubgroup (k := k) ≤
      (allRootCurveSubgroup typeF4RootPairing_base k).map matrixToAmbient := by
    apply (Subgroup.closure_le _).mpr
    intro x hx
    obtain ⟨r, t, rfl⟩ := Set.mem_iUnion.mp hx
    refine ⟨rootCurve r (Multiplicative.toAdd (additiveGroupPointEquiv k t)),
      subset_closure ⟨(_, _), rfl⟩, ?_⟩
    rw [matrixToAmbient_root, kPlusPoint_coordinate]
  have hg : (ambientClosedCarrier (k := k)).inclusion.onPoints g ∈
      ambientCarrierSubgroup (k := k) := (ambientClosedCarrier (k := k)).pointEquiv g |>.property
  obtain ⟨A, hA, he⟩ := hle hg
  have hAg : A = carrierMatrix g := by
    apply matrixAmbientEquiv.injective
    change matrixToAmbient A = matrixAmbientEquiv (matrixAmbientEquiv.symm _)
    rw [MulEquiv.apply_symm_apply]
    exact he
  exact hAg ▸ hA

/-- The remaining simple-root generators alongside the positive subgroup. -/
def negativeSimpleGenerators : Set (Variety.Point (Carrier (k := k))) :=
  {x | ∃ (i : Fin 4) (t : k), x = rootElement (-typeF4SimpleRootIndex i) t}

/-- Positive roots and negative simple roots generate the actual closed carrier. -/
theorem positive_negative_simple_generate :
    Subgroup.closure ((positiveUnipotent (k := k) : Set (Variety.Point (Carrier (k := k)))) ∪
      negativeSimpleGenerators) = ⊤ := by
  let H := Subgroup.closure ((positiveUnipotent (k := k) : Set (Variety.Point (Carrier (k := k)))) ∪
    negativeSimpleGenerators)
  have hs : allRootCurveSubgroup typeF4RootPairing_base k ≤ H.map carrierMatrix := by
    rw [allRootCurveSubgroup_eq_simpleSubgroup]
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨⟨s, i⟩, t, rfl⟩
    cases s
    · change RootPairing.SimpleGeckGroup.negativeUnit i t ∈ _
      rw [← rootCurveUnit_neg_simple]
      obtain ⟨j, rfl⟩ := typeF4RootPairing_baseEquiv.surjective i
      refine ⟨rootElement (-typeF4SimpleRootIndex j) t,
        subset_closure (Or.inr ⟨j, t, rfl⟩), ?_⟩
      exact carrierMatrix_root _ _
    · change RootPairing.SimpleGeckGroup.positiveUnit i t ∈ _
      rw [← rootCurveUnit_simple]
      refine ⟨rootElement i t, subset_closure (Or.inl
        (rootElement_mem_positiveUnipotent i
          (typeF4RootPairing_base.isPos_of_mem_support i.property) t)), ?_⟩
      exact carrierMatrix_root _ _
  apply top_unique
  intro g _
  obtain ⟨x, hx, he⟩ := hs (carrierMatrix_mem_allRootCurveSubgroup g)
  exact (carrierMatrix_injective he) ▸ hx

/-- Positive root elements and the literal nonzero rank-one words generate the
carrier. This statement requires no characteristic or root-transport premise. -/
theorem positiveUnipotent_sup_normalizerWords_eq_top :
    positiveUnipotent (k := k) ⊔ normalizerWords = ⊤ := by
  let H := positiveUnipotent (k := k) ⊔ normalizerWords
  have hp (i : Fin 4) (t : k) : rootElement (typeF4SimpleRootIndex i) t ∈ H :=
    mem_sup_left (rootElement_mem_positiveUnipotent _
      (typeF4RootPairing_base.isPos_of_mem_support (typeF4RootPairing_baseEquiv i).property) t)
  have hn (i : Fin 4) (t : k) : rootElement (-typeF4SimpleRootIndex i) t ∈ H := by
    by_cases ht : t = 0
    · rw [ht, rootElement_zero]
      exact H.one_mem
    · let a : kˣ := -(Units.mk0 t ht)⁻¹
      have he : rootElement (-typeF4SimpleRootIndex i) t =
          (rootElement (typeF4SimpleRootIndex i) (a : k))⁻¹ *
            rankOne (typeF4SimpleRootIndex i) a *
            (rootElement (typeF4SimpleRootIndex i) (a : k))⁻¹ := by
        simp only [rankOne, a, inv_neg, inv_inv, Units.val_neg, neg_neg, Units.val_mk0]
        group
      rw [he]
      exact H.mul_mem (H.mul_mem (H.inv_mem (hp i a))
        (mem_sup_right (rankOne_mem _ a))) (H.inv_mem (hp i a))
  apply top_unique
  rw [← positive_negative_simple_generate (k := k)]
  apply (Subgroup.closure_le _).mpr
  rintro x (hx | ⟨i, t, rfl⟩)
  · exact mem_sup_left hx
  · exact hn i t

/-- Local negative-simple exchange extends to all words in the literal carrier. -/
theorem exists_unrestricted_factors_of_negativeSimpleExchange
    (hexchange : NegativeSimpleExchange (k := k)) (g : Variety.Point (Carrier (k := k))) :
    ∃ u ∈ positiveUnipotent (k := k), ∃ n ∈ normalizerWords (k := k),
      ∃ v ∈ positiveUnipotent (k := k), g = u * n * v := by
  let F : Variety.Point (Carrier (k := k)) → Prop := fun x =>
    ∃ u ∈ positiveUnipotent (k := k), ∃ n ∈ normalizerWords (k := k),
      ∃ v ∈ positiveUnipotent (k := k), x = u * n * v
  have hpositive (u : Variety.Point (Carrier (k := k))) (hu : u ∈ positiveUnipotent)
      (x : Variety.Point (Carrier (k := k))) (hx : F x) : F (u * x) := by
    obtain ⟨a, ha, n, hn, c, hc, rfl⟩ := hx
    exact ⟨u * a, (positiveUnipotent (k := k)).mul_mem hu ha, n, hn, c, hc, by group⟩
  have hnegative (i : Fin 4) (t : k)
      (x : Variety.Point (Carrier (k := k))) (hx : F x) :
      F (rootElement (-typeF4SimpleRootIndex i) t * x) := by
    obtain ⟨u, hu, n, hn, v, hv, rfl⟩ := hx
    obtain ⟨a, ha, n', hn', c, hc, he⟩ := hexchange i t u hu n hn
    refine ⟨a, ha, n', hn', c * v, (positiveUnipotent (k := k)).mul_mem hc hv, ?_⟩
    calc
      _ = (rootElement (-typeF4SimpleRootIndex i) t * u * n) * v := by group
      _ = a * n' * (c * v) := by rw [he, mul_assoc]
  have hg : g ∈ Subgroup.closure ((positiveUnipotent (k := k) : Set (Variety.Point (Carrier (k := k)))) ∪
      negativeSimpleGenerators) := by
    rw [positive_negative_simple_generate]
    exact mem_top g
  change F g
  induction hg using Subgroup.closure_induction_left with
  | one => exact ⟨1, (positiveUnipotent (k := k)).one_mem, 1,
      (normalizerWords (k := k)).one_mem, 1, (positiveUnipotent (k := k)).one_mem, by simp⟩
  | mul_left x hx y _ ih =>
      rcases hx with hx | ⟨i, t, rfl⟩
      · exact hpositive x hx y ih
      · exact hnegative i t y ih
  | inv_mul_cancel x hx y _ ih =>
      rcases hx with hx | ⟨i, t, rfl⟩
      · exact hpositive x⁻¹ ((positiveUnipotent (k := k)).inv_mem hx) y ih
      · rw [rootElement_inv]
        exact hnegative i (-t) y ih

end Theory.AlgebraicGroup.F4Chevalley.DenseParameters.CarrierBruhat
