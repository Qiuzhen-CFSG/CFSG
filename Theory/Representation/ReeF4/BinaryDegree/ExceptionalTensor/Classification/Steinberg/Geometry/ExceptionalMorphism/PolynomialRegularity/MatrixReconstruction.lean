module

public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.Geometry.ExceptionalMorphism.WordDescent
public import Mathlib.LinearAlgebra.Basis.VectorSpace

/-!
# Reconstructing the full F4 matrix from its short columns

Short root operators jointly detect every vector in the actual Geck lattice.
A linear left inverse to this detector recovers each matrix column from its
images under the operators. Restricted adjoint transport expresses those
images using only short columns of the matrix and its inverse. The short
Cartan operators have image in the short ideal because they are commutators
of the two simple root operators.

Consequently every matrix coefficient belongs to any ring of functions
containing constants and these short-column coefficients. This is the
polynomial reconstruction step for GLS3, Theorem 1.15.4(b), with transport
retained as an explicit hypothesis; see `refs/KGroup/GLS3/Chapter1.tex` and
Steinberg, Theorem 28 (`refs/KGroup/GLS3/Chapter2St1.tex`).
-/

public section

open scoped Classical Matrix
open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
open RootPairing.IntegralGeckConstruction ReeF4.WordRelations
open ReeF4.WordRelations.Faithfulness.RestrictedAdjoint
namespace ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.Geometry.ExceptionalMorphism
noncomputable section

variable {F X : Type*} [Field F]

private theorem linear_mem {I : Type*} [Fintype I]
    (R : Subring (X → F)) (hc : ∀ c : F, (fun _ : X => c) ∈ R)
    (L : (I → F) →ₗ[F] F) (v : X → I → F)
    (hv : ∀ i, (fun x => v x i) ∈ R) : (fun x => L (v x)) ∈ R := by
  classical
  have he : (fun x => L (v x)) =
      ∑ i, (fun x => v x i) * (fun _ => L (Pi.single i 1)) := by
    funext x
    conv_lhs => rw [pi_eq_sum_univ' (v x)]
    simp only [map_sum, map_smul, Finset.sum_apply, Pi.mul_apply, smul_eq_mul]
  rw [he]
  exact R.sum_mem (fun i _ => R.mul_mem (hv i) (hc _))

variable [CharP F 2]

/-- Every short coordinate operator, including the Cartan commutators, has
image in the short ideal in characteristic two. -/
theorem coordinateOperator_image (s : Coordinate) (hs : IsShortCoordinate s)
    (i : Coordinate) (hi : ¬IsShortCoordinate i) (j : Coordinate) :
    coordinateOperator (K := F) s i j = 0 := by
  cases s with
  | inr s => exact ShortOperators.rootOperator_image s hs i hi j
  | inl s =>
    simp only [coordinateOperator, Matrix.sub_apply]
    rw [ShortOperators.image_mul _ _ (ShortOperators.eMatrix_image s hs) i hi j,
      ShortOperators.image_mul _ _ (ShortOperators.fMatrix_image s hs) i hi j,
      sub_self]

private def shortDetector : (Coordinate → F) →ₗ[F]
    ({s : typeF4Roots // IsShortRoot s} × Coordinate → F) :=
  LinearMap.pi fun s => (LinearMap.proj s.2).comp
    (Matrix.mulVecLin (coordinateOperator (K := F) (Sum.inr s.1.val)))

private theorem shortDetector_ker : (shortDetector (F := F)).ker = ⊥ := by
  apply LinearMap.ker_eq_bot'.mpr
  intro v hv
  apply ShortOperators.rootOperator_commonKernel v
  intro s hs
  funext i
  exact congrFun hv (⟨s, hs⟩, i)

/-- Full matrix coefficients are generated by the short columns of a matrix and
its inverse whenever restricted adjoint transport holds. -/
theorem matrix_entries_mem_of_short
    (htransport : HasShortAdjointTransport F)
    (R : Subring (X → F)) (hc : ∀ c : F, (fun _ : X => c) ∈ R)
    (g : X → (Matrix Coordinate Coordinate F)ˣ)
    (hg : ∀ x, g x ∈ matrixGroup F)
    (hshort : ∀ i j, IsShortCoordinate j → (fun x => (g x).val i j) ∈ R)
    (hinv : ∀ i j, IsShortCoordinate j → (fun x => (g x)⁻¹.val i j) ∈ R)
    (i j : Coordinate) : (fun x => (g x).val i j) ∈ R := by
  have hE (s : typeF4Roots) (hs : IsShortRoot s) (x : X) :
      coordinateOperator (K := F) (Sum.inr s) * (g x).val =
        (g x).val * adjointMap ((g x)⁻¹.val *ᵥ Pi.single (Sum.inr s) 1) := by
    have hv := matrixGroup_preserves_short (g x)⁻¹
      ((matrixGroup F).inv_mem (hg x)) _ (shortSupported_single (Sum.inr s) hs)
    have ht := htransport (g x) (hg x) _ hv
    rw [Matrix.mulVec_mulVec, Units.mul_inv, Matrix.one_mulVec, adjointMap_single] at ht
    exact ht
  have hdet (s : {s : typeF4Roots // IsShortRoot s} × Coordinate) :
      (fun x => shortDetector (fun k => (g x).val k j) s) ∈ R := by
    change (fun x => (coordinateOperator (K := F) (Sum.inr s.1.val) * (g x).val) s.2 j) ∈ R
    simp_rw [hE _ s.1.property]
    change (fun x => ∑ k, (g x).val s.2 k *
      (∑ l, ((g x)⁻¹.val *ᵥ Pi.single (Sum.inr s.1.val) 1) l •
        coordinateOperator l) k j) ∈ R
    simp only [Matrix.mulVec_single_one, Matrix.col_apply,
      Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul]
    simp_rw [Finset.mul_sum]
    have hr : (∑ k : Coordinate, ∑ l : Coordinate, fun x => (g x).val s.2 k *
        ((g x)⁻¹.val l (Sum.inr s.1.val) * coordinateOperator (K := F) l k j)) ∈ R := by
      apply R.sum_mem
      intro k _
      apply R.sum_mem
      intro l _
      by_cases hl : IsShortCoordinate l
      · by_cases hk : IsShortCoordinate k
        · exact R.mul_mem (hshort _ _ hk) (R.mul_mem (hinv _ _ s.1.property) (hc _))
        · simp only [coordinateOperator_image l hl k hk j, mul_zero]
          exact R.zero_mem
      · have hz (x : X) : (g x)⁻¹.val l (Sum.inr s.1.val) = 0 := by
          have hv := matrixGroup_preserves_short (g x)⁻¹
            ((matrixGroup F).inv_mem (hg x)) _ (shortSupported_single (Sum.inr s.1.val) s.1.property)
          simpa only [Matrix.mulVec_single_one, Matrix.col_apply] using hv l hl
        simp only [hz, zero_mul, mul_zero]
        exact R.zero_mem
    convert hr using 1
    funext x
    simp only [Finset.sum_apply]
  have hh := linear_mem R hc
    ((LinearMap.proj i).comp (shortDetector (F := F)).leftInverse)
    (fun x => shortDetector (fun k => (g x).val k j)) hdet
  simpa only [LinearMap.comp_apply, LinearMap.proj_apply,
    LinearMap.leftInverse_apply_of_inj (shortDetector_ker (F := F))] using hh

end
end ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.Geometry.ExceptionalMorphism
