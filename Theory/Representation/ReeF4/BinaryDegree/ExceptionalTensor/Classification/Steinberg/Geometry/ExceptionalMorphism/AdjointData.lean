module

public import Theory.SpecificGroups.ReeF4.ExceptionalEndomorphism.WordRelations.Faithfulness.RestrictedAdjoint.Support
public import Theory.SpecificGroups.ReeF4.ExceptionalEndomorphism.WordRelations.Faithfulness.ShortOperators

/-!
# Characteristic-two adjoint data for the exceptional F4 construction

The actual integral coordinate operators define an adjoint map over any
commutative ring. Restricted adjoint transport on the short ideal implies
faithfulness there: every short root operator kills every displacement of a
matrix fixing the ideal, and their common kernel is zero.

Transport is an explicit premise here. Its finite-field specialization is
already proved in `RestrictedAdjoint.Unconditional`; using it over an
algebraic closure requires a separate proof. The operators and short ideal
are exactly those of the integral Geck representation used in the existing
exceptional construction. Source: Steinberg, *Lectures on Chevalley Groups*,
Theorem 28 (`refs/KGroup/GLS3/Chapter2St1.tex`).
-/

@[expose] public section

open scoped Classical Matrix
open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
open RootPairing.IntegralGeckConstruction
open ReeF4.WordRelations
open ReeF4.WordRelations.Faithfulness
open ReeF4.WordRelations.Faithfulness.RestrictedAdjoint

namespace ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.Geometry.ExceptionalMorphism

variable {K : Type*} [CommRing K]

/-- The actual subgroup of matrix units generated by all integral F4 root curves. -/
noncomputable def matrixGroup (K : Type*) [CommRing K] :
    Subgroup (Matrix Coordinate Coordinate K)ˣ :=
  Subgroup.closure (Set.range fun rt : F4Chevalley.Root × K =>
    F4Chevalley.rootCurve rt.1 rt.2)

/-- The integral root operators and simple Cartan commutators, over any base ring. -/
noncomputable def coordinateOperator : Coordinate → Matrix Coordinate Coordinate K
  | Sum.inr r => (F4Chevalley.integralOperators.rootOperator r).map (Int.castRingHom K)
  | Sum.inl i =>
      let E := (eMatrix (P := typeF4RootPairing) i).map (Int.castRingHom K)
      let F := (fMatrix (P := typeF4RootPairing) i).map (Int.castRingHom K)
      E * F - F * E

/-- Linear extension of the actual coordinate operators. -/
noncomputable def adjointMap :
    (Coordinate → K) →ₗ[K] Matrix Coordinate Coordinate K :=
  Adjoint.linearExtension coordinateOperator

theorem adjointMap_single (j : Coordinate) :
    adjointMap (Pi.single j (1 : K)) = coordinateOperator j :=
  Adjoint.linearExtension_single coordinateOperator j

theorem adjointMap_root_single (r : F4Chevalley.Root) :
    adjointMap (Pi.single (Sum.inr r) (1 : K)) =
      (F4Chevalley.integralOperators.rootOperator r).map (Int.castRingHom K) :=
  adjointMap_single (Sum.inr r)

/-- Compatibility with the fixed adjoint map in the finite-field development. -/
theorem adjointMap_coefficientField (m : ℕ) :
    adjointMap (K := CoefficientField m) = Adjoint.adjointMap m := rfl

/-- Restricted adjoint transport for the actual generated matrix group.
This is an operator identity, not an exceptional-endomorphism existence premise. -/
def HasShortAdjointTransport (K : Type*) [CommRing K] : Prop :=
  ∀ (g : (Matrix Coordinate Coordinate K)ˣ), g ∈ matrixGroup K →
    ∀ v : Coordinate → K, ShortSupported v →
      adjointMap ((g : Matrix Coordinate Coordinate K) *ᵥ v) * g = g * adjointMap v

/-- Restricted transport detects a matrix fixing the short ideal. -/
theorem eq_one_of_short_transport [CharP K 2]
    (htransport : HasShortAdjointTransport K)
    (g : (Matrix Coordinate Coordinate K)ˣ) (hg : g ∈ matrixGroup K)
    (hfix : (g : Matrix Coordinate Coordinate K) * quotientToIdeal = quotientToIdeal) :
    g = 1 := by
  let E (s : typeF4Roots) :=
    (F4Chevalley.integralOperators.rootOperator s).map (Int.castRingHom K)
  have hcolumns := (mul_quotientToIdeal_eq_iff _).mp hfix
  have hcomm (s : typeF4Roots) (hs : IsShortRoot s) : E s * g = g * E s := by
    have h := htransport g hg (Pi.single (Sum.inr s) 1) (shortSupported_single _ hs)
    have hfixed : (g : Matrix Coordinate Coordinate K) *ᵥ
        Pi.single (Sum.inr s) 1 = Pi.single (Sum.inr s) 1 :=
      fixes_supported_vector IsShortCoordinate _ hcolumns _ (shortSupported_single _ hs)
    simpa only [hfixed, adjointMap_root_single] using h
  have hleft (s : typeF4Roots) (hs : IsShortRoot s) :
      (g : Matrix Coordinate Coordinate K) * E s = E s := by
    ext i j
    exact congrFun (fixes_supported_vector IsShortCoordinate _ hcolumns
      (fun k => E s k j) (fun k hk => ShortOperators.rootOperator_image s hs k hk j)) i
  have hright (s : typeF4Roots) (hs : IsShortRoot s) :
      E s * (g : Matrix Coordinate Coordinate K) = E s :=
    (hcomm s hs).trans (hleft s hs)
  apply Units.ext
  have hm : (g : Matrix Coordinate Coordinate K) - 1 = 0 := by
    ext i j
    have hz := ShortOperators.rootOperator_commonKernel
      (fun k => ((g : Matrix Coordinate Coordinate K) - 1) k j) (by
        intro s hs
        have hprod : E s * ((g : Matrix Coordinate Coordinate K) - 1) = 0 := by
          rw [mul_sub, hright s hs, mul_one, sub_self]
        exact congrArg (fun A : Matrix Coordinate Coordinate K => fun k => A k j) hprod)
    exact congrFun hz i
  exact sub_eq_zero.mp hm

end ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.Geometry.ExceptionalMorphism
