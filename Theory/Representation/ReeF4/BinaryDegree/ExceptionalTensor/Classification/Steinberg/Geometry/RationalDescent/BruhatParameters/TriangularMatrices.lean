module

public import Mathlib.LinearAlgebra.Matrix.Diagonal
public import Mathlib.Algebra.Field.Subfield.Basic
public import Mathlib.Algebra.Order.BigOperators.Group.LocallyFinite

/-!
# Rational extraction of triangular matrix factors

For an actual product of a lower unit triangular matrix, a nonzero diagonal
matrix and an upper unit triangular matrix, every factor entry lies in the
field generated by the product entries. Induction on the sum of the row and
column indices recovers each entry: terms before the pivot are already known,
and the new term is divided only by a nonzero diagonal entry.

This supplies the matrix extraction in Steinberg, *Lectures on Chevalley
Groups*, Theorem 7(b), p. 65 (`refs/KGroup/GLS3/Chapter2St1.tex`). The separate
literal-root calculation must identify its root products with these
triangular factors; no such identification is assumed as a source theorem.
-/

open scoped BigOperators
public section

namespace ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.Geometry.RationalDescent.BruhatParameters
variable {F : Type*} [Field F] {n : ℕ}

private theorem mul_diagonal_mul_entry (L U : Matrix (Fin n) (Fin n) F)
    (d : Fin n → F) (hL : ∀ i j, i < j → L i j = 0)
    (hU : ∀ i j, j < i → U i j = 0) (i j : Fin n) :
    (L * Matrix.diagonal d * U) i j =
      L i (min i j) * d (min i j) * U (min i j) j +
        ∑ k ∈ Finset.Iio (min i j), L i k * d k * U k j := by
  rw [Matrix.mul_apply]
  simp only [Matrix.mul_diagonal]
  rw [Finset.add_sum_Iio_eq_sum_Iic (f := fun k => L i k * d k * U k j) (min i j)]
  symm
  apply Finset.sum_subset (Finset.subset_univ _)
  intro k _ hk
  have hmin : min i j < k := lt_of_not_ge (by simpa only [Finset.mem_Iic] using hk)
  rcases min_lt_iff.mp hmin with hi | hj
  · rw [hL i k hi, zero_mul, zero_mul]
  · rw [hU k j hj, mul_zero]

/-- Recovering every factor of an actual unit triangular decomposition. -/
theorem entries_mem_of_triangular_factorization
    (S : Subfield F) (L U : Matrix (Fin n) (Fin n) F) (d : Fin n → F)
    (hL : ∀ i j, i < j → L i j = 0) (hU : ∀ i j, j < i → U i j = 0)
    (hLd : ∀ i, L i i = 1) (hUd : ∀ i, U i i = 1) (hd : ∀ i, d i ≠ 0)
    (hA : ∀ i j, (L * Matrix.diagonal d * U) i j ∈ S) :
    (∀ i j, L i j ∈ S) ∧ (∀ i, d i ∈ S) ∧ (∀ i j, U i j ∈ S) := by
  have recover : ∀ N (i j : Fin n), i.val + j.val = N →
      L i j ∈ S ∧ U i j ∈ S ∧ (i = j → d i ∈ S) := by
    intro N
    induction N using Nat.strong_induction_on with
    | h N ih =>
      intro i j hij
      have hsum : (∑ k ∈ Finset.Iio (min i j), L i k * d k * U k j) ∈ S := by
        apply S.sum_mem
        intro k hk
        have hki : k.val < i.val := (lt_min_iff.mp (Finset.mem_Iio.mp hk)).1
        have hkj : k.val < j.val := (lt_min_iff.mp (Finset.mem_Iio.mp hk)).2
        exact S.mul_mem
          (S.mul_mem ((ih (i.val + k.val) (by omega) i k rfl).1)
            ((ih (k.val + k.val) (by omega) k k rfl).2.2 rfl))
          ((ih (k.val + j.val) (by omega) k j rfl).2.1)
      have hlead : L i (min i j) * d (min i j) * U (min i j) j ∈ S := by
        have he := mul_diagonal_mul_entry L U d hL hU i j
        have hm := S.sub_mem (hA i j) hsum
        rwa [he, add_sub_cancel_right] at hm
      rcases lt_trichotomy i j with hij' | rfl | hij'
      · rw [min_eq_left (le_of_lt hij'), hLd, one_mul] at hlead
        have hdi : d i ∈ S := (ih (i.val + i.val) (by omega) i i rfl).2.2 rfl
        refine ⟨?_, ?_, fun h => False.elim (ne_of_lt hij' h)⟩
        · rw [hL i j hij']; exact S.zero_mem
        · have hm := S.div_mem hlead hdi
          simpa only [mul_div_cancel_left₀ _ (hd i)] using hm
      · simp only [min_self, hLd, hUd, one_mul, mul_one] at hlead
        exact ⟨hLd i ▸ S.one_mem, hUd i ▸ S.one_mem, fun _ => hlead⟩
      · rw [min_eq_right (le_of_lt hij'), hUd, mul_one] at hlead
        have hdj : d j ∈ S := (ih (j.val + j.val) (by omega) j j rfl).2.2 rfl
        refine ⟨?_, ?_, fun h => False.elim (ne_of_gt hij' h)⟩
        · have hm := S.div_mem hlead hdj
          simpa only [mul_div_cancel_right₀ _ (hd j)] using hm
        · rw [hU i j hij']; exact S.zero_mem
  exact ⟨fun i j => (recover _ i j rfl).1,
    fun i => (recover _ i i rfl).2.2 rfl,
    fun i j => (recover _ i j rfl).2.1⟩
end ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.Geometry.RationalDescent.BruhatParameters
