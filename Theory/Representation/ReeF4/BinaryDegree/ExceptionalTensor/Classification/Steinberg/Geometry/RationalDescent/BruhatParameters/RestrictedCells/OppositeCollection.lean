module

public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.Geometry.RationalDescent.BruhatParameters.RestrictedCells.NormalizerWords
public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.Geometry.Universal.CharacterSeparation.Generation.RootUniqueness.TangentSpan.DimensionBound.DenseParameters.CarrierBruhat.PositiveCollection
public import Theory.SpecificGroups.ReeF4.LocalBlockInput.OuterOddSubgroups.PairNormalization.WeylOpposition.Matrix

/-!
# Collection in the negative F4 root subgroup

The checked opposition matrix conjugates every root curve to its actual
negative. Transporting positive-root collection along its carrier lift gives
negative-root coordinates in any prescribed positive ordering. Inverse
conjugation by a direct coroot product preserves this negative subgroup.

Source: Steinberg, *Lectures on Chevalley Groups*, Lemma 17 and Theorem 4′,
`refs/KGroup/GLS3/Chapter2St1.tex`.
-/

@[expose] public section
noncomputable section
open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
open F4Chevalley F4Chevalley.DenseParameters F4Chevalley.DenseParameters.CarrierBruhat
open RootPairing.IntegralGeckConstruction ReeF4.WordRelations
namespace ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.Geometry.RationalDescent.BruhatParameters.RestrictedCells
local instance restrictedOppositeRootNeg : InvolutiveNeg Root := typeF4RootPairing.indexNeg
variable {k : Type*} [Field k] [IsAlgClosed k]

/-- The subgroup generated by precisely the negative root curves. -/
def negativeUnipotent : Subgroup (Variety.Point (Carrier (k := k))) :=
  Subgroup.closure {x | ∃ (r : Root) (a : k),
    ¬ typeF4RootPairing_base.IsPos r ∧ x = DenseParameters.rootElement r a}

theorem rootElement_mem_negativeUnipotent (r : Root)
    (hr : ¬ typeF4RootPairing_base.IsPos r) (a : k) :
    DenseParameters.rootElement r a ∈ negativeUnipotent (k := k) :=
  Subgroup.subset_closure ⟨r, a, hr, rfl⟩

private theorem literalMatrix_weylWord (l : List (Fin 4)) :
    literalMatrix (weylWord (F := k) l) = titsUnit (l.map typeF4RootPairing_baseEquiv) := by
  induction l with
  | nil => simp [weylWord]
  | cons i l ih =>
    change literalMatrix (algebraicNElement (typeF4SimpleRootIndex i) 1 * weylWord l) = _
    rw [map_mul, literalMatrix_simpleN, ih]
    simp only [List.map_cons, titsUnit_cons, titsUnit_nil, mul_one]

variable [CharP k 2]

private def opposition : Variety.Point (Carrier (k := k)) :=
  weylWord [0, 1, 2, 3] ^ 6

private theorem literalMatrix_opposition :
    literalMatrix (opposition (k := k)) = ReeF4.WordRelations.Faithfulness.Adjoint.omegaUnit := by
  rw [opposition, map_pow, literalMatrix_weylWord]
  have h (l : List typeF4RootPairing_base.support) :
      titsUnit (S := k) l = ReeF4.WordRelations.Faithfulness.Adjoint.titsWordUnit l := by
    apply Units.ext
    rw [ReeF4.WordRelations.Faithfulness.Adjoint.titsWordUnit_val]
    rfl
  rw [h]
  exact ReeF4.LocalBlockInput.PairNormalization.WeylOpposition.coxeterWord_pow_six_eq_omega

private theorem opposition_conj_root (r : Root) (a : k) :
    opposition * DenseParameters.rootElement r a * opposition⁻¹ = DenseParameters.rootElement (-r) a := by
  apply literalMatrix_injective
  simp only [map_mul, map_inv, literalMatrix_opposition, literalMatrix_root]
  exact ReeF4.LocalBlockInput.PairNormalization.WeylOpposition.omega_conj_rootCurve r a

private theorem opposition_inv : (opposition (k := k))⁻¹ = opposition := by
  apply literalMatrix_injective
  rw [map_inv, literalMatrix_opposition]
  exact Units.ext rfl

/-- Negative-root collection, in the literal opposite of any positive ordering. -/
theorem orderedNegativeCoverage (p : BruhatParameters.PositiveOrdering)
    (v : Variety.Point (Carrier (k := k))) (hv : v ∈ negativeUnipotent (k := k)) :
    ∃ b : Fin 24 → k, v = BruhatParameters.rootProduct (fun i => -(p i).val) b := by
  let f := (MulAut.conj (opposition (k := k))).toMonoidHom
  have hc : negativeUnipotent (k := k) ≤ (positiveUnipotent (k := k)).comap f := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨r, a, hr, rfl⟩
    change opposition * DenseParameters.rootElement r a * opposition⁻¹ ∈ positiveUnipotent
    rw [opposition_conj_root]
    exact rootElement_mem_positiveUnipotent _
      ((RootPairing.Base.IsPos.neg_iff_not _ _).mpr hr) _
  obtain ⟨b, hb⟩ := orderedPositiveCoverage p (f v) (hc hv)
  refine ⟨b, ?_⟩
  have he : f (f v) = v := by
    change opposition * (opposition * v * opposition⁻¹) * opposition⁻¹ = v
    nth_rw 1 [← opposition_inv]
    nth_rw 2 [opposition_inv]
    group
  rw [← he, hb]
  change f (DenseParameters.rootProduct (fun i => (p i).val) b) = _
  simp only [DenseParameters.rootProduct, BruhatParameters.rootProduct, map_list_prod,
    List.map_ofFn, Function.comp_def]
  congr 1
  apply congrArg List.ofFn
  funext i
  exact opposition_conj_root _ _

omit [CharP k 2] in
private theorem literalMatrix_corootProduct (t : Fin 4 → kˣ) :
    literalMatrix (corootProduct t) = torusElement t⁻¹ := by
  apply matrixAmbientEquiv.injective
  rw [literalMatrix_ambient]
  exact corootProduct_ambient t

omit [CharP k 2] in
/-- The direct coroot product normalizes the actual negative root subgroup. -/
theorem corootProduct_inv_conj_negative (t : Fin 4 → kˣ)
    {v : Variety.Point (Carrier (k := k))} (hv : v ∈ negativeUnipotent (k := k)) :
    (corootProduct t)⁻¹ * v * corootProduct t ∈ negativeUnipotent (k := k) := by
  let f := (MulAut.conj (corootProduct t)⁻¹).toMonoidHom
  have hc : negativeUnipotent (k := k) ≤ (negativeUnipotent (k := k)).comap f := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨r, a, hr, rfl⟩
    have he : f (DenseParameters.rootElement r a) = DenseParameters.rootElement r
        ((integralChevalleyRootScale (P := typeF4RootPairing) (torusParameter t⁻¹) r : k) * a) := by
      apply literalMatrix_injective
      change literalMatrix ((corootProduct t)⁻¹ * DenseParameters.rootElement r a * ((corootProduct t)⁻¹)⁻¹) = _
      simp only [inv_inv, map_mul, map_inv, literalMatrix_corootProduct, literalMatrix_root]
      exact rootCurve_torus_conjugation (torusParameter t⁻¹) r a
    change f (DenseParameters.rootElement r a) ∈ negativeUnipotent
    rw [he]
    exact rootElement_mem_negativeUnipotent r hr _
  simpa only [Subgroup.mem_comap, f, MulEquiv.coe_toMonoidHom, MulAut.conj_apply,
    inv_inv] using hc hv

end ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.Geometry.RationalDescent.BruhatParameters.RestrictedCells
