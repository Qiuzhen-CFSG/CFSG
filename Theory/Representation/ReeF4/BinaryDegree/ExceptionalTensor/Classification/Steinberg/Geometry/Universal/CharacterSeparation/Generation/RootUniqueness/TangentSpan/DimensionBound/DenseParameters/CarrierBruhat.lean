module

public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.Geometry.Universal.CharacterSeparation.Generation.RootUniqueness.TangentSpan.DimensionBound.DenseParameters
public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.Geometry.Universal.CharacterSeparation.Generation.RootUniqueness.TangentSpan.DimensionBound.DenseParameters.CarrierBruhat.Generation
public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.Geometry.Universal.CharacterSeparation.Generation.RootUniqueness.TangentSpan.DimensionBound.DenseParameters.CarrierBruhat.PositiveCollection
public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.Geometry.Universal.CharacterSeparation.Generation.RootUniqueness.TangentSpan.DimensionBound.DenseParameters.CarrierBruhat.NegativeExchange

/-!
# Assembly of literal F4 root-word normal forms

Local negative-simple exchange gives `U N U` coverage by word induction.
Collection of each positive factor then gives exactly the two ordered 24-root
products consumed by `DenseParameters.exists_dense_of_normal_forms`.

In characteristic two, positive-root collection and negative-simple exchange
discharge both local hypotheses, leaving only exact `RootTransport` for the
literal normalizer words. Coverage holds for any two enumerations of the positive
roots; `positiveOrdering` supplies an actual enumeration. The density corollary
additionally takes finitely many normalizer representatives modulo the split
torus.

This is the unrestricted existence consequence of GLS3 1.11.5, with the literal
rank-one words of 1.12.1. Restricted right factors and uniqueness are separate
statements. Source: `refs/KGroup/GLS3/Chapter1.tex`, §§1.11–1.12.
-/

public section
noncomputable section

namespace Theory.AlgebraicGroup.F4Chevalley.DenseParameters.CarrierBruhat

universe u
variable {k : Type u} [Field k] [IsAlgClosed k]

local instance : AlgebraicGroup (splitTorus (k := k)).carrierVariety :=
  (splitTorus (k := k)).carrierAlgebraicGroup

/-- Ordered collection and local exchange supply the exact literal-word
coverage contract used by the density theorem. -/
theorem exists_normal_forms_of_local_relations (p q : PositiveOrdering)
    (hcollection : OrderedPositiveCoverage (k := k))
    (hexchange : NegativeSimpleExchange (k := k))
    (g : Variety.Point (Carrier (k := k))) :
    ∃ (a b : Fin 24 → k) (n : Variety.Point (Carrier (k := k))),
      n ∈ normalizerWords (k := k) ∧
      g = rootProduct (fun i => (p i).val) a * n * rootProduct (fun i => (q i).val) b := by
  obtain ⟨u, hu, n, hn, v, hv, hg⟩ :=
    exists_unrestricted_factors_of_negativeSimpleExchange hexchange g
  obtain ⟨a, ha⟩ := hcollection p u hu
  obtain ⟨b, hb⟩ := hcollection q v hv
  exact ⟨a, b, n, hn, by rw [← ha, ← hb]; exact hg⟩

/-- The local algebraic inputs connect directly to the existing geometric
density reduction. No group coverage is an additional premise. -/
theorem exists_dense_of_local_relations (p q : PositiveOrdering)
    (hcollection : OrderedPositiveCoverage (k := k))
    (hexchange : NegativeSimpleExchange (k := k))
    (hnormalizer : ∃ W : Finset (Variety.Point (Carrier (k := k))),
      ∀ n ∈ normalizerWords (k := k), ∃ w ∈ W,
        ∃ s : Variety.Point (splitTorus (k := k)).carrierVariety,
          n = w * (splitTorus (k := k)).inclusion.onPoints s) :
    ∃ f : Variety.Morphism (concreteRootParameterSpace (k := k)) (Carrier (k := k)),
      Dense (Set.range f.toFun) :=
  exists_dense_of_normal_forms (fun i => (p i).val) (fun i => (q i).val)
    (exists_normal_forms_of_local_relations p q hcollection hexchange) hnormalizer

variable [CharP k 2]

/-- Every point of the literal F4 carrier has positive–normalizer–positive
factors, assuming exact root transport for the normalizer words. Positive-root
partition and negative-simple exchange are discharged by their carrier proofs. -/
theorem exists_unrestricted_factors_of_rootTransport
    (htransport : ∀ n ∈ normalizerWords (k := k), Nonempty (RootTransport n))
    (g : Variety.Point (Carrier (k := k))) :
    ∃ u ∈ positiveUnipotent (k := k), ∃ n ∈ normalizerWords (k := k),
      ∃ v ∈ positiveUnipotent (k := k), g = u * n * v :=
  exists_unrestricted_factors_of_negativeSimpleExchange
    (negativeSimpleExchange_of_partition positiveRootPartition htransport) g

/-- Literal ordered Bruhat coverage over an algebraically closed field of
characteristic two. The two positive-root enumerations are arbitrary, and the
middle factor belongs to the subgroup generated by the actual rank-one words.
This is exactly the coverage premise of `exists_dense_of_normal_forms`. -/
theorem exists_normal_forms_of_rootTransport (p q : PositiveOrdering)
    (htransport : ∀ n ∈ normalizerWords (k := k), Nonempty (RootTransport n))
    (g : Variety.Point (Carrier (k := k))) :
    ∃ (a b : Fin 24 → k) (n : Variety.Point (Carrier (k := k))),
      n ∈ normalizerWords (k := k) ∧
      g = rootProduct (fun i => (p i).val) a * n * rootProduct (fun i => (q i).val) b :=
  exists_normal_forms_of_local_relations p q orderedPositiveCoverage
    (negativeSimpleExchange_of_partition positiveRootPartition htransport) g

/-- With exact root transport and finite normalizer representatives modulo the
literal split torus, the concrete torus-and-root parameter space has a morphism
with dense image in the F4 carrier. No collection or coverage premise remains. -/
theorem exists_dense_of_rootTransport (p q : PositiveOrdering)
    (htransport : ∀ n ∈ normalizerWords (k := k), Nonempty (RootTransport n))
    (hnormalizer : ∃ W : Finset (Variety.Point (Carrier (k := k))),
      ∀ n ∈ normalizerWords (k := k), ∃ w ∈ W,
        ∃ s : Variety.Point (splitTorus (k := k)).carrierVariety,
          n = w * (splitTorus (k := k)).inclusion.onPoints s) :
    ∃ f : Variety.Morphism (concreteRootParameterSpace (k := k)) (Carrier (k := k)),
      Dense (Set.range f.toFun) :=
  exists_dense_of_normal_forms (fun i => (p i).val) (fun i => (q i).val)
    (exists_normal_forms_of_rootTransport p q htransport) hnormalizer

end Theory.AlgebraicGroup.F4Chevalley.DenseParameters.CarrierBruhat
