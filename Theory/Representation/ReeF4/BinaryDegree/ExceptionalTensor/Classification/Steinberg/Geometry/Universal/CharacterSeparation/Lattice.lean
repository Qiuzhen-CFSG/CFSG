module

public import Theory.Representation.ReeF4.BinaryDegree.ExceptionalTensor.Classification.Steinberg.Geometry.Universal.Characters
public import Theory.AlgebraicGroup.Tori.Character.Operations

/-!
# F4 character separation from a finite common root kernel

Reflection induction puts every actual root character in the subgroup generated
by the four characters indexed by the displayed standard F4 base. This base
need not be the base originally chosen in the root-system model.

The integral inverse of the F4 Cartan matrix then adjusts any torus point by a
product of the four actual coroots so that all root characters evaluate to one.
A character with zero coroot coordinates retains its value under this
adjustment. If the common root kernel is finite, a nontrivial such character
would map a finite set onto all nonzero field elements, a contradiction.

This proves the lattice step in GLS3, Proposition 1.14.1(a), with the geometric
finiteness input explicit. No coroot-generation or universality hypothesis is
used. Source: `refs/KGroup/GLS3/Chapter1.tex`, Sections 1.9 and 1.14.
-/

public section

open Theory.AlgebraicGroup Theory.AlgebraicGroup.StandardRootSystem
open scoped BigOperators

universe u

namespace Theory.AlgebraicGroup.RootSystemModel
variable {k : Type u} [Field k] [IsAlgClosed k]
variable {G : Variety k} [AlgebraicGroup G]
variable (M : RootSystemModel typeF4RootPairingULift G)

omit [IsAlgClosed k] in
private lemma pairing_reflect (a b c : M.rootData.Root) :
    M.rootData.pairing (M.rootData.reflect a b) c =
      M.rootData.pairing b c - M.rootData.pairing b a * M.rootData.pairing a c := by
  apply (Int.cast_injective : Function.Injective (fun n : ℤ => (n : ℝ)))
  push_cast
  simp only [M.actual.1, M.actual.2.1, RootPairing.pairing, RootPairing.root',
    RootPairing.root_reflectionPerm, RootPairing.reflection_apply_root,
    map_sub, map_smul, LinearMap.sub_apply, LinearMap.smul_apply, smul_eq_mul]

omit [IsAlgClosed k] in
/-- The actual root reflection agrees with the displayed standard F4 reflection. -/
lemma f4RootIndex_reflect (a b : M.rootData.Root) :
    M.f4RootIndex (M.rootData.reflect a b) =
      typeF4RootPairing.reflectionPerm (M.f4RootIndex a) (M.f4RootIndex b) := by
  apply typeF4RootPairing_base.injective_pairingIn
  funext j
  dsimp only
  obtain ⟨c, hc⟩ := M.f4RootIndex.surjective j
  rw [← hc, ← M.f4_pairing_eq, pairing_reflect]
  apply (Int.cast_injective : Function.Injective (fun n : ℤ => (n : ℝ)))
  push_cast
  have hcast (i j : typeF4Roots) :
      (typeF4RootPairing.pairingIn ℤ i j : ℝ) = typeF4RootPairing.pairing i j :=
    typeF4RootPairing.algebraMap_pairingIn ℤ i j
  simp only [M.f4_pairing_eq, hcast, RootPairing.pairing, RootPairing.root',
    RootPairing.root_reflectionPerm, RootPairing.reflection_apply_root,
    map_sub, map_smul, LinearMap.sub_apply, LinearMap.smul_apply, smul_eq_mul]

omit [IsAlgClosed k] in
/-- Every actual root character is generated by the displayed simple-root characters. -/
lemma f4_rootWeight_mem_simple_closure (a : M.rootData.Root) :
    M.rootData.rootWeight a ∈ Subgroup.closure
      (Set.range fun i : Fin 4 => M.rootData.rootWeight (M.f4SimpleRoot i)) := by
  let S := Subgroup.closure
    (Set.range fun i : Fin 4 => M.rootData.rootWeight (M.f4SimpleRoot i))
  have hsimple (i : typeF4Roots) (hi : i ∈ typeF4RootPairing_base.support) :
      M.rootData.rootWeight (M.f4RootIndex.symm i) ∈ S := by
    obtain ⟨j, hj⟩ := typeF4RootPairing_baseEquiv.surjective ⟨i, hi⟩
    apply Subgroup.subset_closure
    refine ⟨j, ?_⟩
    apply congrArg M.rootData.rootWeight
    apply M.f4RootIndex.injective
    rw [M.f4SimpleRoot_rootIndex, Equiv.apply_symm_apply]
    exact congrArg Subtype.val hj
  have hreflect (i j : typeF4Roots) :
      M.f4RootIndex.symm (typeF4RootPairing.reflectionPerm j i) =
      M.rootData.reflect (M.f4RootIndex.symm j) (M.f4RootIndex.symm i) := by
    apply M.f4RootIndex.injective
    simp only [f4RootIndex_reflect, Equiv.apply_symm_apply]
  have hweight := M.realization.2.2.2.2.2.1
  have hall (i : typeF4Roots) : M.rootData.rootWeight (M.f4RootIndex.symm i) ∈ S := by
    apply typeF4RootPairing_base.induction_reflect i
    · intro i hi
      rw [hreflect, hweight]
      exact S.mul_mem hi (S.zpow_mem hi _)
    · exact hsimple
    · intro i j hi hj
      rw [hreflect, hweight]
      exact S.mul_mem hi (S.zpow_mem (hsimple j hj) _)
  simpa only [Equiv.symm_apply_apply] using hall (M.f4RootIndex a)

omit [IsAlgClosed k] in
/-- The displayed actual simple roots have the standard integral F4 Cartan matrix. -/
lemma f4SimpleRoot_pairing (i j : Fin 4) :
    M.rootData.pairing (M.f4SimpleRoot i) (M.f4SimpleRoot j) =
      typeF4CartanMatrix i j := by
  rw [M.f4_pairing_eq, M.f4SimpleRoot_rootIndex, M.f4SimpleRoot_rootIndex,
    ← RootPairing.Base.cartanMatrixIn_def ℤ typeF4RootPairing_base]
  exact typeF4RootPairing_base_cartan_apply i j

private def cartanInverse : Matrix (Fin 4) (Fin 4) ℤ :=
  !![2, 3, 4, 2; 3, 6, 8, 4; 2, 4, 6, 3; 1, 2, 3, 2]

private lemma cartan_mul_inverse : typeF4CartanMatrix * cartanInverse = 1 := by
  decide

private lemma prod_zpow_eq {A : Type*} [CommGroup A] {ι : Type*}
    (s : Finset ι) (a : A) (f : ι → ℤ) :
    (∏ i ∈ s, a ^ f i) = a ^ ∑ i ∈ s, f i := by
  classical
  induction s using Finset.induction_on with
  | empty => simp
  | insert i s hi ih => simp [hi, ih, zpow_add]

private lemma cartan_preimage {A : Type*} [CommGroup A] (a : Fin 4 → A) :
    ∃ b : Fin 4 → A, ∀ i, ∏ j, b j ^ typeF4CartanMatrix i j = a i := by
  refine ⟨fun j => ∏ l, a l ^ cartanInverse j l, ?_⟩
  intro i
  simp_rw [← Finset.prod_zpow, ← zpow_mul]
  rw [Finset.prod_comm]
  simp_rw [prod_zpow_eq]
  have hcoeff (l : Fin 4) :
      ∑ j, cartanInverse j l * typeF4CartanMatrix i j = if i = l then 1 else 0 := by
    have h := congrFun (congrFun cartan_mul_inverse i) l
    simpa only [Matrix.mul_apply, Matrix.one_apply, mul_comm] using h
  simp_rw [hcoeff]
  simp

private noncomputable def evalCharacter (χ : TorusWeight M.torus) :
    Variety.Point M.torus.carrierVariety →* kˣ :=
  (MonoidHom.eval χ).comp (torusPointEval M.torus.carrierVariety)

omit [IsAlgClosed k] in
private lemma evalCharacter_coroot (χ : TorusWeight M.torus) (j : Fin 4) (b : kˣ) :
    evalCharacter M χ (M.rootData.rootCocharacter (M.f4SimpleRoot j) |>.onPoints
      ((dPointEquiv 1).symm fun _ => b)) =
      b ^ M.rootData.weightPairing χ (M.f4SimpleRoot j) := by
  apply Units.ext
  have h := M.realization.weightPairing_spec χ (M.f4SimpleRoot j)
    ((dPointEquiv 1).symm fun _ => b)
  change χ.pointCharacter _ = (b ^ _ : kˣ).val
  simpa only [Equiv.apply_symm_apply, Units.val_zpow_eq_zpow_val] using h

omit [IsAlgClosed k] in
private lemma exists_coroot_adjustment (t : Variety.Point M.torus.carrierVariety) :
    ∃ q : Variety.Point M.torus.carrierVariety,
      (∀ i, evalCharacter M (M.rootData.rootWeight (M.f4SimpleRoot i)) q =
        evalCharacter M (M.rootData.rootWeight (M.f4SimpleRoot i)) t) ∧
      (∀ χ : TorusWeight M.torus,
        (∀ i, M.rootData.weightPairing χ (M.f4SimpleRoot i) = 0) →
          evalCharacter M χ q = 1) := by
  obtain ⟨b, hb⟩ := cartan_preimage
    (fun i => evalCharacter M (M.rootData.rootWeight (M.f4SimpleRoot i)) t)
  let q := (List.ofFn fun j : Fin 4 =>
    (M.rootData.rootCocharacter (M.f4SimpleRoot j)).onPoints
      ((dPointEquiv 1).symm fun _ => b j)).prod
  refine ⟨q, ?_, ?_⟩
  · intro i
    dsimp only [q]
    rw [map_list_prod, List.map_ofFn, List.prod_ofFn]
    dsimp only [Function.comp_apply]
    simp_rw [evalCharacter_coroot, M.realization.weightPairing_rootWeight,
      f4SimpleRoot_pairing]
    exact hb i
  · intro χ hχ
    dsimp only [q]
    rw [map_list_prod, List.map_ofFn, List.prod_ofFn]
    dsimp only [Function.comp_apply]
    simp_rw [evalCharacter_coroot, hχ, zpow_zero]
    simp

omit [IsAlgClosed k] in
private lemma evalCharacter_roots_eq_one_of_simple
    (t : Variety.Point M.torus.carrierVariety)
    (ht : ∀ i, evalCharacter M (M.rootData.rootWeight (M.f4SimpleRoot i)) t = 1)
    (a : M.rootData.Root) : evalCharacter M (M.rootData.rootWeight a) t = 1 := by
  have hle : Subgroup.closure
      (Set.range fun i : Fin 4 => M.rootData.rootWeight (M.f4SimpleRoot i)) ≤
      (torusPointEval M.torus.carrierVariety t).ker := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨i, rfl⟩
    exact ht i
  exact hle (M.f4_rootWeight_mem_simple_closure a)

/-- A finite common root kernel makes the four actual coroot coordinates separate characters. -/
lemma f4CorootCoordinates_injective_of_rootKernel_finite
    (hfinite : {t : Variety.Point M.torus.carrierVariety |
      ∀ a, (M.rootData.rootWeight a).pointCharacter t = 1}.Finite) :
    Function.Injective M.f4CorootCoordinates := by
  have htriv (χ : TorusWeight M.torus)
      (hχ : ∀ i, M.rootData.weightPairing χ (M.f4SimpleRoot i) = 0) : χ = 1 := by
    by_contra hn
    have hsurj : Function.Surjective
        (fun t : {t : Variety.Point M.torus.carrierVariety |
          ∀ a, (M.rootData.rootWeight a).pointCharacter t = 1} =>
            evalCharacter M χ t.val) := by
      intro c
      obtain ⟨t, ht⟩ := χ.exists_pointCharacter_eq_of_ne_one M.maximalTorus.1 hn
        (c : k) c.ne_zero
      obtain ⟨q, hq, hqχ⟩ := exists_coroot_adjustment M t
      have hy (a : M.rootData.Root) :
          (M.rootData.rootWeight a).pointCharacter (t * q⁻¹) = 1 := by
        have he := evalCharacter_roots_eq_one_of_simple M (t * q⁻¹) (by
          intro i
          rw [map_mul, map_inv, hq i, mul_inv_cancel]) a
        exact congrArg Units.val he
      refine ⟨⟨t * q⁻¹, hy⟩, ?_⟩
      change evalCharacter M χ (t * q⁻¹) = c
      rw [map_mul, map_inv, hqχ χ hχ, inv_one, mul_one]
      exact Units.ext ht
    let := hfinite.to_subtype
    have : Finite kˣ := Finite.of_surjective _ hsurj
    have hrange : (Set.range (Units.val : kˣ → k)).Finite := Set.finite_range _
    apply (Set.finite_singleton (0 : k)).infinite_compl
    apply hrange.subset
    intro c hc
    exact ⟨Units.mk0 c hc, rfl⟩
  intro x y hxy
  have hzero : M.f4CorootCoordinates (x - y) = 0 := by
    rw [map_sub, hxy, sub_self]
  have hχ := htriv (Additive.toMul (x - y)) (fun i => by
    rw [← M.f4CorootCoordinates_apply]
    exact congrFun hzero i)
  apply sub_eq_zero.mp
  exact congrArg Additive.ofMul hχ

end Theory.AlgebraicGroup.RootSystemModel
