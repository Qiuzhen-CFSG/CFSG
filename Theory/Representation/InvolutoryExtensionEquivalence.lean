module

public import Theory.Representation.RepEquiv
public import Mathlib.Algebra.Field.ZMod
public import Mathlib.RepresentationTheory.Irreducible
public import Mathlib.Algebra.Group.Subgroup.Ker
public import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic

/-!
# Equivalence across a normalizing involution in characteristic two

Suppose a group is generated by an image subgroup and one normalizing
involution. Two binary representations whose restrictions are irreducible and
equivalent are equivalent on the whole group.

If `c` intertwines the restrictions, so does its conjugate `t.c`. The map
`c + t.c` intertwines the involution as well. If this sum is nonzero, Schur's
lemma makes it invertible; if it is zero, characteristic two makes `c` itself
intertwine the involution. Generation then gives the whole-group equivalence.
There is no absolute-irreducibility, finite-dimension or classification premise.

Application: compatibility with the outside field involution in
Aschbacher--Smith K.4.5, printed p.460. The mathematical argument here also
applies to other involutory extensions.
-/

@[expose] public section

namespace Representation
variable {G H V W : Type*} [Group G] [Group H] [AddCommGroup V] [Module (ZMod 2) V]
  [AddCommGroup W] [Module (ZMod 2) W]

private theorem equiv_of_generators (ρ : Representation (ZMod 2) G V)
    (σ : Representation (ZMod 2) G W) (N : Subgroup G) (t : G)
    (hgen : N ⊔ Subgroup.zpowers t = ⊤) (e : V ≃ₗ[ZMod 2] W)
    (hN : ∀ n : N, ∀ v, e (ρ n v) = σ n (e v))
    (ht : ∀ v, e (ρ t v) = σ t (e v)) : Nonempty (RepEquiv ρ σ) := by
  let τ := e.conjRingEquiv.toMonoidHom.comp ρ
  have hle : N ⊔ Subgroup.zpowers t ≤ τ.eqLocus σ := by
    apply sup_le
    · intro n hn
      apply LinearMap.ext
      intro w
      change e (ρ n (e.symm w)) = σ n w
      simpa using hN ⟨n, hn⟩ (e.symm w)
    · apply Subgroup.zpowers_le.mpr
      apply LinearMap.ext
      intro w
      change e (ρ t (e.symm w)) = σ t w
      simpa using ht (e.symm w)
  rw [hgen] at hle
  refine ⟨⟨e, fun g => LinearMap.ext fun v => ?_⟩⟩
  have h := LinearMap.congr_fun (hle (Subgroup.mem_top g)) (e v)
  change e (ρ g (e.symm (e v))) = σ g (e v) at h
  simpa using h

/-- An equivalence on an irreducible binary restriction extends across a normalizing involution. -/
theorem exists_equiv_of_irreducible_restriction_involution
    (ρ : Representation (ZMod 2) G V) (σ : Representation (ZMod 2) G W)
    (ι : H →* G) (α : MulAut H) (t : G) (ht : t ^ 2 = 1)
    (hconj : ∀ n, ι (α n) = t * ι n * t⁻¹)
    (hgen : ι.range ⊔ Subgroup.zpowers t = ⊤)
    [IsIrreducible (k := ZMod 2) (ρ.comp ι)]
    [IsIrreducible (k := ZMod 2) (σ.comp ι)]
    (c : RepEquiv (ρ.comp ι) (σ.comp ι)) :
    Nonempty (RepEquiv ρ σ) := by
  have htinv : t⁻¹ = t := inv_eq_of_mul_eq_one_left (by simpa [pow_two] using ht)
  have hρ (v : V) : ρ t (ρ t v) = v := by
    change (ρ t * ρ t) v = v
    rw [← map_mul, ← pow_two, ht, map_one]
    rfl
  have hσ (w : W) : σ t (σ t w) = w := by
    change (σ t * σ t) w = w
    rw [← map_mul, ← pow_two, ht, map_one]
    rfl
  have hneg (w : W) : -w = w := by
    calc
      -w = (-1 : ZMod 2) • w := (neg_one_smul _ _).symm
      _ = w := by rw [show (-1 : ZMod 2) = 1 by decide, one_smul]
  have hc (n : H) (v : V) : c (ρ (ι n) v) = σ (ι n) (c v) :=
    LinearMap.congr_fun (c.isIntertwining' n) v
  let f : IntertwiningMap (ρ.comp ι) (σ.comp ι) := {
    toLinearMap := c.toLinearMap + (σ t).comp (c.toLinearMap.comp (ρ t))
    isIntertwining' := by
      intro n
      apply LinearMap.ext
      intro v
      change c (ρ (ι n) v) + σ t (c (ρ t (ρ (ι n) v))) =
        σ (ι n) (c v + σ t (c (ρ t v)))
      rw [hc, map_add]
      congr 1
      have he : t * ι n = ι (α n) * t := by rw [hconj]; simp [mul_assoc]
      have he' : t * ι (α n) = ι n * t := by
        rw [hconj]
        simp [htinv, ← mul_assoc, ← pow_two, ht]
      calc
        σ t (c (ρ t (ρ (ι n) v))) = σ t (c (ρ (ι (α n)) (ρ t v))) := by
          congr 2
          change (ρ t * ρ (ι n)) v = (ρ (ι (α n)) * ρ t) v
          rw [← map_mul, ← map_mul, he]
        _ = σ t (σ (ι (α n)) (c (ρ t v))) := by rw [hc]
        _ = σ (ι n) (σ t (c (ρ t v))) := by
          change (σ t * σ (ι (α n))) _ = (σ (ι n) * σ t) _
          rw [← map_mul, ← map_mul, he'] }
  have hf_t (v : V) : f (ρ t v) = σ t (f v) := by
    change c (ρ t v) + σ t (c (ρ t (ρ t v))) =
      σ t (c v + σ t (c (ρ t v)))
    rw [hρ, map_add, hσ, add_comm]
  by_cases hf : f = 0
  · apply equiv_of_generators ρ σ ι.range t hgen c.toLinearEquiv
    · rintro ⟨n, h, rfl⟩ v
      exact hc h v
    intro v
    have he : c (ρ t v) + σ t (c v) = 0 := by
      have h := congrArg (fun a : IntertwiningMap (ρ.comp ι)
        (σ.comp ι) => a (ρ t v)) hf
      change c (ρ t v) + σ t (c (ρ t (ρ t v))) = 0 at h
      simpa only [hρ] using h
    exact (eq_neg_of_add_eq_zero_left he).trans (hneg _)
  · have hb := (IsIrreducible.bijective_or_eq_zero f).resolve_right hf
    let e := LinearEquiv.ofBijective f.toLinearMap hb
    apply equiv_of_generators ρ σ ι.range t hgen e
    · rintro ⟨n, h, rfl⟩ v
      exact LinearMap.congr_fun (f.isIntertwining' h) v
    · exact hf_t
end Representation
