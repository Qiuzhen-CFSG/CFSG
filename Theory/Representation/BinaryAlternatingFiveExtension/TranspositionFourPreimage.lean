module
public import Theory.Representation.BinaryAlternatingFiveExtension.FaithfulExtension
public import Theory.Representation.BinaryPermutation.FiveDihedralRecognition
public import Theory.ElementaryAbelian.Quotient
public import Theory.ElementaryAbelian.AbelianNormalClosure

/-!
# The transposition-four preimage in a natural symmetric-five extension

Restrict an actual quotient section to the four-group generated by two
disjoint transpositions. Its image is an elementary abelian supplement to
the exact natural kernel, so the five-core recognition theorem identifies
the preimage with D₈ × D₈. For a full symmetric-five epimorphism the
faithful-kernel extension theorem constructs the section first.

The target has order 64: it is the preimage of a transposition four-group,
not a Sylow subgroup of the full natural symmetric-five extension. This
is the factor used in the Baumann calculation in Aschbacher–Smith 10.2.1,
pp.742–743.
-/

public noncomputable section
open Subgroup
open scoped IsMulCommutative
namespace BinaryPermutation.AlternatingFiveExtension
local notation "S5" => Equiv.Perm (Fin 5)

private theorem canonical_four_elementary :
    IsElementaryAbelian 2
      (closure ({Equiv.swap 0 1,Equiv.swap 2 3} : Set S5)) := by
  let : IsMulCommutative (closure ({Equiv.swap 0 1,Equiv.swap 2 3} : Set S5)) :=
    isMulCommutative_closure (by
      intro x hx y hy
      rcases hx with rfl | hx
      · rcases hy with rfl | hy
        · rfl
        · have hy' : y = Equiv.swap 2 3 := hy
          subst y
          decide
      · have hx' : x = Equiv.swap 2 3 := hx
        subst x
        rcases hy with rfl | hy
        · decide
        · have hy' : y = Equiv.swap 2 3 := hy
          subst y
          rfl)
  apply IsElementaryAbelian.closure_of_isMulCommutative
  intro x hx
  rcases hx with rfl | hx
  · decide
  · have hx' : x = Equiv.swap 2 3 := hx
    subst x
    decide

/-- An actual section provides the elementary supplement needed for
recognition of a transposition-four image with exact natural kernel. -/
theorem dihedral_square_of_transposition_four_image_section
    {G : Type*} [Group G] (q : G →* S5)
    (hr : q.range = closure ({Equiv.swap 0 1,Equiv.swap 2 3} : Set S5))
    (e : q.ker ≃* V)
    (he : ∀ (g : G) (v : q.ker), e (MulAut.conjNormal g v) = coreAction (q g) (e v))
    (σ : q.range →* G) (hσ : q.comp σ = q.range.subtype) :
    Nonempty (G ≃* DihedralGroup 4 × DihedralGroup 4) := by
  have hσv (v : q.range) : q (σ v) = (v : S5) := DFunLike.congr_fun hσ v
  let W := σ.range
  let : IsElementaryAbelian 2 q.range := hr.symm ▸ canonical_four_elementary
  let : IsElementaryAbelian 2 W := IsElementaryAbelian.of_surjective σ.rangeRestrict
    σ.rangeRestrict_surjective
  have hgen : q.ker ⊔ (⊥ : Subgroup G) ⊔ W = ⊤ := by
    rw [sup_bot_eq]
    apply top_unique
    intro g _
    let v : q.range := ⟨q g,⟨g,rfl⟩⟩
    have hk : g * (σ v)⁻¹ ∈ q.ker := by
      change q (g * (σ v)⁻¹) = 1
      rw [map_mul,map_inv,hσv]
      exact mul_inv_cancel _
    have hm := (q.ker ⊔ W).mul_mem ((show q.ker ≤ q.ker ⊔ W from le_sup_left) hk)
      ((show W ≤ q.ker ⊔ W from le_sup_right) (show σ v ∈ W from ⟨v,rfl⟩))
    simpa only [inv_mul_cancel_right] using hm
  have he' (g : G) (x : core (Fin 5)) :
      (e.symm (.ofAdd (coreRepresentation (Fin 5) (q g) x)) : G) =
        g * (e.symm (.ofAdd x) : G) * g⁻¹ := by
    have hh := he g (e.symm (.ofAdd x))
    rw [e.apply_symm_apply] at hh
    have hh' := congrArg (fun v : V => (e.symm v : G)) hh
    simp only [e.symm_apply_apply,MulAut.conjNormal_apply] at hh'
    exact hh'.symm
  obtain ⟨E⟩ := FiveCoreDihedralSquare.recognize q.ker (⊥ : Subgroup G) W
    bot_le disjoint_bot_right q hr (sup_bot_eq _).symm hgen e.symm he'
  exact ⟨E.trans MulEquiv.uniqueProd⟩

/-- The canonical transposition-four preimage of the original symmetric
epimorphism is a product of two dihedral groups of order eight. -/
theorem transposition_four_preimage_dihedral_square
    {G : Type*} [Group G] [Finite G]
    (q : G →* S5) (hq : Function.Surjective q) (e : q.ker ≃* V)
    (he : ∀ (g : G) (v : q.ker), e (MulAut.conjNormal g v) = coreAction (q g) (e v)) :
    Nonempty ((closure ({Equiv.swap 0 1,Equiv.swap 2 3} : Set S5)).comap q ≃*
      DihedralGroup 4 × DihedralGroup 4) := by
  let D := closure ({Equiv.swap 0 1,Equiv.swap 2 3} : Set S5)
  let P := D.comap q
  let f := q.comp P.subtype
  have hkp : q.ker ≤ P := by
    intro x hx
    change q x ∈ D
    rw [show q x = 1 from hx]
    exact D.one_mem
  let ek : f.ker ≃* q.ker := subgroupOfEquivOfLe hkp
  let ef := ek.trans e
  have hef (g : P) (v : f.ker) : ef (MulAut.conjNormal g v) =
      coreAction (f g) (ef v) := he g.val (ek v)
  have hr : f.range = D := by
    rw [MonoidHom.range_comp,range_subtype]
    exact map_comap_eq_self_of_surjective hq D
  obtain ⟨σ,hσ⟩ := exists_section_of_faithful_kernel q hq e he
  have hσv (x : S5) : q (σ x) = x := DFunLike.congr_fun hσ x
  let τ : f.range →* P := {
    toFun x := ⟨σ x,by change q (σ x) ∈ D; rw [hσv]; exact hr ▸ x.property⟩
    map_one' := Subtype.ext (map_one σ)
    map_mul' x y := Subtype.ext (map_mul σ (x:S5) (y:S5)) }
  have hτ : f.comp τ = f.range.subtype := by
    apply MonoidHom.ext
    intro x
    exact hσv x
  exact dihedral_square_of_transposition_four_image_section f hr ef hef τ hτ

/-- The same conclusion holds for any prescribed conjugate of the
transposition four-group, without changing the quotient homomorphism. -/
theorem conjugate_transposition_four_preimage_dihedral_square
    {G : Type*} [Group G] [Finite G]
    (q : G →* S5) (hq : Function.Surjective q) (e : q.ker ≃* V)
    (he : ∀ (g : G) (v : q.ker), e (MulAut.conjNormal g v) = coreAction (q g) (e v))
    (a : S5) :
    Nonempty (((closure ({Equiv.swap 0 1,Equiv.swap 2 3} : Set S5)).map
      (MulAut.conj a).toMonoidHom).comap q ≃* DihedralGroup 4 × DihedralGroup 4) := by
  let D := closure ({Equiv.swap 0 1,Equiv.swap 2 3} : Set S5)
  obtain ⟨g,hg⟩ := hq a
  have hm : (D.comap q).map (MulAut.conj g).toMonoidHom =
      (D.map (MulAut.conj a).toMonoidHom).comap q := by
    ext x
    constructor
    · rintro ⟨y,hy,rfl⟩
      refine ⟨q y,hy,?_⟩
      change a * q y * a⁻¹ = q (g*y*g⁻¹)
      rw [map_mul,map_mul,map_inv,hg]
    · rintro ⟨y,hy,heq⟩
      refine ⟨g⁻¹*x*g,?_,by simp [MulAut.conj_apply,mul_assoc]⟩
      change q (g⁻¹*x*g) ∈ D
      have hxy : q (g⁻¹*x*g) = y := by
        rw [map_mul,map_mul,map_inv,hg,←heq]
        change a⁻¹ * (a*y*a⁻¹) * a = y
        group
      rwa [hxy]
  obtain ⟨E⟩ := transposition_four_preimage_dihedral_square q hq e he
  exact ⟨(MulEquiv.subgroupCongr hm.symm).trans
    (((MulAut.conj g).subgroupMap (D.comap q)).symm.trans E)⟩

end BinaryPermutation.AlternatingFiveExtension
