module

public import Theory.Representation.CentralCoverOriginalAction

/-!
# Equivariance over a central quotient

An equivariant map for a normal subgroup extends to the full actor when its
source is generated by that subgroup's commutators and its quotient kernel is
fixed by the full actor. For each group element the failure of equivariance
is a linear map into the central kernel. Normality makes this map invariant
under the generating subgroup, so it vanishes.

This gives the full-actor comparison used for natural central extensions in
Aschbacher--Smith, *The Classification of Quasithin Groups*, B.4.6(1), printed
p.88, via the module covering convention of I.1.5, printed p.408.
-/

@[expose] public section

open Representation Representation.OneCohomology
namespace Representation.OneCohomology.CentralCoverOriginalAction
variable {k G U W N : Type*} [Field k] [Group G]
  [AddCommGroup U] [Module k U] [AddCommGroup W] [Module k W]
  [AddCommGroup N] [Module k N]

/-- A map over a central quotient that intertwines a normal generating actor
intertwines the whole group. The difference of its two translates takes values
in the fixed kernel and annihilates all normal-subgroup displacements. -/
theorem equivariant_of_normal_generated
    (H : Subgroup G) [H.Normal]
    (α : Representation k G U) (β : Representation k G W)
    (ν : Representation k G N)
    (q : α.IntertwiningMap ν) (p : β.IntertwiningMap ν)
    (hα : Coinvariants.ker (α.comp H.subtype) = ⊤)
    (hp : p.toLinearMap.ker ≤ fixed β)
    (f : U →ₗ[k] W)
    (hf : ∀ h : H, ∀ u, f (α h.val u) = β h.val (f u))
    (hover : ∀ u, p (f u) = q u) :
    ∀ g u, f (α g u) = β g (f u) := by
  intro g
  let d : U →ₗ[k] W := f.comp (α g) - (β g).comp f
  have hdker (u : U) : d u ∈ p.toLinearMap.ker := by
    change p (f (α g u) - β g (f u)) = 0
    rw [map_sub, hover, p.isIntertwining, hover, q.isIntertwining, sub_self]
  have hd : d = 0 := by
    apply invariant_map_eq_zero (α.comp H.subtype) hα d
    intro h u
    let h' : H := ⟨g * h.val * g⁻¹, (inferInstance : H.Normal).conj_mem h.val h.property g⟩
    have ha : α g (α h.val u) = α h'.val (α g u) := by
      simp only [← Module.End.mul_apply, ← map_mul]
      congr 2
      dsimp [h']
      group
    have hb : β g (β h.val (f u)) = β h'.val (β g (f u)) := by
      simp only [← Module.End.mul_apply, ← map_mul]
      congr 2
      dsimp [h']
      group
    change f (α g (α h.val u)) - β g (f (α h.val u)) =
      f (α g u) - β g (f u)
    rw [ha, hf h', hf h, hb, ← map_sub]
    exact hp (hdker u) h'.val
  intro u
  exact sub_eq_zero.mp (LinearMap.congr_fun hd u)
end Representation.OneCohomology.CentralCoverOriginalAction
