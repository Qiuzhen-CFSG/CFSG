module
public import Theory.Representation.NormalElementaryQuotient
public import Theory.Representation.BinaryConjugationSection.Coinvariants

/-!
# Full movement in an elementary centralizer quotient

If an internal elementary module is generated by its commutators with K,
its literal quotient action has zero coinvariants under the image of K.
The proof uses identity conjugation coordinates and preserves the original
quotient map. This transfers the orbit-module commutator in source10.2.9
to the moved section used by B.5.1 (Aschbacher–Smith, printed p.751).
-/

@[expose] public noncomputable section
open Subgroup
open scoped IsMulCommutative
namespace Representation.NormalElementaryQuotient
variable {G H : Type*} [Group G] [Group H]
  (W : Subgroup G) [W.Normal] [IsElementaryAbelian 2 W]
  (q : G →* H) (hq : Function.Surjective q)
  (hker : q.ker = centralizer (W : Set G))

/-- Full commutator generation survives in the actual quotient action. -/
theorem coinvariants_image_eq_top (K : Subgroup G) (hWK : W ≤ K)
    (hmoved : ⁅W,K⁆ = W) :
    Coinvariants.ker ((representation W q hq hker).comp (K.map q).subtype) = ⊤ := by
  let ρ := (representation W q hq hker).comp (K.map q).subtype
  let r := q.subgroupMap K
  let c : BinaryConjugationSection K W ⊥ (ρ.comp r) := {
    section_le := hWK
    kernel_le := bot_le
    normalized := fun _ _ => by rw [normalizer_eq_top]; trivial
    coordinates := {
      toFun w := Multiplicative.ofAdd (Additive.ofMul w)
      map_one' := rfl
      map_mul' _ _ := rfl }
    onto := fun w => ⟨w.toAdd.toMul,rfl⟩
    kernel_eq := by
      ext w
      change w = 1 ↔ (w : G) = 1
      exact ⟨fun h => congrArg Subtype.val h,fun h => Subtype.ext h⟩
    equivariant := by
      intro k w
      apply Additive.toMul.injective
      apply Subtype.ext
      exact (representation_apply W q hq hker k (Additive.ofMul w)).symm }
  apply c.coinvariants_eq_top_of_group_generation K le_rfl ρ r (fun _ _ => rfl)
  rw [sup_bot_eq,commutator_comm,hmoved]
end Representation.NormalElementaryQuotient
