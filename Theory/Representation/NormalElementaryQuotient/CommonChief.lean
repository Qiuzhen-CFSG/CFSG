/-!
# A common chief section for two commuting residual actions

If two normal p-perfect subgroups commute on a normal p-subgroup, the
three-subgroups lemma interchanges their successive commutators. Coprime
commutator idempotence then makes the double moved subgroup generated by
commutators with each factor.

For a nonzero normal elementary binary subgroup with this generation
property, choose a maximal proper invariant subspace. Neither factor can
centralize its quotient, since that would put the whole moved subgroup in
the denominator. The section uses the original centralizer-quotient action,
restricted to any overgroup of the two factor images. Thus it also applies
to the smaller actor group in the source, without assuming semisimplicity
of the whole module or faithfulness on arbitrary chief factors.

Source application: Aschbacher--Smith 13.1.9, printed pp.870--871, the choice
of the common H₁-chief section W. The Chapter 13 consumer supplies the
literal double movement and discharges the residual-action hypotheses.
-/

public noncomputable section
open Subgroup
namespace Subgroup
variable {G : Type*} [Group G]

/-- Interchange two successive commutators when the actors commute on D. -/
theorem double_commutator_exchange (D A B : Subgroup G) [D.Normal] [A.Normal] [B.Normal]
    (hc : ⁅A,B⁆ ≤ centralizer (D : Set G)) : ⁅⁅D,A⁆,B⁆ = ⁅⁅D,B⁆,A⁆ := by
  have hz : ⁅⁅A,B⁆,D⁆ = ⊥ := commutator_eq_bot_iff_le_centralizer.mpr hc
  apply le_antisymm
  · apply commutator_commutator_le_of_rotate
    · rw [hz]; exact bot_le
    · rw [commutator_comm B D]
  · apply commutator_commutator_le_of_rotate
    · rw [commutator_comm B A,hz]; exact bot_le
    · rw [commutator_comm A D]

/-- Each residual actor generates the same double moved subgroup. -/
theorem double_commutator_idempotent [Finite G] {p : ℕ} [Fact p.Prime]
    (D A B : Subgroup G) [D.Normal] [A.Normal] [B.Normal]
    (hD : IsPGroup p D) (hA : IsPPerfect p A) (hB : IsPPerfect p B)
    (hc : ⁅A,B⁆ ≤ centralizer (D : Set G)) :
    ⁅⁅⁅D,A⁆,B⁆,A⁆ = ⁅⁅D,A⁆,B⁆ ∧ ⁅⁅⁅D,A⁆,B⁆,B⁆ = ⁅⁅D,A⁆,B⁆ := by
  constructor
  · rw [double_commutator_exchange D A B hc]
    exact commutator_isPPerfect_idempotent A ⁅D,B⁆ hA
      (hD.to_le (commutator_le_left D B)) le_normalizer_of_normal
  · exact commutator_isPPerfect_idempotent B ⁅D,A⁆ hB
      (hD.to_le (commutator_le_left D A)) le_normalizer_of_normal
end Subgroup

open scoped IsMulCommutative commutatorElement
open Representation Representation.BinaryOffender
namespace Representation.NormalElementaryQuotient
variable {G H : Type*} [Group G] [Group H]
  (D : Subgroup G) [D.Normal] [IsElementaryAbelian 2 D]
  (q : G →* H) (hq : Function.Surjective q)
  (hker : q.ker = centralizer (D : Set G)) (E : Subgroup H)

/-- A normal subgroup, in the original quotient representation restricted to E. -/
@[expose] def invariantSubrepresentation (C : Subgroup G) [C.Normal] :
    Subrepresentation ((representation D q hq hker).comp E.subtype) where
  toSubmodule := subspace D (C.subgroupOf D)
  apply_mem_toSubmodule g v hv := by
    obtain ⟨x,hx⟩ := hq g.val
    change ((representation D q hq hker g.val v).toMul : G) ∈ C
    rw [←hx,representation_apply]
    exact (inferInstance : C.Normal).conj_mem _ hv x

private theorem section_kernel_forces_eq (C A : Subgroup G) [C.Normal]
    (hCD : C ≤ D) (hC : ⁅C,A⁆ = C) (hAE : A.map q ≤ E)
    (N : Subrepresentation ((representation D q hq hker).comp E.subtype))
    (hN : N ≤ invariantSubrepresentation D q hq hker E C)
    (hk : (A.map q).subgroupOf E ≤ (sectionRepresentation ((representation D q hq hker).comp E.subtype)
      N (invariantSubrepresentation D q hq hker E C)).ker) :
    N = invariantSubrepresentation D q hq hker E C := by
  let S : Subgroup G := N.toSubmodule.toAddSubgroup.toSubgroup'.map D.subtype
  have hc : ⁅C,A⁆ ≤ S := by
    apply commutator_le.mpr
    intro c hc a ha
    let v : D := ⟨c,hCD hc⟩
    have he : ∀ s, sectionRepresentation ((representation D q hq hker).comp E.subtype) N
        (invariantSubrepresentation D q hq hker E C) ⟨q a,hAE (mem_map_of_mem q ha)⟩ s = s :=
      fun s => DFunLike.congr_fun (hk (mem_map_of_mem q ha)) s
    have hv := (sectionRepresentation_trivial_iff _ _ _ _).mp he
      (Additive.ofMul v) hc
    change representation D q hq hker (q a) (Additive.ofMul v) - Additive.ofMul v ∈ N.toSubmodule at hv
    have hm : Additive.ofMul (⟨⁅c,a⁆,(commutator_le_left D ⊤)
        (commutator_mem_commutator v.property (mem_top a))⟩ : D) ∈ N.toSubmodule := by
      rw [vector_commutator D q hq hker v a]
      simpa only [neg_sub] using N.toSubmodule.neg_mem hv
    exact ⟨_,hm,rfl⟩
  rw [hC] at hc
  apply le_antisymm hN
  intro v hv
  obtain ⟨c,hc,he⟩ := hc hv
  have he' : c = v.toMul := Subtype.ext he
  change Additive.ofMul c ∈ N.toSubmodule at hc
  change v ∈ N.toSubmodule
  simpa only [he',ofMul_toMul] using hc

/-- Construct an irreducible invariant section on which both factor images act nontrivially. -/
theorem exists_common_chief_section [Finite G]
    (C A B : Subgroup G) [C.Normal] (hCD : C ≤ D) (hne : C ≠ ⊥)
    (hA : ⁅C,A⁆ = C) (hB : ⁅C,B⁆ = C)
    (hAE : A.map q ≤ E) (hBE : B.map q ≤ E) :
    ∃ N : Subrepresentation ((representation D q hq hker).comp E.subtype),
      N ≤ invariantSubrepresentation D q hq hker E C ∧
      IsIrreducible (sectionRepresentation ((representation D q hq hker).comp E.subtype) N
        (invariantSubrepresentation D q hq hker E C)) ∧
      ¬ (A.map q).subgroupOf E ≤ (sectionRepresentation ((representation D q hq hker).comp E.subtype) N
        (invariantSubrepresentation D q hq hker E C)).ker ∧
      ¬ (B.map q).subgroupOf E ≤ (sectionRepresentation ((representation D q hq hker).comp E.subtype) N
        (invariantSubrepresentation D q hq hker E C)).ker := by
  let ρ := (representation D q hq hker).comp E.subtype
  let W := invariantSubrepresentation D q hq hker E C
  have hW : W.toSubmodule ≠ ⊥ := by
    intro he
    apply hne
    apply bot_unique
    intro c hc
    have hv : Additive.ofMul (⟨c,hCD hc⟩ : D) ∈ W.toSubmodule := hc
    rw [he,Submodule.mem_bot] at hv
    exact mem_bot.mpr (congrArg (fun v : Additive D => (v.toMul : G)) hv)
  let : Nontrivial W := Submodule.nontrivial_iff_ne_bot.mpr hW
  let : IsCoatomic (Subrepresentation W.toRepresentation) :=
    SimpleHeadQuotient.subrepresentation_coatomic W.toRepresentation
  obtain ⟨P,hP⟩ := IsCoatomic.exists_coatom (Subrepresentation W.toRepresentation)
  let N : Subrepresentation ρ := {
    toSubmodule := P.toSubmodule.map W.toSubmodule.subtype
    apply_mem_toSubmodule g v hv := by
      obtain ⟨u,hu,rfl⟩ := hv
      exact ⟨W.toRepresentation g u,P.apply_mem_toSubmodule g hu,rfl⟩ }
  have hNW : N ≤ W := Submodule.map_subtype_le _ _
  have hNP : sectionLower ρ N W = P := by
    apply Subrepresentation.toSubmodule_injective
    exact Submodule.comap_map_eq_of_injective W.toSubmodule.injective_subtype _
  have hNne : N ≠ W := by
    intro he
    apply hP.1
    rw [← hNP,he]
    apply Subrepresentation.toSubmodule_injective
    exact Submodule.comap_subtype_self W.toSubmodule
  refine ⟨N,hNW,?_,?_,?_⟩
  · change IsIrreducible (sectionLower ρ N W).quotientRepresentation
    rw [hNP]
    exact SimpleHeadQuotient.irreducible_quotient_of_isCoatom P hP
  · exact fun hk => hNne (section_kernel_forces_eq D q hq hker E C A hCD hA hAE N hNW hk)
  · exact fun hk => hNne (section_kernel_forces_eq D q hq hker E C B hCD hB hBE N hNW hk)
end Representation.NormalElementaryQuotient

namespace Representation.CommonChief
variable {Q V : Type*} [Group Q] [AddCommGroup V] [Module (ZMod 2) V]
/-- The exact acting subgroup generated by the two factors and the chosen actor. -/
@[expose] def actorGroup (S K A : Subgroup Q) : Subgroup Q := S ⊔ (K ⊔ A)
/-- A literal common irreducible section, inside a prescribed moved subspace. -/
structure Data (ρ : Representation (ZMod 2) Q V) (S K A : Subgroup Q)
    (support : Submodule (ZMod 2) V) where
  lower : Subrepresentation (ρ.comp (actorGroup S K A).subtype)
  upper : Subrepresentation (ρ.comp (actorGroup S K A).subtype)
  lower_le_upper : lower ≤ upper
  upper_le_support : upper.toSubmodule ≤ support
  irreducible : IsIrreducible (sectionRepresentation (ρ.comp (actorGroup S K A).subtype) lower upper)
  first_moves : ¬ S.subgroupOf (actorGroup S K A) ≤
    (sectionRepresentation (ρ.comp (actorGroup S K A).subtype) lower upper).ker
  second_moves : ¬ K.subgroupOf (actorGroup S K A) ≤
    (sectionRepresentation (ρ.comp (actorGroup S K A).subtype) lower upper).ker

/-- The same section as input to the actor rank-loss theorem. -/
@[expose] def Data.movedSection {ρ : Representation (ZMod 2) Q V} {S K A : Subgroup Q}
    {support : Submodule (ZMod 2) V} (d : Data ρ S K A support) :
    RepeatedSectionBudget.MovedSection ρ K A where
  overgroup := actorGroup S K A
  factor_le := le_sup_left.trans le_sup_right
  actor_le := le_sup_right.trans le_sup_right
  lower := d.lower
  upper := d.upper
  lower_le_upper := d.lower_le_upper
  moves := d.second_moves
/-- Construct the common chief section inside the nonzero double commutator. -/
theorem exists_of_double_movement {G Q : Type*} [Group G] [Finite G] [Group Q]
    (D : Subgroup G) [D.Normal] [IsElementaryAbelian 2 D]
    (q : G →* Q) (hq : Function.Surjective q)
    (hker : q.ker = centralizer (D : Set G))
    (S K : Subgroup G) [S.Normal] [K.Normal] (A : Subgroup Q)
    (hpS : IsPPerfect 2 S) (hpK : IsPPerfect 2 K)
    (hc : ⁅S,K⁆ ≤ centralizer (D : Set G)) (hm : ⁅⁅D,S⁆,K⁆ ≠ ⊥) :
    Nonempty (Data (NormalElementaryQuotient.representation D q hq hker)
      (S.map q) (K.map q) A
      (NormalElementaryQuotient.subspace D ((⁅⁅D,S⁆,K⁆).subgroupOf D))) := by
  let U := ⁅⁅D,S⁆,K⁆
  let B := actorGroup (S.map q) (K.map q) A
  have hUD : U ≤ D := (commutator_le_left ⁅D,S⁆ K).trans (commutator_le_left D S)
  have hid := double_commutator_idempotent D S K
    (IsElementaryAbelian.isPGroup 2 D) hpS hpK hc
  obtain ⟨N,hNW,hI,hS,hK⟩ := NormalElementaryQuotient.exists_common_chief_section D q
    hq hker B U S K hUD hm hid.1 hid.2 le_sup_left (le_sup_left.trans le_sup_right)
  exact ⟨⟨N,_,hNW,le_rfl,hI,hS,hK⟩⟩

/-- Transport the construction from an ambient group to a specified local overgroup. -/
theorem exists_of_ambient_double_movement {G Q : Type*}
    [Group G] [Finite G] [Group Q] (E D S K : Subgroup G)
    [(D.subgroupOf E).Normal] [IsElementaryAbelian 2 (D.subgroupOf E)]
    (q : E →* Q) (hq : Function.Surjective q)
    (hker : q.ker = centralizer (D.subgroupOf E : Set E)) (A : Subgroup Q)
    (hDE : D ≤ E) (hSE : S ≤ E) (hKE : K ≤ E)
    (hSN : E ≤ normalizer (S : Set G)) (hKN : E ≤ normalizer (K : Set G))
    (hpS : IsPPerfect 2 S) (hpK : IsPPerfect 2 K)
    (hc : ⁅S,K⁆ ≤ centralizer (D : Set G)) (hm : ⁅⁅D,S⁆,K⁆ ≠ ⊥) :
    Nonempty (Data (NormalElementaryQuotient.representation (D.subgroupOf E) q hq hker)
      ((S.subgroupOf E).map q) ((K.subgroupOf E).map q) A
      (NormalElementaryQuotient.subspace (D.subgroupOf E)
        ((⁅⁅D.subgroupOf E,S.subgroupOf E⁆,K.subgroupOf E⁆).subgroupOf (D.subgroupOf E)))) := by
  let D₀ := D.subgroupOf E
  let S₀ := S.subgroupOf E
  let K₀ := K.subgroupOf E
  let U := ⁅⁅D₀,S₀⁆,K₀⁆
  let : S₀.Normal := normal_subgroupOf_of_le_normalizer hSN
  let : K₀.Normal := normal_subgroupOf_of_le_normalizer hKN
  have hmapD : D₀.map E.subtype = D := map_subgroupOf_eq_of_le hDE
  have hmapS : S₀.map E.subtype = S := map_subgroupOf_eq_of_le hSE
  have hmapK : K₀.map E.subtype = K := map_subgroupOf_eq_of_le hKE
  have hmapU : U.map E.subtype = ⁅⁅D,S⁆,K⁆ := by
    rw [map_commutator,map_commutator,hmapD,hmapS,hmapK]
  have hUne : U ≠ ⊥ := by
    intro he
    apply hm
    rw [←hmapU,he,Subgroup.map_bot]
  have hS : IsPPerfect 2 S₀ := hpS.of_surjective
    (subgroupOfEquivOfLe hSE).symm.toMonoidHom (subgroupOfEquivOfLe hSE).symm.surjective
  have hK : IsPPerfect 2 K₀ := hpK.of_surjective
    (subgroupOfEquivOfLe hKE).symm.toMonoidHom (subgroupOfEquivOfLe hKE).symm.surjective
  have hc₀ : ⁅S₀,K₀⁆ ≤ centralizer (D₀ : Set E) := by
    intro x hx d hd
    have hx' := mem_map_of_mem E.subtype hx
    rw [map_commutator,hmapS,hmapK] at hx'
    exact Subtype.ext (hc hx' d hd)
  exact exists_of_double_movement D₀ q hq hker S₀ K₀ A hS hK hc₀ hUne

end Representation.CommonChief

namespace Representation.CommonChief
variable {Q V : Type*} [Group Q] [AddCommGroup V] [Module (ZMod 2) V]
/-- The nontrivial first-factor action is faithful when that factor is simple. -/
theorem Data.first_faithful {ρ : Representation (ZMod 2) Q V} {S K A : Subgroup Q}
    [IsSimpleGroup S] {support : Submodule (ZMod 2) V} (d : Data ρ S K A support) :
    Function.Injective ((sectionRepresentation (ρ.comp (actorGroup S K A).subtype)
      d.lower d.upper).comp (inclusion (show S ≤ actorGroup S K A from le_sup_left))) := by
  let σ := sectionRepresentation (ρ.comp (actorGroup S K A).subtype) d.lower d.upper
  let f := σ.comp (inclusion (show S ≤ actorGroup S K A from le_sup_left))
  apply (MonoidHom.ker_eq_bot_iff f).mp
  rcases f.normal_ker.eq_bot_or_eq_top with hz | ht
  · exact hz
  · exfalso
    apply d.first_moves
    intro s hs
    exact (show (⟨s.val,hs⟩ : S) ∈ f.ker from ht.symm ▸ mem_top _)
end Representation.CommonChief
