module

public import Theory.Representation.AlternatingSevenBinaryLargeModels.Twenty.Model
public import Theory.Representation.AlternatingSevenBinaryLargeModels.Twenty.Certificate
public import Theory.Representation.AbsolutelyIrreducible
public import Mathlib.Algebra.Field.ZMod

/-!
# Absolute irreducibility of the binary twenty-space

The rank-one certificate supplies every matrix unit in the algebra generated by
two actual even permutations. Thus the action generates all endomorphisms, and
scalar extension preserves this density. The resulting representation is
absolutely irreducible, independently of any representation catalogue.

Source: the twenty-dimensional candidate in the spectrum argument for
Aschbacher–Smith K.1.2, printed p.452/PDF p.463.
-/

public section

open Matrix Thompson.BinaryMatrix
namespace Representation.AlternatingSevenBinaryLargeModels.Twenty
namespace Certificate

private theorem decode_stored (k : Fin 145) :
    decode 20 storedRows[k.val]! = mat k.val := by
  ext i j
  change bit (storedRows[k.val]!)[i.val]! j.val = bit data[k.val]! (20 * i.val + j.val)
  rw [flatten_checked k i]
  unfold bit
  rw [Nat.testBit_mod_two_pow _ 20 j.val, Nat.testBit_shiftRight]
  simp only [j.isLt, decide_true, Bool.true_and]

private theorem mul_checked {a b c : ℕ} (ha : a < 145) (hb : b < 145) (hc : c < 145)
    (h : ∀ i : Fin 20,
      rowProduct (storedRows[a]!)[i.val]! storedRows[b]! 20 = (storedRows[c]!)[i.val]!) :
    mat a * mat b = mat c := by
  rw [← decode_stored ⟨a, ha⟩, ← decode_stored ⟨b, hb⟩, ← decode_stored ⟨c, hc⟩]
  exact decode_mul 20 _ _ _ h

private theorem linearCombination_mem
    (A : Subalgebra (ZMod 2) (Matrix (Fin 20) (Fin 20) (ZMod 2)))
    (a : Array ℕ) (c d x : ℕ) (h : rowProduct c a d = x)
    (hm : ∀ k : Fin d, packedMatrix a[k.val]! ∈ A) : packedMatrix x ∈ A := by
  have he : packedMatrix x =
      ∑ k : Fin d, bit c k.val • packedMatrix a[k.val]! := by
    ext i j
    simp only [Matrix.sum_apply, Matrix.smul_apply, smul_eq_mul, packedMatrix]
    rw [← h, bit_rowProduct, ← Fin.sum_univ_eq_sum_range]
  rw [he]
  exact A.sum_mem fun k _ => A.smul_mem (hm k) _

private theorem first_data : mat 1 = firstMatrix := by
  exact firstMatrix_checked

private theorem second_data : mat 2 = secondMatrix := by
  exact secondMatrix_checked

/-- The two action matrices generate every matrix unit. -/
theorem matrix_algebra_eq_top
    (A : Subalgebra (ZMod 2) (Matrix (Fin 20) (Fin 20) (ZMod 2)))
    (ha : firstMatrix ∈ A) (hb : secondMatrix ∈ A) : A = ⊤ := by
  have hg (b : Bool) : mat (genIndex b) ∈ A := by
    cases b
    · exact first_data.symm ▸ ha
    · exact second_data.symm ▸ hb
  have hm (k : ℕ) : k < 54 → mat k ∈ A := by
    induction k using Nat.strong_induction_on with
    | h k ih =>
      intro hk
      by_cases hz : k = 0
      · subst k
        rw [identity_checked]
        exact A.one_mem
      let j : Fin 53 := ⟨k - 1, by omega⟩
      have hj : j.val + 1 = k := by dsimp [j]; omega
      have hp := parents_checked j
      rw [hj] at hp
      have he := mul_checked (a := genIndex choices[k]!) (b := parents[k]!) (c := k)
        (by cases choices[k]! <;> decide) (by omega) (by omega) (by
          intro i
          simpa only [hj] using words_checked j i)
      rw [← he]
      exact A.mul_mem (hg _) (ih _ hp (by omega))
  have hp (k : ℕ) : k < 7 → mat (54 + k) ∈ A := by
    induction k with
    | zero =>
      intro _
      change packedMatrix data[54]! ∈ A
      rw [power_zero_checked]
      exact hm 0 (by decide)
    | succ k ih =>
      intro hk
      have he := mul_checked (a := 2) (b := 54 + k) (c := 54 + (k + 1))
        (by decide) (by omega) (by omega) (powers_checked ⟨k, by omega⟩)
      rw [← he]
      exact A.mul_mem (hm 2 (by decide)) (ih (by omega))
  have hP : mat 61 ∈ A := by
    apply linearCombination_mem A (data.extract 54 61) 127 7 _ projector_checked
    intro k
    rw [power_extract k]
    exact hp k.val k.isLt
  have hmid : mat 62 ∈ A := by
    have he : mat 62 = mat 1 + mat 14 := by
      ext i j
      change bit data[62]! (20 * i.val + j.val) = _
      rw [← middle_checked, bit_xor]
      rfl
    rw [he]
    exact A.add_mem (hm 1 (by decide)) (hm 14 (by decide))
  have hPR : mat 63 ∈ A := by
    rw [← mul_checked (by decide) (by decide) (by decide) first_product_checked]
    exact A.mul_mem hP hmid
  have hR : mat 64 ∈ A := by
    rw [← mul_checked (by decide) (by decide) (by decide) rank_product_checked]
    exact A.mul_mem hPR hP
  have hl (k : Fin 20) : mat (65 + k.val) ∈ A := by
    have hk := leftWords_checked k
    rw [← mul_checked (by omega) (by decide) (by omega) (left_products_checked k)]
    exact A.mul_mem (hm _ hk) hR
  have hr (k : Fin 20) : mat (85 + k.val) ∈ A := by
    have hk := rightWords_checked k
    rw [← mul_checked (by decide) (by omega) (by omega) (right_products_checked k)]
    exact A.mul_mem hR (hm _ hk)
  have hc (i : Fin 20) : vecMulVec (Pi.single i 1) v ∈ A := by
    rw [← columns_checked i]
    apply linearCombination_mem A (data.extract 65 85) leftCoefficients[i.val]! 20 _
      (left_inverse_checked i)
    intro k
    rw [left_extract k]
    exact hl k
  have hd (j : Fin 20) : vecMulVec u (Pi.single j 1) ∈ A := by
    rw [← rows_checked j]
    apply linearCombination_mem A (data.extract 85 105) rightCoefficients[j.val]! 20 _
      (right_inverse_checked j)
    intro k
    rw [right_extract k]
    exact hr k
  have units (i j : Fin 20) : Matrix.single i j (1 : ZMod 2) ∈ A := by
    have he : vecMulVec (Pi.single i 1) v * vecMulVec u (Pi.single j 1) =
        Matrix.single i j 1 := by
      rw [Matrix.vecMulVec_mul_vecMulVec, pairing_checked, one_smul]
      ext x y
      by_cases hi : i = x <;> by_cases hj : j = y <;>
        simp [vecMulVec_apply, hi, hj, eq_comm]
    rw [← he]
    exact A.mul_mem (hc i) (hd j)
  apply top_unique
  intro M _
  rw [show M = ∑ i, ∑ j, M i j • Matrix.single i j 1 by
    simpa using Matrix.matrix_eq_sum_single M]
  exact A.sum_mem fun i _ => A.sum_mem fun j _ => A.smul_mem (units i j) _

end Certificate

/-- The twenty-space generates its full endomorphism algebra. -/
theorem density : Algebra.adjoin (ZMod 2) (Set.range representation) = ⊤ := by
  let P := Algebra.adjoin (ZMod 2) (Set.range representation)
  let e : Module.End (ZMod 2) Vector ≃ₐ[ZMod 2] Matrix (Fin 20) (Fin 20) (ZMod 2) :=
    LinearMap.toMatrixAlgEquiv'
  let Q := P.map e.toAlgHom
  have ha : firstMatrix ∈ Q := by
    rw [← matrix_threeCycle]
    exact ⟨representation threeCycle, Algebra.subset_adjoin (Set.mem_range_self _), rfl⟩
  have hb : secondMatrix ∈ Q := by
    rw [← matrix_sevenCycle]
    exact ⟨representation sevenCycle, Algebra.subset_adjoin (Set.mem_range_self _), rfl⟩
  have hQ := Certificate.matrix_algebra_eq_top Q ha hb
  apply top_unique
  intro f _
  have hf : e f ∈ Q := by rw [hQ]; trivial
  obtain ⟨f', hf', he⟩ := hf
  exact e.injective he ▸ hf'

/-- An actual absolutely irreducible twenty-dimensional binary A₇ representation. -/
theorem absolutelyIrreducible : IsAbsolutelyIrreducible
    (F := ZMod 2) (G := alternatingGroup (Fin 7)) (V := Fin 20 → ZMod 2)
    representation := by
  refine ⟨?_⟩
  apply irreducible_of_jacobson_density_surjective
  exact (extendScalars_surj_iff (AlgebraicClosure (ZMod 2)) representation).mp density

end Representation.AlternatingSevenBinaryLargeModels.Twenty
