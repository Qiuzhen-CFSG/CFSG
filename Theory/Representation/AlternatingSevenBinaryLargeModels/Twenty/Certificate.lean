  · have he : 58 + (k.val - 58) = k.val := by omega
    simpa only [he] using flatten_2 ⟨k.val - 58, by omega⟩ i
  by_cases h3 : k.val < 116
  · have he : 87 + (k.val - 87) = k.val := by omega
    simpa only [he] using flatten_3 ⟨k.val - 87, by omega⟩ i
  have he : 116 + (k.val - 116) = k.val := by omega
  simpa only [he] using flatten_4 ⟨k.val - 116, by omega⟩ i

