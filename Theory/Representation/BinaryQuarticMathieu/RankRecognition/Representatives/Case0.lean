theorem checked (n : Word) : ValidCertificate 0 n (witness n) := by
  have hn : n = (⟨(n.val / 32) * 32 + n.val % 32, by omega⟩ : Word) := by
    apply Fin.ext
    change n.val = (n.val / 32) * 32 + n.val % 32
    omega
  have hb : n.val / 32 < 32 := by omega
  let b : Fin 32 := ⟨n.val / 32, hb⟩
  let k : Fin 32 := ⟨n.val % 32, Nat.mod_lt _ (by decide)⟩
  have h : ∀ b : Fin 32, ∀ k : Fin 32,
      ValidCertificate 0 (⟨b.val * 32 + k.val, by omega⟩ : Word)
        (witness ⟨b.val * 32 + k.val, by omega⟩) := by
    intro b
    fin_cases b
    · exact check_0
    · exact check_1
    · exact check_2
    · exact check_3
    · exact check_4
    · exact check_5
    · exact check_6
    · exact check_7
    · exact check_8
    · exact check_9
    · exact check_10
    · exact check_11
    · exact check_12
    · exact check_13
    · exact check_14
    · exact check_15
    · exact check_16
    · exact check_17
    · exact check_18
    · exact check_19
    · exact check_20
    · exact check_21
    · exact check_22
    · exact check_23
    · exact check_24
    · exact check_25
    · exact check_26
    · exact check_27
    · exact check_28
    · exact check_29
    · exact check_30
    · exact check_31
  simpa only [b, k, ← hn] using h b k

theorem ranks (n : Word) :
    contractionRank quartic (decode (representative (0 : Fin 3).succ)) (decode n) =
      (witness n).rank.val := certificate_rank 0 n (witness n) (checked n)

set_option maxRecDepth 4096 in
private theorem counts : ∀ r : Fin 11,
    (Finset.univ.filter (fun n : Word => (witness n).rank.val = r.val)).card =
      profile (0 : Fin 3).succ r.val := by
  decide +kernel

theorem histogram : rankDistribution quartic (decode (representative (0 : Fin 3).succ)) =
    profile (0 : Fin 3).succ := by
  funext r
  rw [rankDistribution_eq_word_count quartic _ (fun n => (witness n).rank.val) ranks]
  by_cases hr : r < 11
  · exact counts ⟨r, hr⟩
  · have hz : (Finset.univ.filter (fun n : Word => (witness n).rank.val = r)) = ∅ := by
      apply Finset.eq_empty_iff_forall_notMem.mpr
      intro n hn
      have he := (Finset.mem_filter.mp hn).2
      have hb := (witness n).rank.isLt
      omega
    rw [hz, Finset.card_empty]
    change 0 = largeDistribution r
    simp [largeDistribution,
      show r ≠ 0 by omega, show r ≠ 4 by omega, show r ≠ 6 by omega, show r ≠ 8 by omega]

