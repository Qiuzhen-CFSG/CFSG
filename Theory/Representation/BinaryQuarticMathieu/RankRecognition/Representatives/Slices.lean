def representativeCoordinate (c : Fin 3) : Fin 10 := ![0, 1, 3] c

def tupleMask (t : Fin 4 → Fin 10) : Nat :=
  (2 ^ (t 0).val ||| 2 ^ (t 1).val) ||| (2 ^ (t 2).val ||| 2 ^ (t 3).val)

def tupleIndex (t : Fin 4 → Fin 10) : Fin 210 :=
  (quadrupleIndexRows[tupleMask t / 32]!).getD (tupleMask t % 32) 0

def tuplePermutation (t : Fin 4 → Fin 10) (i : Fin 4) : Fin 4 :=
  Fin.ofNat 4 (Finset.univ.filter (fun j => t j < t i)).card

def sliceTuple (c : Fin 3) (k i j : Fin 10) : Fin 4 → Fin 10 :=
  ![representativeCoordinate c, k, i, j]

def SliceCheck (c : Fin 3) (k i j : Fin 10) : Prop :=
  let t := sliceTuple c k i j
  if Function.Injective t then
    Function.Injective (tuplePermutation t) ∧
    (∀ a, t a = quadruple (tupleIndex t) (tuplePermutation t a)) ∧
    (if coefficientWord.testBit (tupleIndex t).val then (1 : F) else 0) =
      vector (sliceRows c k j) i
  else vector (sliceRows c k j) i = 0

instance (c : Fin 3) (k i j : Fin 10) : Decidable (SliceCheck c k i j) :=
  inferInstanceAs (Decidable (if Function.Injective (sliceTuple c k i j) then _ else _))

set_option maxRecDepth 4096 in
private theorem slice_check_0 : ∀ k i j : Fin 10, SliceCheck 0 k i j := by
  decide +kernel

set_option maxRecDepth 4096 in
private theorem slice_check_1 : ∀ k i j : Fin 10, SliceCheck 1 k i j := by
  decide +kernel

set_option maxRecDepth 4096 in
private theorem slice_check_2 : ∀ k i j : Fin 10, SliceCheck 2 k i j := by
  decide +kernel

theorem slice_check (c : Fin 3) (k i j : Fin 10) : SliceCheck c k i j := by
  fin_cases c
  · exact slice_check_0 k i j
  · exact slice_check_1 k i j
  · exact slice_check_2 k i j

theorem slice_value (c : Fin 3) (k i j : Fin 10) :
    quartic ![basisVector (representativeCoordinate c), basisVector k, basisVector i, basisVector j] =
      vector (sliceRows c k j) i := by
  let t := sliceTuple c k i j
  have he : ![basisVector (representativeCoordinate c), basisVector k, basisVector i, basisVector j] =
      (fun a => basisVector (t a)) := by
    ext a b
    fin_cases a <;> rfl
  rw [he]
  have hc := slice_check c k i j
  change (if Function.Injective t then _ else _) at hc
  by_cases ht : Function.Injective t
  · rw [if_pos ht] at hc
    exact (basis_permutation t (tupleIndex t) (tuplePermutation t) hc.1 hc.2.1).trans hc.2.2
  · rw [if_neg ht] at hc
    rw [hc]
    apply quartic.map_eq_zero_of_not_injective
    exact fun hh => ht (fun a b hab => hh (congrArg basisVector hab))

theorem representative_coordinate : ∀ c : Fin 3,
    decode (representative c.succ) = basisVector (representativeCoordinate c) := by
  decide +kernel

