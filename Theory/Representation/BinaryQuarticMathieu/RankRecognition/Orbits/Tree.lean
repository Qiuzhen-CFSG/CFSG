def treeRow (n : Word) : TreeRow :=
  (treeRows[n.val / 32]!).getD (n.val % 32) default

def treeGenerator (n : Word) : U ≃ₗ[F] U :=
  if (treeRow n).useB then generatorB else generatorA

set_option maxRecDepth 4096 in
theorem tree_labels : ∀ n : Word,
    (treeRow n).root = representative (wordClass n) := by
  decide +kernel

set_option maxRecDepth 4096 in
theorem tree_depth_bound : ∀ n : Word, (treeRow n).depth ≤ 20 := by
  decide +kernel

set_option maxRecDepth 4096 in
theorem tree_roots : ∀ n : Word,
    (treeRow n).depth = 0 → n = (treeRow n).root := by
  decide +kernel

set_option maxRecDepth 4096 in
theorem tree_descent : ∀ n : Word, (treeRow n).depth ≠ 0 →
    (treeRow (treeRow n).parent).depth < (treeRow n).depth ∧
      wordClass (treeRow n).parent = wordClass n := by
  decide +kernel

set_option maxRecDepth 4096 in
private theorem tree_packed_edges : ∀ n : Word, (treeRow n).depth ≠ 0 →
    packedAction (if (treeRow n).useB then columnsB else columnsA)
      (treeRow n).parent.val = n.val := by
  decide +kernel

/-- Every certified packed edge is an edge for the actual invertible map. -/
theorem tree_edges (n : Word) (hn : (treeRow n).depth ≠ 0) :
    treeGenerator n (decode (treeRow n).parent) = decode n := by
  have h := congrArg vector (tree_packed_edges n hn)
  rw [vector_packedAction] at h
  cases he : (treeRow n).useB <;>
    simpa only [treeGenerator, he, Bool.false_eq_true, if_false, if_true,
      generatorA, generatorB, LinearEquiv.coe_ofLinearMap, decode] using h

end BinaryQuarticMathieu.RankRecognition.Orbits
