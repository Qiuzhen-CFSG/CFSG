module

public import Theory.Representation.G2OrthogonalCover.Universal
public import Theory.Representation.FirstCohomologyG2Natural.Commutant
public import Theory.Representation.CentralCoverOriginalAction.Equivariance

/-!
# Natural G₂ cohomology, commutants and central extensions

The binary and nonbinary cocycle calculations give H¹ dimension equal to the
field degree for the natural module of the actual derived group. We transport
this dimension and the additive scalar commutant through genuine group and
module isomorphisms.

Every central natural extension generated by the derived group is a quotient
of the trace-zero octonion seven-space. Centrality and derived generation
extend equivariance of this quotient to full G₂. Rank then gives the bound 7n,
and equality gives an isomorphism over the specified natural projection.
No field-module structure is imposed on an arbitrary central kernel.

Source: Aschbacher--Smith, combined manuscript of 1 March 2004, I.1.5--6,
printed p.408; I.2.3, printed p.413; and B.4.6(1), printed p.88. The imported
split-octonion model and cocycle calculations retain the ATLAS attribution
in LICENSES/ATLAS.txt. No additional ATLAS source is copied here.
-/

@[expose] public section

noncomputable section
open Representation Representation.OneCohomology
namespace Atlas.G2.Natural.Extensions
variable {F : Type*} [Field F] [CharP F 2] [Finite F] [Algebra (ZMod 2) F]
variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]

/-- I.1.6(5) for any actual identification with the natural derived G₂ module.
Both field sizes are included; the output is dimension over the prime field. -/
theorem cohomology_dimension {H N : Type*} [Group H]
    [AddCommGroup N] [Module (ZMod 2) N]
    (ν : Representation (ZMod 2) H N)
    (eH : H ≃* commutator (Model F)) (eN : N ≃ₗ[ZMod 2] Space F)
    (he : ∀ h v, eN (ν h v) = derivedAction F (eH h) (eN v))
    (n : ℕ) (hcard : Nat.card F = 2 ^ n) :
    Module.finrank (ZMod 2) (H1 ν) = n := by
  let e := H1Congr ν (OrthogonalCover.binaryNatural F) eH eN he
  rw [e.finrank_eq]
  change Module.finrank (ZMod 2) (H1 (restrictScalars (k := ZMod 2) (derivedAction F))) = n
  rw [finrank_restrictScalars, OrthogonalCover.natural_H1_finrank, mul_one,
    coefficient_finrank_of_card 2 n hcard]

omit [Finite F] in
/-- The binary commutant of an identified natural derived module consists
exactly of the transported field scalars, with unique scalar coefficient. -/
theorem scalar_commutant {H N : Type*} [Group H]
    [AddCommGroup N] [Module (ZMod 2) N]
    (ν : Representation (ZMod 2) H N)
    (eH : H ≃* commutator (Model F)) (eN : N ≃ₗ[ZMod 2] Space F)
    (he : ∀ h v, eN (ν h v) = derivedAction F (eH h) (eN v))
    (f : N →ₗ[ZMod 2] N) :
    (∀ h v, f (ν h v) = ν h (f v)) ↔
      ∃! c : F, ∀ v, eN (f v) = c • eN v := by
  constructor
  · intro hf
    let f' : Space F →+ Space F :=
      eN.toAddEquiv.toAddMonoidHom.comp
        (f.toAddMonoidHom.comp eN.symm.toAddEquiv.toAddMonoidHom)
    have he' (g : commutator (Model F)) (v : Space F) :
        eN.symm (derivedAction F g v) = ν (eH.symm g) (eN.symm v) := by
      apply eN.injective
      simp only [he, LinearEquiv.apply_symm_apply, eH.apply_symm_apply]
    have hf' (g : commutator (Model F)) (v : Space F) :
        f' (derivedAction F g v) = derivedAction F g (f' v) := by
      change eN (f (eN.symm (derivedAction F g v))) =
        derivedAction F g (eN (f (eN.symm v)))
      rw [he', hf, he, eH.apply_symm_apply]
    obtain ⟨c, hc⟩ := exists_scalar_of_additive_commutes_derived f' hf'
    have hc' (v : N) : eN (f v) = c • eN v := by
      have h := hc (eN v)
      change eN (f (eN.symm (eN v))) = c • eN v at h
      simpa only [LinearEquiv.symm_apply_apply] using h
    refine ⟨c, hc', ?_⟩
    intro d hd
    have : Nontrivial (Space F) := Module.nontrivial_of_finrank_pos (by
      rw [finrank_space]; decide)
    obtain ⟨v, hv⟩ := exists_ne (0 : Space F)
    apply smul_left_injective F hv
    simpa only [LinearEquiv.apply_symm_apply] using (hd (eN.symm v)).symm.trans (hc' (eN.symm v))
  · rintro ⟨c, hc, _⟩ h v
    apply eN.injective
    rw [hc, he, he, hc, map_smul]

/-- A central extension generated by G₂′ is a quotient of the trace-zero
Weyl module, over its original natural projection. The quotient map respects
full G₂, including the proper derived subgroup when the field has order two. -/
theorem exists_weyl_quotient [FiniteDimensional (ZMod 2) V]
    (σ : Representation (ZMod 2) (Model F) V)
    (p : V →ₗ[ZMod 2] Space F)
    (hp : Function.Surjective p)
    (hfixed : p.ker ≤ fixed σ)
    (hgen : Coinvariants.ker (σ.comp (commutator (Model F)).subtype) = ⊤)
    (he : ∀ g v, p (σ g v) = action F g (p v)) :
    ∃ f : TraceZero F →ₗ[ZMod 2] V, Function.Surjective f ∧
      (∀ g w, f (traceZeroAction F g w) = σ g (f w)) ∧
      ∀ w, p (f w) = mk F w := by
  let pD : Representation.IntertwiningMap (σ.comp (commutator (Model F)).subtype)
      (OrthogonalCover.binaryNatural F) :=
    p.intertwiningMap_of_isIntertwiningMap _ _ (fun g v => he g.val v)
  have hpD : IsCover pD := ⟨hp, fun _ hw g => hfixed hw g.val, hgen⟩
  obtain ⟨f, hf, hover⟩ := OrthogonalCover.exists_quotient F pD hpD
  let α := restrictScalars (k := ZMod 2) (traceZeroAction F)
  let ν := restrictScalars (k := ZMod 2) (action F)
  let q : α.IntertwiningMap ν :=
    ((mk F).restrictScalars (ZMod 2)).intertwiningMap_of_isIntertwiningMap _ _
      (fun _ _ => rfl)
  let p' : σ.IntertwiningMap ν := p.intertwiningMap_of_isIntertwiningMap _ _ he
  have hα : Coinvariants.ker (α.comp (commutator (Model F)).subtype) = ⊤ :=
    (OrthogonalCover.binaryProjection_isCover F).2.2
  refine ⟨f.toLinearMap, hf, ?_, hover⟩
  exact CentralCoverOriginalAction.equivariant_of_normal_generated
    (commutator (Model F)) α σ ν q p' hα hfixed f.toLinearMap
    (fun h w => LinearMap.congr_fun (f.isIntertwining' h) w) hover

/-- Central natural extensions have dimension at most seven times the field
degree. At equality the original extension is the Weyl module, with full-group
equivariance and compatibility with the specified natural projection. -/
theorem dimension_and_equality [FiniteDimensional (ZMod 2) V]
    (σ : Representation (ZMod 2) (Model F) V)
    (p : V →ₗ[ZMod 2] Space F)
    (hp : Function.Surjective p)
    (hfixed : p.ker ≤ fixed σ)
    (hgen : Coinvariants.ker (σ.comp (commutator (Model F)).subtype) = ⊤)
    (he : ∀ g v, p (σ g v) = action F g (p v))
    (n : ℕ) (hcard : Nat.card F = 2 ^ n) :
    Module.finrank (ZMod 2) V ≤ 7 * n ∧
      (Module.finrank (ZMod 2) V = 7 * n →
        ∃ e : TraceZero F ≃ₗ[ZMod 2] V,
          (∀ g w, e (traceZeroAction F g w) = σ g (e w)) ∧
          ∀ w, p (e w) = mk F w) := by
  obtain ⟨f, hf, heq, hover⟩ := exists_weyl_quotient σ p hp hfixed hgen he
  have hd : Module.finrank (ZMod 2) (TraceZero F) = 7 * n := by
    rw [← Module.finrank_mul_finrank (ZMod 2) F (TraceZero F),
      OrthogonalCover.finrank_traceZero, coefficient_finrank_of_card 2 n hcard, Nat.mul_comm]
  refine ⟨hd ▸ LinearMap.finrank_le_finrank_of_surjective hf, ?_⟩
  intro hv
  have hi : Function.Injective f :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank (hd.trans hv.symm)).mpr hf
  exact ⟨LinearEquiv.ofBijective f ⟨hi, hf⟩, heq, hover⟩
end Atlas.G2.Natural.Extensions
