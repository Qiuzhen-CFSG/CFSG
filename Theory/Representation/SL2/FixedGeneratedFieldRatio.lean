module
public import Theory.Representation.SL2.FixedGeneratedSmallDegree
public import Theory.Representation.QuadraticFourGroup.Recognition.IrreducibleReduction.Section
public import GorensteinWalter.SL2ProjectiveCover

/-!
# Fixed-generated SL2 modules and two field degrees

A nonzero binary SL2(2^n) module with no invariants, generated by a Sylow
fixed space, is irreducible when n>1 and its dimension is less than 4n.
A simple submodule has dimension at least 2n. A nontrivial quotient would
have a nontrivial simple section because SL2 is perfect, forcing another
2n dimensions. Fixed generation then rules out the remaining trivial quotient.

If |V|=2^m 2^n |C_V(S)|, 2m<=n and |C_V(S)|<=2^(m+n), the module has
dimension at most 3n. Its Schur degree s equals the fixed-space dimension
and divides both n and dim V, hence divides m. The minimum-degree bound
2n<=m+n+s, together with s<=m, forces n=2m and s=m.

These are the actual module and field restrictions used in DGS85,
Groups and Graphs (1985), (11.6)--(11.7), pp.172--175.
-/

public noncomputable section
open scoped MatrixGroups MonoidAlgebra
open Representation Representation.BinaryOffender
namespace Representation.SL2

/-- Fixed generation and no invariant vectors force irreducibility below twice the minimum nontrivial binary SL2 degree. -/
theorem irreducible_of_fixed_generated_degree_lt_four
    {F V : Type*} [Field F] [Finite F] [CharP F 2]
    [AddCommGroup V] [Module (ZMod 2) V] [Finite V] [Nontrivial V]
    (ρ : Representation (ZMod 2) SL(2,F) V) (S : Sylow 2 SL(2,F))
    (hgen : RankOne.QuadraticRecognition.GeneratedByFixedSpace ρ S)
    (hfix : ρ.invariants = ⊥) {n : ℕ} (hn : 1 < n)
    (hF : Nat.card F = 2^n) (hd : Module.finrank (ZMod 2) V < 4*n) :
    ρ.IsIrreducible := by
  let : Group.IsPerfect SL(2,F) := GorensteinWalter.sl2_isPerfect_of_card_gt_three F (by
    rw [hF]
    exact lt_of_lt_of_le (by decide : 3 < 2^2) (Nat.pow_le_pow_right (by decide) hn))
  have hfix' : fixedSpace ρ ⊤ = ⊥ := by
    have he : fixedSpace ρ ⊤ = ρ.invariants := by
      ext v
      exact ⟨fun hv g => hv ⟨g,Subgroup.mem_top g⟩,fun hv g => hv g.val⟩
    exact he.trans hfix
  have hmov := RankOne.QuadraticRecognition.moved_eq_top_of_sylow_generation ρ S hgen hfix'
  obtain ⟨A,hA,_⟩ := (eq_bot_or_exists_atom_le (⊤ : Subrepresentation ρ)).resolve_left top_ne_bot
  let : A.toRepresentation.IsIrreducible := (Subrepresentation.irreducible_iff_isAtom A).mpr hA
  have hnA : ∃ g, A.toRepresentation g ≠ 1 := by
    by_contra! hh
    have hb : A = ⊥ := by
      apply Subrepresentation.toSubmodule_injective
      apply bot_unique
      intro v hv
      apply hfix.le
      intro g
      exact congrArg Subtype.val (congrArg (fun f : Module.End (ZMod 2) A.toSubmodule =>
        f ⟨v,hv⟩) (hh g))
    exact hA.ne_bot hb
  have hlo := Unsigned.irreducible_finrank_bound 2 A.toRepresentation hnA n (by omega) hF
  have hquot : Module.finrank (ZMod 2) (V ⧸ A.toSubmodule) < 2*n := by
    have he := Submodule.finrank_quotient_add_finrank A.toSubmodule
    omega
  have ht : ∀ g w, A.quotientRepresentation g w = w := by
    by_contra! hnot
    obtain ⟨g,w,hw⟩ := hnot
    have hne : ¬ (⊤ : Subgroup SL(2,F)) ≤ A.quotientRepresentation.ker := by
      intro he
      exact hw (LinearMap.congr_fun (he (Subgroup.mem_top g)) w)
    let : Group.IsPerfect (⊤ : Subgroup SL(2,F)) := Group.IsPerfect.ofSurjective
      (f := (Subgroup.topEquiv (G := SL(2,F))).symm.toMonoidHom)
      (Subgroup.topEquiv (G := SL(2,F))).symm.surjective
    obtain ⟨U,N,hi,hN⟩ := QuadraticFourGroup.exists_irreducible_section_surviving_perfect
      (ρ := A.quotientRepresentation) (⊤ : Subgroup SL(2,F)) hne
    let := hi
    have hnt : ∃ g, N.quotientRepresentation g ≠ 1 := by
      by_contra! he
      exact hN (fun g _ => he g)
    have hb := Unsigned.irreducible_finrank_bound 2 N.quotientRepresentation hnt n (by omega) hF
    have hle := (Submodule.finrank_quotient_le N.toSubmodule).trans
      (Submodule.finrank_le U.toSubmodule)
    omega
  have hle : Coinvariants.ker ρ ≤ A.toSubmodule := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨g,v⟩,rfl⟩
    apply (Submodule.Quotient.mk_eq_zero A.toSubmodule).mp
    change A.toSubmodule.mkQ (ρ g v-v) = 0
    rw [map_sub,←A.quotientRepresentation_mk,ht,sub_self]
  have htop : A = ⊤ := Subrepresentation.toSubmodule_injective
    (top_unique (hmov ▸ hle))
  exact isSimpleOrder_iff_isAtom_top.mpr (htop ▸ hA)


/-- A fixed-generated source count with the opposite field at most the square
root forces equality of the field degrees and the exact Sylow-fixed order. -/
theorem field_ratio_of_fixed_generated_order
    {F V : Type*} [Field F] [Finite F] [CharP F 2]
    [AddCommGroup V] [Module (ZMod 2) V] [Finite V] [Nontrivial V]
    (ρ : Representation (ZMod 2) SL(2,F) V) (S : Sylow 2 SL(2,F))
    (hgen : RankOne.QuadraticRecognition.GeneratedByFixedSpace ρ S)
    (hfix : ρ.invariants = ⊥) {n m : ℕ} (hm : 0 < m) (hmn : 2*m ≤ n)
    (hF : Nat.card F = 2^n)
    (hcard : Nat.card V = 2^m * Nat.card F * Nat.card (fixedSpace ρ S))
    (hbound : Nat.card (fixedSpace ρ S) ≤ 2^m * Nat.card F) :
    n = 2*m ∧ Nat.card (fixedSpace ρ S) = 2^m := by
  have hn : 1 < n := by omega
  have hu : Nat.card V ≤ 2^(2*(n+m)) := by
    rw [hcard,hF]
    rw [hF] at hbound
    calc
      2^m * 2^n * Nat.card (fixedSpace ρ S) ≤ 2^m * 2^n * (2^m * 2^n) := Nat.mul_le_mul_left _ hbound
      _ = 2^(2*(n+m)) := by rw [show 2*(n+m)=(m+n)+(m+n) by omega,pow_add,pow_add]
  have hd : Module.finrank (ZMod 2) V < 4*n := by
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod] at hu
    have hh := (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp hu
    omega
  let := irreducible_of_fixed_generated_degree_lt_four ρ S hgen hfix hn hF hd
  have hnt : ∃ g, ρ g ≠ 1 := by
    by_contra! ht
    have he : ρ.invariants = ⊤ := by
      apply top_unique
      intro v _ g
      rw [ht]
      rfl
    exact top_ne_bot (he.symm.trans hfix)
  obtain ⟨hs,w,hw,hsn,_,hdegree⟩ := Unsigned.exists_primeField_highestWeight_parameters 2 ρ hnt n hF
  let s := Module.finrank (ZMod 2) (Module.End (ZMod 2)[SL(2,F)] ρ.asModule)
  have hfixed : Module.finrank (ZMod 2) (fixedSpace ρ S) = s :=
    finrank_sylow_invariants_eq_endField 2 ρ S
  have he : Module.finrank (ZMod 2) V = m+n+s := by
    have hc := hcard
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod,hF,
      Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod,hfixed] at hc
    have he : 2^Module.finrank (ZMod 2) V = 2^(m+n+s) := by
      simpa only [pow_add] using hc
    exact Nat.pow_right_injective (by decide : 1 < 2) he
  have hdvd : s ∣ Module.finrank (ZMod 2) V := ⟨_,hdegree⟩
  have hsm : s ∣ m := by
    have hh : s ∣ n+s := dvd_add hsn (dvd_refl _)
    have he' : s ∣ m+(n+s) := by simpa only [←add_assoc,←he] using hdvd
    exact (Nat.dvd_add_iff_left hh).mpr he'
  have hle : s ≤ m := Nat.le_of_dvd hm hsm
  have hlo := Unsigned.irreducible_finrank_bound 2 ρ hnt n (by omega) hF
  have hsm' : s = m := by omega
  refine ⟨by omega,?_⟩
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod,hfixed,hsm']

end Representation.SL2