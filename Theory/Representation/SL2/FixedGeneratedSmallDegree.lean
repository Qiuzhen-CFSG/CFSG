module
public import Theory.Representation.SL2.PrimeFieldParameters.Unsigned
public import Theory.Representation.SL2.SylowFixedDimension
public import Theory.Representation.RankOne.QuadraticRecognition.Generation

/-!
# Small fixed-generated binary SL2 modules

A nonzero binary SL2(2^n) module with no invariant vectors, generated by
its Sylow-fixed space, is irreducible if its dimension is at most 2n+1.
A simple submodule has dimension at least 2n. Its quotient has dimension
at most one and hence trivial binary action; odd Sylow-coset averaging
and fixed generation rule out that quotient.

For such a module with |V|=2q|C_V(S)| and |C_V(S)|<=q, the Schur field
degree s is both the Sylow-fixed dimension and a divisor of n and dim V.
The order identity gives dim V=1+n+s, forcing s=1. The minimum degree
then gives n<=2; when n>1 the only possibility is n=2 and |C_V(S)|=2.

The application is the binary-beta branch of DGS85 (11.6)--(11.7),
Groups and Graphs (1985), pp.172--175. The representation inputs use the
proved defining-characteristic highest-weight and Schur-field formulas;
no module coordinates or irreducibility are assumed in the final theorem.
-/

public noncomputable section
open scoped MatrixGroups MonoidAlgebra
open Representation Representation.BinaryOffender
namespace Representation.SL2

private theorem binary_dim_one_trivial {D W : Type*} [Group D]
    [AddCommGroup W] [Module (ZMod 2) W] [Finite W]
    (σ : Representation (ZMod 2) D W) (hd : Module.finrank (ZMod 2) W ≤ 1) :
    ∀ g w, σ g w = w := by
  by_cases hz : Module.finrank (ZMod 2) W = 0
  · have : Subsingleton W := by
      by_contra! hn
      let : Nontrivial W := hn
      have hp := Module.finrank_pos (R := ZMod 2) (M := W)
      omega
    exact fun _ _ => Subsingleton.elim _ _
  have hc : Nat.card W = 2 := by
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod,show Module.finrank (ZMod 2) W = 1 by omega,pow_one]
  obtain ⟨z,_,hz⟩ := (Nat.card_eq_two_iff' (0 : W)).mp hc
  intro g w
  by_cases hw : w = 0
  · simp [hw]
  have hsw : σ g w ≠ 0 := by
    intro he
    apply hw
    exact (σ.apply_bijective g).injective (he.trans (map_zero (σ g)).symm)
  exact (hz _ hsw).trans (hz _ hw).symm

/-- Fixed generation and no invariant vectors force irreducibility within
one dimension of the minimum binary SL2 degree. -/
theorem irreducible_of_fixed_generated_small_degree
    {F V : Type*} [Field F] [Finite F] [CharP F 2]
    [AddCommGroup V] [Module (ZMod 2) V] [Finite V] [Nontrivial V]
    (ρ : Representation (ZMod 2) SL(2,F) V) (S : Sylow 2 SL(2,F))
    (hgen : RankOne.QuadraticRecognition.GeneratedByFixedSpace ρ S)
    (hfix : ρ.invariants = ⊥) {n : ℕ} (hn : n ≠ 0)
    (hF : Nat.card F = 2^n) (hd : Module.finrank (ZMod 2) V ≤ 2*n+1) :
    ρ.IsIrreducible := by
  have hfix' : fixedSpace ρ ⊤ = ⊥ := by
    have he : fixedSpace ρ ⊤ = ρ.invariants := by
      ext v
      exact ⟨fun hv g => hv ⟨g,Subgroup.mem_top g⟩,fun hv g => hv g.val⟩
    exact he.trans hfix
  have hmov := RankOne.QuadraticRecognition.moved_eq_top_of_sylow_generation ρ S hgen hfix'
  obtain ⟨A,hA,_⟩ := (eq_bot_or_exists_atom_le (⊤ : Subrepresentation ρ)).resolve_left top_ne_bot
  let : A.toRepresentation.IsIrreducible := (Subrepresentation.irreducible_iff_isAtom A).mpr hA
  have hnA : ∃ g, A.toRepresentation g ≠ 1 := by
    by_contra! hh
    have hb : A = ⊥ := by
      apply Subrepresentation.toSubmodule_injective
      apply bot_unique
      intro v hv
      apply hfix.le
      intro g
      exact congrArg Subtype.val (congrArg (fun f : Module.End (ZMod 2) A.toSubmodule =>
        f ⟨v,hv⟩) (hh g))
    exact hA.ne_bot hb
  have hlo := Unsigned.irreducible_finrank_bound 2 A.toRepresentation hnA n hn hF
  have hquot : Module.finrank (ZMod 2) (V ⧸ A.toSubmodule) ≤ 1 := by
    have he := Submodule.finrank_quotient_add_finrank A.toSubmodule
    omega
  let : Finite (V ⧸ A.toSubmodule) := Finite.of_surjective _ A.toSubmodule.mkQ_surjective
  have ht := binary_dim_one_trivial A.quotientRepresentation hquot
  have hle : Coinvariants.ker ρ ≤ A.toSubmodule := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨g,v⟩,rfl⟩
    apply (Submodule.Quotient.mk_eq_zero A.toSubmodule).mp
    change A.toSubmodule.mkQ (ρ g v-v) = 0
    rw [map_sub,←A.quotientRepresentation_mk,ht,sub_self]
  have htop : A = ⊤ := Subrepresentation.toSubmodule_injective
    (top_unique (hmov ▸ hle))
  exact isSimpleOrder_iff_isAtom_top.mpr (htop ▸ hA)

/-- The binary seed count selects the field and the Sylow-fixed order from
the actual module, without a prescribed module isomorphism. -/
theorem parameter_two_of_fixed_generated_order
    {F V : Type*} [Field F] [Finite F] [CharP F 2]
    [AddCommGroup V] [Module (ZMod 2) V] [Finite V] [Nontrivial V]
    (ρ : Representation (ZMod 2) SL(2,F) V) (S : Sylow 2 SL(2,F))
    (hgen : RankOne.QuadraticRecognition.GeneratedByFixedSpace ρ S)
    (hfix : ρ.invariants = ⊥) {n : ℕ} (hn : 1 < n)
    (hF : Nat.card F = 2^n)
    (hcard : Nat.card V = 2 * Nat.card F * Nat.card (fixedSpace ρ S))
    (hbound : Nat.card (fixedSpace ρ S) ≤ Nat.card F) :
    n = 2 ∧ Nat.card (fixedSpace ρ S) = 2 := by
  have hu : Nat.card V ≤ 2^(2*n+1) := by
    rw [hcard,hF] at *
    calc
      2 * 2^n * Nat.card (fixedSpace ρ S) ≤ 2 * 2^n * 2^n := Nat.mul_le_mul_left _ hbound
      _ = 2^(2*n+1) := by rw [pow_succ,show 2*n=n+n by omega,pow_add]; ring
  have hd : Module.finrank (ZMod 2) V ≤ 2*n+1 := by
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod] at hu
    exact (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp hu
  let := irreducible_of_fixed_generated_small_degree ρ S hgen hfix (by omega) hF hd
  have hnt : ∃ g, ρ g ≠ 1 := by
    by_contra! ht
    have he : ρ.invariants = ⊤ := by
      apply top_unique
      intro v _ g
      rw [ht]
      rfl
    exact top_ne_bot (he.symm.trans hfix)
  obtain ⟨hs,m,hm,hsn,_,hdegree⟩ := Unsigned.exists_primeField_highestWeight_parameters 2 ρ hnt n hF
  let s := Module.finrank (ZMod 2) (Module.End (ZMod 2)[SL(2,F)] ρ.asModule)
  have hfixed : Module.finrank (ZMod 2) (fixedSpace ρ S) = s :=
    finrank_sylow_invariants_eq_endField 2 ρ S
  have he : Module.finrank (ZMod 2) V = 1+n+s := by
    have hc := hcard
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod,hF,
      Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod,hfixed] at hc
    have he : 2^Module.finrank (ZMod 2) V = 2^(1+n+s) := by
      simpa only [pow_add,pow_one] using hc
    exact Nat.pow_right_injective (by decide : 1 < 2) he
  have hdvd : s ∣ Module.finrank (ZMod 2) V := by
    exact ⟨_,hdegree⟩
  have hsone : s ∣ 1 := by
    have hh : s ∣ n+s := dvd_add hsn (dvd_refl _)
    have he' : s ∣ 1+(n+s) := by simpa only [←add_assoc,←he] using hdvd
    exact (Nat.dvd_add_iff_left hh).mpr he'
  have hs1 : s = 1 := Nat.eq_one_of_dvd_one hsone
  have hlo := Unsigned.irreducible_finrank_bound 2 ρ hnt n (by omega) hF
  refine ⟨by rw [he,hs1] at hlo; omega,?_⟩
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod,hfixed,hs1,pow_one]
end Representation.SL2
