module
public import Theory.Representation.RankOne.QuadraticRecognition.SmallFixedSeed
public import Theory.GroupAction.SubgroupQuotientFullAction
public import Theory.Representation.ElementaryAbelianAction
public import Theory.ElementaryAbelian.Quotient
public import Theory.Representation.BinaryOffender.ConjugationImage
public import Theory.GroupTheory.ConjugateSpanSylow

/-!
# Natural coordinates on a conjugate-generated subgroup quotient

Let W be an elementary abelian group normalized by A, with H ≤ C ≤ W.
Suppose A/O₂(A) is marked as SL₂(k), O₂(A) acts trivially on W/H, and
W is generated by the A-conjugates of C. If a Sylow two-subgroup fixes
C/H and has all its displacements in C/H, with |C/H| ≤ |k| and C < W,
then the literal conjugation action on W/H is the natural SL₂(k) action.

We construct the descended action, prove that its seed generates and that
it is nontrivial, and apply small-fixed-seed recognition. The output retains
the given quotient marking and the conjugation formula on representatives.

Source: DGS85, Groups and Graphs, (5.9), (5.12), and (12.9), p.188(4).
The geometric application is CommutingThreeProfile.SuzukiSpanNatural.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender
open scoped MatrixGroups IsMulCommutative commutatorElement
namespace Representation.SL2
variable {G k : Type*} [Group G] [Field k] [Finite k] [CharP k 2]
local instance naturalConjugateQuotientFieldAlgebra : Algebra (ZMod 2) k := ZMod.algebra k 2

/-- Recognize the actual conjugation quotient from its small quadratic Sylow seed. -/
theorem natural_conjugate_quotient
    (A W H C : Subgroup G) [Finite A] [Finite W] [IsElementaryAbelian 2 W]
    (hAW : A ≤ normalizer (W : Set G)) (hAH : A ≤ normalizer (H : Set G))
    (hHC : H ≤ C) (hCW : C ≤ W) (hspan : W = conjugateSpanBy C A)
    (hne : W ≠ C) (hcore : ⁅W,A.pCoreIn 2⁆ ≤ H)
    (T : Sylow 2 A) (e : (A ⧸ pCore 2 A) ≃* SL(2,k))
    (hmove : ⁅W,(T : Subgroup A).map A.subtype⁆ ≤ C)
    (hfix : ⁅C,(T : Subgroup A).map A.subtype⁆ ≤ H)
    (hcard : H.relIndex C ≤ Nat.card k) :
    let : (H.subgroupOf W).Normal := normal_of_isMulCommutative _
    Nat.card (W ⧸ H.subgroupOf W) = Nat.card k ^ 2 ∧
      ∃ E : Additive (W ⧸ H.subgroupOf W) ≃ₗ[ZMod 2] (Fin 2 → k),
        ∀ a : A, ∀ w : W,
          E (Additive.ofMul (QuotientGroup.mk
            ⟨(a : G) * w * (a : G)⁻¹,
              (mem_normalizer_iff.mp (hAW a.property) w).mp w.property⟩)) =
            Matrix.mulVec (e (QuotientGroup.mk a)).val
              (E (Additive.ofMul (QuotientGroup.mk w))) := by
  let : (H.subgroupOf W).Normal := normal_of_isMulCommutative _
  let π := QuotientGroup.mk' (H.subgroupOf W)
  let B := (C.subgroupOf W).map π
  obtain ⟨α,hα⟩ := exists_quotient_conjugation_action A W H hAW hAH inferInstance
  have hkill := quotient_conjugation_action_kills_commutator_layer A W H (A.pCoreIn 2)
    inferInstance hAW hcore α hα
  have hk : pCore 2 A ≤ α.ker := by
    intro a ha
    exact hkill (mem_map_of_mem A.subtype ha)
  let β := QuotientGroup.lift (pCore 2 A) α hk
  let : MulDistribMulAction (A ⧸ pCore 2 A) (W ⧸ H.subgroupOf W) :=
    MulDistribMulAction.compHom _ β
  let ρ : Representation (ZMod 2) (A ⧸ pCore 2 A) (Additive (W ⧸ H.subgroupOf W)) :=
    Representation.ofElementaryAbelianAction
  let τ := ρ.comp e.symm.toMonoidHom
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 A))
  have hq : Function.Surjective q := e.surjective.comp (QuotientGroup.mk'_surjective _)
  let P : Sylow 2 SL(2,k) := T.mapSurjective hq
  have hτ (a : A) (w : W) :
      (τ (q a) (Additive.ofMul (π w))).toMul =
        π ⟨(a : G) * w * (a : G)⁻¹,
          (mem_normalizer_iff.mp (hAW a.property) w).mp w.property⟩ := by
    change (ρ (e.symm (e (QuotientGroup.mk a))) (Additive.ofMul (π w))).toMul = _
    rw [e.symm_apply_apply]
    exact hα a w
  have hmov : subspaceCommutator τ ⊤ (P : Subgroup _) ≤ binarySpace B := by
    apply Submodule.span_le.mpr
    rintro _ ⟨t,ht,v,_,rfl⟩
    obtain ⟨a,ha,rfl⟩ := ht
    obtain ⟨w,hw⟩ := QuotientGroup.mk'_surjective (H.subgroupOf W) v.toMul
    have hv : v = Additive.ofMul (π w) := (congrArg Additive.ofMul hw).symm
    rw [hv]
    change (τ (q a) (Additive.ofMul (π w))).toMul / π w ∈ B
    rw [hτ,div_eq_mul_inv,←map_inv,←map_mul]
    apply mem_map_of_mem
    exact hmove ((commutator_comm _ _).ge (commutator_mem_commutator
      (mem_map_of_mem A.subtype ha) w.property))
  have hfixed : binarySpace B ≤ fixedSpace τ (P : Subgroup _) := by
    rintro v ⟨w,hw,rfl⟩ t
    obtain ⟨a,ha,he⟩ := t.property
    change τ t.val (Additive.ofMul (π w)) = Additive.ofMul (π w)
    rw [←he]
    apply Additive.toMul.injective
    rw [hτ]
    apply QuotientGroup.eq_iff_div_mem.mpr
    change (a : G) * w * (a : G)⁻¹ / (w : G) ∈ H
    simpa only [div_eq_mul_inv,commutatorElement_def,Subgroup.subtype_apply] using
      hfix ((commutator_comm _ _).ge (commutator_mem_commutator
        (mem_map_of_mem A.subtype ha) hw))
  have hseed : (⨆ a, (binarySpace B).map (τ a)) = ⊤ := by
    let M := ⨆ a, (binarySpace B).map (τ a)
    let J := ((binarySubgroup M).comap π).map W.subtype
    have hWJ : W ≤ J := by
      rw [hspan]
      apply (closure_le _).mpr
      rintro z ⟨a,ha,c,hc,rfl⟩
      let w : W := ⟨c,hCW hc⟩
      refine ⟨⟨a*c*a⁻¹,(mem_normalizer_iff.mp (hAW ha) c).mp (hCW hc)⟩,?_,rfl⟩
      change Additive.ofMul (π _) ∈ M
      apply (le_iSup (fun a => (binarySpace B).map (τ a)) (q ⟨a,ha⟩))
      exact ⟨Additive.ofMul (π w),mem_map_of_mem π hc,
        congrArg Additive.ofMul (hτ ⟨a,ha⟩ w)⟩
    apply top_unique
    intro v _
    obtain ⟨w,hw⟩ := QuotientGroup.mk'_surjective (H.subgroupOf W) v.toMul
    obtain ⟨z,hz,he⟩ := hWJ w.property
    have hzw : z = w := Subtype.ext he
    rw [hzw] at hz
    change Additive.ofMul (π w) ∈ M at hz
    have hv : Additive.ofMul (π w) = v := congrArg Additive.ofMul hw
    exact hv ▸ hz
  have hneτ : τ ≠ 1 := by
    intro ht
    have htop : binarySpace B = ⊤ := by
      simpa only [ht,MonoidHom.one_apply,Module.End.one_eq_id,Submodule.map_id,iSup_const] using hseed
    apply hne
    apply le_antisymm _ hCW
    intro w hw
    have hm : π ⟨w,hw⟩ ∈ B := by
      change Additive.ofMul (π ⟨w,hw⟩) ∈ binarySpace B
      rw [htop]
      exact Submodule.mem_top
    obtain ⟨c,hc,he⟩ := hm
    have hd := QuotientGroup.eq_iff_div_mem.mp he
    have hmul := C.mul_mem (C.inv_mem (hHC hd)) hc
    change ((c : G) / w)⁻¹ * (c : G) ∈ C at hmul
    simpa only [div_eq_mul_inv, mul_inv_rev, inv_inv, mul_assoc, inv_mul_cancel, mul_one] using hmul
  have hcardB : Nat.card (binarySpace B) ≤ Nat.card k := by
    rw [←binarySubgroup_card (binarySpace B)]
    change Nat.card ((C.subgroupOf W).map π) ≤ Nat.card k
    rw [←relIndex_ker, QuotientGroup.ker_mk', relIndex_subgroupOf hCW]
    exact hcard
  obtain ⟨horder,E,hE⟩ := RankOne.QuadraticRecognition.sl2_small_seed_natural
    τ P (binarySpace B) hneτ hfixed hseed hmov hcardB
  refine ⟨horder,E,?_⟩
  intro a w
  exact (congrArg E (congrArg Additive.ofMul (hτ a w))).symm.trans
    (hE (q a) (Additive.ofMul (π w)))
end Representation.SL2
