module

public import Theory.Representation.SL2.HighestWeightBasis
public import Theory.Combinatorics.BinomialDigitCount
public import Mathlib.Algebra.CharP.Basic

/-!
# Digit-Product Dimensions for SL2

Let a finite field `K` have `p ^ m` elements, with `p` prime, and let it map
into a field `F` of characteristic `p`. For `n < p ^ m`, the actual
highest-weight orbit span generated by `X 0 ^ n` has dimension equal to the
product of one plus each base-`p` digit of `n`.

The binary-form basis theorem counts its nonzero binomial coefficients.
Characteristic `p` identifies these with coefficients not divisible by `p`,
and Lucas's digit-count theorem evaluates the cardinal. This is the
concrete-module dimension formula underlying Fong--Wong (1.15), p. 149;
it does not assume tensor classification or exhaustivity.
-/

namespace Representation.SL2

variable {K F : Type*} [Field K] [Field F] [Finite K]

public theorem highestWeightSpan_finrank_eq_prod_digits (e : K →+* F)
    (p : ℕ) (hp : p.Prime) [CharP F p] (n m : ℕ)
    (hcard : Nat.card K = p ^ m) (hn : n < p ^ m) :
    Module.finrank F (highestWeightSpan e n).toSubmodule =
      ∏ i : Fin m, (n / p ^ (i : ℕ) % p + 1) := by
  rw [highestWeightSpan_finrank_of_lt_card e n (by rwa [hcard])]
  simpa only [ne_eq, CharP.cast_eq_zero_iff F p] using
    Nat.card_not_dvd_choose_eq_prod_digits p hp n m hn

end Representation.SL2

