def check1024 (i : Nat) : Bool :=
  (rows0960 i ^^^ delta i proposals1024) == rows1024 i

set_option maxRecDepth 8192 in
theorem valid1024 : valid 1408 proposals1024 rows0960 = true := by
  decide +kernel

