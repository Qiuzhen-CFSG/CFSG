theorem solutions1024 (w : Fin 1408 → ZMod 2) :
    solutions 1408 1408 rows1024 w ↔ solutions 1408 1408 rows0960 w :=
  solutions_checked_delta 1408 1408 proposals1024 rows0960 rows1024
