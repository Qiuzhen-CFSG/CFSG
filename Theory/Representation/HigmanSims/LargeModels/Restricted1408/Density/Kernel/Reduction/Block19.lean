def check1280 (i : Nat) : Bool :=
  (rows1216 i ^^^ delta i proposals1280) == rows1280 i

set_option maxRecDepth 8192 in
theorem valid1280 : valid 1408 proposals1280 rows1216 = true := by
  decide +kernel

