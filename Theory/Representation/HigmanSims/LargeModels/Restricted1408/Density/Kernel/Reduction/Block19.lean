theorem solutions1280 (w : Fin 1408 → ZMod 2) :
    solutions 1408 1408 rows1280 w ↔ solutions 1408 1408 rows1216 w :=
  solutions_checked_delta 1408 1408 proposals1280 rows1216 rows1280
