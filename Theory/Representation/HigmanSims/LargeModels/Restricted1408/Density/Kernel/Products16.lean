/-! Checked finite arithmetic for the literal HS restriction.
See `source/README.md`; proposals generated by `source/Generate.py`.
The 64-row boundary is certified in four 16-row kernel reductions to bound
normalization cost, then assembled with the explicit range-addition theorem. -/

@[expose] public section
namespace Representation.HigmanSims.LargeModels.Restricted1408.Density.KernelData
open Thompson.InvolutionCentralizer.AlternatingQuotient.MatrixCertificates

set_option maxRecDepth 8192 in
private theorem block0 : checkRange rowCheck 1024 16 = true := by
  decide +kernel

set_option maxRecDepth 8192 in
private theorem block1 : checkRange rowCheck 1040 16 = true := by
  decide +kernel

set_option maxRecDepth 8192 in
private theorem block2 : checkRange rowCheck 1056 16 = true := by
  decide +kernel

set_option maxRecDepth 8192 in
private theorem block3 : checkRange rowCheck 1072 16 = true := by
  decide +kernel

theorem products16 : checkRange rowCheck 1024 64 = true := by
  have h32 := checkRange_append (f := rowCheck) (start := 1024) (m := 16) (n := 16) block0 block1
  have h48 := checkRange_append (f := rowCheck) (start := 1024) (m := 32) (n := 16) h32 block2
  exact checkRange_append (f := rowCheck) (start := 1024) (m := 48) (n := 16) h48 block3

theorem productsThrough1088 : checkRange rowCheck 0 1088 = true :=
  checkRange_append (f := rowCheck) (start := 0) (m := 1024) (n := 64) productsThrough1024 products16

end Representation.HigmanSims.LargeModels.Restricted1408.Density.KernelData
