module

public import Theory.Representation.HigmanSims.LargeModels.Restricted1408.Density.Cyclicity.Assembly
public import Theory.Representation.HigmanSims.LargeModels.Restricted1408.Density.Cyclicity.ColumnRecurrences
public import Theory.Representation.HigmanSims.LargeModels.Restricted1408.Density.Cyclicity.RowRecurrences
public import Theory.Representation.HigmanSims.LargeModels.Restricted1408.Density.Cyclicity.Spanning

/-!
# Cyclic orbit certificates for the degree-1408 HS restriction

The checked generator recurrences put every published orbit vector in each
invariant subspace containing its seed. The packed spanning certificates then
force that subspace to be the whole space. Thus every column, respectively row,
is a translate of the unchanged seed by the algebra generated by the literal
matrices. All recurrence and spanning premises are discharged here.

Source, ATLAS attribution and coordinate conventions: `Cyclicity/source/README.md`.
The independent parent `Density` module retains full-matrix-algebra assembly.
-/

public section
namespace Representation.HigmanSims.LargeModels.Restricted1408.Density
open Cyclicity

/-- Every column is an algebra translate of the published right-kernel seed. -/
theorem columnCyclic : ColumnCyclic :=
  columnCyclic_of_orbit_certificates columnOrbitRecurrences columnOrbit_spanning

/-- Every row is an algebra translate of the published left-kernel seed. -/
theorem rowCyclic : RowCyclic :=
  rowCyclic_of_orbit_certificates rowOrbitRecurrences rowOrbit_spanning

end Representation.HigmanSims.LargeModels.Restricted1408.Density
