module

public import Theory.Representation.HigmanSims.LargeModels.Restricted1408.Density.Packed

/-!
# The left annihilator of the singular density element

Four list-based XOR checks certify f*a, f*b, f*a*b and f*b*a for the
published row seed f. Their sum with f is zero, proving that f annihilates
`1 + b + a*b + b*a`. All computations are checked by the Lean kernel.
The input matrices and coordinate conventions are unchanged from the
ATLAS restriction in `../source/README.md`.
-/

public section
namespace Representation.HigmanSims.LargeModels.Restricted1408.Density

private def fa : ℕ := 

private def fb : ℕ := 

private def fab : ℕ := 

private def fba : ℕ := 

set_option maxRecDepth 4096 in
private theorem products :
    PackedBinaryRows.listProduct  0 aRows.toList = fa ∧
    PackedBinaryRows.listProduct  0 bRows.toList = fb ∧
    PackedBinaryRows.listProduct fa 0 bRows.toList = fab ∧
    PackedBinaryRows.listProduct fb 0 aRows.toList = fba := by
  decide +kernel

/-- A literal-matrix certificate for the left-annihilator clause. -/
theorem kernelCovector_annihilates : Matrix.vecMul kernelCovector separatingMatrix = 0 := by
  have hfa : Matrix.vecMul kernelCovector matrixA = vectorOfBits fa :=
    vecMul_matrixA_of_listProduct _ _ products.1
  have hfb : Matrix.vecMul kernelCovector matrixB = vectorOfBits fb :=
    vecMul_matrixB_of_listProduct _ _ products.2.1
  have hfab : Matrix.vecMul (vectorOfBits fa) matrixB = vectorOfBits fab :=
    vecMul_matrixB_of_listProduct _ _ products.2.2.1
  have hfba : Matrix.vecMul (vectorOfBits fb) matrixA = vectorOfBits fba :=
    vecMul_matrixA_of_listProduct _ _ products.2.2.2
  simp only [separatingMatrix, Matrix.vecMul_add, Matrix.vecMul_one,
    ← Matrix.vecMul_vecMul, hfa, hfb, hfab, hfba]
  change vectorOfBits  + vectorOfBits fb + vectorOfBits fab + vectorOfBits fba = 0
  rw [← vectorOfBits_xor, ← vectorOfBits_xor, ← vectorOfBits_xor]
  have hz :  ^^^ fb ^^^ fab ^^^ fba = 0 := by decide +kernel
  rw [hz, vectorOfBits_zero]

end Representation.HigmanSims.LargeModels.Restricted1408.Density
