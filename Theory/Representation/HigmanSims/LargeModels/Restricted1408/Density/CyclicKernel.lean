module

public import Mathlib.RingTheory.SimpleModule.Basic
public import Mathlib.LinearAlgebra.FiniteDimensional.Basic
public import Mathlib.Algebra.Algebra.Subalgebra.Lattice
public import Mathlib.LinearAlgebra.Matrix.ToLin

/-!
# The cyclic-kernel density criterion

Let a finite-dimensional module have an algebra element whose kernel is a
line generated by a cyclic vector. Suppose a functional annihilates that
element and its algebra translates separate vectors. Every proper invariant
subspace has injective, hence surjective, restriction of the element; all
translates of the functional then vanish on that subspace. Thus the module
is simple. A commuting endomorphism preserves the kernel line and is scalar
by cyclicity. Jacobson density now realizes every linear endomorphism.

This criterion works over any field and does not require a nonzero pairing
between the two seeds. It supplies the structural argument for the literal
ATLAS degree-1408 HS restriction described in `../source/README.md`.
-/

public section
open Module
namespace Representation.CyclicKernel
variable {F A V : Type*} [Field F] [Ring A] [Algebra F A]
  [AddCommGroup V] [Module F V] [Module A V] [IsScalarTower F A V]
  [FiniteDimensional F V] [Nontrivial V]

theorem simple (s : A) (v : V) (f : Module.Dual F V)
    (hker : ∀ w : V, s • w = 0 → ∃ c : F, w = c • v)
    (hcyc : ∀ w : V, ∃ a : A, a • v = w)
    (hdual : ∀ w : V, (∀ a : A, f (a • w) = 0) → w = 0)
    (hfs : ∀ w : V, f (s • w) = 0) : IsSimpleModule A V := by
  apply (isSimpleModule_iff A V).mpr
  refine ⟨fun W => ?_⟩
  by_cases hv : v ∈ W
  · right
    apply top_unique
    intro w _
    obtain ⟨a, rfl⟩ := hcyc w
    exact W.smul_mem a hv
  · left
    let W' := W.restrictScalars F
    let t : W' →ₗ[F] W' :=
      { toFun := fun w => ⟨s • w.val, W.smul_mem s w.property⟩
        map_add' := fun x y => Subtype.ext (smul_add s x.val y.val)
        map_smul' := fun c x => Subtype.ext (smul_comm s c x.val) }
    have ht : Function.Injective t := by
      apply (LinearMap.ker_eq_bot).mp
      apply (Submodule.eq_bot_iff _).mpr
      intro w hw
      have hz : s • w.val = 0 := congrArg Subtype.val hw
      obtain ⟨c, hc⟩ := hker w.val hz
      have hc0 : c = 0 := by
        by_contra hne
        apply hv
        have hm := W.smul_of_tower_mem (c⁻¹) w.property
        rwa [hc, inv_smul_smul₀ hne] at hm
      apply Subtype.ext
      simpa [hc0] using hc
    have hsurj := (LinearMap.injective_iff_surjective (f := t)).mp ht
    have hzero (w : V) (hw : w ∈ W) : f w = 0 := by
      obtain ⟨x, hx⟩ := hsurj ⟨w, hw⟩
      have hx' : s • x.val = w := congrArg Subtype.val hx
      rw [← hx']
      exact hfs x.val
    apply (Submodule.eq_bot_iff _).mpr
    intro w hw
    exact hdual w fun a => hzero (a • w) (W.smul_mem a hw)

omit [FiniteDimensional F V] [Nontrivial V] in
theorem end_scalar (s : A) (v : V)
    (hsv : s • v = 0)
    (hker : ∀ w : V, s • w = 0 → ∃ c : F, w = c • v)
    (hcyc : ∀ w : V, ∃ a : A, a • v = w)
    (T : Module.End A V) : ∃ c : F, ∀ w, T w = c • w := by
  have hTv : s • T v = 0 := by rw [← map_smul, hsv, map_zero]
  obtain ⟨c, hc⟩ := hker (T v) hTv
  refine ⟨c, fun w => ?_⟩
  obtain ⟨a, rfl⟩ := hcyc w
  rw [map_smul, hc, smul_comm]

theorem dense (s : A) (v : V) (f : Module.Dual F V)
    (hsv : s • v = 0)
    (hker : ∀ w : V, s • w = 0 → ∃ c : F, w = c • v)
    (hcyc : ∀ w : V, ∃ a : A, a • v = w)
    (hdual : ∀ w : V, (∀ a : A, f (a • w) = 0) → w = 0)
    (hfs : ∀ w : V, f (s • w) = 0) (g : Module.End F V) :
    ∃ a : A, ∀ w, g w = a • w := by
  classical
  let : IsSimpleModule A V := simple s v f hker hcyc hdual hfs
  let g' : Module.End (Module.End A V) V :=
    { g.toAddHom with
      map_smul' T w := by
        obtain ⟨c, hc⟩ := end_scalar s v hsv hker hcyc T
        change g (T w) = T (g w)
        rw [hc, hc, map_smul] }
  let b := Module.finBasis F V
  obtain ⟨a, ha⟩ := jacobson_density g' (Finset.univ.image b)
  refine ⟨a, fun w => ?_⟩
  have heq : g = Module.toModuleEnd F (S := A) V a := by
    apply b.ext
    intro i
    exact ha (b i) (Finset.mem_image.mpr ⟨i, Finset.mem_univ i, rfl⟩)
  exact congrArg (fun e : Module.End F V => e w) heq
end Representation.CyclicKernel


namespace Representation.CyclicKernel
variable {F V : Type*} [Field F] [AddCommGroup V] [Module F V]
  [FiniteDimensional F V] [Nontrivial V]

theorem end_top (P : Subalgebra F (Module.End F V))
    (s : Module.End F V) (v : V) (f : Module.Dual F V)
    (hs : s ∈ P) (hsv : s v = 0)
    (hker : ∀ w, s w = 0 → ∃ c : F, w = c • v)
    (hcyc : ∀ w, ∃ a ∈ P, a v = w)
    (hdual : ∀ w, (∀ a ∈ P, f (a w) = 0) → w = 0)
    (hfs : ∀ w, f (s w) = 0) : P = ⊤ := by
  let s' : P := ⟨s, hs⟩
  have hc : ∀ w, ∃ a : P, a • v = w := by
    intro w
    obtain ⟨a, ha, hw⟩ := hcyc w
    exact ⟨⟨a, ha⟩, hw⟩
  have hd : ∀ w, (∀ a : P, f (a • w) = 0) → w = 0 := by
    intro w hw
    exact hdual w fun a ha => hw ⟨a, ha⟩
  apply top_unique
  intro g _
  obtain ⟨a, ha⟩ := dense (F := F) (A := P) s' v f hsv hker hc hd hfs g
  have heq : g = a.val := LinearMap.ext ha
  exact heq.symm ▸ a.property
end Representation.CyclicKernel

