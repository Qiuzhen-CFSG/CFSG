/-!
# Complete transpose certificate for the literal B matrix

Each checked block certifies 32 consecutive columns of the unchanged source
matrix. Its length fixes the offset of the following block. The append theorem
therefore assembles exactly all 1408 proposed rows, retaining the bit convention
proved by `column_bit`. See `../source/README.md` for provenance and conventions.
-/

public section
namespace Representation.HigmanSims.LargeModels.Restricted1408.Density.Cyclicity.ColumnRecurrences

private theorem append_certified {rs cs ds : List Nat} {n m : Nat}
    (hcs : columnsCheck rs 0 cs = true ∧ cs.length = n)
    (hds : columnsCheck rs n ds = true) (hlen : ds.length = m) :
    columnsCheck rs 0 (cs ++ ds) = true ∧ (cs ++ ds).length = n + m := by
  constructor
  · rw [columnsCheck_append, hcs.2, Nat.zero_add, hcs.1, hds]
    rfl
  · rw [List.length_append, hcs.2, hlen]

/-- Every row of the published B transpose is the corresponding literal column. -/
theorem transposeBRows_check :
    columnsCheck bRows.toList 0 transposeBRows.toList = true := by
  have h00 : columnsCheck bRows.toList 0 transposeBBlock00 = true ∧
      transposeBBlock00.length = 32 := ⟨transposeBBlock00_check, rfl⟩
  have h01 := append_certified (n := 32) (m := 32) h00 transposeBBlock01_check rfl
  have h02 := append_certified (n := 64) (m := 32) h01 transposeBBlock02_check rfl
  have h03 := append_certified (n := 96) (m := 32) h02 transposeBBlock03_check rfl
  have h04 := append_certified (n := 128) (m := 32) h03 transposeBBlock04_check rfl
