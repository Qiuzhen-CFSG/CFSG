module

public import Theory.Representation.HigmanSims.LargeModels.Restricted1408.Density.Cyclicity.Checker
public import Theory.Representation.HigmanSims.LargeModels.Restricted1408.Density.Cyclicity.DataFacts
public import Theory.Representation.HigmanSims.LargeModels.Restricted1408.Density.Cyclicity.RecurrenceInput

/-!
# Assembly of the two literal cyclicity certificates

The published predecessor tables have smaller indices. Thus the exact action
recurrences place every orbit vector in an invariant subspace containing the
appropriate seed. A checked packed right inverse puts every standard basis
vector in that same subspace. `OrbitSpan` then gives a translate by an element
of the actual algebra generated by matrixA and matrixB.

The arithmetic recurrence and spanning premises remain explicit. These
conditional results do not assert either unconditional cyclicity contract.
Source and witness conventions: `source/README.md`.
-/

public section

namespace Representation.HigmanSims.LargeModels.Restricted1408.Density.Cyclicity

lemma eq_top_of_arrayProducts (W : Submodule (ZMod 2) Vector) (rows : Array ℕ)
    (hlen : rows.size = 1408)
    (hrows : ∀ i : Fin 1408, vectorOfBits rows[i.val]! ∈ W)
    (hspan : PackedSpanning rows) : W = ⊤ := by
  apply eq_top_of_listProducts W rows.toList _ hspan
  intro r hr
  obtain ⟨i, hi, rfl⟩ := Array.getElem_of_mem (Array.mem_toList_iff.mp hr)
  have hm := hrows ⟨i, hlen ▸ hi⟩
  simpa only [getElem!_pos rows i hi] using hm

lemma rowOrbit_seed : vectorOfBits rowOrbitRows[0]! = kernelCovector :=
  congrArg vectorOfBits rowOrbitRows_zero

lemma columnOrbit_seed : vectorOfBits columnOrbitRows[0]! = kernelVector :=
  congrArg vectorOfBits columnOrbitRows_zero

end Cyclicity
open Cyclicity

theorem rowCyclic_of_orbit_certificates
    (hrec : RowOrbitRecurrences) (hspan : PackedSpanning rowOrbitRows) : RowCyclic := by
  apply rowCyclic_of_invariant
  intro W hA hB hf
  apply eq_top_of_arrayProducts W rowOrbitRows rowOrbitRows_size _ hspan
  intro i
  exact orbit_mem W kernelCovector (fun x => Matrix.vecMul x matrixA)
    (fun x => Matrix.vecMul x matrixB) hA hB hf
    (fun k => rowOrbitRows[k]!) (fun k => rowOrbitParents[k]!)
    (fun k => rowOrbitChoices[k]!) rowOrbit_seed
    (fun k hk hn => rowOrbitParents_lt ⟨k, hn⟩ hk)
    (fun k hk hn => hrec ⟨k, hn⟩ hk) i.val i.isLt

theorem columnCyclic_of_orbit_certificates
    (hrec : ColumnOrbitRecurrences) (hspan : PackedSpanning columnOrbitRows) : ColumnCyclic := by
  apply columnCyclic_of_invariant
  intro W hA hB hv
  apply eq_top_of_arrayProducts W columnOrbitRows columnOrbitRows_size _ hspan
  intro i
  exact orbit_mem W kernelVector matrixA.mulVec matrixB.mulVec hA hB hv
    (fun k => columnOrbitRows[k]!) (fun k => columnOrbitParents[k]!)
    (fun k => columnOrbitChoices[k]!) columnOrbit_seed
    (fun k hk hn => columnOrbitParents_lt ⟨k, hn⟩ hk)
    (fun k hk hn => hrec ⟨k, hn⟩ hk) i.val i.isLt

end Representation.HigmanSims.LargeModels.Restricted1408.Density
