module

public import Theory.Representation.HigmanSims.LargeModels.Restricted1408.Descent.Permutation
public import Theory.GroupTheory.CosetWordCertificate
import Mathlib.Tactic.FinCases

/-!
# The literal index-100 subgroup in the HS presentation

The ATLAS source gives the subgroup M₁ₐ generated by `x`, `y⁻¹*x*y`, and
`y*x*y⁻¹`. We retain these words in the abstract thirteen-relator presentation.
Two auxiliary letters name its conjugate generators. The corresponding two
relations are proved identities, and the original thirteen words are translated
to the signed alphabet of the coset-certificate checker without alteration.

Source: `../source/HSG1-P1.M` (the definition of M1a).
-/

@[expose] public section
namespace Sporadic.LeechRelated.HS.AtlasPresentation.Faithfulness
open Subgroup.CosetWordCertificate

/-- The three literal generators of the source subgroup M₁ₐ. -/
def m1aGenerator : Fin 3 → Universal :=
  ![generator false, (generator true)⁻¹ * generator false * generator true,
    generator true * generator false * (generator true)⁻¹]

/-- This is a subgroup of the abstract presentation, before mapping to permutations. -/
def M1a : Subgroup Universal := Subgroup.closure (Set.range m1aGenerator)

theorem m1aGenerator_mem (i : Fin 3) : m1aGenerator i ∈ M1a :=
  Subgroup.subset_closure ⟨i, rfl⟩

/-- Auxiliary letters stand for fixed words, not additional hypotheses. -/
def extendedPair {G : Type*} [Group G] (a b : G) : Fin 4 → G :=
  ![a, b, b⁻¹ * a * b, b * a * b⁻¹]

def traceGenerator : Fin 4 → Universal := extendedPair (generator false) (generator true)

/-- Translation from the retained ATLAS alphabet `x,y,x⁻¹,y⁻¹`. -/
def sourceLetter : Fin 4 → Letter (Fin 4) :=
  ![(0, true), (1, true), (0, false), (1, false)]

/-- The thirteen source relations and two definitions of auxiliary letters. -/
def sourceWords (r : Nat) : Word (Fin 4) :=
  if h : r < 13 then (relatorLetters ⟨r, h⟩).map sourceLetter
  else if r = 13 then [(1, false), (0, true), (1, true), (2, false)]
  else if r = 14 then [(1, true), (0, true), (1, false), (3, false)]
  else []

theorem eval_sourceLetters {G : Type*} [Group G] (a b : G) (i : Fin 13) :
    eval (extendedPair a b) ((relatorLetters i).map sourceLetter) = word a b i := by
  simp only [eval, FreeGroup.lift_mk, List.map_map, word]
  congr 2
  funext j
  fin_cases j <;> simp [sourceLetter, extendedPair, letter]

/-- Each trace relation holds in Universal itself. -/
theorem sourceWords_valid (r : Nat) : eval traceGenerator (sourceWords r) = 1 := by
  by_cases h : r < 13
  · rw [sourceWords, dif_pos h]
    exact (eval_sourceLetters _ _ ⟨r, h⟩).trans (universal_word ⟨r, h⟩)
  · by_cases h13 : r = 13
    · subst r
      simp [sourceWords, traceGenerator, extendedPair, eval_cons, mul_assoc]
    · by_cases h14 : r = 14
      · subst r
        simp [sourceWords, traceGenerator, extendedPair, eval_cons, mul_assoc]
      · simp [sourceWords, h, h13, h14]

/-- Exactly the three source subgroup generators may introduce root loops. -/
def allowed (a : Letter (Fin 4)) : Bool :=
  decide (a = (0, true) ∨ a = (2, true) ∨ a = (3, true))

theorem allowed_mem (a : Letter (Fin 4)) (h : allowed a = true) :
    eval traceGenerator [a] ∈ M1a := by
  have ha : a = (0, true) ∨ a = (2, true) ∨ a = (3, true) := by
    simpa [allowed] using h
  rcases ha with rfl | rfl | rfl
  · exact m1aGenerator_mem 0
  · exact m1aGenerator_mem 1
  · exact m1aGenerator_mem 2

/-- Generation is inherited from the actual presented group. -/
theorem canonical_generates : Subgroup.closure (Set.range generator) = ⊤ :=
  PresentedGroup.closure_range_of (Set.range relator)

end Sporadic.LeechRelated.HS.AtlasPresentation.Faithfulness
