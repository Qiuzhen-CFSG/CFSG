def branch {α : Type*} (cutoff : Nat) (left right : Nat → α) (i : Nat) : α :=
  if i < cutoff then left i else right i

/-- A bounded decoder; zero terminates and each nonzero digit is a signed letter. -/
def decodeWord : Nat → Nat → Word (Fin 10)
  | 0, _ => []
  | n+1, c => if c = 0 then [] else
      let a := c % 32 - 1
      (⟨(a / 2) % 10, Nat.mod_lt _ (by decide)⟩, a % 2 == 0) ::
        decodeWord n (c >>> 5)

