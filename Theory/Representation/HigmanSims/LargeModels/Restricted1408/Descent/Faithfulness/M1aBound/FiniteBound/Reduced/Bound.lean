module

public import Theory.Representation.HigmanSims.LargeModels.Restricted1408.Descent.Faithfulness.M1aBound.FiniteBound.Reduced.Bound.LocalBase
public import Theory.Representation.HigmanSims.LargeModels.Restricted1408.Descent.Faithfulness.M1aBound.FiniteBound.Reduced.Transfer

/-!
# Assembly for the local subgroup route to the reduced finite bound

The literal subgroup generated by reduced generators 2, 3 and 6 (one-based)
is defined in `Bound.LocalBase`. An actual 22-coset cover and a finite bound
20,160 for this subgroup imply the requested bound 443,520. Neither missing
input is asserted here. The small dihedral subgroup in `LocalBase` provides
a proved base for constructing the local bound.

This assembly applies to the separate ten-generator presentation. The last
theorem connects it to the existing original-carrier consumer, retaining the
independent interpretation and marking premises. Source and outstanding
contracts: `Bound/source/README.md`.
-/

@[expose] public section
namespace Sporadic.LeechRelated.HS.AtlasPresentation.Faithfulness.M1aBound.Schreier.Reduced
open Subgroup.CosetWordCertificate

/-- The two independent inputs for the literal local subgroup route. -/
theorem finite_card_of_local_bound
    (C : Subgroup.GeneratorCosetCover Bound.localSubgroup generator (Fin 22))
    (hlocal : Finite Bound.localSubgroup ∧ Nat.card Bound.localSubgroup ≤ 20160) :
    Finite Carrier ∧ Nat.card Carrier ≤ 443520 := by
  let : Finite Bound.localSubgroup := hlocal.1
  obtain ⟨hf, hc⟩ := C.finite_card_le generator_generates
  refine ⟨hf, hc.trans ?_⟩
  simpa using Nat.mul_le_mul_right 22 hlocal.2

/-- A fully certified subgroup chain would discharge both numerical premises. -/
theorem finite_card_of_local_covers
    (C : Subgroup.GeneratorCosetCover Bound.localSubgroup generator (Fin 22))
    (D : Subgroup.GeneratorCosetCover Bound.smallSubgroup Bound.subgroupGenerator (Fin 3360)) :
    Finite Carrier ∧ Nat.card Carrier ≤ 443520 :=
  finite_card_of_local_bound C (Bound.local_finite_card_of_cover D)

/-- Actual application to the original Schreier carrier, with its independent
interpretation and marking obligations unchanged. -/
theorem original_finite_card_of_local_inputs
    (hr : ∀ r : Fin 597, eval candidateGenerator (relatorWord r) = 1)
    (hm : ∀ i : Fin 3, eval candidateGenerator (markedWord i) = threeGenerator i)
    (C : Subgroup.GeneratorCosetCover Bound.localSubgroup generator (Fin 22))
    (hlocal : Finite Bound.localSubgroup ∧ Nat.card Bound.localSubgroup ≤ 20160) :
    Finite Schreier.Carrier ∧ Nat.card Schreier.Carrier ≤ 443520 :=
  original_finite_card_of_inputs hr hm (finite_card_of_local_bound C hlocal)

end Sporadic.LeechRelated.HS.AtlasPresentation.Faithfulness.M1aBound.Schreier.Reduced
