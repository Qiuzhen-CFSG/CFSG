module

public import Theory.Representation.HigmanSims.LargeModels.Restricted1408.Descent.Faithfulness.M1aBound.FiniteBound.Generation.Checked

/-!
# Three generators for the exact Schreier carrier

The one-coset certificate derives membership of all 101 original generators
in the subgroup generated by indices 0, 1 and 2. Thus the six transitions of
these three generators suffice in an order certificate for the exact carrier.
Every deduction uses a literal Schreier relator; no finite quotient supplies
an equality. Source and reproduction: `Generation/source/README.md`.
-/

public section
namespace Sporadic.LeechRelated.HS.AtlasPresentation.Faithfulness.M1aBound.Schreier
open Subgroup.CosetWordCertificate

theorem localGenerator_mem_threeSubgroup (k : Fin 101) :
    localGenerator k ∈ threeSubgroup := by
  have h := GenerationCertificate.all_hold _ (GenerationCertificate.output_lt (2*k.val))
  rw [GenerationCertificate.shape (2*k.val) (by omega)] at h
  obtain ⟨x, hx⟩ := h
  have hd : GenerationCertificate.decode (2*k.val) = (k, true) := by
    simp [GenerationCertificate.decode, Nat.mod_eq_of_lt k.isLt]
  have he : localGenerator k = x.val := by
    simpa only [hd, Definitions.repr_zero, eval_letter, if_true, one_mul, mul_one] using hx
  exact he.symm ▸ x.property

/-- These three literal generators generate the entire presented group. -/
theorem threeGenerator_generates : Subgroup.closure (Set.range threeGenerator) = ⊤ := by
  have h : Subgroup.closure (Set.range localGenerator) ≤ threeSubgroup := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨k, rfl⟩
    exact localGenerator_mem_threeSubgroup k
  rw [localGenerator_generates] at h
  exact top_le_iff.mp h

/-- The smaller generating family is sufficient for the requested order bound. -/
theorem finite_card_of_three_cover
    (C : Subgroup.GeneratorCosetCover dihedralSubgroup threeGenerator (Fin 44352)) :
    Finite Carrier ∧ Nat.card Carrier ≤ 443520 := by
  let : Finite dihedralSubgroup := dihedralSubgroup_finite_card.1
  obtain ⟨hf, hc⟩ := C.finite_card_le threeGenerator_generates
  refine ⟨hf, hc.trans ?_⟩
  simpa using Nat.mul_le_mul_right 44352 dihedralSubgroup_finite_card.2

/-- Literal consumer: the same six-transition certificate bounds the source M₁ₐ. -/
theorem m1a_finite_card_of_three_cover
    (C : Subgroup.GeneratorCosetCover dihedralSubgroup threeGenerator (Fin 44352)) :
    Finite M1a ∧ Nat.card M1a ≤ 443520 :=
  m1a_finite_card_of_bound (finite_card_of_three_cover C)

end Sporadic.LeechRelated.HS.AtlasPresentation.Faithfulness.M1aBound.Schreier
