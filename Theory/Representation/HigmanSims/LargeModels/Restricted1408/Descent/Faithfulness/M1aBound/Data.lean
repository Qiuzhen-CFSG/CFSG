def letterCode (a : Letter Bool) : Nat := (if a.1 then 2 else 0) + (if a.2 then 0 else 1)
def nextPacked : Nat := 
def edgePacked : Nat := 
def next (i : Fin 100) (a : Letter Bool) : Fin 100 :=
  ⟨((nextPacked >>> (7 * (4 * i.val + letterCode a))) % 128) % 100, Nat.mod_lt _ (by decide)⟩
def transitionWord (i : Fin 100) (a : Letter Bool) : Word (Fin 101) :=
  let k := (edgePacked >>> (8 * (4 * i.val + letterCode a))) % 256
  if k = 255 then [] else [(⟨(k / 2) % 101, Nat.mod_lt _ (by decide)⟩, k % 2 == 0)]

