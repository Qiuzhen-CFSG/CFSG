    ⟨index ⟨(n / 6) % 3360, Nat.mod_lt _ (by decide)⟩,
      [decode (n % 6)], index (dest n)⟩

def shapeBlock (start count : Nat) : Bool :=
  (List.range count).all (fun k => shapeAt (start+k))

theorem shapeBlock_spec (start count : Nat) (h : shapeBlock start count = true)
    (n : Nat) (hlo : start ≤ n) (hhi : n < start + count) : shapeAt n = true := by
  have hm : n - start ∈ List.range count := by simp only [List.mem_range]; omega
  have hn : start + (n - start) = n := by omega
  simpa only [hn] using List.all_eq_true.mp h (n-start) hm

