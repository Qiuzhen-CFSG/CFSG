def unpack (pages : Nat → Nat) (bits i : Nat) : Nat :=
  (pages (i / 128) >>> (bits * (i % 128))) % (2 ^ bits)

def decode (a : Nat) : Letter (Fin 3) :=
  (⟨(a / 2) % 3, Nat.mod_lt _ (by decide)⟩, a % 2 == 0)

def allowed (a : Letter (Fin 3)) : Bool := a.1.val < 2

theorem allowed_mem (a : Letter (Fin 3)) (ha : allowed a = true) :
    eval subgroupGenerator [a] ∈ smallSubgroup := by
  have hi : a.1.val < 2 := by simpa only [allowed, decide_eq_true_eq] using ha
  have hi' : a.1 = 0 ∨ a.1 = 1 := by omega
  have hg : subgroupGenerator a.1 ∈ smallSubgroup := by
    rcases hi' with hi' | hi' <;> rw [hi'] <;> exact Subgroup.subset_closure (by simp)
  rw [eval_letter]
  split
  · exact hg
  · exact smallSubgroup.inv_mem hg

