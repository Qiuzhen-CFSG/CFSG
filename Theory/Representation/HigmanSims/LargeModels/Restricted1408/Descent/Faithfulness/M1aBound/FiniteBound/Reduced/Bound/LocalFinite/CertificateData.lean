def refs : Nat → Nat → List Nat
  | 0, _ => []
  | n+1, c => if c == 0 then [] else (c % 65536 - 1) :: refs n (c >>> 16)

def instructions (n : Nat) : Scan.Op (Fin 3) :=
  let c := opCode n
  let a := c / 8 % 65536
