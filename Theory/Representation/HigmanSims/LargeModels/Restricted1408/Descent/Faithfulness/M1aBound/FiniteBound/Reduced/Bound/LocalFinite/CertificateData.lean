  match c % 8 with
  | 0 => .basic (.refl a)
  | 1 => .basic (.defining a)
  | 2 => .basic (.subgroup (decode a))
  | 3 => .basic (.relator a b)
  | 4 => .basic (.reverse a)
  | 5 => .basic (.compose a b)
  | _ => .scan (scanHeader a / 2048) (scanHeader a % 2048)
