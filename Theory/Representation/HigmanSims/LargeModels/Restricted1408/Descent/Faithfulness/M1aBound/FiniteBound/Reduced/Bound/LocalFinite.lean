module

public import Theory.Representation.HigmanSims.LargeModels.Restricted1408.Descent.Faithfulness.M1aBound.FiniteBound.Reduced.Bound.LocalFinite.Checked

/-!
# A conditional bound for the literal local subgroup

Four explicit word identities, together with the three proved dihedral
relations, supply a checked 3,360-coset cover over the order-six subgroup.
This bounds the literal subgroup generated by reduced generators 2, 3 and 6
(one-based) by 20,160. The four identities still require derivation from the
exact reduced presentation; no permutation-image identity is assumed silently.
See `LocalFinite/source/README.md` for the source and remaining contract.
-/

@[expose] public section
namespace Sporadic.LeechRelated.HS.AtlasPresentation.Faithfulness.M1aBound.Schreier.Reduced.Bound
open Subgroup.CosetWordCertificate

namespace LocalFinite
open Certificate

/-- An actual cover of the literal subgroup, conditional on exactly four words. -/
def cover
    (hr : ∀ r : Fin 4, eval subgroupGenerator (extraRelatorWord r) = 1) :
    Subgroup.GeneratorCosetCover smallSubgroup subgroupGenerator (Fin 3360) :=
  coverOfFacts (H := smallSubgroup) (g := subgroupGenerator)
    (ρ := definitions.repr subgroupGenerator) facts index 0
    (by
      have hz : index 0 = 0 := by decide +kernel
      rw [hz, Definitions.repr_zero])
    (fun i a => dest (6 * i.val + encode a))
    (fun i a => output (6 * i.val + encode a))
    shape (fun i a => all_hold hr _ (output_lt _))

end LocalFinite

/-- The four additional relations discharge the local numerical premise. -/
theorem local_finite_card_of_extra
    (hr : ∀ r : Fin 4,
      eval subgroupGenerator (LocalFinite.extraRelatorWord r) = 1) :
    Finite localSubgroup ∧ Nat.card localSubgroup ≤ 20160 :=
  local_finite_card_of_cover (LocalFinite.cover hr)

end Sporadic.LeechRelated.HS.AtlasPresentation.Faithfulness.M1aBound.Schreier.Reduced.Bound
