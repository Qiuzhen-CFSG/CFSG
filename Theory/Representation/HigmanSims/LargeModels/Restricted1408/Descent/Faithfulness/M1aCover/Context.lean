module

public import Theory.Representation.HigmanSims.LargeModels.Restricted1408.Descent.Faithfulness.M1aCover.defCode

/-! Certified coset data for ATLAS HSG1-P1.M, literal subgroup M₁ₐ.
Generated by `source/generate.py`. Data are untrusted; `Scan.chunk_sound`
supplies witnesses in the subgroup of the abstract presentation. -/

@[expose] public section
namespace Sporadic.LeechRelated.HS.AtlasPresentation.Faithfulness.M1aCertificate
open Subgroup.CosetWordCertificate

def definitions : Definitions (Fin 4) where
  parent n := min (defCode n / 8) (n - 1)
  letter n := decode (defCode n % 8)
  parent_lt n := by
    have := Nat.min_le_right (defCode (n+1) / 8) (n+1-1)
    omega

/-- Rotations and inverses of actual source relations are still relations. -/
def rotatedRelator (r : Nat) : Word (Fin 4) :=
  (if r % 128 < 64 then sourceWords (r / 128)
   else FreeGroup.invRev (sourceWords (r / 128))).rotate (r % 64)

private theorem eval_rotate {G α : Type*} [Group G] (g : α → G)
    (w : Word α) (hw : eval g w = 1) (k : Nat) : eval g (w.rotate k) = 1 := by
  simp only [eval, FreeGroup.lift_mk] at hw ⊢
  rw [List.map_rotate]
  exact List.prod_rotate_eq_one_of_prod_eq_one hw k

theorem rotatedRelator_valid (r : Nat) : eval traceGenerator (rotatedRelator r) = 1 := by
  apply eval_rotate
  split
  · exact sourceWords_valid _
  · rw [eval_invRev, sourceWords_valid, inv_one]

def context : Context (Fin 4) :=
  ⟨definitions.parent, definitions.letter, rotatedRelator, allowed⟩

theorem context_valid : Valid context M1a traceGenerator (definitions.repr traceGenerator) :=
  definitions.valid rotatedRelator allowed allowed_mem rotatedRelator_valid

end Sporadic.LeechRelated.HS.AtlasPresentation.Faithfulness.M1aCertificate
