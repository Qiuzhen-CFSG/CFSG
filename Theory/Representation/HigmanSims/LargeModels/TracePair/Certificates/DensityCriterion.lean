module

public import Theory.Representation.HigmanSims.LargeModels.TracePair.Certificates.Candidates
public import Theory.Representation.G2DerivedPermutationFiltration.CycleFiltration.MatrixCriterion
import Mathlib.GroupTheory.OrderOfElement

/-!
# Extracting the HS rank-one projector without a large matrix power

For an idempotent P annihilated on both sides by H, invertibility of H + P
implies P lies in the algebra generated by H over a finite field. Indeed,
some positive power of H + P is one, while every positive power is Hⁿ + P.
Thus no explicit finite-order exponent or huge power needs to be computed.

For the literal ATLAS HSG1-f4r896aB0 matrices, take H = A + B + omega² I.
The normalized null-vector pair in `Candidates` proposes P. A checked inverse
of H + P and two spanning orbit certificates then imply full matrix algebra.
Those finite checks are explicit premises here; candidate data are in `source/`.
-/

@[expose] public section
namespace Representation.HigmanSims.LargeModels.TracePair.Certificates

/-- Over a finite ring, a complementary invertible perturbation puts the
idempotent in every subalgebra containing its annihilator. -/
theorem idempotent_mem_of_isUnit_add
    {K R : Type*} [CommRing K] [Ring R] [Algebra K R] [Finite R]
    (S : Subalgebra K R) {H P : R} (hH : H ∈ S)
    (hHP : H * P = 0) (hPH : P * H = 0) (hPP : P * P = P)
    (hunit : IsUnit (H + P)) : P ∈ S := by
  obtain ⟨n, hn, he⟩ := hunit.isOfFinOrder.exists_pow_eq_one
  have hp (k : ℕ) : (H + P) ^ (k + 1) = H ^ (k + 1) + P := by
    induction k with
    | zero => simp
    | succ k ih =>
      have hkp : H ^ (k + 1) * P = 0 := by
        rw [pow_succ, mul_assoc, hHP, mul_zero]
      rw [pow_succ, ih, add_mul, mul_add, mul_add, hkp, hPH, hPP,
        add_zero, zero_add, ← pow_succ]
  obtain ⟨k, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hn)
  have hPeq : P = 1 - H ^ (k + 1) := by
    rw [hp] at he
    exact eq_sub_iff_add_eq.mpr (by simpa only [add_comm] using he)
  rw [hPeq]
  exact S.sub_mem S.one_mem (S.pow_mem hH _)

/-- A normalized null-vector pair and a checked inverse construct the rank-one
operator inside the generated algebra. -/
theorem rankOne_mem_of_inverse
    {K n : Type*} [Field K] [Finite K] [Fintype n] [DecidableEq n]
    (S : Subalgebra K (Matrix n n K)) (H T : Matrix n n K) (u v : n → K)
    (hH : H ∈ S) (hu : H.mulVec u = 0) (hv : Matrix.vecMul v H = 0)
    (hvu : dotProduct v u = 1)
    (hT : (H + Matrix.vecMulVec u v) * T = 1) : Matrix.vecMulVec u v ∈ S := by
  apply idempotent_mem_of_isUnit_add S hH
  · rw [Matrix.mul_vecMulVec, hu, Matrix.zero_vecMulVec]
  · rw [Matrix.vecMulVec_mul, hv, Matrix.vecMulVec_zero]
  · rw [Matrix.vecMulVec_mul_vecMulVec, hvu, one_smul]
  · exact ⟨⟨H + Matrix.vecMulVec u v, T, hT, mul_eq_one_comm.mp hT⟩, rfl⟩

theorem matrixA_mem : matrixA ∈ generated := Algebra.subset_adjoin (by simp)
theorem matrixB_mem : matrixB ∈ generated := Algebra.subset_adjoin (by simp)

theorem singular_mem : singular ∈ generated :=
  generated.add_mem (generated.add_mem matrixA_mem matrixB_mem)
    (generated.smul_mem generated.one_mem _)

/-- The concrete projector membership reduces to null-vector and inverse checks. -/
theorem nullProjector_mem_of_inverse (T : Matrix (Fin 896) (Fin 896) Four)
    (hu : singular.mulVec nullColumn = 0)
    (hv : Matrix.vecMul nullRow singular = 0)
    (hT : (singular + Matrix.vecMulVec nullColumn nullRow) * T = 1) :
    Matrix.vecMulVec nullColumn nullRow ∈ generated :=
  rankOne_mem_of_inverse generated singular T nullColumn nullRow singular_mem hu hv
    nullPair_normalized hT

/-- The literal two orbit spans turn the projector into every matrix unit. -/
theorem full_of_nullProjector
    (hP : Matrix.vecMulVec nullColumn nullRow ∈ generated)
    (hc : columnOrbitSpan = ⊤) (hr : rowOrbitSpan = ⊤) : MatrixAlgebraFull :=
  G2DerivedPermutationFiltration.CycleMatrixCriterion.algebra_eq_top_of_rank_one
    generated nullColumn nullRow (fun L : generated => L.val) (fun R : generated => R.val)
    (fun L => L.property) (fun R => R.property) hP hc hr

/-- Assembly of the three independent finite certificate obligations. -/
theorem full_of_finite_checks (T : Matrix (Fin 896) (Fin 896) Four)
    (hu : singular.mulVec nullColumn = 0)
    (hv : Matrix.vecMul nullRow singular = 0)
    (hT : (singular + Matrix.vecMulVec nullColumn nullRow) * T = 1)
    (hc : columnOrbitSpan = ⊤) (hr : rowOrbitSpan = ⊤) : MatrixAlgebraFull :=
  full_of_nullProjector (nullProjector_mem_of_inverse T hu hv hT) hc hr

end Representation.HigmanSims.LargeModels.TracePair.Certificates
