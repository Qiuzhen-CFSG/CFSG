module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.HS.GeneratorCover
public import Mathlib.GroupTheory.PresentedGroup
import Mathlib.Tactic.FinCases

/-!
# Relators and a factorization criterion for the literal HS carrier

The thirteen words below are exactly the relations in the ATLAS file
`HSG1-P1.M`, including its three additional relators. The commutator convention
is Magma's `a⁻¹ b⁻¹ a b`. The unmodified source and its checksum are retained in
`source/`. No assertion that these relations present the carrier is made here.

The carrier evaluation is surjective because its images are the two defining
permutations. If its kernel is contained in the normal closure of the listed
relators, a pair satisfying them factors through this evaluation. The resulting
homomorphism preserves both markings, rather than using an abstract isomorphism.
`Descent.lean` applies this construction to the literal degree-896 matrices.
-/

@[expose] public section
namespace Representation.HigmanSims.LargeModels.TracePair.Descent
open Sporadic.LeechRelated.HS

/-- The thirteen relators in the retained ATLAS Magma presentation. -/
def relation {G : Type*} [Group G] (a b : G) (i : Fin 13) : G :=
  match i.val with
  | 0 => a ^ 2
  | 1 => b ^ 5
  | 2 => (a * b) ^ 11
  | 3 => (a * b ^ 2) ^ 10
  | 4 => (a⁻¹ * b⁻¹ * a * b) ^ 5
  | 5 => (a⁻¹ * (b * a * b)⁻¹ * a * (b * a * b)) ^ 3
  | 6 => (a⁻¹ * (b ^ 2)⁻¹ * a * b ^ 2) ^ 6
  | 7 => a * b * a * b * a * b ^ 2 * a * b⁻¹ * a * (b ^ 2)⁻¹ *
      a * b⁻¹ * a * b ^ 2 * a * b * a * b * (a * (b ^ 2)⁻¹) ^ 4
  | 8 => a * b * (a * b ^ 2 * (a * (b ^ 2)⁻¹) ^ 2) ^ 2 * a * b ^ 2 *
      a * b * a * b ^ 2 * (a * b⁻¹ * a * b ^ 2) ^ 2
  | 9 => a * b * a * b * (a * b ^ 2) ^ 2 * a * b * (a * b⁻¹) ^ 2 *
      a * b * (a * b ^ 2) ^ 2 * a * b * a * b * a * (b ^ 2)⁻¹ *
      a * b⁻¹ * a * (b ^ 2)⁻¹
  | 10 => (a * b * a * b * a * b ^ 2 * a * b⁻¹ * a * (b ^ 2)⁻¹ *
      a * b * a * b * a * b⁻¹) ^ 2
  | 11 => (a * b * a * b * a * b ^ 2) ^ 2 * a * b * a * b * a * b⁻¹ *
      a * b * a * b * (a * b ^ 2) ^ 3 * a * b * a * b * a * b⁻¹
  | _ => a * b * (a * b * a * b ^ 2) ^ 3 * a * b * a * b * a * b ^ 2 *
      a * b⁻¹ * a * b * a * (b ^ 2)⁻¹ * a * b * a * b⁻¹ * a * b ^ 2

theorem map_relation {G H : Type*} [Group G] [Group H]
    (f : G →* H) (a b : G) (i : Fin 13) :
    f (relation a b i) = relation (f a) (f b) i := by
  fin_cases i <;> simp only [relation, map_mul, map_inv, map_pow]

def relator (i : Fin 13) : FreeGroup Bool :=
  relation (FreeGroup.of false) (FreeGroup.of true) i

def relators : Set (FreeGroup Bool) := Set.range relator

def carrierGenerator : Bool → Carrier
  | false => generatorAElement
  | true => generatorBElement

def carrierEvaluation : FreeGroup Bool →* Carrier := FreeGroup.lift carrierGenerator

@[simp] theorem carrierEvaluation_a :
    carrierEvaluation (FreeGroup.of false) = generatorAElement := FreeGroup.lift_apply_of

@[simp] theorem carrierEvaluation_b :
    carrierEvaluation (FreeGroup.of true) = generatorBElement := FreeGroup.lift_apply_of

theorem carrierEvaluation_surjective : Function.Surjective carrierEvaluation := by
  apply MonoidHom.range_eq_top.mp
  exact eq_top_of_generators_mem _ ⟨FreeGroup.of false, carrierEvaluation_a⟩
    ⟨FreeGroup.of true, carrierEvaluation_b⟩

def RelatorsPresentCarrier : Prop :=
  carrierEvaluation.ker ≤ Subgroup.normalClosure relators

/-- A group generated by the two marked permutations is a quotient of the free
group. Once every word in the carrier kernel follows from the given relators,
any pair satisfying those relators defines a homomorphism on this carrier. -/
noncomputable def descend {G : Type*} [Group G] (hp : RelatorsPresentCarrier)
    (a b : G) (hr : ∀ i : Fin 13, relation a b i = 1) : Carrier →* G :=
  carrierEvaluation.liftOfSurjective carrierEvaluation_surjective
    ⟨FreeGroup.lift (fun x : Bool => if x then b else a), hp.trans <|
      Subgroup.normalClosure_le_normal (by
        rintro _ ⟨i, rfl⟩
        change FreeGroup.lift _ (relator i) = 1
        rw [relator, map_relation]
        simpa only [FreeGroup.lift_apply_of, Bool.false_eq_true, if_false, if_true]
          using hr i)⟩

theorem descend_evaluation {G : Type*} [Group G] (hp : RelatorsPresentCarrier)
    (a b : G) (hr : ∀ i : Fin 13, relation a b i = 1) (w : FreeGroup Bool) :
    descend hp a b hr (carrierEvaluation w) =
      FreeGroup.lift (fun x : Bool => if x then b else a) w :=
  MonoidHom.liftOfRightInverse_comp_apply ..

@[simp] theorem descend_a {G : Type*} [Group G] (hp : RelatorsPresentCarrier)
    (a b : G) (hr : ∀ i : Fin 13, relation a b i = 1) :
    descend hp a b hr generatorAElement = a := by
  simpa only [carrierEvaluation_a, FreeGroup.lift_apply_of, Bool.false_eq_true, if_false]
    using descend_evaluation hp a b hr (FreeGroup.of false)

@[simp] theorem descend_b {G : Type*} [Group G] (hp : RelatorsPresentCarrier)
    (a b : G) (hr : ∀ i : Fin 13, relation a b i = 1) :
    descend hp a b hr generatorBElement = b := by
  simpa only [carrierEvaluation_b, FreeGroup.lift_apply_of, if_true]
    using descend_evaluation hp a b hr (FreeGroup.of true)

end Representation.HigmanSims.LargeModels.TracePair.Descent
