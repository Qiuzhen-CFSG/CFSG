private theorem square_scan :
    OrderArithmetic.scan (mask 896 64) b2Packed bTwoRows = b4Packed := by
  decide +kernel

/-- Every coordinate in this batch satisfies this fixed product. -/
theorem square (i : Fin 64) :
    Streaming.product (bTwoRows.getD (768 + i.val) (0, 0)) bTwoRows =
      bFourRows.getD (768 + i.val) (0, 0) := by
  have h := OrderArithmetic.rows_of_scan 896 64 bTwoRows
    b2Packed b4Packed (by decide)
    (Nat.le_of_eq bTwoRows_length) bTwoRows_bounded square_scan i
  simpa only [b2_lanes i, b4_lanes i] using h

