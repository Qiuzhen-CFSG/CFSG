/-!
# The checked closing products for the eleventh-power chain

The row certificates check all 896 images for F² = G and GC = I.
Linearity assembles them with `eval_product` and `eval_inverse`. These
fixed numerical identities discharge the final two premises of
`ABPower.pow_eleven_eq_one_of_products`, for source relator 2 in
`Descent/source/HSG1-P1.M`; no prior power identification is used.

Generated by `Closing/source/Generate.py` using the unchanged ATLAS
HSG1-f4r896aB0 data and the existing GF(4) encoding. Each numerical
identity is checked by Lean. See `Closing/source/README.md`,
`ABPower/source/README.md` and `TracePair/source/README.md`.
-/

@[expose] public section
namespace Representation.HigmanSims.LargeModels.TracePair.Descent.MatrixRelations.PowerChecks.ABPower.Closing
open Representation.HigmanSims.LargeModels.TracePair.Certificates
open LinearCertificates

theorem f_square_eq_g : Packed.eval 896 fRows * Packed.eval 896 fRows = Packed.eval 896 gRows := by
  apply LinearCertificates.eval_product
  intro i
  have h : (0 ≤ i.val ∧ i.val < 112) ∨ (112 ≤ i.val ∧ i.val < 224) ∨ (224 ≤ i.val ∧ i.val < 336) ∨ (336 ≤ i.val ∧ i.val < 448) ∨ (448 ≤ i.val ∧ i.val < 560) ∨ (560 ≤ i.val ∧ i.val < 672) ∨ (672 ≤ i.val ∧ i.val < 784) ∨ (784 ≤ i.val ∧ i.val < 896) := by omega
  rcases h with h0 | h1 | h2 | h3 | h4 | h5 | h6 | h7
  · exact FF00.rows i.val h0.1 h0.2
  · exact FF01.rows i.val h1.1 h1.2
  · exact FF02.rows i.val h2.1 h2.2
  · exact FF03.rows i.val h3.1 h3.2
  · exact FF04.rows i.val h4.1 h4.2
  · exact FF05.rows i.val h5.1 h5.2
  · exact FF06.rows i.val h6.1 h6.2
  · exact FF07.rows i.val h7.1 h7.2

theorem g_mul_c_eq_one : Packed.eval 896 gRows * Packed.eval 896 cRows = 1 := by
  apply LinearCertificates.eval_inverse
  intro i
  have h : (0 ≤ i.val ∧ i.val < 112) ∨ (112 ≤ i.val ∧ i.val < 224) ∨ (224 ≤ i.val ∧ i.val < 336) ∨ (336 ≤ i.val ∧ i.val < 448) ∨ (448 ≤ i.val ∧ i.val < 560) ∨ (560 ≤ i.val ∧ i.val < 672) ∨ (672 ≤ i.val ∧ i.val < 784) ∨ (784 ≤ i.val ∧ i.val < 896) := by omega
  rcases h with h0 | h1 | h2 | h3 | h4 | h5 | h6 | h7
  · exact GC00.rows i.val h0.1 h0.2
  · exact GC01.rows i.val h1.1 h1.2
  · exact GC02.rows i.val h2.1 h2.2
  · exact GC03.rows i.val h3.1 h3.2
  · exact GC04.rows i.val h4.1 h4.2
  · exact GC05.rows i.val h5.1 h5.2
  · exact GC06.rows i.val h6.1 h6.2
  · exact GC07.rows i.val h7.1 h7.2

end Representation.HigmanSims.LargeModels.TracePair.Descent.MatrixRelations.PowerChecks.ABPower.Closing
