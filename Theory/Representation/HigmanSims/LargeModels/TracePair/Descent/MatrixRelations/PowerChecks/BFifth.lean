/-- Relator 1 of the retained `HSG1-P1.M`, with no additional premises. -/
theorem pow_five_eq_one : (Packed.eval 896 generatorRowsB) ^ 5 = 1 := by
  calc
    (Packed.eval 896 generatorRowsB) ^ 5 =
        (Packed.eval 896 generatorRowsB * Packed.eval 896 generatorRowsB) *
