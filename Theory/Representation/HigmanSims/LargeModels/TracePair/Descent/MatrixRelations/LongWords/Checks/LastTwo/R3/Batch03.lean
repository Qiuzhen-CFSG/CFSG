private def left39 : Packed.Row := (, )

private def result39 : Packed.Row := (, )

private theorem left39_checked :
    unpack 896 64 left39 = ((rowsAt 6).drop 192).take 64 := by decide +kernel

private theorem left39_lanes (r : Fin 64) :
    laneRow 896 r.val left39 = (rowsAt 6).getD (192 + r.val) (0,0) :=
  lanes_of_unpack 896 192 64 (rowsAt 6) left39 left39_checked r

private theorem result39_checked :
    unpack 896 64 result39 = ((rowsAt 41).drop 192).take 64 := by decide +kernel

private theorem result39_lanes (r : Fin 64) :
    laneRow 896 r.val result39 = (rowsAt 41).getD (192 + r.val) (0,0) :=
  lanes_of_unpack 896 192 64 (rowsAt 41) result39 result39_checked r

private theorem scan39 : scan (mask 896 64) left39 (rowsAt 5) = result39 := by
  decide +kernel

/-- Every row in this batch satisfies the literal numerical gate 39. -/
theorem gate39 (r : Fin 64) : RowAt 39 (192 + r.val) := by
  change Packed.rowProduct ((rowsAt 6).getD (192 + r.val) (0,0)) (rowsAt 5) =
    (rowsAt 41).getD (192 + r.val) (0,0)
  have h := rows_of_scan 896 64 (rowsAt 5) left39 result39
    (by decide) (le_of_eq (rowsAt_length 5)) bounded_5 scan39 r
  simpa only [left39_lanes r, result39_lanes r] using h

