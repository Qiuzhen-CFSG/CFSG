/-- The literal published matrices generate the full algebra in degree 56. -/
theorem algebra_eq_top
    (Q : Subalgebra (ZMod 2) (Matrix (Fin 56) (Fin 56) (ZMod 2)))
    (ha : decode 56 Binary.D56.aRows ∈ Q)
    (hb : decode 56 Binary.D56.bRows ∈ Q) : Q = ⊤ := by
  have hA (i : Fin 2) : decode 56 (actors i) ∈ Q := by
    by_cases h : i = 0
    · simpa only [actors, h, ↓reduceIte] using ha
    · simpa only [actors, h, ↓reduceIte] using hb
  apply full_of_orbits Q (fun i => decode 56 (actors i)) hA cols rows ci ri
    colParent rowParent colLetter rowLetter colParent_lt rowParent_lt
    _ _ cols_inverse rows_inverse (rankOne_mem Q ha hb)
  · intro i
    rw [← vecMul_transpose, ← actorsT_eq]
    exact vecMul_checked _ _ _ (actorsT_size _) (colSteps i)
  · intro i
    exact vecMul_checked _ _ _ (actors_size _) (rowSteps i)

