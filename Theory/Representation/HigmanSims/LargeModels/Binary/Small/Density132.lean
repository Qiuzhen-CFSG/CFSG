private theorem actorsT_eq (i : Fin 2) :
    decode 132 (actorsT i) = (decode 132 (actors i))ᵀ := by
  by_cases h : i = 0
  · simpa only [actorsT, actors, h, ↓reduceIte] using aTranspose_eq
  · simpa only [actorsT, actors, h, ↓reduceIte] using bTranspose_eq


private theorem cols_inverse : decode 132 ci * decode 132 cols = 1 :=
  inverse_checked ci cols cols_size cols_inverse_checked

private theorem rows_inverse : decode 132 ri * decode 132 rows = 1 :=
  inverse_checked ri rows rows_size rows_inverse_checked

theorem algebra_eq_top
    (Q : Subalgebra (ZMod 2) (Matrix (Fin 132) (Fin 132) (ZMod 2)))
    (ha : decode 132 Binary.D132.aRows ∈ Q)
    (hb : decode 132 Binary.D132.bRows ∈ Q) : Q = ⊤ := by
  have hA (i : Fin 2) : decode 132 (actors i) ∈ Q := by
    by_cases h : i = 0
    · simpa only [actors, h, ↓reduceIte] using ha
    · simpa only [actors, h, ↓reduceIte] using hb
  apply full_of_orbits Q (fun i => decode 132 (actors i)) hA cols rows ci ri
    colParent rowParent colLetter rowLetter colParent_lt rowParent_lt
    _ _ cols_inverse rows_inverse (rankOne_mem Q ha hb)
  · intro i
    rw [← vecMul_transpose, ← actorsT_eq]
    exact vecMul_checked _ _ _ (actorsT_size _) (colSteps i)
  · intro i
    exact vecMul_checked _ _ _ (actors_size _) (rowSteps i)

