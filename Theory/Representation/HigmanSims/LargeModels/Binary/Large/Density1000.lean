module

public import Theory.Representation.HigmanSims.LargeModels.Binary.Large.Density1000.Setup
public import Theory.Representation.HigmanSims.LargeModels.Binary.Large.Density1000.RankOne
public import Theory.Representation.HigmanSims.LargeModels.Binary.Large.Density1000.ColumnSpan
public import Theory.Representation.HigmanSims.LargeModels.Binary.Large.Density1000.RowSpan
public import Theory.Representation.HigmanSims.LargeModels.Binary.Assembly
public import Theory.Representation.G2DerivedPermutationFiltration.CycleFiltration.MatrixCriterion

/-!
# Assembly of the degree-1000 binary HS density calculation

The literal source polynomial is in the algebra generated by the published
matrices. The checked rank-one identity and spanning of both literal word
orbits therefore give `MatrixAlgebraFull 3` by the rank-one matrix criterion.
The unconditional `matrixAlgebraFull` supplies all three certificates to the
preserved conditional assembly. No carrier-action or group hypothesis is used.

Source: R. A. Wilson et al., ATLAS HSG1-f2r1000B0; candidate identities,
word conventions and attribution are in `Binary/source/README.md`.
-/

@[expose] public section

open Matrix Thompson.BinaryMatrix

namespace Representation.HigmanSims.LargeModels.Binary.Large.Density1000

/-- Assemble the three independent numerical certificates in the literal
shared matrix-algebra interface. No carrier-action assumption is used. -/
theorem matrixAlgebraFull_of_certificates
    (hpoly : polynomialMatrix = vecMulVec imageVector functionalVector)
    (hcol : Submodule.span (ZMod 2) (Set.range columnOrbit) = ⊤)
    (hrow : Submodule.span (ZMod 2) (Set.range rowOrbit) = ⊤) :
    MatrixAlgebraFull 3 := by
  change Algebra.adjoin (ZMod 2)
    ({decode 1000 D1000.aRows, decode 1000 D1000.bRows} : Set Square) = ⊤
  let Q := Algebra.adjoin (ZMod 2)
    ({decode 1000 D1000.aRows, decode 1000 D1000.bRows} : Set Square)
  have ha : decode 1000 D1000.aRows ∈ Q := Algebra.subset_adjoin (by simp)
  have hb : decode 1000 D1000.bRows ∈ Q := Algebra.subset_adjoin (by simp)
  exact G2DerivedPermutationFiltration.CycleMatrixCriterion.algebra_eq_top_of_rank_one
    Q imageVector functionalVector columnActor rowActor
    (fun i => wordMatrix_mem Q ha hb Data.columnWords[i.val]!)
    (fun i => wordMatrix_mem Q ha hb Data.rowWords[i.val]!)
    (hpoly ▸ polynomialMatrix_mem Q ha hb) hcol hrow

/-- The two published degree-1000 binary HS matrices generate the full matrix
algebra. Every numerical premise is discharged by its checked certificate. -/
theorem matrixAlgebraFull : MatrixAlgebraFull 3 :=
  matrixAlgebraFull_of_certificates polynomial_identity columnOrbit_span rowOrbit_span_eq_top

end Representation.HigmanSims.LargeModels.Binary.Large.Density1000
