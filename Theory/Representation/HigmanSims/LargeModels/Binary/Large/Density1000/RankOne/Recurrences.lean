theorem chain_step (i : Fin 999) :
    Matrix.vecMul (chain i.castSucc) (Thompson.BinaryMatrix.decode 1000 Data.dRows) =
      chain i.succ := by
  have hp := step_product i
  have hv := dTree.vecMul_of_product dTree_valid Data.dRows dTree_aligned
    1000 dRows_size krylovRows[i.val]! krylovRows[i.val + 1]! hp
  simpa [chain] using hv

end Representation.HigmanSims.LargeModels.Binary.Large.Density1000.RankOne
