module

public import Theory.Representation.HigmanSims.LargeModels.Binary.Large.Density1000.RankOne.Blocks

/-!
# Bounded recurrence infrastructure for the degree-1000 Krylov chain

`stepPair` records the adjacent packed rows from the published candidate
array. The descendant batch modules check bounded lists of these products
against the shared balanced D tree. The source data are the ATLAS
HSG1-f2r1000B0 tables, regenerated by `RankOne/source/generate.py` from
`Density1000/source/discover_cyclic.py`; attribution and rights remain in
`Binary/source/README.md`.
-/

@[expose] public section
open Matrix Thompson.BinaryMatrix
namespace Representation.HigmanSims.LargeModels.Binary.Large.Density1000.RankOne
open RowArithmetic

def stepPair (i : Fin 999) : ℕ × ℕ :=
  (krylovRows[i.val]!, krylovRows[i.val + 1]!)

end Representation.HigmanSims.LargeModels.Binary.Large.Density1000.RankOne
