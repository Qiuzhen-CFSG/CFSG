# The fixed exterior-section pivot minor has the supplied right inverse

The block certificates prove all 1000 packed row products. The packing
lemma identifies those rows with the literal selected-column minor, and
the checked identity discharges the surjectivity premise for descent.
Generated by `Rank/generate.py` from the fixed `Binary/source/section1000.json`.
ATLAS attribution and rights are retained in `Binary/source/README.md`.
-/
@[expose] public section
namespace Representation.HigmanSims.LargeModels.Binary.Large.Exterior1000
private theorem packed_product (i : Fin 1000) :
    RowArithmetic.combine pivotInverseRows.toList (Rank.pack liftRows[i.val]!) = 2 ^ i.val := by
  let q : Fin 40 := ⟨i.val / 25, by omega⟩
  let r : Fin 25 := ⟨i.val % 25, Nat.mod_lt _ (by decide)⟩
  have h (b : Fin 40) :
      RowArithmetic.combine pivotInverseRows.toList
        (Rank.pack liftRows[25 * b.val + r.val]!) = 2 ^ (25 * b.val + r.val) := by
    fin_cases b
    · exact Rank.rows00 r
    · exact Rank.rows01 r
    · exact Rank.rows02 r
    · exact Rank.rows03 r
