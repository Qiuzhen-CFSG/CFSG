  simpa only [hi] using h q

/-- The supplied inverse is a right inverse of the literal selected-column minor. -/
theorem pivotMinor_mul_pivotInverse : pivotMinor * pivotInverse = 1 := by
  funext i
  exact Rank.product_one_row i (packed_product i)

/-- Discharge the exact surjectivity premise used by exterior-section descent. -/
theorem U_mulVecLin_surjective : Function.Surjective U.mulVecLin :=
  surjective_of_pivot_certificate pivotMinor_mul_pivotInverse
