@[expose] public section
namespace Representation.HigmanSims.LargeModels.Binary.Large.Exterior1000.Intertwining.BChecks
/-- Every lifted row intertwines the literal second-generator packed products. -/
theorem products (i : Fin 1000) :
    Tables.b.product liftRows[i.val]! = Tables.lifts.product D1000.bRows[i.val]! := by
  let q : Fin 40 := ⟨i.val / 25, by omega⟩
  let r : Fin 25 := ⟨i.val % 25, Nat.mod_lt _ (by decide)⟩
  have h (b : Fin 40) :
      Tables.b.product liftRows[25 * b.val + r.val]! =
        Tables.lifts.product D1000.bRows[25 * b.val + r.val]! := by
    fin_cases b
    · exact rows00 r
    · exact rows01 r
    · exact rows02 r
    · exact rows03 r
