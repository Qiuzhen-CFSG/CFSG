/-- Literal source lift rows, with no change of basis. -/
def U : Matrix (Fin 1000) (Fin 1540) (ZMod 2) :=
  RowArithmetic.matrix 1000 1540 liftRows.toList

/-- The sorted pivot columns recorded in the candidate. -/
def pivotColumn (i : Fin 1000) : Fin 1540 :=
  ⟨if i.val = 0 then 538 else i.val + 540, by
    split
    · decide
    · exact Nat.add_lt_add_right i.isLt 540⟩

def pivotMinor : Matrix (Fin 1000) (Fin 1000) (ZMod 2) :=
  U.submatrix id pivotColumn

def pivotInverse : Matrix (Fin 1000) (Fin 1000) (ZMod 2) :=
  Thompson.BinaryMatrix.decode 1000 pivotInverseRows

