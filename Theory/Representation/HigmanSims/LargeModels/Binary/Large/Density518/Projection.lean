module
public import Theory.Representation.G2DerivedPermutationFiltration.CycleFiltration.MatrixCriterion
public import Mathlib.GroupTheory.OrderOfElement
public import Mathlib.LinearAlgebra.Matrix.NonsingularInverse

/-!
# A finite-algebra alternative to a long projector polynomial

Let D annihilate an idempotent P on both sides. If D + P is invertible in a
finite algebra, some positive power of D + P is 1. Orthogonality gives
(D + P)^m = D^m + P, hence P = 1 - D^m belongs to the algebra generated by D.
For P = u v, the hypotheses are a unit pairing, two null-vector identities,
and one inverse certificate. The degree-518 consumer in `Density518.lean`
applies this to the literal ATLAS density candidates, replacing evaluation
of their degree-517 polynomial by the complementary inverse calculation.

The source data are R. A. Wilson et al., ATLAS HSG1-f2r518B0; see
`Binary/source/README.md` and `Density518/source/README.md`.
-/

@[expose] public section
open Matrix
namespace Representation.HigmanSims.LargeModels.Binary.Large.Density518

theorem orthogonal_idempotent_mem
    {k R : Type*} [CommRing k] [Ring R] [Algebra k R] [Finite R]
    (Q : Subalgebra k R) (D P : R) (hD : D ∈ Q)
    (hDP : D * P = 0) (hPD : P * D = 0) (hPP : P * P = P)
    (hunit : IsUnit (D + P)) : P ∈ Q := by
  obtain ⟨U, hU⟩ := hunit
  obtain ⟨n, hn, hp⟩ := (isOfFinOrder_of_finite U).exists_pow_eq_one
  have hpow : ∀ m : ℕ, (D + P) ^ (m + 1) = D ^ (m + 1) + P := by
    intro m
    induction m with
    | zero => simp
    | succ m ih =>
      have hz : D ^ (m + 1) * P = 0 := by rw [pow_succ, mul_assoc, hDP, mul_zero]
      rw [pow_succ (D + P), ih, add_mul, mul_add, mul_add, hz, hPD, hPP,
        add_zero, zero_add, ← pow_succ]
  obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hn)
  have he : D ^ (m + 1) + P = 1 := by
    rw [← hpow]
    simpa only [Units.val_pow_eq_pow_val, Units.val_one, hU] using congrArg Units.val hp
  have hP : P = 1 - D ^ (m + 1) := by
    apply eq_sub_iff_add_eq.mpr
    rw [add_comm, he]
  rw [hP]
  exact Q.sub_mem Q.one_mem (Q.pow_mem hD _)

theorem rank_one_mem_of_complement_inverse
    {k n : Type*} [Field k] [Finite k] [Fintype n] [DecidableEq n]
    (Q : Subalgebra k (Matrix n n k)) (D E : Matrix n n k) (u v : n → k)
    (hD : D ∈ Q) (hpair : dotProduct v u = 1)
    (hcol : D.mulVec u = 0) (hrow : vecMul v D = 0)
    (hinv : (D + vecMulVec u v) * E = 1) : vecMulVec u v ∈ Q := by
  apply orthogonal_idempotent_mem Q D _ hD
  · rw [mul_vecMulVec, hcol, zero_vecMulVec]
  · rw [vecMulVec_mul, hrow, vecMulVec_zero]
  · rw [vecMulVec_mul_vecMulVec, hpair, one_smul]
  · exact ⟨⟨D + vecMulVec u v, E, hinv, mul_eq_one_comm.mp hinv⟩, rfl⟩

end Representation.HigmanSims.LargeModels.Binary.Large.Density518
