/-- The supplied right inverse of the literal row basis. -/
theorem row_inverse : R * Ri = 1 := Rows.inverse_of_checked checked_0_65

/-- The saved row words evaluate to the saved basis rows. -/
theorem row_orbit : ∀ i, Matrix.vecMul v (rowActor i) = R.row i := by
  have h := Rows.steps_of_checked checked_0_65
  exact row_orbit_of_prefix_steps Rows.parent Rows.letter
    (fun i => (h i).1) row_word_root row_start
    (fun i => (h i).2.1) (fun i => (h i).2.2)

/-- Unconditional row-span input to the degree-518 density criterion. -/
theorem row_span :
    Submodule.span (ZMod 2)
      (Set.range (fun i => Matrix.vecMul v (rowActor i))) = ⊤ :=
  row_span_of_certificates row_orbit row_inverse

