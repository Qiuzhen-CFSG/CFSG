/-!
# The rank-one operator in the degree-518 generator algebra

Kernel-checked packed products establish D = 1 + B² + B³ + (A B²)²,
so the exact saved D belongs to the algebra generated by A and B without
assuming any generator relations. The two null vectors, their unit pairing,
and the checked right inverse of D + u v yield u v in that algebra by the
finite-algebra projection lemma. `RankOne.Consumer` discharges the projector premise of degree-518 density,
retaining only the two independent orbit spans.

Source: R. A. Wilson et al., ATLAS HSG1-f2r518B0, and the literal
`Binary/source/density518.json`. See `RankOne/source/README.md` for attribution,
reproduction and certificate measurements.
-/

public section
namespace Representation.HigmanSims.LargeModels.Binary.Large.Density518
open Matrix Thompson.BinaryMatrix

/-- Membership of the exact stored D, certified without generator relations. -/
theorem d_mem : D ∈ Q := by
  have hB : B ∈ Q := Algebra.subset_adjoin (by simp)
  have hA : A ∈ Q := Algebra.subset_adjoin (by simp)
  have hS : B * B = decode 518 RankOne.squareRows :=
    RankOne.product_of_checked _ _ _ Blocks.b_size RankOne.bSquare_checked
  have hC : decode 518 RankOne.squareRows * B = decode 518 RankOne.cubeRows :=
    RankOne.product_of_checked _ _ _ Blocks.b_size RankOne.bCube_checked
  have hX : A * decode 518 RankOne.squareRows = decode 518 RankOne.mixedRows :=
    RankOne.product_of_checked _ _ _ RankOne.squareRows_size RankOne.mixed_checked
  have hXX := RankOne.square_sum_of_checked RankOne.squareRows RankOne.cubeRows
    RankOne.mixedRows RankOne.mixedRows_size RankOne.mixedSquare_checked
  have hs : decode 518 RankOne.squareRows ∈ Q := hS ▸ Q.mul_mem hB hB
  have hc : decode 518 RankOne.cubeRows ∈ Q := hC ▸ Q.mul_mem hs hB
  have hx : decode 518 RankOne.mixedRows ∈ Q := hX ▸ Q.mul_mem hA hs
  have hd : D = ((decode 518 RankOne.mixedRows * decode 518 RankOne.mixedRows - 1)
      - decode 518 RankOne.cubeRows) - decode 518 RankOne.squareRows := by
    rw [hXX]
    simp only [add_sub_cancel_right]
  rw [hd]
  exact Q.sub_mem (Q.sub_mem (Q.sub_mem (Q.mul_mem hx hx) Q.one_mem) hc) hs

/-- The exact complementary inverse stored in `Data.lean`. -/
theorem complement_inverse : (D + vecMulVec u v) * E = 1 :=
  RankOne.complement_of_checked RankOne.complement_checked

/-- The unconditional projector premise of the degree-518 density criterion. -/
theorem rank_one_mem : vecMulVec u v ∈ Q :=
  rank_one_mem_of_complement_inverse Q D E u v d_mem pair_eq_one
    RankOne.nullColumn RankOne.nullRow complement_inverse

end Representation.HigmanSims.LargeModels.Binary.Large.Density518
