private theorem identity_mem
    (A : Subalgebra (ZMod 2) BinaryMatrix) (_ha : aMatrix ∈ A) (_hb : bMatrix ∈ A) :
    identity ∈ A := by
  rw [identity_eq]
  exact A.one_mem

