private theorem decode_add (a b c : Array ℕ)
    (h : ∀ i : Fin 20, a[i.val]! ^^^ b[i.val]! = c[i.val]!) :
    decode 20 a + decode 20 b = decode 20 c := by
  ext i k
  change bit a[i.val]! k.val + bit b[i.val]! k.val = bit c[i.val]! k.val
  rw [← bit_xor, h i]

