module
public import Theory.Representation.OrthogonalFourPlusMatrix.SylowSingularLine

/-!
# The singular plane generated by one tensor factor

The first SL₂(4) factor generates the matrices with zero first column from
the canonical common fixed line. The other factor commutes with it, so
transporting the line by any tensor element transports the whole plane.
Thus the first-factor orbit of every Sylow fixed line has sixteen elements.

Source: Aschbacher–Smith 9.1.2 and9.2.2(3), combined manuscript,
printed pp.729–731. This is the concrete representation calculation used
by the literal original-group tensor-plane construction.
-/

@[expose] public noncomputable section
open Matrix Representation Representation.BinaryOffender
namespace ClassicalOrthogonal.FourPlusMatrix.Binary

def firstOrbit (U : Submodule (ZMod 2) V) : Submodule (ZMod 2) V :=
  ⨆ g : SpecialLinearGroup (Fin 2) F, U.map (action (g,1))

theorem planeMap_action (g : SpecialLinearGroup (Fin 2) F) (v : Fin 2 → F) :
    planeMap (g.val *ᵥ v) = action (g,1) (planeMap v) := by
  apply Matrix.ext
  intro i j
  fin_cases i <;> fin_cases j <;>
    simp [planeMap,action_apply,Matrix.mul_apply,Matrix.mulVec,dotProduct,Fin.sum_univ_two]

theorem firstOrbit_point_eq_plane : firstOrbit point = plane := by
  apply le_antisymm
  · apply iSup_le
    intro g
    rintro _ ⟨v,⟨c,rfl⟩,rfl⟩
    have hp : pointMap c = planeMap ![c,0] := by rfl
    rw [hp,←planeMap_action]
    exact ⟨_,rfl⟩
  · rintro _ ⟨v,rfl⟩
    have hpoint (c : F) : pointMap c ∈ firstOrbit point := by
      apply (le_iSup (fun g : SpecialLinearGroup (Fin 2) F => point.map (action (g,1))) 1)
      refine ⟨pointMap c,⟨c,rfl⟩,?_⟩
      change action 1 (pointMap c) = pointMap c
      rw [action.map_one]
      rfl
    let u := SpecialLinearGroup.transvection (by decide : (1 : Fin 2) ≠ 0) (1 : F)
    have hu : action (u,1) (pointMap (v 1)) ∈ firstOrbit point :=
      (le_iSup (fun g : SpecialLinearGroup (Fin 2) F => point.map (action (g,1))) u)
        ⟨pointMap (v 1),⟨v 1,rfl⟩,rfl⟩
    have he : planeMap v = pointMap (v 0-v 1) + action (u,1) (pointMap (v 1)) := by
      apply Matrix.ext
      intro i j
      fin_cases i <;> fin_cases j <;>
        simp [u,planeMap,pointMap,action_apply,SpecialLinearGroup.transvection_coe,
          Matrix.mul_apply,Fin.sum_univ_two]
    rw [he]
    exact (firstOrbit point).add_mem (hpoint _) hu

private theorem action_mul_apply (a b : G) (v : V) :
    action (a*b) v = action a (action b v) :=
  congrArg (fun f : Module.End (ZMod 2) V => f v) (action.map_mul a b)

theorem firstOrbit_map (U : Submodule (ZMod 2) V) (g : G) :
    firstOrbit (U.map (action g)) = (firstOrbit U).map (action g) := by
  rw [firstOrbit,firstOrbit,Submodule.map_iSup]
  apply le_antisymm
  · apply iSup_le
    intro a
    rintro _ ⟨_,⟨v,hv,rfl⟩,rfl⟩
    let b := g.1⁻¹*a*g.1
    apply (le_iSup (fun b : SpecialLinearGroup (Fin 2) F =>
      (U.map (action (b,1))).map (action g)) b)
    refine ⟨action (b,1) v,⟨v,hv,rfl⟩,?_⟩
    rw [←action_mul_apply,←action_mul_apply]
    have he : g*(b,1) = (a,1)*g := by
      apply Prod.ext
      · change g.1*(g.1⁻¹*a*g.1) = a*g.1
        group
      · simp
    rw [he]
  · apply iSup_le
    intro b
    rintro _ ⟨_,⟨v,hv,rfl⟩,rfl⟩
    let a := g.1*b*g.1⁻¹
    apply (le_iSup (fun a : SpecialLinearGroup (Fin 2) F =>
      (U.map (action g)).map (action (a,1))) a)
    refine ⟨action g v,⟨v,hv,rfl⟩,?_⟩
    rw [←action_mul_apply,←action_mul_apply]
    have he : (a,1)*g = g*(b,1) := by
      apply Prod.ext
      · change (g.1*b*g.1⁻¹)*g.1 = g.1*b
        group
      · simp
    rw [he]

theorem card_firstOrbit_fixedSpace_sylow (P : Sylow 2 G) :
    Nat.card (firstOrbit (fixedSpace action (P : Subgroup G))) = 16 := by
  obtain ⟨g,hg⟩ := sylow_fixedSpace_conjugate_point P
  rw [hg,firstOrbit_map,firstOrbit_point_eq_plane]
  change Nat.card (plane.map (linearAction g).toLinearMap) = 16
  rw [Nat.card_congr ((linearAction g).submoduleMap plane).toEquiv.symm]
  exact card_plane

end ClassicalOrthogonal.FourPlusMatrix.Binary
