module
public import Theory.Representation.BinaryPlaneNineSection
public import Theory.Representation.OrthogonalFourPlusMatrix.BorelSection
public import Theory.Representation.BinaryOffender.IrreducibleQuotientDiagonal
public import Theory.GroupTheory.NormalSylowQuotientAction

/-!
# Cubic generation of a normalized tensor Borel

For a Sylow two-group normalizing an actual SL₂(4) × SL₂(4) tensor
subgroup, the intersection Sylow has a binary plane of fixed vectors.
Its Borel quotient has order nine and acts nontrivially on that plane.
The cubic kernel and a coprime invariant complement yield two overgroups
of Sylow index three whose common fixed space is zero.

All subgroup normalizers and quotient cores are transported through the
literal inclusions. Only normalization by the Sylow group is required.
This is the specialized tensor argument for Aschbacher–Smith 14.3.15,
using the index-three placement in 14.3.5, printed pp.991–994.
-/

public noncomputable section
open Subgroup Module Representation Representation.BinaryOffender
namespace ClassicalOrthogonal.FourPlusMatrix.Binary
variable {A W : Type*} [Group A] [Finite A] [AddCommGroup W] [Module (ZMod 2) W]
  [FiniteDimensional (ZMod 2) W]

omit [Finite A] in
private theorem mapped_normalizer (L : Subgroup A) (P : Subgroup L) :
    (normalizer (P : Set L)).map L.subtype = L ⊓ normalizer (P.map L.subtype : Set A) := by
  apply le_antisymm
  · exact le_inf (map_subtype_le _) (P.le_normalizer_map L.subtype)
  · intro x hx
    refine ⟨⟨x,hx.1⟩,?_,rfl⟩
    apply mem_normalizer_iff.mpr
    intro y
    have hh := mem_normalizer_iff.mp hx.2 (y:A)
    have hm (z : L) : (z:A) ∈ P.map L.subtype ↔ z ∈ P := by
      constructor
      · rintro ⟨u,hu,heq⟩
        exact (L.subtype_injective heq) ▸ hu
      · exact mem_map_of_mem L.subtype
    exact (hm y).symm.trans (hh.trans (hm (⟨x,hx.1⟩ * y * ⟨x,hx.1⟩⁻¹)))

/-- The Borel of a tensor subgroup is generated by two overgroups of
Sylow index three. Every vector fixed by both is zero. -/
theorem tensor_borel_generation
    (ρ : Representation (ZMod 2) A W) (S : Sylow 2 A)
    (L : Subgroup A) (hSL : (S : Subgroup A) ≤ normalizer (L : Set A))
    (e : L ≃* G) (c : W ≃ₗ[ZMod 2] V)
    (he : ∀ (l : L) w, c (ρ (l:A) w) = action (e l) (c w)) :
    ∃ J₁ J₂ : Subgroup A,
      (S : Subgroup A) ≤ J₁ ∧ (S : Subgroup A) ≤ J₂ ∧
      (S : Subgroup A).relIndex J₁ = 3 ∧ (S : Subgroup A).relIndex J₂ = 3 ∧
      fixedSpace ρ (J₁ ⊔ J₂) = ⊥ := by
  obtain ⟨P,hP⟩ := NormalSylowQuotientAction.intersection_sylow S L hSL
  let Q := (P : Subgroup L).map L.subtype
  have hQ : Q = (S : Subgroup A) ⊓ L := by
    change ((P : Subgroup L).map L.subtype) = _
    rw [hP]
    ext x
    constructor
    · rintro ⟨y,hy,rfl⟩
      exact ⟨hy,y.property⟩
    · intro hx
      exact ⟨⟨x,hx.2⟩,hx.1,rfl⟩
  let N := normalizer (P : Set L)
  let B := N.map L.subtype
  have hB : B = L ⊓ normalizer (Q : Set A) := mapped_normalizer L P
  have hSQ : (S : Subgroup A) ≤ normalizer (Q : Set A) := by
    rw [hQ]
    exact (le_inf (S : Subgroup A).le_normalizer hSL).trans inf_normalizer_le_normalizer_inf
  have hSB : (S : Subgroup A) ≤ normalizer (B : Set A) := by
    rw [hB]
    exact (le_inf hSL (hSQ.trans (normalizer (Q : Set A)).le_normalizer)).trans
      inf_normalizer_le_normalizer_inf
  have hQB : Q ≤ B := by
    rw [hB]
    exact le_inf (map_subtype_le _) Q.le_normalizer
  have hcore : pCore 2 B = (S : Subgroup A).subgroupOf B := by
    obtain ⟨R,hR⟩ := NormalSylowQuotientAction.intersection_sylow S B hSB
    have hRQ : (R : Subgroup B) = Q.subgroupOf B := by
      rw [hR]
      ext x
      change (x:A) ∈ (S : Subgroup A) ↔ (x:A) ∈ Q
      rw [hQ]
      exact ⟨fun hx => ⟨hx,(map_subtype_le N) x.property⟩,fun hx => hx.1⟩
    let : (Q.subgroupOf B).Normal := (normal_subgroupOf_iff_le_normalizer hQB).mpr (hB.le.trans inf_le_right)
    apply le_antisymm
    · rw [←hR]
      exact pCore_isPGroup.le_sylow_of_normal R
    · rw [←hR,hRQ]
      exact le_sSup ⟨inferInstance,hRQ ▸ R.isPGroup'⟩
  let Pm := P.mapSurjective (f := e.toMonoidHom) e.surjective
  have hn : N.map e.toMonoidHom = normalizer (Pm : Set G) := by
    exact P.normalizer_map_surjective e.toMonoidHom e.surjective
  let en : N ≃* normalizer (Pm : Set G) :=
    (N.equivMapOfInjective e.toMonoidHom e.injective).trans (MulEquiv.subgroupCongr hn)
  let eb : N ≃* B := N.equivMapOfInjective L.subtype L.subtype_injective
  let eqb := eb.symm.trans en
  let eqc := eqb.toMonoidHom.pCoreQuotientEquiv (p := 2) eqb.surjective
    (IsPGroup.ker_isPGroup_of_injective eqb.injective)
  let := sylowNormalizer_quotient_elementary Pm
  let : IsElementaryAbelian 3 (B ⧸ pCore 2 B) :=
    IsElementaryAbelian.of_injective (p := 3) eqc.toMonoidHom eqc.injective
  have hc : Nat.card (B ⧸ pCore 2 B) = 9 :=
    (Nat.card_congr eqc.toEquiv).trans (sylowNormalizer_quotient_card Pm)
  have hfixed (D : Subgroup L) (w : W) :
      w ∈ fixedSpace ρ (D.map L.subtype) ↔ c w ∈ fixedSpace action (D.map e.toMonoidHom) := by
    constructor
    · intro hw a
      obtain ⟨d,hd,ha⟩ := a.property
      have hh := congrArg c (hw ⟨d,mem_map_of_mem _ hd⟩)
      change c (ρ (d:A) w) = c w at hh
      rw [he] at hh
      change action (a:G) (c w) = c w
      change e d = (a:G) at ha
      rw [←ha]
      exact hh
    · intro hw a
      obtain ⟨d,hd,ha⟩ := a.property
      apply c.injective
      change c (ρ (a:A) w) = c w
      rw [←ha]
      exact (he d w).trans (hw ⟨e d,mem_map_of_mem _ hd⟩)
  let U := fixedSpace ρ Q
  have hUcard : Nat.card U = 4 := by
    let ef : U ≃ fixedSpace action (Pm : Subgroup G) := {
      toFun w := ⟨c w,(hfixed P w).mp w.property⟩
      invFun w := ⟨c.symm w,(hfixed P _).mpr (by rw [c.apply_symm_apply]; exact w.property)⟩
      left_inv w := Subtype.ext (c.symm_apply_apply w)
      right_inv w := Subtype.ext (c.apply_symm_apply w) }
    exact (Nat.card_congr ef).trans (card_fixedSpace_sylow Pm)
  have hd : finrank (ZMod 2) U = 2 := by
    have hh := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := U)
    rw [hUcard] at hh
    norm_num at hh
    exact Nat.pow_right_injective (by decide : 1 < 2) (hh.symm.trans (by decide : 4 = 2^2))
  have hBW : ∀ b ∈ B, ∀ w ∈ U, ρ b w ∈ U := by
    intro b hb w hw
    exact (normalizer_le_fixedSpace_stabilizer ρ Q ((hB.le hb).2) w).2 hw
  have hSW : ∀ s ∈ (S : Subgroup A), ∀ w ∈ U, ρ s w ∈ U := by
    intro s hs w hw
    exact (normalizer_le_fixedSpace_stabilizer ρ Q (hSQ hs) w).2 hw
  have hcoreW : ∀ b ∈ pCore 2 B, ∀ w ∈ U, ρ (b:A) w = w := by
    intro b hb w hw
    apply hw ⟨b,?_⟩
    rw [hcore] at hb
    rw [hQ]
    exact ⟨hb,(map_subtype_le N) b.property⟩
  have hBfixed : fixedSpace ρ B = ⊥ := by
    apply (Submodule.eq_bot_iff _).mpr
    intro w hw
    have hh := (hfixed N w).mp hw
    rw [hn,sylowNormalizer_fixedSpace] at hh
    exact c.injective (((Submodule.mem_bot (R := ZMod 2)).mp hh).trans c.map_zero.symm)
  have hmove : ∃ b ∈ B, ∃ w ∈ U, ρ b w ≠ w := by
    by_contra hh
    push Not at hh
    have hz : U = ⊥ := by
      apply le_antisymm ?_ bot_le
      rw [←hBfixed]
      intro w hw b
      exact hh b b.property w hw
    rw [hz,finrank_bot] at hd
    omega
  obtain ⟨D,hD,hDi⟩ := Representation.BinaryPlane.nine_section_invariant_cubic
    ρ S B hSB hc U hd hBW hSW hcoreW hmove
  obtain ⟨J₁,J₂,hS₁,hS₂,_,_,hi₁,hi₂,hgen⟩ :=
    nine_section_cubic_generation S B hSB hcore hc D hD hDi
  refine ⟨J₁,J₂,hS₁,hS₂,hi₁,hi₂,?_⟩
  apply (Submodule.eq_bot_iff _).mpr
  intro w hw
  have hb : w ∈ fixedSpace ρ B := fun b => hw ⟨b,hgen b.property⟩
  rw [hBfixed] at hb
  exact (Submodule.mem_bot (R := ZMod 2)).mp hb
end ClassicalOrthogonal.FourPlusMatrix.Binary
