module

public import Mathlib.RepresentationTheory.Invariants
public import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-!
# Fixed spaces and generated subgroups

The fixed space of the subgroup generated by two subgroups is the intersection
of their fixed spaces. If both contain a common subgroup, the dimension formula
in its fixed space gives a lower bound for that intersection. When the whole
group has no fixed vectors, a positive lower bound proves that the generated
subgroup is proper.

This is the linear-algebra argument used by Wong, “On finite groups whose
2-Sylow subgroups have cyclic subgroups of index 2” (1964), pp.107 and 110.
It does not require an irreducible representation or a finite group.
-/

namespace Representation

variable {F G V : Type*} [Field F] [Group G] [AddCommGroup V] [Module F V]
  (ρ : Representation F G V)

/-- Restricting to a smaller subgroup enlarges the fixed space. -/
public theorem invariants_comp_subtype_antitone {H K : Subgroup G} (h : H ≤ K) :
    invariants (ρ.comp K.subtype) ≤ invariants (ρ.comp H.subtype) := by
  intro v hv g
  exact hv ⟨g, h g.property⟩

/-- The fixed space of a generated subgroup is the intersection of fixed spaces. -/
public theorem invariants_comp_sup (H K : Subgroup G) :
    invariants (ρ.comp (H ⊔ K).subtype) =
      invariants (ρ.comp H.subtype) ⊓ invariants (ρ.comp K.subtype) := by
  apply le_antisymm
  · exact le_inf (ρ.invariants_comp_subtype_antitone le_sup_left)
      (ρ.invariants_comp_subtype_antitone le_sup_right)
  · intro v hv
    let D : Subgroup G := {
      carrier := {g | ρ g v = v}
      one_mem' := by simp
      mul_mem' := by
        intro a b ha hb
        change ρ (a * b) v = v
        rw [map_mul, Module.End.mul_apply, hb, ha]
      inv_mem' := by
        intro a ha
        change ρ a⁻¹ v = v
        calc
          ρ a⁻¹ v = ρ a⁻¹ (ρ a v) := congrArg (ρ a⁻¹) ha.symm
          _ = v := by rw [← Module.End.mul_apply, ← map_mul, inv_mul_cancel]; simp }
    have hD : H ⊔ K ≤ D := sup_le (fun g hg => hv.1 ⟨g, hg⟩)
      (fun g hg => hv.2 ⟨g, hg⟩)
    intro g
    exact hD g.property

/-- A common subgroup bounds the dimension of the sum of two fixed spaces. -/
public theorem finrank_invariants_sup_lower_bound [FiniteDimensional F V]
    (H K T : Subgroup G) (hTH : T ≤ H) (hTK : T ≤ K) :
    Module.finrank F (invariants (ρ.comp H.subtype)) +
        Module.finrank F (invariants (ρ.comp K.subtype)) ≤
      Module.finrank F (invariants (ρ.comp T.subtype)) +
        Module.finrank F (invariants (ρ.comp (H ⊔ K).subtype)) := by
  rw [ρ.invariants_comp_sup]
  rw [← Submodule.finrank_sup_add_finrank_inf_eq]
  exact Nat.add_le_add_right (Submodule.finrank_mono
    (sup_le (ρ.invariants_comp_subtype_antitone hTH)
      (ρ.invariants_comp_subtype_antitone hTK))) _

/-- Overlapping fixed spaces force the generated subgroup to be proper when
the whole representation has no fixed vectors. -/
public theorem sup_ne_top_of_invariants_dimension [FiniteDimensional F V]
    (hρ : invariants ρ = ⊥) (H K T : Subgroup G) (hTH : T ≤ H) (hTK : T ≤ K)
    (hdim : Module.finrank F (invariants (ρ.comp T.subtype)) <
      Module.finrank F (invariants (ρ.comp H.subtype)) +
        Module.finrank F (invariants (ρ.comp K.subtype))) : H ⊔ K ≠ ⊤ := by
  intro htop
  have hbound := ρ.finrank_invariants_sup_lower_bound H K T hTH hTK
  have hfixed : invariants (ρ.comp (H ⊔ K).subtype) = invariants ρ := by
    rw [htop]
    ext v
    exact ⟨fun hv g => hv ⟨g, Subgroup.mem_top g⟩, fun hv g => hv g⟩
  rw [hfixed, hρ, finrank_bot] at hbound
  exact (not_lt_of_ge (by simpa only [add_zero] using hbound)) hdim

end Representation
