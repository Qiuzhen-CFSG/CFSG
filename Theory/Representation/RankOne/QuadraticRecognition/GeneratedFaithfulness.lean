module
public import Theory.Representation.RankOne.QuadraticRecognition.SmallCentralizer
public import Theory.SpecificGroups.SU3.Quasisimplicity
public import Theory.GroupTheory.GeneralizedFitting.QuasisimpleCore

/-!
# Faithfulness of fixed-generated quadratic reductions

If a quadratic actor normally generates G, the quotient by the submodule
generated by its fixed vectors is trivial. The kernel on that submodule
therefore acts quadratically on the original vectors. Faithfulness makes
this kernel elementary abelian of exponent two, so a trivial two-core
makes the restricted representation faithful.

For SU₃ and PSU₃ in the binary simple range, quasisimplicity puts the
two-core in the center. The special scalar kernel has exponent three,
and the projective center is trivial; hence both actual carriers have
trivial two-core. This removes the auxiliary vector-generation premise
from the unitary individual-element bound in UnitaryElementBounds.

Source: DGS85, Groups and Graphs, minimal-module reduction in (5.10),
pp.110–111. Carrier properties use Huppert II.10.12–13.
-/

public noncomputable section
open Subgroup Representation.BinaryOffender
namespace Representation.RankOne.QuadraticRecognition
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]

/-- The fixed-generated reduction preserves faithfulness when the actor
normally generates and the ambient two-core is trivial. -/
theorem fixedGenerated_faithful_of_twoCore_eq_bot
    (ρ : Representation (ZMod 2) G V) (hf : Function.Injective ρ)
    (A : Subgroup G) (hq : IsQuadratic ρ A) (hgen : normalClosure (A : Set G)=⊤)
    (hcore : pCore 2 G=⊥) :
    Function.Injective (fixedGeneratedSubrepresentation ρ A).toRepresentation := by
  let W := fixedGeneratedSubrepresentation ρ A
  have hAk : A≤W.quotientRepresentation.ker := by
    intro a ha
    apply LinearMap.ext
    intro v
    induction v using Submodule.Quotient.induction_on with
    | _ v =>
      apply (Submodule.Quotient.eq W.toSubmodule).mpr
      exact fixedSpace_le_fixedGenerated ρ A (fun b => hq b b.property a ha v)
  have htop : (⊤ : Subgroup G)≤W.quotientRepresentation.ker := by
    rw [←hgen]
    exact normalClosure_le_normal hAk
  have hd (g : G) (v : V) : ρ g v-v∈W.toSubmodule :=
    (Submodule.Quotient.eq W.toSubmodule).mp (LinearMap.congr_fun (htop (mem_top g))
      (W.toSubmodule.mkQ v))
  have hqK : IsQuadratic ρ W.toRepresentation.ker := by
    intro a ha b hb v
    exact congrArg Subtype.val (LinearMap.congr_fun ha ⟨ρ b v-v,hd b v⟩)
  let : IsElementaryAbelian 2 W.toRepresentation.ker :=
    elementary_of_faithful_quadratic ρ hf W.toRepresentation.ker hqK
  have hK : W.toRepresentation.ker≤pCore 2 G :=
    le_sSup ⟨inferInstance,IsElementaryAbelian.isPGroup 2 W.toRepresentation.ker⟩
  exact (MonoidHom.ker_eq_bot_iff _).mp (bot_unique (hK.trans hcore.le))

open BenderSuzuki.MatrixGroups BenderSuzuki.External Theory.GroupTheory
variable {F : Type*} [Field F] [Finite F]
private instance finiteProjective (J : HermitianForm 3 F) :
    Finite (ProjectiveSpecialUnitaryMatrixGroup J) :=
  Finite.of_surjective J.specialToProjective J.specialToProjective_surjective

private theorem projective_center_eq_bot (J : HermitianForm 3 F)
    {n : ℕ} (hn : 2≤n) (hcard : Nat.card F=(2^n)^2)
    (hconj : ∀ x, J.conj x=x^(2^n)) : center (ProjectiveSpecialUnitaryMatrixGroup J)=⊥ := by
  have hfixed := FiniteField.card_fixed_of_quadratic_frobenius J.conj 2 n (by omega) hcard hconj
  have hq : 2<2^n := (by decide : 2<2^2).trans_le (Nat.pow_le_pow_right (by decide) hn)
  let : IsSimpleGroup (ProjectiveSpecialUnitaryMatrixGroup J) := huppert_II_10_13 J (2^n) hq hcard hfixed
  let := SU3.BinaryDegree.isPerfect_projective J hn hcard hconj
  rcases (inferInstance : (center (ProjectiveSpecialUnitaryMatrixGroup J)).Normal).eq_bot_or_eq_top with hb|ht
  · exact hb
  · exact (Group.IsPerfect.not_isMulCommutative _ (center_eq_top_iff.mp ht)).elim

/-- The actual special unitary group has trivial two-core; its scalar
kernel has odd order and is not silently removed from the carrier. -/
theorem su3_twoCore_eq_bot (J : HermitianForm 3 F)
    {n : ℕ} (hn : 2≤n) (hcard : Nat.card F=(2^n)^2)
    (hconj : ∀ x, J.conj x=x^(2^n)) : pCore 2 J.specialSubgroup=⊥ := by
  have hfixed := FiniteField.card_fixed_of_quadratic_frobenius J.conj 2 n (by omega) hcard hconj
  have hq : 2<2^n := (by decide : 2<2^2).trans_le (Nat.pow_le_pow_right (by decide) hn)
  let := J.special_isQuasisimple_of_fixed_card hq hcard hfixed
  have hle : pCore 2 J.specialSubgroup≤J.specialToProjective.ker := by
    rw [J.specialToProjective_ker_eq_center (projective_center_eq_bot J hn hcard hconj)]
    exact IsQuasisimple.pCore_le_center 2
  apply bot_unique
  intro x hx
  let a : pCore 2 J.specialSubgroup := ⟨x,hx⟩
  have hp : Nat.Coprime (orderOf a) 3 := pCore_isPGroup.orderOf_coprime (by decide) a
  have hx3 : x^3=1 := congrArg Subtype.val (J.specialToProjective_ker_cube ⟨x,hle hx⟩)
  have h3 : a^3=1 := Subtype.ext hx3
  have ho : orderOf a=1 := Nat.eq_one_of_dvd_coprimes hp (dvd_refl _) (orderOf_dvd_of_pow_eq_one h3)
  exact congrArg Subtype.val (orderOf_eq_one_iff.mp ho)

/-- The actual projective unitary carrier also has trivial two-core. -/
theorem psu3_twoCore_eq_bot (J : HermitianForm 3 F)
    {n : ℕ} (hn : 2≤n) (hcard : Nat.card F=(2^n)^2)
    (hconj : ∀ x, J.conj x=x^(2^n)) : pCore 2 (ProjectiveSpecialUnitaryMatrixGroup J)=⊥ := by
  have hfixed := FiniteField.card_fixed_of_quadratic_frobenius J.conj 2 n (by omega) hcard hconj
  have hq : 2<2^n := (by decide : 2<2^2).trans_le (Nat.pow_le_pow_right (by decide) hn)
  let := J.projective_isQuasisimple_of_fixed_card hq hcard hfixed
  exact bot_unique ((IsQuasisimple.pCore_le_center 2).trans
    (projective_center_eq_bot J hn hcard hconj).le)
end Representation.RankOne.QuadraticRecognition
