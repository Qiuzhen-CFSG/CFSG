module
public import Theory.Representation.RankOne.QuadraticRecognition.SchurTorus
public import Theory.Representation.RankOne.QuadraticRecognition.UnitaryMovingTorus
public import Theory.Representation.RankOne.QuadraticRecognition.GeneratedFaithfulness

/-!
# Individual-element bounds in binary unitary modules

For the actual SU3 and PSU3 central-root actors, a small fixed-space index
forces a fixed vector for a carefully chosen norm-one torus power on the
central quotient of the fixed-generated SL₂ block. The torus displacement
argument makes that power fixed-free, giving the contradiction. In SU₃,
faithfulness also excludes the cubic scalar branch; fixed-generated
faithfulness is derived from the trivial two-core of the actual carriers.
The Schur-field argument includes the exceptional field order eight.

Source: DGS85, *Groups and Graphs*, (5.10)(b), printed pp.111–112. The
literal critical-module transfers are in `ModuleApplications.CriticalMovingTorus`.
-/

public noncomputable section
open Matrix Subgroup Representation.BinaryOffender
open BenderSuzuki.MatrixGroups BenderSuzuki.External
open HermitianForm.BorelTorus.EvenCenterAction HermitianForm.EvenInner
open Representation.SU3.CubicDegree.InnerActors.ThreeRoots
open scoped MatrixGroups
namespace Representation.RankOne.QuadraticRecognition
variable {F : Type*} [Field F] [CharP F 2] [Finite F]
variable (J : HermitianForm 3 F) (hJ : J.form=!![0,0,1;0,1,0;1,0,0])

omit [CharP F 2] in
private theorem normOne_generator_power_nontrivial
    {n : ℕ} (hn : 2≤n) (hcard : Nat.card F=(2^n)^2)
    (hconj : ∀ x, J.conj x=x^(2^n)) :
    ∃ k : normOne J, k^(2^n+1)=1 ∧ (k^(2^n-1))^3≠1 := by
  obtain ⟨k,hk⟩ := IsCyclic.exists_ofOrder_eq_natCard (α := normOne J)
  rw [normOne_card J hcard hconj] at hk
  refine ⟨k,by rw [←hk]; exact pow_orderOf_eq_one k,?_⟩
  intro h
  rw [←pow_mul] at h
  have hd := orderOf_dvd_of_pow_eq_one h
  rw [hk] at hd
  have hq : 4≤2^n := by
    exact (show 4=2^2 by decide) ▸ Nat.pow_le_pow_right (by decide) hn
  have h6 : 2^n+1∣6 := by
    have he := Nat.dvd_sub (dvd_mul_right (2^n+1) 3) hd
    have hs : (2^n+1)*3-(2^n-1)*3=6 := by omega
    exact hs ▸ he
  by_cases hn2 : n=2
  · subst n
    norm_num at h6
  · have h8 : 8≤2^n := by
      exact (show 8=2^3 by decide) ▸ Nat.pow_le_pow_right (by decide) (by omega : 3≤n)
    have hl := Nat.le_of_dvd (by decide : 0<6) h6
    omega

private theorem embedded_schur_fixed_vector
    {K D V : Type*} [Field K] [Finite K] [CharP K 2] [Group D]
    [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (ρ : Representation (ZMod 2) D V) (hf : Function.Injective ρ) (j : SL(2,K) →* D)
    {n : ℕ} (hn : 2≤n) (hK : Nat.card K=2^n)
    (A : Subgroup D) (hAr : A≤j.range) (hq : IsQuadratic ρ A)
    (t : D) (ht : t∈A) (ht1 : t≠1)
    (hd : let W := fixedGeneratedSubrepresentation (ρ.comp j) (A.comap j)
      Module.finrank (ZMod 2) (W.toSubmodule ⧸ fixedSpace W.toRepresentation ⊤)<4*n)
    (k : D) (hc : ∀ g, k*j g=j g*k) {m : ℕ} (hm : 0<m) (hkp : k^m=1) :
    ∃ v∈(fixedGeneratedSubrepresentation (ρ.comp j) (A.comap j)).toSubmodule,
      v∉fixedSpace (ρ.comp j) ⊤ ∧ ρ (k^(2^n-1)) v-v∈fixedSpace (ρ.comp j) ⊤ := by
  have hlarge : 3<Nat.card K := by
    rw [hK]
    have hh := Nat.pow_le_pow_right (by decide : 1≤(2:ℕ)) hn
    norm_num at hh
    omega
  let : Group.IsPerfect SL(2,K) := SL2SylowFixedRecognition.perfect (by omega)
  let : IsSimpleGroup PSL(2,K) := ProjectiveSpecialLinearGroup.rank_two_simple (by omega)
  let : IsSimpleGroup SL(2,K) := (Matrix.SpecialLinearGroup.TwoConjugateWitness.slEquivPSL K).isSimpleGroup
  let B := A.comap j
  have hcl : normalClosure (B : Set SL(2,K))=⊤ := by
    apply normalClosure_normal.eq_bot_or_eq_top.resolve_left
    intro hb
    obtain ⟨t₀,ht₀⟩ := hAr ht
    have hh : t₀∈normalClosure (B : Set SL(2,K)) := subset_normalClosure (show j t₀∈A from ht₀.symm ▸ ht)
    rw [hb,mem_bot] at hh
    exact ht1 (ht₀.symm.trans (hh ▸ j.map_one))
  have hqB : IsQuadratic (ρ.comp j) B := fun a ha b hb v => hq (j a) ha (j b) hb v
  have hTc (g : SL(2,K)) (v : V) :
      ρ k ((ρ.comp j) g v)=(ρ.comp j) g (ρ k v) := by
    change ρ k (ρ (j g) v)=ρ (j g) (ρ k v)
    rw [←Module.End.mul_apply,←map_mul,hc,map_mul,Module.End.mul_apply]
  have hTp : (ρ k)^m=1 := by rw [←map_pow,hkp,map_one]
  obtain ⟨t₀,ht₀⟩ := hAr ht
  have hnt : ∃ g, (ρ.comp j) g≠1 :=
    ⟨t₀,fun he => ht1 (ht₀.symm.trans (hf (he.trans ρ.map_one.symm)))⟩
  simpa only [map_pow] using sl2_fixedGenerated_power_has_fixed_vector (ρ.comp j) hnt B hqB hcl
    (by omega) hK hd (ρ k) hTc hm hTp

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V] [Finite V]

/-- The complete unitary element bound for modules generated by the actor
fixed space, with the actual fixed-field block and every binary field degree. -/
theorem su3_root_element_fixedCodim_lower_of_generated
    {n : ℕ} (hn : 2≤n) (hcard : Nat.card F=(2^n)^2)
    (hconj : ∀ x, J.conj x=x^(2^n))
    (ρ : Representation (ZMod 2) J.specialSubgroup V) (hf : Function.Injective ρ)
    (A : Subgroup J.specialSubgroup) (hA : A≤central J hJ) (hAc : 4≤Nat.card A)
    (hq : IsQuadratic ρ A) (hgen : GeneratedByFixedSpace ρ A)
    (t : J.specialSubgroup) (ht : t∈A) (ht1 : t≠1) :
    2*n≤fixedCodim ρ (zpowers t) := by
  by_contra! hsmall
  have hF : Nat.card (fixedField J)=2^n :=
    FiniteField.card_fixed_of_quadratic_frobenius J.conj 2 n (by omega) hcard hconj
  have hd := (su3_root_fixedGenerated_reduction J hJ (by omega) hcard hconj
    ρ A hA hAc hq t ht ht1).2
  have hd' : let W := fixedGeneratedSubrepresentation (ρ.comp (block J hJ)) (A.comap (block J hJ))
      Module.finrank (ZMod 2) (W.toSubmodule ⧸ fixedSpace W.toRepresentation ⊤)<4*n := by
    dsimp only at hd ⊢
    omega
  obtain ⟨k,hpow,hcube⟩ := normOne_generator_power_nontrivial J hn hcard hconj
  have hp : (hermitianTorusSU J hJ k.val)^(2^n+1)=1 := by
    exact (map_pow ((hermitianTorusSU J hJ).comp (normOne J).subtype) k _).symm.trans
      (by rw [hpow,map_one])
  obtain ⟨v,hv,hv0,he⟩ := embedded_schur_fixed_vector ρ hf (block J hJ) hn hF A
    (hA.trans (su3_central_le_block J hJ)) hq t ht ht1 hd'
    (hermitianTorusSU J hJ k.val) (su3_normOne_commutes_block J hJ k) (by positivity) hp
  have hfree := su3_small_element_torus_fixed_free J hJ hn hcard hconj ρ
    ⟨t,fun he => ht1 (hf (he.trans ρ.map_one.symm))⟩ A hA hAc hq hgen t ht ht1 hsmall
    (k^(2^n-1)) hcube
  apply hv0 (hfree v hv ?_)
  simpa only [Subgroup.coe_pow,map_pow] using he

/-- The complete unitary element bound for modules generated by the actor
fixed space, with the actual fixed-field block and every binary field degree. -/
theorem psu3_root_element_fixedCodim_lower_of_generated
    {n : ℕ} (hn : 2≤n) (hcard : Nat.card F=(2^n)^2)
    (hconj : ∀ x, J.conj x=x^(2^n))
    (ρ : Representation (ZMod 2) (ProjectiveSpecialUnitaryMatrixGroup J) V) (hf : Function.Injective ρ)
    (A : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J)) (hA : A≤centralImage J hJ) (hAc : 4≤Nat.card A)
    (hq : IsQuadratic ρ A) (hgen : GeneratedByFixedSpace ρ A)
    (t : (ProjectiveSpecialUnitaryMatrixGroup J)) (ht : t∈A) (ht1 : t≠1) :
    2*n≤fixedCodim ρ (zpowers t) := by
  by_contra! hsmall
  have hF : Nat.card (fixedField J)=2^n :=
    FiniteField.card_fixed_of_quadratic_frobenius J.conj 2 n (by omega) hcard hconj
  have hd := (psu3_root_fixedGenerated_reduction J hJ (by omega) hcard hconj
    ρ A hA hAc hq t ht ht1).2
  have hd' : let W := fixedGeneratedSubrepresentation (ρ.comp (J.specialToProjective.comp (block J hJ))) (A.comap (J.specialToProjective.comp (block J hJ)))
      Module.finrank (ZMod 2) (W.toSubmodule ⧸ fixedSpace W.toRepresentation ⊤)<4*n := by
    dsimp only at hd ⊢
    omega
  obtain ⟨k,hpow,hcube⟩ := normOne_generator_power_nontrivial J hn hcard hconj
  have hp : (normOneMap J hJ k)^(2^n+1)=1 := by rw [←map_pow,hpow,map_one]
  obtain ⟨v,hv,hv0,he⟩ := embedded_schur_fixed_vector ρ hf (J.specialToProjective.comp (block J hJ)) hn hF A
    (hA.trans (psu3_central_le_block J hJ)) hq t ht ht1 hd'
    (normOneMap J hJ k) (psu3_normOne_commutes_block J hJ k) (by positivity) hp
  have hfree := psu3_small_element_torus_fixed_free J hJ hn hcard hconj ρ
    ⟨t,fun he => ht1 (hf (he.trans ρ.map_one.symm))⟩ A hA hAc hq hgen t ht ht1 hsmall
    (k^(2^n-1)) (fun he => hcube ((normOneMap_eq_one_iff J hJ _).mp he))
  apply hv0 (hfree v hv ?_)
  simpa only [Subgroup.coe_pow,map_pow] using he

private theorem normally_generates_of_three {D : Type*} [Group D]
    (A : Subgroup D) (g h : D)
    (he : A ⊔ A.map (MulAut.conj g).toMonoidHom ⊔ A.map (MulAut.conj h).toMonoidHom=⊤) :
    normalClosure (A : Set D)=⊤ := by
  have hn (g : D) : A.map (MulAut.conj g).toMonoidHom≤normalClosure (A : Set D) := by
    rintro _ ⟨a,ha,rfl⟩
    exact normalClosure_normal.conj_mem a (subset_normalClosure ha) g
  apply top_unique
  rw [←he]
  exact sup_le (sup_le subset_normalClosure (hn g)) (hn h)

/-- DGS (5.10)(b), special-unitary branch, without a vector-generation
hypothesis. The actor is the literal central-root subgroup and t its
specified nonidentity element. -/
theorem su3_root_element_fixedCodim_lower
    {n : ℕ} (hn : 2≤n) (hcard : Nat.card F=(2^n)^2)
    (hconj : ∀ x, J.conj x=x^(2^n))
    (ρ : Representation (ZMod 2) J.specialSubgroup V) (hf : Function.Injective ρ)
    (A : Subgroup J.specialSubgroup) (hA : A≤central J hJ) (hAc : 4≤Nat.card A)
    (hq : IsQuadratic ρ A)
    (t : J.specialSubgroup) (ht : t∈A) (ht1 : t≠1) :
    2*n≤fixedCodim ρ (zpowers t) := by
  let W := fixedGeneratedSubrepresentation ρ A
  obtain ⟨g,h,he⟩ := su3_root_three_conjugates J hJ hn hcard hconj A hA hAc
  have hfw := fixedGenerated_faithful_of_twoCore_eq_bot ρ hf A hq
    (normally_generates_of_three A g h he) (su3_twoCore_eq_bot J hn hcard hconj)
  have hqw : IsQuadratic W.toRepresentation A := by
    intro a ha b hb v
    apply Subtype.ext
    exact hq a ha b hb v
  have hl := su3_root_element_fixedCodim_lower_of_generated J hJ hn hcard hconj
    W.toRepresentation hfw A hA hAc hqw (fixedGenerated_generated ρ A) t ht ht1
  exact hl.trans (fixedCodim_subrepresentation_le ρ W (zpowers t))

/-- The source bound on the original fixed quotient, including q=8. -/
theorem su3_root_element_field_index
    {n : ℕ} (hn : 2≤n) (hcard : Nat.card F=(2^n)^2)
    (hconj : ∀ x, J.conj x=x^(2^n))
    (ρ : Representation (ZMod 2) J.specialSubgroup V) (hf : Function.Injective ρ)
    (A : Subgroup J.specialSubgroup) (hA : A≤central J hJ) (hAc : 4≤Nat.card A)
    (hq : IsQuadratic ρ A)
    (t : J.specialSubgroup) (ht : t∈A) (ht1 : t≠1) :
    2^(2*n)≤Nat.card (V ⧸ fixedSpace ρ (zpowers t)) := by
  have hd := su3_root_element_fixedCodim_lower J hJ hn hcard hconj ρ hf A hA hAc hq t ht ht1
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod]
  exact Nat.pow_le_pow_right (by decide) hd

/-- DGS (5.10)(b), projective-unitary branch, without a vector-generation
hypothesis. The actor is the literal central-root subgroup and t its
specified nonidentity element. -/
theorem psu3_root_element_fixedCodim_lower
    {n : ℕ} (hn : 2≤n) (hcard : Nat.card F=(2^n)^2)
    (hconj : ∀ x, J.conj x=x^(2^n))
    (ρ : Representation (ZMod 2) (ProjectiveSpecialUnitaryMatrixGroup J) V) (hf : Function.Injective ρ)
    (A : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J)) (hA : A≤centralImage J hJ) (hAc : 4≤Nat.card A)
    (hq : IsQuadratic ρ A)
    (t : (ProjectiveSpecialUnitaryMatrixGroup J)) (ht : t∈A) (ht1 : t≠1) :
    2*n≤fixedCodim ρ (zpowers t) := by
  let W := fixedGeneratedSubrepresentation ρ A
  obtain ⟨g,h,he⟩ := psu3_root_three_conjugates J hJ hn hcard hconj A hA hAc
  have hfw := fixedGenerated_faithful_of_twoCore_eq_bot ρ hf A hq
    (normally_generates_of_three A g h he) (psu3_twoCore_eq_bot J hn hcard hconj)
  have hqw : IsQuadratic W.toRepresentation A := by
    intro a ha b hb v
    apply Subtype.ext
    exact hq a ha b hb v
  have hl := psu3_root_element_fixedCodim_lower_of_generated J hJ hn hcard hconj
    W.toRepresentation hfw A hA hAc hqw (fixedGenerated_generated ρ A) t ht ht1
  exact hl.trans (fixedCodim_subrepresentation_le ρ W (zpowers t))

/-- The source bound on the original fixed quotient, including q=8. -/
theorem psu3_root_element_field_index
    {n : ℕ} (hn : 2≤n) (hcard : Nat.card F=(2^n)^2)
    (hconj : ∀ x, J.conj x=x^(2^n))
    (ρ : Representation (ZMod 2) (ProjectiveSpecialUnitaryMatrixGroup J) V) (hf : Function.Injective ρ)
    (A : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J)) (hA : A≤centralImage J hJ) (hAc : 4≤Nat.card A)
    (hq : IsQuadratic ρ A)
    (t : (ProjectiveSpecialUnitaryMatrixGroup J)) (ht : t∈A) (ht1 : t≠1) :
    2^(2*n)≤Nat.card (V ⧸ fixedSpace ρ (zpowers t)) := by
  have hd := psu3_root_element_fixedCodim_lower J hJ hn hcard hconj ρ hf A hA hAc hq t ht ht1
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod]
  exact Nat.pow_le_pow_right (by decide) hd

