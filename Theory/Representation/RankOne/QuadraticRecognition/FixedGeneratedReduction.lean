module

public import Theory.Representation.RankOne.QuadraticRecognition.SL2PairGeneration
public import Theory.Representation.BinaryOffender.SectionLinear

/-!
# The fixed-generated local SL₂ reduction

For a binary representation and a quadratic actor `A`, this module packages the
actual subrepresentation generated by the translates of `C_V(A)`.  The actor
fixed space generates that subrepresentation by construction, and restriction
of the quadratic action is literal.  When `A` lies in a Sylow 2-subgroup and
contains a nonidentity element `t`, the defining-field SL₂ pair theorem gives
`C_W(A) = C_W(t)` on this subrepresentation.  The central quotient of `W` is
therefore bounded by twice the ambient fixed codimension of `t`.

This is the local module reduction at the start of DGS85 (5.10)(b), printed
pp.110–112.  The subsequent unitary torus argument is kept at the source
adapter layer because it uses the particular SU₃/PSU₃ tori and the small-actor
generation argument.
-/

public noncomputable section
open Subgroup Representation.BinaryOffender
open scoped MatrixGroups
namespace Representation.RankOne.QuadraticRecognition

variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]

@[expose] public def fixedGeneratedSubrepresentation
    (ρ : Representation (ZMod 2) G V) (A : Subgroup G) : Subrepresentation ρ where
  toSubmodule := ⨆ g : G, (fixedSpace ρ A).map (ρ g)
  apply_mem_toSubmodule a v hv := by
    have hs : (⨆ g : G, (fixedSpace ρ A).map (ρ g)).map (ρ a) ≤
        ⨆ g : G, (fixedSpace ρ A).map (ρ g) := by
      rw [Submodule.map_iSup]
      apply iSup_le
      intro g
      rw [← Submodule.map_comp]
      change (fixedSpace ρ A).map (ρ a * ρ g) ≤ _
      rw [← map_mul]
      exact le_iSup (fun g : G => (fixedSpace ρ A).map (ρ g)) (a * g)
    exact hs ⟨v, hv, rfl⟩

public theorem fixedSpace_le_fixedGenerated
    (ρ : Representation (ZMod 2) G V) (A : Subgroup G) :
    fixedSpace ρ A ≤ (fixedGeneratedSubrepresentation ρ A).toSubmodule := by
  change fixedSpace ρ A ≤ ⨆ g : G, (fixedSpace ρ A).map (ρ g)
  have h := le_iSup (fun g : G => (fixedSpace ρ A).map (ρ g)) 1
  simpa only [map_one, show (1 : Module.End (ZMod 2) V) = LinearMap.id from rfl,
    Submodule.map_id] using h

public theorem fixedGenerated_le
    (ρ : Representation (ZMod 2) G V) (A : Subgroup G) (W : Subrepresentation ρ)
    (h : fixedSpace ρ A ≤ W.toSubmodule) :
    fixedGeneratedSubrepresentation ρ A ≤ W := by
  change (⨆ g : G, (fixedSpace ρ A).map (ρ g)) ≤ W.toSubmodule
  apply iSup_le
  intro g
  rintro _ ⟨v, hv, rfl⟩
  exact W.apply_mem_toSubmodule g (h hv)

public theorem fixedGenerated_generated
    (ρ : Representation (ZMod 2) G V) (A : Subgroup G) :
    GeneratedByFixedSpace (fixedGeneratedSubrepresentation ρ A).toRepresentation A := by
  let W := fixedGeneratedSubrepresentation ρ A
  let U := ⨆ g : G, (fixedSpace W.toRepresentation A).map (W.toRepresentation g)
  change U = ⊤
  apply top_unique
  intro w _
  have hW : W.toSubmodule ≤ U.map W.toSubmodule.subtype := by
    change (⨆ g : G, (fixedSpace ρ A).map (ρ g)) ≤ _
    apply iSup_le
    intro g
    rintro _ ⟨v, hv, rfl⟩
    let v' : W.toSubmodule := ⟨v, fixedSpace_le_fixedGenerated ρ A hv⟩
    have hv' : v' ∈ fixedSpace W.toRepresentation A :=
      fun a => Subtype.ext (hv a)
    exact ⟨W.toRepresentation g v',
      (le_iSup (fun g : G =>
        (fixedSpace W.toRepresentation A).map (W.toRepresentation g)) g)
        ⟨v', hv', rfl⟩, rfl⟩
  obtain ⟨u, hu, he⟩ := hW w.property
  have he' : u = w := Subtype.ext he
  exact he' ▸ hu

public theorem fixedGenerated_map_le_of_commutes
    (ρ : Representation (ZMod 2) G V) (A : Subgroup G) (T : V →ₗ[ZMod 2] V)
    (hc : ∀ g v, T (ρ g v) = ρ g (T v)) :
    (fixedGeneratedSubrepresentation ρ A).toSubmodule.map T ≤
      (fixedGeneratedSubrepresentation ρ A).toSubmodule := by
  change (⨆ g : G, (fixedSpace ρ A).map (ρ g)).map T ≤ _
  rw [Submodule.map_iSup]
  apply iSup_le
  intro g
  rintro _ ⟨_, ⟨v, hv, rfl⟩, rfl⟩
  rw [hc]
  refine (le_iSup (fun g : G => (fixedSpace ρ A).map (ρ g)) g) ⟨T v, ?_, rfl⟩
  intro a
  change ρ a (T v) = T v
  calc
    ρ a (T v) = T (ρ a v) := (hc a v).symm
    _ = T v := congrArg T (hv a)

variable {F : Type*} [Field F] [Finite F] [CharP F 2]

public theorem sl2_fixedGenerated_inter_fixedSpace_eq
    (ρ : Representation (ZMod 2) SL(2, F) V)
    {n : ℕ} (hn : 0 < n) (hF : Nat.card F = 2 ^ n)
    (S : Sylow 2 SL(2, F)) (A : Subgroup SL(2, F)) (hAS : A ≤ S)
    (hAc : 4 ≤ Nat.card A) (hq : IsQuadratic ρ A)
    (t : SL(2, F)) (htA : t ∈ A) (ht1 : t ≠ 1) :
    (fixedGeneratedSubrepresentation ρ A).toSubmodule ⊓
        fixedSpace ρ (zpowers t) = fixedSpace ρ A := by
  let W := fixedGeneratedSubrepresentation ρ A
  have hqw : IsQuadratic W.toRepresentation A := by
    intro a ha b hb v
    apply Subtype.ext
    exact hq a ha b hb v
  have he := sl2_quadratic_fixedSpace_eq W.toRepresentation hn hF S A hAS hAc hqw
    (fixedGenerated_generated ρ A) t htA ht1
  apply le_antisymm
  · intro v hv
    have ht : (⟨v, hv.1⟩ : W.toSubmodule) ∈ fixedSpace W.toRepresentation (zpowers t) :=
      fun a => Subtype.ext (hv.2 a)
    rw [← he] at ht
    exact fun a => congrArg Subtype.val (ht a)
  · exact le_inf (fixedSpace_le_fixedGenerated ρ A)
      (ρ.invariants_comp_subtype_antitone (zpowers_le.mpr htA))

public theorem sl2_fixedGenerated_central_degree_le
    (ρ : Representation (ZMod 2) SL(2, F) V)
    {n : ℕ} (hn : 0 < n) (hF : Nat.card F = 2 ^ n)
    (S : Sylow 2 SL(2, F)) (A : Subgroup SL(2, F)) (hAS : A ≤ S)
    (hAc : 4 ≤ Nat.card A) (hq : IsQuadratic ρ A)
    (t : SL(2, F)) (htA : t ∈ A) (ht1 : t ≠ 1)
    [FiniteDimensional (ZMod 2) V] :
    let W := fixedGeneratedSubrepresentation ρ A
    Module.finrank (ZMod 2) (W.toSubmodule ⧸ fixedSpace W.toRepresentation ⊤) ≤
      2 * fixedCodim ρ (zpowers t) := by
  let W := fixedGeneratedSubrepresentation ρ A
  have hqw : IsQuadratic W.toRepresentation A := by
    intro a ha b hb v
    apply Subtype.ext
    exact hq a ha b hb v
  have he := sl2_quadratic_fixedSpace_eq W.toRepresentation hn hF S A hAS hAc hqw
    (fixedGenerated_generated ρ A) t htA ht1
  obtain ⟨g, hg⟩ := sl2_exists_quadratic_pair hn hF S A hAS hAc t htA ht1
  have hp : A ⊔ A.map (MulAut.conj g).toMonoidHom = ⊤ :=
    top_unique (hg.symm ▸ sup_le_sup (zpowers_le.mpr htA) le_rfl)
  have hd := central_quotient_degree_le_pair W.toRepresentation A g hp
  have hec : fixedCodim W.toRepresentation A = fixedCodim W.toRepresentation (zpowers t) := by
    unfold fixedCodim
    rw [he]
  rw [hec] at hd
  exact hd.trans (Nat.mul_le_mul_left 2
    (fixedCodim_subrepresentation_le ρ W (zpowers t)))

end Representation.RankOne.QuadraticRecognition
