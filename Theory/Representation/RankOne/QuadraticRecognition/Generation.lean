module
public import Theory.Representation.BinarySylowFixedSpace
public import Theory.Representation.BinaryOffender.QuadraticDualOffender
public import Theory.Representation.SubspaceQuotient
public import Theory.Representation.GeneratedSubgroupInvariants

/-!+# Quadratic pairs and Sylow fixed-space generation

The corrected generation hypothesis in DGS85 (5.12) has a concrete role:
odd Sylow-coset averaging makes a module generated by its Sylow fixed
space the sum of its global fixed space and its commutator space.
If the global fixed space vanishes, two generating quadratic subgroups
therefore have complementary fixed spaces. This is the linear step in
the characteristic-two proof on printed pp.109,113--114.
-/

public section
namespace Representation.RankOne.QuadraticRecognition
open Subgroup BinaryOffender
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]

/-- The source generation condition uses translates of the actual fixed space. -/
@[expose] def GeneratedByFixedSpace (ρ : Representation (ZMod 2) G V)
    (A : Subgroup G) : Prop :=
  (⨆ g : G, (fixedSpace ρ A).map (ρ g)) = ⊤

/-- Fixed-space generation passes to the same quotient vectors and the
literal image of the actor subgroup. No lifting of quotient fixed vectors
is assumed. -/
theorem generatedByFixedSpace_of_equivariant_surjection
    {D W : Type*} [Group D] [AddCommGroup W] [Module (ZMod 2) W]
    (ρ : Representation (ZMod 2) G V) (σ : Representation (ZMod 2) D W)
    (f : G →* D) (q : V →ₗ[ZMod 2] W) (hq : Function.Surjective q)
    (he : ∀ g v, q (ρ g v) = σ (f g) (q v))
    (A : Subgroup G) (hgen : GeneratedByFixedSpace ρ A) :
    GeneratedByFixedSpace σ (A.map f) := by
  let U := ⨆ d : D, (fixedSpace σ (A.map f)).map (σ d)
  have hfixed : ∀ v ∈ fixedSpace ρ A, q v ∈ fixedSpace σ (A.map f) := by
    intro v hv a
    obtain ⟨b,hb,heq⟩ := a.property
    change σ a.val (q v) = q v
    rw [← heq, ← he]
    exact congrArg q (hv ⟨b,hb⟩)
  have hle : (⨆ g : G, (fixedSpace ρ A).map (ρ g)) ≤ U.comap q := by
    apply iSup_le
    intro g
    rintro _ ⟨v,hv,rfl⟩
    change q (ρ g v) ∈ U
    rw [he]
    exact (le_iSup (fun d : D => (fixedSpace σ (A.map f)).map (σ d)) (f g))
      ⟨q v,hfixed v hv,rfl⟩
  change U = ⊤
  apply top_unique
  intro w _
  obtain ⟨v,rfl⟩ := hq w
  exact hle (hgen.symm ▸ Submodule.mem_top)

/-- In particular the correction descends along the actual linear quotient
map, for every invariant subspace. -/
theorem generatedByFixedSpace_quotient (ρ : Representation (ZMod 2) G V)
    (C : Subrepresentation ρ) (A : Subgroup G)
    (hgen : GeneratedByFixedSpace ρ A) :
    GeneratedByFixedSpace C.quotientRepresentation A := by
  have h := generatedByFixedSpace_of_equivariant_surjection ρ C.quotientRepresentation
    (MonoidHom.id G) C.toSubmodule.mkQ C.toSubmodule.mkQ_surjective
    (fun g v => (C.quotientRepresentation_mk g v).symm) A hgen
  simpa only [Subgroup.map_id] using h

/-- DGS (5.8)(a): fixed-space generation gives the sum with the commutator.
This part does not require quadraticity. -/
theorem moved_sup_fixed_eq_top (ρ : Representation (ZMod 2) G V)
    (A : Subgroup G) (hgen : GeneratedByFixedSpace ρ A) :
    Coinvariants.ker ρ ⊔ fixedSpace ρ A = ⊤ := by
  apply top_unique
  rw [← hgen]
  apply iSup_le
  intro g
  rintro _ ⟨v, hv, rfl⟩
  have hd := Coinvariants.sub_mem_ker (ρ := ρ) g v
  simpa only [sub_add_cancel] using
    (Coinvariants.ker ρ ⊔ fixedSpace ρ A).add_mem
      (Submodule.mem_sup_left hd) (Submodule.mem_sup_right hv)

/-- The corrected Sylow generation condition eliminates trivial quotients
when there are no globally fixed vectors. -/
theorem moved_eq_top_of_sylow_generation [Finite G]
    (ρ : Representation (ZMod 2) G V) (S : Sylow 2 G)
    (hgen : GeneratedByFixedSpace ρ S) (hfix : fixedSpace ρ ⊤ = ⊥) :
    Coinvariants.ker ρ = ⊤ := by
  have hS : fixedSpace ρ S ≤ Coinvariants.ker ρ := by
    intro v hv
    obtain ⟨w, hw, hmem⟩ := BinarySylowFixedSpace.fixed_lift_mod_trivial_quotient
      ρ S (Coinvariants.ker ρ) (Coinvariants.sub_mem_ker (ρ := ρ)) v hv
    have hw0 : w = 0 := by
      have hwf : w ∈ fixedSpace ρ ⊤ := fun g => hw g
      simpa only [hfix, Submodule.mem_bot] using hwf
    simpa only [hw0, sub_zero] using hmem
  have he := moved_sup_fixed_eq_top ρ S hgen
  rwa [sup_eq_left.mpr hS] at he

/-- The commutator of a generated pair is the sum of its two commutators. -/
theorem moved_eq_sup_of_generates (ρ : Representation (ZMod 2) G V)
    (A B : Subgroup G) (hgen : A ⊔ B = ⊤) :
    Coinvariants.ker ρ =
      Coinvariants.ker (ρ.comp A.subtype) ⊔ Coinvariants.ker (ρ.comp B.subtype) := by
  let W := Coinvariants.ker (ρ.comp A.subtype) ⊔ Coinvariants.ker (ρ.comp B.subtype)
  let D : Subgroup G := {
    carrier := {g | ∀ v, ρ g v - v ∈ W}
    one_mem' := by intro v; simp
    mul_mem' := by
      intro a b ha hb v
      have hh := W.add_mem (ha (ρ b v)) (hb v)
      simpa only [map_mul, Module.End.mul_apply, sub_add_sub_cancel] using hh
    inv_mem' := by
      intro a ha v
      have hh := W.neg_mem (ha (ρ a⁻¹ v))
      simpa only [ρ.self_inv_apply, neg_sub] using hh }
  have hD : A ⊔ B ≤ D := by
    apply sup_le
    · intro a ha v
      exact Submodule.mem_sup_left (Coinvariants.sub_mem_ker (ρ := ρ.comp A.subtype) ⟨a,ha⟩ v)
    · intro b hb v
      exact Submodule.mem_sup_right (Coinvariants.sub_mem_ker (ρ := ρ.comp B.subtype) ⟨b,hb⟩ v)
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨⟨g,v⟩,rfl⟩
    exact hD (hgen.symm ▸ mem_top g) v
  · apply sup_le <;> apply Submodule.span_le.mpr
    · rintro _ ⟨⟨a,v⟩,rfl⟩
      exact Coinvariants.sub_mem_ker (ρ := ρ) a v
    · rintro _ ⟨⟨b,v⟩,rfl⟩
      exact Coinvariants.sub_mem_ker (ρ := ρ) b v

/-- Two generating quadratic groups have complementary fixed spaces on a
fully moved module with zero global fixed space. -/
theorem fixed_isCompl_of_quadratic_pair (ρ : Representation (ZMod 2) G V)
    (A B : Subgroup G) (hgen : A ⊔ B = ⊤)
    (hA : IsQuadratic ρ A) (hB : IsQuadratic ρ B)
    (hmoved : Coinvariants.ker ρ = ⊤) (hfix : fixedSpace ρ ⊤ = ⊥) :
    IsCompl (fixedSpace ρ A) (fixedSpace ρ B) := by
  have hWA : Coinvariants.ker (ρ.comp A.subtype) ≤ fixedSpace ρ A :=
    (commutator_le_invariants_iff _).mpr (fun a b v => hA a a.property b b.property v)
  have hWB : Coinvariants.ker (ρ.comp B.subtype) ≤ fixedSpace ρ B :=
    (commutator_le_invariants_iff _).mpr (fun a b v => hB a a.property b b.property v)
  refine ⟨disjoint_iff.mpr ?_, codisjoint_iff.mpr ?_⟩
  · change invariants (ρ.comp A.subtype) ⊓ invariants (ρ.comp B.subtype) = ⊥
    rw [← ρ.invariants_comp_sup, hgen]
    exact hfix
  · apply top_unique
    rw [← hmoved, moved_eq_sup_of_generates ρ A B hgen]
    exact sup_le_sup hWA hWB

/-- The corrected source generation condition supplies the full-movement
premise in the preceding quadratic-pair theorem. -/
theorem fixed_isCompl_of_sylow_generation [Finite G]
    (ρ : Representation (ZMod 2) G V) (S : Sylow 2 G) (B : Subgroup G)
    (hgen : (S : Subgroup G) ⊔ B = ⊤)
    (hS : IsQuadratic ρ S) (hB : IsQuadratic ρ B)
    (hspan : GeneratedByFixedSpace ρ S) (hfix : fixedSpace ρ ⊤ = ⊥) :
    IsCompl (fixedSpace ρ S) (fixedSpace ρ B) :=
  fixed_isCompl_of_quadratic_pair ρ S B hgen hS hB
    (moved_eq_top_of_sylow_generation ρ S hspan hfix) hfix

end Representation.RankOne.QuadraticRecognition
