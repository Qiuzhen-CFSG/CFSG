module
public import Theory.Representation.RankOne.QuadraticRecognition.TorusCentralization
public import Theory.Representation.RankOne.QuadraticRecognition.UnitaryActorDegree
public import Theory.Representation.RankOne.QuadraticRecognition.UnitaryBlockReduction
public import Theory.SpecificGroups.SU3.BinaryFixedTorusGeneration
public import Theory.SpecificGroups.SU3.MarkedFiveTorus

/-!
# The first unitary torus branch of the individual-element bound

A norm-one torus acts on the first Hermitian root coordinate by its cube.
When that cube is nontrivial, commutators generate the full root group.
If the torus fixes the A-displacements, the quotient by C_V(A) forces this
root group to preserve the local fixed-generated SL₂ block. The original
vector-generation hypothesis and root/block generation make that block all
of V. Its fixed-space equality C_V(A)=C_V(t), followed by the field-square
actor bound, proves the individual-element estimate in this branch.

All actions use the original special or projective matrix maps. In SU₃,
nontrivial cubic scalar elements are excluded from the root-generation step:
they centralize the root. In PSU₃ the condition is precisely nontriviality of
the projective torus image. The remaining moving-torus branch, its quotient
fixed-point-free argument, and scalar-cover handling are separate obligations.

Source: DGS85, Groups and Graphs, (5.10)(b), printed pp.111–112.
CriticalUnitaryTorus supplies the literal critical-module application and
proves descent of its original generation, quadraticity, and torus identity.
-/

public noncomputable section
open Matrix Subgroup Representation.BinaryOffender
open BenderSuzuki.MatrixGroups BenderSuzuki.External
open HermitianForm.BorelTorus.EvenCenterAction
open Representation.SU3.CubicDegree.InnerActors.ThreeRoots
namespace Representation.RankOne.QuadraticRecognition
variable {F : Type*} [Field F] [Finite F] [CharP F 2]
variable (J : HermitianForm 3 F) (hJ : J.form=!![0,0,1;0,1,0;1,0,0])

open HermitianForm.BorelTorus HermitianForm.EvenInner

private theorem normOne_commutator_of_injective
    {q : ℕ} (hcard : Nat.card F=q^2)
    (hfixed : Nat.card {x : F // J.conj x=x}=q)
    {D : Type*} [Group D]
    (f : hermitianUnipotentCoord J →* D) (hf : Function.Injective f)
    (s : Fˣ →* D)
    (hact : ∀ k z, s k*f z*(s k)⁻¹=f (hermitianTorusAction J k z))
    (k : normOne J) (hk : k^3≠1) : ⁅f.range,zpowers (s k.val)⁆=f.range := by
  rw [commutator_comm]
  apply HermitianForm.BinaryFixedTorusGeneration.commutator_eq_of_action J hcard hfixed f s
    hact (zpowers (s k.val)) (zpowers_le.mpr ⟨k.val,rfl⟩)
  intro hc
  obtain ⟨b,hb⟩ := huppert_II_10_4_trace_surjective J q hcard hfixed 1 (by simp)
  let z : hermitianUnipotentCoord J := ⟨(1,b),by
    simp only [map_one,mul_one,hb,CharTwo.add_self_eq_zero]⟩
  have hz1 : z.val.1=1 := rfl
  have hh := hc (mem_zpowers (s k.val)) (f z) ⟨z,rfl⟩
  have he : f (hermitianTorusAction J k.val z)=f z := by
    rw [←hact,←hh,mul_inv_cancel_right]
  have he' := congrArg (fun z : hermitianUnipotentCoord J => z.val.1) (hf he)
  rw [normOne_action_first J k.val k.property,hz1,mul_one] at he'
  apply hk
  apply Subtype.ext
  apply Units.ext
  exact he'

/-- The full special root is generated by commutators with a norm-one
 element whose image survives the cubic scalar quotient. -/
theorem su3_normOne_root_commutator
    {q : ℕ} (hcard : Nat.card F=q^2)
    (hfixed : Nat.card {x : F // J.conj x=x}=q)
    (k : normOne J) (hk : k^3≠1) :
    ⁅specialRoot J hJ,zpowers (hermitianTorusSU J hJ k.val)⁆=specialRoot J hJ := by
  apply normOne_commutator_of_injective J hcard hfixed (hermitianUnipotentSU J hJ)
    (fun z w he => Subtype.ext (Prod.ext
      (congrArg (fun x : J.specialSubgroup => x.val.val 0 1) he)
      (congrArg (fun x : J.specialSubgroup => x.val.val 0 2) he)))
    (hermitianTorusSU J hJ) _ k hk
  intro k z
  apply mul_inv_eq_iff_eq_mul.mpr
  exact Subtype.ext (hermitianTorusGL_mul_unipotent J k z)

/-- In PSU₃ the hypothesis is exactly nontriviality of the original
 norm-one torus image. -/
theorem psu3_normOne_root_commutator
    {q : ℕ} (hcard : Nat.card F=q^2)
    (hfixed : Nat.card {x : F // J.conj x=x}=q)
    (k : normOne J) (hk : normOneMap J hJ k≠1) :
    ⁅projectiveRoot J hJ,zpowers (normOneMap J hJ k)⁆=projectiveRoot J hJ :=
  normOne_commutator_of_injective J hcard hfixed (hermitianUnipotentPSU J hJ)
    (root_injective J hJ) (hermitianTorusPSU J hJ) (projective_torus_action J hJ)
    k (fun he => hk ((normOneMap_eq_one_iff J hJ k).mpr he))

omit [Finite F] in
private theorem special_root_centralizes : specialRoot J hJ ≤
    centralizer (central J hJ : Set J.specialSubgroup) := by
  rintro _ ⟨z,rfl⟩ _ ⟨b,rfl⟩
  change hermitianUnipotentSU J hJ (centralCoord J b)*hermitianUnipotentSU J hJ z =
    hermitianUnipotentSU J hJ z*hermitianUnipotentSU J hJ (centralCoord J b)
  rw [←map_mul,←map_mul]
  exact congrArg _ (mem_center_iff.mp (centralCoord_mem_center J b) z).symm

omit [Finite F] in
private theorem special_normOne_centralizes (k : normOne J) :
    hermitianTorusSU J hJ k.val ∈ centralizer (central J hJ : Set J.specialSubgroup) := by
  rintro _ ⟨b,rfl⟩
  have he : hermitianTorusAction J k.val (centralCoord J b)=centralCoord J b := by
    apply Subtype.ext
    apply Prod.ext
    · change 0*(k.val:F)*(J.conj (k.val:F))⁻¹^2=0
      simp only [zero_mul]
    · change (b.toAdd:F)*(J.conj (k.val:F))⁻¹*(k.val:F)⁻¹=(b.toAdd:F)
      rw [k.property,inv_inv,mul_inv_cancel_right₀ k.val.ne_zero]
  apply Subtype.ext
  symm
  change hermitianTorusGL J k.val*hermitianUnipotentGL J (centralCoord J b)=
    hermitianUnipotentGL J (centralCoord J b)*hermitianTorusGL J k.val
  rw [hermitianTorusGL_mul_unipotent,he]

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]

private theorem embedded_local_eq_top
    {D K : Type*} [Group D] [Group K]
    (ρ : Representation (ZMod 2) D V) (j : K →* D) (A S : Subgroup D)
    (hA : A≤j.range) (k : D) (hSA : S≤normalizer (A : Set D))
    (hkA : k∈centralizer (A : Set D)) (hSk : ⁅S,zpowers k⁆=S)
    (hgen : GeneratedByFixedSpace ρ A) (hSL : S ⊔ j.range=⊤)
    (hkfix : ∀ a∈A, ∀ v, ρ k (ρ a v-v)=ρ a v-v) :
    (fixedGeneratedSubrepresentation (ρ.comp j) (A.comap j)).toSubmodule=⊤ := by
  let W := fixedGeneratedSubrepresentation (ρ.comp j) (A.comap j)
  have hAW : fixedSpace ρ A≤W.toSubmodule := by
    have he : fixedSpace (ρ.comp j) (A.comap j)=fixedSpace ρ A := by
      rw [fixedSpace_comp_map,map_comap_eq_self hA]
    exact he ▸ fixedSpace_le_fixedGenerated (ρ.comp j) (A.comap j)
  have hLW : j.range≤subspaceStabilizer ρ W.toSubmodule := by
    apply le_subspaceStabilizer
    rintro _ ⟨g,rfl⟩ v hv
    exact W.apply_mem_toSubmodule g hv
  exact local_eq_top_of_torus_trivial_on_actor_displacements ρ A S j.range k
    hSA hkA hSk hkfix hSL hgen W.toSubmodule hAW hLW

/-- The first torus branch makes the literal SU₃ fixed-generated block
 global. Cubic scalar elements are explicitly excluded from this branch. -/
theorem su3_fixedGenerated_eq_top_of_torus_centralizes_displacements
    {n : ℕ} (hn : 2≤n) (hcard : Nat.card F=(2^n)^2)
    (hconj : ∀ x, J.conj x=x^(2^n))
    (ρ : Representation (ZMod 2) J.specialSubgroup V) (A : Subgroup J.specialSubgroup)
    (hA : A≤central J hJ) (hgen : GeneratedByFixedSpace ρ A)
    (k : normOne J) (hk : k^3≠1)
    (hkfix : ∀ a∈A, ∀ v, ρ (hermitianTorusSU J hJ k.val) (ρ a v-v)=ρ a v-v) :
    (fixedGeneratedSubrepresentation (ρ.comp (block J hJ)) (A.comap (block J hJ))).toSubmodule=⊤ := by
  have hf := FiniteField.card_fixed_of_quadratic_frobenius J.conj 2 n (by omega) hcard hconj
  exact embedded_local_eq_top ρ (block J hJ) A (specialRoot J hJ)
    (hA.trans (su3_central_le_block J hJ)) _
    ((special_root_centralizes J hJ).trans ((centralizer_le hA).trans (Subgroup.centralizer_le_normalizer _)))
    ((centralizer_le hA) (special_normOne_centralizes J hJ k))
    (su3_normOne_root_commutator J hJ hcard hf k hk) hgen
    (su3_root_block_generate J hJ hn hcard hconj) hkfix

/-- The projective first torus branch retains the original torus image
 and the exact projective block preimage of A. -/
theorem psu3_fixedGenerated_eq_top_of_torus_centralizes_displacements
    {n : ℕ} (hn : 2≤n) (hcard : Nat.card F=(2^n)^2)
    (hconj : ∀ x, J.conj x=x^(2^n))
    (ρ : Representation (ZMod 2) (ProjectiveSpecialUnitaryMatrixGroup J) V)
    (A : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J))
    (hA : A≤centralImage J hJ) (hgen : GeneratedByFixedSpace ρ A)
    (k : normOne J) (hk : normOneMap J hJ k≠1)
    (hkfix : ∀ a∈A, ∀ v, ρ (normOneMap J hJ k) (ρ a v-v)=ρ a v-v) :
    let j := J.specialToProjective.comp (block J hJ)
    (fixedGeneratedSubrepresentation (ρ.comp j) (A.comap j)).toSubmodule=⊤ := by
  have hf := FiniteField.card_fixed_of_quadratic_frobenius J.conj 2 n (by omega) hcard hconj
  exact embedded_local_eq_top ρ (J.specialToProjective.comp (block J hJ)) A (projectiveRoot J hJ)
    (hA.trans (psu3_central_le_block J hJ)) _
    ((root_centralizes J hJ).trans ((centralizer_le hA).trans (Subgroup.centralizer_le_normalizer _)))
    ((centralizer_le hA) (HermitianForm.MarkedFiveTorus.normOne_centralizes_upper J hJ ⟨k,rfl⟩))
    (psu3_normOne_root_commutator J hJ hcard hf k hk) hgen
    (psu3_root_block_generate J hJ hn hcard hconj) hkfix

/-- DGS (5.10)(b) in the noncentral first torus branch, for SU₃. -/
theorem su3_element_field_index_of_torus_centralizes_displacements
    {n : ℕ} (hn : 2≤n) (hcard : Nat.card F=(2^n)^2)
    (hconj : ∀ x, J.conj x=x^(2^n)) [Finite V]
    (ρ : Representation (ZMod 2) J.specialSubgroup V) (hnt : ∃ g, ρ g≠1)
    (A : Subgroup J.specialSubgroup) (hA : A≤central J hJ) (hAc : 4≤Nat.card A)
    (hq : IsQuadratic ρ A) (hgen : GeneratedByFixedSpace ρ A)
    (t : J.specialSubgroup) (ht : t∈A) (ht1 : t≠1)
    (k : normOne J) (hk : k^3≠1)
    (hkfix : ∀ a∈A, ∀ v, ρ (hermitianTorusSU J hJ k.val) (ρ a v-v)=ρ a v-v) :
    2^(2*n)≤Nat.card (V ⧸ fixedSpace ρ (zpowers t)) := by
  have hW := su3_fixedGenerated_eq_top_of_torus_centralizes_displacements J hJ hn hcard hconj
    ρ A hA hgen k hk hkfix
  have he := (su3_root_fixedGenerated_reduction J hJ (by omega) hcard hconj
    ρ A hA hAc hq t ht ht1).1
  rw [hW,top_inf_eq] at he
  rw [he]
  exact su3_root_actor_field_index J hJ hn hcard hconj ρ hnt A hA hAc

/-- The first torus branch of the element bound on the actual PSU₃ carrier. -/
theorem psu3_element_field_index_of_torus_centralizes_displacements
    {n : ℕ} (hn : 2≤n) (hcard : Nat.card F=(2^n)^2)
    (hconj : ∀ x, J.conj x=x^(2^n)) [Finite V]
    (ρ : Representation (ZMod 2) (ProjectiveSpecialUnitaryMatrixGroup J) V)
    (hnt : ∃ g, ρ g≠1)
    (A : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J))
    (hA : A≤centralImage J hJ) (hAc : 4≤Nat.card A)
    (hq : IsQuadratic ρ A) (hgen : GeneratedByFixedSpace ρ A)
    (t : ProjectiveSpecialUnitaryMatrixGroup J) (ht : t∈A) (ht1 : t≠1)
    (k : normOne J) (hk : normOneMap J hJ k≠1)
    (hkfix : ∀ a∈A, ∀ v, ρ (normOneMap J hJ k) (ρ a v-v)=ρ a v-v) :
    2^(2*n)≤Nat.card (V ⧸ fixedSpace ρ (zpowers t)) := by
  have hW := psu3_fixedGenerated_eq_top_of_torus_centralizes_displacements J hJ hn hcard hconj
    ρ A hA hgen k hk hkfix
  have he := (psu3_root_fixedGenerated_reduction J hJ (by omega) hcard hconj
    ρ A hA hAc hq t ht ht1).1
  rw [hW,top_inf_eq] at he
  rw [he]
  exact psu3_root_actor_field_index J hJ hn hcard hconj ρ hnt A hA hAc

end Representation.RankOne.QuadraticRecognition
