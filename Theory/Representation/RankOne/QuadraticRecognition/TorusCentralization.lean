module
public import Theory.Representation.RankOne.QuadraticRecognition.FixedGeneratedReduction
public import Theory.Representation.BinaryOffender.CommutatorDisplacement

/-!
# Torus centralization and generation of a local block

If a torus element k centralizes A and fixes every A-displacement, the
commuting-operator identity puts [V,k] in C_V(A). When S normalizes A and
[S,k]=S, the action on V/C_V(A) then puts [V,S] in C_V(A). Consequently any
L-invariant subspace containing C_V(A) is the whole module whenever S and L
generate G and V is generated by the G-translates of C_V(A).

This is the first three-subgroup step on DGS85, Groups and Graphs, printed
p.112, in the proof of (5.10)(b). All normalizers and commutators are relative
to the original ambient group. UnitaryTorus applies the result to the actual
Hermitian root, fixed-field block, and noncentral norm-one torus elements.
-/

public noncomputable section
open Subgroup Representation.BinaryOffender
namespace Representation.RankOne.QuadraticRecognition
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]

/-- Trivial torus action on the actor displacements forces the full root
 to act trivially modulo the original actor fixed space. -/
theorem fixedSpace_contains_root_displacements_of_torus
    (ρ : Representation (ZMod 2) G V) (A S : Subgroup G) (k : G)
    (hSA : S ≤ normalizer (A : Set G))
    (hkA : k ∈ centralizer (A : Set G))
    (hSk : ⁅S, zpowers k⁆ = S)
    (hkfix : ∀ a ∈ A, ∀ v, ρ k (ρ a v-v) = ρ a v-v) :
    subspaceCommutator ρ ⊤ S ≤ fixedSpace ρ A := by
  have hkd (v : V) : ρ k v-v ∈ fixedSpace ρ A := by
    intro a
    have he := hkfix a a.property v
    rw [map_sub] at he
    have hc : ρ k (ρ a v) = ρ a (ρ k v) := by
      rw [← Module.End.mul_apply, ← map_mul, ← Module.End.mul_apply, ← map_mul,
        hkA a a.property]
    rw [hc] at he
    change ρ a (ρ k v-v)=ρ k v-v
    rw [map_sub]
    apply sub_eq_sub_iff_add_eq_add.mpr
    simpa only [add_comm] using sub_eq_sub_iff_add_eq_add.mp he
  have hkn : zpowers k ≤ normalizer (A : Set G) :=
    zpowers_le.mpr (centralizer_le_normalizer (A : Set G) hkA)
  have hks := fixedSpace_stable_of_normalizes ρ hkn
  let I := invariantSubspace ρ (zpowers k) (fixedSpace ρ A) hks
  have hkq : I.quotientRepresentation ⟨k,mem_zpowers k⟩ = 1 := by
    apply LinearMap.ext
    intro v
    induction v using Submodule.Quotient.induction_on with
    | _ v => exact (Submodule.Quotient.eq _).mpr (hkd v)
  have hkg : ∀ g : zpowers k, I.quotientRepresentation g = 1 := by
    intro g
    obtain ⟨m,hm⟩ := g.property
    have hg : (⟨k,mem_zpowers k⟩ : zpowers k)^m=g := Subtype.ext hm
    have he : I.quotientRepresentation.asGroupHom ⟨k,mem_zpowers k⟩=1 := by
      apply Units.ext
      exact hkq
    have hh := congrArg Units.val (show I.quotientRepresentation.asGroupHom g=1 by
      rw [←hg,map_zpow,he,one_zpow])
    exact hh
  apply subspaceCommutator_le_of_commutator_displacement ρ hSk
    (fixedSpace_stable_of_normalizes ρ hSA) hks
  apply Submodule.span_le.mpr
  rintro _ ⟨g,hg,v,_,rfl⟩
  exact (Submodule.Quotient.eq _).mp
    (LinearMap.congr_fun (hkg ⟨g,hg⟩) ((fixedSpace ρ A).mkQ v))

/-- The original vector-generation premise makes the resulting local
 invariant subspace global. -/
theorem local_eq_top_of_torus_trivial_on_actor_displacements
    (ρ : Representation (ZMod 2) G V) (A S L : Subgroup G) (k : G)
    (hSA : S ≤ normalizer (A : Set G))
    (hkA : k ∈ centralizer (A : Set G)) (hSk : ⁅S,zpowers k⁆=S)
    (hkfix : ∀ a ∈ A, ∀ v, ρ k (ρ a v-v)=ρ a v-v)
    (hSL : S ⊔ L=⊤) (hgen : GeneratedByFixedSpace ρ A)
    (W : Submodule (ZMod 2) V) (hAW : fixedSpace ρ A ≤ W)
    (hLW : L ≤ subspaceStabilizer ρ W) : W=⊤ := by
  have hd := fixedSpace_contains_root_displacements_of_torus ρ A S k hSA hkA hSk hkfix
  have hSW : S ≤ subspaceStabilizer ρ W := by
    apply le_subspaceStabilizer
    intro s hs v hv
    have hm := hAW (hd (Submodule.subset_span ⟨s,hs,v,Submodule.mem_top,rfl⟩))
    simpa only [sub_add_cancel] using W.add_mem hm hv
  have hGW : (⊤ : Subgroup G) ≤ subspaceStabilizer ρ W := by
    rw [←hSL]
    exact sup_le hSW hLW
  apply top_unique
  rw [←show (⨆ g : G, (fixedSpace ρ A).map (ρ g))=⊤ from hgen]
  apply iSup_le
  intro g
  rintro _ ⟨v,hv,rfl⟩
  exact (hGW (mem_top g) v).2 (hAW hv)

end Representation.RankOne.QuadraticRecognition
