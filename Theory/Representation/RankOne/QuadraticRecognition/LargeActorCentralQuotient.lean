module
public import Theory.Representation.RankOne.QuadraticRecognition.FixedGeneratedReduction
public import Theory.Representation.SL2SylowFixedRecognition.Complementary
public import Theory.SpecificGroups.PSL2.AutomorphismModel

/-!
# Large quadratic actors and the exact local central quotient

For a binary SL₂ module generated by a quadratic actor's fixed space,
(5.10)(c) identifies that space with each nontrivial actor-element fixed
space. If the actor has squared order larger than the Sylow order, it
meets every normalizer conjugate. Involution fusion therefore gives the
same fixed space for every nonidentity Sylow element. The existing
root-coordinate theorem identifies the literal central quotient with a
sum of natural modules, so its binary degree is divisible by twice the
field degree. Applying this to the fixed-generated subrepresentation
requires no irreducibility or generation assumption on the ambient module.

At field order eight, every actor of order at least four satisfies the
size condition. Thus the eight-dimensional local central quotient in
the exceptional torus case is impossible. UnitaryLargeActors transports
this obstruction through the actual SU₃ and PSU₃ block embeddings.

Source: DGS85, *Groups and Graphs*, (5.10)(b), printed pp.111–112,
and the large-actor argument in (5.12), p.114. Natural coordinates use
Aschbacher–Smith G.1.6, printed pp.329–330. This argument concerns the
local block; the full unitary individual-element estimate is separate.
-/

public noncomputable section
open Subgroup Representation.BinaryOffender
open scoped MatrixGroups
namespace Representation.RankOne.QuadraticRecognition

variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]

private theorem generated_conjugate (ρ : Representation (ZMod 2) G V)
    (A : Subgroup G) (hg : GeneratedByFixedSpace ρ A) (g : G) :
    GeneratedByFixedSpace ρ (A.map (MulAut.conj g).toMonoidHom) := by
  apply generatedByFixedSpace_of_equivariant_surjection ρ ρ
    (MulAut.conj g).toMonoidHom (ρ g) ?_ ?_ A hg
  · intro v
    exact ⟨ρ g⁻¹ v, ρ.self_inv_apply g v⟩
  · intro a v
    simp only [MulEquiv.toMonoidHom_eq_coe, MonoidHom.coe_coe, MulAut.conj_apply,
      map_mul, Module.End.mul_apply, ρ.inv_self_apply]

private theorem large_intersection {D : Type*} [Group D] [Finite D]
    (S A B : Subgroup D) (hAS : A ≤ S) (hBS : B ≤ S)
    (hc : Nat.card S < Nat.card A * Nat.card B) : A ⊓ B ≠ ⊥ := by
  intro h
  have hd : Disjoint A B := disjoint_iff.mpr h
  let f : A × B → S := fun x =>
    ⟨x.1.val * x.2.val, S.mul_mem (hAS x.1.property) (hBS x.2.property)⟩
  have hf : Function.Injective f := fun _ _ hh =>
    mul_injective_of_disjoint hd (congrArg Subtype.val hh)
  have hh := Nat.card_le_card_of_injective f hf
  rw [Nat.card_prod] at hh
  omega

variable {F : Type*} [Field F] [Finite F] [CharP F 2]

/-- Fixed-space generation extends a large quadratic actor to uniform
Sylow fixed spaces, without an irreducibility assumption. -/
theorem sl2_large_actor_fixedSpaceHypotheses
    (ρ : Representation (ZMod 2) SL(2,F) V)
    {n : ℕ} (hn : 0 < n) (hF : Nat.card F = 2^n)
    (S : Sylow 2 SL(2,F)) (A : Subgroup SL(2,F)) (hAS : A ≤ S)
    (hAc : 4 ≤ Nat.card A) (hq : IsQuadratic ρ A)
    (hgen : GeneratedByFixedSpace ρ A) (hlarge : Nat.card S < Nat.card A^2) :
    SL2SylowFixedRecognition.FixedSpaceHypotheses ρ S := by
  have hA : A ≠ ⊥ := by intro h; simp [h] at hAc
  obtain ⟨a,ha,ha1⟩ := A.bot_or_exists_ne_one.resolve_left hA
  have square (a : SL(2,F)) (ha : a ∈ S) : a^2=1 := by
    exact congrArg Subtype.val
      (Matrix.SpecialLinearGroup.twoSubgroup_pow_two (S : Subgroup _) S.isPGroup' ⟨a,ha⟩)
  have hunif (b : SL(2,F)) (hb : b ∈ S) (hb1 : b ≠ 1) :
      fixedSpace ρ A = fixedSpace ρ (zpowers b) := by
    let e := Theory.PSL2.sl2QuotientEquiv F
    have hc := Theory.PSL2.involutions_isConj (e a) (e b)
      ((e.orderOf_eq a).trans (orderOf_eq_prime (square a (hAS ha)) ha1))
      ((e.orderOf_eq b).trans (orderOf_eq_prime (square b hb) hb1))
    have hh : IsConj a b := by
      simpa only [MulEquiv.coe_toMonoidHom,e.symm_apply_apply] using
        e.symm.toMonoidHom.map_isConj hc
    obtain ⟨g,hg⟩ := isConj_iff.mp hh
    have hgN := Matrix.SpecialLinearGroup.mem_sylow_normalizer_of_conjugate_mem S a g
      (hAS ha) ha1 (hg.symm ▸ S.toSubgroup.le_normalizer hb)
    let B := A.map (MulAut.conj g).toMonoidHom
    have hBS : B ≤ S := (Subgroup.map_mono hAS).trans
      (Subgroup.mem_normalizer_iff_map_conj_eq.mp hgN).le
    have hBc : Nat.card B = Nat.card A := card_map_of_injective (MulAut.conj g).injective
    have hi : A ⊓ B ≠ ⊥ := large_intersection S A B hAS hBS (by rwa [hBc,←pow_two])
    obtain ⟨x,hx,hx1⟩ := (A ⊓ B).bot_or_exists_ne_one.resolve_left hi
    have hqB : IsQuadratic ρ B := SL2SylowFixedRecognition.quadratic_conjugate ρ hq g
    have hgB : GeneratedByFixedSpace ρ B := generated_conjugate ρ A hgen g
    have hfix := (sl2_quadratic_fixedSpace_eq ρ hn hF S A hAS hAc hq hgen x hx.1 hx1).trans
      (sl2_quadratic_fixedSpace_eq ρ hn hF S B hBS (hBc.symm ▸ hAc) hqB hgB x hx.2 hx1).symm
    exact hfix.trans (sl2_quadratic_fixedSpace_eq ρ hn hF S B hBS
      (hBc.symm ▸ hAc) hqB hgB b ⟨a,ha,hg⟩ hb1)
  have hfix : fixedSpace ρ S = fixedSpace ρ A := by
    apply le_antisymm (ρ.invariants_comp_subtype_antitone hAS)
    intro v hv b
    by_cases hb1 : b.val=1
    · simp [hb1]
    exact (mem_fixedSpace_zpowers_iff ρ b.val v).mp (hunif b b.property hb1 ▸ hv)
  exact ⟨by simpa only [hfix] using (show (⨆ g, (fixedSpace ρ A).map (ρ g)) = ⊤ from hgen),fun b hb hb1 => (hunif b hb hb1).symm.trans hfix.symm⟩

/-- A large quadratic actor has exactly the full Sylow fixed space on the
original module, even when that module is not generated by its fixed space. -/
theorem sl2_large_actor_fixedSpace_eq_sylow
    (ρ : Representation (ZMod 2) SL(2,F) V)
    {n : ℕ} (hn : 0 < n) (hF : Nat.card F=2^n)
    (S : Sylow 2 SL(2,F)) (A : Subgroup SL(2,F)) (hAS : A ≤ S)
    (hAc : 4 ≤ Nat.card A) (hq : IsQuadratic ρ A)
    (hlarge : Nat.card S < Nat.card A^2) : fixedSpace ρ A = fixedSpace ρ S := by
  let W := fixedGeneratedSubrepresentation ρ A
  have hqw : IsQuadratic W.toRepresentation A := by
    intro a ha b hb v
    apply Subtype.ext
    exact hq a ha b hb v
  have hw := sl2_large_actor_fixedSpaceHypotheses W.toRepresentation hn hF S A hAS
    hAc hqw (fixedGenerated_generated ρ A) hlarge
  have hA : A ≠ ⊥ := by intro h; simp [h] at hAc
  obtain ⟨a,ha,ha1⟩ := A.bot_or_exists_ne_one.resolve_left hA
  apply le_antisymm _ (ρ.invariants_comp_subtype_antitone hAS)
  intro v hv b
  let w : W.toSubmodule := ⟨v,fixedSpace_le_fixedGenerated ρ A hv⟩
  have hwfix : w ∈ fixedSpace W.toRepresentation (zpowers a) :=
    W.toRepresentation.invariants_comp_subtype_antitone (zpowers_le.mpr ha)
      (fun a => Subtype.ext (hv a))
  rw [hw.uniform a (hAS ha) ha1] at hwfix
  exact congrArg Subtype.val (hwfix b)

/-- The literal central quotient of a fixed-generated large-actor module
is a sum of natural modules; the original field and SL₂ action are retained. -/
theorem sl2_large_actor_natural_centralQuotient
    [Finite V] (ρ : Representation (ZMod 2) SL(2,F) V)
    {n : ℕ} (hn : 2 ≤ n) (hF : Nat.card F=2^n)
    (S : Sylow 2 SL(2,F)) (A : Subgroup SL(2,F)) (hAS : A ≤ S)
    (hAc : 4 ≤ Nat.card A) (hq : IsQuadratic ρ A)
    (hgen : GeneratedByFixedSpace ρ A) (hlarge : Nat.card S < Nat.card A^2) :
    SL2SylowFixedRecognition.NaturalCoordinates (SL2SylowFixedRecognition.centralQuotient ρ) :=
  SL2SylowFixedRecognition.natural_centralQuotient ρ S
    (sl2_large_actor_fixedSpaceHypotheses ρ (by omega) hF S A hAS hAc hq hgen hlarge) n hn hF

/-- The quotient degree is a multiple of twice the defining field degree. -/
theorem sl2_large_actor_central_degree_dvd
    [Finite V] (ρ : Representation (ZMod 2) SL(2,F) V)
    {n : ℕ} (hn : 2 ≤ n) (hF : Nat.card F=2^n)
    (S : Sylow 2 SL(2,F)) (A : Subgroup SL(2,F)) (hAS : A ≤ S)
    (hAc : 4 ≤ Nat.card A) (hq : IsQuadratic ρ A)
    (hgen : GeneratedByFixedSpace ρ A) (hlarge : Nat.card S < Nat.card A^2) :
    2*n ∣ Module.finrank (ZMod 2) (V ⧸ fixedSpace ρ ⊤) := by
  let : Algebra (ZMod 2) F := ZMod.algebra F 2
  obtain ⟨m,e,he⟩ := sl2_large_actor_natural_centralQuotient ρ hn hF S A hAS hAc hq hgen hlarge
  have hdimF : Module.finrank (ZMod 2) F=n := by
    have hc := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := F)
    rw [hF,Nat.card_zmod] at hc
    exact (Nat.pow_right_injective (by decide : 1 < (2 : ℕ)) hc).symm
  have hd := e.finrank_eq
  simp only [Module.finrank_pi_fintype,Finset.sum_const,Finset.card_univ,
    Fintype.card_fin,smul_eq_mul,hdimF] at hd
  exact ⟨m,hd.trans (Nat.mul_comm _ _)⟩

/-- Apply divisibility to the block generated by the original actor fixed space. -/
theorem sl2_large_fixedGenerated_central_degree_dvd
    [Finite V] (ρ : Representation (ZMod 2) SL(2,F) V)
    {n : ℕ} (hn : 2 ≤ n) (hF : Nat.card F=2^n)
    (S : Sylow 2 SL(2,F)) (A : Subgroup SL(2,F)) (hAS : A ≤ S)
    (hAc : 4 ≤ Nat.card A) (hq : IsQuadratic ρ A)
    (hlarge : Nat.card S < Nat.card A^2) :
    let W := fixedGeneratedSubrepresentation ρ A
    2*n ∣ Module.finrank (ZMod 2) (W.toSubmodule ⧸ fixedSpace W.toRepresentation ⊤) := by
  let W := fixedGeneratedSubrepresentation ρ A
  have hqw : IsQuadratic W.toRepresentation A := by
    intro a ha b hb v
    apply Subtype.ext
    exact hq a ha b hb v
  exact sl2_large_actor_central_degree_dvd W.toRepresentation hn hF S A hAS hAc hqw
    (fixedGenerated_generated ρ A) hlarge
/-- At q=8 every quadratic actor of order at least four excludes the
exceptional eight-dimensional local central quotient on DGS p.112. -/
theorem sl2_eight_fixedGenerated_degree_ne_eight
    [Finite V] (ρ : Representation (ZMod 2) SL(2,F) V)
    (hF : Nat.card F=8) (S : Sylow 2 SL(2,F))
    (A : Subgroup SL(2,F)) (hAS : A ≤ S)
    (hAc : 4 ≤ Nat.card A) (hq : IsQuadratic ρ A) :
    let W := fixedGeneratedSubrepresentation ρ A
    Module.finrank (ZMod 2) (W.toSubmodule ⧸ fixedSpace W.toRepresentation ⊤) ≠ 8 := by
  have hSc : Nat.card S=8 :=
    (Nat.card_congr (Matrix.SpecialLinearGroup.sylowEquivAdditive F 2 S).symm.toEquiv).trans hF
  have hd := sl2_large_fixedGenerated_central_degree_dvd ρ (n := 3) (by decide)
    hF S A hAS hAc hq (by rw [hSc]; nlinarith)
  dsimp only at hd ⊢
  intro he
  rw [he] at hd
  norm_num at hd

end Representation.RankOne.QuadraticRecognition
