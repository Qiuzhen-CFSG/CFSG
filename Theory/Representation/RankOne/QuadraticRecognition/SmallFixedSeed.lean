module
public import Theory.Representation.RankOne.QuadraticRecognition.NaturalDefinition
public import Theory.Representation.BinaryOffender.ComponentSum
public import Theory.SpecificGroups.SL2.SylowNormalizerCard
public import Theory.SpecificGroups.PSL2.AutomorphismModel

/-!
# Natural SL₂ modules from a small fixed seed

If a Sylow-fixed subspace C contains all Sylow displacements, its conjugates
generate the module, and |C| ≤ |F|, a nontrivial binary SL₂(F) action is natural.
Two conjugate Sylows bound the total degree by twice the seed degree. Faithfulness
and the quadratic minimum-degree bound force equality, and the existing natural
recognition supplies equivariant coordinates over the original field.

The field of order two is included: the pointwise fixer of the Sylow fixed space
is proper, so the representation kernel lies in the Sylow normalizer, which is
then a two-group. The trivial two-core kills that kernel. No simplicity of SL₂(2)
or splitting of a central extension is assumed.

Source: Delgado--Goldschmidt--Stellmacher, Groups and Graphs (1985),
(5.9), (5.12), and the central-intersection argument in (12.3), pp.180--181.
The graph application is CommutingThreeProfile.LinearNaturalLayer.
-/

public noncomputable section
open Subgroup Representation.BinaryOffender
open scoped MatrixGroups
namespace Representation.RankOne.QuadraticRecognition
variable {F W : Type*} [Field F] [Finite F] [CharP F 2]
  [AddCommGroup W] [Module (ZMod 2) W] [Finite W]
local instance : Algebra (ZMod 2) F := ZMod.algebra F 2

omit [Finite W] in
/-- Two generating conjugate actors bound a module generated by a seed which
contains the first actor's displacement space. -/
theorem seed_pair_spans {D : Type*} [Group D]
    (ρ : Representation (ZMod 2) D W) (S : Subgroup D) (g : D)
    (C : Submodule (ZMod 2) W)
    (hpair : S ⊔ S.map (MulAut.conj g).toMonoidHom = ⊤)
    (hseed : (⨆ a : D, C.map (ρ a)) = ⊤)
    (hmove : subspaceCommutator ρ ⊤ S ≤ C) :
    C ⊔ C.map (ρ g) = ⊤ := by
  let B := C ⊔ C.map (ρ g)
  have hm : Coinvariants.ker ρ ≤ B := by
    rw [moved_eq_sup_of_generates ρ S _ hpair]
    rw [← subspaceCommutator_top_eq_coinvariants,
      ← subspaceCommutator_top_eq_coinvariants, ← moved_map_conjugate]
    exact sup_le_sup hmove (Submodule.map_mono hmove)
  apply top_unique
  rw [← hseed]
  apply iSup_le
  intro a
  rintro _ ⟨v,hv,rfl⟩
  have hd := hm (Coinvariants.sub_mem_ker (ρ := ρ) a v)
  simpa only [sub_add_cancel] using B.add_mem hd (Submodule.mem_sup_left hv)

/-- The full module has at most twice the seed degree. -/
theorem seed_pair_degree_bound {D : Type*} [Group D]
    (ρ : Representation (ZMod 2) D W) (S : Subgroup D) (g : D)
    (C : Submodule (ZMod 2) W)
    (hpair : S ⊔ S.map (MulAut.conj g).toMonoidHom = ⊤)
    (hseed : (⨆ a : D, C.map (ρ a)) = ⊤)
    (hmove : subspaceCommutator ρ ⊤ S ≤ C) :
    Module.finrank (ZMod 2) W ≤ 2 * Module.finrank (ZMod 2) C := by
  have he := seed_pair_spans ρ S g C hpair hseed hmove
  have hd := C.finrank_sup_add_finrank_inf_eq (C.map (ρ g))
  have hm := C.finrank_map_le (ρ g)
  rw [he,finrank_top] at hd
  omega

omit [Finite W] in
/-- A nontrivial fixed-generated SL₂ action is faithful, including SL₂(2). -/
theorem sl2_fixed_generated_nontrivial_faithful
    (ρ : Representation (ZMod 2) SL(2,F) W) (S : Sylow 2 SL(2,F))
    (hgen : GeneratedByFixedSpace ρ S) (hne : ρ ≠ 1) :
    Function.Injective ρ := by
  let n := Module.finrank (ZMod 2) F
  have hF : Nat.card F = 2^n := by
    simpa only [Nat.card_zmod] using Module.natCard_eq_pow_finrank (K := ZMod 2) (V := F)
  by_cases hn : 2 ≤ n
  · have hlarge : 3 < Nat.card F := by
      rw [hF]
      have hh := Nat.pow_le_pow_right (by decide : 0 < 2) hn
      norm_num at hh
      omega
    let : IsSimpleGroup (Matrix.ProjectiveSpecialLinearGroup (Fin 2) F) :=
      Matrix.ProjectiveSpecialLinearGroup.rank_two_simple hlarge
    let : IsSimpleGroup SL(2,F) := (Theory.PSL2.sl2QuotientEquiv F).isSimpleGroup
    exact ρ.ker_eq_bot_iff.mp (ρ.normal_ker.eq_bot_or_eq_top.resolve_right
      (fun hk => hne (MonoidHom.ker_eq_top_iff.mp hk)))
  have htwo : Nat.card F = 2 := by
    have hp : 1 < Nat.card F := Finite.one_lt_card
    have hnpos : n ≠ 0 := by intro hz; simp [hz] at hF; omega
    have hn1 : n = 1 := by omega
    simpa only [hn1,pow_one] using hF
  let K : Subgroup SL(2,F) := {
    carrier := {a | ∀ v ∈ fixedSpace ρ S, ρ a v = v}
    one_mem' := by intro v _; simp
    mul_mem' := by
      intro a b ha hb v hv
      rw [map_mul,Module.End.mul_apply,hb v hv,ha v hv]
    inv_mem' := by
      intro a ha v hv
      have hh := congrArg (ρ a⁻¹) (ha v hv)
      simpa only [ρ.inv_self_apply] using hh.symm }
  have hSK : (S : Subgroup SL(2,F)) ≤ K := fun a ha v hv => hv ⟨a,ha⟩
  have hproper : K ≠ ⊤ := by
    intro ht
    have hg : (⨆ a : SL(2,F), (fixedSpace ρ S).map (ρ a)) ≤ fixedSpace ρ ⊤ := by
      apply iSup_le
      intro a
      rintro _ ⟨v,hv,rfl⟩ b
      have ha : ρ a v = v := (show a ∈ K from ht.symm ▸ mem_top a) v hv
      rw [ha]
      exact (show b.val ∈ K from ht.symm ▸ mem_top b.val) v hv
    rw [show (⨆ a, (fixedSpace ρ S).map (ρ a)) = ⊤ from hgen] at hg
    apply hne
    apply MonoidHom.ext
    intro a
    exact LinearMap.ext (fun v => hg Submodule.mem_top ⟨a,mem_top a⟩)
  have hKN := Matrix.SpecialLinearGroup.proper_overgroup_le_sylow_normalizer S K hSK hproper
  have hN : normalizer (S : Set SL(2,F)) = (S : Subgroup SL(2,F)) := by
    apply (eq_of_le_of_card_ge (S : Subgroup SL(2,F)).le_normalizer ?_).symm
    rw [Matrix.SpecialLinearGroup.card_sylow_normalizer_even,
      Nat.card_congr (Matrix.SpecialLinearGroup.sylowEquivAdditive F 2 S).symm.toEquiv]
    change Nat.card F * (Nat.card F - 1) ≤ Nat.card F
    rw [htwo]
  have hkS : ρ.ker ≤ (S : Subgroup SL(2,F)) := by
    rw [← hN]
    apply le_trans ?_ hKN
    intro a ha v _
    exact LinearMap.congr_fun ha v
  have hp : IsPGroup 2 ρ.ker := S.isPGroup'.of_injective
    (inclusion hkS) (inclusion_injective hkS)
  have hk : ρ.ker ≤ pCore 2 SL(2,F) := le_sSup ⟨inferInstance,hp⟩
  exact ρ.ker_eq_bot_iff.mp (bot_unique (hk.trans (Matrix.SL2.twoCore_eq_bot F).le))

/-- A Sylow-fixed seed of order at most q containing all Sylow displacements
and generating a nontrivial module gives the actual natural coordinates. -/
theorem sl2_small_seed_natural
    (ρ : Representation (ZMod 2) SL(2,F) W) (S : Sylow 2 SL(2,F))
    (C : Submodule (ZMod 2) W) (hne : ρ ≠ 1)
    (hfix : C ≤ fixedSpace ρ S)
    (hseed : (⨆ a : SL(2,F), C.map (ρ a)) = ⊤)
    (hmove : subspaceCommutator ρ ⊤ S ≤ C)
    (hcard : Nat.card C ≤ Nat.card F) :
    Nat.card W = Nat.card F ^ 2 ∧
      ∃ E : W ≃ₗ[ZMod 2] (Fin 2 → F),
        ∀ a v, E (ρ a v) = Matrix.mulVec a.val (E v) := by
  have hgen : GeneratedByFixedSpace ρ S := by
    apply top_unique
    rw [← hseed]
    exact iSup_mono (fun a => Submodule.map_mono hfix)
  have hf := sl2_fixed_generated_nontrivial_faithful ρ S hgen hne
  have hq : IsQuadratic ρ S := by
    intro a ha b hb v
    exact hfix (hmove (Submodule.subset_span ⟨b,hb,v,Submodule.mem_top,rfl⟩)) ⟨a,ha⟩
  obtain ⟨g,hg⟩ := SetLike.exists_not_mem_of_ne_top (normalizer (S : Set SL(2,F)))
    (Matrix.SpecialLinearGroup.sylow_normalizer_ne_top S)
  have hpair := Matrix.SpecialLinearGroup.sylow_sup_conjugate_eq_top_of_not_mem_normalizer S hg
  have hd := seed_pair_degree_bound ρ S g C hpair hseed hmove
  let n := Module.finrank (ZMod 2) F
  have hF : Nat.card F = 2^n := by
    simpa only [Nat.card_zmod] using Module.natCard_eq_pow_finrank (K := ZMod 2) (V := F)
  have hn : 0 < n := Module.finrank_pos
  have hc : Module.finrank (ZMod 2) C ≤ n := by
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod,hF] at hcard
    exact (Nat.pow_le_pow_iff_right (by decide : 1 < (2:ℕ))).mp hcard
  have hlo := sl2_quadratic_sylow_degree_lower ρ hf S hq hn hF
  have he : Module.finrank (ZMod 2) W = 2*n := by omega
  have horder : Nat.card W = Nat.card F^2 := by
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod,he,hF,←pow_mul]
    congr 1
    omega
  have hnat : IsSourceNatural ρ S n := by
    refine ⟨?_,?_,hq⟩
    · rw [horder,hF,←pow_mul]; congr 1; omega
    · intro h
      have hk : ρ.ker = ⊥ := (MonoidHom.ker_eq_bot_iff ρ).mpr hf
      have hc : _root_.commutator SL(2,F) = ⊥ := bot_unique (h.trans hk.le)
      have hz : center SL(2,F) = ⊤ := (commutator_eq_bot_iff_center_eq_top SL(2,F)).mp hc
      apply Matrix.SpecialLinearGroup.no_normal_sylow F 2 S
      constructor
      intro x hx g
      have hxZ : x ∈ center SL(2,F) := hz.symm ▸ mem_top x
      rw [mem_center_iff.mp hxZ g,mul_inv_cancel_right]
      exact hx
  obtain ⟨_,_,_,_,_,E,hE⟩ := sourceNatural_coordinates_and_consequences ρ hf S hn hF hnat
  exact ⟨horder,E,hE⟩
end Representation.RankOne.QuadraticRecognition
