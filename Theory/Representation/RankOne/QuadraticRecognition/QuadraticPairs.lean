module
public import Theory.Representation.RankOne.QuadraticRecognition.CentralQuotientBounds
public import Theory.Representation.BinaryOffender.IrreducibleExistence
public import Theory.Representation.BinaryOffender.QuadraticQuotient

/-!
# Quadratic pairs on the central quotient of a perfect group

Perfectness kills every new globally fixed vector after quotienting by
C_V(G). Two quadratic generating subgroups then have disjoint commutator
spaces on this literal quotient. Generation of V by translates of C_V(A)
lets this disjointness identify C_V(A) with C_V(t) when t belongs to A and
generates G together with a quadratic subgroup B.

These are the valid perfect-group forms of the steps in DGS85, *Groups and
Graphs*, (5.8)(d) and (5.10)(c), printed pp.109–111. The unrestricted
(5.8)(d) argument cannot infer absence of new fixed vectors merely from
O₂(G)=1. CriticalPairs discharges perfectness for the actual SL₂ and Suzuki
critical models and retains the precise pair and vector-generation premises.
-/

public noncomputable section
open Subgroup Representation.BinaryOffender
namespace Representation.RankOne.QuadraticRecognition
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]

/-- Perfectness prevents new fixed vectors in the actual global-fixed quotient. -/
theorem globalFixedQuotient_fixed_eq_bot [Group.IsPerfect G]
    (ρ : Representation (ZMod 2) G V) : fixedSpace (globalFixedQuotient ρ) ⊤=⊥ := by
  let q := (fixedSpace ρ ⊤).mkQ
  let W := (fixedSpace (globalFixedQuotient ρ) ⊤).comap q
  have hs : (⊤ : Subgroup G) ≤ subspaceStabilizer ρ W := by
    apply le_subspaceStabilizer
    intro g hg v hv
    change q (ρ g v) ∈ fixedSpace (globalFixedQuotient ρ) ⊤
    have he : q (ρ g v)=q v := hv ⟨g,hg⟩
    rw [he]
    exact hv
  have hc : subspaceCommutator ρ W ⊤ ≤ fixedSpace ρ ⊤ := by
    apply Submodule.span_le.mpr
    rintro _ ⟨g,hg,v,hv,rfl⟩
    exact (Submodule.Quotient.eq _).mp (hv ⟨g,hg⟩)
  have hW := le_fixedSpace_of_commutator_le_fixedSpace ρ ⊤ W hs hc
  apply bot_unique
  intro v hv
  obtain ⟨w,rfl⟩ := (fixedSpace ρ ⊤).mkQ_surjective v
  exact (Submodule.Quotient.mk_eq_zero _).mpr (hW hv)

/-- Two quadratic generators have disjoint commutator spaces on the
central quotient of a perfect group. The second space is disjoint from
the whole fixed space of the first actor. -/
theorem quadratic_pair_quotient_decomposition [Group.IsPerfect G]
    (ρ : Representation (ZMod 2) G V) (A B : Subgroup G)
    (hgen : A ⊔ B=⊤) (hA : IsQuadratic ρ A) (hB : IsQuadratic ρ B) :
    let σ := globalFixedQuotient ρ
    Coinvariants.ker σ =
      Coinvariants.ker (σ.comp A.subtype) ⊔ Coinvariants.ker (σ.comp B.subtype) ∧
    Disjoint (Coinvariants.ker (σ.comp A.subtype)) (Coinvariants.ker (σ.comp B.subtype)) ∧
    Disjoint (Coinvariants.ker (σ.comp B.subtype)) (fixedSpace σ A) := by
  let σ := globalFixedQuotient ρ
  have hquad (C : Subgroup G) (hC : IsQuadratic ρ C) : IsQuadratic σ C :=
    quadratic_of_equivariant_surjection ρ σ (fixedSpace ρ ⊤).mkQ
      (fixedSpace ρ ⊤).mkQ_surjective (fun g v => (globalFixedQuotient_mk ρ g v).symm) C hC
  have hmove (C : Subgroup G) (hC : IsQuadratic ρ C) :
      Coinvariants.ker (σ.comp C.subtype) ≤ fixedSpace σ C :=
    (commutator_le_invariants_iff _).mpr (fun a b v => hquad C hC a a.property b b.property v)
  have hd : Disjoint (fixedSpace σ A) (fixedSpace σ B) := by
    apply disjoint_iff.mpr
    rw [←show fixedSpace σ (A ⊔ B)=fixedSpace σ A ⊓ fixedSpace σ B from
      σ.invariants_comp_sup _ _,hgen]
    exact globalFixedQuotient_fixed_eq_bot ρ
  exact ⟨moved_eq_sup_of_generates σ A B hgen,
    hd.mono (hmove A hA) (hmove B hB),hd.symm.mono_left (hmove B hB)⟩
private theorem moved_fixed_le_global_of_pair [Group.IsPerfect G]
    (ρ : Representation (ZMod 2) G V) (A B : Subgroup G)
    (hgen : A ⊔ B=⊤) (hA : IsQuadratic ρ A) (hB : IsQuadratic ρ B) :
    Coinvariants.ker (ρ.comp B.subtype) ⊓ fixedSpace ρ A ≤ fixedSpace ρ ⊤ := by
  let σ := globalFixedQuotient ρ
  let q := (fixedSpace ρ ⊤).mkQ
  have hm : Coinvariants.ker (ρ.comp B.subtype) ≤
      (Coinvariants.ker (σ.comp B.subtype)).comap q := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨b,v⟩,rfl⟩
    change q (ρ b v-v) ∈ Coinvariants.ker (σ.comp B.subtype)
    rw [map_sub,←globalFixedQuotient_mk]
    exact Coinvariants.sub_mem_ker (ρ := σ.comp B.subtype) b (q v)
  intro v hv
  have hf : q v∈fixedSpace σ A := by
    intro a
    change σ a (q v)=q v
    rw [globalFixedQuotient_mk]
    exact congrArg q (hv.2 a)
  have hz : q v=0 := (quadratic_pair_quotient_decomposition ρ A B hgen hA hB).2.2.le_bot
    ⟨hm hv.1,hf⟩
  exact (Submodule.Quotient.mk_eq_zero _).mp hz

/-- The fixed-space equality in DGS (5.10)(c) follows once the actual
perfect rank-one group is generated by t and a quadratic conjugate of A.
The generation of vectors is from C_V(A), exactly as in that source clause. -/
theorem fixedSpace_eq_of_perfect_quadratic_pair [Group.IsPerfect G]
    (ρ : Representation (ZMod 2) G V) (A B : Subgroup G) (t : G) (ht : t∈A)
    (hA : IsQuadratic ρ A) (hB : IsQuadratic ρ B)
    (hgen : zpowers t ⊔ B=⊤) (hspan : GeneratedByFixedSpace ρ A) :
    fixedSpace ρ A=fixedSpace ρ (zpowers t) := by
  have htA : zpowers t ≤ A := zpowers_le.mpr ht
  have hqt : IsQuadratic ρ (zpowers t) := fun a ha b hb v => hA a (htA ha) b (htA hb) v
  have hmt : Coinvariants.ker (ρ.comp (zpowers t).subtype) ≤ fixedSpace ρ A := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨b,v⟩,rfl⟩ a
    exact hA a a.property b (htA b.property) v
  have he := moved_sup_fixed_eq_top ρ A hspan
  rw [moved_eq_sup_of_generates ρ (zpowers t) B hgen] at he
  apply le_antisymm (ρ.invariants_comp_subtype_antitone htA)
  intro v hv
  have hvall : v∈(Coinvariants.ker (ρ.comp (zpowers t).subtype) ⊔
      Coinvariants.ker (ρ.comp B.subtype)) ⊔ fixedSpace ρ A := he.symm ▸ Submodule.mem_top
  obtain ⟨w,hw,a,ha,rfl⟩ := Submodule.mem_sup.mp hvall
  obtain ⟨x,hx,b,hb,rfl⟩ := Submodule.mem_sup.mp hw
  have hbt : b∈fixedSpace ρ (zpowers t) := by
    have hh := (fixedSpace ρ (zpowers t)).sub_mem
      ((fixedSpace ρ (zpowers t)).sub_mem hv (ρ.invariants_comp_subtype_antitone htA ha))
      (ρ.invariants_comp_subtype_antitone htA (hmt hx))
    simpa only [add_sub_cancel_right,add_sub_cancel_left] using hh
  have hbA := ρ.invariants_comp_subtype_antitone (show A≤⊤ from le_top)
    (moved_fixed_le_global_of_pair ρ (zpowers t) B hgen hqt hB ⟨hb,hbt⟩)
  exact (fixedSpace ρ A).add_mem ((fixedSpace ρ A).add_mem (hmt hx) hbA) ha
end Representation.RankOne.QuadraticRecognition
