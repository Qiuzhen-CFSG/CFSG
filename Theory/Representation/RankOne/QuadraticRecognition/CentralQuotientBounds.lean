module
public import Theory.Representation.RankOne.QuadraticRecognition.Generation
public import Theory.Representation.BinaryOffender.PermutationConjugacy
public import Theory.PGroupCore

/-!
# Faithfulness and degree bounds on the quotient by global fixed vectors

A faithful binary action remains faithful on V/C_V(G) when O₂(G)=1:
the quotient kernel acts quadratically on V, so it is an elementary normal
two-subgroup. If two conjugates of A generate G, their fixed-space intersection
is C_V(G), bounding the quotient dimension by twice the fixed codimension of A.

This is the quotient and generation argument in DGS85, Groups and Graphs,
(5.8)(d) and (5.12), printed pp.109,113–114. SuzukiActors applies it to the
actual subgroup generated by two conjugates, without assuming irreducibility.
-/

public noncomputable section
open Subgroup Representation.BinaryOffender
namespace Representation.RankOne.QuadraticRecognition
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]

/-- The invariant subspace of vectors fixed by every original actor. -/
@[expose] def globalFixedSubrepresentation (ρ : Representation (ZMod 2) G V) :
    Subrepresentation ρ where
  toSubmodule := fixedSpace ρ ⊤
  apply_mem_toSubmodule g v hv := by
    rw [show ρ g v = v from hv ⟨g, mem_top g⟩]
    exact hv

/-- The literal quotient by the global fixed space, with the same actors. -/
@[expose] def globalFixedQuotient (ρ : Representation (ZMod 2) G V) :=
  (globalFixedSubrepresentation ρ).quotientRepresentation

/-- The quotient uses the original vector projection. -/
theorem globalFixedQuotient_mk (ρ : Representation (ZMod 2) G V) (g : G) (v : V) :
    globalFixedQuotient ρ g ((fixedSpace ρ ⊤).mkQ v) =
      (fixedSpace ρ ⊤).mkQ (ρ g v) := rfl

/-- Trivial two-core preserves faithfulness on the central quotient. -/
theorem globalFixedQuotient_faithful (ρ : Representation (ZMod 2) G V)
    (hf : Function.Injective ρ) (hcore : pCore 2 G = ⊥) :
    Function.Injective (globalFixedQuotient ρ) := by
  let σ := globalFixedQuotient ρ
  have hq : IsQuadratic ρ σ.ker := by
    intro a _ b hb v
    have he := LinearMap.congr_fun hb ((fixedSpace ρ ⊤).mkQ v)
    have hd : ρ b v - v ∈ fixedSpace ρ ⊤ := (Submodule.Quotient.eq _).mp he
    exact hd ⟨a,mem_top a⟩
  let : IsElementaryAbelian 2 σ.ker := elementary_of_faithful_quadratic ρ hf σ.ker hq
  have hp : σ.ker ≤ pCore 2 G := le_sSup ⟨inferInstance, IsElementaryAbelian.isPGroup 2 σ.ker⟩
  exact (MonoidHom.ker_eq_bot_iff σ).mp (bot_unique (hp.trans hcore.le))

variable [FiniteDimensional (ZMod 2) V]
/-- Two conjugates bound the dimension of the actual central quotient. -/
theorem central_quotient_degree_le_pair (ρ : Representation (ZMod 2) G V)
    (A : Subgroup G) (g : G)
    (hgen : A ⊔ A.map (MulAut.conj g).toMonoidHom = ⊤) :
    Module.finrank (ZMod 2) (V ⧸ fixedSpace ρ ⊤) ≤ 2 * fixedCodim ρ A := by
  let B := A.map (MulAut.conj g).toMonoidHom
  have hi : fixedSpace ρ A ⊓ fixedSpace ρ B = fixedSpace ρ ⊤ := by
    change invariants (ρ.comp A.subtype) ⊓ invariants (ρ.comp B.subtype) = _
    rw [← ρ.invariants_comp_sup, hgen]
    rfl
  have hh := (fixedSpace ρ A).finrank_sup_add_finrank_inf_eq (fixedSpace ρ B)
  have hs := (fixedSpace ρ A ⊔ fixedSpace ρ B).finrank_le
  have hA := fixedCodim_add_finrank ρ A
  have hB := fixedCodim_add_finrank ρ B
  have hc := (fixedSpace ρ ⊤).finrank_quotient_add_finrank
  have he : fixedCodim ρ B = fixedCodim ρ A := fixedCodim_map_conj ρ A g
  rw [hi] at hh
  omega

end Representation.RankOne.QuadraticRecognition
