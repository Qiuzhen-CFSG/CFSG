module
public import Theory.Representation.OrderTwoTransvections
public import Theory.LinearAlgebra.FieldFourTransvectionPairs
public import Theory.Representation.BinaryOffender.QuadraticDualOffender
public import Theory.GroupTheory.PrimeRankElementary
public import Theory.Representation.BinaryOffender.RestrictionComparison
public import Theory.Representation.BinaryOffender.CommutatorRank
public import Theory.ElementaryAbelian.Join
public import Theory.GroupTheory.Involution.Dihedral
public import Theory.GroupTheory.InvolutionOddProduct

/-!
# Quadratic square bounds in groups of two-rank one

Commuting involutions coincide when the two-rank is one. The central
half-power in a dihedral group then makes every product of involutions odd,
so all involutions are conjugate. If one acts as a binary transvection,
all do, and the three-involution bound applies. An involution outside the
triple generated by two others therefore forces displacement at least two.
A faithful quadratic actor is elementary of order at most two, which gives
its square bound.

The actual SU₃(2) and PSU₃(2) matrix applications are in SmallUnitary.
Source: DGS85, *Groups and Graphs*, (5.8)(b), (5.12), pp.109,113–114;
the transvection calculation is the elementary Stellmacher (1.6) argument.
-/

public noncomputable section
open Subgroup Representation.BinaryOffender
namespace Representation.RankOne.QuadraticRecognition
variable {G V : Type*} [Group G] [Finite G]
  [AddCommGroup V] [Module (ZMod 2) V] [Finite V]

local instance (C : Submodule (ZMod 2) V) : Finite (V ⧸ C) :=
  Finite.of_surjective _ C.mkQ_surjective

theorem commuting_involutions_eq_of_two_rank_one
    (hr : primeRank 2 G ≤ 1) {x y : G} (hx : IsInvolution x) (hy : IsInvolution y)
    (hc : Commute x y) : x = y := by
  let E := zpowers x ⊔ zpowers y
  let : IsElementaryAbelian 2 (zpowers x) := IsElementaryAbelian.zpowers_of_pow_eq_one hx.2
  let : IsElementaryAbelian 2 (zpowers y) := IsElementaryAbelian.zpowers_of_pow_eq_one hy.2
  let : IsElementaryAbelian 2 E := IsElementaryAbelian.sup_of_le_centralizer (by
    rintro a ⟨m,rfl⟩ b ⟨n,rfl⟩
    exact (hc.zpow_zpow n m).eq)
  have he : Nat.card E ≤ 2 := by
    simpa using (primeRank_le_iff_elementary_card_le G).mp hr E inferInstance
  have hge : 2 ≤ Nat.card E := by
    have hh := card_le_of_le (show zpowers x ≤ E from le_sup_left)
    rwa [Nat.card_zpowers,orderOf_eq_prime hx.2 hx.1] at hh
  obtain ⟨a,ha,hu⟩ := (Nat.card_eq_two_iff' (1 : E)).mp (le_antisymm he hge)
  have hxe : (⟨x,(show zpowers x ≤ E from le_sup_left) (mem_zpowers x)⟩ : E) ≠ 1 :=
    fun h => hx.1 (congrArg Subtype.val h)
  have hye : (⟨y,(show zpowers y ≤ E from le_sup_right) (mem_zpowers y)⟩ : E) ≠ 1 :=
    fun h => hy.1 (congrArg Subtype.val h)
  exact congrArg Subtype.val ((hu _ hxe).trans (hu _ hye).symm)

theorem odd_product_of_two_rank_one
    (hr : primeRank 2 G ≤ 1) {x y : G} (hx : IsInvolution x) (hy : IsInvolution y) :
    Odd (orderOf (x*y)) := by
  by_cases hxy : x = y
  · rw [hxy,←pow_two,hy.2,orderOf_one]
    decide
  rw [←Nat.not_even_iff_odd]
  rintro ⟨m,hm⟩
  obtain ⟨hz,hzx,hzy⟩ :=
    BenderSuzuki.External.Suzuki.V.suzuki_ch5_proposition_1_2_iii hx hy hxy
      (show orderOf (x*y) = 2*m by omega)
  exact hxy ((commuting_involutions_eq_of_two_rank_one hr hz hx hzx).symm.trans
    (commuting_involutions_eq_of_two_rank_one hr hz hy hzy))

/-- A two-rank-one group with an involution outside a dihedral triple
has no faithful binary transvection action. -/
theorem involution_fixedCodim_ge_two_of_two_rank_one
    (hr : primeRank 2 G ≤ 1)
    (t u x : G) (ht : IsInvolution t) (hu : IsInvolution u) (hx : IsInvolution x)
    (htu : t ≠ u) (hxt : x ≠ t) (hxu : x ≠ u) (hxthird : x ≠ u⁻¹*t*u)
    (ρ : Representation (ZMod 2) G V) (hf : Function.Injective ρ)
    (a : G) (ha : IsInvolution a) : 2 ≤ fixedCodim ρ (zpowers a) := by
  by_contra! hsmall
  have hall (b : G) (hb : IsInvolution b) : fixedCodim ρ (zpowers b) ≤ 1 := by
    obtain ⟨g,hg⟩ := isConj_iff.mp
      (isConj_of_involutions_odd_product a b ha.2 hb.2 (odd_product_of_two_rank_one hr ha hb))
    rw [←hg,fixedCodim_zpowers_conj]
    omega
  have htrans {b : G} (hb : IsInvolution b) :
      LinearMap.GeneralLinearGroup.toLinearEquiv (ρ.asGroupHom b) ∈
        LinearEquiv.transvections (ZMod 2) V := by
    apply LinearEquiv.mem_transvections_of_square_one_rank_one
    · apply LinearEquiv.ext
      intro v
      change ρ b (ρ b v) = v
      rw [←Module.End.mul_apply,←map_mul,←pow_two,hb.2,map_one]
      rfl
    · exact (fixedCodim_zpowers_eq_displacement_rank ρ b) ▸ hall b hb
  have hinj : Function.Injective ρ.asGroupHom := by
    intro b c he
    apply hf
    exact congrArg Units.val he
  rcases three_involutions_of_faithful_transvection_representation ρ hinj
    htrans (fun hb hc hbc => ⟨fun h => hbc (commuting_involutions_eq_of_two_rank_one hr hb hc h),
      odd_product_of_two_rank_one hr hb hc⟩) ht hu htu hx with h | h | h
  · exact hxt h
  · exact hxu h
  · exact hxthird h

/-- The strict quadratic inequality is impossible in a two-rank-one group
with an involution outside a dihedral triple. -/
theorem square_bound_of_two_rank_one
    (hr : primeRank 2 G ≤ 1)
    (t u x : G) (ht : IsInvolution t) (hu : IsInvolution u) (hx : IsInvolution x)
    (htu : t ≠ u) (hxt : x ≠ t) (hxu : x ≠ u) (hxthird : x ≠ u⁻¹*t*u)
    (ρ : Representation (ZMod 2) G V) (hf : Function.Injective ρ)
    (A : Subgroup G) (hq : IsQuadratic ρ A) :
    Nat.card A ^ 2 ≤ Nat.card (V ⧸ fixedSpace ρ A) := by
  let : IsElementaryAbelian 2 A := elementary_of_faithful_quadratic ρ hf A hq
  have hAc : Nat.card A ≤ 2 := by
    simpa using (primeRank_le_iff_elementary_card_le G).mp hr A inferInstance
  by_cases hA : A = ⊥
  · rw [hA,card_bot,one_pow]
    exact Nat.card_pos
  obtain ⟨a,ha,ha1⟩ := A.bot_or_exists_ne_one.resolve_left hA
  have hd := (involution_fixedCodim_ge_two_of_two_rank_one hr t u x ht hu hx htu hxt hxu
    hxthird ρ hf a ⟨ha1,elemPow_eq_one_of_isElementaryAbelian a ha⟩).trans
    (show fixedCodim ρ (zpowers a) ≤ fixedCodim ρ A from by
      have hh := Submodule.finrank_mono (fixedSpace_antitone ρ (zpowers_le.mpr ha))
      have h1 := fixedCodim_add_finrank ρ (zpowers a)
      have h2 := fixedCodim_add_finrank ρ A
      omega)
  have hc : 4 ≤ Nat.card (V ⧸ fixedSpace ρ A) := by
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod]
    exact Nat.pow_le_pow_right (by decide : 1 ≤ (2 : ℕ)) hd
  nlinarith
end Representation.RankOne.QuadraticRecognition
