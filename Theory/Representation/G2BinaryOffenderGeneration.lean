module
public import Theory.Representation.G2NaturalOffenders
public import Theory.GroupTheory.PrimeRankFixedJoin
public import Theory.AtlasPort.LinearGroups.G2.LieSpecialRadical

/-!
# Two-groups generated by binary natural G₂ offenders

Every natural offender in the specified binary Sylow contains its central
highest-root involution. A nonzero last root coordinate would leave at most
four common fixed vectors, contradicting the offender's fixed three-space.
Thus all such offenders lie in the same five-root subgroup. Its explicit
commutator formula bounds the derived subgroup of their whole generated group
by two. One Sylow conjugator transports this conclusion to arbitrary two-groups.

Source: Meierfrankenfeld--Stellmacher, *Pushing up weak BN-pairs of rank two*,
(3.8), printed p.878, the bound on the derived radius image. The actual
radius application is in MarkedMS/G2Reconstruction/DistanceTwo/DistanceFour/RadiusImage.
The octonion root coordinates use the licensed ATLAS port; see LICENSES/ATLAS.txt.
-/

public noncomputable section
set_option backward.isDefEq.respectTransparency false
open Subgroup Representation Representation.BinaryOffender
open scoped commutatorElement
namespace Atlas.G2.Natural.BinaryOffenderGeneration
open Atlas.G2 Atlas.G2.Restricted.NaturalCoordinates Atlas.G2.LieParabolicSetup
local notation "𝔽" => ZMod 2
local notation "H" => Atlas.G2.Model 𝔽
local notation "ρ" => Atlas.G2.Restricted.NaturalCoordinates.action 𝔽

private theorem offender_card (A : Subgroup H) (hA : IsOffender ρ A) : Nat.card A = 8 := by
  obtain ⟨g,rfl⟩ := NaturalOffenders.offender_conjugate_elementary
    (F := 𝔽) (n := 1) (by norm_num) (by decide) A hA
  rw [card_map_of_injective (MulAut.conj g).injective,EvenTwoRank.elementary_card,Nat.card_zmod]
  norm_num

private theorem offender_fixed_card (A : Subgroup H) (hA : IsOffender ρ A) :
    Nat.card (fixedSpace ρ A) = 8 := by
  have hc : fixedCodim ρ A = 3 := by
    obtain ⟨g,rfl⟩ := NaturalOffenders.offender_conjugate_elementary
      (F := 𝔽) (n := 1) (by norm_num) (by decide) A hA
    rw [fixedCodim_map_conj]
    exact NaturalOffenders.fixedCodim_elementary (n := 1) (by norm_num)
  have hs := fixedCodim_add_finrank ρ A
  have ht : Module.finrank 𝔽 (Fin 6 → 𝔽) = 6 := by simp
  rw [hc,ht] at hs
  have hdim : Module.finrank 𝔽 (fixedSpace ρ A) = 3 := by omega
  rw [Module.natCard_eq_pow_finrank (K := 𝔽),Nat.card_zmod,hdim]
  norm_num

private theorem rootA_mem_offender (A : Subgroup H) (hA : IsOffender ρ A)
    (hU : A ≤ unipotent) : rootA (1 : 𝔽) ∈ A := by
  by_contra hn
  let := hA.1.2
  have horder : orderOf (rootA (1 : 𝔽)) = 2 := by
    apply orderOf_eq_prime
    · rw [pow_two,rootA_add,show (1 : 𝔽) + 1 = 0 from by decide,rootA_zero]
    · intro hz
      exact one_ne_zero (rootA_injective (hz.trans rootA_zero.symm))
  have hfix : A ≤ centralizer ({rootA (1 : 𝔽)} : Set H) := by
    intro a ha
    have hu := hU ha
    rw [unipotent_eq_range] at hu
    obtain ⟨t,rfl⟩ := hu
    exact mem_centralizer_singleton_iff.mpr (unipotentProduct_commute_rootA t 1).eq
  have hr := IsElementaryAbelian.primeRank_ge_of_fixed_join A (rootA (1 : 𝔽))
    horder hn hfix (show Nat.card A = 2^3 from offender_card A hA)
  have hu := EvenTwoRank.two_rank 𝔽 (n := 1) (by norm_num)
  norm_num at hu
  omega

private theorem fixed_coordinates (t : Fin 6 → 𝔽) (ht : t 5 = 1)
    (v : Fin 6 → 𝔽) (ha : ρ (rootA 1) v = v)
    (hu : ρ (unipotentProduct t) v = v) :
    v 3 = 0 ∧ v 4 = 0 ∧ v 5 = 0 ∧ v 1 = t 3 * v 2 := by
  have h4 : v 4 = 0 := by simpa [action_rootA] using congrFun ha 0
  have h5 : v 5 = 0 := by simpa [action_rootA] using congrFun ha 1
  have h3 : v 3 = 0 := by
    have he := congrFun hu 2
    simpa [unipotentProduct,map_mul,Module.End.mul_apply,action_rootA,action_rootB,
      action_rootC,action_rootD,action_rootE,action_rootF,ht,h4,h5] using he
  refine ⟨h3,h4,h5,?_⟩
  have he := congrFun hu 0
  simp [unipotentProduct,map_mul,Module.End.mul_apply,action_rootA,action_rootB,
    action_rootC,action_rootD,action_rootE,action_rootF,ht,h3,h4,h5] at he
  linear_combination (norm := (ring_nf; simp [CharTwo.two_eq_zero])) he

/-- Every natural offender in the specified binary Sylow lies in its actual
five-root subgroup. The central highest-root involution forces two fixed
coordinates, and a nonzero last root parameter would leave only four fixed
vectors, whereas an offender fixes eight. -/
theorem offender_le_radical (A : Subgroup H) (hA : IsOffender ρ A)
    (hU : A ≤ unipotent) : A ≤ radical₁ := by
  have hz := rootA_mem_offender A hA hU
  intro a ha
  have hu := hU ha
  rw [unipotent_eq_range] at hu
  obtain ⟨t,rfl⟩ := hu
  refine ⟨t,?_,rfl⟩
  by_contra ht
  have ht1 : t 5 = 1 := ((show ∀ x : 𝔽, x = 0 ∨ x = 1 by decide) (t 5)).resolve_left ht
  let f : fixedSpace ρ A → (Fin 2 → 𝔽) := fun v => ![v.val 0,v.val 2]
  have hf : Function.Injective f := by
    intro v w hvw
    have hv := fixed_coordinates t ht1 v.val (v.property ⟨_,hz⟩) (v.property ⟨_,ha⟩)
    have hw := fixed_coordinates t ht1 w.val (w.property ⟨_,hz⟩) (w.property ⟨_,ha⟩)
    have h0 : v.val 0 = w.val 0 := congrFun hvw 0
    have h2 : v.val 2 = w.val 2 := congrFun hvw 1
    apply Subtype.ext
    ext i
    fin_cases i <;> simp_all
  have hcard := Nat.card_le_card_of_injective f hf
  rw [offender_fixed_card A hA] at hcard
  norm_num [Nat.card_fun,Nat.card_zmod,Nat.card_fin] at hcard

/-- The five-root bound controls the entire generated subgroup's derived
image, including products of different offenders. -/
theorem derived_card_le_two_of_le_radical (P : Subgroup H) (hP : P ≤ radical₁) :
    Nat.card (⁅P,P⁆ : Subgroup H) ≤ 2 := by
  have hd : ⁅P,P⁆ ≤ highestRoot := by
    apply commutator_le.mpr
    intro x hx y hy
    obtain ⟨t,ht,rfl⟩ := hP hx
    obtain ⟨v,hv,rfl⟩ := hP hy
    rw [fiveRoot_commutator t v ht hv]
    exact ⟨Multiplicative.ofAdd _,rfl⟩
  have hc := card_le_of_le hd
  simpa only [card_highestRoot,Nat.card_zmod] using hc

/-- For a two-group generated by natural offenders, one common Sylow
conjugator puts every generator in the same five-root subgroup. -/
theorem generated_offenders_le_conjugate_radical {ι : Sort*}
    (E : ι → Subgroup H) (hp : IsPGroup 2 (⨆ i, E i : Subgroup H))
    (hE : ∀ i, E i = ⊥ ∨ IsOffender ρ (E i)) :
    ∃ g : H, (⨆ i, E i : Subgroup H).map (MulAut.conj g).toMonoidHom ≤ radical₁ := by
  obtain ⟨P,hP⟩ := hp.exists_le_sylow
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq H P (sylow (F := 𝔽))
  have hU : (⨆ i, E i : Subgroup H).map (MulAut.conj g).toMonoidHom ≤ unipotent := by
    have hh := map_mono (f := (MulAut.conj g).toMonoidHom) hP
    change _ ≤ ((g • P : Sylow 2 H) : Subgroup H) at hh
    simpa only [hg,sylow_coe] using hh
  refine ⟨g,?_⟩
  rw [Subgroup.map_iSup]
  apply iSup_le
  intro i
  rcases hE i with hi | hi
  · rw [hi,Subgroup.map_bot]
    exact bot_le
  · apply offender_le_radical
    · refine ⟨hi.1.map_conj g,?_⟩
      rw [fixedCodim_map_conj,rank_map_conj]
      exact hi.2
    · exact (map_mono (le_iSup E i)).trans hU

/-- Products of different natural offenders in one two-group still have a
derived subgroup of order at most two. -/
theorem generated_offenders_derived_card_le_two {ι : Sort*}
    (E : ι → Subgroup H) (hp : IsPGroup 2 (⨆ i, E i : Subgroup H))
    (hE : ∀ i, E i = ⊥ ∨ IsOffender ρ (E i)) :
    Nat.card (⁅⨆ i, E i,⨆ i, E i⁆ : Subgroup H) ≤ 2 := by
  obtain ⟨g,hg⟩ := generated_offenders_le_conjugate_radical E hp hE
  have hb := derived_card_le_two_of_le_radical _ hg
  rwa [←map_commutator,card_map_of_injective (MulAut.conj g).injective] at hb

end Atlas.G2.Natural.BinaryOffenderGeneration
