module

public import Theory.Representation.BinaryTensorThree
public import Theory.Representation.BinaryOffender.CommutatorRank

/-!
# The concrete group acting on the binary nine-dimensional tensor

The group is the subgroup of GL(V) generated by the two tensor factors and
their interchange. Thus its representation is faithful by construction.
The fixed and moved spaces of its actual swapping involution are identified
with the subspaces calculated in BinaryTensorThree. Identifying this generated
group with the abstract wreath product, and classifying its other elements
and subgroups, are separate obligations.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, H.4.4 setup
and H.4.8(5), printed p.383.
-/

@[expose] public section

namespace BinaryTensorThree

/-- The tensor action group generated by the two factors and their interchange. -/
noncomputable def tensorGroup : Subgroup (Space ≃ₗ[ZMod 2] Space) :=
  Subgroup.closure (Set.range baseAction ∪ {flip})

abbrev Group : Type := tensorGroup

instance : Finite Group :=
  Finite.of_injective (fun g : Group => ((g : Space ≃ₗ[ZMod 2] Space) : Space → Space))
    (fun _ _ h => Subtype.ext (LinearEquiv.ext (congrFun h)))

/-- The actual faithful linear action of the generated subgroup. -/
noncomputable def action : Representation (ZMod 2) Group Space where
  toFun g := g.val.toLinearMap
  map_one' := rfl
  map_mul' _ _ := rfl

theorem action_faithful : Function.Injective action := by
  intro g h he
  apply Subtype.ext
  exact LinearEquiv.toLinearMap_injective he

/-- Both tensor factors, with their original markings, lie in the generated group. -/
noncomputable def baseEmbedding : Factor × Factor →* Group :=
  baseAction.codRestrict tensorGroup (fun g =>
    Subgroup.subset_closure (Or.inl ⟨g, rfl⟩))

/-- The literal factor-interchange element of the tensor action group. -/
noncomputable def swap : Group :=
  ⟨flip, Subgroup.subset_closure (Or.inr rfl)⟩

@[simp] theorem action_swap (v : Space) : action swap v = flip v := rfl

@[simp] theorem action_baseEmbedding (g : Factor × Factor) (v : Space) :
    action (baseEmbedding g) v = baseAction g v := rfl

theorem swap_sq : swap ^ 2 = 1 := by
  apply Subtype.ext
  ext v i j
  rfl

theorem swap_ne_one : swap ≠ 1 := by
  intro h
  have he := congrArg (fun g : Group => action g (Pi.single 0 (Pi.single 1 1)) 1 0) h
  change (1 : ZMod 2) = 0 at he
  exact one_ne_zero he

theorem orderOf_swap : orderOf swap = 2 :=
  orderOf_eq_prime swap_sq swap_ne_one

/-- The swapping involution conjugates the two tensor factors. -/
theorem swap_conjugates_base (g : Factor × Factor) :
    swap * baseEmbedding g * swap⁻¹ = baseEmbedding (g.2, g.1) := by
  apply action_faithful
  ext v i j
  change flip (baseAction g (flip v)) i j = baseAction (g.2, g.1) v i j
  rw [flip_baseAction]
  rfl

/-- Cyclic fixed vectors for the group element are the transpose-fixed matrices. -/
theorem fixedSpace_swap :
    Representation.BinaryOffender.fixedSpace action (Subgroup.zpowers swap) =
      LinearMap.ker (flip.toLinearMap - LinearMap.id) := by
  ext v
  rw [Representation.BinaryOffender.mem_fixedSpace_zpowers_iff]
  change flip v = v ↔ flip v - v = 0
  exact sub_eq_zero.symm

/-- Fixed codimension three for the source's actual swapping involution. -/
theorem fixedCodim_swap :
    Representation.BinaryOffender.fixedCodim action (Subgroup.zpowers swap) = 3 := by
  rw [Representation.BinaryOffender.fixedCodim_zpowers_eq_displacement_rank]
  exact finrank_displacement

theorem finrank_fixedSpace_swap :
    Module.finrank (ZMod 2)
      (Representation.BinaryOffender.fixedSpace action (Subgroup.zpowers swap)) = 6 := by
  rw [fixedSpace_swap]
  exact finrank_fixed

end BinaryTensorThree
