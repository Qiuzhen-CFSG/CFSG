module

public import Theory.Representation.SL2SevenCentralProductOffenders.GroupBounds.Core
public import Theory.Representation.SL2SevenCentralProductOffenders.GroupBounds.MatrixCalculations

/-!
# Group bounds for the SL₂(7) central-product obstruction

Let H be generated by its two-core P and the commuting image of SL₂(7),
with preimage of P equal to the center of SL₂(7). The imported core module
proves the full commutator assertion for subgroups outside P and the rank-two
bound for elementary subgroups disjoint from P.

Here an involution a outside P is written as p f(x). Its matrix coordinate
squares to −I and is conjugate to w = [0,-1;1,0]; its commuting coordinate
has fourth power one. Explicit words in three conjugates of p f(w) remove
that coordinate and produce both elementary matrix generators. This proves
that three conjugates of the original, possibly diagonal, involution generate
a subgroup containing the component. Neither a representation nor an offender
classification is an input.

Source motivation: Aschbacher–Smith, combined manuscript (1 March 2004),
C.1.31–34, printed pp.135–137, and B.2.3–5, pp.75–76. The matrix words are
proved in `GroupBounds.MatrixCalculations` by kernel-checked finite calculation.
-/

public section

open Subgroup Theory.GroupTheory
open scoped MatrixGroups
namespace Representation.BinaryOffender.SL2SevenCentralProduct
open MatrixCalculations
local instance : Fact (Nat.Prime 7) := ⟨by decide⟩
variable {G H : Type*} [Group G] [Group H]

private theorem central_twist_word (f : G →* H) (p : H)
    (hp : ∀ x, Commute p (f x)) (hp4 : p ^ 4 = 1) (x y z : G) :
    ((p * f x) * (p * f y) * (p * f z)) ^ 16 = f ((x * y * z) ^ 16) := by
  have he : (p * f x) * (p * f y) * (p * f z) = p ^ 3 * f (x * y * z) := by
    rw [(hp x).symm.mul_mul_mul_comm]
    rw [← map_mul, (hp (x * y)).symm.mul_mul_mul_comm]
    simp only [map_mul, pow_succ, pow_zero, one_mul, mul_assoc]
  rw [he, ((hp (x * y * z)).pow_left 3).mul_pow, ← map_pow]
  have hp48 : (p ^ 3) ^ 16 = 1 := by
    rw [← pow_mul, show 3 * 16 = 4 * 12 by decide, pow_mul, hp4, one_pow]
  rw [hp48, one_mul]

private theorem central_twist_conj (f : G →* H) (p : H)
    (hp : ∀ x, Commute p (f x)) (x z : G) :
    f z * (p * f x) * (f z)⁻¹ = p * f (z * x * z⁻¹) := by
  rw [← mul_assoc, ← (hp z).eq]
  simp only [map_mul, map_inv, mul_assoc]

/-- Three conjugates of a commuting fourth-root twist of w contain the entire
SL₂(7) image. The explicit words remove the commuting factor. -/
theorem central_twist_range_le (f : SL(2, ZMod 7) →* H) (p : H)
    (hp : ∀ x, Commute p (f x)) (hp4 : p ^ 4 = 1) :
    f.range ≤ zpowers (p * f w) ⊔
      zpowers (f u * (p * f w) * (f u)⁻¹) ⊔
      zpowers (f v * (p * f w) * (f v)⁻¹) := by
  let K := zpowers (p * f w) ⊔
    zpowers (f u * (p * f w) * (f u)⁻¹) ⊔
    zpowers (f v * (p * f w) * (f v)⁻¹)
  have ha : p * f w ∈ K := mem_sup_left (mem_sup_left (mem_zpowers _))
  have hb : f u * (p * f w) * (f u)⁻¹ ∈ K :=
    mem_sup_left (mem_sup_right (mem_zpowers _))
  have hc : f v * (p * f w) * (f v)⁻¹ ∈ K := mem_sup_right (mem_zpowers _)
  have hu : u ∈ K.comap f := by
    have h := K.pow_mem (K.mul_mem (K.mul_mem ha hc) hb) 16
    rw [central_twist_conj f p hp w v, central_twist_conj f p hp w u,
      central_twist_word f p hp hp4, upper_word] at h
    exact h
  have hv : v ∈ K.comap f := by
    have h := K.pow_mem (K.mul_mem (K.mul_mem ha hb) hc) 16
    rw [central_twist_conj f p hp w u, central_twist_conj f p hp w v,
      central_twist_word f p hp hp4, lower_word] at h
    exact h
  have hK := upper_lower_generate (K.comap f) hu hv
  rintro _ ⟨x, rfl⟩
  change x ∈ K.comap f
  rw [hK]
  trivial

private theorem scalar_of_mem_center {x : SL(2, ZMod 7)}
    (hx : x ∈ center SL(2, ZMod 7)) : x = 1 ∨ x = -1 := by
  obtain ⟨c, hc, he⟩ := Matrix.SpecialLinearGroup.mem_center_iff.mp hx
  simp only [Fintype.card_fin] at hc
  rcases sq_eq_one_iff.mp hc with rfl | rfl
  · left
    apply Subtype.ext
    simpa using he.symm
  · right
    apply Subtype.ext
    simpa [← Matrix.diagonal_neg] using he.symm

/-- Every involution outside the two-core has two conjugates which, together
with the original involution, generate a subgroup containing the SL₂(7) image. -/
theorem three_conjugates_range_le (f : SL(2, ZMod 7) →* H)
    (hc : ⁅pCore 2 H, f.range⁆ = ⊥)
    (hs : pCore 2 H ⊔ f.range = ⊤)
    (hz : (pCore 2 H).comap f = center SL(2, ZMod 7))
    (a : H) (ha : a ^ 2 = 1) (haP : a ∉ pCore 2 H) :
    ∃ g h : H, f.range ≤ zpowers a ⊔ zpowers (g * a * g⁻¹) ⊔
      zpowers (h * a * h⁻¹) := by
  obtain ⟨p, hpp, l, ⟨x, rfl⟩, hpx⟩ :=
    mem_sup_of_normal_left.mp (show a ∈ pCore 2 H ⊔ f.range by rw [hs]; trivial)
  have hp (y : SL(2, ZMod 7)) : Commute p (f y) :=
    (mem_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hc hpp)
      (f y) ⟨y, rfl⟩).symm
  have hxnc : x ∉ center SL(2, ZMod 7) := by
    intro hx
    have hfP : f x ∈ pCore 2 H := by
      change x ∈ (pCore 2 H).comap f
      rwa [hz]
    exact haP (hpx ▸ (pCore 2 H).mul_mem hpp hfP)
  have hprod : p ^ 2 * f (x ^ 2) = 1 := by
    rw [map_pow, ← (hp x).mul_pow, hpx, ha]
  have hx2 : x ^ 2 ∈ center SL(2, ZMod 7) := by
    rw [← hz]
    change f (x ^ 2) ∈ pCore 2 H
    rw [eq_inv_of_mul_eq_one_right hprod]
    exact (pCore 2 H).inv_mem ((pCore 2 H).pow_mem hpp 2)
  have hxneg : x ^ 2 = -1 := by
    rcases scalar_of_mem_center hx2 with hh | hh
    · rcases involution_scalar x hh with rfl | rfl
      · exact (hxnc (center _).one_mem).elim
      · apply (hxnc ?_).elim
        apply mem_center_iff.mpr
        intro y
        simp
    · exact hh
  have hx4 : x ^ 4 = 1 := by
    rw [show 4 = 2 * 2 by decide, pow_mul, hxneg]
    norm_num
  have hp4 : p ^ 4 = 1 := by
    have ha4 : a ^ 4 = 1 := by rw [show 4 = 2 * 2 by decide, pow_mul, ha, one_pow]
    rw [← hpx, (hp x).mul_pow, ← map_pow, hx4, map_one, mul_one] at ha4
    exact ha4
  obtain ⟨c, hcx⟩ := sqrt_neg_one_conjugate x hxneg
  let f' := f.comp (MulAut.conj c).toMonoidHom
  have hrange : f'.range = f.range := by
    have hr : (MulAut.conj c).toMonoidHom.range = ⊤ :=
      MonoidHom.range_eq_top.mpr (MulAut.conj c).surjective
    rw [MonoidHom.range_comp, hr, ← MonoidHom.range_eq_map]
  have hw : p * f' w = a := by
    simpa [f', MulAut.conj_apply, ← hcx] using hpx
  have hgen := central_twist_range_le f' p (fun y => hp _) hp4
  rw [hrange, hw] at hgen
  exact ⟨f' u, f' v, hgen⟩

end Representation.BinaryOffender.SL2SevenCentralProduct
