module
public import Theory.Representation.BinaryConjugationSection.InvariantPreimage
public import Theory.Representation.BinaryOffender.Defs
public import Stellmacher.OmegaOneCenterMap
public import Mathlib.GroupTheory.Sylow

/-!
# Sylow-fixed generation for literal center sections

The join of the omega-centers of all Sylow two-subgroups is generated by
conjugates of any one of them. Its every equivariant section is therefore
spanned by conjugates of the chosen Sylow fixed space. A normal subgroup
containing a Sylow has the same Sylow-center span, so the conclusion also
holds for the smaller local actor and any specified quotient action. The
supplement version also handles a normal intermediate actor containing the
two-residual: the Sylow supplement centralizes the original seed, so its
conjugates add no generators.

This discharges the fixed-space-generation condition in the published
correction to DGS, *Groups and Graphs* (1985),5.12, at the center sections
used in7.1. No faithfulness or module-recognition conclusion is assumed.
-/

@[expose] public section
open Subgroup
open scoped Pointwise
namespace Representation.BinaryConjugationSection
open BinaryOffender
variable {G D W : Type*} [Group G] [Group D] [AddCommGroup W] [Module (ZMod 2) W]

noncomputable def fixedConjugateSpan (σ : Representation (ZMod 2) D W)
    (S : Subgroup D) : Subrepresentation σ where
  toSubmodule := ⨆ g : D, (fixedSpace σ S).map (σ g)
  apply_mem_toSubmodule g v hv := by
    have hm : (⨆ h : D, (fixedSpace σ S).map (σ h)).map (σ g) ≤
        ⨆ h : D, (fixedSpace σ S).map (σ h) := by
      rw [Submodule.map_iSup]
      apply iSup_le
      intro h
      rintro _ ⟨_, ⟨v, hv, rfl⟩, rfl⟩
      exact (le_iSup (fun a : D => (fixedSpace σ S).map (σ a)) (g * h))
        ⟨v, hv, by rw [map_mul]; rfl⟩
    exact hm ⟨v, hv, rfl⟩

theorem fixedSpace_le_fixedConjugateSpan (σ : Representation (ZMod 2) D W)
    (S : Subgroup D) : fixedSpace σ S ≤ (fixedConjugateSpan σ S).toSubmodule := by
  intro w hw
  exact (le_iSup (fun g : D => (fixedSpace σ S).map (σ g)) 1)
    ⟨w, hw, by simp⟩

private theorem sylow_omega_le_of_normalized
    (H N : Subgroup G) [Finite H] (T : Sylow 2 H)
    (hn : H ≤ normalizer (N : Set G))
    (ht : Stellmacher.omegaOneCenterAmbient ((T : Subgroup H).map H.subtype) ≤ N) :
    (⨆ P : Sylow 2 H,
      Stellmacher.omegaOneCenterAmbient ((P : Subgroup H).map H.subtype)) ≤ N := by
  apply iSup_le
  intro P
  obtain ⟨g, rfl⟩ := MulAction.exists_smul_eq H T P
  rw [Sylow.coe_subgroup_smul, Subgroup.pointwise_smul_def]
  change Stellmacher.omegaOneCenterAmbient
    (((T : Subgroup H).map (MulAut.conj g).toMonoidHom).map H.subtype) ≤ N
  rw [Subgroup.map_map]
  have he : H.subtype.comp (MulAut.conj g).toMonoidHom =
      (MulAut.conj (g : G)).toMonoidHom.comp H.subtype := rfl
  rw [he, ← Subgroup.map_map,
    Stellmacher.omegaOneCenterAmbient_map_injective _ (MulAut.conj (g : G)).injective]
  rintro _ ⟨x, hx, rfl⟩
  exact (mem_normalizer_iff.mp (hn g.property) x).mp (ht hx)

/-- Passing to a normal subgroup containing a Sylow does not change the
literal Sylow omega-center span. -/
theorem sylow_span_eq_of_normal_contains_sylow [Finite G]
    (L : Subgroup G) [L.Normal] (T : Sylow 2 G) (hTL : (T : Subgroup G) ≤ L) :
    (⨆ P : Sylow 2 G, Stellmacher.omegaOneCenterAmbient (P : Subgroup G)) =
      ⨆ P : Sylow 2 L,
        Stellmacher.omegaOneCenterAmbient ((P : Subgroup L).map L.subtype) := by
  have hPL (P : Sylow 2 G) : (P : Subgroup G) ≤ L := by
    obtain ⟨g, rfl⟩ := MulAction.exists_smul_eq G T P
    rw [Sylow.coe_subgroup_smul, Subgroup.pointwise_smul_def]
    change (T : Subgroup G).map (MulAut.conj g).toMonoidHom ≤ L
    rintro _ ⟨x, hx, rfl⟩
    exact (inferInstance : L.Normal).conj_mem x (hTL hx) g
  apply le_antisymm
  · apply iSup_le
    intro P
    have hm : ((P.subtype (hPL P) : Sylow 2 L) : Subgroup L).map L.subtype =
        (P : Subgroup G) := map_subgroupOf_eq_of_le (hPL P)
    rw [← hm]
    exact le_iSup (fun R : Sylow 2 L => Stellmacher.omegaOneCenterAmbient
      ((R : Subgroup L).map L.subtype)) (P.subtype (hPL P))
  · apply iSup_le
    intro P
    obtain ⟨Q, hQ⟩ := P.exists_comap_subtype_eq
    have hm : (P : Subgroup L).map L.subtype = (Q : Subgroup G) := by
      rw [← hQ]
      exact map_subgroupOf_eq_of_le (hPL Q)
    rw [hm]
    exact le_iSup (fun R : Sylow 2 G =>
      Stellmacher.omegaOneCenterAmbient (R : Subgroup G)) Q

/-- Every section of the actual Sylow-center span is generated by its Sylow
fixed-space conjugates, for its specified quotient action. -/
theorem sylow_span_fixedSpace_generated
    (H Z C : Subgroup G) [Finite H]
    (σ : Representation (ZMod 2) D W) (π : H →* D)
    (d : BinaryConjugationSection H Z C (σ.comp π)) (T : Sylow 2 H)
    (hZ : Z = ⨆ P : Sylow 2 H,
      Stellmacher.omegaOneCenterAmbient ((P : Subgroup H).map H.subtype)) :
    (fixedConjugateSpan σ ((T : Subgroup H).map π)).toSubmodule = ⊤ := by
  let P := fixedConjugateSpan σ ((T : Subgroup H).map π)
  let P' : Subrepresentation (σ.comp π) :=
    ⟨P.toSubmodule, fun h _ hw => P.apply_mem_toSubmodule (π h) hw⟩
  have hseed : Stellmacher.omegaOneCenterAmbient ((T : Subgroup H).map H.subtype) ≤ Z := by
    exact (le_iSup (fun P : Sylow 2 H => Stellmacher.omegaOneCenterAmbient
      ((P : Subgroup H).map H.subtype)) T).trans hZ.ge
  have hseedP : Stellmacher.omegaOneCenterAmbient ((T : Subgroup H).map H.subtype) ≤
      d.invariantPreimage P' := by
    intro z hz
    refine (d.mem_invariantPreimage P' z).mpr ⟨hseed hz, ?_⟩
    apply fixedSpace_le_fixedConjugateSpan σ ((T : Subgroup H).map π)
    intro a
    obtain ⟨t, ht, he⟩ := a.property
    change σ (a : D) (d.coordinates ⟨z, hseed hz⟩).toAdd = _
    rw [← he]
    have hfix : (⟨(t : G) * z * (t : G)⁻¹,
        (mem_normalizer_iff.mp (d.normalized t.property) z).mp (hseed hz)⟩ : Z) =
        ⟨z, hseed hz⟩ := by
      apply Subtype.ext
      change (t : G) * z * (t : G)⁻¹ = z
      have hzt := (Stellmacher.mem_omegaOneCenterAmbient_iff _ _).mp hz |>.2.2
      rw [hzt (t : G) (mem_map_of_mem H.subtype ht), mul_inv_cancel_right]
    have hd := d.equivariant t ⟨z, hseed hz⟩
    rw [hfix] at hd
    exact hd.symm
  have hZP : Z ≤ d.invariantPreimage P' := by
    exact hZ.le.trans (sylow_omega_le_of_normalized H _ T
      (d.invariantPreimage_normalized P') hseedP)
  apply top_unique
  intro w _
  obtain ⟨z, hz⟩ := d.onto (Multiplicative.ofAdd w)
  have hw := (d.mem_invariantPreimage P' z).mp (hZP z.property) |>.choose_spec
  rw [hz] at hw
  exact hw

/-- The generation condition remains true for the normal local actor,
provided it contains a Sylow of the original vertex stabilizer. -/
theorem sylow_span_normal_section_generated [Finite G]
    (L Z C : Subgroup G) [L.Normal] (T : Sylow 2 G)
    (hTL : (T : Subgroup G) ≤ L)
    (σ : Representation (ZMod 2) D W) (π : L →* D)
    (d : BinaryConjugationSection L Z C (σ.comp π))
    (hZ : Z = ⨆ P : Sylow 2 G,
      Stellmacher.omegaOneCenterAmbient (P : Subgroup G)) :
    (fixedConjugateSpan σ (((T.subtype hTL : Sylow 2 L) : Subgroup L).map π)).toSubmodule = ⊤ :=
  sylow_span_fixedSpace_generated L Z C σ π d (T.subtype hTL)
    (hZ.trans (sylow_span_eq_of_normal_contains_sylow L T hTL))

end Representation.BinaryConjugationSection

namespace Representation.BinaryConjugationSection
open Subgroup BinaryOffender
open scoped Pointwise
variable {G D W : Type*} [Group G] [Group D] [AddCommGroup W] [Module (ZMod 2) W]

private theorem sylow_span_le_of_normal_supplement [Finite G]
    (L N : Subgroup G) [L.Normal] (S : Sylow 2 G)
    (hLS : L ⊔ (S : Subgroup G) = ⊤) (hn : L ≤ normalizer (N : Set G))
    (hseed : Stellmacher.omegaOneCenterAmbient (S : Subgroup G) ≤ N) :
    (⨆ P : Sylow 2 G, Stellmacher.omegaOneCenterAmbient (P : Subgroup G)) ≤ N := by
  apply iSup_le
  intro P
  obtain ⟨g, rfl⟩ := MulAction.exists_smul_eq G S P
  rw [Sylow.coe_subgroup_smul, Subgroup.pointwise_smul_def]
  change Stellmacher.omegaOneCenterAmbient
    ((S : Subgroup G).map (MulAut.conj g).toMonoidHom) ≤ N
  rw [Stellmacher.omegaOneCenterAmbient_map_injective _ (MulAut.conj g).injective]
  rintro _ ⟨x,hx,rfl⟩
  have hg : g ∈ L ⊔ (S : Subgroup G) := hLS.symm ▸ mem_top g
  obtain ⟨l,hl,s,hs,rfl⟩ := mem_sup_of_normal_left.mp hg
  have hc := (Stellmacher.mem_omegaOneCenterAmbient_iff _ _).mp hx |>.2.2 s hs
  have he : (l*s)*x*(l*s)⁻¹ = l*x*l⁻¹ := by
    calc
      (l*s)*x*(l*s)⁻¹ = l*(s*x*s⁻¹)*l⁻¹ := by group
      _ = l*x*l⁻¹ := by rw [hc,mul_inv_cancel_right]
  change (l*s)*x*(l*s)⁻¹ ∈ N
  rw [he]
  exact (mem_normalizer_iff.mp (hn hl) x).mp (hseed hx)

/-- A normal subgroup supplemented by the original Sylow generates the same
fixed-space section even if it does not contain that Sylow. This is the
intermediate normal-closure situation in the proof of DGS7.1. -/
theorem sylow_span_supplement_section_generated [Finite G]
    (L Z C : Subgroup G) [L.Normal] (S : Sylow 2 G)
    (hLS : L ⊔ (S : Subgroup G) = ⊤) (T : Sylow 2 L)
    (hTS : (T : Subgroup L).map L.subtype ≤ (S : Subgroup G))
    (σ : Representation (ZMod 2) D W) (π : L →* D)
    (d : BinaryConjugationSection L Z C (σ.comp π))
    (hZ : Z = ⨆ P : Sylow 2 G,
      Stellmacher.omegaOneCenterAmbient (P : Subgroup G)) :
    (fixedConjugateSpan σ ((T : Subgroup L).map π)).toSubmodule = ⊤ := by
  let P := fixedConjugateSpan σ ((T : Subgroup L).map π)
  let P' : Subrepresentation (σ.comp π) :=
    ⟨P.toSubmodule, fun l _ hw => P.apply_mem_toSubmodule (π l) hw⟩
  have hseed : Stellmacher.omegaOneCenterAmbient (S : Subgroup G) ≤ Z :=
    (le_iSup (fun R : Sylow 2 G =>
      Stellmacher.omegaOneCenterAmbient (R : Subgroup G)) S).trans hZ.ge
  have hseedP : Stellmacher.omegaOneCenterAmbient (S : Subgroup G) ≤
      d.invariantPreimage P' := by
    intro z hz
    refine (d.mem_invariantPreimage P' z).mpr ⟨hseed hz, ?_⟩
    apply fixedSpace_le_fixedConjugateSpan σ ((T : Subgroup L).map π)
    intro a
    obtain ⟨t,ht,he⟩ := a.property
    change σ (a : D) (d.coordinates ⟨z,hseed hz⟩).toAdd = _
    rw [←he]
    have hfix : (⟨(t : G)*z*(t : G)⁻¹,
        (mem_normalizer_iff.mp (d.normalized t.property) z).mp (hseed hz)⟩ : Z) =
        ⟨z,hseed hz⟩ := by
      apply Subtype.ext
      change (t : G)*z*(t : G)⁻¹ = z
      have hc := (Stellmacher.mem_omegaOneCenterAmbient_iff _ _).mp hz |>.2.2
        (t : G) (hTS (mem_map_of_mem L.subtype ht))
      rw [hc,mul_inv_cancel_right]
    have hd := d.equivariant t ⟨z,hseed hz⟩
    rw [hfix] at hd
    exact hd.symm
  have hZP : Z ≤ d.invariantPreimage P' := hZ.le.trans
    (sylow_span_le_of_normal_supplement L _ S hLS
      (d.invariantPreimage_normalized P') hseedP)
  apply top_unique
  intro w _
  obtain ⟨z,hz⟩ := d.onto (Multiplicative.ofAdd w)
  have hw := (d.mem_invariantPreimage P' z).mp (hZP z.property) |>.choose_spec
  rw [hz] at hw
  exact hw

end Representation.BinaryConjugationSection
