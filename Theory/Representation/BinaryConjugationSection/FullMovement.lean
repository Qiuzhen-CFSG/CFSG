module
public import Theory.Representation.BinaryConjugationSection.CommutatorImage

/-!
# Full movement in literal binary sections

If a section group is generated by its commutators with an actor together with
the coordinate kernel, its binary coordinate space is fully moved by that
actor. The proof identifies the literal commutator image and uses the given
surjective coordinates. This is the section transport used in MS93 (3.6), p.871.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace Representation.BinaryConjugationSection
variable {G : Type*} [Group G] {H S E : Subgroup G}
  {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
  {ρ : Representation (ZMod 2) H V} (d : BinaryConjugationSection H S E ρ)

include d in
theorem subspaceCommutator_eq_top_of_movement (A : Subgroup G) (hAH : A ≤ H)
    (hmove : S = ⁅A,S⁆ ⊔ E) : subspaceCommutator ρ ⊤ (A.subgroupOf H) = ⊤ := by
  have hS : d.imageSpace S = ⊤ := by
    apply top_unique
    intro v _
    obtain ⟨x,hx⟩ := d.onto (Multiplicative.ofAdd v)
    exact (d.mem_imageSpace_iff S v).mpr ⟨x,x.property,congrArg Multiplicative.toAdd hx⟩
  have hc : ⁅A,S⁆ ≤ S := le_normalizer_iff_commutator_le_right.mp (hAH.trans d.normalized)
  have hk : d.coordinates.ker.map d.coordinates = ⊥ := (Subgroup.map_eq_bot_iff _).mpr le_rfl
  have hm := congrArg (fun P : Subgroup G => (P.subgroupOf S).map d.coordinates) hmove
  rw [subgroupOf_self,←MonoidHom.range_eq_map,MonoidHom.range_eq_top.mpr d.onto,
    subgroupOf_sup hc d.kernel_le,Subgroup.map_sup,←d.kernel_eq,hk,
    sup_bot_eq] at hm
  rw [←hS,←d.imageSpace_commutator A S hAH le_rfl,hS]
  apply top_unique
  intro v _
  change Multiplicative.ofAdd v ∈ (⁅A,S⁆.subgroupOf S).map d.coordinates
  rw [←hm]
  trivial
end Representation.BinaryConjugationSection

