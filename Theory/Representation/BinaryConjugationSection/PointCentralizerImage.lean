module

public import Theory.Representation.BinaryConjugationSection.PointStabilizerRank
public import Theory.GroupTheory.PResidual.PrimePowerGeneration
public import Theory.GroupTheory.PResidual.PrimeToTransport

/-!
# The literal point-centralizer image through a central binary section

Odd-order elements fixing a quotient vector fix its actual lift when the
central denominator has order two. Consequently, if the quotient vector
stabilizer is generated by its three-elements, the original centralizer
of the four-group maps onto that entire stabilizer. No assumption on the
full action kernel is required.

Source: Aschbacher--Smith 12.7.16, printed p.844.
-/

public noncomputable section
namespace Representation.BinaryConjugationSection
open Subgroup
variable {G A W : Type*} [Group G] [Finite G] [Group A]
  [AddCommGroup W] [Module (ZMod 2) W] {H U Z : Subgroup G}
  (ρ : Representation (ZMod 2) A W) (π : H →* A)
  (c : BinaryConjugationSection H U Z (ρ.comp π))

omit [Finite G] in
private theorem odd_fixes_lift (hZ : Nat.card Z = 2)
    (hHZ : H ≤ centralizer (Z : Set G)) (a : H) (ha : Odd (orderOf a))
    (v : U) (hf : ρ (π a) (c.coordinates v).toAdd = (c.coordinates v).toAdd) :
    (a : G) * v * (a : G)⁻¹ = v := by
  let v' : U := ⟨a * v * (a : G)⁻¹,
    (mem_normalizer_iff.mp (c.normalized a.property) v).mp v.property⟩
  have he : c.coordinates v' = c.coordinates v := c.equivariant a v |>.trans hf
  have hm : ((v' * v⁻¹ : U) : G) ∈ Z := (c.coordinates_eq_one_iff _).mp (by
    rw [map_mul,map_inv,he,mul_inv_cancel])
  let z := (a : G) * v * (a : G)⁻¹ * (v : G)⁻¹
  have hz : z ^ 2 = 1 := by
    have hh := pow_card_eq_one' (x := (⟨z,hm⟩ : Z))
    rw [hZ] at hh
    exact congrArg Subtype.val hh
  let f : MulAut G := MulAut.conj (a : G)
  have hfv : f v = z * v := by dsimp [f,z]; group
  have hfz : f z = z := by
    change (a : G) * z * (a : G)⁻¹ = z
    rw [← mem_centralizer_iff.mp (hHZ a.property) z hm,mul_inv_cancel_right]
  have htwo : f (f v) = v := by
    rw [hfv,map_mul,hfz,hfv,←mul_assoc,←pow_two,hz,one_mul]
  have hsq : a ^ 2 ∈ (centralizer ({(v:G)} : Set G)).subgroupOf H := by
    apply mem_centralizer_singleton_iff.mpr
    have he : (a:G)^2 * v * ((a:G)^2)⁻¹ = v := by
      calc
        (a:G)^2 * v * ((a:G)^2)⁻¹ = (a:G)*((a:G)*v*(a:G)⁻¹)*(a:G)⁻¹ := by rw [pow_two]; group
        _ = v := htwo
    exact mul_inv_eq_iff_eq_mul.mp he
  have hm := (zpowers_le.mpr hsq)
    (mem_zpowers_pow_iff.mpr (Nat.coprime_two_left.mpr ha))
  exact mul_inv_eq_iff_eq_mul.mpr (mem_centralizer_singleton_iff.mp hm)

/-- The original four-group centralizer maps onto the full marked point
stabilizer when that stabilizer is its own prime-to-three residual. -/
theorem point_centralizer_image (hπ : Function.Surjective π)
    (P : Subgroup G) (hZP : Z ≤ P) (hi : Z.relIndex P = 2)
    (hZ : Nat.card Z = 2) (hHZ : H ≤ centralizer (Z : Set G))
    (v : U) (hv : (v : G) ∈ P) (hvZ : (v : G) ∉ Z)
    (hres : primeToResidual 3 (BinaryNaturalDual.VectorStabilizers.representationStabilizer
      ρ (c.coordinates v).toAdd) = ⊤) :
    ((centralizer (P : Set G)).subgroupOf H).map π =
      BinaryNaturalDual.VectorStabilizers.representationStabilizer ρ (c.coordinates v).toAdd := by
  let S := BinaryNaturalDual.VectorStabilizers.representationStabilizer ρ (c.coordinates v).toAdd
  let R := S.comap π
  let D := (primeToResidual 3 R).map R.subtype
  have hDC : D ≤ (centralizer (P : Set G)).subgroupOf H := by
    apply map_le_iff_le_comap.mpr
    rw [primeToResidual_eq_closure_prime_power]
    apply (closure_le _).mpr
    rintro a ⟨n,hn⟩
    have ha : Odd (orderOf (a:H)) := ((by decide : Odd (3:ℕ)).pow).of_dvd_nat
      (orderOf_dvd_of_pow_eq_one (congrArg Subtype.val hn))
    have hfix := odd_fixes_lift ρ π c hZ hHZ a ha v a.property
    have haC : (a : G) ∈ H ⊓ centralizer ({(v : G)} : Set G) :=
      ⟨a.val.property,mem_centralizer_singleton_iff.mpr (mul_inv_eq_iff_eq_mul.mp hfix)⟩
    rw [inf_centralizer_eq_of_prime_index_supplement H Z P hZP Nat.prime_two hi hHZ v hv hvZ] at haC
    exact haC.2
  have hR : R.map π = S := map_comap_eq_self_of_surjective hπ S
  have him : D.map π = S := by
    rw [show D = (primeToResidual 3 R).map R.subtype from rfl,
      map_embedded_primeToResidual_of_hom,hR,hres,←MonoidHom.range_eq_map,range_subtype]
  apply le_antisymm _ ?_
  swap
  · change S ≤ _
    rw [←him]
    exact map_mono hDC
  rintro _ ⟨a,ha,rfl⟩
  change ρ (π a) (c.coordinates v).toAdd = (c.coordinates v).toAdd
  change (ρ.comp π) a (c.coordinates v).toAdd = (c.coordinates v).toAdd
  rw [←c.equivariant a v]
  congr 2
  apply Subtype.ext
  exact mul_inv_eq_iff_eq_mul.mpr (mem_centralizer_iff.mp ha v hv |>.symm)

end Representation.BinaryConjugationSection
