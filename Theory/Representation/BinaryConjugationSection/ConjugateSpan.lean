module

public import Theory.Representation.BinaryConjugationSection.JoinImage
public import Theory.GroupTheory.ConjugateSpanOrder
public import Mathlib.RepresentationTheory.Subrepresentation

/-!
# Images of literal conjugate spans

An equivariant quotient sends the subgroup generated by conjugates to the
sum of the corresponding linear images. Consequently an invariant subspace
containing the original subgroup image is the whole coordinate space when
that subgroup generates the numerator by conjugation.

The application is the original U₀/V₂ tensor in Aschbacher–Smith 13.8.29(3).
-/

public section
open Subgroup Representation
namespace Representation.BinaryConjugationSection
variable {G W : Type*} [Group G] [AddCommGroup W] [Module (ZMod 2) W]
  {H S E : Subgroup G} {ρ : Representation (ZMod 2) H W}
  (d : BinaryConjugationSection H S E ρ)

theorem imageSpace_self : d.imageSpace S = ⊤ := by
  apply top_unique
  intro w _
  obtain ⟨s, hs⟩ := d.onto (Multiplicative.ofAdd w)
  exact (d.mem_imageSpace_iff S w).mpr ⟨s, s.property, congrArg Multiplicative.toAdd hs⟩

theorem imageSpace_conjugateSpan (B : Subgroup G) (hB : B ≤ S) :
    d.imageSpace (conjugateSpanBy B H) = ⨆ h : H, (d.imageSpace B).map (ρ h) := by
  have he : conjugateSpanBy B H = ⨆ h : H, B.conjBy h.val := by
    apply le_antisymm
    · apply (closure_le _).mpr
      rintro x ⟨h, hh, b, hb, rfl⟩
      exact (le_iSup (fun h : H => B.conjBy h.val) ⟨h,hh⟩) ⟨b,hb,rfl⟩
    · apply iSup_le
      intro h x hx
      obtain ⟨b,hb,rfl⟩ := hx
      exact subset_closure ⟨h,h.property,b,hb,rfl⟩
  rw [he, d.imageSpace_iSup]
  · exact iSup_congr fun h => d.imageSpace_conjBy B hB h
  · intro h x hx
    obtain ⟨b,hb,rfl⟩ := hx
    exact (mem_normalizer_iff.mp (d.normalized h.property) b).mp (hB hb)

theorem generated_image_le (B : Subgroup G) (hS : S = conjugateSpanBy B H)
    (P : Subrepresentation ρ) (hBP : d.imageSpace B ≤ P.toSubmodule) :
    P.toSubmodule = ⊤ := by
  have hB : B ≤ S := hS ▸ le_conjugateSpanBy B H
  apply top_unique
  rw [← d.imageSpace_self]
  rw [congrArg d.imageSpace hS, d.imageSpace_conjugateSpan B hB]
  apply iSup_le
  intro h w hw
  obtain ⟨v,hv,rfl⟩ := hw
  exact P.apply_mem_toSubmodule h (hBP hv)

end Representation.BinaryConjugationSection
