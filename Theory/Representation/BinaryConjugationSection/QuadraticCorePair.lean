/-!
# Quadratic actions on a core generated by two elementary subgroups

The literal quotient Q/Z is elementary when two elementary generators have
commutators in Z. Conjugate generators fixed by an actor give the corrected
Sylow fixed-space generation condition. Original commutators detect global
fixed vectors. Quadratic SL₂ recognition then constructs natural copies,
and the literal section size can force exactly one copy. A central elementary
kernel and one involution outside it then make the whole core elementary.

Source: Delgado--Goldschmidt--Stellmacher, *Groups and Graphs* (1985),
(5.12), pp.113--115, with Stroth's fixed-generation correction, and the
characteristic-two argument in (10.6), pp.157--158. The actual source graph
application is in DGS85/NoncommutingProfile/BTwoSource.
-/

@[expose] public noncomputable section
open Subgroup Representation Representation.BinaryConjugationSection
open Representation.BinaryOffender Representation.RankOne.QuadraticRecognition
open scoped Pointwise MatrixGroups commutatorElement IsMulCommutative
namespace Representation.BinaryConjugationSection
variable {G : Type*} [Group G]
local instance {k : Type*} [Field k] [CharP k 2] : Algebra (ZMod 2) k := ZMod.algebra k 2

/-- The two elementary generators make the literal central section elementary. -/
theorem pair_quotient_elementary (Q Z A C : Subgroup G)
    [(Z.subgroupOf Q).Normal] [IsElementaryAbelian 2 A] [IsElementaryAbelian 2 C]
    (hAQ : A ≤ Q) (hCQ : C ≤ Q) (hZQ : Z ≤ Q)
    (hgen : Q = (A ⊔ C) ⊔ Z) (hcomm : ⁅A,C⁆ ≤ Z) :
    IsElementaryAbelian 2 (Q ⧸ Z.subgroupOf Q) := by
  let q := QuotientGroup.mk' (Z.subgroupOf Q)
  let A' := A.subgroupOf Q
  let C' := C.subgroupOf Q
  let : IsElementaryAbelian 2 A' :=
    IsElementaryAbelian.of_injective (subgroupOfEquivOfLe hAQ).toMonoidHom
      (subgroupOfEquivOfLe hAQ).injective
  let : IsElementaryAbelian 2 C' :=
    IsElementaryAbelian.of_injective (subgroupOfEquivOfLe hCQ).toMonoidHom
      (subgroupOfEquivOfLe hCQ).injective
  let : IsElementaryAbelian 2 (A'.map q) := IsElementaryAbelian.map q
  let : IsElementaryAbelian 2 (C'.map q) := IsElementaryAbelian.map q
  have hAC : ⁅A',C'⁆ ≤ Z.subgroupOf Q := by
    apply commutator_le.mpr
    intro a ha c hc
    exact hcomm (commutator_mem_commutator ha hc)
  have hc : C'.map q ≤ centralizer (A'.map q : Set (Q ⧸ Z.subgroupOf Q)) := by
    apply commutator_eq_bot_iff_le_centralizer.mp
    rw [commutator_comm,←map_commutator,Subgroup.map_eq_bot_iff,QuotientGroup.ker_mk']
    exact hAC
  have htop : (A' ⊔ C') ⊔ Z.subgroupOf Q = ⊤ := by
    rw [←subgroupOf_sup hAQ hCQ,←subgroupOf_sup (sup_le hAQ hCQ) hZQ,←hgen]
    exact subgroupOf_self Q
  have hz : (Z.subgroupOf Q).map q = ⊥ := by
    rw [Subgroup.map_eq_bot_iff,QuotientGroup.ker_mk']
  have hm := congrArg (map q) htop
  rw [Subgroup.map_sup,Subgroup.map_sup,hz,
    sup_bot_eq,map_top_of_surjective q (QuotientGroup.mk'_surjective _)] at hm
  have he := IsElementaryAbelian.sup_of_le_centralizer (p := 2) hc
  rw [hm] at he
  let := he
  exact IsElementaryAbelian.of_surjective (topEquiv (G := Q ⧸ Z.subgroupOf Q)).toMonoidHom
    (topEquiv (G := Q ⧸ Z.subgroupOf Q)).surjective

/-- The corrected generation premise follows from the actual two conjugate
center images. It is independent of recognition or faithfulness. -/
theorem pair_section_generated
    {D W : Type*} [Group D] [AddCommGroup W] [Module (ZMod 2) W]
    (L Q Z A C T : Subgroup G)
    (σ : Representation (ZMod 2) D W) (π : L →* D)
    (d : BinaryConjugationSection L Q Z (σ.comp π))
    (hAQ : A ≤ Q) (hgen : Q = (A ⊔ C) ⊔ Z)
    (g : L) (hconj : C = A.conjBy (g : G)) (hfix : ⁅T,A⁆ ≤ Z) :
    GeneratedByFixedSpace σ ((T.subgroupOf L).map π) := by
  let S := (T.subgroupOf L).map π
  let R := fixedConjugateSpan σ S
  let R' : Subrepresentation (σ.comp π) :=
    ⟨R.toSubmodule,fun a _ hv => R.apply_mem_toSubmodule (π a) hv⟩
  have hA : A ≤ d.invariantPreimage R' := by
    intro a ha
    refine (d.mem_invariantPreimage R' a).mpr ⟨hAQ ha,?_⟩
    apply fixedSpace_le_fixedConjugateSpan σ S
    intro t
    obtain ⟨u,hu,he⟩ := t.property
    change σ t.val (d.coordinates ⟨a,hAQ ha⟩).toAdd = _
    rw [←he]
    exact d.fixed_on_imageSpace_of_commutator_le T A hfix u hu _
      ((d.mem_imageSpace_iff A _).mpr ⟨⟨a,hAQ ha⟩,ha,rfl⟩)
  have hC : C ≤ d.invariantPreimage R' := by
    rw [hconj]
    rintro _ ⟨a,ha,rfl⟩
    exact (mem_normalizer_iff.mp (d.invariantPreimage_normalized R' g.property) a).mp (hA ha)
  have hQ : Q ≤ d.invariantPreimage R' := by
    exact hgen.le.trans (sup_le (sup_le hA hC) (d.kernel_le_invariantPreimage R'))
  apply top_unique
  intro w _
  obtain ⟨q,hq⟩ := d.onto (Multiplicative.ofAdd w)
  have hw := (d.mem_invariantPreimage R' q).mp (hQ q.property) |>.choose_spec
  rw [hq] at hw
  exact hw

/-- Fixed vectors on the actual section are detected by original commutators. -/
theorem section_fixed_bot_of_commutators
    {D W : Type*} [Group D] [AddCommGroup W] [Module (ZMod 2) W]
    (L Q Z : Subgroup G) (σ : Representation (ZMod 2) D W) (π : L →* D)
    (d : BinaryConjugationSection L Q Z (σ.comp π))
    (hfix : ∀ x ∈ Q, (∀ a ∈ L, ⁅a,x⁆ ∈ Z) → x ∈ Z) :
    fixedSpace σ ⊤ = ⊥ := by
  apply bot_unique
  intro w hw
  obtain ⟨x,hx⟩ := d.onto (Multiplicative.ofAdd w)
  have hxZ : (x : G) ∈ Z := by
    apply hfix x x.property
    intro a ha
    let c : Q :=
      ⟨a*x*a⁻¹, (mem_normalizer_iff.mp (d.normalized ha) x).mp x.property⟩ * x⁻¹
    have hc : d.coordinates c = 1 := by
      apply Multiplicative.toAdd.injective
      dsimp only [c]
      rw [map_mul,map_inv]
      change (d.coordinates (⟨a*x*a⁻¹,_⟩ : Q)).toAdd + -(d.coordinates x).toAdd = 0
      rw [←sub_eq_add_neg,d.equivariant ⟨a,ha⟩ x,hx]
      exact sub_eq_zero.mpr (hw ⟨π ⟨a,ha⟩,mem_top _⟩)
    exact (d.coordinates_eq_one_iff c).mp hc
  have he := (d.coordinates_eq_one_iff x).mpr hxZ
  rw [hx] at he
  exact he
/-- Source quotient size forces exactly one natural copy. No faithful-action
assumption is needed: the specified size also excludes the zero module. -/
theorem natural_of_quadratic_pair_size
    {k W : Type*} [Field k] [Finite k] [CharP k 2]
    [AddCommGroup W] [Module (ZMod 2) W] [Finite W]
    (σ : Representation (ZMod 2) SL(2,k) W) (S : Sylow 2 SL(2,k))
    (hq : IsQuadratic σ S) (hgen : GeneratedByFixedSpace σ S)
    (hfix : fixedSpace σ ⊤ = ⊥) (hcard : Nat.card W = Nat.card k ^ 2) :
    ∃ E : W ≃ₗ[ZMod 2] (Fin 2 → k),
      ∀ a w, E (σ a w) = Matrix.mulVec a.val (E w) := by
  obtain ⟨m,e,he⟩ := sl2_natural_copies σ S hq hgen hfix
  have hc := Nat.card_congr e.toEquiv
  simp only [Nat.card_fun,Nat.card_fin] at hc
  rw [hcard] at hc
  have hk : 1 < Nat.card k := by
    let := Fintype.ofFinite k
    rw [Nat.card_eq_fintype_card]
    exact Fintype.one_lt_card
  have hp : 1 < Nat.card k ^ 2 := one_lt_pow₀ hk (by decide)
  have hm : m = 1 := (Nat.pow_right_injective hp (hc.symm.trans (pow_one _).symm))
  subst m
  exact ⟨e.trans (LinearEquiv.funUnique (Fin 1) (ZMod 2) (Fin 2 → k)),
    fun a w => he a w 0⟩

/-- A natural core quotient with a central elementary kernel and an escaping
neighbor-center involution forces the entire original core to be elementary. -/
theorem elementary_core_of_natural_section
    {k W : Type*} [Field k] [Finite k] [CharP k 2]
    [AddCommGroup W] [Module (ZMod 2) W]
    (L Q Z A : Subgroup G) [IsElementaryAbelian 2 Z] [IsElementaryAbelian 2 A]
    (σ : Representation (ZMod 2) SL(2,k) W) (π : L →* SL(2,k))
    (hπ : Function.Surjective π) (d : BinaryConjugationSection L Q Z (σ.comp π))
    (hcentral : Z ≤ centralizer (Q : Set G)) (hAQ : A ≤ Q) (hescape : ¬ A ≤ Z)
    (E : W ≃ₗ[ZMod 2] (Fin 2 → k))
    (he : ∀ a w, E (σ a w) = Matrix.mulVec a.val (E w)) :
    IsElementaryAbelian 2 Q := by
  apply d.elementary_of_transitive hcentral
    (fun z hz => elemPow_eq_one_of_isElementaryAbelian z hz)
  · obtain ⟨a,ha,haZ⟩ := SetLike.not_le_iff_exists.mp hescape
    refine ⟨⟨a,hAQ ha⟩,Subtype.ext (elemPow_eq_one_of_isElementaryAbelian a ha),?_⟩
    exact fun hh => haZ ((d.coordinates_eq_one_iff _).mp hh)
  · intro u v hu hv
    obtain ⟨a,ha⟩ := transitive_of_natural_coordinates σ E he hu hv
    obtain ⟨l,hl⟩ := hπ a
    exact ⟨l,by simpa only [MonoidHom.comp_apply,hl] using ha⟩

/-- Every nonzero quotient with these quadratic Sylow properties contains
at least one natural copy over the actual quotient field. -/
theorem field_square_le_of_quadratic_section
    {k W : Type*} [Field k] [Finite k] [CharP k 2]
    [AddCommGroup W] [Module (ZMod 2) W] [Finite W]
    (σ : Representation (ZMod 2) SL(2,k) W) (S : Sylow 2 SL(2,k))
    (hq : IsQuadratic σ S) (hgen : GeneratedByFixedSpace σ S)
    (hfix : fixedSpace σ ⊤ = ⊥) (hne : 1 < Nat.card W) :
    Nat.card k ^ 2 ≤ Nat.card W := by
  obtain ⟨m,e,_⟩ := sl2_natural_copies σ S hq hgen hfix
  have hc := Nat.card_congr e.toEquiv
  simp only [Nat.card_fun,Nat.card_fin] at hc
  have hm : 0 < m := by
    by_contra! hh
    have hm0 : m = 0 := Nat.eq_zero_of_le_zero hh
    rw [hm0,pow_zero] at hc
    omega
  rw [hc]
  exact Nat.le_self_pow (by omega) _

/-- Complementarity modulo the actual kernel computes the full section index. -/
theorem section_index_of_pair_intersection
    {L Q Z : Subgroup G} {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]
    {ρ : Representation (ZMod 2) L W} (d : BinaryConjugationSection L Q Z ρ)
    (A C : Subgroup G) (hAQ : A ≤ Q) (hCQ : C ≤ Q)
    (hspan : Q = (A ⊔ C) ⊔ Z) (hinter : (A ⊔ Z) ⊓ (C ⊔ Z) = Z) :
    Z.relIndex Q = Z.relIndex A * Z.relIndex C := by
  let := d.kernel_normal
  have hgen : Q = (A ⊔ Z) ⊔ (C ⊔ Z) := hspan.trans (by ac_rfl)
  have hc := d.isCompl_imageSpace (A ⊔ Z) (C ⊔ Z) hgen hinter.symm
  rw [d.imageSpace_sup_kernel A hAQ,d.imageSpace_sup_kernel C hCQ] at hc
  have hp := Nat.card_congr (Submodule.prodEquivOfIsCompl _ _ hc).toEquiv
  rw [Nat.card_prod,d.imageSpace_card_eq_relIndex A hAQ,
    d.imageSpace_card_eq_relIndex C hCQ] at hp
  exact (Nat.card_congr d.quotientEquiv.toEquiv).trans hp.symm

/-- Conjugate generators have equal literal image indices. -/
theorem section_index_square_of_conjugate_pair
    {L Q Z : Subgroup G} {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]
    {ρ : Representation (ZMod 2) L W} (d : BinaryConjugationSection L Q Z ρ)
    (A C : Subgroup G) (hAQ : A ≤ Q) (hCQ : C ≤ Q)
    (hspan : Q = (A ⊔ C) ⊔ Z) (hinter : (A ⊔ Z) ⊓ (C ⊔ Z) = Z)
    (g : L) (hconj : C = A.conjBy (g : G))
    (hnZ : L ≤ normalizer (Z : Set G)) :
    Z.relIndex Q = (Z.relIndex A)^2 := by
  have he : Z.relIndex C = Z.relIndex A := by
    rw [hconj,conjBy]
    conv_lhs => lhs; rw [←mem_normalizer_iff_map_conj_eq.mp (hnZ g.property)]
    exact relIndex_map_map_of_injective Z A (MulAut.conj (g : G)).injective
  rw [d.section_index_of_pair_intersection A C hAQ hCQ hspan hinter,he,pow_two]
end Representation.BinaryConjugationSection
