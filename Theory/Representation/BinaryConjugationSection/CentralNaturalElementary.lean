module
public import Theory.Representation.BinaryConjugationSection
public import Theory.Representation.SpecialLinearNatural
public import Theory.Representation.FirstCohomologyLinearTransport
public import Theory.SpecificGroups.SL2.Affine.Action
public import Theory.GroupTheory.CentralBinaryKernelSquares
public import Mathlib.Algebra.Algebra.ZMod
public import Mathlib.GroupTheory.Commutator.Basic
import Mathlib.Tactic.Group

/-!
# Elementary central covers of nonbinary natural SL₂ sections

A binary natural SL₂ section with a central elementary kernel is itself
an elementary group when the field has more than two elements. Squares are
independent of a lift, and nonzero-vector transitivity makes their value
constant away from the kernel. The seven nonzero vectors generated by
(0,1), (1,0), and (a,0), with a outside {0,1}, force that common square to
be one by the class-two commutator identity.

The conjugation action and literal kernel are retained. This supplies the
exponent calculation for the adapted W subgroup in DGS, *Groups and Graphs*
(1985), printed p.150, following 9.10(6). The nonbinary assumption is essential:
the quaternion group admits the binary natural quotient with central kernel.
-/

open Subgroup
open scoped MatrixGroups commutatorElement
namespace Representation.BinaryConjugationSection

private theorem seven_squares {R : Type*} [Group R] (a b c k : R)
    (h2 : k ^ 2 = 1)
    (ha : a ^ 2 = k) (hb : b ^ 2 = k) (hc : c ^ 2 = k)
    (hab : (a*b)^2 = k) (hac : (a*c)^2 = k)
    (hbc : (b*c)^2 = k) (habc : (a*(b*c))^2 = k)
    (hsa : a ^ 2 ∈ center R)
    (hcomm : ∀ y, ⁅a,y⁆ ∈ center R) : k = 1 := by
  have hmul (y : R) : (a*y)^2 = a^2 * y^2 * ⁅a,y⁆ := by
    symm
    calc
      a^2 * y^2 * ⁅a,y⁆ = ⁅a,y⁆ * (a^2*y^2) := mem_center_iff.mp (hcomm y) _
      _ = a*y*a⁻¹*(y⁻¹*a^2)*y^2 := by simp only [commutatorElement_def, mul_assoc]
      _ = a*y*a⁻¹*(a^2*y⁻¹)*y^2 := by rw [mem_center_iff.mp hsa]
      _ = (a*y)^2 := by simp only [pow_two]; group
  have hkk : k*k = 1 := by simpa only [pow_two] using h2
  have hab' : ⁅a,b⁆ = k := by simpa only [ha, hb, hab, hkk, one_mul] using (hmul b).symm
  have hac' : ⁅a,c⁆ = k := by simpa only [ha, hc, hac, hkk, one_mul] using (hmul c).symm
  have habc' : ⁅a,b*c⁆ = k := by simpa only [ha, hbc, habc, hkk, one_mul] using (hmul (b*c)).symm
  have hh : ⁅a,b*c⁆ = ⁅a,b⁆ * ⁅a,c⁆ := by
    rw [commutatorElement_mul_right_eq_mul_conj]
    have hcent := mem_center_iff.mp (hcomm c) b
    calc
      _ = ⁅a,b⁆ * (b * ⁅a,c⁆) * b⁻¹ := by group
      _ = ⁅a,b⁆ * ⁅a,c⁆ := by rw [hcent]; group
  simpa only [habc', hab', hac', hkk] using hh

variable {G F : Type*} [Group G] [Field F] [CharP F 2]
  [Algebra (ZMod 2) F] {H W Z : Subgroup G}

/-- A marked natural section with actor-central elementary kernel has exponent
 two over a nonbinary field, and hence its full preimage is elementary abelian. -/
public theorem central_natural_elementary
    (π : H →* SL(2,F)) (hπ : Function.Surjective π)
    (d : BinaryConjugationSection H W Z
      (((specialLinearNatural 2).restrictScalars (k := ZMod 2)).comp π))
    (hcentral : Z ≤ centralizer (H : Set G)) [IsElementaryAbelian 2 Z]
    (a : F) (ha0 : a ≠ 0) (ha1 : a ≠ 1) : IsElementaryAbelian 2 W := by
  have hker : d.coordinates.ker ≤ center W := by
    intro z hz
    apply mem_center_iff.mpr
    intro w
    apply Subtype.ext
    exact hcentral ((d.coordinates_eq_one_iff z).mp hz) w (d.section_le w.property)
  have h2 (z : W) (hz : z ∈ d.coordinates.ker) : z^2 = 1 := by
    apply Subtype.ext
    exact elemPow_eq_one_of_isElementaryAbelian (z : G)
      ((d.coordinates_eq_one_iff z).mp hz)
  have hsq (w : W) : w^2 ∈ d.coordinates.ker := by
    rw [MonoidHom.mem_ker, map_pow]
    apply Multiplicative.toAdd.injective
    change (2 : ℕ) • (d.coordinates w).toAdd = 0
    rw [← Nat.cast_smul_eq_nsmul (ZMod 2), ZMod.natCast_self, zero_smul]
  have hcomm (u v : W) : ⁅u,v⁆ ∈ center W := by
    apply hker
    rw [MonoidHom.mem_ker, map_commutatorElement]
    exact commutatorElement_eq_one_iff_mul_comm.mpr (mul_comm _ _)
  have hsame (u v : W) (hu : d.coordinates u ≠ 1) (hv : d.coordinates v ≠ 1) :
      u^2 = v^2 := by
    obtain ⟨g,hg⟩ := Matrix.SL2.exists_mulVec_eq F
      (d.coordinates u).toAdd (d.coordinates v).toAdd hu hv
    obtain ⟨h,rfl⟩ := hπ g
    let u' : W := ⟨h*u*(h:G)⁻¹,
      (mem_normalizer_iff.mp (d.normalized h.property) u).mp u.property⟩
    have he : d.coordinates u' = d.coordinates v :=
      Multiplicative.toAdd.injective ((d.equivariant h u).trans hg)
    have hs := d.coordinates.square_eq_of_map_eq_of_central_binary_kernel hker h2 he
    apply Subtype.ext
    have hs' := congrArg Subtype.val hs
    change ((h:G)*(u:G)*(h:G)⁻¹)^2 = (v:G)^2 at hs'
    have hc : (h:G)*(u:G)^2 = (u:G)^2*h :=
      hcentral ((d.coordinates_eq_one_iff (u^2)).mp (hsq u)) h h.property
    rw [conj_pow, hc, mul_inv_cancel_right] at hs'
    exact hs'
  have hsquare (w : W) : w^2 = 1 := by
    by_cases hw : d.coordinates w = 1
    · exact h2 w hw
    have hvalue (v : Fin 2 → F) (hv : v ≠ 0) (y : W)
        (hy : d.coordinates y = Multiplicative.ofAdd v) : y^2 = w^2 := by
      apply hsame y w _ hw
      rw [hy]
      exact hv
    let va : Fin 2 → F := ![0,1]
    let vb : Fin 2 → F := ![1,0]
    let vc : Fin 2 → F := ![a,0]
    have ha_ne : va ≠ 0 := by intro h; have := congrFun h 1; simp [va] at this
    have hb_ne : vb ≠ 0 := by intro h; have := congrFun h 0; simp [vb] at this
    have hc_ne : vc ≠ 0 := by intro h; exact ha0 (by simpa [vc] using congrFun h 0)
    have hab_ne : va+vb ≠ 0 := by intro h; have := congrFun h 1; simp [va,vb] at this
    have hac_ne : va+vc ≠ 0 := by intro h; have := congrFun h 1; simp [va,vc] at this
    have hbc_ne : vb+vc ≠ 0 := by
      intro h
      have hh : 1+a=0 := by simpa [vb,vc] using congrFun h 0
      exact ha1 ((eq_neg_of_add_eq_zero_right hh).trans (CharTwo.neg_eq _))
    have habc_ne : va+(vb+vc) ≠ 0 := by
      intro h; have := congrFun h 1; simp [va,vb,vc] at this
    obtain ⟨u,hu⟩ := d.onto (Multiplicative.ofAdd va)
    obtain ⟨v,hv⟩ := d.onto (Multiplicative.ofAdd vb)
    obtain ⟨z,hz⟩ := d.onto (Multiplicative.ofAdd vc)
    have hadd (s t : Fin 2 → F) (x y : W)
        (hx : d.coordinates x = Multiplicative.ofAdd s)
        (hy : d.coordinates y = Multiplicative.ofAdd t) :
        d.coordinates (x*y) = Multiplicative.ofAdd (s+t) := by rw [map_mul,hx,hy]; rfl
    have huv := hadd va vb u v hu hv
    have huz := hadd va vc u z hu hz
    have hvz := hadd vb vc v z hv hz
    have huvz := hadd va (vb+vc) u (v*z) hu hvz
    exact seven_squares u v z (w^2) (h2 _ (hsq w))
      (hvalue va ha_ne u hu) (hvalue vb hb_ne v hv) (hvalue vc hc_ne z hz)
      (hvalue (va+vb) hab_ne (u*v) huv) (hvalue (va+vc) hac_ne (u*z) huz)
      (hvalue (vb+vc) hbc_ne (v*z) hvz) (hvalue (va+(vb+vc)) habc_ne (u*(v*z)) huvz)
      (hker (hsq u)) (hcomm u)
  exact {
    is_comm := ⟨fun u v => (Commute.of_orderOf_dvd_two
      (fun w => orderOf_dvd_of_pow_eq_one (hsquare w)) u v).eq⟩
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr hsquare }
end Representation.BinaryConjugationSection
