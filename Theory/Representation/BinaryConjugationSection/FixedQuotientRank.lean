module
public import Theory.Representation.BinaryConjugationSection.PointStabilizerRank
public import Theory.GroupTheory.QuaternionCentralProductResidualRecognition.Residual
public import Mathlib.RepresentationTheory.Intertwining
public import Mathlib.RepresentationTheory.Invariants

/-!
# Cubic stabilizers above a residual-fixed binary kernel

For an equivariant binary quotient, a cubic fixing the image of a vector
has displacement in the kernel. If the two-residual fixes that kernel,
the displacement is fixed by the cubic. Its action on the original vector
then has order dividing both two and three, and is trivial. Thus the
original and quotient stabilizers have the same three-rank: their
subgroups generated by cubic elements give both rank inequalities.

For a literal conjugation section U/Z, this comparison combines with the
central order-two kernel calculation to bound quotient vector stabilizers
by the centralizer of the original plane. No splitting, faithfulness of the
module, or vanishing of the fixed kernel is required.

Source application: Aschbacher–Smith, 14.7.38, printed p.1060,
refs/quasithin.pdf. Arbitrary invariant kernels require the additional
source geometry in 14.7.2(3), and are not covered by this result.
-/

public noncomputable section
open Subgroup
namespace Representation
variable {A W X : Type*} [Group A]
  [AddCommGroup W] [Module (ZMod 2) W] [AddCommGroup X] [Module (ZMod 2) X]

/-- A cubic binary operator cannot have a nonzero fixed displacement. -/
theorem cubic_fixed_of_fixed_displacement (ρ : Representation (ZMod 2) A W)
    (a : A) (ha : a ^ 3 = 1) (v : W)
    (hf : ρ a (ρ a v - v) = ρ a v - v) : ρ a v = v := by
  have hchar (w : W) : w + w = 0 := by
    rw [←two_smul (ZMod 2),show (2 : ZMod 2) = 0 from rfl,zero_smul]
  have hn (w : W) : -w = w := neg_eq_of_add_eq_zero_left (hchar w)
  have htwo : ρ a (ρ a v) = v := by
    rw [map_sub] at hf
    have hh := sub_eq_sub_iff_add_eq_add.mp hf
    rw [hchar] at hh
    exact (add_eq_zero_iff_eq_neg.mp hh).trans (hn v)
  have hthree : ρ a (ρ a (ρ a v)) = v := by
    have hh := LinearMap.congr_fun (congrArg ρ ha) v
    simpa only [map_pow,pow_succ,pow_zero,mul_one,map_mul,Module.End.mul_apply,
      map_one,Module.End.one_apply] using hh
  simpa only [htwo] using hthree

/-- A quotient with two-residual-fixed kernel preserves the three-rank of
all vector stabilizers, on the same actor. -/
theorem threeRank_stabilizer_eq_of_residual_fixed_kernel [Finite A]
    (ρ : Representation (ZMod 2) A W) (σ : Representation (ZMod 2) A X)
    (p : ρ.IntertwiningMap σ)
    (hk : p.toLinearMap.ker ≤ invariants (ρ.comp (pResidual 2 A).subtype))
    (v : W) :
    primeRank 3 (BinaryNaturalDual.VectorStabilizers.representationStabilizer ρ v) =
      primeRank 3 (BinaryNaturalDual.VectorStabilizers.representationStabilizer σ (p v)) := by
  let C := BinaryNaturalDual.VectorStabilizers.representationStabilizer ρ v
  let D := BinaryNaturalDual.VectorStabilizers.representationStabilizer σ (p v)
  have hCD : C ≤ D := by
    intro a ha
    change σ a (p v) = p v
    rw [←p.isIntertwining,show ρ a v = v from ha]
  apply le_antisymm (primeRank_mono 3 hCD)
  rw [←primeRank_primeOrderClosure 3 D]
  apply primeRank_mono 3
  apply (closure_le _).mpr
  intro a ha
  apply cubic_fixed_of_fixed_displacement ρ a (ha.2 ▸ pow_orderOf_eq_one a) v
  have hd : ρ a v - v ∈ p.toLinearMap.ker := by
    change p (ρ a v - v) = 0
    rw [map_sub,p.isIntertwining,show σ a (p v) = p v from ha.1,sub_self]
  have har : a ∈ pResidual 2 A := mem_pResidual_of_orderOf_coprime (by rw [ha.2]; decide)
  exact hk hd ⟨a,har⟩

end Representation

namespace Representation.BinaryConjugationSection
variable {G A W X : Type*} [Group G] [Finite G] [Group A] [Finite A]
  [AddCommGroup W] [Module (ZMod 2) W] [AddCommGroup X] [Module (ZMod 2) X]
  {H U Z : Subgroup G} {ρ : Representation (ZMod 2) H W}

/-- Vector-stabilizer rank in a residual-central quotient still bounds the
centralizer of the original plane, with both literal kernels retained. -/
theorem point_threeRank_le_of_residual_fixed_quotient
    (c : BinaryConjugationSection H U Z ρ)
    (σ : Representation (ZMod 2) A X) (π : H →* A)
    (hπ : Function.Surjective π) (hker : IsPGroup 2 π.ker)
    (p : ρ.IntertwiningMap (σ.comp π))
    (hk : p.toLinearMap.ker ≤ invariants (ρ.comp (pResidual 2 H).subtype))
    (P : Subgroup G) (hZP : Z ≤ P) (hi : Z.relIndex P = 2)
    (hZ : Nat.card Z = 2) (hHZ : H ≤ centralizer (Z : Set G))
    (v : U) (hv : (v : G) ∈ P) (hvZ : (v : G) ∉ Z) :
    primeRank 3 (BinaryNaturalDual.VectorStabilizers.representationStabilizer σ
      (p (c.coordinates v).toAdd)) ≤ primeRank 3 (centralizer (P : Set G)) := by
  let S := BinaryNaturalDual.VectorStabilizers.representationStabilizer σ
    (p (c.coordinates v).toAdd)
  have he : S.comap π = BinaryNaturalDual.VectorStabilizers.representationStabilizer
      (σ.comp π) (p (c.coordinates v).toAdd) := rfl
  rw [←primeRank_comap_eq_of_isTwoGroup_ker 3 (by decide) π hπ hker S,he,
    ←threeRank_stabilizer_eq_of_residual_fixed_kernel ρ (σ.comp π) p hk]
  exact c.point_threeRank_le ρ (MonoidHom.id H) Function.surjective_id
    (by rw [MonoidHom.ker_id]; exact IsPGroup.of_bot) P hZP hi hZ hHZ v hv hvZ

end Representation.BinaryConjugationSection
