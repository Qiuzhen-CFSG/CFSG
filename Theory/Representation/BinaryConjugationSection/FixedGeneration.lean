module
public import Theory.Representation.BinaryConjugationSection.Cover
public import Theory.Representation.BinaryOffender.PermutedSupports
public import Theory.GroupTheory.ConjugateSpanSupplement

/-!
# From linear fixed generation to literal conjugate spans

The subgroup generated by the component orbit of the point-centralizer fixed
space is exactly the linear fixed-generation submodule in original conjugation
coordinates. Source application: Aschbacher–Smith10.2.9, printed p.751.
-/

public noncomputable section
open Subgroup
open scoped IsMulCommutative
namespace Representation.BinaryConjugationSection
variable {G J : Type*} [Group G] [Group J]
  {L W P : Subgroup G} [IsElementaryAbelian 2 W]

/-- The linear fixed-generation statement is precisely the literal original
conjugate-span statement. -/
theorem conjugateSpan_eq_of_fixed_generation
    (q : L →* J) (hq : Function.Surjective q)
    (σ : Representation (ZMod 2) J (Additive W))
    (hσ : ∀ (l : L) (w : Additive W),
      ((σ (q l) w).toMul : G) = l*w.toMul*(l : G)⁻¹)
    (τ : Representation (ZMod 2) P (Additive W))
    (hτ : ∀ (p : P) (w : Additive W),
      ((τ p w).toMul : G) = p*w.toMul*(p : G)⁻¹)
    (hLW : L ≤ normalizer (W : Set G))
    (hgen : ∀ K : Submodule (ZMod 2) (Additive W),
      (∀ j w, w ∈ K → σ j w ∈ K) →
      (∀ w, (∀ p, τ p w = w) → w ∈ K) → K = ⊤) :
    conjugateSpanBy (W ⊓ centralizer (P : Set G)) L = W := by
  let C := conjugateSpanBy (W ⊓ centralizer (P : Set G)) L
  let K : Submodule (ZMod 2) (Additive W) :=
    AddSubgroup.toZModSubmodule (n := 2) (C.subgroupOf W).toAddSubgroup
  have hK : K = ⊤ := by
    apply hgen
    · intro j w hw
      obtain ⟨l,rfl⟩ := hq j
      change ((σ (q l) w).toMul : G) ∈ C
      rw [hσ]
      exact (mem_normalizer_iff.mp (le_normalizer_conjugateSpanBy _ _ l.property) w.toMul).mp hw
    · intro w hw
      apply le_conjugateSpanBy
      refine ⟨w.toMul.property,?_⟩
      intro p hp
      have he := congrArg (fun z : Additive W => (z.toMul : G)) (hw ⟨p,hp⟩)
      rw [hτ] at he
      exact mul_inv_eq_iff_eq_mul.mp he
  apply le_antisymm (conjugateSpanBy_le inf_le_left hLW)
  intro w hw
  exact (show Additive.ofMul (⟨w,hw⟩ : W) ∈ K from hK ▸ Submodule.mem_top)
end Representation.BinaryConjugationSection
