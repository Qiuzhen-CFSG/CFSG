module
public import Theory.Representation.EssentialResidualQuotient
public import Theory.Representation.BinaryConjugationSection.ActionKernel
public import Theory.Representation.BinaryConjugationSection.QuotientSection
public import Theory.Representation.BinaryConjugationSection.SylowGeneration
public import Theory.Representation.NormalPSubgroupKernel
public import Theory.Representation.BinaryOffender.ActionImage
public import Theory.Representation.Quotient
public import Theory.Representation.RankOne.QuadraticRecognition.Generation

/-!
# Residual-moving simple sections with actual Sylow fixed generation

A maximal quotient retaining two-residual movement has an essential simple
socle. Restrict its literal conjugation coordinates to that socle. Residual
fixed vectors vanish there, normal two-subgroups act trivially, and a
nonzero vector fixed by an actual Sylow generates the simple module.
Passing to the faithful action image preserves these properties on the same
vectors and the literal image of that Sylow.

The section numerator and denominator are full preimages under the original
coordinate quotient; no complement is chosen. This constructs a section,
not a fixed-generation assertion for the original whole module.

Source application: DGS, Groups and Graphs (1985), corrected 5.12 and the
replacement argument in 6.4, pp.113--115 and120--121.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender
open Representation.BinaryConjugationSection Representation.RankOne.QuadraticRecognition
namespace Representation
variable {H W : Type*} [Group H] [Finite H] [AddCommGroup W] [Module (ZMod 2) W]
  [FiniteDimensional (ZMod 2) W]
/-- Every irreducible binary module is generated by its actual Sylow fixed space. -/
theorem irreducible_generated_by_sylow_fixed (ρ : Representation (ZMod 2) H W)
    [IsIrreducible ρ] (T : Sylow 2 H) : GeneratedByFixedSpace ρ T := by
  let : Nontrivial W := Subrepresentation.irreducible_module_nontrivial ρ
  have hc : ringChar (ZMod 2) = 2 := ringChar.eq (ZMod 2) 2
  obtain ⟨w,hw,hfix⟩ := pGroup_fix_nonzero_vector
    (by rw [hc]; decide) (by rw [hc]; exact T.isPGroup') (ρ.comp (T : Subgroup H).subtype)
  let U := fixedConjugateSpan ρ (T : Subgroup H)
  have hU : U ≠ ⊥ := by
    intro he
    have hm : w ∈ U.toSubmodule := fixedSpace_le_fixedConjugateSpan ρ T hfix
    rw [he] at hm
    exact hw hm
  have ht : U = ⊤ := (eq_bot_or_eq_top U).resolve_left hU
  exact congrArg Subrepresentation.toSubmodule ht

/-- The faithful image of an irreducible section retains the same Sylow and residual properties. -/
theorem irreducible_image_fixed_properties (ρ : Representation (ZMod 2) H W)
    [IsIrreducible ρ] (hf : fixedSpace ρ (pResidual 2 H) = ⊥) :
    pCore 2 (actionImage ρ) = ⊥ ∧
      fixedSpace (imageRepresentation ρ) (pResidual 2 (actionImage ρ)) = ⊥ ∧
      ∀ T : Sylow 2 H,
        GeneratedByFixedSpace (imageRepresentation ρ)
          (T.mapSurjective (f := actionHom ρ) ρ.asGroupHom.rangeRestrict_surjective) := by
  have he : (imageRepresentation ρ).comp (actionHom ρ) = ρ :=
    MonoidHom.ext (imageRepresentation_actionHom ρ)
  have hir : IsIrreducible (imageRepresentation ρ) :=
    (irreducible_comp_surjective_iff (actionHom ρ)
      ρ.asGroupHom.rangeRestrict_surjective (imageRepresentation ρ)).mp (he.symm ▸ inferInstance)
  let := hir
  refine ⟨?_,?_,?_⟩
  · have hk := normal_p_subgroup_le_ker (imageRepresentation ρ)
      (pCore 2 (actionImage ρ)) pCore_isPGroup
    rw [(MonoidHom.ker_eq_bot_iff _).mpr (imageRepresentation_injective ρ)] at hk
    exact bot_unique hk
  · rw [←map_pResidual_of_surjective 2 (actionHom ρ) ρ.asGroupHom.rangeRestrict_surjective]
    exact (fixedSpace_actionSubgroup ρ (pResidual 2 H)).trans hf
  · intro T
    exact generatedByFixedSpace_of_equivariant_surjection ρ (imageRepresentation ρ)
      (actionHom ρ) LinearMap.id Function.surjective_id (fun _ _ => rfl)
      T (irreducible_generated_by_sylow_fixed ρ T)
end Representation

namespace Representation.BinaryConjugationSection
universe u v
variable {G : Type u} {W : Type v} [Group G] {H V C : Subgroup G} [Finite H]
  [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]
  {ρ : Representation (ZMod 2) H W}

/-- Residual movement produces a literal noncentral simple section with both corrected fixed-space properties. -/
theorem exists_residual_simple_section (d : BinaryConjugationSection H V C ρ)
    (hmove : ¬ pResidual 2 H ≤ ρ.ker) :
    ∃ N : Subrepresentation ρ, ∃ U : Subrepresentation N.quotientRepresentation,
      IsIrreducible U.toRepresentation ∧
      fixedSpace U.toRepresentation (pResidual 2 H) = ⊥ ∧
      (∀ T : Sylow 2 H, GeneratedByFixedSpace U.toRepresentation T) ∧
      pCore 2 H ≤ U.toRepresentation.ker ∧
      Nonempty (BinaryConjugationSection H ((d.quotientSection N).invariantPreimage U)
        (d.invariantPreimage N) U.toRepresentation) := by
  obtain ⟨N,_,_,hi,_,hf,_⟩ := EssentialResidualQuotient.exists_residual_quotient ρ
    (EssentialResidualQuotient.moved_ne_bot_of_not_le_ker ρ _ hmove)
  let U := N.quotientImage (EssentialResidualQuotient.moved ρ (pResidual 2 H))
  let : IsIrreducible U.toRepresentation := hi
  refine ⟨N,U,hi,?_,fun T => irreducible_generated_by_sylow_fixed _ T,
    normal_p_subgroup_le_ker _ _ pCore_isPGroup,⟨(d.quotientSection N).invariantSection U⟩⟩
  apply bot_unique
  intro v hv
  apply Subtype.ext
  have hmem : v.val ∈ fixedSpace N.quotientRepresentation (pResidual 2 H) :=
    fun r => congrArg Subtype.val (hv r)
  change v.val = 0
  simpa only [hf, Submodule.mem_bot] using hmem

/-- The same construction with abstract section vectors, its actual faithful
image, and the kernel recorded as an original commutator preimage. -/
theorem exists_faithful_residual_simple_section (d : BinaryConjugationSection H V C ρ)
    (hmove : ¬ pResidual 2 H ≤ ρ.ker) :
    ∃ U D : Subgroup G, U ≤ V ∧ ∃ (W' : Type v) (_ : AddCommGroup W')
      (_ : Module (ZMod 2) W') (_ : Finite W') (σ : Representation (ZMod 2) H W'),
      Nonempty (BinaryConjugationSection H U D σ) ∧ IsIrreducible σ ∧
      σ.ker.map H.subtype = commutatorPreimage H U D ∧ pCore 2 H ≤ σ.ker ∧
      Function.Injective (imageRepresentation σ) ∧ pCore 2 (actionImage σ) = ⊥ ∧
      fixedSpace (imageRepresentation σ) (pResidual 2 (actionImage σ)) = ⊥ ∧
      ∀ T : Sylow 2 H, ∃ R : Sylow 2 (actionImage σ),
        (R : Subgroup (actionImage σ)) = (T : Subgroup H).map (actionHom σ) ∧
        GeneratedByFixedSpace (imageRepresentation σ) R := by
  obtain ⟨N,J,hi,hfix,_,hcore,⟨s⟩⟩ := d.exists_residual_simple_section hmove
  let U := (d.quotientSection N).invariantPreimage J
  let D := d.invariantPreimage N
  let σ := J.toRepresentation
  let : IsIrreducible σ := hi
  let : Finite J.toSubmodule := Module.finite_of_finite (ZMod 2)
  have hUV : U ≤ V := (d.quotientSection N).invariantPreimage_le J
  obtain ⟨hzero,hres,hgen⟩ := irreducible_image_fixed_properties σ hfix
  refine ⟨U,D,hUV,J.toSubmodule,inferInstance,inferInstance,inferInstance,σ,⟨s⟩,hi,
    s.action_kernel_map s.kernel_normalized,hcore,imageRepresentation_injective σ,hzero,hres,?_⟩
  intro T
  exact ⟨T.mapSurjective σ.asGroupHom.rangeRestrict_surjective,rfl,hgen T⟩

end Representation.BinaryConjugationSection
