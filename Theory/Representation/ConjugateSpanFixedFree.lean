module
public import Theory.Representation.BinarySylowFixedSpace
public import Theory.Representation.CosetOrbitQuotient
public import Theory.Representation.BinaryOffender.ConjugationCommutator

/-!
# Full movement of a fixed-free conjugate span

An elementary binary span generated by a Sylow-fixed seed is the sum of
its commutator and fixed subgroups. Apply the existing odd Sylow-coset
averaging theorem modulo the commutator: each seed vector has a fixed lift.
If the fixed subgroup is trivial, the seed lies in the commutator, hence so
does its entire conjugate span.

The source consumer applies this to every actual amalgam component and
every subgroup of the original omega-center, including both fixed lines.
Source: Aschbacher--Smith B.2.14 and 13.4.7, printed pp.900--901.
-/

public noncomputable section
open Subgroup
open scoped IsMulCommutative commutatorElement
namespace Representation
variable {G : Type*} [Group G] [Finite G]

/-- A Sylow-fixed seed with no fixed vectors in its span is fully moved. -/
theorem conjugateSpan_commutator_eq_of_fixed_free
    (F C : Subgroup G) (S : Sylow 2 C)
    [IsElementaryAbelian 2 (conjugateSpanBy F C)]
    (hSF : F ≤ centralizer (((S : Subgroup C).map C.subtype) : Set G))
    (hfree : conjugateSpanBy F C ⊓ centralizer (C : Set G) = ⊥) :
    ⁅conjugateSpanBy F C,C⁆ = conjugateSpanBy F C := by
  let U := conjugateSpanBy F C
  let R := ⁅U,C⁆
  let E := R.subgroupOf U
  let W : Submodule (ZMod 2) (Additive U) := AddSubgroup.toZModSubmodule 2 E.toAddSubgroup
  let ρ := elementaryRepresentation (p := 2)
    (U.normalizerMonoidHom.comp (inclusion (le_normalizer_conjugateSpanBy F C)))
  have hdisp (c : C) (v : Additive U) : ρ c v - v ∈ W := by
    change (c.val * v.toMul.val * c.val⁻¹) / v.toMul.val ∈ R
    have hh := commutator_mem_commutator c.property v.toMul.property
    rw [commutator_comm] at hh
    simpa only [commutatorElement_def,div_eq_mul_inv] using hh
  have hFR : F ≤ R := by
    intro x hx
    let v : Additive U := Additive.ofMul ⟨x,le_conjugateSpanBy F C hx⟩
    have hv : v ∈ BinaryOffender.fixedSpace ρ S := by
      intro s
      apply Additive.toMul.injective
      apply Subtype.ext
      change s.val.val * x * s.val.val⁻¹ = x
      exact mul_inv_eq_iff_eq_mul.mpr
        (hSF hx s.val.val (mem_map_of_mem C.subtype s.property))
    obtain ⟨w,hw,hm⟩ := BinarySylowFixedSpace.fixed_lift_mod_trivial_quotient ρ S W hdisp v hv
    have hw0 : w = 0 := by
      apply Additive.toMul.injective
      apply Subtype.ext
      apply hfree.le
      refine ⟨w.toMul.property,?_⟩
      intro c hc
      have hh := congrArg (fun u : Additive U => u.toMul.val) (hw ⟨c,hc⟩)
      change c * w.toMul.val * c⁻¹ = w.toMul.val at hh
      exact mul_inv_eq_iff_eq_mul.mp hh
    rw [hw0,sub_zero] at hm
    exact hm
  exact le_antisymm
    (le_normalizer_iff_commutator_le_left.mp (le_normalizer_conjugateSpanBy F C))
    (conjugateSpanBy_le hFR (normalizer_commutator_ge_right U C))

end Representation
