module
public import Theory.Representation.ElementaryPerfectSplit
public import Theory.Representation.BinaryOffender.EquivariantOffender
public import Theory.GroupTheory.ConjugateSpanOrder
public import Stellmacher.OmegaOneCenterMap
/-!
# Saturating a central seed by its fixed vectors

An elementary subgroup inside T has its T-fixed vectors in Ω₁(Z(T)).
If T is generated by its intersection with a specified actor and elements
centralizing the subgroup, an equivariant model supplies those fixed vectors.
Equality of their cardinalities forces the entire omega-center into the
subgroup. Invariance then contains its whole conjugate span.

This general transport is used for the Fano orbit in Aschbacher–Smith
13.4.7, printed p.901; it keeps the literal conjugation action.
-/

public noncomputable section
open scoped IsMulCommutative
open Subgroup Representation.BinaryOffender Stellmacher
namespace Representation
variable {G H M : Type*} [Group G] [Finite G] [Group H]
  [AddCommGroup M] [Module (ZMod 2) M]

/-- A full-size model fixed space contains the original central seed and its orbit. -/
theorem elementary_seed_saturation (T X C U : Subgroup G) [IsElementaryAbelian 2 U]
    (hUT : U ≤ T) (hCU : C ≤ normalizer (U : Set G))
    (hXU : X ≤ normalizer (U : Set G))
    (hT : T ≤ (T ⊓ C) ⊔ centralizer (U : Set G))
    (f : C →* H) (σ : Representation (ZMod 2) H M)
    (e : Representation.Equiv (σ.comp f)
      (elementaryRepresentation (p := 2) (U.normalizerMonoidHom.comp (inclusion hCU))))
    (hc : Nat.card (fixedSpace σ ((T.subgroupOf C).map f)) =
      Nat.card (omegaOneCenterAmbient T)) :
    conjugateSpanBy (omegaOneCenterAmbient T) X ≤ U := by
  let Z := omegaOneCenterAmbient T
  let F := fixedSpace σ ((T.subgroupOf C).map f)
  have hcomm (v : F) : (e v.val).toMul.val ∈ centralizer (T : Set G) := by
    have hs : T ≤ centralizer ({(e v.val).toMul.val} : Set G) := by
      apply hT.trans
      apply sup_le
      · intro c hc
        have hv := v.property ⟨f ⟨c,hc.2⟩,mem_map_of_mem f hc.1⟩
        change σ (f ⟨c,hc.2⟩) v.val = v.val at hv
        have he := LinearMap.congr_fun (e.isIntertwining' ⟨c,hc.2⟩) v.val
        change e (σ (f ⟨c,hc.2⟩) v.val) = _ at he
        rw [hv] at he
        have he' := congrArg (fun w : Additive U => w.toMul.val) he.symm
        change c * (e v.val).toMul.val * c⁻¹ = (e v.val).toMul.val at he'
        exact mem_centralizer_singleton_iff.mpr (mul_inv_eq_iff_eq_mul.mp he')
      · intro q hq
        exact mem_centralizer_singleton_iff.mpr (hq _ (e v.val).toMul.property).symm
    exact fun t ht => mem_centralizer_singleton_iff.mp (hs ht)
  let j : F → Z := fun v => ⟨(e v.val).toMul.val,
    (mem_omegaOneCenterAmbient_iff _ _).mpr ⟨hUT (e v.val).toMul.property,
      elemPow_eq_one_of_isElementaryAbelian _ (e v.val).toMul.property,hcomm v⟩⟩
  have hj : Function.Injective j := by
    intro v w hvw
    have hh : (e v.val).toMul.val = (e w.val).toMul.val := congrArg (fun z : Z => z.val) hvw
    have he : e v.val = e w.val := Additive.toMul.injective (Subtype.ext hh)
    exact Subtype.ext (e.toLinearEquiv.injective he)
  have hsur : Function.Surjective j := (Nat.bijective_iff_injective_and_card j).mpr ⟨hj,hc⟩ |>.2
  apply conjugateSpanBy_le _ hXU
  intro z hz
  obtain ⟨v,hv⟩ := hsur ⟨z,hz⟩
  have hh : (e v.val).toMul.val = z := congrArg (fun z : Z => z.val) hv
  rw [←hh]
  exact (e v.val).toMul.property
end Representation
