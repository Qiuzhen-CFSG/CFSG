module
public import Theory.Representation.BinarySymmetricThreeNormalizer
public import Theory.Representation.BinaryOffender.Homogeneous.Embedding
public import Theory.Representation.BinaryOffender.CommutatorRank
public import Theory.GroupTheory.SylowNormalRestriction
public import Theory.GroupTheory.PrimeOrderSylowArithmetic

/-!
# Sylow-fixed generation in a binary symmetric-three module

The fixed space of an involution generates a fully moved S₃-module: the
inverted cubic tensor decomposition writes the module as that fixed space
plus a cubic translate. Sylow conjugacy gives the assertion for every
Sylow two-subgroup. Consequently, a proper Sylow-fixed seed in a fully
moved normal S₃ support forces four to divide the ambient actor's order.

Source: Aschbacher--Smith 15.1.2, printed p.1085.
-/

public noncomputable section
open Subgroup Representation.BinaryOffender
namespace Representation.BinarySymmetricThreeSeed
open InvertedCubicTensor
variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V]

private theorem card_inverter : Nat.card (zpowers inverter) = 2 := by
  rw [Nat.card_zpowers]
  exact orderOf_eq_prime (by decide +kernel) (by decide +kernel)

private def inverterSylow : Sylow 2 S₃ :=
  (IsPGroup.of_card (G := zpowers inverter) (n := 1) (by simpa only [pow_one] using card_inverter)).toSylow (by
    have hh := (zpowers inverter).card_mul_index
    rw [card_inverter] at hh
    have hc : Nat.card S₃ = 6 := by
      simp only [Nat.card_eq_fintype_card,Fintype.card_perm,Fintype.card_fin]
      decide
    rw [hc] at hh
    have he : (zpowers inverter).index = 3 := by omega
    rw [he]
    decide)

private theorem fixed_inverter_seed_full (σ : Representation (ZMod 2) S₃ V)
    (hm : subspaceCommutator σ ⊤ ⊤ = ⊤) :
    Homogeneous.orbitSpan σ ⊤ (fixedSpace σ (zpowers inverter)) = ⊤ := by
  have hfree := Representation.BinarySymmetricThreeNormalizer.fixedFree_of_full σ hm
  apply top_unique
  intro v _
  obtain ⟨⟨a,b⟩,rfl⟩ := (pairEquiv σ hfree).surjective v
  rw [pairEquiv_apply]
  apply (Homogeneous.orbitSpan σ ⊤ (fixedSpace σ (zpowers inverter))).add_mem
  · apply Homogeneous.le_orbitSpan σ ⊤ _
    exact (mem_fixedSpace_zpowers_iff σ inverter a).mpr
      ((mem_multiplicitySpace σ a).mp a.property)
  · exact (Homogeneous.orbitSpan_invariant σ ⊤ _ (mem_top cubic) b).2
      (Homogeneous.le_orbitSpan σ ⊤ _
        ((mem_fixedSpace_zpowers_iff σ inverter b).mpr
          ((mem_multiplicitySpace σ b).mp b.property)))

/-- A fully moved binary S₃-module is generated by the fixed space of any Sylow two-subgroup. -/
theorem fixed_sylow_seed_full (σ : Representation (ZMod 2) S₃ V)
    (hm : subspaceCommutator σ ⊤ ⊤ = ⊤) (P : Sylow 2 S₃) :
    Homogeneous.orbitSpan σ ⊤ (fixedSpace σ (P : Subgroup S₃)) = ⊤ := by
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq S₃ inverterSylow P
  have hmap : (zpowers inverter).map (MulAut.conj g).toMonoidHom = (P : Subgroup S₃) := by
    have hh := congrArg (fun Q : Sylow 2 S₃ => (Q : Subgroup S₃)) hg
    simp only [Sylow.coe_subgroup_smul,Subgroup.pointwise_smul_def,
      inverterSylow,IsPGroup.toSylow_coe] at hh
    change (zpowers inverter).map (MulAut.conj g).toMonoidHom = (P : Subgroup S₃) at hh
    exact hh
  let τ := σ.comp (MulAut.conj g).toMonoidHom
  have ht : subspaceCommutator τ ⊤ ⊤ = ⊤ := by
    rw [subspaceCommutator_comp_map, map_top_of_surjective (MulAut.conj g).toMonoidHom (MulAut.conj g).surjective]
    exact hm
  have hh := fixed_inverter_seed_full τ ht
  rw [fixedSpace_comp_map,hmap] at hh
  have he := Homogeneous.orbitSpan_map_equivariant τ σ
    (MulAut.conj g).toMonoidHom (LinearMap.id) (fun _ _ => rfl) ⊤
    (fixedSpace σ (P : Subgroup S₃))
  simp only [Submodule.map_id,map_top_of_surjective (MulAut.conj g).toMonoidHom (MulAut.conj g).surjective] at he
  exact he.symm.trans hh
end Representation.BinarySymmetricThreeSeed

namespace Representation.BinarySymmetricThreeSeed
open InvertedCubicTensor
variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V]

/-- If the Sylow-fixed seed fails to generate a fully moved normal S₃ support,
the ambient support action has a Sylow subgroup of order at least four. -/
theorem proper_fixed_sylow_seed_four_dvd (ρ : Representation (ZMod 2) G V)
    (H : Subgroup G) [H.Normal] (j : H ≃* S₃)
    (hm : subspaceCommutator ρ ⊤ H = ⊤) (S : Sylow 2 G)
    (hproper : Homogeneous.orbitSpan ρ H (fixedSpace ρ (S : Subgroup G)) ≠ ⊤) :
    4 ∣ Nat.card G := by
  by_contra hfour
  have hH : Nat.card H = 6 := by
    rw [Nat.card_congr j.toEquiv]
    simp only [Nat.card_eq_fintype_card,Fintype.card_perm,Fintype.card_fin]
    decide
  have hd : 2 ∣ Nat.card G := by
    have hh := H.card_subgroup_dvd_card
    rw [hH] at hh
    exact (show 2 ∣ 6 by decide).trans hh
  have hS : Nat.card S = 2 := S.card_eq_prime_of_dvd_of_not_sq_dvd hd hfour
  obtain ⟨Q,hQ⟩ := S.exists_sylow_map_eq_inf_of_normal H
  have hQc : Nat.card Q = 2 := Q.card_eq_prime_of_dvd_of_not_sq_dvd
    (by rw [hH]; decide) (by rw [hH]; decide)
  have hQS : (Q : Subgroup H).map H.subtype = (S : Subgroup G) := by
    apply eq_of_le_of_card_ge (by rw [hQ]; exact inf_le_left)
    rw [card_map_of_injective H.subtype_injective,hS,hQc]
  let P : Sylow 2 S₃ := Q.mapSurjective (f := j.toMonoidHom) j.surjective
  let k : S₃ →* G := H.subtype.comp j.symm.toMonoidHom
  let σ := ρ.comp k
  have hktop : (⊤ : Subgroup S₃).map k = H := by
    rw [show k = H.subtype.comp j.symm.toMonoidHom from rfl,←map_map,
      map_top_of_surjective _ j.symm.surjective,←MonoidHom.range_eq_map,H.range_subtype]
  have hPk : (P : Subgroup S₃).map k = (S : Subgroup G) := by
    change ((Q : Subgroup H).map j.toMonoidHom).map k = _
    rw [map_map]
    have he : k.comp j.toMonoidHom = H.subtype := by
      ext x
      simp only [MonoidHom.comp_apply,k,MulEquiv.coe_toMonoidHom,MulEquiv.symm_apply_apply]
    rw [he]
    exact hQS
  have hσ : subspaceCommutator σ ⊤ ⊤ = ⊤ := by
    rw [subspaceCommutator_comp_map,hktop]
    exact hm
  have hh := fixed_sylow_seed_full σ hσ P
  rw [fixedSpace_comp_map,hPk] at hh
  have he := Homogeneous.orbitSpan_map_equivariant σ ρ k
    (LinearMap.id) (fun _ _ => rfl) ⊤ (fixedSpace ρ (S : Subgroup G))
  simp only [Submodule.map_id,hktop] at he
  exact hproper (he.symm.trans hh)
end Representation.BinarySymmetricThreeSeed

