module

public import Theory.Representation.SL2OrthogonalCover.OuterSemilinear
public import Theory.Representation.SL2OrthogonalCover.FullFixed.Geometry
public import Theory.SpecificGroups.PSL2.ElementaryAutomorphisms.FieldDegree
import Mathlib.Tactic.Abel

/-!
# Singular generation in an orthogonal cover fixed by an outer involution

Fixed natural vectors span the plane over the coefficient field: trace-one
averaging expresses any vector as a linear combination of two fixed vectors.
The nondegenerate polar pairing therefore supplies two fixed natural vectors
with nonzero pairing. Their unique singular lifts, together with the lift of
their sum, have a nonzero fixed sum in the radical.

Every fixed radical vector is a fixed-field scalar multiple of this sum, so it
belongs to the additive subgroup generated by fixed singular vectors. Subtracting
the unique singular lift of the natural image proves the same membership for
every fixed vector of the cover. The field-four case is included.

The outer-actor wrapper constructs the semilinear coefficient, quotient actor,
and preservation of singularity from the literal SL₂ intertwining identities.
The marked group adapter applies the result to any homomorphic image: a subgroup
containing the images of the fixed singular vectors contains the image of the
whole fixed cover.

Source: Aschbacher–Smith, the noncentral-block field case in Lemma 2.4.21,
printed p.536, using the orthogonal cover of I.2.3 and the field-involution
structure of 2.4.12(2), manuscript of 1 March 2004.
-/

public section
noncomputable section

namespace Representation.SL2OrthogonalCover
open Matrix FullFixed
variable {F : Type*} [Field F] [Finite F] [CharP F 2] [Algebra (ZMod 2) F]

omit [Finite F] in
private theorem span_fixed_plane (σ : F ≃+* F) (hσ : Function.Involutive σ)
    (hσne : σ ≠ RingEquiv.refl F) (e : Plane F ≃ₗ[ZMod 2] Plane F)
    (he : Function.Involutive e) (hsemi : ∀ c v, e (c • v) = σ c • e v) :
    Submodule.span F {v : Plane F | e v = v} = ⊤ := by
  obtain ⟨t, ht⟩ := (Theory.PSL2.fixed_iff_exists_add_conjugate σ hσ hσne (1 : F)).mp (map_one σ)
  have htwo (v : Plane F) : v + v = 0 := by ext i; exact CharTwo.add_self_eq_zero _
  apply top_unique
  intro v _
  let x := v + e v
  let y := σ t • v + t • e v
  have hx : e x = x := by dsimp [x]; rw [map_add, he, add_comm]
  have hy : e y = y := by dsimp [y]; rw [map_add, hsemi, hsemi, he, hσ, add_comm]
  have hv : t • x + y = v := by
    dsimp [x,y]
    rw [smul_add]
    calc
      t • v + t • e v + (σ t • v + t • e v) =
          (t + σ t) • v + (t • e v + t • e v) := by rw [add_smul]; abel
      _ = v := by rw [ht, one_smul, htwo, add_zero]
  rw [← hv]
  exact Submodule.add_mem _ (Submodule.smul_mem _ t (Submodule.subset_span hx))
    (Submodule.subset_span hy)

omit [Finite F] in
private theorem exists_fixed_pair (σ : F ≃+* F) (hσ : Function.Involutive σ)
    (hσne : σ ≠ RingEquiv.refl F) (e : Plane F ≃ₗ[ZMod 2] Plane F)
    (he : Function.Involutive e) (hsemi : ∀ c v, e (c • v) = σ c • e v) :
    ∃ v w : Plane F, e v = v ∧ e w = w ∧ pairing v w ≠ 0 := by
  have hs := span_fixed_plane σ hσ hσne e he hsemi
  by_contra h
  push Not at h
  have hz (v : Plane F) (hv : e v = v) : v = 0 := by
    apply pairing_nondegenerate.1
    intro w
    have hker : Submodule.span F {v : Plane F | e v = v} ≤ (pairing v).ker := by
      apply Submodule.span_le.mpr
      intro w hw
      exact h v w hv hw
    exact hker (by rw [hs]; trivial)
  have hb : Submodule.span F {v : Plane F | e v = v} ≤ ⊥ :=
    Submodule.span_le.mpr (fun v hv => hz v hv)
  have h10 : (![1,0] : Plane F) = 0 := hb (by rw [hs]; trivial)
  exact one_ne_zero (congrFun h10 0)


private theorem exists_fixed_singular_lift
    (E : Space F ≃ₗ[ZMod 2] Space F) (e : Plane F ≃ₗ[ZMod 2] Plane F)
    (hover : ∀ u, projection (E u) = e (projection u))
    (hsing : ∀ u, form u = 0 → form (E u) = 0)
    (v : Plane F) (hv : e v = v) :
    ∃ u : Space F, E u = u ∧ form u = 0 ∧ projection u = v := by
  obtain ⟨u, hu, huf⟩ := exists_singular v
  refine ⟨u, ?_, huf, hu⟩
  exact singular_unique (E u) u (by rw [hover, hu, hv]) (hsing u huf) huf

private theorem exists_fixed_radical_sum
    (σ : F ≃+* F) (hσ : Function.Involutive σ) (hσne : σ ≠ RingEquiv.refl F)
    (E : Space F ≃ₗ[ZMod 2] Space F) (e : Plane F ≃ₗ[ZMod 2] Plane F)
    (he : Function.Involutive e) (hsemi : ∀ c v, e (c • v) = σ c • e v)
    (hover : ∀ u, projection (E u) = e (projection u))
    (hsing : ∀ u, form u = 0 → form (E u) = 0) :
    ∃ u v w : Space F,
      (E u = u ∧ form u = 0) ∧ (E v = v ∧ form v = 0) ∧
      (E w = w ∧ form w = 0) ∧ projection (u + v - w) = 0 ∧ u + v - w ≠ 0 := by
  obtain ⟨x,y,hx,hy,hxy⟩ := exists_fixed_pair σ hσ hσne e he hsemi
  obtain ⟨u,hu,huf,hux⟩ := exists_fixed_singular_lift E e hover hsing x hx
  obtain ⟨v,hv,hvf,hvy⟩ := exists_fixed_singular_lift E e hover hsing y hy
  obtain ⟨w,hw,hwf,hwxy⟩ := exists_fixed_singular_lift E e hover hsing (x+y)
    (by rw [map_add,hx,hy])
  refine ⟨u,v,w,⟨hu,huf⟩,⟨hv,hvf⟩,⟨hw,hwf⟩,?_,?_⟩
  · rw [map_sub,map_add,hux,hvy,hwxy,sub_self]
  · intro hz
    have heq : u + v = w := sub_eq_zero.mp hz
    apply hxy
    rw [←hux,←hvy]
    have hp := polar_apply u v
    rw [QuadraticMap.polarBilin_apply_apply,QuadraticMap.polar,huf,hvf,
      sub_zero,sub_zero,heq,hwf] at hp
    exact hp.symm

/-- Fixed vectors of a semilinear involution are generated additively by fixed
singular vectors, with the natural quotient and singular preservation marked. -/
theorem fixed_mem_closure_singular_of_semilinear
    (σ : F ≃+* F) (hσ : Function.Involutive σ) (hσne : σ ≠ RingEquiv.refl F)
    (E : Space F ≃ₗ[ZMod 2] Space F) (hE : Function.Involutive E)
    (hsemi : ∀ c u, E (c • u) = σ c • E u)
    (e : Plane F ≃ₗ[ZMod 2] Plane F)
    (hover : ∀ u, projection (E u) = e (projection u))
    (hsing : ∀ u, form u = 0 → form (E u) = 0)
    (x : Space F) (hx : E x = x) :
    x ∈ AddSubgroup.closure {u : Space F | E u = u ∧ form u = 0} := by
  have he : Function.Involutive e := by
    intro v
    obtain ⟨u,rfl⟩ := projection_surjective v
    rw [←hover,←hover,hE]
  have hsemie : ∀ c v, e (c • v) = σ c • e v := by
    intro c v
    obtain ⟨u,rfl⟩ := projection_surjective v
    rw [←map_smul,←hover,hsemi,map_smul,hover]
  obtain ⟨u,v,w,hu,hv,hw,hp,hn⟩ := exists_fixed_radical_sum
    σ hσ hσne E e he hsemie hover hsing
  let r := u+v-w
  have hrE : E r = r := by dsimp [r]; rw [map_sub,map_add,hu.1,hv.1,hw.1]
  have hr1 : r 1 = 0 := congrFun hp 0
  have hr2 : r 2 = 0 := congrFun hp 1
  have hr0 : r 0 ≠ 0 := by
    intro hz
    apply hn
    change r = 0
    ext i; fin_cases i <;> assumption
  let C := AddSubgroup.closure {u : Space F | E u = u ∧ form u = 0}
  have hrad (z : Space F) (hz : E z = z) (hzp : projection z = 0) : z ∈ C := by
    have hz1 : z 1 = 0 := congrFun hzp 0
    have hz2 : z 2 = 0 := congrFun hzp 1
    let c := z 0 / r 0
    have hcz : c • r = z := by
      ext i
      fin_cases i
      · change z 0 / r 0 * r 0 = z 0
        exact div_mul_cancel₀ _ hr0
      · simp [hr1,hz1]
      · simp [hr2,hz2]
    have hc : σ c = c := by
      have hf : σ c • r = c • r := by
        calc
          σ c • r = E (c • r) := by rw [hsemi,hrE]
          _ = c • r := by rw [hcz,hz]
      have hf0 := congrFun hf 0
      exact mul_right_cancel₀ hr0 hf0
    have hscaled (a : Space F) (ha : E a = a ∧ form a = 0) : c • a ∈ C := by
      apply AddSubgroup.subset_closure
      refine ⟨by rw [hsemi,hc,ha.1], ?_⟩
      rw [QuadraticMap.map_smul,ha.2,smul_zero]
    rw [←hcz]
    change c • (u+v-w) ∈ C
    rw [smul_sub,smul_add]
    exact C.sub_mem (C.add_mem (hscaled u hu) (hscaled v hv)) (hscaled w hw)
  obtain ⟨y,hy,hyf,hyp⟩ := exists_fixed_singular_lift E e hover hsing (projection x)
    (by rw [←hover,hx])
  have hsub : x-y ∈ C := hrad _ (by rw [map_sub,hx,hy])
    (by rw [map_sub,hyp,sub_self])
  have hyC : y ∈ C := AddSubgroup.subset_closure ⟨hy,hyf⟩
  simpa only [sub_add_cancel] using C.add_mem hsub hyC


/-- The actual outer normalizing involution supplies every semilinear and
singularity premise of fixed singular generation. -/
theorem outer_fixed_mem_closure_singular (hF : 2 < Nat.card F)
    (a : MulAut (SL F)) (E : Space F ≃ₗ[ZMod 2] Space F)
    (hnorm : ∀ g u, E (action g u) = action (a g) (E u))
    (houter : ¬ ∃ g, a = MulAut.conj g) (hE : Function.Involutive E)
    (x : Space F) (hx : E x = x) :
    x ∈ AddSubgroup.closure {u : Space F | E u = u ∧ form u = 0} := by
  obtain ⟨σ,hσne,hsemi⟩ := outer_intertwiner_semilinear hF a E hnorm houter
  obtain ⟨e,he,hover⟩ := intertwiner_descends a E hnorm
  exact fixed_mem_closure_singular_of_semilinear σ
    (semilinear_coefficient_involutive E hE σ hsemi) hσne E hE hsemi e hover
    (fun u hu => (normalizer_preserves_singular hF a e E he hnorm hover u).mpr hu) x hx

/-- A marked subgroup containing the fixed singular images contains every
fixed image. This applies directly to source fusion-generated subgroups. -/
theorem outer_fixed_image_mem_of_singular {G : Type*} [Group G]
    (hF : 2 < Nat.card F) (a : MulAut (SL F)) (E : Space F ≃ₗ[ZMod 2] Space F)
    (hnorm : ∀ g u, E (action g u) = action (a g) (E u))
    (houter : ¬ ∃ g, a = MulAut.conj g) (hE : Function.Involutive E)
    (q : Multiplicative (Space F) →* G) (H : Subgroup G)
    (hsing : ∀ u, E u = u → form u = 0 → q (Multiplicative.ofAdd u) ∈ H)
    (x : Space F) (hx : E x = x) :
    q (Multiplicative.ofAdd x) ∈ H := by
  let K : AddSubgroup (Space F) := (H.comap q).toAddSubgroup'
  have hK : AddSubgroup.closure {u : Space F | E u = u ∧ form u = 0} ≤ K := by
    apply (AddSubgroup.closure_le K).mpr
    intro u hu
    exact hsing u hu.1 hu.2
  exact hK (outer_fixed_mem_closure_singular hF a E hnorm houter hE x hx)
end Representation.SL2OrthogonalCover
