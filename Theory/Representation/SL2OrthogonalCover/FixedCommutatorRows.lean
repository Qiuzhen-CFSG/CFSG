module
public import Theory.Representation.SL2OrthogonalCover.OuterSemilinear
public import Theory.SpecificGroups.PSL2.ElementaryAutomorphisms.FieldDegree
public import Mathlib.GroupTheory.Commutator.Basic
import Mathlib.Tactic.FieldSimp
import Mathlib.Tactic.LinearCombination

/-!
# Commutator rows fixed by an outer involution

Two distinct nonidentity upper roots have disjoint displacement lines spanning
the orthogonal central plane. For a nontrivial semilinear involution commuting
with those roots, trace-one averaging lifts each fixed displacement to a fixed
vector. The fixed central plane is therefore generated by commutators inside
the original fixed group.

With just one nonidentity fixed root, its displacement line still has a nonzero
fixed vector. This vector is nonsingular, furnishing the exceptional commutator
used when the fixed field has two elements. The final adapters retain the
literal group coordinates, root lifts and subgroup commutator.

Source: Aschbacher–Smith, Lemmas 2.4.12(2) and 2.4.21, with the root geometry
of Lemma I.2.3. This module supplies the coordinate calculations; the source
consumer constructs its actual quotient roots and nonsingular marking.
-/

public section
noncomputable section
namespace Representation.SL2OrthogonalCover
open Matrix
variable {F : Type*} [Field F] [Finite F] [CharP F 2] [Algebra (ZMod 2) F]

omit [Finite F] [Algebra (ZMod 2) F] in
private theorem exists_trace_one (σ : F ≃+* F) (hσ : Function.Involutive σ)
    (hσne : σ ≠ RingEquiv.refl F) : ∃ c, c + σ c = 1 := by
  obtain ⟨c, hc⟩ := (Theory.PSL2.fixed_iff_exists_add_conjugate σ hσ hσne (1 : F)).mp
    (map_one σ)
  exact ⟨c, hc⟩

omit [Algebra (ZMod 2) F] in
/-- Two different nonidentity root rows span the full central fixed plane. -/
theorem two_root_displacements (s t : F) (hs : s ≠ 0) (ht : t ≠ 0) (hst : s ≠ t)
    (v : Space F) (hv : v ∈ fixedPlane) :
    ∃ u w : Space F, v = (action (upper s) u - u) + (action (upper t) w - w) := by
  let d := root s * t - root t * s
  have hd : d ≠ 0 := by
    intro h
    have h' : root s * t = root t * s := sub_eq_zero.mp h
    have hp := congrArg (fun x : F => x ^ 2) h'
    rw [mul_pow, mul_pow, sq_root, sq_root] at hp
    have hst' : (s * t) * t = (s * t) * s := by linear_combination hp
    exact hst ((mul_left_cancel₀ (mul_ne_zero hs ht) hst').symm)
  let y := (t * v 0 - root t * v 1) / d
  let z := (root s * v 1 - s * v 0) / d
  refine ⟨![0, 0, y], ![0, 0, z], ?_⟩
  rw [upper_displacement, upper_displacement]
  ext i
  fin_cases i
  · change v 0 = root s * y + root t * z
    dsimp only [y, z]
    field_simp [hd]
    dsimp only [d]
    ring
  · change v 1 = s * y + t * z
    dsimp only [y, z]
    field_simp [hd]
    dsimp only [d]
    ring
  · simpa using (mem_fixedPlane v).mp hv

/-- Trace-one averaging gives a fixed preimage of every fixed root displacement.
The root is the literal one commuting with the given semilinear actor. -/
theorem fixed_root_displacement_lift
    (σ : F ≃+* F) (hσ : Function.Involutive σ) (hσne : σ ≠ RingEquiv.refl F)
    (E : Space F ≃ₗ[ZMod 2] Space F) (hE : Function.Involutive E)
    (hsemi : ∀ c v, E (c • v) = σ c • E v)
    (t : F) (hcomm : ∀ v, E (action (upper t) v) = action (upper t) (E v))
    (v : Space F) (hv : v ∈ rootDisplacement t) (hvE : E v = v) :
    ∃ u : Space F, E u = u ∧ action (upper t) u - u = v := by
  obtain ⟨c, hc⟩ := exists_trace_one σ hσ hσne
  obtain ⟨w, hw⟩ := hv
  change action (upper t) w - w = v at hw
  refine ⟨c • w + E (c • w), ?_, ?_⟩
  · rw [map_add, hE, add_comm]
  · have hEc : action (upper t) (E (c • w)) - E (c • w) = σ c • v := by
      rw [← hcomm, ← map_sub, map_smul, ← smul_sub, hw, hsemi, hvE]
    calc
      action (upper t) (c • w + E (c • w)) - (c • w + E (c • w)) =
          c • (action (upper t) w - w) +
            (action (upper t) (E (c • w)) - E (c • w)) := by
        rw [map_add, map_smul, smul_sub]
        abel
      _ = v := by rw [hw, hEc, ← add_smul, hc, one_smul]

/-- With two distinct fixed root elements, every fixed vector of the central
plane is a sum of displacements of fixed vectors. These are the commutators
needed in the actual involution centralizer. -/
theorem fixed_plane_two_root_displacements
    (σ : F ≃+* F) (hσ : Function.Involutive σ) (hσne : σ ≠ RingEquiv.refl F)
    (E : Space F ≃ₗ[ZMod 2] Space F) (hE : Function.Involutive E)
    (hsemi : ∀ c v, E (c • v) = σ c • E v)
    (s t : F) (hs : s ≠ 0) (ht : t ≠ 0) (hst : s ≠ t)
    (hcommS : ∀ v, E (action (upper s) v) = action (upper s) (E v))
    (hcommT : ∀ v, E (action (upper t) v) = action (upper t) (E v))
    (v : Space F) (hv : v ∈ fixedPlane) (hvE : E v = v) :
    ∃ u w : Space F, E u = u ∧ E w = w ∧
      v = (action (upper s) u - u) + (action (upper t) w - w) := by
  obtain ⟨u, w, hsum⟩ := two_root_displacements s t hs ht hst v hv
  have hfixed : E (action (upper s) u - u) = action (upper s) u - u := by
    have hmemS : E (action (upper s) u - u) - (action (upper s) u - u) ∈ rootDisplacement s := by
      refine (rootDisplacement s).sub_mem ?_ ⟨u, rfl⟩
      rw [map_sub, hcommS]
      exact ⟨E u, rfl⟩
    have hmemT : E (action (upper s) u - u) - (action (upper s) u - u) ∈ rootDisplacement t := by
      have hv' := hvE
      rw [hsum, map_add] at hv'
      have heq : E (action (upper s) u - u) - (action (upper s) u - u) =
          (action (upper t) w - w) - E (action (upper t) w - w) := by
        linear_combination hv'
      rw [heq]
      refine (rootDisplacement t).sub_mem ⟨w, rfl⟩ ?_
      rw [map_sub, hcommT]
      exact ⟨E w, rfl⟩
    exact sub_eq_zero.mp ((Submodule.disjoint_def.mp (rootDisplacement_disjoint s t hs ht hst)) _ hmemS hmemT)
  have hfixedT : E (action (upper t) w - w) = action (upper t) w - w := by
    have hv' := hvE
    rw [hsum, map_add, hfixed] at hv'
    exact add_left_cancel hv'
  obtain ⟨u', hu', hsu⟩ := fixed_root_displacement_lift σ hσ hσne E hE hsemi s hcommS
    _ ⟨u, rfl⟩ hfixed
  obtain ⟨w', hw', htw⟩ := fixed_root_displacement_lift σ hσ hσne E hE hsemi t hcommT
    _ ⟨w, rfl⟩ hfixedT
  exact ⟨u', w', hu', hw', by rw [hsu, htw]; exact hsum⟩

/-- Even for the field-four exception, a fixed nonidentity root has a nonzero
nonsingular commutator of fixed vectors. -/
theorem exists_fixed_nonsingular_root_displacement
    (σ : F ≃+* F) (hσ : Function.Involutive σ) (hσne : σ ≠ RingEquiv.refl F)
    (E : Space F ≃ₗ[ZMod 2] Space F) (hE : Function.Involutive E)
    (hsemi : ∀ c v, E (c • v) = σ c • E v)
    (t : F) (ht : t ≠ 0)
    (hcomm : ∀ v, E (action (upper t) v) = action (upper t) (E v)) :
    ∃ u : Space F, E u = u ∧ form (action (upper t) u - u) ≠ 0 := by
  let v : Space F := ![root t, t, 0]
  have hv : v ∈ rootDisplacement t := by
    rw [rootDisplacement_eq_span]
    exact Submodule.subset_span (by simp [v])
  have hv0 : v ≠ 0 := by intro h; exact ht (congrFun h 1)
  have hev : E v ∈ rootDisplacement t := by
    obtain ⟨w, hw⟩ := hv
    change action (upper t) w - w = v at hw
    rw [← hw, map_sub, hcomm]
    exact ⟨E w, rfl⟩
  have hex : ∃ x : Space F, x ∈ rootDisplacement t ∧ x ≠ 0 ∧ E x = x := by
    by_cases h : v + E v = 0
    · refine ⟨v, hv, hv0, ?_⟩
      have hh := congrArg (fun x : Space F => x - v) h
      have hneg : -v = v := by
        ext i
        exact CharTwo.neg_eq _
      simpa only [add_sub_cancel_left, zero_sub, hneg] using hh
    · exact ⟨v + E v, (rootDisplacement t).add_mem hv hev, h, by rw [map_add, hE, add_comm]⟩
  obtain ⟨x, hx, hx0, hxE⟩ := hex
  obtain ⟨u, hu, hxu⟩ := fixed_root_displacement_lift σ hσ hσne E hE hsemi t hcomm x hx hxE
  exact ⟨u, hu, hxu ▸ rootDisplacement_nonsingular t ht x hx hx0⟩

open scoped commutatorElement

/-- Apply the fixed-row decomposition to the original group coordinates and
root lifts. It yields membership in the literal subgroup commutator. -/
theorem fixed_plane_mem_commutator {G : Type*} [Group G]
    (σ : F ≃+* F) (hσ : Function.Involutive σ) (hσne : σ ≠ RingEquiv.refl F)
    (E : Space F ≃ₗ[ZMod 2] Space F) (hE : Function.Involutive E)
    (hsemi : ∀ c v, E (c • v) = σ c • E v)
    (s t : F) (hs : s ≠ 0) (ht : t ≠ 0) (hst : s ≠ t)
    (hcommS : ∀ v, E (action (upper s) v) = action (upper s) (E v))
    (hcommT : ∀ v, E (action (upper t) v) = action (upper t) (E v))
    (I : Subgroup G) (q : Multiplicative (Space F) →* G)
    (hq : ∀ v, E v = v → q (Multiplicative.ofAdd v) ∈ I)
    (rₛ rₜ : G) (hrₛ : rₛ ∈ I) (hrₜ : rₜ ∈ I)
    (hactS : ∀ v, q (Multiplicative.ofAdd (action (upper s) v)) =
      rₛ * q (Multiplicative.ofAdd v) * rₛ⁻¹)
    (hactT : ∀ v, q (Multiplicative.ofAdd (action (upper t) v)) =
      rₜ * q (Multiplicative.ofAdd v) * rₜ⁻¹)
    (v : Space F) (hv : v ∈ fixedPlane) (hvE : E v = v) :
    q (Multiplicative.ofAdd v) ∈ ⁅I, I⁆ := by
  obtain ⟨u, w, hu, hw, hvw⟩ := fixed_plane_two_root_displacements
    σ hσ hσne E hE hsemi s t hs ht hst hcommS hcommT v hv hvE
  have hs' : q (Multiplicative.ofAdd (action (upper s) u - u)) =
      ⁅rₛ, q (Multiplicative.ofAdd u)⁆ := by
    rw [ofAdd_sub, map_div, hactS, div_eq_mul_inv]
    rfl
  have ht' : q (Multiplicative.ofAdd (action (upper t) w - w)) =
      ⁅rₜ, q (Multiplicative.ofAdd w)⁆ := by
    rw [ofAdd_sub, map_div, hactT, div_eq_mul_inv]
    rfl
  rw [hvw]
  change q (Multiplicative.ofAdd (action (upper s) u - u) *
    Multiplicative.ofAdd (action (upper t) w - w)) ∈ _
  rw [map_mul, hs', ht']
  exact Subgroup.mul_mem _ (Subgroup.commutator_mem_commutator hrₛ (hq u hu))
    (Subgroup.commutator_mem_commutator hrₜ (hq w hw))

/-- The exceptional fixed root supplies a nonsingular element in the actual
subgroup commutator, ready for the source's nonsingular-to-Delta marking. -/
theorem exists_nonsingular_mem_commutator {G : Type*} [Group G]
    (σ : F ≃+* F) (hσ : Function.Involutive σ) (hσne : σ ≠ RingEquiv.refl F)
    (E : Space F ≃ₗ[ZMod 2] Space F) (hE : Function.Involutive E)
    (hsemi : ∀ c v, E (c • v) = σ c • E v)
    (t : F) (ht : t ≠ 0)
    (hcomm : ∀ v, E (action (upper t) v) = action (upper t) (E v))
    (I : Subgroup G) (q : Multiplicative (Space F) →* G)
    (hq : ∀ v, E v = v → q (Multiplicative.ofAdd v) ∈ I)
    (r : G) (hr : r ∈ I)
    (hact : ∀ v, q (Multiplicative.ofAdd (action (upper t) v)) =
      r * q (Multiplicative.ofAdd v) * r⁻¹) :
    ∃ v : Space F, E v = v ∧ form v ≠ 0 ∧ q (Multiplicative.ofAdd v) ∈ ⁅I, I⁆ := by
  obtain ⟨u, hu, hform⟩ := exists_fixed_nonsingular_root_displacement
    σ hσ hσne E hE hsemi t ht hcomm
  refine ⟨action (upper t) u - u, ?_, hform, ?_⟩
  · rw [map_sub, hcomm, hu]
  · have heq : q (Multiplicative.ofAdd (action (upper t) u - u)) =
        ⁅r, q (Multiplicative.ofAdd u)⁆ := by
      rw [ofAdd_sub, map_div, hact, div_eq_mul_inv]
      rfl
    rw [heq]
    exact Subgroup.commutator_mem_commutator hr (hq u hu)
end Representation.SL2OrthogonalCover
