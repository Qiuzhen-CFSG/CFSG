module

public import Theory.Representation.BinaryTransvectionGroups.Basic
public import Mathlib.LinearAlgebra.Dual.Lemmas
public import Theory.PGroupCore

/-!
# Contragredient actions and binary transvection axes

The actual inverse-dual action is faithful and has the same kernel as the
original action. It identifies each acting subgroup with its dual image, so
transports the intrinsic prime cores. Annihilation exchanges the two radical
conditions (pointwise fixation and trivial quotient action). In particular,
transvections with hyperplane axis `ker f` become transvections with center `f`.
Over the binary field nonzero forms uniquely determine their hyperplanes.
The correspondence also respects groups generated by any family of axes.

These are reusable linear and group transports for the dual form of
Aschbacher--Smith G.3.1, used in G.10.4 and 12.2.20 (combined manuscript,
1 March 2004). They do not assume a recognition or semisimplicity theorem.
-/

@[expose] public section
namespace BinaryTransvectionGroups
open BinaryLinear
variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]

abbrev DualSpace (V : Type*) [AddCommGroup V] [Module (ZMod 2) V] :=
  Module.Dual (ZMod 2) V

def contragredient : BinaryLinear.GL V →* BinaryLinear.GL (DualSpace V) where
  toFun g := g.symm.dualMap
  map_one' := by ext f v; rfl
  map_mul' g h := by ext f v; rfl

@[simp] theorem contragredient_apply (g : BinaryLinear.GL V) (f : DualSpace V) (v : V) :
    contragredient g f v = f (g.symm v) := rfl

theorem contragredient_injective : Function.Injective (contragredient (V := V)) := by
  intro g h he
  have hi : g.symm = h.symm := by
    ext v
    apply Module.eval_apply_injective (ZMod 2)
    ext f
    exact congrArg (fun e : BinaryLinear.GL (DualSpace V) => e f v) he
  simpa using congrArg LinearEquiv.symm hi

def dualGroup (G : Subgroup (BinaryLinear.GL V)) : Subgroup (BinaryLinear.GL (DualSpace V)) :=
  G.map contragredient

noncomputable def dualGroupEquiv (G : Subgroup (BinaryLinear.GL V)) : G ≃* dualGroup G :=
  G.equivMapOfInjective contragredient contragredient_injective

@[simp] theorem dualGroupEquiv_apply (G : Subgroup (BinaryLinear.GL V)) (g : G) :
    (dualGroupEquiv G g : BinaryLinear.GL (DualSpace V)) = contragredient g.val := rfl

instance finiteDualGroup (G : Subgroup (BinaryLinear.GL V)) [Finite G] : Finite (dualGroup G) :=
  Finite.of_equiv G (dualGroupEquiv G).toEquiv

theorem dualGroup_pCore (G : Subgroup (BinaryLinear.GL V)) (p : ℕ) :
    (pCore p G).map (dualGroupEquiv G).toMonoidHom = pCore p (dualGroup G) :=
  pCore_map_iso p (dualGroupEquiv G)

theorem dualGroup_twoCore_eq_bot {G : Subgroup (BinaryLinear.GL V)} (h : pCore 2 G = ⊥) :
    pCore 2 (dualGroup G) = ⊥ := by
  rw [← dualGroup_pCore, h, Subgroup.map_bot]

variable {H : Type*} [Group H]

def dualAction (ρ : H →* BinaryLinear.GL V) : H →* BinaryLinear.GL (DualSpace V) := contragredient.comp ρ

theorem dualAction_ker (ρ : H →* BinaryLinear.GL V) : (dualAction ρ).ker = ρ.ker := by
  ext g
  change contragredient (ρ g) = 1 ↔ ρ g = 1
  rw [← map_one contragredient, contragredient_injective.eq_iff]

theorem dualAction_range (ρ : H →* BinaryLinear.GL V) : (dualAction ρ).range = dualGroup ρ.range :=
  MonoidHom.range_comp contragredient ρ

/-- Duality exchanges the two conditions defining a block-unipotent radical. -/
theorem contragredient_mem_radical_iff (W : Submodule (ZMod 2) V) (g : BinaryLinear.GL V) :
    contragredient g ∈ radical W.dualAnnihilator ↔ g ∈ radical W := by
  constructor
  · intro hg
    refine ⟨?_, ?_⟩
    · intro w hw
      have hi : g.symm w = w := by
        apply Module.eval_apply_injective (ZMod 2)
        ext f
        have he := ((Submodule.mem_dualAnnihilator _).mp (hg.2 f)) w hw
        exact sub_eq_zero.mp he
      simpa using (congrArg g hi).symm
    · intro v
      apply (Subspace.forall_mem_dualAnnihilator_apply_eq_zero_iff W _).mp
      intro f hf
      have he := congrArg (fun l : DualSpace V => l (g v)) (hg.1 f hf)
      have he' : f v = f (g v) := by simpa using he
      exact (map_sub f _ _).trans (sub_eq_zero.mpr he'.symm)
  · intro hg
    have hi := (radical W).inv_mem hg
    refine ⟨?_, ?_⟩
    · intro f hf
      ext v
      have he := ((Submodule.mem_dualAnnihilator _).mp hf) _ (hi.2 v)
      exact sub_eq_zero.mp ((map_sub f _ _).symm.trans he)
    · intro f
      apply (Submodule.mem_dualAnnihilator _).mpr
      intro w hw
      change f (g⁻¹ w) - f w = 0
      rw [hi.1 w hw, sub_self]

theorem ker_dualAnnihilator (f : DualSpace V) :
    f.ker.dualAnnihilator = centerLine f := by
  rw [← LinearMap.range_dualMap_eq_dualAnnihilator_ker,
    LinearMap.range_dualMap_dual_eq_span_singleton]

def axisRootGroup (G : Subgroup (BinaryLinear.GL V)) (f : DualSpace V) : Subgroup (BinaryLinear.GL V) :=
  G ⊓ radical f.ker

theorem contragredient_mem_axisRoot_iff (G : Subgroup (BinaryLinear.GL V)) (f : DualSpace V)
    (g : BinaryLinear.GL V) : contragredient g ∈ rootGroup (dualGroup G) f ↔ g ∈ axisRootGroup G f := by
  change contragredient g ∈ G.map contragredient ∧
    contragredient g ∈ radical (centerLine f) ↔ g ∈ G ∧ g ∈ radical f.ker
  rw [← ker_dualAnnihilator, contragredient_mem_radical_iff]
  constructor
  · rintro ⟨⟨a, ha, he⟩, hg⟩
    exact ⟨contragredient_injective he ▸ ha, hg⟩
  · rintro ⟨hg, hr⟩
    exact ⟨⟨g, hg, rfl⟩, hr⟩

theorem axisRootGroup_map (G : Subgroup (BinaryLinear.GL V)) (f : DualSpace V) :
    (axisRootGroup G f).map contragredient = rootGroup (dualGroup G) f := by
  ext t
  constructor
  · rintro ⟨g, hg, rfl⟩
    exact (contragredient_mem_axisRoot_iff G f g).mpr hg
  · intro ht
    obtain ⟨g, hg, rfl⟩ := ht.1
    exact ⟨g, (contragredient_mem_axisRoot_iff G f g).mp ht, rfl⟩

/-- The kernel of the transformed form is the transported hyperplane. -/
theorem ker_contragredient (g : BinaryLinear.GL V) (f : DualSpace V) :
    (contragredient g f).ker = f.ker.map g.toLinearMap := by
  ext v
  constructor
  · intro hv
    exact ⟨g.symm v, hv, g.apply_symm_apply v⟩
  · rintro ⟨v, hv, rfl⟩
    simpa using hv

/-- Over the binary field nonzero forms are uniquely determined by their axes. -/
theorem eq_of_ker_eq {f l : DualSpace V} (hf : f ≠ 0) (he : f.ker = l.ker) : f = l := by
  have hs : centerLine f = centerLine l := by
    rw [← ker_dualAnnihilator, ← ker_dualAnnihilator, he]
  have hm : f ∈ centerLine l := hs ▸ Submodule.mem_span_singleton_self f
  exact ((mem_centerLine_iff l f).mp hm).resolve_left hf

/-- An axis radical consists of the actual rank-one maps with that fixed form. -/
theorem mem_axisRootGroup_iff {G : Subgroup (BinaryLinear.GL V)} {f : DualSpace V}
    (hf : f ≠ 0) {t : BinaryLinear.GL V} :
    t ∈ axisRootGroup G f ↔ t ∈ G ∧ ∃ w : V, ∃ hw : f w = 0,
      t = BinaryLinear.transvection w f hw := by
  constructor
  · intro ht
    obtain ⟨u, hu⟩ : ∃ u, f u ≠ 0 := by
      by_contra! hn
      exact hf (LinearMap.ext hn)
    have hu1 : f u = 1 := (by decide : ∀ a : ZMod 2, a ≠ 0 → a = 1) _ hu
    let w := t u - u
    have hw : f w = 0 := ht.2.2 u
    refine ⟨ht.1, w, hw, ?_⟩
    ext v
    have hv : v - f v • u ∈ f.ker := by
      change f (v - f v • u) = 0
      rw [map_sub, map_smul, hu1, smul_eq_mul, mul_one, sub_self]
    have htfix := ht.2.1 _ hv
    simp only [map_sub, map_smul] at htfix
    change t v = v + f v • w
    dsimp [w]
    rw [smul_sub]
    rw [(sub_eq_iff_eq_add).mp htfix]
    abel
  · rintro ⟨ht, w, hw, rfl⟩
    exact ⟨ht, BinaryLinear.transvection_mem hw le_rfl⟩

/-- The original groups generated by axes correspond under the faithful dual action. -/
def axisGenerated (G : Subgroup (BinaryLinear.GL V)) (Γ : Set (DualSpace V)) :
    Subgroup (BinaryLinear.GL V) := ⨆ f ∈ Γ, axisRootGroup G f

theorem axisGenerated_map (G : Subgroup (BinaryLinear.GL V)) (Γ : Set (DualSpace V)) :
    (axisGenerated G Γ).map contragredient = generated (dualGroup G) Γ := by
  simp only [axisGenerated, generated, Subgroup.map_iSup, axisRootGroup_map]

end BinaryTransvectionGroups
