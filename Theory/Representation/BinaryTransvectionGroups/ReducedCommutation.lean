module

public import Theory.Representation.BinaryTransvectionGroups.Basic

/-!
# Commutation across a binary subspace with trivial two-core

For a binary linear group stabilizing Q, the kernel on Q and V/Q is a
normal two-subgroup of that group. If its two-core is trivial, elements
fixing Q pointwise commute with elements acting trivially on V/Q.
Consequently the latter preserve [V,X] for X centralizing Q. When Q and
[V,X] are disjoint, they fix [V,X] pointwise.

The proof computes commutators in the block-unipotent radical; all normality
is relative to the actual acting group. This supplies the coprime-action
step in Aschbacher–Smith, combined manuscript (1 March 2004), proof of
Lemma 16.4.7, printed p.1187, in the case Z(L) = 1. Constructing X and
proving the two-core and displacement identities remain separate steps.
-/

@[expose] public section

open scoped commutatorElement
namespace BinaryTransvectionGroups
open BinaryLinear Subgroup
variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]

/-- The kernel on a subspace and its quotient is a normal two-subgroup of
every group stabilizing the subspace. Normality is relative to that group. -/
theorem radical_subgroupOf_le_pCore (H : Subgroup (GL V))
    (W : Submodule (ZMod 2) V) (hH : H ≤ parabolic W) :
    (radical W).subgroupOf H ≤ pCore 2 H := by
  have hn : ((radical W).subgroupOf H).Normal :=
    normal_subgroupOf_of_le_normalizer (hH.trans (parabolic_le_normalizer W))
  exact le_sSup ⟨hn, (radical_two W).comap_subtype⟩

/-- When the two-core is trivial, an element centralizing the invariant
subspace commutes with every element acting trivially on its quotient. -/
theorem commute_of_pointwise_quotient_fixes (H : Subgroup (GL V))
    (W : Submodule (ZMod 2) V) (hH : H ≤ parabolic W)
    (hcore : pCore 2 H = ⊥) (x n : H)
    (hx : x.val ∈ pointwiseFixer W) (hn : n.val ∈ quotientFixer W) :
    Commute x n := by
  have hxi := (pointwiseFixer W).inv_mem hx
  have hni := (quotientFixer W).inv_mem hn
  have hc : ⁅x, n⁆ ∈ (radical W).subgroupOf H := by
    constructor
    · intro w hw
      change x.val (n.val (x.val⁻¹ (n.val⁻¹ w))) = w
      have hwi : n.val⁻¹ w ∈ W := (hH (H.inv_mem n.property) w).mpr hw
      rw [hxi _ hwi, LinearEquiv.coe_inv, n.val.apply_symm_apply, hx w hw]
    · intro v
      let u := x.val⁻¹ (n.val⁻¹ v)
      have hxu : x.val u = n.val⁻¹ v := x.val.apply_symm_apply _
      have hfix := hx (n.val u - u) (hn u)
      rw [map_sub, hxu] at hfix
      have he : x.val (n.val u) = (n.val u - u) + n.val⁻¹ v :=
        sub_eq_iff_eq_add.mp hfix
      change x.val (n.val u) - v ∈ W
      rw [he, add_sub_assoc]
      exact W.add_mem (hn u) (hni v)
  have hh := radical_subgroupOf_le_pCore H W hH hc
  rw [hcore, mem_bot] at hh
  exact commutatorElement_eq_one_iff_commute.mp hh

/-- Commutation makes the displacement subspace invariant. This is the
normalization of [V,X] used in the centerless shadow case. -/
theorem preserves_displacement_of_commute (x n : GL V) (hc : Commute x n) :
    ∀ v ∈ LinearMap.range (x.toLinearMap - LinearMap.id),
      n v ∈ LinearMap.range (x.toLinearMap - LinearMap.id) := by
  rintro v ⟨w, rfl⟩
  refine ⟨n w, ?_⟩
  change x (n w) - n w = n (x w - w)
  rw [map_sub]
  exact congrArg (fun e : GL V => e w - n w) hc.eq

/-- The subspace [V,X] generated by the displacements of the given action. -/
def displacementSpan (X : Subgroup (GL V)) : Submodule (ZMod 2) V :=
  Submodule.span (ZMod 2) {w | ∃ x : X, ∃ v : V, x.val v - v = w}

theorem preserves_displacementSpan (X : Subgroup (GL V)) (n : GL V)
    (hcomm : ∀ x : X, Commute x.val n) {v : V} (hv : v ∈ displacementSpan X) :
    n v ∈ displacementSpan X := by
  induction hv using Submodule.span_induction with
  | mem v hv =>
    obtain ⟨x, w, rfl⟩ := hv
    apply Submodule.subset_span
    refine ⟨x, n w, ?_⟩
    rw [map_sub]
    exact congrArg (fun e : GL V => e w - n w) (hcomm x).eq
  | zero => simp
  | add v w _ _ hv hw => simpa using (displacementSpan X).add_mem hv hw
  | smul a v _ hv => simpa using (displacementSpan X).smul_mem a hv

/-- The centerless-case endgame: quotient-trivial elements fix [V,X]
pointwise when that space is disjoint from the invariant core centralized
by X. Thus they cannot move the marked r in [V,X]. -/
theorem fixes_displacementSpan_of_reduced (H : Subgroup (GL V))
    (Q : Submodule (ZMod 2) V) (hH : H ≤ parabolic Q)
    (hcore : pCore 2 H = ⊥)
    (X : Subgroup (GL V)) (hXH : X ≤ H) (hXQ : X ≤ pointwiseFixer Q)
    (hdis : Disjoint Q (displacementSpan X))
    (n : H) (hn : n.val ∈ quotientFixer Q) {v : V} (hv : v ∈ displacementSpan X) :
    n.val v = v := by
  have hcomm (x : X) : Commute x.val n.val := by
    have hc := commute_of_pointwise_quotient_fixes H Q hH hcore
      ⟨x, hXH x.property⟩ n (hXQ x.property) hn
    exact congrArg Subtype.val hc.eq
  have hnv := preserves_displacementSpan X n.val hcomm hv
  exact sub_eq_zero.mp (Submodule.disjoint_def.mp hdis (n.val v - v) (hn v)
    ((displacementSpan X).sub_mem hnv hv))

end BinaryTransvectionGroups
