module

public import Theory.SpecificGroups.BinaryLinear.Parabolics
public import Theory.ElementaryAbelian.Basic
public import Mathlib.LinearAlgebra.Span.Basic

/-!
# Binary transvection groups with prescribed centers

For a subgroup `G` of the actual binary linear group, `rootGroup G x` is
`G` intersected with the radical of the line through `x`. For nonzero `x`,
`mem_rootGroup_iff` identifies its elements with the maps
`v ↦ v + f(v) x`, where `f(x) = 0`; the zero form gives the identity.

A group generated by such root groups acts trivially modulo the span of
its centers. Its pointwise kernel on that span embeds in the corresponding
block-unipotent radical, so is elementary abelian. Conjugation carries the
root group at `x` to the root group at `g x`, and different binary centers
have disjoint root groups. In particular, an invariant family generates a
normal subgroup of `G` (normality is relative to `G`).

These are the elementary linear-algebra ingredients in the first paragraphs
of Aschbacher--Smith, *The Classification of Quasithin Groups*, combined
1 March 2004 manuscript, Lemma G.3.1, printed pp. 337--338. Recognition of
the action image as the full linear group is a separate assertion.
-/

@[expose] public section

open scoped IsMulCommutative
namespace BinaryTransvectionGroups
open BinaryLinear
variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]

/-- There are only finitely many linear automorphisms of a finite space. -/
instance finiteLinearGroup [Finite V] : Finite (GL V) :=
  Finite.of_injective (fun e : GL V => (e : V → V)) DFunLike.coe_injective

abbrev centerLine (x : V) : Submodule (ZMod 2) V := Submodule.span (ZMod 2) {x}

def rootGroup (G : Subgroup (GL V)) (x : V) : Subgroup (GL V) :=
  G ⊓ radical (centerLine x)

def generated (G : Subgroup (GL V)) (Δ : Set V) : Subgroup (GL V) :=
  ⨆ x ∈ Δ, rootGroup G x

def pointwiseFixer (W : Submodule (ZMod 2) V) : Subgroup (GL V) where
  carrier := {g | ∀ w ∈ W, g w = w}
  one_mem' := by simp
  mul_mem' := by
    intro g h hg hh w hw
    simp only [LinearEquiv.mul_apply, hh w hw, hg w hw]
  inv_mem' := by
    intro g hg w hw
    apply g.injective
    simpa using (hg w hw).symm

def quotientFixer (W : Submodule (ZMod 2) V) : Subgroup (GL V) where
  carrier := {g | ∀ v, g v - v ∈ W}
  one_mem' := by simp
  mul_mem' := by
    intro g h hg hh v
    have := W.add_mem (hg (h v)) (hh v)
    simpa only [sub_add_sub_cancel, LinearEquiv.mul_apply] using this
  inv_mem' := by
    intro g hg v
    have := W.neg_mem (hg (g⁻¹ v))
    simpa only [LinearEquiv.coe_inv, LinearEquiv.apply_symm_apply, neg_sub] using this

theorem rootGroup_le (G : Subgroup (GL V)) (x : V) : rootGroup G x ≤ G := inf_le_left

theorem rootGroup_le_generated (G : Subgroup (GL V)) {Δ : Set V} {x : V}
    (hx : x ∈ Δ) : rootGroup G x ≤ generated G Δ :=
  le_iSup_of_le x (le_iSup_of_le hx le_rfl)

theorem generated_le (G : Subgroup (GL V)) (Δ : Set V) : generated G Δ ≤ G :=
  iSup_le fun x => iSup_le fun _ => rootGroup_le G x

/-- Root groups are finite whenever their ambient group is finite. -/
instance finiteRootGroup (G : Subgroup (GL V)) [Finite G] (x : V) :
    Finite (rootGroup G x) :=
  Finite.of_injective (Subgroup.inclusion (rootGroup_le G x))
    (Subgroup.inclusion_injective _)

/-- The generated group is finite whenever its ambient group is finite. -/
instance finiteGenerated (G : Subgroup (GL V)) [Finite G] (Δ : Set V) :
    Finite (generated G Δ) :=
  Finite.of_injective (Subgroup.inclusion (generated_le G Δ))
    (Subgroup.inclusion_injective _)

theorem generated_le_quotientFixer (G : Subgroup (GL V)) (Δ : Set V) :
    generated G Δ ≤ quotientFixer (Submodule.span (ZMod 2) Δ) := by
  apply iSup_le
  intro x
  apply iSup_le
  intro hx g hg v
  have hline : centerLine x ≤ Submodule.span (ZMod 2) Δ :=
    Submodule.span_mono (Set.singleton_subset_iff.mpr hx)
  exact hline (hg.2.2 v)

theorem quotientFixer_le_parabolic (W : Submodule (ZMod 2) V) :
    quotientFixer W ≤ parabolic W := by
  intro g hg v
  constructor
  · intro hv
    have := W.sub_mem hv (hg v)
    simpa using this
  · intro hv
    have := W.add_mem (hg v) hv
    simpa using this

def action (K : Subgroup (GL V)) (W : Submodule (ZMod 2) V)
    (hK : K ≤ parabolic W) : K →* GL W where
  toFun g :=
    { toFun := fun w => ⟨g.val w, (hK g.property w).mpr w.property⟩
      invFun := fun w => ⟨g.val⁻¹ w, (hK (K.inv_mem g.property) w).mpr w.property⟩
      left_inv := by intro w; apply Subtype.ext; exact g.val.symm_apply_apply w
      right_inv := by intro w; apply Subtype.ext; exact g.val.apply_symm_apply w
      map_add' := by intro u v; apply Subtype.ext; exact g.val.map_add u v
      map_smul' := by intro a v; apply Subtype.ext; exact g.val.map_smul a v }
  map_one' := by ext w; rfl
  map_mul' := by intro g h; ext w; rfl

@[simp] theorem action_apply (K : Subgroup (GL V)) (W : Submodule (ZMod 2) V)
    (hK : K ≤ parabolic W) (g : K) (w : W) :
    (action K W hK g w : V) = g.val w := rfl

def fixingKernel (K : Subgroup (GL V)) (W : Submodule (ZMod 2) V) : Subgroup K :=
  (pointwiseFixer W).comap K.subtype

theorem action_ker_eq (K : Subgroup (GL V)) (W : Submodule (ZMod 2) V)
    (hK : K ≤ parabolic W) : (action K W hK).ker = fixingKernel K W := by
  ext g
  change action K W hK g = 1 ↔ ∀ w ∈ W, g.val w = w
  constructor
  · intro h w hw
    exact congrArg (fun e : GL W => (e ⟨w, hw⟩ : V)) h
  · intro h
    ext w
    exact h w w.property

private theorem binary_add_self (v : V) : v + v = 0 := by
  calc
    v + v = ((1 : ZMod 2) + 1) • v := by rw [add_smul, one_smul]
    _ = 0 := by rw [show (1 : ZMod 2) + 1 = 0 by decide, zero_smul]

private theorem radical_square {W : Submodule (ZMod 2) V} {g : GL V}
    (hg : g ∈ radical W) : g ^ 2 = 1 := by
  ext v
  have hd := hg.1 (g v - v) (hg.2 v)
  simp only [map_sub] at hd
  simp only [pow_two, LinearEquiv.mul_apply, LinearEquiv.coe_one, id_eq]
  apply sub_eq_zero.mp
  calc
    g (g v) - v = (g (g v) - g v) + (g v - v) := by abel
    _ = 0 := by rw [hd, binary_add_self]

theorem elementaryAbelian_of_le_radical {H : Type*} [Group H]
    (f : H →* GL V) (hf : Function.Injective f) (W : Submodule (ZMod 2) V)
    (hW : ∀ h, f h ∈ radical W) : IsElementaryAbelian 2 H := by
  have hs (h : H) : h ^ 2 = 1 := by
    apply hf
    rw [map_pow, map_one]
    exact radical_square (hW h)
  have hi (h : H) : h⁻¹ = h := inv_eq_of_mul_eq_one_right (by simpa [pow_two] using hs h)
  refine { is_comm := ⟨?_⟩, exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr hs }
  intro a b
  have := mul_inv_rev a b
  simpa only [hi] using this

theorem rootGroup_elementaryAbelian (G : Subgroup (GL V)) (x : V) :
    IsElementaryAbelian 2 (rootGroup G x) :=
  elementaryAbelian_of_le_radical (rootGroup G x).subtype Subtype.val_injective
    (centerLine x) (fun g => g.property.2)

theorem fixingKernel_elementaryAbelian (K : Subgroup (GL V))
    (W : Submodule (ZMod 2) V) (hK : K ≤ quotientFixer W) :
    IsElementaryAbelian 2 (fixingKernel K W) := by
  apply elementaryAbelian_of_le_radical
    (K.subtype.comp (fixingKernel K W).subtype)
    (Subtype.val_injective.comp Subtype.val_injective) W
  intro g
  exact ⟨g.property, hK g.val.property⟩

theorem generated_fixingKernel_elementaryAbelian (G : Subgroup (GL V)) (Δ : Set V) :
    IsElementaryAbelian 2
      (fixingKernel (generated G Δ) (Submodule.span (ZMod 2) Δ)) :=
  fixingKernel_elementaryAbelian _ _ (generated_le_quotientFixer G Δ)

/-- Each element has the actual rank-one formula, with the identity allowed. -/
theorem mem_rootGroup_iff {G : Subgroup (GL V)} {x : V} (hx : x ≠ 0) {t : GL V} :
    t ∈ rootGroup G x ↔ t ∈ G ∧ ∃ f : V →ₗ[ZMod 2] ZMod 2,
      ∃ hfx : f x = 0, t = BinaryLinear.transvection x f hfx := by
  constructor
  · intro ht
    let d : V →ₗ[ZMod 2] V := t.toLinearMap - LinearMap.id
    let c : V →ₗ[ZMod 2] centerLine x := d.codRestrict _ ht.2.2
    let f : V →ₗ[ZMod 2] ZMod 2 :=
      (LinearEquiv.coord (ZMod 2) V x hx).toLinearMap.comp c
    have hfd (v : V) : f v • x = t v - v :=
      LinearEquiv.coord_apply_smul (ZMod 2) V x hx (c v)
    have hfx : f x = 0 := by
      have h := hfd x
      rw [ht.2.1 x (Submodule.mem_span_singleton_self x), sub_self] at h
      exact (smul_eq_zero.mp h).resolve_right hx
    refine ⟨ht.1, f, hfx, ?_⟩
    ext v
    change t v = v + f v • x
    rw [hfd]
    abel
  · rintro ⟨ht, f, hfx, rfl⟩
    exact ⟨ht, BinaryLinear.transvection_mem (Submodule.mem_span_singleton_self x)
      (Submodule.span_le.mpr (by simpa using hfx))⟩

/-- Over the binary field a line has a unique nonzero vector. -/
theorem mem_centerLine_iff (x v : V) : v ∈ centerLine x ↔ v = 0 ∨ v = x := by
  rw [Submodule.mem_span_singleton]
  constructor
  · rintro ⟨a, rfl⟩
    rcases (by decide : ∀ a : ZMod 2, a = 0 ∨ a = 1) a with rfl | rfl
    · exact Or.inl (zero_smul _ _)
    · exact Or.inr (one_smul _ _)
  · rintro (rfl | rfl)
    · exact ⟨0, zero_smul _ _⟩
    · exact ⟨1, one_smul _ _⟩

theorem rootGroup_disjoint (G : Subgroup (GL V)) {x y : V} (hxy : x ≠ y) :
    Disjoint (rootGroup G x) (rootGroup G y) := by
  apply disjoint_iff.mpr
  apply le_antisymm _ bot_le
  intro t ht
  apply Subgroup.mem_bot.mpr
  ext v
  apply sub_eq_zero.mp
  have hx := (mem_centerLine_iff x (t v - v)).mp (ht.1.2.2 v)
  have hy := (mem_centerLine_iff y (t v - v)).mp (ht.2.2.2 v)
  rcases hx with hx | hx
  · exact hx
  rcases hy with hy | hy
  · exact hy
  exact (hxy (hx.symm.trans hy)).elim

private theorem map_mem_centerLine (e : GL V) {x v : V} (hv : v ∈ centerLine x) :
    e v ∈ centerLine (e x) := by
  rcases (mem_centerLine_iff x v).mp hv with rfl | rfl
  · simp
  · exact Submodule.mem_span_singleton_self _

theorem conjugate_mem_rootGroup {G : Subgroup (GL V)} {g t : GL V} (hg : g ∈ G)
    {x : V} (ht : t ∈ rootGroup G x) :
    g * t * g⁻¹ ∈ rootGroup G (g x) := by
  refine ⟨G.mul_mem (G.mul_mem hg ht.1) (G.inv_mem hg), ?_, ?_⟩
  · intro w hw
    have hw' : g⁻¹ w ∈ centerLine x := by
      simpa only [LinearEquiv.coe_inv, LinearEquiv.symm_apply_apply] using
        map_mem_centerLine g⁻¹ hw
    change g (t (g⁻¹ w)) = w
    rw [ht.2.1 _ hw']
    exact g.apply_symm_apply w
  · intro v
    have h := map_mem_centerLine g (ht.2.2 (g⁻¹ v))
    simpa only [map_sub, LinearEquiv.mul_apply, LinearEquiv.coe_inv,
      LinearEquiv.apply_symm_apply] using h

theorem rootGroup_conjugate {G : Subgroup (GL V)} {g : GL V} (hg : g ∈ G) (x : V) :
    (rootGroup G x).map (MulAut.conj g).toMonoidHom = rootGroup G (g x) := by
  apply le_antisymm
  · rintro t ⟨s, hs, rfl⟩
    exact conjugate_mem_rootGroup hg hs
  · intro t ht
    refine ⟨g⁻¹ * t * g, ?_, ?_⟩
    · change g⁻¹ * t * g ∈ rootGroup G x
      simpa only [inv_inv, LinearEquiv.coe_inv, LinearEquiv.symm_apply_apply] using
        conjugate_mem_rootGroup (G.inv_mem hg) ht
    · change g * (g⁻¹ * t * g) * g⁻¹ = t
      group

/-- The intrinsic normality is inside `G`, not inside the whole linear group. -/
theorem generated_normal (G : Subgroup (GL V)) (Δ : Set V)
    (hΔ : ∀ g ∈ G, ∀ x ∈ Δ, g x ∈ Δ) :
    ((generated G Δ).subgroupOf G).Normal := by
  have hc (g : GL V) (hg : g ∈ G) :
      generated G Δ ≤ (generated G Δ).comap (MulAut.conj g).toMonoidHom := by
    apply iSup_le
    intro x
    apply iSup_le
    intro hx t ht
    exact rootGroup_le_generated G (hΔ g hg x hx) (conjugate_mem_rootGroup hg ht)
  constructor
  intro n hn g
  exact hc g g.property hn

/-- The concrete restriction to the span of the chosen centers. -/
def spanAction (G : Subgroup (GL V)) (Δ : Set V) :
    generated G Δ →* GL (Submodule.span (ZMod 2) Δ) :=
  action _ _ ((generated_le_quotientFixer G Δ).trans (quotientFixer_le_parabolic _))

theorem spanAction_ker_eq (G : Subgroup (GL V)) (Δ : Set V) :
    (spanAction G Δ).ker = fixingKernel (generated G Δ) (Submodule.span (ZMod 2) Δ) :=
  action_ker_eq _ _ _

theorem spanAction_ker_elementaryAbelian (G : Subgroup (GL V)) (Δ : Set V) :
    IsElementaryAbelian 2 (spanAction G Δ).ker := by
  rw [spanAction_ker_eq]
  exact generated_fixingKernel_elementaryAbelian G Δ

end BinaryTransvectionGroups
