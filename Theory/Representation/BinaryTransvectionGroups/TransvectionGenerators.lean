module

public import Theory.SpecificGroups.BinaryLinear.CyclicTransvectionGeneration
public import Theory.SpecificGroups.BinaryLinear.OuterCyclic.Transvections
public import Theory.LinearAlgebra.IntersectionCodimension

/-!
# Binary transvection generators and common fixed spaces

The cyclic elementary generators give a transvection family indexed by the
dimension of the actual binary vector space. A group generated by a finite
family of transvections has common fixed-space codimension at most the size
of that family, by intersecting their defining linear-form kernels.

These are the linear-algebra ingredients for Aschbacher--Smith 12.7.18,
printed p.845.
-/

public noncomputable section

open Subgroup
namespace BinaryLinear
open OuterCyclic

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V]

/-- The full binary linear group has a transvection generating family indexed
by the dimension of its original vector space. -/
theorem exists_transvection_generators
    (hn : 2 ≤ Module.finrank (ZMod 2) V) :
    ∃ t : Fin (Module.finrank (ZMod 2) V) → BinaryLinear.GL V,
      (∀ i, IsTransvection (t i)) ∧ Subgroup.closure (Set.range t) = ⊤ := by
  classical
  let n := Module.finrank (ZMod 2) V
  let b := Module.finBasis (ZMod 2) V
  let e := b.equivFun
  let E : Matrix.SpecialLinearGroup (Fin n) (ZMod 2) ≃* BinaryLinear.GL V :=
    (slEquivLinear n).trans
      ((LinearMap.GeneralLinearGroup.generalLinearEquiv (ZMod 2) (Fin n → ZMod 2)).symm.trans
        ((LinearMap.GeneralLinearGroup.congrLinearEquiv e.symm).trans
          (LinearMap.GeneralLinearGroup.generalLinearEquiv (ZMod 2) V)))
  obtain ⟨t, ht, hgen⟩ := CyclicTransvectionGeneration.exists_transvection_generators n hn
  refine ⟨fun i => E (t i), ?_, ?_⟩
  · intro i
    obtain ⟨j, k, hjk, he⟩ := ht i
    refine ⟨b j, b.coord k, b.ne_zero j, ?_, ?_, ?_⟩
    · intro hz
      have h := congrArg (fun f : V →ₗ[ZMod 2] ZMod 2 => f (b k)) hz
      simp at h
    · simp [hjk]
    · change E (t i) = _
      rw [he]
      ext v
      change e.symm ((1 + Matrix.single j k (1 : ZMod 2)).mulVec (e v)) =
        v + b.coord k v • b j
      simp only [Matrix.add_mulVec, Matrix.one_mulVec, Matrix.single_mulVec_eq,
        one_mul, map_add, map_smul, LinearEquiv.symm_apply_apply]
      congr 1
      simp [e, b.equivFun_symm_apply]
  · calc
      Subgroup.closure (Set.range (fun i => E (t i))) =
          (Subgroup.closure (Set.range t)).map E.toMonoidHom := by
        rw [MonoidHom.map_closure, Set.range_comp']
        rfl
      _ = ⊤ := by rw [hgen]; exact Subgroup.map_top_of_surjective _ E.surjective

/-- Each genuine transvection generator adds at most one to the codimension
of the common fixed space. -/
theorem fixedSpace_codimension_le_generators {ι : Type*} [Fintype ι]
    (t : ι → BinaryLinear.GL V) (ht : ∀ i, IsTransvection (t i)) :
    Module.finrank (ZMod 2) (V ⧸ fixedSpace (Subgroup.closure (Set.range t))) ≤
      Fintype.card ι := by
  classical
  choose x f hx hf hfx he using ht
  have hfixed : fixedSpace (Subgroup.closure (Set.range t)) = ⨅ i, (f i).ker := by
    ext v
    constructor
    · intro hv
      apply (Submodule.mem_iInf _).mpr
      intro i
      have h := hv (t i) (Subgroup.subset_closure ⟨i, rfl⟩)
      rw [he i] at h
      change v + f i v • x i = v at h
      exact (smul_eq_zero.mp (add_eq_left.mp h)).resolve_right (hx i)
    · intro hv
      have hgen : Subgroup.closure (Set.range t) ≤ MulAction.stabilizer (BinaryLinear.GL V) v := by
        apply (Subgroup.closure_le _).mpr
        rintro _ ⟨i, rfl⟩
        change t i v = v
        rw [he i]
        change v + f i v • x i = v
        rw [show f i v = 0 from (Submodule.mem_iInf _).mp hv i, zero_smul, add_zero]
      intro g hg
      exact hgen hg
  rw [hfixed]
  refine (Submodule.finrank_quotient_iInf_le_sum (fun i => (f i).ker)).trans ?_
  have hdim (i : ι) : Module.finrank (ZMod 2) (V ⧸ (f i).ker) ≤ 1 := by
    rw [(f i).quotKerEquivRange.finrank_eq]
    simpa using (f i).range.finrank_le
  calc
    ∑ i, Module.finrank (ZMod 2) (V ⧸ (f i).ker) ≤ ∑ _i : ι, 1 :=
      Finset.sum_le_sum fun i _ => hdim i
    _ = Fintype.card ι := by simp

end BinaryLinear
