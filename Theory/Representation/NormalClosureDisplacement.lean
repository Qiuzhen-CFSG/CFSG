module

public import Theory.Representation.BinaryOffender.SubspaceAction
public import Theory.GroupTheory.ConjugateSpanOrder
public import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-!
# Conjugate-generated displacement spaces

Commutators with the subgroup generated by H-conjugates of a are exactly the
H-translates of the original displacement space. Invariant subspace containment
and pointwise fixation consequently propagate along this conjugate closure.
A rank-nullity argument gives rank one on both a moved invariant subspace and
its quotient when the original displacement has rank at most two and is not
contained in that subspace.

Source application: Aschbacher–Smith, combined 1 March 2004 manuscript,
G.6.2(1),(3) and G.6.3, printed p.345. No classification is used.
-/

@[expose] public section

open Subgroup
namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

/-- The span of the H-translates of the displacement of a. -/
def conjugateDisplacementSpan (a : G) (H : Subgroup G) : Submodule (ZMod 2) V :=
  Submodule.span (ZMod 2) {v | ∃ h ∈ H, ∃ w, v = ρ h (ρ a w - w)}

private def displacementIn (W : Submodule (ZMod 2) V) : Subgroup G where
  carrier := {g | ∀ v, ρ g v - v ∈ W}
  one_mem' := by simp
  mul_mem' := by
    intro g h hg hh v
    simpa only [map_mul, Module.End.mul_apply, sub_add_sub_cancel] using
      W.add_mem (hg (ρ h v)) (hh v)
  inv_mem' := by
    intro g hg v
    simpa only [← Module.End.mul_apply, ← map_mul, mul_inv_cancel, map_one,
      Module.End.one_apply, neg_sub] using W.neg_mem (hg (ρ g⁻¹ v))

private theorem conjugateDisplacementSpan_stable (a : G) (H : Subgroup G)
    (h : G) (hh : h ∈ H) {v : V} (hv : v ∈ conjugateDisplacementSpan ρ a H) :
    ρ h v ∈ conjugateDisplacementSpan ρ a H := by
  induction hv using Submodule.span_induction with
  | mem v hv =>
    obtain ⟨g, hg, w, rfl⟩ := hv
    exact Submodule.subset_span ⟨h * g, H.mul_mem hh hg, w, by rw [map_mul, Module.End.mul_apply]⟩
  | zero => simp
  | add v w _ _ hv hw => simpa using (conjugateDisplacementSpan ρ a H).add_mem hv hw
  | smul c v _ hv => simpa using (conjugateDisplacementSpan ρ a H).smul_mem c hv

/-- Commutators with the conjugate-generated subgroup are exactly the
translates of the original displacement space. -/
theorem commutator_conjugateSpanBy_zpowers (a : G) (H : Subgroup G) :
    subspaceCommutator ρ ⊤ (conjugateSpanBy (zpowers a) H) =
      conjugateDisplacementSpan ρ a H := by
  let W := conjugateDisplacementSpan ρ a H
  have ha : a ∈ displacementIn ρ W := by
    intro v
    exact Submodule.subset_span ⟨1, H.one_mem, v, by simp⟩
  have hn : H ≤ normalizer (displacementIn ρ W) := by
    apply le_normalizer_iff.mpr
    intro h hh g hg v
    have hm := conjugateDisplacementSpan_stable ρ a H h hh (hg (ρ h⁻¹ v))
    simpa only [map_sub, ← Module.End.mul_apply, ← map_mul, mul_inv_cancel,
      map_one, Module.End.one_apply, mul_assoc] using hm
  have hgen := conjugateSpanBy_le (zpowers_le.mpr ha) hn
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨g, hg, v, _, rfl⟩
    exact hgen hg v
  · apply Submodule.span_le.mpr
    rintro _ ⟨h, hh, v, rfl⟩
    change ρ h (ρ a v - v) ∈ subspaceCommutator ρ ⊤ (conjugateSpanBy (zpowers a) H)
    have hconj : h * a * h⁻¹ ∈ conjugateSpanBy (zpowers a) H :=
      subset_closure ⟨h, hh, a, mem_zpowers a, rfl⟩
    have hm : ρ (h * a * h⁻¹) (ρ h v) - ρ h v ∈
        subspaceCommutator ρ ⊤ (conjugateSpanBy (zpowers a) H) :=
      Submodule.subset_span ⟨_, hconj, ρ h v, Submodule.mem_top, rfl⟩
    simpa only [map_sub, ← Module.End.mul_apply, ← map_mul,
      inv_mul_cancel_right] using hm

/-- The full conjugate span of the cyclic seed is its ordinary normal closure. -/
theorem conjugateSpanBy_zpowers_top (a : G) :
    conjugateSpanBy (zpowers a) ⊤ = normalClosure ({a} : Set G) := by
  apply le_antisymm
  · apply conjugateSpanBy_le
    · exact zpowers_le.mpr (subset_normalClosure (Set.mem_singleton a))
    · rw [normalizer_eq_top]
  · let K := conjugateSpanBy (zpowers a) (⊤ : Subgroup G)
    have hN : K.Normal := normalizer_eq_top_iff.mp
      (top_unique (le_normalizer_conjugateSpanBy (zpowers a) ⊤))
    let := hN
    apply normalClosure_le_normal
    intro x hx
    rcases Set.mem_singleton_iff.mp hx with rfl
    exact le_conjugateSpanBy (zpowers x) ⊤ (mem_zpowers x)

/-- An H-invariant space containing the seed displacement contains all
commutators of the H-conjugate closure. -/
theorem commutator_conjugateSpanBy_le (a : G) (H : Subgroup G)
    (U : Submodule (ZMod 2) V) (hU : H ≤ subspaceStabilizer ρ U)
    (ha : LinearMap.range (ρ a - LinearMap.id) ≤ U) :
    subspaceCommutator ρ ⊤ (conjugateSpanBy (zpowers a) H) ≤ U := by
  rw [commutator_conjugateSpanBy_zpowers]
  apply Submodule.span_le.mpr
  rintro _ ⟨h, hh, v, rfl⟩
  exact (hU hh _).2 (ha (LinearMap.mem_range_self (ρ a - LinearMap.id) v))

/-- Fixing an H-invariant space propagates from a to its H-conjugate closure. -/
theorem fixedSpace_conjugateSpanBy (a : G) (H : Subgroup G)
    (U : Submodule (ZMod 2) V) (hU : H ≤ subspaceStabilizer ρ U)
    (ha : ∀ v ∈ U, ρ a v = v) :
    subspaceCommutator ρ U (conjugateSpanBy (zpowers a) H) = ⊥ := by
  have hcyc : zpowers a ≤ subspaceKernel ρ U ⊤ :=
    zpowers_le.mpr ⟨Subgroup.mem_top _, ha⟩
  have hgen : conjugateSpanBy (zpowers a) H ≤ subspaceKernel ρ U ⊤ := by
    apply (closure_le _).mpr
    rintro _ ⟨h, hh, g, hg, rfl⟩
    refine ⟨Subgroup.mem_top _, ?_⟩
    intro v hv
    have hv' := (hU (H.inv_mem hh) v).2 hv
    have he := congrArg (ρ h) ((hcyc hg).2 _ hv')
    simpa only [← Module.End.mul_apply, ← map_mul, mul_inv_cancel,
      map_one, Module.End.one_apply, mul_assoc] using he
  apply (subspaceCommutator_eq_bot_iff ρ U _).mpr
  intro v hv g
  exact (hgen g.property).2 v hv
end Representation.BinaryOffender

namespace LinearMap
variable {k V : Type*} [Field k] [AddCommGroup V] [Module k V]
  [FiniteDimensional k V]
/-- An invariant subspace moved nontrivially by a rank-at-most-two operator,
which does not contain its image, has rank-one movement on itself and its quotient. -/
theorem rank_one_on_subspace_and_quotient (f : V →ₗ[k] V)
    (U : Submodule k V) (hstable : U.map f ≤ U)
    (hmove : U.map f ≠ ⊥) (hquot : ¬ f.range ≤ U)
    (hrank : Module.finrank k f.range ≤ 2) :
    Module.finrank k (U.map f) = 1 ∧
      Module.finrank k (f.range.map U.mkQ) = 1 := by
  have hle : U.map f ≤ f.range := by
    rintro _ ⟨v, _, rfl⟩
    exact mem_range_self f v
  have hlt : U.map f < f.range := lt_of_le_of_ne hle (by
    intro he
    exact hquot (he ▸ hstable))
  have hdim := Submodule.finrank_lt_finrank_of_lt hlt
  have hpos : Module.finrank k (U.map f) ≠ 0 := by
    exact fun h => hmove (Submodule.finrank_eq_zero.mp h)
  have hfirst : Module.finrank k (U.map f) = 1 := by omega
  let q := U.mkQ.comp f.range.subtype
  have hqrange : q.range = f.range.map U.mkQ := by
    rw [LinearMap.range_comp, Submodule.range_subtype]
  have hqnonzero : q.range ≠ ⊥ := by
    intro he
    apply hquot
    intro v hv
    have hm : U.mkQ v ∈ q.range := ⟨⟨v, hv⟩, rfl⟩
    rw [he, Submodule.mem_bot] at hm
    exact (Submodule.Quotient.mk_eq_zero U).mp hm
  have hker : q.ker ≠ ⊥ := by
    intro he
    apply hmove
    apply le_bot_iff.mp
    intro v hv
    have hvker : (⟨v, hle hv⟩ : f.range) ∈ q.ker := by
      change U.mkQ v = 0
      exact (Submodule.Quotient.mk_eq_zero U).mpr (hstable hv)
    rw [he, Submodule.mem_bot] at hvker
    exact congrArg Subtype.val hvker
  have hqpos : Module.finrank k q.range ≠ 0 :=
    fun h => hqnonzero (Submodule.finrank_eq_zero.mp h)
  have hkpos : Module.finrank k q.ker ≠ 0 :=
    fun h => hker (Submodule.finrank_eq_zero.mp h)
  have hd := q.finrank_range_add_finrank_ker
  refine ⟨hfirst, ?_⟩
  rw [← hqrange]
  omega
end LinearMap

namespace Representation.BinaryOffender
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

/-- A finite group orbit of a finite-dimensional displacement spans a
finite-dimensional module. Finiteness of the whole module is not an extra
hypothesis in the source low-rank setting. -/
theorem finite_of_conjugateDisplacementSpan_eq_top [Finite G] (a : G)
    [Module.Finite (ZMod 2) (LinearMap.range (ρ a - LinearMap.id))]
    (hspan : conjugateDisplacementSpan ρ a ⊤ = ⊤) : Module.Finite (ZMod 2) V := by
  let D := LinearMap.range (ρ a - LinearMap.id)
  let S (g : G) := D.map (ρ g)
  have he : conjugateDisplacementSpan ρ a ⊤ = ⨆ g, S g := by
    apply le_antisymm
    · apply Submodule.span_le.mpr
      rintro _ ⟨g, _, v, rfl⟩
      exact (le_iSup S g) ⟨ρ a v - v,
        LinearMap.mem_range_self (ρ a - LinearMap.id) v, rfl⟩
    · apply iSup_le
      intro g
      rintro _ ⟨_, ⟨v, rfl⟩, rfl⟩
      exact Submodule.subset_span ⟨g, Subgroup.mem_top _, v, rfl⟩
  have hfin : Module.Finite (ZMod 2) (⨆ g, S g : Submodule (ZMod 2) V) := inferInstance
  rw [← he, hspan] at hfin
  let := hfin
  exact Module.Finite.equiv (Submodule.topEquiv : (⊤ : Submodule (ZMod 2) V) ≃ₗ[ZMod 2] V)
end Representation.BinaryOffender
