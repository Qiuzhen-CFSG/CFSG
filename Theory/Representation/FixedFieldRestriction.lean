module

public import Mathlib.FieldTheory.Fixed
public import Mathlib.Algebra.Ring.Action.End
public import Mathlib.Algebra.Group.Subgroup.ZPowers.Basic
public import Mathlib.Algebra.Module.Submodule.Basic

/-!
# Detecting field automorphisms on a fixed scalar orbit

An automorphism of a finite field fixing the fixed field of σ belongs to the
cyclic group generated by σ, by the fixed-field theorem. For a semilinear
actor, one vector outside a subspace detects this condition: fixing its
σ-fixed scalar multiples modulo the subspace forces each such scalar to be
fixed by the actor's field coefficient.

This supplies the field-kernel input for the original fixed-subgroup actions
in Aschbacher--Smith, §2.4, printed pp.538--539. The argument does not require
simultaneous coordinates for all actors or a classification of their group.
-/

public section
noncomputable section
namespace Theory.FixedFieldRestriction
variable {F : Type*} [Field F] [Finite F]

/-- Pointwise fixation of the fixed field detects the cyclic field subgroup. -/
theorem mem_zpowers_of_fixedField_fixed
    (σ τ : F ≃+* F) (hτ : ∀ x : F, σ x = x → τ x = x) :
    τ ∈ Subgroup.zpowers σ := by
  let H := Subgroup.zpowers σ
  let K := FixedPoints.subfield H F
  let : Finite H := Finite.of_injective
    (fun g : H => (g.val : F → F))
    (fun a b h => Subtype.ext (DFunLike.coe_injective h))
  let t : F →ₐ[K] F := { τ.toRingHom with
    commutes' := fun x => hτ x (x.property ⟨σ, Subgroup.mem_zpowers σ⟩) }
  obtain ⟨g,hg⟩ := (FixedPoints.toAlgHom_bijective H F).2 t
  have he : (g : F ≃+* F) = τ := by
    ext x
    exact DFunLike.congr_fun hg x
  exact he ▸ g.property

variable {V : Type*} [AddCommGroup V] [Module F V]

/-- One nonzero fixed scalar orbit modulo a subspace detects the field kernel. -/
theorem mem_zpowers_of_semilinear_fixed_scalar_orbit
    (σ τ : F ≃+* F) (β : V → V)
    (hβ : ∀ (a : F) (v : V), β (a • v) = τ a • β v)
    (W : Submodule F V) (v : V) (hv : v ∉ W)
    (hfix : ∀ a : F, σ a = a → β (a • v) - a • v ∈ W) :
    τ ∈ Subgroup.zpowers σ := by
  apply mem_zpowers_of_fixedField_fixed σ τ
  intro a ha
  have h1 : β v - v ∈ W := by
    simpa only [one_smul] using hfix 1 (map_one σ)
  have hs := W.sub_mem (hfix a ha) (W.smul_mem (τ a) h1)
  rw [hβ, smul_sub] at hs
  have he : (τ a • β v - a • v) - (τ a • β v - τ a • v) =
      (τ a - a) • v := by
    rw [sub_smul]
    abel
  rw [he] at hs
  by_contra hne
  exact hv ((W.smul_mem_iff (sub_ne_zero.mpr hne)).mp hs)

end Theory.FixedFieldRestriction
