module
public import Theory.Representation.SL5ExteriorSquare.LocalGeometry.Coordinates

/-!
# Standard flag and shear subgroup for binary SL₅ exterior geometry

The parabolics are actual stabilizers in the determinant-one matrix group.
The last-column shears are explicit matrices, not a postulated radical. Identifying
them with the relevant two-core is a separate structural calculation.

Reference: Aschbacher--Smith, §12.5, printed pp.817–821/PDF pp.834–838.
-/

@[expose] public section
namespace Representation.SL5ExteriorSquare
open SL5TenDimensional

/-- The first k coordinate vectors of the natural module. -/
def naturalFlag (k : ℕ) : Submodule (ZMod 2) (Fin 5 → ZMod 2) where
  carrier := {v | ∀ i, k ≤ i.val → v i = 0}
  zero_mem' := by intro i hi; rfl
  add_mem' := by intro v w hv hw i hi; simp [hv i hi, hw i hi]
  smul_mem' := by intro c v hv i hi; simp [hv i hi]

/-- Restriction to the first k coordinates identifies Γ_k with F₂^k. -/
noncomputable def naturalFlagEquiv (k : ℕ) (hk : k ≤ 5) :
    naturalFlag k ≃ₗ[ZMod 2] (Fin k → ZMod 2) where
  toFun v i := v.val (Fin.castLE hk i)
  invFun w := ⟨fun i => if h : i.val < k then w ⟨i.val, h⟩ else 0, by
    intro i hi
    simp [not_lt.mpr hi]⟩
  left_inv v := by
    apply Subtype.ext
    funext i
    by_cases h : i.val < k
    · simp [h]
    · simpa [h] using (v.property i (Nat.le_of_not_gt h)).symm
  right_inv w := by
    funext i
    simp
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- The dimensions of the actual standard flag. -/
theorem finrank_naturalFlag (k : ℕ) (hk : k ≤ 5) :
    Module.finrank (ZMod 2) (naturalFlag k) = k := by
  rw [(naturalFlagEquiv k hk).finrank_eq]
  simp

/-- The setwise stabilizer for a genuine linear representation. -/
def subspaceStabilizer {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]
    (ρ : Representation (ZMod 2) Group W) (U : Submodule (ZMod 2) W) : Subgroup Group where
  carrier := {g | ∀ v, ρ g v ∈ U ↔ v ∈ U}
  one_mem' := by intro v; simp
  mul_mem' := by
    intro g h hg hh v
    change ρ (g * h) v ∈ U ↔ v ∈ U
    rw [map_mul]
    exact (hg (ρ h v)).trans (hh v)
  inv_mem' := by
    intro g hg v
    have hi : ρ g (ρ g⁻¹ v) = v := by
      change (ρ g * ρ g⁻¹) v = v
      rw [← map_mul, mul_inv_cancel, map_one]
      rfl
    exact (hg (ρ g⁻¹ v)).symm.trans (by rw [hi])

@[simp] theorem mem_subspaceStabilizer {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]
    (ρ : Representation (ZMod 2) Group W) (U : Submodule (ZMod 2) W) (g : Group) :
    g ∈ subspaceStabilizer ρ U ↔ ∀ v, ρ g v ∈ U ↔ v ∈ U := Iff.rfl

/-- Stabilizer of Γ_k in the actual natural action. -/
def parabolic (k : ℕ) : Subgroup Group :=
  subspaceStabilizer (specialLinearNatural (k := ZMod 2) 5) (naturalFlag k)

/-- Stabilizer of a subspace of the exterior square. -/
noncomputable def exteriorStabilizer (U : Submodule (ZMod 2) V) : Subgroup Group :=
  subspaceStabilizer (exteriorAction 2) U

/-- The upper-triangular subgroup associated to the standard complete flag. -/
def flagGroup : Subgroup Group := ⨅ k : Fin 5, parabolic k.val

/-- Add a specified vector of Γ₄ to the last standard vector. -/
def shear (u : Fin 4 → ZMod 2) : Group :=
  (List.ofFn fun i : Fin 4 => Matrix.SpecialLinearGroup.transvection
    (i := i.castSucc) (j := (4 : Fin 5)) (by
      intro h
      have := congrArg Fin.val h
      change i.val = 4 at this
      omega) (u i)).prod

/-- The subgroup generated by the last-column shears. -/
def shearSubgroup : Subgroup Group := Subgroup.closure (Set.range shear)

/-- The defining generators lie in the shear subgroup. -/
theorem shear_mem (u : Fin 4 → ZMod 2) : shear u ∈ shearSubgroup :=
  Subgroup.subset_closure (Set.mem_range_self _)

end Representation.SL5ExteriorSquare
