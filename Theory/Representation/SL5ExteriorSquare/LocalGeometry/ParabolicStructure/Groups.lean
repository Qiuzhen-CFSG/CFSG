module

public import Theory.Representation.SL5ExteriorSquare.LocalGeometry.ParabolicStructure.Stabilizers
public import Theory.LinearAlgebra.BinaryBlockGeneration
public import Theory.GroupTheory.SolvableResidual
public import Theory.PGroupCore

/-!
# Block generation and source residual groups

Binary block elimination generates each actual natural parabolic by exactly
its allowed elementary transvections. The source groups are then defined using
the terminal derived subgroup and O₂ of its join with the marked flag group.
The parameter k denotes the natural flag dimension: k = 2,3,1,4 corresponds to
the exterior spaces V₁,V₃,V₄,V₆. In particular, the radical of LᵢT is kept
distinct from the two-core of Mᵢ and is not presumed contained in Lᵢ.

These concrete definitions are the common interface for the quotient and
module identifications in Aschbacher–Smith, Lemma 12.5.2, printed p.817/PDF p.834.
-/

@[expose] public section
namespace Representation.SL5ExteriorSquare
open SL5TenDimensional

/-- All elementary transvections allowed by the standard two-block partition. -/
def parabolicTransvections (k : ℕ) : Set Group :=
  {g | ∃ (i j : Fin 5) (hij : i ≠ j) (c : ZMod 2),
    (j.val < k → i.val < k) ∧ g = Matrix.SpecialLinearGroup.transvection hij c}

/-- The actual natural flag stabilizer is generated by its block transvections. -/
theorem parabolic_eq_closure_transvections (k : ℕ) :
    parabolic k = Subgroup.closure (parabolicTransvections k) := by
  apply le_antisymm
  · intro g hg
    have hz := (mem_parabolic_iff_lowerLeft_zero k g).mp hg
    let H := Subgroup.closure (parabolicTransvections k)
    have hex : ∃ h : Group, h ∈ H ∧ h.val = g.val := by
      apply Matrix.binary_partition_induction (fun i : Fin 5 => i.val < k)
        (fun M => ∃ h : Group, h ∈ H ∧ h.val = M)
      · exact ⟨1, H.one_mem, rfl⟩
      · rintro A B ⟨a, ha, rfl⟩ ⟨b, hb, rfl⟩
        exact ⟨a * b, H.mul_mem ha hb, rfl⟩
      · intro i j hij hp c
        exact ⟨Matrix.SpecialLinearGroup.transvection hij c,
          Subgroup.subset_closure ⟨i, j, hij, c, hp, rfl⟩, rfl⟩
      · rw [g.property]
        exact one_ne_zero
      · intro i j hi hj
        exact hz i j (Nat.le_of_not_gt hi) hj
    obtain ⟨h, hh, he⟩ := hex
    exact (Subtype.ext he : h = g) ▸ hh
  · apply (Subgroup.closure_le _).mpr
    rintro g ⟨i, j, hij, c, hp, rfl⟩
    apply (mem_parabolic_iff_lowerLeft_zero k _).mpr
    intro r s hr hs
    have hrs : r ≠ s := by intro he; subst r; omega
    change Matrix.transvection i j c r s = 0
    by_cases hri : r = i
    · subst r
      have hsj : s ≠ j := by
        intro he
        subst s
        have := hp hs
        omega
      simp [Matrix.transvection, Matrix.single, hrs, Ne.symm hsj]
    · simp [Matrix.transvection, Matrix.single, hrs, Ne.symm hri]

/-- The terminal derived subgroup of the actual k-space parabolic, embedded in SL₅(2). -/
def parabolicResidual (k : ℕ) : Subgroup Group :=
  (Subgroup.solvableResidual (parabolic k)).map (parabolic k).subtype

/-- The source overgroup LᵢT, with k = 2,3,1,4 for i = 1,3,4,6. -/
def parabolicResidualFlag (k : ℕ) : Subgroup Group :=
  parabolicResidual k ⊔ flagGroup

/-- The source radical Rᵢ = O₂(LᵢT), embedded in the actual matrix group.
This is not defined as the two-core of the full parabolic. -/
def parabolicResidualTwoCore (k : ℕ) : Subgroup Group :=
  (pCore 2 (parabolicResidualFlag k)).map (parabolicResidualFlag k).subtype

/-- The residual is contained in its actual natural parabolic. -/
theorem parabolicResidual_le (k : ℕ) : parabolicResidual k ≤ parabolic k := by
  rintro _ ⟨x, _, rfl⟩
  exact x.property

/-- The source overgroup lies in the parabolic associated with that flag term. -/
theorem parabolicResidualFlag_le (k : ℕ) (hk : k < 5) :
    parabolicResidualFlag k ≤ parabolic k :=
  sup_le (parabolicResidual_le k) (flagGroup_le_parabolic k hk)

/-- The radical has its defining containment in LᵢT, without imposing Rᵢ ≤ Lᵢ. -/
theorem parabolicResidualTwoCore_le (k : ℕ) :
    parabolicResidualTwoCore k ≤ parabolicResidualFlag k := by
  rintro _ ⟨x, _, rfl⟩
  exact x.property

/-- In source clause (4), both L₆ and L₆T stabilize the literal exterior subspace. -/
theorem parabolicResidualFlag_four_le_stabilizer_V₆ :
    parabolicResidualFlag 4 ≤ exteriorStabilizer V₆ := by
  rw [exteriorStabilizer_V₆_eq_parabolic]
  exact parabolicResidualFlag_le 4 (by decide)

end Representation.SL5ExteriorSquare
