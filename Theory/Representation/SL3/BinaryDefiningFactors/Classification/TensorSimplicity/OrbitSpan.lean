module

public import Theory.Representation.SL3.BinaryDefiningFactors.Classification.TensorSimplicity.HighestVector
public import Theory.Representation.SL3.BinaryDefiningFactors.Classification.TensorSimplicity.RestrictedFactors
public import Theory.Representation.SL3.BinaryDefiningFactors.Classification.TensorSimplicity.OrbitSpan.PolynomialPairing

/-!
# Orbit spans for the concrete SL₃ tensor words

For a word of length `n` over a field of order `2^n`, its recursive highest
vector is cyclic: `wordSeed_orbit_span` is the unconditional orbit-span
input to `wordRep_isIrreducible_of_fixedLine_and_span`. Its only arithmetic
premises are the field cardinality and word length; algebraic closure of the
coefficient field is unnecessary. All four factors, including the trace-zero
adjoint factor, and the field of order two are covered.

The re-exported `FixedLine.wordSeed_lower_orbit_span` proves the stronger
lower-unitriangular assertion. Polynomial coefficient separation makes the
transpose pairing nondegenerate, so every functional annihilating that orbit
is zero. This proof uses neither word irreducibility nor tensor classification.
The general linear reduction from irreducibility is retained separately below.

Source: GLS III, 2.8.6(a), 2.8.9 and 2.8.10(c).
-/

public section

set_option backward.isDefEq.respectTransparency false
noncomputable section
open scoped MatrixGroups TensorProduct
namespace Representation.SL3.BinaryDefiningFactors.TensorSimplicity

variable {F K : Type*} [Field F] [Field K] [CharP K 2]

/-- An irreducible concrete word is generated by its recursive highest vector. -/
theorem wordSeed_orbit_span_of_irreducible
    (ι : F →+* K) (w : List Factor)
    (hirr : IsIrreducible (wordRep ι w)) :
    Submodule.span K (Set.range fun g : SL(3,F) =>
      wordRep ι w g (wordSeed K w)) = ⊤ := by
  let : Nontrivial (WordSpace K w) :=
    ⟨⟨wordSeed K w, 0, wordSeed_ne_zero K w⟩⟩
  let S : Subrepresentation (wordRep ι w) :=
    { toSubmodule := Submodule.span K (Set.range fun g : SL(3,F) =>
        wordRep ι w g (wordSeed K w))
      apply_mem_toSubmodule := by
        intro g v hv
        induction hv using Submodule.span_induction with
        | mem x hx =>
            obtain ⟨h, rfl⟩ := hx
            rw [← Module.End.mul_apply, ← map_mul]
            exact Submodule.subset_span ⟨g * h, rfl⟩
        | zero => simp
        | add x y _ _ hx hy => simpa only [map_add] using (Submodule.span K (Set.range fun g : SL(3,F) =>
          wordRep ι w g (wordSeed K w))).add_mem hx hy
        | smul c x _ hx => simpa only [map_smul] using (Submodule.span K (Set.range fun g : SL(3,F) =>
          wordRep ι w g (wordSeed K w))).smul_mem c hx }
  have hseed : wordSeed K w ∈ S.toSubmodule := by
    exact Submodule.subset_span ⟨1, by simp⟩
  have hS_ne_bot : S ≠ ⊥ := by
    intro h
    have : wordSeed K w ∈ (⊥ : Subrepresentation (wordRep ι w)).toSubmodule := by
      rw [← h]
      exact hseed
    exact (wordSeed_ne_zero K w) (show wordSeed K w = 0 from this)
  rw [IsIrreducible, isSimpleOrder_iff] at hirr
  have hS_top : S = ⊤ := (hirr.2 S).resolve_left hS_ne_bot
  exact congrArg Subrepresentation.toSubmodule hS_top

end Representation.SL3.BinaryDefiningFactors.TensorSimplicity
