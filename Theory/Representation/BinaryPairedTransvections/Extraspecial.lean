/-!
# Extraspecial groups from paired binary transvections

Let `c` be a nonzero vector and `d` a nonzero linear form with `d c = 0`.
The radicals of the line through `c` and of the hyperplane `ker d`
normalize one another. Their join has center generated by the transvection
`v ↦ v + d(v) • c`, and its central quotient is elementary abelian.
If the ambient dimension is `s + 2`, with `s > 0`, this join is extraspecial
and contains the original elementary center-root group of order `2^(s+1)`.

The proof uses self-centralization of the two radicals to identify the
center with their intersection. In their normalized product, the square
of every element lies in that intersection. This is the three-block
unipotent calculation in Aschbacher--Smith, *The Classification of
Quasithin Groups*, original Lemma 15.3.56(6--7), printed p. 1148
(combined manuscript, 1 March 2004).
-/

open scoped Pointwise
open Subgroup
public section
namespace BinaryPairedTransvections

private theorem center_sup_eq_inf
    {G : Type*} [Group G] (X Y : Subgroup G)
    [IsMulCommutative X] [IsMulCommutative Y]
    (hX : centralizer (X : Set G) ≤ X)
    (hY : centralizer (Y : Set G) ≤ Y) :
    (center ↥(X ⊔ Y : Subgroup G)).map (X ⊔ Y).subtype = X ⊓ Y := by
  apply le_antisymm
  · rintro g ⟨z, hz, rfl⟩
    constructor
    · apply hX
      intro x hx
      exact congrArg Subtype.val (mem_center_iff.mp hz ⟨x, (show X ≤ X ⊔ Y from le_sup_left) hx⟩)
    · apply hY
      intro y hy
      exact congrArg Subtype.val (mem_center_iff.mp hz ⟨y, (show Y ≤ X ⊔ Y from le_sup_right) hy⟩)
  · intro g hg
    refine ⟨⟨g, (show X ≤ X ⊔ Y from le_sup_left) hg.1⟩, ?_, rfl⟩
    apply mem_center_iff.mpr
    intro z
    apply Subtype.ext
    have hcent : X ⊔ Y ≤ centralizer ({g} : Set G) := by
      apply sup_le
      · intro x hx
        exact mem_centralizer_singleton_iff.mpr ((le_centralizer X hg.1) x hx)
      · intro y hy
        exact mem_centralizer_singleton_iff.mpr ((le_centralizer Y hg.2) y hy)
    exact mem_centralizer_singleton_iff.mp (hcent z.property)

private theorem quotient_center_elementary
    {G : Type*} [Group G] (X Y : Subgroup G)
    [IsElementaryAbelian 2 X] [IsElementaryAbelian 2 Y]
    (hXY : X ≤ normalizer (Y : Set G))
    (hYX : Y ≤ normalizer (X : Set G))
    (hcenter : (center ↥(X ⊔ Y : Subgroup G)).map (X ⊔ Y).subtype = X ⊓ Y) :
    IsElementaryAbelian 2 (↥(X ⊔ Y : Subgroup G) ⧸ center ↥(X ⊔ Y : Subgroup G)) := by
  have hs (q : ↥(X ⊔ Y : Subgroup G) ⧸ center ↥(X ⊔ Y : Subgroup G)) : q ^ 2 = 1 := by
    induction q using QuotientGroup.induction_on with
    | H g =>
      rw [← QuotientGroup.mk_pow, QuotientGroup.eq_one_iff]
      have hprod : (g : G) ∈ (X : Set G) * (Y : Set G) := by
        rw [← coe_mul_of_right_le_normalizer_left X Y hYX]
        exact g.property
      obtain ⟨x, hx, y, hy, he⟩ := hprod
      have hxi : x⁻¹ = x := inv_eq_of_mul_eq_one_right
        (by simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) x hx)
      have hyi : y⁻¹ = y := inv_eq_of_mul_eq_one_right
        (by simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) y hy)
      have hp : (g : G)^2 ∈ X ⊓ Y := by
        rw [← he, pow_two]
        constructor
        · change x*y*(x*y) ∈ X
          have hh : y*x*y⁻¹ ∈ X := (hYX hy x).mp hx
          rw [hyi] at hh
          simpa only [mul_assoc] using X.mul_mem hx hh
        · change x*y*(x*y) ∈ Y
          have hh : x*y*x⁻¹ ∈ Y := (hXY hx y).mp hy
          rw [hxi] at hh
          simpa only [mul_assoc] using Y.mul_mem hh hy
      rw [← hcenter] at hp
      obtain ⟨z, hz, hzg⟩ := hp
      have : z = g^2 := Subtype.ext hzg
      exact this ▸ hz
  have hi (q : ↥(X ⊔ Y : Subgroup G) ⧸ center ↥(X ⊔ Y : Subgroup G)) : q⁻¹ = q :=
    inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using hs q)
  refine {
    is_comm := ⟨?_⟩
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr hs }
  intro a b
  simpa only [hi] using mul_inv_rev a b


open BinaryLinear BinaryTransvectionGroups
variable {E : Type*} [AddCommGroup E] [Module (ZMod 2) E]

private theorem radical_le_parabolic_of_le
    (U W : Submodule (ZMod 2) E) (hUW : U ≤ W) : radical U ≤ parabolic W := by
  apply le_trans _ (quotientFixer_le_parabolic W)
  intro g hg v
  exact hUW (hg.2 v)

private theorem radical_le_parabolic_of_ge
    (U W : Submodule (ZMod 2) E) (hUW : U ≤ W) : radical W ≤ parabolic U := by
  intro g hg v
  constructor
  · intro hv
    have hh := ((radical W).inv_mem hg).1 (g v) (hUW hv)
    have hh' : v = g v := by simpa using hh
    simpa only [← hh'] using hv
  · intro hv
    rw [hg.1 v (hUW hv)]
    exact hv

/-- The center-root group normalizes the incident axis-root group. -/
theorem centerGroup_normalizes_axisGroup (c : E) (d : Module.Dual (ZMod 2) E)
    (hdc : d c = 0) : centerGroup c ≤ normalizer (axisGroup d : Set (GL E)) := by
  rw [centerGroup_eq_radical, axisGroup_eq_radical]
  exact (radical_le_parabolic_of_le _ _ (Submodule.span_le.mpr (by simpa using hdc))).trans
    (parabolic_le_normalizer _)

/-- The axis-root group normalizes the incident center-root group. -/
theorem axisGroup_normalizes_centerGroup (c : E) (d : Module.Dual (ZMod 2) E)
    (hdc : d c = 0) : axisGroup d ≤ normalizer (centerGroup c : Set (GL E)) := by
  rw [centerGroup_eq_radical, axisGroup_eq_radical]
  exact (radical_le_parabolic_of_ge _ _ (Submodule.span_le.mpr (by simpa using hdc))).trans
    (parabolic_le_normalizer _)

/-- The intrinsic center is the intersection of the two root groups. -/
theorem center_pairGroup_eq_inf (c : E) (hc : c ≠ 0)
    (d : Module.Dual (ZMod 2) E) (hd : d ≠ 0) (hdc : d c = 0) :
    (center (pairGroup c d)).map (pairGroup c d).subtype = centerGroup c ⊓ axisGroup d := by
  let := centerGroup_elementary c
  let := axisGroup_elementary d
  have hl : Submodule.span (ZMod 2) {c} ≤ d.ker :=
    Submodule.span_le.mpr (by simpa using hdc)
  have hln : Submodule.span (ZMod 2) {c} ≠ ⊥ := by simpa using hc
  have hkt : d.ker ≠ ⊤ := by simpa using hd
  have hlt : Submodule.span (ZMod 2) {c} ≠ ⊤ := fun h => hkt (top_unique (h ▸ hl))
  have hkn : d.ker ≠ ⊥ := fun h => hln (bot_unique (h ▸ hl))
  apply center_sup_eq_inf
  · rw [centerGroup_eq_radical]
    exact centralizer_radical_le hln hlt
  · rw [axisGroup_eq_radical]
    exact centralizer_radical_le hkn hkt

/-- The root-group intersection is the marked central transvection group. -/
theorem centerGroup_inf_axisGroup (c : E) (d : Module.Dual (ZMod 2) E)
    (hd : d ≠ 0) (hdc : d c = 0) :
    centerGroup c ⊓ axisGroup d = zpowers (BinaryLinear.transvection c d hdc) := by
  obtain ⟨u, hu⟩ : ∃ u, d u ≠ 0 := by
    by_contra! hh
    exact hd (LinearMap.ext hh)
  have hu1 : d u = 1 := (by decide : ∀ a : ZMod 2, a ≠ 0 → a = 1) _ hu
  apply le_antisymm
  · intro g hg
    obtain ⟨_, w, hw, rfl⟩ := (mem_axisRootGroup_iff hd).mp hg.2
    have hh := hg.1.2.2 u
    change (u + d u • w) - u ∈ centerLine c at hh
    rw [hu1, one_smul, add_sub_cancel_left] at hh
    rcases (mem_centerLine_iff c w).mp hh with rfl | rfl
    · have ht : BinaryLinear.transvection (0 : E) d hw = 1 := by ext v; simp [BinaryLinear.transvection]
      rw [ht]
      exact one_mem _
    · exact mem_zpowers _
  · apply zpowers_le.mpr
    constructor
    · rw [centerGroup_eq_radical]
      exact transvection_mem (Submodule.mem_span_singleton_self c)
        (Submodule.span_le.mpr (by simpa using hdc))
    · exact transvection_mem_axisGroup d c hdc

/-- The literal image of the intrinsic center is the marked transvection group. -/
theorem center_pairGroup (c : E) (hc : c ≠ 0)
    (d : Module.Dual (ZMod 2) E) (hd : d ≠ 0) (hdc : d c = 0) :
    (center (pairGroup c d)).map (pairGroup c d).subtype =
      zpowers (BinaryLinear.transvection c d hdc) := by
  rw [center_pairGroup_eq_inf c hc d hd hdc, centerGroup_inf_axisGroup c d hd hdc]

/-- The intrinsic center has order two. -/
theorem center_pairGroup_card (c : E) (hc : c ≠ 0)
    (d : Module.Dual (ZMod 2) E) (hd : d ≠ 0) (hdc : d c = 0) :
    Nat.card (center (pairGroup c d)) = 2 := by
  rw [← card_map_of_injective (pairGroup c d).subtype_injective,
    center_pairGroup c hc d hd hdc, Nat.card_zpowers]
  apply orderOf_eq_prime
  · let := axisGroup_elementary d
    exact elemPow_eq_one_of_isElementaryAbelian (p := 2) _ (transvection_mem_axisGroup d c hdc)
  · obtain ⟨u, hu⟩ : ∃ u, d u ≠ 0 := by
      by_contra! hh
      exact hd (LinearMap.ext hh)
    have hu1 : d u = 1 := (by decide : ∀ a : ZMod 2, a ≠ 0 → a = 1) _ hu
    intro he
    have hh := congrArg (fun a : GL E => a u) he
    change u + d u • c = u at hh
    rw [hu1, one_smul] at hh
    exact hc (add_eq_left.mp hh)

/-- The quotient by the intrinsic center is elementary abelian. -/
theorem pairGroup_quotient_elementary (c : E) (hc : c ≠ 0)
    (d : Module.Dual (ZMod 2) E) (hd : d ≠ 0) (hdc : d c = 0) :
    IsElementaryAbelian 2 (pairGroup c d ⧸ center (pairGroup c d)) := by
  let := centerGroup_elementary c
  let := axisGroup_elementary d
  exact quotient_center_elementary (centerGroup c) (axisGroup d)
    (centerGroup_normalizes_axisGroup c d hdc) (axisGroup_normalizes_centerGroup c d hdc)
    (center_pairGroup_eq_inf c hc d hd hdc)

/-- The paired group is extraspecial when the space has dimension at least three. -/
theorem pairGroup_extraspecial [FiniteDimensional (ZMod 2) E]
    (c : E) (hc : c ≠ 0) (d : Module.Dual (ZMod 2) E) (hd : d ≠ 0)
    (hdc : d c = 0) (s : ℕ) (hs : 0 < s)
    (hdim : Module.finrank (ZMod 2) E = s + 2) : IsExtraspecial 2 (pairGroup c d) := by
  have hzcard := center_pairGroup_card c hc d hd hdc
  let : Finite ((center (pairGroup c d)).map (pairGroup c d).subtype) :=
    Nat.finite_of_card_ne_zero (by
      rw [card_map_of_injective (pairGroup c d).subtype_injective, hzcard]
      decide)
  refine {
    center_order_p := hzcard
    quotient_elementary_abelian := pairGroup_quotient_elementary c hc d hd hdc
    quotient_nontrivial := QuotientGroup.nontrivial_iff.mpr ?_ }
  intro hz
  have hle : centerGroup c ≤ (center (pairGroup c d)).map (pairGroup c d).subtype := by
    intro x hx
    exact ⟨⟨x, (show centerGroup c ≤ pairGroup c d from le_sup_left) hx⟩,
      hz ▸ mem_top _, rfl⟩
  have hbound := card_le_of_le hle
  rw [card_map_of_injective (pairGroup c d).subtype_injective, hzcard,
    centerGroup_card c hc s hdim] at hbound
  have hp : 2^1 < 2^(s+1) := Nat.pow_lt_pow_right (by decide) (by omega)
  omega

/-- The original center-root group gives the elementary subgroup of half dimension. -/
theorem pairGroup_contains_elementary [FiniteDimensional (ZMod 2) E]
    (c : E) (hc : c ≠ 0) (d : Module.Dual (ZMod 2) E)
    (s : ℕ) (hdim : Module.finrank (ZMod 2) E = s + 2) :
    ∃ X : Subgroup (pairGroup c d), IsElementaryAbelian 2 X ∧ Nat.card X = 2^(s+1) := by
  let : IsElementaryAbelian 2 (centerGroup c) := centerGroup_elementary c
  let X := (centerGroup c).subgroupOf (pairGroup c d)
  have hle : centerGroup c ≤ pairGroup c d := le_sup_left
  refine ⟨X, IsElementaryAbelian.subgroupOf hle, ?_⟩
  rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe hle).toEquiv]
  exact centerGroup_card c hc s hdim

end BinaryPairedTransvections
