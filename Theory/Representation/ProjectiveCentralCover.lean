module

public import Mathlib.Algebra.Module.Projective
public import Mathlib.RepresentationTheory.Coinvariants

/-!
# Projective modules have no nontrivial perfect central covers

An equivariant surjection onto a projective representation splits over the
group algebra. If its kernel is fixed, the complementary projection kills
every displacement `g • w - w`. Thus a source generated by these displacements
has zero kernel.

This is the projectivity argument for module covers in Aschbacher–Smith,
*The Classification of Quasithin Groups*, combined manuscript (1 March 2004),
Remark I.1.5, printed p.408, used in C.1.13(c), printed p.125.
-/

public section

namespace Representation.IntertwiningMap

/-- A commutator-generated central cover of a projective module is injective. -/
theorem injective_of_projective_of_fixed_kernel
    {k G V W : Type*} [Field k] [Group G]
    [AddCommGroup V] [Module k V] [AddCommGroup W] [Module k W]
    {ρ : Representation k G V} {σ : Representation k G W}
    [Module.Projective (MonoidAlgebra k G) ρ.asModule]
    (f : σ.IntertwiningMap ρ) (hf : Function.Surjective f)
    (hk : ∀ w, f w = 0 → ∀ g, σ g w = w)
    (hc : Coinvariants.ker σ = ⊤) : Function.Injective f := by
  let F := equivLinearMapAsModule σ ρ f
  obtain ⟨S, hS⟩ := Module.projective_lifting_property F LinearMap.id hf
  let s := (equivLinearMapAsModule ρ σ).symm S
  have hs (v : V) : f (s v) = v := LinearMap.congr_fun hS v
  let p : σ.IntertwiningMap σ := IntertwiningMap.id σ - s.comp f
  have hp (w : W) : f (p w) = 0 := by
    change f (w - s (f w)) = 0
    rw [map_sub, hs, sub_self]
  have hpc : Coinvariants.ker σ ≤ p.toLinearMap.ker := by
    rw [Coinvariants.ker, Submodule.span_le]
    rintro _ ⟨⟨g, w⟩, rfl⟩
    change p (σ g w - w) = 0
    rw [map_sub, p.isIntertwining, hk _ (hp w), sub_self]
  have hpzero (w : W) : p w = 0 := hpc (hc ▸ Submodule.mem_top)
  apply (LinearMap.ker_eq_bot).mp
  apply le_antisymm _ bot_le
  intro w hw
  have he := hpzero w
  change w - s (f w) = 0 at he
  rw [show f w = 0 from hw, map_zero, sub_zero] at he
  exact he

end Representation.IntertwiningMap
