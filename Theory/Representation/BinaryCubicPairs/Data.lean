def lookup (d : Mat) : Certificate := (certificates.lookup d.toNat).getD ⟨[], 0, 0, 0, 0, 0⟩

def checkB (n : Nat) : Bool :=
  let d := BitVec.ofNat 16 n
  (!readyB d) || validB d (lookup d)

def block (i : Nat) : Bool :=
  (List.range 1024).all fun j => checkB (1024 * i + j)

end BinaryCubicPairs.Packed
