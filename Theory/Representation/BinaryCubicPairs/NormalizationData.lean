def normalizationData : List (Nat × (BitVec 16 × BitVec 16)) :=
  normalizationData0 ++ normalizationData1 ++ normalizationData2 ++ normalizationData3 ++ normalizationData4 ++ normalizationData5

def normalization (a : BitVec 16) : BitVec 16 × BitVec 16 :=
  (normalizationData.lookup a.toNat).getD (ident, ident)

def cubicB (a : BitVec 16) : Bool :=
  mm (mm a a) a == ident &&
    ((List.range 16).countP (fun z => mv a (BitVec.ofNat 4 z) == BitVec.ofNat 4 z) == 4)

def normalizationCheck (n : Nat) : Bool :=
  let a := BitVec.ofNat 16 n
  let g := normalization a
  (!cubicB a) || ((mm g.1 g.2 == ident) && (mm g.2 g.1 == ident) &&
    (mm (mm g.1 a) g.2 == cubic))

def normalizationBlock (i : Nat) : Bool :=
  (List.range 1024).all fun j => normalizationCheck (1024 * i + j)

end BinaryCubicPairs.Packed
