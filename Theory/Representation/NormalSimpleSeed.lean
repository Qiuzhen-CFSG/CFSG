module

public import Theory.Representation.NormalSemisimpleSpan
public import Theory.Representation.CliffordSubquotient
public import Theory.Representation.SubrepresentationLattice

/-!
# Fixed vectors in the orbit span of a nontrivial simple seed

Let N be normal in the actor group. If an irreducible N-submodule has
nontrivial N-action and its ambient orbit generates the representation,
then N has no fixed vectors on that representation. Clifford semisimplicity
makes the restriction semisimple; the seed's nonzero displacement generates
it, so the whole representation is generated by N-displacements.

The original rank-three flag in 12.8.13(4) applies this to the normal closure
of L₁. This replaces the source's intermediate proof that L₁ itself is normal.
Source: Aschbacher--Smith, printed p.856; the semisimple-span argument is
standard Clifford theory.
-/

public section
open Subgroup
open scoped MonoidAlgebra
namespace Representation

/-- A normal subgroup has no fixed vectors if a simple nontrivial seed
and its ambient conjugates generate the representation. -/
theorem fixedSpace_eq_bot_of_normal_simple_seed {A W : Type*} [Group A] [AddCommGroup W] [Module (ZMod 2) W]
    (ρ : Representation (ZMod 2) A W)
    (N : Subgroup A) [N.Normal]
    (S : Subrepresentation (ρ.comp N.subtype))
    (hs : IsIrreducible S.toRepresentation)
    (hm : ∃ n : N, ∃ v : S, S.toRepresentation n v ≠ v)
    (hgen : ∀ U : Subrepresentation ρ, S.toSubmodule ≤ U.toSubmodule → U = ⊤) :
    BinaryOffender.fixedSpace (ρ.comp N.subtype) ⊤ = ⊥ := by
  let τ : Representation (ZMod 2) N W := ρ.comp N.subtype
  let := hs
  have hS : S.IsSemisimple := by
    let : IsSimpleModule (ZMod 2)[N] S.asSubmodule := isSimpleModule_iff_isAtom.mpr
      (((Subrepresentation.subrepresentationSubmoduleOrderIso (ρ := τ)).isAtom_iff S).mpr
        ((Subrepresentation.irreducible_iff_isAtom S).mp hs))
    exact inferInstance
  let : IsSemisimpleModule (ZMod 2)[N] τ.asModule :=
    normal_restriction_semisimple_of_generating_family ρ N (fun _ : Unit => S)
      (fun _ => hS) (fun U hu => hgen U (hu ()))
  let : IsSemisimpleRepresentation τ :=
    (isSemisimpleRepresentation_iff_isSemisimpleModule_asModule τ).mpr inferInstance
  let C : Subrepresentation ρ := ⟨Coinvariants.ker τ, Coinvariants.le_comap_ker ρ N⟩
  have hSC : S.toSubmodule ≤ C.toSubmodule := by
    let A : Subrepresentation S.toRepresentation := {
      toSubmodule := C.toSubmodule.comap S.toSubmodule.subtype
      apply_mem_toSubmodule n v hv := C.apply_mem_toSubmodule n hv }
    have hA : A ≠ ⊥ := by
      obtain ⟨n, v, hv⟩ := hm
      intro he
      have ha : S.toRepresentation n v - v ∈ A :=
        Coinvariants.sub_mem_ker n (v : W)
      rw [he] at ha
      exact hv (sub_eq_zero.mp ha)
    have ha : A = ⊤ := (hs.eq_bot_or_eq_top A).resolve_left hA
    intro v hv
    exact (show (⟨v,hv⟩ : S) ∈ A from ha ▸ Submodule.mem_top)
  have hc : Coinvariants.ker τ = ⊤ := congrArg Subrepresentation.toSubmodule (hgen C hSC)
  exact BinaryOffender.fixedSpace_eq_bot_of_semisimple_coinvariants τ hc


end Representation
