public theorem covered (c : MatrixCode) (hlo : 18432 ≤ c.val)
    (_hhi : c.val < 19683) (hc : codeDet c = 1) :
    ∃ j : Fin 12, IsConj (finiteModelEquiv ⟨c, hc⟩) (representative j) := by
  apply checkRow_sound c hc (witness (c.val - 18432))
  have h := (checkRange_spec row 0 1251).mp checked (c.val - 18432) (by omega)
  have he : (⟨(18432 + (c.val - 18432)) % 19683,
      Nat.mod_lt _ (by decide)⟩ : MatrixCode) = c := by
    apply Fin.ext
    change (18432 + (c.val - 18432)) % 19683 = c.val
    rw [Nat.add_sub_of_le hlo]
    exact Nat.mod_eq_of_lt c.isLt
  simp only [Nat.zero_add] at h
  change checkRow ⟨(18432 + (c.val - 18432)) % 19683,
    Nat.mod_lt _ (by decide)⟩ (witness (c.val - 18432)) = true at h
  rw [he] at h
  exact h
