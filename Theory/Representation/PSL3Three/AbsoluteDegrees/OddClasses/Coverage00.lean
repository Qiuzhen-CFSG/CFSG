public theorem covered (c : MatrixCode) (hlo : 0 ≤ c.val)
    (hhi : c.val < 2048) (hc : codeDet c = 1) :
    ∃ j : Fin 12, IsConj (finiteModelEquiv ⟨c, hc⟩) (representative j) := by
  apply checkRow_sound c hc (witness (c.val - 0))
  have h := (checkRange_spec row 0 2048).mp checked (c.val - 0) (by omega)
  have he : (⟨(0 + (c.val - 0)) % 19683,
      Nat.mod_lt _ (by decide)⟩ : MatrixCode) = c := by
    apply Fin.ext
    change (0 + (c.val - 0)) % 19683 = c.val
    rw [Nat.add_sub_of_le hlo]
    exact Nat.mod_eq_of_lt c.isLt
  simp only [Nat.zero_add] at h
  change checkRow ⟨(0 + (c.val - 0)) % 19683,
    Nat.mod_lt _ (by decide)⟩ (witness (c.val - 0)) = true at h
  rw [he] at h
  exact h
