module

public import Theory.Representation.PSL3Three.AbsoluteDegrees.SixteenModels.NativeAction.EdgeTable
public import Theory.Representation.PSL3Three.AbsoluteDegrees.SixteenModels.NativeAction.Evaluation
public import Theory.Representation.PSL3Three.AbsoluteDegrees.SixteenModels.Contracts
public import Theory.Representation.PSL3Three.AbsoluteDegrees.SixteenModels.MatrixFacts

/-!
# From native right-generator edges to the marked projective action

The two native matrices generate SL₃(3) as a monoid, since this finite group is
already generated by them as a group. Consequently identity normalization and
the two right-edge families imply the entire multiplication law. Coefficient
evaluation gives a matrix homomorphism over any requested field, and the existing
canonical SL₃(3)–PSL₃(3) isomorphism transports it to the literal quotient.
The two generator markings are proved through that same quotient map.

The result remains conditional on an `EdgeTable`. It supplies the action input
used for the degree-sixteen models underlying GM02 Proposition 4.2, manuscript
pp.9–10. It does not assert that an unchecked finite table is correct.
-/

public section
namespace Representation.PSL3Three.AbsoluteDegrees.SixteenModels.NativeAction

variable {F : Type*} [Field F] [CharP F 2]

theorem native_monoid_generators :
    Submonoid.closure ({nativeA, nativeB} : Set Matrix.PSL3Three.SL) = ⊤ := by
  let M := Submonoid.closure ({nativeA, nativeB} : Set Matrix.PSL3Three.SL)
  let H : Subgroup Matrix.PSL3Three.SL :=
    { M with
      inv_mem' := by
        intro g hg
        rw [← one_mul g⁻¹, ← pow_one g, ← pow_orderOf_eq_one g,
          ← pow_sub g (orderOf_pos g)]
        exact M.pow_mem hg _ }
  have hH : H = ⊤ := native_generators H
    (Submonoid.subset_closure (by simp)) (Submonoid.subset_closure (by simp))
  exact congrArg Subgroup.toSubmonoid hH


@[expose] def homOfEdges (f : Matrix.PSL3Three.SL → Matrix (Fin 16) (Fin 16) F)
    (a b : Matrix (Fin 16) (Fin 16) F) (h1 : f 1 = 1)
    (ha : ∀ g, f (g * nativeA) = f g * a)
    (hb : ∀ g, f (g * nativeB) = f g * b) :
    Matrix.PSL3Three.SL →* Matrix (Fin 16) (Fin 16) F := by
  have hfa : f nativeA = a := by simpa [h1] using ha 1
  have hfb : f nativeB = b := by simpa [h1] using hb 1
  exact MonoidHom.ofClosureMEqTopRight f native_monoid_generators h1 (by
    intro g s hs
    rcases hs with rfl | hs
    · simpa [hfa] using ha g
    · have hs' : s = nativeB := hs
      subst s
      simpa [hfb] using hb g)



namespace EdgeTable
variable (E : EdgeTable) (t : F) (ht : t ^ 4 = t + 1)

@[expose] def evaluated (g : Matrix.PSL3Three.SL) : Matrix (Fin 16) (Fin 16) F :=
  evaluate t (E.image (Matrix.PSL3Three.matrixCodeEquiv g.val))

omit [CharP F 2] in
theorem evaluated_one : E.evaluated t 1 = 1 := by
  change evaluate t (E.image (Matrix.PSL3Three.matrixCodeEquiv 1)) = 1
  rw [E.one, evaluate_one]

include ht in
theorem evaluated_rightA (g : Matrix.PSL3Three.SL) :
    E.evaluated t (g * nativeA) = E.evaluated t g * matrixA t := by
  have hc : Matrix.PSL3Three.codeDet (Matrix.PSL3Three.matrixCodeEquiv g.val) = 1 := by
    rw [Matrix.PSL3Three.codeDet_eq_det, Matrix.PSL3Three.decode_encode]
    exact g.property
  have h := E.rightA (Matrix.PSL3Three.matrixCodeEquiv g.val) hc
  rw [Matrix.PSL3Three.decode_encode] at h
  change evaluate t (E.image (Matrix.PSL3Three.matrixCodeEquiv (g.val * nativeA.val))) = _
  rw [h, evaluate_mul t ht]
  rfl

include ht in
theorem evaluated_rightB (g : Matrix.PSL3Three.SL) :
    E.evaluated t (g * nativeB) = E.evaluated t g * matrixB t := by
  have hc : Matrix.PSL3Three.codeDet (Matrix.PSL3Three.matrixCodeEquiv g.val) = 1 := by
    rw [Matrix.PSL3Three.codeDet_eq_det, Matrix.PSL3Three.decode_encode]
    exact g.property
  have h := E.rightB (Matrix.PSL3Three.matrixCodeEquiv g.val) hc
  rw [Matrix.PSL3Three.decode_encode] at h
  change evaluate t (E.image (Matrix.PSL3Three.matrixCodeEquiv (g.val * nativeB.val))) = _
  rw [h, evaluate_mul t ht]
  rfl

@[expose] def matrixHom : Matrix.PSL3Three.SL →* Matrix (Fin 16) (Fin 16) F :=
  homOfEdges (E.evaluated t) (matrixA t) (matrixB t)
    (E.evaluated_one t) (E.evaluated_rightA t ht) (E.evaluated_rightB t ht)

theorem matrixHom_nativeA : E.matrixHom t ht nativeA = matrixA t := by
  change E.evaluated t nativeA = matrixA t
  simpa only [one_mul, E.evaluated_one t] using E.evaluated_rightA t ht 1

theorem matrixHom_nativeB : E.matrixHom t ht nativeB = matrixB t := by
  change E.evaluated t nativeB = matrixB t
  simpa only [one_mul, E.evaluated_one t] using E.evaluated_rightB t ht 1

noncomputable def representation : Representation F Matrix.PSL3Three.PSL (Fin 16 → F) :=
  (Matrix.toLinAlgEquiv'.toMonoidHom.comp (E.matrixHom t ht)).comp
    Matrix.PSL3Three.equiv.symm.toMonoidHom

theorem realizes : Realizes t (E.representation t ht) := by
  constructor
  · change LinearMap.toMatrix' (Matrix.toLin'
      (E.matrixHom t ht (Matrix.PSL3Three.equiv.symm (Matrix.PSL3Three.project nativeA)))) = _
    rw [← Matrix.PSL3Three.equiv_apply, Matrix.PSL3Three.equiv.symm_apply_apply,
      E.matrixHom_nativeA, LinearMap.toMatrix'_toLin']
  · change LinearMap.toMatrix' (Matrix.toLin'
      (E.matrixHom t ht (Matrix.PSL3Three.equiv.symm (Matrix.PSL3Three.project nativeB)))) = _
    rw [← Matrix.PSL3Three.equiv_apply, Matrix.PSL3Three.equiv.symm_apply_apply,
      E.matrixHom_nativeB, LinearMap.toMatrix'_toLin']
end EdgeTable

universe v

theorem actionsExist_of_edgeTable (E : EdgeTable) : ActionsExist.{v} := by
  intro F _ _ t ht
  exact ⟨E.representation t ht, E.realizes t ht⟩

end Representation.PSL3Three.AbsoluteDegrees.SixteenModels.NativeAction
