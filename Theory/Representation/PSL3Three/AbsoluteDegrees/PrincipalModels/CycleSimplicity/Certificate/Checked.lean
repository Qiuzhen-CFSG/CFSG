theorem value_mem
    (Q : Subalgebra (ZMod 2) (Matrix (Fin 26) (Fin 26) (ZMod 2)))
    (h : ∀ a, Data.actorMatrix a ∈ Q) (k : ℕ) (hk : k < 77) :
    decode 26 values[k]! ∈ Q :=
  certificate_mem 26 77 Data.actorRows values operations steps Q h k hk

theorem rank_one : decode 26 values[56]! =
    Matrix.vecMulVec (fun i : Fin 26 => bit column i.val) (fun j : Fin 26 => bit row j.val) := by
  ext i j
  change bit (values[56]!)[i.val]! j.val = bit column i.val * bit row j.val
  revert i j
  decide +kernel

theorem columns_inverse : decode 26 columns * decode 26 columnInverse = 1 :=
  decode_mul_one 26 columns columnInverse (by decide +kernel)

theorem rows_inverse : decode 26 rowInverse * decode 26 rows = 1 :=
  decode_mul_one 26 rowInverse rows (by decide +kernel)

theorem left_action (i : Fin 26) :
    decode 26 values[leftIndex i]! *ᵥ (fun j : Fin 26 => bit column j.val) =
      fun j => decode 26 columns j i := by
  have h := decode_mulVec_of_column 26 values[leftIndex i]! columnEntries column (columnVectors i)
    (by decide +kernel) (by revert i; decide +kernel)
  refine h.trans ?_
  funext j
  change bit (columnVectors i) j.val = bit columns[j.val]! i.val
  revert i j
  decide +kernel

theorem right_action (i : Fin 26) :
    (fun j : Fin 26 => bit row j.val) ᵥ* decode 26 values[rightIndex i]! =
      decode 26 rows i :=
  decode_vecMul 26 values[rightIndex i]! row rows[i.val]!
    (by revert i; decide +kernel)

theorem leftIndex_lt (i : Fin 26) : leftIndex i < 77 :=
  (by decide +kernel : ∀ i : Fin 26, leftIndex i < 77) i

theorem rightIndex_lt (i : Fin 26) : rightIndex i < 77 :=
  (by decide +kernel : ∀ i : Fin 26, rightIndex i < 77) i

