module

public import Theory.Representation.BinaryPermutationNaturalDuality
public import Theory.Representation.BinaryAlternatingNaturalCohomology.Even
public import Theory.Representation.FirstCohomologyDuality

/-!
# The perfect augmentation cover for A₈

The augmentation projection has constant, hence fixed, kernel. Its source is
commutator-generated: the commutator subspace is alternating-invariant and
contains a nonconstant weight-two vector, so it contains the full augmentation
kernel. The invariant dot product identifies the six-dimensional natural
module with its dual; thus the dual H¹ dimension is one as well.

Together these are the concrete inputs to the universal covering comparison
in Aschbacher–Smith I.1.5–I.1.6(1), printed p.408, for the natural permutation
module of §B.3. They concern the six-dimensional A₈ module.
-/

@[expose] public section

open Module Representation Representation.OneCohomology Equiv
namespace BinaryPermutation

private lemma commutator_stable {k G W : Type*} [Field k] [Group G]
    [AddCommGroup W] [Module k W] (ρ : Representation k G W) (g : G) :
    Coinvariants.ker ρ ≤ (Coinvariants.ker ρ).comap (ρ g) := by
  apply Submodule.span_le.mpr
  rintro _ ⟨⟨h, v⟩, rfl⟩
  change ρ g (ρ h v - v) ∈ Coinvariants.ker ρ
  have he : ρ g (ρ h v - v) = (ρ (g * h) v - v) - (ρ g v - v) := by
    rw [map_sub, map_mul, Module.End.mul_apply]
    abel
  rw [he]
  exact (Coinvariants.ker ρ).sub_mem (Coinvariants.sub_mem_ker _ _)
    (Coinvariants.sub_mem_ker _ _)

/-- The augmentation module of A₈ is generated by its commutators. -/
lemma alternatingEight_core_generated :
    Coinvariants.ker (alternatingCoreRepresentation (Fin 8)) = ⊤ := by
  let ρ := alternatingCoreRepresentation (Fin 8)
  let C := Coinvariants.ker ρ
  let D := C.map (core (Fin 8)).subtype
  have hD : ∀ g : alternatingGroup (Fin 8), ∀ v ∈ D,
      representation (Fin 8) g.val v ∈ D := by
    intro g v hv
    obtain ⟨u, hu, rfl⟩ := hv
    exact ⟨ρ g u, commutator_stable ρ g hu, rfl⟩
  rcases invariant_le_constants_or_core_le (by decide : 5 ≤ Fintype.card (Fin 8)) D hD
      with h | h
  · let g : alternatingGroup (Fin 8) := ⟨swap 0 1 * swap 1 2, by
      simp [Perm.mem_alternatingGroup]⟩
    let v : core (Fin 8) := ⟨Pi.single 0 1 + Pi.single 3 1, by
      simp [mem_core, Finset.sum_add_distrib, CharTwo.add_self_eq_zero]⟩
    have hv : ρ g v - v ∈ C := Coinvariants.sub_mem_ker g v
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (h ⟨ρ g v - v, hv, rfl⟩)
    have hconst : (ρ g v - v).val 0 = (ρ g v - v).val 4 := by
      exact (congrFun hc.symm 0).trans (congrFun hc 4)
    have hne : (ρ g v - v).val 0 ≠ (ρ g v - v).val 4 := by decide
    exact (hne hconst).elim
  · apply top_unique
    intro v _
    obtain ⟨u, hu, he⟩ := h v.property
    have : u = v := Subtype.ext he
    exact this ▸ hu

/-- The augmentation projection as a map of alternating-group modules. -/
noncomputable def alternatingCoreProjection (Ω : Type*) [Fintype Ω] [DecidableEq Ω] :
    (alternatingCoreRepresentation Ω).IntertwiningMap (alternatingNaturalRepresentation Ω) :=
  (coreToNatural Ω).intertwiningMap_of_isIntertwiningMap _ _
    (fun g v => coreToNatural_equivariant g.val v)

/-- The seven-dimensional augmentation module is a perfect central cover. -/
lemma alternatingEight_coreProjection_isCover :
    IsCover (alternatingCoreProjection (Fin 8)) := by
  refine ⟨coreToNatural_surjective, ?_, alternatingEight_core_generated⟩
  intro v hv g
  have hv' : v.val ∈ constants (Fin 8) := by
    apply (Submodule.Quotient.mk_eq_zero _).mp
    exact congrArg Subtype.val hv
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hv'
  apply Subtype.ext
  change representation (Fin 8) g.val v.val = v.val
  rw [← hc, map_smul, permute_allOne]
/-- Self-duality transfers I.1.6(1) to the coefficients used in I.1.5. -/
lemma alternatingEight_natural_dual_finrank_H1 :
    finrank (ZMod 2) (H1 (alternatingNaturalRepresentation (Fin 8)).dual) = 1 := by
  let E := H1Congr (alternatingNaturalRepresentation (Fin 8))
    (alternatingNaturalRepresentation (Fin 8)).dual
    (MulEquiv.refl (alternatingGroup (Fin 8))) (naturalDualEquiv (Fin 8))
    (fun g v => naturalDualEquiv_equivariant (Fin 8) g.val v)
  rw [← E.finrank_eq]
  exact alternatingEight_natural_finrank_H1

end BinaryPermutation
