module
public import Theory.Representation.SemisimpleCoinvariants

/-!
# Fixed-free semisimple modules are fully moved

An invariant complement to the displacement span is fixed pointwise: each
of its displacements lies in both complementary spaces. If the whole fixed
space vanishes, so does this complement. The original exceptional A₅ layer
uses this only after proving its semisimplicity by canonical splitting.
Source: Aschbacher--Smith 5.1.14(4), printed p.638.
-/

public noncomputable section
open scoped MonoidAlgebra
namespace Representation
variable {k G V : Type*} [Field k] [Group G] [AddCommGroup V] [Module k V]

/-- A semisimple representation without fixed vectors is generated by its displacements. -/
theorem coinvariants_eq_top_of_semisimple_of_invariants_eq_bot
    (ρ : Representation k G V) [IsSemisimpleModule k[G] ρ.asModule]
    (hf : ρ.invariants = ⊥) : Coinvariants.ker ρ = ⊤ := by
  let : IsSemisimpleRepresentation ρ :=
    (isSemisimpleRepresentation_iff_isSemisimpleModule_asModule ρ).mpr inferInstance
  let C : Subrepresentation ρ := {
    toSubmodule := Coinvariants.ker ρ
    apply_mem_toSubmodule g v hv := by
      exact (Coinvariants.ker ρ).add_mem (Coinvariants.sub_mem_ker g v) hv |>
        fun h => by simpa only [sub_add_cancel] using h }
  obtain ⟨P,hP⟩ := exists_isCompl C
  have hp : P = ⊥ := by
    apply bot_unique
    intro v hv
    apply hf.le
    intro g
    apply sub_eq_zero.mp
    exact hP.disjoint.le_bot ⟨Coinvariants.sub_mem_ker g v,
      P.toSubmodule.sub_mem (P.apply_mem_toSubmodule g hv) hv⟩
  have ht := hP.sup_eq_top
  rw [hp, sup_bot_eq] at ht
  exact congrArg Subrepresentation.toSubmodule ht
end Representation
