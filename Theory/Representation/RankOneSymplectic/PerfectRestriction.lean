module

public import Theory.Representation.RankOneSymplectic.NormalFour
public import Theory.Representation.NormalConstituentDisplacement
public import Mathlib.GroupTheory.IsPerfect

/-!
# Perfect normal subgroups of rank-one generated groups

In a faithful irreducible finite-dimensional representation, a nontrivial
normal subgroup has no fixed vector. Perfectness excludes one-dimensional
constituents. Each rank-one generator must therefore preserve an irreducible
constituent of the normal subgroup: a distinct conjugate constituent would
require displacement at least its dimension. Ambient irreducibility forces
that constituent to be the whole module.

This supplies the perfect-layer restriction in the transvection-socle
reduction of Aschbacher--Smith G.4.9, printed pp.341--342. It uses no
primitivity assumption and is valid over the original coefficient field.
-/

public noncomputable section

open Subgroup Module

namespace Representation.RankOneSymplectic

variable {F G V : Type*} [Field F] [Group G] [AddCommGroup V] [Module F V]
  [FiniteDimensional F V]

private theorem perfect_rep_eq_one_of_finrank_one {K W : Type*} [Group K]
    [Group.IsPerfect K] [AddCommGroup W] [Module F W]
    (ρ : Representation F K W) (hd : finrank F W = 1) : ρ = 1 := by
  have hc (g h : K) : ρ g * ρ h = ρ h * ρ g := by
    obtain ⟨a,ha,_⟩ := LinearMap.existsUnique_eq_smul_id_of_finrank_eq_one hd (ρ g)
    obtain ⟨b,hb,_⟩ := LinearMap.existsUnique_eq_smul_id_of_finrank_eq_one hd (ρ h)
    rw [ha,hb]
    simp [smul_smul,mul_comm]
  let f := ρ.toHomUnits
  let : Group.IsPerfect f.range := Group.IsPerfect.range f
  let : IsMulCommutative f.range := ⟨⟨by
    rintro ⟨_,g,rfl⟩ ⟨_,h,rfl⟩
    apply Subtype.ext
    exact Units.ext (hc g h)⟩⟩
  let : Subsingleton f.range := inferInstance
  apply MonoidHom.ext
  intro g
  exact congrArg (fun x : f.range => (x.val : Module.End F W))
    (Subsingleton.elim (⟨f g,g,rfl⟩ : f.range) 1)

/-- A nontrivial perfect normal subgroup acts irreducibly when the ambient
faithful irreducible action is generated by rank-one displacements. -/
theorem normal_perfect_irreducible (ρ : Representation F G V) [ρ.IsIrreducible]
    (hf : Function.Injective ρ) (D : Set G) (hgen : closure D = ⊤)
    (hrank : ∀ d ∈ D, finrank F (LinearMap.range (ρ d - LinearMap.id)) = 1)
    (N : Subgroup G) [N.Normal] [Group.IsPerfect N] (hn : N ≠ ⊥) :
    Representation.IsIrreducible (ρ.comp N.subtype) := by
  let σ : Representation F N V := ρ.comp N.subtype
  have hfix : invariants σ = ⊥ := normal_invariants_eq_bot ρ hf N hn
  let : Nontrivial V := Subrepresentation.irreducible_module_nontrivial ρ
  obtain ⟨J,hJ⟩ := Subrepresentation.irreducible_subrepresentation_of_finite_dimensional σ
  have ha : IsAtom J := (Subrepresentation.irreducible_iff_isAtom J).mp hJ
  have hJbot : J.toSubmodule ≠ ⊥ := fun h =>
    ha.ne_bot (Subrepresentation.toSubmodule_injective h)
  have hJnt : J.toRepresentation ≠ 1 := by
    intro he
    apply hJbot
    apply bot_unique
    intro v hv
    have hi : v ∈ invariants σ := by
      intro n
      have hh := congrArg (fun τ : Representation F N J.toSubmodule => τ n ⟨v,hv⟩) he
      exact congrArg Subtype.val hh
    rwa [hfix] at hi
  have hdim : 1 < finrank F J.toSubmodule := by
    have hpos : 0 < finrank F J.toSubmodule :=
      Nat.pos_of_ne_zero (fun hz => hJbot (Submodule.finrank_eq_zero.mp hz))
    by_contra! hle
    exact hJnt (perfect_rep_eq_one_of_finrank_one J.toRepresentation (by omega))
  let P : Subgroup G := {
    carrier := {g | ∀ v, ρ g v ∈ J.toSubmodule ↔ v ∈ J.toSubmodule}
    one_mem' := by simp
    mul_mem' := by
      intro g h hg hh v
      simpa only [map_mul,Module.End.mul_apply] using (hg (ρ h v)).trans (hh v)
    inv_mem' := by
      intro g hg v
      have hv := hg (ρ g⁻¹ v)
      simpa only [←Module.End.mul_apply,←map_mul,mul_inv_cancel,map_one,
        Module.End.one_apply] using hv.symm }
  have hDP : D ⊆ P := by
    intro d hd
    have he := map_constituent_eq_self_of_displacement_lt ρ N d J hJ
      (by rw [hrank d hd]; exact hdim)
    intro v
    constructor
    · intro hv
      obtain ⟨w,hw,heq⟩ := (show ρ d v ∈ J.toSubmodule.map (ρ d) from he.symm ▸ hv)
      exact (ρ.apply_bijective d).injective heq ▸ hw
    · intro hv
      exact he ▸ Submodule.mem_map_of_mem hv
  have hle : closure D ≤ P := (Subgroup.closure_le P).mpr hDP
  have hP : P = ⊤ := top_unique (hgen ▸ hle)
  let J₀ : Subrepresentation ρ := {
    toSubmodule := J.toSubmodule
    apply_mem_toSubmodule g v hv := (show g ∈ P from hP ▸ mem_top g) v |>.mpr hv }
  have hJ₀ : J₀ ≠ ⊥ := fun h => hJbot (congrArg Subrepresentation.toSubmodule h)
  have ht : J₀ = ⊤ := (IsSimpleOrder.eq_bot_or_eq_top J₀).resolve_left hJ₀
  have hJsub : J.toSubmodule = ⊤ := congrArg Subrepresentation.toSubmodule ht
  have hJtop : J = ⊤ := Subrepresentation.toSubmodule_injective hJsub
  exact (isSimpleOrder_iff_isAtom_top).mpr (hJtop ▸ ha)

end Representation.RankOneSymplectic
