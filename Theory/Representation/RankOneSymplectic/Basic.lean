module
public import Theory.Representation.NormalInvariants
public import Theory.Representation.ConjugateRep
public import Theory.Representation.SubrepresentationLattice
public import Theory.LinearAlgebra.AlternatingFinrank
public import Mathlib.LinearAlgebra.FiniteDimensional.Lemmas

/-!
# Orthogonal constituents for rank-one generated symplectic actions

A rank-one isometry fixes every invariant totally isotropic subspace. Therefore
an irreducible constituent in a fixed-point-free action generated by rank-one
operators is nondegenerate. Two disjoint constituents must be orthogonal:
a nonzero invariant pairing is injective by Schur's lemma, whereas a rank-one
operator moving one constituent fixes the other.

These elementary arguments work over the original coefficient field. They
supply the normal-transvection-closure reduction in Aschbacher--Smith G.4.6--7,
printed pp.339--340, without strengthening irreducibility to the prime field.
-/

public noncomputable section
open Subgroup Module
namespace Representation.RankOneSymplectic
variable {F G V : Type*} [Field F] [Group G] [AddCommGroup V] [Module F V]

/-- A one-dimensional displacement meeting an invariant subspace nontrivially
is contained in that subspace. -/
theorem range_le_of_nonzero_displacement (f : Module.End F V)
    (hr : finrank F (LinearMap.range (f - LinearMap.id)) = 1)
    (U : Submodule F V) (hu : ∀ u ∈ U, f u ∈ U)
    {u : V} (huU : u ∈ U) (hne : f u ≠ u) :
    LinearMap.range (f - LinearMap.id) ≤ U := by
  rw [eq_span_singleton_of_mem_of_finrank_eq_one hr
    (show f u-u ∈ LinearMap.range (f-LinearMap.id) from ⟨u,rfl⟩)
    (sub_ne_zero.mpr hne)]
  exact Submodule.span_le.mpr (Set.singleton_subset_iff.mpr (U.sub_mem (hu u huU) huU))

/-- A rank-one isometry fixes every invariant totally isotropic subspace. -/
theorem fixes_isotropic (B : LinearMap.BilinForm F V) (hB : B.Nondegenerate)
    (f : Module.End F V) (hf : ∀ x y, B (f x) (f y) = B x y)
    (hr : finrank F (LinearMap.range (f-LinearMap.id)) = 1)
    (U : Submodule F V) (hu : ∀ u ∈ U, f u ∈ U)
    (hiso : ∀ u ∈ U, ∀ v ∈ U, B u v=0) : ∀ u ∈ U, f u=u := by
  intro u huU
  by_contra hne
  have hle := range_le_of_nonzero_displacement f hr U hu huU hne
  have hz : f u-u=0 := hB.2 _ (fun x => by
    have hzero : B (f x-x) (f u)=0 := hiso _ (hle ⟨x,rfl⟩) _ (hu u huU)
    have he : B x (f u)=B x u := by
      have he : B x u-B x (f u)=0 := by
        simpa only [map_sub,LinearMap.sub_apply,hf] using hzero
      exact (sub_eq_zero.mp he).symm
    simp only [map_sub,he,sub_self])
  exact hne (sub_eq_zero.mp hz)

/-- Pairing invariant subspaces gives the literal map into the dual action. -/
def pairing (ρ : Representation F G V) (B : LinearMap.BilinForm F V)
    (hp : ∀ g x y, B (ρ g x) (ρ g y)=B x y)
    (J K : Subrepresentation ρ) : IntertwiningMap J.toRepresentation K.toRepresentation.dual where
  toLinearMap := B.compl₁₂ J.toSubmodule.subtype K.toSubmodule.subtype
  isIntertwining' g := by
    ext v w
    change B (ρ g v.val) w.val = B v.val (ρ g⁻¹ w.val)
    simpa only [ρ.self_inv_apply] using hp g v.val (ρ g⁻¹ w.val)

/-- Evaluation of the invariant pairing on the original vectors. -/
@[simp] theorem pairing_apply (ρ : Representation F G V) (B : LinearMap.BilinForm F V)
    (hp : ∀ g x y, B (ρ g x) (ρ g y)=B x y)
    (J K : Subrepresentation ρ) (u : J.toSubmodule) (v : K.toSubmodule) :
    pairing ρ B hp J K u v=B u.val v.val := by rfl

/-- An irreducible invariant subspace is either isotropic or nondegenerate. -/
theorem isotropic_or_nondegenerate (ρ : Representation F G V)
    (B : LinearMap.BilinForm F V) (halt : B.IsAlt)
    (hp : ∀ g x y, B (ρ g x) (ρ g y)=B x y)
    (J : Subrepresentation ρ) [J.toRepresentation.IsIrreducible] :
    (∀ u ∈ J, ∀ v ∈ J, B u v=0) ∨ (B.restrict J.toSubmodule).Nondegenerate := by
  rcases IsIrreducible.injective_or_eq_zero (pairing ρ B hp J J) with hinj | hz
  · right
    have hl : (B.restrict J.toSubmodule).SeparatingLeft := by
      intro v hv
      apply hinj
      ext w
      change B v.val w.val = B 0 w.val
      exact (hv w).trans (by simp)
    exact ⟨hl,fun w hw => hl w fun v => halt.isRefl _ _ (hw v)⟩
  · left
    intro u hu v hv
    exact congrArg (fun f : IntertwiningMap J.toRepresentation J.toRepresentation.dual =>
      f ⟨u,hu⟩ ⟨v,hv⟩) hz

/-- Pointwise fixation extends from the marked generators to their closure. -/
theorem fixes_of_closure (ρ : Representation F G V) (D : Set G)
    (U : Submodule F V) (hfix : ∀ d ∈ D, ∀ u ∈ U, ρ d u=u)
    {g : G} (hg : g ∈ closure D) : ∀ u ∈ U, ρ g u=u := by
  induction hg using Subgroup.closure_induction with
  | mem g hg => exact hfix g hg
  | one => intro u _; simp
  | mul g h _ _ hg hh => intro u hu; simp only [map_mul,Module.End.mul_apply,hh u hu,hg u hu]
  | inv g _ hg =>
    intro u hu
    apply (ρ.apply_bijective g).injective
    simpa only [ρ.self_inv_apply] using (hg u hu).symm

/-- In a rank-one generated action with no fixed vectors, all irreducible
constituents are nondegenerate. -/
theorem constituent_nondegenerate (ρ : Representation F G V)
    (B : LinearMap.BilinForm F V) (halt : B.IsAlt) (hB : B.Nondegenerate)
    (hp : ∀ g x y, B (ρ g x) (ρ g y)=B x y)
    (D : Set G) (hgen : closure D=⊤)
    (hrank : ∀ d ∈ D, finrank F (LinearMap.range (ρ d-LinearMap.id))=1)
    (hfixed : invariants ρ=⊥)
    (J : Subrepresentation ρ) [J.toRepresentation.IsIrreducible] :
    (B.restrict J.toSubmodule).Nondegenerate := by
  rcases isotropic_or_nondegenerate ρ B halt hp J with hiso | hnondeg
  · exfalso
    have hJ : J=⊥ := by
      apply Subrepresentation.toSubmodule_injective
      apply bot_unique
      intro u hu
      have hf : u ∈ invariants ρ := by
        intro g
        apply fixes_of_closure ρ D J.toSubmodule _ (hgen ▸ mem_top g) u hu
        intro d hd
        exact fixes_isotropic B hB (ρ d) (hp d) (hrank d hd) J.toSubmodule
          (fun v hv => J.apply_mem_toSubmodule d hv) hiso
      rwa [hfixed] at hf
    exact ((Subrepresentation.irreducible_iff_isAtom J).mp inferInstance).ne_bot hJ
  · exact hnondeg

/-- Disjoint invariant constituents are orthogonal when rank-one generators
and absence of fixed vectors rule out a shared active simple constituent. -/
theorem disjoint_orthogonal (ρ : Representation F G V)
    (B : LinearMap.BilinForm F V) (hp : ∀ g x y, B (ρ g x) (ρ g y)=B x y)
    (D : Set G) (hgen : closure D=⊤)
    (hrank : ∀ d ∈ D, finrank F (LinearMap.range (ρ d-LinearMap.id))=1)
    (hfixed : invariants ρ=⊥)
    (J K : Subrepresentation ρ) [J.toRepresentation.IsIrreducible]
    (hdis : Disjoint J.toSubmodule K.toSubmodule) :
    ∀ u ∈ J, ∀ v ∈ K, B u v=0 := by
  rcases IsIrreducible.injective_or_eq_zero (pairing ρ B hp J K) with hinj | hz
  · exfalso
    have hfix (d : G) (hd : d∈D) (u : V) (hu : u∈J) : ρ d u=u := by
      by_contra hne
      have hle := range_le_of_nonzero_displacement (ρ d) (hrank d hd) J.toSubmodule
        (fun v hv => J.apply_mem_toSubmodule d hv) hu hne
      have hK (v : V) (hv : v∈K) : ρ d v=v := by
        apply sub_eq_zero.mp
        exact Submodule.disjoint_def.mp hdis _ (hle ⟨v,rfl⟩)
          (K.toSubmodule.sub_mem (K.apply_mem_toSubmodule d hv) hv)
      have he : pairing ρ B hp J K ⟨ρ d u,J.apply_mem_toSubmodule d hu⟩ =
          pairing ρ B hp J K ⟨u,hu⟩ := by
        ext v
        change B (ρ d u) v.val = B u v.val
        calc
          B (ρ d u) v.val = B (ρ d u) (ρ d v.val) :=
            congrArg (B (ρ d u)) (hK v.val v.property).symm
          _ = B u v.val := hp d u v.val
      exact hne (congrArg Subtype.val (hinj he))
    have hJ : J=⊥ := by
      apply Subrepresentation.toSubmodule_injective
      apply bot_unique
      intro u hu
      have hf : u∈invariants ρ := fun g =>
        fixes_of_closure ρ D J.toSubmodule hfix (hgen ▸ mem_top g) u hu
      rwa [hfixed] at hf
    exact ((Subrepresentation.irreducible_iff_isAtom J).mp inferInstance).ne_bot hJ
  · intro u hu v hv
    exact congrArg (fun f : IntertwiningMap J.toRepresentation K.toRepresentation.dual =>
      f ⟨u,hu⟩ ⟨v,hv⟩) hz

end Representation.RankOneSymplectic
