module
public import Theory.GroupTheory.CommutingPerfectRank
public import Theory.GroupTheory.GeneralizedFitting.ComponentCalculus
public import Theory.GroupTheory.QuasithinBasic
public import Theory.GroupTheory.NonsolvableTwoLocal
public import Theory.GroupTheory.CComponent.QuotientLifting
public import Theory.GroupTheory.PerfectSmallNormalizer
public import Theory.GroupTheory.PrimeRankInvolutionLift
public import Theory.Quasithin.Rank

/-!
# Perfect actors normalize ordinary components in a quasithin group

Four distinct conjugate components would place three commuting copies of
a nontrivial perfect group in the involution centralizer of the fourth.
Their odd rank is at least three, contradicting quasithinness. Thus the
component orbit has size at most three. A perfect actor has trivial
permutation image, and so does any subgroup generated by commutators
with that actor.

This weaker orbit bound supplies the precise normalization step in
Aschbacher--Smith4.4.10, p.621, without the model alternatives of A.3.8.
It does not assert the sharper index-two conclusion or assume SQTK.
-/

public section
open Subgroup
namespace Theory.GroupTheory
variable {G:Type*} [Group G] [Finite G]

/-- The elementary orbit bound sufficient for perfect-actor normalization. -/
theorem IsComponent.normalizer_index_le_three_of_quasithin
    (hqt:IsQuasithin G) {K:Subgroup G} (hK:IsComponent G K)
    (heven:2∣Nat.card K) : (normalizer (K:Set G)).index≤3 := by
  classical
  by_contra! hi
  rw [←ncard_conjugates_eq_index_normalizer] at hi
  obtain ⟨K0,K1,K2,K3,h0,h1,h2,h3,h01,h02,h03,h12,h13,h23⟩:=(Set.three_lt_ncard_iff (Set.finite_range _)).mp hi
  obtain ⟨g0,rfl⟩:=h0
  obtain ⟨g1,rfl⟩:=h1
  obtain ⟨g2,rfl⟩:=h2
  obtain ⟨g3,rfl⟩:=h3
  let :Fintype K:=Fintype.ofFinite K
  obtain ⟨t,ht⟩:=exists_prime_orderOf_dvd_card (G:=K) 2 (by simpa only [Nat.card_eq_fintype_card] using heven)
  let a:G:=MulAut.conj g0 (t:G)
  have hao:orderOf a=2:=by
    rw [show orderOf a=orderOf t from
      ((MulAut.conj g0).orderOf_eq (t:G)).trans (orderOf_injective K.subtype K.subtype_injective t)]
    exact ht
  let C:=centralizer ({a}:Set G)
  have hc (g:G) (hne:K.map (MulAut.conj g).toMonoidHom≠K.map (MulAut.conj g0).toMonoidHom) :
      K.map (MulAut.conj g).toMonoidHom≤C := by
    intro x hx
    have hh:=commutator_eq_bot_iff_le_centralizer.mp
      ((hK.map_conj g).commutator_eq_bot_of_ne (hK.map_conj g0) hne) hx
    exact mem_centralizer_singleton_iff.mpr (hh a (mem_map_of_mem _ t.property)).symm
  let f1:K→*C:=((MulAut.conj g1).toMonoidHom.comp K.subtype).codRestrict C
    (fun k=>hc g1 h01.symm (mem_map_of_mem _ k.property))
  let f2:K→*C:=((MulAut.conj g2).toMonoidHom.comp K.subtype).codRestrict C
    (fun k=>hc g2 h02.symm (mem_map_of_mem _ k.property))
  let f3:K→*C:=((MulAut.conj g3).toMonoidHom.comp K.subtype).codRestrict C
    (fun k=>hc g3 h03.symm (mem_map_of_mem _ k.property))
  have hcomm (g g':G) (hne:K.map (MulAut.conj g).toMonoidHom≠K.map (MulAut.conj g').toMonoidHom)
      (x y:K) : Commute (MulAut.conj g (x:G)) (MulAut.conj g' (y:G)) :=
    ((commutator_eq_bot_iff_le_centralizer.mp
      ((hK.map_conj g).commutator_eq_bot_of_ne (hK.map_conj g') hne))
      (mem_map_of_mem _ x.property) _ (mem_map_of_mem _ y.property)).symm
  let :IsQuasisimple K:=hK.2
  let :IsSimpleGroup (K⧸center K):=IsQuasisimple.simple
  let :Nontrivial K:=(QuotientGroup.mk'_surjective (center K)).nontrivial
  obtain ⟨p,hp,ho,hr⟩:=CommutingPerfectRank.exists_odd_prime_rank_three_of_commuting_perfect
    f1 f2 f3
    (fun x y he=>K.subtype_injective ((MulAut.conj g1).injective (congrArg Subtype.val he)))
    (fun x y he=>K.subtype_injective ((MulAut.conj g2).injective (congrArg Subtype.val he)))
    (fun x y he=>K.subtype_injective ((MulAut.conj g3).injective (congrArg Subtype.val he)))
    (fun x y=>Subtype.ext (hcomm g1 g2 h12 x y).eq)
    (fun x y=>Subtype.ext (hcomm g1 g3 h13 x y).eq)
    (fun x y=>Subtype.ext (hcomm g2 g3 h23 x y).eq)
  have hl:primeRank p C≤2:=(Theory.GroupTheory.isQuasithin_iff_twoLocal.mp hqt)
    C (Theory.GroupTheory.isTwoLocal_involution_centralizer hao) p hp ho
  omega

/-- A perfect actor and its full commutator subgroup both fix the component. -/
theorem IsComponent.perfect_commutator_normalizes_of_quasithin
    (hqt:IsQuasithin G) {K:Subgroup G} (hK:IsComponent G K)
    (heven:2∣Nat.card K) (F V:Subgroup G) [Group.IsPerfect F]
    (hV:V=⁅V,F⁆) : F≤normalizer (K:Set G) ∧ V≤normalizer (K:Set G) := by
  have hidx: (normalizer (K:Set G)).index≤4:=
    (hK.normalizer_index_le_three_of_quasithin hqt heven).trans (by decide)
  have hF:=perfect_le_normalCore_of_index_le_four F (normalizer (K:Set G)) hidx
  refine ⟨hF.trans (normalizer (K:Set G)).normalCore_le,?_⟩
  rw [hV]
  exact ((commutator_mono le_rfl hF).trans (commutator_le_right _ _)).trans
    (normalizer (K:Set G)).normalCore_le
end Theory.GroupTheory
