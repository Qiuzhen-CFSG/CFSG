module

public import CFSG.Quasithin.Chapter15.Section04.LocalIdentification.SourceData
public import Theory.GroupTheory.PResidual.NormalizedGenerators
public import Theory.GroupTheory.LocalNormalizerUniqueness

/-!
# The residual of each local amalgam

The two factors are two-perfect and normalized by the common two-subgroup
`T₀`. Their join is therefore exactly `O²(I)`. This also applies to the
alternate choice `L₁′ = X₂` in 15.4.23, without a new configuration.

Source: Aschbacher–Smith, the use of F.6.6 in 15.4.23, printed p.1165.
The proof is the universal-property argument for prime residuals, applied
inside the actual subgroup `I`, followed by its inclusion into the ambient group.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter15.Section04.Source

open Subgroup
variable {G : Type*} [Group G] {d : Geometry G} (h : LocalData d)

include h

/-- The two-residual, embedded in the common ambient group, for every pair. -/
theorem LocalData.residual_I (i j : Bool) :
    (pResidual 2 (d.I i j)).map (d.I i j).subtype = d.X i ⊔ d.Y j := by
  have hx := d.X_le_I i j
  have hy := d.Y_le_I i j
  have ht := d.T₀_le_I i j
  let A := (d.X i).subgroupOf (d.I i j)
  let B := (d.Y j).subgroupOf (d.I i j)
  let T := d.T₀.subgroupOf (d.I i j)
  have hA : IsPPerfect 2 A := (h.X_perfect i).of_surjective
    (subgroupOfEquivOfLe hx).symm.toMonoidHom (subgroupOfEquivOfLe hx).symm.surjective
  have hB : IsPPerfect 2 B := (h.Y_perfect j).of_surjective
    (subgroupOfEquivOfLe hy).symm.toMonoidHom (subgroupOfEquivOfLe hy).symm.surjective
  have hT₀ : IsPGroup 2 d.T₀ :=
    d.T.isPGroup'.of_injective (inclusion d.T₀_le_T) (inclusion_injective d.T₀_le_T)
  have hT : IsPGroup 2 T := hT₀.of_equiv (subgroupOfEquivOfLe ht).symm
  have hTA : T ≤ normalizer (A : Set (d.I i j)) := by
    apply le_normalizer_iff.mpr
    intro t ht' a ha
    exact (h.X_normalized i ht' (a : G)).mp ha
  have hTB : T ≤ normalizer (B : Set (d.I i j)) := by
    apply le_normalizer_iff.mpr
    intro t ht' b hb
    exact (h.Y_normalized j ht' (b : G)).mp hb
  have hgen : (A ⊔ B) ⊔ T = ⊤ := by
    dsimp [A, B, T]
    rw [← subgroupOf_sup hx hy, ← subgroupOf_sup (sup_le hx hy) ht,
      ← d.I_eq_join i j, subgroupOf_self]
  rw [pResidual_eq_sup_of_normalized_generators A B T hA hB hT hTA hTB hgen,
    Subgroup.map_sup, map_subgroupOf_eq_of_le hx, map_subgroupOf_eq_of_le hy]

/-- Explicitly, the alternate amalgam has residual generated by `X (!i)` and
`Y j`; this is a residual, never a two-core. -/
theorem LocalData.residual_alternate (i j : Bool) :
    (pResidual 2 (d.alternateI i j)).map (d.alternateI i j).subtype =
      d.X (!i) ⊔ d.Y j := h.residual_I (!i) j

/-- The two generator bounds yield the exact residual bound used in 15.4.23.
The layer is characteristic in the first factor, so its normalization
follows from the commutator bounds. -/
theorem LocalData.alternate_residual_commutator_le (i j : Bool)
    (hcross : ⁅d.Y j, d.X i⁆ ≤ (d.X i).pCoreIn 2) :
    ⁅(pResidual 2 (d.alternateI i j)).map (d.alternateI i j).subtype, d.X i⁆ ≤
      (d.X i).pCoreIn 2 := by
  have hn (B : Subgroup G) (hb : ⁅B, d.X i⁆ ≤ (d.X i).pCoreIn 2) :
      B ≤ normalizer ((d.X i).pCoreIn 2 : Set G) :=
    (le_normalizer_iff_commutator_le_right.mpr (hb.trans (pCoreIn_le 2 (d.X i)))).trans
      (normalizer_le_normalizer_characteristic_image (d.X i) (pCore 2 (d.X i)))
  rw [h.residual_alternate]
  exact (commutator_mono
    (sup_le (le_commutatorPreimage (hn _ (h.siblings_X i)) (h.siblings_X i))
      (le_commutatorPreimage (hn _ hcross) hcross)) le_rfl).trans
    (commutator_commutatorPreimage_le (normalizer ((d.X i).pCoreIn 2 : Set G))
      (d.X i) ((d.X i).pCoreIn 2) le_rfl)

/-- Under the cross-commutator bound, the alternate amalgam lies in the
normalizer of `O₂(Xᵢ)`, the rank-bounded local overgroup used below. -/
theorem LocalData.alternate_le_core_normalizer (i j : Bool)
    (hcross : ⁅d.Y j, d.X i⁆ ≤ (d.X i).pCoreIn 2) :
    d.alternateI i j ≤ normalizer ((d.X i).pCoreIn 2 : Set G) := by
  have hc := normalizer_le_normalizer_characteristic_image (d.X i) (pCore 2 (d.X i))
  have hn (B : Subgroup G) (hb : ⁅B, d.X i⁆ ≤ (d.X i).pCoreIn 2) :
      B ≤ normalizer ((d.X i).pCoreIn 2 : Set G) :=
    (le_normalizer_iff_commutator_le_right.mpr (hb.trans (pCoreIn_le 2 (d.X i)))).trans hc
  rw [Geometry.alternateI, d.I_eq_join]
  exact sup_le (sup_le (hn _ (h.siblings_X i)) (hn _ hcross))
    ((h.X_normalized i).trans hc)

end CFSG.Quasithin.Chapter15.Section04.Source
