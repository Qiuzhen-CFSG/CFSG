module

public import CFSG.Quasithin.Chapter15.Section04.Configuration.LocalSetup.SylowGeometry.CoreElimination.BlockEndgame.BorelPlacement.ControlledBorel.SylowCoordinates
public import CFSG.Quasithin.Chapter15.Section04.Configuration.LocalSetup.SylowGeometry.CoreElimination.BlockEndgame.FieldFourCentrality.RadicalLayer
public import Stellmacher.ElementaryAbelianMaxJWeakClosure
public import Stellmacher.ElementaryAbelianMaxJMap
public import Stellmacher.ElementaryAbelianMaxGlobal
public import Theory.GroupTheory.PGroup.CharacteristicPairReduction

/-!
# The contrary core and its elementary Thompson subgroup

Write R = O₂(XU) and Q = O₂(K₁R). These are intrinsic cores embedded in
G; J(R) is generated by elementary abelian subgroups of maximum order.
Its intrinsic characteristicness and nontriviality put N_G(J(R)) in C(G,R).

The ambient core O₂(H) lies in R. Since H has characteristic two, an
abelian R would equal O₂(H), forcing H into C(G,R) and contradicting the
contrary-overgroup hypothesis. Also neither exchanged block lies in M₁.
These deductions use no restriction on the field parameter.

The remaining local pushing-up argument must establish Q ≤ R and identify
J(R)Q/Q with the first block's Sylow image. Those statements are not part
of the definitions here.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), C.1.7–13,
printed pp.123–125; C.2.1–2 and the proof of C.2.7, pp.144–146;
proof of 15.4.20, p.1164.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter15.Section04.LocalSetup.CoreElimination.BlockEndgame.BorelPlacement.ControlledBorel
open Subgroup Stellmacher
variable {G : Type*} [Group G] [Finite G]
variable {κ : GroupClass} {d : Source.Geometry G} {i j : Bool}
variable (c : ContraryData κ d i j)

/-- The source core R = O₂(XU), embedded in G. -/
abbrev contraryCore : Subgroup G := (d.wholeX ⊔ c.U : Subgroup G).pCoreIn 2

/-- The elementary Thompson subgroup of the actual contrary core. -/
noncomputable def coreThompson : Subgroup G := elementaryAbelianMaxJ (contraryCore c)

/-- The local core Q = O₂(K₁R), formed inside the actual join. -/
def blockRadicalCore {c : ContraryData κ d i j} (b : ExchangedBlock c) : Subgroup G :=
  (b.first ⊔ contraryCore c : Subgroup G).pCoreIn 2

omit [Finite G] in
private theorem normalizes_core (P : Subgroup G) :
    P ≤ normalizer (P.pCoreIn 2 : Set G) :=
  P.le_normalizer.trans (normalizer_le_normalizer_characteristic_image P (pCore 2 P))

theorem contraryCore_le_U : contraryCore c ≤ c.U := by
  have hUH : c.U ≤ c.H := c.sylow_image ▸ map_subtype_le (c.sylow : Subgroup c.H)
  have hP := pCoreIn_le_sylow (d.wholeX ⊔ c.U)
    (restrictSylow c.sylow (sup_le c.X_le_H hUH) (c.sylow_image ▸ le_sup_right))
  rwa [restrictSylow_image, c.sylow_image] at hP

theorem contraryCore_le_H : contraryCore c ≤ c.H :=
  (contraryCore_le_U c).trans (c.sylow_image ▸ map_subtype_le (c.sylow : Subgroup c.H))

theorem overgroup_core_le_contraryCore : c.H.pCoreIn 2 ≤ contraryCore c := by
  have hUH : c.U ≤ c.H := c.sylow_image ▸ map_subtype_le (c.sylow : Subgroup c.H)
  have hQU : c.H.pCoreIn 2 ≤ c.U := c.sylow_image ▸ pCoreIn_le_sylow c.H c.sylow
  exact le_pCoreIn_of_normalizes (isPGroup_pCoreIn 2 c.H) (hQU.trans le_sup_right)
    ((sup_le c.X_le_H hUH).trans (normalizes_core c.H))

theorem contraryCore_ne_bot : contraryCore c ≠ ⊥ := by
  intro he
  have hV : d.V₁ i ≤ contraryCore c := c.four_le_contrary_core
  rw [he] at hV
  have hV := bot_unique hV
  have hcard := c.V₁_card i
  rw [hV] at hcard
  simp at hcard

theorem overgroup_core_centralizer :
    c.H ⊓ centralizer (c.H.pCoreIn 2 : Set G) ≤ c.H.pCoreIn 2 := by
  have hC : centralizer (pCore 2 c.H : Set c.H) ≤ pCore 2 c.H := by
    rw [← FieldFourCentrality.overgroup_characteristic_two c]
    exact ChapterB.QuasisimpleSections.centralizer_generalizedFitting_le
  intro x hx
  refine ⟨⟨x, hx.1⟩, hC ?_, rfl⟩
  apply mem_centralizer_iff.mpr
  intro q hq
  apply Subtype.ext
  exact mem_centralizer_iff.mp hx.2 q (mem_map_of_mem c.H.subtype hq)

theorem contraryCore_not_commutative : ¬ IsMulCommutative (contraryCore c) := by
  intro habelian
  let := habelian
  have hRQ : contraryCore c ≤ c.H.pCoreIn 2 := by
    apply le_trans (le_inf (contraryCore_le_H c) ?_) (overgroup_core_centralizer c)
    exact (commutator_eq_bot_iff_le_centralizer.mp
      (commutator_self_eq_bot_iff.mpr habelian)).trans
      (centralizer_le (overgroup_core_le_contraryCore c))
  have he : contraryCore c = c.H.pCoreIn 2 := le_antisymm hRQ (overgroup_core_le_contraryCore c)
  apply c.X_not_normal
  apply le_trans ?_ c.core_characteristic_control
  apply le_trans ?_ (normalizer_le_characteristicNormalizerClosure_self _ (contraryCore_ne_bot c))
  rw [he]
  exact normalizes_core c.H

theorem coreThompson_le : coreThompson c ≤ contraryCore c :=
  sSup_le fun _ hA => hA.1

theorem coreThompson_eq_intrinsic :
    coreThompson c = (elementaryAbelianMaxJ (⊤ : Subgroup (contraryCore c))).map
      (contraryCore c).subtype := by
  rw [← elementaryAbelianMaxJ_map_injective _ (contraryCore c).subtype_injective,
    ← MonoidHom.range_eq_map, range_subtype]
  rfl

theorem coreThompson_ne_bot : coreThompson c ≠ ⊥ := by
  obtain ⟨A, hA⟩ := elementaryAbelianMaxSubgroups_nonempty (contraryCore c)
  let : Nontrivial (contraryCore c) :=
    (Subgroup.nontrivial_iff_ne_bot _).mpr (contraryCore_ne_bot c)
  have hZne : omegaOneCenterAmbient (contraryCore c) ≠ ⊥ := by
    intro he
    exact omega_center_ne_bot (isPGroup_pCoreIn 2 _)
      ((Subgroup.map_eq_bot_iff_of_injective _ (contraryCore c).subtype_injective).mp he)
  have hcard := hA.2.2 (omegaOneCenterAmbient (contraryCore c))
    (fun x hx => ((mem_omegaOneCenterAmbient_iff _ _).mp hx).1)
    (omegaOneCenterAmbient_elementaryAbelian _)
  intro he
  have hA0 : A = ⊥ := bot_unique (he ▸ (show A ≤ coreThompson c from le_sSup hA))
  rw [hA0] at hcard
  have hgt := (Subgroup.one_lt_card_iff_ne_bot (omegaOneCenterAmbient (contraryCore c))).mpr hZne
  have hle : Nat.card (omegaOneCenterAmbient (contraryCore c)) ≤ 1 := by simpa using hcard
  exact (not_lt_of_ge hle) hgt

theorem coreThompson_normalizer_le :
    normalizer (coreThompson c : Set G) ≤ characteristicNormalizerClosure (contraryCore c) := by
  let J := elementaryAbelianMaxJ (⊤ : Subgroup (contraryCore c))
  let : J.Characteristic := elementaryAbelianMaxJ_top_characteristic
  have hJ : J ≠ ⊥ := by
    intro he
    have h := coreThompson_ne_bot c
    rw [coreThompson_eq_intrinsic] at h
    change J.map (contraryCore c).subtype ≠ ⊥ at h
    rw [he, Subgroup.map_bot] at h
    exact h rfl
  rw [coreThompson_eq_intrinsic]
  exact normalizer_le_characteristicNormalizerClosure (contraryCore c) J hJ

theorem first_not_le_M₁ (b : ExchangedBlock c) :
    ¬ b.first ≤ d.M₁ := by
  intro hM
  have hsecond : ExchangedBlock.second b ≤ d.M₁ :=
    (map_mono hM).trans (mem_normalizer_iff_map_conj_eq.mp
      (d.M₁.le_normalizer (c.T_le_M₁ (c.upper_lt.le b.exchanger_mem)))).le
  have hKM : c.K ≤ d.M₁ := b.product ▸ sup_le hM hsecond
  have hUM := c.upper_lt.le.trans c.T_le_M₁
  exact c.X_not_normal (c.product ▸ sup_le hKM hUM)
theorem first_normalizes_blockRadicalCore (b : ExchangedBlock c) :
    b.first ≤ normalizer (blockRadicalCore b : Set G) :=
  le_sup_left.trans (normalizes_core (b.first ⊔ contraryCore c))

end CFSG.Quasithin.Chapter15.Section04.LocalSetup.CoreElimination.BlockEndgame.BorelPlacement.ControlledBorel
