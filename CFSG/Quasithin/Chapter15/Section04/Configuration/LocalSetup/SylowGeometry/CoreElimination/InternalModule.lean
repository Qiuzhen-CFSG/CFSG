module

public import CFSG.Quasithin.Chapter15.Section04.Configuration.LocalSetup.TwoFactors.FFBranch.Transport
public import Theory.GroupTheory.GeneralizedFitting.ComponentLocalClosure.Extension
public import Theory.GroupTheory.GeneralizedFitting.SelfCentralizingPrimeCore
public import Theory.GroupTheory.PResidual.NormalSubgroup
public import Theory.GroupTheory.Commutator.ConjugateGeneration

/-!
# The internal module in the characteristic-two Sylow branch

In the contrary local group H=KU, characteristic two passes from the normal
subgroup K to H because H/K is a two-group. The centralizing supplement U
also gives ⟨Zᴴ⟩=⟨Zᴷ⟩ without requiring Z≤K. Self-centralization of F*(H)
and the equality C_H(Z)=U construct an elementary normal module V in
Ω₁(Z(O₂(H))), with C_H(V)=O₂(H) and two-reduced quotient action.

The source adapter retains Z=Ω₁(Z(T)), the actual Sylow image U and the
Baumann containment. These give C_H(Z)=U and identify the intrinsic J(U)
with the original J(T). A local factor with quotient of order three must
move Z; its equality L=[L,J(T)] then produces a maximum elementary abelian
subgroup whose image is an offender. The representation is faithful and its
value on every vector is the original ambient conjugation.

This directly proves the internal-module consequences of B.2.14 needed in
this branch; it uses no unproved earlier-result parameter. The subsequent
C.2.7 component hypotheses, block exclusions and Borel endgame are not
conclusions of this module.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), B.2.11–14,
printed pp.77–78, and the F*(K)=O₂(K) paragraph of 15.4.20, printed p.1164.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter15.Section04.LocalSetup.CoreElimination
open Subgroup Theory.GroupTheory Stellmacher
open Representation.BinaryOffender
open scoped IsMulCommutative
variable {H : Type*} [Group H]

/-- The subgroup generated by the actual K-conjugates of Z, whether or not Z lies in K. -/
def conjugateModule (K Z : Subgroup H) : Subgroup H :=
  ⨆ k : K, Z.map (MulAut.conj (k : H)).toMonoidHom

/-- A centralizing supplement does not enlarge the conjugate-generated subgroup.
There is no assumption that the seed lies in K. -/
theorem normalClosure_eq_conjugateModule (K U Z : Subgroup H) [K.Normal]
    (hgen : K ⊔ U = ⊤) (hUC : U ≤ centralizer (Z : Set H)) :
    normalClosure (Z : Set H) = conjugateModule K Z := by
  apply le_antisymm
  · apply (closure_le (K := conjugateModule K Z)).mpr
    intro x hx
    obtain ⟨z, hz, hconj⟩ := Group.mem_conjugatesOfSet_iff.mp hx
    obtain ⟨g, rfl⟩ := isConj_iff.mp hconj
    have hg : g ∈ K ⊔ U := hgen ▸ mem_top g
    obtain ⟨k, hk, u, hu, rfl⟩ := mem_sup_of_normal_left.mp hg
    have huz : u * z * u⁻¹ = z := by
      rw [← (mem_centralizer_iff.mp (hUC hu) z hz), mul_assoc, mul_inv_cancel, mul_one]
    apply (le_iSup (fun k : K => Z.map (MulAut.conj (k : H)).toMonoidHom) ⟨k, hk⟩)
    refine ⟨z, hz, ?_⟩
    change k * z * k⁻¹ = (k * u) * z * (k * u)⁻¹
    calc
      k * z * k⁻¹ = k * (u * z * u⁻¹) * k⁻¹ := by rw [huz]
      _ = (k * u) * z * (k * u)⁻¹ := by simp only [mul_inv_rev, mul_assoc]
  · apply iSup_le
    intro k
    rintro _ ⟨z, hz, rfl⟩
    exact (normalClosure_normal (s := (Z : Set H))).conj_mem z (le_normalClosure hz) k

variable [Finite H]

/-- The characteristic-two hypothesis on K passes to H=KU. -/
theorem generalizedFitting_eq_twoCore (K : Subgroup H) [K.Normal]
    (P : Sylow 2 H) (hgen : K ⊔ (P : Subgroup H) = ⊤)
    (hF : generalizedFitting K = pCore 2 K) :
    generalizedFitting H = pCore 2 H := by
  apply generalizedFitting_eq_pCore_of_selfCentralizing 2
  apply centralizer_pCore_le_of_normal_pGroup_quotient K
  · rw [← hF]
    exact ChapterB.QuasisimpleSections.centralizer_generalizedFitting_le
  · exact isPGroup_quotient_of_sup_eq_top K (P : Subgroup H) P.isPGroup' hgen

/-- Construct elementarity from the characteristic-two branch and the actual Sylow centralizer. -/
theorem module_elementary (K : Subgroup H) [K.Normal]
    (P : Sylow 2 H) (Z : Subgroup H) [IsElementaryAbelian 2 Z]
    (hgen : K ⊔ (P : Subgroup H) = ⊤)
    (hC : centralizer (Z : Set H) = (P : Subgroup H))
    (hF : generalizedFitting K = pCore 2 K) :
    IsElementaryAbelian 2 (TwoFactors.FFBranch.moduleClosure Z) :=
  TwoFactors.FFBranch.moduleClosure_elementary P Z hC (generalizedFitting_eq_twoCore K P hgen hF)

/-- All conjugates lie in the first omega subgroup of the center of O₂(H). -/
theorem module_le_omegaCenter (K : Subgroup H) [K.Normal]
    (P : Sylow 2 H) (Z : Subgroup H) [IsElementaryAbelian 2 Z]
    (hgen : K ⊔ (P : Subgroup H) = ⊤)
    (hC : centralizer (Z : Set H) = (P : Subgroup H))
    (hF : generalizedFitting K = pCore 2 K) :
    TwoFactors.FFBranch.moduleClosure Z ≤ omegaOneCenterAmbient (pCore 2 H) := by
  let := module_elementary K P Z hgen hC hF
  have hQ := TwoFactors.FFBranch.moduleClosure_le_twoCore P Z hC
    (generalizedFitting_eq_twoCore K P hgen hF)
  have hCQ : pCore 2 H ≤ centralizer (TwoFactors.FFBranch.moduleClosure Z : Set H) :=
    (TwoFactors.FFBranch.moduleClosure_centralizer P Z hC).symm.le
  intro z hz
  exact (mem_omegaOneCenterAmbient_iff _ _).mpr
    ⟨hQ hz, elemPow_eq_one_of_isElementaryAbelian z hz,
      fun q hq => (mem_centralizer_iff.mp (hCQ hq) z hz).symm⟩

/-- The source K-orbit is the elementary normal H-module with faithful,
two-reduced action quotient H/O₂(H). -/
theorem internal_module (K : Subgroup H) [K.Normal]
    (P : Sylow 2 H) (Z : Subgroup H) [IsElementaryAbelian 2 Z]
    (hgen : K ⊔ (P : Subgroup H) = ⊤)
    (hC : centralizer (Z : Set H) = (P : Subgroup H))
    (hF : generalizedFitting K = pCore 2 K) :
    generalizedFitting H = pCore 2 H ∧
      TwoFactors.FFBranch.moduleClosure Z = conjugateModule K Z ∧
      IsElementaryAbelian 2 (TwoFactors.FFBranch.moduleClosure Z) ∧
      TwoFactors.FFBranch.moduleClosure Z ≤ omegaOneCenterAmbient (pCore 2 H) ∧
      centralizer (TwoFactors.FFBranch.moduleClosure Z : Set H) = pCore 2 H ∧
      pCore 2 (H ⧸ centralizer (TwoFactors.FFBranch.moduleClosure Z : Set H)) = ⊥ := by
  exact ⟨generalizedFitting_eq_twoCore K P hgen hF,
    normalClosure_eq_conjugateModule K P Z hgen hC.symm.le,
    module_elementary K P Z hgen hC hF, module_le_omegaCenter K P Z hgen hC hF,
    TwoFactors.FFBranch.moduleClosure_centralizer P Z hC, TwoFactors.FFBranch.moduleClosure_reduced P Z hC⟩

/-- The actual action of H/O₂(H) on the conjugate-generated binary module.
Elementarity is proved from F*(K)=O₂(K), not supplied as an additional input. -/
noncomputable def quotientAction (K : Subgroup H) [K.Normal]
    (P : Sylow 2 H) (Z : Subgroup H) [IsElementaryAbelian 2 Z]
    (hgen : K ⊔ (P : Subgroup H) = ⊤)
    (hC : centralizer (Z : Set H) = (P : Subgroup H))
    (hF : generalizedFitting K = pCore 2 K) :=
  let := module_elementary K P Z hgen hC hF
  TwoFactors.FFBranch.quotientAction P Z hC

/-- Its action on vectors is the original conjugation in H. -/
theorem quotientAction_apply (K : Subgroup H) [K.Normal]
    (P : Sylow 2 H) (Z : Subgroup H) [IsElementaryAbelian 2 Z]
    (hgen : K ⊔ (P : Subgroup H) = ⊤)
    (hC : centralizer (Z : Set H) = (P : Subgroup H))
    (hF : generalizedFitting K = pCore 2 K) (h : H) (v : Additive (TwoFactors.FFBranch.moduleClosure Z)) :
    (((quotientAction K P Z hgen hC hF) (TwoFactors.FFBranch.coreProjection h) v).toMul : H) =
      h * (v.toMul : H) * h⁻¹ := by
  let := module_elementary K P Z hgen hC hF
  exact TwoFactors.FFBranch.quotientAction_apply P Z hC h v

/-- The quotient representation is faithful. -/
theorem quotientAction_injective (K : Subgroup H) [K.Normal]
    (P : Sylow 2 H) (Z : Subgroup H) [IsElementaryAbelian 2 Z]
    (hgen : K ⊔ (P : Subgroup H) = ⊤)
    (hC : centralizer (Z : Set H) = (P : Subgroup H))
    (hF : generalizedFitting K = pCore 2 K) :
    Function.Injective (quotientAction K P Z hgen hC hF) := by
  let := module_elementary K P Z hgen hC hF
  exact TwoFactors.FFBranch.quotientAction_injective P Z hC

/-- A factor generated by its Thompson commutators supplies an actual offender. -/
theorem exists_offender (K : Subgroup H) [K.Normal]
    (P : Sylow 2 H) (Z : Subgroup H) [IsElementaryAbelian 2 Z]
    (hgen : K ⊔ (P : Subgroup H) = ⊤)
    (hC : centralizer (Z : Set H) = (P : Subgroup H))
    (hF : generalizedFitting K = pCore 2 K) (L : Subgroup H)
    (hL : L = ⁅L, elementaryAbelianMaxJ (P : Subgroup H)⁆)
    (hZL : ⁅Z, L⁆ ≠ ⊥) :
    letI := module_elementary K P Z hgen hC hF
    ∃ A ∈ elementaryAbelianMaxSubgroups (P : Subgroup H),
      ¬ A ≤ pCore 2 H ∧ IsOffender (V := Additive (TwoFactors.FFBranch.moduleClosure Z)) (quotientAction K P Z hgen hC hF)
        (A.map TwoFactors.FFBranch.coreProjection) := by
  let := module_elementary K P Z hgen hC hF
  exact TwoFactors.FFBranch.exists_maxElementary_offender P Z hC L
    (generalizedFitting_eq_twoCore K P hgen hF) hL hZL

/-- Failure of factorization follows from the constructed Thompson offender. -/
theorem quotientAction_isFFModule (K : Subgroup H) [K.Normal]
    (P : Sylow 2 H) (Z : Subgroup H) [IsElementaryAbelian 2 Z]
    (hgen : K ⊔ (P : Subgroup H) = ⊤)
    (hC : centralizer (Z : Set H) = (P : Subgroup H))
    (hF : generalizedFitting K = pCore 2 K) (L : Subgroup H)
    (hL : L = ⁅L, elementaryAbelianMaxJ (P : Subgroup H)⁆)
    (hZL : ⁅Z, L⁆ ≠ ⊥) :
    letI := module_elementary K P Z hgen hC hF
    IsFFModule (V := Additive (TwoFactors.FFBranch.moduleClosure Z)) (quotientAction K P Z hgen hC hF) := by
  let := module_elementary K P Z hgen hC hF
  obtain ⟨A, _, _, hA⟩ := exists_offender K P Z hgen hC hF L hL hZL
  exact ⟨A.map TwoFactors.FFBranch.coreProjection, hA⟩

/-- Transport characteristic two across an actual multiplicative equivalence. -/
theorem generalizedFitting_eq_twoCore_of_equiv {D : Type*} [Group D] [Finite D]
    (e : D ≃* H) (hF : generalizedFitting H = pCore 2 H) :
    generalizedFitting D = pCore 2 D := by
  apply generalizedFitting_eq_pCore_of_selfCentralizing 2
  have he := pCore_map_iso 2 e
  have hc : centralizer (pCore 2 H : Set H) ≤ pCore 2 H := by
    rw [← hF]
    exact ChapterB.QuasisimpleSections.centralizer_generalizedFitting_le
  intro x hx
  have hxe : e x ∈ pCore 2 H := by
    apply hc
    apply mem_centralizer_iff.mpr
    intro y hy
    rw [← he] at hy
    obtain ⟨z, hz, rfl⟩ := hy
    exact (map_mul e z x).symm.trans
      ((congrArg e (mem_centralizer_iff.mp hx z hz)).trans (map_mul e x z))
  rw [← he] at hxe
  obtain ⟨y, hy, hxy⟩ := hxe
  exact e.injective hxy ▸ hy


variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
/-- The actual central omega subgroup lies in the Baumann subgroup. -/
theorem omegaCenter_le_baumann (T : Subgroup G) :
    omegaOneCenterAmbient T ≤ ChapterB.baumann T := by
  intro z hz
  obtain ⟨hzT, _, hzc⟩ := (mem_omegaOneCenterAmbient_iff T z).mp hz
  refine ⟨hzT, mem_centralizer_iff.mpr ?_⟩
  intro e he
  have hJT : elementaryAbelianMaxJ T ≤ T := sSup_le fun _ hA => hA.1
  exact hzc e (hJT ((mem_omegaOneCenterAmbient_iff _ _).mp he).1)

/-- The ambient source centralizer, Baumann containment and actual Sylow
image construct all seed and Thompson inputs inside H. -/
theorem source_seed_inputs (T : Sylow 2 G) (H U Z L : Subgroup G)
    (P : Sylow 2 H) (hP : (P : Subgroup H).map H.subtype = U)
    (hUT : U ≤ (T : Subgroup G)) (hB : ChapterB.baumann (T : Subgroup G) ≤ U)
    (hZ : Z = omegaOneCenterAmbient (T : Subgroup G))
    (hCZ : centralizer (Z : Set G) = (T : Subgroup G))
    (hLH : L ≤ H) (hL : L = ⁅L, elementaryAbelianMaxJ (T : Subgroup G)⁆)
    (hZL : ⁅Z, L⁆ ≠ ⊥) :
    Z ≤ H ∧ IsElementaryAbelian 2 (Z.subgroupOf H) ∧
      centralizer (Z.subgroupOf H : Set H) = (P : Subgroup H) ∧
      Z.subgroupOf H ≤ omegaOneCenterAmbient (P : Subgroup H) ∧
      L.subgroupOf H = ⁅L.subgroupOf H, elementaryAbelianMaxJ (P : Subgroup H)⁆ ∧
      ⁅Z.subgroupOf H, L.subgroupOf H⁆ ≠ ⊥ := by
  have hZU : Z ≤ U := hZ ▸ (omegaCenter_le_baumann _).trans hB
  have hUH : U ≤ H := hP ▸ map_subtype_le (P : Subgroup H)
  have hZH := hZU.trans hUH
  let : IsElementaryAbelian 2 Z := hZ ▸ omegaOneCenterAmbient_elementaryAbelian _
  have hC := TwoFactors.FFBranch.centralizer_seed_subgroupOf H (T : Subgroup G) Z P
    T.isPGroup' (hP ▸ hUT) hZH hCZ
  refine ⟨hZH, IsElementaryAbelian.subgroupOf hZH, hC, ?_,
    TwoFactors.FFBranch.factor_commutator_subgroupOf H L _ _ hLH
      (TwoFactors.FFBranch.thompson_sylow_image_of_baumann H T P (hP ▸ hB)) hL,
    TwoFactors.FFBranch.seed_factor_commutator_ne_bot_subgroupOf H Z L hZH hLH hZL⟩
  intro z hz
  apply (mem_omegaOneCenterAmbient_iff _ _).mpr
  have hzP : z ∈ (P : Subgroup H) := by
    have hzU : (z : G) ∈ U := hZU hz
    rw [← hP] at hzU
    obtain ⟨p, hp, hpz⟩ := hzU
    exact H.subtype_injective hpz ▸ hp
  exact ⟨hzP, Subtype.ext (elemPow_eq_one_of_isElementaryAbelian (z : G) hz),
    fun p hp => (mem_centralizer_iff.mp ((hC.symm.le) hp) z hz).symm⟩

/-- Transport the normal K and its Sylow supplement to H, retaining intrinsic cores. -/
theorem source_core_inputs {H K U : Subgroup G} (hKH : K ≤ H)
    (hHK : H ≤ normalizer (K : Set G))
    (P : Sylow 2 H) (hP : (P : Subgroup H).map H.subtype = U)
    (hgen : K ⊔ U = H) (hF : generalizedFitting K = pCore 2 K) :
    (K.subgroupOf H).Normal ∧ K.subgroupOf H ⊔ (P : Subgroup H) = ⊤ ∧
      generalizedFitting (K.subgroupOf H) = pCore 2 (K.subgroupOf H) := by
  refine ⟨normal_subgroupOf_of_le_normalizer hHK, ?_,
    generalizedFitting_eq_twoCore_of_equiv (subgroupOfEquivOfLe hKH) hF⟩
  apply map_injective H.subtype_injective
  rw [Subgroup.map_sup, map_subgroupOf_eq_of_le hKH, hP, hgen,
    ← MonoidHom.range_eq_map, range_subtype]


omit [Finite G] in
/-- Both realizations of the K-orbit have the same ambient image. -/
theorem conjugateModule_subgroupOf_map {H K Z : Subgroup G}
    (hKH : K ≤ H) (hZH : Z ≤ H) :
    (conjugateModule (K.subgroupOf H) (Z.subgroupOf H)).map H.subtype =
      conjugateModule K Z := by
  rw [conjugateModule, Subgroup.map_iSup]
  apply le_antisymm
  · apply iSup_le
    intro k
    rintro _ ⟨_, ⟨z, hz, rfl⟩, rfl⟩
    exact (le_iSup (fun k : K => Z.map (MulAut.conj (k : G)).toMonoidHom)
      ⟨k, k.property⟩) ⟨z, hz, rfl⟩
  · apply iSup_le
    intro k
    rintro _ ⟨z, hz, rfl⟩
    let kH : K.subgroupOf H := ⟨⟨k, hKH k.property⟩, k.property⟩
    apply (le_iSup (fun k : K.subgroupOf H =>
      ((Z.subgroupOf H).map (MulAut.conj (k : H)).toMonoidHom).map H.subtype) kH)
    exact ⟨(MulAut.conj (kH : H)) ⟨z, hZH hz⟩, ⟨⟨z, hZH hz⟩, hz, rfl⟩, rfl⟩

omit [Finite G] in
/-- A factor with three-element two-core quotient must move the seed whose
centralizer is a two-group. This derives the nontrivial Thompson input. -/
theorem seed_moved_of_factor_quotient (T : Sylow 2 G) (Z L : Subgroup G)
    (hCZ : centralizer (Z : Set G) = (T : Subgroup G))
    (hLq : Nat.card (L ⧸ pCore 2 L) = 3) : ⁅Z, L⁆ ≠ ⊥ := by
  intro hc
  rw [commutator_comm] at hc
  have hLT : L ≤ (T : Subgroup G) := hCZ ▸ commutator_eq_bot_iff_le_centralizer.mp hc
  have hp := ((T.isPGroup').to_le hLT).to_quotient (pCore 2 L)
  have hn := hp.card_eq_or_dvd
  rw [hLq] at hn
  norm_num at hn

/-- The source geometry constructs the actual faithful FF-module, its
centralizer and its realization as the K-conjugates of Ω₁(Z(T)). -/
theorem source_internal_module (T : Sylow 2 G) (H K U Z L : Subgroup G)
    (P : Sylow 2 H) (hP : (P : Subgroup H).map H.subtype = U)
    (hUT : U ≤ (T : Subgroup G)) (hB : ChapterB.baumann (T : Subgroup G) ≤ U)
    (hZ : Z = omegaOneCenterAmbient (T : Subgroup G))
    (hCZ : centralizer (Z : Set G) = (T : Subgroup G))
    (hKH : K ≤ H) (hHK : H ≤ normalizer (K : Set G))
    (hgen : K ⊔ U = H) (hF : generalizedFitting K = pCore 2 K)
    (hLH : L ≤ H) (hL : L = ⁅L, elementaryAbelianMaxJ (T : Subgroup G)⁆)
    (hLq : Nat.card (L ⧸ pCore 2 L) = 3) :
    let V := TwoFactors.FFBranch.moduleClosure (Z.subgroupOf H)
    generalizedFitting H = pCore 2 H ∧
      V.map H.subtype = conjugateModule K Z ∧
      V ≤ omegaOneCenterAmbient (pCore 2 H) ∧
      centralizer (V : Set H) = pCore 2 H ∧
      pCore 2 (H ⧸ centralizer (V : Set H)) = ⊥ ∧
      ∃ hV : IsElementaryAbelian 2 V,
        letI := hV
        ∃ ρ : Representation (ZMod 2) (TwoFactors.FFBranch.coreQuotient H) (Additive V),
          Function.Injective ρ ∧
          (∀ (h : H) (v : Additive V),
            (((ρ (TwoFactors.FFBranch.coreProjection h) v).toMul : H) : G) =
              (h : G) * ((v.toMul : H) : G) * (h : G)⁻¹) ∧
          ∃ A ∈ elementaryAbelianMaxSubgroups (P : Subgroup H),
            ¬ A ≤ pCore 2 H ∧ IsOffender ρ (A.map TwoFactors.FFBranch.coreProjection) := by
  have hZL := seed_moved_of_factor_quotient T Z L hCZ hLq
  obtain ⟨hZH, hZe, hC, _, hLi, hZLi⟩ :=
    source_seed_inputs T H U Z L P hP hUT hB hZ hCZ hLH hL hZL
  let := hZe
  obtain ⟨hKn, hgeni, hFi⟩ := source_core_inputs hKH hHK P hP hgen hF
  let := hKn
  obtain ⟨hFH, hVi, hVe, hVQ, hVC, hVr⟩ := internal_module (K.subgroupOf H) P
    (Z.subgroupOf H) hgeni hC hFi
  have hVm := (congrArg (fun A : Subgroup H => A.map H.subtype) hVi).trans
    (conjugateModule_subgroupOf_map hKH hZH)
  refine ⟨hFH, hVm, hVQ, hVC, hVr, hVe, ?_⟩
  let := hVe
  refine ⟨quotientAction (K.subgroupOf H) P (Z.subgroupOf H) hgeni hC hFi,
    quotientAction_injective _ _ _ _ _ _, ?_,
    exists_offender _ _ _ _ _ _ (L.subgroupOf H) hLi hZLi⟩
  intro h v
  exact congrArg Subtype.val (quotientAction_apply _ _ _ _ _ _ h v)

end CFSG.Quasithin.Chapter15.Section04.LocalSetup.CoreElimination
