module

public import CFSG.Quasithin.Chapter15.Section04.Configuration.LocalSetup.SylowGeometry.CoreElimination.BlockSieve.BinaryBranch.SourceClassification.Socle
public import Theory.GroupTheory.GeneralizedFitting.SimpleSocleStructure
public import Theory.GroupTheory.CComponent.QuasisimpleFactors

/-!
# The actual generalized Fitting subgroup of the binary source offenders

The source offender image contains the literal inner PSL subgroup. This
simple normal subgroup has trivial centralizer in the offender image, so the
solvable radical vanishes and every component lies in that same subgroup.
Consequently it is the generalized Fitting subgroup. Transport through the
original quotient embedding identifies the source generalized Fitting group
with PSLₙ(2), for n = 4 or 5, and proves its quasisimplicity.

These are structure facts about the actual offender actor used in the B.5.6
comparison for Aschbacher--Smith 15.4.20, printed p.1164. They do not assert
that all automorphisms are generated by the source offenders.
-/

@[expose] public section

open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter15.Section04.LocalSetup.CoreElimination.BlockSieve.BinaryBranch.SourceClassification

private theorem fitting_eq_of_simple_self_centralizing
    {A : Type*} [Group A] [Finite A] (L : Subgroup A) [L.Normal]
    [IsSimpleGroup L] [Group.IsPerfect L]
    (hc : centralizer (L : Set A) = ⊥) : generalizedFitting A = L := by
  have hz : center L = ⊥ := Atlas.GroupTheory.center_eq_bot_of_simple_nonabelian L
    (Group.IsPerfect.not_isMulCommutative L)
  let : IsQuasisimple L := ⟨
    ((QuotientGroup.quotientMulEquivOfEq hz).trans QuotientGroup.quotientBot).isSimpleGroup⟩
  have hR : solvableRadical A = ⊥ := SimpleSocle.radical_eq_bot L hc
  have hF : fittingSubgroup A = ⊥ := le_bot_iff.mp
    ((le_solvableRadical (fittingSubgroup A) inferInstance inferInstance).trans hR.le)
  apply le_antisymm
  · unfold generalizedFitting
    rw [hF, bot_sup_eq]
    apply sSup_le
    intro M hM
    rcases hM.normal_dichotomy L with h | h
    · exact h
    · have hMb : M = ⊥ := le_bot_iff.mp
        ((commutator_eq_bot_iff_le_centralizer.mp h).trans hc.le)
      let := hM.2
      let : IsSimpleGroup (M ⧸ center M) := IsQuasisimple.simple
      let : Nontrivial M := (QuotientGroup.mk'_surjective (center M)).nontrivial
      exact ((nontrivial_iff_ne_bot M).mp inferInstance hMb).elim
  · exact component_le_generalizedFitting A L
      ⟨(inferInstance : L.Normal).isSubnormal, inferInstance⟩

variable {G : Type*} [Group G] [Finite G]
  {d : Source.Geometry G} {i j : Bool} {H U K : Subgroup G}

/-- The generalized Fitting subgroup of the actual offender image is precisely
its literal inner PSL subgroup, restricted to that image. -/
theorem sourceImage_fitting_eq_inner (h : Input d i j H U K) {n : ℕ}
    (hn : n = 4 ∨ n = 5)
    (e : (H ⧸ pCore 2 H) ≃* MulAut (Matrix.ProjectiveSpecialLinearGroup (Fin n) (ZMod 2))) :
    generalizedFitting ((sourceGroup h).map e.toMonoidHom) =
      (MulAut.innerSubgroup (Matrix.ProjectiveSpecialLinearGroup (Fin n) (ZMod 2))).subgroupOf
        ((sourceGroup h).map e.toMonoidHom) := by
  let P := Matrix.ProjectiveSpecialLinearGroup (Fin n) (ZMod 2)
  let N := (sourceGroup h).map e.toMonoidHom
  let S := MulAut.innerSubgroup P
  have hn3 : 3 ≤ n := by rcases hn with rfl | rfl <;> decide
  let : IsSimpleGroup P := Atlas.psl_simple_high_rank n hn3
  let : Group.IsPerfect P := Atlas.psl_perfect n hn3
  have hz : center P = ⊥ := Atlas.GroupTheory.center_eq_bot_of_simple_nonabelian P
    (Group.IsPerfect.not_isMulCommutative P)
  let q : P ≃* S := MonoidHom.ofInjective (MulAut.conj_injective_of_center_eq_bot hz)
  have hSN : S ≤ N := inner_le_sourceImage h hn e
  let r : S.subgroupOf N ≃* P := (subgroupOfEquivOfLe hSN).trans q.symm
  let : IsSimpleGroup (S.subgroupOf N) := r.isSimpleGroup
  let : Group.IsPerfect (S.subgroupOf N) :=
    Group.IsPerfect.ofSurjective (f := r.symm.toMonoidHom) r.symm.surjective
  apply fitting_eq_of_simple_self_centralizing (S.subgroupOf N)
  apply le_bot_iff.mp
  intro x hx
  have hxS : (x : MulAut P) ∈ centralizer (S : Set (MulAut P)) := by
    rw [mem_centralizer_iff]
    intro y hy
    exact congrArg Subtype.val (mem_centralizer_iff.mp hx ⟨y, hSN hy⟩ hy)
  rw [MulAut.centralizer_innerSubgroup_eq_bot hz, mem_bot] at hxS
  exact mem_bot.mpr (Subtype.ext hxS)

/-- The original source embedding takes F* onto the same literal inner PSL
subgroup used by the ambient binary model. -/
theorem sourceFitting_map_eq_inner (h : Input d i j H U K) {n : ℕ}
    (hn : n = 4 ∨ n = 5)
    (e : (H ⧸ pCore 2 H) ≃* MulAut (Matrix.ProjectiveSpecialLinearGroup (Fin n) (ZMod 2))) :
    (generalizedFitting (sourceGroup h)).map (sourceEmbedding h e) =
      MulAut.innerSubgroup (Matrix.ProjectiveSpecialLinearGroup (Fin n) (ZMod 2)) := by
  let N := (sourceGroup h).map e.toMonoidHom
  let q : sourceGroup h ≃* N := e.subgroupMap (sourceGroup h)
  calc
    (generalizedFitting (sourceGroup h)).map (sourceEmbedding h e) =
        ((generalizedFitting (sourceGroup h)).map q.toMonoidHom).map N.subtype := by
          rw [map_map]
          rfl
    _ = (generalizedFitting N).map N.subtype := by rw [map_generalizedFitting_equiv q]
    _ = MulAut.innerSubgroup (Matrix.ProjectiveSpecialLinearGroup (Fin n) (ZMod 2)) := by
      rw [sourceImage_fitting_eq_inner h hn e,
        map_subgroupOf_eq_of_le (inner_le_sourceImage h hn e)]

/-- The actual source generalized Fitting group is isomorphic to the simple
binary projective group through its original embedding and conjugation. -/
noncomputable def sourceFittingEquivPSL (h : Input d i j H U K) {n : ℕ}
    (hn : n = 4 ∨ n = 5)
    (e : (H ⧸ pCore 2 H) ≃* MulAut (Matrix.ProjectiveSpecialLinearGroup (Fin n) (ZMod 2))) :
    generalizedFitting (sourceGroup h) ≃*
      Matrix.ProjectiveSpecialLinearGroup (Fin n) (ZMod 2) := by
  let P := Matrix.ProjectiveSpecialLinearGroup (Fin n) (ZMod 2)
  have hn3 : 3 ≤ n := by rcases hn with rfl | rfl <;> decide
  let : IsSimpleGroup P := Atlas.psl_simple_high_rank n hn3
  let : Group.IsPerfect P := Atlas.psl_perfect n hn3
  have hz : center P = ⊥ := Atlas.GroupTheory.center_eq_bot_of_simple_nonabelian P
    (Group.IsPerfect.not_isMulCommutative P)
  let q : P ≃* MulAut.innerSubgroup P :=
    MonoidHom.ofInjective (MulAut.conj_injective_of_center_eq_bot hz)
  exact ((generalizedFitting (sourceGroup h)).equivMapOfInjective
    (sourceEmbedding h e) (sourceEmbedding_injective h e)).trans
      ((MulEquiv.subgroupCongr (sourceFitting_map_eq_inner h hn e)).trans q.symm)

/-- The quasisimple branch of the adequate source classifier applies to the
actual offender group in both binary dimensions. -/
theorem sourceFitting_isQuasisimple (h : Input d i j H U K) {n : ℕ}
    (hn : n = 4 ∨ n = 5)
    (e : (H ⧸ pCore 2 H) ≃* MulAut (Matrix.ProjectiveSpecialLinearGroup (Fin n) (ZMod 2))) :
    IsQuasisimple (generalizedFitting (sourceGroup h)) := by
  let P := Matrix.ProjectiveSpecialLinearGroup (Fin n) (ZMod 2)
  have hn3 : 3 ≤ n := by rcases hn with rfl | rfl <;> decide
  let : IsSimpleGroup P := Atlas.psl_simple_high_rank n hn3
  let : Group.IsPerfect P := Atlas.psl_perfect n hn3
  have hz : center P = ⊥ := Atlas.GroupTheory.center_eq_bot_of_simple_nonabelian P
    (Group.IsPerfect.not_isMulCommutative P)
  let : IsQuasisimple P := ⟨
    ((QuotientGroup.quotientMulEquivOfEq hz).trans QuotientGroup.quotientBot).isSimpleGroup⟩
  exact IsQuasisimple.of_mulEquiv (sourceFittingEquivPSL h hn e).symm

end CFSG.Quasithin.Chapter15.Section04.LocalSetup.CoreElimination.BlockSieve.BinaryBranch.SourceClassification
