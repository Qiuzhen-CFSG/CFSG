module

public import CFSG.Quasithin.Chapter15.Section04.Configuration.LocalSetup.SylowGeometry.BorelFour
public import CFSG.Quasithin.ChapterC.Section01.BlockTypes.Basic
public import Theory.GroupTheory.PResidual.PerfectCover

/-!
# Concrete Borel lifts and the two block-module actions

For the surviving rank-one blocks in the characteristic-two paragraph of
15.4.20, the linear-representation model is equivalent to the literal matrix
conjugation model used by `BorelFour`. The finite-field witness in the block
definition has characteristic two and order at least four.

Take the two-residual of the inverse image of the matrix Borel. This subgroup
is two-perfect and still maps onto the entire Borel. The full inverse image
need not itself be two-perfect. For two blocks the same construction covers
the product Borel, and the product of the actual module quotient maps
intertwines the two independent matrix actions.

A nontrivial subgroup generated by commutators cannot disappear in the
central fixed layers of the blocks. Consequently a four-subgroup in these
module domains, invariant under the constructed lift and generated by
commutators, forces the field order to be four. These are conditional module
calculations: placing the source V₁ in the domain, transporting its
commutators, and putting the lift in M₁ remain source-geometry obligations.
In particular no isomorphism of the internal block product with a direct
product is asserted here.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), definitions
C.1.7 and C.1.12 (pp.123–124), and the proof of 15.4.20 (p.1164).
-/

@[expose] public section

open Subgroup BenderSuzuki.Converse Matrix.SpecialLinearGroup
open scoped MatrixGroups
open CFSG.Quasithin.ChapterC
namespace CFSG.Quasithin.Chapter15.Section04.LocalSetup.CoreElimination.BlockEndgame
variable {L F : Type*} [Group L] [Field F]

/-- The two natural-action APIs describe exactly the same action, with both isomorphisms retained. -/
theorem natural_model_iff :
    IsLinearBlockModel L (Representation.specialLinearNatural (k := F) 2) ↔
      Nonempty (BlockModuleModel L (Matrix.SL2.naturalAction F)) := by
  constructor
  · rintro ⟨ρ, hmodel, hρ⟩
    have he : ρ = Matrix.SL2.naturalAction F := by
      ext g v : 2
      exact hρ g v
    rwa [he] at hmodel
  · intro h
    exact ⟨Matrix.SL2.naturalAction F, h, fun _ _ => rfl⟩

/-- The intrinsic two-residual of the inverse image, embedded in the original group. -/
def residualPreimage {A : Type*} [Group A] (f : L →* A) (B : Subgroup A) :
    Subgroup L := (pResidual 2 (B.comap f)).map (B.comap f).subtype

/-- The residual lift stays in the inverse image. -/
theorem residualPreimage_le {A : Type*} [Group A] (f : L →* A) (B : Subgroup A) :
    residualPreimage f B ≤ B.comap f := map_subtype_le _

/-- Finiteness makes the residual lift two-perfect. -/
theorem residualPreimage_perfect [Finite L] {A : Type*} [Group A]
    (f : L →* A) (B : Subgroup A) : IsPPerfect 2 (residualPreimage f B) :=
  isPPerfect_embedded_pResidual 2 (B.comap f)

/-- Residuals preserve the whole image when the target subgroup is two-perfect. -/
theorem residualPreimage_map [Finite L] {A : Type*} [Group A]
    (f : L →* A) (hf : Function.Surjective f) (B : Subgroup A)
    (hB : IsPPerfect 2 B) : (residualPreimage f B).map f = B := by
  have hm : (B.comap f).map f = B := map_comap_eq_self (by rw [MonoidHom.range_eq_top.mpr hf]; exact le_top)
  rw [residualPreimage, map_embedded_pResidual, hm, (pResidual_eq_top_iff 2 B).mpr hB]
  rw [← MonoidHom.range_eq_map, range_subtype]


/-- Recover a genuine characteristic-two natural model from the source block type. -/
theorem even_block_model {n : ℕ} (h : IsL2EvenBlock L n) :
    ∃ (F : Type) (_ : Field F) (_ : Finite F) (_ : CharP F 2),
      Nat.card F = 2 ^ n ∧ 4 ≤ Nat.card F ∧
        Nonempty (BlockModuleModel L (Matrix.SL2.naturalAction F)) := by
  obtain ⟨hn, _, F, _, _, hcard, _, hmodel⟩ := h
  let : Fintype F := Fintype.ofFinite F
  have hchar : ringChar F = 2 := FiniteField.even_card_iff_char_two.mpr (by
    rw [← Nat.card_eq_fintype_card, hcard]
    exact Nat.mod_eq_zero_of_dvd (dvd_pow_self 2 (by omega : n ≠ 0)))
  have htwo : CharP F 2 := hchar ▸ (inferInstance : CharP F (ringChar F))
  refine ⟨F, inferInstance, inferInstance, htwo, hcard, ?_, natural_model_iff.mp hmodel⟩
  rw [hcard]
  exact Nat.pow_le_pow_right (by decide : 0 < 2) hn

/-- The actual quotient map followed by the specified matrix isomorphism. -/
def projection (model : BlockModuleModel L (Matrix.SL2.naturalAction F)) : L →* SL(2,F) :=
  model.quotientIso.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))

/-- Every matrix has a lift in the actual block. -/
theorem projection_surjective (model : BlockModuleModel L (Matrix.SL2.naturalAction F)) :
    Function.Surjective (projection model) :=
  model.quotientIso.surjective.comp (QuotientGroup.mk'_surjective _)

/-- A two-perfect lift of the upper triangular matrix Borel. -/
def borelLift (model : BlockModuleModel L (Matrix.SL2.naturalAction F)) : Subgroup L :=
  residualPreimage (projection model) (Borel F)

/-- The constructed lift equals its own two-residual. -/
theorem borelLift_perfect [Finite L]
    (model : BlockModuleModel L (Matrix.SL2.naturalAction F)) :
    IsPPerfect 2 (borelLift model) := residualPreimage_perfect _ _

/-- The constructed lift covers the entire matrix Borel. -/
theorem borelLift_map [Finite L] [Finite F] [CharP F 2]
    (model : BlockModuleModel L (Matrix.SL2.naturalAction F)) (hq : 4 ≤ Nat.card F) :
    (borelLift model).map (projection model) = Borel F :=
  residualPreimage_map _ (projection_surjective model) _ (linear_borel_isPPerfect hq)

theorem borelLift_normalizes_root_preimage
    (model : BlockModuleModel L (Matrix.SL2.naturalAction F)) :
    borelLift model ≤ normalizer (((upperUnipotent F).comap (projection model)) : Set L) := by
  apply (residualPreimage_le _ _).trans
  rw [← rankOneBorel_eq_sourceBorel]
  exact (upperUnipotent F).le_normalizer_comap (projection model)

/-- A nontrivial commutator-generated subgroup cannot lie in the central fixed layer. -/
theorem nontrivial_module_image (W : Subgroup (blockU L))
    (A : Subgroup L) (hne : W ≠ ⊥)
    (hcomm : ⁅W.map (blockU L).subtype, A⁆ = W.map (blockU L).subtype) :
    W.map (QuotientGroup.mk' (blockFixed L)) ≠ ⊥ := by
  intro he
  have hWF : W ≤ blockFixed L := by
    rwa [Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] at he
  have hWC : W.map (blockU L).subtype ≤ center L := by
    rintro _ ⟨w, hw, rfl⟩
    exact hWF hw
  have hc := commutator_eq_bot_iff_le_centralizer.mpr
    (hWC.trans (center_le_centralizer (A : Set L)))
  rw [hcomm] at hc
  exact hne ((W.map_eq_bot_iff_of_injective (blockU L).subtype_injective).mp hc)

/-- Coverage and nontrivial projection are proved from the lift and commutator hypotheses. -/
theorem borelLift_field_bound [Finite L] [Finite F] [CharP F 2]
    (model : BlockModuleModel L (Matrix.SL2.naturalAction F)) (hq : 4 ≤ Nat.card F)
    (W : Subgroup (blockU L)) (hcard : Nat.card W = 4) (A : Subgroup L)
    (hcomm : ⁅W.map (blockU L).subtype, A⁆ = W.map (blockU L).subtype)
    (hinv : ∀ l ∈ borelLift model, ∀ w ∈ W, blockConjugate L l w ∈ W) :
    Nat.card F = 4 := by
  have hne : W ≠ ⊥ := by intro he; rw [he] at hcard; simp at hcard
  exact Nat.le_antisymm (linear_block_four_field_bound model W hcard
    (nontrivial_module_image W A hne hcomm) (borelLift model)
    (borelLift_map model hq).ge hinv) hq

section Pair
variable {L₁ L₂ : Type*} [Group L₁] [Group L₂]
variable (m₁ : BlockModuleModel L₁ (Matrix.SL2.naturalAction F))
    (m₂ : BlockModuleModel L₂ (Matrix.SL2.naturalAction F))

/-- The two actual block quotient maps, with independent matrix coordinates. -/
def pairProjection : (L₁ × L₂) →* (SL(2,F) × SL(2,F)) :=
  (projection m₁).prodMap (projection m₂)

/-- The product quotient covers both independent matrix groups. -/
theorem pairProjection_surjective : Function.Surjective (pairProjection m₁ m₂) := by
  rintro ⟨a,b⟩
  obtain ⟨x,hx⟩ := projection_surjective m₁ a
  obtain ⟨y,hy⟩ := projection_surjective m₂ b
  exact ⟨(x,y), Prod.ext hx hy⟩

/-- The product of the two actual module quotient maps, written additively in coordinates. -/
def pairModuleMap : (blockU L₁ × blockU L₂) →*
    Multiplicative ((Fin 2 → F) × (Fin 2 → F)) where
  toFun u := Multiplicative.ofAdd
    ((m₁.moduleIso (QuotientGroup.mk' (blockFixed L₁) u.1)).toAdd,
     (m₂.moduleIso (QuotientGroup.mk' (blockFixed L₂) u.2)).toAdd)
  map_one' := by simp
  map_mul' u v := by
    simp
    rfl

/-- Componentwise conjugation is exactly the independent natural-plane action. -/
theorem pairModuleMap_intertwining (l : L₁ × L₂) (u : blockU L₁ × blockU L₂) :
    pairModuleMap m₁ m₂ (blockConjugate L₁ l.1 u.1, blockConjugate L₂ l.2 u.2) =
      Matrix.SL2.naturalPairAction F (pairProjection m₁ m₂ l) (pairModuleMap m₁ m₂ u) := by
  apply Multiplicative.toAdd.injective
  change ((m₁.moduleIso (QuotientGroup.mk' (blockFixed L₁) (blockConjugate L₁ l.1 u.1))).toAdd,
      (m₂.moduleIso (QuotientGroup.mk' (blockFixed L₂) (blockConjugate L₂ l.2 u.2))).toAdd) = _
  rw [m₁.intertwining, m₂.intertwining]
  rfl

/-- The residual lift of the product Borel in the external product of the blocks. -/
def pairBorelLift : Subgroup (L₁ × L₂) :=
  residualPreimage (pairProjection m₁ m₂) ((Borel F).prod (Borel F))

/-- The product Borel lift is two-perfect. -/
theorem pairBorelLift_perfect [Finite L₁] [Finite L₂] :
    IsPPerfect 2 (pairBorelLift m₁ m₂) := residualPreimage_perfect _ _

/-- Both Borel coordinates are covered independently. -/
theorem pairBorelLift_map [Finite L₁] [Finite L₂] [Finite F] [CharP F 2]
    (hq : 4 ≤ Nat.card F) :
    (pairBorelLift m₁ m₂).map (pairProjection m₁ m₂) = (Borel F).prod (Borel F) :=
  residualPreimage_map _ (pairProjection_surjective m₁ m₂) _ (linear_borel_pair_isPPerfect hq)

/-- A nonzero invariant image in the pair of natural modules bounds the field order. -/
theorem pairBorelLift_card_bound [Finite L₁] [Finite L₂] [Finite F] [CharP F 2]
    (hq : 4 ≤ Nat.card F) (W : Subgroup (blockU L₁ × blockU L₂))
    (hne : W.map (pairModuleMap m₁ m₂) ≠ ⊥)
    (hinv : ∀ l ∈ pairBorelLift m₁ m₂, ∀ w ∈ W,
      (blockConjugate L₁ l.1 w.1, blockConjugate L₂ l.2 w.2) ∈ W) :
    Nat.card F ≤ Nat.card W := by
  have hact : ∀ a ∈ (Borel F).prod (Borel F), ∀ v ∈ W.map (pairModuleMap m₁ m₂),
      Matrix.SL2.naturalPairAction F a v ∈ W.map (pairModuleMap m₁ m₂) := by
    intro a ha v hv
    obtain ⟨l, hl, rfl⟩ := (pairBorelLift_map m₁ m₂ hq).symm ▸ ha
    obtain ⟨w, hw, rfl⟩ := hv
    exact ⟨_, hinv l hl w hw, pairModuleMap_intertwining m₁ m₂ l w⟩
  rw [← rankOneBorel_eq_sourceBorel] at hact
  exact (Matrix.SL2.card_le_of_naturalPairAction_borel_invariant _ hne hact).trans
    (Nat.card_image_le (Set.toFinite _))

/-- The only vectors lost are in the two intrinsic central fixed layers. -/
theorem pairModuleMap_ker : (pairModuleMap m₁ m₂).ker =
    (blockFixed L₁).prod (blockFixed L₂) := by
  ext u
  simp [pairModuleMap, MonoidHom.mem_ker, Prod.ext_iff, QuotientGroup.eq_one_iff, Subgroup.mem_prod]

/-- The literal inclusions of the two commutator layers in their block groups. -/
def pairModuleInclusion : (blockU L₁ × blockU L₂) →* (L₁ × L₂) :=
  (blockU L₁).subtype.prodMap (blockU L₂).subtype

/-- The componentwise inclusion loses no group elements. -/
theorem pairModuleInclusion_injective :
    Function.Injective (pairModuleInclusion (L₁ := L₁) (L₂ := L₂)) := by
  intro u v h
  exact Prod.ext (Subtype.ext (congrArg Prod.fst h)) (Subtype.ext (congrArg Prod.snd h))

/-- Commutator generation rules out disappearance in the pair of central fixed layers. -/
theorem pair_nontrivial_module_image (W : Subgroup (blockU L₁ × blockU L₂))
    (A : Subgroup (L₁ × L₂)) (hne : W ≠ ⊥)
    (hcomm : ⁅W.map pairModuleInclusion, A⁆ = W.map pairModuleInclusion) :
    W.map (pairModuleMap m₁ m₂) ≠ ⊥ := by
  intro he
  have hWF : W ≤ (blockFixed L₁).prod (blockFixed L₂) := by
    rwa [Subgroup.map_eq_bot_iff, pairModuleMap_ker] at he
  have hWC : W.map pairModuleInclusion ≤ center (L₁ × L₂) := by
    rintro _ ⟨w, hw, rfl⟩
    apply Subgroup.mem_center_iff.mpr
    intro x
    exact Prod.ext (Subgroup.mem_center_iff.mp (hWF hw).1 x.1)
      (Subgroup.mem_center_iff.mp (hWF hw).2 x.2)
  have hc := commutator_eq_bot_iff_le_centralizer.mpr
    (hWC.trans (center_le_centralizer (A : Set (L₁ × L₂))))
  rw [hcomm] at hc
  exact hne ((W.map_eq_bot_iff_of_injective pairModuleInclusion_injective).mp hc)

/-- A commutator-generated invariant four-group in the pair of blocks forces field four. -/
theorem pairBorelLift_field_bound [Finite L₁] [Finite L₂] [Finite F] [CharP F 2]
    (hq : 4 ≤ Nat.card F) (W : Subgroup (blockU L₁ × blockU L₂))
    (hcard : Nat.card W = 4) (A : Subgroup (L₁ × L₂))
    (hcomm : ⁅W.map pairModuleInclusion, A⁆ = W.map pairModuleInclusion)
    (hinv : ∀ l ∈ pairBorelLift m₁ m₂, ∀ w ∈ W,
      (blockConjugate L₁ l.1 w.1, blockConjugate L₂ l.2 w.2) ∈ W) :
    Nat.card F = 4 := by
  have hne : W ≠ ⊥ := by intro he; rw [he] at hcard; simp at hcard
  have hb := pairBorelLift_card_bound m₁ m₂ hq W
    (pair_nontrivial_module_image m₁ m₂ W A hne hcomm) hinv
  exact Nat.le_antisymm (hcard ▸ hb) hq

end Pair
end CFSG.Quasithin.Chapter15.Section04.LocalSetup.CoreElimination.BlockEndgame
