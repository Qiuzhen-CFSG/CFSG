module

public import CFSG.Quasithin.Chapter15.Section04.Configuration.LocalSetup.SylowGeometry.CoreElimination.BlockSieve.BinaryBranch
public import CFSG.Quasithin.Chapter15.Section04.Configuration.LocalSetup.TwoFactors.FFBranch.Recognition.ClassificationComparison.ExhaustiveSource
public import Theory.Representation.BinaryOffender.GeneratedCore
public import CFSG.KnownSimple.CarrierCatalogue

/-!
# Applying the adequate FF classification to the actual binary source actor

The group to which B.5.3 applies is the subgroup generated by best offenders
on the original internal module. Its preimage in H gives a genuine SQTK
cover with the full known-simple class. Restriction supplies generation,
faithfulness and a trivial two-core. The source FF witness remains nontrivial
after restriction, and the original Sylow seed excludes a small central section
on this restricted action as well.

The quotient equivalence embeds this exact offender subgroup normally in
Aut(PSLₙ(2)); the action identity retains the original module and quotient map.
The adequate universal B.5.6 implication is applied with all its hypotheses.
Comparison of its module alternatives with the binary simple socle remains
the subsequent representation step; no equality with the entire automorphism
group, splitting, or small-section conclusion is assumed.

Source: Aschbacher–Smith, 15.4.20, printed p.1164; B.5.3/B.5.6, pp.104–110.
-/

@[expose] public section
open Subgroup Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section04.LocalSetup.CoreElimination.BlockSieve.BinaryBranch.SourceClassification
open TwoFactors.FFBranch TwoFactors.FFBranch.ClassificationComparison
universe u
variable {G : Type u} [Group G] [Finite G]
  {d : Source.Geometry G} {i j : Bool} {H U K : Subgroup G}

/-- The source core action equals the existing quotient action on every original lift. -/
theorem quotientAction_eq (h : Input d i j H U K) :
    let := h.module_properties.1
    TwoFactors.FFBranch.quotientAction h.placed.sylow (d.Z.subgroupOf H) h.seed_inputs.2.2.1 =
      coreAction (moduleClosure (d.Z.subgroupOf H)) h.module_properties.2.2.2 := by
  let := h.module_properties.1
  apply MonoidHom.ext
  intro g
  apply LinearMap.ext
  intro v
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (pCore 2 H) g
  apply Additive.toMul.injective
  apply Subtype.ext
  exact (TwoFactors.FFBranch.quotientAction_apply h.placed.sylow (d.Z.subgroupOf H)
    h.seed_inputs.2.2.1 x v).trans
      (coreAction_apply _ h.module_properties.2.2.2 x v).symm

/-- The actual offender subgroup, before transport to the binary automorphism group. -/
noncomputable def sourceGroup (h : Input d i j H U K) : Subgroup (H ⧸ pCore 2 H) :=
  let := h.module_properties.1
  offenderGroup h.placed.sylow (d.Z.subgroupOf H) h.seed_inputs.2.2.1

/-- Restrict the original quotient conjugation representation to its own offenders. -/
noncomputable def sourceAction (h : Input d i j H U K) :
    let := h.module_properties.1
    Representation (ZMod 2) (sourceGroup h) (Additive (moduleClosure (d.Z.subgroupOf H))) :=
  let := h.module_properties.1
  offenderAction h.placed.sylow (d.Z.subgroupOf H) h.seed_inputs.2.2.1

/-- This is the literal embedding induced by the supplied whole quotient equivalence. -/
noncomputable def sourceEmbedding (h : Input d i j H U K) {n : ℕ}
    (e : (H ⧸ pCore 2 H) ≃* MulAut (Matrix.ProjectiveSpecialLinearGroup (Fin n) (ZMod 2))) :
    sourceGroup h →* MulAut (Matrix.ProjectiveSpecialLinearGroup (Fin n) (ZMod 2)) :=
  e.toMonoidHom.comp (sourceGroup h).subtype

theorem sourceEmbedding_injective (h : Input d i j H U K) {n : ℕ}
    (e : (H ⧸ pCore 2 H) ≃* MulAut (Matrix.ProjectiveSpecialLinearGroup (Fin n) (ZMod 2))) :
    Function.Injective (sourceEmbedding h e) := e.injective.comp Subtype.val_injective

/-- The full binary action restricts to the same source action through the literal embedding. -/
theorem sourceAction_eq (h : Input d i j H U K) {n : ℕ}
    (e : (H ⧸ pCore 2 H) ≃* MulAut (Matrix.ProjectiveSpecialLinearGroup (Fin n) (ZMod 2))) :
    let := h.module_properties.1
    sourceAction h = (action h e).comp (sourceEmbedding h e) := by
  let := h.module_properties.1
  apply MonoidHom.ext
  intro g
  change TwoFactors.FFBranch.quotientAction h.placed.sylow (d.Z.subgroupOf H) h.seed_inputs.2.2.1 g.val =
    coreAction _ h.module_properties.2.2.2 (e.symm (e g.val))
  rw [e.symm_apply_apply, quotientAction_eq h]

/-- Normality is inherited from the invariant family of all best offenders. -/
theorem sourceGroup_normal (h : Input d i j H U K) : (sourceGroup h).Normal := by
  let := h.module_properties.1
  exact offenderGroup_normal h.placed.sylow (d.Z.subgroupOf H) h.seed_inputs.2.2.1

/-- Its literal image is normal in the whole automorphism group, including outer actors. -/
theorem sourceImage_normal (h : Input d i j H U K) {n : ℕ}
    (e : (H ⧸ pCore 2 H) ≃* MulAut (Matrix.ProjectiveSpecialLinearGroup (Fin n) (ZMod 2))) :
    ((sourceGroup h).map e.toMonoidHom).Normal :=
  (sourceGroup_normal h).map e.toMonoidHom e.surjective

/-- The source's genuine FF witness produces a best offender in the actual restricted actor. -/
theorem sourceAction_isFFModule (h : Input d i j H U K) {n : ℕ}
    (e : (H ⧸ pCore 2 H) ≃* MulAut (Matrix.ProjectiveSpecialLinearGroup (Fin n) (ZMod 2))) :
    let := h.module_properties.1
    IsFFModule (sourceAction h) := by
  let := h.module_properties.1
  let ρ := TwoFactors.FFBranch.quotientAction h.placed.sylow (d.Z.subgroupOf H) h.seed_inputs.2.2.1
  have hff : IsFFModule ρ := (action_isFFModule h e).map_equivariant (action h e) ρ
    e.symm.toMonoidHom e.symm.injective (LinearEquiv.refl (ZMod 2) _) (by
      intro g v
      change coreAction _ h.module_properties.2.2.2 (e.symm g) v = ρ (e.symm g) v
      rw [show ρ = coreAction _ h.module_properties.2.2.2 from quotientAction_eq h])
  obtain ⟨A, hA⟩ := (isFFModule_iff_exists_bestOffender ρ).mp hff
  exact ⟨A.subgroupOf (sourceGroup h),
    (hA.subgroupOf ρ (hA.le_offenderSubgroup ρ)).isOffender _⟩

/-- The normal image is nontrivial; no full offender-generation claim for Aut is used. -/
theorem sourceImage_ne_bot (h : Input d i j H U K) {n : ℕ}
    (e : (H ⧸ pCore 2 H) ≃* MulAut (Matrix.ProjectiveSpecialLinearGroup (Fin n) (ZMod 2))) :
    (sourceGroup h).map e.toMonoidHom ≠ ⊥ := by
  let := h.module_properties.1
  let : Nontrivial (sourceGroup h) := FFAlternatives.nontrivial_of_ff _ (sourceAction_isFFModule h e)
  intro he
  exact (Subgroup.nontrivial_iff_ne_bot _).mp inferInstance
    (((sourceGroup h).map_eq_bot_iff_of_injective e.injective).mp he)

/-- All B.5.3 premises, with a genuine cover inherited from the full known-simple SQTK input. -/
theorem sourceFFHypothesis (h : Input d i j H U K)
    (hH : IsSQTK KnownSimple.IsKnownSimple H) :
    let := h.module_properties.1
    FFHypothesis KnownSimple.IsKnownSimple (sourceAction h) := by
  let := h.module_properties.1
  exact offenderFFHypothesis h.placed.sylow (d.Z.subgroupOf H) h.seed_inputs.2.2.1 hH

/-- Apply the corrected adequate universal source theorem to that exact restricted action. -/
theorem adequate_source_alternative (h : Input d i j H U K)
    (hH : IsSQTK KnownSimple.IsKnownSimple H)
    (earlier : FFAlternatives.ProjectiveLine.AdequateGeneralClassificationInput.{u,u}
      KnownSimple.IsKnownSimple) :
    let := h.module_properties.1
    FFAlternatives.ProjectiveLine.AdequateSourceAlternative (sourceAction h) := by
  let := h.module_properties.1
  exact earlier (sourceGroup h) (Additive (moduleClosure (d.Z.subgroupOf H)))
    (sourceAction h) (sourceFFHypothesis h hH)

/-- The source Sylow fixed-space obstruction survives restriction to the actual offenders. -/
theorem sourceAction_not_smallSection (h : Input d i j H U K) :
    let := h.module_properties.1
    ¬ BinaryLinearSections.HasSmallSection (sourceAction h) := by
  let := h.module_properties.1
  dsimp only
  change ¬ BinaryLinearSections.HasSmallSection
    (offenderAction h.placed.sylow (d.Z.subgroupOf H) h.seed_inputs.2.2.1)
  intro hs
  obtain ⟨S, hS⟩ := exists_offenderSylow h.placed.sylow (d.Z.subgroupOf H)
    h.seed_inputs.2.2.1
  obtain ⟨x, hx, _, hfix⟩ := hs.sylow_enlargement
    (offenderAction h.placed.sylow (d.Z.subgroupOf H) h.seed_inputs.2.2.1) S
  exact offenderAction_no_fixedSpace_enlargement h.placed.sylow (d.Z.subgroupOf H)
    h.seed_inputs.2.2.1 (S : Subgroup _) hS x hx hfix

end CFSG.Quasithin.Chapter15.Section04.LocalSetup.CoreElimination.BlockSieve.BinaryBranch.SourceClassification
