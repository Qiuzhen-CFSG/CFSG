module
public import CFSG.Quasithin.Chapter15.Section04.Configuration.LocalSetup.SylowGeometry.RControl
public import CFSG.Quasithin.ChapterA.Section04.Signalizers.SectionCentralizer
public import Theory.GroupTheory.SylowNormalRestriction
public import Theory.GroupTheory.Commutator.ConjugateGeneration
public import CFSG.Quasithin.Chapter3.Section01.LocalGeometry

/-!
# Constructing the pushing-up hypotheses in the Sylow contradiction

For the actual contrary Sylow subgroup `U` of `H=I₀`, put
`R=O₂(XU)` and `M=H∩N_G(X)`. The kernel of the action of `U` on
`X/O₂(X)` is exactly `R`. The section centralizer is normal in `M`,
so normal Sylow restriction makes `R` Sylow in it, and hence in the
subgroup generated by the `M`-conjugates of `R`.

Combine this calculation with the radical-core argument and the ambient
characteristic-normalizer control. Restriction carries characteristic
normalizers into the intrinsic group `H`. The resulting theorem constructs
every group-theoretic clause of Hypothesis C.2.3; in particular its Sylow
condition concerns `⟨R^M⟩`, not the join of `R` and `M`. No such clause is
assumed. The C-component, module and embedding alternatives required for
the application of C.2.7 remain subsequent obligations.

Source: Aschbacher–Smith, combined manuscript (1 March 2004),
Hypothesis C.2.3 (p.144) and Lemma 15.4.20 (pp.1163–1164).
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter15.Section04.LocalSetup
open Subgroup
variable {G : Type*} [Group G]

private theorem characteristic_map_equiv {A B : Type*} [Group A] [Group B]
    (e : A ≃* B) (C : Subgroup A) [C.Characteristic] :
    (C.map e.toMonoidHom).Characteristic := by
  apply characteristic_iff_le_comap.mpr
  intro a b hb
  obtain ⟨c, hc, rfl⟩ := hb
  let a' : A ≃* A := (e.trans a).trans e.symm
  exact ⟨a' c, characteristic_iff_le_comap.mp inferInstance a' hc, e.apply_symm_apply _⟩

/-- An injective ambient map carries intrinsic characteristic normalizers
into the characteristic normalizers of the image subgroup. -/
theorem characteristicNormalizerClosure_map_le {B : Type*} [Group B]
    (f : G →* B) (hf : Function.Injective f) (R : Subgroup G) :
    (characteristicNormalizerClosure R).map f ≤ characteristicNormalizerClosure (R.map f) := by
  rw [characteristicNormalizerClosure, Subgroup.map_iSup]
  apply iSup_le
  intro C
  rw [Subgroup.map_iSup]
  apply iSup_le
  intro hC
  rw [Subgroup.map_iSup]
  apply iSup_le
  intro hCne
  let := hC
  let e := equivMapOfInjective R f hf
  let D := C.map e.toMonoidHom
  let : D.Characteristic := characteristic_map_equiv e C
  have hDne : D ≠ ⊥ := fun h => hCne ((C.map_eq_bot_iff_of_injective e.injective).mp h)
  have he : (C.map R.subtype).map f = D.map (R.map f).subtype := by
    rw [map_map, map_map]
    rfl
  exact ((C.map R.subtype).le_normalizer_map f).trans
    (he ▸ normalizer_le_characteristicNormalizerClosure (R.map f) D hDne)

/-- Ambient characteristic-normalizer control restricts to the intrinsic
subgroup `H`. It does not assert characteristicness in the ambient group. -/
theorem characteristicNormalizerClosure_restrict {R H M : Subgroup G}
    (hRH : R ≤ H) (hc : characteristicNormalizerClosure R ≤ M) :
    characteristicNormalizerClosure (R.subgroupOf H) ≤ M.subgroupOf H := by
  apply (map_le_iff_le_comap).mp
  have h := characteristicNormalizerClosure_map_le H.subtype H.subtype_injective (R.subgroupOf H)
  rw [map_subgroupOf_eq_of_le hRH] at h
  exact h.trans hc

variable [Finite G]

omit [Finite G] in
private theorem core_normalized (H : Subgroup G) :
    H ≤ normalizer (H.pCoreIn 2 : Set G) :=
  H.le_normalizer.trans (normalizer_le_normalizer_characteristic_image H (pCore 2 H))

omit [Finite G] in
/-- In a group normalized by `U`, the two-core of `XU` is exactly the
kernel of the action of `U` on the genuine section `X/O₂(X)`. -/
theorem contrary_core_eq_section_kernel {X U H M : Subgroup G}
    (hXM : X ≤ M) (hUM : U ≤ M) (hMH : M ≤ H)
    (hMX : M ≤ normalizer (X : Set G))
    (P : Sylow 2 H) (hP : (P : Subgroup H).map H.subtype = U) :
    (X ⊔ U : Subgroup G).pCoreIn 2 = U ⊓ ChapterA.Section04.twoSectionCentralizer X M := by
  let R := (X ⊔ U : Subgroup G).pCoreIn 2
  let C := ChapterA.Section04.twoSectionCentralizer X M
  have hXUH : X ⊔ U ≤ H := (sup_le hXM hUM).trans hMH
  have hRU : R ≤ U := by
    have h := pCoreIn_le_sylow (X ⊔ U) (restrictSylow P hXUH (hP ▸ le_sup_right))
    rwa [restrictSylow_image, hP] at h
  have hUX : U ≤ normalizer (X : Set G) := hUM.trans hMX
  have hXR : X ≤ normalizer (R : Set G) := le_sup_left.trans (core_normalized _)
  have hRcore : R ⊓ X ≤ X.pCoreIn 2 :=
    le_pCoreIn_of_normalizes ((isPGroup_pCoreIn 2 _).to_le inf_le_left) inf_le_right
      ((le_inf hXR X.le_normalizer).trans inf_normalizer_le_normalizer_inf)
  have hRC : R ≤ C := by
    apply (ChapterA.Section04.le_twoSectionCentralizer_iff X M R).mpr
    refine ⟨hRU.trans hUM, hRU.trans hUX, ?_⟩
    exact (le_inf (le_normalizer_iff_commutator_le_right.mp hXR)
      (le_normalizer_iff_commutator_le_left.mp (hRU.trans hUX))).trans hRcore
  have hcoreR : X.pCoreIn 2 ≤ R :=
    pCoreIn_mono_of_normalizes le_sup_left (sup_le X.le_normalizer hUX)
  have hcoreUC : X.pCoreIn 2 ≤ U ⊓ C := le_inf (hcoreR.trans hRU)
    (ChapterA.Section04.pCoreIn_le_twoSectionCentralizer X M hXM)
  have hCC := (ChapterA.Section04.le_twoSectionCentralizer_iff X M C).mp le_rfl
  have hXUC : X ≤ normalizer ((U ⊓ C : Subgroup G) : Set G) :=
    le_normalizer_iff_commutator_le_right.mpr
      (((commutator_mono le_rfl inf_le_right).trans hCC.2.2).trans hcoreUC)
  have hUC : U ≤ normalizer (C : Set G) :=
    hUM.trans (ChapterA.Section04.twoSectionCentralizer_normalized X M hMX)
  have hUUC : U ≤ normalizer ((U ⊓ C : Subgroup G) : Set G) :=
    (le_inf U.le_normalizer hUC).trans inf_normalizer_le_normalizer_inf
  refine le_antisymm (le_inf hRU hRC) ?_
  exact le_pCoreIn_of_normalizes ((P.isPGroup'.map H.subtype).to_le (hP ▸ inf_le_left))
    (inf_le_left.trans le_sup_right) (sup_le hXUC hUUC)

/-- Normal Sylow restriction with all subgroups retained in their common
ambient group. -/
theorem sylow_intersection_image_of_relative_normal {M C U : Subgroup G}
    (hCM : C ≤ M) (hn : M ≤ normalizer (C : Set G))
    (P : Sylow 2 M) (hP : (P : Subgroup M).map M.subtype = U) :
    ∃ Q : Sylow 2 C, (Q : Subgroup C).map C.subtype = U ⊓ C := by
  let : (C.subgroupOf M).Normal := normal_subgroupOf_of_le_normalizer hn
  obtain ⟨Q, hQ⟩ := P.exists_sylow_map_eq_inf_of_normal (C.subgroupOf M)
  let e := subgroupOfEquivOfLe hCM
  let Q' := Q.mapSurjective (f := e.toMonoidHom) e.surjective
  refine ⟨Q', ?_⟩
  have hmaps : (Q' : Subgroup C).map C.subtype =
      ((Q : Subgroup (C.subgroupOf M)).map (C.subgroupOf M).subtype).map M.subtype := by
    change ((Q : Subgroup (C.subgroupOf M)).map e.toMonoidHom).map C.subtype = _
    rw [map_map, map_map]
    rfl
  rw [hmaps, hQ, map_inf _ _ _ M.subtype_injective, hP, map_subgroupOf_eq_of_le hCM]

/-- `R` is Sylow in the subgroup generated by its conjugates under `M`.
This is the actual Sylow clause of Hypothesis C.2.3, with `M=I₀∩M₁`.
The proof places the normal closure in `C_M(X/O₂(X))` and computes its
intersection with the already supplied Sylow subgroup. -/
theorem contrary_core_sylow_conjugates {X U H M : Subgroup G}
    (hXM : X ≤ M) (hUM : U ≤ M) (hMH : M ≤ H)
    (hMX : M ≤ normalizer (X : Set G))
    (P : Sylow 2 H) (hP : (P : Subgroup H).map H.subtype = U) :
    let R := (X ⊔ U : Subgroup G).pCoreIn 2
    let D := ⨆ m : M, R.map (MulAut.conj (m : G)).toMonoidHom
    ∃ Q : Sylow 2 D, (Q : Subgroup D).map D.subtype = R := by
  let R := (X ⊔ U : Subgroup G).pCoreIn 2
  let C := ChapterA.Section04.twoSectionCentralizer X M
  let D := ⨆ m : M, R.map (MulAut.conj (m : G)).toMonoidHom
  have hR : R = U ⊓ C := contrary_core_eq_section_kernel hXM hUM hMH hMX P hP
  have hn := ChapterA.Section04.twoSectionCentralizer_normalized X M hMX
  have hDC : D ≤ C := by
    apply iSup_le
    intro m
    exact (map_mono (hR.le.trans inf_le_right)).trans
      (mem_normalizer_iff_map_conj_eq.mp (hn m.property)).le
  have hRD : R ≤ D := by
    intro r hr
    exact (le_iSup (fun m : M => R.map (MulAut.conj (m : G)).toMonoidHom) 1)
      ⟨r, hr, by simp⟩
  have hPM := (restrictSylow_image P hMH (hP ▸ hUM)).trans hP
  obtain ⟨Q, hQ⟩ := sylow_intersection_image_of_relative_normal
    (ChapterA.Section04.twoSectionCentralizer_le X M) hn
    (restrictSylow P hMH (hP ▸ hUM)) hPM
  rw [← hR] at hQ
  exact ⟨restrictSylow Q hDC (hQ ▸ hRD), (restrictSylow_image Q hDC (hQ ▸ hRD)).trans hQ⟩

/-- Construct every group-theoretic clause of source Hypothesis C.2.3 for
`H=I₀`, `M_H=I₀∩N_G(X)` and the actual `R=O₂(XT_I)`. The subgroup whose
Sylow subgroup is `R` is generated by the conjugates of `R` under `M_H`.
No characteristic-normalizer, radical or pushing-up condition is assumed. -/
theorem contrary_pushing_up_inputs {K : GroupClass} (hG : IsSimpleQTKE K G)
    (T : Sylow 2 G) {X U H : Subgroup G} (hH : H ∈ Chapter1.H G)
    (hXH : X ≤ H) (hUT : U ≤ (T : Subgroup G))
    (hindex : U.relIndex (T : Subgroup G) = 2)
    (hTX : (T : Subgroup G) ≤ normalizer (X : Set G))
    (hXcore : X.pCoreIn 2 ≠ ⊥)
    (hunique : ∀ N : Subgroup G, IsMaximalTwoLocal N →
      X ⊔ (T : Subgroup G) ≤ N → N = normalizer (X : Set G))
    (P : Sylow 2 H) (hP : (P : Subgroup H).map H.subtype = U) :
    let R := (X ⊔ U : Subgroup G).pCoreIn 2
    let M := H ⊓ normalizer (X : Set G)
    let D : Subgroup G := ⨆ m : M, R.map (MulAut.conj (m : G)).toMonoidHom
    IsSQTK K H ∧ R ≠ ⊥ ∧ R ≤ H ∧ IsPGroup 2 R ∧
      (normalizer (R.subgroupOf H : Set H)).pCoreIn 2 = R.subgroupOf H ∧
      characteristicNormalizerClosure (R.subgroupOf H) ≤ M.subgroupOf H ∧
      (∃ Q : Sylow 2 D, (Q : Subgroup D).map D.subtype = R) := by
  let R := (X ⊔ U : Subgroup G).pCoreIn 2
  let M := H ⊓ normalizer (X : Set G)
  have hUH : U ≤ H := hP ▸ map_subtype_le (P : Subgroup H)
  have hRH : R ≤ H := (pCoreIn_le 2 _).trans (sup_le hXH hUH)
  have hXM : X ≤ M := le_inf hXH X.le_normalizer
  have hUM : U ≤ M := le_inf hUH (hUT.trans hTX)
  have hc := contrary_core_characteristic_control hUT hindex hTX hunique
  have hne := (contrary_core_normalizer_control hUT hindex hTX hXcore hunique).1
  have hrad := contrary_core_radical hXH P hP
  have hrad' : (normalizer (R.subgroupOf H : Set H)).pCoreIn 2 = R.subgroupOf H := by
    apply Subgroup.map_injective H.subtype_injective
    rw [map_pCoreIn_of_injective 2 _ H.subtype H.subtype_injective,
      ← subgroupOf_normalizer_eq hRH, subgroupOf_map_subtype,
      inf_comm (normalizer (R : Set G)) H, hrad, map_subgroupOf_eq_of_le hRH]
  have hc' : characteristicNormalizerClosure (R.subgroupOf H) ≤ M.subgroupOf H := by
    have h := characteristicNormalizerClosure_restrict hRH hc
    simpa only [M, inf_subgroupOf_left] using h
  exact ⟨Chapter3.sqtk_of_mem_H hG hH, hne, hRH, isPGroup_pCoreIn 2 _, hrad', hc',
    contrary_core_sylow_conjugates hXM hUM inf_le_left inf_le_right P hP⟩

end CFSG.Quasithin.Chapter15.Section04.LocalSetup
