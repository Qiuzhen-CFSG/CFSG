module

public import CFSG.Quasithin.Chapter15.Section04.Configuration.LocalSetup.TwoFactors.FFBranch.Transport
public import CFSG.Quasithin.Defs
public import Theory.Representation.BinaryOffender.EquivariantOffender
public import Theory.Representation.BinaryOffender.Stability
public import Theory.GroupTheory.SylowNormalIntersection

/-!
# The actual offender-generated action group

Let `N = J(I/O₂(I), Vᵢ)` for the genuine conjugation representation constructed
in `FFBranch.Module`. Restriction to `N` is faithful, has trivial two-core,
and is generated by its own best offenders. Its preimage in `I` supplies an
actual SQTK quotient presentation. A factor moving the seed supplies the
nontrivial offender needed to exclude the degenerate case of B.5.3.

The explicit Thompson-image containment is the independent input authorized
for this recognition task. Each factor's commutator identity puts its image
in `N`. Thus `I/O₂(I)` is generated by `N` and its prescribed Sylow image,
and its quotient by `N` is a two-group. No equality of `N` with `I/O₂(I)`
is asserted. In particular an FF witness alone is never used as B.5.3's
offender-generation hypothesis.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
1 March 2004 manuscript, Hypothesis B.5.3, printed p.104, and the final
paragraph of Lemma 15.4.18, printed p.1163.
-/

@[expose] public section
open Subgroup Representation.BinaryOffender
open scoped IsMulCommutative
noncomputable section

namespace CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch
variable {H : Type*} [Group H] [Finite H]
variable (P : Sylow 2 H) (Z : Subgroup H)
  [IsElementaryAbelian 2 (moduleClosure Z)]
  (hC : centralizer (Z : Set H) = (P : Subgroup H))

/-- The subgroup generated by all best offenders on the actual quotient module. -/
abbrev offenderGroup := offenderSubgroup (quotientAction P Z hC)
/-- Restriction of the genuine quotient action to its offender-generated subgroup. -/
noncomputable def offenderAction :
    Representation (ZMod 2) (offenderGroup P Z hC) (Additive (moduleClosure Z)) :=
  (quotientAction P Z hC).comp (offenderGroup P Z hC).subtype
instance offenderGroup_normal : (offenderGroup P Z hC).Normal :=
  offenderSubgroup_normal _

omit [Finite H] in
theorem factor_image_le_offenderGroup (Y : Subgroup H)
    (hY : Y = ⁅Y, Stellmacher.elementaryAbelianMaxJ (P : Subgroup H)⁆)
    (hJ : (Stellmacher.elementaryAbelianMaxJ (P : Subgroup H)).map coreProjection ≤
      offenderGroup P Z hC) : Y.map coreProjection ≤ offenderGroup P Z hC := by
  conv_lhs => rw [hY, map_commutator]
  exact (commutator_mono le_rfl hJ).trans (commutator_le_right _ _)

omit [Finite H] in
theorem offenderAction_injective : Function.Injective (offenderAction P Z hC) :=
  (quotientAction_injective P Z hC).comp (offenderGroup P Z hC).subtype_injective

omit [Finite H] in
/-- B.5.3 generation holds for the restricted actors without assuming it for the whole quotient. -/
theorem offenderAction_generated : offenderSubgroup (offenderAction P Z hC) = ⊤ := by
  apply map_injective (offenderGroup P Z hC).subtype_injective
  apply le_antisymm (by simp)
  have htop : (⊤ : Subgroup (offenderGroup P Z hC)).map
      (offenderGroup P Z hC).subtype = offenderGroup P Z hC := by ext x; simp
  rw [htop]
  unfold offenderGroup offenderSubgroup generatedBy
  refine iSup_le fun A => iSup_le fun hA => ?_
  have hAJ : A ≤ offenderGroup P Z hC :=
    le_iSup_of_le A (le_iSup_of_le hA le_rfl)
  rw [← map_subgroupOf_eq_of_le hAJ]
  apply map_mono
  exact le_iSup_of_le (A.subgroupOf (offenderGroup P Z hC))
    (le_iSup_of_le ⟨hA.1.subgroupOf _ hAJ, le_top⟩ le_rfl)

theorem offenderGroup_twoCore : pCore 2 (offenderGroup P Z hC) = ⊥ := by
  have hn : ((pCore 2 (offenderGroup P Z hC)).map
      (offenderGroup P Z hC).subtype).Normal :=
    ConjAct.normal_of_characteristic_of_normal
  have hl : (pCore 2 (offenderGroup P Z hC)).map
      (offenderGroup P Z hC).subtype ≤ pCore 2 (coreQuotient H) :=
    le_sSup ⟨hn, pCore_isPGroup.map _⟩
  rw [coreQuotient_twoCore] at hl
  exact ((pCore 2 (offenderGroup P Z hC)).map_eq_bot_iff_of_injective
    (offenderGroup P Z hC).subtype_injective).mp (le_bot_iff.mp hl)

/-- The actual preimage in the SQTK source group. -/
abbrev offenderCover : Subgroup H := (offenderGroup P Z hC).comap coreProjection

def offenderCoverProjection : offenderCover P Z hC →* offenderGroup P Z hC :=
  coreProjection.subgroupComap (offenderGroup P Z hC)

omit [Finite H] in
theorem offenderCoverProjection_surjective : Function.Surjective (offenderCoverProjection P Z hC) :=
  coreProjection.subgroupComap_surjective_of_surjective _ (QuotientGroup.mk'_surjective _)

/-- The first isomorphism theorem supplies the literal quotient presentation in B.5.3. -/
noncomputable def offenderCoverQuotientEquiv :
    offenderCover P Z hC ⧸ (offenderCoverProjection P Z hC).ker ≃* offenderGroup P Z hC :=
  QuotientGroup.quotientKerEquivOfSurjective (offenderCoverProjection P Z hC)
    (offenderCoverProjection_surjective P Z hC)

theorem offenderCover_sqtk {K : GroupClass} (hH : IsSQTK K H) :
    IsSQTK K (offenderCover P Z hC) := hH.subgroup _


omit [Finite H] in
theorem offenderGroup_ne_bot (Y : Subgroup H)
    (hY : Y = ⁅Y, Stellmacher.elementaryAbelianMaxJ (P : Subgroup H)⁆)
    (hJ : (Stellmacher.elementaryAbelianMaxJ (P : Subgroup H)).map coreProjection ≤
      offenderGroup P Z hC) (hZY : ⁅Z, Y⁆ ≠ ⊥) : offenderGroup P Z hC ≠ ⊥ := by
  intro hb
  have hl := factor_image_le_offenderGroup P Z hC Y hY hJ
  rw [hb] at hl
  have hk : Y ≤ (coreProjection (H := H)).ker := (map_le_iff_le_comap).mp hl
  rw [coreProjection, QuotientGroup.ker_mk'] at hk
  exact factor_not_le_twoCore P Z hC Y hZY hk

theorem offenderAction_isFFModule (Y : Subgroup H)
    (hF : Theory.GroupTheory.generalizedFitting H = pCore 2 H)
    (hY : Y = ⁅Y, Stellmacher.elementaryAbelianMaxJ (P : Subgroup H)⁆)
    (hZY : ⁅Z, Y⁆ ≠ ⊥) : IsFFModule (offenderAction P Z hC) := by
  have hff := quotientAction_isFFModule P Z hC Y hF hY hZY
  obtain ⟨A, hA⟩ := (isFFModule_iff_exists_bestOffender _).mp hff
  have hAJ : A ≤ offenderGroup P Z hC :=
    le_iSup_of_le A (le_iSup_of_le ⟨hA, le_top⟩ le_rfl)
  exact ⟨A.subgroupOf (offenderGroup P Z hC), (hA.subgroupOf _ hAJ).isOffender _⟩

omit [Finite H] in
theorem offenderGroup_sup_sylow (Y₁ Y₂ : Subgroup H)
    (hgen : Y₁ ⊔ Y₂ ⊔ (P : Subgroup H) = ⊤)
    (h₁ : Y₁ = ⁅Y₁, Stellmacher.elementaryAbelianMaxJ (P : Subgroup H)⁆)
    (h₂ : Y₂ = ⁅Y₂, Stellmacher.elementaryAbelianMaxJ (P : Subgroup H)⁆)
    (hJ : (Stellmacher.elementaryAbelianMaxJ (P : Subgroup H)).map coreProjection ≤
      offenderGroup P Z hC) :
    offenderGroup P Z hC ⊔ (P : Subgroup H).map coreProjection = ⊤ := by
  apply top_unique
  calc
    ⊤ = (⊤ : Subgroup H).map coreProjection :=
      (map_top_of_surjective _ (QuotientGroup.mk'_surjective _)).symm
    _ = (Y₁.map coreProjection ⊔ Y₂.map coreProjection) ⊔
        (P : Subgroup H).map coreProjection := by rw [← hgen, Subgroup.map_sup, Subgroup.map_sup]
    _ ≤ _ := sup_le
      (sup_le ((factor_image_le_offenderGroup P Z hC Y₁ h₁ hJ).trans le_sup_left)
        ((factor_image_le_offenderGroup P Z hC Y₂ h₂ hJ).trans le_sup_left)) le_sup_right

omit [Finite H] in
theorem quotient_offenderGroup_isTwoGroup (Y₁ Y₂ : Subgroup H)
    (hgen : Y₁ ⊔ Y₂ ⊔ (P : Subgroup H) = ⊤)
    (h₁ : Y₁ = ⁅Y₁, Stellmacher.elementaryAbelianMaxJ (P : Subgroup H)⁆)
    (h₂ : Y₂ = ⁅Y₂, Stellmacher.elementaryAbelianMaxJ (P : Subgroup H)⁆)
    (hJ : (Stellmacher.elementaryAbelianMaxJ (P : Subgroup H)).map coreProjection ≤
      offenderGroup P Z hC) : IsPGroup 2 (coreQuotient H ⧸ offenderGroup P Z hC) := by
  let q := QuotientGroup.mk' (offenderGroup P Z hC)
  have ht : ((P : Subgroup H).map coreProjection).map q = ⊤ := by
    have hh := congrArg (fun A : Subgroup (coreQuotient H) => A.map q)
      (offenderGroup_sup_sylow P Z hC Y₁ Y₂ hgen h₁ h₂ hJ)
    simpa only [q, Subgroup.map_sup, QuotientGroup.map_mk'_self, bot_sup_eq,
      map_top_of_surjective _ (QuotientGroup.mk'_surjective _)] using hh
  have hp := (P.isPGroup'.map coreProjection).map q
  rw [ht] at hp
  let e : (⊤ : Subgroup (coreQuotient H ⧸ offenderGroup P Z hC)) ≃*
      (coreQuotient H ⧸ offenderGroup P Z hC) := Subgroup.topEquiv
  exact hp.of_surjective e.toMonoidHom e.surjective

theorem exists_offenderSylow : ∃ S : Sylow 2 (offenderGroup P Z hC),
    (S : Subgroup (offenderGroup P Z hC)) =
      ((P : Subgroup H).map coreProjection).subgroupOf (offenderGroup P Z hC) := by
  exact (P.mapSurjective (QuotientGroup.mk'_surjective (pCore 2 H))).exists_subgroupOf_eq_of_normal _

end CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch
