module

public import CFSG.Quasithin.Chapter15.Section04.Configuration.LocalSetup.TwoFactors.FFBranch.Recognition.ActionGroup
public import CFSG.Quasithin.Chapter15.Section04.Configuration.LocalSetup.TwoFactors.FFBranch.Recognition.SeedCriterion

/-!
# The actual hypotheses for the FF classification comparison

This module packages Hypothesis B.5.3 and realizes it for the subgroup
generated by best offenders on the conjugation module. Its finite SQTK cover
is the inverse image of that subgroup in the original group. The quotient
isomorphism is the first isomorphism theorem, not a group-family tag.

The class parameter is the same one supplied by the source application.
Any later universal classification input must be justified for that class;
this module asserts no classification for an arbitrary class of groups.
Nontriviality remains separate from B.5.3, whose printed hypotheses allow
the trivial group. A moved factor supplies an actual FF witness when needed.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
1 March 2004 manuscript, B.5.3 and B.5.6, printed pp.104–105, and the final
paragraph of 15.4.18, p.1163.
-/

@[expose] public section
open Subgroup Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison
universe u v

/-- A literal finite SQTK quotient, including its actual quotient isomorphism. -/
structure SQTKQuotient (K : GroupClass.{u}) (D : Type u) [Group D] where
  Cover : Type u
  [coverGroup : Group Cover]
  [coverFinite : Finite Cover]
  kernel : Subgroup Cover
  [kernelNormal : kernel.Normal]
  sqtk : IsSQTK K Cover
  equiv : (Cover ⧸ kernel) ≃* D

/-- Hypothesis B.5.3 on the actual action. Nontriviality is kept separate,
since the printed hypotheses also admit the trivial group. -/
structure FFHypothesis (K : GroupClass.{u}) {D : Type u} [Group D] [Finite D]
    {V : Type v} [AddCommGroup V] [Module (ZMod 2) V]
    (ρ : Representation (ZMod 2) D V) : Prop where
  finite_module : Module.Finite (ZMod 2) V
  faithful : Function.Injective ρ
  twoCore : pCore 2 D = ⊥
  generated : offenderSubgroup ρ = ⊤
  quotient : Nonempty (SQTKQuotient K D)

variable {H : Type u} [Group H] [Finite H]
    (P : Sylow 2 H) (Z : Subgroup H) [IsElementaryAbelian 2 (moduleClosure Z)]
    (hC : centralizer (Z : Set H) = (P : Subgroup H))

/-- Realize the SQTK cover of the offender subgroup using its actual inverse image. -/
noncomputable def offenderSQTKQuotient {K : GroupClass.{u}} (hH : IsSQTK K H) :
    SQTKQuotient K (offenderGroup P Z hC) where
  Cover := offenderCover P Z hC
  kernel := (offenderCoverProjection P Z hC).ker
  sqtk := offenderCover_sqtk P Z hC hH
  equiv := offenderCoverQuotientEquiv P Z hC

/-- Establish every B.5.3 hypothesis for the restricted action. -/
theorem offenderFFHypothesis {K : GroupClass.{u}} (hH : IsSQTK K H) :
    FFHypothesis K (offenderAction P Z hC) where
  finite_module := Module.Finite.of_finite
  faithful := offenderAction_injective P Z hC
  twoCore := offenderGroup_twoCore P Z hC
  generated := offenderAction_generated P Z hC
  quotient := ⟨offenderSQTKQuotient P Z hC hH⟩

/-- A moved factor supplies the nontrivial offender required by the corrected
nontrivial specialization of B.5.6. No classification conclusion is assumed. -/
theorem offenderFFHypothesis_and_witness {K : GroupClass.{u}} (hH : IsSQTK K H)
    (Y : Subgroup H) (hF : Theory.GroupTheory.generalizedFitting H = pCore 2 H)
    (hY : Y = ⁅Y, Stellmacher.elementaryAbelianMaxJ (P : Subgroup H)⁆)
    (hZY : ⁅Z, Y⁆ ≠ ⊥) :
    FFHypothesis K (offenderAction P Z hC) ∧ IsFFModule (offenderAction P Z hC) :=
  ⟨offenderFFHypothesis P Z hC hH, offenderAction_isFFModule P Z hC Y hF hY hZY⟩

end CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison
