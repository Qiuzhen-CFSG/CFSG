module

public import CFSG.Quasithin.Chapter15.Section04.Configuration.LocalSetup.TwoFactors.FFBranch.Recognition.ClassificationComparison.FFAlternatives.NonQuasisimple
public import Theory.SpecificGroups.PermutationThreePrimeCore

/-!
# Core elimination for the solvable and outer FF alternatives

Generation by best offenders forces every abelian image to have exponent
at most two. In B.5.6(4), the normal product A₆ × C₃ therefore has a two-group
quotient even though the source conclusion does not specify a splitting.
Its three-prime core is trivial, so the ambient three-prime core injects
into that quotient and lies in the already trivial two-core.

The S₃ alternative is handled by its actual permutation model. For the
quasisimple generalized-Fitting alternative we expose the precise model
facts still needed: a three-group center and divisibility of its order by
three. These follow from the model list, not from an assumed core equality.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), B.5.3 and
B.5.6, printed pp.104–105; application to 15.4.18, printed p.1163.
-/

public section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
namespace CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison.FFAlternatives
variable {D : Type*} [Group D] {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    (ρ : Representation (ZMod 2) D V)

/-- Every abelian image of a group generated by binary offenders is a
two-group. No faithfulness or finite-dimensionality assumption is needed. -/
theorem abelian_image_isTwoGroup {Q : Type*} [CommGroup Q]
    (f : D →* Q) (hf : Function.Surjective f) (hg : offenderSubgroup ρ = ⊤) :
    IsPGroup 2 Q := by
  let s : D →* Q := (powMonoidHom 2).comp f
  have hle : offenderSubgroup ρ ≤ s.ker := by
    apply iSup_le
    intro A
    apply iSup_le
    rintro ⟨hA, _⟩ a ha
    let : IsElementaryAbelian 2 A := hA.1.2
    change f a ^ 2 = 1
    rw [← map_pow, elemPow_eq_one_of_isElementaryAbelian a ha, map_one]
  rw [hg] at hle
  intro x
  obtain ⟨a, rfl⟩ := hf x
  exact ⟨1, by simpa [s] using hle (mem_top a)⟩

/-- The conjugation compatibility in the outer case really normalizes the
specified subgroup, rather than an abstract isomorphic copy. -/
theorem InducesOuter.mem_normalizer {A : Subgroup D} {t : D} (h : InducesOuter A t) :
    t ∈ normalizer (A : Set D) := by
  obtain ⟨α, ha, _⟩ := h
  rw [mem_normalizer_iff_map_conj_eq]
  apply le_antisymm
  · rintro _ ⟨a, haA, rfl⟩
    change t * a * t⁻¹ ∈ A
    simpa only [← ha ⟨a, haA⟩] using (α ⟨a, haA⟩).property
  · intro a haA
    refine ⟨(α.symm ⟨a, haA⟩ : A), (α.symm ⟨a, haA⟩).property, ?_⟩
    change t * _ * t⁻¹ = a
    rw [← ha]
    exact congrArg Subtype.val (α.apply_symm_apply ⟨a, haA⟩)

/-- Normality of the product is derived from generation and the specified
outer automorphisms. -/
theorem OuterSixThreeCase.product_normal (c : OuterSixThreeCase ρ) :
    (c.first ⊔ c.second).Normal := by
  apply normalizer_eq_top_iff.mp
  apply top_unique
  rw [← c.generates]
  refine sup_le (c.first ⊔ c.second).le_normalizer (zpowers_le.mpr ?_)
  exact normalizer_inf_normalizer_le_normalizer_sup _ _
    ⟨c.firstOuter.mem_normalizer, c.secondOuter.mem_normalizer⟩

/-- The quotient over the two factors is cyclic, directly from the source's
generation statement. -/
theorem OuterSixThreeCase.quotient_isCyclic (c : OuterSixThreeCase ρ)
    [hn : (c.first ⊔ c.second).Normal] : IsCyclic (D ⧸ (c.first ⊔ c.second)) := by
  let q := QuotientGroup.mk' (c.first ⊔ c.second)
  apply isCyclic_iff_exists_zpowers_eq_top.mpr
  refine ⟨q c.element, ?_⟩
  have h := congrArg (Subgroup.map q) c.generates
  rw [Subgroup.map_sup, QuotientGroup.map_mk'_self, bot_sup_eq,
    MonoidHom.map_zpowers,
    Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective _)] at h
  exact h

/-- B.5.6(2) eliminates the three-prime core through the actual S₃ model. -/
theorem SymmetricThreeCase.threePrimeCore_eq_bot (c : SymmetricThreeCase ρ) :
    pPrimeCore 3 D = ⊥ :=
  pPrimeCore_eq_bot_of_equiv c.equiv Theory.SpecificGroups.symmetricThree_threePrimeCore

variable [Finite D]

/-- B.5.6(4), using exactly the generation and two-core hypotheses of B.5.3. -/
theorem OuterSixThreeCase.threePrimeCore_eq_bot (c : OuterSixThreeCase ρ)
    (hg : offenderSubgroup ρ = ⊤) (h₂ : pCore 2 D = ⊥) : pPrimeCore 3 D = ⊥ := by
  let := c.product_normal
  have hfirst : pPrimeCore 3 c.first = ⊥ := pPrimeCore_eq_bot_of_equiv c.firstEquiv
    Theory.SpecificGroups.alternatingSix_threePrimeCore
  have hsecond : pPrimeCore 3 c.second = ⊥ := pPrimeCore_eq_bot_of_equiv c.secondEquiv
    Theory.SpecificGroups.cyclicThree_threePrimeCore
  have hN : pPrimeCore 3 (c.first ⊔ c.second : Subgroup D) = ⊥ :=
    pPrimeCore_eq_bot_of_equiv c.product.symm (pPrimeCore_prod_eq_bot hfirst hsecond)
  let := c.quotient_isCyclic
  let := IsCyclic.commGroup (α := D ⧸ (c.first ⊔ c.second))
  have hQ := abelian_image_isTwoGroup ρ (QuotientGroup.mk' (c.first ⊔ c.second))
    (QuotientGroup.mk'_surjective _) hg
  exact pPrimeCore_eq_bot_of_pCore_eq_bot_of_quotient (p := 3) (q := 2)
    (c.first ⊔ c.second) hN hQ h₂

omit ρ in
/-- The quasisimple branch reduces to center and order facts about its
listed model, reusing quasisimplicity already supplied by B.5.6(1). -/
theorem threePrimeCore_eq_bot_of_quasisimple_model_facts
    [IsQuasisimple (generalizedFitting D)]
    (hZ : IsPGroup 3 (center (generalizedFitting D)))
    (hthree : 3 ∣ Nat.card (generalizedFitting D)) : pPrimeCore 3 D = ⊥ := by
  apply pPrimeCore_eq_bot_of_selfCentralizing (generalizedFitting D)
    (IsQuasisimple.pPrimeCore_eq_bot hZ hthree)
  exact ChapterB.QuasisimpleSections.centralizer_generalizedFitting_le

end CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison.FFAlternatives
