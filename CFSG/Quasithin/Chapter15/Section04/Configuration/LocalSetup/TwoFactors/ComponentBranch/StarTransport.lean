module

public import CFSG.Quasithin.Chapter15.Section04.Configuration.LocalSetup.TwoFactors.ComponentBranch.AlternatingLocals.RawQuotient
public import Theory.GroupAction.InnerExtension

/-!
# From the actual automorphism extension to the star subgroup

After recognizing an A₆ component in a strongly quasithin group, its
centralizer is exactly O_{3′}(I). The conjugation map therefore embeds the
literal quotient I/O_{3′}(I) into Aut(A₆). Its image on L*Z* is precisely
the subgroup generated by inner automorphisms and the given Z-action.
Restricting that embedding yields the actual equivalence needed to transport
the S₆ recognition into the source quotient. No residual is used as a kernel.

Source: Aschbacher–Smith, combined 1 March 2004 manuscript, proof of 15.4.18,
printed pp.1162–1163.
-/

@[expose] public section
open Subgroup
namespace CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.ComponentBranch
open AlternatingLocals.RawQuotient
open AlternatingSix.ShadowLocal
variable {I : Type*} [Group I] [Finite I]

/-- Transport the actual inner extension to L*Z*, using the source star map
I → I/O_{3'}(I). The kernel is derived after recognizing L as A₆. -/
theorem selected_join_equiv_innerExtension
    (hI : IsStronglyQuasithin I) (L Z : Subgroup I)
    (hL : Theory.GroupTheory.IsComponent I L) (eL : L ≃* alternatingGroup (Fin 6))
    (ρ : Z →* MulAut L)
    (heval : ∀ z : Z, ∀ l : L, (ρ z l : I) = (z : I) * l * (z : I)⁻¹) :
    Nonempty (selectedJoin L Z ≃* MulAut.innerExtension ρ) := by
  let : L.Normal := component_normal hI L hL eL
  let f := conjugationAction L eL
  have hk : pPrimeCore 3 I = f.ker :=
    (core_eq_centralizer hI L hL eL).trans (conjugationAction_ker L eL).symm
  let ψ := QuotientGroup.lift (pPrimeCore 3 I) f hk.le
  have hψ : Function.Injective ψ :=
    (QuotientGroup.injective_lift_iff _ _ _).mpr hk
  have hcomp : ψ.comp (QuotientGroup.mk' (pPrimeCore 3 I)) = f :=
    QuotientGroup.lift_comp_mk' _ _ _
  let σ := (MulAut.congr eL).toMonoidHom.comp ρ
  have hact : f.comp Z.subtype = σ := by
    apply MonoidHom.ext
    intro z
    apply MulEquiv.ext
    intro x
    obtain ⟨l, rfl⟩ := eL.surjective x
    change f (z : I) (eL l) = eL (ρ z (eL.symm (eL l)))
    rw [eL.symm_apply_apply, conjugationAction_apply]
    apply congrArg eL
    apply Subtype.ext
    exact (heval z l).symm
  have hZmap : Z.map f = σ.range := by
    rw [← hact, MonoidHom.range_comp, Z.range_subtype]
  have hm : (selectedJoin L Z).map ψ = MulAut.innerExtension σ := by
    rw [selectedJoin, Subgroup.map_sup, starImage, starImage,
      Subgroup.map_map, Subgroup.map_map, hcomp, hZmap]
    rw [show L.map f = AlternatingSix.ShadowLocal.inner from conjugationAction_map_inner L eL]
    rfl
  exact ⟨((selectedJoin L Z).equivMapOfInjective ψ hψ).trans
    ((MulEquiv.subgroupCongr hm).trans (MulAut.innerExtensionCongr eL ρ).symm)⟩

end CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.ComponentBranch
