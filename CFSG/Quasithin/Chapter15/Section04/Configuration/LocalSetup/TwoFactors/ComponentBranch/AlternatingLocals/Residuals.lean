module

public import CFSG.Quasithin.Chapter15.Section04.Configuration.LocalSetup.TwoFactors.ComponentBranch.AlternatingLocals.Containment
public import Theory.GroupTheory.PResidual.PrimeTo
/-!
# The three-prime residual in the surviving component case

A₆ is generated by three-cycles, so its three-prime residual is the whole
group. Compatible component coordinates transport this generation and make
I/L a two-group, yielding O^{3′}(I) = L. The proof keeps this residual
separate from the core O_{3′}(I) used in the star quotient.

Source: Aschbacher–Smith 15.4.18, combined manuscript, printed p.1163.
-/

@[expose] public section

open Subgroup
open Theory.SpecificGroups.SymmetricSix
namespace CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.ComponentBranch.AlternatingLocals.QuotientCoordinates

private theorem alternating_primeToResidual : primeToResidual 3 A6 = ⊤ := by
  apply top_unique
  rw [← alternatingGroup.closure_isThreeCycles_eq_top, closure_le]
  intro a ha
  apply mem_primeToResidual_of_pow (n := 1)
  apply Subtype.ext
  change (a : S6) ^ (3 ^ 1) = 1
  rw [pow_one, ← ha.orderOf]
  exact pow_orderOf_eq_one _

/-- The three-prime residual is the embedded A₆ component, distinct from
the three-prime core used to define the star quotient. -/
theorem component_eq_primeToResidual
    {I : Type*} [Group I] [Finite I] {L : Subgroup I} (d : QuotientCoordinates L) :
    L = primeToResidual 3 I := by
  let : L.Normal := d.component_normal
  have hLres : primeToResidual 3 L = ⊤ := by
    apply d.componentEquiv.mapSubgroup.injective
    change (primeToResidual 3 L).map d.componentEquiv.toMonoidHom =
      (⊤ : Subgroup L).map d.componentEquiv.toMonoidHom
    rw [map_primeToResidual, alternating_primeToResidual, map_top_of_surjective _
      d.componentEquiv.surjective]
  apply le_antisymm
  · apply le_sInf
    rintro N ⟨hN, hcop⟩
    let : N.Normal := hN
    have hkill := primeToResidual_le_ker
      ((QuotientGroup.mk' N).comp L.subtype) (p := 3)
      (by rwa [← N.index_eq_card])
    rw [hLres] at hkill
    intro l hl
    have he : QuotientGroup.mk' N l = 1 := hkill (show (⟨l, hl⟩ : L) ∈ ⊤ from trivial)
    exact (QuotientGroup.eq_one_iff l).mp he
  · apply primeToResidual_le
    obtain ⟨n, hn⟩ := d.quotient_component_isTwoGroup.exists_card_eq
    rw [index_eq_card, hn]
    exact (by decide : Nat.Coprime 3 2).pow_right n

end CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.ComponentBranch.AlternatingLocals.QuotientCoordinates
