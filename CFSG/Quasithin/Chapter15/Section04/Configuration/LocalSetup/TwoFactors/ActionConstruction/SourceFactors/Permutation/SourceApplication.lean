module

public import CFSG.Quasithin.Chapter15.Section04.Centralizer.Family.SourceConstruction.ModuleStructure.FaithfulMoved.BaumannPair.SourceControl

/-!
# Actual residual factors for the double case of 15.4.12

The faithful moved-module theorem constructs the quotient pair from the genuine
prior source input. The pair is kept inside the original quotient M/O₂(M). Its factors
are lifted by the two-residual of their preimages. This identifies the
generated group with the specified member X, preserves the actual modules
Vᵢ=[V(M),Lᵢ], and gives the index-two stabilizer used in 15.4.18.

The proved Baumann action on the same intrinsic pair gives individual
S-invariance. Whole-group Thompson commutator saturation descends to both
distinct cubic factors and then lifts to the residuals. These assertions use
the actual S=Baum(T) and J(T), with no individual T-invariance assertion.
This module lies above ModuleStructure; the lower residual and permutation
modules do not import it.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), 15.4.12(6),
printed pp.1160–1161, and the opening paragraph of 15.4.18, p.1162.
-/

@[expose] public section
open Subgroup
open scoped Pointwise IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.SourceFactors.Permutation.SourceApplication
open FamilySource FamilySource.ModuleStructure
variable {G : Type*} [Group G] [Finite G]

/-- The intrinsic quotient pair, with its original quotient and actual
ambient interchange retained. It is the output of the source application. -/
structure QuotientPair (T : Sylow 2 G) (M X : Subgroup G) where
  line : Bool → Subgroup (CoreQuotient M)
  card : ∀ i, Nat.card (line i) = 3
  distinct : Function.Injective line
  generate : line false ⊔ line true = image M X
  permuted : ∀ (m : M) i, ∃ j,
    (line i).map (MulAut.conj (quotientMap M m)).toMonoidHom = line j
  interchange : ∃ t ∈ (T : Subgroup G),
    (liftedFactors M (quotientMap M) line false).map (MulAut.conj t).toMonoidHom =
      liftedFactors M (quotientMap M) line true ∧
    (liftedFactors M (quotientMap M) line true).map (MulAut.conj t).toMonoidHom =
      liftedFactors M (quotientMap M) line false ∧
    t ∉ normalizer (liftedFactors M (quotientMap M) line false : Set G)

/-- The specified residual lifts, not a newly selected pair of ambient groups. -/
def QuotientPair.factor {T : Sylow 2 G} {M X : Subgroup G}
    (d : QuotientPair T M X) : Bool → Subgroup G :=
  liftedFactors M (quotientMap M) d.line

/-- The actual source module Vᵢ. -/
def QuotientPair.moduleFactor {T : Sylow 2 G} {M X : Subgroup G}
    (d : QuotientPair T M X) (i : Bool) : Subgroup G :=
  ⁅localV T M, d.factor i⁆

omit [Finite G] in
private theorem quotient_kernel (M : Subgroup G) :
    IsPGroup 2 (quotientMap M).ker := by
  rw [quotientMap, QuotientGroup.ker_mk']
  exact pCore_isPGroup

private theorem member_subgroupOf_perfect {K : GroupClass} {T : Sylow 2 G}
    {M X : Subgroup G} {s : ℕ} (h : Input K T M X s) :
    IsPPerfect 2 (X.subgroupOf M) :=
  (YFamily.perfect h.member).of_surjective
    (subgroupOfEquivOfLe h.member_le).symm.toMonoidHom
    (subgroupOfEquivOfLe h.member_le).symm.surjective

private theorem quotient_normalizes {K : GroupClass} {T : Sylow 2 G}
    {M X : Subgroup G} {s : ℕ} (h : Input K T M X s)
    (d : QuotientPair T M X) (i : Bool) :
    image M X ≤ normalizer (d.line i : Set (CoreQuotient M)) := by
  let : IsElementaryAbelian 3 (image M X) := h.image_structure.1
  have hle : d.line i ≤ image M X := by
    rw [← d.generate]
    cases i
    · exact le_sup_left
    · exact le_sup_right
  exact ((image M X).le_centralizer.trans (centralizer_le hle)).trans
    (Subgroup.centralizer_le_normalizer _)

/-- The chosen member is generated by the two literal residual lifts. -/
theorem QuotientPair.factor_generate {K : GroupClass} {T : Sylow 2 G}
    {M X : Subgroup G} {s : ℕ} (h : Input K T M X s)
    (d : QuotientPair T M X) : d.factor false ⊔ d.factor true = X := by
  have hh := congrArg (Subgroup.map M.subtype)
    (residualPreimage_pair_join (quotientMap M) (QuotientGroup.mk'_surjective _)
      (quotient_kernel M) (X.subgroupOf M) (member_subgroupOf_perfect h)
      (core_normalizes T h.sylow_le (YFamily.invariant h.member))
      d.line d.card d.generate (quotient_normalizes h d))
  simpa only [factor, liftedFactors, Subgroup.map_sup,
    map_subgroupOf_eq_of_le h.member_le] using hh

/-- Each residual factor is normalized by the source member X. -/
theorem QuotientPair.factor_normalized {K : GroupClass} {T : Sylow 2 G}
    {M X : Subgroup G} {s : ℕ} (h : Input K T M X s)
    (d : QuotientPair T M X) (i : Bool) :
    X ≤ normalizer (d.factor i : Set G) := by
  simpa only [factor, map_subgroupOf_eq_of_le h.member_le] using
    liftedFactors_normalized M (quotientMap M) d.line (X.subgroupOf M) i
      (quotient_normalizes h d i)

/-- Each actual factor is two-perfect. -/
theorem QuotientPair.factor_perfect {T : Sylow 2 G} {M X : Subgroup G}
    (d : QuotientPair T M X) (i : Bool) : IsPPerfect 2 (d.factor i) :=
  liftedFactors_perfect M (quotientMap M) d.line i

/-- The intrinsic two-core quotient agrees elementwise with the original M quotient. -/
theorem QuotientPair.factor_quotient_compatible {T : Sylow 2 G} {M X : Subgroup G}
    (d : QuotientPair T M X) (i : Bool) :
    ∃ e : (d.factor i ⧸ pCore 2 (d.factor i)) ≃* d.line i,
      ∀ x : d.factor i,
        (e (QuotientGroup.mk' (pCore 2 (d.factor i)) x) : CoreQuotient M) =
          quotientMap M ⟨(x : G), map_subtype_le _ x.property⟩ :=
  liftedFactors_quotient_compatible M (quotientMap M) (QuotientGroup.mk'_surjective _)
    (quotient_kernel M) d.line i (d.card i)

/-- In particular both factor two-core quotients have order three. -/
theorem QuotientPair.factor_quotient_card {T : Sylow 2 G} {M X : Subgroup G}
    (d : QuotientPair T M X) (i : Bool) :
    Nat.card (d.factor i ⧸ pCore 2 (d.factor i)) = 3 :=
  (liftedFactors_quotient M (quotientMap M) (QuotientGroup.mk'_surjective _)
    (quotient_kernel M) d.line i (d.card i)).2

/-- The action on the residual lifts uses actual conjugation by M. -/
noncomputable def QuotientPair.action {T : Sylow 2 G} {M X : Subgroup G}
    (d : QuotientPair T M X) : MixedLocal.FactorPairAction M d.factor :=
  liftedFactors_action M (quotientMap M) (QuotientGroup.mk'_surjective _)
    d.line d.card d.distinct d.permuted

/-- The same action conjugates the actual modules [V(M),Lᵢ]. -/
theorem QuotientPair.module_conjugation {T : Sylow 2 G} {M X : Subgroup G}
    (d : QuotientPair T M X) (m : M) (i : Bool) :
    (d.moduleFactor i).map (MulAut.conj (m : G)).toMonoidHom =
      d.moduleFactor (d.action.permutation m i) := by
  change (⁅localV T M, d.factor i⁆).map _ = ⁅localV T M, _⁆
  have hn : (m : G) ∈ normalizer (localV (T : Subgroup G) M : Set G) :=
    localV_normalized (T : Subgroup G) M m.property
  have hv : (localV T M).map (MulAut.conj (m : G)).toMonoidHom = localV T M :=
    mem_normalizer_iff_map_conj_eq.mp hn
  rw [map_commutator, hv, d.action.conjugation]

private theorem residual_module_map (M V : Subgroup G) (hVM : V ≤ M)
    (hVN : M ≤ normalizer (V : Set G)) {Q : Type*} [Group Q]
    (q : M →* Q) (hq : Function.Surjective q) (A : Subgroup Q)
    (hA : Nat.card A = 3) (hkV : q.ker.map M.subtype ≤ centralizer (V : Set G)) :
    ⁅V, (residualPreimage q A).map M.subtype⁆ =
      ⁅V, (A.comap q).map M.subtype⁆ := by
  have hk : q.ker ≤ centralizer (V.subgroupOf M : Set M) := by
    intro c hc v hv
    exact Subtype.ext (hkV (mem_map.mpr ⟨c, hc, rfl⟩) (v : G) hv)
  let : (V.subgroupOf M).Normal := normal_subgroupOf_of_le_normalizer hVN
  have hn : A.comap q ≤ normalizer (V.subgroupOf M : Set M) := by
    rw [normalizer_eq_top]
    exact le_top
  have hh := congrArg (Subgroup.map M.subtype)
    (residualPreimage_module q hq A hA (V.subgroupOf M) hk hn)
  simpa only [map_commutator, map_subgroupOf_eq_of_le hVM] using hh

/-- Taking the residual does not change the original commutator module of
its quotient-factor preimage: the two-group kernel centralizes V(M). -/
theorem QuotientPair.module_preimage {K : GroupClass} {T : Sylow 2 G}
    {M X : Subgroup G} {s : ℕ} (h : Input K T M X s)
    (d : QuotientPair T M X) (i : Bool) :
    d.moduleFactor i = ⁅localV T M, ((d.line i).comap (quotientMap M)).map M.subtype⁆ := by
  have hcore : (quotientMap M).ker.map M.subtype ≤
      centralizer (localV (T : Subgroup G) M : Set G) := by
    rw [quotientMap, QuotientGroup.ker_mk']
    change M.pCoreIn 2 ≤ _
    rw [← localV_centralizer T M h.sylow_le h.center_centralizer]
    exact inf_le_right
  exact residual_module_map M (localV (T : Subgroup G) M)
    (localV_le (T : Subgroup G) M) (localV_normalized (T : Subgroup G) M)
    (quotientMap M) (QuotientGroup.mk'_surjective _) (d.line i) (d.card i) hcore

/-- The source product is a literal product of ambient subgroups. -/
theorem QuotientPair.factor_product {K : GroupClass} {T : Sylow 2 G}
    {M X : Subgroup G} {s : ℕ} (h : Input K T M X s)
    (d : QuotientPair T M X) :
    (X : Set G) = (d.factor false : Set G) * (d.factor true : Set G) := by
  simpa only [factor, map_subgroupOf_eq_of_le h.member_le] using
    liftedFactors_product M (quotientMap M) (QuotientGroup.mk'_surjective _)
      (quotient_kernel M) (X.subgroupOf M) (member_subgroupOf_perfect h)
      (core_normalizes T h.sylow_le (YFamily.invariant h.member)) d.line d.card
      d.generate (quotient_normalizes h d)

/-- The exact opening geometry of 15.4.18: an index-two stabilizer, a
generating factor, and the product with its actual T-conjugate. -/
theorem QuotientPair.source_stabilizer {K : GroupClass} {T : Sylow 2 G}
    {M X : Subgroup G} {s : ℕ} (h : Input K T M X s)
    (d : QuotientPair T M X) :
    ∃ t ∈ (T : Subgroup G),
      (d.factor false).map (MulAut.conj t).toMonoidHom = d.factor true ∧
      (d.factor true).map (MulAut.conj t).toMonoidHom = d.factor false ∧
      t ∉ normalizer (d.factor false : Set G) ∧
      (((T : Subgroup G) ⊓ normalizer (d.factor false : Set G)).relIndex T = 2) ∧
      d.factor false ⊔ (T : Subgroup G) = X ⊔ (T : Subgroup G) ∧
      (X : Set G) = (d.factor false : Set G) *
        ((d.factor false).map (MulAut.conj t).toMonoidHom : Set G) := by
  obtain ⟨t, ht, hs, hs', hn⟩ := d.interchange
  change (d.factor false).map (MulAut.conj t).toMonoidHom = d.factor true at hs
  refine ⟨t, ht, hs, hs', hn,
    (d.action.restrict h.sylow_le).stabilizer_index ht hn,
    MixedLocal.pair_join_eq_of_swap (d.factor_generate h) ht hs, ?_⟩
  rw [hs]
  exact d.factor_product h

/-- The restricted T-action on the actual factors is nontrivial. -/
theorem QuotientPair.action_nontrivial {K : GroupClass} {T : Sylow 2 G}
    {M X : Subgroup G} {s : ℕ} (h : Input K T M X s)
    (d : QuotientPair T M X) :
    (d.action.restrict h.sylow_le).permutation ≠ 1 := by
  obtain ⟨t, ht, _, _, hn⟩ := d.interchange
  let a := d.action.restrict h.sylow_le
  intro he
  have hk : (⟨t, ht⟩ : (T : Subgroup G)) ∈ a.permutation.ker := by
    change (d.action.restrict h.sylow_le).permutation ⟨t, ht⟩ = 1
    rw [he]
    rfl
  rw [a.kernel] at hk
  exact hn hk

/-- Construct the actual residual-factor coordinates from the genuine prior
source inputs and clause (3), using the proved faithful moved-module action.
No pair, permutation, transitivity or quotient-action premise is added. -/
theorem exists_quotientPair {K : GroupClass} {T : Sylow 2 G}
    {M X : Subgroup G} (h : Input K T M X 2) : Nonempty (QuotientPair T M X) := by
  obtain ⟨A, hcard, hinj, hgen, hperm, hswap⟩ := h.double_quotient_factors
  exact ⟨⟨A, hcard, hinj, hgen, hperm, hswap⟩⟩

/-- The actual source application supplies the residual pair and the
index-two factor-stabilizer geometry needed at the start of 15.4.18. -/
theorem source_double_factor_geometry {K : GroupClass} {T : Sylow 2 G}
    {M X : Subgroup G} (h : Input K T M X 2) :
    ∃ d : QuotientPair T M X,
      d.factor false ⊔ d.factor true = X ∧
      (∀ i, X ≤ normalizer (d.factor i : Set G) ∧
        IsPPerfect 2 (d.factor i) ∧
        Nat.card (d.factor i ⧸ pCore 2 (d.factor i)) = 3) ∧
      (d.action.restrict h.sylow_le).permutation ≠ 1 ∧
      ∃ t ∈ (T : Subgroup G),
        (d.factor false).map (MulAut.conj t).toMonoidHom = d.factor true ∧
        (d.factor true).map (MulAut.conj t).toMonoidHom = d.factor false ∧
        t ∉ normalizer (d.factor false : Set G) ∧
        (((T : Subgroup G) ⊓ normalizer (d.factor false : Set G)).relIndex T = 2) ∧
        d.factor false ⊔ (T : Subgroup G) = X ⊔ (T : Subgroup G) ∧
        (X : Set G) = (d.factor false : Set G) *
          ((d.factor false).map (MulAut.conj t).toMonoidHom : Set G) := by
  obtain ⟨d⟩ := exists_quotientPair h
  exact ⟨d, d.factor_generate h,
    fun i => ⟨d.factor_normalized h i, d.factor_perfect i, d.factor_quotient_card i⟩,
    d.action_nontrivial h, d.source_stabilizer h⟩

private theorem thompson_le_baumann (T : Subgroup G) :
    ChapterB.thompsonJ T 0 ≤ ChapterB.baumann T := by
  refine le_inf (ChapterB.thompsonJ_le _ _) ?_
  intro j hj
  apply mem_centralizer_iff.mpr
  intro a ha
  rw [ChapterB.thompsonAlpha_eq] at ha
  exact ((Stellmacher.mem_omegaOneCenterAmbient_iff _ _).mp ha).2.2 j hj |>.symm

/-- Baumann invariance of the quotient pair lifts the actual Thompson commutator identity. -/
theorem QuotientPair.factor_thompson_commutator {K : GroupClass} {T : Sylow 2 G}
    {M X : Subgroup G} (h : Input K T M X 2) (d : QuotientPair T M X)
    (hnS : ∀ i, ((ChapterB.baumann (T : Subgroup G)).subgroupOf M).map (quotientMap M) ≤
      normalizer (d.line i : Set (CoreQuotient M))) (i : Bool) :
    ⁅d.factor i, ChapterB.thompsonJ (T : Subgroup G) 0⁆ = d.factor i := by
  let J := (ChapterB.thompsonJ (T : Subgroup G) 0).subgroupOf M
  have hJM : ChapterB.thompsonJ (T : Subgroup G) 0 ≤ M :=
    (ChapterB.thompsonJ_le _ _).trans h.sylow_le
  have hJS : J ≤ (ChapterB.baumann (T : Subgroup G)).subgroupOf M := by
    intro j hj
    exact thompson_le_baumann _ hj
  have hc : ⁅X.subgroupOf M, J⁆ = X.subgroupOf M := by
    apply map_injective M.subtype_injective
    rw [map_commutator, map_subgroupOf_eq_of_le h.member_le,
      show J.map M.subtype = ChapterB.thompsonJ (T : Subgroup G) 0 from
        map_subgroupOf_eq_of_le hJM,
      ChapterB.thompsonJ_zero]
    exact YFamily.commutator_eq h.member
  have hh := congrArg (Subgroup.map M.subtype)
    (residualPreimage_pair_commutator (quotientMap M) (QuotientGroup.mk'_surjective _)
      (quotient_kernel M) (X.subgroupOf M) J d.line d.card d.distinct d.generate
      (quotient_normalizes h d) (fun i => (map_mono hJS).trans (hnS i)) hc i)
  simpa only [map_commutator, J, map_subgroupOf_eq_of_le hJM, QuotientPair.factor,
    liftedFactors] using hh

/-- The same source pair is individually Baumann-invariant and saturated by
J(T). The earlier action theorem supplies its S-invariance; the whole-member
family identity and distinct cubic quotient factors imply both commutators. -/
theorem exists_baumann_quotientPair {K : GroupClass} {T : Sylow 2 G}
    {M X : Subgroup G} (h : Input K T M X 2) :
    ∃ d : QuotientPair T M X, ∀ i,
      ChapterB.baumann (T : Subgroup G) ≤ normalizer (d.factor i : Set G) ∧
      ⁅d.factor i, ChapterB.thompsonJ (T : Subgroup G) 0⁆ = d.factor i := by
  obtain ⟨A, hcard, hinj, hgen, hperm, hnS, hnlift, hswap⟩ := h.double_quotient_baumann_factors
  let d : QuotientPair T M X := ⟨A, hcard, hinj, hgen, hperm, hswap⟩
  exact ⟨d, fun i => ⟨hnlift i, d.factor_thompson_commutator h hnS i⟩⟩

/-- All source factor algebra for 15.4.18, with the actual Baumann and
Thompson subgroups and the same pair's nontrivial T-action. -/
theorem source_double_factor_baumann_geometry {K : GroupClass} {T : Sylow 2 G}
    {M X : Subgroup G} (h : Input K T M X 2) :
    ∃ d : QuotientPair T M X,
      d.factor false ⊔ d.factor true = X ∧
      (∀ i, X ≤ normalizer (d.factor i : Set G) ∧
        ChapterB.baumann (T : Subgroup G) ≤ normalizer (d.factor i : Set G) ∧
        IsPPerfect 2 (d.factor i) ∧
        ⁅d.factor i, ChapterB.thompsonJ (T : Subgroup G) 0⁆ = d.factor i ∧
        Nat.card (d.factor i ⧸ pCore 2 (d.factor i)) = 3) ∧
      (d.action.restrict h.sylow_le).permutation ≠ 1 ∧
      (((T : Subgroup G) ⊓ normalizer (d.factor false : Set G)).relIndex T = 2) ∧
      d.factor false ⊔ (T : Subgroup G) = X ⊔ (T : Subgroup G) := by
  obtain ⟨d, hd⟩ := exists_baumann_quotientPair h
  obtain ⟨_, _, _, _, _, hindex, hjoin, _⟩ := d.source_stabilizer h
  exact ⟨d, d.factor_generate h,
    fun i => ⟨d.factor_normalized h i, (hd i).1, d.factor_perfect i,
      (hd i).2, d.factor_quotient_card i⟩,
    d.action_nontrivial h, hindex, hjoin⟩

end CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.SourceFactors.Permutation.SourceApplication
