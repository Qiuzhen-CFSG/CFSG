module

public import CFSG.Quasithin.Chapter15.Section04.Centralizer.Family.SourceConstruction.ModuleStructure.FaithfulMoved.Idempotence
/-!
# Actual residual-factor modules from their intrinsic actor lines

An equivariant action of a surjective actor image preserves the ambient
commutator exactly: both sides are generated by the same displacements.
For the source member X the preceding cubic idempotence theorem replaces
V(M) by [V(M),X], so the intrinsic factor's moved plane is the literal
ambient subgroup [V(M),L]. In particular a subgroup L mapping to one of
the intrinsic cubic factors has an actual four-element module.

The source-factor consumer retains the original projection and discharges
its actor-image identity with the two-residual preimage calculation.
Source: Aschbacher--Smith 15.4.12(6), printed pp.1160--1161,
combined manuscript of 1 March 2004.
-/

@[expose] public section

open Subgroup Stellmacher
open scoped commutatorElement
namespace CFSG.Quasithin.Chapter15.Section04.FamilySource.ModuleStructure
/-- A surjective actor image keeps its exact ambient commutator subgroup. -/
theorem commutatorAction_image_map {G A : Type*} [Group G] [Group A]
    (X W L : Subgroup G) (q : X →* A) (ρ : A →* MulAut W)
    (hLX : L ≤ X) (D : Subgroup A) (hD : (L.subgroupOf X).map q = D)
    (hρ : ∀ (x : X) (w : W), (ρ (q x) w : G) = (x : G) * (w : G) * (x : G)⁻¹) :
    letI := MulDistribMulAction.compHom W ρ
    (commutatorAction D W).map W.subtype = ⁅W,L⁆ := by
  let _ := MulDistribMulAction.compHom W ρ
  apply le_antisymm
  · rw [commutatorAction_eq_closure, MonoidHom.map_closure]
    apply (closure_le _).mpr
    rintro z ⟨_, ⟨d,w,rfl⟩,rfl⟩
    obtain ⟨x,hx,hxd⟩ := hD.ge d.property
    change (w : G)⁻¹ * (ρ (d : A) w : G) ∈ ⁅W,L⁆
    rw [←hxd,hρ]
    have hxL : (x : G) ∈ L := hx
    simpa only [commutatorElement_def,inv_inv,mul_assoc] using
      commutator_mem_commutator (W.inv_mem w.property) hxL
  · apply commutator_le.mpr
    intro w hw x hx
    let xx : X := ⟨x,hLX hx⟩
    have hqx : q xx ∈ D := hD.le (mem_map.mpr ⟨xx,hx,rfl⟩)
    let ww : W := ⟨w⁻¹,W.inv_mem hw⟩
    have hz : ww⁻¹ * ((⟨q xx,hqx⟩ : D) • ww) ∈ commutatorAction D W := by
      rw [commutatorAction_eq_closure]
      exact subset_closure ⟨⟨q xx,hqx⟩,ww,rfl⟩
    refine mem_map.mpr ⟨_,hz,?_⟩
    change (w⁻¹)⁻¹ * (ρ (q xx) ww : G) = ⁅w,x⁆
    rw [hρ]
    simp only [xx,ww,inv_inv,commutatorElement_def,mul_assoc]
open BinaryNormalizer

/-- The intrinsic moved subgroup is literally the original residual-factor
module whenever its actor image is the specified factor. -/
theorem Input.factor_module_eq {G : Type*} [Group G] [Finite G]
    {K : GroupClass} {T : Sylow 2 G} {M X : Subgroup G} {s : ℕ}
    (h : Input K T M X s)
    (ρ : image M X →* MulAut (movedModule (T : Subgroup G) M X))
    (hρ : ∀ (x : X) (w : movedModule (T : Subgroup G) M X),
      (ρ (memberProjection M X h.member_le x) w : G) =
        (x : G) * (w : G) * (x : G)⁻¹)
    (L : Subgroup G) (hLX : L ≤ X) (D : Subgroup (image M X))
    (hD : (L.subgroupOf X).map (memberProjection M X h.member_le) = D) :
    letI := MulDistribMulAction.compHom (movedModule (T : Subgroup G) M X) ρ
    (commutatorAction D (movedModule (T : Subgroup G) M X)).map
      (movedModule (T : Subgroup G) M X).subtype = ⁅localV T M,L⁆ := by
  rw [h.moved_commutator_stable L hLX]
  exact commutatorAction_image_map X (movedModule (T : Subgroup G) M X) L
    (memberProjection M X h.member_le) ρ hLX D hD hρ

/-- The actual source module attached to a lifted intrinsic factor has four
elements, not merely the same dimension as an abstract model. -/
theorem Input.factor_module_card {G : Type*} [Group G] [Finite G]
    {K : GroupClass} {T : Sylow 2 G} {M X : Subgroup G}
    (h : Input K T M X 2)
    (ρ : image M X →* MulAut (movedModule (T : Subgroup G) M X))
    (hρ : ∀ (x : X) (w : movedModule (T : Subgroup G) M X),
      (ρ (memberProjection M X h.member_le x) w : G) =
        (x : G) * (w : G) * (x : G)⁻¹) :
    letI := MulDistribMulAction.compHom (movedModule (T : Subgroup G) M X) ρ
    ∀ (P : FactorPair (A := image M X) (W := movedModule (T : Subgroup G) M X))
      (i : Bool) (L : Subgroup G) (_hLX : L ≤ X),
      (L.subgroupOf X).map (memberProjection M X h.member_le) = P.line i →
      Nat.card (⁅localV T M,L⁆ : Subgroup G) = 4 := by
  let W := movedModule (T : Subgroup G) M X
  let _ := MulDistribMulAction.compHom W ρ
  let : IsElementaryAbelian 3 (image M X) := h.image_structure.1
  let : IsElementaryAbelian 2 W := h.moved_elementary
  intro P i L hLX hD
  rw [←h.factor_module_eq ρ hρ L hLX (P.line i) hD,
    card_map_of_injective W.subtype_injective]
  exact (P.moved_decomposition (by simpa using h.moved_card)).1 i

end CFSG.Quasithin.Chapter15.Section04.FamilySource.ModuleStructure
