module
public import CFSG.Quasithin.Chapter15.Section04.Centralizer.Witness.SupercriticalNineSource.UpperXi
public import CFSG.Quasithin.Chapter15.Section04.Centralizer.Family.SourceConstruction.Construction
/-!
# Residual lifts of the selected cubic source subgroup

A normal elementary cubic quotient of order three or nine, irreducible under
actual Sylow conjugation and generated by its Thompson commutators, lifts to
the original Y-family. The order-three case uses lowercase Xi; the order-nine
case transports the genuine iterated Frattini action into uppercase Xi.
Characteristic two supplies the required nontrivial local two-core.

Source: Aschbacher--Smith, 15.4.12, printed pp.1160--1161.
-/

public section
open Subgroup Stellmacher
namespace CFSG.Quasithin.Chapter15.Section04.FamilySource.ThompsonFactors
open CentralizerWitness.SupercriticalNineSource
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
/-- Irreducibility in the original quotient gives the exact action on the
Frattini quotient used in the uppercase family definition. -/
theorem irreducible_frattini_of_quotient_subgroups
    (T : Sylow 2 G) (M : Subgroup G) (hTM : (T : Subgroup G) ≤ M)
    (P : Subgroup (CoreQuotient M)) [P.Normal]
    (hirr : ∀ C : Subgroup (CoreQuotient M), C ≤ P →
      image M (T : Subgroup G) ≤ normalizer (C : Set (CoreQuotient M)) → C = ⊥ ∨ C = P) :
    ∀ B : Subgroup (P ⧸ frattini P),
      (∀ t : T, ∀ b ∈ B, quotientAut (frattini P)
        (MulAut.conjNormal (quotientMap M (inclusion hTM t))) b ∈ B) → B = ⊥ ∨ B = ⊤ := by
  intro B hB
  let q := QuotientGroup.mk' (frattini P)
  let C := (B.comap q).map P.subtype
  have hCP : C ≤ P := map_subtype_le _
  have hnorm : image M (T : Subgroup G) ≤ normalizer (C : Set (CoreQuotient M)) := by
    apply le_normalizer_iff.mpr
    rintro _ ⟨m,hm,rfl⟩ _ ⟨p,hp,rfl⟩
    refine mem_map.mpr ⟨MulAut.conjNormal (quotientMap M m) p, ?_, rfl⟩
    have ht := hB (⟨m,hm⟩ : T) (q p) hp
    change quotientAut (frattini P) (MulAut.conjNormal (quotientMap M m))
      (QuotientGroup.mk' (frattini P) p) ∈ B at ht
    rw [quotientAut_apply_mk] at ht
    exact ht
  rcases hirr C hCP hnorm with hb | ht
  · left
    apply le_bot_iff.mp
    intro b hbB
    obtain ⟨p,rfl⟩ := QuotientGroup.mk'_surjective (frattini P) b
    have hp : (p : CoreQuotient M) ∈ C := mem_map.mpr ⟨p,hbB,rfl⟩
    have hp1 : p = 1 := Subtype.ext (mem_bot.mp (hb ▸ hp))
    simpa only [hp1, map_one] using (one_mem (⊥ : Subgroup (P ⧸ frattini P)))
  · right
    apply top_unique
    intro b _
    obtain ⟨p,rfl⟩ := QuotientGroup.mk'_surjective (frattini P) b
    have hp : (p : CoreQuotient M) ∈ C := ht.symm ▸ p.property
    obtain ⟨y,hy,he⟩ := hp
    have hye : y = p := Subtype.ext he
    exact hye ▸ hy

/-- Construct a genuine source member from the selected cubic quotient. -/
theorem normal_elementary_lift_mem_Y
    (T : Sylow 2 G) (M : Subgroup G) (hTM : (T : Subgroup G) ≤ M)
    (hEC : HasCharacteristicTwo M) (P : Subgroup (CoreQuotient M)) [P.Normal]
    [IsElementaryAbelian 3 P] {s : ℕ} (hs : s = 1 ∨ s = 2)
    (hc : Nat.card P = 3 ^ s)
    (hirr : ∀ C : Subgroup (CoreQuotient M), C ≤ P →
      image M (T : Subgroup G) ≤ normalizer (C : Set (CoreQuotient M)) → C = ⊥ ∨ C = P)
    (hcomm : ⁅P, image M (elementaryAbelianMaxJ (T : Subgroup G))⁆ = P) :
    lift M P ∈ Y (T : Subgroup G) := by
  have hp : IsPPerfect 2 P := by
    apply (pResidual_eq_top_iff 2 P).mp
    apply top_unique
    intro x _
    exact mem_pResidual_of_orderOf_coprime
      (((IsElementaryAbelian.isPGroup 3 P).orderOf_coprime (by decide : Nat.Coprime 3 2) x).symm)
  rcases hs with rfl | rfl
  · exact normal_prime_lift_mem_Y (T : Subgroup G) M hTM hEC P (by simpa only [pow_one] using hc)
      inferInstance hcomm
  · have hPn : P ≠ ⊥ := by
      intro hb
      rw [hb, card_bot] at hc
      norm_num at hc
    have hLn : lift M P ≠ ⊥ := by
      intro hb
      have hi := image_lift M P hp
      rw [hb, image, bot_subgroupOf, Subgroup.map_bot] at hi
      exact hPn hi.symm
    have hcore := coreIn_ne_bot_of_normal hEC hLn (lift_le M P) (lift_normal M P inferInstance)
    have hnL : M ≤ normalizer (lift M P : Set G) :=
      (normal_subgroupOf_iff_le_normalizer (lift_le M P)).mp (lift_normal M P inferInstance)
    have hcoreM : M.pCoreIn 2 ≠ ⊥ := by
      intro hb
      apply hcore
      apply le_bot_iff.mp
      rw [← hb]
      apply le_pCoreIn_of_normalizes (isPGroup_pCoreIn 2 _)
        ((pCoreIn_le 2 _).trans (lift_le M P))
      exact hnL.trans (normalizer_le_normalizer_characteristic_image _ (pCore 2 (lift M P)))
    refine ⟨Or.inl (normal_lift_mem_upper_Xi T M hTM hcoreM P hp
      ⟨3, Nat.prime_three, by decide, Or.inl ⟨inferInstance, hc⟩⟩
      (irreducible_frattini_of_quotient_subgroups T M hTM P hirr)), ?_⟩
    apply Eq.symm
    apply lift_commutator M _ ((show elementaryAbelianMaxJ (T : Subgroup G) ≤ T from
      sSup_le fun _ h => h.1).trans hTM) P hp
    · rw [normalizer_eq_top]
      exact le_top
    · exact hcomm

end CFSG.Quasithin.Chapter15.Section04.FamilySource.ThompsonFactors
