module
public import CFSG.Quasithin.Chapter15.Section04.Centralizer.Family.SourceConstruction.ThompsonFactors.Selection
public import Theory.GroupTheory.PResidual.NormalClosureCover
public import Stellmacher.ElementaryAbelianMaxGlobal

/-!
# All normalized subgroups of the actual cubic product

A two-perfect subgroup generated by its Thompson commutators lies in the
global Thompson subgroup, hence in the actual alternating cubic product.
Independent factor involutions show that every nontrivial Sylow-normalized
subgroup of this product is a coordinate cubic or the full product. The
Sylow subgroup realizes the full factor permutation image, so either
possibility is normal in the original star quotient.

Source: Aschbacher–Smith 15.4.12, printed pp.1160–1161.
-/

public noncomputable section
open Subgroup Stellmacher
namespace CFSG.Quasithin.Chapter15.Section04.FamilySource.ThompsonFactors
open Chapter1.RadicalNormalizers.ThompsonSource
variable {H : Type*} [Group H] [Finite H] {S : Sylow 2 H}
  [IsElementaryAbelian 2 (Chapter1.RadicalNormalizers.ThompsonSource.closure S)]

theorem perfect_commutator_image_le_cubicProduct (d : Exceptional S)
    (hc : d.count = 1 ∨ d.count = 2) (Y : Subgroup H) (hp : IsPPerfect 2 Y)
    (hj : Y = ⁅Y,elementaryAbelianMaxJ (S : Subgroup H)⁆) :
    Y.map (starMap (Chapter1.RadicalNormalizers.ThompsonSource.closure S)) ≤ cubicProduct d Finset.univ := by
  let J := elementaryAbelianMaxJ (⊤ : Subgroup H)
  let : J.Characteristic := elementaryAbelianMaxJ_top_characteristic
  have hYJ : Y ≤ J := by
    rw [hj]
    exact (commutator_mono le_top (elementaryAbelianMaxJ_sylow_le_top S)).trans
      (commutator_le_right ⊤ J)
  let A := Y.map (starMap (Chapter1.RadicalNormalizers.ThompsonSource.closure S))
  have hAp : IsPPerfect 2 A := hp.of_surjective
    ((starMap (Chapter1.RadicalNormalizers.ThompsonSource.closure S)).subgroupMap Y)
    ((starMap (Chapter1.RadicalNormalizers.ThompsonSource.closure S)).subgroupMap_surjective Y)
  have hAJ : A ≤ thompsonImage (S := S) := map_mono hYJ
  let := cubicProduct_normal d
  have hS2 : IsPGroup 2 (sylowImage (S := S)) :=
    (S.isPGroup'.to_le (sSup_le fun _ h => h.1)).map _
  have hr := embedded_pResidual_le_of_normal_sup_pGroup (cubicProduct d Finset.univ)
    (sylowImage (S := S)) A hS2 (hAJ.trans_eq (cubicProduct_sylow_sup d hc).symm)
  rw [(pResidual_eq_top_iff 2 A).mpr hAp, ← MonoidHom.range_eq_map, range_subtype] at hr
  exact hr

theorem normalized_cubic_subgroup (d : Exceptional S) (hc : d.count = 1 ∨ d.count = 2)
    (C : Subgroup (Star (S := S))) (hC : C ≤ cubicProduct d Finset.univ)
    (hne : C ≠ ⊥) (hn : sylowStar (S := S) ≤ normalizer (C : Set (Star (S := S)))) :
    ∃ I : Finset (Fin d.count), (I.card = 1 ∨ I.card = 2) ∧ C = cubicProduct d I ∧ C.Normal := by
  classical
  have hI : (Finset.univ : Finset (Fin d.count)).card = 1 ∨
      (Finset.univ : Finset (Fin d.count)).card = 2 := by
    simpa only [Finset.card_univ,Fintype.card_fin] using hc
  have hcard := card_dvd_of_le hC
  rw [cubicProduct_card d Finset.univ hI] at hcard
  obtain ⟨k,hk,hkcard⟩ := (Nat.dvd_prime_pow Nat.prime_three).mp hcard
  have hk2 : k ≤ 2 := by rcases hI with hI | hI <;> omega
  interval_cases k
  · exact (hne (card_eq_one.mp hkcard)).elim
  · have hc3 : Nat.card C = 3 := hkcard
    rcases hI with hI | hI
    · have he : C = cubicProduct d Finset.univ := eq_of_le_of_card_ge hC (by
        rw [cubicProduct_card d Finset.univ (Or.inl hI),hI,hc3]; rfl)
      exact ⟨Finset.univ,Or.inl hI,he,he.symm ▸ cubicProduct_normal d⟩
    · obtain ⟨i,j,hij,hijall⟩ := Finset.card_eq_two.mp hI
      rcases cubic_line_eq_factor d i j hij hijall C hC hc3 hn with he | he
      · refine ⟨{i},Or.inl (Finset.card_singleton _),?_,?_⟩
        · simpa only [cubicProduct,Finset.sup_singleton] using he
        · exact he.symm ▸ cubicFactor_normal_of_sylow_normalized d hc i (he ▸ hn)
      · refine ⟨{j},Or.inl (Finset.card_singleton _),?_,?_⟩
        · simpa only [cubicProduct,Finset.sup_singleton] using he
        · exact he.symm ▸ cubicFactor_normal_of_sylow_normalized d hc j (he ▸ hn)
  · have he : C = cubicProduct d Finset.univ := eq_of_le_of_card_ge hC (by
      rw [cubicProduct_card d Finset.univ hI,hkcard]
      exact Nat.pow_le_pow_right (by decide) (by rcases hI with hI | hI <;> omega))
    exact ⟨Finset.univ,hI,he,he.symm ▸ cubicProduct_normal d⟩

end CFSG.Quasithin.Chapter15.Section04.FamilySource.ThompsonFactors
