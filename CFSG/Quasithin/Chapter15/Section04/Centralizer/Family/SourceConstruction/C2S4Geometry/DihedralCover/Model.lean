module
public import CFSG.Quasithin.Chapter15.Section04.Centralizer.Family.SourceConstruction.C2S4Geometry.Central
public import Theory.SpecificGroups.SymmetricFourResidualCore
public import Theory.GroupTheory.PCoreProduct
public import Mathlib.Tactic

/-!
# Coordinates for the dihedral cover in 15.4.13

The square action embeds C₂ × D₈ as a Sylow subgroup of C₂ × S₄.
Inside it, the identity-first-coordinate D₈ is generated by a reflection
and the Klein four group. Its central intersection is the Frattini subgroup,
and its involutions lie in the two ambient classes of a transposition and a
double transposition.

The residual core is identified in the same coordinates: projection kills
its C₂ coordinate, while the Klein four group belongs to the two-residual
by the proved S₄ calculation. Normality bounds its core by the ambient core.
Only element identities and explicit conjugators use finite kernel checks.
The square action follows `Theory.SpecificGroups.SymmetricFourSylow`.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
Lemma 15.4.13, printed p.1161. The importing construction transports these
coordinates through an ambient equivalence and Sylow conjugacy.
-/

@[expose] public section
open Subgroup
namespace CFSG.Quasithin.Chapter15.Section04.FamilySource.C2S4Geometry.CoverModel
abbrev C := Multiplicative (ZMod 2)
abbrev D := DihedralGroup 4
abbrev S := C × D
abbrev M := C × Equiv.Perm (Fin 4)

def squarePermutation : D → Equiv.Perm (Fin 4)
  | .r i => finRotate 4 ^ i.val
  | .sr i => Equiv.swap 1 3 * finRotate 4 ^ i.val
set_option maxRecDepth 10000 in
def squareEmbedding : D →* Equiv.Perm (Fin 4) where
  toFun := squarePermutation
  map_one' := by decide +kernel
  map_mul' := by decide +kernel
set_option maxRecDepth 10000 in
theorem squareEmbedding_injective : Function.Injective squareEmbedding := by decide +kernel

def j : S →* M := (MonoidHom.id C).prodMap squareEmbedding

theorem j_injective : Function.Injective j := by
  intro x y h
  exact Prod.ext (by simpa [j] using congrArg Prod.fst h)
    (squareEmbedding_injective (by simpa [j] using congrArg Prod.snd h))

def t : S := (1, .sr 0)
def z : S := (1, .r 2)
def R : Subgroup S := (MonoidHom.fst C D).ker
instance : DecidablePred (· ∈ R) := fun x => inferInstanceAs (Decidable (x.1 = 1))

instance : DecidablePred (· ∈ center S ⊓ R) := fun x =>
  inferInstanceAs (Decidable (x ∈ center S ∧ x ∈ R))

def rEquiv : R ≃* D where
  toFun x := x.val.2
  invFun d := ⟨(1,d), rfl⟩
  left_inv x := Subtype.ext (Prod.ext x.property.symm rfl)
  right_inv _ := rfl
  map_mul' _ _ := rfl

theorem card_S : Nat.card S = 16 := by
  norm_num [Nat.card_prod, Nat.card_eq_fintype_card, DihedralGroup.card]
theorem card_M : Nat.card M = 48 := by
  norm_num [Nat.card_prod, Nat.card_eq_fintype_card, Fintype.card_perm, Nat.factorial]
theorem card_R : Nat.card R = 8 := by
  rw [Nat.card_congr rEquiv.toEquiv]
  norm_num [Nat.card_eq_fintype_card, DihedralGroup.card]
theorem index_R : R.index = 2 := by
  have h := R.card_mul_index
  rw [card_R, card_S] at h
  omega

noncomputable def sylow : Sylow 2 M := Sylow.ofCard j.range (by
  have hc : Nat.card j.range = 16 :=
    (Nat.card_congr (MonoidHom.ofInjective j_injective).symm.toEquiv).trans card_S
  rw [hc, card_M]
  rw [show 48 = 2 ^ 4 * 3 by norm_num,
    Nat.factorization_mul (by norm_num) (by norm_num), Nat.factorization_pow]
  norm_num [Nat.prime_two.factorization, Nat.prime_three.factorization])

theorem t_order : orderOf t = 2 := orderOf_eq_prime (by decide) (by decide)
theorem z_order : orderOf z = 2 := orderOf_eq_prime (by decide) (by decide)

theorem center_inter : center S ⊓ R = frattini S := by
  have hp : IsPGroup 2 S := IsPGroup.of_card (n := 4) card_S
  have hle : frattini S ≤ center S ⊓ R := by
    rw [hp.frattini_eq_closure_squares]
    apply (closure_le _).mpr
    rintro x ⟨y, rfl⟩
    exact (show ∀ y : S, y ^ 2 ∈ center S ⊓ R by decide +kernel) y
  apply (eq_of_le_of_card_ge hle ?_).symm
  rw [frattini_card_two (MulEquiv.refl S)]
  have hc : Nat.card (center S ⊓ R : Subgroup S) = 2 := by
    rw [Nat.card_eq_fintype_card]
    decide +kernel
  exact hc.le

theorem z_mem_frattini : z ∈ frattini S := by
  rw [← center_inter]
  decide +kernel

abbrev K := Theory.SpecificGroups.SymmetricSix.DuadCalculation.core
def B : Subgroup M := (⊥ : Subgroup C).prod K
instance : DecidablePred (· ∈ K) := fun x =>
  inferInstanceAs (Decidable (Theory.SpecificGroups.SymmetricSix.DuadCalculation.quotientHom x = 1))
instance : DecidablePred (· ∈ B) := fun x =>
  inferInstanceAs (Decidable (x.1 = 1 ∧ x.2 ∈ K))
instance : B.Normal := inferInstanceAs (((⊥ : Subgroup C).prod K).Normal)

private theorem C_pgroup : IsPGroup 2 C := IsPGroup.of_card (n := 1) (by
  norm_num [Nat.card_eq_fintype_card])

theorem core_M : pCore 2 M = (⊤ : Subgroup C).prod K := by
  rw [pCore_prod, ← Theory.SpecificGroups.SymmetricSix.DuadCalculation.core_eq]
  have h : pCore 2 C = ⊤ := top_unique (le_sSup ⟨inferInstance, C_pgroup.to_subgroup ⊤⟩)
  rw [h]

theorem t_outside_core : j t ∉ pCore 2 M := by
  rw [core_M]
  change ¬ (True ∧ squareEmbedding (.sr 0) ∈ K)
  decide +kernel

theorem residual_core : (pResidual 2 M).pCoreIn 2 = B := by
  have hfirst : pResidual 2 M ≤ (MonoidHom.fst C (Equiv.Perm (Fin 4))).ker := by
    apply sInf_le
    refine ⟨inferInstance, ?_⟩
    exact C_pgroup.of_equiv (QuotientGroup.quotientKerEquivOfSurjective
      (MonoidHom.fst C (Equiv.Perm (Fin 4))) (fun a => ⟨(a,1),rfl⟩)).symm
  have hB : B ≤ pResidual 2 M := by
    rintro ⟨a,b⟩ ⟨ha,hb⟩
    have ha' : a = 1 := mem_bot.mp ha
    subst a
    apply map_pResidual_le 2 (MonoidHom.inr C (Equiv.Perm (Fin 4)))
    refine ⟨b, ?_, rfl⟩
    apply Theory.SpecificGroups.SymmetricFour.twoCore_le_twoResidual
    rwa [← Theory.SpecificGroups.SymmetricSix.DuadCalculation.core_eq]
  apply le_antisymm
  · have hn : ((pResidual 2 M).pCoreIn 2).Normal :=
      inferInstanceAs ((pCore 2 (pResidual 2 M)).map (pResidual 2 M).subtype).Normal
    have hc : (pResidual 2 M).pCoreIn 2 ≤ pCore 2 M :=
      le_sSup ⟨hn, isPGroup_pCoreIn 2 _⟩
    rw [core_M] at hc
    intro x hx
    exact ⟨hfirst (pCoreIn_le 2 _ hx), (hc hx).2⟩
  · apply le_pCoreIn_of_normalizes _ hB le_normalizer_of_normal
    have hc : Nat.card B = 4 := by
      change Nat.card ((⊥ : Subgroup C).prod K) = 4
      rw [Nat.card_congr ((⊥ : Subgroup C).prodEquiv K).toEquiv, Nat.card_prod,
        card_bot, one_mul, Theory.SpecificGroups.SymmetricSix.DuadCalculation.core_card]
    exact IsPGroup.of_card (n := 2) hc

theorem R_image : R.map j = zpowers (j t) ⊔ B := by
  apply le_antisymm
  · rintro x ⟨y,hy,rfl⟩
    have hcalc : ∀ y : S, y ∈ R → j y ∈ B ∨ ∃ b : M, b ∈ B ∧ j y = j t * b := by
      decide +kernel
    rcases hcalc y hy with h | ⟨b,hb,he⟩
    · exact (le_sup_right : B ≤ zpowers (j t) ⊔ B) h
    · rw [he]
      exact mul_mem ((le_sup_left : zpowers (j t) ≤ zpowers (j t) ⊔ B) (mem_zpowers (j t)))
        ((le_sup_right : B ≤ zpowers (j t) ⊔ B) hb)
  · apply sup_le
    · exact zpowers_le.mpr (mem_map.mpr ⟨t, by decide, rfl⟩)
    · intro b hb
      have hcalc : ∀ b : M, b ∈ B → ∃ y : S, y ∈ R ∧ j y = b := by decide +kernel
      exact hcalc b hb

private instance (a b : M) : Decidable (∃ g : M, g * a * g⁻¹ = b) := inferInstance

private theorem cover_calc : ∀ r : S, r ∈ R → r ^ 2 = 1 →
    r = 1 ∨ (∃ g : M, g * j r * g⁻¹ = j t) ∨ (∃ g : M, g * j r * g⁻¹ = j z) := by
  decide +kernel

theorem cover (r : S) (hr : r ∈ R) (ho : orderOf r = 2) :
    IsConj (j r) (j t) ∨ IsConj (j r) (j z) := by
  have hp : r ^ 2 = 1 := by simpa only [ho] using pow_orderOf_eq_one r
  have hn : r ≠ 1 := by intro h; simp [h] at ho
  exact ((cover_calc r hr hp).resolve_left hn).imp isConj_iff.mpr isConj_iff.mpr
end CFSG.Quasithin.Chapter15.Section04.FamilySource.C2S4Geometry.CoverModel
