module

public import Theory.GroupTheory.InvolutionTransferResidual
public import Mathlib.GroupTheory.SpecificGroups.Cyclic.Basic
public import Mathlib.GroupTheory.Subgroup.Simple

/-!
# The missing involution class and transfer in 15.4.13

Three distinct ambient conjugacy classes cannot all meet a subgroup whose
involutions occupy only two ambient classes. We select a missing class
explicitly and apply Thompson transfer to the actual index-two subgroup
of the supplied Sylow group. In a nonabelian simple group that is impossible.

In the source application the three representatives are Z's nonidentity
elements and R is the dihedral subgroup generated by t and O_2(Y). The
model construction and normalizer fusion must supply these hypotheses;
no C_2 x S_4 exclusion or missing-class certificate is assumed here.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
Lemma 15.4.13, printed p.1161.
-/

public section
open Subgroup
namespace CFSG.Quasithin.Chapter15.Section04.FamilySource.Transfer
variable {G : Type*} [Group G]

private theorem choose_missing (a b c t z : G)
    (hab : ¬ IsConj a b) (hac : ¬ IsConj a c) (hbc : ¬ IsConj b c) :
    (¬ IsConj a t ∧ ¬ IsConj a z) ∨
      (¬ IsConj b t ∧ ¬ IsConj b z) ∨ (¬ IsConj c t ∧ ¬ IsConj c z) := by
  by_cases hat : IsConj a t
  · have hbt : ¬ IsConj b t := fun h => hab (hat.trans h.symm)
    have hct : ¬ IsConj c t := fun h => hac (hat.trans h.symm)
    by_cases hbz : IsConj b z
    · exact Or.inr (Or.inr ⟨hct, fun h => hbc (hbz.trans h.symm)⟩)
    · exact Or.inr (Or.inl ⟨hbt, hbz⟩)
  · by_cases haz : IsConj a z
    · have hbz : ¬ IsConj b z := fun h => hab (haz.trans h.symm)
      have hcz : ¬ IsConj c z := fun h => hac (haz.trans h.symm)
      by_cases hbt : IsConj b t
      · exact Or.inr (Or.inr ⟨fun h => hbc (hbt.trans h.symm), hcz⟩)
      · exact Or.inr (Or.inl ⟨hbt, hbz⟩)
    · exact Or.inl ⟨hat, haz⟩

/-- Select one of the three supplied involutions whose class misses R, and
retain the source conclusion that it lies outside O²(G). -/
theorem exists_missing_class [Finite G] (T : Sylow 2 G) (R : Subgroup T)
    (hR : R.index = 2) (a b c : T)
    (ha : orderOf a = 2) (hb : orderOf b = 2) (hc : orderOf c = 2)
    (hab : ¬ IsConj (a : G) (b : G)) (hac : ¬ IsConj (a : G) (c : G))
    (hbc : ¬ IsConj (b : G) (c : G)) (t z : G)
    (hcover : ∀ r : T, r ∈ R → orderOf r = 2 → IsConj (r : G) t ∨ IsConj (r : G) z) :
    ∃ i : T, (i = a ∨ i = b ∨ i = c) ∧ orderOf i = 2 ∧
      (∀ r : T, r ∈ R → ¬ IsConj (i : G) (r : G)) ∧ (i : G) ∉ pResidual 2 G := by
  have hs : ∃ i : T, (i = a ∨ i = b ∨ i = c) ∧ orderOf i = 2 ∧
      ¬ IsConj (i : G) t ∧ ¬ IsConj (i : G) z := by
    obtain h | h | h := choose_missing (a : G) b c t z hab hac hbc
    · exact ⟨a, Or.inl rfl, ha, h⟩
    · exact ⟨b, Or.inr (Or.inl rfl), hb, h⟩
    · exact ⟨c, Or.inr (Or.inr rfl), hc, h⟩
  obtain ⟨i, he, hi, hit, hiz⟩ := hs
  have hmissing (r : T) (hr : r ∈ R) (hir : IsConj (i : G) (r : G)) : False := by
    have ho : orderOf r = 2 := by
      obtain ⟨g, hg⟩ := isConj_iff.mp hir
      rw [← Subgroup.orderOf_coe, ← hg]
      change orderOf ((MulAut.conj g) (i : G)) = 2
      rw [MulEquiv.orderOf_eq, Subgroup.orderOf_coe, hi]
    rcases hcover r hr ho with ht | hz
    · exact hit (hir.trans ht)
    · exact hiz (hir.trans hz)
  exact ⟨i, he, hi, hmissing, T.not_mem_twoResidual_of_nonfusion_index_two R hR i hi
    (fun r hr hmem => hmissing r hmem hr)⟩

/-- Simplicity and noncommutativity exclude normal subgroups of index two. -/
theorem no_index_two_of_simple [Finite G] [IsSimpleGroup G]
    (hna : ¬ IsMulCommutative G) (K : Subgroup G) (hK : K.Normal) : K.index ≠ 2 := by
  intro hi
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal K hK with h | h
  · rw [h, index_bot] at hi
    let : IsCyclic G := isCyclic_of_prime_card hi
    exact hna inferInstance
  · simp [h] at hi

/-- The source transfer contradiction, before instantiating the C₂ × S₄ geometry. -/
theorem two_class_cover_impossible [Finite G] [IsSimpleGroup G]
    (hna : ¬ IsMulCommutative G) (T : Sylow 2 G) (R : Subgroup T)
    (hR : R.index = 2) (a b c : T)
    (ha : orderOf a = 2) (hb : orderOf b = 2) (hc : orderOf c = 2)
    (hab : ¬ IsConj (a : G) (b : G)) (hac : ¬ IsConj (a : G) (c : G))
    (hbc : ¬ IsConj (b : G) (c : G)) (t z : G)
    (hcover : ∀ r : T, r ∈ R → orderOf r = 2 → IsConj (r : G) t ∨ IsConj (r : G) z) :
    False := by
  obtain ⟨i, _, hi, hmissing, _⟩ := exists_missing_class T R hR a b c ha hb hc hab hac hbc t z hcover
  obtain ⟨r, hir, hr⟩ := T.exists_isConj_mem_of_index_two
    (no_index_two_of_simple hna) R hR i hi
  exact hmissing r hr hir

end CFSG.Quasithin.Chapter15.Section04.FamilySource.Transfer
