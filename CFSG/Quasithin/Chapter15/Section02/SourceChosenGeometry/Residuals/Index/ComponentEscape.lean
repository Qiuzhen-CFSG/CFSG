module

public import CFSG.Quasithin.Chapter15.Section02.SourceChosenGeometry.Residuals.Index.MathieuExclusion
public import CFSG.Quasithin.Chapter15.Section02.SourcePlaneUniqueness.CharacteristicTwo.ComponentModels.Catalogue.BinaryG2

/-!
# Equality-row component escape without the partner residual identity

When Kc = K, the cubic-generated subgroup of Mc is solvable. A nontrivial
perfect subgroup generated by its cubic elements therefore cannot lie in Mc.
For the actual normalized A₆/A₇ and binary G₂ components of 15.2.23,
the existing source markings supply that generation. The alternating
argument uses the literal cubic closure in I; the binary G₂ argument uses
the full quotient by O₂(X), with its trivial center and three-rank two.

These applications remove the missing identity Kc = O^{3′}(Mc) from
component escape in these rows. They retain the original component,
star/core markings and preceding source data. They do not assert the
separate residual-intersection identities or full plane uniqueness.

Source: Aschbacher--Smith, 15.2.12(4) and 15.2.23, printed pp.1111,
1116--1117, refs/quasithin.pdf.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter15.Section02
open Section01 ChosenGeometry ComponentCatalogue PlaneUniquenessPreceding TerminalLinear
open Chapter1.RadicalExclusions.ModelReduction FullSieve FullSieve.SourceInterface
open ChapterC.C27Source
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {M Mc V H B ZS I X : Subgroup G}
variable {h : ChosenSmallSource T M Mc V}

namespace ChosenGeometry

/-- Cubically generated nontrivial perfect subgroups escape the actual partner
in the equality row, independently of its prime-complement residual. -/
theorem ResidualInput.cubic_perfect_not_le_partner_of_eq
    (r : ResidualInput h H B) (he : partnerSpan H Mc = residual H)
    [Group.IsPerfect X] (hne : X ≠ ⊥)
    (hgen : closure {x : X | orderOf x = 3} = ⊤) : ¬ X ≤ Mc := by
  intro hXM
  have hs := solvable_cubic_closure_of_injective (inclusion hXM)
    (inclusion_injective hXM) (r.cubic_closure_solvable_of_eq he)
  rw [hgen] at hs
  let : Group.IsSolvable (⊤ : Subgroup X) := hs
  let : Group.IsSolvable X := Group.isSolvable_of_surjective
    (f := (topEquiv : (⊤ : Subgroup X) ≃* X).toMonoidHom) topEquiv.surjective
  let : Nontrivial X := (nontrivial_iff_ne_bot X).mpr hne
  exact Group.IsPerfect.not_isSolvable X inferInstance

/-- The literal normalized alternating component escapes Mc without an
orbit-residual equality or an intrinsic-movement assumption. -/
theorem ResidualInput.alternating_component_not_le_partner_of_eq
    (r : ResidualInput h H B) (he : partnerSpan H Mc = residual H)
    (hI : PlaneEscapes Mc ZS I) (hcore : (M ⊓ I).pCoreIn 2 = M.pCoreIn 2)
    (s : Normalized H M I X) {n : ℕ} (hn : n = 6 ∨ n = 7)
    (e : ((X ⧸ pCore 2 X) ⧸ center (X ⧸ pCore 2 X)) ≃*
      alternatingGroup (Fin n)) : ¬ X ≤ Mc := by
  let a := normalized_component_input (hsource := h) hI hcore s
  have hz : Nat.card (center (X ⧸ pCore 2 X)) ≤ 3 := by
    rcases coreQuotient_center_card_from_source a with hh | hh <;> omega
  have hg := alternating_component_cubic_closure (hsource := h) hI s.toSelected hz hn e
  let : Group.IsPerfect (X.subgroupOf I) := s.component.2.perfect
  let : Group.IsPerfect X := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe s.component.1).toMonoidHom)
    (subgroupOfEquivOfLe s.component.1).surjective
  apply r.cubic_perfect_not_le_partner_of_eq (X := X) he
    (fun hbot => s.outside (by rw [hbot]; exact bot_le))
  let C := closure {x : X | orderOf x = 3}
  have hXC : X ≤ C.map X.subtype := by
    refine hg.ge.trans ?_
    apply (closure_le _).mpr
    rintro x ⟨hxI,hx⟩
    have hxX : x ∈ X := hg ▸ subset_closure ⟨hxI,hx⟩
    exact ⟨⟨x,hxX⟩,subset_closure ((X.orderOf_coe _).symm.trans hx),rfl⟩
  apply map_injective X.subtype_injective
  rw [← MonoidHom.range_eq_map,range_subtype]
  exact le_antisymm (map_subtype_le C) hXC

/-- The literal binary G₂ component escapes Mc using its actual core/star
identification, without the missing partner residual identity. -/
theorem ResidualInput.binaryG2_component_not_le_partner_of_eq
    (r : ResidualInput h H B) (he : partnerSpan H Mc = residual H)
    (hI : PlaneEscapes Mc ZS I) (hcore : (M ⊓ I).pCoreIn 2 = M.pCoreIn 2)
    (s : Normalized H M I X)
    (e : starImage X ((M ⊓ I).pCoreIn 2) X ≃*
      commutator (Atlas.G2.Model (ZMod 2))) : ¬ X ≤ Mc := by
  let a := binaryG2CoreEquiv (normalized_component_input (hsource := h) hI hcore s) e
  let : IsQuasisimple (X ⧸ pCore 2 X) := s.quasisimple
  let : Group.IsPerfect (X.subgroupOf I) := s.component.2.perfect
  let : Group.IsPerfect X := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe s.component.1).toMonoidHom)
    (subgroupOfEquivOfLe s.component.1).surjective
  have hr : 2 ≤ primeRank 3 X := by
    have hq : 2 ≤ primeRank 3 (X ⧸ pCore 2 X) := by
      rw [primeRank_congr 3 a]
      exact Theory.SpecificGroups.Classical.BinaryDerivedCubicRank.g2
    exact hq.trans (primeRank_quotient_le_of_isTwoGroup 3 (by decide) _ pCore_isPGroup)
  have hz : primeRank 3 (center (X ⧸ pCore 2 X)) ≤ 1 := by
    let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
    apply primeRank_le_of_card_le_prime_pow (n := 1)
    rw [Nat.card_congr (centerCongr a).toEquiv,
      Theory.SpecificGroups.g2_derived_two_center_eq_bot,card_bot]
    norm_num
  exact r.cubic_perfect_not_le_partner_of_eq (X := X) he
    (fun hbot => s.outside (by rw [hbot]; exact bot_le))
    (cubic_closure_eq_top_of_twoCore_quasisimple hr hz)

end ChosenGeometry
end CFSG.Quasithin.Chapter15.Section02
