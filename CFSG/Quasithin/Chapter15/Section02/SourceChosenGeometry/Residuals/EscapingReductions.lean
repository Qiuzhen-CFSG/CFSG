module

public import CFSG.Quasithin.Chapter15.Section02.SourceChosenGeometry.Residuals.EscapingSylow
public import CFSG.Quasithin.Chapter15.Section02.SourcePlaneUniqueness.CharacteristicTwo.LocalReductions
public import Theory.GroupTheory.PResidual.CubicGenerationModuloTwoCore

/-!
# Local reductions on the actual escaping offender plane

The proved Sylow geometry supplies the two-core containment and the original
index-two intersection argument. A subgroup containing K and S and normalized
by T lies in Mc by the original unique maximal-two-local overgroup of H.
The literal intersection factorization then forces its two-residual to
centralize V. These are the geometric reductions used by the Omega action,
chi-block, and component consumers of 15.2.23.

The actual wreath residual additionally satisfies K intersect M = O₂(K)
and is generated by cubic elements. No partner-residual identity or
PlaneUniquenessPreceding packet is used.

Source: Aschbacher--Smith, 15.2.18--19 and 15.2.23,
printed pp.1113--1117, refs/quasithin.pdf.
-/

public section
open Subgroup Stellmacher Theory.GroupTheory
namespace CFSG.Quasithin.Chapter15.Section02.ChosenGeometry
open Section01 Section03 ChapterA.Section05To06
open Chapter13.Section08.Components.Swapped.LinearThree
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {M Mc V H B I : Subgroup G}
variable {h : ChosenSmallSource T M Mc V}
variable (r : ResidualInput h H B)
include r

/-- The literal source intersection factorization holds before the partner
prime-to-three residual has been identified. -/
theorem ResidualInput.partner_intersection_eq :
    M ⊓ Mc = (M ⊓ centralizer (V : Set G)) ⊔ (T : Subgroup G) := by
  rw [r.partner_eq_centralizer]
  exact h.seed_centralizer_eq r.full

/-- The actual core of I lies in its proved Sylow subgroup S. -/
theorem ResidualInput.core_le_plane (hI : PlaneEscapes Mc ⁅V,B⁆ I) :
    I.pCoreIn 2 ≤ planeCentralizer T ⁅V,B⁆ := by
  obtain ⟨P,hP⟩ := r.sylow_in_escape hI
  exact (pCoreIn_le_sylow I P).trans_eq hP

/-- The overgroup-uniqueness argument used in 15.2.18 and 15.2.22. -/
theorem ResidualInput.normalized_intermediate_le_partner (hI : PlaneEscapes Mc ⁅V,B⁆ I)
    {J : Subgroup G} (hJI : J ≤ I) (hSJ : planeCentralizer T ⁅V,B⁆ ≤ J)
    (hKJ : (pResidual 2 H).map H.subtype ≤ J)
    (hTJ : (T : Subgroup G) ≤ normalizer (J : Set G)) : J ≤ Mc := by
  have hQJ : I.pCoreIn 2 ≤ J := (r.core_le_plane hI).trans hSJ
  have hQQ : I.pCoreIn 2 ≤ J.pCoreIn 2 := by
    simpa only [inf_eq_right.mpr hQJ] using inf_pCoreIn_le_of_le 2 hJI
  have hQne : J.pCoreIn 2 ≠ ⊥ := by
    intro he
    exact hI.1 (bot_unique (hQQ.trans_eq he))
  let D := J ⊔ (T : Subgroup G)
  have hQD : J.pCoreIn 2 ≤ D.pCoreIn 2 :=
    pCoreIn_mono_of_normalizes le_sup_left (sup_le J.le_normalizer hTJ)
  have hDne : pCore 2 D ≠ ⊥ := by
    intro he
    apply hQne
    apply bot_unique
    simpa only [pCoreIn, he, Subgroup.map_bot] using hQD
  obtain ⟨N,hN,hDN⟩ := exists_maximalTwoLocal_overgroup_of_twoCore_ne_bot D hDne
  have hHN : H ≤ N := by
    rw [← r.residual_join]
    exact (sup_le_sup_right hKJ _).trans hDN
  have hNM : N = Mc := source_chosen_HStar_unique r.outside r.two_overgroups N hN hHN
  exact (le_sup_left.trans hDN).trans_eq hNM

/-- The two-residual of the literal M ∩ Mc lies in C_M(V), by 15.2.14(5). -/
theorem ResidualInput.partner_intersection_residual_le_module_centralizer :
    (pResidual 2 (M ⊓ Mc : Subgroup G)).map (M ⊓ Mc).subtype ≤
      M ⊓ centralizer (V : Set G) := by
  let A := M ⊓ Mc
  let C := M ⊓ centralizer (V : Set G)
  have hCA : C ≤ A := by
    change C ≤ M ⊓ Mc
    rw [r.partner_intersection_eq]
    exact le_sup_left
  have hTA : (T : Subgroup G) ≤ A := by
    change (T : Subgroup G) ≤ M ⊓ Mc
    rw [r.partner_intersection_eq]
    exact le_sup_right
  have hAC : A ≤ normalizer (C : Set G) :=
    inf_le_left.trans ((le_inf M.le_normalizer
      (h.prepared.normalized.trans (normalizer_le_normalizer_centralizer V))).trans
        inf_normalizer_le_normalizer_inf)
  let : (C.subgroupOf A).Normal := normal_subgroupOf_of_le_normalizer hAC
  have hgen : C.subgroupOf A ⊔ (T : Subgroup G).subgroupOf A = ⊤ := by
    apply map_injective A.subtype_injective
    rw [Subgroup.map_sup,map_subgroupOf_eq_of_le hCA,map_subgroupOf_eq_of_le hTA,
      ← MonoidHom.range_eq_map,range_subtype]
    exact r.partner_intersection_eq.symm
  have hquot : IsPGroup 2 (A ⧸ C.subgroupOf A) :=
    isPGroup_quotient_of_sup_eq_top _ _ T.isPGroup'.comap_subtype hgen
  have hres := map_mono ((pResidual_le_iff_isPGroup_quotient 2 (C.subgroupOf A)).mpr hquot)
    (f := A.subtype)
  rwa [map_subgroupOf_eq_of_le hCA] at hres

/-- The noncentral residual image in 15.2.18 cannot have T-invariant full preimage. -/
theorem ResidualInput.residual_join_centralizer_not_normalized
    (hI : PlaneEscapes Mc ⁅V,B⁆ I)
    (hout : ¬ (pResidual 2 (M ⊓ I : Subgroup G)).map (M ⊓ I).subtype ≤
      centralizer (V : Set G)) :
    ¬ (T : Subgroup G) ≤ normalizer
      (((pResidual 2 (M ⊓ I : Subgroup G)).map (M ⊓ I).subtype ⊔
        (M ⊓ centralizer (V : Set G)) : Subgroup G) : Set G) := by
  let X := (pResidual 2 (M ⊓ I : Subgroup G)).map (M ⊓ I).subtype
  let C := M ⊓ centralizer (V : Set G)
  let K := (pResidual 2 H).map H.subtype
  let S := planeCentralizer T ⁅V,B⁆
  intro hT
  have hSI : S ≤ I :=
    (le_sup_right.trans (r.residual_sup_planeCentralizer_le hI)).trans inf_le_right
  have hKI : K ≤ I :=
    (le_sup_left.trans (r.residual_sup_planeCentralizer_le hI)).trans inf_le_right
  have hCI : C ≤ I := inf_le_right.trans (r.module_centralizer_le_escape hI)
  have hXI : X ≤ I := (map_subtype_le _).trans inf_le_right
  have hTS : (T : Subgroup G) ≤ normalizer (S : Set G) :=
    (normal_subgroupOf_iff_le_normalizer inf_le_left).mp
      (normal_of_index_eq_two (r.escape_index hI).2)
  have hTK : (T : Subgroup G) ≤ normalizer (K : Set G) :=
    r.geometry.outside.1.1.2.trans
      (H.le_normalizer.trans (normalizer_le_normalizer_characteristic_image H (pResidual 2 H)))
  have hTJ : (T : Subgroup G) ≤ normalizer ((X ⊔ C ⊔ S ⊔ K : Subgroup G) : Set G) :=
    (le_inf ((le_inf hT hTS).trans (normalizer_inf_normalizer_le_normalizer_sup _ _))
      hTK).trans (normalizer_inf_normalizer_le_normalizer_sup _ _)
  have hJMc := r.normalized_intermediate_le_partner hI
    (sup_le (sup_le (sup_le hXI hCI) hSI) hKI)
    (le_sup_right.trans le_sup_left) le_sup_right hTJ
  have hXA : X ≤ M ⊓ Mc := le_inf ((map_subtype_le _).trans inf_le_left)
    ((le_sup_left.trans (le_sup_left.trans le_sup_left)).trans hJMc)
  have hpX : IsPPerfect 2 X := isPPerfect_embedded_pResidual 2 (M ⊓ I)
  have hres := embedded_pResidual_mono 2 hXA
  rw [(pResidual_eq_top_iff 2 X).mpr hpX, ← MonoidHom.range_eq_map, range_subtype] at hres
  exact hout ((hres.trans r.partner_intersection_residual_le_module_centralizer).trans inf_le_right)

/-- Intersecting I with a two-subgroup of T is the same as intersecting S. -/
theorem ResidualInput.twoGroup_intersection (hI : PlaneEscapes Mc ⁅V,B⁆ I)
    {Q : Subgroup G} (hQT : Q ≤ (T : Subgroup G)) :
    I ⊓ Q = planeCentralizer T ⁅V,B⁆ ⊓ Q := by
  obtain ⟨P,hP⟩ := r.sylow_in_escape hI
  have hTI : (T : Subgroup G) ⊓ I = planeCentralizer T ⁅V,B⁆ := by
    rw [← hP]
    exact inf_eq_sylow_map P T.isPGroup' (hP ▸ inf_le_left)
  apply le_antisymm
  · exact le_inf (fun x hx => hTI ▸ (show x ∈ (T : Subgroup G) ⊓ I from ⟨hQT hx.2,hx.1⟩)) inf_le_right
  · exact inf_le_inf_right Q ((le_sup_right.trans (r.residual_sup_planeCentralizer_le hI)).trans inf_le_right)

/-- Every such intersection has index at most two in the given two-subgroup. -/
theorem ResidualInput.twoGroup_intersection_index (hI : PlaneEscapes Mc ⁅V,B⁆ I)
    {Q : Subgroup G} (hQT : Q ≤ (T : Subgroup G)) :
    (I ⊓ Q).relIndex Q ≤ 2 := by
  let S := planeCentralizer T ⁅V,B⁆
  let Sn := S.subgroupOf (T : Subgroup G)
  let : Sn.Normal := normal_of_index_eq_two (r.escape_index hI).2
  have hd := Sn.relIndex_dvd_index_of_normal (Q.subgroupOf (T : Subgroup G))
  have he : Sn.index = 2 := (r.escape_index hI).2
  rw [he] at hd
  rw [r.twoGroup_intersection hI hQT, inf_relIndex_right]
  rw [relIndex_subgroupOf hQT] at hd
  exact Nat.le_of_dvd (by decide) hd

/-- Relative normality and two-perfectness upgrade mutual normalization. -/
theorem ResidualInput.normal_twoPerfect_normalized_by_twoGroup (hI : PlaneEscapes Mc ⁅V,B⁆ I)
    {X Q : Subgroup G} (hXI : X ≤ I) (hIX : I ≤ normalizer (X : Set G))
    (hpX : IsPPerfect 2 X) (hQT : Q ≤ (T : Subgroup G))
    (hXQ : X ≤ normalizer (Q : Set G)) : Q ≤ normalizer (X : Set G) := by
  let W := I ⊓ Q
  have hXW : X ≤ normalizer (W : Set G) :=
    (le_inf (hXI.trans I.le_normalizer) hXQ).trans inf_normalizer_le_normalizer_inf
  have hi : W.relIndex Q ≤ 2 := r.twoGroup_intersection_index hI hQT
  have hpos : 0 < W.relIndex Q := Nat.pos_of_ne_zero index_ne_zero_of_finite
  have hc : ⁅Q,X⁆ ≤ W := by
    have hcases : W.relIndex Q = 1 ∨ W.relIndex Q = 2 := by omega
    rcases hcases with hi | hi
    · exact (le_normalizer_iff_commutator_le_left.mp hXQ).trans (relIndex_eq_one.mp hi)
    · exact commutator_le_of_normalized_index_two Q W X inf_le_right hi hXQ hXW
  have hQW : Q ≤ normalizer (W : Set G) := by
    change Q ≤ normalizer ((I ⊓ Q : Subgroup G) : Set G)
    rw [r.twoGroup_intersection hI hQT]
    have hTS : (T : Subgroup G) ≤ normalizer (planeCentralizer T ⁅V,B⁆ : Set G) :=
      (normal_subgroupOf_iff_le_normalizer inf_le_left).mp
        (normal_of_index_eq_two (r.escape_index hI).2)
    exact (le_inf (hQT.trans hTS) Q.le_normalizer).trans inf_normalizer_le_normalizer_inf
  have hx : (pResidual 2 X).map X.subtype = X := by
    rw [(pResidual_eq_top_iff 2 X).mpr hpX, ← MonoidHom.range_eq_map, range_subtype]
  have hn := normalizes_residual_of_commutator_le_two Q I X W hIX inf_le_left
    ((T.isPGroup'.to_le hQT).to_le inf_le_right) hQW (by simpa only [hx] using hc)
  simpa only [hx] using hn

/-- The literal K intersects the chosen maximal local only in O₂(K). -/
theorem ResidualInput.residual_intersection_eq_core :
    residual H ⊓ M = (residual H).pCoreIn 2 := by
  let K := residual H
  have hKH : K ≤ H := map_subtype_le _
  have hHK : H ≤ normalizer (K : Set G) :=
    H.le_normalizer.trans (normalizer_le_normalizer_characteristic_image H (pResidual 2 H))
  have hcoreM : K.pCoreIn 2 ≤ M :=
    (pCoreIn_mono_of_normalizes hKH hHK).trans
      ((pCoreIn_le_sylow H (T.subtype r.outside.1.1.2)).trans
        (by
          rintro x ⟨y,hy,rfl⟩
          exact h.maximal.1.2 hy))
  apply le_antisymm ?_ (le_inf (pCoreIn_le 2 K) hcoreM)
  have htwo : IsPGroup 2 (K ⊓ M : Subgroup G) := T.isPGroup'.to_le (by
    rw [←r.intersection_eq_sylow]
    exact le_inf (inf_le_left.trans hKH) inf_le_right)
  have hc : Nat.card (K ⧸ pCore 2 K) = 9 := by
    exact (Nat.card_congr (residualQuotientEquiv H r.quotient.some).toEquiv).trans
      WreathModel.cubicBase_card
  let A := (K ⊓ M).subgroupOf K
  let q := QuotientGroup.mk' (pCore 2 K)
  have hAc : Nat.card (A.map q) = 1 := by
    rcases (htwo.comap_subtype.map q).card_eq_or_dvd with hh | hh
    · exact hh
    · have hd := hh.trans (A.map q).card_subgroup_dvd_card
      rw [hc] at hd
      norm_num at hd
  have hA : A ≤ pCore 2 K := by
    simpa only [q,QuotientGroup.ker_mk'] using
      (Subgroup.map_eq_bot_iff _).mp (Subgroup.card_eq_one.mp hAc)
  intro x hx
  exact mem_map_of_mem K.subtype (hA (show (⟨x,hx.1⟩ : K) ∈ A from hx))

/-- The actual wreath residual is generated by its cubic elements. -/
theorem ResidualInput.residual_cubic_closure :
    closure {x : G | x ∈ residual H ∧ orderOf x = 3} = residual H := by
  let K := residual H
  let eK := (pResidual 2 H).equivMapOfInjective H.subtype H.subtype_injective
  have hp : IsPPerfect 2 K := (isPPerfect_pResidual 2 (G := H)).of_surjective
    eK.toMonoidHom eK.surjective
  let e := residualQuotientEquiv H r.quotient.some
  let : IsElementaryAbelian 3 (K ⧸ pCore 2 K) :=
    IsElementaryAbelian.of_injective e.toMonoidHom e.injective
  have hc : ∀ x : K ⧸ pCore 2 K, x ^ 3 = 1 :=
    Monoid.exponent_dvd_iff_forall_pow_eq_one.mp (IsElementaryAbelian.exponent_dvd_p 3 _)
  have hg := cubic_closure_eq_top_of_twoPerfect_of_quotient_cube hp hc
  have hm := congrArg (map K.subtype) hg
  rw [MonoidHom.map_closure,←MonoidHom.range_eq_map,range_subtype] at hm
  convert hm using 1
  congr 1
  ext x
  constructor
  · rintro ⟨hxK,hx⟩
    exact ⟨⟨x,hxK⟩,(K.orderOf_coe _).symm.trans hx,rfl⟩
  · rintro ⟨y,hy,rfl⟩
    exact ⟨y.property,(K.orderOf_coe y).trans hy⟩

end CFSG.Quasithin.Chapter15.Section02.ChosenGeometry
