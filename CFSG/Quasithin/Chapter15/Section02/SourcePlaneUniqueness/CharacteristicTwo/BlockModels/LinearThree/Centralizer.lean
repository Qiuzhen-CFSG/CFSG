/-!
# The original binary linear-three component centralizer

The proved component-orbit bound makes K = O²(H) normalize X. Its elementary
nine meets X nontrivially, giving an actual odd subgroup D ≤ K ∩ X. If X
escapes Mc, its centralizer of ZS is a proper Sylow overgroup containing D.
The PSL₃(2) parabolic lattice therefore makes this centralizer maximal and
generated by D and S ∩ X. Thus C_X(ZS) = X ∩ Mc and C_X(ZS) ≤ KS, with
the original subgroup embeddings. The S-conjugate span is normal in I.

For a normal X, the last theorem applies this marking to the genuine
MS-pair construction for XQI. This does not identify an exchanged orbit
with X or assume the full C.1.34 classification. The escape proof for the
non-block models, exchanged-orbit marking and local-omega comparison remain
with qt-e-152-char2-block-exclusion. Earlier source Kc premises retain their
original producers and enclosing plane-uniqueness discharge.

Source: Aschbacher--Smith, preliminary 15.2.23, printed p.1115,
C.1.34, printed pp.136--137, refs/quasithin.pdf.
-/

public section
open Subgroup Stellmacher Theory.GroupTheory
namespace CFSG.Quasithin.Chapter15.Section02.PlaneUniquenessPreceding
open Section01 Section03 ChapterA.Section04 ChapterA.Section05To06
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {M Mc V H ZS I : Subgroup G}
variable {hsource : ChosenSmallSource T M Mc V}
variable (d : PlaneUniquenessPreceding hsource H ZS)
include d

omit d in
/-- The actual linear-three C-component has at most two I-conjugates. -/
theorem linearThree_component_orbit_bound
    (hsource : ChosenSmallSource T M Mc V)
    (hI : PlaneEscapes Mc ZS I) {X : Subgroup I} (hX : X.IsCComponent) :
    X.Normal ∨ (normalizer (X : Set I)).index = 2 := by
  have hsq := Chapter3.sqtk_of_mem_H hsource.ambient hI.1
  have hsqQ : IsSQTK KnownSimple.IsKnownSimple (I ⧸ pCore 2 I) := by
    refine ⟨?_,hsq.isKGroup.quotient _⟩
    intro p hp ho
    let : Fact p.Prime := ⟨hp⟩
    exact (primeRank_quotient_le_of_isTwoGroup p ho (pCore 2 I) pCore_isPGroup).trans
      (hsq.stronglyQuasithin p hp ho)
  let := pCore_isNilpotent (p := 2) (G := I)
  exact cComponent_normal_or_index_two_of_quotient hX (pCore 2 I)
    (ChapterA.Section03.ComponentOrbitBound.normal_or_index_two_of_noncentral_structure
      (ChapterA.Section03.CComponentCommutation.noncentralStructureInput _)
      hsqQ (pCore_quotient_pCore_eq_bot 2) (hX.map_quotient _))

/-- K normalizes the actual component, and its elementary nine supplies
an odd nontrivial subgroup in K ∩ X. -/
theorem linearThree_component_odd_intersection
    (hI : PlaneEscapes Mc ZS I) {X : Subgroup I} (hX : X.IsCComponent)
    (e : (X ⧸ pCore 2 X) ≃* Matrix.PSL3Two.PSL) :
    ∃ D : Subgroup I, D ≤ X ∧ Odd (Nat.card D) ∧ D ≠ ⊥ ∧
      D.map I.subtype ≤ (pResidual 2 H).map H.subtype := by
  let K := (pResidual 2 H).map H.subtype
  have hKI : K ≤ I := le_sup_left.trans ((d.residual_sup_planeSylow_le hI).trans inf_le_right)
  let K' := K.subgroupOf I
  let eK : (pResidual 2 H) ≃* K' :=
    ((pResidual 2 H).equivMapOfInjective H.subtype H.subtype_injective).trans
      (subgroupOfEquivOfLe hKI).symm
  have hp : IsPPerfect 2 K' := (isPPerfect_pResidual 2 (G := H)).of_surjective
    eK.toMonoidHom eK.surjective
  have hIr := (Chapter3.sqtk_of_mem_H hsource.ambient hI.1).stronglyQuasithin
    3 (by decide) (by decide)
  have hkr : primeRank 3 K' = 2 := by
    have hh := (primeRank_subgroup_le 3 K').trans hIr
    have hl : 2 ≤ primeRank 3 K' := by
      rw [← primeRank_congr 3 eK]
      exact d.residual_threeRank_ge_two
    omega
  have hn : K' ≤ normalizer (X : Set I) := by
    rcases linearThree_component_orbit_bound hsource hI hX with hn | hi
    · let := hn
      rw [normalizer_eq_top]
      exact le_top
    · let N := normalizer (X : Set I)
      let : N.Normal := N.normal_of_index_eq_two hi
      have hquot : IsPGroup 2 (I ⧸ N) := IsPGroup.of_card (n := 1) (by
        simpa only [← index_eq_card,pow_one] using hi)
      exact (le_pResidual_of_isPPerfect K' hp).trans (sInf_le ⟨inferInstance,hquot⟩)
  have hthree : 3 ∣ Nat.card X := by
    apply dvd_trans ?_ (pCore 2 X).card_quotient_dvd_card
    rw [Nat.card_congr e.toEquiv,Matrix.PSL3Two.card_PSL]
    decide
  obtain ⟨E,hE,hcard⟩ := exists_elementaryAbelian_card_primeRank (G := K') (p := 3)
  let := hE
  let E' := E.map K'.subtype
  let : IsElementaryAbelian 3 E' := IsElementaryAbelian.map_subtype
  have hc : Nat.card E' = 3^2 := by
    rw [card_map_of_injective K'.subtype_injective,hcard,hkr]
  let D := E' ⊓ X
  have hd : D ≠ ⊥ := E'.inf_ne_bot_of_elementary_plane X ((map_subtype_le _).trans hn)
    hthree hc hIr
  have hodd : Odd (Nat.card D) := by
    obtain ⟨n,he⟩ := ((IsElementaryAbelian.isPGroup 3 E').to_le
      (show D ≤ E' from inf_le_left)).exists_card_eq
    rw [he]
    exact (by decide : Odd 3).pow
  refine ⟨D,inf_le_right,hodd,hd,?_⟩
  exact (map_mono (inf_le_left.trans (map_subtype_le _))).trans_eq
    (map_subgroupOf_eq_of_le hKI)

/-- A proper centralizer in the actual component is maximal and generated
by its original Sylow intersection and the constructed odd subgroup. -/
theorem linearThree_component_centralizer_parabolic
    (hI : PlaneEscapes Mc ZS I) {X : Subgroup I} (hX : X.IsCComponent)
    (e : (X ⧸ pCore 2 X) ≃* Matrix.PSL3Two.PSL)
    (hout : ¬ X.map I.subtype ≤ Mc) :
    IsCoatom ((centralizer (ZS : Set G)).comap (I.subtype.comp X.subtype)) ∧
      X.map I.subtype ⊓ centralizer (ZS : Set G) = X.map I.subtype ⊓ Mc ∧
      X.map I.subtype ⊓ centralizer (ZS : Set G) ≤
        (pResidual 2 H).map H.subtype ⊔ planeSylow T ZS := by
  let f := I.subtype.comp X.subtype
  let B := (centralizer (ZS : Set G)).comap f
  obtain ⟨S,hS⟩ := d.sylow_in_escape hI
  obtain ⟨P,hP⟩ := S.exists_subgroupOf_eq_of_subnormal X hX.subnormal
  have hPmap : (P : Subgroup X).map f = planeSylow T ZS ⊓ X.map I.subtype := by
    rw [← map_map,hP,subgroupOf_map_subtype,Subgroup.map_inf _ _ _ I.subtype_injective,hS]
  have hPB : (P : Subgroup X) ≤ B := by
    intro x hx
    exact ((hPmap ▸ mem_map_of_mem f hx).1).2
  have hB : B ≠ ⊤ := by
    intro ht
    apply hout
    rintro x ⟨a,ha,rfl⟩
    have hh : (⟨a,ha⟩ : X) ∈ B := ht ▸ mem_top _
    exact ((d.centralizer_le_intersection hI) hh).1
  obtain ⟨D,hDX,ho,hd,hDK⟩ := d.linearThree_component_odd_intersection hI hX e
  let D' := D.subgroupOf X
  have hDB : D' ≤ B := by
    intro a ha
    exact d.residual_centralizes (hDK (mem_map_of_mem I.subtype ha))
  have ho' : Odd (Nat.card D') := by
    rwa [Nat.card_congr (subgroupOfEquivOfLe hDX).toEquiv]
  have hd' : D' ≠ ⊥ := by
    intro he
    apply hd
    have hm := congrArg (Subgroup.map X.subtype) he
    simpa only [D',map_subgroupOf_eq_of_le hDX,Subgroup.map_bot] using hm
  obtain ⟨hc,_,hg⟩ := Matrix.PSL3Two.cover_parabolic_generated_by_sylow_and_odd
    e P B D' hPB hB hDB ho' hd'
  have heM : B = Mc.comap f := by
    have hle : B ≤ Mc.comap f := fun a ha => ((d.centralizer_le_intersection hI) ha).1
    rcases hc.le_iff.mp hle with ht | he
    · exfalso
      apply hout
      rintro x ⟨a,ha,rfl⟩
      exact (show (⟨a,ha⟩ : X) ∈ Mc.comap f from ht ▸ mem_top _)
    · exact he.symm
  have himage (C : Subgroup G) : (C.comap f).map f = X.map I.subtype ⊓ C := by
    ext x
    constructor
    · rintro ⟨a,ha,rfl⟩
      exact ⟨mem_map_of_mem I.subtype a.property,ha⟩
    · rintro ⟨⟨a,ha,rfl⟩,hc⟩
      exact ⟨⟨a,ha⟩,hc,rfl⟩
  refine ⟨hc,?_,?_⟩
  · rw [← himage,← himage,← heM]
  · rw [← himage,show (centralizer (ZS : Set G)).comap f = B from rfl,hg,Subgroup.map_sup]
    apply sup_le
    · rw [hPmap]
      exact inf_le_left.trans le_sup_right
    · have he : D'.map f = D.map I.subtype := by
        rw [←map_map,map_subgroupOf_eq_of_le hDX]
      exact he ▸ hDK.trans le_sup_left
/-- The full S-orbit is normal relative to I, without requiring X itself
normal or identifying an exchanged orbit with one constituent. -/
theorem linearThree_componentOrbit_normalized
    (hI : PlaneEscapes Mc ZS I) {X : Subgroup I} (hX : X.IsCComponent) :
    I ≤ normalizer (planeBlockOrbit T ZS X : Set G) := by
  obtain ⟨P,hP⟩ := d.sylow_in_escape hI
  let Y := conjugateSpanBy X (P : Subgroup I)
  let : Y.Normal := conjugateSpanBy_sylow_normal X P
    (linearThree_component_orbit_bound hsource hI hX)
  have he : Y.map I.subtype = planeBlockOrbit T ZS X := by
    rw [map_conjugateSpanBy,hP]
  rw [← he]
  intro x hx
  apply le_normalizer_map I.subtype
  exact ⟨⟨x,hx⟩,by rw [normalizer_eq_top]; trivial,rfl⟩

open Chapter1.RadicalExclusions.ModelReduction.FullSieve.SourceInterface in
/-- For a normal actual component, the parabolic proof discharges the
marking premise of the genuine MS-pair construction. Escape still has to
be supplied by the source module calculation. -/
theorem linearThree_normal_component_msPair
    (hI : PlaneEscapes Mc ZS I) (hfit : generalizedFitting I = pCore 2 I)
    {X : Subgroup I} (hX : X.IsCComponent) [X.Normal]
    (e : (X ⧸ pCore 2 X) ≃* Matrix.PSL3Two.PSL)
    (hout : ¬ X.map I.subtype ≤ Mc) :
    LinearThreeMSPair KnownSimple.IsKnownSimple (X.map I.subtype)
      (planeParabolicCore T H ZS) 1 (ZMod 2) := by
  let Y := X.map I.subtype
  let a : X ≃* Y := X.equivMapOfInjective I.subtype I.subtype_injective
  let eQ : (Y ⧸ pCore 2 Y) ≃* Matrix.PSL3Two.SL :=
    ((QuotientGroup.congr _ _ a.symm (pCore_map_iso 2 a.symm)).trans e).trans
      Matrix.PSL3Two.equiv.symm
  have hY : Y ∈ Chapter1.cComponentsIn I := by
    refine ⟨map_subtype_le _,?_⟩
    have he : Y.subgroupOf I = X := comap_map_eq_self_of_injective I.subtype_injective X
    rwa [he]
  have hn : I ≤ normalizer (Y : Set G) := by
    have hh := X.le_normalizer_map I.subtype
    simpa only [normalizer_eq_top,← MonoidHom.range_eq_map,range_subtype] using hh
  exact d.plane_linearThree_msPair hI hfit hY hn hout (by decide)
    (by norm_num [Nat.card_eq_fintype_card]) eQ
    (d.linearThree_component_centralizer_parabolic hI hX e hout).2.2

end CFSG.Quasithin.Chapter15.Section02.PlaneUniquenessPreceding
