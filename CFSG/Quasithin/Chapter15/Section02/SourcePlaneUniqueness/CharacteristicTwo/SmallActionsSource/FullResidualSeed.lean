/-!
# Arbitrary seeds in the full-image branch of 15.2.22

When the original Y has order-nine action image and C_M(V) is a 3′-group,
Y has index prime to three in M. Every corrected two-perfect cubic seed is
its own prime-to-three residual, so it lies in Y. The centralizer hypothesis
also excludes the order-27 star alternative, giving the actual elementary
core quotient of Y. Its two-core lies in S, which normalizes the seed.
Recovering the seed from its quotient image therefore proves normality in Y.

Y is normal in M, so every T-conjugate of the seed is normal in Y as well.
Their commutator lies in their intersection. The actual conjugate residual
pair and the characteristic-two normalizer argument now give 15.2.22 for
this branch, for every seed and every specified t in T − S.

The cubic-image branch still needs its choice of t normalizing YY₁; this
module does not claim the unconditional source theorem. The earlier Omega
and plane inputs retain their existing producers, with final discharge by
qt-e-152-plane-uniqueness.
Source: Aschbacher--Smith 15.2.22, printed pp.1114--1115, refs/quasithin.pdf.
-/

public noncomputable section
open Subgroup Stellmacher Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section02.SmallActionsSource
open Section01 ChapterD ChapterD.UniqueFactor PlaneUniquenessPreceding.OmegaAction
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
private theorem index_coprime_of_nine_image {D : Type*} [Group D] [Finite D]
    (f : G →* D) (hf : Function.Surjective f) (hc : Nat.card D = 36)
    (hk : Nat.Coprime 3 (Nat.card f.ker))
    (A : Subgroup G) (hA : Nat.card (A.map f) = 9) : Nat.Coprime 3 A.index := by
  have hd : 9 ∣ Nat.card A := hA ▸ card_dvd_of_surjective
    (f.subgroupMap A) (f.subgroupMap_surjective A)
  obtain ⟨k,hkA⟩ := hd
  have hG : Nat.card G = 36 * Nat.card f.ker := by
    rw [←hc, ←Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective f hf).toEquiv]
    exact card_eq_card_quotient_mul_card_subgroup f.ker
  have he : 9 * (k * A.index) = 9 * (4 * Nat.card f.ker) := by
    calc
      _ = Nat.card A * A.index := by rw [hkA, Nat.mul_assoc]
      _ = Nat.card G := A.card_mul_index
      _ = _ := by rw [hG]; omega
  have he' : k * A.index = 4 * Nat.card f.ker := Nat.mul_left_cancel (by decide) he
  exact ((by decide : Nat.Coprime 3 4).mul_right hk).coprime_dvd_right
    ⟨k,by simpa only [Nat.mul_comm] using he'.symm⟩

omit [Finite G] in
private theorem not_twentyseven_dvd_of_coprime_kernel {D : Type*} [Group D] [Finite D]
    (f : G →* D) (hf : Function.Surjective f) (hc : Nat.card D = 36)
    (hk : Nat.Coprime 3 (Nat.card f.ker)) : ¬ 27 ∣ Nat.card G := by
  have hG : Nat.card G = 36 * Nat.card f.ker := by
    rw [←hc, ←Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective f hf).toEquiv]
    exact card_eq_card_quotient_mul_card_subgroup f.ker
  intro hd
  have hd' : 9 * 3 ∣ 9 * (4 * Nat.card f.ker) := by simpa only [hG, ← Nat.mul_assoc] using hd
  have hh : 3 ∣ 4 * Nat.card f.ker := (Nat.mul_dvd_mul_iff_left (by decide)).mp hd'
  exact Nat.prime_three.coprime_iff_not_dvd.mp
    ((by decide : Nat.Coprime 3 4).mul_right hk) hh

/-- Every corrected seed is generated by its three-elements in the residual sense. -/
theorem Seed.primeToResidual_eq_top {M I S E : Subgroup G}
    (s : Seed M I S E) (hS : IsPGroup 2 S) : primeToResidual 3 E = ⊤ := by
  have hc := s.core_quotient_card hS
  let : IsSimpleGroup (E ⧸ pCore 2 E) := isSimpleGroup_of_prime_card hc
  exact primeToResidual_eq_top_of_simple_quotient 3 2 (pCore 2 E)
    pCore_isPGroup s.perfect (hc ▸ dvd_rfl)

variable {T : Sylow 2 G} {M Mc V H ZS I E : Subgroup G}
variable {hsource : ChosenSmallSource T M Mc V}
variable (d : PlaneUniquenessPreceding hsource H ZS)
include d

omit d in
private theorem centralizer_coprime (hC : IsSmallActionThreePrime (M ⊓ centralizer (V : Set G))) :
    Nat.Coprime 3 (Nat.card (action hsource).ker) := by
  have hc := primeToResidual_index_coprime (G := (M ⊓ centralizer (V : Set G) : Subgroup G)) 3
  change primeToResidual 3 (M ⊓ centralizer (V : Set G) : Subgroup G) = ⊥ at hC
  rw [hC,index_bot] at hc
  have he : (action hsource).ker.map M.subtype = M ⊓ centralizer (V : Set G) := by
    rw [action_ker,subgroupOf_map_subtype,inf_comm]
  rwa [←he,card_map_of_injective M.subtype_injective] at hc

omit d in
/-- In the full-image branch of 15.2.22, the actual Y has elementary
core quotient and contains every corrected seed. -/
theorem Seed.le_full_residual
    (s : Seed M I (smallActionS T ZS) E)
    (hC : IsSmallActionThreePrime (M ⊓ centralizer (V : Set G))) :
    letI := hsource.prepared.elementary
    SourceCases.Omega (imageRepresentation M V hsource.prepared.normalized) →
    let Y := caseIIResidual T M (chosenStarredPreimage M V hsource.prepared.normalized) Mc
    Nat.card ((Y.subgroupOf M).map (action hsource)) = 9 →
    E ≤ Y ∧ Nonempty ((Y ⧸ pCore 2 Y) ≃*
      (Multiplicative (ZMod 3) × Multiplicative (ZMod 3))) := by
  let := hsource.prepared.elementary
  intro ho
  dsimp only
  intro hYbar
  let Y := caseIIResidual T M (chosenStarredPreimage M V hsource.prepared.normalized) Mc
  let A := Y.subgroupOf M
  let f := action hsource
  let e := ho.2.2.2.1.some
  have hf : Function.Surjective f := (actionHom M V hsource.prepared.normalized).rangeRestrict_surjective
  have hc : Nat.card (actionHom M V hsource.prepared.normalized).range = 36 :=
    (Nat.card_congr e.toEquiv).trans SymmetricThreeProduct.card_group
  have hk := centralizer_coprime (hsource := hsource) hC
  have hindex : Nat.Coprime 3 A.index := index_coprime_of_nine_image f hf hc hk A hYbar
  let : A.Normal := source_omega_lemma_15_2_3_2 T hsource.maximal.1.2
    hsource.prepared.normalized ho
  have hE : E ≤ Y := by
    have hp := s.primeToResidual_eq_top (T.isPGroup'.to_le inf_le_left)
    let j := inclusion (s.le_NI.trans inf_le_left)
    have hh := map_primeToResidual_le_of_hom 3 j
    rw [hp,←MonoidHom.range_eq_map] at hh
    intro x hx
    exact (primeToResidual_le A hindex) (hh ⟨⟨x,hx⟩,rfl⟩)
  refine ⟨hE,?_⟩
  obtain ⟨_,he | hx⟩ := source_omega_nine_residual_structure hsource.ambient T
    hsource.maximal.1 hsource.partner hsource.prepared ho hYbar
  · exact he.2.2.1
  · exfalso
    have hd : 27 ∣ Nat.card M := hx.1 ▸
      ((card_dvd_of_surjective ((QuotientGroup.mk' (pCore 2 M)).subgroupMap A)
        ((QuotientGroup.mk' (pCore 2 M)).subgroupMap_surjective A)).trans A.card_subgroup_dvd_card)
    exact not_twentyseven_dvd_of_coprime_kernel f hf hc hk hd

/-- A seed in the full residual is normal there: its normalizing S contains
the residual's two-core, and the original core quotient is abelian. -/
theorem Seed.full_residual_normalizes
    (s : Seed M I (smallActionS T ZS) E)
    (hC : IsSmallActionThreePrime (M ⊓ centralizer (V : Set G))) :
    letI := hsource.prepared.elementary
    SourceCases.Omega (imageRepresentation M V hsource.prepared.normalized) →
    let Y := caseIIResidual T M (chosenStarredPreimage M V hsource.prepared.normalized) Mc
    Nat.card ((Y.subgroupOf M).map (action hsource)) = 9 →
    E ≤ Y ∧ Y ≤ normalizer (E : Set G) := by
  let := hsource.prepared.elementary
  intro ho
  dsimp only
  intro hYbar
  let Y := caseIIResidual T M (chosenStarredPreimage M V hsource.prepared.normalized) Mc
  obtain ⟨hEY,⟨e⟩⟩ := s.le_full_residual hC ho hYbar
  have hYM : Y ≤ M := source_omega_caseIIResidual_le T hsource.maximal.1.2 hsource.prepared.normalized ho
  let : (Y.subgroupOf M).Normal := source_omega_lemma_15_2_3_2 T
    hsource.maximal.1.2 hsource.prepared.normalized ho
  let : IsMulCommutative (Y ⧸ pCore 2 Y) := ⟨⟨fun a b => e.injective (by simp only [map_mul,mul_comm])⟩⟩
  have hQS : Y.pCoreIn 2 ≤ smallActionS T ZS := by
    have hQM : Y.pCoreIn 2 ≤ M.pCoreIn 2 :=
      pCoreIn_mono_of_normalizes hYM ((normal_subgroupOf_iff_le_normalizer hYM).mp inferInstance)
    have hQT : M.pCoreIn 2 ≤ (T : Subgroup G) := by
      simpa only [Sylow.coe_subtype,map_subgroupOf_eq_of_le hsource.maximal.1.2] using
        pCoreIn_le_sylow M (T.subtype hsource.maximal.1.2)
    apply le_inf (hQM.trans hQT)
    rintro x hx
    obtain ⟨q,hq,rfl⟩ := hQM hx
    have hqC : (q : G) ∈ centralizer (V : Set G) := by
      have hh := source_omega_core_le_kernel hsource.prepared.normalized ho hq
      change q ∈ (action hsource).ker at hh
      rwa [action_ker] at hh
    exact centralizer_le d.geometry.plane_le hqC
  have hn : (E.subgroupOf Y).Normal := normal_of_isPPerfect_of_core_normalizes
    (E.subgroupOf Y)
    (s.perfect.of_surjective (subgroupOfEquivOfLe hEY).symm.toMonoidHom
      (subgroupOfEquivOfLe hEY).symm.surjective) (by
      intro q hq
      rw [←subgroupOf_normalizer_eq hEY]
      exact s.normalized (hQS (mem_map_of_mem Y.subtype hq)))
  exact ⟨hEY,(normal_subgroupOf_iff_le_normalizer hEY).mp hn⟩

/-- The full-image branch supplies the arbitrary-seed same-family relation
for every t in T, on the original ambient conjugation map. -/
theorem Seed.full_residual_conjugate_commutator
    (s : Seed M I (smallActionS T ZS) E)
    (hC : IsSmallActionThreePrime (M ⊓ centralizer (V : Set G)))
    (t : G) (ht : t ∈ (T : Subgroup G)) :
    letI := hsource.prepared.elementary
    SourceCases.Omega (imageRepresentation M V hsource.prepared.normalized) →
    let Y := caseIIResidual T M (chosenStarredPreimage M V hsource.prepared.normalized) Mc
    Nat.card ((Y.subgroupOf M).map (action hsource)) = 9 →
    ⁅E,E.map (MulAut.conj t).toMonoidHom⁆ ≤ E ⊓ E.map (MulAut.conj t).toMonoidHom := by
  let := hsource.prepared.elementary
  intro ho
  dsimp only
  intro hYbar
  let Y := caseIIResidual T M (chosenStarredPreimage M V hsource.prepared.normalized) Mc
  obtain ⟨hEY,hYE⟩ := s.full_residual_normalizes d hC ho hYbar
  have hYM := source_omega_caseIIResidual_le T hsource.maximal.1.2 hsource.prepared.normalized ho (Mc := Mc)
  let : (Y.subgroupOf M).Normal := source_omega_lemma_15_2_3_2 T
    hsource.maximal.1.2 hsource.prepared.normalized ho
  have htY : t ∈ normalizer (Y : Set G) :=
    ((normal_subgroupOf_iff_le_normalizer hYM).mp inferInstance) (hsource.maximal.1.2 ht)
  have hEtY : E.map (MulAut.conj t).toMonoidHom ≤ Y :=
    (map_mono hEY).trans_eq (mem_normalizer_iff_map_conj_eq.mp htY)
  exact le_inf
    (le_normalizer_iff_commutator_le_left.mp (hEtY.trans hYE))
    (le_normalizer_iff_commutator_le_right.mp
      (hEY.trans (normalizes_conjugate_of_normalizes htY hYE)))

/-- The arbitrary-seed 15.2.22 conclusion in the full residual-image branch.
Both same-family relations and the characteristic-two normalizer contradiction
are proved on the original subgroups. -/
theorem source_15_2_22_of_full_residual
    (hI : PlaneEscapes Mc ZS I) (hfit : generalizedFitting I = pCore 2 I)
    (s : Seed M I (smallActionS T ZS) E)
    (hC : IsSmallActionThreePrime (M ⊓ centralizer (V : Set G)))
    {t : G} (p : ResidualPair (T : Subgroup G) (smallActionS T ZS) (smallActionK H) t) :
    letI := hsource.prepared.elementary
    SourceCases.Omega (imageRepresentation M V hsource.prepared.normalized) →
    let Y := caseIIResidual T M (chosenStarredPreimage M V hsource.prepared.normalized) Mc
    Nat.card ((Y.subgroupOf M).map (action hsource)) = 9 →
    ¬ ⁅E,p.K₂⁆ ≤ E ⊓ p.K₂ := by
  let := hsource.prepared.elementary
  intro ho
  dsimp only
  intro hYbar
  exact commutator_exclusion_of_residualPair d hI hfit p s hC
    (s.full_residual_conjugate_commutator d hC t p.t_mem ho hYbar)

/-- Construct the conjugate residual factors and apply the arbitrary-seed
full-image branch, with no pair or commutator premise. -/
theorem exists_pair_exclusion_of_full_residual
    (hI : PlaneEscapes Mc ZS I) (hfit : generalizedFitting I = pCore 2 I)
    (hnot : ¬ IsSmallActionIrreducible (smallActionS T ZS) (smallActionK H))
    (s : Seed M I (smallActionS T ZS) E)
    (hC : IsSmallActionThreePrime (M ⊓ centralizer (V : Set G)))
    (t : G) (ht : t ∈ (T : Subgroup G)) (htS : t ∉ smallActionS T ZS) :
    letI := hsource.prepared.elementary
    SourceCases.Omega (imageRepresentation M V hsource.prepared.normalized) →
    let Y := caseIIResidual T M (chosenStarredPreimage M V hsource.prepared.normalized) Mc
    Nat.card ((Y.subgroupOf M).map (action hsource)) = 9 →
    ∃ p : ResidualPair (T : Subgroup G) (smallActionS T ZS) (smallActionK H) t,
      ¬ ⁅E,p.K₂⁆ ≤ E ⊓ p.K₂ := by
  let := hsource.prepared.elementary
  intro ho
  dsimp only
  intro hYbar
  obtain ⟨p⟩ := exists_residualPair d hI hnot t ht htS
  exact ⟨p,source_15_2_22_of_full_residual d hI hfit s hC p ho hYbar⟩

