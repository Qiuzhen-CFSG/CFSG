module
public import CFSG.Quasithin.Chapter15.Section02.SourcePlaneUniqueness.CharacteristicTwo.SmallActionsSource.StarReduction
public import Theory.GroupTheory.PResidual.CubicClosureTwoKernel

/-!
# The middle seed is the actual central cubic in the star quotient

The two-perfect seed is generated by its elements of order three, using
its intrinsic cubic two-core quotient. The earlier source centralizer-rank
calculation places each such element's star image in the center of the
actual extraspecial residual. The image is nontrivial because the star
kernel is a two-group, so it equals that center.

This retains Y₀ and M/O₂(M), and supplies the precise marking consumed by
ExtraspecialExclusion. Source: Aschbacher--Smith15.2.21(3), printed p.1114,
refs/quasithin.pdf.
-/

public noncomputable section
open Subgroup Stellmacher Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section02.SmallActionsSource
open Section01 ChapterD ChapterD.UniqueFactor PlaneUniquenessPreceding.OmegaAction
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {M Mc V H ZS I Y₀ : Subgroup G}
variable {hsource : ChosenSmallSource T M Mc V}

/-- The literal image of a two-perfect cubic seed in C_M(V) lies in the
actual extraspecial residual center. -/
theorem centralizing_seed_star_image_le_center
    (hY : Y₀ ≤ M ⊓ centralizer (V : Set G)) (hp : IsPPerfect 2 Y₀)
    (hYc : Nat.card (Y₀ ⧸ pCore 2 Y₀) = 3) :
    letI := hsource.prepared.elementary
    SourceCases.Omega (imageRepresentation M V hsource.prepared.normalized) →
    let Y := caseIIResidual T M (chosenStarredPreimage M V hsource.prepared.normalized) Mc
    let q := QuotientGroup.mk' (pCore 2 M)
    let P := (Y.subgroupOf M).map q
    Nat.card ((Y.subgroupOf M).map (action hsource)) = 9 →
    Nonempty (P ≃* HeisenbergPrime 3) →
    (Y₀.subgroupOf M).map q ≤ (center P).map P.subtype := by
  let := hsource.prepared.elementary
  dsimp only
  intro ho hcard he
  let Y := caseIIResidual T M (chosenStarredPreimage M V hsource.prepared.normalized) Mc
  let q := QuotientGroup.mk' (pCore 2 M)
  let P := (Y.subgroupOf M).map q
  let j := inclusion (hY.trans inf_le_left)
  let f := q.comp j
  let q₀ := QuotientGroup.mk' (pCore 2 Y₀)
  have hgen : closure {x : Y₀ | orderOf x = 3} = ⊤ := by
    rw [cubic_closure_eq_twoResidual_of_cube_image q₀
      (by rw [QuotientGroup.ker_mk']; exact pCore_isPGroup)
      (fun x => hYc ▸ pow_card_eq_one' (x := q₀ x))]
    exact (pResidual_eq_top_iff 2 Y₀).mpr hp
  have hle : closure {x : Y₀ | orderOf x = 3} ≤ ((center P).map P.subtype).comap f := by
    apply (closure_le _).mpr
    intro x hx
    have hx3 : (x : G) ^ 3 = 1 := congrArg Subtype.val (hx ▸ pow_orderOf_eq_one x)
    apply source_omega_extraspecial_star_cubic_mem_center hsource.ambient T hsource.maximal.1
      hsource.partner hsource.prepared ho hcard he
    · rw [omegaStarActor_ker]
      exact mem_map_of_mem q (hY x.property)
    · change (q (j x)) ^ 3 = 1
      rw [←map_pow,show (j x) ^ 3 = 1 from Subtype.ext hx3,map_one]
  rw [hgen] at hle
  rintro z ⟨x,hx,rfl⟩
  exact hle (mem_top (⟨x,hx⟩ : Y₀))

/-- The middle seed maps onto precisely the central cubic, with the
original quotient map. Its image cannot vanish through a two-group kernel. -/
theorem centralizing_seed_star_image_eq_center
    (hY : Y₀ ≤ M ⊓ centralizer (V : Set G)) (hp : IsPPerfect 2 Y₀)
    (hYc : Nat.card (Y₀ ⧸ pCore 2 Y₀) = 3) :
    letI := hsource.prepared.elementary
    SourceCases.Omega (imageRepresentation M V hsource.prepared.normalized) →
    let Y := caseIIResidual T M (chosenStarredPreimage M V hsource.prepared.normalized) Mc
    let q := QuotientGroup.mk' (pCore 2 M)
    let P := (Y.subgroupOf M).map q
    Nat.card ((Y.subgroupOf M).map (action hsource)) = 9 →
    Nonempty (P ≃* HeisenbergPrime 3) →
    (Y₀.subgroupOf M).map q = (center P).map P.subtype := by
  let := hsource.prepared.elementary
  dsimp only
  intro ho hcard ⟨eP⟩
  let Y := caseIIResidual T M (chosenStarredPreimage M V hsource.prepared.normalized) Mc
  let q := QuotientGroup.mk' (pCore 2 M)
  let P := (Y.subgroupOf M).map q
  let B := (Y₀.subgroupOf M).map q
  let C := (center P).map P.subtype
  have hle : B ≤ C := centralizing_seed_star_image_le_center hY hp hYc ho hcard ⟨eP⟩
  have hC : Nat.card C = 3 := by
    rw [card_map_of_injective P.subtype_injective,
      Nat.card_congr (centerCongr eP).toEquiv,HeisenbergPrime.card_center]
  have hBne : B ≠ ⊥ := by
    intro hbot
    have hk : Y₀.subgroupOf M ≤ pCore 2 M := by
      have hh := (Subgroup.map_eq_bot_iff _).mp hbot
      rwa [QuotientGroup.ker_mk'] at hh
    have hY2 : IsPGroup 2 Y₀ := (pCore_isPGroup.to_le hk).of_equiv
      (subgroupOfEquivOfLe (hY.trans inf_le_left))
    have hQ2 := hY2.of_surjective (QuotientGroup.mk' (pCore 2 Y₀))
      (QuotientGroup.mk'_surjective _)
    rcases hQ2.card_eq_or_dvd with h | h <;> rw [hYc] at h <;> omega
  have hB : Nat.card B = 3 := ((Nat.dvd_prime Nat.prime_three).mp
    (hC ▸ card_dvd_of_le hle)).resolve_left (fun h => hBne (card_eq_one.mp h))
  exact eq_of_le_of_card_ge hle (by rw [hB,hC])
end CFSG.Quasithin.Chapter15.Section02.SmallActionsSource
