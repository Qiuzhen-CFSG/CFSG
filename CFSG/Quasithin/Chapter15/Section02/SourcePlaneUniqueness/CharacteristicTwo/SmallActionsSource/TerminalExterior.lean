/-!
# The terminal exterior exclusion from the original wreath residual

The actual K = O²(H) has elementary-nine two-core quotient and is a
{2,3}-group. Hence K = O^{3′}(K). Its containment in the original plane
centralizer M₁ therefore gives K ≤ KI = O^{3′}(M₁), without an additional
S₃-square quotient premise.

In the exterior-five row the existing concrete model gives
KI/O₂(KI) ≃ C₃ × SL₃(2). The actual three-rank of K forces its intersection
with the characteristic cubic residual of KI to have rank one. This subgroup
is T-invariant. The wreath quotient proves T-irreducibility, which excludes
that rank-one intersection. The last theorem applies this argument to the
canonical action on U = [⟨ZS^X⟩,X], discharging both the pair-quotient and
T-irreducibility premises of the earlier exterior consumer.

The component-residual identity X = O^{3′}(I), component normality and K ≤ X
remain earlier component-preparation inputs of qt-e-152-char2-component-models.
The preceding geometry retains its source producers; final discharge remains
with qt-e-152-plane-uniqueness. This is the exterior branch of 15.2.23, not
the L₄(2) split exclusion of 15.2.21(3).

Source: Aschbacher--Smith, combined manuscript (1 March 2004),
15.2.21(1) and 15.2.23(d), printed pp.1114,1117; refs/quasithin.pdf.
The quotient intersection proof follows TerminalLinear.Exterior.Action with
its residual and action premises discharged from Factors and the wreath model.
-/

public section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
open scoped IsMulCommutative MatrixGroups
namespace CFSG.Quasithin.Chapter15.Section02.SmallActionsSource
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {M Mc V H ZS I X : Subgroup G}
variable {hsource : ChosenSmallSource T M Mc V}
variable (d : PlaneUniquenessPreceding hsource H ZS)
include d

/-- The original wreath residual is generated by its three-elements. -/
theorem residual_primeTo_three_eq_top : primeToResidual 3 (smallActionK H) = ⊤ := by
  let K := smallActionK H
  let e := ChosenGeometry.residualQuotientEquiv H d.geometry.quotient.some
  have hc : Nat.card (K ⧸ pCore 2 K) = 9 :=
    (Nat.card_congr e.toEquiv).trans
      Chapter13.Section08.Components.Swapped.LinearThree.WreathModel.cubicBase_card
  obtain ⟨r,hr⟩ := (pCore_isPGroup (p := 2) (G := K)).exists_card_eq
  have hpi : IsPiGroup twoThreePrimes K := by
    apply (IsPiGroup_iff _ _).mpr
    intro p hp
    rw [card_eq_card_quotient_mul_card_subgroup (pCore 2 K),hc,hr] at hp
    rcases p.property.dvd_mul.mp hp with hd | hd
    · have hd' : p.val ∣ 3^2 := hd
      exact Or.inr ((Nat.dvd_prime Nat.prime_three).mp
        (p.property.dvd_of_dvd_pow hd') |>.resolve_left p.property.ne_one)
    · exact Or.inl ((Nat.dvd_prime Nat.prime_two).mp
        (p.property.dvd_of_dvd_pow hd) |>.resolve_left p.property.ne_one)
  rw [← twoResidual_eq_primeToResidual_three hpi]
  exact (pResidual_eq_top_iff 2 K).mpr (isPPerfect_embedded_pResidual 2 H)

end CFSG.Quasithin.Chapter15.Section02.SmallActionsSource

namespace CFSG.Quasithin.Chapter15.Section02.TerminalLinear
variable {G : Type*} [Group G] [Finite G]
private theorem false_of_normal_rank_one {T K D : Subgroup G}
    (hp : IsPPerfect 2 K) (hr : 2 ≤ primeRank 3 K)
    (hirr : IsSmallActionIrreducible T K) (hDK : D ≤ K)
    (hn : K ≤ normalizer (D : Set G)) (hT : T ≤ normalizer (D : Set G))
    (hD : primeRank 3 D = 1) : False := by
  have hTc : T ≤ normalizer (K.pCoreIn 2 : Set G) := hirr.1.trans
    (normalizer_le_normalizer_characteristic_image K (pCore 2 K))
  have hTD : T ≤ normalizer ((D ⊔ K.pCoreIn 2 : Subgroup G) : Set G) :=
    (le_inf hT hTc).trans (normalizer_inf_normalizer_le_normalizer_sup _ _)
  rcases hirr.2 (D ⊔ K.pCoreIn 2) le_sup_right
      (sup_le hDK (pCoreIn_le 2 K)) hTD with he | he
  · have hpD : IsPGroup 2 D := (isPGroup_pCoreIn 2 K).to_le (le_sup_left.trans he.le)
    obtain ⟨n,hn⟩ := hpD.exists_card_eq
    have hz : primeRank 3 D = 0 := PrimeRank.eq_zero_iff_not_dvd_card.mpr (by
      rw [hn]
      exact (Nat.prime_three.coprime_iff_not_dvd).mp
        ((by decide : Nat.Coprime 3 2).pow_right n))
    omega
  · let N := D.subgroupOf K
    let : N.Normal := normal_subgroupOf_of_le_normalizer hn
    have hsup : N ⊔ pCore 2 K = ⊤ := by
      apply map_injective K.subtype_injective
      rw [Subgroup.map_sup,map_subgroupOf_eq_of_le hDK,
        ← MonoidHom.range_eq_map,range_subtype]
      exact he
    have hq := isPGroup_quotient_of_sup_eq_top N (pCore 2 K) pCore_isPGroup hsup
    have hN := hp N inferInstance hq
    have hKD : K ≤ D := by
      intro x hx
      have : (⟨x,hx⟩ : K) ∈ N := hN.symm ▸ mem_top _
      exact this
    have hh := primeRank_mono 3 hKD
    omega


open ChapterB.QuasisimpleSource Section01 SmallActionsSource
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {M Mc V H ZS I X : Subgroup G}
variable {hsource : ChosenSmallSource T M Mc V}
variable (d : PlaneUniquenessPreceding hsource H ZS)
include d

/-- The original K lies in KI by its wreath residual and plane centralization. -/
theorem K_le_KI_from_preceding
    (hKX : (pResidual 2 H).map H.subtype ≤ X) :
    (pResidual 2 H).map H.subtype ≤ KI X ZS := by
  have hh := embedded_primeToResidual_mono (p := 3)
    (show smallActionK H ≤ M1 X ZS from le_inf hKX d.residual_centralizes)
  rw [residual_primeTo_three_eq_top d, ← MonoidHom.range_eq_map, range_subtype] at hh
  exact hh

/-- The original T-invariant characteristic preimage meets K in rank one. -/
theorem exterior_intersection_rank_from_preceding
    (e : (KI X ZS ⧸ pCore 2 (KI X ZS)) ≃*
      (alternatingGroup (Fin 3) × SL(3,ZMod 2)))
    (hKX : (pResidual 2 H).map H.subtype ≤ X) :
    primeRank 3 ((pResidual 2 H).map H.subtype ⊓ twoThreeIn (KI X ZS) : Subgroup G) = 1 := by
  let A := KI X ZS
  let K := (pResidual 2 H).map H.subtype
  have hKA : K ≤ A := K_le_KI_from_preceding d hKX
  let B := K.subgroupOf A
  let C := (pCore 3 (A ⧸ pCore 2 A)).comap (QuotientGroup.mk' (pCore 2 A))
  have hr := BinaryLinear.ExteriorParabolic.cubicPreimage_intersection_rank e B (by
    rw [primeRank_equiv 3 (subgroupOfEquivOfLe hKA)]
    exact (PlaneUniquenessPreceding.LinearThree.residual_rank_two d).symm.le)
  have he : (B ⊓ C).map A.subtype = K ⊓ twoThreeIn A := by
    rw [Subgroup.map_inf _ _ _ A.subtype_injective,map_subgroupOf_eq_of_le hKA]
    rfl
  rw [← he, ← primeRank_equiv 3 ((B ⊓ C).equivMapOfInjective A.subtype A.subtype_injective)]
  exact hr

/-- The rank-one intersection lies in the original characteristic cubic
residual. Its Sylow three-subgroup supplies the lower bound, while the
constructed cubic residual supplies the upper bound. -/
theorem exterior_cubic_intersection_rank_from_preceding
    (hI : PlaneEscapes Mc ZS I) (hfit : generalizedFitting I = pCore 2 I)
    (hXI : X ≤ I) (hn : I ≤ normalizer (X : Set G))
    (hKX : (pResidual 2 H).map H.subtype ≤ X)
    {r : ℕ} (hr : r = 2 ∨ r = 3) :
    letI := U_elementary d hI hfit hXI
    Nonempty (ActionEquiv (U_representation d hI hfit hXI hn)
      (SL5TenDimensional.exteriorAction r)) →
    primeRank 3 ((pResidual 2 H).map H.subtype ⊓ cubicResidual X ZS : Subgroup G) = 1 := by
  let := U_elementary d hI hfit hXI
  intro he
  obtain ⟨e⟩ := KI_quotient_of_exterior d hI hfit hXI hn hr he
  let K := smallActionK H
  let C := twoThreeIn (KI X ZS)
  let D := K ⊓ C
  let R := K ⊓ cubicResidual X ZS
  let P : Sylow 3 D := Classical.choice inferInstance
  have hDP : primeRank 3 P = 1 := by
    rw [← P.primeRank_eq]
    exact exterior_intersection_rank_from_preceding d e hKX
  let f : P →* R :=
    { toFun := fun x => ⟨x.val.val,x.val.property.1,by
        change x.val.val ∈ (primeToResidual 3 C).map C.subtype
        apply mem_map.mpr
        refine ⟨⟨x.val.val,x.val.property.2⟩, ?_,rfl⟩
        obtain ⟨n,hn⟩ := P.isPGroup' x
        apply mem_primeToResidual_of_pow (n := n)
        exact Subtype.ext (congrArg (fun y : P => (y.val.val : G)) hn)⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl }
  have hf : Function.Injective f := by
    intro x y h
    apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun z : R => (z : G)) h
  have hl := Theory.GroupTheory.primeRank_le_of_injective 3 f hf
  rw [hDP] at hl
  exact le_antisymm ((primeRank_mono 3 (inf_le_right : R ≤ cubicResidual X ZS)).trans_eq
    (cubicResidual_rank_of_exterior d hI hfit hXI hn hr he)) hl

/-- The exterior row is excluded on the canonical action. The original
wreath model supplies the residual generation, rank and T-irreducibility;
no pair-quotient or irreducibility premise remains. -/
theorem not_exteriorFive_from_preceding
    (hI : PlaneEscapes Mc ZS I) (hfit : generalizedFitting I = pCore 2 I)
    (hXI : X ≤ I) (hn : I ≤ normalizer (X : Set G))
    (hX : X = (primeToResidual 3 I).map I.subtype)
    (hKX : (pResidual 2 H).map H.subtype ≤ X)
    {r : ℕ} (hr : r = 2 ∨ r = 3) :
    letI := U_elementary d hI hfit hXI
    ¬ Nonempty (ActionEquiv (U_representation d hI hfit hXI hn)
      (SL5TenDimensional.exteriorAction r)) := by
  let := U_elementary d hI hfit hXI
  intro he
  have hirr := sylow_irreducible d
  let K := smallActionK H
  let R := cubicResidual X ZS
  have hKR : K ≤ normalizer (R : Set G) :=
    (K_le_KI_from_preceding d hKX).trans (KI_normalizes_cubicResidual X ZS)
  have hTR : (T : Subgroup G) ≤ normalizer (R : Set G) :=
    cubicResidual_normalized d hI hX
  exact false_of_normal_rank_one (isPPerfect_embedded_pResidual 2 H)
    ((PlaneUniquenessPreceding.LinearThree.residual_rank_two d).symm.le) hirr (D := K ⊓ R) inf_le_left
    ((le_inf K.le_normalizer hKR).trans inf_normalizer_le_normalizer_inf)
    ((le_inf hirr.1 hTR).trans inf_normalizer_le_normalizer_inf)
    (exterior_cubic_intersection_rank_from_preceding d hI hfit hXI hn hKX hr he)


end CFSG.Quasithin.Chapter15.Section02.TerminalLinear
