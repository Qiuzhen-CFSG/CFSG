/-!
# Excluding the exterior-five row with the original cubic subgroup

The S₃-square quotient and the two-perfectness of K prove K ≤ KI. In the
constructed quotient KI/O₂(KI) ≅ C₃ × SL₃(2), projection to the second
factor forces K ∩ O₂,₃(KI) to have three-rank one. Its Sylow three-subgroup
lies in the original cubicResidual = O^{3′}(O₂,₃(KI)). Thus K intersects
that characteristic subgroup in three-rank one as well.

This intersection D is normalized by K and T. Adjoining O₂(K) makes it
an intermediate T-invariant subgroup of K/O₂(K). It is nontrivial by
its rank, and it is proper: otherwise two-perfectness of K would give
D = K, contrary to their different three-ranks. The earlier irreducibility
of T therefore excludes the exterior action on the original U.

The literal row consumer leaves only degree-five repeated-natural, retaining
its actual KI quotient and M₁ point-parabolic marking. Original-U recognition
and the minimal-parabolic exclusion remain with this terminal-linear owner.
The earlier component-residual identity and action clauses remain explicit
with qt-e-152-char2-component-models and qt-e-152-small-parabolic; their final
discharge belongs to qt-e-152-plane-uniqueness. No SmallActionCaseII core
identity or assumed terminal contradiction is used.

Source: Aschbacher--Smith 15.2.23(d), printed p.1117.
-/

public section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
open scoped IsMulCommutative MatrixGroups
namespace CFSG.Quasithin.Chapter15.Section02.TerminalLinear
open ChapterB.QuasisimpleSource Section01
variable {G : Type*} [Group G] [Finite G]

private theorem false_of_normal_rank_one {T K D : Subgroup G}
    (hp : IsPPerfect 2 K) (hr : 2 ≤ primeRank 3 K)
    (hirr : IsSmallActionIrreducible T K) (hDK : D ≤ K)
    (hn : K ≤ normalizer (D : Set G)) (hT : T ≤ normalizer (D : Set G))
    (hD : primeRank 3 D = 1) : False := by
  have hTc : T ≤ normalizer (K.pCoreIn 2 : Set G) := hirr.1.trans
    (normalizer_le_normalizer_characteristic_image K (pCore 2 K))
  have hTD : T ≤ normalizer ((D ⊔ K.pCoreIn 2 : Subgroup G) : Set G) :=
    (le_inf hT hTc).trans (normalizer_inf_normalizer_le_normalizer_sup _ _)
  rcases hirr.2 (D ⊔ K.pCoreIn 2) le_sup_right
      (sup_le hDK (pCoreIn_le 2 K)) hTD with he | he
  · have hpD : IsPGroup 2 D := (isPGroup_pCoreIn 2 K).to_le (le_sup_left.trans he.le)
    obtain ⟨n,hn⟩ := hpD.exists_card_eq
    have hz : primeRank 3 D = 0 := PrimeRank.eq_zero_iff_not_dvd_card.mpr (by
      rw [hn]
      exact (Nat.prime_three.coprime_iff_not_dvd).mp
        ((by decide : Nat.Coprime 3 2).pow_right n))
    omega
  · let N := D.subgroupOf K
    let : N.Normal := normal_subgroupOf_of_le_normalizer hn
    have hsup : N ⊔ pCore 2 K = ⊤ := by
      apply map_injective K.subtype_injective
      rw [Subgroup.map_sup,map_subgroupOf_eq_of_le hDK,
        ← MonoidHom.range_eq_map,range_subtype]
      exact he
    have hq := isPGroup_quotient_of_sup_eq_top N (pCore 2 K) pCore_isPGroup hsup
    have hN := hp N inferInstance hq
    have hKD : K ≤ D := by
      intro x hx
      have : (⟨x,hx⟩ : K) ∈ N := hN.symm ▸ mem_top _
      exact this
    have hh := primeRank_mono 3 hKD
    omega

variable {T : Sylow 2 G} {M Mc V H ZS I X : Subgroup G}
variable {hsource : ChosenSmallSource T M Mc V}
variable (d : PlaneUniquenessPreceding hsource H ZS)
include d

/-- The source S₃-square quotient forces K to be generated by its three-elements,
so its actual containment in M₁ strengthens to containment in KI. -/
theorem K_le_KI_of_pair
    (hKX : (pResidual 2 H).map H.subtype ≤ X)
    (hpair : Nonempty ((KS H T ZS ⧸ pCore 2 (KS H T ZS)) ≃*
      (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3)))) :
    (pResidual 2 H).map H.subtype ≤ KI X ZS := by
  let K := (pResidual 2 H).map H.subtype
  have hTH : (T : Subgroup G) ≤ H := by
    rw [← d.residual_sup_sylow]
    exact le_sup_right
  have hHn : H ≤ normalizer (K : Set G) := H.le_normalizer.trans
    (normalizer_le_normalizer_characteristic_image H (pResidual 2 H))
  have heK : (pResidual 2 (KS H T ZS)).map (KS H T ZS).subtype = K :=
    embedded_pResidual_join_pGroup K (planeSylow T ZS)
      (isPPerfect_embedded_pResidual 2 H) (T.isPGroup'.to_le inf_le_left)
      (inf_le_left.trans (hTH.trans hHn))
  obtain ⟨e⟩ := hpair
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 (KS H T ZS)))
  have hq : Function.Surjective q := e.surjective.comp (QuotientGroup.mk'_surjective _)
  have hk : IsPGroup 2 q.ker := by
    have he : q.ker = pCore 2 (KS H T ZS) := by
      ext x
      exact e.map_eq_one_iff.trans (QuotientGroup.eq_one_iff x)
    rw [he]
    exact pCore_isPGroup
  have hpi : IsPiGroup twoThreePrimes (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3)) := by
    apply (IsPiGroup_iff _ _).mpr
    intro p hp
    have hc : Nat.card (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3)) = 2 ^ 2 * 3 ^ 2 := by
      simp [Nat.card_eq_fintype_card, Fintype.card_perm, Nat.factorial]
    rw [hc] at hp
    rcases p.property.dvd_mul.mp hp with hp | hp
    · exact Or.inl ((Nat.dvd_prime Nat.prime_two).mp
        (p.property.dvd_of_dvd_pow hp) |>.resolve_left p.property.ne_one)
    · exact Or.inr ((Nat.dvd_prime Nat.prime_three).mp
        (p.property.dvd_of_dvd_pow hp) |>.resolve_left p.property.ne_one)
  have hr := twoResidual_eq_primeToResidual_three_of_two_kernel q hq hk
    (twoResidual_eq_primeToResidual_three hpi)
  have hKgen : (primeToResidual 3 K) = ⊤ := by
    have he : (primeToResidual 3 (KS H T ZS)).map (KS H T ZS).subtype = K := by
      rw [← hr]
      exact heK
    let a := (primeToResidual 3 (KS H T ZS)).equivMapOfInjective
      (KS H T ZS).subtype (KS H T ZS).subtype_injective
    let b := a.trans (MulEquiv.subgroupCongr he)
    have hid : primeToResidual 3 (primeToResidual 3 (KS H T ZS)) = ⊤ := by
      apply map_injective (primeToResidual 3 (KS H T ZS)).subtype_injective
      rw [embedded_primeToResidual_eq_of_normal 3 _ le_rfl,
        ← MonoidHom.range_eq_map, range_subtype]
    rw [← map_primeToResidual_of_surjective 3 b.toMonoidHom b.surjective,
      hid, map_top_of_surjective _ b.surjective]
  have hKM : K ≤ M1 X ZS := le_inf hKX d.residual_centralizes
  have hh := embedded_primeToResidual_mono (p := 3) hKM
  rw [hKgen, ← MonoidHom.range_eq_map, range_subtype] at hh
  exact hh

/-- The original T-invariant characteristic preimage meets K in rank one. -/
theorem exterior_intersection_rank
    (e : (KI X ZS ⧸ pCore 2 (KI X ZS)) ≃*
      (alternatingGroup (Fin 3) × SL(3,ZMod 2)))
    (hKX : (pResidual 2 H).map H.subtype ≤ X)
    (hpair : Nonempty ((KS H T ZS ⧸ pCore 2 (KS H T ZS)) ≃*
      (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3)))) :
    primeRank 3 ((pResidual 2 H).map H.subtype ⊓ twoThreeIn (KI X ZS) : Subgroup G) = 1 := by
  let A := KI X ZS
  let K := (pResidual 2 H).map H.subtype
  have hKA : K ≤ A := K_le_KI_of_pair d hKX hpair
  let B := K.subgroupOf A
  let C := (pCore 3 (A ⧸ pCore 2 A)).comap (QuotientGroup.mk' (pCore 2 A))
  have hr := BinaryLinear.ExteriorParabolic.cubicPreimage_intersection_rank e B (by
    rw [primeRank_equiv 3 (subgroupOfEquivOfLe hKA)]
    exact K_threeRank_ge_two d hpair)
  have he : (B ⊓ C).map A.subtype = K ⊓ twoThreeIn A := by
    rw [Subgroup.map_inf _ _ _ A.subtype_injective,map_subgroupOf_eq_of_le hKA]
    rfl
  rw [← he, ← primeRank_equiv 3 ((B ⊓ C).equivMapOfInjective A.subtype A.subtype_injective)]
  exact hr

/-- The rank-one intersection lies in the original characteristic cubic
residual. Its Sylow three-subgroup supplies the lower bound, while the
constructed cubic residual supplies the upper bound. -/
theorem exterior_cubic_intersection_rank
    (hI : PlaneEscapes Mc ZS I) (hfit : generalizedFitting I = pCore 2 I)
    (hXI : X ≤ I) (hn : I ≤ normalizer (X : Set G))
    (hKX : (pResidual 2 H).map H.subtype ≤ X)
    (hpair : Nonempty ((KS H T ZS ⧸ pCore 2 (KS H T ZS)) ≃*
      (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3))))
    {r : ℕ} (hr : r = 2 ∨ r = 3) :
    letI := U_elementary d hI hfit hXI
    Nonempty (ActionEquiv (U_representation d hI hfit hXI hn)
      (SL5TenDimensional.exteriorAction r)) →
    primeRank 3 ((pResidual 2 H).map H.subtype ⊓ cubicResidual X ZS : Subgroup G) = 1 := by
  let := U_elementary d hI hfit hXI
  intro he
  obtain ⟨e⟩ := KI_quotient_of_exterior d hI hfit hXI hn hr he
  let K := smallActionK H
  let C := twoThreeIn (KI X ZS)
  let D := K ⊓ C
  let R := K ⊓ cubicResidual X ZS
  let P : Sylow 3 D := Classical.choice inferInstance
  have hDP : primeRank 3 P = 1 := by
    rw [← P.primeRank_eq]
    exact exterior_intersection_rank d e hKX hpair
  let f : P →* R :=
    { toFun := fun x => ⟨x.val.val,x.val.property.1,by
        change x.val.val ∈ (primeToResidual 3 C).map C.subtype
        apply mem_map.mpr
        refine ⟨⟨x.val.val,x.val.property.2⟩, ?_,rfl⟩
        obtain ⟨n,hn⟩ := P.isPGroup' x
        apply mem_primeToResidual_of_pow (n := n)
        exact Subtype.ext (congrArg (fun y : P => (y.val.val : G)) hn)⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl }
  have hf : Function.Injective f := by
    intro x y h
    apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun z : R => (z : G)) h
  have hl := Theory.GroupTheory.primeRank_le_of_injective 3 f hf
  rw [hDP] at hl
  exact le_antisymm ((primeRank_mono 3 (inf_le_right : R ≤ cubicResidual X ZS)).trans_eq
    (cubicResidual_rank_of_exterior d hI hfit hXI hn hr he)) hl

/-- The exterior row contradicts the earlier T-irreducibility on K/O₂(K).
The invariant subgroup and its strict intermediate position are constructed,
with no rank-one containment assumption. -/
theorem not_exteriorFive_canonical
    (hI : PlaneEscapes Mc ZS I) (hfit : generalizedFitting I = pCore 2 I)
    (hXI : X ≤ I) (hn : I ≤ normalizer (X : Set G))
    (hX : X = (primeToResidual 3 I).map I.subtype)
    (hKX : (pResidual 2 H).map H.subtype ≤ X)
    (hpair : Nonempty ((KS H T ZS ⧸ pCore 2 (KS H T ZS)) ≃*
      (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3))))
    (hirr : IsSmallActionIrreducible (T : Subgroup G) (smallActionK H))
    {r : ℕ} (hr : r = 2 ∨ r = 3) :
    letI := U_elementary d hI hfit hXI
    ¬ Nonempty (ActionEquiv (U_representation d hI hfit hXI hn)
      (SL5TenDimensional.exteriorAction r)) := by
  let := U_elementary d hI hfit hXI
  intro he
  let K := smallActionK H
  let R := cubicResidual X ZS
  have hKR : K ≤ normalizer (R : Set G) :=
    (K_le_KI_of_pair d hKX hpair).trans (KI_normalizes_cubicResidual X ZS)
  have hTR : (T : Subgroup G) ≤ normalizer (R : Set G) :=
    cubicResidual_normalized d hI hX
  exact false_of_normal_rank_one (isPPerfect_embedded_pResidual 2 H)
    (K_threeRank_ge_two d hpair) hirr (D := K ⊓ R) inf_le_left
    ((le_inf K.le_normalizer hKR).trans inf_normalizer_le_normalizer_inf)
    ((le_inf hirr.1 hTR).trans inf_normalizer_le_normalizer_inf)
    (exterior_cubic_intersection_rank d hI hfit hXI hn hKX hpair hr he)

/-- Literal classification consumer after the exterior exclusion. The sole
surviving row is repeated-natural of degree five, with the original KI quotient
and M₁ point-parabolic marking. -/
theorem remaining_repeatedNatural_of_source
    (hI : PlaneEscapes Mc ZS I) (hfit : generalizedFitting I = pCore 2 I)
    (hXI : X ≤ I) (hn : I ≤ normalizer (X : Set G)) (hout : ¬ X ≤ Mc)
    (hX : X = (primeToResidual 3 I).map I.subtype)
    (hKX : (pResidual 2 H).map H.subtype ≤ X)
    (hpair : Nonempty ((KS H T ZS ⧸ pCore 2 (KS H T ZS)) ≃*
      (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3))))
    (hirr : IsSmallActionIrreducible (T : Subgroup G) (smallActionK H)) :
    letI := U_elementary d hI hfit hXI
    let σ := U_representation d hI hfit hXI hn
    ModuleRow σ →
      Nonempty ((KI X ZS ⧸ pCore 2 (KI X ZS)) ≃* SL(4,ZMod 2)) ∧
        ∃ r : ℕ, 0 < r ∧ r ≤ 4 ∧
          ∃ e : ActionEquiv σ (repeated (linearNatural BinaryField.two 5) r),
          ∃ v : Fin 5 → ZMod 2, v ≠ 0 ∧
            (((M1 X ZS).subgroupOf X).map (QuotientGroup.mk' (pCore 2 X))).map
              e.groupEquiv.toMonoidHom = MulAction.stabilizer SL(5,ZMod 2) v := by
  let := U_elementary d hI hfit hXI
  dsimp only
  intro hrow
  rcases remaining_rows_with_KI_quotient d hI hfit hXI hn hout hKX hpair hrow with h | h
  · exact h
  · obtain ⟨r,hr,_,_,he⟩ := h
    exact (not_exteriorFive_canonical d hI hfit hXI hn hX hKX hpair hirr hr he).elim

end CFSG.Quasithin.Chapter15.Section02.TerminalLinear
