module
public import CFSG.Quasithin.Chapter15.Section02.SourcePlaneUniqueness.CharacteristicTwo.ComponentModels.TerminalLinear.RepeatedNatural
public import Theory.SpecificGroups.BinaryLinear.FivePointQuotient
public import Theory.GroupTheory.PResidual.PrimeToCoreQuotient

/-!
# The original repeated-natural residual quotient

The point-stabilizer marking of M₁ is composed with the literal quotient
X → X/O₂(X). The resulting surjection has a two-group kernel. Restricting
it to O^{3′}(M₁) still surjects, because the degree-five point parabolic is
generated by its three-elements. Quotienting intrinsic two-cores therefore
constructs K_I/O₂(K_I) ≅ SL₄(2).

The final row consumer retains this quotient together with the action and
point-parabolic marking. Original-U recognition and the remaining
minimal-parabolic and exterior-five exclusions are still required.

Source: Aschbacher--Smith, 15.2.23(a), printed p.1117.
-/

set_option backward.isDefEq.respectTransparency false
public section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section02.TerminalLinear
open ChapterB.QuasisimpleSource Section01
variable {G : Type*} [Group G] [Finite G]

/-- An actual point-parabolic image identifies the literal prime-to-three
residual modulo its own two-core. -/
theorem KI_quotient_of_point_image {X ZS : Subgroup G}
    (e : (X ⧸ pCore 2 X) ≃* Matrix.SpecialLinearGroup (Fin 5) (ZMod 2))
    (v : Fin 5 → ZMod 2) (hv : v ≠ 0)
    (hmark : (((M1 X ZS).subgroupOf X).map (QuotientGroup.mk' (pCore 2 X))).map
      e.toMonoidHom = MulAction.stabilizer (Matrix.SpecialLinearGroup (Fin 5) (ZMod 2)) v) :
    Nonempty ((KI X ZS ⧸ pCore 2 (KI X ZS)) ≃*
      Matrix.SpecialLinearGroup (Fin 4) (ZMod 2)) := by
  let A := M1 X ZS
  let P := MulAction.stabilizer (Matrix.SpecialLinearGroup (Fin 5) (ZMod 2)) v
  let j : A →* X := inclusion inf_le_left
  let q := QuotientGroup.mk' (pCore 2 X)
  let f0 := e.toMonoidHom.comp (q.comp j)
  have hmem (a : A) : f0 a ∈ P := by
    dsimp only [P]
    rw [← hmark]
    exact mem_map_of_mem e.toMonoidHom (mem_map_of_mem q a.property)
  let f := f0.codRestrict P hmem
  have hf : Function.Surjective f := by
    intro p
    have hp := hmark.symm.le p.property
    obtain ⟨y,⟨x,hx,rfl⟩,he⟩ := hp
    exact ⟨⟨x,hx⟩, Subtype.ext he⟩
  have hk : IsPGroup 2 f.ker := by
    let k : f.ker →* pCore 2 X :=
      (j.comp f.ker.subtype).codRestrict _ (by
        intro a
        have he := congrArg P.subtype a.property
        change e (q (j a.val)) = 1 at he
        exact (QuotientGroup.eq_one_iff _).mp (e.map_eq_one_iff.mp he))
    apply pCore_isPGroup.of_injective k
    intro a b he
    apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun x : pCore 2 X => (x.val : G)) he
  let er := f.primeToResidualCoreQuotientEquiv 3 2 hf hk
    (BinaryLinear.PointStabilizerRank.five_point_primeToResidual v hv)
  obtain ⟨ep⟩ := BinaryLinear.PointStabilizerRank.five_point_quotient v hv
  let ei : primeToResidual 3 A ≃* KI X ZS :=
    (primeToResidual 3 A).equivMapOfInjective A.subtype A.subtype_injective
  exact ⟨((QuotientGroup.congr _ _ ei (pCore_map_iso 2 ei)).symm.trans er).trans ep⟩

/-- The repeated-natural source row constructs K_I/O₂(K_I) ≅ SL₄(2). -/
theorem KI_quotient_of_repeatedNatural
    {T : Sylow 2 G} {M Mc V H ZS I X : Subgroup G}
    {hsource : ChosenSmallSource T M Mc V}
    (d : PlaneUniquenessPreceding hsource H ZS)
    (hI : PlaneEscapes Mc ZS I) (hfit : generalizedFitting I = pCore 2 I)
    (hXI : X ≤ I) (hn : I ≤ normalizer (X : Set G))
    (r : ℕ) (hr : 0 < r) :
    letI := U_elementary d hI hfit hXI
    Nonempty (ActionEquiv (U_representation d hI hfit hXI hn)
      (repeated (linearNatural BinaryField.two 5) r)) →
    Nonempty ((KI X ZS ⧸ pCore 2 (KI X ZS)) ≃*
      Matrix.SpecialLinearGroup (Fin 4) (ZMod 2)) := by
  let := U_elementary d hI hfit hXI
  rintro ⟨e⟩
  obtain ⟨v,hv,he⟩ := M1_image_pointStabilizer_of_repeatedNatural
    d hI hfit hXI hn (by decide) hr e
  exact KI_quotient_of_point_image e.groupEquiv v hv he


/-- The literal row consumer retains the constructed residual quotient in the
degree-five repeated-natural alternative. No residual-model hypothesis remains. -/
theorem remaining_rows_with_KI_quotient
    {T : Sylow 2 G} {M Mc V H ZS I X : Subgroup G}
    {hsource : ChosenSmallSource T M Mc V}
    (d : PlaneUniquenessPreceding hsource H ZS)
    (hI : PlaneEscapes Mc ZS I) (hfit : generalizedFitting I = pCore 2 I)
    (hXI : X ≤ I) (hn : I ≤ normalizer (X : Set G)) (hout : ¬ X ≤ Mc)
    (hKX : (pResidual 2 H).map H.subtype ≤ X)
    (hpair : Nonempty ((KS H T ZS ⧸ pCore 2 (KS H T ZS)) ≃*
      (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3)))) :
    letI := U_elementary d hI hfit hXI
    let σ := U_representation d hI hfit hXI hn
    ModuleRow σ →
      (Nonempty ((KI X ZS ⧸ pCore 2 (KI X ZS)) ≃*
          Matrix.SpecialLinearGroup (Fin 4) (ZMod 2)) ∧
        ∃ r : ℕ, 0 < r ∧ r ≤ 4 ∧
          ∃ e : ActionEquiv σ (repeated (linearNatural BinaryField.two 5) r),
          ∃ v : Fin 5 → ZMod 2, v ≠ 0 ∧
            (((M1 X ZS).subgroupOf X).map (QuotientGroup.mk' (pCore 2 X))).map
              e.groupEquiv.toMonoidHom =
              MulAction.stabilizer (Matrix.SpecialLinearGroup (Fin 5) (ZMod 2)) v) ∨
      (∃ r : ℕ, (r = 2 ∨ r = 3) ∧ IsIrreducible σ ∧
        Module.finrank (ZMod 2) (Additive (U X ZS)) = 10 ∧
        Nonempty (ActionEquiv σ (Representation.SL5TenDimensional.exteriorAction r))) := by
  let := U_elementary d hI hfit hXI
  dsimp only
  intro hrow
  rcases remaining_rows_in_degree_five d hI hfit hXI hn hout hKX hpair hrow with h | h
  · obtain ⟨r,hr,hb,e,v,hv,he⟩ := h
    exact Or.inl ⟨KI_quotient_of_point_image e.groupEquiv v hv he, r,hr,hb,e,v,hv,he⟩
  · exact Or.inr h

end CFSG.Quasithin.Chapter15.Section02.TerminalLinear
