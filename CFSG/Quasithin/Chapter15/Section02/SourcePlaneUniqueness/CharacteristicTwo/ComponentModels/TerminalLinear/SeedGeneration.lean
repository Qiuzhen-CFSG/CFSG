module
public import CFSG.Quasithin.Chapter15.Section02.SourcePlaneUniqueness.CharacteristicTwo.ComponentModels.TerminalLinear.OriginalModule
public import Theory.GroupTheory.SylowSeedCommutator
public import Theory.Representation.BinaryOffender.SylowFixedGeneration

/-!
# The original U is generated by U∩ZS

The original plane is Ω₁Z(S), S is Sylow in I, and the conjugate span
lies in QI≤S. The Sylow-averaging theorem therefore applies to XS.
Its result is then transported to the literal X/O₂(X)-action, using the
stated conjugation equation. No centralizer alignment is an assumption.

Source: Aschbacher--Smith, 15.2.23, printed p.1116, using B.2.14.
-/

public section
open Subgroup Stellmacher Representation Representation.BinaryOffender Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section02.TerminalLinear
open Section01 PlaneUniquenessPreceding
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {M Mc V H ZS I X : Subgroup G}
variable {hsource : ChosenSmallSource T M Mc V}
variable (d : PlaneUniquenessPreceding hsource H ZS)
include d

/-- B.2.14 on the original subgroup, including its literal generating seed. -/
theorem U_seed_generates
    (hI : PlaneEscapes Mc ZS I) (hfit : generalizedFitting I = pCore 2 I)
    (hXI : X ≤ I) (hn : I ≤ normalizer (X : Set G)) :
    conjugateSpanBy (U X ZS ⊓ ZS) X = U X ZS := by
  let S := planeSylow T ZS
  have hSI : S ≤ I :=
    (le_sup_right.trans (d.residual_sup_planeSylow_le hI)).trans inf_le_right
  let := d.plane_span_elementary hI hfit hXI
  obtain ⟨P,hP⟩ := (show Chapter1.IsSylowIn 2 S I from d.sylow_in_escape hI).restrict
    (show S ≤ X ⊔ S from le_sup_right) (sup_le hXI hSI)
  exact conjugateSpanBy_moved_inf_omegaCenter X S ZS d.omega_center
    (hSI.trans hn)
    ((d.plane_span_le_planeParabolicCore hI hfit hXI).trans
      (d.planeParabolicCore_le_plane hI)) P hP

/-- The literal quotient action is generated by the same seed in additive
coordinates. No identification with the star quotient is made. -/
theorem U_seed_module_generates
    (hI : PlaneEscapes Mc ZS I) (hfit : generalizedFitting I = pCore 2 I)
    (hXI : X ≤ I) (hn : I ≤ normalizer (X : Set G))
    [IsElementaryAbelian 2 (U X ZS)]
    (σ : Representation (ZMod 2) (X ⧸ pCore 2 X) (Additive (U X ZS)))
    (hσ : ∀ (x : X) (u : Additive (U X ZS)),
      ((σ (QuotientGroup.mk' (pCore 2 X) x) u).toMul : G) =
        (x : G) * (u.toMul : G) * (x : G)⁻¹) :
    let Z := AddSubgroup.toZModSubmodule 2 (ZS.subgroupOf (U X ZS)).toAddSubgroup
    (⨆ g : X ⧸ pCore 2 X, Z.map (σ g)) = ⊤ := by
  let Z := AddSubgroup.toZModSubmodule 2 (ZS.subgroupOf (U X ZS)).toAddSubgroup
  let L := ⨆ g : X ⧸ pCore 2 X, Z.map (σ g)
  let C := L.toAddSubgroup.toSubgroup'.map (U X ZS).subtype
  have hseed : U X ZS ⊓ ZS ≤ C := by
    intro z hz
    exact ⟨⟨z,hz.1⟩, le_iSup_maps σ Z hz.2, rfl⟩
  have hXC : X ≤ normalizer (C : Set G) := by
    apply le_normalizer_iff.mpr
    intro x hx c hc
    obtain ⟨u,hu,rfl⟩ := hc
    let v := σ (QuotientGroup.mk' (pCore 2 X) ⟨x,hx⟩) (Additive.ofMul u)
    refine ⟨v.toMul, ?_, hσ ⟨x,hx⟩ (Additive.ofMul u)⟩
    exact (iSup_maps_invariant σ Z (mem_top _) (Additive.ofMul u)).2 hu
  have hUC : U X ZS ≤ C :=
    (U_seed_generates d hI hfit hXI hn).ge.trans (conjugateSpanBy_le hseed hXC)
  apply top_unique
  intro v _
  obtain ⟨u,hu,he⟩ := hUC v.toMul.property
  have he' : u = v.toMul := Subtype.ext he
  rw [he'] at hu
  exact hu

end CFSG.Quasithin.Chapter15.Section02.TerminalLinear
