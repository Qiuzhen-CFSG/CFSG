module

public import CFSG.Quasithin.Chapter15.Section02.SourcePlaneUniqueness.CharacteristicTwo.ComponentModels.Preparation
public import Theory.GroupTheory.PResidual.FiniteImage
public import Theory.GroupTheory.CyclicSubgroupNormalizer

/-!
# The original intersection action in 15.2.18(3)

The plane centralizer S is Sylow in NI = M ∩ I. Thus NI is generated by
S and its two-residual, and a central residual gives NI ≤ MI = Mc ∩ I.
Otherwise the preceding normalizer obstruction shows that the residual
image in the actual conjugation action of M on V is not normal. A cyclic
two-residual in that action is therefore impossible. This isolates genuine
Omega, using only a weakening of the earlier 15.2.13 action alternatives.

All action images below are formed from the original conjugation map;
the kernel is C_M(V). The final complement and point-stabilizer calculation
is separate from this reduction.

Source: Aschbacher--Smith, 15.2.18(3), printed p.1113, refs/quasithin.pdf.
The earlier restricted-action premise belongs to qt-e-152-plane-geometry
and qt-e-152-small-parabolic.
-/

public section
open Subgroup Stellmacher Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section02
open Section01 Section03 ChapterA.Section05To06 ChapterD ChapterD.UniqueFactor
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {M Mc V H ZS I : Subgroup G}
variable {hsource : ChosenSmallSource T M Mc V}

namespace PlaneUniquenessPreceding
variable (d : PlaneUniquenessPreceding hsource H ZS)
include d

/-- The actual S is Sylow in NI as well as I. -/
theorem planeSylow_in_intersection (hI : PlaneEscapes Mc ZS I) :
    Chapter1.IsSylowIn 2 (planeSylow T ZS) (M ⊓ I) :=
  Chapter1.IsSylowIn.restrict (d.sylow_in_escape hI)
    (le_inf (inf_le_left.trans hsource.maximal.1.2)
      ((le_sup_right.trans (d.residual_sup_planeSylow_le hI)).trans inf_le_right))
    inf_le_right

/-- The residual and the literal plane Sylow generate the original NI. -/
theorem intersection_residual_sup_planeSylow (hI : PlaneEscapes Mc ZS I) :
    (pResidual 2 (M ⊓ I : Subgroup G)).map (M ⊓ I).subtype ⊔ planeSylow T ZS = M ⊓ I := by
  obtain ⟨P,hP⟩ := d.planeSylow_in_intersection hI
  have hh := congrArg (Subgroup.map (M ⊓ I).subtype) (pResidual_sup_sylow_eq_top P)
  rwa [Subgroup.map_sup,hP,←MonoidHom.range_eq_map,range_subtype] at hh

/-- The first source alternative is exactly centralization by O²(NI). -/
theorem intersection_le_partner_iff_residual_centralizes (hI : PlaneEscapes Mc ZS I) :
    M ⊓ I ≤ Mc ⊓ I ↔
      (pResidual 2 (M ⊓ I : Subgroup G)).map (M ⊓ I).subtype ≤ centralizer (V : Set G) := by
  constructor
  · intro hn
    exact (embedded_pResidual_mono 2 (le_inf inf_le_left (hn.trans inf_le_left))).trans
      (d.partner_intersection_residual_le_module_centralizer.trans inf_le_right)
  · intro hx
    rw [←d.intersection_residual_sup_planeSylow hI]
    exact sup_le
      (le_inf (hx.trans ((centralizer_le d.geometry.plane_le).trans
        (d.centralizer_le_intersection hI) |>.trans inf_le_left))
        ((map_subtype_le _).trans inf_le_right))
      (le_sup_right.trans (d.residual_sup_planeSylow_le hI))

namespace OmegaAction

/-- The actual faithful action map M → M/C_M(V). -/
noncomputable abbrev action (h : ChosenSmallSource T M Mc V) :
    M →* internalActionImage M V h.prepared.normalized :=
  (actionHom M V h.prepared.normalized).rangeRestrict

/-- NI in that same action, not an independently chosen symmetric quotient. -/
noncomputable abbrev intersectionImage (h : ChosenSmallSource T M Mc V)
    (I : Subgroup G) : Subgroup (internalActionImage M V h.prepared.normalized) :=
  ((M ⊓ I).subgroupOf M).map (action h)

/-- The two-residual of the actual NI action. -/
noncomputable abbrev residualImage (h : ChosenSmallSource T M Mc V)
    (I : Subgroup G) : Subgroup (internalActionImage M V h.prepared.normalized) :=
  (pResidual 2 (intersectionImage h I)).map (intersectionImage h I).subtype

omit d in
/-- The conjugation kernel retains the literal centralizer in M. -/
theorem action_ker : (action hsource).ker = (centralizer (V : Set G)).subgroupOf M := by
  exact (MonoidHom.ker_rangeRestrict (actionHom M V hsource.prepared.normalized)).trans
    (actionHom_ker M V hsource.prepared.normalized)

omit d in
/-- Residual formation commutes with the literal NI action image. -/
theorem residualImage_eq : residualImage hsource I =
    (((pResidual 2 (M ⊓ I : Subgroup G)).map (M ⊓ I).subtype).subgroupOf M).map
      (action hsource) := by
  let N : Subgroup G := M ⊓ I
  have hNM : N ≤ M := inf_le_left
  have he : ((pResidual 2 (N.subgroupOf M)).map (N.subgroupOf M).subtype).map M.subtype =
      (pResidual 2 N).map N.subtype := by
    rw [map_embedded_pResidual,map_subgroupOf_eq_of_le hNM]
  have he' := congrArg (Subgroup.comap M.subtype) he
  rw [comap_map_eq_self_of_injective M.subtype_injective] at he'
  change (pResidual 2 (intersectionImage hsource I)).map (intersectionImage hsource I).subtype = _
  rw [←map_embedded_pResidual,he']
  rfl

omit d in
/-- The full preimage of the residual image is precisely X C_M(V). -/
theorem residualImage_preimage :
    ((residualImage hsource I).comap (action hsource)).map M.subtype =
      (pResidual 2 (M ⊓ I : Subgroup G)).map (M ⊓ I).subtype ⊔
        (M ⊓ centralizer (V : Set G)) := by
  rw [residualImage_eq,comap_map_eq,Subgroup.map_sup,
    map_subgroupOf_eq_of_le ((map_subtype_le _).trans inf_le_left),action_ker,
    subgroupOf_map_subtype,inf_comm (centralizer (V : Set G)) M]

/-- The source obstruction rules out normality in the whole M-action. -/
theorem residualImage_not_normal (hI : PlaneEscapes Mc ZS I)
    (hout : ¬ M ⊓ I ≤ Mc ⊓ I) : ¬ (residualImage hsource I).Normal := by
  intro hn
  let hc := hn.comap (action hsource)
  have hMn : M ≤ normalizer
      ((((residualImage hsource I).comap (action hsource)).map M.subtype : Subgroup G) : Set G) := by
    intro m hm
    exact ((residualImage hsource I).comap (action hsource)).le_normalizer_map M.subtype
      (mem_map_of_mem M.subtype (show (⟨m,hm⟩ : M) ∈
        normalizer (((residualImage hsource I).comap (action hsource) : Subgroup M) : Set M) from
          by rw [normalizer_eq_top]; exact mem_top _))
  rw [residualImage_preimage] at hMn
  exact d.residual_join_centralizer_not_normalized hI
    (fun hx => hout ((d.intersection_le_partner_iff_residual_centralizes hI).mpr hx))
    (hsource.maximal.1.2.trans hMn)

/-- The cyclic-residual alternatives of 15.2.13 cannot escape MI. -/
theorem intersection_le_partner_of_cyclic_residual (hI : PlaneEscapes Mc ZS I)
    [IsCyclic (pResidual 2 (internalActionImage M V hsource.prepared.normalized))] :
    M ⊓ I ≤ Mc ⊓ I := by
  by_contra hout
  apply residualImage_not_normal d hI hout
  apply normalizer_eq_top_iff.mp
  apply top_unique
  exact (le_normalizer_of_normal (H := pResidual 2
    (internalActionImage M V hsource.prepared.normalized))).trans
      (normalizer_le_normalizer_of_le_cyclic _ _
        (map_pResidual_le 2 (intersectionImage hsource I).subtype))

/-- Genuine Omega is forced in the second branch. The disjunction supplied here
is only the cyclic-residual weakening of the earlier restricted action list;
it contains no conclusion about NI, its index, or its quotient. -/
theorem omega_of_not_le_partner (hI : PlaneEscapes Mc ZS I)
    (ha : letI := hsource.prepared.elementary;
      IsCyclic (pResidual 2 (internalActionImage M V hsource.prepared.normalized)) ∨
        SourceCases.Omega (imageRepresentation M V hsource.prepared.normalized))
    (hout : ¬ M ⊓ I ≤ Mc ⊓ I) :
    letI := hsource.prepared.elementary;
    SourceCases.Omega (imageRepresentation M V hsource.prepared.normalized) := by
  let := hsource.prepared.elementary
  rcases ha with hc | ho
  · let := hc
    exact (hout (intersection_le_partner_of_cyclic_residual d hI)).elim
  · exact ho

end OmegaAction
end PlaneUniquenessPreceding
end CFSG.Quasithin.Chapter15.Section02
