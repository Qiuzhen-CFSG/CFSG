variable {G : Type*} [Group G] [Finite G] {I X R N : Subgroup G}

private noncomputable def coreStarCover
    (h : Input KnownSimple.IsKnownSimple I R N X) :
    Cover (X ⧸ pCore 2 X) (starImage X R X) where
  toMonoidHom := coreToStar h.normalizes
  surjective := coreToStar_surjective h.normalizes
  isPerfect := h.quasisimple.toIsPerfect
  ker_le_center := coreToStar_ker_central_from_source h

/-- The original core-to-star central covering induces the indicated central-quotient isomorphism. -/
noncomputable def coreStarCenterEquiv
    (h : Input KnownSimple.IsKnownSimple I R N X) :
    ((X ⧸ pCore 2 X) ⧸ center (X ⧸ pCore 2 X)) ≃*
      (starImage X R X ⧸ center (starImage X R X)) :=
  (coreStarCover h).quotientCenterEquiv

/-- A centerless alternating star row identifies the central quotient of the full core quotient. -/
noncomputable def alternatingStarCoreCenterEquiv
    (h : Input KnownSimple.IsKnownSimple I R N X)
    {n : ℕ} (hn : 5 ≤ n) (e : starImage X R X ≃* alternatingGroup (Fin n)) :
    ((X ⧸ pCore 2 X) ⧸ center (X ⧸ pCore 2 X)) ≃* alternatingGroup (Fin n) := by
  let f : Cover (X ⧸ pCore 2 X) (alternatingGroup (Fin n)) :=
    { toMonoidHom := e.toMonoidHom.comp (coreToStar h.normalizes)
      surjective := e.surjective.comp (coreToStar_surjective h.normalizes)
      isPerfect := h.quasisimple.toIsPerfect
      ker_le_center := by
        rw [MonoidHom.ker_comp_of_injective _ _ e.injective]
        exact coreToStar_ker_central_from_source h }
  exact f.quotientCenterEquiv.trans
    ((QuotientGroup.quotientMulEquivOfEq
      (alternatingGroup.center_eq_bot (by simpa only [Nat.card_fin] using (show 4 ≤ n by omega)))).trans
        QuotientGroup.quotientBot)

private noncomputable def quotientCenterCongr {A B : Type*} [Group A] [Group B]
    (e : A ≃* B) : (A ⧸ center A) ≃* (B ⧸ center B) :=
  QuotientGroup.congr _ _ e (by
    apply le_antisymm
    · rintro _ ⟨a, ha, rfl⟩
      exact (centerCongr e ⟨a, ha⟩).property
    · intro b hb
      exact ⟨e.symm b, ((centerCongr e).symm ⟨b, hb⟩).property, e.apply_symm_apply b⟩)

private theorem alternating_central_quotient_rank {A : Type*} [Group A] [Finite A]
    {n : ℕ} (hn : n = 6 ∨ n = 7)
    (e : (A ⧸ center A) ≃* alternatingGroup (Fin n)) : 2 ≤ primeRank 3 A := by
  by_contra hh
  let P : Sylow 3 A := default
  have hc : IsCyclic P := P.isCyclic_of_odd_of_primeRank_le_one (by decide) (by omega)
  let f := e.toMonoidHom.comp (QuotientGroup.mk' (center A))
  have hf : Function.Surjective f := e.surjective.comp (QuotientGroup.mk'_surjective _)
  have hr := P.primeRank_le_one_of_surjective hc f hf
  rw [GLS3.Chapter5.PRank.alternating_primeRank_of_odd_prime n 3
    Nat.prime_three (by decide)] at hr
  rcases hn with rfl | rfl <;> norm_num at hr

variable {T : Sylow 2 G} {M Mc V H ZS : Subgroup G}
variable {hsource : ChosenSmallSource T M Mc V}
variable (d : PlaneUniquenessPreceding hsource H ZS)

include hsource in
/-- For an alternating central quotient of degree six or seven, the selected component is the cubic closure of the original I. -/
theorem alternating_component_cubic_closure
    (hI : PlaneEscapes Mc ZS I) (s : Selected H M I X)
    (hz : Nat.card (center (X ⧸ pCore 2 X)) ≤ 3)
    {n : ℕ} (hn : n = 6 ∨ n = 7)
    (e : ((X ⧸ pCore 2 X) ⧸ center (X ⧸ pCore 2 X)) ≃*
      alternatingGroup (Fin n)) :
    closure {x : G | x ∈ I ∧ orderOf x = 3} = X := by
  let Y := X.subgroupOf I
  let eY : Y ≃* X := subgroupOfEquivOfLe s.component.1
  let eQ : (Y ⧸ pCore 2 Y) ≃* (X ⧸ pCore 2 X) :=
    QuotientGroup.congr _ _ eY (pCore_map_iso 2 eY)
  let eA := (quotientCenterCongr eQ).trans e
  let : IsQuasisimple (X ⧸ pCore 2 X) := s.quasisimple
  let : IsQuasisimple (Y ⧸ pCore 2 Y) := IsQuasisimple.of_mulEquiv eQ.symm
  have hzY : Nat.card (center (Y ⧸ pCore 2 Y)) ≤ 3 := by
    rwa [Nat.card_congr (centerCongr eQ).toEquiv]
  have hrY : 2 ≤ primeRank 3 (Y ⧸ pCore 2 Y) :=
    alternating_central_quotient_rank hn eA
  have hrI : primeRank 3 I ≤ 2 :=
    (Chapter1.RadicalExclusions.sqtk_of_mem_H hsource.ambient hI.1).stronglyQuasithin
      3 Nat.prime_three (by decide)
  let : Y.Normal := s.component.2.normal_of_cubic_core_center_threeRank hzY hrY hrI
  have he : closure {x : I | orderOf x = 3} = Y := by
    rcases hn with rfl | rfl
    · exact SixCComponentTheta.cubic_closure_eq_of_central_quotient_six Y
        s.component.2 eA hrI
    · apply le_antisymm
      · apply (closure_le Y).mpr
        intro x hx
        exact SevenCComponentTheta.order_three_mem_of_central_quotient_seven Y
          s.component.2 eA hrI hx
      · let : Group.IsPerfect Y := s.component.2.perfect
        have hr : 2 ≤ primeRank 3 Y := hrY.trans
          (primeRank_quotient_le_of_isTwoGroup 3 (by decide) _ pCore_isPGroup)
        have hzc : primeRank 3 (center (Y ⧸ pCore 2 Y)) ≤ 1 := by
          let : Fact (Nat.Prime 3) := ⟨Nat.prime_three⟩
          apply primeRank_le_of_card_le_prime_pow (n := 1)
          simpa using hzY
        have hg := cubic_closure_eq_top_of_twoCore_quasisimple hr hzc
        have hm := congrArg (map Y.subtype) hg
        rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, range_subtype] at hm
        rw [← hm]
        apply Subgroup.closure_mono
        rintro x ⟨y, hy, rfl⟩
        exact (Y.orderOf_coe y).trans hy
  have hm := congrArg (map I.subtype) he
  rw [MonoidHom.map_closure, map_subgroupOf_eq_of_le s.component.1] at hm
  convert hm using 1
  congr 1
  ext x
  constructor
  · rintro ⟨hxI, hx⟩
    exact ⟨⟨x, hxI⟩, (I.orderOf_coe _).symm.trans hx, rfl⟩
  · rintro ⟨y, hy, rfl⟩
    exact ⟨y.property, (I.orderOf_coe y).trans hy⟩

include hsource in
/-- The alternating component is normal relative to I. -/
theorem alternating_component_normalized
    (hI : PlaneEscapes Mc ZS I) (s : Selected H M I X)
    (hz : Nat.card (center (X ⧸ pCore 2 X)) ≤ 3)
    {n : ℕ} (hn : n = 6 ∨ n = 7)
    (e : ((X ⧸ pCore 2 X) ⧸ center (X ⧸ pCore 2 X)) ≃*
      alternatingGroup (Fin n)) : I ≤ normalizer (X : Set G) := by
  rw [← alternating_component_cubic_closure (hsource := hsource) hI s hz hn e]
  apply le_normalizer_closure_iff.mpr
  intro g hg x hx
  refine subset_closure ⟨I.mul_mem (I.mul_mem hg hx.1) (I.inv_mem hg), ?_⟩
  exact (MulAut.conj g).orderOf_eq x |>.trans hx.2

include hsource in
/-- The selected alternating component is generated by its cubic elements, hence equals its own cubic residual. -/
theorem alternating_component_threeResidual_eq_top
    (hI : PlaneEscapes Mc ZS I) (s : Selected H M I X)
    (hz : Nat.card (center (X ⧸ pCore 2 X)) ≤ 3)
    {n : ℕ} (hn : n = 6 ∨ n = 7)
    (e : ((X ⧸ pCore 2 X) ⧸ center (X ⧸ pCore 2 X)) ≃*
      alternatingGroup (Fin n)) : primeToResidual 3 X = ⊤ := by
  have ht := alternating_component_cubic_closure (hsource := hsource) hI s hz hn e
  have hX : X ≤ (primeToResidual 3 X).map X.subtype := by
    refine (le_of_eq ht.symm).trans ?_
    apply (closure_le _).mpr
    rintro x ⟨hxI, hx⟩
    have hxX : x ∈ X := ht ▸ subset_closure ⟨hxI, hx⟩
    refine ⟨⟨x, hxX⟩, ?_, rfl⟩
    apply mem_primeToResidual_of_pow (n := 1)
    apply Subtype.ext
    simpa only [coe_pow, coe_one, pow_one, hx] using pow_orderOf_eq_one x
  apply map_injective X.subtype_injective
  rw [← MonoidHom.range_eq_map, range_subtype]
  exact le_antisymm (map_subtype_le _) hX

include d in
/-- Intrinsic movement and the genuine earlier Kc premise exclude containment of this component in Mc. -/
theorem normalized_alternating_component_not_le_partner
    (horbit : smallActionKc H Mc = smallActionK H ∨
      ∃ L : Subgroup G, L ∈ Chapter1.L G T ∧
        smallActionKc H Mc = componentOrbit L (T : Subgroup G))
    (hI : PlaneEscapes Mc ZS I) (hcore : (M ⊓ I).pCoreIn 2 = M.pCoreIn 2)
    (s : Normalized H M I X) {n : ℕ} (hn : n = 6 ∨ n = 7)
    (e : ((X ⧸ pCore 2 X) ⧸ center (X ⧸ pCore 2 X)) ≃*
      alternatingGroup (Fin n)) : ¬ X ≤ Mc := by
  let h := normalized_component_input (hsource := hsource) hI hcore s
  have hz : Nat.card (center (X ⧸ pCore 2 X)) ≤ 3 := by
    rcases coreQuotient_center_card_from_source h with hh | hh <;> omega
  let : Group.IsPerfect (X.subgroupOf I) := s.component.2.perfect
  let : Group.IsPerfect X := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe s.component.1).toMonoidHom)
    (subgroupOfEquivOfLe s.component.1).surjective
  intro hx
  exact d.no_normal_perfect_threeResidual horbit hI s.component.1
    (alternating_component_normalized (hsource := hsource) hI s.toSelected hz hn e) hx
    (alternating_component_threeResidual_eq_top (hsource := hsource) hI s.toSelected hz hn e)
    (input_intrinsic_movement h)

include d in
/-- The actual wreath quotient generates the embedded O²(H) by elements of order three. -/
theorem residual_cubic_closure :
    closure {x : G | x ∈ (pResidual 2 H).map H.subtype ∧ orderOf x = 3} =
      (pResidual 2 H).map H.subtype := by
  let K := (pResidual 2 H).map H.subtype
  obtain ⟨eH⟩ := d.geometry.quotient
  let eK := (pResidual 2 H).equivMapOfInjective H.subtype H.subtype_injective
  have hp : IsPPerfect 2 K := (isPPerfect_pResidual 2 (G := H)).of_surjective
    eK.toMonoidHom eK.surjective
  let r := ChosenGeometry.residualQuotientEquiv H eH
  let : IsElementaryAbelian 3 (K ⧸ pCore 2 K) :=
    IsElementaryAbelian.of_injective r.toMonoidHom r.injective
  have hc : ∀ x : K ⧸ pCore 2 K, x ^ 3 = 1 :=
    Monoid.exponent_dvd_iff_forall_pow_eq_one.mp (IsElementaryAbelian.exponent_dvd_p 3 _)
  have hg := cubic_closure_eq_top_of_twoPerfect_of_quotient_cube hp hc
  have hm := congrArg (map K.subtype) hg
  rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, range_subtype] at hm
  convert hm using 1
  congr 1
  ext x
  constructor
  · rintro ⟨hxK, hx⟩
    exact ⟨⟨x, hxK⟩, (K.orderOf_coe _).symm.trans hx, rfl⟩
  · rintro ⟨y, hy, rfl⟩
    exact ⟨y.property, (K.orderOf_coe y).trans hy⟩

include d in
/-- Cubic closure places the original O²(H) in C_X(ZS). -/
theorem alternating_component_residual_le_M1
    (hI : PlaneEscapes Mc ZS I) (s : Selected H M I X)
    (hz : Nat.card (center (X ⧸ pCore 2 X)) ≤ 3)
    {n : ℕ} (hn : n = 6 ∨ n = 7)
    (e : ((X ⧸ pCore 2 X) ⧸ center (X ⧸ pCore 2 X)) ≃*
      alternatingGroup (Fin n)) :
    (pResidual 2 H).map H.subtype ≤ M1 X ZS := by
  refine le_inf ?_ d.residual_centralizes
  rw [← alternating_component_cubic_closure (hsource := hsource) hI s hz hn e,
    ← residual_cubic_closure d]
  apply Subgroup.closure_mono
  rintro x ⟨hx, ho⟩
  exact ⟨((le_sup_left.trans (d.residual_sup_planeSylow_le hI)).trans inf_le_right) hx, ho⟩

include d in
/-- Placement on the actual A₆ or A₇ star row, with its original radical and component. -/
theorem alternating_star_residual_le_M1
    (hI : PlaneEscapes Mc ZS I) (hcore : (M ⊓ I).pCoreIn 2 = M.pCoreIn 2)
    (s : Normalized H M I X) {n : ℕ} (hn : n = 6 ∨ n = 7)
    (e : starImage X ((M ⊓ I).pCoreIn 2) X ≃* alternatingGroup (Fin n)) :
    (pResidual 2 H).map H.subtype ≤ M1 X ZS := by
  let h := normalized_component_input (hsource := hsource) hI hcore s
  have hz : Nat.card (center (X ⧸ pCore 2 X)) ≤ 3 := by
    rcases coreQuotient_center_card_from_source h with hh | hh <;> omega
  exact alternating_component_residual_le_M1 d hI s.toSelected hz hn
    (alternatingStarCoreCenterEquiv h (by rcases hn with rfl | rfl <;> decide) e)

include d in
/-- Placement for the actual 3.A₆ star row, retaining the central covering. -/
theorem tripleSix_star_residual_le_M1
    (hI : PlaneEscapes Mc ZS I) (hcore : (M ⊓ I).pCoreIn 2 = M.pCoreIn 2)
    (s : Normalized H M I X)
    (e : (starImage X ((M ⊓ I).pCoreIn 2) X ⧸
      center (starImage X ((M ⊓ I).pCoreIn 2) X)) ≃* alternatingGroup (Fin 6)) :
    (pResidual 2 H).map H.subtype ≤ M1 X ZS := by
  let h := normalized_component_input (hsource := hsource) hI hcore s
  have hz : Nat.card (center (X ⧸ pCore 2 X)) ≤ 3 := by
    rcases coreQuotient_center_card_from_source h with hh | hh <;> omega
  exact alternating_component_residual_le_M1 d hI s.toSelected hz (Or.inl rfl)
    ((coreStarCenterEquiv h).trans e)

include d in
private theorem intersection_rank_of_residual_placement
    (hI : PlaneEscapes Mc ZS I) (hXI : X ≤ I)
    (hK : (pResidual 2 H).map H.subtype ≤ M1 X ZS)
    (hpair : Nonempty ((KS H T ZS ⧸ pCore 2 (KS H T ZS)) ≃*
      (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3)))) :
    (pResidual 2 H).map H.subtype ≤ (Mc ⊓ I) ⊓ X ∧
      primeRank 3 (M1 X ZS) = 2 ∧ primeRank 3 ((Mc ⊓ I) ⊓ X : Subgroup G) = 2 := by
  have hM1 : M1 X ZS ≤ (Mc ⊓ I) ⊓ X :=
    le_inf (M1_le_partner_intersection d hI hXI) inf_le_left
  have hl := K_threeRank_ge_two d hpair
  have hu := (Chapter1.RadicalExclusions.sqtk_of_mem_H hsource.ambient hI.1).stronglyQuasithin
    3 Nat.prime_three (by decide)
  have hl1 := hl.trans (primeRank_mono 3 hK)
  have hl0 := hl1.trans (primeRank_mono 3 hM1)
  have hu0 := (primeRank_mono 3 (inf_le_left.trans inf_le_right : (Mc ⊓ I) ⊓ X ≤ I)).trans hu
  have hu1 := (primeRank_mono 3 hM1).trans hu0
  exact ⟨hK.trans hM1, by omega, by omega⟩

include d in
/-- The actual KS quotient forces three-rank two in C_X(ZS) and M₀ for the alternating rows. -/
theorem alternating_star_intersection_rank
    (hI : PlaneEscapes Mc ZS I) (hcore : (M ⊓ I).pCoreIn 2 = M.pCoreIn 2)
    (s : Normalized H M I X) {n : ℕ} (hn : n = 6 ∨ n = 7)
    (e : starImage X ((M ⊓ I).pCoreIn 2) X ≃* alternatingGroup (Fin n))
    (hpair : Nonempty ((KS H T ZS ⧸ pCore 2 (KS H T ZS)) ≃*
      (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3)))) :
    (pResidual 2 H).map H.subtype ≤ (Mc ⊓ I) ⊓ X ∧
      primeRank 3 (M1 X ZS) = 2 ∧ primeRank 3 ((Mc ⊓ I) ⊓ X : Subgroup G) = 2 :=
  intersection_rank_of_residual_placement d hI s.component.1
    (alternating_star_residual_le_M1 d hI hcore s hn e) hpair

include d in
/-- The same original quotient forces three-rank two for the triple-six row. -/
theorem tripleSix_star_intersection_rank
    (hI : PlaneEscapes Mc ZS I) (hcore : (M ⊓ I).pCoreIn 2 = M.pCoreIn 2)
    (s : Normalized H M I X)
    (e : (starImage X ((M ⊓ I).pCoreIn 2) X ⧸
      center (starImage X ((M ⊓ I).pCoreIn 2) X)) ≃* alternatingGroup (Fin 6))
    (hpair : Nonempty ((KS H T ZS ⧸ pCore 2 (KS H T ZS)) ≃*
      (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3)))) :
    (pResidual 2 H).map H.subtype ≤ (Mc ⊓ I) ⊓ X ∧
      primeRank 3 (M1 X ZS) = 2 ∧ primeRank 3 ((Mc ⊓ I) ⊓ X : Subgroup G) = 2 :=
  intersection_rank_of_residual_placement d hI s.component.1
    (tripleSix_star_residual_le_M1 d hI hcore s e) hpair

include d in
/-- The original A₆ or A₇ star component lies outside Mc. -/
theorem alternating_star_not_le_partner
    (horbit : smallActionKc H Mc = smallActionK H ∨
      ∃ L : Subgroup G, L ∈ Chapter1.L G T ∧
        smallActionKc H Mc = componentOrbit L (T : Subgroup G))
    (hI : PlaneEscapes Mc ZS I) (hcore : (M ⊓ I).pCoreIn 2 = M.pCoreIn 2)
    (s : Normalized H M I X) {n : ℕ} (hn : n = 6 ∨ n = 7)
    (e : starImage X ((M ⊓ I).pCoreIn 2) X ≃* alternatingGroup (Fin n)) :
    ¬ X ≤ Mc :=
  normalized_alternating_component_not_le_partner d horbit hI hcore s hn
    (alternatingStarCoreCenterEquiv
      (normalized_component_input (hsource := hsource) hI hcore s)
      (by rcases hn with rfl | rfl <;> decide) e)

include d in
/-- The original triple-six star component lies outside Mc. -/
theorem tripleSix_star_not_le_partner
    (horbit : smallActionKc H Mc = smallActionK H ∨
      ∃ L : Subgroup G, L ∈ Chapter1.L G T ∧
        smallActionKc H Mc = componentOrbit L (T : Subgroup G))
    (hI : PlaneEscapes Mc ZS I) (hcore : (M ⊓ I).pCoreIn 2 = M.pCoreIn 2)
    (s : Normalized H M I X)
    (e : (starImage X ((M ⊓ I).pCoreIn 2) X ⧸
      center (starImage X ((M ⊓ I).pCoreIn 2) X)) ≃* alternatingGroup (Fin 6)) :
    ¬ X ≤ Mc :=
  normalized_alternating_component_not_le_partner d horbit hI hcore s (Or.inl rfl)
    ((coreStarCenterEquiv
      (normalized_component_input (hsource := hsource) hI hcore s)).trans e)

