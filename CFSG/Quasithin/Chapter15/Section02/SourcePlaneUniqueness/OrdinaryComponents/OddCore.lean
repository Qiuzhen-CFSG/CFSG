module

public import CFSG.Quasithin.Chapter15.Section02.SourcePlaneUniqueness.OrdinaryComponents.InvolutionSetup
public import CFSG.Quasithin.ChapterA.Section01.RankActions.SourceActions
public import Theory.GroupTheory.PResidual.SubnormalCoreAction
public import Theory.GroupTheory.NoncentralChiefRefinement.ResidualCentralization
public import Theory.GroupTheory.PGroup.NormalSubgroups
public import Theory.ElementaryAbelian.Injective

/-!
# The odd core of an escaping plane overgroup

The prepared module has two noncentral H-chief factors, so K = O²(H)
cannot centralize U_H. Thus U_K = [U_H,K] is nontrivial. It is elementary,
T-invariant, and lies in S, and A.1.26 makes it centralize O(I). A central
involution of T in U_K then puts O(I) in Mc. The actual 1.1.5 intersection
conclusion forces O(I) = 1. No odd-core or component premise is retained.

Source: Aschbacher--Smith, 15.2.20(3), printed p.1113, refs/quasithin.pdf.
-/

public section

open Subgroup Stellmacher Theory.GroupTheory NoncentralChiefRefinement
namespace CFSG.Quasithin.Chapter15.Section02.OrdinaryComponents
open Section01 Section03 ChapterA.Section05To06 ChapterD.UniqueFactor
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {M Mc V H ZS : Subgroup G}
variable {hsource : ChosenSmallSource T M Mc V}
variable (d : PlaneUniquenessPreceding hsource H ZS)
include d

/-- The literal U_K = [U_H,K], where U_H is the H-span of the chosen module. -/
abbrev movedModule (H V : Subgroup G) : Subgroup G :=
  ⁅conjugateSpanBy V H, (pResidual 2 H).map H.subtype⁆

/-- The moved module is nontrivial, elementary, T-invariant, and generated by its K-commutators. -/
theorem movedModule_data :
    movedModule H V ≠ ⊥ ∧ IsElementaryAbelian 2 (movedModule H V) ∧
    movedModule H V ≤ planeSylow T ZS ∧
    (T : Subgroup G) ≤ normalizer (movedModule H V : Set G) ∧
    ⁅movedModule H V, (pResidual 2 H).map H.subtype⁆ = movedModule H V := by
  let U := conjugateSpanBy V H
  let K := (pResidual 2 H).map H.subtype
  let W := ⁅U,K⁆
  have hd := hsource.prepared.chief_data hsource.ambient T hsource.empty
    hsource.maximal hsource.centralizing H d.geometry.outside
  have hUe : IsElementaryAbelian 2 U := by
    change IsElementaryAbelian 2 (conjugateSpanBy V H)
    rw [← ChapterD.UniqueFactor.conjugateSpan_eq H V]
    exact hd.1
  let := hUe
  have hTH : (T : Subgroup G) ≤ H := d.geometry.outside.1.1.2
  have hVH : V ≤ H := (hsource.prepared.inside_core H d.geometry.outside).trans (twoCore_le H)
  have hUH : U ≤ H := conjugateSpanBy_le_self hVH
  have hHU : H ≤ normalizer (U : Set G) := le_normalizer_conjugateSpanBy _ _
  have hKH : K ≤ H := map_subtype_le _
  have hHK : H ≤ normalizer (K : Set G) := by
    simpa only [normalizer_eq_top, ← MonoidHom.range_eq_map,range_subtype] using
      (pResidual 2 H).le_normalizer_map H.subtype
  let : (U.subgroupOf H).Normal := normal_subgroupOf_of_le_normalizer hHU
  have hUT : U ≤ (T : Subgroup G) := by
    have hp : IsPGroup 2 (U.subgroupOf H) := (IsElementaryAbelian.isPGroup 2 U).comap_subtype
    have hh := hp.le_sylow_of_normal (T.subtype hTH)
    intro x hx
    exact hh (show (⟨x,hUH hx⟩ : H) ∈ U.subgroupOf H from hx)
  have hUS : U ≤ planeSylow T ZS := le_inf hUT
    (le_centralizer_iff_isMulCommutative.mpr inferInstance |>.trans
      (centralizer_le (d.geometry.plane_le.trans (le_conjugateSpanBy _ _))))
  have hWU : W ≤ U := le_normalizer_iff_commutator_le_left.mp (hKH.trans hHU)
  have hWn : H ≤ normalizer (W : Set G) := by
    intro x hx
    rw [mem_normalizer_iff_map_conj_eq]
    change ⁅U,K⁆.map (MulAut.conj x).toMonoidHom = ⁅U,K⁆
    have heU : U.map (MulAut.conj x).toMonoidHom = U := mem_normalizer_iff_map_conj_eq.mp (hHU hx)
    have heK : K.map (MulAut.conj x).toMonoidHom = K := mem_normalizer_iff_map_conj_eq.mp (hHK hx)
    rw [map_commutator,heU,heK]
  have hne : W ≠ ⊥ := by
    intro hb
    have hc : K ≤ centralizer (U : Set G) :=
      le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hb)
    let := hd.1
    obtain ⟨s⟩ := SeriesOn.exists_series ((ChapterD.conjugateSpan H V).subgroupOf H)
    have hpU : IsPGroup 2 ((ChapterD.conjugateSpan H V).subgroupOf H) :=
      (IsElementaryAbelian.isPGroup 2 (ChapterD.conjugateSpan H V)).comap_subtype
    have hz := s.noncentralCount_eq_zero_of_residual_centralizes hpU (by
        intro k hk u hu
        have hu' : (u : G) ∈ U := by
          change (u : G) ∈ ChapterD.conjugateSpan H V at hu
          simpa only [ChapterD.UniqueFactor.conjugateSpan_eq] using hu
        exact Subtype.ext (hc (mem_map_of_mem H.subtype hk) u hu'))
    have ht : s.noncentralCount = 2 := hd.2 s
    omega
  exact ⟨hne, IsElementaryAbelian.of_injective (inclusion hWU) (inclusion_injective _),
    hWU.trans hUS,hTH.trans hWn,
    commutator_isPPerfect_idempotent K U (isPPerfect_embedded_pResidual 2 H)
      (IsElementaryAbelian.isPGroup 2 U) (hKH.trans hHU)⟩

/-- A nonidentity central involution of T lies in the actual moved module. -/
theorem exists_central_moved_involution :
    ∃ z : G, z ∈ centralInvolutions T ∧ z ≠ 1 ∧ z ∈ movedModule H V := by
  obtain ⟨hne,he,hle,hn,_⟩ := movedModule_data d
  let W := movedModule H V
  let := he
  have hWT : W ≤ (T : Subgroup G) := hle.trans inf_le_left
  let : (W.subgroupOf (T : Subgroup G)).Normal := normal_subgroupOf_of_le_normalizer hn
  let : Nontrivial (W.subgroupOf (T : Subgroup G)) := by
    apply (nontrivial_iff_ne_bot _).mpr
    intro hb
    have hh := map_subgroupOf_eq_of_le hWT
    rw [hb,Subgroup.map_bot] at hh
    exact hne hh.symm
  let : Fact (IsPGroup 2 T) := ⟨T.isPGroup'⟩
  obtain ⟨x,hx,hxc⟩ := exists_nontrivial_center_mem_normal (W.subgroupOf (T : Subgroup G)) (p := 2)
  have hx2 : ((x : T) : G) ^ 2 = 1 := by
    exact elemPow_eq_one_of_isElementaryAbelian (A := W) (x : G) x.property
  refine ⟨x,?_,?_,x.property⟩
  · refine ⟨(x : T), ⟨⟨(x : T),hxc⟩,subset_closure ?_,rfl⟩,rfl⟩
    change (⟨(x : T),hxc⟩ : center T) ^ (2 ^ 1) = 1
    apply Subtype.ext
    apply Subtype.ext
    simpa using hx2
  · intro hh
    apply hx
    exact Subtype.ext (Subtype.ext hh)

/-- A.1.26 applied inside the literal escaping I makes U_K centralize its odd core. -/
theorem movedModule_centralizes_oddCore {I : Subgroup G} (hI : PlaneEscapes Mc ZS I) :
    movedModule H V ≤ centralizer ((pPrimeCore 2 I).map I.subtype : Set G) := by
  obtain ⟨_,he,hle,_,hcomm⟩ := movedModule_data d
  let W := movedModule H V
  let K := (pResidual 2 H).map H.subtype
  have hWI : W ≤ I := hle.trans
    ((le_sup_right.trans (d.residual_sup_planeSylow_le hI)).trans inf_le_right)
  have hKI : K ≤ I :=
    (le_sup_left.trans (d.residual_sup_planeSylow_le hI)).trans inf_le_right
  let := he
  let : IsElementaryAbelian 2 (W.subgroupOf I) := IsElementaryAbelian.subgroupOf hWI
  have hp : IsPPerfect 2 (K.subgroupOf I) :=
    (isPPerfect_embedded_pResidual 2 H).of_surjective
      (subgroupOfEquivOfLe hKI).symm.toMonoidHom (subgroupOfEquivOfLe hKI).symm.surjective
  have hcommI : ⁅W.subgroupOf I,K.subgroupOf I⁆ = W.subgroupOf I := by
    apply map_injective I.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le hWI,map_subgroupOf_eq_of_le hKI,hcomm]
  have hh := ChapterA.lemma_A_1_26_1_of_stronglyQuasithin
    (Chapter3.sqtk_of_mem_H hsource.ambient hI.1).stronglyQuasithin
    (K.subgroupOf I) (W.subgroupOf I) hp hcommI
  have hmap := congrArg (Subgroup.map I.subtype) hh
  rw [map_commutator,map_subgroupOf_eq_of_le hWI,Subgroup.map_bot] at hmap
  exact commutator_eq_bot_iff_le_centralizer.mp hmap

/-- Original 15.2.20(3): every escaping overgroup has trivial odd core. -/
theorem oddCore_eq_bot {I : Subgroup G} (hI : PlaneEscapes Mc ZS I) :
    pPrimeCore 2 I = ⊥ := by
  obtain ⟨z,hz,hzne,hzW⟩ := exists_central_moved_involution d
  obtain ⟨P,hP⟩ := d.sylow_in_escape hI
  have hmark := lemma115 d hI P hP hz hzne
  have hc := movedModule_centralizes_oddCore d hI hzW
  apply bot_unique
  intro r hr
  have hrM : (r : G) ∈ Mc := by
    rw [← (marked_centralizer d hI hz hzne).2]
    exact mem_centralizer_singleton_iff.mpr (hc r (mem_map_of_mem I.subtype hr))
  have hh : (⟨r,hrM⟩ : Mc.subgroupOf I) ∈
      (pPrimeCore 2 I).subgroupOf (Mc.subgroupOf I) := hr
  rw [hmark.oddCore_intersection_eq_bot] at hh
  exact congrArg Subtype.val (mem_bot.mp hh)

end CFSG.Quasithin.Chapter15.Section02.OrdinaryComponents
