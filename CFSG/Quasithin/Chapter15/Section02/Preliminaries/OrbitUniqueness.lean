module

public import CFSG.Quasithin.Chapter15.Section01.ChosenNormalizerSource
public import CFSG.Quasithin.Chapter15.Section01.RatioReduction.PreparedChosen

/-!
# The central-seed uniqueness criterion at the start of Case II

The original chosen module V is generated by the M₀-conjugates of Z ∩ V.
If M₀ lies in X N_M(Z ∩ V), the same seed is generated by X: the right
factor preserves the seed, so each M₀-conjugate is an X-conjugate.
The alternative containment in X C_M(V) implies this normalizer condition.
For a maximal local L containing X, the literal L ∩ M orbit therefore
also generates V. Source 14.1.4 supplies the ordering L ≼ M, and A.5.6
forces L = M.

The final application uses X = YT, exactly the uniqueness conclusion
of 15.2.3(3) reused in 15.2.6. The orbit identity under M₀ is the earlier
15.1.5(1) input; it is deliberately distinguished from the weaker orbit
identity under M in `PreparedChosenModule`.

Source: Aschbacher--Smith, combined manuscript (1 March 2004),
15.1.5(1), printed p.1087, and 15.2.2--3, printed pp.1104--1105.
-/

public section
open Subgroup Stellmacher Theory.GroupTheory
open scoped Pointwise
namespace CFSG.Quasithin.Chapter15.Section02
open Section01 Section03 Section03.InitialSource ChapterA.Section05To06
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
private theorem seed_orbit_le_of_product (Z M₀ X N : Subgroup G)
    (hN : N ≤ normalizer (Z : Set G))
    (hprod : (M₀ : Set G) ⊆ (X : Set G) * (N : Set G)) :
    conjugateSpanBy Z M₀ ≤ conjugateSpanBy Z X := by
  apply (closure_le _).mpr
  rintro _ ⟨m, hm, z, hz, rfl⟩
  obtain ⟨x, hx, n, hn, rfl⟩ := hprod hm
  have hnz : n * z * n⁻¹ ∈ Z := (mem_normalizer_iff.mp (hN hn) z).mp hz
  exact subset_closure ⟨x, hx, n * z * n⁻¹, hnz, by group⟩

omit [Finite G] in
/-- The literal source products preserve the orbit of Z ∩ V. -/
theorem source_seed_span_of_product (T : Sylow 2 G)
    {M M₀ V X : Subgroup G} (hXM : X ≤ M)
    (hn : M ≤ normalizer (V : Set G))
    (hspan : V = conjugateSpanBy (centralInvolutions T ⊓ V) M₀)
    (hprod : (M₀ : Set G) ⊆ (X : Set G) *
      ((M ⊓ centralizer (V : Set G) : Subgroup G) : Set G) ∨
      (M₀ : Set G) ⊆ (X : Set G) *
      ((M ⊓ normalizer (centralInvolutions T ⊓ V : Set G) : Subgroup G) : Set G)) :
    V = conjugateSpanBy (centralInvolutions T ⊓ V) X := by
  apply le_antisymm ?_ (conjugateSpanBy_le inf_le_right (hXM.trans hn))
  apply hspan.le.trans
  rcases hprod with hc | hn
  · have hcentral : M ⊓ centralizer (V : Set G) ≤
        centralizer (centralInvolutions T ⊓ V : Set G) :=
      inf_le_right.trans (centralizer_le (show centralInvolutions T ⊓ V ≤ V from inf_le_right))
    exact seed_orbit_le_of_product _ _ _ _
      (hcentral.trans (centralizer_le_normalizer _)) hc
  · exact seed_orbit_le_of_product _ _ _ _ inf_le_right hn

/-- The A.5.6 argument used in 15.2.2, with the actual source ordering supplied. -/
theorem source_unique_overgroup_of_seed_span
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M V X : Subgroup G} [IsElementaryAbelian 2 V]
    (hM : IsOrderingMaximal T M)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hTX : (T : Subgroup G) ≤ X) (hXM : X ≤ M)
    (hVne : V ≠ ⊥) (hn : M ≤ normalizer (V : Set G))
    (hspan : V = conjugateSpanBy (centralInvolutions T ⊓ V) X) :
    maximalTwoLocalOvergroups X = {M} := by
  ext L
  constructor
  · rintro ⟨hL, hXL⟩
    have hLM : L ≤ M := by
      apply le_of_generated_intersection hM.1.1
        (source_ordering_of_centralizing_orderingMaximal hG T hempty hM hJ
          L ⟨hL, hTX.trans hXL⟩) hVne (IsElementaryAbelian.isPGroup 2 V) ?_ hn
      apply le_antisymm
      · calc
          V = conjugateSpanBy (centralInvolutions T ⊓ V) X := hspan
          _ ≤ conjugateSpanBy (V ⊓ centralOmega T) (L ⊓ M) :=
            conjugateSpanBy_mono (by rw [inf_comm]) (le_inf hXL hXM)
      · exact conjugateSpanBy_le inf_le_left (inf_le_right.trans hn)
    exact Set.mem_singleton_iff.mpr (le_antisymm hLM (hL.2 hM.1.1.1 hLM))
  · rintro rfl
    exact ⟨hM.1.1, hXM⟩

/-- Original 15.2.2 from the earlier 15.1.5(1) orbit identity.
`M₀` is the original subgroup occurring in that identity; the proof is
independent of its chosen presentation as a Jhat preimage. -/
theorem source_lemma_15_2_2
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M M₀ V X : Subgroup G} (hM : IsOrderingMaximal T M)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hV : PreparedChosenModule T M V)
    (hTX : (T : Subgroup G) ≤ X) (hXM : X ≤ M)
    (hspan : V = conjugateSpanBy (centralInvolutions T ⊓ V) M₀)
    (hprod : (M₀ : Set G) ⊆ (X : Set G) *
      ((M ⊓ centralizer (V : Set G) : Subgroup G) : Set G) ∨
      (M₀ : Set G) ⊆ (X : Set G) *
      ((M ⊓ normalizer (centralInvolutions T ⊓ V : Set G) : Subgroup G) : Set G)) :
    maximalTwoLocalOvergroups X = {M} := by
  let := hV.elementary
  exact source_unique_overgroup_of_seed_span hG T hempty hM hJ hTX hXM
    hV.nontrivial hV.normalized (source_seed_span_of_product T hXM hV.normalized hspan hprod)

omit [Finite G] in
private theorem product_of_action_image_le
    {M M₀ V X : Subgroup G} (hn : M ≤ normalizer (V : Set G))
    (hM₀M : M₀ ≤ M)
    (himage : (M₀.subgroupOf M).map (ChapterD.UniqueFactor.actionHom M V hn) ≤
      (X.subgroupOf M).map (ChapterD.UniqueFactor.actionHom M V hn)) :
    (M₀ : Set G) ⊆ (X : Set G) *
      ((M ⊓ centralizer (V : Set G) : Subgroup G) : Set G) := by
  intro m hm
  let m' : M := ⟨m, hM₀M hm⟩
  let f := ChapterD.UniqueFactor.actionHom M V hn
  have hx : f m' ∈ (X.subgroupOf M).map f :=
    himage (mem_map_of_mem f (show m' ∈ M₀.subgroupOf M from hm))
  obtain ⟨x, hx, he⟩ := hx
  have hc : x⁻¹ * m' ∈ f.ker := by
    change f (x⁻¹ * m') = 1
    rw [map_mul, map_inv, he, inv_mul_cancel]
  rw [ChapterD.UniqueFactor.actionHom_ker] at hc
  exact ⟨x, hx, (x : G)⁻¹ * m, ⟨M.mul_mem (M.inv_mem x.property) m'.property, hc⟩,
    by simp⟩

/-- The action-image version of 15.2.2, retaining the original M₀, X,
chosen V, and literal conjugation homomorphism. -/
theorem source_unique_overgroup_of_action_image
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M M₀ V X : Subgroup G} (hM : IsOrderingMaximal T M)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hV : PreparedChosenModule T M V)
    (hTX : (T : Subgroup G) ≤ X) (hXM : X ≤ M) (hM₀M : M₀ ≤ M)
    (hspan : V = conjugateSpanBy (centralInvolutions T ⊓ V) M₀)
    (himage : (M₀.subgroupOf M).map (ChapterD.UniqueFactor.actionHom M V hV.normalized) ≤
      (X.subgroupOf M).map (ChapterD.UniqueFactor.actionHom M V hV.normalized)) :
    maximalTwoLocalOvergroups X = {M} :=
  source_lemma_15_2_2 hG T hempty hM hJ hV hTX hXM hspan
    (Or.inl (product_of_action_image_le hV.normalized hM₀M himage))

/-- In the M₀ = M rows of 15.2.1, the prepared chosen module discharges
15.1.5(1), leaving only the literal full-action condition on X. -/
theorem source_unique_overgroup_of_full_action
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M V X : Subgroup G} (hM : IsOrderingMaximal T M)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hV : PreparedChosenModule T M V)
    (hTX : (T : Subgroup G) ≤ X) (hXM : X ≤ M)
    (himage : (ChapterD.UniqueFactor.actionHom M V hV.normalized).range ≤
      (X.subgroupOf M).map (ChapterD.UniqueFactor.actionHom M V hV.normalized)) :
    maximalTwoLocalOvergroups X = {M} := by
  apply source_unique_overgroup_of_action_image hG T hempty hM hJ hV hTX hXM le_rfl hV.seed_span
  simpa only [subgroupOf_self, ← MonoidHom.range_eq_map] using himage

/-- The actual 15.2.3(3) consumer: the original residual Y yields the unique
maximal local overgroup of YT once its source image contains M₀. -/
theorem source_residual_sylow_unique_overgroup
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M M₀ V Y : Subgroup G} (hM : IsOrderingMaximal T M)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hV : PreparedChosenModule T M V) (hYM : Y ≤ M)
    (hspan : V = conjugateSpanBy (centralInvolutions T ⊓ V) M₀)
    (hprod : (M₀ : Set G) ⊆ ((Y ⊔ (T : Subgroup G) : Subgroup G) : Set G) *
      ((M ⊓ centralizer (V : Set G) : Subgroup G) : Set G)) :
    maximalTwoLocalOvergroups (Y ⊔ (T : Subgroup G)) = {M} :=
  source_lemma_15_2_2 hG T hempty hM hJ hV le_sup_right
    (sup_le hYM hM.1.2) hspan (Or.inl hprod)

/-- Source 15.2.3(3) through the actual action-image containment.
The earlier residual structure supplies this containment on YT. -/
theorem source_residual_sylow_unique_of_action_image
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M M₀ V Y : Subgroup G} (hM : IsOrderingMaximal T M)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hV : PreparedChosenModule T M V) (hYM : Y ≤ M) (hM₀M : M₀ ≤ M)
    (hspan : V = conjugateSpanBy (centralInvolutions T ⊓ V) M₀)
    (himage : (M₀.subgroupOf M).map (ChapterD.UniqueFactor.actionHom M V hV.normalized) ≤
      ((Y ⊔ (T : Subgroup G)).subgroupOf M).map
        (ChapterD.UniqueFactor.actionHom M V hV.normalized)) :
    maximalTwoLocalOvergroups (Y ⊔ (T : Subgroup G)) = {M} :=
  source_unique_overgroup_of_action_image hG T hempty hM hJ hV le_sup_right
    (sup_le hYM hM.1.2) hM₀M hspan himage

end CFSG.Quasithin.Chapter15.Section02
