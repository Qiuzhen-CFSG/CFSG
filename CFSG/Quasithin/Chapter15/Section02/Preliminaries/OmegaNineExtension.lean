/-!
# The genuine central-extension alternatives above the order-nine image

The residual's image is E₉. Source15.2.3(5) centralizes its action kernel,
so the star residual has class at most two. The original intersection core
contains an image inverter. The normalizing cover lifts it to an involution
and forces the whole star residual to be generated by cubic elements.
Thus it is a three-group of exponent three. Its surjection onto E₉ and the
standing quasithin bound give rank exactly two, and A.1.24 identifies it
with E₉ or the prime Heisenberg group of order27.

The final theorem transports these actual models through the original
Y/O₂(Y) quotient. No central-extension model, generation premise, kernel
faithfulness on Y, or rank premise is retained.

Source: Aschbacher--Smith15.2.3(1), printed p.1105, using A.1.24.
-/

public section
open Subgroup Representation Representation.BinaryOffender Stellmacher Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section02
open Section01 Section03 ChapterA.Section05To06 ChapterD ChapterD.UniqueFactor
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
private theorem sylow_le_partner (T : Sylow 2 G) {Mc : Subgroup G}
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc}) :
    (T : Subgroup G) ≤ Mc := by
  have hMc : Mc ∈ maximalTwoLocalOvergroups
      (centralizer (centralInvolutions T : Set G)) := hu ▸ Set.mem_singleton Mc
  intro t ht
  exact hMc.2 (fun z hz => (centralInvolutions_le_centralizer_sylow T hz t ht).symm)

private theorem residual_notation {D : Type*} [Group D] [Finite D] (H : Subgroup D) :
    twoResidualAmbient H = (pResidual 2 H).map H.subtype := by
  unfold twoResidualAmbient twoResidualSubgroup pResidual
  congr 1
  apply congrArg sInf
  ext N
  constructor
  · rintro ⟨hN, n, hn⟩
    exact ⟨hN, IsPGroup.of_card hn⟩
  · rintro ⟨hN, hp⟩
    exact ⟨hN, IsPGroup.iff_card.mp hp⟩

private theorem elementaryNine_cube :
    ∀ x : Multiplicative (ZMod 3) × Multiplicative (ZMod 3), x ^ 3 = 1 := by
  decide +kernel

private theorem elementaryNine_rank :
    primeRank 3 (Multiplicative (ZMod 3) × Multiplicative (ZMod 3)) = 2 := by
  have hc : Nat.card (Multiplicative (ZMod 3) × Multiplicative (ZMod 3)) = 3 ^ 2 := by simp
  apply le_antisymm
  · apply (primeRank_le_iff_elementary_card_le _).mpr
    intro E _
    exact E.card_le_card_group.trans hc.le
  · exact primeRank_ge_of_elementary_embedding elementaryNine_cube hc
      (MonoidHom.id _) Function.injective_id

/-- The actual star residual has class at most two above its E₉ image. -/
theorem source_omega_nine_star_class_two (T : Sylow 2 G)
    {M Mc V : Subgroup G} [IsElementaryAbelian 2 V]
    (hTM : (T : Subgroup G) ≤ M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hV : PreparedChosenModule T M V)
    (ho : SourceCases.Omega (imageRepresentation M V hV.normalized))
    (hcard : Nat.card (((caseIIResidual T M (chosenStarredPreimage M V hV.normalized) Mc).subgroupOf M).map
      (actionHom M V hV.normalized).rangeRestrict) = 9) :
    let P := ((caseIIResidual T M (chosenStarredPreimage M V hV.normalized) Mc).subgroupOf M).map
      (QuotientGroup.mk' (pCore 2 M))
    _root_.commutator P ≤ center P := by
  let P := ((caseIIResidual T M (chosenStarredPreimage M V hV.normalized) Mc).subgroupOf M).map
    (QuotientGroup.mk' (pCore 2 M))
  let f := omegaStarActor hV.normalized ho
  obtain ⟨e⟩ := source_omega_nine_image_equiv T hTM (sylow_le_partner T hu) hV.normalized ho hcard
  have hab : IsMulCommutative (P.map f) := by
    rw [omegaStarActor_map]
    exact ⟨⟨fun a b => e.injective ((e.map_mul a b).trans
      ((mul_comm (e a) (e b)).trans (e.map_mul b a).symm))⟩⟩
  apply commutator_le_center_of_abelian_image_central_kernel f P hab
  rw [omegaStarActor_ker]
  apply le_centralizer_iff.mpr
  exact le_sup_right.trans (source_omega_lemma_15_2_3_5 T hTM hu hV ho)

/-- Cubic generation of the actual star residual, with its original source inverter. -/
theorem source_omega_nine_star_omega (T : Sylow 2 G)
    {M Mc V : Subgroup G} [IsElementaryAbelian 2 V]
    (hTM : (T : Subgroup G) ≤ M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hV : PreparedChosenModule T M V)
    (ho : SourceCases.Omega (imageRepresentation M V hV.normalized))
    (hcard : Nat.card (((caseIIResidual T M (chosenStarredPreimage M V hV.normalized) Mc).subgroupOf M).map
      (actionHom M V hV.normalized).rangeRestrict) = 9) :
    let P := ((caseIIResidual T M (chosenStarredPreimage M V hV.normalized) Mc).subgroupOf M).map
      (QuotientGroup.mk' (pCore 2 M))
    omega₁ P (p := 3) = ⊤ := by
  let Y := (caseIIResidual T M (chosenStarredPreimage M V hV.normalized) Mc).subgroupOf M
  let q := QuotientGroup.mk' (pCore 2 M)
  let P := Y.map q
  let R := (((M ⊓ Mc).pCoreIn 2).subgroupOf M).map q
  let S := (T.subtype hTM : Subgroup M).map q
  let f := omegaStarActor hV.normalized ho
  let : Y.Normal := source_omega_lemma_15_2_3_2 T hTM hV.normalized ho
  let : P.Normal := Normal.map inferInstance q (QuotientGroup.mk'_surjective _)
  obtain ⟨hcover, hs⟩ := source_omega_nine_star_cover T hTM (sylow_le_partner T hu)
    hV.normalized ho hcard
  have hc : f.ker ≤ centralizer ((P ⊔ R : Subgroup (M ⧸ pCore 2 M)) : Set _) := by
    rw [omegaStarActor_ker]
    apply le_centralizer_iff.mpr
    rw [sup_comm]
    exact source_omega_lemma_15_2_3_5 T hTM hu hV ho
  have hP : P = (pResidual 2 (normalClosure (R : Set (M ⧸ pCore 2 M)))).map
      (normalClosure (R : Set (M ⧸ pCore 2 M))).subtype := by
    dsimp only [P, Y, R]
    rw [source_omega_caseIIResidual_image T hTM hV.normalized ho q
      (QuotientGroup.mk'_surjective _), residual_notation]
  apply omega_one_eq_top_of_inverted_residual_image f P R S hP
    ((isPGroup_pCoreIn 2 (M ⊓ Mc)).comap_subtype.map q)
    (pCore_quotient_pCore_eq_bot 2) hc hs hcover
  · obtain ⟨r, hr, _, hr2, hi⟩ := source_omega_nine_inverter T hTM
      (sylow_le_partner T hu) hV.normalized ho hcard
    refine ⟨q r, mem_map_of_mem q hr, hr2, ?_⟩
    rintro _ ⟨y, hy, rfl⟩
    change f (q r * q y * (q r)⁻¹) = (f (q y))⁻¹
    rw [map_mul, map_mul, map_inv]
    exact hi _ (mem_map_of_mem _ hy)
  · obtain ⟨e⟩ := source_omega_nine_image_equiv T hTM (sylow_le_partner T hu)
      hV.normalized ho hcard
    rintro _ ⟨y, hy, rfl⟩
    let a : Y.map (actionHom M V hV.normalized).rangeRestrict :=
      ⟨(actionHom M V hV.normalized).rangeRestrict y, mem_map_of_mem _ hy⟩
    have ha : a ^ 3 = 1 := e.injective (by rw [map_pow, elementaryNine_cube, map_one])
    exact congrArg Subtype.val ha

/-- The original quasithin bound and E₉ image give star three-rank exactly two. -/
theorem source_omega_nine_star_rank
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    {M Mc V : Subgroup G} [IsElementaryAbelian 2 V]
    (hM : M ∈ maximalTwoLocalOvergroups (T : Subgroup G))
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hV : PreparedChosenModule T M V)
    (ho : SourceCases.Omega (imageRepresentation M V hV.normalized))
    (hcard : Nat.card (((caseIIResidual T M (chosenStarredPreimage M V hV.normalized) Mc).subgroupOf M).map
      (actionHom M V hV.normalized).rangeRestrict) = 9) :
    let P := ((caseIIResidual T M (chosenStarredPreimage M V hV.normalized) Mc).subgroupOf M).map
      (QuotientGroup.mk' (pCore 2 M))
    primeRank 3 P = 2 := by
  let P := ((caseIIResidual T M (chosenStarredPreimage M V hV.normalized) Mc).subgroupOf M).map
    (QuotientGroup.mk' (pCore 2 M))
  let f := omegaStarActor hV.normalized ho
  have hr : primeRank 3 (M ⧸ pCore 2 M) ≤ 2 := by
    rw [primeRank_quotient_eq_of_isTwoGroup 3 (by decide) (pCore 2 M) pCore_isPGroup]
    exact (hG.twoLocal_sqtk hM.1.1).stronglyQuasithin 3 Nat.prime_three (by decide)
  apply le_antisymm ((primeRank_subgroup_le 3 P).trans hr)
  obtain ⟨e⟩ := source_omega_nine_image_equiv T hM.2 (sylow_le_partner T hu)
    hV.normalized ho hcard
  let e' : P.map f ≃* Multiplicative (ZMod 3) × Multiplicative (ZMod 3) :=
    (MulEquiv.subgroupCongr (omegaStarActor_map hV.normalized ho _)).trans e
  let g := e'.toMonoidHom.comp (f.subgroupMap P)
  have hg : Function.Surjective g := e'.surjective.comp (f.subgroupMap_surjective P)
  have hh := PrimeRank.le_of_surjective_of_target_le_two (by decide : 3 ≠ 2)
    g hg elementaryNine_rank.le
  rwa [elementaryNine_rank] at hh

/-- The actual E₉ or extraspecial27 models above the full original action image. -/
theorem source_omega_nine_star_models
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    {M Mc V : Subgroup G} [IsElementaryAbelian 2 V]
    (hM : M ∈ maximalTwoLocalOvergroups (T : Subgroup G))
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hV : PreparedChosenModule T M V)
    (ho : SourceCases.Omega (imageRepresentation M V hV.normalized))
    (hcard : Nat.card (((caseIIResidual T M (chosenStarredPreimage M V hV.normalized) Mc).subgroupOf M).map
      (actionHom M V hV.normalized).rangeRestrict) = 9) :
    let P := ((caseIIResidual T M (chosenStarredPreimage M V hV.normalized) Mc).subgroupOf M).map
      (QuotientGroup.mk' (pCore 2 M))
    (Nat.card P = 9 ∧ Nonempty (P ≃* Multiplicative (ZMod 3) × Multiplicative (ZMod 3))) ∨
      (Nat.card P = 27 ∧ IsExtraspecial 3 P ∧ Nonempty (P ≃* HeisenbergPrime 3)) := by
  let P := ((caseIIResidual T M (chosenStarredPreimage M V hV.normalized) Mc).subgroupOf M).map
    (QuotientGroup.mk' (pCore 2 M))
  have hc := source_omega_nine_star_class_two T hM.2 hu hV ho hcard
  have hw := source_omega_nine_star_omega T hM.2 hu hV ho hcard
  have he := exponent_dvd_prime_of_omega_one_eq_top (by decide : 3 ≠ 2) hc hw
  have hp : IsPGroup 3 P := fun x => ⟨1, by
    simpa using Monoid.exponent_dvd_iff_forall_pow_eq_one.mp he x⟩
  exact ChapterA.lemma_A_1_24 (by decide) hp hw hc
    (source_omega_nine_star_rank hG T hM hu hV ho hcard)

/-- The actual central-extension alternatives for the intrinsic original Y/O₂(Y). -/
theorem source_omega_nine_quotient_models
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    {M Mc V : Subgroup G} [IsElementaryAbelian 2 V]
    (hM : M ∈ maximalTwoLocalOvergroups (T : Subgroup G))
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hV : PreparedChosenModule T M V)
    (ho : SourceCases.Omega (imageRepresentation M V hV.normalized))
    (hcard : Nat.card (((caseIIResidual T M (chosenStarredPreimage M V hV.normalized) Mc).subgroupOf M).map
      (actionHom M V hV.normalized).rangeRestrict) = 9) :
    let Y := caseIIResidual T M (chosenStarredPreimage M V hV.normalized) Mc
    Nonempty ((Y ⧸ pCore 2 Y) ≃* Multiplicative (ZMod 3) × Multiplicative (ZMod 3)) ∨
      Nonempty ((Y ⧸ pCore 2 Y) ≃* HeisenbergPrime 3) := by
  rcases source_omega_nine_star_models hG T hM hu hV ho hcard with
    ⟨_, ⟨e⟩⟩ | ⟨_, _, ⟨e⟩⟩
  · exact Or.inl ⟨(omegaResidualCoreQuotientEquivStar T hM.2 hV.normalized ho).trans e⟩
  · exact Or.inr ⟨(omegaResidualCoreQuotientEquivStar T hM.2 hV.normalized ho).trans e⟩

end CFSG.Quasithin.Chapter15.Section02
