module

public import CFSG.Quasithin.Chapter15.Section02.Preliminaries.OmegaNineElementary
public import CFSG.Quasithin.Chapter15.Section02.Preliminaries.OmegaNineCoreInversion
public import CFSG.Quasithin.Chapter15.Section02.Preliminaries.OmegaNineExtraspecialTheta

/-!
# The complete order-nine branch of original15.2.3(1)

The source's full order-nine image yields exactly two genuine central
extensions. In the elementary branch, Y/O₂(Y) is E₉, C_Y(V)=O₂(Y), and
C_M(V) has order prime to three. In the extraspecial branch, the same
intrinsic quotient is the prime Heisenberg group of order27, Rc-bar has
order two and inverts all of Y-bar, the centralizer has three-rank at most
one, and O²(O₂,Z(Y)) is exactly the subgroup generated by its cubic elements.

Every branch premise is discharged by the proved star classification.
All groups, quotient maps, central preimages and theta subgroups are the
original ones. The only cardinality hypothesis selects the order-nine
branch already supplied by OmegaResidualStructure.

Source: Aschbacher--Smith15.2.3(1)(i),(ii), printed pp.1104--1105.
-/

public section
open Subgroup Representation Representation.BinaryOffender Stellmacher Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section02
open Section01 Section03 ChapterA.Section05To06 ChapterD ChapterD.UniqueFactor
variable {G : Type*} [Group G] [Finite G]

/-- The entire order-nine source alternative, with all central-extension,
centralizer, inversion and theta conclusions proved. -/
theorem source_omega_nine_residual_structure
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    {M Mc V : Subgroup G} [IsElementaryAbelian 2 V]
    (hM : M ∈ maximalTwoLocalOvergroups (T : Subgroup G))
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hV : PreparedChosenModule T M V)
    (ho : SourceCases.Omega (imageRepresentation M V hV.normalized))
    (hcard : Nat.card (((caseIIResidual T M (chosenStarredPreimage M V hV.normalized) Mc).subgroupOf M).map
      (actionHom M V hV.normalized).rangeRestrict) = 9) :
    let Y := caseIIResidual T M (chosenStarredPreimage M V hV.normalized) Mc
    let f := (actionHom M V hV.normalized).rangeRestrict
    let P := (Y.subgroupOf M).map (QuotientGroup.mk' (pCore 2 M))
    let Rbar := (((M ⊓ Mc).pCoreIn 2).subgroupOf M).map f
    let C := M ⊓ centralizer (V : Set G)
    (Y.subgroupOf M).map f = pResidual 2 (actionHom M V hV.normalized).range ∧
      ((Nat.card P = 9 ∧
          Nonempty (P ≃* Multiplicative (ZMod 3) × Multiplicative (ZMod 3)) ∧
          Nonempty ((Y ⧸ pCore 2 Y) ≃* Multiplicative (ZMod 3) × Multiplicative (ZMod 3)) ∧
          Y ⊓ centralizer (V : Set G) = Y.pCoreIn 2 ∧ Nat.Coprime 3 (Nat.card C)) ∨
       (Nat.card P = 27 ∧ IsExtraspecial 3 P ∧ Nonempty (P ≃* HeisenbergPrime 3) ∧
          Nonempty ((Y ⧸ pCore 2 Y) ≃* HeisenbergPrime 3) ∧
          Nat.card Rbar = 2 ∧
          (∀ r ∈ Rbar, r ≠ 1 → ∀ y ∈ (Y.subgroupOf M).map f, r * y * r⁻¹ = y⁻¹) ∧
          primeRank 3 C ≤ 1 ∧
          (centralPreimage (pCore 2 Y)).map Y.subtype = Y ⊓ centralizer (V : Set G) ∧
          twoResidualAmbient ((centralPreimage (pCore 2 Y)).map Y.subtype) = theta C)) := by
  refine ⟨source_omega_nine_image_eq T hM.2 hV.normalized ho hcard, ?_⟩
  rcases source_omega_nine_star_models hG T hM hu hV ho hcard with
    ⟨hc, ⟨e⟩⟩ | ⟨hc, hex, he⟩
  · obtain ⟨hker, hcop⟩ := source_omega_nine_elementary_data hG T hM hu hV ho hcard hc
    exact Or.inl ⟨hc, ⟨e⟩,
      ⟨(omegaResidualCoreQuotientEquivStar T hM.2 hV.normalized ho).trans e⟩, hker, hcop⟩
  · obtain ⟨hR, hinv⟩ := source_omega_extraspecial_core_inversion T hM.2 hu hV ho hcard hc hex
    obtain ⟨e⟩ := he
    exact Or.inr ⟨hc, hex, ⟨e⟩,
      ⟨(omegaResidualCoreQuotientEquivStar T hM.2 hV.normalized ho).trans e⟩, hR, hinv,
      source_omega_extraspecial_centralizer_rank hG T hM hu hV ho ⟨e⟩,
      source_omega_extraspecial_centralPreimage_eq T hM.2 hu hV ho hcard hex,
      source_omega_extraspecial_theta hG T hM hu hV ho hcard ⟨e⟩⟩

/-- The rank bound used to exclude the later E₉ centralizer in15.2.4. -/
theorem source_omega_nine_centralizer_rank
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    {M Mc V : Subgroup G} [IsElementaryAbelian 2 V]
    (hM : M ∈ maximalTwoLocalOvergroups (T : Subgroup G))
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hV : PreparedChosenModule T M V)
    (ho : SourceCases.Omega (imageRepresentation M V hV.normalized))
    (hcard : Nat.card (((caseIIResidual T M (chosenStarredPreimage M V hV.normalized) Mc).subgroupOf M).map
      (actionHom M V hV.normalized).rangeRestrict) = 9) :
    primeRank 3 (M ⊓ centralizer (V : Set G) : Subgroup G) ≤ 1 := by
  rcases source_omega_nine_star_models hG T hM hu hV ho hcard with
    ⟨hc, _⟩ | ⟨_, _, he⟩
  · have hp := (source_omega_nine_elementary_data hG T hM hu hV ho hcard hc).2
    have hz := PrimeRank.eq_zero_iff_not_dvd_card.mpr
      (Nat.prime_three.coprime_iff_not_dvd.mp hp)
    exact hz.le.trans (by decide)
  · exact source_omega_extraspecial_centralizer_rank hG T hM hu hV ho he

end CFSG.Quasithin.Chapter15.Section02
end
