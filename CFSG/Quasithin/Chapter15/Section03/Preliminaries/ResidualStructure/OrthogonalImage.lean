module

public import CFSG.Quasithin.Chapter15.Section03.Preliminaries.ResidualStructure.OrthogonalImage.CoreImage
public import CFSG.Quasithin.Chapter15.Section03.Preliminaries.ResidualStructure.OrthogonalImage.Displacement
public import Theory.GroupTheory.WreathTwoResidual

/-!
# The orthogonal residual image in Lemma 15.3.7

For the actual `Rc = O₂(M ∩ Mc)` and `Y = O²(⟨Rc^M⟩)`, the genuine
noncentrality input 14.1.17(1) implies that the image of `Y` is the full
two-residual of the natural orthogonal actor. The coordinate action then
gives `[V,Y] = V`. The actor has trivial two-core, its residual is actually
isomorphic to `E₉`, and the image of `Rc` contains an involution inverting
that entire residual.

CoreImage derives containment and normalization in the actual Sylow image.
The independent wreath calculation uses the central involution of its
dihedral Sylow subgroup, including when the core image has order two.
Basic transports the literal normal-closure residual to the actor, and
Displacement retains the specified coordinate action to prove the module
commutator. No other clause of 15.3.7 is assumed or asserted here; the full
three-group alternatives remain with the ResidualStructure assembly owner.

Source: Aschbacher–Smith, Lemma 15.3.7, printed p.1122 (PDF p.1139).
-/

open Subgroup Stellmacher
namespace CFSG.Quasithin.Chapter15.Section03

private theorem residual_notation {X : Type*} [Group X] [Finite X] (H : Subgroup X) :
    twoResidualAmbient H = (pResidual 2 H).map H.subtype := by
  unfold twoResidualAmbient
  congr 1
  unfold twoResidualSubgroup pResidual
  congr 1
  ext N
  constructor
  · rintro ⟨hN,n,hn⟩
    refine ⟨hN,?_⟩
    let _ := hN
    exact IsPGroup.iff_card.mpr ⟨n,by simpa [Subgroup.index_eq_card] using hn⟩
  · rintro ⟨hN,hp⟩
    let _ := hN
    obtain ⟨n,hn⟩ := IsPGroup.iff_card.mp hp
    exact ⟨hN,n,by simpa [Subgroup.index_eq_card] using hn⟩

private theorem actor_residual_notation :
    twoResidualAmbient (⊤ : Subgroup OrthogonalActor) = pResidual 2 OrthogonalActor := by
  rw [residual_notation]
  exact map_pResidual 2 Subgroup.topEquiv

/-- The orthogonal actor's two-residual has actual elementary-nine coordinates. -/
public theorem orthogonalActor_residual_equiv_elementaryNine :
    Nonempty ((twoResidualAmbient (⊤ : Subgroup OrthogonalActor)) ≃*
      Multiplicative (Fin 2 → ZMod 3)) := by
  obtain ⟨e⟩ := Theory.GroupTheory.WreathTwoResidual.residual_equiv_elementaryNine
  exact ⟨(MulEquiv.subgroupCongr actor_residual_notation).trans e⟩

/-- The literal orthogonal actor has trivial two-core. -/
public theorem orthogonalActor_twoCore_eq_bot : pCore 2 OrthogonalActor = ⊥ :=
  Theory.GroupTheory.WreathTwoResidual.twoCore_eq_bot

variable {G : Type*} [Group G] [Finite G]

/-- The action image of the source residual is the whole actor residual. -/
public theorem residualY_orthogonal_image (M Mc V : Subgroup G) (T : Sylow 2 G)
    (hTM : (T : Subgroup G) ≤ M) (hTMc : (T : Subgroup G) ≤ Mc)
    (d : NaturalOrthogonalAction M V)
    (hRc : ¬ (M ⊓ Mc).pCoreIn 2 ≤ centralizer (V : Set G)) :
    ((residualY M Mc).subgroupOf M).map d.actor =
      twoResidualAmbient (⊤ : Subgroup OrthogonalActor) := by
  rw [residualY_image, residual_notation, actor_residual_notation]
  exact Theory.GroupTheory.WreathTwoResidual.normalClosure_residual_eq
    (d.sylowImage T hTM) (d.intersectionCoreImage Mc)
    (d.intersectionCoreImage_le_sylowImage Mc T hTM hTMc)
    (d.sylowImage_normalizes_intersectionCoreImage Mc T hTM hTMc)
    (d.intersectionCoreImage_ne_bot Mc hRc)

/-- The compatible natural module is generated by its commutators with the actual `Y`. -/
public theorem residualY_orthogonal_commutator (M Mc V : Subgroup G) (T : Sylow 2 G)
    (hTM : (T : Subgroup G) ≤ M) (hTMc : (T : Subgroup G) ≤ Mc)
    (d : NaturalOrthogonalAction M V)
    (hRc : ¬ (M ⊓ Mc).pCoreIn 2 ≤ centralizer (V : Set G)) :
    ⁅V,residualY M Mc⁆ = V :=
  d.commutator_eq_of_residual_image (residualY M Mc)
    (Chapter14.SourcePreliminaries.sourceResidual_le M Mc)
    (residualY_orthogonal_image M Mc V T hTM hTMc d hRc)

/-- An element of the actual core image has order two and inverts the entire
actor residual, including when that core image is itself of order two. -/
public theorem intersectionCoreImage_exists_residual_inverter
    (M Mc V : Subgroup G) (T : Sylow 2 G)
    (hTM : (T : Subgroup G) ≤ M) (hTMc : (T : Subgroup G) ≤ Mc)
    (d : NaturalOrthogonalAction M V)
    (hRc : ¬ (M ⊓ Mc).pCoreIn 2 ≤ centralizer (V : Set G)) :
    ∃ r : OrthogonalActor, r ∈ d.intersectionCoreImage Mc ∧ orderOf r = 2 ∧
      ∀ x : OrthogonalActor, x ∈ twoResidualAmbient (⊤ : Subgroup OrthogonalActor) →
        r*x*r⁻¹ = x⁻¹ := by
  rw [actor_residual_notation]
  exact Theory.GroupTheory.WreathTwoResidual.exists_normal_sylow_inverter
    (d.sylowImage T hTM) (d.intersectionCoreImage Mc)
    (d.intersectionCoreImage_le_sylowImage Mc T hTM hTMc)
    (d.sylowImage_normalizes_intersectionCoreImage Mc T hTM hTMc)
    (d.intersectionCoreImage_ne_bot Mc hRc)

end CFSG.Quasithin.Chapter15.Section03
