module
public import CFSG.Quasithin.Chapter15.Section03.Preliminaries.OrthogonalLocal.Source50Model.Other
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.WeakClosure.CoordinateModel

/-!
The displacement hyperplane of the other Klein four-group.

For the actual orthogonal four-space action, the displacement subgroup has
order eight and is the polar perpendicular of the Sylow fixed line. The proof
computes the standard Klein group's displacements and transports this identity
by Sylow conjugacy, using invariance of the literal quadratic form. This is
the model calculation in original 15.3.53 and the marking needed for G.2.6.
-/

public section
namespace CFSG.Quasithin.Chapter15.Section03.OrthogonalGeometry.Source50Model
open Subgroup
open scoped IsMulCommutative Pointwise
set_option synthInstance.maxSize 4096
set_option maxRecDepth 10000
attribute [local instance] FourGroupMatrixCoordinates.naturalAction orthogonalAction
private instance : DecidableEq OrthogonalActor := fun a b => decidable_of_iff
  (a.left = b.left ∧ a.right = b.right) RegularWreathProduct.ext_iff.symm
private instance : Fintype OrthogonalActor :=
  Fintype.ofEquiv ((OrthogonalPlaneIndex → OrthogonalPlaneActor) × OrthogonalPlaneIndex)
    (RegularWreathProduct.equivProd _ _).symm
/-- The subgroup generated by all displacements in the specified model action. -/
@[expose] def movement (R : Subgroup OrthogonalActor) : Subgroup OrthogonalVector :=
  closure {w | ∃ r ∈ R, ∃ v : OrthogonalVector, r • v * v⁻¹ = w}

private def standardHyperplane : Subgroup OrthogonalVector where
  carrier v := (v 1).toAdd 1 = (v (Multiplicative.ofAdd 1)).toAdd 1
  one_mem' := rfl
  mul_mem' := by
    intro v w hv hw
    change (v 1).toAdd 1 + (w 1).toAdd 1 =
      (v (Multiplicative.ofAdd 1)).toAdd 1 + (w (Multiplicative.ofAdd 1)).toAdd 1
    rw [hv, hw]
  inv_mem' := by
    intro v hv
    change -(v 1).toAdd 1 = -(v (Multiplicative.ofAdd 1)).toAdd 1
    rw [hv]

private instance (v : OrthogonalVector) : Decidable (v ∈ standardHyperplane) :=
  inferInstanceAs (Decidable ((v 1).toAdd 1 = (v (Multiplicative.ofAdd 1)).toAdd 1))

private theorem standard_movement : movement otherActor = standardHyperplane := by
  apply le_antisymm
  · apply (closure_le _).mpr
    rintro _ ⟨r, ⟨a, ha, rfl⟩, v, rfl⟩
    have hc : ∀ a : DihedralGroup 4, a ∈ otherDihedral → ∀ v : OrthogonalVector,
        wreathTwoDihedralHom a • v * v⁻¹ ∈ standardHyperplane := by decide +kernel
    exact hc a ha v
  · intro v hv
    have hc : ∀ v : OrthogonalVector, v ∈ standardHyperplane →
        ∃ u w : OrthogonalVector, v =
          (wreathTwoDihedralHom (DihedralGroup.r 2) • u * u⁻¹) *
          (wreathTwoDihedralHom (DihedralGroup.sr 0) • w * w⁻¹) := by decide +kernel
    obtain ⟨u,w,rfl⟩ := hc v hv
    apply (movement otherActor).mul_mem
    · exact subset_closure ⟨_, ⟨_, Or.inr (Or.inl rfl), rfl⟩, u, rfl⟩
    · exact subset_closure ⟨_, ⟨_, Or.inr (Or.inr (Or.inl rfl)), rfl⟩, w, rfl⟩

private theorem movement_conj (R : Subgroup OrthogonalActor) (g : OrthogonalActor) :
    movement (R.map (MulAut.conj g).toMonoidHom) =
      (movement R).map (MulDistribMulAction.toMulEquiv OrthogonalVector g).toMonoidHom := by
  apply le_antisymm
  · apply (closure_le _).mpr
    rintro _ ⟨_, ⟨r,hr,rfl⟩, v, rfl⟩
    refine ⟨r • (g⁻¹ • v) * (g⁻¹ • v)⁻¹, subset_closure ⟨r,hr,_,rfl⟩, ?_⟩
    change g • (r • (g⁻¹ • v) * (g⁻¹ • v)⁻¹) = _
    simp only [smul_mul', smul_inv', smul_inv_smul, MulEquiv.coe_toMonoidHom,
      MulAut.conj_apply, mul_smul]
  · apply map_le_iff_le_comap.mpr
    apply (closure_le _).mpr
    rintro _ ⟨r,hr,v,rfl⟩
    have h := (show (MulAut.conj g) r • (g • v) * (g • v)⁻¹ ∈
        movement (R.map (MulAut.conj g).toMonoidHom) from
      subset_closure ⟨_, ⟨r,hr,rfl⟩, g • v, rfl⟩)
    change g • (r • v * v⁻¹) ∈ movement (R.map (MulAut.conj g).toMonoidHom)
    simpa only [MulEquiv.coe_toMonoidHom, MulAut.conj_apply, mul_smul,
      inv_smul_smul, smul_mul', smul_inv'] using h

/-- The other elementary Sylow image has a displacement hyperplane of order eight. -/
theorem movement_card_eight (P : Sylow 2 OrthogonalActor)
    (R : Subgroup OrthogonalActor) [IsElementaryAbelian 2 R]
    (hle : R ≤ P)
    (hn : (P : Subgroup OrthogonalActor) ≤ normalizer (R : Set OrthogonalActor))
    (hout : ¬ R ≤ planePart P) : Nat.card (movement R) = 8 := by
  obtain ⟨g,_,he⟩ := exists_other_conjugate P R hle hn hout
  have hc : Nat.card standardHyperplane = 8 := by
    rw [Nat.card_eq_fintype_card]; decide +kernel
  rw [← card_map_of_injective
    (f := (MulDistribMulAction.toMulEquiv OrthogonalVector g).toMonoidHom)
    (MulDistribMulAction.toMulEquiv OrthogonalVector g).injective,
    ← movement_conj, he, standard_movement, hc]

abbrev polarValue (v z : OrthogonalVector) : ZMod 2 :=
  FusionCore.orthogonalCoordinateValue (v*z) - FusionCore.orthogonalCoordinateValue v -
    FusionCore.orthogonalCoordinateValue z

set_option maxRecDepth 10000 in
theorem quadratic_invariant (g : OrthogonalActor) (v : OrthogonalVector) :
    FusionCore.orthogonalCoordinateValue (g • v) = FusionCore.orthogonalCoordinateValue v := by
  have hc : ∀ g : OrthogonalActor, ∀ v : OrthogonalVector,
      FusionCore.orthogonalCoordinateValue (g • v) = FusionCore.orthogonalCoordinateValue v := by
    decide +kernel
  exact hc g v

private theorem polar_invariant (g : OrthogonalActor) (v z : OrthogonalVector) :
    polarValue (g • v) (g • z) = polarValue v z := by
  dsimp only [polarValue]
  rw [← smul_mul', quadratic_invariant, quadratic_invariant, quadratic_invariant]

private theorem standard_perpendicular (v : OrthogonalVector) :
    v ∈ standardHyperplane ↔ ∀ z ∈ fixedVectors wreathTwoDihedralHom.range,
      polarValue v z = 0 := by
  have hc : ∀ v : OrthogonalVector,
      v ∈ standardHyperplane ↔ ∀ z : OrthogonalVector,
        (∀ a : DihedralGroup 4, wreathTwoDihedralHom a • z = z) → polarValue v z = 0 := by
    decide +kernel
  rw [hc]
  constructor
  · intro hv z hz
    exact hv z (fun a => hz _ ⟨a,rfl⟩)
  · intro hv z hz
    exact hv z (by rintro _ ⟨a,rfl⟩; exact hz a)

/-- The displacement is the perpendicular of the literal Sylow fixed line. -/
theorem movement_mem_iff_perpendicular (P : Sylow 2 OrthogonalActor)
    (R : Subgroup OrthogonalActor) [IsElementaryAbelian 2 R]
    (hle : R ≤ P)
    (hn : (P : Subgroup OrthogonalActor) ≤ normalizer (R : Set OrthogonalActor))
    (hout : ¬ R ≤ planePart P) (v : OrthogonalVector) :
    v ∈ movement R ↔ ∀ z ∈ fixedVectors P, polarValue v z = 0 := by
  obtain ⟨g,hP,he⟩ := exists_other_conjugate P R hle hn hout
  have hm : v ∈ movement R ↔ g • v ∈ standardHyperplane := by
    rw [← standard_movement, ← he, movement_conj]
    exact (mem_map_iff_mem (MulDistribMulAction.toMulEquiv OrthogonalVector g).injective).symm
  rw [hm, standard_perpendicular, ← hP]
  constructor
  · intro hv z hz
    rw [← polar_invariant g]
    exact hv _ ((fixed_conj (P : Subgroup OrthogonalActor) g z).mpr hz)
  · intro hv z hz
    have hz' : g⁻¹ • z ∈ fixedVectors P := by
      apply (fixed_conj (P : Subgroup OrthogonalActor) g (g⁻¹ • z)).mp
      simpa only [smul_inv_smul] using hz
    have h := hv _ hz'
    rw [← polar_invariant g, smul_inv_smul] at h
    exact h

end CFSG.Quasithin.Chapter15.Section03.OrthogonalGeometry.Source50Model
