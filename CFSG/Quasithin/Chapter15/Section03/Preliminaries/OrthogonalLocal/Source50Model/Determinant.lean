module
public import CFSG.Quasithin.Chapter15.Section03.Preliminaries.OrthogonalLocal.Source50Model.Movement
public import Theory.Representation.OrthogonalFourPlusMatrix.Action
public import Theory.GroupTheory.WreathTwoResidual

/-!
Determinant coordinates for the exact subgroup generated by Y and U.

An explicit linear change of coordinates carries the sum of the two definite
binary planes to the 2-by-2 determinant form. We construct two commuting SL₂(2)
factors in the actual wreath actor, prove their literal action is A X B⁻¹,
and identify their image with the other Klein group joined with the 2-residual.
Sylow conjugacy then provides compatible matrix coordinates and the marked
point perpendicular required by G.2.6 and original 15.3.54.
-/

public section
namespace CFSG.Quasithin.Chapter15.Section03.OrthogonalGeometry.Source50Matrix
set_option synthInstance.maxSize 4096
set_option maxRecDepth 10000
open Subgroup ClassicalOrthogonal.FourPlusMatrix
attribute [local instance] FourGroupMatrixCoordinates.naturalAction orthogonalAction
private instance : DecidableEq OrthogonalActor := fun a b => decidable_of_iff
  (a.left = b.left ∧ a.right = b.right) RegularWreathProduct.ext_iff.symm
private instance : Fintype OrthogonalActor :=
  Fintype.ofEquiv ((OrthogonalPlaneIndex → OrthogonalPlaneActor) × OrthogonalPlaneIndex)
    (RegularWreathProduct.equivProd _ _).symm

/-- The determinant coordinates for the sum of the two definite binary planes. -/
@[expose] def coordinates : OrthogonalVector ≃* Multiplicative (Mat (F := ZMod 2)) where
  toFun v := Multiplicative.ofAdd
    !![(v 1).toAdd 0 + (v (Multiplicative.ofAdd 1)).toAdd 0 +
        (v (Multiplicative.ofAdd 1)).toAdd 1,
       (v 1).toAdd 0 + (v 1).toAdd 1 + (v (Multiplicative.ofAdd 1)).toAdd 1;
       (v 1).toAdd 1 + (v (Multiplicative.ofAdd 1)).toAdd 1,
       (v 1).toAdd 0 + (v (Multiplicative.ofAdd 1)).toAdd 0]
  invFun v i := if i = 1 then
    Multiplicative.ofAdd ![v.toAdd 0 1 + v.toAdd 1 0,
      v.toAdd 0 0 + v.toAdd 1 0 + v.toAdd 1 1]
    else Multiplicative.ofAdd ![v.toAdd 0 1 + v.toAdd 1 0 + v.toAdd 1 1,
      v.toAdd 0 0 + v.toAdd 1 1]
  left_inv := by decide +kernel
  right_inv := by decide +kernel
  map_mul' := by decide +kernel

private def cubic : OrthogonalPlaneActor := ⟨!![0,1;1,1], by decide⟩
private def reflection : OrthogonalPlaneActor := ⟨!![1,1;0,1], by decide⟩
private def code (a : OrthogonalPlaneActor) : Fin 3 × Fin 2 :=
  if a = 1 then (0,0) else if a = cubic then (1,0) else if a = cubic^2 then (2,0)
  else if a = reflection then (0,1) else if a = cubic*reflection then (1,1) else (2,1)

private def firstCubic : OrthogonalActor :=
  ⟨fun i => if i = 1 then cubic else cubic⁻¹, 1⟩
private def secondCubic : OrthogonalActor := ⟨fun _ => cubic, 1⟩
private def firstReflection : OrthogonalActor := ⟨1, Multiplicative.ofAdd 1⟩
private def secondReflection : OrthogonalActor := ⟨fun _ => reflection, Multiplicative.ofAdd 1⟩
private def actorFun (a : PairSL (F := ZMod 2)) : OrthogonalActor :=
  firstCubic ^ (code a.1).1.val * firstReflection ^ (code a.1).2.val *
    (secondCubic ^ (code a.2).1.val * secondReflection ^ (code a.2).2.val)

set_option maxRecDepth 10000 in
private theorem compatible_fun : ∀ a : PairSL (F := ZMod 2), ∀ v : OrthogonalVector,
    (coordinates (actorFun a • v)).toAdd = matrixAction a (coordinates v).toAdd := by
  decide +kernel

private theorem actor_ext {a b : OrthogonalActor}
    (h : ∀ v : OrthogonalVector, a • v = b • v) : a = b := by
  let _ := FourGroupMatrixCoordinates.naturalAction_faithful
  let _ : FaithfulSMul OrthogonalActor OrthogonalVector :=
    RegularWreathProduct.functionModule_faithful _ _ _
  exact FaithfulSMul.eq_of_smul_eq_smul h

/-- The two commuting determinant factors inside the actual wreath actor. -/
def actor : PairSL (F := ZMod 2) →* OrthogonalActor where
  toFun := actorFun
  map_one' := by
    apply actor_ext
    intro v
    apply coordinates.injective
    apply Multiplicative.toAdd.injective
    rw [compatible_fun]
    change matrixHom 1 (coordinates v).toAdd = (coordinates (1 • v)).toAdd
    rw [map_one, one_smul]
    rfl
  map_mul' a b := by
    apply actor_ext
    intro v
    apply coordinates.injective
    apply Multiplicative.toAdd.injective
    rw [mul_smul, compatible_fun, compatible_fun, compatible_fun]
    exact LinearEquiv.congr_fun (map_mul matrixHom a b) _

/-- This is equality for the specified action, not an abstract actor isomorphism. -/
theorem compatible (a : PairSL (F := ZMod 2)) (v : OrthogonalVector) :
    (coordinates (actor a • v)).toAdd = matrixAction a (coordinates v).toAdd :=
  compatible_fun a v

theorem actor_injective : Function.Injective actor := by
  intro a b hab
  apply matrixHom_injective
  apply LinearEquiv.ext
  intro v
  obtain ⟨w, hw⟩ := coordinates.surjective (Multiplicative.ofAdd v)
  change matrixAction a v = matrixAction b v
  rw [← show (coordinates w).toAdd = v from congrArg Multiplicative.toAdd hw,
    ← compatible, ← compatible, hab]

set_option maxRecDepth 10000 in
/-- The same coordinates preserve the full quadratic form. -/
theorem determinant_eq (v : OrthogonalVector) :
    determinantForm (coordinates v).toAdd = FusionCore.orthogonalCoordinateValue v := by
  exact (show ∀ v : OrthogonalVector,
    determinantForm (coordinates v).toAdd = FusionCore.orthogonalCoordinateValue v by
      decide +kernel) v

private theorem actor_card : Nat.card actor.range = 36 := by
  rw [← Nat.card_congr (MonoidHom.ofInjective actor_injective).toEquiv,
    Nat.card_prod]
  have hs : Nat.card OrthogonalPlaneActor = 6 := by
    rw [Nat.card_eq_fintype_card]; decide +kernel
  rw [hs]

private theorem actor_index : actor.range.index = 2 := by
  have h := actor.range.card_mul_index
  have hs : Nat.card OrthogonalPlaneActor = 6 := by
    rw [Nat.card_eq_fintype_card]; decide +kernel
  have hc : Nat.card OrthogonalActor = 72 := by
    rw [RegularWreathProduct.card, hs]
    norm_num [OrthogonalPlaneIndex, Nat.card_eq_fintype_card]
  rw [actor_card, hc] at h
  omega

private instance : actor.range.Normal := normal_of_index_eq_two actor_index

/-- The cubic residual is contained in these actual determinant factors. -/
theorem residual_le_actor : pResidual 2 OrthogonalActor ≤ actor.range := by
  apply sInf_le
  refine ⟨inferInstance, IsPGroup.of_card (n := 1) ?_⟩
  simpa only [pow_one, ← Subgroup.index_eq_card] using actor_index

open Source50Model

private theorem other_le_actor : otherActor ≤ actor.range := by
  rintro _ ⟨a,ha,rfl⟩
  have hc : ∀ a : DihedralGroup 4, a ∈ otherDihedral →
      ∃ b : PairSL (F := ZMod 2), actorFun b = wreathTwoDihedralHom a := by
    decide +kernel
  exact hc a ha

private theorem actor_le_other_sup_residual :
    actor.range ≤ otherActor ⊔ pResidual 2 OrthogonalActor := by
  have hfirst : firstCubic ∈ pResidual 2 OrthogonalActor :=
    mem_pResidual_of_orderOf_coprime ((by decide : Nat.Coprime 2 3).of_dvd_right
      (orderOf_dvd_of_pow_eq_one (show firstCubic ^ 3 = 1 by decide +kernel)))
  have hsecond : secondCubic ∈ pResidual 2 OrthogonalActor :=
    mem_pResidual_of_orderOf_coprime ((by decide : Nat.Coprime 2 3).of_dvd_right
      (orderOf_dvd_of_pow_eq_one (show secondCubic ^ 3 = 1 by decide +kernel)))
  have hs : firstReflection ∈ otherActor :=
    ⟨DihedralGroup.sr 0, Or.inr (Or.inr (Or.inl rfl)), by decide +kernel⟩
  have ht : secondReflection ∈ otherActor :=
    ⟨DihedralGroup.sr 2, Or.inr (Or.inr (Or.inr rfl)), by decide +kernel⟩
  rintro _ ⟨a,rfl⟩
  change actorFun a ∈ _
  unfold actorFun
  exact mul_mem (mul_mem (pow_mem (mem_sup_right hfirst) _)
    (pow_mem (mem_sup_left hs) _))
    (mul_mem (pow_mem (mem_sup_right hsecond) _) (pow_mem (mem_sup_left ht) _))

/-- The determinant image is the subgroup generated by the other Klein actor
and the literal cubic residual. -/
theorem actor_range_eq : actor.range = otherActor ⊔ pResidual 2 OrthogonalActor :=
  le_antisymm actor_le_other_sup_residual (sup_le other_le_actor residual_le_actor)

/-- Compatible determinant coordinates on the precise source image YU. -/
theorem determinant_model (P : Sylow 2 OrthogonalActor)
    (R : Subgroup OrthogonalActor) [IsElementaryAbelian 2 R]
    (hle : R ≤ P)
    (hn : (P : Subgroup OrthogonalActor) ≤ normalizer (R : Set OrthogonalActor))
    (hout : ¬ R ≤ planePart P) :
    ∃ c : OrthogonalVector ≃* Multiplicative (Mat (F := ZMod 2)),
    ∃ a : (R ⊔ pResidual 2 OrthogonalActor : Subgroup OrthogonalActor) ≃*
        PairSL (F := ZMod 2),
      (∀ (h : (R ⊔ pResidual 2 OrthogonalActor : Subgroup OrthogonalActor))
          (v : OrthogonalVector),
        (c ((h : OrthogonalActor) • v)).toAdd = matrixAction (a h) (c v).toAdd) ∧
      ∀ v, determinantForm (c v).toAdd = FusionCore.orthogonalCoordinateValue v := by
  obtain ⟨g,_,hR⟩ := exists_other_conjugate P R hle hn hout
  let J := R ⊔ pResidual 2 OrthogonalActor
  have hJ : J.map (MulAut.conj g).toMonoidHom = actor.range := by
    change (R ⊔ pResidual 2 OrthogonalActor).map (MulAut.conj g).toMonoidHom = actor.range
    rw [Subgroup.map_sup, hR, map_pResidual 2 (MulAut.conj g), actor_range_eq]
  let E := MonoidHom.ofInjective actor_injective
  let a : J ≃* PairSL (F := ZMod 2) :=
    ((MulAut.conj g).subgroupMap J).trans ((MulEquiv.subgroupCongr hJ).trans E.symm)
  let c := (MulDistribMulAction.toMulEquiv OrthogonalVector g).trans coordinates
  refine ⟨c,a,?_,?_⟩
  · intro h v
    have ha : actor (a h) = (MulAut.conj g) h := by
      exact congrArg Subtype.val (E.apply_symm_apply ((MulEquiv.subgroupCongr hJ)
        ((MulAut.conj g).subgroupMap J h)))
    change (coordinates (g • ((h : OrthogonalActor) • v))).toAdd =
      matrixAction (a h) (coordinates (g • v)).toAdd
    rw [← compatible, ha]
    simp only [MulAut.conj_apply, mul_smul, inv_smul_smul]
  · intro v
    change determinantForm (coordinates (g • v)).toAdd = _
    rw [determinant_eq, quadratic_invariant]

/-- The same determinant coordinates retain the point-perpendicular marking
required by G.2.6 and the original 15.3.54 consumer. -/
theorem determinant_model_with_perpendicular (P : Sylow 2 OrthogonalActor)
    (R : Subgroup OrthogonalActor) [IsElementaryAbelian 2 R]
    (hle : R ≤ P)
    (hn : (P : Subgroup OrthogonalActor) ≤ normalizer (R : Set OrthogonalActor))
    (hout : ¬ R ≤ planePart P) :
    ∃ c : OrthogonalVector ≃* Multiplicative (Mat (F := ZMod 2)),
    ∃ a : (R ⊔ pResidual 2 OrthogonalActor : Subgroup OrthogonalActor) ≃*
        PairSL (F := ZMod 2),
      (∀ (h : (R ⊔ pResidual 2 OrthogonalActor : Subgroup OrthogonalActor))
          (v : OrthogonalVector),
        (c ((h : OrthogonalActor) • v)).toAdd = matrixAction (a h) (c v).toAdd) ∧
      (∀ v, determinantForm (c v).toAdd = FusionCore.orthogonalCoordinateValue v) ∧
      ∀ v, v ∈ movement R ↔ ∀ z ∈ fixedVectors P,
        determinantForm.polarBilin (c v).toAdd (c z).toAdd = 0 := by
  obtain ⟨c,a,hcomp,hq⟩ := determinant_model P R hle hn hout
  refine ⟨c,a,hcomp,hq,?_⟩
  have hp (v z : OrthogonalVector) :
      determinantForm.polarBilin (c v).toAdd (c z).toAdd = polarValue v z := by
    rw [QuadraticMap.polarBilin_apply_apply, QuadraticMap.polar]
    change determinantForm (c v * c z).toAdd - determinantForm (c v).toAdd -
      determinantForm (c z).toAdd = _
    rw [← map_mul, hq, hq, hq]
  intro v
  simp only [hp]
  exact movement_mem_iff_perpendicular P R hle hn hout v

#print axioms determinant_model_with_perpendicular

end CFSG.Quasithin.Chapter15.Section03.OrthogonalGeometry.Source50Matrix
