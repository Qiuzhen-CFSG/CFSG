module

public import CFSG.Quasithin.Chapter15.Section03.Preliminaries.OutsideStructure.LocalBranches.QuotientTheta.Source
public import CFSG.Quasithin.Chapter15.Section03.Preliminaries.OutsideStructure.LocalControl
public import CFSG.Quasithin.Chapter15.Section03.Preliminaries.OutsideStructure.LocalBranches.SecondAction
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.CosetSetup.ExtraspecialLocal.Residual

/-!
# Order-three generation and the local theta identity

A subgroup of Y has an exponent-three quotient with two-group kernel, so
its two-residual is generated by its elements of order three. In the
ordinary alternative, O^{3′}(M)=Y puts every three-element of M into Y;
thus theta(M)=Y in both earlier alternatives. Restricting the order-three
generators to I and using the established residual-intersection identity
proves Y₊=theta(M∩I) for both choices.

In the ordinary alternative, every element of three-power order already
has cube one. Its Sylow three-subgroups therefore lie in theta, whose
index is prime to three. This identifies the literal O^{3′}(M∩I), without
replacing that residual by the three-core.

The residual-intersection identity is an explicit input of this conditional
calculation. The actual quotient identifications in 15.3.11(5) are separate.
Source: Aschbacher–Smith, combined manuscript (1 March 2004),
15.3.7 and 15.3.11(5)–(6), printed pp.1122–1124.
-/

public section

open Subgroup Stellmacher
namespace CFSG.Quasithin.Chapter15.Section03.OutsideStructure.LocalBranches.QuotientTheta
open FusionCore.CosetSetup.ExtraspecialLocal
variable {G : Type*} [Group G] [Finite G]

private theorem elementary_nine_cube (x : Multiplicative (Fin 2 → ZMod 3)) : x ^ 3 = 1 := by
  apply Multiplicative.toAdd.injective
  change 3 • x.toAdd = 0
  funext i
  exact (by decide : ∀ z : ZMod 3, 3 • z = 0) _

omit [Finite G] in
/-- The actual E₉ isomorphism supplies the cubic equation. -/
theorem ordinary_quotient_cube (d : CharacteristicTwo.LocalData G)
    (h : OrdinaryCase d.M d.Y d.V) (x : d.Y ⧸ pCore 2 d.Y) : x ^ 3 = 1 := by
  obtain ⟨e⟩ := h.quotient_equiv
  apply e.injective
  rw [map_pow, map_one]
  exact elementary_nine_cube _

omit [Finite G] in
/-- Both earlier quotients have exponent dividing three. -/
theorem earlier_quotient_cube (d : CharacteristicTwo.LocalData G)
    (h : EarlierThreeAlternatives d) (x : d.Y ⧸ pCore 2 d.Y) : x ^ 3 = 1 := by
  rcases h with h | ⟨h, _, _⟩
  · exact ordinary_quotient_cube d h x
  · rw [← h.quotient_exponent]
    exact Monoid.pow_exponent_eq_one _


omit [Finite G] in
/-- The earlier alternatives retain the actual quotient models. -/
theorem earlier_cubic_quotient (d : CharacteristicTwo.LocalData G)
    (h : EarlierThreeAlternatives d) : CubicQuotient (d.Y ⧸ pCore 2 d.Y) := by
  rcases h with h | ⟨h, _, _⟩
  · exact Or.inl h.quotient_equiv
  · refine Or.inr ⟨h.extraspecial, h.quotient_card, ?_⟩
    intro x
    rw [← h.quotient_exponent]
    exact Monoid.pow_exponent_eq_one _

omit [Finite G] in
/-- In the first choice, the cubic quotient is precisely the earlier quotient of Y. -/
theorem first_choice_cubic_quotient (d : CharacteristicTwo.LocalData G)
    (hfirst : d.Yplus = d.Y) (h : EarlierThreeAlternatives d) :
    CubicQuotient (d.Yplus ⧸ pCore 2 d.Yplus) := by
  rw [hfirst]
  exact earlier_cubic_quotient d h

private theorem residual_eq_theta_of_cube (X Y : Subgroup G) (hXY : X ≤ Y)
    (he : ∀ x : Y ⧸ pCore 2 Y, x ^ 3 = 1) : twoResidualAmbient X = theta X := by
  let f := (QuotientGroup.mk' (pCore 2 Y)).comp (inclusion hXY)
  apply twoResidual_eq_theta_of_exponent_three X f
  · change IsPGroup 2 ((QuotientGroup.mk' (pCore 2 Y)).ker.comap (inclusion hXY))
    rw [QuotientGroup.ker_mk']
    exact pCore_isPGroup.comap_of_injective _ (inclusion_injective hXY)
  · exact fun x => he (f x)

omit [Finite G] in
private theorem theta_le_primeToResidual (X : Subgroup G) :
    theta X ≤ (primeToResidual 3 X).map X.subtype := by
  apply (closure_le _).mpr
  rintro x ⟨hx, ho⟩
  refine ⟨⟨x, hx⟩, mem_primeToResidual_of_pow (n := 1) ?_, rfl⟩
  apply Subtype.ext
  change x ^ (3 ^ 1) = 1
  rw [pow_one, ← ho, pow_orderOf_eq_one]

/-- Both full alternatives of 15.3.7 identify the original residual with theta(M). -/
theorem y_eq_theta_m (d : CharacteristicTwo.LocalData G)
    (h : EarlierThreeAlternatives d) : d.Y = theta d.M := by
  have hgen : d.Y = theta d.Y := by
    exact (residualY_residual_eq d.M d.Mc).symm.trans
      (residual_eq_theta_of_cube _ _ le_rfl (earlier_quotient_cube d h))
  rcases h with h | ⟨h, _, _⟩
  · exact le_antisymm
      (hgen.le.trans (theta_mono (Chapter14.SourcePreliminaries.sourceResidual_le d.M d.Mc)))
      ((theta_le_primeToResidual d.M).trans_eq h.residual_eq.symm)
  · exact h.theta_eq

omit [Finite G] in
private theorem theta_intersection (M Y I : Subgroup G)
    (hYM : Y ≤ M) (hY : Y = theta M) : theta (M ⊓ I) = theta (Y ⊓ I) := by
  refine le_antisymm ((closure_le _).mpr ?_) (theta_mono (inf_le_inf_right I hYM))
  rintro x ⟨hx, ho⟩
  apply Subgroup.subset_closure
  refine ⟨⟨?_, hx.2⟩, ho⟩
  rw [hY]
  exact Subgroup.subset_closure ⟨hx.1, ho⟩

/-- Clause (6) from the earlier alternatives and the independently proved clause (3). -/
theorem chosen_eq_theta (d : CharacteristicTwo.LocalData G)
    (I : Subgroup G) (hI : I ∈ d.Hplus) (h7 : EarlierThreeAlternatives d)
    (hintersection : SecondChoice d → d.Yplus = twoResidualAmbient (d.Y ⊓ I)) :
    d.Yplus = theta (d.MI I) := by
  have hY := y_eq_theta_m d h7
  rcases d.choice with hfirst | hsecond
  · change d.Yplus = d.Y at hfirst
    have hgen : d.Y = theta d.Y := by rw [hY, theta_idempotent]
    apply le_antisymm
    · apply (hfirst.trans hgen).le.trans
      exact theta_mono (le_inf (Chapter14.SourcePreliminaries.sourceResidual_le d.M d.Mc)
        (hfirst ▸ le_sup_left.trans hI.1.2))
    · exact (theta_mono inf_le_left).trans_eq (hY.symm.trans hfirst.symm)
  · rw [hintersection hsecond, residual_eq_theta_of_cube _ d.Y inf_le_left
      (earlier_quotient_cube d h7)]
    exact (theta_intersection d.M d.Y I
      (Chapter14.SourcePreliminaries.sourceResidual_le d.M d.Mc) hY).symm

private theorem primeToResidual_eq_theta_of_cube_powers (X : Subgroup G)
    (hp : ∀ (x : X) (n : ℕ), x ^ (3 ^ n) = 1 → x ^ 3 = 1) :
    (primeToResidual 3 X).map X.subtype = theta X := by
  let N := (theta X).subgroupOf X
  let : N.Normal := normal_subgroupOf_of_le_normalizer
    (X.le_normalizer.trans (normalizer_le_normalizer_theta X))
  let P : Sylow 3 X := Classical.choice inferInstance
  have hPN : (P : Subgroup X) ≤ N := by
    intro x hx
    obtain ⟨n, hn⟩ := P.isPGroup' (⟨x, hx⟩ : P)
    have hc : x ^ 3 = 1 := hp x n (congrArg Subtype.val hn)
    rcases (Nat.dvd_prime Nat.prime_three).mp (orderOf_dvd_of_pow_eq_one hc) with ho | ho
    · rw [orderOf_eq_one_iff.mp ho]
      exact N.one_mem
    · exact Subgroup.subset_closure ⟨x.property, (Subgroup.orderOf_coe x).trans ho⟩
  have hc : Nat.Coprime 3 N.index :=
    (Nat.prime_three.coprime_iff_not_dvd.mpr P.not_dvd_index).coprime_dvd_right
      (index_dvd_of_le hPN)
  apply le_antisymm ?_ (theta_le_primeToResidual X)
  exact (map_mono (f := X.subtype) (primeToResidual_le N hc)).trans_eq
    (map_subgroupOf_eq_of_le (theta_le X))

/-- Every subgroup of M has its literal prime-to-three residual generated by cubics
in the ordinary alternative. -/
theorem ordinary_primeToResidual_eq_theta (d : CharacteristicTwo.LocalData G)
    (h : OrdinaryCase d.M d.Y d.V) (X : Subgroup G) (hXM : X ≤ d.M) :
    (primeToResidual 3 X).map X.subtype = theta X := by
  apply primeToResidual_eq_theta_of_cube_powers
  intro x n hx
  have hxy : (x : G) ∈ d.Y := by
    rw [h.residual_eq]
    exact ⟨⟨x, hXM x.property⟩,
      mem_primeToResidual_of_pow (n := n)
        (Subtype.ext (congrArg (fun z : X => (z : G)) hx)), rfl⟩
  let y : d.Y := ⟨x, hxy⟩
  let q := QuotientGroup.mk' (pCore 2 d.Y)
  have hc : Nat.Coprime 2 (orderOf y) := by
    apply (by decide : Nat.Coprime 2 3).pow_right n |>.coprime_dvd_right
    apply orderOf_dvd_of_pow_eq_one
    exact Subtype.ext (congrArg (fun z : X => (z : G)) hx)
  have hk : IsPGroup 2 q.ker := by
    dsimp only [q]
    rw [QuotientGroup.ker_mk']
    exact pCore_isPGroup
  have ho : orderOf y ∣ 3 := by
    rw [← q.orderOf_map_eq_of_coprime_of_isPGroup_ker hk y hc]
    exact orderOf_dvd_of_pow_eq_one (ordinary_quotient_cube d h (q y))
  exact Subtype.ext (congrArg (fun z : d.Y => (z : G))
    (orderOf_dvd_iff_pow_eq_one.mp ho))

/-- The prime-to-three residual equality required in clause (5ii).
The same equality also holds for the first choice in the ordinary alternative. -/
theorem ordinary_chosen_primeToResidual (d : CharacteristicTwo.LocalData G)
    (I : Subgroup G) (hI : I ∈ d.Hplus) (h : OrdinaryCase d.M d.Y d.V)
    (hintersection : SecondChoice d → d.Yplus = twoResidualAmbient (d.Y ⊓ I)) :
    d.Yplus = (primeToResidual 3 (d.MI I)).map (d.MI I).subtype := by
  rw [ordinary_primeToResidual_eq_theta d h (d.MI I) inf_le_left]
  exact chosen_eq_theta d I hI (Or.inl h) hintersection

end CFSG.Quasithin.Chapter15.Section03.OutsideStructure.LocalBranches.QuotientTheta

end
