module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ModelExclusions.PointTransport
public import CFSG.Quasithin.ChapterB.Section03.Offenders.Six
public import Theory.SpecificGroups.SymmetricSix.Parabolics.TwoCores.Duad
public import Theory.SpecificGroups.SymmetricSix.BinaryFlags.NaturalGeometry

/-!
# The six-letter point-core calculation in 15.3.49

On the natural binary S₆-module, strong offenders are conjugates of the
group generated by three disjoint transpositions (B.3.2). The two-core of
the stabilizer of the vector `{4,5}` is instead the exceptional eight-group:
the regular Klein four on the first four letters times the last transposition.
Its subgroups cannot be conjugates of the first eight-group. We identify
this intrinsic two-core by transporting the already proved S₂ × S₄ model.

The same calculation applies to the core module, and restriction to A₆
has no strong offender at all. The source application still has to identify
its component section and the projected point with these model coordinates.
This module proves the model calculation, not that identification.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), B.3.2,
printed pp.83–84, and the last paragraph of 15.3.49, printed p.1145.
-/

public section

namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ModelExclusions

open Subgroup Representation.BinaryOffender
open scoped IsMulCommutative
open ChapterB.Offenders ChapterB.Offenders.Six
open Theory.SpecificGroups.SymmetricSix

namespace SixPoint

private abbrev Product := Equiv.Perm (Fin 2) × Equiv.Perm (Fin 4)

private def productHom : Product →* S6 :=
  (Equiv.permCongrHom ((Equiv.sumComm (Fin 2) (Fin 4)).trans
    (finSumFinEquiv : Fin 4 ⊕ Fin 2 ≃ Fin 6))).toMonoidHom.comp
      (Equiv.Perm.sumCongrHom _ _)

set_option maxRecDepth 100000 in
private theorem productHom_mem : ∀ x, productHom x ∈ BinaryFlags.H1 := by decide +kernel

private def productToStabilizer : Product →* BinaryFlags.H1 :=
  productHom.codRestrict _ productHom_mem

private theorem productHom_injective : Function.Injective productHom :=
  (Equiv.permCongrHom _).injective.comp Equiv.Perm.sumCongrHom_injective

set_option maxRecDepth 100000 in
private theorem stabilizer_card : Nat.card BinaryFlags.H1 = 48 := by
  rw [Nat.card_eq_fintype_card]
  decide +kernel

private noncomputable def productEquiv : Product ≃* BinaryFlags.H1 :=
  MulEquiv.ofBijective productToStabilizer
    ((Nat.bijective_iff_injective_and_card _).mpr ⟨fun x y h =>
      productHom_injective (congrArg Subtype.val h), by
        rw [stabilizer_card, Nat.card_eq_fintype_card]
        decide⟩)

set_option maxRecDepth 100000 in
private theorem core_words : ∀ x : Product, x.2.sign = 1 → x.2 ^ 2 = 1 →
    ∃ i, exceptionalWords i = productHom x := by decide +kernel

/-- The literal two-core of the point stabilizer lies in the exceptional
eight-group, in the same coordinates as the offender classification. -/
theorem point_core_le_exceptional :
    localTwoCore BinaryFlags.H1 ≤ exceptional 6 (by decide) := by
  rintro x ⟨y, hy, rfl⟩
  rw [← pCore_map_iso 2 productEquiv] at hy
  obtain ⟨w, hw, rfl⟩ := hy
  rw [← DuadCalculation.productCore_eq] at hw
  have hh := DuadCalculation.core_mem_iff w.2 |>.mp hw.2
  exact (mem_exceptional_iff _).mpr (core_words w hh.1 hh.2)

/-- B.3.2 excludes a strong offender in this point-core on the natural module. -/
theorem not_strong_natural {A : Subgroup S6}
    (hA : A ≤ localTwoCore BinaryFlags.H1) :
    ¬ IsStrongOffender (BinaryPermutation.naturalRepresentation (Fin 6)) A := by
  intro hs
  exact exceptional_not_conjugate_D (hA.trans point_core_le_exceptional)
    ((isStrongOffender_natural_iff A).mp hs)

/-- The same exclusion on the nonsplit five-dimensional core module. -/
theorem not_strong_core {A : Subgroup S6}
    (hA : A ≤ localTwoCore BinaryFlags.H1) :
    ¬ IsStrongOffender (BinaryPermutation.coreRepresentation (Fin 6)) A := by
  intro hs
  exact exceptional_not_conjugate_D (hA.trans point_core_le_exceptional)
    ((isStrongOffender_core_iff A).mp hs)

/-- The vector stabilizer, not just its isomorphism type, is `H1`. -/
theorem natural_point_stabilizer :
    pointStabilizer (BinaryPermutation.naturalRepresentation (Fin 6))
      (BinaryFlags.NaturalGeometry.pairVector 4 5) = BinaryFlags.H1 := by
  ext g
  change (BinaryPermutation.naturalRepresentation (Fin 6) g
    (BinaryFlags.NaturalGeometry.pairVector 4 5) =
      BinaryFlags.NaturalGeometry.pairVector 4 5) ↔ _
  rw [BinaryFlags.NaturalGeometry.pairVector_map,
    BinaryFlags.NaturalGeometry.pairVector_eq_iff (g.injective.ne (by decide)) (by decide)]
  change pair (g 4) (g 5) = pair 4 5 ↔ (pair 4 5).image g = pair 4 5
  simp only [pair, Finset.image_insert, Finset.image_singleton]

private theorem not_conjugate_D_of_even {A : Subgroup S6}
    (hA : A ≤ alternatingGroup (Fin 6)) : ¬ IsConjugateTo A (D 6) := by
  rintro ⟨g, rfl⟩
  have hx := hA (mem_map_of_mem (MulAut.conj g).toMonoidHom
    (pairSwap_mem (n := 6) (m := 3) 0 (by decide)))
  have hy := (inferInstance : (alternatingGroup (Fin 6)).Normal).conj_mem _ hx g⁻¹
  have he : g⁻¹ * ((MulAut.conj g) (pairSwap 6 0)) * (g⁻¹)⁻¹ = pairSwap 6 0 := by
    simp [MulAut.conj_apply, mul_assoc]
  change g⁻¹ * ((MulAut.conj g) (pairSwap 6 0)) * (g⁻¹)⁻¹ ∈ alternatingGroup (Fin 6) at hy
  rw [he] at hy
  exact (by decide : pairSwap 6 0 ∉ alternatingGroup (Fin 6)) hy

/-- No strong natural-module offender is contained in the alternating component. -/
theorem not_strong_natural_of_even {A : Subgroup S6}
    (hA : A ≤ alternatingGroup (Fin 6)) :
    ¬ IsStrongOffender (BinaryPermutation.naturalRepresentation (Fin 6)) A := by
  intro hs
  exact not_conjugate_D_of_even hA ((isStrongOffender_natural_iff A).mp hs)

/-- No strong core-module offender is contained in the alternating component. -/
theorem not_strong_core_of_even {A : Subgroup S6}
    (hA : A ≤ alternatingGroup (Fin 6)) :
    ¬ IsStrongOffender (BinaryPermutation.coreRepresentation (Fin 6)) A := by
  intro hs
  exact not_conjugate_D_of_even hA ((isStrongOffender_core_iff A).mp hs)

end SixPoint

/-- The actual six-letter point-stabilizer contradiction once the component
submodule and its point have been identified. No no-offender input remains. -/
theorem exclude_six_natural_point
    {G : Type*} [Group G] [Finite G]
    {H U Z Vα Vγ : Subgroup G} [IsElementaryAbelian 2 U]
    (action : SectionAction H U Z) (Y₀ T : Subgroup G)
    (U₀ : Subrepresentation action.representation)
    (e : (H ⧸ pCore 2 H) ≃* S6)
    (E : U₀.toSubmodule ≃ₗ[ZMod 2] BinaryPermutation.natural (Fin 6))
    (hE : ∀ g v, E (U₀.toRepresentation g v) =
      BinaryPermutation.naturalRepresentation (Fin 6) (e g) (E v))
    (z : U₀.toSubmodule)
    (hz : E z = BinaryFlags.NaturalGeometry.pairVector 4 5)
    (hP : starImage H Y₀ ⊔ starImage H T = pointStabilizer U₀.toRepresentation z)
    (hα : starImage H Vα ≤ localTwoCore (starImage H Y₀ ⊔ starImage H T))
    (g : H ⧸ pCore 2 H)
    (hconj : starImage H Vα = (starImage H Vγ).map (MulAut.conj g).toMonoidHom)
    (hγ : IsStrongOffender action.representation (starImage H Vγ)) : False := by
  apply exclude_strong_at_submodule_point action.representation
    (BinaryPermutation.naturalRepresentation (Fin 6)) U₀ e E hE z
      (starImage H Y₀ ⊔ starImage H T) (starImage H Vα) hP hα
  · rw [hz, SixPoint.natural_point_stabilizer]
    exact fun _ hB => SixPoint.not_strong_natural hB
  · exact strong_alpha action hγ g hconj

end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ModelExclusions
