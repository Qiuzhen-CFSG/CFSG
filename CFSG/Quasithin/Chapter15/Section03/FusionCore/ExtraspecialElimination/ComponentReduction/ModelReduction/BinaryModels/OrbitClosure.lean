module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.BinaryModels.OrbitClosure.ProjectionEnvelope
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.BinaryModels.OrbitClosure.TwoFactors
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.BinaryModels.OrbitClosure.StarTransport
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.BinaryModels.OrbitClosure.Models

/-!
# Eliminating the component orbit in 15.3.49(l)

For a nontrivial orbit, the exact 1.2.1(3) alternatives give two conjugate
components. In the centerless case they commute with trivial intersection.
Projecting Y₀* onto both factors constructs a solvable product P, normalized
by (Y₀T)*, generated by cubic elements, and of order divisible by nine.
Universal (j) and θ(M ∩ H) = Y₀ rule out this P.

This first disposes of L₃(2). The same argument handles every exact
nonnormal model: the published model theorems show that all are centerless
once quasisimplicity excludes the small solvable PSL₂ parameter. Thus the
closure proof works for any quasisimple component quotient, including the
entire binary catalogue, without needing additional model-comparison inputs.
The section action, quadratic offenders, and explicit (i), (j), and (k)
remain in SourceSetup. Relative normality in the replacement H and the
literal Sylow intersection follow after closure equality.

The universal earlier orbit theorem and quasisimplicity are explicit task
inputs; the parent supplies them. The minimal-parabolic assertion and the
remaining clauses of (l) are not asserted here.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), printed
pp.1143–1144; Proposition 1.2.1(3), printed p.504.
-/

@[expose] public section
open Subgroup Theory.GroupTheory
open CFSG.Quasithin.Chapter1
open CFSG.Quasithin.Chapter15.Section03
open CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination
namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.BinaryModels.OrbitClosure.SourceSetup
universe u
variable {G : Type u} [Group G] [Finite G] {κ : CFSG.Quasithin.GroupClass.{u}}
    {H M Y L T ZS Z A : Subgroup G} [IsElementaryAbelian 2 (localSpan ZS H)]
    (d : SourceSetup κ H M Y L T ZS Z A)
    [IsQuasisimple (L ⧸ pCore 2 L)]
include d

/-- The orbit itself constructs the invariant solvable cubic envelope forbidden by (j). -/
theorem no_two_orbit (hne : localSpan L T ≠ L)
    (hi : (normalizer (L.subgroupOf H : Set H)).index = 2)
    (hz : center (L ⧸ pCore 2 L) = ⊥) : False := by
  let D := H ⧸ pCore 2 H
  let B := starImage H L
  let Ys := starImage H Y
  let Ts := starImage H T
  let S := starImage H (Y ⊔ T)
  let e := componentStarEquiv H L d.component_le_H d.component_in_H
  let : IsQuasisimple B := starImage_quasisimple H L d.component_le_H d.component_in_H
  let := pCore_isNilpotent (p := 2) (G := H)
  have hB : IsComponent D B :=
    ⟨(d.component_in_H.map_quotient (pCore 2 H)).subnormal, inferInstance⟩
  have hZ : center B = ⊥ := by
    apply eq_bot_of_card_eq
    rw [← Nat.card_congr (centerCongr e).toEquiv, hz, card_bot]
  have hiB : (normalizer (B : Set D)).index = 2 :=
    (cComponent_normalizer_index_quotient d.component_in_H (pCore 2 H)).trans hi
  obtain ⟨C, hd, hc, hY, hb, hcne, hcg, hpair⟩ := pair_of_two_orbit B Ys Ts
    hB hZ hiB (star_moves d hne) (star_containment d) (star_normalizes d) (star_commutator d)
  have hYn : S ≤ normalizer (Ys : Set D) := by
    have hYH : Y ≤ H := (d.control.theta_eq ▸ theta_le _).trans inf_le_right
    have hTH : T ≤ H := (isSylowIn_iff.mp d.control.sylow).2.1
    apply le_normalizer_iff_commutator_le_left.mpr
    rw [← starImage_commutator H Y (Y ⊔ T) hYH (sup_le hYH hTH)]
    exact map_mono (comap_mono (le_normalizer_iff_commutator_le_left.mp
      (sup_le Y.le_normalizer d.control.normalizes)))
  let : Group.IsSolvable Ys := star_solvable d
  obtain ⟨hsol, ht, hn, hdiv⟩ := projectionEnvelope_properties B C Ys S
    hd hc hY (star_theta d) hb hcne (star_commutator d) hcg hYn (fun s _ => hpair s)
  let := hsol
  exact no_invariant_solvable_cubic_product_star H M Y T d.control
    (projectionEnvelope B C Ys) ht hn hdiv

/-- The possible L₃(2) orbit collapses by the actual projection envelope. -/
theorem closure_eq_of_linear_three (earlier : EarlierOrbitAlternative κ)
    (e : (L ⧸ pCore 2 L) ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 3) (ZMod 2)) :
    localSpan L T = L := by
  by_contra hn
  exact no_two_orbit d hn (d.nonnormal_alternative earlier hn).1
    (linear_three_center_eq_bot e)

/-- Clause L₀ = L follows from the genuine replacement hypotheses and the exact
universal 1.2.1(3) alternative. Quasisimplicity is supplied by the model sieve. -/
theorem closure_eq (earlier : EarlierOrbitAlternative κ) : localSpan L T = L := by
  by_contra hn
  obtain ⟨hi, hm⟩ := d.nonnormal_alternative earlier hn
  exact no_two_orbit d hn hi (nonnormal_model_center_eq_bot hm)


/-- Closure, relative normality, T-normalization, and the two literal Sylow sections. -/
theorem closure_structure (earlier : EarlierOrbitAlternative κ) :
    localSpan L T = L ∧ (L.subgroupOf H).Normal ∧ T ≤ normalizer (L : Set G) ∧
      IsSylowIn 2 (T ⊓ L) L ∧
      IsSylowIn 2 (starImage H (T ⊓ L)) (starImage H L) := by
  have he := closure_eq d earlier
  obtain ⟨hn, ht⟩ := d.normal_and_normalized_of_closure_eq he
  exact ⟨he, hn, ht, d.sylow_sections⟩

end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.BinaryModels.OrbitClosure.SourceSetup
