/-!
# G₂ normalizer commutators, parity and cubic rank

The Borel projection to the two-parameter split torus kills commutators.
Its order is q⁶(q − 1)², which is prime to three in odd binary degree.
In even degree, a cubic field unit in each independent torus coordinate
embeds an elementary nine into the subgroup generated by order-three
normalizer elements. Sylow conjugacy transports all three conclusions
inside the full split-octonion automorphism group.

The final theorem assembles `NormalizerData` using the concrete Bruhat and
root-cell calculation to place every solvable standard-Sylow overgroup in
the Borel. Thus the model calculation retains only the field order and
degree assumptions, including the field of four elements.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), proof of
15.3.49 after (k), printed p.1144. The octonion model and split torus are
from the licensed ATLAS port; see LICENSES/ATLAS.txt and
LICENSES/ATLAS-CITATION.cff.
-/

public section

open Subgroup Atlas.G2 Atlas.G2.EvenBorelTorus
open CFSG.Quasithin.Chapter15.Section03
open scoped commutatorElement

namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.LargerFields.RankOne.ModelGeometry

variable {F : Type*} [Field F]

private theorem borel_commutator : ⁅borel (K := F), borel (K := F)⁆ ≤ unipotent (K := F) := by
  apply Subgroup.commutator_le.mpr
  intro a ha b hb
  have hm : ⁅(⟨a,ha⟩ : borel (K := F)), ⟨b,hb⟩⁆ ∈ (projection (F := F)).ker := by
    change projection _ = 1
    rw [map_commutatorElement]
    simp [commutatorElement_def]
  rw [projection_ker] at hm
  exact hm

variable [Finite F] [CharP F 2]

/-- Odd field degree makes every Sylow normalizer three-prime. -/
theorem g2_normalizer_threePrime_of_odd {n : ℕ} (hF : Nat.card F = 2 ^ n) (hn : Odd n)
    (S : Sylow 2 (Model F)) : ¬ 3 ∣ Nat.card (normalizer (S : Set (Model F))) := by
  rw [Nat.card_congr (sylowNormalizerEquiv S).toEquiv, card_borel, hF]
  have hc : Nat.Coprime 3 ((2 ^ n) ^ 6 * (2 ^ n - 1) ^ 2) :=
    (((by decide : Nat.Coprime 3 2).pow_right n).pow_right 6).mul_right
      ((Nat.BinaryTorusParity.coprime_three_sub_one hn).pow_right 2)
  exact Nat.prime_three.coprime_iff_not_dvd.mp hc

/-- Two independent cubic coordinates in the actual split torus give rank two
inside theta of every Sylow normalizer, including over the field of order four. -/
theorem g2_theta_normalizer_rank {n : ℕ} (hF : Nat.card F = 2 ^ n) (hn : Even n)
    (S : Sylow 2 (Model F)) : 2 ≤ primeRank 3 (theta (normalizer (S : Set (Model F)))) := by
  obtain ⟨u, hu⟩ := exists_prime_orderOf_dvd_card' (G := Fˣ) 3 (by
    rw [Nat.card_units, hF]
    exact (Nat.BinaryTorusParity.three_dvd_sub_one_iff n).mpr hn)
  let A := zpowers u
  have hA : Nat.card A = 3 := (Nat.card_zpowers u).trans hu
  have hcube (a : A) : a ^ 3 = 1 := by
    rw [← hA]
    exact pow_card_eq_one'
  let E := A × A
  have hE : Nat.card E = 3 ^ 2 := by rw [Nat.card_prod, hA]; norm_num
  have hcubeE (a : E) : a ^ 3 = 1 := Prod.ext (hcube a.1) (hcube a.2)
  let t : E →* Model F := torusHom.comp (A.subtype.prodMap A.subtype)
  have ht : Function.Injective t := torusHom_injective.comp
    (fun a b h => Prod.ext (Subtype.ext (congrArg Prod.fst h))
      (Subtype.ext (congrArg Prod.snd h)))
  obtain ⟨g, _, hg⟩ := sylow_normalizer_conjugate S
  let f : E →* Model F := (MulAut.conj g).toMonoidHom.comp t
  have hf : Function.Injective f := (MulAut.conj g).injective.comp ht
  have hmem (a : E) : f a ∈ theta (normalizer (S : Set (Model F))) := by
    by_cases h : f a = 1
    · rw [h]; exact one_mem _
    apply Subgroup.subset_closure
    refine ⟨?_, orderOf_eq_prime ?_ h⟩
    · rw [← hg]
      apply mem_map_of_mem
      exact (le_sup_right : splitTorus (K := F) ≤ borel) ⟨_,rfl⟩
    · rw [← map_pow, hcubeE, map_one]
  let fθ := f.codRestrict _ hmem
  exact primeRank_ge_of_elementary_embedding hcubeE hE fθ
    (fun a b h => hf (congrArg Subtype.val h))

/-- The normalizer quotient is a split torus, so its commutator lies in the
specified Sylow subgroup. -/
theorem g2_normalizer_commutator_le (S : Sylow 2 (Model F)) :
    ⁅normalizer (S : Set (Model F)), normalizer (S : Set (Model F))⁆ ≤ S := by
  obtain ⟨g, hu, hb⟩ := sylow_normalizer_conjugate S
  rw [← hb, ← map_commutator, ← hu]
  exact map_mono borel_commutator

private theorem solvable_overgroups_of_standard_borel
    (hB : ∀ H : Subgroup (Model F), unipotent ≤ H → Group.IsSolvable H → H ≤ borel)
    (S : Sylow 2 (Model F)) (H : Subgroup (Model F))
    (hH : Group.IsSolvable H) (hS : (S : Subgroup (Model F)) ≤ H) :
    H ≤ normalizer (S : Set (Model F)) := by
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq (Model F) S (LieParabolicSetup.sylow (F := F))
  let e := MulAut.conj g
  have he : (S : Subgroup (Model F)).map e.toMonoidHom = unipotent :=
    congrArg Sylow.toSubgroup hg
  let K := H.map e.toMonoidHom
  have hU : unipotent ≤ K := by rw [← he]; exact map_mono hS
  let _ : Group.IsSolvable H := hH
  have hK : Group.IsSolvable K := Group.isSolvable_of_surjective
    (f := (H.equivMapOfInjective e.toMonoidHom e.injective).toMonoidHom)
    (H.equivMapOfInjective e.toMonoidHom e.injective).surjective
  have hb := hB K hU hK
  rw [← SylowNormalizer.normalizer_unipotent, ← he, ← map_equiv_normalizer_eq] at hb
  exact (map_le_map_iff_of_injective e.injective).mp hb

/-- The remaining geometric input is placement of a solvable overgroup of the
standard positive-root Sylow in a full parabolic. The existing parabolic
refinement then puts it in the Borel; conjugacy handles every supplied Sylow.
This conditional assembly is not the unconditional model-normalizer theorem. -/
theorem g2_normalizerData_of_standard_placement {n : ℕ}
    (hF : Nat.card F = 2 ^ n) (hn : 1 < n)
    (hP : ∀ H : Subgroup (Model F), unipotent ≤ H → Group.IsSolvable H →
      H ≤ LieParabolicSetup.parabolic₁ ∨ H ≤ LieParabolicSetup.parabolic₂) :
    NormalizerData (Model F) n 2 := by
  have hq : 2 < Nat.card F := by
    rw [hF]
    simpa using Nat.pow_lt_pow_right (by decide : 1 < 2) hn
  have hB (H : Subgroup (Model F)) (hU : unipotent ≤ H)
      (hH : Group.IsSolvable H) : H ≤ borel := by
    have hN := SolvableParabolic.normalizes hq
      (LieParabolicSetup.sylow (F := F)) H hU hH (hP H hU hH)
    change H ≤ normalizer (unipotent (K := F) : Set (Model F)) at hN
    rwa [SylowNormalizer.normalizer_unipotent] at hN
  exact ⟨solvable_overgroups_of_standard_borel hB,
    g2_normalizer_commutator_le, g2_normalizer_threePrime_of_odd hF,
    g2_theta_normalizer_rank hF⟩

/-- The complete larger-field G₂ normalizer data for the full split-octonion
model, with the standard-Sylow placement proved by its Bruhat decomposition. -/
theorem g2_normalizerData {n : ℕ} (hF : Nat.card F = 2 ^ n) (hn : 1 < n) :
    NormalizerData (Model F) n 2 := by
  have hq : 2 < Nat.card F := by
    rw [hF]
    simpa using Nat.pow_lt_pow_right (by decide : 1 < 2) hn
  exact g2_normalizerData_of_standard_placement hF hn
    (fun H hU hH => SolvableSylowPlacement.le_parabolic hq H hU hH)

end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.LargerFields.RankOne.ModelGeometry
