module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.BinaryModels.OrbitClosure.SourceSetup

/-!
# Transporting the component orbit to the star quotient

The actual quotient map carries the T-conjugate span and the commutator
identity to H/O₂(H). The solvable-quotient correspondence of C-components
also preserves failure of T-normalization. The image of Y remains solvable
and generated by elements of order three, as required by the projection
construction.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), printed
p.1144, clauses (b), (i), and (k) in the proof of 15.3.49.
-/

@[expose] public section
open Subgroup
open CFSG.Quasithin.Chapter1
open CFSG.Quasithin.Chapter15.Section03
open CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination
open CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction
open CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction
namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.BinaryModels.OrbitClosure.SourceSetup
variable {G D : Type*} [Group G] [Group D]
private theorem map_span (L T : Subgroup G) (f : G →* D) :
    (conjugateSpanBy L T).map f = conjugateSpanBy (L.map f) (T.map f) := by
  unfold conjugateSpanBy
  rw [MonoidHom.map_closure]
  congr 1
  ext x
  constructor
  · rintro ⟨_, ⟨t, ht, l, hl, rfl⟩, rfl⟩
    exact ⟨f t, mem_map_of_mem f ht, f l, mem_map_of_mem f hl, by simp⟩
  · rintro ⟨_, ⟨t, ht, rfl⟩, _, ⟨l, hl, rfl⟩, rfl⟩
    exact ⟨t * l * t⁻¹, ⟨t, ht, l, hl, rfl⟩, by simp⟩

variable [Finite G] {κ : CFSG.Quasithin.GroupClass} {H M Y L T ZS Z A : Subgroup G}
    [IsElementaryAbelian 2 (localSpan ZS H)]
    (d : SourceSetup κ H M Y L T ZS Z A)
include d

omit [Finite G] in
theorem star_containment : starImage H Y ≤
    conjugateSpanBy (starImage H L) (starImage H T) := by
  have hTH : T ≤ H := (isSylowIn_iff.mp d.control.sylow).2.1
  have hYH : Y ≤ H := (d.control.theta_eq ▸ theta_le _).trans inf_le_right
  have hY' : Y.subgroupOf H ≤ conjugateSpanBy (L.subgroupOf H) (T.subgroupOf H) := by
    apply (map_le_map_iff_of_injective H.subtype_injective).mp
    rw [map_span, map_subgroupOf_eq_of_le d.component_le_H,
      map_subgroupOf_eq_of_le hTH, map_subgroupOf_eq_of_le hYH]
    exact d.y_le_closure
  have he := map_mono (f := QuotientGroup.mk' (pCore 2 H)) hY'
  rw [map_span] at he
  exact he

omit [Finite G] in
theorem star_normalizes : starImage H T ≤
    normalizer (starImage H Y : Set (H ⧸ pCore 2 H)) := by
  have hTH : T ≤ H := (isSylowIn_iff.mp d.control.sylow).2.1
  have hYH : Y ≤ H := (d.control.theta_eq ▸ theta_le _).trans inf_le_right
  apply le_normalizer_iff_commutator_le_left.mpr
  rw [← starImage_commutator H Y T hYH hTH]
  exact map_mono (comap_mono (le_normalizer_iff_commutator_le_left.mp d.control.normalizes))

omit [Finite G] in
theorem star_commutator : starImage H L = ⁅starImage H L, starImage H Y⁆ := by
  have hYH : Y ≤ H := (d.control.theta_eq ▸ theta_le _).trans inf_le_right
  rw [← starImage_commutator H L Y d.component_le_H hYH, ← d.commutator_eq]

theorem star_moves (hne : localSpan L T ≠ L) :
    ¬ starImage H T ≤ normalizer (starImage H L : Set (H ⧸ pCore 2 H)) := by
  intro hn
  let _ := pCore_isNilpotent (p := 2) (G := H)
  have hi : T.subgroupOf H ≤ normalizer (L.subgroupOf H : Set H) := by
    have h := map_le_iff_le_comap.mp hn
    unfold starImage at h
    rwa [normalizer_cComponent_quotient d.component_in_H (pCore 2 H)] at h
  have ht : T ≤ normalizer (L : Set G) := by
    have h := (map_mono (f := H.subtype) hi).trans ((L.subgroupOf H).le_normalizer_map H.subtype)
    rwa [map_subgroupOf_eq_of_le d.component_le_H,
      map_subgroupOf_eq_of_le (isSylowIn_iff.mp d.control.sylow).2.1] at h
  exact hne (le_antisymm (conjugateSpanBy_le le_rfl ht) (le_conjugateSpanBy L T))

omit [Finite G] in
theorem star_theta : theta (starImage H Y) = starImage H Y := by
  have hYH : Y ≤ H := (d.control.theta_eq ▸ theta_le _).trans inf_le_right
  have ht : theta (Y.subgroupOf H) = Y.subgroupOf H := by
    apply map_injective H.subtype_injective
    rw [theta_map_of_injective _ H.subtype_injective,
      map_subgroupOf_eq_of_le hYH, ← d.control.theta_eq, theta_idempotent]
  apply le_antisymm (theta_le _) _
  have hh := theta_map_le (Y.subgroupOf H) (QuotientGroup.mk' (pCore 2 H))
  rwa [ht] at hh

omit [Finite G] in
theorem star_solvable : Group.IsSolvable (starImage H Y) := by
  let _ := d.control.solvable_intersection
  have hYH : Y ≤ H := (d.control.theta_eq ▸ theta_le _).trans inf_le_right
  let _ : Group.IsSolvable Y := Group.isSolvable_of_isSolvable_injective
    (inclusion_injective (d.control.theta_eq ▸ theta_le (M ⊓ H)))
  let _ : Group.IsSolvable (Y.subgroupOf H) := Group.isSolvable_of_isSolvable_injective
    (f := (subgroupOfEquivOfLe hYH).toMonoidHom) (subgroupOfEquivOfLe hYH).injective
  exact Group.isSolvable_of_surjective ((QuotientGroup.mk' (pCore 2 H)).subgroupMap_surjective (Y.subgroupOf H))
end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.BinaryModels.OrbitClosure.SourceSetup
