module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.LargerFields.RankOne.ModelGeometry.NormalizerData
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.LargerFields.RankOne.LocalGeometry
public import Theory.GroupTheory.SylowNormalizerCommutingFamily.FactorControl
public import Theory.GroupTheory.ComponentLocalDirectPowerSection
public import Theory.GroupTheory.SolvableRadical.SolvableKernel


/-!
# Borel placement in a central product

Cubes in the two-core make C a solvable two-by-three group. Adjoining its
normalizing Sylow subgroup preserves solvability. The multiplication map
from the actual commuting factors has central kernel, so the preimage of
this solvable overgroup remains solvable. Coordinate projection and the
concrete solvable-overgroup theorem put it in the product Borel. The
normalizer and commutator calculations descend through the surjection.
Thus C lies in the ambient Borel, which normalizes C and has cubic theta
rank at most one. No disjointness of the factors is used.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), proof of
15.3.49 after (k), printed p.1144.
-/

public section
open Subgroup
open scoped IsMulCommutative
open CFSG.Quasithin.Chapter15.Section03
namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.LargerFields.RankOne.ModelGeometry
variable {D : Type*} [Group D] [Finite D]

/-- The cubic condition gives a solvable subgroup, by a two-by-three extension. -/
private theorem solvable_of_cubes (C : Subgroup D)
    (hc : ∀ c : C, c ^ 3 ∈ pCore 2 C) : Group.IsSolvable C := by
  have hp : IsPGroup 3 (C ⧸ pCore 2 C) := by
    intro x
    obtain ⟨c, rfl⟩ := QuotientGroup.mk'_surjective (pCore 2 C) x
    refine ⟨1, ?_⟩
    change (QuotientGroup.mk' (pCore 2 C)) c ^ 3 = 1
    rw [← map_pow]
    exact (QuotientGroup.eq_one_iff _).mpr (hc c)
  let : Group.IsNilpotent (pCore 2 C) := (pCore_isPGroup (p := 2) (G := C)).isNilpotent
  let : Group.IsNilpotent (C ⧸ pCore 2 C) := hp.isNilpotent
  exact (Group.isSolvable_iff_subgroup_quotient (pCore 2 C)).mpr
    ⟨inferInstance, inferInstance⟩

/-- The subgroup generated by C and a normalizing Sylow subgroup is solvable. -/
private theorem solvable_sup (C : Subgroup D) (S : Sylow 2 D)
    (hc : ∀ c : C, c ^ 3 ∈ pCore 2 C)
    (hn : (S : Subgroup D) ≤ normalizer (C : Set D)) :
    Group.IsSolvable (C ⊔ (S : Subgroup D) : Subgroup D) := by
  let H := C ⊔ (S : Subgroup D)
  let A := C.subgroupOf H
  let B := (S : Subgroup D).subgroupOf H
  let : A.Normal := normal_subgroupOf_of_le_normalizer (sup_le C.le_normalizer hn)
  let : Group.IsSolvable C := solvable_of_cubes C hc
  let : Group.IsSolvable A := Group.isSolvable_of_isSolvable_injective
    (f := (subgroupOfEquivOfLe (show C ≤ H from le_sup_left)).toMonoidHom)
    (subgroupOfEquivOfLe (show C ≤ H from le_sup_left)).injective
  let : Group.IsNilpotent B := S.isPGroup'.comap_subtype.isNilpotent
  apply Group.isSolvable_of_normal_sup_eq_top A B
  apply map_injective H.subtype_injective
  simp [A, B, H, Subgroup.map_sup, le_sup_left, le_sup_right, ← MonoidHom.range_eq_map]

section Product
variable {ι : Type*} [Fintype ι] (K : ι → Type*)
    [∀ i, Group (K i)] [∀ i, Finite (K i)]

/-- Membership in a product Sylow is coordinatewise. -/
private theorem mem_product_sylow (P : Sylow 2 (∀ i, K i)) (x : ∀ i, K i) :
    x ∈ P ↔ ∀ i, x i ∈ P.map (Pi.evalMonoidHom K i) := by
  let R : Subgroup (∀ i, K i) := Subgroup.pi Set.univ
    (fun i => P.map (Pi.evalMonoidHom K i))
  have hp : IsPGroup 2 R := by
    intro y
    choose n hn using fun i =>
      (P.mapSurjective (Function.surjective_eval i)).isPGroup'
        ⟨y.val i, y.property i (Set.mem_univ i)⟩
    refine ⟨∑ i, n i, Subtype.ext (funext fun i => ?_)⟩
    have hi : n i ≤ ∑ j, n j := Finset.single_le_sum
      (fun j _ => Nat.zero_le (n j)) (Finset.mem_univ i)
    have he : y.val i ^ (2 ^ n i) = 1 := congrArg Subtype.val (hn i)
    exact orderOf_dvd_iff_pow_eq_one.mp ((orderOf_dvd_of_pow_eq_one he).trans
      (pow_dvd_pow 2 hi))
  have hPR : (P : Subgroup (∀ i, K i)) ≤ R :=
    fun y hy i _ => mem_map_of_mem _ hy
  have he := P.is_maximal' hp hPR
  change x ∈ (P : Subgroup (∀ i, K i)) ↔ _
  conv_lhs => rw [← he]
  simp only [R, mem_pi, Set.mem_univ, forall_const]

/-- Solvable-overgroup normalization passes to finite products. -/
private theorem product_solvable_overgroups
    (hK : ∀ i, ∀ (P : Sylow 2 (K i)) (H : Subgroup (K i)),
      Group.IsSolvable H → (P : Subgroup (K i)) ≤ H →
        H ≤ normalizer (P : Set (K i)))
    (P : Sylow 2 (∀ i, K i)) (H : Subgroup (∀ i, K i))
    (hH : Group.IsSolvable H) (hPH : (P : Subgroup (∀ i, K i)) ≤ H) :
    H ≤ normalizer (P : Set (∀ i, K i)) := by
  let _ := hH
  have hn (i : ι) : H.map (Pi.evalMonoidHom K i) ≤
      normalizer (P.map (Pi.evalMonoidHom K i) : Set (K i)) :=
    hK i (P.mapSurjective (Function.surjective_eval i)) _
      (Group.isSolvable_of_surjective ((Pi.evalMonoidHom K i).subgroupMap_surjective H))
      (map_mono hPH)
  apply le_normalizer_iff.mpr
  intro x hx y hy
  apply (mem_product_sylow K P _).mpr
  intro i
  exact ((mem_normalizer_iff.mp (hn i (mem_map_of_mem _ hx))) (y i)).mp
    ((mem_product_sylow K P y).mp hy i)

/-- The Borel commutator bound passes to finite products. -/
private theorem product_commutator_le
    (hK : ∀ i, ∀ P : Sylow 2 (K i),
      ⁅normalizer (P : Set (K i)), normalizer (P : Set (K i))⁆ ≤ P)
    (P : Sylow 2 (∀ i, K i)) :
    ⁅normalizer (P : Set (∀ i, K i)), normalizer (P : Set (∀ i, K i))⁆ ≤ P := by
  intro x hx
  apply (mem_product_sylow K P x).mpr
  intro i
  have hn := (P : Subgroup (∀ i, K i)).le_normalizer_map (Pi.evalMonoidHom K i)
  have he := mem_map_of_mem (Pi.evalMonoidHom K i) hx
  rw [map_commutator] at he
  exact hK i (P.mapSurjective (Function.surjective_eval i))
    (commutator_mono hn hn he)
end Product

omit [Finite D] in
/-- Pullback through a solvable central kernel preserves the overgroup argument. -/
private theorem image_solvable_overgroups {E : Type*} [Group E] [Finite E]
    (f : E →* D) (hf : Function.Surjective f) [Group.IsSolvable f.ker]
    (hE : ∀ (P : Sylow 2 E) (H : Subgroup E), Group.IsSolvable H →
      (P : Subgroup E) ≤ H → H ≤ normalizer (P : Set E))
    (S : Sylow 2 D) (H : Subgroup D) (hH : Group.IsSolvable H)
    (hSH : (S : Subgroup D) ≤ H) : H ≤ normalizer (S : Set D) := by
  let _ := hH
  obtain ⟨P, hP⟩ := Sylow.mapSurjective_surjective hf 2 S
  have hPS : P.map f = (S : Subgroup D) := congrArg Sylow.toSubgroup hP
  have hn := hE P (H.comap f) (isSolvable_comap_of_solvable_ker f H)
    (map_le_iff_le_comap.mp (hPS ▸ hSH))
  have hm := (map_mono (f := f) hn).trans ((P : Subgroup E).le_normalizer_map f)
  rwa [map_comap_eq_self_of_surjective hf, hPS] at hm

omit [Finite D] in
/-- Sylow-normalizer commutator bounds descend through arbitrary surjections. -/
private theorem image_commutator_le {E : Type*} [Group E] [Finite E]
    (f : E →* D) (hf : Function.Surjective f)
    (hE : ∀ P : Sylow 2 E, ⁅normalizer (P : Set E), normalizer (P : Set E)⁆ ≤ P)
    (S : Sylow 2 D) : ⁅normalizer (S : Set D), normalizer (S : Set D)⁆ ≤ S := by
  obtain ⟨P, hP⟩ := Sylow.mapSurjective_surjective hf 2 S
  have hPS : P.map f = (S : Subgroup D) := congrArg Sylow.toSubgroup hP
  have hn := P.normalizer_map_surjective f hf
  rw [hPS, Sylow.coe_coe] at hn
  rw [← hn, ← map_commutator]
  exact (map_mono (hE P)).trans_eq hPS

omit [Finite D] in
/-- The natural multiplication of actual commuting subgroups has central kernel. -/
private theorem family_kernel_central {ι : Type*} [Fintype ι]
    (K : ι → Subgroup D)
    (hc : Pairwise fun i j => ∀ x y : D, x ∈ K i → y ∈ K j → Commute x y) :
    (noncommPiCoprod hc).ker ≤ center (∀ i, K i) := by
  classical
  apply Theory.GroupTheory.ComponentLocalCoreSection.ker_le_center_of_injective_factors
  intro i a b hab
  apply Subtype.ext
  simpa only [MonoidHom.comp_apply, MonoidHom.mulSingle_apply,
    noncommPiCoprod_mulSingle] using hab

/-- The Borel containing C and the chosen Sylow exists in a central product
once each factor's solvable-overgroup theorem and commutator bound are proved. -/
theorem family_borel {ι : Type*} [Fintype ι]
    (K : ι → Subgroup D)
    (hc : Pairwise fun i j => K i ≤ centralizer (K j : Set D))
    (hgen : iSup K = ⊤) (n : ℕ) (r : ι → ℕ)
    (hK : ∀ i, NormalizerData (K i) n (r i))
    (C : Subgroup D) (hC : CubicSylowControl D C)
    (S : Sylow 2 D) (hn : (S : Subgroup D) ≤ normalizer (C : Set D)) :
    C ≤ normalizer (S : Set D) ∧
      normalizer (S : Set D) ≤ normalizer (C : Set D) ∧
      primeRank 3 (theta (normalizer (S : Set D))) ≤ 1 := by
  have hcomm : Pairwise fun i j => ∀ x y : D,
      x ∈ K i → y ∈ K j → Commute x y :=
    fun _ _ hij _x y hx hy => (hc hij hx y hy).symm
  let f := noncommPiCoprod hcomm
  have hf : Function.Surjective f := MonoidHom.range_eq_top.mp
    (noncommPiCoprod_range.trans hgen)
  let : Group.IsSolvable f.ker := Group.isSolvable_of_isSolvable_injective
    (f := inclusion (family_kernel_central K hcomm))
    (inclusion_injective (family_kernel_central K hcomm))
  have hCB : C ≤ normalizer (S : Set D) := le_sup_left.trans
    (image_solvable_overgroups f hf
      (product_solvable_overgroups (fun i => K i) (fun i => (hK i).solvable_overgroups))
      S _ (solvable_sup C S hC.cubes hn) le_sup_right)
  have hb := image_commutator_le f hf
    (product_commutator_le (fun i => K i) (fun i => (hK i).commutator_le)) S
  exact ⟨hCB, borel_le_normalizer _ _ C hCB S.le_normalizer hn hb hC.theta_normalizer,
    hC.borel_rank_le_one C _ _ hCB S.le_normalizer hn hb⟩
end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.LargerFields.RankOne.ModelGeometry
