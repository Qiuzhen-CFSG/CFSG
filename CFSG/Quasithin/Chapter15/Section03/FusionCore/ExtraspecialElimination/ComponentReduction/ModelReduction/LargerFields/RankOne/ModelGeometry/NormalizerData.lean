module

public import CFSG.Quasithin.Chapter15.Section03.Preliminaries.Elementary
public import Theory.GroupTheory.PrimeRankProduct

/-!
# Concrete normalizer facts for the larger-field reduction

The four models must supply solvable-overgroup placement, the Borel
commutator bound, absence of cubic elements in odd field degree, and an
actual cubic-rank lower bound in even degree. These are independent
model calculations, not assumptions of the final source theorem.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), proof of
15.3.49 after (k), printed p.1144.
-/

public section
open Subgroup
open CFSG.Quasithin.Chapter15.Section03
namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.LargerFields.RankOne.ModelGeometry

/-- The concrete facts needed from a model's Sylow normalizers. The rank is
measured on the subgroup generated by actual elements of order three. -/
structure NormalizerData (D : Type*) [Group D] (n r : ℕ) : Prop where
  solvable_overgroups : ∀ (S : Sylow 2 D) (H : Subgroup D),
    Group.IsSolvable H → (S : Subgroup D) ≤ H → H ≤ normalizer (S : Set D)
  commutator_le : ∀ S : Sylow 2 D,
    ⁅normalizer (S : Set D), normalizer (S : Set D)⁆ ≤ S
  odd : Odd n → ∀ S : Sylow 2 D, ¬ 3 ∣ Nat.card (normalizer (S : Set D))
  rank : Even n → ∀ S : Sylow 2 D, r ≤ primeRank 3 (theta (normalizer (S : Set D)))


end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.LargerFields.RankOne.ModelGeometry
