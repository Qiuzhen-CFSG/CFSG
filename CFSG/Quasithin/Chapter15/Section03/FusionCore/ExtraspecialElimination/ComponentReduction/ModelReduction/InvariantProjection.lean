variable {G D : Type*} [Group G] [Finite G] [Group D] [Finite D]

lemma cubic_le_image_theta_preimage (f : G →* D) (hf : Function.Surjective f)
    (hk : IsPGroup 2 f.ker) (P : Subgroup D) (hP : Nat.card P = 3) :
    P ≤ (theta (P.comap f)).map f := by
  let E := P.comap f
  let r : E →* P := (f.comp E.subtype).codRestrict P (fun x => x.property)
  have hr : Function.Surjective r := by
    intro x
    obtain ⟨y, hy⟩ := hf x
    exact ⟨⟨y, show f y ∈ P from hy ▸ x.property⟩, Subtype.ext hy⟩
  have hd : 3 ∣ Nat.card E := hP ▸ card_dvd_of_surjective r hr
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := E) 3 hd
  have hxG : orderOf (x : G) = 3 := (Subgroup.orderOf_coe x).trans hx
  have hxD : orderOf (f x) = 3 :=
    (f.orderOf_map_eq_of_coprime_of_isPGroup_ker hk x
      (hxG ▸ (by decide : Nat.Coprime 2 3))).trans hxG
  have he : zpowers (f x) = P := eq_of_le_of_card_ge
    (zpowers_le.mpr x.property) (by rw [Nat.card_zpowers, hxD, hP])
  apply he ▸ (show zpowers (f x) ≤ (theta (P.comap f)).map f from ?_)
  exact zpowers_le.mpr ⟨x, subset_closure ⟨x.property, hxG⟩, rfl⟩

omit [Finite D] in
private lemma solvable_join_of_normalized (A B : Subgroup D)
    [Group.IsSolvable A] [Group.IsSolvable B]
    (hn : B ≤ normalizer (A : Set D)) : Group.IsSolvable (A ⊔ B : Subgroup D) := by
  let A' := A.subgroupOf (A ⊔ B)
  let B' := B.subgroupOf (A ⊔ B)
  let : A'.Normal := (normal_subgroupOf_iff_le_normalizer le_sup_left).mpr
    (sup_le A.le_normalizer hn)
  let : Group.IsSolvable A' := Group.isSolvable_of_isSolvable_injective
    (f := (subgroupOfEquivOfLe (show A ≤ A ⊔ B from le_sup_left)).toMonoidHom)
    (subgroupOfEquivOfLe (show A ≤ A ⊔ B from le_sup_left)).injective
  let : Group.IsSolvable B' := Group.isSolvable_of_isSolvable_injective
    (f := (subgroupOfEquivOfLe (show B ≤ A ⊔ B from le_sup_right)).toMonoidHom)
    (subgroupOfEquivOfLe (show B ≤ A ⊔ B from le_sup_right)).injective
  exact Group.isSolvable_of_normal_sup_eq_top A' B' (codisjoint_subgroupOf_sup A B).eq_top

lemma invariant_cubic_le_image (f : G →* D) (hf : Function.Surjective f)
    (hk : IsPGroup 2 f.ker) (M Y T : Subgroup G)
    [Group.IsSolvable (Y ⊔ T : Subgroup G)] (hθ : theta M = Y)
    (hj : ∀ K : Subgroup G, Group.IsSolvable K → Y ⊔ T ≤ K → K ≤ M)
    (P : Subgroup D) (hP : Nat.card P = 3)
    (hn : (Y ⊔ T).map f ≤ normalizer (P : Set D)) : P ≤ Y.map f := by
  let S := (Y ⊔ T).map f
  let : IsCyclic P := isCyclic_of_prime_card hP
  let : Group.IsSolvable P := Group.isSolvable_of_comm (fun x y => mul_comm x y)
  let : Group.IsSolvable S := Group.isSolvable_of_surjective (f.subgroupMap_surjective (Y ⊔ T))
  let : Group.IsSolvable (P ⊔ S : Subgroup D) := solvable_join_of_normalized P S hn
  let : Group.IsNilpotent f.ker := hk.isNilpotent
  let : Group.IsSolvable ((P ⊔ S).comap f) := isSolvable_comap_of_solvable_ker f (P ⊔ S)
  have hKM := hj ((P ⊔ S).comap f) inferInstance
    ((map_le_iff_le_comap).mp le_sup_right)
  have hPM : P.comap f ≤ M := (comap_mono (show P ≤ P ⊔ S from le_sup_left)).trans hKM
  exact (cubic_le_image_theta_preimage f hf hk P hP).trans
    (map_mono ((theta_mono hPM).trans_eq hθ))

lemma invariant_cubic_le_starImage (H M Y T : Subgroup G)
    (hYH : Y ≤ H) (hTH : T ≤ H)
    [Group.IsSolvable (Y ⊔ T : Subgroup G)]
    (hθ : theta (M ⊓ H) = Y)
    (hj : ∀ K : Subgroup G, Group.IsSolvable K → Y ⊔ T ≤ K → K ≤ H → K ≤ M ⊓ H)
    (P : Subgroup (H ⧸ pCore 2 H)) (hP : Nat.card P = 3)
    (hn : starImage H (Y ⊔ T) ≤ normalizer (P : Set (H ⧸ pCore 2 H))) :
    P ≤ starImage H Y := by
  let Y' := Y.subgroupOf H
  let T' := T.subgroupOf H
  have hjoin : Y' ⊔ T' = (Y ⊔ T).subgroupOf H := by
    apply map_injective H.subtype_injective
    rw [Subgroup.map_sup, map_subgroupOf_eq_of_le hYH, map_subgroupOf_eq_of_le hTH,
      map_subgroupOf_eq_of_le (sup_le hYH hTH)]
  let : Group.IsSolvable (Y' ⊔ T' : Subgroup H) := by
    rw [hjoin]
    exact Group.isSolvable_of_isSolvable_injective
      (f := (subgroupOfEquivOfLe (sup_le hYH hTH)).toMonoidHom)
      (subgroupOfEquivOfLe (sup_le hYH hTH)).injective
  have hθ' : theta ((M ⊓ H).subgroupOf H) = Y' := by
    apply map_injective H.subtype_injective
    rw [theta_map_of_injective _ H.subtype_injective,
      map_subgroupOf_eq_of_le inf_le_right, hθ, map_subgroupOf_eq_of_le hYH]
  apply invariant_cubic_le_image (QuotientGroup.mk' (pCore 2 H))
    (QuotientGroup.mk'_surjective _) (by rw [QuotientGroup.ker_mk']; exact pCore_isPGroup)
    ((M ⊓ H).subgroupOf H) Y' T' hθ' ?_ P hP ?_
  · intro K hK hYK
    let := hK
    let : Group.IsSolvable (K.map H.subtype) :=
      Group.isSolvable_of_surjective (H.subtype.subgroupMap_surjective K)
    have hle : Y ⊔ T ≤ K.map H.subtype := by
      have hm := map_mono (f := H.subtype) hYK
      rwa [hjoin, map_subgroupOf_eq_of_le (sup_le hYH hTH)] at hm
    exact (map_le_iff_le_comap).mp (hj _ inferInstance hle (map_subtype_le K))
  · simpa only [hjoin, starImage] using hn


omit [Finite G] [Finite D] in
lemma pPerfect_le_of_image_le (f : G →* D) (hk : IsPGroup 2 f.ker)
    (Y L : Subgroup G) [L.Normal] (hY : IsPPerfect 2 Y)
    (himage : Y.map f ≤ L.map f) : Y ≤ L := by
  let q := QuotientGroup.mk' L
  have hle : Y ≤ L ⊔ f.ker := le_sup_left.trans ((map_le_map_iff').mp himage)
  have hm : Y.map q ≤ f.ker.map q := by
    have hh := map_mono (f := q) hle
    simpa only [q, Subgroup.map_sup, QuotientGroup.map_mk'_self, bot_sup_eq] using hh
  let r : Y →* f.ker.map q := (q.comp Y.subtype).codRestrict _
    (fun y => hm (mem_map_of_mem _ y.property))
  have hr := hY.hom_eq_one_of_isPGroup (hk.map q) r
  intro y hy
  apply (QuotientGroup.eq_one_iff (N := L) y).mp
  exact congrArg Subtype.val (DFunLike.congr_fun hr ⟨y, hy⟩)

omit [Finite G] in
private lemma conj_injective_of_center_eq_bot (hcenter : center G = ⊥) :
    Function.Injective (MulAut.conj : G →* MulAut G) := by
  apply (MonoidHom.ker_eq_bot_iff _).mp
  apply le_bot_iff.mp
  intro x hx
  have he (y : G) : x * y * x⁻¹ = y := DFunLike.congr_fun hx y
  have hc : x ∈ center G := mem_center_iff.mpr (fun y => by
    have hh := congrArg (fun z => z * x) (he y)
    simpa only [mul_assoc, inv_mul_cancel, mul_one] using hh.symm)
  simpa only [hcenter] using hc

omit [Finite D] in
lemma inner_projection_range_normalized (L Y S : Subgroup D) [L.Normal]
    (hcenter : center L = ⊥) (hn : S ≤ normalizer (Y : Set D))
    (π : Y →* L)
    (hπ : ∀ y : Y, MulAut.conj (π y) = (MulAut.conjNormal y : MulAut L)) :
    S ≤ normalizer (π.range.map L.subtype : Set D) := by
  apply le_normalizer_iff.mpr
  intro s hs x hx
  obtain ⟨l, ⟨y, rfl⟩, rfl⟩ := hx
  let y' : Y := ⟨s * y * s⁻¹, le_normalizer_iff.mp hn s hs y y.property⟩
  have he : π y' = MulAut.conjNormal s (π y) := by
    apply conj_injective_of_center_eq_bot hcenter
    rw [hπ]
    change MulAut.conjNormal (s * y * s⁻¹) = _
    rw [map_mul, map_mul, map_inv]
    rw [← hπ y]
    apply MulEquiv.ext
    intro l
    change MulAut.conjNormal s
        (π y * ((MulAut.conjNormal s)⁻¹ l) * (π y)⁻¹) =
      MulAut.conjNormal s (π y) * l * (MulAut.conjNormal s (π y))⁻¹
    simp only [map_mul, map_inv, MulAut.apply_inv_self]
  refine ⟨π y', ⟨y', rfl⟩, ?_⟩
  exact congrArg Subtype.val he

omit [Finite D] in
lemma exists_inner_projection (L Y : Subgroup D) [L.Normal]
    (hcenter : center L = ⊥)
    (hinner : ∀ y : Y, ∃ l : L, MulAut.conj l = (MulAut.conjNormal y : MulAut L)) :
    ∃ π : Y →* L, ∀ y : Y, MulAut.conj (π y) = (MulAut.conjNormal y : MulAut L) := by
  classical
  let π₀ : Y → L := fun y => (hinner y).choose
  have he (y : Y) : MulAut.conj (π₀ y) = (MulAut.conjNormal y : MulAut L) :=
    (hinner y).choose_spec
  refine ⟨{ toFun := π₀, map_one' := ?_, map_mul' := ?_ }, he⟩
  · apply conj_injective_of_center_eq_bot hcenter
    rw [he, map_one]
    exact map_one (MulAut.conjNormal : D →* MulAut L)
  · intro a b
    apply conj_injective_of_center_eq_bot hcenter
    rw [he, map_mul, he, he]
    exact map_mul (MulAut.conjNormal : D →* MulAut L) (a : D) (b : D)

omit [Finite D] in
lemma inner_projection_ne_one (L Y : Subgroup D) [L.Normal]
    (hcomm : L = ⁅L, Y⁆) (hL : L ≠ ⊥)
    (π : Y →* L)
    (hπ : ∀ y : Y, MulAut.conj (π y) = (MulAut.conjNormal y : MulAut L)) : π ≠ 1 := by
  intro hb
  have hc : Y ≤ centralizer (L : Set D) := by
    intro y hy
    rw [mem_centralizer_iff]
    intro l hl
    have he := congrArg (fun a : MulAut L => a ⟨l, hl⟩) (hπ ⟨y, hy⟩)
    rw [hb, MonoidHom.one_apply, map_one] at he
    have hh : l = y * l * y⁻¹ := congrArg Subtype.val he
    have hm := congrArg (fun z => z * y) hh
    simpa only [mul_assoc, inv_mul_cancel, mul_one] using hm
  exact hL (hcomm.trans (commutator_eq_bot_iff_le_centralizer.mpr (le_centralizer_iff.mp hc)))



omit [Finite G] [Finite D] in
lemma theta_map_le (X : Subgroup G) (f : G →* D) :
    (theta X).map f ≤ theta (X.map f) := by
  rw [theta, MonoidHom.map_closure, closure_le]
  rintro _ ⟨x, ⟨hx, ho⟩, rfl⟩
  have hd : orderOf (f x) ∣ 3 := ho ▸ orderOf_map_dvd f x
  rcases (Nat.dvd_prime Nat.prime_three).mp hd with h1 | h3
  · rw [orderOf_eq_one_iff.mp h1]
    exact one_mem _
  · exact subset_closure ⟨mem_map_of_mem _ hx, h3⟩

omit [Finite G] [Finite D] in
lemma theta_range_eq_self (X : Subgroup G) (hX : theta X = X) (f : X →* D) :
    theta f.range = f.range := by
  have ht : theta (⊤ : Subgroup X) = ⊤ := by
    apply map_injective X.subtype_injective
    rw [theta_map_of_injective _ X.subtype_injective, ← MonoidHom.range_eq_map,
      range_subtype, hX]
  apply le_antisymm (theta_le _) _
  simpa only [ht, ← MonoidHom.range_eq_map] using theta_map_le (⊤ : Subgroup X) f

lemma invariant_solvable_theta_le_image (f : G →* D) (hf : Function.Surjective f)
    (hk : IsPGroup 2 f.ker) (M Y T : Subgroup G)
    [Group.IsSolvable (Y ⊔ T : Subgroup G)] (hθ : theta M = Y)
    (hj : ∀ K : Subgroup G, Group.IsSolvable K → Y ⊔ T ≤ K → K ≤ M)
    (P : Subgroup D) [Group.IsSolvable P]
    (hn : (Y ⊔ T).map f ≤ normalizer (P : Set D)) : theta P ≤ Y.map f := by
  let S := (Y ⊔ T).map f
  let : Group.IsSolvable S := Group.isSolvable_of_surjective (f.subgroupMap_surjective (Y ⊔ T))
  let : Group.IsSolvable (P ⊔ S : Subgroup D) := solvable_join_of_normalized P S hn
  let : Group.IsNilpotent f.ker := hk.isNilpotent
  let : Group.IsSolvable ((P ⊔ S).comap f) := isSolvable_comap_of_solvable_ker f (P ⊔ S)
  have hKM := hj ((P ⊔ S).comap f) inferInstance
    ((map_le_iff_le_comap).mp le_sup_right)
  apply (closure_le _).mpr
  rintro x ⟨hx, horder⟩
  have hcx : zpowers x ≤ P ⊔ S := (zpowers_le.mpr hx).trans le_sup_left
  have hm : (theta ((zpowers x).comap f)).map f ≤ Y.map f :=
    map_mono ((theta_mono ((comap_mono hcx).trans hKM)).trans_eq hθ)
  exact hm (cubic_le_image_theta_preimage f hf hk (zpowers x)
    (by rwa [Nat.card_zpowers]) (mem_zpowers x))

omit [Finite G] in
lemma exists_cubic_of_theta (P : Subgroup G) (hP : theta P = P) (hne : P ≠ ⊥) :
    ∃ x ∈ P, orderOf x = 3 := by
  by_contra! h
  apply hne
  rw [← hP]
  apply le_bot_iff.mp
  exact (closure_le _).mpr (fun x hx => (h x hx.1 hx.2).elim)

omit [Finite D] in
lemma pPerfect_le_of_cubic_image_intersection
    (f : G →* D) (hk : IsPGroup 2 f.ker) (Y L : Subgroup G) [L.Normal] [(L.map f).Normal]
    (hY : IsPPerfect 2 Y) (hcard : Nat.card (Y ⧸ pCore 2 Y) = 3)
    (hthree : ∃ x ∈ Y.map f ⊓ L.map f, orderOf x = 3) : Y ≤ L := by
  let A := ((L.map f).comap f).subgroupOf Y
  let q := QuotientGroup.mk' (pCore 2 Y)
  have hA : A.Normal := inferInstance
  obtain ⟨x, ⟨⟨y, hy, hyx⟩, hxL⟩, hx3⟩ := hthree
  let a : A := ⟨⟨y, hy⟩, show f y ∈ L.map f from hyx ▸ hxL⟩
  let r : A →* D := f.comp (Y.subtype.comp A.subtype)
  have har : orderOf (r a) = 3 := by change orderOf (f y) = 3; rwa [hyx]
  have hd : 3 ∣ Nat.card A := har ▸
    (orderOf_map_dvd r a).trans (orderOf_dvd_natCard a)
  obtain ⟨b, hb⟩ := exists_prime_orderOf_dvd_card' (G := A) 3 hd
  have hbY : orderOf (b : Y) = 3 := (Subgroup.orderOf_coe b).trans hb
  have hbq : orderOf (q b) = 3 :=
    (q.orderOf_map_eq_of_coprime_of_isPGroup_ker
      (by dsimp [q]; rw [QuotientGroup.ker_mk']; exact pCore_isPGroup) b
      (hbY ▸ (by decide : Nat.Coprime 2 3))).trans hbY
  have hmap : A.map q = ⊤ := by
    let : Fact (Nat.card (Y ⧸ pCore 2 Y)).Prime := ⟨hcard ▸ Nat.prime_three⟩
    rcases (A.map q).eq_bot_or_eq_top_of_prime_card with hbot | htop
    · have he : q b = 1 := by
        have hm := mem_map_of_mem q b.property
        rwa [hbot, mem_bot] at hm
      rw [he, orderOf_one] at hbq
      contradiction
    · exact htop
  have hs : A ⊔ pCore 2 Y = ⊤ := by
    have he := congrArg (Subgroup.comap q) hmap
    simpa only [comap_map_eq, q, QuotientGroup.ker_mk', comap_top] using he
  have hAtop : A = ⊤ := hY A hA (isPGroup_quotient_of_sup_eq_top A (pCore 2 Y) pCore_isPGroup hs)
  apply pPerfect_le_of_image_le f hk Y L hY
  rintro z ⟨y, hy, rfl⟩
  exact (show (⟨y, hy⟩ : Y) ∈ A from hAtop ▸ mem_top _)

lemma le_of_inner_image_action
    (f : G →* D) (hf : Function.Surjective f) (hk : IsPGroup 2 f.ker)
    (M Y T L : Subgroup G) [L.Normal] [(L.map f).Normal]
    [Group.IsSolvable (Y ⊔ T : Subgroup G)]
    (hθ : theta M = Y)
    (hj : ∀ K : Subgroup G, Group.IsSolvable K → Y ⊔ T ≤ K → K ≤ M)
    (hY : IsPPerfect 2 Y) (hcard : Nat.card (Y ⧸ pCore 2 Y) = 3)
    (hn : T ≤ normalizer (Y : Set G))
    (hcomm : L = ⁅L, Y⁆) (hne : L.map f ≠ ⊥) (hcenter : center (L.map f) = ⊥)
    (hinner : ∀ y : Y.map f, ∃ l : L.map f,
      MulAut.conj l = (MulAut.conjNormal y : MulAut (L.map f))) : Y ≤ L := by
  obtain ⟨π, hπ⟩ := exists_inner_projection (L.map f) (Y.map f) hcenter hinner
  have he : L.map f = ⁅L.map f, Y.map f⁆ := by rw [← map_commutator, ← hcomm]
  have hπne := inner_projection_ne_one _ _ he hne π hπ
  let r := (L.map f).subtype.comp (π.comp (f.subgroupMap Y))
  have hrange : r.range = π.range.map (L.map f).subtype := by
    rw [MonoidHom.range_comp, MonoidHom.range_comp,
      MonoidHom.range_eq_top_of_surjective _ (f.subgroupMap_surjective Y), ← MonoidHom.range_eq_map]
  let P := r.range
  have hPne : P ≠ ⊥ := by
    intro hb
    have hh : π.range = ⊥ := (π.range.map_eq_bot_iff_of_injective (L.map f).subtype_injective).mp
      (hrange ▸ hb)
    apply hπne
    apply MonoidHom.ext
    intro y
    exact (show π y ∈ (⊥ : Subgroup (L.map f)) from hh ▸ ⟨y, rfl⟩)
  have hYθ : theta Y = Y := by rw [← hθ, theta_idempotent]
  have hPθ : theta P = P := theta_range_eq_self Y hYθ r
  let : Group.IsSolvable Y := Group.isSolvable_of_isSolvable_injective
    (inclusion_injective (show Y ≤ Y ⊔ T from le_sup_left))
  let : Group.IsSolvable P := Group.isSolvable_of_surjective r.rangeRestrict_surjective
  have hPY : P ≤ Y.map f := by
    rw [← hPθ]
    apply invariant_solvable_theta_le_image f hf hk M Y T hθ hj P
    rw [show P = π.range.map (L.map f).subtype from hrange]
    exact inner_projection_range_normalized (L.map f) (Y.map f) ((Y ⊔ T).map f)
      hcenter ((map_mono (sup_le Y.le_normalizer hn)).trans (Y.le_normalizer_map f)) π hπ
  obtain ⟨p, hp, hp3⟩ := exists_cubic_of_theta P hPθ hPne
  apply pPerfect_le_of_cubic_image_intersection f hk Y L hY hcard
  exact ⟨p, ⟨hPY hp, (hrange ▸ map_subtype_le π.range) hp⟩, hp3⟩


lemma Y0_le_closure_of_inner_star_action
    (H M Y0 L T : Subgroup G) [Group.IsSolvable (M ⊓ H : Subgroup G)]
    (hgen : H = reducedOvergroup L Y0 T) (hTM : T ≤ M)
    (hθ : theta (M ⊓ H) = Y0)
    (hj : ∀ K : Subgroup G, Group.IsSolvable K → Y0 ⊔ T ≤ K → K ≤ H → K ≤ M ⊓ H)
    (hY : IsPPerfect 2 Y0) (hcard : Nat.card ((Y0.subgroupOf H) ⧸ pCore 2 (Y0.subgroupOf H)) = 3)
    (hTY : T ≤ normalizer (Y0 : Set G)) (hcomm : L = ⁅L, Y0⁆)
    (hne : starImage H (localSpan L T) ≠ ⊥)
    (hcenter : center (starImage H (localSpan L T)) = ⊥)
    (hinner : ∀ y : starImage H Y0, ∃ l : starImage H (localSpan L T),
      ∀ x : starImage H (localSpan L T),
        (l : H ⧸ pCore 2 H) * x * l⁻¹ = y * x * y⁻¹) : Y0 ≤ localSpan L T := by
  let L0 := localSpan L T
  have hL0H : L0 ≤ H := hgen ▸ le_sup_left
  have hYH : Y0 ≤ H := hgen ▸ (le_sup_left.trans le_sup_right)
  have hTH : T ≤ H := hgen ▸ (le_sup_right.trans le_sup_right)
  let Y' := Y0.subgroupOf H
  let T' := T.subgroupOf H
  let L' := L0.subgroupOf H
  let q := QuotientGroup.mk' (pCore 2 H)
  have hnorm : L'.Normal := by
    have hh := componentClosure_normal_in_replacement L Y0 T
      (le_normalizer_iff_commutator_le_left.mpr hcomm.ge) hTY
    rwa [← hgen] at hh
  let := hnorm
  let : (L'.map q).Normal := hnorm.map q (QuotientGroup.mk'_surjective _)
  have hYT : Y0 ⊔ T ≤ M ⊓ H := sup_le (hθ ▸ theta_le (M ⊓ H))
    (le_inf hTM hTH)
  have hjoin : Y' ⊔ T' = (Y0 ⊔ T).subgroupOf H := by
    apply map_injective H.subtype_injective
    rw [Subgroup.map_sup, map_subgroupOf_eq_of_le hYH, map_subgroupOf_eq_of_le hTH,
      map_subgroupOf_eq_of_le (sup_le hYH hTH)]
  let : Group.IsSolvable (Y0 ⊔ T : Subgroup G) :=
    Group.isSolvable_of_isSolvable_injective (inclusion_injective hYT)
  let : Group.IsSolvable (Y' ⊔ T' : Subgroup H) := by
    rw [hjoin]
    exact Group.isSolvable_of_isSolvable_injective
      (f := (subgroupOfEquivOfLe (sup_le hYH hTH)).toMonoidHom)
      (subgroupOfEquivOfLe (sup_le hYH hTH)).injective
  have hθ' : theta ((M ⊓ H).subgroupOf H) = Y' := by
    apply map_injective H.subtype_injective
    rw [theta_map_of_injective _ H.subtype_injective,
      map_subgroupOf_eq_of_le inf_le_right, hθ, map_subgroupOf_eq_of_le hYH]
  have hTY' : T' ≤ normalizer (Y' : Set H) := by
    apply le_normalizer_iff.mpr
    intro t ht y hy
    exact le_normalizer_iff.mp hTY t ht y hy
  have hcomm' : L' = ⁅L', Y'⁆ := by
    apply map_injective H.subtype_injective
    rw [map_commutator, map_subgroupOf_eq_of_le hL0H, map_subgroupOf_eq_of_le hYH]
    exact componentClosure_commutator L Y0 T hcomm hTY
  have hle : Y' ≤ L' := by
    apply le_of_inner_image_action q (QuotientGroup.mk'_surjective _)
      (by dsimp [q]; rw [QuotientGroup.ker_mk']; exact pCore_isPGroup)
      ((M ⊓ H).subgroupOf H) Y' T' L' hθ' ?_
      (hY.of_surjective (subgroupOfEquivOfLe hYH).symm.toMonoidHom
        (subgroupOfEquivOfLe hYH).symm.surjective)
      hcard hTY' hcomm' hne hcenter ?_
    · intro K hK hYK
      let := hK
      let : Group.IsSolvable (K.map H.subtype) :=
        Group.isSolvable_of_surjective (H.subtype.subgroupMap_surjective K)
      have hle : Y0 ⊔ T ≤ K.map H.subtype := by
        have hm := map_mono (f := H.subtype) hYK
        rwa [hjoin, map_subgroupOf_eq_of_le (sup_le hYH hTH)] at hm
      exact (map_le_iff_le_comap).mp (hj _ inferInstance hle (map_subtype_le K))
    · intro y
      obtain ⟨l, hl⟩ := hinner y
      exact ⟨l, MulEquiv.ext (fun x => Subtype.ext (hl x))⟩
  have hm := map_mono (f := H.subtype) hle
  rwa [map_subgroupOf_eq_of_le hYH, map_subgroupOf_eq_of_le hL0H] at hm

end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction
