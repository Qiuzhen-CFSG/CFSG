module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.BorelInner.SourceSetup
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.BorelInner.ModelCases
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.BorelInner.AutomorphismCollapse.TorusControl
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.BorelInner.ModelSelection.Transport
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.BorelInner.AutomorphismCollapse.RankTwoField.Kernel

/-!
# Source contradiction from the component torus kernel

The two fields of `ComponentBorel` retain the actual Sylow intersection and
embed its whole intrinsic normalizer in the star image of the relative Borel.
Given these identifications, quotient invariance and the commutator bound from
`TorusControl` make every Y₀* actor trivial on the component torus quotient.
Torus rigidity makes it inner, and Sylow invariance puts an inner representative
in the component normalizer. That normalizer has order prime to three, whereas
Y₀* is generated by elements of order three. Its action is therefore trivial,
contrary to the actual nontrivial component's equality L* = [L*,Y₀*].

The local rigidity and component embeddings remain explicit inputs here.
Neither a classification theorem nor 15.3.49(k) is asserted by their definitions.
The component product construction and concrete model calculations discharge
them separately; no assumption of centerlessness or L₀ = L is used.

Source: Aschbacher–Smith, `refs/quasithin.pdf`, printed p.1144,
proof of 15.3.49(k).
-/

@[expose] public section

open Subgroup
open scoped commutatorElement
open CFSG.Quasithin.Chapter15.Section03
open CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination
open CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction
open CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction

namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.BorelInner.AutomorphismCollapse.RankTwoField

universe u
variable {G : Type u} [Group G]

/-- The component Sylow and its full normalizer, with their actual ambient embeddings. -/
structure ComponentBorel (H L : Subgroup G) (T : Sylow 2 G) where
  sylow : Sylow 2 (starImage H L)
  sylow_eq : (sylow : Subgroup (starImage H L)).map (starImage H L).subtype =
    starImage H (sylowIntersection L T) ⊓ starImage H L
  normalizer_le : (normalizer (sylow : Set (starImage H L))).map
    (starImage H L).subtype ≤ starImage H (relativeBorel L T)

private theorem theta_hom_trivial {D E : Type*} [Group D] [Group E] [Finite E]
    (Y : Subgroup D) (hY : theta Y = Y) (hE : ¬ 3 ∣ Nat.card E)
    (f : Y →* E) : f = 1 := by
  have hy : Y ≤ f.ker.map Y.subtype := by
    conv_lhs => rw [← hY]
    apply (closure_le _).mpr
    intro y hy
    refine ⟨⟨y, hY ▸ subset_closure hy⟩, ?_, rfl⟩
    apply orderOf_eq_one_iff.mp
    have hd : orderOf (f ⟨y, hY ▸ subset_closure hy⟩) ∣ 3 :=
      (orderOf_map_dvd f _).trans (by simpa only [Subgroup.orderOf_mk] using hy.2.dvd)
    exact ((Nat.dvd_prime Nat.prime_three).mp hd).resolve_right
      (fun he => hE (he ▸ orderOf_dvd_natCard _))
  ext y
  obtain ⟨z, hz, he⟩ := hy y.property
  exact MonoidHom.mem_ker.mp ((show z = y from Subtype.ext he) ▸ hz)

variable [Finite G]
variable {κ : GroupClass.{u}} {H M Y V Y0 L ZS Z A : Subgroup G}
    {T : Sylow 2 G} [IsElementaryAbelian 2 (localSpan ZS H)]
    (d : SourceSetup κ H M Y V Y0 L ZS Z A T)

include d

/-- Torus rigidity and the genuine component Borel contradict source noncontainment. -/
theorem exclusion_of_componentBorel [Group.IsSolvable (relativeBorel L T)]
    (hout : ¬ Y0 ≤ localSpan L T) (c : ComponentBorel H L T)
    (hrigid : TorusRigid (starImage H L)) : False := by
  let K := starImage H L
  let W := starImage H Y0
  let P := c.sylow
  let N : Subgroup K := normalizer (P : Set K)
  have hcomm : K = ⁅K, W⁆ := by
    rw [← starImage_commutator H L Y0 (ModelSelection.component_le d)
      ((d.theta_eq ▸ theta_le _).trans inf_le_right), ← d.commutator_eq]
  have hn : W ≤ normalizer (K : Set (H ⧸ pCore 2 H)) :=
    le_normalizer_iff_commutator_le_left.mpr hcomm.ge
  let α : W →* MulAut K := K.normalizerMonoidHom.comp (inclusion hn)
  have hnP : W ≤ normalizer ((P : Subgroup K).map K.subtype : Set (H ⧸ pCore 2 H)) := by
    rw [c.sylow_eq]
    exact (le_inf (star_sylow_normalized d hout) hn).trans inf_normalizer_le_normalizer_inf
  have hαP (y : W) : (P : Subgroup K).map (α y).toMonoidHom = P := by
    apply map_injective K.subtype_injective
    rw [Subgroup.map_map]
    have he : K.subtype.comp (α y).toMonoidHom =
        (MulAut.conj y.val).toMonoidHom.comp K.subtype := by
      ext x
      rfl
    rw [he, ← Subgroup.map_map]
    exact mem_normalizer_iff_map_conj_eq.mp (hnP y.property)
  have hdisp (y : W) (b : K) (hb : b ∈ N) : b⁻¹ * α y b ∈ P := by
    apply (mem_map_iff_mem (f := K.subtype) K.subtype_injective).mp
    rw [c.sylow_eq]
    refine ⟨?_, (b⁻¹ * α y b).property⟩
    have hB := c.normalizer_le (mem_map_of_mem K.subtype hb)
    apply star_borel_commutator_le d hout
    have hc := commutator_mem_commutator
      ((starImage H (relativeBorel L T)).inv_mem hB) y.property
    change ⁅b.val⁻¹, y.val⁆ ∈ ⁅starImage H (relativeBorel L T), starImage H Y0⁆ at hc
    change b.val⁻¹ * (y.val * b.val * y.val⁻¹) ∈ _
    simpa only [commutatorElement_def, inv_inv, mul_assoc] using hc
  have hNthree : ¬ 3 ∣ Nat.card N := by
    have hB := (d.borel_control (relativeBorel L T) hout rfl).2.2.2.1
    have hd : Nat.card (starImage H (relativeBorel L T)) ∣ Nat.card (relativeBorel L T) :=
      ((relativeBorel L T).subgroupOf H).card_map_dvd _ |>.trans
        (card_comap_dvd_of_injective (relativeBorel L T) H.subtype H.subtype_injective)
    intro h
    have hm : 3 ∣ Nat.card (N.map K.subtype) := by
      rwa [← Nat.card_congr (N.equivMapOfInjective K.subtype K.subtype_injective).toEquiv]
    exact hB ((hm.trans (card_dvd_of_le c.normalizer_le)).trans hd)
  let I : Subgroup (MulAut K) := N.map (MulAut.conj : K →* MulAut K)
  have hIthree : ¬ 3 ∣ Nat.card I := fun h => hNthree (h.trans (N.card_map_dvd _))
  have hαI (y : W) : α y ∈ I := by
    obtain ⟨g, hg⟩ := hrigid P (α y) (hαP y) (hdisp y)
    refine ⟨g, ?_, hg⟩
    apply mem_normalizer_iff_map_conj_eq.mpr
    rw [hg]
    exact hαP y
  let f : W →* I := α.codRestrict I hαI
  have hf : f = 1 := theta_hom_trivial W (star_theta_eq_self H M Y0 d.theta_eq) hIthree f
  have hαone (y : W) : α y = 1 := congrArg Subtype.val (DFunLike.congr_fun hf y)
  have hz : ⁅K, W⁆ = ⊥ := by
    apply commutator_eq_bot_iff_le_centralizer.mpr
    intro x hx y hy
    have he := congrArg (fun a : MulAut K => (a ⟨x, hx⟩).val) (hαone ⟨y, hy⟩)
    change y * x * y⁻¹ = x at he
    exact mul_inv_eq_iff_eq_mul.mp he
  exact component_star_nontrivial H L L d.component_in_H le_rfl (hcomm.trans hz)

end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.BorelInner.AutomorphismCollapse.RankTwoField
