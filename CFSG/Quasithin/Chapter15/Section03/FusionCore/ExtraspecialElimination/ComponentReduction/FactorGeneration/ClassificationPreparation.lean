module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.FactorGeneration.Preparation
public import CFSG.Quasithin.Defs

/-!
# The actual SQTK cover for B.5.3

The projection of the conjugate span inside H onto its star image is
surjective with two-group kernel. Its first-isomorphism equivalence supplies
a literal quotient of an SQTK subgroup. Restricting the given SectionAction
to the star image is faithful, has trivial two-core, and is generated by best
offenders; a transported best offender supplies the nontrivial FF witness.
These are the hypotheses of B.5.3, not its classification conclusion.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), Hypothesis
B.5.3, printed p.104, and proof of 15.3.49(i), printed p.1143.
-/

@[expose] public section

open Subgroup Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.FactorGeneration
universe u
variable {G : Type u} [Group G]

def spanStarProjection (H A : Subgroup G) :
    (localSpan A H).subgroupOf H →* starImage H (localSpan A H) :=
  (QuotientGroup.mk' (pCore 2 H)).subgroupMap ((localSpan A H).subgroupOf H)

theorem spanStarProjection_surjective (H A : Subgroup G) :
    Function.Surjective (spanStarProjection H A) :=
  (QuotientGroup.mk' (pCore 2 H)).subgroupMap_surjective _

noncomputable def spanStarQuotientEquiv (H A : Subgroup G) :
    ((localSpan A H).subgroupOf H ⧸ (spanStarProjection H A).ker) ≃*
      starImage H (localSpan A H) :=
  QuotientGroup.quotientKerEquivOfSurjective _ (spanStarProjection_surjective H A)

theorem spanStarCover_sqtk [Finite G] {K : GroupClass.{u}}
    (H A : Subgroup G) (hH : IsSQTK K H) :
    IsSQTK K ((localSpan A H).subgroupOf H) := hH.subgroup _

theorem spanStarProjection_kernel_twoGroup (H A : Subgroup G) :
    IsPGroup 2 (spanStarProjection H A).ker := by
  change IsPGroup 2 ((QuotientGroup.mk' (pCore 2 H)).subgroupMap _).ker
  rw [Subgroup.ker_subgroupMap, QuotientGroup.ker_mk']
  exact pCore_isPGroup.comap_of_injective _ ((localSpan A H).subgroupOf H).subtype_injective

theorem star_span_isFFModule [Finite G]
    (H ZS Z A : Subgroup G) [IsElementaryAbelian 2 (localSpan ZS H)]
    (action : SectionAction H (localSpan ZS H) Z)
    (hbest : IsBestOffender action.representation (starImage H A)) :
    IsFFModule (action.representation.comp (starImage H (localSpan A H)).subtype) := by
  have hAJ : starImage H A ≤ starImage H (localSpan A H) :=
    map_mono (comap_mono (le_conjugateSpanBy A H))
  exact ⟨(starImage H A).subgroupOf (starImage H (localSpan A H)),
    (hbest.subgroupOf action.representation hAJ).isOffender _⟩

/-- All B.5.3 conditions, with an explicit SQTK cover and a nontrivial FF witness.
The quotient presentation is `spanStarQuotientEquiv`. -/
theorem star_span_classification_hypotheses [Finite G] {K : GroupClass.{u}}
    (H ZS Z A : Subgroup G) [IsElementaryAbelian 2 (localSpan ZS H)]
    (action : SectionAction H (localSpan ZS H) Z)
    (hH : IsSQTK K H) (hAH : A ≤ H)
    (hbest : IsBestOffender action.representation (starImage H A)) :
    let ρ := action.representation.comp (starImage H (localSpan A H)).subtype
    Module.Finite (ZMod 2) (Additive (localSpan ZS H ⧸ Z.subgroupOf (localSpan ZS H))) ∧
      Function.Injective ρ ∧ pCore 2 (starImage H (localSpan A H)) = ⊥ ∧
      offenderSubgroup ρ = ⊤ ∧ IsSQTK K ((localSpan A H).subgroupOf H) ∧
      IsFFModule ρ := by
  exact ⟨Module.Finite.of_finite,
    star_span_action_faithful H ZS Z A action,
    star_span_twoCore_eq_bot H A hAH,
    star_span_offenderSubgroup_eq_top H ZS Z A action hAH hbest,
    spanStarCover_sqtk H A hH,
    star_span_isFFModule H ZS Z A action hbest⟩

end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.FactorGeneration
