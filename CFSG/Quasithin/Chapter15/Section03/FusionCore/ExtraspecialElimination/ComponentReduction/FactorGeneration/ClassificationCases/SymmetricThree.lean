module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.FactorGeneration.ClassificationCases.SaturatedLift

/-!
# The symmetric-three alternative in the local factor analysis

In S₃ every nonidentity involution inverts every element of odd order.
Consequently, for any embedded S₃ and any nontrivial elementary-two
subgroup of it, the cubic core is generated by its commutators with that
subgroup. We verify the six-element permutation identity in the kernel
and transport it through the supplied multiplicative equivalence.

For the actual star image of J = ⟨A^H⟩, alternative B.5.6(2) supplies this
S₃ equivalence and the rank-two moved space. The selected best offender
then gives the cubic identity. Normality of J* gives a single conjugate,
and the saturated lift constructs every field of SolvableStarFactor.
The lift in this case is J itself. The other B.5.6 alternatives and the
component conclusion are separate obligations.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), B.5.6(2),
printed p.105, and proof of 15.3.49(i), printed pp.1143–1144.
-/

@[expose] public section

open Subgroup Representation.BinaryOffender
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.FactorGeneration.ClassificationCases
variable {G : Type*} [Group G]

private theorem symmetricThree_cubic_identity :
    ∀ a r : Equiv.Perm (Fin 3), a ^ 2 = 1 → a ≠ 1 →
      r ^ 3 = 1 → ⁅r⁻¹, a⁆ = r := by decide +kernel

/-- Any nontrivial elementary-two subgroup of an embedded S₃ generates its
cubic core by commutators. No offender inequality is needed for this step. -/
theorem threeCore_commutator_of_symmetricThree
    (B A : Subgroup G) (e : B ≃* Equiv.Perm (Fin 3))
    (hAB : A ≤ B) (hA : IsElementaryTwo A) :
    (pCore 3 B).map B.subtype = ⁅(pCore 3 B).map B.subtype, A⁆ := by
  let R := (pCore 3 B).map B.subtype
  have hnorm : B ≤ normalizer (R : Set G) :=
    B.le_normalizer.trans (normalizer_le_normalizer_characteristic_image B (pCore 3 B))
  apply le_antisymm _ (le_normalizer_iff_commutator_le_left.mp (hAB.trans hnorm))
  have ha : ∃ a ∈ A, a ≠ 1 := by
    by_contra! h
    exact hA.1 (A.eq_bot_iff_forall.mpr h)
  obtain ⟨a, ha, hane⟩ := ha
  let aB : B := ⟨a, hAB ha⟩
  let : IsElementaryAbelian 2 A := hA.2
  have ha2 : e aB ^ 2 = 1 := by
    rw [← map_pow]
    have he : aB ^ 2 = 1 := Subtype.ext (elemPow_eq_one_of_isElementaryAbelian a ha)
    rw [he, map_one]
  have hae : e aB ≠ 1 := fun hh => hane (congrArg Subtype.val (e.map_eq_one_iff.mp hh))
  rintro x ⟨r, hr, rfl⟩
  have hc : Nat.Coprime (orderOf (e r)) 2 := by
    rw [e.orderOf_eq]
    simpa only [Subgroup.orderOf_mk] using
      (pCore_isPGroup (p := 3) (G := B)).orderOf_coprime
        (by decide : Nat.Coprime 3 2) (⟨r, hr⟩ : pCore 3 B)
  have hr6 : orderOf (e r) ∣ 6 := by
    simpa only [Nat.card_eq_fintype_card, Fintype.card_perm, Fintype.card_fin,
      show Nat.factorial 3 = 6 from by decide] using orderOf_dvd_natCard (e r)
  have hr3 : e r ^ 3 = 1 :=
    orderOf_dvd_iff_pow_eq_one.mp (hc.dvd_mul_left.mp hr6)
  have he : ⁅r⁻¹, aB⁆ = r := by
    apply e.injective
    simpa only [map_commutatorElement, map_inv] using
      symmetricThree_cubic_identity (e aB) (e r) ha2 hae hr3
  have heG : ⁅(r : G)⁻¹, a⁆ = (r : G) := congrArg Subtype.val he
  change (r : G) ∈ ⁅R, A⁆
  rw [← heG]
  exact commutator_mem_commutator (inv_mem (mem_map_of_mem B.subtype hr)) ha


/-- The complete candidate for B.5.6(2), from its actual model and moved rank. -/
noncomputable def solvableStarFactorOfSymmetricThree
    (H ZS Z A : Subgroup G) [IsElementaryAbelian 2 (localSpan ZS H)]
    (action : SectionAction H (localSpan ZS H) Z) (hAH : A ≤ H)
    (hbest : IsBestOffender action.representation (starImage H A))
    (model : starImage H (localSpan A H) ≃* Equiv.Perm (Fin 3))
    (hrank : Module.finrank (ZMod 2)
      (Representation.Coinvariants.ker
        (action.representation.comp (starImage H (localSpan A H)).subtype)) = 2) :
    SolvableStarFactor H ZS Z A action := by
  have hJ : (starImage H (localSpan A H)).Normal :=
    (localSpan_normal A H hAH).map _ (QuotientGroup.mk'_surjective _)
  refine solvableStarFactorOfImage H ZS Z A action hAH
    (starImage H (localSpan A H)) le_rfl ?_ model ?_ hrank ?_
  · rw [subgroupOf_self]
    exact IsSubnormal.top
  · exact threeCore_commutator_of_symmetricThree _ _ model
      (map_mono (comap_mono (le_conjugateSpanBy A H))) hbest.1
  · let := hJ
    rw [ncard_conjugates_eq_index_normalizer, normalizer_eq_top, index_top]
    decide

/-- In the pure S₃ case the canonical candidate is the entire conjugate span. -/
theorem solvableStarFactorOfSymmetricThree_carrier
    (H ZS Z A : Subgroup G) [IsElementaryAbelian 2 (localSpan ZS H)]
    (action : SectionAction H (localSpan ZS H) Z) (hAH : A ≤ H)
    (hbest : IsBestOffender action.representation (starImage H A))
    (model : starImage H (localSpan A H) ≃* Equiv.Perm (Fin 3))
    (hrank : Module.finrank (ZMod 2)
      (Representation.Coinvariants.ker
        (action.representation.comp (starImage H (localSpan A H)).subtype)) = 2) :
    (solvableStarFactorOfSymmetricThree H ZS Z A action hAH hbest model hrank).carrier =
      localSpan A H :=
  saturatedStarLift_unique H (localSpan A H) (localSpan A H)
    (conjugateSpanBy_le_self hAH) le_rfl inf_le_left

end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.FactorGeneration.ClassificationCases
