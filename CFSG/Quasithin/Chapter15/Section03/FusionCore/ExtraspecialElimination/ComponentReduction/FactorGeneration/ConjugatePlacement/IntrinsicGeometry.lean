module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.FactorGeneration.ConjugatePlacement.GeometryTransport

/-!
# The source cosets inside the generated group

F.7.2 uses G₀ = ⟨YT,H⟩, with vertices its cosets modulo YT and H.
We retain those actual quotient types. Inclusion of G₀ in G gives an
injective map to the ambient cosets, preserving incidence and intertwining
the actions. Every ambient stabilizer of an image vertex already lies in
G₀. Thus vertex and edge stabilizers, and the embedded intrinsic two-cores
of edge stabilizers, agree exactly under inclusion.

This allows the ambient subgroup and section-action calculations to consume
F.9.13 at an actual source vertex. No arbitrary vertex action or group-family
label replaces the source geometry.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), F.7.2–3,
printed p.311, and F.9.10–13, printed pp.321–322.
-/

@[expose] public section

open Subgroup

namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.FactorGeneration.ConjugatePlacement
variable {G : Type*} [Group G]

/-- The group G₀ generated by the two source vertex stabilizers. -/
abbrev geometryGroup (Y T H : Subgroup G) : Subgroup G := (Y ⊔ T) ⊔ H

/-- The two vertex subgroups viewed inside G₀. -/
def sourceFamily (Y T H : Subgroup G) : Bool → Subgroup (geometryGroup Y T H) :=
  fun i => (family Y T H i).subgroupOf (geometryGroup Y T H)

/-- The literal typed cosets of F.7.2 inside G₀. -/
abbrev SourceVertex (Y T H : Subgroup G) := CosetGeometry.Vertex (sourceFamily Y T H)

/-- The standard source vertex of either type. -/
abbrev sourceBase (Y T H : Subgroup G) (i : Bool) : SourceVertex Y T H :=
  CosetGeometry.base (sourceFamily Y T H) i

/-- Inclusion of G₀ induces the indicated map on cosets. -/
def sourceCosetMap (Y T H : Subgroup G) (i : Bool) :
    geometryGroup Y T H ⧸ sourceFamily Y T H i → G ⧸ family Y T H i :=
  Quotient.lift (fun a : geometryGroup Y T H => ((a : G) : G ⧸ family Y T H i)) (by
    intro a b hab
    apply QuotientGroup.eq.mpr
    have hab' : a⁻¹ * b ∈ sourceFamily Y T H i := QuotientGroup.leftRel_apply.mp hab
    exact hab')

/-- Include the source vertices into ambient typed cosets. -/
def sourceEmbedding (Y T H : Subgroup G) (v : SourceVertex Y T H) : Vertex Y T H :=
  ⟨v.type, sourceCosetMap Y T H v.type v.coset⟩

/-- No two source cosets are identified by the ambient embedding. -/
theorem sourceEmbedding_injective (Y T H : Subgroup G) :
    Function.Injective (sourceEmbedding Y T H) := by
  rintro ⟨i, a⟩ ⟨j, b⟩ he
  have hi : i = j := congrArg CosetGeometry.Vertex.type he
  subst j
  obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective a
  obtain ⟨b, rfl⟩ := QuotientGroup.mk_surjective b
  have hq : ((a : G) : G ⧸ family Y T H i) = ((b : G) : G ⧸ family Y T H i) := by
    injection he with htype hcoset
  have hmem : (a : G)⁻¹ * (b : G) ∈ family Y T H i := QuotientGroup.eq.mp hq
  have hs : (a : geometryGroup Y T H ⧸ sourceFamily Y T H i) = b :=
    QuotientGroup.eq.mpr hmem
  exact congrArg (CosetGeometry.Vertex.mk i) hs

/-- Standard vertices agree under inclusion. -/
theorem sourceEmbedding_base (Y T H : Subgroup G) (i : Bool) :
    sourceEmbedding Y T H (sourceBase Y T H i) = base Y T H i := rfl

/-- The embedding intertwines the source and ambient actions. -/
theorem sourceEmbedding_smul (Y T H : Subgroup G) (g : geometryGroup Y T H)
    (v : SourceVertex Y T H) :
    sourceEmbedding Y T H (g • v) = (g : G) • sourceEmbedding Y T H v := by
  rcases v with ⟨i, q⟩
  obtain ⟨a, rfl⟩ := QuotientGroup.mk_surjective q
  change CosetGeometry.Vertex.mk i (sourceCosetMap Y T H i (g • (a : geometryGroup Y T H ⧸ sourceFamily Y T H i))) = _
  rw [MulAction.Quotient.smul_mk]
  change CosetGeometry.Vertex.mk i ((↑(g * a) : G) : G ⧸ family Y T H i) =
    CosetGeometry.Vertex.mk i ((g : G) • ((a : G) : G ⧸ family Y T H i))
  rw [MulAction.Quotient.smul_mk]
  rfl

/-- An incident source pair remains incident in the ambient geometry. -/
theorem sourceEmbedding_incident (Y T H : Subgroup G) (v w : SourceVertex Y T H)
    (hv : CosetGeometry.Incident (sourceFamily Y T H) v w) :
    CosetGeometry.Incident (family Y T H) (sourceEmbedding Y T H v) (sourceEmbedding Y T H w) := by
  obtain ⟨g, hg, hw⟩ := hv
  exact ⟨g, congrArg (sourceCosetMap Y T H v.type) hg,
    congrArg (sourceCosetMap Y T H w.type) hw⟩

private theorem family_le_geometryGroup (Y T H : Subgroup G) (i : Bool) :
    family Y T H i ≤ geometryGroup Y T H := by
  cases i
  · exact le_sup_left
  · exact le_sup_right

/-- The ambient stabilizer of a source vertex lies inside G₀. -/
theorem stabilizer_sourceEmbedding_le (Y T H : Subgroup G) (v : SourceVertex Y T H) :
    MulAction.stabilizer G (sourceEmbedding Y T H v) ≤ geometryGroup Y T H := by
  obtain ⟨g, hg⟩ := CosetGeometry.exists_smul_base (sourceFamily Y T H) v
  rw [← hg, sourceEmbedding_smul, sourceEmbedding_base,
    MulAction.stabilizer_smul_eq_stabilizer_map_conj, base, CosetGeometry.stabilizer_base]
  rintro x ⟨a, ha, rfl⟩
  exact (geometryGroup Y T H).mul_mem
    ((geometryGroup Y T H).mul_mem g.property (family_le_geometryGroup Y T H _ ha))
    ((geometryGroup Y T H).inv_mem g.property)

/-- The intrinsic source stabilizer maps onto the full ambient stabilizer. -/
theorem source_stabilizer_image (Y T H : Subgroup G) (v : SourceVertex Y T H) :
    (MulAction.stabilizer (geometryGroup Y T H) v).map (geometryGroup Y T H).subtype =
      MulAction.stabilizer G (sourceEmbedding Y T H v) := by
  apply le_antisymm
  · rintro x ⟨g, hg, rfl⟩
    apply MulAction.mem_stabilizer_iff.mpr
    change (g : G) • sourceEmbedding Y T H v = sourceEmbedding Y T H v
    rw [← sourceEmbedding_smul, MulAction.mem_stabilizer_iff.mp hg]
  · intro x hx
    let g : geometryGroup Y T H := ⟨x, stabilizer_sourceEmbedding_le Y T H v hx⟩
    refine ⟨g, ?_, rfl⟩
    apply MulAction.mem_stabilizer_iff.mpr
    apply sourceEmbedding_injective Y T H
    rw [sourceEmbedding_smul]
    exact MulAction.mem_stabilizer_iff.mp hx

/-- The pointwise source edge stabilizer inside G₀. -/
def sourceEdgeGroup (Y T H : Subgroup G) (v w : SourceVertex Y T H) :
    Subgroup (geometryGroup Y T H) :=
  MulAction.stabilizer (geometryGroup Y T H) v ⊓ MulAction.stabilizer (geometryGroup Y T H) w

/-- The source edge stabilizer maps onto the ambient edge stabilizer. -/
theorem source_edge_image (Y T H : Subgroup G) (v w : SourceVertex Y T H) :
    (sourceEdgeGroup Y T H v w).map (geometryGroup Y T H).subtype =
      edgeGroup Y T H (sourceEmbedding Y T H v) (sourceEmbedding Y T H w) := by
  rw [sourceEdgeGroup, Subgroup.map_inf _ _ _ (geometryGroup Y T H).subtype_injective,
    source_stabilizer_image, source_stabilizer_image]
  rfl

/-- The intrinsic edge two-core maps onto the full ambient edge two-core. -/
theorem source_edge_core_image (Y T H : Subgroup G) (v w : SourceVertex Y T H) :
    ((sourceEdgeGroup Y T H v w).pCoreIn 2).map (geometryGroup Y T H).subtype =
      (edgeGroup Y T H (sourceEmbedding Y T H v) (sourceEmbedding Y T H w)).pCoreIn 2 := by
  rw [map_pCoreIn_of_injective 2 _ _ (geometryGroup Y T H).subtype_injective, source_edge_image]

/-- The local actor H included in G₀. -/
def sourceActor (Y T H : Subgroup G) : H →* geometryGroup Y T H := inclusion le_sup_right

end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.FactorGeneration.ConjugatePlacement
