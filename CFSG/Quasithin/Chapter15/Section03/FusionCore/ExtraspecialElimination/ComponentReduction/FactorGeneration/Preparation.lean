module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.OffenderTransport
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.LocalTransfer
public import Theory.GroupTheory.CComponent.QuotientLifting
public import Theory.GroupTheory.PResidual.PerfectCover
public import Theory.GroupTheory.PResidual.NormalSubgroup
public import Theory.Representation.BinaryOffender.EquivariantOffender
public import Mathlib.GroupTheory.IndexNormal


/-!
# Preparing the factor-generation argument

Conjugating the selected quadratic best offender preserves its full weight
condition and its normal closure. On the actual star image of this closure,
the restricted section representation is faithful, the two-core vanishes,
and the best offenders generate the whole actor. These establish the
algebraic parts of B.5.3; the SQTK provenance and the full B.5.6 alternatives
still have to be supplied in the source application.

A two-perfect subgroup fixes a subgroup with at most two conjugates.
Moreover a nontrivial three-subgroup generated by its commutators with
an actor in O₂(B) cannot lie in B. These deductions supply normalization
and the first escape step of the solvable-factor argument, without assuming
component generation or a strong offender.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), B.5.3 and
B.5.6, printed pp.104–105, and proof of 15.3.49(i), printed pp.1143–1144.
-/

@[expose] public section

open Subgroup Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.FactorGeneration
variable {G : Type*} [Group G]

def selectedConjugate (H Vgamma : Subgroup G) (h : H) : Subgroup G :=
  Vgamma.map (MulAut.conj (h : G)).toMonoidHom

theorem selectedConjugate_le (H Vgamma : Subgroup G) (hVH : Vgamma ≤ H) (h : H) :
    selectedConjugate H Vgamma h ≤ H := by
  rintro x ⟨v, hv, rfl⟩
  exact H.mul_mem (H.mul_mem h.property (hVH hv)) (H.inv_mem h.property)

theorem selectedConjugate_span (H Vgamma : Subgroup G) (h : H) :
    localSpan (selectedConjugate H Vgamma h) H = localSpan Vgamma H := by
  apply le_antisymm
  · apply conjugateSpanBy_le _ (le_normalizer_conjugateSpanBy _ _)
    rintro x ⟨v, hv, rfl⟩
    exact subset_closure ⟨h, h.property, v, hv, rfl⟩
  · apply conjugateSpanBy_le _ (le_normalizer_conjugateSpanBy _ _)
    intro v hv
    apply Subgroup.subset_closure
    refine ⟨(h : G)⁻¹, H.inv_mem h.property, (h : G) * v * (h : G)⁻¹,
      mem_map_of_mem _ hv, ?_⟩
    group

theorem selectedConjugate_offender
    (H ZS Z Vgamma : Subgroup G) [IsElementaryAbelian 2 (localSpan ZS H)]
    (action : SectionAction H (localSpan ZS H) Z) (hVH : Vgamma ≤ H) (h : H)
    (hbest : IsBestOffender action.representation (starImage H Vgamma))
    (hquad : IsQuadratic action.representation (starImage H Vgamma)) :
    IsBestOffender action.representation (starImage H (selectedConjugate H Vgamma h)) ∧
      IsQuadratic action.representation (starImage H (selectedConjugate H Vgamma h)) :=
  quadratic_bestOffender_conjugate H (localSpan ZS H) Z Vgamma action hVH h hbest hquad

private theorem twoPerfect_le_of_index_le_two [Finite G] (Y N : Subgroup G)
    (hY : IsPPerfect 2 Y) (hindex : N.index ≤ 2) : Y ≤ N := by
  have hpos : 0 < N.index := Nat.card_pos
  have hcases : N.index = 1 ∨ N.index = 2 := by omega
  rcases hcases with he | he
  · rw [index_eq_one.mp he]
    exact le_top
  · let : N.Normal := N.normal_of_index_eq_two he
    have hp : IsPGroup 2 (G ⧸ N) := IsPGroup.of_card (n := 1) (by simpa only [Subgroup.index, pow_one] using he)
    exact (le_pResidual_of_isPPerfect Y hY).trans (sInf_le ⟨inferInstance, hp⟩)

theorem starImage_twoPerfect (H Y0 : Subgroup G) (hYH : Y0 ≤ H)
    (hY : IsPPerfect 2 Y0) : IsPPerfect 2 (starImage H Y0) := by
  have hi := hY.of_surjective (subgroupOfEquivOfLe hYH).symm.toMonoidHom
    (subgroupOfEquivOfLe hYH).symm.surjective
  exact hi.of_surjective ((QuotientGroup.mk' (pCore 2 H)).subgroupMap (Y0.subgroupOf H))
    ((QuotientGroup.mk' (pCore 2 H)).subgroupMap_surjective _)

theorem star_normalizes_of_two_conjugates [Finite G]
    (H Y0 L : Subgroup G) (hYH : Y0 ≤ H) (hY : IsPPerfect 2 Y0)
    (horbit : (Set.range fun h : H ⧸ pCore 2 H =>
      (starImage H L).map (MulAut.conj h).toMonoidHom).ncard ≤ 2) :
    starImage H Y0 ≤ normalizer (starImage H L : Set (H ⧸ pCore 2 H)) := by
  apply twoPerfect_le_of_index_le_two _ _ (starImage_twoPerfect H Y0 hYH hY)
  rwa [ncard_conjugates_eq_index_normalizer] at horbit

private theorem three_subgroup_escapes_core_overgroup
    (R A B : Subgroup G) (hR : IsPGroup 3 R) (hne : R ≠ ⊥)
    (hgen : R = ⁅R, A⁆) (hA : A ≤ (pCore 2 B).map B.subtype) : ¬ R ≤ B := by
  intro hRB
  let Q := (pCore 2 B).map B.subtype
  have hBQ : B ≤ normalizer (Q : Set G) :=
    B.le_normalizer.trans (normalizer_le_normalizer_characteristic_image B (pCore 2 B))
  have hRQ : R ≤ Q := by
    calc
      R = ⁅R, A⁆ := hgen
      _ ≤ ⁅B, Q⁆ := commutator_mono hRB hA
      _ ≤ Q := le_normalizer_iff_commutator_le_right.mp hBQ
  have hd : Disjoint R Q := hR.disjoint_of_coprime (pCore_isPGroup.map B.subtype) (by decide)
  exact hne (le_bot_iff.mp (by simpa only [inf_eq_left.mpr hRQ] using hd.le_bot))

theorem three_factor_escapes_star_overgroup
    (H Y0 T A : Subgroup G) (R : Subgroup (H ⧸ pCore 2 H))
    (hR : IsPGroup 3 R) (hne : R ≠ ⊥)
    (hgen : R = ⁅R, starImage H A⁆)
    (hA : starImage H A ≤
      (pCore 2 ↥(starImage H Y0 ⊔ starImage H T)).map
        (starImage H Y0 ⊔ starImage H T).subtype) :
    ¬ R ≤ starImage H Y0 ⊔ starImage H T :=
  three_subgroup_escapes_core_overgroup R _ _ hR hne hgen hA


theorem star_span_twoCore_eq_bot [Finite G] (H A : Subgroup G) (hAH : A ≤ H) :
    pCore 2 (starImage H (localSpan A H)) = ⊥ := by
  have hn : (starImage H (localSpan A H)).Normal :=
    (localSpan_normal A H hAH).map _ (QuotientGroup.mk'_surjective _)
  rw [pCore_subnormal_eq_comap 2 hn.isSubnormal, pCore_quotient_pCore_eq_bot]
  exact (starImage H (localSpan A H)).subtype.ker_eq_bot
    (starImage H (localSpan A H)).subtype_injective

theorem star_span_offenderSubgroup_eq_top
    (H ZS Z A : Subgroup G) [IsElementaryAbelian 2 (localSpan ZS H)]
    (action : SectionAction H (localSpan ZS H) Z) (hAH : A ≤ H)
    (hbest : IsBestOffender action.representation (starImage H A)) :
    offenderSubgroup (action.representation.comp (starImage H (localSpan A H)).subtype) = ⊤ := by
  let J := localSpan A H
  let Jstar := starImage H J
  let q := QuotientGroup.mk' (pCore 2 H)
  let D := offenderSubgroup (action.representation.comp Jstar.subtype)
  have hJH : J ≤ H := conjugateSpanBy_le_self hAH
  have hconj (h : H) : selectedConjugate H A h ≤ J := by
    rintro x ⟨a, ha, rfl⟩
    exact subset_closure ⟨h, h.property, a, ha, rfl⟩
  have hspan : J ≤ ((D.map Jstar.subtype).comap q).map H.subtype := by
    apply (Subgroup.closure_le _).mpr
    rintro _ ⟨h, hh, a, ha, rfl⟩
    let h' : H := ⟨h, hh⟩
    let B := starImage H (selectedConjugate H A h')
    have hBJ : B ≤ Jstar := map_mono (comap_mono (hconj h'))
    have hB : IsBestOffender action.representation B := by
      change IsBestOffender action.representation
        (starImage H (A.map (MulAut.conj (h' : G)).toMonoidHom))
      rw [starImage_map_conj H A hAH h']
      exact hbest.map_conj action.representation _
    have hBD : B.subgroupOf Jstar ≤ D :=
      le_iSup_of_le (B.subgroupOf Jstar)
        (le_iSup_of_le ⟨hB.subgroupOf action.representation hBJ, le_top⟩ le_rfl)
    let x : H := ⟨h * a * h⁻¹, H.mul_mem (H.mul_mem hh (hAH ha)) (H.inv_mem hh)⟩
    have hx : q x ∈ B := ⟨x, ⟨a, ha, rfl⟩, rfl⟩
    exact ⟨x, ⟨⟨q x, hBJ hx⟩, hBD hx, rfl⟩, rfl⟩
  apply top_unique
  intro x _
  obtain ⟨a, ha, he⟩ := x.property
  obtain ⟨b, hb, hba⟩ := hspan ha
  have hba' : b = a := Subtype.ext hba
  rw [hba'] at hb
  have hx : (x : H ⧸ pCore 2 H) ∈ D.map Jstar.subtype := he ▸ hb
  obtain ⟨d, hd, hdx⟩ := hx
  exact (Subtype.ext hdx : d = x) ▸ hd

theorem star_span_action_faithful
    (H ZS Z A : Subgroup G) [IsElementaryAbelian 2 (localSpan ZS H)]
    (action : SectionAction H (localSpan ZS H) Z) :
    Function.Injective
      (action.representation.comp (starImage H (localSpan A H)).subtype) :=
  action.faithful.comp (starImage H (localSpan A H)).subtype_injective

end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.FactorGeneration

