module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.LocalTransfer

/-!
# Selecting the replacement component

Once the conjugate span is generated by its C-components, a genuine best
offender makes that span nontrivial and therefore supplies a component.
Solvability of M intersect H forces that component outside M. Its T-conjugate
span, supplemented by Y_0 T, remains in the actual outside local family;
its relative normality, commutator generation and theta identity are retained.

This packages the subgroup selection after 15.3.49(i), without assuming a
chosen component or noncontainment in M. The proof of (i) and the transfer of
the faithful section actions to the smaller group remain separate obligations.
It does not replace H in a source theorem without that action transfer.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), proof of
15.3.49(j)–(k), printed p.1144.
-/

@[expose] public section

open Subgroup
open CFSG.Quasithin.Chapter15.Section03
open CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination
open scoped IsMulCommutative

namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction

variable {G : Type*} [Group G]

/-- A nontrivial span generated by C-components contains a component of H. -/
theorem exists_component_of_span_generated
    (H A : Subgroup G) (hAH : A ≤ H)
    (hne : localSpan A H ≠ ⊥)
    (hgen : (cComponentLayer (localSpan A H)).map (localSpan A H).subtype = localSpan A H) :
    ∃ L : Subgroup G, L ≤ localSpan A H ∧
      (L.subgroupOf (localSpan A H)).IsCComponent ∧ (L.subgroupOf H).IsCComponent := by
  classical
  let J := localSpan A H
  have hC : ∃ K : Subgroup J, K.IsCComponent := by
    by_contra! hnone
    have hb : cComponentLayer J = ⊥ := le_bot_iff.mp
      (sSup_le fun K hK => (hnone K hK).elim)
    apply hne
    rw [← hgen, hb, Subgroup.map_bot]
  obtain ⟨K, hK⟩ := hC
  let L := K.map J.subtype
  have hLJ : L ≤ J := map_subtype_le K
  have hc : (L.subgroupOf J).IsCComponent := by
    change ((K.map J.subtype).comap J.subtype).IsCComponent
    rwa [comap_map_eq_self_of_injective J.subtype_injective]
  exact ⟨L, hLJ, hc, localSpan_component_isCComponent A H L hAH hLJ hc⟩

open Representation.BinaryOffender

/-- Select an admissible replacement and prove its subgroup-theoretic properties. -/
theorem exists_replacement_of_generated_components [Finite G]
    (H M Y0 A ZS Z : Subgroup G) (T : Sylow 2 H)
    [IsElementaryAbelian 2 (localSpan ZS H)] [Group.IsSolvable ↥(M ⊓ H)]
    (action : SectionAction H (localSpan ZS H) Z)
    (hAH : A ≤ H) (hA : IsBestOffender action.representation (starImage H A))
    (hH : localTwoCore H ≠ ⊥) (hYH : Y0 ≤ H)
    (hθ : theta (M ⊓ H) = Y0)
    (hTY : (T : Subgroup H).map H.subtype ≤ normalizer (Y0 : Set G))
    (hgen : (cComponentLayer (localSpan A H)).map (localSpan A H).subtype = localSpan A H)
    (hcomm : ∀ L : Subgroup G, L ≤ localSpan A H →
      (L.subgroupOf (localSpan A H)).IsCComponent → L = ⁅L, Y0⁆) :
    ∃ L : Subgroup G, L ≤ localSpan A H ∧ (L.subgroupOf H).IsCComponent ∧
      L = ⁅L, Y0⁆ ∧
      let T' := (T : Subgroup H).map H.subtype
      let K := reducedOvergroup L Y0 T'
      K ≤ H ∧ K ∈ outsideFamily Y0 T' M ∧ theta (M ⊓ K) = Y0 ∧
        ((localSpan L T').subgroupOf K).Normal ∧ localSpan L T' = ⁅localSpan L T', Y0⁆ := by
  obtain ⟨L, hLJ, hcJ, hcH⟩ := exists_component_of_span_generated H A hAH
    (localSpan_ne_bot_of_bestOffender H (localSpan ZS H) Z A action hA) hgen
  have hLH : L ≤ H := hLJ.trans (conjugateSpanBy_le_self hAH)
  have hLY := hcomm L hLJ hcJ
  let T' := (T : Subgroup H).map H.subtype
  have hKH : reducedOvergroup L Y0 T' ≤ H :=
    reducedOvergroup_le hLH hYH (map_subtype_le _)
  refine ⟨L, hLJ, hcH, hLY, hKH,
    reducedOvergroup_mem_of_component L Y0 H M T hH hLH hcH hYH,
    theta_intermediate M H _ Y0 hKH (le_sup_left.trans le_sup_right) hθ,
    componentClosure_normal_in_replacement L Y0 T'
      (le_normalizer_iff_commutator_le_left.mpr hLY.ge) hTY,
    componentClosure_commutator L Y0 T' hLY hTY⟩

end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction
