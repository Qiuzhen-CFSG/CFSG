module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases.MarkedSeed.Generation
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases.MarkedSeed.ExceptionalGeneration.AlternatingSeven.Words

/-!
# Sylow-overgroup generation in the actual alternating group A₇

Conjugate the given Sylow two-subgroup to the standard even permutation
subgroup. The checked double-coset words express every element of every
overgroup using that Sylow subgroup and cubic elements of the same
overgroup. A nonidentity element whose cube is one has order three, so the
resulting generation is exactly the source's theta generation. Conjugating
back proves the property for the original Sylow subgroup, without a
properness, solvability, or designated-stabilizer hypothesis.

Source application: Aschbacher–Smith, combined manuscript (1 March 2004),
15.3.49(l) and the point stabilizers on printed pp.1144–1145.
-/

public section
open Subgroup
open CFSG.Quasithin.Chapter13.Section08.ComponentSieve.Seven
open LocalGeometry.PermutationOvergroups PlacementCertificate
namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases.MarkedSeed.ExceptionalGeneration

private theorem standard_generation (K : Subgroup (alternatingGroup (Fin 7)))
    (hPK : standardEvenTwo ≤ K) : K = theta K ⊔ standardEvenTwo := by
  let f := (alternatingGroup (Fin 7)).subtype
  have hu (i : Fin 8) : upper i ∈ standardEvenTwo.map f :=
    mem_map.mpr ⟨⟨upper i, (upper_mem i).2⟩, (upper_mem i).1, rfl⟩
  apply map_injective (f := f) (alternatingGroup (Fin 7)).subtype_injective
  rw [Subgroup.map_sup, theta_map_of_injective _ (alternatingGroup (Fin 7)).subtype_injective]
  apply le_antisymm ?_ (sup_le (theta_le _) (map_mono hPK))
  apply AlternatingSevenWords.overgroup_le_of_cube _ _ (map_subtype_le K)
    (fun i => map_mono hPK (hu i)) (fun i => mem_sup_right (hu i))
  intro g hg hc
  apply mem_sup_left
  rcases (Nat.dvd_prime Nat.prime_three).mp (orderOf_dvd_of_pow_eq_one hc) with h | h
  · rw [orderOf_eq_one_iff.mp h]
    exact one_mem _
  · exact subset_closure ⟨hg, h⟩

/-- Every overgroup of every Sylow two-subgroup of A₇ is generated by that
Sylow subgroup and its actual elements of order three. -/
theorem alternating_seven : SylowThetaGeneration (alternatingGroup (Fin 7)) := by
  intro P K hPK
  obtain ⟨g, hg⟩ := sylow_conjugate_standard (alternatingGroup (Fin 7)) le_rfl P
  change (P : Subgroup _).map (MulAut.conj g).toMonoidHom = standardEvenTwo at hg
  have hPK' : standardEvenTwo ≤ K.map (MulAut.conj g).toMonoidHom := by
    rw [← hg]
    exact map_mono hPK
  have he := standard_generation _ hPK'
  apply map_injective (f := (MulAut.conj g).toMonoidHom) (MulAut.conj g).injective
  rw [Subgroup.map_sup, theta_map_of_injective _ (MulAut.conj g).injective, hg]
  exact he

end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases.MarkedSeed.ExceptionalGeneration
