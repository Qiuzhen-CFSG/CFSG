module

public import CFSG.Quasithin.Chapter15.Section03.Preliminaries.Elementary

/-!
# Theta-generation and subgroups above a Sylow supplement

The intrinsic property `SylowThetaGeneration D` says that each subgroup
containing a Sylow two-subgroup is generated by that Sylow subgroup and
its elements of order three. It is invariant under actual group
isomorphisms. When D is a normal subgroup with a two-subgroup supplement,
this property controls all overgroups of the supplement by intersection
with D and the normal-product factorization.

This module proves the transport and reduction, not the property for any
of the source component models. Those concrete proofs remain prerequisites
for the source point marking in `MarkedSeed`. Neither a representation nor
a chosen point or parabolic occurs in the intrinsic property.

Source application: Aschbacher–Smith, combined manuscript (1 March 2004),
15.3.49(l) and the point stabilizers on printed pp.1144–1145.
-/

@[expose] public section

open Subgroup
namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases.MarkedSeed

/-- An intrinsic generation property of Sylow overgroups. No representation,
seed, or designated parabolic occurs in this property. -/
def SylowThetaGeneration (D : Type*) [Group D] : Prop :=
  ∀ (P : Sylow 2 D) (K : Subgroup D), (P : Subgroup D) ≤ K →
    K = theta K ⊔ (P : Subgroup D)

namespace SylowThetaGeneration
variable {D F : Type*} [Group D] [Group F]

theorem of_mulEquiv [Finite D] [Finite F] (h : SylowThetaGeneration D) (e : F ≃* D) :
    SylowThetaGeneration F := by
  intro P K hPK
  have he := h (P.mapSurjective e.surjective) (K.map e.toMonoidHom) (map_mono hPK)
  apply map_injective (f := e.toMonoidHom) e.injective
  rw [Subgroup.map_sup, theta_map_of_injective _ e.injective]
  exact he

theorem overgroup_le (C S K : Subgroup D) [C.Normal]
    (h : SylowThetaGeneration C) (P : Sylow 2 C)
    (hPS : (P : Subgroup C).map C.subtype ≤ S)
    (hgen : C ⊔ S = ⊤) (hSK : S ≤ K) : K ≤ theta K ⊔ S := by
  have hPK : (P : Subgroup C) ≤ K.subgroupOf C := by
    intro x hx
    exact hSK (hPS (mem_map_of_mem C.subtype hx))
  have he := congrArg (Subgroup.map C.subtype) (h P (K.subgroupOf C) hPK)
  rw [Subgroup.map_sup, theta_map_of_injective _ C.subtype_injective,
    subgroupOf_map_subtype] at he
  have hKC : K ⊓ C ≤ theta K ⊔ S := by
    rw [he]
    exact sup_le (theta_mono inf_le_left |>.trans le_sup_left) (hPS.trans le_sup_right)
  intro x hx
  obtain ⟨c, hc, s, hs, rfl⟩ := mem_sup_of_normal_left.mp
    (show x ∈ C ⊔ S from hgen.symm ▸ mem_top x)
  have hcK : c ∈ K := by
    simpa only [mul_inv_cancel_right] using K.mul_mem hx (K.inv_mem (hSK hs))
  exact mul_mem (hKC ⟨hcK, hc⟩) (mem_sup_right hs)

end SylowThetaGeneration
end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases.MarkedSeed
