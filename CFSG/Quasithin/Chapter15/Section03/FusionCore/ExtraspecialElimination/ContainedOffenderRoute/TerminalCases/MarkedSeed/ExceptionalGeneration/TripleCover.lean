module
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases.MarkedSeed.ExceptionalGeneration.AlternatingSix
public import Theory.GroupTheory.CComponent.HexacodeTheta.ExponentThree

/-!
# Sylow-overgroup generation in the nonsplit hexacode triple cover

The actual coordinate map has kernel of order three. Every cubic element
in the image of a subgroup lifts inside that subgroup to an element killed
by nine, hence by three using the checked exponent-three Sylow calculation.
The intersection with the coordinate kernel is also generated by cubic
elements. Thus the A₆ generation theorem lifts through this literal map,
including for subgroups which do not contain the coordinate kernel.

This discharges the triple-cover premise of the point marking in
Aschbacher–Smith, combined manuscript (1 March 2004), 15.3.49(l), printed
pp.1144–1145. The concrete monomial cover and its coordinate map come from
the licensed ATLAS port; see `LICENSES/ATLAS.txt` and
`LICENSES/ATLAS-CITATION.cff`.
-/

public section

open Subgroup Atlas.Codes
namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases.MarkedSeed.ExceptionalGeneration

private theorem mem_theta_of_cube {D : Type*} [Group D] (K : Subgroup D)
    {x : D} (hx : x ∈ K) (hc : x ^ 3 = 1) : x ∈ theta K := by
  by_cases h : x = 1
  · simp [h]
  · exact subset_closure ⟨hx, orderOf_eq_prime hc h⟩

private theorem generation_of_cubic_kernel {D F : Type*} [Group D] [Group F]
    [Finite D] [Finite F] (f : D →* F) (hf : Function.Surjective f)
    (hk : ∀ x ∈ f.ker, x ^ 3 = 1)
    (h9 : ∀ x : D, x ^ 9 = 1 → x ^ 3 = 1)
    (hF : SylowThetaGeneration F) : SylowThetaGeneration D := by
  intro P K hPK
  let J := theta K ⊔ (P : Subgroup D)
  have hJK : J ≤ K := sup_le (theta_le K) hPK
  have himage : K.map f ≤ J.map f := by
    rw [hF (P.mapSurjective hf) (K.map f) (map_mono hPK)]
    apply sup_le ?_ (map_mono le_sup_right)
    apply (closure_le _).mpr
    rintro y ⟨⟨x, hx, rfl⟩, ho⟩
    have hx9 : x ^ 9 = 1 := by
      have hc : x ^ 3 ∈ f.ker := by
        change f (x ^ 3) = 1
        rw [map_pow, ← ho, pow_orderOf_eq_one]
      simpa only [← pow_mul] using hk (x ^ 3) hc
    exact mem_map_of_mem f (mem_sup_left (mem_theta_of_cube K hx (h9 x hx9)))
  have hker : K ⊓ f.ker ≤ J := by
    intro x hx
    exact mem_sup_left (mem_theta_of_cube K hx.1 (hk x hx.2))
  apply le_antisymm ?_ hJK
  intro x hx
  obtain ⟨y, hy, hxy⟩ := himage (mem_map_of_mem f hx)
  have hd : x * y⁻¹ ∈ J := hker ⟨K.mul_mem hx (K.inv_mem (hJK hy)), by
    change f (x * y⁻¹) = 1
    rw [map_mul, map_inv, hxy, mul_inv_cancel]⟩
  simpa only [inv_mul_cancel_right] using J.mul_mem hd hy

/-- Generation for the literal nonsplit cover, for every Sylow overgroup. -/
theorem triple_cover :
    SylowThetaGeneration HexEvenAutomorphisms := by
  apply generation_of_cubic_kernel hexEvenCoordinate hexEvenCoordinate_surjective ?_
    (fun _ hx => Theory.GroupTheory.HexacodeTheta.cube_eq_one_of_ninth hx) alternating_six
  intro x hx
  have he := pow_card_eq_one' (x := (⟨x, hx⟩ : hexEvenCoordinate.ker))
  rw [hexEven_kernel_card] at he
  exact congrArg Subtype.val he

end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases.MarkedSeed.ExceptionalGeneration
