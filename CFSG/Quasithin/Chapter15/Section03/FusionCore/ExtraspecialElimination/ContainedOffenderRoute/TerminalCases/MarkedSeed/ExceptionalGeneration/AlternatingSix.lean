/-!
# Sylow-overgroup generation in the actual alternating group A₆

Every proper subgroup containing a Sylow two-subgroup lies in one of the
order-24 parabolics, by the checked six-letter overgroup exhaustion. Its
order is therefore eight or twenty-four. Cauchy's theorem supplies the
missing factor of three in the latter case. For the whole group, simplicity
makes the nontrivial normal subgroup generated by cubic elements equal to A₆.

This discharges the A₆ generation premise in the point marking used in
Aschbacher–Smith, combined manuscript (1 March 2004), 15.3.49(l) and its
stabilizer applications on printed pp.1144–1145.
-/

public section

open Subgroup
open Theory.SpecificGroups.SymmetricSix
namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases.MarkedSeed.ExceptionalGeneration

private theorem theta_top_of_simple {D : Type*} [Group D] [Finite D]
    [IsSimpleGroup D] (h3 : 3 ∣ Nat.card D) : theta (⊤ : Subgroup D) = ⊤ := by
  have hn : (theta (⊤ : Subgroup D)).Normal := by
    rw [← normalizer_eq_top_iff]
    apply top_unique
    simpa only [normalizer_eq_top] using normalizer_le_normalizer_theta (⊤ : Subgroup D)
  let := hn
  rcases hn.eq_bot_or_eq_top with hb | ht
  · obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := D) 3 h3
    have hm : x ∈ theta (⊤ : Subgroup D) := subset_closure ⟨mem_top x, hx⟩
    rw [hb, mem_bot] at hm
    simp [hm] at hx
  · exact ht

private theorem generation_of_card_dvd_24 {D : Type*} [Group D] [Finite D]
    (P K : Subgroup D) (hP : Nat.card P = 8) (hPK : P ≤ K)
    (hK : Nat.card K ∣ 24) : K = theta K ⊔ P := by
  have h8 : 8 ∣ Nat.card K := hP ▸ card_dvd_of_le hPK
  obtain ⟨n, hn⟩ := h8
  have hn3 : n ∣ 3 := by
    apply (Nat.mul_dvd_mul_iff_left (by decide : 0 < 8)).mp
    simpa only [hn] using hK
  rcases (Nat.dvd_prime Nat.prime_three).mp hn3 with hn1 | hn3
  · have he : P = K := eq_of_le_of_card_ge hPK (by omega)
    rw [← he]
    exact (sup_eq_right.mpr (theta_le P)).symm
  · have hc : Nat.card K = 24 := by omega
    let J := theta K ⊔ P
    have hJK : J ≤ K := sup_le (theta_le K) hPK
    obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := K) 3 (by rw [hc]; decide)
    have hxJ : (x : D) ∈ J := mem_sup_left (subset_closure
      ⟨x.property, (Subgroup.orderOf_coe x).trans hx⟩)
    have h3J : 3 ∣ Nat.card J := by
      have hd := orderOf_dvd_natCard (⟨x, hxJ⟩ : J)
      rwa [← Subgroup.orderOf_coe, Subgroup.orderOf_coe x, hx] at hd
    have h8J : 8 ∣ Nat.card J := hP ▸ card_dvd_of_le (show P ≤ J from le_sup_right)
    have h24J : 24 ∣ Nat.card J :=
      (show Nat.Coprime 8 3 by decide).mul_dvd_of_dvd_of_dvd h8J h3J
    exact (eq_of_le_of_card_ge hJK (by
      rw [hc]
      exact Nat.le_of_dvd Nat.card_pos h24J)).symm

theorem alternating_six : SylowThetaGeneration (alternatingGroup (Fin 6)) := by
  intro P K hPK
  by_cases hK : K = ⊤
  · subst K
    let : IsSimpleGroup A6 := alternatingGroup.isSimpleGroup (by simp)
    rw [theta_top_of_simple (by rw [a6_order]; decide), top_sup_eq]
  · have hP : Nat.card P = 8 :=
      (Nat.card_congr (P.equiv a6BorelSylow).toEquiv).trans a6Borel_order
    apply generation_of_card_dvd_24 (P : Subgroup A6) K hP hPK
    obtain ⟨M, hM, hKM⟩ := (eq_top_or_exists_le_coatom K).resolve_left hK
    obtain ⟨g, _, hg⟩ := a6_coatoms_over_sylow P
    have hcM : Nat.card M = 24 := by
      rcases (hg M).mp ⟨hM, hPK.trans hKM⟩ with rfl | rfl
      · change Nat.card (a6DuadStabilizer.map (MulAut.conj g).toMonoidHom) = 24
        rw [card_map_of_injective (MulAut.conj g).injective, a6DuadStabilizer_order]
      · change Nat.card (a6SynthemeStabilizer.map (MulAut.conj g).toMonoidHom) = 24
        rw [card_map_of_injective (MulAut.conj g).injective, a6SynthemeStabilizer_order]
    exact hcM ▸ card_dvd_of_le hKM
end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases.MarkedSeed.ExceptionalGeneration
