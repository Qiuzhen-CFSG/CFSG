module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases.MarkedSeed.SeedControl
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases.MarkedSeed.Generation
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases.MarkedSeed.LinearGeneration
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases.MarkedSeed.ExceptionalGeneration
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.ReducedModels

/-!
# Exact marking of the terminal source seed

The original quotient seed and the component point have the same stabilizer.
The seed-control module puts it in (M ∩ H)*. After the earlier component
and orbit arguments give H = LT with L normal in H, every overgroup of T*
is the product of T* with its intersection with L*. Each Sylow overgroup
of every possible L* is generated by its Sylow subgroup and its elements
of order three. Thus theta(M ∩ H) = Y₀ gives the reverse containment.

`exists_terminalPoint_of_earlier` applies the source component
classification, the larger-field exclusion, the actual component quotient
isomorphism, and `exists_seedPoint`. Thus it constructs the point rather
than assuming a witness. No direct-sum assertion is used.

`generation_of_binary_model` discharges every concrete carrier-generation
premise: linear degrees 3–5, A₆, A₇, the actual triple cover, and the derived
G₂(2) carrier. The intrinsic leaves use no source seed, action, point or
designated parabolic. The older conditional generation APIs are preserved.

The additional genuine earlier-source inputs are Z_S ≤ T and [Z_S,T] ≤ Z
from 15.3.48(2), and [Z_S:Z] = 2 from the same earlier seed setup. The
universal component-section, orbit, full corrected B.5.1, and B.2.14
implications remain explicit with their original source assembly owner.
The placed input already supplies theta(M ∩ H) = Y₀ from 15.3.49(b),
N_G(Z_S) ≤ M from 15.3.46(5), and the literal quotient action from 15.3.48.
This route needs neither an orthogonal-action premise nor |Z| = 2;
the separate SeedControl residual theorem records the orthogonal route.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), the seed
paragraph preceding 15.3.49(k) and the stabilizer uses on pp.1144–1145.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases
open Subgroup Representation Representation.BinaryOffender ModelExclusions
open ReducedModels ComponentReduction ModelReduction BinaryModels MarkedSeed
open CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison.FFAlternatives
open scoped IsMulCommutative
universe u
variable {G : Type u} [Group G] [Finite G]
    {κ : GroupClass.{u}} {H M Y V Y0 T ZS Z E L upper : Subgroup G}
    [IsElementaryAbelian 2 (localSpan ZS H)]
    {r : ReducedModels.Input κ H M Y V Y0 T ZS Z E L upper}

namespace SeedPoint

/-- Exact reverse containment, conditional on the independent intrinsic
Sylow-overgroup theorem for the actual component. -/
theorem stabilizer_le_of_component_generation (p : SeedPoint r)
    (sections : EarlierComponentSections κ)
    (orbits : OrbitClosure.EarlierOrbitAlternative κ)
    (hi : Z.relIndex ZS = 2)
    (generation : SylowThetaGeneration (starImage H L)) :
    pointStabilizer p.space.toRepresentation p.point ≤ starImage H Y0 ⊔ starImage H T := by
  obtain ⟨_, _, hg, hn, _, _, hs⟩ := r.structure_of_earlier sections orbits
  let : (L.subgroupOf H).Normal := hn
  let : (starImage H L).Normal := hn.map _ (QuotientGroup.mk'_surjective _)
  have hgen : starImage H L ⊔ starImage H T = ⊤ := by
    have he : L.subgroupOf H ⊔ T.subgroupOf H = ⊤ := by
      rw [← subgroupOf_sup r.l_le r.t_le, ← hg, subgroupOf_self]
    rw [starImage, starImage, ← Subgroup.map_sup, he,
      map_top_of_surjective _ (QuotientGroup.mk'_surjective _)]
  obtain ⟨P, hP⟩ := hs
  have hPS : (P : Subgroup (starImage H L)).map (starImage H L).subtype ≤
      starImage H T := by
    rw [hP, starImage_inter_sylow H T L r.sylowIn]
    exact inf_le_left
  have hc := generation.overgroup_le (starImage H L) (starImage H T)
    (pointStabilizer p.space.toRepresentation p.point) P hPS hgen
    (le_sup_right.trans p.base_le)
  apply hc.trans
  apply sup_le_sup_right
  calc
    theta (pointStabilizer p.space.toRepresentation p.point) ≤
        theta (starImage H (M ⊓ H)) := theta_mono (p.stabilizer_le_star_intersection hi)
    _ = starImage H Y0 := by
      rw [← FactorGeneration.starImage_theta H (M ⊓ H) inf_le_right, r.placed.theta_eq]

/-- Equality with the literal source parabolic, under the same intrinsic
generation premise. -/
theorem stabilizer_eq_of_component_generation (p : SeedPoint r)
    (sections : EarlierComponentSections κ)
    (orbits : OrbitClosure.EarlierOrbitAlternative κ)
    (hi : Z.relIndex ZS = 2)
    (generation : SylowThetaGeneration (starImage H L)) :
    pointStabilizer p.space.toRepresentation p.point = starImage H Y0 ⊔ starImage H T :=
  le_antisymm (p.stabilizer_le_of_component_generation sections orbits hi generation) p.base_le

end SeedPoint

/-- B.2.14 supplies the actual seed point, and intrinsic generation supplies
its marking. The final earlier-source adapter discharges the latter premise. -/
theorem exists_terminalPoint_of_component_generation
    (r : ReducedModels.Input κ H M Y V Y0 T ZS Z E L upper)
    (sections : EarlierComponentSections κ)
    (orbits : OrbitClosure.EarlierOrbitAlternative κ)
    (hB214 : CharacteristicTwo.RankOneConfiguration.EightGeometry.NaturalModule.FixedGeometry.SourceB214Splitting.{u})
    (hZST : ZS ≤ T) (h48 : ⁅ZS, T⁆ ≤ Z) (hi : Z.relIndex ZS = 2)
    (generation : SylowThetaGeneration (starImage H L)) : Nonempty (TerminalPoint r) := by
  obtain ⟨p⟩ := exists_seedPoint r sections hB214 hZST h48
  exact ⟨p.mark (r.structure_of_earlier sections orbits).1
    (p.stabilizer_le_of_component_generation sections orbits hi generation)⟩

namespace MarkedSeed

/-- The actual binary-model alternatives transfer the intrinsic generation
properties through their supplied isomorphisms. -/
theorem generation_of_models {D : Type*} [Group D] [Finite D]
    (hmodel : BinaryComponentModel D)
    (linear : ∀ n : ℕ, 3 ≤ n → n ≤ 5 →
      SylowThetaGeneration (Matrix.ProjectiveSpecialLinearGroup (Fin n) (ZMod 2)))
    (six : SylowThetaGeneration (alternatingGroup (Fin 6)))
    (seven : SylowThetaGeneration (alternatingGroup (Fin 7)))
    (cover : SylowThetaGeneration Atlas.Codes.HexEvenAutomorphisms)
    (g2 : SylowThetaGeneration (commutator (Atlas.G2.Model (ZMod 2)))) :
    SylowThetaGeneration D := by
  cases hmodel with
  | linear n lo hi iso =>
    obtain ⟨e⟩ := iso
    exact (linear n lo hi).of_mulEquiv e
  | alternating_six iso =>
    obtain ⟨e⟩ := iso
    exact six.of_mulEquiv e
  | alternating_seven iso =>
    obtain ⟨e⟩ := iso
    exact seven.of_mulEquiv e
  | triple_cover iso =>
    obtain ⟨e⟩ := iso
    exact cover.of_mulEquiv e
  | g2_derived iso =>
    obtain ⟨e⟩ := iso
    exact g2.of_mulEquiv e

/-- Every binary component alternative has the required intrinsic generation,
transported through its actual carrier isomorphism. -/
theorem generation_of_binary_model {D : Type*} [Group D] [Finite D]
    (hmodel : BinaryComponentModel D) : SylowThetaGeneration D :=
  generation_of_models hmodel LinearGeneration.binary_linear
    ExceptionalGeneration.alternating_six ExceptionalGeneration.alternating_seven
    ExceptionalGeneration.triple_cover ExceptionalGeneration.g2_derived

/-- The earlier source reductions identify the actual component quotient with
one of the proved carriers. No model or generation premise remains. -/
theorem component_generation_of_earlier
    (r : ReducedModels.Input κ H M Y V Y0 T ZS Z E L upper)
    (sections : EarlierComponentSections κ)
    (orbits : OrbitClosure.EarlierOrbitAlternative κ)
    (source : ProjectiveLine.QuasisimpleClassificationInput.{u,u} κ)
    (hB214 : CharacteristicTwo.RankOneConfiguration.EightGeometry.NaturalModule.FixedGeometry.SourceB214Splitting.{u})
    (hZST : ZS ≤ T) (h48 : ⁅ZS, T⁆ ≤ Z) :
    SylowThetaGeneration (starImage H L) := by
  have hm := (r.binary_sections sections
    (r.no_larger_field_of_earlier sections orbits source hB214 hZST h48)).2.1
  exact (generation_of_binary_model hm).of_mulEquiv
    (componentStarEquiv H L r.l_le r.component_in_H).symm

end MarkedSeed

/-- All source reductions and the actual seed construction are applied here.
Only the concrete intrinsic generation theorems remain in addition to the
stated earlier-source inputs. This is a conditional assembly, not the
finished source marking. -/
theorem exists_terminalPoint_of_binary_generation
    (r : ReducedModels.Input κ H M Y V Y0 T ZS Z E L upper)
    (sections : EarlierComponentSections κ)
    (orbits : OrbitClosure.EarlierOrbitAlternative κ)
    (source : ProjectiveLine.QuasisimpleClassificationInput.{u,u} κ)
    (hB214 : CharacteristicTwo.RankOneConfiguration.EightGeometry.NaturalModule.FixedGeometry.SourceB214Splitting.{u})
    (hZST : ZS ≤ T) (h48 : ⁅ZS, T⁆ ≤ Z) (hi : Z.relIndex ZS = 2)
    (linear : ∀ n : ℕ, 3 ≤ n → n ≤ 5 →
      SylowThetaGeneration (Matrix.ProjectiveSpecialLinearGroup (Fin n) (ZMod 2)))
    (six : SylowThetaGeneration (alternatingGroup (Fin 6)))
    (seven : SylowThetaGeneration (alternatingGroup (Fin 7)))
    (cover : SylowThetaGeneration Atlas.Codes.HexEvenAutomorphisms)
    (g2 : SylowThetaGeneration (commutator (Atlas.G2.Model (ZMod 2)))) :
    Nonempty (TerminalPoint r) := by
  have hm := (r.binary_sections sections
    (r.no_larger_field_of_earlier sections orbits source hB214 hZST h48)).2.1
  have hc := MarkedSeed.generation_of_models hm linear six seven cover g2
  have hs := hc.of_mulEquiv (componentStarEquiv H L r.l_le r.component_in_H).symm
  exact exists_terminalPoint_of_component_generation r sections orbits hB214 hZST h48 hi hs

namespace SeedPoint

/-- Reverse containment for the original quotient seed, with all intrinsic
model-generation premises discharged from the earlier source inputs. -/
theorem stabilizer_le_of_earlier (p : SeedPoint r)
    (sections : EarlierComponentSections κ)
    (orbits : OrbitClosure.EarlierOrbitAlternative κ)
    (source : ProjectiveLine.QuasisimpleClassificationInput.{u,u} κ)
    (hB214 : CharacteristicTwo.RankOneConfiguration.EightGeometry.NaturalModule.FixedGeometry.SourceB214Splitting.{u})
    (hZST : ZS ≤ T) (h48 : ⁅ZS, T⁆ ≤ Z) (hi : Z.relIndex ZS = 2) :
    pointStabilizer p.space.toRepresentation p.point ≤ starImage H Y0 ⊔ starImage H T :=
  p.stabilizer_le_of_component_generation sections orbits hi
    (component_generation_of_earlier r sections orbits source hB214 hZST h48)

/-- The exact source parabolic stabilizes the constructed component point. -/
theorem stabilizer_eq_of_earlier (p : SeedPoint r)
    (sections : EarlierComponentSections κ)
    (orbits : OrbitClosure.EarlierOrbitAlternative κ)
    (source : ProjectiveLine.QuasisimpleClassificationInput.{u,u} κ)
    (hB214 : CharacteristicTwo.RankOneConfiguration.EightGeometry.NaturalModule.FixedGeometry.SourceB214Splitting.{u})
    (hZST : ZS ≤ T) (h48 : ⁅ZS, T⁆ ≤ Z) (hi : Z.relIndex ZS = 2) :
    pointStabilizer p.space.toRepresentation p.point = starImage H Y0 ⊔ starImage H T :=
  le_antisymm (p.stabilizer_le_of_earlier sections orbits source hB214 hZST h48 hi) p.base_le

end SeedPoint

/-- Construct and mark the literal terminal point from the earlier source
inputs. B.2.14 supplies the seed, all binary carriers supply generation, and
the relative component structure supplies the unchanged component commutator.
The universal earlier implications remain with the source assembly owner. -/
theorem exists_terminalPoint_of_earlier
    (r : ReducedModels.Input κ H M Y V Y0 T ZS Z E L upper)
    (sections : EarlierComponentSections κ)
    (orbits : OrbitClosure.EarlierOrbitAlternative κ)
    (source : ProjectiveLine.QuasisimpleClassificationInput.{u,u} κ)
    (hB214 : CharacteristicTwo.RankOneConfiguration.EightGeometry.NaturalModule.FixedGeometry.SourceB214Splitting.{u})
    (hZST : ZS ≤ T) (h48 : ⁅ZS, T⁆ ≤ Z) (hi : Z.relIndex ZS = 2) :
    Nonempty (TerminalPoint r) := by
  obtain ⟨p⟩ := exists_seedPoint r sections hB214 hZST h48
  exact ⟨p.mark (r.structure_of_earlier sections orbits).1
    (p.stabilizer_le_of_earlier sections orbits source hB214 hZST h48 hi)⟩

end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases
