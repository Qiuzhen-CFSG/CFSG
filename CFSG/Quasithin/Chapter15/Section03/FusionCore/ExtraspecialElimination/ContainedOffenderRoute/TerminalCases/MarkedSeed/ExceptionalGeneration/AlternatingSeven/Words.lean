private def generators (g : S7) (i : Fin 10) : S7 :=
  if h : i.val < 8 then upper ⟨i.val, h⟩ else if i.val = 8 then g else g⁻¹

private def word (g : S7) (w : List (Fin 10)) : S7 :=
  (w.map (generators g)).prod

private theorem word_mem (K : Subgroup S7) (hu : ∀ i, upper i ∈ K)
    {g : S7} (hg : g ∈ K) (w : List (Fin 10)) : word g w ∈ K := by
  apply K.list_prod_mem
  intro x hx
  obtain ⟨i, _, rfl⟩ := List.mem_map.mp hx
  unfold generators
  split_ifs
  · exact hu _
  · exact hg
  · exact K.inv_mem hg

