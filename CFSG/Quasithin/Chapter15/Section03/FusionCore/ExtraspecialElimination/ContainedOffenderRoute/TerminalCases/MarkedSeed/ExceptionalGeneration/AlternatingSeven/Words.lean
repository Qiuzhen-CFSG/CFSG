private theorem word_certificate (j : Fin 98) :
    rep j ∈ alternatingGroup (Fin 7) →
      word (rep j) (cubicWords j) ^ 3 = 1 ∧
      word (word (rep j) (cubicWords j)) (recoveryWords j) = rep j := by
  revert j
  decide +kernel

/-- Every alternating overgroup is generated by its standard Sylow subgroup
and its elements whose cubes are one. The target subgroup is arbitrary. -/
theorem overgroup_le_of_cube (K J : Subgroup S7)
    (hKA : K ≤ alternatingGroup (Fin 7))
    (huK : ∀ i, upper i ∈ K) (huJ : ∀ i, upper i ∈ J)
    (hcube : ∀ g ∈ K, g ^ 3 = 1 → g ∈ J) : K ≤ J := by
  intro g hg
  obtain ⟨i, j, k, he⟩ := decomposition g
  have hr : rep j ∈ K := by
    have hm := K.mul_mem (K.mul_mem (K.inv_mem (huK i)) hg) (K.inv_mem (huK k))
    simpa only [he, mul_assoc, inv_mul_cancel_left, mul_inv_cancel, mul_one] using hm
  obtain ⟨hc, hw⟩ := word_certificate j (hKA hr)
  have hcJ := hcube _ (word_mem K huK hr _) hc
  have hrJ : rep j ∈ J := hw ▸ word_mem J huJ hcJ (recoveryWords j)
  rw [he]
  exact J.mul_mem (J.mul_mem (huJ i) hrJ) (huJ k)

