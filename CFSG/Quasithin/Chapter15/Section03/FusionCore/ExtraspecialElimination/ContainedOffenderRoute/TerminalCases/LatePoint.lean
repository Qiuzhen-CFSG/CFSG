module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalPoint
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.ReducedModels.NaturalSelection.FivePoint
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ModelExclusions.PointCases
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ModelExclusions.BinaryGeneration.StarSetup

/-!
# Point exclusions inside the late actor

Restrict the actual component point to the subgroup generated by all best
offenders. Its stabilizer is the intersection with Y₀*T*. It is still proper:
otherwise the component, together with T*, would fix the point, and these
generate H*. The later selected strong offender remains in the intrinsic
two-core of this restricted stabilizer.

The checked binary and six-letter point calculations therefore apply on the
late actor, including when it is a proper subgroup of H*. No identification
of that actor with the first offender span or with H* is required. The
module alternatives in the last two theorems remain explicit; their
construction from the full B.5.1 conclusion is a separate obligation.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), B.5.1,
printed pp.99–103, and the point exclusions on p.1145.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases

open Subgroup Representation Representation.BinaryOffender ModelExclusions
open ReducedModels ComponentReduction ModelReduction BinaryModels
open scoped IsMulCommutative

universe u
variable {G : Type u} [Group G]
    {κ : GroupClass.{u}} {H M Y V Y0 T ZS Z E L upper : Subgroup G}
    [IsElementaryAbelian 2 (localSpan ZS H)]
    {r : ReducedModels.Input κ H M Y V Y0 T ZS Z E L upper}

namespace PointOnLateActor

/-- Restriction retains the literal component submodule and its vector. -/
def space (p : TerminalPoint r) :
    Subrepresentation (r.placed.action.representation.comp (lateActor r.placed.action).subtype) where
  toSubmodule := p.space.toSubmodule
  apply_mem_toSubmodule g _ hv := p.space.apply_mem_toSubmodule g.val hv

/-- The restricted stabilizer is the genuine intersection, not an assumed
point stabilizer for a preferred model vector. -/
theorem stabilizer (p : TerminalPoint r) :
    pointStabilizer (space p).toRepresentation p.point =
      (starImage H Y0 ⊔ starImage H T).subgroupOf (lateActor r.placed.action) := by
  rw [p.stabilizer]
  ext g
  rfl

/-- H* = L*T* ensures that properness survives restriction to the late actor. -/
theorem proper [Finite G] (p : TerminalPoint r)
    (sections : EarlierComponentSections κ)
    (orbits : OrbitClosure.EarlierOrbitAlternative κ) :
    pointStabilizer (space p).toRepresentation p.point ≠ ⊤ := by
  intro ht
  have hP : lateActor r.placed.action ≤ starImage H Y0 ⊔ starImage H T := by
    intro g hg
    have hm : (⟨g, hg⟩ : lateActor r.placed.action) ∈
        pointStabilizer (space p).toRepresentation p.point := ht.symm ▸ mem_top _
    rw [stabilizer] at hm
    exact hm
  apply p.proper
  apply top_unique
  rw [← BinaryGeneration.star_generation
    (r.reduced_data orbits (r.y_le_closure sections))]
  exact sup_le ((r.component_le_late_actor sections orbits).trans hP) le_sup_right

/-- Intersecting the actual local two-core puts the same selected subgroup
in the two-core of the restricted point stabilizer. -/
theorem offender_in_core (p : TerminalPoint r) (s : StrongPlacement r) :
    (starImage H s.selected.carrier).subgroupOf (lateActor r.placed.action) ≤
      localTwoCore (pointStabilizer (space p).toRepresentation p.point) := by
  rw [stabilizer]
  exact (comap_mono s.core).trans (ReducedModels.NaturalSelection.core_restrict _ _)

/-- The later subgroup remains strong on the component submodule under the
late action. Its membership and rank are inherited from its own best status. -/
theorem strong [Finite G] (p : TerminalPoint r) (s : StrongPlacement r) :
    IsStrongOffender (space p).toRepresentation
      ((starImage H s.selected.carrier).subgroupOf (lateActor r.placed.action)) := by
  have hs := s.late_offender.2.2
  exact ⟨hs.1, (fixedCodim_subrepresentation_le _ (space p) _).trans_lt hs.2⟩

/-- Apply the binary natural/central-extension/doubled alternatives to the
literal late action and selected point. The alternatives must be constructed. -/
theorem exclude_binary [Finite G] (p : TerminalPoint r) (s : StrongPlacement r)
    (sections : EarlierComponentSections κ)
    (orbits : OrbitClosure.EarlierOrbitAlternative κ)
    (hcase : PointCases.BinaryModuleCase (space p).toRepresentation
      ((starImage H L).subgroupOf (lateActor r.placed.action))) : False :=
  hcase.exclude _ _ p.point (proper p sections orbits) (offender_in_core p s) (strong p s)

/-- Apply all four A₆/S₆ natural/core alternatives at the actual point. -/
theorem exclude_six [Finite G] (p : TerminalPoint r) (s : StrongPlacement r)
    (sections : EarlierComponentSections κ)
    (orbits : OrbitClosure.EarlierOrbitAlternative κ)
    (hcase : PointCases.SixModuleCase (space p).toRepresentation
      ((starImage H L).subgroupOf (lateActor r.placed.action))) : False :=
  hcase.exclude _ _ p.point (proper p sections orbits) (offender_in_core p s) (strong p s)

end PointOnLateActor
end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases
