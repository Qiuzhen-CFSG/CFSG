module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases.MarkedSeed.Generation
public import Theory.AtlasPort.LinearGroups.G2.BinaryDerivedSimplicity
public import Theory.AtlasPort.LinearGroups.G2.BinaryParabolicPair.MarkedRestriction
public import Theory.AtlasPort.LinearGroups.G2.BinaryParabolicPair.SevenSylowOvergroups
public import Theory.AtlasPort.LinearGroups.G2.BinaryParabolicPair.ThreeSylowContainment
public import Theory.GroupTheory.TwoThreeSolvable

/-!
# Theta-generation in the actual derived binary G₂ carrier

Simplicity and Cauchy's theorem prove that the whole commutator group is
generated by its cubic elements. A Sylow overgroup of order dividing 96
is generated by its Sylow subgroup and cubic elements as well.

For an arbitrary Sylow overgroup whose order is not divisible by seven,
Lagrange gives only the primes two and three. The proved two-prime
solvability theorem supplies solvability, and the binary G₂ obstruction
then excludes nine. The Sylow order 32 forces the order to divide 96.
This includes every subgroup in either restricted parabolic.

For seven-divisible overgroups, the derived Bruhat coverage and checked
root-word certificates force the whole group. Applying this model theorem
to `g2_derived_of_seven_overgroups` proves unrestricted `g2_derived`, for
every Sylow subgroup by conjugacy. `DerivedG2.Application` connects the
result to the literal source seed; this leaf remains independent of the
parent `MarkedSeed`.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), 15.3.49(l)
and its point-stabilizer applications, printed pp.1144–1145. The underlying
carrier, orders and simplicity are those of the licensed split-octonion
ATLAS port, as cited in the imported G₂ modules. No unitary comparison is
used.
-/

public section

open Subgroup Atlas.G2.BinaryParabolicPair
open scoped Pointwise
namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases.MarkedSeed.ExceptionalGeneration

private theorem derived_card : Nat.card DerivedModel = 6048 := by
  rw [DerivedModel, commutator_eq_longRootClosure]
  exact Atlas.G2.BinaryException.card_H

private theorem sylow_card (P : Sylow 2 DerivedModel) : Nat.card P = 32 :=
  (Nat.card_congr (P.equiv derivedSylow).toEquiv).trans card_derivedSylow

/-- Cubic elements generate the whole actual simple derived group. -/
theorem g2_derived_theta_top : theta (⊤ : Subgroup DerivedModel) = ⊤ := by
  let : IsSimpleGroup DerivedModel := Atlas.G2.isSimple_commutator_binary
  have hn : (theta (⊤ : Subgroup DerivedModel)).Normal := by
    rw [← normalizer_eq_top_iff]
    apply top_unique
    simpa only [normalizer_eq_top] using normalizer_le_normalizer_theta (⊤ : Subgroup DerivedModel)
  let := hn
  rcases hn.eq_bot_or_eq_top with hb | ht
  · obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := DerivedModel) 3
      (by rw [derived_card]; decide)
    have hm : x ∈ theta (⊤ : Subgroup DerivedModel) := subset_closure ⟨mem_top x, hx⟩
    rw [hb, mem_bot] at hm
    simp [hm] at hx
  · exact ht

/-- The order-32 Sylow subgroup and one cubic fill an order-96 overgroup. -/
theorem g2_derived_generation_of_card_dvd_96
    (P : Sylow 2 DerivedModel) (K : Subgroup DerivedModel)
    (hPK : (P : Subgroup DerivedModel) ≤ K) (hK : Nat.card K ∣ 96) :
    K = theta K ⊔ (P : Subgroup DerivedModel) := by
  have hP := sylow_card P
  have h32 : 32 ∣ Nat.card K := hP ▸ card_dvd_of_le hPK
  obtain ⟨n, hn⟩ := h32
  have hn3 : n ∣ 3 := by
    apply (Nat.mul_dvd_mul_iff_left (by decide : 0 < 32)).mp
    simpa only [hn] using hK
  rcases (Nat.dvd_prime Nat.prime_three).mp hn3 with hn1 | hn3
  · have he : (P : Subgroup DerivedModel) = K := eq_of_le_of_card_ge hPK (by omega)
    rw [← he]
    exact (sup_eq_right.mpr (theta_le _)).symm
  · have hc : Nat.card K = 96 := by omega
    let J := theta K ⊔ (P : Subgroup DerivedModel)
    have hJK : J ≤ K := sup_le (theta_le K) hPK
    obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := K) 3 (by rw [hc]; decide)
    have hxJ : (x : DerivedModel) ∈ J := mem_sup_left (subset_closure
      ⟨x.property, (Subgroup.orderOf_coe x).trans hx⟩)
    have h3J : 3 ∣ Nat.card J := by
      have hd := orderOf_dvd_natCard (⟨x, hxJ⟩ : J)
      rwa [← Subgroup.orderOf_coe, Subgroup.orderOf_coe x, hx] at hd
    have h32J : 32 ∣ Nat.card J := hP ▸ card_dvd_of_le
      (show (P : Subgroup DerivedModel) ≤ J from le_sup_right)
    have h96J : 96 ∣ Nat.card J :=
      (show Nat.Coprime 32 3 by decide).mul_dvd_of_dvd_of_dvd h32J h3J
    exact (eq_of_le_of_card_ge hJK (by
      rw [hc]
      exact Nat.le_of_dvd Nat.card_pos h96J)).symm

private theorem prime_support (K : Subgroup DerivedModel) (h7 : ¬ 7 ∣ Nat.card K)
    (p : ℕ) (hp : p.Prime) (hd : p ∣ Nat.card K) : p = 2 ∨ p = 3 := by
  have h : p ∣ (2 ^ 5 * 3 ^ 3) * 7 := by
    simpa only [derived_card, show (2 ^ 5 * 3 ^ 3) * 7 = 6048 by decide] using
      hd.trans K.card_subgroup_dvd_card
  rcases hp.dvd_mul.mp h with h | h
  · rcases hp.dvd_mul.mp h with h | h
    · exact Or.inl ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp (hp.dvd_of_dvd_pow h))
    · exact Or.inr ((Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).mp (hp.dvd_of_dvd_pow h))
  · have he := (Nat.prime_dvd_prime_iff_eq hp (by decide : Nat.Prime 7)).mp h
    exact False.elim (h7 (he ▸ hd))

private theorem card_dvd_96_of_exclusions (K : Subgroup DerivedModel)
    (h32 : 32 ∣ Nat.card K) (h9 : ¬ 9 ∣ Nat.card K) (h7 : ¬ 7 ∣ Nat.card K) :
    Nat.card K ∣ 96 := by
  obtain ⟨n, hn⟩ := h32
  have hn189 : n ∣ 189 := by
    apply (Nat.mul_dvd_mul_iff_left (by decide : 0 < 32)).mp
    simpa only [derived_card, hn] using K.card_subgroup_dvd_card
  have hnc : Nat.Coprime n 7 :=
    ((show Nat.Prime 7 by decide).coprime_iff_not_dvd.mpr (by
      intro hd
      exact h7 (hn ▸ dvd_mul_of_dvd_right hd 32))).symm
  have hn27 : n ∣ 3 ^ 3 := hnc.dvd_of_dvd_mul_right hn189
  obtain ⟨k, hk, rfl⟩ := (Nat.dvd_prime_pow Nat.prime_three).mp hn27
  have hk2 : k < 2 := by
    by_contra h
    have hd : 9 ∣ 3 ^ k := (show 3 ^ 2 ∣ 3 ^ k from Nat.pow_dvd_pow 3 (by omega))
    exact h9 (hn ▸ dvd_mul_of_dvd_right hd 32)
  have hd : 3 ^ k ∣ 3 := by
    have : k = 0 ∨ k = 1 := by omega
    rcases this with rfl | rfl <;> norm_num
  rw [hn]
  exact Nat.mul_dvd_mul_left 32 hd

/-- No solvability assumption is required: absence of seven forces the two-and-three
prime support, which supplies solvability by the proved Burnside specialization. -/
theorem g2_derived_generation_of_seven_not_dvd
    (P : Sylow 2 DerivedModel) (K : Subgroup DerivedModel)
    (hPK : (P : Subgroup DerivedModel) ≤ K) (h7 : ¬ 7 ∣ Nat.card K) :
    K = theta K ⊔ (P : Subgroup DerivedModel) := by
  let : IsSimpleGroup DerivedModel := Atlas.G2.isSimple_commutator_binary
  let : MulAction DerivedModel (Sylow 2 DerivedModel) := Sylow.mulAction
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq DerivedModel P derivedSylow
  let e := MulAut.conj g
  let K' := K.map e.toMonoidHom
  have hP : (P : Subgroup DerivedModel).map e.toMonoidHom = derivedSylow :=
    congrArg Sylow.toSubgroup hg
  have hPK' : (derivedSylow : Subgroup DerivedModel) ≤ K' :=
    hP ▸ map_mono hPK
  have hc : Nat.card K' = Nat.card K := card_map_of_injective e.injective
  have h7' : ¬ 7 ∣ Nat.card K' := hc ▸ h7
  have hne : K' ≠ ⊤ := by
    intro ht
    apply h7'
    rw [ht, card_top, derived_card]
    decide
  have hprimes := prime_support K' h7'
  have hs := Theory.GroupTheory.isSolvable_of_prime_dvd_card_eq_two_or_three K' hprimes
  have h9 := ThreeSylowContainment.nine_not_dvd_card_of_sylow_le K' hne hs hPK' hprimes
  apply g2_derived_generation_of_card_dvd_96 P K hPK
  apply card_dvd_96_of_exclusions K ((sylow_card P) ▸ card_dvd_of_le hPK) (hc ▸ h9) h7

/-- Both literal restricted parabolics, and all their Sylow overgroups, satisfy
this branch with the displayed containment in the actual model parabolics. -/
theorem g2_derived_generation_in_parabolics
    (P : Sylow 2 DerivedModel) (K : Subgroup DerivedModel)
    (hPK : (P : Subgroup DerivedModel) ≤ K)
    (hK : K ≤ derivedFirst ∨ K ≤ derivedSecond) :
    K = theta K ⊔ (P : Subgroup DerivedModel) := by
  apply g2_derived_generation_of_card_dvd_96 P K hPK
  rcases hK with h | h
  · exact card_derivedFirst ▸ card_dvd_of_le h
  · exact card_derivedSecond ▸ card_dvd_of_le h

/-- A reduction isolating unrestricted coverage of the seven-divisible
Sylow overgroups, without solvability or parabolic-containment premises. -/
theorem g2_derived_of_seven_overgroups
    (seven : ∀ K : Subgroup DerivedModel,
      (derivedSylow : Subgroup DerivedModel) ≤ K → 7 ∣ Nat.card K → K = ⊤) :
    SylowThetaGeneration (commutator (Atlas.G2.Model (ZMod 2))) := by
  intro P K hPK
  by_cases h7 : 7 ∣ Nat.card K
  · let : MulAction DerivedModel (Sylow 2 DerivedModel) := Sylow.mulAction
    obtain ⟨g, hg⟩ := MulAction.exists_smul_eq DerivedModel P derivedSylow
    let e := MulAut.conj g
    have hP : (P : Subgroup DerivedModel).map e.toMonoidHom = derivedSylow :=
      congrArg Sylow.toSubgroup hg
    have hK : K.map e.toMonoidHom = ⊤ := seven _ (hP ▸ map_mono hPK)
      (by rwa [card_map_of_injective e.injective])
    have ht : K = ⊤ := map_injective e.injective
      (hK.trans (map_top_of_surjective e.toMonoidHom e.surjective).symm)
    rw [ht, g2_derived_theta_top, top_sup_eq]
  · exact g2_derived_generation_of_seven_not_dvd P K hPK h7

/-- Every overgroup of every Sylow two-subgroup of the actual derived binary
G₂ carrier is generated by that Sylow subgroup and its cubic elements. -/
theorem g2_derived : SylowThetaGeneration (commutator (Atlas.G2.Model (ZMod 2))) :=
  g2_derived_of_seven_overgroups SevenSylowOvergroups.eq_top_of_seven_dvd

end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases.MarkedSeed.ExceptionalGeneration
