module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalMiddle
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.MinimalBinary
public import CFSG.Quasithin.Chapter15.Section03.Preliminaries.OrthogonalLocal.Geometry

/-!+# The conditional extraspecial contradiction

Select a least-order eligible local group before constructing its faithful
action and contained best offender. Exhaustive B.5.6 supplies an outside
component; minimality and the component reductions give H = LT. The local
Fitting and orthogonal-plane arguments give strict span, and simultaneous
endpoint reversal constructs a strong best offender at its own marked edge.

The terminal point is then constructed on the literal component commutator
of U_H/Z. Strong offending excludes every component except PSL₄(2) and
PSL₅(2). Minimality excludes the smaller-overgroup generation alternative,
so the actual S₈ middle-node identification holds. Classification on the
late actor generated by all best offenders puts the later offender in L*
and supplies natural-plus-dual coordinates. Its marked point-core bound
contradicts B.4.9(2iii).

`EarlierLocal.false_of_earlier` is the complete conditional contradiction.
Its remaining parameters are earlier-source implications, with the following
discharge obligations retained by the Section 15.3 source parent:

* `EarlierLocal`: the standing 15.3.2–12 data, the actual extraspecial
  alternative of 15.3.7, 15.3.46, the local kernel in 15.3.48(3), and
  15.3.49(b),(d) at the initial overgroup;
* the actual natural orthogonal actions and fixed-plane marking, empty L_f,
  local characteristic two, 15.3.46(2), and the uniform 15.3.48(2),(3)
  conclusions, including [Z_S,T] ≤ Z;
* `GeometricFamily`, uniformly on eligible subgroups: literal conjugate
  actions, 15.3.49(c), the 15.3.47 normalizer test, the F.9.13 edge-core,
  commutator and noncentrality clauses, F.9.16 rank selection, and the
  simultaneous reversal of F.9.17. Every admissible endpoint retains its
  edge marking, including the one selected for strong offending;
* the adequate exhaustive B.5.6 implication, the B.5.5/B.4.2 component
  sections, the orbit consequence of 1.2.1(3), the corrected full B.5.1
  implication, B.2.14, and the universal B.4.9(2iii) rank assertion.

The seed quotient order is derived from the actual orthogonal fixed plane;
it is not another premise. Minimality, offenders, components, H = LT,
strict span, point marking, model coordinates, and all actor membership
and generation statements are discharged internally. No assertion about
bestness of a whole endpoint or generation of the first span by components
is used. This theorem supplies the extraspecial-elimination parent; that
parent still owns instantiation of the enumerated earlier implications and
the other conclusions of 15.3.49.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), proof of
15.3.49, printed pp.1142–1145; B.1.4(4), p.68; B.4.9(2iii), p.92;
B.5.1, pp.99–103; B.5.3–6, pp.104–105; F.9.13–17, pp.322–324.
-/

public section

namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute

open Subgroup ComponentReduction ModelReduction BinaryModels ReducedModels
open CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison.FFAlternatives
open scoped IsMulCommutative commutatorElement

universe u v
variable {G : Type u} [Group G] [Finite G]

/-- Eliminate all terminal models of the reduced local group, constructing
the marked point and the middle-node identification before using the final
rank contradiction. The input offender is the later contained strong one. -/
theorem false_of_terminal_input
    {κ : GroupClass.{u}} {H M Y V Y0 T ZS Z E L upper : Subgroup G}
    [IsElementaryAbelian 2 (localSpan ZS H)]
    (r : ReducedModels.Input κ H M Y V Y0 T ZS Z E L upper)
    (s : StrongPlacement r)
    (sections : EarlierComponentSections κ)
    (orbits : OrbitClosure.EarlierOrbitAlternative κ)
    (source : ProjectiveLine.QuasisimpleClassificationInput.{u,u} κ)
    (splitting : CharacteristicTwo.RankOneConfiguration.EightGeometry.NaturalModule.FixedGeometry.SourceB214Splitting.{u})
    (rank_source : ModelExclusions.MiddleEight.NaturalDualBestRank)
    (hZST : ZS ≤ T) (hseed_comm : ⁅ZS, T⁆ ≤ Z) (hseed_index : Z.relIndex ZS = 2) :
    False := by
  obtain ⟨⟨p⟩, hb⟩ := TerminalCases.terminalPoint_and_binary_of_earlier r s
    sections orbits source splitting hZST hseed_comm hseed_index
  have hm : Nonempty (ModelExclusions.BinaryGeometry.MiddleNodeEight
      (starImage H L) (ModelExclusions.componentParabolic H L Y0 T)) := by
    rcases hb with h4 | h5
    · obtain ⟨b⟩ := h4
      exact middleNodeEight_of_minimal_binary r.minimal r.sylow r.sylow_eq b
    · obtain ⟨b⟩ := h5
      exact middleNodeEight_of_minimal_binary r.minimal r.sylow r.sylow_eq b
  obtain ⟨m⟩ := hm
  exact TerminalMiddle.exclude r p m sections orbits s source rank_source

namespace EarlierLocal

/-- The extraspecial order-27 exponent-three case is impossible under the
enumerated genuine earlier local and appendix implications. The eligible
family is nonempty by `d.eligible`; the minimal H and every subsequent
offender, component and model witness are constructed within the proof. -/
theorem false_of_earlier
    {κ : GroupClass.{u}} (T : Sylow 2 G) (M Y Y0 ZS upper : Subgroup G)
    [IsElementaryAbelian 2 (localModule T M)]
    (a : Section03.NaturalOrthogonalAction M (localModule T M))
    (o : FusionCore.NaturalOrthogonalAction M (localModule T M))
    (i : OrthogonalPlaneIndex)
    (d : EarlierLocal κ M Y (localModule T M) Y0 ZS (centralInvolutions T) upper T)
    (hseed : ZS = fixedPlane (localModule T M) (planeStabilizer T (a.plane i)))
    (hseed_comm : ⁅ZS, (T : Subgroup G)⁆ ≤ centralInvolutions T)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    (hnormalizer : ∀ W : Subgroup G, W ≤ localModule T M →
      ¬ IsTotallySingular o.form W → normalizer (W : Set G) ≤ M)
    (hlocal : ∀ H : Subgroup G, H ∈ outsideFamily Y0 (T : Subgroup G) M → H ≤ upper →
      centralizer (pCore 2 H : Set H) ≤ pCore 2 H)
    (h48 : ∀ H : Subgroup G, H ∈ outsideFamily Y0 (T : Subgroup G) M → H ≤ upper →
      localSpan (ZS.subgroupOf H) ⊤ ≤ pCore 2 H ∧
      (frattini (localSpan (ZS.subgroupOf H) ⊤)).map
        (localSpan (ZS.subgroupOf H) ⊤).subtype ≤ (centralInvolutions T).subgroupOf H ∧
      (∀ h : H, (∀ u ∈ localSpan (ZS.subgroupOf H) ⊤,
        ⁅u,h⁆ ∈ (centralInvolutions T).subgroupOf H) ↔ h ∈ pCore 2 H) ∧
      ⁅localSpan ZS H, localTwoCore H⁆ ≤ centralInvolutions T)
    (ι : Subgroup G → Type v) [∀ H, Finite (ι H)]
    (geometry : ∀ H : Subgroup G, H ∈ outsideFamily Y0 (T : Subgroup G) M →
      (hHU : H ≤ upper) →
      letI := d.elementary_seed H hHU
      letI := d.elementary_span H hHU
      Nonempty (GeometricFamily (ι H) Y (T : Subgroup G) H (localModule T M) ZS
        (centralInvolutions T)))
    (classification : ProjectiveLine.AdequateGeneralClassificationInput.{u,u} κ)
    (sections : EarlierComponentSections κ)
    (orbits : OrbitClosure.EarlierOrbitAlternative κ)
    (source : ProjectiveLine.QuasisimpleClassificationInput.{u,u} κ)
    (splitting : CharacteristicTwo.RankOneConfiguration.EightGeometry.NaturalModule.FixedGeometry.SourceB214Splitting.{u})
    (rank_source : ModelExclusions.MiddleEight.NaturalDualBestRank) : False := by
  have hZcard : Nat.card (centralInvolutions T) = 2 :=
    a.card_centralInvolutions T d.t_le_m
  have hZScard : Nat.card ZS = 4 := by
    rw [hseed]
    exact a.card_fixedPlane_planeStabilizer T d.t_le_m i
  have hseed_index : (centralInvolutions T).relIndex ZS = 2 := by
    have hc := ((centralInvolutions T).subgroupOf ZS).card_mul_index
    rw [Nat.card_congr (subgroupOfEquivOfLe d.line_le_seed).toEquiv, hZcard,
      hZScard] at hc
    change 2 * (centralInvolutions T).relIndex ZS = 4 at hc
    omega
  obtain ⟨H, hm, E, L, r, ⟨s⟩⟩ := exists_terminal_input T M Y Y0 ZS upper
    a o i d hseed hZcard hempty hnormalizer hlocal h48 ι
    (fun H hm => geometry H hm.eligible hm.le_upper) classification sections orbits
  let := d.elementary_seed H hm.le_upper
  exact false_of_terminal_input r s sections orbits source splitting rank_source
    (d.seed_le.trans d.v_le_t) hseed_comm hseed_index

end EarlierLocal
end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute
