module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.ReducedModels.Containment
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.ReducedModels.Orbit
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.LateActor
public import CFSG.Quasithin.Chapter15.Section04.Configuration.LocalSetup.TwoFactors.FFBranch.Recognition.ClassificationComparison.QuasisimpleComparison.SourceContracts

/-!
# Applying B.5.1 after contained-offender reduction

Containment (k) and the universal orbit alternative give L₀ = L, H = LT,
and normality relative to H. The normal group generated by all best offenders
then contains L* and has generalized Fitting subgroup precisely L*. Its
faithful, offender-generated action is the restriction of the original U_H/Z
action. The odd-rank bound on H/O₂(H) supplies the required SQTK condition.

`late_source_conclusion` applies the full universal B.5.1 implication with
these hypotheses discharged. It uses the corrected projective-line contract
for B.4.2(8); no legacy triple-six offender convention is assumed. The selected
contained offender remains quadratic and best on restriction, and retains its
placement in the actual ambient O₂(Y₀*T*).

The explicit earlier inputs are the B.5.5(1)(iii)–(iv)/B.4.2 component-section
implication, the 1.2.1(3) orbit implication, and the full B.5.1 implication.
Their discharge belongs to the source assembly owner. Natural-module selection
from the full conclusion is still needed for larger-field exclusion; this
module does not identify the late actor with L*.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), proof of
15.3.49(k)–(l), printed pp.1144–1145; B.5.1, p.99; B.5.5, pp.104–105;
1.2.1(3), p.504.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.ReducedModels

open Subgroup Representation.BinaryOffender Theory.GroupTheory
open ComponentReduction ModelReduction BinaryModels
open CFSG.Quasithin.Chapter1
open CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison.FFAlternatives
open scoped IsMulCommutative

universe u

namespace Input
variable {G : Type u} [Group G] [Finite G]
    {κ : GroupClass.{u}} {H M Y V Y0 T ZS Z E L upper : Subgroup G}
    [IsElementaryAbelian 2 (localSpan ZS H)]
    (d : Input κ H M Y V Y0 T ZS Z E L upper)
include d

/-- Containment and orbit collapse together, with no intermediate local premise. -/
theorem structure_of_earlier
    (sections : EarlierComponentSections κ)
    (orbits : OrbitClosure.EarlierOrbitAlternative κ) :
    localSpan L T = L ∧ Y0 ≤ L ∧ H = L ⊔ T ∧
      (L.subgroupOf H).Normal ∧ H ≤ normalizer (L : Set G) ∧
      IsSylowIn 2 (T ⊓ L) L ∧
      IsSylowIn 2 (starImage H (T ⊓ L)) (starImage H L) :=
  d.reduced_structure orbits (d.y_le_closure sections)

/-- The component of the late actor has the original star carrier. -/
theorem component_le_late_actor
    (sections : EarlierComponentSections κ)
    (orbits : OrbitClosure.EarlierOrbitAlternative κ) :
    starImage H L ≤ lateActor d.placed.action := by
  obtain ⟨_, _, hg, _, hn, _, _⟩ := d.structure_of_earlier sections orbits
  exact component_le_lateActor d.placed.action d.placed.selected L T
    hg hn d.twoGroup d.component_in_H d.component.quasisimple

/-- The generalized Fitting subgroup is the relative component, not the
whole first offender span. -/
theorem late_fitting
    (sections : EarlierComponentSections κ)
    (orbits : OrbitClosure.EarlierOrbitAlternative κ) :
    generalizedFitting (lateActor d.placed.action) =
      (starImage H L).subgroupOf (lateActor d.placed.action) := by
  obtain ⟨_, _, hg, _, hn, _, _⟩ := d.structure_of_earlier sections orbits
  exact lateActor_generalizedFitting d.placed.action d.placed.selected L T
    hg hn d.twoGroup d.component_in_H d.component.quasisimple

/-- Every hypothesis of B.5.1 for the late actor on the literal U_H/Z.
The SQTK condition follows from H/O₂(H), whose odd ranks were already proved. -/
theorem late_source_hypothesis
    (sections : EarlierComponentSections κ)
    (orbits : OrbitClosure.EarlierOrbitAlternative κ) :
    QuasisimpleSourceHypothesis
      (d.placed.action.representation.comp (lateActor d.placed.action).subtype) κ
      ((starImage H L).subgroupOf (lateActor d.placed.action)) := by
  obtain ⟨hf, hfaith, hcore, hgen, _, _⟩ :=
    lateActor_classification_hypotheses d.placed.action d.placed.sqtk d.placed.selected.best
  let := d.component.quasisimple
  refine ⟨hf, hfaith, IsQuasisimple.of_mulEquiv
    (subgroupOfEquivOfLe (d.component_le_late_actor sections orbits)).symm,
    (d.quotient_sqtk.subgroup (lateActor d.placed.action)).subgroup _, ?_, hcore, hgen⟩
  have hc : center (lateActor d.placed.action) ≤
      generalizedFitting (lateActor d.placed.action) :=
    (show center (lateActor d.placed.action) ≤ fittingSubgroup (lateActor d.placed.action)
      from le_sSup ⟨inferInstance, inferInstance⟩).trans (fitting_le_generalizedFitting _)
  rw [d.late_fitting sections orbits] at hc ⊢
  exact (sup_eq_left.mpr hc).symm

/-- Apply the full, corrected B.5.1 implication to the actual late actor.
All alternatives remain; choosing its natural SL₂ section is a further deduction. -/
theorem late_source_conclusion
    (sections : EarlierComponentSections κ)
    (orbits : OrbitClosure.EarlierOrbitAlternative κ)
    (source : ProjectiveLine.QuasisimpleClassificationInput.{u,u} κ) :
    Nonempty (ProjectiveLine.QuasisimpleSourceConclusion
      (d.placed.action.representation.comp (lateActor d.placed.action).subtype)
      ((starImage H L).subgroupOf (lateActor d.placed.action))) :=
  source _ _ _ _ (d.late_source_hypothesis sections orbits)

omit [Finite G] in
/-- The placed offender survives on the late actor; its original ambient
two-core placement is retained without replacing it by a component core. -/
theorem late_selected_offender :
    starImage H d.placed.selected.carrier ≤ lateActor d.placed.action ∧
      IsBestOffender
        (d.placed.action.representation.comp (lateActor d.placed.action).subtype)
        ((starImage H d.placed.selected.carrier).subgroupOf (lateActor d.placed.action)) ∧
      IsQuadratic
        (d.placed.action.representation.comp (lateActor d.placed.action).subtype)
        ((starImage H d.placed.selected.carrier).subgroupOf (lateActor d.placed.action)) ∧
      starImage H d.placed.selected.carrier ≤
        (starImage H Y0 ⊔ starImage H T).pCoreIn 2 := by
  have ha := best_le_lateActor d.placed.action d.placed.selected.best
  refine ⟨ha, d.placed.selected.best.subgroupOf d.placed.action.representation ha,
    ?_, d.placed.actor_core⟩
  intro a ha b hb v
  exact d.placed.selected.quadratic a ha b hb v

end Input
end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.ReducedModels
