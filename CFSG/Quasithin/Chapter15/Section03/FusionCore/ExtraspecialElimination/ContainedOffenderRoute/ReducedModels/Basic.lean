module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.Inputs
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.BorelInner.OuterAction
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.BinaryModels.LocalSections
public import Theory.Quasithin.Rank

/-!
# Local inputs for the contained-offender model reduction

The component is supplied separately from its construction. Minimality and
the actual ambient Sylow subgroup give the replacement and universal (j).
Only Y₀ is initially known to be solvable. Its normalization by T proves
solvability of Y₀T, which is the solvability needed by the projection and
orbit arguments. No solvability assertion about M ∩ H is used here.

All fields of `Input` are the contractual inputs to this reduction: the
earlier local and seed statements in `PlacedInput`, the constructed outside
component, and minimal selection with the original ambient Sylow subgroup.
The intrinsic cubic quotient comes from 15.3.7's extraspecial alternative;
it is not the order of Y₀*. The appendix classification is to be applied to
the literal actor generated by the contained best offender on U_H/Z.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), proof of
15.3.49(b), (h)–(l), printed pp.1143–1144; B.5.3, printed p.104.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.ReducedModels

open Subgroup Representation.BinaryOffender ComponentReduction ModelReduction
open CFSG.Quasithin.Chapter1
open scoped IsMulCommutative

universe u
variable {G : Type u} [Group G]

/-- The separately supplied component and minimal local group, with the
ambient Sylow witness retained. No model or closure conclusion is a field. -/
structure Input (κ : GroupClass.{u}) (H M Y V Y0 T ZS Z E L upper : Subgroup G)
    [IsElementaryAbelian 2 (localSpan ZS H)] where
  placed : PlacedInput κ H M Y V Y0 T ZS Z E
  component : OutsideComponent H M Y0 placed.selected.carrier L
  minimal : MinimalLocal Y0 T M upper H
  sylow : Sylow 2 G
  sylow_eq : (sylow : Subgroup G) = T

/-- Solvability of a normalized join; normality is only inside the join. -/
theorem solvable_normalized_join (A B : Subgroup G)
    [Group.IsSolvable A] [Group.IsSolvable B]
    (hn : B ≤ normalizer (A : Set G)) : Group.IsSolvable (A ⊔ B : Subgroup G) := by
  let A' := A.subgroupOf (A ⊔ B)
  let B' := B.subgroupOf (A ⊔ B)
  let : A'.Normal := (normal_subgroupOf_iff_le_normalizer le_sup_left).mpr
    (sup_le A.le_normalizer hn)
  let : Group.IsSolvable A' := Group.isSolvable_of_isSolvable_injective
    (f := (subgroupOfEquivOfLe (show A ≤ A ⊔ B from le_sup_left)).toMonoidHom)
    (subgroupOfEquivOfLe (show A ≤ A ⊔ B from le_sup_left)).injective
  let : Group.IsSolvable B' := Group.isSolvable_of_isSolvable_injective
    (f := (subgroupOfEquivOfLe (show B ≤ A ⊔ B from le_sup_right)).toMonoidHom)
    (subgroupOfEquivOfLe (show B ≤ A ⊔ B from le_sup_right)).injective
  exact Group.isSolvable_of_normal_sup_eq_top A' B' (codisjoint_subgroupOf_sup A B).eq_top

namespace Input
variable {κ : GroupClass.{u}} {H M Y V Y0 T ZS Z E L upper : Subgroup G}
    [IsElementaryAbelian 2 (localSpan ZS H)]
    (d : Input κ H M Y V Y0 T ZS Z E L upper)
include d

theorem y_le : Y0 ≤ H := le_sup_left.trans d.minimal.base_le

theorem t_le : T ≤ H := le_sup_right.trans d.minimal.base_le

theorem l_le : L ≤ H :=
  d.component.le_span.trans (conjugateSpanBy_le_self d.placed.selected.le_local)

theorem component_in_H : (L.subgroupOf H).IsCComponent :=
  d.component.in_local d.placed.selected.le_local

theorem normalizes : T ≤ normalizer (Y0 : Set G) :=
  d.placed.t_le_m.trans_eq d.placed.normalizer_eq.symm

theorem twoGroup : IsPGroup 2 T := by
  rw [← d.sylow_eq]
  exact d.sylow.isPGroup'

theorem sylowIn : IsSylowIn 2 T H := by
  have hs : (d.sylow : Subgroup G) ≤ H := by
    rw [d.sylow_eq]
    exact d.t_le
  refine ⟨d.sylow.subtype hs, ?_⟩
  rw [Sylow.coe_subtype, map_subgroupOf_eq_of_le hs, d.sylow_eq]

theorem twoCore_le : localTwoCore H ≤ T :=
  d.minimal.twoCore_le_sylow d.sylow d.sylow_eq

theorem replacement [Finite G] : H = reducedOvergroup L Y0 T :=
  (d.component.minimal_reduction d.minimal d.twoCore_le d.placed.selected.le_local).1

theorem overgroups [Finite G] (K : Subgroup G) (hs : Group.IsSolvable K)
    (hb : Y0 ⊔ T ≤ K) (hK : K ≤ H) : K ≤ M ⊓ H :=
  (d.component.minimal_reduction d.minimal d.twoCore_le d.placed.selected.le_local).2
    K hs hb hK

theorem y_solvable [Finite G] : Group.IsSolvable Y0 :=
  d.placed.toLocalInput.residual_solvable

theorem base_solvable [Finite G] : Group.IsSolvable (Y0 ⊔ T : Subgroup G) := by
  let := d.y_solvable
  let := d.twoGroup.isNilpotent
  exact solvable_normalized_join Y0 T d.normalizes

theorem quotient_card [Finite G] : Nat.card (Y0 ⧸ pCore 2 Y0) = 3 :=
  d.placed.residual ▸ BorelInner.residual_quotient_card M Y V d.placed.extraspecial

theorem quotient_card_in [Finite G] :
    Nat.card ((Y0.subgroupOf H) ⧸ pCore 2 (Y0.subgroupOf H)) = 3 :=
  BorelInner.residual_quotient_card_in H M Y V Y0 d.placed.extraspecial
    d.placed.residual d.y_le

theorem closure_le [Finite G] : localSpan L T ≤ H := d.replacement ▸ le_sup_left

theorem closure_normal [Finite G] : ((localSpan L T).subgroupOf H).Normal := by
  have hn := componentClosure_normal_in_replacement L Y0 T
    (le_normalizer_iff_commutator_le_left.mpr d.component.commutator_eq.ge) d.normalizes
  rwa [← d.replacement] at hn

theorem closure_normalized [Finite G] : H ≤ normalizer (localSpan L T : Set G) :=
  (normal_subgroupOf_iff_le_normalizer d.closure_le).mp d.closure_normal

theorem closure_star_normal [Finite G] : (starImage H (localSpan L T)).Normal :=
  d.closure_normal.map _ (QuotientGroup.mk'_surjective _)

theorem component_star_ne_bot [Finite G] : starImage H L ≠ ⊥ :=
  BorelInner.component_star_nontrivial H L L d.component_in_H le_rfl

theorem closure_star_ne_bot [Finite G] : starImage H (localSpan L T) ≠ ⊥ :=
  BorelInner.component_star_nontrivial H L (localSpan L T) d.component_in_H
    (le_conjugateSpanBy L T)

/-- All B.5.3 hypotheses on the genuine actor, with its actual SQTK cover. -/
theorem classification_hypotheses [Finite G] :
    let A := d.placed.selected.carrier
    let ρ := d.placed.action.representation.comp (starImage H (localSpan A H)).subtype
    Module.Finite (ZMod 2) (Additive (localSpan ZS H ⧸ Z.subgroupOf (localSpan ZS H))) ∧
      Function.Injective ρ ∧ pCore 2 (starImage H (localSpan A H)) = ⊥ ∧
      offenderSubgroup ρ = ⊤ ∧ IsSQTK κ ((localSpan A H).subgroupOf H) ∧
      IsFFModule ρ :=
  FactorGeneration.star_span_classification_hypotheses H ZS Z d.placed.selected.carrier
    d.placed.action d.placed.sqtk d.placed.selected.le_local d.placed.selected.best

theorem quotient_sqtk [Finite G] : IsSQTK κ (H ⧸ pCore 2 H) := by
  refine ⟨?_, d.placed.sqtk.isKGroup.quotient _⟩
  intro p hp ho
  let _ : Fact p.Prime := ⟨hp⟩
  exact (primeRank_quotient_le_of_isTwoGroup p ho _ pCore_isPGroup).trans
    (d.placed.sqtk.stronglyQuasithin p hp ho)

theorem intrinsic_quasisimple [Finite G] :
    Theory.GroupTheory.IsQuasisimple (L ⧸ pCore 2 L) := by
  let := d.component.quasisimple
  exact Theory.GroupTheory.IsQuasisimple.of_mulEquiv
    (BinaryModels.componentStarEquiv H L d.l_le d.component_in_H).symm

end Input
end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.ReducedModels
