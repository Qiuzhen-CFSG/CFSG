module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.ReducedModels.Basic
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ModelReduction.BinaryModels.ModelSieve.SectionTransport

/-!
# Applying the component clause of B.5.5 to the contained actor

The universal earlier-result parameter below is the component-model consequence
of B.5.5(1)(iii)–(iv) and B.4.2, including the actual exceptional section.
It retains every B.5.3 hypothesis and a literal finite SQTK quotient. It is
not asserted for an arbitrary class κ: the source assembly must supply it
for its chosen class, together with the requisite concrete model comparisons.

We establish its application hypotheses for J = ⟨A^H⟩*, where A is the
contained best offender, and prove that L* is an ordinary component of J.
No assertion that J is generated by its components is needed. Transport
back to H* preserves the original U_H/Z action and the hexacode coordinates.
The final field sieve is conditional on exclusion of larger fields, which
remains a separate obligation of the reduction assembly.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), B.4.2, B.5.3,
B.5.5(1)(iii)–(iv), printed pp.86, 104–105; proof of 15.3.49(k)–(l), p.1144.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.ReducedModels

open Subgroup Representation.BinaryOffender Theory.GroupTheory
open ComponentReduction ModelReduction BinaryModels ModelSieve
open scoped IsMulCommutative

universe u

/-- The universal earlier component-section implication, with the actual
quotient, action, and ordinary component among its hypotheses. Only the
consumed representation clause (the exceptional hexacode section) is returned;
this does not purport to encode all conclusions of B.5.5 or B.4.2. -/
def EarlierComponentSections (κ : GroupClass.{u}) : Prop :=
  ∀ (D W : Type u) [Group D] [Finite D] [AddCommGroup W] [Module (ZMod 2) W]
    (ρ : Representation (ZMod 2) D W),
    Module.Finite (ZMod 2) W → Function.Injective ρ → pCore 2 D = ⊥ →
    offenderSubgroup ρ = ⊤ →
    ∀ (Cover : Type u) [Group Cover] [Finite Cover], IsSQTK κ Cover →
      ∀ (N : Subgroup Cover) [N.Normal], (Cover ⧸ N) ≃* D →
        ∀ C : Subgroup D, IsComponent D C → ComponentSectionAlternative ρ C

namespace Input

variable {G : Type u} [Group G] [Finite G]
    {κ : GroupClass.{u}} {H M Y V Y0 T ZS Z E L upper : Subgroup G}
    [IsElementaryAbelian 2 (localSpan ZS H)]
    (d : Input κ H M Y V Y0 T ZS Z E L upper)

include d

/-- The supplied quasisimple image is an ordinary component of the genuine
offender-generated actor, rather than merely a component of H*. -/
theorem component_in_actor :
    IsComponent (starImage H (localSpan d.placed.selected.carrier H))
      ((starImage H L).subgroupOf
        (starImage H (localSpan d.placed.selected.carrier H))) := by
  let := pCore_isNilpotent (p := 2) (G := H)
  have hc := (d.component_in_H.map_quotient (pCore 2 H)).subgroupOf
    (map_mono (comap_mono d.component.le_span))
  let : IsQuasisimple (starImage H L) := d.component.quasisimple
  let e : ((starImage H L).subgroupOf
      (starImage H (localSpan d.placed.selected.carrier H))) ≃* starImage H L :=
    subgroupOfEquivOfLe (map_mono (comap_mono d.component.le_span))
  exact ⟨hc.subnormal, IsQuasisimple.of_mulEquiv e.symm⟩

/-- Apply the universal appendix implication only after proving its B.5.3
hypotheses and its ordinary-component premise; then restore the ambient action. -/
theorem component_sections (earlier : EarlierComponentSections κ) :
    ComponentSectionAlternative d.placed.action.representation (starImage H L) := by
  obtain ⟨hfinite, hfaithful, hcore, hgenerated, hcover, _⟩ :=
    d.classification_hypotheses
  have h := earlier _ _
    (d.placed.action.representation.comp
      (starImage H (localSpan d.placed.selected.carrier H)).subtype)
    hfinite hfaithful hcore hgenerated _ hcover
    (FactorGeneration.spanStarProjection H d.placed.selected.carrier).ker
    (FactorGeneration.spanStarQuotientEquiv H d.placed.selected.carrier)
    _ d.component_in_actor
  exact h.of_subgroupOf (map_mono (comap_mono d.component.le_span))

/-- The conditional sieve keeps the exceptional source section as well as
the actual intrinsic component model. The larger-field premise is not discharged here. -/
theorem binary_sections (earlier : EarlierComponentSections κ)
    (hfield : NoLargerField (L ⧸ pCore 2 L)) :
    BinarySectionAlternative d.placed.action.representation (starImage H L) ∧
      BinaryComponentModel (L ⧸ pCore 2 L) ∧
      IsQuasisimple (L ⧸ pCore 2 L) := by
  let e := componentStarEquiv H L d.l_le d.component_in_H
  have hs := (d.component_sections earlier).sieve (hfield.of_mulEquiv e.symm)
  exact ⟨hs, hs.componentModel.of_mulEquiv e, d.intrinsic_quasisimple⟩

end Input
end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.ReducedModels
