/-!
# Terminal point and binary models for the contained-offender route

`terminalPoint_and_binary_of_earlier` constructs the point of the literal
component commutator section and leaves only the binary degree-four and
degree-five branches. B.2.14 supplies the point from an actual seed in Z_S,
with a fixed supplement and fixed difference. Seed normalizer control and
the proved intrinsic generation of each binary carrier identify its proper
stabilizer with Y₀*T*. No direct-sum premise is needed.

`PointOnLateActor` restricts a marked point and the later strong offender
to the actual actor generated by all best offenders. The point stabilizer
remains proper, and the offender stays in its intrinsic two-core. The
constructed binary and six-letter module alternatives therefore exclude
PSL₃(2) and A₆, including the proper outer extensions in full B.5.1.

`exists_strong_source_section` applies the full corrected B.5.1 to the
late actor and retains every clause, with a strong offender on its actual
component section and the resulting exclusion of quadratic ratio one.
`strict_late_component_model` removes every ratio-one B.4.2 row and
returns actual component equivalences for the five remaining families.
Comparison with the orders of the actual A₇, G₂(2)' and triple-cover
carriers excludes all three exceptional branches, without identifying
groups merely from classification row names.

The surviving `BinaryLocalData` retain the exact componentParabolic and its
model equivalence, position and T*-invariance, ready for
`middleNodeEight_of_minimal_binary`. The additional earlier local premises
are exactly Z_S ≤ T, [Z_S,T] ≤ Z and [Z_S:Z] = 2. The universal component
sections, orbit implication, corrected full B.5.1 and B.2.14 remain explicit.
Their discharge, construction of the reduced input and strong placement,
and the final middle-node contradiction belong to the source assembly
owner. This module completes the conditional terminal reduction, not the
whole of 15.3.49.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), printed
pp.1144–1145; B.3.2–3, pp.83–84; B.4.2, p.86; B.5.1, pp.99–103.
-/

public section

namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases

open Subgroup ReducedModels ModelExclusions
open ComponentReduction ModelReduction BinaryModels
open CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison.FFAlternatives
open scoped IsMulCommutative

universe u
variable {G : Type u} [Group G] [Finite G]
    {κ : GroupClass.{u}} {H M Y V Y0 T ZS Z E L upper : Subgroup G}
    [IsElementaryAbelian 2 (localSpan ZS H)]
    (r : ReducedModels.Input κ H M Y V Y0 T ZS Z E L upper)

/-- Exhaust the actual alternatives in (l) at a marked terminal point.
The two surviving geometric positions use the original component and
literal parabolic, with every field and nonbinary exclusion discharged. -/
theorem binary_of_terminalPoint (p : TerminalPoint r) (s : StrongPlacement r)
    (sections : EarlierComponentSections κ)
    (orbits : OrbitClosure.EarlierOrbitAlternative κ)
    (source : ProjectiveLine.QuasisimpleClassificationInput.{u,u} κ)
    (hB214 : CharacteristicTwo.RankOneConfiguration.EightGeometry.NaturalModule.FixedGeometry.SourceB214Splitting.{u})
    (hZST : ZS ≤ T) (h48 : ⁅ZS, T⁆ ≤ Z) :
    Nonempty (BinaryLocalData H M L Y0 T 4) ∨
      Nonempty (BinaryLocalData H M L Y0 T 5) := by
  obtain ⟨_, _, _, _, _, _, _, _, hinv, alternatives, reduced⟩ :=
    r.reduction_of_earlier sections orbits source hB214 hZST h48
  cases alternatives with
  | linear n lo hi position =>
    have hn : n = 3 ∨ n = 4 ∨ n = 5 := by omega
    rcases hn with rfl | rfl | rfl
    · exact (SmallModules.exclude_binary p s sections orbits source position.model).elim
    · exact Or.inl ⟨⟨reduced, Or.inl rfl, position, hinv⟩⟩
    · exact Or.inr ⟨⟨reduced, Or.inr rfl, position, hinv⟩⟩
  | six e _ _ _ =>
    exact (SmallModules.exclude_six p s sections orbits source e).elim
  | g2 e _ _ _ =>
    exact (ExceptionalModels.not_g2 r s sections orbits source ⟨e⟩).elim
  | seven model =>
    exact (ExceptionalModels.not_seven r s sections orbits source model).elim
  | triple_cover sectionModel =>
    exact (ExceptionalModels.not_hexSection r s sections orbits source sectionModel).elim

/-- Construct the source point and eliminate every terminal component except
the two binary degrees. The only additional local seed inputs are the
earlier containment, commutator bound and quotient order two. The universal
source implications and final contradiction remain with the source owner. -/
theorem terminalPoint_and_binary_of_earlier (s : StrongPlacement r)
    (sections : EarlierComponentSections κ)
    (orbits : OrbitClosure.EarlierOrbitAlternative κ)
    (source : ProjectiveLine.QuasisimpleClassificationInput.{u,u} κ)
    (hB214 : CharacteristicTwo.RankOneConfiguration.EightGeometry.NaturalModule.FixedGeometry.SourceB214Splitting.{u})
    (hZST : ZS ≤ T) (h48 : ⁅ZS, T⁆ ≤ Z) (hi : Z.relIndex ZS = 2) :
    Nonempty (TerminalPoint r) ∧
      (Nonempty (BinaryLocalData H M L Y0 T 4) ∨
        Nonempty (BinaryLocalData H M L Y0 T 5)) := by
  obtain ⟨p⟩ := exists_terminalPoint_of_earlier r sections orbits source hB214 hZST h48 hi
  exact ⟨⟨p⟩, binary_of_terminalPoint r p s sections orbits source hB214 hZST h48⟩

end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.TerminalCases
