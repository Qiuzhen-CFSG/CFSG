module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.OffenderLifts
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ComponentReduction.ActionGeneration
public import Theory.GroupTheory.GeneralizedFitting.QuasisimpleTwoQuotient

/-!
# An actor containing every later best offender

The subgroup generated by all best offenders on the fixed SectionAction is
normal in `H/O₂(H)`, has trivial two-core, and its restricted representation
is itself offender-generated. Its full preimage in `H` supplies a literal
SQTK cover, with a two-group kernel.

After `H = LT`, every nontrivial elementary star image generates `L` by
commutators. In particular any contained best offender puts `L*` in this
actor. Its quotient above `L*` is a two-group, so its generalized Fitting
subgroup is exactly `L*`. These are application hypotheses for B.5.1;
its model and module conclusions are not assumed or proved here.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), B.5.1 and
B.5.3, printed pp.99 and 104, and proof of 15.3.49, printed pp.1144–1145.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute

open Subgroup Representation.BinaryOffender ComponentReduction Theory.GroupTheory
open scoped IsMulCommutative

universe u
variable {G : Type u} [Group G]
variable {H U Z : Subgroup G} [IsElementaryAbelian 2 U]

/-- This actor contains all best offenders, including ones chosen after the
component reduction; it is independent of the first contained offender. -/
noncomputable def lateActor (action : SectionAction H U Z) : Subgroup (H ⧸ pCore 2 H) :=
  offenderSubgroup action.representation

theorem lateActor_normal (action : SectionAction H U Z) : (lateActor action).Normal :=
  offenderSubgroup_normal action.representation

theorem best_le_lateActor (action : SectionAction H U Z)
    {B : Subgroup (H ⧸ pCore 2 H)} (hB : IsBestOffender action.representation B) :
    B ≤ lateActor action :=
  le_iSup_of_le B (le_iSup_of_le ⟨hB, le_top⟩ le_rfl)

theorem lateActor_twoCore_eq_bot [Finite G] (action : SectionAction H U Z) :
    pCore 2 (lateActor action) = ⊥ := by
  rw [pCore_subnormal_eq_comap 2 (lateActor_normal action).isSubnormal,
    pCore_quotient_pCore_eq_bot]
  exact (lateActor action).subtype.ker_eq_bot (lateActor action).subtype_injective

/-- All generating best offenders remain best on restriction to their
generated actor, proving the generation premise of B.5.3. -/
theorem lateActor_offenderSubgroup_eq_top (action : SectionAction H U Z) :
    offenderSubgroup (action.representation.comp (lateActor action).subtype) = ⊤ := by
  let P := lateActor action
  let D := offenderSubgroup (action.representation.comp P.subtype)
  have hPD : P ≤ D.map P.subtype := by
    apply iSup_le
    intro B
    apply iSup_le
    rintro ⟨hB, _⟩
    have hBP : B ≤ P := best_le_lateActor action hB
    have hBD : B.subgroupOf P ≤ D :=
      le_iSup_of_le (B.subgroupOf P)
        (le_iSup_of_le ⟨hB.subgroupOf action.representation hBP, le_top⟩ le_rfl)
    simpa only [map_subgroupOf_eq_of_le hBP] using map_mono (f := P.subtype) hBD
  apply top_unique
  intro x _
  obtain ⟨y, hy, he⟩ := hPD x.property
  exact (Subtype.ext he : y = x) ▸ hy

theorem lateActor_action_faithful (action : SectionAction H U Z) :
    Function.Injective (action.representation.comp (lateActor action).subtype) :=
  action.faithful.comp (lateActor action).subtype_injective

/-- The preimage is a subgroup of the actual local group, not an arbitrary
SQTK group associated with a family label. -/
noncomputable def lateCover (action : SectionAction H U Z) : Subgroup H :=
  (lateActor action).comap (QuotientGroup.mk' (pCore 2 H))

noncomputable def lateProjection (action : SectionAction H U Z) :
    lateCover action →* lateActor action where
  toFun x := ⟨QuotientGroup.mk' (pCore 2 H) x, x.property⟩
  map_one' := Subtype.ext (map_one (QuotientGroup.mk' (pCore 2 H)))
  map_mul' x y := Subtype.ext (map_mul (QuotientGroup.mk' (pCore 2 H)) (x : H) (y : H))

theorem lateProjection_surjective (action : SectionAction H U Z) :
    Function.Surjective (lateProjection action) := by
  intro y
  obtain ⟨x, he⟩ := QuotientGroup.mk'_surjective (pCore 2 H) (y : H ⧸ pCore 2 H)
  have hx : x ∈ lateCover action := by
    change QuotientGroup.mk' (pCore 2 H) x ∈ lateActor action
    rw [he]
    exact y.property
  exact ⟨⟨x, hx⟩, Subtype.ext he⟩

noncomputable def lateQuotientEquiv (action : SectionAction H U Z) :
    (lateCover action ⧸ (lateProjection action).ker) ≃* lateActor action :=
  QuotientGroup.quotientKerEquivOfSurjective _ (lateProjection_surjective action)

theorem lateProjection_kernel_twoGroup (action : SectionAction H U Z) :
    IsPGroup 2 (lateProjection action).ker := by
  have he : (lateProjection action).ker = (pCore 2 H).comap (lateCover action).subtype := by
    ext x
    change lateProjection action x = 1 ↔ (x : H) ∈ pCore 2 H
    rw [Subtype.ext_iff]
    change QuotientGroup.mk' (pCore 2 H) (x : H) = 1 ↔ (x : H) ∈ pCore 2 H
    exact QuotientGroup.eq_one_iff _
  rw [he]
  exact pCore_isPGroup.comap_of_injective _ (lateCover action).subtype_injective

theorem lateCover_sqtk [Finite G] {κ : GroupClass.{u}}
    (action : SectionAction H U Z) (hH : IsSQTK κ H) : IsSQTK κ (lateCover action) :=
  hH.subgroup _

/-- The nontrivial FF witness, in addition to all B.5.3 group hypotheses. -/
theorem lateActor_classification_hypotheses [Finite G] {κ : GroupClass.{u}}
    (action : SectionAction H U Z) (hH : IsSQTK κ H)
    {B : Subgroup (H ⧸ pCore 2 H)} (hB : IsBestOffender action.representation B) :
    let ρ := action.representation.comp (lateActor action).subtype
    Module.Finite (ZMod 2) (Additive (U ⧸ Z.subgroupOf U)) ∧
      Function.Injective ρ ∧ pCore 2 (lateActor action) = ⊥ ∧
      offenderSubgroup ρ = ⊤ ∧ IsSQTK κ (lateCover action) ∧ IsFFModule ρ := by
  refine ⟨Module.Finite.of_finite, lateActor_action_faithful action,
    lateActor_twoCore_eq_bot action, lateActor_offenderSubgroup_eq_top action,
    lateCover_sqtk action hH, ?_⟩
  exact ⟨B.subgroupOf (lateActor action),
    (hB.subgroupOf action.representation (best_le_lateActor action hB)).isOffender _⟩

/-- Commutator generation places the component in the actor of all best
offenders, whether or not the new offender belongs to the initial span. -/
theorem component_le_lateActor_of_commutator (action : SectionAction H U Z)
    (L A : Subgroup G) (hLH : L ≤ H) (hAH : A ≤ H)
    (hcomm : L = ⁅L, A⁆)
    (hbest : IsBestOffender action.representation (starImage H A)) :
    starImage H L ≤ lateActor action := by
  let := lateActor_normal action
  calc
    starImage H L = ⁅starImage H L, starImage H A⁆ := by
      rw [← starImage_commutator H L A hLH hAH, ← hcomm]
    _ ≤ ⁅starImage H L, lateActor action⁆ :=
      commutator_mono le_rfl (best_le_lateActor action hbest)
    _ ≤ lateActor action := commutator_le_right _ _

/-- In the reduced group the requisite commutator generation is a theorem,
requiring only the elementary, nontrivial image of the contained offender. -/
theorem component_le_lateActor [Finite G] (action : SectionAction H U Z)
    {E : Subgroup G} (d : ContainedBest H U Z E action)
    (L T : Subgroup G) (hgen : H = L ⊔ T)
    (hn : H ≤ normalizer (L : Set G)) (hT : IsPGroup 2 T)
    (hL : (L.subgroupOf H).IsCComponent) (hq : IsQuasisimple (starImage H L)) :
    starImage H L ≤ lateActor action :=
  component_le_lateActor_of_commutator action L d.carrier (hgen ▸ le_sup_left)
    d.le_local (commutator_eq_of_reduced_two_subgroup H L T d.carrier
      hgen hn hT d.le_local hL hq d.best.1) d.best

private theorem quotient_subgroup_twoGroup
    {D : Type*} [Group D] (L P : Subgroup D) [L.Normal]
    (hp : IsPGroup 2 (D ⧸ L)) : IsPGroup 2 (P ⧸ L.subgroupOf P) := by
  let f := (QuotientGroup.mk' L).comp P.subtype
  have he : f.ker = L.subgroupOf P := by
    ext x
    change QuotientGroup.mk' L (x : D) = 1 ↔ (x : D) ∈ L
    exact QuotientGroup.eq_one_iff _
  let e := (QuotientGroup.quotientMulEquivOfEq he.symm).trans
    (QuotientGroup.quotientKerEquivRange f)
  exact (hp.to_subgroup f.range).of_equiv e.symm

/-- The precise generalized-Fitting hypothesis needed for B.5.1 on the
late actor. No equality of the first span with a component product is used. -/
theorem lateActor_generalizedFitting [Finite G] (action : SectionAction H U Z)
    {E : Subgroup G} (d : ContainedBest H U Z E action)
    (L T : Subgroup G) (hgen : H = L ⊔ T)
    (hn : H ≤ normalizer (L : Set G)) (hT : IsPGroup 2 T)
    (hL : (L.subgroupOf H).IsCComponent) (hq : IsQuasisimple (starImage H L)) :
    generalizedFitting (lateActor action) = (starImage H L).subgroupOf (lateActor action) := by
  have hLH : L ≤ H := hgen ▸ le_sup_left
  have hTH : T ≤ H := hgen ▸ le_sup_right
  let : (L.subgroupOf H).Normal := (normal_subgroupOf_iff_le_normalizer hLH).mpr hn
  let : (starImage H L).Normal :=
    (inferInstance : (L.subgroupOf H).Normal).map _ (QuotientGroup.mk'_surjective _)
  have hjoin : starImage H L ⊔ starImage H T = ⊤ := by
    have hi : L.subgroupOf H ⊔ T.subgroupOf H = ⊤ := by
      apply map_injective H.subtype_injective
      rw [Subgroup.map_sup, map_subgroupOf_eq_of_le hLH, map_subgroupOf_eq_of_le hTH,
        ← MonoidHom.range_eq_map, range_subtype, ← hgen]
    rw [starImage, starImage, ← Subgroup.map_sup, hi,
      map_top_of_surjective _ (QuotientGroup.mk'_surjective _)]
  have hquot : IsPGroup 2 ((H ⧸ pCore 2 H) ⧸ starImage H L) :=
    isPGroup_quotient_of_sup_eq_top _ _ (hT.comap_subtype.map _) hjoin
  have hLP := component_le_lateActor action d L T hgen hn hT hL hq
  let := hq
  let : IsQuasisimple ((starImage H L).subgroupOf (lateActor action)) :=
    IsQuasisimple.of_mulEquiv (subgroupOfEquivOfLe hLP).symm
  exact generalizedFitting_eq_of_quasisimple_two_quotient _
    (quotient_subgroup_twoGroup _ _ hquot) (lateActor_twoCore_eq_bot action)

end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute
