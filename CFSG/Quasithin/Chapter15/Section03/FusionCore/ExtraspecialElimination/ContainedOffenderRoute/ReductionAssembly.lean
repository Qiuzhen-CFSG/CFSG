module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.LocalSelection
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.GeometricAssembly
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.StrictSpan
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.ComponentExistence
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute.ReducedModels
public import Theory.Representation.BinaryOffender.GeneratedCore

/-!
# From minimal local selection to a placed strong best offender

Construct the first contained offender, apply exhaustive B.5.6 to its actual
generated actor, and reduce the selected local group using its minimality.
The strong endpoint is then selected from the same geometric family, and
its own edge gives the placement of a new contained strong best offender.
`StrongPlacement` keeps this later subgroup separate from the first actor.
Both belong to the late actor generated by all best offenders.

`EarlierLocal.exists_terminal_input` also chooses the minimal group and
derives strict span from the local Fitting theorem. Its only geometric input
is the family of earlier local/F.9 conclusions enumerated in
`GeometricFamily`. It assumes neither an offender, a component, reduction
to H = LT, nor strict span. The final model contradictions still have to be
proved from its output; this module does not assert extraspecial elimination.

The three explicit classification inputs used in construction are exhaustive
B.5.6, B.5.5 component sections, and the orbit implication used by 1.2.1(3).
The existing ReducedModels theorems supply the final model/parabolic list
from the further universal B.5.1 and B.2.14 inputs. All retain their source
parent's discharge obligation.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), proof of
15.3.49(h)–(n), printed pp.1143–1145.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute

open Subgroup Representation.BinaryOffender ComponentReduction
open ModelReduction BinaryModels ModelSieve FactorGeneration.ConjugatePlacement
open ReducedModels
open CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison.FFAlternatives
open scoped IsMulCommutative commutatorElement

universe u v
variable {G : Type u} [Group G]

/-- Output for the final model argument. The later strong best offender is
not assumed to lie in the initial offender's conjugate span. -/
structure StrongPlacement
    {κ : GroupClass.{u}} {H M Y V Y0 T ZS Z E L upper : Subgroup G}
    [IsElementaryAbelian 2 (localSpan ZS H)]
    (r : ReducedModels.Input κ H M Y V Y0 T ZS Z E L upper) where
  endpoint : Subgroup G
  selected : ContainedBest H (localSpan ZS H) Z endpoint r.placed.action
  strong : IsStrongOffender r.placed.action.representation (starImage H selected.carrier)
  core : starImage H selected.carrier ≤ (starImage H Y0 ⊔ starImage H T).pCoreIn 2

namespace StrongPlacement
variable {κ : GroupClass.{u}} {H M Y V Y0 T ZS Z E L upper : Subgroup G}
    [IsElementaryAbelian 2 (localSpan ZS H)]
    {r : ReducedModels.Input κ H M Y V Y0 T ZS Z E L upper}
    (s : StrongPlacement r)

/-- Later actor membership is proved from best offending. It does not
rely on membership in the first contained offender's generated actor. -/
theorem in_late_actor : starImage H s.selected.carrier ≤ lateActor r.placed.action :=
  best_le_lateActor r.placed.action s.selected.best

/-- The very same contained actor is best, quadratic and strong on the
late representation. Its original parabolic-core placement remains literal. -/
theorem late_offender [Finite G] :
    IsBestOffender (r.placed.action.representation.comp (lateActor r.placed.action).subtype)
        ((starImage H s.selected.carrier).subgroupOf (lateActor r.placed.action)) ∧
      IsQuadratic (r.placed.action.representation.comp (lateActor r.placed.action).subtype)
        ((starImage H s.selected.carrier).subgroupOf (lateActor r.placed.action)) ∧
      IsStrongOffender (r.placed.action.representation.comp (lateActor r.placed.action).subtype)
        ((starImage H s.selected.carrier).subgroupOf (lateActor r.placed.action)) := by
  refine ⟨s.selected.best.subgroupOf r.placed.action.representation s.in_late_actor, ?_, ?_⟩
  · intro a ha b hb w
    exact s.selected.quadratic a ha b hb w
  · refine ⟨(s.selected.best.subgroupOf r.placed.action.representation s.in_late_actor).1, ?_⟩
    rw [fixedCodim_subgroupOf _ s.in_late_actor, rank_subgroupOf s.in_late_actor]
    exact s.strong.2

end StrongPlacement

variable [Finite G]

/-- Component existence and H = LT are discharged before invoking strong
construction. Every selection uses the local action already attached to H. -/
theorem exists_terminal_of_strict_span
    {κ : GroupClass.{u}} {H M Y V Y0 T ZS Z upper : Subgroup G}
    [IsElementaryAbelian 2 (localSpan ZS H)]
    [IsElementaryAbelian 2 (localSpan V H)]
    (d : LocalInput κ H M Y V Y0 T ZS Z)
    (hm : MinimalLocal Y0 T M upper H) (S : Sylow 2 G) (hS : (S : Subgroup G) = T)
    {ι : Type v} [Finite ι] (f : GeometricFamily ι Y T H V ZS Z)
    (hHZ : H ≤ centralizer (Z : Set G))
    (hedge : H ⊓ (Y ⊔ T) = Y0 ⊔ T)
    (hTV : T ≤ normalizer (V : Set G)) (hVH : localSpan V H ≤ H)
    (hproper : localSpan ZS H ⊔ V < localSpan V H)
    (source : ProjectiveLine.AdequateGeneralClassificationInput.{u,u} κ)
    (sections : EarlierComponentSections κ)
    (orbits : OrbitClosure.EarlierOrbitAlternative κ) :
    ∃ E L : Subgroup G, ∃ r : ReducedModels.Input κ H M Y V Y0 T ZS Z E L upper,
      r.placed.toLocalInput = d ∧ Nonempty (StrongPlacement r) := by
  obtain ⟨i, c, h, _, hcore⟩ := f.exists_placed_best d.action Y0 d.seed_le hHZ hedge
  let p : PlacedInput κ H M Y V Y0 T ZS Z
      ((f.endpoint i).V.map (MulAut.conj ((h⁻¹ : H) : G)).toMonoidHom) :=
    { toLocalInput := d, selected := c.conjugate h⁻¹, actor_core := hcore }
  obtain ⟨L, hL⟩ := ComponentExistence.exists_of_classification p source
  let r : ReducedModels.Input κ H M Y V Y0 T ZS Z
      ((f.endpoint i).V.map (MulAut.conj ((h⁻¹ : H) : G)).toMonoidHom) L upper :=
    ⟨p, hL, hm, S, hS⟩
  obtain ⟨_, _, hgen, _, hn, _, _⟩ := r.structure_of_earlier sections orbits
  obtain ⟨j, _, b, _, k, _, hk, hs⟩ := f.exists_placed_strong r.placed.action Y0 L
    d.seed_le hHZ hedge hgen hn r.twoGroup r.component_in_H hL.quasisimple hTV hVH hproper
  exact ⟨_, L, r, rfl, ⟨⟨_, b.conjugate k⁻¹, hs, hk⟩⟩⟩

namespace EarlierLocal

/-- Minimal selection, local-action reconstruction, contained offender and
component construction, reduction, strict span and strong placement in one
conditional source assembly. The geometric-family constructor must still
come from the genuine earlier F.9 inputs at the selected H. -/
theorem exists_terminal_input
    {κ : GroupClass.{u}} (T : Sylow 2 G) (M Y Y0 ZS upper : Subgroup G)
    [IsElementaryAbelian 2 (localModule T M)]
    (a : Section03.NaturalOrthogonalAction M (localModule T M))
    (o : FusionCore.NaturalOrthogonalAction M (localModule T M))
    (i : OrthogonalPlaneIndex)
    (d : EarlierLocal κ M Y (localModule T M) Y0 ZS (centralInvolutions T) upper T)
    (hseed : ZS = fixedPlane (localModule T M) (planeStabilizer T (a.plane i)))
    (hZcard : Nat.card (centralInvolutions T) = 2)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    (hnormalizer : ∀ W : Subgroup G, W ≤ localModule T M →
      ¬ IsTotallySingular o.form W → normalizer (W : Set G) ≤ M)
    (hlocal : ∀ H : Subgroup G, H ∈ outsideFamily Y0 (T : Subgroup G) M → H ≤ upper →
      centralizer (pCore 2 H : Set H) ≤ pCore 2 H)
    (h48 : ∀ H : Subgroup G, H ∈ outsideFamily Y0 (T : Subgroup G) M → H ≤ upper →
      localSpan (ZS.subgroupOf H) ⊤ ≤ pCore 2 H ∧
      (frattini (localSpan (ZS.subgroupOf H) ⊤)).map
        (localSpan (ZS.subgroupOf H) ⊤).subtype ≤ (centralInvolutions T).subgroupOf H ∧
      (∀ h : H, (∀ u ∈ localSpan (ZS.subgroupOf H) ⊤,
        ⁅u,h⁆ ∈ (centralInvolutions T).subgroupOf H) ↔ h ∈ pCore 2 H) ∧
      ⁅localSpan ZS H, localTwoCore H⁆ ≤ centralInvolutions T)
    (ι : Subgroup G → Type v) [∀ H, Finite (ι H)]
    (geometry : ∀ H : Subgroup G, (hm : MinimalLocal Y0 (T : Subgroup G) M upper H) →
      letI := d.elementary_seed H hm.le_upper
      letI := d.elementary_span H hm.le_upper
      Nonempty (GeometricFamily (ι H) Y (T : Subgroup G) H (localModule T M) ZS
        (centralInvolutions T)))
    (source : ProjectiveLine.AdequateGeneralClassificationInput.{u,u} κ)
    (sections : EarlierComponentSections κ)
    (orbits : OrbitClosure.EarlierOrbitAlternative κ) :
    ∃ H : Subgroup G, ∃ hm : MinimalLocal Y0 (T : Subgroup G) M upper H,
      letI := d.elementary_seed H hm.le_upper
      ∃ E L : Subgroup G,
        ∃ r : ReducedModels.Input κ H M Y (localModule T M) Y0 (T : Subgroup G) ZS
          (centralInvolutions T) E L upper, Nonempty (StrongPlacement r) := by
  obtain ⟨H, hm⟩ := exists_minimalLocal Y0 (T : Subgroup G) M upper d.eligible
  let := d.elementary_seed H hm.le_upper
  let := d.elementary_span H hm.le_upper
  obtain ⟨f⟩ := geometry H hm
  obtain ⟨hUQ, hPhi, hsmall, hcomm⟩ := h48 H hm.eligible hm.le_upper
  have hp := strict_span_of_earlier T M H ZS d.t_le_m (le_sup_right.trans hm.base_le)
    hm.outside a o i hseed d.line_le_seed hZcard (hm.le_upper.trans d.centralizes)
    (hlocal H hm.eligible hm.le_upper) hempty hUQ hPhi hsmall hcomm hnormalizer
  obtain ⟨E, L, r, _, hs⟩ := exists_terminal_of_strict_span
    (d.localInput H hm.eligible hm.le_upper) hm T rfl f
    (hm.le_upper.trans d.centralizes) (d.edge_eq H hm.eligible hm.le_upper)
    (d.t_le_m.trans d.m_normalizes)
    (conjugateSpanBy_le_self (d.v_le_t.trans (le_sup_right.trans hm.base_le))) hp
    source sections orbits
  exact ⟨H, hm, E, L, r, hs⟩

end EarlierLocal
end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.ContainedOffenderRoute
