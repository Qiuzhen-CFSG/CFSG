module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.LocalAlgebra
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.Geometry.Sections
public import Theory.GroupTheory.PGroup.OmegaAmbient

/-!
# Cross-centralization at the two endpoints

The source's 15.3.47 normalizer test transports under conjugation. Each
endpoint span is generated by conjugates of V, so the test applies to the
whole span even though that span need not itself be a conjugate of V.

Faithfulness identifies E_gamma with V_gamma ∩ Q_H. Its involutions lie in
Omega_1(Q_H); the center containment of 15.3.49(c) makes E_gamma centralize
U_H. The normalizer test then makes it centralize every H-conjugate of V.
Repeating the argument at the other endpoint proves both cross-centralizations.
We use (c) and (d) at both conjugate endpoints, together with F.9.13(3) and
the endpoint containments from F.9.13(2). These are explicit earlier inputs,
not an assumed symmetry of the desired conclusion.

The fusion lemma also supplies F.9.8(f) from the centralizer span at C_G(Z).
Together with F.9.1 and the restricted normalizer test this gives (e).

Source: Aschbacher–Smith, combined manuscript (1 March 2004),
15.3.49(e)–(f), printed p.1143; F.9.8 and F.9.13, printed pp.321–322.
-/

@[expose] public section
open Subgroup
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.Geometry
variable {G : Type*} [Group G]

private theorem map_conj_conj (X : Subgroup G) (a b : G) :
    (X.map (MulAut.conj a).toMonoidHom).map (MulAut.conj b).toMonoidHom =
      X.map (MulAut.conj (b * a)).toMonoidHom := by
  rw [map_map]
  congr 1
  ext x
  simp [MulAut.conj_apply, mul_assoc]

private theorem map_conj_inv (X : Subgroup G) (a : G) :
    (X.map (MulAut.conj a).toMonoidHom).map (MulAut.conj a⁻¹).toMonoidHom = X := by
  rw [map_conj_conj]
  simp only [inv_mul_cancel, map_one]
  exact map_id X

/-- The ambient 15.3.47 conclusion used in F.9.8(g)(ii). -/
def ConjugateNormalizerTest (V ZS : Subgroup G) : Prop :=
  ∀ x ∈ centralizer (ZS : Set G), ⁅V, zpowers x⁆ ≠ ⊥ → ∀ g : G,
    V.map (MulAut.conj g).toMonoidHom ≤ normalizer (⁅V, zpowers x⁆ : Subgroup G) →
      V.map (MulAut.conj g).toMonoidHom ≤ centralizer (V : Set G)

/-- The test holds with both seeds replaced by any common conjugate. -/
theorem conjugateNormalizerTest_conjugate (V ZS : Subgroup G)
    (htest : ConjugateNormalizerTest V ZS) (a : G) :
    ConjugateNormalizerTest (V.map (MulAut.conj a).toMonoidHom)
      (ZS.map (MulAut.conj a).toMonoidHom) := by
  intro x hx hn g hg
  let f := (MulAut.conj a⁻¹).toMonoidHom
  have hx' : f x ∈ centralizer (ZS : Set G) := by
    intro z hz
    have h := congrArg f (hx (MulAut.conj a z) (mem_map_of_mem _ hz))
    simpa [f, MulAut.conj_apply, mul_assoc] using h
  have hcomm : (⁅V.map (MulAut.conj a).toMonoidHom, zpowers x⁆ : Subgroup G).map f =
      ⁅V, zpowers (f x)⁆ := by
    rw [map_commutator, MonoidHom.map_zpowers, map_conj_inv]
  have hn' : ⁅V, zpowers (f x)⁆ ≠ ⊥ := by
    intro he
    apply hn
    exact (map_eq_bot_iff_of_injective _ (MulAut.conj a⁻¹).injective).mp (hcomm.trans he)
  have hvg : ((V.map (MulAut.conj a).toMonoidHom).map
      (MulAut.conj g).toMonoidHom).map f =
      V.map (MulAut.conj (a⁻¹ * (g * a))).toMonoidHom := by
    simp only [f, map_conj_conj]
  have hnorm : V.map (MulAut.conj (a⁻¹ * (g * a))).toMonoidHom ≤
      normalizer (⁅V, zpowers (f x)⁆ : Subgroup G) := by
    rw [← hvg, ← hcomm]
    exact (map_mono hg).trans (le_normalizer_map _)
  have hc := htest (f x) hx' hn' (a⁻¹ * (g * a)) hnorm
  intro y hy v hv
  apply (MulAut.conj a⁻¹).injective
  have hy' : f y ∈ V.map (MulAut.conj (a⁻¹ * (g * a))).toMonoidHom := by
    rw [← hvg]
    exact mem_map_of_mem _ hy
  have hv' : f v ∈ V := by
    have hh := mem_map_of_mem f hv
    rw [map_conj_inv] at hh
    exact hh
  change f (v * y) = f (y * v)
  simpa only [map_mul] using hc hy' (f v) hv'

/-- Apply the normalizer test to every conjugate generating the abelian span. -/
theorem centralizes_of_span_normalizer_test
    (V ZS E W : Subgroup G) [IsMulCommutative W]
    (hEW : E ≤ W) (hEZ : E ≤ centralizer (ZS : Set G))
    (hcomm : ⁅V, E⁆ ≤ W)
    (htest : ConjugateNormalizerTest V ZS)
    (hgen : ∀ N : Subgroup G, (∀ g : G,
      V.map (MulAut.conj g).toMonoidHom ≤ W →
        V.map (MulAut.conj g).toMonoidHom ≤ N) → W ≤ N) :
    E ≤ centralizer (V : Set G) := by
  apply centralizes_of_conjugate_normalizer_test V E W hEW hcomm
  intro x hx hnonzero hnorm
  apply hgen
  intro g hg
  exact htest x (hEZ hx) hnonzero g (hg.trans hnorm)

/-- Centralizing U_H upgrades to centralizing V_H using the transported test. -/
theorem centralizes_localSpan_of_normalizer_test
    (V ZS H E W : Subgroup G) [IsMulCommutative W]
    (hEW : E ≤ W) (hEU : E ≤ centralizer (localSpan ZS H : Set G))
    (hcomm : ⁅localSpan V H, E⁆ ≤ W)
    (htest : ConjugateNormalizerTest V ZS)
    (hgen : ∀ a : G, ∀ N : Subgroup G, (∀ g : G,
      (V.map (MulAut.conj a).toMonoidHom).map (MulAut.conj g).toMonoidHom ≤ W →
        (V.map (MulAut.conj a).toMonoidHom).map (MulAut.conj g).toMonoidHom ≤ N) →
          W ≤ N) :
    E ≤ centralizer (localSpan V H : Set G) := by
  apply centralizes_localSpan
  intro a ha
  have hV : V.map (MulAut.conj a).toMonoidHom ≤ localSpan V H := by
    rintro _ ⟨v, hv, rfl⟩
    exact subset_closure ⟨a, ha, v, hv, rfl⟩
  have hZS : ZS.map (MulAut.conj a).toMonoidHom ≤ localSpan ZS H := by
    rintro _ ⟨z, hz, rfl⟩
    exact subset_closure ⟨a, ha, z, hz, rfl⟩
  exact centralizes_of_span_normalizer_test _ _ E W hEW
    (hEU.trans (centralizer_le hZS)) ((commutator_mono hV le_rfl).trans hcomm)
    (conjugateNormalizerTest_conjugate V ZS htest a) (hgen a)


private theorem conjugate_span_generated
    (V K : Subgroup G) (t a : G) (N : Subgroup G)
    (hgen : ∀ g : G,
      (V.map (MulAut.conj a).toMonoidHom).map (MulAut.conj g).toMonoidHom ≤
        localSpan (V.map (MulAut.conj t).toMonoidHom) K →
      (V.map (MulAut.conj a).toMonoidHom).map (MulAut.conj g).toMonoidHom ≤ N) :
    localSpan (V.map (MulAut.conj t).toMonoidHom) K ≤ N := by
  apply (closure_le _).mpr
  rintro _ ⟨k, hk, w, hw, rfl⟩
  have he : (V.map (MulAut.conj a).toMonoidHom).map
      (MulAut.conj (k * t * a⁻¹)).toMonoidHom =
      (V.map (MulAut.conj t).toMonoidHom).map (MulAut.conj k).toMonoidHom := by
    simp only [map_conj_conj, inv_mul_cancel_right]
  have hle : (V.map (MulAut.conj t).toMonoidHom).map (MulAut.conj k).toMonoidHom ≤
      localSpan (V.map (MulAut.conj t).toMonoidHom) K := by
    rintro _ ⟨v, hv, rfl⟩
    exact subset_closure ⟨k, hk, v, hv, rfl⟩
  have h := hgen (k * t * a⁻¹) (he.symm ▸ hle)
  rw [he] at h
  exact h (mem_map_of_mem _ hw)

/-- The generation premise is automatic for a span of conjugates of a conjugate of V. -/
theorem centralizes_span_of_conjugate_span
    (V ZS H K E : Subgroup G) (t : G)
    [IsMulCommutative (localSpan (V.map (MulAut.conj t).toMonoidHom) K)]
    (hEW : E ≤ localSpan (V.map (MulAut.conj t).toMonoidHom) K)
    (hEU : E ≤ centralizer (localSpan ZS H : Set G))
    (hcomm : ⁅localSpan V H, E⁆ ≤ localSpan (V.map (MulAut.conj t).toMonoidHom) K)
    (htest : ConjugateNormalizerTest V ZS) :
    E ≤ centralizer (localSpan V H : Set G) :=
  centralizes_localSpan_of_normalizer_test V ZS H E _ hEW hEU hcomm htest
    (fun a N => conjugate_span_generated V K t a N)

/-- Clause (e): F.9.8(f), with Z its actual cyclic subgroup. -/
theorem fusion_implies_F98_f
    (V M Z : Subgroup G) (z : G) (hZ : Z = zpowers z)
    (hM : M = normalizer (V : Set G))
    (hfusion : ∀ a : G, MulAut.conj a z ∈ V → ConjugateBy M z (MulAut.conj a z))
    [IsMulCommutative (localSpan V (centralizer ({z} : Set G)))] :
    ∀ g : G, Z ≤ V.map (MulAut.conj g).toMonoidHom →
      ⁅V, V.map (MulAut.conj g).toMonoidHom⁆ = ⊥ := by
  intro g hg
  apply conjugate_commutes_of_abelian_localSpan V M z hM hfusion g
  exact hg (hZ ▸ mem_zpowers z)


/-- One half of (f), deriving the initial U_H centralization from (c). -/
theorem crossCentralization_from_omega
    (V ZS Z H W K : Subgroup G) (t : G)
    [IsElementaryAbelian 2 (localSpan ZS H)] [IsElementaryAbelian 2 W]
    (action : SectionAction H (localSpan ZS H) Z)
    (hWH : W ≤ H) (hW : W = localSpan (V.map (MulAut.conj t).toMonoidHom) K)
    (hcenter : localSpan ZS H ≤
      (center (omegaOneAmbient (localTwoCore H))).map (omegaOneAmbient (localTwoCore H)).subtype)
    (hcomm : ⁅localSpan V H, W⁆ ≤ W)
    (htest : ConjugateNormalizerTest V ZS) :
    sectionCentralizer W (localSpan ZS H) Z ≤ centralizer (localSpan V H : Set G) := by
  let E := sectionCentralizer W (localSpan ZS H) Z
  have hE : E = W ⊓ localTwoCore H :=
    sectionCentralizer_eq_core_intersection H (localSpan ZS H) Z W action hWH
  have hEW : E ≤ W := hE ▸ inf_le_left
  have hEO : E ≤ omegaOneAmbient (localTwoCore H) := by
    intro e he
    exact (omegaOneAmbient_le_iff _ _).mp le_rfl e ((hE ▸ he).2)
      (elemPow_eq_one_of_isElementaryAbelian e (hEW he))
  have hUE : localSpan ZS H ≤ centralizer (E : Set G) := by
    intro u hu e he
    obtain ⟨c, hc, rfl⟩ := hcenter hu
    exact congrArg Subtype.val ((mem_center_iff.mp hc) ⟨e, hEO he⟩)
  apply centralizes_localSpan_of_normalizer_test V ZS H E W hEW
    (le_centralizer_iff.mp hUE) ((commutator_mono le_rfl hEW).trans hcomm) htest
  intro a N hn
  rw [hW] at hn ⊢
  exact conjugate_span_generated V K t a N hn

/-- Both halves of (f), with the two faithful section actions and conjugate seeds explicit. -/
theorem crossCentralizations
    (V ZS Z H K : Subgroup G) (t : G)
    [IsElementaryAbelian 2 (localSpan ZS H)]
    [IsElementaryAbelian 2 (localSpan (ZS.map (MulAut.conj t).toMonoidHom) K)]
    [IsElementaryAbelian 2 (localSpan V H)]
    [IsElementaryAbelian 2 (localSpan (V.map (MulAut.conj t).toMonoidHom) K)]
    (actionH : SectionAction H (localSpan ZS H) Z)
    (actionK : SectionAction K (localSpan (ZS.map (MulAut.conj t).toMonoidHom) K)
      (Z.map (MulAut.conj t).toMonoidHom))
    (hWH : localSpan (V.map (MulAut.conj t).toMonoidHom) K ≤ H)
    (hXK : localSpan V H ≤ K)
    (hcenterH : localSpan ZS H ≤
      (center (omegaOneAmbient (localTwoCore H))).map (omegaOneAmbient (localTwoCore H)).subtype)
    (hcenterK : localSpan (ZS.map (MulAut.conj t).toMonoidHom) K ≤
      (center (omegaOneAmbient (localTwoCore K))).map (omegaOneAmbient (localTwoCore K)).subtype)
    (hcomm : ⁅localSpan V H, localSpan (V.map (MulAut.conj t).toMonoidHom) K⁆ ≤
      localSpan V H ⊓ localSpan (V.map (MulAut.conj t).toMonoidHom) K)
    (htest : ConjugateNormalizerTest V ZS) :
    sectionCentralizer (localSpan (V.map (MulAut.conj t).toMonoidHom) K) (localSpan ZS H) Z ≤
        centralizer (localSpan V H : Set G) ∧
      sectionCentralizer (localSpan V H) (localSpan (ZS.map (MulAut.conj t).toMonoidHom) K)
        (Z.map (MulAut.conj t).toMonoidHom) ≤
        centralizer (localSpan (V.map (MulAut.conj t).toMonoidHom) K : Set G) := by
  refine ⟨crossCentralization_from_omega V ZS Z H _ K t actionH hWH rfl hcenterH
    (hcomm.trans inf_le_right) htest, ?_⟩
  apply crossCentralization_from_omega (V.map (MulAut.conj t).toMonoidHom)
    (ZS.map (MulAut.conj t).toMonoidHom) (Z.map (MulAut.conj t).toMonoidHom)
    K (localSpan V H) H t⁻¹ actionK hXK
  · rw [map_conj_inv]
  · exact hcenterK
  · rw [commutator_comm]
    exact hcomm.trans inf_le_left
  · exact conjugateNormalizerTest_conjugate V ZS htest t

end CFSG.Quasithin.Chapter15.Section03.FusionCore.ExtraspecialElimination.Geometry
