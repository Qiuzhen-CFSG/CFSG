module
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.WeakClosure.Centralization.CoreGeometry.Coordinates
public import CFSG.Quasithin.Chapter15.Section03.FusionCore.WeakClosure.Centralization.Reductions
public import Mathlib.Algebra.Group.Pointwise.Finset.Basic
public import Theory.GroupTheory.WreathTwoSylowModel

/-!
# The two Klein four actions in the orthogonal four-space

The actual matrix-and-permutation action of the standard dihedral Sylow
subgroup has two kinds of Klein four subgroups. The fixed subgroups of their
three involutions generate either the whole space or an order-eight subgroup
whose common fixed subgroup has order two. The calculation enumerates only
pairs in the eight-element dihedral group and vectors in the sixteen-element
module, with all finite equalities checked by the Lean kernel.

Chapter E's involution-generator theorem identifies this generated subgroup
with the dual core at one. Sylow conjugacy transports both the core and its
fixed subgroup through the corresponding vector automorphism. Thus a proper
dual core always has the second pair of orders, without any choice of marking
for the ambient natural module.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), the second case
of 15.3.46(4), printed p.1141, and Definition F.4.41, printed p.294.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.Centralization.CoreGeometry
open Subgroup
open scoped Pointwise
attribute [local instance] orthogonalAction
private instance : DecidableEq OrthogonalActor :=
  fun a b => decidable_of_iff (a.left = b.left ∧ a.right = b.right)
    RegularWreathProduct.ext_iff.symm
private instance : Fintype OrthogonalActor :=
  Fintype.ofEquiv ((OrthogonalPlaneIndex → OrthogonalPlaneActor) × OrthogonalPlaneIndex)
    (RegularWreathProduct.equivProd _ _).symm

def fixedSet (p : OrthogonalActor) : Finset OrthogonalVector :=
  Finset.univ.filter fun v => p • v = v

def generatedFixedSet (p q : OrthogonalActor) : Finset OrthogonalVector :=
  fixedSet p * fixedSet q * fixedSet (p * q)

set_option synthInstance.maxSize 4096 in
set_option maxRecDepth 10000 in
set_option maxHeartbeats 1000000 in
theorem pair_calculation :
    ∀ p q : DihedralGroup 4,
      p ^ 2 = 1 → q ^ 2 = 1 → p * q = q * p →
      p ≠ 1 → q ≠ 1 → p ≠ q →
      (generatedFixedSet (wreathTwoDihedralHom p) (wreathTwoDihedralHom q)).card = 16 ∨
      ((generatedFixedSet (wreathTwoDihedralHom p) (wreathTwoDihedralHom q)).card = 8 ∧ (fixedSet (wreathTwoDihedralHom p) ∩ fixedSet (wreathTwoDihedralHom q)).card = 2) := by
  decide +kernel
end CFSG.Quasithin.Chapter15.Section03.FusionCore.Centralization.CoreGeometry

namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.Centralization.CoreGeometry
open Subgroup ChapterE
open scoped Pointwise IsMulCommutative
attribute [local instance] orthogonalAction

/-- Vectors fixed by one specified coordinate actor. -/
def fixedSubgroup (p : OrthogonalActor) : Subgroup OrthogonalVector where
  carrier := {v | p • v = v}
  one_mem' := smul_one p
  mul_mem' := by
    intro v w hv hw
    change p • v = v at hv
    change p • w = w at hw
    change p • (v * w) = v * w
    rw [smul_mul', hv, hw]
  inv_mem' := by
    intro v hv
    change p • v = v at hv
    change p • v⁻¹ = v⁻¹
    rw [smul_inv', hv]

/-- The subgroup generated by the fixed groups of a Klein four's three involutions. -/
def generatedFixedSubgroup (p q : OrthogonalActor) : Subgroup OrthogonalVector :=
  fixedSubgroup p ⊔ fixedSubgroup q ⊔ fixedSubgroup (p * q)

private theorem mem_fixedSet (p : OrthogonalActor) (v : OrthogonalVector) :
    v ∈ fixedSet p ↔ v ∈ fixedSubgroup p := by simp [fixedSet, fixedSubgroup]

private theorem mem_generatedFixedSet (p q : OrthogonalActor) (v : OrthogonalVector) :
    v ∈ generatedFixedSet p q ↔ v ∈ generatedFixedSubgroup p q := by
  simp only [generatedFixedSet, generatedFixedSubgroup, Finset.mem_mul,
    Subgroup.mem_sup, mem_fixedSet]

private theorem card_generatedFixedSubgroup (p q : OrthogonalActor) :
    Nat.card (generatedFixedSubgroup p q) = (generatedFixedSet p q).card := by
  calc
    _ = Nat.card (generatedFixedSet p q) := Nat.card_congr
      (Equiv.subtypeEquivRight fun v => (mem_generatedFixedSet p q v).symm)
    _ = _ := Nat.card_eq_finsetCard _

private theorem card_fixedSubgroup_inf (p q : OrthogonalActor) :
    Nat.card (fixedSubgroup p ⊓ fixedSubgroup q : Subgroup OrthogonalVector) =
      (fixedSet p ∩ fixedSet q).card := by
  calc
    _ = Nat.card ↥(fixedSet p ∩ fixedSet q) := Nat.card_congr
      (Equiv.subtypeEquivRight fun v => by
        simp only [Finset.mem_inter, mem_inf, mem_fixedSet])
    _ = _ := Nat.card_eq_finsetCard _

private theorem imageAction_zpowers (J : Subgroup OrthogonalActor) (p : J) :
    actionCentralizer (imageAction J) (zpowers p) = fixedSubgroup p := by
  ext v
  constructor
  · intro hv
    exact hv p (mem_zpowers p)
  · intro hv x hx
    have hle : zpowers p ≤ (MulAction.stabilizer OrthogonalActor v).comap J.subtype :=
      zpowers_le.mpr hv
    exact hle hx

private theorem pair_cases {J : Subgroup OrthogonalActor} [IsKleinFour J]
    (p q : J) (hp : p ≠ 1) (hq : q ≠ 1) (hpq : p ≠ q) (x : J) :
    x = p * q ∨ x = p ∨ x = q ∨ x = 1 := by
  classical
  let _ := Fintype.ofFinite J
  have hx : x ∈ ({p * q, p, q, 1} : Finset J) := by
    rw [IsKleinFour.eq_finset_univ hp hq hpq]
    exact Finset.mem_univ x
  simpa only [Finset.mem_insert, Finset.mem_singleton] using hx

private theorem imageCore_eq_generated {J : Subgroup OrthogonalActor}
    [IsElementaryAbelian 2 J] [IsKleinFour J]
    (p q : J) (hp : p ≠ 1) (hq : q ≠ 1) (hpq : p ≠ q) :
    imageCore J = generatedFixedSubgroup p q := by
  have he := dualGeneratedCore_eq_involution_fixed (imageAction J)
    (by rw [IsKleinFour.card_four]; decide)
  have hlog : Nat.log 2 (Nat.card J) - 1 = 1 := by
    rw [IsKleinFour.card_four]; decide
  rw [hlog] at he
  change imageCore J = _ at he
  rw [he]
  unfold generatedFixedSubgroup
  apply le_antisymm
  · apply iSup_le
    intro x
    apply iSup_le
    intro hx
    rw [imageAction_zpowers]
    rcases pair_cases p q hp hq hpq x with rfl | rfl | rfl | rfl
    · exact le_sup_right
    · exact le_sup_left.trans le_sup_left
    · exact le_sup_right.trans le_sup_left
    · simp at hx
  · apply sup_le
    · apply sup_le
      · rw [← imageAction_zpowers J p]
        exact le_iSup_of_le p (le_iSup_of_le (orderOf_eq_prime
          (by simpa only [pow_two] using IsKleinFour.mul_self p) hp) le_rfl)
      · rw [← imageAction_zpowers J q]
        exact le_iSup_of_le q (le_iSup_of_le (orderOf_eq_prime
          (by simpa only [pow_two] using IsKleinFour.mul_self q) hq) le_rfl)
    · rw [show (p : OrthogonalActor) * q = (p * q : J) from rfl,
        ← imageAction_zpowers J (p * q)]
      have hpq1 : p * q ≠ 1 := by
        intro hh
        exact hpq (by simpa only [IsKleinFour.inv_eq_self] using mul_eq_one_iff_eq_inv.mp hh)
      exact le_iSup_of_le (p * q) (le_iSup_of_le (orderOf_eq_prime
        (by simpa only [pow_two] using IsKleinFour.mul_self (p * q)) hpq1) le_rfl)

private theorem imageFixed_eq_pair {J : Subgroup OrthogonalActor} [IsKleinFour J]
    (p q : J) (hp : p ≠ 1) (hq : q ≠ 1) (hpq : p ≠ q) :
    actionCentralizer (imageAction J) ⊤ = fixedSubgroup p ⊓ fixedSubgroup q := by
  ext v
  constructor
  · intro hv; exact ⟨hv p (mem_top _), hv q (mem_top _)⟩
  · rintro ⟨hv, hw⟩ x _
    rcases pair_cases p q hp hq hpq x with rfl | rfl | rfl | rfl
    · change ((p : OrthogonalActor) * q) • v = v
      rw [mul_smul, show (q : OrthogonalActor) • v = v from hw,
        show (p : OrthogonalActor) • v = v from hv]
    · exact hv
    · exact hw
    · change (1 : OrthogonalActor) • v = v
      exact one_smul _ _

end CFSG.Quasithin.Chapter15.Section03.FusionCore.Centralization.CoreGeometry

namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.Centralization.CoreGeometry
open Subgroup ChapterE
open scoped Pointwise IsMulCommutative
attribute [local instance] orthogonalAction

private theorem exists_pair (J : Subgroup OrthogonalActor) (hJ : Nat.card J = 4) :
    ∃ p q : J, p ≠ 1 ∧ q ≠ 1 ∧ p ≠ q := by
  classical
  let _ := Fintype.ofFinite J
  have hc : Fintype.card J = 4 := by rwa [← Nat.card_eq_fintype_card]
  obtain ⟨p, hp⟩ := Fintype.exists_ne_of_one_lt_card (by omega : 1 < Fintype.card J) (1 : J)
  have hq : ∃ q : J, q ≠ 1 ∧ q ≠ p := by
    by_contra hn
    push Not at hn
    have hs : (Finset.univ : Finset J) ⊆ {1, p} := by
      intro q _
      simp only [Finset.mem_insert, Finset.mem_singleton]
      by_cases h : q = 1
      · exact Or.inl h
      · exact Or.inr (hn q h)
    have hh := Finset.card_le_card hs
    simp [Ne.symm hp, hc] at hh
  obtain ⟨q, hq, hqp⟩ := hq
  exact ⟨p, q, hp, hq, hqp.symm⟩

/-- The complete fixed-space alternative inside the standard dihedral Sylow. -/
theorem standard_core_alternative (J : Subgroup OrthogonalActor)
    [IsElementaryAbelian 2 J] (hJ : Nat.card J = 4)
    (hstd : J ≤ wreathTwoDihedralHom.range) :
    imageCore J = ⊤ ∨
      (Nat.card (imageCore J) = 8 ∧
       Nat.card (imageCore J ⊓ actionCentralizer (imageAction J) ⊤ :
         Subgroup OrthogonalVector) = 2) := by
  classical
  let _ := Fintype.ofFinite J
  let _ : Nontrivial J := Fintype.one_lt_card_iff_nontrivial.mp
    (by rw [← Nat.card_eq_fintype_card, hJ]; decide)
  let _ : IsKleinFour J := ⟨hJ, IsElementaryAbelian.exponent_eq_prime⟩
  obtain ⟨p, q, hp, hq, hpq⟩ := exists_pair J hJ
  obtain ⟨x, hx⟩ := hstd p.property
  obtain ⟨y, hy⟩ := hstd q.property
  have hpsq : p ^ 2 = 1 := by simpa only [pow_two] using IsKleinFour.mul_self p
  have hqsq : q ^ 2 = 1 := by simpa only [pow_two] using IsKleinFour.mul_self q
  have hx2 : x ^ 2 = 1 := by
    apply wreathTwoDihedralHom_injective
    rw [map_pow, map_one, hx]
    exact congrArg (fun z : J => (z : OrthogonalActor)) hpsq
  have hy2 : y ^ 2 = 1 := by
    apply wreathTwoDihedralHom_injective
    rw [map_pow, map_one, hy]
    exact congrArg (fun z : J => (z : OrthogonalActor)) hqsq
  have hxy : x * y = y * x := by
    apply wreathTwoDihedralHom_injective
    rw [map_mul, map_mul, hx, hy]
    exact congrArg (fun z : J => (z : OrthogonalActor)) (mul_comm p q)
  have hx1 : x ≠ 1 := by
    intro h
    apply hp
    apply Subtype.ext
    change (p : OrthogonalActor) = 1
    simpa only [h, map_one] using hx.symm
  have hy1 : y ≠ 1 := by
    intro h
    apply hq
    apply Subtype.ext
    change (q : OrthogonalActor) = 1
    simpa only [h, map_one] using hy.symm
  have hxyne : x ≠ y := by
    intro h
    apply hpq
    apply Subtype.ext
    rw [← hx, ← hy, h]
  have hcalc := pair_calculation x y hx2 hy2 hxy hx1 hy1 hxyne
  rw [hx, hy, ← card_generatedFixedSubgroup, ← card_fixedSubgroup_inf] at hcalc
  have hcore := imageCore_eq_generated p q hp hq hpq
  have hfixed := imageFixed_eq_pair p q hp hq hpq
  have hsub : fixedSubgroup (p : OrthogonalActor) ⊓ fixedSubgroup q ≤
      generatedFixedSubgroup p q :=
    inf_le_left.trans (le_sup_left.trans le_sup_left)
  rcases hcalc with hfull | ⟨he, hf⟩
  · left
    rw [hcore]
    apply Subgroup.eq_top_of_card_eq
    rw [hfull]
    norm_num [OrthogonalVector, OrthogonalPlaneIndex, OrthogonalPlaneVector,
      Nat.card_eq_fintype_card]
  · right
    rw [hcore, hfixed, inf_eq_right.mpr hsub]
    exact ⟨he, hf⟩

end CFSG.Quasithin.Chapter15.Section03.FusionCore.Centralization.CoreGeometry

namespace CFSG.Quasithin.Chapter15.Section03.FusionCore.Centralization.CoreGeometry
open Subgroup ChapterE

/-- The standard calculation holds in every Sylow subgroup, using actual conjugacy
and the matching vector automorphism. -/
theorem coordinate_core_alternative (J : Subgroup OrthogonalActor)
    [IsElementaryAbelian 2 J] (hJ : Nat.card J = 4) :
    imageCore J = ⊤ ∨
      (Nat.card (imageCore J) = 8 ∧
       Nat.card (imageCore J ⊓ actionCentralizer (imageAction J) ⊤ :
         Subgroup OrthogonalVector) = 2) := by
  obtain ⟨P, hJP⟩ := (IsElementaryAbelian.isPGroup 2 J).exists_le_sylow
  obtain ⟨a, ha⟩ := MulAction.exists_smul_eq OrthogonalActor P wreathTwoSylow
  have hmap : (P : Subgroup OrthogonalActor).map (MulAut.conj a).toMonoidHom =
      (wreathTwoSylow : Subgroup OrthogonalActor) :=
    congrArg (fun Q : Sylow 2 OrthogonalActor => (Q : Subgroup OrthogonalActor)) ha
  let K := J.map (MulAut.conj a).toMonoidHom
  let _ : IsElementaryAbelian 2 K := IsElementaryAbelian.map _
  have hK : Nat.card K = 4 := by
    rw [card_map_of_injective (MulAut.conj a).injective]
    exact hJ
  have hstd : K ≤ wreathTwoDihedralHom.range := by
    rw [← wreathTwoSylow_coe, ← hmap]
    exact map_mono hJP
  rcases standard_core_alternative K hK hstd with hfull | ⟨he, hf⟩
  · left
    apply map_injective (f := (coordinateAction a).toMonoidHom)
      (coordinateAction a).injective
    rw [imageCore_conjugate, show imageCore (J.map (MulAut.conj a).toMonoidHom) = ⊤ from hfull,
      map_top_of_surjective (coordinateAction a).toMonoidHom (coordinateAction a).surjective]
  · right
    change Nat.card (imageCore (J.map (MulAut.conj a).toMonoidHom)) = 8 at he
    rw [← imageCore_conjugate, card_map_of_injective (f := (coordinateAction a).toMonoidHom) (coordinateAction a).injective] at he
    change Nat.card (imageCore (J.map (MulAut.conj a).toMonoidHom) ⊓
      actionCentralizer (imageAction (J.map (MulAut.conj a).toMonoidHom)) ⊤ :
      Subgroup OrthogonalVector) = 2 at hf
    rw [← imageCore_conjugate, ← imageFixed_conjugate,
      ← map_inf _ _ (coordinateAction a).toMonoidHom (coordinateAction a).injective,
      card_map_of_injective (f := (coordinateAction a).toMonoidHom) (coordinateAction a).injective] at hf
    exact ⟨he, hf⟩

/-- A proper core excludes the base Klein four, leaving core order eight and
exactly two fixed vectors in the core. -/
theorem coordinate_core_sizes (J : Subgroup OrthogonalActor)
    [IsElementaryAbelian 2 J] (hJ : Nat.card J = 4) (hproper : imageCore J ≠ ⊤) :
    Nat.card (imageCore J) = 8 ∧
      Nat.card (imageCore J ⊓ actionCentralizer (imageAction J) ⊤ :
        Subgroup OrthogonalVector) = 2 :=
  (coordinate_core_alternative J hJ).resolve_left hproper
end CFSG.Quasithin.Chapter15.Section03.FusionCore.Centralization.CoreGeometry
