module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.WeakClosure.Setup
public import CFSG.Quasithin.ChapterE.Section03.Offenders.Basic
public import CFSG.Quasithin.ChapterE.Section03.Offenders.Transport.Foundations
public import Theory.GroupTheory.WeakClosureFrattini
public import Theory.GroupTheory.TwoLocalUniquenessControl
public import Stellmacher.SectionThree.LemmaThreeSeven

/-!
# Consequences of centralizing the zeroth weak closure

Centralization of the actual `W₀(T,V)` makes the actual minimum `w(G,V)`
positive. Sylow transport then controls every conjugate of `V` in `N_G(V)`.
The Frattini argument is carried out inside `M`, where `C_M(V)` is normal;
it yields `M = N_M(W₀) C_M(V)`.

The source generation `V = ⟨Z^M⟩` excludes `M ≤ C_G(V)T`: both factors
centralize `Z = C_V(T)`, which would force `V ≤ Z`. Consequently the
two-residual of `N_M(W₀)` acts nontrivially on `V`. The actual dichotomy
15.3.2(4) gives uniqueness, and two-local maximality bounds `N_G(W₀)`.

These prove the deductions after the two-case centralization argument in
15.3.46(4). Centralization itself remains an explicit input.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), printed p.1141.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter15.Section03.FusionCore

open Subgroup
open scoped IsMulCommutative

variable {G : Type*} [Group G]

/-- It suffices to centralize each whole conjugate occurring among the generators. -/
theorem weakClosure_zero_le_centralizer_iff (V T : Subgroup G) :
    ChapterE.indexedWeakClosure V T 0 ≤ centralizer (V : Set G) ↔
      ∀ g : G, V.map (MulAut.conj g).toMonoidHom ≤ T →
        V.map (MulAut.conj g).toMonoidHom ≤ centralizer (V : Set G) := by
  constructor
  · intro h g hg
    exact (ChapterE.gamma_le_weakClosure
      ((ChapterE.mem_gamma_zero_iff V T _).mpr ⟨g, rfl, hg⟩)).trans h
  · intro h
    rw [ChapterE.weakClosure_eq_sSup_gamma]
    apply sSup_le
    intro A hA
    obtain ⟨g, rfl, hg⟩ := (ChapterE.mem_gamma_zero_iff V T A).mp hA
    exact h g hg

/-- Positivity concerns the actual extended-natural minimum, including infinity. -/
theorem globalW_pos_of_weakClosure_zero {V T : Subgroup G}
    (hW : ChapterE.indexedWeakClosure V T 0 ≤ centralizer (V : Set G)) :
    0 < ChapterE.globalW V T := by
  apply lt_of_le_of_ne bot_le
  intro h
  obtain ⟨g, hgT, hgC⟩ := (ChapterE.globalW_eq_zero_iff V T).mp h.symm
  exact hgC ((weakClosure_zero_le_centralizer_iff V T).mp hW g hgT)

/-- Frattini inside `M`; normality of its relative centralizer is derived
from its action on `V`, without assuming ambient normality. -/
theorem weakClosure_zero_frattini [Finite G] (M V : Subgroup G) (T : Sylow 2 G)
    (hTM : (T : Subgroup G) ≤ M) (hMN : M ≤ normalizer (V : Set G))
    (hW : ChapterE.indexedWeakClosure V T 0 ≤ centralizer (V : Set G)) :
    (M ⊓ normalizer (ChapterE.indexedWeakClosure V T 0 : Set G)) ⊔
      (M ⊓ centralizer (V : Set G)) = M := by
  let W := ChapterE.indexedWeakClosure V T 0
  have hWT : W ≤ (T : Subgroup G) := ChapterE.indexedWeakClosure_le V T 0
  have hWM : W ≤ M := hWT.trans hTM
  have hCN : M ≤ normalizer (centralizer (V : Set G) : Set G) :=
    hMN.trans (le_normalizer_of_normal_subgroupOf (Subgroup.centralizer_le_normalizer _))
  let : ((centralizer (V : Set G)).subgroupOf M).Normal :=
    normal_subgroupOf_of_le_normalizer hCN
  have hweak : ∀ m : M,
      (W.subgroupOf M).map (MulAut.conj m).toMonoidHom ≤
        (T.subtype hTM : Subgroup M) →
      (W.subgroupOf M).map (MulAut.conj m).toMonoidHom = W.subgroupOf M := by
    intro m hm
    have hcomp : M.subtype.comp (MulAut.conj m).toMonoidHom =
        (MulAut.conj (m : G)).toMonoidHom.comp M.subtype := by ext x; rfl
    have hmG := map_mono (f := M.subtype) hm
    rw [map_map, hcomp, ← map_map, map_subgroupOf_eq_of_le hWM,
      Sylow.coe_subtype, map_subgroupOf_eq_of_le hTM] at hmG
    have he := ChapterE.weakClosure_weakly_closed V T 0 (m : G) hmG
    apply Subgroup.map_injective M.subtype_injective
    rw [map_map, hcomp, ← map_map, map_subgroupOf_eq_of_le hWM]
    exact he
  have hf := normalizer_sup_eq_top_of_weakly_closed (T.subtype hTM)
    ((centralizer (V : Set G)).subgroupOf M) (W.subgroupOf M)
    (show W.subgroupOf M ≤ (T.subtype hTM : Subgroup M) from fun _ hx => hWT hx)
    (fun _ hx => hW hx) hweak
  have hfG := congrArg (fun H : Subgroup M => H.map M.subtype) hf
  rw [Subgroup.map_sup, ← subgroupOf_normalizer_eq hWM, subgroupOf_map_subtype,
    subgroupOf_map_subtype, ← MonoidHom.range_eq_map, M.range_subtype] at hfG
  simpa only [inf_comm] using hfG

/-- The source module is generated by conjugates of `Z`. Its larger order
excludes a centralizer–Sylow supplement, without an actor-order assumption. -/
theorem not_le_centralizer_sup_sylow [Finite G] (T : Sylow 2 G) (M V : Subgroup G)
    (hV : V = localModule T M)
    (hfixed : centralInvolutions T = fixedPlane V T)
    (hcard : Nat.card (centralInvolutions T) < Nat.card V) :
    ¬ M ≤ centralizer (V : Set G) ⊔ (T : Subgroup G) := by
  intro hM
  have hZV : centralInvolutions T ≤ V := hfixed.le.trans inf_le_left
  have hTZ : (T : Subgroup G) ≤ centralizer (centralInvolutions T : Set G) :=
    le_centralizer_iff.mpr (hfixed.le.trans inf_le_right)
  have hMC : M ≤ centralizer (centralInvolutions T : Set G) :=
    hM.trans (sup_le (centralizer_le hZV) hTZ)
  have hVZ : V ≤ centralInvolutions T := by
    rw [hV]
    exact conjugateSpanBy_le le_rfl (hMC.trans (Subgroup.centralizer_le_normalizer _))
  have hc := Nat.card_le_card_of_injective (Subgroup.inclusion hVZ)
    (Subgroup.inclusion_injective hVZ)
  omega

private theorem residual_sup_sylow [Finite G] (T : Sylow 2 G) {X : Subgroup G}
    (hTX : (T : Subgroup G) ≤ X) :
    Stellmacher.twoResidualAmbient X ⊔ (T : Subgroup G) = X := by
  apply Stellmacher.SectionThree.twoResidual_sup_sylowImage
  exact ⟨T.subtype hTX, by rw [Sylow.coe_subtype, map_subgroupOf_eq_of_le hTX]⟩

/-- Frattini and 15.3.2(4) bound the full normalizer of the nontrivial weak closure. -/
theorem normalizer_weakClosure_zero_le [Finite G]
    (M V : Subgroup G) (T : Sylow 2 G)
    (hVT : V ≤ T) (hVne : V ≠ ⊥)
    (hTM : (T : Subgroup G) ≤ M) (hMN : M ≤ normalizer (V : Set G))
    (hnot : ¬ M ≤ centralizer (V : Set G) ⊔ (T : Subgroup G))
    (h24 : ResidualUniquenessDichotomy T M V)
    (hW : ChapterE.indexedWeakClosure V T 0 ≤ centralizer (V : Set G)) :
    normalizer (ChapterE.indexedWeakClosure V T 0 : Set G) ≤ M := by
  let W := ChapterE.indexedWeakClosure V T 0
  let X := M ⊓ normalizer (W : Set G)
  have hTX : (T : Subgroup G) ≤ X := le_inf hTM
    (le_normalizer.trans (ChapterE.normalizer_le_weakClosure_normalizer V T 0))
  have hgen : X ⊔ (M ⊓ centralizer (V : Set G)) = M :=
    weakClosure_zero_frattini M V T hTM hMN hW
  have hres : ¬ Stellmacher.twoResidualAmbient X ≤ M ⊓ centralizer (V : Set G) := by
    intro h
    apply hnot
    rw [← hgen]
    refine sup_le ?_ (inf_le_right.trans le_sup_left)
    rw [← residual_sup_sylow T hTX]
    exact sup_le (h.trans (inf_le_right.trans le_sup_left)) le_sup_right
  have hu := (h24 X hTX inf_le_left).resolve_left hres
  have hWp : IsPGroup 2 W := T.isPGroup'.to_le (ChapterE.indexedWeakClosure_le V T 0)
  have hWne : W ≠ ⊥ := by
    intro h
    exact hVne (le_bot_iff.mp (h ▸ ChapterE.self_le_weakClosure_zero hVT))
  exact normalizer_le_of_unique_maximalTwoLocal hu.2.2.2 hWp hWne inf_le_right

/-- Sylow transport gives the source's assertion `Vᴳ ∩ M ⊆ C_G(V)`. -/
theorem conjugate_in_M_le_centralizer_of_weakClosure_zero [Finite G]
    {M V : Subgroup G} [IsElementaryAbelian 2 V]
    (T : Sylow 2 G) (hTM : (T : Subgroup G) ≤ M)
    (hM : M = normalizer (V : Set G))
    (hW : ChapterE.indexedWeakClosure V T 0 ≤ centralizer (V : Set G))
    (g : G) (hg : V.map (MulAut.conj g).toMonoidHom ≤ M) :
    V.map (MulAut.conj g).toMonoidHom ≤ centralizer (V : Set G) := by
  exact ChapterE.conjugate_le_centralizer_of_normalizes_of_weakClosure_zero
    (hTM.trans hM.le) hW g (hg.trans hM.le)

end CFSG.Quasithin.Chapter15.Section03.FusionCore
