module

public import CFSG.Quasithin.Chapter15.Section03.TerminalRecognition.Cases.Intersection.LowRows
public import CFSG.Quasithin.Chapter15.Section03.TerminalRecognition.Cases.Intersection.SourceClassifications
public import CFSG.Quasithin.Chapter15.Section04.Configuration.LocalSetup.TwoFactors.FFBranch.Recognition.ClassificationComparison.ExhaustiveSource

/-!
# Source-correct terminal low-row comparison

The F.6.18 reduction is applied to the original local images and the original
quotient Sylow.  Its S₃ × S₃ row already identifies the Thompson image.  The
extraspecial row is excluded from the corrected B.5.6 alternatives using only
the actual offender actor, while the product row is excluded by the prime
support estimate for the projective-line and group-only outer alternatives.

The projective-line branch keeps the corrected two-dimensional F₄ convention;
the outer branch uses only its literal A₆ and C₃ factors, their product and the
cyclic quotient generated by the outer element.  No legacy fixed-space or
whole-module splitting assertion is introduced.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), final proof of
15.3.1, printed p.1155; F.6.16–18, pp.308–310; B.5.1/B.5.6, pp.99–105;
K.1.3, p.453.
-/

public section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative

namespace CFSG.Quasithin.Chapter15.Section03.TerminalRecognition.Intersection
open CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GoldschmidtCore.Centrality.Semilinear.Recognition
open CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison

namespace SourceInput
variable {H : Type*} [Group H] [Finite H] {V : Subgroup H}
  [IsElementaryAbelian 2 (moduleClosure V)] (d : SourceInput V)

private theorem quasisimple_not_solvable {A : Type*} [Group A]
    (h : IsQuasisimple A) : ¬ Group.IsSolvable A := by
  let : IsQuasisimple A := h
  let : IsSimpleGroup (A ⧸ center A) := h.simple
  let : Nontrivial A := (QuotientGroup.mk'_surjective (center A)).nontrivial
  exact Group.IsPerfect.not_isSolvable A

private theorem no_extraspecial_row_of_projectiveLine_alternative
    (N : Subgroup (coreQuotient H)) [N.Normal] [IsExtraspecial 3 N]
    (hN : Nat.card N = 27)
    (q : Nonempty ((coreQuotient H ⧸ N) ≃* FSource.E4))
    (hB : FFAlternatives.ProjectiveLine.SourceAlternative d.offenderAction) : False := by
  have hD : Nat.card (coreQuotient H) = 108 := by
    obtain ⟨e⟩ := q
    rw [card_eq_card_quotient_mul_card_subgroup N, Nat.card_congr e.toEquiv, hN]
    norm_num [FSource.E4, FSource.C]
  have hi : Nat.card d.offenderGroup ≤ 108 := by
    rw [← hD]
    exact Nat.card_le_card_of_injective d.offenderGroup.subtype
      d.offenderGroup.subtype_injective
  cases hB.toAdequate d.offenderAction with
  | trivial h =>
    let : Subsingleton d.offenderGroup := h
    apply d.offender_ne_bot
    apply le_bot_iff.mp
    intro x hx
    exact Subgroup.mem_bot.mpr
      (congrArg Subtype.val (Subsingleton.elim (⟨x, hx⟩ : d.offenderGroup) 1))
  | quasisimple hq _ =>
    let : Group.IsNilpotent N := (IsExtraspecial.isPGroup 3 N).isNilpotent
    have hQ : IsPGroup 2 (coreQuotient H ⧸ N) := by
      obtain ⟨e⟩ := q
      have hE : IsPGroup 2 FSource.E4 := IsPGroup.of_card (n := 2) (by
        simp [FSource.E4, FSource.C])
      exact hE.of_equiv e.symm
    let : Group.IsNilpotent (coreQuotient H ⧸ N) := hQ.isNilpotent
    let : Group.IsSolvable (coreQuotient H) :=
      (Group.isSolvable_iff_subgroup_quotient N).mpr ⟨inferInstance, inferInstance⟩
    exact quasisimple_not_solvable hq inferInstance
  | symmetricThree c =>
    exact d.no_symmetricThree_offender_of_extraspecial_row N q c.equiv
  | twoFactors c =>
    obtain ⟨e⟩ := LowRows.Extraspecial.product_equiv_symmetricThreePair c.product
      (c.firstCase.factorModel _) (c.secondCase.factorModel _) hi
    exact d.no_symmetricThreePair_offender_of_extraspecial_row N q e
  | outerSixThree c =>
    exact d.no_outerSixThreeShape_of_extraspecial_row N hN q c
  | hyperplane c =>
    have hh := (Nat.card_le_card_of_injective c.first.subtype c.first.subtype_injective).trans hi
    rw [Nat.card_congr c.firstEquiv.toEquiv, Matrix.PSL3Two.card_SL] at hh
    omega

private theorem no_extraspecial_row_of_sourceFFAlternative
    (N : Subgroup (coreQuotient H)) [N.Normal] [IsExtraspecial 3 N]
    (hN : Nat.card N = 27)
    (q : Nonempty ((coreQuotient H ⧸ N) ≃* FSource.E4))
    (hB : SourceFFAlternative d.offenderAction) : False := by
  rcases hB with hB | hshape
  · exact d.no_extraspecial_row_of_projectiveLine_alternative N hN q hB
  · obtain ⟨c⟩ := hshape
    exact d.no_outerSixThreeShape_of_extraspecial_row N hN q c

private theorem no_primeProduct_row_of_sourceFFAlternative
    (c : FSource.ProductRow d.quotientSylow)
    (hs : Nonempty (d.quotientSylow ≃* DihedralGroup 4))
    (hB : SourceFFAlternative d.offenderAction) : False := by
  have bound : ∀ p : ℕ, p.Prime → p ∣ Nat.card d.offenderGroup → p ≤ 7 := by
    rcases hB with hB | hshape
    · exact LowRows.PrimeProduct.FFSpectrum.prime_le_seven_projectiveLine
        d.offenderAction d.primeProduct_offender_generated
        (d.primeProduct_no_sixteen_dvd_offender hs) hB
    · obtain ⟨c⟩ := hshape
      exact fun p hp hd => LowRows.PrimeProduct.FFSpectrum.outerShape_prime_le_seven
        d.offenderAction d.primeProduct_offender_generated c hp hd
  exact d.no_primeProduct_row_of_offender_prime_bound c hs bound

/-- The corrected source alternatives force the actual Thompson image to be
S₃ whenever the ambient generalized Fitting subgroup is not quasisimple. -/
theorem source_thompson_symmetricThree_of_nonquasisimple
    (hF : FSource.Alternative (d.G1.map coreProjection) (d.G2.map coreProjection)
        d.quotientSylow ∨
      FSource.Alternative (d.G2.map coreProjection) (d.G1.map coreProjection)
        d.quotientSylow)
    (hB : SourceFFAlternative d.offenderAction)
    (hnot : ¬ IsQuasisimple (generalizedFitting (coreQuotient H))) :
    Nonempty ((thompsonGroup H).map coreProjection ≃* Equiv.Perm (Fin 3)) := by
  rcases d.symmetricThree_or_remaining_low_rows hF hnot with he | h
  · exact he
  · cases h with
    | extraspecial N hnormal hextraspecial hcard _ hquotient =>
      let : N.Normal := hnormal
      let : IsExtraspecial 3 N := hextraspecial
      exact (d.no_extraspecial_row_of_sourceFFAlternative N hcard hquotient hB).elim
    | product data hs hl =>
      exact (d.no_primeProduct_row_of_sourceFFAlternative data hs hB).elim

end SourceInput
end CFSG.Quasithin.Chapter15.Section03.TerminalRecognition.Intersection
