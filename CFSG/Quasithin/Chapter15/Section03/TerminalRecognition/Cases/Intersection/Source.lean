module

public import CFSG.Quasithin.Chapter15.Section03.TerminalRecognition.Cases.Reductions
public import CFSG.Quasithin.Chapter15.Section03.TerminalRecognition.ExceptionalAction.Recognition.ActionRecognition.Thompson
public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GoldschmidtCore.Centrality.Semilinear.Recognition.FSource

/-!
# Source inputs before the terminal classification intersection

The intrinsic configuration is the one on printed pp.1154–1155, with
H = G₀ and both local factors embedded in H. In contrast to the later
exceptional-action input, it does not assume the residual identity for
J(H). The escape of X_E from O₂(H) gives a nonzero Thompson image and
an actual offender on the conjugate-span module.

The classifications are applied to their proper actors: F.6.18 on H/O₂(H),
using O₃′(H) = O₂(H), and B.5.6 on the subgroup generated by best offenders
on V₀. The B-side retains the full action conclusions. The existing
FSource interface retains all thirteen rows; its extraspecial row records
an extension but forgets the particular action. Applicability here is valid
for that weaker consequence too. A row comparison using it must either
work uniformly on that input or recover the specified extension action.
This module only proves applicability, not the intersection. No common-core
equality from the problematic proof of 15.3.68(2) is used.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), 15.3.66–68
and the final proof of 15.3.1, printed pp.1152–1155; F.6.18, pp.309–310,
and B.5.3/B.5.6, pp.104–105.
-/

@[expose] public section
open Subgroup Representation.BinaryOffender
open scoped IsMulCommutative

namespace CFSG.Quasithin.Chapter15.Section03.TerminalRecognition.Intersection

open CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GoldschmidtCore.Centrality.Semilinear.Recognition
open CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison
open FFAlternatives

universe u
variable {H : Type u} [Group H] [Finite H]

/-- The genuine pre-intersection data; no Thompson residual or model is assumed. -/
structure SourceInput (V : Subgroup H) where
  T : Sylow 2 H
  YF : Subgroup H
  XE : Subgroup H
  G1 : Subgroup H
  G2 : Subgroup H
  R : Subgroup H
  F : Subgroup H
  /-- Definitions immediately before 15.3.68. -/
  first_local : G1 = YF ⊔ (T : Subgroup H)
  second_local : G2 = XE ⊔ (T : Subgroup H)
  generated : G1 ⊔ G2 = ⊤
  common_sylow : G1 ⊓ G2 = (T : Subgroup H)
  first_quotient : Nonempty (G1 ⧸ pCore 2 G1 ≃* Equiv.Perm (Fin 3))
  second_quotient : Nonempty (G2 ⧸ pCore 2 G2 ≃* Equiv.Perm (Fin 3))
  /-- Relative normality inherited from 15.3.67(3) and its conjugate. -/
  first_normalized : G1 ≤ normalizer (YF : Set H)
  second_normalized : G2 ≤ normalizer (XE : Set H)
  /-- The residuals defining the local odd factors. -/
  first_perfect : IsPPerfect 2 YF
  second_perfect : IsPPerfect 2 XE
  first_residual : (pResidual 2 G1).map G1.subtype = YF
  second_residual : (pResidual 2 G2).map G2.subtype = XE
  /-- The cyclic quotients in 15.3.67(3), also transported to `Y_F`. -/
  first_odd_quotient : Nonempty (YF ⧸ pCore 2 YF ≃* Multiplicative (ZMod 3))
  second_odd_quotient : Nonempty (XE ⧸ pCore 2 XE ≃* Multiplicative (ZMod 3))
  /-- The genuine centralizer identities from 15.3.67(1). -/
  centralizer_eq : R = centralizer (V : Set H)
  sylow_centralizer_eq : R = (T : Subgroup H) ⊓ centralizer (V : Set H)
  /-- 15.3.68(2), with the other half of centrality following from the bound below. -/
  vector_le_core : V ≤ pCore 2 H
  /-- The bound explicitly used in the final paragraph on p.1155. -/
  core_bound : pCore 2 H ⊔ YF.pCoreIn 2 ≤ R
  /-- 15.3.68(5). -/
  three_prime_core : pPrimeCore 3 H = pCore 2 H
  /-- The escape in 15.3.67(3), since O₂(H) lies in T_E ≤ M. -/
  second_escape : ¬ XE ≤ pCore 2 H
  /-- 15.3.67(4) and `J(T_E) = J(R)` from its proof. -/
  second_commutator : XE = ⁅XE, Stellmacher.elementaryAbelianMaxJ (T : Subgroup H)⁆
  sylow_thompson : Stellmacher.elementaryAbelianMaxJ (T : Subgroup H) =
    Stellmacher.elementaryAbelianMaxJ R
  /-- The normality used at the top of p.1155. -/
  thompson_normalized : G1 ≤
    normalizer (Stellmacher.elementaryAbelianMaxJ (T : Subgroup H) : Set H)
  /-- The conjugate of 15.3.66(5). -/
  vector_commutator : V = ⁅V, YF⁆
  /-- The standing natural orthogonal module has order sixteen. -/
  vector_card : Nat.card V = 16
  /-- The marked commutator used in the final exclusion. -/
  local_commutator : ⁅V, G1.pCoreIn 2⁆ = F
  singular_nontrivial : F ≠ ⊥

namespace SourceInput
variable {V : Subgroup H} (d : SourceInput V)
include d

/-- The marked pair is the source Goldschmidt triple. -/
theorem goldschmidt : ChapterF.IsGoldschmidtTriple d.G1 d.G2 :=
  ⟨d.generated, d.first_quotient, d.second_quotient, d.T, d.common_sylow⟩

omit [Finite H] in
/-- The centralizer is contained in the specified common Sylow. -/
theorem centralizer_le_sylow : centralizer (V : Set H) ≤ (d.T : Subgroup H) := by
  rw [← d.centralizer_eq, d.sylow_centralizer_eq]
  exact inf_le_left

omit [Finite H] in
/-- The kernel bound for the actual quotient representation. -/
theorem centralizer_isTwoGroup : IsPGroup 2 (centralizer (V : Set H)) :=
  d.T.isPGroup'.to_le d.centralizer_le_sylow

omit [Finite H] in
/-- The ambient core, rather than the intersection of local cores, centralizes V. -/
theorem core_centralizes : pCore 2 H ≤ centralizer (V : Set H) :=
  le_sup_left.trans (d.core_bound.trans d.centralizer_eq.le)

/-- The commutator identity puts X_E in the actual Thompson subgroup. -/
theorem second_le_thompson : d.XE ≤ thompsonGroup H :=
  d.second_commutator.le.trans
    ((commutator_mono le_rfl (Stellmacher.elementaryAbelianMaxJ_sylow_le_top d.T)).trans
      (commutator_le_right _ _))

/-- The source escape makes the Thompson image nontrivial before any classification. -/
theorem thompson_image_ne_bot : (thompsonGroup H).map coreProjection ≠ ⊥ := by
  intro hz
  exact d.second_escape (d.second_le_thompson.trans
    (((Subgroup.map_eq_bot_iff _).mp hz).trans (QuotientGroup.ker_mk' _).le))

omit [Finite H] in
/-- The same escape already makes the marked Sylow Thompson image nonzero. -/
theorem sylow_thompson_image_ne_bot :
    (Stellmacher.elementaryAbelianMaxJ (d.T : Subgroup H)).map coreProjection ≠ ⊥ := by
  intro hz
  have hj : Stellmacher.elementaryAbelianMaxJ (d.T : Subgroup H) ≤ pCore 2 H :=
    ((Subgroup.map_eq_bot_iff _).mp hz).trans (QuotientGroup.ker_mk' _).le
  exact d.second_escape (d.second_commutator.le.trans
    ((commutator_mono le_rfl hj).trans (commutator_le_right _ _)))

/-- The actual quotient image of the common Sylow. -/
noncomputable def quotientSylow : Sylow 2 (coreQuotient H) :=
  d.T.mapSurjective (QuotientGroup.mk'_surjective _)

/-- The local embeddings have exactly the specified common Sylow image. -/
theorem quotient_intersection :
    d.G1.map coreProjection ⊓ d.G2.map coreProjection =
      (d.quotientSylow : Subgroup (coreQuotient H)) := by
  rw [← map_inf_of_ker_le coreProjection d.G1 d.G2 (show
    (coreProjection (H := H)).ker ≤ d.G2 from
      (QuotientGroup.ker_mk' _).le.trans
        ((pCore_isPGroup.le_sylow_of_normal d.T).trans
          (d.common_sylow ▸ inf_le_right))), d.common_sylow]
  rfl

/-- F.6.18 is applied to the original two local images, not abstract copies. -/
theorem full_goldschmidt_alternative {K : GroupClass.{u}} (hH : IsSQTK K H)
    (classification : FSource.ClassificationInput K) :
    FSource.Alternative (d.G1.map coreProjection) (d.G2.map coreProjection) d.quotientSylow ∨
      FSource.Alternative (d.G2.map coreProjection) (d.G1.map coreProjection) d.quotientSylow := by
  obtain ⟨S, hS, h⟩ := classification (coreQuotient H) _ _
    (goldschmidt_twoCore_quotient d.G1 d.G2 d.goldschmidt)
    (threePrimeSQTKQuotient_of_core_eq hH d.three_prime_core)
  have he : S = d.quotientSylow := Sylow.ext (hS.symm.trans d.quotient_intersection)
  exact he ▸ h

variable [IsElementaryAbelian 2 (moduleClosure V)]

/-- The group generated by the best offenders on the original module. -/
noncomputable abbrev offenderGroup : Subgroup (coreQuotient H) :=
  offenderSubgroup (quotientAction V d.centralizer_isTwoGroup d.core_centralizes)

/-- Restriction changes the actor only; it keeps the same module and action. -/
noncomputable def offenderAction :
    Representation (ZMod 2) d.offenderGroup (Additive (moduleClosure V)) :=
  (quotientAction V d.centralizer_isTwoGroup d.core_centralizes).comp d.offenderGroup.subtype

/-- The maximum-elementary argument relates the two actors without identifying them. -/
theorem thompson_image_le_offender :
    (thompsonGroup H).map coreProjection ≤ d.offenderGroup :=
  ExceptionalAction.ActionRecognition.thompson_image_le_offenderSubgroup
    V d.centralizer_isTwoGroup d.core_centralizes

/-- The original X_E image is nonzero inside the offender actor. -/
theorem offender_ne_bot : d.offenderGroup ≠ ⊥ :=
  fun h => d.thompson_image_ne_bot (le_bot_iff.mp (h ▸ d.thompson_image_le_offender))

/-- The faithful quotient module has an FF-offender from the source commutator. -/
theorem action_isFF : IsFFModule (quotientAction V d.centralizer_isTwoGroup d.core_centralizes) :=
  quotientAction_isFFModule V d.centralizer_isTwoGroup d.core_centralizes d.T d.XE
    d.vector_le_core d.second_commutator d.second_escape

/-- Every B.5.3 hypothesis is proved on the correct restricted representation. -/
theorem offender_hypothesis {K : GroupClass.{u}} (hH : IsSQTK K H) :
    FFHypothesis K d.offenderAction := by
  let _ : Module.Finite (ZMod 2) (Additive (moduleClosure V)) := Module.Finite.of_finite
  exact offender_source_hypothesis hH coreProjection (QuotientGroup.mk'_surjective _)
    CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.coreQuotient_twoCore
    _ (quotientAction_injective V d.centralizer_isTwoGroup d.core_centralizes)

/-- The full B.5.6 conclusion, including all representation and extension clauses. -/
theorem full_offender_alternative {K : GroupClass.{u}} (hH : IsSQTK K H)
    (classification : CompleteClassificationInput.{u,u} K) : SourceAlternative d.offenderAction :=
  classification.general _ _ _ (d.offender_hypothesis hH)

omit [IsElementaryAbelian 2 (moduleClosure V)] in
/-- The strict local-core inequality remains available before deriving the residual. -/
theorem local_core_strict :
    (d.YF.map coreProjection).pCoreIn 2 < (d.G1.map coreProjection).pCoreIn 2 :=
  localCore_strict d.YF d.G1 V d.R d.F (d.first_local.symm ▸ le_sup_left)
    d.first_normalized d.core_bound d.centralizer_eq.le d.local_commutator d.singular_nontrivial

/-- The original four-dimensional plane is fixed pointwise by the first factor's core. -/
theorem vector_fixed : planeSubspace V V ≤
    fixedSpace (quotientAction V d.centralizer_isTwoGroup d.core_centralizes)
      ((d.YF.map coreProjection).pCoreIn 2) :=
  localCore_fixes_subspace V d.centralizer_isTwoGroup d.core_centralizes
    d.YF d.R d.core_bound d.centralizer_eq.le

end SourceInput
end CFSG.Quasithin.Chapter15.Section03.TerminalRecognition.Intersection
