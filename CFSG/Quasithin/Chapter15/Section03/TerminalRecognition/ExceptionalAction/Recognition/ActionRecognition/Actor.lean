module

public import CFSG.Quasithin.Chapter15.Section03.TerminalRecognition.ExceptionalAction.Recognition.ActionRecognition.Source
public import CFSG.Quasithin.Chapter15.Section03.TerminalRecognition.ExceptionalAction.Recognition.ActionRecognition.Thompson
public import Theory.Representation.BinaryOffender.EquivariantOffender
public import CFSG.Quasithin.Defs

/-!
# The offender actor for the terminal action

The source residual identity and the maximum-elementary argument put the
actual Thompson image inside the subgroup N generated by the best offenders
on V₀. Restriction to N is faithful, has trivial two-core, and is generated
by its own best offenders. The source identity V = [V,Y_F] makes this action
nontrivial. The preimage of N in H supplies the literal SQTK quotient needed
by B.5.3. Finally N and the marked Sylow image generate H/O₂(H), whose
quotient by N is a two-group.

These are application hypotheses for B.5.6, not a classification of the
resulting action. In particular no equality between N, the Thompson image,
and the full quotient is assumed.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, B.5.3,
printed p.104, and the final proof of 15.3.1, printed p.1155.
-/

@[expose] public section

open Subgroup Representation.BinaryOffender
open scoped IsMulCommutative

namespace CFSG.Quasithin.Chapter15.Section03.TerminalRecognition.ExceptionalAction.ActionRecognition.SourceInput

variable {H : Type*} [Group H] [Finite H]
  {V : Subgroup H} (d : SourceInput V)

include d

omit [Finite H] in
/-- The marked vector group is nontrivial. -/
theorem vector_ne_bot : V ≠ ⊥ := by
  intro h
  have hc := d.vector_card
  rw [h] at hc
  norm_num at hc

omit [Finite H] in
/-- The nonzero commutator seed prevents the Thompson image from vanishing. -/
theorem thompson_image_ne_bot : (thompsonGroup H).map coreProjection ≠ ⊥ := by
  intro h
  have hX := (map_eq_bot_iff (thompsonGroup H)).mp h
  have hY : d.YF ≤ centralizer (V : Set H) :=
    d.thompson_contains.trans (hX.trans (by
      simpa only [coreProjection, QuotientGroup.ker_mk'] using d.core_centralizes))
  apply d.vector_ne_bot
  rw [d.vector_commutator, commutator_eq_bot_iff_le_centralizer]
  exact le_centralizer_iff.mp hY

omit [Finite H] in
/-- The residual identity supplies the usual Thompson/Sylow supplement. -/
theorem residual_le_thompson : pResidual 2 H ≤ thompsonGroup H := by
  rw [← d.thompson_residual]
  exact map_subtype_le _

/-- The marked Sylow subgroup supplements the actual Thompson subgroup. -/
theorem thompson_sup_sylow : thompsonGroup H ⊔ (d.T : Subgroup H) = ⊤ :=
  top_unique ((pResidual_sup_sylow_eq_top d.T).symm.trans_le
    (sup_le_sup_right d.residual_le_thompson _))

variable [IsElementaryAbelian 2 (moduleClosure V)]

/-- The subgroup generated by the best offenders on the actual quotient module. -/
noncomputable abbrev offenderGroup : Subgroup (coreQuotient H) :=
  offenderSubgroup (quotientAction V d.centralizer_isTwoGroup d.core_centralizes)

/-- The original conjugation representation restricted to its offender group. -/
noncomputable def offenderAction :
    Representation (ZMod 2) d.offenderGroup (Additive (moduleClosure V)) :=
  (quotientAction V d.centralizer_isTwoGroup d.core_centralizes).comp d.offenderGroup.subtype

omit [Finite H] in
instance offenderGroup_normal : d.offenderGroup.Normal := offenderSubgroup_normal _

/-- The actual Thompson image is contained in this actor. -/
theorem thompson_image_le : (thompsonGroup H).map coreProjection ≤ d.offenderGroup :=
  thompson_image_le_offenderSubgroup V d.centralizer_isTwoGroup d.core_centralizes

/-- Both the factor marking and its subgroup image are preserved. -/
theorem first_image_le : d.YF.map coreProjection ≤ d.offenderGroup :=
  (map_mono d.thompson_contains).trans d.thompson_image_le

/-- The commutator description of X_E puts its image in the same actor. -/
theorem second_image_le : d.XE.map coreProjection ≤ d.offenderGroup := by
  let _ := d.offenderGroup_normal
  conv_lhs => rw [d.second_commutator, map_commutator]
  exact (commutator_mono le_rfl
    (sylow_thompson_image_le_offenderSubgroup V d.centralizer_isTwoGroup
      d.core_centralizes d.T d.vector_le_core)).trans (commutator_le_right _ _)

omit [Finite H] in
/-- Restriction preserves the faithfulness of the genuine quotient action. -/
theorem offenderAction_injective : Function.Injective d.offenderAction :=
  (quotientAction_injective V d.centralizer_isTwoGroup d.core_centralizes).comp
    d.offenderGroup.subtype_injective

omit [Finite H] in
/-- Best offenders remain best on restriction to N, so N = J(N,V₀). -/
theorem offenderAction_generated : offenderSubgroup d.offenderAction = ⊤ := by
  apply map_injective d.offenderGroup.subtype_injective
  apply le_antisymm (by simp)
  have htop : (⊤ : Subgroup d.offenderGroup).map d.offenderGroup.subtype =
      d.offenderGroup := by ext x; simp
  rw [htop]
  unfold offenderGroup offenderSubgroup generatedBy
  refine iSup_le fun A => iSup_le fun hA => ?_
  have hAN : A ≤ d.offenderGroup := le_iSup_of_le A (le_iSup_of_le hA le_rfl)
  rw [← map_subgroupOf_eq_of_le hAN]
  apply map_mono
  exact le_iSup_of_le (A.subgroupOf d.offenderGroup)
    (le_iSup_of_le ⟨hA.1.subgroupOf _ hAN, le_top⟩ le_rfl)

omit d [IsElementaryAbelian 2 (moduleClosure V)] in
/-- The quotient by the original two-core has trivial two-core. -/
theorem quotient_twoCore : pCore 2 (coreQuotient H) = ⊥ := by
  let q : H →* coreQuotient H := coreProjection
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective _
  have hk : IsPGroup 2 q.ker := by
    change IsPGroup 2 ((QuotientGroup.mk' (pCore 2 H)).ker)
    rw [QuotientGroup.ker_mk']
    exact pCore_isPGroup
  have hm := congrArg (map q) (q.comap_pCore_of_ker_isPGroup hq hk)
  rw [map_comap_eq_self_of_surjective hq] at hm
  exact hm.trans ((Subgroup.map_eq_bot_iff _).mpr (by
    change pCore 2 H ≤ (QuotientGroup.mk' (pCore 2 H)).ker
    rw [QuotientGroup.ker_mk']))

/-- Normality of N makes its two-core trivial as well. -/
theorem offenderGroup_twoCore : pCore 2 d.offenderGroup = ⊥ := by
  have hn : ((pCore 2 d.offenderGroup).map d.offenderGroup.subtype).Normal :=
    ConjAct.normal_of_characteristic_of_normal
  have hl : (pCore 2 d.offenderGroup).map d.offenderGroup.subtype ≤
      pCore 2 (coreQuotient H) := le_sSup ⟨hn, pCore_isPGroup.map _⟩
  rw [quotient_twoCore] at hl
  exact ((pCore 2 d.offenderGroup).map_eq_bot_iff_of_injective
    d.offenderGroup.subtype_injective).mp (le_bot_iff.mp hl)

/-- The actual seed forces N to be nontrivial. -/
theorem offenderGroup_ne_bot : d.offenderGroup ≠ ⊥ :=
  fun hb => d.thompson_image_ne_bot (le_bot_iff.mp (hb ▸ d.thompson_image_le))

/-- A nontrivial offender-generated group supplies a best offender. -/
theorem quotientAction_isFF :
    IsFFModule (quotientAction V d.centralizer_isTwoGroup d.core_centralizes) := by
  classical
  by_contra h
  apply d.offenderGroup_ne_bot
  apply le_bot_iff.mp
  unfold offenderGroup offenderSubgroup generatedBy
  refine iSup_le fun A => iSup_le fun hA => ?_
  exact (h ⟨A, hA.1.isOffender _⟩).elim

/-- The restricted action is an FF-module, with an actual nontrivial offender. -/
theorem offenderAction_isFF : IsFFModule d.offenderAction := by
  obtain ⟨A, hA⟩ := (isFFModule_iff_exists_bestOffender _).mp d.quotientAction_isFF
  have hAN : A ≤ d.offenderGroup :=
    le_iSup_of_le A (le_iSup_of_le ⟨hA, le_top⟩ le_rfl)
  exact ⟨A.subgroupOf d.offenderGroup, (hA.subgroupOf _ hAN).isOffender _⟩

/-- The preimage of N in the source group, for the quotient clause of B.5.3. -/
noncomputable abbrev offenderCover : Subgroup H := d.offenderGroup.comap coreProjection

omit [Finite H] in
instance offenderCover_normal : d.offenderCover.Normal := inferInstanceAs
  ((d.offenderGroup.comap coreProjection).Normal)

/-- The literal surjection from the source preimage to N. -/
noncomputable def offenderCoverProjection : d.offenderCover →* d.offenderGroup :=
  coreProjection.subgroupComap d.offenderGroup

omit [Finite H] in
theorem offenderCoverProjection_surjective : Function.Surjective d.offenderCoverProjection :=
  coreProjection.subgroupComap_surjective_of_surjective _ (QuotientGroup.mk'_surjective _)

/-- The first isomorphism theorem gives the required quotient identification. -/
noncomputable def offenderCoverQuotientEquiv :
    d.offenderCover ⧸ d.offenderCoverProjection.ker ≃* d.offenderGroup :=
  QuotientGroup.quotientKerEquivOfSurjective _ d.offenderCoverProjection_surjective

/-- SQTK is inherited by the actual cover, with the catalogue kept explicit. -/
theorem offenderCover_sqtk {K : GroupClass} (hH : IsSQTK K H) :
    IsSQTK K d.offenderCover := hH.subgroup _

/-- The module is generated by commutators with the preimage of N. -/
theorem closure_commutator_offenderCover :
    moduleClosure V = ⁅moduleClosure V, d.offenderCover⁆ :=
  moduleClosure_eq_commutator V d.offenderCover d.YF
    (map_le_iff_le_comap.mp d.first_image_le) d.vector_commutator

/-- N and the marked Sylow image generate the full quotient. -/
theorem offenderGroup_sup_sylow :
    d.offenderGroup ⊔ (d.T : Subgroup H).map coreProjection = ⊤ := by
  apply top_unique
  calc
    ⊤ = (⊤ : Subgroup H).map coreProjection :=
      (map_top_of_surjective _ (QuotientGroup.mk'_surjective _)).symm
    _ = (thompsonGroup H).map coreProjection ⊔ (d.T : Subgroup H).map coreProjection := by
      rw [← d.thompson_sup_sylow, Subgroup.map_sup]
    _ ≤ _ := sup_le_sup_right d.thompson_image_le _

/-- The full quotient has two-group quotient over its offender-generated actor. -/
theorem quotient_offenderGroup_isTwoGroup : IsPGroup 2 (coreQuotient H ⧸ d.offenderGroup) := by
  let q := QuotientGroup.mk' d.offenderGroup
  have ht : ((d.T : Subgroup H).map coreProjection).map q = ⊤ := by
    have hh := congrArg (fun A : Subgroup (coreQuotient H) => A.map q) d.offenderGroup_sup_sylow
    simpa only [q, Subgroup.map_sup, QuotientGroup.map_mk'_self, bot_sup_eq,
      map_top_of_surjective _ (QuotientGroup.mk'_surjective _)] using hh
  have hp := (d.T.isPGroup'.map coreProjection).map q
  rw [ht] at hp
  exact hp.of_equiv Subgroup.topEquiv

/-- Intersecting the marked Sylow image with N gives an actual Sylow subgroup. -/
theorem exists_offenderSylow : ∃ S : Sylow 2 d.offenderGroup,
    (S : Subgroup d.offenderGroup) =
      ((d.T : Subgroup H).map coreProjection).subgroupOf d.offenderGroup :=
  (d.T.mapSurjective (QuotientGroup.mk'_surjective (pCore 2 H))).exists_subgroupOf_eq_of_normal _

/-- In a two-perfect classification branch, the source residual identity
identifies N with the actual Thompson image, not just an abstract copy. -/
theorem thompson_image_eq_of_isPPerfect (hN : IsPPerfect 2 d.offenderGroup) :
    (thompsonGroup H).map coreProjection = d.offenderGroup := by
  apply le_antisymm d.thompson_image_le
  calc
    d.offenderGroup ≤ pResidual 2 (coreQuotient H) := le_pResidual_of_isPPerfect _ hN
    _ = (pResidual 2 H).map coreProjection :=
      (map_pResidual_of_surjective 2 coreProjection (QuotientGroup.mk'_surjective _)).symm
    _ ≤ (thompsonGroup H).map coreProjection := map_mono d.residual_le_thompson

end CFSG.Quasithin.Chapter15.Section03.TerminalRecognition.ExceptionalAction.ActionRecognition.SourceInput
