module

public import CFSG.Quasithin.Chapter15.Section03.TerminalRecognition.ExceptionalAction.Recognition.ActionRecognition.Actor
public import CFSG.Quasithin.Chapter15.Section04.Configuration.LocalSetup.TwoFactors.FFBranch.Recognition.ClassificationComparison.FFAlternatives.SourceAlternatives

/-!+# The full FF classification applied to the terminal offender actor

The actor is the subgroup generated by best offenders on the actual module,
not the full quotient or an abstract copy of the Thompson image. Its inverse
image in the source group supplies the SQTK quotient required by B.5.3.
Consequently the existing complete B.5.6 interface applies, with all its
module, extension and fixed-summand clauses intact.

The four remaining possibilities for the full quotient are a separate
input, expressed by actual group equivalences. Neither that alternative nor
the universal FF classification is proved here. Excluding ordinary modules
from these inputs remains the next step in the terminal argument.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, B.5.1,
B.5.3 and B.5.6, printed pp.99 and 104–105, and the final proof of 15.3.1,
printed p.1155. The triple-cover convention is A.3.5 and K.1.3.
-/

@[expose] public section

open Subgroup Representation.BinaryOffender
open scoped IsMulCommutative

namespace CFSG.Quasithin.Chapter15.Section03.TerminalRecognition.ExceptionalAction.ActionRecognition

open CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison
open FFAlternatives

universe u

/-- The full quotient alternative preceding the last FF-module exclusion.
Each constructor identifies the actual group, including the concrete nonsplit
triple cover in the exceptional case. There is no representation premise. -/
inductive FullQuotientAlternative (D : Type u) [Group D] : Prop
  | symmetricSix (equiv : D ≃* Equiv.Perm (Fin 6))
  | tripleSymmetricSix (equiv : D ≃* Atlas.Codes.HexAutomorphisms)
  | symmetricSeven (equiv : D ≃* Equiv.Perm (Fin 7))
  | g2Two (equiv : D ≃* Atlas.G2.Model (ZMod 2))

namespace SourceInput

variable {H : Type u} [Group H] [Finite H]
    {V : Subgroup H} [IsElementaryAbelian 2 (moduleClosure V)] (d : SourceInput V)

/-- The genuine finite SQTK cover is the inverse image of the offender group. -/
noncomputable def offenderSQTKQuotient {K : GroupClass.{u}} (hH : IsSQTK K H) :
    SQTKQuotient K d.offenderGroup where
  Cover := d.offenderCover
  kernel := d.offenderCoverProjection.ker
  sqtk := d.offenderCover_sqtk hH
  equiv := d.offenderCoverQuotientEquiv

/-- Every hypothesis of B.5.3 holds on the original restricted representation. -/
theorem offenderFFHypothesis {K : GroupClass.{u}} (hH : IsSQTK K H) :
    FFHypothesis K d.offenderAction where
  finite_module := Module.Finite.of_finite
  faithful := d.offenderAction_injective
  twoCore := d.offenderGroup_twoCore
  generated := d.offenderAction_generated
  quotient := ⟨d.offenderSQTKQuotient hH⟩

/-- Apply the full source classification without losing any action clauses.
The universal classification implication remains an explicit input. -/
theorem sourceAlternative {K : GroupClass.{u}} (hH : IsSQTK K H)
    (classification : CompleteClassificationInput.{u,u} K) :
    SourceAlternative d.offenderAction :=
  classification.general d.offenderGroup (Additive (moduleClosure V)) d.offenderAction
    (d.offenderFFHypothesis hH)

end SourceInput

end CFSG.Quasithin.Chapter15.Section03.TerminalRecognition.ExceptionalAction.ActionRecognition
