module

public import CFSG.Quasithin.Chapter15.Section03.TerminalRecognition.ExceptionalAction.Recognition.Target
public import Stellmacher.MaxElementaryOffenderEquality
public import Theory.GroupTheory.NormalizedSupCard
public import Theory.Representation.BinaryOffender.Stability

/-!
# The actual Thompson image lies in the offender-generated group

Let A be an elementary abelian subgroup of maximum order and let B lie
in its image on the normal elementary module. Lift B to D ≤ A and replace
D by D C_V(D). Maximality bounds the order of this elementary subgroup.
After cancelling the common action kernel, this is precisely the best
offender weight inequality for B. Thus every nontrivial image of a
maximum elementary subgroup is a best offender, and the image of J(H)
lies in the subgroup generated by all best offenders on the quotient module.

This inclusion justifies the distinction between the actual Thompson
image and the actor in B.5.3; it does not assert either is the full quotient.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
B.1.3, B.2.4 and the final proof of 15.3.1, printed p.1155.
-/

open Subgroup Representation.BinaryOffender
open scoped IsMulCommutative

namespace Representation.NormalElementaryQuotient

variable {G H : Type*} [Group G] [Group H] [Finite G] [Finite H]
  (V : Subgroup G) [V.Normal] [IsElementaryAbelian 2 V]
  (q : G →* H) (hq : Function.Surjective q)
  (hker : q.ker = centralizer (V : Set G))

omit [Finite G] [Finite H] in
private theorem card_inf_mul_image (A : Subgroup G) :
    Nat.card (q.ker ⊓ A : Subgroup G) * Nat.card (A.map q) = Nat.card A := by
  simpa only [relIndex_bot_left, inf_relIndex_right, relIndex_ker] using
    relIndex_mul_relIndex (⊥ : Subgroup G) (q.ker ⊓ A) A bot_le inf_le_right

omit [Finite H] in
private theorem maxElementary_image_weight_card (S A : Subgroup G) (hVS : V ≤ S)
    (hA : A ∈ Stellmacher.elementaryAbelianMaxSubgroups S)
    (B : Subgroup H) (hBA : B ≤ A.map q) :
    Nat.card B * Nat.card (fixedSpace (representation V q hq hker) B) ≤
      Nat.card (A.map q) * Nat.card (fixedSpace (representation V q hq hker) (A.map q)) := by
  let D := A ⊓ B.comap q
  let C := V ⊓ centralizer (D : Set G)
  let C₀ := V ⊓ centralizer (A : Set G)
  let _ : IsElementaryAbelian 2 A := hA.2.1
  let _ : IsElementaryAbelian 2 D := IsElementaryAbelian.of_le (show D ≤ A from inf_le_left)
  let _ : IsElementaryAbelian 2 C := IsElementaryAbelian.of_le (show C ≤ V from inf_le_left)
  let _ : IsElementaryAbelian 2 C₀ := IsElementaryAbelian.of_le (show C₀ ≤ V from inf_le_left)
  have hC₀A : C₀ ≤ A :=
    Stellmacher.maxElementary_contains_elementary_centralizer S A C₀ hA
      (inf_le_left.trans hVS) inf_le_right
  have hAA : A ≤ centralizer (A : Set G) := le_centralizer_iff_isMulCommutative.mpr inferInstance
  have hVV : V ≤ q.ker := by
    rw [hker]
    exact le_centralizer_iff_isMulCommutative.mpr inferInstance
  have hDC : D ⊓ C = C₀ := by
    apply le_antisymm
    · exact le_inf (inf_le_right.trans inf_le_left)
        (inf_le_left.trans (inf_le_left.trans hAA))
    · intro x hx
      exact ⟨⟨hC₀A hx, by change q x ∈ B; rw [hVV hx.1]; exact B.one_mem⟩,
        hx.1, centralizer_le (show D ≤ A from inf_le_left) hx.2⟩
  have hDmap : D.map q = B := by
    apply le_antisymm
    · exact map_le_iff_le_comap.mpr inf_le_right
    · intro b hb
      obtain ⟨a, ha, rfl⟩ := hBA hb
      exact mem_map_of_mem q (show a ∈ D from ⟨ha, hb⟩)
  have hKD : q.ker ⊓ D = q.ker ⊓ A := by
    ext x
    constructor
    · exact fun hx => ⟨hx.1, hx.2.1⟩
    · intro hx
      refine ⟨hx.1, hx.2, ?_⟩
      change q x ∈ B
      rw [hx.1]
      exact B.one_mem
  have he : IsElementaryAbelian 2 (D ⊔ C : Subgroup G) :=
    IsElementaryAbelian.sup_of_le_centralizer (show C ≤ centralizer (D : Set G) from inf_le_right)
  have hm : Nat.card (D ⊔ C : Subgroup G) ≤ Nat.card A :=
    hA.2.2 _ (sup_le (inf_le_left.trans hA.1) (inf_le_left.trans hVS)) he
  have hp := card_mul_eq_card_inf_mul_card_sup_of_normalizes D C
    ((show C ≤ centralizer (D : Set G) from inf_le_right).trans (Subgroup.centralizer_le_normalizer _))
  rw [hDC] at hp
  have hDcard := card_inf_mul_image q D
  rw [hKD, hDmap] at hDcard
  have hAcard := card_inf_mul_image q A
  have hc : Nat.card B * Nat.card C ≤ Nat.card (A.map q) * Nat.card C₀ := by
    apply Nat.le_of_mul_le_mul_left (c := Nat.card (q.ker ⊓ A : Subgroup G))
    · calc
        _ = Nat.card D * Nat.card C := by rw [← hDcard]; ac_rfl
        _ = Nat.card C₀ * Nat.card (D ⊔ C : Subgroup G) := hp
        _ ≤ Nat.card C₀ * Nat.card A := Nat.mul_le_mul_left _ hm
        _ = _ := by rw [← hAcard]; ac_rfl
    · exact Nat.card_pos
  rw [← Nat.card_congr (fixedSpaceEquiv V q hq hker D), hDmap,
    ← Nat.card_congr (fixedSpaceEquiv V q hq hker A)] at hc
  exact hc

private theorem maxElementary_image_best (S A : Subgroup G) (hVS : V ≤ S)
    (hA : A ∈ Stellmacher.elementaryAbelianMaxSubgroups S) (hne : ¬ A ≤ q.ker) :
    IsBestOffender (representation V q hq hker) (A.map q) := by
  let _ : IsElementaryAbelian 2 A := hA.2.1
  let _ : IsElementaryAbelian 2 (A.map q) := IsElementaryAbelian.map q
  refine ⟨⟨fun h => hne ((map_eq_bot_iff A).mp h), inferInstance⟩, ?_⟩
  intro B hBA
  let _ : IsElementaryAbelian 2 B := IsElementaryAbelian.of_le hBA
  have hc := maxElementary_image_weight_card V q hq hker S A hVS hA B hBA
  have hw (D : Subgroup H) [IsElementaryAbelian 2 D] :
      Nat.card D * Nat.card (fixedSpace (representation V q hq hker) D) =
        2 ^ weight (representation V q hq hker) D := by
    have hd : Nat.card D = 2 ^ rank D := by
      obtain ⟨n, hn⟩ := (IsElementaryAbelian.isPGroup 2 D).exists_card_eq
      rw [rank, hn, Nat.log_pow (by decide : 1 < 2)]
    rw [hd, Module.natCard_eq_pow_finrank (K := ZMod 2), Nat.card_zmod, ← pow_add]
    rfl
  rw [hw B, hw (A.map q)] at hc
  exact (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp hc

private theorem maxJ_image_le_offenderSubgroup (S : Subgroup G) (hVS : V ≤ S) :
    (Stellmacher.elementaryAbelianMaxJ S).map q ≤
      offenderSubgroup (representation V q hq hker) := by
  rw [map_le_iff_le_comap]
  apply sSup_le
  intro A hA
  rw [← map_le_iff_le_comap]
  by_cases hk : A ≤ q.ker
  · rw [(map_eq_bot_iff A).mpr hk]
    exact bot_le
  · exact le_iSup_of_le (A.map q)
      (le_iSup_of_le ⟨maxElementary_image_best V q hq hker S A hVS hA hk, le_top⟩ le_rfl)

end Representation.NormalElementaryQuotient

@[expose] public section

namespace CFSG.Quasithin.Chapter15.Section03.TerminalRecognition.ExceptionalAction.ActionRecognition

variable {H : Type*} [Group H] [Finite H]
  (V : Subgroup H) [IsElementaryAbelian 2 (moduleClosure V)]
  (hC : IsPGroup 2 (centralizer (V : Set H)))
  (hcore : pCore 2 H ≤ centralizer (V : Set H))

/-- The image of the actual elementary Thompson subgroup is contained in
`J(H/O₂(H), V₀)`, the actor to which B.5.3 applies. -/
theorem thompson_image_le_offenderSubgroup :
    (thompsonGroup H).map coreProjection ≤ offenderSubgroup (quotientAction V hC hcore) :=
  Representation.NormalElementaryQuotient.maxJ_image_le_offenderSubgroup
    (moduleClosure V) coreProjection (QuotientGroup.mk'_surjective _)
    (coreProjection_ker V hC hcore) ⊤ le_top

/-- The same best-offender argument applies to the marked Sylow subgroup. -/
theorem sylow_thompson_image_le_offenderSubgroup (T : Sylow 2 H)
    (hV : V ≤ pCore 2 H) :
    (Stellmacher.elementaryAbelianMaxJ (T : Subgroup H)).map coreProjection ≤
      offenderSubgroup (quotientAction V hC hcore) :=
  Representation.NormalElementaryQuotient.maxJ_image_le_offenderSubgroup
    (moduleClosure V) coreProjection (QuotientGroup.mk'_surjective _)
    (coreProjection_ker V hC hcore) (T : Subgroup H)
    ((moduleClosure_le_twoCore V hV).trans (pCore_isPGroup.le_sylow_of_normal T))

end CFSG.Quasithin.Chapter15.Section03.TerminalRecognition.ExceptionalAction.ActionRecognition
