module

public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.PairedOffenders.QuotientGeometry.Center

/-!
# Regular and even offender images in the dihedral quotient

For an arbitrary regular elementary eight, evaluation on a point identifies
its block-preserving subgroup with the four points in that block. Those four
elements are precisely its intersection with the block kernel. Its quotient
image has order two and meets the center trivially; together they generate
the even four-group.

Every conjugate of the even pair subgroup is generated by transpositions and
double transpositions. Inside the canonical Sylow these preserve the two
blocks. Parity puts its quotient image in the center, and the earlier kernel
exclusion makes the image the entire center. This proves (I) and (IV) for every
relevant subgroup, and `realizes_position` assembles all four calculations.

Source: Aschbacher–Smith, proof of 15.3.25, printed pp.1133–1134.
-/

public section

open Subgroup Representation.BinaryOffender
open CFSG.Quasithin.ChapterB.Offenders
open CFSG.Quasithin.ChapterB.Offenders.Eight
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.PairedQuotient

private theorem small_fixes_blocks {s : Perm} (hs : s ∈ canonicalSylow)
    (hd : s.IsSwap ∨ IsConj (kleinFirst 8 (by decide)) s) : s ∈ blockStabilizer := by
  have hD : D 8 ≤ blockStabilizer := by
    have ht : ∀ i x, (dWords i x).val / 4 = x.val / 4 := by decide +kernel
    rintro x hx
    obtain ⟨i, rfl⟩ := (mem_D_iff x).mp hx
    exact ht i
  have hE : exceptional 8 (by decide) ≤ blockStabilizer := by
    have ht : ∀ i x, (exceptionalWords i x).val / 4 = x.val / 4 := by decide +kernel
    rintro x hx
    obtain ⟨i, rfl⟩ := (mem_exceptional_iff x).mp hx
    exact ht i
  have hO : oppositeExceptional ≤ blockStabilizer := by
    have ht : ∀ i x, (((MulAut.conj halfSwap) (exceptionalWords i)) x).val / 4 =
        x.val / 4 := by decide +kernel
    rintro _ ⟨x, hx, rfl⟩
    obtain ⟨i, rfl⟩ := (mem_exceptional_iff x).mp hx
    exact ht i
  rcases hd with hd | hd
  · exact hD (isSwap_mem_D_of_isPGroup canonicalSylow.isPGroup' D_le_canonicalSylow hd hs)
  · rcases doubleSwap_mem_D_or_exceptional hs hd with h | h | h
    · exact hD h
    · exact hE h
    · exact hO h

theorem even_le_blockStabilizer {A : Subgroup Perm}
    (hA : EightCase.even.Realizes A) (hAS : A ≤ canonicalSylow) :
    A ≤ blockStabilizer := by
  apply (caseBFamily_le_smallClosure (Or.inr (Or.inr (Or.inl hA)))).trans
  apply (Subgroup.closure_le _).mpr
  rintro s ⟨hs, hd⟩
  exact small_fixes_blocks (hAS hs) hd

theorem even_le_alternating {A : Subgroup Perm}
    (hA : EightCase.even.Realizes A) : A ≤ alternatingGroup (Fin 8) := by
  obtain ⟨g, rfl⟩ := hA
  rintro _ ⟨a, ha, rfl⟩
  change Equiv.Perm.sign (g * a * g⁻¹) = 1
  simp only [map_mul, map_inv, show Equiv.Perm.sign a = 1 from ha.2, mul_one, mul_inv_cancel]

/-- Calculation (IV), for every conjugate of the even pair subgroup in the Sylow. -/
theorem even_position {A : Subgroup Perm}
    (hA : EightCase.even.Realizes A) (hAS : A ≤ canonicalSylow) :
    Position .even evenFour (quotientImage A) := by
  have hle : quotientImage A ≤ Subgroup.center Quotient := by
    rintro y ⟨x, hx, rfl⟩
    exact (quotientMap_mem_center_iff x).mpr
      ⟨even_le_alternating hA hx, even_le_blockStabilizer hA hAS hx⟩
  have hnon : quotientImage A ≠ ⊥ :=
    fun h => even_not_le_blockCore hA ((quotientImage_eq_bot_iff hAS).mp h)
  have hc := (Subgroup.one_lt_card_iff_ne_bot (quotientImage A)).mpr hnon
  apply Subgroup.eq_of_le_of_card_ge hle
  rw [card_center]
  omega

private theorem regular_free {A : Subgroup Perm} (hA : EightCase.regular.Realizes A)
    (a : A) (x : Fin 8) (hx : a.val x = x) : a = 1 := by
  obtain ⟨b, hb, hu⟩ := hA.2.2.2 x x
  exact (hu a hx).trans (hu 1 rfl).symm

set_option maxRecDepth 10000 in
private theorem regular_word_core : ∀ i : Fin 128,
    sylowWord i ^ 2 = 1 → (∀ x, sylowWord i x ≠ x) →
    (sylowWord i 0).val / 4 = 0 → ∃ j, coreWords j = sylowWord i := by decide +kernel

/-- In a regular offender, precisely the elements fixing the blocks lie in the kernel. -/
theorem regular_mem_blockCore_iff {A : Subgroup Perm}
    (hA : EightCase.regular.Realizes A) (hAS : A ≤ canonicalSylow) (a : A) :
    a.val ∈ blockCore ↔ (a.val 0).val / 4 = 0 := by
  constructor
  · intro h
    exact blockCore_preserves_each_half h 0
  · intro h
    by_cases ha : a = 1
    · simpa only [ha, OneMemClass.coe_one] using blockCore.one_mem
    have hn : ∀ x, a.val x ≠ x := fun x hx => ha (regular_free hA a x hx)
    let : IsElementaryAbelian 2 A := hA.1.2
    have hp : a.val ^ 2 = 1 := elemPow_eq_one_of_isElementaryAbelian a.val a.property
    obtain ⟨i, hi⟩ := (mem_canonicalTwoSubgroup a.val).mp (hAS a.property)
    rw [← hi] at h hn hp ⊢
    exact regular_word_core i hp hn h

theorem card_regular_inf_blockCore {A : Subgroup Perm}
    (hA : EightCase.regular.Realizes A) (hAS : A ≤ canonicalSylow) :
    Nat.card (A ⊓ blockCore : Subgroup Perm) = 4 := by
  let f : (A ⊓ blockCore : Subgroup Perm) → Fin 4 := fun a =>
    ⟨(a.val 0).val, by
      have h := blockCore_preserves_each_half a.property.2 0
      change (a.val 0).val / 4 = 0 at h
      omega⟩
  have hi : Function.Injective f := by
    intro a b he
    have hval : a.val 0 = b.val 0 := by
      apply Fin.ext
      exact congrArg (fun z : Fin 4 => z.val) he
    obtain ⟨c, hc, hu⟩ := hA.2.2.2 0 (b.val 0)
    have hab : (⟨a.val, a.property.1⟩ : A) = ⟨b.val, b.property.1⟩ :=
      (hu _ hval).trans (hu _ rfl).symm
    exact Subtype.ext (congrArg (fun z : A => z.val) hab)
  have hs : Function.Surjective f := by
    intro y
    obtain ⟨a, ha, _⟩ := hA.2.2.2 0 ⟨y.val, by omega⟩
    have haK : a.val ∈ blockCore := (regular_mem_blockCore_iff hA hAS a).mpr (by
      rw [ha]; exact Nat.div_eq_of_lt y.isLt)
    refine ⟨⟨a.val, a.property, haK⟩, ?_⟩
    apply Fin.ext
    exact congrArg (fun z : Fin 8 => z.val) ha
  simpa using Nat.card_congr (Equiv.ofBijective f ⟨hi, hs⟩)

theorem card_quotientImage_regular {A : Subgroup Perm}
    (hA : EightCase.regular.Realizes A) (hAS : A ≤ canonicalSylow) :
    Nat.card (quotientImage A) = 2 := by
  have hc := card_inf_mul_card_quotientImage hAS
  rw [card_regular_inf_blockCore hA hAS, hA.2.1] at hc
  omega

theorem regular_disjoint_center {A : Subgroup Perm}
    (hA : EightCase.regular.Realizes A) (hAS : A ≤ canonicalSylow) :
    Disjoint (quotientImage A) (Subgroup.center Quotient) := by
  rw [disjoint_iff_inf_le]
  rintro x ⟨⟨a, ha, he⟩, hz⟩
  have hb := ((quotientMap_mem_center_iff a).mp (he.symm ▸ hz)).2 0
  have hk : a.val ∈ blockCore := (regular_mem_blockCore_iff hA hAS ⟨a.val, ha⟩).mpr hb
  change x = 1
  rw [← he]
  exact (QuotientGroup.eq_one_iff _).mpr hk

/-- Calculation (I), for every regular elementary eight in the Sylow. -/
theorem regular_position {A : Subgroup Perm}
    (hA : EightCase.regular.Realizes A) (hAS : A ≤ canonicalSylow) :
    Position .regular evenFour (quotientImage A) := by
  have hc := card_quotientImage_regular hA hAS
  have hd := regular_disjoint_center hA hAS
  refine ⟨hc, hd, ?_⟩
  have hle : quotientImage A ⊔ Subgroup.center Quotient ≤ evenFour :=
    sup_le ((quotientImage_le_evenFour_iff hAS).mpr hA.2.2.1) center_le_evenFour
  apply Subgroup.eq_of_le_of_card_ge hle
  have hdiv := Subgroup.card_dvd_of_le
    (show quotientImage A ≤ quotientImage A ⊔ Subgroup.center Quotient from le_sup_left)
  rw [hc] at hdiv
  have hn : 2 < Nat.card (quotientImage A ⊔ Subgroup.center Quotient : Subgroup Quotient) := by
    by_contra h
    have he : quotientImage A = quotientImage A ⊔ Subgroup.center Quotient :=
      Subgroup.eq_of_le_of_card_ge le_sup_left (by omega)
    have hz : Subgroup.center Quotient ≤ quotientImage A := he.symm ▸ le_sup_right
    have hh : Subgroup.center Quotient = ⊥ := by
      rw [← inf_eq_right.mpr hz]
      exact le_bot_iff.mp (disjoint_iff_inf_le.mp hd)
    have := card_center
    rw [hh, Subgroup.card_bot] at this
    omega
  rw [card_evenFour]
  omega

/-- All four source calculations have been proved for the actual permutation families. -/
theorem realizes_position {c : EightCase} {A : Subgroup Perm}
    (hA : c.Realizes A) (hAS : A ≤ canonicalSylow) :
    Position c evenFour (quotientImage A) := by
  cases c with
  | regular => exact regular_position hA hAS
  | transposition => exact transposition_position hA hAS
  | disjoint => exact disjoint_position hA hAS
  | even => exact even_position hA hAS

end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.PairedQuotient

