module
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.ComponentExtraction.InternalModule
public import Theory.GroupTheory.GeneralizedFitting.ComponentCalculus
public import Stellmacher.ElementaryAbelianMaxGlobal
public import CFSG.Quasithin.Chapter15.Section03.Preliminaries.ComponentIntersection.Basic

/-!
# Commutator generation of the selected Thompson component

A normalized C-component with a noncentral quasisimple image is generated
by its commutators with the acting subgroup. Otherwise that commutator is
a proper subnormal subgroup of the C-component and hence solvable, while
its image contains the nontrivial perfect image of the whole component.

For the actual star quotient, clauses 15.3.11(2),(9) force this noncentral
action: a component centralizing `Y₊*` would lie in its normalizer `M_I*`,
and the kernel containment would put the original component in `M`.
The two-perfectness supplied by `Y₊ = θ(M_I)` also reduces normalization
to the source C-component orbit bound. All normality is internal to `I`.

These are conditional deductions for a selected component. Its existence,
the orbit bound, and quasisimplicity modulo the two-core remain separate
obligations in the extraction theorem.

Source: Aschbacher–Smith, combined manuscript (1 March 2004),
15.3.15(2) and 15.3.26(2), printed pp.1125 and 1130; A.3.3(1), p.42.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo
open Subgroup
variable {G H : Type*} [Group G] [Group H] [Finite G]

/-- A noncentral quasisimple image forces a normalized C-component to be
generated by its commutators. -/
theorem cComponent_eq_commutator_of_image {L Y : Subgroup G}
    (hL : L.IsCComponent) (hY : Y ≤ normalizer (L : Set G))
    (f : G →* H) (hf : Function.Surjective f)
    (hq : Theory.GroupTheory.IsQuasisimple (L.map f))
    (hne : ⁅L.map f, Y.map f⁆ ≠ ⊥) : L = ⁅L, Y⁆ := by
  have hcL : ⁅L, Y⁆ ≤ L := le_normalizer_iff_commutator_le_left.mp hY
  have hcomp : Theory.GroupTheory.IsComponent H (L.map f) := ⟨hL.subnormal.map hf, hq⟩
  have hlarge : L.map f ≤ (⁅L, Y⁆).map f := by
    rcases hcomp.commutator_dichotomy (Y.map f) with hz | he
    · exact (hne hz).elim
    · rw [map_commutator, he]
      exact le_iSup_conjugates _ _
  by_contra hneq
  have hn : (⁅L, Y⁆.subgroupOf L).Normal :=
    normal_subgroupOf_of_le_normalizer (normalizer_commutator_ge_left L Y)
  have hp : ⁅L, Y⁆.subgroupOf L ≠ ⊤ := by
    intro ht
    exact hneq (le_antisymm (subgroupOf_eq_top.mp ht) hcL)
  let _ := hL.isSolvable_of_subnormal_lt_top hn.isSubnormal hp
  let e := subgroupOfEquivOfLe hcL
  let _ : Group.IsSolvable (⁅L, Y⁆ : Subgroup G) :=
    Group.isSolvable_of_isSolvable_injective (f := e.symm.toMonoidHom) e.symm.injective
  let _ : Group.IsSolvable ((⁅L, Y⁆).map f) :=
    Group.isSolvable_of_surjective (f.subgroupMap_surjective ⁅L, Y⁆)
  let _ : Group.IsSolvable (L.map f) :=
    Group.isSolvable_of_isSolvable_injective (inclusion_injective hlarge)
  let _ := hq
  let _ : IsSimpleGroup ((L.map f) ⧸ center (L.map f)) := hq.simple
  let _ : Nontrivial (L.map f) := (QuotientGroup.mk'_surjective (center (L.map f))).nontrivial
  exact Group.IsPerfect.not_isSolvable (L.map f) inferInstance

namespace LocalData
variable (d : LocalData G)

omit [Finite G] in
/-- The actual Thompson subgroup is normal inside the local overgroup. -/
theorem thompson_subgroupOf_normal (I : Subgroup G) :
    ((Stellmacher.elementaryAbelianMaxJ I).subgroupOf I).Normal := by
  rw [thompson_subgroupOf]
  let _ := Stellmacher.elementaryAbelianMaxJ_top_characteristic (H := I)
  infer_instance

omit [Finite G] in
/-- Transfer a C-component of `J(I)` into `I`, using its relative normality. -/
theorem thompson_component_in {I L : Subgroup G}
    (hLJ : L ≤ Stellmacher.elementaryAbelianMaxJ I)
    (hL : (L.subgroupOf (Stellmacher.elementaryAbelianMaxJ I)).IsCComponent) :
    (L.subgroupOf I).IsCComponent := by
  let J := Stellmacher.elementaryAbelianMaxJ I
  have hJI : J ≤ I := sSup_le fun A hA => hA.1
  have he := hL.map_equiv (subgroupOfEquivOfLe hJI).symm
  have hm := he.map_subtype (thompson_subgroupOf_normal I).isSubnormal
  have hmap : ((L.subgroupOf J).map (subgroupOfEquivOfLe hJI).symm.toMonoidHom).map
      (J.subgroupOf I).subtype = L.subgroupOf I := by
    ext x
    constructor
    · rintro ⟨y, ⟨z, hz, rfl⟩, rfl⟩
      exact hz
    · intro hx
      exact ⟨⟨x, hLJ hx⟩, ⟨⟨x, hLJ hx⟩, hx, rfl⟩, rfl⟩
  rwa [hmap] at hm

omit [Finite G] in
/-- Outside components act nontrivially on `Y₊*`, since its normalizer
is exactly `M_I*` and the action kernel lies in `M`. -/
theorem star_commutator_ne_bot {I L : Subgroup G}
    (hLI : L ≤ I) (hLM : ¬ L ≤ d.M)
    (hC : I ⊓ centralizer (d.UI I : Set G) ≤ d.MI I)
    (hN : normalizer (d.starImage I d.Yplus : Set (d.Star I)) = d.starImage I d.M) :
    ⁅d.starImage I L, d.starImage I d.Yplus⁆ ≠ ⊥ := by
  intro hc
  have him : d.starImage I L ≤ d.starImage I d.M := by
    rw [← hN]
    exact (commutator_eq_bot_iff_le_centralizer.mp hc).trans (Subgroup.centralizer_le_normalizer _)
  have hker : (d.starMap I).ker ≤ d.M.subgroupOf I := by
    rw [show (d.starMap I).ker = localActionKernel d.Z I from QuotientGroup.ker_mk' _]
    exact fun x hx => (hC ⟨x.property, hx⟩).1
  have hle : L.subgroupOf I ≤ d.M.subgroupOf I := by
    have hh := map_le_iff_le_comap.mp him
    change L.subgroupOf I ≤ ((d.M.subgroupOf I).map (d.starMap I)).comap (d.starMap I) at hh
    rw [comap_map_eq, sup_eq_left.mpr hker] at hh
    exact hh
  apply hLM
  intro l hl
  exact hle (show (⟨l, hLI hl⟩ : I) ∈ L.subgroupOf I from hl)

/-- The commutator assertion in 15.3.15(2)/26(2), once the actual
Thompson component has been selected and its normalization established. -/
theorem thompson_component_eq_commutator {I L : Subgroup G}
    (hLJ : L ≤ Stellmacher.elementaryAbelianMaxJ I)
    (hL : (L.subgroupOf (Stellmacher.elementaryAbelianMaxJ I)).IsCComponent)
    (hYI : d.Yplus ≤ I) (hYL : d.Yplus ≤ normalizer (L : Set G))
    (hLM : ¬ L ≤ d.M)
    (hC : I ⊓ centralizer (d.UI I : Set G) ≤ d.MI I)
    (hN : normalizer (d.starImage I d.Yplus : Set (d.Star I)) = d.starImage I d.M)
    (hq : Theory.GroupTheory.IsQuasisimple (d.starImage I L)) : L = ⁅L, d.Yplus⁆ := by
  have hLI : L ≤ I := hLJ.trans (sSup_le fun A hA => hA.1)
  have hnorm : d.Yplus.subgroupOf I ≤ normalizer (L.subgroupOf I : Set I) := by
    rw [← subgroupOf_normalizer_eq hLI]
    exact comap_mono hYL
  have he := cComponent_eq_commutator_of_image (thompson_component_in hLJ hL) hnorm
    (d.starMap I) (QuotientGroup.mk'_surjective _) hq
    (d.star_commutator_ne_bot hLI hLM hC hN)
  have hm := congrArg (map I.subtype) he
  simpa only [map_commutator, map_subgroupOf_eq_of_le hLI,
    map_subgroupOf_eq_of_le hYI] using hm

/-- The local theta and orbit conclusions discharge the normalization
premise of the commutator argument. No ambient normality is required. -/
theorem thompson_component_eq_commutator_of_orbit {I L : Subgroup G}
    (hI : I ∈ d.Hplus)
    (hLJ : L ≤ Stellmacher.elementaryAbelianMaxJ I)
    (hL : (L.subgroupOf (Stellmacher.elementaryAbelianMaxJ I)).IsCComponent)
    (hθ : theta (d.MI I) = d.Yplus)
    (hindex : (normalizer (L : Set G)).relIndex I ≤ 2)
    (hLM : ¬ L ≤ d.M)
    (hC : I ⊓ centralizer (d.UI I : Set G) ≤ d.MI I)
    (hN : normalizer (d.starImage I d.Yplus : Set (d.Star I)) = d.starImage I d.M)
    (hq : Theory.GroupTheory.IsQuasisimple (d.starImage I L)) : L = ⁅L, d.Yplus⁆ := by
  have hYI : d.Yplus ≤ I := le_sup_left.trans hI.1.2
  have hY : IsPPerfect 2 d.Yplus := hθ ▸ ComponentIntersection.theta_isPPerfect (d.MI I)
  exact d.thompson_component_eq_commutator hLJ hL hYI
    (ComponentIntersection.normalizes_of_index_le_two hYI hY hindex) hLM hC hN hq

end LocalData
end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo
end
