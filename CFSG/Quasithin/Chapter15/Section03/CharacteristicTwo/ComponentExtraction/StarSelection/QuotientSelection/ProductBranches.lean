module

public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.ComponentExtraction.StarSelection.QuotientSelection.ProductBranches.Orbit
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.ComponentExtraction.StarSelection.QuotientSelection.Basic

/-!
# Escaping components in both B.5.6 product alternatives

An actual product of two source factors is generated by its ordinary
residual components, normal S₃ subgroups and any Sylow two-subgroup.
The S₃ coordinate classification bounds each ambient normalizer index
by two. The two-perfect normalization and residual dichotomy in `Basic`
then place every such S₃ in M. If every ordinary component also lay in M,
the Sylow intersection and generation theorem would give N ≤ M.

The adapters extract the actual group equivalences from all natural,
double-natural and exceptional-extension cases in B.5.6(3), and from
both hyperplane cases in B.5.6(5). They require neither a splitting of
the full module nor an additional normalization hypothesis.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), B.5.6,
printed p.105, and 15.3.15(2)/26(2), pp.1123–1126 and 1130.
-/

public section

open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.StarSelection.QuotientSelection.ProductBranches
open CFSG.Quasithin.Chapter15.Section04.LocalSetup.TwoFactors.FFBranch.ClassificationComparison.FFAlternatives
variable {D E : Type*} [Group D] [Group E]

private theorem model_of_equiv {F : Type*} [Group F] (e : F ≃* D)
    (h : FactorModel D) : FactorModel F := by
  cases h with
  | linearTwo K f => exact .linearTwo K (e.trans f)
  | symmetricFive f => exact .symmetricFive (e.trans f)
  | linearThree K ho f => exact .linearThree K ho (e.trans f)

variable {B : Type*} [Group B] [Finite B]
private theorem normal_factor_le (P : Sylow 2 B) (H : Subgroup B)
    (hPH : (P : Subgroup B) ≤ H)
    (hcomp : ∀ K : Subgroup B, IsComponent B K → K ≤ H)
    (hs3 : ∀ K : Subgroup B, K.Normal → Nonempty (K ≃* Equiv.Perm (Fin 3)) → K ≤ H)
    (F : Subgroup B) [F.Normal] (hF : FactorModel F) : F ≤ H := by
  rcases factor_structure hF with he | ⟨hq, hi, _⟩
  · exact hs3 F inferInstance he
  · let C := (solvableResidual F).map F.subtype
    let : C.Normal := inferInstance
    let := hq
    have hc : IsComponent B C :=
      ⟨(inferInstance : C.Normal).isSubnormal,
        IsQuasisimple.of_mulEquiv ((solvableResidual F).equivMapOfInjective
          F.subtype F.subtype_injective)⟩
    obtain ⟨T, hT⟩ := P.exists_subgroupOf_eq_of_normal F
    have hg := congrArg (fun K : Subgroup F => K.map F.subtype)
      (residual_sup_sylow_of_index T hi)
    rw [Subgroup.map_sup, ← MonoidHom.range_eq_map, range_subtype,
      hT, subgroupOf_map_subtype] at hg
    exact hg ▸ sup_le (hcomp C hc) (inf_le_left.trans hPH)

/-- The ordinary residual components, normal S₃ subgroups and a Sylow
two-subgroup generate every actual product of two source factors. -/
theorem eq_top_of_components_s3_sylow (e : B ≃* D × E)
    (hD : FactorModel D) (hE : FactorModel E) (P : Sylow 2 B) (H : Subgroup B)
    (hPH : (P : Subgroup B) ≤ H)
    (hcomp : ∀ K : Subgroup B, IsComponent B K → K ≤ H)
    (hs3 : ∀ K : Subgroup B, K.Normal → Nonempty (K ≃* Equiv.Perm (Fin 3)) → K ≤ H) :
    H = ⊤ := by
  let L := ((⊤ : Subgroup D).prod (⊥ : Subgroup E)).map e.symm.toMonoidHom
  let R := ((⊥ : Subgroup D).prod (⊤ : Subgroup E)).map e.symm.toMonoidHom
  let : L.Normal := (inferInstance : ((⊤ : Subgroup D).prod (⊥ : Subgroup E)).Normal).map
    _ e.symm.surjective
  let : R.Normal := (inferInstance : ((⊥ : Subgroup D).prod (⊤ : Subgroup E)).Normal).map
    _ e.symm.surjective
  let eL : L ≃* D := (e.symm.subgroupMap _).symm.trans firstEquiv
  let eR : R ≃* E := (e.symm.subgroupMap _).symm.trans
    { toFun := fun x => x.1.2
      invFun := fun y => ⟨(1, y), ⟨rfl, mem_top _⟩⟩
      left_inv := fun x => by apply Subtype.ext; exact Prod.ext x.property.1.symm rfl
      right_inv := fun _ => rfl
      map_mul' := fun _ _ => rfl }
  have hL := normal_factor_le P H hPH hcomp hs3 L (model_of_equiv eL hD)
  have hR := normal_factor_le P H hPH hcomp hs3 R (model_of_equiv eR hE)
  apply top_unique
  intro x _
  have h1 : e.symm ((e x).1, 1) ∈ H := hL (mem_map_of_mem _ ⟨mem_top _, rfl⟩)
  have h2 : e.symm (1, (e x).2) ∈ H := hR (mem_map_of_mem _ ⟨rfl, mem_top _⟩)
  have hm := H.mul_mem h1 h2
  simpa only [← map_mul, Prod.mk_mul_mk, mul_one, one_mul, Prod.mk.eta,
    e.symm_apply_apply] using hm

variable {A : Type*} [Group A] [Finite A]

/-- Escaping ordinary-component selection for an actual product of any two
B.5.6 factor models. No factor normalization or placement is assumed. -/
theorem exists_component_outside_of_product
    (N : Subgroup A) [N.Normal] (Y M : Subgroup A) (S : Sylow 2 A)
    (hY : IsPPerfect 2 Y) (hSM : (S : Subgroup A) ≤ M)
    (hN : normalizer (Y : Set A) = M) (hNM : ¬ N ≤ M)
    (e : N ≃* D × E) (hD : FactorModel D) (hE : FactorModel E) :
    ∃ K : Subgroup N, IsComponent N K ∧ ¬ K.map N.subtype ≤ M := by
  let : Finite (D × E) := Finite.of_equiv N e.toEquiv
  let : Finite D := Finite.of_surjective (Prod.fst : D × E → D) Prod.fst_surjective
  let : Finite E := Finite.of_surjective (Prod.snd : D × E → E) Prod.snd_surjective
  by_contra! hc
  obtain ⟨P, hP⟩ := S.exists_subgroupOf_eq_of_normal N
  have he : M.subgroupOf N = ⊤ := by
    apply eq_top_of_components_s3_sylow e hD hE P
    · rw [hP]
      exact comap_mono hSM
    · intro K hK
      exact map_le_iff_le_comap.mp (hc K hK)
    · intro K hn ⟨eK⟩
      let := hn
      have hi := normal_s3_normalizer_index N e hD hE K eK
      exact map_le_iff_le_comap.mp
        (symmetricThree_le_of_small_normalizer_index (K.map N.subtype) Y M
          ((K.equivMapOfInjective N.subtype N.subtype_injective).symm.trans eK)
          S hi hY hSM hN)
  exact hNM (subgroupOf_eq_top.mp he)

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]

/-- B.5.6(3), including natural, double-natural and exceptional extension actions. -/
theorem exists_component_outside_of_twoFactors
    (N : Subgroup A) [N.Normal] (Y M : Subgroup A) (S : Sylow 2 A)
    (hY : IsPPerfect 2 Y) (hSM : (S : Subgroup A) ≤ M)
    (hN : normalizer (Y : Set A) = M) (hNM : ¬ N ≤ M)
    (ρ : Representation (ZMod 2) N V) (c : SourceTwoFactorCase ρ) :
    ∃ K : Subgroup N, IsComponent N K ∧ ¬ K.map N.subtype ≤ M :=
  exists_component_outside_of_product N Y M S hY hSM hN hNM c.product.equiv.symm
    (c.firstCase.factorModel ρ) (c.secondCase.factorModel ρ)

/-- B.5.6(5), covering both second-factor actions without splitting the hyperplane extension. -/
theorem exists_component_outside_of_hyperplane
    (N : Subgroup A) [N.Normal] (Y M : Subgroup A) (S : Sylow 2 A)
    (hY : IsPPerfect 2 Y) (hSM : (S : Subgroup A) ≤ M)
    (hN : normalizer (Y : Set A) = M) (hNM : ¬ N ≤ M)
    (ρ : Representation (ZMod 2) N V) (c : HyperplaneCase ρ) :
    ∃ K : Subgroup N, IsComponent N K ∧ ¬ K.map N.subtype ≤ M :=
  exists_component_outside_of_product N Y M S hY hSM hN hNM c.product.equiv.symm
    (.linearThree BinaryField.two (by decide) c.firstEquiv) (c.secondCase.factorModel ρ)

end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.StarSelection.QuotientSelection.ProductBranches
