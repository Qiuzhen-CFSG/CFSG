module

public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.SmallExtension.MarkedMS.G2Reconstruction.DistanceTwo.DistanceFour.NaturalCommutator
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.SmallExtension.MarkedMS.G2Reconstruction.DistanceTwo.DistanceFour.Recognition
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.SmallExtension.MarkedMS.G2Reconstruction.DistanceTwo.DistanceFour.DerivedMidpoint

/-!
# Applying the G₂ radius obstruction to the critical-distance contract

The radius group is generated by its moving part and an elementary edge
radius. The actual natural critical image then forces [Vcirc,V] to have
order at least eight at a critical midpoint. Hence the source order-two
bound suffices for the unchanged distance-four exclusion contract.

`FixedRadiusInput` is the remaining obligation of the whole-core
reconstruction owner, qt-e-ms-small-g2-reconstruction. `Displacement`
constructs the projected offender, residual generation, and zero fixed space
of the whole moving central quotient in the fixed-derived branch.
`Recognition` proves its whole natural recognition, and `NaturalCommutator`
then gives the radius bound. The earlier conditional interfaces remain
available. `RadiusImage` proves the unconditional order-two bound for the
derived-radius image at a distance-two vertex, starting the remaining source
argument. `DerivedMidpoint` lifts this bound through the literal quotient
and Frattini action, placing the derived radius in every distance-two kernel
and bounding the whole radius image by eight. Neither derived fixation nor a radius bound is a hypothesis of
the original SmallMSPair.
Source: MS93 (3.8), printed pp.878--879.
-/

@[expose] public section
open Subgroup Theory.GroupTheory Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS
open ChapterC BinaryMS.MS93
namespace G2Reconstruction.DistanceTwo.DistanceFour
universe u

/-- The remaining radius calculation, stated on the literal moving subgroup.
The owner must discharge it before claiming unconditional reconstruction. -/
def RadiusTwoBoundInput : Prop :=
  ∀ (J : Type u) [Group J] [Finite J] (L R : Subgroup J)
    (h : SmallMSPair KnownSimple.IsKnownSimple L R),
    ((L ⧸ centralPreimage (pCore 2 L)) ≃* commutator (Atlas.G2.Model (ZMod 2))) →
    (geometry h).b (R.subgroupOf (L ⊔ R)) = 4 → LocalControl h →
    ∀ c : Vertex (R.subgroupOf (L ⊔ R)), color (R.subgroupOf (L ⊔ R)) c = false →
      Nat.card (⁅Vcirc (R.subgroupOf (L ⊔ R)) c,V (R.subgroupOf (L ⊔ R)) c⁆ :
        Subgroup (FreeAmalgam (R.subgroupOf (L ⊔ R)))) ≤ 2

/-- The actual midpoint contradiction supplies the published exclusion input. -/
theorem distanceFourExclusion_of_radiusTwoBound
    (hbound : RadiusTwoBoundInput.{u}) : DistanceFourExclusionInput.{u} := by
  intro J _ _ L R h e hb hloc
  exact false_of_small_moving_commutator h e hb (hbound J L R h e hb hloc)

/-- Source data still to be constructed by this owner: the derived radius
is residual-fixed and its whole moving central quotient has the literal
natural marking. Neither clause is part of the original SmallMSPair. -/
def FixedNaturalRadiusInput : Prop :=
  ∀ (J : Type u) [Group J] [Finite J] (L R : Subgroup J)
    (h : SmallMSPair KnownSimple.IsKnownSimple L R),
    ((L ⧸ centralPreimage (pCore 2 L)) ≃* commutator (Atlas.G2.Model (ZMod 2))) →
    (geometry h).b (R.subgroupOf (L ⊔ R)) = 4 → LocalControl h →
    ∀ c : Vertex (R.subgroupOf (L ⊔ R)), color (R.subgroupOf (L ⊔ R)) c = false →
      ⁅V (R.subgroupOf (L ⊔ R)) c,V (R.subgroupOf (L ⊔ R)) c⁆ ≤
        fixedCore (R.subgroupOf (L ⊔ R)) c ∧
      ∃ d : Comparison.EndpointModel (R.subgroupOf (L ⊔ R)) c,
        Nonempty (MovingCentralModel c d)

/-- The invariant commutator-form calculation supplies the existing radius
bound, retaining the preceding source construction as an explicit input. -/
theorem radiusTwoBound_of_fixedNaturalRadius
    (hnatural : FixedNaturalRadiusInput.{u}) : RadiusTwoBoundInput.{u} := by
  intro J _ _ L R h e hb hloc c hc
  obtain ⟨hfixed,d,⟨m⟩⟩ := hnatural J L R h e hb hloc c hc
  exact moving_commutator_card_le_two_of_natural h (by omega) c hc hfixed d m

/-- The literal critical commutator has at least eight elements, contradicting
the bound on the whole moving commutator in the fixed natural branch. -/
theorem distanceFourExclusion_of_fixedNaturalRadius
    (hnatural : FixedNaturalRadiusInput.{u}) : DistanceFourExclusionInput.{u} :=
  distanceFourExclusion_of_radiusTwoBound (radiusTwoBound_of_fixedNaturalRadius hnatural)

/-- The remaining source obligation is residual fixation of the derived
radius. Whole natural recognition no longer occurs as an extra premise. -/
def FixedRadiusInput : Prop :=
  ∀ (J : Type u) [Group J] [Finite J] (L R : Subgroup J)
    (h : SmallMSPair KnownSimple.IsKnownSimple L R),
    ((L ⧸ centralPreimage (pCore 2 L)) ≃* commutator (Atlas.G2.Model (ZMod 2))) →
    (geometry h).b (R.subgroupOf (L ⊔ R)) = 4 → LocalControl h →
    ∀ c : Vertex (R.subgroupOf (L ⊔ R)), color (R.subgroupOf (L ⊔ R)) c = false →
      ⁅V (R.subgroupOf (L ⊔ R)) c,V (R.subgroupOf (L ⊔ R)) c⁆ ≤
        fixedCore (R.subgroupOf (L ⊔ R)) c

/-- Whole quotient recognition and invariant commutator forms establish the
radius bound from derived fixation alone. -/
theorem radiusTwoBound_of_fixedRadius (hfixed : FixedRadiusInput.{u}) :
    RadiusTwoBoundInput.{u} := by
  intro J _ _ L R h e hb hloc c hc
  exact moving_commutator_card_le_two_of_fixed h e (by omega) c hc
    (hfixed J L R h e hb hloc c hc)

/-- The entire fixed-derived branch of the distance-four configuration is
excluded by the actual critical-image lower bound. -/
theorem distanceFourExclusion_of_fixedRadius (hfixed : FixedRadiusInput.{u}) :
    DistanceFourExclusionInput.{u} :=
  distanceFourExclusion_of_radiusTwoBound (radiusTwoBound_of_fixedRadius hfixed)

end G2Reconstruction.DistanceTwo.DistanceFour
end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS
