module
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.SmallExtension.MarkedMS.AlternatingSixReconstruction.Exceptional.Exhaustion.LargeDistance.CubicRadiusCenter

/-!
# Noncentral factors forced by the cubic radius center

A normal subgroup of the radius center is fixed modulo the initial seed
whenever the radius is nonabelian and its quotient has just one noncentral
chief factor. Indeed, the unique-factor dichotomy would otherwise put the
full residual movement in that central subgroup times the seed. The radius
would then be generated by its abelian incident edge radius and a central
subgroup, making it abelian.

In the remaining point-core branch, the selected order-two commutator
proves that the original radius is nonabelian, while CubicRadiusCenter
proves that its central involutions move modulo the seed. Consequently
every chief series of the literal V_alpha/Z_alpha image has at least two
noncentral factors. The existing cubic-aware chief-factor bound then forces
fixed index at least sixteen for every actor whose original S6 image
contains an even involution.

Both whole-core and C.1.32 consumers retain the original projection kernel
E, its nontrivial odd quotient, both moving covers and the plane/Sylow
branches. The fixed-index lower bound is an obstruction still to exclude;
no small even-actor index or natural radius marking is assumed or proved.
The large-critical-image uniqueness theorem does not apply to this branch,
where all critical seed images have order two. The remaining source
comparison and both final reconstruction outcomes remain open.

Source: Meierfrankenfeld--Stellmacher, *Pushing up weak BN-pairs of rank two*
(1993), the center containment in (3.10)(ii), printed p.881, and the
single-factor argument in (5.2)(i), printed p.914; Aschbacher--Smith
C.1.31--32, printed pp.135--136.
-/

public noncomputable section
open Subgroup Theory.GroupTheory NoncentralChiefRefinement
open Theory.SpecificGroups.SymmetricSix Theory.SpecificGroups.SymmetricSix.BinaryFlags
open CFSG.Quasithin.ChapterC.BinaryMS.MS93 Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality
open CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup
open CFSG.Quasithin.ChapterC.NaturalSixControl
open CFSG.Quasithin.ChapterC.BinaryMS.MS93.NaturalStructure.Exclusion
open scoped IsMulCommutative commutatorElement Pointwise
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS
namespace AlternatingSixReconstruction.Exceptional.Exhaustion.LargeDistance.CubicFull
universe u
variable {G : Type u} [Group G] [Finite G] {L R : Subgroup G}
  (h : SmallMSPair KnownSimple.IsKnownSimple L R) (e : CentralMarking L)
  (hz : Nat.card (center (L ⧸ pCore 2 L)) = 3)
  (hk : layerKernel L R = extensionKernel h)
local notation "M" => (L ⊔ R : Subgroup G)
local notation "Rg" => edge L R
local notation "π" => CubicAction.projection h e hz hk

include h in
/-- A unique noncentral radius factor gives the source residual dichotomy
for any normal subgroup of the original radius, through its literal quotient. -/
theorem radius_normal_dichotomy_of_unique
    (hb : 2 < sourceDistance h)
    (s : SeriesOn (radiusQuotient L R)) (hs : s.noncentralCount = 1)
    (Y : Subgroup M) [Y.Normal] (hY : Y ≤ radiusPreimage L R) :
    ⁅Y,L.subgroupOf M⁆ ≤ radiusSeed L R ∨
      ⁅radiusPreimage L R,L.subgroupOf M⁆ ≤ Y ⊔ radiusSeed L R := by
  let q := QuotientGroup.mk' (radiusSeed L R)
  let : (Y.map q).Normal := Subgroup.Normal.map inferInstance q (QuotientGroup.mk'_surjective _)
  have hV : radiusPreimage L R ≤ pCore 2 M := by
    have hh := comap_mono (f := embedM Rg) (V_le_Q Rg
      (geometry := sourceGeometry h) (a := alpha Rg) rfl hb)
    rwa [Q_alpha_comap Rg h.relative_radical.isPGroup
      h.relative_radical.twoCore_le] at hh
  have htwo : IsPGroup 2 (radiusQuotient L R) :=
    (pCore_isPGroup.to_le hV).map q
  have hres : (L.subgroupOf M).map q = pResidual 2 (M ⧸ radiusSeed L R) := by
    rw [←h.relative_residual,map_pResidual_quotient]
  rcases s.residual_dichotomy_of_count_one htwo hs (Y.map q) (map_mono hY) with hf | hc
  · left
    have hh : (⁅Y,L.subgroupOf M⁆).map q = ⊥ := by rwa [map_commutator,hres]
    simpa only [q,QuotientGroup.ker_mk'] using (Subgroup.map_eq_bot_iff _).mp hh
  · right
    have hh : (⁅radiusPreimage L R,L.subgroupOf M⁆).map q ≤ Y.map q := by
      rwa [map_commutator,hres]
    simpa only [comap_map_eq,q,QuotientGroup.ker_mk'] using map_le_iff_le_comap.mp hh

private theorem commutative_of_central_supplement {F : Type*} [Group F]
    (V A C : Subgroup F) [IsMulCommutative A]
    (hAV : A ≤ V) (hCV : C ≤ V) (hC : C ≤ centralizer (V : Set F))
    (hcover : V ≤ A ⊔ C) : IsMulCommutative V := by
  have hsup : A ⊔ C ≤ centralizer ((A ⊔ C : Subgroup F) : Set F) := by
    apply sup_le
    · exact le_centralizer_iff.mpr (sup_le A.le_centralizer
        (hC.trans (centralizer_le hAV)))
    · exact hC.trans (centralizer_le (sup_le hAV hCV))
  exact le_centralizer_iff_isMulCommutative.mp
    (hcover.trans (hsup.trans (centralizer_le hcover)))

include h in
/-- In a nonabelian radius with a unique noncentral quotient factor, every
normal central subgroup is fixed by the component modulo the full seed. -/
theorem radius_central_normal_fixed_of_unique
    (hb : 2 < sourceDistance h)
    (s : SeriesOn (radiusQuotient L R)) (hs : s.noncentralCount = 1)
    (hn : ¬ IsMulCommutative (radiusPreimage L R))
    (Y : Subgroup M) [Y.Normal] (hY : Y ≤ radiusPreimage L R)
    (hYC : Y ≤ centralizer (radiusPreimage L R : Set M)) :
    ⁅Y,L.subgroupOf M⁆ ≤ radiusSeed L R := by
  rcases radius_normal_dichotomy_of_unique h hb s hs Y hY with hf | hc
  · exact hf
  exfalso
  apply hn
  let E := (V Rg (beta Rg)).comap (embedM Rg)
  have hEV : E ≤ radiusPreimage L R :=
    comap_mono (edge_radius_le_radius rfl (base_adjacent Rg))
  have hZE : radiusSeed L R ≤ E := by
    apply comap_mono
    apply le_iSup_of_le (alpha Rg)
    apply le_iSup_of_le (show (cosetGraph Rg).dist (alpha Rg) (beta Rg) ≤ 2 from ?_)
    · exact le_rfl
    · exact (SimpleGraph.dist_eq_one_iff_adj.mpr
        ((cosetGraph_adj Rg _ _).mpr (base_adjacent Rg))).le.trans (by decide)
  let : IsMulCommutative E := by
    let := edge_radius_commutative (sourceGeometry h) hb (alpha Rg) (beta Rg)
      rfl (base_adjacent Rg)
    apply le_centralizer_iff_isMulCommutative.mp
    intro x hx y hy
    apply embedM_injective Rg
    simpa only [map_mul] using
      (V Rg (beta Rg)).le_centralizer hx (embedM Rg y) hy
  apply commutative_of_central_supplement (radiusPreimage L R) E Y hEV hY hYC
  exact (radius_comap_le_edge_sup_commutator (h := h) hb).trans
    (sup_le le_sup_left (hc.trans (sup_le le_sup_right (hZE.trans le_sup_left))))

include h e hz hk in
/-- The selected commutator of order two certifies noncommutativity of
the whole radius in the original vertex group. -/
theorem point_radius_noncommutative
    (u : S) (hR : (Rg).map π ≤ pointCore.map (MulAut.conj u).toMonoidHom) :
    ¬ IsMulCommutative (radiusPreimage L R) := by
  intro hcom
  let := hcom
  have hb := distance_gt_two h e hz hk
  have hV : IsMulCommutative (V Rg (alpha Rg)) := by
    rw [←radius_comap_map (h := h) hb]
    exact Subgroup.map_isMulCommutative (radiusPreimage L R) (embedM Rg)
  obtain ⟨a',p,hcard,_,_⟩ := point_image_selected_span_radius_line h e hz hk u hR
  have hPV : localZSpan Rg (p.walk.getVert 2) (alpha Rg) ≤ V Rg (alpha Rg) :=
    localZSpan_le_V Rg (by
      rw [SimpleGraph.dist_comm,p.dist_start (by
        have hl : 2 < p.walk.length := p.length_eq_b ▸ hb
        omega)])
  have hPC : localZSpan Rg (p.walk.getVert 2) (alpha Rg) ≤
      centralizer (localZSpan Rg (p.walk.getVert 2) (alpha Rg) : Set (FreeAmalgam Rg)) :=
    hPV.trans ((le_centralizer_iff_isMulCommutative.mpr hV).trans (centralizer_le hPV))
  rw [commutator_eq_bot_iff_le_centralizer.mpr hPC,card_bot] at hcard
  omega

include h e hz hk in
/-- The actual point-core branch forces at least two noncentral factors
in every chief series of the original radius image modulo its full seed. -/
theorem point_radius_two_noncentral_factors
    (u : S) (hR : (Rg).map π ≤ pointCore.map (MulAut.conj u).toMonoidHom)
    (s : SeriesOn (radiusQuotient L R)) : 2 ≤ s.noncentralCount := by
  have hb := distance_gt_two h e hz hk
  have hV : radiusPreimage L R ≤ pCore 2 M := by
    have hh := comap_mono (f := embedM Rg) (V_le_Q Rg
      (geometry := sourceGeometry h) (a := alpha Rg) rfl hb)
    rwa [Q_alpha_comap Rg h.relative_radical.isPGroup
      h.relative_radical.twoCore_le] at hh
  have htwo : IsPGroup 2 (radiusQuotient L R) :=
    (pCore_isPGroup.to_le hV).map (QuotientGroup.mk' (radiusSeed L R))
  have hpos : s.noncentralCount ≠ 0 := by
    intro hs
    have hh := s.series.residual_commutator_le_head_of_central_steps
      (show IsPGroup 2 s.series.last.val by rw [s.last_eq]; exact htwo)
      (s.noncentralCount_eq_zero_iff.mp hs)
    rw [s.last_eq,s.head_eq] at hh
    exact radiusQuotient_moving_ne_bot h e hz hk hb (le_bot_iff.mp hh)
  have hne : s.noncentralCount ≠ 1 := by
    intro hs
    let Y := Stellmacher.omegaOneCenterAmbient (radiusPreimage L R)
    let : Y.Normal := by
      apply normalizer_eq_top_iff.mp
      apply top_unique
      intro x hx
      rw [mem_normalizer_iff_map_conj_eq]
      change Y.map (MulAut.conj x).toMonoidHom = Y
      rw [←Stellmacher.omegaOneCenterAmbient_map_injective _ (MulAut.conj x).injective,
        MulEquiv.toMonoidHom_eq_coe,
        mem_normalizer_iff_map_conj_eq.mp
          ((radiusPreimage L R).le_normalizer_of_normal (mem_top x))]
    have hYV : Y ≤ radiusPreimage L R := fun x hx =>
      ((Stellmacher.mem_omegaOneCenterAmbient_iff _ _).mp hx).1
    have hYC : Y ≤ centralizer (radiusPreimage L R : Set M) := fun x hx =>
      ((Stellmacher.mem_omegaOneCenterAmbient_iff _ _).mp hx).2.2
    have hf := radius_central_normal_fixed_of_unique h hb s hs
      (point_radius_noncommutative h e hz hk u hR) Y hYV hYC
    have hm := map_mono (f := embedM Rg) hf
    have hL : (L.subgroupOf M).map (embedM Rg) = Ltilde Rg (alpha Rg) := by
      rw [Ltilde_alpha,h.relative_residual]
    have hZ : (radiusSeed L R).map (embedM Rg) = Z Rg (alpha Rg) :=
      map_comap_eq_self ((Z_le_stabilizer Rg _).trans_eq (stabilizer_m_base Rg))
    rw [map_commutator,hL,hZ] at hm
    have hYm : Y.map (embedM Rg) = Stellmacher.omegaOneCenterAmbient (V Rg (alpha Rg)) := by
      rw [←Stellmacher.omegaOneCenterAmbient_map_injective _ (embedM_injective Rg),
        radius_comap_map (h := h) hb]
    rw [hYm] at hm
    exact point_radius_omega_center_component_movement h e hz hk u hR hm
  omega

include h e hz hk in
/-- Every actor containing an even involution in the original S₆ image has
fixed index at least sixteen on the full radius quotient in the point-core
branch. The quotient is by Z_alpha and the projection kernel remains E. -/
theorem point_radius_even_actor_index
    (u : S) (hR : (Rg).map π ≤ pointCore.map (MulAut.conj u).toMonoidHom)
    (A : Subgroup M) (a : S) (ha : orderOf a = 2)
    (heven : a ∈ alternatingGroup (Fin 6)) (haA : a ∈ A.map π) :
    16 ≤ (centralizer (A.map (QuotientGroup.mk' (radiusSeed L R)) :
      Set (M ⧸ radiusSeed L R))).relIndex (radiusQuotient L R) := by
  have hb := distance_gt_two h e hz hk
  let q := QuotientGroup.mk' (radiusSeed L R)
  have hV : radiusPreimage L R ≤ pCore 2 M := by
    have hh := comap_mono (f := embedM Rg) (V_le_Q Rg
      (geometry := sourceGeometry h) (a := alpha Rg) rfl hb)
    rwa [Q_alpha_comap Rg h.relative_radical.isPGroup
      h.relative_radical.twoCore_le] at hh
  have htwo : IsPGroup 2 (radiusQuotient L R) :=
    (pCore_isPGroup.to_le hV).map q
  obtain ⟨s⟩ := SeriesOn.exists_series (radiusQuotient L R)
  have hnot : ¬ (centralizer (A.map q : Set (M ⧸ radiusSeed L R))).relIndex
      (radiusQuotient L R) ≤ 8 := by
    intro hi
    have hupper := quotient_noncentralCount_le_one h e hz hk q
      (QuotientGroup.mk'_surjective _) (radiusQuotient L R) htwo A a ha heven haA hi s
    have hlower := point_radius_two_noncentral_factors h e hz hk u hR s
    omega
  obtain ⟨n,hn⟩ := htwo.index
    ((centralizer (A.map q : Set (M ⧸ radiusSeed L R))).subgroupOf (radiusQuotient L R))
  change (centralizer (A.map q : Set (M ⧸ radiusSeed L R))).relIndex
    (radiusQuotient L R) = 2^n at hn
  have hn4 : 4 ≤ n := by
    by_contra! hn4
    have hpow := Nat.pow_le_pow_right (by decide : 1 ≤ 2) (show n ≤ 3 by omega)
    exact hnot (by simpa only [hn] using hpow)
  change 16 ≤ (centralizer (A.map q : Set (M ⧸ radiusSeed L R))).relIndex
    (radiusQuotient L R)
  rw [hn]
  exact Nat.pow_le_pow_right (by decide : 1 ≤ 2) hn4


omit hk in
include h e hz in
/-- Whole-core application of the radius-center comparison. The point-core
branch requires at least two noncentral factors and fixed index at least
sixteen for every marked even actor. Plane and Sylow images remain. -/
theorem coreExhaustion_or_cubic_radius_factors :
    CoreExhaustion L R ∨ ∃ hk : layerKernel L R = extensionKernel h,
      Function.Surjective (CubicAction.projection h e hz hk) ∧
      2 < sourceDistance h ∧
      (∀ a : Vertex Rg, color Rg a = false →
        Nat.card (U Rg a) = 16 ∨ Nat.card (U Rg a) = 32) ∧
      ∃ u : S,
        ((Rg).map (CubicAction.projection h e hz hk) =
            pointCore.map (MulAut.conj u).toMonoidHom ∧
          sourceDistance h = 4 ∧
          (∀ s : SeriesOn (radiusQuotient L R), 2 ≤ s.noncentralCount) ∧
          ∀ (A : Subgroup M) (a : S), orderOf a = 2 →
            a ∈ alternatingGroup (Fin 6) →
            a ∈ A.map (CubicAction.projection h e hz hk) →
            16 ≤ (centralizer (A.map (QuotientGroup.mk' (radiusSeed L R)) :
              Set (M ⧸ radiusSeed L R))).relIndex (radiusQuotient L R)) ∨
        (Rg).map (CubicAction.projection h e hz hk) =
          D.map (MulAut.conj u).toMonoidHom ∨
        (Rg).map (CubicAction.projection h e hz hk) =
          borel.map (MulAut.conj u).toMonoidHom := by
  rcases coreExhaustion_or_cubic_radical_cases h e hz with
    hx | ⟨hk,hs,hb,hcovers,u,hpoint | hplane | hsylow⟩
  · exact Or.inl hx
  · exact Or.inr ⟨hk,hs,hb,hcovers,u,Or.inl ⟨hpoint.2,hpoint.1,
      point_radius_two_noncentral_factors h e hz hk u hpoint.2.le,
      point_radius_even_actor_index h e hz hk u hpoint.2.le⟩⟩
  · exact Or.inr ⟨hk,hs,hb,hcovers,u,Or.inr (Or.inl hplane)⟩
  · exact Or.inr ⟨hk,hs,hb,hcovers,u,Or.inr (Or.inr hsylow)⟩

omit hk in
include h e hz in
/-- Literal C.1.32 application, retaining the original projection, the
whole radius quotient and both moving covers in all radical-image branches. -/
theorem rankTwo_or_cubic_radius_factors :
    RankTwoAlternatives L R ∨ ∃ hk : layerKernel L R = extensionKernel h,
      Function.Surjective (CubicAction.projection h e hz hk) ∧
      2 < sourceDistance h ∧
      (∀ a : Vertex Rg, color Rg a = false →
        Nat.card (U Rg a) = 16 ∨ Nat.card (U Rg a) = 32) ∧
      ∃ u : S,
        ((Rg).map (CubicAction.projection h e hz hk) =
            pointCore.map (MulAut.conj u).toMonoidHom ∧
          sourceDistance h = 4 ∧
          (∀ s : SeriesOn (radiusQuotient L R), 2 ≤ s.noncentralCount) ∧
          ∀ (A : Subgroup M) (a : S), orderOf a = 2 →
            a ∈ alternatingGroup (Fin 6) →
            a ∈ A.map (CubicAction.projection h e hz hk) →
            16 ≤ (centralizer (A.map (QuotientGroup.mk' (radiusSeed L R)) :
              Set (M ⧸ radiusSeed L R))).relIndex (radiusQuotient L R)) ∨
        (Rg).map (CubicAction.projection h e hz hk) =
          D.map (MulAut.conj u).toMonoidHom ∨
        (Rg).map (CubicAction.projection h e hz hk) =
          borel.map (MulAut.conj u).toMonoidHom :=
  (coreExhaustion_or_cubic_radius_factors h e hz).imp (rankTwo_of_exhaustion h e hz) id

end AlternatingSixReconstruction.Exceptional.Exhaustion.LargeDistance.CubicFull
