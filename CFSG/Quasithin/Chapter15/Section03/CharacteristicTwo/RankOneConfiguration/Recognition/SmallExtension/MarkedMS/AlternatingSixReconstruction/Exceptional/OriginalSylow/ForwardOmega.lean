module
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.SmallExtension.MarkedMS.AlternatingSixReconstruction.Exceptional.OriginalSylow.ForwardSpan
public import Theory.GroupTheory.Commutator.NilpotentSaturation
import all CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.SmallExtension.MarkedMS.AlternatingSixReconstruction.Exceptional.OriginalSylow.DistinctShifts
import all CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.SmallExtension.MarkedMS.AlternatingSixReconstruction.Exceptional.Exhaustion.LargeDistance.CubicSmallBackward

import all CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.SmallExtension.MarkedMS.AlternatingSixReconstruction.Exceptional.OriginalSylow.ForwardCollapse
import all CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.SmallExtension.MarkedMS.AlternatingSixReconstruction.Exceptional.Exhaustion.LargeDistance.CubicOmegaGeneration
import all CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.SmallExtension.MarkedMS.AlternatingSixReconstruction.Exceptional.Exhaustion.LargeDistance.CubicOrbitKernelControl
/-!
# Full omega generation in the Borel small-slice countercase

Apply the full-omega dichotomy to the reversed shifted critical pair. If
central generation fails, it controls the entire seed orbit modulo the
starting seed and its commutator with the full reverse omega kernel.
This larger kernel still lies in the second two-core and normalizes the
seed orbit. The resulting normal radius subgroup collapses, by residual
edge generation and nilpotent commutator saturation, to the original
small two-seed subgroup. Its Baumann-slice containment contradicts escape.

Thus X is generated by U and its whole-stabilizer fixed part at every
component vertex, and X equals the full seed Z. This also excludes the
distinct opposite mover containing the starting core, removing precisely
the second alternative of source (5.5)(c) from the next R₃ comparison.
The literal original-source application retains both full covers and all
central attachments, the same paths and transporter, and the cubic E/Q.

Source: Meierfrankenfeld--Stellmacher, Pushing up weak BN-pairs of rank two
(1993), (3.3)(ii) and (5.9), printed p.921, the omega-generation clause in
(††). Full-stabilizer centrality of R₃, whole-span stabilization, strict
forward slices and the terminal distance exclusions are still required
for whole-core exhaustion and exceptional block reconstruction.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender BinaryPermutation
open scoped IsMulCommutative commutatorElement Pointwise
open Theory.SpecificGroups.SymmetricSix Theory.SpecificGroups.SymmetricSix.BinaryFlags CoreCrossing
open CFSG.Quasithin.ChapterC.BinaryMS.MS93 Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup
open CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS
namespace AlternatingSixReconstruction.Exceptional.Exhaustion.LargeDistance.CubicFull
open AlternatingSixReconstruction.Exceptional.OriginalSylow
universe u
variable {G : Type u} [Group G] [Finite G] {L R : Subgroup G}
  {h : SmallMSPair KnownSimple.IsKnownSimple L R} (e : CentralMarking L)
  (hz : Nat.card (center (L ⧸ pCore 2 L)) = 3)
  (hk : layerKernel L R = extensionKernel h)
local notation "Rg" => edge L R
namespace SmallSliceShift
variable {a' : Vertex (edge L R)}
  {p : CriticalPath (edge L R) (sourceGeometry h) (alpha (edge L R)) a'}
  (s : SmallSliceShift h p)

include e hz hk in
private theorem borel_omega_orbit_control_impossible
    (hb : 4 < sourceDistance h) (u : Equiv.Perm (Fin 6))
    (hR : (Rg).map (CubicAction.projection h e hz hk) =
      Theory.SpecificGroups.SymmetricSix.borel.map (MulAut.conj u).toMonoidHom)
    (hcontrol : ⁅s.seedOrbit,X Rg s.endpoint⁆ ≤
      Z Rg (p.walk.getVert 2) ⊔ ⁅s.seedOrbit,X Rg s.endpoint ⊓ Q Rg (p.walk.getVert 2)⁆) : False := by
  let c := p.walk.getVert 2
  let t := act Rg s.conjugator⁻¹ (p.walk.getVert 1)
  let D := s.seedOrbit ⊔ Z Rg c
  let Y := Z Rg s.centerVertex ⊔ Z Rg c
  let N := ⁅D,Q Rg c⁆ ⊔ Z Rg c
  have hb2 : 2 < sourceDistance h := by omega
  have hc : color Rg c = false := s.path.start_color
  have hl : p.walk.length = sourceDistance h := p.length_eq_b
  have hat : Adjacent Rg s.centerVertex t := by
    apply (adjacent_act_iff Rg s.conjugator⁻¹ _ _).mpr
    apply (cosetGraph_adj Rg _ _).mp
    simpa only [SimpleGraph.Walk.getVert_zero] using
      p.walk.adj_getVert_succ (i := 0) (by omega)
  have hct : Adjacent Rg c t := by
    have hh := adjacent_symm Rg
      ((cosetGraph_adj Rg _ _).mp (p.walk.adj_getVert_succ (i := 1) (by omega)))
    simpa only [s.fixes_second] using (adjacent_act_iff Rg s.conjugator⁻¹ _ _).mpr hh
  have ht : color Rg t = true := by
    have hh := adjacent_color_ne Rg hct
    rw [hc] at hh
    cases he : color Rg t <;> simp_all
  have hdist : (cosetGraph Rg).dist c s.centerVertex ≤ 2 :=
    CFSG.Quasithin.ChapterC.Sp4Four.DistanceReduction.neighbor_distance_le_two hat hct
  have hDV : D ≤ V Rg c := sup_le (s.seedOrbit_radius_and_escape e hz hb2).1
    (Z_le_VBall Rg c 2)
  have hDQ : D ≤ Q Rg c := hDV.trans ((sourceGeometry h).V_le_Q hb2 c hc)
  have hDG : D ≤ stabilizer Rg c := hDQ.trans (fun _ hx => hx.1)
  have hEG : Z Rg s.endpoint ≤ stabilizer Rg c :=
    critical_Z_le_stabilizer Rg (sourceGeometry h) c hc
      (by rw [(sourceGeometry h).distance_constant c hc]; exact sourceDistance_pos h)
      s.path.critical
  let K := X Rg s.endpoint ⊓ Q Rg c
  let H := ⁅s.seedOrbit,K⁆
  have hHX : H ≤ s.seedOrbit := le_normalizer_iff_commutator_le_left.mp
    (inf_le_right.trans ((s.second_core_le_lineCentralizer hb2).trans
      s.centralizer_orbits_normalized.1))
  have hRD : H ≤ D := hHX.trans le_sup_left
  have hZeX : Z Rg s.endpoint ≤ X Rg s.endpoint :=
    (sourceGeometry h).omega_bound _ s.path.end_color (by
      rw [(sourceGeometry h).distance_constant _ s.path.end_color]
      exact sourceDistance_pos h)
  have hseedControl : ⁅s.seedOrbit,Z Rg s.endpoint⁆ ≤ Z Rg c ⊔ H :=
    (commutator_mono le_rfl hZeX).trans hcontrol
  have hDN : stabilizer Rg c ≤ normalizer (D : Set (FreeAmalgam Rg)) := by
    rw [←s.centralizer_orbits_normalized.2.2]
    apply sup_le
    · exact (le_inf s.centralizer_orbits_normalized.1
        (inf_le_left.trans (Z_normalized Rg c))).trans
          (normalizer_inf_normalizer_le_normalizer_sup _ _)
    · have hEN := hEG.trans (Z_normalized Rg c)
      have hE : ⁅s.seedOrbit,Z Rg s.endpoint⁆ ≤ D :=
        hseedControl.trans (sup_le le_sup_right hRD)
      apply le_normalizer_iff.mpr
      intro x hx v hv
      have hm : D.map (MulAut.conj x).toMonoidHom ≤ D := by
        rw [Subgroup.map_sup]
        refine sup_le ?_ ((mem_normalizer_iff_map_conj_eq.mp (hEN hx)).le.trans le_sup_right)
        rintro _ ⟨y,hy,rfl⟩
        rw [commutator_comm] at hE
        have hm := D.mul_mem (hE (commutator_mem_commutator hx hy)) (mem_sup_left hy)
        simpa [MulAut.conj_apply,commutatorElement_def,mul_assoc] using hm
      exact hm (mem_map_of_mem (MulAut.conj x).toMonoidHom hv)
  have hYD : Y ≤ D := sup_le
    ((le_conjugateSpanBy (Z Rg s.centerVertex) s.lineCentralizer).trans le_sup_left) le_sup_right
  have hNN : stabilizer Rg c ≤ normalizer (N : Set (FreeAmalgam Rg)) := by
    intro g hg
    rw [mem_normalizer_iff_map_conj_eq]
    dsimp only [N]
    rw [Subgroup.map_sup,map_commutator,mem_normalizer_iff_map_conj_eq.mp (hDN hg),
      mem_normalizer_iff_map_conj_eq.mp (Q_normalized Rg c hg),
      mem_normalizer_iff_map_conj_eq.mp (Z_normalized Rg c hg)]
  have hND : N ≤ D := sup_le
    (le_normalizer_iff_commutator_le_left.mp ((show Q Rg c ≤ stabilizer Rg c from
      fun _ hx => hx.1).trans hDN)) le_sup_right
  have hNG : N ≤ stabilizer Rg c := hND.trans hDG
  have hRN : H ≤ N :=
    (commutator_mono (show s.seedOrbit ≤ D from le_sup_left)
      (show K ≤ Q Rg c from inf_le_right)).trans le_sup_left
  have hDE : ⁅D,Z Rg s.endpoint⁆ ≤ N := by
    apply commutator_sup_le_of_relative_normal (stabilizer Rg c)
      s.seedOrbit (Z Rg c) (Z Rg s.endpoint) N hNN (le_sup_left.trans hDG)
      (Z_le_stabilizer Rg c) (hseedControl.trans (sup_le le_sup_right hRN))
    exact (le_normalizer_iff_commutator_le_left.mp
      (hEG.trans (Z_normalized Rg c))).trans le_sup_right
  have hres : ⁅D,Ltilde Rg c⁆ ≤ N :=
    normal_section_residual_control_mod e hz hk s.path D N hDG hDN hNN hNG hDE
  have hQY : Q Rg c ≤ normalizer (Y : Set (FreeAmalgam Rg)) :=
    (le_inf ((Q_le_stabilizer_of_dist_le_two c s.centerVertex hc s.center_color hdist).trans
      (Z_normalized Rg _)) ((show Q Rg c ≤ stabilizer Rg c from fun _ hx => hx.1).trans
      (Z_normalized Rg c))).trans (normalizer_inf_normalizer_le_normalizer_sup _ _)
  have hQtG : Q Rg t ≤ stabilizer Rg c := fun _ hx => hx.2 _ (adjacent_symm Rg hct)
  have hQtY : Q Rg t ≤ normalizer (Y : Set (FreeAmalgam Rg)) :=
    (le_inf ((show Q Rg t ≤ stabilizer Rg s.centerVertex from
      fun _ hx => hx.2 _ (adjacent_symm Rg hat)).trans (Z_normalized Rg _))
      (hQtG.trans (Z_normalized Rg c))).trans (normalizer_inf_normalizer_le_normalizer_sup _ _)
  have hYN : stabilizer Rg c ≤ normalizer ((Y ⊔ N : Subgroup (FreeAmalgam Rg)) :
      Set (FreeAmalgam Rg)) := by
    rw [←CFSG.Quasithin.ChapterC.RankTwo.Sp4Four.local_residual_edge_generation Rg
      (by rw [h.relative_residual]; exact (codisjoint_subgroupOf_sup L R).eq_top) hc hct]
    refine sup_le ?_ ((le_inf hQtY (hQtG.trans hNN)).trans
      (normalizer_inf_normalizer_le_normalizer_sup _ _))
    apply le_normalizer_iff_commutator_le_left.mpr
    apply le_trans ?_ le_sup_right
    apply commutator_sup_le_of_relative_normal (stabilizer Rg c)
      Y N (Ltilde Rg c) N hNN (hYD.trans hDG) hNG
      ((commutator_mono hYD le_rfl).trans hres)
    exact le_normalizer_iff_commutator_le_left.mp ((Ltilde_le_stabilizer _).trans hNN)
  have hcover : D ≤ Y ⊔ ⁅D,Q Rg c⁆ := by
    have hs : s.seedOrbit ≤ Y ⊔ N :=
      conjugateSpanBy_le (show Z Rg s.centerVertex ≤ Y ⊔ N from
        le_sup_left.trans le_sup_left) (inf_le_left.trans hYN)
    have hd : D ≤ Y ⊔ N := sup_le hs (le_sup_right.trans le_sup_left)
    exact hd.trans (sup_le le_sup_left (sup_le le_sup_right (le_sup_right.trans le_sup_left)))
  let := finite_stabilizer Rg c
  let : Finite (Q Rg c) := Finite.of_injective
    (inclusion (show Q Rg c ≤ stabilizer Rg c from fun _ hx => hx.1)) (inclusion_injective _)
  have hDY : D ≤ Y := le_of_le_sup_commutator_of_isNilpotent (Q Rg c) D Y (Q Rg c)
    (Q_isPGroup Rg h.relative_radical.isPGroup h.relative_radical.twoCore_le c hc).isNilpotent
    hDQ (hYD.trans hDQ) le_rfl hQY hcover
  have hD : D = Y := le_antisymm hDY hYD
  have hZQt : Z Rg c ≤ Q Rg t :=
    (((sourceGeometry h).omega_bound c hc (by
      rw [(sourceGeometry h).distance_constant c hc]; exact sourceDistance_pos h)).trans
      (omegaCenter_le _)).trans (Q_le_adjacent_h Rg ht hct)
  let := finite_Z Rg c
  have hsmall : (Z Rg c).relIndex D ∣ 8 := by
    rw [hD]
    change (Z Rg c).relIndex (Z Rg s.centerVertex ⊔ Z Rg c) ∣ 8
    rw [relIndex_sup_of_normalizes (Z Rg s.centerVertex) (Z Rg c)
      (hZQt.trans ((show Q Rg t ≤ stabilizer Rg s.centerVertex from
        fun _ hx => hx.2 _ (adjacent_symm Rg hat)).trans (Z_normalized Rg _)))]
    have hd := relIndex_dvd_of_le_left (Z Rg s.centerVertex) (adjacent_Z_le Rg hc hct)
    rw [borel_full_seed_edge_index h e hz hk u hR s.center_color hat] at hd
    exact hd
  exact (s.seedOrbit_radius_and_escape e hz hb2).2
    (le_sup_left.trans (small_normal_radius_le_slice_at e hz hk hc D hDV hDN hsmall))

include s e hz hk in
/-- A small forward Borel slice above distance four forces central generation
of the full omega layer, at every component vertex. This is the additional
clause of MS93 (5.9) obtained from the uncontrolled whole orbit. -/
theorem borel_small_slice_omega_generation
    (hb : 4 < sourceDistance h) (u : Equiv.Perm (Fin 6))
    (hR : (Rg).map (CubicAction.projection h e hz hk) =
      Theory.SpecificGroups.SymmetricSix.borel.map (MulAut.conj u).toMonoidHom)
    (hslice : (B Rg (alpha Rg) ((sourceGeometry h).Z_normal _)).relIndex
      (U Rg (p.walk.getVert 2)) ≤ 2)
    (a : Vertex Rg) (ha : color Rg a = false) :
    X Rg a = U Rg a ⊔
      (X Rg a ⊓ centralizer (stabilizer Rg a : Set (FreeAmalgam Rg))) := by
  have hb2 : 2 < sourceDistance h := by omega
  let c := p.walk.getVert 2
  have hel := (borel_critical_paths h e hz hk u hR p).2.2.2
  have hs := s.borel_shifted_indices e hz hk hb u hR hslice hel
  have hrev := critical_reverse Rg (sourceGeometry h) (sourceEdgeCentralizer h e)
    c s.path.start_color (by
      rw [(sourceGeometry h).distance_constant _ s.path.start_color]
      exact sourceDistance_pos h) s.endpoint s.path.end_color s.path.critical
  let q : CriticalPath Rg (sourceGeometry h) s.endpoint c :=
    CriticalPath.ofPair s.path.end_color hrev
  have hq : (Q Rg c).relIndex (Z Rg s.endpoint) < 4 := by
    rw [hs.2]
    decide
  rcases small_critical_omega_generation_or_control_at h e hz hk q hq with hgen | hcontrol
  · exact omega_generation_transport s.path.end_color ha hgen
  exfalso
  have hDold := (s.borel_centralizer_orbits_le_old_endpoint_core e hz hk hb u hR hslice hel).1
  have hDG : s.seedOrbit ≤ stabilizer Rg s.endpoint :=
    hDold.trans (s.old_core_le_endpoint_stabilizer hb2)
  have hDQ : s.seedOrbit ≤ Q Rg c :=
    (s.seedOrbit_radius_and_escape e hz hb2).1.trans
      ((sourceGeometry h).V_le_Q hb2 c s.path.start_color)
  have hXZ : ⁅X Rg s.endpoint,Z Rg c⁆ ≤ Z Rg c :=
    le_normalizer_iff_commutator_le_right.mp
      ((critical_X_le_vertex h e s.endpoint s.path.end_color c hrev).trans
        (Z_normalized Rg c))
  have hDR : s.seedOrbit ≤ centralizer
      ((⁅X Rg s.endpoint,Z Rg c⁆ : Subgroup (FreeAmalgam Rg)) : Set (FreeAmalgam Rg)) :=
    (hDQ.trans (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp
      (Z_centralizes_Q Rg c s.path.start_color)))).trans (centralizer_le hXZ)
  exact s.borel_omega_orbit_control_impossible e hz hk hb u hR
    ((hcontrol s.seedOrbit hDG hDR).trans (sup_le_sup hXZ le_rfl))

include s e hz hk in
/-- Under the same retained small slice, the full omega layer equals the
whole seed, including its central attachment. -/
theorem borel_small_slice_omega_eq_seed
    (hb : 4 < sourceDistance h) (u : Equiv.Perm (Fin 6))
    (hR : (Rg).map (CubicAction.projection h e hz hk) =
      Theory.SpecificGroups.SymmetricSix.borel.map (MulAut.conj u).toMonoidHom)
    (hslice : (B Rg (alpha Rg) ((sourceGeometry h).Z_normal _)).relIndex
      (U Rg (p.walk.getVert 2)) ≤ 2)
    (a : Vertex Rg) (ha : color Rg a = false) : X Rg a = Z Rg a :=
  omega_eq_seed_of_central_generation h a ha
    (s.borel_small_slice_omega_generation e hz hk hb u hR hslice a ha)

include s e hz hk in
/-- The full-omega conclusion excludes the core-containing alternative of
MS93 (5.5)(c). Every distinct opposite mover therefore generates the
original residual with the given generating actor. -/
theorem borel_small_slice_distinct_mover_residual
    (hb : 4 < sourceDistance h) (u : Equiv.Perm (Fin 6))
    (hR : (Rg).map (CubicAction.projection h e hz hk) =
      Theory.SpecificGroups.SymmetricSix.borel.map (MulAut.conj u).toMonoidHom)
    (hslice : (B Rg (alpha Rg) ((sourceGeometry h).Z_normal _)).relIndex
      (U Rg (p.walk.getVert 2)) ≤ 2)
    {a c t : Vertex Rg} (ha : color Rg a = false) (hc : color Rg c = false)
    (hat : Adjacent Rg a t) (hct : Adjacent Rg c t)
    (hne : edgeOffenderJoin a t ≠ edgeOffenderJoin c t)
    (A : Subgroup (FreeAmalgam Rg)) (hgen : Q Rg t ⊔ A = stabilizer Rg a) :
    (¬ Q Rg a ≤ edgeOffenderJoin c t) ∧
      (edgeOffenderJoin c t ⊔ A).relIndex (stabilizer Rg a) ≤ 2 ∧
      Ltilde Rg a ≤ edgeOffenderJoin c t ⊔ A := by
  have hnot : ¬ Q Rg a ≤ edgeOffenderJoin c t := by
    intro hcore
    exact borel_opposite_containing_core_nonsplit h e hz hk u hR ha hc hat hct hne hcore
      (s.borel_small_slice_omega_generation e hz hk hb u hR hslice a ha)
  exact ⟨hnot,borel_opposite_generation_of_core_not_le h e hz hk u hR ha hc hat hct A hgen hnot⟩

end SmallSliceShift
end AlternatingSixReconstruction.Exceptional.Exhaustion.LargeDistance.CubicFull
end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS
