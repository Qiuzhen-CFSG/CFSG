/-!
# The small radical-image branch on both original moved covers

MS3 supplies an elementary offender on the actual moved cover. If the radical
image has order at most two, its natural quotient action forces that image to
be generated by a transposition. C.1.24(c), in its natural and augmentation
forms, then makes the actual replacement component short. The augmentation
argument retains its central attachment and its original conjugation action;
MS3 excludes the characteristic-normal alternative on the actual radical.

The whole ambient-core commutator of this short component is elementary and
centralized by the ambient two-core. Thus it lies in the central omega subgroup;
the existing Frattini argument places it in the initial seed. At distance
greater than two this contradicts the movement of the full radius. The final
application proves distance two for every literal replacement with radical
image of order at most two, with no cover-order or transposition premise.
Larger radical images remain separate cases.

Source: Aschbacher--Smith C.1.24(c), printed pp.130--131, and C.1.7--11;
Meierfrankenfeld--Stellmacher (1993), Section 5, printed pp.912--927.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open CFSG.Quasithin.ChapterC
open CFSG.Quasithin.ChapterC.BinaryMS.MS93 Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS
namespace AlternatingSixReconstruction.Natural.Exhaustion.LargeDistance.SectionFive
universe u
variable {G : Type u} [Group G] [Finite G] {L R : Subgroup G}
  {h : SmallMSPair KnownSimple.IsKnownSimple L R} {e : CentralMarking L}
  {hz : center (L ⧸ pCore 2 L) = ⊥} {hn : InitialNatural h e hz}
  {d : Replacement L R}

include e hz hn in
/-- Shortness of the actual replacement component puts its whole core
commutator in the starting seed, forcing the original critical distance two. -/
theorem distance_eq_two_of_short_component
    (hs : IsShort (replacementComponent d)) : replacementDistance h d = 2 := by
  by_contra hne
  have hb : 2 < replacementDistance h d := by
    by_contra! hn
    exact hne (replacementDistance_eq_two h d hn)
  let s := fullSymmetricAction_knownSimple h e hz hn d hb
  have hc := DistanceTwo.centralLayer_knownSimple G L R h e hz hn d
  have hbL : IsBlock (replacementComponent d) :=
    ⟨inferInstance,hs,h.component.subgroupOf (show L.subgroupOf (L ⊔ R) ≤ d.overgroup from le_sup_left) |>.subnormal⟩
  let C := ⁅pCore 2 d.overgroup,replacementComponent d⁆
  have hC : C = (blockU (replacementComponent d)).map (replacementComponent d).subtype :=
    hbL.ambient_core_commutator
  have hCX : C ≤ omegaCenterIn (pCore 2 d.overgroup) := by
    intro x hx
    apply (mem_omegaCenterIn_iff _ x).mpr
    refine ⟨commutator_le_left _ _ hx,?_,?_⟩
    · exact le_centralizer_iff.mp hbL.core_centralizes_blockU (hC ▸ hx)
    · rw [hC] at hx
      obtain ⟨z,hz,rfl⟩ := hx
      let := hs.elementary
      have hp : z ^ 2 = 1 := congrArg Subtype.val
        (Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
          (IsElementaryAbelian.exponent_dvd_p 2 (blockU (replacementComponent d))) ⟨z,hz⟩)
      simpa only [←map_pow,map_one] using congrArg (replacementComponent d).subtype hp
  have hgraph : core d.radical (alpha d.radical) ≤ X d.radical (alpha d.radical) := by
    rw [core_alpha d.radical (replacement_radical_isPGroup h d)
      (replacement_core_le_radical h d) rfl,replacement_residual h d,
      X,Q_alpha d.radical (replacement_radical_isPGroup h d) (replacement_core_le_radical h d),
      omegaCenter_map _ _ (embedM_injective d.radical)]
    exact map_mono hCX
  have hCU := DistanceTwo.graph_core_le_of_frattini h d hc (hgraph.trans le_sup_right)
  have hCZ : core d.radical (alpha d.radical) ≤ Z d.radical (alpha d.radical) :=
    hCU.trans (hc.U_eq_moved ▸ DistanceEight.U_le_Z d.radical _)
  have hCQ : C ≤ radiusSeed d := by
    apply map_le_iff_le_comap.mp
    rw [core_alpha d.radical (replacement_radical_isPGroup h d)
      (replacement_core_le_radical h d) (replacement_residual h d)] at hCZ
    exact hCZ
  have hVQ : radiusPreimage d ≤ pCore 2 d.overgroup := by
    have hh := comap_mono (f := embedM d.radical) (V_le_Q d.radical
      (geometry := replacementGeometry h d) (a := alpha d.radical) rfl hb)
    rwa [Q_alpha_comap d.radical (replacement_radical_isPGroup h d)
      (replacement_core_le_radical h d)] at hh
  exact radius_moving_not_le_seed s hc hb ((commutator_mono hVQ le_rfl).trans hCQ)

/-- MS3 detects a transposition whenever the actual radical image has order
at most two. This statement retains both moved-cover orders. -/
theorem radical_image_swap_of_card_le_two
    (hsmall : Nat.card (d.radical.map (SourceReduction.projection h e hz hn d)) ≤ 2) :
    ∃ t : Equiv.Perm (Fin 6), t.IsSwap ∧
      d.radical.map (SourceReduction.projection h e hz hn d) = zpowers t := by
  obtain ⟨E,hE,hne,hoff⟩ := SourceReduction.Cover.exists_maxElementary_offender h e hz hn d
  let A := E.map (SourceReduction.projection h e hz hn d)
  let D := d.radical.map (SourceReduction.projection h e hz hn d)
  change Nat.card D ≤ 2 at hsmall
  have hAD : A ≤ D := map_mono hE.1
  have hnA : A ≠ ⊥ := by
    intro hzA
    apply hne
    have hh := (map_eq_bot_iff E).mp hzA
    rwa [SourceReduction.projection_kernel h e hz hn d] at hh
  have hlo := (one_lt_card_iff_ne_bot A).mpr hnA
  have hup : Nat.card A ≤ Nat.card D := card_le_of_le hAD
  have htwo : Nat.card A = 2 := by omega
  have he : A = D := eq_of_le_of_card_ge hAD (by omega)
  have hr : rank A = 1 := by
    change Nat.log 2 (Nat.card A) = 1
    rw [htwo]
    decide
  have hfix : fixedCodim (BinaryPermutation.naturalRepresentation (Fin 6)) A ≤ 1 :=
    hoff.2.trans_eq hr
  obtain ⟨t,_,ht,htA⟩ :=
    Theory.SpecificGroups.SymmetricSix.BinaryFlags.PointCoreTranspositionFixed.small_image_eq_zpowers
      A hnA hfix
  exact ⟨t,ht,he.symm.trans htA⟩

/-- The transposition radical branch on the original order-sixteen cover. -/
theorem distance_eq_two_of_natural_transposition
    (s : FullSymmetricAction h e hz hn d)
    (hnat : Nat.card (replacementMoved d) = 16)
    (t : Equiv.Perm (Fin 6)) (ht : t.IsSwap)
    (himage : d.radical.map s.projection = zpowers t) :
    replacementDistance h d = 2 := by
  let := replacementComponent_normal h d
  let := replacementMoved_normal h d
  let := h.relative_core_quasisimple e
  let f := subgroupOfEquivOfLe
    (show L.subgroupOf (L ⊔ R) ≤ d.overgroup from le_sup_left)
  let : IsQuasisimple ((replacementComponent d) ⧸ pCore 2 (replacementComponent d)) :=
    IsQuasisimple.of_mulEquiv (QuotientGroup.congr _ _ f (pCore_map_iso 2 f)).symm
  have hcomp : (replacementComponent d).IsCComponent :=
    h.component.subgroupOf (show L.subgroupOf (L ⊔ R) ≤ d.overgroup from le_sup_left)
  have hb := (nativeSource s hnat).alternatingBlock_of_radical_image_swap hcomp t ht
    (by simpa only [nativeSource_projection] using himage)
  exact distance_eq_two_of_short_component (e := e) (hz := hz) (hn := hn) hb.2.1

private theorem characteristic_map_equiv {A B : Type*} [Group A] [Group B]
    (f : A ≃* B) (C : Subgroup A) [C.Characteristic] :
    (C.map f.toMonoidHom).Characteristic := by
  apply characteristic_iff_le_comap.mpr
  intro a x hx
  obtain ⟨y,hy,rfl⟩ := hx
  let b : MulAut A := f.trans (a.trans f.symm)
  refine ⟨b y,(characteristic_iff_le_comap.mp inferInstance b) hy,?_⟩
  exact f.apply_symm_apply _

private theorem short_component_of_core_transposition
    (s : FullSymmetricAction h e hz hn d)
    (E : Additive (replacementMoved d) ≃ₗ[ZMod 2] BinaryPermutation.core (Fin 6))
    (hE : ∀ g v, E (coverAction s g v) =
      BinaryPermutation.coreRepresentation (Fin 6) g (E v))
    (t : Equiv.Perm (Fin 6)) (ht : t.IsSwap)
    (himage : d.radical.map s.projection = zpowers t) :
    IsShort (replacementComponent d) := by
  let := replacementComponent_normal h d
  let := replacementMoved_normal h d
  let := h.relative_core_quasisimple e
  let f := subgroupOfEquivOfLe
    (show L.subgroupOf (L ⊔ R) ≤ d.overgroup from le_sup_left)
  let : IsQuasisimple ((replacementComponent d) ⧸ pCore 2 (replacementComponent d)) :=
    IsQuasisimple.of_mulEquiv (QuotientGroup.congr _ _ f (pCore_map_iso 2 f)).symm
  have hcomp : (replacementComponent d).IsCComponent :=
    h.component.subgroupOf (show L.subgroupOf (L ⊔ R) ≤ d.overgroup from le_sup_left)
  have hself := replacement_self_centralizing h d
  have hf := generalizedFitting_eq_pCore_of_selfCentralizing 2 hself
  have hfL := generalizedFitting_eq_pCore_of_selfCentralizing 2
    (subnormal_core_selfCentralizing hself (replacementComponent d) hcomp.subnormal)
  obtain ⟨T,hRT⟩ := (replacement_radical_isPGroup h d).exists_le_sylow
  have hprod : ∀ m : d.overgroup, ∃ l ∈ replacementComponent d,
      ∃ t ∈ (T : Subgroup d.overgroup), l*t=m := by
    intro m
    obtain ⟨l,hl,t,ht,he⟩ := replacement_product h d m
    exact ⟨l,hl,t,hRT ht,he⟩
  let fV : replacementMoved d ≃* Multiplicative (BinaryPermutation.core (Fin 6)) :=
    E.toAddEquiv.toMultiplicativeRight
  have hequiv : ∀ (g : d.overgroup) (v : replacementMoved d),
      (fV (MulAut.conjNormal g v)).toAdd =
        BinaryPermutation.coreRepresentation (Fin 6) (s.projection g) (fV v).toAdd := by
    intro g v
    have hconj : coverAction s (s.projection g) (Additive.ofMul v) =
        Additive.ofMul (MulAut.conjNormal g v) := by
      apply Additive.toMul.injective
      apply Subtype.ext
      exact coverAction_conjugate s g (Additive.ofMul v)
    change E (Additive.ofMul (MulAut.conjNormal g v)) = _
    rw [←hconj]
    exact hE (s.projection g) (Additive.ofMul v)
  have hm : ⁅replacementMoved d,replacementComponent d⁆ ≠ ⊥ := by
    rw [replacementMoved_idempotent h d]
    intro hzV
    have hc := moved_card s
    rw [hzV,card_bot] at hc
    omega
  rcases ChapterC.RankOne.SymmetricSix.normal_characteristic_or_block_of_core_six
      (replacementComponent d) (replacementMoved d) d.radical hcomp hf hfL T
      (replacement_core_le_radical h d) hRT hprod s.projection s.component_image
      fV hequiv hm t ht himage with hC | hb
  · obtain ⟨C,hC,hne,hn⟩ := hC
    let := hC
    let B := ChapterB.baumann d.radical
    have hBR : B ≤ d.radical := inf_le_left
    have hB : B.subgroupOf d.radical = ChapterB.baumann (⊤ : Subgroup d.radical) := by
      apply map_injective d.radical.subtype_injective
      rw [map_subgroupOf_eq_of_le hBR]
      change ChapterB.baumann d.radical =
        (ChapterB.baumann (⊤ : Subgroup d.radical)).map d.radical.subtype
      rw [ChapterC.RankOne.SymmetricSix.baumann_map d.radical d.radical.subtype
        d.radical.subtype_injective,←MonoidHom.range_eq_map,range_subtype]
    let : (B.subgroupOf d.radical).Characteristic := hB ▸ ChapterB.baumann_characteristic
    let fB : B ≃* B.subgroupOf d.radical := (subgroupOfEquivOfLe hBR).symm
    let C' := C.map fB.toMonoidHom
    let : C'.Characteristic := characteristic_map_equiv fB C
    let D := C'.map (B.subgroupOf d.radical).subtype
    let : D.Characteristic := inferInstance
    have hmap : D.map d.radical.subtype = C.map B.subtype := by
      rw [map_map,map_map]
      rfl
    have hDn : (D.map d.radical.subtype).Normal := hmap.symm ▸ hn
    have hD0 := (replacement_characteristic h d).eq_bot_of_normal D hDn
    have hC0 : C.map B.subtype = ⊥ := by rw [←hmap,hD0,Subgroup.map_bot]
    exact (hne ((C.map_eq_bot_iff_of_injective B.subtype_injective).mp hC0)).elim
  · exact hb.short

/-- A transposition image forces distance two on either original moved cover. -/
theorem distance_eq_two_of_transposition
    (s : FullSymmetricAction h e hz hn d)
    (t : Equiv.Perm (Fin 6)) (ht : t.IsSwap)
    (himage : d.radical.map s.projection = zpowers t) :
    replacementDistance h d = 2 := by
  rcases cover_model s with ⟨E,_⟩ | ⟨E,hE⟩
  · have hnat : Nat.card (replacementMoved d) = 16 := by
      change Nat.card (Additive (replacementMoved d)) = 16
      rw [Nat.card_congr E.toEquiv,Module.natCard_eq_pow_finrank (K := ZMod 2),
        BinaryPermutation.finrank_natural_even (Fin 6) (by decide)]
      norm_num
    exact distance_eq_two_of_natural_transposition s hnat t ht himage
  · exact distance_eq_two_of_short_component (e := e) (hz := hz) (hn := hn)
      (short_component_of_core_transposition s E hE t ht himage)

/-- Every literal replacement has distance two in the small-radical-image
branch, retaining both moved covers and their actual central attachments. -/
theorem distance_eq_two_of_small_radical_image_knownSimple
    (hsmall : Nat.card (d.radical.map (SourceReduction.projection h e hz hn d)) ≤ 2) :
    replacementDistance h d = 2 := by
  by_cases hb : 2 < replacementDistance h d
  · let s := fullSymmetricAction_knownSimple h e hz hn d hb
    obtain ⟨t,ht,he⟩ := radical_image_swap_of_card_le_two hsmall
    exact distance_eq_two_of_transposition s t ht (by
      rwa [SourceReduction.fullSymmetricAction_projection_unique h e hz hn d s])
  · exact replacementDistance_eq_two h d (Nat.le_of_not_gt hb)

/-- Large distance requires a radical image of order at least four for either
central cover. This uses the original radical's two-group property. -/
theorem large_distance_radical_image_four_le_knownSimple
    (hb : 2 < replacementDistance h d) :
    4 ≤ Nat.card (d.radical.map (SourceReduction.projection h e hz hn d)) := by
  have hnsmall : ¬ Nat.card (d.radical.map (SourceReduction.projection h e hz hn d)) ≤ 2 := by
    intro hsmall
    have he := distance_eq_two_of_small_radical_image_knownSimple hsmall
    omega
  have hp := (replacement_radical_isPGroup h d).map (SourceReduction.projection h e hz hn d)
  obtain ⟨n,he⟩ := hp.exists_card_eq
  rw [he] at hnsmall ⊢
  have hn : 2 ≤ n := by
    by_contra! hh
    interval_cases n <;> norm_num at hnsmall
  exact Nat.pow_le_pow_right (by decide : 0 < 2) hn

end AlternatingSixReconstruction.Natural.Exhaustion.LargeDistance.SectionFive
