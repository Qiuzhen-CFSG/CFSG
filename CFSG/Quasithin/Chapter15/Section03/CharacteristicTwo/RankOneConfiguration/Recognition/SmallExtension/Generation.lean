module

public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.SmallExtension.CentralAction

/-!
# Conjugate generation from irreducible intersections

In C.1.34(1)–(2), Q is the sum of one or two natural binary modules.
An irreducible summand meeting Y₊ nontrivially is generated by the
L-conjugates of its intersection. Taking the sum supplies the generation
hypothesis of the checked centralization argument in Recognition.Local.

The model calculation must construct these summands and prove that each
intersection is a hyperplane. The results here also require its bound
[D,L] ≤ Q and the abelianness of Q; they do not establish those model facts.

Source: Aschbacher–Smith, combined manuscript (1 March 2004),
printed p.1132 (PDF p.1149), final paragraph of the proof of 15.3.31.
-/

@[expose] public section

open Subgroup
open scoped commutatorElement

namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension

variable {G : Type*} [Group G]

/-- A nontrivial intersection generates an irreducible invariant subgroup
under conjugation. In the application, W is a natural binary summand and
W ∩ Y₊ is a hyperplane; that model calculation remains separate. -/
theorem span_intersection_eq_of_irreducible {W Y L : Subgroup G}
    (hLW : L ≤ normalizer (W : Set G))
    (hirr : ∀ N : Subgroup G, N ≤ W → L ≤ normalizer (N : Set G) → N = ⊥ ∨ N = W)
    (hne : W ⊓ Y ≠ ⊥) : localSpan (W ⊓ Y) L = W := by
  have hle : localSpan (W ⊓ Y) L ≤ W := conjugateSpanBy_le inf_le_left hLW
  rcases hirr _ hle (le_normalizer_conjugateSpanBy _ _) with h | h
  · exact (hne (eq_bot_iff.mpr ((le_conjugateSpanBy (W ⊓ Y) L).trans h.le))).elim
  · exact h

/-- The natural summands in C.1.34(1)–(2) reduce conjugate generation of Q
to nontriviality of their intersections with Y₊. The irreducibility condition
is stated for the actual conjugation action, not for an unrelated module tag. -/
theorem core_le_span_of_irreducible_cover (d : LocalData G) {I : Subgroup G}
    (c : ComponentWitness d I) {ι : Sort*} (W : ι → Subgroup G)
    (hcover : extensionCore c.L ≤ ⨆ i, W i)
    (hWQ : ∀ i, W i ≤ extensionCore c.L)
    (hLW : ∀ i, c.L ≤ normalizer (W i : Set G))
    (hirr : ∀ i (N : Subgroup G), N ≤ W i → c.L ≤ normalizer (N : Set G) →
      N = ⊥ ∨ N = W i)
    (hmeet : ∀ i, W i ⊓ d.Yplus ≠ ⊥) :
    extensionCore c.L ≤ localSpan (extensionCore c.L ⊓ d.Yplus) c.L := by
  apply hcover.trans
  refine iSup_le fun i => ?_
  rw [← span_intersection_eq_of_irreducible (hLW i) (hirr i) (hmeet i)]
  exact conjugateSpanBy_mono (inf_le_inf_right d.Yplus (hWQ i)) le_rfl

/-- The abelian cases centralize Q once their actual irreducible summands,
intersections, and quotient-centralizer commutator bound have been constructed. -/
theorem centralizes_core_of_irreducible_cover (d : LocalData G) {I : Subgroup G}
    (c : ComponentWitness d I) {ι : Sort*} (W : ι → Subgroup G)
    (hcover : extensionCore c.L ≤ ⨆ i, W i)
    (hWQ : ∀ i, W i ≤ extensionCore c.L)
    (hLW : ∀ i, c.L ≤ normalizer (W i : Set G))
    (hirr : ∀ i (N : Subgroup G), N ≤ W i → c.L ≤ normalizer (N : Set G) →
      N = ⊥ ∨ N = W i)
    (hmeet : ∀ i, W i ⊓ d.Yplus ≠ ⊥)
    (hQab : IsMulCommutative (extensionCore c.L))
    (hDL : ⁅yplusCentralizer d I, c.L⁆ ≤ extensionCore c.L) :
    yplusCentralizer d I ≤ centralizer (extensionCore c.L : Set G) :=
  centralizes_extensionCore_of_conjugate_generation d c hQab hDL
    (core_le_span_of_irreducible_cover d c W hcover hWQ hLW hirr hmeet)

end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension

end
