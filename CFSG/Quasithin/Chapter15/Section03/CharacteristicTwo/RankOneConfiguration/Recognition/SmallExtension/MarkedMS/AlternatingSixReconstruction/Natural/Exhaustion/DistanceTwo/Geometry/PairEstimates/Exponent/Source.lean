module
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.SmallExtension.MarkedMS.AlternatingSixReconstruction.Natural.Exhaustion.DistanceTwo.Geometry.PairEstimates.Exponent.Plane

/-!
# Exponent two for the literal paired critical-orbit commutator

The local calculations centralize the orbit commutator by both the residual
and the common edge. Thus normal generation identifies it with the plane
commutator. Every paired square lies in that subgroup and, by the retained
reversed-orbit conjugation, in the opposite fixed attachment. The whole-cover
separation proved in Plane makes the square trivial.

This proves PairedExponentInput with exactly its existing hypotheses. Earlier
local images and plane intersection remain with
qt-e-ms-small-a6-exhaustion-distance-two; Assembly.Exponent.Source applies this
result to the literal selected orbit and the whole-core exhaustion consumer.
Source: MS93 (3.6), printed p.871, the paired Frattini calculation.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender BinaryPermutation
open scoped IsMulCommutative commutatorElement
open CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup.Source
open CFSG.Quasithin.ChapterC.BinaryMS.MS93 Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticDistanceTwo
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS
namespace AlternatingSixReconstruction.Natural.Exhaustion.DistanceTwo.Geometry.PairEstimates
variable {M : Type*} [Group M] [Finite M] {R : Subgroup M} {geo : Geometry R}

/-- The central orbit commutator is already generated by the critical plane's
commutator. The edge layer and residual together centralize the latter. -/
theorem orbit_commutator_eq_plane_of_calculations
    (hp : IsPGroup 2 R) (hQR : pCore 2 M ≤ R)
    (hgen : pResidual 2 M ⊔ R = ⊤)
    (hl : LocalCalculations R geo) (hb : geo.b R = 2)
    {c b : Vertex R}
    (hc : CriticalPair R (alpha R) c (geo.exists_critical _ rfl))
    (hab : Adjacent R (alpha R) b) (hcb : Adjacent R c b) :
    ⁅Q R (alpha R),criticalOrbit R c b⁆ = ⁅Q R (alpha R),criticalPlane R c b⁆ := by
  let D := ⁅Q R (alpha R),criticalPlane R c b⁆
  have hD : D ≤ ⁅Q R (alpha R),criticalOrbit R c b⁆ :=
    commutator_mono le_rfl (criticalPlane_le_orbit geo hb hc b)
  have hcent : ⁅⁅Q R (alpha R),criticalOrbit R c b⁆,Ltilde R (alpha R)⁆ = ⊥ := by
    rw [Q_alpha R hp hQR,criticalOrbit,Ltilde_alpha,←map_commutator,←map_commutator,
      hl.commutator_central c b hc hab hcb,Subgroup.map_bot]
  have hG : Ltilde R (alpha R) ⊔ Q R b = stabilizer R (alpha R) := by
    have hbase : Ltilde R (alpha R) ⊔ Q R (beta R) = stabilizer R (alpha R) := by
      rw [Ltilde_alpha,Q_beta,←Subgroup.map_sup,hgen,←MonoidHom.range_eq_map]
      exact (stabilizer_m_base R).symm
    obtain ⟨g,hg,hgb⟩ := stabilizer_transitive_neighbors R (alpha R) (base_adjacent R) hab
    have hh := congrArg (fun H : Subgroup (FreeAmalgam R) =>
      H.map (MulAut.conj g⁻¹).toMonoidHom) hbase
    change act R g (alpha R) = alpha R at hg
    change act R g (beta R) = b at hgb
    rw [Subgroup.map_sup,←Ltilde_act,←Q_act,←stabilizer_act,hg,hgb] at hh
    exact hh
  have hDG : D ≤ centralizer (stabilizer R (alpha R) : Set (FreeAmalgam R)) := by
    apply le_centralizer_iff.mp
    rw [←hG]
    apply sup_le
    · exact le_centralizer_iff.mp
        (hD.trans (commutator_eq_bot_iff_le_centralizer.mp hcent))
    · apply le_centralizer_iff.mp
      intro z hz
      have hzZ := criticalPlane_commutator_le geo hb hc hab hcb hz
      have hcol := DistanceTwo.NaturalCore.edge_color hab
      have hZb : Z R b = omegaCenter (Q R b) := by
        simp only [Z,hcol,Bool.true_eq_false,if_false,edgeOmega]
      rw [hZb] at hzZ
      exact (mem_omegaCenter_iff.mp hzZ).2.2
  let D0 := D.comap (embedM R)
  let Y := (criticalPlane R c b).comap (embedM R)
  let : D0.Normal := by
    constructor
    intro x hx m
    change embedM R (m*x*m⁻¹) ∈ D
    rw [map_mul,map_mul,map_inv]
    have hm : embedM R m ∈ stabilizer R (alpha R) := by
      rw [show alpha R = mVertex R 1 from rfl,stabilizer_m_base]
      exact ⟨m,rfl⟩
    rw [hDG hx _ hm,mul_inv_cancel_right]
    exact hx
  have hcomm : ⁅pCore 2 M,Y⁆ ≤ D0 := by
    apply map_le_iff_le_comap.mp
    rw [map_commutator,←Q_alpha R hp hQR]
    exact commutator_mono le_rfl (map_comap_le _ _)
  have hh := map_mono (f := embedM R)
    (commutator_normalClosure_le_of_normal (pCore 2 M) Y D0 hcomm)
  rw [map_commutator,←Q_alpha R hp hQR] at hh
  exact le_antisymm (hh.trans (map_comap_le _ _)) hD

universe u
variable {G : Type u} [Group G] [Finite G] {L T : Subgroup G}
  (h : SmallMSPair KnownSimple.IsKnownSimple L T) (e : CentralMarking L)
  (hz : center (L ⧸ pCore 2 L) = ⊥) (hn : InitialNatural h e hz)
  (d : Replacement L T)

include h e hz hn in
/-- Squares in the actual paired commutator vanish, while the central
attachment of the whole moved cover is retained. -/
theorem paired_square_eq_one
    (hl : LocalCalculations d.radical (replacementGeometry h d))
    (hb : replacementDistance h d = 2)
    (hlarge : ¬ core d.radical (alpha d.radical) ≤
      (frattini (Q d.radical (alpha d.radical))).map
        (Q d.radical (alpha d.radical)).subtype ⊔ X d.radical (alpha d.radical))
    (o : OrderedOrbit (replacementGeometry h d))
    {x : FreeAmalgam d.radical}
    (hx : x ∈ ⁅criticalOrbit d.radical o.c o.b,o.opposite⁆) : x ^ 2 = 1 := by
  have hp := replacement_radical_isPGroup h d
  have hQR := replacement_core_le_radical h d
  let A := criticalOrbit d.radical o.c o.b
  have hAQ : A ≤ Q d.radical (alpha d.radical) := by
    rw [Q_alpha d.radical hp hQR]
    exact map_mono (hl.orbit_core o.c o.b o.critical o.adjacent_left o.adjacent_right)
  have hAG := hAQ.trans (DistanceTwo.NaturalCore.Q_le_endpoint_stabilizer
    o.adjacent_left o.adjacent_right)
  have hBG : o.opposite ≤ stabilizer d.radical (alpha d.radical) :=
    (o.opposite_le.trans (Q_le_adjacent_h d.radical
      (DistanceTwo.NaturalCore.edge_color o.adjacent_left) o.adjacent_right)).trans
      (fun _ hy => hy.2 _ (adjacent_symm d.radical o.adjacent_left))
  have hxA := le_normalizer_iff_commutator_le_left.mp
    (hBG.trans (criticalOrbit_normalized o.c o.b)) hx
  have hxB := le_normalizer_iff_commutator_le_right.mp (hAG.trans o.opposite_normalized) hx
  let : Finite (stabilizer d.radical (alpha d.radical)) := finite_stabilizer _ _
  let : Finite A := Finite.of_injective
    (inclusion (hAQ.trans (show Q d.radical (alpha d.radical) ≤ stabilizer d.radical (alpha d.radical)
      from fun _ hy => hy.1))) (inclusion_injective _)
  let : Fact (IsPGroup 2 A) := ⟨(Q_isPGroup d.radical hp hQR (alpha d.radical) rfl).of_injective
    (inclusion hAQ) (inclusion_injective _)⟩
  have hphi : x ^ 2 ∈ (frattini A).map A.subtype :=
    mem_map_of_mem A.subtype (pth_power_mem_frattini_of_isPGroup (p := 2) (⟨x,hxA⟩ : A))
  have hcomm := orbit_frattini_le_commutator hp hQR hl hb
    o.critical o.adjacent_left o.adjacent_right hphi
  rw [orbit_commutator_eq_plane_of_calculations hp hQR (replacement_residual_sup_radical h d)
    hl hb o.critical o.adjacent_left o.adjacent_right] at hcomm
  have hfixed := (rebased_square_central_edge hp hQR hl hb o.rebased hxB).2
  exact mem_bot.mp ((plane_commutator_inf_opposite_fixed_eq_bot h e hz hn d hb hlarge
    o.critical o.adjacent_left o.adjacent_right) ▸ ⟨hcomm,hfixed⟩)

/-- The exact remaining paired-exponent contract follows from whole-cover
coordinates and the original local calculations. -/
theorem pairedExponent_knownSimple : PairedExponentInput.{u} KnownSimple.IsKnownSimple := by
  intro _ G _ _ L T h e hz hn d _ hb hlarge hl _ c b B hc hab hcb hr hs ho _ _ a ha x hx
  let o := orderedOfRebased (replacement_radical_isPGroup h d) (replacement_core_le_radical h d)
    hl c b B hc hab hcb hr hs ho
  exact paired_square_eq_one h e hz hn d hl hb hlarge o (commutator_mem_commutator ha hx)

end AlternatingSixReconstruction.Natural.Exhaustion.DistanceTwo.Geometry.PairEstimates
