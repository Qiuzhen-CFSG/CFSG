/-- Every nonzero seed image within the radius-four ball is a transposition
at critical distance four. -/
theorem four_seed_image_bot_or_swap
    (hc : DistanceTwo.CentralLayer d) (hb : replacementDistance h d = 4)
    (u : S) (hfull : d.radical.map s.projection =
      pointCore.map (MulAut.conj u).toMonoidHom)
    (c : Vertex d.radical) (hcCol : color d.radical c = false)
    (hcd : (cosetGraph d.radical).dist (alpha d.radical) c ≤ 4) :
    graphImage s (Z d.radical c) = ⊥ ∨
      ∃ t : S, t.IsSwap ∧ graphImage s (Z d.radical c) = zpowers t := by
  by_cases hZQ : Z d.radical c ≤ Q d.radical (alpha d.radical)
  · left
    apply bot_unique
    change ((Z d.radical c).comap (embedM d.radical)).map s.projection ≤ ⊥
    rw [map_le_iff_le_comap]
    change _ ≤ s.projection.ker
    rw [s.projection_kernel]
    intro x hx
    have hm := hZQ hx
    rw [Q_alpha d.radical (replacement_radical_isPGroup h d)
      (replacement_core_le_radical h d)] at hm
    obtain ⟨z,hz,he⟩ := hm
    exact (embedM_injective d.radical he) ▸ hz
  · have hdist : (cosetGraph d.radical).dist c (alpha d.radical) =
        criticalDistance d.radical c ((replacementGeometry h d).exists_critical c hcCol) := by
      have hlo := criticalDistance_le d.radical c
        ((replacementGeometry h d).exists_critical c hcCol) hZQ
      rw [(replacementGeometry h d).distance_constant c hcCol] at hlo ⊢
      change replacementDistance h d ≤ _ at hlo
      change _ = replacementDistance h d
      rw [SimpleGraph.dist_comm] at hlo ⊢
      omega
    let q : CriticalPath d.radical (replacementGeometry h d) c (alpha d.radical) :=
      CriticalPath.ofPair hcCol ⟨hdist,hZQ⟩
    let p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) c :=
      CriticalPath.ofPair rfl (critical_reverse_pair s hc q)
    right
    apply small_critical_image_eq_swap s hc p
    have hf : d.radical.map (SourceReduction.projection h e hz hn d) =
        pointCore.map (MulAut.conj u).toMonoidHom := by
      rwa [SourceReduction.fullSymmetricAction_projection_unique h e hz hn d s] at hfull
    have hi := (full_point_four_critical_indices_two_knownSimple hb u hf p).1
    omega

/-- All nonzero radius generators use the same transposition of the literal
edge point core. Thus the complete radius has cyclic image of order at most two. -/
theorem four_radius_image_le_swap
    (hc : DistanceTwo.CentralLayer d) (hb : replacementDistance h d = 4)
    (u : S) (hfull : d.radical.map s.projection =
      pointCore.map (MulAut.conj u).toMonoidHom)
    (c : Vertex d.radical) (hcCol : color d.radical c = false)
    (hcd : (cosetGraph d.radical).dist c (alpha d.radical) = 2) :
    ∃ v : S, graphImage s (V d.radical c) ≤ zpowers (v*swap45*v⁻¹) := by
  obtain ⟨t,hct,hat⟩ := exists_common_neighbor_of_dist_two d.radical c (alpha d.radical) hcd
  have hdt : (cosetGraph d.radical).dist c t = 1 :=
    SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj d.radical _ _).mpr hct)
  have hVt : V d.radical c ≤ Q d.radical t :=
    V_le_Q_of_dist_add_two_lt d.radical hcCol (by
      rw [hdt]
      change 1+2 < replacementDistance h d
      omega)
  have hVG : V d.radical c ≤ stabilizer d.radical (alpha d.radical) :=
    hVt.trans (fun _ hx => hx.2 _ (adjacent_symm d.radical hat))
  obtain ⟨v,hv⟩ := graphImage_le_pointCore_of_le_edge s u hfull.le t hat (V d.radical c) hVt
  refine ⟨v,?_⟩
  let T : Subgroup S := zpowers (v*swap45*v⁻¹)
  let K := T.comap s.projection
  have hVK : V d.radical c ≤ K.map (embedM d.radical) := by
    apply NaturalStructure.Exclusion.radius_le_of_m_ball hcCol
    intro z hz hzc
    have hZV : Z d.radical z ≤ V d.radical c := le_iSup_of_le z (le_iSup_of_le hzc le_rfl)
    have hdist : (cosetGraph d.radical).dist (alpha d.radical) z ≤ 4 := by
      have hh := (cosetGraph_connected d.radical).dist_triangle
        (u := z) (v := c) (w := alpha d.radical)
      rw [SimpleGraph.dist_comm (u := alpha d.radical)]
      omega
    have himage : graphImage s (Z d.radical z) ≤ T := by
      rcases four_seed_image_bot_or_swap s hc hb u hfull z hz hdist with he | ⟨a,ha,he⟩
      · rw [he]; exact bot_le
      · have haCore : a ∈ pointCore.map (MulAut.conj v).toMonoidHom :=
          hv ((map_mono (comap_mono hZV)) (show a ∈ graphImage s (Z d.radical z) by rw [he]; exact mem_zpowers a))
        have haEq := PointCoreTranspositionFixed.swap_eq_conjugate v a haCore ha
        rw [he,haEq]
    have hm : ((Z d.radical z).comap (embedM d.radical)).map (embedM d.radical) = Z d.radical z :=
      map_comap_eq_self ((hZV.trans hVG).trans_eq (stabilizer_m_base d.radical))
    rw [←hm]
    exact map_mono (map_le_iff_le_comap.mp himage)
  change ((V d.radical c).comap (embedM d.radical)).map s.projection ≤ T
  apply map_le_iff_le_comap.mpr
  apply (map_le_map_iff_of_injective (embedM_injective d.radical)).mp
  rw [map_comap_eq_self (hVG.trans_eq (stabilizer_m_base d.radical))]
  exact hVK

/-- The original two-core sees at most two elements of any radius whose
center is two edges from the base vertex. -/
theorem four_radius_index_le_two_base
    (hc : DistanceTwo.CentralLayer d) (hb : replacementDistance h d = 4)
    (u : S) (hfull : d.radical.map s.projection =
      pointCore.map (MulAut.conj u).toMonoidHom)
    (c : Vertex d.radical) (hcCol : color d.radical c = false)
    (hcd : (cosetGraph d.radical).dist c (alpha d.radical) = 2) :
    (Q d.radical (alpha d.radical)).relIndex (V d.radical c) ≤ 2 := by
  obtain ⟨v,hv⟩ := four_radius_image_le_swap s hc hb u hfull c hcCol hcd
  have hVG : V d.radical c ≤ stabilizer d.radical (alpha d.radical) := by
    obtain ⟨t,hct,hat⟩ := exists_common_neighbor_of_dist_two d.radical c (alpha d.radical) hcd
    have hdt : (cosetGraph d.radical).dist c t = 1 :=
      SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj d.radical _ _).mpr hct)
    have hVt := V_le_Q_of_dist_add_two_lt d.radical hcCol (show
        (cosetGraph d.radical).dist c t + 2 < (replacementGeometry h d).b d.radical by
      rw [hdt]; change 1+2 < replacementDistance h d; omega)
    exact hVt.trans (fun _ hx => hx.2 _ (adjacent_symm d.radical hat))
  rw [←graphImage_card s _ hVG]
  have hswap : (v*swap45*v⁻¹).IsSwap := by
    change (v*Equiv.swap (4:Fin 6) 5*v⁻¹).IsSwap
    rw [←Equiv.swap_apply_apply]
    exact ⟨_,_,v.injective.ne (by decide),rfl⟩
  exact (card_le_of_le hv).trans_eq (by rw [Nat.card_zpowers,hswap.orderOf])

/-- The radius estimate transports through the actual amalgam action to
any two component vertices at distance two. -/
theorem four_radius_index_le_two_at
    (hc : DistanceTwo.CentralLayer d) (hb : replacementDistance h d = 4)
    (u : S) (hfull : d.radical.map s.projection =
      pointCore.map (MulAut.conj u).toMonoidHom)
    {a c : Vertex d.radical} (ha : color d.radical a = false)
    (hcCol : color d.radical c = false)
    (hcd : (cosetGraph d.radical).dist c a = 2) :
    (Q d.radical a).relIndex (V d.radical c) ≤ 2 := by
  obtain ⟨g,hg⟩ := exists_mVertex_of_color d.radical ha
  have hbase : act d.radical g⁻¹ a = alpha d.radical := by
    rw [hg,act_mVertex,mul_inv_cancel]
    rfl
  have hc0 : color d.radical (act d.radical g⁻¹ c) = false := by
    rw [action_preserves_color,hcCol]
  have hd0 : (cosetGraph d.radical).dist (act d.radical g⁻¹ c) (alpha d.radical) = 2 := by
    rw [←hbase,dist_act]
    exact hcd
  have hi := four_radius_index_le_two_base s hc hb u hfull _ hc0 hd0
  rw [←hbase,Q_act,V_act,relIndex_map_map_of_injective _ _ (MulAut.conj (g⁻¹)⁻¹).injective] at hi
  exact hi

/-- At distance four, both midpoint radius images on the original critical
path have order exactly two. The lower bounds use the genuine critical
endpoint and the proved radius escape of source (5.8). -/
theorem full_point_four_midpoint_radius_indices_knownSimple
    (hb : replacementDistance h d = 4) (u : S)
    (hfull : d.radical.map (SourceReduction.projection h e hz hn d) =
      pointCore.map (MulAut.conj u).toMonoidHom)
    {a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) a') :
    (Q d.radical (alpha d.radical)).relIndex (V d.radical (p.walk.getVert 2)) = 2 ∧
      (Q d.radical (p.walk.getVert 2)).relIndex (V d.radical (alpha d.radical)) = 2 := by
  have hb2 : 2 < replacementDistance h d := by omega
  let s := fullSymmetricAction_knownSimple h e hz hn d hb2
  have hc := DistanceTwo.centralLayer_knownSimple G L R h e hz hn d
  have hf : d.radical.map s.projection = pointCore.map (MulAut.conj u).toMonoidHom := by
    rwa [SourceReduction.fullSymmetricAction_projection_unique h e hz hn d s]
  have hl : p.walk.length = 4 := p.length_eq_b.trans hb
  have hcol : color d.radical (p.walk.getVert 2) = false :=
    (p.vertex_color (by omega)).mpr (by decide)
  have hd : (cosetGraph d.radical).dist (alpha d.radical) (p.walk.getVert 2) = 2 :=
    p.dist_start (by omega)
  have hdc : (cosetGraph d.radical).dist (p.walk.getVert 2) (alpha d.radical) = 2 := by
    rw [SimpleGraph.dist_comm]; exact hd
  have hi := four_radius_index_le_two_at s hc hb u hf rfl hcol hdc
  have hj := four_radius_index_le_two_at s hc hb u hf hcol rfl hd
  have hZe : Z d.radical a' ≤ V d.radical (p.walk.getVert 2) := by
    exact le_iSup_of_le a' (le_iSup_of_le (show
      (cosetGraph d.radical).dist a' (p.walk.getVert 2) ≤ 2 by
        rw [SimpleGraph.dist_comm,p.dist_end,hl]) le_rfl)
  have hn1 : ¬ V d.radical (p.walk.getVert 2) ≤ Q d.radical (alpha d.radical) :=
    fun hh => (critical_reverse_pair s hc p).2 (hZe.trans hh)
  have hn2 := full_point_radius_not_le_predecessor_knownSimple hb2 u hfull p
  simp only [hl,show 4-2=2 from rfl] at hn2
  let := finite_stabilizer d.radical (alpha d.radical)
  let := finite_stabilizer d.radical (p.walk.getVert 2)
  let : Finite (V d.radical (alpha d.radical)) := Finite.of_injective
    (inclusion ((V_le_Q d.radical rfl hb2).trans (fun _ hx => hx.1))) (inclusion_injective _)
  let : Finite (V d.radical (p.walk.getVert 2)) := Finite.of_injective
    (inclusion ((V_le_Q d.radical hcol hb2).trans (fun _ hx => hx.1))) (inclusion_injective _)
  have hp1 : 0 < (Q d.radical (alpha d.radical)).relIndex (V d.radical (p.walk.getVert 2)) :=
    Nat.pos_of_ne_zero index_ne_zero_of_finite
  have hp2 : 0 < (Q d.radical (p.walk.getVert 2)).relIndex (V d.radical (alpha d.radical)) :=
    Nat.pos_of_ne_zero index_ne_zero_of_finite
  have hh1 := mt relIndex_eq_one.mp hn1
  have hh2 := mt relIndex_eq_one.mp hn2
  exact ⟨by omega,by omega⟩

/-- A two-edge radius image larger than two already forces distance two in
the literal full-point replacement branch. -/
theorem full_point_distance_two_of_large_radius_image_knownSimple
    (u : S) (hfull : d.radical.map (SourceReduction.projection h e hz hn d) =
      pointCore.map (MulAut.conj u).toMonoidHom)
    {a c : Vertex d.radical} (ha : color d.radical a = false)
    (hcCol : color d.radical c = false)
    (hcd : (cosetGraph d.radical).dist c a = 2)
    (hlarge : 2 < (Q d.radical a).relIndex (V d.radical c)) :
    replacementDistance h d = 2 := by
  rcases full_point_distance_two_or_four_knownSimple u hfull with hb | hb
  · exact hb
  · let s := fullSymmetricAction_knownSimple h e hz hn d (by omega)
    have hc := DistanceTwo.centralLayer_knownSimple G L R h e hz hn d
    have hf : d.radical.map s.projection = pointCore.map (MulAut.conj u).toMonoidHom := by
      rwa [SourceReduction.fullSymmetricAction_projection_unique h e hz hn d s]
    have hi := four_radius_index_le_two_at s hc hb u hf ha hcCol hcd
    omega

/-- The midpoint radius and opposite critical seed have the same literal
image under the original full symmetric projection. -/
theorem four_midpoint_radius_image_eq_seed
    (hc : DistanceTwo.CentralLayer d) (hb : replacementDistance h d = 4)
    (u : S) (hfull : d.radical.map s.projection =
      pointCore.map (MulAut.conj u).toMonoidHom)
    {a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) a') :
    graphImage s (V d.radical (p.walk.getVert 2)) = graphImage s (Z d.radical a') := by
  have hl : p.walk.length = 4 := p.length_eq_b.trans hb
  have hcol : color d.radical (p.walk.getVert 2) = false :=
    (p.vertex_color (by omega)).mpr (by decide)
  have hd : (cosetGraph d.radical).dist (p.walk.getVert 2) (alpha d.radical) = 2 := by
    rw [SimpleGraph.dist_comm,p.dist_start (by omega)]
  obtain ⟨v,hv⟩ := four_radius_image_le_swap s hc hb u hfull _ hcol hd
  have hcard : Nat.card (graphImage s (V d.radical (p.walk.getVert 2))) ≤ 2 := by
    have hswap : (v*swap45*v⁻¹).IsSwap := by
      change (v*Equiv.swap (4:Fin 6) 5*v⁻¹).IsSwap
      rw [←Equiv.swap_apply_apply]
      exact ⟨_,_,v.injective.ne (by decide),rfl⟩
    exact (card_le_of_le hv).trans_eq (by rw [Nat.card_zpowers,hswap.orderOf])
  have hZV : Z d.radical a' ≤ V d.radical (p.walk.getVert 2) := by
    exact le_iSup_of_le a' (le_iSup_of_le (show
      (cosetGraph d.radical).dist a' (p.walk.getVert 2) ≤ 2 by
        rw [SimpleGraph.dist_comm,p.dist_end,hl]) le_rfl)
  symm
  apply eq_of_le_of_card_ge (map_mono (comap_mono hZV))
  change Nat.card (graphImage s (V d.radical (p.walk.getVert 2))) ≤
    Nat.card (graphImage s (Z d.radical a'))
  rw [graphImage_card s _ (critical_Z_le_stabilizer d.radical (replacementGeometry h d)
    (alpha d.radical) rfl (replacementDistance_pos h d) p.critical)]
  have hf : d.radical.map (SourceReduction.projection h e hz hn d) =
      pointCore.map (MulAut.conj u).toMonoidHom := by
    rwa [SourceReduction.fullSymmetricAction_projection_unique h e hz hn d s] at hfull
  rw [(full_point_four_critical_indices_two_knownSimple hb u hf p).2]
  exact hcard

include s in
private theorem graph_commutator_le_of_image_le
    (A D : Subgroup (FreeAmalgam d.radical))
    (hA : A ≤ stabilizer d.radical (alpha d.radical))
    (himage : graphImage s A ≤ graphImage s D) :
    ⁅Z d.radical (alpha d.radical),A⁆ ≤ ⁅Z d.radical (alpha d.radical),D⁆ := by
  apply commutator_le.mpr
  intro z hz a ha
  obtain ⟨m,rfl⟩ := (hA.trans_eq (stabilizer_m_base d.radical)) ha
  have hm : s.projection m ∈ graphImage s A := mem_map_of_mem s.projection ha
  obtain ⟨n,hn,he⟩ := himage hm
  have hq : n⁻¹*m ∈ pCore 2 d.overgroup := by
    rw [←s.projection_kernel]
    change s.projection (n⁻¹*m) = 1
    rw [map_mul,map_inv,he,inv_mul_cancel]
  have hqG : embedM d.radical (n⁻¹*m) ∈ Q d.radical (alpha d.radical) := by
    rw [Q_alpha d.radical (replacement_radical_isPGroup h d) (replacement_core_le_radical h d)]
    exact mem_map_of_mem _ hq
  have hzq : ⁅z,embedM d.radical (n⁻¹*m)⁆ = 1 :=
    commutatorElement_eq_one_iff_mul_comm.mpr
      (((commutator_eq_bot_iff_le_centralizer.mp
        (Z_centralizes_Q d.radical (alpha d.radical) rfl)) hz) _ hqG).symm
  have hfactor : embedM d.radical m = embedM d.radical n * embedM d.radical (n⁻¹*m) := by
    rw [←map_mul,mul_inv_cancel_left]
  rw [hfactor,commutatorElement_mul_right_eq_mul_conj,hzq,mul_one,mul_inv_cancel_right]
  exact commutator_mem_commutator hz hn

/-- The entire midpoint radius moves the initial seed by precisely the
original critical line. This keeps the full Z-seed and both cover orders. -/
theorem four_midpoint_radius_commutator_eq_critical
    (hc : DistanceTwo.CentralLayer d) (hb : replacementDistance h d = 4)
    (u : S) (hfull : d.radical.map s.projection =
      pointCore.map (MulAut.conj u).toMonoidHom)
    {a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) a') :
    ⁅Z d.radical (alpha d.radical),V d.radical (p.walk.getVert 2)⁆ =
      ⁅Z d.radical (alpha d.radical),Z d.radical a'⁆ := by
  have hl : p.walk.length = 4 := p.length_eq_b.trans hb
  have hcol : color d.radical (p.walk.getVert 2) = false :=
    (p.vertex_color (by omega)).mpr (by decide)
  have hct : Adjacent d.radical (p.walk.getVert 2) (p.walk.getVert 1) :=
    adjacent_symm d.radical ((cosetGraph_adj d.radical _ _).mp
      (p.walk.adj_getVert_succ (i := 1) (by omega)))
  have hat : Adjacent d.radical (alpha d.radical) (p.walk.getVert 1) := by
    apply (cosetGraph_adj d.radical _ _).mp
    simpa only [SimpleGraph.Walk.getVert_zero] using p.walk.adj_getVert_succ (i := 0) (by omega)
  have hdt : (cosetGraph d.radical).dist (p.walk.getVert 2) (p.walk.getVert 1) = 1 :=
    SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj d.radical _ _).mpr hct)
  have hVt : V d.radical (p.walk.getVert 2) ≤ Q d.radical (p.walk.getVert 1) :=
    V_le_Q_of_dist_add_two_lt d.radical hcol (by
      rw [hdt]; change 1+2 < replacementDistance h d; omega)
  have hVG : V d.radical (p.walk.getVert 2) ≤ stabilizer d.radical (alpha d.radical) :=
    hVt.trans (fun _ hx => hx.2 _ (adjacent_symm d.radical hat))
  have hZV : Z d.radical a' ≤ V d.radical (p.walk.getVert 2) := by
    exact le_iSup_of_le a' (le_iSup_of_le (show
      (cosetGraph d.radical).dist a' (p.walk.getVert 2) ≤ 2 by
        rw [SimpleGraph.dist_comm,p.dist_end,hl]) le_rfl)
  exact le_antisymm (graph_commutator_le_of_image_le s _ _ hVG
    (four_midpoint_radius_image_eq_seed s hc hb u hfull p).le)
      (commutator_mono le_rfl hZV)

/-- The actual midpoint radius has the same noncentral order-two
commutator as the critical endpoint, with the original marking discharged. -/
theorem full_point_four_midpoint_radius_commutator_knownSimple
    (hb : replacementDistance h d = 4) (u : S)
    (hfull : d.radical.map (SourceReduction.projection h e hz hn d) =
      pointCore.map (MulAut.conj u).toMonoidHom)
    {a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) a') :
    ⁅Z d.radical (alpha d.radical),V d.radical (p.walk.getVert 2)⁆ =
        ⁅Z d.radical (alpha d.radical),Z d.radical a'⁆ ∧
      Nat.card (⁅Z d.radical (alpha d.radical),V d.radical (p.walk.getVert 2)⁆ :
        Subgroup (FreeAmalgam d.radical)) = 2 ∧
      ¬ ⁅Z d.radical (alpha d.radical),V d.radical (p.walk.getVert 2)⁆ ≤
        centralizer (stabilizer d.radical (alpha d.radical) : Set (FreeAmalgam d.radical)) := by
  let s := fullSymmetricAction_knownSimple h e hz hn d (by omega)
  have hc := DistanceTwo.centralLayer_knownSimple G L R h e hz hn d
  have hf : d.radical.map s.projection = pointCore.map (MulAut.conj u).toMonoidHom := by
    rwa [SourceReduction.fullSymmetricAction_projection_unique h e hz hn d s]
  have heq := four_midpoint_radius_commutator_eq_critical s hc hb u hf p
  refine ⟨heq,?_,?_⟩
  · rw [heq]
    exact (full_point_four_critical_indices_two_at_knownSimple hb u hfull p).2.2
  · rw [heq]
    exact critical_commutator_not_central s hc p

/-- Literal application to the chosen minimum characteristic replacement:
a larger two-edge radius image removes the remaining distance-four branch. -/
theorem original_full_point_distance_two_of_large_radius_image_knownSimple
    (u : S)
    (hfull : (replacement h).radical.map
      (SourceReduction.projection h e hz hn (replacement h)) =
        pointCore.map (MulAut.conj u).toMonoidHom)
    {a c : Vertex (replacement h).radical}
    (ha : color (replacement h).radical a = false)
    (hcCol : color (replacement h).radical c = false)
    (hcd : (cosetGraph (replacement h).radical).dist c a = 2)
    (hlarge : 2 < (Q (replacement h).radical a).relIndex (V (replacement h).radical c)) :
    replacementDistance h (replacement h) = 2 :=
  full_point_distance_two_of_large_radius_image_knownSimple u hfull ha hcCol hcd hlarge

/-- The full-point chosen replacement has distance two, or distance four
with every two-edge radius image bounded by two. This retains the unresolved
small-radius case as an explicit alternative. -/
theorem original_full_point_distance_two_or_four_radius_small_knownSimple
    (u : S)
    (hfull : (replacement h).radical.map
      (SourceReduction.projection h e hz hn (replacement h)) =
        pointCore.map (MulAut.conj u).toMonoidHom) :
    replacementDistance h (replacement h) = 2 ∨
      (replacementDistance h (replacement h) = 4 ∧
        ∀ (a c : Vertex (replacement h).radical),
          color (replacement h).radical a = false → color (replacement h).radical c = false →
          (cosetGraph (replacement h).radical).dist c a = 2 →
          (Q (replacement h).radical a).relIndex (V (replacement h).radical c) ≤ 2) := by
  rcases full_point_distance_two_or_four_knownSimple u hfull with hb | hb
  · exact Or.inl hb
  · refine Or.inr ⟨hb,?_⟩
    intro a c ha hcCol hcd
    let s := fullSymmetricAction_knownSimple h e hz hn (replacement h) (by omega)
    have hc := DistanceTwo.centralLayer_knownSimple G L R h e hz hn (replacement h)
    have hf : (replacement h).radical.map s.projection = pointCore.map (MulAut.conj u).toMonoidHom := by
      rwa [SourceReduction.fullSymmetricAction_projection_unique h e hz hn (replacement h) s]
    exact four_radius_index_le_two_at s hc hb u hf ha hcCol hcd

/-- The radius estimate discharges the selected-span index premise in the
source terminal natural-quotient argument. -/
theorem full_point_four_selected_span_index_knownSimple
    (hb : replacementDistance h d = 4) (u : S)
    (hfull : d.radical.map (SourceReduction.projection h e hz hn d) =
      pointCore.map (MulAut.conj u).toMonoidHom)
    {a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) a') :
    (Q d.radical (p.walk.getVert 2)).relIndex
      (localZSpan d.radical (p.walk.getVert 2) (alpha d.radical)) ≤ 2 := by
  have hb2 : 2 < replacementDistance h d := by omega
  have hPV : localZSpan d.radical (p.walk.getVert 2) (alpha d.radical) ≤
      V d.radical (alpha d.radical) := localZSpan_le_V d.radical (by
    rw [SimpleGraph.dist_comm,p.dist_start (by
      have hl : p.walk.length = replacementDistance h d := p.length_eq_b; omega)])
  let := finite_stabilizer d.radical (alpha d.radical)
  let : Finite (V d.radical (alpha d.radical)) := Finite.of_injective
    (inclusion ((V_le_Q d.radical rfl hb2).trans (fun _ hx => hx.1))) (inclusion_injective _)
  exact (relIndex_le_of_le_right hPV index_ne_zero_of_finite).trans_eq
    (full_point_four_midpoint_radius_indices_knownSimple hb u hfull p).2

/-- The literal selected natural quotient now needs only nonabelianness,
fixed derived subgroup, and the endpoint commutator estimate. Its image-size
and index premises follow from the original full-point distance-four data. -/
theorem selected_natural_quotient_of_full_point_four_estimates_knownSimple
    (hb : replacementDistance h d = 4) (u : S)
    (hfull : d.radical.map (SourceReduction.projection h e hz hn d) =
      pointCore.map (MulAut.conj u).toMonoidHom)
    {a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) a')
    (hnonabelian : ⁅localZSpan d.radical (p.walk.getVert 2) (alpha d.radical),
      localZSpan d.radical (p.walk.getVert 2) (alpha d.radical)⁆ ≠ ⊥)
    (hfixed : ⁅localZSpan d.radical (p.walk.getVert 2) (alpha d.radical),
      localZSpan d.radical (p.walk.getVert 2) (alpha d.radical)⁆ ≤
      centralizer (Ltilde d.radical (alpha d.radical) : Set (FreeAmalgam d.radical)))
    (hcomm : ⁅localZSpan d.radical (p.walk.getVert 2) (alpha d.radical) ⊓
        Q d.radical (p.walk.getVert 2),Z d.radical a'⁆ ≤ Z d.radical (alpha d.radical)) :
    ∃ (E : ((forwardMovedSpan d.radical (p.walk.getVert 2)) ⧸
          center (forwardMovedSpan d.radical (p.walk.getVert 2))) ≃*
        Multiplicative (BinaryPermutation.natural (Fin 6)))
      (τ : S ≃* S),
      ∀ (m : d.overgroup) (x : forwardMovedSpan d.radical (p.walk.getVert 2)),
        (E (QuotientGroup.mk' _ (forwardMovedSpanAction d.radical (p.walk.getVert 2) m x))).toAdd =
          BinaryPermutation.naturalRepresentation (Fin 6)
            (τ (SourceReduction.projection h e hz hn d m))
            (E (QuotientGroup.mk' _ x)).toAdd := by
  have hb2 : 2 < replacementDistance h d := by omega
  let s := fullSymmetricAction_knownSimple h e hz hn d hb2
  have hc := DistanceTwo.centralLayer_knownSimple G L R h e hz hn d
  have hi := (full_point_four_critical_indices_two_knownSimple hb u hfull p).1
  have hindex := full_point_four_selected_span_index_knownSimple hb u hfull p
  have hout := selected_natural_quotient_of_path_estimates s hc hb2
    (h.sqtk.subgroup d.overgroup) p (by omega) hnonabelian hfixed hindex hcomm
  rwa [SourceReduction.fullSymmetricAction_projection_unique h e hz hn d s] at hout

