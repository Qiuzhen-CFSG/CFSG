private theorem critical_first_seed_noncentral_base
    (u : S)
    (hR : (Rg).map π ≤ pointCore.map (MulAut.conj u).toMonoidHom)
    {a' : Vertex Rg}
    (p : CriticalPath Rg (sourceGeometry h) (alpha Rg) a') :
    ¬ ⁅Z Rg (alpha Rg),Z Rg a'⁆ ⊓ Z Rg (p.walk.getVert 1) ≤
      centralizer (stabilizer Rg (alpha Rg) : Set (FreeAmalgam Rg)) := by
  have hp := sourceDistance_pos h
  have hl : p.walk.length = sourceDistance h := p.length_eq_b
  let t := p.walk.getVert 1
  have hat : Adjacent Rg (alpha Rg) t := by
    apply (cosetGraph_adj Rg _ _).mp
    simpa only [SimpleGraph.Walk.getVert_zero] using
      p.walk.adj_getVert_succ (i := 0) (by omega)
  have ht : color Rg t = true := by
    have hh := adjacent_color_ne Rg hat
    change false ≠ color Rg t at hh
    cases he : color Rg t <;> simp_all
  have hAt : Z Rg a' ≤ Q Rg t := by
    apply Z_le_Q_of_dist_lt Rg a' ((sourceGeometry h).exists_critical a' p.end_color)
    rw [SimpleGraph.dist_comm,p.dist_end,(sourceGeometry h).distance_constant _ p.end_color]
    change p.walk.length-1 < sourceDistance h
    omega
  have htG : Q Rg t ≤ stabilizer Rg (alpha Rg) :=
    fun _ hx => hx.2 _ (adjacent_symm Rg hat)
  obtain ⟨v,hv⟩ := terminal_graphImage_le_pointCore_of_le_edge h e hz hk u hR
    t hat (Q Rg t) le_rfl
  let A := (Z Rg a').comap (embedM Rg)
  let T := (Q Rg t).comap (embedM Rg)
  have hmA : A.map (embedM Rg) = Z Rg a' :=
    map_comap_eq_self ((hAt.trans htG).trans_eq (stabilizer_m_base Rg))
  have hmT : T.map (embedM Rg) = Q Rg t :=
    map_comap_eq_self (htG.trans_eq (stabilizer_m_base Rg))
  have hAv : A.map π ≤ pointCore.map (MulAut.conj v).toMonoidHom :=
    (map_mono (comap_mono hAt)).trans hv
  let := (sourceGeometry h).Z_elementary hp a' p.end_color
  let := IsElementaryAbelian.comap_of_injective (p := 2) (embedM Rg) (embedM_injective Rg) (Z Rg a')
  have hswap : v*swap45*v⁻¹ ∈ A.map π := by
    by_cases hs : (Q Rg a').relIndex (Z Rg (alpha Rg)) < 4
    · obtain ⟨k,hkSwap,hkA⟩ := small_critical_image_eq_swap h e hz hk p hs
      have hkMem : k ∈ A.map π := hkA.symm ▸ mem_zpowers k
      have he := PointCoreTranspositionFixed.swap_eq_conjugate v k (hAv hkMem) hkSwap
      exact he ▸ hkMem
    · have hcard : 4 ≤ Nat.card (A.map π) := by
        rw [CubicAction.permutation_image_card_of_two h e hz hk A
          (IsElementaryAbelian.isPGroup 2 A)]
        have hi := reverse_critical_image_four_le h e hz hk hp p (by omega)
        rwa [Q_alpha Rg h.relative_radical.isPGroup h.relative_radical.twoCore_le,
          ←hmA,relIndex_map_map_of_injective _ _ (embedM_injective Rg)] at hi
      have hquad : QuadraticPointCore.Quadratic (A.map π) := by
        apply image_quadratic_of_commutator h e hz hk A
        intro x hx y hy
        apply embedM_injective Rg
        simp only [map_mul]
        have hx' : embedM Rg x ∈ Z Rg a' := by
          apply (terminal_critical_seed_commutator_le h p).trans inf_le_right
          apply commutator_mono (DistanceEight.U_le_Z Rg _) le_rfl
          rw [←graph_U_map h e hz,←hmA,←map_commutator]
          exact mem_map_of_mem _ hx
        exact (le_centralizer_iff_isMulCommutative.mpr inferInstance) hx' _ hy
      exact Natural.Exhaustion.LargeDistance.SectionFive.TerminalLine.conjugate_four_contains_swap
        (A.map π) v hAv hquad hcard
  have hn := point_transposition_fixed_commutator h e hz hk A T v hv hswap
  intro hcentral
  apply hn
  rintro x ⟨hx,hxT⟩
  have hxD : embedM Rg x ∈ ⁅Z Rg (alpha Rg),Z Rg a'⁆ := by
    have hh := mem_map_of_mem (embedM Rg) hx
    rw [map_commutator,hmA,graph_U_map h e hz] at hh
    exact commutator_mono (DistanceEight.U_le_Z Rg _) le_rfl hh
  have hxZ : embedM Rg x ∈ Z Rg (alpha Rg) :=
    ((terminal_critical_seed_commutator_le h p).trans inf_le_left) hxD
  have hxQ : embedM Rg x ∈ Q Rg t := by
    apply Q_le_adjacent_h Rg ht hat
    apply Z_le_Q_of_dist_lt Rg _ ((sourceGeometry h).exists_critical _ rfl) _ hxZ
    rw [SimpleGraph.dist_self,(sourceGeometry h).distance_constant _ rfl]
    exact hp
  have hxC : embedM Rg x ∈ centralizer (Q Rg t : Set (FreeAmalgam Rg)) := by
    rw [←hmT]
    exact map_centralizer_le_centralizer_image (T : Set M) (embedM Rg)
      (mem_map_of_mem _ hxT)
  have hxseed : embedM Rg x ∈ Z Rg t := by
    rw [Z,if_neg (by simp [ht])]
    let := (sourceGeometry h).Z_elementary hp (alpha Rg) rfl
    exact mem_omegaCenter_iff.mpr ⟨hxQ,elemPow_eq_one_of_isElementaryAbelian _ hxZ,hxC⟩
  apply mem_center_iff.mpr
  intro m
  apply embedM_injective Rg
  simp only [map_mul]
  apply hcentral ⟨hxD,hxseed⟩
  change embedM Rg m ∈ stabilizer Rg (mVertex Rg 1)
  rw [stabilizer_m_base]
  exact ⟨m,rfl⟩
include h e hz hk in
/-- A critical commutator meets its first edge seed in a subgroup that is
noncentral at its own start. This retains the center of the order-32 cover. -/
theorem critical_first_seed_noncentral (u : S)
    (hR : (Rg).map π ≤ pointCore.map (MulAut.conj u).toMonoidHom)
    {a a' : Vertex Rg}
    (p : CriticalPath Rg (sourceGeometry h) a a') :
    ¬ ⁅Z Rg a,Z Rg a'⁆ ⊓ Z Rg (p.walk.getVert 1) ≤
      centralizer (stabilizer Rg a : Set (FreeAmalgam Rg)) := by
  obtain ⟨g,hg⟩ := exists_mVertex_of_color Rg p.start_color
  have hbase : act Rg g⁻¹ a = alpha Rg := by
    rw [hg,act_mVertex,mul_inv_cancel]
    rfl
  have base := critical_first_seed_noncentral_base h e hz hk u hR
    (a' := act Rg g⁻¹ a')
  rw [←hbase] at base
  intro hcentral
  apply base (p.act g⁻¹)
  have hh := (map_mono (f := (MulAut.conj g).toMonoidHom) hcentral).trans
    (map_centralizer_le_centralizer_image _ _)
  rw [map_inf _ _ _ (MulAut.conj g).injective,map_commutator] at hh
  simpa only [CriticalPath.act,actWalk_getVert,Z_act,stabilizer_act,inv_inv,Subgroup.coe_map] using hh

private theorem terminal_central_fixed_map {F : Type*} [Group F] (H K : Subgroup F)
    (hHK : H ≤ centralizer (K : Set F)) {x : F} (hx : x ∈ K) :
    H.map (MulAut.conj x).toMonoidHom = H :=
  mem_normalizer_iff_map_conj_eq.mp
    (Subgroup.centralizer_le_normalizer _ (le_centralizer_iff.mp hHK hx))

include h e hz hk in
/-- The same two generating edges and component transporter exclude the
critical configuration for both cover orders. -/
theorem point_image_three_shift_generators_false
    (u : S)
    (hfull : (Rg).map π ≤ pointCore.map (MulAut.conj u).toMonoidHom)
    {a b : Vertex Rg} (p : CriticalPath Rg (sourceGeometry h) a b)
    (c v z f g : Vertex Rg)
    (hct : Adjacent Rg c (p.walk.getVert 1)) (hcv : Adjacent Rg c v)
    (hgenC : Q Rg (p.walk.getVert 1)⊔Z Rg f=stabilizer Rg c)
    (hgenD : Q Rg v⊔Z Rg g=stabilizer Rg z)
    (hRf : ⁅Z Rg a,Z Rg b⁆≤centralizer (Z Rg f:Set (FreeAmalgam Rg)))
    (hRg : ⁅Z Rg a,Z Rg b⁆≤centralizer (Z Rg g:Set (FreeAmalgam Rg)))
    (x : FreeAmalgam Rg) (hx : x∈stabilizer Rg c) (hxa : act Rg x z=a) : False := by
  let H := ⁅Z Rg a,Z Rg b⁆⊓Z Rg (p.walk.getVert 1)
  have hnon := critical_first_seed_noncentral h e hz hk u hfull p
  have ht : color Rg (p.walk.getVert 1)=true := by
    have hcol := p.vertex_color (show 1≤p.walk.length by
      have hh : 0<p.walk.length := p.length_eq_b ▸ sourceDistance_pos h
      omega)
    have hf : ¬color Rg (p.walk.getVert 1)=false := by
      intro hh
      have he := hcol.mp hh
      norm_num at he
    cases he : color Rg (p.walk.getVert 1) <;> simp_all
  have hseed (w : Vertex Rg) (hw : color Rg w=true) :
      Z Rg w≤centralizer (Q Rg w:Set (FreeAmalgam Rg)) := by
    intro z hz
    rw [Z,if_neg (by simp [hw])] at hz
    exact (mem_omegaCenter_iff.mp hz).2.2
  have hHC : H≤centralizer (stabilizer Rg c:Set (FreeAmalgam Rg)) := by
    apply le_centralizer_iff.mp
    rw [←hgenC]
    exact sup_le (le_centralizer_iff.mp (inf_le_right.trans (hseed _ ht)))
      (le_centralizer_iff.mp (inf_le_left.trans hRf))
  have hHv : H≤Z Rg v := by
    obtain ⟨y,hy,hyt⟩ := stabilizer_transitive_neighbors Rg c hct hcv
    rw [←hyt,Z_act]
    rw [←terminal_central_fixed_map H (stabilizer Rg c) hHC ((stabilizer Rg c).inv_mem hy)]
    exact map_mono inf_le_right
  have hc0 : color Rg c=false := by
    have hh := adjacent_color_ne Rg hct
    rw [ht] at hh
    cases he : color Rg c <;> simp_all
  have hv : color Rg v=true := by
    have hh := adjacent_color_ne Rg hcv
    rw [hc0] at hh
    cases he : color Rg v <;> simp_all
  have hHD : H≤centralizer (stabilizer Rg z:Set (FreeAmalgam Rg)) := by
    apply le_centralizer_iff.mp
    rw [←hgenD]
    exact sup_le (le_centralizer_iff.mp (hHv.trans (hseed _ hv)))
      (le_centralizer_iff.mp (inf_le_left.trans hRg))
  have hHA : H≤centralizer (stabilizer Rg a:Set (FreeAmalgam Rg)) := by
    rw [←hxa,stabilizer_act]
    have hh := (map_mono (f:=(MulAut.conj x⁻¹).toMonoidHom) hHD).trans
      (map_centralizer_le_centralizer_image _ _)
    rwa [terminal_central_fixed_map H (stabilizer Rg c) hHC ((stabilizer Rg c).inv_mem hx)] at hh
  exact hnon hHA


include h e hz hk in
/-- The two generating backward shifts exclude distance greater than four
on the original cubic graph, retaining both moving covers and the full kernel. -/
theorem full_point_distance_le_four (u : S)
    (hfull : (Rg).map π = pointCore.map (MulAut.conj u).toMonoidHom) :
    sourceDistance h ≤ 4 := by
  by_contra! hb
  obtain ⟨a',⟨p⟩⟩ := CriticalPath.exists_from (R := Rg)
    (geometry := sourceGeometry h) (a := alpha Rg) rfl
  obtain ⟨c,t,x,hx,hxc,hat,hct,hgen,q,hq1,hover⟩ :=
    full_point_generating_backward_step_at h e hz hk hb u hfull p
  obtain ⟨z,v,y,hy,hyz,hcv,hzv,hgen',r,hr1,hover'⟩ :=
    full_point_generating_backward_step_at h e hz hk hb u hfull q
  have hq2 : q.walk.getVert 2 = alpha Rg := by
    simpa only [Nat.zero_add,SimpleGraph.Walk.getVert_zero] using hover 0 (Nat.zero_le _)
  have hyz' : act Rg y (alpha Rg) = z := by rwa [hq2] at hyz
  have hlenP : p.walk.length = sourceDistance h := p.length_eq_b
  have hlenQ : q.walk.length = sourceDistance h := q.length_eq_b
  have hdist1 : (cosetGraph Rg).dist (q.walk.getVert (q.walk.length-2))
      (p.walk.getVert (p.walk.length-2)) = 2 := by
    rw [q.dist_end]
    omega
  have hdist2 : (cosetGraph Rg).dist (p.walk.getVert (p.walk.length-2)) a' = 2 := by
    rw [p.dist_end]
    omega
  have hdist : (cosetGraph Rg).dist (q.walk.getVert (q.walk.length-2)) a' ≤ 4 := by
    have hh := (cosetGraph_connected Rg).dist_triangle
      (u := q.walk.getVert (q.walk.length-2)) (v := p.walk.getVert (p.walk.length-2)) (w := a')
    omega
  have hHe : ⁅Z Rg z,Z Rg (q.walk.getVert (q.walk.length-2))⁆ ≤
      Z Rg (q.walk.getVert (q.walk.length-2)) :=
    (terminal_critical_seed_commutator_le h r).trans inf_le_right
  have hcent (w : Vertex Rg) (hw : color Rg w = false)
      (hdist : (cosetGraph Rg).dist (q.walk.getVert (q.walk.length-2)) w < sourceDistance h) :
      ⁅Z Rg z,Z Rg (q.walk.getVert (q.walk.length-2))⁆ ≤
        centralizer (Z Rg w : Set (FreeAmalgam Rg)) := by
    apply (hHe.trans (Z_le_Q_of_dist_lt Rg _
      ((sourceGeometry h).exists_critical _ r.end_color) ?_)).trans
      (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp
        (Z_centralizes_Q Rg w hw)))
    rwa [(sourceGeometry h).distance_constant _ r.end_color]
  exact point_image_three_shift_generators_false h e hz hk u hfull.le r
    c t (alpha Rg) (p.walk.getVert (p.walk.length-2)) a'
    (by rw [hr1]; exact hcv) hct
    (by rw [hr1]; exact hgen') hgen
    (hcent _ q.end_color (by omega)) (hcent _ p.end_color (by omega))
    y hy hyz'

include h e hz hk in
/-- Positivity and parity leave exactly distances two and four in the
full point-core branch of the original cubic graph. -/
theorem full_point_distance_two_or_four (u : S)
    (hfull : (Rg).map π = pointCore.map (MulAut.conj u).toMonoidHom) :
    sourceDistance h = 2 ∨ sourceDistance h = 4 := by
  have hb := full_point_distance_le_four h e hz hk u hfull
  have hp := sourceDistance_pos h
  have he := sourceDistance_even h
  rw [Nat.even_iff] at he
  omega

omit hk in
include h e hz in
/-- The whole-core reduction now leaves only distance four whenever the
original cubic radical has full point-core image. Identifying that image and
excluding distance four remain explicit mathematical obligations. -/
theorem coreExhaustion_or_cubic_full_point_distance_four :
    CoreExhaustion L R ∨ ∃ hk : layerKernel L R = extensionKernel h,
      Function.Surjective (CubicAction.projection h e hz hk) ∧
      2 < sourceDistance h ∧
      (∀ a : Vertex Rg, color Rg a = false → Nat.card (U Rg a) = 16 ∨ Nat.card (U Rg a) = 32) ∧
      ∀ u : S, (Rg).map (CubicAction.projection h e hz hk) =
        pointCore.map (MulAut.conj u).toMonoidHom → sourceDistance h = 4 := by
  rcases CubicEven.coreExhaustion_or_cubic_fullSymmetric h e hz with hx | ⟨hk,hs,hb⟩
  · exact Or.inl hx
  · refine Or.inr ⟨hk,hs,hb,graph_U_card h e hz hk,?_⟩
    intro u hu
    exact (full_point_distance_two_or_four h e hz hk u hu).resolve_left (by omega)

omit hk in
include h e hz in
/-- Literal C.1.32 application of the cubic terminal bound, retaining both
full moving covers and the actual projection. -/
theorem rankTwo_or_cubic_full_point_distance_four :
    RankTwoAlternatives L R ∨ ∃ hk : layerKernel L R = extensionKernel h,
      Function.Surjective (CubicAction.projection h e hz hk) ∧
      2 < sourceDistance h ∧
      (∀ a : Vertex Rg, color Rg a = false → Nat.card (U Rg a) = 16 ∨ Nat.card (U Rg a) = 32) ∧
      ∀ u : S, (Rg).map (CubicAction.projection h e hz hk) =
        pointCore.map (MulAut.conj u).toMonoidHom → sourceDistance h = 4 :=
  (coreExhaustion_or_cubic_full_point_distance_four h e hz).imp (rankTwo_of_exhaustion h e hz) id

