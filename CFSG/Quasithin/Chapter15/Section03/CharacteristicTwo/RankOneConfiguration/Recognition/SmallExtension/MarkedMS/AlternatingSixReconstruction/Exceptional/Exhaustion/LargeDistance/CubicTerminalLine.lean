variable {G : Type u} [Group G] [Finite G] {L R : Subgroup G}
  (h : SmallMSPair KnownSimple.IsKnownSimple L R) (e : CentralMarking L)
  (hz : Nat.card (center (L ⧸ pCore 2 L)) = 3)
  (hk : layerKernel L R = extensionKernel h)
local notation "M" => (L ⊔ R : Subgroup G)
local notation "Rg" => edge L R
local notation "W" => (⁅centralOmega L R,L.subgroupOf (L ⊔ R)⁆ : Subgroup M)
local notation "π" => CubicAction.projection h e hz hk
local instance : IsElementaryAbelian 2 W := IsElementaryAbelian.of_le (commutator_le_left _ _)
private abbrev terminalCoverAction : Representation (ZMod 2) S (Additive W) := by
  let := h.relative_normal
  exact NormalElementaryQuotient.representation W π
    (CubicEven.projection_surjective h e hz hk) (CubicAction.moved_projection_kernel h e hz hk)
private theorem terminalCoverAction_conjugate (g : M) (v : Additive W) :
    ((terminalCoverAction h e hz hk (π g) v).toMul : M) = g*v.toMul*g⁻¹ := by
  let := h.relative_normal
  exact NormalElementaryQuotient.representation_apply W π
    (CubicEven.projection_surjective h e hz hk) (CubicAction.moved_projection_kernel h e hz hk) g v

include h e hz hk in
/-- The actual point-core transposition supplies a noncentral commutator in
 the full cubic moving cover, fixed by the prescribed edge subgroup. -/
theorem point_transposition_fixed_commutator
    (A T : Subgroup M) (u : S)
    (hT : T.map π ≤ pointCore.map (MulAut.conj u).toMonoidHom)
    (ha : u*swap45*u⁻¹ ∈ A.map π) :
    ¬ ⁅W,A⁆ ⊓ centralizer (T : Set M) ≤ center M := by
  let := h.relative_normal
  obtain ⟨a,ha,hea⟩ := ha
  obtain ⟨v,hfix,hnon⟩ :=
    Natural.Exhaustion.LargeDistance.SectionFive.TerminalLine.cover_model_fixed_displacement
      (terminalCoverAction h e hz hk) (moved_subgroup_cover_model h e hz hk) u
  let r := terminalCoverAction h e hz hk (u*swap45*u⁻¹) v-v
  have hr : (r.toMul : M) = a*v.toMul*a⁻¹*(v.toMul : M)⁻¹ := by
    dsimp only [r]
    rw [toMul_sub,Subgroup.coe_div,div_eq_mul_inv,←hea,terminalCoverAction_conjugate]
  have hrA : (r.toMul : M) ∈ ⁅W,A⁆ := by
    rw [hr,commutator_comm]
    exact commutator_mem_commutator ha v.toMul.property
  have hrT : (r.toMul : M) ∈ centralizer (T : Set M) := by
    intro t ht
    have hh := congrArg (fun z : Additive W => (z.toMul : M))
      (hfix (π t) (hT (mem_map_of_mem _ ht)))
    rw [terminalCoverAction_conjugate] at hh
    exact mul_inv_eq_iff_eq_mul.mp hh
  intro hcentral
  have hc := hcentral ⟨hrA,hrT⟩
  apply hnon
  intro g
  obtain ⟨t,rfl⟩ := CubicEven.projection_surjective h e hz hk g
  change (terminalCoverAction h e hz hk (π t) r).toMul = r.toMul
  apply Subtype.ext
  rw [terminalCoverAction_conjugate,(mem_center_iff.mp hc t),mul_inv_cancel_right]

private theorem terminal_graphImage_le_pointCore_of_le_edge (u : S)
    (hR : (Rg).map π ≤ pointCore.map (MulAut.conj u).toMonoidHom)
    (t : Vertex Rg) (hat : Adjacent Rg (alpha Rg) t)
    (A : Subgroup (FreeAmalgam Rg)) (hAt : A ≤ Q Rg t) :
    ∃ v : S, CubicAction.graphImage h e hz hk A ≤ pointCore.map (MulAut.conj v).toMonoidHom := by
  obtain ⟨g,hg|hg⟩ := edge_transitive Rg hat (base_adjacent Rg)
  · have hgM : g ∈ (embedM Rg).range := by
      change g ∈ Mbar Rg
      rw [← stabilizer_m_base Rg]
      exact hg.1
    obtain ⟨m,rfl⟩ := hgM
    have hQt : (Q Rg t).map
        (MulAut.conj ((embedM Rg m)⁻¹)).toMonoidHom =
          (Rg).map (embedM Rg) := by
      rw [← Q_act,hg.2]
      exact Q_beta Rg
    have hAm (x : M) (hx : x ∈ A.comap (embedM Rg)) :
        m⁻¹*x*m ∈ Rg := by
      have hh := ((map_mono hAt).trans_eq hQt) (mem_map_of_mem
        (MulAut.conj ((embedM Rg m)⁻¹)).toMonoidHom hx)
      obtain ⟨r,hr,he⟩ := hh
      have heq : r = m⁻¹*x*m := by
        apply embedM_injective Rg
        change embedM Rg r = (embedM Rg m)⁻¹ *
          embedM Rg x * ((embedM Rg m)⁻¹)⁻¹ at he
        simpa only [map_mul,map_inv,inv_inv] using he
      exact heq ▸ hr
    refine ⟨π m * u,?_⟩
    rintro _ ⟨x,hx,rfl⟩
    obtain ⟨r,hr,he⟩ := hR (mem_map_of_mem π (hAm x hx))
    refine ⟨r,hr,?_⟩
    change (π m*u)*r*(π m*u)⁻¹=π x
    have he' : u*r*u⁻¹ = (π m)⁻¹*π x*π m := by
      change u*r*u⁻¹ = π (m⁻¹*x*m) at he
      simpa only [map_mul,map_inv] using he
    calc
      (π m*u)*r*(π m*u)⁻¹ =
          π m*(u*r*u⁻¹)*(π m)⁻¹ := by group
      _ = π x := by rw [he']; group
  · have hh : color Rg (beta Rg) = false := by
      change color Rg (hVertex Rg 1) = false
      rw [← hg.1,action_preserves_color]
      rfl
    cases hh


