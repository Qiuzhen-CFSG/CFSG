public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS
open ChapterC AlternatingSixReconstruction
universe u

/-- The two source branches suffice, with natural irreducibility proved from
the given equivariant model and the quotient-center split proved in Setup. -/
theorem alternatingSixReconstruction_of_core_cases {κ : GroupClass.{u}}
    (hn : NaturalCoreInput κ) (hx : ExceptionalCoreInput κ) :
    AlternatingSixReconstructionInput κ := by
  intro J _ _ L R h e
  rcases h.alternating_center_cases e with hz | hz
  · obtain ⟨he, hc, hm⟩ := hn J L R h e hz
    exact ⟨he, hc, hm.alternating_six_irreducible, Or.inl hm⟩
  · obtain ⟨he, hc, hi, hu, hf⟩ := hx J L R h e hz
    exact ⟨he, hc, hi, Or.inr ⟨hz, hu, hf⟩⟩

/-- Actual application to the parent's C.1.32 consumer. The source hypotheses
give relative blockhood; neither R being Sylow nor a block assumption is used. -/
theorem SmallMSPair.rankTwo_of_alternatingSix_core_cases
    {G : Type u} [Group G] [Finite G] {κ : GroupClass.{u}} {L R : Subgroup G}
    (hn : NaturalCoreInput κ) (hx : ExceptionalCoreInput κ)
    (h : SmallMSPair κ L R)
    (e : (L ⧸ centralPreimage (pCore 2 L)) ≃*
      commutator (Matrix.symplecticGroup (Fin 2) (ZMod 2))) :
    RankTwoAlternatives L R :=
  h.rankTwo_of_alternatingSix_reconstruction e
    (alternatingSixReconstruction_of_core_cases hn hx G L R h e)

end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS
