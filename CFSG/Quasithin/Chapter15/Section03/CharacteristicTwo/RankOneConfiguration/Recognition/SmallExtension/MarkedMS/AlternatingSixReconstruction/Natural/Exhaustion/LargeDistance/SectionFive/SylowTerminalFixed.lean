module
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.SmallExtension.MarkedMS.AlternatingSixReconstruction.Natural.Exhaustion.LargeDistance.SectionFive.SylowTerminalCores
import all CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.SmallExtension.MarkedMS.AlternatingSixReconstruction.Natural.Exhaustion.LargeDistance.SectionFive.OmegaExtension

/-!
# Residual-fixed whole omega and the terminal critical line

A small critical pair makes the residual-fixed part of the whole omega
center central in the component stabilizer. Its commutator with the critical
actor lies in the order-two critical line and in the residual-fixed part
of the moved cover. The latter is central; the former misses the stabilizer
center. The commutator therefore vanishes. The actual symmetric quotient,
generated by its alternating subgroup and the critical transposition, then
proves full centrality. Transport gives this at every component vertex.

The terminal line already lies in the intermediate whole omega center and
is noncentral there, so it escapes the intermediate fixed core. This uses
the source fixed core C_Q(O²(G)), not the commutator core [Q,O²(G)]. Both
moved covers and their full central attachments remain unchanged.

The internal import reuses the full-omega embedding and centralizer
calculations. The reverse-shift application is in SylowTerminalComparison.
Source: Meierfrankenfeld--Stellmacher, Pushing up weak BN-pairs of rank two
(1993), (3.3), (5.10), printed pp.866--867 and 923.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped commutatorElement Pointwise
open CFSG.Quasithin.ChapterC.BinaryMS.MS93 Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS
namespace AlternatingSixReconstruction.Natural.Exhaustion.LargeDistance.SectionFive
universe u
variable {G : Type u} [Group G] [Finite G] {L R : Subgroup G}
  {h : SmallMSPair KnownSimple.IsKnownSimple L R} {e : CentralMarking L}
  {hz : center (L ⧸ pCore 2 L) = ⊥} {hn : InitialNatural h e hz}
  {d : Replacement L R}


variable (s : FullSymmetricAction h e hz hn d)

private theorem alternating_swap_generate (t : Equiv.Perm (Fin 6)) (ht : t.IsSwap) :
    alternatingGroup (Fin 6) ⊔ zpowers t = ⊤ := by
  have hout : t ∉ alternatingGroup (Fin 6) := by
    simp only [Equiv.Perm.mem_alternatingGroup,ht.sign_eq]
    decide
  apply top_unique
  intro x _
  by_cases hx : x ∈ alternatingGroup (Fin 6)
  · exact mem_sup_left hx
  · have hxt : x*t⁻¹ ∈ alternatingGroup (Fin 6) := by
      rw [Subgroup.mul_mem_iff_of_index_two alternatingGroup.index_eq_two,inv_mem_iff]
      exact iff_of_false hx hout
    have hh := (alternatingGroup (Fin 6) ⊔ zpowers t).mul_mem
      (mem_sup_left hxt) (mem_sup_right (mem_zpowers t))
    simpa using hh

include s in
private theorem base_omega_fixed_central
    (hc : DistanceTwo.CentralLayer d)
    {a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) a')
    (hsmall : (Q d.radical a').relIndex (Z d.radical (alpha d.radical)) < 4) :
    omegaCenterIn (pCore 2 d.overgroup) ⊓
      centralizer (replacementComponent d : Set d.overgroup) ≤ center d.overgroup := by
  let i := embedM d.radical
  let X₀ := omegaCenterIn (pCore 2 d.overgroup)
  let F := X₀ ⊓ centralizer (replacementComponent d : Set d.overgroup)
  let A := (Z d.radical a').comap i
  let H := ⁅F,A⁆
  let D := ⁅Z d.radical (alpha d.radical),Z d.radical a'⁆
  have hi := embedM_injective d.radical
  have hir : i.range = stabilizer d.radical (alpha d.radical) :=
    (stabilizer_m_base d.radical).symm
  have hXm : X₀.map i = X d.radical (alpha d.radical) := omega_map (h := h)
  have hAm : A.map i = Z d.radical a' := map_comap_eq_self
    ((critical_Z_le_stabilizer d.radical (replacementGeometry h d) _ rfl
      (replacementDistance_pos h d) p.critical).trans_eq hir.symm)
  have hZX : Z d.radical a' ≤ X d.radical a' := by
    apply (replacementGeometry h d).omega_bound a' p.end_color
    rw [(replacementGeometry h d).distance_constant _ p.end_color]
    exact replacementDistance_pos h d
  have hHD : H.map i ≤ D := by
    rw [show H = ⁅F,A⁆ from rfl,map_commutator,hAm]
    have hFX : F.map i ≤ X d.radical (alpha d.radical) :=
      (map_mono (f := i) (show F ≤ X₀ from inf_le_left)).trans_eq hXm
    exact (commutator_mono hFX hZX).trans_eq (small_critical_X_commutator s hc p hsmall)
  have hDU : D ≤ U d.radical (alpha d.radical) :=
    (critical_Z_commutator_le_moving (h := h) p).trans inf_le_left
  have hHU : H ≤ replacementMoved d := by
    apply (map_le_map_iff_of_injective hi).mp
    exact (hHD.trans hDU).trans_eq hc.U_eq_moved
  let := replacementComponent_normal h d
  let : X₀.Normal := omega_normal
  let : F.Normal := inferInstance
  have hHF : H ≤ F := commutator_le_left F A
  have hHC : H ≤ center d.overgroup :=
    (le_inf hHU (hHF.trans inf_le_right)).trans (moved_fixed_le_center s)
  have hHCm : H.map i ≤ centralizer
      (stabilizer d.radical (alpha d.radical) : Set (FreeAmalgam d.radical)) := by
    rintro _ ⟨x,hx,rfl⟩ y hy
    rw [←hir] at hy
    obtain ⟨y,rfl⟩ := hy
    exact (map_mul i y x).symm.trans
      ((congrArg i ((mem_center_iff.mp (hHC hx)) y)).trans (map_mul i x y))
  have hHbot : H = ⊥ := by
    apply (map_injective hi)
    rw [Subgroup.map_bot]
    apply le_bot_iff.mp
    exact (le_inf hHD hHCm).trans_eq (small_critical_commutator_inf_centralizer s hc p hsmall)
  let C := centralizer (F : Set d.overgroup)
  have hAC : A ≤ C := le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hHbot)
  have hQC : pCore 2 d.overgroup ≤ C :=
    (omega_centralizer s).symm.le.trans (centralizer_le (show F ≤ X₀ from inf_le_left))
  have hLC : replacementComponent d ≤ C := le_centralizer_iff.mp inf_le_right
  obtain ⟨t,ht,him⟩ := small_critical_image_eq_swap s hc p hsmall
  have him' : A.map s.projection = zpowers t := him
  have hCm : C.map s.projection = ⊤ := by
    apply top_unique
    rw [←alternating_swap_generate t ht]
    exact sup_le (s.component_image ▸ map_mono (f := s.projection) hLC)
      (him' ▸ map_mono (f := s.projection) hAC)
  have hC : C = ⊤ := by
    apply map_injective_of_ker_le s.projection (s.projection_kernel ▸ hQC) le_top
    rw [hCm,←MonoidHom.range_eq_map,MonoidHom.range_eq_top.mpr s.surjective]
  change F ≤ center d.overgroup
  rw [←centralizer_univ]
  change F ≤ centralizer ((⊤ : Subgroup d.overgroup) : Set d.overgroup)
  apply le_centralizer_iff.mp
  change ⊤ ≤ C
  rw [hC]

include s in
/-- A small critical pair forces the residual-fixed part of the whole omega
center to be central at every component vertex. This retains the full omega
layer, not just its moved summand. -/
theorem omega_fixed_central_of_small_critical
    (hc : DistanceTwo.CentralLayer d)
    {a a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) a a')
    (hsmall : (Q d.radical a').relIndex (Z d.radical a) < 4)
    (c : Vertex d.radical) (hcfalse : color d.radical c = false) :
    X d.radical c ⊓ fixedCore d.radical c ≤
      centralizer (stabilizer d.radical c : Set (FreeAmalgam d.radical)) := by
  obtain ⟨g,hga⟩ := exists_mVertex_of_color d.radical p.start_color
  subst a
  have hbase : act d.radical g⁻¹ (mVertex d.radical g) = alpha d.radical := by
    simp only [act_mVertex,mul_inv_cancel]
    rfl
  have hh := base_omega_fixed_central s hc (a' := act d.radical g⁻¹ a')
  rw [←hbase] at hh
  have hs : (Q d.radical (act d.radical g⁻¹ a')).relIndex
      (Z d.radical (act d.radical g⁻¹ (mVertex d.radical g))) < 4 := by
    rw [Q_act,Z_act,relIndex_map_map_of_injective _ _ (MulAut.conj _).injective]
    exact hsmall
  specialize hh (p.act g⁻¹) hs
  let F := omegaCenterIn (pCore 2 d.overgroup) ⊓
    centralizer (replacementComponent d : Set d.overgroup)
  have hcomm : ⁅F,(⊤ : Subgroup d.overgroup)⁆ = ⊥ := by
    apply commutator_eq_bot_iff_le_centralizer.mpr
    simpa only [coe_top,centralizer_univ] using hh
  have hLm : (replacementComponent d).map (embedM d.radical) =
      Ltilde d.radical (alpha d.radical) := by
    rw [Ltilde_alpha,replacement_residual h d]
  have hGm : (⊤ : Subgroup d.overgroup).map (embedM d.radical) =
      stabilizer d.radical (alpha d.radical) :=
    (MonoidHom.range_eq_map _).symm.trans (stabilizer_m_base _).symm
  have hbaseComm := congrArg (Subgroup.map (embedM d.radical)) hcomm
  dsimp only [F] at hbaseComm
  rw [map_commutator,←map_inf_centralizer_of_injective _ (embedM_injective d.radical),
    omega_map (h := h),hLm,hGm,Subgroup.map_bot] at hbaseComm
  obtain ⟨k,rfl⟩ := exists_mVertex_of_color d.radical hcfalse
  have htrans := congrArg (Subgroup.map (MulAut.conj k⁻¹).toMonoidHom) hbaseComm
  rw [map_commutator,←map_inf_centralizer_of_injective _ (MulAut.conj k⁻¹).injective,
    ←X_act,←Ltilde_act,←stabilizer_act,Subgroup.map_bot] at htrans
  have hfix : X d.radical (mVertex d.radical k) ⊓
      centralizer (Ltilde d.radical (mVertex d.radical k) : Set (FreeAmalgam d.radical)) ≤
      centralizer (stabilizer d.radical (mVertex d.radical k) : Set (FreeAmalgam d.radical)) := by
    apply commutator_eq_bot_iff_le_centralizer.mp
    simpa only [alpha,act_mVertex,one_mul] using htrans
  exact (inf_le_inf_left _ (show fixedCore d.radical (mVertex d.radical k) ≤
    centralizer (Ltilde d.radical (mVertex d.radical k) : Set (FreeAmalgam d.radical)) from inf_le_right)).trans hfix

include e hz hn in
/-- The terminal critical line escapes the intermediate residual-fixed core.
The centrality premise is discharged on the actual small critical path. -/
theorem orbit_terminal_line_not_le_fixedCore_knownSimple
    (hb : 4 < replacementDistance h d)
    (hcard : Nat.card (d.radical.map (SourceReduction.projection h e hz hn d)) = 16)
    {a a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) a a')
    (q : BackwardShift (h := h) p) (r : BackwardShift (h := h) q.path)
    (t : BackwardShift (h := h) r.path)
    (hr : SylowTerminalPath.OrbitPrefix (h := h) r.path (replacementDistance h d)) :
    ¬ ⁅Z d.radical t.start,Z d.radical (r.path.walk.getVert (r.path.walk.length-2))⁆ ≤
      fixedCore d.radical r.start := by
  have hb2 : 2 < replacementDistance h d := by omega
  let s := fullSymmetricAction_knownSimple h e hz hn d hb2
  have hc := DistanceTwo.centralLayer_knownSimple G L R h e hz hn d
  have hs := SylowShiftChain.two_backward_shifts_small_moving_knownSimple
    (e := e) (hz := hz) (hn := hn) hb p q r
  have hsmall : (Q d.radical (q.path.walk.getVert (q.path.walk.length-2))).relIndex
      (Z d.radical r.start) < 4 := by rw [hs.2.1]; decide
  have hcentral := omega_fixed_central_of_small_critical s hc r.path hsmall r.start r.path.start_color
  have hline := orbit_terminal_line_in_omega_knownSimple hb hcard p q r t hr
  intro hfixed
  exact hline.2.2 ((le_inf hline.2.1 hfixed).trans hcentral)


end AlternatingSixReconstruction.Natural.Exhaustion.LargeDistance.SectionFive
end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS
