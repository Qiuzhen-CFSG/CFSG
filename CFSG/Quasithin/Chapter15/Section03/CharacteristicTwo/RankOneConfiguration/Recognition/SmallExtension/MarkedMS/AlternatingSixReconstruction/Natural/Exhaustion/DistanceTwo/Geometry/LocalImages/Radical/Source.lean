module
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.SmallExtension.MarkedMS.AlternatingSixReconstruction.Natural.Exhaustion.DistanceTwo.Geometry.LocalImages.CriticalTransposition.Source
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.SmallExtension.MarkedMS.AlternatingSixReconstruction.Natural.Exhaustion.DistanceTwo.Geometry.LocalImages.Radical.Model

/-!
# Radical-derived containment outside the full Sylow image

The original opposite-edge coordinates retain the entire radical map.
The critical Z-image is normal in that edge image and is generated by one
transposition, so that transposition is central in the image. The sign-kernel
argument then bounds every nonabelian possibility to order sixteen.
Pullback through the literal projection proves radical-derived containment
for every other image. Both whole moved covers remain unchanged.

The order-sixteen branch and the opposite-plane bound are still obligations
of qt-e-ms-small-a6-exhaustion-distance-two. The original commutator consumer
is in Assembly.Radical.Source. Source: MS93 (3.3)(ii), (3.6), pp.866--871.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender BinaryPermutation
open scoped IsMulCommutative commutatorElement
open CFSG.Quasithin.ChapterC.BinaryMS.MS93 Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticDistanceTwo
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS.AlternatingSixReconstruction.Natural.Exhaustion.DistanceTwo.Geometry.LocalImages
open LargeDistance PlaneMovement
universe u
variable {G : Type u} [Group G] [Finite G] {L R : Subgroup G}
  (h : SmallMSPair KnownSimple.IsKnownSimple L R) (e : CentralMarking L)
  (hz : center (L ⧸ pCore 2 L) = ⊥) (hn : InitialNatural h e hz)
  (d : Replacement L R)
include h e hz hn in
/-- The critical transposition is central in the entire literal radical image. -/
theorem radical_image_central_transposition
    (hb : replacementDistance h d = 2)
    (hlarge : ¬ core d.radical (alpha d.radical) ≤
      (frattini (Q d.radical (alpha d.radical))).map
        (Q d.radical (alpha d.radical)).subtype ⊔ X d.radical (alpha d.radical)) :
    ∃ t : Equiv.Perm (Fin 6), t.IsSwap ∧
      t ∈ d.radical.map (Recognition.sourceProjection h e hz hn d) ∧
      ∀ r ∈ d.radical.map (Recognition.sourceProjection h e hz hn d), t*r=r*t := by
  obtain ⟨c,hc⟩ := criticalPair_exists d.radical (alpha d.radical)
    ((replacementGeometry h d).exists_critical _ rfl)
  obtain ⟨b,i,A,hi,hab,hcb,hAR,hAm,hiW,hiS,hiL,hiR,t,hswap,he⟩ :=
    critical_transposition_coordinates_with_edge h e hz hn d hb hlarge hc
  let q := Recognition.sourceProjection h e hz hn d
  have ht : t ∈ A.map q := he ▸ mem_zpowers t
  have ht1 : t ≠ 1 := by
    intro hh
    have ho := hswap.orderOf
    rw [hh,orderOf_one] at ho
    omega
  refine ⟨t,hswap,map_mono hAR ht,?_⟩
  rintro _ ⟨r,hr,rfl⟩
  obtain ⟨a,ha,hat⟩ := ht
  have hconj : r*a*r⁻¹ ∈ A := by
    have hmem : i (r*a*r⁻¹) ∈ A.map i := by
      rw [hAm,map_mul,map_mul,map_inv]
      apply le_normalizer_iff.mp (Z_normalized d.radical (alpha d.radical))
      · have hrb : i r ∈ Q d.radical b := hiR ▸ mem_map_of_mem i hr
        exact hrb.2 _ (adjacent_symm d.radical hab)
      · exact hAm ▸ mem_map_of_mem i ha
    obtain ⟨z,hz,hzval⟩ := hmem
    exact hi hzval ▸ hz
  have hqm : (MulAut.conj (q r)) t ∈ zpowers t := by
    rw [←he,←hat]
    simpa only [MulAut.conj_apply,map_mul,map_inv] using mem_map_of_mem q hconj
  rw [mem_zpowers_iff_mem_range_orderOf,hswap.orderOf] at hqm
  obtain ⟨n,hnn,hnval⟩ := Finset.mem_image.mp hqm
  have hnn' := Finset.mem_range.mp hnn
  have hfixed : (MulAut.conj (q r)) t = t := by
    interval_cases n
    · rw [pow_zero] at hnval
      exact (ht1 ((MulAut.conj (q r)).map_eq_one_iff.mp hnval.symm)).elim
    · simpa only [pow_one] using hnval.symm
  exact (mul_inv_eq_iff_eq_mul.mp hfixed).symm
include h e hz hn in
/-- All nonabelian radical images are full Sylow images of order sixteen. -/
theorem radical_derived_or_image_sixteen
    (hb : replacementDistance h d = 2)
    (hlarge : ¬ core d.radical (alpha d.radical) ≤
      (frattini (Q d.radical (alpha d.radical))).map
        (Q d.radical (alpha d.radical)).subtype ⊔ X d.radical (alpha d.radical)) :
    ⁅d.radical,d.radical⁆ ≤ pCore 2 d.overgroup ∨
      Nat.card (d.radical.map (Recognition.sourceProjection h e hz hn d)) = 16 := by
  obtain ⟨t,ht,htR,hcent⟩ := radical_image_central_transposition h e hz hn d hb hlarge
  let q := Recognition.sourceProjection h e hz hn d
  rcases commutative_or_card_sixteen_of_central_swap (d.radical.map q)
      ((replacement_radical_isPGroup h d).map q) t ht htR hcent with hab | h16
  · apply Or.inl
    rw [←Recognition.sourceProjection_kernel h e hz hn d]
    apply (Subgroup.map_eq_bot_iff _).mp
    rw [map_commutator]
    exact commutator_self_eq_bot_iff.mpr hab
  · exact Or.inr h16

include h e hz hn in
/-- The exceptional image really makes the original replacement radical
Sylow: the literal quotient projection preserves its odd index. -/
theorem radical_sylow_of_image_sixteen
    (hb : replacementDistance h d = 2)
    (hlarge : ¬ core d.radical (alpha d.radical) ≤
      (frattini (Q d.radical (alpha d.radical))).map
        (Q d.radical (alpha d.radical)).subtype ⊔ X d.radical (alpha d.radical))
    (h16 : Nat.card (d.radical.map (Recognition.sourceProjection h e hz hn d)) = 16) :
    ∃ P : Sylow 2 d.overgroup, (P : Subgroup d.overgroup) = d.radical := by
  let q := Recognition.sourceProjection h e hz hn d
  have hq := sourceProjection_surjective_of_nonfrattini h e hz hn d hb hlarge
  have hk : q.ker ≤ d.radical := (Recognition.sourceProjection_kernel h e hz hn d) ▸
    replacement_core_le_radical h d
  have hidx := index_map_eq d.radical hq hk
  have hc := (d.radical.map q).card_mul_index
  rw [h16,hidx,Nat.card_perm,Nat.card_fin] at hc
  have hi : d.radical.index = 45 := by norm_num at hc; omega
  refine ⟨(replacement_radical_isPGroup h d).toSylow ?_,rfl⟩
  rw [hi]
  decide

include h e hz hn in
/-- The derived clause is unconditional on every radical image of order
strictly smaller than a Sylow image; the actual radical is never replaced. -/
theorem radical_derived_of_image_card_ne_sixteen
    (hb : replacementDistance h d = 2)
    (hlarge : ¬ core d.radical (alpha d.radical) ≤
      (frattini (Q d.radical (alpha d.radical))).map
        (Q d.radical (alpha d.radical)).subtype ⊔ X d.radical (alpha d.radical))
    (h16 : Nat.card (d.radical.map (Recognition.sourceProjection h e hz hn d)) ≠ 16) :
    ⁅d.radical,d.radical⁆ ≤ pCore 2 d.overgroup :=
  (radical_derived_or_image_sixteen h e hz hn d hb hlarge).resolve_right h16

include h e hz hn in
/-- Both source-image clauses hold on every image outside the order-sixteen
case, including the original critical relative-index convention. -/
theorem localImageData_of_image_card_ne_sixteen
    (hb : replacementDistance h d = 2)
    (hlarge : ¬ core d.radical (alpha d.radical) ≤
      (frattini (Q d.radical (alpha d.radical))).map
        (Q d.radical (alpha d.radical)).subtype ⊔ X d.radical (alpha d.radical))
    (h16 : Nat.card (d.radical.map (Recognition.sourceProjection h e hz hn d)) ≠ 16) :
    LocalImageData h d :=
  ⟨radical_derived_of_image_card_ne_sixteen h e hz hn d hb hlarge h16,
    fun _ hc => critical_image_two h e hz hn d hb hlarge hc⟩

end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS.AlternatingSixReconstruction.Natural.Exhaustion.DistanceTwo.Geometry.LocalImages
