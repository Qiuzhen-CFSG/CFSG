local notation "S" => Equiv.Perm (Fin 6)
private abbrev a : S := kleinFirst 6 (by decide)
private abbrev t : S := pairSwap 6 2

private theorem centralizer_certificate : ∀ g : S,
    g*a=a*g → ∃ i : Fin 16, sylowWords i = g := by
  intro g hga
  have ha0 : g 1 = a (g 0) := congrArg (fun q : S => q 0) hga
  have ha2 : g 3 = a (g 2) := congrArg (fun q : S => q 2) hga
  have ha4 : g 4 = a (g 4) := congrArg (fun q : S => q 4) hga
  have ha5 : g 5 = a (g 5) := congrArg (fun q : S => q 5) hga
  have hfixed : ∀ i : Fin 6, i = a i → 4 ≤ i := by decide +kernel
  have hmoved : ∀ i : Fin 6, a i ≠ i → i < 4 := by decide +kernel
  have h0lt : g 0 < 4 := hmoved _ (by
    intro he
    exact (by decide : (1 : Fin 6) ≠ 0) (g.injective (ha0.trans he)))
  have h2lt : g 2 < 4 := hmoved _ (by
    intro he
    exact (by decide : (3 : Fin 6) ≠ 2) (g.injective (ha2.trans he)))
  have h4 : 4 ≤ g 4 := hfixed _ ha4
  have h5 : 4 ≤ g 5 := hfixed _ ha5
  have hlast : ∀ i j : Fin 6, 4 ≤ i → 4 ≤ j → j ≠ i → j = t i := by decide +kernel
  have ht4 : g 5 = t (g 4) := hlast _ _ h4 h5 (g.injective.ne (by decide))
  have h03 : g 0 ≠ a (g 2) := by
    rw [←ha2]
    exact g.injective.ne (by decide)
  have table : ∀ i j k : Fin 6, i < 4 → j < 4 → i ≠ j → i ≠ a j → 4 ≤ k →
      ∃ n : Fin 16, sylowWords n 0 = i ∧ sylowWords n 2 = j ∧ sylowWords n 4 = k := by
    decide +kernel
  obtain ⟨n,h0,h2,h4⟩ := table (g 0) (g 2) (g 4) h0lt h2lt
    (g.injective.ne (by decide)) h03 h4
  have words : ∀ n : Fin 16,
      sylowWords n 1 = a (sylowWords n 0) ∧
      sylowWords n 3 = a (sylowWords n 2) ∧
      sylowWords n 5 = t (sylowWords n 4) := by decide +kernel
  refine ⟨n,?_⟩
  apply Equiv.ext
  intro i
  fin_cases i
  · exact h0
  · exact (words n).1.trans ((congrArg a h0).trans ha0.symm)
  · exact h2
  · exact (words n).2.1.trans ((congrArg a h2).trans ha2.symm)
  · exact h4
  · exact (words n).2.2.trans ((congrArg t h4).trans ht4.symm)

private theorem normalizer_plus_isPGroup : IsPGroup 2 (normalizer (plus : Set S)) := by
  apply (IsPGroup.of_card (p := 2) (n := 4) card_sylowCarrier).to_le
  intro g hg
  have ha : a ∈ plus := subset_closure (by simp)
  have hga := (mem_normalizer_iff.mp hg a).mp ha
  obtain ⟨i,hi⟩ := (mem_plus_iff _).mp hga
  have hca : (g*a*g⁻¹).support.card = 4 := by
    rw [Equiv.Perm.card_support_conj]
    decide
  rw [←hi] at hca
  have hacert : ∀ i : Fin 4, (planeWords 0 i).support.card = 4 → planeWords 0 i = a := by
    decide +kernel
  have hga' : g*a*g⁻¹=a := hi.symm.trans (hacert i hca)
  exact (mem_sylowCarrier_iff _).mpr (centralizer_certificate g
    (mul_inv_eq_iff_eq_mul.mp hga'))

private theorem normalizer_pair_isPGroup :
    IsPGroup 2 (normalizer (disjointTranspositions 6 2 : Set S)) := by
  apply (IsPGroup.of_card (p := 2) (n := 4) card_sylowCarrier).to_le
  intro g hg
  have ha : a ∈ disjointTranspositions 6 2 :=
    (mem_disjointTranspositions_iff (2 : Fin 4) _).mpr ⟨3, by decide⟩
  have hga := (mem_normalizer_iff.mp hg a).mp ha
  obtain ⟨i,hi⟩ := (mem_disjointTranspositions_iff (2 : Fin 4) _).mp hga
  have hca : (g*a*g⁻¹).support.card = 4 := by
    rw [Equiv.Perm.card_support_conj]
    decide
  rw [←hi] at hca
  have hacert : ∀ i : Fin 4,
      (initialWords 2 i).support.card = 4 → initialWords 2 i = a := by
    decide +kernel
  have hga' : g*a*g⁻¹=a := hi.symm.trans (hacert i hca)
  exact (mem_sylowCarrier_iff _).mpr (centralizer_certificate g
    (mul_inv_eq_iff_eq_mul.mp hga'))

private theorem normalizer_conjugate_pair_isPGroup (g : S) :
    IsPGroup 2 (normalizer
      ((disjointTranspositions 6 2).map (MulAut.conj g).toMonoidHom : Set S)) := by
  rw [←map_normalizer_eq_of_bijective (disjointTranspositions 6 2)
    (MulAut.conj g).bijective]
  exact normalizer_pair_isPGroup.map _

private theorem normalizer_conjugate_plus_isPGroup (g : S) :
    IsPGroup 2 (normalizer (plus.map (MulAut.conj g).toMonoidHom : Set S)) := by
  rw [←map_normalizer_eq_of_bijective plus (MulAut.conj g).bijective]
  exact normalizer_plus_isPGroup.map _

private theorem elementary_of_squares (A : Subgroup S)
    (hs : ∀ x ∈ A, x ^ 2 = 1) : IsElementaryAbelian 2 A := by
  have hp (x : A) : x ^ 2 = 1 := Subtype.ext (hs x x.property)
  let : IsMulCommutative A :=
    ⟨⟨fun x y => (Commute.of_orderOf_dvd_two
      (fun z => orderOf_dvd_of_pow_eq_one (hp z)) x y).eq⟩⟩
  exact ⟨Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr hp⟩

private theorem sylow_square_certificate : ∀ i : Fin 16,
    (sylowWords i)^2 = 1 ∨ (sylowWords i)^2 = a := by decide +kernel

private theorem nonelementary_normalizer_of_le_sylow (A : Subgroup S)
    (hA : A ≤ sylowCarrier) (hne : ¬ IsElementaryAbelian 2 A) :
    IsPGroup 2 (normalizer (A : Set S)) := by
  have hex : ∃ x ∈ A, x^2 ≠ 1 := by
    by_contra! hh
    exact hne (elementary_of_squares A hh)
  obtain ⟨x,hx,hsq⟩ := hex
  obtain ⟨i,hi⟩ := (mem_sylowCarrier_iff _).mp (hA hx)
  have hx2 : x^2 = a := (hi ▸ sylow_square_certificate i).resolve_left hsq
  apply (IsPGroup.of_card (p := 2) (n := 4) card_sylowCarrier).to_le
  intro g hg
  have hconj := (mem_normalizer_iff.mp hg x).mp hx
  obtain ⟨j,hj⟩ := (mem_sylowCarrier_iff _).mp (hA hconj)
  have hsqconj : (g*x*g⁻¹)^2 = g*a*g⁻¹ := by
    change ((MulAut.conj g) x)^2 = (MulAut.conj g) a
    rw [←map_pow,hx2]
  have hga : g*a*g⁻¹=a := by
    rcases hj ▸ sylow_square_certificate j with he | he
    · have he1 : a = 1 := (MulAut.conj g).injective
        ((hsqconj.symm.trans he).trans (map_one (MulAut.conj g)).symm)
      exact (hsq (hx2.trans he1)).elim
    · exact hsqconj.symm.trans he
  exact (mem_sylowCarrier_iff _).mpr (centralizer_certificate g
    (mul_inv_eq_iff_eq_mul.mp hga))

private theorem nonelementary_normalizer_isPGroup (A : Subgroup S) (hp : IsPGroup 2 A)
    (hne : ¬ IsElementaryAbelian 2 A) : IsPGroup 2 (normalizer (A : Set S)) := by
  obtain ⟨P,hAP⟩ := hp.exists_le_sylow
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq S P sylow
  let f := (MulAut.conj g).toMonoidHom
  have hAs : A.map f ≤ sylowCarrier := by
    rintro _ ⟨x,hx,rfl⟩
    change (MulAut.conj g) x ∈ (sylow : Subgroup S)
    rw [←hg]
    exact mem_map_of_mem f (hAP hx)
  have hn : ¬ IsElementaryAbelian 2 (A.map f) := by
    intro hel
    let := hel
    apply hne
    apply elementary_of_squares
    intro x hx
    apply (MulAut.conj g).injective
    rw [map_pow,map_one]
    exact elemPow_eq_one_of_isElementaryAbelian _ (mem_map_of_mem f hx)
  have hh := nonelementary_normalizer_of_le_sylow (A.map f) hAs hn
  rw [←map_normalizer_eq_of_bijective A (MulAut.conj g).bijective] at hh
  have hc := hh.comap_of_ker_isPGroup f
    (IsPGroup.ker_isPGroup_of_injective (MulAut.conj g).injective)
  rwa [comap_map_eq_self_of_injective (MulAut.conj g).injective] at hc


private theorem pgroup_of_intersection {F : Type*} [Group F]
    (N H : Subgroup F) [N.Normal] (hq : IsPGroup 2 (F ⧸ N))
    (hi : IsPGroup 2 (H.subgroupOf N)) : IsPGroup 2 H := by
  intro x
  obtain ⟨k,hk⟩ := hq ((QuotientGroup.mk' N) (x : F))
  have hxN : (x : F) ^ (2 ^ k) ∈ N := by
    apply (QuotientGroup.eq_one_iff _).mp
    change (QuotientGroup.mk' N) ((x : F) ^ (2 ^ k)) = 1
    simpa only [map_pow] using hk
  obtain ⟨l,hl⟩ := hi ⟨⟨(x : F) ^ (2 ^ k),hxN⟩,H.pow_mem x.property _⟩
  refine ⟨k+l,?_⟩
  apply Subtype.ext
  change (x : F) ^ (2 ^ (k+l)) = 1
  rw [pow_add,pow_mul]
  exact congrArg (fun y : H.subgroupOf N => ((y : N) : F)) hl

private theorem pcore_top {F : Type*} [Group F] (hp : IsPGroup 2 F) :
    pCore 2 F = ⊤ := by
  apply top_unique
  exact le_sSup ⟨inferInstance,hp.to_subgroup ⊤⟩

end NonsylowImage

universe u
variable {G : Type u} [Group G] [Finite G] {κ : GroupClass.{u}} {L R : Subgroup G}
  {h : SmallMSPair κ L R} {e : CentralMarking L}
  {hz : center (L ⧸ pCore 2 L) = ⊥} {hn : InitialNatural h e hz}
  {d : Replacement L R}

private theorem original_sylow_of_image_normalizer_twoGroup
    (s : FullSymmetricAction h e hz hn d)
    (hp : IsPGroup 2 (normalizer (d.radical.map s.projection : Set (Equiv.Perm (Fin 6))))) :
    ∃ T : Sylow 2 (L ⊔ R : Subgroup G), (T : Subgroup (L ⊔ R : Subgroup G)) =
      R.subgroupOf (L ⊔ R) := by
  let M := (L ⊔ R : Subgroup G)
  let R₀ := R.subgroupOf (L ⊔ R)
  obtain ⟨H,_,hodd,hcore⟩ := h.relative_radical
  let := d.characteristic
  let := replacement_normal h d
  have hHR : H ≤ normalizer (R₀ : Set M) := by
    dsimp only [R₀]
    rw [←hcore]
    exact H.le_normalizer.trans (normalizer_le_normalizer_characteristic_image H (pCore 2 H))
  have hHD : H ≤ normalizer (d.ambient : Set M) :=
    hHR.trans (normalizer_le_normalizer_characteristic_image R₀ d.subgroup)
  have hnD : H.subgroupOf d.overgroup ≤ normalizer (d.radical : Set d.overgroup) :=
    (comap_mono hHD).trans (le_normalizer_comap d.overgroup.subtype)
  have hm : (H.subgroupOf d.overgroup).map s.projection ≤
      normalizer (d.radical.map s.projection : Set (Equiv.Perm (Fin 6))) :=
    (map_mono hnD).trans (le_normalizer_map s.projection)
  have hk : IsPGroup 2 s.projection.ker := by
    rw [s.projection_kernel]
    exact pCore_isPGroup
  have hi : IsPGroup 2 (H.subgroupOf d.overgroup) :=
    (hp.comap_of_ker_isPGroup s.projection hk).to_le (map_le_iff_le_comap.mp hm)
  have hquot : IsPGroup 2 (M ⧸ d.overgroup) := by
    apply isPGroup_quotient_of_sup_eq_top d.overgroup R₀ h.relative_radical.isPGroup
    apply top_unique
    rw [←relative_sup (L := L) (R := R)]
    exact sup_le (le_sup_left.trans le_sup_left) le_sup_right
  have hHp : IsPGroup 2 H := NonsylowImage.pgroup_of_intersection d.overgroup H hquot hi
  have hHR_eq : H = R₀ := by
    rw [NonsylowImage.pcore_top hHp,←MonoidHom.range_eq_map,range_subtype] at hcore
    exact hcore
  exact ⟨hHp.toSylow hodd.not_two_dvd_nat,hHR_eq⟩

open Theory.SpecificGroups.SymmetricSix.BinaryFlags

/-- A mixed-plane image forces the original MS2(a) radical to be Sylow.
This conclusion concerns the original radical, not its characteristic replacement. -/
theorem large_distance_mixed_original_sylow_knownSimple
    {h : SmallMSPair KnownSimple.IsKnownSimple L R} {e : CentralMarking L}
    {hz : center (L ⧸ pCore 2 L) = ⊥} {hn : InitialNatural h e hz}
    (hb : 2 < replacementDistance h d) (g : Equiv.Perm (Fin 6))
    (himage : d.radical.map (SourceReduction.projection h e hz hn d) =
      plus.map (MulAut.conj g).toMonoidHom) :
    ∃ T : Sylow 2 (L ⊔ R : Subgroup G), (T : Subgroup (L ⊔ R : Subgroup G)) =
      R.subgroupOf (L ⊔ R) := by
  let s := fullSymmetricAction_knownSimple h e hz hn d hb
  apply original_sylow_of_image_normalizer_twoGroup s
  rw [SourceReduction.fullSymmetricAction_projection_unique h e hz hn d s,himage]
  exact NonsylowImage.normalizer_conjugate_plus_isPGroup g


/-- Two disjoint transpositions as replacement image force the original
MS2(a) radical to be Sylow, using its odd-index witness and characteristicity. -/
theorem large_distance_pair_original_sylow_knownSimple
    {h : SmallMSPair KnownSimple.IsKnownSimple L R} {e : CentralMarking L}
    {hz : center (L ⧸ pCore 2 L) = ⊥} {hn : InitialNatural h e hz}
    (hb : 2 < replacementDistance h d) (g : Equiv.Perm (Fin 6))
    (himage : d.radical.map (SourceReduction.projection h e hz hn d) =
      (disjointTranspositions 6 2).map (MulAut.conj g).toMonoidHom) :
    ∃ T : Sylow 2 (L ⊔ R : Subgroup G), (T : Subgroup (L ⊔ R : Subgroup G)) =
      R.subgroupOf (L ⊔ R) := by
  let s := fullSymmetricAction_knownSimple h e hz hn d hb
  apply original_sylow_of_image_normalizer_twoGroup s
  rw [SourceReduction.fullSymmetricAction_projection_unique h e hz hn d s,himage]
  exact NonsylowImage.normalizer_conjugate_pair_isPGroup g

/-- For a nonsylow original radical, every large-distance replacement has
an elementary abelian quotient image. Nonabelian and exponent-four images
are thereby excluded without a Sylow assumption on the replacement. -/
theorem nonsylow_radical_image_elementary_knownSimple
    {h : SmallMSPair KnownSimple.IsKnownSimple L R} {e : CentralMarking L}
    {hz : center (L ⧸ pCore 2 L) = ⊥} {hn : InitialNatural h e hz}
    (hb : 2 < replacementDistance h d)
    (hns : ¬ ∃ T : Sylow 2 (L ⊔ R : Subgroup G),
      (T : Subgroup (L ⊔ R : Subgroup G)) = R.subgroupOf (L ⊔ R)) :
    IsElementaryAbelian 2 (d.radical.map (SourceReduction.projection h e hz hn d)) := by
  by_contra hnE
  let s := fullSymmetricAction_knownSimple h e hz hn d hb
  apply hns
  apply original_sylow_of_image_normalizer_twoGroup s
  rw [SourceReduction.fullSymmetricAction_projection_unique h e hz hn d s]
  exact NonsylowImage.nonelementary_normalizer_isPGroup _
    ((replacement_radical_isPGroup h d).map _) hnE

/-- The original nonsylow hypothesis discharges full point-core equality
from mere point-core containment, in the unchanged natural marking. -/
theorem nonsylow_point_image_full_knownSimple
    {h : SmallMSPair KnownSimple.IsKnownSimple L R} {e : CentralMarking L}
    {hz : center (L ⧸ pCore 2 L) = ⊥} {hn : InitialNatural h e hz}
    (hb : 2 < replacementDistance h d)
    (hns : ¬ ∃ T : Sylow 2 (L ⊔ R : Subgroup G),
      (T : Subgroup (L ⊔ R : Subgroup G)) = R.subgroupOf (L ⊔ R))
    (u : Equiv.Perm (Fin 6))
    (hpoint : d.radical.map (SourceReduction.projection h e hz hn d) ≤
      pointCore.map (MulAut.conj u).toMonoidHom) :
    d.radical.map (SourceReduction.projection h e hz hn d) =
      pointCore.map (MulAut.conj u).toMonoidHom := by
  rcases (large_distance_point_images_knownSimple hb u hpoint).2.2 with he | ⟨g,hg⟩
  · exact he
  · exact (hns (large_distance_mixed_original_sylow_knownSimple hb g hg)).elim

/-- The literal replacement has distance at most four in the point-contained
nonsylow branch. Both the full-point and mixed-plane alternatives are discharged. -/
theorem nonsylow_point_distance_le_four_knownSimple
    {h : SmallMSPair KnownSimple.IsKnownSimple L R} {e : CentralMarking L}
    {hz : center (L ⧸ pCore 2 L) = ⊥} {hn : InitialNatural h e hz}
    (hns : ¬ ∃ T : Sylow 2 (L ⊔ R : Subgroup G),
      (T : Subgroup (L ⊔ R : Subgroup G)) = R.subgroupOf (L ⊔ R))
    (u : Equiv.Perm (Fin 6))
    (hpoint : d.radical.map (SourceReduction.projection h e hz hn d) ≤
      pointCore.map (MulAut.conj u).toMonoidHom) : replacementDistance h d ≤ 4 := by
  by_contra! hb
  exact (Nat.not_le_of_gt hb) (full_point_distance_le_four_knownSimple u
    (nonsylow_point_image_full_knownSimple (by omega) hns u hpoint))

/-- For a nonsylow original radical, all proper elementary replacement
images are excluded. The remaining image is one of the two full elementary
eights in the same natural six-letter marking. -/
theorem nonsylow_radical_image_maximal_knownSimple
    {h : SmallMSPair KnownSimple.IsKnownSimple L R} {e : CentralMarking L}
    {hz : center (L ⧸ pCore 2 L) = ⊥} {hn : InitialNatural h e hz}
    (hb : 2 < replacementDistance h d)
    (hns : ¬ ∃ T : Sylow 2 (L ⊔ R : Subgroup G),
      (T : Subgroup (L ⊔ R : Subgroup G)) = R.subgroupOf (L ⊔ R)) :
    (∃ g : Equiv.Perm (Fin 6),
      d.radical.map (SourceReduction.projection h e hz hn d) =
        pointCore.map (MulAut.conj g).toMonoidHom) ∨
    (∃ g : Equiv.Perm (Fin 6),
      d.radical.map (SourceReduction.projection h e hz hn d) =
        (D 6).map (MulAut.conj g).toMonoidHom) := by
  let A := d.radical.map (SourceReduction.projection h e hz hn d)
  have hcard : 4 ≤ Nat.card A := large_distance_radical_image_four_le_knownSimple hb
  have hne : A ≠ ⊥ := by
    intro he
    rw [he,card_bot] at hcard
    omega
  have hel : IsElementaryTwo A :=
    ⟨hne,nonsylow_radical_image_elementary_knownSimple hb hns⟩
  have hodd : ¬ A ≤ alternatingGroup (Fin 6) := by
    intro hle
    let s := fullSymmetricAction_knownSimple h e hz hn d hb
    have hR : d.radical.map s.projection ≤ alternatingGroup (Fin 6) := by
      rwa [SourceReduction.fullSymmetricAction_projection_unique h e hz hn d s]
    obtain ⟨x,hx⟩ := s.surjective swap01
    obtain ⟨k,hk,r,hr,hkr⟩ := replacement_product h d x
    have hk' : s.projection k ∈ alternatingGroup (Fin 6) := by
      rw [←s.component_image]
      exact mem_map_of_mem s.projection hk
    have hr' := hR (mem_map_of_mem s.projection hr)
    have hswap : swap01 ∈ alternatingGroup (Fin 6) := by
      rw [←hx,←hkr,map_mul]
      exact mul_mem hk' hr'
    exact (by decide : swap01 ∉ alternatingGroup (Fin 6)) hswap
  obtain ⟨B,hB,hBD | hBE,hAB⟩ := exists_conjugate_le_D_or_exceptional hel
  · rcases subgroup_D_conjugacy hBD hB.1 with hh | hh | hh | hh | hh | hh | hh
    · have he := (hAB.trans hh).card_eq
      have hc : Nat.card (disjointTranspositions 6 1) = 2 :=
        card_disjointTranspositions (1 : Fin 4)
      rw [hc] at he
      omega
    · obtain ⟨g,hg⟩ := hAB.trans hh
      exact (hns (large_distance_pair_original_sylow_knownSimple hb g hg)).elim
    · exact Or.inr (hAB.trans hh)
    · have he := (hAB.trans hh).card_eq
      rw [card_double] at he
      omega
    · have he := (hAB.trans hh).card_eq
      rw [card_triple] at he
      omega
    · obtain ⟨g,hg⟩ := hAB.trans hh
      exact (hns (large_distance_mixed_original_sylow_knownSimple hb g hg)).elim
    · exact (hodd ((hAB.trans hh).le_alternating_iff.mpr inf_le_right)).elim
  · obtain ⟨g,hg⟩ := hAB
    have hpoint : A ≤ pointCore.map (MulAut.conj g).toMonoidHom := by
      rw [hg,CFSG.Quasithin.ChapterC.NaturalSixControl.Model.pointCore_eq_exceptional]
      exact map_mono hBE
    exact Or.inl ⟨g,nonsylow_point_image_full_knownSimple hb hns g hpoint⟩

/-- Beyond four, a nonsylow original radical forces the full three-pair
image. No other elementary image, nor a full point-core image, remains. -/
theorem nonsylow_four_lt_radical_image_cube_knownSimple
    {h : SmallMSPair KnownSimple.IsKnownSimple L R} {e : CentralMarking L}
    {hz : center (L ⧸ pCore 2 L) = ⊥} {hn : InitialNatural h e hz}
    (hb : 4 < replacementDistance h d)
    (hns : ¬ ∃ T : Sylow 2 (L ⊔ R : Subgroup G),
      (T : Subgroup (L ⊔ R : Subgroup G)) = R.subgroupOf (L ⊔ R)) :
    ∃ g : Equiv.Perm (Fin 6),
      d.radical.map (SourceReduction.projection h e hz hn d) =
        (D 6).map (MulAut.conj g).toMonoidHom := by
  rcases nonsylow_radical_image_maximal_knownSimple
    (h := h) (e := e) (hz := hz) (hn := hn) (d := d) (by omega) hns with ⟨g,hg⟩ | hh
  · exact (Nat.not_le_of_gt hb (full_point_distance_le_four_knownSimple g hg)).elim
  · exact hh

end AlternatingSixReconstruction.Natural.Exhaustion.LargeDistance.SectionFive
