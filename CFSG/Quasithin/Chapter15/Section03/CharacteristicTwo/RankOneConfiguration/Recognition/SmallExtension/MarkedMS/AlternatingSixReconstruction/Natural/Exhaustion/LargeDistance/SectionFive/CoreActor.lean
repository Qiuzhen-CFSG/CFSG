module

public import CFSG.Quasithin.ChapterB.Section03.Offenders.Six.Structure
public import Theory.SpecificGroups.SymmetricSix.BinaryFlags.CoreCrossing

/-!
# The exceptional actor on the full augmentation cover

A quadratic elementary subgroup of S₆ of order at least four either moves
the central line of the five-dimensional augmentation core or is conjugate
to the group generated by two disjoint transpositions. The existing
six-letter subgroup catalogue reduces this dichotomy to small displacement
calculations; the regular Klein and twisted planes are not quadratic.

In the exceptional case, the pointwise fixer of the moved plane lies in
the three-transposition group. Its commutators on the fixed hyperplane of
the third transposition lie in the original moved plane. Conjugation retains
the literal permutation marking, and the restricted actor has dimension four.
`CoreRestriction` applies these statements to the original central cover.

Source: Meierfrankenfeld--Stellmacher (1993), (3.3)(ii)(1), printed
pp.866--867, and the definition of the restricted actor in (5.0), p.912.
-/

@[expose] public noncomputable section
open Subgroup Representation Representation.BinaryOffender BinaryPermutation
open Theory.SpecificGroups.SymmetricSix.BinaryFlags
open CFSG.Quasithin.ChapterB.Offenders CFSG.Quasithin.ChapterB.Offenders.Six
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS.AlternatingSixReconstruction.Natural.Exhaustion.LargeDistance.SectionFive.CoreActor
open CoreCrossing
local notation "ρ" => coreRepresentation (Fin 6)
local notation "π" => coreToNatural (Fin 6)

def Quadratic (A : Subgroup S) : Prop :=
  ∀ a ∈ A, ∀ b ∈ A, ∀ v, ρ a (ρ b v-v) = ρ b v-v

private theorem one_fixed (g : S) : ρ g oneWord = oneWord := by
  apply Subtype.ext
  funext i
  rfl

private theorem kernel_le_of_one (A : Subgroup S)
    (h : oneWord ∈ subspaceCommutator ρ ⊤ A) :
    (π).ker ≤ subspaceCommutator ρ ⊤ A := by
  intro v hv
  have hv' : v.val ∈ constants (Fin 6) := by
    exact (Submodule.Quotient.mk_eq_zero _).mp (show (constants (Fin 6)).mkQ v.val = 0 from congrArg Subtype.val hv)
  obtain ⟨c,hc⟩ := Submodule.mem_span_singleton.mp hv'
  have he : c • oneWord = v := Subtype.ext hc
  rw [←he]
  exact Submodule.smul_mem _ _ h

private theorem quadratic_conjugate (A : Subgroup S) (hq : Quadratic A) (g : S) :
    Quadratic (A.map (MulAut.conj g).toMonoidHom) := by
  rintro _ ⟨a,ha,rfl⟩ _ ⟨b,hb,rfl⟩ v
  let w := ρ g⁻¹ v
  have hv : ρ g w = v := by
    dsimp [w]
    rw [←Module.End.mul_apply,←map_mul,mul_inv_cancel,map_one,Module.End.one_apply]
  have hh := congrArg (ρ g) (hq a ha b hb w)
  simp only [map_sub,←Module.End.mul_apply,←map_mul] at hh ⊢
  change ρ (g*(a*b)*g⁻¹) v - ρ (g*a*g⁻¹) v = ρ (g*b*g⁻¹) v-v
  rw [←hv]
  simp only [←Module.End.mul_apply,←map_mul]
  simpa only [mul_assoc,inv_mul_cancel,mul_one] using hh

private theorem one_moved_conjugate (A : Subgroup S)
    (h : oneWord ∈ subspaceCommutator ρ ⊤ A) (g : S) :
    oneWord ∈ subspaceCommutator ρ ⊤ (A.map (MulAut.conj g).toMonoidHom) := by
  have hm : (subspaceCommutator ρ ⊤ A).map (ρ g) ≤
      subspaceCommutator ρ ⊤ (A.map (MulAut.conj g).toMonoidHom) := by
    rw [Submodule.map_le_iff_le_comap]
    apply Submodule.span_le.mpr
    rintro _ ⟨a,ha,v,_,rfl⟩
    change ρ g (ρ a v-v) ∈ subspaceCommutator ρ ⊤ (A.map (MulAut.conj g).toMonoidHom)
    have he : ρ g (ρ a v-v) = ρ ((MulAut.conj g) a) (ρ g v)-ρ g v := by
      simp only [map_sub,←Module.End.mul_apply,←map_mul]
      change ρ (g*a) v-ρ g v = ρ ((g*a*g⁻¹)*g) v-ρ g v
      rw [inv_mul_cancel_right]
    rw [he]
    exact Submodule.subset_span ⟨_,mem_map_of_mem _ ha,_,Submodule.mem_top,rfl⟩
  exact hm ⟨oneWord,h,one_fixed g⟩

private theorem one_moved_plus : oneWord ∈ subspaceCommutator ρ ⊤ plus := by
  have h1 : planeWords 0 1 ∈ plus := (mem_plus_iff _).mpr ⟨1,rfl⟩
  have h2 : planeWords 0 2 ∈ plus := (mem_plus_iff _).mpr ⟨2,rfl⟩
  have hx : ρ (planeWords 0 1) (pairWord 0 4)-pairWord 0 4 ∈ subspaceCommutator ρ ⊤ plus :=
    Submodule.subset_span ⟨_,h1,_,Submodule.mem_top,rfl⟩
  have hy : ρ (planeWords 0 1) (pairWord 2 4)-pairWord 2 4 ∈ subspaceCommutator ρ ⊤ plus :=
    Submodule.subset_span ⟨_,h1,_,Submodule.mem_top,rfl⟩
  have hz : ρ (planeWords 0 2) (pairWord 0 4)-pairWord 0 4 ∈ subspaceCommutator ρ ⊤ plus :=
    Submodule.subset_span ⟨_,h2,_,Submodule.mem_top,rfl⟩
  have he : (ρ (planeWords 0 1) (pairWord 0 4)-pairWord 0 4) +
      (ρ (planeWords 0 1) (pairWord 2 4)-pairWord 2 4) +
      (ρ (planeWords 0 2) (pairWord 0 4)-pairWord 0 4) = oneWord := by decide
  exact he ▸ Submodule.add_mem _ (Submodule.add_mem _ hx hy) hz

private theorem one_moved_even : oneWord ∈ subspaceCommutator ρ ⊤ (evenPart 6) := by
  have h1 : planeWords 4 1 ∈ evenPart 6 := (mem_evenPart_iff _).mpr ⟨1,rfl⟩
  have h2 : planeWords 4 2 ∈ evenPart 6 := (mem_evenPart_iff _).mpr ⟨2,rfl⟩
  have hx : ρ (planeWords 4 1) (pairWord 0 4)-pairWord 0 4 ∈ subspaceCommutator ρ ⊤ (evenPart 6) :=
    Submodule.subset_span ⟨_,h1,_,Submodule.mem_top,rfl⟩
  have hy : ρ (planeWords 4 1) (pairWord 2 4)-pairWord 2 4 ∈ subspaceCommutator ρ ⊤ (evenPart 6) :=
    Submodule.subset_span ⟨_,h1,_,Submodule.mem_top,rfl⟩
  have hz : ρ (planeWords 4 2) (pairWord 2 4)-pairWord 2 4 ∈ subspaceCommutator ρ ⊤ (evenPart 6) :=
    Submodule.subset_span ⟨_,h2,_,Submodule.mem_top,rfl⟩
  have he : (ρ (planeWords 4 1) (pairWord 0 4)-pairWord 0 4) +
      (ρ (planeWords 4 1) (pairWord 2 4)-pairWord 2 4) +
      (ρ (planeWords 4 2) (pairWord 2 4)-pairWord 2 4) = oneWord := by decide
  exact he ▸ Submodule.add_mem _ (Submodule.add_mem _ hx hy) hz

private theorem klein_not_quadratic : ¬ Quadratic klein := by
  intro h
  have hh := h (planeWords 1 1) ((mem_klein_iff _).mpr ⟨1,rfl⟩)
    (planeWords 1 2) ((mem_klein_iff _).mpr ⟨2,rfl⟩) (pairWord 0 4)
  exact (by decide : ρ (planeWords 1 1) (ρ (planeWords 1 2) (pairWord 0 4)-pairWord 0 4) ≠
    ρ (planeWords 1 2) (pairWord 0 4)-pairWord 0 4) hh

private theorem twisted_not_quadratic : ¬ Quadratic twisted := by
  intro h
  have hh := h (planeWords 2 1) ((mem_twisted_iff _).mpr ⟨1,rfl⟩)
    (planeWords 2 2) ((mem_twisted_iff _).mpr ⟨2,rfl⟩) (pairWord 0 4)
  exact (by decide : ρ (planeWords 2 1) (ρ (planeWords 2 2) (pairWord 0 4)-pairWord 0 4) ≠
    ρ (planeWords 2 2) (pairWord 0 4)-pairWord 0 4) hh

/-- The only quadratic elementary actor of order at least four whose moved
space misses the central line is the two-transposition plane. -/
theorem kernel_or_two_transpositions (A : Subgroup S) [IsElementaryAbelian 2 A]
    (hcard : 4 ≤ Nat.card A) (hq : Quadratic A) :
    (π).ker ≤ subspaceCommutator ρ ⊤ A ∨ IsConjugateTo A (disjointTranspositions 6 2) := by
  have hn : A ≠ ⊥ := by intro he; rw [he,card_bot] at hcard; omega
  have hqconj {B : Subgroup S} (hc : IsConjugateTo A B) : Quadratic B := by
    obtain ⟨g,rfl⟩ := hc
    have hh := quadratic_conjugate _ hq g⁻¹
    have he : (MulAut.conj g⁻¹).toMonoidHom.comp (MulAut.conj g).toMonoidHom = MonoidHom.id S := by
      ext x : 1
      change g⁻¹*(g*x*g⁻¹)*g = x
      group
    simpa only [Subgroup.map_map,he,Subgroup.map_id] using hh
  have hsmall {B : Subgroup S} (hc : IsConjugateTo A B) (hB : Nat.card B = 2) : False := by
    obtain ⟨g,rfl⟩ := hc
    rw [card_map_of_injective (MulAut.conj g).injective,hB] at hcard
    omega
  have hgood {B : Subgroup S} (hc : IsConjugateTo A B)
      (hB : oneWord ∈ subspaceCommutator ρ ⊤ B) : (π).ker ≤ subspaceCommutator ρ ⊤ A := by
    obtain ⟨g,rfl⟩ := hc
    exact kernel_le_of_one _ (one_moved_conjugate B hB g)
  rcases elementaryTwo_conjugacy ⟨hn,inferInstance⟩ with h | h | h | h | h | h | h | h | h | h
  · exact (hsmall h (card_disjointTranspositions 1)).elim
  · exact Or.inr h
  · apply Or.inl
    apply hgood h
    have hp : subspaceCommutator ρ ⊤ plus ≤ subspaceCommutator ρ ⊤ (D 6) := by
      apply Submodule.span_mono
      rintro _ ⟨a,ha,v,hv,rfl⟩
      exact ⟨a,plus_le_D ha,v,hv,rfl⟩
    exact hp one_moved_plus
  · apply False.elim
    apply klein_not_quadratic
    intro a ha b hb v
    exact hqconj h a (klein_le_exceptional ha) b (klein_le_exceptional hb) v
  · exact Or.inl (hgood h one_moved_even)
  · exact Or.inl (hgood h one_moved_plus)
  · exact (hsmall h card_double).elim
  · exact (hsmall h card_triple).elim
  · exact (klein_not_quadratic (hqconj h)).elim
  · exact (twisted_not_quadratic (hqconj h)).elim

private theorem pair01_mem : pairWord 0 1 ∈
    subspaceCommutator ρ ⊤ (disjointTranspositions 6 2) := by
  have hh : ρ (pairSwap 6 0) (pairWord 0 4) - pairWord 0 4 = pairWord 0 1 := by decide
  rw [←hh]
  exact Submodule.subset_span ⟨_,pairSwap_mem 0 (by decide),_,Submodule.mem_top,rfl⟩

private theorem pair23_mem : pairWord 2 3 ∈
    subspaceCommutator ρ ⊤ (disjointTranspositions 6 2) := by
  have hh : ρ (pairSwap 6 1) (pairWord 2 4) - pairWord 2 4 = pairWord 2 3 := by decide
  rw [←hh]
  exact Submodule.subset_span ⟨_,pairSwap_mem 1 (by decide),_,Submodule.mem_top,rfl⟩

private theorem fixer_certificate : ∀ g : S,
    ρ g (pairWord 0 1) = pairWord 0 1 →
    ρ g (pairWord 2 3) = pairWord 2 3 → ∃ i : Fin 8, dWords i = g := by
  decide +kernel

private def hyperplaneWords : Fin 4 → C :=
  ![pairWord 0 1,pairWord 0 2,pairWord 0 3,pairWord 4 5]

private theorem displacement_certificate : ∀ i : Fin 8, ∀ j : Fin 4,
    ∃ a b : ZMod 2, ρ (dWords i) (hyperplaneWords j) - hyperplaneWords j =
      a • pairWord 0 1 + b • pairWord 2 3 := by decide +kernel

/-- In the exceptional case the full pointwise fixer is contained in the
three-transposition group, with the same literal coordinate marking. -/
theorem exceptional_fixer_le_cube (Y : Subgroup S)
    (hfix : Y ≤ subspaceKernel ρ (subspaceCommutator ρ ⊤ (disjointTranspositions 6 2)) ⊤) :
    Y ≤ D 6 := by
  intro y hy
  obtain ⟨i,hi⟩ := fixer_certificate y ((hfix hy).2 _ pair01_mem) ((hfix hy).2 _ pair23_mem)
  exact (mem_disjointTranspositions_iff (3 : Fin 4) y).mpr ⟨i,hi⟩

/-- Restricting the original core to the fixed hyperplane of the third
transposition removes precisely the exceptional commutator contribution. -/
theorem exceptional_hyperplane_control (Y : Subgroup S)
    (hfix : Y ≤ subspaceKernel ρ (subspaceCommutator ρ ⊤ (disjointTranspositions 6 2)) ⊤) :
    subspaceCommutator ρ hyperplane Y ≤ subspaceCommutator ρ ⊤ (disjointTranspositions 6 2) := by
  apply Submodule.span_le.mpr
  rintro _ ⟨y,hy,v,hv,rfl⟩
  obtain ⟨i,rfl⟩ := (mem_disjointTranspositions_iff (3 : Fin 4) y).mp
    (exceptional_fixer_le_cube Y hfix hy)
  have hh : hyperplane ≤ (subspaceCommutator ρ ⊤ (disjointTranspositions 6 2)).comap
      (ρ (dWords i) - LinearMap.id) := by
    rw [hyperplane_eq_span,Submodule.span_le]
    intro w hw
    have hex : ∃ j : Fin 4, hyperplaneWords j = w := by
      rcases hw with rfl | rfl | rfl | rfl
      · exact ⟨0,rfl⟩
      · exact ⟨1,rfl⟩
      · exact ⟨2,rfl⟩
      · exact ⟨3,rfl⟩
    obtain ⟨j,rfl⟩ := hex
    obtain ⟨a,b,hab⟩ := displacement_certificate i j
    change ρ (dWords i) (hyperplaneWords j)-hyperplaneWords j ∈ subspaceCommutator ρ ⊤ (disjointTranspositions 6 2)
    rw [hab]
    exact Submodule.add_mem _ (Submodule.smul_mem _ a pair01_mem)
      (Submodule.smul_mem _ b pair23_mem)
  exact hh hv

/-- The source actor is the fixed space of the third transposition itself. -/
theorem hyperplane_eq_fixed_third : hyperplane = LinearMap.ker (ρ swap45 - LinearMap.id) := by
  ext v
  constructor
  · intro hv
    change ρ swap45 v-v = 0
    rw [swap45_fixes_hyperplane v hv,sub_self]
  · intro hv
    change ρ swap45 v-v = 0 at hv
    have hh := congrArg (fun w : C => w.val 4) (sub_eq_zero.mp hv)
    exact (mem_hyperplane v).mpr hh.symm

private theorem conjugate_equivariant (g a : S) (v : C) :
    ρ a (ρ g v) = ρ g (ρ ((MulAut.conj g⁻¹) a) v) := by
  simp only [←Module.End.mul_apply,←map_mul]
  congr 2
  change a*g = g*(g⁻¹*a*g)
  group

private theorem action_surjective (g : S) : Function.Surjective (ρ g) :=
  (LinearMap.GeneralLinearGroup.toLinearEquiv ((coreRepresentation (Fin 6)).asGroupHom g)).surjective

private theorem conjugate_cancel (A : Subgroup S) (g : S) :
    (A.map (MulAut.conj g).toMonoidHom).map (MulAut.conj g⁻¹).toMonoidHom = A := by
  have he : (MulAut.conj g⁻¹).toMonoidHom.comp (MulAut.conj g).toMonoidHom = MonoidHom.id S := by
    ext x : 1
    change g⁻¹*(g*x*g⁻¹)*g = x
    group
  rw [Subgroup.map_map,he,Subgroup.map_id]

private theorem moved_conjugate (A : Subgroup S) (g : S) :
    subspaceCommutator ρ ⊤ (A.map (MulAut.conj g).toMonoidHom) =
      (subspaceCommutator ρ ⊤ A).map (ρ g) := by
  have hh := subspaceCommutator_map_embedding ρ ρ (MulAut.conj g⁻¹).toMonoidHom (ρ g)
    (conjugate_equivariant g) (A.map (MulAut.conj g).toMonoidHom) ⊤
  rwa [Submodule.map_top,LinearMap.range_eq_top.mpr (action_surjective g),conjugate_cancel] at hh

/-- The exceptional restriction is transported using the original permutation
conjugation, rather than an unrelated choice of a natural quotient. -/
theorem exceptional_conjugate_control (g : S) (Y : Subgroup S)
    (hfix : Y ≤ subspaceKernel ρ
      (subspaceCommutator ρ ⊤ ((disjointTranspositions 6 2).map (MulAut.conj g).toMonoidHom)) ⊤) :
    subspaceCommutator ρ (hyperplane.map (ρ g)) Y ≤
      subspaceCommutator ρ ⊤ ((disjointTranspositions 6 2).map (MulAut.conj g).toMonoidHom) := by
  have hf : Y.map (MulAut.conj g⁻¹).toMonoidHom ≤
      subspaceKernel ρ (subspaceCommutator ρ ⊤ (disjointTranspositions 6 2)) ⊤ := by
    rintro _ ⟨y,hy,rfl⟩
    refine ⟨mem_top _,?_⟩
    intro v hv
    apply (LinearMap.GeneralLinearGroup.toLinearEquiv
      ((coreRepresentation (Fin 6)).asGroupHom g)).injective
    change ρ g (ρ ((MulAut.conj g⁻¹) y) v) = ρ g v
    rw [←conjugate_equivariant]
    apply (hfix hy).2
    rw [moved_conjugate]
    exact Submodule.mem_map_of_mem hv
  rw [subspaceCommutator_map_embedding ρ ρ (MulAut.conj g⁻¹).toMonoidHom (ρ g)
    (conjugate_equivariant g),moved_conjugate]
  exact Submodule.map_mono (exceptional_hyperplane_control _ hf)

/-- Conjugation preserves the index-two size of the actual restricted actor. -/
theorem conjugate_hyperplane_finrank (g : S) :
    Module.finrank (ZMod 2) (hyperplane.map (ρ g)) = 4 := by
  have he := (Submodule.equivMapOfInjective (ρ g)
    (LinearMap.GeneralLinearGroup.toLinearEquiv
      ((coreRepresentation (Fin 6)).asGroupHom g)).injective hyperplane).finrank_eq
  exact he.symm.trans hyperplane_finrank

/-- The restriction fixes the literal conjugate of the third transposition. -/
theorem conjugate_hyperplane_eq_fixed_third (g : S) :
    hyperplane.map (ρ g) = LinearMap.ker (ρ ((MulAut.conj g) swap45)-LinearMap.id) := by
  ext v
  constructor
  · rintro ⟨w,hw,rfl⟩
    change ρ ((MulAut.conj g) swap45) (ρ g w)-ρ g w = 0
    rw [conjugate_equivariant]
    have he : (MulAut.conj g⁻¹) ((MulAut.conj g) swap45) = swap45 := by
      change g⁻¹*(g*swap45*g⁻¹)*g = swap45
      group
    rw [he,swap45_fixes_hyperplane w hw,sub_self]
  · intro hv
    obtain ⟨w,rfl⟩ := action_surjective g v
    refine ⟨w,?_,rfl⟩
    rw [hyperplane_eq_fixed_third]
    change ρ swap45 w-w = 0
    apply sub_eq_zero.mpr
    apply (LinearMap.GeneralLinearGroup.toLinearEquiv
      ((coreRepresentation (Fin 6)).asGroupHom g)).injective
    change ρ ((MulAut.conj g) swap45) (ρ g w)-ρ g w = 0 at hv
    have he : ρ g (ρ swap45 w) = ρ ((MulAut.conj g) swap45) (ρ g w) := by
      simp only [←Module.End.mul_apply,←map_mul]
      change ρ (g*swap45) w = ρ ((g*swap45*g⁻¹)*g) w
      rw [inv_mul_cancel_right]
    change ρ g (ρ swap45 w) = ρ g w
    rw [he]
    exact sub_eq_zero.mp hv

end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS.AlternatingSixReconstruction.Natural.Exhaustion.LargeDistance.SectionFive.CoreActor
