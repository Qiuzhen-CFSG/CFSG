local notation "T" => R.subgroupOf (L ⊔ R)

private theorem natural_coordinates_transitive {v w : NaturalSpace}
    (hv : v ≠ 0) (hw : w ≠ 0) :
    ∃ g : commutator (Atlas.G2.Model (ZMod 2)), rho g v = w := by
  let E := Atlas.G2.Restricted.NaturalCoordinates.equiv (ZMod 2)
  have hv' : E.symm v ≠ 0 := fun h => hv (E.symm.map_eq_zero_iff.mp h)
  have hw' : E.symm w ≠ 0 := fun h => hw (E.symm.map_eq_zero_iff.mp h)
  obtain ⟨g,hg⟩ := Atlas.G2.Natural.Binary.natural_transitive hv' hw'
  refine ⟨g,?_⟩
  change E (Atlas.G2.Natural.derivedAction (ZMod 2) g (E.symm v)) = w
  rw [hg,E.apply_symm_apply]

omit [Finite G] in
/-- Any nontrivial residual-generated subgroup of the seed covers its entire
natural quotient, with the original endpoint projection. -/
theorem seed_projection_surjective_of_residual_generated
    (a : Vertex T) (d : EndpointModel T a) (N : Subgroup (FreeAmalgam T))
    (hNZ : N ≤ Z T a) (hN : ⁅N,Ltilde T a⁆ = N) (hne : N ≠ ⊥) :
    (N.subgroupOf (Z T a)).map d.projection = ⊤ := by
  have hn : ¬ N ≤ d.projection.ker.map (Z T a).subtype := by
    intro hn
    rw [d.projection_kernel] at hn
    have hc : ⁅N,Ltilde T a⁆ = ⊥ :=
      commutator_eq_bot_iff_le_centralizer.mpr (hn.trans inf_le_right)
    exact hne (hN.symm.trans hc)
  obtain ⟨v,hv,hvn⟩ := SetLike.not_le_iff_exists.mp hn
  let v' : Z T a := ⟨v,hNZ hv⟩
  have hv0 : (d.projection v').toAdd ≠ 0 := by
    intro hz
    apply hvn
    exact ⟨v',show d.projection v' = 1 from congrArg Multiplicative.ofAdd hz,rfl⟩
  apply top_unique
  intro w _
  by_cases hw : w = 1
  · subst w
    exact Subgroup.one_mem _
  have hw0 : w.toAdd ≠ 0 := by
    intro hz
    exact hw (congrArg Multiplicative.ofAdd hz)
  obtain ⟨g,hg⟩ := natural_coordinates_transitive hv0 hw0
  have hgm : g.val ∈ ((Ltilde T a).subgroupOf (stabilizer T a)).map d.actor := by
    rw [d.actor_residual]
    exact g.property
  obtain ⟨s,hs,hsg⟩ := hgm
  have hnorm : Ltilde T a ≤ normalizer (N : Set (FreeAmalgam T)) :=
    le_normalizer_iff_commutator_le_left.mpr hN.le
  let x : Z T a := ⟨s.val*v*s.val⁻¹,
    (mem_normalizer_iff.mp (Z_normalized T a s.property) v).mp v'.property⟩
  refine ⟨x, (mem_normalizer_iff.mp (hnorm hs) v).mp hv, ?_⟩
  have hi := d.intertwines s v'
  change d.projection x = _ at hi
  rw [hsg,hg] at hi
  exact hi

omit [Finite G] in
/-- The actual moving seed is minimal among nontrivial residual-generated
subgroups of the seed; central projection kernels do not leave an error term. -/
theorem seed_eq_of_residual_generated
    (a : Vertex T) (d : EndpointModel T a) (N : Subgroup (FreeAmalgam T))
    (hNZ : N ≤ Z T a) (hN : ⁅N,Ltilde T a⁆ = N) (hne : N ≠ ⊥) :
    N = U T a := by
  have hfull := seed_projection_surjective_of_residual_generated a d N hNZ hN hne
  apply le_antisymm
  · rw [←hN]
    exact commutator_mono hNZ le_rfl
  · apply commutator_le.mpr
    intro x hx g hg
    have hxim : d.projection ⟨x,hx⟩ ∈ (N.subgroupOf (Z T a)).map d.projection := by
      rw [hfull]
      trivial
    obtain ⟨n,hn,hnx⟩ := hxim
    have hk : n⁻¹ * (⟨x,hx⟩ : Z T a) ∈ d.projection.ker := by
      change d.projection (n⁻¹ * (⟨x,hx⟩ : Z T a)) = 1
      rw [map_mul,map_inv,hnx,inv_mul_cancel]
    have hkc : n.val⁻¹*x ∈ centralizer (Ltilde T a : Set (FreeAmalgam T)) := by
      have hm : n.val⁻¹*x ∈ d.projection.ker.map (Z T a).subtype :=
        ⟨n⁻¹ * (⟨x,hx⟩ : Z T a),hk,rfl⟩
      rw [d.projection_kernel] at hm
      exact hm.2
    have hkg : ⁅n.val⁻¹*x,g⁆ = 1 :=
      commutatorElement_eq_one_iff_mul_comm.mpr (hkc g hg).symm
    have he : ⁅x,g⁆ = ⁅n.val,g⁆ := by
      calc
        ⁅x,g⁆ = ⁅n.val*(n.val⁻¹*x),g⁆ := by rw [mul_inv_cancel_left]
        _ = _ := by rw [commutatorElement_mul_left_eq_conj_mul,hkg]; simp
    rw [he,←hN]
    exact commutator_mem_commutator hn hg

variable (h : SmallMSPair KnownSimple.IsKnownSimple L R)
  (e : (L ⧸ centralPreimage (pCore 2 L)) ≃* commutator (Atlas.G2.Model (ZMod 2)))

/-- Residual commutators on the derived radius are fully generated by the
same residual, since the derived radius is a finite two-group. -/
theorem radius_derived_full_commutation
    (hb : 2 < (geometry h).b T) (a : Vertex T) (ha : color T a = false) :
    ⁅⁅⁅V T a,V T a⁆,Ltilde T a⁆,Ltilde T a⁆ = ⁅⁅V T a,V T a⁆,Ltilde T a⁆ := by
  let S := stabilizer T a
  let D := ⁅V T a,V T a⁆
  let W := D.subgroupOf S
  let := finite_stabilizer T a
  have hn : S ≤ normalizer (D : Set (FreeAmalgam T)) := by
    intro g hg
    rw [mem_normalizer_iff_map_conj_eq,map_commutator,
      mem_normalizer_iff_map_conj_eq.mp (V_normalized a hg)]
  let : W.Normal := normal_subgroupOf_of_le_normalizer hn
  have hDV : D ≤ V T a := le_normalizer_iff_commutator_le_left.mp (V T a).le_normalizer
  have hDS : D ≤ S := hDV.trans (((geometry h).V_le_Q hb a ha).trans (fun _ hx => hx.1))
  have hp : IsPGroup 2 W := ((radius_isPGroup h hb a ha).to_le hDV).comap_subtype
  have hid := commutator_isPPerfect_idempotent (pResidual 2 S) W
    (isPPerfect_pResidual 2) hp le_normalizer_of_normal
  have hh := congrArg (Subgroup.map S.subtype) hid
  have hW : W.map S.subtype = D := map_subgroupOf_eq_of_le hDS
  simpa only [map_commutator,hW,Ltilde] using hh

include e in
/-- In the nonfixed branch of MS93 (3.8), the derived radius generates the
whole actual moving seed, not only a noncentral constituent. -/
theorem radius_derived_residual_eq_seed_of_nonfixed
    (hb : (geometry h).b T = 4) (a : Vertex T) (ha : color T a = false)
    (hn : ¬ ⁅V T a,V T a⁆ ≤ fixedCore T a) :
    ⁅⁅V T a,V T a⁆,Ltilde T a⁆ = U T a := by
  obtain ⟨d⟩ := endpointModel_knownSimple h e ha
  apply seed_eq_of_residual_generated a d
    _ (radius_derived_residual_commutator_le_seed h e hb a ha)
    (radius_derived_full_commutation h (by omega) a ha)
  intro hz
  apply hn
  refine le_inf ?_ (commutator_eq_bot_iff_le_centralizer.mp hz)
  exact (le_normalizer_iff_commutator_le_left.mp (V T a).le_normalizer).trans
    ((geometry h).V_le_Q (by omega) a ha)

include e in
/-- The source nonfixed-derived branch contains the entire moving seed in
the derived radius. -/
theorem seed_le_radius_derived_of_nonfixed
    (hb : (geometry h).b T = 4) (a : Vertex T) (ha : color T a = false)
    (hn : ¬ ⁅V T a,V T a⁆ ≤ fixedCore T a) : U T a ≤ ⁅V T a,V T a⁆ := by
  rw [← radius_derived_residual_eq_seed_of_nonfixed h e hb a ha hn]
  apply le_normalizer_iff_commutator_le_left.mp
  intro g hg
  rw [mem_normalizer_iff_map_conj_eq,map_commutator,
    mem_normalizer_iff_map_conj_eq.mp (V_normalized a (Ltilde_le_stabilizer a hg))]

include e in
/-- In the nonfixed branch the part of the derived radius inside its seed
surjects under the same endpoint projection onto all sixty-four natural vectors. -/
theorem radius_derived_seed_projection_of_nonfixed
    (hb : (geometry h).b T = 4) (a : Vertex T) (ha : color T a = false)
    (hn : ¬ ⁅V T a,V T a⁆ ≤ fixedCore T a) (d : EndpointModel T a) :
    ((⁅V T a,V T a⁆).subgroupOf (Z T a)).map d.projection = ⊤ := by
  have hN := radius_derived_residual_eq_seed_of_nonfixed h e hb a ha hn
  have hne : ⁅⁅V T a,V T a⁆,Ltilde T a⁆ ≠ ⊥ := by
    intro hz
    apply hn
    refine le_inf ?_ (commutator_eq_bot_iff_le_centralizer.mp hz)
    exact (le_normalizer_iff_commutator_le_left.mp (V T a).le_normalizer).trans
      ((geometry h).V_le_Q (by omega) a ha)
  have hfull := seed_projection_surjective_of_residual_generated a d _
    (radius_derived_residual_commutator_le_seed h e hb a ha)
    (radius_derived_full_commutation h (by omega) a ha) hne
  rw [hN] at hfull
  apply top_unique
  rw [←hfull]
  exact map_mono (comap_mono (seed_le_radius_derived_of_nonfixed h e hb a ha hn))

include h

/-- The initial moving seed and the center of the actual incident edge
kernel generate the whole seed. The latter factor is fixed by that edge. -/
theorem seed_eq_moving_sup_edgeOmega
    (a t : Vertex T) (ha : color T a = false) (hat : Adjacent T a t) :
    Z T a = U T a ⊔ edgeOmega T t := by
  have hEZ : edgeOmega T t ≤ Z T a := by
    rw [Z,if_pos ha]
    exact le_iSup_of_le t (le_iSup_of_le hat le_rfl)
  have hU : stabilizer T a ≤ normalizer (U T a : Set (FreeAmalgam T)) :=
    U_normalized a
  have hE : Q T t ≤ centralizer (edgeOmega T t : Set (FreeAmalgam T)) :=
    Q_le_centralizer_X T t
  have hn : stabilizer T a ≤ normalizer (U T a ⊔ edgeOmega T t : Subgroup (FreeAmalgam T)) := by
    rw [←local_generation_edge h ha hat]
    apply sup_le
    · exact normalizes_sup_of_commutator_le _ _ _
        ((Ltilde_le_stabilizer a).trans hU) (commutator_mono hEZ le_rfl)
    · exact (le_inf
        ((CriticalCriterion.edge_le_stabilizer T ha hat).trans hU)
        (hE.trans (Subgroup.centralizer_le_normalizer _))).trans
        (normalizer_inf_normalizer_le_normalizer_sup _ _)
  apply le_antisymm _ (sup_le (U_le_Z a) hEZ)
  rw [Z,if_pos ha]
  apply iSup_le
  intro d
  apply iSup_le
  intro had
  obtain ⟨g,hg,hgd⟩ := stabilizer_transitive_neighbors T a hat had
  rw [←hgd,edgeOmega_act]
  exact (map_mono (show edgeOmega T t ≤ U T a ⊔ edgeOmega T t from le_sup_right)).trans
    (mem_normalizer_iff_map_conj_eq.mp (hn ((stabilizer T a).inv_mem hg))).le

/-- Edge displacement on the whole seed lies in its actual moving subgroup;
there is no remaining residual-fixed kernel term. -/
theorem seed_edge_commutator_le_moving
    (a t : Vertex T) (ha : color T a = false) (hat : Adjacent T a t) :
    ⁅Z T a,Q T t⁆ ≤ U T a := by
  have hEZ : edgeOmega T t ≤ Z T a := by
    rw [Z,if_pos ha]
    exact le_iSup_of_le t (le_iSup_of_le hat le_rfl)
  have hUZ : U T a ≤ Z T a := U_le_Z a
  have hU : stabilizer T a ≤ normalizer (U T a : Set (FreeAmalgam T)) := U_normalized a
  have hcentral : ⁅edgeOmega T t,Q T t⁆ = ⊥ :=
    commutator_eq_bot_iff_le_centralizer.mpr (le_centralizer_iff.mp (Q_le_centralizer_X T t))
  have he := seed_eq_moving_sup_edgeOmega h a t ha hat
  rw [he]
  exact commutator_sup_le_of_relative_normal (Z T a) _ _ _ _
    ((Z_le_stabilizer T a).trans hU) hUZ hEZ
    (le_normalizer_iff_commutator_le_left.mp
      ((CriticalCriterion.edge_le_stabilizer T ha hat).trans hU))
    (hcentral.le.trans bot_le)

/-- The triple commutator in the last paragraph of MS93 (3.8) lies in the
starting moving seed, rather than merely in its larger central-omega seed. -/
theorem critical_triple_le_start_moving
    (a z : Vertex T) (ha : color T a = false)
    (hc : CriticalPair T a z ((geometry h).exists_critical a ha))
    (t : Vertex T) (hat : Adjacent T a t) :
    ⁅⁅Z T a,Z T z⁆,Q T t⁆ ≤ U T a :=
  (commutator_mono (critical_image_le_start (geometry h) a z ha hc) le_rfl).trans
    (seed_edge_commutator_le_moving h a t ha hat)

include e in
/-- The whole critical commutator lies in the starting moving seed. Choose
the first edge of the critical geodesic and use its literal displacement bound. -/
theorem critical_commutator_le_start_moving
    (a z : Vertex T) (ha : color T a = false)
    (hc : CriticalPair T a z ((geometry h).exists_critical a ha)) :
    ⁅Z T a,Z T z⁆ ≤ U T a := by
  have hd : (cosetGraph T).dist a z = (geometry h).b T :=
    hc.1.trans ((geometry h).distance_constant a ha)
  obtain ⟨t,hat,ht⟩ := exists_adjacent_dist_sub_one T a z (by
    rw [hd]
    exact (positive_even h e).1)
  have hz := critical_endpoint_color T a ha _ hc
  have hpos : 0 < criticalDistance T z ((geometry h).exists_critical z hz) := by
    rw [(geometry h).distance_constant z hz]
    exact (positive_even h e).1
  have hzt : Z T z ≤ Q T t := by
    apply ((geometry h).omega_bound z hz hpos).trans
    apply X_le_Q_of_dist_lt T (geometry h) (edgeCentralizer h e) z hz t
    rw [SimpleGraph.dist_comm,(geometry h).distance_constant z hz]
    change (cosetGraph T).dist t z < (geometry h).b T
    omega
  exact (commutator_mono le_rfl hzt).trans
    (seed_edge_commutator_le_moving h a t ha hat)

include e in
/-- Both original moving seeds contain their whole critical commutator;
the statement retains the original ambient subgroups on both sides. -/
theorem critical_commutator_le_moving_intersection
    (a z : Vertex T) (ha : color T a = false)
    (hc : CriticalPair T a z ((geometry h).exists_critical a ha)) :
    ⁅Z T a,Z T z⁆ ≤ U T a ⊓ U T z := by
  have hz := critical_endpoint_color T a ha _ hc
  have hrev := critical_reverse T (geometry h) (edgeCentralizer h e) a ha (by
    rw [(geometry h).distance_constant a ha]
    exact (positive_even h e).1) z hz hc
  refine le_inf (critical_commutator_le_start_moving h e a z ha hc) ?_
  rw [commutator_comm]
  exact critical_commutator_le_start_moving h e z a hz hrev

