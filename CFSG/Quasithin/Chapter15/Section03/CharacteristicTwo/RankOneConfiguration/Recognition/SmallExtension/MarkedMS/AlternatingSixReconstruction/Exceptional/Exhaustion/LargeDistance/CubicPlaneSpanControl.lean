module
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.SmallExtension.MarkedMS.AlternatingSixReconstruction.Exceptional.Exhaustion.LargeDistance.CubicPlanePredecessor
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.SmallExtension.MarkedMS.AlternatingSixReconstruction.Exceptional.Exhaustion.LargeDistance.CubicShiftContainment

/-!
# Saturation of the original cubic predecessor-kernel commutator

A selected nonzero seed-kernel line cannot contain the displacement of an
escaping normal local span. Otherwise the same transported full kernel is
an actual escaping two-actor controlling that span modulo its seed, placing
it in the Baumann slice. The plane cover's bound of four then forces the
whole predecessor-kernel commutator to have order four, generated by the
selected line and that escaping displacement.

All subgroups are on the original cubic graph and the two-actor is proved
to be a two-group from the full elementary endpoint seed. The original
cubic kernel and central attachments are retained. This supplies a local
source comparison for (5.9); the selected orbit data and terminal closure
remain separate obligations.

Source: Meierfrankenfeld--Stellmacher (1993), (3.3) and (5.9), printed
pp.866--867,920--922.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender BinaryPermutation
open scoped commutatorElement IsMulCommutative Pointwise
open CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup
open Theory.SpecificGroups.SymmetricSix.BinaryFlags
open CFSG.Quasithin.ChapterC.BinaryMS.MS93 Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS
namespace AlternatingSixReconstruction.Exceptional.Exhaustion.LargeDistance.CubicFull
universe u
variable {G : Type u} [Group G] [Finite G] {L R : Subgroup G}
  (h : SmallMSPair KnownSimple.IsKnownSimple L R) (e : CentralMarking L)
  (hz : Nat.card (center (L ⧸ pCore 2 L)) = 3)
  (hk : layerKernel L R = extensionKernel h)
local notation "Rg" => edge L R
local notation "π" => CubicAction.projection h e hz hk

include h e hz hk in
/-- A nonzero selected seed-kernel line and its escaping normal local span
force the entire predecessor-kernel commutator to have order four. The span's
kernel displacement is not confined to the selected line. -/
theorem plane_predecessor_kernel_saturated
    (hb : 2 < sourceDistance h)
    (u : Equiv.Perm (Fin 6))
    (hR : (Rg).map π ≤ D.map
      (MulAut.conj u).toMonoidHom)
    {c z a : Vertex Rg}
    (q : CriticalPath Rg (sourceGeometry h) c z)
    (hsmall : (Q Rg z).relIndex (Z Rg c) < 4)
    (ha : color Rg a = false) (hca : (cosetGraph Rg).dist c a ≤ 2)
    (Y : Subgroup (FreeAmalgam Rg)) (hYV : Y ≤ V Rg a)
    (hYN : stabilizer Rg a ≤ normalizer (Y : Set (FreeAmalgam Rg)))
    (hYB : ¬ Y ≤ B Rg a ((sourceGeometry h).Z_normal _))
    (x : FreeAmalgam Rg) (hx : x ∈ stabilizer Rg c)
    (hZpre : (Z Rg a).map (MulAut.conj x).toMonoidHom ≤
      Q Rg (q.walk.getVert (q.walk.length-2)))
    (hYpre : Y.map (MulAut.conj x).toMonoidHom ≤
      Q Rg (q.walk.getVert (q.walk.length-2)))
    (hcard : Nat.card (⁅(Z Rg a).map (MulAut.conj x).toMonoidHom,
      Z Rg z ⊓ Q Rg c⁆ : Subgroup (FreeAmalgam Rg)) = 2) :
    let K := Z Rg z ⊓ Q Rg c
    let J := ⁅(Z Rg a).map (MulAut.conj x).toMonoidHom,K⁆
    let N := ⁅K,Q Rg (q.walk.getVert (q.walk.length-2))⁆
    Nat.card N = 4 ∧
      ¬ ⁅Y.map (MulAut.conj x).toMonoidHom,K⁆ ≤ J ∧
      J ⊔ ⁅Y.map (MulAut.conj x).toMonoidHom,K⁆ = N := by
  let K := Z Rg z ⊓ Q Rg c
  let f := (MulAut.conj x).toMonoidHom
  let fi := (MulAut.conj x⁻¹).toMonoidHom
  let A := K.map fi
  let J := ⁅(Z Rg a).map f,K⁆
  let N := ⁅K,Q Rg (q.walk.getVert (q.walk.length-2))⁆
  have hAf : A.map f = K := by
    rw [map_map]
    have he : f.comp fi = MonoidHom.id (FreeAmalgam Rg) := by
      apply MonoidHom.ext
      intro v
      change x*(x⁻¹*v*(x⁻¹)⁻¹)*x⁻¹ = v
      group
    rw [he,map_id]
  have hAQ : A ≤ Q Rg c :=
    (map_mono (show K ≤ Q Rg c from inf_le_right)).trans_eq
      (mem_normalizer_iff_map_conj_eq.mp
        ((Q_normalized Rg c) ((stabilizer Rg c).inv_mem hx)))
  have hAG : A ≤ stabilizer Rg a := hAQ.trans
    (Q_le_stabilizer_of_dist_le_two c a q.start_color ha hca)
  have hZA : ⁅Z Rg a,A⁆ ≤ Z Rg a :=
    le_normalizer_iff_commutator_le_left.mp (hAG.trans (Z_normalized Rg a))
  have hZAmap : (⁅Z Rg a,A⁆ : Subgroup (FreeAmalgam Rg)).map f = J := by
    rw [map_commutator,hAf]
  have hne : ¬ A ≤ Q Rg a := by
    intro hAcore
    have hzero : ⁅Z Rg a,A⁆ = ⊥ := le_bot_iff.mp
      ((commutator_mono le_rfl hAcore).trans_eq (Z_centralizes_Q Rg a ha))
    rw [hzero,Subgroup.map_bot] at hZAmap
    change Nat.card J = 2 at hcard
    rw [←hZAmap,card_bot] at hcard
    omega
  have hnot : ¬ ⁅Y.map f,K⁆ ≤ J := by
    intro hle
    have hYA : ⁅Y,A⁆ ≤ Z Rg a := by
      apply le_trans _ hZA
      apply (map_le_map_iff_of_injective (f := f) (MulAut.conj x).injective).mp
      rwa [hZAmap,map_commutator,hAf]
    let := (sourceGeometry h).Z_elementary (sourceDistance_pos h) z q.end_color
    have hAtwo : IsPGroup 2 A :=
      ((IsElementaryAbelian.isPGroup 2 (Z Rg z)).to_le
        (show K ≤ Z Rg z from inf_le_left)).map fi
    exact hYB (normalized_radius_le_slice_of_controlled_actor h e hz hb ha
      Y A hYV hYN hAG hAtwo hne hYA)
  have hcardN : Nat.card N ≤ 4 := plane_small_critical_kernel_predecessor_card h e hz hk hb u hR q hsmall
  have hJN : J ≤ N := by
    dsimp only [J,N]
    rw [commutator_comm ((Z Rg a).map f)]
    exact commutator_mono le_rfl hZpre
  have hYN' : ⁅Y.map f,K⁆ ≤ N := by
    rw [commutator_comm]
    exact commutator_mono le_rfl hYpre
  let v := q.walk.getVert (q.walk.length-2)
  have hvcol : color Rg v = false := by
    apply (q.vertex_color (Nat.sub_le _ _)).mpr
    have he := sourceDistance_even h
    rw [Nat.even_iff] at he ⊢
    have hl : q.walk.length = sourceDistance h := q.length_eq_b
    omega
  have hvz : (cosetGraph Rg).dist v z = 2 := by
    rw [q.dist_end]
    have hl : q.walk.length = sourceDistance h := q.length_eq_b
    omega
  have hNZ : N ≤ Z Rg z :=
    (commutator_mono inf_le_left le_rfl).trans
      (le_normalizer_iff_commutator_le_left.mp
        ((Q_le_stabilizer_of_dist_two Rg v z hvcol hvz).trans (Z_normalized Rg z)))
  let := finite_Z Rg z
  let : Finite N := Finite.of_injective (inclusion hNZ) (inclusion_injective _)
  have hlarge : 2 < Nat.card N := by
    by_contra! hsmallN
    have heq : J = N := eq_of_le_of_card_ge hJN (by change Nat.card J = 2 at hcard; omega)
    exact hnot (hYN'.trans_eq heq.symm)
  have heven : 2 ∣ Nat.card N := by
    have hd := card_dvd_of_le hJN
    change Nat.card J = 2 at hcard
    rwa [hcard] at hd
  have hNcard : Nat.card N = 4 := by omega
  let E := J ⊔ ⁅Y.map f,K⁆
  have hEN : E ≤ N := sup_le hJN hYN'
  let : Finite E := Finite.of_injective (inclusion hEN) (inclusion_injective _)
  have hJE : J ≤ E := le_sup_left
  have hElarge : 2 < Nat.card E := by
    by_contra! hsmallE
    have heq : J = E := eq_of_le_of_card_ge hJE (by change Nat.card J = 2 at hcard; omega)
    exact hnot ((show ⁅Y.map f,K⁆ ≤ E from le_sup_right).trans_eq heq.symm)
  have hEeven : 2 ∣ Nat.card E := by
    have hd := card_dvd_of_le hJE
    change Nat.card J = 2 at hcard
    rwa [hcard] at hd
  have hEcard : Nat.card E ≤ Nat.card N := card_le_of_le hEN
  have hENeq : E = N := eq_of_le_of_card_ge hEN (by omega)
  exact ⟨hNcard,hnot,hENeq⟩


end AlternatingSixReconstruction.Exceptional.Exhaustion.LargeDistance.CubicFull
end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS
