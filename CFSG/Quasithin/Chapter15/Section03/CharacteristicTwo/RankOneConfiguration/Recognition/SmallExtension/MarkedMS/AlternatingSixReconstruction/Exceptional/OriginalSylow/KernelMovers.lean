local notation "borel" => Theory.SpecificGroups.SymmetricSix.borel

private theorem borel_swap_le_plane (s : S) (hs : s ∈ borel) (ht : s.IsSwap) : s ∈ D := by
  have cert : ∀ i : Fin 16, (BorelCalculation.words i).cycleType = {2} →
      ∃ k : Fin 8, dWords k = BorelCalculation.words i := by decide +kernel
  obtain ⟨i,rfl⟩ := BorelCalculation.words_complete s hs
  obtain ⟨k,hk⟩ := cert i (Equiv.Perm.isSwap_iff_cycleType.mp ht)
  rw [←hk,CFSG.Quasithin.ChapterB.Offenders.SixCorePlane.cube_eq]
  exact (CFSG.Quasithin.ChapterB.Offenders.Six.mem_disjointTranspositions_iff (3 : Fin 4) _).mpr ⟨k,rfl⟩

private theorem borel_small_fixed_le_plane (A : Subgroup S) (u : S)
    (hA : A ≤ borel.map (MulAut.conj u).toMonoidHom)
    (hs : fixedCodim (naturalRepresentation (Fin 6)) A ≤ 1) :
    A ≤ D.map (MulAut.conj u).toMonoidHom := by
  let A₀ := A.map (MulAut.conj u⁻¹).toMonoidHom
  have hA₀ : A₀ ≤ borel := (map_mono hA).trans_eq (conjBy_inv borel u)
  have hs₀ : fixedCodim (naturalRepresentation (Fin 6)) A₀ ≤ 1 := by
    simpa only [A₀,fixedCodim_map_conj] using hs
  have hle : A₀ ≤ D := by
    by_cases he : A₀ = ⊥
    · rw [he]; exact bot_le
    obtain ⟨s,hsm,hst,hse⟩ := PointCoreTranspositionFixed.small_image_eq_zpowers A₀ he hs₀
    rw [hse,zpowers_le]
    exact borel_swap_le_plane s (hA₀ hsm) hst
  have hm := map_mono (f := (MulAut.conj u).toMonoidHom) hle
  exact (conjBy_inv' A u).symm.le.trans hm

universe u
variable {G : Type u} [Group G] [Finite G] {L R : Subgroup G}
  (h : SmallMSPair KnownSimple.IsKnownSimple L R) (e : CentralMarking L)
  (hz : Nat.card (center (L ⧸ pCore 2 L)) = 3)
  (hk : layerKernel L R = extensionKernel h)
local notation "M" => (L ⊔ R : Subgroup G)
local notation "Rg" => edge L R
local notation "W" => (⁅centralOmega L R,L.subgroupOf M⁆ : Subgroup M)
local notation "π" => CubicAction.projection h e hz hk

include h e hz hk in
/-- An edge actor moving at most a line of the full cover belongs to the
actual proper Borel Thompson mover. -/
theorem borel_small_commutator_actor_le_mover
    (u : S) (hR : (Rg).map π = borel.map (MulAut.conj u).toMonoidHom)
    {c t : Vertex Rg} (hc : color Rg c = false) (hct : Adjacent Rg c t)
    (A : Subgroup (FreeAmalgam Rg)) (hAT : A ≤ Q Rg t)
    (hcard : Nat.card (⁅U Rg c,A⁆ : Subgroup (FreeAmalgam Rg)) ≤ 2) :
    A ≤ edgeOffenderJoin c t := by
  have hAG : A ≤ stabilizer Rg c := hAT.trans (fun _ hx => hx.2 _ (adjacent_symm Rg hct))
  have hfix := moving_small_commutator_fixed_index h e hz hk hc A hAG hcard
  obtain ⟨i,hi,hir,hiR,hiQ,hiU⟩ := remaining_edge_coordinates h e hz hc hct
  have hAm : (A.comap i).map i = A := map_comap_eq_self (hAG.trans_eq hir.symm)
  have hAR : A.comap i ≤ Rg := by
    apply (map_le_map_iff_of_injective hi).mp
    rw [hAm,hiR]
    exact hAT
  have hidx : (centralizer (A.comap i : Set M)).relIndex W ≤ 2 := by
    rw [←hAm,←hiU,←inf_relIndex_right,inf_comm,map_inf_centralizer_of_injective i hi,
      relIndex_map_map_of_injective _ _ hi,inf_relIndex_left] at hfix
    exact hfix
  have hcodim : fixedCodim (naturalRepresentation (Fin 6)) ((A.comap i).map π) ≤ 1 := by
    apply (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp
    exact (cubic_cover_movement_bounds h e hz hk (A.comap i)).1.trans hidx
  have hplane := borel_small_fixed_le_plane ((A.comap i).map π) u
    ((map_mono hAR).trans_eq hR) hcodim
  have hle : A.comap i ≤ borelPlane h e hz hk u := le_inf hAR (map_le_iff_le_comap.mp hplane)
  rw [remaining_join_in_chart h e hz hk u (Or.inr hR) hc hct i hi hiR hiQ hiU,←hAm]
  exact map_mono hle

include h e hz hk in
/-- Two small end slices put the entire reverse critical kernel in the
neighboring mover and make its commutator fixed by that mover. -/
theorem borel_two_slice_reverse_kernel_mover
    (u : S) (hR : (Rg).map π = borel.map (MulAut.conj u).toMonoidHom)
    {a z c t : Vertex Rg}
    (p : CriticalPath Rg (sourceGeometry h) a z)
    (hat : Adjacent Rg a t) (hct : Adjacent Rg c t)
    (hforward : (B Rg a ((sourceGeometry h).Z_normal _)).relIndex (U Rg c) ≤ 2)
    (hpre : (B Rg (p.walk.getVert (p.walk.length-2))
      ((sourceGeometry h).Z_normal _)).relIndex (U Rg z) ≤ 2)
    (hbad : Z Rg c ≤ Q Rg (p.walk.getVert (p.walk.length-2))) :
    Nat.card (⁅Z Rg z ⊓ Q Rg a,Z Rg c⁆ : Subgroup (FreeAmalgam Rg)) ≤ 2 ∧
      Z Rg z ⊓ Q Rg a ≤ edgeOffenderJoin c t ∧
      ⁅Z Rg z ⊓ Q Rg a,Z Rg c⁆ ≤
        centralizer (edgeOffenderJoin c t : Set (FreeAmalgam Rg)) := by
  let K := Z Rg z ⊓ Q Rg a
  let H := ⁅K,Z Rg c⁆
  have ht : color Rg t = true := by
    have hh := adjacent_color_ne Rg hat
    rw [p.start_color] at hh
    cases he : color Rg t <;> simp_all
  have hc : color Rg c = false := by
    have hh := adjacent_color_ne Rg hct
    rw [ht] at hh
    cases he : color Rg c <;> simp_all
  have hKT : K ≤ Q Rg t := inf_le_right.trans (Q_le_adjacent_h Rg ht hat)
  have hKG : K ≤ stabilizer Rg c := hKT.trans (fun _ hx => hx.2 _ (adjacent_symm Rg hct))
  have hHZ : H ≤ Z Rg c := le_normalizer_iff_commutator_le_right.mp
    (hKG.trans (Z_normalized Rg c))
  let := finite_Z Rg c
  let : Finite H := Finite.of_injective (inclusion hHZ) (inclusion_injective _)
  have hcard : Nat.card H ≤ 2 := by
    by_cases he : H = ⊥
    · rw [he,card_bot]; decide
    obtain ⟨k,_,_,q,_,_,_,_,hh,_⟩ :=
      two_slice_residual_line h e hz hk p hforward hpre hat hct hbad he
    exact hh.le
  have hsmall : Nat.card (⁅U Rg c,K⁆ : Subgroup (FreeAmalgam Rg)) ≤ 2 := by
    have hle : ⁅U Rg c,K⁆ ≤ H := by
      dsimp only [H]
      rw [commutator_comm K]
      exact commutator_mono (DistanceEight.U_le_Z Rg c) le_rfl
    exact (card_le_of_le hle).trans hcard
  have hKJ := borel_small_commutator_actor_le_mover h e hz hk u hR hc hct K hKT hsmall
  have hquad : ⁅H,edgeOffenderJoin c t⁆ = ⊥ := by
    apply le_bot_iff.mp
    dsimp only [H]
    rw [commutator_comm K]
    exact (commutator_mono (commutator_mono le_rfl hKJ) le_rfl).trans_eq
      (remaining_edge_full_seed_quadratic h e hz hk u (Or.inr hR) hc hct)
  exact ⟨hcard,hKJ,commutator_eq_bot_iff_le_centralizer.mp hquad⟩

include h e hz hk in
/-- Opposite-mover generation makes the full reverse-kernel commutator
fixed by both the starting and predecessor residuals. -/
theorem borel_two_slice_opposite_residual_control
    (u : S) (hR : (Rg).map π = borel.map (MulAut.conj u).toMonoidHom)
    {a z c t : Vertex Rg}
    (p : CriticalPath Rg (sourceGeometry h) a z)
    (hat : Adjacent Rg a t) (hct : Adjacent Rg c t)
    (hgen : Q Rg t ⊔ Z Rg z = stabilizer Rg a)
    (hcore : ¬ Q Rg a ≤ edgeOffenderJoin c t)
    (hforward : (B Rg a ((sourceGeometry h).Z_normal _)).relIndex (U Rg c) ≤ 2)
    (hpre : (B Rg (p.walk.getVert (p.walk.length-2))
      ((sourceGeometry h).Z_normal _)).relIndex (U Rg z) ≤ 2)
    (hbad : Z Rg c ≤ Q Rg (p.walk.getVert (p.walk.length-2))) :
    ⁅Z Rg z ⊓ Q Rg a,Z Rg c⁆ ≤
      centralizer ((Ltilde Rg a ⊔ Ltilde Rg (p.walk.getVert (p.walk.length-2)) :
        Subgroup (FreeAmalgam Rg)) : Set (FreeAmalgam Rg)) := by
  have hb := distance_gt_two h e hz hk
  have hl : 2 < p.walk.length := p.length_eq_b ▸ hb
  have ht : color Rg t = true := by
    have hh := adjacent_color_ne Rg hat
    rw [p.start_color] at hh
    cases he : color Rg t <;> simp_all
  have hc : color Rg c = false := by
    have hh := adjacent_color_ne Rg hct
    rw [ht] at hh
    cases he : color Rg c <;> simp_all
  let K := Z Rg z ⊓ Q Rg a
  let H := ⁅K,Z Rg c⁆
  have hlast : Adjacent Rg z (p.walk.getVert (p.walk.length-1)) := by
    have hh := p.walk.adj_getVert_succ (i := p.walk.length-1) (by omega)
    rw [show p.walk.length-1+1=p.walk.length by omega,p.walk.getVert_length] at hh
    exact adjacent_symm Rg ((cosetGraph_adj Rg _ _).mp hh)
  have hlastcol : color Rg (p.walk.getVert (p.walk.length-1)) = true := by
    have hh := adjacent_color_ne Rg hlast
    rw [p.end_color] at hh
    cases he : color Rg (p.walk.getVert (p.walk.length-1)) <;> simp_all
  have hprelast : Adjacent Rg (p.walk.getVert (p.walk.length-2))
      (p.walk.getVert (p.walk.length-1)) := by
    have hh := p.walk.adj_getVert_succ (i := p.walk.length-2) (by omega)
    rw [show p.walk.length-2+1=p.walk.length-1 by omega] at hh
    exact (cosetGraph_adj Rg _ _).mp hh
  have hZcG : Z Rg c ≤ stabilizer Rg z :=
    (hbad.trans (Q_le_adjacent_h Rg hlastcol hprelast)).trans
      (fun _ hx => hx.2 _ (adjacent_symm Rg hlast))
  have hHZ : H ≤ Z Rg z := (commutator_mono inf_le_left le_rfl).trans
    (le_normalizer_iff_commutator_le_left.mp (hZcG.trans (Z_normalized Rg z)))
  let := (sourceGeometry h).Z_elementary (sourceDistance_pos h) z p.end_color
  have hHCz : H ≤ centralizer (Z Rg z : Set (FreeAmalgam Rg)) :=
    hHZ.trans (le_centralizer_iff_isMulCommutative.mpr inferInstance)
  have hHCJ := (borel_two_slice_reverse_kernel_mover h e hz hk u hR p
    hat hct hforward hpre hbad).2.2
  have hLC := (borel_opposite_generation_of_core_not_le h e hz hk u hR p.start_color hc
    hat hct (Z Rg z) hgen hcore).2
  have hHCa : H ≤ centralizer (Ltilde Rg a : Set (FreeAmalgam Rg)) := by
    apply le_centralizer_iff.mp
    exact hLC.trans (sup_le (le_centralizer_iff.mp hHCJ) (le_centralizer_iff.mp hHCz))
  have hHCpre : H ≤ centralizer (Ltilde Rg (p.walk.getVert (p.walk.length-2)) :
      Set (FreeAmalgam Rg)) :=
    (commutator_mono le_rfl hbad).trans (predecessor_kernel_residual_central h e hz hk p hpre)
  exact le_centralizer_iff.mp (sup_le (le_centralizer_iff.mp hHCa) (le_centralizer_iff.mp hHCpre))

include h e hz hk in
/-- Central generation discharges core noncontainment for a distinct
mover, retaining the full kernel and both residual centralizers. -/
theorem borel_central_two_slice_distinct_control
    (u : S) (hR : (Rg).map π = borel.map (MulAut.conj u).toMonoidHom)
    {a z c t : Vertex Rg}
    (p : CriticalPath Rg (sourceGeometry h) a z)
    (hat : Adjacent Rg a t) (hct : Adjacent Rg c t)
    (hgen : Q Rg t ⊔ Z Rg z = stabilizer Rg a)
    (hsplit : X Rg a = U Rg a ⊔
      (X Rg a ⊓ centralizer (stabilizer Rg a : Set (FreeAmalgam Rg))))
    (hne : edgeOffenderJoin a t ≠ edgeOffenderJoin c t)
    (hforward : (B Rg a ((sourceGeometry h).Z_normal _)).relIndex (U Rg c) ≤ 2)
    (hpre : (B Rg (p.walk.getVert (p.walk.length-2))
      ((sourceGeometry h).Z_normal _)).relIndex (U Rg z) ≤ 2)
    (hbad : Z Rg c ≤ Q Rg (p.walk.getVert (p.walk.length-2))) :
    Nat.card (⁅Z Rg z ⊓ Q Rg a,Z Rg c⁆ : Subgroup (FreeAmalgam Rg)) ≤ 2 ∧
      Z Rg z ⊓ Q Rg a ≤ edgeOffenderJoin c t ∧
      ⁅Z Rg z ⊓ Q Rg a,Z Rg c⁆ ≤
        centralizer ((Ltilde Rg a ⊔ Ltilde Rg (p.walk.getVert (p.walk.length-2)) :
          Subgroup (FreeAmalgam Rg)) : Set (FreeAmalgam Rg)) := by
  have hc : color Rg c = false := by
    have h1 := adjacent_color_ne Rg hat
    have h2 := adjacent_color_ne Rg hct
    rw [p.start_color] at h1
    cases hh : color Rg c <;> cases hh' : color Rg t <;> simp_all
  have hcore : ¬ Q Rg a ≤ edgeOffenderJoin c t := by
    intro hh
    exact borel_opposite_containing_core_nonsplit h e hz hk u hR p.start_color hc
      hat hct hne hh hsplit
  have hm := borel_two_slice_reverse_kernel_mover h e hz hk u hR p hat hct hforward hpre hbad
  exact ⟨hm.1,hm.2.1,borel_two_slice_opposite_residual_control h e hz hk u hR p
    hat hct hgen hcore hforward hpre hbad⟩

include h e hz hk in
/-- For every mover comparison, endpoint escape yields a noncentral
order-two full-kernel line centralized by both actual residuals. -/
theorem borel_central_two_slice_endpoint_alternatives
    (u : S) (hR : (Rg).map π = borel.map (MulAut.conj u).toMonoidHom)
    {a z c t : Vertex Rg}
    (p : CriticalPath Rg (sourceGeometry h) a z)
    (hat : Adjacent Rg a t) (hct : Adjacent Rg c t)
    (hgen : Q Rg t ⊔ Z Rg z = stabilizer Rg a)
    (hsplit : X Rg a = U Rg a ⊔
      (X Rg a ⊓ centralizer (stabilizer Rg a : Set (FreeAmalgam Rg))))
    (hforward : (B Rg a ((sourceGeometry h).Z_normal _)).relIndex (U Rg c) ≤ 2)
    (hpre : (B Rg (p.walk.getVert (p.walk.length-2))
      ((sourceGeometry h).Z_normal _)).relIndex (U Rg z) ≤ 2)
    (hbad : Z Rg c ≤ Q Rg (p.walk.getVert (p.walk.length-2))) :
    Z Rg z ⊓ Q Rg a ≤ edgeOffenderJoin c t ∧
      (⁅Z Rg c,Z Rg z⁆ ≤ Z Rg a ∨
        (Nat.card (⁅Z Rg z ⊓ Q Rg a,Z Rg c⁆ : Subgroup (FreeAmalgam Rg)) = 2 ∧
          ⁅Z Rg z ⊓ Q Rg a,Z Rg c⁆ ≤
            centralizer ((Ltilde Rg a ⊔ Ltilde Rg (p.walk.getVert (p.walk.length-2)) :
              Subgroup (FreeAmalgam Rg)) : Set (FreeAmalgam Rg)) ∧
          ¬ ⁅Z Rg z ⊓ Q Rg a,Z Rg c⁆ ≤
            centralizer (stabilizer Rg z : Set (FreeAmalgam Rg)))) := by
  refine ⟨(borel_two_slice_reverse_kernel_mover h e hz hk u hR p
    hat hct hforward hpre hbad).2.1,?_⟩
  by_cases hcontrol : ⁅Z Rg c,Z Rg z⁆ ≤ Z Rg a
  · exact Or.inl hcontrol
  right
  have hb := distance_gt_two h e hz hk
  have hs : (Q Rg z).relIndex (Z Rg a) < 4 := by
    rw [(critical_predecessor_small_slice h e hz hk hb p hpre).2.2]
    decide
  have hnonzero : ⁅Z Rg z ⊓ Q Rg a,Z Rg c⁆ ≠ ⊥ := by
    intro he
    rw [commutator_comm] at he
    exact hcontrol (small_critical_predecessor_commutator h e hz hk hb p hs
      (Z Rg c) hbad (commutator_eq_bot_iff_le_centralizer.mp he))
  have hne : edgeOffenderJoin a t ≠ edgeOffenderJoin c t := by
    intro he
    exact hcontrol (borel_equal_mover_two_slice_endpoint_control h e hz hk u hR p
      hat hct he hforward hpre hbad)
  obtain ⟨k,_,_,q,_,_,_,_,hcard,_,_,_,hnon⟩ :=
    two_slice_residual_line h e hz hk p hforward hpre hat hct hbad hnonzero
  exact ⟨hcard,(borel_central_two_slice_distinct_control h e hz hk u hR p
    hat hct hgen hsplit hne hforward hpre hbad).2.2,hnon⟩

end AlternatingSixReconstruction.Exceptional.OriginalSylow
