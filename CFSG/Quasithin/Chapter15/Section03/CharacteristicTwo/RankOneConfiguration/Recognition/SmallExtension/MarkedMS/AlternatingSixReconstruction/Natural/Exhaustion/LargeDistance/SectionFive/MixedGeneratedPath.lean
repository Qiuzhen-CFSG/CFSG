private theorem crossing_normalizer_generates :
    normalizer (plus.map (MulAut.conj MixedLarge.crossing).toMonoidHom : Set S) ⊔
      zpowers swap45 = ⊤ := by
  let ns : Fin 4 → S := ![Equiv.swap 0 1, Equiv.swap 2 3,
    Equiv.swap 0 2 * Equiv.swap 1 3, swap45]
  have hns (i : Fin 4) : ns i ∈ normalizer (plus : Set S) := by
    apply Subgroup.centralizer_le_normalizer
    intro a ha
    obtain ⟨j,rfl⟩ := (mem_plus_iff a).mp ha
    have cert : ∀ i j : Fin 4, planeWords 0 j * ns i = ns i * planeWords 0 j := by decide +kernel
    exact cert i j
  let H := normalizer (plus.map (MulAut.conj MixedLarge.crossing).toMonoidHom : Set S) ⊔
    zpowers swap45
  let gs : Fin 5 → S := ![(MulAut.conj MixedLarge.crossing) (ns 0),
    (MulAut.conj MixedLarge.crossing) (ns 1),
    (MulAut.conj MixedLarge.crossing) (ns 2),
    (MulAut.conj MixedLarge.crossing) (ns 3),swap45]
  have hgs (i : Fin 5) : gs i ∈ H := by
    have hc (j : Fin 4) : (MulAut.conj MixedLarge.crossing) (ns j) ∈ H := by
      apply mem_sup_left
      rw [←map_normalizer_eq_of_bijective _ (MulAut.conj MixedLarge.crossing).bijective]
      exact mem_map_of_mem _ (hns j)
    fin_cases i
    · exact hc 0
    · exact hc 1
    · exact hc 2
    · exact hc 3
    · exact mem_sup_right (mem_zpowers _)
  let words : Fin 5 → List (Fin 5) := ![[0,2,4,1,2],[1,4,1],[2,4,2],[3],[4]]
  have cert : ∀ i : Fin 5, ((words i).map gs).prod = Equiv.swap i.castSucc (5 : Fin 6) := by decide +kernel
  have hs (i : Fin 5) : Equiv.swap i.castSucc (5 : Fin 6) ∈ H := by
    rw [←cert i]
    apply list_prod_mem
    intro g hg
    obtain ⟨j,_,rfl⟩ := List.mem_map.mp hg
    exact hgs j
  apply top_unique
  rw [←Subgroup.closure_eq_top_of_mclosure_eq_top (Equiv.Perm.mclosure_swap_castSucc_succ 5)]
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨i,rfl⟩
  have cert' : ∀ i : Fin 4, Equiv.swap (i.castSucc.castSucc : Fin 6) i.castSucc.succ =
      Equiv.swap i.castSucc.castSucc 5 * Equiv.swap i.succ.castSucc 5 *
        Equiv.swap i.castSucc.castSucc 5 := by decide +kernel
  fin_cases i
  · change Equiv.swap (0 : Fin 6) 1 ∈ H
    rw [show Equiv.swap (0 : Fin 6) 1 = _ from cert' 0]
    exact H.mul_mem (H.mul_mem (hs 0) (hs 1)) (hs 0)
  · change Equiv.swap (1 : Fin 6) 2 ∈ H
    rw [show Equiv.swap (1 : Fin 6) 2 = _ from cert' 1]
    exact H.mul_mem (H.mul_mem (hs 1) (hs 2)) (hs 1)
  · change Equiv.swap (2 : Fin 6) 3 ∈ H
    rw [show Equiv.swap (2 : Fin 6) 3 = _ from cert' 2]
    exact H.mul_mem (H.mul_mem (hs 2) (hs 3)) (hs 2)
  · change Equiv.swap (3 : Fin 6) 4 ∈ H
    rw [show Equiv.swap (3 : Fin 6) 4 = _ from cert' 3]
    exact H.mul_mem (H.mul_mem (hs 3) (hs 4)) (hs 3)
  · exact hs 4

private theorem map_conj_map {F H : Type*} [Group F] [Group H]
    (f : F →* H) (A : Subgroup F) (g : F) :
    (A.map (MulAut.conj g).toMonoidHom).map f =
      (A.map f).map (MulAut.conj (f g)).toMonoidHom := by
  rw [map_map,map_map]
  congr 1
  apply MonoidHom.ext
  intro z
  change f (g*z*g⁻¹) = f g*f z*(f g)⁻¹
  simp only [map_mul,map_inv]

private theorem mixed_aligned_pair (v a : S)
    (ha : a ∈ plus.map (MulAut.conj v).toMonoidHom) (hs : a.IsSwap) :
    ∃ k : S,
      plus.map (MulAut.conj v).toMonoidHom ⊔
        (plus.map (MulAut.conj v).toMonoidHom).map (MulAut.conj k).toMonoidHom = ⊤ ∧
      normalizer (((plus.map (MulAut.conj v).toMonoidHom).map
        (MulAut.conj k).toMonoidHom) : Set S) ⊔ zpowers a = ⊤ := by
  have he : a = (MulAut.conj v) swap45 :=
    MixedEscape.conjugate_mixed_swap_unique v a _ ha
      (mem_map_of_mem _ ((mem_plus_iff swap45).mpr ⟨2,by decide +kernel⟩)) hs
      (by apply Equiv.Perm.isSwap_iff_cycleType.mpr
          change (v * swap45 * v⁻¹).cycleType = {2}
          rw [Equiv.Perm.cycleType_conj]
          decide +kernel)
  let k := v * MixedLarge.crossing * v⁻¹
  have hm : (plus.map (MulAut.conj v).toMonoidHom).map (MulAut.conj k).toMonoidHom =
      (plus.map (MulAut.conj MixedLarge.crossing).toMonoidHom).map (MulAut.conj v).toMonoidHom := by
    rw [map_map,map_map]
    congr 1
    apply MonoidHom.ext
    intro z
    change (v*MixedLarge.crossing*v⁻¹)*(v*z*v⁻¹)*(v*MixedLarge.crossing*v⁻¹)⁻¹ =
      v*(MixedLarge.crossing*z*MixedLarge.crossing⁻¹)*v⁻¹
    group
  refine ⟨k,?_,?_⟩
  · rw [hm,←Subgroup.map_sup,MixedLarge.crossing_generates,map_top_of_surjective _ (MulAut.conj v).surjective]
  · have hz : zpowers ((MulAut.conj v) swap45) =
        (zpowers swap45).map (MulAut.conj v).toMonoidHom :=
      (MonoidHom.map_zpowers (MulAut.conj v).toMonoidHom swap45).symm
    rw [hm,he,hz,←map_normalizer_eq_of_bijective _ (MulAut.conj v).bijective,
      ←Subgroup.map_sup,crossing_normalizer_generates,map_top_of_surjective _ (MulAut.conj v).surjective]

universe u
variable {G : Type u} [Group G] [Finite G] {L R : Subgroup G}
  {h : SmallMSPair KnownSimple.IsKnownSimple L R} {e : CentralMarking L}
  {hz : center (L ⧸ pCore 2 L) = ⊥} {hn : InitialNatural h e hz}
  {d : Replacement L R}

/-- Select one backward edge with both the relative-normalizer generation
needed for escape and generation by its full kernel and the original first
edge kernel. The latter is an additional geometric selection, not a
consequence of arbitrary relative-normalizer generation. -/
theorem mixed_aligned_generating_neighbor_knownSimple
    (hb : 4 < replacementDistance h d) (u : S)
    (him : d.radical.map (SourceReduction.projection h e hz hn d) =
      plus.map (MulAut.conj u).toMonoidHom)
    {a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) a') :
    ∃ t, Adjacent d.radical (alpha d.radical) t ∧
      Q d.radical (p.walk.getVert 1) ⊔ Q d.radical t = stabilizer d.radical (alpha d.radical) ∧
      (normalizer (Q d.radical t : Set (FreeAmalgam d.radical)) ⊓
        stabilizer d.radical (alpha d.radical)) ⊔ Z d.radical a' =
          stabilizer d.radical (alpha d.radical) := by
  let s := fullSymmetricAction_knownSimple h e hz hn d (by omega)
  have hc := DistanceTwo.centralLayer_knownSimple G L R h e hz hn d
  have hf : d.radical.map s.projection = plus.map (MulAut.conj u).toMonoidHom := by
    rwa [SourceReduction.fullSymmetricAction_projection_unique h e hz hn d s]
  have hl : p.walk.length = replacementDistance h d := p.length_eq_b
  have hat : Adjacent d.radical (alpha d.radical) (p.walk.getVert 1) := by
    apply (cosetGraph_adj d.radical _ _).mp
    simpa only [SimpleGraph.Walk.getVert_zero] using p.walk.adj_getVert_succ (i := 0) (by omega)
  have hAt : Z d.radical a' ≤ Q d.radical (p.walk.getVert 1) := by
    apply Z_le_Q_of_dist_lt d.radical a' ((replacementGeometry h d).exists_critical a' p.end_color)
    rw [SimpleGraph.dist_comm,p.dist_end,(replacementGeometry h d).distance_constant _ p.end_color]
    change p.walk.length-1 < replacementDistance h d
    omega
  obtain ⟨E,v,hEm,hEk,hEi⟩ := MixedEndpoint.edge_preimage s u hf hat
  let A := (Z d.radical a').comap (embedM d.radical)
  have hAm : A.map (embedM d.radical) = Z d.radical a' :=
    map_comap_eq_self ((critical_Z_le_stabilizer d.radical (replacementGeometry h d)
      (alpha d.radical) rfl (replacementDistance_pos h d) p.critical).trans_eq
        (stabilizer_m_base d.radical))
  have hAE : A ≤ E := by
    apply (map_le_map_iff_of_injective (embedM_injective d.radical)).mp
    rwa [hAm,hEm]
  obtain ⟨a,ha,hAi⟩ := small_critical_image_eq_swap s hc p (by
    rw [(MixedLarge.mixed_critical_indices_two_knownSimple hb u him p).1]
    decide)
  change A.map s.projection = zpowers a at hAi
  have haE : a ∈ plus.map (MulAut.conj v).toMonoidHom := by
    rw [←hEi]
    exact (map_mono hAE) (hAi ▸ mem_zpowers a)
  obtain ⟨k,hpair,hNg⟩ := mixed_aligned_pair v a haE ha
  obtain ⟨g,hgk⟩ := s.surjective k
  let D := E.map (MulAut.conj g).toMonoidHom
  have hDi : D.map s.projection = (plus.map (MulAut.conj v).toMonoidHom).map
      (MulAut.conj k).toMonoidHom := by
    rw [show D=E.map (MulAut.conj g).toMonoidHom from rfl,map_conj_map,hEi,hgk]
  have hDk : s.projection.ker ≤ D := by
    have hQ : (pCore 2 d.overgroup).map (MulAut.conj g).toMonoidHom = pCore 2 d.overgroup :=
      mem_normalizer_iff_map_conj_eq.mp (by rw [normalizer_eq_top]; exact mem_top _)
    rw [s.projection_kernel,←hQ]
    apply map_mono
    rwa [←s.projection_kernel]
  have hgen : E ⊔ D = ⊤ := by
    apply map_injective_of_ker_le s.projection (hEk.trans le_sup_left) le_top
    rw [Subgroup.map_sup,hEi,hDi,map_top_of_surjective _ s.surjective]
    exact hpair
  have hNm : (normalizer (D : Set d.overgroup)).map s.projection =
      normalizer (D.map s.projection : Set S) := by
    calc
      _ = ((normalizer (D.map s.projection : Set S)).comap s.projection).map s.projection := by
        rw [comap_normalizer_eq_of_surjective _ s.surjective,comap_map_eq_self hDk]
      _ = _ := map_comap_eq_self (by rw [MonoidHom.range_eq_top.mpr s.surjective]; exact le_top)
  have hNgen : normalizer (D : Set d.overgroup) ⊔ A = ⊤ := by
    apply map_injective_of_ker_le s.projection ((hDk.trans D.le_normalizer).trans le_sup_left) le_top
    rw [Subgroup.map_sup,hNm,hDi,hAi,map_top_of_surjective _ s.surjective]
    exact hNg
  let f := (embedM d.radical g)⁻¹
  have hbase : stabilizer d.radical (alpha d.radical) = (embedM d.radical).range := stabilizer_m_base d.radical
  have hfix : act d.radical f (alpha d.radical) = alpha d.radical := by
    change f ∈ stabilizer d.radical (alpha d.radical)
    rw [hbase]
    exact ⟨g⁻¹,by simp only [map_inv,f]⟩
  have hDm : D.map (embedM d.radical) = Q d.radical (act d.radical f (p.walk.getVert 1)) := by
    rw [show D=E.map (MulAut.conj g).toMonoidHom from rfl,map_conj_map,hEm,Q_act]
    simp only [f,inv_inv]
  refine ⟨act d.radical f (p.walk.getVert 1),?_,?_,?_⟩
  · simpa only [hfix] using (adjacent_act_iff d.radical f _ _).mpr hat
  · have hh := congrArg (Subgroup.map (embedM d.radical)) hgen
    rwa [Subgroup.map_sup,hEm,hDm,←MonoidHom.range_eq_map,←hbase] at hh
  · have hh := congrArg (Subgroup.map (embedM d.radical)) hNgen
    rwa [Subgroup.map_sup,SylowNormalizer.normalizer_embed,hDm,hAm,
      ←MonoidHom.range_eq_map,←hbase] at hh

/-- The strengthened edge selection survives strict backward escape and
supplies generation at the first interior component of the new critical
walk. Both transporters, the strict slice and every overlapping vertex are
retained on the original graph. -/
theorem mixed_generated_backward_path_knownSimple
    (hb : 4 < replacementDistance h d) (u : S)
    (him : d.radical.map (SourceReduction.projection h e hz hn d) =
      plus.map (MulAut.conj u).toMonoidHom)
    {a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) a') :
    ∃ t, Adjacent d.radical (alpha d.radical) t ∧
      ∃ x ∈ stabilizer d.radical (alpha d.radical),
        act d.radical x (p.walk.getVert 1) = t ∧
        ∃ k ∈ stabilizer d.radical t,
          ∃ q : CriticalPath d.radical (replacementGeometry h d)
              (act d.radical k (act d.radical x (p.walk.getVert 2)))
              (p.walk.getVert (p.walk.length-2)),
            q.walk.getVert 1 = t ∧
            (∀ i ≤ p.walk.length-2, q.walk.getVert (i+2) = p.walk.getVert i) ∧
            (B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _)).relIndex
                (U d.radical (act d.radical k (act d.radical x (p.walk.getVert 2)))) =
              (B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _)).relIndex
                (U d.radical (p.walk.getVert 2)) ∧
            2 < (B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _)).relIndex
                (U d.radical (act d.radical k (act d.radical x (p.walk.getVert 2)))) ∧
            Q d.radical (q.walk.getVert 1) ⊔ Q d.radical (q.walk.getVert 3) =
              stabilizer d.radical (q.walk.getVert 2) := by
  let s := fullSymmetricAction_knownSimple h e hz hn d (by omega)
  have hc := DistanceTwo.centralLayer_knownSimple G L R h e hz hn d
  have hb2 : 2 < replacementDistance h d := by omega
  have hf : d.radical.map s.projection = plus.map (MulAut.conj u).toMonoidHom := by
    rwa [SourceReduction.fullSymmetricAction_projection_unique h e hz hn d s]
  obtain ⟨t,hat,hpair,hgen⟩ := mixed_aligned_generating_neighbor_knownSimple hb u him p
  have hl : p.walk.length = replacementDistance h d := p.length_eq_b
  have hfirst : Adjacent d.radical (alpha d.radical) (p.walk.getVert 1) := by
    apply (cosetGraph_adj d.radical _ _).mp
    simpa only [SimpleGraph.Walk.getVert_zero] using p.walk.adj_getVert_succ (i := 0) (by omega)
  obtain ⟨x,hx,hxt⟩ := stabilizer_transitive_neighbors d.radical (alpha d.radical) hfirst hat
  have hdelta : Adjacent d.radical (p.walk.getVert 2) (p.walk.getVert 1) :=
    adjacent_symm d.radical ((cosetGraph_adj d.radical _ _).mp
      (p.walk.adj_getVert_succ (i := 1) (by omega)))
  have hct : Adjacent d.radical (act d.radical x (p.walk.getVert 2)) t := by
    rw [←hxt]
    exact (adjacent_act_iff d.radical x _ _).mpr hdelta
  have hB : (B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _)).map
      (MulAut.conj x⁻¹).toMonoidHom = B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _) :=
    mem_normalizer_iff_map_conj_eq.mp (Escape.Propagation.Rigidity.B_normalized hb2 _ rfl
      ((stabilizer d.radical (alpha d.radical)).inv_mem hx))
  have hi : (B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _)).relIndex
      (U d.radical (act d.radical x (p.walk.getVert 2))) =
      (B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _)).relIndex
        (U d.radical (p.walk.getVert 2)) := by
    rw [U_act,←hB,relIndex_map_map_of_injective _ _ (MulAut.conj x⁻¹).injective,hB]
  have hstrict := MixedLarge.mixed_forward_slice_strict_knownSimple hb u him p
  obtain ⟨k,hk,q,hq1,hover,hidx⟩ := MixedEscape.relative_small_backward_shift s hc hb2 u hf p
    (by rw [(MixedLarge.mixed_critical_indices_two_knownSimple hb u him p).1]; decide)
    hat hct hgen (by rwa [hi])
  have hq2 : q.walk.getVert 2 = alpha d.radical := by
    simpa only [Nat.zero_add,SimpleGraph.Walk.getVert_zero] using hover 0 (Nat.zero_le _)
  have hq3 : q.walk.getVert 3 = p.walk.getVert 1 := hover 1 (by omega)
  refine ⟨t,hat,x,hx,hxt,k,hk,q,hq1,hover,hidx.trans hi,?_,?_⟩
  · rwa [hidx,hi]
  · rw [hq1,hq2,hq3]
    exact (sup_comm _ _).trans hpair

/-- The full opposite-radius kernel lies in the first interior core on
a path whose incident kernels generate there. This retains the actual
mixed image and uses no full point-core equality. -/
theorem mixed_radius_kernel_le_interior_knownSimple
    (hb : 4 < replacementDistance h d)
    (u : S)
    (him : d.radical.map (SourceReduction.projection h e hz hn d) =
      plus.map (MulAut.conj u).toMonoidHom)
    {a a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) a a')
    (hgen : Q d.radical (p.walk.getVert 1) ⊔ Q d.radical (p.walk.getVert 3) =
      stabilizer d.radical (p.walk.getVert 2)) :
    V d.radical a' ⊓ Q d.radical a ≤ Q d.radical (p.walk.getVert 2) := by
  let s := fullSymmetricAction_knownSimple h e hz hn d (by omega)
  have hc := DistanceTwo.centralLayer_knownSimple G L R h e hz hn d
  have hR : d.radical.map s.projection ≤ (D 6).map (MulAut.conj u).toMonoidHom := by
    rw [SourceReduction.fullSymmetricAction_projection_unique h e hz hn d s,him]
    exact map_mono plus_le_D
  have hab : ⁅d.radical.map s.projection,d.radical.map s.projection⁆ = ⊥ := by
    let : IsElementaryAbelian 2 (D 6) := elementary_disjointTranspositions (3 : Fin 4)
    let : IsElementaryAbelian 2 ((D 6).map (MulAut.conj u).toMonoidHom) := IsElementaryAbelian.map _
    exact le_antisymm ((commutator_mono hR hR).trans
      (commutator_eq_bot_iff_le_centralizer.mpr
        (le_centralizer_iff_isMulCommutative.mpr inferInstance)).le) bot_le
  have hl : p.walk.length=replacementDistance h d := p.length_eq_b
  have ha₂ : color d.radical (p.walk.getVert 2)=false :=
    (p.vertex_color (by omega)).mpr (by decide)
  have h₂₁ : Adjacent d.radical (p.walk.getVert 2) (p.walk.getVert 1) :=
    adjacent_symm d.radical ((cosetGraph_adj d.radical _ _).mp
      (p.walk.adj_getVert_succ (i := 1) (by omega)))
  have h₂₃ : Adjacent d.radical (p.walk.getVert 2) (p.walk.getVert 3) :=
    (cosetGraph_adj d.radical _ _).mp (p.walk.adj_getVert_succ (i := 2) (by omega))
  rw [←abelian_generating_edge_kernels_inf s hc hab ha₂ h₂₁ h₂₃ hgen]
  apply le_inf
  · have ha₁ : Adjacent d.radical a (p.walk.getVert 1) := by
      apply (cosetGraph_adj d.radical _ _).mp
      simpa only [SimpleGraph.Walk.getVert_zero] using p.walk.adj_getVert_succ (i := 0) (by omega)
    have ht : color d.radical (p.walk.getVert 1)=true := by
      have hh := adjacent_color_ne d.radical ha₁
      rw [p.start_color] at hh
      cases he : color d.radical (p.walk.getVert 1) <;> simp_all
    exact inf_le_right.trans (Q_le_adjacent_h d.radical ht ha₁)
  · apply inf_le_left.trans
    apply V_le_Q_of_dist_add_two_lt d.radical (geometry := replacementGeometry h d) p.end_color
    rw [SimpleGraph.dist_comm,p.dist_end]
    change p.walk.length-3+2 < replacementDistance h d
    omega

/-- Exact two-step kernel tower for a generated mixed-plane path in the
index-four case, retaining the whole radius and full endpoint seed. -/
theorem mixed_radius_four_kernel_tower_knownSimple
    (hb : 4 < replacementDistance h d)
    (u : S)
    (him : d.radical.map (SourceReduction.projection h e hz hn d) =
      plus.map (MulAut.conj u).toMonoidHom)
    {a a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) a a')
    (hgen : Q d.radical (p.walk.getVert 1) ⊔ Q d.radical (p.walk.getVert 3) =
      stabilizer d.radical (p.walk.getVert 2))
    (hfour : (Q d.radical a).relIndex (V d.radical a')=4) :
    (Q d.radical (p.walk.getVert 2)).relIndex (V d.radical a')=2 ∧
      (Q d.radical a).relIndex (V d.radical a' ⊓ Q d.radical (p.walk.getVert 2))=2 ∧
      V d.radical a' ⊓ Q d.radical (p.walk.getVert 2) =
        Z d.radical a' ⊔ (V d.radical a' ⊓ Q d.radical a) := by
  let s := fullSymmetricAction_knownSimple h e hz hn d (by omega)
  have hc := DistanceTwo.centralLayer_knownSimple G L R h e hz hn d
  have hl : p.walk.length=replacementDistance h d := p.length_eq_b
  have hZC : Z d.radical a' ≤ Q d.radical (p.walk.getVert 2) := by
    apply Z_le_Q_of_dist_lt d.radical a' ((replacementGeometry h d).exists_critical a' p.end_color)
    rw [(replacementGeometry h d).distance_constant a' p.end_color,SimpleGraph.dist_comm,p.dist_end]
    change p.walk.length-2 < replacementDistance h d
    omega
  let rev : CriticalPath d.radical (replacementGeometry h d) a' a :=
    ⟨p.end_color,p.walk.reverse,by rw [SimpleGraph.Walk.length_reverse,p.shortest,SimpleGraph.dist_comm],critical_reverse_pair s hc p⟩
  have hri := (MixedRadius.mixed_opposite_radius_line_knownSimple hb u him rev).1
  change (Q d.radical (p.walk.reverse.getVert (p.walk.reverse.length-2))).relIndex
    (V d.radical a')=2 at hri
  rw [SimpleGraph.Walk.length_reverse,SimpleGraph.Walk.getVert_reverse,
    show p.walk.length-(p.walk.length-2)=2 by omega] at hri
  have hescape : ¬ V d.radical a' ≤ Q d.radical (p.walk.getVert 2) := by
    intro he
    have hh := relIndex_eq_one.mpr he
    rw [hri] at hh
    contradiction
  have hVQ := V_le_Q d.radical (geometry := replacementGeometry h d) p.end_color
    (show 2 < replacementDistance h d by omega)
  let := finite_stabilizer d.radical a'
  let : Finite (V d.radical a') := Finite.of_injective
    (inclusion (hVQ.trans (fun _ hx => hx.1))) (inclusion_injective _)
  exact index_four_kernel_tower _ _ _ _ (Z_le_VBall d.radical _ 2) hZC
    (mixed_radius_kernel_le_interior_knownSimple (e := e) (hz := hz) (hn := hn) hb u him p hgen)
    (MixedLarge.mixed_critical_indices_two_knownSimple (e := e) (hz := hz) (hn := hn) hb u him p).2.1
    hfour hescape

include e hz hn in
/-- In the equality-four case, the whole interior radius kernel has exactly
the original critical commutator against the starting seed. -/
theorem mixed_radius_four_kernel_commutator_knownSimple
    (hb : 4 < replacementDistance h d)
    (u : S)
    (him : d.radical.map (SourceReduction.projection h e hz hn d) =
      plus.map (MulAut.conj u).toMonoidHom)
    {a a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) a a')
    (hgen : Q d.radical (p.walk.getVert 1) ⊔ Q d.radical (p.walk.getVert 3) =
      stabilizer d.radical (p.walk.getVert 2))
    (hfour : (Q d.radical a).relIndex (V d.radical a')=4) :
    ⁅V d.radical a' ⊓ Q d.radical (p.walk.getVert 2),Z d.radical a⁆ =
      ⁅Z d.radical a',Z d.radical a⁆ := by
  have ht := mixed_radius_four_kernel_tower_knownSimple
    (e := e) (hz := hz) (hn := hn) hb u him p hgen hfour
  rw [ht.2.2]
  apply le_antisymm _ (commutator_mono le_sup_left le_rfl)
  let J := ⁅Z d.radical a',Z d.radical a⁆
  have hJZ : J ≤ Z d.radical a' := by
    dsimp only [J]
    rw [commutator_comm]
    exact ((critical_Z_commutator_le_moving (h := h) p).trans inf_le_right).trans
      (DistanceEight.U_le_Z d.radical a')
  have hQN : Q d.radical a' ≤ normalizer (J : Set (FreeAmalgam d.radical)) :=
    ((le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp
      (Z_centralizes_Q d.radical a' p.end_color))).trans (centralizer_le hJZ)).trans
        (Subgroup.centralizer_le_normalizer _)
  have hVQ := V_le_Q d.radical (geometry := replacementGeometry h d) p.end_color
    (show 2 < replacementDistance h d by omega)
  apply commutator_sup_le_of_relative_normal (Q d.radical a')
    (Z d.radical a') (V d.radical a' ⊓ Q d.radical a) (Z d.radical a) J hQN
    ((Z_le_VBall d.radical a' 2).trans hVQ) (inf_le_left.trans hVQ) le_rfl
  exact (commutator_mono inf_le_right le_rfl).trans
    (by rw [commutator_comm,Z_centralizes_Q d.radical a p.start_color]; exact bot_le)


/-- The small whole-radius case is impossible on a path selected with
interior kernel generation. The exact commutator estimate contradicts the
previously proved whole-radius endpoint escape on the reversed path. -/
theorem mixed_generated_radius_gt_four_knownSimple
    (hb : 4 < replacementDistance h d) (u : S)
    (him : d.radical.map (SourceReduction.projection h e hz hn d) =
      plus.map (MulAut.conj u).toMonoidHom)
    {a a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) a a')
    (hgen : Q d.radical (p.walk.getVert 1) ⊔ Q d.radical (p.walk.getVert 3) =
      stabilizer d.radical (p.walk.getVert 2)) :
    4 < (Q d.radical a).relIndex (V d.radical a') := by
  by_contra! hsmall
  have hfour := (small_opposite_radius_eq_four_knownSimple
    (e := e) (hz := hz) (hn := hn) (by omega) p hsmall).2.2
  have hcomm := mixed_radius_four_kernel_commutator_knownSimple hb u him p hgen hfour
  let s := fullSymmetricAction_knownSimple h e hz hn d (by omega)
  have hc := DistanceTwo.centralLayer_knownSimple G L R h e hz hn d
  let rev : CriticalPath d.radical (replacementGeometry h d) a' a :=
    ⟨p.end_color,p.walk.reverse,
      by rw [SimpleGraph.Walk.length_reverse,p.shortest,SimpleGraph.dist_comm],
      critical_reverse_pair s hc p⟩
  have hnot := MixedEndpoint.mixed_radius_kernel_commutator_escape_at_knownSimple hb u him rev
  have hl : p.walk.length = replacementDistance h d := p.length_eq_b
  change ¬ ⁅V d.radical a' ⊓ Q d.radical (p.walk.reverse.getVert (p.walk.reverse.length-2)),
    Z d.radical a⁆ ≤ Z d.radical a' at hnot
  rw [SimpleGraph.Walk.length_reverse,SimpleGraph.Walk.getVert_reverse,
    show p.walk.length-(p.walk.length-2)=2 by omega] at hnot
  apply hnot
  rw [hcomm,commutator_comm]
  exact ((critical_Z_commutator_le_moving (h := h) p).trans inf_le_right).trans
    (DistanceEight.U_le_Z d.radical a')

/-- Every mixed-plane critical path above distance four has an actual
strict backward shift whose endpoint radius has index greater than four
against its starting core. The two original transporters, full interior
kernel generation and all overlapping vertices remain part of the witness. -/
theorem mixed_backward_large_radius_knownSimple
    (hb : 4 < replacementDistance h d) (u : S)
    (him : d.radical.map (SourceReduction.projection h e hz hn d) =
      plus.map (MulAut.conj u).toMonoidHom)
    {a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) a') :
    ∃ t, Adjacent d.radical (alpha d.radical) t ∧
      ∃ x ∈ stabilizer d.radical (alpha d.radical),
        act d.radical x (p.walk.getVert 1) = t ∧
        ∃ k ∈ stabilizer d.radical t,
          ∃ q : CriticalPath d.radical (replacementGeometry h d)
              (act d.radical k (act d.radical x (p.walk.getVert 2)))
              (p.walk.getVert (p.walk.length-2)),
            q.walk.getVert 1 = t ∧
            (∀ i ≤ p.walk.length-2, q.walk.getVert (i+2) = p.walk.getVert i) ∧
            (B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _)).relIndex
                (U d.radical (act d.radical k (act d.radical x (p.walk.getVert 2)))) =
              (B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _)).relIndex
                (U d.radical (p.walk.getVert 2)) ∧
            2 < (B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _)).relIndex
                (U d.radical (act d.radical k (act d.radical x (p.walk.getVert 2)))) ∧
            (Q d.radical (q.walk.getVert 1) ⊔ Q d.radical (q.walk.getVert 3) =
              stabilizer d.radical (q.walk.getVert 2)) ∧
            4 < (Q d.radical (act d.radical k (act d.radical x (p.walk.getVert 2)))).relIndex
              (V d.radical (p.walk.getVert (p.walk.length-2))) := by
  obtain ⟨t,hat,x,hx,hxt,k,hk,q,hq1,hover,hidx,hstrict,hgen⟩ :=
    mixed_generated_backward_path_knownSimple hb u him p
  exact ⟨t,hat,x,hx,hxt,k,hk,q,hq1,hover,hidx,hstrict,hgen,
    mixed_generated_radius_gt_four_knownSimple hb u him q hgen⟩


/-- The selected large-radius backward path exists at every original
component vertex. Its literal overlap and interior generation allow
successive selections on the same graph; no new path premise is added. -/
theorem mixed_backward_large_radius_at_knownSimple
    (hb : 4 < replacementDistance h d) (u : S)
    (him : d.radical.map (SourceReduction.projection h e hz hn d) =
      plus.map (MulAut.conj u).toMonoidHom)
    {a a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) a a') :
    ∃ z : Vertex d.radical,
      ∃ q : CriticalPath d.radical (replacementGeometry h d) z
          (p.walk.getVert (p.walk.length-2)),
        (∀ i ≤ p.walk.length-2, q.walk.getVert (i+2) = p.walk.getVert i) ∧
        (Q d.radical (q.walk.getVert 1) ⊔ Q d.radical (q.walk.getVert 3) =
          stabilizer d.radical (q.walk.getVert 2)) ∧
        2 < (B d.radical a ((replacementGeometry h d).Z_normal _)).relIndex (U d.radical z) ∧
        4 < (Q d.radical z).relIndex (V d.radical (p.walk.getVert (p.walk.length-2))) := by
  obtain ⟨g,hga⟩ := exists_mVertex_of_color d.radical p.start_color
  have hbase : act d.radical g⁻¹ a = alpha d.radical := by
    rw [hga,act_mVertex,mul_inv_cancel]
    rfl
  have base := mixed_backward_large_radius_knownSimple hb u him
    (a' := act d.radical g⁻¹ a')
  rw [←hbase] at base
  obtain ⟨t,hat,x,hx,hxt,k,hk,q,hq1,hover,hidx,hstrict,hgen,hlarge⟩ := base (p.act g⁻¹)
  let z := act d.radical k (act d.radical x ((p.act g⁻¹).walk.getVert 2))
  have hcancel (v : Vertex d.radical) : act d.radical g (act d.radical g⁻¹ v) = v := by
    rw [←act_mul,inv_mul_cancel,act_one]
  have hout : ∃ r : CriticalPath d.radical (replacementGeometry h d)
      (act d.radical g z)
      (act d.radical g ((p.act g⁻¹).walk.getVert ((p.act g⁻¹).walk.length-2))),
        (∀ i ≤ p.walk.length-2, r.walk.getVert (i+2) = p.walk.getVert i) ∧
        Q d.radical (r.walk.getVert 1) ⊔ Q d.radical (r.walk.getVert 3) =
          stabilizer d.radical (r.walk.getVert 2) := by
    refine ⟨q.act g,?_,?_⟩
    · intro i hi
      have he := congrArg (act d.radical g) (hover i (by
        simpa only [CriticalPath.act,actWalk_length] using hi))
      change (actWalk d.radical g q.walk).getVert (i+2) = _
      rw [actWalk_getVert]
      simpa only [CriticalPath.act,actWalk_getVert,hcancel] using he
    · change Q d.radical ((actWalk d.radical g q.walk).getVert 1) ⊔
        Q d.radical ((actWalk d.radical g q.walk).getVert 3) =
          stabilizer d.radical ((actWalk d.radical g q.walk).getVert 2)
      rw [actWalk_getVert,actWalk_getVert,actWalk_getVert]
      have he := congrArg (Subgroup.map (MulAut.conj g⁻¹).toMonoidHom) hgen
      rw [Subgroup.map_sup,←Q_act,←Q_act,←stabilizer_act] at he
      simpa only [CriticalPath.act,actWalk_getVert] using he
  have hend : act d.radical g ((p.act g⁻¹).walk.getVert ((p.act g⁻¹).walk.length-2)) =
      p.walk.getVert (p.walk.length-2) := by
    change act d.radical g ((actWalk d.radical g⁻¹ p.walk).getVert
      ((actWalk d.radical g⁻¹ p.walk).length-2)) = _
    rw [actWalk_length,actWalk_getVert,hcancel]
  rw [hend] at hout
  obtain ⟨r,hro,hri⟩ := hout
  refine ⟨act d.radical g z,r,hro,hri,?_,?_⟩
  · have hB := Escape.PairingControl.FirstPairing.B_act
      (geometry := replacementGeometry h d) (show 2 < replacementDistance h d by omega)
      g (act d.radical g⁻¹ a) (by rw [action_preserves_color]; exact p.start_color)
    rw [hcancel] at hB
    rw [hB,U_act,relIndex_map_map_of_injective _ _ (MulAut.conj g⁻¹).injective]
    exact hstrict
  · have he : (Q d.radical (act d.radical g z)).relIndex
        (V d.radical (act d.radical g ((p.act g⁻¹).walk.getVert ((p.act g⁻¹).walk.length-2)))) =
        (Q d.radical z).relIndex (V d.radical ((p.act g⁻¹).walk.getVert ((p.act g⁻¹).walk.length-2))) := by
      rw [Q_act,V_act,relIndex_map_map_of_injective _ _ (MulAut.conj g⁻¹).injective]
    rw [hend] at he
    rwa [he]

