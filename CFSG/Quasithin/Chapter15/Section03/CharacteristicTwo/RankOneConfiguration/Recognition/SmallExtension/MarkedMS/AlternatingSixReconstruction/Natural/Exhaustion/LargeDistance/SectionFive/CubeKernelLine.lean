include s in
/-- The fixed-hyperplane comparison in the literal moved subgroup and original
quotient action; both possible central covers are retained. -/
theorem cube_cover_large_fixed_commutator (u : S)
    (hR : d.radical.map s.projection ≤ (D 6).map (MulAut.conj u).toMonoidHom)
    (A P : Subgroup d.overgroup) (hA : A ≤ d.radical) (hP : P ≤ d.radical)
    (hne : ¬ A ≤ pCore 2 d.overgroup)
    (hindex : (centralizer (A : Set d.overgroup)).relIndex (replacementMoved d) ≤ 2)
    (hlarge : 2 < Nat.card (⁅replacementMoved d ⊓ centralizer (A : Set d.overgroup),P⁆ : Subgroup d.overgroup)) :
    ⁅replacementMoved d,P⁆ ≤
      ⁅replacementMoved d ⊓ centralizer (A : Set d.overgroup),P⁆ ⊔ ⁅replacementMoved d,A⁆ := by
  let := replacementMoved_normal h d
  let U := replacementMoved d
  let F := U ⊓ centralizer (A : Set d.overgroup)
  let K := ⁅F,P⁆
  have hKU : K ≤ U := (commutator_mono inf_le_left le_rfl).trans (commutator_le_left U P)
  let : IsElementaryAbelian 2 K := IsElementaryAbelian.of_le hKU
  have hker := s.projection_kernel.trans (moved_centralizer s).symm
  have hsmall : fixedCodim (coverAction s) (A.map s.projection) ≤ 1 := by
    rw [centralizer_index_eq_fixedCodim U s.projection s.surjective hker] at hindex
    exact (Nat.pow_le_pow_iff_right (by decide : 1<2)).mp hindex
  have hnat : fixedCodim (naturalRepresentation (Fin 6)) (A.map s.projection) ≤ 1 :=
    (fixedCodim_le_of_equivariant_surjection (coverAction s) (naturalRepresentation (Fin 6))
      (coverMap (h := h) (e := e) (hz := hz) (hn := hn) (d := d))
      (coverMap_surjective (h := h) (e := e) (hz := hz) (hn := hn) (d := d))
      (coverMap_equivariant s) (A.map s.projection)).trans hsmall
  have hnA : A.map s.projection ≠ ⊥ := by
    intro he
    exact hne (s.projection_kernel ▸ (map_eq_bot_iff A).mp he)
  obtain ⟨t,ht,hs,he⟩ := PointCoreTranspositionFixed.small_image_eq_zpowers (A.map s.projection) hnA hnat
  have hF : subgroupSpace U F = fixedSpace (coverAction s) (A.map s.projection) := by
    ext v
    change ((v.toMul : d.overgroup) ∈ U ∧ (v.toMul : d.overgroup) ∈ centralizer (A : Set d.overgroup)) ↔ _
    simp only [v.toMul.property,true_and]
    exact (mem_fixedSpace_image U s.projection s.surjective hker A v).symm
  have hK : subgroupSpace U K = subspaceCommutator (coverAction s)
      (fixedSpace (coverAction s) (A.map s.projection)) (P.map s.projection) := by
    rw [subgroupSpace_commutator U s.projection s.surjective hker F P inf_le_left,hF]
    rfl
  have hU : subgroupSpace U U = ⊤ := by ext v; exact iff_of_true v.toMul.property trivial
  have hdim : 1 < Module.finrank (ZMod 2) (subgroupSpace U K) := by
    have hcard : Nat.card K = 2 ^ Module.finrank (ZMod 2) (subgroupSpace U K) := by
      calc Nat.card K = Nat.card (Additive K) := rfl
           _ = Nat.card (subgroupSpace U K) := Nat.card_congr (subgroupSpaceEquiv U K hKU).toEquiv
           _ = _ := by rw [Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod]
    change 2 < Nat.card K at hlarge
    rw [hcard] at hlarge
    exact (Nat.pow_lt_pow_iff_right (by decide : 1<2)).mp hlarge
  rw [hK,he] at hdim
  have hc := CubeKernelLine.model_comparison (coverAction s) (cover_model s) u t
    (P.map s.projection) ((map_mono hP).trans hR) (((map_mono hA).trans hR) ht) hs hdim
  rw [←he,←hK] at hc
  have hwhole (B : Subgroup d.overgroup) : subgroupSpace U ⁅U,B⁆ =
      subspaceCommutator (coverAction s) ⊤ (B.map s.projection) := by
    rw [subgroupSpace_commutator U s.projection s.surjective hker U B le_rfl,hU]
    rfl
  rw [←hwhole P,←hwhole A,←subgroupSpace_sup U hKU (commutator_le_left U A)] at hc
  intro v hv
  exact hc (show Additive.ofMul (⟨v,(commutator_le_left U P) hv⟩ : U) ∈ subgroupSpace U ⁅U,P⁆ from hv)

include s in
private theorem embedded_cube_large_fixed_commutator {H : Type*} [Group H]
    (u : S) (hR : d.radical.map s.projection ≤ (D 6).map (MulAut.conj u).toMonoidHom)
    (i : d.overgroup →* H) (hi : Function.Injective i)
    (A P : Subgroup H) (hA : A ≤ d.radical.map i) (hP : P ≤ d.radical.map i)
    (hne : ¬ A ≤ (pCore 2 d.overgroup).map i)
    (hindex : (centralizer (A : Set H)).relIndex ((replacementMoved d).map i) ≤ 2)
    (hlarge : 2 < Nat.card (⁅(replacementMoved d).map i ⊓ centralizer (A : Set H),P⁆ : Subgroup H)) :
    ⁅(replacementMoved d).map i,P⁆ ≤
      ⁅(replacementMoved d).map i ⊓ centralizer (A : Set H),P⁆ ⊔ ⁅(replacementMoved d).map i,A⁆ := by
  have hmA : (A.comap i).map i = A := map_comap_eq_self (hA.trans (map_le_range i _))
  have hmP : (P.comap i).map i = P := map_comap_eq_self (hP.trans (map_le_range i _))
  have hAr : A.comap i ≤ d.radical := by
    apply (map_le_map_iff_of_injective hi).mp
    rwa [hmA]
  have hPr : P.comap i ≤ d.radical := by
    apply (map_le_map_iff_of_injective hi).mp
    rwa [hmP]
  have hnA : ¬ A.comap i ≤ pCore 2 d.overgroup := by
    intro hh
    exact hne (hmA ▸ map_mono hh)
  have hidx : (centralizer (A.comap i : Set d.overgroup)).relIndex (replacementMoved d) ≤ 2 := by
    rw [←hmA,←inf_relIndex_right,inf_comm,
      map_inf_centralizer_of_injective i hi,relIndex_map_map_of_injective _ _ hi,inf_relIndex_left] at hindex
    exact hindex
  have hcard : 2 < Nat.card (⁅replacementMoved d ⊓ centralizer (A.comap i : Set d.overgroup),P.comap i⁆ : Subgroup d.overgroup) := by
    rw [←card_map_of_injective hi,map_commutator,←map_inf_centralizer_of_injective i hi,hmA,hmP]
    exact hlarge
  have hh := map_mono (f := i) (cube_cover_large_fixed_commutator s u hR
    (A.comap i) (P.comap i) hAr hPr hnA hidx hcard)
  rwa [Subgroup.map_sup,map_commutator,map_commutator,map_commutator,
    ←map_inf_centralizer_of_injective i hi,hmA,hmP] at hh
private theorem commutator_sup_of_central_attachment {H : Type*} [Group H]
    (U Z P : Subgroup H) (hN : Z ≤ normalizer (U : Set H))
    (hC : Z ≤ centralizer (P : Set H)) : ⁅U ⊔ Z,P⁆ = ⁅U,P⁆ := by
  apply le_antisymm _ (commutator_mono le_sup_left le_rfl)
  apply commutator_le.mpr
  intro x hx r hr
  have hp : x ∈ (U : Set H) * (Z : Set H) := by
    rw [←coe_mul_of_right_le_normalizer_left U Z hN]
    exact hx
  obtain ⟨w,hw,z,hz,rfl⟩ := hp
  have hzero : ⁅z,r⁆=1 := commutatorElement_eq_one_iff_mul_comm.mpr (hC hz r hr).symm
  rw [commutatorElement_mul_left_eq_conj_mul,hzero,mul_one,mul_inv_cancel,one_mul]
  exact commutator_mem_commutator hw hr

include s in
/-- The literal full seed, including its central edge attachment, satisfies
the hyperplane comparison for every actor in the incident edge kernel. -/
theorem cube_edge_large_fixed_commutator (hc : DistanceTwo.CentralLayer d) (u : S)
    (hR : d.radical.map s.projection ≤ (D 6).map (MulAut.conj u).toMonoidHom)
    {c t : Vertex d.radical} (hcol : color d.radical c = false)
    (hct : Adjacent d.radical c t)
    (A P : Subgroup (FreeAmalgam d.radical)) (hA : A ≤ Q d.radical t) (hP : P ≤ Q d.radical t)
    (hne : ¬ A ≤ Q d.radical c)
    (hindex : (centralizer (A : Set (FreeAmalgam d.radical))).relIndex (U d.radical c) ≤ 2)
    (hlarge : 2 < Nat.card (⁅Z d.radical c ⊓ centralizer (A : Set (FreeAmalgam d.radical)),P⁆ :
      Subgroup (FreeAmalgam d.radical))) :
    ⁅Z d.radical c,P⁆ ≤
      ⁅Z d.radical c ⊓ centralizer (A : Set (FreeAmalgam d.radical)),P⁆ ⊔ ⁅Z d.radical c,A⁆ := by
  have hcoords : ∃ i : d.overgroup →* FreeAmalgam d.radical, Function.Injective i ∧
      d.radical.map i = Q d.radical t ∧ (pCore 2 d.overgroup).map i = Q d.radical c ∧
      (replacementMoved d).map i = U d.radical c := by
    obtain ⟨g,hg|hg⟩ := (adjacent_iff_exists_common d.radical c t).mp hct
    · rcases hg with ⟨rfl,rfl⟩
      let i := (MulAut.conj g⁻¹).toMonoidHom.comp (embedM d.radical)
      refine ⟨i,(MulAut.conj g⁻¹).injective.comp (embedM_injective d.radical),?_,?_,?_⟩
      · have he := Q_act d.radical g (beta d.radical)
        rw [Q_beta] at he
        simpa only [beta,act_hVertex,one_mul,map_map] using he.symm
      · have he := Q_act d.radical g (alpha d.radical)
        rw [Q_alpha d.radical (replacement_radical_isPGroup h d) (replacement_core_le_radical h d)] at he
        simpa only [alpha,act_mVertex,one_mul,map_map] using he.symm
      · have he := U_act d.radical g (alpha d.radical)
        rw [hc.U_eq_moved] at he
        simpa only [alpha,act_mVertex,one_mul,map_map] using he.symm
    · rw [hg.1] at hcol
      cases hcol
  obtain ⟨i,hi,hiR,hiQ,hiU⟩ := hcoords
  have ht : color d.radical t = true := by
    have hh := adjacent_color_ne d.radical hct
    rw [hcol] at hh
    cases he : color d.radical t <;> simp_all
  have hseed : Z d.radical t ≤ centralizer (Q d.radical t : Set (FreeAmalgam d.radical)) := by
    intro x hx
    rw [Z,if_neg (by simp [ht])] at hx
    exact (mem_omegaCenter_iff.mp hx).2.2
  have hseedA := hseed.trans (centralizer_le hA)
  have hseedP := hseed.trans (centralizer_le hP)
  have hseedN : Z d.radical t ≤ normalizer (U d.radical c : Set (FreeAmalgam d.radical)) :=
    ((adjacent_Z_le d.radical hcol hct).trans (Z_le_stabilizer d.radical c)).trans (U_normalized c)
  let F := U d.radical c ⊓ centralizer (A : Set (FreeAmalgam d.radical))
  have heq : Z d.radical c ⊓ centralizer (A : Set (FreeAmalgam d.radical)) = F ⊔ Z d.radical t := by
    rw [DistanceTwo.CentralLayer.Z_eq_moving_sup_edge_at h e hz d hcol hct,
      sup_comm (U d.radical c),inf_centralizer_sup_of_centralizing _ _ _ hseedN hseedA]
    exact sup_comm _ _
  have hNF : Z d.radical t ≤ normalizer (F : Set (FreeAmalgam d.radical)) :=
    (le_inf hseedN (hseedA.trans (centralizer (A : Set (FreeAmalgam d.radical))).le_normalizer)).trans
      inf_normalizer_le_normalizer_inf
  have hcomm : ⁅Z d.radical c ⊓ centralizer (A : Set (FreeAmalgam d.radical)),P⁆ = ⁅F,P⁆ := by
    rw [heq,commutator_sup_of_central_attachment F _ P hNF hseedP]
  have hwhole (X : Subgroup (FreeAmalgam d.radical)) (hX : X ≤ Q d.radical t) :
      ⁅Z d.radical c,X⁆ = ⁅U d.radical c,X⁆ := by
    rw [DistanceTwo.CentralLayer.Z_eq_moving_sup_edge_at h e hz d hcol hct,
      commutator_sup_of_central_attachment _ _ X hseedN (hseed.trans (centralizer_le hX))]
  rw [hcomm] at hlarge ⊢
  rw [hwhole P hP,hwhole A hA]
  rw [←hiR] at hA hP
  rw [←hiQ] at hne
  rw [←hiU] at hindex
  have hh := embedded_cube_large_fixed_commutator s u hR i hi A P hA hP hne hindex
  rw [hiU] at hh
  exact hh hlarge

include s in
/-- Failure of the retained endpoint normalization excludes the order-four
reverse-kernel obstruction, on the original overlapping critical path. -/
theorem cube_backward_kernel_card_le_two
    (hc : DistanceTwo.CentralLayer d) (hb : 2 < replacementDistance h d)
    (u : S) (hR : d.radical.map s.projection ≤ (D 6).map (MulAut.conj u).toMonoidHom)
    {a a' c t : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) a a')
    (hsmall : (Q d.radical a').relIndex (Z d.radical a) < 4)
    (hat : Adjacent d.radical a t) (hct : Adjacent d.radical c t)
    (hbad : Z d.radical c ≤ Q d.radical (p.walk.getVert (p.walk.length-2)))
    (hnorm : ¬ Z d.radical a' ≤ normalizer
      ((Z d.radical c ⊔ Z d.radical a : Subgroup (FreeAmalgam d.radical)) : Set (FreeAmalgam d.radical))) :
    Nat.card (⁅Z d.radical c,Z d.radical a' ⊓ Q d.radical a⁆ : Subgroup (FreeAmalgam d.radical)) ≤ 2 := by
  by_contra hcard
  have hlarge := Nat.lt_of_not_ge hcard
  let F := Z d.radical a' ⊓ Q d.radical a
  let P := Z d.radical a ⊔ Z d.radical c
  have hl : 2 < p.walk.length := p.length_eq_b ▸ hb
  let v := p.walk.getVert (p.walk.length-1)
  have hev : Adjacent d.radical a' v := by
    have hh := p.walk.adj_getVert_succ (i := p.walk.length-1) (by omega)
    rw [show p.walk.length-1+1=p.walk.length by omega,p.walk.getVert_length] at hh
    exact adjacent_symm d.radical ((cosetGraph_adj d.radical _ _).mp hh)
  have hv : color d.radical v = true := by
    have hh := adjacent_color_ne d.radical hev
    rw [p.end_color] at hh
    cases he : color d.radical v <;> simp_all
  have hpre : Q d.radical (p.walk.getVert (p.walk.length-2)) ≤ Q d.radical v := by
    apply Q_le_adjacent_h d.radical hv
    have hh := p.walk.adj_getVert_succ (i := p.walk.length-2) (by omega)
    rw [show p.walk.length-2+1=p.walk.length-1 by omega] at hh
    exact (cosetGraph_adj d.radical _ _).mp hh
  have hAv : Z d.radical a ≤ Q d.radical v := by
    apply Z_le_Q_of_dist_lt d.radical _ ((replacementGeometry h d).exists_critical _ p.start_color)
    rw [(replacementGeometry h d).distance_constant _ p.start_color,p.dist_start (Nat.sub_le _ _)]
    have he : p.walk.length = replacementDistance h d := p.length_eq_b
    change p.walk.length-1 < replacementDistance h d
    omega
  have hPv : P ≤ Q d.radical v := sup_le hAv (hbad.trans hpre)
  have hfixed : F = Z d.radical a' ⊓ centralizer (Z d.radical a : Set (FreeAmalgam d.radical)) := by
    apply le_antisymm
    · exact inf_le_inf_left _ (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp
        (Z_centralizes_Q d.radical a p.start_color)))
    · intro x hx
      refine ⟨hx.1,?_⟩
      rw [←C_eq_Q s hc a p.start_color]
      exact ⟨critical_Z_le_stabilizer d.radical (replacementGeometry h d) a p.start_color
        (by rw [(replacementGeometry h d).distance_constant a p.start_color]
            exact replacementDistance_pos h d) p.critical hx.1,hx.2⟩
  let := finite_Z d.radical a'
  let : Finite (U d.radical a') := Finite.of_injective
    (inclusion (DistanceEight.U_le_Z d.radical a')) (inclusion_injective _)
  have hindex : (centralizer (Z d.radical a : Set (FreeAmalgam d.radical))).relIndex
      (U d.radical a') ≤ 2 := by
    have hQC : Q d.radical a ≤ centralizer (Z d.radical a : Set (FreeAmalgam d.radical)) :=
      le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp
        (Z_centralizes_Q d.radical a p.start_color))
    exact ((relIndex_le_of_le_left hQC index_ne_zero_of_finite).trans
      (relIndex_le_of_le_right (DistanceEight.U_le_Z d.radical a') index_ne_zero_of_finite)).trans_eq
        (small_critical_indices s hc p hsmall).2
  have hdist : (cosetGraph d.radical).dist c a ≤ 2 := by
    have h1 : (cosetGraph d.radical).dist c t=1 :=
      SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj d.radical _ _).mpr hct)
    have h2 : (cosetGraph d.radical).dist t a=1 :=
      SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj d.radical _ _).mpr (adjacent_symm d.radical hat))
    simpa only [h1,h2] using (cosetGraph_connected d.radical).dist_triangle (u := c) (v := t) (w := a)
  have hCQ : Z d.radical c ≤ Q d.radical a :=
    ((Z_le_localZSpan d.radical _ _).trans (localZSpan_le_V d.radical hdist)).trans
      ((replacementGeometry h d).V_le_Q hb a p.start_color)
  have hAC : Z d.radical a ≤ centralizer (Z d.radical c : Set (FreeAmalgam d.radical)) :=
    (commutator_eq_bot_iff_le_centralizer.mp (Z_centralizes_Q d.radical a p.start_color)).trans
      (centralizer_le hCQ)
  have hAF : Z d.radical a ≤ centralizer (F : Set (FreeAmalgam d.radical)) := by
    rw [hfixed]
    exact le_centralizer_iff.mpr inf_le_right
  have hK : ⁅F,P⁆ = ⁅Z d.radical c,F⁆ := by
    rw [commutator_comm]
    change ⁅Z d.radical a ⊔ Z d.radical c,F⁆ = _
    rw [sup_comm (Z d.radical a),commutator_sup_of_central_attachment _ _ _
      (hAC.trans (Subgroup.centralizer_le_normalizer _)) hAF]
  have hlarge' : 2 < Nat.card (⁅Z d.radical a' ⊓
      centralizer (Z d.radical a : Set (FreeAmalgam d.radical)),P⁆ : Subgroup (FreeAmalgam d.radical)) := by
    rw [←hfixed,hK]
    exact hlarge
  have hcmp := cube_edge_large_fixed_commutator s hc u hR p.end_color hev
    (Z d.radical a) P hAv hPv p.critical.2 hindex hlarge'
  rw [←hfixed,hK] at hcmp
  have hH := ((cube_backward_kernel_le_edge_seeds s hc hb u hR p hat hct hbad).2).trans inf_le_left
  have hcrit : ⁅Z d.radical a',Z d.radical a⁆ ≤ Z d.radical a :=
    le_normalizer_iff_commutator_le_right.mp
      ((critical_Z_le_stabilizer d.radical (replacementGeometry h d) a p.start_color
        (by rw [(replacementGeometry h d).distance_constant a p.start_color]
            exact replacementDistance_pos h d) p.critical).trans (Z_normalized d.radical a))
  apply hnorm
  rw [sup_comm (Z d.radical c)]
  exact le_normalizer_iff_commutator_le_right.mpr ((hcmp.trans (sup_le hH hcrit)).trans le_sup_left)

include e hz hn in
/-- On the actual nonsylow minimum replacement, retain the selected cubic,
neighbor transporter and overlapping walk. Its remaining kernel obstruction
has order exactly two and lies in both end-edge seeds and intervening component seeds. -/
theorem nonsylow_small_backward_line_obstruction_knownSimple
    (hb4 : 4 < replacementDistance h d)
    (hns : ¬ ∃ T : Sylow 2 (L ⊔ R : Subgroup G),
      (T : Subgroup (L ⊔ R : Subgroup G)) = R.subgroupOf (L ⊔ R))
    {a' delta : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) a')
    (hsmall : (Q d.radical a').relIndex (Z d.radical (alpha d.radical)) < 4)
    (hdelta : Adjacent d.radical delta (p.walk.getVert 1))
    (hel : ¬ U d.radical delta ≤ B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _)) :
    ∃ t, Adjacent d.radical (alpha d.radical) t ∧
      ∃ g ∈ stabilizer d.radical (alpha d.radical),
        act d.radical g (p.walk.getVert 1) = t ∧
        Adjacent d.radical (act d.radical g delta) t ∧
        ∃ x ∈ Ltilde d.radical (alpha d.radical),
          x ∈ normalizer (Q d.radical t : Set (FreeAmalgam d.radical)) ∧
          x^3 ∈ Q d.radical (alpha d.radical) ∧
          Q d.radical t ⊔ Z d.radical a' ⊔ Z d.radical (act d.radical x a') =
            stabilizer d.radical (alpha d.radical) ∧
          ∃ z, ∃ q : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) z,
            ((z=a' ∧ ∀ i, q.walk.getVert i=p.walk.getVert i) ∨
              (z=act d.radical x a' ∧ ∀ i, q.walk.getVert i=act d.radical x (p.walk.getVert i))) ∧
            (Q d.radical z).relIndex (Z d.radical (alpha d.radical)) < 4 ∧
            (¬ Z d.radical z ≤ normalizer ((Z d.radical (act d.radical g delta) ⊔
              Z d.radical (alpha d.radical) : Subgroup (FreeAmalgam d.radical)) : Set (FreeAmalgam d.radical))) ∧
            ((∃ v : CriticalPath d.radical (replacementGeometry h d) (act d.radical g delta)
                (q.walk.getVert (q.walk.length-2)), v.walk.getVert 1=t ∧
                ∀ i ≤ q.walk.length-2, v.walk.getVert (i+2)=q.walk.getVert i) ∨
              (Z d.radical (act d.radical g delta) ≤ Q d.radical (q.walk.getVert (q.walk.length-2)) ∧
                let H := ⁅Z d.radical (act d.radical g delta),Z d.radical z ⊓ Q d.radical (alpha d.radical)⁆
                Nat.card H=2 ∧
                H ≤ Z d.radical (act d.radical g delta) ⊓ Z d.radical z ∧
                H ≤ Z d.radical t ⊓ Z d.radical (q.walk.getVert (q.walk.length-1)) ∧
                H ≤ Z d.radical (alpha d.radical) ⊓ Z d.radical (q.walk.getVert (q.walk.length-2)) ∧
                H ≤ centralizer (V d.radical (alpha d.radical) : Set (FreeAmalgam d.radical)) ∧
                ¬ H ≤ centralizer (stabilizer d.radical (act d.radical g delta) : Set (FreeAmalgam d.radical)))) := by
  obtain ⟨t,hat,g,hg,hgt,hct,x,hx,hxN,hx3,hgen,z,q,hq,hqs,hnorm,hcases⟩ :=
    nonsylow_small_backward_edge_obstruction_knownSimple (e := e) (hz := hz) (hn := hn)
      hb4 hns p hsmall hdelta hel
  refine ⟨t,hat,g,hg,hgt,hct,x,hx,hxN,hx3,hgen,z,q,hq,hqs,hnorm,?_⟩
  rcases hcases with hpath | ⟨hbad,hcard,hseed,hedge,hmiddle,hcent,hncent⟩
  · exact Or.inl hpath
  · have hb : 2 < replacementDistance h d := by omega
    let s := fullSymmetricAction_knownSimple h e hz hn d hb
    have hc := DistanceTwo.centralLayer_knownSimple G L R h e hz hn d
    obtain ⟨u,hfull⟩ := nonsylow_four_lt_radical_image_cube_knownSimple
      (e := e) (hz := hz) (hn := hn) hb4 hns
    have hR : d.radical.map s.projection ≤ (D 6).map (MulAut.conj u).toMonoidHom := by
      rw [SourceReduction.fullSymmetricAction_projection_unique h e hz hn d s,hfull]
    have hle := cube_backward_kernel_card_le_two s hc hb u hR q hqs hat hct hbad hnorm
    have he : Nat.card (⁅Z d.radical (act d.radical g delta),Z d.radical z ⊓
        Q d.radical (alpha d.radical)⁆ : Subgroup (FreeAmalgam d.radical)) = 2 := by
      rcases hcard with h2 | h4
      · exact h2
      · omega
    exact Or.inr ⟨hbad,he,hseed,hedge,hmiddle,hcent,hncent⟩

