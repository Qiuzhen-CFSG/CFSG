namespace CubeKernelLine
local notation "ρ" => coreRepresentation (Fin 6)
private def firstWord (i : Fin 3) : C := ![pairWord 2 3,pairWord 0 1,pairWord 0 1] i
private def secondWord (i : Fin 3) : C := ![pairWord 4 5,pairWord 4 5,pairWord 2 3] i

private theorem swaps_in_cube (t : S) (ht : t ∈ D 6) (hs : t.IsSwap) :
    ∃ i : Fin 3, t = pairSwap 6 i := by
  obtain ⟨j,rfl⟩ := (mem_disjointTranspositions_iff (3 : Fin 4) t).mp ht
  have hc : ∀ j : Fin 8, (initialWords 3 j).cycleType = {2} → ∃ i : Fin 3, initialWords 3 j = pairSwap 6 i := by
    decide +kernel
  exact hc j (Equiv.Perm.isSwap_iff_cycleType.mp hs)

private def leftCoord (i : Fin 3) : Fin 6 := ⟨2*i.val,by omega⟩
private def rightCoord (i : Fin 3) : Fin 6 := ⟨2*i.val+1,by omega⟩
private def firstCoord (i : Fin 3) : Fin 6 := ![2,0,0] i
private def secondCoord (i : Fin 3) : Fin 6 := ![4,4,2] i
private theorem cube_pair_action (j : Fin 8) (i : Fin 3) :
    ((initialWords 3 j).symm (leftCoord i)=leftCoord i ∧
      (initialWords 3 j).symm (rightCoord i)=rightCoord i) ∨
    ((initialWords 3 j).symm (leftCoord i)=rightCoord i ∧
      (initialWords 3 j).symm (rightCoord i)=leftCoord i) := by
  have h : ∀ j : Fin 8, ∀ i : Fin 3,
    ((initialWords 3 j).symm (leftCoord i)=leftCoord i ∧
      (initialWords 3 j).symm (rightCoord i)=rightCoord i) ∨
    ((initialWords 3 j).symm (leftCoord i)=rightCoord i ∧
      (initialWords 3 j).symm (rightCoord i)=leftCoord i) := by decide +kernel
  exact h j i

private theorem displacement_certificate
    (i : Fin 3) (j : Fin 8) (v : Full (Fin 6))
    (hv : representation (Fin 6) (pairSwap 6 i) v=v) :
    ∃ a b : ZMod 2, representation (Fin 6) (initialWords 3 j) v-v =
      a • (firstWord i).val + b • (secondWord i).val := by
  let w := representation (Fin 6) (initialWords 3 j) v-v
  have hp (k : Fin 3) : w (leftCoord k)=w (rightCoord k) := by
    change v ((initialWords 3 j).symm (leftCoord k))-v (leftCoord k)=
      v ((initialWords 3 j).symm (rightCoord k))-v (rightCoord k)
    rcases cube_pair_action j k with ⟨h1,h2⟩ | ⟨h1,h2⟩
    · rw [h1,h2,sub_self,sub_self]
    · rw [h1,h2,CharTwo.sub_eq_add,CharTwo.sub_eq_add,add_comm]
  have hvpair : v (rightCoord i)=v (leftCoord i) := by
    have hh := congrFun hv (leftCoord i)
    simpa only [representation_apply,pairSwap,Equiv.symm_swap,Equiv.swap_apply_left,
      leftCoord,rightCoord] using hh
  have hz : w (leftCoord i)=0 := by
    change v ((initialWords 3 j).symm (leftCoord i))-v (leftCoord i)=0
    rcases cube_pair_action j i with ⟨h1,_⟩ | ⟨h1,_⟩
    · rw [h1,sub_self]
    · rw [h1,hvpair,sub_self]
  have h01 : w 0=w 1 := hp 0
  have h23 : w 2=w 3 := hp 1
  have h45 : w 4=w 5 := hp 2
  have he : w=w 0 • (pairWord 0 1).val+w 2 • (pairWord 2 3).val+w 4 • (pairWord 4 5).val := by
    ext k
    fin_cases k <;> simp [pairWord,h01,h23,h45]
  refine ⟨w (firstCoord i),w (secondCoord i),?_⟩
  change w=_
  conv_lhs => rw [he]
  fin_cases i
  · change w 0 • (pairWord 0 1).val+w 2 • (pairWord 2 3).val+w 4 • (pairWord 4 5).val =
      w 2 • (pairWord 2 3).val+w 4 • (pairWord 4 5).val
    have hz0 : w 0=0 := hz
    rw [hz0,zero_smul,zero_add]
  · change w 0 • (pairWord 0 1).val+w 2 • (pairWord 2 3).val+w 4 • (pairWord 4 5).val =
      w 0 • (pairWord 0 1).val+w 4 • (pairWord 4 5).val
    have hz2 : w 2=0 := hz
    rw [hz2,zero_smul,add_zero]
  · change w 0 • (pairWord 0 1).val+w 2 • (pairWord 2 3).val+w 4 • (pairWord 4 5).val =
      w 0 • (pairWord 0 1).val+w 2 • (pairWord 2 3).val
    have hz4 : w 4=0 := hz
    rw [hz4,zero_smul,add_zero]

private theorem core_displacement (i : Fin 3) (g : S) (hg : g ∈ D 6)
    (v : C) (hv : ρ (pairSwap 6 i) v=v) :
    ∃ a b : ZMod 2, ρ g v-v = a • firstWord i+b • secondWord i := by
  obtain ⟨j,rfl⟩ := (mem_disjointTranspositions_iff (3 : Fin 4) g).mp hg
  obtain ⟨a,b,hv⟩ := displacement_certificate i j v.val (congrArg Subtype.val hv)
  exact ⟨a,b,Subtype.ext hv⟩

private theorem whole_displacement (j : Fin 8) (v : C) :
    ∃ a b c : ZMod 2, ρ (initialWords 3 j) v-v =
      a • pairWord 0 1 + b • pairWord 2 3 + c • pairWord 4 5 := by
  let w := ρ (initialWords 3 j) v-v
  have hp (k : Fin 3) : w.val (leftCoord k)=w.val (rightCoord k) := by
    change v.val ((initialWords 3 j).symm (leftCoord k))-v.val (leftCoord k)=
      v.val ((initialWords 3 j).symm (rightCoord k))-v.val (rightCoord k)
    rcases cube_pair_action j k with ⟨h1,h2⟩ | ⟨h1,h2⟩
    · rw [h1,h2,sub_self,sub_self]
    · rw [h1,h2,CharTwo.sub_eq_add,CharTwo.sub_eq_add,add_comm]
  have h01 : w.val 0=w.val 1 := hp 0
  have h23 : w.val 2=w.val 3 := hp 1
  have h45 : w.val 4=w.val 5 := hp 2
  refine ⟨w.val 0,w.val 2,w.val 4,?_⟩
  change w = _
  apply Subtype.ext
  ext k
  fin_cases k <;> simp [pairWord,h01,h23,h45]

private def criticalWord (i : Fin 3) : C := ![pairWord 0 1,pairWord 2 3,pairWord 4 5] i
private def testWord (i : Fin 3) : C := ![pairWord 0 2,pairWord 0 2,pairWord 0 4] i
private theorem critical_displacement (i : Fin 3) :
    ρ (pairSwap 6 i) (testWord i)-testWord i=criticalWord i := by
  apply Subtype.ext
  ext k
  fin_cases i <;> fin_cases k <;> decide +kernel

private theorem core_comparison (u t : S) (P : Subgroup S)
    (hP : P ≤ (D 6).map (MulAut.conj u).toMonoidHom)
    (ht : t ∈ (D 6).map (MulAut.conj u).toMonoidHom) (hs : t.IsSwap)
    (hlarge : 1 < Module.finrank (ZMod 2)
      (subspaceCommutator ρ (fixedSpace ρ (zpowers t)) P)) :
    subspaceCommutator ρ ⊤ P ≤
      subspaceCommutator ρ (fixedSpace ρ (zpowers t)) P ⊔
        subspaceCommutator ρ ⊤ (zpowers t) := by
  obtain ⟨t₀,ht₀,he⟩ := ht
  have hs₀ : t₀.IsSwap := by
    have hh : IsConj t₀ t := isConj_iff.mpr ⟨u,he⟩
    exact Equiv.Perm.isSwap_iff_cycleType.mpr
      ((Equiv.Perm.isConj_iff_cycleType_eq.mp hh).trans (Equiv.Perm.isSwap_iff_cycleType.mp hs))
  obtain ⟨i,rfl⟩ := swaps_in_cube t₀ ht₀ hs₀
  let F := Submodule.span (ZMod 2) {ρ u (firstWord i),ρ u (secondWord i)}
  let K := subspaceCommutator ρ (fixedSpace ρ (zpowers t)) P
  have hKF : K ≤ F := by
    apply Submodule.span_le.mpr
    rintro _ ⟨g,hg,v,hv,rfl⟩
    obtain ⟨k,hk,hkg⟩ := hP hg
    change u*k*u⁻¹=g at hkg
    rw [←hkg]
    let w := ρ u⁻¹ v
    have hw : ρ (pairSwap 6 i) w=w := by
      have hh := (mem_fixedSpace_zpowers_iff _ _ _).mp hv
      rw [←he] at hh
      change ρ (u * pairSwap 6 i * u⁻¹) v = v at hh
      have hh' := congrArg (ρ u⁻¹) hh
      simpa only [map_mul,Module.End.mul_apply,(ρ).inv_self_apply] using hh'
    obtain ⟨a,b,hmove⟩ := core_displacement i k hk w hw
    have heq := congrArg (ρ u) hmove
    rw [map_sub,map_add,map_smul,map_smul] at heq
    have heq' : ρ (u*k*u⁻¹) v-v = a • ρ u (firstWord i)+b • ρ u (secondWord i) := by
      simpa only [w,map_mul,Module.End.mul_apply,(ρ).self_inv_apply] using heq
    rw [heq']
    exact Submodule.add_mem _
      (Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_insert _ _)))
      (Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))))
  have hdim : Module.finrank (ZMod 2) F ≤ 2 := by
    apply (finrank_span_le_card ({ρ u (firstWord i),ρ u (secondWord i)} : Set C) (R := ZMod 2)).trans
    simp only [Set.toFinset_insert,Set.toFinset_singleton]
    exact Finset.card_le_two
  change 1 < Module.finrank (ZMod 2) K at hlarge
  have hFK : F ≤ K := (Submodule.eq_of_le_of_finrank_le hKF (by omega)).ge
  let T := K ⊔ subspaceCommutator ρ ⊤ (zpowers t)
  have hf : ρ u (firstWord i) ∈ T :=
    (show K ≤ T from le_sup_left) (hFK (Submodule.subset_span (Set.mem_insert _ _)))
  have hsnd : ρ u (secondWord i) ∈ T := (show K ≤ T from le_sup_left) (hFK
    (Submodule.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))))
  have hc : ρ u (criticalWord i) ∈ T := by
    apply (show subspaceCommutator ρ ⊤ (zpowers t) ≤ T from le_sup_right)
    have hh : ρ t (ρ u (testWord i))-ρ u (testWord i)=ρ u (criticalWord i) := by
      rw [←he]
      change ρ (u * pairSwap 6 i * u⁻¹) (ρ u (testWord i)) - _ = _
      simpa only [map_mul,Module.End.mul_apply,(ρ).inv_self_apply,←map_sub] using
        congrArg (ρ u) (critical_displacement i)
    rw [←hh]
    exact Submodule.subset_span ⟨t,mem_zpowers t,_,Submodule.mem_top,rfl⟩
  have hp : ρ u (pairWord 0 1) ∈ T ∧ ρ u (pairWord 2 3) ∈ T ∧ ρ u (pairWord 4 5) ∈ T := by
    fin_cases i
    · exact ⟨hc,hf,hsnd⟩
    · exact ⟨hf,hc,hsnd⟩
    · exact ⟨hf,hsnd,hc⟩
  apply Submodule.span_le.mpr
  rintro _ ⟨g,hg,v,_,rfl⟩
  obtain ⟨k,hk,hkg⟩ := hP hg
  obtain ⟨j,rfl⟩ := (mem_disjointTranspositions_iff (3 : Fin 4) k).mp hk
  obtain ⟨a,b,c,hdisp⟩ := whole_displacement j (ρ u⁻¹ v)
  have hh := congrArg (ρ u) hdisp
  have hh' : ρ g v-v=a • ρ u (pairWord 0 1)+b • ρ u (pairWord 2 3)+c • ρ u (pairWord 4 5) := by
    rw [←hkg]
    change ρ (u * initialWords 3 j * u⁻¹) v-v = _
    simpa only [map_mul,Module.End.mul_apply,(ρ).self_inv_apply,map_sub,map_add,map_smul] using hh
  rw [hh']
  exact T.add_mem (T.add_mem (T.smul_mem a hp.1) (T.smul_mem b hp.2.1)) (T.smul_mem c hp.2.2)

private theorem comparison_transport
    {Y W : Type*} [AddCommGroup Y] [Module (ZMod 2) Y]
    [AddCommGroup W] [Module (ZMod 2) W]
    (σ : Representation (ZMod 2) S Y) (τ : Representation (ZMod 2) S W)
    (E : Y ≃ₗ[ZMod 2] W) (hE : ∀ g v, E (σ g v) = τ g (E v))
    (A P : Subgroup S)
    (hmodel : 1 < Module.finrank (ZMod 2) (subspaceCommutator τ (fixedSpace τ A) P) →
      subspaceCommutator τ ⊤ P ≤ subspaceCommutator τ (fixedSpace τ A) P ⊔
        subspaceCommutator τ ⊤ A)
    (hlarge : 1 < Module.finrank (ZMod 2) (subspaceCommutator σ (fixedSpace σ A) P)) :
    subspaceCommutator σ ⊤ P ≤ subspaceCommutator σ (fixedSpace σ A) P ⊔
      subspaceCommutator σ ⊤ A := by
  have hF := fixedSpace_map_equivariant σ τ (MonoidHom.id S) E hE A
  rw [map_id] at hF
  have hK := subspaceCommutator_map_embedding τ σ (MonoidHom.id S) E.toLinearMap
    (fun g v => (hE g v).symm) P (fixedSpace σ A)
  rw [hF,map_id] at hK
  have htop (B : Subgroup S) :
      subspaceCommutator τ ⊤ B = (subspaceCommutator σ ⊤ B).map E.toLinearMap := by
    have hh := subspaceCommutator_map_embedding τ σ (MonoidHom.id S) E.toLinearMap
      (fun g v => (hE g v).symm) B ⊤
    simpa only [map_id,Submodule.map_top,LinearEquiv.range] using hh
  have hdim : 1 < Module.finrank (ZMod 2) (subspaceCommutator τ (fixedSpace τ A) P) := by
    rw [hK,LinearEquiv.finrank_map_eq]
    exact hlarge
  have hh := hmodel hdim
  rw [htop P,hK,htop A,←Submodule.map_sup] at hh
  exact (Submodule.map_le_map_iff_of_injective E.injective _ _).mp hh

/-- On either six-letter cover, a fixed-hyperplane commutator of dimension
at least two, together with the transposition line, contains the full actor
commutator. The actor need only lie in the same conjugate three-pair group. -/
theorem model_comparison {Y : Type*} [AddCommGroup Y] [Module (ZMod 2) Y]
    (σ : Representation (ZMod 2) S Y)
    (hm : SixCover.IsNaturalOrCore σ (MonoidHom.id S))
    (u t : S) (P : Subgroup S)
    (hP : P ≤ (D 6).map (MulAut.conj u).toMonoidHom)
    (ht : t ∈ (D 6).map (MulAut.conj u).toMonoidHom) (hs : t.IsSwap)
    (hlarge : 1 < Module.finrank (ZMod 2)
      (subspaceCommutator σ (fixedSpace σ (zpowers t)) P)) :
    subspaceCommutator σ ⊤ P ≤
      subspaceCommutator σ (fixedSpace σ (zpowers t)) P ⊔
        subspaceCommutator σ ⊤ (zpowers t) := by
  rcases hm with ⟨E,hE⟩ | ⟨E,hE⟩
  · apply comparison_transport σ (naturalRepresentation (Fin 6)) E hE (zpowers t) P _ hlarge
    intro hdim
    have hle := subspaceCommutator_mono_left (naturalRepresentation (Fin 6))
      (show fixedSpace (naturalRepresentation (Fin 6)) (zpowers t) ≤ ⊤ from le_top) P
    have hfull : Module.finrank (ZMod 2) (subspaceCommutator (naturalRepresentation (Fin 6)) ⊤ P) ≤ 2 := by
      have hb : Module.finrank (ZMod 2) (subspaceCommutator (naturalRepresentation (Fin 6)) ⊤
          ((D 6).map (MulAut.conj u).toMonoidHom)) ≤ 2 := by
        rw [NaturalPairing.moved_finrank_eq_fixedCodim,fixedCodim_map_conj,fixedCodim_D.2.2.2]
      have hmono : subspaceCommutator (naturalRepresentation (Fin 6)) ⊤ P ≤
          subspaceCommutator (naturalRepresentation (Fin 6)) ⊤ ((D 6).map (MulAut.conj u).toMonoidHom) := by
        apply Submodule.span_mono
        rintro _ ⟨g,hg,v,hv,rfl⟩
        exact ⟨g,hP hg,v,hv,rfl⟩
      exact (Submodule.finrank_mono hmono).trans hb
    have he := Submodule.eq_of_le_of_finrank_le hle (by omega)
    exact he ▸ le_sup_left
  · exact comparison_transport σ ρ E hE (zpowers t) P
      (core_comparison u t P hP ht hs) hlarge

end CubeKernelLine
