private theorem commutator_sup_bound {H : Type*} [Group H] (A B C D : Subgroup H)
    (hn : A ⊔ B ≤ normalizer (D : Set H)) (hA : ⁅A,C⁆ ≤ D) (hB : ⁅B,C⁆ ≤ D) :
    ⁅A ⊔ B,C⁆ ≤ D := by
  have hle : A ⊔ B ≤ commutatorPreimage (A ⊔ B) C D :=
    sup_le (le_commutatorPreimage le_sup_left hA) (le_commutatorPreimage le_sup_right hB)
  exact (commutator_mono hle le_rfl).trans (commutator_commutatorPreimage_le _ _ _ hn)

/-- The entire radius and its moving subgroup have the same derived group.
The fixed derived group and full residual movement remove the cross terms;
the incident radius is abelian. -/
theorem radius_derived_eq_moving_derived_original
    (geometry : Geometry T) (hb : 2 < geometry.b T)
    (a t : Vertex T) (ha : color T a = false) (hat : Adjacent T a t)
    (hfixed : ⁅V T a,V T a⁆ ≤ fixedCore T a) :
    ⁅V T a,V T a⁆ = ⁅Vcirc T a,Vcirc T a⁆ := by
  let P := Vcirc T a
  let D := ⁅P,P⁆
  have hm : P ≤ V T a := le_normalizer_iff_commutator_le_left.mp
    ((Ltilde_le_stabilizer a).trans (V_normalized a))
  have hVN : V T a ≤ normalizer (D : Set (FreeAmalgam T)) := by
    intro g hg
    have hn := (Vcirc_normalized a) (((geometry.V_le_Q hb a ha) hg).1)
    rw [mem_normalizer_iff_map_conj_eq]
    change (⁅P,P⁆).map (MulAut.conj g).toMonoidHom = ⁅P,P⁆
    have hmap : P.map (MulAut.conj g).toMonoidHom = P :=
      mem_normalizer_iff_map_conj_eq.mp hn
    rw [map_commutator,hmap]
  have hLN : Ltilde T a ≤ normalizer (D : Set (FreeAmalgam T)) := by
    intro g hg
    have hn := Vcirc_normalized a (Ltilde_le_stabilizer a hg)
    rw [mem_normalizer_iff_map_conj_eq]
    change (⁅P,P⁆).map (MulAut.conj g).toMonoidHom = ⁅P,P⁆
    have hmap : P.map (MulAut.conj g).toMonoidHom = P :=
      mem_normalizer_iff_map_conj_eq.mp hn
    rw [map_commutator,hmap]
  have hD : ⁅⁅V T a,V T a⁆,Ltilde T a⁆ = ⊥ :=
    commutator_eq_bot_iff_le_centralizer.mpr (hfixed.trans inf_le_right)
  have hone : ⁅⁅Ltilde T a,V T a⁆,P⁆ ≤ D := by
    rw [commutator_comm (Ltilde T a) (V T a)]
    exact le_rfl
  have htwo : ⁅⁅V T a,P⁆,Ltilde T a⁆ ≤ D :=
    (commutator_mono (commutator_mono le_rfl hm) le_rfl).trans (hD.le.trans bot_le)
  have hPV := commutator_commutator_le_of_rotate_of_le_normalizer
    (hm.trans hVN) hLN hVN hone htwo
  rw [show ⁅P,Ltilde T a⁆ = P from moving_full_commutation_original h geometry hb a ha] at hPV
  have hE := edge_radius_le_radius ha hat
  have hPE : ⁅P,V T t⁆ ≤ D := (commutator_mono le_rfl hE).trans hPV
  have hEE : ⁅V T t,V T t⁆ ≤ D :=
    (commutator_eq_bot_iff_le_centralizer.mpr
      (le_centralizer_iff_isMulCommutative.mpr (edge_radius_commutative geometry hb a t ha hat))).le.trans bot_le
  have hEV : ⁅V T t,V T a⁆ ≤ D := by
    rw [commutator_comm,radius_eq_moving_sup_edge_original h ha hat]
    exact commutator_sup_bound _ _ _ _
      ((radius_eq_moving_sup_edge_original h ha hat).symm ▸ hVN) hPE hEE
  apply le_antisymm _ (commutator_mono hm hm)
  exact (congrArg (fun S : Subgroup (FreeAmalgam T) => ⁅S,V T a⁆)
    (radius_eq_moving_sup_edge_original h ha hat)).le.trans
    (commutator_sup_bound _ _ _ _
      ((radius_eq_moving_sup_edge_original h ha hat).symm ▸ hVN) hPV hEV)

/-- Abelian moving radius implies abelian full radius, using the actual
incident radical for generation and the fixed derived subgroup. -/
theorem radius_commutative_of_moving_commutative_original
    (geometry : Geometry T) (hb : 2 < geometry.b T)
    (a t : Vertex T) (ha : color T a = false) (hat : Adjacent T a t)
    (hfixed : ⁅V T a,V T a⁆ ≤ fixedCore T a)
    (hcomm : IsMulCommutative (Vcirc T a)) : IsMulCommutative (V T a) := by
  apply le_centralizer_iff_isMulCommutative.mp
  apply commutator_eq_bot_iff_le_centralizer.mp
  rw [radius_derived_eq_moving_derived_original h geometry hb a t ha hat hfixed]
  exact commutator_eq_bot_iff_le_centralizer.mpr
    (le_centralizer_iff_isMulCommutative.mpr hcomm)

