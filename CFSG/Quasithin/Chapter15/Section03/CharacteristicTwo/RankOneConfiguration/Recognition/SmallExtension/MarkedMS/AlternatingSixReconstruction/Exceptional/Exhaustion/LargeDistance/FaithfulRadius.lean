private theorem fixedSpace_subgroup_index {G D : Type*} [Group G] [Group D]
    [IsElementaryAbelian 2 D] [Finite D] (action : G →* MulAut D) (A : Subgroup G) :
    (Subgroup.toAddSubgroup.symm
      (fixedSpace (Offenders.linearize action) A).toAddSubgroup).index =
      2 ^ fixedCodim (Offenders.linearize action) A := by
  let ρ := Offenders.linearize action
  let C := Subgroup.toAddSubgroup.symm (fixedSpace ρ A).toAddSubgroup
  let e : fixedSpace ρ A ≃ C := {
    toFun := fun v => ⟨v.val.toMul, v.property⟩
    invFun := fun x => ⟨Additive.ofMul x.val, x.property⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl }
  have hC : Nat.card C = 2 ^ Module.finrank (ZMod 2) (fixedSpace ρ A) := by
    have hf := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := fixedSpace ρ A)
    rw [Nat.card_zmod] at hf
    exact (Nat.card_congr e).symm.trans hf
  have hT : Nat.card D = 2 ^ Module.finrank (ZMod 2) (Additive D) :=
    (Module.natCard_eq_pow_finrank (K := ZMod 2) (V := Additive D)).trans (by rw [Nat.card_zmod])
  have hdim := fixedCodim_add_finrank ρ A
  have hmul := C.card_mul_index
  rw [hC, hT, ← hdim, pow_add, Nat.mul_comm (2 ^ fixedCodim ρ A)] at hmul
  exact Nat.eq_of_mul_eq_mul_left (by positivity) hmul

/-- Centralization modulo X bounds displacement on the actual moving central quotient. -/
theorem moving_fixedCodim_pow_le_radius_index_X (geometry : Geometry T)
    (hb : 2 < geometry.b T) (a : Vertex T) (ha : color T a = false)
    (hfixed : ⁅V T a, V T a⁆ ≤ fixedCore T a)
    (E K : Subgroup (FreeAmalgam T))
    (hcomm : ⁅V T a ⊓ K, E⁆ ≤ X T a) :
    letI := moving_central_quotient_elementary geometry (by omega) a ha hfixed
    2 ^ fixedCodim (Offenders.linearize (movingQuotientAction a))
      (E.subgroupOf (stabilizer T a)) ≤ K.relIndex (V T a) := by
  let := moving_central_quotient_elementary geometry (by omega) a ha hfixed
  let := finite_moving geometry hb a ha
  let P := Vcirc T a
  let q := QuotientGroup.mk' (center P)
  let ρ := Offenders.linearize (movingQuotientAction a)
  let A := E.subgroupOf (stabilizer T a)
  let C := Subgroup.toAddSubgroup.symm (fixedSpace ρ A).toAddSubgroup
  have hPV : P ≤ V T a := le_normalizer_iff_commutator_le_left.mp
    ((Ltilde_le_stabilizer a).trans (V_normalized a))
  have hVQ := geometry.V_le_Q hb a ha
  let := finite_stabilizer T a
  let : Finite (V T a) := Finite.of_injective
    (inclusion (hVQ.trans (fun _ hx => hx.1))) (inclusion_injective _)
  have hZC : X T a ≤ centralizer (P : Set (FreeAmalgam T)) :=
    (le_centralizer_iff.mp (Q_le_centralizer_X T a)).trans
      (centralizer_le (hPV.trans hVQ))
  have hKC : K.subgroupOf P ≤ C.comap q := by
    intro p hp e
    have he : (e.val : FreeAmalgam T) ∈ E := e.property
    let d : P := movingAction a e.val p * p⁻¹
    have hd : (d : FreeAmalgam T) ∈ X T a := by
      have hcomm' : ⁅E, V T a ⊓ K⁆ ≤ X T a := by rwa [commutator_comm]
      exact hcomm' (commutator_mem_commutator he ⟨hPV p.property, hp⟩)
    have hdC : d ∈ center P := by
      apply mem_center_iff.mpr
      intro v
      apply Subtype.ext
      exact hZC hd v v.property
    change Additive.ofMul (movingQuotientAction a e.val (q p)) = Additive.ofMul (q p)
    apply congrArg Additive.ofMul
    rw [movingQuotientAction_apply]
    apply QuotientGroup.eq_iff_div_mem.mpr
    simpa only [div_eq_mul_inv] using hdC
  have hindex : C.index ≤ (K.subgroupOf P).index := by
    rw [← C.index_comap_of_surjective (QuotientGroup.mk'_surjective (center P))]
    exact Nat.le_of_dvd (Nat.pos_of_ne_zero (K.subgroupOf P).index_ne_zero_of_finite)
      (index_dvd_of_le hKC)
  rw [fixedSpace_subgroup_index] at hindex
  exact hindex.trans (relIndex_le_of_le_right hPV (K.subgroupOf (V T a)).index_ne_zero_of_finite)

include h e hz hk

/-- The actual critical endpoint moves at most two dimensions on the moving
radius central quotient. The original two-core action has not been discarded. -/
theorem faithful_moving_fixedCodim_le_two
    (hb : 2 < sourceDistance h)
    (a : Vertex T) (ha : color T a = false) (b : Vertex T)
    (hc : CriticalPair T a b ((sourceGeometry h).exists_critical a ha))
    (c : Vertex T) (hcColor : color T c = false)
    (hac : (cosetGraph T).dist a c = 2) (hcb : (cosetGraph T).dist c b = 2) :
    letI := moving_central_quotient_elementary (sourceGeometry h) (sourceDistance_pos h)
      a ha (faithful_radius_derived_le_fixed h e hz hk hb a ha)
    fixedCodim (Offenders.linearize (movingQuotientAction a))
      ((X T b).subgroupOf (stabilizer T a)) ≤ 2 := by
  let := moving_central_quotient_elementary (sourceGeometry h) (sourceDistance_pos h)
    a ha (faithful_radius_derived_le_fixed h e hz hk hb a ha)
  have hi := moving_fixedCodim_pow_le_radius_index_X (sourceGeometry h) hb a ha
    (faithful_radius_derived_le_fixed h e hz hk hb a ha) (X T b) (Q T c)
    ((faithful_radius_intersection_X h e hz hk hb a ha b hc c hac hcb).trans
      ((critical_X_commutator_le h e a ha b hc).trans inf_le_left))
  have hh := hi.trans (faithful_radius_index_le_four h e hz hk hb a ha b hc c hcColor hac hcb)
  exact (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp hh

