/-- The original residual and the incident radical generate the whole vertex;
this does not identify the radical with a Sylow subgroup or with Q. -/
theorem residual_edge_generation {a t : Vertex T}
    (ha : color T a = false) (hat : Adjacent T a t) :
    Ltilde T a ⊔ Q T t = stabilizer T a := by
  have hbase : Ltilde T (alpha T) ⊔ Q T (beta T) = stabilizer T (alpha T) := by
    rw [Ltilde_alpha,h.relative_residual,Q_beta,←Subgroup.map_sup,
      (codisjoint_subgroupOf_sup L R).eq_top]
    exact (MonoidHom.range_eq_map (embedM T)).symm.trans (stabilizer_m_base T).symm
  obtain ⟨g,hg | hg⟩ := (adjacent_iff_exists_common T a t).mp hat
  · rcases hg with ⟨rfl,rfl⟩
    have he := congrArg (Subgroup.map (MulAut.conj g⁻¹).toMonoidHom) hbase
    rw [Subgroup.map_sup,←Ltilde_act,←Q_act,←stabilizer_act] at he
    simpa only [alpha,beta,act_mVertex,act_hVertex,one_mul] using he
  · rw [hg.1] at ha
    cases ha

