private theorem normalizes_sup_of_commutator_le {G : Type*} [Group G]
    (A B K : Subgroup G) (hKA : K ≤ normalizer (A : Set G))
    (hc : ⁅B, K⁆ ≤ A) : K ≤ normalizer (A ⊔ B : Subgroup G) := by
  apply le_normalizer_iff.mpr
  intro k hk x hx
  have hm : (A ⊔ B).map (MulAut.conj k).toMonoidHom ≤ A ⊔ B := by
    rw [Subgroup.map_sup]
    apply sup_le
    · exact (mem_normalizer_iff_map_conj_eq.mp (hKA hk)).le.trans le_sup_left
    · rintro _ ⟨b, hb, rfl⟩
      have hcb : ⁅k, b⁆ ∈ A := by
        rw [commutator_comm] at hc
        exact hc (commutator_mem_commutator hk hb)
      have h := (A ⊔ B).mul_mem (mem_sup_left hcb) (mem_sup_right hb)
      simpa [commutatorElement_def, mul_assoc] using h
  exact hm (mem_map_of_mem (MulAut.conj k).toMonoidHom hx)

include h

/-- The moving radius and any incident radius generate the entire radius. -/
theorem radius_eq_moving_sup_edge_original
    {a t : Vertex T} (ha : color T a = false) (hat : Adjacent T a t) :
    V T a = Vcirc T a ⊔ V T t := by
  have htV := edge_radius_le_radius ha hat
  have hn : stabilizer T a ≤ normalizer (Vcirc T a ⊔ V T t : Subgroup (FreeAmalgam T)) := by
    rw [← residual_edge_generation h ha hat]
    apply sup_le
    · exact normalizes_sup_of_commutator_le _ _ _
        ((Ltilde_le_stabilizer a).trans (Vcirc_normalized a))
        (commutator_mono htV le_rfl)
    · exact (le_inf
        ((show Q T t ≤ stabilizer T a from CriticalCriterion.edge_le_stabilizer T ha hat).trans (Vcirc_normalized a))
        ((show Q T t ≤ stabilizer T t from fun _ hx => hx.1).trans (V_normalized t))).trans
        (normalizer_inf_normalizer_le_normalizer_sup _ _)
  have hmov : Vcirc T a ≤ V T a := le_normalizer_iff_commutator_le_left.mp
    ((Ltilde_le_stabilizer a).trans (V_normalized a))
  apply le_antisymm _ (sup_le hmov htV)
  apply radius_le_of_m_ball ha
  intro d hd hdist
  by_cases hda : d = a
  · subst d
    apply (show Z T a ≤ V T t from ?_).trans le_sup_right
    apply le_iSup_of_le a
    exact le_iSup_of_le
      (show (cosetGraph T).dist a t ≤ 2 from
        (SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj T _ _).mpr hat)).le.trans (by decide)) le_rfl
  have htwo : (cosetGraph T).dist a d = 2 := by
    have hne : (cosetGraph T).dist a d ≠ 0 := by
      intro hz
      exact hda ((cosetGraph_connected T).dist_eq_zero_iff.mp hz).symm
    have heven : Even ((cosetGraph T).dist a d) := by
      obtain ⟨w, hw⟩ := (cosetGraph_connected T).exists_walk_length_eq_dist a d
      rw [← hw, walk_even_iff_color_eq, ha, hd]
    rw [Nat.even_iff] at heven
    rw [SimpleGraph.dist_comm] at hdist
    omega
  obtain ⟨u, hau, hdu⟩ := exists_common_neighbor_of_dist_two T a d htwo
  obtain ⟨g, hg, hgu⟩ := stabilizer_transitive_neighbors T a hat hau
  have hVu : V T u ≤ Vcirc T a ⊔ V T t := by
    rw [← hgu, V_act]
    exact (map_mono (show V T t ≤ Vcirc T a ⊔ V T t from le_sup_right)).trans
      (mem_normalizer_iff_map_conj_eq.mp (hn ((stabilizer T a).inv_mem hg))).le
  apply (show Z T d ≤ V T u from ?_).trans hVu
  apply le_iSup_of_le d
  exact le_iSup_of_le
    (show (cosetGraph T).dist d u ≤ 2 from
      (SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj T _ _).mpr hdu)).le.trans (by decide)) le_rfl

/-- The original finite two-group radius is fully moved after one residual commutator. -/
theorem moving_full_commutation_original (geometry : Geometry T)
    (hb : 2 < geometry.b T) (a : Vertex T) (ha : color T a = false) :
    ⁅Vcirc T a, Ltilde T a⁆ = Vcirc T a := by
  let S := stabilizer T a
  let W := (V T a).subgroupOf S
  let := finite_stabilizer T a
  let : W.Normal := normal_subgroupOf_of_le_normalizer (V_normalized a)
  have hV : V T a ≤ S := (geometry.V_le_Q hb a ha).trans (fun _ hx => hx.1)
  have hid := commutator_isPPerfect_idempotent (pResidual 2 S) W
    (isPPerfect_pResidual 2) ((Q_isPGroup T h.relative_radical.isPGroup h.relative_radical.twoCore_le a ha).to_le
      (geometry.V_le_Q hb a ha)).comap_subtype
    le_normalizer_of_normal
  have hh := congrArg (Subgroup.map S.subtype) hid
  have hW : W.map S.subtype = V T a := map_subgroupOf_eq_of_le hV
  simpa only [map_commutator, hW, Ltilde, Vcirc] using hh

/-- Full movement survives the literal quotient by the moving subgroup's center. -/
theorem movingQuotientAction_full_original
    (geometry : Geometry T) (hb : 2 < geometry.b T)
    (a : Vertex T) (ha : color T a = false)
    (hfixed : ⁅V T a, V T a⁆ ≤ fixedCore T a) :
    letI := moving_central_quotient_elementary geometry (by omega) a ha hfixed
    subspaceCommutator (Offenders.linearize (movingQuotientAction a))
      ⊤ (pResidual 2 (stabilizer T a)) = ⊤ := by
  let := moving_central_quotient_elementary geometry (by omega) a ha hfixed
  let P := Vcirc T a
  let q := QuotientGroup.mk' (center P)
  let ρ := Offenders.linearize (movingQuotientAction a)
  let W := subspaceCommutator ρ ⊤ (pResidual 2 (stabilizer T a))
  let J : Subgroup (P ⧸ center P) := Subgroup.toAddSubgroup.symm W.toAddSubgroup
  have hP : P ≤ (J.comap q).map P.subtype := by
    change Vcirc T a ≤ _
    conv_lhs => rw [← moving_full_commutation_original h geometry hb a ha, commutator_comm]
    apply commutator_le.mpr
    intro l hl v hv
    obtain ⟨g, hg, rfl⟩ := hl
    let vP : P := ⟨v, hv⟩
    refine ⟨movingAction a g vP * vP⁻¹, ?_, ?_⟩
    · change Additive.ofMul (q (movingAction a g vP * vP⁻¹)) ∈ W
      have hh : ρ g (Additive.ofMul (q vP)) - Additive.ofMul (q vP) ∈ W :=
        Submodule.subset_span ⟨g, hg, Additive.ofMul (q vP), Submodule.mem_top, rfl⟩
      simp only [ρ, Offenders.linearize, sub_eq_add_neg] at hh
      change Additive.ofMul (movingQuotientAction a g (q vP) * (q vP)⁻¹) ∈ W at hh
      rw [movingQuotientAction_apply] at hh
      simpa only [map_mul, map_inv] using hh
    · change (movingAction a g vP : FreeAmalgam T) * v⁻¹ = _
      rw [movingAction_apply]
      rfl
  apply top_unique
  intro v _
  obtain ⟨p, hp⟩ := QuotientGroup.mk'_surjective (center P) v.toMul
  obtain ⟨w, hw, he⟩ := hP p.property
  have he' : w = p := Subtype.ext he
  subst w
  change Additive.ofMul (q p) ∈ W at hw
  change q p = v.toMul at hp
  rw [hp] at hw
  exact hw

