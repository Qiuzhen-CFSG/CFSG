/-- A nonabelian midpoint retains a nonzero moving central quotient. -/
theorem faithful_moving_not_commutative
    (hb : 2 < sourceDistance h) (a : Vertex T) (ha : color T a = false)
    (hV : ¬ IsMulCommutative (V T a)) : ¬ IsMulCommutative (Vcirc T a) := by
  intro hP
  obtain ⟨g,hga⟩ := exists_mVertex_of_color T ha
  let t := hVertex T g
  have hat : Adjacent T a t := (adjacent_iff_exists_common T a t).mpr ⟨g,Or.inl ⟨hga,rfl⟩⟩
  exact hV (radius_commutative_of_moving_commutative_original h (sourceGeometry h) hb a t ha hat
    (faithful_radius_derived_le_fixed h e hz hk hb a ha) hP)

