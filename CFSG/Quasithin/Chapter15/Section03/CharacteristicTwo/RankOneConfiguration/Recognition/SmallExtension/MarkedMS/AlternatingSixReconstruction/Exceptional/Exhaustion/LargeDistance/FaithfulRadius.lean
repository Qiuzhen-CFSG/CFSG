/-- The remaining representation data live on the literal central quotient
of a moving radius, with its original vertex actor and hexacode marking. -/
def FaithfulMovingSection (h : SmallMSPair KnownSimple.IsKnownSimple L R) : Prop :=
  2 < sourceDistance h ∧
  ∃ (a : Vertex T) (ha : color T a = false) (b : Vertex T),
    CriticalPair T a b ((sourceGeometry h).exists_critical a ha) ∧
    ∃ he : IsElementaryAbelian 2 ((Vcirc T a) ⧸ center (Vcirc T a)),
      letI := he
      let ρ := Offenders.linearize (movingQuotientAction a)
      ∃ chart : HexacodeChart (L := L) (R := R) a,
        let A := (X T b).subgroupOf (stabilizer T a)
        IsElementaryAbelian 2 A ∧ Nat.card (A.map chart.projection) = 4 ∧
        IsBestOffender Hexacode.action (A.map chart.projection) ∧
        fixedCodim ρ A ≤ 2 ∧ IsOffender ρ A ∧
        subspaceCommutator ρ ⊤ (pResidual 2 (stabilizer T a)) = ⊤ ∧
        ∃ B : LinearMap.BilinForm (ZMod 2) (Additive ((Vcirc T a) ⧸ center (Vcirc T a))),
          B ≠ 0 ∧ B.IsAlt ∧
          ∀ (g : stabilizer T a), g ∈ pResidual 2 (stabilizer T a) → ∀ v w,
            B (ρ g v) (ρ g w) = B v w

/-- Every larger faithful distance supplies the complete actual FF section:
its endpoint has image four, moves at most two dimensions, and the fully
moved central quotient carries a nonzero residual-invariant alternating form. -/
theorem faithful_moving_section (hb : 2 < sourceDistance h) :
    FaithfulMovingSection h := by
  obtain ⟨a,ha,hV,hfixed⟩ := faithful_nonabelian_radius h e hz hk hb
  let he := moving_central_quotient_elementary (sourceGeometry h) (sourceDistance_pos h) a ha hfixed
  let := he
  obtain ⟨b,hcrit⟩ := criticalPair_exists T a ((sourceGeometry h).exists_critical a ha)
  let p := DistanceEight.PathCentrality.CriticalPath.ofPair (geometry := sourceGeometry h) ha hcrit
  have hl : p.walk.length = 4 := p.length_eq_b.trans (faithful_distance_eq_four h e hz hk hb)
  have hle : 2 ≤ p.walk.length := by omega
  let c := p.walk.getVert 2
  have hc : color T c = false := (p.vertex_color hle).mpr (by decide)
  have hac : (cosetGraph T).dist a c = 2 := p.dist_start hle
  have hcb : (cosetGraph T).dist c b = 2 := by rw [p.dist_end,hl]
  obtain ⟨chart⟩ := hexacodeChart_nonempty h e hz hk a ha
  let A := (X T b).subgroupOf (stabilizer T a)
  let : IsElementaryAbelian 2 (X T b) := omegaCenter_elementary _
  let : IsElementaryAbelian 2 A := IsElementaryAbelian.comap_of_injective
    (stabilizer T a).subtype (stabilizer T a).subtype_injective _
  have hbest : IsBestOffender Hexacode.action (A.map chart.projection) :=
    chart.critical_best h e hz hk ha b hcrit
  have hcard : Nat.card (A.map chart.projection) = 4 := Hexacode.bestOffender_card _ hbest
  have hcost := faithful_moving_fixedCodim_le_two h e hz hk hb a ha b hcrit c hc hac hcb
  let := finite_stabilizer T a
  have hcardle : 4 ≤ Nat.card A := by
    rw [←hcard]
    apply Nat.card_le_card_of_surjective
      (fun x : A => (⟨chart.projection x,mem_map_of_mem _ x.property⟩ : A.map chart.projection))
    rintro ⟨y,x,hx,rfl⟩
    exact ⟨⟨x,hx⟩,rfl⟩
  have hrank : 2 ≤ rank A := Nat.le_log_of_pow_le (by decide : 1 < 2) hcardle
  have hne : A ≠ ⊥ := by
    intro hbot
    rw [hbot,Nat.card_unique] at hcardle
    omega
  refine ⟨hb,a,ha,b,hcrit,he,chart,inferInstance,hcard,hbest,hcost,⟨⟨hne,inferInstance⟩,hcost.trans hrank⟩,
    movingQuotientAction_full_original h (sourceGeometry h) hb a ha hfixed,?_⟩
  exact moving_nonzero_invariant_form (sourceGeometry h) (sourceDistance_pos h) a ha hfixed
    (faithful_moving_not_commutative h e hz hk hb a ha hV)

/-- Exhaustion of the entire intrinsic core or the remaining marked radius
representation. The latter is constructed, not assumed, and stays with this owner. -/
theorem faithful_coreExhaustion_or_moving_section :
    CoreExhaustion L R ∨ FaithfulMovingSection h := by
  by_cases hb : 2 < sourceDistance h
  · exact Or.inr (faithful_moving_section h e hz hk hb)
  · exact Or.inl (coreExhaustion_of_distanceTwo h e hz
      (sourceDistance_eq_two h (Nat.le_of_not_gt hb)))

/-- The literal C.1.32 consumer with the same outstanding representation branch. -/
theorem faithful_rankTwo_or_moving_section :
    RankTwoAlternatives L R ∨ FaithfulMovingSection h :=
  (faithful_coreExhaustion_or_moving_section h e hz hk).imp (rankTwo_of_exhaustion h e hz) id

