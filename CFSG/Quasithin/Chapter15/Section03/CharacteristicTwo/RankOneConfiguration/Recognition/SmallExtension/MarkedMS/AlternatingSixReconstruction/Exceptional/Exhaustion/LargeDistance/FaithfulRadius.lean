/-- A nonabelian moving radius has a nonzero alternating commutator form
fixed by its actual two-residual. -/
theorem moving_nonzero_invariant_form
    (geometry : Geometry T) (hb : 0 < geometry.b T)
    (a : Vertex T) (ha : color T a = false)
    (hfixed : ⁅V T a,V T a⁆ ≤ fixedCore T a)
    (hP : ¬ IsMulCommutative (Vcirc T a)) :
    letI := moving_central_quotient_elementary geometry hb a ha hfixed
    ∃ B : LinearMap.BilinForm (ZMod 2) (Additive ((Vcirc T a) ⧸ center (Vcirc T a))),
      B ≠ 0 ∧ B.IsAlt ∧
      ∀ (g : stabilizer T a), g ∈ pResidual 2 (stabilizer T a) → ∀ v w,
        B (Additive.ofMul (movingQuotientAction a g v.toMul))
          (Additive.ofMul (movingQuotientAction a g w.toMul)) = B v w := by
  let := moving_central_quotient_elementary geometry hb a ha hfixed
  obtain ⟨forms,halt,hsep,hinv⟩ := movingQuotient_separating_forms geometry hb a ha hfixed
  by_contra hno
  have hzero (B : LinearMap.BilinForm (ZMod 2)
      (Additive ((Vcirc T a) ⧸ center (Vcirc T a)))) (hB : B ∈ forms) : B = 0 := by
    by_contra hn
    exact hno ⟨B,hn,halt B hB,fun g hg v w => hinv g hg B hB v w⟩
  have hvzero (v : Additive ((Vcirc T a) ⧸ center (Vcirc T a))) : v = 0 := by
    apply hsep v
    intro B hB w
    rw [hzero B hB]
    rfl
  apply hP
  refine ⟨⟨fun x y => ?_⟩⟩
  have hx0 := hvzero (Additive.ofMul (QuotientGroup.mk' (center (Vcirc T a)) x))
  have hxq : QuotientGroup.mk' (center (Vcirc T a)) x = 1 := congrArg Additive.toMul hx0
  exact (mem_center_iff.mp ((QuotientGroup.eq_one_iff x).mp hxq) y).symm

