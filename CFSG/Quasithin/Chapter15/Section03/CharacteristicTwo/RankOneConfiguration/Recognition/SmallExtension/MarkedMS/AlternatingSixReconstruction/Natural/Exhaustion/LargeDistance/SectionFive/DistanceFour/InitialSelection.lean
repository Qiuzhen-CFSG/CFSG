module
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.SmallExtension.MarkedMS.AlternatingSixReconstruction.Natural.Exhaustion.LargeDistance.SectionFive.DistanceFour.LargeImage
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.SmallExtension.MarkedMS.AlternatingSixReconstruction.Natural.Exhaustion.LargeDistance.SectionFive.DistanceFour.Selection
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.SmallExtension.MarkedMS.AlternatingSixReconstruction.Natural.Exhaustion.LargeDistance.SectionFive.ConsecutiveSlices

/-!
# Initial selection and the remaining small critical images at distance four

In the full point-core branch, two consecutive small slices give a nonabelian
selected span. If the predecessor slice is large, the actual forward extension
retains that slice as its first slice; transport to the original base and the
large-slice derived calculation give nonabelianness. Reciprocal selection then
supplies a nonabelian large-slice path. This proves the initial selection for
both moving covers, including the order-thirty-two central attachment.

For an arbitrary radical image, absence of such a selection forces every
critical image to have order two. Every nontrivial seed image in a nearby
whole radius is consequently generated by a transposition. A two-subgroup of
S₆ generated by transpositions lies in a conjugate of the subgroup generated
by three disjoint transpositions: conjugate into the canonical Sylow subgroup
and check its sixteen elements. Applying this to all full radius generators
bounds the entire nearby radius image, without identifying it with the image
of the radical.

The final application combines these results on the literal minimum
characteristic replacement. The remaining alternative has no full point-core
radical image, has both critical indices equal to two, and has the proved
cube bound on every nearby whole radius image. Excluding this alternative is
still required for initial selection in all cases. The selected terminal
argument and final DistanceFourInput assembly remain separate obligations.

Source: Meierfrankenfeld--Stellmacher, *Pushing up weak BN-pairs of rank two*
(1993), (5.8) and (5.12), printed pp.919--920 and 924--927. The full point-core
argument combines the proved original-cover consecutive-slice, forward-path,
and derived-span calculations. The cube bound uses the same small critical
transposition theorem on each full seed and the original symmetric projection.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped commutatorElement Pointwise
open CFSG.Quasithin.ChapterC.BinaryMS.MS93 Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality
open CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup
open CFSG.Quasithin.ChapterB.Offenders CFSG.Quasithin.ChapterB.Offenders.Six
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS
namespace AlternatingSixReconstruction.Natural.Exhaustion.LargeDistance.SectionFive.DistanceFour
universe u
private theorem swap_sylow_certificate : ∀ k : Fin 16,
    (sylowWords k).support.card = 2 →
      ∃ i : Fin 8, dWords i = sylowWords k := by decide +kernel

private theorem generated_transpositions_le_cube
    (B : Subgroup (Equiv.Perm (Fin 6))) (hB : IsPGroup 2 B)
    {I : Sort*} (A : I → Subgroup (Equiv.Perm (Fin 6)))
    (hgen : B = ⨆ i, A i)
    (hA : ∀ i, A i = ⊥ ∨ ∃ t : Equiv.Perm (Fin 6), t.IsSwap ∧ A i = zpowers t) :
    ∃ g : Equiv.Perm (Fin 6), B ≤ (D 6).map (MulAut.conj g).toMonoidHom := by
  obtain ⟨P,hBP⟩ := hB.exists_le_sylow
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq (Equiv.Perm (Fin 6)) P sylow
  let f := (MulAut.conj g).toMonoidHom
  have hBs : B.map f ≤ sylowCarrier := by
    rintro _ ⟨b,hb,rfl⟩
    change (MulAut.conj g) b ∈ (sylow : Subgroup (Equiv.Perm (Fin 6)))
    rw [←hg]
    exact mem_map_of_mem f (hBP hb)
  have hcube : B.map f ≤ D 6 := by
    rw [hgen,Subgroup.map_iSup]
    apply iSup_le
    intro i
    rcases hA i with hi | ⟨t,ht,hi⟩
    · rw [hi,Subgroup.map_bot]
      exact bot_le
    · rw [hi,MonoidHom.map_zpowers]
      apply zpowers_le.mpr
      have htB : t ∈ B := (hgen ▸ le_iSup A i) (hi ▸ mem_zpowers t)
      obtain ⟨k,hk⟩ := (mem_sylowCarrier_iff _).mp (hBs (mem_map_of_mem f htB))
      have hcard : (f t).support.card = 2 := by
        change (g*t*g⁻¹).support.card = 2
        rw [Equiv.Perm.card_support_conj]
        exact Equiv.Perm.card_support_eq_two.mpr ht
      obtain ⟨j,hj⟩ := swap_sylow_certificate k (by rwa [hk])
      exact (mem_disjointTranspositions_iff (3 : Fin 4) _).mpr ⟨j,hj.trans hk⟩
  refine ⟨g⁻¹,?_⟩
  have hm := map_mono (f := (MulAut.conj g⁻¹).toMonoidHom) hcube
  have hid : (MulAut.conj g⁻¹).toMonoidHom.comp f =
      MonoidHom.id (Equiv.Perm (Fin 6)) := by
    ext x
    simp [f,MulAut.conj_apply,mul_assoc]
  rwa [map_map,hid,map_id] at hm

variable {G : Type u} [Group G] [Finite G] {L R : Subgroup G}
  {h : SmallMSPair KnownSimple.IsKnownSimple L R} {e : CentralMarking L}
  {hz : center (L ⧸ pCore 2 L) = ⊥} {hn : InitialNatural h e hz}
  {d : Replacement L R} (s : FullSymmetricAction h e hz hn d)

include s in
/-- If every critical image from the base is small, the full image of each
nearby radius is contained in one conjugate of the three-transposition group. -/
theorem radius_image_le_cube_of_small_critical_images
    (hc : DistanceTwo.CentralLayer d) (hb : replacementDistance h d = 4)
    (hsmall : ∀ z, ∀ _p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) z,
      (Q d.radical z).relIndex (Z d.radical (alpha d.radical)) < 4)
    (a : Vertex d.radical) (ha : color d.radical a = false)
    (hd : (cosetGraph d.radical).dist a (alpha d.radical) ≤ 2) :
    ∃ g : Equiv.Perm (Fin 6),
      graphImage s (V d.radical a) ≤ (D 6).map (MulAut.conj g).toMonoidHom := by
  have hb2 : 2 < replacementDistance h d := by omega
  have hVaQ : V d.radical a ≤ Q d.radical a := V_le_Q d.radical ha hb2
  have hVbase : V d.radical a ≤ stabilizer d.radical (alpha d.radical) := by
    apply (V_le_iff d.radical ha _).mpr
    intro z hz hza
    apply Z_le_stabilizer_of_dist_le z ((replacementGeometry h d).exists_critical z hz)
    rw [(replacementGeometry h d).distance_constant z hz]
    have ht := (cosetGraph_connected d.radical).dist_triangle (u := z) (v := a) (w := alpha d.radical)
    change (cosetGraph d.radical).dist z (alpha d.radical) ≤ replacementDistance h d
    omega
  let I := {z : Vertex d.radical // color d.radical z = false ∧
    (cosetGraph d.radical).dist z a ≤ 2}
  have hV : V d.radical a = ⨆ z : I, Z d.radical z.val := by
    apply le_antisymm
    · apply (V_le_iff d.radical ha _).mpr
      intro z hz hza
      exact le_iSup_of_le (⟨z,hz,hza⟩ : I) le_rfl
    · exact iSup_le fun z => le_iSup_of_le z.val (le_iSup_of_le z.property.2 le_rfl)
  have hseed (z : I) : Z d.radical z.val ≤ V d.radical a :=
    hV ▸ le_iSup (fun z : I => Z d.radical z.val) z
  have hm (z : I) : ((Z d.radical z.val).comap (embedM d.radical)).map (embedM d.radical) =
      Z d.radical z.val := map_comap_eq_self ((hseed z).trans hVbase |>.trans_eq (stabilizer_m_base d.radical))
  have hgen : graphImage s (V d.radical a) = ⨆ z : I, graphImage s (Z d.radical z.val) := by
    have hcmap : (V d.radical a).comap (embedM d.radical) =
        ⨆ z : I, (Z d.radical z.val).comap (embedM d.radical) := by
      apply map_injective (embedM_injective d.radical)
      rw [Subgroup.map_iSup]
      simp only [hm]
      rw [map_comap_eq_self (hVbase.trans_eq (stabilizer_m_base d.radical)),hV]
    change ((V d.radical a).comap (embedM d.radical)).map s.projection = _
    rw [hcmap,Subgroup.map_iSup]
    rfl
  have hP : IsPGroup 2 (graphImage s (V d.radical a)) :=
    (((Q_isPGroup d.radical (replacement_radical_isPGroup h d)
      (replacement_core_le_radical h d) a ha).to_le hVaQ).comap_of_injective
        (embedM d.radical) (embedM_injective d.radical)).map s.projection
  apply generated_transpositions_le_cube _ hP _ hgen
  intro z
  by_cases hcore : Z d.radical z.val ≤ Q d.radical (alpha d.radical)
  · left
    apply (Subgroup.map_eq_bot_iff _).mpr
    rw [s.projection_kernel]
    have hh := comap_mono (f := embedM d.radical) hcore
    rwa [Q_alpha_comap d.radical (replacement_radical_isPGroup h d)
      (replacement_core_le_radical h d)] at hh
  · right
    have hlo := criticalDistance_le d.radical z.val
      ((replacementGeometry h d).exists_critical z.val z.property.1) hcore
    rw [(replacementGeometry h d).distance_constant z.val z.property.1] at hlo
    have ht := (cosetGraph_connected d.radical).dist_triangle
      (u := z.val) (v := a) (w := alpha d.radical)
    have hzdist := z.property.2
    have hdist : (cosetGraph d.radical).dist z.val (alpha d.radical) = replacementDistance h d := by
      change replacementDistance h d ≤ (cosetGraph d.radical).dist z.val (alpha d.radical) at hlo
      omega
    let r : CriticalPath d.radical (replacementGeometry h d) z.val (alpha d.radical) :=
      CriticalPath.ofPair z.property.1 ⟨by
        rw [(replacementGeometry h d).distance_constant z.val z.property.1]
        exact hdist,hcore⟩
    let p := CriticalPath.ofPair (geometry := replacementGeometry h d) r.end_color
      (critical_reverse_pair s hc r)
    exact small_critical_image_eq_swap s hc p (hsmall z.val p)

include e hz hn in
/-- Both covers in the full point-core branch supply the initial nonabelian
large-slice path. A large predecessor slice is retained by the actual
forward extension, and a small one supplies the endpoint estimate. -/
theorem full_point_initial_selection_knownSimple
    (hb : replacementDistance h d = 4) (u : Equiv.Perm (Fin 6))
    (hfull : d.radical.map (SourceReduction.projection h e hz hn d) =
      Theory.SpecificGroups.SymmetricSix.BinaryFlags.pointCore.map (MulAut.conj u).toMonoidHom) :
    ∃ z, ∃ p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) z,
      ⁅localZSpan d.radical (p.walk.getVert 2) (alpha d.radical),
        localZSpan d.radical (p.walk.getVert 2) (alpha d.radical)⁆ ≠ ⊥ ∧
        2 < (B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _)).relIndex
          (U d.radical (p.walk.getVert 2)) := by
  obtain ⟨z,⟨p⟩⟩ := CriticalPath.exists_from (R := d.radical)
    (geometry := replacementGeometry h d) (a := alpha d.radical) rfl
  by_cases hpre : (B d.radical (p.walk.getVert 2) ((replacementGeometry h d).Z_normal _)).relIndex
      (U d.radical z) ≤ 2
  · exact exists_nonabelian_large_slice_knownSimple (e := e) (hz := hz) (hn := hn) hb p
      (small_predecessor_selected_span_nonabelian_knownSimple hb u hfull p hpre)
  have hb2 : 2 < replacementDistance h d := by omega
  obtain ⟨w,q,_,_,hq⟩ := (full_point_forward_path_knownSimple hb2 u hfull p).2.2
  have hlen : q.walk.length = 4 := q.length_eq_b.trans hb
  have hqmid : q.walk.getVert 2 = z := by simpa only [hlen] using hq
  obtain ⟨g,hg⟩ := exists_mVertex_of_color d.radical q.start_color
  have hbase : act d.radical g⁻¹ (p.walk.getVert 2) = alpha d.radical := by
    rw [hg,act_mVertex,mul_inv_cancel]
    rfl
  have hlarge : 2 < (B d.radical (act d.radical g⁻¹ (p.walk.getVert 2))
      ((replacementGeometry h d).Z_normal _)).relIndex
        (U d.radical ((q.act g⁻¹).walk.getVert 2)) := by
    change 2 < (B d.radical _ _).relIndex (U d.radical ((actWalk d.radical g⁻¹ q.walk).getVert 2))
    rw [actWalk_getVert,Escape.PairingControl.FirstPairing.B_act hb2 _ _ q.start_color,
      U_act,relIndex_map_map_of_injective _ _ (MulAut.conj _).injective,hqmid]
    omega
  have hex : ∃ r : CriticalPath d.radical (replacementGeometry h d)
      (act d.radical g⁻¹ (p.walk.getVert 2)) (act d.radical g⁻¹ w),
      2 < (B d.radical (act d.radical g⁻¹ (p.walk.getVert 2))
        ((replacementGeometry h d).Z_normal _)).relIndex (U d.radical (r.walk.getVert 2)) :=
    ⟨q.act g⁻¹,hlarge⟩
  rw [hbase] at hex
  obtain ⟨r,hr⟩ := hex
  refine ⟨_,r,?_,hr⟩
  have hcard := (full_point_four_large_slice_derived_knownSimple hb u hfull r hr).2.1
  intro he
  rw [he,card_bot] at hcard
  omega

include e hz hn in
/-- The literal initial-selection alternative. The full point-core image is
already selected for either cover; in the remaining case every critical image
has order two and every nearby whole-radius image has the stated cube bound. -/
theorem initial_selection_or_cube_radius_knownSimple
    (hb : replacementDistance h d = 4) :
    (∃ z, ∃ p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) z,
      ⁅localZSpan d.radical (p.walk.getVert 2) (alpha d.radical),
        localZSpan d.radical (p.walk.getVert 2) (alpha d.radical)⁆ ≠ ⊥ ∧
        2 < (B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _)).relIndex
          (U d.radical (p.walk.getVert 2))) ∨
    ((∀ u : Equiv.Perm (Fin 6), d.radical.map (SourceReduction.projection h e hz hn d) ≠
        Theory.SpecificGroups.SymmetricSix.BinaryFlags.pointCore.map (MulAut.conj u).toMonoidHom) ∧
      (∀ z, ∀ _p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) z,
        (Q d.radical z).relIndex (Z d.radical (alpha d.radical)) = 2 ∧
          (Q d.radical (alpha d.radical)).relIndex (Z d.radical z) = 2) ∧
      ∀ a : Vertex d.radical, color d.radical a = false →
      (cosetGraph d.radical).dist a (alpha d.radical) ≤ 2 →
      ∃ g : Equiv.Perm (Fin 6),
        graphImage (fullSymmetricAction_knownSimple h e hz hn d (by omega)) (V d.radical a) ≤
          (D 6).map (MulAut.conj g).toMonoidHom) := by
  classical
  by_cases hnon : ∃ z, ∃ p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) z,
      ⁅localZSpan d.radical (p.walk.getVert 2) (alpha d.radical),
        localZSpan d.radical (p.walk.getVert 2) (alpha d.radical)⁆ ≠ ⊥
  · obtain ⟨z,p,hp⟩ := hnon
    exact Or.inl (exists_nonabelian_large_slice_knownSimple (e := e) (hz := hz) (hn := hn) hb p hp)
  let s := fullSymmetricAction_knownSimple h e hz hn d (by omega)
  have hc := DistanceTwo.centralLayer_knownSimple G L R h e hz hn d
  have hsmall : ∀ z, ∀ p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) z,
      (Q d.radical z).relIndex (Z d.radical (alpha d.radical)) < 4 := by
    intro z p
    by_contra! hlarge
    exact hnon ⟨z,p,large_image_selected_span_nonabelian s hc hb p hlarge⟩
  refine Or.inr ⟨?_,fun z p => small_critical_indices s hc p (hsmall z p),
    fun a ha hd => radius_image_le_cube_of_small_critical_images s hc hb hsmall a ha hd⟩
  intro u hfull
  obtain ⟨z,p,hp,_⟩ := full_point_initial_selection_knownSimple hb u hfull
  exact hnon ⟨z,p,hp⟩

end AlternatingSixReconstruction.Natural.Exhaustion.LargeDistance.SectionFive.DistanceFour
end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS
