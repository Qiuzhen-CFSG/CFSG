module

public import Theory.SpecificGroups.SymmetricSix.Parabolics.TwoCores
public import Theory.GroupTheory.PResidual.PrimeToTransport
public import Theory.GroupTheory.FiniteParabolicTransfer

/-!
# Rank-one flags for the exceptional source quotient

The actual duad and syntheme parabolics of A₆ and S₆ have self-centralizing
two-cores and quotients S₃. Their common flag stabilizer is Sylow and has
index three in each parabolic. This identifies both local Sylow normalizers
and proves that each parabolic is generated by its two-elements. Transport
through an isomorphism and conjugacy aligns the flag with any prescribed
two-subgroup.

These are the local WBN hypotheses used by the exceptional MS preparation;
no whole-core exhaustion is assumed. Source: Meierfrankenfeld--Stellmacher
(1993), definition on pp.827--828; Aschbacher--Smith I.5.7, pp.420--421.
-/

public section
open Subgroup
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS
namespace AlternatingSixReconstruction.Exceptional.Exhaustion

universe u v
/-- Concrete source weak-BN data with P_i^* = P_i. The rank-one
quotient is the actual permutation group S3 = SL2(2). -/
structure SixLocalData (H : Type u) [Group H] where
  parabolic : Bool → Subgroup H
  sylow : Sylow 2 H
  generation : parabolic false ⊔ parabolic true = ⊤
  intersection : parabolic false ⊓ parabolic true = (sylow : Subgroup H)
  index_three : ∀ i, (sylow : Subgroup H).relIndex (parabolic i) = 3
  self_centralizing : ∀ i, centralizer (pCore 2 (parabolic i) : Set (parabolic i)) ≤
    pCore 2 (parabolic i)
  quotient : ∀ i, Nonempty (parabolic i ⧸ pCore 2 (parabolic i) ≃* Equiv.Perm (Fin 3))

namespace SixLocalData
open Theory.SpecificGroups.SymmetricSix

noncomputable def symmetric : SixLocalData S6 where
  parabolic i := if i then synthemeStabilizer else duadStabilizer
  sylow := borelSylow
  generation := parabolics_sup
  intersection := parabolics_inf
  index_three i := by cases i <;> first | exact borel_relIndex_duad | exact borel_relIndex_syntheme
  self_centralizing i := by cases i <;> first | exact duadCore_centralizer.le | exact synthemeCore_centralizer.le
  quotient i := by cases i <;> first | exact ⟨duadCoreQuotientEquiv⟩ | exact ⟨synthemeCoreQuotientEquiv⟩

noncomputable def alternating : SixLocalData A6 where
  parabolic i := if i then a6SynthemeStabilizer else a6DuadStabilizer
  sylow := a6BorelSylow
  generation := a6_parabolics_sup
  intersection := a6_parabolics_inf
  index_three i := by cases i <;> first | exact a6Borel_relIndex_duad | exact a6Borel_relIndex_syntheme
  self_centralizing i := by cases i <;> first | exact a6DuadCore_centralizer.le | exact a6SynthemeCore_centralizer.le
  quotient i := by cases i <;> first | exact ⟨a6DuadCoreQuotientEquiv⟩ | exact ⟨a6SynthemeCoreQuotientEquiv⟩

variable {H : Type u} {I : Type v} [Group H] [Group I]

private theorem core_centralizer_transport (e : H ≃* I)
    (hc : centralizer (pCore 2 H : Set H) ≤ pCore 2 H) :
    centralizer (pCore 2 I : Set I) ≤ pCore 2 I := by
  intro x hx
  rw [← pCore_map_iso 2 e]
  refine ⟨e.symm x, hc ?_, e.apply_symm_apply x⟩
  intro y hy
  apply e.injective
  simpa only [map_mul, e.apply_symm_apply] using hx (e y)
    (pCore_map_iso 2 e ▸ mem_map_of_mem e.toMonoidHom hy)

noncomputable def map [Finite H] (d : SixLocalData H) (e : H ≃* I) : SixLocalData I where
  parabolic i := (d.parabolic i).map e.toMonoidHom
  sylow := d.sylow.mapSurjective e.surjective
  generation := by rw [← Subgroup.map_sup, d.generation, map_top_of_surjective _ e.surjective]
  intersection := by rw [← map_inf _ _ _ e.injective, d.intersection]; rfl
  index_three i := by
    change ((d.sylow : Subgroup H).map e.toMonoidHom).relIndex
      ((d.parabolic i).map e.toMonoidHom) = 3
    rw [relIndex_map_map_of_injective _ _ e.injective, d.index_three]
  self_centralizing i := core_centralizer_transport (e.subgroupMap (d.parabolic i))
    (d.self_centralizing i)
  quotient i := by
    obtain ⟨a⟩ := d.quotient i
    let f := e.subgroupMap (d.parabolic i)
    exact ⟨(QuotientGroup.congr _ _ f (pCore_map_iso 2 f)).symm.trans a⟩

theorem sylow_le (d : SixLocalData H) (i : Bool) :
    (d.sylow : Subgroup H) ≤ d.parabolic i := by
  rw [← d.intersection]
  cases i
  · exact inf_le_left
  · exact inf_le_right

variable [Finite H]

private theorem primeToResidual_perm : primeToResidual 2 (Equiv.Perm (Fin 3)) = ⊤ := by
  apply top_unique
  intro x _
  refine Equiv.Perm.swap_induction_on x (primeToResidual 2 _).one_mem ?_
  intro y a b _ hy
  apply (primeToResidual 2 _).mul_mem _ hy
  apply mem_primeToResidual_of_pow (n := 1)
  simp [pow_two]

/-- Both source parabolics are generated by two-elements. -/
theorem primeToResidual_eq_top (d : SixLocalData H) (i : Bool) :
    primeToResidual 2 (d.parabolic i) = ⊤ := by
  obtain ⟨a⟩ := d.quotient i
  let π := a.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 (d.parabolic i)))
  have hπ : Function.Surjective π := a.surjective.comp (QuotientGroup.mk'_surjective _)
  have hk : π.ker = pCore 2 (d.parabolic i) := by
    ext x
    change a (QuotientGroup.mk' (pCore 2 (d.parabolic i)) x) = 1 ↔ _
    rw [a.map_eq_one_iff, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
  have hle : π.ker ≤ primeToResidual 2 (d.parabolic i) := by
    rw [hk]
    exact le_primeToResidual_of_isPGroup pCore_isPGroup
  have hm := map_primeToResidual_of_surjective 2 π hπ
  rw [primeToResidual_perm] at hm
  have hh := congrArg (fun P => P.comap π) hm
  simpa only [comap_map_eq_self hle, comap_top] using hh

omit [Finite H] in
/-- The local Borel is exactly the Sylow normalizer, as required in WBN. -/
theorem sylow_normalizer (d : SixLocalData H) (i : Bool) :
    normalizer ((d.sylow.subtype (d.sylow_le i)) : Set (d.parabolic i)) =
      (d.sylow.subtype (d.sylow_le i) : Subgroup (d.parabolic i)) := by
  let S := d.sylow.subtype (d.sylow_le i)
  change normalizer (S : Set (d.parabolic i)) = (S : Subgroup (d.parabolic i))
  have hi : (S : Subgroup (d.parabolic i)).index = 3 := d.index_three i
  have hnot : ¬ (S : Subgroup (d.parabolic i)).Normal := by
    intro hn
    let := hn
    have hS : (S : Subgroup (d.parabolic i)) = pCore 2 (d.parabolic i) :=
      le_antisymm (le_sSup ⟨hn, S.isPGroup'⟩) (pCore_isPGroup.le_sylow_of_normal S)
    obtain ⟨a⟩ := d.quotient i
    have hc : (pCore 2 (d.parabolic i)).index = 6 := by
      rw [index_eq_card, Nat.card_congr a.toEquiv, Nat.card_perm, Nat.card_fin]
      decide
    rw [hS, hc] at hi
    omega
  have hd := index_dvd_of_le (S : Subgroup (d.parabolic i)).le_normalizer
  rw [hi] at hd
  rcases (Nat.dvd_prime (by decide : Nat.Prime 3)).mp hd with hone | hthree
  · exact (hnot (normalizer_eq_top_iff.mp (index_eq_one.mp hone))).elim
  · have hm := relIndex_mul_index (S : Subgroup (d.parabolic i)).le_normalizer
    rw [hi, hthree] at hm
    change (S : Subgroup (d.parabolic i)).relIndex
      (normalizer (S : Set (d.parabolic i))) * 3 = 3 at hm
    have hr : (S : Subgroup (d.parabolic i)).relIndex
        (normalizer (S : Set (d.parabolic i))) = 1 := by omega
    exact le_antisymm (relIndex_eq_one.mp hr) (S : Subgroup (d.parabolic i)).le_normalizer

/-- Alignment with a prescribed two-subgroup changes only the common flag. -/
theorem exists_aligned (d : SixLocalData H) (T : Subgroup H) (hT : IsPGroup 2 T) :
    ∃ c : SixLocalData H, T ≤ (c.sylow : Subgroup H) := by
  obtain ⟨S, hS⟩ := hT.exists_le_sylow
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq H d.sylow S
  refine ⟨d.map (MulAut.conj g), ?_⟩
  have he : ((d.map (MulAut.conj g)).sylow : Subgroup H) = (S : Subgroup H) := by
    change ((g • d.sylow : Sylow 2 H) : Subgroup H) = (S : Subgroup H)
    rw [hg]
  exact he.symm ▸ hS

end SixLocalData
end AlternatingSixReconstruction.Exceptional.Exhaustion
end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS
