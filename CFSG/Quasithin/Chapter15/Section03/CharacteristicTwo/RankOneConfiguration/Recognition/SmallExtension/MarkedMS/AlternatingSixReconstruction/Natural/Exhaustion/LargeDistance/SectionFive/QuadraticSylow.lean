module

public import Theory.SpecificGroups.SymmetricSix.BinaryFlags.QuadraticPointCore.Conjugation
public import CFSG.Quasithin.ChapterB.Section03.Offenders.Six.Structure.Basic

/-!
# Normal quadratic generators in the six-letter Sylow subgroup

A two-subgroup of S₆ generated by normal elementary abelian subgroups acting
quadratically on the natural module has order at most eight. Conjugate into
the canonical Sylow subgroup of order sixteen. If the whole Sylow occurred,
each normal quadratic generator would lie in its three-pair subgroup of order
eight: a short element-table certificate excludes every outside involution by
its double displacement with a conjugate.

This is the finite action calculation for the radius-image estimate in MS93
(5.2), printed p.914. `RadiusImage` applies it to the literal graph generators;
no point-core condition on the original radical is used.
-/

public noncomputable section
open Subgroup BinaryPermutation
open Theory.SpecificGroups.SymmetricSix.BinaryFlags
open Theory.SpecificGroups.SymmetricSix.BinaryFlags.NaturalGeometry
open CFSG.Quasithin.ChapterB.Offenders
open CFSG.Quasithin.ChapterB.Offenders.Six
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS.AlternatingSixReconstruction.Natural.Exhaustion.LargeDistance.SectionFive.QuadraticSylow
private def pairFull (i j : Fin 6) : Full (Fin 6) := Pi.single i 1 + Pi.single j 1
private def cross (g h : S) : Full (Fin 6) :=
  pairFull (g (h 0)) (g (h 4)) - pairFull (g 0) (g 4) -
    (pairFull (h 0) (h 4) - pairFull 0 4)

private theorem quadratic_coordinate (A : Subgroup S) (hq : QuadraticPointCore.Quadratic A)
    (g h : S) (hg : g ∈ A) (hh : h ∈ A) : cross g h 0 = cross g h 4 := by
  have he := hq g hg h hh (pairVector 0 4)
  rw [map_sub,pairVector_map,pairVector_map,pairVector_map] at he
  have hz := congrArg Subtype.val (sub_eq_zero.mpr he)
  change (constants (Fin 6)).mkQ (pairFull (g (h 0)) (g (h 4))) -
    (constants (Fin 6)).mkQ (pairFull (g 0) (g 4)) -
      ((constants (Fin 6)).mkQ (pairFull (h 0) (h 4)) -
        (constants (Fin 6)).mkQ (pairFull 0 4)) = 0 at hz
  rw [←map_sub,←map_sub,←map_sub] at hz
  have hc : cross g h ∈ constants (Fin 6) := (Submodule.Quotient.mk_eq_zero _).mp hz
  obtain ⟨c,hc⟩ := Submodule.mem_span_singleton.mp hc
  have h0 := congrFun hc (0:Fin 6)
  have h4 := congrFun hc (4:Fin 6)
  simpa only [Pi.smul_apply,allOne,smul_eq_mul,mul_one] using h0.symm.trans h4

private theorem normal_quadratic_cert : ∀ i : Fin 16,
    (sylowWords i)^2 = 1 →
    cross (sylowWords i) (swap01 * sylowWords i * swap01⁻¹) 0 =
      cross (sylowWords i) (swap01 * sylowWords i * swap01⁻¹) 4 →
    ∃ j : Fin 8, dWords j = sylowWords i := by decide +kernel

private theorem normal_quadratic_le_cube (A : Subgroup S) [IsElementaryAbelian 2 A]
    (hA : A ≤ sylowCarrier) (hn : sylowCarrier ≤ normalizer (A : Set S))
    (hq : QuadraticPointCore.Quadratic A) : A ≤ CFSG.Quasithin.ChapterB.Offenders.D 6 := by
  have hs : swap01 ∈ sylowCarrier := (mem_sylowCarrier_iff _).mpr ⟨1,rfl⟩
  intro g hg
  obtain ⟨i,hi⟩ := (mem_sylowCarrier_iff _).mp (hA hg)
  have hconj : swap01*g*swap01⁻¹ ∈ A := (mem_normalizer_iff.mp (hn hs) g).mp hg
  have he := quadratic_coordinate A hq g (swap01*g*swap01⁻¹) hg hconj
  have hsq := elemPow_eq_one_of_isElementaryAbelian (p:=2) g hg
  rw [←hi] at he hsq
  obtain ⟨j,hj⟩ := normal_quadratic_cert i hsq he
  exact (mem_disjointTranspositions_iff (3 : Fin 4) _).mpr ⟨j,hj.trans hi⟩

theorem generated_normal_quadratic_bound (B : Subgroup S) (hB : IsPGroup 2 B)
    {I : Sort*} (A : I → Subgroup S) (hgen : B = ⨆ i, A i)
    (helem : ∀ i, IsElementaryAbelian 2 (A i))
    (hnorm : ∀ i, B ≤ normalizer (A i : Set S))
    (hquad : ∀ i, QuadraticPointCore.Quadratic (A i)) : Nat.card B ≤ 8 := by
  obtain ⟨P,hBP⟩ := hB.exists_le_sylow
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq S P sylow
  let f := (MulAut.conj g).toMonoidHom
  have hBt : B.map f ≤ sylowCarrier := by
    rintro _ ⟨b,hb,rfl⟩
    change (MulAut.conj g) b ∈ (sylow : Subgroup S)
    rw [←hg]
    exact mem_map_of_mem f (hBP hb)
  have hcard : Nat.card (B.map f) ≤ 16 := by
    simpa only [card_sylowCarrier] using card_le_of_le hBt
  have hne : B.map f ≠ sylowCarrier := by
    intro heq
    have hle : B.map f ≤ CFSG.Quasithin.ChapterB.Offenders.D 6 := by
      rw [hgen,Subgroup.map_iSup]
      apply iSup_le
      intro i
      let := helem i
      let := IsElementaryAbelian.map (p:=2) (A:=A i) f
      apply normal_quadratic_le_cube
      · exact ((map_mono (hgen ▸ le_iSup A i)).trans hBt)
      · rw [←heq]
        exact (map_mono (hnorm i)).trans (le_normalizer_map f)
      · exact QuadraticPointCore.quadratic_conjugate _ (hquad i) g
    rw [heq] at hle
    have hh := card_le_of_le hle
    have hc : Nat.card (CFSG.Quasithin.ChapterB.Offenders.D 6) = 8 := card_disjointTranspositions 3
    rw [card_sylowCarrier,hc] at hh
    omega
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  obtain ⟨n,hn⟩ := (hB.map f).exists_card_eq
  have hnlt : n < 4 := by
    by_contra hh
    have hh := Nat.pow_le_pow_right (by decide : 1 ≤ 2) (Nat.le_of_not_gt hh)
    have hc : Nat.card (B.map f) = 16 := by omega
    exact hne (eq_of_le_of_card_ge hBt (by rw [card_sylowCarrier,hc]))
  have hbnd : Nat.card (B.map f) ≤ 8 := by
    rw [hn]
    exact Nat.pow_le_pow_right (by decide : 1 ≤ 2) (by omega : n ≤ 3)
  rwa [card_map_of_injective (MulAut.conj g).injective] at hbnd
end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS.AlternatingSixReconstruction.Natural.Exhaustion.LargeDistance.SectionFive.QuadraticSylow
