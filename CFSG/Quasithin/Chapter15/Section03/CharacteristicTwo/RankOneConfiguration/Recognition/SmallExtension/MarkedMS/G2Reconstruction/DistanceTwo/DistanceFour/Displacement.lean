/-- Once the derived radius lies in the midpoint kernel, its image is elementary:
the radius is generated by involutions, so squares lie in its derived subgroup. -/
theorem radius_image_elementary
    (hb : 2 < (geometry h).b T)
    (a c : Vertex T) (ha : color T a = false)
    (hac : (cosetGraph T).dist a c = 2)
    (hd : ⁅V T a,V T a⁆ ≤ Q T c) (d : EndpointModel T c) :
    IsElementaryAbelian 2 (image d (V T a)) := by
  have hVS : V T a ≤ stabilizer T c :=
    ((geometry h).V_le_Q hb a ha).trans (Q_le_stabilizer_of_dist_two T a c ha hac)
  have hk : d.actor.ker = (Q T c).subgroupOf (stabilizer T c) := by
    apply map_injective (stabilizer T c).subtype_injective
    rw [d.actor_kernel,map_subgroupOf_eq_of_le (show Q T c ≤ stabilizer T c from fun _ hx => hx.1)]
  have hp (x : image d (V T a)) : x ^ 2 = 1 := by
    obtain ⟨v,hv,hvx⟩ := x.property
    apply Subtype.ext
    change x.val ^ 2 = 1
    rw [←hvx,←map_pow]
    apply (show v ^ 2 ∈ d.actor.ker → d.actor (v ^ 2) = 1 from fun h => h)
    rw [hk]
    exact hd (radius_sq_mem_derived (geometry h) (by omega) a ha ⟨v.val,hv⟩)
  exact elementary_of_sq hp

