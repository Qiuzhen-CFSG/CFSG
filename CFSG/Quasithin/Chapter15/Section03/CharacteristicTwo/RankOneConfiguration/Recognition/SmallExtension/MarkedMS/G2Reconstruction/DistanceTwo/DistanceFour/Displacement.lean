/-- The derived-radius containment bounds the whole radius image by the
actual two-rank of the G₂ model, not just the images of its generators. -/
theorem radius_index_le_eight_of_derived_le
    (hb : 2 < (geometry h).b T)
    (a c : Vertex T) (ha : color T a = false)
    (hac : (cosetGraph T).dist a c = 2)
    (hd : ⁅V T a,V T a⁆ ≤ Q T c) (d : EndpointModel T c) :
    (Q T c).relIndex (V T a) ≤ 8 := by
  have hVS : V T a ≤ stabilizer T c :=
    ((geometry h).V_le_Q hb a ha).trans (Q_le_stabilizer_of_dist_two T a c ha hac)
  rw [←image_card d _ hVS]
  have hr := Atlas.G2.EvenTwoRank.two_rank (ZMod 2) (n := 1) (by norm_num)
  have hbnd := (primeRank_le_iff_elementary_card_le (Atlas.G2.Model (ZMod 2))).mp
    hr.le (image d (V T a)) (radius_image_elementary h hb a c ha hac hd d)
  simpa using hbnd

/-- The moving central quotient satisfies the literal projected-offender
inequality from the source radius containment. -/
theorem moving_fixedCodim_le_three_of_fixed
    (hb : 2 < (geometry h).b T)
    (a z : Vertex T) (ha : color T a = false)
    (hc : CriticalPair T a z ((geometry h).exists_critical a ha))
    (c : Vertex T) (hcColor : color T c = false)
    (hac : (cosetGraph T).dist a c = 2)
    (hcz : (cosetGraph T).dist c z = 2)
    (hfixed : ⁅V T a,V T a⁆ ≤ fixedCore T a) :
    letI := moving_central_quotient_elementary (geometry h) (by omega) a ha hfixed
    fixedCodim (Offenders.linearize (movingQuotientAction a))
      ((Z T z).subgroupOf (stabilizer T a)) ≤ 3 := by
  let := moving_central_quotient_elementary (geometry h) (by omega) a ha hfixed
  obtain ⟨d⟩ := endpointModel_knownSimple h e hcColor
  have hpow := (moving_fixedCodim_pow_le_radius_index (geometry h) hb a ha hfixed
    (Z T z) (Q T c) (radius_intersection_seed h e hb a z ha hc c hcColor hcz)).trans
      (radius_index_le_eight_of_derived_le h hb a c ha hac
        (radius_derived_le_midpoint_of_fixed h hb a c ha hcColor hac hfixed) d)
  exact (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp (show 2 ^ _ ≤ 2 ^ 3 from hpow)

