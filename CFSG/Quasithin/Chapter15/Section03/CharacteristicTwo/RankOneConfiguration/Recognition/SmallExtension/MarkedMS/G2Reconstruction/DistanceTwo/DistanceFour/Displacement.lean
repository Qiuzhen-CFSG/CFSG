/-- The residual has no fixed vectors on the whole moving central quotient.
A fixed vector is orthogonal to every residual commutator for every scalar
commutator form; fullness and separation force that vector to vanish. -/
theorem moving_quotient_fixedSpace_eq_bot
    (hb : 2 < (geometry h).b T) (a : Vertex T) (ha : color T a = false)
    (hfixed : ⁅V T a,V T a⁆ ≤ fixedCore T a) :
    letI := moving_central_quotient_elementary (geometry h) (by omega) a ha hfixed
    fixedSpace (Offenders.linearize (movingQuotientAction a))
      (pResidual 2 (stabilizer T a)) = ⊥ := by
  let := moving_central_quotient_elementary (geometry h) (by omega) a ha hfixed
  let ρ := Offenders.linearize (movingQuotientAction a)
  have hfull := moving_quotient_full_of_fixed h hb a ha hfixed
  obtain ⟨forms,_,hsep,hinv⟩ := movingQuotient_separating_forms (geometry h) (by omega) a ha hfixed
  apply bot_unique
  intro v hv
  change v = 0
  apply hsep v
  intro B hB w
  have hker : subspaceCommutator ρ ⊤ (pResidual 2 (stabilizer T a)) ≤ (B v).ker := by
    apply Submodule.span_le.mpr
    rintro _ ⟨g,hg,x,_,rfl⟩
    change B v (ρ g x - x) = 0
    rw [map_sub]
    have he := hinv g hg B hB v x
    have hgv : ρ g v = v := hv ⟨g,hg⟩
    change B (ρ g v) (ρ g x) = B v x at he
    rw [hgv] at he
    exact sub_eq_zero.mpr he
