/-- Residual commutator generation holds on the whole moving central quotient. -/
theorem moving_quotient_full_of_fixed
    (hb : 2 < (geometry h).b T) (a : Vertex T) (ha : color T a = false)
    (hfixed : ⁅V T a,V T a⁆ ≤ fixedCore T a) :
    letI := moving_central_quotient_elementary (geometry h) (by omega) a ha hfixed
    subspaceCommutator (Offenders.linearize (movingQuotientAction a))
      ⊤ (pResidual 2 (stabilizer T a)) = ⊤ := by
  let := moving_central_quotient_elementary (geometry h) (by omega) a ha hfixed
  let P := Vcirc T a
  let q := QuotientGroup.mk' (center P)
  let ρ := Offenders.linearize (movingQuotientAction a)
  let W := subspaceCommutator ρ ⊤ (pResidual 2 (stabilizer T a))
  let J : Subgroup (P ⧸ center P) := Subgroup.toAddSubgroup.symm W.toAddSubgroup
  have hP : P ≤ (J.comap q).map P.subtype := by
    change Vcirc T a ≤ _
    conv_lhs => rw [← moving_full_commutation h hb a ha, commutator_comm]
    apply commutator_le.mpr
    intro l hl v hv
    obtain ⟨g, hg, rfl⟩ := hl
    let vP : P := ⟨v,hv⟩
    refine ⟨movingAction a g vP * vP⁻¹, ?_, ?_⟩
    · change Additive.ofMul (q (movingAction a g vP * vP⁻¹)) ∈ W
      have hh : ρ g (Additive.ofMul (q vP)) - Additive.ofMul (q vP) ∈ W :=
        Submodule.subset_span ⟨g,hg,Additive.ofMul (q vP),Submodule.mem_top,rfl⟩
      simp only [ρ,Offenders.linearize,sub_eq_add_neg] at hh
      change Additive.ofMul (movingQuotientAction a g (q vP) * (q vP)⁻¹) ∈ W at hh
      rw [movingQuotientAction_apply] at hh
      simpa only [map_mul,map_inv] using hh
    · change (movingAction a g vP : FreeAmalgam T) * v⁻¹ = _
      rw [movingAction_apply]
      rfl
  apply top_unique
  intro v _
  obtain ⟨p,hp⟩ := QuotientGroup.mk'_surjective (center P) v.toMul
  obtain ⟨w,hw,he⟩ := hP p.property
  have he' : w = p := Subtype.ext he
  subst w
  change Additive.ofMul (q p) ∈ W at hw
  change q p = v.toMul at hp
  rw [hp] at hw
  exact hw

/-- The fixed-derived branch supplies an actual elementary critical actor
whose image has rank three and bounds displacement of the whole moving
central quotient. Its projection retains the exact two-core kernel. -/
theorem moving_projected_offender_of_fixed
    (hb : 2 < (geometry h).b T) (a : Vertex T) (ha : color T a = false)
    (hfixed : ⁅V T a,V T a⁆ ≤ fixedCore T a) :
    letI := moving_central_quotient_elementary (geometry h) (by omega) a ha hfixed
    ∃ (d : EndpointModel T a) (A : Subgroup (stabilizer T a)),
      IsElementaryAbelian 2 A ∧ Nat.card (A.map d.actor) = 8 ∧
      fixedCodim (Offenders.linearize (movingQuotientAction a)) A ≤ rank (A.map d.actor) := by
  let := moving_central_quotient_elementary (geometry h) (by omega) a ha hfixed
  obtain ⟨z,hcrit⟩ := criticalPair_exists T a ((geometry h).exists_critical a ha)
  have hfour := distance_four_knownSimple h e hb
  have hd : (cosetGraph T).dist a z = 4 :=
    hcrit.1.trans (((geometry h).distance_constant a ha).trans hfour)
  obtain ⟨t,hat,htz⟩ := exists_adjacent_dist_sub_one T a z (by omega)
  obtain ⟨c,htc,hcz⟩ := exists_adjacent_dist_sub_one T t z (by omega)
  have hcColor : color T c = false := by
    have ht := adjacent_color_ne T hat
    have hc := adjacent_color_ne T htc
    rw [ha] at ht
    cases hc' : color T c <;> cases ht' : color T t <;> simp_all
  have hat1 := SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj T _ _).mpr hat)
  have htc1 := SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj T _ _).mpr htc)
  have h₁ := (cosetGraph_connected T).dist_triangle (u := a) (v := t) (w := c)
  have h₂ := (cosetGraph_connected T).dist_triangle (u := a) (v := c) (w := z)
  have hac : (cosetGraph T).dist a c = 2 := by omega
  have hcz2 : (cosetGraph T).dist c z = 2 := by omega
  have hz := critical_endpoint_color T a ha _ hcrit
  have hrev := critical_reverse T (geometry h) (edgeCentralizer h e) a ha (by
    rw [(geometry h).distance_constant a ha]; exact (positive_even h e).1) z hz hcrit
  obtain ⟨d⟩ := endpointModel_knownSimple h e ha
  let A := (Z T z).subgroupOf (stabilizer T a)
  let := (geometry h).Z_elementary (by omega) z hz
  have hAS := Z_le_stabilizer_of_dist_le z ((geometry h).exists_critical z hz) hrev.1.le
  have hAc : Nat.card (A.map d.actor) = 8 := critical_image_card_eight h e z a hz hrev d
  refine ⟨d,A,IsElementaryAbelian.subgroupOf hAS,hAc,?_⟩
  have hr : rank (A.map d.actor) = 3 := by rw [rank,hAc]; decide
  rw [hr]
  exact moving_fixedCodim_le_three_of_fixed h e hb a z ha hcrit c hcColor hac hcz2 hfixed

/-- In particular the entire moving central quotient is an FF module for
its literal stabilizer action in the fixed-derived branch. No descent of
the two-core action or irreducibility is assumed here. -/
theorem moving_isFFModule_of_fixed
    (hb : 2 < (geometry h).b T) (a : Vertex T) (ha : color T a = false)
    (hfixed : ⁅V T a,V T a⁆ ≤ fixedCore T a) :
    letI := moving_central_quotient_elementary (geometry h) (by omega) a ha hfixed
    IsFFModule (Offenders.linearize (movingQuotientAction a)) := by
  let := moving_central_quotient_elementary (geometry h) (by omega) a ha hfixed
  let := finite_stabilizer T a
  obtain ⟨d,A,hA,hcard,hcost⟩ := moving_projected_offender_of_fixed h e hb a ha hfixed
  have hne : A ≠ ⊥ := by
    intro hz
    rw [hz,Subgroup.map_bot,card_bot] at hcard
    omega
  have hc : Nat.card (A.map d.actor) ≤ Nat.card A := by
    let f : A → A.map d.actor := fun x => ⟨d.actor x,mem_map_of_mem d.actor x.property⟩
    apply Nat.card_le_card_of_surjective f
    rintro ⟨x,y,hy,hxy⟩
    exact ⟨⟨y,hy⟩,Subtype.ext hxy⟩
  exact ⟨A,⟨hne,hA⟩,hcost.trans (Nat.log_mono_right hc)⟩

