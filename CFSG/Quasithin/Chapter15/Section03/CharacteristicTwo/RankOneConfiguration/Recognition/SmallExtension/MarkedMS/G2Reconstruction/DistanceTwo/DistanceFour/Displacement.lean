/-- The actual critical endpoint image has order eight. -/
theorem critical_image_card_eight
    (a z : Vertex T) (ha : color T a = false)
    (hc : CriticalPair T a z ((geometry h).exists_critical a ha))
    (d : EndpointModel T z) : Nat.card (image d (Z T a)) = 8 := by
  obtain ⟨da⟩ := endpointModel_knownSimple h e ha
  have ho := critical_image_offender (geometry h) (edgeCentralizer h e)
    a z ha (positive_even h e).1 hc da d
  obtain ⟨g,hg⟩ := Atlas.G2.NaturalOffenders.offender_conjugate_elementary
    (F := ZMod 2) (n := 1) (by norm_num) (by decide) _ ho
  rw [hg,card_map_of_injective (MulAut.conj g).injective,
    Atlas.G2.EvenTwoRank.elementary_card,Nat.card_zmod]
  norm_num

/-- Critical index eight uses the exact actor kernel, including central attachments. -/
theorem critical_index_eight
    (a z : Vertex T) (ha : color T a = false)
    (hc : CriticalPair T a z ((geometry h).exists_critical a ha)) :
    (Q T z).relIndex (Z T a) = 8 := by
  obtain ⟨d⟩ := endpointModel_knownSimple h e (critical_endpoint_color T a ha _ hc)
  rw [← image_card d _
    (Z_le_stabilizer_of_dist_le a ((geometry h).exists_critical a ha) hc.1.le)]
  exact critical_image_card_eight h e a z ha hc d

/-- The radius intersection at a critical midpoint has its whole endpoint
commutator in the original critical commutator. -/
theorem radius_intersection_critical_commutator
    (hb : 2 < (geometry h).b T)
    (a z : Vertex T) (ha : color T a = false)
    (hc : CriticalPair T a z ((geometry h).exists_critical a ha))
    (c : Vertex T) (hcColor : color T c = false)
    (hcz : (cosetGraph T).dist c z = 2) :
    ⁅V T a ⊓ Q T c,Z T z⁆ ≤ ⁅Z T a,Z T z⁆ := by
  obtain ⟨da⟩ := endpointModel_knownSimple h e ha
  obtain ⟨dz⟩ := endpointModel_knownSimple h e (critical_endpoint_color T a ha _ hc)
  apply critical_commutator_le (geometry h) (edgeCentralizer h e) a z ha
    (positive_even h e).1 hc da dz
  · exact inf_le_right.trans (Q_le_stabilizer_of_dist_two T c z hcColor hcz)
  · exact (inf_le_left.trans ((geometry h).V_le_Q hb a ha)).trans
      ((Q_le_centralizer_X T a).trans (centralizer_le
        ((critical_image_le_start (geometry h) a z ha hc).trans
          ((geometry h).omega_bound a ha (by
            rw [(geometry h).distance_constant a ha]
            exact (positive_even h e).1)))))

/-- The critical endpoint fixes the radius intersection modulo the initial seed. -/
theorem radius_intersection_seed
    (hb : 2 < (geometry h).b T)
    (a z : Vertex T) (ha : color T a = false)
    (hc : CriticalPair T a z ((geometry h).exists_critical a ha))
    (c : Vertex T) (hcColor : color T c = false)
    (hcz : (cosetGraph T).dist c z = 2) :
    ⁅V T a ⊓ Q T c,Z T z⁆ ≤ Z T a :=
  (radius_intersection_critical_commutator h e hb a z ha hc c hcColor hcz).trans
    (critical_image_le_start (geometry h) a z ha hc)

