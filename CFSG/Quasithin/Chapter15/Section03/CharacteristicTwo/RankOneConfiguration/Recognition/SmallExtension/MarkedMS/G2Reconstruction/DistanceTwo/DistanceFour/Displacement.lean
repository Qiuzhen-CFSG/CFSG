private theorem elementary_of_sq {P : Type*} [Group P] (hp : ∀ x : P, x ^ 2 = 1) :
    IsElementaryAbelian 2 P := by
  let : IsMulCommutative P := ⟨⟨fun x y => by
    have hi (x : P) : x⁻¹ = x :=
      inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using hp x)
    simpa only [hi] using mul_inv_rev x y⟩⟩
  exact ⟨Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr hp⟩

