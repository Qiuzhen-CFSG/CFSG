/-- The fixed-derived branch supplies its required midpoint-kernel containment
without any natural-model or quotient-index premise. -/
theorem radius_derived_le_midpoint_of_fixed
    (hb : 2 < (geometry h).b T)
    (a c : Vertex T) (ha : color T a = false) (hcColor : color T c = false)
    (hac : (cosetGraph T).dist a c = 2)
    (hfixed : ⁅V T a,V T a⁆ ≤ fixedCore T a) : ⁅V T a,V T a⁆ ≤ Q T c := by
  obtain ⟨t,hat,hct⟩ := exists_common_neighbor_of_dist_two T a c hac
  exact (radius_derived_le_edge_of_fixed h hb a t ha hat hfixed).trans
    ((edge_radius_le_radius hcColor hct).trans ((geometry h).V_le_Q hb c hcColor))

