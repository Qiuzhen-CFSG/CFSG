universe u
variable {G : Type u} [Group G] [Finite G] {L R : Subgroup G}
  (h : SmallMSPair KnownSimple.IsKnownSimple L R) (e : CentralMarking L)
  (hz : Nat.card (center (L ⧸ pCore 2 L)) = 3)
  (hk : layerKernel L R = extensionKernel h)
local notation "M" => (L ⊔ R : Subgroup G)
local notation "Rg" => edge L R
local notation "π" => CubicAction.projection h e hz hk
private theorem selected_graphImage_le_pointCore_of_le_edge (u : S)
    (hR : (Rg).map π ≤ pointCore.map (MulAut.conj u).toMonoidHom)
    (t : Vertex Rg) (hat : Adjacent Rg (alpha Rg) t)
    (A : Subgroup (FreeAmalgam Rg)) (hAt : A ≤ Q Rg t) :
    ∃ v : S, CubicAction.graphImage h e hz hk A ≤ pointCore.map (MulAut.conj v).toMonoidHom := by
  obtain ⟨g,hg|hg⟩ := edge_transitive Rg hat (base_adjacent Rg)
  · have hgM : g ∈ (embedM Rg).range := by
      change g ∈ Mbar Rg
      rw [← stabilizer_m_base Rg]
      exact hg.1
    obtain ⟨m,rfl⟩ := hgM
    have hQt : (Q Rg t).map
        (MulAut.conj ((embedM Rg m)⁻¹)).toMonoidHom =
          (Rg).map (embedM Rg) := by
      rw [← Q_act,hg.2]
      exact Q_beta Rg
    have hAm (x : M) (hx : x ∈ A.comap (embedM Rg)) :
        m⁻¹*x*m ∈ Rg := by
      have hh := ((map_mono hAt).trans_eq hQt) (mem_map_of_mem
        (MulAut.conj ((embedM Rg m)⁻¹)).toMonoidHom hx)
      obtain ⟨r,hr,he⟩ := hh
      have heq : r = m⁻¹*x*m := by
        apply embedM_injective Rg
        change embedM Rg r = (embedM Rg m)⁻¹ *
          embedM Rg x * ((embedM Rg m)⁻¹)⁻¹ at he
        simpa only [map_mul,map_inv,inv_inv] using he
      exact heq ▸ hr
    refine ⟨π m * u,?_⟩
    rintro _ ⟨x,hx,rfl⟩
    obtain ⟨r,hr,he⟩ := hR (mem_map_of_mem π (hAm x hx))
    refine ⟨r,hr,?_⟩
    change (π m*u)*r*(π m*u)⁻¹=π x
    have he' : u*r*u⁻¹ = (π m)⁻¹*π x*π m := by
      change u*r*u⁻¹ = π (m⁻¹*x*m) at he
      simpa only [map_mul,map_inv] using he
    calc
      (π m*u)*r*(π m*u)⁻¹ =
          π m*(u*r*u⁻¹)*(π m)⁻¹ := by group
      _ = π x := by rw [he']; group
  · have hh : color Rg (beta Rg) = false := by
      change color Rg (hVertex Rg 1) = false
      rw [← hg.1,action_preserves_color]
      rfl
    cases hh

include h e hz hk in
private theorem point_radius_image_at_base_le_two
    (u : S) (hR : (Rg).map π ≤ pointCore.map (MulAut.conj u).toMonoidHom)
    {a t : Vertex Rg} (ha : color Rg a = false)
    (hat : Adjacent Rg a t) (hbt : Adjacent Rg (alpha Rg) t) :
    (Q Rg (alpha Rg)).relIndex (V Rg a) ≤ 2 := by
  have hb := point_image_distance_eq_four h e hz hk u hR
  have hb2 : 2 < sourceDistance h := by omega
  have ht : color Rg t = true := by
    have hh := adjacent_color_ne Rg hat
    rw [ha] at hh
    cases he : color Rg t <;> simp_all
  have hd : (cosetGraph Rg).dist a (alpha Rg) ≤ 2 := by
    have h1 := SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj Rg _ _).mpr hat)
    have h2 := SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj Rg _ _).mpr (adjacent_symm Rg hbt))
    have hh := (cosetGraph_connected Rg).dist_triangle (u := a) (v := t) (w := alpha Rg)
    omega
  have hVQ : V Rg a ≤ Q Rg a := V_le_Q Rg (geometry := sourceGeometry h) ha hb2
  have hVt := hVQ.trans (Q_le_adjacent_h Rg ht hat)
  have hVG : V Rg a ≤ stabilizer Rg (alpha Rg) :=
    hVt.trans (fun _ hx => hx.2 _ (adjacent_symm Rg hbt))
  obtain ⟨v,hv⟩ := selected_graphImage_le_pointCore_of_le_edge h e hz hk u hR t hbt
    (V Rg a) hVt
  let I := {d : Vertex Rg // color Rg d = false ∧ (cosetGraph Rg).dist d a ≤ 2}
  have hV : V Rg a = ⨆ d : I, Z Rg d.val := by
    apply le_antisymm
    · apply (V_le_iff Rg ha _).mpr
      intro d hcol hdist
      exact le_iSup_of_le (⟨d,hcol,hdist⟩ : I) le_rfl
    · exact iSup_le fun d => le_iSup_of_le d.val (le_iSup_of_le d.property.2 le_rfl)
  have hseed (d : I) : Z Rg d.val ≤ V Rg a := hV ▸ le_iSup (fun d : I => Z Rg d.val) d
  have hm (d : I) : ((Z Rg d.val).comap (embedM Rg)).map (embedM Rg) = Z Rg d.val :=
    map_comap_eq_self (((hseed d).trans hVG).trans_eq (stabilizer_m_base Rg))
  have hgen : CubicAction.graphImage h e hz hk (V Rg a) =
      ⨆ d : I, CubicAction.graphImage h e hz hk (Z Rg d.val) := by
    have hcmap : (V Rg a).comap (embedM Rg) = ⨆ d : I, (Z Rg d.val).comap (embedM Rg) := by
      apply map_injective (embedM_injective Rg)
      rw [Subgroup.map_iSup]
      simp only [hm]
      rw [map_comap_eq_self (hVG.trans_eq (stabilizer_m_base Rg)),hV]
    change ((V Rg a).comap (embedM Rg)).map π = _
    rw [hcmap,Subgroup.map_iSup]
    rfl
  have hbound : CubicAction.graphImage h e hz hk (V Rg a) ≤ zpowers (v*swap45*v⁻¹) := by
    rw [hgen]
    apply iSup_le
    intro d
    by_cases hcore : Z Rg d.val ≤ Q Rg (alpha Rg)
    · have hpre : (Z Rg d.val).comap (embedM Rg) ≤ pCore 2 M := by
        have hh := comap_mono (f := embedM Rg) hcore
        rwa [Q_alpha_comap Rg h.relative_radical.isPGroup h.relative_radical.twoCore_le] at hh
      have hz0 : CubicAction.graphImage h e hz hk (Z Rg d.val) = ⊥ := by
        apply (Subgroup.map_eq_bot_iff _).mpr
        rw [CubicAction.projection_kernel]
        exact hpre.trans (show pCore 2 M ≤ extensionKernel h from le_sup_right)
      rw [hz0]
      exact bot_le
    · have hlo := criticalDistance_le Rg d.val ((sourceGeometry h).exists_critical d.val d.property.1) hcore
      have hhi := (cosetGraph_connected Rg).dist_triangle (u := d.val) (v := a) (w := alpha Rg)
      have hd' := d.property.2
      have hpair : CriticalPair Rg d.val (alpha Rg)
          ((sourceGeometry h).exists_critical d.val d.property.1) := by
        refine ⟨?_,hcore⟩
        rw [(sourceGeometry h).distance_constant _ d.property.1] at hlo ⊢
        change _ = sourceDistance h
        change sourceDistance h ≤ _ at hlo
        omega
      let q := CriticalPath.ofPair (geometry := sourceGeometry h) rfl
        (critical_reverse Rg (sourceGeometry h) (sourceEdgeCentralizer h e) d.val d.property.1
          (by rw [(sourceGeometry h).distance_constant _ d.property.1]; exact sourceDistance_pos h)
          (alpha Rg) rfl hpair)
      have hi := (point_image_critical_indices_two h e hz hk u hR q).1
      obtain ⟨s,hs,he⟩ := small_critical_image_eq_swap h e hz hk q (by omega)
      have hmem : s ∈ CubicAction.graphImage h e hz hk (Z Rg d.val) := by
        change s ∈ ((Z Rg d.val).comap (embedM Rg)).map π
        rw [he]
        exact mem_zpowers s
      have hsv := PointCoreTranspositionFixed.swap_eq_conjugate v s
        (hv ((map_mono (comap_mono (hseed d))) hmem)) hs
      change ((Z Rg d.val).comap (embedM Rg)).map π ≤ _
      rw [he,hsv]
  have hP : IsPGroup 2 ((V Rg a).comap (embedM Rg)) :=
    ((Q_isPGroup Rg h.relative_radical.isPGroup h.relative_radical.twoCore_le a ha).to_le hVQ).comap_of_injective (embedM Rg) (embedM_injective Rg)
  have hcard : Nat.card (CubicAction.graphImage h e hz hk (V Rg a)) =
      (Q Rg (alpha Rg)).relIndex (V Rg a) := by
    change Nat.card (((V Rg a).comap (embedM Rg)).map π) = _
    rw [CubicAction.permutation_image_card_of_two h e hz hk _ hP]
    rw [←Q_alpha_comap Rg h.relative_radical.isPGroup h.relative_radical.twoCore_le,
      relIndex_comap,map_comap_eq_self (hVG.trans_eq (stabilizer_m_base Rg))]
  rw [←hcard]
  apply (card_le_of_le hbound).trans
  have he : zpowers (v*swap45*v⁻¹) = (zpowers swap45).map (MulAut.conj v).toMonoidHom := by
    rw [MonoidHom.map_zpowers]
    rfl
  rw [he,card_map_of_injective (MulAut.conj v).injective,Nat.card_zpowers]
  exact (show swap45.IsSwap from ⟨4,5,by decide,rfl⟩).orderOf.le

include h e hz hk in
/-- Every radius incident with the same edge as a component vertex has image
at most two there. All nontrivial seed images are the unique transposition
in that edge's marked point core. -/
theorem point_radius_index_le_two
    (u : S) (hR : (Rg).map π ≤ pointCore.map (MulAut.conj u).toMonoidHom)
    {a c t : Vertex Rg} (ha : color Rg a = false) (hc : color Rg c = false)
    (hat : Adjacent Rg a t) (hct : Adjacent Rg c t) :
    (Q Rg c).relIndex (V Rg a) ≤ 2 := by
  obtain ⟨g,hg⟩ := exists_mVertex_of_color Rg hc
  have hbase : act Rg g⁻¹ c = alpha Rg := by
    rw [hg,act_mVertex,mul_inv_cancel]
    rfl
  have hbound := point_radius_image_at_base_le_two h e hz hk u hR
    (a := act Rg g⁻¹ a) (t := act Rg g⁻¹ t)
    (by rwa [action_preserves_color])
    ((adjacent_act_iff Rg _ _ _).mpr hat)
    (by rw [←hbase]; exact (adjacent_act_iff Rg _ _ _).mpr hct)
  rw [←hbase,Q_act,V_act,
    relIndex_map_map_of_injective _ _ (MulAut.conj (g⁻¹)⁻¹).injective] at hbound
  exact hbound

private theorem index_two_supplement {F : Type*} [Group F] (A N V : Subgroup F)
    (hAV : A ≤ V) (hidx : N.relIndex V = 2) (hne : ¬ A ≤ N) :
    (V ⊓ N) ⊔ A = V := by
  classical
  apply le_antisymm (sup_le inf_le_left hAV)
  obtain ⟨a,ha,han⟩ := Set.not_subset.mp hne
  change a ∉ N at han
  intro v hv
  by_cases hvn : v ∈ N
  · exact mem_sup_left ⟨hv,hvn⟩
  have hdiff : v*a⁻¹ ∈ N := by
    apply (N.subgroupOf V).mul_mem_iff_of_index_two hidx
      (a := (⟨v,hv⟩ : V)) (b := (⟨a,hAV ha⟩ : V)⁻¹) |>.mpr
    change v ∈ N ↔ a⁻¹ ∈ N
    simp only [inv_mem_iff,hvn,han]
  have hh : v*a⁻¹*a ∈ (V ⊓ N) ⊔ A :=
    mul_mem (mem_sup_left ⟨V.mul_mem hv (V.inv_mem (hAV ha)),hdiff⟩) (mem_sup_right ha)
  simpa only [inv_mul_cancel_right] using hh

include h e hz hk in
/-- At a critical pair the full midpoint radius has image exactly two at
both endpoints. This concerns the entire radius, with both moving covers. -/
theorem point_critical_midpoint_radius_indices
    (u : S) (hR : (Rg).map π ≤ pointCore.map (MulAut.conj u).toMonoidHom)
    {a a' : Vertex Rg} (p : CriticalPath Rg (sourceGeometry h) a a') :
    (Q Rg a).relIndex (V Rg (p.walk.getVert 2)) = 2 ∧
      (Q Rg a').relIndex (V Rg (p.walk.getVert 2)) = 2 := by
  have hb := point_image_distance_eq_four h e hz hk u hR
  have hl : p.walk.length = 4 := p.length_eq_b.trans hb
  let c := p.walk.getVert 2
  have hc : color Rg c = false := (p.vertex_color (by omega)).mpr (by decide)
  have hct : Adjacent Rg c (p.walk.getVert 1) :=
    adjacent_symm Rg ((cosetGraph_adj Rg _ _).mp (p.walk.adj_getVert_succ (i := 1) (by omega)))
  have hat : Adjacent Rg a (p.walk.getVert 1) := by
    simpa only [SimpleGraph.Walk.getVert_zero] using
      (cosetGraph_adj Rg _ _).mp (p.walk.adj_getVert_succ (i := 0) (by omega))
  have hcs : Adjacent Rg c (p.walk.getVert 3) :=
    (cosetGraph_adj Rg _ _).mp (p.walk.adj_getVert_succ (i := 2) (by omega))
  have has : Adjacent Rg a' (p.walk.getVert 3) := by
    have hh := p.walk.adj_getVert_succ (i := 3) (by omega)
    rw [show 3+1=p.walk.length by omega,p.walk.getVert_length] at hh
    exact adjacent_symm Rg ((cosetGraph_adj Rg _ _).mp hh)
  have hVC : V Rg c ≤ stabilizer Rg c := (sourceGeometry h).V_local c hc (by
    rw [(sourceGeometry h).distance_constant _ hc]; change 2 < sourceDistance h; omega)
  let := finite_stabilizer Rg c
  let : Finite (V Rg c) := Finite.of_injective (inclusion hVC) (inclusion_injective _)
  have hZa : Z Rg a ≤ V Rg c :=
    le_iSup_of_le a (le_iSup_of_le (by
      change (cosetGraph Rg).dist a (p.walk.getVert 2) ≤ 2
      rw [p.dist_start (by omega)]) le_rfl)
  have hZe : Z Rg a' ≤ V Rg c :=
    le_iSup_of_le a' (le_iSup_of_le (by
      change (cosetGraph Rg).dist a' (p.walk.getVert 2) ≤ 2
      rw [SimpleGraph.dist_comm,p.dist_end,hl]) le_rfl)
  have hi := point_image_critical_indices_two h e hz hk u hR p
  constructor
  · apply Nat.le_antisymm (point_radius_index_le_two h e hz hk u hR hc p.start_color hct hat)
    have hh := relIndex_le_of_le_right hZe (index_ne_zero_of_finite (H := (Q Rg a).subgroupOf (V Rg c)))
    rwa [hi.2.1] at hh
  · apply Nat.le_antisymm (point_radius_index_le_two h e hz hk u hR hc p.end_color hcs has)
    have hh := relIndex_le_of_le_right hZa (index_ne_zero_of_finite (H := (Q Rg a').subgroupOf (V Rg c)))
    rwa [hi.1] at hh

include h e hz hk in
/-- Each full critical seed supplements the other endpoint's kernel inside
the literal midpoint radius. No natural quotient is substituted for that radius. -/
theorem point_critical_midpoint_radius_supplements
    (u : S) (hR : (Rg).map π ≤ pointCore.map (MulAut.conj u).toMonoidHom)
    {a a' : Vertex Rg} (p : CriticalPath Rg (sourceGeometry h) a a') :
    (V Rg (p.walk.getVert 2) ⊓ Q Rg a) ⊔ Z Rg a' = V Rg (p.walk.getVert 2) ∧
      (V Rg (p.walk.getVert 2) ⊓ Q Rg a') ⊔ Z Rg a = V Rg (p.walk.getVert 2) := by
  have hb := point_image_distance_eq_four h e hz hk u hR
  have hl : p.walk.length = 4 := p.length_eq_b.trans hb
  have hi := point_critical_midpoint_radius_indices h e hz hk u hR p
  have hr := critical_reverse Rg (sourceGeometry h) (sourceEdgeCentralizer h e)
    a p.start_color (by rw [(sourceGeometry h).distance_constant _ p.start_color]; exact sourceDistance_pos h)
    a' p.end_color p.critical
  constructor
  · apply index_two_supplement _ _ _ ?_ hi.1 hr.2
    exact le_iSup_of_le a' (le_iSup_of_le (by
      rw [SimpleGraph.dist_comm,p.dist_end,hl]) le_rfl)
  · apply index_two_supplement _ _ _ ?_ hi.2 p.critical.2
    exact le_iSup_of_le a (le_iSup_of_le (by rw [p.dist_start (by omega)]) le_rfl)

include h e hz hk in
/-- The entire midpoint radius induces precisely the critical line on each
endpoint seed. This is an equality of subgroups in the original amalgam. -/
theorem point_critical_midpoint_radius_commutators
    (u : S) (hR : (Rg).map π ≤ pointCore.map (MulAut.conj u).toMonoidHom)
    {a a' : Vertex Rg} (p : CriticalPath Rg (sourceGeometry h) a a') :
    ⁅Z Rg a,V Rg (p.walk.getVert 2)⁆ = ⁅Z Rg a,Z Rg a'⁆ ∧
      ⁅Z Rg a',V Rg (p.walk.getVert 2)⁆ = ⁅Z Rg a,Z Rg a'⁆ := by
  have hs := point_critical_midpoint_radius_supplements h e hz hk u hR p
  have hZa : Z Rg a ≤ stabilizer Rg a' := Z_le_stabilizer_of_dist_le a _ p.critical.1.le
  have hZe : Z Rg a' ≤ stabilizer Rg a :=
    critical_Z_le_stabilizer Rg (sourceGeometry h) a p.start_color
      (by rw [(sourceGeometry h).distance_constant _ p.start_color]; exact sourceDistance_pos h) p.critical
  constructor
  · exact (commutator_eq_of_centralizing_sup hs.1
      (inf_le_right.trans (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp
        (Z_centralizes_Q Rg a p.start_color)))) (hZe.trans (Z_normalized Rg a))).symm
  · rw [commutator_comm (Z Rg a) (Z Rg a')]
    exact (commutator_eq_of_centralizing_sup hs.2
      (inf_le_right.trans (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp
        (Z_centralizes_Q Rg a' p.end_color)))) (hZa.trans (Z_normalized Rg a'))).symm

include h e hz hk in
/-- The two full critical kernels centralize the entire midpoint radius. -/
theorem point_critical_kernels_centralize_midpoint_radius
    (u : S) (hR : (Rg).map π ≤ pointCore.map (MulAut.conj u).toMonoidHom)
    {a a' : Vertex Rg} (p : CriticalPath Rg (sourceGeometry h) a a') :
    Z Rg a ⊓ Q Rg a' ≤ centralizer (V Rg (p.walk.getVert 2) : Set (FreeAmalgam Rg)) ∧
      Z Rg a' ⊓ Q Rg a ≤ centralizer (V Rg (p.walk.getVert 2) : Set (FreeAmalgam Rg)) := by
  have hs := point_critical_midpoint_radius_supplements h e hz hk u hR p
  have hZa := commutator_eq_bot_iff_le_centralizer.mp (Z_centralizes_Q Rg a p.start_color)
  have hZe := commutator_eq_bot_iff_le_centralizer.mp (Z_centralizes_Q Rg a' p.end_color)
  constructor
  · apply le_centralizer_iff.mpr
    rw [←hs.1]
    exact sup_le ((inf_le_right.trans (le_centralizer_iff.mp hZa)).trans (centralizer_le inf_le_left))
      (hZe.trans (centralizer_le inf_le_right))
  · apply le_centralizer_iff.mpr
    rw [←hs.2]
    exact sup_le ((inf_le_right.trans (le_centralizer_iff.mp hZe)).trans (centralizer_le inf_le_left))
      (hZa.trans (centralizer_le inf_le_right))

include h e hz hk in
/-- A selected central critical line controls the full orbit span against
its entire midpoint radius, without a forward-slice hypothesis. -/
theorem point_selected_span_radius_commutator
    (u : S) (hR : (Rg).map π ≤ pointCore.map (MulAut.conj u).toMonoidHom)
    {c d : Vertex Rg} (q : CriticalPath Rg (sourceGeometry h) c d)
    (hq : q.walk.getVert 2 = alpha Rg)
    (hd : d ∈ Set.range (fun x : stabilizer Rg (alpha Rg) => act Rg x c))
    (hcentral : ⁅Z Rg c,Z Rg d⁆ ≤
      centralizer (stabilizer Rg (alpha Rg) : Set (FreeAmalgam Rg))) :
    ⁅localZSpan Rg c (alpha Rg),V Rg (alpha Rg)⁆ = ⁅Z Rg c,Z Rg d⁆ ∧
      ⁅localZSpan Rg c (alpha Rg),localZSpan Rg c (alpha Rg)⁆ = ⁅Z Rg c,Z Rg d⁆ := by
  let P := localZSpan Rg c (alpha Rg)
  let D₀ := ⁅Z Rg c,Z Rg d⁆
  have hb := point_image_distance_eq_four h e hz hk u hR
  have hl : q.walk.length = 4 := q.length_eq_b.trans hb
  have hdist : (cosetGraph Rg).dist c (alpha Rg) ≤ 2 := by
    rw [←hq,q.dist_start (by omega)]
  have hPV : P ≤ V Rg (alpha Rg) := localZSpan_le_V Rg hdist
  have hZcG : Z Rg c ≤ stabilizer Rg (alpha Rg) :=
    ((Z_le_localZSpan Rg _ _).trans hPV).trans ((sourceGeometry h).V_local _ rfl (by
      change 2 < sourceDistance h; omega))
  have hDN : stabilizer Rg (alpha Rg) ≤ normalizer (D₀ : Set (FreeAmalgam Rg)) :=
    (le_centralizer_iff.mp hcentral).trans (Subgroup.centralizer_le_normalizer _)
  have hZV := (point_critical_midpoint_radius_commutators h e hz hk u hR q).1
  rw [hq] at hZV
  have hPD : ⁅P,V Rg (alpha Rg)⁆ ≤ D₀ := by
    dsimp only [P]
    rw [localZSpan_eq_conjugates]
    apply commutator_iSup_le_of_relative_normal (stabilizer Rg (alpha Rg))
      (V Rg (alpha Rg)) _ _ hDN
    · intro g
      have hgmap : (stabilizer Rg (alpha Rg)).map
          (MulAut.conj (g : FreeAmalgam Rg)⁻¹).toMonoidHom = stabilizer Rg (alpha Rg) :=
        mem_normalizer_iff_map_conj_eq.mp ((stabilizer Rg (alpha Rg)).le_normalizer
          ((stabilizer Rg (alpha Rg)).inv_mem g.property))
      exact (map_mono hZcG).trans_eq hgmap
    · intro g
      have hm := map_mono (f := (MulAut.conj (g : FreeAmalgam Rg)⁻¹).toMonoidHom) hZV.le
      have hVm := mem_normalizer_iff_map_conj_eq.mp (DistanceEight.V_normalized Rg
        (alpha Rg) ((stabilizer Rg (alpha Rg)).inv_mem g.property))
      change (V Rg (alpha Rg)).map (MulAut.conj (g : FreeAmalgam Rg)⁻¹).toMonoidHom = V Rg (alpha Rg) at hVm
      have hDm := mem_normalizer_iff_map_conj_eq.mp (hDN
        ((stabilizer Rg (alpha Rg)).inv_mem g.property))
      change D₀.map (MulAut.conj (g : FreeAmalgam Rg)⁻¹).toMonoidHom = D₀ at hDm
      change ⁅Z Rg c,V Rg (alpha Rg)⁆.map
        (MulAut.conj (g : FreeAmalgam Rg)⁻¹).toMonoidHom ≤ D₀.map
        (MulAut.conj (g : FreeAmalgam Rg)⁻¹).toMonoidHom at hm
      rwa [map_commutator,hVm,hDm] at hm
  have hcP : Z Rg c ≤ P := Z_le_localZSpan Rg _ _
  have hdP : Z Rg d ≤ P := by
    obtain ⟨x,rfl⟩ := hd
    rw [Z_act]
    exact (map_mono hcP).trans_eq (mem_normalizer_iff_map_conj_eq.mp
      (localZSpan_normalized Rg _ _ ((stabilizer Rg (alpha Rg)).inv_mem x.property)))
  have hDP : D₀ ≤ ⁅P,P⁆ := commutator_mono hcP hdP
  have hPP : ⁅P,P⁆ ≤ D₀ := (commutator_mono le_rfl hPV).trans hPD
  exact ⟨le_antisymm hPD (hDP.trans (commutator_mono le_rfl hPV)),le_antisymm hPP hDP⟩

include h e hz hk in
/-- Point-core containment supplies a nonabelian selected span whose entire
radius commutator and derived subgroup are the same central order-two line.
No small-forward-slice premise remains. -/
theorem point_image_selected_span_radius_line
    (u : S) (hR : (Rg).map π ≤ pointCore.map (MulAut.conj u).toMonoidHom) :
    ∃ a', ∃ p : CriticalPath Rg (sourceGeometry h) (alpha Rg) a',
      let P := localZSpan Rg (p.walk.getVert 2) (alpha Rg)
      Nat.card (⁅P,P⁆ : Subgroup (FreeAmalgam Rg)) = 2 ∧
      ⁅P,P⁆ ≤ centralizer (stabilizer Rg (alpha Rg) : Set (FreeAmalgam Rg)) ∧
      ⁅P,V Rg (alpha Rg)⁆ = ⁅P,P⁆ := by
  obtain ⟨hb,a',p,_,c,t,x,hx,hxc,_,_,_,q,_,hover,_,_,hcard,hcentral⟩ :=
    point_image_small_central_generating_configuration h e hz hk u hR
  have hl : p.walk.length = 4 := p.length_eq_b.trans hb
  have hq2 : q.walk.getVert 2 = alpha Rg := by
    simpa only [Nat.zero_add,SimpleGraph.Walk.getVert_zero] using hover 0 (Nat.zero_le _)
  let qr : CriticalPath Rg (sourceGeometry h) (p.walk.getVert (p.walk.length-2)) c :=
    ⟨q.end_color,q.walk.reverse,
      by rw [SimpleGraph.Walk.length_reverse,q.shortest,SimpleGraph.dist_comm],
      critical_reverse Rg (sourceGeometry h) (sourceEdgeCentralizer h e) c q.start_color
        (by rw [(sourceGeometry h).distance_constant _ q.start_color]; exact sourceDistance_pos h)
        _ q.end_color q.critical⟩
  have hqr2 : qr.walk.getVert 2 = alpha Rg := by
    change q.walk.reverse.getVert 2 = _
    rw [SimpleGraph.Walk.getVert_reverse,show q.walk.length = 4 from q.length_eq_b.trans hb]
    exact hq2
  have hc : c ∈ Set.range (fun g : stabilizer Rg (alpha Rg) =>
      act Rg g (p.walk.getVert (p.walk.length-2))) := by
    refine ⟨⟨x,hx⟩,?_⟩
    simpa only [hl,Nat.reduceSub] using hxc
  have hcent : ⁅Z Rg (p.walk.getVert (p.walk.length-2)),Z Rg c⁆ ≤
      centralizer (stabilizer Rg (alpha Rg) : Set (FreeAmalgam Rg)) := by
    rwa [commutator_comm]
  have hs := point_selected_span_radius_commutator h e hz hk u hR qr hqr2 hc hcent
  rw [commutator_comm (Z Rg (p.walk.getVert (p.walk.length-2))) (Z Rg c)] at hs
  have hcardP : Nat.card (⁅localZSpan Rg (p.walk.getVert (p.walk.length-2)) (alpha Rg),
      localZSpan Rg (p.walk.getVert (p.walk.length-2)) (alpha Rg)⁆ : Subgroup (FreeAmalgam Rg)) = 2 := by
    rw [hs.2]
    exact hcard
  refine ⟨a',p,?_⟩
  simpa only [hl,Nat.reduceSub] using
    And.intro hcardP (And.intro (hs.2.trans_le hcentral) (hs.1.trans hs.2.symm))

omit hk in
include h e hz in
/-- Whole-core application retaining the full cubic point-core radius line,
with the plane and Sylow images as separate unresolved alternatives. -/
theorem coreExhaustion_or_cubic_point_radius_line :
    CoreExhaustion L R ∨ ∃ hk : layerKernel L R = extensionKernel h,
      Function.Surjective (CubicAction.projection h e hz hk) ∧
      2 < sourceDistance h ∧
      (∀ a : Vertex Rg, color Rg a = false →
        Nat.card (U Rg a) = 16 ∨ Nat.card (U Rg a) = 32) ∧
      ∃ u : S,
        ((Rg).map (CubicAction.projection h e hz hk) =
            pointCore.map (MulAut.conj u).toMonoidHom ∧
          sourceDistance h = 4 ∧
          (∀ (a a' : Vertex Rg) (p : CriticalPath Rg (sourceGeometry h) a a'),
            (Q Rg a).relIndex (V Rg (p.walk.getVert 2)) = 2 ∧
            (Q Rg a').relIndex (V Rg (p.walk.getVert 2)) = 2) ∧
          ∃ a', ∃ p : CriticalPath Rg (sourceGeometry h) (alpha Rg) a',
            let P := localZSpan Rg (p.walk.getVert 2) (alpha Rg)
            Nat.card (⁅P,P⁆ : Subgroup (FreeAmalgam Rg)) = 2 ∧
            ⁅P,P⁆ ≤ centralizer (stabilizer Rg (alpha Rg) : Set (FreeAmalgam Rg)) ∧
            ⁅P,V Rg (alpha Rg)⁆ = ⁅P,P⁆) ∨
        (Rg).map (CubicAction.projection h e hz hk) =
          D.map (MulAut.conj u).toMonoidHom ∨
        (Rg).map (CubicAction.projection h e hz hk) =
          borel.map (MulAut.conj u).toMonoidHom := by
  rcases coreExhaustion_or_cubic_radical_cases h e hz with
    hx | ⟨hk,hs,hb,hcovers,u,hpoint | hplane | hsylow⟩
  · exact Or.inl hx
  · refine Or.inr ⟨hk,hs,hb,hcovers,u,Or.inl ?_⟩
    exact ⟨hpoint.2,hpoint.1,
      fun _ _ p => point_critical_midpoint_radius_indices h e hz hk u hpoint.2.le p,
      point_image_selected_span_radius_line h e hz hk u hpoint.2.le⟩
  · exact Or.inr ⟨hk,hs,hb,hcovers,u,Or.inr (Or.inl hplane)⟩
  · exact Or.inr ⟨hk,hs,hb,hcovers,u,Or.inr (Or.inr hsylow)⟩

