module

public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.SmallExtension
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.Recognition.Parabolics.Alternatives.Interfaces

/-!
# The core calculation in the noncentral small-extension branch

This file records the group-theoretic part of the last paragraph of the proof
of 15.3.31.  The model owners supply actual natural (or dual-natural) layer
models.  We keep their output as a family of *ambient subgroups* and require
the intertwining facts needed by the conjugation argument.  Thus the theorem
below applies to an actual model action; a name or an isomorphism of abstract
groups alone cannot be used in its place.

The main point is that an irreducible natural summand meeting `Y₊` nontrivially
is generated by that intersection and its `L`-conjugates.  For a cover of `Q`
this gives the hypotheses of `centralizes_extensionCore_of_conjugate_generation`.
The quotient-centralizer and marked-line calculations remain model-specific
inputs to the two constructors at the end of the file.  They are deliberately
separate from the generic generation argument, so that a C.1.34(3) dual layer
cannot be silently discarded.

Source: Aschbacher--Smith, combined manuscript (1 March 2004), printed
p.1132 (PDF p.1149), proof of 15.3.31.
-/

@[expose] public section

open Subgroup
open scoped commutatorElement

namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration
namespace SmallExtension

variable {G : Type*} [Group G]

/-! ## Actual summands and their cover -/

/- A summand is an ambient subgroup.  `irreducible` is stated for the actual
conjugation action of `L`; no representation tag is used. -/
structure SummandData (d : LocalData G) {I : Subgroup G}
    (c : ComponentWitness d I) where
  W : Subgroup G
  le_core : W ≤ extensionCore c.L
  normalized : c.L ≤ normalizer (W : Set G)
  irreducible : ∀ N : Subgroup G, N ≤ W →
    c.L ≤ normalizer (N : Set G) → N = ⊥ ∨ N = W
  intersection_ne_bot : W ⊓ d.Yplus ≠ ⊥

/- The source's “hyperplane” conclusion is retained as a separate field.  It
is useful to consumers that need the dimension statement, while generation
uses only the nonzero intersection above. -/
structure HyperplaneData (d : LocalData G) {I : Subgroup G}
    (c : ComponentWitness d I) extends SummandData d c where
  intersection_is_maximal : W ⊓ d.Yplus < W
  intersection_maximal : ∀ U : Subgroup G, W ⊓ d.Yplus ≤ U →
    U ≤ W → U = W ⊓ d.Yplus ∨ U = W

/- A finite family of the actual summands covering `Q`. -/
structure CoverData (d : LocalData G) {I : Subgroup G}
    (c : ComponentWitness d I) (ι : Sort*) where
  summand : ι → SummandData d c
  cover : extensionCore c.L ≤ ⨆ i, (summand i).W
  abelian : IsMulCommutative (extensionCore c.L)

theorem summand_span_eq (d : LocalData G) {I : Subgroup G}
    (c : ComponentWitness d I) (s : SummandData d c) :
    localSpan (s.W ⊓ d.Yplus) c.L = s.W := by
  exact span_intersection_eq_of_irreducible s.normalized s.irreducible
    s.intersection_ne_bot

theorem cover_generation (d : LocalData G) {I : Subgroup G}
    (c : ComponentWitness d I) {ι : Sort*} (a : CoverData d c ι) :
    extensionCore c.L ≤ localSpan (extensionCore c.L ⊓ d.Yplus) c.L := by
  exact core_le_span_of_irreducible_cover d c (fun i => (a.summand i).W)
    a.cover (fun i => (a.summand i).le_core)
    (fun i => (a.summand i).normalized)
    (fun i => (a.summand i).irreducible)
    (fun i => (a.summand i).intersection_ne_bot)

/- The preceding proof also gives the exact type of the cover needed by the
existing centralization reduction. -/
theorem centralizes_of_cover (d : LocalData G) {I : Subgroup G}
    (c : ComponentWitness d I) {ι : Sort*} (a : CoverData d c ι)
    (hDL : ⁅yplusCentralizer d I, c.L⁆ ≤ extensionCore c.L) :
    yplusCentralizer d I ≤ centralizer (extensionCore c.L : Set G) := by
  apply centralizes_extensionCore_of_conjugate_generation d c a.abelian hDL
  exact cover_generation d c a

/-! ## The noncentral branch -/

/- This is the precise contradiction used after the marked model has supplied
the commutator bound.  It does not turn noncentrality into an assumed
centralizer equality. -/
theorem noncentral_core_false (d : LocalData G) {I : Subgroup G}
    (c : ComponentWitness d I) {ι : Sort*} (a : CoverData d c ι)
    (hDL : ⁅yplusCentralizer d I, c.L⁆ ≤ extensionCore c.L)
    (hnoncentral : ¬ yplusCentralizer d I ≤
      centralizer (extensionCore c.L : Set G)) : False := by
  exact hnoncentral (centralizes_of_cover d c a hDL)

/- The model-specific centralizer estimate `C_L(Q) ≤ O₂(L)` is enough to
construct the commutator bound required above.  This is the assembly theorem
used by the parent once its quotient and marked-module calculations are in
place. -/
theorem noncentral_core_false_of_centralizer_bound [Finite G]
    (d : LocalData G) {I : Subgroup G} (c : ComponentWitness d I)
    {ι : Sort*} (a : CoverData d c ι)
    (hYL : d.Yplus ≤ c.L)
    (hnormal : (c.L.subgroupOf I).Normal)
    (hCQ : c.L ⊓ centralizer (extensionCore c.L : Set G) ≤ c.L.pCoreIn 2)
    (hDQ : yplusCentralizer d I ≤ centralizer (extensionCore c.L : Set G))
    (hnoncentral : ¬ yplusCentralizer d I ≤
      centralizer (extensionCore c.L : Set G)) : False := by
  apply noncentral_core_false d c a
    (commutator_le_core_of_centralizes d c hYL hnormal hCQ hDQ)
  exact hnoncentral

end SmallExtension
end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration

end
