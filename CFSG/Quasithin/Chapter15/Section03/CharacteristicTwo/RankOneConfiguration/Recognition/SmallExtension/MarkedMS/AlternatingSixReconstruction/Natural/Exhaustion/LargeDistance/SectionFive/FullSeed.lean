/-!
# Full-seed line selection and the selected terminal contradiction

A small critical seed image is generated by a transposition. Its fixed index
on the full starting seed is two; conjugation gives displacement rank one
for every transposition on that entire seed. The marked moved cover supplies
an equivariant augmentation-core map that is nonzero on every pair vector.
For any seed vector, the five adjacent transpositions determine six binary
coordinates. Generation of S₆ then identifies every displacement with the
image of the ordinary permutation displacement of those coordinates.

A noncentral seed vector has two unequal coordinates. One alternating
conjugator places them at the prescribed critical transposition. Permutations
of equal-coordinate letters fix the conjugate; those permutations together
with the critical transposition generate S₆. Lifting through the original
projection gives a generating centralizer and a moved line, with the same
conjugator. This works on the full seed, without assuming that the line lies
in the moved cover, and preserves both cover orders and the constant kernel.

The forward closure argument now proves centrality of the full forward line.
Relative normal generation identifies it with the nonabelian selected span's
derived subgroup. Transporting this calculation along the actual opposite
path discharges both derived-fixedness premises of the terminal contradiction.
The natural-quotient application and full-core terminal application below use
the literal midpoint orbit, slice kernels, quotient action, and conjugators.

The source still must supply the selected midpoint orbit and its two slice
bounds. The strict radius bound, intermediate R₄/R₆ noncentrality, and both
unconditional distance exclusions remain with
qt-e-ms-small-a6-exhaustion-large-distance; this is not an unconditional
proof of (5.11) or (5.12). Whole-core reconstruction remains with
qt-e-ms-small-a6-reconstruction.

Source: MS93 (3.3)(ii), (5.9), and (5.12), printed pp.866--867,
920--922, 924--927. The full-seed coordinate argument extends the checked
cover-line choice in `CoordinatedLines`; the actual closure proof uses
`ForwardClosure.small_critical_controlled_line_false`.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender BinaryPermutation
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS
namespace AlternatingSixReconstruction.Natural.Exhaustion.LargeDistance.SectionFive
namespace SeedCoordinates
abbrev S := Equiv.Perm (Fin 6)
def pairVector (i j : Fin 6) : core (Fin 6) :=
  ⟨Pi.single i 1 + Pi.single j 1, by simp [mem_core, Finset.sum_add_distrib]⟩
def adjacent (i : Fin 5) : S := Equiv.swap i.castSucc i.succ

def displacement (g : S) (w : Full (Fin 6)) : core (Fin 6) :=
  ⟨representation (Fin 6) g w - w, by
    change augmentation (Fin 6) _ = 0
    rw [map_sub,augmentation_permute,sub_self]⟩

theorem displacement_mul (g t : S) (w : Full (Fin 6)) :
    displacement (g*t) w = coreRepresentation (Fin 6) g (displacement t w) + displacement g w := by
  apply Subtype.ext
  change representation (Fin 6) (g*t) w-w =
    representation (Fin 6) g (representation (Fin 6) t w-w) + (representation (Fin 6) g w-w)
  rw [map_mul,Module.End.mul_apply,map_sub]
  abel

private theorem pair_displacement : ∀ i : Fin 5, ∃ v : core (Fin 6),
    coreRepresentation (Fin 6) (adjacent i) v-v = pairVector i.castSucc i.succ := by
  intro i
  refine ⟨![pairVector 0 2,pairVector 1 3,pairVector 2 4,pairVector 3 5,pairVector 4 0] i,?_⟩
  have he : ∀ i : Fin 5, coreRepresentation (Fin 6) (adjacent i)
      (![pairVector 0 2,pairVector 1 3,pairVector 2 4,pairVector 3 5,pairVector 4 0] i) -
      (![pairVector 0 2,pairVector 1 3,pairVector 2 4,pairVector 3 5,pairVector 4 0] i) =
      pairVector i.castSucc i.succ := by decide +kernel
  exact he i

private def coordinates (a : Fin 5 → ZMod 2) : Full (Fin 6) :=
  ![0,a 0,a 0+a 1,a 0+a 1+a 2,a 0+a 1+a 2+a 3,a 0+a 1+a 2+a 3+a 4]

private theorem coordinates_displacement : ∀ (a : Fin 5 → ZMod 2) (i : Fin 5),
    displacement (adjacent i) (coordinates a) = a i • pairVector i.castSucc i.succ := by
  decide +kernel

variable {Y : Type*} [AddCommGroup Y] [Module (ZMod 2) Y] [FiniteDimensional (ZMod 2) Y]

/-- Rank-one transpositions encode every displacement by a full six-letter
vector; the map from the augmentation core may retain its constant kernel. -/
theorem exists_coordinates
    (ρ : Representation (ZMod 2) S Y)
    (j : (coreRepresentation (Fin 6)).IntertwiningMap ρ)
    (hj : ∀ i : Fin 5, j (pairVector i.castSucc i.succ) ≠ 0)
    (hsmall : ∀ i : Fin 5, fixedCodim ρ (zpowers (adjacent i)) ≤ 1)
    (z : Y) :
    ∃ w : Full (Fin 6), ∀ g : S, ρ g z-z = j (displacement g w) := by
  have hline (i : Fin 5) : ∃ a : ZMod 2,
      ρ (adjacent i) z-z = a • j (pairVector i.castSucc i.succ) := by
    let D := ρ (adjacent i)-LinearMap.id
    have hdim : Module.finrank (ZMod 2) D.range ≤ 1 := by
      dsimp only [D]
      rw [←fixedCodim_zpowers_eq_displacement_rank]
      exact hsmall i
    obtain ⟨v,hv⟩ := pair_displacement i
    have hmem : j (pairVector i.castSucc i.succ) ∈ D.range := by
      refine ⟨j v,?_⟩
      change ρ (adjacent i) (j v)-j v = _
      rw [←j.isIntertwining,←map_sub,hv]
    have hle : Submodule.span (ZMod 2) {j (pairVector i.castSucc i.succ)} ≤ D.range :=
      Submodule.span_le.mpr (by simpa using hmem)
    have he : Submodule.span (ZMod 2) {j (pairVector i.castSucc i.succ)} = D.range :=
      Submodule.eq_of_le_of_finrank_le hle (by rw [finrank_span_singleton (hj i)];exact hdim)
    have hz : ρ (adjacent i) z-z ∈ Submodule.span (ZMod 2) {j (pairVector i.castSucc i.succ)} :=
      he.symm ▸ (show D z ∈ D.range from LinearMap.mem_range_self D z)
    obtain ⟨a,ha⟩ := Submodule.mem_span_singleton.mp hz
    exact ⟨a,ha.symm⟩
  choose a ha using hline
  refine ⟨coordinates a,?_⟩
  intro g
  have hg : g ∈ Submonoid.closure (Set.range adjacent) := by
    rw [show Submonoid.closure (Set.range adjacent) = ⊤ from Equiv.Perm.mclosure_swap_castSucc_succ 5]
    trivial
  induction hg using Submonoid.closure_induction with
  | mem x hx =>
      obtain ⟨i,rfl⟩ := hx
      rw [coordinates_displacement,map_smul]
      exact ha i
  | one =>
      have he : displacement 1 (coordinates a) = 0 := by apply Subtype.ext; simp [displacement]
      rw [he,map_zero,map_one,Module.End.one_apply,sub_self]
  | mul g t _ _ hg ht =>
      rw [displacement_mul,map_add,j.isIntertwining,←ht,←hg,map_mul,Module.End.mul_apply,map_sub]
      abel

end SeedCoordinates
namespace SeedCoordinates
open Equiv
variable {Y : Type*} [AddCommGroup Y] [Module (ZMod 2) Y]

private theorem displacement_swap : ∀ (w : Full (Fin 6)) (i j : Fin 6),
    displacement (swap i j) w = (w i+w j) • pairVector i j := by
  intro w i j
  apply Subtype.ext
  ext k
  by_cases hki : k=i
  · subst k
    by_cases hij : i=j
    · subst j; simp [displacement,pairVector,representation_apply]
    · simp [displacement,pairVector,representation_apply,hij,CharTwo.sub_eq_add,add_comm]
  · by_cases hkj : k=j
    · subst k
      simp [displacement,pairVector,representation_apply,hki,CharTwo.sub_eq_add]
    · simp [displacement,pairVector,representation_apply,swap_apply_def,hki,hkj]

private theorem binary_partition_generation (w : Full (Fin 6)) (i j : Fin 6)
    (hne : w i ≠ w j) (H : Subgroup S)
    (hfix : ∀ x y, w x = w y → swap x y ∈ H) (hij : swap i j ∈ H) : H = ⊤ := by
  apply top_unique
  rw [←Equiv.Perm.closure_isSwap,Subgroup.closure_le]
  rintro _ ⟨x,y,_,rfl⟩
  by_cases hxy : w x=w y
  · exact hfix x y hxy
  have htwo : ∀ c : ZMod 2, c=w i ∨ c=w j := by
    exact (by decide : ∀ a b : ZMod 2, a ≠ b → ∀ c, c=a ∨ c=b) _ _ hne
  rcases htwo (w x) with hx | hx
  · have hy : w y=w j := (htwo (w y)).resolve_left (fun hy => hxy (hx.trans hy.symm))
    exact SubmonoidClass.swap_mem_trans H
      (SubmonoidClass.swap_mem_trans H (hfix x i hx) hij) (hfix j y hy.symm)
  · have hy : w y=w i := (htwo (w y)).resolve_right (fun hy => hxy (hx.trans hy.symm))
    exact SubmonoidClass.swap_mem_trans H
      (SubmonoidClass.swap_mem_trans H (hfix x j hx) (by simpa only [swap_comm] using hij))
      (hfix i y hy.symm)

/-- A nonfixed full-seed vector admits one alternating conjugate whose
stabilizer and a prescribed transposition generate S₆. The same transposition
moves that conjugate. -/
theorem exists_generating_conjugate
    (ρ : Representation (ZMod 2) S Y)
    (j : (coreRepresentation (Fin 6)).IntertwiningMap ρ)
    (hj : ∀ i k : Fin 6, i ≠ k → j (pairVector i k) ≠ 0)
    (z : Y) (w : Full (Fin 6))
    (hw : ∀ g : S, ρ g z-z = j (displacement g w))
    (hz : ¬ ∀ g : S, ρ g z=z) (t : S) (ht : t.IsSwap) :
    ∃ g : alternatingGroup (Fin 6),
      ρ t (ρ g.val z) ≠ ρ g.val z ∧
      ∀ H : Subgroup S, (∀ x, ρ x (ρ g.val z)=ρ g.val z → x∈H) → t∈H → H=⊤ := by
  have hnc : ∃ a b : Fin 6, w a ≠ w b := by
    by_contra! he
    apply hz
    intro g
    apply sub_eq_zero.mp
    rw [hw]
    have hd : displacement g w = 0 := by
      apply Subtype.ext
      ext k
      exact sub_eq_zero.mpr (he (g.symm k) k)
    rw [hd,map_zero]
  obtain ⟨a,b,hab⟩ := hnc
  obtain ⟨i,k,hik,rfl⟩ := ht
  have hab' : a ≠ b := fun he => hab (congrArg w he)
  let : MulAction.IsMultiplyPretransitive (alternatingGroup (Fin 6)) (Fin 6) 2 := by
    have := alternatingGroup.isMultiplyPretransitive (Fin 6)
    apply MulAction.isMultiplyPretransitive_of_le (n := Nat.card (Fin 6)-2) (by simp) (Nat.sub_le _ _)
  obtain ⟨g,hga,hgb⟩ := MulAction.is_two_pretransitive_iff.mp
    (inferInstance : MulAction.IsMultiplyPretransitive (alternatingGroup (Fin 6)) (Fin 6) 2) hab' hik
  change g.val a=i at hga
  change g.val b=k at hgb
  let w' := representation (Fin 6) g.val w
  have hcol : w' i ≠ w' k := by
    change w (g.val.symm i) ≠ w (g.val.symm k)
    rw [(Equiv.symm_apply_eq _).mpr hga.symm,(Equiv.symm_apply_eq _).mpr hgb.symm]
    exact hab
  have htransport (x : S) : ρ x (ρ g.val z)-ρ g.val z = j (displacement x w') := by
    have h1 := hw (x*g.val)
    have h2 := hw g.val
    rw [map_mul,Module.End.mul_apply] at h1
    have he : displacement (x*g.val) w-displacement g.val w = displacement x w' := by
      apply Subtype.ext
      change (representation (Fin 6) (x*g.val) w-w)-(representation (Fin 6) g.val w-w) = _
      rw [map_mul,Module.End.mul_apply]
      dsimp [displacement,w']
      abel
    calc
      _ = (ρ x (ρ g.val z)-z)-(ρ g.val z-z) := by abel
      _ = j (displacement (x*g.val) w)-j (displacement g.val w) := by rw [h1,h2]
      _ = _ := by rw [←map_sub,he]
  have hswap (x y : Fin 6) (he : w' x=w' y) : ρ (swap x y) (ρ g.val z)=ρ g.val z := by
    apply sub_eq_zero.mp
    rw [htransport,displacement_swap,he,CharTwo.add_self_eq_zero,zero_smul,map_zero]
  refine ⟨g,?_,?_⟩
  · intro he
    have hh := htransport (swap i k)
    rw [he,sub_self,displacement_swap,map_smul] at hh
    have hbit : w' i+w' k=1 :=
      (by decide : ∀ a b : ZMod 2, a≠b → a+b=1) _ _ hcol
    rw [hbit,one_smul] at hh
    exact hj i k hik hh.symm
  · intro H hH ht
    exact binary_partition_generation w' i k hcol H (fun x y hxy => hH _ (hswap x y hxy)) ht
end SeedCoordinates
end AlternatingSixReconstruction.Natural.Exhaustion.LargeDistance.SectionFive
