open Theory.GroupTheory
open scoped commutatorElement IsMulCommutative
open CFSG.Quasithin.ChapterC.BinaryMS.MS93 Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS
namespace AlternatingSixReconstruction.Natural.Exhaustion.LargeDistance.SectionFive
universe u
section General
variable {G : Type u} [Group G] [Finite G] {κ : GroupClass.{u}} {L R : Subgroup G}
  {h : SmallMSPair κ L R} {e : CentralMarking L}
  {hz : center (L ⧸ pCore 2 L) = ⊥} {hn : InitialNatural h e hz}
  {d : Replacement L R} (s : FullSymmetricAction h e hz hn d)

include h in
/-- The literal seed preimage is elementary abelian. -/
theorem seed_elementary : IsElementaryAbelian 2 (radiusSeed d) := by
  let := (replacementGeometry h d).Z_elementary (replacementDistance_pos h d) (alpha d.radical) rfl
  exact IsElementaryAbelian.comap_of_injective (p := 2) (embedM d.radical)
    (embedM_injective d.radical) (Z d.radical (alpha d.radical))

include s in
/-- The full seed has exactly the original two-core as its centralizer. -/
theorem seed_centralizer (hc : DistanceTwo.CentralLayer d) :
    centralizer (radiusSeed d : Set d.overgroup) = pCore 2 d.overgroup := by
  apply le_antisymm
  · rw [←moved_centralizer s]
    apply centralizer_le
    intro v hv
    have hh := mem_map_of_mem (embedM d.radical) hv
    rw [←hc.U_eq_moved] at hh
    exact DistanceEight.U_le_Z d.radical _ hh
  · intro q hq z hz
    apply embedM_injective d.radical
    simp only [map_mul]
    have hQ : embedM d.radical q ∈ Q d.radical (alpha d.radical) := by
      rw [Q_alpha d.radical (replacement_radical_isPGroup h d) (replacement_core_le_radical h d)]
      exact mem_map_of_mem _ hq
    exact (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp
      (Z_centralizes_Q d.radical (alpha d.radical) rfl))) hQ _ hz

section SeedAction
variable [IsElementaryAbelian 2 (radiusSeed d)]

/-- Conjugation on the full seed through the original symmetric projection. -/
noncomputable def seedAction (hc : DistanceTwo.CentralLayer d) :
    Representation (ZMod 2) (Equiv.Perm (Fin 6)) (Additive (radiusSeed d)) :=
  NormalElementaryQuotient.representation _ s.projection s.surjective
    (s.projection_kernel.trans (seed_centralizer s hc).symm)

/-- The descended seed action agrees with literal replacement conjugation. -/
theorem seedAction_conjugate (hc : DistanceTwo.CentralLayer d)
    (g : d.overgroup) (z : Additive (radiusSeed d)) :
    ((seedAction s hc (s.projection g) z).toMul : d.overgroup) = g*z.toMul*g⁻¹ :=
  NormalElementaryQuotient.representation_apply _ _ _ _ g z
include s in
/-- One small critical pair makes every transposition a transvection on the
entire seed, including all its central attachments. -/
theorem seed_transposition_rank_one (hc : DistanceTwo.CentralLayer d)
    {a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) a')
    (hsmall : (Q d.radical a').relIndex (Z d.radical (alpha d.radical)) < 4)
    (i j : Fin 6) (hij : i ≠ j) :
    Module.finrank (ZMod 2) (LinearMap.range (seedAction s hc (Equiv.swap i j)-LinearMap.id)) = 1 := by
  let A := (Z d.radical a').comap (embedM d.radical)
  have hmA : A.map (embedM d.radical) = Z d.radical a' := map_comap_eq_self
    ((critical_Z_le_stabilizer d.radical (replacementGeometry h d) (alpha d.radical)
      rfl (replacementDistance_pos h d) p.critical).trans_eq (stabilizer_m_base d.radical))
  have hmZ : (radiusSeed d).map (embedM d.radical) = Z d.radical (alpha d.radical) :=
    map_comap_eq_self ((Z_le_stabilizer d.radical _).trans_eq (stabilizer_m_base d.radical))
  have hfixed : Z d.radical (alpha d.radical) ⊓ centralizer (Z d.radical a' : Set (FreeAmalgam d.radical)) =
      Z d.radical (alpha d.radical) ⊓ Q d.radical a' := by
    apply le_antisymm
    · intro x hx
      refine ⟨hx.1,?_⟩
      rw [←C_eq_Q s hc a' p.end_color]
      exact ⟨Z_le_stabilizer_of_dist_le (alpha d.radical) _ p.critical.1.le hx.1,hx.2⟩
    · exact inf_le_inf_left _ (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp
        (Z_centralizes_Q d.radical a' p.end_color)))
  have hidx : (centralizer (A : Set d.overgroup)).relIndex (radiusSeed d) = 2 := by
    calc
      _ = ((radiusSeed d).map (embedM d.radical) ⊓
          centralizer (A.map (embedM d.radical) : Set (FreeAmalgam d.radical))).relIndex
          ((radiusSeed d).map (embedM d.radical)) := by
        rw [map_inf_centralizer_of_injective _ (embedM_injective d.radical),
          relIndex_map_map_of_injective _ _ (embedM_injective d.radical),inf_relIndex_left]
      _ = _ := by
        rw [hmA,hmZ,hfixed,inf_relIndex_left]
        exact (small_critical_indices s hc p hsmall).1
  obtain ⟨t,ht,him⟩ := small_critical_image_eq_swap s hc p hsmall
  have hdim : fixedCodim (seedAction s hc) (zpowers t) = 1 := by
    rw [NormalElementaryQuotient.centralizer_index_eq_fixedCodim (radiusSeed d)
      s.projection s.surjective (s.projection_kernel.trans (seed_centralizer s hc).symm)] at hidx
    change 2 ^ fixedCodim (seedAction s hc) (graphImage s (Z d.radical a')) = 2 at hidx
    rw [him] at hidx
    exact (Nat.pow_right_injective (by decide : 1 < 2)) (hidx.trans (by decide : 2 = 2^1))
  apply BinaryPermutation.TransvectionCoreMap.swap_rank_one (seedAction s hc) ht _ i j hij
  rw [←fixedCodim_zpowers_eq_displacement_rank]
  exact hdim

/-- Every vector of the full source seed has ordinary six-letter displacement
coordinates. The canonical core map retains its possible central kernel. -/
theorem full_seed_displacement_coordinates (hc : DistanceTwo.CentralLayer d)
    {a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) a')
    (hsmall : (Q d.radical a').relIndex (Z d.radical (alpha d.radical)) < 4) :
    ∃ j : (coreRepresentation (Fin 6)).IntertwiningMap (seedAction s hc),
      (∀ i k : Fin 6, i ≠ k → j (SeedCoordinates.pairVector i k) ≠ 0) ∧
      (∀ z : Additive (radiusSeed d), ∃ w : Full (Fin 6), ∀ g : Equiv.Perm (Fin 6),
        seedAction s hc g z-z = j (SeedCoordinates.displacement g w)) := by
  let ρ := seedAction s hc
  have hUZ : replacementMoved d ≤ radiusSeed d := by
    intro v hv
    have hh := mem_map_of_mem (embedM d.radical) hv
    rw [←hc.U_eq_moved] at hh
    exact DistanceEight.U_le_Z d.radical _ hh
  let inc : Additive (replacementMoved d) →ₗ[ZMod 2] Additive (radiusSeed d) :=
    (Subgroup.inclusion hUZ).toAdditive.toZModLinearMap 2
  have hi : Function.Injective inc := by
    intro v w he
    apply Additive.toMul.injective
    apply Subtype.ext
    exact congrArg (fun x : Additive (radiusSeed d) => (x.toMul : d.overgroup)) he
  have heq (g : Equiv.Perm (Fin 6)) (v : Additive (replacementMoved d)) :
      inc (coverAction s g v) = ρ g (inc v) := by
    obtain ⟨m,rfl⟩ := s.surjective g
    apply Additive.toMul.injective
    apply Subtype.ext
    exact (coverAction_conjugate s m v).trans (seedAction_conjugate s hc m (inc v)).symm
  have hex : ∃ j : (coreRepresentation (Fin 6)).IntertwiningMap ρ,
      ∀ i k : Fin 6, i ≠ k → j (SeedCoordinates.pairVector i k) ≠ 0 := by
    have hpair (i k : Fin 6) (hik : i ≠ k) :
        coreToNatural (Fin 6) (SeedCoordinates.pairVector i k) ≠ 0 :=
      Theory.SpecificGroups.SymmetricSix.BinaryFlags.NaturalGeometry.pairVector_ne_zero hik
    rcases cover_model s with ⟨E,hE⟩ | ⟨E,hE⟩
    · let f := inc.comp (E.symm.toLinearMap.comp (coreToNatural (Fin 6)))
      have hf (g : Equiv.Perm (Fin 6)) (v : core (Fin 6)) :
          f (coreRepresentation (Fin 6) g v) = ρ g (f v) := by
        change inc (E.symm (coreToNatural (Fin 6) (coreRepresentation (Fin 6) g v))) = _
        rw [coreToNatural_equivariant]
        have hh := hE g (E.symm (coreToNatural (Fin 6) v))
        simp only [MonoidHom.id_apply,LinearEquiv.apply_symm_apply] at hh
        rw [←hh,E.symm_apply_apply,heq]
        rfl
      refine ⟨{toLinearMap := f,isIntertwining' := fun g => LinearMap.ext (hf g)},?_⟩
      intro i k hik hz
      apply hpair i k hik
      apply E.symm.injective
      exact (hi (hz.trans (map_zero inc).symm)).trans (map_zero E.symm).symm
    · let f := inc.comp E.symm.toLinearMap
      have hf (g : Equiv.Perm (Fin 6)) (v : core (Fin 6)) :
          f (coreRepresentation (Fin 6) g v) = ρ g (f v) := by
        change inc (E.symm (coreRepresentation (Fin 6) g v)) = _
        have hh := hE g (E.symm v)
        simp only [MonoidHom.id_apply,LinearEquiv.apply_symm_apply] at hh
        rw [←hh,E.symm_apply_apply,heq]
        rfl
      refine ⟨{toLinearMap := f,isIntertwining' := fun g => LinearMap.ext (hf g)},?_⟩
      intro i k hik hz
      have he : SeedCoordinates.pairVector i k = 0 := by
        apply E.symm.injective
        exact (hi (hz.trans (map_zero inc).symm)).trans (map_zero E.symm).symm
      exact hpair i k hik (he ▸ map_zero _)
  obtain ⟨j,hj⟩ := hex
  let hr := seed_transposition_rank_one s hc p hsmall
  refine ⟨j,hj,?_⟩
  intro z
  apply SeedCoordinates.exists_coordinates ρ j (fun i => hj _ _ (by simp only [ne_eq, Fin.ext_iff,Fin.val_castSucc,Fin.val_succ]; omega)) _ z
  intro i
  rw [fixedCodim_zpowers_eq_displacement_rank]
  exact (hr i.castSucc i.succ (by simp only [ne_eq, Fin.ext_iff,Fin.val_castSucc,Fin.val_succ]; omega)).le


end SeedAction
include s in
/-- The full seed admits the same simultaneous generating-centralizer and
movement choice as the moved cover, using the literal small critical actor. -/
theorem exists_seed_conjugate_generator (hc : DistanceTwo.CentralLayer d)
    {a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) a')
    (hsmall : (Q d.radical a').relIndex (Z d.radical (alpha d.radical)) < 4)
    (v : radiusSeed d) (hv : (v : d.overgroup) ∉ center d.overgroup) :
    let A := (Z d.radical a').comap (embedM d.radical)
    ∃ g ∈ replacementComponent d,
      centralizer ({g*(v:d.overgroup)*g⁻¹} : Set d.overgroup) ⊔ A = ⊤ ∧
      g*(v:d.overgroup)*g⁻¹ ∉ centralizer (A : Set d.overgroup) := by
  let := seed_elementary (h := h) (d := d)
  let ρ := seedAction s hc
  let A := (Z d.radical a').comap (embedM d.radical)
  obtain ⟨j,hj,hcoords⟩ := full_seed_displacement_coordinates s hc p hsmall
  obtain ⟨w,hw⟩ := hcoords (Additive.ofMul v)
  have hvfix : ¬ ∀ x, ρ x (Additive.ofMul v)=Additive.ofMul v := by
    intro hh
    apply hv
    apply mem_center_iff.mpr
    intro m
    have he := congrArg (fun y : Additive (radiusSeed d) => (y.toMul : d.overgroup)) (hh (s.projection m))
    rw [seedAction_conjugate] at he
    exact mul_inv_eq_iff_eq_mul.mp he
  obtain ⟨t,ht,him⟩ := small_critical_image_eq_swap s hc p hsmall
  obtain ⟨x,hxt⟩ := SeedCoordinates.exists_generating_conjugate ρ j hj (Additive.ofMul v) w hw hvfix t ht
  obtain ⟨g,hg,hgx⟩ := (show x.val ∈ (replacementComponent d).map s.projection by
    rw [s.component_image];exact x.property)
  let v' : Additive (radiusSeed d) := ρ x.val (Additive.ofMul v)
  have hv' : (v'.toMul : d.overgroup) = g*(v:d.overgroup)*g⁻¹ := by
    dsimp only [v']
    rw [←hgx]
    exact seedAction_conjugate s hc g _
  let C := centralizer ({g*(v:d.overgroup)*g⁻¹} : Set d.overgroup)
  let D := C ⊔ A
  have hk : s.projection.ker ≤ D := by
    rw [s.projection_kernel,←seed_centralizer s hc]
    apply le_trans _ le_sup_left
    intro q hq
    rw [mem_centralizer_singleton_iff]
    exact (hq _ (hv' ▸ v'.toMul.property)).symm
  have htA : t ∈ A.map s.projection := by
    change t ∈ graphImage s (Z d.radical a')
    rw [him]
    exact mem_zpowers t
  have hmD : D.map s.projection = ⊤ := by
    apply hxt.2
    · intro y hy
      obtain ⟨m,rfl⟩ := s.surjective y
      refine mem_map_of_mem _ (mem_sup_left ?_)
      rw [mem_centralizer_singleton_iff]
      have he := congrArg (fun z : Additive (radiusSeed d) => (z.toMul : d.overgroup)) hy
      change ((seedAction s hc (s.projection m) v').toMul : d.overgroup) = (v'.toMul : d.overgroup) at he
      rw [seedAction_conjugate,hv'] at he
      exact mul_inv_eq_iff_eq_mul.mp he
    · exact map_mono le_sup_right htA
  have hD : D = ⊤ := by
    have he := congrArg (Subgroup.comap s.projection) hmD
    rwa [comap_map_eq,sup_eq_left.mpr hk,comap_top] at he
  refine ⟨g,hg,hD,?_⟩
  intro hfix
  obtain ⟨a,ha,hat⟩ := htA
  apply hxt.1
  change ρ t v' = v'
  rw [←hat]
  apply Additive.toMul.injective
  apply Subtype.ext
  rw [seedAction_conjugate,hv',hfix a ha,mul_inv_cancel_right]

include s in
/-- One component conjugator supplies generation and movement for any
noncentral line in the full graph seed. -/
theorem exists_seed_line_generator (hc : DistanceTwo.CentralLayer d)
    {b : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) b)
    (hsmall : (Q d.radical b).relIndex (Z d.radical (alpha d.radical)) < 4)
    (H : Subgroup (FreeAmalgam d.radical)) (hHZ : H ≤ Z d.radical (alpha d.radical))
    (hcard : Nat.card H = 2)
    (hcentral : ¬ H ≤ centralizer (stabilizer d.radical (alpha d.radical) : Set (FreeAmalgam d.radical))) :
    ∃ g ∈ Ltilde d.radical (alpha d.radical),
      (stabilizer d.radical (alpha d.radical) ⊓ centralizer
        (H.map (MulAut.conj g).toMonoidHom : Set (FreeAmalgam d.radical))) ⊔
          Z d.radical b = stabilizer d.radical (alpha d.radical) ∧
      ¬ H.map (MulAut.conj g).toMonoidHom ≤ centralizer
        (Z d.radical b : Set (FreeAmalgam d.radical)) := by
  classical
  obtain ⟨z,hzn,hunique⟩ := (Nat.card_eq_two_iff' (1 : H)).mp hcard
  have hznot : (z : FreeAmalgam d.radical) ∉ centralizer
      (stabilizer d.radical (alpha d.radical) : Set (FreeAmalgam d.radical)) := by
    intro hz
    apply hcentral
    intro x hx
    by_cases hx1 : x = 1
    · exact hx1 ▸ one_mem _
    · have he : (⟨x,hx⟩ : H) = z := hunique _ (fun he => hx1 (congrArg Subtype.val he))
      have hxz : x = (z : FreeAmalgam d.radical) := congrArg Subtype.val he
      rw [hxz]
      exact hz
  let := seed_elementary (h := h) (d := d)
  let i := embedM d.radical
  have hi := embedM_injective d.radical
  have hir : i.range = stabilizer d.radical (alpha d.radical) := (stabilizer_m_base d.radical).symm
  obtain ⟨v,hvz⟩ := (show (z : FreeAmalgam d.radical) ∈ i.range from
    hir.symm ▸ (Z_le_stabilizer d.radical _ (hHZ z.property)))
  have hv : v ∈ radiusSeed d := by
    change i v ∈ Z d.radical (alpha d.radical)
    rw [hvz]
    exact hHZ z.property
  have hvnot : v ∉ center d.overgroup := by
    intro hv
    apply hznot
    intro m hm
    obtain ⟨m,rfl⟩ := hir.symm ▸ hm
    rw [←hvz,←map_mul,←map_mul]
    exact congrArg i (mem_center_iff.mp hv m)
  have hA : Z d.radical b ≤ i.range := by
    rw [hir]
    exact critical_Z_le_stabilizer d.radical (replacementGeometry h d) (alpha d.radical) p.start_color
      (by rw [(replacementGeometry h d).distance_constant (alpha d.radical) p.start_color]
          exact replacementDistance_pos h d) p.critical
  let A := (Z d.radical b).comap i
  have hmA : A.map i = Z d.radical b := map_comap_eq_self hA
  obtain ⟨g,hg,hgen,hmove⟩ := exists_seed_conjugate_generator s hc p hsmall ⟨v,hv⟩ hvnot
  let j : d.overgroup →* stabilizer d.radical (alpha d.radical) :=
    i.codRestrict _ (fun x => hir ▸ (show i x ∈ i.range from ⟨x,rfl⟩))
  have hgL : i g ∈ Ltilde d.radical (alpha d.radical) := by
    have hg' : g ∈ pResidual 2 d.overgroup := (replacement_residual h d).symm ▸ hg
    exact mem_map_of_mem (stabilizer d.radical (alpha d.radical)).subtype
      ((map_pResidual_le 2 j) (mem_map_of_mem j hg'))
  let C := centralizer ({g * v * g⁻¹} : Set d.overgroup)
  let HC := H.map (MulAut.conj (i g)).toMonoidHom
  have hC : C.map i ≤ stabilizer d.radical (alpha d.radical) ⊓
      centralizer (HC : Set (FreeAmalgam d.radical)) := by
    rintro _ ⟨x,hx,rfl⟩
    refine ⟨hir ▸ (show i x ∈ i.range from ⟨x,rfl⟩),?_⟩
    rintro y ⟨w,hw,rfl⟩
    by_cases hw1 : w = 1
    · simp only [hw1,map_one,one_mul,mul_one]
    · have he : (⟨w,hw⟩ : H) = z := hunique _ (fun he => hw1 (congrArg Subtype.val he))
      have hwz : w = (z : FreeAmalgam d.radical) := congrArg Subtype.val he
      rw [hwz,←hvz]
      change (i g * i v * (i g)⁻¹) * i x = i x * (i g * i v * (i g)⁻¹)
      simpa only [map_mul,map_inv] using congrArg i
        (mem_centralizer_singleton_iff.mp hx).symm
  refine ⟨i g,hgL,?_,?_⟩
  · apply le_antisymm (sup_le inf_le_left (hA.trans_eq hir))
    have hm := congrArg (Subgroup.map i) hgen
    rw [Subgroup.map_sup,hmA,←MonoidHom.range_eq_map,hir] at hm
    calc
      stabilizer d.radical (alpha d.radical) = C.map i ⊔ Z d.radical b := hm.symm
      _ ≤ _ := sup_le_sup_right hC _
  · intro hfix
    apply hmove
    intro x hx
    have hzH : i (g * v * g⁻¹) ∈ HC := by
      have hh := mem_map_of_mem (MulAut.conj (i g)).toMonoidHom z.property
      change (i g * (z : FreeAmalgam d.radical) * (i g)⁻¹) ∈ HC at hh
      simpa only [←hvz,map_mul,map_inv] using hh
    apply hi
    simpa only [map_mul] using hfix hzH (i x) hx

end General
variable {G : Type u} [Group G] [Finite G] {L R : Subgroup G}
  {h : SmallMSPair KnownSimple.IsKnownSimple L R} {e : CentralMarking L}
  {hz : center (L ⧸ pCore 2 L) = ⊥} {hn : InitialNatural h e hz}
  {d : Replacement L R} (s : FullSymmetricAction h e hz hn d)
open CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup
include s in
/-- In the small critical branch, the full forward commutator line
is centralized by the whole starting stabilizer. -/
theorem small_forward_line_central
    (hlayer : DistanceTwo.CentralLayer d)
    (hb : 2 < replacementDistance h d) {a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) a')
    (hsmall : (Q d.radical a').relIndex (Z d.radical (alpha d.radical)) < 4)
    (hslice : (B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _)).relIndex
      (U d.radical (p.walk.getVert 2)) ≤ 2) :
    ⁅U d.radical (p.walk.getVert 2),Q d.radical (alpha d.radical) ⊓ centralizer
      (U d.radical (p.walk.getVert 2) ⊓ B d.radical (alpha d.radical)
        ((replacementGeometry h d).Z_normal _) : Set (FreeAmalgam d.radical))⁆ ≤
      centralizer (stabilizer d.radical (alpha d.radical) : Set (FreeAmalgam d.radical)) := by
  let c := p.walk.getVert 2
  let t := p.walk.getVert 1
  let T := Q d.radical (alpha d.radical) ⊓ centralizer
    (U d.radical c ⊓ B d.radical (alpha d.radical)
      ((replacementGeometry h d).Z_normal _) : Set (FreeAmalgam d.radical))
  let H := ⁅U d.radical c,T⁆
  change H ≤ centralizer (stabilizer d.radical (alpha d.radical) : Set (FreeAmalgam d.radical))
  by_contra hnon
  have hne : H ≠ ⊥ := by intro he; exact hnon (he ▸ bot_le)
  have hl : 2 < p.walk.length := p.length_eq_b ▸ hb
  have hat : Adjacent d.radical (alpha d.radical) t := by
    apply (cosetGraph_adj d.radical _ _).mp
    simpa only [SimpleGraph.Walk.getVert_zero] using p.walk.adj_getVert_succ (i := 0) (by omega)
  have hct : Adjacent d.radical c t := adjacent_symm d.radical
    ((cosetGraph_adj d.radical _ _).mp (p.walk.adj_getVert_succ (i := 1) (by omega)))
  have hline := selected_forward_kernel_line s hlayer hb p hslice
  have hHZ : H ≤ Z d.radical (alpha d.radical) :=
    hline.2.trans (adjacent_Z_le d.radical rfl hat)
  let := finite_Z d.radical (alpha d.radical)
  let : Finite H := Finite.of_injective (inclusion hHZ) (inclusion_injective _)
  have hcard : Nat.card H = 2 := by
    have hp := (one_lt_card_iff_ne_bot H).mpr hne
    have hh : Nat.card H ≤ 2 := hline.1
    omega
  have hUB : ¬ U d.radical c ≤ B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _) := by
    intro hh
    apply hne
    apply commutator_eq_bot_iff_le_centralizer.mpr
    apply le_centralizer_iff.mp
    intro x hx y hy
    exact hx.2 y ⟨hy,hh hy⟩
  have hUV : U d.radical c ≤ V d.radical (alpha d.radical) :=
    (DistanceEight.U_le_Z d.radical c).trans
      (le_iSup_of_le c (le_iSup_of_le (by rw [SimpleGraph.dist_comm,p.dist_start (by omega)]) le_rfl))
  have hTN : stabilizer d.radical (alpha d.radical) ≤ normalizer (T : Set (FreeAmalgam d.radical)) :=
    selected_forward_kernel_normalized hb rfl hat hct
  obtain ⟨g,hg,hgen,hmove⟩ := exists_seed_line_generator s hlayer p hsmall H hHZ hcard hnon
  have hgG := Ltilde_le_stabilizer (alpha d.radical) hg
  let f := (MulAut.conj g).toMonoidHom
  let A := (U d.radical c).map f
  let J := H.map f
  have hVm : (V d.radical (alpha d.radical)).map f = V d.radical (alpha d.radical) :=
    mem_normalizer_iff_map_conj_eq.mp (DistanceEight.V_normalized d.radical _ hgG)
  have hBm : (B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _)).map f =
      B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _) :=
    mem_normalizer_iff_map_conj_eq.mp (Escape.Propagation.Rigidity.B_normalized hb _ rfl hgG)
  have hTm : T.map f = T := mem_normalizer_iff_map_conj_eq.mp (hTN hgG)
  have hZm : (Z d.radical (alpha d.radical)).map f = Z d.radical (alpha d.radical) :=
    mem_normalizer_iff_map_conj_eq.mp (Z_normalized d.radical _ hgG)
  have hAV : A ≤ V d.radical (alpha d.radical) := hVm ▸ map_mono hUV
  have hAB : ¬ A ≤ B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _) := by
    intro hh
    apply hUB
    apply (map_le_map_iff_of_injective (f := f) (MulAut.conj g).injective).mp
    rwa [hBm]
  have hJZ : J ≤ Z d.radical (alpha d.radical) := hZm ▸ map_mono hHZ
  have hJcard : Nat.card J ≤ 2 := by
    rw [show Nat.card J = Nat.card H from card_map_of_injective (MulAut.conj g).injective,hcard]
  have hcomm : ⁅A,T⁆ ≤ J := by
    change ⁅(U d.radical c).map f,T⁆ ≤ H.map f
    rw [show H = ⁅U d.radical c,T⁆ from rfl,map_commutator,hTm]
  exact small_critical_controlled_line_false s hlayer hb p hsmall A T J
    hAV hAB inf_le_left hTN hJZ hJcard hmove hgen hcomm
    (selected_forward_kernel_contains_inner_layers (h := h) hb p)

include e hz hn in
/-- The actual selected span has the forward line as its derived subgroup
for the full starting seed. This supplies the derived
fixedness premise of the terminal natural-quotient argument. -/
theorem small_selected_span_derived_knownSimple
    (hb : 2 < replacementDistance h d) {a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) a')
    (hsmall : (Q d.radical a').relIndex (Z d.radical (alpha d.radical)) < 4)
    (hslice : (B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _)).relIndex
      (U d.radical (p.walk.getVert 2)) ≤ 2)
    (hnonabelian : ⁅localZSpan d.radical (p.walk.getVert 2) (alpha d.radical),
      localZSpan d.radical (p.walk.getVert 2) (alpha d.radical)⁆ ≠ ⊥) :
    let P := localZSpan d.radical (p.walk.getVert 2) (alpha d.radical)
    let H := ⁅U d.radical (p.walk.getVert 2),Q d.radical (alpha d.radical) ⊓ centralizer
      (U d.radical (p.walk.getVert 2) ⊓ B d.radical (alpha d.radical)
        ((replacementGeometry h d).Z_normal _) : Set (FreeAmalgam d.radical))⁆
    ⁅P,P⁆ = H ∧ Nat.card (⁅P,P⁆ : Subgroup (FreeAmalgam d.radical)) = 2 ∧
      ⁅P,P⁆ ≤ centralizer (stabilizer d.radical (alpha d.radical) : Set (FreeAmalgam d.radical)) := by
  let s := fullSymmetricAction_knownSimple h e hz hn d hb
  have hlayer := DistanceTwo.centralLayer_knownSimple G L R h e hz hn d
  let c := p.walk.getVert 2
  let t := p.walk.getVert 1
  let T := Q d.radical (alpha d.radical) ⊓ centralizer
    (U d.radical c ⊓ B d.radical (alpha d.radical)
      ((replacementGeometry h d).Z_normal _) : Set (FreeAmalgam d.radical))
  let H := ⁅U d.radical c,T⁆
  let P := localZSpan d.radical c (alpha d.radical)
  have hfixed : H ≤ centralizer (stabilizer d.radical (alpha d.radical) : Set (FreeAmalgam d.radical)) :=
    small_forward_line_central s hlayer hb p hsmall hslice
  have hHN : stabilizer d.radical (alpha d.radical) ≤ normalizer (H : Set (FreeAmalgam d.radical)) :=
    (le_centralizer_iff.mp hfixed).trans (Subgroup.centralizer_le_normalizer _)
  have hl : 2 < p.walk.length := p.length_eq_b ▸ hb
  have hcol : color d.radical c = false := (p.vertex_color (by omega)).mpr (by decide)
  have hat : Adjacent d.radical (alpha d.radical) t := by
    apply (cosetGraph_adj d.radical _ _).mp
    simpa only [SimpleGraph.Walk.getVert_zero] using p.walk.adj_getVert_succ (i := 0) (by omega)
  have hct : Adjacent d.radical c t := adjacent_symm d.radical
    ((cosetGraph_adj d.radical _ _).mp (p.walk.adj_getVert_succ (i := 1) (by omega)))
  have ht : color d.radical t = true := by
    have hh := adjacent_color_ne d.radical hat
    change false ≠ color d.radical t at hh
    cases he : color d.radical t <;> simp_all
  have hTQt : T ≤ Q d.radical t := inf_le_left.trans (Q_le_adjacent_h d.radical ht hat)
  have hseed : Z d.radical t ≤ centralizer (T : Set (FreeAmalgam d.radical)) := by
    intro z hz x hx
    rw [Z,if_neg (by simp [ht])] at hz
    exact (mem_omegaCenter_iff.mp hz).2.2 x (hTQt hx)
  have hTN : stabilizer d.radical (alpha d.radical) ≤ normalizer (T : Set (FreeAmalgam d.radical)) :=
    selected_forward_kernel_normalized hb rfl hat hct
  have hZcG : Z d.radical c ≤ stabilizer d.radical (alpha d.radical) :=
    ((Z_le_localZSpan d.radical c (alpha d.radical)).trans (localZSpan_le_V d.radical (by
      rw [SimpleGraph.dist_comm,p.dist_start (by omega)]))).trans
      ((replacementGeometry h d).V_local _ rfl hb)
  have hZc : ⁅Z d.radical c,T⁆ ≤ H := by
    rw [DistanceTwo.CentralLayer.Z_eq_moving_sup_edge_at h e hz d hcol hct]
    apply commutator_sup_le_of_relative_normal (stabilizer d.radical (alpha d.radical))
      _ _ T _ hHN ((DistanceEight.U_le_Z d.radical c).trans hZcG)
      ((adjacent_Z_le d.radical rfl hat).trans (Z_le_stabilizer d.radical _)) le_rfl
    exact (commutator_eq_bot_iff_le_centralizer.mpr hseed).le.trans bot_le
  have hPT : ⁅P,T⁆ ≤ H := by
    dsimp only [P]
    rw [localZSpan_eq_conjugates]
    apply commutator_iSup_le_of_relative_normal (stabilizer d.radical (alpha d.radical)) T _ _ hHN
    · intro g
      have hgmap : (stabilizer d.radical (alpha d.radical)).map
          (MulAut.conj (g : FreeAmalgam d.radical)⁻¹).toMonoidHom = stabilizer d.radical (alpha d.radical) :=
        mem_normalizer_iff_map_conj_eq.mp ((stabilizer d.radical (alpha d.radical)).le_normalizer
          ((stabilizer d.radical (alpha d.radical)).inv_mem g.property))
      exact (map_mono hZcG).trans_eq hgmap
    · intro g
      have hm := map_mono (f := (MulAut.conj (g : FreeAmalgam d.radical)⁻¹).toMonoidHom) hZc
      have hTm : T.map (MulAut.conj (g : FreeAmalgam d.radical)⁻¹).toMonoidHom = T :=
        mem_normalizer_iff_map_conj_eq.mp (hTN ((stabilizer d.radical (alpha d.radical)).inv_mem g.property))
      have hHm : H.map (MulAut.conj (g : FreeAmalgam d.radical)⁻¹).toMonoidHom = H :=
        mem_normalizer_iff_map_conj_eq.mp (hHN ((stabilizer d.radical (alpha d.radical)).inv_mem g.property))
      rwa [map_commutator,hTm,hHm] at hm
  have hPP : ⁅P,P⁆ ≤ H :=
    (commutator_mono le_rfl (selected_span_le_forward_kernel (h := h) hb p)).trans hPT
  have hline := selected_forward_kernel_noncentral_line_knownSimple
    (e := e) (hz := hz) (hn := hn) hb p hslice hnonabelian
  let := finite_Z d.radical t
  let : Finite H := Finite.of_injective (inclusion hline.2.1) (inclusion_injective _)
  let : Finite (⁅P,P⁆ : Subgroup (FreeAmalgam d.radical)) :=
    Finite.of_injective (inclusion hPP) (inclusion_injective _)
  have hpos := (one_lt_card_iff_ne_bot (⁅P,P⁆ : Subgroup (FreeAmalgam d.radical))).mpr hnonabelian
  have he : ⁅P,P⁆ = H := eq_of_le_of_card_ge hPP (by have hh : Nat.card H = 2 := hline.1; omega)
  exact ⟨he,he ▸ hline.1,hPP.trans hfixed⟩

include e hz hn in
/-- The full-seed derived-line calculation at an arbitrary source vertex;
the same conjugator transports the critical walk and the forward slice. -/
theorem small_selected_span_derived_fixed_at_knownSimple
    (hb : 2 < replacementDistance h d) {a a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) a a')
    (hsmall : (Q d.radical a').relIndex (Z d.radical a) < 4)
    (hslice : (B d.radical a ((replacementGeometry h d).Z_normal _)).relIndex
      (U d.radical (p.walk.getVert 2)) ≤ 2)
    (hnonabelian : ⁅localZSpan d.radical (p.walk.getVert 2) a,
      localZSpan d.radical (p.walk.getVert 2) a⁆ ≠ ⊥) :
    ⁅localZSpan d.radical (p.walk.getVert 2) a,
      localZSpan d.radical (p.walk.getVert 2) a⁆ ≤
      centralizer (Ltilde d.radical a : Set (FreeAmalgam d.radical)) := by
  obtain ⟨x,rfl⟩ := exists_mVertex_of_color d.radical p.start_color
  have hxbase : act d.radical x⁻¹ (mVertex d.radical x) = alpha d.radical := by
    simp only [act_mVertex,mul_inv_cancel]
    rfl
  have base := small_selected_span_derived_knownSimple
    (e := e) (hz := hz) (hn := hn) hb (a' := act d.radical x⁻¹ a')
  rw [←hxbase] at base
  have hsmall' : (Q d.radical (act d.radical x⁻¹ a')).relIndex
      (Z d.radical (act d.radical x⁻¹ (mVertex d.radical x))) < 4 := by
    rw [Q_act,Z_act,relIndex_map_map_of_injective _ _ (MulAut.conj _).injective]
    exact hsmall
  have hsi : (B d.radical (act d.radical x⁻¹ (mVertex d.radical x))
        ((replacementGeometry h d).Z_normal _)).relIndex
      (U d.radical ((p.act x⁻¹).walk.getVert 2)) ≤ 2 := by
    change (B d.radical _ _).relIndex (U d.radical ((actWalk d.radical x⁻¹ p.walk).getVert 2)) ≤ 2
    rw [actWalk_getVert,Escape.PairingControl.FirstPairing.B_act hb _ _ p.start_color,
      U_act,relIndex_map_map_of_injective _ _ (MulAut.conj _).injective]
    exact hslice
  have hnon : ⁅localZSpan d.radical ((p.act x⁻¹).walk.getVert 2)
        (act d.radical x⁻¹ (mVertex d.radical x)),
      localZSpan d.radical ((p.act x⁻¹).walk.getVert 2)
        (act d.radical x⁻¹ (mVertex d.radical x))⁆ ≠ ⊥ := by
    change ⁅localZSpan d.radical ((actWalk d.radical x⁻¹ p.walk).getVert 2) _,
      localZSpan d.radical ((actWalk d.radical x⁻¹ p.walk).getVert 2) _⁆ ≠ ⊥
    rw [actWalk_getVert,LocalCommutator.CriticalCase.localZSpan_act,←map_commutator]
    intro hh
    exact hnonabelian (map_eq_bot_iff_of_injective _ (MulAut.conj _).injective |>.mp hh)
  have hh := (base (p.act x⁻¹) hsmall' hsi hnon).2.2
  have hfix := hh.trans (centralizer_le (Ltilde_le_stabilizer _))
  change ⁅localZSpan d.radical ((actWalk d.radical x⁻¹ p.walk).getVert 2)
      (act d.radical x⁻¹ (mVertex d.radical x)),
    localZSpan d.radical ((actWalk d.radical x⁻¹ p.walk).getVert 2)
      (act d.radical x⁻¹ (mVertex d.radical x))⁆ ≤
      centralizer (Ltilde d.radical (act d.radical x⁻¹ (mVertex d.radical x)) : Set (FreeAmalgam d.radical)) at hfix
  rw [actWalk_getVert] at hfix
  have hm := map_mono (f := (MulAut.conj x⁻¹).toMonoidHom) hfix
  have hrestore (v : Vertex d.radical) : act d.radical x (act d.radical x⁻¹ v) = v := by
    rw [←act_mul,inv_mul_cancel,act_one]
  rw [map_commutator,←LocalCommutator.CriticalCase.localZSpan_act,hrestore] at hm
  have hz := (map_centralizer_le_centralizer_image
    (Ltilde d.radical (act d.radical x⁻¹ (mVertex d.radical x)) : Set (FreeAmalgam d.radical))
    (MulAut.conj x⁻¹).toMonoidHom)
  have hh' := hm.trans hz
  simpa only [←Subgroup.coe_map,←Ltilde_act,hrestore] using hh'

/-- On the original midpoint orbit, the full-seed closure
argument supplies the selected derived-fixedness premise. The
natural quotient, its literal action, and transfer to index-two subgroups
retain both cover orders and the same endpoint conjugator. -/
theorem selected_natural_quotient_of_midpoint_slices_fixed_knownSimple
    {h : SmallMSPair KnownSimple.IsKnownSimple L R} {e : CentralMarking L}
    {hz : center (L ⧸ pCore 2 L) = ⊥} {hn : InitialNatural h e hz}
    {d : Replacement L R} (hb : replacementDistance h d = 4)
    {a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) a')
    (hnonabelian : ⁅localZSpan d.radical (p.walk.getVert 2) (alpha d.radical),
      localZSpan d.radical (p.walk.getVert 2) (alpha d.radical)⁆ ≠ ⊥)
    (hslice : (B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _)).relIndex
      (U d.radical (p.walk.getVert 2)) ≤ 2)
    (g : FreeAmalgam d.radical) (hg : g ∈ stabilizer d.radical (p.walk.getVert 2))
    (he : act d.radical g (alpha d.radical) = a')
    (hopposite : (B d.radical (p.walk.getVert 2) ((replacementGeometry h d).Z_normal _)).relIndex
      (U d.radical a') ≤ 2) :
    ∃ (E : ((forwardMovedSpan d.radical (p.walk.getVert 2)) ⧸
          center (forwardMovedSpan d.radical (p.walk.getVert 2))) ≃*
        Multiplicative (BinaryPermutation.natural (Fin 6)))
      (τ : Equiv.Perm (Fin 6) ≃* Equiv.Perm (Fin 6)),
      (∀ (m : d.overgroup) (x : forwardMovedSpan d.radical (p.walk.getVert 2)),
        (E (QuotientGroup.mk' _ (forwardMovedSpanAction d.radical (p.walk.getVert 2) m x))).toAdd =
          BinaryPermutation.naturalRepresentation (Fin 6)
            (τ (SourceReduction.projection h e hz hn d m))
            (E (QuotientGroup.mk' _ x)).toAdd) ∧
      (center (forwardMovedSpan d.radical (p.walk.getVert 2))).index = 16 ∧
      Nat.card (⁅localZSpan d.radical (p.walk.getVert 2) (alpha d.radical),
        localZSpan d.radical (p.walk.getVert 2) (alpha d.radical)⁆ : Subgroup (FreeAmalgam d.radical)) = 2 ∧
      ∀ A : Subgroup (FreeAmalgam d.radical), A ≤ localZSpan d.radical (p.walk.getVert 2) (alpha d.radical) →
        A.relIndex (localZSpan d.radical (p.walk.getVert 2) (alpha d.radical)) ≤ 2 →
        ⁅A,A⁆ = ⁅localZSpan d.radical (p.walk.getVert 2) (alpha d.radical),localZSpan d.radical (p.walk.getVert 2) (alpha d.radical)⁆ := by
  have hb2 : 2 < replacementDistance h d := by omega
  let s := fullSymmetricAction_knownSimple h e hz hn d hb2
  have hc := DistanceTwo.centralLayer_knownSimple G L R h e hz hn d
  have hi := (midpoint_slice_eq_reverse_kernel s hc hb p g hg he hopposite).2.2.1
  have hfixed := (small_selected_span_derived_knownSimple
    (e := e) (hz := hz) (hn := hn) hb2 p (by omega) hslice hnonabelian).2.2
  exact selected_natural_quotient_and_transfer_of_midpoint_slices_knownSimple
    (e := e) (hz := hz) (hn := hn) hb p hnonabelian
    (hfixed.trans (centralizer_le (Ltilde_le_stabilizer _))) hslice g hg he hopposite
/-- The source midpoint orbit and its two slice bounds give the full terminal
contradiction. Both selected derived-fixedness premises are discharged. -/
theorem selected_terminal_false_of_full_seed_slices_knownSimple
    {h : SmallMSPair KnownSimple.IsKnownSimple L R} {e : CentralMarking L}
    {hz : center (L ⧸ pCore 2 L) = ⊥} {hn : InitialNatural h e hz}
    {d : Replacement L R} (hb : replacementDistance h d = 4)
    {a' : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) a')
    (hnonabelian : ⁅localZSpan d.radical (p.walk.getVert 2) (alpha d.radical),
      localZSpan d.radical (p.walk.getVert 2) (alpha d.radical)⁆ ≠ ⊥)
    (hslice : (B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _)).relIndex
      (U d.radical (p.walk.getVert 2)) ≤ 2)
    (g : FreeAmalgam d.radical) (hg : g ∈ stabilizer d.radical (p.walk.getVert 2))
    (he : act d.radical g (alpha d.radical) = a')
    (hopposite : (B d.radical (p.walk.getVert 2) ((replacementGeometry h d).Z_normal _)).relIndex
      (U d.radical a') ≤ 2) : False := by
  have hb2 : 2 < replacementDistance h d := by omega
  let s := fullSymmetricAction_knownSimple h e hz hn d hb2
  have hc := DistanceTwo.centralLayer_knownSimple G L R h e hz hn d
  let c := p.walk.getVert 2
  have hci : color d.radical c = false :=
    (p.vertex_color (by have hl : p.walk.length = replacementDistance h d := p.length_eq_b; omega)).mpr (by decide)
  have hi := (midpoint_slice_eq_reverse_kernel s hc hb p g hg he hopposite).2.2.1
  have hfixed := small_selected_span_derived_fixed_at_knownSimple
    (e := e) (hz := hz) (hn := hn) hb2 p (by omega) hslice hnonabelian
  have hnonOpp : ⁅localZSpan d.radical (alpha d.radical) c,
      localZSpan d.radical (alpha d.radical) c⁆ ≠ ⊥ := by
    have hstart : Z d.radical (alpha d.radical) ≤ localZSpan d.radical (alpha d.radical) c :=
      Z_le_localZSpan d.radical _ _
    have hend : Z d.radical a' ≤ localZSpan d.radical (alpha d.radical) c := by
      rw [←he,Z_act]
      exact (map_mono hstart).trans_eq (mem_normalizer_iff_map_conj_eq.mp
        (localZSpan_normalized d.radical (alpha d.radical) c
          ((stabilizer d.radical c).inv_mem hg)))
    intro hn
    have hcrit := critical_noncommutation d.radical (replacementGeometry h d)
      (edgeCentralizerCondition s hc) (alpha d.radical) rfl
      (by rw [(replacementGeometry h d).distance_constant _ rfl]; exact replacementDistance_pos h d)
      p.critical
    exact hcrit (le_bot_iff.mp ((commutator_mono hstart hend).trans_eq hn))
  obtain ⟨_,x,hx,q,_,hq,_⟩ := selected_span_conjugate_critical_path (h := h) hb2 p hnonabelian
  have hBn := Escape.Propagation.Rigidity.B_normalized
    (geometry := replacementGeometry h d) hb2 c hci
  have hBm : (B d.radical c ((replacementGeometry h d).Z_normal _)).map
      (MulAut.conj g⁻¹).toMonoidHom = B d.radical c ((replacementGeometry h d).Z_normal _) :=
    mem_normalizer_iff_map_conj_eq.mp (hBn ((stabilizer d.radical c).inv_mem hg))
  have hforwardOpp : (B d.radical c ((replacementGeometry h d).Z_normal _)).relIndex
      (U d.radical (q.walk.getVert 2)) ≤ 2 := by
    rw [hq]
    have hh := hopposite
    have hUe : U d.radical a' = (U d.radical (alpha d.radical)).map
        (MulAut.conj g⁻¹).toMonoidHom := by rw [←he,U_act]
    rw [hUe,←hBm,relIndex_map_map_of_injective _ _ (MulAut.conj g⁻¹).injective] at hh
    exact hh
  have hBna := Escape.Propagation.Rigidity.B_normalized
    (geometry := replacementGeometry h d) hb2 (alpha d.radical) rfl
  have hBma : (B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _)).map
      (MulAut.conj x⁻¹).toMonoidHom = B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _) :=
    mem_normalizer_iff_map_conj_eq.mp (hBna ((stabilizer d.radical (alpha d.radical)).inv_mem hx))
  have hoppositeOpp : (B d.radical (q.walk.getVert 2) ((replacementGeometry h d).Z_normal _)).relIndex
      (U d.radical (act d.radical x c)) ≤ 2 := by
    rw [hq,U_act,←hBma,relIndex_map_map_of_injective _ _ (MulAut.conj x⁻¹).injective]
    exact hslice
  have hiOpp := (midpoint_slice_eq_reverse_kernel s hc hb q x
    (hq.symm ▸ hx) rfl hoppositeOpp).2.2.1
  have hfixedOpp := small_selected_span_derived_fixed_at_knownSimple
    (e := e) (hz := hz) (hn := hn) hb2 q (by omega) hforwardOpp
    (by simpa only [hq] using hnonOpp)
  rw [hq] at hfixedOpp
  exact selected_terminal_false_of_midpoint_slices_knownSimple
    (e := e) (hz := hz) (hn := hn) hb p hnonabelian hfixed hfixedOpp
    hslice g hg he hopposite

