universe u
variable {G : Type u} [Group G] [Finite G] {L R : Subgroup G}
  (h : SmallMSPair KnownSimple.IsKnownSimple L R) (e : CentralMarking L)
  (hz : center (L ⧸ pCore 2 L) = ⊥) (hn : InitialNatural h e hz)
  (d : Replacement L R)
private theorem plane_normalized_edge
    {M : Type*} [Group M] [Finite M] {R : Subgroup M} (geo : Geometry R) (hb : geo.b R = 2)
    {c t : Vertex R}
    (hc : CriticalPair R (alpha R) c (geo.exists_critical (alpha R) rfl))
    (hat : Adjacent R (alpha R) t) (hct : Adjacent R c t) :
    Q R t ≤ normalizer (criticalPlane R c t : Set (FreeAmalgam R)) := by
  have htGa : Q R t ≤ stabilizer R (alpha R) :=
    fun k hk => hk.2 (alpha R) (adjacent_symm R hat)
  have htGc : Q R t ≤ stabilizer R c :=
    fun k hk => hk.2 c (adjacent_symm R hct)
  apply le_normalizer_iff.mpr
  intro k hk y hy
  apply (mem_criticalPlane_iff geo hb hc hat hct _).mpr
  have hy' := (mem_criticalPlane_iff geo hb hc hat hct y).mp hy
  refine ⟨le_normalizer_iff.mp (Z_normalized R c) k (htGc hk) y hy'.1,?_⟩
  intro q hq
  have hq' : k⁻¹*q*k ∈ Q R (alpha R) := by
    simpa only [inv_inv] using
      le_normalizer_iff.mp (Q_normalized R (alpha R)) k⁻¹
        (htGa ((Q R t).inv_mem hk)) q hq
  have hm := hy'.2 (k⁻¹*q*k) hq'
  have hconj : (MulAut.conj k) ⁅k⁻¹*q*k,y⁆ ∈ Z R t :=
    le_normalizer_iff.mp (Z_normalized R t) k hk.1 _ hm
  rw [map_commutatorElement] at hconj
  have he : (MulAut.conj k) (k⁻¹*q*k) = q := by
    simp [MulAut.conj_apply,mul_assoc]
  rw [he] at hconj
  exact hconj


private theorem common_neighbor_unique
    {M : Type*} [Group M] (R : Subgroup M) {a c b b' : Vertex R}
    (hac : a ≠ c) (hab : Adjacent R a b) (hcb : Adjacent R c b)
    (hab' : Adjacent R a b') (hcb' : Adjacent R c b') : b = b' := by
  have hab0 : (cosetGraph R).Adj a b := (cosetGraph_adj R _ _).mpr hab
  have hbc0 : (cosetGraph R).Adj b c := (cosetGraph_adj R _ _).mpr (adjacent_symm R hcb)
  have hab0' : (cosetGraph R).Adj a b' := (cosetGraph_adj R _ _).mpr hab'
  have hbc0' : (cosetGraph R).Adj b' c := (cosetGraph_adj R _ _).mpr (adjacent_symm R hcb')
  let p : (cosetGraph R).Walk a c := .cons hab0 (.cons hbc0 .nil)
  let q : (cosetGraph R).Walk a c := .cons hab0' (.cons hbc0' .nil)
  have hp : p.IsPath := by simp [p,hab0.ne,hbc0.ne,hac]
  have hq : q.IsPath := by simp [q,hab0'.ne,hbc0'.ne,hac]
  have he := ((cosetGraph_isTree R).isAcyclic.subsingleton_path a c).elim
    (⟨p,hp⟩ : (cosetGraph R).Path a c) ⟨q,hq⟩
  exact congrArg (fun r : (cosetGraph R).Path a c => r.val.snd) he


include h e hz hn in
/-- On the literal critical plane, centralizing the plane forces the whole
opposite Z-layer's displacement back into it. -/
theorem critical_plane_centralizer_displacement
    (hb : replacementDistance h d = 2)
    (hlarge : ¬ core d.radical (alpha d.radical) ≤
      (frattini (Q d.radical (alpha d.radical))).map
        (Q d.radical (alpha d.radical)).subtype ⊔ X d.radical (alpha d.radical))
    {c b : Vertex d.radical}
    (hc : CriticalPair d.radical (alpha d.radical) c
      ((replacementGeometry h d).exists_critical _ rfl))
    (hab : Adjacent d.radical (alpha d.radical) b) (hcb : Adjacent d.radical c b)
    (N : Subgroup (FreeAmalgam d.radical)) (hN : N ≤ Q d.radical (alpha d.radical))
    (hfix : N ≤ centralizer (criticalPlane d.radical c b : Set (FreeAmalgam d.radical))) :
    ⁅N,Z d.radical c⁆ ≤ criticalPlane d.radical c b := by
  obtain ⟨b',i,A,hi,hab',hcb',hAR,hAm,hiW,hiS,hiL,hiR,t,ht,hAt⟩ :=
    critical_transposition_coordinates_with_edge h e hz hn d hb hlarge hc
  have hac : alpha d.radical ≠ c := by
    intro hh
    have hd := hc.1.trans hb
    rw [hh,SimpleGraph.dist_self] at hd
    omega
  have hbb := common_neighbor_unique d.radical hac hab hcb hab' hcb'
  subst b'
  let := replacementMoved_normal h d
  let := moved_elementary h d
  let W := replacementMoved d
  let q := Recognition.sourceProjection h e hz hn d
  let B := d.radical.map q
  have hq := sourceProjection_surjective_of_nonfrattini h e hz hn d hb hlarge
  let hk := (Recognition.sourceProjection_kernel h e hz hn d).trans
    (moved_centralizer h e hz hn d).symm
  let ρ := NormalElementaryQuotient.representation W q hq hk
  have hmodel := moved_cover_model h e hz hn d hq
  have hZc : Z d.radical c = (W ⊔ omegaCenter d.radical).map i := by
    rw [Subgroup.map_sup,hiW,hiS]
    exact CentralLayer.Z_eq_moving_sup_edge_at h e hz d
      (critical_endpoint_color d.radical (alpha d.radical) rfl _ hc) hcb
  have hQa : Q d.radical (alpha d.radical) ≤ d.radical.map i := by
    rw [hiR]
    exact Q_le_adjacent_h d.radical (DistanceTwo.NaturalCore.edge_color hab) hab
  have hWR : W ≤ d.radical := (replacementMoved_le_omegaCenter h d).trans
    ((omegaCenter_le _).trans (replacement_core_le_radical h d))
  let P : Additive W → Prop := fun v => i v.toMul.val ∈ criticalPlane d.radical c b
  have hP (v : Additive W) (hv : SecondFixed ρ B v) : P v := by
    apply (mem_criticalPlane_iff (replacementGeometry h d) hb hc hab hcb _).mpr
    refine ⟨?_,?_⟩
    · rw [hZc]
      exact mem_map_of_mem i (show v.toMul.val ∈ W ⊔ omegaCenter d.radical from
        mem_sup_left v.toMul.property)
    · intro y hy
      obtain ⟨y,hyR,rfl⟩ := hQa hy
      let δ := ρ (q y) v-v
      have he : δ.toMul.val = ⁅y,v.toMul.val⁆ := by
        dsimp only [δ]
        rw [toMul_sub,div_eq_mul_inv]
        change ((ρ (q y) v).toMul : d.overgroup) * v.toMul.val⁻¹ = _
        rw [NormalElementaryQuotient.representation_apply]
        rfl
      have hδ : δ.toMul.val ∈ omegaCenter d.radical := by
        apply mem_omegaCenter_iff.mpr
        refine ⟨hWR δ.toMul.property,
          elemPow_eq_one_of_isElementaryAbelian (p := 2) _ δ.toMul.property,?_⟩
        intro r hr
        have heq := congrArg (fun x : Additive W => x.toMul.val)
          (hv (q y) (mem_map_of_mem q hyR) (q r) (mem_map_of_mem q hr))
        rw [NormalElementaryQuotient.representation_apply] at heq
        exact mul_inv_eq_iff_eq_mul.mp heq
      rw [←map_commutatorElement,←he,←hiS]
      exact mem_map_of_mem i hδ
  apply commutator_le.mpr
  intro n hnN z hzZ
  obtain ⟨n,hnR,rfl⟩ := hQa (hN hnN)
  obtain ⟨z,hz,rfl⟩ := hZc.le hzZ
  obtain ⟨w,hw,s,hs,rfl⟩ := mem_sup_of_normal_left.mp hz
  have hnf (v : Additive W) (hv : P v) : ρ (q n) v = v := by
    apply Additive.toMul.injective
    apply Subtype.ext
    rw [NormalElementaryQuotient.representation_apply]
    apply mul_inv_eq_iff_eq_mul.mpr
    apply hi
    simp only [map_mul]
    exact (hfix hnN _ hv).symm
  let w0 : Additive W := Additive.ofMul ⟨w,hw⟩
  have hm := cover_displacement_of_second_fixed ρ hmodel B
    ((replacement_radical_isPGroup h d).map q) P hP (q n) (mem_map_of_mem q hnR) hnf w0
  have he : (ρ (q n) w0-w0).toMul.val = ⁅n,w⁆ := by
    rw [toMul_sub,div_eq_mul_inv]
    change ((ρ (q n) w0).toMul : d.overgroup) * w⁻¹ = _
    rw [NormalElementaryQuotient.representation_apply]
    rfl
  change i (ρ (q n) w0-w0).toMul.val ∈ criticalPlane d.radical c b at hm
  rw [he,map_commutatorElement] at hm
  have hns : Commute (i n) (i s) := by
    change i n * i s = i s * i n
    simpa only [map_mul] using congrArg i ((mem_omegaCenter_iff.mp hs).2.2 n hnR)
  rw [map_mul,commutatorElement_mul_right_eq_mul_conj,hns.commutator_eq]
  simpa only [mul_one,mul_inv_cancel_right] using hm


include h e hz hn in
/-- Source orbit noncentrality before the maximal-plane equality. The whole
central attachment and the original radical are retained. -/
theorem critical_orbit_noncentral
    (hb : replacementDistance h d = 2)
    (hlarge : ¬ core d.radical (alpha d.radical) ≤
      (frattini (Q d.radical (alpha d.radical))).map
        (Q d.radical (alpha d.radical)).subtype ⊔ X d.radical (alpha d.radical))
    {c b : Vertex d.radical}
    (hc : CriticalPair d.radical (alpha d.radical) c
      ((replacementGeometry h d).exists_critical _ rfl))
    (hab : Adjacent d.radical (alpha d.radical) b) (hcb : Adjacent d.radical c b) :
    ¬ ⁅criticalOrbit d.radical c b,Ltilde d.radical (alpha d.radical)⁆ ≤
      Z d.radical (alpha d.radical) := by
  let j := embedM d.radical
  let T := (Q d.radical b).comap j
  let Z0 := orbitLayer d.radical
  let E := (Z d.radical c).comap j
  let Y := (criticalPlane d.radical c b).comap j
  let geo := replacementGeometry h d
  have hp := replacement_radical_isPGroup h d
  have hQR := replacement_core_le_radical h d
  have hZr : Z d.radical c ≤ j.range :=
    (critical_Z_le_stabilizer d.radical geo (alpha d.radical) rfl
      (by change 0 < replacementDistance h d; omega) hc).trans_eq (stabilizer_m_base _)
  have hEm : E.map j = Z d.radical c := map_comap_eq_self hZr
  have hYmap : Y.map j = criticalPlane d.radical c b :=
    map_comap_eq_self ((criticalPlane_le_opposite c b).trans hZr)
  have hTm : T.map j = Q d.radical b := map_comap_eq_self
    ((show Q d.radical b ≤ stabilizer d.radical (alpha d.radical) from
      fun _ hx => hx.2 _ (adjacent_symm d.radical hab)).trans_eq (stabilizer_m_base _))
  have hc0 := critical_endpoint_color d.radical (alpha d.radical) rfl _ hc
  have hrev := critical_reverse d.radical geo (replacement_edge_centralizer h e hz d)
    (alpha d.radical) rfl (by change 0 < replacementDistance h d; omega) c hc0 hc
  have hE : ¬ E ≤ pCore 2 d.overgroup := by
    intro he
    apply hrev.2
    rw [←hEm,Q_alpha d.radical hp hQR]
    exact map_mono he
  have hpositive : 0 < criticalDistance d.radical c (geo.exists_critical c hc0) := by
    rw [geo.distance_constant c hc0]
    change 0 < replacementDistance h d
    omega
  let := Z_elementary_of_positive d.radical geo c hc0 hpositive
  let : IsElementaryAbelian 2 E := IsElementaryAbelian.comap_of_injective
    (p := 2) j (embedM_injective d.radical) (Z d.radical c)
  have hgen : pResidual 2 d.overgroup ⊔ T = ⊤ := by
    have hbase : Ltilde d.radical (alpha d.radical) ⊔ Q d.radical (beta d.radical) =
        stabilizer d.radical (alpha d.radical) := by
      rw [Ltilde_alpha,Q_beta,←Subgroup.map_sup,replacement_residual_sup_radical h d,
        ←MonoidHom.range_eq_map]
      exact (stabilizer_m_base _).symm
    obtain ⟨g,hg,hgb⟩ := stabilizer_transitive_neighbors d.radical (alpha d.radical)
      (base_adjacent d.radical) hab
    have hh := congrArg (fun H : Subgroup (FreeAmalgam d.radical) =>
      H.map (MulAut.conj g⁻¹).toMonoidHom) hbase
    change act d.radical g (alpha d.radical) = alpha d.radical at hg
    change act d.radical g (beta d.radical) = b at hgb
    rw [Subgroup.map_sup,←Ltilde_act,←Q_act,←stabilizer_act,hg,hgb] at hh
    apply (map_injective (embedM_injective d.radical))
    rw [Subgroup.map_sup,hTm,←Ltilde_alpha,hh,←MonoidHom.range_eq_map]
    exact stabilizer_m_base _
  have hTY : T ≤ normalizer (Y : Set d.overgroup) := by
    apply le_normalizer_iff.mpr
    intro t ht y hy
    change j (t*y*t⁻¹) ∈ criticalPlane d.radical c b
    rw [map_mul,map_mul,map_inv]
    exact le_normalizer_iff.mp (plane_normalized_edge geo hb hc hab hcb) _ ht _ hy
  have hZQ : Z0 ≤ centralizer (pCore 2 d.overgroup : Set d.overgroup) := by
    intro z hz q hq
    apply embedM_injective d.radical
    simp only [map_mul]
    exact (commutator_eq_bot_iff_le_centralizer.mp
      (Z_centralizes_Q d.radical (alpha d.radical) rfl)) hz _
        (Q_alpha d.radical hp hQR ▸ mem_map_of_mem j hq)
  have hQE : ⁅pCore 2 d.overgroup,E⁆ ≤ E ⊓ pCore 2 d.overgroup := by
    apply le_inf
    · apply map_le_iff_le_comap.mp
      rw [map_commutator,hEm,←Q_alpha d.radical hp hQR]
      exact DistanceTwo.NaturalCore.local_commutator_le_endpoint hab hcb
    · exact commutator_le_left _ _
  have hne : ¬ ⁅pCore 2 d.overgroup,pResidual 2 d.overgroup⁆ ≤ Z0 := by
    intro hh
    have hm := map_mono (f := j) hh
    rw [←core_alpha d.radical hp hQR rfl] at hm
    have hzX := geo.omega_bound (alpha d.radical) rfl
      (by change 0 < replacementDistance h d; omega)
    exact hlarge (((hm.trans (map_comap_le _ _)).trans hzX).trans le_sup_right)
  have hd (N : Subgroup d.overgroup) [N.Normal]
      (hN : N ≤ pCore 2 d.overgroup) (hfix : N ≤ centralizer (Y : Set d.overgroup)) :
      ⁅N,E⁆ ≤ Y := by
    apply (map_le_map_iff_of_injective (embedM_injective d.radical)).mp
    rw [map_commutator,hEm,hYmap]
    apply critical_plane_centralizer_displacement h e hz hn d hb hlarge hc hab hcb
    · rw [Q_alpha d.radical hp hQR]
      exact map_mono hN
    · rw [←hYmap]
      rintro _ ⟨n,hnN,rfl⟩ _ ⟨y,hy,rfl⟩
      exact (map_mul j y n).symm.trans
        ((congrArg j (hfix hnN y hy)).trans (map_mul j n y))
  have hnc := normal_orbit_noncentral T Z0 E Y (replacement_normal_generation h e hz d)
    hgen hTY (comap_mono (criticalPlane_le_opposite c b)) hZQ hE hQE hne hd
  intro hh
  apply hnc
  apply map_le_iff_le_comap.mp
  rw [map_commutator,←Ltilde_alpha]
  exact hh


include h e hz hn in
/-- The generating plane escapes the canonical fixed preimage before any
local plane equality or favorable-pair estimate is supplied. -/
theorem critical_plane_not_fixed
    (hb : replacementDistance h d = 2)
    (hlarge : ¬ core d.radical (alpha d.radical) ≤
      (frattini (Q d.radical (alpha d.radical))).map
        (Q d.radical (alpha d.radical)).subtype ⊔ X d.radical (alpha d.radical))
    {c b : Vertex d.radical}
    (hc : CriticalPair d.radical (alpha d.radical) c
      ((replacementGeometry h d).exists_critical _ rfl))
    (hab : Adjacent d.radical (alpha d.radical) b) (hcb : Adjacent d.radical c b) :
    ¬ (criticalPlane d.radical c b).comap (embedM d.radical) ≤
      orbitFixedKernel (pResidual 2 d.overgroup) d.radical c b := by
  apply plane_not_fixed_of_movement
  intro hm
  have hh := map_mono (f := embedM d.radical) hm
  rw [map_commutator,←Ltilde_alpha] at hh
  exact critical_orbit_noncentral h e hz hn d hb hlarge hc hab hcb
    (hh.trans (map_comap_le _ _))

