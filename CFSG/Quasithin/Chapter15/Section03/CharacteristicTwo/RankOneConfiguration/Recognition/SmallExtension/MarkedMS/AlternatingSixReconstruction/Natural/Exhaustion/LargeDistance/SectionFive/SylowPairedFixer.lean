/-- On the literal minimum replacement, the same compatible pair gives an
overlapping backward critical path or a trapped pair whose common full-kernel
fixer lies in the strict slice and whose joint movement exceeds a line.
In the trapped case full-X central generation and both kernel identifications
are proved, not supplied as additional premises. -/
theorem sixteen_equal_mover_strict_kernel_alternative_knownSimple
    (hb : 4 < replacementDistance h d)
    (hcard : Nat.card (d.radical.map (SourceReduction.projection h e hz hn d)) = 16)
    {z delta : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) z)
    (hsmall : (Q d.radical z).relIndex (Z d.radical (alpha d.radical)) < 4)
    (hdelta : Adjacent d.radical delta (p.walk.getVert 1))
    (hequal : SmallMover.join (U d.radical delta) (Q d.radical delta)
        (Q d.radical (p.walk.getVert 1)) 4 =
      SmallMover.join (U d.radical (alpha d.radical)) (Q d.radical (alpha d.radical))
        (Q d.radical (p.walk.getVert 1)) 4)
    (hstrict : 2 < (B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _)).relIndex
      (U d.radical delta)) :
    ∃ t, Adjacent d.radical (alpha d.radical) t ∧
      ∃ g ∈ stabilizer d.radical (alpha d.radical),
        act d.radical g (p.walk.getVert 1) = t ∧
        Adjacent d.radical (act d.radical g delta) t ∧
        2 < (B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _)).relIndex
          (U d.radical (act d.radical g delta)) ∧
        ∃ x ∈ Ltilde d.radical (alpha d.radical),
          x^3 ∈ Q d.radical (alpha d.radical) ∧
          ∃ q : CriticalPath d.radical (replacementGeometry h d)
              (alpha d.radical) (act d.radical x z),
            (∀ i, q.walk.getVert i = act d.radical x (p.walk.getVert i)) ∧
            (Q d.radical (act d.radical x z)).relIndex (Z d.radical (alpha d.radical)) < 4 ∧
            let c := act d.radical g delta
            let J := SmallMover.join (U d.radical c) (Q d.radical c) (Q d.radical t) 4
            let A := Z d.radical z ⊓ Q d.radical (alpha d.radical) ⊔
              Z d.radical (act d.radical x z) ⊓ Q d.radical (alpha d.radical)
            J = SmallMover.join (U d.radical (alpha d.radical))
              (Q d.radical (alpha d.radical)) (Q d.radical t) 4 ∧
            Q d.radical t ⊔ Z d.radical z = stabilizer d.radical (alpha d.radical) ∧
            Q d.radical t ⊔ Z d.radical (act d.radical x z) = stabilizer d.radical (alpha d.radical) ∧
            J ⊔ Z d.radical z ⊔ Z d.radical (act d.radical x z) = stabilizer d.radical (alpha d.radical) ∧
            J ⊔ J.map (MulAut.conj x).toMonoidHom = stabilizer d.radical (alpha d.radical) ∧
            (Z d.radical (alpha d.radical) ⊓ centralizer (J : Set (FreeAmalgam d.radical))) ⊓
              centralizer (J.map (MulAut.conj x).toMonoidHom : Set (FreeAmalgam d.radical)) =
              Z d.radical (alpha d.radical) ⊓
                centralizer (stabilizer d.radical (alpha d.radical) : Set (FreeAmalgam d.radical)) ∧
            ¬ Z d.radical z ≤ normalizer ((Z d.radical c ⊔ Z d.radical (alpha d.radical) :
              Subgroup (FreeAmalgam d.radical)) : Set (FreeAmalgam d.radical)) ∧
            ¬ Z d.radical (act d.radical x z) ≤ normalizer
              ((Z d.radical c ⊔ Z d.radical (alpha d.radical) : Subgroup (FreeAmalgam d.radical)) :
                Set (FreeAmalgam d.radical)) ∧
            Adjacent d.radical (alpha d.radical) (act d.radical x⁻¹ t) ∧
            Adjacent d.radical (act d.radical x⁻¹ c) (act d.radical x⁻¹ t) ∧
            2 < (B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _)).relIndex
              (U d.radical (act d.radical x⁻¹ c)) ∧
            J.map (MulAut.conj x).toMonoidHom =
              SmallMover.join (U d.radical (act d.radical x⁻¹ c))
                (Q d.radical (act d.radical x⁻¹ c)) (Q d.radical (act d.radical x⁻¹ t)) 4 ∧
            Q d.radical (act d.radical x⁻¹ t) ⊔ Z d.radical z = stabilizer d.radical (alpha d.radical) ∧
            ¬ Z d.radical z ≤ normalizer
              ((Z d.radical (act d.radical x⁻¹ c) ⊔ Z d.radical (alpha d.radical) :
                Subgroup (FreeAmalgam d.radical)) : Set (FreeAmalgam d.radical)) ∧
            (let T := ((R.subgroupOf (L ⊔ R)).subgroupOf d.overgroup).map (embedM d.radical)
             ∃ r ∈ stabilizer d.radical (alpha d.radical),
               T.map (MulAut.conj r⁻¹).toMonoidHom = Q d.radical t ∧
               (SmallMover.join (U d.radical (alpha d.radical)) (Q d.radical (alpha d.radical))
                 T 4).map (MulAut.conj r⁻¹).toMonoidHom = J) ∧
            ((∃ b : CriticalPath d.radical (replacementGeometry h d)
                c (p.walk.getVert (p.walk.length-2)),
                b.walk.getVert 1 = t ∧
                ∀ i ≤ p.walk.length-2, b.walk.getVert (i+2) = p.walk.getVert i) ∨
             (∃ b : CriticalPath d.radical (replacementGeometry h d)
                c (q.walk.getVert (q.walk.length-2)),
                b.walk.getVert 1 = t ∧
                ∀ i ≤ q.walk.length-2, b.walk.getVert (i+2) = q.walk.getVert i) ∨
             (Z d.radical c ≤ Q d.radical (p.walk.getVert (p.walk.length-2)) ∧
              Z d.radical c ≤ Q d.radical (q.walk.getVert (q.walk.length-2)) ∧
              (∀ v, color d.radical v = false →
                X d.radical v = U d.radical v ⊔
                  (X d.radical v ⊓ centralizer (stabilizer d.radical v : Set (FreeAmalgam d.radical)))) ∧
              ⁅Z d.radical c,X d.radical z ⊓ Q d.radical (alpha d.radical)⁆ =
                ⁅Z d.radical c,Z d.radical z ⊓ Q d.radical (alpha d.radical)⁆ ∧
              ⁅Z d.radical c,X d.radical (act d.radical x z) ⊓ Q d.radical (alpha d.radical)⁆ =
                ⁅Z d.radical c,Z d.radical (act d.radical x z) ⊓ Q d.radical (alpha d.radical)⁆ ∧
              Z d.radical c ⊓ centralizer (A : Set (FreeAmalgam d.radical)) ≤
                B d.radical (alpha d.radical) ((replacementGeometry h d).Z_normal _) ∧
              2 < Nat.card (⁅U d.radical c,A⁆ : Subgroup (FreeAmalgam d.radical)) ∧
              ⁅Z d.radical c,X d.radical z ⊓ Q d.radical (alpha d.radical)⁆ ≤
                Z d.radical (alpha d.radical) ∧
              ⁅Z d.radical c,X d.radical z ⊓ Q d.radical (alpha d.radical)⁆ ⊓
                ⁅Z d.radical (act d.radical x⁻¹ c),X d.radical z ⊓ Q d.radical (alpha d.radical)⁆ ≤
                  Z d.radical (alpha d.radical) ⊓ centralizer
                    (stabilizer d.radical (alpha d.radical) : Set (FreeAmalgam d.radical)))) := by
  obtain ⟨t,hat,g,hg,hgt,hct,hi,x,hx,hx3,q,hq,hqs,heq,hgen₀,hgen₁,hgen,hpair,hfix,
    hn₀,hn₁,hat₂,hct₂,hi₂,hJ₂,hgen₂,hn₂⟩ :=
    SylowCompatible.sixteen_equal_mover_strict_pair_knownSimple
      (e := e) (hz := hz) (hn := hn) hb hcard p hsmall hdelta hequal hstrict
  let c := act d.radical g delta
  have hcol : color d.radical c = false := by
    have h1 := adjacent_color_ne d.radical hat
    have h2 := adjacent_color_ne d.radical hct
    change false ≠ color d.radical t at h1
    change color d.radical c ≠ color d.radical t at h2
    cases hc : color d.radical c <;> cases ht : color d.radical t <;> simp_all
  refine ⟨t,hat,g,hg,hgt,hct,hi,x,hx,hx3,q,hq,hqs,heq,hgen₀,hgen₁,hgen,hpair,hfix,
    hn₀,hn₁,hat₂,hct₂,hi₂,hJ₂,hgen₂,hn₂,?_,?_⟩
  · obtain ⟨r,hr,hrt⟩ := stabilizer_transitive_neighbors d.radical (alpha d.radical)
      (base_adjacent d.radical) hat
    have hR := (SylowLarge.sixteen_original_restriction_knownSimple
      (e := e) (hz := hz) (hn := hn) (by omega : 2 < replacementDistance h d) hcard).2.1
    have hT : ((R.subgroupOf (L ⊔ R)).subgroupOf d.overgroup).map (embedM d.radical) =
        Q d.radical (beta d.radical) := by
      rw [Q_beta]
      exact congrArg (Subgroup.map (embedM d.radical)) hR.symm
    have hra : act d.radical r (alpha d.radical) = alpha d.radical := hr
    change act d.radical r (beta d.radical) = t at hrt
    refine ⟨r,hr,?_,?_⟩
    · rw [hT,←Q_act]
      exact congrArg (Q d.radical) hrt
    · rw [SmallMover.join_map _ (MulAut.conj r⁻¹).injective,hT,←U_act,←Q_act,←Q_act,hra,hrt]
      exact heq.symm
  · have hb2 : 2 < replacementDistance h d := by omega
    have backward {v : Vertex d.radical}
        (r : CriticalPath d.radical (replacementGeometry h d) (alpha d.radical) v)
        (hbad : ¬ Z d.radical c ≤ Q d.radical (r.walk.getVert (r.walk.length-2))) :
        ∃ b : CriticalPath d.radical (replacementGeometry h d)
            c (r.walk.getVert (r.walk.length-2)),
          b.walk.getVert 1 = t ∧
          ∀ i ≤ r.walk.length-2, b.walk.getVert (i+2) = r.walk.getVert i := by
      let w : (cosetGraph d.radical).Walk c (alpha d.radical) :=
        .cons ((cosetGraph_adj d.radical _ _).mpr hct)
          (.cons ((cosetGraph_adj d.radical _ _).mpr (adjacent_symm d.radical hat)) .nil)
      have hw : w.length = 2 := rfl
      let b := r.prepend_two (Nat.le_of_lt hb2) hcol w hw hbad
      refine ⟨b,?_,fun i hi => r.prepend_two_overlap _ _ _ _ _ hi⟩
      simp only [b,CriticalPath.prepend_two_walk,SimpleGraph.Walk.getVert_append,
        hw,show 1<2 from by decide,ite_true,w,SimpleGraph.Walk.getVert_cons_succ,
        SimpleGraph.Walk.getVert_zero]
    by_cases hpbad : Z d.radical c ≤ Q d.radical (p.walk.getVert (p.walk.length-2))
    · by_cases hqbad : Z d.radical c ≤ Q d.radical (q.walk.getVert (q.walk.length-2))
      · apply Or.inr ∘ Or.inr
        have hXp := trapped_nonnormalized_full_kernel_knownSimple
          (e := e) (hz := hz) (hn := hn) hb2 p hsmall hat hct hpbad hn₀
        have hXq := trapped_nonnormalized_full_kernel_knownSimple
          (e := e) (hz := hz) (hn := hn) hb2 q hqs hat hct hqbad hn₁
        have hXall := X_central_generation_all p.end_color hXp.1
        have hXa := central_generation_eq_seed (h := h) rfl hat (hXall (alpha d.radical) rfl)
        have hcontrol := equal_mover_pair_control (e := e) (hz := hz) (hn := hn)
          hb hcard rfl hat hct heq hXa x (Ltilde_le_stabilizer _ hx) hpair
          (X d.radical z ⊓ Q d.radical (alpha d.radical)) inf_le_right
        exact ⟨hpbad,hqbad,hXall,
          (hXp.2.2 (Z d.radical c) hpbad).1,(hXq.2.2 (Z d.radical c) hqbad).1,
          sixteen_paired_trapped_fixer_le_slice_knownSimple
            (e := e) (hz := hz) (hn := hn) hb hcard p q hsmall hqs hat hct heq hgen hpbad hqbad,
          sixteen_paired_trapped_joint_movement_gt_two_knownSimple
            (e := e) (hz := hz) (hn := hn) hb hcard p q hsmall hqs hat hct heq hgen hpbad hqbad hi,hcontrol⟩
      · exact Or.inr (Or.inl (backward q hqbad))
    · exact Or.inl (backward p hpbad)


