/-- Trapping and the actual failure of normalization discharge full omega
central generation. The kernel decomposition retains the whole central
summand, and the full-X, seed and moving kernels have the same commutator
on every actor in the literal predecessor core. -/
theorem trapped_nonnormalized_full_kernel_knownSimple
    (hb : 2 < replacementDistance h d)
    {a z c t : Vertex d.radical}
    (p : CriticalPath d.radical (replacementGeometry h d) a z)
    (hsmall : (Q d.radical z).relIndex (Z d.radical a) < 4)
    (hat : Adjacent d.radical a t) (hct : Adjacent d.radical c t)
    (htrap : Z d.radical c ≤ Q d.radical (p.walk.getVert (p.walk.length-2)))
    (hnorm : ¬ Z d.radical z ≤ normalizer
      ((Z d.radical c ⊔ Z d.radical a : Subgroup (FreeAmalgam d.radical)) :
        Set (FreeAmalgam d.radical))) :
    X d.radical z = U d.radical z ⊔
      (X d.radical z ⊓ centralizer (stabilizer d.radical z : Set (FreeAmalgam d.radical))) ∧
    X d.radical z ⊓ Q d.radical a = (Z d.radical z ⊓ Q d.radical a) ⊔
      (X d.radical z ⊓ centralizer (stabilizer d.radical z : Set (FreeAmalgam d.radical))) ∧
    ∀ Y : Subgroup (FreeAmalgam d.radical),
      Y ≤ Q d.radical (p.walk.getVert (p.walk.length-2)) →
        ⁅Y,X d.radical z ⊓ Q d.radical a⁆ = ⁅Y,Z d.radical z ⊓ Q d.radical a⁆ ∧
        ⁅Y,X d.radical z ⊓ Q d.radical a⁆ = ⁅Y,U d.radical z ⊓ Q d.radical a⁆ := by
  let s := fullSymmetricAction_knownSimple h e hz hn d hb
  have hc := DistanceTwo.centralLayer_knownSimple G L R h e hz hn d
  have hlast := critical_last_edge_inputs (h := h) hb p
  have hpreG : Q d.radical (p.walk.getVert (p.walk.length-2)) ≤ stabilizer d.radical z :=
    hlast.2.1.trans (fun _ hx => hx.2 _ (adjacent_symm d.radical hlast.1))
  have ht : color d.radical t = true := by
    have hh := adjacent_color_ne d.radical hat
    rw [p.start_color] at hh
    cases he : color d.radical t <;> simp_all
  have hdist : (cosetGraph d.radical).dist c a ≤ 2 := by
    have h1 : (cosetGraph d.radical).dist c t = 1 :=
      SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj d.radical _ _).mpr hct)
    have h2 : (cosetGraph d.radical).dist t a = 1 :=
      SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj d.radical _ _).mpr (adjacent_symm d.radical hat))
    simpa only [h1,h2] using (cosetGraph_connected d.radical).dist_triangle (u := c) (v := t) (w := a)
  have hCQ : Z d.radical c ≤ Q d.radical a :=
    ((Z_le_localZSpan d.radical _ _).trans (localZSpan_le_V d.radical hdist)).trans
      ((replacementGeometry h d).V_le_Q hb a p.start_color)
  have hXG : X d.radical z ⊓ Q d.radical a ≤ stabilizer d.radical c :=
    (inf_le_right.trans (Q_le_adjacent_h d.radical ht hat)).trans
      (fun _ hx => hx.2 _ (adjacent_symm d.radical hct))
  have hXgen : X d.radical z = U d.radical z ⊔
      (X d.radical z ⊓ centralizer (stabilizer d.radical z : Set (FreeAmalgam d.radical))) := by
    rcases critical_X_generation_or_normalization s hc p hsmall (Z d.radical c)
      (htrap.trans hpreG) hCQ (hXG.trans (Z_normalized d.radical c)) with hh | hh
    · exact hh
    · have hZX : Z d.radical z ≤ X d.radical z := by
        apply (replacementGeometry h d).omega_bound z p.end_color
        rw [(replacementGeometry h d).distance_constant z p.end_color]
        exact replacementDistance_pos h d
      exact (hnorm (hZX.trans hh)).elim
  refine ⟨hXgen,critical_X_kernel_of_central_generation s hc p hXgen,?_⟩
  intro Y hY
  have he := (critical_X_displacements_of_central_generation s hc p hXgen Y (hY.trans hpreG)).2
  refine ⟨he,he.trans ?_⟩
  simpa only [commutator_comm Y] using (critical_kernel_predecessor_moving s hc hb p).2.2 Y hY



