/-- The subactor and the whole last-edge radius kernel have the same exact
four-element endpoint image. The seed, already contained in the subactor,
has its original two-element critical image. -/
theorem plane_radius_kernel_indices_four
    (u : S) (hR : (Rg).map π = D.map (MulAut.conj u).toMonoidHom)
    {a z : Vertex Rg} (p : CriticalPath Rg (sourceGeometry h) a z)
    (hp : (Q Rg z).relIndex (Z Rg a) < 4)
    (Y : Subgroup (FreeAmalgam Rg)) (hYV : Y ≤ V Rg a)
    (hYt : Y ≤ Q Rg (p.walk.getVert (p.walk.length-1)))
    (hAY : Z Rg a ≤ Y) (hnot : ¬ ⁅Y,Z Rg z⁆ ≤ Z Rg a) :
    (Q Rg z).relIndex Y = 4 ∧
      (Q Rg z).relIndex (V Rg a ⊓ Q Rg (p.walk.getVert (p.walk.length-1))) = 4 := by
  have hYW := le_inf hYV hYt
  exact ⟨plane_radius_subactor_index_four h e hz hk u hR p hp Y hYV hYt hAY hnot,
    plane_radius_subactor_index_four h e hz hk u hR p hp _ inf_le_left inf_le_right
      (hAY.trans hYW) (fun hh => hnot ((commutator_mono hYW le_rfl).trans hh))⟩

