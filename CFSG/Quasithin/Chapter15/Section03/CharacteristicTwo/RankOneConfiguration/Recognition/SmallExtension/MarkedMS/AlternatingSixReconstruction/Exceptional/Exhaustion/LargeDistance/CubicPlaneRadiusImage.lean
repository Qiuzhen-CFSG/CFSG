local notation "ρ" => coreRepresentation (Fin 6)
local notation "ν" => naturalRepresentation (Fin 6)
private def fourWords : Set S := {1,swap45,swap01*swap23,swap01*swap23*swap45}
private instance (g : S) : Decidable (g ∈ fourWords) :=
  inferInstanceAs (Decidable (g=1 ∨ g=swap45 ∨ g=swap01*swap23 ∨ g=swap01*swap23*swap45))
private def four : Subgroup S where
  carrier := fourWords
  one_mem' := by simp [fourWords]
  mul_mem' := by
    intro a b ha hb
    rcases ha with rfl|rfl|rfl|rfl <;> rcases hb with rfl|rfl|rfl|rfl <;> decide
  inv_mem' := by
    intro a ha
    rcases ha with rfl|rfl|rfl|rfl <;> decide
private theorem four_card : Nat.card four = 4 := by
  let w : Fin 4 → four := fun i => ⟨![1,swap45,swap01*swap23,swap01*swap23*swap45] i,by
    change _ ∈ fourWords
    fin_cases i <;> decide⟩
  have hi : Function.Injective w := by decide +kernel
  have hs : Function.Surjective w := by
    rintro ⟨g,hg⟩
    rcases hg with rfl|rfl|rfl|rfl
    · exact ⟨0,rfl⟩
    · exact ⟨1,rfl⟩
    · exact ⟨2,rfl⟩
    · exact ⟨3,rfl⟩
  exact (Nat.card_congr (Equiv.ofBijective w ⟨hi,hs⟩)).symm.trans (Nat.card_fin 4)

private theorem test_certificate : ∀ (j : Fin 8) (b c : ZMod 2),
    ρ (initialWords 3 j) (pairWord 0 2)-pairWord 0 2 = b • pairWord 4 5+c • oneWord →
      initialWords 3 j ∈ fourWords := by decide +kernel

private theorem natural_test_bound (P : Subgroup S) (hP : P ≤ D 6)
    (htest : ∀ g ∈ P, ν g (coreToNatural (Fin 6) (pairWord 0 2)) -
      coreToNatural (Fin 6) (pairWord 0 2) ∈
        subspaceCommutator ν ⊤ (zpowers swap45)) : P ≤ four := by
  intro g hg
  obtain ⟨j,rfl⟩ := (mem_disjointTranspositions_iff (3 : Fin 4) g).mp (hP hg)
  have hm := subspaceCommutator_map_embedding ν ρ (MonoidHom.id S)
    (coreToNatural (Fin 6)) (fun g v => (coreToNatural_equivariant g v).symm)
    (zpowers swap45) ⊤
  rw [Submodule.map_top,LinearMap.range_eq_top.mpr coreToNatural_surjective,
    map_id,swap45_moved,Submodule.map_span] at hm
  have hv := htest _ hg
  rw [hm] at hv
  simp only [Set.image_singleton] at hv
  obtain ⟨b,hb⟩ := Submodule.mem_span_singleton.mp hv
  have hz : coreToNatural (Fin 6)
      (ρ (initialWords 3 j) (pairWord 0 2)-pairWord 0 2-b • pairWord 4 5) = 0 := by
    rw [map_sub,map_sub,map_smul,coreToNatural_equivariant,←hb,sub_self]
  have hc : (ρ (initialWords 3 j) (pairWord 0 2)-pairWord 0 2-b • pairWord 4 5).val ∈
      constants (Fin 6) := by
    apply (Submodule.Quotient.mk_eq_zero _).mp
    exact congrArg Subtype.val hz
  obtain ⟨c,hc⟩ := Submodule.mem_span_singleton.mp hc
  apply test_certificate j b c
  have he : ρ (initialWords 3 j) (pairWord 0 2)-pairWord 0 2-b • pairWord 4 5 = c • oneWord :=
    Subtype.ext hc.symm
  exact (sub_eq_iff_eq_add.mp he).trans (add_comm _ _)

private theorem canonical_bound {Y : Type*} [AddCommGroup Y] [Module (ZMod 2) Y]
    (σ : Representation (ZMod 2) S Y)
    (f : C →ₗ[ZMod 2] Y) (q : Y →ₗ[ZMod 2] natural (Fin 6))
    (hf : ∀ g v, f (ρ g v)=σ g (f v))
    (hq : ∀ g v, q (σ g v)=ν g (q v))
    (hcomp : ∀ v, q (f v)=coreToNatural (Fin 6) v)
    (P : Subgroup S) (hP : P ≤ D 6)
    (halign : subspaceCommutator σ (fixedSpace σ (zpowers swap45)) P ≤
      subspaceCommutator σ ⊤ (zpowers swap45) ⊔ fixedSpace σ ⊤) : Nat.card P ≤ 4 := by
  have hc : (fixedSpace σ ⊤).map q = ⊥ := by
    apply le_bot_iff.mp
    rintro _ ⟨v,hv,rfl⟩
    have hi : Function.Injective (alternatingNaturalRepresentation (Fin 6)) := by
      intro a b he
      exact Subtype.ext (naturalRepresentation_injective (Fin 6) (by decide) he)
    apply (invariants_eq_bot_of_faithful_irreducible _ hi
      (alternatingNatural_isIrreducible (by decide : 5 ≤ Fintype.card (Fin 6)))).le
    intro g
    change ν g.val (q v)=q v
    rw [←hq]
    exact congrArg q (hv ⟨g.val,mem_top _⟩)
  have hm : (subspaceCommutator σ ⊤ (zpowers swap45)).map q ≤
      subspaceCommutator ν ⊤ (zpowers swap45) := by
    have he := subspaceCommutator_map_embedding ν σ (MonoidHom.id S) q
      (fun g v => (hq g v).symm) (zpowers swap45) ⊤
    rw [Subgroup.map_id] at he
    rw [←he]
    apply Submodule.span_le.mpr
    rintro _ ⟨g,hg,v,_,rfl⟩
    exact Submodule.subset_span ⟨g,hg,v,Submodule.mem_top,rfl⟩
  have hle : P ≤ four := by
    apply natural_test_bound P hP
    intro g hg
    have ht : f (pairWord 0 2) ∈ fixedSpace σ (zpowers swap45) := by
      apply (mem_fixedSpace_zpowers_iff _ _ _).mpr
      rw [←hf]
      congr 1
      decide +kernel
    have hh := Submodule.mem_map_of_mem (f := q)
      (halign (Submodule.subset_span ⟨g,hg,f (pairWord 0 2),ht,rfl⟩))
    rw [Submodule.map_sup,hc,sup_bot_eq] at hh
    have hv := hm hh
    simpa only [map_sub,hq,hcomp] using hv
  exact (card_le_of_le hle).trans_eq four_card

private theorem model_bound {Y : Type*} [AddCommGroup Y] [Module (ZMod 2) Y]
    (σ : Representation (ZMod 2) S Y)
    (hm : SixCover.IsNaturalOrCore σ (MonoidHom.id S))
    (u t : S) (P : Subgroup S)
    (hP : P ≤ (D 6).map (MulAut.conj u).toMonoidHom)
    (ht : t ∈ (D 6).map (MulAut.conj u).toMonoidHom) (hs : t.IsSwap)
    (halign : subspaceCommutator σ (fixedSpace σ (zpowers t)) P ≤
      subspaceCommutator σ ⊤ (zpowers t) ⊔ fixedSpace σ ⊤) : Nat.card P ≤ 4 := by
  have hex : ∃ f : C →ₗ[ZMod 2] Y, ∃ q : Y →ₗ[ZMod 2] natural (Fin 6),
      (∀ g v, f (ρ g v)=σ g (f v)) ∧
      (∀ g v, q (σ g v)=ν g (q v)) ∧
      ∀ v, q (f v)=coreToNatural (Fin 6) v := by
    rcases hm with ⟨E,hE⟩|⟨E,hE⟩
    · refine ⟨E.symm.toLinearMap.comp (coreToNatural (Fin 6)),E.toLinearMap,?_,?_,?_⟩
      · intro g v
        apply E.injective
        simp only [LinearMap.comp_apply,LinearEquiv.coe_coe,LinearEquiv.apply_symm_apply,
          hE,MonoidHom.id_apply,coreToNatural_equivariant]
      · exact hE
      · intro v
        exact E.apply_symm_apply _
    · refine ⟨E.symm.toLinearMap,(coreToNatural (Fin 6)).comp E.toLinearMap,?_,?_,?_⟩
      · intro g v
        apply E.injective
        simp only [LinearEquiv.coe_coe,LinearEquiv.apply_symm_apply,hE,MonoidHom.id_apply]
      · intro g v
        simp only [LinearMap.comp_apply,LinearEquiv.coe_coe,hE,MonoidHom.id_apply,
          coreToNatural_equivariant]
      · intro v
        simp only [LinearMap.comp_apply,LinearEquiv.coe_coe,LinearEquiv.apply_symm_apply]
  obtain ⟨f,q,hf,hq,hcomp⟩ := hex
  obtain ⟨w,hw,htw⟩ := CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS.AlternatingSixReconstruction.Natural.Exhaustion.LargeDistance.SectionFive.CubeAlignmentModel.marked_cube u t ht hs
  let c := (MulAut.conj w).toMonoidHom
  let P₀ := P.comap c
  have hmap : P₀.map c=P := map_comap_eq_self_of_surjective (MulAut.conj w).surjective P
  have hP₀ : P₀ ≤ D 6 := by
    apply (map_le_map_iff_of_injective (f := c) (MulAut.conj w).injective).mp
    rw [hmap,hw]
    exact hP
  let τ := σ.comp c
  let f₀ := (σ w).comp f
  let q₀ := (ν w⁻¹).comp q
  have hf₀ (g : S) (v : C) : f₀ (ρ g v)=τ g (f₀ v) := by
    change σ w (f (ρ g v))=σ (w*g*w⁻¹) (σ w (f v))
    rw [hf]
    simp only [map_mul,Module.End.mul_apply,σ.inv_self_apply]
  have hq₀ (g : S) (v : Y) : q₀ (τ g v)=ν g (q₀ v) := by
    change ν w⁻¹ (q (σ (w*g*w⁻¹) v))=ν g (ν w⁻¹ (q v))
    rw [hq]
    simp only [map_mul,Module.End.mul_apply,(naturalRepresentation (Fin 6)).inv_self_apply]
  have hcomp₀ (v : C) : q₀ (f₀ v)=coreToNatural (Fin 6) v := by
    change ν w⁻¹ (q (σ w (f v)))=_
    rw [hq,(naturalRepresentation (Fin 6)).inv_self_apply,hcomp]
  have hA : (zpowers swap45).map c=zpowers t := by
    rw [MonoidHom.map_zpowers]
    exact congrArg zpowers htw
  have hT : (⊤ : Subgroup S).map c=⊤ := map_top_of_surjective c (MulAut.conj w).surjective
  have hh := canonical_bound τ f₀ q₀ hf₀ hq₀ hcomp₀ P₀ hP₀
    (by simpa only [τ,subspaceCommutator_comp_map,fixedSpace_comp_map,hA,hmap,hT] using halign)
  calc
    Nat.card P = Nat.card P₀ := by rw [←hmap,card_map_of_injective (f := c) (MulAut.conj w).injective]
    _ ≤ 4 := hh

end PlaneRadiusImageModel

