/-- Literal C.1.32 application on the original cubic graph. Distance four
and uniformly small critical images remain premises of the index assertion;
neither core exhaustion nor the full reconstruction is asserted. -/
theorem rankTwo_or_cubic_plane_radius_indices :
    RankTwoAlternatives L R ∨ ∃ hk : layerKernel L R = extensionKernel h,
      Function.Surjective (CubicAction.projection h e hz hk) ∧
      2 < sourceDistance h ∧
      (∀ a : Vertex Rg, color Rg a = false →
        Nat.card (U Rg a) = 16 ∨ Nat.card (U Rg a) = 32) ∧
      ∃ u : S,
        (Rg).map (CubicAction.projection h e hz hk) =
          borel.map (MulAut.conj u).toMonoidHom ∨
        ((Rg).map (CubicAction.projection h e hz hk) =
          D.map (MulAut.conj u).toMonoidHom ∧
        (sourceDistance h = 4 →
          (∀ a z (_p : CriticalPath Rg (sourceGeometry h) a z),
            (Q Rg z).relIndex (Z Rg a) < 4) →
          ∃ a z, ∃ p : CriticalPath Rg (sourceGeometry h) a z,
      let Y := V Rg a ⊓ Q Rg (p.walk.getVert 2)
      (Q Rg z).relIndex Y = 4 ∧
        (Q Rg z).relIndex (V Rg a ⊓ Q Rg (p.walk.getVert 3)) = 4 ∧
        Z Rg z ⊓ centralizer (Y : Set (FreeAmalgam Rg)) = Z Rg (p.walk.getVert 3) ∧
        Z Rg z ⊓ centralizer ((V Rg a ⊓ Q Rg (p.walk.getVert 3) :
          Subgroup (FreeAmalgam Rg)) : Set (FreeAmalgam Rg)) = Z Rg (p.walk.getVert 3) ∧
        ¬ ⁅Y,X Rg z⁆ ≤ Z Rg a)) :=
  (coreExhaustion_or_cubic_plane_radius_indices h e hz).imp
    (rankTwo_of_exhaustion h e hz) id

