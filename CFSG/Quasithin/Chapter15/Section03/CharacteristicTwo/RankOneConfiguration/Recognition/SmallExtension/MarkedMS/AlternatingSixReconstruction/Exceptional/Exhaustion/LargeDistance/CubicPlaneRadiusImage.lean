/-- Whole-core application of the exact endpoint indices of both full radius kernels.
Both full moving covers, the original cubic kernel and the Borel alternative
are retained. The escaping commutator still requires the terminal contradiction. -/
theorem coreExhaustion_or_cubic_plane_radius_indices :
    CoreExhaustion L R ∨ ∃ hk : layerKernel L R = extensionKernel h,
      Function.Surjective (CubicAction.projection h e hz hk) ∧
      2 < sourceDistance h ∧
      (∀ a : Vertex Rg, color Rg a = false →
        Nat.card (U Rg a) = 16 ∨ Nat.card (U Rg a) = 32) ∧
      ∃ u : S,
        (Rg).map (CubicAction.projection h e hz hk) =
          borel.map (MulAut.conj u).toMonoidHom ∨
        ((Rg).map (CubicAction.projection h e hz hk) =
          D.map (MulAut.conj u).toMonoidHom ∧
        (sourceDistance h = 4 →
          (∀ a z (_p : CriticalPath Rg (sourceGeometry h) a z),
            (Q Rg z).relIndex (Z Rg a) < 4) →
          ∃ a z, ∃ p : CriticalPath Rg (sourceGeometry h) a z,
      let Y := V Rg a ⊓ Q Rg (p.walk.getVert 2)
      (Q Rg z).relIndex Y = 4 ∧
        (Q Rg z).relIndex (V Rg a ⊓ Q Rg (p.walk.getVert 3)) = 4 ∧
        Z Rg z ⊓ centralizer (Y : Set (FreeAmalgam Rg)) = Z Rg (p.walk.getVert 3) ∧
        Z Rg z ⊓ centralizer ((V Rg a ⊓ Q Rg (p.walk.getVert 3) :
          Subgroup (FreeAmalgam Rg)) : Set (FreeAmalgam Rg)) = Z Rg (p.walk.getVert 3) ∧
        ¬ ⁅Y,X Rg z⁆ ≤ Z Rg a)) := by
  rcases coreExhaustion_or_cubic_plane_paths h e hz with
    hex | ⟨hk,hs,hb,hcovers,u,hborel | ⟨hplane,_⟩⟩
  · exact Or.inl hex
  · exact Or.inr ⟨hk,hs,hb,hcovers,u,Or.inl hborel⟩
  · exact Or.inr ⟨hk,hs,hb,hcovers,u,Or.inr ⟨hplane,
      fun hb4 hsmall => by
        obtain ⟨a,z,p,hi,hj,hf,hfW,_,hd⟩ := plane_small_four_radius_indices h e hz hk u hplane hb4 hsmall
        exact ⟨a,z,p,hi,hj,hf,hfW,hd.2.2.2.2.2.2.2.1⟩⟩⟩

