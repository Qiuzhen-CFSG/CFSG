/-!
# Critical-layer commutators have trivial opposite image

The critical image is generated by a transposition. Every commutator has
trivial sign, so any commutator contained in the critical Z-layer lies in
the opposite two-core. This is the precise transfer needed to centralize
the orbit/core commutator by the residual; abelianness of the entire edge
quotient is unnecessary for this step. The literal subgroup embeddings and
both possible whole central covers are retained.

These unconditional commutator identities construct LocalCalculations once
the exact plane-intersection bound is supplied. Their selected-orbit
application gives both order-eight images, the fixed index four and the
proved elementary paired commutator without a radical-image premise.
The plane bound and the exceptional order-sixteen radical image remain
obligations of qt-e-ms-small-a6-exhaustion-distance-two; this module does not
claim the complete distance-two source theorem.

Source: MS93 (3.6), printed p.871, the transfer of [R_alpha,Q_alpha]
from Z_alpha to Q_alpha'.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender BinaryPermutation
open scoped commutatorElement IsMulCommutative
open CFSG.Quasithin.ChapterC.BinaryMS.MS93 Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticDistanceTwo
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.SmallExtension.MarkedMS
namespace AlternatingSixReconstruction.Natural.Exhaustion.DistanceTwo.Geometry
open LocalImages LargeDistance PlaneMovement
universe u
variable {G : Type u} [Group G] [Finite G] {L R : Subgroup G}
  (h : SmallMSPair KnownSimple.IsKnownSimple L R) (e : CentralMarking L)
  (hz : center (L ⧸ pCore 2 L) = ⊥) (hn : InitialNatural h e hz)
  (d : Replacement L R)
  (hb : replacementDistance h d = 2)
  (hlarge : ¬ core d.radical (alpha d.radical) ≤
    (frattini (Q d.radical (alpha d.radical))).map
      (Q d.radical (alpha d.radical)).subtype ⊔ X d.radical (alpha d.radical))
  {c b : Vertex d.radical}
  (hc : CriticalPair d.radical (alpha d.radical) c
    ((replacementGeometry h d).exists_critical _ rfl))
  (hab : Adjacent d.radical (alpha d.radical) b) (hcb : Adjacent d.radical c b)

include h e hz hn hb hlarge hc in
/-- The critical Z-layer's intersection with a kernel commutator has trivial
opposite image, because a nonidentity image is an odd transposition. -/
theorem critical_layer_commutator_le_opposite_core
    (B : Subgroup (FreeAmalgam d.radical))
    (hB : B ≤ Q d.radical (alpha d.radical))
    (hcomm : ⁅Q d.radical (alpha d.radical),B⁆ ≤ Z d.radical (alpha d.radical)) :
    ⁅Q d.radical (alpha d.radical),B⁆ ≤ Q d.radical c := by
  obtain ⟨A,T,hAT,hTR,hAc,hTA,hne,_,_,hfix,_,
      b',i,hi,hAm,hab',hcb',hTm,hiW,hiS,_,_,hiQ⟩ :=
    critical_image_data_coordinates_with_edge h e hz hn d hb hlarge hc
  let q := Recognition.sourceProjection h e hz hn d
  let := hAc
  let : IsElementaryAbelian 2 (A.map q) := IsElementaryAbelian.map _
  have hp : IsPGroup 2 (T.map q) :=
    ((replacement_radical_isPGroup h d).of_injective (inclusion hTR) (inclusion_injective _)).map q
  have hcent : T.map q ≤ centralizer (A.map q : Set (Equiv.Perm (Fin 6))) := by
    rintro _ ⟨y,hy,rfl⟩ _ ⟨a,ha,rfl⟩
    exact (map_mul q a y).symm.trans ((congrArg q (hTA hy a ha)).trans (map_mul q y a))
  have hnq := critical_image_nonquadratic h e hz hn d hb hlarge hc hab' hcb' T i hi hTm hiW hiS
  let B0 := B.comap i
  have hBm : B0.map i = B := map_comap_eq_self
    (hB.trans (hTm ▸ map_le_range i T))
  have hTA0 : ⁅T,B0⁆ ≤ A := by
    apply (map_le_map_iff_of_injective hi).mp
    rw [map_commutator,hTm,hBm,hAm]
    exact hcomm
  have heven : ⁅T,B0⁆ ≤ (Equiv.Perm.sign.comp q).ker := by
    apply commutator_le.mpr
    intro y hy z hzB
    change Equiv.Perm.sign (q ⁅y,z⁆) = 1
    rw [map_commutatorElement,map_commutatorElement,commutatorElement_eq_one_iff_mul_comm]
    exact mul_comm _ _
  have hkernel : ⁅T,B0⁆ ≤ pCore 2 d.overgroup := by
    rw [←Recognition.sourceProjection_kernel h e hz hn d]
    intro x hx
    change q x = 1
    by_contra hnon
    have hswap := isSwap_of_nonquadratic_fixer (A.map q) (T.map q) hp
      (map_mono hAT) hcent hfix hnq (mem_map_of_mem q (hTA0 hx)) hnon
      (elemPow_eq_one_of_isElementaryAbelian (p := 2) _ (mem_map_of_mem q (hTA0 hx)))
    have hsign : Equiv.Perm.sign (q x) = 1 := heven hx
    rw [hswap.sign_eq] at hsign
    cases hsign
  rw [←hTm,←hBm,←map_commutator,←hiQ]
  exact map_mono hkernel

include h e hz hn hb hlarge hc hab hcb in
/-- The actual orbit/core commutator centralizes the residual before any
radical-derived or plane-intersection assumption. -/
theorem orbit_commutator_centralizes_residual_of_transposition :
    ⁅⁅pCore 2 d.overgroup,criticalOrbitNative d.radical c b⁆,
      pResidual 2 d.overgroup⁆ = ⊥ := by
  let A := criticalOrbitNative d.radical c b
  let B := ⁅pCore 2 d.overgroup,A⁆
  let E := (Z d.radical c).comap (embedM d.radical)
  have hp := replacement_radical_isPGroup h d
  have hQR := replacement_core_le_radical h d
  have geo := replacementGeometry h d
  have hc0 := critical_endpoint_color d.radical (alpha d.radical) rfl _ hc
  have hrev := critical_reverse d.radical geo (replacement_edge_centralizer h e hz d)
    (alpha d.radical) rfl (by change 0 < replacementDistance h d; omega) c hc0 hc
  have hZ : Z d.radical c ≤ (embedM d.radical).range :=
    (critical_Z_le_stabilizer d.radical geo (alpha d.radical) rfl
      (by change 0 < replacementDistance h d; omega) hc).trans_eq (stabilizer_m_base _)
  have hEm : E.map (embedM d.radical) = Z d.radical c := map_comap_eq_self hZ
  have hE : ¬ E ≤ pCore 2 d.overgroup := by
    intro hh
    apply hrev.2
    rw [←hEm,Q_alpha d.radical hp hQR]
    exact map_mono hh
  have hAQ : criticalOrbit d.radical c b ≤ Q d.radical (alpha d.radical) := by
    rw [Q_alpha d.radical hp hQR]
    exact map_mono (replacement_orbit_le_core h e hz d hb hlarge hc hab hcb)
  have htransfer := critical_layer_commutator_le_opposite_core h e hz hn d hb hlarge hc
    (criticalOrbit d.radical c b) hAQ
    (criticalOrbit_commutator_le geo hp hQR hb hc hab hcb)
  have hBE : ⁅B,E⁆ = ⊥ := by
    apply (map_eq_bot_iff_of_injective _ (embedM_injective d.radical)).mp
    rw [map_commutator,hEm]
    dsimp only [B]
    rw [map_commutator,←Q_alpha d.radical hp hQR]
    apply le_bot_iff.mp
    exact (commutator_mono htransfer le_rfl).trans_eq
      ((commutator_comm _ _).trans (Z_centralizes_Q d.radical c hc0))
  have hEC : E ≤ centralizer (B : Set d.overgroup) :=
    le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hBE)
  have hLC := replacement_normal_generation h e hz d (centralizer (B : Set d.overgroup))
    (fun hh => hE (hEC.trans hh))
  exact commutator_eq_bot_iff_le_centralizer.mpr (le_centralizer_iff.mpr hLC)

include h e hz hn hb hlarge hc hab hcb in
/-- Normal generation retains the exact plane commutator once the sign
argument has centralized the orbit commutator by the residual. -/
theorem orbit_commutator_eq_plane_of_transposition :
    ⁅Q d.radical (alpha d.radical),criticalOrbit d.radical c b⁆ =
      ⁅Q d.radical (alpha d.radical),criticalPlane d.radical c b⁆ := by
  have hp := replacement_radical_isPGroup h d
  have hQR := replacement_core_le_radical h d
  have hgen := replacement_residual_sup_radical h d
  have geo := replacementGeometry h d
  let D := ⁅Q d.radical (alpha d.radical),criticalPlane d.radical c b⁆
  have hD : D ≤ ⁅Q d.radical (alpha d.radical),criticalOrbit d.radical c b⁆ :=
    commutator_mono le_rfl (criticalPlane_le_orbit geo hb hc b)
  have hcent : ⁅⁅Q d.radical (alpha d.radical),criticalOrbit d.radical c b⁆,Ltilde d.radical (alpha d.radical)⁆ = ⊥ := by
    rw [Q_alpha d.radical hp hQR,criticalOrbit,Ltilde_alpha,←map_commutator,←map_commutator,
      orbit_commutator_centralizes_residual_of_transposition h e hz hn d hb hlarge hc hab hcb,Subgroup.map_bot]
  have hG : Ltilde d.radical (alpha d.radical) ⊔ Q d.radical b = stabilizer d.radical (alpha d.radical) := by
    have hbase : Ltilde d.radical (alpha d.radical) ⊔ Q d.radical (beta d.radical) = stabilizer d.radical (alpha d.radical) := by
      rw [Ltilde_alpha,Q_beta,←Subgroup.map_sup,hgen,←MonoidHom.range_eq_map]
      exact (stabilizer_m_base d.radical).symm
    obtain ⟨g,hg,hgb⟩ := stabilizer_transitive_neighbors d.radical (alpha d.radical) (base_adjacent d.radical) hab
    have hh := congrArg (fun H : Subgroup (FreeAmalgam d.radical) =>
      H.map (MulAut.conj g⁻¹).toMonoidHom) hbase
    change act d.radical g (alpha d.radical) = alpha d.radical at hg
    change act d.radical g (beta d.radical) = b at hgb
    rw [Subgroup.map_sup,←Ltilde_act,←Q_act,←stabilizer_act,hg,hgb] at hh
    exact hh
  have hDG : D ≤ centralizer (stabilizer d.radical (alpha d.radical) : Set (FreeAmalgam d.radical)) := by
    apply le_centralizer_iff.mp
    rw [←hG]
    apply sup_le
    · exact le_centralizer_iff.mp
        (hD.trans (commutator_eq_bot_iff_le_centralizer.mp hcent))
    · apply le_centralizer_iff.mp
      intro z hz
      have hzZ := criticalPlane_commutator_le geo hb hc hab hcb hz
      have hcol := DistanceTwo.NaturalCore.edge_color hab
      have hZb : Z d.radical b = omegaCenter (Q d.radical b) := by
        simp only [Z,hcol,Bool.true_eq_false,if_false,edgeOmega]
      rw [hZb] at hzZ
      exact (mem_omegaCenter_iff.mp hzZ).2.2
  let D0 := D.comap (embedM d.radical)
  let Y := (criticalPlane d.radical c b).comap (embedM d.radical)
  let : D0.Normal := by
    constructor
    intro x hx m
    change embedM d.radical (m*x*m⁻¹) ∈ D
    rw [map_mul,map_mul,map_inv]
    have hm : embedM d.radical m ∈ stabilizer d.radical (alpha d.radical) := by
      rw [show alpha d.radical = mVertex d.radical 1 from rfl,stabilizer_m_base]
      exact ⟨m,rfl⟩
    rw [hDG hx _ hm,mul_inv_cancel_right]
    exact hx
  have hcomm : ⁅pCore 2 d.overgroup,Y⁆ ≤ D0 := by
    apply map_le_iff_le_comap.mp
    rw [map_commutator,←Q_alpha d.radical hp hQR]
    exact commutator_mono le_rfl (map_comap_le _ _)
  have hh := map_mono (f := embedM d.radical)
    (commutator_normalClosure_le_of_normal (pCore 2 d.overgroup) Y D0 hcomm)
  rw [map_commutator,←Q_alpha d.radical hp hQR] at hh
  exact le_antisymm (hh.trans (map_comap_le _ _)) hD

include h e hz hn hb hlarge hc hab hcb in
/-- The literal orbit commutator is contained in the common edge layer,
without radical-derived containment or a plane-intersection input. -/
theorem orbit_commutator_le_edge_of_transposition :
    ⁅Q d.radical (alpha d.radical),criticalOrbit d.radical c b⁆ ≤ Z d.radical b := by
  rw [orbit_commutator_eq_plane_of_transposition h e hz hn d hb hlarge hc hab hcb]
  exact criticalPlane_commutator_le (replacementGeometry h d) hb hc hab hcb

include h e hz hb hlarge hc hab hcb in
/-- The remaining intersection bound identifies the orbit's component
commutator, using residual detection on the literal core. -/
theorem orbit_component_commutator_of_intersection_bound
    (hinter : ⁅Q d.radical (alpha d.radical),
      Z d.radical c ⊓ Q d.radical (alpha d.radical)⁆ ≤ Z d.radical b) :
    ⁅criticalOrbit d.radical c b,Ltilde d.radical (alpha d.radical)⁆ =
      core d.radical (alpha d.radical) := by
  have hp := replacement_radical_isPGroup h d
  have hQR := replacement_core_le_radical h d
  have geo := replacementGeometry h d
  let A := criticalOrbitNative d.radical c b
  let E := (Z d.radical c).comap (embedM d.radical)
  have hrev := critical_reverse d.radical geo (replacement_edge_centralizer h e hz d)
    (alpha d.radical) rfl (by change 0 < replacementDistance h d; omega)
    c (critical_endpoint_color d.radical (alpha d.radical) rfl _ hc) hc
  have hZ : Z d.radical c ≤ (embedM d.radical).range :=
    (critical_Z_le_stabilizer d.radical geo (alpha d.radical) rfl
      (by change 0 < replacementDistance h d; omega) hc).trans_eq (stabilizer_m_base _)
  have hEm : E.map (embedM d.radical) = Z d.radical c := map_comap_eq_self hZ
  have hE : ¬ E ≤ pCore 2 d.overgroup := by
    intro hh
    apply hrev.2
    rw [←hEm,Q_alpha d.radical hp hQR]
    exact map_mono hh
  have hcomm : ⁅Q d.radical (alpha d.radical),Z d.radical c⁆ ≤
      criticalPlane d.radical c b := by
    rw [replacement_plane_eq_of_intersection_bound h e hz d hb hlarge hc hab hcb hinter]
    exact le_inf (DistanceTwo.NaturalCore.local_commutator_le_endpoint hab hcb)
      (DistanceTwo.NaturalCore.local_commutator_le_Q geo hb hc)
  have hcomm0 : ⁅pCore 2 d.overgroup,E⁆ ≤ A := by
    apply (map_le_map_iff_of_injective (embedM_injective d.radical)).mp
    rw [map_commutator,hEm,←Q_alpha d.radical hp hQR]
    exact hcomm.trans (criticalPlane_le_orbit geo hb hc b)
  have hcore : core d.radical (alpha d.radical) ≤ criticalOrbit d.radical c b := by
    have hh := map_mono (f := embedM d.radical)
      (core_le_of_commutator_le_of_normal_generation (replacement_normal_generation h e hz d)
        A E hE hcomm0)
    rwa [←core_alpha d.radical hp hQR rfl] at hh
  have hAQ : criticalOrbit d.radical c b ≤ Q d.radical (alpha d.radical) := by
    rw [Q_alpha d.radical hp hQR]
    exact map_mono (replacement_orbit_le_core h e hz d hb hlarge hc hab hcb)
  have hid : ⁅core d.radical (alpha d.radical),Ltilde d.radical (alpha d.radical)⁆ =
      core d.radical (alpha d.radical) := by
    rw [core_alpha d.radical hp hQR rfl,Ltilde_alpha,←map_commutator]
    exact congrArg (Subgroup.map (embedM d.radical))
      (commutator_isPPerfect_idempotent (pResidual 2 d.overgroup) (pCore 2 d.overgroup)
        (isPPerfect_pResidual 2) pCore_isPGroup le_normalizer_of_normal)
  exact le_antisymm (commutator_mono hAQ le_rfl)
    (hid.symm.le.trans (commutator_mono hcore le_rfl))

include h e hz hn hb hlarge in
/-- All six local orbit identities follow from the exact plane-intersection
bound alone. The radical's abelian-image clause is not needed here. -/
theorem localCalculations_of_intersection_bound
    (hinter : ∀ c b, CriticalPair d.radical (alpha d.radical) c
      ((replacementGeometry h d).exists_critical _ rfl) →
      Adjacent d.radical (alpha d.radical) b → Adjacent d.radical c b →
      ⁅Q d.radical (alpha d.radical),
        Z d.radical c ⊓ Q d.radical (alpha d.radical)⁆ ≤ Z d.radical b) :
    LocalCalculations d.radical (replacementGeometry h d) := {
  edge_centralizer := replacement_edge_centralizer h e hz d
  orbit_core := fun _ _ hc hab hcb => replacement_orbit_le_core h e hz d hb hlarge hc hab hcb
  commutator_edge := fun _ _ hc hab hcb =>
    orbit_commutator_le_edge_of_transposition h e hz hn d hb hlarge hc hab hcb
  commutator_core := fun c b hc hab hcb =>
    orbit_component_commutator_of_intersection_bound h e hz d hb hlarge hc hab hcb
      (hinter c b hc hab hcb)
  commutator_central := fun _ _ hc hab hcb =>
    orbit_commutator_centralizes_residual_of_transposition h e hz hn d hb hlarge hc hab hcb
  image_two := fun _ hc => critical_image_two h e hz hn d hb hlarge hc }

include h e hz hn hb hlarge in
/-- On the actual favorable pair, the two orbit images have order eight,
the fixed quotient has index four, and the paired commutator is elementary.
Only the exact plane-intersection bound remains explicit; neither an abelian
radical image nor a complement to the central attachment is assumed. -/
theorem exists_ordered_estimates_of_intersection_bound
    (hinter : ∀ c b, CriticalPair d.radical (alpha d.radical) c
      ((replacementGeometry h d).exists_critical _ rfl) →
      Adjacent d.radical (alpha d.radical) b → Adjacent d.radical c b →
      ⁅Q d.radical (alpha d.radical),
        Z d.radical c ⊓ Q d.radical (alpha d.radical)⁆ ≤ Z d.radical b) :
    ∃ o : OrderedOrbit (replacementGeometry h d),
      (Q d.radical (alpha d.radical)).relIndex o.opposite = 8 ∧
      (Q d.radical o.c).relIndex (criticalOrbit d.radical o.c o.b) = 8 ∧
      (commutatorPreimage (criticalOrbit d.radical o.c o.b) o.opposite
        (Z d.radical (alpha d.radical))).relIndex (criticalOrbit d.radical o.c o.b) = 4 ∧
      IsElementaryAbelian 2 (⁅criticalOrbit d.radical o.c o.b,o.opposite⁆ :
        Subgroup (FreeAmalgam d.radical)) := by
  have hp := replacement_radical_isPGroup h d
  have hQR := replacement_core_le_radical h d
  have hl := localCalculations_of_intersection_bound h e hz hn d hb hlarge hinter
  obtain ⟨o,hB,hA,hfix,_,_⟩ := PairEstimates.exists_ordered_early_estimates h e hz hn d hb hlarge hl
  exact ⟨o,hB,hA,hfix,
    (PairEstimates.earlyPair hp hQR hl hb hlarge o).elementary_commutator_of_squares hp hQR hl
      (fun a ha x hx => PairEstimates.paired_square_eq_one h e hz hn d hl hb hlarge o
        (commutator_mem_commutator ha hx))⟩

end AlternatingSixReconstruction.Natural.Exhaustion.DistanceTwo.Geometry
