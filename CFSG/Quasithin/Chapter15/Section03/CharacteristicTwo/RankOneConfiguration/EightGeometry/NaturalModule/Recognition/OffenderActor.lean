module

public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.EightGeometry.NaturalModule.Recognition.FaithfulAction
public import Theory.Representation.BinaryOffender.EquivariantOffender
public import Theory.Representation.BinaryOffender.Stability
public import Mathlib.GroupTheory.SpecificGroups.Alternating.Simple
public import Theory.GroupTheory.GeneralizedFitting.QuasisimpleTwoQuotient
public import CFSG.Quasithin.Defs

/-!
# The actor to which B.5.1 applies

Restrict the faithful action on the actual component module to the subgroup
J generated by its best offenders. This restriction is faithful and generated
by its own offenders. Normality makes its two-core trivial. Under the supplied
S₈ marking, J contains the alternating component: every nontrivial normal
subgroup of S₈ contains A₈. The quotient by that component is a two-group,
so the generalized Fitting subgroup of J is exactly the component.

Thus the group and action hypotheses of B.5.1 are verified at J, rather than
silently imposed on the full S₈ quotient. Strong quasithinness and the K-group
hypothesis on the component still belong to the standing source inputs.
This module does not assert any classification alternative.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), B.5.1,
printed pp.99–100, and the proof of 15.3.32(1), printed p.1132.
-/

@[expose] public section


open Subgroup Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.EightGeometry.NaturalModule.Recognition
variable {G : Type*} [Group G] [Finite G]
variable (d : LocalData G) {I : Subgroup G} (c : ComponentWitness d I)
  (hn : (c.L.subgroupOf I).Normal) (hI : I = c.L ⊔ d.S)
  (hchar : HasCharacteristicTwo I)
  (P : Sylow 2 I) (hP : (P : Subgroup I).map I.subtype = d.S)
  [IsElementaryAbelian 2 ((d.componentModule I c.L).subgroupOf I)]

noncomputable abbrev offenderGroup : Subgroup (d.Star I) :=
  offenderSubgroup (componentAction d c hn hI hchar P hP)

noncomputable def offenderAction : Representation (ZMod 2)
    (offenderGroup d c hn hI hchar P hP) (Additive ((d.componentModule I c.L).subgroupOf I)) :=
  (componentAction d c hn hI hchar P hP).comp (offenderGroup d c hn hI hchar P hP).subtype

theorem offenderGroup_normal : (offenderGroup d c hn hI hchar P hP).Normal :=
  offenderSubgroup_normal _

theorem offenderAction_faithful : Function.Injective (offenderAction d c hn hI hchar P hP) :=
  (componentAction_faithful d c hn hI hchar P hP).comp
    (offenderGroup d c hn hI hchar P hP).subtype_injective

theorem offenderAction_generated : offenderSubgroup (offenderAction d c hn hI hchar P hP) = ⊤ := by
  apply map_injective (offenderGroup d c hn hI hchar P hP).subtype_injective
  apply le_antisymm (by simp)
  have htop : (⊤ : Subgroup (offenderGroup d c hn hI hchar P hP)).map
      (offenderGroup d c hn hI hchar P hP).subtype = offenderGroup d c hn hI hchar P hP := by
    ext x; simp
  rw [htop]
  unfold offenderGroup offenderSubgroup generatedBy
  refine iSup_le fun A => iSup_le fun hA => ?_
  have hAJ : A ≤ offenderGroup d c hn hI hchar P hP :=
    le_iSup_of_le A (le_iSup_of_le hA le_rfl)
  rw [← map_subgroupOf_eq_of_le hAJ]
  apply map_mono
  exact le_iSup_of_le (A.subgroupOf (offenderGroup d c hn hI hchar P hP))
    (le_iSup_of_le ⟨hA.1.subgroupOf _ hAJ, le_top⟩ le_rfl)

theorem offenderGroup_twoCore : pCore 2 (offenderGroup d c hn hI hchar P hP) = ⊥ := by
  let _ := offenderGroup_normal d c hn hI hchar P hP
  have hnormal : ((pCore 2 (offenderGroup d c hn hI hchar P hP)).map
      (offenderGroup d c hn hI hchar P hP).subtype).Normal :=
    ConjAct.normal_of_characteristic_of_normal
  have hl : (pCore 2 (offenderGroup d c hn hI hchar P hP)).map
      (offenderGroup d c hn hI hchar P hP).subtype ≤ pCore 2 (d.Star I) :=
    le_sSup ⟨hnormal, pCore_isPGroup.map _⟩
  have hZS : d.Z ≤ d.S := (le_conjugateSpanBy d.Z d.M).trans
    (d.action.le_planeStabilizer d.T d.sylow_le (localModule_le d.T d.sylow_le) 1)
  rw [d.star_twoCore_eq_bot ⟨P, hP⟩ hZS] at hl
  exact ((pCore 2 (offenderGroup d c hn hI hchar P hP)).map_eq_bot_iff_of_injective
    (offenderGroup d c hn hI hchar P hP).subtype_injective).mp (le_bot_iff.mp hl)

theorem offenderGroup_ne_bot : offenderGroup d c hn hI hchar P hP ≠ ⊥ := by
  obtain ⟨A, hA⟩ := (isFFModule_iff_exists_bestOffender _).mp
    (componentAction_isFFModule d c hn hI hchar P hP)
  have hAJ : A ≤ offenderGroup d c hn hI hchar P hP :=
    le_iSup_of_le A (le_iSup_of_le ⟨hA, le_top⟩ le_rfl)
  exact fun hb => hA.1.1 (le_bot_iff.mp (hb ▸ hAJ))

theorem offenderAction_isFFModule : IsFFModule (offenderAction d c hn hI hchar P hP) := by
  obtain ⟨A, hA⟩ := (isFFModule_iff_exists_bestOffender _).mp
    (componentAction_isFFModule d c hn hI hchar P hP)
  have hAJ : A ≤ offenderGroup d c hn hI hchar P hP :=
    le_iSup_of_le A (le_iSup_of_le ⟨hA, le_top⟩ le_rfl)
  exact ⟨A.subgroupOf (offenderGroup d c hn hI hchar P hP), (hA.subgroupOf _ hAJ).isOffender _⟩

theorem component_le_offenderGroup
    (e : d.Star I ≃* Equiv.Perm (Fin 8))
    (hmark : (d.starImage I c.L).map e.toMonoidHom = alternatingGroup (Fin 8)) :
    d.starImage I c.L ≤ offenderGroup d c hn hI hchar P hP := by
  apply (map_le_map_iff_of_injective (f := e.toMonoidHom) e.injective).mp
  rw [hmark]
  let N := (offenderGroup d c hn hI hchar P hP).map e.toMonoidHom
  let _ : N.Normal := (offenderGroup_normal d c hn hI hchar P hP).map _ e.surjective
  have hne : N ≠ ⊥ := fun h => offenderGroup_ne_bot d c hn hI hchar P hP
    (((offenderGroup d c hn hI hchar P hP).map_eq_bot_iff_of_injective e.injective).mp h)
  exact Equiv.Perm.alternatingGroup_le_of_normal (by simp) ((nontrivial_iff_ne_bot N).mpr hne)


/-- The component inside the offender-generated actor. -/
noncomputable abbrev offenderComponent : Subgroup (offenderGroup d c hn hI hchar P hP) :=
  (d.starImage I c.L).subgroupOf (offenderGroup d c hn hI hchar P hP)

omit [Finite G] [IsElementaryAbelian 2 ((d.componentModule I c.L).subgroupOf I)] in
include hn in
theorem starComponent_normal : (d.starImage I c.L).Normal := by
  let _ := hn
  exact (inferInstance : (c.L.subgroupOf I).Normal).map (d.starMap I)
    (QuotientGroup.mk'_surjective _)

theorem offenderComponent_normal : (offenderComponent d c hn hI hchar P hP).Normal := by
  let _ := starComponent_normal d c hn
  exact inferInstanceAs (((d.starImage I c.L).subgroupOf
    (offenderGroup d c hn hI hchar P hP)).Normal)

theorem offenderComponent_quasisimple
    (e : d.Star I ≃* Equiv.Perm (Fin 8))
    (hmark : (d.starImage I c.L).map e.toMonoidHom = alternatingGroup (Fin 8)) :
    Theory.GroupTheory.IsQuasisimple (offenderComponent d c hn hI hchar P hP) := by
  let _ := c.star_quasisimple
  exact Theory.GroupTheory.IsQuasisimple.of_mulEquiv
    (subgroupOfEquivOfLe (component_le_offenderGroup d c hn hI hchar P hP e hmark)).symm

/-- Transfer the standing SQTK hypothesis to the component of the actual
offender actor. The class of known simple groups is kept explicit. -/
theorem offenderComponent_sqtk {K : GroupClass}
    (e : d.Star I ≃* Equiv.Perm (Fin 8))
    (hmark : (d.starImage I c.L).map e.toMonoidHom = alternatingGroup (Fin 8))
    (hSQTK : IsSQTK K (d.starImage I c.L)) :
    IsSQTK K (offenderComponent d c hn hI hchar P hP) :=
  (IsSQTK.equiv (subgroupOfEquivOfLe
    (component_le_offenderGroup d c hn hI hchar P hP e hmark))).mpr hSQTK

omit [Finite G] [IsElementaryAbelian 2 ((d.componentModule I c.L).subgroupOf I)] in
/-- Squares of all original star actors belong to the marked component. -/
theorem star_square_mem_component (e : d.Star I ≃* Equiv.Perm (Fin 8))
    (hmark : (d.starImage I c.L).map e.toMonoidHom = alternatingGroup (Fin 8))
    (g : d.Star I) : g ^ 2 ∈ d.starImage I c.L := by
  have hmem : e (g ^ 2) ∈ (d.starImage I c.L).map e.toMonoidHom := by
    rw [hmark, Equiv.Perm.mem_alternatingGroup, map_pow, map_pow]
    exact Int.units_sq _
  obtain ⟨x, hx, hxe⟩ := hmem
  exact e.injective hxe ▸ hx

theorem offenderComponent_two_quotient
    (e : d.Star I ≃* Equiv.Perm (Fin 8))
    (hmark : (d.starImage I c.L).map e.toMonoidHom = alternatingGroup (Fin 8)) :
    let _ := offenderComponent_normal d c hn hI hchar P hP
    IsPGroup 2 ((offenderGroup d c hn hI hchar P hP) ⧸
      offenderComponent d c hn hI hchar P hP) := by
  dsimp only
  let _ := offenderComponent_normal d c hn hI hchar P hP
  intro x
  refine ⟨1, ?_⟩
  induction x using QuotientGroup.induction_on with
  | H x =>
    change (QuotientGroup.mk' (offenderComponent d c hn hI hchar P hP) x) ^ (2 ^ 1) = 1
    rw [pow_one, ← map_pow (QuotientGroup.mk' _) x 2]
    exact (QuotientGroup.eq_one_iff _).mpr
      (star_square_mem_component d c e hmark x.val)

theorem offenderGroup_generalizedFitting
    (e : d.Star I ≃* Equiv.Perm (Fin 8))
    (hmark : (d.starImage I c.L).map e.toMonoidHom = alternatingGroup (Fin 8)) :
    Theory.GroupTheory.generalizedFitting (offenderGroup d c hn hI hchar P hP) =
      offenderComponent d c hn hI hchar P hP := by
  let _ := offenderComponent_normal d c hn hI hchar P hP
  let _ := offenderComponent_quasisimple d c hn hI hchar P hP e hmark
  exact Theory.GroupTheory.generalizedFitting_eq_of_quasisimple_two_quotient _
    (offenderComponent_two_quotient d c hn hI hchar P hP e hmark)
    (offenderGroup_twoCore d c hn hI hchar P hP)

theorem offenderGroup_generalizedFitting_eq_component_sup_center
    (e : d.Star I ≃* Equiv.Perm (Fin 8))
    (hmark : (d.starImage I c.L).map e.toMonoidHom = alternatingGroup (Fin 8)) :
    Theory.GroupTheory.generalizedFitting (offenderGroup d c hn hI hchar P hP) =
      offenderComponent d c hn hI hchar P hP ⊔ center (offenderGroup d c hn hI hchar P hP) := by
  have hnil : Group.IsNilpotent (center (offenderGroup d c hn hI hchar P hP)) := by
    refine ⟨1, ?_⟩
    rw [Subgroup.upperCentralSeries_one_eq_top_iff]
    infer_instance
  have hz : center (offenderGroup d c hn hI hchar P hP) ≤
      Theory.GroupTheory.generalizedFitting (offenderGroup d c hn hI hchar P hP) :=
    (show _ ≤ fittingSubgroup _ from le_sSup ⟨inferInstance, hnil⟩).trans
      (Theory.GroupTheory.fitting_le_generalizedFitting _)
  rw [offenderGroup_generalizedFitting d c hn hI hchar P hP e hmark] at hz ⊢
  exact (sup_eq_left.mpr hz).symm

end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.EightGeometry.NaturalModule.Recognition

end
