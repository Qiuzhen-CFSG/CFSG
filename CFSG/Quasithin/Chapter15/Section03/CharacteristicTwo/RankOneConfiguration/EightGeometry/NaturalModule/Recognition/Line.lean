module

public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.EightGeometry.NaturalModule.Recognition.FaithfulAction
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.EightGeometry.NaturalModule.Recognition.Models
public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.RankOne.FourGroup

/-!
# The actual moving line in the component module

The genuine earlier plane identities put V₂ = [V₂,Y₊] inside U_L.
The action of M ∩ I preserves it. Since Y₊ is generated by elements of
order three, its full commutator action on this four-group has no
nonidentity fixed point. Restriction to the binary realization of U_L
therefore gives a line of order four, invariant under both the actual
component parabolic and the original Sylow subgroup, and disjoint from
the Y₊-fixed space. All actors use the original star map.

`LineData` records only the displayed preliminary identities, not a module
classification, an assumed fixed-space equality on U_L, or coordinates.
This construction supplies the geometric input for both FF exclusions.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), 15.3.10–11
and the proof of 15.3.32(1), printed pp.1123–1124 and 1132.
-/

@[expose] public section


open Subgroup Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.EightGeometry.NaturalModule.Recognition
variable {G : Type*} [Group G]

/-- Earlier local plane identities used in 15.3.32. These are conclusions
of 15.3.11 and the natural action in 15.3.10, not module recognition. -/
structure LineData (d : LocalData G) (I : Subgroup G) : Prop where
  theta_eq : theta (d.MI I) = d.Yplus
  normalizer_eq : I ⊓ normalizer (d.Yplus : Set G) = d.MI I
  plane_eq : ⁅d.V, d.Yplus⁆ = d.V₂
  plane_full : ⁅d.V₂, d.Yplus⁆ = d.V₂
  plane_le_span : d.V₂ ≤ d.UI I

variable (d : LocalData G) {I : Subgroup G} (c : ComponentWitness d I)

/-- The full `Y₊`-action puts the actual line into the component module. -/
theorem LineData.plane_le_component (h : LineData d I) (hYL : d.Yplus ≤ c.L) :
    d.V₂ ≤ d.componentModule I c.L := by
  rw [← h.plane_full]
  exact commutator_mono h.plane_le_span hYL

/-- The actual local intersection preserves the actual line. -/
theorem LineData.plane_normalized (h : LineData d I) :
    d.MI I ≤ normalizer (d.V₂ : Set G) := by
  intro m hm
  rw [← h.plane_eq, mem_normalizer_iff_map_conj_eq, map_commutator]
  exact congrArg₂ (fun A B : Subgroup G => ⁅A, B⁆)
    (mem_normalizer_iff_map_conj_eq.mp (d.action.normalizes hm.1))
    (mem_normalizer_iff_map_conj_eq.mp ((h.normalizer_eq.ge hm).2))

/-- The order-three-generated action has no nonidentity fixed point on `V₂`. -/
theorem LineData.plane_fixed_trivial [Finite G] (h : LineData d I) :
    d.V₂ ⊓ centralizer (d.Yplus : Set G) = ⊥ := by
  let _ := d.action.elementary_of_le (d.action.plane_le
    (Multiplicative.ofAdd (1 : ZMod 2)))
  have hc : Nat.card d.V₂ = 4 := d.action.card_plane _
  let _ : Nontrivial d.V₂ := Finite.one_lt_card_iff_nontrivial.mp (by rw [hc]; decide)
  let _ : IsKleinFour d.V₂ := ⟨hc, IsElementaryAbelian.exponent_eq_prime⟩
  have hgen : theta d.Yplus = d.Yplus := by rw [← h.theta_eq, theta_idempotent]
  have hYM : d.Yplus ≤ d.MI I := h.theta_eq ▸ theta_le (d.MI I)
  exact Section03.RankOne.fourGroup_centralizer_eq_bot hgen
    (hYM.trans (h.plane_normalized d)) h.plane_full

variable [Finite G]
  (hn : (c.L.subgroupOf I).Normal) (hI : I = c.L ⊔ d.S)
  (hchar : HasCharacteristicTwo I)
  (P : Sylow 2 I) (hP : (P : Subgroup I).map I.subtype = d.S)
  [IsElementaryAbelian 2 ((d.componentModule I c.L).subgroupOf I)]

/-- The subspace is the original `V₂`, restricted twice into the internal module. -/
noncomputable def planeSpace :
    Submodule (ZMod 2) (Additive ((d.componentModule I c.L).subgroupOf I)) :=
  Representation.NormalElementaryQuotient.subspace _
    ((d.V₂.subgroupOf I).subgroupOf ((d.componentModule I c.L).subgroupOf I))

omit [Finite G] in
/-- Membership in the line keeps its original ambient interpretation. -/
theorem mem_planeSpace (v : Additive ((d.componentModule I c.L).subgroupOf I)) :
    v ∈ planeSpace d c ↔ ((v.toMul : I) : G) ∈ d.V₂ := Iff.rfl

/-- An ambient line normalizer preserves its subspace under the same star map. -/
theorem planeSpace_stable {X : Subgroup G} (hX : X ≤ normalizer (d.V₂ : Set G)) :
    ∀ x ∈ d.starImage I X, ∀ v ∈ planeSpace d c,
      componentAction d c hn hI hchar P hP x v ∈ planeSpace d c := by
  rintro x ⟨i, hi, rfl⟩ v hv
  rw [mem_planeSpace, componentAction_apply]
  exact (hX hi _).mp hv

include P hP in
/-- The intrinsic line has exactly the four original elements of `V₂`. -/
theorem LineData.planeSpace_card (h : LineData d I) (hYL : d.Yplus ≤ c.L) :
    Nat.card (planeSpace d c) = 4 := by
  have hWU := h.plane_le_component d c hYL
  have hWI : d.componentModule I c.L ≤ I :=
    (componentModule_le_span d c).trans (span_le d (hP ▸ map_subtype_le _))
  let e : planeSpace d c ≃ d.V₂ := {
    toFun v := ⟨((v.val.toMul : I) : G), v.property⟩
    invFun v := ⟨Additive.ofMul ⟨⟨v, hWI (hWU v.property)⟩, hWU v.property⟩, v.property⟩
    left_inv _ := rfl
    right_inv _ := rfl }
  exact (Nat.card_congr e).trans (d.action.card_plane _)

/-- The quotient representation does not create a fixed vector on the line. -/
theorem LineData.planeSpace_fixed_disjoint (h : LineData d I) :
    Disjoint (planeSpace d c)
      (fixedSpace (componentAction d c hn hI hchar P hP) (d.starImage I d.Yplus)) := by
  apply Submodule.disjoint_def.mpr
  intro v hv hfix
  have hcen : ((v.toMul : I) : G) ∈ centralizer (d.Yplus : Set G) := by
    intro y hy
    have hyI : y ∈ I := (h.theta_eq ▸ theta_le (d.MI I)) hy |>.2
    have he := hfix ⟨d.starMap I ⟨y, hyI⟩, mem_map_of_mem _ hy⟩
    have he' := congrArg (fun w : Additive ((d.componentModule I c.L).subgroupOf I) =>
      ((w.toMul : I) : G)) he
    change (((componentAction d c hn hI hchar P hP (d.starMap I ⟨y, hyI⟩) v).toMul : I) : G) =
      ((v.toMul : I) : G) at he'
    rw [componentAction_apply] at he'
    exact mul_inv_eq_iff_eq_mul.mp he'
  have he : ((v.toMul : I) : G) = 1 :=
    mem_bot.mp (h.plane_fixed_trivial d ▸ (show ((v.toMul : I) : G) ∈
      d.V₂ ⊓ centralizer (d.Yplus : Set G) from ⟨hv, hcen⟩))
  exact Additive.toMul.injective (Subtype.ext (Subtype.ext he))

/-- The moving line needed by both model exclusions, with all original actors. -/
noncomputable def LineData.movingLine (h : LineData d I) (hYL : d.Yplus ≤ c.L) :
    Models.MovingLine (componentAction d c hn hI hchar P hP)
      (d.starImage I (d.M ⊓ c.L)) (d.starImage I d.S) (d.starImage I d.Yplus) where
  space := planeSpace d c
  card := h.planeSpace_card d c P hP hYL
  parabolic_stable := planeSpace_stable d c hn hI hchar P hP
    ((inf_le_inf_left d.M (component_le c)).trans (h.plane_normalized d))
  sylow_stable := planeSpace_stable d c hn hI hchar P hP
    ((le_inf (inf_le_left.trans d.sylow_le)
      (show d.S ≤ I from hP ▸ map_subtype_le (P : Subgroup I))).trans
      (h.plane_normalized d))
  fixed_disjoint := h.planeSpace_fixed_disjoint d c hn hI hchar P hP

end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.EightGeometry.NaturalModule.Recognition

end
