module

public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.EightGeometry.ResidualCentralizers.ComponentExtension.MarkedAction
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.EightGeometry.ResidualCentralizers.LocalFamily
public import Theory.GroupTheory.CComponent.ThreeResidual
public import Theory.GroupTheory.PResidual.PrimeTo

/-!
# The ordinary A.3.18 residual conclusion for an A₈ component

A normal C-component with intrinsic core quotient A₈ has index prime to three
in an ambient group of three-rank at most two. The quotient is centerless,
has three-rank greater than one, and has two-group outer automorphism group.
The checked C-component index theorem therefore gives the upper inclusion
for the subgroup generated by all three-power elements.

For the reverse inclusion, a three-element survives in the actual A₈
quotient. The normal image of the three-generated subgroup is therefore
all of A₈. If that subgroup were proper in the C-component, it would be
solvable, contradicting this image. Thus it generates the component.
This proves the ordinary outcome of A.3.18 directly; no exceptional cover
or extension is assumed away, and the residual is `primePowerGenerated`.

The local adapter retains the standing simple-QTKE hypothesis when deriving
SQTK of the line centralizer. Placement as a normal C-component is a separate
premise here and remains the obligation of the extension argument.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), A.3.18,
printed pp.51–52, and 15.3.32(3), printed p.1133.
-/

@[expose] public section

open Subgroup
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.EightGeometry.ComponentExtension
universe u
variable {G : Type u} [Group G] [Finite G]

private theorem eight_outer_two : IsPGroup 2 (MulAut.Outer (alternatingGroup (Fin 8))) := by
  let A := alternatingGroup (Fin 8)
  have htwo : IsPGroup 2 (Equiv.Perm (Fin 8) ⧸ A) := by
    apply IsPGroup.of_card (n := 1)
    rw [← A.index_eq_card, alternatingGroup.index_eq_two]
    rfl
  apply htwo.of_surjective (MulAut.outerAction A)
  intro x
  obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective (MulAut.innerSubgroup A) x
  obtain ⟨σ, rfl⟩ :=
    (GroupTheory.AutAlternating.aut_alternatingGroup_bijective_conj 8 (by decide) (by decide)).surjective a
  exact ⟨QuotientGroup.mk' A σ, rfl⟩

private theorem center_bot_of_equiv {Q R : Type*} [Group Q] [Group R]
    (e : Q ≃* R) (hz : center R = ⊥) : center Q = ⊥ := by
  apply eq_bot_iff.mpr
  intro x hx
  have he : e x ∈ center R := (centerCongr e ⟨x, hx⟩).property
  rw [hz, mem_bot] at he
  exact e.map_eq_one_iff.mp he

private theorem component_generated_by_three {H : Type*} [Group H] [Finite H]
    (L : Subgroup H) (hL : L.IsCComponent)
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 8)) :
    primePowerGenerated 3 L = ⊤ := by
  let f := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))
  have hf : Function.Surjective f := e.surjective.comp (QuotientGroup.mk'_surjective _)
  have hk : f.ker = pCore 2 L := by
    dsimp only [f]
    rw [MonoidHom.ker_comp_of_injective _ _ e.injective, QuotientGroup.ker_mk']
  let R := primePowerGenerated 3 L
  have hcard : Nat.card (alternatingGroup (Fin 8)) = 20160 := by
    rw [nat_card_alternatingGroup, Nat.card_fin]
    decide
  have hdiv : 3 ∣ Nat.card L :=
    dvd_trans ((by rw [hcard]; norm_num)) (card_dvd_of_surjective f hf)
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := L) 3 hdiv
  have hxR : x ∈ R := mem_primePowerGenerated_of_pow (n := 1) (by
    simpa only [pow_one, hx] using pow_orderOf_eq_one x)
  have hxne : f x ≠ 1 := by
    intro hfx
    have hxcore : x ∈ pCore 2 L := hk ▸ (show x ∈ f.ker from hfx)
    obtain ⟨n, hn⟩ := (pCore_isPGroup (p := 2) (G := L)) ⟨x, hxcore⟩
    have hd : 3 ∣ 2 ^ n := by
      rw [← hx]
      exact orderOf_dvd_of_pow_eq_one (congrArg Subtype.val hn)
    exact (by simpa using (Nat.prime_three.dvd_of_dvd_pow hd))
  let : (R.map f).Normal := (inferInstance : R.Normal).map f hf
  have htop : R.map f = ⊤ := by
    rcases alternatingGroup.normal_subgroup_eq_bot_or_eq_top (by simp : 5 ≤ Nat.card (Fin 8))
      (N := R.map f) with hb | ht
    · have hm := mem_map_of_mem f hxR
      rw [hb, mem_bot] at hm
      exact (hxne hm).elim
    · exact ht
  by_contra hR
  let : Group.IsSolvable R := hL.isSolvable_of_subnormal_lt_top
    (inferInstance : R.Normal).isSubnormal hR
  have hs : Group.IsSolvable (alternatingGroup (Fin 8)) :=
    Group.isSolvable_of_surjective (f := f.domRestrict R) (by
      intro a
      obtain ⟨x, hx, he⟩ := (show a ∈ R.map f from htop.symm ▸ mem_top a)
      exact ⟨⟨x, hx⟩, he⟩)
  let : Group.IsPerfect (alternatingGroup (Fin 8)) :=
    ⟨commutator_alternatingGroup_eq_top (by simp)⟩
  exact Group.IsPerfect.not_isSolvable _ hs

/-- The ordinary A.3.18 outcome for an actual A₈ core quotient. The
centerless rank-two quotient and its three-prime outer order exclude every
extra three-part in the overgroup. The reverse inclusion uses generation
by three-elements in the C-component. -/
theorem normal_eight_component_eq_primePowerGenerated {H : Type*} [Group H] [Finite H]
    (L : Subgroup H) [L.Normal] (hL : L.IsCComponent)
    (e : (L ⧸ pCore 2 L) ≃* alternatingGroup (Fin 8))
    (hr : primeRank 3 H ≤ 2) : L = primePowerGenerated 3 H := by
  have hz : center (L ⧸ pCore 2 L) = ⊥ :=
    center_bot_of_equiv e (alternatingGroup.center_eq_bot (by simp))
  have hrL : 2 ≤ primeRank 3 (L ⧸ pCore 2 L) := by
    rw [primeRank_congr 3 e]
    exact alternatingGroup.TwoThreeCycles.two_le_primeRank (by decide)
  have ho : Nat.Coprime 3 (Nat.card (MulAut.Outer (L ⧸ pCore 2 L))) := by
    rw [Nat.card_congr (MulAut.outerCongr e).toEquiv]
    obtain ⟨n, hn⟩ := eight_outer_two.exists_card_dvd_pow
    exact ((by decide : Nat.Coprime 3 2).pow_right n).coprime_dvd_right hn
  have hi := Theory.GroupTheory.cComponent_index_coprime_three_of_quotient L hL hz hrL hr ho
  apply le_antisymm
  · have hm := map_primePowerGenerated_le 3 L.subtype
    rw [component_generated_by_three L hL e, ← MonoidHom.range_eq_map, range_subtype] at hm
    exact hm
  · apply (primePowerGenerated_le_iff 3 L).mpr
    intro x n hx
    exact primeToResidual_le L hi (mem_primeToResidual_of_pow hx)

/-- The final residual step of 15.3.32(3), after the extension exclusions
have established normal C-component membership in the line centralizer.
Those two placement premises must still be discharged by final assembly. -/
theorem component_eq_fixedLine_residual_of_normal_component {κ : GroupClass.{u}}
    (hG : IsSimpleQTKE κ G) (d : LocalData G) {I : Subgroup G}
    (c : ComponentWitness d I) (hjoin : I = c.L ⊔ d.S)
    (hfixed : d.ZS ⊓ centralizer (c.L : Set G) = d.ZS ⊓ d.V₁)
    (hcard : Nat.card (d.ZS ⊓ d.V₁ : Subgroup G) = 2)
    (P : Sylow 2 I) (hP : (P : Subgroup I).map I.subtype = d.S)
    (hcentralizer : I ⊓ centralizer (d.componentModule I c.L : Set G) = I.pCoreIn 2)
    (e : d.Star I ≃* Equiv.Perm (Fin 8))
    (hmark : (d.starImage I c.L).map e.toMonoidHom = alternatingGroup (Fin 8))
    (hcomponent : (c.L.subgroupOf (centralizer ((d.ZS ⊓ d.V₁ : Subgroup G) : Set G))).IsCComponent)
    (hnormal : (c.L.subgroupOf (centralizer ((d.ZS ⊓ d.V₁ : Subgroup G) : Set G))).Normal) :
    c.L = RankOne.threeResidualIn (centralizer ((d.ZS ⊓ d.V₁ : Subgroup G) : Set G)) := by
  let C := centralizer ((d.ZS ⊓ d.V₁ : Subgroup G) : Set G)
  have hLC : c.L ≤ C := (component_le c).trans
    (overgroup_le_fixedLine_centralizer d c hjoin hfixed)
  let N := c.L.subgroupOf C
  let _ : N.Normal := hnormal
  let q := (QuotientGroup.congr _ _ (subgroupOfEquivOfLe hLC) (pCore_map_iso 2 _)).trans
    (componentCoreEquivEightOfModule d c P hP hcentralizer e hmark)
  have he := normal_eight_component_eq_primePowerGenerated N hcomponent q
    ((fixedLine_centralizer_sqtk hG d hcard).stronglyQuasithin 3 (by decide) (by decide))
  have hm := congrArg (Subgroup.map C.subtype) he
  simpa only [N, map_subgroupOf_eq_of_le hLC, RankOne.threeResidualIn] using hm

end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankOneConfiguration.EightGeometry.ComponentExtension

end
