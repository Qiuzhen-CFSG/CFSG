module

public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.Basic
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.ConjugatePair
public import Theory.GroupTheory.PResidual.SubnormalCoreAction

/-!
# The actual commutator core in the L₃(2) elimination

We construct Q = [O₂(L),L] and the subgroup generated by Q and Qᵗ. Relative
normalization and two-perfect commutator idempotence prove
[O₂(LS),L] = Q. The elementary span W_L is normal in LS, so its moved part
lies in Q; the outside condition then proves Q nontrivial. The preliminary
core bound and R = C_T(V) place Q in S.

The two later source branches need only prove that Qᵗ centralizes L, or that
Qᵗ lies in O₂(LS). Either condition gives [Qᵗ,L] ≤ Q. Independently,
|T:S| = 2 transfers S-invariance from Q to Qᵗ. Thus LS normalizes their join.
The exchange of Y_L and Y_C gives Y ≤ ⟨L,T⟩, and the shared two-local
uniqueness theorem supplies the contradiction.

This is a conditional group-theoretic reduction, not the L₃(2) exclusion.
The C.1.34 case analysis, the fixed-space argument for [V,Y_L] ≠ 1, the
choice in Hypothesis 15.3.10, and construction of the two conjugate-core
bounds remain obligations of the source-case proofs. No order-three or
exponent-three assertion about Y_C or Y₊ is used.

Source: Aschbacher–Smith, combined manuscript (1 March 2004),
15.3.23, printed pp.1128–1129 (PDF pp.1145–1146).
-/

@[expose] public section

open Subgroup
open scoped commutatorElement

namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.LinearThree
variable {G : Type*} [Group G]

/-- The actual source subgroup Q = [O₂(L),L], in the original ambient group. -/
abbrev commutatorCore (L : Subgroup G) : Subgroup G := ⁅L.pCoreIn 2, L⁆

/-- The core commutator is contained in the intrinsic two-core of L. -/
theorem commutatorCore_le (L : Subgroup G) : commutatorCore L ≤ L.pCoreIn 2 := by
  exact le_normalizer_iff_commutator_le_left.mp
    (L.le_normalizer.trans (normalizer_le_normalizer_characteristic_image L (pCore 2 L)))

/-- Every automorphism of L induced by ambient conjugation preserves Q. -/
theorem normalizer_le_normalizer_commutatorCore (L : Subgroup G) :
    normalizer (L : Set G) ≤ normalizer (commutatorCore L : Set G) := by
  have hc : normalizer (L : Set G) ≤ normalizer (L.pCoreIn 2 : Set G) :=
    normalizer_le_normalizer_characteristic_image L (pCore 2 L)
  intro g hg
  apply mem_normalizer_iff_map_conj_eq.mpr
  rw [commutatorCore, map_commutator]
  rw [mem_normalizer_iff_map_conj_eq.mp (hc hg), mem_normalizer_iff_map_conj_eq.mp hg]

/-- The centralizer description of R puts it in the stabilizer of each coordinate plane. -/
theorem R_le_S (d : LocalData G)
    (hR : d.R = (d.T : Subgroup G) ⊓ centralizer (d.V : Set G)) : d.R ≤ d.S := by
  exact le_inf (hR.le.trans inf_le_left)
    ((hR.le.trans inf_le_right).trans
      ((centralizer_le (d.action.plane_le 1)).trans (Subgroup.centralizer_le_normalizer _)))

/-- The preliminary core bound places Q in the fixed two-subgroup S. -/
theorem commutatorCore_le_S (d : LocalData G) (L : Subgroup G)
    (hcore : L.pCoreIn 2 ≤ d.R)
    (hR : d.R = (d.T : Subgroup G) ⊓ centralizer (d.V : Set G)) :
    commutatorCore L ≤ d.S :=
  (commutatorCore_le L).trans (hcore.trans (R_le_S d hR))

/-- An outside component acts nontrivially on the span containing V. -/
theorem spanCommutator_ne_bot (d : LocalData G) {I : Subgroup G}
    (c : ComponentWitness d I) (hC : centralizer (d.V : Set G) ≤ d.M) :
    spanCommutator d c.L ≠ ⊥ := by
  intro h
  have hc : d.componentSpan c.L ≤ centralizer (c.L : Set G) :=
    commutator_eq_bot_iff_le_centralizer.mp h
  exact c.outside ((le_centralizer_iff.mp
    ((le_conjugateSpanBy d.V c.L).trans hc)).trans hC)

/-- Any containment of the moved span in Q proves Q nontrivial. -/
theorem commutatorCore_ne_bot (d : LocalData G) {I : Subgroup G}
    (c : ComponentWitness d I) (hC : centralizer (d.V : Set G) ≤ d.M)
    (hUQ : spanCommutator d c.L ≤ commutatorCore c.L) : commutatorCore c.L ≠ ⊥ := by
  intro h
  exact spanCommutator_ne_bot d c hC (eq_bot_iff.mpr (hUQ.trans h.le))

/-- Exchanging the actual residual factors puts Y in the subgroup generated by L and T. -/
theorem Y_le_component_sylow (d : LocalData G) (L : Subgroup G)
    (hY : d.Y = YL d L ⊔ YC d L) (t : G) (ht : t ∈ (d.T : Subgroup G))
    (hexchange : (YL d L).conjBy t = YC d L) : d.Y ≤ L ⊔ (d.T : Subgroup G) := by
  have hYL : YL d L ≤ L := (ComponentIntersection.intersectionResidual_le _ _).trans inf_le_right
  rw [hY, ← hexchange]
  refine sup_le (hYL.trans le_sup_left) ?_
  rintro x ⟨y, hy, rfl⟩
  exact ((L ⊔ (d.T : Subgroup G)).le_normalizer (mem_sup_right ht) y).mp
    (mem_sup_left (hYL hy))

private theorem normalizes_sup_of_cross_commutator {A Q U : Subgroup G}
    (hAQ : A ≤ normalizer (Q : Set G)) (hcomm : ⁅U, A⁆ ≤ Q) :
    A ≤ normalizer ((Q ⊔ U : Subgroup G) : Set G) := by
  apply le_normalizer_iff.mpr
  intro a ha w hw
  have hmap : (Q ⊔ U).map (MulAut.conj a).toMonoidHom ≤ Q ⊔ U := by
    rw [Subgroup.map_sup]
    apply sup_le
    · apply map_le_iff_le_comap.mpr
      intro q hq
      exact mem_sup_left ((hAQ ha q).mp hq)
    · apply map_le_iff_le_comap.mpr
      intro u hu
      have hc : ⁅a, u⁆ ∈ Q := hcomm
        ((commutator_comm A U) ▸ commutator_mem_commutator ha hu)
      have hm := (Q ⊔ U).mul_mem (mem_sup_left hc) (mem_sup_right hu)
      change a * u * a⁻¹ ∈ Q ⊔ U
      simpa only [commutatorElement_def, mul_assoc, inv_mul_cancel, mul_one] using hm
  exact hmap (mem_map.mpr ⟨w, hw, rfl⟩)

/-- The index-two relation makes S preserve the t-conjugate of Q whenever S preserves L. -/
theorem S_normalizes_conjugate_core (d : LocalData G) (L : Subgroup G)
    (hindex : (d.S.subgroupOf (d.T : Subgroup G)).index = 2)
    (hSL : d.S ≤ normalizer (L : Set G)) (t : G) (ht : t ∈ (d.T : Subgroup G)) :
    d.S ≤ normalizer ((commutatorCore L).conjBy t : Set G) := by
  have hSQ := hSL.trans (normalizer_le_normalizer_commutatorCore L)
  have hTS : (d.T : Subgroup G) ≤ normalizer (d.S : Set G) :=
    (normal_subgroupOf_iff_le_normalizer (show d.S ≤ (d.T : Subgroup G) from inf_le_left)).mp
      (normal_of_index_eq_two hindex)
  change d.S ≤ normalizer ((commutatorCore L).map (MulAut.conj t).toMonoidHom : Set G)
  rw [← map_equiv_normalizer_eq]
  have hmap := map_mono (f := (MulAut.conj t).toMonoidHom) hSQ
  have heq : d.S.map (MulAut.conj t).toMonoidHom = d.S :=
    mem_normalizer_iff_map_conj_eq.mp (hTS ht)
  rwa [heq] at hmap

/-- A commutator bound with L suffices: invariance under S follows independently from index two. -/
theorem pair_normalized_of_cross_commutator (d : LocalData G) (L : Subgroup G)
    (hindex : (d.S.subgroupOf (d.T : Subgroup G)).index = 2)
    (hSL : d.S ≤ normalizer (L : Set G)) (t : G) (ht : t ∈ (d.T : Subgroup G))
    (hcomm : ⁅(commutatorCore L).conjBy t, L⁆ ≤ commutatorCore L) :
    L ⊔ d.S ≤ normalizer (conjugatePair (commutatorCore L) t : Set G) := by
  refine sup_le ?_ ?_
  · exact normalizes_sup_of_cross_commutator
      (normalizer_commutator_ge_right _ _) hcomm
  · exact (le_inf (hSL.trans (normalizer_le_normalizer_commutatorCore L))
      (S_normalizes_conjugate_core d L hindex hSL t ht)).trans
      (normalizer_inf_normalizer_le_normalizer_sup _ _)

private theorem component_perfect (d : LocalData G) {I : Subgroup G}
    (c : ComponentWitness d I) : Group.IsPerfect c.L := by
  let _ := c.component.perfect
  have hp := Group.IsPerfect.map (Stellmacher.elementaryAbelianMaxJ I).subtype
    (H := c.L.subgroupOf (Stellmacher.elementaryAbelianMaxJ I))
  rwa [map_subgroupOf_eq_of_le c.le_thompson] at hp

private theorem component_twoPerfect [Finite G] (d : LocalData G) {I : Subgroup G}
    (c : ComponentWitness d I) : IsPPerfect 2 c.L := by
  let _ := component_perfect d c
  intro N hN hp
  let _ := hN
  have hsub : Subsingleton (c.L ⧸ N) := by
    by_contra! hn
    exact Group.IsPerfect.not_isNilpotent (c.L ⧸ N) hp.isNilpotent
  apply eq_top_iff.mpr
  intro g _
  exact (QuotientGroup.eq_one_iff g).mp (Subsingleton.elim _ _)

/-- Two-perfect commutator idempotence absorbs the external two-core action into Q. -/
theorem overgroup_core_commutator_le [Finite G] (d : LocalData G) {I : Subgroup G}
    (c : ComponentWitness d I) (hSL : d.S ≤ normalizer (c.L : Set G)) :
    ⁅(c.L ⊔ d.S).pCoreIn 2, c.L⁆ ≤ commutatorCore c.L := by
  let X := (c.L ⊔ d.S).pCoreIn 2
  have hLX : c.L ≤ normalizer (X : Set G) := le_sup_left.trans
    ((c.L ⊔ d.S).le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image (c.L ⊔ d.S)
        (pCore 2 (c.L ⊔ d.S : Subgroup G))))
  have hXL : X ≤ normalizer (c.L : Set G) :=
    (pCoreIn_le 2 _).trans (sup_le c.L.le_normalizer hSL)
  have hpX : IsPGroup 2 X := (c.L ⊔ d.S).isPGroup_pCoreIn 2
  have hcore : ⁅X, c.L⁆ ≤ c.L.pCoreIn 2 := le_pCoreIn_of_normalizes
    (hpX.to_le (le_normalizer_iff_commutator_le_left.mp hLX))
    (le_normalizer_iff_commutator_le_right.mp hXL)
    (normalizer_commutator_ge_right X c.L)
  exact (commutator_isPPerfect_idempotent c.L X (component_twoPerfect d c) hpX hLX).symm.le.trans
    (commutator_mono hcore le_rfl)

/-- The source identity [O₂(LS),L] = [O₂(L),L], with only relative normalization. -/
theorem overgroup_core_commutator_eq [Finite G] (d : LocalData G) {I : Subgroup G}
    (c : ComponentWitness d I) (hSL : d.S ≤ normalizer (c.L : Set G)) :
    ⁅(c.L ⊔ d.S).pCoreIn 2, c.L⁆ = commutatorCore c.L := by
  apply le_antisymm (overgroup_core_commutator_le d c hSL)
  apply commutator_mono ?_ le_rfl
  exact le_pCoreIn_of_normalizes (c.L.isPGroup_pCoreIn 2)
    ((c.L.pCoreIn_le 2).trans le_sup_left)
    ((sup_le c.L.le_normalizer hSL).trans
      (normalizer_le_normalizer_characteristic_image c.L (pCore 2 c.L)))

/-- Both L and S normalize the actual conjugate span once S normalizes L. -/
theorem component_sylow_normalizes_span (d : LocalData G) (L : Subgroup G)
    (hSL : d.S ≤ normalizer (L : Set G)) :
    L ⊔ d.S ≤ normalizer (d.componentSpan L : Set G) := by
  refine sup_le (le_normalizer_conjugateSpanBy d.V L) ?_
  have hSV : d.S ≤ normalizer (d.V : Set G) :=
    inf_le_left.trans (d.sylow_le.trans d.action.normalizes)
  apply le_normalizer_closure_iff.mpr
  rintro s hs x ⟨l, hl, v, hv, rfl⟩
  refine subset_closure ⟨s * l * s⁻¹, (hSL hs l).mp hl,
    s * v * s⁻¹, (hSV hs v).mp hv, ?_⟩
  group

/-- An elementary span is a normal two-subgroup of LS, hence lies in its two-core. -/
theorem span_le_overgroup_core [Finite G] (d : LocalData G) (L : Subgroup G)
    [IsElementaryAbelian 2 (d.componentSpan L)]
    (hSL : d.S ≤ normalizer (L : Set G)) :
    d.componentSpan L ≤ (L ⊔ d.S).pCoreIn 2 := by
  have hVS : d.V ≤ d.S := d.action.le_planeStabilizer d.T d.sylow_le
    (localModule_le d.T d.sylow_le) 1
  have hW : d.componentSpan L ≤ L ⊔ d.S := conjugateSpanBy_le
    (hVS.trans le_sup_right) (le_sup_left.trans (L ⊔ d.S).le_normalizer)
  exact le_pCoreIn_of_normalizes (IsElementaryAbelian.isPGroup 2 (d.componentSpan L))
    hW (component_sylow_normalizes_span d L hSL)

/-- The moved span U_L lies in Q, without assuming a classified core shape. -/
theorem spanCommutator_le_core [Finite G] (d : LocalData G) {I : Subgroup G}
    (c : ComponentWitness d I) [IsElementaryAbelian 2 (d.componentSpan c.L)]
    (hSL : d.S ≤ normalizer (c.L : Set G)) :
    spanCommutator d c.L ≤ commutatorCore c.L :=
  (commutator_mono (span_le_overgroup_core d c.L hSL) le_rfl).trans
    (overgroup_core_commutator_le d c hSL)

/-- The elementary span and the outside condition force Q to be nontrivial. -/
theorem commutatorCore_ne_bot_of_elementary_span [Finite G] (d : LocalData G)
    {I : Subgroup G} (c : ComponentWitness d I)
    [IsElementaryAbelian 2 (d.componentSpan c.L)]
    (hSL : d.S ≤ normalizer (c.L : Set G))
    (hC : centralizer (d.V : Set G) ≤ d.M) : commutatorCore c.L ≠ ⊥ :=
  commutatorCore_ne_bot d c hC (spanCommutator_le_core d c hSL)

/-- The normalization deduction for the one- and two-chief-factor branches; the conjugate-core containment remains to be constructed. -/
theorem pair_normalized_of_conjugate_le_core [Finite G] (d : LocalData G) {I : Subgroup G}
    (c : ComponentWitness d I)
    (hindex : (d.S.subgroupOf (d.T : Subgroup G)).index = 2)
    (hSL : d.S ≤ normalizer (c.L : Set G)) (t : G) (ht : t ∈ (d.T : Subgroup G))
    (hconj : (commutatorCore c.L).conjBy t ≤ (c.L ⊔ d.S).pCoreIn 2) :
    c.L ⊔ d.S ≤ normalizer (conjugatePair (commutatorCore c.L) t : Set G) := by
  apply pair_normalized_of_cross_commutator d c.L hindex hSL t ht
  exact (commutator_mono hconj le_rfl).trans (overgroup_core_commutator_le d c hSL)

/-- The normalization deduction for the three-chief-factor branch; centralization of L remains to be constructed. -/
theorem pair_normalized_of_conjugate_centralizes (d : LocalData G) (L : Subgroup G)
    (hindex : (d.S.subgroupOf (d.T : Subgroup G)).index = 2)
    (hSL : d.S ≤ normalizer (L : Set G)) (t : G) (ht : t ∈ (d.T : Subgroup G))
    (hconj : (commutatorCore L).conjBy t ≤ centralizer (L : Set G)) :
    L ⊔ d.S ≤ normalizer (conjugatePair (commutatorCore L) t : Set G) := by
  apply pair_normalized_of_cross_commutator d L hindex hSL t ht
  rw [commutator_eq_bot_iff_le_centralizer.mpr hconj]
  exact bot_le

/-- Conditional final group-theoretic deduction of 15.3.23. The source-case proofs must construct the exchanged residuals and one of the two conjugate-core bounds; this theorem does not establish those model-dependent inputs. -/
theorem contradiction_of_conjugate_core_control [Finite G] (d : LocalData G)
    {I : Subgroup G} (c : ComponentWitness d I)
    [IsElementaryAbelian 2 (d.componentSpan c.L)]
    (hindex : (d.S.subgroupOf (d.T : Subgroup G)).index = 2)
    (hR : d.R = (d.T : Subgroup G) ⊓ centralizer (d.V : Set G))
    (hcore : c.L.pCoreIn 2 ≤ d.R)
    (hC : centralizer (d.V : Set G) ≤ d.M)
    (hSL : d.S ≤ normalizer (c.L : Set G))
    (hY : d.Y = YL d c.L ⊔ YC d c.L)
    (t : G) (ht : t ∈ (d.T : Subgroup G)) (htS : t ∉ d.S)
    (hexchange : (YL d c.L).conjBy t = YC d c.L)
    (hcontrol : (commutatorCore c.L).conjBy t ≤ centralizer (c.L : Set G) ∨
      (commutatorCore c.L).conjBy t ≤ (c.L ⊔ d.S).pCoreIn 2)
    (hunique : Chapter4.UniqueMaximalOvergroup (d.Y ⊔ (d.T : Subgroup G)) d.M) :
    False := by
  have hnorm : c.L ⊔ d.S ≤ normalizer (conjugatePair (commutatorCore c.L) t : Set G) := by
    rcases hcontrol with h | h
    · exact pair_normalized_of_conjugate_centralizes d c.L hindex hSL t ht h
    · exact pair_normalized_of_conjugate_le_core d c hindex hSL t ht h
  exact outside_conjugatePair_contradiction d c.outside
    (commutatorCore_ne_bot_of_elementary_span d c hSL hC)
    (commutatorCore_le_S d c.L hcore hR) t ht htS hindex
    (hSL.trans (normalizer_le_normalizer_commutatorCore c.L)) hnorm
    (Y_le_component_sylow d c.L hY t ht hexchange) hunique

end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.LinearThree

end
