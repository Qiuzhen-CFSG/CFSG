module

public import Theory.SpecificGroups.SymmetricThreeProduct.NormalThreeSubgroups
/-!
# Distinguishing moved and fixed cubic directions

In S₃ × S₃, a nonidentity cubic element fixed by an actor and a nontrivial
commutator with that actor lie on opposite coordinate axes. This identifies
two cubic subgroups when one is generated by those commutators and the other
is fixed. The only finite check is a three-permutation calculation in S₃.

This is the quotient-action step of Aschbacher–Smith 15.3.23, printed p.1128
(combined manuscript, 1 March 2004). It assumes no invariance under the full
rank-two actor.
-/

public section
open Subgroup
open scoped commutatorElement
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.LinearThree.ResidualInvariance
private theorem cubic_fixed_commutes : ∀ (a b t : Equiv.Perm (Fin 3)),
    a ^ 3 = 1 → b ^ 3 = 1 → b ≠ 1 → t * b = b * t → a * t = t * a := by
  decide +kernel

private theorem reflection_test (a b t : SymmetricThreeProduct.G)
    (ha : a ^ 3 = 1) (hb : b ^ 3 = 1) (hb1 : b ≠ 1)
    (hbt : t * b = b * t) (hat : ⁅a,t⁆ ≠ 1) :
    ((⁅a,t⁆).2 = 1 ∧ b.1 = 1) ∨ ((⁅a,t⁆).1 = 1 ∧ b.2 = 1) := by
  have hcomm₁ (h : b.1 ≠ 1) : (⁅a,t⁆).1 = 1 := by
    have hc := cubic_fixed_commutes a.1 b.1 t.1 (congrArg Prod.fst ha)
      (congrArg Prod.fst hb) h (congrArg Prod.fst hbt)
    change a.1 * t.1 * a.1⁻¹ * t.1⁻¹ = 1
    rw [hc]
    group
  have hcomm₂ (h : b.2 ≠ 1) : (⁅a,t⁆).2 = 1 := by
    have hc := cubic_fixed_commutes a.2 b.2 t.2 (congrArg Prod.snd ha)
      (congrArg Prod.snd hb) h (congrArg Prod.snd hbt)
    change a.2 * t.2 * a.2⁻¹ * t.2⁻¹ = 1
    rw [hc]
    group
  by_cases hb₁ : b.1 = 1
  · exact Or.inl ⟨hcomm₂ (fun h => hb1 (Prod.ext hb₁ h)), hb₁⟩
  · refine Or.inr ⟨hcomm₁ hb₁, ?_⟩
    by_contra hb₂
    exact hat (Prod.ext (hcomm₁ hb₁) (hcomm₂ hb₂))

private theorem cubic_generator {H : Type*} [Group H] [Finite H]
    (A : Subgroup H) (hc : Nat.card A = 3) {a : H} (ha : a ∈ A) (ha1 : a ≠ 1) :
    zpowers a = A := by
  have ho : orderOf a = 3 := by
    rcases Nat.prime_three.eq_one_or_self_of_dvd _ (hc ▸ A.orderOf_dvd_natCard ha) with h | h
    · exact (ha1 (orderOf_eq_one_iff.mp h)).elim
    · exact h
  exact eq_of_le_of_card_ge (zpowers_le_of_mem ha) (by rw [Nat.card_zpowers, ho, hc])

/-- A moved cubic direction and a fixed cubic direction in the actual S₃ × S₃
shadow are its two coordinate axes, in either orientation. -/
theorem shadow_axes_of_moved_fixed (A B T : Subgroup SymmetricThreeProduct.G)
    (hA : A ≤ SymmetricThreeProduct.threeCore.prod SymmetricThreeProduct.threeCore)
    (hB : B ≤ SymmetricThreeProduct.threeCore.prod SymmetricThreeProduct.threeCore)
    (hA3 : Nat.card A = 3) (hB3 : Nat.card B = 3)
    (hm : ⁅A,T⁆ = A) (hf : ⁅B,T⁆ = ⊥) :
    (A = SymmetricThreeProduct.leftThree ∧ B = SymmetricThreeProduct.rightThree) ∨
    (A = SymmetricThreeProduct.rightThree ∧ B = SymmetricThreeProduct.leftThree) := by
  classical
  have hAn : A ≠ ⊥ := by intro h; simp [h] at hA3
  have hBn : B ≠ ⊥ := by intro h; simp [h] at hB3
  obtain ⟨b,hb,hb1⟩ : ∃ b ∈ B, b ≠ 1 := by
    by_contra! h
    exact hBn (B.eq_bot_iff_forall.mpr h)
  have hex : ∃ a ∈ A, ∃ t ∈ T, ⁅a,t⁆ ≠ 1 := by
    by_contra! h
    apply hAn
    rw [← hm]
    exact le_bot_iff.mp (commutator_le.mpr h)
  obtain ⟨a,ha,t,ht,hat⟩ := hex
  have hcA : ⁅a,t⁆ ∈ A := hm ▸ commutator_mem_commutator ha ht
  have hcP := hA hcA
  have hbP := hB hb
  have hbt : t * b = b * t :=
    commutator_eq_bot_iff_le_centralizer.mp hf hb t ht
  have hga := cubic_generator A hA3 hcA hat
  have hgb := cubic_generator B hB3 hb hb1
  rcases reflection_test a b t (Prod.ext (hA ha).1 (hA ha).2)
      (Prod.ext hbP.1 hbP.2) hb1 hbt hat with h | h
  · exact Or.inl ⟨hga.symm.trans (cubic_generator _ SymmetricThreeProduct.card_leftThree
      ⟨hcP.1,h.1⟩ hat),
      hgb.symm.trans (cubic_generator _ SymmetricThreeProduct.card_rightThree
      ⟨h.2,hbP.2⟩ hb1)⟩
  · exact Or.inr ⟨hga.symm.trans (cubic_generator _ SymmetricThreeProduct.card_rightThree
      ⟨h.1,hcP.2⟩ hat),
      hgb.symm.trans (cubic_generator _ SymmetricThreeProduct.card_leftThree
      ⟨hbP.1,h.2⟩ hb1)⟩
end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.LinearThree.ResidualInvariance

end
