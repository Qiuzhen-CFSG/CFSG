module
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.LinearThree.OriginalSource.FullCover.Layers
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.LinearThree.OriginalSource.FullCover.Plane
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.LinearThree.OriginalSource.FullCover.Dynamics

/-!
The actual moving plane lies in the natural derived subgroup of the core.
Its plane-parabolic residual generates the full cover; the exchanged residual
then centralizes the core and component by the exact doubled-dual quotient
calculation. This supplies the original conjugate-core contradiction without
discarding any fixed part of the center.
Source: Aschbacher–Smith, 15.3.23, printed p.1129.
-/

public noncomputable section
open Subgroup
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.LinearThree.OriginalSource.FullCover
open CoreActions CoreActions.ThreeLayer ChapterC
open RankOneConfiguration.SmallExtension
variable {G : Type*} [Group G] [Finite G]
local notation "SL" => Matrix.SpecialLinearGroup (Fin 3) (ZMod 2)

theorem component_core_idempotent (d : LocalData G) {I : Subgroup G}
    (c : ComponentWitness d I) : ⁅commutatorCore c.L,c.L⁆ = commutatorCore c.L := by
  have hp : Group.IsPerfect c.L := by
    let _ := c.component.perfect
    have hh := Group.IsPerfect.map (Stellmacher.elementaryAbelianMaxJ I).subtype
      (H := c.L.subgroupOf (Stellmacher.elementaryAbelianMaxJ I))
    rwa [map_subgroupOf_eq_of_le c.le_thompson] at hh
  let _ := hp
  have htwo : IsPPerfect 2 c.L := by
    intro N hN hq
    let _ := hN
    have hs : Subsingleton (c.L ⧸ N) := by
      by_contra! hn
      exact Group.IsPerfect.not_isNilpotent (c.L ⧸ N) hq.isNilpotent
    apply eq_top_iff.mpr
    intro l _
    exact (QuotientGroup.eq_one_iff l).mp (Subsingleton.elim _ _)
  exact commutator_isPPerfect_idempotent c.L (c.L.pCoreIn 2) htwo
    (c.L.isPGroup_pCoreIn 2)
    (c.L.le_normalizer.trans (normalizer_le_normalizer_characteristic_image c.L (pCore 2 c.L)))

/-- The original moving plane is in Q′, whose natural action it generates.
Its doubled-dual full cover is consequently generated by YL. -/
theorem residual_actions (d : LocalData G) {I : Subgroup G}
    (c : ComponentWitness d I) [IsElementaryAbelian 2 (d.componentSpan c.L)]
    (f : BinaryMS.FullCoreDoubleDualCover c.L)
    (n : BinaryMS.NaturalCenterDoubleDualQuotient c.L) (he : f.marking = n.marking)
    {e : (c.L ⧸ pCore 2 c.L) ≃* SL}
    (h : ResidualSourceData d c.L e) (hg : ResidualGeometry d c.L)
    (hi : (d.S.subgroupOf (d.T : Subgroup G)).index = 2)
    (hpar : YL d c.L ⊔ (d.S ⊓ c.L) = c.L ⊓ normalizer (movingPlane d c.L : Set G))
    (t : G) (ht : t ∈ (d.T : Subgroup G)) (htS : t ∉ d.S) :
    YC d c.L ≤ centralizer (commutatorCore c.L : Set G) ∧
      YC d c.L ≤ centralizer (c.L : Set G) := by
  let m := naturalDerived f
  let D := ⁅commutatorCore c.L,commutatorCore c.L⁆
  have hZL := center_commutator_le_derived f
  have hYL : YL d c.L ≤ c.L :=
    (ComponentIntersection.intersectionResidual_le _ _).trans inf_le_right
  have hUZ := movingPlane_le_coreCenter d c hg.component_normalized h.core_le h.radical
  obtain ⟨i,j,hij,hU,hC,hmove,hUV,hdis⟩ := hg.coordinates
  have hUD : movingPlane d c.L ≤ D := by
    rw [←hmove]
    exact (commutator_mono hUZ hYL).trans hZL
  have hUne : movingPlane d c.L ≠ ⊥ := by
    intro hb
    have hc := hg.plane_card
    rw [hb,card_bot] at hc
    omega
  have hLC := component_normalizes_YC d c.L h.core_le h.radical
    (le_sup_right.trans hg.centralizer_residual_normalized)
  have hfix : YC d c.L ≤ centralizer (D : Set G) := by
    apply le_centralizer_iff.mpr
    dsimp only [D]
    rw [←natural_generated m hUD hUne]
    exact conjugateSpanBy_le (le_centralizer_iff.mp hg.plane_centralized)
      (hLC.trans (normalizer_le_normalizer_centralizer _))
  have hSYL := le_sup_right.trans hg.component_residual_normalized
  have hdet := Plane.YL_detected d c.L D (movingPlane d c.L) m hUD hg.plane_card hSYL hpar
  have hgen := ContainedCoreModels.cover_coinvariants_of_detected_dual f.cover f.isCover _ hdet
  have hfull : ⁅commutatorCore c.L,YL d c.L⁆ = commutatorCore c.L := by
    have hh := congrArg (fun A : Subgroup c.L => A.map c.L.subtype)
      (f.core_eq_commutator_of_coinvariants ((YL d c.L).subgroupOf c.L) hgen)
    rw [map_commutator,block_map,map_subgroupOf_eq_of_le hYL] at hh
    exact hh.symm
  have dn := dualLayer n
  rw [←he] at dn
  have hfixQ := Dynamics.YC_fixes_core d c m dn (component_core_idempotent d c) hZL hLC hfix
    hi (commutatorCore_le_S d c.L h.core_le h.radical) hSYL hUne hfull
      t ht (hg.exchange t ht htS)
  exact ⟨hfixQ,YC_centralizes_of_core_fixed d c hfixQ⟩

/-- The original rank-two source excludes the actual full distance-four cover
and exact doubled-dual quotient under their common component marking. -/
theorem contradiction (d : LocalData G) {I : Subgroup G} (hI : I ∈ d.Hplus)
    (c : ComponentWitness d I) [IsElementaryAbelian 2 (d.componentSpan c.L)]
    (f : BinaryMS.FullCoreDoubleDualCover c.L)
    (n : BinaryMS.NaturalCenterDoubleDualQuotient c.L) (he : f.marking = n.marking)
    {e : (c.L ⧸ pCore 2 c.L) ≃* SL}
    (h : ResidualSourceData d c.L e) (hg : ResidualGeometry d c.L)
    (hE : IsEvenCharacteristicAt d.T) (hne : ⁅d.V,YL d c.L⁆ ≠ ⊥)
    (hi : (d.S.subgroupOf (d.T : Subgroup G)).index = 2)
    (hC : centralizer (d.V : Set G) ≤ d.M)
    (hu : Chapter4.UniqueMaximalOvergroup (d.Y ⊔ (d.T : Subgroup G)) d.M) : False := by
  have hpar := componentParabolic_eq_planeNormalizer_of_source d hI c e h hE hne
  have hex : ∃ t : G, t ∈ (d.T : Subgroup G) ∧ t ∉ d.S := by
    by_contra! hn
    have ht : d.S.subgroupOf (d.T : Subgroup G) = ⊤ :=
      top_unique (fun t _ => hn t t.property)
    rw [ht,index_top] at hi
    omega
  obtain ⟨t,ht,htS⟩ := hex
  obtain ⟨hQ,hL⟩ := residual_actions d c f n he h hg hi hpar t ht htS
  exact contradiction_of_residual_centralization d c h hg hi hC hu hQ hL
end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.LinearThree.OriginalSource.FullCover
