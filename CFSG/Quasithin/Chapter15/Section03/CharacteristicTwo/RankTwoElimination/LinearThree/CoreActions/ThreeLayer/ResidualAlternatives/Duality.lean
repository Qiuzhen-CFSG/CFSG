module

public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.LinearThree.CoreActions.NaturalActions.Multiplicity
public import Theory.Representation.DualCommutator

/-!
# The commuting residual on two dual natural copies

Pairing identifies the dual of two dual SL₃(2) modules with two natural
modules, with the original marking preserved. If the moved space is proper,
its annihilator contains a nonzero fixed functional. The natural multiplicity
calculation then makes the dual action of any two-perfect commuting actor
trivial, and dual separation makes the original action trivial. Otherwise
the whole dual layer is generated by displacement.

Source: Aschbacher–Smith, C.1.34(3), printed pp.136–137, and the three-layer
paragraph of 15.3.23, printed p.1129 (1 March 2004 manuscript).
-/

@[expose] public section

open Representation
open CFSG.Quasithin.Chapter15.Section04.LocalSetup.CoreElimination.BlockSieve.ExchangedCases.SL3Geometry.SourceCases
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.LinearThree.CoreActions.ThreeLayer.ResidualAlternatives

local notation "W" => Fin 3 → ZMod 2
local notation "N" => Fin 2 → W
local notation "D" => Fin 2 → Module.Dual (ZMod 2) W

private noncomputable def pairing : N →ₗ[ZMod 2] Module.Dual (ZMod 2) D where
  toFun v :=
    { toFun f := ∑ i, f i (v i)
      map_add' f h := by simp [Finset.sum_add_distrib]
      map_smul' c f := by simp [mul_add] }
  map_add' v w := by apply LinearMap.ext; intro f; simp [Finset.sum_add_distrib]
  map_smul' c v := by apply LinearMap.ext; intro f; simp [mul_add]

private lemma pairing_injective : Function.Injective pairing := by
  intro v w h
  funext i
  apply (Module.evalEquiv (ZMod 2) W).injective
  apply LinearMap.ext
  intro f
  have he := LinearMap.congr_fun h (Pi.single i f)
  fin_cases i <;> simpa [pairing] using he

private lemma pairing_surjective : Function.Surjective pairing := by
  intro f
  let v : N := fun i => (Module.evalEquiv (ZMod 2) W).symm
    (f.comp (LinearMap.single (ZMod 2) (fun _ : Fin 2 => Module.Dual (ZMod 2) W) i))
  refine ⟨v, ?_⟩
  apply LinearMap.ext
  intro x
  have he : x = ∑ i : Fin 2, Pi.single i (x i) := by ext i; simp [Finset.sum_apply]
  have hv (i : Fin 2) : x i (v i) = f (Pi.single i (x i)) := by
    exact LinearMap.congr_fun ((Module.evalEquiv (ZMod 2) W).apply_symm_apply _) (x i)
  change (∑ i, x i (v i)) = f x
  simp_rw [hv]
  rw [← map_sum, ← he]

private noncomputable def pairingEquiv : N ≃ₗ[ZMod 2] Module.Dual (ZMod 2) D :=
  LinearEquiv.ofBijective pairing ⟨pairing_injective, pairing_surjective⟩

private theorem pairing_intertwining (g : Matrix.SpecialLinearGroup (Fin 3) (ZMod 2)) (v : N) :
    pairingEquiv (NaturalCopies (ZMod 2) 2 g v) =
      (DualCopies (ZMod 2) 2).dual g (pairingEquiv v) := by
  apply LinearMap.ext
  intro f
  change (∑ i, f i (specialLinearNatural 3 g (v i))) =
    ∑ i, f i (specialLinearNatural 3 (g⁻¹)⁻¹ (v i))
  rw [inv_inv]

private noncomputable def dualAction {K : Type*} [Group K]
    (ρ : Representation (ZMod 2) K D) : Representation (ZMod 2) K N :=
  pairingEquiv.symm.conjRingEquiv.toMonoidHom.comp ρ.dual

private theorem dualAction_apply {K : Type*} [Group K]
    (ρ : Representation (ZMod 2) K D) (k : K) (v : N) :
    pairingEquiv (dualAction ρ k v) = ρ.dual k (pairingEquiv v) := by
  exact pairingEquiv.apply_symm_apply _

private theorem dualAction_commutes {K : Type*} [Group K]
    (ρ : Representation (ZMod 2) K D)
    (hρ : ∀ k g v, ρ k (DualCopies (ZMod 2) 2 g v) =
      DualCopies (ZMod 2) 2 g (ρ k v)) (k : K)
    (g : Matrix.SpecialLinearGroup (Fin 3) (ZMod 2)) (v : N) :
    dualAction ρ k (NaturalCopies (ZMod 2) 2 g v) =
      NaturalCopies (ZMod 2) 2 g (dualAction ρ k v) := by
  apply pairingEquiv.injective
  rw [dualAction_apply, pairing_intertwining, pairing_intertwining, dualAction_apply]
  apply LinearMap.ext
  intro x
  change pairingEquiv v (DualCopies (ZMod 2) 2 g⁻¹ (ρ k⁻¹ x)) =
    pairingEquiv v (ρ k⁻¹ (DualCopies (ZMod 2) 2 g⁻¹ x))
  rw [hρ]

/-- A two-perfect action commuting with the marked doubled dual layer is
trivial or generates the whole layer by displacement. -/
theorem dual_copies_fixed_or_moving {K : Type*} [Group K]
    (ρ : Representation (ZMod 2) K D) (hK : IsPPerfect 2 K)
    (hρ : ∀ k g v, ρ k (DualCopies (ZMod 2) 2 g v) =
      DualCopies (ZMod 2) 2 g (ρ k v)) :
    (∀ k, ρ k = 1) ∨ Coinvariants.ker ρ = ⊤ := by
  by_cases hm : Coinvariants.ker ρ = ⊤
  · exact Or.inr hm
  left
  have hn : ρ.dual.invariants ≠ ⊥ := by
    rw [ρ.invariants_dual_eq_commutator_annihilator]
    exact fun h => hm (Submodule.dualAnnihilator_eq_bot_iff.mp h)
  obtain ⟨f, hf, hfn⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hn
  let v := pairingEquiv.symm f
  have hv : v ≠ 0 := by
    intro h
    apply hfn
    simpa [v] using congrArg pairingEquiv h
  have hfix (k : K) : dualAction ρ k v = v := by
    apply pairingEquiv.injective
    rw [dualAction_apply]
    simpa only [v, pairingEquiv.apply_symm_apply] using hf k
  have ht := NaturalActions.twoPerfect_copies_fixed (Or.inr rfl) (dualAction ρ) hK
    (dualAction_commutes ρ hρ) v hv hfix
  intro k
  apply LinearMap.ext
  intro x
  apply sub_eq_zero.mp
  apply (Module.forall_dual_apply_eq_zero_iff (ZMod 2) _).mp
  intro f
  have hh := LinearMap.congr_fun (ht k⁻¹) (pairingEquiv.symm f)
  have hh' := congrArg pairingEquiv hh
  rw [dualAction_apply, Module.End.one_apply, pairingEquiv.apply_symm_apply] at hh'
  have h := LinearMap.congr_fun hh' x
  change f (ρ (k⁻¹)⁻¹ x) = f x at h
  simpa only [map_sub, sub_eq_zero, inv_inv, Module.End.one_apply] using h

end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.LinearThree.CoreActions.ThreeLayer.ResidualAlternatives

end
