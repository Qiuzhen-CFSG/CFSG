module

public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.LocalData
public import CFSG.Quasithin.Chapter4.Section01.NormalizerUniqueness
public import Theory.GroupTheory.SubgroupConjugation

/-!
# The conjugate-pair normalizer contradiction

The rank-one block and `L₃(2)` eliminations construct a nontrivial two-subgroup
`Q ≤ S` and show that `L S` normalizes `W = ⟨Q,Qᵗ⟩`, where `t ∈ T − S`.
If `S` normalizes `Q`, the index-two relation makes `t` interchange its two
conjugates. Thus all of `T` normalizes `W`. Once `Y ≤ ⟨L,T⟩`, the normalizer
of `W` is a two-local overgroup of `YT`, so uniqueness forces `L ≤ M`.

The component-dependent construction of `Q` and proof of its normalization
remain explicit obligations. Only normality in the indicated overgroups is
used; no ambient normality of `Q` or `W` is required.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), final paragraphs
of 15.3.18 and 15.3.23, printed pp.1127 and 1129 (PDF pp.1144 and 1146).
-/

@[expose] public section

open Subgroup
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination
variable {G : Type*} [Group G]

/-- The subgroup generated by a two-subgroup and its conjugate by `t`. -/
abbrev conjugatePair (Q : Subgroup G) (t : G) : Subgroup G := Q ⊔ Q.conjBy t

/-- If `t²` normalizes `Q`, conjugation by `t` interchanges the two generators. -/
theorem normalizes_conjugatePair (Q : Subgroup G) (t : G)
    (ht2 : t ^ 2 ∈ normalizer (Q : Set G)) :
    t ∈ normalizer (conjugatePair Q t : Set G) := by
  apply mem_normalizer_iff_map_conj_eq.mpr
  change (Q ⊔ Q.conjBy t).map (MulAut.conj t).toMonoidHom = _
  rw [Subgroup.map_sup]
  change Q.conjBy t ⊔ (Q.conjBy t).conjBy t = Q ⊔ Q.conjBy t
  have hQ : Q.conjBy (t ^ 2) = Q := mem_normalizer_iff_map_conj_eq.mp ht2
  rw [conjBy_conjBy, ← pow_two, hQ, sup_comm]

/-- For `S` of index two in `T`, the square condition and the two-coset decomposition extend normalization from `S` to `T`. -/
theorem index_two_normalizes_conjugatePair
    (S T Q : Subgroup G) (hindex : (S.subgroupOf T).index = 2)
    (t : G) (ht : t ∈ T) (htS : t ∉ S)
    (hSQ : S ≤ normalizer (Q : Set G))
    (hSW : S ≤ normalizer (conjugatePair Q t : Set G)) :
    T ≤ normalizer (conjugatePair Q t : Set G) := by
  have ht2 : t ^ 2 ∈ S := (S.subgroupOf T).sq_mem_of_index_two hindex ⟨t, ht⟩
  have htW := normalizes_conjugatePair Q t (hSQ ht2)
  intro x hx
  by_cases hxS : x ∈ S
  · exact hSW hxS
  · have hxt : x * t⁻¹ ∈ S := by
      have hi := (S.subgroupOf T).mul_mem_iff_of_index_two hindex
        (a := (⟨x, hx⟩ : T)) (b := (⟨t, ht⟩ : T)⁻¹)
      apply hi.mpr
      change x ∈ S ↔ t⁻¹ ∈ S
      simp only [S.inv_mem_iff, hxS, htS]
    simpa only [inv_mul_cancel_right] using
      (normalizer (conjugatePair Q t : Set G)).mul_mem (hSW hxt) htW

/-- Both conjugates remain in the common two-group. -/
theorem conjugatePair_le {T Q : Subgroup G} (hQT : Q ≤ T)
    {t : G} (ht : t ∈ T) : conjugatePair Q t ≤ T := by
  refine sup_le hQT ?_
  rintro x ⟨q, hq, rfl⟩
  exact (T.le_normalizer ht q).mp (hQT hq)

/-- The conjugate pair contains its nontrivial first factor. -/
theorem conjugatePair_ne_bot {Q : Subgroup G} (hQ : Q ≠ ⊥) (t : G) :
    conjugatePair Q t ≠ ⊥ := fun h => hQ (eq_bot_iff.mpr (le_sup_left.trans h.le))

/-- The terminal argument shared by 15.3.18 and 15.3.23. The case analysis must construct `Q`, its relative normalizations, and the containment of `Y`. -/
theorem outside_conjugatePair_contradiction [Finite G]
    (d : LocalData G) {L Q : Subgroup G}
    (hL : ¬ L ≤ d.M) (hQ : Q ≠ ⊥) (hQS : Q ≤ d.S)
    (t : G) (ht : t ∈ (d.T : Subgroup G)) (htS : t ∉ d.S)
    (hindex : (d.S.subgroupOf (d.T : Subgroup G)).index = 2)
    (hSQ : d.S ≤ normalizer (Q : Set G))
    (hLS : L ⊔ d.S ≤ normalizer (conjugatePair Q t : Set G))
    (hY : d.Y ≤ L ⊔ (d.T : Subgroup G))
    (hunique : Chapter4.UniqueMaximalOvergroup (d.Y ⊔ (d.T : Subgroup G)) d.M) :
    False := by
  let W := conjugatePair Q t
  have hWT : W ≤ (d.T : Subgroup G) := conjugatePair_le (hQS.trans inf_le_left) ht
  have hTw : (d.T : Subgroup G) ≤ normalizer (W : Set G) :=
    index_two_normalizes_conjugatePair d.S (d.T : Subgroup G) Q hindex t ht htS
      hSQ (le_sup_right.trans hLS)
  have hLw : L ≤ normalizer (W : Set G) := le_sup_left.trans hLS
  have hlocal : IsTwoLocal (normalizer (W : Set G)) :=
    ⟨W, conjugatePair_ne_bot hQ t, d.T.isPGroup'.to_le hWT, rfl⟩
  obtain ⟨N, hWN, hN⟩ := Finite.exists_le_maximal hlocal
  have hYN : d.Y ⊔ (d.T : Subgroup G) ≤ N :=
    sup_le (hY.trans ((sup_le hLw hTw).trans hWN)) (hTw.trans hWN)
  have hNM := hunique.2.2 N hN hYN
  exact hL (hNM ▸ hLw.trans hWN)

end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination

end
