module
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource.BinaryThreePointFixedSpanComponentAction
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.ComponentExtraction.Inheritance
public import Theory.GroupTheory.CComponent.QuasisimpleImage

/-!
# The promoted component in the original star quotient

The original star quotient uses d.Z and its span d.UI in the Sylow join.
Its two-core vanishes. The normal containing component therefore has its
intrinsic two-core killed by the star map. The original source normalizer
control makes its star action nontrivial, proving both quasisimplicity of
the image and generation by commutators with the original Yplus.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped MatrixGroups IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource
open LinearThree LinearThree.OriginalSource CoreActions ChapterC BinaryMS.MS93
open CFSG.Quasithin.Chapter1.RadicalExclusions.ModelReduction.FullSieve.SourceInterface
variable {G : Type*} [Group G] [Finite G]

private theorem normal_component_star
    (d : LocalData G) {J B : Subgroup G} (hBJ : B ≤ J)
    (hBn : (B.subgroupOf J).Normal) (hBc : (B.subgroupOf J).IsCComponent)
    (hq : IsQuasisimple (B ⧸ pCore 2 B))
    (hBM : ¬ B ≤ d.M) (hYJ : d.Yplus ≤ J)
    (hS : Chapter1.IsSylowIn 2 d.S J)
    (hC : J ⊓ centralizer (d.UI J : Set G) ≤ d.MI J)
    (hN : normalizer (d.starImage J d.Yplus : Set (d.Star J)) = d.starImage J d.M) :
    IsQuasisimple (d.starImage J B) ∧ B = ⁅B,d.Yplus⁆ := by
  let BN := B.subgroupOf J
  let : BN.Normal := hBn
  let N := BN.pCoreIn 2
  let : N.Normal := ConjAct.normal_of_characteristic_of_normal
  let f := d.starMap J
  have hf : Function.Surjective f := QuotientGroup.mk'_surjective _
  have hZS := d.Z_le_S (d.action.le_sylow d.T d.sylow_le (localModule_le d.T d.sylow_le))
  have hzero := d.star_twoCore_eq_bot hS hZS
  have hk : N ≤ f.ker := by
    have hm : N.map f ≤ pCore 2 (d.Star J) :=
      le_sSup ⟨(inferInstance : N.Normal).map f hf,(BN.isPGroup_pCoreIn 2).map f⟩
    exact (map_eq_bot_iff N).mp (le_bot_iff.mp (hm.trans_eq hzero))
  let a : BN ≃* B := subgroupOfEquivOfLe hBJ
  let q : (BN ⧸ pCore 2 BN) ≃* (B ⧸ pCore 2 B) :=
    QuotientGroup.congr _ _ a (pCore_map_iso 2 a)
  let : IsQuasisimple (B ⧸ pCore 2 B) := hq
  have hqN : IsQuasisimple (BN ⧸ pCore 2 BN) := IsQuasisimple.of_mulEquiv q.symm
  have hmove := d.star_commutator_ne_bot hBJ hBM hC hN
  have hne : BN.map f ≠ ⊥ := by
    intro hb
    exact hmove (by change ⁅BN.map f,_⁆ = ⊥; rw [hb,commutator_bot_left])
  have hstar : IsQuasisimple (d.starImage J B) :=
    (hBc.isComponent_map_of_twoCore_killed hqN f hf hk hne).2
  have hn : d.Yplus.subgroupOf J ≤ normalizer (BN : Set J) := by
    rw [normalizer_eq_top]
    exact le_top
  have he := cComponent_eq_commutator_of_image hBc hn f hf hstar hmove
  have hm := congrArg (map J.subtype) he
  refine ⟨hstar,?_⟩
  simpa only [map_commutator,map_subgroupOf_eq_of_le hBJ,
    map_subgroupOf_eq_of_le hYJ] using hm

/-- The promoted component has a quasisimple genuine star image in its
actual Sylow join, and is generated by the original residual action. -/
theorem binary_three_source_fixed_span_component_star
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (d : LocalData G)
    (hempty : MainForward.faithfulLocalComponents d.T = ∅)
    (hM : ChapterA.Section05To06.IsOrderingMaximal d.T d.M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions d.T : Set G)) = {d.Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (d.T : Subgroup G)).ncard)
    {I : Subgroup G} (hI : I ∈ d.Hplus) (htwo : OutsideStructure.RankTwoCase d I)
    (hf : HasCharacteristicTwo I) (c : ComponentWitness d I)
    (e : (c.L ⧸ pCore 2 c.L) ≃* PSL(3,ZMod 2))
    (b : BinaryMS.Input KnownSimple.IsKnownSimple
      (c.L.subgroupOf (c.L ⊔ d.S)) (d.S.subgroupOf (c.L ⊔ d.S)))
    (t : InputSetup b)
    (hc : ¬ IsMulCommutative (BinaryMS.commutatorCore (c.L.subgroupOf (c.L ⊔ d.S))))
    (hb : 4 < t.geometry.b t.reduction.radical)
    (z : G) (hzH : z ∈ LinearThree.OriginalSource.intrinsicFour c.L)
    (hz2 : orderOf z = 2) (hLS : c.L ⊔ d.S ≤ centralizer ({z} : Set G))
    (P : Sylow 2 (centralizer ({z} : Set G)))
    (hP : (P : Subgroup _).map (centralizer ({z} : Set G)).subtype = d.S)
    (K : Subgroup (centralizer ({z} : Set G)))
    (hK : K.IsCComponent) (hKn : K.Normal)
    (hLK : c.L.subgroupOf (centralizer ({z} : Set G)) ≤ K)
    [IsSimpleGroup (K.map (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G)))))]
    (eB : (((c.L.subgroupOf (centralizer ({z} : Set G))).map
      (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G))))) ⧸
      pCore 2 ((c.L.subgroupOf (centralizer ({z} : Set G))).map
        (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G)))))) ≃* PSL(3,ZMod 2))
    (hrX : primeRank 3 (centralizer ({z} : Set G) ⧸ pCore 2 (centralizer ({z} : Set G))) = 2)
    (hrB : primeRank 3 (normalizer ((c.L.subgroupOf (centralizer ({z} : Set G))).map
      (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G)))) :
        Set ((centralizer ({z} : Set G)) ⧸ pCore 2 (centralizer ({z} : Set G))))) ≤ 1)
    (hm : ClassicalGroup.IsPSL
      (K.map (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G))))) 4 2) :
    let U := conjugateSpanBy (intrinsicFour c.L) (centralizer ({z} : Set G))
    let A := normalizer (U : Set G)
    ∃ D : Subgroup A, D.IsCComponent ∧ D.Normal ∧ c.L.subgroupOf A ≤ D ∧
      Function.Surjective (U.normalizerMonoidHom.comp D.subtype) ∧
      (U.normalizerMonoidHom.comp D.subtype).ker = pCore 2 D ∧
      let B := D.map A.subtype
      let J := B ⊔ d.S
      Nonempty ((B ⧸ pCore 2 B) ≃* PSL(5,ZMod 2)) ∧
      B = theta A ∧ d.Yplus ≤ B ∧ HasCharacteristicTwo J ∧
      J ∈ d.Hplus ∧ Chapter1.IsSylowIn 2 d.S J ∧
      ¬ B ≤ d.M ∧ 2 ≤ primeRank 3 B ∧
      IsQuasisimple (B ⧸ pCore 2 B) ∧
      IsQuasisimple (d.starImage J B) ∧ B = ⁅B,d.Yplus⁆ := by
  let U := conjugateSpanBy (intrinsicFour c.L) (centralizer ({z} : Set G))
  let A := normalizer (U : Set G)
  obtain ⟨D,hD,hDn,hLD,hfull,hker,⟨eD⟩,hθ,hY,hchar⟩ :=
    binary_three_source_fixed_span_component_theta
      hG d hempty hM hu hmany hI htwo hf c e b t hc hb z hzH hz2 hLS P hP
        K hK hKn hLK eB hrX hrB hm
  let B := D.map A.subtype
  let J := B ⊔ d.S
  have hout := binary_three_source_fixed_span_outside
    hG d hempty hM hu hmany hI htwo hf c e b t hc hb z hzH hz2 hLS P hP
      K hK hKn hLK eB hrX hrB hm
  have hLA : c.L ≤ A := le_sup_left.trans hout.2.1
  have hSA : d.S ≤ A := le_sup_right.trans hout.2.1
  have hBA : B ≤ A := map_subtype_le D
  have hJA : J ≤ A := sup_le hBA hSA
  have hBJ : B ≤ J := le_sup_left
  have hLB : c.L ≤ B := by
    intro x hx
    exact ⟨⟨x,hLA hx⟩,hLD hx,rfl⟩
  have hBM : ¬ B ≤ d.M := fun hh => c.outside (hLB.trans hh)
  have hJ : J ∈ d.Hplus := d.mem_Hplus_of_intermediate hout.2.2.1
    hout.2.2.2.1 hJA (sup_le (hY.trans hBJ) le_sup_right)
      (fun hh => hBM (hBJ.trans hh))
  have hSJ : Chapter1.IsSylowIn 2 d.S J := hout.2.2.2.1.restrict le_sup_right hJA
  have hBAeq : B.subgroupOf A = D := by
    change (D.map A.subtype).comap A.subtype = D
    exact comap_map_eq_self_of_injective A.subtype_injective D
  have hBcA : (B.subgroupOf A).IsCComponent := hBAeq.symm ▸ hD
  have hBnA : (B.subgroupOf A).Normal := hBAeq.symm ▸ hDn
  have hBcJ : (B.subgroupOf J).IsCComponent := hBcA.subgroupOf_of_le hBJ hJA
  have hBnJ : (B.subgroupOf J).Normal :=
    (normal_subgroupOf_iff_le_normalizer hBJ).mpr
      (hJA.trans ((normal_subgroupOf_iff_le_normalizer hBA).mp hBnA))
  let a : D ≃* B := D.equivMapOfInjective A.subtype A.subtype_injective
  let eG : (B ⧸ pCore 2 B) ≃* PSL(5,ZMod 2) :=
    (QuotientGroup.congr _ _ a (pCore_map_iso 2 a)).symm.trans eD
  let : IsQuasisimple PSL(5,ZMod 2) := Theory.SpecificGroups.PSL5Two.UniversalCover.isQuasisimple _
  have hqG : IsQuasisimple (B ⧸ pCore 2 B) := IsQuasisimple.of_mulEquiv eG.symm
  have hr : 2 ≤ primeRank 3 B := by
    have hq : 2 ≤ primeRank 3 (B ⧸ pCore 2 B) := by
      rw [primeRank_congr 3 (eG.trans (BinaryLinear.OuterCyclic.projectiveEquivSL (by decide)))]
      exact BinaryLinear.SmallCubicRank.five
    exact hq.trans (primeRank_quotient_le_of_isTwoGroup 3 (by decide) _ pCore_isPGroup)
  have h11 := OutsideStructure.source_lemma_15_3_11_from_selection
    hG d hempty hM hu hmany J hJ
  have hstar := normal_component_star d hBJ hBnJ hBcJ hqG hBM
    (hY.trans hBJ) hSJ h11.centralizer_le h11.action_normalizer.1
  exact ⟨D,hD,hDn,hLD,hfull,hker,⟨eG⟩,hθ,hY,hchar,hJ,hSJ,hBM,hr,hqG,hstar⟩

end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource
