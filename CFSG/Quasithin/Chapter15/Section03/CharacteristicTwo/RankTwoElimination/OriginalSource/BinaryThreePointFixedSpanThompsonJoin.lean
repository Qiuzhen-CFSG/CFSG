module
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource.BinaryThreePointFixedSpanThompson
public import Theory.GroupTheory.ElementaryThompsonComponentSylowJoin

/-!
# Thompson placement in the actual containing-component join

The normal containing component is generated by its commutators with the
same Sylow Thompson subgroup. Transporting that generation into its own
join with S gives the literal Thompson placement and relative C-component
needed for a new original-source witness.
-/
public noncomputable section
open Subgroup Theory.GroupTheory
open scoped MatrixGroups IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource
open LinearThree LinearThree.OriginalSource CoreActions ChapterC BinaryMS.MS93
open CFSG.Quasithin.Chapter1.RadicalExclusions.ModelReduction.FullSieve.SourceInterface
variable {G : Type*} [Group G] [Finite G]

/-- Every normal containing component lies in the Thompson subgroup of its
own join with the original S, with the literal relative component property. -/
theorem binary_three_source_fixed_span_thompson_join
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (d : LocalData G)
    (hempty : MainForward.faithfulLocalComponents d.T = ∅)
    (hM : ChapterA.Section05To06.IsOrderingMaximal d.T d.M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions d.T : Set G)) = {d.Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (d.T : Subgroup G)).ncard)
    {I : Subgroup G} (hI : I ∈ d.Hplus) (htwo : OutsideStructure.RankTwoCase d I)
    (hf : HasCharacteristicTwo I) (c : ComponentWitness d I)
    (e : (c.L ⧸ pCore 2 c.L) ≃* PSL(3,ZMod 2))
    (b : BinaryMS.Input KnownSimple.IsKnownSimple
      (c.L.subgroupOf (c.L ⊔ d.S)) (d.S.subgroupOf (c.L ⊔ d.S)))
    (t : InputSetup b)
    (hc : ¬ IsMulCommutative (BinaryMS.commutatorCore (c.L.subgroupOf (c.L ⊔ d.S))))
    (hb : 4 < t.geometry.b t.reduction.radical)
    (z : G) (hzH : z ∈ LinearThree.OriginalSource.intrinsicFour c.L)
    (hz2 : orderOf z = 2) (hLS : c.L ⊔ d.S ≤ centralizer ({z} : Set G))
    (P : Sylow 2 (centralizer ({z} : Set G)))
    (hP : (P : Subgroup _).map (centralizer ({z} : Set G)).subtype = d.S)
    (K : Subgroup (centralizer ({z} : Set G)))
    (hK : K.IsCComponent) (hKn : K.Normal)
    (hLK : c.L.subgroupOf (centralizer ({z} : Set G)) ≤ K)
    [IsSimpleGroup (K.map (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G)))))]
    (eB : (((c.L.subgroupOf (centralizer ({z} : Set G))).map
      (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G))))) ⧸
      pCore 2 ((c.L.subgroupOf (centralizer ({z} : Set G))).map
        (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G)))))) ≃* PSL(3,ZMod 2))
    (hrX : primeRank 3 (centralizer ({z} : Set G) ⧸ pCore 2 (centralizer ({z} : Set G))) = 2)
    (hrB : primeRank 3 (normalizer ((c.L.subgroupOf (centralizer ({z} : Set G))).map
      (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G)))) :
        Set ((centralizer ({z} : Set G)) ⧸ pCore 2 (centralizer ({z} : Set G))))) ≤ 1)
    (hm : ClassicalGroup.IsPSL
      (K.map (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G))))) 4 2) :
    let U := conjugateSpanBy (intrinsicFour c.L) (centralizer ({z} : Set G))
    let NU := normalizer (U : Set G)
    ∀ D : Subgroup NU, D.IsCComponent → D.Normal → c.L.subgroupOf NU ≤ D →
      let B := D.map NU.subtype
      B ≤ Stellmacher.elementaryAbelianMaxJ (B ⊔ d.S) ∧
        (B.subgroupOf (Stellmacher.elementaryAbelianMaxJ (B ⊔ d.S))).IsCComponent := by
  let U := conjugateSpanBy (intrinsicFour c.L) (centralizer ({z} : Set G))
  let NU := normalizer (U : Set G)
  have hTh := (binary_three_source_fixed_span_thompson
    hG d hempty hM hu hmany hI htwo hf c e b t hc hb z hzH hz2 hLS P hP
      K hK hKn hLK eB hrX hrB hm).2
  obtain ⟨S,hS⟩ := (binary_three_source_fixed_span_outside
    hG d hempty hM hu hmany hI htwo hf c e b t hc hb z hzH hz2 hLS P hP
      K hK hKn hLK eB hrX hrB hm).2.2.2.1
  change ∀ D : Subgroup NU, D.IsCComponent → D.Normal → c.L.subgroupOf NU ≤ D →
    D.map NU.subtype ≤ Stellmacher.elementaryAbelianMaxJ (D.map NU.subtype ⊔ d.S) ∧
      ((D.map NU.subtype).subgroupOf
        (Stellmacher.elementaryAbelianMaxJ (D.map NU.subtype ⊔ d.S))).IsCComponent
  intro D hD hDn hLD
  let _ := hDn
  let B := D.map NU.subtype
  let V := D ⊔ (S : Subgroup NU)
  let J := Stellmacher.elementaryAbelianMaxJ (B ⊔ d.S)
  have hDJ : D ≤ Stellmacher.elementaryAbelianMaxJ (⊤ : Subgroup NU) := by
    rw [←LocalData.thompson_subgroupOf]
    intro x hx
    exact (hTh D hD hLD).1 (mem_map_of_mem NU.subtype hx)
  have hDV : D ≤ Stellmacher.elementaryAbelianMaxJ V :=
    Stellmacher.normal_cComponent_le_maxJ_sup_sylow S hD hDJ
  have hVmap : V.map NU.subtype = B ⊔ d.S := by
    rw [show V = D ⊔ (S : Subgroup NU) from rfl, Subgroup.map_sup,hS]
  have hBJ : B ≤ J := by
    have hh := map_mono (f := NU.subtype) hDV
    rwa [←Stellmacher.elementaryAbelianMaxJ_map_injective
      NU.subtype NU.subtype_injective,hVmap] at hh
  refine ⟨hBJ,?_⟩
  have hJoinNU : B ⊔ d.S ≤ NU := by
    rw [←hVmap]
    simpa only [range_subtype] using map_le_range (f := NU.subtype) V
  have hJNU : J ≤ NU := (sSup_le fun A hA => hA.1).trans hJoinNU
  let JN := J.subgroupOf NU
  have hDJN : D ≤ JN := fun x hx => hBJ (mem_map_of_mem NU.subtype hx)
  let f : JN ≃* J := subgroupOfEquivOfLe hJNU
  have he : (D.subgroupOf JN).map f.toMonoidHom = B.subgroupOf J := by
    ext x
    constructor
    · rintro ⟨y,hy,rfl⟩
      exact ⟨y.val,hy,rfl⟩
    · rintro ⟨y,hy,he⟩
      exact ⟨⟨y,hDJN hy⟩,hy,Subtype.ext he⟩
  rw [←he]
  exact (hD.subgroupOf hDJN).map_equiv f

end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource
