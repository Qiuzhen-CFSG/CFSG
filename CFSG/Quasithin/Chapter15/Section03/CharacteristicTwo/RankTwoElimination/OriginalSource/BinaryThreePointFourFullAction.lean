/-!
# Full component action in the original binary-four point quotient

The actual Sylow acts innerly on K. Its outer automorphism group is a
two-group, so the two-residual and Sylow together show that the full point
quotient is K times its actual centralizer. The latter's preimage fixes
the original span, which is therefore generated already over the literal
preimage of K. No faithfulness of the whole point quotient is assumed.
-/
public noncomputable section
open Subgroup Theory.GroupTheory
open scoped MatrixGroups Pointwise
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource
open LinearThree LinearThree.OriginalSource CoreActions ChapterC BinaryMS.MS93
open BinaryLinear.OuterCyclic
private theorem full_inner_of_sylow_inner {X : Type*} [Group X] [Finite X] (K : Subgroup X) [K.Normal]
    (houter : IsPGroup 2 (MulAut.Outer K)) (S : Sylow 2 X)
    (hS : (S : Subgroup X) ≤ K ⊔ centralizer (K : Set X)) :
    K ⊔ centralizer (K : Set X) = ⊤ := by
  let a : X →* MulAut.Outer K :=
    (QuotientGroup.mk' (MulAut.innerSubgroup K)).comp MulAut.conjNormal
  have hk : a.ker=K ⊔ centralizer (K : Set X) := by
    change ((QuotientGroup.mk' (MulAut.innerSubgroup K)).comp
      (MulAut.conjNormal : X →* MulAut K)).ker=_
    rw [←MonoidHom.comap_ker,QuotientGroup.ker_mk',MulAut.conjNormal_comap_innerSubgroup]
  have hr := pResidual_le_ker_of_isPGroup 2 a houter
  rw [hk] at hr
  apply top_unique
  rw [←pResidual_sup_sylow_eq_top S]
  exact sup_le hr hS

variable {G : Type*} [Group G] [Finite G]

/-- The full actual point quotient is generated by its binary-four
component and the component's full centralizer. -/
theorem binary_three_point_four_component_centralizer_product
    (d : LocalData G) (L : Subgroup G)
    (b : BinaryMS.Input KnownSimple.IsKnownSimple
      (L.subgroupOf (L ⊔ d.S)) (d.S.subgroupOf (L ⊔ d.S)))
    (z : G) (hLS : L ⊔ d.S ≤ centralizer ({z} : Set G))
    (P : Sylow 2 (centralizer ({z} : Set G)))
    (hP : (P : Subgroup _).map (centralizer ({z} : Set G)).subtype = d.S)
    (K : Subgroup (centralizer ({z} : Set G) ⧸ pCore 2 (centralizer ({z} : Set G))))
    [K.Normal]
    (hBK : (L.subgroupOf (centralizer ({z} : Set G))).map
      (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G)))) ≤ K)
    (hm : ClassicalGroup.IsPSL K 4 2) :
    K ⊔ centralizer (K : Set (centralizer ({z} : Set G) ⧸ pCore 2 (centralizer ({z} : Set G)))) = ⊤ := by
  let C := centralizer ({z} : Set G)
  let q := QuotientGroup.mk' (pCore 2 C)
  let S := P.mapSurjective (QuotientGroup.mk'_surjective (pCore 2 C))
  obtain ⟨_,_,_,a,_,_,_⟩ := binary_three_point_four_endpoint_equality d L b z hLS P hP K hBK hm
  have hout : IsPGroup 2 (MulAut.Outer K) :=
    (linear_outer_isTwoGroup (Or.inl rfl : 4=4 ∨ 4=5)).of_equiv (MulAut.outerCongr a).symm
  have hS := (binary_three_point_four_sylow_action d L b z hLS P hP K hBK hm).1
  exact full_inner_of_sylow_inner K hout S (hS.trans (sup_le_sup hBK le_rfl))

/-- The original natural-eight span is generated by the literal
preimage of K; the full component-centralizer kernel is retained. -/
theorem binary_three_source_four_component_span
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (d : LocalData G)
    (hempty : MainForward.faithfulLocalComponents d.T = ∅)
    (hM : ChapterA.Section05To06.IsOrderingMaximal d.T d.M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions d.T : Set G)) = {d.Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (d.T : Subgroup G)).ncard)
    {I : Subgroup G} (hI : I ∈ d.Hplus) (htwo : OutsideStructure.RankTwoCase d I)
    (hf : HasCharacteristicTwo I) (c : ComponentWitness d I)
    (e : (c.L ⧸ pCore 2 c.L) ≃* PSL(3,ZMod 2))
    (b : BinaryMS.Input KnownSimple.IsKnownSimple
      (c.L.subgroupOf (c.L ⊔ d.S)) (d.S.subgroupOf (c.L ⊔ d.S)))
    (t : InputSetup b)
    (hc : ¬ IsMulCommutative (BinaryMS.commutatorCore (c.L.subgroupOf (c.L ⊔ d.S))))
    (hb : 4 < t.geometry.b t.reduction.radical)
    (z : G) (hLS : c.L ⊔ d.S ≤ centralizer ({z} : Set G))
    (P : Sylow 2 (centralizer ({z} : Set G)))
    (hP : (P : Subgroup _).map (centralizer ({z} : Set G)).subtype = d.S)
    (K : Subgroup ((centralizer ({z} : Set G)) ⧸ pCore 2 (centralizer ({z} : Set G))))
    [K.Normal]
    (hBK : (c.L.subgroupOf (centralizer ({z} : Set G))).map
      (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G)))) ≤ K)
    (hm : ClassicalGroup.IsPSL K 4 2) :
    let C := centralizer ({z} : Set G)
    let q := QuotientGroup.mk' (pCore 2 C)
    let V := ⁅coreCenter c.L,c.L⁆
    let A := (K.comap q).map C.subtype
    conjugateSpanBy V C = conjugateSpanBy V A := by
  let C := centralizer ({z} : Set G)
  let q := QuotientGroup.mk' (pCore 2 C)
  let V := ⁅coreCenter c.L,c.L⁆
  let Z := centralizer (K : Set (C ⧸ pCore 2 C))
  let A := (K.comap q).map C.subtype
  let D := (Z.comap q).map C.subtype
  have hsplit := binary_three_point_four_component_centralizer_product d c.L b z hLS P hP K hBK hm
  have hgen : A ⊔ D=C := by
    change (K.comap q).map C.subtype ⊔ (Z.comap q).map C.subtype=C
    rw [←Subgroup.map_sup,comap_sup_eq q K Z (QuotientGroup.mk'_surjective _),
      hsplit,comap_top,←MonoidHom.range_eq_map,range_subtype]
  have hDfix := binary_three_source_component_centralizer_fixes_span
    hG d hempty hM hu hmany hI htwo hf c e b t hc hb z hLS P hP K hBK
  have hDV : D ≤ normalizer (V : Set G) :=
    (hDfix.trans (Subgroup.centralizer_le (le_conjugateSpanBy V C))).trans
      (Subgroup.centralizer_le_normalizer _)
  have hCA : C ≤ normalizer (A : Set G) := by
    have hh := (K.comap q).le_normalizer_map C.subtype
    rw [normalizer_eq_top,←MonoidHom.range_eq_map,range_subtype] at hh
    exact hh
  have hDA : D ≤ normalizer (A : Set G) := (map_subtype_le _).trans hCA
  change conjugateSpanBy V C=conjugateSpanBy V A
  rw [←hgen]
  exact conjugateSpanBy_sup_of_normalizes_seed V A D hDV hDA

end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource
