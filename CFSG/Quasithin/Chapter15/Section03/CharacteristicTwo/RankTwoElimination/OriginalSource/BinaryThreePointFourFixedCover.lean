/-!
# The actual fifteen-coset cover of the original fixed-four section

The preimage of the component centralizer preserves the original L and H.
It can therefore be removed from the conjugate span of H. The actual H/Z
line is fixed by B and its K-orbit spans U/Z. This gives a surjective map
from the literal fifteen-coset permutation module, with the original point,
section kernel and quotient representative equation retained throughout.

Source context: Aschbacher--Smith 15.3.23, original binary-four carrier.
-/
public noncomputable section
open Subgroup Theory.GroupTheory Representation
open scoped MatrixGroups IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource
open LinearThree LinearThree.OriginalSource CoreActions ChapterC BinaryMS.MS93
open BinaryLinear.OuterCyclic BinaryLinear.InvariantNodeActions
variable {G : Type*} [Group G] [Finite G]

private theorem preimage_centralizer_normalizes_original
    (d : LocalData G) (L : Subgroup G)
    (b : BinaryMS.Input KnownSimple.IsKnownSimple
      (L.subgroupOf (L ⊔ d.S)) (d.S.subgroupOf (L ⊔ d.S)))
    (z : G) (hLS : L ⊔ d.S ≤ centralizer ({z} : Set G))
    (P : Sylow 2 (centralizer ({z} : Set G)))
    (hP : (P : Subgroup _).map (centralizer ({z} : Set G)).subtype = d.S)
    (K : Subgroup (centralizer ({z} : Set G) ⧸ pCore 2 (centralizer ({z} : Set G))))
    [K.Normal]
    (hBK : (L.subgroupOf (centralizer ({z} : Set G))).map
      (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G)))) ≤ K) :
    let C := centralizer ({z} : Set G)
    let q := QuotientGroup.mk' (pCore 2 C)
    ((centralizer (K : Set (C ⧸ pCore 2 C))).comap q).map C.subtype ≤ normalizer L := by
  let C := centralizer ({z} : Set G)
  let N := C.pCoreIn 2
  let q := QuotientGroup.mk' (pCore 2 C)
  let J := L ⊔ d.S
  let LC := L.subgroupOf C
  have hLC : L ≤ C := le_sup_left.trans hLS
  have hJL : J ≤ normalizer L :=
    (normal_subgroupOf_iff_le_normalizer (show L ≤ J from le_sup_left)).mp b.component_normal
  have hNS : N ≤ d.S := hP ▸ pCoreIn_le_sylow C P
  have hqn : q.ker ≤ normalizer LC := by
    rw [QuotientGroup.ker_mk',←subgroupOf_normalizer_eq hLC]
    intro x hx
    exact (hNS.trans (le_sup_right.trans hJL)) (mem_map_of_mem C.subtype hx)
  have hq : IsPGroup 2 q.ker := by rw [QuotientGroup.ker_mk']; exact pCore_isPGroup
  let : Group.IsPerfect (L.subgroupOf J) := b.component.perfect
  let ec : (L.subgroupOf J) ≃* LC :=
    (subgroupOfEquivOfLe (show L ≤ J from le_sup_left)).trans
      (subgroupOfEquivOfLe hLC).symm
  let : Group.IsPerfect LC := Group.IsPerfect.ofSurjective (f := ec.toMonoidHom) ec.surjective
  have hp : IsPPerfect 2 LC := by
    intro M hM htwoM
    let := hM
    have hs : Subsingleton (LC ⧸ M) := by
      by_contra! hn
      exact Group.IsPerfect.not_isNilpotent (LC ⧸ M) htwoM.isNilpotent
    apply eq_top_iff.mpr
    intro x _
    exact (QuotientGroup.eq_one_iff x).mp (Subsingleton.elim _ _)
  have hpre := comap_normalizer_map_of_pPerfect q LC hp hq hqn
  have hT : (centralizer (K : Set (C ⧸ pCore 2 C))).comap q ≤
      (normalizer L).subgroupOf C := by
    rw [subgroupOf_normalizer_eq hLC,←hpre]
    exact comap_mono ((centralizer_le hBK).trans (Subgroup.centralizer_le_normalizer _))
  change ((centralizer (K : Set (C ⧸ pCore 2 C))).comap q).map C.subtype ≤ normalizer L
  rintro _ ⟨x,hx,rfl⟩
  exact hT hx

/-- The original intrinsic-four span is already generated by the actual
preimage of K; no point-kernel self-centralization is used. -/
theorem binary_three_point_four_fixed_component_span
    (d : LocalData G) (L : Subgroup G)
    (b : BinaryMS.Input KnownSimple.IsKnownSimple
      (L.subgroupOf (L ⊔ d.S)) (d.S.subgroupOf (L ⊔ d.S)))
    (z : G) (hLS : L ⊔ d.S ≤ centralizer ({z} : Set G))
    (P : Sylow 2 (centralizer ({z} : Set G)))
    (hP : (P : Subgroup _).map (centralizer ({z} : Set G)).subtype = d.S)
    (K : Subgroup (centralizer ({z} : Set G) ⧸ pCore 2 (centralizer ({z} : Set G))))
    [K.Normal]
    (hBK : (L.subgroupOf (centralizer ({z} : Set G))).map
      (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G)))) ≤ K)
    (hm : ClassicalGroup.IsPSL K 4 2) :
    let C := centralizer ({z} : Set G)
    let q := QuotientGroup.mk' (pCore 2 C)
    let H := intrinsicFour L
    conjugateSpanBy H C = conjugateSpanBy H ((K.comap q).map C.subtype) := by
  let C := centralizer ({z} : Set G)
  let q := QuotientGroup.mk' (pCore 2 C)
  let H := intrinsicFour L
  let A := (K.comap q).map C.subtype
  let D := ((centralizer (K : Set (C ⧸ pCore 2 C))).comap q).map C.subtype
  have hsplit := binary_three_point_four_component_centralizer_product d L b z hLS P hP K hBK hm
  have hgen : A ⊔ D = C := by
    change (K.comap q).map C.subtype ⊔
      ((centralizer (K : Set (C ⧸ pCore 2 C))).comap q).map C.subtype = C
    rw [←Subgroup.map_sup,comap_sup_eq q _ _ (QuotientGroup.mk'_surjective _),
      hsplit,comap_top,←MonoidHom.range_eq_map,range_subtype]
  have hDH : D ≤ normalizer H :=
    (preimage_centralizer_normalizes_original d L b z hLS P hP K hBK).trans
      (intrinsicFour_normalized L)
  have hCA : C ≤ normalizer A := by
    have hh := (K.comap q).le_normalizer_map C.subtype
    rw [normalizer_eq_top,←MonoidHom.range_eq_map,range_subtype] at hh
    exact hh
  change conjugateSpanBy H C = conjugateSpanBy H A
  rw [←hgen]
  exact conjugateSpanBy_sup_of_normalizes_seed H A D hDH ((map_subtype_le _).trans hCA)

/-- The cosets used by the original fixed-line cover have exactly fifteen points. -/
theorem binary_three_point_four_endpoint_index
    (d : LocalData G) (L : Subgroup G)
    (b : BinaryMS.Input KnownSimple.IsKnownSimple
      (L.subgroupOf (L ⊔ d.S)) (d.S.subgroupOf (L ⊔ d.S)))
    (z : G) (hLS : L ⊔ d.S ≤ centralizer ({z} : Set G))
    (P : Sylow 2 (centralizer ({z} : Set G)))
    (hP : (P : Subgroup _).map (centralizer ({z} : Set G)).subtype = d.S)
    (K : Subgroup (centralizer ({z} : Set G) ⧸ pCore 2 (centralizer ({z} : Set G))))
    [K.Normal]
    (hBK : (L.subgroupOf (centralizer ({z} : Set G))).map
      (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G)))) ≤ K)
    (hm : ClassicalGroup.IsPSL K 4 2) :
    (((L.subgroupOf (centralizer ({z} : Set G))).map
      (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G))))).subgroupOf K).index = 15 := by
  obtain ⟨_,_,_,a,v,_,hflag⟩ := binary_three_point_four_endpoint_equality d L b z hLS P hP K hBK hm
  rw [←index_map_of_bijective (f := a.toMonoidHom) a.bijective]
  rcases hflag with hflag | hflag
  · rw [hflag]
    simpa only [cutStabilizer,iInf_singleton] using
      (FifteenPointSubgroups.LinearFour.endpoint_parabolic_action (cutSpace v 0)
        (Or.inl (cutSpace_finrank v 0))).1
  · rw [hflag]
    simpa only [cutStabilizer,iInf_singleton] using
      (FifteenPointSubgroups.LinearFour.endpoint_parabolic_action (cutSpace v 2)
        (Or.inr (cutSpace_finrank v 2))).1

omit [Finite G] in
private theorem index_two_seed (H U Z : Subgroup G) (hHU : H ≤ U)
    [hZ : (Z.subgroupOf U).Normal] (hi : Z.relIndex H = 2) :
    ∃ h : H,
      QuotientGroup.mk' (Z.subgroupOf U) (inclusion hHU h) ≠ 1 ∧
      ∀ a : H, QuotientGroup.mk' (Z.subgroupOf U) (inclusion hHU a) = 1 ∨
        QuotientGroup.mk' (Z.subgroupOf U) (inclusion hHU a) =
          QuotientGroup.mk' (Z.subgroupOf U) (inclusion hHU h) := by
  let f := (QuotientGroup.mk' (Z.subgroupOf U)).comp (inclusion hHU)
  have hk : f.ker = Z.subgroupOf H := by
    ext h
    exact QuotientGroup.eq_one_iff (inclusion hHU h)
  have hc : Nat.card f.range = 2 := by rw [←index_ker,hk]; exact hi
  obtain ⟨w,hw,hu⟩ := (Nat.card_eq_two_iff' (1 : f.range)).mp hc
  obtain ⟨h,hh⟩ := w.property
  refine ⟨h,?_,?_⟩
  · intro he
    apply hw
    apply Subtype.ext
    exact hh.symm.trans he
  · intro a
    by_cases ha : f a = 1
    · exact Or.inl ha
    · have he : (⟨f a,⟨a,rfl⟩⟩ : f.range) = w :=
        hu _ (fun he => ha (congrArg Subtype.val he))
      exact Or.inr ((congrArg Subtype.val he).trans hh.symm)

omit [Finite G] in
private theorem fixed_section_orbit_span
    {X : Type*} [Group X] (C H U Z : Subgroup G)
    [hZ : (Z.subgroupOf U).Normal] [IsElementaryAbelian 2 (U ⧸ Z.subgroupOf U)]
    (q : C →* X) (K : Subgroup X) (hHU : H ≤ U)
    (hspan : U = conjugateSpanBy H ((K.comap q).map C.subtype))
    (ρ : X →* MulAut (U ⧸ Z.subgroupOf U))
    (hρ : ∀ (x : C) (u v : U), (v : G) = x*(u : G)*(x : G)⁻¹ →
      ρ (q x) (QuotientGroup.mk' (Z.subgroupOf U) u) =
        QuotientGroup.mk' (Z.subgroupOf U) v)
    (w : U ⧸ Z.subgroupOf U)
    (hseed : ∀ h : H, QuotientGroup.mk' (Z.subgroupOf U) (inclusion hHU h) = 1 ∨
      QuotientGroup.mk' (Z.subgroupOf U) (inclusion hHU h) = w) :
    Submodule.span (ZMod 2)
      (Set.range (fun k : K => elementaryRepresentation (p := 2) ρ k.val (Additive.ofMul w))) = ⊤ := by
  let π := QuotientGroup.mk' (Z.subgroupOf U)
  let S := Submodule.span (ZMod 2)
    (Set.range (fun k : K => elementaryRepresentation (p := 2) ρ k.val (Additive.ofMul w)))
  let D : Subgroup (U ⧸ Z.subgroupOf U) := S.toAddSubgroup.toSubgroup'
  have hUP : U ≤ (D.comap π).map U.subtype := by
    conv_lhs => rw [hspan]
    apply (closure_le _).mpr
    rintro _ ⟨x,hx,h,hh,rfl⟩
    obtain ⟨x,hx,rfl⟩ := hx
    have hxu : (x:G)*h*(x:G)⁻¹ ∈ U := by
      rw [hspan]
      exact subset_closure ⟨x,mem_map_of_mem C.subtype hx,h,hh,rfl⟩
    refine ⟨⟨(x:G)*h*(x:G)⁻¹,hxu⟩,?_,rfl⟩
    change Additive.ofMul (π ⟨(x:G)*h*(x:G)⁻¹,hxu⟩) ∈ S
    rw [←hρ x (inclusion hHU ⟨h,hh⟩) _ rfl]
    rcases hseed ⟨h,hh⟩ with hz | hw
    · rw [hz,map_one]
      exact S.zero_mem
    · rw [hw]
      exact Submodule.subset_span ⟨⟨q x,hx⟩,rfl⟩
  apply top_unique
  intro x _
  obtain ⟨u,hu⟩ := QuotientGroup.mk'_surjective (Z.subgroupOf U) x.toMul
  obtain ⟨y,hy,he⟩ := hUP u.property
  have hyu : y = u := Subtype.ext he
  subst y
  change Additive.ofMul (π u) ∈ S at hy
  change π u = x.toMul at hu
  rw [hu] at hy
  exact hy

/-- The literal original U/Z is an equivariant quotient of the fifteen
cosets of the actual B inside K, generated by the original nonzero H/Z line. -/
theorem binary_three_source_four_fixed_cover
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (d : LocalData G)
    (hempty : MainForward.faithfulLocalComponents d.T = ∅)
    (hM : ChapterA.Section05To06.IsOrderingMaximal d.T d.M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions d.T : Set G)) = {d.Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (d.T : Subgroup G)).ncard)
    {I : Subgroup G} (hI : I ∈ d.Hplus) (htwo : OutsideStructure.RankTwoCase d I)
    (hf : HasCharacteristicTwo I) (c : ComponentWitness d I)
    (e : (c.L ⧸ pCore 2 c.L) ≃* PSL(3,ZMod 2))
    (b : BinaryMS.Input KnownSimple.IsKnownSimple
      (c.L.subgroupOf (c.L ⊔ d.S)) (d.S.subgroupOf (c.L ⊔ d.S)))
    (t : InputSetup b)
    (hc : ¬ IsMulCommutative (BinaryMS.commutatorCore (c.L.subgroupOf (c.L ⊔ d.S))))
    (hb : 4 < t.geometry.b t.reduction.radical)
    (z : G) (hzH : z ∈ LinearThree.OriginalSource.intrinsicFour c.L)
    (hz2 : orderOf z = 2) (hLS : c.L ⊔ d.S ≤ centralizer ({z} : Set G))
    (P : Sylow 2 (centralizer ({z} : Set G)))
    (hP : (P : Subgroup _).map (centralizer ({z} : Set G)).subtype = d.S)
    (K : Subgroup ((centralizer ({z} : Set G)) ⧸ pCore 2 (centralizer ({z} : Set G))))
    [K.Normal]
    (hBK : (c.L.subgroupOf (centralizer ({z} : Set G))).map
      (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G)))) ≤ K)
    (hm : ClassicalGroup.IsPSL K 4 2) :
    let C := centralizer ({z} : Set G)
    let N := C.pCoreIn 2
    let q := QuotientGroup.mk' (pCore 2 C)
    let B := (c.L.subgroupOf C).map q
    let H := intrinsicFour c.L
    let Z := zpowers z
    let U := conjugateSpanBy H C
    Z ≤ H ∧ Z.relIndex H = 2 ∧ H ≤ U ∧ U ≤ N ∧
      C ≤ normalizer U ∧ ⁅U,N⁆ ≤ Z ∧ (B.subgroupOf K).index = 15 ∧
      ∃ hZ : (Z.subgroupOf U).Normal,
        let := hZ
        ∃ hel : IsElementaryAbelian 2 (U ⧸ Z.subgroupOf U),
          let := hel
          ∃ ρ : (C ⧸ pCore 2 C) →* MulAut (U ⧸ Z.subgroupOf U),
            (∀ (x : C) (u v : U), (v : G) = x*(u : G)*(x : G)⁻¹ →
              ρ (q x) (QuotientGroup.mk' (Z.subgroupOf U) u) =
                QuotientGroup.mk' (Z.subgroupOf U) v) ∧
            ∃ h : H,
              let w := Additive.ofMul (QuotientGroup.mk' (Z.subgroupOf U)
                (inclusion (le_conjugateSpanBy H C) h))
              let τ := elementaryRepresentation (p := 2) (ρ.comp K.subtype)
              w ≠ 0 ∧
              (∀ a : H, QuotientGroup.mk' (Z.subgroupOf U)
                (inclusion (le_conjugateSpanBy H C) a) = 1 ∨
                QuotientGroup.mk' (Z.subgroupOf U)
                  (inclusion (le_conjugateSpanBy H C) a) = w.toMul) ∧
              (∀ b : B.subgroupOf K, τ b.val w = w) ∧
              Submodule.span (ZMod 2) (Set.range (fun k : K => τ k w)) = ⊤ ∧
              ∃ f : ((K ⧸ B.subgroupOf K) →₀ ZMod 2) →ₗ[ZMod 2]
                  Additive (U ⧸ Z.subgroupOf U),
                Function.Surjective f ∧
                (∀ k : K, f (Finsupp.single (QuotientGroup.mk k) 1) = τ k w) ∧
                (∀ (k : K) v, f (Finsupp.lmapDomain (ZMod 2) (ZMod 2)
                  (fun a : K ⧸ B.subgroupOf K => k • a) v) = τ k (f v)) := by
  let C := centralizer ({z} : Set G)
  let q := QuotientGroup.mk' (pCore 2 C)
  let B := (c.L.subgroupOf C).map q
  let H := intrinsicFour c.L
  let Z := zpowers z
  let U := conjugateSpanBy H C
  obtain ⟨hZH,hi,hHU,hUN,hCU,hcomm,hZ,hel,ρ,hρ⟩ := binary_three_source_binary_fixed_span
    hG d hempty hM hu hmany hI htwo hf c e b t hc hb z hzH hz2 hLS P hP K hBK (Or.inl rfl) hm
  let := hZ
  let := hel
  obtain ⟨h,hh,hseed⟩ := index_two_seed H U Z hHU hi
  let w := Additive.ofMul (QuotientGroup.mk' (Z.subgroupOf U) (inclusion hHU h))
  let τ := elementaryRepresentation (p := 2) (ρ.comp K.subtype)
  have hw : w ≠ 0 := fun he => hh (congrArg Additive.toMul he)
  obtain ⟨common⟩ := t.commonFacts hc
  have earlier := DistanceEight.PathCentrality.Source44.OriginalEarlier.earlier common hb
  have hHL : H ≤ centralizer (c.L : Set G) :=
    (intrinsicFour_properties_of_MS93 d c.L b t common earlier).2.2.trans inf_le_right
  have hfix (a : B.subgroupOf K) : τ a.val w = w := by
    obtain ⟨l,hl,he⟩ := a.property
    change q l = a.val.val at he
    change Additive.ofMul (ρ a.val.val w.toMul) = w
    apply Additive.toMul.injective
    change ρ a.val.val (QuotientGroup.mk' (Z.subgroupOf U) (inclusion hHU h)) = _
    rw [←he]
    apply hρ l (inclusion hHU h) (inclusion hHU h)
    change (h:G) = (l:G)*(h:G)*(l:G)⁻¹
    exact (mul_inv_eq_iff_eq_mul.mpr (hHL h.property l hl)).symm
  have hspan : Submodule.span (ZMod 2) (Set.range (fun k : K => τ k w)) = ⊤ :=
    fixed_section_orbit_span C H U Z q K hHU
      (binary_three_point_four_fixed_component_span d c.L b z hLS P hP K hBK hm)
      ρ hρ w.toMul hseed
  exact ⟨hZH,hi,hHU,hUN,hCU,hcomm,
    binary_three_point_four_endpoint_index d c.L b z hLS P hP K hBK hm,
    hZ,hel,ρ,hρ,h,hw,hseed,hfix,hspan,exists_coset_orbit_map τ (B.subgroupOf K) w hfix hspan⟩

end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource
