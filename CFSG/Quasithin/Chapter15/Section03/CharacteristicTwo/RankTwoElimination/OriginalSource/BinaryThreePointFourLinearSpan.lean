module
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource.BinaryThreePointFourSpanAction
public import Theory.Representation.ElementaryPerfectSplit

/-!
# The actual binary-four linear orbit span

The elementary structure and the original conjugation action give the binary
representation on the literal central span. Its restriction to the actual
component is faithful and the original moving eight generates the entire
space under that component. The full point-quotient kernel and representative
equation are retained; no simplicity or dimension condition is put on W.

Source context: Aschbacher--Smith 15.3.23, original binary-four carrier.
-/
public noncomputable section
open Subgroup Theory.GroupTheory Representation
open scoped MatrixGroups Pointwise IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource
open LinearThree LinearThree.OriginalSource CoreActions ChapterC BinaryMS.MS93

private theorem component_orbit_span
    {G X : Type*} [Group G] [Group X]
    (C V W : Subgroup G) [IsElementaryAbelian 2 V] [IsElementaryAbelian 2 W]
    (q : C →* X) (K : Subgroup X) (hVW : V ≤ W)
    (hspan : W = conjugateSpanBy V ((K.comap q).map C.subtype))
    (ρ : X →* MulAut W)
    (hρ : ∀ (x : C) (w : W), (ρ (q x) w : G) = x * (w : G) * (x : G)⁻¹) :
    Submodule.span (ZMod 2)
      (Set.range (fun kv : K × Additive V =>
        elementaryRepresentation (p := 2) ρ kv.1.val
          ((inclusion hVW).toAdditive.toZModLinearMap 2 kv.2))) = ⊤ := by
  let S := Submodule.span (ZMod 2)
    (Set.range (fun kv : K × Additive V =>
      elementaryRepresentation (p := 2) ρ kv.1.val
        ((inclusion hVW).toAdditive.toZModLinearMap 2 kv.2)))
  let D : Subgroup W := S.toAddSubgroup.toSubgroup'
  have hWD : W ≤ D.map W.subtype := by
    conv_lhs => rw [hspan]
    apply (closure_le _).mpr
    rintro _ ⟨x,hx,v,hv,rfl⟩
    obtain ⟨x,hx,rfl⟩ := hx
    refine ⟨ρ (q x) (inclusion hVW ⟨v,hv⟩),?_,?_⟩
    · change Additive.ofMul (ρ (q x) (inclusion hVW ⟨v,hv⟩)) ∈ S
      exact Submodule.subset_span ⟨(⟨q x,hx⟩,Additive.ofMul ⟨v,hv⟩),rfl⟩
    · exact hρ x (inclusion hVW ⟨v,hv⟩)
  apply top_unique
  intro w _
  obtain ⟨u,hu,he⟩ := hWD w.toMul.property
  have hue : u = w.toMul := Subtype.ext he
  subst u
  exact hu

private theorem elementary_action_injective
    {X W : Type*} [Group X] [Group W] [IsElementaryAbelian 2 W]
    (ρ : X →* MulAut W) (hρ : Function.Injective ρ) :
    Function.Injective (elementaryRepresentation (p := 2) ρ) := by
  intro x y h
  apply hρ
  apply MulEquiv.ext
  intro w
  exact Additive.ofMul.injective (LinearMap.congr_fun h (Additive.ofMul w))

private theorem elementary_action_ker
    {X W : Type*} [Group X] [Group W] [IsElementaryAbelian 2 W]
    (ρ : X →* MulAut W) :
    (elementaryRepresentation (p := 2) ρ).ker = ρ.ker := by
  ext x
  constructor
  · intro hx
    apply MulEquiv.ext
    intro w
    exact Additive.ofMul.injective (LinearMap.congr_fun hx (Additive.ofMul w))
  · intro hx
    apply LinearMap.ext
    intro w
    change Additive.ofMul (ρ x w.toMul) = w
    rw [show ρ x = 1 from hx]
    rfl

variable {G : Type*} [Group G] [Finite G]

/-- The original central span, with its canonical binary structure and
full quotient action, is faithfully generated by the original moving eight
under the actual component K. -/
theorem binary_three_source_four_linear_span
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (d : LocalData G)
    (hempty : MainForward.faithfulLocalComponents d.T = ∅)
    (hM : ChapterA.Section05To06.IsOrderingMaximal d.T d.M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions d.T : Set G)) = {d.Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (d.T : Subgroup G)).ncard)
    {I : Subgroup G} (hI : I ∈ d.Hplus) (htwo : OutsideStructure.RankTwoCase d I)
    (hf : HasCharacteristicTwo I) (c : ComponentWitness d I)
    (e : (c.L ⧸ pCore 2 c.L) ≃* PSL(3,ZMod 2))
    (b : BinaryMS.Input KnownSimple.IsKnownSimple
      (c.L.subgroupOf (c.L ⊔ d.S)) (d.S.subgroupOf (c.L ⊔ d.S)))
    (t : InputSetup b)
    (hc : ¬ IsMulCommutative (BinaryMS.commutatorCore (c.L.subgroupOf (c.L ⊔ d.S))))
    (hb : 4 < t.geometry.b t.reduction.radical)
    (z : G) (hLS : c.L ⊔ d.S ≤ centralizer ({z} : Set G))
    (P : Sylow 2 (centralizer ({z} : Set G)))
    (hP : (P : Subgroup _).map (centralizer ({z} : Set G)).subtype = d.S)
    (K : Subgroup ((centralizer ({z} : Set G)) ⧸ pCore 2 (centralizer ({z} : Set G))))
    [K.Normal]
    (hBK : (c.L.subgroupOf (centralizer ({z} : Set G))).map
      (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G)))) ≤ K)
    (hm : ClassicalGroup.IsPSL K 4 2) :
    let C := centralizer ({z} : Set G)
    let q := QuotientGroup.mk' (pCore 2 C)
    let V := ⁅coreCenter c.L,c.L⁆
    let W := conjugateSpanBy V C
    ∃ (hV : IsElementaryAbelian 2 V) (hW : IsElementaryAbelian 2 W) (hVW : V ≤ W),
      letI := hV
      letI := hW
      ∃ σ : Representation (ZMod 2) (C ⧸ pCore 2 C) (Additive W),
        let τ := σ.comp K.subtype
        Function.Injective τ ∧
        (∀ (x : C) (w : Additive W),
          ((σ (q x) w).toMul : G) = x * (w.toMul : G) * (x : G)⁻¹) ∧
        σ.ker = centralizer (K : Set (C ⧸ pCore 2 C)) ∧
        Submodule.span (ZMod 2)
          (Set.range (fun kv : K × Additive V =>
            τ kv.1 ((inclusion hVW).toAdditive.toZModLinearMap 2 kv.2))) = ⊤ := by
  let C := centralizer ({z} : Set G)
  let q := QuotientGroup.mk' (pCore 2 C)
  let V := ⁅coreCenter c.L,c.L⁆
  let W := conjugateSpanBy V C
  obtain ⟨hV,_,hVW,_,_,hW⟩ := binary_three_source_binary_central_eight_span
    hG d hempty hM hu hmany hI htwo hf c e b t hc hb z hLS P hP K hBK (Or.inl rfl) hm
  refine ⟨hV,hW,hVW,?_⟩
  let := hV
  let := hW
  obtain ⟨ρ,hρ,hinj,hker⟩ := binary_three_source_four_central_span_action
    hG d hempty hM hu hmany hI htwo hf c e b t hc hb z hLS P hP K hBK hm
  refine ⟨elementaryRepresentation (p := 2) ρ,?_,?_,?_,?_⟩
  · exact elementary_action_injective (ρ.comp K.subtype) hinj
  · intro x w
    exact hρ x w.toMul
  · exact (elementary_action_ker ρ).trans hker
  · exact component_orbit_span C V W q K hVW
      (binary_three_source_four_component_span
        hG d hempty hM hu hmany hI htwo hf c e b t hc hb z hLS P hP K hBK hm) ρ hρ

end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource
