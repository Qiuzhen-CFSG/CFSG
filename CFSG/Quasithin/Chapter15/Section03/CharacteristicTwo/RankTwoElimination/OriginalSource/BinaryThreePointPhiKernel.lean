/-!
# The original Frattini layer lies in the binary-carrier point kernel

The literal original derived core is fully moved by L, by transporting the
source moving-radius identity. In each binary carrier the derived two-core
of the perfect image B centralizes B. Their comparison kills the image of
Φ(Q)=Q′. This preserves the actual C, N=O₂(C), quotient and carrier; it
neither kills all of Q nor asserts that Q is characteristic in N.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher.PushingUp.AmalgamGraph
open scoped MatrixGroups
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource
open LinearThree LinearThree.OriginalSource CoreActions ChapterC BinaryMS.MS93
universe u
variable {G : Type u} [Group G] [Finite G]

/-- The literal original derived core is fully generated by its L-commutators. -/
theorem binary_three_large_distance_original_derived_full_commutation
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (d : LocalData G)
    (hempty : MainForward.faithfulLocalComponents d.T = ∅)
    (hM : ChapterA.Section05To06.IsOrderingMaximal d.T d.M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions d.T : Set G)) = {d.Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (d.T : Subgroup G)).ncard)
    {I : Subgroup G} (hI : I ∈ d.Hplus) (htwo : OutsideStructure.RankTwoCase d I)
    (hf : HasCharacteristicTwo I) (c : ComponentWitness d I)
    (e : (c.L ⧸ pCore 2 c.L) ≃* PSL(3,ZMod 2))
    (b : BinaryMS.Input KnownSimple.IsKnownSimple
      (c.L.subgroupOf (c.L ⊔ d.S)) (d.S.subgroupOf (c.L ⊔ d.S)))
    (t : InputSetup b)
    (hc : ¬ IsMulCommutative (BinaryMS.commutatorCore (c.L.subgroupOf (c.L ⊔ d.S))))
    (hb : 4 < t.geometry.b t.reduction.radical) :
    let Q := LinearThree.commutatorCore c.L
    ⁅⁅Q,Q⁆,c.L⁆ = ⁅Q,Q⁆ := by
  obtain ⟨hW,hJ,hcore,_⟩ := source_lemma_15_3_16_local_geometry
    hG d hempty hM hu hmany hI htwo hf c
  obtain ⟨hne,hBaum,_⟩ := InitialSource.UniformControl.source_controls_of_ordering_maximal
    hG d.T hempty hM hu hmany (d.action.card_centralInvolutions d.T d.sylow_le)
  let eSL := e.trans (BinaryLinear.OuterCyclic.projectiveEquivSL (by decide))
  obtain ⟨_,h,hg⟩ := residual_geometry_of_original hG d hempty hM hu hmany hne hBaum
    hI c (OutsideStructure.rankTwoCase_three_rank hG d hI htwo) eSL hW hJ hcore
  obtain ⟨common⟩ := t.commonFacts hc
  have earlier := DistanceEight.PathCentrality.Source44.OriginalEarlier.earlier common hb
  have hi := d.action.planeStabilizer_index_two d.T d.sylow_le 1
  have hnot : ¬ (d.T : Subgroup G) ≤ d.S := by
    intro hTS
    have ht : d.S.subgroupOf (d.T : Subgroup G) = ⊤ := top_unique (fun x _ => hTS x.property)
    rw [ht,index_top] at hi
    omega
  obtain ⟨g,hgT,hgS⟩ := SetLike.not_le_iff_exists.mp hnot
  let J := c.L ⊔ d.S
  let M := t.reduction.overgroup
  let R := t.reduction.radical
  let K := core R (alpha R)
  let L₀ := (c.L.subgroupOf J).subgroupOf M
  let ι : M →* G := J.subtype.comp M.subtype
  let emb := embedM R
  have hLe : L₀.map emb = Ltilde R (alpha R) := t.Ltilde_embedded.symm
  have hLi : L₀.map ι = c.L := by
    dsimp only [ι,L₀]
    rw [←map_map,map_subgroupOf_eq_of_le (show c.L.subgroupOf J ≤ M from le_sup_left),
      map_subgroupOf_eq_of_le (show c.L ≤ J from le_sup_left)]
  have hKe : K ≤ emb.range := by
    have hh : K ≤ stabilizer R (alpha R) :=
      (DistanceTwo.core_le_Q _).trans (fun _ hx => hx.1)
    simpa only [alpha,stabilizer_m_base,Mbar] using hh
  have hmap : (K.comap emb).map emb = K := by
    rw [map_comap_eq]
    exact inf_eq_right.mpr hKe
  have hKi : (K.comap emb).map ι = LinearThree.commutatorCore c.L := by
    dsimp only [ι]
    rw [←map_map,t.core_pullback]
    exact sourceQ_map_subtype (show c.L ≤ J from le_sup_left) b.component
  have hderived : ⁅K,K⁆ = Vcirc R (alpha R) :=
    (source_core_structure_of_original_exchange d c.L eSL h hg b t common earlier g hgT hgS).2.1
  have hmoved : ⁅⁅K,K⁆,Ltilde R (alpha R)⁆ = ⁅K,K⁆ := by
    rw [hderived]
    exact NaturalStructure.Exclusion.moving_full_commutation t.source t.geometry (by omega) _ rfl
  have hpull : ⁅⁅K.comap emb,K.comap emb⁆,L₀⁆ = ⁅K.comap emb,K.comap emb⁆ := by
    apply map_injective (f := emb) (embedM_injective R)
    simpa only [map_commutator,hmap,hLe] using hmoved
  have hi := congrArg (Subgroup.map ι) hpull
  simpa only [map_commutator,hKi,hLi] using hi

/-- Perfectness removes the adjacent scalar, and the middle derived corner
is fixed. Thus the actual binary-carrier image centralizes its derived core. -/
theorem binary_three_point_binary_core_derived_central
    {X : Type*} [Group X] [Finite X]
    (S : Sylow 2 X) {B K : Subgroup X} [K.Normal] [Group.IsPerfect B]
    (hBK : B ≤ K) (hSB : (S : Subgroup X) ≤ normalizer (B : Set X))
    (e : (B ⧸ pCore 2 B) ≃* PSL(3,ZMod 2))
    {n : ℕ} (hn : n = 4 ∨ n = 5) (hm : ClassicalGroup.IsPSL K n 2) :
    ⁅⁅B.pCoreIn 2,B.pCoreIn 2⁆,B⁆ = ⊥ := by
  obtain ⟨F,_,_,hF,⟨a₀⟩⟩ := hm
  let := Fintype.ofFinite F
  let f : F ≃+* ZMod 2 := FiniteField.ringEquivOfCardEq (by
    simpa only [←Nat.card_eq_fintype_card,Nat.card_zmod] using hF)
  let a := (a₀.trans (Atlas.fieldEquivPSL n f)).trans
    (BinaryLinear.OuterCyclic.projectiveEquivLinear (by omega : 0 < n))
  obtain ⟨T,hT⟩ := S.exists_subgroupOf_eq_of_normal K
  let D := B.subgroupOf K
  let : Group.IsPerfect D := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe hBK).symm.toMonoidHom) (subgroupOfEquivOfLe hBK).symm.surjective
  let : Group.IsPerfect (D.map a.toMonoidHom) := Group.IsPerfect.ofSurjective
    (a.toMonoidHom.subgroupMap_surjective D)
  have hTD : (T : Subgroup K) ≤ normalizer (D : Set K) := by
    rw [hT,← subgroupOf_normalizer_eq hBK]
    exact fun _ hx => hSB hx
  let U := T.mapSurjective (f := a.toMonoidHom) a.surjective
  have hUD : (U : Subgroup _) ≤ normalizer (D.map a.toMonoidHom : Set (BinaryLinear.OuterCyclic.LinearGroup n)) :=
    (map_mono hTD).trans (D.le_normalizer_map a.toMonoidHom)
  have h7B : 7 ∣ Nat.card B := by
    apply (show 7 ∣ Nat.card (B ⧸ pCore 2 B) from ?_).trans (card_quotient_dvd_card _)
    rw [Nat.card_congr (e.trans Matrix.PSL3Two.equiv.symm).toEquiv, Matrix.PSL3Two.card_SL]
    decide
  have h7D : 7 ∣ Nat.card (D.map a.toMonoidHom) := by
    rw [← Nat.card_congr (Subgroup.equivMapOfInjective D a.toMonoidHom a.injective).toEquiv,
      Nat.card_congr (subgroupOfEquivOfLe hBK).toEquiv]
    exact h7B
  have hc := BinaryLinear.SevenFlagCore.normalized_perfect_twoCore_derived_central hn U
    (D.map a.toMonoidHom) hUD h7D
  have hcD : ⁅⁅D.pCoreIn 2,D.pCoreIn 2⁆,D⁆ = ⊥ := by
    apply map_injective (f := a.toMonoidHom) a.injective
    rw [map_commutator,map_commutator,map_pCoreIn_of_injective 2 D _ a.injective,
      Subgroup.map_bot]
    exact hc
  have hcB : ⁅⁅B.pCoreIn 2,B.pCoreIn 2⁆,B⁆ = ⊥ := by
    have hh := congrArg (fun V : Subgroup K => V.map K.subtype) hcD
    simpa only [map_commutator,map_pCoreIn_of_injective 2 D _ K.subtype_injective,
      D,map_subgroupOf_eq_of_le hBK,Subgroup.map_bot] using hh
  exact hcB

private theorem core_map_of_two_kernel {A D : Type*} [Group A] [Group D] [Finite A] [Finite D]
    (f : A →* D) (hk : IsPGroup 2 f.ker) (L : Subgroup A) :
    (LinearThree.commutatorCore L).map f = LinearThree.commutatorCore (L.map f) := by
  simp only [LinearThree.commutatorCore,map_commutator,map_pCoreIn_of_ker_isPGroup f hk]

/-- The full original prefix puts the actual Frattini layer of Q in the
actual point kernel in either binary carrier. No faithfulness or dimension
bound is assumed, and Q itself is allowed a nonzero quotient image. -/
theorem binary_three_source_binary_phi_kernel
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (d : LocalData G)
    (hempty : MainForward.faithfulLocalComponents d.T = ∅)
    (hM : ChapterA.Section05To06.IsOrderingMaximal d.T d.M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions d.T : Set G)) = {d.Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (d.T : Subgroup G)).ncard)
    {I : Subgroup G} (hI : I ∈ d.Hplus) (htwo : OutsideStructure.RankTwoCase d I)
    (hf : HasCharacteristicTwo I) (c : ComponentWitness d I)
    (e : (c.L ⧸ pCore 2 c.L) ≃* PSL(3,ZMod 2))
    (b : BinaryMS.Input KnownSimple.IsKnownSimple
      (c.L.subgroupOf (c.L ⊔ d.S)) (d.S.subgroupOf (c.L ⊔ d.S)))
    (t : InputSetup b)
    (hc : ¬ IsMulCommutative (BinaryMS.commutatorCore (c.L.subgroupOf (c.L ⊔ d.S))))
    (hb : 4 < t.geometry.b t.reduction.radical)
    (z : G) (hLS : c.L ⊔ d.S ≤ centralizer ({z} : Set G))
    (P : Sylow 2 (centralizer ({z} : Set G)))
    (hP : (P : Subgroup _).map (centralizer ({z} : Set G)).subtype = d.S)
    (K : Subgroup (centralizer ({z} : Set G) ⧸ pCore 2 (centralizer ({z} : Set G))))
    [K.Normal]
    (hBK : (c.L.subgroupOf (centralizer ({z} : Set G))).map
      (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G)))) ≤ K)
    {n : ℕ} (hn : n=4 ∨ n=5) (hm : ClassicalGroup.IsPSL K n 2) :
    (frattini (LinearThree.commutatorCore c.L)).map (LinearThree.commutatorCore c.L).subtype ≤
      (centralizer ({z} : Set G)).pCoreIn 2 := by
  let C := centralizer ({z} : Set G)
  let A := c.L.subgroupOf C
  let q := QuotientGroup.mk' (pCore 2 C)
  let B := A.map q
  let Q := LinearThree.commutatorCore c.L
  let Q₀ := LinearThree.commutatorCore A
  have hLC : c.L ≤ C := le_sup_left.trans hLS
  have hSL : d.S ≤ normalizer (c.L : Set G) :=
    le_sup_right.trans ((normal_subgroupOf_iff_le_normalizer
      (show c.L ≤ c.L ⊔ d.S from le_sup_left)).mp b.component_normal)
  have hPB : (P : Subgroup C) ≤ normalizer (A : Set C) := by
    rw [←subgroupOf_normalizer_eq hLC]
    intro x hx
    exact hSL (hP ▸ mem_map_of_mem C.subtype hx)
  have hSB := (map_mono (f := q) hPB).trans (A.le_normalizer_map q)
  have hq : IsPGroup 2 q.ker := by rw [QuotientGroup.ker_mk']; exact pCore_isPGroup
  have hk : IsPGroup 2 (q.subgroupMap A).ker := by
    rw [ker_subgroupMap]
    exact hq.comap_subtype
  let a := subgroupOfEquivOfLe hLC
  let eB : (B ⧸ pCore 2 B) ≃* PSL(3,ZMod 2) :=
    ((q.subgroupMap A).pCoreQuotientEquiv (q.subgroupMap_surjective A) hk).symm.trans
      ((QuotientGroup.congr _ _ a (pCore_map_iso 2 a)).trans e)
  let : Group.IsPerfect (c.L.subgroupOf (c.L ⊔ d.S)) := b.component.perfect
  let i := subgroupOfEquivOfLe (show c.L ≤ c.L ⊔ d.S from le_sup_left)
  let : Group.IsPerfect c.L := Group.IsPerfect.ofSurjective (f := i.toMonoidHom) i.surjective
  let : Group.IsPerfect A := Group.IsPerfect.ofSurjective (f := a.symm.toMonoidHom) a.symm.surjective
  let : Group.IsPerfect B := Group.IsPerfect.ofSurjective (q.subgroupMap_surjective A)
  have hcentral := binary_three_point_binary_core_derived_central
    (P.mapSurjective (QuotientGroup.mk'_surjective _)) hBK hSB eB hn hm
  have hs : IsPGroup 2 C.subtype.ker := by
    rw [(MonoidHom.ker_eq_bot_iff _).mpr C.subtype_injective]
    exact IsPGroup.of_card (n := 0) (by simp)
  have hmapQ : Q₀.map C.subtype = Q := by
    rw [core_map_of_two_kernel C.subtype hs,map_subgroupOf_eq_of_le hLC]
  have hmove : ⁅⁅Q,Q⁆,c.L⁆ = ⁅Q,Q⁆ :=
    binary_three_large_distance_original_derived_full_commutation
      hG d hempty hM hu hmany hI htwo hf c e b t hc hb
  have hmapA : A.map C.subtype = c.L := map_subgroupOf_eq_of_le hLC
  have hmove₀ : ⁅⁅Q₀,Q₀⁆,A⁆ = ⁅Q₀,Q₀⁆ := by
    apply map_injective C.subtype_injective
    simpa only [map_commutator,hmapQ,hmapA] using hmove
  have hQimage : Q₀.map q ≤ B.pCoreIn 2 := by
    have hh := map_mono (f := q) (LinearThree.commutatorCore_le A)
    rw [map_pCoreIn_of_ker_isPGroup q hq] at hh
    exact hh
  have hcentral₀ : ⁅(⁅Q₀,Q₀⁆).map q,B⁆ = ⊥ := by
    rw [map_commutator]
    exact eq_bot_iff.mpr ((commutator_mono (commutator_mono hQimage hQimage) le_rfl).trans hcentral.le)
  have hkill : (⁅Q₀,Q₀⁆).map q = ⊥ := by
    rw [←hmove₀,map_commutator]
    exact hcentral₀
  have hle₀ : ⁅Q₀,Q₀⁆ ≤ pCore 2 C := by
    have hh := (Subgroup.map_eq_bot_iff (⁅Q₀,Q₀⁆)).mp hkill
    simpa only [q,QuotientGroup.ker_mk'] using hh
  have hle : ⁅Q,Q⁆ ≤ C.pCoreIn 2 := by
    have hh := map_mono (f := C.subtype) hle₀
    change ⁅Q,Q⁆ ≤ (pCore 2 C).map C.subtype
    simpa only [map_commutator,hmapQ] using hh
  have hroot : _root_.commutator Q = frattini Q :=
    (binary_three_large_distance_original_core_structure
      hG d hempty hM hu hmany hI htwo hf c e b t hc hb).2.2.2.2.2.1
  change (frattini Q).map Q.subtype ≤ C.pCoreIn 2
  rw [←hroot]
  simpa only [_root_.commutator_def,map_commutator,←MonoidHom.range_eq_map,range_subtype] using hle

end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource
