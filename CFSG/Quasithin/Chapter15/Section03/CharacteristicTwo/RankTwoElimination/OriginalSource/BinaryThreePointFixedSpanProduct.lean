module
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource.BinaryThreePointFixedSpanOrder
public import Theory.GroupTheory.NormalizedSupCard
public import Theory.GroupTheory.Commutator.SplitPair

/-!
# The original Frattini subgroup is generated by the fixed span and center

The actual fixed span U has order 32 and meets Z(Q), also of order 32,
in the original four H. Since U lies in Phi(Q), their product has the full
order 256 of Phi(Q). The central factor then drops out of the commutator
with Q, giving the exact original identity [U,Q]=H.
-/
public noncomputable section
open Subgroup Theory.GroupTheory
open scoped MatrixGroups IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource
open LinearThree LinearThree.OriginalSource CoreActions ChapterC BinaryMS.MS93
open CFSG.Quasithin.Chapter1.RadicalExclusions.ModelReduction.FullSieve.SourceInterface
variable {G : Type*} [Group G] [Finite G]

/-- The original fixed span and center generate the full Frattini subgroup,
and its displacement by Q is the original intrinsic four. -/
theorem binary_three_source_fixed_span_frattini_product
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (d : LocalData G)
    (hempty : MainForward.faithfulLocalComponents d.T = ∅)
    (hM : ChapterA.Section05To06.IsOrderingMaximal d.T d.M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions d.T : Set G)) = {d.Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (d.T : Subgroup G)).ncard)
    {I : Subgroup G} (hI : I ∈ d.Hplus) (htwo : OutsideStructure.RankTwoCase d I)
    (hf : HasCharacteristicTwo I) (c : ComponentWitness d I)
    (e : (c.L ⧸ pCore 2 c.L) ≃* PSL(3,ZMod 2))
    (b : BinaryMS.Input KnownSimple.IsKnownSimple
      (c.L.subgroupOf (c.L ⊔ d.S)) (d.S.subgroupOf (c.L ⊔ d.S)))
    (t : InputSetup b)
    (hc : ¬ IsMulCommutative (BinaryMS.commutatorCore (c.L.subgroupOf (c.L ⊔ d.S))))
    (hb : 4 < t.geometry.b t.reduction.radical)
    (z : G) (hzH : z ∈ LinearThree.OriginalSource.intrinsicFour c.L)
    (hz2 : orderOf z = 2) (hLS : c.L ⊔ d.S ≤ centralizer ({z} : Set G))
    (P : Sylow 2 (centralizer ({z} : Set G)))
    (hP : (P : Subgroup _).map (centralizer ({z} : Set G)).subtype = d.S)
    (K : Subgroup (centralizer ({z} : Set G)))
    (hK : K.IsCComponent) (hKn : K.Normal)
    (hLK : c.L.subgroupOf (centralizer ({z} : Set G)) ≤ K)
    [IsSimpleGroup (K.map (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G)))))]
    (eB : (((c.L.subgroupOf (centralizer ({z} : Set G))).map
      (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G))))) ⧸
      pCore 2 ((c.L.subgroupOf (centralizer ({z} : Set G))).map
        (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G)))))) ≃* PSL(3,ZMod 2))
    (hrX : primeRank 3 (centralizer ({z} : Set G) ⧸ pCore 2 (centralizer ({z} : Set G))) = 2)
    (hrB : primeRank 3 (normalizer ((c.L.subgroupOf (centralizer ({z} : Set G))).map
      (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G)))) :
        Set ((centralizer ({z} : Set G)) ⧸ pCore 2 (centralizer ({z} : Set G))))) ≤ 1)
    (hm : ClassicalGroup.IsPSL
      (K.map (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G))))) 4 2) :
    let Q := LinearThree.commutatorCore c.L
    let U := conjugateSpanBy (intrinsicFour c.L) (centralizer ({z} : Set G))
    frattiniIn Q = U ⊔ coreCenter c.L ∧ ⁅U,Q⁆ = intrinsicFour c.L := by
  let C := centralizer ({z} : Set G)
  let q := QuotientGroup.mk' (pCore 2 C)
  let Q := LinearThree.commutatorCore c.L
  let Phi := frattiniIn Q
  let ZQ := coreCenter c.L
  let H := intrinsicFour c.L
  let U := conjugateSpanBy H C
  let := hKn
  let : (K.map q).Normal := hKn.map q (QuotientGroup.mk'_surjective _)
  have hBK := map_mono (f := q) hLK
  have hUPhi : U ≤ Phi := (binary_three_source_fixed_span_frattini
    hG d hempty hM hu hmany hI htwo hf c e b t hc hb z hzH hz2 hLS P hP
      (K.map q) hBK hm).2
  have hUZ : U ⊓ ZQ = H := (binary_three_source_fixed_span_center_bound
    hG d hempty hM hu hmany hI htwo hf c e b t hc hb z hzH hz2 hLS P hP
      (K.map q) hBK hm).2.1
  have hUcard : Nat.card U = 32 := binary_three_source_four_fixed_span_order
    hG d hempty hM hu hmany hI htwo hf c e b t hc hb z hzH hz2 hLS P hP
      K hK hKn hLK eB hrX hrB hm
  have hsizes := binary_three_large_distance_original_core_structure
    hG d hempty hM hu hmany hI htwo hf c e b t hc hb
  have hZcard : Nat.card ZQ = 32 := by
    change Nat.card ((center Q).map Q.subtype) = 32
    rw [card_map_of_injective Q.subtype_injective]
    exact hsizes.2.1
  have hPhicard : Nat.card Phi = 256 := by
    change Nat.card ((frattini Q).map Q.subtype) = 256
    rw [card_map_of_injective Q.subtype_injective]
    exact hsizes.2.2.1
  obtain ⟨common⟩ := t.commonFacts hc
  have earlier := DistanceEight.PathCentrality.Source44.OriginalEarlier.earlier common hb
  have hHcard : Nat.card H = 4 :=
    (intrinsicFour_properties_of_MS93 d c.L b t common earlier).2.1
  have hZPhi : ZQ ≤ Phi := map_mono hsizes.2.2.2.2.1
  have hUQ : U ≤ Q := hUPhi.trans (map_subtype_le _)
  have hZcQ : ZQ ≤ centralizer (Q : Set G) := by
    rintro _ ⟨x,hx,rfl⟩ y hy
    exact congrArg Subtype.val (mem_center_iff.mp hx ⟨y,hy⟩)
  have hZcU : ZQ ≤ centralizer (U : Set G) := hZcQ.trans (centralizer_le hUQ)
  have hcount := card_mul_eq_card_inf_mul_card_sup_of_normalizes U ZQ
    (hZcU.trans (Subgroup.centralizer_le_normalizer _))
  rw [hUcard,hZcard,hUZ,hHcard] at hcount
  have hproduct : U ⊔ ZQ = Phi := eq_of_le_of_card_ge
    (sup_le hUPhi hZPhi) (by rw [hPhicard]; omega)
  have hPhi : Phi = ⁅Q,Q⁆ := by
    dsimp only [Phi,frattiniIn]
    rw [←hsizes.2.2.2.2.2.1,_root_.commutator_def,map_commutator,
      ←MonoidHom.range_eq_map,range_subtype]
  have hPhiComm : ⁅Phi,Q⁆ = H := by
    rw [hPhi]
    rfl
  have hQnZ : Q ≤ normalizer ZQ :=
    (le_centralizer_iff.mp hZcQ).trans (Subgroup.centralizer_le_normalizer _)
  have hZcomm : ⁅ZQ,Q⁆ = ⊥ := commutator_eq_bot_iff_le_centralizer.mpr hZcQ
  rw [←hproduct,commutator_sup_of_commuting_factors U ZQ Q
    (le_centralizer_iff.mp hZcU) hQnZ,hZcomm,sup_bot_eq] at hPhiComm
  exact ⟨hproduct.symm,hPhiComm⟩

end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource
