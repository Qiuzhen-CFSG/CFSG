module
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource.BinaryThreePointOpposedKernelRadical
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource.BinaryThreePointFixedSpanKernelCentralizer
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource.BinaryThreePointCoreSizes
public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource.BinaryThreeOriginalCoreSections
public import Theory.GroupTheory.NormalizedSupCard

/-!
# The original radical part of the point kernel

For F=C_N(U), the actual core intersection Q intersect N has order 2^17
and meets F in D of order 2^14. Its product with F therefore has index two
in N. The opposed-plane comparison identifies this product with N intersect
R, and the product description proves normalization by the original L.
-/
public noncomputable section
open Subgroup Theory.GroupTheory
open scoped MatrixGroups Pointwise
namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource
open LinearThree LinearThree.OriginalSource CoreActions ChapterC BinaryMS.MS93
open CFSG.Quasithin.Chapter1.RadicalExclusions.ModelReduction.FullSieve.SourceInterface
variable {G : Type*} [Group G] [Finite G]

/-- The original radical intersection is generated by the actual core
intersection and fixed-span action kernel, and is normalized by L. -/
theorem binary_three_source_radical_kernel_product
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (d : LocalData G)
    (hempty : MainForward.faithfulLocalComponents d.T = ∅)
    (hM : ChapterA.Section05To06.IsOrderingMaximal d.T d.M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions d.T : Set G)) = {d.Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (d.T : Subgroup G)).ncard)
    {I : Subgroup G} (hI : I ∈ d.Hplus) (htwo : OutsideStructure.RankTwoCase d I)
    (hf : HasCharacteristicTwo I) (c : ComponentWitness d I)
    (e : (c.L ⧸ pCore 2 c.L) ≃* PSL(3,ZMod 2))
    (b : BinaryMS.Input KnownSimple.IsKnownSimple
      (c.L.subgroupOf (c.L ⊔ d.S)) (d.S.subgroupOf (c.L ⊔ d.S)))
    (t : InputSetup b)
    (hc : ¬ IsMulCommutative (BinaryMS.commutatorCore (c.L.subgroupOf (c.L ⊔ d.S))))
    (hb : 4 < t.geometry.b t.reduction.radical)
    (z : G) (hzH : z ∈ LinearThree.OriginalSource.intrinsicFour c.L)
    (hz2 : orderOf z = 2) (hLS : c.L ⊔ d.S ≤ centralizer ({z} : Set G))
    (P : Sylow 2 (centralizer ({z} : Set G)))
    (hP : (P : Subgroup _).map (centralizer ({z} : Set G)).subtype = d.S)
    (K : Subgroup (centralizer ({z} : Set G)))
    (hK : K.IsCComponent) (hKn : K.Normal)
    (hLK : c.L.subgroupOf (centralizer ({z} : Set G)) ≤ K)
    [IsSimpleGroup (K.map (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G)))))]
    (eB : (((c.L.subgroupOf (centralizer ({z} : Set G))).map
      (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G))))) ⧸
      pCore 2 ((c.L.subgroupOf (centralizer ({z} : Set G))).map
        (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G)))))) ≃* PSL(3,ZMod 2))
    (hrX : primeRank 3 (centralizer ({z} : Set G) ⧸ pCore 2 (centralizer ({z} : Set G))) = 2)
    (hrB : primeRank 3 (normalizer ((c.L.subgroupOf (centralizer ({z} : Set G))).map
      (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G)))) :
        Set ((centralizer ({z} : Set G)) ⧸ pCore 2 (centralizer ({z} : Set G))))) ≤ 1)
    (hm : ClassicalGroup.IsPSL
      (K.map (QuotientGroup.mk' (pCore 2 (centralizer ({z} : Set G))))) 4 2)
    (g : G) (hgT : g ∈ (d.T : Subgroup G)) (hgS : g ∉ d.S) :
    let C := centralizer ({z} : Set G)
    let N := C.pCoreIn 2
    let Q := LinearThree.commutatorCore c.L
    let U := conjugateSpanBy (intrinsicFour c.L) C
    let F := N ⊓ centralizer (U : Set G)
    N ⊓ d.R = F ⊔ (Q ⊓ N) ∧ c.L ≤ normalizer (N ⊓ d.R) ∧
      F.relIndex (N ⊓ d.R) = 8 := by
  let C := centralizer ({z} : Set G)
  let q := QuotientGroup.mk' (pCore 2 C)
  let N := C.pCoreIn 2
  let H := intrinsicFour c.L
  let Q := LinearThree.commutatorCore c.L
  let Phi := frattiniIn Q
  let D := Q ⊓ centralizer (Phi : Set G)
  let U := conjugateSpanBy H C
  let F := N ⊓ centralizer (U : Set G)
  let A := Q ⊓ N
  let M := N ⊓ d.R
  let := hKn
  let : (K.map q).Normal := hKn.map q (QuotientGroup.mk'_surjective _)
  have hBK := map_mono (f := q) hLK
  have hrad := binary_three_source_opposed_kernel_radical
    hG d hempty hM hu hmany hI htwo hf c e b t hc hb z hzH hz2 hLS P hP
      K hK hKn hLK eB hrX hrB hm g hgT hgS
  have hker := binary_three_source_fixed_span_kernel_centralizer
    hG d hempty hM hu hmany hI htwo hf c e b t hc hb z hzH hz2 hLS P hP
      K hK hKn hLK eB hrX hrB hm
  have hFC : C ≤ normalizer F := hker.1
  have hFQ : F ⊓ Q = D := hker.2.2.2.1
  have hFNindex : F.relIndex N = 16 := hker.2.2.2.2
  have hmeet : M = N ⊓ centralizer (H : Set G) := hrad.2.2.1
  have hMNindex : M.relIndex N = 2 := by rw [inf_relIndex_left]; exact hrad.2.2.2
  have hFM : F ≤ M := by
    rw [hmeet]
    exact le_inf inf_le_left (inf_le_right.trans (centralizer_le (le_conjugateSpanBy H C)))
  have hQL : Q ≤ c.L := (LinearThree.commutatorCore_le c.L).trans (c.L.pCoreIn_le 2)
  have hLC : c.L ≤ C := le_sup_left.trans hLS
  obtain ⟨common⟩ := t.commonFacts hc
  have earlier := DistanceEight.PathCentrality.Source44.OriginalEarlier.earlier common hb
  have hHL : H ≤ centralizer (c.L : Set G) :=
    (intrinsicFour_properties_of_MS93 d c.L b t common earlier).2.2.trans inf_le_right
  have hAM : A ≤ M := by
    rw [hmeet]
    exact le_inf inf_le_right (inf_le_left.trans (hQL.trans (le_centralizer_iff.mp hHL)))
  have hFA : F ⊓ A = D := by
    change F ⊓ (Q ⊓ N) = D
    rw [←inf_assoc,inf_eq_left.mpr (inf_le_left.trans (show F ≤ N from inf_le_left)),hFQ]
  have hAcard : Nat.card A = 131072 := (binary_three_source_binary_core_sizes
    hG d hempty hM hu hmany hI htwo hf c e b t hc hb z hLS P hP
      (K.map q) hBK (Or.inl rfl) hm).2
  have hQcard : Nat.card Q = 1048576 := (binary_three_large_distance_original_core_structure
    hG d hempty hM hu hmany hI htwo hf c e b t hc hb).2.2.2.1
  obtain ⟨a,_,_,hs⟩ := binary_three_large_distance_original_core_sections
    hG d hempty hM hu hmany hI htwo hf c e b t hc hb
  have hDcard : Nat.card D = 16384 := by
    obtain ⟨hDQ,_,_,hn,E,_⟩ := hs
    let := hn
    have hcount := card_eq_card_quotient_mul_card_subgroup (D.subgroupOf Q)
    rw [Nat.card_congr E.toEquiv,
      Nat.card_congr (subgroupOfEquivOfLe hDQ).toEquiv,hQcard] at hcount
    have hvec : Nat.card (Multiplicative ((Fin 3 → ZMod 2) × (Fin 3 → ZMod 2))) = 64 := by
      simp
    rw [hvec] at hcount
    change 1048576 = 64 * Nat.card D at hcount
    omega
  have hprod := card_mul_eq_card_inf_mul_card_sup_of_normalizes F A
    ((inf_le_right.trans (C.pCoreIn_le 2)).trans hFC)
  rw [hFA,hAcard,hDcard] at hprod
  have hFN := relIndex_mul_relIndex (⊥ : Subgroup G) F N bot_le inf_le_left
  have hMN := relIndex_mul_relIndex (⊥ : Subgroup G) M N bot_le inf_le_left
  rw [relIndex_bot_left,relIndex_bot_left,hFNindex] at hFN
  rw [relIndex_bot_left,relIndex_bot_left,hMNindex] at hMN
  have heq : M = F ⊔ A := (eq_of_le_of_card_ge (sup_le hFM hAM) (by omega)).symm
  have hCN : C ≤ normalizer N := C.le_normalizer.trans
    (normalizer_le_normalizer_characteristic_image C (pCore 2 C))
  have hLQ : c.L ≤ normalizer Q := c.L.le_normalizer.trans
    (normalizer_le_normalizer_commutatorCore c.L)
  have hLA : c.L ≤ normalizer A :=
    (le_inf hLQ (hLC.trans hCN)).trans inf_normalizer_le_normalizer_inf
  have hLM : c.L ≤ normalizer M := by
    rw [heq]
    exact (le_inf (hLC.trans hFC) hLA).trans (normalizer_inf_normalizer_le_normalizer_sup F A)
  have hindex := relIndex_mul_relIndex F M N hFM inf_le_left
  rw [hMNindex,hFNindex] at hindex
  refine ⟨heq,hLM,?_⟩
  change F.relIndex M = 8
  omega

end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.OriginalSource
