module

public import CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.LinearFourFive.NaturalDualParabolic.Basic

/-!
# The actual central subgroup contradicting C.1.34(3)

The natural fixed line and the dual annihilator of the marked point give a
four-dimensional subgroup of U_L. Each is generated by actual displacements,
so their product lies in Q_P = [O₂(P),P]. The geometric point radical fixes
both pointwise, proving containment in Z(Q_P), not assuming it. Thus the centre
has order at least sixteen, excluding the natural order-eight centre in case (3).
The full seven-dimensional moved space also embeds in Q_P, giving order at
least 128. These arguments retain W_L and its possible central supplement.

Source: Aschbacher–Smith, combined manuscript (1 March 2004),
15.3.24, printed pp.1129–1130 (PDF pp.1146–1147).
-/

@[expose] public section

open Subgroup BinaryLinear.OuterCyclic
open BinaryNaturalDual.VectorStabilizers BinaryNaturalDual.VectorStabilizers.Pure
open scoped commutatorElement

namespace CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.LinearFourFive.NaturalDualParabolic

variable {G : Type*} [Group G] {d : LocalData G} {L : Subgroup G}

/-- The four-dimensional subspace whose image will lie in Z(Q_P). -/
def centralSpace (x : Space 4) :
    Submodule (ZMod 2) (Space 4 × Module.Dual (ZMod 2) (Space 4)) :=
  (Submodule.span (ZMod 2) {x}).prod (annihilator x)

theorem centralSpace_card {x : Space 4} (hx : x ≠ 0) :
    Nat.card (centralSpace x) = 16 := by
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2), Nat.card_zmod]
  have hd : Module.finrank (ZMod 2) (centralSpace x) = 4 := by
    let e : ((Submodule.span (ZMod 2) {x}) × annihilator x) ≃ₗ[ZMod 2] centralSpace x := {
      toFun w := ⟨(w.1.val, w.2.val), w.1.property, w.2.property⟩
      invFun w := (⟨w.val.1, w.property.1⟩, ⟨w.val.2, w.property.2⟩)
      left_inv _ := rfl
      right_inv _ := rfl
      map_add' _ _ := rfl
      map_smul' _ _ := rfl }
    rw [← e.finrank_eq, Module.finrank_prod, finrank_span_singleton hx, annihilator_finrank hx]
  rw [hd]
  decide

/-- Both pieces are actual displacements, so the claimed central space lies in Q_P. -/
theorem centralSpace_mem_core (h : NaturalDual d L) {x : Space 4} (hx : x ≠ 0)
    (hU : spanCommutator d L ≤ (point h x).pCoreIn 2)
    (v : Space 4 × Module.Dual (ZMod 2) (Space 4)) (hv : v ∈ centralSpace x) :
    embed h (Multiplicative.ofAdd v) ∈ coreCommutator (point h x) := by
  obtain ⟨a, ha⟩ := Submodule.mem_span_singleton.mp hv.1
  have hxQ : embed h (Multiplicative.ofAdd (x, (0 : Module.Dual (ZMod 2) (Space 4)))) ∈
      coreCommutator (point h x) := by
    obtain ⟨g, w, hw⟩ := marked_displacement (V := Space 4)
      (by simp [Space]) hx
    have hc := displacement_mem h x hU g (w, 0)
    have he : BinaryLinear.NaturalDualFlag.action g.val (w, 0) - (w, 0) = (x, 0) := by
      apply Prod.ext
      · simpa only [Prod.fst_sub, BinaryLinear.NaturalDualFlag.action_fst] using hw
      · apply LinearMap.ext
        intro y
        simp only [Prod.snd_sub, BinaryLinear.NaturalDualFlag.action_snd,
          LinearMap.zero_apply, sub_zero]
    rwa [he] at hc
  have haQ : embed h (Multiplicative.ofAdd (v.1, (0 : Module.Dual (ZMod 2) (Space 4)))) ∈
      coreCommutator (point h x) := by
    rw [← ha]
    by_cases ha0 : a = 0
    · rw [ha0, zero_smul]
      change (embed h) 1 ∈ _
      rw [map_one]
      exact one_mem _
    · have ha1 : a = 1 := (by decide : ∀ a : ZMod 2, a ≠ 0 → a = 1) a ha0
      simpa only [ha1, one_smul] using hxQ
  have hqQ : embed h (Multiplicative.ofAdd ((0 : Space 4), v.2)) ∈
      coreCommutator (point h x) := by
    obtain ⟨g, f, hf⟩ := dual_displacement hx hv.2
    have hc := displacement_mem h x hU g (0, f)
    have he : BinaryLinear.NaturalDualFlag.action g.val (0, f) - (0, f) = (0, v.2) := by
      apply Prod.ext
      · simp
      · apply LinearMap.ext
        intro y
        simpa only [Prod.snd_sub, LinearMap.sub_apply, BinaryLinear.NaturalDualFlag.action_snd,
          LinearEquiv.dualMap_apply] using LinearMap.congr_fun hf y
    rwa [he] at hc
  have hh := (coreCommutator (point h x)).mul_mem haQ hqQ
  rw [← map_mul] at hh
  simpa only [← ofAdd_add, Prod.mk_add_mk, add_zero, zero_add] using hh

/-- The geometric radical fixes the line and the annihilator pointwise. -/
theorem centralSpace_fixed_by_core (h : NaturalDual d L) (x : Space 4)
    (p : point h x) (hp : p ∈ pCore 2 (point h x))
    (v : Space 4 × Module.Dual (ZMod 2) (Space 4)) (hv : v ∈ centralSpace x) :
    BinaryLinear.NaturalDualFlag.action (pointActor h x p).val v = v := by
  apply Prod.ext
  · rw [BinaryLinear.NaturalDualFlag.action_fst]
    exact Theory.LinearAlgebra.BinaryFivePointStabilizer.fixes_line x
      (pointActor h x p) v.1 hv.1
  · have hk : pointActor h x p ∈ (pointAnnihilatorAction x).ker := by
      rw [pointAnnihilatorAction_ker]
      exact point_core_actor h x p hp
    have he := LinearEquiv.congr_fun (MonoidHom.mem_ker.mp hk)
      (⟨v.2, hv.2⟩ : annihilator x)
    apply LinearMap.ext
    intro y
    rw [BinaryLinear.NaturalDualFlag.action_snd]
    exact LinearMap.congr_fun (congrArg Subtype.val he) y

/-- The subgroup corresponding to [W₁,P] C_{W₂}(P), retaining the marked coordinates. -/
def centralSubgroup (h : NaturalDual d L) (x : Space 4) : Subgroup G :=
  ((centralSpace x).toAddSubgroup.toSubgroup).map (embed h)

theorem centralSubgroup_card (h : NaturalDual d L) {x : Space 4} (hx : x ≠ 0) :
    Nat.card (centralSubgroup h x) = 16 := by
  rw [centralSubgroup, ← Nat.card_congr
    (((centralSpace x).toAddSubgroup.toSubgroup).equivMapOfInjective
      (embed h) (embed_injective h)).toEquiv]
  exact centralSpace_card hx

/-- The asserted containment in the source is proved from the actual radical action. -/
theorem centralSubgroup_le_center (h : NaturalDual d L) {x : Space 4} (hx : x ≠ 0)
    (hU : spanCommutator d L ≤ (point h x).pCoreIn 2) :
    centralSubgroup h x ≤ (center (coreCommutator (point h x))).map
      (coreCommutator (point h x)).subtype := by
  rintro _ ⟨v, hv, rfl⟩
  have hvm := centralSpace_mem_core h hx hU v.toAdd hv
  refine mem_map.mpr ⟨⟨embed h v, hvm⟩, ?_, rfl⟩
  rw [mem_center_iff]
  intro q
  apply Subtype.ext
  obtain ⟨p, hp, he⟩ := coreCommutator_le (point h x) q.property
  have hc := embed_conj h (⟨p, point_le h x p.property⟩ : L) v.toAdd
  have hf := centralSpace_fixed_by_core h x p hp v.toAdd hv
  change BinaryLinear.NaturalDualFlag.action
    (linearAction (by decide) h.model ⟨p, point_le h x p.property⟩) v.toAdd = v.toAdd at hf
  rw [hf] at hc
  have hh := (mul_inv_eq_iff_eq_mul).mp hc
  change (p : G) = (q : G) at he
  change (q : G) * embed h v = embed h v * (q : G)
  simpa only [he, ofAdd_toAdd] using hh

/-- In particular case (3) of C.1.34, whose centre has order eight, is impossible. -/
theorem center_card_ge_sixteen [Finite G] (h : NaturalDual d L)
    {x : Space 4} (hx : x ≠ 0)
    (hU : spanCommutator d L ≤ (point h x).pCoreIn 2) :
    16 ≤ Nat.card (center (coreCommutator (point h x))) := by
  have hc := card_le_of_le (centralSubgroup_le_center h hx hU)
  rw [centralSubgroup_card h hx, ← Nat.card_congr
    ((center (coreCommutator (point h x))).equivMapOfInjective
      (coreCommutator (point h x)).subtype (coreCommutator (point h x)).subtype_injective).toEquiv] at hc
  exact hc

theorem not_center_card_eight [Finite G] (h : NaturalDual d L)
    {x : Space 4} (hx : x ≠ 0)
    (hU : spanCommutator d L ≤ (point h x).pCoreIn 2)
    (hcard : Nat.card (center (coreCommutator (point h x))) = 8) : False := by
  have hh := center_card_ge_sixteen h hx hU
  omega

/-- It suffices to place U_L in the old two-core; no splitting of W_L is required. -/
theorem center_card_ge_sixteen_of_componentCore [Finite G] (h : NaturalDual d L)
    {x : Space 4} (hx : x ≠ 0) (hU : spanCommutator d L ≤ L.pCoreIn 2) :
    16 ≤ Nat.card (center (coreCommutator (point h x))) :=
  center_card_ge_sixteen h hx (hU.trans (componentCore_le_pointCore h x))

/-- The seven-dimensional moved space embeds in Q_P. This is also an
order obstruction to the one-copy, two-copy, and central-cover cases. -/
theorem coreCommutator_card_ge [Finite G] (h : NaturalDual d L)
    {x : Space 4} (hx : x ≠ 0)
    (hU : spanCommutator d L ≤ (point h x).pCoreIn 2) :
    128 ≤ Nat.card (coreCommutator (point h x)) := by
  let W : Submodule (ZMod 2) (Space 4 × Module.Dual (ZMod 2) (Space 4)) :=
    AddSubgroup.toZModSubmodule 2
      (((coreCommutator (point h x)).comap (embed h)).toAddSubgroup')
  have hw : Representation.Coinvariants.ker (pointRepresentation x) ≤ W := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨g,v⟩, rfl⟩
    change embed h (Multiplicative.ofAdd
      (BinaryNaturalDual.naturalDualRepresentation g.val v - v)) ∈ coreCommutator (point h x)
    have he : BinaryNaturalDual.naturalDualRepresentation g.val v =
        BinaryLinear.NaturalDualFlag.action g.val v := by
      rw [BinaryNaturalDual.naturalDualRepresentation_apply]
      apply Prod.ext
      · exact (BinaryLinear.NaturalDualFlag.action_fst g.val v).symm
      · apply LinearMap.ext
        intro y
        exact (BinaryLinear.NaturalDualFlag.action_snd g.val v y).symm
    rw [he]
    exact displacement_mem h x hU g v
  rw [point_commutator (by simp [Space]) hx] at hw
  let f : (Space 4 × annihilator x) → coreCommutator (point h x) :=
    fun v => ⟨embed h (Multiplicative.ofAdd (v.1, v.2.val)), hw ⟨Submodule.mem_top, v.2.property⟩⟩
  have hf : Function.Injective f := by
    intro v w he
    have he' : embed h (Multiplicative.ofAdd (v.1, v.2.val)) =
        embed h (Multiplicative.ofAdd (w.1, w.2.val)) :=
      congrArg (fun z : coreCommutator (point h x) => (z : G)) he
    have hh := embed_injective h he'
    have hh' := congrArg Multiplicative.toAdd hh
    apply Prod.ext
    · exact congrArg (fun z : Space 4 × Module.Dual (ZMod 2) (Space 4) => z.1) hh'
    · apply Subtype.ext
      exact congrArg (fun z : Space 4 × Module.Dual (ZMod 2) (Space 4) => z.2) hh'
  have hc := Nat.card_le_card_of_injective f hf
  have ha : Nat.card (annihilator x) = 8 := by
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2), Nat.card_zmod, annihilator_finrank hx]
    decide
  simpa only [Nat.card_prod, ha, show Nat.card (Space 4) = 16 by
    simp [Space, Nat.card_eq_fintype_card]] using hc


end CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.RankTwoElimination.LinearFourFive.NaturalDualParabolic

end
