      ⁅K₀,Q Rg r.start⁆ ≠ ⊥ := by
  obtain ⟨q,hqe⟩ := OriginalSylow.borel_backwardShift hms e hz hk hb u hR p
  obtain ⟨r,hre⟩ := OriginalSylow.borel_backwardShift hms e hz hk hb u hR q.path
  obtain ⟨t,hte⟩ := OriginalSylow.borel_backwardShift hms e hz hk hb u hR r.path
  have hline := OriginalSylow.borel_three_shift_line_omega hms e hz hk hb u hR p q r t
  have hmove := OriginalSylow.borel_three_shift_core_movement hms e hz hk hb u hR p q r t
  have hrest := OriginalSylow.borel_three_shift_restricted_core_movement hms e hz hk hb u hR p q r t
  exact ⟨q,r,t,hqe,hre,hte,hline.1,hline.2,hmove.1,hmove.2.1,hmove.2.2.1,
