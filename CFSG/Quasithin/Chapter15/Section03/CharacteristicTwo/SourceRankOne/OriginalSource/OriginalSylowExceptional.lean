      (¬ v.span ≤ B Rg v.centerVertex ((sourceGeometry hms).Z_normal _)) ∧
      (4 < sourceDistance hms → Z Rg z ≤ Q Rg v.centerVertex ∧ v.span ≤ Q Rg z ∧
        v.seedOrbit ⊔ v.spanOrbit ≤ Q Rg z ∧
        (Q Rg v.endpoint).relIndex (Z Rg (p.walk.getVert 2)) = 2 ∧
        (Q Rg (p.walk.getVert 2)).relIndex (Z Rg v.endpoint) = 2) :=
  OriginalSylow.borel_small_slice_shift_control hms e hz hk
    (Exhaustion.LargeDistance.CubicFull.distance_gt_two hms e hz hk) u hR p hslice

