/-- The original Sylow source reduces to whole-core exhaustion or a Borel
geometry with compatible paths everywhere. Central generation and strict
slices no longer survive as separate path-construction alternatives. The
terminal distance contradictions remain necessary. -/
theorem source_cubic_coreExhaustion_or_borel_paths :
    CoreExhaustion c.L d.S ∨ ∃ hk : layerKernel c.L d.S = extensionKernel hms,
      Function.Surjective (CubicAction.projection hms e hz hk) ∧
      2 < sourceDistance hms ∧
      (∀ a : Vertex Rg, color Rg a = false →
        Nat.card (U Rg a) = 16 ∨ Nat.card (U Rg a) = 32) ∧
      ∃ u : S,
        (Rg).map (CubicAction.projection hms e hz hk) =
          borel.map (MulAut.conj u).toMonoidHom ∧
        (∀ a z (p : CriticalPath Rg (sourceGeometry hms) a z),
      (¬ V Rg a ≤ Q Rg (p.walk.getVert (p.walk.length-2))) ∧
      (∃ d, ∃ w : (cosetGraph Rg).Walk d a,
        ∃ q : CriticalPath Rg (sourceGeometry hms) d (p.walk.getVert (p.walk.length-2)),
          w.length = 2 ∧ q.walk = w.append (p.walk.take (p.walk.length-2)) ∧
          ∀ i ≤ p.walk.length-2, q.walk.getVert (i+2) = p.walk.getVert i) ∧
      (∃ d, ∃ q : CriticalPath Rg (sourceGeometry hms) (p.walk.getVert 2) d,
        q.walk.getVert 1 = p.walk.getVert 1 ∧ q.walk.getVert 2 = a) ∧
      ¬ U Rg (p.walk.getVert 2) ≤ B Rg a ((sourceGeometry hms).Z_normal _)) := by
  rcases source_cubic_coreExhaustion_or_borel s hm e hz with
    hex | ⟨hk,hs,hb,hcovers,u,hR⟩
  · exact Or.inl hex
  · exact Or.inr ⟨hk,hs,hb,hcovers,u,hR,
      fun _ _ p => OriginalSylow.borel_critical_paths hms e hz hk u hR p⟩

/-- The original Borel small slice supplies the entire shifted span and
its order-two central line for either critical image size. Above distance
