      act Rg t.transporter (r.path.walk.getVert 1) = t.edge ∧
      let z := q.path.walk.getVert (q.path.walk.length-2)
      let v := r.path.walk.getVert (r.path.walk.length-2)
      let K₀ := Z Rg t.start ⊓ Q Rg v
      let N := K₀ ⊔ Z Rg r.start
      let H := ⁅K₀,Z Rg z ⊓ Q Rg r.start⁆
      let D := ⁅Z Rg t.start,Z Rg v⁆
      let I := (H ⊔ D) ⊓ Z Rg t.edge
      K₀.relIndex (Z Rg t.start) = 2 ∧
      (¬ K₀ ≤ B Rg r.start ((sourceGeometry hms).Z_normal _)) ∧
      edgeOffenderJoin t.start t.edge ≤ normalizer (N : Set (FreeAmalgam Rg)) ∧
      X Rg z ⊓ Q Rg r.start ≤ normalizer (K₀ : Set (FreeAmalgam Rg)) ∧
      (¬ Ltilde Rg r.start ≤ normalizer (N : Set (FreeAmalgam Rg))) ∧
      H ⊔ D ≤ V Rg z ∧ H ⊔ D ≤ Z Rg t.start ∧
      I ≤ centralizer (stabilizer Rg r.start : Set (FreeAmalgam Rg)) ∧
      I ≤ centralizer (stabilizer Rg q.start : Set (FreeAmalgam Rg)) ∧
      I = (H ⊔ D) ⊓ centralizer (stabilizer Rg t.start : Set (FreeAmalgam Rg)) ∧
      D ⊓ I = ⊥ ∧
      ((Z Rg z ≤ normalizer (N : Set (FreeAmalgam Rg)) ∧
        Q Rg r.start ≤ edgeOffenderJoin t.start t.edge ∧
        (X Rg r.start = U Rg r.start ⊔
          (X Rg r.start ⊓ centralizer (stabilizer Rg r.start : Set (FreeAmalgam Rg))) →
          edgeOffenderJoin r.start t.edge = edgeOffenderJoin t.start t.edge)) ∨
       ((¬ Z Rg z ≤ normalizer (N : Set (FreeAmalgam Rg))) ∧
        Nat.card H = 2 ∧ H ≤ K₀ ∧
        ∀ w : Vertex Rg, color Rg w = false →
          X Rg w = U Rg w ⊔
            (X Rg w ⊓ centralizer (stabilizer Rg w : Set (FreeAmalgam Rg))) ∧
          X Rg w = Z Rg w)) := by
  obtain ⟨q,hqe⟩ := OriginalSylow.borel_backwardShift hms e hz hk hb u hR p
  obtain ⟨r,hre⟩ := OriginalSylow.borel_backwardShift hms e hz hk hb u hR q.path
  obtain ⟨t,hte⟩ := OriginalSylow.borel_backwardShift hms e hz hk hb u hR r.path
  have hK := OriginalSylow.borel_three_shift_restricted_kernel hms e hz hk hb u hR p q r t
  have hM := OriginalSylow.borel_three_shift_mover_comparison hms e hz hk hb u hR p q r t
  have hI := OriginalSylow.borel_three_shift_kernel_intersection_central hms e hz hk hb u hR p q r t
  refine ⟨q,r,t,hqe,hre,hte,hK.1,hK.2.1,hK.2.2.1,hK.2.2.2.1,hM.1,
    hI.1,hI.2.1,hI.2.2.1,hI.2.2.2.1,hI.2.2.2.2.1,hI.2.2.2.2.2,?_⟩
  by_cases hnZ : Z Rg (q.path.walk.getVert (q.path.walk.length-2)) ≤ normalizer
      (((Z Rg t.start ⊓ Q Rg (r.path.walk.getVert (r.path.walk.length-2))) ⊔
        Z Rg r.start : Subgroup (FreeAmalgam Rg)) : Set (FreeAmalgam Rg))
  · exact Or.inl ⟨hnZ,hM.2 hnZ⟩
  · exact Or.inr ⟨hnZ,hK.2.2.2.2 hnZ⟩


