theorem source_borel_four_midpoint_core_at
    {a z : Vertex Rg} (p : CriticalPath Rg (sourceGeometry hms) a z) :
    (Q Rg a).relIndex (Q Rg (p.walk.getVert 2)) = 4 ∧
      Q Rg (p.walk.getVert 2) = (Q Rg (p.walk.getVert 2) ⊓ Q Rg a) ⊔ Z Rg z ∧
      ⁅Z Rg a,Q Rg (p.walk.getVert 2)⁆ = ⁅Z Rg a,Z Rg z⁆ :=
  OriginalSylow.borel_four_midpoint_core_at hms e hz hk u hR p

/-- On c.L,d.S there exists an original critical path whose entire midpoint
two-core has the even endpoint image, the full intersection factorization,
and exactly the critical commutator on the starting seed. No path-selection
premise is required. -/
theorem source_borel_four_even_midpoint_core_configuration :
    ∃ z, ∃ p : CriticalPath Rg (sourceGeometry hms) (alpha Rg) z,
      CubicAction.graphImage hms e hz hk (Q Rg (p.walk.getVert 2)) =
        CubicAction.graphImage hms e hz hk (Z Rg z) ∧
      Q Rg (p.walk.getVert 2) ≤ Ltilde Rg (alpha Rg) ⊔ Q Rg (alpha Rg) ∧
      (Q Rg (alpha Rg)).relIndex (Q Rg (p.walk.getVert 2)) = 4 ∧
      Q Rg (p.walk.getVert 2) =
        (Q Rg (p.walk.getVert 2) ⊓ Q Rg (alpha Rg)) ⊔ Z Rg z ∧
      ⁅Z Rg (alpha Rg),Q Rg (p.walk.getVert 2)⁆ = ⁅Z Rg (alpha Rg),Z Rg z⁆ := by
  obtain ⟨z,p,_⟩ := OriginalSylow.borel_four_exists_large_critical hms e hz hk u hR
  exact ⟨z,p,(source_borel_four_midpoint_core_image s hm e hz hk u hR p).1,
    OriginalSylow.borel_four_midpoint_core_residual_core hms e hz hk u hR p,
    source_borel_four_midpoint_core_at s hm e hz hk u hR p⟩


open Representation Representation.BinaryOffender LargeDistance.CubicFull
open scoped IsMulCommutative

/-- Both opposed full spans on the literal original graph have index four modulo the opposite core and satisfy the source cross-kernel commutator bounds. -/
theorem source_borel_four_opposed_spans
    {z : Vertex Rg} (p : CriticalPath Rg (sourceGeometry hms) (alpha Rg) z) :
    let a := alpha Rg
    let c := p.walk.getVert 2
    let P₁ := localZSpan Rg c a
    let P₂ := localZSpan Rg a c
    (Q Rg c).relIndex P₁ = 4 ∧ (Q Rg a).relIndex P₂ = 4 ∧
      ⁅P₁,Q Rg a⁆ ≤ Z Rg c ∧ ⁅P₂,Q Rg c⁆ ≤ Z Rg a ∧
      ⁅P₁ ⊓ Q Rg c,P₂⁆ ≤ Z Rg a ∧
      ⁅P₂ ⊓ Q Rg a,P₁⁆ ≤ Z Rg c :=
  OriginalSylow.borel_four_opposed_spans hms e hz hk u hR p

/-- The whole opposite span has the conjugate even three-pair image under the literal original cubic projection. -/
theorem source_borel_four_opposed_span_image
    {z : Vertex Rg} (p : CriticalPath Rg (sourceGeometry hms) (alpha Rg) z) :
    ∃ v : S, CubicAction.graphImage hms e hz hk
      (localZSpan Rg (alpha Rg) (p.walk.getVert 2)) = D0.map (MulAut.conj v).toMonoidHom :=
  OriginalSylow.borel_four_opposed_span_image hms e hz hk u hR p

/-- The entire opposite span has fixed codimension two on the original forward span modulo its own center, retaining the cubic kernel. -/
theorem source_borel_four_opposed_span_fixed_codim_eq_two
    {z : Vertex Rg} (p : CriticalPath Rg (sourceGeometry hms) (alpha Rg) z) :
    let c := p.walk.getVert 2
    letI := selected_span_central_quotient_elementary hms e hz hk
      (distance_gt_two hms e hz hk) c (by
        rw [SimpleGraph.dist_comm,p.dist_start (by
          have hl := p.length_eq_b.trans (OriginalSylow.borel_distance_eq_four hms e hz hk u hR)
          omega)])
    fixedCodim (Offenders.linearize (forwardSpanCentralAction Rg c))
      ((localZSpan Rg (alpha Rg) c).comap (embedM Rg)) = 2 :=
  OriginalSylow.borel_four_opposed_span_fixed_codim_eq_two hms e hz hk u hR p

/-- Construct an actual critical path on c.L,d.S with both whole-span
indices four, the full opposite even image and its exact fixed codimension.
No chosen-path or terminal premise is required. -/
theorem source_borel_four_opposed_span_configuration :
    ∃ z, ∃ p : CriticalPath Rg (sourceGeometry hms) (alpha Rg) z, ∃ v : S,
      CubicAction.graphImage hms e hz hk
        (localZSpan Rg (alpha Rg) (p.walk.getVert 2)) = D0.map (MulAut.conj v).toMonoidHom ∧
      (Q Rg (p.walk.getVert 2)).relIndex
        (localZSpan Rg (p.walk.getVert 2) (alpha Rg)) = 4 ∧
      (Q Rg (alpha Rg)).relIndex
        (localZSpan Rg (alpha Rg) (p.walk.getVert 2)) = 4 ∧
      letI := selected_span_central_quotient_elementary hms e hz hk
        (distance_gt_two hms e hz hk) (p.walk.getVert 2) (by
          rw [SimpleGraph.dist_comm,p.dist_start (by
            have hl := p.length_eq_b.trans (OriginalSylow.borel_distance_eq_four hms e hz hk u hR)
            omega)])
      fixedCodim (Offenders.linearize (forwardSpanCentralAction Rg (p.walk.getVert 2)))
        ((localZSpan Rg (alpha Rg) (p.walk.getVert 2)).comap (embedM Rg)) = 2 := by
  obtain ⟨z,p,_⟩ := OriginalSylow.borel_four_exists_large_critical hms e hz hk u hR
  obtain ⟨v,hv⟩ := source_borel_four_opposed_span_image s hm e hz hk u hR p
  have hi := source_borel_four_opposed_spans s hm e hz hk u hR p
  exact ⟨z,p,v,hv,hi.1,hi.2.1,
    source_borel_four_opposed_span_fixed_codim_eq_two s hm e hz hk u hR p⟩


/-- On the original c.L,d.S graph, Baumann is exactly the centralizer of
its moving radius inside the whole radius. -/
theorem source_borel_four_baumann_eq_radius_centralizer :
    B Rg (alpha Rg) ((sourceGeometry hms).Z_normal _) =
      V Rg (alpha Rg) ⊓ centralizer (Vcirc Rg (alpha Rg) : Set (FreeAmalgam Rg)) :=
  OriginalSylow.borel_four_baumann_eq_radius_centralizer hms e hz hk u hR

/-- The original Baumann subgroup cuts out exactly the intrinsic center
of the full moving radius. -/
theorem source_borel_four_moving_baumann_eq_center :
    (B Rg (alpha Rg) ((sourceGeometry hms).Z_normal _)).subgroupOf
      (Vcirc Rg (alpha Rg)) = center (Vcirc Rg (alpha Rg)) :=
  OriginalSylow.borel_four_moving_baumann_eq_center hms e hz hk u hR

/-- The center of each whole selected source span lies in the actual
Baumann subgroup, with its full central attachment retained. -/
theorem source_borel_four_span_center_le_baumann
    {z : Vertex Rg} (p : CriticalPath Rg (sourceGeometry hms) (alpha Rg) z) :
    let P := localZSpan Rg (p.walk.getVert 2) (alpha Rg)
    (center P).map P.subtype ≤ B Rg (alpha Rg) ((sourceGeometry hms).Z_normal _) :=
  OriginalSylow.borel_four_span_center_le_baumann hms e hz hk u hR p

/-- The whole opposite actor on c.L,d.S fixes a subgroup of index at most
four in the forward span modulo the literal Baumann subgroup. -/
theorem source_borel_four_opposed_span_baumann_fixed_index
    {z : Vertex Rg} (p : CriticalPath Rg (sourceGeometry hms) (alpha Rg) z) :
    let a := alpha Rg
    let c := p.walk.getVert 2
    let P := (localZSpan Rg c a).comap (embedM Rg)
    let A := (localZSpan Rg a c).comap (embedM Rg)
    let D := (B Rg a ((sourceGeometry hms).Z_normal _)).comap (embedM Rg)
    letI := OriginalSylow.baumann_preimage_normal hms (distance_gt_two hms e hz hk)
    (centralizerModulo P A D).relIndex P ≤ 4 :=
  OriginalSylow.borel_four_opposed_span_baumann_fixed_index hms e hz hk u hR p

