open ChapterA.Section05To06 RankOneConfiguration SmallExtension MarkedMS
open AlternatingSixReconstruction.Exceptional AlternatingSixReconstruction.Exceptional.Exhaustion
universe u
variable {G : Type u} [Group G] [Finite G]
  {d : LocalData G} {I : Subgroup G} {c : ComponentWitness d I}
  (s : SourceData KnownSimple.IsKnownSimple d c)
  (hm : Parabolics.SmallParabolicMarking d I c.L)
  (e : CentralMarking c.L)
  (hz : Nat.card (center (c.L ⧸ pCore 2 c.L)) = 3)
local notation "hms" => source_smallMSPair s hm
local notation "Rg" => edge c.L d.S
local notation "K" => c.L.subgroupOf (c.L ⊔ d.S)

/-- The original source supplies generating edges in every surviving Borel
critical-path case, with displacement of each full small critical kernel. -/
theorem source_cubic_coreExhaustion_or_borel_generating_edges :
    CoreExhaustion c.L d.S ∨ ∃ hk : layerKernel c.L d.S = extensionKernel hms,
      Function.Surjective (CubicAction.projection hms e hz hk) ∧
      2 < sourceDistance hms ∧
      (∀ a : Vertex Rg, color Rg a = false →
        Nat.card (U Rg a) = 16 ∨ Nat.card (U Rg a) = 32) ∧
      ∃ u : S,
        (Rg).map (CubicAction.projection hms e hz hk) =
          borel.map (MulAut.conj u).toMonoidHom ∧
        ∀ a z : Vertex Rg, ∀ _p : CriticalPath Rg (sourceGeometry hms) a z,
          ∃ t, Adjacent Rg a t ∧ Q Rg t ⊔ Z Rg z = stabilizer Rg a ∧
            ((Q Rg z).relIndex (Z Rg a) < 4 →
              ¬ Q Rg t ≤ normalizer
                ((Z Rg a ⊓ Q Rg z : Subgroup (FreeAmalgam Rg)) : Set (FreeAmalgam Rg))) :=
  OriginalSylow.coreExhaustion_or_borel_generating_edges hms
    (source_smallMSPair_original_sylow s) e hz

/-- The same constructed Borel geometry feeds the unchanged C.1.32 consumer
whenever exhaustion occurs; the genuine Borel alternative remains explicit. -/
theorem source_cubic_rankTwo_or_borel_generating_edges :
    RankTwoAlternatives c.L d.S ∨ ∃ hk : layerKernel c.L d.S = extensionKernel hms,
      Function.Surjective (CubicAction.projection hms e hz hk) ∧
      2 < sourceDistance hms ∧
      (∀ a : Vertex Rg, color Rg a = false →
        Nat.card (U Rg a) = 16 ∨ Nat.card (U Rg a) = 32) ∧
      ∃ u : S,
        (Rg).map (CubicAction.projection hms e hz hk) =
          borel.map (MulAut.conj u).toMonoidHom ∧
        ∀ a z : Vertex Rg, ∀ _p : CriticalPath Rg (sourceGeometry hms) a z,
          ∃ t, Adjacent Rg a t ∧ Q Rg t ⊔ Z Rg z = stabilizer Rg a ∧
            ((Q Rg z).relIndex (Z Rg a) < 4 →
              ¬ Q Rg t ≤ normalizer
                ((Z Rg a ⊓ Q Rg z : Subgroup (FreeAmalgam Rg)) : Set (FreeAmalgam Rg))) :=
  (source_cubic_coreExhaustion_or_borel_generating_edges s hm e hz).imp
    (rankTwo_of_exhaustion hms e hz) id

/-- On the literal original source, every surviving Borel edge has a
strict two-edge Baumann slice. The original Sylow witness excludes the plane
image, and constructed compatible choices discharge all path premises.
The remaining strict-slice contradiction is still needed for exhaustion. -/
theorem source_cubic_coreExhaustion_or_borel_strict_slices :
    CoreExhaustion c.L d.S ∨ ∃ hk : layerKernel c.L d.S = extensionKernel hms,
      Function.Surjective (CubicAction.projection hms e hz hk) ∧
      sourceDistance hms = 4 ∧
      (∀ a : Vertex Rg, color Rg a = false →
        Nat.card (U Rg a) = 16 ∨ Nat.card (U Rg a) = 32) ∧
      ∃ u : S,
        (Rg).map (CubicAction.projection hms e hz hk) =
          borel.map (MulAut.conj u).toMonoidHom ∧
        ∀ a t : Vertex Rg, color Rg a = false → Adjacent Rg a t →
          ∃ v : Vertex Rg, Adjacent Rg v t ∧
            2 < (B Rg a ((sourceGeometry hms).Z_normal _)).relIndex (U Rg v) := by
  rcases source_cubic_coreExhaustion_or_borel_generating_edges s hm e hz with
    hex | ⟨hk,hs,_,hcovers,u,hR,_⟩
  · exact Or.inl hex
  · exact Or.inr ⟨hk,hs,OriginalSylow.borel_distance_eq_four hms e hz hk u hR,
      hcovers,u,hR,fun _ _ ha hat =>
        OriginalSylow.borel_four_strict_slice_at_edge hms e hz hk u hR ha hat⟩

variable (hk : layerKernel c.L d.S = extensionKernel (source_smallMSPair s hm))
  (u : S)
  (hR : (edge c.L d.S).map (CubicAction.projection (source_smallMSPair s hm) e hz hk) =
    borel.map (MulAut.conj u).toMonoidHom)

include s hm e hz hk u hR

/-- The comparison used in the distinct-choice branch of source (5.5), on the original graph and
full moving covers: two Thompson choices generate the edge and their
cross-fixed indices are greater than four. -/
theorem source_borel_distinct_thompson_comparison
    {a b t : Vertex Rg} (ha : color Rg a = false) (hb : color Rg b = false)
    (hat : Adjacent Rg a t) (hbt : Adjacent Rg b t)
    (hne : edgeOffenderJoin a t ≠ edgeOffenderJoin b t) :
    edgeOffenderJoin a t ⊔ edgeOffenderJoin b t = Q Rg t ∧
      (edgeOffenderJoin a t ⊓ edgeOffenderJoin b t).relIndex (Q Rg t) = 4 ∧
      4 < (centralizer (edgeOffenderJoin b t : Set (FreeAmalgam Rg))).relIndex (U Rg a) ∧
      4 < (centralizer (edgeOffenderJoin a t : Set (FreeAmalgam Rg))).relIndex (U Rg b) := by
  rcases OriginalSylow.borel_adjacent_thompson_comparison hms e hz hk u hR ha hb hat hbt with
    he | ⟨hgen,_,_,hindex,_,_,hfixa,hfixb⟩
  · exact (hne he).elim
  · exact ⟨hgen,hindex,hfixa,hfixb⟩

/-- The actual original edge supplies the conjugator; both the full kernel
and its critical line move along the same transported critical path. -/
theorem source_borel_small_critical_edge_displacement
    {a z : Vertex Rg} (p : CriticalPath Rg (sourceGeometry hms) a z)
    (hsmall : (Q Rg z).relIndex (Z Rg a) < 4) :
    ∃ t, Adjacent Rg a t ∧ Q Rg t ⊔ Z Rg z = stabilizer Rg a ∧
      ∃ g ∈ Q Rg t, act Rg g t = t ∧
      ∃ q : CriticalPath Rg (sourceGeometry hms) a (act Rg g z),
        (∀ i, q.walk.getVert i = act Rg g (p.walk.getVert i)) ∧
        (Q Rg (act Rg g z)).relIndex (Z Rg a) = 2 ∧
        Z Rg a ⊓ Q Rg (act Rg g z) ≠ Z Rg a ⊓ Q Rg z ∧
        ⁅Z Rg a,Z Rg (act Rg g z)⁆ ≠ ⁅Z Rg a,Z Rg z⁆ :=
  OriginalSylow.borel_small_critical_edge_displacement hms e hz hk u hR p hsmall


/-- Distinct quadratic Thompson choices have exact fixed index eight on the
original full moving cover; their fixed subgroup on the full seed is exactly
the original edge seed, including its central attachment. -/
theorem source_borel_distinct_thompson_fixed
    {a b t : Vertex Rg} (ha : color Rg a = false) (hb : color Rg b = false)
    (hat : Adjacent Rg a t) (hbt : Adjacent Rg b t)
    (hne : edgeOffenderJoin a t ≠ edgeOffenderJoin b t) :
    (centralizer (Q Rg t : Set (FreeAmalgam Rg))).relIndex (U Rg a) = 8 ∧
      (centralizer (edgeOffenderJoin b t : Set (FreeAmalgam Rg))).relIndex (U Rg a) = 8 ∧
      U Rg a ⊓ centralizer (edgeOffenderJoin b t : Set (FreeAmalgam Rg)) =
        U Rg a ⊓ centralizer (Q Rg t : Set (FreeAmalgam Rg)) ∧
      Z Rg a ⊓ centralizer (edgeOffenderJoin b t : Set (FreeAmalgam Rg)) = Z Rg t :=
  ⟨OriginalSylow.borel_edge_fixed_index hms e hz hk u hR ha hat,
    OriginalSylow.borel_cross_thompson_fixed_index_eq_eight hms e hz hk u hR ha hb hat hbt hne,
    OriginalSylow.borel_cross_thompson_moving_fixed hms e hz hk u hR ha hb hat hbt hne,
    OriginalSylow.borel_cross_thompson_seed_fixed hms e hz hk u hR ha hb hat hbt hne⟩

omit hk u hR in
/-- Original Sylow eliminates the plane case and constructs the paired selectors
in every surviving small critical-image case. These are conclusions on the
actual source graph; no selector or terminal premise is added. -/
theorem source_cubic_coreExhaustion_or_borel_seed_selectors :
    CoreExhaustion c.L d.S ∨ ∃ hk : layerKernel c.L d.S = extensionKernel hms,
      Function.Surjective (CubicAction.projection hms e hz hk) ∧
      2 < sourceDistance hms ∧
      (∀ a : Vertex Rg, color Rg a = false →
        Nat.card (U Rg a) = 16 ∨ Nat.card (U Rg a) = 32) ∧
      ∃ u : S,
        (Rg).map (CubicAction.projection hms e hz hk) =
          borel.map (MulAut.conj u).toMonoidHom ∧
        ∀ z : Vertex Rg, ∀ p : CriticalPath Rg (sourceGeometry hms) (alpha Rg) z,
          (Q Rg z).relIndex (Z Rg (alpha Rg)) < 4 →
          ∃ t, Adjacent Rg (alpha Rg) t ∧ ∃ r ∈ K,
            let x := (embedM Rg r)⁻¹
            let J := edgeOffenderJoin (alpha Rg) t
            let J' := edgeOffenderJoin (alpha Rg) (act Rg x t)
            let b := p.walk.getVert 1
            (J ⊔ Z Rg z) ⊔ Z Rg (act Rg x z) = stabilizer Rg (alpha Rg) ∧
              J ⊔ J' = stabilizer Rg (alpha Rg) ∧
              Q Rg b ⊔ J = stabilizer Rg (alpha Rg) ∧
              Q Rg b ⊔ J' = stabilizer Rg (alpha Rg) ∧
              Q Rg t ⊔ Z Rg z = stabilizer Rg (alpha Rg) ∧
              Q Rg (act Rg x t) ⊔ Z Rg z = stabilizer Rg (alpha Rg) ∧
              Z Rg b ⊓ centralizer (J : Set (FreeAmalgam Rg)) ≤
                centralizer (stabilizer Rg (alpha Rg) : Set (FreeAmalgam Rg)) ∧
              Z Rg b ⊓ centralizer (J' : Set (FreeAmalgam Rg)) ≤
                centralizer (stabilizer Rg (alpha Rg) : Set (FreeAmalgam Rg)) ∧
              x ∈ normalizer (edgeOffenderJoin (alpha Rg) b : Set (FreeAmalgam Rg)) ∧
              Z Rg z ⊔ Z Rg (act Rg x z) ≤ edgeOffenderJoin (alpha Rg) b ∧
              ⁅⁅Z Rg (alpha Rg),Z Rg z ⊔ Z Rg (act Rg x z)⁆,
                edgeOffenderJoin (alpha Rg) b⁆ = ⊥ := by
  rcases source_cubic_coreExhaustion_or_borel s hm e hz with
    hex | ⟨hk,hs,hb,hcovers,u,hR⟩
  · exact Or.inl hex
  · exact Or.inr ⟨hk,hs,hb,hcovers,u,hR,fun _ p hsmall =>
      OriginalSylow.borel_small_critical_seed_selectors hms e hz hk u hR p hsmall⟩


/-- The original source's opposite Thompson mover generates the local
residual with the actual opposite seed whenever it omits the starting core. -/
theorem source_borel_opposite_generation_of_core_not_le
    {a v t : Vertex Rg} (ha : color Rg a = false) (hv : color Rg v = false)
    (hat : Adjacent Rg a t) (hvt : Adjacent Rg v t)
    (A : Subgroup (FreeAmalgam Rg))
    (hgen : Q Rg t ⊔ A = stabilizer Rg a)
    (hnot : ¬ Q Rg a ≤ edgeOffenderJoin v t) :
    (edgeOffenderJoin v t ⊔ A).relIndex (stabilizer Rg a) ≤ 2 ∧
      Ltilde Rg a ≤ edgeOffenderJoin v t ⊔ A :=
  OriginalSylow.borel_opposite_generation_of_core_not_le hms e hz hk u hR
    ha hv hat hvt A hgen hnot

/-- Literal original-source application of the paired opposite-mover
comparison. The unresolved core-containing branch remains explicit. -/
theorem source_borel_small_critical_opposite_selectors
    {z : Vertex Rg} (p : CriticalPath Rg (sourceGeometry hms) (alpha Rg) z)
    (hsmall : (Q Rg z).relIndex (Z Rg (alpha Rg)) < 4)
    {v : Vertex Rg} (hc : color Rg v = false)
    (hcb : Adjacent Rg v (p.walk.getVert 1))
    (hne : edgeOffenderJoin (alpha Rg) (p.walk.getVert 1) ≠
      edgeOffenderJoin v (p.walk.getVert 1)) :
    ∃ t, Adjacent Rg (alpha Rg) t ∧
      ∃ r ∈ K,
        let x := (embedM Rg r)⁻¹
        let J := edgeOffenderJoin (alpha Rg) t
        let J' := edgeOffenderJoin (alpha Rg) (act Rg x t)
        ∃ g ∈ stabilizer Rg (alpha Rg),
          act Rg g (p.walk.getVert 1) = t ∧
          (J ⊔ Z Rg z) ⊔ Z Rg (act Rg x z) = stabilizer Rg (alpha Rg) ∧
          J ⊔ J' = stabilizer Rg (alpha Rg) ∧
          Q Rg t ⊔ Z Rg z = stabilizer Rg (alpha Rg) ∧
          Q Rg (act Rg x t) ⊔ Z Rg z = stabilizer Rg (alpha Rg) ∧
          Z Rg (p.walk.getVert 1) ⊓ centralizer (J : Set (FreeAmalgam Rg)) ≤
            centralizer (stabilizer Rg (alpha Rg) : Set (FreeAmalgam Rg)) ∧
          Z Rg (p.walk.getVert 1) ⊓ centralizer (J' : Set (FreeAmalgam Rg)) ≤
