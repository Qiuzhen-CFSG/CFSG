      let d := act Rg g (t.path.walk.getVert (t.path.walk.length-1))
      let c := act Rg g (t.path.walk.getVert (t.path.walk.length-2))
      Q Rg d ⊔ Z Rg t.start = stabilizer Rg v ∧
