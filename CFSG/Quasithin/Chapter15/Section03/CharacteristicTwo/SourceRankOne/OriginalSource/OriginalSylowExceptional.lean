theorem source_borel_terminal_core_movement
    (hb : 4 < sourceDistance hms)
    {a a' : Vertex Rg} (p : CriticalPath Rg (sourceGeometry hms) a a') :
    ∃ (q : OriginalSylow.BorelBackwardShift (h := hms) p)
