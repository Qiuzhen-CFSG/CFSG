/-- On the literal original-Sylow source, every small forward slice above
distance four has a nonzero quadratic full reverse-kernel commutator.
Either the whole seed orbit joined to the second seed is locally normal,
or an actual conjugate seed realizes its order-two line and places the
entire reverse kernel inside the corresponding proper Thompson mover.
Excluding the normal alternative and proving full local centrality of the
line remain necessary for MS93 (5.9). -/
theorem source_borel_small_slice_orbit_alternative
    (hb : 4 < sourceDistance hms)
    {z : Vertex Rg} (p : CriticalPath Rg (sourceGeometry hms) (alpha Rg) z)
    (hslice : (B Rg (alpha Rg) ((sourceGeometry hms).Z_normal _)).relIndex
      (U Rg (p.walk.getVert 2)) ≤ 2) :
    ∃ v : Exhaustion.LargeDistance.CubicFull.SmallSliceShift hms p,
      v.orbitDisplacement ≠ ⊥ ∧
      v.orbitDisplacement ≤ v.seedOrbit ⊓ v.orbitKernel ∧
      ⁅v.orbitDisplacement,v.seedOrbit⁆ = ⊥ ∧
      ((stabilizer Rg (p.walk.getVert 2) ≤ normalizer
          ((v.seedOrbit ⊔ Z Rg (p.walk.getVert 2) : Subgroup (FreeAmalgam Rg)) :
            Set (FreeAmalgam Rg))) ∨
        (Nat.card v.orbitDisplacement = 2 ∧
          ∃ x ∈ v.lineCentralizer, ∃ t : Vertex Rg,
            Adjacent Rg (act Rg x⁻¹ v.centerVertex) t ∧
            Adjacent Rg (p.walk.getVert 2) t ∧
            ⁅Z Rg (act Rg x⁻¹ v.centerVertex),v.orbitKernel⁆ = v.orbitDisplacement ∧
            v.orbitKernel ≤ edgeOffenderJoin (act Rg x⁻¹ v.centerVertex) t ∧
            v.orbitDisplacement ≤ centralizer
              (edgeOffenderJoin (act Rg x⁻¹ v.centerVertex) t : Set (FreeAmalgam Rg)))) := by
  obtain ⟨v,_⟩ := source_borel_small_slice_shift_control s hm e hz hk u hR p hslice
  have hf := v.borel_orbit_displacement_nonzero_quadratic e hz hk hb u hR hslice
  refine ⟨v,hf.1,hf.2.1,hf.2.2,?_⟩
  rcases v.borel_orbit_normalized_or_line e hz hk hb u hR hslice with hn | ⟨hl,_⟩
  · exact Or.inl hn
  · exact Or.inr ⟨hl,v.borel_orbit_line_mover e hz hk hb u hR hl⟩

/-- The literal original-Sylow Borel orbit has an order-two reverse-kernel
commutator. The controlled alternative is excluded by nilpotent collapse
and the actual Baumann-slice escape. An actual conjugate seed realizes
the line and its proper Thompson mover contains the whole reverse kernel.
Full-stabilizer centrality and the terminal source exclusions remain open. -/
theorem source_borel_small_slice_orbit_line
    (hb : 4 < sourceDistance hms)
    {z : Vertex Rg} (p : CriticalPath Rg (sourceGeometry hms) (alpha Rg) z)
    (hslice : (B Rg (alpha Rg) ((sourceGeometry hms).Z_normal _)).relIndex
      (U Rg (p.walk.getVert 2)) ≤ 2) :
    ∃ v : Exhaustion.LargeDistance.CubicFull.SmallSliceShift hms p,
      Nat.card v.orbitDisplacement = 2 ∧
      v.orbitDisplacement ≤ v.seedOrbit ⊓ v.orbitKernel ∧
      ⁅v.orbitDisplacement,v.seedOrbit⁆ = ⊥ ∧
      ∃ x ∈ v.lineCentralizer, ∃ t : Vertex Rg,
        Adjacent Rg (act Rg x⁻¹ v.centerVertex) t ∧
        Adjacent Rg (p.walk.getVert 2) t ∧
        ⁅Z Rg (act Rg x⁻¹ v.centerVertex),v.orbitKernel⁆ = v.orbitDisplacement ∧
        v.orbitKernel ≤ edgeOffenderJoin (act Rg x⁻¹ v.centerVertex) t ∧
        v.orbitDisplacement ≤ centralizer
          (edgeOffenderJoin (act Rg x⁻¹ v.centerVertex) t : Set (FreeAmalgam Rg)) := by
  obtain ⟨v,_⟩ := source_borel_small_slice_shift_control s hm e hz hk u hR p hslice
  have hf := v.borel_orbit_displacement_nonzero_quadratic e hz hk hb u hR hslice
  have hl := v.borel_orbit_displacement_card_two e hz hk hb u hR hslice
  exact ⟨v,hl,hf.2.1,hf.2.2,v.borel_orbit_line_mover e hz hk hb u hR hl⟩

/-- The original source keeps its two different whole orbits. The span
orbit fixes the seed orbit's order-two displacement, but its own full
reverse-kernel displacement escapes that line. Thus their combined
commutator has order greater than two. This rules out transferring the
point-core whole-orbit bound to the remaining Borel branch. -/
theorem source_borel_small_slice_whole_span_displacement
    (hb : 4 < sourceDistance hms)
    {z : Vertex Rg} (p : CriticalPath Rg (sourceGeometry hms) (alpha Rg) z)
    (hslice : (B Rg (alpha Rg) ((sourceGeometry hms).Z_normal _)).relIndex
      (U Rg (p.walk.getVert 2)) ≤ 2) :
    ∃ v : Exhaustion.LargeDistance.CubicFull.SmallSliceShift hms p,
      Nat.card v.orbitDisplacement = 2 ∧
      v.spanOrbit ≤ normalizer (v.orbitKernel : Set (FreeAmalgam Rg)) ∧
      v.orbitDisplacement ≤ centralizer (v.spanOrbit : Set (FreeAmalgam Rg)) ∧
      (¬ ⁅v.spanOrbit,v.orbitKernel⁆ ≤ v.orbitDisplacement) ∧
      v.orbitDisplacement < ⁅v.seedOrbit ⊔ v.spanOrbit,v.orbitKernel⁆ ∧
      2 < Nat.card (⁅v.seedOrbit ⊔ v.spanOrbit,v.orbitKernel⁆ : Subgroup (FreeAmalgam Rg)) := by
  obtain ⟨v,_⟩ := source_borel_small_slice_shift_control s hm e hz hk u hR p hslice
  have hline := v.borel_orbit_displacement_card_two e hz hk hb u hR hslice
  have hfix := v.borel_spanOrbit_kernel_normalizes_and_line_fixed e hz hk hb u hR hslice
  exact ⟨v,hline,hfix.1,hfix.2,
    v.borel_spanOrbit_displacement_not_le e hz hk hb u hR hslice,
    v.borel_combined_orbit_displacement_gt_two e hz hk hb u hR hslice⟩


/-- In the literal original-Sylow small-slice countercase, the full omega
layer is centrally generated and equals the whole seed at every component
vertex. The distinct opposite-mover comparison therefore always has the
residual-generation outcome; no extra splitting premise is assumed. -/
theorem source_borel_small_slice_full_omega
    (hb : 4 < sourceDistance hms)
    {z : Vertex Rg} (p : CriticalPath Rg (sourceGeometry hms) (alpha Rg) z)
    (hslice : (B Rg (alpha Rg) ((sourceGeometry hms).Z_normal _)).relIndex
      (U Rg (p.walk.getVert 2)) ≤ 2) :
    (∀ a : Vertex Rg, color Rg a = false →
      X Rg a = U Rg a ⊔
        (X Rg a ⊓ centralizer (stabilizer Rg a : Set (FreeAmalgam Rg))) ∧
      X Rg a = Z Rg a) ∧
    (∀ a v t : Vertex Rg, color Rg a = false → color Rg v = false →
      Adjacent Rg a t → Adjacent Rg v t →
      edgeOffenderJoin a t ≠ edgeOffenderJoin v t →
      ∀ A : Subgroup (FreeAmalgam Rg), Q Rg t ⊔ A = stabilizer Rg a →
        (¬ Q Rg a ≤ edgeOffenderJoin v t) ∧
        (edgeOffenderJoin v t ⊔ A).relIndex (stabilizer Rg a) ≤ 2 ∧
        Ltilde Rg a ≤ edgeOffenderJoin v t ⊔ A) := by
  obtain ⟨v,_⟩ := source_borel_small_slice_shift_control s hm e hz hk u hR p hslice
  refine ⟨fun a ha => ⟨v.borel_small_slice_omega_generation e hz hk hb u hR hslice a ha,
    v.borel_small_slice_omega_eq_seed e hz hk hb u hR hslice a ha⟩,?_⟩
  exact fun a w t ha hw hat hwt hne A hgen =>
    v.borel_small_slice_distinct_mover_residual e hz hk hb u hR hslice ha hw hat hwt hne A hgen

/-- MS93 (5.9) on the literal original c.L,d.S graph. The original Borel
small-slice countercase is excluded for either critical image size. -/
