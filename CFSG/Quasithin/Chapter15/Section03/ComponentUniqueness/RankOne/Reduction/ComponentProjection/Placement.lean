module

public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.RankOne.Reduction.ComponentProjection.Construction
public import Theory.GroupTheory.PResidual.SylowSupplement
public import Theory.GroupTheory.PResidual.PrimeSection

/-!
# Residual placement and equality of the component projection

If a projected subgroup has two-core quotient of order three, its two-core
is in the common Sylow subgroup. A commutator bound then makes the
projection normalize `Y O₂(A)`. Since `Y` is two-perfect, it is the
characteristic two-residual of that join. The normalizer identity places
`A` in `M ∩ I`. Three-element generation puts it in `Y`, and normality,
nontriviality and two-perfectness give equality. Equality does not follow
merely by comparing three-parts of orders.

The lemmas here apply to explicit subgroups. The central-product analysis
must supply their algebraic premises for the canonical projection before
they prove the source containment.

Source: Aschbacher--Smith, combined manuscript (1 March 2004),
15.3.43, the projection paragraph on printed p.1139.
-/

public section

open Subgroup
namespace CFSG.Quasithin.Chapter15.Section03.RankOne.ComponentProjection
variable {G : Type*} [Group G] [Finite G]

/-- A two-perfect group with two-core index three is generated by its
three-elements. The residual property supplies the missing two-part. -/
theorem three_generated_of_core_index {A : Subgroup G}
    (hp : IsPPerfect 2 A) (hi : (pCore 2 A).index = 3) :
    threeResidualIn A = A := by
  have hc : Nat.card (A ⧸ pCore 2 A) = 3 := by rwa [← index_eq_card]
  obtain ⟨a, ha, hgen⟩ := exists_prime_order_sup_pCore_eq_top (G := A)
    (by decide : Nat.Coprime 2 3) hc
  let R := primePowerGenerated 3 A
  have har : a ∈ R := mem_primePowerGenerated_of_pow (n := 1) (by
    simpa only [pow_one, ha] using pow_orderOf_eq_one a)
  have hsup : R ⊔ pCore 2 A = ⊤ := top_unique (hgen ▸ sup_le_sup
    (zpowers_le.mpr har) le_rfl)
  have ht : IsPPerfect 2 (⊤ : Subgroup A) :=
    hp.of_surjective (topEquiv (G := A)).symm.toMonoidHom (topEquiv (G := A)).symm.surjective
  have hR : R = ⊤ := top_unique
    (le_normal_of_isPPerfect_of_le_sup_pGroup (⊤ : Subgroup A) R (pCore 2 A)
      ht pCore_isPGroup hsup.ge)
  change R.map A.subtype = A
  rw [hR, ← MonoidHom.range_eq_map, range_subtype]

omit [Finite G] in
/-- Functoriality of the actual prime-to-three residual. -/
theorem threeResidualIn_mono {A B : Subgroup G} (h : A ≤ B) :
    threeResidualIn A ≤ threeResidualIn B := by
  have hm := map_mono (f := B.subtype)
    (map_primePowerGenerated_le 3 (inclusion h))
  simpa only [threeResidualIn, map_map, subtype_comp_inclusion] using hm

omit [Finite G] in
/-- Residual-normalization places the projected subgroup in the intersection.
The commutator bound is an algebraic condition, not a placement premise. -/
theorem le_intersection_of_projection_core
    {A Y S M I : Subgroup G}
    (hAI : A ≤ I) (hpY : IsPPerfect 2 Y)
    (hSY : S ≤ normalizer (Y : Set G))
    (hN : I ⊓ normalizer (Y : Set G) = M ⊓ I)
    (Q : Sylow 2 A) (hQ : (Q : Subgroup A).map A.subtype = S ⊓ A)
    (hc : ⁅A, Y⁆ ≤ A.pCoreIn 2) : A ≤ M ⊓ I := by
  let R := A.pCoreIn 2
  have hRS : R ≤ S := (pCoreIn_le_sylow A Q).trans (hQ.le.trans inf_le_left)
  have hRY : R ≤ normalizer (Y : Set G) := hRS.trans hSY
  have hAR : A ≤ normalizer (R : Set G) :=
    A.le_normalizer.trans (normalizer_le_normalizer_characteristic_image A (pCore 2 A))
  have hAYR : A ≤ normalizer ((Y ⊔ R : Subgroup G) : Set G) := by
    apply le_normalizer_iff.mpr
    intro a ha y hy
    have hY : Y ≤ (Y ⊔ R).comap (MulAut.conj a).toMonoidHom := by
      intro b hb
      have hh : a * b * a⁻¹ * b⁻¹ ∈ R := hc (commutator_mem_commutator ha hb)
      have hm := (Y ⊔ R).mul_mem ((le_sup_right : R ≤ Y ⊔ R) hh) ((le_sup_left : Y ≤ Y ⊔ R) hb)
      change a * b * a⁻¹ ∈ Y ⊔ R
      simpa only [mul_assoc, inv_mul_cancel, mul_one] using hm
    have hR : R ≤ (Y ⊔ R).comap (MulAut.conj a).toMonoidHom := by
      intro r hr
      exact (le_sup_right : R ≤ Y ⊔ R) ((mem_normalizer_iff.mp (hAR ha) r).mp hr)
    exact sup_le hY hR hy
  have hres := embedded_pResidual_join_pGroup Y R hpY (isPGroup_pCoreIn 2 A) hRY
  have hAY : A ≤ normalizer (Y : Set G) := by
    have hn := hAYR.trans
      (normalizer_le_normalizer_characteristic_image (Y ⊔ R)
        (pResidual 2 (Y ⊔ R : Subgroup G)))
    rwa [hres] at hn
  exact (le_inf hAI hAY).trans hN.le

/-- Once placed in `M ∩ I`, the projection lies in the source residual. -/
theorem le_residual_of_core_index {A Y M I : Subgroup G}
    (hA : A ≤ M ⊓ I) (hp : IsPPerfect 2 A) (hi : (pCore 2 A).index = 3)
    (hres : Y = threeResidualIn (M ⊓ I)) : A ≤ Y := by
  rw [hres, ← three_generated_of_core_index hp hi]
  exact threeResidualIn_mono hA

omit [Finite G] in
/-- A nontrivial normal two-perfect subgroup fills a two-perfect cubic
extension of its two-core. This uses generation, not order comparison alone. -/
theorem eq_of_normal_core_index {A Y : Subgroup G}
    (hAY : A ≤ Y) (hn : Y ≤ normalizer (A : Set G))
    (hpA : IsPPerfect 2 A) (hne : A ≠ ⊥)
    (hpY : IsPPerfect 2 Y) (hi : (pCore 2 Y).index = 3) : A = Y := by
  let N := A.subgroupOf Y
  let : N.Normal := normal_subgroupOf_of_le_normalizer hn
  let q := QuotientGroup.mk' (pCore 2 Y)
  have hc : Nat.card (Y ⧸ pCore 2 Y) = 3 := by rwa [← index_eq_card]
  let : Fact (Nat.card (Y ⧸ pCore 2 Y)).Prime := ⟨hc ▸ Nat.prime_three⟩
  rcases (N.map q).eq_bot_or_eq_top_of_prime_card with hb | ht
  · have hNcore : N ≤ pCore 2 Y := by
      intro a ha
      exact (QuotientGroup.eq_one_iff a).mp
        (mem_bot.mp (hb ▸ mem_map_of_mem q ha))
    have hAcore : A ≤ Y.pCoreIn 2 := by
      intro a ha
      exact ⟨⟨a, hAY ha⟩, hNcore ha, rfl⟩
    have htwo : IsPGroup 2 A := (isPGroup_pCoreIn 2 Y).to_le hAcore
    have hzero := hpA.hom_eq_one_of_isPGroup htwo (MonoidHom.id A)
    exact (hne ((eq_bot_iff_forall A).mpr fun a ha =>
      congrArg Subtype.val (DFunLike.congr_fun hzero (⟨a, ha⟩ : A)))).elim
  · have hsup : N ⊔ pCore 2 Y = ⊤ := by
      have hm := congrArg (Subgroup.comap q) ht
      simpa only [comap_map_eq, q, QuotientGroup.ker_mk', comap_top] using hm
    have hp : IsPPerfect 2 (⊤ : Subgroup Y) :=
      hpY.of_surjective (topEquiv (G := Y)).symm.toMonoidHom (topEquiv (G := Y)).symm.surjective
    have htop : N = ⊤ := top_unique
      (le_normal_of_isPPerfect_of_le_sup_pGroup (⊤ : Subgroup Y) N (pCore 2 Y)
        hp pCore_isPGroup hsup.ge)
    exact le_antisymm hAY (subgroupOf_eq_top.mp htop)

end CFSG.Quasithin.Chapter15.Section03.RankOne.ComponentProjection
