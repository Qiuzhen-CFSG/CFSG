module

public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.RankOne.EvenModels.Basic
public import Theory.GroupTheory.DisjointConjugateCenter

/-!
# Irreducibility of the actual normal four-group

A proper nontrivial subgroup of a four-group has order two. Every element
normalizing such a subgroup centralizes it. Thus the fixed-point-free actor
from 15.3.43(b) excludes every proper nontrivial invariant subgroup of V₂,
even for its full normalizer. The same argument applies to its faithful image
in I/C_I(L); the quotient map preserves order-three generation and the full
commutator action. This is the source premise used by the J₄ plane inspection.

Source: Aschbacher--Smith, 15.3.43(b),(e), printed pp.1139--1140.
-/

public section
open Subgroup
namespace CFSG.Quasithin.Chapter15.Section03.RankOne
variable {G : Type*} [Group G]

/-- A fully moved four-group has no proper nontrivial invariant subgroup for
its full ambient normalizer. -/
theorem fourGroup_normalizer_irreducible {V Y : Subgroup G} [IsKleinFour V]
    (hgen : theta Y = Y) (hnorm : Y ≤ normalizer (V : Set G))
    (hcomm : ⁅V, Y⁆ = V) (B : Subgroup G) (hBV : B ≤ V)
    (hB : normalizer (V : Set G) ≤ normalizer (B : Set G)) :
    B = ⊥ ∨ B = V := by
  classical
  by_cases hb : B = ⊥
  · exact Or.inl hb
  by_cases hv : B = V
  · exact Or.inr hv
  let : Finite V := Nat.finite_of_card_ne_zero
    (by rw [IsKleinFour.card_four]; decide)
  let : Finite B := Finite.of_injective (inclusion hBV) (inclusion_injective hBV)
  have hdiv : Nat.card B ∣ 4 := IsKleinFour.card_four (G := V) ▸ card_dvd_of_le hBV
  have hpos : 0 < Nat.card B := Nat.card_pos
  have hle : Nat.card B ≤ 4 := Nat.le_of_dvd (by decide) hdiv
  have hne1 : Nat.card B ≠ 1 := fun he => hb (Subgroup.card_eq_one.mp he)
  have hne4 : Nat.card B ≠ 4 := by
    intro he
    exact hv (eq_of_le_of_card_ge hBV (by rw [he, IsKleinFour.card_four]))
  have htwo : Nat.card B = 2 := by
    interval_cases h : Nat.card B <;> norm_num at *
  have hc : B ≤ centralizer (Y : Set G) := le_centralizer_iff.mp
    (centralizes_of_normalizes_card_two htwo (hnorm.trans hB))
  exact (hb (bot_unique ((le_inf hBV hc).trans
    (fourGroup_centralizer_eq_bot hgen hnorm hcomm).le))).elim

private theorem theta_image_eq_self {H : Type*} [Group H]
    (f : G →* H) (Y : Subgroup G) (hY : theta Y = Y) :
    theta (Y.map f) = Y.map f := by
  apply le_antisymm (theta_le _) ?_
  conv_lhs => rw [← hY]
  rw [theta, MonoidHom.map_closure, closure_le]
  rintro _ ⟨y, ⟨hy, ho⟩, rfl⟩
  have hd : orderOf (f y) ∣ 3 := ho ▸ orderOf_map_dvd f y
  rcases (Nat.dvd_prime Nat.prime_three).mp hd with he | he
  · rw [orderOf_eq_one_iff.mp he]
    exact one_mem _
  · exact subset_closure ⟨mem_map_of_mem f hy, he⟩

/-- The original source actor remains generated by order-three elements under
the literal component action quotient. -/
theorem ReducedConfiguration.image_actor_theta {Yplus S M I L V₁ V₂ : Subgroup G}
    (c : ReducedConfiguration Yplus S M I L V₁ V₂) :
    theta (c.toComponentAction.image Yplus) = c.toComponentAction.image Yplus := by
  have hYI := c.y_le_component.trans c.component_le
  have hgen : theta Yplus = Yplus := by rw [← c.theta_eq, theta_idempotent]
  have hgenI : theta (Yplus.subgroupOf I) = Yplus.subgroupOf I := by
    apply Subgroup.map_injective I.subtype_injective
    rw [theta_map_of_injective I.subtype I.subtype_injective,
      map_subgroupOf_eq_of_le hYI, hgen]
  exact theta_image_eq_self c.toComponentAction.quotientMap _ hgenI

/-- Every subgroup of the actual plane image invariant under its full
normalizer is trivial or the whole plane. All source and quotient premises
are discharged on the literal reduced configuration. -/
theorem ReducedConfiguration.image_plane_normalizer_irreducible
    {Yplus S M I L V₁ V₂ : Subgroup G}
    (c : ReducedConfiguration Yplus S M I L V₁ V₂)
    (B : Subgroup c.toComponentAction.Quotient)
    (hB : B ≤ c.toComponentAction.image V₂)
    (hn : normalizer (c.toComponentAction.image V₂ : Set c.toComponentAction.Quotient) ≤
      normalizer (B : Set c.toComponentAction.Quotient)) :
    B = ⊥ ∨ B = c.toComponentAction.image V₂ := by
  obtain ⟨⟨e⟩, hVM, hVN, hcomm⟩ := c.four_group_image
  let : IsKleinFour V₂ := EvenModels.plane_isKleinFour c
  let : IsKleinFour (c.toComponentAction.image V₂) :=
    ⟨(Nat.card_congr e.toEquiv).symm.trans IsKleinFour.card_four,
      (Monoid.exponent_eq_of_mulEquiv e).symm.trans IsKleinFour.exponent_two⟩
  have hYN : c.toComponentAction.image Yplus ≤
      normalizer (c.toComponentAction.image V₂ : Set c.toComponentAction.Quotient) := by
    have hYM : c.toComponentAction.image Yplus ≤ c.toComponentAction.image M :=
      map_mono (fun _ hy => (EvenModels.actor_le_local c hy).1)
    exact hYM.trans ((normal_subgroupOf_iff_le_normalizer hVM).mp hVN)
  exact fourGroup_normalizer_irreducible c.image_actor_theta hYN hcomm B hB hn

end CFSG.Quasithin.Chapter15.Section03.RankOne
