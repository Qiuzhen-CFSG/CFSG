module

public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.RankOne.SporadicModels.LocalConfiguration
public import Theory.GroupTheory.SylowNormalIntersection
public import Theory.GroupTheory.GeneralizedFitting.ComponentLocalClosure.Extension
public import Theory.GroupTheory.GeneralizedFitting.SelfCentralizingPrimeCore
public import Theory.GroupTheory.PResidual.NormalSubgroup
public import Theory.GroupTheory.PCoreOvergroup

/-!
# Normalizer reduction for the Held rank-one branch

The source commutator identity places the normal four-group inside the
component. If that component has even characteristic, its inner four-group
normalizer has characteristic two. This passes to the ambient normalizer
because the ambient group is generated by the normal component and a Sylow
two-subgroup. Maximality then identifies the given local group with that
normalizer, including in an almost-simple extension.

The genuine O^{3′} residual puts every three-subgroup of the local group
inside Y. The S₃ quotient of YS implies that nine does not divide the local
order. A two-group inner normalizer is also impossible, since it would make
YS a two-group. These deductions leave a concrete normalizer calculation;
they do not classify Held's four-groups.

Source: Aschbacher--Smith, combined manuscript (1 March 2004), 15.3.43,
printed pp.1139--1140, especially (a), (b), (e) and the sporadic paragraph.
-/

public section

open Subgroup
namespace CFSG.Quasithin.Chapter15.Section03.RankOne.SporadicModels
variable {G : Type*} [Group G]

namespace HeldReduction

/-- Full movement by the inner residual puts the plane inside the component. -/
theorem plane_le_component {K S M Y V : Subgroup G}
    (c : LocalConfiguration K S M Y V) : V ≤ K := by
  let : K.Normal := c.normal
  rw [← c.plane_commutator]
  exact (commutator_mono le_rfl c.y_le_component).trans (commutator_le_right V K)

/-- Relative normality gives the actual ambient normalizer containment. -/
theorem local_le_plane_normalizer {K S M Y V : Subgroup G}
    (c : LocalConfiguration K S M Y V) : M ≤ normalizer (V : Set G) :=
  (normal_subgroupOf_iff_le_normalizer c.plane_le_local).mp c.plane_normal

/-- The source four-group is nontrivial. -/
theorem plane_ne_bot {K S M Y V : Subgroup G}
    (c : LocalConfiguration K S M Y V) : V ≠ ⊥ := by
  intro hb
  have hc := c.plane_card
  simp [hb] at hc

variable [Finite G]

/-- The actual S₃ quotient determines the odd part of YS. -/
theorem shadow_card {Y S : Subgroup G} (h : SymmetricThreeShadow Y S) :
    ∃ k, Nat.card (Y ⊔ S : Subgroup G) = 2 ^ k * 6 := by
  obtain ⟨e⟩ := h
  have hc : Nat.card ((Y ⊔ S : Subgroup G) ⧸ pCore 2 (Y ⊔ S : Subgroup G)) = 6 := by
    rw [Nat.card_congr e.toEquiv, Nat.card_eq_fintype_card, Fintype.card_perm]
    decide
  obtain ⟨k, hk⟩ := (pCore_isPGroup (p := 2) (G := (Y ⊔ S : Subgroup G))).exists_card_eq
  exact ⟨k, by rw [← (pCore 2 (Y ⊔ S : Subgroup G)).card_mul_index, hk,
    index_eq_card, hc]⟩

/-- Every three-subgroup lies in the source residual, so the local order has at most one factor of three. -/
theorem nine_not_dvd_local {K S M Y V : Subgroup G}
    (c : LocalConfiguration K S M Y V) : ¬ 9 ∣ Nat.card M := by
  let P : Sylow 3 M := default
  have hPY : (P : Subgroup M).map M.subtype ≤ Y := by
    rintro _ ⟨x, hx, rfl⟩
    obtain ⟨n, hn⟩ := P.isPGroup' (⟨x, hx⟩ : P)
    rw [c.residual]
    exact mem_map.mpr ⟨x, mem_primePowerGenerated_of_pow
      (congrArg (fun a : P => (a : M)) hn), rfl⟩
  let f : P →* (Y ⊔ S : Subgroup G) := {
    toFun := fun x => ⟨(x : M), (show Y ≤ Y ⊔ S from le_sup_left) (hPY (mem_map.mpr ⟨x, x.property, rfl⟩))⟩
    map_one' := rfl
    map_mul' := fun _ _ => rfl }
  have hf : Function.Injective f := by
    intro x y h
    exact Subtype.ext (Subtype.ext (congrArg (fun a : (Y ⊔ S : Subgroup G) => (a : G)) h))
  intro hd
  have hcop : Nat.Coprime 9 (P : Subgroup M).index := by
    exact (Nat.prime_three.coprime_iff_not_dvd.mpr P.not_dvd_index).pow_left 2
  have hdP : 9 ∣ Nat.card P := hcop.dvd_of_dvd_mul_right
    (by rwa [(P : Subgroup M).card_mul_index])
  have hdYS := hdP.trans (card_dvd_of_injective f hf)
  obtain ⟨k, hk⟩ := shadow_card c.shadow
  rw [hk] at hdYS
  have hcop2 : Nat.Coprime 9 (2 ^ k) := (by decide : Nat.Coprime 9 2).pow_right k
  have : 9 ∣ 6 := hcop2.dvd_of_dvd_mul_left hdYS
  norm_num at this

/-- A two-group inner normalizer would make the source S₃ shadow a two-group. -/
theorem inner_plane_normalizer_not_two_group {K S M Y V : Subgroup G}
    (c : LocalConfiguration K S M Y V) :
    ¬ IsPGroup 2 (normalizer (V.subgroupOf K : Set K)) := by
  have hVK := plane_le_component c
  have hYM : Y ≤ M := by rw [c.residual]; exact map_subtype_le _
  have hYN : Y ≤ normalizer (V : Set G) := hYM.trans (local_le_plane_normalizer c)
  let f : Y →* normalizer (V.subgroupOf K : Set K) := {
    toFun := fun y => ⟨⟨y, c.y_le_component y.property⟩, by
      rw [← subgroupOf_normalizer_eq hVK]
      exact hYN y.property⟩
    map_one' := rfl
    map_mul' := fun _ _ => rfl }
  have hf : Function.Injective f := by
    intro x y h
    exact Subtype.ext (congrArg (fun a : normalizer (V.subgroupOf K : Set K) => ((a : K) : G)) h)
  intro hp
  have hY : IsPGroup 2 Y := hp.of_injective f hf
  obtain ⟨P, hP⟩ := c.sylow
  have hS : IsPGroup 2 S := hP ▸ P.isPGroup'
  have hSN : S ≤ normalizer (Y : Set G) := c.normalizer_eq ▸ c.sylow_le_local
  have hYS : IsPGroup 2 (Y ⊔ S : Subgroup G) := by
    rw [sup_comm]
    exact hS.to_sup_of_normal_right' hY hSN
  obtain ⟨k, hk⟩ := hYS.exists_card_eq
  obtain ⟨j, hj⟩ := shadow_card c.shadow
  have hd : 3 ∣ 2 ^ k := by rw [← hk, hj]; exact dvd_mul_of_dvd_right (by decide) _
  exact (by decide : ¬ 3 ∣ 2) (Nat.prime_three.dvd_of_dvd_pow hd)

/-- Even characteristic in the component and a two-group ambient quotient make maximality applicable to the full plane normalizer. -/
theorem local_eq_plane_normalizer {K S M Y V : Subgroup G}
    (c : LocalConfiguration K S M Y V) (heven : IsEvenCharacteristic K) :
    M = normalizer (V : Set G) := by
  let : K.Normal := c.normal
  have hVK := plane_le_component c
  have hMN := local_le_plane_normalizer c
  let N := normalizer (V : Set G)
  have hSN : S ≤ N := c.sylow_le_local.trans hMN
  obtain ⟨P, hP⟩ := c.sylow
  obtain ⟨T, hT⟩ := P.exists_subgroupOf_eq_of_normal K
  have hTN : (T : Subgroup K) ≤ N.subgroupOf K := by
    rw [hT, hP]
    exact fun _ hx => hSN hx
  let : IsElementaryAbelian 2 V := c.plane_elementary
  have hlocal : IsTwoLocal (N.subgroupOf K) := by
    rw [show N.subgroupOf K = normalizer (V.subgroupOf K : Set K) from
      subgroupOf_normalizer_eq hVK]
    refine ⟨V.subgroupOf K, ?_, (IsElementaryAbelian.isPGroup 2 V).comap_subtype, rfl⟩
    intro hb
    apply plane_ne_bot c
    rw [← map_subgroupOf_eq_of_le hVK, hb, Subgroup.map_bot]
  obtain ⟨D, hND, hD⟩ := Finite.exists_le_maximal hlocal
  have hNDchar : HasCharacteristicTwo (N.subgroupOf K) := by
    have hh := centralizer_pCore_le_of_sylow_le (T.subtype (hTN.trans hND))
      ((N.subgroupOf K).subgroupOf D) (fun _ hx => hTN hx) (heven T D hD (hTN.trans hND))
    exact (Theory.Quasithin.centralizer_pCore_le_iff 2 (subgroupOfEquivOfLe hND)).mp hh
  let e : N.subgroupOf K ≃* K.subgroupOf N := {
    toFun := fun x => ⟨⟨x.val.val, x.property⟩, x.val.property⟩
    invFun := fun x => ⟨⟨x.val.val, x.property⟩, x.val.property⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl
    map_mul' := fun _ _ => rfl }
  have hNchar : HasCharacteristicTwo N := by
    have hq : IsPGroup 2 (G ⧸ K) :=
      isPGroup_quotient_of_sup_eq_top K S (hP ▸ P.isPGroup') c.generated
    have hqN : IsPGroup 2 (N ⧸ K.subgroupOf N) := by
      intro x
      induction x using QuotientGroup.induction_on with | H n =>
        obtain ⟨k, hk⟩ := hq (QuotientGroup.mk' K (n : G))
        refine ⟨k, ?_⟩
        change QuotientGroup.mk' (K.subgroupOf N) n ^ 2 ^ k = 1
        rw [← map_pow]
        apply (QuotientGroup.eq_one_iff _).mpr
        change (n : G) ^ 2 ^ k ∈ K
        apply (QuotientGroup.eq_one_iff _).mp
        change QuotientGroup.mk' K ((n : G) ^ 2 ^ k) = 1
        rw [map_pow]
        exact hk
    exact Theory.GroupTheory.centralizer_pCore_le_of_normal_pGroup_quotient
      (K.subgroupOf N) ((Theory.Quasithin.centralizer_pCore_le_iff 2 e).mp hNDchar) hqN
  exact le_antisymm hMN (c.maximal.2
    (Theory.GroupTheory.generalizedFitting_eq_pCore_of_selfCentralizing 2 hNchar) hMN)

/-- The exact inner normalizer has neither of the two arithmetic shapes
predicted by the three concrete Held four-group representatives. -/
theorem inner_plane_normalizer_nine_not_dvd {K S M Y V : Subgroup G}
    (c : LocalConfiguration K S M Y V) (heven : IsEvenCharacteristic K) :
    ¬ 9 ∣ Nat.card (normalizer (V.subgroupOf K : Set K)) := by
  have hVK := plane_le_component c
  have hM := local_eq_plane_normalizer c heven
  let f : normalizer (V.subgroupOf K : Set K) →* M := {
    toFun := fun x => ⟨x.val.val, by
      rw [hM]
      have hx : (x : K) ∈ (normalizer (V : Set G)).subgroupOf K := by
        simpa only [subgroupOf_normalizer_eq hVK] using x.property
      exact hx⟩
    map_one' := rfl
    map_mul' := fun _ _ => rfl }
  have hf : Function.Injective f := by
    intro x y h
    exact Subtype.ext (Subtype.ext (congrArg (fun a : M => (a : G)) h))
  exact fun hd => nine_not_dvd_local c (hd.trans (card_dvd_of_injective f hf))

end HeldReduction
end CFSG.Quasithin.Chapter15.Section03.RankOne.SporadicModels
