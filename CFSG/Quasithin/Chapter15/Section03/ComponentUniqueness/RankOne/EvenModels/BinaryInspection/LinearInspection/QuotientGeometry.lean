/-!
# The actual binary component parabolic

A binary Sylow subgroup stabilizes a full flag, and its normalizer preserves
each flag subspace. Thus it is self-normalizing. Transport through the actual
component model identifies the component Borel in I/C_I(L) with S⁺ ∩ L⁺.
Minimality of the original outside overgroup bounds every proper quotient
overgroup of Y₊⁺S⁺. Dedekind's identity then proves maximality among proper
S⁺-invariant component overgroups, hence the required maximal parabolic.

The original residual retains its two-core index three. The quotient component
and extended local intersection are kept separate throughout. These deductions
do not yet select the permitted node or exclude either binary dimension.

Source: Aschbacher--Smith, combined manuscript (1 March 2004), 15.3.43(e)
and its n = 1 paragraph, printed p.1140; 1.1.5(3)(a), p.501; A.2.3--4, p.33.
-/

public section

open Subgroup
open scoped Pointwise
namespace CFSG.Quasithin.Chapter15.Section03.RankOne.EvenModels.BinaryInspection.LinearInspection
open BinaryLinear.InvariantNodeActions BinaryLinear.OuterCyclic

private theorem fullFlag_normalizer {m : ℕ} (b : Basis m) :
    normalizer (cutStabilizer b Set.univ : Set (LinearGroup (m + 1))) =
      cutStabilizer b Set.univ := by
  apply le_antisymm ?_ (cutStabilizer b Set.univ).le_normalizer
  intro g hg
  have he := mem_normalizer_iff_map_conj_eq.mp hg
  change (cutStabilizer b Set.univ).map (MulAut.conj g).toMonoidHom = _ at he
  rw [cutStabilizer_map_conj] at he
  rw [mem_cutStabilizer_maps]
  intro i _ v hv
  have hc := cutSpace_eq_of_fullFlag_le b (b.map g) Set.univ he.ge i (Set.mem_univ i)
  rw [← hc, cutSpace_map]
  exact Submodule.mem_map.mpr ⟨v, hv, rfl⟩

private theorem binary_sylow_normalizer {m : ℕ}
    (T : Sylow 2 (LinearGroup (m + 1))) :
    normalizer (T : Set (LinearGroup (m + 1))) = (T : Subgroup _) := by
  obtain ⟨b, hb⟩ := sylow_eq_cutStabilizer T
  change normalizer ((T : Subgroup (LinearGroup (m + 1))) : Set (LinearGroup (m + 1))) = _
  rw [hb, fullFlag_normalizer]

variable {G : Type*} [Group G]
variable {Yplus S M I L V₁ V₂ : Subgroup G}
variable (c : ReducedConfiguration Yplus S M I L V₁ V₂)
include c

/-- The actual action quotient is generated by the component and Sylow images. -/
theorem quotient_generated :
    c.toComponentAction.image L ⊔ c.toComponentAction.image S = ⊤ := by
  change (L.subgroupOf I).map c.toComponentAction.quotientMap ⊔
    (S.subgroupOf I).map c.toComponentAction.quotientMap = ⊤
  rw [← Subgroup.map_sup, ← subgroupOf_sup c.component_le
    ((sylow_le_local c).trans inf_le_right), ← c.generated, subgroupOf_self]
  exact map_top_of_surjective _ c.toComponentAction.quotientMap_surjective

/-- The full local image is the component intersection extended by its Sylow image. -/
theorem quotient_local_eq_sup :
    c.toComponentAction.image M =
      c.toComponentAction.image (M ⊓ L) ⊔ c.toComponentAction.image S := by
  have hLI := c.component_le
  have hSI := (sylow_le_local c).trans inf_le_right
  let : (L.subgroupOf I).Normal := normal_subgroupOf_of_le_normalizer c.normalizes
  have hgen : L.subgroupOf I ⊔ S.subgroupOf I = ⊤ := by
    rw [← subgroupOf_sup hLI hSI, ← c.generated, subgroupOf_self]
  have hinter : M.subgroupOf I = (M ⊓ L).subgroupOf I ⊔ S.subgroupOf I := by
    apply le_antisymm ?_ (sup_le (fun _ hx => hx.1) (fun _ hx => c.sylow_le_M hx))
    intro x hx
    have hxm : x ∈ L.subgroupOf I ⊔ S.subgroupOf I := hgen ▸ mem_top _
    obtain ⟨l, hl, s, hs, he⟩ := mem_sup_of_normal_left.mp hxm
    have hlM : (l : G) ∈ M := by
      have hv : (l : G) * (s : G) = x := congrArg Subtype.val he
      rw [(eq_mul_inv_iff_mul_eq).mpr hv]
      exact M.mul_mem hx (M.inv_mem (c.sylow_le_M hs))
    exact he ▸ ((M ⊓ L).subgroupOf I ⊔ S.subgroupOf I).mul_mem
      (mem_sup_left ⟨hlM, hl⟩) (mem_sup_right hs)
  change (M.subgroupOf I).map c.toComponentAction.quotientMap = _
  rw [hinter, Subgroup.map_sup]
  rfl

/-- Kernel containment recovers the literal component intersection in the quotient. -/
theorem quotient_intersection_eq :
    c.toComponentAction.image (M ⊓ L) =
      c.toComponentAction.image M ⊓ c.toComponentAction.image L := by
  apply le_antisymm (le_inf (map_mono (comap_mono inf_le_left))
    (map_mono (comap_mono inf_le_right)))
  rintro x ⟨hxM, l, hl, rfl⟩
  have hpre := ParabolicInspection.componentMap_preimage_local c
  have hm : (⟨l, hl⟩ : L) ∈ M.subgroupOf L := by
    rw [← hpre]
    exact hxM
  exact mem_map.mpr ⟨l, ⟨hm, hl⟩, rfl⟩

private theorem proper_overgroup_le (J : Subgroup G)
    (hYJ : Yplus ⊔ S ≤ J) (hJI : J < I) : J ≤ M := by
  by_contra hJM
  obtain ⟨P, hP⟩ := c.sylow
  have hcore : I.pCoreIn 2 ≤ J.pCoreIn 2 := by
    apply le_pCoreIn_of_normalizes (isPGroup_pCoreIn 2 I)
    · exact (hP ▸ pCoreIn_le_sylow I P).trans (le_sup_right.trans hYJ)
    · exact hJI.le.trans (I.le_normalizer.trans
        (normalizer_le_normalizer_characteristic_image I (pCore 2 I)))
  have hJ : J ∈ outsideFamily Yplus S M := by
    refine ⟨⟨?_, hYJ⟩, hJM⟩
    intro he
    exact c.minimal.1.1.1 (bot_unique (he ▸ hcore))
  exact hJI.ne (c.minimal.eq_of_ge hJ hJI.le).symm

/-- A proper quotient overgroup of the actor and Sylow is contained in the local image. -/
theorem quotient_proper_overgroup_le (H : Subgroup c.toComponentAction.Quotient)
    (hYH : c.toComponentAction.image Yplus ⊔ c.toComponentAction.image S ≤ H)
    (hH : H ≠ ⊤) : H ≤ c.toComponentAction.image M := by
  let d := c.toComponentAction
  let J := (H.comap d.quotientMap).map I.subtype
  have hJI : J ≤ I := map_subtype_le _
  have hYJ : Yplus ⊔ S ≤ J := by
    apply sup_le
    · intro y hy
      refine ⟨⟨y, c.component_le (c.y_le_component hy)⟩, ?_, rfl⟩
      exact hYH (mem_sup_left (mem_map.mpr ⟨_, hy, rfl⟩))
    · intro s hs
      refine ⟨⟨s, ((sylow_le_local c).trans inf_le_right) hs⟩, ?_, rfl⟩
      exact hYH (mem_sup_right (mem_map.mpr ⟨_, hs, rfl⟩))
  have hlt : J < I := lt_of_le_of_ne hJI (by
    intro he
    apply hH
    apply top_unique
    intro z _
    obtain ⟨i, rfl⟩ := d.quotientMap_surjective z
    have hi : (i : G) ∈ J := he.ge i.property
    obtain ⟨j, hj, hji⟩ := hi
    have heq : j = i := Subtype.ext hji
    exact heq ▸ hj)
  have hJM := proper_overgroup_le c J hYJ hlt
  intro z hz
  obtain ⟨i, rfl⟩ := d.quotientMap_surjective z
  exact mem_map.mpr ⟨i, hJM (mem_map.mpr ⟨i, hz, rfl⟩), rfl⟩

/-- Every proper invariant enlargement of the component intersection equals it. -/
theorem invariant_overgroup_le (H : Subgroup c.toComponentAction.Quotient)
    (hHL : H < c.toComponentAction.image L)
    (hPH : c.toComponentAction.image M ⊓ c.toComponentAction.image L ≤ H)
    (hn : c.toComponentAction.image S ≤ normalizer (H : Set c.toComponentAction.Quotient)) :
    H ≤ c.toComponentAction.image M ⊓ c.toComponentAction.image L := by
  let d := c.toComponentAction
  have hSM : d.image S ≤ d.image M := map_mono (comap_mono c.sylow_le_M)
  have hint : (H ⊔ d.image S) ⊓ d.image L = H := by
    apply le_antisymm ?_ (le_inf le_sup_left hHL.le)
    intro x hx
    have hm : x ∈ (H : Set d.Quotient) * (d.image S : Set d.Quotient) := by
      rw [← coe_mul_of_right_le_normalizer_left H (d.image S) hn]
      exact hx.1
    obtain ⟨h, hh, s, hs, he⟩ := hm
    have hsL : s ∈ d.image L := by
      have hhx := (d.image L).mul_mem ((d.image L).inv_mem (hHL.le hh)) hx.2
      rw [← he, inv_mul_cancel_left] at hhx
      exact hhx
    exact he ▸ H.mul_mem hh (hPH ⟨hSM hs, hsL⟩)
  have hproper : H ⊔ d.image S ≠ ⊤ := by
    intro ht
    rw [ht, top_inf_eq] at hint
    exact hHL.ne hint.symm
  have hYH : d.image Yplus ≤ H := (le_inf (map_mono (comap_mono ((actor_le_local c).trans inf_le_left)))
      (map_mono (comap_mono c.y_le_component))).trans hPH
  exact le_inf (le_sup_left.trans (quotient_proper_overgroup_le c _
    (sup_le_sup hYH le_rfl) hproper)) hHL.le



/-- Simplicity is used only to remove the original component centre. -/
theorem component_center_eq_bot (hs : IsSimpleGroup L) : center L = ⊥ := by
  let : IsSimpleGroup L := hs
  let : Group.IsPerfect L := SporadicModels.reduced_component_perfect c
  rcases (inferInstance : (center L).Normal).eq_bot_or_eq_top with h | h
  · exact h
  · exact (Group.IsPerfect.not_isMulCommutative L (center_eq_top_iff.mp h)).elim

/-- The actual quotient component is the specified binary linear model. -/
theorem exists_component_linearEquiv (hs : IsSimpleGroup L) {n : ℕ} (hn : 0 < n)
    (iso : ClassicalGroup.IsPSL L n 2) :
    Nonempty (c.toComponentAction.image L ≃* LinearGroup n) := by
  obtain ⟨F, _, _, hF, ⟨e⟩⟩ := iso
  let : Fintype F := Fintype.ofFinite F
  let f : F ≃+* ZMod 2 := FiniteField.ringEquivOfCardEq (by
    simpa only [← Nat.card_eq_fintype_card, Nat.card_zmod] using hF)
  exact ⟨((subgroupImageEquiv c (component_center_eq_bot c hs) L le_rfl).symm.trans e).trans
    ((Atlas.fieldEquivPSL n f).trans (projectiveEquivLinear hn))⟩

omit [Group G] c in
private theorem sylow_normalizer_of_linearEquiv {H : Type*} [Group H] [Finite H]
    {m : ℕ} (e : H ≃* LinearGroup (m + 1)) (P : Sylow 2 H) :
    normalizer (P : Set H) = (P : Subgroup H) := by
  let T := P.mapSurjective (f := e.toMonoidHom) e.surjective
  apply le_antisymm ?_ (P : Subgroup H).le_normalizer
  intro x hx
  have hm : e x ∈ normalizer (T : Set (LinearGroup (m + 1))) :=
    (P : Subgroup H).le_normalizer_map e.toMonoidHom ⟨x, hx, rfl⟩
  rw [binary_sylow_normalizer] at hm
  obtain ⟨y, hy, hyx⟩ := hm
  exact e.injective hyx ▸ hy

variable [Finite G]

/-- In the binary model the component Borel is its Sylow intersection. -/
theorem quotient_borel_eq (hs : IsSimpleGroup L) {n : ℕ} (hn : 0 < n)
    (iso : ClassicalGroup.IsPSL L n 2) :
    ChapterF.Source.borel (c.toComponentAction.image L) (c.toComponentAction.image S) =
      c.toComponentAction.image S ⊓ c.toComponentAction.image L := by
  obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hn)
  obtain ⟨e⟩ := exists_component_linearEquiv c hs hn iso
  obtain ⟨P, hP⟩ := c.sylow
  obtain ⟨T, hT⟩ := c.toComponentAction.image_sylow P hP
  obtain ⟨R, hR⟩ := T.exists_subgroupOf_eq_of_normal (c.toComponentAction.image L)
  have hN : normalizer ((c.toComponentAction.image S).subgroupOf
      (c.toComponentAction.image L) : Set (c.toComponentAction.image L)) =
        (c.toComponentAction.image S).subgroupOf (c.toComponentAction.image L) := by
    rw [← hT, ← hR]
    exact sylow_normalizer_of_linearEquiv e R
  have hb : (ChapterF.Source.borel (c.toComponentAction.image L)
      (c.toComponentAction.image S)).subgroupOf (c.toComponentAction.image L) =
      (c.toComponentAction.image S).subgroupOf (c.toComponentAction.image L) := by
    rw [ChapterF.Source.borel, inf_subgroupOf_left,
      subgroupOf_normalizer_eq inf_le_right, inf_subgroupOf_right, hN]
  have he := congrArg (fun H : Subgroup (c.toComponentAction.image L) =>
    H.map (c.toComponentAction.image L).subtype) hb
  rwa [map_subgroupOf_eq_of_le (show ChapterF.Source.borel
    (c.toComponentAction.image L) (c.toComponentAction.image S) ≤
      c.toComponentAction.image L from inf_le_left), subgroupOf_map_subtype] at he

/-- The required maximal invariant parabolic is derived from the configuration,
with no assumed local classification or chosen parabolic. -/
theorem quotientParabolic (hs : IsSimpleGroup L) {n : ℕ} (hn : 0 < n)
    (iso : ClassicalGroup.IsPSL L n 2) : ParabolicInspection.QuotientParabolic c := by
  refine ⟨?_, ParabolicInspection.quotient_intersection_proper c,
    ParabolicInspection.quotient_sylow_normalizes_intersection c, ?_⟩
  · rw [quotient_borel_eq c hs hn iso]
    exact inf_le_inf_right _ (map_mono (comap_mono c.sylow_le_M))
  · intro Q _ hQ hn hPQ
    exact invariant_overgroup_le c Q hQ hPQ hn

omit [Finite G] in

/-- Removing the component centre preserves the literal residual's two-core index. -/
theorem quotient_actor_index (hs : IsSimpleGroup L) :
    (pCore 2 (c.toComponentAction.image Yplus)).index = 3 := by
  let e := subgroupImageEquiv c (component_center_eq_bot c hs) Yplus c.y_le_component
  rw [← pCore_map_iso 2 e, Subgroup.index_map_of_bijective e.bijective, c.index]

