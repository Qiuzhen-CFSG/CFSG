module

public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.RankOne.EvenModels.Basic
public import Theory.AtlasPort.ExceptionalIsomorphisms.Order360
public import GorensteinWalter.PSL2KleinFourCentralizerEqSelf

/-!
# Recovering the original A₄ actor in the A₆ branch

Transport the original four-group into the actual PSL₂(9) model using the
proved exceptional isomorphism. Its self-centralizer theorem bounds the
centralizer back inside L. The actor is generated by elements of order three,
so the existing two-perfect recognition constructs Y₊ ≃ A₄. In particular,
C_L(Y₊) is trivial. No use is made of the final exclusion of A₄.

This uses two-perfectness from the order-three generation identity; it does
not identify the source prime-to-three residual with a two-residual.

Source: Aschbacher--Smith, combined manuscript (1 March 2004), the n = 1
paragraph of 15.3.43, printed p.1140. The actual PSL₂(9)--A₆ comparison is
imported from Theory.AtlasPort.ExceptionalIsomorphisms.Order360, retaining
its ATLAS attribution and license (LICENSES/ATLAS.txt).
-/

public section

open Subgroup
namespace CFSG.Quasithin.Chapter15.Section03.RankOne.EvenModels.BinaryInspection.SixInspection
variable {G : Type*} [Group G] [Finite G]
variable {Yplus S M I L V₁ V₂ : Subgroup G}
variable (c : ReducedConfiguration Yplus S M I L V₁ V₂)
include c

omit [Finite G] in
/-- The original four-group is self-centralizing inside the component. -/
theorem plane_centralizer (e : L ≃* alternatingGroup (Fin 6)) :
    L ⊓ centralizer (V₂ : Set G) ≤ V₂ := by
  let K := V₂.subgroupOf L
  let eK : K ≃* V₂ := subgroupOfEquivOfLe (plane_le_component c)
  have hK : IsKleinFour K :=
    ⟨(Nat.card_congr eK.toEquiv).trans (plane_isKleinFour c).card_four,
      (Monoid.exponent_eq_of_mulEquiv eK).trans (plane_isKleinFour c).exponent_two⟩
  let f := e.trans Atlas.Comparisons.Exceptional.psl2NineCoordinatesEquivAlt6.symm
  have hF : GorensteinWalter.IsOddPrimePower
      (Nat.card Atlas.Comparisons.Exceptional.Nine.F) := by
    rw [Atlas.Comparisons.Exceptional.Nine.card]
    exact ⟨3, 2, by decide, by decide, by decide, by decide⟩
  have hcentral := GorensteinWalter.psl2_kleinFour_centralizer_eq_self
    Atlas.Comparisons.Exceptional.Nine.F hF (K.map f.toMonoidHom)
    (GorensteinWalter.isKleinFour_map_of_injective K hK f.toMonoidHom f.injective)
  intro x hx
  let xL : L := ⟨x, hx.1⟩
  have hc : f xL ∈ centralizer (K.map f.toMonoidHom : Set _) := by
    rintro _ ⟨v, hv, rfl⟩
    change f v * f xL = f xL * f v
    rw [← map_mul, ← map_mul]
    exact congrArg f (Subtype.ext (hx.2 v hv))
  rw [hcentral] at hc
  obtain ⟨v, hv, he⟩ := hc
  show xL ∈ K
  exact f.injective he ▸ hv

/-- Recover the original actor, rather than just its quotient image. -/
theorem actor_alternating_four (h6 : Nonempty (L ≃* alternatingGroup (Fin 6))) :
    Nonempty (Yplus ≃* alternatingGroup (Fin 4)) := by
  obtain ⟨e⟩ := h6
  exact actor_alternating_four_of_plane_centralizer c (plane_centralizer c e)

/-- The actor has trivial centralizer inside the original component. -/
theorem actor_centralizer (e : L ≃* alternatingGroup (Fin 6)) :
    L ⊓ centralizer (Yplus : Set G) = ⊥ := by
  obtain ⟨a⟩ := actor_alternating_four c ⟨e⟩
  apply bot_unique
  intro x hx
  have hxV : x ∈ V₂ := plane_centralizer c e
    ⟨hx.1, centralizer_le (plane_le_actor c) hx.2⟩
  let xY : Yplus := ⟨x, plane_le_actor c hxV⟩
  have hz : a xY ∈ center (alternatingGroup (Fin 4)) := by
    apply mem_center_iff.mpr
    intro y
    obtain ⟨y, rfl⟩ := a.surjective y
    rw [← map_mul, ← map_mul]
    exact congrArg a (Subtype.ext (hx.2 y y.property))
  have hx1 : a xY = 1 := (alternatingGroup.center_eq_bot (by simp)).le hz
  exact Subtype.ext_iff.mp (a.injective (hx1.trans a.map_one.symm))
end CFSG.Quasithin.Chapter15.Section03.RankOne.EvenModels.BinaryInspection.SixInspection
