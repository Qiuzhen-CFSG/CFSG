/-!
# The Ree branch of the larger-field residual inspection

Conjugate the actual component Sylow subgroup to the root-defined positive
subgroup of the Ree carrier. Its normalizer is the root Borel. The concrete
rank-two Tits system identifies every proper Borel overgroup as that Borel
or one of the two full maximal parabolics, including complementary tori.

The Borel and the Suzuki parabolic have three-free order, contradicting the
actor's two-core index three. The linear parabolic projects onto SL₂ over
F_(2^(2*m+1)). For m ≥ 1 that group is nonsolvable and generated by its
three-elements, so the parabolic's O^{3′} residual cannot be solvable.
The original residual actor supplies precisely the opposite condition.

No automorphism-stability premise is required: the inspection covers every
proper Borel overgroup, including any invariant Borel case. Simplicity is
retained as a source input; no additional model simplicity or order theorem
is needed. The prime-power and prime-to-index residual conventions are
identified by the proved finite-group transport theorem.

Source: Aschbacher--Smith, combined manuscript (1 March 2004), 15.3.43,
printed p.1140; 1.1.5(3)(a), pp.501--502; A.2.3--4, p.33.
-/

public section

open Subgroup
open CFSG.Quasithin.ChapterF.Source
namespace CFSG.Quasithin.Chapter15.Section03.RankOne.EvenModels.ParabolicInspection

private theorem rankTwo_trichotomy {H : Type*} [Group H]
    (T : Theory.AlgebraicGroup.TitsSystem (X := H))
    {s t : T.N ⧸ (T.B ⊓ T.N).subgroupOf T.N} (hS : T.S = {s, t})
    (Q : Subgroup H) (hBQ : T.B ≤ Q) (hQ : Q < ⊤) :
    Q = T.B ∨ Q = T.standardParabolic {s} ∨ Q = T.standardParabolic {t} := by
  classical
  have he := T.subgroup_eq_standardParabolic_simpleIndices Q hBQ
  have hi := T.simpleIndices_subset Q
  rw [hS] at hi
  by_cases hs : s ∈ T.simpleIndices Q
  · by_cases ht : t ∈ T.simpleIndices Q
    · have hall : T.simpleIndices Q = T.S := by
        rw [hS]
        exact Set.Subset.antisymm hi
          (Set.insert_subset_iff.mpr ⟨hs, Set.singleton_subset_iff.mpr ht⟩)
      rw [hall, T.standardParabolic_S] at he
      exact (hQ.ne he).elim
    · right; left
      rw [he]
      congr 1
      ext w
      constructor
      · intro hw
        rcases hi hw with rfl | rfl
        · rfl
        · exact (ht hw).elim
      · rintro rfl
        exact hs
  · by_cases ht : t ∈ T.simpleIndices Q
    · right; right
      rw [he]
      congr 1
      ext w
      constructor
      · intro hw
        rcases hi hw with rfl | rfl
        · exact (hs hw).elim
        · rfl
      · rintro rfl
        exact ht
    · left
      have hempty : T.simpleIndices Q = ∅ := by
        apply Set.eq_empty_iff_forall_notMem.mpr
        intro w hw
        exact (hi hw).elim (fun he => hs (he ▸ hw)) (fun he => ht (he ▸ hw))
      rw [he, hempty, T.standardParabolic_empty]

private theorem ree_linear_residual_not_solvable {m : ℕ} (hm : 1 ≤ m) :
    ¬ Group.IsSolvable (primeToResidual 3 (ReeF4.ConverseParabolics.parabolic m .linear)) := by
  intro hsol
  let := hsol
  have hF : 2 < Nat.card (ReeF4.CoefficientField m) := by
    rw [ReeF4.field_card]
    exact pow_lt_pow_right₀ (by decide : 1 < 2) (by omega : 1 < 2 * m + 1)
  let f : ReeF4.ConverseParabolics.parabolic m .linear →*
      Matrix.SpecialLinearGroup (Fin 2) (ReeF4.CoefficientField m) :=
    (MonoidHom.fst _ _).comp (ReeF4.ConverseParabolics.linearProjection hm)
  have hf : Function.Surjective f :=
    by
    intro x
    obtain ⟨y, hy⟩ := ReeF4.ConverseParabolics.linearProjection_surjective hm (x, 1)
    exact ⟨y, congrArg Prod.fst hy⟩
  have hs : Group.IsSolvable ((primeToResidual 3
      (ReeF4.ConverseParabolics.parabolic m .linear)).map f) :=
    Group.isSolvable_of_surjective (f.subgroupMap_surjective _)
  rw [map_primeToResidual_of_surjective 3 f hf,
    Theory.SpecificGroups.SymplecticFour.ThreeResidualPlacement.sl2_primeToThreeResidual_eq_top hF] at hs
  let := hs
  let := Theory.SpecificGroups.SymplecticFour.NaturalExtension.model_perfect hF
  let := Theory.SpecificGroups.SymplecticFour.NaturalExtension.model_simple hF
  exact Group.IsPerfect.not_isSolvable
    (Matrix.SpecialLinearGroup (Fin 2) (ReeF4.CoefficientField m))
    (Group.isSolvable_of_surjective
      (f := (topEquiv : (⊤ : Subgroup (Matrix.SpecialLinearGroup (Fin 2)
        (ReeF4.CoefficientField m))) ≃* _).toMonoidHom) topEquiv.surjective)

attribute [local instance] ReeF4.SectionGeometry.BNPair.borel_inf_normalizerWords_normal

private theorem ree_standard_exclusion {m : ℕ} (hm : 1 ≤ m)
    (Q : Subgroup (ReeF4.Model m)) (hBQ : ReeF4.Parabolics.borel m ≤ Q)
    (hQ : Q < ⊤) (h3 : 3 ∣ Nat.card Q)
    (hsol : Group.IsSolvable (primeToResidual 3 Q)) : False := by
  have hcases := rankTwo_trichotomy (ReeF4.SectionGeometry.BNPair.titsSystem m)
    (ReeF4.SectionGeometry.BNPair.simpleReflections_eq_pair m) Q hBQ hQ
  rcases hcases with hb | hl | hs
  · rw [hb] at h3
    apply ReeF4.ConverseParabolics.suzuki_parabolic_three_free hm
    exact h3.trans (card_dvd_of_le (show ReeF4.Parabolics.borel m ≤
      ReeF4.ConverseParabolics.parabolic m .suzuki from
        (ReeF4.MaximalSubgroups.AbelianCharacteristic.TwoLocalGeometry.parabolic_eq_rootParabolic
          m .suzuki).symm ▸ ReeF4.Parabolics.borel_le_parabolic m .suzuki))
  · have he := hl.trans
      (ReeF4.MaximalSubgroups.AbelianCharacteristic.TwoLocalGeometry.standardParabolic_singleton_eq_parabolic m hm .linear)
    rw [he] at hsol
    exact ree_linear_residual_not_solvable hm hsol
  · have he := hs.trans
      (ReeF4.MaximalSubgroups.AbelianCharacteristic.TwoLocalGeometry.standardParabolic_singleton_eq_parabolic m hm .suzuki)
    rw [he] at h3
    exact ReeF4.ConverseParabolics.suzuki_parabolic_three_free hm h3

variable {G : Type*} [Group G] [Finite G]
variable {Yplus S M I L V₁ V₂ : Subgroup G}

/-- Both full Ree parabolics and their Borel are excluded by the cubic actor. -/
theorem ree_residual_exclusion
    (c : ReducedConfiguration Yplus S M I L V₁ V₂)
    {m : ℕ} (hm : 1 ≤ m) (_hs : IsSimpleGroup L)
    (hmodel : Nonempty (L ≃* ReeF4.Model m)) (hp : QuotientParabolic c) : False := by
  obtain ⟨e⟩ := hmodel
  obtain ⟨P, hP⟩ := component_sylow c
  let P' := P.mapSurjective (f := e.toMonoidHom) e.surjective
  obtain ⟨T, hT⟩ := ReeF4.ConverseParabolics.exists_sylow_eq_unipotent m
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq (ReeF4.Model m) P' T
  let f := e.trans (MulAut.conj g)
  have hPT : (P : Subgroup L).map f.toMonoidHom =
      ReeF4.ConverseParabolics.unipotent m := by
    rw [← hT]
    change (P : Subgroup L).map
      ((MulAut.conj g).toMonoidHom.comp e.toMonoidHom) = (T : Subgroup (ReeF4.Model m))
    rw [← map_map]
    exact congrArg Sylow.toSubgroup hg
  let Q := ((M ⊓ L).subgroupOf L).map f.toMonoidHom
  let eQ : (M ⊓ L : Subgroup G) ≃* Q :=
    (subgroupOfEquivOfLe (show M ⊓ L ≤ L from inf_le_right)).symm.trans
      (f.subgroupMap ((M ⊓ L).subgroupOf L))
  have hBQ : ReeF4.Parabolics.borel m ≤ Q := by
    rw [← ReeF4.Parabolics.unipotent_normalizer_eq_borel]
    rw [← ReeF4.MaximalSubgroups.AbelianCharacteristic.TwoLocalGeometry.unipotent_eq_rootUnipotent,
      ← hPT, ← map_equiv_normalizer_eq]
    apply map_mono
    change sylowNormalizer P ≤ (M ⊓ L).subgroupOf L
    rw [← borel_subgroupOf_eq_sylowNormalizer L S P hP]
    exact subgroupOf_mono L (borel_le_intersection c hp)
  have hproper : Q < ⊤ := by
    have hML : (M ⊓ L).subgroupOf L < ⊤ := by
      apply lt_top_iff_ne_top.mpr
      intro he
      exact c.component_outside ((subgroupOf_eq_top.mp he).trans inf_le_left)
    simpa only [map_top_of_surjective f.toMonoidHom f.surjective] using
      (map_lt_map_iff_of_injective (f := f.toMonoidHom) f.injective).mpr hML
  have h3 : 3 ∣ Nat.card Q := by
    rw [← Nat.card_congr eQ.toEquiv]
    have h3Y : 3 ∣ Nat.card Yplus := c.index ▸ (pCore 2 Yplus).index_dvd_card
    exact h3Y.trans (card_dvd_of_le
      (le_inf ((actor_le_local c).trans inf_le_left) c.y_le_component))
  have hsol : Group.IsSolvable (primeToResidual 3 (M ⊓ L : Subgroup G)) := by
    have himage : Group.IsSolvable
        ((primeToResidual 3 (M ⊓ L : Subgroup G)).map (M ⊓ L).subtype) := by
      rw [← threeResidualIn_eq_primeToResidual, ← residual_on_component c]
      exact actor_solvable c
    let := himage
    let er := equivMapOfInjective (primeToResidual 3 (M ⊓ L : Subgroup G))
      (M ⊓ L).subtype (M ⊓ L).subtype_injective
    exact Group.isSolvable_of_isSolvable_injective (f := er.toMonoidHom) er.injective
  let := hsol
  exact ree_standard_exclusion hm Q hBQ hproper h3
    (Group.isSolvable_of_surjective (f := (primeToResidualEquiv 3 eQ).toMonoidHom)
      (primeToResidualEquiv 3 eQ).surjective)

end CFSG.Quasithin.Chapter15.Section03.RankOne.EvenModels.ParabolicInspection
