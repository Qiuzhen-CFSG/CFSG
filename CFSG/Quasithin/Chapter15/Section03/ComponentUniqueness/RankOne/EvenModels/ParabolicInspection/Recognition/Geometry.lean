module

public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.RankOne.EvenModels.ParabolicInspection.Contracts
public import Theory.GroupTheory.GeneralizedFitting.ComponentLocalClosure.Extension
public import Theory.GroupTheory.GeneralizedFitting.SelfCentralizingPrimeCore
public import Theory.GroupTheory.PResidual.NormalSubgroup

/-!
# From invariant parabolic geometry to characteristic-two maximality

Let `H = KS`, with `K` normal and `S` a two-group. A subgroup containing
`S` is generated by its intersection with `K` and `S`. A proper invariant
parabolic `Q` of `K` with self-centralizing two-core gives a characteristic-two
overgroup `QS`, because characteristic two passes to extensions by two-groups.
Thus maximality subject to characteristic two promotes parabolic containment
to equality and gives maximality among the proper invariant parabolics.

The two geometric inputs below are separate obligations. Neither is included
in the incoming reduced configuration. Source: Aschbacher--Smith, 15.3.43(e)
and the first characteristic-two paragraph, printed p.1140.
-/

@[expose] public section

open Subgroup Theory.GroupTheory CFSG.Quasithin.ChapterF.Source
namespace CFSG.Quasithin.Chapter15.Section03.RankOne.EvenModels.ParabolicInspection

variable {H : Type*} [Group H]

/-- A proper invariant parabolic covering the component intersection of a
two-local. Its existence is a geometric assertion, without a maximality claim. -/
def InvariantHull (K S N : Subgroup H) : Prop :=
  ∃ Q : Subgroup H, borel K S ≤ Q ∧ Q < K ∧
    S ≤ normalizer (Q : Set H) ∧ N ⊓ K ≤ Q

/-- The intrinsic characteristic-two calculation for the relevant parabolics.
The passage from `Q` to `QS` is proved below, not assumed here. -/
def ParabolicCores (K S : Subgroup H) : Prop :=
  ∀ Q : Subgroup H, borel K S ≤ Q → Q < K →
    S ≤ normalizer (Q : Set H) →
      centralizer (pCore 2 Q : Set Q) ≤ pCore 2 Q

/-- Dedekind's subgroup identity in the actual two-group extension. -/
theorem intersection_sup_eq (K S N : Subgroup H) [K.Normal]
    (hgen : K ⊔ S = ⊤) (hSN : S ≤ N) : (N ⊓ K) ⊔ S = N := by
  apply le_antisymm (sup_le inf_le_left hSN)
  intro x hx
  obtain ⟨k, hk, s, hs, rfl⟩ := mem_sup_of_normal_left.mp (hgen ▸ mem_top x)
  have hkN : k ∈ N := by
    simpa only [mul_inv_cancel_right] using N.mul_mem hx (N.inv_mem (hSN hs))
  exact mul_mem_sup ⟨hkN, hk⟩ hs

/-- Intrinsic characteristic two survives adjoining a normalizing two-group. -/
theorem characteristicTwo_sup_of_normalizes [Finite H] (Q S : Subgroup H)
    (hS : IsPGroup 2 S) (hn : S ≤ normalizer (Q : Set H))
    (hc : centralizer (pCore 2 Q : Set Q) ≤ pCore 2 Q) :
    generalizedFitting (Q ⊔ S : Subgroup H) = pCore 2 (Q ⊔ S : Subgroup H) := by
  let X := Q ⊔ S
  let N := Q.subgroupOf X
  let : N.Normal := normal_subgroupOf_of_le_normalizer (sup_le Q.le_normalizer hn)
  have hN : centralizer (pCore 2 N : Set N) ≤ pCore 2 N :=
    (Theory.Quasithin.centralizer_pCore_le_iff 2
      (subgroupOfEquivOfLe (show Q ≤ X from le_sup_left))).mpr hc
  have hgen : N ⊔ S.subgroupOf X = ⊤ := by
    rw [← subgroupOf_sup (show Q ≤ X from le_sup_left)
      (show S ≤ X from le_sup_right)]
    exact subgroupOf_self X
  apply generalizedFitting_eq_pCore_of_selfCentralizing 2
  exact centralizer_pCore_le_of_normal_pGroup_quotient N hN
    (isPGroup_quotient_of_sup_eq_top N (S.subgroupOf X) hS.comap_subtype hgen)

/-- The two independent geometric calculations imply the exact recognition
statement using the supplied characteristic-two maximality. -/
theorem maximalInvariantParabolic_of_geometry [Finite H]
    (K S N : Subgroup H) [K.Normal] (hgen : K ⊔ S = ⊤)
    (hS : IsPGroup 2 S) (hSN : S ≤ N)
    (hmax : Maximal (fun X : Subgroup H => generalizedFitting X = pCore 2 X) N)
    (hhull : InvariantHull K S N) (hcores : ParabolicCores K S) :
    MaximalInvariantParabolic K S (N ⊓ K) := by
  obtain ⟨Q, hBQ, hQK, hnQ, hNQ⟩ := hhull
  have hNQS : N ≤ Q ⊔ S := by
    rw [← intersection_sup_eq K S N hgen hSN]
    exact sup_le_sup_right hNQ S
  have hQSN : Q ⊔ S ≤ N := hmax.2
    (characteristicTwo_sup_of_normalizes Q S hS hnQ (hcores Q hBQ hQK hnQ)) hNQS
  have hQN : Q ≤ N := le_sup_left.trans hQSN
  have he : N ⊓ K = Q := le_antisymm hNQ (le_inf hQN hQK.le)
  rw [he]
  refine ⟨hBQ, hQK, hnQ, ?_⟩
  intro R hBR hRK hnR hQR
  have hNR : N ≤ R ⊔ S := hNQS.trans (sup_le_sup_right hQR S)
  have hRN : R ≤ N := le_sup_left.trans (hmax.2
    (characteristicTwo_sup_of_normalizes R S hS hnR (hcores R hBR hRK hnR)) hNR)
  exact (le_inf hRN hRK.le).trans he.le

end CFSG.Quasithin.Chapter15.Section03.RankOne.EvenModels.ParabolicInspection
