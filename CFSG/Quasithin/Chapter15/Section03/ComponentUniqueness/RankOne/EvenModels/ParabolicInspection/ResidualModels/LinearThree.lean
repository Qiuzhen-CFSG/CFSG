module

public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.RankOne.EvenModels.ParabolicInspection.ResidualModels.Data
public import Theory.SpecificGroups.PSL3.LinearThreeSylow.ThreeResidualOvergroups
public import Theory.SpecificGroups.PSL3.LinearThreeSylow.BorelStructure

/-!
# The PSL₃ branch of the larger-field residual inspection

Work in the actual component action image, canonically isomorphic to L/Z(L).
A non-Borel Sylow overgroup in PSL₃ contains an SL₂ generated by its
three-elements, contradicting solvability of the supplied O^{3′} residual.
The parabolic's Borel containment gives equality. The actor's two-core has
index three, whereas the Borel order is prime to three in odd field degree;
therefore the degree is even.

No trivial-center hypothesis is used: in particular the nontrivial central
two-covers of PSL₃(4) remain in this branch.

Source: Aschbacher--Smith, combined manuscript (1 March 2004), 15.3.43,
printed p.1140, and 1.1.5(3)(a)--(b), printed pp.501--502.
-/

public section

open Subgroup
open CFSG.Quasithin.ChapterF.Source
namespace CFSG.Quasithin.Chapter15.Section03.RankOne.EvenModels.ParabolicInspection

variable {G : Type*} [Group G] [Finite G]
variable {Yplus S M I L V₁ V₂ : Subgroup G}
variable (c : ReducedConfiguration Yplus S M I L V₁ V₂)

omit [Finite G] c in
private theorem marked_sylow_eq {Q : Type*} [Group Q] (A T : Subgroup Q)
    (P : Sylow 2 A) (hP : (P : Subgroup A).map A.subtype = T ⊓ A) :
    T.subgroupOf A = P := by
  apply Subgroup.map_injective A.subtype_injective
  rw [subgroupOf_map_subtype, hP]

omit [Finite G] c in
private theorem marked_borel_eq {Q : Type*} [Group Q] (A T : Subgroup Q)
    (P : Sylow 2 A) (hP : (P : Subgroup A).map A.subtype = T ⊓ A) :
    (borel A T).subgroupOf A = normalizer (P : Set A) := by
  rw [borel, inf_subgroupOf_left, subgroupOf_normalizer_eq inf_le_right,
    inf_subgroupOf_right, marked_sylow_eq A T P hP]
  rfl

omit [Finite G] c in
private theorem residual_solvable_equiv {A B : Type*} [Group A] [Group B]
    (e : A ≃* B) (h : Group.IsSolvable (primePowerGenerated 3 A)) :
    Group.IsSolvable (primePowerGenerated 3 B) := by
  let := h
  have hs : Group.IsSolvable ((primePowerGenerated 3 A).map e.toMonoidHom) :=
    Group.isSolvable_of_surjective (e.toMonoidHom.subgroupMap_surjective _)
  rwa [map_primePowerGenerated_equiv] at hs

private theorem linearThree_quotient_intersection {n : ℕ} (hn : 1 < n)
    (hp : QuotientParabolic c)
    (hm : ClassicalGroup.IsPSL (L ⧸ center L) 3 (2 ^ n)) :
    c.toComponentAction.image M ⊓ c.toComponentAction.image L =
      borel (c.toComponentAction.image L) (c.toComponentAction.image S) := by
  obtain ⟨F, hF, hfin, hcard, ⟨e⟩⟩ := hm
  let f := c.toComponentAction.centerQuotientEquiv.symm.trans e
  let A := c.toComponentAction.image L
  let X := c.toComponentAction.image M ⊓ A
  let H := (c.toComponentAction.image M).subgroupOf A
  let eX : H ≃* X :=
    (MulEquiv.subgroupCongr (inf_subgroupOf_right (c.toComponentAction.image M) A).symm).trans
      (subgroupOfEquivOfLe (show c.toComponentAction.image M ⊓ A ≤ A from inf_le_right))
  let eH := equivMapOfInjective H f.toMonoidHom f.injective
  have hs : Group.IsSolvable (primePowerGenerated 3 X) := by
    let : Group.IsSolvable ((primePowerGenerated 3 X).map X.subtype) :=
      quotient_parabolic_residual_solvable c
    let eR := equivMapOfInjective (primePowerGenerated 3 X) X.subtype X.subtype_injective
    exact Group.isSolvable_of_isSolvable_injective (f := eR.toMonoidHom) eR.injective
  have ht := residual_solvable_equiv (eX.symm.trans eH) hs
  obtain ⟨P, hP⟩ := quotient_component_sylow c
  let T := P.mapSurjective (f := f.toMonoidHom) f.surjective
  have hPH : (P : Subgroup A) ≤ H := by
    rw [← marked_sylow_eq A (c.toComponentAction.image S) P hP]
    exact fun x hx => (map_mono (show S.subgroupOf I ≤ M.subgroupOf I from
      fun _ hs => c.sylow_le_M hs)) hx
  have hnorm := Matrix.PSL3.LinearThree.ThreeResidualOvergroups.solvable_residual_overgroup_le_normalizer
    F (by omega : 2 ≤ n) hcard T (H.map f.toMonoidHom) ht (map_mono hPH)
  change H.map f.toMonoidHom ≤
    normalizer ((P : Subgroup A).map f.toMonoidHom : Set _) at hnorm
  rw [← map_equiv_normalizer_eq] at hnorm
  have hle := (map_le_map_iff_of_injective f.injective).mp hnorm
  change H ≤ normalizer (P : Set A) at hle
  rw [← marked_borel_eq A (c.toComponentAction.image S) P hP] at hle
  have hmap := map_mono (f := A.subtype) hle
  rw [subgroupOf_map_subtype, map_subgroupOf_eq_of_le
    (show borel A (c.toComponentAction.image S) ≤ A from inf_le_left)] at hmap
  exact le_antisymm hmap hp.contains_borel

private theorem linearThree_quotient_even {n : ℕ}
    (hm : ClassicalGroup.IsPSL (L ⧸ center L) 3 (2 ^ n))
    (hB : c.toComponentAction.image M ⊓ c.toComponentAction.image L =
      borel (c.toComponentAction.image L) (c.toComponentAction.image S)) : Even n := by
  obtain ⟨F, hF, hfin, hcard, ⟨e⟩⟩ := hm
  let f := c.toComponentAction.centerQuotientEquiv.symm.trans e
  let A := c.toComponentAction.image L
  obtain ⟨P, hP⟩ := quotient_component_sylow c
  let T := P.mapSurjective (f := f.toMonoidHom) f.surjective
  have he : (normalizer (P : Set A)).map f.toMonoidHom = normalizer (T : Set _) :=
    map_equiv_normalizer_eq (P : Subgroup A) f
  let eN : normalizer (P : Set A) ≃* normalizer (T : Set _) :=
    (equivMapOfInjective _ f.toMonoidHom f.injective).trans (MulEquiv.subgroupCongr he)
  have h3Y : 3 ∣ Nat.card (c.toComponentAction.image Yplus) :=
    quotient_actor_index c ▸ (pCore 2 (c.toComponentAction.image Yplus)).index_dvd_card
  have hYB : c.toComponentAction.image Yplus ≤ borel A (c.toComponentAction.image S) := by
    rw [← hB, quotient_residual_on_component c]
    rintro x ⟨y, hy, rfl⟩
    exact y.property
  have h3B := h3Y.trans (Subgroup.card_dvd_of_le hYB)
  have hBc : Nat.card (borel A (c.toComponentAction.image S)) =
      Nat.card (normalizer (T : Set (Matrix.ProjectiveSpecialLinearGroup (Fin 3) F))) := by
    rw [← Nat.card_congr (subgroupOfEquivOfLe
      (show borel A (c.toComponentAction.image S) ≤ A from inf_le_left)).toEquiv,
      marked_borel_eq A (c.toComponentAction.image S) P hP, Nat.card_congr eN.toEquiv]
  rw [hBc] at h3B
  by_contra hn
  exact Matrix.PSL3.LinearThree.BorelStructure.three_not_dvd_card_sylowNormalizer_of_odd
    F (Nat.not_even_iff_odd.mp hn) hcard T h3B

/-- The PSL₃ residual inspection in the central quotient, retaining all central two-covers. -/
theorem linearThree_residual_inspection {n : ℕ} (hn : 1 < n)
    (hp : QuotientParabolic c)
    (hm : ClassicalGroup.IsPSL (L ⧸ center L) 3 (2 ^ n)) :
    Even n ∧ c.toComponentAction.image M ⊓ c.toComponentAction.image L =
      borel (c.toComponentAction.image L) (c.toComponentAction.image S) := by
  have hB := linearThree_quotient_intersection c hn hp hm
  exact ⟨linearThree_quotient_even c hm hB, hB⟩

end CFSG.Quasithin.Chapter15.Section03.RankOne.EvenModels.ParabolicInspection
