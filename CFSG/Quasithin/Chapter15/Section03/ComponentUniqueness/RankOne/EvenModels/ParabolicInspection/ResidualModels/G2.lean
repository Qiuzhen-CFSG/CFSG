/-!
# G₂ exclusions in the larger-field parabolic residual inspection

In even field degree, the two split-torus coordinates give an elementary nine
in the Borel, contradicting the three-rank bound on the actual parabolic.
For the remaining degrees, the source four-group survives faithfully in the
component action quotient and supplies a nontrivial normal two-subgroup in the
local intersection. G₂ normalizer geometry puts this intersection in a root
parabolic. Sylow-stabilizer invariance and the supplied invariant maximality
identify it with that full parabolic.

Each root parabolic contains its concrete local subgroup with a surjection
onto SL₂. The latter is simple, perfect, and generated by its three-elements,
so the parabolic's O^{3′} cannot be solvable. This uses the prime-power-generated
residual throughout. The two incoming source alternatives are transported by
the actual component map and the actual central-quotient equivalence;
in particular the central G₂(4) covers are retained until the torus obstruction.

Source: Aschbacher--Smith, combined manuscript (1 March 2004), 15.3.43,
printed p.1140; 1.1.5(3)(a)--(b), pp.501--502; A.2.3--4, p.33.
The concrete octonion root, torus, and parabolic calculations are supplied by
the licensed ATLAS port; see LICENSES/ATLAS.txt and LICENSES/ATLAS-CITATION.cff.
-/

public section

open Subgroup
open CFSG.Quasithin.Chapter15.Section03.RankOne
open Atlas.G2 Atlas.G2.LieParabolicSetup
open scoped MatrixGroups
namespace CFSG.Quasithin.Chapter15.Section03.RankOne.EvenModels.ParabolicInspection.G2Residual

private theorem top_threeResidual {A : Type*} [Group A] :
    threeResidualIn (⊤ : Subgroup A) = primePowerGenerated 3 A := by
  rw [threeResidualIn, map_primePowerGenerated_subtype]
  congr 1
  ext a
  simp

private theorem map_threeGenerated {A B : Type*} [Group A] [Group B] [Finite A]
    (f : A →* B) (hf : Function.Surjective f) :
    (primePowerGenerated 3 A).map f = primePowerGenerated 3 B := by
  have h := threeResidualIn_map (⊤ : Subgroup A) f
  rwa [top_threeResidual, map_top_of_surjective _ hf, top_threeResidual] at h

private theorem residual_solvable_of_injective {A B : Type*} [Group A] [Group B]
    (f : A →* B) (hf : Function.Injective f) [Group.IsSolvable (primePowerGenerated 3 B)] :
    Group.IsSolvable (primePowerGenerated 3 A) := by
  let g : primePowerGenerated 3 A →* primePowerGenerated 3 B :=
    (f.comp (primePowerGenerated 3 A).subtype).codRestrict _
      (fun a => map_primePowerGenerated_le 3 f (mem_map_of_mem f a.property))
  exact Group.isSolvable_of_isSolvable_injective (f := g)
    (fun a b h => Subtype.ext (hf (congrArg Subtype.val h)))

private theorem residual_solvable_of_surjective {A B : Type*} [Group A] [Group B] [Finite A]
    (f : A →* B) (hf : Function.Surjective f) [Group.IsSolvable (primePowerGenerated 3 A)]
    (hB : primePowerGenerated 3 B = ⊤) : Group.IsSolvable B := by
  let g := f.comp (primePowerGenerated 3 A).subtype
  apply Group.isSolvable_of_surjective (f := g)
  intro b
  have hb : b ∈ (primePowerGenerated 3 A).map f := by
    rw [map_threeGenerated f hf, hB]
    trivial
  obtain ⟨a, ha, he⟩ := hb
  exact ⟨⟨a, ha⟩, he⟩

variable {F : Type*} [Field F] [Finite F] [CharP F 2]

private theorem field_four (hq : 2 < Nat.card F) : 4 ≤ Nat.card F := by
  obtain ⟨n, hn, he⟩ := field_card (F := F)
  have hn2 : 2 ≤ n := by
    by_contra h
    have : n = 1 := by omega
    simp [this] at he
    omega
  rw [he]
  exact pow_le_pow_right₀ (by decide : (1 : ℕ) ≤ 2) hn2

private theorem sl_threeGenerated (hq : 2 < Nat.card F) :
    primePowerGenerated 3 SL(2,F) = ⊤ := by
  let : IsSimpleGroup PSL(2,F) := Matrix.ProjectiveSpecialLinearGroup.rank_two_simple (field_four hq)
  let : IsSimpleGroup SL(2,F) := (longSLEquivPSL (F := F)).isSimpleGroup
  let x : SL(2,F) := ⟨!![0,-1;1,-1], by simp [Matrix.det_fin_two]⟩
  have hx : x ^ 3 = 1 := by
    apply Subtype.ext
    change (!![0,-1;1,-1] : Matrix (Fin 2) (Fin 2) F) ^ 3 = 1
    ext i j
    fin_cases i <;> fin_cases j <;> norm_num [pow_succ, Matrix.mul_apply, Fin.sum_univ_two]
  have hxne : x ≠ 1 := by
    intro h
    have he := congrArg (fun a : SL(2,F) => a 0 1) h
    simp [x] at he
  rcases (inferInstance : (primePowerGenerated 3 SL(2,F)).Normal).eq_bot_or_eq_top with h | h
  · exact (hxne (h.le (mem_primePowerGenerated_of_pow (n := 1)
      (by simpa only [pow_one] using hx)))).elim
  · exact h

/-- A full root parabolic has nonsolvable prime-to-three residual: its local
subgroup surjects onto the nontrivial perfect SL₂, generated by three-elements. -/
private theorem parabolic_residual_not_solvable (hq : 2 < Nat.card F) (i : Fin 2) :
    ¬ Group.IsSolvable (threeResidualIn
      (if i = 0 then parabolic₁ (F := F) else parabolic₂)) := by
  intro hs
  let P : Subgroup (Atlas.G2.Model F) := if i = 0 then parabolic₁ else parabolic₂
  let : Group.IsSolvable ((primePowerGenerated 3 P).map P.subtype) := hs
  let : Group.IsSolvable (primePowerGenerated 3 P) :=
    Group.isSolvable_of_isSolvable_injective
      (f := ((primePowerGenerated 3 P).equivMapOfInjective P.subtype P.subtype_injective).toMonoidHom)
      ((primePowerGenerated 3 P).equivMapOfInjective P.subtype P.subtype_injective).injective
  let : Group.IsPerfect (local₁ (F := F)) := local₁_isPerfect hq
  let : Group.IsPerfect SL(2,F) := Group.IsPerfect.ofSurjective shortSLHom_surjective
  let : Nontrivial SL(2,F) := (longSLEquivPSL (F := F)).toEquiv.nontrivial
  apply Group.IsPerfect.not_isSolvable SL(2,F)
  fin_cases i
  · have hle : local₁ (F := F) ≤ P := by
      change local₁ ≤ parabolic₁
      rw [← local₁_sup_borel]
      exact le_sup_left
    let : Group.IsSolvable (primePowerGenerated 3 (local₁ (F := F))) :=
      residual_solvable_of_injective (inclusion hle) (inclusion_injective hle)
    exact residual_solvable_of_surjective shortSLHom shortSLHom_surjective (sl_threeGenerated hq)
  · have hle : local₂ (F := F) ≤ P := by
      change local₂ ≤ parabolic₂
      rw [← local₂_sup_borel]
      exact le_sup_left
    let : Group.IsSolvable (primePowerGenerated 3 (local₂ (F := F))) :=
      residual_solvable_of_injective (inclusion hle) (inclusion_injective hle)
    exact residual_solvable_of_surjective longSLHom longSLHom_surjective (sl_threeGenerated hq)

end CFSG.Quasithin.Chapter15.Section03.RankOne.EvenModels.ParabolicInspection.G2Residual


open Subgroup
open CFSG.Quasithin.Chapter15.Section03.RankOne
open Theory.GroupTheory
namespace CFSG.Quasithin.Chapter15.Section03.RankOne.EvenModels.ParabolicInspection.G2Residual
variable {F : Type*} [Field F] [Finite F] [CharP F 2]

omit [CharP F 2] in
/-- The two actual split-torus coordinates give an elementary nine in even degree. -/
private theorem borel_threeRank {n : ℕ} (hF : Nat.card F = 2 ^ n) (he : Even n) :
    2 ≤ primeRank 3 (Atlas.G2.borel (K := F)) := by
  obtain ⟨u, hu⟩ := exists_prime_orderOf_dvd_card' (G := Fˣ) 3 (by
    rw [Nat.card_units, hF]
    exact (Nat.BinaryTorusParity.three_dvd_sub_one_iff n).mpr he)
  let C := zpowers u
  have hC : Nat.card C = 3 := (Nat.card_zpowers u).trans hu
  let f : C × C →* Atlas.G2.borel (K := F) :=
    Atlas.G2.EvenBorelTorus.torusSection.comp (C.subtype.prodMap C.subtype)
  have hf : Function.Injective f := by
    intro x y h
    have he := congrArg Atlas.G2.EvenBorelTorus.projection h
    change Atlas.G2.EvenBorelTorus.projection
      (Atlas.G2.EvenBorelTorus.torusSection ((x.1 : Fˣ), (x.2 : Fˣ))) =
      Atlas.G2.EvenBorelTorus.projection
      (Atlas.G2.EvenBorelTorus.torusSection ((y.1 : Fˣ), (y.2 : Fˣ))) at he
    have hproj (a : Fˣ × Fˣ) : Atlas.G2.EvenBorelTorus.projection
        (Atlas.G2.EvenBorelTorus.torusSection a) = a :=
      Atlas.G2.EvenBorelTorus.projection_torus a
    rw [hproj, hproj] at he
    exact Prod.ext (Subtype.ext (congrArg Prod.fst he)) (Subtype.ext (congrArg Prod.snd he))
  have hp : ∀ x : C × C, x ^ 3 = 1 := by
    intro x
    apply Prod.ext
    · simpa [hC] using (pow_card_eq_one' (x := x.1))
    · simpa [hC] using (pow_card_eq_one' (x := x.2))
  apply primeRank_ge_of_elementary_embedding hp _ f hf
  rw [Nat.card_prod, hC]
  norm_num

variable {G : Type*} [Group G] [Finite G]
variable {Yplus S M I L V₁ V₂ : Subgroup G}
variable (c : ReducedConfiguration Yplus S M I L V₁ V₂)

/-- In even degree Borel containment already contradicts the source three-rank bound. -/
private theorem even_degree_exclusion {n : ℕ} (hF : Nat.card F = 2 ^ n) (he : Even n)
    (hp : QuotientParabolic c) (e : c.toComponentAction.image L ≃* Atlas.G2.Model F) : False := by
  let K := c.toComponentAction.image L
  let T := c.toComponentAction.image S
  obtain ⟨Q, hQ⟩ := quotient_component_sylow c
  have hQeq : T.subgroupOf K = (Q : Subgroup K) := by
    apply map_injective K.subtype_injective
    rw [subgroupOf_map_subtype, hQ]
  have hB : (ChapterF.Source.borel K T).subgroupOf K = normalizer (Q : Set K) := by
    rw [ChapterF.Source.borel, inf_subgroupOf_left, subgroupOf_normalizer_eq inf_le_right,
      inf_subgroupOf_right, hQeq]
    rfl
  let R := Q.mapSurjective (f := e.toMonoidHom) e.surjective
  have heN : (normalizer (Q : Set K)).map e.toMonoidHom =
      normalizer (R : Set (Atlas.G2.Model F)) := map_equiv_normalizer_eq (Q : Subgroup K) e
  let f : ChapterF.Source.borel K T ≃* Atlas.G2.borel (K := F) :=
    (subgroupOfEquivOfLe (show ChapterF.Source.borel K T ≤ K from inf_le_left)).symm.trans
      ((MulEquiv.subgroupCongr hB).trans
        (((equivMapOfInjective _ e.toMonoidHom e.injective).trans
          (MulEquiv.subgroupCongr heN)).trans (Atlas.G2.EvenBorelTorus.sylowNormalizerEquiv R)))
  have h2 := borel_threeRank hF he
  have h2' := h2.trans (primeRank_le_of_injective 3 f.symm.toMonoidHom f.symm.injective)
  have h1 := (primeRank_le_of_injective 3 (inclusion hp.contains_borel)
    (inclusion_injective hp.contains_borel)).trans (quotient_parabolic_threeRank c)
  exact (by omega : ¬ (2 : ℕ) ≤ 1) (h2'.trans h1)

end CFSG.Quasithin.Chapter15.Section03.RankOne.EvenModels.ParabolicInspection.G2Residual


open Subgroup
open CFSG.Quasithin.Chapter15.Section03.RankOne
open CFSG.Quasithin.ChapterF.Source
namespace CFSG.Quasithin.Chapter15.Section03.RankOne.EvenModels.ParabolicInspection.G2Residual
open Atlas.G2 Atlas.G2.LieParabolicSetup Atlas.G2.SylowParabolicRecognition

variable {G : Type*} [Group G] [Finite G]
variable {Yplus S M I L V₁ V₂ : Subgroup G}
variable (c : ReducedConfiguration Yplus S M I L V₁ V₂)

omit [Finite G] in
private theorem intersection_core_ne_bot :
    pCore 2 ((c.toComponentAction.image M).subgroupOf (c.toComponentAction.image L)) ≠ ⊥ := by
  let K := c.toComponentAction.image L
  let N := c.toComponentAction.image M
  let R := c.toComponentAction.image V₂
  obtain ⟨⟨e⟩, hRN, hn, hcomm⟩ := c.four_group_image
  have hYK : c.toComponentAction.image Yplus ≤ c.toComponentAction.image L :=
    map_mono (fun _ hx => c.y_le_component hx)
  have hRK : R ≤ K := by
    change c.toComponentAction.image V₂ ≤ c.toComponentAction.image L
    rw [← hcomm]
    exact (commutator_mono le_rfl hYK).trans
      (commutator_le_right _ _)
  have hRP : R ≤ N ⊓ K := le_inf hRN hRK
  have hnorm : N ⊓ K ≤ normalizer (R : Set c.toComponentAction.Quotient) :=
    inf_le_left.trans ((normal_subgroupOf_iff_le_normalizer hRN).mp hn)
  let : (R.subgroupOf (N ⊓ K)).Normal := normal_subgroupOf_of_le_normalizer hnorm
  have hc : Nat.card (R.subgroupOf (N ⊓ K)) = 4 :=
    (Nat.card_congr (subgroupOfEquivOfLe hRP).toEquiv).trans
      ((Nat.card_congr e.toEquiv).symm.trans c.plane_two_card)
  have hRcore : R.subgroupOf (N ⊓ K) ≤ pCore 2 (N ⊓ K : Subgroup _) :=
    le_sSup ⟨inferInstance, IsPGroup.of_card (n := 2) (by simpa using hc)⟩
  have hcore : pCore 2 (N ⊓ K : Subgroup _) ≠ ⊥ := by
    intro h
    have he := bot_unique (hRcore.trans_eq h)
    have hc1 := Subgroup.card_eq_one.mpr he
    omega
  let eJ : N.subgroupOf K ≃* (N ⊓ K : Subgroup _) :=
    (MulEquiv.subgroupCongr (inf_subgroupOf_right N K).symm).trans
      (subgroupOfEquivOfLe (show N ⊓ K ≤ K from inf_le_right))
  intro h
  apply hcore
  rw [← pCore_map_iso 2 eJ, h, Subgroup.map_bot]

private theorem map_conj_subgroupOf {A : Type*} [Group A] [Finite A]
    (K T : Subgroup A) [K.Normal] (s : A) (hs : s ∈ normalizer (T : Set A)) :
    (T.subgroupOf K).map (MulAut.conjNormal (H := K) s).toMonoidHom = T.subgroupOf K := by
  apply Subgroup.eq_of_le_of_card_ge
  · rintro _ ⟨x, hx, rfl⟩
    exact (hs (x : A)).mp hx
  · rw [card_map_of_injective (f := (MulAut.conjNormal (H := K) s).toMonoidHom)
      (MulAut.conjNormal (H := K) s).injective]

/-- The actual quotient intersection is a full root parabolic in a Sylow marking. -/
private theorem marking {F : Type*} [Field F] [Finite F] [CharP F 2]
    (hq : 2 < Nat.card F) (hp : QuotientParabolic c)
    (e : c.toComponentAction.image L ≃* Atlas.G2.Model F) :
    ∃ (f : c.toComponentAction.image L ≃* Atlas.G2.Model F) (i : Fin 2),
      ((c.toComponentAction.image M).subgroupOf (c.toComponentAction.image L)).map
        f.toMonoidHom = (if i = 0 then parabolic₁ else parabolic₂) := by
  let K := c.toComponentAction.image L
  let T := c.toComponentAction.image S
  let N := c.toComponentAction.image M
  let J := N.subgroupOf K
  let D := commutator (Atlas.G2.Model F)
  let : Group.IsPerfect (Atlas.G2.Model F) := Atlas.G2.isPerfect hq
  have ht : commutator (Atlas.G2.Model F) = ⊤ := Group.IsPerfect.commutator_eq_top
  let t : D ≃* Atlas.G2.Model F := (MulEquiv.subgroupCongr ht).trans topEquiv
  let eD := e.trans t.symm
  obtain ⟨Q, hQ⟩ := quotient_component_sylow c
  have hQeq : (Q : Subgroup K) = T.subgroupOf K := by
    apply map_injective K.subtype_injective
    rw [hQ, subgroupOf_map_subtype]
  have hTN : T ≤ N := map_mono (fun _ hx => c.sylow_le_M hx)
  have hQJ : (Q : Subgroup K) ≤ J := by
    rw [hQeq]
    exact fun _ hx => hTN hx
  obtain ⟨f, i, hQf, hJP⟩ := exists_aligned_parabolic_of_twoCore eD Q J hQJ
    (intersection_core_ne_bot c)
  let : IsSimpleGroup K := c.quotient.simple
  let : IsSimpleGroup D := eD.symm.isSimpleGroup
  let : Group.IsPerfect D := Group.IsPerfect.ofSurjective (f := t.symm.toMonoidHom) t.symm.surjective
  have hDcore : pCore 2 D = ⊥ := by
    rcases (inferInstance : (pCore 2 D).Normal).eq_bot_or_eq_top with h | h
    · exact h
    · have htwo : IsPGroup 2 D :=
        pCore_isPGroup.of_equiv ((MulEquiv.subgroupCongr h).trans topEquiv)
      let : Group.IsNilpotent D := htwo.isNilpotent
      exact (Group.IsPerfect.not_isSolvable D inferInstance).elim
  have fixed (s : c.toComponentAction.Quotient) (hs : s ∈ T) (j : Fin 2) :
      ((rootParabolic j).map (K.subtype.comp f.symm.toMonoidHom)).map
          (MulAut.conj s).toMonoidHom =
        (rootParabolic j).map (K.subtype.comp f.symm.toMonoidHom) := by
    let b := MulAut.conjNormal (H := K) s
    let β : MulAut D := (f.symm.trans b).trans f
    have transport (A : Subgroup K) :
        (A.map f.toMonoidHom).map β.toMonoidHom =
          (A.map b.toMonoidHom).map f.toMonoidHom := by
      rw [map_map, map_map]
      congr 1
      apply MonoidHom.ext
      intro x
      change f (b (f.symm (f x))) = f (b x)
      rw [f.symm_apply_apply]
    have hQb : (Q : Subgroup K).map b.toMonoidHom = Q := by
      rw [hQeq]
      exact map_conj_subgroupOf K T s (T.le_normalizer hs)
    have hU : (unipotent.subgroupOf D).map β.toMonoidHom = unipotent.subgroupOf D := by
      rw [← hQf, transport, hQb]
    have hPi := rootParabolic_invariant β hU j
    let m : D →* c.toComponentAction.Quotient := K.subtype.comp f.symm.toMonoidHom
    have hcomp : m.comp β.toMonoidHom = (MulAut.conj s).toMonoidHom.comp m := by
      ext x
      change ((f.symm (f (b (f.symm x))) : K) : c.toComponentAction.Quotient) =
        s * ((f.symm x : K) : c.toComponentAction.Quotient) * s⁻¹
      rw [f.symm_apply_apply]
      rfl
    change ((rootParabolic j).map m).map (MulAut.conj s).toMonoidHom =
      (rootParabolic j).map m
    rw [map_map, ← hcomp, ← map_map, hPi]
  let P := (rootParabolic i).map (K.subtype.comp f.symm.toMonoidHom)
  have hPmap : P.subgroupOf K = (rootParabolic i).map f.symm.toMonoidHom := by
    change (((rootParabolic i).map (K.subtype.comp f.symm.toMonoidHom)).comap K.subtype) = _
    rw [← map_map, comap_map_eq_self_of_injective K.subtype_injective]
  have hPK : P ≤ K := by
    change (rootParabolic i).map (K.subtype.comp f.symm.toMonoidHom) ≤ K
    rw [← map_map]
    exact map_subtype_le _
  have hNP : N ⊓ K ≤ P := by
    intro x hx
    have hm := hJP (mem_map_of_mem f.toMonoidHom (show (⟨x, hx.2⟩ : K) ∈ J from hx.1))
    exact ⟨f ⟨x, hx.2⟩, hm, by simp⟩
  have hPne : P ≠ K := by
    intro he
    have htop : (rootParabolic (F := F) i).map f.symm.toMonoidHom = ⊤ := by
      rw [← hPmap, he, subgroupOf_self]
    exact rootParabolic_ne_top hDcore i
      (f.symm.mapSubgroup.injective (htop.trans f.symm.mapSubgroup.map_top.symm))
  have hPN : P ≤ N ⊓ K := hp.maximal P (hp.contains_borel.trans hNP)
    (lt_of_le_of_ne hPK hPne)
    (fun s hs => mem_normalizer_iff_map_conj_eq.mpr (fixed s hs i)) hNP
  have he : P = N ⊓ K := le_antisymm hPN hNP
  have hmark : J.map f.toMonoidHom = rootParabolic i := by
    apply (map_injective (f := f.symm.toMonoidHom) f.symm.injective)
    rw [map_map]
    have hm : f.symm.toMonoidHom.comp f.toMonoidHom = MonoidHom.id K := by
      apply MonoidHom.ext
      intro x
      exact f.symm_apply_apply x
    rw [hm, map_id, ← hPmap, he, inf_subgroupOf_right]
  refine ⟨f.trans t, i, ?_⟩
  change J.map (t.toMonoidHom.comp f.toMonoidHom) = _
  rw [← map_map, hmark]
  change ((if i = 0 then parabolic₁ else parabolic₂).subgroupOf D).map D.subtype = _
  exact map_subgroupOf_eq_of_le (le_top.trans ht.ge)
end CFSG.Quasithin.Chapter15.Section03.RankOne.EvenModels.ParabolicInspection.G2Residual

open Subgroup
namespace CFSG.Quasithin.Chapter15.Section03.RankOne.EvenModels.ParabolicInspection
variable {G : Type*} [Group G] [Finite G]
variable {Yplus S M I L V₁ V₂ : Subgroup G}
variable (c : ReducedConfiguration Yplus S M I L V₁ V₂)

/-- The residual obstruction on the actual image of the component. -/
theorem g2_quotient_residual_exclusion {n : ℕ} (hn : 1 < n)
    (hp : QuotientParabolic c)
    (hm : ClassificationModels.IsG2At (c.toComponentAction.image L) (2 ^ n)) : False := by
  obtain ⟨F, hF, hfin, hcard, ⟨e⟩⟩ := hm
  let := Fintype.ofFinite F
  let : CharP F 2 := charP_of_card_eq_prime_pow
    (by simpa only [Nat.card_eq_fintype_card] using hcard)
  by_cases heven : Even n
  · exact G2Residual.even_degree_exclusion c hcard heven hp e
  have hq : 2 < Nat.card F := by
    rw [hcard]
    exact lt_of_lt_of_le (by decide : 2 < 2 ^ 2)
      (pow_le_pow_right₀ (by decide : (1 : ℕ) ≤ 2) hn)
  obtain ⟨f, i, hmark⟩ := G2Residual.marking c hq hp e
  let K := c.toComponentAction.image L
  let N := c.toComponentAction.image M
  let J := N.subgroupOf K
  have hR : (threeResidualIn J).map K.subtype = threeResidualIn (N ⊓ K) := by
    rw [threeResidualIn_map, subgroupOf_map_subtype]
  let er := ((threeResidualIn J).equivMapOfInjective K.subtype K.subtype_injective).trans
    (MulEquiv.subgroupCongr hR)
  let : Group.IsSolvable (threeResidualIn (N ⊓ K)) := quotient_parabolic_residual_solvable c
  let : Group.IsSolvable (threeResidualIn J) :=
    Group.isSolvable_of_isSolvable_injective (f := er.toMonoidHom) er.injective
  apply G2Residual.parabolic_residual_not_solvable hq i
  rw [← hmark, ← threeResidualIn_map]
  exact Group.isSolvable_of_surjective (f.toMonoidHom.subgroupMap_surjective (threeResidualIn J))

/-- Exclusion of the simple G₂(2ⁿ) alternative in 1.1.5(3a). -/
theorem g2_residual_exclusion {n : ℕ} (hn : 1 < n)
    (hs : IsSimpleGroup L) (hm : ClassificationModels.IsG2At L (2 ^ n))
    (hp : QuotientParabolic c) : False := by
  let : IsSimpleGroup L := hs
  let : Theory.GroupTheory.IsQuasisimple (L.subgroupOf I) := c.component.2
  let : Group.IsPerfect L := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe c.component_le).toMonoidHom)
    (subgroupOfEquivOfLe c.component_le).surjective
  have hc : center L = ⊥ := by
    rcases (inferInstance : (center L).Normal).eq_bot_or_eq_top with h | h
    · exact h
    · exact (Group.IsPerfect.not_isMulCommutative L (center_eq_top_iff.mp h)).elim
  let e : L ≃* c.toComponentAction.image L :=
    MulEquiv.ofBijective c.toComponentAction.componentMap
      ⟨(MonoidHom.ker_eq_bot_iff _).mp (c.toComponentAction.componentMap_ker.trans hc),
        c.toComponentAction.componentMap_surjective⟩
  exact g2_quotient_residual_exclusion c hn hp (hm.of_mulEquiv e.symm)

/-- Exclusion of the G₂(4) central covers in 1.1.5(3b), through the actual
central-quotient equivalence. No identification of L with its quotient is used. -/
theorem g2_cover_residual_exclusion (_hz : center L ≠ ⊥)
    (hm : ClassificationModels.IsG2At (L ⧸ center L) 4)
    (hp : QuotientParabolic c) : False := by
  exact g2_quotient_residual_exclusion c (n := 2) (by decide) hp
    (hm.of_mulEquiv c.toComponentAction.centerQuotientEquiv.symm)

end CFSG.Quasithin.Chapter15.Section03.RankOne.EvenModels.ParabolicInspection
