private theorem residual_solvable_of_injective {A B : Type*} [Group A] [Group B]
    (f : A →* B) (hf : Function.Injective f)
    (hsol : Group.IsSolvable (primePowerGenerated 3 B)) :
    Group.IsSolvable (primePowerGenerated 3 A) := by
  let _ := hsol
  let j : primePowerGenerated 3 A →* primePowerGenerated 3 B :=
    (f.comp (primePowerGenerated 3 A).subtype).codRestrict _ (fun x =>
      map_primePowerGenerated_le 3 f (mem_map_of_mem _ x.property))
  exact Group.isSolvable_of_isSolvable_injective (f := j)
    (fun a b h => Subtype.ext (hf (congrArg Subtype.val h)))

private theorem sl2_residual_not_solvable {F : Type*} [Field F] [Finite F] [CharP F 2]
    (hF : 2 < Nat.card F) : ¬ Group.IsSolvable (primePowerGenerated 3 SL(2, F)) := by
  let _ := Theory.SpecificGroups.SymplecticFour.NaturalExtension.model_simple hF
  let _ := Theory.SpecificGroups.SymplecticFour.NaturalExtension.model_perfect hF
  have htop : primePowerGenerated 3 SL(2, F) = ⊤ := by
    let x : SL(2, F) := ⟨!![0,1;1,1], by simp [CharTwo.neg_eq]⟩
    have hx : x ^ 3 = 1 := by
      apply Subtype.ext
      change (!![0,1;1,1] : Matrix (Fin 2) (Fin 2) F) ^ 3 = 1
      ext i j
      fin_cases i <;> fin_cases j <;>
        norm_num [pow_succ, Matrix.mul_apply, Fin.sum_univ_two, CharTwo.add_self_eq_zero]
    have hm : x ∈ primePowerGenerated 3 SL(2, F) :=
      mem_primePowerGenerated_of_pow (p := 3) (n := 1) (by simpa using hx)
    rcases (inferInstance : (primePowerGenerated 3 SL(2, F)).Normal).eq_bot_or_eq_top
        with hb | ht
    · rw [hb, mem_bot] at hm
      have he := congrArg (fun g : SL(2, F) => g.val 0 1) hm
      simp [x] at he
    · exact ht
  intro hs
  rw [htop] at hs
  let _ := hs
  exact Group.IsPerfect.not_isSolvable SL(2, F)
    (Group.isSolvable_of_surjective (f := (topEquiv : (⊤ : Subgroup SL(2, F)) ≃*
      SL(2, F)).toMonoidHom) topEquiv.surjective)

private theorem levi_residual_not_solvable (P : Parameters) (hp : P.prime = 2)
    (hq : 2 < P.q) (a : Node) : ¬ Group.IsSolvable (primePowerGenerated 3 (levi P a)) := by
  intro hs
  cases a with
  | arms =>
    let _ : CharP (ExtensionField P) 2 := hp ▸ inferInstanceAs (CharP (ExtensionField P) P.prime)
    let e := (Theory.PSL2.sl2QuotientEquiv (ExtensionField P)).trans
      (leviArmsEquivPSL2 P hp).symm
    apply sl2_residual_not_solvable (F := ExtensionField P) _
      (residual_solvable_of_injective e.toMonoidHom e.injective hs)
    rw [card_extensionField]
    exact hq.trans_le (Nat.le_self_pow (by decide) _)
  | central =>
    let _ : CharP (GaloisField P.prime P.exponent) 2 :=
      hp ▸ inferInstanceAs (CharP (GaloisField P.prime P.exponent) P.prime)
    let e := (Theory.PSL2.sl2QuotientEquiv (GaloisField P.prime P.exponent)).trans
      (leviCentralEquivPSL2 P hp).symm
    apply sl2_residual_not_solvable (F := GaloisField P.prime P.exponent) _
      (residual_solvable_of_injective e.toMonoidHom e.injective hs)
    rwa [GaloisField.card P.prime P.exponent (Nat.ne_of_gt P.exponent_pos)]

private theorem eq_borel_of_residual_solvable (P : Parameters) (hp : P.prime = 2)
    (hq : 2 < P.q) (Q : Subgroup (Carrier P)) (hBQ : borel P ≤ Q)
    (hs : Group.IsSolvable (primePowerGenerated 3 Q)) : Q = borel P := by
  obtain ⟨n, hn, rfl⟩ := (exists_binaryParameters_iff P).mpr hp
  let T := ConcreteBruhat.titsSystem n hn
  have hnot (a : Node) : ¬ parabolic (binaryParameters n hn) a ≤ Q := by
    intro h
    exact levi_residual_not_solvable _ rfl hq a
      (residual_solvable_of_injective (inclusion ((levi_le_parabolic _ a).trans h))
        (inclusion_injective _) hs)
  have he := T.subgroup_eq_standardParabolic_simpleIndices Q hBQ
  have hi : T.simpleIndices Q = ∅ := by
    apply Set.eq_empty_iff_forall_notMem.mpr
    intro s hs
    obtain ⟨hs, hcell⟩ := (T.mem_simpleIndices_iff Q s).mp hs
    rcases (ConcreteBruhat.mem_titsSystem_S_iff n hn s).mp hs with rfl | rfl
    · apply hnot .arms
      rw [ConcreteBruhat.parabolic_eq_standardParabolic]
      exact T.standardParabolic_le Q hBQ (fun _ h => (Set.mem_singleton_iff.mp h) ▸ hcell)
    · apply hnot .central
      rw [ConcreteBruhat.parabolic_eq_standardParabolic]
      exact T.standardParabolic_le Q hBQ (fun _ h => (Set.mem_singleton_iff.mp h) ▸ hcell)
  rw [hi, T.standardParabolic_empty] at he
  exact he

private theorem borel_obstruction (P : Parameters) (hp : P.prime = 2)
    {n : ℕ} (hq : P.q = 2 ^ n) (hr : primeRank 3 (borel P) ≤ 1)
    (hd : 3 ∣ Nat.card (borel P)) : False := by
  by_cases hn : Even n
  · have hfix : 3 ∣ Nat.card (fixedField P)ˣ := by
      rw [Nat.card_units, card_fixedField, hq]
      exact (Nat.BinaryTorusParity.three_dvd_sub_one_iff n).mpr hn
    have hext : 3 ∣ Nat.card (ExtensionField P)ˣ := by
      rw [Nat.card_units, card_extensionField, hq, ← pow_mul]
      exact (Nat.BinaryTorusParity.three_dvd_sub_one_iff (n * 3)).mpr (hn.mul_right 3)
    have hfixr := mt (PrimeRank.eq_zero_iff_not_dvd_card (G := (fixedField P)ˣ)).mp
      (not_not.mpr hfix)
    have hextr := mt (PrimeRank.eq_zero_iff_not_dvd_card (G := (ExtensionField P)ˣ)).mp
      (not_not.mpr hext)
    have ht := primeRank_le_of_injective 3 (inclusion (ConcreteBruhat.torus_le_borel P))
      (inclusion_injective (ConcreteBruhat.torus_le_borel P))
    rw [← primeRank_equiv 3 (ConcreteBruhat.TorusCoordinates.torusMulEquiv P hp),
      primeRank_prod_eq_add] at ht
    omega
  · have hn : Odd n := Nat.not_even_iff_odd.mp hn
    have hc : Nat.card (borel P) = P.q ^ 12 * ((P.q ^ 3 - 1) * (P.q - 1)) := by
      rw [← Nat.card_congr (ConcreteBruhat.borelEquiv P hp), Nat.card_prod,
        card_unipotent_binary P hp, ConcreteBruhat.TorusCoordinates.card_torus P hp]
    have hcop : Nat.Coprime 3 (Nat.card (borel P)) := by
      rw [hc, hq, ← pow_mul, ← pow_mul]
      exact ((by decide : Nat.Coprime 3 2).pow_right (n * 12)).mul_right
        ((Nat.BinaryTorusParity.coprime_three_sub_one (hn.mul (by decide : Odd 3))).mul_right
          (Nat.BinaryTorusParity.coprime_three_sub_one hn))
    exact (Nat.prime_three.coprime_iff_not_dvd.mp hcop) hd

private theorem model_exclusion {H : Type*} [Group H] [Finite H]
    {n : ℕ} (hn : 1 < n) (hm : IsTrialityGroupAt (2 ^ n) H)
    (T : Sylow 2 H) (Q : Subgroup H) (hBQ : normalizer (T : Set H) ≤ Q)
    (hr : primeRank 3 Q ≤ 1) (hd : 3 ∣ Nat.card Q)
    (hs : Group.IsSolvable (primePowerGenerated 3 Q)) : False := by
  obtain ⟨P, hq, ⟨e⟩⟩ := hm
  have hp : P.prime = 2 := by
    apply (Nat.prime_dvd_prime_iff_eq P.prime_prime Nat.prime_two).mp
    apply P.prime_prime.dvd_of_dvd_pow
    rw [← hq]
    exact dvd_pow_self P.prime (Nat.ne_of_gt P.exponent_pos)
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq (Carrier P)
    (T.mapSurjective (f := e.toMonoidHom) e.surjective) (unipotentSylow P hp)
  let e' := e.trans (MulAut.conj g)
  have hTU : (T : Subgroup H).map e'.toMonoidHom = unipotent P := by
    change (T : Subgroup H).map ((MulAut.conj g).toMonoidHom.comp e.toMonoidHom) = _
    rw [← Subgroup.map_map]
    exact congrArg Sylow.toSubgroup hg
  have hB : borel P ≤ Q.map e'.toMonoidHom := by
    rw [← ConcreteBruhat.normalizer_unipotent_eq_borel P hp, ← hTU,
      ← map_equiv_normalizer_eq]
    exact map_mono hBQ
  have hq2 : 2 < P.q := by
    rw [hq]
    calc
      2 < 2 ^ 2 := by decide
      _ ≤ 2 ^ n := Nat.pow_le_pow_right (by decide) hn
  let eQ := equivMapOfInjective Q e'.toMonoidHom e'.injective
  have heq := eq_borel_of_residual_solvable P hp hq2 _ hB
    (residual_solvable_of_injective eQ.symm.toMonoidHom eQ.symm.injective hs)
  apply borel_obstruction P hp hq
  · rw [← heq, ← primeRank_equiv 3 eQ]
    exact hr
  · rw [← heq, ← Nat.card_congr eQ.toEquiv]
    exact hd

end TrialityResidual

open CFSG.Quasithin.ChapterF.Source
variable {G : Type*} [Group G] [Finite G]
variable {Yplus S M I L V₁ V₂ : Subgroup G}

/-- Larger-field genuine triality cannot realize the residual parabolic in
15.3.43. The Borel containment alone suffices; the involution premises are
not needed for this exclusion. -/
theorem triality_residual_exclusion (c : ReducedConfiguration Yplus S M I L V₁ V₂)
    {n : ℕ} (hn : 1 < n) (_hs : IsSimpleGroup L)
    (hm : Triality.Standard.IsTrialityGroupAt (2 ^ n) L)
    (hp : QuotientParabolic c) : False := by
  let A := M ⊓ L
  let Q := M.subgroupOf L
  let e : Q ≃* A := {
    toFun := fun x => ⟨x, x.property, x.val.property⟩
    invFun := fun x => ⟨⟨x, x.property.2⟩, x.property.1⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl
    map_mul' := fun _ _ => rfl }
  obtain ⟨T, hT⟩ := component_sylow c
  have hTQ : normalizer (T : Set L) ≤ Q := by
    have hS : S.subgroupOf L = (T : Subgroup L) := by
      apply Subgroup.map_injective L.subtype_injective
      rw [subgroupOf_map_subtype, hT]
    have he : (borel L S).subgroupOf L = normalizer (T : Set L) := by
      rw [borel, inf_subgroupOf_left, subgroupOf_normalizer_eq inf_le_right,
        inf_subgroupOf_right, hS]
      rfl
    rw [← he]
    intro x hx
    exact (borel_le_intersection c hp hx).1
  have hr : primeRank 3 Q ≤ 1 := by
    rw [Theory.GroupTheory.primeRank_equiv 3 e]
    exact threeRank_le_one_of_residual_index (residual_on_component c) c.index
  have hd : 3 ∣ Nat.card Q := by
    rw [Nat.card_congr e.toEquiv]
    have hYA : Yplus ≤ A := le_inf ((actor_le_local c).trans inf_le_left) c.y_le_component
    exact (c.index ▸ (pCore 2 Yplus).index_dvd_card).trans (card_dvd_of_le hYA)
  let R := primePowerGenerated 3 A
  let f : R →* Yplus := (A.subtype.comp R.subtype).codRestrict _ (fun x => by
    rw [residual_on_component c]
    exact mem_map_of_mem A.subtype x.property)
  have hf : Function.Injective f := by
    intro x y h
    exact Subtype.ext (Subtype.ext (congrArg (fun a : Yplus => (a : G)) h))
  let _ := actor_solvable c
  have hR : Group.IsSolvable R := Group.isSolvable_of_isSolvable_injective hf
  exact TrialityResidual.model_exclusion hn hm T Q hTQ hr hd
    (TrialityResidual.residual_solvable_of_injective e.toMonoidHom e.injective hR)

end CFSG.Quasithin.Chapter15.Section03.RankOne.EvenModels.ParabolicInspection
