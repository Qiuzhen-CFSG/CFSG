module

public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.DiagonalOuter.CoverReduction.LocalCover.SourceResiduals
public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.Candidates.RankAlternatives.DiagonalProduct.LinearCore.MatrixImage
public import Theory.GroupTheory.PGroup.NormalPrimeImage

/-!
# The opposite residual's diagonal action from image generation

The two normal residuals have cyclic quotients of order three and generate
the actual E₉ quotient; their quotient images therefore intersect trivially.
The quotient-action image is generated by the component residual and the
original outer cubic actor. Its intersection with inner automorphisms is
just the image of the component residual. Since the action kernel lies in
O₂(Y), an order-three element of the opposite residual cannot have inner
image. This preserves the original projective marking and does not use
the ambient product, the kernel commutator bound, or centre identification.

Source: Aschbacher--Smith, final paragraph of 15.3.37 and proof of 15.3.38,
combined manuscript (1 March 2004), printed pp.1135--1136.
-/

public section
open Subgroup
open scoped Pointwise MatrixGroups
namespace CFSG.Quasithin.Chapter15.Section03.DiagonalOuter.CoverReduction.LocalCover.SourceResiduals
variable {G : Type*} [Group G] [Finite G]

/-- Disjointness in the literal two-core quotient, using the cyclic residual
quotients and relative normality. No full product with the original y occurs. -/
theorem images_disjoint_of_cyclic_quotients {Y A D : Subgroup G}
    (hAY : A ≤ Y) (hDY : D ≤ Y)
    (hYA : Y ≤ normalizer (A : Set G)) (hYD : Y ≤ normalizer (D : Set G))
    (hA : Nat.card (A ⧸ pCore 2 A) = 3)
    (hD : Nat.card (D ⧸ pCore 2 D) = 3)
    (h9 : Nat.card (Y ⧸ pCore 2 Y) = 9) (hgen : Y = A ⊔ D) :
    Disjoint ((A.subgroupOf Y).map (QuotientGroup.mk' (pCore 2 Y)))
      ((D.subgroupOf Y).map (QuotientGroup.mk' (pCore 2 Y))) := by
  let q := QuotientGroup.mk' (pCore 2 Y)
  let Aq := (A.subgroupOf Y).map q
  let Dq := (D.subgroupOf Y).map q
  let : (A.subgroupOf Y).Normal := normal_subgroupOf_of_le_normalizer hYA
  let : Aq.Normal := (inferInstance : (A.subgroupOf Y).Normal).map q
    (QuotientGroup.mk'_surjective _)
  have hsup : Aq ⊔ Dq = ⊤ := by
    dsimp [Aq, Dq]
    rw [← Subgroup.map_sup, ← subgroupOf_sup hAY hDY, ← hgen, subgroupOf_self]
    exact map_top_of_surjective _ (QuotientGroup.mk'_surjective _)
  have ha := card_image_core_quotient_dvd (q := 2) hAY hYA
  have hd := card_image_core_quotient_dvd (q := 2) hDY hYD
  rw [hA] at ha
  rw [hD] at hd
  have ha' : Nat.card Aq ≤ 3 := Nat.le_of_dvd (by decide) ha
  have hd' : Nat.card Dq ≤ 3 := Nat.le_of_dvd (by decide) hd
  have hprod := card_mul_eq_card_inf_mul_card_sup_of_normalizes Aq Dq
    (by rw [Aq.normalizer_eq_top]; exact le_top)
  rw [hsup, card_top, h9] at hprod
  rw [disjoint_iff, ← card_eq_one]
  change Nat.card (Aq ⊓ Dq : Subgroup _) = 1
  have hpos := Nat.card_pos (α := (Aq ⊓ Dq : Subgroup _))
  have hbound := Nat.mul_le_mul ha' hd'
  nlinarith

/-- Image generation transfers an outer cubic action to the opposite residual.
The only kernel premise is its containment in the original two-core. -/
theorem diagonal_of_image_generation {Y L D : Subgroup G} {q : ℕ}
    (c : ProjectiveMarking L q) (hn : Y ≤ normalizer (L : Set G))
    (y : Y) (hy : c.Diagonal (y : G))
    (himage : (Candidates.LinearCore.quotientAction hn c.equivalence).range ≤
      ((componentPart Y L).subgroupOf Y).map
        (Candidates.LinearCore.quotientAction hn c.equivalence) ⊔
      zpowers (Candidates.LinearCore.quotientAction hn c.equivalence y))
    (hker : (Candidates.LinearCore.quotientAction hn c.equivalence).ker ≤ pCore 2 Y)
    (hdis : Disjoint
      (((componentPart Y L).subgroupOf Y).map (QuotientGroup.mk' (pCore 2 Y)))
      ((D.subgroupOf Y).map (QuotientGroup.mk' (pCore 2 Y))))
    (z : Y) (hzD : (z : G) ∈ D) (hz3 : orderOf (z : G) = 3) :
    c.Diagonal (z : G) := by
  let ρ := Candidates.LinearCore.quotientAction hn c.equivalence
  let A := (componentPart Y L).subgroupOf Y
  let N := MulAut.innerSubgroup PSL(3,c.F)
  let π := QuotientGroup.mk' N
  let : A.Normal := normal_subgroupOf_of_le_normalizer
    (ComponentIntersection.normalizes_intersectionResidual hn)
  have hAinner : A.map ρ ≤ N := by
    rintro _ ⟨a, ha, rfl⟩
    rw [Candidates.LinearCore.MatrixImage.quotientAction_on_component hn c.equivalence a
      ((map_subtype_le _ ha).2)]
    exact ⟨_, rfl⟩
  obtain ⟨hy3, m, hmout, β, hβ, hcompat⟩ := hy
  have hym : ρ y = Matrix.PSL3.OuterSolvable.linearConj c.F m :=
    Candidates.LinearCore.quotientAction_eq_of_compatible hn c.equivalence y β _ hβ hcompat
  have hyout : π (ρ y) ≠ 1 := by
    intro he
    exact hmout (hym ▸ (QuotientGroup.eq_one_iff _).mp he)
  have hycube : y ^ 3 = 1 := by
    apply Subtype.ext
    exact hy3 ▸ pow_orderOf_eq_one (y : G)
  have houterorder : orderOf (π (ρ y)) = 3 := orderOf_eq_prime (by
    rw [← map_pow, ← map_pow, hycube, map_one, map_one]) hyout
  have hylinear : ρ y ∈ Matrix.PSL3.OuterSolvable.innerDiagonal c.F :=
    ⟨m, hym.symm⟩
  have hlinear : ρ z ∈ Matrix.PSL3.OuterSolvable.innerDiagonal c.F :=
    (sup_le (hAinner.trans (Matrix.PSL3.OuterSolvable.inner_le_innerDiagonal c.F))
      (zpowers_le.mpr hylinear)) (himage ⟨z, rfl⟩)
  obtain ⟨m', hm'⟩ := hlinear
  refine ⟨hz3, m', ?_, ?_⟩
  · rw [hm']
    intro hzinner
    have hnorm : zpowers (ρ y) ≤ normalizer (A.map ρ : Set (MulAut PSL(3,c.F))) := by
      apply zpowers_le.mpr
      apply Subgroup.le_normalizer_map ρ
      exact mem_map_of_mem ρ (A.normalizer_eq_top ▸ mem_top y)
    have hzmem : ρ z ∈ (A.map ρ : Set (MulAut PSL(3,c.F))) *
        (zpowers (ρ y) : Set (MulAut PSL(3,c.F))) := by
      rw [← coe_mul_of_right_le_normalizer_left _ _ hnorm]
      exact himage ⟨z, rfl⟩
    obtain ⟨_, ⟨a, ha, rfl⟩, _, hk, he⟩ := hzmem
    obtain ⟨k, rfl⟩ := mem_zpowers_iff.mp hk
    change ρ a * ρ y ^ k = ρ z at he
    have hπa : π (ρ a) = 1 := (QuotientGroup.eq_one_iff _).mpr (hAinner (mem_map_of_mem _ ha))
    have hπz : π (ρ z) = 1 := (QuotientGroup.eq_one_iff _).mpr hzinner
    have hπk : π (ρ y) ^ k = 1 := by
      have hh := congrArg π he
      rw [map_mul, map_zpow, hπa, one_mul, hπz] at hh
      exact hh
    have hdiv := orderOf_dvd_iff_zpow_eq_one.mpr hπk
    rw [houterorder] at hdiv
    have hyorder : orderOf y = 3 := (Subgroup.orderOf_coe y).symm.trans hy3
    have hyk : y ^ k = 1 := orderOf_dvd_iff_zpow_eq_one.mp (hyorder ▸ hdiv)
    have hρeq : ρ a = ρ z := by
      rw [← map_zpow, hyk, map_one, mul_one] at he
      exact he
    have hqeq : QuotientGroup.mk' (pCore 2 Y) a = QuotientGroup.mk' (pCore 2 Y) z := by
      apply QuotientGroup.eq_iff_div_mem.mpr
      apply hker
      change ρ (a / z) = 1
      rw [map_div, hρeq, div_self']
    have hzq : QuotientGroup.mk' (pCore 2 Y) z = 1 := hdis.le_bot
      ⟨hqeq ▸ mem_map_of_mem _ ha, mem_map_of_mem _ hzD⟩
    have hzcore : z ∈ pCore 2 Y := (QuotientGroup.eq_one_iff _).mp hzq
    have hord := (pCore_isPGroup (p := 2) (G := Y)).orderOf_coprime
      (by decide : Nat.Coprime 2 3) ⟨z, hzcore⟩
    have hzorder : orderOf (⟨z, hzcore⟩ : pCore 2 Y) = 3 := by
      rw [Subgroup.orderOf_mk]
      exact (Subgroup.orderOf_coe z).symm.trans hz3
    rw [hzorder] at hord
    norm_num at hord
  · rw [hm']
    exact ⟨L.normalizerMonoidHom ⟨z, hn z.property⟩, fun _ => rfl,
      fun x => (Candidates.LinearCore.quotientAction_apply hn c.equivalence z x).symm⟩

end CFSG.Quasithin.Chapter15.Section03.DiagonalOuter.CoverReduction.LocalCover.SourceResiduals
