module

public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.DiagonalOuter.CentralizerConsequences
public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.DiagonalOuter.CoverReduction.ModelWitnesses
public import Theory.GroupTheory.OrderNineAutomorphisms

/-!
# The ordinary-component step for the graph involution

The normalizer and representative-centralizer geometry gives TI. The known
conjugation of the two graph representatives then embeds the odd core of the
graph centralizer into the local odd core E₉. A perfect group centralizes a
normal subgroup of order dividing nine, since that subgroup has solvable
automorphism group. This discharges the additional premise in I.3.1(2).

`EarlierBalance` retains actual 2-components and the equality of their normal
closures in I.3.1(1), as well as the conditional ordinary-component assertion
in (2). It is an explicit earlier theorem input, not an assertion of balance.
The local 2-component still has to be supplied in the indicated local
centralizer. No fusion from transfer, TI, or global ordinary component is an
input to the graph theorem.

Source: Aschbacher--Smith, combined manuscript of 1 March 2004,
I.3.1--2, printed pp.414--415; proof of 15.3.38, pp.1136--1137.
-/

@[expose] public section

open Subgroup Theory.GroupTheory
open CFSG.Quasithin.ChapterI.Section06To08
namespace CFSG.Quasithin.Chapter15.Section03.DiagonalOuter.CoverReduction.GlobalGeometry

universe u
variable {G : Type u} [Group G]

/-- The source definition: a C-component whose odd-core quotient is quasisimple. -/
def IsTwoComponent (B : Subgroup G) : Prop :=
  B.IsCComponent ∧ IsQuasisimple (B ⧸ pPrimeCore 2 B)

/-- The 2-layer, generated by the source 2-components. -/
def twoLayer (G : Type u) [Group G] : Subgroup G :=
  sSup {B : Subgroup G | IsTwoComponent B}

/-- Exactly the witness and closure assertion of I.3.1(1), and its implication
(2). Normality and centralization are in the local group `H`. -/
def EarlierBalance (κ : GroupClass.{u}) : Prop :=
  ∀ (H : Type u) [Group H] [Finite H], IsKGroup κ H →
    ∀ (P : Subgroup H), IsPGroup 2 P →
    ∀ (B : Subgroup (centralizer (P : Set H))), IsTwoComponent B →
      ∃ K : Subgroup H, IsTwoComponent K ∧
        conjugateSpanBy (B.map (centralizer (P : Set H)).subtype)
          (pPrimeCore 2 H ⊔ twoLayer H) = conjugateSpanBy K P ∧
        (B.map (centralizer (P : Set H)).subtype ≤
          centralizer (pPrimeCore 2 H : Set H) →
          IsComponent (centralizer (P : Set H)) B ∧ IsComponent H K)

private theorem aut_solvable_of_card_dvd_nine {H : Type*} [Group H] [Finite H]
    (h : Nat.card H ∣ 9) : Group.IsSolvable (MulAut H) := by
  have hc : Nat.card H = 1 ∨ Nat.card H = 3 ∨ Nat.card H = 9 := by
    obtain ⟨k, hk, he⟩ := (Nat.dvd_prime_pow Nat.prime_three).mp
      (show Nat.card H ∣ 3 ^ 2 from h)
    rw [he]
    interval_cases k <;> norm_num
  rcases hc with h | h | h
  · let : Subsingleton H := (Nat.card_eq_one_iff_unique.mp h).1
    exact Group.isSolvable_of_comm (fun _ _ => MulEquiv.ext (fun _ => Subsingleton.elim _ _))
  · let : IsCyclic H := isCyclic_of_prime_card h
    have ha : Nat.card (MulAut H) = 2 := by rw [IsCyclic.card_mulAut, h]; decide
    let : IsCyclic (MulAut H) := isCyclic_of_prime_card ha
    exact Group.isSolvable_of_comm (fun _ _ => IsMulCommutative.is_comm.comm _ _)
  · exact MulAut.isSolvable_of_card_nine h

/-- The action argument needed to use I.3.1(2). The normal subgroup may
have order one or three as well as nine. -/
theorem perfect_centralizes_normal_of_card_dvd_nine [Finite G]
    (B R : Subgroup G) [Group.IsPerfect B] [R.Normal]
    (hR : Nat.card R ∣ 9) : B ≤ centralizer (R : Set G) := by
  let ρ : B →* MulAut R := MulAut.conjNormal.comp B.subtype
  let : Group.IsSolvable (MulAut R) := aut_solvable_of_card_dvd_nine hR
  let : Group.IsPerfect ρ.range := Group.IsPerfect.range ρ
  have hr : Subsingleton ρ.range := by
    by_contra hn
    let : Nontrivial ρ.range := not_subsingleton_iff_nontrivial.mp hn
    exact Group.IsPerfect.not_isSolvable ρ.range inferInstance
  intro b hb r hrR
  have he : ρ ⟨b, hb⟩ = 1 := congrArg Subtype.val
    (hr.elim (ρ.rangeRestrict ⟨b, hb⟩) 1)
  have hf := congrArg (fun a : MulAut R => (a ⟨r, hrR⟩ : G)) he
  change b * r * b⁻¹ = r at hf
  exact (mul_inv_eq_iff_eq_mul.mp hf).symm

/-- Upgrade a specified local 2-component using the order bound on the odd
core. The local centralizer can first be cut down to an actual overgroup `D`;
the containment premise identifies that cut-down with the full centralizer. -/
theorem exists_component_of_local_twoComponent [Finite G]
    {κ : GroupClass.{u}} (balance : EarlierBalance κ) (hG : IsKGroup κ G)
    (P D B : Subgroup G) (hP : IsPGroup 2 P)
    (hCD : centralizer (P : Set G) ≤ D)
    (hB : IsTwoComponent (B.subgroupOf (D ⊓ centralizer (P : Set G))))
    (hodd : Nat.card (pPrimeCore 2 G) ∣ 9) :
    ∃ K : Subgroup G, IsComponent G K := by
  have he : D ⊓ centralizer (P : Set G) = centralizer (P : Set G) :=
    inf_eq_right.mpr hCD
  rw [he] at hB
  let C := centralizer (P : Set G)
  let J := B.subgroupOf C
  let : Group.IsPerfect J := hB.1.perfect
  let : Group.IsPerfect (J.map C.subtype) := Group.IsPerfect.map C.subtype
  have hc : J.map C.subtype ≤ centralizer (pPrimeCore 2 G : Set G) :=
    perfect_centralizes_normal_of_card_dvd_nine _ _ hodd
  obtain ⟨K, _, _, hK⟩ := balance G hG P hP J hB
  exact ⟨K, (hK hc).2⟩

/-- The geometry and the actual dihedral conjugation bound the odd core.
The model equivalence is attached to `O(C_I(τf))`, not to an unrelated E₉. -/
theorem graph_oddCore_card_dvd_nine [Finite G]
    (T : Sylow 2 G) (Y S L V I J : Subgroup G) [IsKleinFour V]
    (c : ProjectiveMarking L 4) (d : SylowThreeLift T Y S L c)
    (hI : I = normalizer (V : Set G)) (v : G) (hv : v ∈ V) (hv1 : v ≠ 1)
    (hCv : centralizer ({v} : Set G) ≤ I) (hJI : J ≤ I)
    (htrans : ∀ x y : G, x ∈ V → x ≠ 1 → y ∈ V → y ≠ 1 →
      ∃ m : J, (MulAut.conj (m : G)) x = y)
    (hfixed : (d.dihedral.firstReflection : G) * (d.dihedral.halfTurn : G) ∈
      centralizer (V : Set G))
    (emodel : pPrimeCore 2 ↥(I ⊓ centralizer
      ({(d.dihedral.firstReflection : G) * (d.dihedral.halfTurn : G)} : Set G)) ≃*
        Multiplicative (Fin 2 → ZMod 3)) :
    IsTISubgroup V ∧
      Nat.card (pPrimeCore 2 (centralizer
        ({(d.dihedral.firstReflection : G)} : Set G))) ∣ 9 := by
  have ht : ∀ x y : G, x ∈ V → x ≠ 1 → y ∈ V → y ≠ 1 →
      ∃ m : I, (MulAut.conj (m : G)) x = y := by
    intro x y hx hx1 hy hy1
    obtain ⟨m, hm⟩ := htrans x y hx hx1 hy hy1
    exact ⟨⟨m, hJI m.property⟩, hm⟩
  have hTI := ti_of_transitive_normalizer V I hI hv hv1 hCv ht
  have hconj : IsConj (d.dihedral.firstReflection : G)
      ((d.dihedral.firstReflection : G) * (d.dihedral.halfTurn : G)) := by
    apply isConj_iff.mpr
    exact ⟨(d.dihedral.secondReflection : G),
      congrArg (fun x : T => (x : G)) d.dihedral.conjugate_firstReflection⟩
  obtain ⟨ι, hι⟩ := centralizer_oddCore_embeds_of_fusion V I hTI hI hfixed
    hconj.symm emodel
  refine ⟨hTI, ?_⟩
  have h := card_dvd_of_injective ι hι
  simpa [Nat.card_eq_fintype_card] using h

end CFSG.Quasithin.Chapter15.Section03.DiagonalOuter.CoverReduction.GlobalGeometry
