module

public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.DiagonalOuter.CoverReduction.SylowNormalizer.NaturalConstruction.ModelContracts
public import Theory.GroupTheory.WreathTwoSylowModel

/-!
# The concrete cubic base in the natural wreath model

The order-nine subgroup generated by all cubic elements of the literal
`SL₂(2) ≀ C₂` actor is computed directly in its two coordinate planes.  A
finite factorization proves that this subgroup together with the base part of
every Sylow two-subgroup generates the full plane-preserving base.  The same
literal action calculation has no nontrivial vector fixed by the cubic base.

Source: Aschbacher--Smith, proof of 15.3.38, printed p.1136.
-/

@[expose] public section

open Subgroup
open scoped Pointwise
namespace CFSG.Quasithin.Chapter15.Section03.DiagonalOuter.CoverReduction.SylowNormalizer.NaturalConstruction

private instance : DecidableEq OrthogonalActor := fun a b => decidable_of_iff
  (a.left = b.left ∧ a.right = b.right) RegularWreathProduct.ext_iff.symm

private instance : Fintype OrthogonalActor := Fintype.ofEquiv
  ((OrthogonalPlaneIndex → OrthogonalPlaneActor) × OrthogonalPlaneIndex)
  (RegularWreathProduct.equivProd _ _).symm

set_option maxRecDepth 100000
set_option maxHeartbeats 4000000

/-- In the literal wreath product, being cubic is the coordinatewise condition. -/
private theorem cube_characterization : ∀ a : OrthogonalActor,
    a ^ 3 = 1 ↔ a.right = 1 ∧ ∀ i, (a.left i) ^ 3 = 1 := by
  decide +kernel

/-- The coordinatewise order-three subgroup of the plane-preserving base. -/
private def coordinateCube : Subgroup OrthogonalActor where
  carrier a := a.right = 1 ∧ ∀ i, (a.left i) ^ 3 = 1
  one_mem' := by
    constructor
    · rfl
    · intro i
      simp
  mul_mem' := by
    intro a b ha hb
    exact ⟨by simp [ha.1, hb.1], fun i => by
      exact (by decide +kernel : ∀ x y : OrthogonalPlaneActor,
        x ^ 3 = 1 → y ^ 3 = 1 → (x * y) ^ 3 = 1) _ _ (ha.2 i) (hb.2 _)
    ⟩
  inv_mem' := by
    intro a ha
    refine ⟨by simp [ha.1], fun i => ?_⟩
    simpa only [RegularWreathProduct.inv_left, Pi.inv_apply, inv_pow, inv_one]
      using congrArg Inv.inv (ha.2 (a.right * i))

private instance planeBase_normal : planeBase.Normal := by
  change (RegularWreathProduct.rightHom.ker : Subgroup OrthogonalActor).Normal
  exact MonoidHom.normal_ker _

private instance coordinateCube_normal : coordinateCube.Normal where
  conj_mem a ha g := by
    refine ⟨by simp [ha.1], fun i => ?_⟩
    have he : (g * a * g⁻¹).left i =
        g.left i * a.left (g.right⁻¹ * i) * (g.left i)⁻¹ := by
      simp [ha.1]
    rw [he, conj_pow, ha.2]
    simp

private theorem cubic_eq_coordinateCube : cubicBase = coordinateCube := by
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    intro a ha
    exact (cube_characterization a).mp ha
  · intro a ha
    apply Subgroup.subset_closure
    exact (cube_characterization a).mpr ha

private theorem coordinateCube_card : Nat.card coordinateCube = 9 := by
  let e : coordinateCube ≃
      (OrthogonalPlaneIndex → {a : OrthogonalPlaneActor // a ^ 3 = 1}) := {
    toFun := fun a i => ⟨a.val.left i, a.property.2 i⟩
    invFun := fun f => ⟨⟨fun i => (f i).val, 1⟩, rfl, fun i => (f i).property⟩
    left_inv := fun a => Subtype.ext (RegularWreathProduct.ext rfl a.property.1.symm)
    right_inv := fun _ => rfl }
  rw [Nat.card_congr e, Nat.card_fun]
  have hc : Nat.card {a : OrthogonalPlaneActor // a ^ 3 = 1} = 3 := by
    rw [Nat.card_eq_fintype_card]
    decide +kernel
  rw [hc]
  norm_num [OrthogonalPlaneIndex, Nat.card_eq_fintype_card]

private theorem normal_smul_eq_self (H : Subgroup OrthogonalActor) [H.Normal]
    (g : OrthogonalActor) : MulAut.conj g • H = H := by
  apply le_antisymm
  · rw [Subgroup.pointwise_smul_def]
    rintro _ ⟨h, hh, rfl⟩
    exact (inferInstance : H.Normal).conj_mem h hh g
  · intro x hx
    have hh : g⁻¹ * x * g ∈ H := by
      simpa using (inferInstance : H.Normal).conj_mem x hx g⁻¹
    have hm := Subgroup.smul_mem_pointwise_smul (g⁻¹ * x * g) (MulAut.conj g) H hh
    simpa [MulAut.conj_apply, mul_assoc] using hm

private theorem standard_generation :
    coordinateCube ⊔ ((wreathTwoSylow : Subgroup OrthogonalActor) ⊓ planeBase) = planeBase := by
  rw [wreathTwoSylow_coe]
  apply le_antisymm
  · apply sup_le
    · intro a ha
      exact ha.1
    · intro a ha
      exact ha.2
  · intro a ha
    have hgen : ∀ a : OrthogonalActor, a.right = 1 → ∃ x, (x.right = 1 ∧
        ∀ i, (x.left i) ^ 3 = 1) ∧ ∃ y, y ∈ wreathTwoDihedralHom.range ∧
        y.right = 1 ∧ a = x * y := by
      decide +kernel
    obtain ⟨x, hx, y, hy, hyshift, hxy⟩ := hgen a ha
    rw [hxy]
    apply mul_mem_sup hx
    exact (show y ∈ wreathTwoDihedralHom.range ⊓ planeBase from by exact ⟨hy, hyshift⟩)

private theorem arbitrary_generation (P : Sylow 2 OrthogonalActor) :
    coordinateCube ⊔ ((P : Subgroup OrthogonalActor) ⊓ planeBase) = planeBase := by
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq OrthogonalActor wreathTwoSylow P
  have hstd : coordinateCube ⊔ ((wreathTwoSylow : Subgroup OrthogonalActor) ⊓ planeBase) =
      planeBase := standard_generation
  have hs := congrArg (fun H : Subgroup OrthogonalActor => MulAut.conj g • H) hstd
  have hsup (A B : Subgroup OrthogonalActor) : MulAut.conj g • (A ⊔ B) =
      (MulAut.conj g • A) ⊔ (MulAut.conj g • B) := by
    rw [Subgroup.pointwise_smul_def, Subgroup.pointwise_smul_def,
      Subgroup.pointwise_smul_def]
    change (A ⊔ B).map (MulAut.conj g).toMonoidHom =
      A.map (MulAut.conj g).toMonoidHom ⊔ B.map (MulAut.conj g).toMonoidHom
    exact Subgroup.map_sup _ _ _
  have hinf (A B : Subgroup OrthogonalActor) : MulAut.conj g • (A ⊓ B) =
      (MulAut.conj g • A) ⊓ (MulAut.conj g • B) := by
    rw [Subgroup.pointwise_smul_def, Subgroup.pointwise_smul_def,
      Subgroup.pointwise_smul_def]
    change (A ⊓ B).map (MulAut.conj g).toMonoidHom =
      A.map (MulAut.conj g).toMonoidHom ⊓ B.map (MulAut.conj g).toMonoidHom
    exact Subgroup.map_inf _ _ _ (MulAut.conj g).injective
  rw [hsup, hinf, normal_smul_eq_self coordinateCube _,
      normal_smul_eq_self planeBase] at hs
  have hp : (P : Subgroup OrthogonalActor) = MulAut.conj g •
      (wreathTwoSylow : Subgroup OrthogonalActor) := by
    rw [← hg, Sylow.coe_subgroup_smul]
  rw [hp]
  exact hs

private theorem fixed_vectors : letI := orthogonalAction
    ∀ v : OrthogonalVector, (∀ g ∈ coordinateCube, g • v = v) → v = 1 := by
  let _ := orthogonalAction
  intro v hv
  have hfixed : ∀ v : OrthogonalVector, (∀ g : OrthogonalActor,
      (g.right = 1 ∧ ∀ i, (g.left i) ^ 3 = 1) → g • v = v) → v = 1 := by
    decide +kernel
  apply hfixed v
  intro g hg
  exact hv g hg

/-- The unconditional order, generation, and fixed-vector calculations for the
literal natural wreath model. -/
theorem baseModelFacts : BaseModelFacts := by
  refine { card_cubic := ?_, generate := ?_, fixed := ?_ }
  · rw [cubic_eq_coordinateCube]
    exact coordinateCube_card
  · intro P
    rw [cubic_eq_coordinateCube]
    exact arbitrary_generation P
  · let _ := orthogonalAction
    rw [cubic_eq_coordinateCube] at *
    exact fixed_vectors

end CFSG.Quasithin.Chapter15.Section03.DiagonalOuter.CoverReduction.SylowNormalizer.NaturalConstruction

end
