module

public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.DiagonalOuter.CoverReduction.SylowNormalizer.QuotientCoordinates

/-!
# Concrete model calculations for the natural-action coordinates

The base is the kernel of the actual coordinate permutation in
`SL₂(2) ≀ C₂`. Its cubic subgroup is generated by the elements whose cubes
are one. The remaining model calculations identify this subgroup as E₉,
show that it and the base part of any Sylow two-subgroup generate the base,
and compute fixed vectors and marked dihedral elements.

These are output contracts for calculations in the concrete group of order
72, not hypotheses asserting the local-group conclusion. The ambient-group
transport is in `NaturalConstruction`; both contracts must be constructed
before that conditional transport proves the requested coordinates.

Source: Aschbacher--Smith, proof of 15.3.38, printed p.1136.
-/

@[expose] public section

open Subgroup
namespace CFSG.Quasithin.Chapter15.Section03.DiagonalOuter.CoverReduction.SylowNormalizer.NaturalConstruction

/-- The actual plane-preserving base of the wreath product. -/
def planeBase : Subgroup OrthogonalActor := RegularWreathProduct.rightHom.ker

/-- The subgroup generated by all cubic elements of the actual actor. -/
def cubicBase : Subgroup OrthogonalActor := closure {g | g ^ 3 = 1}

/-- Conjugation preserves cubic elements and hence their generated subgroup. -/
instance cubicBase_normal : cubicBase.Normal := by
  rw [← normalizer_eq_top_iff, ← top_le_iff]
  apply le_normalizer_closure_iff.mpr
  intro g _ x hx
  apply Subgroup.subset_closure
  change (g * x * g⁻¹) ^ 3 = 1
  change ((MulAut.conj g) x) ^ 3 = 1
  rw [← map_pow, show x ^ 3 = 1 from hx, map_one]

/-- The unmarked base and fixed-vector calculations, to be proved in the
literal matrix wreath product. -/
structure BaseModelFacts : Prop where
  card_cubic : Nat.card cubicBase = 9
  generate : ∀ P : Sylow 2 OrthogonalActor,
    cubicBase ⊔ ((P : Subgroup OrthogonalActor) ⊓ planeBase) = planeBase
  fixed : letI := orthogonalAction
    ∀ v : OrthogonalVector, (∀ g ∈ cubicBase, g • v = v) → v = 1

/-- The generation calculation in particular places the cubic group in the base. -/
theorem BaseModelFacts.cubic_le (b : BaseModelFacts) : cubicBase ≤ planeBase := by
  let P : Sylow 2 OrthogonalActor := Classical.choice inferInstance
  exact le_sup_left.trans (b.generate P).le

/-- Dihedral coordinates on an arbitrary Sylow two-subgroup of the actual
actor, with the first reflection supported on the first plane. -/
structure SylowModelCoordinates (P : Sylow 2 OrthogonalActor) where
  embedding : DihedralGroup 4 →* OrthogonalActor
  injective : Function.Injective embedding
  range_eq : embedding.range = P
  base_preimage : ∀ x, (embedding x).right = 1 ↔ x ∈ baseFour
  inverts : ∀ y ∈ cubicBase,
    embedding (.r 2) * y * (embedding (.r 2))⁻¹ = y⁻¹
  first_fixes_second : letI := orthogonalAction
    ∀ v ∈ orthogonalCoordinatePlane (Multiplicative.ofAdd (1 : ZMod 2)),
      embedding (.sr 0) • v = v
  fixes_first : letI := orthogonalAction
    ∀ v ∈ orthogonalCoordinatePlane 1, embedding (.sr 2) • v = v

end CFSG.Quasithin.Chapter15.Section03.DiagonalOuter.CoverReduction.SylowNormalizer.NaturalConstruction

end
