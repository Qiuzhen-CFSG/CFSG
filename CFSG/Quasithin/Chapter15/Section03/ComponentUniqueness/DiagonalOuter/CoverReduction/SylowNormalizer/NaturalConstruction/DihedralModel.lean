module

public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.DiagonalOuter.CoverReduction.SylowNormalizer.NaturalConstruction.ModelContracts
public import Theory.GroupTheory.SpecificGroups.SLTwoPermThree

/-!
# Plane-marked dihedral Sylow coordinates

The projective action identifies each SL₂(2) factor with S₃. A transposition
on the first plane and the pure plane swap generate a dihedral subgroup of
order eight in their wreath product, whose order is 72. The square of the
rotation acts by that transposition on both planes and inverts the subgroup
generated by all cubic elements. The two base reflections fix the opposite
coordinate planes for the exact natural matrix action.

Sylow conjugacy gives coordinates on any Sylow two-subgroup. Multiplying the
conjugator by an element of the standard Sylow makes its coordinate permutation
trivial; hence transporting the reflections preserves their plane markings.
The finite permutation calculations are checked by the Lean kernel. No model
coordinates or additional action hypotheses are assumed.

Source: Aschbacher--Smith, proof of 15.3.38, printed p.1136, combined
manuscript of 1 March 2004 (the choices of τ, f, t with f inverting X,
τf centralizing V₁, and ⟨t, τ⟩ dihedral).
-/

open Subgroup
namespace CFSG.Quasithin.Chapter15.Section03.DiagonalOuter.CoverReduction.SylowNormalizer.NaturalConstruction
namespace DihedralModel

abbrev Q := Multiplicative (ZMod 2)
abbrev S := Equiv.Perm (Fin 3)
abbrev W := RegularWreathProduct S Q
instance : DecidableEq W := fun x y => decidable_of_iff
  (x.left = y.left ∧ x.right = y.right) (RegularWreathProduct.ext_iff.symm)
-- Number the three points so the chosen transposition exchanges 0 and 1.
def t : S := Equiv.swap 0 1
def a : W := ⟨fun i => if i = 1 then t else 1, 1⟩
def b : W := ⟨1, Multiplicative.ofAdd 1⟩
def rot : W := a * b
-- The first reflection acts on plane 1; the other generator swaps the planes.
def d : DihedralGroup 4 → W
  | .r i => rot ^ i.val
  | .sr i => a * rot ^ i.val
def dHom : DihedralGroup 4 →* W where
  toFun := d
  map_one' := by decide +kernel
  map_mul' := by decide +kernel
theorem d_injective : Function.Injective dHom := by decide +kernel
theorem d_base : ∀ x, (dHom x).right = 1 ↔ x ∈ baseFour := by
  change ∀ x, (d x).right = 1 ↔ x = 1 ∨ x = .sr 0 ∨ x = .r 2 ∨ x = .sr 2
  decide +kernel
theorem perm_inverts : ∀ s : S, s ^ 3 = 1 → t * s * t⁻¹ = s⁻¹ := by decide +kernel
theorem perm_cubic_mul : ∀ s u : S, s ^ 3 = 1 → u ^ 3 = 1 → (s * u) ^ 3 = 1 := by decide +kernel

/-- Cubic elements in the two symmetric factors form a subgroup. This supplies
closure control for the actual `cubicBase`, rather than just its generators. -/
def cubicKernel : Subgroup W where
  carrier y := y.right = 1 ∧ ∀ i, (y.left i) ^ 3 = 1
  one_mem' := by
    change (1 : Q) = 1 ∧ ∀ i : Q, (1 : S) ^ 3 = 1
    simp
  mul_mem' := by
    rintro x y ⟨hx, hx'⟩ ⟨hy, hy'⟩
    refine ⟨by simp [hx, hy], ?_⟩
    intro i
    simpa [hx] using perm_cubic_mul (x.left i) (y.left i) (hx' i) (hy' i)
  inv_mem' := by
    rintro x ⟨hx, hx'⟩
    refine ⟨by simp [hx], ?_⟩
    intro i
    simp [hx, inv_pow, hx']

theorem cubic_mem (x : W) (hx : x ^ 3 = 1) : x ∈ cubicKernel := by
  have hr : x.right = 1 := by
    have h : x.right ^ 3 = 1 := congrArg RegularWreathProduct.right hx
    exact (show ∀ q : Q, q ^ 3 = 1 → q = 1 by decide) x.right h
  refine ⟨hr, ?_⟩
  intro i
  have h := congrArg (fun w : W => w.left i) hx
  simpa [pow_succ, hr] using h

theorem d_half_inverts (x : W) (hx : x ∈ cubicKernel) :
    dHom (.r 2) * x * (dHom (.r 2))⁻¹ = x⁻¹ := by
  have hr : (dHom (.r 2)).right = 1 := by decide
  have hl : ∀ i, (dHom (.r 2)).left i = t := by decide +kernel
  apply RegularWreathProduct.ext
  · funext i
    simpa [hr, hl, hx.1] using perm_inverts (x.left i) (hx.2 i)
  · simp [hr, hx.1]

noncomputable def E : OrthogonalActor ≃* W :=
  RegularWreathProduct.congr (Classical.choice SLTwoPermThree.sl2Two_equiv_perm_three)
    (MulEquiv.refl _)
@[simp] theorem E_right (x : OrthogonalActor) : (E x).right = x.right := rfl
@[simp] theorem E_symm_right (x : W) : (E.symm x).right = x.right := rfl
noncomputable def embedding : DihedralGroup 4 →* OrthogonalActor :=
  E.symm.toMonoidHom.comp dHom

theorem embedding_injective : Function.Injective embedding := E.symm.injective.comp d_injective

theorem card_actor : Nat.card OrthogonalActor = 72 := by
  rw [Nat.card_congr E.toEquiv, RegularWreathProduct.card]
  norm_num [S, Q, Nat.card_perm, Fintype.card_perm, Nat.factorial]
theorem card_range : Nat.card embedding.range = 8 := by
  rw [← Nat.card_congr (MonoidHom.ofInjective embedding_injective).toEquiv]
  exact DihedralGroup.nat_card
noncomputable def standardSylow : Sylow 2 OrthogonalActor :=
  Sylow.ofCard embedding.range (by rw [card_range, card_actor]; decide +kernel)

theorem cubic_le_kernel : cubicBase ≤ cubicKernel.comap E.toMonoidHom := by
  apply (cubicKernel.comap E.toMonoidHom).closure_le.mpr
  intro x hx
  apply cubic_mem
  rw [← map_pow, show x ^ 3 = 1 from hx, map_one]

theorem standard_inverts (y : OrthogonalActor) (hy : y ∈ cubicBase) :
    embedding (.r 2) * y * (embedding (.r 2))⁻¹ = y⁻¹ := by
  apply E.injective
  simpa [embedding] using d_half_inverts (E y) (cubic_le_kernel hy)

theorem fixes_plane (x : OrthogonalActor) (i : OrthogonalPlaneIndex)
    (hr : x.right = 1) (hl : x.left i = 1) :
    letI := orthogonalAction
    ∀ v ∈ orthogonalCoordinatePlane i, x • v = v := by
  let _ := FourGroupMatrixCoordinates.naturalAction
  let _ := orthogonalAction
  intro v hv
  funext j
  change x.left j • v (x.right⁻¹ * j) = v j
  rw [hr, inv_one, one_mul]
  by_cases hj : j = i
  · subst j
    rw [hl, one_smul]
  · rw [hv j hj, smul_one]

theorem E_symm_left_one (x : W) (i : Q) (hx : x.left i = 1) :
    (E.symm x).left i = 1 := by
  change (Classical.choice SLTwoPermThree.sl2Two_equiv_perm_three).symm (x.left i) = 1
  rw [hx, map_one]

theorem standard_first_fixes_second : letI := orthogonalAction
    ∀ v ∈ orthogonalCoordinatePlane (Multiplicative.ofAdd (1 : ZMod 2)),
      embedding (.sr 0) • v = v := by
  apply fixes_plane
  · change (dHom (.sr 0)).right = 1
    decide +kernel
  · apply E_symm_left_one
    decide +kernel

theorem standard_fixes_first : letI := orthogonalAction
    ∀ v ∈ orthogonalCoordinatePlane 1, embedding (.sr 2) • v = v := by
  apply fixes_plane
  · change (dHom (.sr 2)).right = 1
    decide +kernel
  · apply E_symm_left_one
    decide +kernel

theorem standard_has_right (q : Q) : ∃ z ∈ (standardSylow : Subgroup OrthogonalActor),
    z.right = q := by
  have h : ∀ q : Q, ∃ x : DihedralGroup 4, (dHom x).right = q := by decide +kernel
  obtain ⟨x, hx⟩ := h q
  exact ⟨embedding x, ⟨x, rfl⟩, hx⟩

/-- Absorb the coordinate permutation into the standard Sylow before
conjugating, so the prescribed plane labels are retained. -/
theorem marked_conjugator (P : Sylow 2 OrthogonalActor) :
    ∃ g : OrthogonalActor, g.right = 1 ∧ g • standardSylow = P := by
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq OrthogonalActor standardSylow P
  obtain ⟨z, hz, hzr⟩ := standard_has_right g.right⁻¹
  refine ⟨g * z, ?_, ?_⟩
  · simp [hzr]
  · rw [mul_smul, Sylow.smul_eq_iff_mem_normalizer.mpr (le_normalizer hz), hg]

-- A base conjugator preserves each plane for the exact named action.
theorem base_preserves_plane (g : OrthogonalActor) (hg : g.right = 1)
    (i : OrthogonalPlaneIndex) : letI := orthogonalAction
    ∀ v ∈ orthogonalCoordinatePlane i, g • v ∈ orthogonalCoordinatePlane i := by
  let _ := FourGroupMatrixCoordinates.naturalAction
  let _ := orthogonalAction
  intro v hv j hj
  change g.left j • v (g.right⁻¹ * j) = 1
  rw [hg, inv_one, one_mul, hv j hj, smul_one]

theorem conjugate_fixes_plane (g x : OrthogonalActor) (hg : g.right = 1)
    (i : OrthogonalPlaneIndex)
    (hx : letI := orthogonalAction
      ∀ v ∈ orthogonalCoordinatePlane i, x • v = v) :
    letI := orthogonalAction
    ∀ v ∈ orthogonalCoordinatePlane i, (g * x * g⁻¹) • v = v := by
  let _ := orthogonalAction
  intro v hv
  rw [mul_smul, mul_smul, hx _ (base_preserves_plane g⁻¹ (by simp [hg]) i v hv),
    smul_inv_smul]

-- Keep this identity abstract so its proof does not unfold matrix multiplication.
theorem conjugate_inversion {A : Type*} [Group A] (g x y : A)
    (h : x * (g⁻¹ * y * g) * x⁻¹ = (g⁻¹ * y * g)⁻¹) :
    (g * x * g⁻¹) * y * (g * x * g⁻¹)⁻¹ = y⁻¹ := by
  calc
    _ = g * (x * (g⁻¹ * y * g) * x⁻¹) * g⁻¹ := by group
    _ = g * (g⁻¹ * y * g)⁻¹ * g⁻¹ := by rw [h]
    _ = y⁻¹ := by group

theorem conjugate_inverts (g : OrthogonalActor) (y : OrthogonalActor) (hy : y ∈ cubicBase) :
    (g * embedding (.r 2) * g⁻¹) * y * (g * embedding (.r 2) * g⁻¹)⁻¹ = y⁻¹ := by
  exact conjugate_inversion g _ y
    (standard_inverts _ (cubicBase_normal.conj_mem' y hy g))

noncomputable def conjugateEmbedding (g : OrthogonalActor) : DihedralGroup 4 →* OrthogonalActor :=
  (MulAut.conj g).toMonoidHom.comp embedding

theorem coordinates (P : Sylow 2 OrthogonalActor) : Nonempty (SylowModelCoordinates P) := by
  obtain ⟨g, hg, hP⟩ := marked_conjugator P
  refine ⟨{
    embedding := conjugateEmbedding g
    injective := (MulAut.conj g).injective.comp embedding_injective
    range_eq := ?_
    base_preimage := ?_
    inverts := ?_
    first_fixes_second := ?_
    fixes_first := ?_
  }⟩
  · rw [conjugateEmbedding, MonoidHom.range_comp]
    exact congrArg (fun P : Sylow 2 OrthogonalActor => (P : Subgroup OrthogonalActor)) hP
  · intro x
    change (g * embedding x * g⁻¹).right = 1 ↔ x ∈ baseFour
    simpa [hg, embedding] using d_base x
  · exact conjugate_inverts g
  · exact conjugate_fixes_plane g _ hg _ standard_first_fixes_second
  · exact conjugate_fixes_plane g _ hg _ standard_fixes_first

end DihedralModel

/-- Every Sylow two-subgroup of the literal orthogonal actor admits dihedral
coordinates with the prescribed base, half-turn and two plane markings. -/
public theorem sylowModelCoordinates_nonempty (P : Sylow 2 OrthogonalActor) :
    Nonempty (SylowModelCoordinates P) :=
  DihedralModel.coordinates P

end CFSG.Quasithin.Chapter15.Section03.DiagonalOuter.CoverReduction.SylowNormalizer.NaturalConstruction
