module

public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.RankTwo.NonCharacteristicTwo.SporadicSieve.HeldExclusion.ProperExtensionProfile.Coverage.NormalizerInclusions.Transport
public import Theory.SpecificGroups.Held.TwoLocalCandidates.MaximalNormalizerCatalogue.AmbientIdentities.Max5Upper
public import Theory.SpecificGroups.Held.LocalPairs.PairCoverage.LocalActions.RepresentativeImages.InnerImages.Transport
public import Theory.GroupTheory.CharacteristicCentralizerFusion

/-!
# The order-two outer Held row

The published row generator is the known central involution, transported by the
already certified pure-Sylow conjugator. A four-point certificate checks this
literal identity. The existing max5 involution-centralizer theorem identifies
its full inner normalizer. Every automorphism preserving the row therefore
preserves this conjugate of max5, giving the required full ambient inclusion.

Source: GLS3 Table 5.3p, the ATLAS max5 words, and Aschbacher--Smith 15.3.41--42,
printed p.1138. No outer-group bound, model order or coverage premise is needed.
-/

public section
open Subgroup Held.LocalPairs
open Held.LocalPairs.PairCoverage.LocalActions.RepresentativeImages.InnerImages
namespace CFSG.Quasithin.Chapter15.Section03.RankTwo.NonCharacteristicTwo.SporadicSieve.HeldExclusion.ProperExtensionProfile.NormalizerInclusions
open CoverageData

/-- The literal generator of the first row. -/
@[expose] def rowZeroElement : Held.He :=
  word [-4, 2, 3, 4, 2, 3, -4, -2, -3, -4, -2, -3]

/-- The exact conjugator from the fixed max5 marking to the outer row marking. -/
@[expose] def rowZeroConjugator : Held.He :=
  transporter false 0 * Held.TwoLocalCandidates.MaximalNormalizerCatalogue.conjugator 0

set_option maxRecDepth 16384 in
set_option maxHeartbeats 2000000 in
private theorem rowZeroElement_transport : rowZeroElement =
    MulAut.conj (transporter false 0)
      Held.TwoLocalCandidates.MaximalNormalizerCatalogue.centralWord := by
  apply Held.eq_of_four_point_images
  decide +kernel

/-- The same element is the transported max5 central involution. -/
theorem rowZeroElement_eq : rowZeroElement =
    MulAut.conj rowZeroConjugator (Held.TwoLocalCandidates.max5First ^ 4) := by
  rw [rowZeroElement_transport,
    ← Held.TwoLocalCandidates.MaximalNormalizerCatalogue.conjugator_zero_max5First_four]
  simp only [rowZeroConjugator, map_mul, MulAut.mul_apply]

/-- The first row is the cyclic subgroup generated by its displayed word. -/
theorem heldRow_zero_eq_zpowers : heldRow 0 = zpowers rowZeroElement := by
  have hr : row 0 = zpowers (word [-4, 2, 3, 4, 2, 3, -4, -2, -3, -4, -2, -3]) := by
    change closure {x : pureTwo | ∃ w ∈
      [[-4, 2, 3, 4, 2, 3, -4, -2, -3, -4, -2, -3]], word w = x} = _
    rw [zpowers_eq_closure]
    congr 1
    ext x
    simp only [Set.mem_ofPred_eq, List.mem_singleton, exists_eq_left, Set.mem_singleton_iff]
    exact eq_comm
  rw [heldRow, hr, MonoidHom.map_zpowers]
  rfl

/-- The full normalizer inside Held is the specified conjugate of max5. -/
theorem heldRow_zero_normalizer : normalizer (heldRow 0 : Set Held.He) =
    Held.TwoLocalCandidates.max5.map (MulAut.conj rowZeroConjugator).toMonoidHom := by
  rw [heldRow_zero_eq_zpowers, rowZeroElement_eq]
  have he : (zpowers (Held.TwoLocalCandidates.max5First ^ 4)).map
      (MulAut.conj rowZeroConjugator).toMonoidHom =
      zpowers (MulAut.conj rowZeroConjugator (Held.TwoLocalCandidates.max5First ^ 4)) :=
    (MulAut.conj rowZeroConjugator).toMonoidHom.map_zpowers _
  rw [← he, ← map_equiv_normalizer_eq, normalizer_zpowers_eq_centralizer_of_order_two _
      Held.TwoLocalCandidates.CentralInvolutionBounds.orderOf_centralInvolution,
    Held.TwoLocalCandidates.MaximalNormalizerCatalogue.max5_involution_centralizer_eq
      Held.LocalPairs.SylowGeometry.Calculations.representative_isPGroup]

/-- Full ambient normalizer containment for the first literal row. -/
theorem ambientRow_zero_normalizer_le :
    normalizer (ambientRow 0 : Set (MulAut Held.He)) ≤
      (candidate false).map (MulAut.conj (MulAut.conj rowZeroConjugator)).toMonoidHom := by
  rw [ambientRow_normalizer]
  have h := automorphismNormalizer_le_innerNormalizer (heldRow 0)
  rw [heldRow_zero_normalizer, automorphismNormalizer_map] at h
  exact h

end CFSG.Quasithin.Chapter15.Section03.RankTwo.NonCharacteristicTwo.SporadicSieve.HeldExclusion.ProperExtensionProfile.NormalizerInclusions
