module

public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.RankTwo.Containment.FactorGeometry.PlaneActors.Geometry
public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.RankTwo.Containment.FactorGeometry.ActorData
public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.RankTwo.Containment.FactorGeometry.PlaneActors.FullAction.Coordinates
public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.RankTwo.Containment.FactorGeometry.PlaneActors.CentralizerAction.PlaneImage.Kernel

/-!
# CaseTwo from the literal cubic coordinate calculation

CaseTwo defines Y₊ as O²(C_Y(V₁)), so the cubic coordinate calculation on
Y determines its image and its displacement on V₂. The order-nine quotient
of Y₊ then identifies the image of C_{Y₊}(V₂) as a line of order three.
Its two-residual has three-part three, even though its action on V is trivial.

The full residual image from 15.3.7 supplies the coordinate facts and
identifies the literal image of Y₊ with the cyclic group generated by the
cubic matrix on V₂. This discharges all three CaseTwo action premises.
No order-nine quotient of the larger Y, rank-two shadow or core equality
is required, and the genuine CaseTwo uniqueness premise is retained.
Both labels are supported symmetrically.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), 15.3.7,
15.3.10(2), 15.3.11(5), and 15.3.39–40, printed pp.1122–1124 and 1137–1138.
-/

public section

open Subgroup
namespace CFSG.Quasithin.Chapter15.Section03.RankTwo
variable {G : Type*} [Group G] [Finite G]

/-- The literal centralizer, before taking its residual, maps to a line
of order three in the actual quotient Y₊/O₂(Y₊). -/
theorem caseTwo_plane_centralizer_quotient_card_of_coordinates
    {M Mc V S Yplus : Subgroup G} (d : NaturalOrthogonalAction M V)
    {i j : OrthogonalPlaneIndex} (hij : i ≠ j)
    (hcase : CaseTwo M (residualY M Mc) S (d.plane i) Yplus)
    (hcoords : FullActionCoordinateFacts d (residualY M Mc))
    (h9 : Nat.card (Yplus ⧸ pCore 2 Yplus) = 9) :
    Nat.card (((Yplus ⊓ centralizer (d.plane j : Set G)).subgroupOf Yplus).map
      (QuotientGroup.mk' (pCore 2 Yplus))) = 3 := by
  have he : Yplus = centralizingFactor (residualY M Mc) (d.plane i) := hcase.2
  have hYM : Yplus ≤ M := by
    rw [he]
    exact (centralizingFactor_le_left _ _).trans
      (Chapter14.SourcePreliminaries.sourceResidual_le M Mc)
  have hYC : Yplus ≤ centralizer (d.plane i : Set G) := by
    rw [he]
    exact centralizingFactor_le _ _
  have hi : Nat.card (d.image Yplus) = 3 := by
    rw [he]
    exact hcoords.image_card i
  exact natural_other_plane_centralizer_quotient_card d hYM hij hYC hi h9

/-- The three action premises for CaseTwo follow from the shared cubic
coordinate calculation and the order-nine quotient of Y₊. -/
theorem caseTwo_action_of_fullActionCoordinates
    {M Mc V S Yplus : Subgroup G} (d : NaturalOrthogonalAction M V)
    {i j : OrthogonalPlaneIndex} (hij : i ≠ j)
    (hcase : CaseTwo M (residualY M Mc) S (d.plane i) Yplus)
    (hcoords : FullActionCoordinateFacts d (residualY M Mc))
    (h9 : Nat.card (Yplus ⧸ pCore 2 Yplus) = 9) :
    3 ^ (Nat.card (centralizingFactor Yplus (d.plane j))).factorization 3 = 3 ∧
      ⁅V, Yplus⁆ = d.plane j ∧ ⁅d.plane j, Yplus⁆ = d.plane j := by
  have he : Yplus = centralizingFactor (residualY M Mc) (d.plane i) := hcase.2
  have hYM : Yplus ≤ M := by
    rw [he]
    exact (centralizingFactor_le_left _ _).trans
      (Chapter14.SourcePreliminaries.sourceResidual_le M Mc)
  have hYC : Yplus ≤ centralizer (d.plane i : Set G) := by
    rw [he]
    exact centralizingFactor_le _ _
  have hi : Nat.card (d.image Yplus) = 3 := by
    rw [he]
    exact hcoords.image_card i
  refine ⟨natural_other_plane_centralizingFactor_threePart d hYM hij hYC hi h9, ?_, ?_⟩
  · rw [he]
    exact hcoords.commutator i j hij
  · rw [he]
    exact hcoords.commutator_self i j hij

/-- In CaseTwo the literal compatible action of Y₊ is exactly the
order-three rotations supported on the other plane. The coordinate cubic
has order three and fixes the plane used to define Y₊. -/
theorem caseTwo_image_eq_coordinateCubic
    {M Mc V S Yplus : Subgroup G} (d : NaturalOrthogonalAction M V)
    {i j : OrthogonalPlaneIndex} (hij : i ≠ j)
    (hcase : CaseTwo M (residualY M Mc) S (d.plane i) Yplus)
    (h7 : d.image (residualY M Mc) =
      Stellmacher.twoResidualAmbient (⊤ : Subgroup OrthogonalActor)) :
    d.image Yplus = Subgroup.zpowers (FullActionCoordinates.coordinateCubic j) := by
  have he : Yplus = centralizingFactor (residualY M Mc) (d.plane i) := hcase.2
  rw [he]
  exact residualY_centralizingFactor_image_eq_coordinateCubic d h7 hij

/-- The image of C_{Y₊}(Vⱼ) in the actual quotient Y₊/O₂(Y₊) has order
three. Its action image is calculated from 15.3.7, not assumed. -/
theorem caseTwo_plane_centralizer_quotient_card
    {M Mc V S Yplus : Subgroup G} (d : NaturalOrthogonalAction M V)
    {i j : OrthogonalPlaneIndex} (hij : i ≠ j)
    (hcase : CaseTwo M (residualY M Mc) S (d.plane i) Yplus)
    (h7 : d.image (residualY M Mc) =
      Stellmacher.twoResidualAmbient (⊤ : Subgroup OrthogonalActor))
    (h9 : Nat.card (Yplus ⧸ pCore 2 Yplus) = 9) :
    Nat.card (((Yplus ⊓ centralizer (d.plane j : Set G)).subgroupOf Yplus).map
      (QuotientGroup.mk' (pCore 2 Yplus))) = 3 :=
  caseTwo_plane_centralizer_quotient_card_of_coordinates d hij hcase
    (residualY_fullActionCoordinateFacts d h7) h9

/-- The three CaseTwo action conclusions from the genuine full residual
image and the order-nine quotient of Y₊. The first is the three-part of
O²(C_{Y₊}(Vⱼ)); the other two are literal ambient subgroup commutators.
Taking `i = 1` and `j = Multiplicative.ofAdd (1 : ZMod 2)` gives the
source labels V₁ and V₂. -/
theorem caseTwo_action_of_full_image
    {M Mc V S Yplus : Subgroup G} (d : NaturalOrthogonalAction M V)
    {i j : OrthogonalPlaneIndex} (hij : i ≠ j)
    (hcase : CaseTwo M (residualY M Mc) S (d.plane i) Yplus)
    (h7 : d.image (residualY M Mc) =
      Stellmacher.twoResidualAmbient (⊤ : Subgroup OrthogonalActor))
    (h9 : Nat.card (Yplus ⧸ pCore 2 Yplus) = 9) :
    3 ^ (Nat.card (centralizingFactor Yplus (d.plane j))).factorization 3 = 3 ∧
      ⁅V, Yplus⁆ = d.plane j ∧ ⁅d.plane j, Yplus⁆ = d.plane j :=
  caseTwo_action_of_fullActionCoordinates d hij hcase
    (residualY_fullActionCoordinateFacts d h7) h9

end CFSG.Quasithin.Chapter15.Section03.RankTwo
