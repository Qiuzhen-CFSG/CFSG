module

public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.RankTwo.Containment.Definitions
public import Theory.GroupTheory.DisjointCommutingProduct.Projections
public import Mathlib.GroupTheory.SpecificGroups.Alternating

/-!
# Component-orbit projections and plane interchange

For 15.3.39, the orbit join uses the actual S-conjugates of L. Once the
two-conjugate decomposition is established, multiplication gives its
projection onto L and the exact kernel. The imported swapped-product
argument constructs equal images for normal residual actors, and proves
that an invariant nontrivial plane has nontrivial image.

For 15.3.40, relative normality places the commutator plane in L or in
its centralizer. The latter case forces `Y₊ = Y` by 15.3.11(3), justifying
the interchange of the definite planes. Multiplication and conjugation
then give the actual A₄-square equivalence once the chief-factor analysis
has established generation and disjoint commuting factors.

These are conditional intermediate results. The source geometry supplying
the residual factors in 15.3.39, the rank-one Borel restrictions, and the
chief-factor argument in 15.3.40 remain necessary before either numbered
source containment theorem can be asserted.

Source: Aschbacher--Smith, combined manuscript (1 March 2004),
15.3.39--40, printed pp.1137--1138.
-/

public section

namespace CFSG.Quasithin.Chapter15.Section03.RankTwo

open Subgroup Theory.GroupTheory

variable {G : Type*} [Group G]

private theorem normalizes_centralizer {L I : Subgroup G}
    (hLI : L ≤ I) [(L.subgroupOf I).Normal] :
    I ≤ normalizer (centralizer (L : Set G) : Set G) := by
  have hn := le_normalizer_of_normal_subgroupOf hLI
  intro x hx
  apply mem_normalizer_iff.mpr
  intro c
  constructor
  · intro hc l hl
    have hxl : x⁻¹ * l * x ∈ L := by
      simpa only [inv_inv] using (mem_normalizer_iff.mp (hn (I.inv_mem hx)) l).mp hl
    have hh := hc (x⁻¹ * l * x) hxl
    have hh' := congrArg (fun a : G => x * a * x⁻¹) hh
    simpa only [mul_assoc, mul_inv_cancel_left, inv_mul_cancel_left,
      mul_inv_cancel, inv_mul_cancel, mul_one, one_mul] using hh'
  · intro hc l hl
    have hxl : x * l * x⁻¹ ∈ L :=
      (mem_normalizer_iff.mp (hn hx) l).mp hl
    have hh := hc (x * l * x⁻¹) hxl
    have hh' := congrArg (fun a : G => x⁻¹ * a * x) hh
    simpa only [mul_assoc, mul_inv_cancel_left, inv_mul_cancel_left,
      mul_inv_cancel, inv_mul_cancel, mul_one, one_mul] using hh'

/-- The plane interchange in 15.3.40. If the centralizing factor is the
actor on `V₂`, the case-(2) normalizer control contradicts `L ≰ M`.
Consequently `Y₊ = Y`, which permits the interchange. In either orientation
the plane generated by the component factor lies in L. Normality of L
is required only inside I. Generation of `V₁` by `Y₁` is used only after
proving `Y₊ = Y`; it need not hold in case (2) of 15.3.10.

The identification of the two residual factors with the two plane actors
is a separate geometric premise, still to be proved in the source setup. -/
theorem orient_component_plane {M Y Yplus L I S V₁ V₂ Y₁ Y₂ : Subgroup G}
    (hcase : Hypothesis15310 M Y S V₁ Yplus)
    (hcontrol : CaseTwo M Y S V₁ Yplus → normalizer (V₂ : Set G) ≤ M)
    (hLI : L ≤ I) [(L.subgroupOf I).Normal] (hLM : ¬ L ≤ M)
    (hV₁I : V₁ ≤ I) (hV₂I : V₂ ≤ I)
    (hgen₁ : Yplus = Y → ⁅V₁, Y₁⁆ = V₁) (hgen₂ : ⁅V₂, Y₂⁆ = V₂)
    (hpair : (componentFactor Yplus L = Y₂ ∧ centralizingFactor Yplus L = Y₁) ∨
      (componentFactor Yplus L = Y₁ ∧ centralizingFactor Yplus L = Y₂)) :
    (componentFactor Yplus L = Y₂ ∧ V₂ ≤ L) ∨
      (Yplus = Y ∧ componentFactor Yplus L = Y₁ ∧ V₁ ≤ L) := by
  have hn := le_normalizer_of_normal_subgroupOf hLI
  have hle (W N : Subgroup G) (hWI : W ≤ I) (hWN : ⁅W, N⁆ = W)
      (he : componentFactor Yplus L = N) : W ≤ L := by
    rw [← hWN]
    exact (commutator_mono le_rfl (he ▸ componentFactor_le Yplus L)).trans
      (le_normalizer_iff_commutator_le_right.mp (hWI.trans hn))
  rcases hpair with ⟨hL, _⟩ | ⟨hL, hC⟩
  · exact Or.inl ⟨hL, hle V₂ Y₂ hV₂I hgen₂ hL⟩
  · have hc : V₂ ≤ centralizer (L : Set G) := by
      rw [← hgen₂]
      exact (commutator_mono le_rfl (hC ▸ centralizingFactor_le Yplus L)).trans
        (le_normalizer_iff_commutator_le_right.mp (hV₂I.trans (normalizes_centralizer hLI)))
    have hy : Yplus = Y := by
      rcases hcase with h | h
      · exact h
      · exact (hLM ((le_centralizer_iff.mpr hc).trans
          ((Subgroup.centralizer_le_normalizer _).trans (hcontrol h)))).elim
    exact Or.inr ⟨hy, hL, hle V₁ Y₁ hV₁I (hgen₁ hy) hL⟩

/-- The two-conjugate conclusion of 1.2.1(3) identifies the actual orbit
join; there is no independently chosen subgroup called `L₀`. -/
theorem componentOrbit_eq_sup_of_two_conjugates (L S : Subgroup G) (s : S)
    (htwo : ∀ a : S, L.map (MulAut.conj (a : G)).toMonoidHom = L ∨
      L.map (MulAut.conj (a : G)).toMonoidHom = L.map (MulAut.conj (s : G)).toMonoidHom) :
    componentOrbit L S = L ⊔ L.map (MulAut.conj (s : G)).toMonoidHom := by
  apply le_antisymm
  · apply iSup_le
    intro a
    rcases htwo a with h | h
    · exact h.le.trans le_sup_left
    · exact h.le.trans le_sup_right
  · exact sup_le (le_componentOrbit L S)
      (le_iSup (fun a : S => L.map (MulAut.conj (a : G)).toMonoidHom) s)

/-- Multiplication and the actual conjugation map construct the A₄ square.
The source chief-factor argument must supply generation, disjointness, and
commutation; an abstract product configuration is not an input. -/
theorem alternating_square_of_conjugate_factors (Y A : Subgroup G) (t : G)
    (hgen : Y = A ⊔ A.map (MulAut.conj t).toMonoidHom)
    (hd : Disjoint A (A.map (MulAut.conj t).toMonoidHom))
    (hc : A ≤ centralizer (A.map (MulAut.conj t).toMonoidHom : Set G))
    (eA : A ≃* alternatingGroup (Fin 4)) :
    Nonempty (Y ≃* (alternatingGroup (Fin 4) × alternatingGroup (Fin 4))) := by
  obtain ⟨e, _⟩ := exists_mulEquiv_prod_sup_of_disjoint_of_commuting _ _ hd hc
  let et : A ≃* A.map (MulAut.conj t).toMonoidHom := (MulAut.conj t).subgroupMap A
  exact ⟨(MulEquiv.subgroupCongr hgen).trans (e.symm.trans
    (eA.prodCongr (et.symm.trans eA)))⟩

/-- The two-factor component orbit has an actual projection onto L,
with kernel the other conjugate and identity restriction to L. -/
theorem exists_component_orbit_projection (L S : Subgroup G) (s : S)
    (htwo : ∀ a : S, L.map (MulAut.conj (a : G)).toMonoidHom = L ∨
      L.map (MulAut.conj (a : G)).toMonoidHom = L.map (MulAut.conj (s : G)).toMonoidHom)
    (hd : Disjoint L (L.map (MulAut.conj (s : G)).toMonoidHom))
    (hc : L ≤ centralizer (L.map (MulAut.conj (s : G)).toMonoidHom : Set G)) :
    ∃ f : componentOrbit L S →* L, Function.Surjective f ∧
      f.ker = (L.map (MulAut.conj (s : G)).toMonoidHom).subgroupOf (componentOrbit L S) ∧
      ∀ l : L, f (inclusion (le_componentOrbit L S) l) = l := by
  have he := componentOrbit_eq_sup_of_two_conjugates L S s htwo
  obtain ⟨g, hg, hk, hl, _⟩ := exists_left_projection_of_disjoint_of_commuting _ _ hd hc
  let e := MulEquiv.subgroupCongr he
  refine ⟨g.comp e.toMonoidHom, hg.comp e.surjective, ?_, ?_⟩
  · ext x
    exact SetLike.ext_iff.mp hk (e x)
  · intro l
    exact hl l

end CFSG.Quasithin.Chapter15.Section03.RankTwo
