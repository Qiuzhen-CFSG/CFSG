module

public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.Candidates.RankAlternatives.DiagonalProduct.LinearCore.MatrixImage.LocalSetup
public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.Candidates.RankAlternatives.DiagonalProduct.LinearCore.MatrixImage.BorelPlacement.Source
public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.Candidates.RankAlternatives.DiagonalProduct.LinearCore.MatrixImage.CubicCoverage
public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.Candidates.RankAlternatives.DiagonalProduct.LinearCore.MatrixImage.CubicBorel
public import Theory.SpecificGroups.PSL3.OuterSolvable.Coverage

/-!
# The source assembly for the linear quotient-action image

The preceding reductions isolate three concrete obligations: placement of the
actual Sylow normalizer, coverage of cubic actors by inner diagonal actions,
and the cubic Borel calculation.  For the genuine `SourceSetup`, each is now
discharged in the supplied projective coordinates.  The field, quotient
equivalence, conjugation and matrix from `DiagonalCoordinates` are kept
unchanged, including the order-four central-cover branch.

This is the image premise used by `LinearCore.cover_of_action_image`.  It does
not use the later kernel-action argument or any product containment.

Source: Aschbacher--Smith, combined manuscript (1 March 2004), final
paragraph of 15.3.37, printed p.1135, with 15.3.11--12, 15.3.33 and
15.3.36--37.
-/

public section

open Subgroup Theory.GroupTheory
open scoped MatrixGroups

namespace CFSG.Quasithin.Chapter15.Section03.Candidates.LinearCore.MatrixImage

variable {G : Type*} [Group G] [Finite G]

/-- The actual quotient-action image is generated by the component residual and
the supplied order-three actor.  Every auxiliary model fact is discharged
from the same `SourceSetup` and the exact supplied field coordinates. -/
theorem image_le_of_source_setup {d : CharacteristicTwo.LocalData G}
    {I L : Subgroup G} (h : SourceSetup d I L)
    (hn : d.Yplus ≤ normalizer (L : Set G))
    (y : d.Yplus) (hy : orderOf y = 3)
    {F : Type*} [Field F] [Finite F]
    (hcase : LinearCase L (Nat.card F))
    (w : DiagonalCoordinates L (y : G) F) :
    (quotientAction hn w.e).range ≤
      ((componentPart d.Yplus L).subgroupOf d.Yplus).map (quotientAction hn w.e) ⊔
        zpowers (quotientAction hn w.e y) := by
  obtain ⟨n, hnpos, heven, hcard⟩ := hcase.even_card
  obtain ⟨b⟩ := h.borelPlacement hn y hy hcase w
  have hstandard : Matrix.PSL3.OuterSolvable.standard F = ⊤ :=
    Matrix.PSL3.OuterSolvable.standard_eq_top_of_two_power_card F hnpos hcard
  exact CubicCoverage.image_le_of_source_borel_of_standard h hn y hy hcase w b
    hstandard (cubicBorelGeneration F hnpos heven hcard)

/-- Unpack the supplied linear witness once, then apply the source assembly to
that same field, quotient equivalence, conjugation and matrix. -/
theorem image_witness_of_source_setup {d : CharacteristicTwo.LocalData G}
    {I L : Subgroup G} (h : SourceSetup d I L)
    (hn : d.Yplus ≤ normalizer (L : Set G))
    (y : d.Yplus) (hy : orderOf y = 3) {q : ℕ}
    (hcase : LinearCase L q)
    (hdiag : LinearDiagonalOnTwoQuotient L (y : G) q) :
    ∃ (F : Type) (_ : Field F) (_ : Finite F), Nat.card F = q ∧
      ∃ w : DiagonalCoordinates L (y : G) F,
        (quotientAction hn w.e).range ≤
          ((componentPart d.Yplus L).subgroupOf d.Yplus).map (quotientAction hn w.e) ⊔
            zpowers (quotientAction hn w.e y) := by
  obtain ⟨F, hF, hfin, hcard, ⟨w⟩⟩ := diagonalCoordinates_iff.mp hdiag
  have hfield : LinearCase L (Nat.card F) := hcard.symm ▸ hcase
  exact ⟨F, hF, hfin, hcard, w,
    image_le_of_source_setup h hn y hy hfield w⟩

end CFSG.Quasithin.Chapter15.Section03.Candidates.LinearCore.MatrixImage
