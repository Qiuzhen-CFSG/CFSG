module

public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.Candidates.RankAlternatives.DiagonalProduct.CoreRemoval
public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.Candidates.SectionCentralizers
public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.Candidates.SuzukiExclusion.LocalReduction
public import Theory.GroupTheory.CentralCharacteristicAutomorphisms

/-!
# Lifting the linear component action through its actual kernel

The quotient action is conjugation on L/O₂(L), transported through the
chosen multiplicative equivalence. For a perfect L with central two-core,
its kernel is precisely C_{Y₊}(L), including when the center is nontrivial.
The three-free centralizer bound and the three-group quotient Y/O₂(Y)
put this kernel in the original O₂(Y).

Write A = O²(Y₊ ∩ L). If the action image is generated by the image of A
and the chosen element y of order three, then Y₊ is covered by A⟨y⟩O₂(Y).
For the action bound it suffices to prove [C_{Y₊}(L), y] ≤ A: modulo A
and the action kernel, the group is generated by y and is a three-group,
so every two-subgroup has trivial image. A commutator calculation then
lifts the bound from the kernel to Y₊ ∩ O₂(Y).

Image generation and the kernel commutator bound remain explicit premises.
In particular matrix image calculations alone do not control the kernel.
No exponent-three assumption on Y₊ or containment O₂(Y) ≤ Y₊ is used.
The generic three-free-subgroup lemma is reused from SuzukiExclusion;
none of that branch's model premises is consumed.

Source: Aschbacher--Smith, combined manuscript (1 March 2004), final
paragraph of 15.3.37, printed p.1135, with 15.3.7 and 15.3.12.
-/

@[expose] public section

open Subgroup Theory.GroupTheory
open scoped Pointwise commutatorElement

namespace CFSG.Quasithin.Chapter15.Section03.Candidates.LinearCore
variable {G H : Type*} [Group G] [Group H]

/-- Conjugation on the actual two-core quotient, in the chosen coordinates. -/
def quotientAction {Yplus L : Subgroup G} (hn : Yplus ≤ normalizer (L : Set G))
    (e : (L ⧸ pCore 2 L) ≃* H) : Yplus →* MulAut H :=
  (MulAut.congr e).toMonoidHom.comp ((quotientAut (pCore 2 L)).comp
    (L.normalizerMonoidHom.comp (inclusion hn)))

/-- The transported action evaluated on a quotient representative. -/
theorem quotientAction_apply {Yplus L : Subgroup G}
    (hn : Yplus ≤ normalizer (L : Set G)) (e : (L ⧸ pCore 2 L) ≃* H)
    (y : Yplus) (x : L) :
    quotientAction hn e y (e (QuotientGroup.mk' (pCore 2 L) x)) =
      e (QuotientGroup.mk' (pCore 2 L)
        (L.normalizerMonoidHom ⟨y, hn y.property⟩ x)) := by
  change e (quotientAut (pCore 2 L)
    (L.normalizerMonoidHom ⟨y, hn y.property⟩)
    (e.symm (e (QuotientGroup.mk' (pCore 2 L) x)))) = _
  rw [e.symm_apply_apply, quotientAut_apply_mk]

/-- A supplied compatible matrix action is the action of the very same actor. -/
theorem quotientAction_eq_of_compatible {Yplus L : Subgroup G}
    (hn : Yplus ≤ normalizer (L : Set G)) (e : (L ⧸ pCore 2 L) ≃* H)
    (y : Yplus) (α : MulAut L) (β : MulAut H)
    (hconj : ConjugationOn L y α)
    (hcompat : ∀ x : L, e (QuotientGroup.mk' (pCore 2 L) (α x)) =
      β (e (QuotientGroup.mk' (pCore 2 L) x))) :
    quotientAction hn e y = β := by
  ext z
  obtain ⟨x, rfl⟩ := (e.surjective.comp (QuotientGroup.mk'_surjective _)) z
  change quotientAction hn e y (e (QuotientGroup.mk' (pCore 2 L) x)) =
    β (e (QuotientGroup.mk' (pCore 2 L) x))
  rw [quotientAction_apply, ← hcompat]
  have he : L.normalizerMonoidHom ⟨y, hn y.property⟩ x = α x :=
    Subtype.ext (hconj x).symm
  rw [he]

/-- Perfectness identifies the section-action kernel with the ordinary centralizer. -/
theorem quotientAction_ker {Yplus L : Subgroup G} [Group.IsPerfect L]
    (hn : Yplus ≤ normalizer (L : Set G)) (e : (L ⧸ pCore 2 L) ≃* H)
    (hcore : pCore 2 L ≤ center L) :
    (quotientAction hn e).ker = (centralizer (L : Set G)).subgroupOf Yplus := by
  ext y
  change quotientAction hn e y = 1 ↔ (y : G) ∈ centralizer (L : Set G)
  rw [← sectionCentralizer_eq_centralizer_of_perfect hcore]
  constructor
  · intro hy
    have hk : ((quotientAction hn e).ker.map Yplus.subtype) ≤
        Chapter4.sectionCentralizer L := by
      apply le_commutatorPreimage ((map_subtype_le _).trans hn)
      apply commutator_le.mpr
      rintro _ ⟨a, ha, rfl⟩ x hx
      have he := DFunLike.congr_fun ha (e (QuotientGroup.mk' (pCore 2 L) ⟨x, hx⟩))
      rw [quotientAction_apply] at he
      have he' := e.injective he
      have hm := QuotientGroup.eq_iff_div_mem.mp he'
      exact ⟨L.normalizerMonoidHom ⟨a, hn a.property⟩ ⟨x, hx⟩ / ⟨x, hx⟩,
        hm, by simp only [div_eq_mul_inv]; rfl⟩
    exact hk (mem_map.mpr ⟨y, hy, rfl⟩)
  · intro hy
    have hc : (y : G) ∈ centralizer (L : Set G) := by
      rwa [sectionCentralizer_eq_centralizer_of_perfect hcore] at hy
    ext z
    obtain ⟨x, rfl⟩ := (e.surjective.comp (QuotientGroup.mk'_surjective _)) z
    change quotientAction hn e y (e (QuotientGroup.mk' (pCore 2 L) x)) =
      e (QuotientGroup.mk' (pCore 2 L) x)
    rw [quotientAction_apply]
    apply congrArg e
    apply congrArg (QuotientGroup.mk' (pCore 2 L))
    apply Subtype.ext
    change (y : G) * (x : G) * (y : G)⁻¹ = x
    rw [← mem_centralizer_iff.mp hc x x.property]
    group

private theorem generated_mod_kernel {X : Type*} [Group X] (f : X →* H)
    (A : Subgroup X) (y : X)
    (hgen : f.range ≤ A.map f ⊔ zpowers (f y)) :
    (A ⊔ zpowers y) ⊔ f.ker = ⊤ := by
  apply top_unique
  rw [← Subgroup.comap_map_eq]
  rw [Subgroup.map_sup, MonoidHom.map_zpowers]
  intro x _
  exact hgen ⟨x, rfl⟩

private theorem two_subgroup_le_component_kernel {X : Type*} [Group X]
    (f : X →* H) (A : Subgroup X) [A.Normal] (y : X)
    (hy : orderOf y = 3) (hgen : f.range ≤ A.map f ⊔ zpowers (f y))
    (Q : Subgroup X) (hQ : IsPGroup 2 Q) : Q ≤ A ⊔ f.ker := by
  let D := A ⊔ f.ker
  let g := QuotientGroup.mk' D
  have hs : D ⊔ zpowers y = ⊤ := by
    simpa only [D, sup_assoc, sup_comm, sup_left_comm] using generated_mod_kernel f A y hgen
  have h3 : IsPGroup 3 (X ⧸ D) := isPGroup_quotient_of_sup_eq_top D (zpowers y)
    (IsPGroup.of_card (n := 1) (by simpa only [Nat.card_zpowers, pow_one] using hy)) hs
  have hd := (hQ.map g).disjoint_of_coprime (h3.to_subgroup (Q.map g)) (by decide)
  have he : Q.map g = ⊥ := disjoint_self.mp hd
  have hle := (Subgroup.map_eq_bot_iff Q).mp he
  simpa only [g, QuotientGroup.ker_mk'] using hle

private theorem cover_and_action_of_image {Yplus Q A : Subgroup G}
    (hn : Yplus ≤ normalizer (A : Set G))
    (f : Yplus →* H) (y : Yplus) (hy : orderOf y = 3)
    (hQ : IsPGroup 2 Q) (hkQ : f.ker.map Yplus.subtype ≤ Q)
    (hgen : f.range ≤ (A.subgroupOf Yplus).map f ⊔ zpowers (f y))
    (hkc : ∀ c : Yplus, c ∈ f.ker → ⁅(c : G), (y : G)⁆ ∈ A) :
    ((Yplus : Set G) ⊆ ((A : Set G) * (zpowers (y : G) : Set G)) * (Q : Set G)) ∧
      ∀ q ∈ Yplus, q ∈ Q → ⁅q, (y : G)⁆ ∈ A := by
  let B := A.subgroupOf Yplus
  let : B.Normal := normal_subgroupOf_of_le_normalizer hn
  constructor
  · intro x hx
    have hm : (⟨x, hx⟩ : Yplus) ∈ (B ⊔ zpowers y) ⊔ f.ker := by
      rw [generated_mod_kernel f B y hgen]
      trivial
    obtain ⟨d, hd, k, hk, he⟩ := mem_sup_of_normal_right.mp hm
    obtain ⟨a, ha, t, ht, hat⟩ := mem_sup_of_normal_left.mp hd
    refine ⟨d, ⟨a, ha, t, ?_, congrArg Subtype.val hat⟩,
      k, hkQ (mem_map.mpr ⟨k, hk, rfl⟩), congrArg Subtype.val he⟩
    exact (MonoidHom.map_zpowers Yplus.subtype y) ▸ mem_map_of_mem Yplus.subtype ht
  · intro q hq hqQ
    have hm : (⟨q, hq⟩ : Yplus) ∈ B ⊔ f.ker :=
      two_subgroup_le_component_kernel f B y hy hgen (Q.subgroupOf Yplus)
        hQ.comap_subtype hqQ
    obtain ⟨a, ha, c, hc, he⟩ := mem_sup_of_normal_left.mp hm
    have hcA := hkc c hc
    have haA : (a : G) ∈ A := ha
    have hay : ⁅(a : G), (y : G)⁆ ∈ A :=
      (le_normalizer_iff_commutator_le_left.mp hn)
        (commutator_mem_commutator haA y.property)
    have heG : (a : G) * (c : G) = q := congrArg Subtype.val he
    rw [← heG]
    change ⁅(a : G) * (c : G), (y : G)⁆ ∈ A
    rw [commutatorElement_mul_left_eq_conj_mul]
    exact A.mul_mem ((A.le_normalizer haA _).mp hcA) hay

variable [Finite G]

omit [Finite G] in
/-- The kernel lies in the original two-core by the three-free centralizer bound. -/
theorem quotientAction_kernel_le_core {Y Yplus I L : Subgroup G}
    [Group.IsPerfect L]
    (hYplus : Yplus ≤ Y) (hY : IsPGroup 3 (Y ⧸ pCore 2 Y))
    (hYI : Yplus ≤ I) (hn : Yplus ≤ normalizer (L : Set G))
    (e : (L ⧸ pCore 2 L) ≃* H) (hcore : pCore 2 L ≤ center L)
    (hC : Nat.Coprime 3 (Nat.card (I ⊓ centralizer (L : Set G) : Subgroup G))) :
    (quotientAction hn e).ker.map Yplus.subtype ≤ Y.pCoreIn 2 := by
  have hK : (quotientAction hn e).ker.map Yplus.subtype ≤
      I ⊓ centralizer (L : Set G) := by
    rw [quotientAction_ker hn e hcore]
    rintro x ⟨a, ha, rfl⟩
    exact ⟨hYI a.property, ha⟩
  exact SuzukiExclusion.le_twoCore_of_three_free
    ((map_subtype_le _).trans hYplus) hY
    (fun hd => (Nat.prime_three.coprime_iff_not_dvd.mp hC)
      (hd.trans (card_dvd_of_le hK)))

/-- Image generation and the kernel action bound give both clauses of the core cover.
These two premises still require the local linear argument. -/
theorem cover_of_action_image {Y Yplus I L : Subgroup G}
    [Group.IsPerfect L]
    (hYplus : Yplus ≤ Y) (hY : IsPGroup 3 (Y ⧸ pCore 2 Y))
    (hYI : Yplus ≤ I) (hn : Yplus ≤ normalizer (L : Set G))
    (e : (L ⧸ pCore 2 L) ≃* H) (hcore : pCore 2 L ≤ center L)
    (hC : Nat.Coprime 3 (Nat.card (I ⊓ centralizer (L : Set G) : Subgroup G)))
    (y : Yplus) (hy : orderOf y = 3)
    (himage : (quotientAction hn e).range ≤
      ((componentPart Yplus L).subgroupOf Yplus).map (quotientAction hn e) ⊔
        zpowers (quotientAction hn e y))
    (hkernel : ∀ c ∈ Yplus, c ∈ centralizer (L : Set G) →
      ⁅c, (y : G)⁆ ∈ componentPart Yplus L) :
    DiagonalCoreCover Y Yplus L y := by
  apply cover_and_action_of_image (ComponentIntersection.normalizes_intersectionResidual hn)
    (quotientAction hn e) y hy (Y.isPGroup_pCoreIn 2)
    (quotientAction_kernel_le_core hYplus hY hYI hn e hcore hC) himage
  intro c hc
  have hcent : (c : G) ∈ centralizer (L : Set G) := by
    have he := quotientAction_ker hn e hcore
    exact (show c ∈ (centralizer (L : Set G)).subgroupOf Yplus from he ▸ hc)
  exact hkernel c c.property hcent

end CFSG.Quasithin.Chapter15.Section03.Candidates.LinearCore
