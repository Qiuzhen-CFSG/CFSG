module

public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.Candidates.RankAlternatives.InitialModels
public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.Candidates.RankAlternatives.RankOneAction.ActionKernel
public import Theory.AtlasPort.ExceptionalIsomorphisms.Order168

/-!
# The actual outer quotient in the PSL₃(2) case

Over F₂ every field automorphism and every diagonal outer automorphism is
trivial. Thus the image of the concrete standard automorphism group in
Aut(PSL₃(2))/Inn(PSL₃(2)) is generated by the graph involution. It is a
two-group. Full automorphism coverage is the remaining explicit hypothesis.

A prime-field equivalence transports this actual quotient to the component.
Its two-perfect Y₊ action then gives witnesses in the genuine section kernel.
No assertion here derives coverage from the standard generators alone.
Source: Aschbacher--Smith, the rank-one paragraph of 15.3.37, printed p.1135.
-/

@[expose] public section

open Subgroup
open scoped MatrixGroups
namespace CFSG.Quasithin.Chapter15.Section03.Candidates.RankOneAction
open Matrix.PSL3.OuterSolvable

private theorem zmodTwo_field_eq_one (a : ZMod 2 ≃+* ZMod 2) : a = 1 := by
  ext x
  have hx : x = 0 ∨ x = 1 := (by decide : ∀ x : ZMod 2, x = 0 ∨ x = 1) x
  rcases hx with rfl | rfl <;> simp

private theorem zmodTwo_unit_eq_one (u : (ZMod 2)ˣ) : u = 1 := by
  ext
  have hx : u.val = 0 ∨ u.val = 1 := (by decide : ∀ x : ZMod 2, x = 0 ∨ x = 1) u.val
  exact hx.resolve_left u.ne_zero

private theorem binary_linear_outer_eq_bot : innerDiagonalOuter (ZMod 2) = ⊥ := by
  apply eq_bot_iff.mpr
  rintro _ ⟨g, rfl⟩
  exact det_ker_le_linearOuterAction_ker (ZMod 2)
    (zmodTwo_unit_eq_one (Matrix.GeneralLinearGroup.det g))

private theorem binary_field_range_eq_bot : (fieldAction (ZMod 2)).range = ⊥ := by
  apply eq_bot_iff.mpr
  rintro _ ⟨a, rfl⟩
  rw [zmodTwo_field_eq_one a, map_one]
  exact one_mem _

theorem binary_standard_outer_eq : standardOuter (ZMod 2) =
    zpowers (QuotientGroup.mk' (MulAut.innerSubgroup PSL(3, ZMod 2))
      (graph (ZMod 2))) := by
  unfold standardOuter standard
  rw [Subgroup.map_sup, Subgroup.map_sup, binary_field_range_eq_bot, Subgroup.map_bot, sup_bot_eq]
  have he : (innerDiagonal (ZMod 2)).map
      (QuotientGroup.mk' (MulAut.innerSubgroup PSL(3, ZMod 2))) =
      innerDiagonalOuter (ZMod 2) := by
    rw [innerDiagonal, MonoidHom.map_range]
    rfl
  rw [he, binary_linear_outer_eq_bot, bot_sup_eq, MonoidHom.map_zpowers]

theorem binary_outer_twoGroup_of_coverage
    (hc : standard (ZMod 2) = ⊤) : IsPGroup 2 (MulAut.Outer PSL(3, ZMod 2)) := by
  let q := QuotientGroup.mk' (MulAut.innerSubgroup PSL(3, ZMod 2))
  have hs : standardOuter (ZMod 2) = ⊤ := by
    rw [standardOuter, hc, map_top_of_surjective q (QuotientGroup.mk'_surjective _)]
  have hg : (q (graph (ZMod 2))) ^ 2 = 1 := by
    rw [← map_pow, graph_sq, map_one]
  have hz : IsPGroup 2 (zpowers (q (graph (ZMod 2)))) := by
    apply isPGroup_iff_pow_pow_eq_one.mpr
    rintro ⟨x, k, rfl⟩
    refine ⟨1, Subtype.ext ?_⟩
    change (q (graph (ZMod 2)) ^ k) ^ (2 ^ 1) = 1
    rw [pow_one, ← zpow_natCast, ← zpow_mul, mul_comm k, zpow_mul,
      zpow_natCast, hg, one_zpow]
  rw [← binary_standard_outer_eq, hs] at hz
  exact hz.of_equiv (Subgroup.topEquiv : (⊤ : Subgroup (MulAut.Outer PSL(3, ZMod 2))) ≃* _)
theorem Setup.inner_of_psl3_two_coverage
    {G : Type*} [Group G] [Finite G] {Yplus S M I L : Subgroup G}
    (h : Setup Yplus S M I L) (hm : ClassicalGroup.IsPSL L 3 2)
    (hc : standard (ZMod 2) = ⊤) :
    ComponentIntersection.InducesInnerOnTwoCoreQuotient Yplus L := by
  obtain ⟨F, _, _, hF, ⟨e⟩⟩ := hm
  let := Fintype.ofFinite F
  let f : F ≃+* ZMod 2 :=
    (ZMod.ringEquivOfPrime F Nat.prime_two
      (by simpa only [Nat.card_eq_fintype_card] using hF)).symm
  let E : L ≃* PSL(3, ZMod 2) := e.trans (Atlas.fieldEquivPSL 3 f)
  exact h.inner_of_outer_twoGroup
    ((binary_outer_twoGroup_of_coverage hc).of_equiv (MulAut.outerCongr E).symm)

end CFSG.Quasithin.Chapter15.Section03.Candidates.RankOneAction
