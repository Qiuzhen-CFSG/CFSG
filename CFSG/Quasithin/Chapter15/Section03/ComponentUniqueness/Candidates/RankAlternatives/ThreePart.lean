module

public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.Candidates.RankAlternatives
public import CFSG.Quasithin.Chapter15.Section03.Preliminaries.ComponentIntersection.QuotientCoordinates

/-!+# The three-part reduction used by 15.3.39--40

The statement of 15.3.37(2) prints `|Y_C| = 3`, but its proof and the
application in 15.3.40 establish and use `|Y_C|₃ = 3`. We give that reduction
a separate name, retaining all other clauses and the literal output interface.

The weak orbit consequence needed by 15.3.39 follows from these alternatives.
It also follows directly from the nontrivial-orbit argument and the precise
prime-to-three residual equality in 1.2.2, independently of the single-component
classification. The rank-one assembly below transports the actual section
centralizer in 15.3.12 to the ordinary centralizer and constructs the two
three-parts and the E₉ equivalence from the quotient orders and exponent.
Its model, splitting and quotient-order premises still require proof in the
source reduction; it does not assert the complete alternatives.

Source: Aschbacher--Smith, combined manuscript (1 March 2004), printed
pp.1125, 1135 and 1138; correction documented in `docs/quasithin-proof-basis.md`.
-/

@[expose] public section

open Subgroup Theory.GroupTheory
open scoped Pointwise
namespace CFSG.Quasithin.Chapter15.Section03.Candidates
variable {G : Type*} [Group G]

/-- The corrected second branch of 15.3.37. Only the full-order assertion
for the centralizer is replaced, by its three-part assertion. -/
structure RankOneThreePartSplit (Yplus L L₀ : Subgroup G) : Prop where
  orbit_eq : L = L₀
  model : RankOneModel L
  product : (Yplus : Set G) =
    (componentPart Yplus L : Set G) * (centralizingPart Yplus L : Set G)
  component_three_part : 3 ^ (Nat.card (componentPart Yplus L)).factorization 3 = 3
  centralizer_three_part : 3 ^ (Nat.card (centralizingPart Yplus L)).factorization 3 = 3
  quotient : Nonempty ((Yplus ⧸ pCore 2 Yplus) ≃*
    Multiplicative (Fin 2 → ZMod 3))

/-- The separately named reduction, with the first and third alternatives
of 15.3.37 unchanged. -/
def Alternatives15337ThreePart (Yplus L L₀ : Subgroup G) : Prop :=
  Yplus ≤ L₀ ∨ RankOneThreePartSplit Yplus L L₀ ∨ RankTwoDiagonal Yplus L L₀

/-- The only consequence of the alternatives needed by the orbit argument
in 15.3.39. Neither split branch can have a nontrivial component orbit. -/
theorem Alternatives15337ThreePart.le_of_orbit_ne {Yplus L L₀ : Subgroup G}
    (h : Alternatives15337ThreePart Yplus L L₀) (hne : L ≠ L₀) : Yplus ≤ L₀ := by
  rcases h with h | h | h
  · exact h
  · exact (hne h.orbit_eq).elim
  · exact (hne h.1).elim

variable [Finite G]

/-- The weak orbit consequence can be proved before the single-component
model analysis. The earlier input is exactly the I-orbit residual in 1.2.2. -/
theorem yplus_le_localSpan_of_ne_of_local {Yplus M I L S : Subgroup G}
    (hI : I ∈ outsideFamily Yplus S M)
    (hθ : theta (M ⊓ I) = Yplus) (hne : L ≠ localSpan L S)
    (hindex : (normalizer (L : Set G)).relIndex I ≤ 2)
    (hres : (primeToResidual 3 I).map I.subtype = localSpan L I) :
    Yplus ≤ localSpan L S := by
  have horbit := localSpan_eq_of_nontrivial_orbit (le_sup_right.trans hI.1.2)
    (lt_of_le_of_ne (le_conjugateSpanBy L S) hne) hindex
  exact (yplus_le_theta_of_local hθ).trans
    ((theta_le_threeResidual I).trans (hres.trans horbit).le)

/-- The nontrivial-orbit branch also inhabits the corrected reduction. -/
theorem alternatives15337ThreePart_of_nontrivial_orbit {Yplus M I L S : Subgroup G}
    (hI : I ∈ outsideFamily Yplus S M)
    (hθ : theta (M ⊓ I) = Yplus) (hne : L ≠ localSpan L S)
    (hindex : (normalizer (L : Set G)).relIndex I ≤ 2)
    (hres : (primeToResidual 3 I).map I.subtype = localSpan L I) :
    Alternatives15337ThreePart Yplus L (localSpan L S) :=
  Or.inl (yplus_le_localSpan_of_ne_of_local hI hθ hne hindex hres)

/-- The residual branch of A.3.18 gives the precise θ equality, since the
positive-rank quasisimple component is itself generated by order-three elements. -/
theorem theta_eq_of_threeResidual {I L : Subgroup G} [IsQuasisimple L]
    (hcore : center L ≤ pCore 2 L) (hrank : 1 ≤ primeRank 3 L)
    (hLI : L ≤ I) (hres : (primeToResidual 3 I).map I.subtype = L) :
    theta I = L := by
  refine le_antisymm ((theta_le_threeResidual I).trans hres.le) ?_
  rw [← theta_eq_self_of_quasisimple hcore hrank]
  exact theta_mono hLI

/-- Arithmetic and centralizer-convention assembly for the corrected rank-one
branch. The product and the three quotient facts are the genuine conclusions
of 15.3.12(2); no full-order assertion for the centralizer is used. -/
theorem rankOneThreePartSplit_of_section_splitting {Yplus L L₀ : Subgroup G}
    [Group.IsPerfect L] (hcore : pCore 2 L ≤ center L)
    (horbit : L = L₀) (hmodel : RankOneModel L)
    (hproduct : (Yplus : Set G) =
      (ComponentIntersection.intersectionResidual Yplus L : Set G) *
        (ComponentIntersection.centralizerResidual Yplus L : Set G))
    (hLcard : Nat.card (ComponentIntersection.TwoCoreQuotient
      (ComponentIntersection.intersectionResidual Yplus L)) = 3)
    (hCcard : Nat.card (ComponentIntersection.TwoCoreQuotient
      (ComponentIntersection.centralizerResidual Yplus L)) = 3)
    (hYcard : Nat.card (Yplus ⧸ pCore 2 Yplus) = 9)
    (hYexp : Monoid.exponent (Yplus ⧸ pCore 2 Yplus) ∣ 3) :
    RankOneThreePartSplit Yplus L L₀ := by
  have hcentral : ComponentIntersection.centralizerResidual Yplus L =
      centralizingPart Yplus L := sectionCentralizingPart_eq_centralizingPart hcore
  refine ⟨horbit, hmodel, ?_, ?_, ?_, ?_⟩
  · simpa only [hcentral, ComponentIntersection.intersectionResidual] using hproduct
  · exact ComponentIntersection.three_part_eq_three_of_quotient_card hLcard
  · rw [hcentral] at hCcard
    exact ComponentIntersection.three_part_eq_three_of_quotient_card hCcard
  · exact ComponentIntersection.quotient_equiv_elementaryNine_of_card hYcard hYexp

end CFSG.Quasithin.Chapter15.Section03.Candidates
