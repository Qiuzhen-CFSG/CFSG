module

public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.Candidates.Alternatives
public import CFSG.Quasithin.Chapter15.Section03.ComponentUniqueness.Candidates.SectionCentralizers
public import CFSG.Quasithin.Chapter15.Section03.Preliminaries.ComponentIntersection.Basic
public import Theory.GroupTheory.PResidual.PrimeTo
public import Theory.GroupTheory.PrimeRankZero

/-!
# Orbit branches and an order obstruction for the rank alternatives

We prove the nontrivial-component-orbit branches of 15.3.37 and the initial
alternatives of 15.3.43. The input from 1.2.2 is literally
`O^{3′}(I) = ⟨L^I⟩`. If `L < ⟨L^S⟩`, the orbit bound of 1.2.1(3)
identifies the I-span with the S-span. Order-three generation then places
Y₊ in this residual. A quasisimple L with two-group center and positive
three-rank is generated by its elements of order three, giving the further
identity `θ(I) = ⟨L^S⟩` needed by 15.3.43.

There is a source obstruction to the requested rank-one split: the statement
of 15.3.37(2) prints `|Y_C| = 3`, whereas its proof establishes only
`|Y_C|₃ = 3`. For the actual ordinary-centralizer residual, the former is
incompatible with 15.3.11(6),(7) and the component orbit bound. Indeed, Y_C
is normal in Y₊, which is normal in M ∩ I. If Y_C had order three, it would
lie in O₃(Y₊), hence O₃(M ∩ I). But that core is trivial because
`F*(M ∩ I) = O₂(M ∩ I)`. We use the checked section-centralizer comparison
and prove the obstruction directly with this generalized-Fitting input.

The existing output propositions are preserved. These results do not assert
either complete classification alternative, nor refute the full standing
counterexample setup: the single-component branches remain to be settled.

Source: Aschbacher--Smith, combined manuscript (1 March 2004),
1.2.2 (printed p.504), 15.3.11--12 (pp.1123--1125), 15.3.37 (p.1135),
and the initial alternatives in the proof of 15.3.43 (p.1139).
-/

public section

open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter15.Section03.Candidates
variable {G : Type*} [Group G]

/-- Every order-three generator belongs to the prime-to-three residual. -/
theorem theta_le_threeResidual (I : Subgroup G) :
    theta I ≤ (primeToResidual 3 I).map I.subtype := by
  apply (closure_le _).mpr
  rintro x ⟨hxI, hx⟩
  refine ⟨⟨x, hxI⟩, mem_primeToResidual_of_pow (n := 1) ?_, rfl⟩
  apply Subtype.ext
  change x ^ (3 ^ 1) = 1
  simpa only [pow_one, hx] using pow_orderOf_eq_one x

/-- The generation identity 15.3.11(6) embeds Y₊ into θ(I). -/
theorem yplus_le_theta_of_local {Yplus M I : Subgroup G}
    (hθ : theta (M ⊓ I) = Yplus) : Yplus ≤ theta I := by
  rw [← hθ]
  exact theta_mono inf_le_right

private theorem alternatives15337_of_orbit_residual {Yplus M I L S : Subgroup G}
    (hθ : theta (M ⊓ I) = Yplus)
    (hres : (primeToResidual 3 I).map I.subtype = localSpan L S) :
    Alternatives15337 Yplus L (localSpan L S) := by
  exact Or.inl ((yplus_le_theta_of_local hθ).trans ((theta_le_threeResidual I).trans hres.le))

variable [Finite G]

/-- A nontrivial S-orbit exhausts an I-orbit of size at most two. Thus the
source S-span equals the I-span appearing in 1.2.2. -/
theorem localSpan_eq_of_nontrivial_orbit {L S I : Subgroup G}
    (hSI : S ≤ I) (hlt : L < localSpan L S)
    (hindex : (normalizer (L : Set G)).relIndex I ≤ 2) :
    localSpan L I = localSpan L S := by
  classical
  have hs : ∃ s ∈ S, s ∉ normalizer (L : Set G) := by
    by_contra! hn
    exact hlt.not_ge (conjugateSpanBy_le le_rfl hn)
  obtain ⟨s, hs, hsN⟩ := hs
  let N := (normalizer (L : Set G)).subgroupOf I
  have hidx : N.index = 2 := by
    have hpos := N.index_ne_zero_of_finite
    have hnot : N.index ≠ 1 := by
      intro he
      have ht := Subgroup.index_eq_one.mp he
      have hmem : (⟨s, hSI hs⟩ : I) ∈ N := ht ▸ mem_top _
      exact hsN hmem
    change N.index ≤ 2 at hindex
    omega
  refine le_antisymm ?_ (conjugateSpanBy_mono le_rfl hSI)
  apply (closure_le _).mpr
  rintro x ⟨i, hi, l, hl, rfl⟩
  by_cases hiN : i ∈ normalizer (L : Set G)
  · exact le_conjugateSpanBy L S ((hiN l).mp hl)
  · have hn : s⁻¹ * i ∈ normalizer (L : Set G) := by
      have hs' : (⟨s, hSI hs⟩ : I)⁻¹ ∉ N := by
        simpa only [inv_mem_iff] using (show (⟨s, hSI hs⟩ : I) ∉ N from hsN)
      have hi' : (⟨i, hi⟩ : I) ∉ N := hiN
      exact (N.mul_mem_iff_of_index_two hidx).mpr (iff_of_false hs' hi')
    have hnL : (s⁻¹ * i) * l * (s⁻¹ * i)⁻¹ ∈ L := (hn l).mp hl
    apply Subgroup.subset_closure
    exact ⟨s, hs, _, hnL, by simp [mul_assoc]⟩

/-- Cauchy supplies an order-three element outside the two-group center.
Its normal closure, and hence θ(L), is all of the quasisimple group L. -/
theorem theta_eq_self_of_quasisimple {L : Subgroup G} [IsQuasisimple L]
    (hcore : center L ≤ pCore 2 L) (hrank : 1 ≤ primeRank 3 L) : theta L = L := by
  have hdvd : 3 ∣ Nat.card L := by
    by_contra hn
    have hz : primeRank 3 L = 0 := PrimeRank.eq_zero_iff_not_dvd_card.mpr hn
    omega
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := L) 3 hdvd
  have hnormal : L ≤ normalizer (theta L : Set G) :=
    L.le_normalizer.trans (normalizer_le_normalizer_theta L)
  let := normal_subgroupOf_of_le_normalizer hnormal
  rcases IsQuasisimple.normal_le_center_or_eq_top ((theta L).subgroupOf L) with hc | ht
  · have hxθ : x ∈ (theta L).subgroupOf L :=
      subset_closure ⟨x.property, (orderOf_injective L.subtype L.subtype_injective x).trans hx⟩
    have hp := (pCore_isPGroup (p := 2) (G := L)).orderOf_coprime
      (show Nat.Coprime 2 3 by decide) (⟨x, hcore (hc hxθ)⟩ : pCore 2 L)
    simp only [Subgroup.orderOf_mk, hx] at hp
    norm_num at hp
  · have he := congrArg (Subgroup.map L.subtype) ht
    simpa only [map_subgroupOf_eq_of_le (theta_le L), ← MonoidHom.range_eq_map, range_subtype] using he

/-- The residual equality, positive three-rank, and two-group center imply
the θ-equality required in the first alternative of 15.3.43. -/
theorem theta_eq_orbit_of_threeResidual {I L S : Subgroup G} [IsQuasisimple L]
    (hcore : center L ≤ pCore 2 L) (hrank : 1 ≤ primeRank 3 L)
    (hLI : L ≤ I) (hSI : S ≤ I)
    (hres : (primeToResidual 3 I).map I.subtype = localSpan L S) :
    theta I = localSpan L S := by
  refine le_antisymm ((theta_le_threeResidual I).trans hres.le) ?_
  apply conjugateSpanBy_le
  · rw [← theta_eq_self_of_quasisimple hcore hrank]
    exact theta_mono hLI
  · exact hSI.trans (I.le_normalizer.trans (normalizer_le_normalizer_theta I))

private theorem alternatives15343_of_orbit_residual {Yplus M I L S : Subgroup G}
    [IsQuasisimple L]
    (hθ : theta (M ⊓ I) = Yplus)
    (hcore : center L ≤ pCore 2 L) (hrank : 1 ≤ primeRank 3 L)
    (hLI : L ≤ I) (hSI : S ≤ I)
    (hres : (primeToResidual 3 I).map I.subtype = localSpan L S) :
    Alternatives15343 Yplus I L (localSpan L S) := by
  exact Or.inl ⟨yplus_le_theta_of_local hθ,
    theta_eq_orbit_of_threeResidual hcore hrank hLI hSI hres⟩

/-- The nontrivial-orbit branch of 15.3.37, conditional on the precise
prime-to-three residual conclusion of 1.2.2. The S-span is derived. -/
theorem alternatives15337_of_nontrivial_orbit {Yplus M I L S : Subgroup G}
    (hI : I ∈ outsideFamily Yplus S M)
    (hθ : theta (M ⊓ I) = Yplus) (hlt : L < localSpan L S)
    (hindex : (normalizer (L : Set G)).relIndex I ≤ 2)
    (hres : (primeToResidual 3 I).map I.subtype = localSpan L I) :
    Alternatives15337 Yplus L (localSpan L S) := by
  exact alternatives15337_of_orbit_residual hθ
    (hres.trans (localSpan_eq_of_nontrivial_orbit (le_sup_right.trans hI.1.2) hlt hindex))

/-- The nontrivial-orbit branch of the alternatives in 15.3.43. In addition
to containment, this proves θ(I) = L₀ with L₀ anchored to the S-span. -/
theorem alternatives15343_of_nontrivial_orbit {Yplus M I L S : Subgroup G}
    [IsQuasisimple L]
    (hI : I ∈ outsideFamily Yplus S M)
    (hθ : theta (M ⊓ I) = Yplus)
    (hcore : center L ≤ pCore 2 L) (hrank : 1 ≤ primeRank 3 L)
    (hLI : L ≤ I) (hlt : L < localSpan L S)
    (hindex : (normalizer (L : Set G)).relIndex I ≤ 2)
    (hres : (primeToResidual 3 I).map I.subtype = localSpan L I) :
    Alternatives15343 Yplus I L (localSpan L S) := by
  have hSI : S ≤ I := le_sup_right.trans hI.1.2
  exact alternatives15343_of_orbit_residual hθ hcore hrank hLI hSI
    (hres.trans (localSpan_eq_of_nontrivial_orbit hSI hlt hindex))

private theorem threeCore_eq_bot_of_fstar {H : Type*} [Group H] [Finite H]
    (hF : generalizedFitting H = pCore 2 H) : pCore 3 H = ⊥ := by
  have hle : pCore 3 H ≤ pCore 2 H :=
    (pCore_le_fitting H 3).trans ((fitting_le_generalizedFitting H).trans hF.le)
  have hd := IsPGroup.disjoint_of_ne 3 2 (by decide) (pCore 3 H) (pCore 2 H)
    pCore_isPGroup pCore_isPGroup
  exact eq_bot_iff.mpr (fun _ hx => hd.le_bot ⟨hx, hle hx⟩)

/-- The ordinary centralizer residual cannot have order three when its
normal overgroup lies normally in a group with F* = O₂. -/
theorem centralizingPart_card_ne_three_of_fstar {Yplus L H : Subgroup G}
    [Group.IsPerfect L] (hcore : pCore 2 L ≤ center L)
    (hYH : Yplus ≤ H) (hHY : H ≤ normalizer (Yplus : Set G))
    (hF : generalizedFitting H = pCore 2 H)
    (hYL : Yplus ≤ normalizer (L : Set G)) :
    Nat.card (centralizingPart Yplus L) ≠ 3 := by
  have he : ComponentIntersection.centralizerResidual Yplus L = centralizingPart Yplus L :=
    sectionCentralizingPart_eq_centralizingPart hcore
  have hnormal : Yplus ≤ normalizer (centralizingPart Yplus L : Set G) :=
    he ▸ ComponentIntersection.normalizes_centralizerResidual hYL
  intro hc
  have hCY : centralizingPart Yplus L ≤ Yplus := (map_subtype_le _).trans inf_le_left
  have hp : IsPGroup 3 (centralizingPart Yplus L) :=
    IsPGroup.of_card (n := 1) (by simpa using hc)
  have hCYcore : centralizingPart Yplus L ≤ Yplus.pCoreIn 3 :=
    le_pCoreIn_of_normalizes hp hCY hnormal
  have hcores : Yplus.pCoreIn 3 ≤ H.pCoreIn 3 :=
    pCoreAmbient_mono_of_isSubnormalIn Yplus H 3 hYH
      (normal_subgroupOf_of_le_normalizer hHY).isSubnormal
  have hHcore : H.pCoreIn 3 = ⊥ := by
    simp only [pCoreIn, threeCore_eq_bot_of_fstar hF, Subgroup.map_bot]
  have hb : centralizingPart Yplus L = ⊥ :=
    le_bot_iff.mp ((hCYcore.trans hcores).trans hHcore.le)
  have h1 := Subgroup.card_eq_one.mpr hb
  omega

/-- The genuine local inputs 15.3.11(6),(7) and the component orbit bound
exclude the stronger order clause printed in 15.3.37(2). -/
theorem centralizingPart_card_ne_three_of_local {Yplus S M I L : Subgroup G}
    [Group.IsPerfect L] (hcore : pCore 2 L ≤ center L)
    (hI : I ∈ outsideFamily Yplus S M)
    (hθ : theta (M ⊓ I) = Yplus)
    (hF : generalizedFitting (M ⊓ I : Subgroup G) = pCore 2 (M ⊓ I : Subgroup G))
    (hindex : (normalizer (L : Set G)).relIndex I ≤ 2) :
    Nat.card (centralizingPart Yplus L) ≠ 3 := by
  apply centralizingPart_card_ne_three_of_fstar hcore (H := M ⊓ I)
  · rw [← hθ]
    exact theta_le _
  · rw [← hθ]
    exact (M ⊓ I).le_normalizer.trans (normalizer_le_normalizer_theta _)
  · exact hF
  · exact ComponentIntersection.normalizes_of_index_le_two (le_sup_left.trans hI.1.2)
      (hθ ▸ ComponentIntersection.theta_isPPerfect (M ⊓ I)) hindex

/-- The published RankOneSplit output contains the incompatible order
clause. This obstruction does not assert either other classification branch. -/
theorem not_rankOneSplit_of_local {Yplus S M I L L₀ : Subgroup G}
    [Group.IsPerfect L] (hcore : pCore 2 L ≤ center L)
    (hI : I ∈ outsideFamily Yplus S M)
    (hθ : theta (M ⊓ I) = Yplus)
    (hF : generalizedFitting (M ⊓ I : Subgroup G) = pCore 2 (M ⊓ I : Subgroup G))
    (hindex : (normalizer (L : Set G)).relIndex I ≤ 2) :
    ¬ RankOneSplit Yplus L L₀ := by
  intro h
  exact centralizingPart_card_ne_three_of_local hcore hI hθ hF hindex h.centralizer_card

end CFSG.Quasithin.Chapter15.Section03.Candidates
