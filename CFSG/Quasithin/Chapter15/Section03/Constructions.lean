module

public import CFSG.Quasithin.ChapterA.Section05To06.Ordering
public import CFSG.Quasithin.Chapter4.Defs
public import CFSG.Quasithin.Chapter14.Section01.SourcePreliminaries.Calculations

/-!+# The local constructions in Section 15.3

The section uses `Z = Ω₁(Z(T))` and the special Chapter 14/15 convention
`V(M) = ⟨Z^M⟩`. Its residual subgroup is
`Y = O²(⟨O₂(M ∩ M_c)^M⟩)`, formed inside `M` and embedded back in `G`.
We reuse the actual Appendix A.5 and Chapter 14 constructions for these
objects. In particular, the residual in `Y` and `Y₊` is not a two-core.

Given the two definite planes in the natural four-dimensional module,
`S = N_T(V₁)` and `Z_S = C_V(S)`. The uniqueness argument uses either
`Y₊ = Y`, or the two-residual of `C_Y(V₁)` after uniqueness for `YS` has
been established. `H₊` consists of the genuine nontrivial-two-core
overgroups of `Y₊S` outside `M`.

These definitions fix local notation; they do not encode the standing
Hypothesis 14.1.5, the choice of `M_f`, the orthogonal action, or any
classification conclusion. Those inputs must be supplied by the source
reduction and discharged in the assembly of Theorem 15.3.1.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
manuscript (1 March 2004), pp.1120–1123 and 1141.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter15.Section03

open Subgroup

variable {G : Type*} [Group G]

/-- The source `Z`, embedded from the center of the fixed Sylow group. -/
abbrev centralInvolutions (T : Sylow 2 G) : Subgroup G :=
  ChapterA.Section05To06.centralOmega T

/-- The Chapter 14/15 meaning of `V(M)`. -/
abbrev localModule (T : Sylow 2 G) (M : Subgroup G) : Subgroup G :=
  ChapterA.Section05To06.sourceModule T M

/-- The actual two-residual of the normal closure of the intersection core. -/
noncomputable abbrev residualY (M Mc : Subgroup G) : Subgroup G :=
  Chapter14.SourcePreliminaries.sourceResidual M Mc

/-- The stabilizer `S = N_T(V₁)` of one definite plane. -/
def planeStabilizer (T : Sylow 2 G) (V₁ : Subgroup G) : Subgroup G :=
  (T : Subgroup G) ⊓ normalizer (V₁ : Set G)

/-- The fixed subgroup `Z_S = C_V(S)`. -/
def fixedPlane (V S : Subgroup G) : Subgroup G :=
  V ⊓ centralizer (S : Set G)

/-- The source's subgroup generated by elements of order three. -/
def theta (X : Subgroup G) : Subgroup G :=
  closure {x : G | x ∈ X ∧ orderOf x = 3}

/-- `⟨A^H⟩`, used both for `U_I = ⟨Z^I⟩` and, later, `U_H = ⟨Z_S^H⟩`. -/
abbrev localSpan (A H : Subgroup G) : Subgroup G := conjugateSpanBy A H

/-- Exactly the two choices of Hypothesis 15.3.10, in the standing local setup. -/
def Hypothesis15310 (M Y S V₁ Yplus : Subgroup G) : Prop :=
  Yplus = Y ∨
    (Chapter4.UniqueMaximalOvergroup (Y ⊔ S) M ∧
      Yplus = Stellmacher.twoResidualAmbient (Y ⊓ centralizer (V₁ : Set G)))

/-- The family `H(Y₊S,M)` from p.1123. -/
def outsideFamily (Yplus S M : Subgroup G) : Set (Subgroup G) :=
  Chapter1.HOutside G ((Yplus ⊔ S : Subgroup G) : Set G) (M : Set G)

/-- Its minimal members, ordered by subgroup inclusion. -/
def minimalOutsideFamily (Yplus S M : Subgroup G) : Set (Subgroup G) :=
  {I | Minimal (fun J => J ∈ outsideFamily Yplus S M) I}

end CFSG.Quasithin.Chapter15.Section03
