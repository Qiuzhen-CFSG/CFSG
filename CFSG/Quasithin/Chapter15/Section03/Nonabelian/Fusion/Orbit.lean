module

public import CFSG.Quasithin.Chapter15.Section03.FusionCore.ElementFusion

/-!
# The last four-orbit argument in 15.3.61

The source has four `I`-orbits on `B_i` minus the identity: two inside `V`
and two outside. Both inside orbits generate `V`. An element of `N_G(B_i)`
which moves `V` must therefore move a point of each inside orbit outside.
If the inside representatives are in distinct ambient classes, they must
meet different outside orbits. Thus every nonidentity element of `B_i`
is conjugate to one of the two representatives.

The proof needs the actual conjugation orbits, their generation of `V`,
and a moving normalizer element. It does not infer these facts from the
order of an abstract group or from a family label. Constructing the source
blocks and their four orbits is a separate local calculation.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), p.1151.
-/

@[expose] public section

open Subgroup
open CFSG.Quasithin.Chapter15.Section03.FusionCore

namespace CFSG.Quasithin.Chapter15.Section03.Nonabelian.Fusion
variable {G : Type*} [Group G]

private theorem conjugate_mem_of_normalizes {I V : Subgroup G} {r x : G}
    (hIV : I ≤ normalizer (V : Set G)) (hr : r ∈ V) (h : ConjugateBy I r x) : x ∈ V := by
  obtain ⟨i, hi, rfl⟩ := h
  exact (mem_normalizer_iff.mp (hIV hi) r).mp hr

/-- A conjugator moving the subgroup generated by an orbit moves an orbit point outside. -/
theorem exists_orbit_point_moved_outside [Finite G] (I V : Subgroup G) (r g : G)
    (hspan : closure {x | ConjugateBy I r x} = V)
    (hg : g ∉ normalizer (V : Set G)) :
    ∃ x, ConjugateBy I r x ∧ MulAut.conj g x ∉ V := by
  by_contra! h
  have hle : V.map (MulAut.conj g).toMonoidHom ≤ V := by
    rw [map_le_iff_le_comap]
    calc
      V = closure {x | ConjugateBy I r x} := hspan.symm
      _ ≤ V.comap (MulAut.conj g).toMonoidHom := (closure_le _).mpr h
  have he := eq_of_le_of_card_ge hle (by
    rw [card_map_of_injective (MulAut.conj g).injective])
  exact hg (mem_normalizer_iff_map_conj_eq.mpr he)

/-- The four local orbits collapse to the two distinct ambient classes when
both inside orbits generate `V` and the block normalizer moves `V`. -/
theorem two_class_cover_of_four_orbits [Finite G]
    (I V B : Subgroup G) (z v a b : G)
    (hIV : I ≤ normalizer (V : Set G)) (hVB : V ≤ B)
    (hzV : z ∈ V) (hvV : v ∈ V)
    (hzspan : closure {x | ConjugateBy I z x} = V)
    (hvspan : closure {x | ConjugateBy I v x} = V)
    (hfour : ∀ x ∈ B, x ≠ 1 →
      ConjugateBy I z x ∨ ConjugateBy I v x ∨
        ConjugateBy I a x ∨ ConjugateBy I b x)
    (hmove : ∃ g ∈ normalizer (B : Set G), g ∉ normalizer (V : Set G))
    (hsep : ¬ IsConj z v) :
    ∀ x ∈ B, x ≠ 1 → IsConj x z ∨ IsConj x v := by
  obtain ⟨g, hgB, hgV⟩ := hmove
  have hout (r : G) (hrV : r ∈ V)
      (hspan : closure {x | ConjugateBy I r x} = V) : IsConj r a ∨ IsConj r b := by
    obtain ⟨y, hry, hy⟩ := exists_orbit_point_moved_outside I V r g hspan hgV
    have hyV := conjugate_mem_of_normalizes hIV hrV hry
    have hgyB := (mem_normalizer_iff.mp hgB y).mp (hVB hyV)
    have hgy1 : MulAut.conj g y ≠ 1 := fun he => hy (he ▸ V.one_mem)
    have hrg : IsConj r (MulAut.conj g y) := hry.isConj.trans (isConj_iff.mpr ⟨g, rfl⟩)
    rcases hfour _ hgyB hgy1 with hz | hv | ha | hb
    · exact (hy (conjugate_mem_of_normalizes hIV hzV hz)).elim
    · exact (hy (conjugate_mem_of_normalizes hIV hvV hv)).elim
    · exact Or.inl (hrg.trans ha.isConj.symm)
    · exact Or.inr (hrg.trans hb.isConj.symm)
  have hz := hout z hzV hzspan
  have hv := hout v hvV hvspan
  have hab : (IsConj a z ∨ IsConj a v) ∧ (IsConj b z ∨ IsConj b v) := by
    rcases hz with hza | hzb <;> rcases hv with hva | hvb
    · exact (hsep (hza.trans hva.symm)).elim
    · exact ⟨Or.inl hza.symm, Or.inr hvb.symm⟩
    · exact ⟨Or.inr hva.symm, Or.inl hzb.symm⟩
    · exact (hsep (hzb.trans hvb.symm)).elim
  intro x hx hx1
  rcases hfour x hx hx1 with hz | hv | ha | hb
  · exact Or.inl hz.isConj.symm
  · exact Or.inr hv.isConj.symm
  · exact hab.1.imp (ha.isConj.symm.trans ·) (ha.isConj.symm.trans ·)
  · exact hab.2.imp (hb.isConj.symm.trans ·) (hb.isConj.symm.trans ·)

end CFSG.Quasithin.Chapter15.Section03.Nonabelian.Fusion
