module
public import CFSG.Quasithin.Chapter15.Section03.Nonabelian.Fusion.ResidualOrbits.CubicBlocks.Realization.Summands

/-!
# The literal determinant hyperplane and cubic tensor line

The source orthogonality in V is the polarization of the determinant on
the supplied lower coordinates. Its kernel is transported back through
that very equivalence and the inclusion V → G. The cubic tensor line is
generated by a vector and its image under the complementary rotation.

These definitions do not assert that U meets V in this hyperplane, or
identify a source commutator with the tensor line. Those are separate
geometric assertions, retained explicitly in the source application.

Source: Aschbacher–Smith, 15.3.53(2) and 15.3.61(2), pp.1146 and 1150.
-/

@[expose] public section
open Subgroup Matrix
open CFSG.Quasithin.Chapter15.Section03.Nonabelian.Fusion.Core.Automizers.Models
namespace CFSG.Quasithin.Chapter15.Section03.Nonabelian.Fusion.ResidualOrbits.CubicBlocks.Realization

/-- Polarization of the determinant, with no independently chosen form. -/
def determinantPolar (z v : TensorVector) : ZMod 2 :=
  (z.toAdd + v.toAdd).det - z.toAdd.det - v.toAdd.det

theorem determinantPolar_one (z : TensorVector) : determinantPolar z 1 = 0 := by
  simp [determinantPolar]

theorem determinantPolar_mul (z v w : TensorVector) :
    determinantPolar z (v * w) = determinantPolar z v + determinantPolar z w := by
  change (z.toAdd + (v.toAdd + w.toAdd)).det - z.toAdd.det - (v.toAdd + w.toAdd).det =
    ((z.toAdd + v.toAdd).det - z.toAdd.det - v.toAdd.det) +
      ((z.toAdd + w.toAdd).det - z.toAdd.det - w.toAdd.det)
  simp only [Matrix.det_fin_two, Matrix.add_apply]
  ring

/-- The bilinear functional defining the source hyperplane. -/
def determinantFunctional (z : TensorVector) : TensorVector →* Multiplicative (ZMod 2) where
  toFun v := Multiplicative.ofAdd (determinantPolar z v)
  map_one' := congrArg Multiplicative.ofAdd (determinantPolar_one z)
  map_mul' v w := congrArg Multiplicative.ofAdd (determinantPolar_mul z v w)

/-- The orthogonal hyperplane to a tensor vector. -/
def determinantHyperplane (z : TensorVector) : Subgroup TensorVector :=
  (determinantFunctional z).ker

theorem mem_determinantHyperplane (z v : TensorVector) :
    v ∈ determinantHyperplane z ↔ determinantPolar z v = 0 := Iff.rfl

/-- The line generated by the source singular vector and its cubic image. -/
def tensorCubicLine (j : Fin 2) (z : TensorVector) : Subgroup TensorVector :=
  zpowers z ⊔ zpowers (tensorAction (complementaryRotation j) z)

variable {G : Type*} [Group G] {I Y P V : Subgroup G}
  {hIP : I ≤ normalizer (P : Set G)} {hIV : I ≤ normalizer (V : Set G)}
  [(V.subgroupOf P).Normal]

/-- The actual ambient embedding obtained from the given lower coordinates. -/
noncomputable def tensorEmbedding (d : LayerActions I Y P V hIP hIV) : TensorVector →* G :=
  V.subtype.comp d.lowerCoordinates.symm.toMonoidHom

theorem tensorEmbedding_injective (d : LayerActions I Y P V hIP hIV) :
    Function.Injective (tensorEmbedding d) :=
  Subtype.val_injective.comp d.lowerCoordinates.symm.injective

@[simp] theorem tensorEmbedding_coordinates (d : LayerActions I Y P V hIP hIV) (v : V) :
    tensorEmbedding d (d.lowerCoordinates v) = (v : G) := by
  simp [tensorEmbedding]

/-- The literal orthogonal hyperplane in V, embedded in the ambient group. -/
noncomputable def sourceHyperplane (d : LayerActions I Y P V hIP hIV) (z : V) : Subgroup G :=
  (determinantHyperplane (d.lowerCoordinates z)).map (tensorEmbedding d)

theorem sourceHyperplane_le (d : LayerActions I Y P V hIP hIV) (z : V) :
    sourceHyperplane d z ≤ V := by
  rintro x ⟨v, _, rfl⟩
  exact (d.lowerCoordinates.symm v).property

theorem mem_sourceHyperplane (d : LayerActions I Y P V hIP hIV) (z v : V) :
    (v : G) ∈ sourceHyperplane d z ↔
      determinantPolar (d.lowerCoordinates z) (d.lowerCoordinates v) = 0 := by
  constructor
  · rintro ⟨w, hw, he⟩
    have heV : d.lowerCoordinates.symm w = v := Subtype.ext he
    have hew : w = d.lowerCoordinates v := by
      rw [← heV, d.lowerCoordinates.apply_symm_apply]
    exact hew ▸ hw
  · intro hv
    exact mem_map.mpr ⟨d.lowerCoordinates v, hv, tensorEmbedding_coordinates d v⟩

/-- Convert the literal source intersection equality to its elementwise form. -/
theorem mem_lower_source_iff (d : LayerActions I Y P V hIP hIV)
    (U : Subgroup G) (z : V) (hUV : U ⊓ V = sourceHyperplane d z) (v : V) :
    (v : G) ∈ U ↔ determinantPolar (d.lowerCoordinates z) (d.lowerCoordinates v) = 0 := by
  rw [← mem_sourceHyperplane d z v, ← hUV]
  exact ⟨fun hv => ⟨hv, v.property⟩, fun hv => hv.1⟩

end CFSG.Quasithin.Chapter15.Section03.Nonabelian.Fusion.ResidualOrbits.CubicBlocks.Realization
