module

public import CFSG.Quasithin.Chapter15.Section03.Nonabelian.Fusion.ResidualOrbits.Extraspecial.Coordinates
public import CFSG.Quasithin.Chapter15.Section03.Nonabelian.Fusion.ResidualOrbits.Extraspecial.MarkedGeometry.Transport
public import Theory.SpecificGroups.OrthogonalFourBinary.NaturalAction

/-!
# The marked z and v in the extraspecial natural/dual geometry

The inputs below are earlier source geometry, not the involution orbits in
15.3.61. In particular the two transvection centers in the proof of 15.3.58
bound the two coordinates of (V ∩ U)/Z. The marked line ZS/Z is fixed by t
(15.3.56(7)), so its nonzero vector has both coordinates nonzero. A singular
point in z-perp outside Z cannot have that same quotient, since the local
orthogonal form is constant on Z-cosets in z-perp and v is nonsingular.
It therefore supplies a pure lift. The actual full orthogonal action on V
then supplies an ambient conjugator to z.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), the orthogonal
geometry after 15.3.4 (pp.1121–1122), 15.3.53(2), 15.3.56(1,7), the proof of
15.3.58, 15.3.59(1), and the marking before 15.3.60 (pp.1146–1150).
-/

@[expose] public section
open Subgroup BinaryNaturalDual BinaryNaturalDual.ModelOrbits
open CFSG.Quasithin.Chapter15.Section03.Nonabelian
open CFSG.Quasithin.Chapter15.Section03.Nonabelian.Fusion.Core.ResidualGeneration
namespace CFSG.Quasithin.Chapter15.Section03.Nonabelian.Fusion.ResidualOrbits.Extraspecial

variable {G : Type*} [Group G] {T Z ZS V M V₁ : Subgroup G} {t z v : G}
variable [(Z.subgroupOf (closureU Z ZS)).Normal]

/-- Earlier local geometry sufficient for the two markings. The last coordinate
bound is exactly the inclusion in the span of the two transvection-center
lines from the proof of 15.3.58; it does not label any involution orbit. -/
structure LocalGeometry (d : RecognizedAction T Z ZS V t)
    (M V₁ : Subgroup G) (z v : G) where
  /-- 15.3.2(1): the full natural orthogonal action, with actual conjugation. -/
  orthogonal : OrthogonalFourBinary.NaturalAction V M
  /-- The local Z is generated by the marked involution. -/
  z_order : orderOf z = 2
  z_mark : zpowers z = Z
  z_mem : z ∈ V
  /-- The Sylow-fixed point Z is singular in the earlier orthogonal V. -/
  z_singular : orthogonal.singular ⟨z, z_mem⟩
  /-- The marking before 15.3.60, with the nontrivial generator retained. -/
  v_order : orderOf v = 2
  v_mark : zpowers v = ZS ⊓ V₁
  definite_le : V₁ ≤ V
  /-- V₁ is one of the definite planes, as defined after 15.3.4. -/
  definite : ∀ x : V, (x : G) ∈ V₁ → x ≠ 1 → ¬ orthogonal.singular x
  /-- 15.3.53(2), with the actual orthogonal complement, not an arbitrary tag. -/
  perpendicular : ∀ x : V, (x : G) ∈ closureU Z ZS ↔
    OrthogonalFourBinary.form.polarBilin
      (orthogonal.coordinates ⟨z, z_mem⟩).toAdd (orthogonal.coordinates x).toAdd = 0
  /-- The t-fixation part of 15.3.56(7) on the literal distinguished line. -/
  fixed_line : ∀ x : closureU Z ZS, (x : G) ∈ ZS →
    quotientAction Z ZS ⟨t, d.t_mem_H⟩ (QuotientGroup.mk' _ x) = QuotientGroup.mk' _ x
  /-- Natural transvection center in the proof of 15.3.58. -/
  naturalCenter : BinaryLinearThree.Vector
  naturalCenter_ne : naturalCenter ≠ 0
  /-- Dual transvection center in the proof of 15.3.58. -/
  dualCenter : Module.Dual (ZMod 2) BinaryLinearThree.Vector
  dualCenter_ne : dualCenter ≠ 0
  /-- The proof of 15.3.58 identifies V-tilde intersect U with the span
  of the two center lines; only its containment is required here. -/
  plane : ∀ x : closureU Z ZS, (x : G) ∈ V →
    ((d.coordinates (QuotientGroup.mk' _ x)).toAdd.1 = 0 ∨
      (d.coordinates (QuotientGroup.mk' _ x)).toAdd.1 = naturalCenter) ∧
    ((d.coordinates (QuotientGroup.mk' _ x)).toAdd.2 = 0 ∨
      (d.coordinates (QuotientGroup.mk' _ x)).toAdd.2 = dualCenter)

private theorem involution_ne_one {a : G} (ha : orderOf a = 2) : a ≠ 1 := by
  intro he
  simp [he] at ha

private theorem center_cases (hz : orderOf z = 2) (hZ : zpowers z = Z)
    {x : G} (hx : x ∈ Z) : x = 1 ∨ x = z := by
  classical
  have hc : Nat.card Z = 2 := by rw [← hZ, Nat.card_zpowers, hz]
  have hzZ : z ∈ Z := hZ ▸ mem_zpowers z
  obtain ⟨a, _, hall⟩ := (Nat.card_eq_two_iff' (1 : Z)).mp hc
  by_cases h : x = 1
  · exact Or.inl h
  · have hx1 : (⟨x, hx⟩ : Z) ≠ 1 := fun he => h (congrArg Subtype.val he)
    have hz1 : (⟨z, hzZ⟩ : Z) ≠ 1 :=
      fun he => involution_ne_one hz (congrArg Subtype.val he)
    exact Or.inr (congrArg Subtype.val ((hall _ hx1).trans (hall _ hz1).symm))

private theorem coordinate_ne_zero (d : RecognizedAction T Z ZS V t)
    (x : closureU Z ZS) (hx : (x : G) ∉ Z) :
    (d.coordinates (QuotientGroup.mk' _ x)).toAdd ≠ 0 := by
  intro he
  apply hx
  apply (QuotientGroup.eq_one_iff (N := Z.subgroupOf (closureU Z ZS)) x).mp
  apply d.coordinates.injective
  exact he.trans (map_one d.coordinates).symm

/-- A nonzero vector fixed by the actual summand interchange has two
nonzero components; no orbit theorem is used. -/
theorem fixed_coordinates_nonzero (d : RecognizedAction T Z ZS V t)
    (w : VectorQuotient Z ZS) (hw : w ≠ 1)
    (hfix : quotientAction Z ZS ⟨t, d.t_mem_H⟩ w = w) :
    (d.coordinates w).toAdd.1 ≠ 0 ∧ (d.coordinates w).toAdd.2 ≠ 0 := by
  have hn : (d.coordinates w).toAdd ≠ 0 := by
    intro he
    exact hw (d.coordinates.injective (he.trans (map_one d.coordinates).symm))
  constructor
  · intro h₁
    have he : w = d.coordinates.symm (Multiplicative.ofAdd (0, (d.coordinates w).toAdd.2)) := by
      apply d.coordinates.injective
      rw [d.coordinates.apply_symm_apply]
      exact Prod.ext h₁ rfl
    have hs := d.swaps_dual (d.coordinates w).toAdd.2
    rw [← he, hfix] at hs
    exact hn (Prod.ext h₁ hs)
  · intro h₂
    have he : w = d.coordinates.symm (Multiplicative.ofAdd ((d.coordinates w).toAdd.1, 0)) := by
      apply d.coordinates.injective
      rw [d.coordinates.apply_symm_apply]
      exact Prod.ext rfl h₂
    have hs := d.swaps_natural (d.coordinates w).toAdd.1
    rw [← he, hfix] at hs
    exact hn (Prod.ext hs h₂)

variable (d : RecognizedAction T Z ZS V t) (l : LocalGeometry d M V₁ z v)
include l

private theorem marked_v_memberships : v ∈ ZS ∧ v ∈ V₁ :=
  show v ∈ ZS ⊓ V₁ from l.v_mark ▸ mem_zpowers v

/-- The actual marked v lies in the literal U. -/
theorem marked_v_mem : v ∈ closureU Z ZS :=
  ZS_le_closureU Z ZS (marked_v_memberships d l).1

private theorem marked_v_mem_V : v ∈ V := l.definite_le (marked_v_memberships d l).2

private theorem marked_v_nonsingular :
    ¬ l.orthogonal.singular ⟨v, marked_v_mem_V d l⟩ := by
  apply l.definite _ (marked_v_memberships d l).2
  intro he
  exact involution_ne_one l.v_order (congrArg Subtype.val he)

private theorem marked_v_not_mem_Z : v ∉ Z := by
  intro hv
  rcases center_cases l.z_order l.z_mark hv with he | he
  · exact involution_ne_one l.v_order he
  · apply marked_v_nonsingular d l
    simpa only [he] using l.z_singular

/-- Noncentrality and t-fixation put the marked v off both coordinate axes. -/
theorem marked_v_coordinates_nonzero :
    (d.coordinates (QuotientGroup.mk' _ ⟨v, marked_v_mem d l⟩)).toAdd.1 ≠ 0 ∧
      (d.coordinates (QuotientGroup.mk' _ ⟨v, marked_v_mem d l⟩)).toAdd.2 ≠ 0 := by
  let x : closureU Z ZS := ⟨v, marked_v_mem d l⟩
  have hn : QuotientGroup.mk' (Z.subgroupOf (closureU Z ZS)) x ≠ 1 :=
    fun he => marked_v_not_mem_Z d l ((QuotientGroup.eq_one_iff x).mp he)
  exact fixed_coordinates_nonzero d _ hn (l.fixed_line x (marked_v_memberships d l).1)

/-- The marking ZS ∩ V₁=⟨v⟩, its definiteness in V, and t-fixation give
both nonzero coordinates and, by the square calculation, zero pairing. -/
theorem marked_v_mixed (s : SquareForm d z)
    (hnatural : ∀ x ∈ naturalPreimage d, x ^ 2 = 1) :
    IsSingularDiagonal (d.coordinates (QuotientGroup.mk' _ ⟨v, marked_v_mem d l⟩)).toAdd := by
  have hh := marked_v_coordinates_nonzero d l
  refine ⟨hh.1, hh.2, ?_⟩
  exact (square_eq_one_iff_quadratic_zero d s l.z_order
    (l.z_mark ▸ mem_zpowers z) hnatural ⟨v, marked_v_mem d l⟩).mp
      (l.v_order ▸ pow_orderOf_eq_one v)

omit l in
set_option synthInstance.maxSize 512 in
private theorem exists_perpendicular_singular (a : OrthogonalFourBinary.Space)
    (ha : a ≠ 0) (hq : OrthogonalFourBinary.form a = 0) :
    ∃ b : OrthogonalFourBinary.Space, b ≠ 0 ∧ b ≠ a ∧
      OrthogonalFourBinary.form b = 0 ∧ OrthogonalFourBinary.form.polarBilin a b = 0 := by
  have h : ∀ a : OrthogonalFourBinary.Space, a ≠ 0 → OrthogonalFourBinary.form a = 0 →
      ∃ b : OrthogonalFourBinary.Space, b ≠ 0 ∧ b ≠ a ∧
        OrthogonalFourBinary.form b = 0 ∧
          OrthogonalFourBinary.form (a + b) - OrthogonalFourBinary.form a -
            OrthogonalFourBinary.form b = 0 := by
    decide +kernel
  simpa only [QuadraticMap.polarBilin_apply_apply, QuadraticMap.polar] using h a ha hq

/-- A singular point of z-perp outside Z exists in the actual local V. -/
theorem exists_local_singular_lift : ∃ x : closureU Z ZS,
    ∃ hxV : (x : G) ∈ V, (x : G) ∉ Z ∧ l.orthogonal.singular ⟨x, hxV⟩ := by
  let zz : V := ⟨z, l.z_mem⟩
  have hz : (l.orthogonal.coordinates zz).toAdd ≠ 0 := by
    intro he
    apply involution_ne_one l.z_order
    exact congrArg Subtype.val (l.orthogonal.coordinates.injective
      (he.trans (map_one l.orthogonal.coordinates).symm))
  obtain ⟨b, hb, hbz, hbs, hbp⟩ := exists_perpendicular_singular _ hz l.z_singular
  let x : V := l.orthogonal.coordinates.symm (Multiplicative.ofAdd b)
  have hc : (l.orthogonal.coordinates x).toAdd = b := by
    simp only [x, l.orthogonal.coordinates.apply_symm_apply, toAdd_ofAdd]
  have hxU : (x : G) ∈ closureU Z ZS := (l.perpendicular x).mpr (by rwa [hc])
  refine ⟨⟨x, hxU⟩, x.property, ?_, ?_⟩
  · intro hx
    rcases center_cases l.z_order l.z_mark hx with he | he
    · apply hb
      have hh : x = 1 := Subtype.ext he
      rw [← hc, hh, map_one]
      rfl
    · apply hbz
      have hh : x = zz := Subtype.ext he
      rw [← hc, hh]
  · change OrthogonalFourBinary.form (l.orthogonal.coordinates x).toAdd = 0
    rwa [hc]

private theorem singular_not_v_coset (x : closureU Z ZS) (hxV : (x : G) ∈ V)
    (hxs : l.orthogonal.singular ⟨x, hxV⟩) :
    QuotientGroup.mk' (Z.subgroupOf (closureU Z ZS)) x ≠
      QuotientGroup.mk' _ ⟨v, marked_v_mem d l⟩ := by
  intro he
  have hm : x⁻¹ * (⟨v, marked_v_mem d l⟩ : closureU Z ZS) ∈
      Z.subgroupOf (closureU Z ZS) := QuotientGroup.eq.mp he
  apply marked_v_nonsingular d l
  rcases center_cases l.z_order l.z_mark hm with hh | hh
  · have he : v = (x : G) := by
      simpa using (eq_inv_mul_iff_mul_eq.mp hh.symm).symm
    simpa only [he] using hxs
  · have he : v = (x : G) * z := (eq_inv_mul_iff_mul_eq.mp hh.symm).symm
    have hv : (⟨v, marked_v_mem_V d l⟩ : V) = ⟨x, hxV⟩ * ⟨z, l.z_mem⟩ := Subtype.ext he
    change OrthogonalFourBinary.form (l.orthogonal.coordinates ⟨v, marked_v_mem_V d l⟩).toAdd = 0
    rw [hv, map_mul, toAdd_mul, QuadraticMap.map_add OrthogonalFourBinary.form]
    have hp := (l.perpendicular ⟨x, hxV⟩).mp x.property
    rw [QuadraticMap.polarBilin_apply_apply, QuadraticMap.polar_comm] at hp
    rw [show OrthogonalFourBinary.form (l.orthogonal.coordinates ⟨x, hxV⟩).toAdd = 0 from hxs,
      show OrthogonalFourBinary.form (l.orthogonal.coordinates ⟨z, l.z_mem⟩).toAdd = 0 from l.z_singular,
      hp, add_zero, add_zero]

/-- A local singular lift is pure because the only mixed point of the
transvection-center plane is the marked v-coset, which is locally nonsingular. -/
theorem local_singular_lift_pure
    (x : closureU Z ZS) (hxV : (x : G) ∈ V) (hxZ : (x : G) ∉ Z)
    (hxs : l.orthogonal.singular ⟨x, hxV⟩) :
    IsPure (d.coordinates (QuotientGroup.mk' _ x)).toAdd := by
  have hn := coordinate_ne_zero d x hxZ
  by_cases h₁ : (d.coordinates (QuotientGroup.mk' _ x)).toAdd.1 = 0
  · exact Or.inr ⟨h₁, fun h₂ => hn (Prod.ext h₁ h₂)⟩
  by_cases h₂ : (d.coordinates (QuotientGroup.mk' _ x)).toAdd.2 = 0
  · exact Or.inl ⟨h₁, h₂⟩
  have hp := l.plane x hxV
  have hv := marked_v_coordinates_nonzero d l
  have hvc := l.plane ⟨v, marked_v_mem d l⟩ (marked_v_mem_V d l)
  exfalso
  apply singular_not_v_coset d l x hxV hxs
  apply d.coordinates.injective
  exact Prod.ext ((hp.1.resolve_left h₁).trans (hvc.1.resolve_left hv.1).symm)
    ((hp.2.resolve_left h₂).trans (hvc.2.resolve_left hv.2).symm)

/-- The pure seed has an actual conjugator in M, obtained from the earlier
orthogonal action on V, rather than an assumed involution orbit in U. -/
theorem exists_pure_seed_conjugator :
    ∃ x : closureU Z ZS, IsPure (d.coordinates (QuotientGroup.mk' _ x)).toAdd ∧
      ∃ m ∈ M, MulAut.conj m (x : G) = z := by
  obtain ⟨x, hxV, hxZ, hxs⟩ := exists_local_singular_lift d l
  have hx1 : (⟨x, hxV⟩ : V) ≠ 1 := by
    intro he
    exact hxZ (show (x : G) ∈ Z from (congrArg Subtype.val he).symm ▸ Z.one_mem)
  have hz1 : (⟨z, l.z_mem⟩ : V) ≠ 1 :=
    fun he => involution_ne_one l.z_order (congrArg Subtype.val he)
  exact ⟨x, local_singular_lift_pure d l x hxV hxZ hxs,
    l.orthogonal.exists_conjugator_of_singular _ _ hx1 hz1 hxs l.z_singular⟩

/-- Construct the square and marking contract from precisely the earlier
power-map, total-singularity and local orthogonal inputs. -/
theorem markedGeometry_of_earlier_geometry (s : SquareForm d z)
    (hnatural : ∀ x ∈ naturalPreimage d, x ^ 2 = 1) : Nonempty (MarkedGeometry d z v) := by
  obtain ⟨x, hx, m, _, hm⟩ := exists_pure_seed_conjugator d l
  exact ⟨{
    square_zero := square_eq_one_iff_quadratic_zero d s l.z_order
      (l.z_mark ▸ mem_zpowers z) hnatural
    pureSeed := x
    pureSeed_pure := hx
    pureSeed_fusion := isConj_iff.mpr ⟨m, hm⟩
    v_mem := marked_v_mem d l
    v_mixed := marked_v_mixed d l s hnatural }⟩

/-- The full earlier extraspecial branch retained for source assembly.
The elementary subgroup of order 16 records plus type for the order-128
extraspecial group. The actor equivalence, natural/dual recognition, and the
specific summand interchange are carried by d; the residual equivalence
below is on the actual O²(H)/U. No involution-orbit conclusion is a field. -/
structure EarlierGeometry (d : RecognizedAction T Z ZS V t)
    (M V₁ : Subgroup G) (z v : G)
    [((closureU Z ZS).subgroupOf (residualK Z)).Normal] where
  /-- 15.3.55. -/
  extraspecial : IsExtraspecial 2 (closureU Z ZS)
  /-- 15.3.58(2). -/
  order128 : Nat.card (closureU Z ZS) = 128
  /-- Plus type in 15.3.58(2): a maximal elementary subgroup of order 16. -/
  plus_type : ∃ A : Subgroup (closureU Z ZS), IsElementaryAbelian 2 A ∧ Nat.card A = 16
  /-- The actual center, from 15.3.55. -/
  center_eq : Z.subgroupOf (closureU Z ZS) = center (closureU Z ZS)
  /-- The source containment identifying the denominator with Z. -/
  Z_le_ZS : Z ≤ ZS
  /-- The defining local containment U ≤ H. -/
  ZS_le_H : ZS ≤ centralizerH Z
  /-- 15.3.59(1), with O₂ formed inside H. -/
  core_eq : closureU Z ZS = coreQ Z
  /-- The actual residual quotient from 15.3.58–59. -/
  residualEquiv : (residualK Z ⧸ (closureU Z ZS).subgroupOf (residualK Z)) ≃*
    Matrix.PSL3Two.SL
  /-- The supplied source involution, not a freely chosen swapping map. -/
  t_involution : orderOf t = 2
  /-- 15.3.56(1), constructed from an intrinsic space by
  `SquareForm.of_orthogonalSpace` when necessary. -/
  squareForm : SquareForm d z
  /-- Total singularity established in the proof of 15.3.58, stated on
  actual lifts in the natural-summand preimage. -/
  natural_totally_singular : ∀ x ∈ naturalPreimage d, x ^ 2 = 1
  /-- The earlier V-geometry and the two actual generator markings. -/
  localGeometry : LocalGeometry d M V₁ z v

omit l in
/-- The requested construction in the full source setting. The parent may
use this witness in `noncentral_involution_orbit_iff` and
`inside_cover_of_markedGeometry`; this theorem assumes no part of 15.3.61. -/
theorem nonempty_markedGeometry
    [((closureU Z ZS).subgroupOf (residualK Z)).Normal]
    (h : EarlierGeometry d M V₁ z v) : Nonempty (MarkedGeometry d z v) :=
  markedGeometry_of_earlier_geometry d h.localGeometry h.squareForm h.natural_totally_singular

end CFSG.Quasithin.Chapter15.Section03.Nonabelian.Fusion.ResidualOrbits.Extraspecial
