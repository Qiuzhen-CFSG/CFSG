module

public import CFSG.Quasithin.Chapter15.Section03.Nonabelian.Recognition.Action
public import CFSG.Quasithin.Chapter15.Section03.Nonabelian.Recognition.Degree
public import Theory.Representation.BinaryOffender.SubspaceAction
public import Theory.Representation.NormalConstituentDisplacement
public import Mathlib.RepresentationTheory.Invariants
public import Mathlib.LinearAlgebra.QuadraticForm.Basic

/-!
# Source data for the irreducible branch of 15.3.58

The actor `X` is the original elementary subgroup, the involution `v` generates
`V*`, and `T` is an actual Sylow subgroup of the faithful acting group. The
three prime-to-three conditions concern the setwise stabilizer of the
literal displacement plane, the pointwise fixer of the literal Sylow fixed
space, and the centralizer of the cyclic subgroup generated by `v`.

These are earlier source inputs, not model exclusions. `ComponentData`
records the minimal normal component join supplied by the normal reduction;
it deliberately does not assume quasiequivalence of its two restrictions.
The application of G.9.3 must construct that additional hypothesis.

All definitions are representation-theoretic so concrete model computations
can use them. The assembly specializes the representation to
`Recognition.actorRepresentation`, on the literal `U/Z`.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), 15.3.53(2),
15.3.56, and the proof of 15.3.58, printed pp.1146–1149; G.9.1 and G.9.3,
printed pp.351–357.
-/

@[expose] public noncomputable section

namespace CFSG.Quasithin.Chapter15.Section03.Nonabelian.Recognition.IrreducibleSieve

open Subgroup Representation
open Representation.BinaryOffender

variable {H W : Type*} [Group H] [AddCommGroup W] [Module (ZMod 2) W]

/-- The actual moved space of the marked involution. -/
abbrev displacement (ρ : Representation (ZMod 2) H W) (v : H) :=
  LinearMap.range (ρ v - LinearMap.id)

/-- The source fixed line, defined as the whole fixed space of the given Sylow
subgroup rather than an arbitrary invariant line. -/
abbrev sylowFixedSpace (ρ : Representation (ZMod 2) H W) (T : Sylow 2 H) :=
  Representation.invariants (ρ.comp (T : Subgroup H).subtype)

/-- The literal pointwise centralizer of a subspace in the faithful actor. -/
abbrev pointwiseCentralizer (ρ : Representation (ZMod 2) H W)
    (D : Submodule (ZMod 2) W) := subspaceKernel ρ D ⊤

/-- Exactly the local action and geometric restrictions used on p.1149.
Nondegeneracy is imposed on the polar form, appropriate for the even-dimensional
binary orthogonal space; no division by two or associated form is used. -/
structure SourceData [Finite H] [FiniteDimensional (ZMod 2) W]
    (ρ : Representation (ZMod 2) H W) (X : Subgroup H)
    (T : Sylow 2 H) (v : H) (s : ℕ) : Prop where
  faithful : Function.Injective ρ
  positive : 0 < s
  dimension : Module.finrank (ZMod 2) W = 2 * (s + 2)
  elementary : IsElementaryAbelian 2 X
  card_actor : Nat.card X = 2 ^ (s + 1)
  actor_le_sylow : X ≤ (T : Subgroup H)
  involution : orderOf v = 2
  marked_mem : v ∈ X
  marked_central : v ∈ (Subgroup.center (T : Subgroup H)).map (T : Subgroup H).subtype
  displacement_rank : Module.finrank (ZMod 2) (displacement ρ v) = 2
  quadratic : ∃ q : QuadraticForm (ZMod 2) W,
    q.polarBilin.Nondegenerate ∧ ∀ g w, q (ρ g w) = q w
  fixed_dimension : Module.finrank (ZMod 2) (sylowFixedSpace ρ T) = 1
  plane_three_free : Nat.Coprime 3
    (Nat.card (subspaceStabilizer ρ (displacement ρ v)))
  line_three_free : Nat.Coprime 3
    (Nat.card (pointwiseCentralizer ρ (sylowFixedSpace ρ T)))
  centralizer_three_free : Nat.Coprime 3
    (Nat.card (Subgroup.centralizer (Subgroup.zpowers v : Set H)))

/-- The nonsolvable minimal normal subgroup and its one or two actual simple
components. The group isomorphism of the two components is not a substitute
for the representation comparison required by G.9.3. -/
structure ComponentData (ρ : Representation (ZMod 2) H W) (K : Subgroup H) : Prop where
  normal : K.Normal
  nonsolvable : ¬ Group.IsSolvable K
  minimal : ∀ J : Subgroup H, J.Normal → J ≤ K → J = ⊥ ∨ J = K
  irreducible : Representation.IsIrreducible (ρ.comp K.subtype)
  factors : ∃ L : Subgroup H, Theory.GroupTheory.IsComponent H L ∧
    IsSimpleGroup L ∧ ¬ IsMulCommutative L ∧
      (K = L ∨ ∃ L₂ : Subgroup H,
        Theory.GroupTheory.IsComponent H L₂ ∧ IsSimpleGroup L₂ ∧
        ¬ IsMulCommutative L₂ ∧ L ≠ L₂ ∧ Nonempty (L ≃* L₂) ∧ K = L ⊔ L₂)

end CFSG.Quasithin.Chapter15.Section03.Nonabelian.Recognition.IrreducibleSieve
