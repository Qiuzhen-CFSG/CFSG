module

public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GoldschmidtCore.ThompsonExtension.OmegaModule


/-!
# Applying the earlier source theorems to the terminal extension

Use F.6.11(1) to choose the normal Sylow two-subgroup of the three-prime
core and obtain its solvability. Its extension by `J(U)` is solvable and
has characteristic two. The full B.2.16 statement supplies a two-reduced
omega-center module centralized by `J(U)`, since the other alternative
would have an actual `L₂(2)` section and a divisor three of the group order.

Sylow conjugacy makes this module characteristic. The conjugates of `Z`
under `Y_F` therefore lie in it. Its centralizer lies in `C_H(F)` and is
three-prime, hence a two-group by the local prime support. Normality and
Thompson heredity give `J(U)` normal in the extension, establishing the
factorization through the full `R₂`. The already proved CoreReduction
endpoints restrict the product to `P` and give `P = Q`.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
15.3.68, printed pp.1154–1155, F.6.11(1), p.306, and B.2.16, p.79.
-/

public section

open Subgroup Stellmacher
open scoped Pointwise
namespace CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GoldschmidtCore.ThompsonExtension
open Chapter1.RadicalNormalizers.ThompsonSource
universe u
variable {H : Type u} [Group H] [Finite H]

/-- The subgroup generated by the source right conjugates `Zʸ = y⁻¹Zy`
under `Y_F`. -/
@[expose] def conjugateSpan (Y Z : Subgroup H) : Subgroup H :=
  ⨆ y : Y, Z.map (MulAut.conj (y : H)⁻¹).toMonoidHom

/-- Invariance of the source omega-center module contains the entire conjugate span. -/
theorem span_le_module (U : Sylow 2 H) (Y Z : Subgroup H)
    (hY : Y ≤ normalizer (elementaryAbelianMaxJ (U : Subgroup H) : Set H))
    (hZ : Z ≤ omegaOneCenterAmbient (U : Subgroup H))
    (S : Sylow 2 (extension U))
    (hS : (S : Subgroup (extension U)).map (extension U).subtype = sylowImage U) :
    conjugateSpan Y Z ≤ (Chapter1.RadicalNormalizers.ThompsonSource.closure S).map (extension U).subtype := by
  let X := extension U
  let W := (Chapter1.RadicalNormalizers.ThompsonSource.closure S).map X.subtype
  let : (Chapter1.RadicalNormalizers.ThompsonSource.closure S).Characteristic := closure_characteristic S
  have hYW : Y ≤ normalizer (W : Set H) :=
    (normalizes_extension U Y hY).trans
      (normalizer_le_normalizer_characteristic_image X (Chapter1.RadicalNormalizers.ThompsonSource.closure S))
  have hZW : Z ≤ W := by
    apply (hZ.trans (omegaCenter_le_sylowImage U)).trans
    rw [← hS, omegaOneCenterAmbient_map_injective X.subtype X.subtype_injective]
    exact map_mono (show omegaOneCenterAmbient (S : Subgroup X) ≤ Chapter1.RadicalNormalizers.ThompsonSource.closure S from
      subset_normalClosure)
  apply iSup_le
  intro y
  exact (map_mono hZW).trans_eq
    (mem_normalizer_iff_map_conj_eq.mp (hYW (Y.inv_mem y.property)))

/-- The local prime supports make the module centralizer a two-group. -/
theorem centralizer_module_two (X F : Subgroup H) (W : Subgroup X)
    (hFW : F ≤ W.map X.subtype) (hX3 : Nat.Coprime 3 (Nat.card X))
    (hCF : ∀ p : ℕ, p.Prime → p ∣ Nat.card (centralizer (F : Set H)) →
      p = 2 ∨ p = 3) : IsPGroup 2 (centralizer (W : Set X)) := by
  let C := centralizer (W : Set X)
  have hC : C.map X.subtype ≤ centralizer (F : Set H) :=
    (map_centralizer_le_centralizer_image _ X.subtype).trans (centralizer_le hFW)
  have hcard : Nat.card C ∣ Nat.card (centralizer (F : Set H)) := by
    rw [← card_map_of_injective (f := X.subtype) X.subtype_injective]
    exact card_dvd_of_le hC
  apply IsPGroup.of_card
  apply Nat.eq_prime_pow_of_unique_prime_dvd Nat.card_pos.ne'
  intro p hp hd
  rcases hCF p hp (hd.trans hcard) with h2 | h3
  · exact h2
  · subst p
    exact ((Nat.prime_three.coprime_iff_not_dvd.mp hX3)
      (hd.trans C.card_subgroup_dvd_card)).elim

/-- Transport of Thompson heredity for the chosen intrinsic Sylow witness. -/
theorem thompson_sylow_map (U : Sylow 2 H) (S : Sylow 2 (extension U))
    (hS : (S : Subgroup (extension U)).map (extension U).subtype = sylowImage U) :
    (elementaryAbelianMaxJ (S : Subgroup (extension U))).map (extension U).subtype =
      elementaryAbelianMaxJ (U : Subgroup H) := by
  rw [← elementaryAbelianMaxJ_map_injective (extension U).subtype
    (extension U).subtype_injective, hS, thompson_sylowImage]

/-- The literal factorization through the genuine reduced core, obtained
from B.2.16 and the local hypotheses without an assumed core equality. -/
theorem extension_factorization (hB : TheoremB216.{u})
    (U : Sylow 2 H) (V R Y Z F : Subgroup H)
    (hV : V ≤ pCore 2 H) (hC : centralizer (V : Set H) ≤ R) (hR : IsPGroup 2 R)
    (hY : Y ≤ normalizer (elementaryAbelianMaxJ (U : Subgroup H) : Set H))
    (hZ : Z ≤ omegaOneCenterAmbient (U : Subgroup H)) (hF : F = conjugateSpan Y Z)
    (hCF : ∀ p : ℕ, p.Prime → p ∣ Nat.card (centralizer (F : Set H)) →
      p = 2 ∨ p = 3)
    (hQ : IsSylowSubgroupIn (pCore 2 H) (pPrimeCore 3 H))
    (hsol : Group.IsSolvable (pPrimeCore 3 H)) :
    F ≤ (reducedCore (extension U)).map (extension U).subtype ∧
      extension U ≤ normalizer (elementaryAbelianMaxJ (U : Subgroup H) : Set H) ∧
      (extension U : Set H) =
        (extension U ⊓ centralizer
          ((reducedCore (extension U)).map (extension U).subtype : Set H) : Set H) *
        (extension U ⊓ normalizer (elementaryAbelianMaxJ (U : Subgroup H) : Set H) : Set H) := by
  let X := extension U
  have hJ : IsPGroup 2 (elementaryAbelianMaxJ (U : Subgroup H)) :=
    U.isPGroup'.to_le (sSup_le fun _ hA => hA.1)
  have hX3 : Nat.Coprime 3 (Nat.card X) := threePrime_extension_coprime _ hJ
  have hsyl : IsSylowSubgroupIn (sylowImage U) X :=
    threePrime_extension_sylow _ hJ hQ
  obtain ⟨S, hS⟩ := hsyl
  have hQX : pCore 2 H ≤ X :=
    (by
      obtain ⟨T, hT⟩ := hQ
      rw [← hT]
      exact (map_subtype_le _).trans le_sup_right)
  have hfit := overgroup_generalizedFitting X hQX (core_selfCentralizing V R hV hC hR)
  have hb := hB X (extension_solvable U hsol) hfit S
  have hFW : F ≤ (Chapter1.RadicalNormalizers.ThompsonSource.closure S).map X.subtype := by
    rw [hF]
    exact span_le_module U Y Z hY hZ S hS
  have hFZ : F ≤ (reducedCore X).map X.subtype :=
    hFW.trans (map_mono (show Chapter1.RadicalNormalizers.ThompsonSource.closure S ≤ reducedCore X from le_sSup hb.isR2))
  have hJC := centralizes_closure_of_three_coprime hb hX3
  let : (elementaryAbelianMaxJ (S : Subgroup X)).Normal :=
    thompson_normal_of_centralizer_two hJC
      (centralizer_module_two X F (Chapter1.RadicalNormalizers.ThompsonSource.closure S) hFW hX3 hCF)
  have hXN : X ≤ normalizer (elementaryAbelianMaxJ (U : Subgroup H) : Set H) := by
    rw [← thompson_sylow_map U S hS]
    exact normalizes_image X _
  exact ⟨hFZ, hXN, product_of_normalizes _ _ _ hXN⟩

/-- Sylow maximality identifies `QJ(U)` with the source subgroup `U ∩ X`. -/
theorem sylowImage_eq_inf (U : Sylow 2 H)
    (hQ : IsSylowSubgroupIn (pCore 2 H) (pPrimeCore 3 H)) :
    sylowImage U = (U : Subgroup H) ⊓ extension U := by
  have hJ : IsPGroup 2 (elementaryAbelianMaxJ (U : Subgroup H)) :=
    U.isPGroup'.to_le (sSup_le fun _ hA => hA.1)
  have hsyl : IsSylowSubgroupIn (sylowImage U) (extension U) :=
    threePrime_extension_sylow _ hJ hQ
  obtain ⟨S, hS⟩ := hsyl
  have hSU : (S : Subgroup (extension U)) ≤ (U : Subgroup H).subgroupOf (extension U) := by
    intro s hs
    exact sylowImage_le U (hS ▸ mem_map_of_mem (extension U).subtype hs)
  have he := S.is_maximal' U.isPGroup'.comap_subtype hSU
  apply le_antisymm
  · exact le_inf (sylowImage_le U) (hS ▸ map_subtype_le _)
  · intro x hx
    rw [← hS]
    exact mem_map.mpr ⟨⟨x, hx.2⟩, he ▸ hx.1, rfl⟩

/-- All extension premises and both terminal products, before the parent
assembles the five clauses of 15.3.68. -/
structure ExtensionResult (U : Sylow 2 H) (Y F : Subgroup H) : Prop where
  oddCore : pPrimeCore 2 (pPrimeCore 3 H) = ⊥
  fittingP : (Theory.GroupTheory.generalizedFitting (pPrimeCore 3 H)).map
    (pPrimeCore 3 H).subtype = pCore 2 H
  fittingX : Theory.GroupTheory.generalizedFitting (extension U) = pCore 2 (extension U)
  sylow : IsSylowSubgroupIn (sylowImage U) (extension U)
  sylow_eq : sylowImage U = (U : Subgroup H) ⊓ extension U
  thompson_eq : elementaryAbelianMaxJ (sylowImage U) = elementaryAbelianMaxJ (U : Subgroup H)
  Y_normalizes : Y ≤ normalizer (extension U : Set H)
  F_le : F ≤ (reducedCore (extension U)).map (extension U).subtype
  reduced_normal : extension U ≤ normalizer
    ((reducedCore (extension U)).map (extension U).subtype : Set H)
  thompson_normal : extension U ≤ normalizer (elementaryAbelianMaxJ (U : Subgroup H) : Set H)
  productX : (extension U : Set H) =
    (extension U ⊓ centralizer
      ((reducedCore (extension U)).map (extension U).subtype : Set H) : Set H) *
    (extension U ⊓ normalizer (elementaryAbelianMaxJ (U : Subgroup H) : Set H) : Set H)
  productP : (pPrimeCore 3 H : Set H) =
    (pPrimeCore 3 H ⊓ centralizer (F : Set H) : Set H) *
    (pPrimeCore 3 H ⊓ normalizer (elementaryAbelianMaxJ (U : Subgroup H) : Set H) : Set H)
  core_eq : pPrimeCore 3 H = pCore 2 H

/-- The conditional application of precisely F.6.11(1) and B.2.16.
The former supplies only its normal Sylow and solvability conclusions;
the latter is the complete existing source statement. Neither witness
assumes factorization of this extension or equality of its two cores.
All groups and normalities are inside `H = G₀`.

The source's `V ≤ Z(Q)` is more than the needed containment `V ≤ Q`.
Likewise nontriviality of `Z` is unnecessary because B.2.16 already
supplies two-reduction of the closure of the full Sylow omega-center. -/
theorem apply_F611_B216
    (hF611 : ∀ A B : Subgroup H, ChapterF.IsGoldschmidtTriple A B →
      IsSylowSubgroupIn (pCore 2 H) (pPrimeCore 3 H) ∧ Group.IsSolvable (pPrimeCore 3 H))
    (hB216 : TheoremB216.{u})
    (A B : Subgroup H) (hGold : ChapterF.IsGoldschmidtTriple A B)
    (U : Sylow 2 H) (V R Y Z F M : Subgroup H)
    (hV : V ≤ pCore 2 H) (hC : centralizer (V : Set H) ≤ R) (hR : IsPGroup 2 R)
    (hY : Y ≤ normalizer (elementaryAbelianMaxJ (U : Subgroup H) : Set H))
    (hZ : Z ≤ omegaOneCenterAmbient (U : Subgroup H)) (hF : F = conjugateSpan Y Z)
    (hJF : elementaryAbelianMaxJ (U : Subgroup H) ≤ centralizer (F : Set H))
    (hCF : ∀ p : ℕ, p.Prime → p ∣ Nat.card (centralizer (F : Set H)) → p = 2 ∨ p = 3)
    (hM : ∀ p : ℕ, p.Prime → p ∣ Nat.card M → p = 2 ∨ p = 3)
    (hJM : normalizer (elementaryAbelianMaxJ (U : Subgroup H) : Set H) ≤ M) :
    ExtensionResult U Y F := by
  obtain ⟨hQ, hsol⟩ := hF611 A B hGold
  have hQP : pCore 2 H ≤ pPrimeCore 3 H := by
    obtain ⟨T, hT⟩ := hQ
    rw [← hT]
    exact map_subtype_le _
  have hJ : IsPGroup 2 (elementaryAbelianMaxJ (U : Subgroup H)) :=
    U.isPGroup'.to_le (sSup_le fun _ hA => hA.1)
  have hchar := core_selfCentralizing V R hV hC hR
  obtain ⟨hFZ, hJN, hfactor⟩ := extension_factorization hB216 U V R Y Z F
    hV hC hR hY hZ hF hCF hQ hsol
  have hR2 := normalizes_image (extension U) (reducedCore (extension U))
  have hSylow : IsSylowSubgroupIn (sylowImage U) (extension U) :=
    threePrime_extension_sylow _ hJ hQ
  refine ⟨oddCore_threePrimeCore_eq_bot V R hV hC hR, ?_,
    overgroup_generalizedFitting _ (hQP.trans le_sup_right) hchar,
    hSylow, sylowImage_eq_inf U hQ, thompson_sylowImage U,
    normalizes_extension U Y hY, hFZ, hR2, hJN, hfactor, ?_, ?_⟩
  · rw [overgroup_generalizedFitting _ hQP hchar]
    exact twoCore_threePrimeCore
  · exact normal_subgroup_factorization_from_extension (pPrimeCore 3 H) (pCore 2 H)
      (elementaryAbelianMaxJ (U : Subgroup H)) F _ hQP hJF hFZ hR2
      (threePrime_extension_coprime _ hJ) hCF hSylow hfactor
  · exact threePrimeCore_eq_twoCore_from_extension_factorization
      (elementaryAbelianMaxJ (U : Subgroup H)) F _ M hJ hJF hFZ hR2 hCF hM hJM hQ hfactor

end CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GoldschmidtCore.ThompsonExtension
