module

public import Theory.SpecificGroups.PSL3Two.Parabolics.CompatibleMarking
public import Theory.Representation.PSL3Two.IrreducibleCatalogue.Irreducibility

/-!
# Reconstructing the natural module from the actual marked four-group

A faithful binary action generated by the orbit of a point fixed by the point
parabolic has seven distinct orbit vectors. The line parabolic preserves the
specified four-element subspace, so its three orbit vectors sum to zero.
Transporting this relation along ordered pairs gives every Fano line relation.
The orbit map extended by zero is therefore additive and equivariant. Generation
gives surjectivity, and natural-module irreducibility gives injectivity.

This is the independent geometric step in the repair of Aschbacher–Smith
15.3.68(2), combined manuscript of 1 March 2004, printed pp.1152–1155.
An actual quotient identification and compatible parabolic marking are explicit
inputs; the F.6.18/B.5.6 recognition and the ambient module construction are not
asserted here. No dimension or irreducibility of the target is assumed.
-/

public section

open Matrix Representation BinaryLinearThree Matrix.PSL3Two
namespace CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GoldschmidtCore.Centrality.Semilinear.Recognition

private def secondPoint : Point := ⟨![0,1,0], by decide⟩
private def thirdPoint : Point := ⟨![1,1,0], by decide⟩

set_option maxRecDepth 100000 in
set_option maxHeartbeats 16000000 in
private theorem point_stabilizer : ∀ g : BinaryLinearThree.Group,
    pointPerm g flagPoint = flagPoint ↔ g ∈ pointParabolicSL := by
  simp only [mem_pointParabolicSL_iff]
  change ∀ g : BinaryLinearThree.Group, (⟨g.val *ᵥ flagPoint.val, _⟩ : Point) = flagPoint ↔ _
  decide +kernel

set_option maxRecDepth 100000 in
set_option maxHeartbeats 16000000 in
private theorem ordered_pair_reachable : ∀ p q : Point, p ≠ q →
    ∃ g : BinaryLinearThree.Group, pointPerm g flagPoint = p ∧ pointPerm g secondPoint = q := by
  decide +kernel

private theorem point_reachable (p : Point) :
    ∃ g : BinaryLinearThree.Group, pointPerm g flagPoint = p := by
  have : ∃ q : Point, p ≠ q := by
    by_cases h : p = flagPoint
    · exact ⟨secondPoint, by rw [h]; decide⟩
    · exact ⟨flagPoint, h⟩
  obtain ⟨q,hq⟩ := this
  obtain ⟨g,hg,_⟩ := ordered_pair_reachable p q hq
  exact ⟨g,hg⟩

private noncomputable def pointLift (p : Point) : BinaryLinearThree.Group :=
  Classical.choose (point_reachable p)
private theorem pointLift_spec (p : Point) : pointPerm (pointLift p) flagPoint = p :=
  Classical.choose_spec (point_reachable p)

variable {A : Type*} [AddCommGroup A] [Module (ZMod 2) A]

private theorem twice (a : A) : a + a = 0 := by
  have h : (1 + 1 : ZMod 2) = 0 := by decide
  simpa only [add_smul, one_smul, zero_smul] using congrArg (fun c : ZMod 2 => c • a) h

private noncomputable def orbitValue (ρ : Representation (ZMod 2) BinaryLinearThree.Group A) (z : A)
    (p : Point) : A := ρ (pointLift p) z

private theorem orbitValue_eq (ρ : Representation (ZMod 2) BinaryLinearThree.Group A) (z : A)
    (hfix : ∀ g ∈ pointParabolicSL, ρ g z = z)
    (g : BinaryLinearThree.Group) (p : Point) (hg : pointPerm g flagPoint = p) :
    orbitValue ρ z p = ρ g z := by
  have hm : (pointLift p)⁻¹ * g ∈ pointParabolicSL := by
    rw [← point_stabilizer, map_mul, map_inv]
    change (pointPerm (pointLift p)).symm (pointPerm g flagPoint) = flagPoint
    rw [hg]
    apply (pointPerm (pointLift p)).injective
    simpa using (pointLift_spec p).symm
  have hh := congrArg (ρ (pointLift p)) (hfix _ hm)
  rw [← Module.End.mul_apply, ← map_mul, mul_inv_cancel_left] at hh
  exact hh.symm

private theorem orbitValue_equivariant (ρ : Representation (ZMod 2) BinaryLinearThree.Group A)
    (z : A) (hfix : ∀ g ∈ pointParabolicSL, ρ g z = z)
    (g : BinaryLinearThree.Group) (p : Point) :
    orbitValue ρ z (pointPerm g p) = ρ g (orbitValue ρ z p) := by
  rw [orbitValue_eq ρ z hfix (g * pointLift p) _ (by
    rw [map_mul]; change pointPerm g (pointPerm (pointLift p) flagPoint) = _
    rw [pointLift_spec])]
  rw [map_mul]
  rfl

private theorem orbitValue_seed (ρ : Representation (ZMod 2) BinaryLinearThree.Group A)
    (z : A) (hfix : ∀ g ∈ pointParabolicSL, ρ g z = z) :
    orbitValue ρ z flagPoint = z := by
  simpa using orbitValue_eq ρ z hfix 1 flagPoint (by simp)

private theorem orbitValue_nonzero (ρ : Representation (ZMod 2) BinaryLinearThree.Group A)
    (z : A) (hz : z ≠ 0) (p : Point) : orbitValue ρ z p ≠ 0 := by
  intro h
  have hh := congrArg (ρ (pointLift p)⁻¹) h
  change ρ (pointLift p)⁻¹ (ρ (pointLift p) z) = _ at hh
  rw [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one] at hh
  exact hz (by simpa using hh)

private theorem orbitValue_injective (ρ : Representation (ZMod 2) BinaryLinearThree.Group A)
    (z : A) (hfix : ∀ g ∈ pointParabolicSL, ρ g z = z)
    (hmoved : ∃ g, ρ g z ≠ z) : Function.Injective (orbitValue ρ z) := by
  let act : MulAction BinaryLinearThree.Group A := {
    smul := fun g a => ρ g a
    one_smul a := by change ρ 1 a = a; simp
    mul_smul g h a := by change ρ (g*h) a = ρ g (ρ h a); rw [map_mul]; rfl }
  let := act
  have hs : MulAction.stabilizer BinaryLinearThree.Group z = pointParabolicSL := by
    apply (isCoatom_pointParabolicSL.le_iff_eq _).mp
    · exact hfix
    · intro he
      obtain ⟨g,hg⟩ := hmoved
      exact hg (show g ∈ MulAction.stabilizer BinaryLinearThree.Group z from he ▸ Subgroup.mem_top g)
  intro p q hpq
  have hm : (pointLift q)⁻¹ * pointLift p ∈ MulAction.stabilizer BinaryLinearThree.Group z := by
    change ρ ((pointLift q)⁻¹ * pointLift p) z = z
    rw [map_mul]
    change ρ (pointLift q)⁻¹ (orbitValue ρ z p) = z
    rw [hpq]
    change ρ (pointLift q)⁻¹ (ρ (pointLift q) z) = z
    rw [← Module.End.mul_apply, ← map_mul, inv_mul_cancel, map_one]
    rfl
  rw [hs, ← point_stabilizer, map_mul, map_inv] at hm
  change (pointPerm (pointLift q)).symm (pointPerm (pointLift p) flagPoint) = flagPoint at hm
  have hh := congrArg (pointPerm (pointLift q)) hm
  simpa only [Equiv.apply_symm_apply, pointLift_spec] using hh

private theorem sum_of_three_nonzero (F : Submodule (ZMod 2) A) (hF : Nat.card F = 4)
    (a b c : F) (ha : a ≠ 0) (hb : b ≠ 0) (hc : c ≠ 0)
    (hab : a ≠ b) (hac : a ≠ c) (hbc : b ≠ c) : a + b = c := by
  classical
  let : Finite F := Nat.finite_of_card_ne_zero (by omega)
  let f : Fin 4 → F := ![0,a,b,c]
  have hi : Function.Injective f := by
    intro i j hij
    fin_cases i <;> fin_cases j <;> simp_all [f, eq_comm]
  have hs : Function.Surjective f := (hi.bijective_of_nat_card_le (by simp [hF])).2
  obtain ⟨i,hi⟩ := hs (a+b)
  fin_cases i
  · change (0 : F) = a+b at hi
    have he : a = b := by
      have := congrArg (fun x : F => x + b) hi
      simpa only [zero_add, add_assoc, twice, add_zero] using this.symm
    exact (hab he).elim
  · exact (hb (add_left_cancel (hi.symm.trans (add_zero a).symm))).elim
  · exact (ha (add_right_cancel (hi.symm.trans (zero_add b).symm))).elim
  · exact hi.symm

private def lineRotation : BinaryLinearThree.Group :=
  ⟨!![0,1,0;1,1,0;0,0,1], by decide⟩
private theorem lineRotation_mem : lineRotation ∈ lineParabolicSL := by decide
private theorem lineRotation_point : pointPerm lineRotation flagPoint = secondPoint := by decide
private theorem lineRotation_second : pointPerm lineRotation secondPoint = thirdPoint := by decide

private theorem marked_line_relation (ρ : Representation (ZMod 2) BinaryLinearThree.Group A)
    (z : A) (hz : z ≠ 0) (hfix : ∀ g ∈ pointParabolicSL, ρ g z = z)
    (hmoved : ∃ g, ρ g z ≠ z)
    (F : Submodule (ZMod 2) A) (hF : Nat.card F = 4) (hzF : z ∈ F)
    (hstable : ∀ g ∈ lineParabolicSL, ∀ a ∈ F, ρ g a ∈ F) :
    orbitValue ρ z flagPoint + orbitValue ρ z secondPoint = orbitValue ρ z thirdPoint := by
  have h0 : orbitValue ρ z flagPoint ∈ F := by rw [orbitValue_seed ρ z hfix]; exact hzF
  have h1 : orbitValue ρ z secondPoint ∈ F := by
    rw [← lineRotation_point, orbitValue_equivariant ρ z hfix]
    exact hstable _ lineRotation_mem _ h0
  have h2 : orbitValue ρ z thirdPoint ∈ F := by
    rw [← lineRotation_second, orbitValue_equivariant ρ z hfix]
    exact hstable _ lineRotation_mem _ h1
  have hi := orbitValue_injective ρ z hfix hmoved
  exact congrArg Subtype.val (sum_of_three_nonzero F hF
    ⟨_,h0⟩ ⟨_,h1⟩ ⟨_,h2⟩
    (fun h => orbitValue_nonzero ρ z hz _ (congrArg Subtype.val h))
    (fun h => orbitValue_nonzero ρ z hz _ (congrArg Subtype.val h))
    (fun h => orbitValue_nonzero ρ z hz _ (congrArg Subtype.val h))
    (fun h => (by decide : flagPoint ≠ secondPoint) (hi (congrArg Subtype.val h)))
    (fun h => (by decide : flagPoint ≠ thirdPoint) (hi (congrArg Subtype.val h)))
    (fun h => (by decide : secondPoint ≠ thirdPoint) (hi (congrArg Subtype.val h))))

private theorem every_line_relation (ρ : Representation (ZMod 2) BinaryLinearThree.Group A)
    (z : A) (hfix : ∀ g ∈ pointParabolicSL, ρ g z = z)
    (hline : orbitValue ρ z flagPoint + orbitValue ρ z secondPoint = orbitValue ρ z thirdPoint)
    (p q r : Point) (hpq : p ≠ q) (hr : r.val = p.val + q.val) :
    orbitValue ρ z p + orbitValue ρ z q = orbitValue ρ z r := by
  obtain ⟨g,hp,hq⟩ := ordered_pair_reachable p q hpq
  have hthird : pointPerm g thirdPoint = r := by
    apply Subtype.ext
    change W g thirdPoint.val = r.val
    rw [show thirdPoint.val = flagPoint.val + secondPoint.val by decide, map_add, hr]
    exact congrArg₂ (· + ·) (congrArg Subtype.val hp) (congrArg Subtype.val hq)
  rw [← hp, ← hq, ← hthird]
  simp only [orbitValue_equivariant ρ z hfix, ← map_add, hline]

private noncomputable def extendOrbit (ρ : Representation (ZMod 2) BinaryLinearThree.Group A)
    (z : A) (v : Vector) : A := if h : v = 0 then 0 else orbitValue ρ z ⟨v,h⟩

private theorem extendOrbit_point (ρ : Representation (ZMod 2) BinaryLinearThree.Group A)
    (z : A) (p : Point) : extendOrbit ρ z p.val = orbitValue ρ z p := by
  simp only [extendOrbit, dif_neg p.property]

private theorem extendOrbit_zero (ρ : Representation (ZMod 2) BinaryLinearThree.Group A)
    (z : A) : extendOrbit ρ z 0 = 0 := by simp [extendOrbit]

private theorem extendOrbit_add (ρ : Representation (ZMod 2) BinaryLinearThree.Group A)
    (z : A) (hfix : ∀ g ∈ pointParabolicSL, ρ g z = z)
    (hline : orbitValue ρ z flagPoint + orbitValue ρ z secondPoint = orbitValue ρ z thirdPoint)
    (x y : Vector) : extendOrbit ρ z (x+y) = extendOrbit ρ z x + extendOrbit ρ z y := by
  by_cases hx : x = 0
  · simp [hx, extendOrbit_zero]
  by_cases hy : y = 0
  · simp [hy, extendOrbit_zero]
  by_cases he : x = y
  · subst y; rw [twice, extendOrbit_zero, twice]
  have hxy : x+y ≠ 0 := by
    intro h
    apply he
    have := congrArg (fun v => v+y) h
    simpa only [add_assoc, twice, add_zero, zero_add] using this
  simp only [extendOrbit, dif_neg hx, dif_neg hy, dif_neg hxy]
  exact (every_line_relation ρ z hfix hline ⟨x,hx⟩ ⟨y,hy⟩ ⟨x+y,hxy⟩
    (fun h => he (congrArg Subtype.val h)) rfl).symm

private theorem seed_moved (ρ : Representation (ZMod 2) BinaryLinearThree.Group A)
    (hfaith : Function.Injective ρ) (z : A)
    (hspan : Submodule.span (ZMod 2) (Set.range (fun g => ρ g z)) = ⊤) :
    ∃ g, ρ g z ≠ z := by
  by_contra! h
  have hall (g : BinaryLinearThree.Group) (a : A) : ρ g a = a := by
    have ha : a ∈ Submodule.span (ZMod 2) (Set.range (fun g => ρ g z)) := hspan ▸ Submodule.mem_top
    induction ha using Submodule.span_induction with
    | mem a ha => obtain ⟨k,rfl⟩ := ha; dsimp only; rw [h k,h g]
    | zero => exact map_zero _
    | add x y hx hy ihx ihy => rw [map_add,ihx,ihy]
    | smul c x hx ih => rw [map_smul,ih]
  have he : ρ lineRotation = ρ 1 := by ext a; rw [hall, hall]
  exact (by decide : lineRotation ≠ 1) (hfaith he)

/-- The actual marked four-group forces all Fano line relations. The orbit map,
extended by zero, is a representation equivalence. No dimension or irreducibility
of the target is assumed. -/
theorem natural_equiv_of_marked_four
    (ρ : Representation (ZMod 2) BinaryLinearThree.Group A)
    (hfaith : Function.Injective ρ) (z : A) (hz : z ≠ 0)
    (hfix : ∀ g ∈ pointParabolicSL, ρ g z = z)
    (F : Submodule (ZMod 2) A) (hF : Nat.card F = 4) (hzF : z ∈ F)
    (hstable : ∀ g ∈ lineParabolicSL, ∀ a ∈ F, ρ g a ∈ F)
    (hspan : Submodule.span (ZMod 2) (Set.range (fun g => ρ g z)) = ⊤) :
    ∃ e : W.Equiv ρ, e flagPoint.val = z := by
  have hline := marked_line_relation ρ z hz hfix (seed_moved ρ hfaith z hspan) F hF hzF hstable
  let f : W.IntertwiningMap ρ := {
    toLinearMap := {
      toFun := extendOrbit ρ z
      map_add' := extendOrbit_add ρ z hfix hline
      map_smul' := by
        intro c x
        have hc : c = 0 ∨ c = 1 := by exact (by decide : ∀ c : ZMod 2, c = 0 ∨ c = 1) c
        rcases hc with rfl | rfl <;> simp [extendOrbit_zero] }
    isIntertwining' := by
      intro g
      apply LinearMap.ext
      intro x
      change extendOrbit ρ z (W g x) = ρ g (extendOrbit ρ z x)
      by_cases hx : x = 0
      · simp [hx,extendOrbit_zero]
      · exact (extendOrbit_point ρ z (pointPerm g ⟨x,hx⟩)).trans
          ((orbitValue_equivariant ρ z hfix g ⟨x,hx⟩).trans
            (congrArg (ρ g) (extendOrbit_point ρ z ⟨x,hx⟩).symm)) }
  have hf : f flagPoint.val = z := (extendOrbit_point ρ z flagPoint).trans (orbitValue_seed ρ z hfix)
  let : IsIrreducible W := IrreducibleCatalogue.natural_irreducible
  have hi : Function.Injective f := by
    rcases IsIrreducible.injective_or_eq_zero f with hi | he
    · exact hi
    · exact (hz (hf.symm.trans (congrArg (fun f : W.IntertwiningMap ρ => f flagPoint.val) he))).elim
  have hs : Function.Surjective f := by
    change Function.Surjective f.toLinearMap
    rw [← LinearMap.range_eq_top]
    apply top_unique
    rw [← hspan]
    apply Submodule.span_le.mpr
    rintro _ ⟨g,rfl⟩
    exact ⟨W g flagPoint.val, (Representation.IntertwiningMap.isIntertwining W ρ f g flagPoint.val).trans (congrArg (ρ g) hf)⟩
  exact ⟨f.ofBijective ⟨hi,hs⟩,hf⟩

/-- The nonzero seed orbit contains exactly seven vectors under the same
representation equivalence constructed above. -/
theorem natural_seed_orbit_card
    (ρ : Representation (ZMod 2) BinaryLinearThree.Group A)
    (e : W.Equiv ρ) (z : A) (he : e flagPoint.val = z) :
    Nat.card (Set.range (fun g => ρ g z)) = 7 := by
  let f : Point → Set.range (fun g => ρ g z) := fun p => ⟨e p.val, by
    obtain ⟨g,hg⟩ := point_reachable p
    refine ⟨g,?_⟩
    rw [← he]
    exact (Representation.IntertwiningMap.isIntertwining W ρ e.toIntertwiningMap
      g flagPoint.val).symm.trans (congrArg e (congrArg Subtype.val hg))⟩
  have hi : Function.Injective f := by
    intro p q h
    exact Subtype.ext (e.toLinearEquiv.injective (congrArg Subtype.val h))
  have hs : Function.Surjective f := by
    rintro ⟨a,g,rfl⟩
    refine ⟨pointPerm g flagPoint,?_⟩
    apply Subtype.ext
    change e (W g flagPoint.val) = ρ g z
    exact (Representation.IntertwiningMap.isIntertwining W ρ e.toIntertwiningMap
      g flagPoint.val).trans (congrArg (ρ g) he)
  rw [← Nat.card_congr (Equiv.ofBijective f ⟨hi,hs⟩),
    Nat.card_eq_fintype_card, Matrix.PSL3Two.Fano.card_point]

/-- Every nonzero vector has the same seven-element orbit in the reconstructed
natural representation, including the literal generator of Z. -/
theorem natural_nonzero_orbit_card
    (ρ : Representation (ZMod 2) BinaryLinearThree.Group A)
    (e : W.Equiv ρ) (z : A) (hz : z ≠ 0) :
    Nat.card (Set.range (fun g => ρ g z)) = 7 := by
  have hp : e.toLinearEquiv.symm z ≠ 0 := by
    intro h
    apply hz
    have hh := congrArg e.toLinearEquiv h
    rw [e.toLinearEquiv.apply_symm_apply, map_zero] at hh
    exact hh
  obtain ⟨k,hk⟩ := point_reachable ⟨e.toLinearEquiv.symm z,hp⟩
  have hkz : ρ k (e flagPoint.val) = z := by
    have he := Representation.IntertwiningMap.isIntertwining W ρ e.toIntertwiningMap k flagPoint.val
    change e (W k flagPoint.val) = ρ k (e flagPoint.val) at he
    apply he.symm.trans
    change e (pointPerm k flagPoint).val = z
    rw [hk]
    exact e.toLinearEquiv.apply_symm_apply z
  have hr : Set.range (fun g => ρ g z) = Set.range (fun g => ρ g (e flagPoint.val)) := by
    ext a
    constructor
    · rintro ⟨g,rfl⟩
      refine ⟨g*k,?_⟩
      dsimp only
      rw [map_mul]
      change ρ g (ρ k (e flagPoint.val)) = ρ g z
      rw [hkz]
    · rintro ⟨g,rfl⟩
      refine ⟨g*k⁻¹,?_⟩
      dsimp only
      rw [← hkz,← Module.End.mul_apply,← map_mul,inv_mul_cancel_right]
  rw [hr]
  exact natural_seed_orbit_card ρ e _ rfl

end CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GoldschmidtCore.Centrality.Semilinear.Recognition
