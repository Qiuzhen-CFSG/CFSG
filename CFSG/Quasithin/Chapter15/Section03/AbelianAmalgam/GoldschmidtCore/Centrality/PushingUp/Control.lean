module

public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GoldschmidtCore.Centrality.PushingUp.Algebra
public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GoldschmidtCore.Centrality.PushingUp.Residual
public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GoldschmidtCore.Centrality.PushingUp.Coordinates
public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GoldschmidtCore.Centrality.PushingUp.Characteristic
public import CFSG.Quasithin.Defs

/-!
# Conditional use of the doubled-natural specialization of C.1.37

`DoubledNaturalSource` spells out the universal earlier-source implication
used here. It is an assumption, not a theorem or a classification label.
The Chapter C owner must prove it; the 15.3.68 assembly owner must supply
that proof. This module discharges its local hypotheses from the actual
quotient and compatible doubled-natural action of the character kernel.

The canonical component is K∞. Its quotient action is inner, its two-core
is its intersection with O₂(K), and the doubled module is fixed-point-free
and generated by component commutators. The natural block alternative is
excluded by injecting the order-64 module into the order-8 block quotient.
The remaining core-commutator equality then gives [O₂(K),K∞] ≤ U via the
relative three-subgroups lemma. No such commutator bound is assumed.

Source: Aschbacher–Smith, C.1.37, printed pp.141–143, with A.3.3(4),
C.1.7 and C.1.30. Only the doubled-natural L₃(2) specialization is used;
proving and excluding the other source alternatives belongs to its owner.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GoldschmidtCore.Centrality.PushingUp
open Subgroup Theory.GroupTheory
universe u

/-- The explicit universal source input. R is literally O₂(P), normality
is inside J, and both the quotient and module identifications intertwine
the same actual conjugation action. The final plane marking is not consumed. -/
def DoubledNaturalSource (κ : GroupClass.{u}) : Prop :=
  ∀ (J : Type u) [Group J] [Finite J], IsSQTK κ J →
  ∀ (L P U : Subgroup J) [L.Normal] [U.Normal] (S : Sylow 2 J),
    L.IsCComponent → generalizedFitting J = pCore 2 J →
    L ⊔ (S : Subgroup J) = ⊤ → IsCoatom P → (S : Subgroup J) ≤ P →
    ∀ (eJ : (J ⧸ pCore 2 J) ≃* SL) (eL : (L ⧸ pCore 2 L) ≃* SL),
    (∀ l : L, eL (QuotientGroup.mk' (pCore 2 L) l) = eJ (QuotientGroup.mk' (pCore 2 J) l)) →
    (∀ k : J, ∃ l : L, ∀ x : L,
      QuotientGroup.mk' (pCore 2 L) (MulAut.conjNormal k x) =
      QuotientGroup.mk' (pCore 2 L) (l * x * l⁻¹)) →
    IsElementaryAbelian 2 U → pCore 2 (J ⧸ centralizer (U : Set J)) = ⊥ →
    ⁅U,L⁆ = U → U ≠ ⊥ →
    ∀ eU : U ≃* Multiplicative DoubleSpace,
    (∀ k u, Multiplicative.toAdd (eU (MulAut.conjNormal k u)) =
      fun j => Matrix.mulVec (eJ (QuotientGroup.mk' (pCore 2 J) k)).val (Multiplicative.toAdd (eU u) j)) →
    (∃ C : Subgroup (ChapterB.baumann ((pCore 2 P).map P.subtype)),
      C.Characteristic ∧ C ≠ ⊥ ∧
        (C.map (ChapterB.baumann ((pCore 2 P).map P.subtype)).subtype).Normal) ∨
    ChapterC.IsLinearTwoBlock L 3 ∨
    U = (ChapterC.blockU L).map L.subtype

variable {K : Type u} [Group K] [Finite K]

/-- The canonical component quotient identification, compatible with K/O₂(K). -/
noncomputable def componentIso (e : (K ⧸ pCore 2 K) ≃* SL) :
    (solvableResidual K ⧸ pCore 2 (solvableResidual K)) ≃* SL :=
  (cComponentTwoCoreQuotientEquiv (residual_isCComponent e)).trans
    ((MulEquiv.subgroupCongr (residual_quotient_image e)).trans (topEquiv.trans e))

/-- The component isomorphism uses exactly the original quotient map. -/
theorem componentIso_apply (e : (K ⧸ pCore 2 K) ≃* SL) (l : solvableResidual K) :
    componentIso e (QuotientGroup.mk' (pCore 2 (solvableResidual K)) l) =
      e (QuotientGroup.mk' (pCore 2 K) l) := by rfl

/-- Generation by component commutators places the module in O₂(L). -/
theorem le_component_core (U L : Subgroup K) [L.Normal]
    (hUN : U ≤ pCore 2 K) (hcomm : ⁅U,L⁆ = U) :
    U ≤ (pCore 2 L).map L.subtype := by
  have hUL : U ≤ L := hcomm ▸ commutator_le_right U L
  rw [pCore_subnormal_eq_comap 2 (inferInstance : L.Normal).isSubnormal,
    map_comap_eq, range_subtype]
  exact le_inf hUL hUN

/-- The block obstruction, with all subgroup-to-component transports explicit. -/
theorem block_exclusion (U L : Subgroup K) [U.Normal] [L.Normal]
    (hUN : U ≤ pCore 2 K) (hcomm : ⁅U,L⁆ = U)
    (hfix : U ⊓ centralizer (L : Set K) = ⊥) (hcard : Nat.card U = 64) :
    ¬ ChapterC.IsLinearTwoBlock L 3 := by
  have hUL : U ≤ L := hcomm ▸ commutator_le_right U L
  have hcore : U.subgroupOf L ≤ pCore 2 L := by
    rw [pCore_subnormal_eq_comap 2 (inferInstance : L.Normal).isSubnormal]
    exact fun _ hx => hUN hx
  have hcomm' : ⁅U.subgroupOf L, (⊤ : Subgroup L)⁆ = U.subgroupOf L := by
    apply map_injective L.subtype_injective
    rw [map_commutator, map_subgroupOf_eq_of_le hUL, ← MonoidHom.range_eq_map,
      range_subtype, hcomm]
  apply not_linearTwoBlock_of_card (U.subgroupOf L)
  · rw [← hcomm']
    exact commutator_mono hcore le_rfl
  · apply eq_bot_iff.mpr
    rintro u ⟨hu,hz⟩
    have hc : (u : K) ∈ centralizer (L : Set K) := by
      apply mem_centralizer_iff.mpr
      intro l hl
      exact congrArg Subtype.val (mem_center_iff.mp hz ⟨l,hl⟩)
    have hb : (u : K) ∈ (⊥ : Subgroup K) := hfix ▸ ⟨hu,hc⟩
    exact Subtype.ext hb
  · exact (Nat.card_congr (subgroupOfEquivOfLe hUL).toEquiv).trans hcard

/-- Conditional local pushing-up control, after every source premise and
both unwanted alternatives have been discharged. -/
theorem local_control {κ : GroupClass.{u}} (hsource : DoubledNaturalSource κ)
    (hSQ : IsSQTK κ K) (P U : Subgroup K) [U.Normal]
    (S : Sylow 2 K) (hP : IsCoatom P) (hSP : (S : Subgroup K) ≤ P)
    (eK : (K ⧸ pCore 2 K) ≃* SL)
    (eU : U ≃* Multiplicative DoubleSpace)
    (hU : IsElementaryAbelian 2 U) (hUN : U ≤ pCore 2 K)
    (hC : centralizer (U : Set K) = pCore 2 K)
    (hact : ∀ k u, Multiplicative.toAdd (eU (MulAut.conjNormal k u)) =
      fun j => Matrix.mulVec (eK (QuotientGroup.mk' (pCore 2 K) k)).val
        (Multiplicative.toAdd (eU u) j))
    (hchar : ∀ C : Subgroup (ChapterB.baumann ((pCore 2 P).map P.subtype)),
      C.Characteristic → C ≠ ⊥ →
        ¬ (C.map (ChapterB.baumann ((pCore 2 P).map P.subtype)).subtype).Normal) :
    U = (ChapterC.blockU (solvableResidual K)).map (solvableResidual K).subtype ∧
      ⁅pCore 2 K,solvableResidual K⁆ ≤ U := by
  let L := solvableResidual K
  let ρ := eK.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 K))
  have hsurj : Function.Surjective (ρ.comp L.subtype) := by
    intro x
    obtain ⟨l,hl,hq⟩ := (show eK.symm x ∈ L.map (QuotientGroup.mk' (pCore 2 K)) from
      residual_quotient_image eK ▸ mem_top _)
    exact ⟨⟨l,hl⟩, by change eK (QuotientGroup.mk' (pCore 2 K) l) = x; rw [hq]; simp⟩
  have hcomm := doubled_commutator U L ρ eU hact hsurj
  have hfix := doubled_fixed U L ρ eU hact hsurj
  have hcard := doubled_card U eU
  have hne : U ≠ ⊥ := by
    intro hb
    simp [hb] at hcard
  have htypes := hsource K hSQ L P U S (residual_isCComponent eK)
    (fitting_eq_core U hUN hC) (sup_sylow_eq_top L (residual_sup_core eK) S)
    hP hSP eK (componentIso eK) (fun _ => rfl)
    (quotient_conjugation_inner L (residual_quotient_image eK))
    hU (reduced_quotient_core U hC) hcomm hne eU hact
  rcases htypes with ⟨C,hCc,hCn,hCN⟩ | hblock | hcore
  · exact (hchar C hCc hCn hCN).elim
  · exact (block_exclusion U L hUN hcomm hfix hcard hblock).elim
  · refine ⟨hcore, ?_⟩
    apply commutator_le_of_core_commutator_le (pCore 2 K) L U (commutator_le_inf _ _)
    · rw [core_intersection L (residual_isCComponent eK), hcore]
      rw [ChapterC.blockU, map_commutator, ← MonoidHom.range_eq_map, range_subtype]
    · rw [normalizer_eq_top]; exact le_top
    · rw [normalizer_eq_top]; exact le_top
end CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GoldschmidtCore.Centrality.PushingUp
