module

public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.LineNormalizers.Descent.Frattini
/-!
# The residual convention in the descent argument

Here `O^{2,3}(H)` is the `{2,3}`-residual: the subgroup generated by
all elements of order prime to six. This is the usual `O^π` convention,
spelled out in `refs/KGroup/GLS2/ChapterA.tex`, printed p.3. The superscript
in the proof of 15.3.67 is not the core `O_{2,3}` and does not denote an
iteration of the two- and three-residuals. In particular, an iterated
residual vanishing would be incompatible with the earlier nontrivial
binary module `V = [V,Y_E]` in that argument.

Conjugation preserves both subgroup membership and element order. Thus
normalizers preserve this residual, so it is relatively normal in its
parent subgroup. The descent still has to compare the residuals of
`G_E`, `M`, and `C_G(V)` before applying the local collapse theorem.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), proof of
Lemma 15.3.67, printed p.1154, PDF p.1171; GLS II, Chapter A, p.3
for the general residual convention.
-/

@[expose] public section

open Subgroup
namespace CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.Descent
variable {G : Type*} [Group G]

/-- The ambient `{2,3}`-residual, generated by elements of order prime to six. -/
def twoThreeResidual (H : Subgroup G) : Subgroup G :=
  closure {x : G | x ∈ H ∧ Nat.Coprime (orderOf x) 6}

/-- Every residual generator belongs to its parent subgroup. -/
theorem twoThreeResidual_le (H : Subgroup G) : twoThreeResidual H ≤ H :=
  (closure_le H).mpr (fun _ hx => hx.1)

/-- Residual generation is monotone in the parent subgroup. -/
theorem twoThreeResidual_mono {H K : Subgroup G} (hHK : H ≤ K) :
    twoThreeResidual H ≤ twoThreeResidual K :=
  closure_mono (fun _ hx => ⟨hHK hx.1, hx.2⟩)

/-- Conjugation preserving the parent subgroup preserves its prime-to-six generators. -/
theorem normalizer_le_normalizer_twoThreeResidual (H : Subgroup G) :
    normalizer (H : Set G) ≤ normalizer (twoThreeResidual H : Set G) := by
  intro g hg
  apply mem_normalizer_iff_map_conj_eq.mpr
  rw [twoThreeResidual, MonoidHom.map_closure]
  congr 1
  ext x
  constructor
  · rintro ⟨y, ⟨hy, ho⟩, rfl⟩
    refine ⟨(hg y).mp hy, ?_⟩
    exact (orderOf_injective (MulAut.conj g).toMonoidHom (MulAut.conj g).injective y).symm ▸ ho
  · rintro ⟨hx, ho⟩
    refine ⟨(MulAut.conj g).symm x, ⟨?_, ?_⟩, (MulAut.conj g).apply_symm_apply x⟩
    · change g⁻¹ * x * g ∈ H
      simpa only [inv_inv, SetLike.mem_coe] using (((normalizer (H : Set G)).inv_mem hg) x).mp hx
    · exact (orderOf_injective (MulAut.conj g).symm.toMonoidHom
        (MulAut.conj g).symm.injective x).symm ▸ ho

/-- The `{2,3}`-residual is relatively normal in its parent subgroup. -/
theorem twoThreeResidual_normal (H : Subgroup G) : ((twoThreeResidual H).subgroupOf H).Normal :=
  (normal_subgroupOf_iff_le_normalizer (twoThreeResidual_le H)).mpr
    (H.le_normalizer.trans (normalizer_le_normalizer_twoThreeResidual H))

end CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.Descent
