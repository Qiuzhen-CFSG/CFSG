module

public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.LineNormalizers.Descent.QuotientIdentification.Cores
public import Mathlib.Data.Fintype.Perm

/-!
# Preserving the initially marked quotient factors

The second factor of the decomposition on printed p.1153 is defined as the
actual image of `C_G(E)` in `G_E/Q_E`. Its first-isomorphism equivalence uses
the intrinsic centralizer two-core, already compared with the original
`Q_E`. The initial first factor is marked by `⟨Y_E,τ⟩`, with `τ ∈ T_E`.

After recognizing the centralizer quotient as `S₃`, a product equivalence
changes only the second coordinate. The first marked factor and the maps
from actual centralizer elements are preserved. Thus the construction
retains the factor identification, in addition to the abstract group type.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), proof of
Lemma 15.3.67, printed pp.1153–1154, PDF pp.1170–1171.
-/

@[expose] public section
open Subgroup
namespace CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.Descent.QuotientIdentification
variable {G : Type*} [Group G]

/-- The actual image of `C_G(E)` in the original core quotient. -/
noncomputable def centralizerImage (E : Subgroup G) :
    Subgroup (lineNormalizer E ⧸ pCore 2 (lineNormalizer E)) :=
  (restrictedQuotient E (centralizer (E : Set G))
    (centralizer_le_normalizer (E : Set G))).range

/-- First isomorphism theorem with the intrinsic centralizer core as kernel. -/
noncomputable def centralizerCoreEquivImage (E : Subgroup G) :
    (centralizer (E : Set G) ⧸ pCore 2 (centralizer (E : Set G))) ≃* centralizerImage E :=
  (QuotientGroup.quotientMulEquivOfEq (centralizer_quotient_ker E).symm).trans
    (QuotientGroup.quotientKerEquivRange _)

/-- The canonical element of the actual centralizer image. -/
noncomputable def centralizerImageMap (E : Subgroup G) :
    centralizer (E : Set G) →* centralizerImage E :=
  (restrictedQuotient E (centralizer (E : Set G))
    (centralizer_le_normalizer (E : Set G))).rangeRestrict

/-- Compatibility of the first isomorphism theorem with the original quotient map. -/
theorem centralizerCoreEquivImage_mk (E : Subgroup G) (c : centralizer (E : Set G)) :
    centralizerCoreEquivImage E (QuotientGroup.mk' (pCore 2 (centralizer (E : Set G))) c) =
      centralizerImageMap E c := rfl

/-- The initial, partly unidentified decomposition on printed p.1153. Its second
factor is literally the image of `C_G(E)`; no isomorphism type is imposed on it.
The first marked factor is generated by the original `Y_E` and `τ ∈ T_E`. -/
structure MarkedDecomposition (Y T E : Subgroup G) where
  tau : G
  tau_mem : tau ∈ lineT T E
  equiv : (lineNormalizer E ⧸ pCore 2 (lineNormalizer E)) ≃*
    Equiv.Perm (Fin 3) × centralizerImage E
  first_factor :
    (((lineY Y E ⊔ zpowers tau).subgroupOf (lineNormalizer E)).map
      (equiv.toMonoidHom.comp (quotientMap E))) =
        (⊤ : Subgroup (Equiv.Perm (Fin 3))).prod ⊥
  centralizer_factor : ∀ c : centralizer (E : Set G),
    equiv (restrictedQuotient E _ (centralizer_le_normalizer (E : Set G)) c) =
      (1, centralizerImageMap E c)

/-- Relabel the actual centralizer factor using its now-proved intrinsic quotient. -/
noncomputable def centralizerImageEquiv (E : Subgroup G)
    (e : (centralizer (E : Set G) ⧸ pCore 2 (centralizer (E : Set G))) ≃*
      Equiv.Perm (Fin 3)) : centralizerImage E ≃* Equiv.Perm (Fin 3) :=
  (centralizerCoreEquivImage E).symm.trans e

/-- The relabeling preserves the actual centralizer quotient map. -/
theorem centralizerImageEquiv_apply (E : Subgroup G)
    (e : (centralizer (E : Set G) ⧸ pCore 2 (centralizer (E : Set G))) ≃*
      Equiv.Perm (Fin 3)) (c : centralizer (E : Set G)) :
    centralizerImageEquiv E e (centralizerImageMap E c) =
      e (QuotientGroup.mk' (pCore 2 (centralizer (E : Set G))) c) := by
  change e ((centralizerCoreEquivImage E).symm (centralizerImageMap E c)) = _
  rw [← centralizerCoreEquivImage_mk, MulEquiv.symm_apply_apply]

/-- Extend the initial marked decomposition by identifying only its second factor. -/
noncomputable def markedProductEquiv (Y T E : Subgroup G) (d : MarkedDecomposition Y T E)
    (e : (centralizer (E : Set G) ⧸ pCore 2 (centralizer (E : Set G))) ≃*
      Equiv.Perm (Fin 3)) :
    (lineNormalizer E ⧸ pCore 2 (lineNormalizer E)) ≃*
      Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3) :=
  d.equiv.trans ((MulEquiv.refl _).prodCongr (centralizerImageEquiv E e))

/-- The original first marked coordinate is preserved pointwise. -/
theorem markedProductEquiv_fst (Y T E : Subgroup G) (d : MarkedDecomposition Y T E)
    (e : (centralizer (E : Set G) ⧸ pCore 2 (centralizer (E : Set G))) ≃*
      Equiv.Perm (Fin 3)) (q : lineNormalizer E ⧸ pCore 2 (lineNormalizer E)) :
    (markedProductEquiv Y T E d e q).1 = (d.equiv q).1 := rfl

/-- The actual centralizer maps onto the second factor, through its intrinsic quotient. -/
theorem markedProductEquiv_centralizer (Y T E : Subgroup G) (d : MarkedDecomposition Y T E)
    (e : (centralizer (E : Set G) ⧸ pCore 2 (centralizer (E : Set G))) ≃*
      Equiv.Perm (Fin 3)) (c : centralizer (E : Set G)) :
    markedProductEquiv Y T E d e
      (restrictedQuotient E _ (centralizer_le_normalizer (E : Set G)) c) =
        (1, e (QuotientGroup.mk' (pCore 2 (centralizer (E : Set G))) c)) := by
  change ((MulEquiv.refl _).prodCongr (centralizerImageEquiv E e))
    (d.equiv _) = _
  rw [d.centralizer_factor]
  exact Prod.ext rfl (centralizerImageEquiv_apply E e c)

/-- The marked `⟨Y_E,τ⟩` remains precisely the first full `S₃` factor. -/
theorem markedProductEquiv_first_factor (Y T E : Subgroup G) (d : MarkedDecomposition Y T E)
    (e : (centralizer (E : Set G) ⧸ pCore 2 (centralizer (E : Set G))) ≃*
      Equiv.Perm (Fin 3)) :
    (((lineY Y E ⊔ zpowers d.tau).subgroupOf (lineNormalizer E)).map
      ((markedProductEquiv Y T E d e).toMonoidHom.comp (quotientMap E))) =
        (⊤ : Subgroup (Equiv.Perm (Fin 3))).prod ⊥ := by
  have he : (markedProductEquiv Y T E d e).toMonoidHom.comp (quotientMap E) =
      ((MulEquiv.refl _).prodCongr (centralizerImageEquiv E e)).toMonoidHom.comp
        (d.equiv.toMonoidHom.comp (quotientMap E)) := rfl
  rw [he, ← map_map, d.first_factor]
  ext x
  constructor
  · rintro ⟨z, hz, rfl⟩
    refine ⟨mem_top _, ?_⟩
    change centralizerImageEquiv E e z.2 = 1
    rw [show z.2 = 1 from hz.2, map_one]
  · rintro ⟨_, hx⟩
    refine ⟨(x.1, 1), ⟨mem_top _, rfl⟩, ?_⟩
    apply Prod.ext
    · rfl
    · change centralizerImageEquiv E e 1 = x.2
      rw [map_one]
      exact hx.symm

end CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.Descent.QuotientIdentification
