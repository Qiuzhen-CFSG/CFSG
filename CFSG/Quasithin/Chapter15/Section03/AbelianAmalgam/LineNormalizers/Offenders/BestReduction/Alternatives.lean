module

public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.LineNormalizers.Offenders.BestReduction.Fields
public import Theory.Representation.BinaryPermutation

/-!
# The unreduced and reduced line-offender alternatives

This conditional interface starts with arbitrary positive binary field degree
in the SL₂ family, and arbitrary positive odd degree in the SL₃ family. Each
case contains the actual group and central-quotient module equivalences.
The B.4 comparison concerns the normalizer of the specified subgroup J.
Applying the marked normalizer argument proves that every field degree is one.
The original witness, and hence its module coordinates and extension, is retained.

These are conclusions to be supplied by the earlier B.2/B.4/B.5 arguments.
This module does not prove their classification or that an arbitrary Thompson
image is generated by best offenders on the first summand.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), proof of
15.3.67, printed p.1154; B.4.2 and B.5.1, printed pp.86 and 99.
-/

@[expose] public section
open Subgroup Representation Representation.BinaryOffender
open Representation.HigherFieldBorelFixedSpaces
open Matrix Matrix.SpecialLinearGroup Matrix.PSL3.LinearThree
open scoped MatrixGroups

namespace CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.Offenders.BestReduction
universe u v
variable {D : Type u} [Group D] {W : Type v} [AddCommGroup W] [Module (ZMod 2) W]

/-- Precise preceding classification and Borel-normalizer outputs. The group
and the natural module are linked by the same actor equivalence. -/
inductive UnreducedAlternative (ρ : Representation (ZMod 2) D W) (J : Subgroup D) :
    Type (max u v 1) where
  | linearTwo (F : Type) [Field F] [Finite F] [CharP F 2] [Algebra (ZMod 2) F]
      (n : ℕ) (positive : 0 < n) (card_eq : Nat.card F = 2 ^ n)
      (model : CentralQuotientCoordinates ρ (binaryNatural (F := F) 2))
      (normalizes : rankOneBorel F ≤
        Subgroup.normalizer (J.map model.actor.toMonoidHom : Set SL(2,F)))
  | linearThree (F : Type) [Field F] [Finite F] [CharP F 2] [Algebra (ZMod 2) F]
      (n : ℕ) (positive : 0 < n) (odd : Odd n) (card_eq : Nat.card F = 2 ^ n)
      (model : CentralQuotientCoordinates ρ (binaryNatural (F := F) 3))
      (normalizes : borelSL F ≤
        Subgroup.normalizer (J.map model.actor.toMonoidHom : Set SL(3,F)))
  | doubleLinearThree (F : Type) [Field F] [Finite F] [CharP F 2] [Algebra (ZMod 2) F]
      (n : ℕ) (positive : 0 < n) (odd : Odd n) (card_eq : Nat.card F = 2 ^ n)
      (model : CentralQuotientCoordinates ρ
        ((binaryNatural (F := F) 3).prod (binaryNatural (F := F) 3)))
      (normalizes : borelSL F ≤
        Subgroup.normalizer (J.map model.actor.toMonoidHom : Set SL(3,F)))
  | symmetricFive
      (model : CentralQuotientCoordinates ρ (BinaryPermutation.naturalRepresentation (Fin 5)))

/-- The degree retained in the preceding witness; the symmetric case is binary. -/
def UnreducedAlternative.fieldDegree {ρ : Representation (ZMod 2) D W} {J : Subgroup D} :
    UnreducedAlternative ρ J → ℕ := by
  intro a
  cases a with
  | linearTwo F n hn hc c hB => exact n
  | linearThree F n hn ho hc c hB => exact n
  | doubleLinearThree F n hn ho hc c hB => exact n
  | symmetricFive c => exact 1

/-- The original classification witness has degree one. No replacement of its
module by an unproved split model occurs. -/
theorem UnreducedAlternative.field_degree_eq_one
    {ρ : Representation (ZMod 2) D W} {J : Subgroup D}
    (a : UnreducedAlternative ρ J) (d : MarkedNormalizer ρ J) : a.fieldDegree = 1 := by
  cases a with
  | linearTwo F n hn hc c hB => exact linearTwo_field_degree_eq_one d c hn hc hB
  | linearThree F n hn _ hc c hB => exact linearThree_field_degree_eq_one d c hn hc hB
  | doubleLinearThree F n hn _ hc c hB => exact doubleLinearThree_field_degree_eq_one d c hn hc hB
  | symmetricFive c => rfl

/-- The degree reduction produces actual small-group equivalences. The original
`a` and `d` still retain the marked subspace, Sylow subgroup, and all natural or
doubled-natural central-quotient coordinates for the subsequent index proof. -/
theorem UnreducedAlternative.small_group_cases
    {ρ : Representation (ZMod 2) D W} {J : Subgroup D}
    (a : UnreducedAlternative ρ J) (d : MarkedNormalizer ρ J) :
    Nonempty (D ≃* Equiv.Perm (Fin 3)) ∨ Nonempty (D ≃* Equiv.Perm (Fin 5)) ∨
      Nonempty (D ≃* PSL(3,ZMod 2)) := by
  cases a with
  | linearTwo F n hn hc c hB => exact Or.inl (linearTwo_equiv_symmetricThree d c hn hc hB)
  | linearThree F n hn _ hc c hB =>
    obtain ⟨e⟩ := linearThree_equiv_binary d c hn hc hB
    exact Or.inr (Or.inr ⟨e.trans (sl3ProjectiveEquiv (n := 1) (by decide) (by simp))⟩)
  | doubleLinearThree F n hn _ hc c hB =>
    obtain ⟨e⟩ := doubleLinearThree_equiv_binary d c hn hc hB
    exact Or.inr (Or.inr ⟨e.trans (sl3ProjectiveEquiv (n := 1) (by decide) (by simp))⟩)
  | symmetricFive c => exact Or.inr (Or.inl ⟨c.actor⟩)

end CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.Offenders.BestReduction
