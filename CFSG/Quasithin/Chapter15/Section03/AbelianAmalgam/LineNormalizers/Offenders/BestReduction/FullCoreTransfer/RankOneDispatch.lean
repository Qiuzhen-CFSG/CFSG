public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.LineNormalizers.Offenders.BestReduction.FullCoreTransfer.RankOneDispatch.SymmetricThree
public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.LineNormalizers.Offenders.BestReduction.FullCoreTransfer.RankOneDispatch.Sections
public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.LineNormalizers.Offenders.BestReduction.FullCoreTransfer.RankOneDispatch.Quasisimple
public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.LineNormalizers.Offenders.BestReduction.FullCoreTransfer.CoreInput
public import Stellmacher.ElementaryAbelianMaxDefs

/-!
# The full B.5.6 reduction and its faithful-image consumer

At three-rank one, the product and outer branches are impossible, and the
split symmetric-three branch gives an actual SL₂(2) model section. Exhausting
the full B.5.1 conclusion on the generalized Fitting subgroup supplies the
remaining SL₂, S₅ and odd-degree SL₃ models, with actual equivariant sections.

The consumer uses N = J(image(ρ),W). Its faithful, two-core and generation
hypotheses are proved by CoreInput; an ordinary offender and the odd action
kernel make N nontrivial. The second consumer uses the literal original
Thompson image and an ordinary maximum image. Neither assumes that original
actor is already generated by best offenders.

The universal adequate classifier remains an explicit earlier-source input;
this reduction does not prove that classifier. The final full-core transfer
assembly must instantiate it and establish generation of the original actor.
Source: Aschbacher–Smith, B.5.1 and B.5.6, printed pp.99–105, and proof of
15.3.67, printed pp.1153–1154 (combined manuscript of 1 March 2004).
-/

public section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
namespace CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.Offenders.BestReduction.FullCoreTransfer.RankOneDispatch
open ChapterB.SourceInduction
universe u v

/-- Every B.5.6 branch except its full quasisimple branch is discharged.
The right alternative retains every B.5.1 clause on the actual action. -/
theorem model_or_full_quasisimple
    {D : Type u} [Group D] [Finite D] {W : Type v}
    [AddCommGroup W] [Module (ZMod 2) W] {K : GroupClass.{u}}
    (ρ : Representation (ZMod 2) D W) (hff : FFHypothesis K ρ)
    (hr : primeRank 3 D ≤ 1) (h : NontrivialAdequateAlternative ρ) :
    RankOneModel ρ ∨ (IsQuasisimple (generalizedFitting D) ∧
      Nonempty (ProjectiveLine.QuasisimpleSourceConclusion ρ (generalizedFitting D))) := by
  let := hff.finite_module
  rcases quasisimple_or_symmetricThree ρ hr h with hq | hs
  · exact Or.inr hq
  · obtain ⟨hs⟩ := hs
    exact Or.inl (symmetricThree_model ρ hff.faithful hs)

/-- The full five-way adequate B.5.6 alternative gives an actual model
section at three-rank one. The quasisimple branch uses the complete B.5.1
action conclusion, and all other source branches are discharged above. -/
theorem model_of_adequate_alternative
    {D : Type u} [Group D] [Finite D] {W : Type v}
    [AddCommGroup W] [Module (ZMod 2) W] {K : GroupClass.{u}}
    (ρ : Representation (ZMod 2) D W) (hff : FFHypothesis K ρ)
    (hr : primeRank 3 D ≤ 1) (h : NontrivialAdequateAlternative ρ) :
    RankOneModel ρ := by
  rcases model_or_full_quasisimple ρ hff hr h with hm | ⟨_, ⟨hc⟩⟩
  · exact hm
  · exact quasisimple_model hr hc

/-- Specialize the genuine universal classifier using actual actor
nontriviality. The earlier-source classification premise remains explicit. -/
theorem model_of_classification
    {D : Type u} [Group D] [Finite D] [Nontrivial D] {W : Type v}
    [AddCommGroup W] [Module (ZMod 2) W] {K : GroupClass.{u}}
    (classify : AdequateClassificationInput.{u,v} K)
    (ρ : Representation (ZMod 2) D W) (hff : FFHypothesis K ρ)
    (hr : primeRank 3 D ≤ 1) : RankOneModel ρ :=
  model_of_adequate_alternative ρ hff hr
    ((classify D W ρ hff).of_nontrivial ρ)

section Image
variable {D W : Type u} [Group D] [Finite D]
  [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]

/-- Apply the genuine universal classifier to precisely the nontrivial
best-offender subgroup of the faithful image. Both kernel conditions are
explicit: oddness preserves ordinary offending, and the prime-to-three
condition transports the rank bound. -/
theorem image_offenderCore_model_or_full_quasisimple
    {K : GroupClass.{u}} (classify : AdequateClassificationInput.{u,u} K)
    (ρ : Representation (ZMod 2) D W)
    (hff : IsFFModule ρ) (hodd : Odd (Nat.card (actionHom ρ).ker))
    (hker : Nat.Coprime 3 (Nat.card (actionHom ρ).ker)) (hr : primeRank 3 D ≤ 1)
    (S : Sylow 2 (actionImage ρ)) (P : Submodule (ZMod 2) W)
    (hfix : P ≤ fixedSpace (imageRepresentation ρ) (S : Subgroup (actionImage ρ)))
    (hspan : Submodule.span (ZMod 2)
      {w | ∃ (g : actionImage ρ) (v : W), v ∈ P ∧ imageRepresentation ρ g v = w} = ⊤)
    (cover : SQTKQuotient K (actionImage ρ)) :
    let δ := imageRepresentation ρ
    let N := offenderSubgroup δ
    RankOneModel (δ.comp N.subtype) ∨ (IsQuasisimple (generalizedFitting N) ∧
      Nonempty (ProjectiveLine.QuasisimpleSourceConclusion (δ.comp N.subtype)
        (generalizedFitting N))) := by
  let δ := imageRepresentation ρ
  let N := offenderSubgroup δ
  have hN := offenderCore_FFHypothesis δ (imageRepresentation_injective ρ)
    S P hfix hspan cover
  have hrN := image_offenderCore_threeRank_le_one ρ hker hr
  have hne : N ≠ ⊥ := by
    obtain ⟨A, hA⟩ := hff
    exact offenderSubgroup_ne_bot_of_ff δ ⟨_, hA.actionImage_of_odd_kernel ρ hodd⟩
  let : Nontrivial N := (Subgroup.nontrivial_iff_ne_bot N).mpr hne
  have ha := (classify N W (δ.comp N.subtype) hN).of_nontrivial (δ.comp N.subtype)
  exact model_or_full_quasisimple (δ.comp N.subtype) hN hrN ha

/-- The actual nontrivial offender subgroup of the faithful image has one
of the three model sections. This discharges the model-selection premise of
the full-core bootstrap, retaining the universal earlier-source classifier. -/
theorem image_offenderCore_model
    {K : GroupClass.{u}} (classify : AdequateClassificationInput.{u,u} K)
    (ρ : Representation (ZMod 2) D W)
    (hff : IsFFModule ρ) (hodd : Odd (Nat.card (actionHom ρ).ker))
    (hker : Nat.Coprime 3 (Nat.card (actionHom ρ).ker)) (hr : primeRank 3 D ≤ 1)
    (S : Sylow 2 (actionImage ρ)) (P : Submodule (ZMod 2) W)
    (hfix : P ≤ fixedSpace (imageRepresentation ρ) (S : Subgroup (actionImage ρ)))
    (hspan : Submodule.span (ZMod 2)
      {w | ∃ (g : actionImage ρ) (v : W), v ∈ P ∧ imageRepresentation ρ g v = w} = ⊤)
    (cover : SQTKQuotient K (actionImage ρ)) :
    let δ := imageRepresentation ρ
    let N := offenderSubgroup δ
    RankOneModel (δ.comp N.subtype) := by
  rcases image_offenderCore_model_or_full_quasisimple classify ρ hff hodd hker hr
      S P hfix hspan cover with hm | ⟨_, ⟨hc⟩⟩
  · exact hm
  · exact quasisimple_model (image_offenderCore_threeRank_le_one ρ hker hr) hc

end Image

section ThompsonImage
variable {G H W : Type u} [Group G] [Finite G] [Group H] [Finite H]
  [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]

/-- Source application to ρI = σ.comp I.subtype for the original
I = q(J(C)). An actual ordinary maximum image supplies nontriviality,
and the original SQTK group supplies the genuine cover of the image. -/
theorem thompson_image_model_or_full_quasisimple
    {K : GroupClass.{u}} (classify : AdequateClassificationInput.{u,u} K)
    (hG : IsSQTK K G) (C : Subgroup G) (q : G →* H) (hq : Function.Surjective q)
    (σ : Representation (ZMod 2) H W)
    (A : Subgroup G) (hA : A ∈ Stellmacher.elementaryAbelianMaxSubgroups C)
    (hordinary : IsOffender σ (A.map q))
    (hodd : Odd (Nat.card (actionHom
      (σ.comp ((Stellmacher.elementaryAbelianMaxJ C).map q).subtype)).ker))
    (hker : Nat.Coprime 3 (Nat.card (actionHom
      (σ.comp ((Stellmacher.elementaryAbelianMaxJ C).map q).subtype)).ker))
    (hr : primeRank 3 ((Stellmacher.elementaryAbelianMaxJ C).map q) ≤ 1)
    (S : Sylow 2 (actionImage (σ.comp ((Stellmacher.elementaryAbelianMaxJ C).map q).subtype)))
    (P : Submodule (ZMod 2) W)
    (hfix : P ≤ fixedSpace
      (imageRepresentation (σ.comp ((Stellmacher.elementaryAbelianMaxJ C).map q).subtype)) S)
    (hspan : Submodule.span (ZMod 2)
      {w | ∃ (g : actionImage (σ.comp ((Stellmacher.elementaryAbelianMaxJ C).map q).subtype))
        (v : W), v ∈ P ∧
        imageRepresentation (σ.comp ((Stellmacher.elementaryAbelianMaxJ C).map q).subtype)
          g v = w} = ⊤) :
    let I := (Stellmacher.elementaryAbelianMaxJ C).map q
    let δ := imageRepresentation (σ.comp I.subtype)
    let N := offenderSubgroup δ
    RankOneModel (δ.comp N.subtype) ∨ (IsQuasisimple (generalizedFitting N) ∧
      Nonempty (ProjectiveLine.QuasisimpleSourceConclusion (δ.comp N.subtype)
        (generalizedFitting N))) := by
  let I := (Stellmacher.elementaryAbelianMaxJ C).map q
  have hAI : A.map q ≤ I := map_mono (le_sSup hA)
  have hff : IsFFModule (σ.comp I.subtype) := ⟨_, hordinary.subgroupOf σ hAI⟩
  exact image_offenderCore_model_or_full_quasisimple classify (σ.comp I.subtype)
    hff hodd hker hr S P hfix hspan (actionImage_sqtkCover hG q hq I σ)

/-- Complete model selection for N = J(image(σ|I),W), where I is the
literal original Thompson image. The ordinary maximum image supplies the
required nontrivial offender; no best-generation assumption on I is used. -/
theorem thompson_image_model
    {K : GroupClass.{u}} (classify : AdequateClassificationInput.{u,u} K)
    (hG : IsSQTK K G) (C : Subgroup G) (q : G →* H) (hq : Function.Surjective q)
    (σ : Representation (ZMod 2) H W)
    (A : Subgroup G) (hA : A ∈ Stellmacher.elementaryAbelianMaxSubgroups C)
    (hordinary : IsOffender σ (A.map q))
    (hodd : Odd (Nat.card (actionHom
      (σ.comp ((Stellmacher.elementaryAbelianMaxJ C).map q).subtype)).ker))
    (hker : Nat.Coprime 3 (Nat.card (actionHom
      (σ.comp ((Stellmacher.elementaryAbelianMaxJ C).map q).subtype)).ker))
    (hr : primeRank 3 ((Stellmacher.elementaryAbelianMaxJ C).map q) ≤ 1)
    (S : Sylow 2 (actionImage (σ.comp ((Stellmacher.elementaryAbelianMaxJ C).map q).subtype)))
    (P : Submodule (ZMod 2) W)
    (hfix : P ≤ fixedSpace
      (imageRepresentation (σ.comp ((Stellmacher.elementaryAbelianMaxJ C).map q).subtype)) S)
    (hspan : Submodule.span (ZMod 2)
      {w | ∃ (g : actionImage (σ.comp ((Stellmacher.elementaryAbelianMaxJ C).map q).subtype))
        (v : W), v ∈ P ∧
        imageRepresentation (σ.comp ((Stellmacher.elementaryAbelianMaxJ C).map q).subtype)
          g v = w} = ⊤) :
    let I := (Stellmacher.elementaryAbelianMaxJ C).map q
    let δ := imageRepresentation (σ.comp I.subtype)
    let N := offenderSubgroup δ
    RankOneModel (δ.comp N.subtype) := by
  let I := (Stellmacher.elementaryAbelianMaxJ C).map q
  have hAI : A.map q ≤ I := map_mono (le_sSup hA)
  have hff : IsFFModule (σ.comp I.subtype) := ⟨_, hordinary.subgroupOf σ hAI⟩
  exact image_offenderCore_model classify (σ.comp I.subtype)
    hff hodd hker hr S P hfix hspan (actionImage_sqtkCover hG q hq I σ)

end ThompsonImage
end CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.Offenders.BestReduction.FullCoreTransfer.RankOneDispatch
