module
public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.LineNormalizers.Offenders.BestReduction.FullCoreTransfer.Source
public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.LineNormalizers.Offenders.Replacement.Marked

/-!
# Application to Replacement's constructed marked first summand

Instantiate the full-core transfer on OriginalData.pairedRepresentation and
the literal fixed image of τ in U/E. OriginalData supplies the paired
surjection, its exact action kernel and the temporary quotient product;
none is replaced by a representation tag or an isomorphic unmarked module.

The transvection package and geometry have their existing producer in
Replacement.temporaryData_of_original and Replacement.fixedGeometry_of_original.
They are explicit here to keep this module independent of that umbrella.
The earlier marker, Sylow and maximum-family facts remain with the Offenders
assembly; the universal B.5 classifier remains with BestReduction.

Source: Aschbacher–Smith, proof of 15.3.67, printed pp.1153–1154
(combined manuscript of 1 March 2004).
-/

public section
open Subgroup Representation.BinaryOffender
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.Offenders.BestReduction.FullCoreTransfer
open Replacement.Transvections ChapterB.SourceInduction
universe u
variable {G L : Type u} [Group G] [Finite G] [Group L]

/-- The exact original marked first summand is best-generated by the same
temporary Thompson image. The paired kernel and product are discharged. -/
theorem marked_thompson_image_generated
    {K : GroupClass.{u}} (classify : AdequateClassificationInput.{u,u} K)
    {Y T V M E Pc : Subgroup G} [IsMulCommutative V]
    (d : Replacement.Geometry.OriginalData Y T V M E Pc)
    (dt : TemporaryData Y T V E)
    (hG : IsSQTK K (temporaryLineNormalizer T V E))
    (Z : Subgroup G) (hZV : Z ≤ V)
    (hZ : Nat.Coprime 3 (Nat.card (normalizer (Z : Set G))))
    (f : temporaryLineNormalizer T V E →* L) (hf : Function.Surjective f)
    (hker : f.ker = centralizer
      (Replacement.Transvections.localSpan T V E : Set (temporaryLineNormalizer T V E)))
    (geom : letI := d.module_normal
      letI := d.module_elementary
      FixedGeometry (localRepresentation T V E f hf hker)
        (f dt.tau) (f dt.conjugator) (localLineSpace T V E))
    (hcompare : ∃ B ∈ Stellmacher.elementaryAbelianMaxSubgroups
      ((lineT T E).subgroupOf (temporaryLineNormalizer T V E)), B ≤ localCentralizer T V E)
    (S : Sylow 2 ((localCentralizer T V E).map (QuotientGroup.mk' (localCore T V E))))
    (hST : (S : Subgroup _).map ((localCentralizer T V E).map
      (QuotientGroup.mk' (localCore T V E))).subtype ≤
        ((lineT T E).subgroupOf (temporaryLineNormalizer T V E)).map
          (QuotientGroup.mk' (localCore T V E))) :
    letI := d.module_normal
    letI := d.module_elementary
    let σ := d.pairedRepresentation f hf hker
    ∀ P : Submodule (ZMod 2)
      (Replacement.MarkedSection.fixedImage (Replacement.Transvections.localSpan T V E)
        (localLine T V E) d.tau),
    P ≤ fixedSpace σ ((S : Subgroup _).map
      ((localCentralizer T V E).map (QuotientGroup.mk' (localCore T V E))).subtype) →
    Submodule.span (ZMod 2)
      {w | ∃ (g : thompsonImage T V E) (v : _), v ∈ P ∧ σ g v = w} = ⊤ →
    (∀ x ∈ localCentralizer T V E,
      QuotientGroup.mk' (localCore T V E) x ∈ thompsonImage T V E →
      (∀ w ∈ P, σ (QuotientGroup.mk' (localCore T V E) x) w = w) →
        ∀ v ∈ V.subgroupOf (temporaryLineNormalizer T V E), ⁅x, v⁆ ∈ localLine T V E) →
    offenderSubgroup (σ.comp (thompsonImage T V E).subtype) = ⊤ := by
  let := d.module_normal
  let := d.module_elementary
  dsimp only
  intro P hfix hspan hmarker
  exact temporary_thompson_image_generated classify Y T V E Z dt hG hZV hZ
    f hf hker geom (d.pairedRepresentation f hf hker) (d.pairedSection f hf hker)
    (d.pairedRepresentation_centralizer_ker f hf hker) hcompare
    d.markedQuotientFactors.equiv S hST P hfix hspan hmarker

end CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.Offenders.BestReduction.FullCoreTransfer
