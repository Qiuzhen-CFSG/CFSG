module

public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.LineNormalizers.Offenders.Replacement.Marked.Kernel
public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.LineNormalizers.Offenders.Replacement.Core

/-!
# The marked product and span after replacement

The original natural action proves the residual section-kernel bound.
Consequently both `Y_E` and the original marked `τ ∈ T_E` belong to `H`.
Intersecting the original literal product with `H` gives
`H = ⟨Y_E,τ⟩ C_H(E)`. Since the marked subgroup normalizes `V`, the
unchanged module `V_E` is generated by its `C_H(E)`-conjugates.

The inputs are the original action, Sylow subgroup and marked product;
no temporary product, span or core equality is assumed.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), proof of
15.3.67, printed p.1153, PDF p.1170.
-/

@[expose] public section
open Subgroup Stellmacher OrthogonalFourBinary OrthogonalFourBinary.TerminalLines
open scoped commutatorElement Pointwise IsMulCommutative

namespace CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.Offenders.Replacement
variable {G : Type*} [Group G]

/-- Restrict the original literal product to the temporary subgroup. -/
theorem temporary_product_of_original_product (T V E A : Subgroup G)
    (hAH : A ≤ temporaryLineNormalizer T V E)
    (hprod : (lineNormalizer E : Set G) =
      (A : Set G) * (centralizer (E : Set G) : Set G)) :
    (temporaryLineNormalizer T V E : Set G) =
      (A : Set G) * (temporaryCentralizer T V E : Set G) := by
  apply Set.Subset.antisymm
  · intro h hh
    have hp : h ∈ (A : Set G) * (centralizer (E : Set G) : Set G) :=
      hprod ▸ hh.1
    obtain ⟨a, ha, c, hc, hac⟩ := hp
    have hcH : c ∈ temporaryLineNormalizer T V E := by
      have hx := (temporaryLineNormalizer T V E).mul_mem
        ((temporaryLineNormalizer T V E).inv_mem (hAH ha)) hh
      rwa [← hac, inv_mul_cancel_left] at hx
    exact ⟨a, ha, c, ⟨hcH, hc⟩, hac⟩
  · rintro _ ⟨a, ha, c, hc, rfl⟩
    exact (temporaryLineNormalizer T V E).mul_mem (hAH ha) hc.1

/-- The original module is generated by the smaller centralizer's conjugates. -/
theorem lineV_eq_temporaryCentralizer_span [Finite G] (T V E A : Subgroup G)
    [IsMulCommutative V] (hEV : E ≤ V)
    (P : Sylow 2 (lineNormalizer E))
    (hP : (P : Subgroup (lineNormalizer E)).map (lineNormalizer E).subtype = lineT T E)
    (hAV : A ≤ normalizer (V : Set G))
    (hprod : (temporaryLineNormalizer T V E : Set G) =
      (A : Set G) * (temporaryCentralizer T V E : Set G)) :
    lineV V E = conjugateSpanBy V (temporaryCentralizer T V E) := by
  rw [lineV_eq_temporary_span T V E hEV P hP]
  apply le_antisymm
  · apply (closure_le _).mpr
    rintro _ ⟨g, hg, v, hv, rfl⟩
    have hi : g⁻¹ ∈ (A : Set G) * (temporaryCentralizer T V E : Set G) := by
      rw [← hprod]
      exact (temporaryLineNormalizer T V E).inv_mem hg
    obtain ⟨a, ha, c, hc, hac⟩ := hi
    have he : g = c⁻¹ * a⁻¹ := by simpa only [mul_inv_rev, inv_inv] using
      (congrArg Inv.inv hac).symm
    have hv' : a⁻¹ * v * a ∈ V := by
      simpa only [inv_inv, SetLike.mem_coe] using (hAV (A.inv_mem ha) v).mp hv
    apply Subgroup.subset_closure
    refine ⟨c⁻¹, (temporaryCentralizer T V E).inv_mem hc, a⁻¹ * v * a, hv', ?_⟩
    rw [he]
    group
  · exact conjugateSpanBy_mono le_rfl inf_le_left

open GoldschmidtCore.LocalRelations GoldschmidtCore.LocalRelations.OrthogonalProducts
variable [Finite G] {V M : Subgroup G}

/-- Marked membership, product and span, from the original natural action and product. -/
theorem marked_group_inheritance (d : NaturalAction V M) (Y T E : Subgroup G)
    [IsMulCommutative V]
    (hYM : Y ≤ M) (hEV : E ≤ V) (hcard : Nat.card E = 4)
    (hs : ∀ e : E, d.singular ⟨e, hEV e.property⟩)
    (himage : actionImage d Y = pResidual 2 IsometryGroup)
    (hYcore : twoCoreAmbient Y = Y ⊓ centralizer (V : Set G))
    (hY : lineNormalizer E ≤ normalizer (lineY Y E : Set G))
    (P : Sylow 2 (lineNormalizer E))
    (hP : (P : Subgroup (lineNormalizer E)).map (lineNormalizer E).subtype = lineT T E)
    (hQK : lineQ E ≤ Descent.sectionKernel V E)
    (τ : G) (hτ : τ ∈ lineT T E) (hτM : τ ∈ M)
    (hprod : (lineNormalizer E : Set G) =
      ((lineY Y E ⊔ zpowers τ : Subgroup G) : Set G) * (centralizer (E : Set G) : Set G)) :
    τ ∈ temporaryLineNormalizer T V E ∧
      lineY Y E ≤ temporaryLineNormalizer T V E ∧
      (temporaryLineNormalizer T V E : Set G) =
        ((lineY Y E ⊔ zpowers τ : Subgroup G) : Set G) * (temporaryCentralizer T V E : Set G) ∧
      lineV V E = conjugateSpanBy V (temporaryCentralizer T V E) := by
  have hτH := lineT_le_temporary T V E hEV hτ
  have hYH := lineY_le_temporary Y T V E hEV P hP hY hQK
    (lineY_inf_sectionKernel_le_lineQ d Y E hYM hEV hcard hs himage hYcore hY)
  have hAH : lineY Y E ⊔ zpowers τ ≤ temporaryLineNormalizer T V E :=
    sup_le hYH (zpowers_le.mpr hτH)
  have hp := temporary_product_of_original_product T V E _ hAH hprod
  have hAV : lineY Y E ⊔ zpowers τ ≤ normalizer (V : Set G) :=
    (sup_le ((lineY_le Y E).trans (inf_le_left.trans hYM)) (zpowers_le.mpr hτM)).trans
      d.normalizes
  exact ⟨hτH, hYH, hp, lineV_eq_temporaryCentralizer_span T V E _ hEV P hP hAV hp⟩

/-- The original marked action discharges the missing kernel premise in the
replacement-core theorem. All remaining hypotheses precede replacement. -/
theorem temporaryCore_eq_of_original_action (d : NaturalAction V M) (Y T E : Subgroup G)
    [IsMulCommutative V]
    (hYM : Y ≤ M) (hEV : E ≤ V) (hcard : Nat.card E = 4)
    (hs : ∀ e : E, d.singular ⟨e, hEV e.property⟩)
    (himage : actionImage d Y = pResidual 2 IsometryGroup)
    (hYcore : twoCoreAmbient Y = Y ⊓ centralizer (V : Set G))
    (hY : lineNormalizer E ≤ normalizer (lineY Y E : Set G))
    (hVT : V ≤ lineT T E) (P : Sylow 2 (lineNormalizer E))
    (hP : (P : Subgroup (lineNormalizer E)).map (lineNormalizer E).subtype = lineT T E)
    (hQK : lineQ E ≤ Descent.sectionKernel V E)
    (hlocal : (lineY Y E ⊔ lineT T E).pCoreIn 2 ≤ T ⊓ centralizer (E : Set G))
    (hcomm : ⁅V, T ⊓ centralizer (E : Set G)⁆ ≤ E) :
    temporaryCore T V E = lineQuotientCentralizer T V E :=
  temporaryCore_eq_quotientCentralizer Y T V E hEV hVT P hP hY hQK
    (lineY_inf_sectionKernel_le_lineQ d Y E hYM hEV hcard hs himage hYcore hY)
    hlocal hcomm

end CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.Offenders.Replacement
