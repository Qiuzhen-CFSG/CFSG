module
public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.WeakClosureBounds.GenerationOne.RepresentationReduction.SourceRestrictions.Cases.Single.LocalSetup
public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.WeakClosureBounds.GenerationOne.RepresentationReduction.SourceRestrictions.Cases.Single.CentralComparison
public import Theory.GroupTheory.PGroup.NormalDirectPowerSection
public import Theory.GroupTheory.CComponent.QuotientLifting
public import Theory.Quasithin.Rank
public import Theory.GroupTheory.PerfectCentralCover

/-!
# Group preparation and kernel restrictions for the single actor

For the local input on printed p.1152, K is normal in H because T normalizes
its own conjugate span. Subnormal p-core intersection identifies its image
A in D=H/O₂(H) with K/O₂(K). Odd-prime rank descends through O₂(H), and
D/A is generated by the image of the Sylow two-group.

The actual central covering A → KJ/J has kernel Z(A). Its center has odd
order since O₂(A)=1, and its order divides |M∩H|. Thus the three-prime
hypothesis also excludes a three-center. The final collapse lemma still
requires a model covering calculation restricting the remaining primes;
no such calculation is included in LocalInput or asserted here.

Source: Aschbacher--Smith, combined manuscript (1 March 2004), E.2.2,
printed pp.215--216, and the proof of 15.3.65, printed p.1152.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.RepresentationReduction.SourceRestrictions.Cases.Single
open BorelReduction
namespace CoverModels
universe u
variable {G : Type u} [Group G] [Finite G]
variable {𝒦 : GroupClass.{u}} {H M K T Z ZS : Subgroup G} {f : ℕ}
variable [IsElementaryAbelian 2 (conjugateSpanBy ZS H)]
variable {a : LocalQuotientAction H (conjugateSpanBy ZS H) Z}
variable {I : Submodule (ZMod 2)
  (Additive ((conjugateSpanBy ZS H) ⧸ Z.subgroupOf (conjugateSpanBy ZS H)))}
variable (h : LocalInput 𝒦 H M K T Z ZS f a I)
include h

theorem component_normal : (K.subgroupOf H).Normal := by
  apply normal_subgroupOf_of_le_normalizer
  rw [h.source.generated]
  apply sup_le K.le_normalizer
  rw [← h.single]
  exact le_normalizer_conjugateSpanBy K T

theorem actor_normal : (actorImage H K).Normal := by
  let := component_normal h
  exact Normal.map inferInstance _ (QuotientGroup.mk'_surjective _)

def intrinsicActorEquiv : (K ⧸ pCore 2 K) ≃* actorImage H K :=
  (QuotientGroup.congr (pCore 2 (K.subgroupOf H)) (pCore 2 K)
    (subgroupOfEquivOfLe h.source.component_le)
    (pCore_map_iso 2 (subgroupOfEquivOfLe h.source.component_le))).symm.trans
      (h.source.component.subnormal.quotientCoreImageEquiv 2)

theorem intrinsicActorEquiv_mk (k : K) :
    (intrinsicActorEquiv h (QuotientGroup.mk' (pCore 2 K) k) : H ⧸ pCore 2 H) =
      QuotientGroup.mk' (pCore 2 H) ⟨k.val, h.source.component_le k.property⟩ := by
  rfl

theorem actor_quasisimple : IsQuasisimple (actorImage H K) := by
  let := h.source.quasisimple
  exact IsQuasisimple.of_mulEquiv (intrinsicActorEquiv h)

theorem actor_sqtk : IsSQTK 𝒦 (H ⧸ pCore 2 H) := by
  refine ⟨?_, h.local_sqtk.isKGroup.quotient _⟩
  intro p hp ho
  let : Fact p.Prime := ⟨hp⟩
  exact (primeRank_quotient_le_of_isTwoGroup p ho _ pCore_isPGroup).trans
    (h.local_sqtk.stronglyQuasithin p hp ho)

theorem sylow_twoGroup : IsPGroup 2 T := by
  obtain ⟨S, he⟩ := h.sylow
  exact he ▸ S.isPGroup'.map H.subtype

theorem actor_sup_sylow : actorImage H K ⊔ actorImage H T = ⊤ := by
  have hTH : T ≤ H := h.source.generated ▸ le_sup_right
  rw [actorImage, actorImage, ← Subgroup.map_sup, ← subgroupOf_sup h.source.component_le hTH,
    ← h.source.generated, subgroupOf_self]
  exact Subgroup.map_top_of_surjective _ (QuotientGroup.mk'_surjective _)

theorem actor_quotient_twoGroup :
    let := actor_normal h
    IsPGroup 2 ((H ⧸ pCore 2 H) ⧸ actorImage H K) := by
  let := actor_normal h
  exact isPGroup_quotient_of_sup_eq_top _ (actorImage H T)
    ((sylow_twoGroup h).comap_subtype.map _) (actor_sup_sylow h)

theorem actor_twoCore : pCore 2 (actorImage H K) = ⊥ := by
  have hs : (actorImage H K).IsSubnormal :=
    h.source.component.subnormal.map (QuotientGroup.mk'_surjective _)
  rw [← hs.pCore_subgroupOf 2, pCore_quotient_pCore_eq_bot, bot_subgroupOf]


theorem center_order_dvd_overlap :
    Nat.card (center (actorImage H K)) ∣ Nat.card (M ⊓ H : Subgroup G) := by
  have hc := (single_source_cases h.source.cases h.single).1
  have hle : (center (actorImage H K)).map (actorImage H K).subtype ≤
      actorImage H (M ⊓ H) := by
    rw [← hc.kernel_center]
    apply map_mono
    intro x hx
    exact ⟨(M.subgroupOf H).normalCore_le hx, x.property⟩
  have hd := (card_dvd_of_le hle).trans (card_actorImage_dvd (H := H) inf_le_right)
  rwa [card_map_of_injective (actorImage H K).subtype_injective] at hd

theorem center_no_three : ¬ 3 ∣ Nat.card (center (actorImage H K)) :=
  fun hd => h.noThree (hd.trans (center_order_dvd_overlap h))

theorem center_no_two : ¬ 2 ∣ Nat.card (center (actorImage H K)) := by
  intro hd
  obtain ⟨z, hz⟩ := exists_prime_orderOf_dvd_card' (G := center (actorImage H K)) 2 hd
  have hc : zpowers (z : actorImage H K) ≤ center (actorImage H K) :=
    zpowers_le.mpr z.property
  let : (zpowers (z : actorImage H K)).Normal := ⟨by
    intro x hx g
    have he := mem_center_iff.mp (hc hx) g
    simpa only [he, mul_inv_cancel_right] using hx⟩
  have hp : IsPGroup 2 (zpowers (z : actorImage H K)) := by
    apply IsPGroup.of_card (n := 1)
    simpa only [Nat.card_zpowers, Subgroup.orderOf_coe, pow_one] using hz
  have hle : zpowers (z : actorImage H K) ≤ pCore 2 (actorImage H K) :=
    le_sSup ⟨inferInstance, hp⟩
  rw [actor_twoCore h] at hle
  have he : (z : actorImage H K) = 1 := hle (mem_zpowers _)
  have hez : z = 1 := Subtype.ext he
  simp only [hez, orderOf_one] at hz
  omega

/-- Once a model's covering calculation bounds the prime divisors of the
center by two and three, the local core and overlap hypotheses kill it. -/
theorem center_eq_bot_of_prime_support
    (hcover : ∀ p : ℕ, p.Prime → p ∣ Nat.card (center (actorImage H K)) →
      p = 2 ∨ p = 3) : center (actorImage H K) = ⊥ := by
  apply card_eq_one.mp
  apply Nat.eq_one_iff_not_exists_prime_dvd.mpr
  intro p hp hd
  rcases hcover p hp hd with rfl | rfl
  · exact center_no_two h hd
  · exact center_no_three h hd

/-- The E.2.2 kernel collapses when its entire component center does. -/
theorem sourceKernel_eq_twoCore_of_center_eq_bot
    (hz : center (actorImage H K) = ⊥) : sourceKernel H M = pCore 2 H := by
  apply le_antisymm _ h.source.core_le
  have hc := (single_source_cases h.source.cases h.single).1
  have he : (sourceKernel H M).map (QuotientGroup.mk' (pCore 2 H)) = ⊥ := by
    rw [hc.kernel_center, hz, Subgroup.map_bot]
  simpa only [QuotientGroup.ker_mk'] using (Subgroup.map_eq_bot_iff _).mp he


/-- The actual actor is a perfect central cover of its source image. -/
def componentCover : PerfectCentralCovering.Cover (actorImage H K) (sourceImage H M K) where
  toMonoidHom := componentToSource h.source.core_le
  surjective := componentToSource_surjective h.source.core_le
  isPerfect := (actor_quasisimple h).toIsPerfect
  ker_le_center := (componentToSource_ker h.source.core_le
    (single_source_cases h.source.cases h.single).1).le

theorem componentCover_ker :
    (componentCover h).toMonoidHom.ker = center (actorImage H K) :=
  componentToSource_ker h.source.core_le (single_source_cases h.source.cases h.single).1

/-- Compose with a genuine E.2.2 model identification, retaining the same
center as kernel. This is the input to the concrete covering calculations. -/
def modelCover {X : Type*} [Group X] (e : sourceImage H M K ≃* X) :
    PerfectCentralCovering.Cover (actorImage H K) X where
  toMonoidHom := e.toMonoidHom.comp (componentCover h).toMonoidHom
  surjective := e.surjective.comp (componentCover h).surjective
  isPerfect := (componentCover h).isPerfect
  ker_le_center := by
    intro x hx
    apply (componentCover h).ker_le_center
    exact e.injective (hx.trans e.map_one.symm)

theorem modelCover_ker {X : Type*} [Group X] (e : sourceImage H M K ≃* X) :
    (modelCover h e).toMonoidHom.ker = center (actorImage H K) := by
  rw [← componentCover_ker h]
  ext x
  exact e.injective.eq_iff' e.map_one

/-- The image of the actual Sylow subgroup is Sylow in the actor quotient. -/
theorem actor_sylow : ∃ S : Sylow 2 (H ⧸ pCore 2 H),
    (S : Subgroup (H ⧸ pCore 2 H)) = actorImage H T := by
  obtain ⟨S, he⟩ := h.sylow
  refine ⟨S.mapSurjective (QuotientGroup.mk'_surjective (pCore 2 H)), ?_⟩
  change (S : Subgroup H).map (QuotientGroup.mk' (pCore 2 H)) =
    (T.subgroupOf H).map (QuotientGroup.mk' (pCore 2 H))
  congr 1
  apply Subgroup.map_injective H.subtype_injective
  rw [map_subgroupOf_eq_of_le (h.source.generated ▸ le_sup_right)]
  exact he

/-- The ordinary component used by the section-action theorems. -/
theorem actor_component : IsComponent (H ⧸ pCore 2 H) (actorImage H K) :=
  ⟨h.source.component.subnormal.map (QuotientGroup.mk'_surjective _), actor_quasisimple h⟩


end CoverModels
end CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.RepresentationReduction.SourceRestrictions.Cases.Single
