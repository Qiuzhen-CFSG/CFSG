public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.WeakClosureBounds.GenerationOne.RepresentationReduction.SourceRestrictions.Cases.Ratios
public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.WeakClosureBounds.GenerationOne.RepresentationReduction.SourceRestrictions.ModuleIdentifications
public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.WeakClosureBounds.GenerationOne.Setup

/-!+# Source module cases: section and numerical preparation

This module connects the literal local quotient U/Z, U=⟨ZS^H⟩, to the
homogeneous orbit-section development. Equivariant model identifications
of quotient images give identifications of the central quotients by the
proved canonical map. The quadratic bound supplies a cubic actor without
identifying the two action ratios.

The deduction of the three module cases is still open. It must reconcile
the full F.9.18(4),(5) alternatives and B.4.2/B.4.5 outputs with the actual
E.2.2 models, preserving the central covers, Borel maps, and induced diagram
actions. Neither a filtered list nor FF exclusions are asserted here.

The source assembly must supply: the chosen T-homogeneous Irr⁺ section
(A.1.42); the residual-orbit and actor-generation identities; the full
F.9.18(4),(5) outputs on that section; and B.4.2/B.4.5 on the actual finite
faithful section images, with their SQTK, quasisimple generalized Fitting,
irreducibility and numerical hypotheses. For B.4.2 the best offender must
be supplied or obtained from the proved FF-to-best-offender implication.
Model comparisons and compatible Borel/diagram witnesses remain required.

Source: Aschbacher--Smith, combined manuscript (1 March 2004), 15.3.65,
printed p.1152; F.9.18(4),(5), pp.325--326; B.4.2/B.4.5, pp.86--87.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.RepresentationReduction.SourceRestrictions.Cases
open Representation Representation.BinaryOffender Subgroup
open scoped IsMulCommutative

/-- An identification of the image in V/C_V(K) produces an identification
of the literal I/C_I(K), using the same group equivalence. -/
noncomputable def identificationOfQuotientImage
    {D E V X : Type*} [Group D] [Group E]
    [AddCommGroup V] [Module (ZMod 2) V] [AddCommGroup X] [Module (ZMod 2) X]
    (ρ : Representation (ZMod 2) D V) (K : Subgroup D)
    (I : Submodule (ZMod 2) V) (hI : K ≤ subspaceStabilizer ρ I)
    (σ : Representation (ZMod 2) E X) (φ : K ≃* E)
    (e : I.map (fixedSpace ρ K).mkQ ≃ₗ[ZMod 2] X)
    (he : ∀ g v, e ((quotientImage ρ K I hI).toRepresentation g v) =
      σ (φ g) (e v)) : CentralQuotientIdentification ρ K I hI σ where
  groupEquiv := φ
  linearEquiv := (centralQuotientImageEquiv ρ K I).trans e
  equivariant g v := by
    change e (centralQuotientImageEquiv ρ K I
      (centralQuotientRepresentation ρ K I hI g v)) = _
    rw [centralQuotientImageEquiv_equivariant]
    exact he g (centralQuotientImageEquiv ρ K I v)

section Local
variable {G : Type*} [Group G] [Finite G] {H Z ZS : Subgroup G}
    [IsElementaryAbelian 2 (conjugateSpanBy ZS H)]

/-- The quadratic bound on the literal local module supplies an actual
cubic elementary actor. It does not assert faithfulness on a section. -/
theorem local_cubic_actor
    (a : LocalQuotientAction H (conjugateSpanBy ZS H) Z)
    (hq : quadraticRatio a.representation ≤ 2) :
    ∃ A : Subgroup (H ⧸ pCore 2 H), IsElementaryTwo A ∧
      IsCubic a.representation A ∧ actionRatio a.representation A ≤ 2 :=
  (cubicRatio_le_iff a.representation (by simp)).mp
    ((cubicRatio_le_quadraticRatio a.representation).trans hq)

omit [Finite G] in
/-- The homogeneous orbit in the literal U/Z is a nonzero subrepresentation
generated by its residual commutators. Actor generation is the separate,
proved residual/Sylow calculation in `actorImage_residual_sup_sylow`. -/
theorem local_homogeneous_orbit
    (a : LocalQuotientAction H (conjugateSpanBy ZS H) Z) (T : Subgroup G)
    (I : Submodule (ZMod 2) (Additive ((conjugateSpanBy ZS H) ⧸
      Z.subgroupOf (conjugateSpanBy ZS H))))
    (hI : IsIrrPlusWith a.representation (actorImage H (residual H)) (actorImage H T) I)
    (hgen : actorImage H (residual H) ⊔ actorImage H T = ⊤) :
    ∃ W : Subrepresentation a.representation,
      W.toSubmodule = orbitSpan a.representation (actorImage H T) I ∧
      W.toSubmodule ≠ ⊥ ∧
      subspaceCommutator a.representation W.toSubmodule
        (actorImage H (residual H)) = W.toSubmodule := by
  refine ⟨orbitSubrepresentation a.representation hI.normalizes hI.isIrrPlus hgen,
    rfl, ?_, ?_⟩
  · exact orbitSpan_ne_bot a.representation hI.isIrrPlus
  · exact orbitSpan_full_commutator a.representation hI.normalizes hI.isIrrPlus

end Local
end CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.RepresentationReduction.SourceRestrictions.Cases
