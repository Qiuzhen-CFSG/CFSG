module

public import Theory.Representation.BinaryOffender.EquivariantOffender
public import Theory.Representation.BinaryOffender.StableSaturation
public import Theory.PGroupCore

/-!
# Restriction to the offender-generated subgroup

B.5.1 requires the acting group to equal J(G,V). Restriction to the actual
subgroup generated by all best offenders has this property, preserves
faithfulness and both FF properties, and inherits a trivial two-core.
The strong case first replaces a strong offender by a strong best offender;
an arbitrary strong offender need not itself be contained in J(G,V).

These reductions do not assert the generalized-Fitting hypotheses of B.5.1.
Those must be established in each model and component case.

Source: Aschbacher--Smith, combined manuscript (1 March 2004), B.1.4,
printed pp.68--69, and B.5.1, pp.99--100.
-/

@[expose] public section

open Subgroup Representation Representation.BinaryOffender
namespace CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.RepresentationReduction.SourceRestrictions.FFExclusions
variable {D V : Type*} [Group D] [AddCommGroup V] [Module (ZMod 2) V]
    (ρ : Representation (ZMod 2) D V)

/-- Injective change of actors and an equivariant linear equivalence preserve strong offending. -/
theorem strongFF_map_equivariant
    {E X : Type*} [Group E] [AddCommGroup X] [Module (ZMod 2) X]
    (σ : Representation (ZMod 2) E X) (f : D →* E) (hf : Function.Injective f)
    (e : V ≃ₗ[ZMod 2] X) (he : ∀ g v, e (ρ g v) = σ (f g) (e v))
    (h : IsStrongFFModule ρ) : IsStrongFFModule σ := by
  obtain ⟨A, hA, hstrict⟩ := h
  have hweak : IsOffender ρ A := ⟨hA, hstrict.le⟩
  refine ⟨A.map f, (hweak.map_equivariant ρ σ f hf e he).1, ?_⟩
  rw [← fixedCodim_map_equivariant ρ σ f e he, rank_map_injective f hf]
  exact hstrict

/-- Each best offender lies in the actual offender-generated subgroup. -/
theorem bestOffender_le_generated {A : Subgroup D} (hA : IsBestOffender ρ A) :
    A ≤ offenderSubgroup ρ := le_generatedBy_top_of_mem hA

/-- Restriction to J(G,V) satisfies the generation hypothesis required by B.5.1. -/
theorem offenderSubgroup_restriction :
    offenderSubgroup (ρ.comp (offenderSubgroup ρ).subtype) = ⊤ := by
  apply Subgroup.map_injective (offenderSubgroup ρ).subtype_injective
  rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]
  apply le_antisymm (by simpa only [Subgroup.range_subtype] using
    (Subgroup.map_le_range (offenderSubgroup ρ).subtype
      (offenderSubgroup (ρ.comp (offenderSubgroup ρ).subtype))))
  refine iSup_le fun A => iSup_le fun hA => ?_
  have hAJ := bestOffender_le_generated ρ hA.1
  have hle := bestOffender_le_generated (ρ.comp (offenderSubgroup ρ).subtype)
    (hA.1.subgroupOf ρ hAJ)
  have hm := Subgroup.map_mono (f := (offenderSubgroup ρ).subtype) hle
  rwa [Subgroup.map_subgroupOf_eq_of_le hAJ] at hm

/-- Restriction preserves the given faithful action on the same module. -/
theorem offenderSubgroup_restriction_faithful (hρ : Function.Injective ρ) :
    Function.Injective (ρ.comp (offenderSubgroup ρ).subtype) :=
  hρ.comp (offenderSubgroup ρ).subtype_injective

/-- The two-core of J(G,V) vanishes if the ambient two-core does: it is characteristic in a normal subgroup. -/
theorem offenderSubgroup_twoCore (hcore : pCore 2 D = ⊥) :
    pCore 2 (offenderSubgroup ρ) = ⊥ := by
  let : (offenderSubgroup ρ).Normal := offenderSubgroup_normal ρ
  apply (Subgroup.map_eq_bot_iff_of_injective _ (offenderSubgroup ρ).subtype_injective).mp
  apply le_antisymm _ bot_le
  rw [← hcore]
  exact le_sSup ⟨inferInstance, pCore_isPGroup.map _⟩

/-- A strong offender remains strong in any overgroup containing it. -/
theorem strongOffender_subgroupOf {A H : Subgroup D}
    (hA : IsStrongOffender ρ A) (hAH : A ≤ H) :
    IsStrongOffender (ρ.comp H.subtype) (A.subgroupOf H) := by
  have hm := Subgroup.map_subgroupOf_eq_of_le hAH
  let : IsElementaryAbelian 2 A := hA.1.2
  refine ⟨⟨?_, IsElementaryAbelian.subgroupOf hAH⟩, ?_⟩
  · intro he
    exact hA.1.1 (by rw [← hm, he, Subgroup.map_bot])
  · have hr := rank_map_injective H.subtype H.subtype_injective (A.subgroupOf H)
    rw [hm] at hr
    unfold fixedCodim
    rw [fixedSpace_comp_map, hm, ← hr]
    exact hA.2

/-- A strong offender in a subgroup remains strong in the ambient actor group. -/
theorem strongOffender_map_subtype (H : Subgroup D) {A : Subgroup H}
    (hA : IsStrongOffender (ρ.comp H.subtype) A) :
    IsStrongOffender ρ (A.map H.subtype) := by
  let : IsElementaryAbelian 2 A := hA.1.2
  refine ⟨⟨?_, IsElementaryAbelian.map _⟩, ?_⟩
  · intro he
    exact hA.1.1 ((A.map_eq_bot_iff_of_injective H.subtype_injective).mp he)
  · rw [rank_map_injective H.subtype H.subtype_injective]
    change Module.finrank (ZMod 2) (V ⧸ fixedSpace ρ (A.map H.subtype)) < rank A
    rw [← fixedSpace_comp_map ρ H.subtype A]
    exact hA.2

/-- FF status is unchanged by restriction to the offender-generated subgroup. -/
theorem isFFModule_restriction_iff [Finite D] [FiniteDimensional (ZMod 2) V] :
    IsFFModule (ρ.comp (offenderSubgroup ρ).subtype) ↔ IsFFModule ρ := by
  constructor
  · intro h
    exact h.map_equivariant _ ρ (offenderSubgroup ρ).subtype
      (offenderSubgroup ρ).subtype_injective (LinearEquiv.refl _ _) (fun _ _ => rfl)
  · intro h
    obtain ⟨A, hA⟩ := (isFFModule_iff_exists_bestOffender ρ).mp h
    exact ⟨A.subgroupOf (offenderSubgroup ρ),
      (hA.subgroupOf ρ (bestOffender_le_generated ρ hA)).isOffender _⟩

/-- Strong FF status is unchanged by restriction, using strong best-offender replacement. -/
theorem isStrongFFModule_restriction_iff [Finite D] [FiniteDimensional (ZMod 2) V] :
    IsStrongFFModule (ρ.comp (offenderSubgroup ρ).subtype) ↔ IsStrongFFModule ρ := by
  constructor
  · rintro ⟨A, hA⟩
    exact ⟨_, strongOffender_map_subtype ρ _ hA⟩
  · rintro ⟨A, hA⟩
    obtain ⟨B, _, hB, hs⟩ := hA.exists_bestOffender ρ
    exact ⟨_, strongOffender_subgroupOf ρ hs (bestOffender_le_generated ρ hB)⟩
end CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.RepresentationReduction.SourceRestrictions.FFExclusions
