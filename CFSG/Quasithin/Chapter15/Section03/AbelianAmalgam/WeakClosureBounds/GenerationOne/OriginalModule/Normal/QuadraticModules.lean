module

public import Theory.Representation.BinaryOffender.QuadraticHomogeneousOrbit
public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.WeakClosureBounds.GenerationOne.OriginalModule.Normal.Filtration
public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.WeakClosureBounds.GenerationOne.OriginalModule.Normal.StableConstituentBorel
public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.WeakClosureBounds.GenerationOne.OriginalModule.Normal.Restriction

/-!
# Borel fixation from a common quadratic actor

The actual common elementary actor is joined to the normal component. On each
irreducible factor of this subgroup, the quadratic orbit argument makes the
component action irreducible or trivial. The source classifiers recognize the
surviving natural module and its marked Borel has zero fixed space. Odd-index
traces carry equality of Borel-fixed and component-fixed vectors through the
original module's invariant extensions.

This specialized route proves the fixed-space calculation used by
Aschbacher–Smith 15.3.65, printed p.1152, without a full F.9.18 classification.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.OriginalModule.Normal
open Representation Representation.BinaryOffender Subgroup Theory.GroupTheory
open RepresentationReduction.SourceRestrictions.Cases.Single.SmallRatio
open CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.RepresentationReduction
universe u
variable {D V : Type u} [Group D] [Finite D] [AddCommGroup V]
  [Module (ZMod 2) V] [Finite V]

/-- For an actual odd-field normal component, a common elementary quadratic
supplement of ratio at most two makes Borel-fixed vectors component-fixed.
The natural-module recognition is proved on the literal irreducible factors;
odd-index traces then reassemble the original action. -/
theorem fixedSpace_le_of_quadratic_supplement
    (ρ : Representation (ZMod 2) D V) (K A : Subgroup D)
    [K.Normal] [IsQuasisimple K] (hZ : center K = ⊥) (hgen : K ⊔ A = ⊤)
    (hs : IsSQTK KnownSimple.IsKnownSimple D) (hquot : IsPGroup 2 (D ⧸ K))
    (hA : IsElementaryTwo A) (hq : IsQuadratic ρ A)
    (hc : fixedCodim ρ A ≤ 2 * rank A)
    (hAC : A ⊓ centralizer (K : Set D) = ⊥)
    {f : ℕ} (hm : SourceModel (K ⧸ center K) f) (hf : 1 < f) (ho : Odd f)
    (B : Subgroup K) (hB : ∃ P : Sylow 2 K, normalizer (P : Set K) = B) :
    fixedSpace (ρ.comp K.subtype) B ≤ fixedSpace (ρ.comp K.subtype) ⊤ := by
  obtain ⟨P,hP⟩ := hB
  have hindex : Odd B.index := odd_index_of_sylow_le P B
    (hP ▸ le_normalizer)
  apply fixedSpace_le_by_quadratic_irreducibles K A B hindex ?_ ρ hq hc
  intro W _ _ _ σ hi hq hc
  let : FiniteDimensional (ZMod 2) W := Module.Finite.of_finite
  by_cases hn : (⊤ : Submodule (ZMod 2) W) ≤ fixedSpace σ K
  · intro w hw k
    exact hn Submodule.mem_top k.val
  · have hK := component_irreducible_of_quadratic_supplement σ K A hZ hgen hA hq hc hAC hi hn
    rw [fixedSpace_eq_bot_of_irreducible_component σ K hs hquot hZ hK hn
      A hA hq hc hAC hm hf ho B ⟨P,hP⟩]
    exact bot_le
end CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.OriginalModule.Normal


namespace CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.OriginalModule.Normal
open Representation Representation.BinaryOffender Subgroup Theory.GroupTheory
open RepresentationReduction.SourceRestrictions.Cases.Single.SmallRatio
universe u
variable {D V : Type u} [Group D] [Finite D] [AddCommGroup V]
  [Module (ZMod 2) V] [Finite V]

/-- Restrict to the subgroup generated by the component and the actual common
actor, keeping the original component and Borel in the conclusion. -/
theorem fixedSpace_le_of_quadratic_actor
    (ρ : Representation (ZMod 2) D V) (K A : Subgroup D)
    [K.Normal] [IsQuasisimple K] (hZ : center K = ⊥)
    (hs : IsSQTK KnownSimple.IsKnownSimple D)
    (hA : IsElementaryTwo A) (hq : IsQuadratic ρ A)
    (hc : fixedCodim ρ A ≤ 2 * rank A)
    (hAC : A ⊓ centralizer (K : Set D) = ⊥)
    {f : ℕ} (hm : SourceModel (K ⧸ center K) f) (hf : 1 < f) (ho : Odd f)
    (B : Subgroup K) (hB : ∃ P : Sylow 2 K, normalizer (P : Set K) = B) :
    fixedSpace (ρ.comp K.subtype) B ≤ fixedSpace (ρ.comp K.subtype) ⊤ := by
  let : IsQuasisimple (K.subgroupOf (K ⊔ A)) := componentInSup_quasisimple K A
  apply fixedSpace_le_of_componentInSup ρ K A B
  exact fixedSpace_le_of_quadratic_supplement (ρ.comp (K ⊔ A).subtype)
    (K.subgroupOf (K ⊔ A)) (A.subgroupOf (K ⊔ A))
    (componentInSup_center K A hZ) (componentInSup_generated K A)
    (hs.subgroup (K ⊔ A)) (componentInSup_quotient K A hA)
    (actorInSup_elementary K A hA) (actorInSup_quadratic ρ K A hq)
    (actorInSup_bound ρ K A hc) (actorInSup_faithful K A hAC)
    (componentInSup_model K A hm) hf ho (borelInSup K A B) (borelInSup_sylow K A B hB)
end CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.OriginalModule.Normal
