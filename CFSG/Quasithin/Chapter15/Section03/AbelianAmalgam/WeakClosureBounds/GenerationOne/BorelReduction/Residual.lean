module

public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.WeakClosureBounds.GenerationOne.Setup
public import Theory.GroupTheory.PResidual.NormalSubgroup
public import Theory.GroupTheory.PResidual.PerfectCover
public import Theory.GroupTheory.CComponent.Basic

/-!
# The residual generated by the component orbit

If `H = ⟨K,T⟩`, `T` is a two-group and `K` is a C-component of `H`, then
`O²(H) = ⟨K^T⟩` and `H = O²(H)T`. A perfect group has no nontrivial finite
two-group quotient, so the residual contains K and its T-conjugates.
Conversely the conjugate span is normal in H and the quotient is generated
by the image of T. All component and normality conditions are internal to H.

This supplies the residual identities used on printed p.1152 directly from
the generation clause of E.2.2; it requires no model classification.
Source: Aschbacher–Smith, combined manuscript (1 March 2004), E.2.2,
printed pp.215–216, and 15.3.65, printed p.1152.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.BorelReduction
open Subgroup
variable {G : Type*} [Group G] [Finite G]

private theorem perfect_twoPerfect {A : Type*} [Group A] [Finite A]
    [Group.IsPerfect A] : IsPPerfect 2 A := by
  intro N hN hp
  let := hN
  have hsub : Subsingleton (A ⧸ N) := by
    by_contra! hn
    exact Group.IsPerfect.not_isNilpotent (A ⧸ N) hp.isNilpotent
  apply eq_top_iff.mpr
  intro g _
  exact (QuotientGroup.eq_one_iff g).mp (Subsingleton.elim _ _)

/-- The source orbit is exactly the two-residual, not the two-core. -/
theorem residual_eq_conjugateSpanBy_of_component
    {H K T : Subgroup G} (hgen : H = K ⊔ T) (hT : IsPGroup 2 T)
    (hK : (K.subgroupOf H).IsCComponent) :
    residual H = conjugateSpanBy K T := by
  have hKH : K ≤ H := hgen ▸ le_sup_left
  have hTH : T ≤ H := hgen ▸ le_sup_right
  let C := conjugateSpanBy K T
  have hCH : C ≤ H := conjugateSpanBy_le hKH (hTH.trans H.le_normalizer)
  have hKC : K ≤ C := le_conjugateSpanBy K T
  have hTC : T ≤ normalizer (C : Set G) := le_normalizer_conjugateSpanBy K T
  have hHC : H ≤ normalizer (C : Set G) := by
    rw [hgen]
    exact sup_le (hKC.trans C.le_normalizer) hTC
  let : (C.subgroupOf H).Normal := normal_subgroupOf_of_le_normalizer hHC
  have hsup : C ⊔ T = H := le_antisymm (sup_le hCH hTH)
    (by rw [hgen]; exact sup_le (hKC.trans le_sup_left) le_sup_right)
  have hquot : IsPGroup 2 (H ⧸ C.subgroupOf H) := by
    apply isPGroup_quotient_of_sup_eq_top _ (T.subgroupOf H) hT.comap_subtype
    rw [← subgroupOf_sup hCH hTH, hsup, subgroupOf_self]
  apply le_antisymm
  · have hres : pResidual 2 H ≤ C.subgroupOf H := sInf_le ⟨inferInstance, hquot⟩
    simpa only [residual, C, map_subgroupOf_eq_of_le hCH] using (map_mono (f := H.subtype) hres)
  · let := hK.perfect
    have hKR : K ≤ residual H := by
      have h := le_pResidual_of_isPPerfect (K.subgroupOf H) perfect_twoPerfect
      simpa only [residual, map_subgroupOf_eq_of_le hKH] using (map_mono (f := H.subtype) h)
    have hn : H ≤ normalizer (residual H : Set G) := by
      apply (normal_subgroupOf_iff_le_normalizer (residual_le H)).mp
      apply normal_embedded_pResidual_subgroupOf 2 (le_refl H)
      rw [subgroupOf_self]
      infer_instance
    exact conjugateSpanBy_le hKR (hTH.trans hn)

/-- The residual and T generate H. -/
theorem residual_sup_of_component
    {H K T : Subgroup G} (hgen : H = K ⊔ T) (hT : IsPGroup 2 T)
    (hK : (K.subgroupOf H).IsCComponent) : residual H ⊔ T = H := by
  apply le_antisymm (sup_le (residual_le H) (hgen ▸ le_sup_right))
  rw [residual_eq_conjugateSpanBy_of_component hgen hT hK, hgen]
  exact sup_le_sup_right (le_conjugateSpanBy K T) T

open scoped Pointwise in
/-- The generated product is also the literal setwise product O²(H)T. -/
theorem residual_mul_of_component
    {H K T : Subgroup G} (hgen : H = K ⊔ T) (hT : IsPGroup 2 T)
    (hK : (K.subgroupOf H).IsCComponent) :
    (H : Set G) = (residual H : Set G) * (T : Set G) := by
  rw [← coe_mul_of_right_le_normalizer_left _ _
    (residual_eq_conjugateSpanBy_of_component hgen hT hK ▸ le_normalizer_conjugateSpanBy K T)]
  rw [residual_sup_of_component hgen hT hK]

end CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.GenerationOne.BorelReduction
