module
public import CFSG.Quasithin.Chapter15.Section01.SourceOmegaMarkedSplitting

/-!
# The literal generated Omega quotient

The marked same-P residual branch supplies a two subgroup `Q` and the cubic
residual `X = O²([O²(N),Q])`.  This file keeps the actual generated subgroup
`L = Q ⊔ X`; no abstract `S₄ × S₄` cover is introduced.  The coordinate map
on the chosen normalizer restricts to a surjection `L → Ω`, and the kernel is
the literal `W.subgroupOf L`.  Coordinates on this restricted module are
transported through the subgroup-of equivalence.

Source: Aschbacher--Smith 15.1.11, printed p.1089.
-/

public section
open Subgroup Stellmacher Theory.GroupTheory Representation Representation.BinaryOffender
open scoped IsMulCommutative ENNReal commutatorElement
namespace CFSG.Quasithin.Chapter15.Section01
open Section03 Section03.InitialSource ChapterA.Section05To06 ChapterD ChapterD.UniqueFactor
variable {G : Type*} [Group G] [Finite G]
variable {N : Subgroup G}

/-- The actual quotient data on the subgroup generated by the Sylow core and
its cubic residual. -/
structure OmegaGeneratedQuotient (W : Subgroup N)
    [IsElementaryAbelian 2 W] [W.Normal]
    (c : ChosenOmegaCoordinates N W) (Q : Subgroup N)
    (S : Sylow 2 OrthogonalFourBinary.omega) where
  hQ : Q.map c.q = S
  hXker : (Subgroup.cubicCommutatorResidual Q) ⊓ c.q.ker = W
  hQker : Q ⊓ c.q.ker ≤ W
  hWL : W ≤ Q ⊔ Subgroup.cubicCommutatorResidual Q

namespace OmegaGeneratedQuotient

variable {W : Subgroup N} [IsElementaryAbelian 2 W] [W.Normal]
variable {c : ChosenOmegaCoordinates N W} {Q : Subgroup N}
variable {S : Sylow 2 OrthogonalFourBinary.omega}

/-- The product of the two literal factors has the expected kernel in the
coordinate quotient. -/
private theorem ker_inter_eq (d : OmegaGeneratedQuotient W c Q S) :
    (Q ⊔ Subgroup.cubicCommutatorResidual Q) ⊓ c.q.ker = W := by
  let X := Subgroup.cubicCommutatorResidual Q
  let L := Q ⊔ X
  have hnorm : Q ≤ normalizer (X : Set N) :=
    le_sup_right.trans (Subgroup.cubicCommutatorResidual_normalized Q)
  have hprod := coe_mul_of_left_le_normalizer_right Q X hnorm
  have hdis : Disjoint (S : Subgroup OrthogonalFourBinary.omega)
      (pResidual 2 OrthogonalFourBinary.omega) := by
    exact S.isPGroup'.disjoint_of_coprime
      OrthogonalFourBinary.omega_twoResidual_elementary.isPGroup (by decide)
  have hle : L ⊓ c.q.ker ≤ W := by
    intro z hz
    have hzL : (z : N) ∈ (L : Set N) := hz.1
    change (z : N) ∈ (L : Set N) at hzL
    rw [hprod] at hzL
    obtain ⟨a,ha,b,hb,hzab⟩ := hzL
    have hzab' : a * b = z := hzab
    have hzker : c.q (a * b) = 1 := by
      rw [hzab']
      exact MonoidHom.mem_ker.mp hz.2
    rw [map_mul] at hzker
    have haS : c.q a ∈ (S : Subgroup OrthogonalFourBinary.omega) := by
      rw [← d.hQ]
      exact ⟨a,ha,rfl⟩
    have hbR : c.q b ∈ pResidual 2 OrthogonalFourBinary.omega := by
      rw [← Subgroup.cubicCommutatorResidual_map_of_symmetricThree_pair
        c.q c.surjective c.e Q S d.hQ]
      exact ⟨b,hb,rfl⟩
    have haeq : c.q a = (c.q b)⁻¹ := by
      have hh := congrArg (fun y => y * (c.q b)⁻¹) hzker
      simpa [mul_assoc] using hh
    have haR : c.q a ∈ pResidual 2 OrthogonalFourBinary.omega := by
      rw [haeq]
      exact (pResidual 2 OrthogonalFourBinary.omega).inv_mem hbR
    have ha_one : c.q a = 1 := by
      have hz0 : c.q a ∈ (⊥ : Subgroup OrthogonalFourBinary.omega) :=
        hdis.le_bot ⟨haS,haR⟩
      exact hz0
    have hb_one : c.q b = 1 := by simpa [ha_one] using hzker
    have haW : a ∈ W := d.hQker ⟨ha,MonoidHom.mem_ker.mpr ha_one⟩
    have hbW : b ∈ W := by
      rw [← d.hXker]
      exact ⟨hb,MonoidHom.mem_ker.mpr hb_one⟩
    rw [← hzab']
    exact W.mul_mem haW hbW
  have hW : W ≤ L ⊓ c.q.ker := by
    refine le_inf d.hWL ?_
    rw [c.ker_eq]
    exact W.le_centralizer
  exact le_antisymm hle hW

/-- Restriction of the chosen-normalizer coordinate map to the generated
subgroup `Q ⊔ O²([O²(N),Q])`. -/
noncomputable def map {W : Subgroup N} [IsElementaryAbelian 2 W] [W.Normal]
    {c : ChosenOmegaCoordinates N W} {Q : Subgroup N}
    {S : Sylow 2 OrthogonalFourBinary.omega}
    (_d : OmegaGeneratedQuotient W c Q S) :
    ↥(Q ⊔ Subgroup.cubicCommutatorResidual Q) →*
      OrthogonalFourBinary.omega :=
  c.q.comp (Q ⊔ Subgroup.cubicCommutatorResidual Q).subtype

/-- The restricted map is onto Ω. -/
theorem map_surjective {W : Subgroup N} [IsElementaryAbelian 2 W] [W.Normal]
    {c : ChosenOmegaCoordinates N W} {Q : Subgroup N}
    {S : Sylow 2 OrthogonalFourBinary.omega}
    (d : OmegaGeneratedQuotient W c Q S) :
    Function.Surjective d.map := by
  let X := Subgroup.cubicCommutatorResidual Q
  let L := Q ⊔ X
  have hXmap : X.map c.q = pResidual 2 OrthogonalFourBinary.omega :=
    Subgroup.cubicCommutatorResidual_map_of_symmetricThree_pair
      c.q c.surjective c.e Q S d.hQ
  have hmap : L.map c.q = ⊤ := by
    rw [Subgroup.map_sup,d.hQ,hXmap,sup_comm]
    exact pResidual_sup_sylow_eq_top S
  intro z
  have hz : z ∈ L.map c.q := by
    rw [hmap]
    exact (show z ∈ (⊤ : Subgroup OrthogonalFourBinary.omega) from trivial)
  obtain ⟨a,ha,rfl⟩ := hz
  exact ⟨⟨a,ha⟩,rfl⟩

/-- The restricted map has exactly the literal module kernel. -/
theorem map_ker {W : Subgroup N} [IsElementaryAbelian 2 W] [W.Normal]
    {c : ChosenOmegaCoordinates N W} {Q : Subgroup N}
    {S : Sylow 2 OrthogonalFourBinary.omega}
    (d : OmegaGeneratedQuotient W c Q S) :
    d.map.ker = W.subgroupOf (Q ⊔ Subgroup.cubicCommutatorResidual Q) := by
  let L := Q ⊔ Subgroup.cubicCommutatorResidual Q
  have hinter := ker_inter_eq d
  apply map_injective L.subtype_injective
  calc
    d.map.ker.map L.subtype = L ⊓ c.q.ker := by
      change (c.q.comp L.subtype).ker.map L.subtype = L ⊓ c.q.ker
      ext z
      constructor
      · rintro ⟨y,hy,rfl⟩
        exact ⟨y.property, MonoidHom.mem_ker.mp hy⟩
      · intro hz
        refine ⟨⟨z,hz.1⟩, MonoidHom.mem_ker.mpr hz.2, rfl⟩
    _ = W := hinter
    _ = (W.subgroupOf L).map L.subtype :=
      (map_subgroupOf_eq_of_le d.hWL).symm

/-- The natural coordinates restrict through `W.subgroupOf L ≃ W`. -/
noncomputable def coordinate {W : Subgroup N} [IsElementaryAbelian 2 W] [W.Normal]
    {c : ChosenOmegaCoordinates N W} {Q : Subgroup N}
    {S : Sylow 2 OrthogonalFourBinary.omega}
    (d : OmegaGeneratedQuotient W c Q S)
    [IsElementaryAbelian 2 (W.subgroupOf (Q ⊔ Subgroup.cubicCommutatorResidual Q))] :
    Additive (W.subgroupOf (Q ⊔ Subgroup.cubicCommutatorResidual Q)) ≃ₗ[ZMod 2]
      OrthogonalFourBinary.Space := by
  let L := Q ⊔ Subgroup.cubicCommutatorResidual Q
  let ev : W.subgroupOf L ≃* W := subgroupOfEquivOfLe d.hWL
  let evlin : Additive (W.subgroupOf L) ≃ₗ[ZMod 2] Additive W :=
    LinearEquiv.ofBijective (ev.toMonoidHom.toAdditive.toZModLinearMap 2)
      ev.toAdditive.bijective
  exact evlin.trans c.x

omit [Finite G] in
/-- The restricted coordinates intertwine conjugation with the literal map. -/
theorem coordinate_apply {W : Subgroup N} [IsElementaryAbelian 2 W] [W.Normal]
    {c : ChosenOmegaCoordinates N W} {Q : Subgroup N}
    {S : Sylow 2 OrthogonalFourBinary.omega}
    (d : OmegaGeneratedQuotient W c Q S)
    [IsElementaryAbelian 2 (W.subgroupOf (Q ⊔ Subgroup.cubicCommutatorResidual Q))] (l : ↥(Q ⊔ Subgroup.cubicCommutatorResidual Q))
    (w : Additive (W.subgroupOf (Q ⊔ Subgroup.cubicCommutatorResidual Q))) :
    d.coordinate (NoncentralChiefRefinement.normalRepresentation
      (W.subgroupOf (Q ⊔ Subgroup.cubicCommutatorResidual Q)) l w) =
      (d.map l).val.val (d.coordinate w) := by
  let L := Q ⊔ Subgroup.cubicCommutatorResidual Q
  let ev : W.subgroupOf L ≃* W := subgroupOfEquivOfLe d.hWL
  let evlin : Additive (W.subgroupOf L) ≃ₗ[ZMod 2] Additive W :=
    LinearEquiv.ofBijective (ev.toMonoidHom.toAdditive.toZModLinearMap 2)
      ev.toAdditive.bijective
  dsimp [coordinate,map,evlin,ev,L]
  change c.x (evlin (NoncentralChiefRefinement.normalRepresentation
      (W.subgroupOf L) l w)) =
    (c.q (l : N)).val.val (c.x (evlin w))
  rw [← c.coord]
  apply congrArg c.x
  apply Additive.toMul.injective
  apply Subtype.ext
  change (l : N) * (w.toMul : N) * (l : N)⁻¹ =
    ((l : N) * (w.toMul : N) * (l : N)⁻¹)
  rfl

end OmegaGeneratedQuotient

end CFSG.Quasithin.Chapter15.Section01
namespace CFSG.Quasithin.Chapter15.Section01
open Section03 Section03.InitialSource ChapterA.Section05To06 ChapterD ChapterD.UniqueFactor Representation
variable {G : Type*} [Group G] [Finite G]

/-- The original solvable full-Omega source branch supplies the generated
quotient data with the same core `P`; the map and kernel are then the generic
ones above. -/
theorem source_fullOmega_solvable_omega_generated_quotient
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    {M H : Subgroup G} [IsElementaryAbelian 2 (localModule T M)]
    (hM : IsOrderingMaximal T M)
    (_hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (_hH : H ∈ Chapter3.HStar (T : Subgroup G) M)
    (_hs : Group.IsSolvable H) (_hout : ¬localModule T M ≤ H.pCoreIn 2)
    (P : Subgroup G) (hPT : P ≤ (T : Subgroup G))
    (hprod : (T : Subgroup G) = P ⊔ ((T : Subgroup G) ⊓ centralizer (localModule T M : Set G)))
    (hint : P ⊓ centralizer (localModule T M : Set G) = P ⊓ localModule T M)
    (ho : SourceCases.Omega (imageRepresentation M (localModule T M)
        (le_normalizer_conjugateSpanBy _ _)))
    (hXcap : let N := chosenNormalizer T M (localModule T M)
      let X := (Subgroup.cubicCommutatorResidual
        (P.subgroupOf N)).map N.subtype
      X ⊓ centralizer (localModule T M : Set G) = localModule T M) :
    let V := localModule T M
    let N := chosenNormalizer T M V
    let hred := chosenNormalizer_reduced T hM.1.2 (localModule_le T hM.1.2)
      (le_normalizer_conjugateSpanBy _ _) (by
        have hZ : centralInvolutions T ≤ localModule T M := le_conjugateSpanBy _ _
        rw [inf_eq_left.mpr hZ]
        rfl)
    letI := hred.normal
    letI := hred.elementary
    let W := V.subgroupOf N
    let c := Classical.choice
      (source_chosenNormalizer_omega_coordinates hG T hM.1.2
        (localModule_le T hM.1.2) (by
          intro hz
          have hZ : centralInvolutions T ≤ localModule T M := le_conjugateSpanBy _ _
          exact centralInvolutions_ne_bot_of_maximal_local T
            ⟨hM.1.1,hM.1.2⟩ (bot_unique (hZ.trans_eq hz)))
        (le_normalizer_conjugateSpanBy _ _) (by
          have hZ : centralInvolutions T ≤ localModule T M := le_conjugateSpanBy _ _
          rw [inf_eq_left.mpr hZ]
          rfl) ho)
    let hTN : (T : Subgroup G) ≤ N :=
      sylow_le_chosenNormalizer T hM.1.2 (le_normalizer_conjugateSpanBy _ _)
    let Q := P.subgroupOf N
    let S₀ : Sylow 2 N := T.subtype hTN
    let A : Sylow 2 OrthogonalFourBinary.omega := S₀.mapSurjective (f := c.q) c.surjective
    Nonempty (OmegaGeneratedQuotient W c Q A) := by
  dsimp only
  let V := localModule T M
  let N := chosenNormalizer T M V
  let hred := chosenNormalizer_reduced T hM.1.2 (localModule_le T hM.1.2)
      (le_normalizer_conjugateSpanBy _ _) (by
        have hZ : centralInvolutions T ≤ V := le_conjugateSpanBy _ _
        rw [inf_eq_left.mpr hZ]
        rfl)
  let _ := hred.normal
  let _ := hred.elementary
  let W := V.subgroupOf N
  have hVne : V ≠ ⊥ := by
    intro hz
    have hZ : centralInvolutions T ≤ V := le_conjugateSpanBy _ _
    exact centralInvolutions_ne_bot_of_maximal_local T
      ⟨hM.1.1,hM.1.2⟩ (bot_unique (hZ.trans_eq hz))
  let c := Classical.choice
    (source_chosenNormalizer_omega_coordinates hG T hM.1.2
      (localModule_le T hM.1.2) hVne (le_normalizer_conjugateSpanBy _ _)
      (by
        have hZ : centralInvolutions T ≤ V := le_conjugateSpanBy _ _
        rw [inf_eq_left.mpr hZ]
        rfl) ho)
  have hTN : (T : Subgroup G) ≤ N :=
    sylow_le_chosenNormalizer T hM.1.2 (le_normalizer_conjugateSpanBy _ _)
  have hPN : P ≤ N := hPT.trans hTN
  have hVN : V ≤ N := module_le_chosenNormalizer T hM.1.2
    (localModule_le T hM.1.2) (le_normalizer_conjugateSpanBy _ _)
  let Q := P.subgroupOf N
  let S₀ : Sylow 2 N := T.subtype hTN
  let A : Sylow 2 OrthogonalFourBinary.omega := S₀.mapSurjective (f := c.q) c.surjective
  have hSW : (S₀ : Subgroup N) = Q ⊔ ((S₀ : Subgroup N) ⊓ centralizer (W : Set N)) := by
    apply (map_injective N.subtype_injective)
    rw [Subgroup.map_sup,map_inf _ _ _ N.subtype_injective,
      map_centralizer_subtype,map_subgroupOf_eq_of_le hVN,
      map_subgroupOf_eq_of_le hPN,show (S₀ : Subgroup N).map N.subtype =
        (T : Subgroup G) from map_subgroupOf_eq_of_le hTN,
      ← inf_assoc,inf_eq_left.mpr hTN]
    exact hprod
  have hQmap : Q.map c.q = (A : Subgroup OrthogonalFourBinary.omega) := by
    change Q.map c.q = (S₀ : Subgroup N).map c.q
    conv_rhs => rw [hSW,Subgroup.map_sup]
    have hk : ((S₀ : Subgroup N) ⊓ centralizer (W : Set N)).map c.q = ⊥ := by
      apply bot_unique
      rw [map_le_iff_le_comap]
      change (S₀ : Subgroup N) ⊓ centralizer (W : Set N) ≤ c.q.ker
      rw [c.ker_eq]
      exact inf_le_right
    rw [hk,sup_bot_eq]
  have hQker : Q ⊓ c.q.ker ≤ W := by
    rw [c.ker_eq]
    intro z hz
    have hmap : (Q ⊓ centralizer (W : Set N)).map N.subtype ≤ P ⊓ V := by
      rw [map_inf _ _ _ N.subtype_injective,map_centralizer_subtype,
        map_subgroupOf_eq_of_le hVN,map_subgroupOf_eq_of_le hPN]
      rw [← inf_assoc, inf_eq_left.mpr hPN, hint]
    exact (hmap ⟨z,hz,rfl⟩).2
  have hXker : (Subgroup.cubicCommutatorResidual Q) ⊓ c.q.ker = W := by
    apply (map_injective N.subtype_injective)
    rw [c.ker_eq,map_inf _ _ _ N.subtype_injective,map_centralizer_subtype,
      map_subgroupOf_eq_of_le hVN]
    rw [← inf_assoc, inf_eq_left.mpr (map_subtype_le _)]
    exact hXcap
  have hWL : W ≤ Q ⊔ Subgroup.cubicCommutatorResidual Q := by
    exact (hXker.symm.le.trans inf_le_left).trans le_sup_right
  exact ⟨⟨hQmap,hXker,hQker,hWL⟩⟩

end CFSG.Quasithin.Chapter15.Section01
