module
public import CFSG.Quasithin.Chapter15.Section01.SourceThompsonFixed
public import Theory.GroupTheory.SylowImageRestriction

/-!
# Lifting a marked vector from the literal conjugation image

A nonzero vector in the actual elementary subgroup V gives the cyclic
subgroup Z₁ generated by that same group element. Fixedness under the image
of J₁(T) puts Z₁ in C_V(J₁(T)). The full preimage of the vector stabilizer
is C_M(Z₁), so generation with the image Sylow lifts to generation of M.
The prescribed Sylow intersection also lifts through an arbitrary kernel:
its kernel intersection is Sylow by normality, and the two relative indices
are prime to two.

The resulting centralizer has a surjection onto the same model stabilizer,
with exact kernel C_M(V) and the original conjugation action. Thus later
residual calculations retain both the selected Z₁ and the literal quotient.

Source: Aschbacher--Smith, original 15.1.16--18, printed pp.1091--1092.
-/

public section
open Subgroup Representation Representation.BinaryOffender Stellmacher Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section01
open ChapterD ChapterD.UniqueFactor
variable {G : Type*} [Group G]

/-- Pulling back a vector stabilizer is the literal ambient centralizer of its cyclic subgroup. -/
theorem vector_stabilizer_preimage
    (M V : Subgroup G) [IsElementaryAbelian 2 V]
    (hn : M ≤ normalizer (V : Set G))
    (v : Additive V) (K : Subgroup (internalActionImage M V hn))
    (hK : ∀ d, d ∈ K ↔ imageRepresentation M V hn d v = v) :
    (K.comap (actionHom M V hn).rangeRestrict).map M.subtype =
      M ⊓ centralizer (zpowers (v.toMul : G) : Set G) := by
  let f : M →* internalActionImage M V hn := (actionHom M V hn).rangeRestrict
  change (K.comap f).map M.subtype = _
  have hfix (m : M) : f m ∈ K ↔
      (m : G) ∈ centralizer (zpowers (v.toMul : G) : Set G) := by
    rw [hK, zpowers_eq_closure, centralizer_closure, mem_centralizer_singleton_iff]
    constructor
    · intro he
      have hv := congrArg (fun w : Additive V => (w.toMul : G)) he
      change (m : G) * v.toMul * (m : G)⁻¹ = v.toMul at hv
      exact mul_inv_eq_iff_eq_mul.mp hv
    · intro he
      apply Additive.toMul.injective
      apply Subtype.ext
      change (m : G) * v.toMul * (m : G)⁻¹ = v.toMul
      rw [he, mul_inv_cancel_right]
  ext x
  constructor
  · rintro ⟨m,hm,rfl⟩
    exact ⟨m.property,(hfix m).mp hm⟩
  · intro hx
    exact ⟨⟨x,hx.1⟩,(hfix ⟨x,hx.1⟩).mpr hx.2,rfl⟩

variable [Finite G]

/-- An actual fixed vector supplies the literal source marking and generation equality. -/
theorem marked_zpowers_of_image_stabilizer
    (T : Sylow 2 G) {M V : Subgroup G} [IsElementaryAbelian 2 V]
    (hTM : (T : Subgroup G) ≤ M)
    (hn : M ≤ normalizer (V : Set G))
    (v : Additive V) (hv : v ≠ 0)
    (hfixed : v ∈ fixedSpace (imageRepresentation M V hn)
      (((ChapterB.thompsonJ (T : Subgroup G) 1).subgroupOf M).map
        (actionHom M V hn).rangeRestrict))
    (K : Subgroup (internalActionImage M V hn))
    (hK : ∀ d, d ∈ K ↔ imageRepresentation M V hn d v = v)
    (hgen : K ⊔ ((T : Subgroup G).subgroupOf M).map
      (actionHom M V hn).rangeRestrict = ⊤) :
    let Z1 := zpowers (v.toMul : G)
    Z1 ≤ thompsonFixed T V ∧ Z1 ≠ ⊥ ∧
      M = (M ⊓ centralizer (Z1 : Set G)) ⊔ (T : Subgroup G) := by
  let f : M →* internalActionImage M V hn := (actionHom M V hn).rangeRestrict
  have hf : Function.Surjective f := (actionHom M V hn).rangeRestrict_surjective
  have hcen : (v.toMul : G) ∈ centralizer
      (ChapterB.thompsonJ (T : Subgroup G) 1 : Set G) := by
    intro j hj
    have hjM := hTM (ChapterB.thompsonJ_le _ _ hj)
    have hjf : f ⟨j,hjM⟩ ∈ ((ChapterB.thompsonJ (T : Subgroup G) 1).subgroupOf M).map f :=
      mem_map_of_mem f hj
    have he := congrArg (fun w : Additive V => (w.toMul : G)) (hfixed ⟨_,hjf⟩)
    change j * v.toMul * j⁻¹ = v.toMul at he
    exact mul_inv_eq_iff_eq_mul.mp he
  refine ⟨zpowers_le.mpr ⟨v.toMul.property,hcen⟩,?_,?_⟩
  · apply zpowers_ne_bot.mpr
    intro he
    apply hv
    apply Additive.toMul.injective
    exact Subtype.ext he
  · have hmap : (K.comap f ⊔ (T : Subgroup G).subgroupOf M).map f = ⊤ := by
      rw [Subgroup.map_sup, map_comap_eq_self_of_surjective hf]
      exact hgen
    have htop : K.comap f ⊔ (T : Subgroup G).subgroupOf M = ⊤ := by
      have he := congrArg (Subgroup.comap f) hmap
      rwa [comap_map_eq_self ((K.ker_le_comap f).trans le_sup_left), comap_top] at he
    have hU : (K.comap f).map M.subtype =
        M ⊓ centralizer (zpowers (v.toMul : G) : Set G) :=
      vector_stabilizer_preimage M V hn v K hK
    have he := congrArg (Subgroup.map M.subtype) htop
    rw [Subgroup.map_sup, hU,
      map_subgroupOf_eq_of_le hTM, ←MonoidHom.range_eq_map, M.range_subtype] at he
    exact he.symm

/-- The image Sylow intersection lifts to the original centralizer, including
when the centralizer kernel has odd-order elements. -/
theorem vector_stabilizer_sylow_preimage
    (T : Sylow 2 G) {M V : Subgroup G} [IsElementaryAbelian 2 V]
    (hTM : (T : Subgroup G) ≤ M)
    (hn : M ≤ normalizer (V : Set G))
    (v : Additive V) (K : Subgroup (internalActionImage M V hn))
    (hK : ∀ d, d ∈ K ↔ imageRepresentation M V hn d v = v)
    (P : Sylow 2 K)
    (hP : (P : Subgroup K).map K.subtype =
      (((T : Subgroup G).subgroupOf M).map (actionHom M V hn).rangeRestrict) ⊓ K) :
    ∃ S : Sylow 2 ↥(M ⊓ centralizer (zpowers (v.toMul : G) : Set G)),
      (S : Subgroup ↥(M ⊓ centralizer (zpowers (v.toMul : G) : Set G))).map
        (M ⊓ centralizer (zpowers (v.toMul : G) : Set G)).subtype =
          (T : Subgroup G) ⊓ centralizer (zpowers (v.toMul : G) : Set G) := by
  let f : M →* internalActionImage M V hn := (actionHom M V hn).rangeRestrict
  let U := K.comap f
  let C := M ⊓ centralizer (zpowers (v.toMul : G) : Set G)
  have hUC : U.map M.subtype = C := vector_stabilizer_preimage M V hn v K hK
  let e : U ≃* C := (U.equivMapOfInjective M.subtype M.subtype_injective).trans
    (MulEquiv.subgroupCongr hUC)
  obtain ⟨Q,hQ⟩ := Subgroup.exists_sylow_preimage_inf_of_image (T.subtype hTM) f
    (actionHom M V hn).rangeRestrict_surjective K P hP
  refine ⟨Q.mapSurjective (f := e.toMonoidHom) e.surjective,?_⟩
  have he : C.subtype.comp e.toMonoidHom = M.subtype.comp U.subtype := by
    ext x
    rfl
  change ((Q : Subgroup U).map e.toMonoidHom).map C.subtype = _
  rw [Subgroup.map_map, he, ←Subgroup.map_map, hQ,
    Subgroup.map_inf _ _ _ M.subtype_injective, Sylow.coe_subtype,
    map_subgroupOf_eq_of_le hTM, hUC]
  exact le_antisymm (le_inf inf_le_left (inf_le_right.trans inf_le_right))
    (le_inf inf_le_left (le_inf (inf_le_left.trans hTM) inf_le_right))

/-- The finite image marking supplies all literal subgroup data needed by
original 15.1.16 and the initial Sylow restriction in 15.1.17. -/
theorem marked_zpowers_and_sylow_of_image_stabilizer
    (T : Sylow 2 G) {M V : Subgroup G} [IsElementaryAbelian 2 V]
    (hTM : (T : Subgroup G) ≤ M)
    (hn : M ≤ normalizer (V : Set G))
    (v : Additive V) (hv : v ≠ 0)
    (hfixed : v ∈ fixedSpace (imageRepresentation M V hn)
      (((ChapterB.thompsonJ (T : Subgroup G) 1).subgroupOf M).map
        (actionHom M V hn).rangeRestrict))
    (K : Subgroup (internalActionImage M V hn))
    (hK : ∀ d, d ∈ K ↔ imageRepresentation M V hn d v = v)
    (hgen : K ⊔ ((T : Subgroup G).subgroupOf M).map
      (actionHom M V hn).rangeRestrict = ⊤)
    (hsyl : ∃ P : Sylow 2 K, (P : Subgroup K).map K.subtype =
      (((T : Subgroup G).subgroupOf M).map (actionHom M V hn).rangeRestrict) ⊓ K) :
    let Z1 := zpowers (v.toMul : G)
    Z1 ≤ thompsonFixed T V ∧ Z1 ≠ ⊥ ∧
      M = (M ⊓ centralizer (Z1 : Set G)) ⊔ (T : Subgroup G) ∧
      ∃ S : Sylow 2 ↥(M ⊓ centralizer (Z1 : Set G)),
        (S : Subgroup ↥(M ⊓ centralizer (Z1 : Set G))).map
          (M ⊓ centralizer (Z1 : Set G)).subtype =
            (T : Subgroup G) ⊓ centralizer (Z1 : Set G) := by
  obtain ⟨hZ,hne,hM⟩ := marked_zpowers_of_image_stabilizer T hTM hn v hv hfixed K hK hgen
  obtain ⟨P,hP⟩ := hsyl
  exact ⟨hZ,hne,hM,vector_stabilizer_sylow_preimage T hTM hn v K hK P hP⟩

omit [Finite G] in
/-- The same marked centralizer maps onto its model stabilizer with the
literal centralizer of V as kernel. This identifies the quotient used in
original 15.1.18 with the very same K selected in 15.1.16. -/
theorem vector_stabilizer_projection
    (M V : Subgroup G) [IsElementaryAbelian 2 V]
    (hn : M ≤ normalizer (V : Set G))
    (v : Additive V) (K : Subgroup (internalActionImage M V hn))
    (hK : ∀ d, d ∈ K ↔ imageRepresentation M V hn d v = v) :
    let C := M ⊓ centralizer (zpowers (v.toMul : G) : Set G)
    ∃ q : C →* K, Function.Surjective q ∧
      q.ker = (centralizer (V : Set G)).subgroupOf C ∧
      ∀ x : C, (q x : internalActionImage M V hn) =
        (actionHom M V hn).rangeRestrict ⟨x,x.property.1⟩ := by
  let f : M →* internalActionImage M V hn := (actionHom M V hn).rangeRestrict
  let U := K.comap f
  let C := M ⊓ centralizer (zpowers (v.toMul : G) : Set G)
  have hUC : U.map M.subtype = C := vector_stabilizer_preimage M V hn v K hK
  let e : U ≃* C := (U.equivMapOfInjective M.subtype M.subtype_injective).trans
    (MulEquiv.subgroupCongr hUC)
  let r : U →* K := (f.comp U.subtype).codRestrict K (fun u => u.property)
  have hr : Function.Surjective r := by
    intro k
    obtain ⟨m,hm⟩ := (actionHom M V hn).rangeRestrict_surjective (k : internalActionImage M V hn)
    refine ⟨⟨m,?_⟩,Subtype.ext hm⟩
    change f m ∈ K
    rw [show f m = k from hm]
    exact k.property
  let q : C →* K := r.comp e.symm.toMonoidHom
  have hq (x : C) : (q x : internalActionImage M V hn) = f ⟨x,x.property.1⟩ := by
    change f ((e.symm x : U) : M) = f ⟨x,x.property.1⟩
    congr 1
    apply Subtype.ext
    have he := congrArg (fun y : C => (y : G)) (e.apply_symm_apply x)
    exact he
  refine ⟨q,hr.comp e.symm.surjective,?_,hq⟩
  ext x
  constructor
  · intro hx
    have hd : f ⟨x,x.property.1⟩ = 1 := (hq x).symm.trans (congrArg Subtype.val hx)
    have ha : (actionHom M V hn) ⟨x,x.property.1⟩ = 1 := congrArg Subtype.val hd
    have hc : (⟨x,x.property.1⟩ : M) ∈ (actionHom M V hn).ker := ha
    rw [actionHom_ker] at hc
    exact hc
  · intro hx
    have ha : (actionHom M V hn) ⟨x,x.property.1⟩ = 1 := by
      change (⟨x,x.property.1⟩ : M) ∈ (actionHom M V hn).ker
      rw [actionHom_ker]
      exact hx
    apply Subtype.ext
    rw [hq]
    exact Subtype.ext ha

end CFSG.Quasithin.Chapter15.Section01
