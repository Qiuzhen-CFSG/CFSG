module
public import CFSG.Quasithin.Chapter15.Section01.NormalizerSource
public import CFSG.Quasithin.Chapter15.Section01.OrderingSource.Assembly
public import Theory.GroupTheory.ReducedNormal.SylowCentralSeed

/-!
# The normalizer of the centralizer of the chosen Chapter 15 subgroup

For the chosen elementary abelian V, set R = C_T(V) and N = N_M(R).
The Sylow Frattini argument in C_M(V) gives M = N C_M(V), equality of
literal action images, and generation of V by the same central seed under N.
Sylow-central generation makes V reduced in N and identifies O₂(N) with R.
Even characteristic then identifies F*(N) with O₂(N).

The original ordering conclusion of 14.1.4 and A.5.6 make M the unique
maximal two-local overgroup of N. This discharges the common-normal
exclusion in the genuine QRC configuration for every H in H*(T,M).
The final theorem assembles precisely 15.1.9(5–6). Its subgroup V remains
the chosen subgroup from 15.1.4, including the proper four-space case;
the central-seed span premise is supplied by that earlier construction.

Source: Aschbacher–Smith, A.5.7(2b), printed pp.62–63, and 15.1.9(5–6),
printed pp.1088–1089.
-/

public section
open Subgroup Stellmacher Theory.GroupTheory
namespace CFSG.Quasithin.Chapter15.Section01
open Section03 Section03.InitialSource ChapterA.Section05To06
variable {G : Type*} [Group G] [Finite G]

/-- The source subgroup N_M(C_T(V)) for the actual chosen V. -/
abbrev chosenNormalizer (T : Sylow 2 G) (M V : Subgroup G) : Subgroup G :=
  M ⊓ normalizer ((T : Subgroup G) ⊓ centralizer (V : Set G) : Set G)

omit [Finite G] in
/-- The original Sylow subgroup normalizes its centralizer of V. -/
theorem sylow_le_chosenNormalizer (T : Sylow 2 G) {M V : Subgroup G}
    (hTM : (T : Subgroup G) ≤ M) (hMV : M ≤ normalizer (V : Set G)) :
    (T : Subgroup G) ≤ chosenNormalizer T M V := by
  refine le_inf hTM ?_
  exact (le_inf (T : Subgroup G).le_normalizer
    ((hTM.trans hMV).trans (normalizer_le_normalizer_centralizer _))).trans
      inf_normalizer_le_normalizer_inf

/-- Sylow Frattini in C_M(V), with representatives in the ambient group. -/
theorem chosenNormalizer_factorization (T : Sylow 2 G) {M V : Subgroup G}
    (hTM : (T : Subgroup G) ≤ M) (hMV : M ≤ normalizer (V : Set G)) :
    ∀ m ∈ M, ∃ n ∈ chosenNormalizer T M V, ∃ c ∈ M ⊓ centralizer (V : Set G),
      n * c = m := by
  let C := (centralizer (V : Set G)).subgroupOf M
  let : C.Normal := normal_subgroupOf_of_le_normalizer
    (hMV.trans (normalizer_le_normalizer_centralizer _))
  obtain ⟨P, hP⟩ := (T.subtype hTM).exists_subgroupOf_eq_of_normal C
  let R := (P : Subgroup C).map C.subtype
  have hR : R.map M.subtype = (T : Subgroup G) ⊓ centralizer (V : Set G) := by
    rw [show R = (P : Subgroup C).map C.subtype from rfl, hP, map_map]
    ext x
    constructor
    · rintro ⟨c, hc, rfl⟩
      exact ⟨hc, c.property⟩
    · intro hx
      exact ⟨⟨⟨x, hTM hx.1⟩, hx.2⟩, hx.1, rfl⟩
  have hf : normalizer (R : Set M) ⊔ C = ⊤ := P.normalizer_sup_eq_top
  intro m hm
  have hm' : (⟨m, hm⟩ : M) ∈ normalizer (R : Set M) ⊔ C := hf ▸ mem_top _
  obtain ⟨n, hn, c, hc, he⟩ := mem_sup_of_normal_right.mp hm'
  have hnR : (n : G) ∈ normalizer (R.map M.subtype : Set G) :=
    R.le_normalizer_map M.subtype (mem_map_of_mem M.subtype hn)
  rw [hR] at hnR
  exact ⟨n, ⟨n.property, hnR⟩, c, ⟨c.property, hc⟩, congrArg Subtype.val he⟩

/-- The chosen V is generated by its original central seed under N_M(C_T(V)). -/
theorem chosenNormalizer_span (T : Sylow 2 G) {M V : Subgroup G}
    (hTM : (T : Subgroup G) ≤ M) (hMV : M ≤ normalizer (V : Set G))
    (hspan : V = conjugateSpanBy (centralInvolutions T ⊓ V) M) :
    V = conjugateSpanBy (centralInvolutions T ⊓ V) (chosenNormalizer T M V) := by
  have h : ConjugateSpanLE (centralInvolutions T ⊓ V) M (chosenNormalizer T M V) := by
    intro m hm
    obtain ⟨n,hn,c,hc,he⟩ := chosenNormalizer_factorization T hTM hMV m hm
    exact ⟨n,⟨hn.1,hn⟩,c,⟨hc.1,hspan ▸ hc.2⟩,he⟩
  exact le_antisymm (hspan.le.trans h.span_le) (conjugateSpanBy_le inf_le_right
    (inf_le_left.trans hMV))

omit [Finite G] in
/-- A normal elementary abelian V lies in T and hence in N_M(C_T(V)). -/
theorem module_le_chosenNormalizer (T : Sylow 2 G) {M V : Subgroup G}
    [IsElementaryAbelian 2 V] (hTM : (T : Subgroup G) ≤ M) (hVM : V ≤ M)
    (hMV : M ≤ normalizer (V : Set G)) : V ≤ chosenNormalizer T M V := by
  let : (V.subgroupOf M).Normal := normal_subgroupOf_of_le_normalizer hMV
  let := IsElementaryAbelian.subgroupOf hVM (p := 2)
  have h := (IsElementaryAbelian.isPGroup 2 (V.subgroupOf M)).le_sylow_of_normal
    (T.subtype hTM)
  have hVT : V ≤ (T : Subgroup G) := by
    have hm := map_mono (f := M.subtype) h
    simpa only [map_subgroupOf_eq_of_le hVM, Sylow.coe_subtype,
      map_subgroupOf_eq_of_le hTM] using hm
  exact hVT.trans (sylow_le_chosenNormalizer T hTM hMV)

/-- A.5.7(2b): the chosen subgroup is reduced in its source normalizer. -/
theorem chosenNormalizer_reduced (T : Sylow 2 G) {M V : Subgroup G}
    [IsElementaryAbelian 2 V] (hTM : (T : Subgroup G) ≤ M) (hVM : V ≤ M)
    (hMV : M ≤ normalizer (V : Set G))
    (hspan : V = conjugateSpanBy (centralInvolutions T ⊓ V) M) :
    IsPReduced 2 (V.subgroupOf (chosenNormalizer T M V)) := by
  apply reduced_of_sylow_central_seed T _ V (centralInvolutions T ⊓ V)
    (sylow_le_chosenNormalizer T hTM hMV) (module_le_chosenNormalizer T hTM hVM hMV)
    (inf_le_left.trans hMV) inf_le_right ?_ (chosenNormalizer_span T hTM hMV hspan)
  intro z hz s hs
  exact ((mem_omegaOneCenterAmbient_iff _ z).mp hz.1).2.2 s hs

/-- A.5.7(2b): the ambient image of the normalizer two-core is C_T(V). -/
theorem chosenNormalizer_twoCore (T : Sylow 2 G) {M V : Subgroup G}
    [IsElementaryAbelian 2 V] (hTM : (T : Subgroup G) ≤ M) (hVM : V ≤ M)
    (hMV : M ≤ normalizer (V : Set G))
    (hspan : V = conjugateSpanBy (centralInvolutions T ⊓ V) M) :
    (chosenNormalizer T M V).pCoreIn 2 = (T : Subgroup G) ⊓ centralizer (V : Set G) := by
  let N := chosenNormalizer T M V
  let R := (T : Subgroup G) ⊓ centralizer (V : Set G)
  have hTN : (T : Subgroup G) ≤ N := sylow_le_chosenNormalizer T hTM hMV
  have hred := chosenNormalizer_reduced T hTM hVM hMV hspan
  apply le_antisymm
  · refine le_inf ?_ ?_
    · simpa only [Sylow.coe_subtype, map_subgroupOf_eq_of_le hTN] using
        pCoreIn_le_sylow N (T.subtype hTN)
    · rintro x ⟨n, hn, rfl⟩ v hv
      exact congrArg N.subtype ((le_centralizer_iff.mp hred.le_centralizer_pCore)
        hn ⟨v, module_le_chosenNormalizer T hTM hVM hMV hv⟩ hv)
  · exact le_pCoreIn_of_normalizes (T.isPGroup'.to_le inf_le_left)
      (le_inf (inf_le_left.trans hTM) R.le_normalizer) inf_le_right

/-- Reducedness on the literal D.1.1 conjugation image. -/
theorem chosenNormalizer_actionImage_reduced (T : Sylow 2 G) {M V : Subgroup G}
    [IsElementaryAbelian 2 V] (hTM : (T : Subgroup G) ≤ M) (hVM : V ≤ M)
    (hMV : M ≤ normalizer (V : Set G))
    (hspan : V = conjugateSpanBy (centralInvolutions T ⊓ V) M) :
    pCore 2 (ChapterD.internalActionImage (chosenNormalizer T M V) V
      (inf_le_left.trans hMV)) = ⊥ := by
  let N := chosenNormalizer T M V
  have hNV : N ≤ normalizer (V : Set G) := inf_le_left.trans hMV
  let f := ChapterE.DihedralCubic.conjugation N V hNV
  have hred := chosenNormalizer_reduced T hTM hVM hMV hspan
  let := hred.normal
  have hk : f.ker = centralizer (V.subgroupOf N : Set N) := by
    rw [ChapterE.DihedralCubic.conjugation_ker]
    ext n
    constructor
    · intro hn v hv
      exact Subtype.ext (hn v hv)
    · intro hn v hv
      exact congrArg N.subtype (hn ⟨v, module_le_chosenNormalizer T hTM hVM hMV hv⟩ hv)
  let e := (QuotientGroup.quotientMulEquivOfEq hk.symm).trans
    (QuotientGroup.quotientKerEquivRange f)
  change pCore 2 f.range = ⊥
  rw [← pCore_map_iso 2 e, hred.quotient_pCore_eq_bot, Subgroup.map_bot]


/-- The normalizer is an overgroup of T with nontrivial two-core, hence belongs to He. -/
theorem chosenNormalizer_mem_He
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    {M V : Subgroup G} [IsElementaryAbelian 2 V]
    (hTM : (T : Subgroup G) ≤ M) (hVM : V ≤ M) (hVne : V ≠ ⊥)
    (hMV : M ≤ normalizer (V : Set G)) : chosenNormalizer T M V ∈ Chapter1.He G := by
  apply Chapter1.lemma_1_1_4_6 T (hG.evenCharacteristic T)
  refine ⟨?_, sylow_le_chosenNormalizer T hTM hMV⟩
  have hVc : V ≤ (chosenNormalizer T M V).pCoreIn 2 :=
    le_pCoreIn_of_normalizes (IsElementaryAbelian.isPGroup 2 V)
      (module_le_chosenNormalizer T hTM hVM hMV) (inf_le_left.trans hMV)
  intro he
  exact hVne (bot_unique (hVc.trans_eq he))

/-- Even characteristic identifies the normalizer generalized Fitting subgroup. -/
theorem chosenNormalizer_generalizedFitting
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    {M V : Subgroup G} [IsElementaryAbelian 2 V]
    (hTM : (T : Subgroup G) ≤ M) (hVM : V ≤ M) (hVne : V ≠ ⊥)
    (hMV : M ≤ normalizer (V : Set G)) :
    generalizedFitting (chosenNormalizer T M V) = pCore 2 (chosenNormalizer T M V) :=
  generalizedFitting_eq_pCore_of_selfCentralizing 2
    (Chapter1.mem_He_iff.mp (chosenNormalizer_mem_He hG T hTM hVM hVne hMV))

/-- A.5.6 gives uniqueness from domination in the source ordering. -/
theorem chosenNormalizer_unique_of_ordering (T : Sylow 2 G) {M V : Subgroup G}
    [IsElementaryAbelian 2 V] (hM : M ∈ maximalLocals T)
    (hdom : ∀ L ∈ maximalLocals T, OrderingLE T L M)
    (hVne : V ≠ ⊥) (hMV : M ≤ normalizer (V : Set G))
    (hspan : V = conjugateSpanBy (centralInvolutions T ⊓ V) M) :
    ∀ L : Subgroup G, IsMaximalTwoLocal L → chosenNormalizer T M V ≤ L → L = M := by
  intro L hL hNL
  have hTL := (sylow_le_chosenNormalizer T hM.2 hMV).trans hNL
  have hgen : V = conjugateSpanBy (V ⊓ centralOmega T) (L ⊓ M) := by
    apply le_antisymm
    · calc
        V = conjugateSpanBy (centralInvolutions T ⊓ V) (chosenNormalizer T M V) :=
          chosenNormalizer_span T hM.2 hMV hspan
        _ ≤ conjugateSpanBy (V ⊓ centralOmega T) (L ⊓ M) :=
          conjugateSpanBy_mono (by rw [inf_comm]) (le_inf hNL inf_le_left)
    · exact conjugateSpanBy_le inf_le_left (inf_le_right.trans hMV)
  have hLM := le_of_generated_intersection hM.1 (hdom L ⟨hL,hTL⟩) hVne
    (IsElementaryAbelian.isPGroup 2 V) hgen hMV
  exact le_antisymm hLM (hL.2 hM.1.1 hLM)

/-- Original 15.1.9(5), with ordering domination supplied by source 14.1.4. -/
theorem source_chosenNormalizer_unique
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M V : Subgroup G} [IsElementaryAbelian 2 V] (hM : IsOrderingMaximal T M)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hVne : V ≠ ⊥) (hMV : M ≤ normalizer (V : Set G))
    (hspan : V = conjugateSpanBy (centralInvolutions T ⊓ V) M) :
    ∀ L : Subgroup G, IsMaximalTwoLocal L → chosenNormalizer T M V ≤ L → L = M :=
  chosenNormalizer_unique_of_ordering T hM.1
    (source_ordering_of_centralizing_orderingMaximal hG T hempty hM hJ) hVne hMV hspan

/-- Case (II) of 3.1.5 for the actual chosen V and original H in H*(T,M). -/
theorem chosenNormalizer_qrcHypotheses (T : Sylow 2 G)
    {M H V : Subgroup G} [IsElementaryAbelian 2 V]
    (hTM : (T : Subgroup G) ≤ M) (hVM : V ≤ M)
    (hMV : M ≤ normalizer (V : Set G))
    (hspan : V = conjugateSpanBy (centralInvolutions T ⊓ V) M)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) M) :
    Chapter3.QrcHypotheses T M (chosenNormalizer T M V) H V :=
  ⟨sylow_le_chosenNormalizer T hTM hMV, inf_le_left, hH,
    module_le_chosenNormalizer T hTM hVM hMV, inf_le_left.trans hMV,
    inferInstance, chosenNormalizer_actionImage_reduced T hTM hVM hMV hspan,
    chosenNormalizer_twoCore T hTM hVM hMV hspan, Or.inr (inf_le_right.trans hMV)⟩

/-- The genuine QRC consumer, including the proved common-normal exclusion. -/
theorem source_chosenNormalizer_qrcConfiguration
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M H V : Subgroup G} [IsElementaryAbelian 2 V] (hM : IsOrderingMaximal T M)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hVM : V ≤ M) (hVne : V ≠ ⊥) (hMV : M ≤ normalizer (V : Set G))
    (hspan : V = conjugateSpanBy (centralInvolutions T ⊓ V) M)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) M) :
    ChapterD.QRCConfiguration (chosenNormalizer T M V) H (T : Subgroup G) V := by
  let d := chosenNormalizer_qrcHypotheses T hM.1.2 hVM hMV hspan hH
  exact d.toQRCConfiguration (d.no_common_normal
    (source_chosenNormalizer_unique hG T hempty hM hJ hVne hMV hspan))

/-- Uniqueness excludes the two-core alternative in the generated QRC group. -/
theorem source_chosenNormalizer_join_twoCore_eq_bot
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M H V : Subgroup G} [IsElementaryAbelian 2 V] (hM : IsOrderingMaximal T M)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hVne : V ≠ ⊥) (hMV : M ≤ normalizer (V : Set G))
    (hspan : V = conjugateSpanBy (centralInvolutions T ⊓ V) M)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) M) :
    pCore 2 (chosenNormalizer T M V ⊔ H : Subgroup G) = ⊥ :=
  twoCore_sup_eq_bot_of_unique_maximalTwoLocal_overgroup _ _ M
    (source_chosenNormalizer_unique hG T hempty hM hJ hVne hMV hspan) hH.1.2


/-- Frattini representatives identify Aut_N(V) with the literal Aut_M(V) subgroup. -/
theorem chosenNormalizer_actionImage_eq (T : Sylow 2 G) {M V : Subgroup G}
    (hTM : (T : Subgroup G) ≤ M) (hMV : M ≤ normalizer (V : Set G)) :
    ChapterD.internalActionImage (chosenNormalizer T M V) V (inf_le_left.trans hMV) =
      ChapterD.internalActionImage M V hMV := by
  apply le_antisymm
  · rintro a ⟨n,rfl⟩
    exact ⟨⟨n,n.property.1⟩,rfl⟩
  · rintro a ⟨m,rfl⟩
    obtain ⟨n,hn,c,hc,he⟩ := chosenNormalizer_factorization T hTM hMV m m.property
    refine ⟨⟨n,hn⟩,?_⟩
    apply MulEquiv.ext
    intro v
    apply Subtype.ext
    change n * v * n⁻¹ = (m : G) * v * (m : G)⁻¹
    rw [← he]
    symm
    calc
      (n*c) * v * (n*c)⁻¹ = n * (c * v * c⁻¹) * n⁻¹ := by group
      _ = n * v * n⁻¹ := by rw [← hc.2 v v.property, mul_inv_cancel_right]


/-- The complete chosen-V source normalizer and QRC conclusions of 15.1.9(5–6). -/
theorem source_lemma_15_1_9_5_6
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M V : Subgroup G} [IsElementaryAbelian 2 V] (hM : IsOrderingMaximal T M)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hVM : V ≤ M) (hVne : V ≠ ⊥) (hMV : M ≤ normalizer (V : Set G))
    (hspan : V = conjugateSpanBy (centralInvolutions T ⊓ V) M) :
    let N := chosenNormalizer T M V
    (∀ L : Subgroup G, IsMaximalTwoLocal L → N ≤ L → L = M) ∧
    N ∈ Chapter1.He G ∧ IsPReduced 2 (V.subgroupOf N) ∧
    N.pCoreIn 2 = (T : Subgroup G) ⊓ centralizer (V : Set G) ∧
    ChapterD.internalActionImage N V (inf_le_left.trans hMV) =
      ChapterD.internalActionImage M V hMV ∧
    ∀ H ∈ Chapter3.HStar (T : Subgroup G) M,
      Chapter3.QrcHypotheses T M N H V ∧ ChapterD.QRCConfiguration N H (T : Subgroup G) V := by
  refine ⟨source_chosenNormalizer_unique hG T hempty hM hJ hVne hMV hspan,
    chosenNormalizer_mem_He hG T hM.1.2 hVM hVne hMV,
    chosenNormalizer_reduced T hM.1.2 hVM hMV hspan,
    chosenNormalizer_twoCore T hM.1.2 hVM hMV hspan,
    chosenNormalizer_actionImage_eq T hM.1.2 hMV, ?_⟩
  intro H hH
  exact ⟨chosenNormalizer_qrcHypotheses T hM.1.2 hVM hMV hspan hH,
    source_chosenNormalizer_qrcConfiguration hG T hempty hM hJ hVM hVne hMV hspan hH⟩

end CFSG.Quasithin.Chapter15.Section01
