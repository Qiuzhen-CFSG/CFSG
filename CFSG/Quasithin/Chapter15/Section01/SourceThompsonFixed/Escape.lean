module

public import CFSG.Quasithin.Chapter15.Section01.SourceThompsonFixed
public import Theory.GroupTheory.PResidual.CentralizerEscape

/-!
# The escape step for the chosen Thompson fixed subgroup

For the original prepared chosen V, put W = C_V(J₁(T)) and C = C_G(Z).
The source15.1.6 residual centralizer and Sylow normalization show that,
if O²(C) fails to centralize W, it escapes the subgroup generated by M ∩ C
and O²(C) ∩ C_G(W). All subgroups and residual embeddings are literal.
The subsequent extraction of an HStar witness remains a separate source step.

Source: Aschbacher--Smith15.1.14(1), printed p.1091, its displayed inequality.
-/

public section
open Subgroup Representation Representation.BinaryOffender Stellmacher Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section01
open Section03 Section03.InitialSource ChapterA.Section05To06 ChapterD ChapterD.UniqueFactor
variable {G : Type*} [Group G] [Finite G]

theorem PreparedChosenModule.thompsonFixed_residual_escape
    (T : Sylow 2 G) {M V : Subgroup G} (hM : IsOrderingMaximal T M)
    (h : PreparedChosenModule T M V)
    (hnot : ¬ (pResidual 2 (centralizer (centralInvolutions T : Set G))).map
      (centralizer (centralInvolutions T : Set G)).subtype ≤ centralizer (thompsonFixed T V : Set G)) :
    let C := centralizer (centralInvolutions T : Set G)
    let R := (pResidual 2 C).map C.subtype
    ¬ R ≤ (M ⊓ C) ⊔ (R ⊓ centralizer (thompsonFixed T V : Set G)) := by
  let J := ChapterB.thompsonJ (T : Subgroup G) 1
  have hTJ : (T : Subgroup G) ≤ normalizer (J : Set G) := by
    intro t ht
    rw [mem_normalizer_iff_map_conj_eq]
    change (ChapterB.thompsonJ (T : Subgroup G) 1).map (MulAut.conj t).toMonoidHom = _
    rw [←ChapterB.thompsonJ_map_equiv]
    exact congrArg (fun S => ChapterB.thompsonJ S 1)
      (mem_normalizer_iff_map_conj_eq.mp ((T : Subgroup G).le_normalizer ht))
  have hTN : (T : Subgroup G) ≤ normalizer (thompsonFixed T V : Set G) :=
    (le_inf (hM.1.2.trans h.normalized)
      (hTJ.trans (normalizer_le_normalizer_centralizer _))).trans inf_normalizer_le_normalizer_inf
  have hTC : (T : Subgroup G) ≤ centralizer (centralInvolutions T : Set G) := by
    intro t ht z hz
    exact (((mem_omegaOneCenterAmbient_iff _ z).mp hz).2.2 t ht).symm
  exact residual_escape_of_not_centralizes T _ M _ hTC hM.1.2 hTN
    (h.seed_residual.trans (centralizer_le inf_le_left)) hnot


end CFSG.Quasithin.Chapter15.Section01
