module
public import CFSG.Quasithin.Chapter15.Section01.RatioReduction.ChosenSeed
public import CFSG.Quasithin.Chapter15.Section01.ChosenNormalizerSource

/-!
# Chosen-V source QRC in the proper case of15.1.2

The actual proper-orbit theorem gives complementary invariant support and
fixed summands. The complementary projection proves that the literal moved
four-space is generated by its intersection with the original central seed.
Its nonzero elementary ambient subgroup then enters A.5.7(2b), yielding the
exact normalizer core and QRC configuration for every original HStar local.
Source: Aschbacher--Smith15.1.4--5 and15.1.9(5--6), pp.1087--1089.
-/

public section
open Subgroup Representation Theory.GroupTheory Stellmacher Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section01
open Section03 Section03.InitialSource ChapterD ChapterD.UniqueFactor ChapterA.Section05To06
open ChapterD.RatioDecomposition
variable {G : Type*} [Group G] [Finite G]

theorem source_localAction_proper_orbit_chosen_seed
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hne : M ≠ Mc) :
    letI := localModule_elementary_from_source hG T
      ⟨Chapter1.mem_H_of_isTwoLocal hM.1.1.1,hM.1.2⟩
    let V := localModule T M
    let D := internalActionImage M V (le_normalizer_conjugateSpanBy _ _)
    let ρ := imageRepresentation M V (le_normalizer_conjugateSpanBy _ _)
    ∀ (U : Submodule (ZMod 2) (Additive V)) (c : FactorData ρ (Jhat ρ) U)
      (d : Decomposition c.representation), d.FittingFull →
    ∀ (π : D →* Equiv.Perm d.Index),
      (∀ g i, (c.ambientFactor d i).actor.map (MulAut.conj g).toMonoidHom =
        (c.ambientFactor d (π g i)).actor) →
      (∀ g i, (c.ambientFactor d i).space.map (ρ g) =
        (c.ambientFactor d (π g i)).space) →
      ¬ (U = ⊤ ∧ ∀ i j, ∃ g : D, π g i = j) →
      let W := (Subgroup.toAddSubgroup.symm U.toAddSubgroup).map V.subtype
      W ≤ M ∧ W ≠ ⊥ ∧ M ≤ normalizer (W : Set G) ∧ IsElementaryAbelian 2 W ∧
      W = conjugateSpanBy (centralInvolutions T ⊓ W) M := by
  let := localModule_elementary_from_source hG T
    ⟨Chapter1.mem_H_of_isTwoLocal hM.1.1.1,hM.1.2⟩
  let V := localModule T M
  let ρ := imageRepresentation M V (le_normalizer_conjugateSpanBy _ _)
  let := Jhat_normal ρ
  dsimp only
  intro U c d hd π hp hs hnt
  obtain ⟨_,_,hstable,hU0,_,_,hcompl,_⟩ :=
    source_localAction_proper_orbit_support hG T hempty hM hmany hJ hu hne
      U c d hd π hp hs hnt
  obtain ⟨hWM,hnW,hEW,hspan⟩ := source_localAction_complement_generated_seed hG T hM
    U (fixedSpace ρ (Jhat ρ)) hstable (fixedSpace_stable_of_normal ρ (Jhat ρ)) hcompl
  refine ⟨hWM,?_,hnW,hEW,hspan⟩
  intro hb
  apply hU0
  apply le_bot_iff.mp
  intro v hv
  have hx : (v.toMul : G) ∈ (Subgroup.toAddSubgroup.symm U.toAddSubgroup).map V.subtype :=
    mem_map_of_mem V.subtype
      (show v.toMul ∈ Subgroup.toAddSubgroup.symm U.toAddSubgroup from hv)
  rw [hb] at hx
  have hv0 : v = 0 := Additive.toMul.injective (Subtype.ext (Subgroup.mem_bot.mp hx))
  simpa only [hv0] using (zero_mem (⊥ : Submodule (ZMod 2) (Additive V)))
theorem source_localAction_proper_orbit_chosen_qrc
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hne : M ≠ Mc) :
    letI := localModule_elementary_from_source hG T
      ⟨Chapter1.mem_H_of_isTwoLocal hM.1.1.1,hM.1.2⟩
    let V := localModule T M
    let D := internalActionImage M V (le_normalizer_conjugateSpanBy _ _)
    let ρ := imageRepresentation M V (le_normalizer_conjugateSpanBy _ _)
    ∀ (U : Submodule (ZMod 2) (Additive V)) (c : FactorData ρ (Jhat ρ) U)
      (d : Decomposition c.representation), d.FittingFull →
    ∀ (π : D →* Equiv.Perm d.Index),
      (∀ g i, (c.ambientFactor d i).actor.map (MulAut.conj g).toMonoidHom =
        (c.ambientFactor d (π g i)).actor) →
      (∀ g i, (c.ambientFactor d i).space.map (ρ g) =
        (c.ambientFactor d (π g i)).space) →
      ¬ (U = ⊤ ∧ ∀ i j, ∃ g : D, π g i = j) →
      let W := (Subgroup.toAddSubgroup.symm U.toAddSubgroup).map V.subtype
      W ≠ ⊥ ∧
      (chosenNormalizer T M W).pCoreIn 2 = (T : Subgroup G) ⊓ centralizer (W : Set G) ∧
      ∀ H ∈ Chapter3.HStar (T : Subgroup G) M,
        Chapter3.QrcHypotheses T M (chosenNormalizer T M W) H W ∧
        ChapterD.QRCConfiguration (chosenNormalizer T M W) H (T : Subgroup G) W := by
  let := localModule_elementary_from_source hG T
    ⟨Chapter1.mem_H_of_isTwoLocal hM.1.1.1,hM.1.2⟩
  dsimp only
  intro U c d hd π hp hs hnt
  obtain ⟨hWM,hWne,hnW,hE,hspan⟩ := source_localAction_proper_orbit_chosen_seed
    hG T hempty hM hmany hJ hu hne U c d hd π hp hs hnt
  let := hE
  obtain ⟨_,_,_,hcore,_,hQ⟩ := source_lemma_15_1_9_5_6 hG T hempty hM hJ
    hWM hWne hnW hspan
  exact ⟨hWne,hcore,hQ⟩

end CFSG.Quasithin.Chapter15.Section01
