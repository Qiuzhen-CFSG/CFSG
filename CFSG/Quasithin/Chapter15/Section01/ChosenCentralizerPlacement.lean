module
public import CFSG.Quasithin.Chapter15.Section01.RatioReduction.PreparedChosen
public import CFSG.Quasithin.Chapter15.Section03.InitialSource.OddImage
/-!
# Placement of the chosen module centralizer

A nontrivial module generated by its intersection with the original central
involutions contains a nonidentity central involution. The full centralizer
of that involution belongs to the unique maximal local M_c. Therefore the
full centralizer of the chosen module lies in M_c as well.

This proves original 15.1.5(2) for every prepared chosen module, including
the proper moved four-space. Its Case-I residual-intersection consumer is
in `CaseI.SourceResidualIntersection`.

Source: Aschbacher--Smith 15.1.5(1--2), printed p.1087.
-/

public section
open Subgroup Representation Representation.BinaryOffender Stellmacher Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section01
open Section03 Section03.InitialSource ChapterA.Section05To06 ChapterD ChapterD.UniqueFactor
variable {G : Type*} [Group G] [Finite G]

theorem centralizer_le_partner_of_seed_span
    (T : Sylow 2 G) {M Mc V : Subgroup G}
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hne : V ≠ ⊥) (hspan : V = conjugateSpanBy (centralInvolutions T ⊓ V) M) :
    centralizer (V : Set G) ≤ Mc := by
  have hseed : centralInvolutions T ⊓ V ≠ ⊥ := by
    intro he
    apply hne
    rw [hspan, he]
    exact bot_unique (conjugateSpanBy_le bot_le (by
      change M ≤ normalizer (⊥ : Subgroup G)
      rw [normalizer_eq_top]
      exact le_top))
  have hi : Nontrivial (centralInvolutions T ⊓ V : Subgroup G) :=
    (nontrivial_iff_ne_bot _).mpr hseed
  obtain ⟨z, hz, hzne⟩ := (nontrivial_iff_exists_ne_one _).mp hi
  exact (centralizer_le (Set.singleton_subset_iff.mpr hz.2)).trans
    (central_involution_centralizer_le_partner T hu hz.1 hzne)

theorem PreparedChosenModule.centralizer_le_partner
    (T : Sylow 2 G) {M Mc V : Subgroup G}
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (h : PreparedChosenModule T M V) : centralizer (V : Set G) ≤ Mc :=
  centralizer_le_partner_of_seed_span T hu h.nontrivial h.seed_span

end CFSG.Quasithin.Chapter15.Section01
