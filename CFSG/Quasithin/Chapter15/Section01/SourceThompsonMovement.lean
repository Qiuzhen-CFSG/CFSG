/-!
# Thompson-center escape and movement of the actual chosen module

The original minimal outside local subgroup is generated by its two-residual
and the fixed Sylow subgroup. Thus the residual centralization from15.1.12(4)
forces the Thompson omega-center's centralizer outside the selected maximal
local group.

Quadratic ratio two implies that the chosen elementary module has dimension
at least two, so the Sylow two-rank is greater than one. If its first Thompson
subgroup fixed the chosen module, Thompson heredity would make its omega-center
invariant under the literal chosen normalizer. The established unique maximal
two-local overgroup would then contain the full omega-center normalizer,
contradicting centralizer escape. The final consumer retains the actual chosen
subgroup, including the proper moved support from15.1.4.

Source: Aschbacher--Smith15.1.13(1--2), printed pp.1090--1091, using
B.2.3(1,3) and15.1.9(5). The only earlier-source premise is15.1.12(4),
with the mapped two-residual O²(H), not the two-core O₂(H).
-/

public section
open Subgroup Representation Representation.BinaryOffender Stellmacher Theory.GroupTheory
open scoped IsMulCommutative ENNReal
namespace CFSG.Quasithin.Chapter15.Section01
open Section03 Section03.InitialSource ChapterA.Section05To06 ChapterD ChapterD.UniqueFactor
variable {G : Type*} [Group G] [Finite G]

/-- Source15.1.13(1), from the actual outside local family and15.1.12(4). -/
theorem source_thompson_one_centralizer_escape
    (T : Sylow 2 G) {M : Subgroup G}
    (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hres : ∀ H ∈ Chapter3.HStar (T : Subgroup G) M,
      omegaOneCenterAmbient (ChapterB.thompsonJ (T : Subgroup G) 1) ≤
        centralizer ((pResidual 2 H).map H.subtype : Set G)) :
    ¬ centralizer (omegaOneCenterAmbient (ChapterB.thompsonJ (T : Subgroup G) 1) : Set G) ≤ M := by
  have hout : Chapter3.HasMaximalOutside T M := by
    obtain ⟨L,hL,K,hK,hne⟩ := (Set.one_lt_ncard_iff_nontrivial_and_finite.mp hmany).1
    by_cases hLM : L = M
    · exact Chapter3.hasMaximalOutside_of_two_distinct hM hK.1 hTM hK.2
        (fun he => hne (hLM.trans he.symm))
    · exact Chapter3.hasMaximalOutside_of_two_distinct hM hL.1 hTM hL.2 hLM
  obtain ⟨H,hH⟩ := Chapter3.exists_HStar_of_hasMaximalOutside hout
  have hgen : (pResidual 2 H).map H.subtype ⊔ (T : Subgroup G) = H := by
    let S := T.subtype hH.1.1.2
    have he := congrArg (map H.subtype) (pResidual_sup_sylow_eq_top S)
    change (pResidual 2 H ⊔ (S : Subgroup H)).map H.subtype = (⊤ : Subgroup H).map H.subtype at he
    rw [Subgroup.map_sup, ←MonoidHom.range_eq_map, range_subtype] at he
    have hS : (S : Subgroup H).map H.subtype = (T : Subgroup G) :=
      map_subgroupOf_eq_of_le hH.1.1.2
    rwa [hS] at he
  intro hc
  apply hH.1.2
  rw [←hgen]
  exact sup_le (((le_centralizer_iff.mp (hres H hH))).trans hc) hTM

private theorem finrank_gt_one_of_quadraticRatio_two
    {D W : Type*} [Group D] [Finite D] [AddCommGroup W] [Module (ZMod 2) W]
    [FiniteDimensional (ZMod 2) W] (ρ : Representation (ZMod 2) D W)
    (hq : quadraticRatio ρ = 2) : 1 < Module.finrank (ZMod 2) W := by
  by_contra! hd
  obtain ⟨A,hA,hquad,_⟩ := (quadraticRatio_le_iff ρ (by simp : (2 : ℝ≥0∞) ≠ ⊤)).mp hq.le
  have hc : fixedCodim ρ A ≤ rank A := by
    have hh := fixedCodim_add_finrank ρ A
    have hr := hA.rank_pos
    omega
  have hh := (quadraticRatio_le_one_iff ρ).mpr ⟨A,⟨hA,hc⟩,hquad⟩
  rw [hq] at hh
  norm_num at hh

/-- The chosen ratio-two action supplies the rank needed for Thompson heredity. -/
theorem chosen_twoRank_gt_one_of_quadraticRatio_two
    (T : Sylow 2 G) {M V : Subgroup G} [IsElementaryAbelian 2 V]
    (hTM : (T : Subgroup G) ≤ M) (hVM : V ≤ M)
    (hMV : M ≤ normalizer (V : Set G))
    (hq : quadraticRatio (imageRepresentation M V hMV) = 2) :
    1 < ChapterB.twoRank (T : Subgroup G) := by
  let : (V.subgroupOf M).Normal := normal_subgroupOf_of_le_normalizer hMV
  let := IsElementaryAbelian.subgroupOf hVM (p := 2)
  have hh := (IsElementaryAbelian.isPGroup 2 (V.subgroupOf M)).le_sylow_of_normal (T.subtype hTM)
  have hVT : V ≤ (T : Subgroup G) := by
    simpa only [map_subgroupOf_eq_of_le hVM, Sylow.coe_subtype,
      map_subgroupOf_eq_of_le hTM] using map_mono (f := M.subtype) hh
  obtain ⟨A,hA⟩ := elementaryAbelianMaxSubgroups_nonempty (T : Subgroup G)
  have hc : Nat.card V ≤ elementaryAbelianMaxOrder (T : Subgroup G) := by
    rw [←elementaryAbelianMaxSubgroups_card_eq _ _ hA]
    exact hA.2.2 V hVT inferInstance
  have hcard : Nat.card V = 2 ^ Module.finrank (ZMod 2) (Additive V) := by
    exact (Nat.card_congr (Additive.ofMul : V ≃ Additive V)).trans (by
      simpa using (Module.natCard_eq_pow_finrank (K := ZMod 2) (V := Additive V)))
  rw [hcard,ChapterB.maxOrder_eq_two_pow_rank] at hc
  have hr := (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp hc
  exact (finrank_gt_one_of_quadraticRatio_two _ hq).trans_le hr

private theorem normalizer_le_normalizer_thompson_omega (R : Subgroup G) :
    normalizer (R : Set G) ≤
      normalizer (omegaOneCenterAmbient (ChapterB.thompsonJ R 1) : Set G) := by
  intro g hg
  rw [mem_normalizer_iff_map_conj_eq] at hg ⊢
  change R.map (MulAut.conj g).toMonoidHom = R at hg
  change (omegaOneCenterAmbient (ChapterB.thompsonJ R 1)).map (MulAut.conj g).toMonoidHom = _
  rw [←omegaOneCenterAmbient_map_injective _ (MulAut.conj g).injective,
    ←ChapterB.thompsonJ_map_equiv,hg]

/-- Source15.1.13(2), for the literal chosen elementary subgroup. -/
theorem source_chosen_thompson_one_moves
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M V : Subgroup G} [IsElementaryAbelian 2 V] (hM : IsOrderingMaximal T M)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hVM : V ≤ M) (hVne : V ≠ ⊥) (hMV : M ≤ normalizer (V : Set G))
    (hspan : V = conjugateSpanBy (centralInvolutions T ⊓ V) M)
    (hq : quadraticRatio (imageRepresentation M V hMV) = 2)
    (hres : ∀ H ∈ Chapter3.HStar (T : Subgroup G) M,
      omegaOneCenterAmbient (ChapterB.thompsonJ (T : Subgroup G) 1) ≤
        centralizer ((pResidual 2 H).map H.subtype : Set G)) :
    ⁅V,ChapterB.thompsonJ (T : Subgroup G) 1⁆ ≠ ⊥ := by
  let J := ChapterB.thompsonJ (T : Subgroup G) 1
  let E := omegaOneCenterAmbient J
  let R := (T : Subgroup G) ⊓ centralizer (V : Set G)
  have hr : 1 < ChapterB.twoRank (T : Subgroup G) :=
    chosen_twoRank_gt_one_of_quadraticRatio_two T hM.1.2 hVM hMV hq
  have hJJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ J := by
    rw [←ChapterB.thompsonJ_zero]
    exact ChapterB.lemma_B_2_3_1 _ (by omega : 0 ≤ 1) hr
  have hZE : centralInvolutions T ≤ E := by
    intro z hz
    have hzc := (mem_omegaOneCenterAmbient_iff _ z).mp hz
    have hzJ := (mem_omegaOneCenterAmbient_iff _ z).mp
      (omegaCenter_le_omegaCenter_maxJ (T : Subgroup G) hz)
    exact (mem_omegaOneCenterAmbient_iff _ z).mpr
      ⟨hJJ hzJ.1,hzc.2.1,fun j hj => hzc.2.2 j (ChapterB.thompsonJ_le _ _ hj)⟩
  have hEne : E ≠ ⊥ := fun he => centralInvolutions_ne_bot_of_maximal_local T hM.1
    (bot_unique (hZE.trans_eq he))
  have hesc : ¬ centralizer (E : Set G) ≤ M :=
    source_thompson_one_centralizer_escape T hM.1.1 hM.1.2 hmany hres
  intro hmove
  have hJR : J ≤ R := le_inf (ChapterB.thompsonJ_le _ _)
    (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hmove))
  have hJeq : J = ChapterB.thompsonJ R 1 :=
    ChapterB.lemma_B_2_3_3 _ _ hr hJR inf_le_left
  have hnE : chosenNormalizer T M V ≤ normalizer (E : Set G) := by
    change chosenNormalizer T M V ≤ normalizer (omegaOneCenterAmbient J : Set G)
    rw [hJeq]
    exact inf_le_right.trans (normalizer_le_normalizer_thompson_omega R)
  let := omegaOneCenterAmbient_elementaryAbelian J
  have hl : IsTwoLocal (normalizer (E : Set G)) :=
    ⟨E,hEne,IsElementaryAbelian.isPGroup 2 E,rfl⟩
  obtain ⟨L,hNL,hL⟩ := hl.exists_le_maximal
  have hLM : L = M := source_chosenNormalizer_unique hG T hempty hM hJ hVne hMV hspan
    L hL (hnE.trans hNL)
  exact hesc ((centralizer_le_normalizer (E : Set G)).trans (hNL.trans_eq hLM))

/-- The original prepared-chosen consumer of source15.1.13(1--2). -/
theorem PreparedChosenModule.thompson_escape_and_movement
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M V : Subgroup G} (hM : IsOrderingMaximal T M)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (h : PreparedChosenModule T M V)
    (hres : ∀ H ∈ Chapter3.HStar (T : Subgroup G) M,
      omegaOneCenterAmbient (ChapterB.thompsonJ (T : Subgroup G) 1) ≤
        centralizer ((pResidual 2 H).map H.subtype : Set G)) :
    (¬ centralizer (omegaOneCenterAmbient (ChapterB.thompsonJ (T : Subgroup G) 1) : Set G) ≤ M) ∧
      ⁅V,ChapterB.thompsonJ (T : Subgroup G) 1⁆ ≠ ⊥ := by
  let := h.elementary
  exact ⟨source_thompson_one_centralizer_escape T hM.1.1 hM.1.2 hmany hres,
    source_chosen_thompson_one_moves hG T hempty hM hmany hJ h.le_selected h.nontrivial
      h.normalized h.seed_span h.quadratic_ratio hres⟩

end CFSG.Quasithin.Chapter15.Section01
