module

public import CFSG.Quasithin.Chapter15.Section01.SourceCentralizing.SourceResidualSelectionDecomposableQuinticCoreThompson
public import Theory.GroupTheory.ElementaryThompsonNormalizerControl
public import Theory.GroupTheory.CommutatorPreimage
import all CFSG.Quasithin.ChapterD.Section01.UniqueFactor.SourceThompson

/-!
# Normalization or actual FF action on the quintic fixed span

The elementary subgroup F generated by the C_G(V(Mc))-conjugates of the
original fixed subgroup E is normal in Mc and lies in its two-core.
If J(T) centralizes F, the relative Thompson Frattini argument writes Mc
as the join of its J(T)-normalizer and C_Mc(F). The first lies in M∩Mc
and normalizes E, while the second centralizes E. Thus Mc normalizes E.
Otherwise the literal Mc-action on F is FF by maximum elementary replacement.
This retains F itself and asserts neither its reducedness nor an FF action
on F/V(Mc).

The deliberate internal import reuses the generic maximum elementary FF
criterion from the same source-proof package, as in the existing span proofs.
No private declaration occurs in the public theorem statement.
-/

public section
open Subgroup Stellmacher Theory.GroupTheory Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section01
open Section03 Section03.InitialSource ChapterA.Section05To06 ChapterD ChapterD.UniqueFactor
open ChapterD.RatioDecomposition DecomposableMarker
variable {G : Type*} [Group G] [Finite G]

/-- On the original quintic source, the actual partner either normalizes E
or acts as an FF group on the same elementary centralizer span F. -/
theorem PreparedChosenModule.decomposable_five_partner_normalizes_or_fixed_span_ff
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc V : Subgroup G} (hM : IsOrderingMaximal T M)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (h : PreparedChosenModule T M V) (hfull : V = localModule T M) :
    letI := h.elementary
    ∀ {U : Submodule (ZMod 2) (Additive V)}
      (c : FactorData (imageRepresentation M V h.normalized)
        (Jhat (imageRepresentation M V h.normalized)) U)
      (d : Decomposition c.representation), d.FittingFull →
    ∀ (s : DecomposableMarker.ThompsonPair (T := T) h.normalized c d)
      (π : internalActionImage M V h.normalized →* Equiv.Perm d.Index),
      (∀ g k, (c.ambientFactor d k).actor.map (MulAut.conj g).toMonoidHom =
        (c.ambientFactor d (π g k)).actor) →
      (∀ g k, (c.ambientFactor d k).space.map (imageRepresentation M V h.normalized g) =
        (c.ambientFactor d (π g k)).space) →
      SourceCases.Decomposable (imageRepresentation M V h.normalized) (T : Subgroup G) M
        (actionHom M V h.normalized).rangeRestrict c d π →
      cubicRatio (imageRepresentation M V h.normalized) = 2 → s.prime = 5 →
      let Uc := localModule T Mc
      let E := thompsonFixed T V
      let F := conjugateSpanBy E (centralizer (Uc : Set G))
      Mc ≤ normalizer (E : Set G) ∨
        ∃ (hn : Mc ≤ normalizer (F : Set G)) (he : IsElementaryAbelian 2 F),
          letI := he
          ¬ elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (F : Set G) ∧
            IsFFModule (imageRepresentation Mc F hn) := by
  let := h.elementary
  intro U c d hd s π hp hs hdec hq hfive
  let Uc := localModule T Mc
  let E := thompsonFixed T V
  let C := centralizer (Uc : Set G)
  let Q := C.pCoreIn 2
  let F := conjugateSpanBy E C
  obtain ⟨_,_,hQT,_,_,_,_,_⟩ := h.decomposable_five_partner_kernel_core
    hG T hempty hM hmany hJ hu hfull c d hd s π hp hs hdec hq hfive
  obtain ⟨_,_,hFA,heF,_,hnF⟩ := h.decomposable_five_partner_fixed_envelope
    hG T hempty hM hmany hJ hu hfull c d hd s π hp hs hdec hq hfive
  have hJQ : elementaryAbelianMaxJ Q ≤ Q := sSup_le fun _ hA => hA.1
  have hFQ : F ≤ Q := by
    intro f hf
    exact hJQ ((mem_omegaOneCenterAmbient_iff _ _).mp (hFA hf)).1
  have hMcC : Mc ∈ maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) :=
    hu ▸ Set.mem_singleton Mc
  have hTMc : (T : Subgroup G) ≤ Mc := by
    intro t ht
    exact hMcC.2 (fun z hz => (centralInvolutions_le_centralizer_sylow T hz t ht).symm)
  have hIE : M ⊓ Mc ≤ normalizer (E : Set G) :=
    (h.decomposable_five_partner_control hG T hempty hM hmany hJ hu
      hfull c d hd s π hp hs hdec hq hfive).2.1
  by_cases hj : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (F : Set G)
  · left
    let S := T.subtype hTMc
    let D := (centralizer (F : Set G)).subgroupOf Mc
    let : D.Normal := normal_subgroupOf_of_le_normalizer
      (hnF.trans (normalizer_le_normalizer_centralizer F))
    have hm : (elementaryAbelianMaxJ (S : Subgroup Mc)).map Mc.subtype =
        elementaryAbelianMaxJ (T : Subgroup G) := by
      rw [←elementaryAbelianMaxJ_map_injective Mc.subtype Mc.subtype_injective]
      exact congrArg elementaryAbelianMaxJ (map_subgroupOf_eq_of_le hTMc)
    have hJD : elementaryAbelianMaxJ (S : Subgroup Mc) ≤ D := by
      intro j hjS
      exact hj (hm ▸ mem_map_of_mem Mc.subtype hjS)
    have hgen := elementaryAbelianMaxJ_frattini_of_le_normal S D hJD
    have hbound : normalizer (elementaryAbelianMaxJ (S : Subgroup Mc) : Set Mc) ⊔ D ≤
        (normalizer (E : Set G)).subgroupOf Mc := by
      apply sup_le
      · intro n hn
        have hnJ : (n : G) ∈ normalizer (elementaryAbelianMaxJ (T : Subgroup G) : Set G) := by
          rw [←hm]
          exact le_normalizer_map Mc.subtype (mem_map_of_mem Mc.subtype hn)
        exact hIE ⟨(source_centralizing_baumann_control hG T hM hJ).2.2.2.2.2.1 hnJ,n.property⟩
      · intro n hn
        exact (Subgroup.centralizer_le_normalizer (E : Set G))
          ((centralizer_le (le_conjugateSpanBy E C)) hn)
    rw [hgen] at hbound
    intro n hn
    exact hbound (show (⟨n,hn⟩ : Mc) ∈ ⊤ from mem_top _)
  · right
    let := heF
    exact ⟨hnF,heF,hj,image_isFF_of_maxJ_not_centralizes Mc (T : Subgroup G) F
      hTMc (hFQ.trans hQT) hnF hj⟩


/-- Failure of actual normalization forces Thompson movement even modulo
the original partner module, without transporting Thompson subgroups through a quotient. -/
theorem PreparedChosenModule.decomposable_five_partner_normalizes_or_section_movement
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc V : Subgroup G} (hM : IsOrderingMaximal T M)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (h : PreparedChosenModule T M V) (hfull : V = localModule T M) :
    letI := h.elementary
    ∀ {U : Submodule (ZMod 2) (Additive V)}
      (c : FactorData (imageRepresentation M V h.normalized)
        (Jhat (imageRepresentation M V h.normalized)) U)
      (d : Decomposition c.representation), d.FittingFull →
    ∀ (s : DecomposableMarker.ThompsonPair (T := T) h.normalized c d)
      (π : internalActionImage M V h.normalized →* Equiv.Perm d.Index),
      (∀ g k, (c.ambientFactor d k).actor.map (MulAut.conj g).toMonoidHom =
        (c.ambientFactor d (π g k)).actor) →
      (∀ g k, (c.ambientFactor d k).space.map (imageRepresentation M V h.normalized g) =
        (c.ambientFactor d (π g k)).space) →
      SourceCases.Decomposable (imageRepresentation M V h.normalized) (T : Subgroup G) M
        (actionHom M V h.normalized).rangeRestrict c d π →
      cubicRatio (imageRepresentation M V h.normalized) = 2 → s.prime = 5 →
      let Uc := localModule T Mc
      let E := thompsonFixed T V
      let F := conjugateSpanBy E (centralizer (Uc : Set G))
      Mc ≤ normalizer (E : Set G) ∨
        ¬ ⁅elementaryAbelianMaxJ (T : Subgroup G),F⁆ ≤ Uc := by
  let := h.elementary
  intro U c d hd s π hp hs hdec hq hfive
  let Uc := localModule T Mc
  let E := thompsonFixed T V
  let C := centralizer (Uc : Set G)
  let F := conjugateSpanBy E C
  obtain ⟨_,hIE,hUE⟩ := h.decomposable_five_partner_control
    hG T hempty hM hmany hJ hu hfull c d hd s π hp hs hdec hq hfive
  have hnF : Mc ≤ normalizer (F : Set G) :=
    (h.decomposable_five_partner_fixed_envelope hG T hempty hM hmany hJ hu
      hfull c d hd s π hp hs hdec hq hfive).2.2.2.2.2
  have hnU : Mc ≤ normalizer (Uc : Set G) := le_normalizer_conjugateSpanBy _ _
  have hMcC : Mc ∈ maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) :=
    hu ▸ Set.mem_singleton Mc
  have hTMc : (T : Subgroup G) ≤ Mc := by
    intro t ht
    exact hMcC.2 (fun z hz => (centralInvolutions_le_centralizer_sylow T hz t ht).symm)
  by_cases hmove : ⁅elementaryAbelianMaxJ (T : Subgroup G),F⁆ ≤ Uc
  · left
    let K := commutatorPreimage Mc F Uc
    have hnK : Mc ≤ normalizer (K : Set G) :=
      commutatorPreimage_normalized Mc F Uc Mc hnU Mc.le_normalizer hnF hnU
    have hKE : K ≤ normalizer (E : Set G) :=
      le_normalizer_iff_commutator_le_right.mpr
        (((commutator_mono le_rfl (le_conjugateSpanBy E C)).trans
          (commutator_commutatorPreimage_le Mc F Uc hnU)).trans hUE)
    let S := T.subtype hTMc
    let D := K.subgroupOf Mc
    let : D.Normal := normal_subgroupOf_of_le_normalizer hnK
    have hm : (elementaryAbelianMaxJ (S : Subgroup Mc)).map Mc.subtype =
        elementaryAbelianMaxJ (T : Subgroup G) := by
      rw [←elementaryAbelianMaxJ_map_injective Mc.subtype Mc.subtype_injective]
      exact congrArg elementaryAbelianMaxJ (map_subgroupOf_eq_of_le hTMc)
    have hJMc : elementaryAbelianMaxJ (T : Subgroup G) ≤ Mc :=
      (sSup_le fun _ hA => hA.1).trans hTMc
    have hJK : elementaryAbelianMaxJ (T : Subgroup G) ≤ K :=
      le_commutatorPreimage hJMc hmove
    have hJD : elementaryAbelianMaxJ (S : Subgroup Mc) ≤ D := by
      intro j hj
      exact hJK (hm ▸ mem_map_of_mem Mc.subtype hj)
    have hgen := elementaryAbelianMaxJ_frattini_of_le_normal S D hJD
    have hbound : normalizer (elementaryAbelianMaxJ (S : Subgroup Mc) : Set Mc) ⊔ D ≤
        (normalizer (E : Set G)).subgroupOf Mc := by
      apply sup_le
      · intro n hn
        have hnJ : (n : G) ∈ normalizer (elementaryAbelianMaxJ (T : Subgroup G) : Set G) := by
          rw [←hm]
          exact le_normalizer_map Mc.subtype (mem_map_of_mem Mc.subtype hn)
        exact hIE ⟨(source_centralizing_baumann_control hG T hM hJ).2.2.2.2.2.1 hnJ,n.property⟩
      · intro n hn
        exact hKE hn
    rw [hgen] at hbound
    intro n hn
    exact hbound (show (⟨n,hn⟩ : Mc) ∈ ⊤ from mem_top _)
  · exact Or.inr hmove

end CFSG.Quasithin.Chapter15.Section01
