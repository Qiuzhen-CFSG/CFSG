private theorem maximal_three_core {A : Type*} [Group A] [Finite A]
    (e : (A ⧸ pCore 2 A) ≃* Matrix.PSL3Two.SL)
    (S : Sylow 2 A) (P : Subgroup A) (hSP : (S : Subgroup A) < P)
    (hP : IsCoatom P) :
    P.index = 7 ∧ Nonempty ((P ⧸ pCore 2 P) ≃* Equiv.Perm (Fin 3)) ∧
      IsLinearMaximalParabolic (P.map (QuotientGroup.mk' (pCore 2 A))) 3 (ZMod 2) := by
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 A))
  have hq : Function.Surjective q := e.surjective.comp (QuotientGroup.mk'_surjective _)
  have hk : q.ker = pCore 2 A := by
    rw [MonoidHom.ker_comp_of_injective _ _ e.injective,QuotientGroup.ker_mk']
  have hkS : q.ker ≤ (S : Subgroup A) := hk ▸ pCore_isPGroup.le_sylow_of_normal S
  let B := P.map q
  have hBS : (S.mapSurjective hq : Subgroup Matrix.PSL3Two.SL) ≤ B := map_mono hSP.le
  have hB : B ≠ ⊤ := by
    intro he
    have hh := comap_map_eq_self (hkS.trans hSP.le)
    change B.comap q = P at hh
    rw [he,comap_top] at hh
    exact hP.ne_top hh.symm
  have hn : ¬ IsPGroup 2 B := by
    intro hp
    have hp' := hp.comap_of_ker_isPGroup q (hk ▸ pCore_isPGroup)
    rw [comap_map_eq_self (hkS.trans hSP.le)] at hp'
    exact hSP.ne ((S.is_maximal' hp' hSP.le).symm)
  obtain ⟨t,_,ht⟩ := Matrix.PSL3Two.exists_sylow_line_marking
    Matrix.PSL3Two.equiv (S.mapSurjective hq) B hBS hB hn
  let b : B ≃* Equiv.Perm (Fin 4) :=
    ((t.subgroupMap B).trans (MulEquiv.subgroupCongr ht)).trans
      Matrix.PSL3Two.MarkedAutomorphisms.lineEquivSymmetric
  have hc : Nat.card B = 24 := by
    rw [Nat.card_congr b.toEquiv,Nat.card_perm]
    norm_num
  have hi : B.index = 7 := by
    have hh := B.index_mul_card
    rw [hc,Matrix.PSL3Two.card_SL] at hh
    omega
  have hfker : IsPGroup 2 (q.subgroupMap P).ker := by
    have he : (q.subgroupMap P).ker = q.ker.subgroupOf P := by
      ext x
      exact Subtype.ext_iff
    rw [he,hk]
    exact pCore_isPGroup.comap_subtype
  refine ⟨((P.index_map_eq hq (hkS.trans hSP.le)).symm.trans hi),
    ⟨((q.subgroupMap P).pCoreQuotientEquiv (q.subgroupMap_surjective P) hfker).trans
      (Matrix.PSL3Two.ParabolicCoreModel.coreQuotientEquiv b)⟩,?_⟩
  let W : Submodule (ZMod 2) (Fin 3 → ZMod 2) := {
    carrier := {v | v 2 = 0}
    zero_mem' := rfl
    add_mem' := by intro u v hu hv; change u 2 + v 2 = 0; rw [hu,hv,add_zero]
    smul_mem' := by intro a v hv; change a * v 2 = 0; rw [hv,mul_zero] }
  refine ⟨e.trans t,W,?_,?_,?_⟩
  · intro hz
    have hh : (![1,0,0] : Fin 3 → ZMod 2) ∈ W := rfl
    rw [hz,Submodule.mem_bot] at hh
    have hh0 := congrFun hh 0
    simp at hh0
  · intro ht
    have hh : (![0,0,1] : Fin 3 → ZMod 2) ∈ W := ht ▸ Submodule.mem_top
    simp [W] at hh
  · have hm : (P.map (QuotientGroup.mk' (pCore 2 A))).map
        (e.trans t).toMonoidHom = Matrix.PSL3Two.lineParabolicSL := by
      change (P.map (QuotientGroup.mk' (pCore 2 A))).map
        (t.toMonoidHom.comp e.toMonoidHom) = _
      simpa only [B,q,←map_map] using ht
    rw [hm]
    ext g
    rw [Matrix.PSL3Two.lineParabolicSL,linearStabilizer,
      Subgroup.mem_comap,Submodule.stabilizer_coe,
      MulAction.mem_stabilizer_set,MulAction.mem_stabilizer_set]
    rfl

/-- The two literal maximal Sylow overgroups and their complete interval.
They are subgroups of the original ambient group, with intrinsic maximality
and two-core quotients on their actual carriers. -/
structure BinaryThreeParabolicInterval (K S : Subgroup G) where
  sylow : Chapter1.IsSylowIn 2 S K
  left : Subgroup G
  right : Subgroup G
  left_le : left ≤ K
  right_le : right ≤ K
  sylow_left : S < left
  sylow_right : S < right
  left_maximal : IsCoatom (left.subgroupOf K)
  right_maximal : IsCoatom (right.subgroupOf K)
  intersection : left ⊓ right = S
  generated : left ⊔ right = K
  left_fitting : generalizedFitting left = pCore 2 left
  right_fitting : generalizedFitting right = pCore 2 right
  left_parabolic : IsLinearMaximalParabolic
    ((left.subgroupOf K).map (QuotientGroup.mk' (pCore 2 K))) 3 (ZMod 2)
  right_parabolic : IsLinearMaximalParabolic
    ((right.subgroupOf K).map (QuotientGroup.mk' (pCore 2 K))) 3 (ZMod 2)
  left_index : (left.subgroupOf K).index = 7
  right_index : (right.subgroupOf K).index = 7
  left_quotient : Nonempty ((left ⧸ pCore 2 left) ≃* Equiv.Perm (Fin 3))
  right_quotient : Nonempty ((right ⧸ pCore 2 right) ≃* Equiv.Perm (Fin 3))
  exhaustive : ∀ P : Subgroup G, S ≤ P → P ≤ K →
    P = S ∨ P = left ∨ P = right ∨ P = K

/-- Construct the whole Sylow interval on any binary-three member of the
original local family. Ambient C-componenthood is not required. -/
theorem localFamily_binaryThree_interval (d : CaseIComponentData T M Mc V)
    {K : Subgroup G} (hK : K ∈ Chapter1.LIn d.G1 d.S)
    (hf : generalizedFitting K = pCore 2 K)
    (e : (K ⧸ pCore 2 K) ≃* Matrix.PSL3Two.SL) :
    Nonempty (BinaryThreeParabolicInterval K (d.S ⊓ K)) := by
  obtain ⟨S,hS⟩ := ComponentModels.source20_sylow_intersection hK.2
  let q := (e.trans Matrix.PSL3Two.equiv).toMonoidHom.comp (QuotientGroup.mk' (pCore 2 K))
  have hq : Function.Surjective q :=
    (e.trans Matrix.PSL3Two.equiv).surjective.comp (QuotientGroup.mk'_surjective _)
  have hk : q.ker = pCore 2 K := by
    rw [MonoidHom.ker_comp_of_injective _ _ (e.trans Matrix.PSL3Two.equiv).injective,
      QuotientGroup.ker_mk']
  obtain ⟨P,Q,hP,hQ,hPQ,hI,hSP,hSQ,_,_,hall⟩ :=
    Matrix.PSL3Two.two_kernel_parabolics S q hq (hk ▸ pCore_isPGroup)
  have hgen : P ⊔ Q = ⊤ := by
    apply hP.2
    apply lt_of_le_of_ne le_sup_left
    intro he
    have hQP : Q ≤ P := le_sup_right.trans_eq he.symm
    have hEq : Q = P := by
      by_contra hn
      exact hP.ne_top (hQ.2 P (lt_of_le_of_ne hQP hn))
    exact hPQ hEq.symm
  have hfit (D : Subgroup K) (hSD : (S : Subgroup K) ≤ D) :
      generalizedFitting D = pCore 2 D :=
    generalizedFitting_eq_pCore_of_normalized_by_pCore D hf
      ((pCore_isPGroup.le_sylow_of_normal S).trans (hSD.trans D.le_normalizer))
  obtain ⟨hPi,⟨ep⟩,hPpar⟩ := maximal_three_core e S P hSP hP
  obtain ⟨hQi,⟨eq⟩,hQpar⟩ := maximal_three_core e S Q hSQ hQ
  let B := P.map K.subtype
  let C := Q.map K.subtype
  let b : P ≃* B := P.equivMapOfInjective K.subtype K.subtype_injective
  let c : Q ≃* C := Q.equivMapOfInjective K.subtype K.subtype_injective
  have hBK : B.subgroupOf K = P := comap_map_eq_self_of_injective K.subtype_injective _
  have hCK : C.subgroupOf K = Q := comap_map_eq_self_of_injective K.subtype_injective _
  refine ⟨⟨⟨S,hS⟩,B,C,map_subtype_le _,map_subtype_le _,?_,?_,hBK ▸ hP,hCK ▸ hQ,
    ?_,?_,?_,?_,hBK ▸ hPpar,hCK ▸ hQpar,hBK ▸ hPi,hCK ▸ hQi,?_,?_,?_⟩⟩
  · rw [←hS]
    exact (map_lt_map_iff_of_injective K.subtype_injective).mpr hSP
  · rw [←hS]
    exact (map_lt_map_iff_of_injective K.subtype_injective).mpr hSQ
  · rw [←map_inf _ _ _ K.subtype_injective,hI,hS]
  · rw [←Subgroup.map_sup,hgen,←MonoidHom.range_eq_map,range_subtype]
  · rw [←map_generalizedFitting_equiv b,←pCore_map_iso 2 b,hfit P hSP.le]
  · rw [←map_generalizedFitting_equiv c,←pCore_map_iso 2 c,hfit Q hSQ.le]
  · exact ⟨(QuotientGroup.congr _ _ b (pCore_map_iso 2 b)).symm.trans ep⟩
  · exact ⟨(QuotientGroup.congr _ _ c (pCore_map_iso 2 c)).symm.trans eq⟩
  · intro D hSD hDK
    have hs : (S : Subgroup K) ≤ D.subgroupOf K := by
      intro x hx
      exact hSD (hS ▸ mem_map_of_mem K.subtype hx)
    rcases hall (D.subgroupOf K) hs with he | he | he | he
    · exact Or.inl (by rw [←map_subgroupOf_eq_of_le hDK,he,hS])
    · exact Or.inr (Or.inl (by rw [←map_subgroupOf_eq_of_le hDK,he]))
    · exact Or.inr (Or.inr (Or.inl (by rw [←map_subgroupOf_eq_of_le hDK,he])))
    · exact Or.inr (Or.inr (Or.inr (le_antisymm hDK (subgroupOf_eq_top.mp he))))


private theorem cubic_generates {K S P : Subgroup G}
    (hS : Chapter1.IsSylowIn 2 S K) (hSP : S ≤ P) (hPK : P ≤ K)
    (e : (P ⧸ pCore 2 P) ≃* Equiv.Perm (Fin 3)) :
    (primeToResidual 3 P).map P.subtype ⊔ S = P := by
  obtain ⟨Q,hQ⟩ := hS.restrict hSP hPK
  have hh := congrArg (Subgroup.map P.subtype)
    (show primeToResidual 3 P ⊔ (Q : Subgroup P) = ⊤ by
      rw [←SymmetricThreeTwoCore.twoResidual_eq_primeToThree e]
      exact pResidual_sup_sylow_eq_top Q)
  simpa only [Subgroup.map_sup,hQ,←MonoidHom.range_eq_map,range_subtype] using hh

/-- Each parabolic is generated by the original Sylow intersection and
its literal O^{3′}; in particular that residual escapes the other parabolic. -/
theorem BinaryThreeParabolicInterval.cubic_residuals {K S : Subgroup G}
    (i : BinaryThreeParabolicInterval K S) :
    (primeToResidual 3 i.left).map i.left.subtype ⊔ S = i.left ∧
      (primeToResidual 3 i.right).map i.right.subtype ⊔ S = i.right ∧
      ¬ (primeToResidual 3 i.left).map i.left.subtype ≤ i.right ∧
      ¬ (primeToResidual 3 i.right).map i.right.subtype ≤ i.left := by
  obtain ⟨eL⟩ := i.left_quotient
  obtain ⟨eR⟩ := i.right_quotient
  have hl := cubic_generates i.sylow i.sylow_left.le i.left_le eL
  have hr := cubic_generates i.sylow i.sylow_right.le i.right_le eR
  refine ⟨hl,hr,?_,?_⟩
  · intro hh
    have hle : i.left ≤ i.right := hl ▸ sup_le hh i.sylow_right.le
    have he : i.left = S := (inf_eq_left.mpr hle).symm.trans i.intersection
    exact i.sylow_left.ne he.symm
  · intro hh
    have hle : i.right ≤ i.left := hr ▸ sup_le hh i.sylow_left.le
    have he : i.right = S := (inf_eq_right.mpr hle).symm.trans i.intersection
    exact i.sylow_right.ne he.symm

/-- The two original intersections occupy the same literal interval.
The Sylow possibility is retained until the source fixed-space argument
excludes it; maximality is not silently inferred from properness. -/
theorem localFamily_binaryThree_intersections (d : CaseIComponentData T M Mc V)
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    {K : Subgroup G} (hK : K ∈ Chapter1.LIn d.G1 d.S) (hout : ¬ K ≤ d.MZ)
    (i : BinaryThreeParabolicInterval K (d.S ⊓ K)) :
    (d.MZ ⊓ K = d.S ⊓ K ∨ d.MZ ⊓ K = i.left ∨ d.MZ ⊓ K = i.right) ∧
      (M ⊓ K = d.S ⊓ K ∨ M ⊓ K = i.left ∨ M ⊓ K = i.right) := by
  have hMc : Mc ∈ maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) :=
    hu ▸ Set.mem_singleton Mc
  have hSMZ : d.S ≤ d.MZ := by
    refine le_inf d.S_le_G1 ?_
    intro x hx
    exact hMc.2 (fun z hz =>
      (centralInvolutions_le_centralizer_sylow T hz x (d.S_le_T hx)).symm)
  have classify (A : Subgroup G) (hSA : d.S ≤ A) (hne : ¬ K ≤ A) :
      A ⊓ K = d.S ⊓ K ∨ A ⊓ K = i.left ∨ A ⊓ K = i.right := by
    rcases i.exhaustive (A ⊓ K) (inf_le_inf_right _ hSA) inf_le_right with he | he | he | he
    · exact Or.inl he
    · exact Or.inr (Or.inl he)
    · exact Or.inr (Or.inr he)
    · exact (hne (he ▸ inf_le_left)).elim
  exact ⟨classify d.MZ hSMZ hout,classify M (d.S_le_T.trans hM.1.2)
    (d.localFamily_not_le_M hG hempty hM hu hK hout)⟩

/-- Apply the interval to every original local-family FF image, preserving
its elementwise quotient marking and both literal intersections. No new
CaseIComponentData or source selection is assigned to K. -/
theorem localFamily_binaryThree_ff_interval (d : CaseIComponentData T M Mc V)
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    (hM : IsOrderingMaximal T M)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (h : PreparedChosenModule T M V)
    {K : Subgroup G} (hK : K ∈ Chapter1.LIn d.G1 d.S)
    (hq : IsQuasisimple (K ⧸ pCore 2 K)) (hout : ¬ K ≤ d.MZ)
    (hf : generalizedFitting K = pCore 2 K)
    (e : d.normalizerImage K ≃* Matrix.PSL3Two.SL) :
    ∃ t : (K ⧸ pCore 2 K) ≃* Matrix.PSL3Two.SL,
      (∀ k : K, t (QuotientGroup.mk' (pCore 2 K) k) = e (d.toNormalizerImage K k)) ∧
      ∃ i : BinaryThreeParabolicInterval K (d.S ⊓ K),
        (d.MZ ⊓ K = d.S ⊓ K ∨ d.MZ ⊓ K = i.left ∨ d.MZ ⊓ K = i.right) ∧
        (M ⊓ K = d.S ⊓ K ∨ M ⊓ K = i.left ∨ M ⊓ K = i.right) := by
  have a := d.localFamily_normalizerAction hG hempty hM hJ hu h hK hq hout hf
  let t := a.binaryThree_coreEquiv hq e
  obtain ⟨i⟩ := d.localFamily_binaryThree_interval hK hf t
  exact ⟨t,a.binaryThree_coreEquiv_mk hq e,i,
    d.localFamily_binaryThree_intersections hG hempty hM hu hK hout i⟩

/-- If the source intersections are distinct and both exceed S_L, the
interval supplies generation and escape of the actual selected residual. -/
theorem binaryThree_generation_of_strict_intersections
    {d : CaseIComponentData T M Mc V}
    (i : BinaryThreeParabolicInterval d.L d.SL)
    (hm : d.ML = d.SL ∨ d.ML = i.left ∨ d.ML = i.right)
    (hn : M ⊓ d.L = d.SL ∨ M ⊓ d.L = i.left ∨ M ⊓ d.L = i.right)
    (hms : d.ML ≠ d.SL) (hns : M ⊓ d.L ≠ d.SL) (hne : d.ML ≠ M ⊓ d.L) :
    (M ⊓ d.L) ⊔ d.ML = d.L ∧ ¬ d.localThreeResidual ≤ d.ML := by
  have hres := i.cubic_residuals
  rcases hm.resolve_left hms with hm | hm <;>
    rcases hn.resolve_left hns with hn | hn
  · exact (hne (hm.trans hn.symm)).elim
  · constructor
    · rw [hm,hn,sup_comm,i.generated]
    · change ¬ (primeToResidual 3 (M ⊓ d.L : Subgroup G)).map (M ⊓ d.L).subtype ≤ d.ML
      rw [hn,hm]
      exact hres.2.2.2
  · constructor
    · rw [hm,hn,i.generated]
    · change ¬ (primeToResidual 3 (M ⊓ d.L : Subgroup G)).map (M ⊓ d.L).subtype ≤ d.ML
      rw [hn,hm]
      exact hres.2.2.1
  · exact (hne (hm.trans hn.symm)).elim

/-- The original binary-three FF row has the complete literal Sylow
interval and locates both source intersections in it, at either prime. -/
theorem PreExclusionSource.constrained_binaryThree_interval
    {d : CaseIComponentData T M Mc V} {h : PreparedChosenModule T M V} {p : ℕ}
    (s : d.PreExclusionSource h.normalized p)
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    (hM : IsOrderingMaximal T M)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hf : generalizedFitting d.L = pCore 2 d.L)
    (e : d.normalizerImage d.L ≃* Matrix.PSL3Two.SL) :
    ∃ t : (d.L ⧸ pCore 2 d.L) ≃* Matrix.PSL3Two.SL,
      (∀ k : d.L, t (QuotientGroup.mk' (pCore 2 d.L) k) = e (d.toNormalizerImage d.L k)) ∧
      d.ConstrainedLinearParabolic t d.ML ∧
      d.ConstrainedLinearParabolic t (M ⊓ d.L) ∧
      ∃ i : BinaryThreeParabolicInterval d.L d.SL,
        (d.ML = d.SL ∨ d.ML = i.left ∨ d.ML = i.right) ∧
        (M ⊓ d.L = d.SL ∨ M ⊓ d.L = i.left ∨ M ⊓ d.L = i.right) := by
  have hK : d.L ∈ Chapter1.LIn d.G1 d.S := ⟨d.L_component.1,s.local_component⟩
  obtain ⟨t,ht,i,hm,hn⟩ := d.localFamily_binaryThree_ff_interval
    hG hempty hM hJ hu h hK s.quasisimple d.L_not_le_MZ hf e
  have hp := d.constrained_binary_flags hG hempty hM hu hK (by decide : 0 < 3) t
  exact ⟨t,ht,hp.1,hp.2,i,hm,hn⟩

/-- Either exchanged plane uses the same interval and the original FF marking. -/
theorem ExchangedSource.constrained_binaryThree_interval
    {d : CaseIComponentData T M Mc V} (s : d.ExchangedSource)
    (h : PreparedChosenModule T M V)
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    (hM : IsOrderingMaximal T M)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hf : generalizedFitting d.L = pCore 2 d.L)
    (e : d.normalizerImage d.L ≃* Matrix.PSL3Two.SL) :
    ∃ t : (d.L ⧸ pCore 2 d.L) ≃* Matrix.PSL3Two.SL,
      (∀ k : d.L, t (QuotientGroup.mk' (pCore 2 d.L) k) = e (d.toNormalizerImage d.L k)) ∧
      d.ConstrainedLinearParabolic t d.ML ∧
      d.ConstrainedLinearParabolic t (M ⊓ d.L) ∧
      ∃ i : BinaryThreeParabolicInterval d.L d.SL,
        (d.ML = d.SL ∨ d.ML = i.left ∨ d.ML = i.right) ∧
        (M ⊓ d.L = d.SL ∨ M ⊓ d.L = i.left ∨ M ⊓ d.L = i.right) := by
  have hK : d.L ∈ Chapter1.LIn d.G1 d.S := ⟨d.L_component.1,s.local_component⟩
  obtain ⟨t,ht,i,hm,hn⟩ := d.localFamily_binaryThree_ff_interval
    hG hempty hM hJ hu h hK s.quasisimple d.L_not_le_MZ hf e
  have hp := d.constrained_binary_flags hG hempty hM hu hK (by decide : 0 < 3) t
  exact ⟨t,ht,hp.1,hp.2,i,hm,hn⟩

/-- Strict source intersections occupy the two maximal positions;
their literal quotient images are maximal parabolics. -/
theorem binaryThree_maximal_parabolics_of_strict_intersections
    {d : CaseIComponentData T M Mc V}
    (i : BinaryThreeParabolicInterval d.L d.SL)
    (hm : d.ML = d.SL ∨ d.ML = i.left ∨ d.ML = i.right)
    (hn : M ⊓ d.L = d.SL ∨ M ⊓ d.L = i.left ∨ M ⊓ d.L = i.right)
    (hms : d.ML ≠ d.SL) (hns : M ⊓ d.L ≠ d.SL) :
    IsLinearMaximalParabolic ((d.ML.subgroupOf d.L).map
      (QuotientGroup.mk' (pCore 2 d.L))) 3 (ZMod 2) ∧
      IsLinearMaximalParabolic (((M ⊓ d.L).subgroupOf d.L).map
        (QuotientGroup.mk' (pCore 2 d.L))) 3 (ZMod 2) := by
  constructor
  · rcases hm.resolve_left hms with he | he
    · simpa only [he] using i.left_parabolic
    · simpa only [he] using i.right_parabolic
  · rcases hn.resolve_left hns with he | he
    · simpa only [he] using i.left_parabolic
    · simpa only [he] using i.right_parabolic

/-- The binary-three FF row supplies the parabolic and residual clauses
once the original fixed-space argument distinguishes both intersections
from S_L and from one another. These three source obligations remain explicit. -/
theorem PreExclusionSource.constrained_binaryThree_parabolic_clauses
    {d : CaseIComponentData T M Mc V} {h : PreparedChosenModule T M V} {p : ℕ}
    (s : d.PreExclusionSource h.normalized p)
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    (hM : IsOrderingMaximal T M)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hf : generalizedFitting d.L = pCore 2 d.L)
    (e : d.normalizerImage d.L ≃* Matrix.PSL3Two.SL)
    (hms : d.ML ≠ d.SL) (hns : M ⊓ d.L ≠ d.SL) (hne : d.ML ≠ M ⊓ d.L) :
    IsLinearMaximalParabolic ((d.ML.subgroupOf d.L).map
      (QuotientGroup.mk' (pCore 2 d.L))) 3 (ZMod 2) ∧
      IsLinearMaximalParabolic (((M ⊓ d.L).subgroupOf d.L).map
        (QuotientGroup.mk' (pCore 2 d.L))) 3 (ZMod 2) ∧
      (M ⊓ d.L) ⊔ d.ML = d.L ∧ ¬ d.localThreeResidual ≤ d.ML := by
  obtain ⟨_,_,_,_,i,hm,hn⟩ := s.constrained_binaryThree_interval (h := h)
    hG hempty hM hJ hu hf e
  have hp := binaryThree_maximal_parabolics_of_strict_intersections i hm hn hms hns
  exact ⟨hp.1,hp.2,binaryThree_generation_of_strict_intersections i hm hn hms hns hne⟩


end CFSG.Quasithin.Chapter15.Section01.CaseIComponentData

namespace CFSG.Quasithin.Chapter15.Section01
open Chapter1.RadicalExclusions.ModelReduction.FullSieve.SourceInterface
open Section03 Section03.InitialSource ChapterA.Section05To06
variable {G : Type*} [Group G] [Finite G]

/-- The actual original marker supplies the binary-three interval, quotient
marking and both intersection positions, preserving either source prime. -/
theorem PreparedChosenModule.source_preExclusion_constrained_binaryThree_interval
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc V : Subgroup G} (hM : IsOrderingMaximal T M)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hne : M ≠ Mc) (h : PreparedChosenModule T M V)
    (hfull : V = localModule T M)
    (m : CaseIPreExclusionMarker T M V h.normalized)
    (hres : (pResidual 2 (centralizer (centralInvolutions T : Set G))).map
      (centralizer (centralInvolutions T : Set G)).subtype ≤
        centralizer (thompsonFixed T V : Set G)) :
    ∃ d : CaseIComponentData T M Mc V, d.Z1 = m.Z1 ∧ d.row = m.row ∧
      d.PreExclusionSource h.normalized m.prime ∧
      (generalizedFitting d.L = pCore 2 d.L →
        ∀ e : d.normalizerImage d.L ≃* Matrix.PSL3Two.SL,
          ∃ t : (d.L ⧸ pCore 2 d.L) ≃* Matrix.PSL3Two.SL,
            (∀ k : d.L, t (QuotientGroup.mk' (pCore 2 d.L) k) = e (d.toNormalizerImage d.L k)) ∧
            d.ConstrainedLinearParabolic t d.ML ∧
            d.ConstrainedLinearParabolic t (M ⊓ d.L) ∧
            ∃ i : CaseIComponentData.BinaryThreeParabolicInterval d.L d.SL,
              (d.ML = d.SL ∨ d.ML = i.left ∨ d.ML = i.right) ∧
              (M ⊓ d.L = d.SL ∨ M ⊓ d.L = i.left ∨ M ⊓ d.L = i.right)) := by
  obtain ⟨d,hZ,hr,s⟩ := h.component_of_preExclusionMarker
    hG T hempty hM hmany hJ hu hne hfull m hres
  exact ⟨d,hZ,hr,s,fun hf e =>
    s.constrained_binaryThree_interval (h := h) hG hempty hM hJ hu hf e⟩

end CFSG.Quasithin.Chapter15.Section01
