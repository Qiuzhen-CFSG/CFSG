variable {G : Type*} [Group G] [Finite G]
namespace CaseIComponentData
variable {T : Sylow 2 G} {M Mc V : Subgroup G} {p : ℕ}

/-- The original constrained component either has its full Sylow subgroup
in Q₁ or admits the actual C.2.7 star catalogue, with its comparison kernel. -/
theorem PreExclusionSource.constrained_star_catalogue_or_full_sylow
    {d : CaseIComponentData T M Mc V} {h : PreparedChosenModule T M V}
    (s : d.PreExclusionSource h.normalized p)
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hfit : generalizedFitting d.L = pCore 2 d.L) :
    d.SL ≤ d.Q1 ∨ ∃ hnL : d.Q1 ≤ normalizer (d.L : Set G),
      StarModels.Model (starImage d.L d.Q1 d.L) ∧
        (coreToStar hnL).ker ≤ center (d.L ⧸ pCore 2 d.L) ∧
        (Nat.card (center (d.L ⧸ pCore 2 d.L)) = 1 ∨
          Nat.card (center (d.L ⧸ pCore 2 d.L)) = 3) := by
  rcases s.constrained_radical_alternative (h := h) hG hu hfit with hs | hnL
  · exact Or.inl hs
  · exact Or.inr ⟨hnL, s.constrained_star_catalogue_of_normalizes (h := h) hG hfit hnL⟩

/-- The same comparison on both exchanged-plane sizes once the full-Sylow
alternative has been excluded. No model of the unidentified quotient is assumed. -/
theorem ExchangedSource.constrained_star_catalogue_of_not_contains_sylow
    {d : CaseIComponentData T M Mc V} (s : d.ExchangedSource)
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (h : PreparedChosenModule T M V)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hfit : generalizedFitting d.L = pCore 2 d.L)
    (hproper : ¬ d.SL ≤ d.Q1) :
    ∃ hnL : d.Q1 ≤ normalizer (d.L : Set G),
      StarModels.Model (starImage d.L d.Q1 d.L) ∧
        (coreToStar hnL).ker ≤ center (d.L ⧸ pCore 2 d.L) ∧
        (Nat.card (center (d.L ⧸ pCore 2 d.L)) = 1 ∨
          Nat.card (center (d.L ⧸ pCore 2 d.L)) = 3) := by
  have hi := s.constrained_input_of_not_contains_sylow hG h hu hfit hproper
  exact ⟨hi.normalizes, star_model_from_source hi,
    coreToStar_ker_central_from_source hi, coreQuotient_center_card_from_source hi⟩

end CaseIComponentData
end CFSG.Quasithin.Chapter15.Section01
