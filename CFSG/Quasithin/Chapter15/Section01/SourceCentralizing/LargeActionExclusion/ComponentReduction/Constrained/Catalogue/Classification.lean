/-!
# Source classification of the original normalized local action

The original central-involution span has an actual FF action with a
quasisimple generalized Fitting subgroup. Restrict to the normal subgroup
generated by best offenders. A nontrivial offender makes this subgroup
contain the same component; hence its faithful action satisfies all the
hypotheses of the proved B.5.1 source classifier.

The first export retains all six module and action clauses. The second
forgets only those clauses to give the group catalogue on the literal
image of K. The ambient application works for every S-normalized K in
L(G₁,S), without requiring that K be an ambient C-component. It does not
yet exclude the larger fields, reconstruct blocks, or identify parabolics.

Source: Aschbacher--Smith 15.1.20(2), pp.1094--1095, and B.5.1, pp.99--103.
-/

public section
open Subgroup Theory.GroupTheory Stellmacher Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section01.CaseIComponentData
open ChapterC.C27Source
open Section03 Section03.InitialSource ChapterA.Section05To06
open ChapterB.QuasisimpleSource ChapterB.QuasisimpleSource.SourceCompletion
open ChapterB.SourceInduction.HighThreeRank.CoverCentralizer.SourceConstruction
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {M Mc V : Subgroup G}

/-- Full B.5.1 for the original local-family module, restricted to its genuine
best-offender subgroup. All six source clauses retain their actual action. -/
theorem CatalogueAction.source_classification {d : CaseIComponentData T M Mc V}
    {K : Subgroup G} (a : d.CatalogueAction K) (hsq : IsSQTK KnownSimple.IsKnownSimple K) :
    letI := a.reduced.elementary
    let H := K ⊔ d.S
    let C := centralizer (d.catalogueModule K : Set H)
    let q := QuotientGroup.mk' C
    let ρ : Representation (ZMod 2) (H ⧸ C) (Additive (d.catalogueModule K)) :=
      NormalElementaryQuotient.representation (d.catalogueModule K) q
      (QuotientGroup.mk'_surjective C) (QuotientGroup.ker_mk' C)
    let L := (K.subgroupOf H).map q
    let J := offenderSubgroup ρ
    L ≤ J ∧ Nonempty (ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
      (ρ.comp J.subtype) (L.subgroupOf J)) := by
  let := a.reduced.elementary
  let H := K ⊔ d.S
  let C := centralizer (d.catalogueModule K : Set H)
  let q := QuotientGroup.mk' C
  let ρ : Representation (ZMod 2) (H ⧸ C) (Additive (d.catalogueModule K)) :=
      NormalElementaryQuotient.representation (d.catalogueModule K) q
    (QuotientGroup.mk'_surjective C) (QuotientGroup.ker_mk' C)
  let L := (K.subgroupOf H).map q
  let J := offenderSubgroup ρ
  let : J.Normal := offenderSubgroup_normal ρ
  let : IsQuasisimple L := a.quasisimple
  have hcore : pCore 2 (H ⧸ C) = ⊥ := a.reduced.quotient_pCore_eq_bot
  obtain ⟨A,hA⟩ := (isFFModule_iff_exists_bestOffender ρ).mp a.ff
  let : IsElementaryAbelian 2 A := hA.1.2
  have hshape : IsQuasisimple (generalizedFitting (H ⧸ C)) := a.fitting ▸ a.quasisimple
  have hf := generalizedFitting_normal_eq_of_quasisimple_or_three hcore
    (Or.inl hshape) J A (IsElementaryAbelian.isPGroup 2 A) hA.1.1 (hA.le_offenderSubgroup ρ)
  have hLJ : L ≤ J := (a.fitting.trans hf.symm).le.trans (map_subtype_le _)
  have hfit : generalizedFitting J = L.subgroupOf J := by
    apply map_injective J.subtype_injective
    rw [map_subgroupOf_eq_of_le hLJ,hf]
    exact a.fitting.symm
  have hcoreJ : pCore 2 J = ⊥ := by
    apply ((pCore 2 J).map_eq_bot_iff_of_injective J.subtype_injective).mp
    apply le_bot_iff.mp
    have hm : (pCore 2 J).map J.subtype ≤ pCore 2 (H ⧸ C) :=
      le_sSup ⟨ConjAct.normal_of_characteristic_of_normal,pCore_isPGroup.map J.subtype⟩
    exact hm.trans hcore.le
  let eK : K.subgroupOf H ≃* K := subgroupOfEquivOfLe le_sup_left
  let eL : L.subgroupOf J ≃* L := subgroupOfEquivOfLe hLJ
  let : IsQuasisimple (L.subgroupOf J) := IsQuasisimple.of_mulEquiv eL.symm
  have hsqL : IsSQTK KnownSimple.IsKnownSimple L :=
    quasisimple_section_sqtk (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
      ((IsSQTK.equiv eK).mpr hsq)
      (ChapterA.Section02.IsSectionOf.of_surjective (q.subgroupMap (K.subgroupOf H))
        (q.subgroupMap_surjective (K.subgroupOf H)))
  have hyp : QuasisimpleSourceHypothesis (ρ.comp J.subtype) KnownSimple.IsKnownSimple
      (L.subgroupOf J) := by
    refine ⟨inferInstance,
      (NormalElementaryQuotient.representation_injective (d.catalogueModule K) q
        (QuotientGroup.mk'_surjective C) (QuotientGroup.ker_mk' C)).comp J.subtype_injective,
      inferInstance,(IsSQTK.equiv eL).mpr hsqL,?_,hcoreJ,offenderSubgroup_restrict_eq_top ρ⟩
    rw [hfit]
    exact (sup_eq_left.mpr (by
      rw [←hfit]
      exact (show center J ≤ fittingSubgroup J from le_sSup ⟨inferInstance,inferInstance⟩).trans
        (fitting_le_generalizedFitting J))).symm
  exact ⟨hLJ,knownSimple_quasisimpleClassificationInput
    (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
    (ChapterA.SQTKStructure.a36Input_of_theoremsAC
      (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
      (fun _ _ _ => ChapterA.Section02.theoremC_knownSimple))
    ChapterB.SourceClassification.irreducibleClassification_knownSimple
    ChapterB.SourceInduction.nonbinaryG2RootPairInput _ _ _ _ hyp⟩

/-- The first source group list, on the image of K in its literal module quotient. -/
theorem CatalogueAction.model {d : CaseIComponentData T M Mc V}
    {K : Subgroup G} (a : d.CatalogueAction K) (hsq : IsSQTK KnownSimple.IsKnownSimple K) :
    let q := QuotientGroup.mk' (centralizer (d.catalogueModule K : Set (K ⊔ d.S : Subgroup G)))
    StarModels.Model ((K.subgroupOf (K ⊔ d.S)).map q) := by
  let := a.reduced.elementary
  obtain ⟨hLJ,⟨c⟩⟩ := a.source_classification hsq
  exact StarModels.model_of_source _ (subgroupOfEquivOfLe hLJ).symm c

/-- Apply the actual FF action and model extraction to every normalized member
of the original fixed local family. No new component-data record is imposed on K. -/
theorem localFamily_normalized_catalogue (d : CaseIComponentData T M Mc V)
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    (hM : IsOrderingMaximal T M)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (h : PreparedChosenModule T M V)
    {K : Subgroup G} (hK : K ∈ Chapter1.LIn d.G1 d.S)
    (hq : IsQuasisimple (K ⧸ pCore 2 K)) (hout : ¬ K ≤ d.MZ)
    (hf : generalizedFitting K = pCore 2 K)
    (hn : d.S ≤ normalizer (K : Set G)) :
    d.CatalogueAction K ∧
      (let q := QuotientGroup.mk' (centralizer (d.catalogueModule K : Set (K ⊔ d.S : Subgroup G)))
       StarModels.Model ((K.subgroupOf (K ⊔ d.S)).map q)) := by
  let := h.elementary
  have hsq := caseI_centralizer_sqtk hG d.Z1 d.Z1_ne_bot
    ((IsElementaryAbelian.isPGroup 2 V).to_le (d.Z1_le_fixed.trans inf_le_left))
  have hsqK := (IsSQTK.equiv (subgroupOfEquivOfLe hK.1)).mp (hsq.subgroup (K.subgroupOf d.G1))
  have a := d.localFamily_catalogueAction_of_normalizes hG hempty hM hJ hu h hK hq hout hf hn
  exact ⟨a,a.model hsqK⟩

end CFSG.Quasithin.Chapter15.Section01.CaseIComponentData
