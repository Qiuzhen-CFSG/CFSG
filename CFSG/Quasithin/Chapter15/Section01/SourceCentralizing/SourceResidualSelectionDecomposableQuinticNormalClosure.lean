module

public import Theory.GroupTheory.PResidual.CyclicImageCentralKernel
public import Theory.GroupTheory.PStar.ActionTools

/-!
# Three-group residuals through a central kernel

Let R be a two-subgroup centralizing the kernel of a homomorphism into D,
where the two-residual of D is a three-group. The normal closure N of R
also centralizes that kernel. Its two-residual has central Sylow
two-subgroups, so two-perfectness and transfer exclude two from its order.
For every prime other than two and three, the Sylow subgroups of N have
trivial image in D and are central. Normal generation by R makes N perfect
at each such prime, so transfer excludes those primes as well.

Thus the embedded two-residual of N is a three-group. The map need not be
surjective, and its kernel need not have any prescribed prime divisors.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter15
namespace DecomposableQuinticControl

private theorem coprime_card_of_central_kernel_sylow_image
    {X D : Type*} [Group X] [Finite X] [Group D]
    {p : ℕ} [Fact p.Prime] (hp : p ≠ 3)
    (f : X →* D) (hc : f.ker ≤ center X) (hX : IsPPerfect p X)
    (B : Subgroup D) (hB : IsPGroup 3 B) (P : Sylow p X)
    (hPB : (P : Subgroup X).map f ≤ B) :
    Nat.Coprime p (Nat.card X) := by
  let : Fact (Nat.Prime 3) := ⟨by decide⟩
  have hd := IsPGroup.disjoint_of_ne p 3 hp ((P : Subgroup X).map f) B
    (P.isPGroup'.map f) hB
  apply PStarAction.coprime_card_of_central_sylow hX P
  intro x hx
  apply hc
  exact disjoint_def.mp hd (mem_map_of_mem f hx) (hPB (mem_map_of_mem f hx))

/-- The two-residual of a normal closure generated by a two-group is a
three-group when the generators centralize the kernel and the target has
three-group two-residual. -/
theorem three_twoResidual_normalClosure_of_central_kernel
    {H D : Type*} [Group H] [Finite H] [Group D] [Finite D]
    (f : H →* D) (R : Subgroup H) (hR : IsPGroup 2 R)
    (hc : R ≤ centralizer (f.ker : Set H))
    (hD : IsPGroup 3 (pResidual 2 D)) :
    IsPGroup 3 ((pResidual 2 (normalClosure (R : Set H))).map
      (normalClosure (R : Set H)).subtype) := by
  let : Fact (Nat.Prime 2) := ⟨by decide⟩
  let : Fact (Nat.Prime 3) := ⟨by decide⟩
  let N := normalClosure (R : Set H)
  let Y := pResidual 2 N
  let g := f.comp N.subtype
  have hNC : N ≤ centralizer (f.ker : Set H) := normalClosure_le_normal hc
  have hgc : g.ker ≤ center N := by
    intro x hx
    apply mem_center_iff.mpr
    intro y
    exact Subtype.ext (hNC y.property _ hx).symm
  have hY : IsPGroup 3 Y := by
    have htwo : Nat.Coprime 2 (Nat.card Y) := by
      let k := g.comp Y.subtype
      have hkc : k.ker ≤ center Y := by
        intro x hx
        apply mem_center_iff.mpr
        intro y
        exact Subtype.ext (mem_center_iff.mp (hgc hx) y)
      let P : Sylow 2 Y := Classical.choice inferInstance
      apply coprime_card_of_central_kernel_sylow_image (by decide)
        k hkc (isPPerfect_pResidual 2) (pResidual 2 D) hD P
      rintro _ ⟨x,hx,rfl⟩
      exact map_pResidual_le 2 g (mem_map_of_mem g x.property)
    have hother (q : ℕ) (hq : q.Prime) (hq2 : q ≠ 2) (hq3 : q ≠ 3) :
        Nat.Coprime q (Nat.card N) := by
      let : Fact q.Prime := ⟨hq⟩
      let P : Sylow q N := Classical.choice inferInstance
      apply coprime_card_of_central_kernel_sylow_image hq3
        g hgc (isPPerfect_normalClosure_of_twoGroup R hR hq2)
        (pResidual 2 D) hD P
      rintro _ ⟨x,hx,rfl⟩
      have ho := P.isPGroup'.orderOf_coprime
        ((Nat.coprime_primes hq Nat.prime_two).mpr hq2) (⟨x,hx⟩ : P)
      rw [← orderOf_coe] at ho
      exact map_pResidual_le 2 g
        (mem_map_of_mem g (mem_pResidual_of_orderOf_coprime ho.symm))
    apply IsPGroup.of_card
    apply Nat.eq_prime_pow_of_unique_prime_dvd Nat.card_pos.ne'
    intro q hq hqd
    by_contra hq3
    by_cases hq2 : q = 2
    · exact (Nat.prime_two.coprime_iff_not_dvd.mp htwo) (hq2 ▸ hqd)
    · exact (hq.coprime_iff_not_dvd.mp (hother q hq hq2 hq3))
        (hqd.trans Y.card_subgroup_dvd_card)
  exact hY.map N.subtype

end DecomposableQuinticControl
end CFSG.Quasithin.Chapter15
