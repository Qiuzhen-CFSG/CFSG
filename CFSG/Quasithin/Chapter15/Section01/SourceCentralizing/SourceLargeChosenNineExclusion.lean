module

public import CFSG.Quasithin.Chapter15.Section01.SourceCentralizing.SourceResidualSelectionNineNormalization
public import CFSG.Quasithin.ChapterB.Section02.Thompson.CyclicImage

/-!
# Excluding the actual full Nine action in 15.1.15

The Thompson subgroup is generated by elementary abelian subgroups. Its
image in a cyclic group of order four therefore lies in the unique subgroup
of order two. For the actual full Nine source, the proved normalization
argument identifies this Thompson image with the entire Sylow image. The
resulting strict inclusion and equality are incompatible.

All original groups, chosen-module data and conjugation maps are retained.
The final contradiction has no residual-centralization, strict-image,
whole-core reconstruction or additional model premise.

Source: Aschbacher--Smith B.2.2 and 15.1.14--15, printed pp.74,1091--1092.
-/

public section
open Subgroup Representation Representation.BinaryOffender Stellmacher Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section01
open Section03 Section03.InitialSource ChapterA.Section05To06 ChapterD ChapterD.UniqueFactor
variable {G : Type*} [Group G] [Finite G]

/-- In the actual Nine action, the elementary generators of the original
Thompson subgroup cannot cover the cyclic Sylow image of order four. -/
theorem chosen_nine_thompson_image_lt_sylow
    (T : Sylow 2 G) {M V : Subgroup G} [IsElementaryAbelian 2 V]
    (hTM : (T : Subgroup G) ≤ M) (hn : M ≤ normalizer (V : Set G))
    (h9 : SourceCases.Nine (imageRepresentation M V hn)
      (((T : Subgroup G).subgroupOf M).map (actionHom M V hn).rangeRestrict)) :
    ((ChapterB.thompsonJ (T : Subgroup G) 1).subgroupOf M).map
        (actionHom M V hn).rangeRestrict <
      ((T : Subgroup G).subgroupOf M).map (actionHom M V hn).rangeRestrict := by
  let f := (actionHom M V hn).rangeRestrict
  let S := ((T : Subgroup G).subgroupOf M).map f
  obtain ⟨_,_,_,_,_,_,hS,_⟩ := h9
  let : IsCyclic S := hS.1
  obtain ⟨A,hAS,hA,hJA⟩ := ChapterB.exists_cyclic_two_marker
    (T : Subgroup G) M hTM f S le_rfl hS.2 1
  refine lt_of_le_of_ne (hJA.trans hAS) ?_
  intro he
  have hcard : Nat.card S ≤ Nat.card A := card_le_of_le (he.ge.trans hJA)
  have hSfour : Nat.card S = 4 := hS.2
  omega

/-- The original full Nine row is impossible. The earlier 15.1.14 result
is proved from the same source hypotheses, rather than supplied as an input. -/
theorem PreparedChosenModule.false_of_full_nine
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc V : Subgroup G} (hM : IsOrderingMaximal T M)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hne : M ≠ Mc) (h : PreparedChosenModule T M V)
    (hfull : V = localModule T M)
    (h9 : letI := h.elementary
      SourceCases.Nine (imageRepresentation M V h.normalized)
        (((T : Subgroup G).subgroupOf M).map (actionHom M V h.normalized).rangeRestrict)) :
    False := by
  let := h.elementary
  exact (chosen_nine_thompson_image_lt_sylow T hM.1.2 h.normalized h9).ne
    (h.nine_thompson_image_eq_sylow hG T hempty hM hmany hJ hu hne hfull h9)

end CFSG.Quasithin.Chapter15.Section01
