module
public import CFSG.Quasithin.Chapter15.Section01.SourceCentralizing.SmallActionUniqueness
public import Theory.SpecificGroups.SymmetricThreeCentralNormalizer
public import Theory.GroupTheory.PGroup.OmegaCenterIn

/-!
# The S3 times C3 maximal-overgroup row

The Sylow normalizer in the actual action has index three. Its full preimage
is generated by the original Sylow normalizer and action kernel. Both
normalize the central seed Z cap V: Z is characteristic in the Sylow, V is
normal in M, and the action kernel centralizes V. The seed normalizer lies
in Mc and is proper in M, so it also has index three. The proved seed-span
uniqueness argument then leaves exactly M and Mc as maximal overgroups.

Source: Aschbacher--Smith15.2.5, printed p.1107, cases(1)--(2).
-/
public section
open Subgroup Stellmacher Theory.GroupTheory Representation Representation.BinaryOffender
namespace CFSG.Quasithin.Chapter15.Section01
open Section03 Section03.InitialSource ChapterA.Section05To06 ChapterD ChapterD.UniqueFactor
variable {G : Type*} [Group G] [Finite G]

theorem PreparedChosenModule.seed_normalizer_index_of_action_sylow
    (T : Sylow 2 G) {M Mc V : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hne : M ≠ Mc) (hV : PreparedChosenModule T M V)
    (hi : ∀ P : Sylow 2 (internalActionImage M V hV.normalized),
      (normalizer (P : Set (internalActionImage M V hV.normalized))).index = 3) :
    (M ⊓ normalizer (centralInvolutions T ⊓ V : Set G)).relIndex M = 3 := by
  classical
  let D := internalActionImage M V hV.normalized
  let f : M →* D := (actionHom M V hV.normalized).rangeRestrict
  have hf : Function.Surjective f := (actionHom M V hV.normalized).rangeRestrict_surjective
  let P := T.subtype hM.1.2
  let B := (M ⊓ normalizer (centralInvolutions T ⊓ V : Set G)).subgroupOf M
  have hker : f.ker ≤ B := by
    intro x hx
    have hx' : x ∈ (actionHom M V hV.normalized).ker :=
      congrArg (fun d : D => (d : MulAut V)) hx
    rw [actionHom_ker] at hx'
    exact ⟨x.property, Subgroup.centralizer_le_normalizer _ (centralizer_le inf_le_right hx')⟩
  have hn : normalizer (P : Set M) ≤ B := by
    intro x hx
    have hxT : (x : G) ∈ normalizer ((T : Subgroup G) : Set G) := by
      have h := (P : Subgroup M).le_normalizer_map M.subtype (mem_map_of_mem _ hx)
      simpa only [P,Sylow.coe_subtype,map_subgroupOf_eq_of_le hM.1.2,
        Subgroup.subtype_apply] using h
    exact ⟨x.property, inf_normalizer_le_normalizer_inf
      ⟨normalizer_le_normalizer_omegaCenterIn (T : Subgroup G) hxT,
        hV.normalized x.property⟩⟩
  have hpre : (normalizer (P.mapSurjective hf : Set D)).comap f ≤ B := by
    change (normalizer (P.map f : Set D)).comap f ≤ B
    rw [← P.normalizer_map_surjective f hf,comap_map_eq]
    exact sup_le hn hker
  have hd := index_dvd_of_le hpre
  rw [index_comap_of_surjective _ hf,hi] at hd
  change B.index = 3
  rcases (Nat.dvd_prime Nat.prime_three).mp hd with hone | hthree
  · have hMle : M ≤ Mc := by
      intro x hx
      have hb : (⟨x,hx⟩ : M) ∈ B := (index_eq_one.mp hone) ▸ mem_top _
      exact hV.central_seed_normalizer_le_partner T hu hb.2
    have hMc : IsMaximalTwoLocal Mc := (hu ▸ Set.mem_singleton Mc).1
    exact (hne (le_antisymm hMle (hM.1.1.2 hMc.1 hMle))).elim
  · exact hthree
/-- Original15.2.5 in the S3 times C3 action row. -/
theorem PreparedChosenModule.maximal_overgroups_of_symmetric_three_cubic_action
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc V : Subgroup G} (hM : IsOrderingMaximal T M)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hne : M ≠ Mc) (hV : PreparedChosenModule T M V)
    (e : internalActionImage M V hV.normalized ≃*
      (Equiv.Perm (Fin 3) × Multiplicative (ZMod 3))) :
    maximalTwoLocalOvergroups (T : Subgroup G) = {M, Mc} := by
  apply hV.maximal_overgroups_of_seed_index_three hG T hempty hM hJ hu
  exact hV.seed_normalizer_index_of_action_sylow T hM hu hne
    (SymmetricThreeCentralNormalizer.equiv_product_normalizer_index e)
end CFSG.Quasithin.Chapter15.Section01
