module

public import CFSG.Quasithin.Chapter15.Section01.SourceCentralizing.SourceResidualSelectionExtraspecialKernel
public import CFSG.Quasithin.Chapter15.Section01.SourceCentralizing.SourceResidualSelectionExtraspecialResidualImage

/-!
# No third maximal local in the original full extraspecial row

The third residual is generated by a cubic complement under the original
action centralizer. Coprimality of the original action kernel makes a Sylow
three-subgroup containing that complement centralize it. It consequently
normalizes the whole residual and lies in the third local. This contradicts
the intersection's index nine. The only maximal two-locals over the original
Sylow subgroup are therefore the selected local and its centralizer partner.
-/

public section
open Subgroup Representation Representation.BinaryOffender Stellmacher Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section01
open Section03 Section03.InitialSource ChapterA.Section05To06 ChapterD ChapterD.UniqueFactor
open Chapter14.SourcePreliminaries
variable {G : Type*} [Group G] [Finite G]

/-- The original full extraspecial row admits no third maximal two-local. -/
theorem PreparedChosenModule.extraspecial_full_no_third_maximal
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc V N : Subgroup G} (hM : IsOrderingMaximal T M)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (h : PreparedChosenModule T M V) (hfull : V = localModule T M)
    (hex : letI := h.elementary; SourceCases.Extraspecial (imageRepresentation M V h.normalized)
      (((T : Subgroup G).subgroupOf M).map (actionHom M V h.normalized).rangeRestrict))
    (hN : N ∈ maximalTwoLocalOvergroups (T : Subgroup G)) (hNM : N ≠ M) (hNMc : N ≠ Mc) :
    False := by
  let := h.elementary
  obtain ⟨hle,hn,hp,_,_,hCY⟩ := h.extraspecial_third_residual hG T hempty hM hmany hJ hu hfull hex hN hNM hNMc
  obtain ⟨hker,⟨e⟩⟩ := h.extraspecial_third_residual_original_kernel hG T hempty hM hmany hJ hu hfull hex hN hNM hNMc
  have hnorm := h.extraspecial_third_residual_normalizer hG T hempty hM hmany hJ hu hfull hex hN hNM hNMc
  let Y := sourceResidual N Mc
  let C := M ⊓ centralizer (V : Set G)
  have hYM : Y ≤ M := hle.trans inf_le_left
  have hc : Nat.card (Y ⧸ pCore 2 Y) = 3 := (Nat.card_congr e.toEquiv).trans (by simp)
  obtain ⟨x,hx,hgen⟩ := exists_prime_order_sup_pCore_eq_top (G := Y) (by decide : Nat.Coprime 2 3) hc
  let X := zpowers (x : G)
  have hXQ : X ⊔ Y.pCoreIn 2 = Y := by
    have hh := congrArg (map Y.subtype) hgen
    simpa only [X,pCoreIn,Subgroup.map_sup,MonoidHom.map_zpowers,subtype_apply,
      ←MonoidHom.range_eq_map,range_subtype] using hh
  have hXC : conjugateSpanBy X C = Y := conjugateSpan_eq_of_pPerfect_supplement
    Y X C (Y.pCoreIn 2) hp (isPGroup_pCoreIn 2 Y) hXQ
      (le_inf ((pCoreIn_le 2 Y).trans hYM) (hker.symm.le.trans inf_le_right)) hCY
  let xM : M := inclusion hYM x
  have hxM : orderOf xM = 3 := (orderOf_injective (inclusion hYM) (inclusion_injective hYM) x).trans hx
  have hX3 : IsPGroup 3 (zpowers xM) :=
    IsPGroup.of_card (n := 1) (by simpa only [Nat.card_zpowers,pow_one] using hxM)
  obtain ⟨P,hXP⟩ := hX3.exists_le_sylow
  have hcop := h.extraspecial_third_action_kernel_coprime
    hG T hempty hM hmany hJ hu hfull hex hN hNM hNMc
  have hPC := h.extraspecial_third_threeSylow_centralizes
    hG T hempty hM hmany hJ hu hfull hex hN hNM hNMc hcop P (zpowers xM)
      (zpowers_le.mpr x.property) hXP
  let P₀ := (P : Subgroup M).map M.subtype
  have hPX : P₀ ≤ centralizer (X : Set G) := by
    have hXmap : (zpowers xM).map M.subtype = X := by rw [MonoidHom.map_zpowers]; rfl
    rw [←hXmap]
    exact (map_mono hPC).trans (map_centralizer_le_centralizer_image _ M.subtype)
  have hMC : M ≤ normalizer (C : Set G) :=
    (le_inf M.le_normalizer (h.normalized.trans
      (normalizer_le_normalizer_centralizer _))).trans inf_normalizer_le_normalizer_inf
  have hPY : P₀ ≤ normalizer (Y : Set G) := by
    rw [←hXC]
    exact normalizes_conjugateSpanBy X C P₀ (hPX.trans (Subgroup.centralizer_le_normalizer _))
      ((map_subtype_le _).trans hMC)
  rw [hnorm] at hPY
  let H := (M ⊓ N).subgroupOf M
  have hPH : (P : Subgroup M) ≤ H := by
    intro p hpP
    exact ⟨p.property,hPY (mem_map_of_mem M.subtype hpP)⟩
  let f := (actionHom M V h.normalized).rangeRestrict
  let A := H.map f
  have hord := source_ordering_of_centralizing_orderingMaximal hG T hempty
    hM hJ N hN
  have hCH : f.ker ≤ H := by
    intro m hm
    have hh : m ∈ (actionHom M V h.normalized).ker := congrArg Subtype.val hm
    rw [actionHom_ker] at hh
    have hCN : M ⊓ centralizer (V : Set G) ≤ N := by
      rw [hfull]
      exact ((lemma_A_5_3 hord).2.2 (maximal_local_normalizer_from_source hG T hN)).trans inf_le_left
    exact ⟨m.property,hCN ⟨m.property,hh⟩⟩
  have hAi : A.index = 9 :=
    (h.extraspecial_third_intersection hG T hempty hM hmany hJ hu hfull hex hN hNM hNMc).2.1
  have hHi : H.index = 9 := by
    have hi : A.index = H.index := H.index_map_eq
      (actionHom M V h.normalized).rangeRestrict_surjective hCH
    exact hi.symm.trans hAi
  have hd := index_dvd_of_le hPH
  rw [hHi] at hd
  exact P.not_dvd_index ((by decide : 3 ∣ 9).trans hd)

/-- In the original full extraspecial row, the selected local and its
centralizer partner exhaust the maximal two-locals over T. -/
theorem PreparedChosenModule.maximal_overgroups_of_full_extraspecial
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc V : Subgroup G} (hM : IsOrderingMaximal T M)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (h : PreparedChosenModule T M V) (hfull : V = localModule T M)
    (hex : letI := h.elementary; SourceCases.Extraspecial (imageRepresentation M V h.normalized)
      (((T : Subgroup G).subgroupOf M).map (actionHom M V h.normalized).rangeRestrict)) :
    maximalTwoLocalOvergroups (T : Subgroup G) = {M,Mc} := by
  classical
  have hMc : Mc ∈ maximalTwoLocalOvergroups
      (centralizer (centralInvolutions T : Set G)) := hu ▸ Set.mem_singleton Mc
  have hTMc : (T : Subgroup G) ≤ Mc := by
    intro t ht
    exact hMc.2 (fun z hz => (centralInvolutions_le_centralizer_sylow T hz t ht).symm)
  ext N
  constructor
  · intro hN
    by_cases hNM : N = M
    · simp [hNM]
    by_cases hNMc : N = Mc
    · simp [hNMc]
    exact (h.extraspecial_full_no_third_maximal hG T hempty hM hmany hJ hu hfull hex hN hNM hNMc).elim
  · intro hN
    rcases Set.mem_insert_iff.mp hN with rfl | hN
    · exact hM.1
    · obtain rfl := Set.mem_singleton_iff.mp hN
      exact ⟨hMc.1,hTMc⟩

end CFSG.Quasithin.Chapter15.Section01
