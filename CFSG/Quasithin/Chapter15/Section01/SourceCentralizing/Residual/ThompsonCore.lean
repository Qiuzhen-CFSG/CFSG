module
public import CFSG.Quasithin.Chapter15.Section01.SourceCentralizing.Residual.CoreReduction
public import CFSG.Quasithin.ChapterB.Section02.Thompson.RankGap

/-!
# The Thompson-core obstruction in the original residual witness

If the self-centralizing two-core of an outside minimal parabolic lies in
J₁(T), then Ω₁Z(J₁(T)) lies in Ω₁Z(O₂(P)). The proved source core-omega
centralization therefore makes its residual fix the original C_V(J₁(T)).
Consequently every selected moving witness has O₂(P) outside J₁(T).
If that core is generated by its maximum elementary subgroups, its two-rank
is at least two below that of T, and its index in T is greater than two.

All deductions use the same original prepared V and the literal embedded
core and residual. The remaining witness is not excluded by this reduction.

Source: Aschbacher--Smith15.1.14(1), printed p.1091, using B.2.2--3 and
characteristic two; the residual-centralization input is proved in CoreReduction.
-/

public section
open Subgroup Stellmacher Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter15.Section01
open Section03 Section03.InitialSource ChapterA.Section05To06
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
private theorem omega_center_le_core_omega (P Q J : Subgroup G) (hJP : J ≤ P)
    (hc : P ⊓ centralizer (Q : Set G) ≤ Q) (hQJ : Q ≤ J) :
    omegaOneCenterAmbient J ≤ omegaCenterIn Q := by
  intro x hx
  obtain ⟨hxJ,hx2,hxc⟩ := (mem_omegaOneCenterAmbient_iff J x).mp hx
  have hxC : x ∈ centralizer (Q : Set G) := fun q hq => hxc q (hQJ hq)
  exact (mem_omegaCenterIn_iff Q x).mpr ⟨hc ⟨hJP hxJ,hxC⟩,hxC,hx2⟩


/-- A two-core contained in J₁(T) makes the entire Thompson omega-center fixed by the residual. -/
theorem source_outside_minimalParabolic_thompson_residual_of_core_le
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M P : Subgroup G} (hM : IsOrderingMaximal T M)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hP : P ∈ Chapter1.HOver G (T : Set G))
    (hpar : ChapterB.IsMinimalParabolicOver T P) (hPM : ¬ P ≤ M)
    (hQJ : P.pCoreIn 2 ≤ ChapterB.thompsonJ (T : Subgroup G) 1) :
    omegaOneCenterAmbient (ChapterB.thompsonJ (T : Subgroup G) 1) ≤
      centralizer ((pResidual 2 P).map P.subtype : Set G) := by
  have hself : P ⊓ centralizer (P.pCoreIn 2 : Set G) ≤ P.pCoreIn 2 :=
    Chapter1.lemma_1_1_4_6 T (hG.evenCharacteristic T) hP
  have hE := omega_center_le_core_omega P (P.pCoreIn 2)
    (ChapterB.thompsonJ (T : Subgroup G) 1) ((ChapterB.thompsonJ_le _ _).trans hP.2) hself hQJ
  have hc := source_outside_minimalParabolic_residual_centralizes_core_omega
    hG T hempty hM hJ hP hpar hPM
  intro e he r hr
  obtain ⟨r,hr,rfl⟩ := hr
  obtain ⟨heQ,heC,he2⟩ := (mem_omegaCenterIn_iff _ _).mp (hE he)
  have heP : e ∈ P := pCoreIn_le 2 P heQ
  have heQ' : (⟨e,heP⟩ : P) ∈ pCore 2 P := by
    obtain ⟨q,hq,hqe⟩ := heQ
    have he : q = ⟨e,heP⟩ := Subtype.ext hqe
    exact he ▸ hq
  have heOmega : (⟨e,heP⟩ : P) ∈ omegaCenterIn (pCore 2 P) := by
    apply (mem_omegaCenterIn_iff _ _).mpr
    refine ⟨heQ',?_,?_⟩
    · intro q hq
      exact Subtype.ext (heC q (mem_map_of_mem P.subtype hq))
    · exact Subtype.ext he2
  exact (congrArg P.subtype (hc hr _ heOmega)).symm

/-- A residual moving the actual chosen fixed subgroup forces a strict core-rank obstruction. -/
theorem PreparedChosenModule.moving_parabolic_core_constraints
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M V P : Subgroup G} (hM : IsOrderingMaximal T M)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (h : PreparedChosenModule T M V)
    (hP : P ∈ Chapter1.HOver G (T : Set G))
    (hpar : ChapterB.IsMinimalParabolicOver T P) (hPM : ¬ P ≤ M)
    (hmove : ¬ (pResidual 2 P).map P.subtype ≤ centralizer (thompsonFixed T V : Set G)) :
    ¬ P.pCoreIn 2 ≤ ChapterB.thompsonJ (T : Subgroup G) 1 ∧
      (elementaryAbelianMaxJ (P.pCoreIn 2) = P.pCoreIn 2 →
        ChapterB.twoRank (P.pCoreIn 2) + 1 < ChapterB.twoRank (T : Subgroup G) ∧
          2 < (P.pCoreIn 2).relIndex (T : Subgroup G)) := by
  have hn : ¬ P.pCoreIn 2 ≤ ChapterB.thompsonJ (T : Subgroup G) 1 := by
    intro hQJ
    exact hmove (le_centralizer_iff.mp ((h.thompsonFixed_le_omega T hM).trans
      (source_outside_minimalParabolic_thompson_residual_of_core_le
        hG T hempty hM hJ hP hpar hPM hQJ)))
  refine ⟨hn,?_⟩
  intro hcore
  let := h.elementary
  have hr := chosen_twoRank_gt_one_of_quadraticRatio_two T hM.1.2 h.le_selected
    h.normalized h.quadratic_ratio
  have hQT : P.pCoreIn 2 ≤ (T : Subgroup G) := by
    have hmap : ((T.subtype hP.2 : Sylow 2 P) : Subgroup P).map P.subtype =
        (T : Subgroup G) := map_subgroupOf_eq_of_le hP.2
    have hle := pCoreIn_le_sylow P (T.subtype hP.2)
    rwa [hmap] at hle
  have hgap : ChapterB.twoRank (P.pCoreIn 2) + 1 < ChapterB.twoRank (T : Subgroup G) := by
    apply Nat.lt_of_not_ge
    intro hle
    apply hn
    rw [←hcore]
    exact ChapterB.maxJ_le_thompson_one_of_rank_gap _ _ hQT hr hle
  refine ⟨hgap,?_⟩
  apply Nat.lt_of_not_ge
  intro hi
  exact hgap.not_ge (ChapterB.twoRank_le_add_one_of_relIndex_le_two _ _ hi)

/-- Failure of15.1.14 retains the nonabelian witness and forces its core outside J₁(T).
For a self-Thompson core, both the rank deficit and the Sylow index must be larger. -/
theorem PreparedChosenModule.thompsonFixed_moving_parabolic_core_obstruction
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M V : Subgroup G} (hM : IsOrderingMaximal T M)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (h : PreparedChosenModule T M V)
    (hnot : ¬ (pResidual 2 (centralizer (centralInvolutions T : Set G))).map
      (centralizer (centralInvolutions T : Set G)).subtype ≤
        centralizer (thompsonFixed T V : Set G)) :
    ∃ P : Subgroup G, P ≤ centralizer (centralInvolutions T : Set G) ∧
      P ∈ Chapter1.HOver G (T : Set G) ∧ ChapterB.IsMinimalParabolicOver T P ∧
      IsSQTK KnownSimple.IsKnownSimple P ∧ generalizedFitting P = pCore 2 P ∧
      ¬ P ≤ M ∧ ¬ IsMulCommutative (pCore 2 P) ∧
      pResidual 2 P ≤ centralizer (omegaCenterIn (pCore 2 P) : Set P) ∧
      (∀ U : Subgroup P, IsPReduced 2 U → centralizer (U : Set P) = ⊤) ∧
      ¬ (pResidual 2 P).map P.subtype ≤ centralizer (thompsonFixed T V : Set G) ∧
      ¬ P.pCoreIn 2 ≤ ChapterB.thompsonJ (T : Subgroup G) 1 ∧
      (elementaryAbelianMaxJ (P.pCoreIn 2) = P.pCoreIn 2 →
        ChapterB.twoRank (P.pCoreIn 2) + 1 < ChapterB.twoRank (T : Subgroup G) ∧
          2 < (P.pCoreIn 2).relIndex (T : Subgroup G)) := by
  obtain ⟨P,hPC,hPH,hP,hSQ,hF,hPM,hna,hω,hred,hmove⟩ :=
    h.thompsonFixed_moving_nonabelian_parabolic hG T hempty hM hJ hnot
  exact ⟨P,hPC,hPH,hP,hSQ,hF,hPM,hna,hω,hred,hmove,
    h.moving_parabolic_core_constraints hG T hempty hM hJ hPH hP hPM hmove⟩

end CFSG.Quasithin.Chapter15.Section01

