universe u

private theorem kernel_span_of_natural_cover
    {G : Type*} [Group G] [Finite G] (H F D B A : Subgroup G)
    [IsElementaryAbelian 2 F] [IsElementaryAbelian 2 A]
    (n : ℕ) (hn : 3 ≤ n)
    (π : H →* Matrix.SpecialLinearGroup (Fin n) (ZMod 2)) (hπ : Function.Surjective π)
    (d : BinaryConjugationSection H F D ((specialLinearNatural n).comp π))
    (hHD : H ≤ centralizer (D : Set G)) (hmoved : ⁅F,H⁆ = F)
    (hBD : ⁅B,F⁆ ≤ D) (hk : ∀ a : H, π a = 1 → (a : G) ∈ B)
    (hAH : A ≤ H) (hne : ∃ a : A, π (inclusion hAH a) ≠ 1)
    (hindex : (centralizer (A : Set G)).relIndex F ≤ 2) : ⁅B,F⁆ = D := by
  let D₀ := ⁅B,F⁆
  have hD₀F : D₀ ≤ F := hBD.trans d.kernel_le
  have hHD₀ : H ≤ centralizer (D₀ : Set G) := hHD.trans (centralizer_le hBD)
  have hnD₀ : H ≤ normalizer (D₀ : Set G) := hHD₀.trans (Subgroup.centralizer_le_normalizer _)
  let : (D₀.subgroupOf F).Normal := normal_subgroupOf_of_le_normalizer
    (d.section_le.trans hnD₀)
  obtain ⟨τ,c,_⟩ := BinaryConjugationSection.exists_descended_actor H F D₀
    d.section_le hD₀F d.normalized hnD₀ π hπ
    (fun a ha f hf => commutator_mem_commutator (hk a ha) hf)
  obtain ⟨p₀,hp₀,heq⟩ := c.exists_nested_coordinate_map d le_rfl hBD
  change ∀ f : F, p₀ (c.coordinates f).toAdd = (d.coordinates f).toAdd at hp₀
  let p : τ.IntertwiningMap (specialLinearNatural (k := ZMod 2) n) :=
    p₀.intertwiningMap_of_isIntertwiningMap _ _ (by
      intro a w
      obtain ⟨x,rfl⟩ := hπ a
      exact heq x x rfl w)
  have hp : Function.Surjective p := by
    intro w
    obtain ⟨f,hf⟩ := d.onto (Multiplicative.ofAdd w)
    exact ⟨(c.coordinates f).toAdd,(hp₀ f).trans (congrArg Multiplicative.toAdd hf)⟩
  have hfixed : p.toLinearMap.ker ≤ OneCohomology.fixed τ := by
    intro w hw a
    obtain ⟨f,hf⟩ := c.onto (Multiplicative.ofAdd w)
    have hf' : (c.coordinates f).toAdd = w := congrArg Multiplicative.toAdd hf
    have hd : (f : G) ∈ D := by
      apply (d.coordinates_eq_one_iff f).mp
      change (d.coordinates f).toAdd = 0
      rw [←hp₀]
      exact hf'.symm ▸ hw
    obtain ⟨x,rfl⟩ := hπ a
    rw [←hf']
    change ((τ.comp π) x) (c.coordinates f).toAdd = (c.coordinates f).toAdd
    rw [←c.equivariant x f]
    congr 2
    apply Subtype.ext
    change (x : G) * (f : G) * (x : G)⁻¹ = (f : G)
    rw [(hHD x.property f hd).symm,mul_inv_cancel_right]
  have hmove : Coinvariants.ker τ = ⊤ :=
    c.coinvariants_eq_top_of_group_generation H le_rfl τ π (fun _ _ => rfl) (by
      rw [commutator_comm,hmoved,sup_eq_left.mpr hD₀F])
  let J := F ⊓ centralizer (A : Set G)
  have hD₀J : D₀ ≤ J := le_inf hD₀F
    (le_centralizer_iff.mp (hAH.trans hHD₀))
  have hcost : fixedCodim τ ((A.subgroupOf H).map π) ≤ 1 :=
    BinaryConjugationSection.fixedCodim_le_one_of_fixed_index H F D₀ A J τ π c
      inf_le_left hD₀J
      ((commutator_mono le_rfl inf_le_right).trans
        ((commutator_eq_bot_iff_le_centralizer.mpr
          (le_centralizer_iff.mp le_rfl)).le.trans bot_le))
      (by simpa only [J,inf_relIndex_left] using hindex)
  obtain ⟨a,ha⟩ := hne
  have ha2 : orderOf (π (inclusion hAH a)) = 2 := orderOf_eq_prime (by
    rw [←map_pow,←map_pow]
    have ha' : a ^ 2 = 1 := Subtype.ext
      (elemPow_eq_one_of_isElementaryAbelian (p := 2) (a : G) a.property)
    rw [ha',map_one,map_one]) ha
  have hle : zpowers (π (inclusion hAH a)) ≤ (A.subgroupOf H).map π :=
    zpowers_le.mpr (mem_map_of_mem π a.property)
  have hdim := Submodule.finrank_mono (fixedSpace_antitone τ hle)
  have hc := fixedCodim_add_finrank τ ((A.subgroupOf H).map π)
  have hz := fixedCodim_add_finrank τ (zpowers (π (inclusion hAH a)))
  have hi := DecomposableQuinticControl.natural_cover_injective_of_small_involution
    n hn τ p ⟨hp,hfixed,hmove⟩ (π (inclusion hAH a)) ha2 (by omega)
  apply le_antisymm hBD
  intro f hf
  have hpf : p (c.coordinates ⟨f,d.kernel_le hf⟩).toAdd = 0 := by
    rw [show p (c.coordinates ⟨f,d.kernel_le hf⟩).toAdd =
      (d.coordinates ⟨f,d.kernel_le hf⟩).toAdd from hp₀ _]
    exact (d.coordinates_eq_one_iff _).mpr hf
  have hz' : (c.coordinates ⟨f,d.kernel_le hf⟩).toAdd = 0 :=
    hi (hpf.trans (map_zero p).symm)
  exact (c.coordinates_eq_one_iff _).mp hz'

variable {G : Type u} [Group G] [Finite G]

/-- The original section kernel in the normal closure of V generates exactly
its canonical denominator by commutators with the full elementary span. -/
theorem PreparedChosenModule.decomposable_five_partner_two_kernel_span
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc V : Subgroup G} (hM : IsOrderingMaximal T M)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localModule T M : Set G))
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (h : PreparedChosenModule T M V) (hfull : V = localModule T M) :
    letI := h.elementary
    ∀ {U : Submodule (ZMod 2) (Additive V)}
      (c : FactorData (imageRepresentation M V h.normalized)
        (Jhat (imageRepresentation M V h.normalized)) U)
      (d : Decomposition c.representation), d.FittingFull →
    ∀ (s : DecomposableMarker.ThompsonPair (T := T) h.normalized c d)
      (π : internalActionImage M V h.normalized →* Equiv.Perm d.Index),
      (∀ g k, (c.ambientFactor d k).actor.map (MulAut.conj g).toMonoidHom =
        (c.ambientFactor d (π g k)).actor) →
      (∀ g k, (c.ambientFactor d k).space.map (imageRepresentation M V h.normalized g) =
        (c.ambientFactor d (π g k)).space) →
      SourceCases.Decomposable (imageRepresentation M V h.normalized) (T : Subgroup G) M
        (actionHom M V h.normalized).rangeRestrict c d π →
      cubicRatio (imageRepresentation M V h.normalized) = 2 → s.prime = 5 →
      Nat.card (localModule T Mc) = 2 →
      let E := thompsonFixed T V
      let C := centralizer (localModule T Mc : Set G)
      let F := conjugateSpanBy E C
      let D := (((F ⊓ centralizer (V : Set G)).subgroupOf Mc).normalCore).map Mc.subtype
      V ≤ Mc.pCoreIn 2 ∨
        ∀ {W : Type u} [AddCommGroup W] [Module (ZMod 2) W]
          (ρ : Representation (ZMod 2) Mc W) (_dF : BinaryConjugationSection Mc F D ρ),
          D ⊓ thompsonPlane T V (c.ambientFactor d s.first).space = ⊥ →
          let N := normalClosure (V.subgroupOf Mc : Set Mc)
          let K := commutatorPreimage Mc F D
          ⁅K ⊓ N.map Mc.subtype,F⁆ = D := by
  let := h.elementary
  intro U c d hd s π hp hs hdec hq hfive hcU
  let E := thompsonFixed T V
  let C := centralizer (localModule T Mc : Set G)
  let F := conjugateSpanBy E C
  let D := (((F ⊓ centralizer (V : Set G)).subgroupOf Mc).normalCore).map Mc.subtype
  by_cases hVQ : V ≤ Mc.pCoreIn 2
  · exact Or.inl hVQ
  right
  intro W _ _ ρ dF hDZ
  let N := normalClosure (V.subgroupOf Mc : Set Mc)
  let H := N.map Mc.subtype
  let L := ((solvableResidual N).map N.subtype).map Mc.subtype
  let K := commutatorPreimage Mc F D
  let B := K ⊓ H
  let A := plane V (c.ambientFactor d s.first).space
  have hHMc : H ≤ Mc := map_subtype_le N
  obtain ⟨_,_,_,_,_,hmoved,hFL,himage⟩ :=
    ((h.decomposable_five_partner_two_perfect_actor
      hG T hempty hM hmany hJ hu hfull c d hd s π hp hs hdec hq hfive hcU).resolve_left hVQ)
      ρ dF hDZ
  obtain ⟨_,_,_,hLH,hHD,_,hBD,_⟩ :=
    ((h.decomposable_five_partner_two_disjoint_normal_kernel_rows
      hG T hempty hM hmany hJ hu hfull c d hd s π hp hs hdec hq hfive hcU).resolve_left hVQ)
      ρ dF hDZ
  obtain ⟨hrank,_,_,_,_,n,hn,⟨e⟩⟩ :=
    ((h.decomposable_five_partner_two_canonical_natural
      hG T hempty hM hmany hJ hu hfull c d hd s π hp hs hdec hq hfive hcU).resolve_left hVQ)
      ρ dF hDZ
  have hFH : F ≤ H := hFL.trans hLH
  change ⁅F,L⁆ = F at hmoved
  change L ≤ H at hLH
  have hmoveH : ⁅F,H⁆ = F := le_antisymm
    (le_normalizer_iff_commutator_le_left.mp (hHMc.trans dF.normalized))
    (hmoved.ge.trans (commutator_mono le_rfl hLH))
  let f := Representation.BinaryOffender.actionHom ρ
  let q := e.groupEquiv.toMonoidHom.comp (f.comp (inclusion hHMc))
  have hqsurj : Function.Surjective q := by
    intro x
    have hx : e.groupEquiv.symm x ∈ actionSubgroup ρ (L.subgroupOf Mc) := himage ▸ mem_top _
    obtain ⟨l,hl,he⟩ := hx
    refine ⟨⟨l,hLH hl⟩,?_⟩
    change e.groupEquiv (f l) = x
    exact (congrArg e.groupEquiv he).trans (e.groupEquiv.apply_symm_apply x)
  let dNat : BinaryConjugationSection H F D ((specialLinearNatural n).comp q) := {
    section_le := hFH
    kernel_le := dF.kernel_le
    normalized := hHMc.trans dF.normalized
    coordinates := e.linearEquiv.toAddEquiv.toMultiplicative.toMonoidHom.comp dF.coordinates
    onto := e.linearEquiv.toAddEquiv.toMultiplicative.surjective.comp dF.onto
    kernel_eq := by
      ext x
      change e.linearEquiv (dF.coordinates x).toAdd = 0 ↔ (x:G) ∈ D
      rw [e.linearEquiv.map_eq_zero_iff]
      exact dF.coordinates_eq_one_iff x
    equivariant := by
      intro a x
      change e.linearEquiv (dF.coordinates _).toAdd =
        specialLinearNatural n (q a) (e.linearEquiv (dF.coordinates x).toAdd)
      exact (congrArg e.linearEquiv (dF.equivariant (inclusion hHMc a) x)).trans
        (e.intertwines (f (inclusion hHMc a)) _) }
  obtain ⟨_,_,_,hnD,_⟩ := (h.decomposable_five_partner_two_core_or_canonical_action
    hG T hempty hM hmany hJ hu hfull c d hd s π hp hs hdec hq hfive hcU).resolve_left hVQ
  have hk (a : H) (ha : q a = 1) : (a:G) ∈ B := by
    refine ⟨?_,a.property⟩
    have hf : f (inclusion hHMc a) = 1 := e.groupEquiv.injective
      (ha.trans e.groupEquiv.map_one.symm)
    have hker : inclusion hHMc a ∈ ρ.ker :=
      congrArg (fun x : Representation.BinaryOffender.actionImage ρ => (x.val).val) hf
    have hh := mem_map_of_mem Mc.subtype hker
    rw [dF.action_kernel_map hnD] at hh
    exact hh
  have hUE := (h.decomposable_five_partner_control
    hG T hempty hM hmany hJ hu hfull c d hd s π hp hs hdec hq hfive).2.2
  have hVMc : V ≤ Mc := (V.le_centralizer.trans
    (centralizer_le (hUE.trans inf_le_left))).trans (localModule_centralizer_le_partner T Mc hu)
  have hVH : V ≤ H := by
    intro v hv
    exact mem_map_of_mem Mc.subtype
      (subset_normalClosure (show (⟨v,hVMc hv⟩ : Mc) ∈ V.subgroupOf Mc from hv))
  have hAH : A ≤ H := (plane_le _).trans hVH
  let : IsElementaryAbelian 2 A := IsElementaryAbelian.of_le (plane_le _)
  have hne : ∃ a : A, q (inclusion hAH a) ≠ 1 := by
    have hnA : actionSubgroup ρ (A.subgroupOf Mc) ≠ ⊥ := by
      intro hz
      rw [hz,BinaryOffender.rank_bot] at hrank
      omega
    obtain ⟨x,hxne⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hnA
    obtain ⟨a,ha,he⟩ := x.property
    refine ⟨⟨a,ha⟩,?_⟩
    intro hh
    have hf : f a = 1 := e.groupEquiv.injective (hh.trans e.groupEquiv.map_one.symm)
    exact hxne (Subtype.ext (he.symm.trans hf))
  obtain ⟨_,hFQZ,hEF,_,_,_⟩ := (h.decomposable_five_partner_core_alternatives
    hG T hempty hM hmany hJ hu hfull c d hd s π hp hs hdec hq hfive).resolve_left hVQ
  obtain ⟨_,hcore,hQT,_,_,_,_,_⟩ := h.decomposable_five_partner_kernel_core
    hG T hempty hM hmany hJ hu hfull c d hd s π hp hs hdec hq hfive
  have hFT : F ≤ (T : Subgroup G) := hFQZ.trans inf_le_left |>.trans (hcore ▸ hQT)
  have hFE : F ≤ centralizer (E : Set G) := hFQZ.trans inf_le_right |>.trans
    (centralizer_le (hEF.trans (hFQZ.trans inf_le_left)))
  have hFN : F ≤ normalizer (A : Set G) := fun x hx => s.centralizer_le_stabilizer
    ⟨hFT hx,(hFE.trans (centralizer_le (show thompsonPlane T V
      (c.ambientFactor d s.first).space ≤ E from inf_le_right))) hx⟩
  let : IsElementaryAbelian 2 F := (h.decomposable_five_partner_fixed_envelope
    hG T hempty hM hmany hJ hu hfull c d hd s π hp hs hdec hq hfive).2.2.2.1
  have hindex : (centralizer (A : Set G)).relIndex F ≤ 2 :=
    elementary_support_action_index hM.1.2 h.normalized c d s π hp hs hfive F hFT s.first hFN
  exact kernel_span_of_natural_cover H F D B A n (by rcases hn with rfl|rfl|rfl <;> omega)
    q hqsurj dNat hHD hmoveH hBD hk hAH hne hindex

end CFSG.Quasithin.Chapter15.Section01
