module
public import CFSG.Quasithin.ChapterG.Section10.Components
public import Theory.GroupTheory.GeneralizedFitting.SylowMovedComponent
public import Theory.Representation.BinaryOffender.IrreducibleDiagonal

/-!
# Movement of invariant subspaces in G.10.10

The selected component's normal orbit is generated by commutators with X.
An invariant subspace centralized by X is therefore fixed by this normal
orbit, whose fixed space is zero in the faithful irreducible representation.
This proves the movement conclusion independently of the separate
marked-point-containment argument.

Source: Aschbacher--Smith G.10.10, printed p.360.
-/

public noncomputable section
open Subgroup Theory.GroupTheory

open Module Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterG.Section10.Hypothesis
variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V]
  [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
  {ρ : Representation (ZMod 2) G V} {B : LinearMap.BilinForm (ZMod 2) V}
  {v : V} {W : Submodule (ZMod 2) V} {X : Subgroup G}
  [IsElementaryAbelian 2 X] {X₀ : Subgroup X}
  (h : Hypothesis ρ B v W X X₀)
include h

/-- The movement conclusion in G.10.10 does not require the separate
invariant-submodule classification G.10.4(2). -/
theorem normal_component_subspace_not_fixed (hn : ¬ Group.IsSolvable G)
    {L : Subgroup G} (hL : IsComponent G L) (hm : ⁅L,X⁆ ≠ ⊥)
    (S : Sylow 2 G) (hnX : (S : Subgroup G) ≤ normalizer (X : Set G))
    (hi : (normalizer (L : Set G)).index ≤ 2)
    (U : Submodule (ZMod 2) V) (hU : componentOrbit L ⊤ ≤ subspaceStabilizer ρ U)
    (hU0 : U ≠ ⊥) : ¬ U ≤ fixedSpace ρ X := by
  intro hf
  have hc := le_fixedSpace_commutator_of_invariant ρ hU hf
  rw [hL.normalOrbit_eq_commutator_of_sylow_normalizes S X hnX hi hm] at hc
  let := componentOrbit_top_normal L
  have hfixed := fixedSpace_eq_bot_of_normal_faithful_irreducible ρ h.faithful
    (h.irreducible_of_not_solvable hn) (componentOrbit L ⊤)
    (hL.componentOrbit_top_ne_bot)
  exact hU0 (le_bot_iff.mp (hfixed ▸ hc))

end CFSG.Quasithin.ChapterG.Section10.Hypothesis
