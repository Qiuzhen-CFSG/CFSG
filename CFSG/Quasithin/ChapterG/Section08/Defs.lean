module

public import Theory.ElementaryAbelian.Basic
public import Theory.GroupTheory.GeneralizedFitting.Defs
public import Theory.GroupTheory.PGroup.Supercritical
public import Mathlib.GroupTheory.SpecificGroups.Dihedral

/-!+# Source interfaces for the extension of Thompson's dihedral lemma

These definitions retain the actual subgroup actions, complements, embedded
dihedral products and supercritical subgroups used in Aschbacher–Smith,
*The Classification of Quasithin Groups*, G.8, printed pp.349–351 (combined
manuscript, 1 March 2004). Faithfulness is the triviality of the actual
centralizer intersection. A dihedral product is an injective homomorphism
from the product of the indicated concrete groups.

The displayed G.8.9(1) has `F*(X)` in its centralizer subscript. Its proof
on p.351 and its consumer A.4.4(b), p.58, use `F*(H)`, which is the intended
hypothesis: with `F*(X)` the
centralizer is already contained in X, making the hypothesis vacuous,
including at X = 1. The terminal result must use the ambient `F*(H)`.
Subnormality is relative to `F*(H)`, not ambient normality.
-/

@[expose] public section

namespace CFSG.Quasithin.ChapterG.Section08

open Subgroup Theory.GroupTheory

universe u
variable {G : Type u} [Group G]

/-- The conclusion of G.8.2, including its full centralizer clause. -/
def FaithfulComplement (A B X D : Subgroup G) : Prop :=
  B ⊓ D = ⊥ ∧ B ⊔ D = A ∧
    B ⊓ centralizer (X ⊓ centralizer (D : Set G) : Set G) = ⊥ ∧
    A ⊓ centralizer (X ⊓ centralizer (D : Set G) : Set G) = D

/-- The universal G.8.2 input for the independent dihedral induction.
This is a proof obligation, not an additional source hypothesis. -/
def FaithfulComplementTheorem (G : Type u) [Group G] : Prop :=
  ∀ [Finite G] (A B X : Subgroup G),
    IsElementaryAbelian 2 A → Group.IsNilpotent X → Odd (Nat.card X) →
      A ≤ normalizer (X : Set G) → B ≤ A →
        B ⊓ centralizer (X : Set G) = ⊥ →
          ∃ D : Subgroup G, FaithfulComplement A B X D

/-- A genuine embedded direct product of odd-prime dihedral groups. -/
structure DihedralProduct (G : Type u) [Group G] (n : ℕ) where
  prime : Fin n → ℕ
  prime_isPrime : ∀ i, (prime i).Prime
  prime_odd : ∀ i, Odd (prime i)
  embedding : (∀ i, DihedralGroup (prime i)) →* G
  injective : Function.Injective embedding

/-- Λ(K), generated by all elements of prime order in the actual subgroup K. -/
def primeOrderGenerated (K : Subgroup G) : Subgroup G :=
  closure {x : G | x ∈ K ∧ (orderOf x).Prime}

/-- The prime divisors of |F(G)|, indexing the factors in Θ(G). -/
abbrev FittingPrimes (G : Type u) [Group G] :=
  {p : ℕ // p.Prime ∧ p ∣ Nat.card (fittingSubgroup G)}

/-- Membership in the source family Θ(G). The factors are actual
supercritical subgroups inside O_p(G), mapped into the ambient group. -/
def IsThetaSubgroup (θ : Subgroup G) : Prop :=
  ∃ D : (p : FittingPrimes G) → Subgroup (pCore p.val G),
    (∀ p, IsSupercriticalPSubgroup p.val (D p)) ∧
      θ = componentLayer G ⊔ ⨆ p, (D p).map (pCore p.val G).subtype

end CFSG.Quasithin.ChapterG.Section08
