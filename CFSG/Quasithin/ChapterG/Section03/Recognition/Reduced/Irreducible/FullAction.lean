module

public import CFSG.Quasithin.ChapterG.Section03.Recognition.Reduced.Irreducible.Enlargement
public import CFSG.Quasithin.ChapterG.Section03.Recognition.Reduced.Irreducible.RootFormEnvelope
public import CFSG.Quasithin.ChapterG.Section03.Recognition.Reduced.Irreducible.RootFormSeed
public import CFSG.Quasithin.ChapterG.Section03.Recognition.Configurations

/-!
# Irreducible binary root-orbit recognition

A finite group generated by a spanning orbit of binary root groups of order
greater than two is the full linear group if its actual action is irreducible.
The orbit is then all nonzero vectors, and its actual restriction action is
surjective. Thus the whole orbit enlarges every proper full configuration.

The proof constructs a three-dimensional root-form seed, propagates its form
space to an envelope, and applies global irreducibility to the invariant
annihilator. All seed and envelope premises are discharged here. This replaces
the inference that a particular boundary root moves the local fixed space;
no irreducibility of a subgroup or restriction is assumed.

Source motivation: Aschbacher--Smith, G.3.1, printed pp.337--338. These results
prove the irreducible specialization, not the unrestricted printed statement.
-/

@[expose] public section

open BinaryLinear BinaryTransvectionGroups
namespace CFSG.Quasithin.ChapterG.Section03.Reduced
variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
variable {G : Subgroup (GL V)} {Δ : Set V}

/-- Construct the global envelope from the genuine root-orbit hypotheses. -/
theorem RootGeneratedOrbit.exists_rootFormEnvelope [Finite G]
    (r : RootGeneratedOrbit G Δ) : ∃ E, IsRootFormEnvelope G Δ E := by
  obtain ⟨W, E, hs⟩ := r.exists_rootFormSeed
  exact ⟨E, r.rootFormEnvelope_of_seed hs⟩

/-- Global irreducibility forces the actual root-generated group to be full. -/
theorem RootGeneratedOrbit.eq_top_of_irreducible [Finite G]
    (r : RootGeneratedOrbit G Δ) (hirr : Irreducible G) : G = ⊤ := by
  obtain ⟨E, he⟩ := r.exists_rootFormEnvelope
  exact r.eq_top_of_envelope hirr he

/-- The large root groups force ambient dimension at least three. -/
theorem RootGeneratedOrbit.dimension_ge_three [Finite G]
    (r : RootGeneratedOrbit G Δ) : 3 ≤ Module.finrank (ZMod 2) V := by
  let : FiniteDimensional (ZMod 2) V := r.finiteDimensional
  obtain ⟨W, E, hs⟩ := r.exists_rootFormSeed
  exact hs.dimension_ge_three.trans W.finrank_le

/-- The irreducible spanning root orbit consists of every nonzero vector. -/
theorem RootGeneratedOrbit.all_points_of_irreducible [Finite G]
    (r : RootGeneratedOrbit G Δ) (hirr : Irreducible G) : Δ = {v : V | v ≠ 0} := by
  let : FiniteDimensional (ZMod 2) V := r.finiteDimensional
  ext v
  constructor
  · exact r.nonzero v
  · intro hv
    obtain ⟨x, hx⟩ := r.nonempty
    let d := (LinearEquiv.coord (ZMod 2) V x (r.nonzero x hx)).trans
      (LinearEquiv.coord (ZMod 2) V v hv).symm
    obtain ⟨g, hg⟩ := Submodule.exists_linearEquiv_restrict_eq d
    have hgv : g x = v := by
      have he := hg ⟨x, Submodule.mem_span_singleton_self x⟩
      have hd : d ⟨x, Submodule.mem_span_singleton_self x⟩ =
          ⟨v, Submodule.mem_span_singleton_self v⟩ := by
        apply (LinearEquiv.coord (ZMod 2) V v hv).injective
        simp [d, LinearEquiv.coord_self]
      rw [hd] at he
      exact he.symm
    rw [← hgv]
    exact r.stable g (r.eq_top_of_irreducible hirr ▸ Subgroup.mem_top g) x hx

/-- Surjectivity concerns the original restriction homomorphism. -/
theorem RootGeneratedOrbit.spanAction_surjective_of_irreducible [Finite G]
    (r : RootGeneratedOrbit G Δ) (hirr : Irreducible G) :
    Function.Surjective (spanAction G Δ) := by
  let : FiniteDimensional (ZMod 2) V := r.finiteDimensional
  intro a
  obtain ⟨g, hg⟩ := Submodule.exists_linearEquiv_restrict_eq a
  have hgG : g ∈ generated G Δ := by
    rw [r.generated_eq, r.eq_top_of_irreducible hirr]
    exact Subgroup.mem_top g
  refine ⟨⟨g, hgG⟩, ?_⟩
  ext v
  exact (hg v).symm

/-- The whole root orbit is a full configuration under global irreducibility. -/
theorem RootGeneratedOrbit.linearConfiguration_of_irreducible [Finite G]
    (r : RootGeneratedOrbit G Δ) (hirr : Irreducible G) :
    LinearConfiguration G Δ Δ := by
  refine ⟨Set.Subset.rfl, ?_, r.spanAction_surjective_of_irreducible hirr, ?_⟩
  · simpa only [r.span_eq_top, Submodule.mem_top, true_and] using
      r.all_points_of_irreducible hirr
  · rw [r.span_eq_top, finrank_top]
    exact le_trans (by decide : 2 ≤ 3) r.dimension_ge_three

/-- Every proper full configuration has a strictly larger full configuration.
The construction uses the whole orbit, so it needs no assertion about the
action of an individual boundary root on a local fixed space. -/
theorem RootGeneratedOrbit.enlarge_linearConfiguration_of_irreducible [Finite G]
    (r : RootGeneratedOrbit G Δ) (hirr : Irreducible G) {Γ : Set V}
    (c : LinearConfiguration G Δ Γ) (hne : Γ ≠ Δ) :
    ∃ Γ' : Set V, LinearConfiguration G Δ Γ' ∧ Γ ⊂ Γ' ∧ Γ.ncard < Γ'.ncard := by
  have hss : Γ ⊂ Δ := Set.ssubset_iff_subset_ne.mpr ⟨c.subset, hne⟩
  have hfin : Δ.Finite := by
    obtain ⟨x, rfl⟩ := r.orbit
    exact Finite.finite_mulAction_orbit x
  exact ⟨Δ, r.linearConfiguration_of_irreducible hirr, hss, Set.ncard_lt_ncard hss hfin⟩

end CFSG.Quasithin.ChapterG.Section03.Reduced
