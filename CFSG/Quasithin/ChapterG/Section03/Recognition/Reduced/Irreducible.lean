module

public import CFSG.Quasithin.ChapterG.Section03.Recognition.Reduced
public import CFSG.Quasithin.ChapterG.Section03.Recognition.Reduced.Irreducible.FullAction

/-!
# Recognition of irreducible root-generated actions

The actual irreducibility hypothesis immediately removes the common fixed-space
obstruction: the fixed vectors form a `G`-invariant subspace, and large root
groups exclude the trivial action. The imported root-form argument proves
`eq_top_of_irreducible_rootGeneratedOrbit`, exposed below under the recognition
contract's name, and constructs strictly larger full configurations from every
proper one. It uses global irreducibility without passing it to local subgroups
or restriction actions. The three-dimensional seed and its root-form envelope
are constructed from the orbit inputs; no configuration premise remains.

Source interface: Aschbacher--Smith G.3.1, printed pp.337--338 (PDF pp.348--349).
-/

@[expose] public section

open BinaryLinear BinaryTransvectionGroups
namespace CFSG.Quasithin.ChapterG.Section03.Reduced
variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
variable {G : Subgroup (GL V)} {Δ : Set V}

/-- A finite irreducible binary linear group generated by a spanning orbit of
root groups of order greater than two is the full linear group. -/
theorem eq_top_of_irreducible_rootGeneratedOrbit [Finite G]
    (r : RootGeneratedOrbit G Δ) (hirr : Irreducible G) : G = ⊤ :=
  r.eq_top_of_irreducible hirr

/-- An irreducible root-generated action has no common fixed vector. -/
theorem RootGeneratedOrbit.fixedSpace_eq_bot [Finite G]
    (r : RootGeneratedOrbit G Δ) (hirr : Irreducible G) : fixedSpace G = ⊥ := by
  have hpar : G ≤ parabolic (fixedSpace G) :=
    G.le_normalizer.trans (normalizer_le_parabolic_fixedSpace G)
  rcases hirr (fixedSpace G) hpar with hb | ht
  · exact hb
  · exfalso
    apply r.ne_bot
    apply bot_unique
    intro g hg
    ext v
    exact (show v ∈ fixedSpace G from ht ▸ Submodule.mem_top) g hg

end CFSG.Quasithin.ChapterG.Section03.Reduced
