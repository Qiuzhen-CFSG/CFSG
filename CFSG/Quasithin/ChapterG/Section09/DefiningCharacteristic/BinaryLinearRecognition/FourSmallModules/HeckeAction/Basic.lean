module

public import CFSG.Quasithin.ChapterG.Section09.DefiningCharacteristic.BinaryLinearRecognition.FourSmallModules.LocalData

/-!
# Rank-one and separated-root operators for binary SL₄

On the upper-fixed subspace, the operators `(1 + ρ(uᵢ))ρ(sᵢ)` are idempotent.
Their zero and one eigenvalues are exactly the local highest-vector alternatives.
Separated-root operators commute. These identities are verified on the actual
four-by-four binary matrices and transported through the representation.

Source: Aschbacher--Smith, combined manuscript (1 March 2004),
G.9.3(11)--(12), printed pp.354,356--357. The elementary root proofs adapt
the binary SL₅ highest-vector development in this repository to rank three.
-/

@[expose] public section

open Representation
open scoped MatrixGroups

namespace CFSG.Quasithin.ChapterG.Section09.DefiningCharacteristic.BinaryLinearRecognition.FourSmallModules.HeckeAction

/-- The rank-one identity giving the two-term formula on upper-fixed vectors. -/
theorem upper_mul_swap (i : Fin 3) :
    simpleUpper i * simpleSwap i = simpleLower i * simpleUpper i := by
  revert i
  decide

/-- An adjacent coordinate exchange is an involution. -/
theorem swap_sq (i : Fin 3) : simpleSwap i * simpleSwap i = 1 := by
  revert i
  decide

/-- A rank-one product rewritten with an upper transvection on the right. -/
theorem swap_mul_lower (i : Fin 3) :
    simpleSwap i * simpleLower i = simpleLower i * simpleUpper i := by
  revert i
  decide

/-- The upper-lower-upper expression for the adjacent coordinate exchange. -/
theorem upper_lower_upper (i : Fin 3) :
    simpleUpper i * (simpleLower i * simpleUpper i) = simpleSwap i := by
  revert i
  decide

private theorem nonadjacent_commute (i j : Fin 3)
    (hij : i.val + 1 < j.val ∨ j.val + 1 < i.val) :
    Commute (simpleUpper i) (simpleUpper j) ∧
    Commute (simpleUpper i) (simpleSwap j) ∧
    Commute (simpleSwap i) (simpleUpper j) ∧
    Commute (simpleSwap i) (simpleSwap j) := by
  unfold Commute SemiconjBy
  revert i j
  decide

/-- The subgroup generated by all positive root transvections. -/
def upperRootSubgroup : Subgroup Group :=
  Subgroup.closure {g | ∃ (i j : Fin 4) (hij : i < j),
    g = Matrix.SpecialLinearGroup.transvection (ne_of_lt hij) (1 : ZMod 2)}

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]

/-- The subspace fixed by every positive root transvection. -/
def upperFixedSubmodule (ρ : Representation (ZMod 2) Group V) : Submodule (ZMod 2) V where
  carrier := {v | UpperFixed ρ v}
  zero_mem' := by intro i j hij; simp
  add_mem' := by intro v w hv hw i j hij; rw [map_add, hv i j hij, hw i j hij]
  smul_mem' := by intro c v hv i j hij; rw [map_smul, hv i j hij]

/-- Generator fixedness is equivalent to fixedness under the generated subgroup. -/
theorem upperFixed_iff_fixed_subgroup (ρ : Representation (ZMod 2) Group V) (v : V) :
    UpperFixed ρ v ↔ ∀ g ∈ upperRootSubgroup, ρ g v = v := by
  constructor
  · intro hv g hg
    induction hg using Subgroup.closure_induction with
    | mem g hg =>
      obtain ⟨i, j, hij, rfl⟩ := hg
      exact hv i j hij
    | one => simp
    | mul g k _ _ hg hk =>
      rw [map_mul]
      change ρ g (ρ k v) = v
      rw [hk, hg]
    | inv g _ hg => exact ρ.inv_apply_eq_iff.mpr hg.symm
  · intro hv i j hij
    exact hv _ (Subgroup.subset_closure ⟨i, j, hij, rfl⟩)

/-- The simple zero-Hecke operator, initially defined on the ambient module. -/
def operator (ρ : Representation (ZMod 2) Group V) (i : Fin 3) : V →ₗ[ZMod 2] V :=
  (1 + ρ (simpleUpper i)) * ρ (simpleSwap i)

private theorem binary_add_self (v : V) : v + v = 0 := by
  have htwo : (1 : ZMod 2) + 1 = 0 := by decide
  simpa only [add_smul, one_smul, zero_smul] using congrArg (fun c : ZMod 2 => c • v) htwo

private theorem act_mul (ρ : Representation (ZMod 2) Group V) (g h : Group) (v : V) :
    ρ g (ρ h v) = ρ (g * h) v := by rw [map_mul]; rfl

/-- The defining pointwise formula for the root operator. -/
theorem operator_apply (ρ : Representation (ZMod 2) Group V) (i : Fin 3) (v : V) :
    operator ρ i v = ρ (simpleSwap i) v + ρ (simpleUpper i) (ρ (simpleSwap i) v) := rfl

/-- On upper-fixed vectors the operator is the sum of two rank-one translates. -/
theorem operator_apply_of_upperFixed (ρ : Representation (ZMod 2) Group V)
    (i : Fin 3) {v : V} (hv : UpperFixed ρ v) :
    operator ρ i v = ρ (simpleSwap i) v + ρ (simpleLower i) v := by
  rw [operator_apply, act_mul, upper_mul_swap, map_mul]
  change _ + ρ (simpleLower i) (ρ (simpleUpper i) v) = _
  have hu : ρ (simpleUpper i) v = v := hv i.castSucc i.succ (by simp)
  rw [hu]

/-- The rank-one operator is idempotent on upper-fixed vectors. -/
theorem operator_idempotent (ρ : Representation (ZMod 2) Group V)
    (i : Fin 3) {v : V} (hv : UpperFixed ρ v) :
    operator ρ i (operator ρ i v) = operator ρ i v := by
  have hu : ρ (simpleUpper i) v = v := hv i.castSucc i.succ (by simp)
  rw [operator_apply_of_upperFixed ρ i hv, operator_apply, map_add, map_add]
  simp only [act_mul, swap_sq, swap_mul_lower, upper_lower_upper, mul_one]
  simp only [map_one, Module.End.one_apply, map_mul, Module.End.mul_apply, hu]
  calc
    v + ρ (simpleLower i) v + (v + ρ (simpleSwap i) v) =
        (v + v) + (ρ (simpleSwap i) v + ρ (simpleLower i) v) := by abel
    _ = _ := by rw [binary_add_self, zero_add]

/-- Eigenvalue zero is exactly the inactive-root alternative. -/
theorem operator_eq_zero_iff (ρ : Representation (ZMod 2) Group V)
    (i : Fin 3) {v : V} (hv : UpperFixed ρ v) :
    operator ρ i v = 0 ↔ ρ (simpleSwap i) v = v := by
  have hu : ρ (simpleUpper i) v = v := hv i.castSucc i.succ (by simp)
  constructor
  · intro ht
    rw [operator_apply_of_upperFixed ρ i hv] at ht
    have hsum := congrArg (fun x => x + ρ (simpleLower i) v) ht
    have hsl : ρ (simpleSwap i) v = ρ (simpleLower i) v := by
      simpa only [add_assoc, binary_add_self, add_zero, zero_add] using hsum
    have he := congrArg (ρ (simpleSwap i)) hsl
    simp only [act_mul, swap_sq, swap_mul_lower, map_one, Module.End.one_apply,
      map_mul, Module.End.mul_apply, hu] at he
    exact hsl.trans he.symm
  · intro hs
    rw [operator_apply, hs, hu, binary_add_self]

/-- Eigenvalue one is exactly the active-root three-term relation. -/
theorem operator_eq_self_iff (ρ : Representation (ZMod 2) Group V)
    (i : Fin 3) {v : V} (hv : UpperFixed ρ v) :
    operator ρ i v = v ↔ v + ρ (simpleSwap i) v + ρ (simpleLower i) v = 0 := by
  rw [operator_apply_of_upperFixed ρ i hv, add_assoc]
  constructor
  · intro h; rw [h, binary_add_self]
  · intro h
    have he := congrArg (fun x => v + x) h
    simpa only [← add_assoc, binary_add_self, zero_add, add_zero] using he

/-- Operators at separated roots commute on the whole module. -/
theorem operator_commute (ρ : Representation (ZMod 2) Group V) (i j : Fin 3)
    (hij : i.val + 1 < j.val ∨ j.val + 1 < i.val) :
    Commute (operator ρ i) (operator ρ j) := by
  obtain ⟨huu, hus, hsu, hss⟩ := nonadjacent_commute i j hij
  unfold operator
  apply Commute.mul_left
  · apply Commute.add_left
    · exact Commute.one_left _
    · exact ((Commute.one_right _).add_right (huu.map ρ)).mul_right (hus.map ρ)
  · exact ((Commute.one_right _).add_right (hsu.map ρ)).mul_right (hss.map ρ)

end CFSG.Quasithin.ChapterG.Section09.DefiningCharacteristic.BinaryLinearRecognition.FourSmallModules.HeckeAction
