module

public import CFSG.Quasithin.ChapterG.Section09.NilpotentRigidity.Contracts
public import Theory.GroupTheory.QuaternionCentralProductResidualRecognition.Residual

/-!
# Residual conventions in G.9.2

The `{3,5}`-residual is generated by elements of order prime to fifteen.
It lies in the three-residual, is monotone in the parent subgroup, and is
normalized by the parent's normalizer. In particular all normality here
is relative to `X`; no ambient normality of `X` is used.

Source: Aschbacher--Smith G.9.2, printed pp.351--352, and the `O^π`
convention in GLS II, Chapter A, printed p.3.
-/

public section

namespace CFSG.Quasithin.ChapterG.Section09.NilpotentRigidity

open Subgroup

variable {G : Type*} [Group G]

theorem threeFiveResidual_le (X : Subgroup G) : threeFiveResidual X ≤ X :=
  (closure_le X).mpr (fun _ hx => hx.1)

theorem threeFiveResidual_mono {X Y : Subgroup G} (hXY : X ≤ Y) :
    threeFiveResidual X ≤ threeFiveResidual Y :=
  closure_mono (fun _ hx => ⟨hXY hx.1, hx.2⟩)

theorem threeFiveResidual_le_threeResidual (X : Subgroup G) :
    threeFiveResidual X ≤ threeResidual X := by
  apply (closure_le _).mpr
  rintro x ⟨hx, ho⟩
  refine ⟨⟨x, hx⟩, mem_pResidual_of_orderOf_coprime ?_, rfl⟩
  have h3 : Nat.Coprime 3 (orderOf x) :=
    (Nat.Coprime.of_dvd_right (by decide : 3 ∣ 15) ho).symm
  rw [← orderOf_injective X.subtype X.subtype_injective (⟨x, hx⟩ : X)]
  exact h3

theorem normalizer_le_normalizer_threeFiveResidual (X : Subgroup G) :
    normalizer (X : Set G) ≤ normalizer (threeFiveResidual X : Set G) := by
  intro g hg
  apply mem_normalizer_iff_map_conj_eq.mpr
  rw [threeFiveResidual, MonoidHom.map_closure]
  congr 1
  ext x
  constructor
  · rintro ⟨y, ⟨hy, ho⟩, rfl⟩
    refine ⟨(hg y).mp hy, ?_⟩
    exact (orderOf_injective (MulAut.conj g).toMonoidHom
      (MulAut.conj g).injective y).symm ▸ ho
  · rintro ⟨hx, ho⟩
    refine ⟨(MulAut.conj g).symm x, ⟨?_, ?_⟩, (MulAut.conj g).apply_symm_apply x⟩
    · change g⁻¹ * x * g ∈ X
      simpa only [inv_inv, SetLike.mem_coe] using
        (((normalizer (X : Set G)).inv_mem hg) x).mp hx
    · exact (orderOf_injective (MulAut.conj g).symm.toMonoidHom
        (MulAut.conj g).symm.injective x).symm ▸ ho

theorem threeFiveResidual_normal (X : Subgroup G) :
    ((threeFiveResidual X).subgroupOf X).Normal :=
  (normal_subgroupOf_iff_le_normalizer (threeFiveResidual_le X)).mpr
    (X.le_normalizer.trans (normalizer_le_normalizer_threeFiveResidual X))

theorem threeFiveResidual_centralizes_of_threeResidual {A X : Subgroup G}
    (h : ⁅threeResidual X, A⁆ = ⊥) : ⁅threeFiveResidual X, A⁆ = ⊥ :=
  eq_bot_iff.mpr ((commutator_mono (threeFiveResidual_le_threeResidual X) le_rfl).trans
    h.le)

end CFSG.Quasithin.ChapterG.Section09.NilpotentRigidity
