module

public import CFSG.Quasithin.ChapterG.Section09.Setup
public import Theory.GroupTheory.PResidual.Defs
public import Theory.SpecificGroups.ClassicalOrthogonal.SplitOdd.Elementary
public import Theory.SpecificGroups.ClassicalOrthogonal.SplitOdd.Forms
public import Mathlib.RepresentationTheory.Coinvariants
public import Mathlib.GroupTheory.SpecificGroups.Dihedral

/-!
# The nilpotent rigidity statement and its dihedral inputs

These are the contracts for Aschbacher--Smith G.9.2, printed pp.351--353
(combined manuscript, 1 March 2004). Residual superscripts are preserved:
`threeResidual` is the embedded three-residual, and `threeFiveResidual`
is generated by the elements of order prime to fifteen.

The output includes internal group and vector-space equivalences preserving
the factor inclusions. The orthogonal alternative uses the actual elementary
isometry subgroup of the split four-space and an intertwining linear
equivalence. It is not a group-family label.

`DihedralExtraction` describes the group-theoretic input from G.8.6/G.8.8
and the fifth observation in the proof of G.9.2. It contains no representation
or degree conclusion. The degree and equality-case representation arguments
remain separate obligations of the G.9.2 assembly.
-/

@[expose] public section

namespace CFSG.Quasithin.ChapterG.Section09.NilpotentRigidity

universe u v

variable {G : Type u} [Group G]
  {V : Type v} [AddCommGroup V] [Module (ZMod 2) V]

/-- `O³(X)`, included in the ambient group. -/
def threeResidual (X : Subgroup G) : Subgroup G :=
  (pResidual 3 X).map X.subtype

/-- `O^{3,5}(X)`, the `{3,5}`-residual, not a core or an iterated residual. -/
def threeFiveResidual (X : Subgroup G) : Subgroup G :=
  Subgroup.closure {x : G | x ∈ X ∧ Nat.Coprime (orderOf x) 15}

/-- The source hypotheses of G.9.2, including relative normalization and
the conditional sharper bound. -/
structure Hypothesis [Finite G] [FiniteDimensional (ZMod 2) V]
    (ρ : Representation (ZMod 2) G V) (A X : Subgroup G) (m : ℕ) : Prop
    extends Setup ρ A m where
  nilpotent : Group.IsNilpotent X
  odd_order : Odd (Nat.card X)
  normalizes : A ≤ Subgroup.normalizer (X : Set G)
  faithful_on_X : A ⊓ Subgroup.centralizer (X : Set G) = ⊥
  degree_le_of_centralizes : ⁅threeResidual X, A⁆ = ⊥ →
    Module.finrank (ZMod 2) V ≤ 2 * m

/-- The actual displacement span `[V,K]`. -/
def movedSpace (ρ : Representation (ZMod 2) G V) (K : Subgroup G) :
    Submodule (ZMod 2) V := Representation.Coinvariants.ker (ρ.comp K.subtype)

/-- Both decompositions are internal: their equivalences preserve each
canonical factor inclusion. A finite product of vector spaces is a direct sum. -/
structure InternalDecomposition (ρ : Representation (ZMod 2) G V)
    (H : Subgroup G) (r : ℕ) where
  factor : Fin r → Subgroup G
  groupEquiv : (∀ i, factor i) ≃* H
  group_inclusion : ∀ i g, (groupEquiv (Pi.mulSingle i g) : G) = g
  spaceEquiv : (∀ i, movedSpace ρ (factor i)) ≃ₗ[ZMod 2] V
  space_inclusion : ∀ i v, spaceEquiv (Pi.single i v) = v

/-- The genuine elementary orthogonal group on the split binary four-space. -/
abbrev OmegaFour := ClassicalOrthogonal.elementarySubgroup
  (ClassicalOrthogonal.formD 2 (ZMod 2))

/-- An actual natural orthogonal action, with group and module coordinates. -/
def IsNaturalOmegaFour (ρ : Representation (ZMod 2) G V)
    (K : Subgroup G) (U : Submodule (ZMod 2) V) : Prop :=
  ∃ e : K ≃* OmegaFour,
    ∃ f : U ≃ₗ[ZMod 2] ClassicalOrthogonal.VectorD 2 (ZMod 2),
      ∀ (g : K) (v : U),
        ρ g v = (f.symm ((e g).val.val (f v)) : V)

/-- The alternatives in G.9.2(4), including the prescribed dimensions. -/
def IsOrdinaryFactor (ρ : Representation (ZMod 2) G V) (K : Subgroup G) : Prop :=
  (Nonempty (K ≃* Equiv.Perm (Fin 3)) ∧
    Module.finrank (ZMod 2) (movedSpace ρ K) = 2) ∨
  (IsNaturalOmegaFour ρ K (movedSpace ρ K) ∧
    Module.finrank (ZMod 2) (movedSpace ρ K) = 4)

/-- The group/module classification for a specified subgroup. The exceptional
factor is first, and exists when the exceptional flag is true. -/
structure ClassifiedDecomposition (ρ : Representation (ZMod 2) G V)
    (H : Subgroup G) (exceptional : Prop) where
  count : ℕ
  internal : InternalDecomposition ρ H count
  exceptional_factor : exceptional → ∃ h : 0 < count,
    Nonempty (internal.factor ⟨0, h⟩ ≃* DihedralGroup 5) ∧
      Module.finrank (ZMod 2) (movedSpace ρ (internal.factor ⟨0, h⟩)) = 4
  ordinary_factor : ∀ i, (¬exceptional ∨ 0 < i.val) →
    IsOrdinaryFactor ρ (internal.factor i)

/-- All six clauses of G.9.2. This is an output contract, not a hypothesis. -/
structure Conclusion (ρ : Representation (ZMod 2) G V)
    (A X : Subgroup G) (m : ℕ) : Prop where
  residual_centralizes : ⁅threeFiveResidual X, A⁆ = ⊥
  decomposition : ∃ H : Subgroup G, A ≤ H ∧ H ≤ X ⊔ A ∧
    Nonempty (ClassifiedDecomposition ρ H (⁅threeResidual X, A⁆ ≠ ⊥))
  degree_central : ⁅threeResidual X, A⁆ = ⊥ → Module.finrank (ZMod 2) V = 2 * m
  degree_noncentral : ⁅threeResidual X, A⁆ ≠ ⊥ →
    Module.finrank (ZMod 2) V = 2 * (m + 1)

/-- An embedded direct product of odd-prime dihedral groups. Injectivity
provides a genuine product, not only a collection of commuting subgroups. -/
structure DihedralSystem (G : Type u) [Group G] (m : ℕ) where
  prime : Fin m → ℕ
  prime_isPrime : ∀ i, (prime i).Prime
  prime_odd : ∀ i, Odd (prime i)
  embedding : (∀ i, DihedralGroup (prime i)) →* G
  injective : Function.Injective embedding

/-- The precise group-theoretic extraction needed in the proof. The first
two selected-prime clauses are the nilpotent specialization of G.8.8. -/
structure DihedralExtraction (A X : Subgroup G) (m : ℕ) : Prop where
  exists_system : ∃ D : DihedralSystem G m,
    A ≤ D.embedding.range ∧ D.embedding.range ≤ X ⊔ A
  cubic_system : ⁅threeResidual X, A⁆ = ⊥ → ∃ D : DihedralSystem G m,
    A ≤ D.embedding.range ∧ D.embedding.range ≤ X ⊔ A ∧ ∀ i, D.prime i = 3
  large_prime_system : ⁅threeFiveResidual X, A⁆ ≠ ⊥ → ∃ D : DihedralSystem G m,
    A ≤ D.embedding.range ∧ D.embedding.range ≤ X ⊔ A ∧ ∃ i, 5 < D.prime i
  five_system : ⁅threeFiveResidual X, A⁆ = ⊥ → ⁅threeResidual X, A⁆ ≠ ⊥ →
    ∃ D : DihedralSystem G m,
      A ≤ D.embedding.range ∧ D.embedding.range ≤ X ⊔ A ∧ ∃ i, D.prime i = 5

/-- Lower-bound obligations for restrictions of the given representation to
embedded dihedral products. These are not assumed source theorems. In the
last clause the dihedral action, not just a cyclic-prime bound, is essential. -/
def HasDihedralLowerBounds (_ρ : Representation (ZMod 2) G V) : Prop :=
  ∀ (r : ℕ) (D : DihedralSystem G r),
    2 * r ≤ Module.finrank (ZMod 2) V ∧
    ((∃ i, D.prime i ≠ 3) → 2 * (r + 1) ≤ Module.finrank (ZMod 2) V) ∧
    ((∃ i, 5 < D.prime i) → 2 * (r + 1) < Module.finrank (ZMod 2) V)

/-- Equality-case classification obligations for actual embedded products.
The two cases have different degree bounds, as in the source. The G.9.2
assembly must prove this predicate, not add it to `Hypothesis`. -/
def HasDihedralEqualityCases (ρ : Representation (ZMod 2) G V) : Prop :=
  ∀ (r : ℕ) (D : DihedralSystem G r),
    ((∀ i, D.prime i = 3) → Module.finrank (ZMod 2) V ≤ 2 * r →
      Nonempty (ClassifiedDecomposition ρ D.embedding.range False)) ∧
    ((∃ i, D.prime i = 5) → Module.finrank (ZMod 2) V ≤ 2 * (r + 1) →
      Nonempty (ClassifiedDecomposition ρ D.embedding.range True))

/-- The uniform degree theorem needed on the smaller spaces in the
induction. This contract allows the degree and equality-case proofs to be
developed independently; the assembly must supply its proof. -/
def DihedralDegreeTheorem : Prop :=
  ∀ (W : Type v) [AddCommGroup W] [Module (ZMod 2) W]
    [FiniteDimensional (ZMod 2) W],
    ∀ (r : ℕ) (p : Fin r → ℕ), (∀ i, (p i).Prime) → (∀ i, Odd (p i)) →
      ∀ σ : Representation (ZMod 2) (∀ i, DihedralGroup (p i)) W,
        Function.Injective σ →
          2 * r ≤ Module.finrank (ZMod 2) W ∧
          ((∃ i, p i ≠ 3) → 2 * (r + 1) ≤ Module.finrank (ZMod 2) W) ∧
          ((∃ i, 5 < p i) → 2 * (r + 1) < Module.finrank (ZMod 2) W)

/-- The precise small model fact used when two cubic factors share a
four-space. Both rotations act without nonzero fixed vectors. This excludes
the direct sum of two natural planes. The conclusion identifies the actual
elementary orthogonal carrier and intertwines its natural action. -/
def OrthogonalPairTheorem : Prop :=
  ∀ (W : Type v) [AddCommGroup W] [Module (ZMod 2) W]
    [FiniteDimensional (ZMod 2) W],
    ∀ σ : Representation (ZMod 2) (DihedralGroup 3 × DihedralGroup 3) W,
      Function.Injective σ → Module.finrank (ZMod 2) W = 4 →
      (∀ v, σ (DihedralGroup.r 1, 1) v = v → v = 0) →
      (∀ v, σ (1, DihedralGroup.r 1) v = v → v = 0) →
      ∃ e : (DihedralGroup 3 × DihedralGroup 3) ≃* OmegaFour,
        ∃ f : W ≃ₗ[ZMod 2] ClassicalOrthogonal.VectorD 2 (ZMod 2),
          ∀ g v, f (σ g v) = (e g).val.val (f v)

/-- The genuine half-space splitting supplied by A.1.44, as used in G.9.2.
The moved space is the actual rotation displacement span and the half-space
is its intersection with the reflection's fixed space. No dimension bound,
faithfulness of other factors, or equality-case classification is included. -/
def DihedralSplittingTheorem : Prop :=
  ∀ (W : Type v) [AddCommGroup W] [Module (ZMod 2) W]
    [FiniteDimensional (ZMod 2) W],
    ∀ p : ℕ, p.Prime → Odd p →
      ∀ σ : Representation (ZMod 2) (DihedralGroup p) W,
        Function.Injective σ →
          let M := movedSpace σ (Subgroup.zpowers (DihedralGroup.r 1))
          let C := LinearMap.ker (σ (DihedralGroup.r 1) - 1)
          let U := M ⊓ LinearMap.ker (σ (DihedralGroup.sr 0) - 1)
          IsCompl C M ∧ Disjoint U (U.map (σ (DihedralGroup.r 1))) ∧
            U ⊔ U.map (σ (DihedralGroup.r 1)) = M

end CFSG.Quasithin.ChapterG.Section09.NilpotentRigidity
