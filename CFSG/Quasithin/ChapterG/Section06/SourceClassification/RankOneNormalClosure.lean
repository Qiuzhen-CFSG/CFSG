module
public import CFSG.Quasithin.ChapterG.Section06.SourceClassification.HighRank
public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.Complete

/-!
# The outer A6--C3 exclusion without displacement generation

The rank-one offender argument for G.6.4 uses only the literal normal
closure, its faithful FF action and the distinguished involution's rank.
It does not need the original module to be generated by displacements.
If the involution centralizes the normal three-core, its ambient normal
closure does too. Otherwise the proved B.5.7 offender-plane calculation
would give its order-two subgroup rank three.

This applies the existing cover and module calculations with their genuine
known-simple inputs. It allows fixed vectors in the VH-action used by
original 14.3.25 and supplies no assumption of its S3 identification.

Source: Aschbacher--Smith B.5.7, G.6.4, and 14.3.25,
printed pp.105--106,345--346 and 1001.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterG.Section06
open ChapterB.SourceInduction
open HighThreeRank HighThreeRank.ModuleCalculation
open HighThreeRank.CoverCentralizer.SourceConstruction
universe u v

/-- The outer A6--C3 row is excluded for a rank-one normal closure on its
original module, including fixed vectors. Full displacement generation of
that module is not required. -/
theorem no_outerShape_of_rank_one_normalClosure
    {J : Type u} [Group J] [Finite J] {X : Type v} [AddCommGroup X] [Module (ZMod 2) X]
    (K : Subgroup J) [K.Normal] (a : J) (ha : a ∈ K)
    (hK : K = normalClosure ({a} : Set J))
    (ρ : Representation (ZMod 2) K X) (hf : FFHypothesis KnownSimple.IsKnownSimple ρ)
    (ha2 : a ^ 2 = 1) (hne : a ≠ 1)
    (hr : Module.finrank (ZMod 2) (ρ ⟨a,ha⟩ - LinearMap.id).range = 1)
    (c : ChapterB.OuterSixThreeShape K) : False := by
  let := hf.finite_module
  let t : K := ⟨a,ha⟩
  have htp : t ^ 2 = 1 := Subtype.ext ha2
  have htne : t ≠ 1 := fun hh => hne (congrArg Subtype.val hh)
  have hA := fun (D : Type u) [Group D] [Finite D] =>
    ChapterA.Section02.theoremA_knownSimple (G := D)
  have h36 := ChapterA.SQTKStructure.a36Input_of_theoremsAC hA
    (fun _ _ _ => ChapterA.Section02.theoremC_knownSimple)
  have h4 := ChapterB.SourceClassification.irreducibleClassification_knownSimple
  have h1 := ChapterB.QuasisimpleSource.SourceCompletion.knownSimple_quasisimpleClassificationInput
    hA h36 h4 nonbinaryG2RootPairInput
  have h5 := ChapterB.PreparationSource.componentInput ChapterB.PreparationSource.componentNormalization
    hA h36 h4
  obtain ⟨lc⟩ := PreciseMultiplierInputs.liftedCover_of_preparation ρ
    (coverInput_of_a36 h36) h5 hA h36 hf c.first_isComponent c.first_three_rank
  rcases CoverCentralizer.reduction_of_liftedCover hf c.first_isComponent c.first_three_rank lc with hq | hnc
  · obtain ⟨hsq,hfit⟩ := hq
    exact c.not_quasisimple_fitting
      (HighThreeRank.quasisimple_branch ρ h1 hf c.first_isComponent hsq hfit).1
  · obtain ⟨nc⟩ := hnc
    have hbest : IsBestOffender ρ (zpowers t) :=
      bestOffender_of_involution_displacement_le_one ρ t htp htne hr.le
    have hm : ¬ zpowers t ≤ centralizer (pCore 3 K : Set K) := by
      intro hc
      have htC := hc (mem_zpowers t)
      let N := (pCore 3 K).map K.subtype
      have htN : a ∈ centralizer (N : Set J) := by
        apply mem_centralizer_iff.mpr
        rintro x ⟨y,hy,rfl⟩
        exact congrArg Subtype.val (mem_centralizer_iff.mp htC y hy)
      have hKN : K ≤ centralizer (N : Set J) :=
        hK.le.trans (normalClosure_le_normal (by
          simpa only [Set.singleton_subset_iff,SetLike.mem_coe] using htN))
      apply nc.noncentral
      intro x hx
      apply mem_center_iff.mpr
      intro y
      exact Subtype.ext (mem_centralizer_iff.mp (hKN y.property) x
        (mem_map_of_mem K.subtype hx)).symm
    obtain ⟨r⟩ := NaturalReduction.ModelComparison.reduced_of_threeFreePerfectKernels h1
      NaturalReduction.ModelComparison.alternatingEight_threeFreePerfectKernels
      NaturalReduction.ModelComparison.binaryG2_threeFreePerfectKernels ρ hf
      c.first_isComponent c.first_three_rank nc hbest hm
    obtain ⟨m⟩ := NaturalReduction.model_of_reduced ρ hf c.first_isComponent nc hm r
    have hfix := NaturalCentralizers.threeCore_fixes_model ρ
      NaturalCentralizers.ConcreteModels.modelCommutants c.first_isComponent nc m
    have hp := NaturalCentralizers.source_offender_plane ρ hf c.first_isComponent nc hbest hm hfix m
    have hc : Nat.card (zpowers t) = 2 := by
      rw [Nat.card_zpowers]
      exact orderOf_eq_prime htp htne
    have htr : rank (zpowers t) = 1 := by
      rw [rank,hc]
      decide
    have he := hp.rank_eq
    omega

end CFSG.Quasithin.ChapterG.Section06
