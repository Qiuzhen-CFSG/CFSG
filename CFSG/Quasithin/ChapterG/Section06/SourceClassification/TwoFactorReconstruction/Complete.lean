module

public import CFSG.Quasithin.ChapterG.Section06.SourceClassification.TwoFactorReconstruction.AmbientNormalizer
public import Theory.GroupTheory.NormalClosureProductSplit
public import Theory.GroupTheory.NormalClosurePairCentralSylow

/-!
# The complete two-factor branch of G.6.4

The reconstructed small factors have exactly their own product as ambient
stabilizer. Correcting an actual exchanger produces the required involution
and the full ambient extension. A nonidentity marked element of the first
factor cannot be central in an ambient Sylow two-subgroup. Thus this branch
satisfies every clause of the original G.6.4 conclusion.

The source application starts with the literal B.5.6 two-factor quotient row;
no fixed-kernel, normalizer, extension, or two-central exclusion is assumed.
Source: Aschbacher–Smith, G.6.4(1)–(4), printed pp.345–346.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterG.Section06
open ChapterB.SourceInduction TwoFactorReconstruction
universe u v
variable {G : Type u} [Group G] {V : Type v} [AddCommGroup V] [Module (ZMod 2) V]
  {ρ : Representation (ZMod 2) G V} {a : G}

/-- The ambient extension of the same reconstructed pair is generated by an involution. -/
theorem TwoFactorModules.has_involutory_extension (d : TwoFactorModules ρ a)
    (hf : Function.Injective ρ) : Nonempty (TwoFactors ρ a) := by
  refine ⟨{ toTwoFactorModules := d, extension := ?_ }⟩
  exact exists_involutive_exchange_of_normalClosure_product d.first d.second a
    d.marked d.join_eq (disjoint_iff.mpr d.disjoint) d.commute d.second_nontrivial
    d.permutation (mem_closure_of_preserves_factors d hf)

/-- All G.6.4 clauses follow from the original reconstructed pair and faithfulness. -/
theorem TwoFactorModules.conclusion [Finite G] (d : TwoFactorModules ρ a)
    (hf : Function.Injective ρ) (hne : a ≠ 1) : Conclusion ρ a := by
  refine ⟨Or.inr (d.has_involutory_extension hf), ?_⟩
  intro T hz
  exact (not_twoCentral_of_normalClosure_pair d.first d.second a d.marked hne
    d.join_eq (disjoint_iff.mpr d.disjoint) d.second_nontrivial d.permutation T hz).elim

variable {κ : GroupClass.{u}} {Cover : Type u} [Group Cover] {q : Cover →* G}

/-- The full original G.6.4 conclusion in the literal B.5.6 two-factor source branch. -/
theorem Hypotheses.conclusion_of_twoFactor_source
    (h : Hypotheses κ ρ a q)
    (hr : Module.finrank (ZMod 2) (LinearMap.range (ρ a - LinearMap.id)) = 1)
    (d : SourceTwoFactorCase (ρ.comp (normalClosure ({a} : Set G)).subtype)) :
    Conclusion ρ a := by
  let := h.finite_group
  obtain ⟨c⟩ := h.twoFactorModules_of_source hr d
  exact c.conclusion h.faithful h.nonidentity

end CFSG.Quasithin.ChapterG.Section06
