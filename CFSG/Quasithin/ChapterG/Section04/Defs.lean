module

public import Theory.GroupAction.IrreducibleTwoCoreKernel
public import Theory.PGroupCore
public import Mathlib.LinearAlgebra.FiniteDimensional.Basic

/-!
# The source interface for G.4

The source works in a four-dimensional symplectic space over `F = F_(2^n)`.
The group-theoretic part of the first reduction only uses the additive binary
action.  We therefore keep the ambient symplectic realization as explicit
metadata and record the acting groups as subgroups of the actual additive
automorphism group.  This makes the two-core statement reusable by consumers
which already have a concrete symplectic realization, without silently
identifying an abstract quotient with a matrix group.

Source: Aschbacher--Smith, combined manuscript of 1 March 2004, §G.4,
printed pp.338--341 (PDF pp.349--352).
-/

@[expose] public section

namespace CFSG.Quasithin.ChapterG.Section04

open Subgroup

variable {F V : Type*} [Field F] [AddCommGroup V] [Module F V]
  [Finite V] [Nontrivial V]

/-- A binary-action irreducibility condition for an automorphism subgroup.

This is the exact subgroup hypothesis used by the modular two-core lemma. It
is stronger than the source's `F`-linear irreducibility when `F` is a proper
extension of `𝔽₂`; a concrete symplectic consumer must provide that bridge.
It is deliberately stated on the literal additive action image.
-/
def IsBinaryIrreducible (A : Subgroup (MulAut (Multiplicative V))) : Prop :=
  ∀ W : Subgroup (Multiplicative V),
    (∀ a : A, ∀ v : Multiplicative V, v ∈ W → a • v ∈ W) → W = ⊥ ∨ W = ⊤

/-- The action-level input data of §G.4 before the recognition argument.

`G₀` is the actual action image.  `D` is the marked set of `F`-transvections;
its detailed symplectic definition is retained by the concrete consumer and
is not replaced here by an order-only surrogate.  `generated` is the literal
subgroup generated by that set.
-/
structure Setup where
  /-- The extension degree in `F = F_(2^n)`. -/
  n : ℕ
  field_card : Nat.card F = 2 ^ n
  /-- The four-dimensionality of the source space. -/
  dimension : Module.finrank F V = 4
  /-- The subgroup acting on the literal binary additive space. -/
  G₀ : Subgroup (MulAut (Multiplicative V))
  /-- The marked set of transvections in `G₀`. -/
  D : Set (MulAut (Multiplicative V))
  D_le : D ⊆ G₀
  D_nonempty : D.Nonempty
  /-- Conjugation by `G₀` preserves the marked transvections. -/
  D_conj : ∀ g : G₀, ∀ d ∈ D, (g : MulAut (Multiplicative V)) * d * (g : MulAut (Multiplicative V))⁻¹ ∈ D
  /-- Marked transvections are nonidentity automorphisms. -/
  D_ne_one : ∀ d ∈ D, d ≠ 1
  /-- The additive binary group structure used by the two-core argument. -/
  binary_elementary : IsElementaryAbelian 2 (Multiplicative V)
  irreducible : IsBinaryIrreducible G₀

namespace Setup

variable (S : Setup (F := F) (V := V))

/-- The subgroup generated by the marked transvections. -/
def generated : Subgroup (MulAut (Multiplicative V)) := Subgroup.closure S.D

omit [Finite V] [Nontrivial V] in
theorem generated_le : S.generated ≤ S.G₀ := by
  exact (Subgroup.closure_le S.G₀).mpr S.D_le

omit [Finite V] [Nontrivial V] in
theorem generated_normal : (S.generated.subgroupOf S.G₀).Normal := by
  apply Subgroup.normal_subgroupOf_of_le_normalizer
  change S.G₀ ≤ Subgroup.normalizer ↑(Subgroup.closure S.D)
  rw [Subgroup.le_normalizer_closure_iff]
  intro g hg d hd
  exact Subgroup.subset_closure (S.D_conj ⟨g, hg⟩ d hd)

omit [Finite V] [Nontrivial V] in
theorem generated_ne_bot : S.generated ≠ ⊥ := by
  intro h
  obtain ⟨d, hd⟩ := S.D_nonempty
  have hmem : d ∈ S.generated := Subgroup.subset_closure hd
  rw [h, Subgroup.mem_bot] at hmem
  exact S.D_ne_one d hd (by simpa using hmem)

end Setup

end CFSG.Quasithin.ChapterG.Section04

