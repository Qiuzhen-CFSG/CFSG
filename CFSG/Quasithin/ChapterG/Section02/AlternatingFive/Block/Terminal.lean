module

public import CFSG.Quasithin.ChapterG.Section02.AlternatingFive.Block.CoreCollapse
public import CFSG.Quasithin.ChapterG.Section02.AlternatingFive.Block.Intrinsic
public import CFSG.Quasithin.ChapterG.Section02.AlternatingFive.Block.Quaternion

/-!
# The terminal implication of G.2.4

From the earlier clauses (1–7) and exactly the two extra premises of (8),
the chief-factor and natural-action arguments collapse S to V_L. The
intrinsic short-group and equivariant-module construction identifies L
as an A₅-block. The original U is its local two-core, generated by two
commuting quaternion subgroups meeting in the original point V₁.

The diagonal-quotient presentation retains the embeddings of both factors.
No terminal core equality, block recognition or quaternion witness is an
input. The earlier-clause records remain inputs to this independent branch;
the enclosing G.2.4 assembly constructs them.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
G.2.4(8), printed pp.334–335; the central-product convention is E.2.16.
-/

@[expose] public section
open Subgroup
namespace CFSG.Quasithin.ChapterG.Section02.AlternatingFive.Hypothesis
open Setup Block
variable {G : Type*} [Group G] [Finite G] {D : Setup G} {g : G}
  {F : Type*} [Field F] {s : ℕ}
  [((S₂ D g).subgroupOf (D.S g)).Normal]

/-- All conclusions of G.2.4(8), conditional only on clauses (1–7) and
the two source terminal premises. The central product has actual factors
and is identified with the quotient by the diagonal central involution. -/
theorem terminal_block (d : Hypothesis D g)
    (c : EarlierStructure D g) (e : EarlierUpper D g c F s)
    (hfull : ⁅D.tilde D.U, D.tilde D.L₁⁆ = D.tilde D.U)
    (hcore : D.L₁.pCoreIn 2 ≤ D.QH) :
    D.I g = D.L ∧ D.S g = D.VL ∧ ChapterC.IsAlternatingBlock D.L 5 ∧
      D.U = D.L₁.pCoreIn 2 ∧ Nonempty (QuaternionCentralProductData D.U) ∧
      Nonempty (D.U ≃* QuaternionCentralProduct.Model) := by
  have hS := d.terminal_core_eq_first c e hfull hcore
  exact ⟨d.terminal_group_eq hfull c.generated, hS,
    d.intrinsic_alternatingBlock c hfull hS,
    d.terminal_local_core_and_quaternion c hfull hcore hS⟩

/-- The terminal factors meet in the original point, and multiplication of
their quaternion coordinates induces the literal diagonal-quotient map. -/
theorem terminal_quaternion_presentation (d : Hypothesis D g)
    (c : EarlierStructure D g) (e : EarlierUpper D g c F s)
    (hfull : ⁅D.tilde D.U, D.tilde D.L₁⁆ = D.tilde D.U)
    (hcore : D.L₁.pCoreIn 2 ≤ D.QH) :
    ∃ q : QuaternionCentralProductData D.U,
      (q.left ⊓ q.right).map D.U.subtype = D.V₁ ∧
      ∃ (eL : q.left ≃* QuaternionGroup 2) (eR : q.right ≃* QuaternionGroup 2)
        (f : QuaternionCentralProduct.Model ≃* D.U),
        ∀ x y : QuaternionGroup 2,
          f (QuotientGroup.mk' QuaternionCentralProduct.diagonalCenter (x, y)) =
            eL.symm x * eR.symm y := by
  have hS := d.terminal_core_eq_first c e hfull hcore
  obtain ⟨q⟩ := Quaternion.closure_quaternion_factors d c hfull hS
  refine ⟨q, ?_, ?_⟩
  · rw [← q.center_eq]
    exact Quaternion.closure_center_map d c hfull hS
  · obtain ⟨eL⟩ := q.left_model
    obtain ⟨eR⟩ := q.right_model
    exact ⟨eL, eR, q.exists_quotientEquiv eL eR⟩

end CFSG.Quasithin.ChapterG.Section02.AlternatingFive.Hypothesis
