module

public import CFSG.Quasithin.ChapterG.Section02.AlternatingFive.QuotientImages
public import CFSG.Quasithin.ChapterG.Section02.AlternatingFive.NaturalLayer
public import Theory.GroupTheory.NormalizedSupCard

/-!
# The denominator and order calculation in G.2.4

The literal kernel on W is W∩S₂. Since S₂=V_L(W∩S₂) and
V_L∩(W∩S₂)=V, the product-order formula gives
|W∩S₂|=|V|[S₂:V_L]. Thus the marked image of order 2^(2s), together
with |V|=8 and [U:W]=4, gives exactly clause (7). The core-order
formula uses the actual natural-layer coordinates and |V_L|=16.

The natural-layer witness and its marked image size must still be
constructed by recognition. These counting results do not assume S₂≤W.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
G.2.4(6–7), printed pp.334–335; the core count feeds 13.5.22.
-/

@[expose] public section
open Subgroup
open scoped Pointwise IsMulCommutative
namespace CFSG.Quasithin.ChapterG.Section02.AlternatingFive
open Setup
namespace Hypothesis
variable {G : Type*} [Group G] [Finite G] {D : Setup G} {g : G}
  (d : Hypothesis D g)
include d

omit d [Finite G] in
private theorem card_eq_mul_relIndex {A B : Subgroup G} (hAB : A ≤ B) :
    Nat.card B = Nat.card A * A.relIndex B := by
  simpa only [relIndex_bot_left] using
    (relIndex_mul_relIndex (⊥ : Subgroup G) A B bot_le hAB).symm

/-- The denominator is generated by V_L and the actual kernel on W. -/
theorem second_eq_sup_upper_kernel (hLI : D.L ≤ D.I g) :
    S₂ D g = D.VL ⊔ (D.W g ⊓ S₂ D g) := by
  apply le_antisymm _ (sup_le le_sup_left inf_le_right)
  apply sup_le le_sup_left
  intro x hx
  exact mem_sup_right ⟨⟨hx.1, d.second_le_core hLI (mem_sup_right hx)⟩, mem_sup_right hx⟩

/-- V_L meets the W-kernel in the original hyperplane V. -/
theorem first_inf_upper_kernel (hLI : D.L ≤ D.I g) (hVU : D.VL ⊓ D.U = D.V) :
    D.VL ⊓ (D.W g ⊓ S₂ D g) = D.V := by
  rw [← hVU]
  apply le_antisymm
  · exact fun _ hx => ⟨hx.1, hx.2.1.1⟩
  · intro x hx
    exact ⟨hx.1, ⟨hx.2, (d.central_first hLI hx.1).1⟩, mem_sup_left hx.1⟩

/-- Counting uses W∩S₂, and never assumes S₂≤W. -/
theorem card_upper_kernel (hLI : D.L ≤ D.I g)
    (hVU : D.VL ⊓ D.U = D.V) :
    Nat.card (D.W g ⊓ S₂ D g : Subgroup G) =
      Nat.card D.V * D.VL.relIndex (S₂ D g) := by
  have hn : D.W g ⊓ S₂ D g ≤ normalizer (D.VL : Set G) :=
    (inf_le_left.trans (inf_le_right.trans (pCoreIn_le 2 _))).trans d.I_normalizes_VL
  have hp := card_mul_eq_card_inf_mul_card_sup_of_normalizes D.VL
    (D.W g ⊓ S₂ D g) hn
  rw [d.first_inf_upper_kernel hLI hVU, ← d.second_eq_sup_upper_kernel hLI,
    card_eq_mul_relIndex (show D.VL ≤ S₂ D g from le_sup_left)] at hp
  apply Nat.eq_of_mul_eq_mul_left (Nat.card_pos (α := D.VL))
  calc
    _ = Nat.card D.V * (Nat.card D.VL * D.VL.relIndex (S₂ D g)) := hp
    _ = _ := by ac_rfl

/-- Clause (7) from the cardinality of the literal upper image. Recognition
must supply that image cardinality for the same multiplicity s. -/
theorem order_of_upper_image (hLI : D.L ≤ D.I g)
    (hVU : D.VL ⊓ D.U = D.V) (hV : Nat.card D.V = 8)
    (hUW : (D.W g).relIndex D.U = 4)
    [((S₂ D g).subgroupOf (D.S g)).Normal]
    (s : ℕ) (himage : Nat.card (upperImage D g (D.W g)) = 2 ^ (2 * s)) :
    Nat.card D.U = 2 ^ (2 * s + 5) * D.VL.relIndex (S₂ D g) := by
  have hW : Nat.card (D.W g) =
      (8 * D.VL.relIndex (S₂ D g)) * 2 ^ (2 * s) := by
    rw [card_eq_mul_relIndex (show D.W g ⊓ S₂ D g ≤ D.W g from inf_le_left),
      inf_relIndex_left, ← card_upperImage_W, himage, d.card_upper_kernel hLI hVU, hV]
  rw [card_eq_mul_relIndex (show D.W g ≤ D.U from inf_le_left), hUW, hW, pow_add]
  ring

/-- The orthogonal first layer has order sixteen, independently of the
multiplicity of the natural upper layer. -/
theorem card_first_layer : Nat.card D.VL = 16 := by
  rw [Nat.card_congr d.coordinates.toEquiv]
  change Nat.card (BinaryPermutation.core (Fin 5)) = _
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2), BinaryPermutation.finrank_core]
  norm_num

/-- The source's core-order formula, for the same natural-layer witness. -/
theorem core_order_of_naturalLayer (hLI : D.L ≤ D.I g)
    [((S₂ D g).subgroupOf (D.S g)).Normal]
    {F : Type*} [Field F] {s : ℕ} (c : NaturalLayer D g F s hLI) :
    Nat.card (D.S g) = 2 ^ (4 * s + 4) * D.VL.relIndex (S₂ D g) := by
  have hf : Finite F := Nat.finite_of_card_ne_zero (c.field_card ▸ (by decide : 4 ≠ 0))
  have hQ : Nat.card (UpperQuotient D g) = 2 ^ (4 * s) := by
    rw [Nat.card_congr c.coordinates.toEquiv]
    change Nat.card (Fin s → Fin 2 → F) = _
    rw [Nat.card_fun, Nat.card_fun, Nat.card_fin, Nat.card_fin, c.field_card]
    rw [show (4 : ℕ) ^ 2 = 2 ^ 4 from rfl, ← pow_mul]
  have hc := card_eq_card_quotient_mul_card_subgroup ((S₂ D g).subgroupOf (D.S g))
  have he : Nat.card ((S₂ D g).subgroupOf (D.S g)) = Nat.card (S₂ D g) :=
    Nat.card_congr (subgroupOfEquivOfLe (d.second_le_core hLI)).toEquiv
  rw [he, hQ, card_eq_mul_relIndex (show D.VL ≤ S₂ D g from le_sup_left),
    d.card_first_layer] at hc
  rw [hc, pow_add]
  ring

end Hypothesis
end CFSG.Quasithin.ChapterG.Section02.AlternatingFive
