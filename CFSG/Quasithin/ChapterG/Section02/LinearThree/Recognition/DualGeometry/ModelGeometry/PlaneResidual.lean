module

public import Theory.Representation.SpecialLinearThreeFrameGeometry.PlaneResidual
public import CFSG.Quasithin.ChapterG.Section02.LinearThree.Recognition.DualGeometry.ModelGeometry.Basic

/-!
# The G.2.5 plane factorization and relative prime-to-two residual

The actual model equivalence transports the frame calculation to the starred
source group. Its subgroup generated by the two marked point radicals equals
the embedded relative O^{2′} of the natural pair-plane stabilizer. The latter
is the literal set product of this subgroup and the intersection of the two
point stabilizers. The membership lemma specifies stabilization by the exact
natural action, and the conjugated point follows the source inverse convention.

This discharges the plane model input in the dual-point extension argument.
The separate identification of ambient U* with the point radical belongs to
the G.2.5 assembly owner. No such identification is assumed here.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, G.2.5 proof,
printed pp.335–336 / PDF pp.346–347.
-/

@[expose] public section

noncomputable section
namespace CFSG.Quasithin.ChapterG.Section02.LinearThree.Recognition
open Subgroup Setup Projective Matrix
namespace DualGeometry.ModelGeometry
open CFSG.Quasithin.ChapterG.Section02.LinearThree.Recognition.Hypothesis
open Matrix.SpecialLinearGroup
open scoped MatrixGroups Pointwise
variable {G : Type*} [Group G] [Finite G] {D : Setup G} {F : Type*} [Field F] [Finite F]
  {n : ℕ} {g h : G} (d : LinearThree.Hypothesis D F n g h)

/-- Setwise subspace stabilization in the source's exact natural action. -/
def naturalStabilizer (A : Submodule F (Fin 3 → F)) : Subgroup (D.star D.L) :=
  (FrameGeometry.stabilizer A).comap d.model.toMonoidHom

theorem mem_naturalStabilizer_iff (A : Submodule F (Fin 3 → F)) (a : D.star D.L) :
    a ∈ naturalStabilizer d A ↔ A.map (naturalAction d a) = A :=
  FrameGeometry.mem_stabilizer_iff A (d.model a)

theorem map_naturalStabilizer (A : Submodule F (Fin 3 → F)) :
    (naturalStabilizer d A).map d.model.toMonoidHom = FrameGeometry.stabilizer A :=
  Subgroup.map_comap_eq_self_of_surjective d.model.surjective _

/-- The literal product in the starred source group used to extend the
marked dual-point assignment in G.2.5. -/
theorem pair_plane_factorization :
    (naturalStabilizer d (pairPlane d) : Set (D.star D.L)) =
      (↑(rootGroup (naturalAction d) d.point d.point ⊔
        rootGroup (naturalAction d) (conjugatePoint d ⟨g, d.g_mem⟩).val
          (conjugatePoint d ⟨g, d.g_mem⟩).val) : Set (D.star D.L)) *
      (↑(naturalStabilizer d d.point ⊓
        naturalStabilizer d (conjugatePoint d ⟨g, d.g_mem⟩).val) : Set (D.star D.L)) := by
  apply FrameGeometry.factorization_of_map d.model
  rw [map_naturalStabilizer, Subgroup.map_sup, map_rootGroup, map_rootGroup,
    Subgroup.map_inf _ _ _ d.model.injective, map_naturalStabilizer, map_naturalStabilizer]
  exact (frame d).plane_factorization

/-- The prime-to-two residual is relative to the actual plane stabilizer;
its subtype map embeds it in the starred group. No ambient U* identification
is an input to this model calculation. -/
theorem pair_plane_oddResidual :
    rootGroup (naturalAction d) d.point d.point ⊔
      rootGroup (naturalAction d) (conjugatePoint d ⟨g, d.g_mem⟩).val
        (conjugatePoint d ⟨g, d.g_mem⟩).val =
      (piResidual {p : Nat.Primes | p.val ≠ 2} (naturalStabilizer d (pairPlane d))).map
        (naturalStabilizer d (pairPlane d)).subtype := by
  let := field_char_two d
  apply Subgroup.map_injective (f := d.model.toMonoidHom) d.model.injective
  rw [Subgroup.map_sup, map_rootGroup, map_rootGroup, Subgroup.map_embedded_piResidual,
    map_naturalStabilizer]
  exact (frame d).plane_oddResidual

/-- The source product written with its literal relative residual factor. -/
theorem pair_plane_residual_factorization :
    (naturalStabilizer d (pairPlane d) : Set (D.star D.L)) =
      ((piResidual {p : Nat.Primes | p.val ≠ 2} (naturalStabilizer d (pairPlane d))).map
        (naturalStabilizer d (pairPlane d)).subtype : Set (D.star D.L)) *
      (↑(naturalStabilizer d d.point ⊓
        naturalStabilizer d (conjugatePoint d ⟨g, d.g_mem⟩).val) : Set (D.star D.L)) := by
  rw [← pair_plane_oddResidual]
  exact pair_plane_factorization d

end DualGeometry.ModelGeometry
end CFSG.Quasithin.ChapterG.Section02.LinearThree.Recognition
