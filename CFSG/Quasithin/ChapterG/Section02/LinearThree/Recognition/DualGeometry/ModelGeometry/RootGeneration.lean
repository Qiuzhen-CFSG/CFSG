module
public import Theory.Representation.SpecialLinearThreeFrameGeometry.RootGeneration
public import CFSG.Quasithin.ChapterG.Section02.LinearThree.Recognition.DualGeometry.ModelGeometry.Basic

/-!
# Frame-root generation in the source coordinates of G.2.5

The exact model isomorphism transports the two-root decomposition of each
point radical and generation by all six frame roots to the literal natural
root groups on L*. In particular the radicals centered at V₁, V₁ᵍ and V₁ʰ
generate L*. These statements supply the root-generation input on printed
p.336. Identifying the source U* with its point radical remains the separate
G.2.5(1) argument.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, G.1.1–2 and
G.2.5, printed pp.327,335–336, PDF pp.338,346–347.
-/

@[expose] public section
noncomputable section
namespace CFSG.Quasithin.ChapterG.Section02.LinearThree.Recognition
open Subgroup Setup Projective Matrix
namespace DualGeometry.ModelGeometry
open CFSG.Quasithin.ChapterG.Section02.LinearThree.Recognition.Hypothesis
open Matrix.SpecialLinearGroup
open scoped MatrixGroups
variable {G : Type*} [Group G] [Finite G] {D : Setup G} {F : Type*} [Field F] [Finite F]
  {n : ℕ} {g h : G} (d : LinearThree.Hypothesis D F n g h)

/-- Each literal source point radical is generated by its two frame roots. -/
theorem frame_pointRadical_eq_sup_roots (i j k : Fin 3)
    (hij : i ≠ j) (hik : i ≠ k) (hjk : j ≠ k) :
    rootGroup (naturalAction d) ((frame d).point i) ((frame d).point i) =
      rootGroup (naturalAction d) ((frame d).point i)
        ((frame d).point i ⊔ (frame d).point j) ⊔
      rootGroup (naturalAction d) ((frame d).point i)
        ((frame d).point i ⊔ (frame d).point k) := by
  apply Subgroup.map_injective (f := d.model.toMonoidHom) d.model.injective
  rw [Subgroup.map_sup, map_rootGroup, map_rootGroup, map_rootGroup]
  exact (frame d).pointRadical_eq_sup_axisRoot i j k hij hik hjk

/-- The two roots through the marked point generate its literal radical. -/
theorem marked_pointRadical_eq_sup_roots :
    rootGroup (naturalAction d) d.point d.point =
      rootGroup (naturalAction d) d.point
        (d.point ⊔ (conjugatePoint d ⟨g, d.g_mem⟩).val) ⊔
      rootGroup (naturalAction d) d.point
        (d.point ⊔ (conjugatePoint d ⟨h, d.h_mem⟩).val) :=
  frame_pointRadical_eq_sup_roots d 0 1 2 (by decide) (by decide) (by decide)

/-- Generation by all six roots in the actual source action on L*. -/
theorem frame_roots_generate :
    (⨆ i, ⨆ j, ⨆ (_ : i ≠ j),
      rootGroup (naturalAction d) ((frame d).point i)
        ((frame d).point i ⊔ (frame d).point j)) = ⊤ := by
  apply Subgroup.map_injective (f := d.model.toMonoidHom) d.model.injective
  rw [Subgroup.map_top_of_surjective _ d.model.surjective]
  simp_rw [Subgroup.map_iSup, map_rootGroup]
  exact (frame d).iSup_axisRoot_eq_top

/-- The three marked radicals generate L*, with the original point marks. -/
theorem marked_pointRadicals_generate :
    (rootGroup (naturalAction d) d.point d.point ⊔
      rootGroup (naturalAction d) (conjugatePoint d ⟨g, d.g_mem⟩).val
        (conjugatePoint d ⟨g, d.g_mem⟩).val) ⊔
      rootGroup (naturalAction d) (conjugatePoint d ⟨h, d.h_mem⟩).val
        (conjugatePoint d ⟨h, d.h_mem⟩).val = ⊤ := by
  apply Subgroup.map_injective (f := d.model.toMonoidHom) d.model.injective
  rw [Subgroup.map_top_of_surjective _ d.model.surjective]
  simp only [Subgroup.map_sup, map_rootGroup]
  simpa [frame, FrameGeometry.pointRadical] using (frame d).iSup_pointRadical_eq_top

/-- The exact model pullback of the two generating roots at the marked point. -/
theorem marked_pointRadical_eq_comap_sup_roots :
    rootGroup (naturalAction d) d.point d.point =
      ((frame d).axisRoot 0 1 ⊔ (frame d).axisRoot 0 2).comap d.model.toMonoidHom := by
  rw [rootGroup_eq_comap]
  rw [← (frame d).pointRadical_eq_sup_axisRoot 0 1 2
    (by decide) (by decide) (by decide)]
  rfl

end DualGeometry.ModelGeometry
end CFSG.Quasithin.ChapterG.Section02.LinearThree.Recognition
