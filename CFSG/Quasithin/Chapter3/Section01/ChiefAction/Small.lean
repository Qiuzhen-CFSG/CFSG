module
public import CFSG.Quasithin.Chapter3.Section01.ChiefAction.Offender
public import CFSG.Quasithin.ChapterB.Section06To07.ChiefActions.SmallThompson
public import CFSG.Quasithin.ChapterB.Section06To07.ChiefActions.SmallThreeThompson
public import CFSG.Quasithin.ChapterB.Section06To07.ChiefActions.SmallPair

/-!
# The single symmetric-five branch on the original qrc chief factors

The original minimal actor supplies a sharp FF offender on each noncentral
chief factor of the H-span of V. When B.6.9 gives its marked five-point
section, irreducibility upgrades that section to the entire literal chief
action, with the whole actor generated by offenders. No faithfulness,
reducedness, FF-module, or minimal-parabolic assumption is added to the
original qrc source. The only branch premise is its actual B.6.9 marking.

Source: Aschbacher–Smith, 3.1.9(5) and15.1.12(3), printed pp.577–578,1090.
-/

public section
open Subgroup Representation Representation.BinaryOffender NoncentralChiefRefinement Stellmacher
open scoped IsMulCommutative ENNReal
namespace CFSG.Quasithin.Chapter3
open ChapterD ChapterD.UniqueFactor Theory.GroupTheory
open ChapterB.SourceInduction ChapterB.QuasisimpleSource
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {M M₀ H V : Subgroup G}

set_option backward.isDefEq.respectTransparency false in
theorem QrcHypotheses.sqtk_chief_five_action
    (h : QrcHypotheses T M M₀ H V) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hM : IsMaximalTwoLocal M)
    (hu : ∀ N : Subgroup G, IsMaximalTwoLocal N → M₀ ≤ N → N = M)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (V : Set G))
    (hne : V ≠ ⊥) (hV : V ≤ twoCoreIn H)
    (hdual : ¬ DualFF (h.toQRCConfiguration (h.no_common_normal hu)))
    (hq : letI := h.module_elementary
      quadraticRatio (imageRepresentation M₀ V h.module_normalized) = 2) :
    let d := h.toQRCConfiguration (h.no_common_normal hu)
    let U := (conjugateSpan H V).subgroupOf H
    letI := d.module_elementary
    letI := source_elementary_span_of_notFF d hV (source_notFF_of_ratio_two d hq)
    letI : IsElementaryAbelian 2 U := IsElementaryAbelian.subgroupOf
      ((span_le_right_core d hV).trans (twoCore_le H))
    ∀ (s : SeriesOn U) (i : Fin s.series.length), ¬ s.Central i →
      let ρ := Representation.BinaryOffender.imageRepresentation (s.factorRepresentation i)
      ChapterB.ChiefFiveMarkedSection ρ →
      Nonempty (ActionEquiv ρ (BinaryPermutation.naturalRepresentation (Fin 5))) ∧
        offenderSubgroup ρ = ⊤ ∧
        (elementaryAbelianMaxJ (⊤ : Subgroup H)).map
          (actionHom (s.factorRepresentation i)) = ⊤ := by
  let d := h.toQRCConfiguration (h.no_common_normal hu)
  let := d.module_elementary
  let := source_elementary_span_of_notFF d hV (source_notFF_of_ratio_two d hq)
  let U := (conjugateSpan H V).subgroupOf H
  let : IsElementaryAbelian 2 U := IsElementaryAbelian.subgroupOf
    ((span_le_right_core d hV).trans (twoCore_le H))
  let S := T.subtype h.right_mem.1.1.2
  have hS : (S : Subgroup H).map H.subtype = T := map_subgroupOf_eq_of_le h.right_mem.1.1.2
  obtain ⟨A,hA,hAR,hff⟩ := h.sqtk_chief_ff_actor hG hM hu hJ hne hV hdual hq
  dsimp only
  intro s i hi hmark
  let := s.factorRepresentation_irreducible i
  obtain ⟨⟨e⟩,hoff⟩ := ChapterB.minimalParabolic_chief_five_of_marked (s.factorRepresentation i) S
    (source_intrinsic_minimalParabolic_of_notFF d hne (source_notFF_of_ratio_two d hq) S hS)
    ⟨_,(hff s i hi).1⟩ hmark
  exact ⟨⟨e⟩,hoff,ChapterB.chief_five_thompson_image (s.factorRepresentation i) S A hA
    (hff s i hi).1 e⟩


set_option backward.isDefEq.respectTransparency false in
theorem QrcHypotheses.sqtk_chief_three_thompson_image
    (h : QrcHypotheses T M M₀ H V) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hM : IsMaximalTwoLocal M)
    (hu : ∀ N : Subgroup G, IsMaximalTwoLocal N → M₀ ≤ N → N = M)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (V : Set G))
    (hne : V ≠ ⊥) (hV : V ≤ twoCoreIn H)
    (hdual : ¬ DualFF (h.toQRCConfiguration (h.no_common_normal hu)))
    (hq : letI := h.module_elementary
      quadraticRatio (imageRepresentation M₀ V h.module_normalized) = 2) :
    let d := h.toQRCConfiguration (h.no_common_normal hu)
    let U := (conjugateSpan H V).subgroupOf H
    letI := d.module_elementary
    letI := source_elementary_span_of_notFF d hV (source_notFF_of_ratio_two d hq)
    letI : IsElementaryAbelian 2 U := IsElementaryAbelian.subgroupOf
      ((span_le_right_core d hV).trans (twoCore_le H))
    ∀ (s : SeriesOn U) (i : Fin s.series.length), ¬ s.Central i →
      (actionImage (s.factorRepresentation i) ≃* Equiv.Perm (Fin 3)) →
      (elementaryAbelianMaxJ (⊤ : Subgroup H)).map
        (actionHom (s.factorRepresentation i)) = ⊤ := by
  let d := h.toQRCConfiguration (h.no_common_normal hu)
  let := d.module_elementary
  let := source_elementary_span_of_notFF d hV (source_notFF_of_ratio_two d hq)
  let U := (conjugateSpan H V).subgroupOf H
  let : IsElementaryAbelian 2 U := IsElementaryAbelian.subgroupOf
    ((span_le_right_core d hV).trans (twoCore_le H))
  let S := T.subtype h.right_mem.1.1.2
  have hS : (S : Subgroup H).map H.subtype = T := map_subgroupOf_eq_of_le h.right_mem.1.1.2
  obtain ⟨A,hA,hAR,hff⟩ := h.sqtk_chief_ff_actor hG hM hu hJ hne hV hdual hq
  dsimp only
  intro s i hi e
  exact ChapterB.chief_three_thompson_image (s.factorRepresentation i) S A hA
    (hff s i hi).1 e


set_option backward.isDefEq.respectTransparency false in
theorem QrcHypotheses.sqtk_chief_five_pair_action
    (h : QrcHypotheses T M M₀ H V) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hM : IsMaximalTwoLocal M)
    (hu : ∀ N : Subgroup G, IsMaximalTwoLocal N → M₀ ≤ N → N = M)
    (hJ : elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (V : Set G))
    (hne : V ≠ ⊥) (hV : V ≤ twoCoreIn H)
    (hdual : ¬ DualFF (h.toQRCConfiguration (h.no_common_normal hu)))
    (hq : letI := h.module_elementary
      quadraticRatio (imageRepresentation M₀ V h.module_normalized) = 2) :
    let d := h.toQRCConfiguration (h.no_common_normal hu)
    let U := (conjugateSpan H V).subgroupOf H
    letI := d.module_elementary
    letI := source_elementary_span_of_notFF d hV (source_notFF_of_ratio_two d hq)
    letI : IsElementaryAbelian 2 U := IsElementaryAbelian.subgroupOf
      ((span_le_right_core d hV).trans (twoCore_le H))
    ∀ (s : SeriesOn U) (i : Fin s.series.length), ¬ s.Central i →
      let ρ := Representation.BinaryOffender.imageRepresentation (s.factorRepresentation i)
      ChapterB.ChiefFivePairMarkedSection ρ →
      ∃ e : ActionEquiv ρ BinaryPermutation.FivePair.wreathRepresentation,
        (offenderSubgroup ρ).map e.groupEquiv.toMonoidHom =
          BinaryPermutation.FivePair.baseSubgroup := by
  let d := h.toQRCConfiguration (h.no_common_normal hu)
  let := d.module_elementary
  let := source_elementary_span_of_notFF d hV (source_notFF_of_ratio_two d hq)
  let U := (conjugateSpan H V).subgroupOf H
  let : IsElementaryAbelian 2 U := IsElementaryAbelian.subgroupOf
    ((span_le_right_core d hV).trans (twoCore_le H))
  let S := T.subtype h.right_mem.1.1.2
  have hS : (S : Subgroup H).map H.subtype = T := map_subgroupOf_eq_of_le h.right_mem.1.1.2
  obtain ⟨A,hA,hAR,hff⟩ := h.sqtk_chief_ff_actor hG hM hu hJ hne hV hdual hq
  dsimp only
  intro s i hi hmark
  let := s.factorRepresentation_irreducible i
  exact ChapterB.minimalParabolic_chief_five_pair_of_marked (s.factorRepresentation i) S
    (source_intrinsic_minimalParabolic_of_notFF d hne (source_notFF_of_ratio_two d hq) S hS)
    ⟨_,(hff s i hi).1⟩ hmark

end CFSG.Quasithin.Chapter3
