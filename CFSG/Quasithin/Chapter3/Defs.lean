module

public import Theory.Quasithin
public import Mathlib.GroupTheory.Sylow
public import CFSG.Quasithin.Chapter1.Defs

/-!
# The local setup used in Chapter 3, §3.1

The family `HStar` is Definition 3.0.1 of Aschbacher–Smith, combined
manuscript (1 March 2004), p. 571, using the Chapter 1 definition of `H(T)`.
The remaining definitions retain the earlier elementary interface. Normality is
recorded relative to the subgroup generated by two local subgroups; this avoids
silently treating a subgroup normal in `M₀` as normal in the ambient group.

The definitions are deliberately parameterised by the ambient group and can be
instantiated by the preceding chapter when its local-family definitions are
available.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter3

variable {G : Type*} [Group G]

/-- Definition 3.0.1: the minimal members of `H(T)` outside `M`.
The star is a subscript in the manuscript. -/
def HStar (T M : Subgroup G) : Set (Subgroup G) :=
  {H | Minimal (fun Y => Y ∈ Chapter1.HOver G (T : Set G) ∧ ¬ Y ≤ M) H}

/-- Normality of `N` in a subgroup `K`, with the inclusion made explicit. -/
def NormalIn (N K : Subgroup G) : Prop :=
  N ≤ K ∧ ∀ ⦃g : G⦄, g ∈ K → ∀ ⦃n : G⦄, n ∈ N → g * n * g⁻¹ ∈ N

/-- The subgroup generated by the two local subgroups in §3.1. -/
def generated (M₀ H : Subgroup G) : Subgroup G :=
  Subgroup.closure ((M₀ : Set G) ∪ (H : Set G))

/-- The hypotheses needed for the elementary common-normal-subgroup transfer.

`Rnormal` is ambient normality, which is stronger than the local normality
assumed in source 3.1.1. This older structure is retained for compatibility;
it is not the source's common-normal-subgroup hypothesis.
-/
structure CommonNormalData where
  T : Subgroup G
  M₀ : Subgroup G
  H : Subgroup G
  R : Subgroup G
  T_le_M₀ : T ≤ M₀
  T_le_H : T ≤ H
  R_le_T : R ≤ T
  R_ne_bot : R ≠ ⊥
  Rnormal : R.Normal

@[simp] theorem generated_def (M₀ H : Subgroup G) :
    generated M₀ H = Subgroup.closure ((M₀ : Set G) ∪ (H : Set G)) := rfl

theorem le_generated_left {M₀ H : Subgroup G} : M₀ ≤ generated M₀ H := by
  intro x hx
  exact Subgroup.subset_closure (Set.mem_union_left (H : Set G) hx)

theorem le_generated_right {M₀ H : Subgroup G} : H ≤ generated M₀ H := by
  intro x hx
  exact Subgroup.subset_closure (Set.mem_union_right (M₀ : Set G) hx)

theorem normalIn_of_normal {N K : Subgroup G} (hNK : N ≤ K) (hN : N.Normal) :
    NormalIn N K := by
  refine ⟨hNK, ?_⟩
  intro g hg n hn
  exact hN.conj_mem n hn g

/-- A local family together with the interval-closure property used in Lemma
3.1.2.  The additional SQTK predicate is kept explicit because it is supplied
by the preceding QTKE API. -/
structure LocalFamily (T : Subgroup G) where
  member : Subgroup G → Prop
  stronglyQuasithin : Subgroup G → Prop
  interval_closed : ∀ ⦃H Y : Subgroup G⦄, member H → T ≤ Y → Y ≤ H → member Y
  member_strong : ∀ ⦃H : Subgroup G⦄, member H → stronglyQuasithin H

public theorem interval_member {T : Subgroup G} (F : LocalFamily (G := G) T)
    {H Y : Subgroup G} (hH : F.member H) (hTY : T ≤ Y) (hYH : Y ≤ H) :
    F.member Y := F.interval_closed hH hTY hYH

public theorem interval_stronglyQuasithin {T : Subgroup G}
    (F : LocalFamily (G := G) T)
    {H Y : Subgroup G} (hH : F.member H) (hTY : T ≤ Y) (hYH : Y ≤ H) :
    F.stronglyQuasithin Y := F.member_strong (F.interval_closed hH hTY hYH)

end CFSG.Quasithin.Chapter3
