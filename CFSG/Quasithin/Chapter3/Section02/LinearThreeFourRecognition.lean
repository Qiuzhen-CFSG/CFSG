/-!
# Recognizing the irreducible FSU action with quotient PSL₃(4)

Use the literal conjugation image of L₀T on V. If T normalizes K,
commutator generation makes the K-image nontrivial. Its kernel is precisely
O₂(K): the core acts trivially and the remaining kernel is central in the
centerless quasisimple quotient. Thus the marking preserves the original
quotient map, not merely the abstract isomorphism type.

Reducedness and the two-group quotient identify F* with this component image.
Theorem A supplies SQTK for that image, and the actual qrc configuration
supplies cubic ratio at most two under the multiple-overgroup guard.
Consequently irreducibility alone supplies Chapter K's source hypotheses;
its recognition gives Hermitian coordinates for the original FSU module.

The source derivation of irreducibility (including the moved-seed and fixed
space alternatives) remains with qt-d-1222-linear-residual-maximal-nonfaithful.
This module does not assert the unconditional 3.2.5 or 3.2.9. Its residual
consumer is RankOneModuleGenericExceptionalLinearResidualFSURecognition.
Source: Aschbacher–Smith 3.2.2–9, printed pp.579–583, and 5.1.14, p.638
(refs/quasithin.pdf).
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation
open scoped MatrixGroups IsMulCommutative
open Representation.HermitianTensorThree Representation.HermitianTensorThree.ImageOuter
namespace CFSG.Quasithin.Chapter3.Section02.FundamentalSetup
open ChapterD.UniqueFactor ChapterK.Linear.Recognition
open Representation.BinaryOffender Representation.BinaryOffender.Homogeneous
universe u
variable {G : Type u} [Group G] [Finite G]
  {T : Sylow 2 G} {K : Subgroup G} {𝒦 : GroupClass.{u}}
  (D : FundamentalSetup 𝒦 T K)

/-- The actual local conjugation image on V. -/
abbrev joinActionImage := ChapterD.internalActionImage (localJoin T K)
  D.moduleSubgroup D.join_normalizes_module

/-- The original join maps onto its action image. -/
abbrev joinAction : localJoin T K →* D.joinActionImage :=
  (actionHom (localJoin T K) D.moduleSubgroup D.join_normalizes_module).rangeRestrict

/-- Restriction of the same conjugation action to K. -/
abbrev componentAction : K →* D.joinActionImage :=
  D.joinAction.comp (inclusion ((le_componentOrbit K (T : Subgroup G)).trans le_sup_left))

/-- The component as a subgroup of the actual join image. -/
abbrev componentActionImage : Subgroup D.joinActionImage := D.componentAction.range

/-- The original component projection onto its faithful image. -/
abbrev componentProjection : K →* D.componentActionImage := D.componentAction.rangeRestrict

local instance : IsElementaryAbelian 2 D.moduleSubgroup := D.module_elementary

/-- The faithful binary representation on the actual ambient V. -/
abbrev joinRepresentation : Representation (ZMod 2) D.joinActionImage
    (Additive D.moduleSubgroup) :=
  imageRepresentation (localJoin T K) D.moduleSubgroup D.join_normalizes_module

/-- The original module is generated by its K-commutators. -/
theorem module_commutator_component
    (hn : (T : Subgroup G) ≤ normalizer (K : Set G)) :
    D.moduleSubgroup = ⁅D.moduleSubgroup,K⁆ := by
  have he : localOrbit T K = K :=
    le_antisymm (iSup_conjugates_le_of_le_normalizer _ _ _ le_rfl hn)
      (le_componentOrbit _ _)
  rw [D.module_eq_subspaceImage]
  have hm := ReducedNormal.subspaceImage_eq_commutator (localJoin T K) _
    (localOrbit T K) le_sup_left
    (orbitSpan_component_invariant _ D.homogeneous.normalizes D.homogeneous.isIrrPlus)
    (orbitSpan_full_commutator _ D.homogeneous.normalizes D.homogeneous.isIrrPlus)
  simpa only [he] using hm

/-- The component image is nontrivial by commutator generation. -/
theorem componentActionImage_nontrivial
    (hn : (T : Subgroup G) ≤ normalizer (K : Set G)) :
    Nontrivial D.componentActionImage := by
  apply not_subsingleton_iff_nontrivial.mp
  intro hs
  let := hs
  have hc : K ≤ centralizer (D.moduleSubgroup : Set G) := by
    intro k hk w hw
    have h := Subsingleton.elim (D.componentProjection ⟨k,hk⟩) 1
    have hh := congrArg (fun a : D.componentActionImage =>
      ((a.val.val : MulAut D.moduleSubgroup) ⟨w,hw⟩ : G)) h
    change k * w * k⁻¹ = w at hh
    exact (mul_inv_eq_iff_eq_mul.mp hh).symm
  apply D.module_ne_bot
  rw [D.module_commutator_component hn,commutator_comm]
  exact commutator_eq_bot_iff_le_centralizer.mpr hc

/-- The intrinsic component two-core fixes the actual module. -/
theorem componentProjection_core_le_ker
    (hn : (T : Subgroup G) ≤ normalizer (K : Set G)) :
    pCore 2 K ≤ D.componentProjection.ker := by
  have he : localOrbit T K = K :=
    le_antisymm (iSup_conjugates_le_of_le_normalizer _ _ _ le_rfl hn)
      (le_componentOrbit _ _)
  have hc : K.pCoreIn 2 ≤ centralizer (D.moduleSubgroup : Set G) := by
    apply (pCoreIn_mono_of_normalizes ((le_componentOrbit K (T : Subgroup G)).trans
      le_sup_left) ?_).trans D.core_centralizes_module
    change localOrbit T K ⊔ (T : Subgroup G) ≤ _
    rw [he]
    exact sup_le K.le_normalizer hn
  intro k hk
  apply MonoidHom.mem_ker.mpr
  apply Subtype.ext
  apply Subtype.ext
  apply MulEquiv.ext
  intro w
  apply Subtype.ext
  change (k : G) * (w : G) * (k : G)⁻¹ = w
  have hkw := hc (mem_map_of_mem K.subtype hk) w w.property
  change (w : G) * (k : G) = (k : G) * (w : G) at hkw
  rw [← hkw, mul_inv_cancel_right]

/-- Centerlessness identifies the exact action kernel with O₂(K). -/
theorem componentProjection_ker
    (hn : (T : Subgroup G) ≤ normalizer (K : Set G))
    (e : (K ⧸ pCore 2 K) ≃* PSL(3,E 1))
    : D.componentProjection.ker = pCore 2 K := by
  let := D.quasisimple
  let := D.componentActionImage_nontrivial hn
  have hc := D.componentProjection_core_le_ker hn
  have hz : center (K ⧸ pCore 2 K) = ⊥ := by
    apply Subgroup.card_eq_one.mp
    rw [Nat.card_congr (Subgroup.centerCongr e).toEquiv,
      Group.IsPerfect.center_quotient_center_eq_bot SL(3,E 1), Subgroup.card_bot]
  apply le_antisymm _ hc
  intro k hk
  apply (QuotientGroup.eq_one_iff _).mp
  have hh := D.componentProjection.map_ker_central_of_quasisimple_pCore
    D.componentAction.rangeRestrict_surjective hc (mem_map_of_mem _ hk)
  rwa [hz, Subgroup.mem_bot] at hh

/-- The quotient marking preserves the original projection on representatives. -/
noncomputable def componentQuotientEquiv
    (hn : (T : Subgroup G) ≤ normalizer (K : Set G))
    (e : (K ⧸ pCore 2 K) ≃* PSL(3,E 1))
    : (K ⧸ pCore 2 K) ≃* D.componentActionImage :=
  (QuotientGroup.quotientMulEquivOfEq (D.componentProjection_ker hn e).symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective D.componentProjection
      D.componentAction.rangeRestrict_surjective)

/-- Chapter K recognition supplies an actual FSU action marking. -/
theorem hermitianFourMarking_of_sourceHypothesis
    (hn : (T : Subgroup G) ≤ normalizer (K : Set G))
    (e : (K ⧸ pCore 2 K) ≃* PSL(3,E 1))
    (h : SourceHypothesis 𝒦 D.joinRepresentation D.componentActionImage) :
    Nonempty D.HermitianFourMarking := by
  let q := D.componentQuotientEquiv hn e
  obtain ⟨j,c,he⟩ := linearThreeFour_hermitian_coordinates h (q.symm.trans e)
  refine ⟨⟨q.trans j,c.toAddEquiv,?_⟩⟩
  intro k w
  have hc := he (D.componentProjection k) (Additive.ofMul w)
  convert hc using 1 <;> rfl

omit [Finite G] in
private theorem orbit_eq (hn : (T : Subgroup G) ≤ normalizer (K : Set G)) :
    localOrbit T K = K :=
  le_antisymm (iSup_conjugates_le_of_le_normalizer _ _ _ le_rfl hn)
    (le_componentOrbit _ _)

private theorem component_map :
    (K.subgroupOf (localJoin T K)).map D.joinAction = D.componentActionImage := by
  ext a
  constructor
  · rintro ⟨k,hk,rfl⟩
    exact ⟨⟨k,hk⟩,rfl⟩
  · rintro ⟨k,rfl⟩
    exact ⟨⟨k,(le_componentOrbit K (T : Subgroup G)).trans le_sup_left k.property⟩,
      k.property,rfl⟩

/-- Normality is inside the literal join action image. -/
theorem componentActionImage_normal
    (hn : (T : Subgroup G) ≤ normalizer (K : Set G)) :
    D.componentActionImage.Normal := by
  have hN : (K.subgroupOf (localJoin T K)).Normal :=
    normal_subgroupOf_of_le_normalizer (by
      change localOrbit T K ⊔ (T : Subgroup G) ≤ _
      rw [orbit_eq hn]
      exact sup_le K.le_normalizer hn)
  rw [← D.component_map]
  exact Normal.map hN D.joinAction (MonoidHom.rangeRestrict_surjective _)

/-- The action image is a two-group extension of the component image. -/
theorem joinImage_quotient_isTwoGroup
    (hn : (T : Subgroup G) ≤ normalizer (K : Set G)) :
    letI := D.componentActionImage_normal hn
    IsPGroup 2 (D.joinActionImage ⧸ D.componentActionImage) := by
  let := D.componentActionImage_normal hn
  let A := localJoin T K
  let X := K.subgroupOf A
  let : X.Normal := normal_subgroupOf_of_le_normalizer (by
    change localOrbit T K ⊔ (T : Subgroup G) ≤ _
    rw [orbit_eq hn]
    exact sup_le K.le_normalizer hn)
  have hp : IsPGroup 2 (A ⧸ X) := by
    apply isPGroup_quotient_of_sup_eq_top X ((T : Subgroup G).subgroupOf A)
      T.isPGroup'.comap_subtype
    have hKA : K ≤ A := (le_componentOrbit K (T : Subgroup G)).trans le_sup_left
    rw [← subgroupOf_sup hKA le_sup_right]
    have he : K ⊔ (T : Subgroup G) = A := by
      change _ = localOrbit T K ⊔ (T : Subgroup G)
      rw [orbit_eq hn]
    rw [he,subgroupOf_self]
  have hx : X ≤ D.componentActionImage.comap D.joinAction := by
    intro x hx
    exact ⟨⟨x,hx⟩,rfl⟩
  exact hp.of_surjective (QuotientGroup.map X D.componentActionImage D.joinAction hx)
    (QuotientGroup.map_surjective_of_surjective _ _ D.joinAction
      ((QuotientGroup.mk'_surjective _).comp (MonoidHom.rangeRestrict_surjective _)) hx)

/-- Reducedness identifies the actual generalized Fitting subgroup. -/
theorem joinImage_fitting
    (h127 : Chapter1.Section02.NonsolvableUniquenessConclusion T K)
    (hn : (T : Subgroup G) ≤ normalizer (K : Set G))
    (e : (K ⧸ pCore 2 K) ≃* PSL(3,E 1)) :
    generalizedFitting D.joinActionImage = D.componentActionImage := by
  let := D.componentActionImage_normal hn
  let := D.quasisimple
  let : IsQuasisimple D.componentActionImage :=
    IsQuasisimple.of_mulEquiv (D.componentQuotientEquiv hn e)
  exact generalizedFitting_eq_of_quasisimple_two_quotient D.componentActionImage
    (D.joinImage_quotient_isTwoGroup hn)
    (internalActionImage_core_of_reduced _ _
      (D.module_le_core.trans (pCoreIn_le 2 _)) D.join_normalizes_module
      (D.module_reduced h127))

/-- Theorem A transfers SQTK to the component image and its two-extension. -/
theorem joinImage_sqtk
    (h127 : Chapter1.Section02.NonsolvableUniquenessConclusion T K)
    (hn : (T : Subgroup G) ≤ normalizer (K : Set G))
    (e : (K ⧸ pCore 2 K) ≃* PSL(3,E 1))
    (hA : ∀ (X : Type u) [Group X] [Finite X], ChapterA.Section02.TheoremA 𝒦 X) :
    IsSQTK 𝒦 D.joinActionImage := by
  have hJ := (D.local_internal_module h127).sqtk
  have hK : IsSQTK 𝒦 K := (IsSQTK.equiv (subgroupOfEquivOfLe
    ((le_componentOrbit K (T : Subgroup G)).trans le_sup_left))).mp
      (hJ.subgroup (K.subgroupOf (localJoin T K)))
  let := D.componentActionImage_normal hn
  let := D.quasisimple
  let : IsQuasisimple D.componentActionImage :=
    IsQuasisimple.of_mulEquiv (D.componentQuotientEquiv hn e)
  have hs : ChapterA.Section02.IsSemisimple D.componentActionImage := by
    apply top_unique
    exact le_sSup (show IsComponent D.componentActionImage ⊤ from
      ⟨Subgroup.IsSubnormal.top, IsQuasisimple.of_mulEquiv topEquiv.symm⟩)
  have hS := (hA K).stronglyQuasithin_section hK.stronglyQuasithin hK.isKGroup
    (ChapterA.Section02.IsSectionOf.of_surjective D.componentProjection
      D.componentAction.rangeRestrict_surjective) hs
  exact ⟨ChapterB.QuasisimpleSource.IrreducibleBranch.stronglyQuasithin_of_twoGroup_quotient
    D.componentActionImage (D.joinImage_quotient_isTwoGroup hn) hS,
    hJ.isKGroup.of_surjective D.joinAction (MonoidHom.rangeRestrict_surjective _)⟩

omit D in
/-- The original qrc configuration bounds the actual local action. -/
theorem joinRepresentation_cubicRatio_le_two
    (D : FundamentalSetup KnownSimple.IsKnownSimple T K)
    (h127 : Chapter1.Section02.NonsolvableUniquenessConclusion T K)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard) :
    letI := D.module_elementary
    cubicRatio D.joinRepresentation ≤ 2 := by
  let := D.module_elementary
  obtain ⟨hM,hJM,hu⟩ := D.lemma_3_2_3_uniqueness h127
  have hTM : (T : Subgroup G) ≤ D.maximalLocal := le_sup_right.trans hJM
  obtain ⟨H,hH⟩ := Chapter3.exists_HStar_of_hasMaximalOutside
    (Chapter3.hasMaximalOutside_of_many T hmany D.maximalLocal hM hTM)
  exact (D.qrcHypotheses h127 hH).source_cubicRatio_le_two
    D.simpleQTKE hM hu D.module_ne_bot

omit D in
/-- All Chapter K hypotheses except irreducibility follow from the FSU. -/
theorem joinRepresentation_sourceHypothesis_of_irreducible
    (D : FundamentalSetup KnownSimple.IsKnownSimple T K)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hn : (T : Subgroup G) ≤ normalizer (K : Set G))
    (e : (K ⧸ pCore 2 K) ≃* PSL(3,E 1))
    (hi : letI := D.module_elementary
      Representation.IsIrreducible (D.joinRepresentation.comp D.componentActionImage.subtype)) :
    letI := D.module_elementary
    SourceHypothesis KnownSimple.IsKnownSimple D.joinRepresentation D.componentActionImage := by
  let := D.module_elementary
  have h127 := Chapter1.Section02.nonsolvable_uniqueness_of_theoremsAC
    (fun X _ _ => ChapterA.Section02.theoremA_knownSimple (G := X))
    (fun X _ _ => ChapterA.Section02.theoremC_knownSimple (G := X))
    D.simpleQTKE T D.maximal
  let := D.quasisimple
  exact ⟨inferInstance,inferInstance,
    D.joinImage_sqtk h127 hn e (fun X _ _ => ChapterA.Section02.theoremA_knownSimple (G := X)),
    D.joinImage_fitting h127 hn e,
    IsQuasisimple.of_mulEquiv (D.componentQuotientEquiv hn e),
    imageRepresentation_injective _ _ _, hi,
    D.joinRepresentation_cubicRatio_le_two h127 hmany⟩

omit D in
/-- Irreducibility recognizes the original FSU module over any field marking. -/
theorem hermitianFourMarking_of_irreducible
    (D : FundamentalSetup KnownSimple.IsKnownSimple T K)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hn : (T : Subgroup G) ≤ normalizer (K : Set G))
    (hlinear : ClassicalGroup.IsPSL (K ⧸ pCore 2 K) 3 4)
    (hi : letI := D.module_elementary
      Representation.IsIrreducible (D.joinRepresentation.comp D.componentActionImage.subtype)) :
    Nonempty D.HermitianFourMarking := by
  obtain ⟨F,hF,hfin,hcard,⟨e⟩⟩ := hlinear
  let : Fintype F := Fintype.ofFinite F
  let : Fintype (E 1) := Fintype.ofFinite _
  let a : F ≃+* E 1 := FiniteField.ringEquivOfCardEq (by
    rw [← Nat.card_eq_fintype_card,← Nat.card_eq_fintype_card,hcard,card_E]
    norm_num)
  let e' := e.trans (Atlas.fieldEquivPSL 3 a)
  exact D.hermitianFourMarking_of_sourceHypothesis hn e'
    (D.joinRepresentation_sourceHypothesis_of_irreducible hmany hn e' hi)

end CFSG.Quasithin.Chapter3.Section02.FundamentalSetup
