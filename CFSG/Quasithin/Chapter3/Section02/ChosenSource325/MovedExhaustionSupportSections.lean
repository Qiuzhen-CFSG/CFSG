module
public import CFSG.Quasithin.Chapter3.Section02.ChosenSource325.MovedExhaustionNormalSupport
public import CFSG.Quasithin.Chapter3.Section02.ChosenSource325.MovedSylowOffenderExtraction
public import Theory.Representation.BinaryOffender.IrreducibleSubspaceExistence
public import Theory.Representation.BinaryOffender.PerfectCentralizer

/-!
# Sections of the normal support on the chosen isotypic pair

A support X generated by its commutators with a subactor B cannot act
nontrivially on an A-invariant half fixed by A. Neither complementary
half can therefore supplement the other by A-fixed vectors. The genuine
D.2.7 restriction alternatives give strict cubic-ratio decrease on both.

Inside a half moved by the perfect support, minimal-section existence and
A.1.42 select an Irr⁺ member homogeneous for the original Sylow half
stabilizer. The exchanger gives a disjoint copy, so its full Sylow orbit
is strictly larger. The original fixed-free perfect component cannot
stabilize this member, by the cyclic centralizer theorem for Irr⁺. Its
orbit under that component is strictly larger, stays inside the original
half, and is fully moved by X, as required for the final multiplicity estimate.

For a normal quasisimple support, faithfulness of the actor on the support
makes it faithful on both halves. Their shared codimension budget gives
an actual FF offender on one half; conjugation transfers FF to the first.
This retains the alternative of a nontrivial support centralizer. It does
not assert FF for the selected Irr⁺ member or full movement on a half.

The actual application is `SeedAlternativesMovedExhaustionSupportSections`.
Support classification, component movement, multiplicity, other-model FF
exclusions and Source325 assembly remain with qt-baumann-fsu.
Source: Aschbacher--Smith A.1.42, D.2.7 and D.3.17, pp.32,179 and203.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open Representation.BinaryOffender.Homogeneous
open scoped IsMulCommutative ENNReal
namespace CFSG.Quasithin.Chapter3.Section02.ChosenSource325
variable {H E : Type*} [Group H] [Finite H] [AddCommGroup E] [Module (ZMod 2) E]
  [FiniteDimensional (ZMod 2) E]

omit [Finite H] [FiniteDimensional (ZMod 2) E] in
private theorem fixed_other_of_supplement
    (ρ : Representation (ZMod 2) H E) (P Q : Submodule (ZMod 2) E)
    (hd : Disjoint P Q) (A : Subgroup H)
    (hAP : A ≤ subspaceStabilizer ρ P) (hAQ : A ≤ subspaceStabilizer ρ Q)
    (hs : P ⊔ fixedSpace ρ A = ⊤) : Q ≤ fixedSpace ρ A := by
  intro v hv a
  obtain ⟨p,hp,c,hc,rfl⟩ := Submodule.mem_sup.mp (hs.symm ▸ (Submodule.mem_top : v ∈ ⊤))
  have he : ρ a.val (p+c) - (p+c) = ρ a.val p-p := by
    have hca : ρ a.val c = c := hc a
    rw [map_add,hca]
    abel
  apply sub_eq_zero.mp
  apply Submodule.disjoint_def.mp hd
  · change ρ a.val (p+c) - (p+c) ∈ P
    rw [he]
    exact P.sub_mem ((hAP a.property p).2 hp) hp
  · exact Q.sub_mem ((hAQ a.property _).2 hv) hv

/-- Support moved by a subactor forces strict ratio decrease on both invariant halves. -/
theorem support_pair_strict_ratios
    (ρ : Representation (ZMod 2) H E)
    (X A B : Subgroup H) (hA : A ∈ CFSG.Quasithin.ChapterD.QhatStar ρ)
    (hBA : B ≤ A) (hXB : ⁅X,B⁆ = X)
    (P Q : Submodule (ZMod 2) E) (hd : Disjoint P Q)
    (hXP : X ≤ subspaceStabilizer ρ P) (hXQ : X ≤ subspaceStabilizer ρ Q)
    (hAP : A ≤ subspaceStabilizer ρ P) (hAQ : A ≤ subspaceStabilizer ρ Q)
    (hmP : ¬ P ≤ fixedSpace ρ X) (hmQ : ¬ Q ≤ fixedSpace ρ X) :
    (restrictedSubgroup ρ P A ∈ CFSG.Quasithin.ChapterD.Qhat (subspaceImageRepresentation ρ P) ∧
      actionRatio (subspaceImageRepresentation ρ P) (restrictedSubgroup ρ P A) < cubicRatio ρ) ∧
    (restrictedSubgroup ρ Q A ∈ CFSG.Quasithin.ChapterD.Qhat (subspaceImageRepresentation ρ Q) ∧
      actionRatio (subspaceImageRepresentation ρ Q) (restrictedSubgroup ρ Q A) < cubicRatio ρ) := by
  have hnot (R : Submodule (ZMod 2) E) (hXR : X ≤ subspaceStabilizer ρ R)
      (hm : ¬ R ≤ fixedSpace ρ X) : ¬ R ≤ fixedSpace ρ A := by
    intro hf
    apply hm
    rw [←hXB]
    exact le_fixedSpace_commutator_of_invariant ρ hXR (hf.trans (fixedSpace_antitone ρ hBA))
  have hstep (R S : Submodule (ZMod 2) E) (hRS : Disjoint R S)
      (hXR : X ≤ subspaceStabilizer ρ R) (hXS : X ≤ subspaceStabilizer ρ S)
      (hAR : A ≤ subspaceStabilizer ρ R) (hAS : A ≤ subspaceStabilizer ρ S)
      (hr : ¬ R ≤ fixedSpace ρ X) (hs : ¬ S ≤ fixedSpace ρ X) :
      restrictedSubgroup ρ R A ∈ CFSG.Quasithin.ChapterD.Qhat (subspaceImageRepresentation ρ R) ∧
      actionRatio (subspaceImageRepresentation ρ R) (restrictedSubgroup ρ R A) < cubicRatio ρ := by
    rcases (CFSG.Quasithin.ChapterD.QhatStar.restriction_alternatives ρ hA R hAR
      (hnot R hXR hr)).2.2 with h | ⟨_,h⟩
    · exact h
    · exact (hnot S hXS hs (fixed_other_of_supplement ρ R S hRS A hAR hAS h)).elim
  exact ⟨hstep P Q hd hXP hXQ hAP hAQ hmP hmQ,
    hstep Q P hd.symm hXQ hXP hAQ hAP hmQ hmP⟩

omit [Finite H] in
/-- The source's homogeneous support seed lies inside the original half;
its Sylow conjugate is disjoint and the commuting fixed-free component moves it. -/
theorem exists_homogeneous_support_seed_in_half
    (ρ : Representation (ZMod 2) H E) (X K S : Subgroup H)
    [X.Normal] [Group.IsPerfect X] [Group.IsPerfect K]
    (hS : IsPGroup 2 S) (hK : fixedSpace ρ K = ⊥)
    (hc : K ≤ centralizer (X : Set H))
    (P : Submodule (ZMod 2) E) (hXP : X ≤ subspaceStabilizer ρ P)
    (hm : ¬ P ≤ fixedSpace ρ X) (t : H) (ht : t ∈ S)
    (hd : Disjoint P (P.map (ρ t))) :
    ∃ R : Submodule (ZMod 2) E, R ≤ P ∧
      IsIrrPlusWith ρ X (S ⊓ subspaceStabilizer ρ P) R ∧
      IsIrrPlus ρ X (R.map (ρ t)) ∧
      Disjoint R (R.map (ρ t)) ∧ R.map (ρ t) ≠ R ∧
      R < orbitSpan ρ S R ∧ ¬ K ≤ subspaceStabilizer ρ R := by
  obtain ⟨R,hRP,hR⟩ := exists_isIrrPlus_le_of_not_fixed ρ X P hXP hm
  have hn : S ⊓ subspaceStabilizer ρ P ≤ normalizer (X : Set H) := by
    rw [normalizer_eq_top]
    exact le_top
  obtain ⟨Q,hQR,hQ⟩ := exists_isIrrPlusWith_le_orbitSpan ρ hn
    (hS.to_le inf_le_left) hR
  have hQP : Q ≤ P := hQR.trans (orbitSpan_le ρ hRP inf_le_right)
  have hdQ : Disjoint Q (Q.map (ρ t)) := hd.mono hQP (Submodule.map_mono hQP)
  have hne : Q.map (ρ t) ≠ Q := by
    intro he
    exact hQ.isIrrPlus.ne_bot ρ (disjoint_self.mp (by simpa only [he] using hdQ))
  refine ⟨Q,hQP,hQ,hQ.isIrrPlus.map_normalizer ρ (by rw [normalizer_eq_top]; trivial),
    hdQ,hne,?_,?_⟩
  · apply lt_of_le_of_ne (le_orbitSpan ρ S Q)
    intro he
    have hle : Q.map (ρ t) ≤ Q := by
      have hh : Q.map (ρ t) ≤ orbitSpan ρ S Q :=
        le_iSup (fun s : S => Q.map (ρ s.val)) ⟨t,ht⟩
      rwa [←he] at hh
    exact hne (Submodule.eq_of_le_of_finrank_eq hle (finrank_map_action ρ Q t))
  · intro hkQ
    exact hQ.isIrrPlus.ne_bot ρ (bot_unique (hK ▸
      hQ.isIrrPlus.le_fixedSpace_of_perfect_centralizes ρ hc hkQ))

/-- A component-faithful actor gives an actual offender on one of the two
halves, and hence an FF module on the original half. -/
theorem quasisimple_support_half_ff_or_centralizer
    (ρ : Representation (ZMod 2) H E) (X A : Subgroup H)
    [X.Normal] [IsQuasisimple X]
    (hA : IsElementaryTwo A) (hb : fixedCodim ρ A ≤ 2 * rank A)
    (P : Submodule (ZMod 2) E) (t : H) (hd : Disjoint P (P.map (ρ t)))
    (hXP : X ≤ subspaceStabilizer ρ P) (hXQ : X ≤ subspaceStabilizer ρ (P.map (ρ t)))
    (hAP : A ≤ subspaceStabilizer ρ P) (hAQ : A ≤ subspaceStabilizer ρ (P.map (ρ t)))
    (hmP : ¬ P ≤ fixedSpace ρ X) (hmQ : ¬ P.map (ρ t) ≤ fixedSpace ρ X) :
    A ⊓ centralizer (X : Set H) ≠ ⊥ ∨ IsFFModule (subspaceImageRepresentation ρ P) := by
  by_cases hk : A ⊓ centralizer (X : Set H) = ⊥
  · right
    have hkernel (R : Submodule (ZMod 2) E) (hXR : X ≤ subspaceStabilizer ρ R)
        (hm : ¬ R ≤ fixedSpace ρ X) : subspaceKernel ρ R A = ⊥ := by
      apply bot_unique
      intro a ha
      exact hk.le ⟨ha.1,subspaceKernel_le_component_centralizer ρ X R hXR hm A ha⟩
    rcases common_actor_offends_one_of_pair ρ P (P.map (ρ t)) hA hAP hAQ hd
      (hkernel P hXP hmP) (hkernel _ hXQ hmQ) hb with h | h
    · exact ⟨_,h⟩
    · exact isFFModule_of_conjugate_image ρ P t ⟨_,h⟩
  · exact Or.inl hk

omit [Finite H] in
/-- The original commuting component generates a strictly larger support
module from every selected Irr⁺ member. This is the literal orbit used in
the final D.3.10 multiplicity estimate, with its full support movement proved. -/
theorem support_seed_commuting_orbit
    (ρ : Representation (ZMod 2) H E) (X K : Subgroup H) [Group.IsPerfect K]
    (hK : fixedSpace ρ K = ⊥) (hc : K ≤ centralizer (X : Set H))
    (P R : Submodule (ZMod 2) E) (hKP : K ≤ subspaceStabilizer ρ P)
    (hRP : R ≤ P) (hR : IsIrrPlus ρ X R) :
    R < orbitSpan ρ K R ∧ orbitSpan ρ K R ≤ P ∧
      X ≤ subspaceStabilizer ρ (orbitSpan ρ K R) ∧
      subspaceCommutator ρ (orbitSpan ρ K R) X = orbitSpan ρ K R ∧
      ¬ IsIrrPlus ρ X (orbitSpan ρ K R) := by
  have hn : K ≤ normalizer (X : Set H) := hc.trans (Subgroup.centralizer_le_normalizer _)
  have hstrict : R < orbitSpan ρ K R := by
    apply lt_of_le_of_ne (le_orbitSpan ρ K R)
    intro he
    have hKR : K ≤ subspaceStabilizer ρ R := by
      rw [he]
      exact orbitSpan_invariant ρ K R
    exact hR.ne_bot ρ (bot_unique (hK ▸ hR.le_fixedSpace_of_perfect_centralizes ρ hc hKR))
  refine ⟨hstrict,orbitSpan_le ρ hRP hKP,orbitSpan_component_invariant ρ hn hR,
    orbitSpan_full_commutator ρ hn hR,?_⟩
  intro ho
  exact hstrict.ne (hR.eq_of_le ρ ho hstrict.le)

end CFSG.Quasithin.Chapter3.Section02.ChosenSource325
