module
public import CFSG.Quasithin.Chapter3.Section02.ChosenSource325.MovedExhaustionSuzukiFixedSpace
public import Theory.Representation.Suzuki.TensorExchangeBound
public import Theory.Representation.QuadraticFourGroup.Recognition.IrreducibleReduction.Section
public import Theory.Representation.BinaryOffender.SectionLinear

/-!
# Excluding exchanged Suzuki support from a starred cubic actor

A nontrivial Suzuki factor survives on an irreducible section of the group
generated by its pair and the exchanging involution. If a pair constituent
moves, its degree bounds the involution's displacement. Otherwise the
constituent fills the section, and the faithful tensor-exchange bound gives
displacement at least 3(2r+1). This argument requires neither irreducibility
of the original module nor full movement by either component.

Thompson A×B keeps the pair faithful on the fixed space of its actor
centralizer. The preceding reduced-actor estimate gives displacement at
most 2(2r+2), contradicting the lower bound for r > 0. The actual Chapter12
application proves U = W in the odd-degree natural SL₃ branch and removes
the Suzuki alternative from the original enlargement reduction.
Source: Aschbacher--Smith D.3.8--9, printed pp.199--201, used in D.3.10
and3.2.5, pp.201--204 and580; refs/quasithin.pdf.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
namespace CFSG.Quasithin.Chapter3.Section02.ChosenSource325
variable {H E : Type*} [Group H] [Finite H] [AddCommGroup E] [Module (ZMod 2) E]
  [FiniteDimensional (ZMod 2) E]

private theorem nontrivial_suzuki_pair_degree
    {J : Type*} [Group J] (r : ℕ) (hr : 0 < r)
    (e : J ≃* BenderSuzuki.MatrixGroups.SuzukiMatrixGroup r)
    (σ : Representation (ZMod 2) (J × J) E) (hn : σ.ker ≠ ⊤) :
    4 * (2*r+1) ≤ Module.finrank (ZMod 2) E := by
  let : Fact (0 < r) := ⟨hr⟩
  let : IsSimpleGroup J := e.isSimpleGroup
  let α := σ.comp (MonoidHom.inl J J)
  let β := σ.comp (MonoidHom.inr J J)
  have hfaith : Function.Injective α ∨ Function.Injective β := by
    by_cases ha : Function.Injective α
    · exact Or.inl ha
    by_cases hb : Function.Injective β
    · exact Or.inr hb
    have hα : α.ker = ⊤ := (IsSimpleGroup.eq_bot_or_eq_top_of_normal _ inferInstance).resolve_left
      (fun hz => ha ((MonoidHom.ker_eq_bot_iff α).mp hz))
    have hβ : β.ker = ⊤ := (IsSimpleGroup.eq_bot_or_eq_top_of_normal _ inferInstance).resolve_left
      (fun hz => hb ((MonoidHom.ker_eq_bot_iff β).mp hz))
    apply False.elim
    apply hn
    apply top_unique
    intro g _
    have h1 : σ (g.1,1) = 1 := hα.ge (mem_top g.1)
    have h2 : σ (1,g.2) = 1 := hβ.ge (mem_top g.2)
    change σ g = 1
    rw [show g = (g.1,1)*(1,g.2) by simp,map_mul,h1,h2,one_mul]
  rcases hfaith with hf | hf
  · exact Representation.Suzuki.finrank_ge (by omega : 1 ≤ r)
      (α.comp e.symm.toMonoidHom) (hf.comp e.symm.injective)
  · exact Representation.Suzuki.finrank_ge (by omega : 1 ≤ r)
      (β.comp e.symm.toMonoidHom) (hf.comp e.symm.injective)

omit [Finite H] [FiniteDimensional (ZMod 2) E] in
private theorem surviving_suzuki_pair_faithful
    (ρ : Representation (ZMod 2) H E) (J : Subgroup H) (hJ : IsComponent H J)
    (a : H) (han : a ∉ normalizer (J : Set H))
    (r : ℕ) (hr : 0 < r) (e : J ≃* BenderSuzuki.MatrixGroups.SuzukiMatrixGroup r)
    (hm : ¬ J ≤ ρ.ker) :
    Function.Injective (ρ.comp (J ⊔ J.map (MulAut.conj a).toMonoidHom).subtype) := by
  let K := J.map (MulAut.conj a).toMonoidHom
  let X := J ⊔ K
  have hK : IsComponent H K := hJ.map_conj a
  have hmK : ¬ K ≤ ρ.ker := by
    intro hh
    apply hm
    intro j hj
    have hj' := (inferInstance : ρ.ker.Normal).conj_mem (a*j*a⁻¹)
      (hh (mem_map_of_mem _ hj)) a⁻¹
    simpa only [inv_inv,inv_mul_cancel_left,mul_assoc,mul_inv_cancel_right,inv_mul_cancel,mul_one] using hj'
  have hCJ : ρ.ker ≤ centralizer (J : Set H) := le_centralizer_iff.mp
    (commutator_eq_bot_iff_le_centralizer.mp ((hJ.normal_dichotomy ρ.ker).resolve_left hm))
  have hCK : ρ.ker ≤ centralizer (K : Set H) := le_centralizer_iff.mp
    (commutator_eq_bot_iff_le_centralizer.mp ((hK.normal_dichotomy ρ.ker).resolve_left hmK))
  have hCX : ρ.ker ≤ centralizer (X : Set H) := le_centralizer_iff.mp
    (sup_le (le_centralizer_iff.mp hCJ) (le_centralizer_iff.mp hCK))
  let : Fact (0 < r) := ⟨hr⟩
  let : IsSimpleGroup J := e.isSimpleGroup
  let : IsQuasisimple J := hJ.2
  have hzJ : center J = ⊥ :=
    (IsSimpleGroup.eq_bot_or_eq_top_of_normal _ inferInstance).resolve_right
      (fun hh => Group.IsPerfect.not_isMulCommutative J (center_eq_top_iff.mp hh))
  obtain ⟨_,_,hzX⟩ := centerless_component_pair_coordinates J hJ hzJ a han
  apply (MonoidHom.ker_eq_bot_iff _).mp
  apply bot_unique
  intro x hx
  exact hzX.le (mem_center_iff.mpr (fun y => Subtype.ext (hCX hx y y.property)))

omit [Finite H] in
private theorem irreducible_exchanged_suzuki_displacement
    (ρ : Representation (ZMod 2) H E) (hi : ρ.IsIrreducible)
    (J : Subgroup H) (hJ : IsComponent H J)
    (a : H) (ha2 : a*a=1) (han : a ∉ normalizer (J : Set H))
    (hXN : (J ⊔ J.map (MulAut.conj a).toMonoidHom : Subgroup H).Normal)
    (hgen : (J ⊔ J.map (MulAut.conj a).toMonoidHom) ⊔ zpowers a = ⊤)
    (r : ℕ) (hr : 0 < r) (e : J ≃* BenderSuzuki.MatrixGroups.SuzukiMatrixGroup r)
    (hm : ¬ J ≤ ρ.ker) :
    3*(2*r+1) ≤ fixedCodim ρ (zpowers a) := by
  let X := J ⊔ J.map (MulAut.conj a).toMonoidHom
  let : X.Normal := hXN
  let := hi
  let := Subrepresentation.irreducible_module_nontrivial ρ
  have hfix : fixedSpace ρ X = ⊥ := by
    by_contra hn
    exact hm ((show J ≤ X from le_sup_left).trans (le_ker_of_normal_invariants_ne_bot ρ X hn))
  let : Fact (0 < r) := ⟨hr⟩
  let : IsSimpleGroup J := e.isSimpleGroup
  let : IsQuasisimple J := hJ.2
  have hzJ : center J = ⊥ :=
    (IsSimpleGroup.eq_bot_or_eq_top_of_normal _ inferInstance).resolve_right
      (fun hh => Group.IsPerfect.not_isMulCommutative J (center_eq_top_iff.mp hh))
  obtain ⟨q,hq,hqa⟩ := Representation.Suzuki.exchanged_pair_coordinates J hJ hzJ a ha2 han
  obtain ⟨I,hI⟩ := Subrepresentation.irreducible_subrepresentation_of_finite_dimensional (ρ.comp X.subtype)
  have hIn : I ≠ ⊥ := ((Subrepresentation.irreducible_iff_isAtom I).mp hI).ne_bot
  have hnon : (I.toRepresentation.comp q.toMonoidHom).ker ≠ ⊤ := by
    intro he
    apply hIn
    apply Subrepresentation.toSubmodule_injective
    apply bot_unique
    intro v hv
    apply hfix.le
    intro x
    have hx : I.toRepresentation x = 1 := by
      have hh := he.ge (mem_top (q.symm x))
      change I.toRepresentation (q (q.symm x)) = 1 at hh
      simpa only [q.apply_symm_apply] using hh
    exact congrArg Subtype.val (LinearMap.congr_fun hx (⟨v,hv⟩ : I))
  have hdeg := nontrivial_suzuki_pair_degree r hr e (I.toRepresentation.comp q.toMonoidHom) hnon
  by_cases hsmall : fixedCodim ρ (zpowers a) < Module.finrank (ZMod 2) I.toSubmodule
  · have hIa : I.toSubmodule.map (ρ a) = I.toSubmodule :=
      map_constituent_eq_self_of_displacement_lt ρ X a I hI
        (by rwa [←fixedCodim_zpowers_eq_displacement_rank])
    have hXI : X ≤ subspaceStabilizer ρ I.toSubmodule :=
      le_subspaceStabilizer ρ _ (fun x hx v hv => I.apply_mem_toSubmodule ⟨x,hx⟩ hv)
    have hAI : zpowers a ≤ subspaceStabilizer ρ I.toSubmodule :=
      zpowers_le.mpr ((subspace_map_eq_iff ρ I.toSubmodule a).mp hIa)
    have hHI : (⊤ : Subgroup H) ≤ subspaceStabilizer ρ I.toSubmodule :=
      hgen ▸ sup_le hXI hAI
    let P : Subrepresentation ρ := {
      toSubmodule := I.toSubmodule
      apply_mem_toSubmodule g v hv := (hHI (mem_top g) v).mpr hv }
    have hP : P ≠ ⊥ := fun hh => hIn (Subrepresentation.toSubmodule_injective
      (congrArg (fun Q : Subrepresentation ρ => Q.toSubmodule) hh))
    have ht : P = ⊤ := (hi.eq_bot_or_eq_top P).resolve_left hP
    have hIt : I = ⊤ := Subrepresentation.toSubmodule_injective
      (congrArg (fun Q : Subrepresentation ρ => Q.toSubmodule) ht)
    have hXirr : IsIrreducible (ρ.comp X.subtype) :=
      isSimpleOrder_iff_isAtom_top.mpr (hIt ▸ (Subrepresentation.irreducible_iff_isAtom I).mp hI)
    have hf := surviving_suzuki_pair_faithful ρ J hJ a han r hr e hm
    let σ := (ρ.comp X.subtype).comp q.toMonoidHom
    have hσ : IsIrreducible σ :=
      (irreducible_comp_surjective_iff q.toMonoidHom q.surjective (ρ.comp X.subtype)).mpr hXirr
    let p := MulEquiv.prodCongr e.symm e.symm
    let τ := σ.comp p.toMonoidHom
    have hτ : IsIrreducible τ :=
      (irreducible_comp_surjective_iff p.toMonoidHom p.surjective σ).mpr hσ
    have hτf : Function.Injective τ := (hf.comp q.injective).comp p.injective
    have hd := Representation.Suzuki.binary_square_finrank_ge r hr τ hτ hτf
    have hT2 : ρ a * ρ a = 1 := by rw [←map_mul,ha2,map_one]
    have hswap (g : J × J) (v : E) : ρ a (σ g v) = σ (g.2,g.1) (ρ a v) := by
      change ρ a (ρ (q g : H) v) = ρ (q (g.2,g.1) : H) (ρ a v)
      rw [←hqa g.1 g.2]
      simp only [←Module.End.mul_apply,←map_mul,mul_assoc,inv_mul_cancel,mul_one]
    have hb := Representation.Suzuki.binary_product_exchange_displacement_unconditional
      r hr e σ hσ (hf.comp q.injective) (ρ a) hT2 hswap
    rw [fixedCodim_zpowers_eq_displacement_rank]
    change 3*(2*r+1) ≤ Module.finrank (ZMod 2) (ρ a - 1).range
    omega
  · omega

omit [Finite H] in
private theorem generated_exchanged_suzuki_displacement
    (ρ : Representation (ZMod 2) H E)
    (J : Subgroup H) (hJ : IsComponent H J)
    (a : H) (ha2 : a*a=1) (han : a ∉ normalizer (J : Set H))
    (hXN : (J ⊔ J.map (MulAut.conj a).toMonoidHom : Subgroup H).Normal)
    (hgen : (J ⊔ J.map (MulAut.conj a).toMonoidHom) ⊔ zpowers a = ⊤)
    (r : ℕ) (hr : 0 < r) (e : J ≃* BenderSuzuki.MatrixGroups.SuzukiMatrixGroup r)
    (hm : ¬ J ≤ ρ.ker) :
    3*(2*r+1) ≤ fixedCodim ρ (zpowers a) := by
  let : IsQuasisimple J := hJ.2
  obtain ⟨U,N,hi,hn⟩ := QuadraticFourGroup.exists_irreducible_section_surviving_perfect J hm
  have hd := irreducible_exchanged_suzuki_displacement N.quotientRepresentation hi
    J hJ a ha2 han hXN hgen r hr e hn
  have hU := fixedCodim_subrepresentation_le ρ U (zpowers a)
  have hN := fixedCodim_quotient_add_subrepresentation_le U.toRepresentation N (zpowers a)
  omega


omit [Finite H] in
/-- An actual involution exchanging a Suzuki pair has large displacement on
any invariant subspace faithful for the pair. No full movement is assumed. -/
theorem exchanged_suzuki_subspace_displacement
    (ρ : Representation (ZMod 2) H E)
    (J A : Subgroup H) (hJ : IsComponent H J)
    (a : H) (ha : a ∈ A) (ha2 : a*a=1) (han : a ∉ normalizer (J : Set H))
    (hXN : (J ⊔ J.map (MulAut.conj a).toMonoidHom : Subgroup H).Normal)
    (r : ℕ) (hr : 0 < r) (e : J ≃* BenderSuzuki.MatrixGroups.SuzukiMatrixGroup r)
    (W : Submodule (ZMod 2) E)
    (hXW : (J ⊔ J.map (MulAut.conj a).toMonoidHom) ≤ subspaceStabilizer ρ W)
    (hAW : A ≤ subspaceStabilizer ρ W)
    (hk : subspaceKernel ρ W (J ⊔ J.map (MulAut.conj a).toMonoidHom) = ⊥) :
    3*(2*r+1) ≤ fixedCodim (subspaceImageRepresentation ρ W) (restrictedSubgroup ρ W A) := by
  let X := J ⊔ J.map (MulAut.conj a).toMonoidHom
  let N := X ⊔ zpowers a
  have hJN : J ≤ N := (show J ≤ X from le_sup_left).trans le_sup_left
  have haN : a ∈ N := (show zpowers a ≤ N from le_sup_right) (mem_zpowers a)
  let aa : N := ⟨a,haN⟩
  let J₀ := J.subgroupOf N
  have hJ₀ : IsComponent N J₀ := hJ.subgroupOf hJN
  have hpair : J₀ ⊔ J₀.map (MulAut.conj aa).toMonoidHom = X.subgroupOf N := by
    apply map_injective N.subtype_injective
    have hconj : (J₀.map (MulAut.conj aa).toMonoidHom).map N.subtype =
        (J₀.map N.subtype).map (MulAut.conj a).toMonoidHom := by
      rw [map_map,map_map]
      rfl
    rw [Subgroup.map_sup,hconj,map_subgroupOf_eq_of_le hJN,
      map_subgroupOf_eq_of_le (show X ≤ N from le_sup_left)]
  have hgen : (J₀ ⊔ J₀.map (MulAut.conj aa).toMonoidHom) ⊔ zpowers aa = ⊤ := by
    apply map_injective N.subtype_injective
    rw [hpair,Subgroup.map_sup,map_subgroupOf_eq_of_le (show X ≤ N from le_sup_left),
      MonoidHom.map_zpowers,←MonoidHom.range_eq_map,range_subtype]
    rfl
  have hnormal : (J₀ ⊔ J₀.map (MulAut.conj aa).toMonoidHom).Normal := by
    let : X.Normal := hXN
    rw [hpair]
    infer_instance
  have han₀ : aa ∉ normalizer (J₀ : Set N) := by
    intro hh
    apply han
    change aa ∈ (normalizer (J : Set H)).subgroupOf N
    rwa [subgroupOf_normalizer_eq hJN]
  have hNW : N ≤ subspaceStabilizer ρ W :=
    sup_le hXW (zpowers_le.mpr (hAW ha))
  let σ := (invariantSubspace ρ N W hNW).toRepresentation
  have hm : ¬ J₀ ≤ σ.ker := by
    intro hh
    let : Fact (0 < r) := ⟨hr⟩
    let : IsSimpleGroup J := e.isSimpleGroup
    have hJne : J ≠ ⊥ := (Subgroup.nontrivial_iff_ne_bot J).mp inferInstance
    apply hJne
    apply bot_unique
    intro j hj
    apply hk.le
    refine ⟨(show J ≤ X from le_sup_left) hj,?_⟩
    intro w hw
    have he : σ (⟨j,hJN hj⟩ : N) = 1 := hh hj
    exact congrArg Subtype.val (LinearMap.congr_fun he (⟨w,hw⟩ : W))
  have hd := generated_exchanged_suzuki_displacement σ J₀ hJ₀ aa
    (Subtype.ext ha2) han₀ hnormal hgen r hr ((subgroupOfEquivOfLe hJN).trans e) hm
  let f := subgroupActionHom ρ W N hNW
  have he : fixedCodim σ (zpowers aa) =
      fixedCodim (subspaceImageRepresentation ρ W) ((zpowers aa).map f) := by
    change fixedCodim ((subspaceImageRepresentation ρ W).comp f) (zpowers aa) = _
    unfold fixedCodim
    rw [fixedSpace_comp_map]
  rw [he] at hd
  apply hd.trans
  apply NaturalTensor.fixedCodim_mono
  rw [MonoidHom.map_zpowers]
  apply zpowers_le.mpr
  exact ⟨⟨a,hAW ha⟩,ha,rfl⟩

/-- The starred cubic budget excludes a genuinely exchanged Suzuki support. -/
theorem not_starred_exchanged_suzuki_support
    (ρ : Representation (ZMod 2) H E) (hf : Function.Injective ρ)
    (hcore : pCore 2 H = ⊥) (J A : Subgroup H) (hJ : IsComponent H J)
    (hindex : (normalizer (J : Set H)).index = 2)
    (a : H) (ha : a ∈ A) (han : a ∉ normalizer (J : Set H))
    (horbit : componentOrbit J A = J ⊔ J.map (MulAut.conj a).toMonoidHom)
    (hA : A ∈ CFSG.Quasithin.ChapterD.QhatStar ρ)
    (r : ℕ) (hr : 0 < r) (e : J ≃* BenderSuzuki.MatrixGroups.SuzukiMatrixGroup r) : False := by
  obtain ⟨hXN,hker,⟨hXW,_⟩,_,_,_,hbudget,_⟩ :=
    exchanged_support_fixedSpace_reduction ρ hf hcore J A hindex a ha han horbit hA r hr e
  let X := componentOrbit J A
  let B := A ⊓ centralizer (X : Set H)
  let W := fixedSpace ρ B
  have hAW : A ≤ subspaceStabilizer ρ W := fixedSpace_subactor_stabilized ρ hA.1.2.1 inf_le_left
  let : IsElementaryAbelian 2 A := hA.1.2.1.2
  have ha2 : a*a=1 := by
    simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) a ha
  have hd := exchanged_suzuki_subspace_displacement ρ J A hJ a ha ha2 han
    (horbit ▸ hXN) r hr e W (horbit ▸ hXW) hAW (horbit ▸ hker)
  change fixedCodim (subspaceImageRepresentation ρ W) (restrictedSubgroup ρ W A) ≤ 2*(2*r+2) at hbudget
  omega

end CFSG.Quasithin.Chapter3.Section02.ChosenSource325
