module
public import CFSG.Quasithin.Chapter3.Section02.ChosenSource325.MovedExhaustionLocalFF
public import CFSG.Quasithin.ChapterB.Section05.Quasisimple.SourceCompletion.RepeatedPrefixes

/-!
# The binary local ratio and the three-section obstruction

The complete corrected B.5.1 conclusion, together with the actual two
nonisomorphic simple component types, puts the subgroup generated by best
offenders in the component. This is a consequence of all four source
alternatives; the irreducible alternative is excluded using the literal
fully moved, fixed-free section.

Thompson replacement preserves every offending ratio at most one. The
B.4.9 natural-plus-dual bound therefore gives ratio strictly greater than
three quarters for every elementary actor, including the original cubic
actor without any extra quadratic assumption. Three successive copies
of the same local pair then exceed that actor's original two-rank budget.

The literal Chapter12 application is SeedAlternativesMovedExhaustionBinaryRatio.
Construction of the full filtration and the multiplicity-two centralizer
coordinates remains with qt-baumann-fsu, as does final Source325 assembly.
Source: Aschbacher--Smith D.3.9(1), printed pp.199--200, B.5.1 and
B.4.9(2)(iii)--(iv), pp.99--103,94--95; refs/quasithin.pdf.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open scoped ENNReal
namespace CFSG.Quasithin.Chapter3.Section02.ChosenSource325
open ChapterB.QuasisimpleSource

variable {H E : Type*} [Group H] [AddCommGroup E] [Module (ZMod 2) E]

/-- The irreducible source row is incompatible with the two literal
nonisomorphic simple component summands. The other rows give the whole actor. -/
theorem whole_of_source_distinct_simple_types
    (ρ : Representation (ZMod 2) H E) (K : Subgroup H)
    (c : ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion ρ K)
    (hm : moved ρ K = ⊤) (hz : fixedSpace ρ K = ⊥)
    {P F : Type*} [Group P] [AddCommGroup F] [Module (ZMod 2) F]
    (τ : Representation (ZMod 2) P F) (a : ActionEquiv τ (ρ.comp K.subtype))
    (I J : Subrepresentation τ)
    (hi : IsIrreducible I.toRepresentation) (hj : IsIrreducible J.toRepresentation)
    (hne : ¬ Nonempty (I.toRepresentation.Equiv J.toRepresentation)) : K = ⊤ := by
  cases c.clause_one with
  | doubleThree _ hwhole _ _ _ => exact hwhole
  | naturalDual _ _ hwhole _ => exact hwhole
  | repeatedNatural _ _ _ _ _ hwhole _ => exact hwhole
  | irreducible _ _ hirr _ _ =>
    let s := c.sectionData
    have hs : s.space.toSubmodule = ⊤ := s.space_eq.trans hm
    let f : s.space.toSubmodule ≃ₗ[ZMod 2] E :=
      LinearEquiv.ofBijective s.space.toSubmodule.subtype
        ⟨Subtype.val_injective,fun v => ⟨⟨v,hs ▸ Submodule.mem_top⟩,rfl⟩⟩
    let e : ActionEquiv (s.space.toRepresentation.comp K.subtype) (ρ.comp K.subtype) :=
      ⟨MulEquiv.refl K,f,fun _ _ => rfl⟩
    have hfix : Representation.invariants (s.space.toRepresentation.comp K.subtype) = ⊥ :=
      ExtensionConsequences.invariants_of_equiv e hz
    let q := ExtensionConsequences.movedQuotientEquiv s hfix
    let t : ActionEquiv (s.action.comp K.subtype) (ρ.comp K.subtype) :=
      ⟨q.groupEquiv.trans e.groupEquiv,q.linearEquiv.trans e.linearEquiv,
        fun g v => (congrArg e.linearEquiv (q.intertwines g v)).trans
          (e.intertwines (q.groupEquiv g) (q.linearEquiv v))⟩
    let b := ExtensionConsequences.actionSymm t
    let ab : ActionEquiv τ (s.action.comp K.subtype) :=
      ⟨a.groupEquiv.trans b.groupEquiv,a.linearEquiv.trans b.linearEquiv,
        fun g v => (congrArg b.linearEquiv (a.intertwines g v)).trans
          (b.intertwines (a.groupEquiv g) (a.linearEquiv v))⟩
    exact (hne (same_simple_types_of_homogeneous_chart _ _ ab
      (ExtensionConsequences.homogeneous_of_irreducible hirr) I J hi hj)).elim

/-- On two distinct simple component types, the complete earlier source
conclusion puts the offender-generated actor in the component. -/
theorem offenderSubgroup_eq_of_source_distinct_types
    (ρ : Representation (ZMod 2) H E) (K : Subgroup H)
    (hK : K ≤ offenderSubgroup ρ)
    (c : ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
      (ρ.comp (offenderSubgroup ρ).subtype) (K.subgroupOf (offenderSubgroup ρ)))
    (hm : moved ρ K = ⊤) (hz : fixedSpace ρ K = ⊥)
    {P F : Type*} [Group P] [AddCommGroup F] [Module (ZMod 2) F]
    (τ : Representation (ZMod 2) P F) (a : ActionEquiv τ (ρ.comp K.subtype))
    (I J : Subrepresentation τ)
    (hi : IsIrreducible I.toRepresentation) (hj : IsIrreducible J.toRepresentation)
    (hne : ¬ Nonempty (I.toRepresentation.Equiv J.toRepresentation)) :
    offenderSubgroup ρ = K := by
  let O := offenderSubgroup ρ
  let α := ρ.comp O.subtype
  let C := K.subgroupOf O
  let e := (subgroupOfEquivOfLe hK).symm
  let a' : ActionEquiv τ (α.comp C.subtype) :=
    ⟨a.groupEquiv.trans e,a.linearEquiv,a.intertwines⟩
  have hm' : moved α C = ⊤ := by
    change subspaceCommutator α ⊤ C = ⊤
    rw [subspaceCommutator_comp_map,map_subgroupOf_eq_of_le hK]
    exact hm
  have hz' : fixedSpace α C = ⊥ := by
    rw [fixedSpace_comp_map,map_subgroupOf_eq_of_le hK]
    exact hz
  have he := congrArg (Subgroup.map O.subtype)
    (whole_of_source_distinct_simple_types α C c hm' hz' τ a' I J hi hj hne)
  change (K.subgroupOf O).map O.subtype = (⊤ : Subgroup O).map O.subtype at he
  rw [map_subgroupOf_eq_of_le hK,←MonoidHom.range_eq_map,range_subtype] at he
  exact he.symm

/-- Keep the image coordinates abstract when identifying the actual
best-offender subgroup from the two original component types. -/
theorem image_offenderSubgroup_eq_of_source_distinct_types
    (ρ : Representation (ZMod 2) H E) (K : Subgroup H)
    (hf : Function.Injective (ρ.comp K.subtype))
    (hK : actionSubgroup ρ K ≤ offenderSubgroup (imageRepresentation ρ))
    (c : ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
      ((imageRepresentation ρ).comp (offenderSubgroup (imageRepresentation ρ)).subtype)
      ((actionSubgroup ρ K).subgroupOf (offenderSubgroup (imageRepresentation ρ))))
    (hm : moved ρ K = ⊤) (hz : fixedSpace ρ K = ⊥)
    {P F : Type*} [Group P] [AddCommGroup F] [Module (ZMod 2) F]
    (τ : Representation (ZMod 2) P F) (a : ActionEquiv τ (ρ.comp K.subtype))
    (I J : Subrepresentation τ)
    (hi : IsIrreducible I.toRepresentation) (hj : IsIrreducible J.toRepresentation)
    (hne : ¬ Nonempty (I.toRepresentation.Equiv J.toRepresentation)) :
    offenderSubgroup (imageRepresentation ρ) = actionSubgroup ρ K := by
  let q := actionHom ρ
  let C := actionSubgroup ρ K
  let δ := imageRepresentation ρ
  have hqi : Function.Injective (q.subgroupMap K) := by
    intro x y he
    apply hf
    exact congrArg (fun z : C => δ z.val) he
  let e : K ≃* C := MulEquiv.ofBijective (q.subgroupMap K) ⟨hqi,q.subgroupMap_surjective K⟩
  let b : ActionEquiv (ρ.comp K.subtype) (δ.comp C.subtype) :=
    ⟨e,LinearEquiv.refl _ _,fun _ _ => rfl⟩
  have hm' : moved δ C = ⊤ := by
    change subspaceCommutator δ ⊤ (K.map q) = ⊤
    rw [←subspaceCommutator_comp_map]
    exact hm
  have hz' : fixedSpace δ C = ⊥ := (fixedSpace_actionSubgroup ρ K).trans hz
  let ab : ActionEquiv τ (δ.comp C.subtype) := {
    groupEquiv := a.groupEquiv.trans b.groupEquiv
    linearEquiv := a.linearEquiv.trans b.linearEquiv
    intertwines g v := (congrArg b.linearEquiv (a.intertwines g v)).trans
      (b.intertwines (a.groupEquiv g) (a.linearEquiv v)) }
  exact offenderSubgroup_eq_of_source_distinct_types δ C hK c hm' hz'
    τ ab I J hi hj hne

variable [Finite H] [FiniteDimensional (ZMod 2) E]

/-- Replacement carries the mixed binary ratio bound to every elementary
actor, without requiring it to be quadratic or contained in the component. -/
theorem actionRatio_gt_three_quarters_of_binary_offenderSubgroup
    (ρ : Representation (ZMod 2) H E) (K : Subgroup H)
    (hgen : offenderSubgroup ρ = K)
    {d : ℕ} (hd : d = 4 ∨ d = 5) (hn : IsNaturalPlusDual (ρ.comp K.subtype) d)
    (A : Subgroup H) (hA : IsElementaryTwo A) :
    (3 / 4 : ℝ≥0∞) < actionRatio ρ A := by
  by_contra! hr
  have hoff : IsOffender ρ A := ⟨hA,(actionRatio_le_one_iff ρ hA).mp
    (hr.trans (by
      apply (ENNReal.toReal_le_toReal (ENNReal.div_ne_top (by norm_num) (by norm_num))
        (by norm_num)).mp
      norm_num [ENNReal.toReal_div]))⟩
  obtain ⟨B,hBA,hB,hw⟩ := exists_bestOffender_ge_weight ρ hoff
  obtain ⟨D,hD,hDB⟩ := hB.exists_minimal ρ
  have hDA : D ≤ A := hDB.1.trans hBA
  have hDK : D ≤ K := (hD.1.le_offenderSubgroup ρ).trans_eq hgen
  have hrD : actionRatio ρ D ≤ actionRatio ρ A :=
    SourceCompletion.actionRatio_le_of_weight ρ hoff hD.1.1
      (Nat.log_mono_right (Subgroup.card_le_of_le hDA)) (hw.trans_eq hDB.2.symm)
  have hDoff := (hD.1.isOffender ρ).subgroupOf ρ hDK
  have hq : IsQuadratic (ρ.comp K.subtype) (D.subgroupOf K) := by
    intro a ha b hb v
    exact hD.isQuadratic ρ a.val ha b.val hb v
  have hlo := SourceCompletion.naturalDual_ratio_gt_three_quarters
    (ρ.comp K.subtype) hd hn ⟨_,hDoff⟩
  have hle : quadraticRatio (ρ.comp K.subtype) ≤ actionRatio ρ D := by
    have hh : quadraticRatio (ρ.comp K.subtype) ≤
        actionRatio (ρ.comp K.subtype) (D.subgroupOf K) :=
      iInf_le_of_le (D.subgroupOf K) (iInf_le_of_le ⟨hDoff.1,hq⟩ le_rfl)
    simpa only [actionRatio,fixedCodim_subgroupOf ρ hDK,rank_subgroupOf hDK] using hh
  exact not_lt_of_ge (hle.trans (hrD.trans hr)) hlo

/-- The binary ratio bound in faithful-image coordinates of the original
section; the component is only identified after proving injectivity. -/
theorem image_actionRatio_gt_three_quarters_of_binary
    (ρ : Representation (ZMod 2) H E) (K : Subgroup H)
    (hf : Function.Injective (ρ.comp K.subtype))
    (hgen : offenderSubgroup (imageRepresentation ρ) = actionSubgroup ρ K)
    {d : ℕ} (hd : d = 4 ∨ d = 5) (hn : IsNaturalPlusDual (ρ.comp K.subtype) d)
    (A : Subgroup (actionImage ρ)) (hA : IsElementaryTwo A) :
    (3 / 4 : ℝ≥0∞) < actionRatio (imageRepresentation ρ) A := by
  let q := actionHom ρ
  let C := actionSubgroup ρ K
  let δ := imageRepresentation ρ
  have hqi : Function.Injective (q.subgroupMap K) := by
    intro x y he
    apply hf
    exact congrArg (fun z : C => δ z.val) he
  let e : K ≃* C := MulEquiv.ofBijective (q.subgroupMap K) ⟨hqi,q.subgroupMap_surjective K⟩
  let a : ActionEquiv (ρ.comp K.subtype) (δ.comp C.subtype) :=
    ⟨e,LinearEquiv.refl _ _,fun _ _ => rfl⟩
  obtain ⟨b⟩ := hn
  let c := ExtensionConsequences.actionSymm a
  have hn' : IsNaturalPlusDual (δ.comp C.subtype) d := ⟨{
    groupEquiv := c.groupEquiv.trans b.groupEquiv
    linearEquiv := c.linearEquiv.trans b.linearEquiv
    intertwines g v := (congrArg b.linearEquiv (c.intertwines g v)).trans
      (b.intertwines (c.groupEquiv g) (c.linearEquiv v)) }⟩
  exact actionRatio_gt_three_quarters_of_binary_offenderSubgroup δ C hgen hd hn' A hA

/-- Transfer the binary chart before specializing to an internal section. -/
theorem image_actionRatio_gt_three_quarters_of_binary_chart
    (ρ : Representation (ZMod 2) H E) (K : Subgroup H)
    {P F : Type*} [Group P] [AddCommGroup F] [Module (ZMod 2) F]
    (τ : Representation (ZMod 2) P F) (a : ActionEquiv τ (ρ.comp K.subtype))
    (hf : Function.Injective τ)
    (hgen : offenderSubgroup (imageRepresentation ρ) = actionSubgroup ρ K)
    {d : ℕ} (hd : d = 4 ∨ d = 5) (hn : IsNaturalPlusDual τ d)
    (A : Subgroup (actionImage ρ)) (hA : IsElementaryTwo A) :
    (3 / 4 : ℝ≥0∞) < actionRatio (imageRepresentation ρ) A := by
  have hfaith : Function.Injective (ρ.comp K.subtype) := by
    intro x y hxy
    apply a.groupEquiv.symm.injective
    apply hf
    apply LinearMap.ext
    intro v
    apply a.linearEquiv.injective
    rw [a.intertwines,a.intertwines,a.groupEquiv.apply_symm_apply,a.groupEquiv.apply_symm_apply]
    exact LinearMap.congr_fun hxy (a.linearEquiv v)
  obtain ⟨b⟩ := hn
  let c := ExtensionConsequences.actionSymm a
  have hn' : IsNaturalPlusDual (ρ.comp K.subtype) d := ⟨{
    groupEquiv := c.groupEquiv.trans b.groupEquiv
    linearEquiv := c.linearEquiv.trans b.linearEquiv
    intertwines g v := (congrArg b.linearEquiv (c.intertwines g v)).trans
      (b.intertwines (c.groupEquiv g) (c.linearEquiv v)) }⟩
  exact image_actionRatio_gt_three_quarters_of_binary ρ K hfaith hgen hd hn' A hA

omit [FiniteDimensional (ZMod 2) E] in
/-- Clear the original elementary actor's positive rank. -/
theorem three_mul_rank_lt_four_mul_fixedCodim
    (ρ : Representation (ZMod 2) H E) (A : Subgroup H) (hA : IsElementaryTwo A)
    (hr : (3 / 4 : ℝ≥0∞) < actionRatio ρ A) :
    3 * rank A < 4 * fixedCodim ρ A := by
  have hp : (0 : ℝ) < rank A := by exact_mod_cast hA.rank_pos
  have ha : actionRatio ρ A ≠ ⊤ := ENNReal.div_ne_top (by simp)
    (by exact_mod_cast (Nat.ne_of_gt hA.rank_pos))
  have hh := (ENNReal.toReal_lt_toReal
    (ENNReal.div_ne_top (by norm_num) (by norm_num)) ha).mpr hr
  simp only [actionRatio,ENNReal.toReal_div,ENNReal.toReal_natCast] at hh
  have hc : (3 : ℝ) * rank A < 4 * fixedCodim ρ A := by
    have h := (lt_div_iff₀ hp).mp hh
    norm_num at h
    linarith
  exact_mod_cast hc

omit [Finite H] in
/-- Three copies of the exchanged local pair cannot fit the same actor's
original two-rank budget. The copies are literal successive sections. -/
theorem no_three_equivalent_sections_of_pair_cost
    (ρ : Representation (ZMod 2) H E) (S : Subrepresentation ρ)
    (A : Subgroup H) (hbudget : fixedCodim ρ A ≤ 2 * rank A)
    (hcost : 3 * rank A < 4 * fixedCodim S.toRepresentation A)
    (B : Subrepresentation S.quotientRepresentation)
    (C : Subrepresentation B.quotientRepresentation) :
    ¬ (Nonempty (S.toRepresentation.Equiv B.toRepresentation) ∧
      Nonempty (S.toRepresentation.Equiv C.toRepresentation)) := by
  rintro ⟨⟨eB⟩,⟨eC⟩⟩
  have hb : fixedCodim B.toRepresentation A = fixedCodim S.toRepresentation A := by
    simpa only [Subgroup.map_id] using (fixedCodim_map_equivariant
      S.toRepresentation B.toRepresentation (MonoidHom.id H) eB.toLinearEquiv
      (fun g v => LinearMap.congr_fun (eB.isIntertwining' g) v) A).symm
  have hc : fixedCodim C.toRepresentation A = fixedCodim S.toRepresentation A := by
    simpa only [Subgroup.map_id] using (fixedCodim_map_equivariant
      S.toRepresentation C.toRepresentation (MonoidHom.id H) eC.toLinearEquiv
      (fun g v => LinearMap.congr_fun (eC.isIntertwining' g) v) A).symm
  have h₁ := fixedCodim_quotient_add_subrepresentation_le ρ S A
  have h₂ := fixedCodim_quotient_add_subrepresentation_le S.quotientRepresentation B A
  have h₃ := fixedCodim_subrepresentation_le B.quotientRepresentation C A
  omega

/-- Apply the three-section budget in faithful-image coordinates without
expanding those image maps in the internal-group consumer. -/
theorem no_three_equivalent_sections_of_image_ratio
    (ρ : Representation (ZMod 2) H E) (S : Subrepresentation ρ) (A : Subgroup H)
    (hA : IsElementaryTwo (actionSubgroup S.toRepresentation A))
    (hrank : rank (actionSubgroup S.toRepresentation A) = rank A)
    (hr : (3 / 4 : ℝ≥0∞) < actionRatio (imageRepresentation S.toRepresentation)
      (actionSubgroup S.toRepresentation A))
    (hb : fixedCodim ρ A ≤ 2 * rank A)
    (B : Subrepresentation S.quotientRepresentation)
    (C : Subrepresentation B.quotientRepresentation) :
    ¬ (Nonempty (S.toRepresentation.Equiv B.toRepresentation) ∧
      Nonempty (S.toRepresentation.Equiv C.toRepresentation)) := by
  have hc := three_mul_rank_lt_four_mul_fixedCodim (imageRepresentation S.toRepresentation)
    (actionSubgroup S.toRepresentation A) hA hr
  rw [fixedCodim_actionSubgroup,hrank] at hc
  exact no_three_equivalent_sections_of_pair_cost ρ S A hb hc B C

