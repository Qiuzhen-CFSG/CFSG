module
public import CFSG.Quasithin.Chapter3.Section02.ChosenSource325.MovedExhaustionCentralizer
public import Theory.Representation.BinaryOffender.IrreducibleMovedGeneration

/-!
# The proper orbit quotient and the fixed-space supplement

A normal quasisimple component generating the whole module acts nontrivially
on every proper invariant quotient. The component dichotomy therefore places
the quotient kernel in its centralizer. In particular, an actor giving a
fixed-space supplement to the subspace must centralize the component.
If the subspace kernel equals this centralizer, faithfulness rules out the
supplement for every nontrivial actor. D.2.7 then gives strict ratio decrease
for a starred actor that moves the component, without needing a separate
nontriviality proof for the component centralizer.

The actual application is `SeedAlternativesMovedExhaustionQuotient` on the
literal U = componentOrbit V (normalizer L) and W = componentOrbit V T.
This is a quotient route to the inequality used in D.3.19; it does not prove
D.3.13, D.3.18, the model exclusions, or U = W. Those obligations and final
Source325 assembly remain with qt-baumann-fsu.
Source: Aschbacher--Smith D.2.7--8 and D.3.13--19, printed pp.179--180,202--204.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open Representation.BinaryOffender.Homogeneous
open scoped IsMulCommutative ENNReal
namespace CFSG.Quasithin.Chapter3.Section02.ChosenSource325
variable {H E : Type*} [Group H] [AddCommGroup E] [Module (ZMod 2) E]
  (ρ : Representation (ZMod 2) H E)

/-- A noncentral irreducible seed spanning a normal-subgroup orbit makes the
whole module generated by component commutators. -/
theorem fully_moved_of_irreducible_orbit
    (K : Subgroup H) [K.Normal]
    (S : Subrepresentation (ρ.comp K.subtype))
    (hi : IsIrreducible S.toRepresentation)
    (hn : ¬ S.toSubmodule ≤ fixedSpace ρ K)
    (hspan : orbitSpan ρ ⊤ S.toSubmodule = ⊤) :
    subspaceCommutator ρ ⊤ K = ⊤ := by
  let Q : Subrepresentation (ρ.comp K.subtype) := {
    toSubmodule := subspaceCommutator ρ S.toSubmodule K
    apply_mem_toSubmodule := fun k v hv =>
      (subspaceCommutator_invariant ρ S.toSubmodule K k.property v).2 hv }
  have hQS : Q ≤ S := subspaceCommutator_le_of_invariant ρ
    (le_subspaceStabilizer ρ S.toSubmodule (fun k hk v hv => S.apply_mem_toSubmodule ⟨k,hk⟩ hv))
  have hQn : Q ≠ ⊥ := by
    intro hz
    apply hn
    apply (subspaceCommutator_eq_bot_iff ρ _ _).mp
    exact congrArg Subrepresentation.toSubmodule hz
  have he : Q = S := by
    by_contra hh
    exact hQn (((Subrepresentation.irreducible_iff_isAtom S).mp hi).2 Q
      (lt_of_le_of_ne hQS hh))
  have hSM : S.toSubmodule ≤ subspaceCommutator ρ ⊤ K := by
    rw [←congrArg Subrepresentation.toSubmodule he]
    exact subspaceCommutator_mono_left ρ le_top K
  have hs : (⊤ : Subgroup H) ≤ subspaceStabilizer ρ (subspaceCommutator ρ ⊤ K) :=
    subspaceCommutator_invariant_normalizer ρ
      (le_subspaceStabilizer ρ ⊤ (by intros; trivial)) (by rw [normalizer_eq_top])
  apply top_unique
  exact hspan.ge.trans (orbitSpan_le ρ hSM hs)

/-- The kernel on a proper invariant quotient centralizes the normal
quasisimple component when that component generates the whole module. -/
theorem quotient_kernel_le_component_centralizer
    (K : Subgroup H) [K.Normal] [IsQuasisimple K]
    (hfull : subspaceCommutator ρ ⊤ K = ⊤)
    (I : Submodule (ZMod 2) E) (hKI : K ≤ subspaceStabilizer ρ I)
    (hne : I ≠ ⊤) :
    ((invariantSubspace ρ (subspaceStabilizer ρ I) I le_rfl).quotientRepresentation.ker.map
      (subspaceStabilizer ρ I).subtype) ≤ centralizer (K : Set H) := by
  let B := subspaceStabilizer ρ I
  let X := K.subgroupOf B
  let σ := (invariantSubspace ρ B I le_rfl).quotientRepresentation
  let : IsQuasisimple X := IsQuasisimple.of_mulEquiv (subgroupOfEquivOfLe hKI).symm
  have hX : IsComponent B X := ⟨(inferInstance : X.Normal).isSubnormal,inferInstance⟩
  have hn : ¬ X ≤ σ.ker := by
    intro hk
    apply hne
    apply top_unique
    rw [←hfull]
    apply Submodule.span_le.mpr
    rintro _ ⟨k,hk',v,_,rfl⟩
    have hh := LinearMap.congr_fun (hk (show (⟨k,hKI hk'⟩ : B) ∈ X from hk')) (I.mkQ v)
    exact (Submodule.Quotient.eq I).mp hh
  have hc : σ.ker ≤ centralizer (X : Set B) := by
    rcases hX.normal_dichotomy σ.ker with hle | hz
    · exact (hn hle).elim
    · exact commutator_eq_bot_iff_le_centralizer.mp ((commutator_comm _ _).trans hz)
  rintro _ ⟨a,ha,rfl⟩ k hk
  exact congrArg Subtype.val (hc ha ⟨k,hKI hk⟩ hk)

/-- An actor supplying a fixed-space supplement to a proper component-invariant
subspace centralizes the component, through the literal quotient action. -/
theorem centralizes_component_of_fixed_supplement
    (K : Subgroup H) [K.Normal] [IsQuasisimple K]
    (hfull : subspaceCommutator ρ ⊤ K = ⊤)
    (I : Submodule (ZMod 2) E) (hKI : K ≤ subspaceStabilizer ρ I)
    (hne : I ≠ ⊤) (A : Subgroup H)
    (hAI : A ≤ subspaceStabilizer ρ I) (hs : I ⊔ fixedSpace ρ A = ⊤) :
    A ≤ centralizer (K : Set H) := by
  have hd := subspaceCommutator_le_of_le_sup_fixedSpace ρ hAI hs.ge
  have hk := quotient_kernel_le_component_centralizer ρ K hfull I hKI hne
  intro a ha
  apply hk
  refine ⟨⟨a,hAI ha⟩,?_,rfl⟩
  apply LinearMap.ext
  intro q
  induction q using Submodule.Quotient.induction_on with
  | _ v =>
    exact (Submodule.Quotient.eq I).mpr (hd (Submodule.subset_span ⟨a,ha,v,Submodule.mem_top,rfl⟩))


/-- If the subspace kernel is the component centralizer, a nontrivial actor
cannot supply a fixed-space supplement to a proper invariant subspace. -/
theorem no_fixed_supplement_of_component_kernel
    (hf : Function.Injective ρ)
    (K : Subgroup H) [K.Normal] [IsQuasisimple K]
    (hfull : subspaceCommutator ρ ⊤ K = ⊤)
    (I : Submodule (ZMod 2) E) (hKI : K ≤ subspaceStabilizer ρ I)
    (hne : I ≠ ⊤) (A : Subgroup H) (hA : A ≠ ⊥)
    (hAI : A ≤ subspaceStabilizer ρ I)
    (hk : subspaceKernel ρ I A = A ⊓ centralizer (K : Set H)) :
    I ⊔ fixedSpace ρ A ≠ ⊤ := by
  intro hs
  have hc := centralizes_component_of_fixed_supplement ρ K hfull I hKI hne A hAI hs
  have hi : I ≤ fixedSpace ρ A := by
    intro v hv a
    exact (hk.ge ⟨a.property,hc a.property⟩).2 v hv
  have he : fixedSpace ρ A = ⊤ := by rwa [sup_eq_right.mpr hi] at hs
  apply hA
  apply bot_unique
  intro a ha
  apply hf
  rw [map_one]
  apply LinearMap.ext
  intro v
  exact (show v ∈ fixedSpace ρ A from he.symm ▸ Submodule.mem_top) ⟨a,ha⟩

variable [Finite H] [FiniteDimensional (ZMod 2) E]
open CFSG.Quasithin.ChapterD

/-- A component-moving starred actor has strict ratio decrease on a proper
noncentral component-invariant subspace. No nontrivial kernel is assumed. -/
theorem starred_restriction_strict_of_component_quotient
    (K : Subgroup H) [K.Normal] [IsQuasisimple K]
    (hfull : subspaceCommutator ρ ⊤ K = ⊤)
    (I : Submodule (ZMod 2) E) (hKI : K ≤ subspaceStabilizer ρ I)
    (hIn : ¬ I ≤ fixedSpace ρ K) (hne : I ≠ ⊤)
    {A : Subgroup H} (hA : A ∈ QhatStar ρ)
    (hAI : A ≤ subspaceStabilizer ρ I)
    (hm : ¬ A ≤ centralizer (K : Set H)) :
    restrictedSubgroup ρ I A ∈ Qhat (subspaceImageRepresentation ρ I) ∧
      actionRatio (subspaceImageRepresentation ρ I) (restrictedSubgroup ρ I A) < cubicRatio ρ := by
  have hn : ¬ I ≤ fixedSpace ρ A := by
    intro hf
    apply hm
    intro a ha
    exact subspaceKernel_le_component_centralizer ρ K I hKI hIn A
      ⟨ha,fun v hv => hf hv ⟨a,ha⟩⟩
  rcases (QhatStar.restriction_alternatives ρ hA I hAI hn).2.2 with hr | ⟨_,hs⟩
  · exact hr
  · exact (hm (centralizes_component_of_fixed_supplement ρ K hfull I hKI hne A hAI hs)).elim
end CFSG.Quasithin.Chapter3.Section02.ChosenSource325
