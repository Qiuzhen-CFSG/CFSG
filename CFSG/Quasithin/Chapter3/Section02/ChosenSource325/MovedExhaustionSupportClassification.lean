public import CFSG.Quasithin.ChapterB.Section05.Quasisimple.SourceCompletion.FFQuasisimple

/-!
# B.5.1 on the homogeneous support orbit

The faithful kernel quotient of the literal central orbit section has trivial
two-core even when the quasisimple support has a nontrivial center. Its
component image is quasisimple. The two-core centralizes that image, and
perfectness lifts the centralizer through the section kernel. A Sylow subgroup
of the preimage maps onto the two-core. Homogeneity makes this lifted two-group
stabilize every conjugate seed; the odd linear centralizer fixes each seed,
so faithfulness kills the two-core.

The quotient by the component image is a two-group. The full known-simple
B.5.1 theorem therefore applies after restriction to the actual subgroup
generated by offenders. Its six corrected clauses are obtained without an
extra classification premise. The original support centrally covers its image
by the literal quotient map, whose coordinates are retained explicitly.

The application is `SeedAlternativesMovedExhaustionSupportClassification`.
Selecting the natural constituent from these clauses, the Suzuki and
multiplicity exclusions, and final Source325 assembly remain with
qt-baumann-fsu.
Source: Aschbacher--Smith A.1.41--42, B.5.1 and D.3.17, printed
pp.31--32,99--103,203; refs/quasithin.pdf.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open Representation.BinaryOffender.Homogeneous
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter3.Section02.ChosenSource325
variable {H E : Type*} [Group H] [Finite H] [AddCommGroup E] [Module (ZMod 2) E]
  [FiniteDimensional (ZMod 2) E]

omit [Finite H] [FiniteDimensional (ZMod 2) E] in
private theorem support_section_kernel_centralizes
    (ρ : Representation (ZMod 2) H E) (X P : Subgroup H) [IsQuasisimple X]
    (R : Submodule (ZMod 2) E) (hR : IsIrrPlusWith ρ X P R) :
    (KernelQuotient.projection (orbitSectionRepresentation ρ hR)).ker ≤
      centralizer (X.subgroupOf (X ⊔ P) : Set (X ⊔ P : Subgroup H)) := by
  let J := X ⊔ P
  let σ := orbitSectionRepresentation ρ hR
  have hk := centralSection_kernel_le_centralizer_of_not_fixed ρ X J le_sup_left
    (orbitSpan ρ P R)
    (fun hh => hR.isIrrPlus.not_le_fixedSpace ρ ((le_orbitSpan ρ P R).trans hh))
    (orbitSection_stable ρ hR.normalizes hR.isIrrPlus)
    (sup_le X.le_normalizer hR.normalizes)
  intro x hx
  have hx' : x ∈ σ.ker := by
    change KernelQuotient.projection σ x = 1 at hx
    have he := congrArg (KernelQuotient.action σ) hx
    rw [KernelQuotient.action_projection,map_one] at he
    exact he
  have hc := (hk (mem_map_of_mem J.subtype hx')).2
  exact mem_centralizer_iff.mpr (fun y hy => Subtype.ext (mem_centralizer_iff.mp hc y hy))

omit [Finite H] [FiniteDimensional (ZMod 2) E] in
private theorem support_section_component_ne_bot
    (ρ : Representation (ZMod 2) H E) (X P : Subgroup H) [IsQuasisimple X]
    (R : Submodule (ZMod 2) E) (hR : IsIrrPlusWith ρ X P R) :
    (X.subgroupOf (X ⊔ P)).map
      (KernelQuotient.projection (orbitSectionRepresentation ρ hR)) ≠ ⊥ := by
  let J := X ⊔ P
  let X₀ := X.subgroupOf J
  let : IsQuasisimple X₀ := IsQuasisimple.of_mulEquiv
    (subgroupOfEquivOfLe (show X ≤ J from le_sup_left)).symm
  let : IsSimpleGroup (X₀ ⧸ center X₀) := IsQuasisimple.simple
  let : Nontrivial X₀ := (QuotientGroup.mk'_surjective (center X₀)).nontrivial
  intro he
  have h := (map_eq_bot_iff X₀).mp he
  have hc : X₀ ≤ centralizer (X₀ : Set J) :=
    h.trans (support_section_kernel_centralizes ρ X P R hR)
  exact Group.IsPerfect.not_isMulCommutative X₀ (le_centralizer_iff_isMulCommutative.mp hc)

/-- The central orbit quotient has trivial two-core, without assuming a centerless support. -/
theorem support_section_twoCore_eq_bot
    (ρ : Representation (ZMod 2) H E) (X P : Subgroup H) [IsQuasisimple X]
    (R : Submodule (ZMod 2) E) (hR : IsIrrPlusWith ρ X P R) :
    pCore 2 (KernelQuotient.Actor (orbitSectionRepresentation ρ hR)) = ⊥ := by
  let J := X ⊔ P
  let X₀ := X.subgroupOf J
  let : X₀.Normal := (normal_subgroupOf_iff_le_normalizer
    (show X ≤ J from le_sup_left)).mpr (sup_le X.le_normalizer hR.normalizes)
  let : IsQuasisimple X₀ := IsQuasisimple.of_mulEquiv
    (subgroupOfEquivOfLe (show X ≤ J from le_sup_left)).symm
  let σ := orbitSectionRepresentation ρ hR
  let q := KernelQuotient.projection σ
  let Q := KernelQuotient.Actor σ
  let D := X₀.map q
  let : D.Normal := (inferInstance : X₀.Normal).map q (KernelQuotient.projection_surjective σ)
  let : Nontrivial D := (Subgroup.nontrivial_iff_ne_bot D).mpr
    (support_section_component_ne_bot ρ X P R hR)
  let : IsQuasisimple D := IsQuasisimple.of_surjective (q.subgroupMap X₀)
    (q.subgroupMap_surjective X₀)
  have hDO : pCore 2 Q ≤ centralizer (D : Set Q) := by
    have hD : IsComponent Q D := ⟨(inferInstance : D.Normal).isSubnormal,inferInstance⟩
    rcases hD.normal_dichotomy (pCore 2 Q) with h | h
    · let : Group.IsNilpotent D := (pCore_isPGroup.to_le h).isNilpotent
      exact (Group.IsPerfect.not_isSolvable D (IsNilpotent.to_isSolvable)).elim
    · exact le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp h)
  let N := (pCore 2 Q).comap q
  have hNC : N ≤ centralizer (X₀ : Set J) := by
    have hh := Subgroup.comap_mono (f := q) hDO
    rwa [comap_centralizer_map_eq_of_perfect q X₀
      (support_section_kernel_centralizes ρ X P R hR)] at hh
  let f : N →* pCore 2 Q := q.subgroupComap (pCore 2 Q)
  have hf : Function.Surjective f :=
    q.subgroupComap_surjective_of_surjective _ (KernelQuotient.projection_surjective σ)
  let S : Sylow 2 N := Sylow.nonempty.some
  have hSf : (S : Subgroup N).map f = ⊤ := by
    apply top_unique
    exact (show IsPGroup 2 (⊤ : Subgroup (pCore 2 Q)) from pCore_isPGroup.to_subgroup ⊤).le_sylow_of_normal
      (S.mapSurjective hf)
  let B := ((S : Subgroup N).map N.subtype).map J.subtype
  have hBJ : B ≤ J := by
    exact Subgroup.map_subtype_le _
  have hBC : B ≤ centralizer (X : Set H) := by
    rintro _ ⟨j,⟨n,hn,rfl⟩,rfl⟩
    exact mem_centralizer_iff.mpr fun x hx => congrArg Subtype.val
      (mem_centralizer_iff.mp (hNC n.property) ⟨x,(show X ≤ J from le_sup_left) hx⟩ hx)
  have hBker : ((S : Subgroup N).map N.subtype) ≤ q.ker := by
    rintro _ ⟨n,hn,rfl⟩
    apply (QuotientGroup.eq_one_iff _).mpr
    apply (actionHom_eq_one_iff σ _).mpr
    intro v
    let W := orbitSpan ρ P R
    obtain ⟨w,rfl⟩ := ((fixedSpace ρ X).comap W.subtype).mkQ_surjective v
    have hfixW : W ≤ fixedSpace ρ B := by
      apply iSup_le
      intro p
      rintro _ ⟨r,hr,rfl⟩ b
      -- Conjugates of the lifted two-group need not be itself; each centralizing
      -- two-group stabilizes every homogeneous conjugate of R.
      have hRt := hR.isIrrPlus.map_normalizer ρ (hR.normalizes p.property)
      have hstab : B ≤ subspaceStabilizer ρ (R.map (ρ p)) := by
        apply le_subspaceStabilizer
        intro b hb v hv
        have hbp : p.val⁻¹*b*p.val ∈ J ⊓ centralizer (X : Set H) := by
          refine ⟨J.mul_mem (J.mul_mem (J.inv_mem ((show P ≤ J from le_sup_right) p.property)) (hBJ hb))
            ((show P ≤ J from le_sup_right) p.property),?_⟩
          change p.val⁻¹*b*p.val ∈ centralizer (X : Set H)
          simpa only [inv_inv] using (mem_normalizer_iff.mp
            (normalizer_le_normalizer_centralizer X
              ((normalizer (X : Set H)).inv_mem (hR.normalizes p.property))) b).mp (hBC hb)
        obtain ⟨r,hr,rfl⟩ := hv
        refine ⟨ρ (p.val⁻¹*b*p.val) r,
          ((hR.centralizer_stabilizes ρ hbp) r).2 hr,?_⟩
        simp only [←Module.End.mul_apply,←map_mul]
        congr 2
        group
      exact (Homogeneous.IsIrrPlus.le_fixedSpace_of_twoGroup_centralizes ρ hRt
        ((S.isPGroup'.map N.subtype).map J.subtype) hBC hstab) ⟨r,hr,rfl⟩ b
    have hw := hfixW w.property ⟨(n : J),mem_map_of_mem J.subtype (mem_map_of_mem N.subtype hn)⟩
    exact congrArg ((fixedSpace ρ X).comap W.subtype).mkQ (Subtype.ext hw)
  apply bot_unique
  intro z hz
  have hm : (⟨z,hz⟩ : pCore 2 Q) ∈ (S : Subgroup N).map f := hSf.symm ▸ mem_top _
  obtain ⟨n,hn,he⟩ := hm
  have hnq := hBker (mem_map_of_mem N.subtype hn)
  exact mem_bot.mpr ((congrArg Subtype.val he).symm.trans hnq)

omit [Finite H] [FiniteDimensional (ZMod 2) E] in
/-- The original support centrally covers its image by the same orbit-section map. -/
def supportSectionComponentCover
    (ρ : Representation (ZMod 2) H E) (X P : Subgroup H) [IsQuasisimple X]
    (R : Submodule (ZMod 2) E) (hR : IsIrrPlusWith ρ X P R) :
    PerfectCentralCovering.Cover X ((X.subgroupOf (X ⊔ P)).map
      (KernelQuotient.projection (orbitSectionRepresentation ρ hR))) := by
  let J := X ⊔ P
  let X₀ := X.subgroupOf J
  let q := KernelQuotient.projection (orbitSectionRepresentation ρ hR)
  let e : X₀ ≃* X := subgroupOfEquivOfLe (show X ≤ J from le_sup_left)
  refine { toMonoidHom := (q.subgroupMap X₀).comp e.symm.toMonoidHom
           surjective := (q.subgroupMap_surjective X₀).comp e.symm.surjective
           isPerfect := inferInstance
           ker_le_center := ?_ }
  intro x hx
  have hk : (e.symm x : J) ∈ q.ker := congrArg Subtype.val hx
  have hc := support_section_kernel_centralizes ρ X P R hR hk
  exact mem_center_iff.mpr fun y => Subtype.ext
    (congrArg (fun z : J => z.val) (mem_centralizer_iff.mp hc (e.symm y) (e.symm y).property))

omit [Finite H] [FiniteDimensional (ZMod 2) E] in
/-- The central covering retains the original quotient projection pointwise. -/
theorem supportSectionComponentCover_apply
    (ρ : Representation (ZMod 2) H E) (X P : Subgroup H) [IsQuasisimple X]
    (R : Submodule (ZMod 2) E) (hR : IsIrrPlusWith ρ X P R) (x : X) :
    ((supportSectionComponentCover ρ X P R hR).toMonoidHom x :
      KernelQuotient.Actor (orbitSectionRepresentation ρ hR)) =
      KernelQuotient.projection (orbitSectionRepresentation ρ hR)
        (inclusion (show X ≤ X ⊔ P from le_sup_left) x) := by rfl

/-- All six B.5.1 clauses on the literal support quotient, with the original
central covering map. Naming the exact conclusion avoids repeatedly elaborating
its nested quotient and offender-subgroup instances in Chapter12. -/
@[expose] def SupportSectionClassification
    (ρ : Representation (ZMod 2) H E) {X P : Subgroup H}
    {R : Submodule (ZMod 2) E} (hR : IsIrrPlusWith ρ X P R) : Prop :=
  let σ := orbitSectionRepresentation ρ hR
  let δ := KernelQuotient.action σ
  let D := (X.subgroupOf (X ⊔ P)).map (KernelQuotient.projection σ)
  (∃ c : PerfectCentralCovering.Cover X D, ∀ x : X,
    (c.toMonoidHom x : KernelQuotient.Actor σ) =
      KernelQuotient.projection σ (inclusion (show X ≤ X ⊔ P from le_sup_left) x)) ∧
  D ≤ offenderSubgroup δ ∧
    Nonempty (ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
      (δ.comp (offenderSubgroup δ).subtype) (D.subgroupOf (offenderSubgroup δ)))

/-- B.5.1 on the literal central support orbit and its actual offender subgroup. -/
theorem support_section_classification
    (ρ : Representation (ZMod 2) H E) (X P : Subgroup H) [IsQuasisimple X]
    (hP : IsPGroup 2 P) (hsq : IsSQTK KnownSimple.IsKnownSimple X)
    (R : Submodule (ZMod 2) E) (hR : IsIrrPlusWith ρ X P R)
    (hff : IsFFModule (KernelQuotient.action (orbitSectionRepresentation ρ hR))) :
    SupportSectionClassification ρ hR := by
  let J := X ⊔ P
  let X₀ := X.subgroupOf J
  let : X₀.Normal := (normal_subgroupOf_iff_le_normalizer
    (show X ≤ J from le_sup_left)).mpr (sup_le X.le_normalizer hR.normalizes)
  let e : X₀ ≃* X := subgroupOfEquivOfLe (show X ≤ J from le_sup_left)
  let : IsQuasisimple X₀ := IsQuasisimple.of_mulEquiv e.symm
  let σ := orbitSectionRepresentation ρ hR
  let q := KernelQuotient.projection σ
  let Q := KernelQuotient.Actor σ
  let D := X₀.map q
  let : D.Normal := (inferInstance : X₀.Normal).map q (KernelQuotient.projection_surjective σ)
  let : Nontrivial D := (Subgroup.nontrivial_iff_ne_bot D).mpr
    (support_section_component_ne_bot ρ X P R hR)
  let : IsQuasisimple D := IsQuasisimple.of_surjective (q.subgroupMap X₀)
    (q.subgroupMap_surjective X₀)
  have hgen : P.subgroupOf J ⊔ X₀ = ⊤ := by
    rw [sup_comm,←subgroupOf_sup (show X ≤ J from le_sup_left)
      (show P ≤ J from le_sup_right)]
    exact subgroupOf_self _
  have hquot : IsPGroup 2 (J ⧸ X₀) :=
    quotient_isPGroup_of_sup_eq_top (P.subgroupOf J) X₀ hP.comap_subtype hgen
  have hquot' : IsPGroup 2 (Q ⧸ D) :=
    ChapterB.QuasisimpleSource.SourceCompletion.ChiefImage.component_quotient_isTwoGroup σ X₀ hquot
  have hsq' : IsSQTK KnownSimple.IsKnownSimple D :=
    ChapterB.SourceInduction.HighThreeRank.CoverCentralizer.SourceConstruction.quasisimple_section_sqtk
      (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple) hsq
      (ChapterA.Section02.IsSectionOf.of_surjective
        ((q.subgroupMap X₀).comp e.symm.toMonoidHom)
        ((q.subgroupMap_surjective X₀).comp e.symm.surjective))
  refine ⟨⟨supportSectionComponentCover ρ X P R hR,
    supportSectionComponentCover_apply ρ X P R hR⟩,?_⟩
  exact ChapterB.QuasisimpleSource.SourceCompletion.ff_quasisimple_source_conclusion
    (KernelQuotient.action σ) D hquot' (support_section_twoCore_eq_bot ρ X P R hR)
    hsq' (KernelQuotient.faithful σ) hff

