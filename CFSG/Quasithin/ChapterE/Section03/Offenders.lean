module

public import CFSG.Quasithin.ChapterE.Section03.Offenders.Basic
public import CFSG.Quasithin.ChapterE.Section03.Offenders.CoreDefs
public import CFSG.Quasithin.ChapterE.Section03.Offenders.Calculus
public import CFSG.Quasithin.ChapterE.Section03.Offenders.Core
public import CFSG.Quasithin.ChapterE.Section03.Offenders.Transport
public import Theory.GroupTheory.QuasithinBasic

/-!
# Weak-closure offenders

This module proves E.3.25–33 for the actual weak-closure minimum and
normalizers in conjugates of `V`. Empty minimizing families have value infinity;
Sylow transport realizes every finite minimum by an offender.

The fundamental inequality follows from nonnormalization and additivity of
quotient rank through the kernel of the genuine automizer action. In its
equality case, centralizer rigidity controls the dual core generated by
involution fixed points. Equality of coranks identifies that core with the
reverse normalizer, yielding a symmetric offender; the actual automizer
isomorphism transports the final rank equality. The last result assembles
all four fixed-space and centralizer conclusions of E.3.33.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), E.3.22–33,
printed pp. 236–238 (PDF pp. 247–249).
-/

public section
namespace CFSG.Quasithin.ChapterE
open Subgroup Representation.BinaryOffender
open scoped IsMulCommutative
variable {G : Type*} [Group G] [Finite G]

/-- Aschbacher–Smith E.3.28, all four clauses. -/
theorem lemma_E_3_28
    {V : Subgroup G} [IsElementaryAbelian 2 V] {T : Sylow 2 G}
    (hT : HypothesisE322 V T) (h24 : HypothesisE324 V T) {g : G}
    (h : IsWOffenderAt V T g) :
    globalR V ≤ (subgroupCorank (V.map (MulAut.conj g).toMonoidHom)
      (offenderNormalizer V g ⊓ centralizer (V : Set G)) : ℕ∞) ∧
    (globalR V ≤ globalW V T +
      (rank (inducedAutomizer V (offenderNormalizer V g)) : ℕ∞) ∧
      globalW V T + (rank (inducedAutomizer V (offenderNormalizer V g)) : ℕ∞) ≤
        globalW V T + (primeRank 2 (Automizer V) : ℕ∞)) ∧
    globalR V - globalW V T ≤
      (rank (inducedAutomizer V (offenderNormalizer V g)) : ℕ∞) ∧
    (¬ V ≤ normalizer (V.map (MulAut.conj g).toMonoidHom : Set G)) ∧
    (0 < globalW V T →
      ¬ V.map (MulAut.conj g).toMonoidHom ≤ normalizer (V : Set G)) := by
  obtain ⟨hn, hp⟩ := lemma_E_3_28_4 hT h24 h
  obtain ⟨hc, hi, hu, hl⟩ := offender_inequalities_of_not_normalizes h hn
  exact ⟨hc, ⟨hi, hu⟩, hl, hn, hp⟩

/-- E.3.29, the fundamental weak closure inequality. The infinite minimum
case is automatic; a finite minimum is realized by an actual offender. -/
theorem lemma_E_3_29
    {V : Subgroup G} [IsElementaryAbelian 2 V] {T : Sylow 2 G}
    (hT : HypothesisE322 V T) (h24 : HypothesisE324 V T) :
    globalR V ≤ (primeRank 2 (Automizer V) : ℕ∞) + globalW V T := by
  by_cases hw : globalW V T = ⊤
  · simp [hw]
  · obtain ⟨g, hg⟩ := exists_isWOffenderAt_of_globalW_ne_top hT hw
    have h28 := (lemma_E_3_28 hT h24 hg).2.1
    simpa only [add_comm] using h28.1.trans h28.2

/-- Equal coranks of nested subspaces imply equality of those subspaces. -/
private theorem offender_eq_of_corank_eq {V A B : Subgroup G}
    [IsElementaryAbelian 2 V] (hAB : A ≤ B) (hBV : B ≤ V)
    (hc : subgroupCorank V A = subgroupCorank V B) : A = B := by
  let _ : IsElementaryAbelian 2 B := offender_elementary_of_le hBV
  have hadd := offender_corank_add hAB hBV
  rw [hc] at hadd
  exact subgroup_eq_of_corank_zero hAB (by omega)

/-- Aschbacher–Smith E.3.31: equality in the fundamental inequality gives
normalizer control by involution fixed points and, at equal corank, the full
symmetric offender and its maximal automizer rank. -/
theorem lemma_E_3_31
    {V : Subgroup G} [IsElementaryAbelian 2 V] {T : Sylow 2 G}
    (hT : HypothesisE322 V T) (h24 : HypothesisE324 V T) {g : G}
    (h : IsWOffenderAt V T g)
    (heq : globalR V = globalW V T + (primeRank 2 (Automizer V) : ℕ∞)) :
    let Vg := V.map (MulAut.conj g).toMonoidHom
    let A := offenderNormalizer V g
    let I := inducedAutomizer V A
    let W := automizerDualCore V I (rank I - 1)
    (rank I = primeRank 2 (Automizer V) ∧
      globalR V = (subgroupCorank Vg (A ⊓ centralizer (V : Set G)) : ℕ∞) ∧
      W ≤ V ⊓ normalizer (Vg : Set G)) ∧
    (globalW V T ≤ (subgroupCorank V W : ℕ∞) ∧
      ((subgroupCorank V W : ℕ∞) = globalW V T →
        0 < globalW V T ∧ W = V ⊓ normalizer (Vg : Set G) ∧
        IsWOffender Vg (g • T : Sylow 2 G) W ∧
        rank (inducedAutomizer Vg W) = primeRank 2 (Automizer V))) := by
  dsimp only
  let Vg := V.map (MulAut.conj g).toMonoidHom
  let I := inducedAutomizer V (offenderNormalizer V g)
  let W := automizerDualCore V I (rank I - 1)
  let B := V ⊓ normalizer (Vg : Set G)
  let _ : IsElementaryAbelian 2 Vg := IsElementaryAbelian.map _
  have hn := (lemma_E_3_28_4 hT h24 h).1
  obtain ⟨hI, hr⟩ := offender_ranks_of_fundamental_equality h hn heq
  have hqpos := automizer_primeRank_pos_of_globalW_ne_top hT h.globalW_ne_top
  have hIpos : 0 < rank I := by dsimp only [I]; omega
  have heqI : globalR V = globalW V T + (rank I : ℕ∞) := by
    dsimp only [I]
    rw [hI]
    exact heq
  have hWB : W ≤ B := offender_dualCore_le_of_rank_equality h hIpos heqI
  have hwr : globalW V T < globalR V := by
    rw [heqI, h.2]
    exact_mod_cast (show subgroupCorank Vg (offenderNormalizer V g) <
      subgroupCorank Vg (offenderNormalizer V g) + rank I by omega)
  have hwB : globalW V T ≤ (subgroupCorank V B : ℕ∞) :=
    h.le_reverse_normalizer_corank hT hwr
  have hcor : subgroupCorank V B ≤ subgroupCorank V W := by
    have hadd := offender_corank_add hWB (show B ≤ V from inf_le_left)
    omega
  refine ⟨⟨hI, hr, hWB⟩, hwB.trans (by exact_mod_cast hcor), ?_⟩
  intro heW
  have hWB_eq : W = B := by
    apply offender_eq_of_corank_eq hWB inf_le_left
    have hback : subgroupCorank V W ≤ subgroupCorank V B := by
      exact_mod_cast (heW.trans_le hwB)
    omega
  have hwpos : 0 < globalW V T := by
    apply pos_iff_ne_zero.mpr
    intro hz
    have hcor0 : subgroupCorank V W = 0 := by exact_mod_cast (heW.trans hz)
    have hWV := subgroup_eq_of_corank_zero (hWB.trans inf_le_left) hcor0
    have hWN : W ≤ normalizer (Vg : Set G) := hWB.trans inf_le_right
    rw [hWV] at hWN
    exact hn hWN
  have hinv : Vg.map (MulAut.conj g⁻¹).toMonoidHom = V :=
    offender_map_conj_inverse V g
  have hNB : offenderNormalizer Vg g⁻¹ = B := by
    dsimp only [offenderNormalizer]
    rw [hinv]
  have hwconj : globalW Vg (g • T : Sylow 2 G) = globalW V T :=
    globalW_conj V T g
  have hrev : IsWOffenderAt Vg (g • T : Sylow 2 G) g⁻¹ := by
    constructor
    · rw [hinv, Subgroup.commutator_comm]
      exact h.1
    · rw [hinv, hNB, hwconj, ← hWB_eq]
      exact heW.symm
  have hqconj : primeRank 2 (Automizer Vg) = primeRank 2 (Automizer V) :=
    (Theory.GroupTheory.primeRank_equiv 2 (automizerMapEquiv V (MulAut.conj g))).symm
  have heqrev : globalR Vg = globalW Vg (g • T : Sylow 2 G) +
      (primeRank 2 (Automizer Vg) : ℕ∞) := by
    rw [globalR_map_equiv, hwconj, hqconj]
    exact heq
  have h24rev : HypothesisE324 Vg (g • T : Sylow 2 G) :=
    Or.inl (hwconj ▸ hwpos)
  have hnrev := (lemma_E_3_28_4 (hT.conj g) h24rev hrev).1
  have hIrev := (offender_ranks_of_fundamental_equality hrev hnrev heqrev).1
  refine ⟨hwpos, hWB_eq, ⟨g⁻¹, hWB_eq.trans hNB.symm, hrev⟩, ?_⟩
  change rank (inducedAutomizer Vg W) = _
  rw [hWB_eq, ← hNB, hIrev, hqconj]

/-- Aschbacher–Smith E.3.33, including properness, the escaping centralizer,
the global corank bound, and both positive automizer-rank bounds. -/
theorem lemma_E_3_33
    {V : Subgroup G} [IsElementaryAbelian 2 V] {T : Sylow 2 G}
    (hT : HypothesisE322 V T) {g : G} (h : IsWOffenderAt V T g)
    (hw : 0 < globalW V T) (hs : globalW V T < globalS V) :
    let Vg := V.map (MulAut.conj g).toMonoidHom
    let A := offenderNormalizer V g
    let U := V ⊓ centralizer (A : Set G)
    (U = V ⊓ centralizer (Vg : Set G) ∧ U < V) ∧
    (V < V ⊔ Vg ∧ V ⊔ Vg ≤ centralizer (U : Set G) ∧
      ¬ centralizer (U : Set G) ≤ normalizer (V : Set G)) ∧
    globalR V ≤ (subgroupCorank V U : ℕ∞) ∧
    (inducedAutomizer V A ∈ fixedSpaceFamily (automizerRepresentation V)
      ((globalS V).toNat - (globalW V T).toNat) ∧
      (globalS V).toNat - (globalW V T).toNat ≤ rank (inducedAutomizer V A) ∧
      1 ≤ (globalS V).toNat - (globalW V T).toNat) := by
  have hn := (lemma_E_3_28_4 hT (Or.inl hw) h).2 hw
  obtain ⟨hc, hu, hv, hgen, hesc, hr⟩ :=
    offender_configuration_of_not_normalizes h hs hn
  obtain ⟨hl, hp⟩ := offender_rank_lower_of_lt_globalS h hs
  exact ⟨⟨hc, hu⟩, ⟨hv, hgen, hesc⟩, hr,
    (offender_fixedSpaceFamily_of_lt_globalS h hs).2, hl, hp⟩

end CFSG.Quasithin.ChapterE
