module

public import CFSG.Quasithin.ChapterE.Section03.Offenders.Core.Lifting
public import CFSG.Quasithin.ChapterE.Section03.Offenders.CoreDefs
public import CFSG.Quasithin.ChapterE.Section03.Offenders.Calculus

/-!
# Dual-core normalizer control

Lift subgroups of the induced automizer to inverse images in the offender.
Corank additivity and centralizer rigidity below `r` put every generating
fixed subgroup into the relative normalizer of the conjugate. This proves
E.3.32 and the core-containment step of E.3.31. At rank minus one, the core
is precisely generated by the fixed subgroups of involutions.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), E.3.30–32,
printed pp. 237–238. E.3.31's numerical premises and remaining conclusions
are supplied by its assembly owner.
-/

public section
namespace CFSG.Quasithin.ChapterE
open Subgroup Representation.BinaryOffender
open scoped IsMulCommutative
variable {G : Type*} [Group G]

/-- The ambient image of the fixed subgroup is exactly the relative centralizer. -/
theorem core_actionCentralizer_map {V B : Subgroup G}
    (hB : B ≤ normalizer (V : Set G))
    (I : Subgroup (Automizer V)) (X : Subgroup I)
    (hX : inducedAutomizer V B = X.map I.subtype) :
    (actionCentralizer ((Automizer V).subtype.comp I.subtype) X).map V.subtype =
      V ⊓ centralizer (B : Set G) := by
  ext v
  constructor
  · rintro ⟨u, hu, rfl⟩
    exact ⟨u.property, (core_fixed_iff_centralizer hB I X hX u).mp hu⟩
  · rintro ⟨hv, hc⟩
    exact ⟨⟨v, hv⟩, (core_fixed_iff_centralizer hB I X hX ⟨v, hv⟩).mpr hc, rfl⟩


/-- For a nontrivial finite elementary abelian two-group, the core at rank minus
one is exactly the subgroup generated by fixed points of involutions. -/
theorem dualGeneratedCore_eq_involution_fixed {P H : Type*} [Group P] [Group H]
    [Finite P] [IsElementaryAbelian 2 P] (ρ : P →* MulAut H)
    (hpos : 0 < Nat.log 2 (Nat.card P)) :
    dualGeneratedCore ρ (Nat.log 2 (Nat.card P) - 1) =
      ⨆ (p : P) (_ : orderOf p = 2), actionCentralizer ρ (zpowers p) := by
  apply le_antisymm
  · apply dualGeneratedCore_le
    intro X hX
    have hne : X ≠ ⊥ := by
      intro he
      rw [he, Subgroup.index_bot] at hX
      omega
    obtain ⟨p, hp⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hne
    have hp' : (p : P) ≠ 1 := by
      intro he
      exact hp (Subtype.ext he)
    have ho : orderOf (p : P) = 2 := orderOf_eq_prime
      (Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
        (IsElementaryAbelian.exponent_dvd_p 2 P) p) hp'
    apply le_iSup_of_le (p : P)
    apply le_iSup_of_le ho
    intro v hv x hx
    exact hv x ((Subgroup.zpowers_le.mpr p.property) hx)
  · apply iSup_le
    intro p
    apply iSup_le
    intro hp
    apply actionCentralizer_le_dualGeneratedCore
    have hc := (zpowers p).index_mul_card
    rw [Nat.card_zpowers, hp] at hc
    have hl := congrArg (Nat.log 2) hc
    rw [Nat.log_mul_base (by decide) (Subgroup.index_ne_zero_of_finite)] at hl
    omega

variable [Finite G]

/-- Every generator of the dual core lifts to a subgroup of the conjugate of
corank below `r`; its centralizer therefore normalizes that conjugate. -/
theorem automizerDualCore_le_conjugate_normalizer {V : Subgroup G}
    [IsElementaryAbelian 2 V] (g : G) (k : ℕ)
    (hk : (subgroupCorank (V.map (MulAut.conj g).toMonoidHom)
      (offenderNormalizer V g) + k : ℕ∞) < globalR V) :
    automizerDualCore V (inducedAutomizer V (offenderNormalizer V g)) k ≤
      V ⊓ normalizer (V.map (MulAut.conj g).toMonoidHom : Set G) := by
  let W := V.map (MulAut.conj g).toMonoidHom
  let A := offenderNormalizer V g
  let I := inducedAutomizer V A
  let _ : IsElementaryAbelian 2 W := IsElementaryAbelian.map _
  have hAN : A ≤ normalizer (V : Set G) := inf_le_right
  have hAW : A ≤ W := inf_le_left
  apply Subgroup.map_le_iff_le_comap.mpr
  apply dualGeneratedCore_le
  intro X hX
  obtain ⟨B, hBA, hBI, hcor⟩ := core_lift_induced_subgroup hAN X
  have hBW : B ≤ W := hBA.trans hAW
  have hbound : (subgroupCorank W B : ℕ∞) < globalR W := by
    rw [offender_corank_add hBA hAW, hcor, globalR_map_equiv]
    exact lt_of_le_of_lt (by exact_mod_cast Nat.add_le_add_left hX (subgroupCorank W A)) hk
  have hrig := centralizer_le_normalizer_of_corank_lt_globalR hBW hbound
  apply Subgroup.map_le_iff_le_comap.mp
  rw [core_actionCentralizer_map (hBA.trans hAN) I X hBI]
  exact inf_le_inf_left V hrig

/-- Aschbacher–Smith E.3.32. An offender with `w < r` controls the dual core
at `r - w - 1`, without Hypothesis E.3.24. Both parameters are finite here. -/
theorem lemma_E_3_32 {V T : Subgroup G} [IsElementaryAbelian 2 V]
    {g : G} (h : IsWOffenderAt V T g) (hwr : globalW V T < globalR V) :
    automizerDualCore V (inducedAutomizer V (offenderNormalizer V g))
      ((globalR V).toNat - (globalW V T).toNat - 1) ≤
      V ⊓ normalizer (V.map (MulAut.conj g).toMonoidHom : Set G) := by
  apply automizerDualCore_le_conjugate_normalizer
  have hr := globalR_ne_top_of_noncentralizing_conjugate g h.1
  have hwr' : (globalW V T).toNat < (globalR V).toNat :=
    by
      rw [← ENat.natCast_toNat h.globalW_ne_top, ← ENat.natCast_toNat hr] at hwr
      exact_mod_cast hwr
  rw [h.2, ENat.toNat_natCast] at hwr' ⊢
  rw [← ENat.natCast_toNat hr]
  exact_mod_cast (show subgroupCorank (V.map (MulAut.conj g).toMonoidHom)
      (offenderNormalizer V g) + ((globalR V).toNat -
      subgroupCorank (V.map (MulAut.conj g).toMonoidHom) (offenderNormalizer V g) - 1)
      < (globalR V).toNat by omega)

/-- The core-containment step of E.3.31. Its assembly owner supplies positive
image rank and the equality `r = w + m(Aut_A(V))`. -/
theorem offender_dualCore_le_of_rank_equality {V T : Subgroup G}
    [IsElementaryAbelian 2 V] {g : G} (h : IsWOffenderAt V T g)
    (hpos : 0 < rank (inducedAutomizer V (offenderNormalizer V g)))
    (heq : globalR V = globalW V T +
      (rank (inducedAutomizer V (offenderNormalizer V g)) : ℕ∞)) :
    automizerDualCore V (inducedAutomizer V (offenderNormalizer V g))
      (rank (inducedAutomizer V (offenderNormalizer V g)) - 1) ≤
      V ⊓ normalizer (V.map (MulAut.conj g).toMonoidHom : Set G) := by
  apply automizerDualCore_le_conjugate_normalizer
  rw [heq, h.2]
  exact_mod_cast (show subgroupCorank (V.map (MulAut.conj g).toMonoidHom)
      (offenderNormalizer V g) + (rank (inducedAutomizer V (offenderNormalizer V g)) - 1) <
      subgroupCorank (V.map (MulAut.conj g).toMonoidHom) (offenderNormalizer V g) +
      rank (inducedAutomizer V (offenderNormalizer V g)) by omega)

end CFSG.Quasithin.ChapterE
