module
public import CFSG.Quasithin.ChapterE.Section02.ThompsonAction.QuasisimpleWhole
public import CFSG.Quasithin.ChapterE.Section02.ThompsonAction.QuasisimpleFiveWhole
public import CFSG.Quasithin.ChapterE.Section02.ThompsonAction.CompleteSource
public import CFSG.Quasithin.ChapterE.Section02.ThompsonAction.Solvable
/-!
# The global Thompson image from the original source hypotheses

The full known-simple action classification selects the genuine solvable,
quasisimple or exchanged-pair action. In every case the literal image of
J(G) is exactly the subgroup generated by the actual best offenders.
The factor decompositions and natural modules thus describe the original
Thompson image, with no recognition, earlier-classification or image premise.

Source: Aschbacher–Smith E.2.3(1), printed pp.216–217.
-/
public section
open Subgroup Stellmacher Theory.GroupTheory Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterE.ThompsonAction
open ChapterB ChapterB.QuasisimpleSource ChapterB.SourceInduction
universe u
variable {G : Type u} [Group G] [Finite G]

theorem source_global_thompson_image
    (hG : IsSQTK KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hP : IsMinimalParabolicOver T ⊤)
    (U : Subgroup G) (hU : IsPReduced 2 U)
    (hJ : ¬ elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (U : Set G)) :
    letI := hU.normal
    letI := hU.elementary
    let C := centralizer (U : Set G)
    let q := QuotientGroup.mk' C
    (elementaryAbelianMaxJ (⊤ : Subgroup G)).map q =
      offenderSubgroup (NormalElementaryQuotient.representation U q
        (QuotientGroup.mk'_surjective C) (QuotientGroup.ker_mk' C)) := by
  let := hU.normal
  let := hU.elementary
  let C := centralizer (U : Set G)
  let q := QuotientGroup.mk' C
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective C
  have hk : q.ker = centralizer (U : Set G) := QuotientGroup.ker_mk' C
  let α := NormalElementaryQuotient.representation U q hq hk
  by_cases hs : Group.IsSolvable G
  · let := hs
    obtain ⟨d,_,himg,_⟩ := source_solvable_factors T hP U hU hJ
      (hG.stronglyQuasithin 3 (by decide) (by decide)) inferInstance
    exact himg
  · rcases source_nonsolvable_natural_factors hG T hP U hU hs hJ with
      ⟨hqs,c,hlin|hfive⟩ | ⟨d,_,_⟩
    · obtain ⟨F,hF⟩ := hlin
      exact (quasisimple_linear_whole_source T hP U hU hJ q hq hk hqs c.sectionData F hF).1
    · obtain ⟨e⟩ := hfive
      exact (quasisimple_five_global_thompson_image T hP U hU hJ q hq hk hqs c.sectionData e).1
    · let := offenderSubgroup_normal α
      have hcore : pCore 2 (G ⧸ C) = ⊥ := hU.quotient_pCore_eq_bot
      have hn : q.ker ≠ ⊤ := by
        intro he
        exact hJ (hk ▸ (he ▸ (le_top : elementaryAbelianMaxJ (T:Subgroup G) ≤ ⊤)))
      have hp := (minimalParabolic_reduced_image T hP q hq hcore hn).2
      have hff : IsFFModule α := by
        obtain hf | ⟨_,hff,_,_,_⟩ := lemma_B_2_7 U q hq hk T
        · exact (hJ ((elementaryAbelianMaxJ_sylow_le_top T).trans hf.1)).elim
        · exact hff
      obtain ⟨t,ht₁,ht₂,hmodel⟩ := source_offender_two_factor_shared_natural
        α (T.mapSurjective hq) hp hff hcore d
      rcases hmodel with hlin | hsym
      · obtain ⟨F,⟨c⟩⟩ := hlin
        exact paired_linear_global_thompson_image T hP U hU hJ q hq hk d F c ⟨t,ht₁,ht₂⟩
      · obtain ⟨c⟩ := hsym
        exact paired_symmetric_global_thompson_image T hP U hU hJ q hq hk d c ⟨t,ht₁,ht₂⟩
end CFSG.Quasithin.ChapterE.ThompsonAction
