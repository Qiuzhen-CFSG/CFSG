/-!
# Thompson commutators in the solvable orbit-centralizer residual

Assume the original reduced action moves the elementary Thompson subgroup,
the ambient three-rank is at most two, and the residual of the two-core
quotient has one of the cubic E.2.1 models. Then the canonical residual
`X = O²(C_G(U))` satisfies `X = [X,J(T)]`.

E.2.3 identifies the action kernel with the minimal-parabolic core. If X is
nontrivial, the cyclic and elementary residual models have trivial Frattini
subgroup and are excluded. In the extraspecial order-27 case, the kernel
image is the cubic center. Its Sylow centralizer is cyclic of order four,
whereas the actual paired Thompson image has order four and is generated
by involutions. Hence the Thompson image moves the cubic center. Prime-order
commutator generation lifts through O₂(G) using two-perfectness of X.

The cubic residual models and solvability are explicit earlier inputs. This
module does not infer the E.2.1 escape hypothesis from reducedness alone.
Source: Aschbacher--Smith 6.1.5, printed p.666; B.6.8 and E.2.3.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher Representation Representation.BinaryOffender
open scoped IsMulCommutative

namespace CFSG.Quasithin.ChapterE.ThompsonAction
variable {G D : Type*} [Group G] [Finite G] [Group D] [Finite D]

omit [Finite G] [Finite D] in
private theorem cyclic_thompson_image_card_le_two (S : Subgroup G) (f : G →* D)
    (hc : IsCyclic ((elementaryAbelianMaxJ S).map f)) :
    Nat.card ((elementaryAbelianMaxJ S).map f) ≤ 2 := by
  let I := (elementaryAbelianMaxJ S).map f
  let := hc
  have hle : I ≤ omegaOneCenterAmbient I := by
    apply map_le_iff_le_comap.mpr
    apply sSup_le
    intro A hA a ha
    apply (mem_omegaOneCenterAmbient_iff I (f a)).mpr
    have hm : f a ∈ I := mem_map_of_mem f (le_sSup hA ha)
    let := hA.2.1
    refine ⟨hm,?_,?_⟩
    · rw [← map_pow,elemPow_eq_one_of_isElementaryAbelian (p := 2) a ha,map_one]
    · intro x hx
      exact congrArg I.subtype (mul_comm (⟨x,hx⟩ : I) ⟨f a,hm⟩)
  let : IsElementaryAbelian 2 (omegaOneCenterAmbient I) :=
    omegaOneCenterAmbient_elementaryAbelian I
  let : IsElementaryAbelian 2 I :=
    IsElementaryAbelian.of_injective (inclusion hle) (inclusion_injective hle)
  apply Nat.le_of_dvd (by decide : 0 < 2)
  rw [← IsCyclic.exponent_eq_card]
  exact IsElementaryAbelian.exponent_dvd_p 2 I

private theorem paired_thompson_image_card
    (T : Sylow 2 G) (U : Subgroup G) [U.Normal] [IsElementaryAbelian 2 U]
    (q : G →* D) (hq : Function.Surjective q)
    (hk : q.ker = centralizer (U : Set G))
    (d : ChapterB.ThreeConjugates.SolvableFFStructure
      (NormalElementaryQuotient.representation U q hq hk))
    (hc : d.count = 2)
    (himage : (elementaryAbelianMaxJ (T : Subgroup G)).map q =
      (T : Subgroup G).map q ⊓ offenderSubgroup
        (NormalElementaryQuotient.representation U q hq hk)) :
    Nat.card ((elementaryAbelianMaxJ (T : Subgroup G)).map q) = 4 := by
  let ρ := NormalElementaryQuotient.representation U q hq hk
  let L := offenderSubgroup ρ
  let := offenderSubgroup_normal ρ
  obtain ⟨P,hP⟩ := (T.mapSurjective hq).exists_sylow_map_eq_inf_of_normal L
  change (P : Subgroup L).map L.subtype = (T : Subgroup G).map q ⊓ L at hP
  rw [himage,←hP,card_map_of_injective L.subtype_injective,P.card_eq_multiplicity]
  have hL : Nat.card L = 36 := by
    simpa [L,ρ,hc] using d.toSolvableFFFactors.offenderSubgroup_card
  rw [hL]
  decide +kernel

end CFSG.Quasithin.ChapterE.ThompsonAction

namespace CFSG.Quasithin.ChapterE.ThompsonAction
variable {G : Type*} [Group G] [Finite G]

/-- The literal centralizer residual is generated by its Thompson commutators. -/
theorem source_centralizer_residual_commutator_of_cubic_models
    (T : Sylow 2 G) (hP : ChapterB.IsMinimalParabolicOver T ⊤)
    (U : Subgroup G) (hU : IsPReduced 2 U)
    (hJ : ¬ elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (U : Set G))
    (hrank : primeRank 3 G ≤ 2) (hs : Group.IsSolvable G)
    (hmodels : SolvableMinimalParabolic.CubicResidualModels G) :
    let C := centralizer (U : Set G)
    let X := (pResidual 2 C).map C.subtype
    X = ⁅X,elementaryAbelianMaxJ (T : Subgroup G)⁆ := by
  let := hU.normal
  let := hU.elementary
  let := hs
  let C := centralizer (U : Set G)
  let X := (pResidual 2 C).map C.subtype
  let Q := pCore 2 G
  let J := elementaryAbelianMaxJ (T : Subgroup G)
  have hQC : Q ≤ C := le_centralizer_iff.mp hU.le_centralizer_pCore
  have hCnormal : C.Normal := by
    apply normalizer_eq_top_iff.mp
    apply top_unique
    exact (le_normalizer_of_normal : (⊤ : Subgroup G) ≤ normalizer (U : Set G)).trans
      (normalizer_le_normalizer_centralizer U)
  let := hCnormal
  by_cases hX : X = ⊥
  · change X = ⁅X,J⁆
    rw [hX,commutator_bot_left]
  let q := QuotientGroup.mk' C
  let hq := QuotientGroup.mk'_surjective C
  let hk := QuotientGroup.ker_mk' C
  let ρ := NormalElementaryQuotient.representation U q hq hk
  have hcore : pCore 2 (G ⧸ C) = ⊥ := hU.quotient_pCore_eq_bot
  have hqne : q.ker ≠ ⊤ := by
    rw [hk]
    exact fun he => hJ (le_top.trans_eq he.symm)
  have hsmall := source_solvable_whole_actor T hP U hU hJ hrank inferInstance
  let : IsElementaryAbelian 3 (pResidual 2 (G ⧸ C)) :=
    hsmall.wreath.residual_elementary
  have hC : ChapterB.minimalParabolicCore T hP = C :=
    (ChapterB.minimalParabolic_core_eq_kernel_of_elementary_residual
      T hP q hq hcore hqne inferInstance (p := 3)).trans hk
  have hresne : pResidual 2 (ChapterB.minimalParabolicCore T hP) ≠ ⊥ := by
    rw [hC]
    exact fun he => hX (by change (pResidual 2 C).map C.subtype = ⊥; rw [he,Subgroup.map_bot])
  let π := QuotientGroup.mk' Q
  let hπ := QuotientGroup.mk'_surjective Q
  let P := pResidual 2 (G ⧸ Q)
  let Z := (center P).map P.subtype
  obtain ⟨hPcard,hPextra,_,hZeq⟩ :=
    SolvableMinimalParabolic.extraspecial_of_cubicModels_and_core_residual
      T hP hs hmodels hresne
  let := hPextra
  have hCimage : C.map π = Z := by
    rw [←hC]
    exact hZeq
  have hZcard : Nat.card Z = 3 := by
    rw [card_map_of_injective P.subtype_injective,IsExtraspecial.center_order_p 3 P]
  have hZthree : IsPGroup 3 Z := IsPGroup.of_card (n := 1) (by simpa using hZcard)
  have hXimage : X.map π = Z := by
    rw [map_embedded_pResidual,hCimage]
    have ht : pResidual 2 Z = ⊤ := by
      apply top_unique
      intro z _
      exact mem_pResidual_of_orderOf_coprime
        ((hZthree.orderOf_coprime (by decide : Nat.Coprime 3 2) z).symm)
    rw [ht,←MonoidHom.range_eq_map,range_subtype]
  let f : (G ⧸ Q) →* (G ⧸ C) := QuotientGroup.lift Q q (by
    rwa [hk])
  have hf : Function.Surjective f := by
    intro y
    obtain ⟨x,rfl⟩ := hq y
    exact ⟨π x,rfl⟩
  have hcomp : f.comp π = q := rfl
  have hker : f.ker = Z := by
    rw [←hCimage]
    apply comap_injective hπ
    rw [MonoidHom.comap_ker,hcomp,hk,comap_map_eq_self]
    simpa only [QuotientGroup.ker_mk'] using hQC
  have hkerCard : Nat.card f.ker = 3 := by rw [hker,hZcard]
  have hnotSix : Nat.card (G ⧸ C) ≠ 6 := by
    intro he
    have hm := f.ker.card_mul_index
    have hi : f.ker.index = Nat.card (G ⧸ C) :=
      Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective f hf).toEquiv
    rw [hkerCard,hi,he] at hm
    have hd := P.card_subgroup_dvd_card
    rw [hPcard,←hm] at hd
    norm_num at hd
  obtain ⟨d,hcount,_,ht,hpair⟩ := solvable_factors_and_pair_images T hP U q hq hk
    hcore inferInstance (hU.le_pCore.trans (pCore_isPGroup.le_sylow_of_normal T)) hJ hrank
  have hfaith := NormalElementaryQuotient.representation_injective U q hq hk
  have hmin := (ChapterB.minimalParabolic_reduced_image T hP q hq hcore hqne).2
  have hff : IsFFModule ρ := (isFFModule_iff_quadraticRatio_le_one ρ).mpr d.ratio_one.le
  have hr := (ChapterB.offender_generation (T.mapSurjective hq) hmin ρ hff hcore).1
  have htwo : d.count = 2 := by
    rcases hcount with hc | hc
    · obtain ⟨_,e,_⟩ := d.toSolvableFFFactors.one_factor_moved_natural_coordinates
        hfaith hcore hr hc
      apply False.elim
      apply hnotSix
      rw [Nat.card_congr e.toEquiv,Nat.card_eq_fintype_card]
      decide +kernel
    · exact hc
  have hJcard : Nat.card (J.map q) = 4 :=
    paired_thompson_image_card T U q hq hk d htwo (hpair htwo).1
  have ha : Nonempty ((G ⧸ C) ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod 2)) ∨
      Nonempty ((G ⧸ C) ≃* RegularWreathProduct
        (Matrix.SpecialLinearGroup (Fin 2) (ZMod 2)) (Multiplicative (ZMod 2))) := by
    rcases hsmall.wreath with ⟨_,e,_⟩ | ⟨e,_,_⟩
    · exact Or.inl ⟨e⟩
    · exact Or.inr ⟨e⟩
  have hQzero : pCore 2 (G ⧸ Q) = ⊥ := by
    rw [←pCore_map_mk'_eq_of_normal_isPGroup (p := 2) Q
      (pCore_isPGroup (p := 2) (G := G))]
    exact (Subgroup.map_eq_bot_iff _).mpr (by simp [Q])
  have hPcentral : centralizer (P : Set (G ⧸ Q)) ≤ P :=
    centralizer_pResidual_le_of_pCore_eq_bot hQzero
  let S := T.mapSurjective hπ
  let R := (S : Subgroup (G ⧸ Q)) ⊓ centralizer (Z : Set (G ⧸ Q))
  obtain ⟨hRcyclic,_⟩ := Extraspecial27Dihedral.centerSylow_cyclic_of_small_quotient
    P hPcard hPcentral S f hf hker ha
  have hmove : ¬ J.map π ≤ centralizer (Z : Set (G ⧸ Q)) := by
    intro hc
    have hJR : J.map π ≤ R :=
      le_inf (map_mono (sSup_le fun _ hA => hA.1)) hc
    let := hRcyclic
    let : IsCyclic (J.map π) := isCyclic_of_injective
      (inclusion hJR) (inclusion_injective hJR)
    let : IsCyclic ((J.map π).map f) :=
      isCyclic_of_surjective (f.subgroupMap (J.map π)) (f.subgroupMap_surjective _)
    have he : (J.map π).map f = J.map q := by rw [map_map,hcomp]
    have hcyclic : IsCyclic (J.map q) := he ▸ inferInstance
    have hb := cyclic_thompson_image_card_le_two (T : Subgroup G) q hcyclic
    rw [hJcard] at hb
    omega
  have hcomm : Z = ⁅Z,J.map π⁆ := by
    have hle : ⁅Z,J.map π⁆ ≤ Z := commutator_le_left _ _
    have hne : ⁅Z,J.map π⁆ ≠ ⊥ := fun hh =>
      hmove (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hh))
    let : Fact (Nat.card Z).Prime := ⟨hZcard ▸ Nat.prime_three⟩
    rcases (⁅Z,J.map π⁆.subgroupOf Z).eq_bot_or_eq_top_of_prime_card with hb | ht
    · have he := congrArg (map Z.subtype) hb
      rw [map_subgroupOf_eq_of_le hle,Subgroup.map_bot] at he
      exact (hne he).elim
    · have he := congrArg (map Z.subtype) ht
      simpa only [map_subgroupOf_eq_of_le hle,←MonoidHom.range_eq_map,range_subtype] using he.symm
  apply eq_commutator_of_isPPerfect_of_map_eq X J
    (isPPerfect_embedded_pResidual 2 C) le_normalizer_of_normal π
    (by rw [QuotientGroup.ker_mk']; exact pCore_isPGroup)
  rwa [hXimage]

end CFSG.Quasithin.ChapterE.ThompsonAction
