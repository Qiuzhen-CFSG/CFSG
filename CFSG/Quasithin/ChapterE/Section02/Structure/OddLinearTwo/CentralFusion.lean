module

public import CFSG.Quasithin.ChapterE.Section02.Structure.OddLinearTwo.PrimeSource
public import Theory.GroupTheory.SylowCentralizerNonfusion
public import GorensteinWalter.DihedralCore

/-!
# Sylow-center fusion in the original odd component

The normalizer of the intrinsic Sylow intersection is a proper overgroup of
T after mapping into H, hence lies in the source maximal overgroup. When that
maximal overgroup centralizes t, Burnside fusion shows that t is the unique
involution centralizing the intrinsic Sylow subgroup. Dihedral center
coordinates identify its whole center with the subgroup generated by t.

Source: Aschbacher–Smith E.2.2(2c), printed pp.215–216.
-/

public section
open Subgroup
namespace CFSG.Quasithin.ChapterE.Structure

variable {H : Type*} [Group H] [Finite H]

/-- The actual Sylow normalizer lies in the original maximal intersection. -/
theorem normalizer_intersection_sylow_le_max
    (T : Sylow 2 H) (hP : ChapterB.IsMinimalParabolicOver T ⊤)
    (K : Subgroup H) [K.Normal] [IsSimpleGroup K]
    (S : Sylow 2 K) (hS : (S : Subgroup K) = (T : Subgroup H).subgroupOf K)
    (hsbot : (S : Subgroup K) ≠ ⊥) (hstop : (S : Subgroup K) ≠ ⊤) :
    normalizer (S : Set K) ≤ (ChapterB.minimalParabolicMax T hP).subgroupOf K := by
  let A := (S : Subgroup K).map K.subtype
  have hA : A = (T : Subgroup H) ⊓ K := by
    dsimp only [A]
    rw [hS, subgroupOf_map_subtype]
  have hNne : normalizer (A : Set H) ≠ ⊤ := by
    intro he
    have hh := congrArg (comap K.subtype) he
    rw [comap_normalizer_eq_of_le_range (map_le_range _ _),
      comap_map_eq_self_of_injective K.subtype_injective, comap_top] at hh
    have hn : (S : Subgroup K).Normal := normalizer_eq_top_iff.mp hh
    exact (hn.eq_bot_or_eq_top.elim hsbot hstop)
  have hTN : (T : Subgroup H) ≤ normalizer (A : Set H) := by
    rw [hA]
    exact (le_inf (T : Subgroup H).le_normalizer
      (by rw [K.normalizer_eq_top]; exact le_top)).trans inf_normalizer_le_normalizer_inf
  have hNM : normalizer (A : Set H) ≤ ChapterB.minimalParabolicMax T hP :=
    hP.1.le_maximal ⟨(ChapterB.minimalParabolicMax_spec T hP).2,
      (ChapterB.minimalParabolicMax_spec T hP).1.covBy_top⟩ hTN
      (lt_top_iff_ne_top.mpr hNne)
  intro k hk
  exact hNM ((S : Subgroup K).le_normalizer_map K.subtype (mem_map_of_mem K.subtype hk))

/-- Burnside fusion makes the marked central involution unique. -/
theorem unique_sylow_central_involution_of_max_centralizer
    (T : Sylow 2 H) (hP : ChapterB.IsMinimalParabolicOver T ⊤)
    (K : Subgroup H) [K.Normal] [IsSimpleGroup K]
    (S : Sylow 2 K) (hS : (S : Subgroup K) = (T : Subgroup H).subgroupOf K)
    (hsbot : (S : Subgroup K) ≠ ⊥) (hstop : (S : Subgroup K) ≠ ⊤)
    (t : K)
    (hfix : (T : Subgroup H) ≤ centralizer ({(t : H)} : Set H))
    (hMK : (ChapterB.minimalParabolicMax T hP).subgroupOf K = centralizer ({t} : Set K))
    (hfusion : ∀ y : K, orderOf y = 2 → IsConj t y) :
    ∀ y : K, y ∈ centralizer (S : Set K) → orderOf y = 2 → y = t := by
  intro y hy hyo
  have hN := normalizer_intersection_sylow_le_max T hP K S hS hsbot hstop
  rw [hMK] at hN
  have htC : t ∈ centralizer (S : Set K) := by
    intro s hs
    apply Subtype.ext
    have hsT : (s : H) ∈ (T : Subgroup H) := by
      exact show s ∈ (T : Subgroup H).subgroupOf K from hS ▸ hs
    exact mem_centralizer_singleton_iff.mp (hfix hsT)
  exact S.eq_of_isConj_of_normalizer_le_centralizer t y htC hy hN (hfusion y hyo)

private theorem dihedral_center_square {m : ℕ}
    (x : DihedralGroup (2 ^ m)) (hx : x ∈ center (DihedralGroup (2 ^ m))) :
    x ^ 2 = 1 := by
  obtain ⟨i, rfl⟩ | ⟨i, rfl⟩ := GorensteinWalter.dihedralGroup_cases x
  · have hc := mem_center_iff.mp hx (DihedralGroup.sr 0)
    have hi : i = -i := by
      simpa only [DihedralGroup.sr_mul_r, DihedralGroup.r_mul_sr, zero_add,
        zero_sub, DihedralGroup.sr.injEq] using hc
    rw [pow_two, DihedralGroup.r_mul_r, eq_neg_iff_add_eq_zero.mp hi]
    rfl
  · simpa only [pow_two] using DihedralGroup.sr_mul_self i

/-- Dihedral coordinates turn uniqueness into the literal center identity. -/
theorem sylow_center_eq_zpowers_of_dihedral_unique
    {G : Type*} [Group G] [Finite G] (S : Subgroup G) {m : ℕ}
    (e : S ≃* DihedralGroup (2 ^ m)) (t : G) (htS : t ∈ S)
    (htC : t ∈ centralizer (S : Set G))
    (hunique : ∀ y : G, y ∈ centralizer (S : Set G) → orderOf y = 2 → y = t) :
    (center S).map S.subtype = zpowers t := by
  apply le_antisymm
  · rintro y ⟨s, hs, rfl⟩
    change (s : G) ∈ zpowers t
    by_cases hone : (s : G) = 1
    · rw [hone]; exact one_mem _
    have hsC : (s : G) ∈ centralizer (S : Set G) := by
      intro a ha
      exact congrArg Subtype.val (mem_center_iff.mp hs (⟨a, ha⟩ : S))
    have hs2 : (s : G) ^ 2 = 1 := by
      have hecent : e s ∈ center (DihedralGroup (2 ^ m)) := (centerCongr e ⟨s, hs⟩).property
      have he2 := dihedral_center_square (e s) hecent
      have hs2 : s ^ 2 = 1 := e.injective (by simpa only [map_pow, map_one] using he2)
      exact congrArg S.subtype hs2
    rw [hunique _ hsC (orderOf_eq_prime hs2 hone)]
    exact mem_zpowers t
  · apply zpowers_le.mpr
    refine ⟨⟨t, htS⟩, ?_, rfl⟩
    apply mem_center_iff.mpr
    intro s
    apply Subtype.ext
    exact htC s s.property

end CFSG.Quasithin.ChapterE.Structure
