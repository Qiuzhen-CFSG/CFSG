module

public import CFSG.Quasithin.ChapterE.Section02.Structure.SymplecticFour.SourceNonrootSocle
public import Theory.GroupTheory.GeneralizedFitting.ComponentLayerStructure
public import Theory.SpecificGroups.SymplecticFour.TwoConjugate.InvolutionGenerated
public import Theory.SpecificGroups.PSL2.InvolutionGeneratedExtension
public import Theory.SpecificGroups.Suzuki.InvolutionGeneratedExtension

/-!
# Removing outer extensions in the original root-free symplectic pair

The literal opposite pair is generated by involutions. Its simple socle
has trivial centralizer, and every pair involution has two-group centralizer.
Binary PSL2 outer involutions fix a nontrivial half-field PSL2 group with
trivial two-core, while Suzuki outer groups have odd order. Consequently,
for either model of the actual socle, the entire original pair equals its
socle. No containment of the original V in the socle is assumed.

The final theorem applies to the original component inclusion and pullback.
Socle model recognition remains with the independent catalogue inspection;
the coefficient representation and Borel marking are subsequent source steps.
Source: Aschbacher--Smith E.2.7, printed pp.220--221.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterE.Structure.SymplecticFour
open Theory.SpecificGroups.SymplecticFour TwoConjugate InvolutionTypes
variable {G F : Type*} [Group G] [Finite G] [Field F] [Finite F] [CharP F 2]

private theorem nonroot_socle_centralizer_eq_bot {n : ℕ} (hF : Nat.card F=2^n)
    (V : Subgroup (Sp F)) [IsElementaryAbelian 2 V] (hr : 2<Nat.card V)
    (hc : V≤(CentralRootGeometry.parameter (F := F)).range)
    (h2 : pCore 2 (oppositePair V)=⊥)
    (hnr : ∀ g ∈ oppositePair V, ¬IsRootElement g) :
    centralizer (generalizedFitting (oppositePair V) : Set (oppositePair V)) = ⊥ := by
  let P := oppositePair V
  have ho := oppositePair_oddCore_eq_bot_of_nonroot_central hF V hr hc hnr
  have hfit : fittingSubgroup P=⊥ :=
    le_bot_iff.mp (ho ▸ fitting_le_pPrimeCore_of_pCore_eq_bot 2 h2)
  let : IsSimpleGroup (generalizedFitting P) :=
    oppositePair_generalizedFitting_simple_of_nonroot_central hF V hr hc h2 hnr
  have hperfect : Group.IsPerfect (generalizedFitting P) := by
    change Group.IsPerfect (↥(fittingSubgroup P ⊔ componentLayer P))
    rw [hfit,bot_sup_eq]
    exact componentLayer_isPerfect
  let := hperfect
  exact SimpleSocle.centralizer_eq_bot (Group.IsPerfect.not_isMulCommutative _)

/-- A binary PSL2 model of the actual socle already models the whole literal
root-free pair. All potential outer extensions are eliminated. -/
theorem nonroot_pair_binary_of_socle {n r : ℕ} (hF : Nat.card F=2^n)
    (V : Subgroup (Sp F)) [IsElementaryAbelian 2 V] (hr : 2<Nat.card V)
    (hc : V≤(CentralRootGeometry.parameter (F := F)).range)
    (h2 : pCore 2 (oppositePair V)=⊥)
    (hnr : ∀ g ∈ oppositePair V, ¬IsRootElement g) (hrank : 2≤r)
    (e : generalizedFitting (oppositePair V) ≃* Theory.PSL2.BinaryGroup r) :
    Nonempty (oppositePair V ≃* Theory.PSL2.BinaryGroup r) := by
  have ht := Theory.PSL2.BinaryOuterGeometry.eq_top_of_involution_generated
    (generalizedFitting (oppositePair V)) e
    (nonroot_socle_centralizer_eq_bot hF V hr hc h2 hnr) hrank
    (oppositePair_involution_generated V)
    (subgroup_isPGroup_involution_centralizers_of_nonroot hF (oppositePair V) hnr)
  exact ⟨Subgroup.topEquiv.symm.trans ((MulEquiv.subgroupCongr ht.symm).trans e)⟩

/-- A Suzuki model of the actual socle already models the whole literal
root-free pair, because the odd outer quotient kills all involutory generators. -/
theorem nonroot_pair_suzuki_of_socle {n m : ℕ} (hF : Nat.card F=2^n)
    (V : Subgroup (Sp F)) [IsElementaryAbelian 2 V] (hr : 2<Nat.card V)
    (hc : V≤(CentralRootGeometry.parameter (F := F)).range)
    (h2 : pCore 2 (oppositePair V)=⊥)
    (hnr : ∀ g ∈ oppositePair V, ¬IsRootElement g) (hm : 1≤m)
    (e : generalizedFitting (oppositePair V) ≃* BenderSuzuki.MatrixGroups.SuzukiMatrixGroup m) :
    Nonempty (oppositePair V ≃* BenderSuzuki.MatrixGroups.SuzukiMatrixGroup m) := by
  have ht := BenderSuzuki.MatrixGroups.suzuki_eq_top_of_involution_generated
    (generalizedFitting (oppositePair V)) m hm e
    (nonroot_socle_centralizer_eq_bot hF V hr hc h2 hnr)
    (oppositePair_involution_generated V)
  exact ⟨Subgroup.topEquiv.symm.trans ((MulEquiv.subgroupCongr ht.symm).trans e)⟩

/-- The original source pullback removes outer extensions in both surviving
Bender rows. Only recognition of the actual socle remains an independent
input; all original core and central-plane assumptions are discharged. -/
theorem source_nonroot_pair_bender_of_socle {n : ℕ}
    (hF : Nat.card F=2^n) (hn : 1<n)
    (T : Sylow 2 G) (hP : ChapterB.IsMinimalParabolicOver T ⊤)
    (hJ : ChapterB.minimalParabolicCore T hP=⊥)
    (L : Subgroup G) [L.Normal] [IsSimpleGroup L] (e : Sp F≃*L)
    (hmark : (T : Subgroup G).comap (L.subtype.comp e.toMonoidHom)=unipotent)
    (hgen : L⊔(T : Subgroup G)=⊤)
    (V : Subgroup G) [IsElementaryAbelian 2 V] (hVT : V≤T)
    (hVM : V≤(ChapterB.minimalParabolicMax T hP).pCoreIn 2)
    (hVN : (T : Subgroup G)≤normalizer (V : Set G)) (hr : 2<Nat.card V)
    (hnr : ∀ g ∈ oppositePair (V.comap (L.subtype.comp e.toMonoidHom)),
      ¬IsRootElement g)
    (hm : let I := generalizedFitting (oppositePair (V.comap (L.subtype.comp e.toMonoidHom)))
      (∃ r : ℕ, 2≤r ∧ Nonempty (I ≃* Theory.PSL2.BinaryGroup r)) ∨
      (∃ m : ℕ, 1≤m ∧ Nonempty (I ≃* BenderSuzuki.MatrixGroups.SuzukiMatrixGroup m))) :
    let P := oppositePair (V.comap (L.subtype.comp e.toMonoidHom))
    (∃ r : ℕ, 2≤r ∧ Nonempty (P ≃* Theory.PSL2.BinaryGroup r)) ∨
    (∃ m : ℕ, 1≤m ∧ Nonempty (P ≃* BenderSuzuki.MatrixGroups.SuzukiMatrixGroup m)) := by
  let f := L.subtype.comp e.toMonoidHom
  let W := V.comap f
  have hf : Function.Injective f := L.subtype_injective.comp e.injective
  obtain ⟨_,hmap,hc,_,h2⟩ := source_geometry hF hn T hP hJ L e hmark hgen V hVT hVM hVN hr
  have hcard : Nat.card W=Nat.card V := by
    rw [←hmap,card_map_of_injective hf]
  let j : W →* V := (f.comp W.subtype).codRestrict V (fun x => x.property)
  let : IsElementaryAbelian 2 W := IsElementaryAbelian.of_injective j (by
    intro x y h
    exact Subtype.ext (hf (congrArg (fun z : V => (z : G)) h)))
  rcases hm with ⟨r,hrank,⟨a⟩⟩ | ⟨m,hm,⟨a⟩⟩
  · exact Or.inl ⟨r,hrank,nonroot_pair_binary_of_socle hF W (hcard.symm ▸ hr)
      (CentralRootGeometry.parameter_range (F := F) ▸ hc) h2 hnr hrank a⟩
  · exact Or.inr ⟨m,hm,nonroot_pair_suzuki_of_socle hF W (hcard.symm ▸ hr)
      (CentralRootGeometry.parameter_range (F := F) ▸ hc) h2 hnr hm a⟩

end CFSG.Quasithin.ChapterE.Structure.SymplecticFour
