module

public import Theory.GroupTheory.SpecificGroups.CyclicInvertedDihedral
public import Mathlib.Algebra.Group.Conj
public import Mathlib.Tactic.Group
public import Mathlib.Tactic.Ring

/-!
# Two conjugate involutions in the E.2.10 recognition argument

Two nonidentity conjugate involutions generating a finite group give an actual
odd dihedral model. Put `r = b*a`. The two normal forms for a conjugator give
`r = r^(2k)`, so its order divides an odd integer. The cyclic-inversion
isomorphism then supplies the model. The same normal forms show that every
central element lies in the subgroup generated by the first involution.

This is the elementary recognition calculation used in Aschbacher–Smith,
*The Classification of Quasithin Groups*, E.2.10(6), printed pp. 222–223.
-/

open Subgroup
open scoped Pointwise
namespace CFSG.Quasithin.ChapterE.TwoConjugate.OddDihedral
variable {G : Type*} [Group G] [Finite G]

private theorem involution_zpowers {a : G} (ha : a ^ 2 = 1) {x : G}
    (hx : x ∈ zpowers a) : x = 1 ∨ x = a := by
  obtain ⟨n, rfl⟩ := (mem_powers_iff_mem_zpowers).mpr hx
  change a ^ n = 1 ∨ a ^ n = a
  rw [pow_eq_pow_mod n ha]
  have : n % 2 = 0 ∨ n % 2 = 1 := by omega
  rcases this with h | h <;> simp [h]

omit [Finite G] in
private theorem inverted_zpowers {a r : G} (hi : a * r * a⁻¹ = r⁻¹)
    {x : G} (hx : x ∈ zpowers r) : a * x * a⁻¹ = x⁻¹ := by
  obtain ⟨k, rfl⟩ := hx
  rw [← conj_zpow, hi, inv_zpow]

omit [Finite G] in
private theorem inverter_normalizes {a r : G} (ha : a ^ 2 = 1)
    (hi : a * r * a⁻¹ = r⁻¹) : zpowers a ≤ normalizer (zpowers r : Set G) := by
  apply zpowers_le.mpr
  rw [mem_normalizer_iff]
  intro x
  constructor
  · intro hx
    rw [inverted_zpowers hi hx]
    exact inv_mem hx
  · intro hx
    have hh := inverted_zpowers hi hx
    have haa : a * a = 1 := by simpa [pow_two] using ha
    have hai : a⁻¹ = a := inv_eq_of_mul_eq_one_right haa
    have he : a * (a * x * a⁻¹) * a⁻¹ = x := by
      rw [hai]
      calc
        _ = (a * a) * x * (a * a) := by group
        _ = x := by rw [haa]; simp
    rw [he] at hh
    rw [hh]
    exact inv_mem hx

private theorem normal_forms {a r : G} (ha : a ^ 2 = 1)
    (hi : a * r * a⁻¹ = r⁻¹)
    (hg : zpowers r ⊔ zpowers a = ⊤) (x : G) :
    ∃ k : ℤ, x = r ^ k ∨ x = r ^ k * a := by
  have hx : x ∈ (zpowers r ⊔ zpowers a : Subgroup G) := hg ▸ mem_top x
  rw [← SetLike.mem_coe, coe_mul_of_right_le_normalizer_left _ _
    (inverter_normalizes ha hi)] at hx
  obtain ⟨u, hu, v, hv, rfl⟩ := hx
  obtain ⟨k, rfl⟩ := hu
  rcases involution_zpowers ha hv with rfl | rfl
  · exact ⟨k, Or.inl (mul_one _)⟩
  · exact ⟨k, Or.inr rfl⟩

private theorem odd_rotation {a b : G} (ha : a ^ 2 = 1) (hb : b ^ 2 = 1)
    (hg : zpowers (b * a) ⊔ zpowers a = ⊤) (hc : IsConj a b) :
    Odd (orderOf (b * a)) := by
  let r := b * a
  have haa : a * a = 1 := by simpa [pow_two] using ha
  have hbb : b * b = 1 := by simpa [pow_two] using hb
  have hai : a⁻¹ = a := inv_eq_of_mul_eq_one_right haa
  have hbi : b⁻¹ = b := inv_eq_of_mul_eq_one_right hbb
  have hi : a * r * a⁻¹ = r⁻¹ := by
    simp only [r, mul_inv_rev, hai, hbi, mul_assoc, haa, mul_one]
  obtain ⟨x, hx⟩ := isConj_iff.mp hc
  obtain ⟨k, hk⟩ := normal_forms ha hi hg x
  have hcomm : a * (r ^ k)⁻¹ = r ^ k * a := by
    have hh := inverted_zpowers hi (inv_mem (zpow_mem (mem_zpowers r) k))
    simpa only [inv_inv, mul_inv_eq_iff_eq_mul] using hh
  have he : r = r ^ (2 * k) := by
    change b * a = _
    rw [← hx]
    rcases hk with rfl | rfl
    · calc
        _ = r ^ k * (a * (r ^ k)⁻¹) * a := by group
        _ = r ^ k * (r ^ k * a) * a := by rw [hcomm]
        _ = r ^ (2 * k) := by rw [mul_assoc, mul_assoc, haa, mul_one, ← zpow_add]; congr 1; omega
    · calc
        _ = r ^ k * (a * (r ^ k)⁻¹) * a := by group
        _ = r ^ k * (r ^ k * a) * a := by rw [hcomm]
        _ = r ^ (2 * k) := by rw [mul_assoc, mul_assoc, haa, mul_one, ← zpow_add]; congr 1; omega
  have hd : (orderOf r : ℤ) ∣ 2 * k - 1 :=
    orderOf_dvd_sub_iff_zpow_eq_zpow.mpr (by simpa only [zpow_one] using he.symm)
  obtain ⟨t, ht⟩ := hd
  have ho : Odd ((orderOf r : ℤ) * t) := by
    rw [← ht]
    exact ⟨k - 1, by ring⟩
  exact (Int.odd_coe_nat _).mp ((Int.odd_mul.mp ho).1)

private theorem center_le_reflection {a r : G} (ha : a ^ 2 = 1)
    (hi : a * r * a⁻¹ = r⁻¹) (hg : zpowers r ⊔ zpowers a = ⊤)
    (ho : Odd (orderOf r)) : center G ≤ zpowers a := by
  intro z hz
  obtain ⟨k, hk⟩ := normal_forms ha hi hg z
  have ht : r ^ k ∈ zpowers r := zpow_mem (mem_zpowers r) k
  have hinv := inverted_zpowers hi ht
  have hc := mem_center_iff.mp hz a
  have he : r ^ k = (r ^ k)⁻¹ := by
    rw [← hinv]
    rcases hk with rfl | rfl
    · exact (mul_inv_eq_iff_eq_mul.mpr hc).symm
    · have hc' : a * r ^ k = r ^ k * a := mul_right_cancel
        (by simpa only [mul_assoc] using hc)
      exact (mul_inv_eq_iff_eq_mul.mpr hc').symm
  have ht2 : (r ^ k) ^ 2 = 1 := by
    simpa only [pow_two, ← he] using mul_inv_cancel (r ^ k)
  have ht1 : r ^ k = 1 := orderOf_eq_one_iff.mp
    (Nat.eq_one_of_dvd_coprimes (Nat.coprime_two_left.mpr ho)
      (orderOf_dvd_of_pow_eq_one ht2) (orderOf_dvd_of_mem_zpowers ht))
  rcases hk with rfl | rfl <;> simp [ht1, mem_zpowers]

public theorem recognition {a b : G} (ha1 : a ≠ 1) (ha : a ^ 2 = 1) (hb : b ^ 2 = 1)
    (hg : zpowers a ⊔ zpowers b = ⊤) (hc : IsConj a b) :
    ∃ m : ℕ, 0 < m ∧ Odd m ∧ Nonempty (G ≃* DihedralGroup m) ∧
      center G ≤ zpowers a := by
  let r := b * a
  have haa : a * a = 1 := by simpa only [pow_two] using ha
  have hbb : b * b = 1 := by simpa only [pow_two] using hb
  have hai : a⁻¹ = a := inv_eq_of_mul_eq_one_right haa
  have hbi : b⁻¹ = b := inv_eq_of_mul_eq_one_right hbb
  have hi : a * r * a⁻¹ = r⁻¹ := by
    simp only [r, mul_inv_rev, hai, hbi, mul_assoc, haa, mul_one]
  have hg' : zpowers r ⊔ zpowers a = ⊤ := by
    apply top_unique
    rw [← hg]
    refine sup_le le_sup_right (zpowers_le.mpr ?_)
    have hh := (zpowers r ⊔ zpowers a).mul_mem
      ((le_sup_left : zpowers r ≤ zpowers r ⊔ zpowers a) (mem_zpowers r))
      ((le_sup_right : zpowers a ≤ zpowers r ⊔ zpowers a) (mem_zpowers a))
    simpa only [r, mul_assoc, haa, mul_one] using hh
  have ho : Odd (orderOf r) := odd_rotation ha hb hg' hc
  have hout : a ∉ zpowers r := by
    intro hh
    have hd := orderOf_dvd_of_mem_zpowers hh
    rw [orderOf_eq_prime ha ha1] at hd
    exact ho.not_two_dvd_nat hd
  obtain ⟨e⟩ := (zpowers r).nonempty_mulEquiv_dihedralGroup_of_cyclic_inverted
    a inferInstance ha hout (fun _ hx => inverted_zpowers hi hx)
  have em : Nonempty (G ≃* DihedralGroup (orderOf r)) := by
    rw [← Nat.card_zpowers]
    exact ⟨topEquiv.symm.trans ((MulEquiv.subgroupCongr hg'.symm).trans e)⟩
  exact ⟨orderOf r, ho.pos, ho, em, center_le_reflection ha hi hg' ho⟩
end CFSG.Quasithin.ChapterE.TwoConjugate.OddDihedral
