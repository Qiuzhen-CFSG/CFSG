module

public import CFSG.Quasithin.ChapterE.Section02.ModuleBounds.DihedralCubic.SmallCore
public import Theory.GroupTheory.PGroup.ExtraspecialInvariantImage
public import Theory.GroupTheory.PResidual.Quotient
public import Theory.ElementaryAbelian.Quotient

/-!
# The quaternion pair core lies in the two-residual

The two-residual quotient is generated by the image of the marked elementary
subgroup: its Sylow image is the whole quotient, so that marked image is normal.
Thus the quotient is elementary. The two-conjugate fixed-space identities show
that the core modulo its center has no global fixed points. Extraspecial
commutator duality therefore kills the entire core in the elementary quotient.

Source: Aschbacher--Smith E.2.17, the placement of the marked pair core in the
ambient two-core at the start of the solvable case. The source-facing transport
is in Witnesses/BenderPlacement/SmallCorePlacement.
-/

public section
open Subgroup
open scoped IsMulCommutative commutatorElement

namespace CFSG.Quasithin.ChapterE.TwoConjugate.Hypotheses
variable {X : Type*} [Group X] [Finite X]
  {T : Sylow 2 X} {V M : Subgroup X} {g : X}

theorem residual_quotient_elementary (h : Hypotheses T V M g) :
    IsElementaryAbelian 2 (X ⧸ pResidual 2 X) := by
  let := h.elementary
  let q := QuotientGroup.mk' (pResidual 2 X)
  have hq := QuotientGroup.mk'_surjective (pResidual 2 X)
  have hT : (T : Subgroup X).map q = ⊤ :=
    top_unique (((isPGroup_quotient_pResidual (G := X) 2).to_subgroup ⊤).le_sylow_of_normal
      (T.mapSurjective hq))
  have hVn : (V.map q).Normal := by
    apply normalizer_eq_top_iff.mp
    apply top_unique
    rw [← hT]
    exact (map_mono h.sylow_le_normalizer).trans (V.le_normalizer_map q)
  let := hVn
  have hconjV : (V.map q).map (MulAut.conj (q g)).toMonoidHom = V.map q :=
    mem_normalizer_iff_map_conj_eq.mp (show q g ∈ normalizer (V.map q : Set _) from
      le_normalizer_of_normal (mem_top (q g)))
  have he : V.map q = ⊤ := by
    have hm := congrArg (map q) h.generate
    have hconj : (V.map (MulAut.conj g).toMonoidHom).map q =
        (V.map q).map (MulAut.conj (q g)).toMonoidHom := by
      rw [map_map,map_map]
      congr 1
    rw [Subgroup.map_sup,hconj,hconjV,sup_idem,map_top_of_surjective q hq] at hm
    exact hm
  let f := q.comp V.subtype
  have hf : Function.Surjective f := MonoidHom.range_eq_top.mp (by
    rw [MonoidHom.range_comp,range_subtype,he])
  exact IsElementaryAbelian.of_surjective f hf

theorem P_le_twoResidual_of_extraspecial
    (h : Hypotheses T V M g)
    (hcenter : (center (P V M g)).map (P V M g).subtype = Z V g)
    [IsExtraspecial 2 (P V M g)] : P V M g ≤ pResidual 2 X := by
  let := h.core_geometry.1
  let := h.Z_normal
  let := h.residual_quotient_elementary
  let q := QuotientGroup.mk' (Z V g)
  let f := (QuotientGroup.mk' (pResidual 2 X)).comp (P V M g).subtype
  have hfix (r : P V M g)
      (hr : ∀ x : X, (MulAut.conjNormal x : MulAut (P V M g)) r * r⁻¹ ∈ center (P V M g)) :
      r ∈ center (P V M g) := by
    have hdisp (x : X) : x * (r : X) * x⁻¹ * (r : X)⁻¹ ∈ Z V g := by
      rw [←hcenter]
      exact mem_map_of_mem (P V M g).subtype (hr x)
    have hrc : q r ∈ centralizer (V.map q : Set (X ⧸ Z V g)) := by
      rintro _ ⟨v,hv,rfl⟩
      apply commutatorElement_eq_one_iff_mul_comm.mp
      rw [←map_commutatorElement]
      exact (QuotientGroup.eq_one_iff _).mpr (hdisp v)
    have hrB : (r : X) ∈ B V M := by
      have hh : q r ∈ (B V M).map q := h.quotient_fixed_eq_B ▸
        (show q r ∈ (P V M g).map q ⊓ centralizer (V.map q : Set _) from
          ⟨mem_map_of_mem q r.property,hrc⟩)
      have hh' : (r : X) ∈ ((B V M).map q).comap q := hh
      rw [comap_map_eq,QuotientGroup.ker_mk',sup_eq_left.mpr
        (h.Z_le_B_inf_A.trans inf_le_left)] at hh'
      exact hh'
    have hrA : (r : X) ∈ A V M g := by
      have hc : g * (r : X) * g⁻¹ * (r : X)⁻¹ ∈ A V M g :=
        (h.Z_le_B_inf_A (hdisp g)).2
      have hg : g * (r : X) * g⁻¹ ∈ A V M g :=
        mem_map_of_mem (MulAut.conj g).toMonoidHom hrB
      have hh := (A V M g).mul_mem ((A V M g).inv_mem hc) hg
      have he : (g * (r : X) * g⁻¹ * (r : X)⁻¹)⁻¹ * (g * (r : X) * g⁻¹) = r := by group
      rwa [he] at hh
    have hrZ : (r : X) ∈ Z V g := h.B_inf_A_eq_Z ▸ ⟨hrB,hrA⟩
    rw [←hcenter] at hrZ
    obtain ⟨s,hs,he⟩ := hrZ
    exact (P V M g).subtype_injective he ▸ hs
  have hf : f = 1 := Theory.GroupTheory.invariant_hom_eq_one_of_extraspecial_fixed_center
    (P V M g) hfix f (by
      intro x p
      change QuotientGroup.mk' (pResidual 2 X) (x*(p : X)*x⁻¹) = _
      rw [map_mul,map_mul,map_inv,mul_comm (QuotientGroup.mk' (pResidual 2 X) x),
        mul_inv_cancel_right]
      rfl)
  intro x hx
  exact (QuotientGroup.eq_one_iff x).mp (DFunLike.congr_fun hf ⟨x,hx⟩)
end CFSG.Quasithin.ChapterE.TwoConjugate.Hypotheses
