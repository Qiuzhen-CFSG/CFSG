module

public import CFSG.Quasithin.ChapterB.Section06To07.Structure
public import Theory.GroupTheory.AbelianGeneratorCore
public import Theory.GroupTheory.TINormalizerControl

/-!
# Elementary reductions for minimal parabolics

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
manuscript (1 March 2004), E.2.9, E.2.10(1), and E.2.14(1), pp. 221–226.

A two-subgroup outside the core of the unique maximal overgroup cannot be
normal. Its normalizer therefore lies in that overgroup. The two-core
normalizes any subgroup generated by two conjugates of a subgroup normal
in the Sylow subgroup. For two abelian generators the intersection is central,
and their intersections with the two-core generate a normal subgroup.
The TI argument identifies the local normalizer when the intersection is
nontrivial.

These are elementary parts of the source results, not their classification
or module-theoretic conclusions. The source right conjugate `V^g` is represented
here by `V.map (MulAut.conj g).toMonoidHom`, with the conjugating element inverted
when translating the source's convention.
-/

namespace CFSG.Quasithin.ChapterE

open Subgroup ChapterB

variable {H : Type*} [Group H]

/-- The normalizer assertion at the start of E.2.9. Elementary abelianness
can be weakened to the two-group condition in this step. -/
public theorem minimalParabolic_normalizer_le [Finite H] (T : Sylow 2 H)
    (hP : IsMinimalParabolicOver T ⊤) (V : Subgroup H) (hV : IsPGroup 2 V)
    (hTV : (T : Subgroup H) ≤ normalizer (V : Set H))
    (hVJ : ¬ V ≤ minimalParabolicCore T hP) :
    normalizer (V : Set H) ≤ minimalParabolicMax T hP := by
  have hproper : normalizer (V : Set H) ≠ ⊤ := by
    intro hn
    have hnormal : V.Normal := normalizer_eq_top_iff.mp hn
    have hcore : V ≤ pCore 2 H := le_sSup ⟨hnormal, hV⟩
    exact hVJ (hcore.trans (minimalParabolicTwoCore_le_core T hP))
  have hmax := minimalParabolicMax_spec T hP
  exact hP.1.le_maximal ⟨hmax.2, hmax.1.covBy_top⟩ hTV (lt_top_iff_ne_top.mpr hproper)

/-- The two-core normalization in E.2.9(1), independent of the model of `I`. -/
public theorem twoCore_le_normalizer_conjugate_join (T : Sylow 2 H) (V : Subgroup H)
    (hTV : (T : Subgroup H) ≤ normalizer (V : Set H)) (g : H) :
    pCore 2 H ≤
      normalizer ((V ⊔ V.map (MulAut.conj g).toMonoidHom : Subgroup H) : Set H) :=
  normal_le_normalizer_conjugate_join _ V
    ((pCore_isPGroup.le_sylow_of_normal T).trans hTV) g

/-- The normality and central-intersection conclusions of E.2.10(1),
using the two-core intersections. Identifying these with the source's
`J ∩ V` and its conjugate requires the separate two-closedness theorem for `J`. -/
public theorem twoConjugate_twoCore_structure (T : Sylow 2 H) (V : Subgroup H)
    [IsMulCommutative V] (hV : IsPGroup 2 V)
    (hTV : (T : Subgroup H) ≤ normalizer (V : Set H)) (g : H)
    (hgen : V ⊔ V.map (MulAut.conj g).toMonoidHom = ⊤) :
    let W := V.map (MulAut.conj g).toMonoidHom
    let P := (pCore 2 H ⊓ V) ⊔ (pCore 2 H ⊓ W)
    P.Normal ∧ V ⊓ W ≤ P ⊓ center H := by
  dsimp only
  have hQV : pCore 2 H ≤ normalizer (V : Set H) :=
    (pCore_isPGroup.le_sylow_of_normal T).trans hTV
  have hQmap : (pCore 2 H).map (MulAut.conj g).toMonoidHom = pCore 2 H :=
    mem_normalizer_iff_map_conj_eq.mp (le_normalizer_of_normal (mem_top g))
  have hQW : pCore 2 H ≤ normalizer (V.map (MulAut.conj g).toMonoidHom : Set H) := by
    rw [← map_equiv_normalizer_eq V (MulAut.conj g)]
    simpa only [hQmap] using map_mono (f := (MulAut.conj g).toMonoidHom) hQV
  refine ⟨normal_sup_inf_of_normal_normalizes_generators V _ _ hgen hQV hQW, ?_⟩
  exact le_inf ((le_inf (abelian_generator_intersection_le_pCore 2 V _ hV hgen)
    inf_le_left).trans le_sup_left) (inf_le_center_of_abelian_generators V _ hgen)

/-- E.2.14(1)'s TI argument, retaining the ambient embedding of the local
normalizer as `I ∩ N_H(V)`. -/
public theorem ti_generated_pair_normalizer (M V : Subgroup H) [IsMulCommutative V]
    (hTI : ∀ x ∈ M, V ⊓ V.map (MulAut.conj x).toMonoidHom = ⊥ ∨
      V.map (MulAut.conj x).toMonoidHom = V)
    (hNV : normalizer (V : Set H) ≤ M) (g : H)
    (hZ : V ⊓ V.map (MulAut.conj g).toMonoidHom ≠ ⊥) :
    (V ⊔ V.map (MulAut.conj g).toMonoidHom) ⊓ M =
      (V ⊔ V.map (MulAut.conj g).toMonoidHom) ⊓ normalizer (V : Set H) := by
  apply inf_eq_inf_normalizer_of_trivial_intersections hTI hNV hZ inf_le_left
  exact (sup_le_centralizer_inf_of_abelian V _).trans (centralizer_le_normalizer _)

end CFSG.Quasithin.ChapterE
