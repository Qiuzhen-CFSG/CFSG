module
public import CFSG.Quasithin.ChapterE.Section02.Elementary
public import Theory.GroupTheory.GeneralizedFitting.PrimeCoreNormalized
/-!
# Generalized-Fitting inheritance for the original conjugate pair

The ambient two-core normalizes both elementary generators, hence the
subgroup generated by them. Passing through its product with O₂(H) proves
F*(I)=O₂(I) whenever F*(H)=O₂(H). The maps from the original V into I and
the original internal conjugator are retained throughout.
Source: Aschbacher–Smith E.2.9(1–2), printed pp.221–222.
-/
public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterE.Witnesses.Solvable
variable {H : Type*} [Group H] [Finite H]

theorem two_conjugate_fitting (T : Sylow 2 H) (V I : Subgroup H)
    (hTV : (T : Subgroup H) ≤ normalizer (V : Set H)) (hVI : V ≤ I)
    (g : I) (hgen : V.subgroupOf I ⊔
      (V.subgroupOf I).map (MulAut.conj g).toMonoidHom = ⊤)
    (hfit : generalizedFitting H = pCore 2 H) :
    generalizedFitting I = pCore 2 I := by
  have he : V ⊔ V.map (MulAut.conj (g : H)).toMonoidHom = I := by
    have hh := congrArg (fun A : Subgroup I => A.map I.subtype) hgen
    rw [Subgroup.map_sup, map_subgroupOf_eq_of_le hVI, ← MonoidHom.range_eq_map, range_subtype] at hh
    rw [map_map] at hh
    have hm : I.subtype.comp (MulAut.conj g).toMonoidHom =
        (MulAut.conj (g : H)).toMonoidHom.comp I.subtype := by
      ext x
      rfl
    rw [hm, ← map_map, map_subgroupOf_eq_of_le hVI] at hh
    exact hh
  exact generalizedFitting_eq_pCore_of_normalized_by_pCore I hfit
    (he ▸ twoCore_le_normalizer_conjugate_join T V hTV (g : H))
end CFSG.Quasithin.ChapterE.Witnesses.Solvable
