module
public import CFSG.Quasithin.ChapterE.Section02.Witnesses.Solvable.Dihedral
public import Theory.GroupTheory.PResidual.SylowSupplement
public import Theory.GroupTheory.PCoreOvergroup
/-!
# Solvable two-conjugate witnesses above a core-free odd residual

An inverted odd prime-power line gives an actual subgroup generated by two
conjugates of the elementary subgroup. Disjointness from the marked maximal
subgroup identifies its intersection exactly, and the odd index makes the
elementary subgroup a Sylow subgroup. The quotient is the literal dihedral
group constructed in `Dihedral`. A residual movement lemma supplies the
nontrivial action whenever the ambient two-core is trivial.

Source: Aschbacher–Smith, E.2.7 and E.2.9, printed pp.220–222.
-/

public section
noncomputable section
open Subgroup
open scoped Pointwise
namespace CFSG.Quasithin.ChapterE.Witnesses.Solvable
variable {G : Type*} [Group G] [Finite G]

structure CoreFreeWitness (M V : Subgroup G) (p : ℕ) where
  subgroup : Subgroup G
  le : V ≤ subgroup
  conjugator : subgroup
  generate : V.subgroupOf subgroup ⊔
    (V.subgroupOf subgroup).map (MulAut.conj conjugator).toMonoidHom = ⊤
  sylow : Sylow 2 subgroup
  sylow_eq : (sylow : Subgroup subgroup).map subgroup.subtype = V
  maximal_eq : M.subgroupOf subgroup = V.subgroupOf subgroup
  exponent : ℕ
  positive : 0 < exponent
  dihedral : Nonempty ((subgroup ⧸ (M.subgroupOf subgroup).normalCore) ≃*
    DihedralGroup (p ^ exponent))

theorem coreFreeWitness_of_moved_prime_group {p : ℕ} [Fact p.Prime] (hp : p ≠ 2)
    (R M V : Subgroup G) (hR : IsPGroup p R) [R.Normal]
    [IsElementaryAbelian 2 V] (hVM : V ≤ M) (hRM : Disjoint R M)
    (hne : ⁅R,V⁆ ≠ ⊥) : Nonempty (CoreFreeWitness M V p) := by
  have hVR : V ≤ normalizer (R : Set G) := le_normalizer_of_normal
  obtain ⟨g,v,a,hgR,hv,ha,hord,hi,hsign⟩ :=
    Theory.GroupAction.exists_inverted_prime_power_line hp R V hR hVR hne
  have ho : Odd (orderOf g) := by rw [hord]; exact (Nat.Prime.odd_of_ne_two Fact.out hp).pow
  have hg : g ≠ 1 := by
    intro hg
    rw [hg,orderOf_one] at hord
    have hlt : 1 < p^a := Nat.one_lt_pow (by omega) (Fact.out : p.Prime).one_lt
    omega
  let D := zpowers g
  let I := D ⊔ V
  have hn := Theory.GroupTheory.normalizes_cyclic_of_identity_or_inversion V g hsign
  have hDR : D ≤ R := zpowers_le.mpr hgR
  have hdM : Disjoint D M := hRM.mono_left hDR
  have hdV : Disjoint D V := hdM.mono_right hVM
  have hMI : M ⊓ I = V := by
    apply le_antisymm ?_ (le_inf hVM le_sup_right)
    intro x hx
    have hh : x ∈ (D : Set G) * (V : Set G) := by
      rw [← coe_mul_of_right_le_normalizer_left D V hn]
      exact hx.2
    obtain ⟨d,hd,w,hw,he⟩ := hh
    have hd' : d ∈ M := by
      have hh := M.mul_mem hx.1 (M.inv_mem (hVM hw))
      rwa [← he,mul_inv_cancel_right] at hh
    have hd1 := disjoint_def.mp hdM hd hd'
    have heq : w = x := by simpa only [hd1,one_mul] using he
    exact heq ▸ hw
  have hVle : V ≤ I := le_sup_right
  let U := V.subgroupOf I
  let : IsElementaryAbelian 2 U := IsElementaryAbelian.subgroupOf hVle
  let gg : I := ⟨g,(show D ≤ I from le_sup_left) (mem_zpowers g)⟩
  let vv : I := ⟨v,hVle hv⟩
  have hgen : zpowers gg ⊔ U = ⊤ := by
    apply (map_injective I.subtype_injective)
    rw [Subgroup.map_sup,MonoidHom.map_zpowers,map_subgroupOf_eq_of_le hVle,
      ← MonoidHom.range_eq_map,range_subtype]
    rfl
  have hvU : vv ∈ U := hv
  have hi' : vv*gg*vv⁻¹=gg⁻¹ := Subtype.ext hi
  have hsign' : ∀w∈U,w*gg*w⁻¹=gg ∨ w*gg*w⁻¹=gg⁻¹ := by
    intro w hw
    rcases hsign w hw with h | h
    · exact Or.inl (Subtype.ext h)
    · exact Or.inr (Subtype.ext h)
  have ho' : Odd (orderOf gg) := by rwa [← Subgroup.orderOf_coe]
  have hg' : gg ≠ 1 := fun hh => hg (congrArg Subtype.val hh)
  have hcard : Nat.card I = orderOf g * Nat.card V := by
    simpa only [D,I,Nat.card_zpowers] using card_sup_eq_mul_of_normalizes_of_disjoint D V hn hdV
  have hidx : U.index = orderOf g := by
    have hh := U.card_mul_index
    rw [Nat.card_congr (subgroupOfEquivOfLe hVle).toEquiv,hcard] at hh
    have hpos : 0 < Nat.card V := Nat.card_pos
    nlinarith
  have hpU : IsPGroup 2 U := (IsElementaryAbelian.isPGroup 2 V).comap_subtype
  let S : Sylow 2 I := hpU.toSylow (by rw [hidx]; exact ho.not_two_dvd_nat)
  have hM : M.subgroupOf I = U := by
    ext x
    exact ⟨fun hx => hMI.le ⟨hx,x.property⟩,fun hx => hVM hx⟩
  have hquot := quotient_equiv_dihedral U gg vv hvU ho' hg' hgen hi' hsign'
  rw [← Subgroup.orderOf_coe,hord] at hquot
  refine ⟨⟨I,hVle,gg,?_,S,?_,hM,a,ha,?_⟩⟩
  · exact (Theory.GroupTheory.conjugate_join_eq_cyclic_sup U gg vv hvU ho' hi').trans hgen
  · exact map_subgroupOf_eq_of_le hVle
  · rwa [hM]

theorem residual_moves_elementary (T : Sylow 2 G) (V : Subgroup G)
    [IsElementaryAbelian 2 V] (hVT : V ≤ T)
    (hn : (V.subgroupOf (T : Subgroup G)).Normal)
    (hcore : pCore 2 G = ⊥) (hV : V ≠ ⊥) : ⁅pResidual 2 G,V⁆ ≠ ⊥ := by
  intro he
  have hR := commutator_eq_bot_iff_le_centralizer.mp he
  have hT := (normal_subgroupOf_iff_le_normalizer hVT).mp hn
  have hnormal : V.Normal := normalizer_eq_top_iff.mp (by
    apply top_unique
    rw [← pResidual_sup_sylow_eq_top T]
    exact sup_le (hR.trans (centralizer_le_normalizer _)) hT)
  have hh : V ≤ pCore 2 G := le_sSup ⟨hnormal,IsElementaryAbelian.isPGroup 2 V⟩
  exact hV (bot_unique (hcore ▸ hh))
end CFSG.Quasithin.ChapterE.Witnesses.Solvable
end
