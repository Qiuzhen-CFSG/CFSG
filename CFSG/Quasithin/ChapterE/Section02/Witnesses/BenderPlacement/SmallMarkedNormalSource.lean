module
public import CFSG.Quasithin.ChapterE.Section02.Witnesses.BenderPlacement.SmallNormalSource

/-!
# The marked solvable quaternion core

Retain the original pair I generated by V and one I-conjugate of V, together
with its exact S3 quotient and the normality of the same P=O2(I) in H. This
allows the later Omega argument to construct its cubic and involution actors
inside I without identifying H/P with S3.

Source: Aschbacher--Smith, E.2.17, printed pp.229--230; consumed in the
full Omega branch of 15.1.11, printed p.1089.
-/

public section
open Subgroup Theory.GroupTheory Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterE.Witnesses.BenderPlacement
variable {H D : Type*} [Group H] [Finite H] [Group D] [Finite D]
  {V U : Subgroup H} [IsElementaryAbelian 2 V]
theorem source_solvable_small_marked_normal_core
    {κ : GroupClass} (hH : IsSQTK κ H) (T : Sylow 2 H)
    (hP : ChapterB.IsMinimalParabolicOver T ⊤) (hs : Group.IsSolvable H)
    (hVT : V ≤ T) (hvn : (V.subgroupOf (T : Subgroup H)).Normal)
    (hVM : V ≤ (ChapterB.minimalParabolicMax T hP).pCoreIn 2)
    (hout : ¬ V ≤ ChapterB.minimalParabolicCore T hP)
    (hfit : generalizedFitting H = pCore 2 H) (hV : Nat.card V = 16)
    (hTU : (T : Subgroup H) ≤ U) (hU : U ≤ normalizer (V : Set H))
    (q : U →* D) (hq : Function.Surjective q)
    (hk : q.ker = (centralizer (V : Set H)).subgroupOf U)
    (hD : Nat.card D ≤ 4)
    (hratio : 1 < cubicRatio (DihedralCubic.representation U V hU q hq hk))
    (hres : (pResidual 2 (ChapterB.minimalParabolicMax T hP)).map
      (ChapterB.minimalParabolicMax T hP).subtype ≤ centralizer (V : Set H)) :
    ∃ I : Subgroup H, V ≤ I ∧
      (∃ g : I, V.subgroupOf I ⊔ (V.subgroupOf I).map (MulAut.conj g).toMonoidHom = ⊤) ∧
      let P := I.pCoreIn 2
      P.Normal ∧ P ≤ (T : Subgroup H) ∧
        Nonempty (QuaternionCentralProductData P) ∧
        U = P ⊔ (U ⊓ centralizer (V : Set H)) ∧
        P ⊓ centralizer (V : Set H) = P ⊓ V ∧
        ⁅U ⊓ centralizer (V : Set H),P⁆ ≤ P ⊓ V ∧
        Nonempty ((I ⧸ pCore 2 I) ≃* DihedralGroup 3) := by
  obtain ⟨w₀⟩ := Solvable.solvable_witness T hP hs V hVT hvn hVM hout
  let w : OriginalWitness T (ChapterB.minimalParabolicMax T hP) V 1 :=
    OriginalWitness.of_dihedral w₀
  have hTV := (normal_subgroupOf_iff_le_normalizer hVT).mp hvn
  obtain ⟨hn,hPT,hd,hprod,hint,hcomm⟩ := w.small_normal_core_of_solvable hH hP hs
    hVT hTV hVM hout hfit hV hTU hU q hq hk hD hratio hres
  have hNV := ChapterE.minimalParabolic_normalizer_le T hP V
    (IsElementaryAbelian.isPGroup 2 V) hTV hout
  have hsmall := w.small_quaternion_core hVT hTV hVM hNV hfit hV
    hTU hU q hq hk hD hratio
  exact ⟨w.pair.subgroup,w.pair.le,⟨w.pair.conjugator,w.pair.generate⟩,
    hn,hPT,hd,hprod,hint,hcomm,hsmall.2.2.2.1⟩
end CFSG.Quasithin.ChapterE.Witnesses.BenderPlacement
