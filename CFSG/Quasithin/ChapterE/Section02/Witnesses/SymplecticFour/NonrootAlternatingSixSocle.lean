module

public import Theory.SpecificGroups.AlternatingSix.InvolutionGeneratedExtension
public import Theory.SpecificGroups.SymplecticFour.TwoConjugate.InvolutionGenerated
public import Theory.SpecificGroups.SymplecticFour.TwoConjugate.NonrootSocle
public import CFSG.Quasithin.ChapterE.Section02.Witnesses.SymplecticFour.NonrootAlternatingSix

/-!
# Excluding an A₆ socle in the original root-free symplectic pair

Root avoidance makes every involution centralizer of the literal opposite
pair a two-group. The pair is generated by the original elementary group
and its opposite, hence by involutions. For an A₆ socle, each generating
involution induces an inner automorphism, and self-centralization of the
generalized Fitting subgroup puts all generators in the socle. The pair
itself is therefore A₆, contradicting the proved central-plane exclusion.

The original-source application retains the same component inclusion and
the same pullback of V. It assumes no placement of V in the socle and
removes possible outer extensions. Source: Aschbacher--Smith E.2.7,
printed p.220, the all-c₂ automorphism-centralizer step.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterE.Witnesses.SymplecticFour
open Theory.SpecificGroups.SymplecticFour TwoConjugate InvolutionTypes
open DiagramAutomorphisms EvenBorelTorus ChapterB
open Representation.OneCohomology.SymplecticFour
variable {F : Type*} [Field F] [Finite F] [CharP F 2]

omit [Finite F] in
private theorem not_root_axis_of_nonroot_pair
    (V : Subgroup (Sp F)) (hr : 2<Nat.card V)
    (hnr : ∀ g ∈ oppositePair V, ¬IsRootElement g) (r : Fin 8) :
    ¬V≤RootSubgroup.group r := by
  intro hroot
  have hne : V≠⊥ := by
    intro he
    subst V
    simp at hr
  obtain ⟨⟨v,hv⟩,hv1⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hne
  have hvne : v≠1 := fun he => hv1 (Subtype.ext he)
  obtain ⟨t,ht⟩ := (RootSubgroup.mem_group_iff r v).mp (hroot hv)
  have ht0 : t≠0 := by
    intro h
    apply hvne
    rw [←ht,h,RootSubgroup.element_zero]
  apply hnr v ((show V≤oppositePair V from le_sup_left) hv)
  refine ⟨1,r,t,ht0,?_⟩
  simpa only [one_mul,inv_one,mul_one] using ht.symm

/-- The A₆ socle alternative is impossible for the literal root-free
opposite pair of a central elementary subgroup of order greater than two. -/
theorem source_pair_socle_not_alternating_six {n : ℕ}
    (hF : Nat.card F=2^n) (V : Subgroup (Sp F)) [IsElementaryAbelian 2 V]
    (hc : V≤(center (unipotent (F := F))).map (unipotent (F := F)).subtype)
    (hr : 2<Nat.card V)
    (hnr : ∀ g ∈ oppositePair V, ¬IsRootElement g) :
    ¬Nonempty (generalizedFitting (oppositePair V) ≃* alternatingGroup (Fin 6)) := by
  rintro ⟨e⟩
  have he := AlternatingSix.equiv_of_involution_generated_socle e
    (oppositePair_involution_generated V)
    (subgroup_isPGroup_involution_centralizers_of_nonroot hF (oppositePair V) hnr)
  exact source_pair_not_alternating_six hF V hc
    (not_root_axis_of_nonroot_pair V hr hnr 0)
    (not_root_axis_of_nonroot_pair V hr hnr 4) hr he

/-- The actual moving actor supplies central placement, while the
extension argument removes any outside-socle generators. -/
theorem source_moving_pair_socle_not_alternating_six {n : ℕ}
    (hF : Nat.card F=2^n) (hn : 1<n)
    (a : ActorReduction.stabilizer (F := F)) (ha : ¬PreservesDiagram a.val)
    (V : Subgroup (Sp F)) [IsElementaryAbelian 2 V] (hVU : V≤unipotent)
    (hV : V.map a.val.toMonoidHom=V) (hr : 2<Nat.card V)
    (hnr : ∀ g ∈ oppositePair V, ¬IsRootElement g) :
    ¬Nonempty (generalizedFitting (oppositePair V) ≃* alternatingGroup (Fin 6)) := by
  obtain ⟨hc,_,_⟩ := source_moving_pair hF hn a ha V hVU hV hr
  exact source_pair_socle_not_alternating_six hF V hc hr hnr

/-- The original minimal-parabolic source excludes an A₆ model of the
generalized Fitting subgroup of its same marked pullback pair. -/
theorem source_original_pair_socle_not_alternating_six
    {G : Type*} [Group G] [Finite G] {n : ℕ}
    (hF : Nat.card F=2^n) (hn : 1<n)
    (T : Sylow 2 G) (hP : IsMinimalParabolicOver T ⊤)
    (hJ : minimalParabolicCore T hP=⊥)
    (L : Subgroup G) [L.Normal] [IsSimpleGroup L] (e : Sp F≃*L)
    (hmark : (T : Subgroup G).comap (L.subtype.comp e.toMonoidHom)=unipotent)
    (hgen : L⊔(T : Subgroup G)=⊤)
    (V : Subgroup G) [IsElementaryAbelian 2 V] (hVT : V≤T)
    (hVM : V≤(minimalParabolicMax T hP).pCoreIn 2)
    (hVN : (T : Subgroup G)≤normalizer (V : Set G)) (hr : 2<Nat.card V)
    (hnr : ∀ g ∈ oppositePair (V.comap (L.subtype.comp e.toMonoidHom)),
      ¬IsRootElement g) :
    ¬Nonempty (generalizedFitting
      (oppositePair (V.comap (L.subtype.comp e.toMonoidHom))) ≃*
        alternatingGroup (Fin 6)) := by
  let f := L.subtype.comp e.toMonoidHom
  let W := V.comap f
  have hf : Function.Injective f := L.subtype_injective.comp e.injective
  obtain ⟨_,hmap,hc,_,_⟩ := Structure.SymplecticFour.source_geometry
    hF hn T hP hJ L e hmark hgen V hVT hVM hVN hr
  have hcard : Nat.card W=Nat.card V := by
    rw [←hmap,card_map_of_injective hf]
  let j : W →* V := (f.comp W.subtype).codRestrict V (fun x => x.property)
  let : IsElementaryAbelian 2 W := IsElementaryAbelian.of_injective j (by
    intro x y h
    exact Subtype.ext (hf (congrArg (fun z : V => (z : G)) h)))
  exact source_pair_socle_not_alternating_six hF W hc (hcard.symm ▸ hr) hnr

end CFSG.Quasithin.ChapterE.Witnesses.SymplecticFour
