module
public import CFSG.Quasithin.ChapterE.Section02.Witnesses.SymplecticFour.WeakSource
public import CFSG.Quasithin.ChapterE.Section02.Witnesses.QuotientLift.Source
-- The marked-core lift intentionally uses the defining core as in MarkedLift.
import all CFSG.Quasithin.ChapterB.Section06To07.Structure

/-!
# Adapter for the remaining E.2.7 symplectic recognition cases

The E.2.7 recognition step supplies a literal two-conjugate pair on the
original V. Its quotient by the pair's marked maximal normal core is a
symplectic group over a (possibly proper) coefficient field. Once this marked
model, its Sylow and central-root placement are supplied, the E.2.13 cubic
estimate is already available for every original normalizing overgroup U. No
full-center cardinality or TI premise is required here.

This module records the recognition contract rather than claiming that the
unresolved middle-image extraction has been proved. The source obligation is
to construct `MarkedModel` from the literal opposite pair, including the
Borel/core and center markings.

Source: Aschbacher--Smith E.2.7--9 and E.2.13, printed pp.219--225.
-/

public section
noncomputable section
open Subgroup Theory.GroupTheory Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterE.Witnesses.SymplecticFour

variable {H : Type*} [Group H] [Finite H]

/-- A recognized E.2.7 pair retaining all data used by the E.2.13 actor bound.

`pair` is the literal pair generated by the original V and its internal
conjugate. `model` is the quotient by the pair's marked maximal-intersection
core; `center_placement` is the original Sylow-center placement. The field
need not be the ambient component field, so this covers proper coefficient
subfields and the binary Sp₄(2) case.
-/
structure MarkedModel
    (T : Sylow 2 H) (M V : Subgroup H) where
  pair : QuotientLift.Pair T M V
  F : Type
  [field : Field F]
  [finiteField : Finite F]
  [charTwo : CharP F 2]
  model : (pair.subgroup ⧸ (M.subgroupOf pair.subgroup).normalCore) ≃*
    Theory.SpecificGroups.SymplecticFour.Sp F
  modelSylow : Sylow 2 (Theory.SpecificGroups.SymplecticFour.Sp F)
  borel_placement :
    ((M.subgroupOf pair.subgroup).map
      (QuotientGroup.mk' (M.subgroupOf pair.subgroup).normalCore)).map model.toMonoidHom =
      normalizer (modelSylow : Set (Theory.SpecificGroups.SymplecticFour.Sp F))
  center_placement :
    (V.subgroupOf pair.subgroup).map (model.toMonoidHom.comp
      (QuotientGroup.mk' (M.subgroupOf pair.subgroup).normalCore)) ≤
      (center modelSylow).map (modelSylow : Subgroup _).subtype
  exponent : ℕ
  field_card : Nat.card F = 2 ^ exponent
  exponent_positive : 0 < exponent

/-- A marked symplectic model gives the weak cubic bound for the literal
canonical action of every overgroup U containing the original Sylow. -/
theorem MarkedModel.cubicRatio_le_two
    (T : Sylow 2 H) (hP : ChapterB.IsMinimalParabolicOver T ⊤)
    (V U : Subgroup H) [IsElementaryAbelian 2 V]
    (hVT : V ≤ (T : Subgroup H)) (hvn : (V.subgroupOf T).Normal)
    (hVM : V ≤ (ChapterB.minimalParabolicMax T hP).pCoreIn 2)
    (hout : ¬ V ≤ ChapterB.minimalParabolicCore T hP)
    (hfit : generalizedFitting H = pCore 2 H)
    (hTU : (T : Subgroup H) ≤ U) (hU : U ≤ normalizer (V : Set H))
    (w : MarkedModel T (ChapterB.minimalParabolicMax T hP) V) :
    cubicRatio (DihedralCubic.canonicalAction U V hU) ≤ 2 := by
  let := DihedralCubic.centralizer_normal U V hU
  let := w.field
  let := w.finiteField
  let := w.charTwo
  have hTV : (T : Subgroup H) ≤ normalizer (V : Set H) :=
    (normal_subgroupOf_iff_le_normalizer hVT).mp hvn
  have hNV : normalizer (V : Set H) ≤ ChapterB.minimalParabolicMax T hP :=
    minimalParabolic_normalizer_le T hP V
      (IsElementaryAbelian.isPGroup 2 V) hTV hout
  have h := w.pair.hypotheses hVT hTV hVM hNV
  have hSU : (w.pair.sylow : Subgroup w.pair.subgroup).map
      w.pair.subgroup.subtype ≤ U :=
    w.pair.sylow_eq.le.trans (inf_le_left.trans hTU)
  have hproper : V.subgroupOf w.pair.subgroup ≠ ⊤ :=
    w.pair.proper_of_quotient_card_ne_one hNV (by
      rw [Nat.card_congr w.model.toEquiv]
      have hdiv : 2 ∣ Nat.card (Theory.SpecificGroups.SymplecticFour.Sp w.F) := by
        rw [Theory.SpecificGroups.SymplecticFour.card_sp, w.field_card]
        exact dvd_mul_of_dvd_left (dvd_mul_of_dvd_left
          ((dvd_pow_self 2 (Nat.ne_of_gt w.exponent_positive : w.exponent ≠ 0)).trans
            (dvd_pow_self _ (by decide : 4 ≠ 0))) _) _
      intro hone
      rw [hone] at hdiv
      norm_num at hdiv)
  let q : U →* (U ⧸ (centralizer (V : Set H)).subgroupOf U) :=
    QuotientGroup.mk' _
  have hh := DihedralCubic.ambient_cubic_actor_strict_symplectic_four_of_positive_exponent
    w.pair.le hU h hSU hproper (w.pair.fitting hTV hfit)
    w.exponent w.exponent_positive w.field_card w.model w.modelSylow
    w.center_placement q (QuotientGroup.mk'_surjective _)
    (QuotientGroup.ker_mk' _)
  exact hh.2.2.2.2.2.le

/-- Lift the recognized symplectic pair from the full minimal-parabolic core
quotient, preserving its coefficient field, Borel and original central image. -/
theorem MarkedModel.lift
    (T : Sylow 2 H) (hP : ChapterB.IsMinimalParabolicOver T ⊤)
    (V : Subgroup H) [IsElementaryAbelian 2 V]
    (hVT : V ≤ T) (hvn : (V.subgroupOf (T : Subgroup H)).Normal)
    (hVM : V ≤ (ChapterB.minimalParabolicMax T hP).pCoreIn 2)
    (w : MarkedModel
      (T.mapSurjective (QuotientGroup.mk'_surjective (ChapterB.minimalParabolicCore T hP)))
      ((ChapterB.minimalParabolicMax T hP).map (QuotientGroup.mk' (ChapterB.minimalParabolicCore T hP)))
      (V.map (QuotientGroup.mk' (ChapterB.minimalParabolicCore T hP)))) :
    Nonempty (MarkedModel T (ChapterB.minimalParabolicMax T hP) V) := by
  let := w.field
  let := w.finiteField
  let := w.charTwo
  let M := ChapterB.minimalParabolicMax T hP
  let J := ChapterB.minimalParabolicCore T hP
  let q := QuotientGroup.mk' J
  let B := M.map q
  obtain ⟨w',r,hr,hrq,e,he⟩ := QuotientLift.lift_pair T hP V hVT hvn hVM w.pair
  have hrV : (V.subgroupOf w'.subgroup).map r = (V.map q).subgroupOf w.pair.subgroup := by
    ext y
    constructor
    · rintro ⟨x,hx,rfl⟩
      change (r x : H ⧸ J) ∈ V.map q
      rw [hrq]
      exact mem_map_of_mem q hx
    · intro hy
      obtain ⟨x,hx,hxy⟩ := hy
      let z : w'.subgroup := ⟨x,w'.le hx⟩
      refine ⟨z,hx,Subtype.ext ?_⟩
      rw [hrq]
      exact hxy
  have hemap : (e.trans w.model).toMonoidHom.comp (QuotientGroup.mk' _) =
      (w.model.toMonoidHom.comp (QuotientGroup.mk' _)).comp r := by
    apply MonoidHom.ext
    intro x
    change w.model (e (QuotientGroup.mk' _ x)) = w.model (QuotientGroup.mk' _ (r x))
    rw [he]
  have hMpre : B.comap q = M := by
    rw [comap_map_eq,QuotientGroup.ker_mk']
    exact sup_eq_left.mpr (normalCore_le M)
  have hApre : (B.subgroupOf w.pair.subgroup).comap r = M.subgroupOf w'.subgroup := by
    ext x
    change (r x : H ⧸ J) ∈ B ↔ (x : H) ∈ M
    rw [hrq]
    exact SetLike.ext_iff.mp hMpre (x : H)
  have hAmap : (M.subgroupOf w'.subgroup).map r = B.subgroupOf w.pair.subgroup := by
    rw [←hApre,map_comap_eq_self_of_surjective hr]
  refine ⟨{
    pair := w'
    F := w.F
    field := w.field
    finiteField := w.finiteField
    charTwo := w.charTwo
    model := e.trans w.model
    modelSylow := w.modelSylow
    exponent := w.exponent
    field_card := w.field_card
    exponent_positive := w.exponent_positive
    borel_placement := ?_
    center_placement := ?_ }⟩
  · rw [map_map,hemap,←map_map,hAmap,←map_map]
    exact w.borel_placement
  · rw [hemap,←map_map,hrV]
    exact w.center_placement

/-- E.2.7 recognition contract on the original V. The Bender alternative may
use a smaller subgroup containing V, as in the all-Suzuki-involution route;
the symplectic alternative retains its own coefficient field. -/
def HasRecognizedPair (T : Sylow 2 H) (M V : Subgroup H) : Prop :=
  (∃ n, Nonempty (BenderPlacement.OriginalWitness T M V n)) ∨
    Nonempty (MarkedModel T M V)

/-- A literal Bender witness supplies the first recognition alternative. -/
theorem HasRecognizedPair.of_originalWitness
    {T : Sylow 2 H} {M V : Subgroup H} {n : ℕ}
    (w : BenderPlacement.OriginalWitness T M V n) : HasRecognizedPair T M V :=
  Or.inl ⟨n,⟨w⟩⟩

/-- A marked coefficient-field model supplies the symplectic alternative. -/
theorem HasRecognizedPair.of_markedModel
    {T : Sylow 2 H} {M V : Subgroup H} (w : MarkedModel T M V) :
    HasRecognizedPair T M V := Or.inr ⟨w⟩

/-- Actual source consumer of either recognized pair alternative. This is
conditional precisely on E.2.7 recognition, not on any numerical estimate. -/
theorem source_cubicRatio_le_two_of_recognized_pair
    (T : Sylow 2 H) (hP : ChapterB.IsMinimalParabolicOver T ⊤)
    (V U : Subgroup H) [IsElementaryAbelian 2 V]
    (hVT : V ≤ (T : Subgroup H)) (hvn : (V.subgroupOf T).Normal)
    (hVM : V ≤ (ChapterB.minimalParabolicMax T hP).pCoreIn 2)
    (hout : ¬ V ≤ ChapterB.minimalParabolicCore T hP)
    (hfit : generalizedFitting H = pCore 2 H)
    (hTU : (T : Subgroup H) ≤ U) (hU : U ≤ normalizer (V : Set H))
    (hr : HasRecognizedPair T (ChapterB.minimalParabolicMax T hP) V) :
    cubicRatio (DihedralCubic.canonicalAction U V hU) ≤ 2 := by
  rcases hr with hb | hs
  · obtain ⟨n,⟨w⟩⟩ := hb
    exact BenderPlacement.original_witness_cubicRatio_le_two hP hVT hvn hVM
      hout hfit w hTU hU
  · obtain ⟨w⟩ := hs
    exact MarkedModel.cubicRatio_le_two T hP V U hVT hvn hVM hout hfit hTU hU w

/-- The original source cubic bound after recognition in H/J. Both branches
lift the literal original V through the full marked maximal core. -/
theorem source_cubicRatio_le_two_of_recognized_star
    (T : Sylow 2 H) (hP : ChapterB.IsMinimalParabolicOver T ⊤)
    (V U : Subgroup H) [IsElementaryAbelian 2 V]
    (hVT : V ≤ (T : Subgroup H)) (hvn : (V.subgroupOf T).Normal)
    (hVM : V ≤ (ChapterB.minimalParabolicMax T hP).pCoreIn 2)
    (hout : ¬ V ≤ ChapterB.minimalParabolicCore T hP)
    (hfit : generalizedFitting H = pCore 2 H)
    (hTU : (T : Subgroup H) ≤ U) (hU : U ≤ normalizer (V : Set H))
    (hr : HasRecognizedPair
      (T.mapSurjective (QuotientGroup.mk'_surjective (ChapterB.minimalParabolicCore T hP)))
      ((ChapterB.minimalParabolicMax T hP).map (QuotientGroup.mk' (ChapterB.minimalParabolicCore T hP)))
      (V.map (QuotientGroup.mk' (ChapterB.minimalParabolicCore T hP)))) :
    cubicRatio (DihedralCubic.canonicalAction U V hU) ≤ 2 := by
  apply source_cubicRatio_le_two_of_recognized_pair T hP V U hVT hvn hVM hout hfit hTU hU
  rcases hr with hb | hs
  · obtain ⟨n,w⟩ := hb
    exact Or.inl ⟨n,w.elim (BenderPlacement.lift_original_witness T hP V hVT hvn hVM)⟩
  · exact Or.inr (hs.elim (MarkedModel.lift T hP V hVT hvn hVM))

end CFSG.Quasithin.ChapterE.Witnesses.SymplecticFour
