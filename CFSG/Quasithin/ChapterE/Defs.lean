module

public import Theory.GroupTheory.CentralizerModulo
public import Theory.PGroupCore
public import Theory.ElementaryAbelian.Basic
public import Theory.GroupTheory.GeneralizedFitting.Defs
public import Theory.GroupTheory.SolvableRadical
public import Theory.GroupTheory.SolvableResidual
public import Theory.GroupTheory.PResidual.Defs
public import Mathlib.GroupTheory.Sylow
public import Mathlib.GroupTheory.Rank

/-!
# E-generation: source definitions

These are Definitions E.1.1, E.1.2, E.1.5, E.1.6 and E.1.9 of
Aschbacher--Smith, *The Classification of Quasithin Groups*, combined manuscript
of 1 March 2004, pp.209--211. All quotients are intrinsic to the indicated
subgroup. The radical `O_∞` and residual `G^∞` are distinct; `pResidual 2`
denotes `O^2`, never `O₂`.

The structural series in (E1) and (E2) are expressed by their final quotient:
`K/O_{2,p}(K)` and `(K/O_∞(K))/E(K/O_∞(K))` are 2-groups, respectively.
The component in (E2) generates the layer under the *local* tau subgroup,
not the ambient tau subgroup. Joins express generated products.

The natural-number infimum defining `generationParameter` follows the source
minimum convention. Its set must be proved nonempty for even-order groups
before invoking a minimum specification; that generation theorem is a separate
proof obligation, not an assumption in these definitions.
-/

@[expose] public section
namespace CFSG.Quasithin.ChapterE
open Subgroup
open Theory.GroupTheory

variable {G : Type*} [Group G]

/-- E.1.1: `C_T(AO₂(G)/O₂(G))`, viewed as a subgroup of `G`. -/
def tau (T A : Subgroup G) : Subgroup G := centralizerModulo T A (pCore 2 G)

/-- A group is 2-closed when it has a normal Sylow 2-subgroup. -/
def IsTwoClosed (H : Type*) [Group H] : Prop :=
  ∃ S : Sylow 2 H, (S : Subgroup H).Normal

/-- A normal subgroup with a 2-group quotient; normality is explicit. -/
def HasTwoGroupQuotient {H : Type*} [Group H] (N : Subgroup H) : Prop :=
  ∃ hN : N.Normal, @IsPGroup 2 (H ⧸ N) (@QuotientGroup.Quotient.group H _ N hN)

/-- The orbit-generated subgroup under conjugation by `D`. -/
def conjugateJoin {H : Type*} [Group H] (D L : Subgroup H) : Subgroup H :=
  ⨆ d : D, L.map (MulAut.conj (d : H)).toMonoidHom

variable [Finite G]

/-- E.1.2(E1), including the exact rank-one condition on the image of `A`. -/
def ECaseOdd (A K : Subgroup G) : Prop :=
  let Q := K ⧸ pCore 2 K
  let a := (A.subgroupOf K).map (QuotientGroup.mk' (pCore 2 K))
  ∃ p : ℕ, p.Prime ∧ Odd p ∧
    IsPGroup 2 (Q ⧸ pCore p Q) ∧
    pCore p Q ≠ ⊥ ∧ pCore p Q = ⁅pCore p Q, a⁆ ∧ Group.rank a = 1

/-- E.1.2(E2), with its local tau orbit and both alternatives retained. -/
def ECaseComponent (T A K : Subgroup G) : Prop :=
  let R := solvableRadical K
  let Q := K ⧸ R
  let q := QuotientGroup.mk' R
  let a := (A.subgroupOf K).map q
  let d := (tau (T.subgroupOf K) (A.subgroupOf K)).map q
  IsTwoClosed R ∧ HasTwoGroupQuotient (componentLayer Q) ∧
    pResidual 2 K = solvableResidual K ∧
    ∃ L : Subgroup Q, IsComponent Q L ∧ componentLayer Q = conjugateJoin d L ∧
      (L = ⁅L, a⁆ ∨ (¬ a ≤ normalizer (L : Set Q)) ∧ Group.rank a = 1)

/-- E.1.2. The elementary-abelian and containment conditions make the source
standing assumptions explicit. `T.subgroupOf K` is precisely `T ∩ K` in `K`. -/
def IsEMember (T A K : Subgroup G) : Prop :=
  IsElementaryAbelian 2 A ∧ A ≤ T ∧ A ≤ K ∧
    tau T A ≤ T ⊓ K ∧
    (∃ S : Sylow 2 K, (S : Subgroup K) = T.subgroupOf K) ∧
    (ECaseOdd A K ∨ ECaseComponent T A K)

/-- E.1.5: the rank bound is taken in the quotient for the relevant branch. -/
def IsEMemberAt (i : ℕ) (T A K : Subgroup G) : Prop :=
  IsEMember T A K ∧
    ((ECaseOdd A K ∧
      Group.rank ((A.subgroupOf K).map (QuotientGroup.mk' (pCore 2 K))) ≤ i) ∨
    (ECaseComponent T A K ∧
      Group.rank ((A.subgroupOf K).map (QuotientGroup.mk' (solvableRadical K))) ≤ i))

/-- The subgroup generated by the members of `ℰᵢ(G,T,A)`. -/
def eSubgroup (i : ℕ) (T A : Subgroup G) : Subgroup G :=
  sSup {K : Subgroup G | IsEMemberAt i T A K}

/-- E.1.5: `Eᵢ(G,T,Ω)`, generated over the members of `Ω` contained in `T`. -/
def eFamilySubgroup (i : ℕ) (T : Subgroup G) (Ω : Set (Subgroup G)) : Subgroup G :=
  ⨆ A : {A : Subgroup G // A ∈ Ω ∧ A ≤ T}, eSubgroup i T A.1

/-- E.1.5: `W(X,Ω) = ⟨A ∈ Ω : A ≤ X⟩`. -/
def weakClosure (X : Subgroup G) (Ω : Set (Subgroup G)) : Subgroup G :=
  sSup {A : Subgroup G | A ∈ Ω ∧ A ≤ X}

/-- A conjugation-invariant collection of elementary abelian 2-subgroups. -/
def IsElementaryFamily (Ω : Set (Subgroup G)) : Prop :=
  (∀ A ∈ Ω, IsElementaryAbelian 2 A) ∧
    ∀ (g : G) (A : Subgroup G), A ∈ Ω → A.map (MulAut.conj g).toMonoidHom ∈ Ω

/-- E.1.5: generation at the specified Sylow subgroup. -/
def IsEGeneratedAt (i : ℕ) (T : Sylow 2 G) : Prop :=
  ∀ Ω : Set (Subgroup G), IsElementaryFamily Ω →
    eFamilySubgroup i (T : Subgroup G) Ω ⊔
      normalizer (weakClosure (T : Subgroup G) Ω : Set G) = ⊤

/-- E.1.5: generation, independently of a choice of Sylow subgroup. -/
def IsEGenerated (i : ℕ) (G : Type*) [Group G] [Finite G] : Prop :=
  ∀ T : Sylow 2 G, IsEGeneratedAt i T

/-- E.1.6: odd-order groups have parameter zero; otherwise take the least
positive generation bound. Nonemptiness is required for its specification. -/
noncomputable def generationParameter (G : Type*) [Group G] [Finite G] : ℕ :=
  if Odd (Nat.card G) then 0 else sInf {i : ℕ | 0 < i ∧ IsEGenerated i G}

/-- E.1.9: minimal supplements over `T` to the kernel `Y` inside `X T`.
Normality and `Y ≤ X` are hypotheses of the theorems using this definition. -/
def IsMinimalSupplement (T X Y K : Subgroup G) : Prop :=
  Minimal (fun J : Subgroup G => T ≤ J ∧ J ≤ X ⊔ T ∧ J ⊔ Y = X ⊔ T) K

end CFSG.Quasithin.ChapterE
