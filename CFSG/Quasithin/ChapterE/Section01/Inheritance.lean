module

public import CFSG.Quasithin.ChapterE.Defs
public import CFSG.Quasithin.ChapterE.Section01.Basic
public import Theory.GroupTheory.CComponent.Structure
public import CFSG.Quasithin.ChapterE.Section01.Inheritance.Tau
public import CFSG.Quasithin.ChapterE.Section01.Inheritance.IntrinsicTransport

/-!
# Normal generation, inheritance, and transport of E-members

E.1.4 uses the intrinsic normal closure of `A` in `K`. In the odd-prime
branch the relevant normal p-core is generated by commutators with `A`;
after killing the normal closure, both the kernel and quotient are 2-groups.
In the component branch the radical-free commutator dichotomy puts the
chosen component in this normal closure even when `A` moves it. Normality
then captures its entire tau orbit. The resulting quotient is solvable, and
`O²(K) = K∞` finishes the argument.

The successive intrinsic tau inclusions give the full chain in E.1.8(1).
The subgroup embedding preserves the local Sylow intersection, the two
intrinsic alternatives and their quotient ranks, establishing E.1.8(2).
Isomorphisms also preserve E-members, their generated subgroups, weak closure,
and the generation property. Sylow conjugacy then makes generation at one
Sylow subgroup sufficient for generation at every Sylow subgroup.

Source: Aschbacher--Smith, *The Classification of Quasithin Groups*,
Lemmas E.1.4 and E.1.8, printed pp.210--211 (1 March 2004 manuscript).
-/

@[expose] public section
open Subgroup
open Theory.GroupTheory
namespace CFSG.Quasithin.ChapterE
variable {G Q : Type*} [Group G] [Group Q]

private theorem quotient_lift_kernel (q : G →* Q) (N : Subgroup G) [N.Normal]
    [(N.map q).Normal] :
    (QuotientGroup.lift N ((QuotientGroup.mk' (N.map q)).comp q)
      (by intro n hn; exact (QuotientGroup.eq_one_iff _).mpr (mem_map_of_mem q hn))).ker ≤
      q.ker.map (QuotientGroup.mk' N) := by
  intro x hx
  obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective N x
  have hg : q g ∈ N.map q := (QuotientGroup.eq_one_iff _).mp hx
  obtain ⟨n, hn, he⟩ := hg
  refine ⟨g * n⁻¹, ?_, ?_⟩
  · change q (g * n⁻¹) = 1
    simp only [map_mul, map_inv, he, mul_inv_cancel]
  · have hn' : (QuotientGroup.mk' N) n = 1 := (QuotientGroup.eq_one_iff _).mpr hn
    simp only [map_mul, map_inv, hn', inv_one, mul_one]

private theorem isPGroup_quotient_of_image {p : ℕ} (q : G →* Q)
    (hq : Function.Surjective q) (N : Subgroup G) [N.Normal]
    (hk : IsPGroup p q.ker)
    (hi : let := Normal.map (inferInstance : N.Normal) q hq; IsPGroup p (Q ⧸ N.map q)) :
    IsPGroup p (G ⧸ N) := by
  let := Normal.map (inferInstance : N.Normal) q hq
  let f := QuotientGroup.lift N ((QuotientGroup.mk' (N.map q)).comp q)
    (by intro n hn; exact (QuotientGroup.eq_one_iff _).mpr (mem_map_of_mem q hn))
  have hf : IsPGroup p f.ker :=
    (hk.map (QuotientGroup.mk' N)).to_le (quotient_lift_kernel q N)
  have htop := (hi.to_subgroup ⊤).comap_of_ker_isPGroup f hf
  rw [comap_top] at htop
  exact htop.of_equiv Subgroup.topEquiv

private theorem solvable_quotient_of_image (q : G →* Q)
    (hq : Function.Surjective q) (N : Subgroup G) [N.Normal]
    [Group.IsSolvable q.ker]
    (hi : let := Normal.map (inferInstance : N.Normal) q hq; Group.IsSolvable (Q ⧸ N.map q)) :
    Group.IsSolvable (G ⧸ N) := by
  let := Normal.map (inferInstance : N.Normal) q hq
  let := hi
  let f := QuotientGroup.lift N ((QuotientGroup.mk' (N.map q)).comp q)
    (by intro n hn; exact (QuotientGroup.eq_one_iff _).mpr (mem_map_of_mem q hn))
  have : Group.IsSolvable (q.ker.map (QuotientGroup.mk' N)) :=
    Group.isSolvable_of_surjective ((QuotientGroup.mk' N).subgroupMap_surjective q.ker)
  exact Group.isSolvable_of_ker_le_range (q.ker.map (QuotientGroup.mk' N)).subtype f
    (by simpa only [range_subtype] using quotient_lift_kernel q N)

private theorem isPGroup_quotient_of_le {p : ℕ} (R N : Subgroup G)
    [R.Normal] [N.Normal] (hRN : R ≤ N) (hR : IsPGroup p (G ⧸ R)) :
    IsPGroup p (G ⧸ N) :=
  hR.of_surjective (QuotientGroup.map R N (MonoidHom.id G) hRN)
    (QuotientGroup.map_surjective_of_surjective R N (MonoidHom.id G)
      QuotientGroup.mk_surjective hRN)

variable [Finite G]

/-- The odd-prime branch of E.1.4. -/
theorem ECaseOdd.residual_le_normalClosure {A K : Subgroup G} (h : ECaseOdd A K) :
    pResidual 2 K ≤ normalClosure (A.subgroupOf K : Set K) := by
  obtain ⟨p, hp, ho, hquot, hne, hcomm, hrank⟩ := h
  let N := normalClosure (A.subgroupOf K : Set K)
  let q := QuotientGroup.mk' (pCore 2 K)
  let : (N.map q).Normal := Normal.map inferInstance q (QuotientGroup.mk'_surjective _)
  have hA : (A.subgroupOf K).map q ≤ N.map q := map_mono le_normalClosure
  have hP : pCore p (K ⧸ pCore 2 K) ≤ N.map q := by
    rw [hcomm]
    exact (commutator_mono le_rfl hA).trans (commutator_le_right _ _)
  have hi : IsPGroup 2 ((K ⧸ pCore 2 K) ⧸ N.map q) :=
    isPGroup_quotient_of_le _ _ hP hquot
  have hk : IsPGroup 2 q.ker := by
    change IsPGroup 2 (QuotientGroup.mk' (pCore 2 K)).ker
    rw [QuotientGroup.ker_mk']
    exact pCore_isPGroup
  exact sInf_le ⟨inferInstance,
    isPGroup_quotient_of_image q (QuotientGroup.mk'_surjective _) N hk hi⟩

private theorem conjugateJoin_le_normal {H : Type*} [Group H]
    (D L N : Subgroup H) [N.Normal] (hL : L ≤ N) : conjugateJoin D L ≤ N := by
  apply iSup_le
  intro d
  rintro _ ⟨l, hl, rfl⟩
  exact (inferInstance : N.Normal).conj_mem l (hL hl) d

private theorem le_conjugateJoin {H : Type*} [Group H] (D L : Subgroup H) :
    L ≤ conjugateJoin D L := by
  apply le_iSup_of_le (⟨1, D.one_mem⟩ : D)
  intro x hx
  exact ⟨x, hx, by simp⟩

/-- The component branch of E.1.4, including a component moved by `A`. -/
theorem ECaseComponent.residual_le_normalClosure {T A K : Subgroup G}
    (h : ECaseComponent T A K) :
    pResidual 2 K ≤ normalClosure (A.subgroupOf K : Set K) := by
  obtain ⟨hclosed, ⟨hlayerNormal, hquot⟩, hres, L, hL, horbit, halt⟩ := h
  let N := normalClosure (A.subgroupOf K : Set K)
  let q := QuotientGroup.mk' (solvableRadical K)
  let : (N.map q).Normal := Normal.map inferInstance q (QuotientGroup.mk'_surjective _)
  let := hlayerNormal
  have hA : (A.subgroupOf K).map q ≤ N.map q := map_mono le_normalClosure
  have hLN : L ≤ N.map q := by
    have hc : ⁅L, (A.subgroupOf K).map q⁆ ≤ N.map q :=
      (commutator_mono le_rfl hA).trans (commutator_le_right _ _)
    rcases halt with heq | ⟨hnot, hrank⟩
    · exact heq ▸ hc
    · have hLC := isComponent_iff_isCComponent_map_solvableRadical.mp hL
      rcases cComponent_commutator_dichotomy_of_solvableRadical_eq_bot hLC
        solvableRadical_quotient_solvableRadical ((A.subgroupOf K).map q) with hz | heq
      · exact (hnot (le_normalizer_iff_commutator_le_left.mpr (hz ▸ bot_le))).elim
      · exact (le_conjugateJoin _ L).trans (heq ▸ hc)
  have hEN : componentLayer (K ⧸ solvableRadical K) ≤ N.map q := by
    rw [horbit]
    exact conjugateJoin_le_normal _ _ _ hLN
  have hi : IsPGroup 2 ((K ⧸ solvableRadical K) ⧸ N.map q) :=
    isPGroup_quotient_of_le _ _ hEN hquot
  have : Group.IsNilpotent ((K ⧸ solvableRadical K) ⧸ N.map q) := hi.isNilpotent
  have : Group.IsSolvable q.ker := by
    change Group.IsSolvable (QuotientGroup.mk' (solvableRadical K)).ker
    rw [QuotientGroup.ker_mk']
    infer_instance
  have : Group.IsSolvable (K ⧸ N) :=
    solvable_quotient_of_image q (QuotientGroup.mk'_surjective _) N inferInstance
  rw [hres]
  exact solvableResidual_le_of_solvable_quotient N

/-- Aschbacher--Smith E.1.4: the intrinsic normal closure of `A` in an
E-member contains its two-residual. -/
theorem IsEMember.residual_le_normalClosure {T A K : Subgroup G}
    (h : IsEMember T A K) :
    pResidual 2 K ≤ normalClosure (A.subgroupOf K : Set K) := by
  rcases h.2.2.2.2.2 with ho | hc
  · exact ho.residual_le_normalClosure
  · exact hc.residual_le_normalClosure

/-- E.1.8(1), with intrinsic taus embedded successively in the ambient group. -/
theorem IsEMemberAt.tau_chain {i : ℕ} (T : Sylow 2 G) (A H : Subgroup G)
    [IsElementaryAbelian 2 A] (hAT : A ≤ (T : Subgroup G))
    (hH : tau (T : Subgroup G) A ≤ H) {K : Subgroup H}
    (hK : IsEMemberAt i ((T : Subgroup G).subgroupOf H) (A.subgroupOf H) K) :
    A ⊔ pCore 2 G ≤ tau (T : Subgroup G) A ∧
    tau (T : Subgroup G) A ≤
      (tau ((T : Subgroup G).subgroupOf H) (A.subgroupOf H)).map H.subtype ∧
    (tau ((T : Subgroup G).subgroupOf H) (A.subgroupOf H)).map H.subtype ≤
      ((tau (((T : Subgroup G).subgroupOf H).subgroupOf K)
        ((A.subgroupOf H).subgroupOf K)).map K.subtype).map H.subtype ∧
    ((tau (((T : Subgroup G).subgroupOf H).subgroupOf K)
        ((A.subgroupOf H).subgroupOf K)).map K.subtype).map H.subtype ≤
      K.map H.subtype := by
  refine ⟨sup_pCore_le_tau T A hAT, tau_le_map_tau _ _ _ hH, ?_, ?_⟩
  · exact map_mono (tau_le_map_tau _ _ _ (hK.1.2.2.2.1.trans inf_le_right))
  · apply map_mono
    rintro _ ⟨x, hx, rfl⟩
    exact x.property

variable {H : Type*} [Group H] [Finite H]

omit [Finite G] [Finite H] in
private theorem mapped_local_sylow (f : G →* H) (hf : Function.Injective f)
    (T K : Subgroup G) (U : Subgroup H) (hU : U.comap f = T) :
    (T.map f).subgroupOf (K.map f) = U.subgroupOf (K.map f) := by
  ext x
  obtain ⟨y, hy, he⟩ := x.property
  change x.val ∈ T.map f ↔ x.val ∈ U
  rw [← he, mem_map_iff_mem hf, ← hU]
  rfl

/-- E-members pass through embeddings when the ambient tau lies in the image
and the ambient Sylow subgroup restricts to the original one. -/
theorem IsEMember.map_of_comap {T A K : Subgroup G} (h : IsEMember T A K)
    (f : G →* H) (hf : Function.Injective f) (U : Subgroup H)
    (hU : U.comap f = T) (htau : tau U (A.map f) ≤ K.map f) :
    IsEMember U (A.map f) (K.map f) := by
  let := h.1
  have hlocal := mapped_local_sylow f hf T K U hU
  refine ⟨IsElementaryAbelian.map f, ?_, map_mono h.2.2.1,
    le_inf (tau_le _ _) htau, ?_, ?_⟩
  · exact map_le_iff_le_comap.mpr (hU ▸ h.2.1)
  · obtain ⟨S, hS⟩ := h.2.2.2.2.1
    let e := K.equivMapOfInjective f hf
    refine ⟨S.mapSurjective (f := e.toMonoidHom) e.surjective, ?_⟩
    change (S : Subgroup K).map e.toMonoidHom = _
    rw [hS]
    exact (intrinsic_subgroupOf_map f hf T K).trans hlocal
  · rcases h.2.2.2.2.2 with ho | hc
    · exact Or.inl (ho.map_injective f hf)
    · right
      have hm := hc.map_injective f hf
      unfold ECaseComponent at hm ⊢
      rwa [hlocal] at hm

/-- The rank bound is unchanged in the embedding inheritance theorem. -/
theorem IsEMemberAt.map_of_comap {i : ℕ} {T A K : Subgroup G}
    (h : IsEMemberAt i T A K) (f : G →* H) (hf : Function.Injective f)
    (U : Subgroup H) (hU : U.comap f = T)
    (htau : tau U (A.map f) ≤ K.map f) : IsEMemberAt i U (A.map f) (K.map f) := by
  refine ⟨h.1.map_of_comap f hf U hU htau, ?_⟩
  rcases h.2 with ⟨ho, hr⟩ | ⟨hc, hr⟩
  · exact Or.inl ⟨ho.map_injective f hf, (rank_pCore_quotient_image_map f hf A K) ▸ hr⟩
  · right
    refine ⟨?_, (rank_solvableRadical_quotient_image_map f hf A K) ▸ hr⟩
    have hm := hc.map_injective f hf
    unfold ECaseComponent at hm ⊢
    rwa [mapped_local_sylow f hf T K U hU] at hm

/-- E.1.8(2): membership, with the same rank bound, passes to an overgroup. -/
theorem IsEMemberAt.inherit {i : ℕ} (T : Sylow 2 G) (A H : Subgroup G)
    [IsElementaryAbelian 2 A] (hAT : A ≤ (T : Subgroup G))
    (hH : tau (T : Subgroup G) A ≤ H) {K : Subgroup H}
    (hK : IsEMemberAt i ((T : Subgroup G).subgroupOf H) (A.subgroupOf H) K) :
    IsEMemberAt i (T : Subgroup G) A (K.map H.subtype) := by
  have hAH : A ≤ H := (le_sup_left.trans (sup_pCore_le_tau T A hAT)).trans hH
  have hm := hK.map_of_comap H.subtype Subtype.val_injective (T : Subgroup G) rfl
  rw [map_subgroupOf_eq_of_le hAH] at hm
  apply hm
  exact (tau_le_map_tau _ _ _ hH).trans (map_mono (hK.1.2.2.2.1.trans inf_le_right))

/-- E-members are invariant under group isomorphisms. -/
theorem IsEMember.map_equiv {T A K : Subgroup G} (h : IsEMember T A K)
    (e : G ≃* H) : IsEMember (T.map e.toMonoidHom) (A.map e.toMonoidHom)
      (K.map e.toMonoidHom) := by
  apply h.map_of_comap e.toMonoidHom e.injective (T.map e.toMonoidHom)
  · ext x; exact mem_map_iff_mem e.injective
  · rw [← map_tau_equiv]
    exact map_mono (h.2.2.2.1.trans inf_le_right)

/-- Ranked E-members are invariant under group isomorphisms. -/
theorem IsEMemberAt.map_equiv {i : ℕ} {T A K : Subgroup G} (h : IsEMemberAt i T A K)
    (e : G ≃* H) : IsEMemberAt i (T.map e.toMonoidHom) (A.map e.toMonoidHom)
      (K.map e.toMonoidHom) := by
  apply h.map_of_comap e.toMonoidHom e.injective (T.map e.toMonoidHom)
  · ext x; exact mem_map_iff_mem e.injective
  · rw [← map_tau_equiv]
    exact map_mono (h.1.2.2.2.1.trans inf_le_right)

/-- Conjugation transports an E-member, including its intrinsic component orbit. -/
theorem IsEMember.conj {T A K : Subgroup G} (h : IsEMember T A K) (g : G) :
    IsEMember (T.map (MulAut.conj g).toMonoidHom)
      (A.map (MulAut.conj g).toMonoidHom) (K.map (MulAut.conj g).toMonoidHom) :=
  h.map_equiv (MulAut.conj g)

/-- Conjugation preserves the rank bound of an E-member. -/
theorem IsEMemberAt.conj {i : ℕ} {T A K : Subgroup G} (h : IsEMemberAt i T A K) (g : G) :
    IsEMemberAt i (T.map (MulAut.conj g).toMonoidHom)
      (A.map (MulAut.conj g).toMonoidHom) (K.map (MulAut.conj g).toMonoidHom) :=
  h.map_equiv (MulAut.conj g)

private theorem map_eSubgroup_le (e : G ≃* H) (i : ℕ) (T A : Subgroup G) :
    (eSubgroup i T A).map e.toMonoidHom ≤
      eSubgroup i (T.map e.toMonoidHom) (A.map e.toMonoidHom) := by
  apply map_le_iff_le_comap.mpr
  apply sSup_le
  intro K hK
  exact map_le_iff_le_comap.mp (le_sSup (hK.map_equiv e))

/-- Isomorphisms carry the subgroup generated by ranked E-members to its counterpart. -/
theorem map_eSubgroup_equiv (e : G ≃* H) (i : ℕ) (T A : Subgroup G) :
    (eSubgroup i T A).map e.toMonoidHom =
      eSubgroup i (T.map e.toMonoidHom) (A.map e.toMonoidHom) := by
  apply le_antisymm (map_eSubgroup_le e i T A)
  have h := map_mono (f := e.toMonoidHom)
    (map_eSubgroup_le e.symm i (T.map e.toMonoidHom) (A.map e.toMonoidHom))
  simpa [map_map] using h

/-- Transport of the family-generated subgroup, with the family pulled back
along the isomorphism. -/
theorem map_eFamilySubgroup_equiv (e : G ≃* H) (i : ℕ) (T : Subgroup G)
    (Ω : Set (Subgroup H)) :
    (eFamilySubgroup i T {A | A.map e.toMonoidHom ∈ Ω}).map e.toMonoidHom =
      eFamilySubgroup i (T.map e.toMonoidHom) Ω := by
  unfold eFamilySubgroup
  rw [Subgroup.map_iSup]
  simp_rw [map_eSubgroup_equiv]
  apply le_antisymm
  · apply iSup_le
    intro A
    exact le_iSup_of_le ⟨A.val.map e.toMonoidHom, A.property.1, map_mono A.property.2⟩ le_rfl
  · apply iSup_le
    intro B
    let A := B.val.map e.symm.toMonoidHom
    have he : A.map e.toMonoidHom = B.val := by simp [A, map_map]
    have hAT : A ≤ T := by
      have hm := map_mono (f := e.symm.toMonoidHom) B.property.2
      simpa [map_map, A] using hm
    exact le_iSup_of_le
      ⟨A, by simpa only [Set.mem_ofPred_eq, he] using B.property.1, hAT⟩ (by rw [he])

omit [Finite G] [Finite H] in
/-- The weak closure in a subgroup is preserved by isomorphisms. -/
theorem map_weakClosure_equiv (e : G ≃* H) (T : Subgroup G)
    (Ω : Set (Subgroup H)) :
    (weakClosure T {A | A.map e.toMonoidHom ∈ Ω}).map e.toMonoidHom =
      weakClosure (T.map e.toMonoidHom) Ω := by
  apply le_antisymm
  · apply map_le_iff_le_comap.mpr
    apply sSup_le
    intro A hA
    exact map_le_iff_le_comap.mp (le_sSup ⟨hA.1, map_mono hA.2⟩)
  · apply sSup_le
    intro B hB
    let A := B.map e.symm.toMonoidHom
    have he : A.map e.toMonoidHom = B := by simp [A, map_map]
    have hAT : A ≤ T := by
      have hm := map_mono (f := e.symm.toMonoidHom) hB.2
      simpa [map_map, A] using hm
    rw [← he]
    exact map_mono (le_sSup ⟨by simpa only [Set.mem_ofPred_eq, he] using hB.1, hAT⟩)

omit [Finite G] [Finite H] in
/-- Pulling back an invariant elementary family along an isomorphism gives
an invariant elementary family. -/
theorem IsElementaryFamily.comap_equiv {Ω : Set (Subgroup H)}
    (hΩ : IsElementaryFamily Ω) (e : G ≃* H) :
    IsElementaryFamily {A | A.map e.toMonoidHom ∈ Ω} := by
  constructor
  · intro A hA
    let := hΩ.1 _ hA
    have h := IsElementaryAbelian.map (p := 2) (A := A.map e.toMonoidHom) e.symm.toMonoidHom
    have he : (A.map e.toMonoidHom).map e.symm.toMonoidHom = A := by simp [map_map]
    exact he ▸ h
  · intro g A hA
    have h := hΩ.2 (e g) (A.map e.toMonoidHom) hA
    have he : (A.map (MulAut.conj g).toMonoidHom).map e.toMonoidHom =
        (A.map e.toMonoidHom).map (MulAut.conj (e g)).toMonoidHom := by
      rw [map_map, map_map]
      congr 1
      ext x
      simp
    simpa only [Set.mem_ofPred_eq, he] using h

/-- Generation at a specified Sylow subgroup is invariant under isomorphism. -/
theorem IsEGeneratedAt.map_equiv {i : ℕ} {T : Sylow 2 G}
    (h : IsEGeneratedAt i T) (e : G ≃* H) :
    IsEGeneratedAt i (T.mapSurjective (f := e.toMonoidHom) e.surjective) := by
  intro Ω hΩ
  have hm := congrArg (Subgroup.map e.toMonoidHom)
    (h _ (hΩ.comap_equiv e))
  rw [Subgroup.map_sup, map_eFamilySubgroup_equiv,
    map_normalizer_eq_of_bijective _ e.bijective, map_weakClosure_equiv,
    map_top_of_surjective _ e.surjective] at hm
  exact hm

/-- Sylow conjugacy makes generation independent of the chosen Sylow subgroup. -/
theorem IsEGeneratedAt.of_sylow {i : ℕ} {T : Sylow 2 G}
    (h : IsEGeneratedAt i T) (U : Sylow 2 G) : IsEGeneratedAt i U := by
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq G T U
  have he : T.mapSurjective (f := (MulAut.conj g).toMonoidHom)
      (MulAut.conj g).surjective = g • T := by
    apply Sylow.ext
    rfl
  rw [← hg, ← he]
  exact h.map_equiv (MulAut.conj g)

/-- A generation proof for one Sylow subgroup supplies the source group property. -/
theorem IsEGeneratedAt.isEGenerated {i : ℕ} {T : Sylow 2 G}
    (h : IsEGeneratedAt i T) : IsEGenerated i G := h.of_sylow

/-- E-generation is preserved by group isomorphisms. -/
theorem IsEGenerated.map_equiv {i : ℕ} (h : IsEGenerated i G) (e : G ≃* H) :
    IsEGenerated i H := by
  obtain ⟨T⟩ := (inferInstance : Nonempty (Sylow 2 G))
  exact ((h T).map_equiv e).isEGenerated

end CFSG.Quasithin.ChapterE
