module

public import CFSG.Quasithin.ChapterE.Section01.ValuesEvenClassical.RankTwoUpper.LinearThreeCover
public import CFSG.Quasithin.ChapterE.Section01.ValuesEvenClassical.RankTwoUpper.LinearThree.LocalMembers
public import CFSG.Quasithin.ChapterE.Section01.ValuesEvenClassical.RankTwoUpper.LinearThree.InnerFamilies
public import CFSG.Quasithin.ChapterE.Section01.ValuesEvenClassical.RankTwoUpper.LinearThree.OuterFamilies
public import CFSG.Quasithin.ChapterE.Section01.ValuesEvenClassical.RankOneUpper.SimpleSocle
public import CFSG.Quasithin.ChapterE.Section01.Inheritance

/-!
# PSL₃ upper E-generation

`isEGenerated_of_source` proves the upper-generation half of the PSL₃ clause
of E.1.14(1), including graph and field extensions and the binary field.
Its numerical corollary gives n(G) ≤ f.

Small nontrivial elementary actors give a whole-group E-member through the
simple generalized-Fitting calculation. For large families, `InnerFamilies`
uses the point and line locals enlarged by their normalizing tau subgroups,
while `OuterFamilies` uses actual involution centralizers. Both calculations
place the two transported parabolics inside the subgroup generated by the
E-members and the weak-closure normalizer. That normalizer contains T, so
the proved two-parabolic cover finishes generation.

To discharge Sylow alignment, choose a Sylow subgroup containing the image
of the standard unipotent group. The original equation G = LT makes G/L a
two-group, so L also supplements the chosen Sylow subgroup. The conditional
assembly interfaces below remain available, but the final source theorem
discharges all their component and local-containment premises.

Source: Aschbacher--Smith, *The Classification of Quasithin Groups*,
E.1.1--6 and E.1.14(1), printed pp.209--211, 214. The latter cites
Aschbacher, *GF(2)-representations of finite groups* (1982), Lemma 4.7,
DOI 10.2307/2374202. The proof here uses the independently proved model
calculations and the corrected local tau convention of E.1.2.
-/

public section

open Subgroup Theory.GroupTheory Matrix.PSL3.LinearThree
open scoped MatrixGroups
namespace CFSG.Quasithin.ChapterE.ValuesEvenClassical.RankTwoUpper.LinearThree
variable {G F : Type*} [Group G] [Finite G] [Field F] [Finite F]

/-- The two actual parabolics suffice once the local calculations put them
inside the E-generation subgroup. T is supplied by the weak-closure normalizer. -/
theorem isEGeneratedAt_of_large_family_parabolics (L : Subgroup G)
    (e : L ≃* PSL(3,F)) (T : Sylow 2 G) {f : ℕ}
    (hLT : L ⊔ (T : Subgroup G) = ⊤)
    (hcomponent : ∀ A : Subgroup G, IsElementaryAbelian 2 A →
      A ≤ (T : Subgroup G) → A ≠ ⊥ → ECaseComponent (T : Subgroup G) A ⊤)
    (hlarge : ∀ Ω : Set (Subgroup G), IsElementaryFamily Ω →
      (∃ A ∈ Ω, A ≤ (T : Subgroup G) ∧ A ≠ ⊥) →
      (∀ A ∈ Ω, A ≤ (T : Subgroup G) → A ≠ ⊥ → f < Group.rank A) →
      let M := eFamilySubgroup f (T : Subgroup G) Ω ⊔
        normalizer (weakClosure (T : Subgroup G) Ω : Set G)
      (pointParabolic F).map (linearThreeEmbedding L e) ≤ M ∧
        (lineParabolic F).map (linearThreeEmbedding L e) ≤ M) :
    IsEGeneratedAt f T := by
  classical
  intro Ω hΩ
  by_cases hsmall : ∃ A ∈ Ω, A ≤ (T : Subgroup G) ∧ A ≠ ⊥ ∧ Group.rank A ≤ f
  · obtain ⟨A, hA, hAT, hne, hrank⟩ := hsmall
    have hmem := RankOneUpper.isEMemberAt_top_of_component_and_rank T A
      (hΩ.1 A hA) hAT (hcomponent A (hΩ.1 A hA) hAT hne) hrank
    apply top_unique
    exact (show (⊤ : Subgroup G) ≤ eSubgroup f (T : Subgroup G) A from le_sSup hmem).trans
      ((le_iSup (fun B : {B : Subgroup G // B ∈ Ω ∧ B ≤ (T : Subgroup G)} =>
        eSubgroup f (T : Subgroup G) B.1) ⟨A, hA, hAT⟩).trans le_sup_left)
  · by_cases hex : ∃ A ∈ Ω, A ≤ (T : Subgroup G) ∧ A ≠ ⊥
    · have hbig : ∀ A ∈ Ω, A ≤ (T : Subgroup G) → A ≠ ⊥ → f < Group.rank A := by
        intro A hA hAT hne
        exact Nat.lt_of_not_ge (fun h => hsmall ⟨A, hA, hAT, hne, h⟩)
      obtain ⟨hP, hQ⟩ := hlarge Ω hΩ hex hbig
      have hT : (T : Subgroup G) ≤ eFamilySubgroup f (T : Subgroup G) Ω ⊔
          normalizer (weakClosure (T : Subgroup G) Ω : Set G) :=
        (Subgroup.le_normalizer.trans
          (RankOneUpper.normalizer_le_weakClosure_normalizer _ hΩ)).trans le_sup_right
      apply top_unique
      rw [← linearThreeOvergroups_generate L (T : Subgroup G) e hLT]
      apply sSup_le
      intro H hH
      rcases hH with rfl | hH
      · exact sup_le hP hT
      · rw [Set.mem_singleton_iff] at hH
        subst H
        exact sup_le hQ hT
    · have hW := RankOneUpper.weakClosure_eq_bot_of_members_eq_bot (T : Subgroup G) Ω
        (fun A hA hAT => by
          by_contra hne
          exact hex ⟨A, hA, hAT, hne⟩)
      rw [hW, normalizer_eq_top, sup_top_eq]

/-- The assembly separates large families meeting the socle from those whose
nontrivial members in T all involve an outer automorphism. Each premise still
requires the source local calculation, including graph and field actors. -/
theorem isEGenerated_of_inner_and_outer_family_parabolics (L : Subgroup G)
    (e : L ≃* PSL(3,F)) (T : Sylow 2 G) {f : ℕ}
    (hLT : L ⊔ (T : Subgroup G) = ⊤)
    (hcomponent : ∀ A : Subgroup G, IsElementaryAbelian 2 A →
      A ≤ (T : Subgroup G) → A ≠ ⊥ → ECaseComponent (T : Subgroup G) A ⊤)
    (hinner : ∀ Ω : Set (Subgroup G), IsElementaryFamily Ω →
      (∃ A ∈ Ω, A ≤ (T : Subgroup G) ∧ A ≠ ⊥ ∧ A ≤ L) →
      (∀ A ∈ Ω, A ≤ (T : Subgroup G) → A ≠ ⊥ → f < Group.rank A) →
      let M := eFamilySubgroup f (T : Subgroup G) Ω ⊔
        normalizer (weakClosure (T : Subgroup G) Ω : Set G)
      (pointParabolic F).map (linearThreeEmbedding L e) ≤ M ∧
        (lineParabolic F).map (linearThreeEmbedding L e) ≤ M)
    (houter : ∀ Ω : Set (Subgroup G), IsElementaryFamily Ω →
      (∃ A ∈ Ω, A ≤ (T : Subgroup G) ∧ A ≠ ⊥) →
      (∀ A ∈ Ω, A ≤ (T : Subgroup G) → A ≠ ⊥ → ¬ A ≤ L) →
      (∀ A ∈ Ω, A ≤ (T : Subgroup G) → A ≠ ⊥ → f < Group.rank A) →
      let M := eFamilySubgroup f (T : Subgroup G) Ω ⊔
        normalizer (weakClosure (T : Subgroup G) Ω : Set G)
      (pointParabolic F).map (linearThreeEmbedding L e) ≤ M ∧
        (lineParabolic F).map (linearThreeEmbedding L e) ≤ M) :
    IsEGenerated f G := by
  apply IsEGeneratedAt.isEGenerated (T := T)
  apply isEGeneratedAt_of_large_family_parabolics L e T hLT hcomponent
  intro Ω hΩ hex hbig
  by_cases hin : ∃ A ∈ Ω, A ≤ (T : Subgroup G) ∧ A ≠ ⊥ ∧ A ≤ L
  · exact hinner Ω hΩ hin hbig
  · exact houter Ω hΩ hex (fun A hA hAT hne hAL => hin ⟨A, hA, hAT, hne, hAL⟩) hbig

/-- The upper-generation half of the PSL₃ clause of E.1.14(1), for every
finite field of order 2^f with f > 0. The actual model equivalence and the
source simple-socle and supplement hypotheses suffice; Sylow alignment and
all inner, outer, and binary local calculations are discharged here. -/
theorem isEGenerated_of_source {K : GroupClass} (hG : IsSQTK K G)
    [IsSimpleGroup (generalizedFitting G)]
    (e : generalizedFitting G ≃* PSL(3,F)) (T : Sylow 2 G)
    {f : ℕ} (hf : 0 < f) (hF : Nat.card F = 2 ^ f)
    (hLT : generalizedFitting G ⊔ (T : Subgroup G) = ⊤) :
    IsEGenerated f G := by
  obtain ⟨S, hUS⟩ := ((unipotent_isTwoGroup F hF).map
    (linearThreeEmbedding (generalizedFitting G) e)).exists_le_sylow
  have hLS : generalizedFitting G ⊔ (S : Subgroup G) = ⊤ := by
    simpa only [sup_comm] using S.sup_eq_top_of_quotient_isPGroup
      (generalizedFitting G)
      (isPGroup_quotient_of_sup_eq_top (generalizedFitting G) T T.isPGroup' hLT)
  refine isEGenerated_of_inner_and_outer_family_parabolics
    (generalizedFitting G) e S hLS ?_ ?_ ?_
  · intro A _ _ hne
    exact RankOneUpper.eCaseComponent_top (OuterFamilies.socle_nonabelian e)
      T hLT (S : Subgroup G) A hne
  · exact InnerFamilies.parabolics_le_of_source hG e S hf hF hLS hUS
  · exact OuterFamilies.parabolics_le_of_large_outer_family e S hf hF hLS hUS

/-- The numerical upper bound in the PSL₃ clause of E.1.14(1). -/
theorem generationParameter_le_of_source {K : GroupClass} (hG : IsSQTK K G)
    [IsSimpleGroup (generalizedFitting G)]
    (e : generalizedFitting G ≃* PSL(3,F)) (T : Sylow 2 G)
    {f : ℕ} (hf : 0 < f) (hF : Nat.card F = 2 ^ f)
    (hLT : generalizedFitting G ⊔ (T : Subgroup G) = ⊤) :
    generationParameter G ≤ f :=
  generationParameter_le hf (isEGenerated_of_source hG e T hf hF hLT)

end CFSG.Quasithin.ChapterE.ValuesEvenClassical.RankTwoUpper.LinearThree
