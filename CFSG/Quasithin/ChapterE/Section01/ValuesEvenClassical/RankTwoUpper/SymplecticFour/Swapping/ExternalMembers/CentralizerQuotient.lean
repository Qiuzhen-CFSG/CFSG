/-!
# The swapping involution supplement and centralizer quotient

For odd field degree, the faithful outer action embeds G/L in Out(Sp₄(F)),
whose order divides twice the degree. Since a Sylow two-subgroup supplements
L, the quotient is a two-group and has order at most two. An element outside
the diagram kernel therefore supplements L.

For a swapping involution t with the specified inner conjugacy, the marked
fixed-group theorem identifies C_L(t) with the concrete Suzuki matrix group.
Inside C_G(t), the subgroup generated by t is central and complementary to
C_L(t). The resulting quotient is Suzuki; its trivial two-core then gives
O₂(C_G(t)) = ⟨t⟩, interpreted intrinsically in the centralizer.

`normalized_quotient_calculations` discharges the exact `hquotient` premise of
`ExternalMembers.exists_external_member_of_normalized_calculations`. The
structural calculation needs neither SQTK nor the elementary actor's rank
bound. Inner conjugacy remains the explicit earlier-source input; no descent
or centralizer Sylow geometry is assumed here.

Source: Aschbacher--Smith, E.1.1--2, E.1.5 and E.1.14(1), printed
pp.209--210,214, citing Aschbacher (1982), Lemma 4.7. The outer-order bound
uses GLS3 §2.5; the fixed Suzuki model is 16.1.4(7), printed p.1171, and
Huppert--Blackburn III, XI.3.1--3.6.
-/

public section

open Subgroup Theory.GroupTheory Theory.SpecificGroups.SymplecticFour
namespace CFSG.Quasithin.ChapterE.ValuesEvenClassical.RankTwoUpper.SymplecticFour.Swapping.ExternalMembers
open DiagramAutomorphisms BenderSuzuki.MatrixGroups
variable {G F : Type*} [Group G] [Finite G] [Field F] [Finite F] [CharP F 2]

/-- In odd degree any element outside the diagram kernel supplements the socle. -/
theorem swapping_sup_socle_eq_top [IsSimpleGroup (generalizedFitting G)]
    (e : Sp F ≃* generalizedFitting G) (T : Sylow 2 G)
    (hLT : generalizedFitting G ⊔ (T : Subgroup G) = ⊤)
    {f : ℕ} (hF : Nat.card F = 2 ^ f) (hodd : Odd f)
    (hq : 2 < Nat.card F) (t : G) (ht : t ∉ diagramKernel (generalizedFitting G) e hq) :
    generalizedFitting G ⊔ zpowers t = ⊤ := by
  let L := generalizedFitting G
  have hc := SimpleSocle.centralizer_eq_bot (symplectic_socle_nonabelian e hq)
  have hd : Nat.card (G ⧸ L) ∣ 2 * f := by
    have hi := Subgroup.card_dvd_of_injective (MulAut.outerAction L)
      (MulAut.outerAction_injective L hc)
    rw [← Nat.card_congr (MulAut.outerCongr e).toEquiv] at hi
    exact hi.trans (card_outer_dvd_two_mul hF hq
      SemilinearClassification.inner_field_of_preservesDiagram)
  have hp := isPGroup_quotient_of_sup_eq_top L (T : Subgroup G) T.isPGroup' hLT
  obtain ⟨k, hk⟩ := hp.exists_card_eq
  have hcop : (Nat.card (G ⧸ L)).Coprime f := by
    rw [hk]
    exact (Nat.coprime_two_left.mpr hodd).pow_left k
  have hd2 := hcop.dvd_of_dvd_mul_right hd
  have htL : t ∉ L := fun htL => ht (le_diagramKernel _ e hq htL)
  have htq : QuotientGroup.mk' L t ≠ 1 := by
    exact fun he => htL ((QuotientGroup.eq_one_iff t).mp he)
  have hcard : Nat.card (G ⧸ L) = 2 := by
    rcases (Nat.dvd_prime Nat.prime_two).mp hd2 with h1 | h2
    · let : Subsingleton (G ⧸ L) := (Nat.card_eq_one_iff_unique.mp h1).1
      exact (htq (Subsingleton.elim _ _)).elim
    · exact h2
  have hg := zpowers_eq_top_of_prime_card hcard htq
  have he := congrArg (fun K : Subgroup (G ⧸ L) => K.comap (QuotientGroup.mk' L)) hg
  rwa [← MonoidHom.map_zpowers, QuotientGroup.comap_map_mk', Subgroup.comap_top] at he

private theorem centralizer_core_and_quotient
    (L : Subgroup G) [L.Normal] (t : G) (htorder : orderOf t = 2)
    (htL : t ∉ L) (hgen : L ⊔ zpowers t = ⊤)
    (m : ℕ) (hm : 0 < m)
    (es : (L ⊓ centralizer ({t} : Set G) : Subgroup G) ≃* SuzukiMatrixGroup m) :
    let D := centralizer ({t} : Set G)
    pCore 2 D = (zpowers t).subgroupOf D ∧
      Nonempty ((D ⧸ pCore 2 D) ≃* SuzukiMatrixGroup m) := by
  classical
  let D := centralizer ({t} : Set G)
  let C := L ⊓ D
  let R := (zpowers t).subgroupOf D
  have hz : zpowers t ≤ D := zpowers_le.mpr (by
    rw [mem_centralizer_singleton_iff])
  have hmem (x : G) (hx : x ∈ zpowers t) : x = 1 ∨ x = t := by
    simpa [mem_zpowers_iff_mem_range_orderOf, htorder, Finset.range_add_one,
      Finset.range_zero, or_comm, eq_comm] using hx
  have hn : D ≤ normalizer (zpowers t : Set G) := by
    apply le_trans ?_ (centralizer_le_normalizer _)
    intro x hx
    rw [mem_centralizer_iff]
    intro y hy
    rcases hmem y hy with rfl | rfl
    · simp
    · exact (mem_centralizer_singleton_iff.mp hx).symm
  let : R.Normal := (normal_subgroupOf_iff_le_normalizer hz).mpr hn
  have hd : Disjoint (zpowers t) C := by
    apply disjoint_def.mpr
    intro x hx hC
    rcases hmem x hx with h1 | rfl
    · exact h1
    · exact (htL hC.1).elim
  have hCD : C ≤ D := inf_le_right
  have hprod : zpowers t ⊔ C = D := by
    apply le_antisymm (sup_le hz hCD)
    intro x hx
    have hxG : x ∈ L ⊔ zpowers t := hgen.symm ▸ mem_top x
    obtain ⟨l, hl, r, hr, hlr⟩ := mem_sup_of_normal_left.mp hxG
    have hlD : l ∈ D := by
      have := D.mul_mem hx (D.inv_mem (hz hr))
      simpa [← hlr] using this
    rw [← hlr]
    exact mul_mem ((le_sup_right : C ≤ zpowers t ⊔ C) ⟨hl, hlD⟩)
      ((le_sup_left : zpowers t ≤ zpowers t ⊔ C) hr)
  let eq : (D ⧸ R) ≃* SuzukiMatrixGroup m :=
    (relativeQuotientEquiv hz hCD hprod hd).trans es
  let φ : D →* SuzukiMatrixGroup m := eq.toMonoidHom.comp (QuotientGroup.mk' R)
  have hφ : Function.Surjective φ := eq.surjective.comp (QuotientGroup.mk'_surjective R)
  have hker : φ.ker = R := by
    rw [MonoidHom.ker_comp_of_injective _ _ eq.injective, QuotientGroup.ker_mk']
  have hp : IsPGroup 2 R := by
    apply IsPGroup.comap_subtype
    exact IsPGroup.of_card (n := 1) (by simpa only [Nat.card_zpowers, pow_one] using htorder)
  have hs : pCore 2 (SuzukiMatrixGroup m) = ⊥ := by
    let := (BenderSuzuki.External.huppert_blackburn_XI_3_6 m hm).1
    rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal (pCore 2 (SuzukiMatrixGroup m))
        inferInstance with h0 | htop
    · exact h0
    · have hpS : IsPGroup 2 (SuzukiMatrixGroup m) :=
        (htop ▸ (pCore_isPGroup (p := 2) (G := SuzukiMatrixGroup m))).of_equiv topEquiv
      let := hpS.isNilpotent
      exact (BenderSuzuki.External.suzukiMatrixGroup_not_isSolvable m hm inferInstance).elim
  have hcore : pCore 2 D = R := by
    have hh := φ.comap_pCore_of_ker_isPGroup hφ (hker.symm ▸ hp)
    rw [hs, MonoidHom.comap_bot, hker] at hh
    exact hh.symm
  exact ⟨hcore, ⟨(QuotientGroup.quotientMulEquivOfEq hcore).trans eq⟩⟩

/-- The specified conjugacy gives the involution supplement, the exact intrinsic
centralizer two-core, and its concrete Suzuki quotient. -/
theorem centralizer_core_eq_and_quotient_of_conjugacy [IsSimpleGroup (generalizedFitting G)]
    (e : Sp F ≃* generalizedFitting G) (T : Sylow 2 G)
    (hLT : generalizedFitting G ⊔ (T : Subgroup G) = ⊤)
    {f : ℕ} (hF : Nat.card F = 2 ^ f) (hf : 1 < f) (hodd : Odd f)
    (hq : 2 < Nat.card F) (t : G) (htH : t ∉ diagramKernel (generalizedFitting G) e hq)
    (htorder : orderOf t = 2) (h : Sp F)
    (ht : extensionAction (generalizedFitting G) e t =
      MulAut.conj h * ExceptionalGraph.graphAut ^ f * (MulAut.conj h)⁻¹) :
    let D := centralizer ({t} : Set G)
    generalizedFitting G ⊔ zpowers t = ⊤ ∧
      pCore 2 D = (zpowers t).subgroupOf D ∧
      Nonempty ((D ⧸ pCore 2 D) ≃* SuzukiMatrixGroup (f / 2)) := by
  have hdeg : 2 * (f / 2) + 1 = f := by
    obtain ⟨m, hm⟩ := hodd
    omega
  have hm : 0 < f / 2 := by omega
  have hgen := swapping_sup_socle_eq_top e T hLT hF hodd hq t htH
  refine ⟨hgen, centralizer_core_and_quotient (generalizedFitting G) t htorder
    (fun htL => htH (le_diagramKernel _ e hq htL)) hgen (f / 2) hm ?_⟩
  exact socleCentralizerEquivSuzukiOfConjugacy (generalizedFitting G) e (f / 2)
    (by simpa only [hdeg] using hF) t h (by simpa only [hdeg] using ht)

/-- The literal structural premise `hquotient` in the external E-member
construction. All extra centralizer calculations in that premise are discharged. -/
theorem normalized_quotient_calculations [IsSimpleGroup (generalizedFitting G)]
    (e : Sp F ≃* generalizedFitting G) (T : Sylow 2 G)
    (hLT : generalizedFitting G ⊔ (T : Subgroup G) = ⊤)
    {f : ℕ} (hF : Nat.card F = 2 ^ f) (hf : 1 < f) (hodd : Odd f)
    (hq : 2 < Nat.card F) (A : Subgroup G) :
    ∀ t ∈ A, t ∉ diagramKernel (generalizedFitting G) e hq → orderOf t = 2 →
      ∀ h : Sp F, extensionAction (generalizedFitting G) e t =
        MulAut.conj h * ExceptionalGraph.graphAut ^ f * (MulAut.conj h)⁻¹ →
      let D := centralizer ({t} : Set G)
      generalizedFitting G ⊔ zpowers t = ⊤ ∧
        pCore 2 D ≤ (zpowers t).subgroupOf D ∧
        Nonempty ((D ⧸ pCore 2 D) ≃* SuzukiMatrixGroup (f / 2)) := by
  intro t _htA htH htorder h ht
  obtain ⟨hgen, hcore, he⟩ := centralizer_core_eq_and_quotient_of_conjugacy
    e T hLT hF hf hodd hq t htH htorder h ht
  exact ⟨hgen, hcore.le, he⟩

end CFSG.Quasithin.ChapterE.ValuesEvenClassical.RankTwoUpper.SymplecticFour.Swapping.ExternalMembers
