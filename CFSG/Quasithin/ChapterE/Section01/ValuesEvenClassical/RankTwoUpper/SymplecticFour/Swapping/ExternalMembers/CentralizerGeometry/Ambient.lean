module
public import CFSG.Quasithin.ChapterE.Section01.ValuesEvenClassical.RankTwoUpper.SymplecticFour.Swapping.ExternalMembers.FixedModel

/-!
# Transport from fixed-model geometry to the original centralizer

Changing the socle marking by the supplied inner conjugacy makes the action
literally graph-field. Restricting the original ambient Sylow to the normal
socle then gives a stable model Sylow, with its membership formula retained.
The fixed-group equivalence transports the relative Sylow intersection.

The supplement `G = L⟨t⟩` lifts that relative Sylow calculation to `C_G(t)`:
any larger 2-subgroup has the same intersection with `C_L(t)`, and its elements
split into a relative centralizer element and a power of `t`. The same
supplement lifts generation from the marked model to the ambient group.

Source: the centralizer construction in the swapping branch of
Aschbacher--Smith E.1.14(1), printed p.214, using the marked fixed-group
realization of 16.1.4(7), printed p.1171. Model geometry remains explicit.
-/

public section
open Subgroup Theory.GroupTheory Theory.SpecificGroups.SymplecticFour
namespace CFSG.Quasithin.ChapterE.ValuesEvenClassical.RankTwoUpper.SymplecticFour.Swapping.ExternalMembers.CentralizerGeometry
open DiagramAutomorphisms GraphFieldFixedResidual
variable {G F : Type*} [Group G] [Finite G] [Field F]

omit [Finite G] in
/-- A Sylow intersection in the relative centralizer lifts through the cyclic
supplement generated by the same element of the ambient Sylow. -/
theorem lift_relative_sylow (L : Subgroup G) [L.Normal]
    (T : Sylow 2 G) (t : G) (htT : t ∈ T) (hsplit : L ⊔ zpowers t = ⊤)
    (hrelative : ∃ R : Sylow 2 (L ⊓ centralizer ({t} : Set G) : Subgroup G),
      (R : Subgroup (L ⊓ centralizer ({t} : Set G) : Subgroup G)) =
        (T : Subgroup G).subgroupOf (L ⊓ centralizer ({t} : Set G))) :
    ∃ S : Sylow 2 (centralizer ({t} : Set G)),
      (S : Subgroup (centralizer ({t} : Set G))) =
        (T : Subgroup G).subgroupOf (centralizer ({t} : Set G)) := by
  let D := centralizer ({t} : Set G)
  let W := L ⊓ D
  obtain ⟨R, hR⟩ := hrelative
  have hzD : zpowers t ≤ D := zpowers_le.mpr (mem_centralizer_singleton_iff.mpr rfl)
  have hzT : zpowers t ≤ (T : Subgroup G) := zpowers_le.mpr htT
  refine ⟨{ toSubgroup := (T : Subgroup G).subgroupOf D
            isPGroup' := T.isPGroup'.comap_subtype
            is_maximal' := ?_ }, rfl⟩
  intro Q hpQ hTQ
  let j : W →* D := inclusion inf_le_right
  have hp : IsPGroup 2 (Q.comap j) := hpQ.comap_of_injective j (inclusion_injective _)
  have hRQ : (R : Subgroup W) ≤ Q.comap j := by
    intro w hw
    apply hTQ
    rw [hR] at hw
    exact hw
  have hQR : Q.comap j = (R : Subgroup W) := R.is_maximal' hp hRQ
  apply le_antisymm ?_ hTQ
  intro x hx
  obtain ⟨l, hl, z, hz, he⟩ := mem_sup_of_normal_left.mp
    (show (x : G) ∈ L ⊔ zpowers t from hsplit.symm ▸ mem_top _)
  have hlD : l ∈ D := by
    have hh := D.mul_mem x.property (D.inv_mem (hzD hz))
    simpa only [← he, mul_inv_cancel_right] using hh
  have hlQ : (⟨l, hlD⟩ : D) ∈ Q := by
    have hzQ : (⟨z, hzD hz⟩ : D) ∈ Q := hTQ (hzT hz)
    have hh := Q.mul_mem hx (Q.inv_mem hzQ)
    have hh' : x * (⟨z, hzD hz⟩ : D)⁻¹ = ⟨l, hlD⟩ :=
      Subtype.ext (by simp only [coe_mul, coe_inv, ← he, mul_inv_cancel_right])
    rwa [hh'] at hh
  have hlR : (⟨l, hl, hlD⟩ : W) ∈ (R : Subgroup W) :=
    hQR ▸ (show (⟨l, hl, hlD⟩ : W) ∈ Q.comap j from hlQ)
  have hlT : l ∈ (T : Subgroup G) := by
    rw [hR] at hlR
    exact hlR
  change (x : G) ∈ (T : Subgroup G)
  rw [← he]
  exact (T : Subgroup G).mul_mem hlT (hzT hz)


variable [Finite F] [CharP F 2]

omit [Finite G] in
/-- Changing the socle marking by the supplied inner conjugacy makes the
extension action literally the graph-field representative. -/
theorem normalized_marking_action (L : Subgroup G) [L.Normal]
    (e : Sp F ≃* L) (t : G) (h : Sp F) (m : ℕ)
    (ht : extensionAction L e t =
      MulAut.conj h * graphFieldAut m * (MulAut.conj h)⁻¹) :
    extensionAction L ((MulAut.conj h).trans e) t = graphFieldAut m := by
  apply MulEquiv.ext
  intro u
  change (MulAut.conj h).symm
    (extensionAction L e t ((MulAut.conj h) u)) = graphFieldAut m u
  rw [ht]
  change (MulAut.conj h).symm ((MulAut.conj h)
    (graphFieldAut m ((MulAut.conj h).symm ((MulAut.conj h) u)))) = _
  simp only [MulEquiv.symm_apply_apply]

omit [CharP F 2] in
/-- Restriction to the normal socle and the supplied marking retains exact
membership in the original ambient Sylow subgroup. -/
theorem exists_marked_sylow (L : Subgroup G) [L.Normal]
    (e : Sp F ≃* L) (T : Sylow 2 G) (t : G) (htT : t ∈ T) :
    ∃ S : Sylow 2 (Sp F),
      (∀ u : Sp F, u ∈ (S : Subgroup (Sp F)) ↔ (e u).val ∈ (T : Subgroup G)) ∧
      (S : Subgroup (Sp F)).map (extensionAction L e t).toMonoidHom = S := by
  obtain ⟨P, hP⟩ := T.exists_subgroupOf_eq_of_normal L
  let S := P.mapSurjective (f := e.symm.toMonoidHom) e.symm.surjective
  have hS (u : Sp F) : u ∈ (S : Subgroup (Sp F)) ↔ (e u).val ∈ (T : Subgroup G) := by
    change u ∈ (P : Subgroup L).map e.symm.toMonoidHom ↔ _
    rw [hP]
    constructor
    · rintro ⟨v, hv, rfl⟩
      change (e (e.symm v)).val ∈ (T : Subgroup G)
      rw [e.apply_symm_apply]
      exact hv
    · intro hu
      exact ⟨e u, hu, e.symm_apply_apply u⟩
  refine ⟨S, hS, Subgroup.eq_of_le_of_card_ge ?_ ?_⟩
  · rintro _ ⟨u, hu, rfl⟩
    apply (hS _).mpr
    change (e (extensionAction L e t u)).val ∈ (T : Subgroup G)
    rw [extensionAction_apply]
    exact (T : Subgroup G).mul_mem
      ((T : Subgroup G).mul_mem htT ((hS u).mp hu)) ((T : Subgroup G).inv_mem htT)
  · rw [card_map_of_injective (extensionAction L e t).injective]

omit [Finite G] in
/-- Transfer the fixed-intersection Sylow and generation calculations through
the actual socle marking, then lift from the socle centralizer to the full one. -/
theorem geometry_of_marked_model (L : Subgroup G) [L.Normal]
    (e : Sp F ≃* L) (T : Sylow 2 G) (t : G) (htT : t ∈ T)
    (hsplit : L ⊔ zpowers t = ⊤) (m : ℕ)
    (ha : extensionAction L e t = graphFieldAut m)
    (S : Sylow 2 (Sp F))
    (hS : ∀ u : Sp F, u ∈ (S : Subgroup (Sp F)) ↔ (e u).val ∈ (T : Subgroup G))
    (hfixed : ∃ R : Sylow 2 (graphFieldAut (F := F) m).fixedSubgroup,
      (R : Subgroup (graphFieldAut (F := F) m).fixedSubgroup) =
        (S : Subgroup (Sp F)).subgroupOf (graphFieldAut m).fixedSubgroup)
    (hgen : (graphFieldAut (F := F) m).fixedSubgroup ⊔ (S : Subgroup (Sp F)) = ⊤) :
    let D := centralizer ({t} : Set G)
    (∃ R : Sylow 2 D, (R : Subgroup D) = (T : Subgroup G).subgroupOf D) ∧
      D ⊔ (T : Subgroup G) = ⊤ := by
  let D := centralizer ({t} : Set G)
  let W := L ⊓ D
  let C := (graphFieldAut (F := F) m).fixedSubgroup
  let c : W ≃* C := (socleCentralizerEquivFixed L e t).trans
    (MulEquiv.subgroupCongr (congrArg MulAut.fixedSubgroup ha))
  have hc (w : W) : (c w : Sp F) = e.symm ⟨w.val, w.property.1⟩ :=
    socleCentralizerEquivFixed_apply L e t w
  constructor
  · apply lift_relative_sylow L T t htT hsplit
    obtain ⟨R, hR⟩ := hfixed
    let R' := R.mapSurjective (f := c.symm.toMonoidHom) c.symm.surjective
    have hle : (R' : Subgroup W) ≤ (T : Subgroup G).subgroupOf W := by
      rintro _ ⟨x, hx, rfl⟩
      rw [hR] at hx
      have he : (e x.val).val = (c.symm x).val := by
        have hh := hc (c.symm x)
        rw [c.apply_symm_apply] at hh
        have hh' := congrArg (fun u : Sp F => (e u).val) hh
        simpa only [e.apply_symm_apply] using hh'
      change (c.symm x).val ∈ (T : Subgroup G)
      rw [← he]
      exact (hS x.val).mp hx
    exact ⟨R', (R'.is_maximal' T.isPGroup'.comap_subtype hle).symm⟩
  · have hmodel : (⊤ : Subgroup (Sp F)) ≤ (D ⊔ (T : Subgroup G)).comap
        (L.subtype.comp e.toMonoidHom) := by
      rw [← hgen]
      apply sup_le
      · intro u hu
        apply mem_sup_left
        apply mem_centralizer_singleton_iff.mpr
        have hfix : extensionAction L e t u = u := by
          rw [ha]
          exact (MulAut.mem_fixedSubgroup _ _).mp hu
        have hh := extensionAction_apply L e t u
        rw [hfix] at hh
        exact (mul_inv_eq_iff_eq_mul.mp hh.symm).symm
      · intro u hu
        exact mem_sup_right ((hS u).mp hu)
    apply top_unique
    rw [← hsplit]
    apply sup_le
    · intro l hl
      obtain ⟨u, he⟩ := e.surjective ⟨l, hl⟩
      have hu := hmodel (mem_top u)
      change (e u).val ∈ D ⊔ (T : Subgroup G) at hu
      simpa only [he] using hu
    · exact (zpowers_le.mpr htT).trans le_sup_right

end CFSG.Quasithin.ChapterE.ValuesEvenClassical.RankTwoUpper.SymplecticFour.Swapping.ExternalMembers.CentralizerGeometry
