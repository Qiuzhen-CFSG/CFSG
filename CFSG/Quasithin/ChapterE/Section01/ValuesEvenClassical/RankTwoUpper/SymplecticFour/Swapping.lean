module

public import CFSG.Quasithin.ChapterE.Section01.ValuesEvenClassical.RankTwoUpper.SymplecticFour.Swapping.Reduction
public import CFSG.Quasithin.ChapterE.Section01.ValuesEvenClassical.RankTwoUpper.SymplecticFour.Swapping.DiagramKernel
public import CFSG.Quasithin.ChapterE.Section01.ValuesEvenClassical.RankTwoUpper.SymplecticFour.Swapping.Parity
public import CFSG.Quasithin.Defs

/-!
# Reduction of the nonbinary symplectic swapping branch

The diagram kernel has the same marked simple generalized Fitting subgroup,
is SQTK by inheritance, and is generated by that subgroup and its intrinsic
Sylow intersection. Its induced action preserves the actual parabolic classes.
Thus the separate diagram-preserving generation theorem applies literally.

For the ambient generation problem, small nontrivial elementary actors give
the whole group as an E2 member, using the simple-socle structural theorem.
For large families supported in the kernel, a fixed-actor rank calculation
places ambient tau in the kernel and permits inheritance of its E-members.
For an actor outside the kernel, a local E-member supplementing the Sylow
settles the family directly. Every rank and E0/E2 condition is retained by the
proved embedding inheritance theorem.

This is a conditional reduction, not the completed E.1.14(1) swapping branch.
The fixed-actor rank bound and the external local construction remain explicit.
The diagram-preserving generation input belongs to the separate existing owner.
No involution normal form, graph descent or fixed-group residual is assumed
implicitly. Final assembly remains in this module.

Source: Aschbacher--Smith, E.1.1--8 and E.1.14(1), printed pp.209--211,214.
-/

public section

universe u v
open Subgroup Theory.GroupTheory Theory.SpecificGroups.SymplecticFour
namespace CFSG.Quasithin.ChapterE.ValuesEvenClassical.RankTwoUpper.SymplecticFour.Swapping
open DiagramAutomorphisms
variable {G : Type u} [Group G] [Finite G]
    {F : Type v} [Field F] [Finite F] [CharP F 2]

/-- The existing diagram-preserving branch can be applied to the actual
kernel, with its source hypotheses and its marked action proved here. -/
theorem diagramKernel_generation_of_preserving_bound {f : ℕ}
    {𝒦 : GroupClass.{u}} (hG : IsSQTK 𝒦 G)
    [IsSimpleGroup (generalizedFitting G)]
    (e : Sp F ≃* generalizedFitting G) (hF : 2 < Nat.card F)
    (T : Sylow 2 G) (hLT : generalizedFitting G ⊔ (T : Subgroup G) = ⊤)
    (hpreserving : ∀ (J : Type u) [Group J] [Finite J]
      [IsSimpleGroup (generalizedFitting J)], IsSQTK 𝒦 J →
      ∀ (S : Sylow 2 J), generalizedFitting J ⊔ (S : Subgroup J) = ⊤ →
      ∀ (eJ : Sp F ≃* generalizedFitting J),
        (∀ x : J, PreservesDiagram (extensionAction (generalizedFitting J) eJ x)) →
        IsEGenerated f J) :
    IsEGenerated f (diagramKernel (generalizedFitting G) e hF) := by
  let H := diagramKernel (generalizedFitting G) e hF
  obtain ⟨hs, S, hS⟩ := diagramKernel_source_structure e hF T hLT
  let := hs
  exact hpreserving H (hG.subgroup H) S hS (diagramKernelModel e hF T hLT)
    (diagramKernelModel_preserves e hF T hLT)

/-- Conditional ambient assembly. The two outstanding model inputs concern
actual centralizers and actual bounded-rank E-members; neither is discharged
by cyclicity of the outer quotient alone. -/
theorem isEGenerated_of_diagramKernel_calculations {f : ℕ}
    (hF : Nat.card F = 2 ^ f) (hf : 1 < f)
    [IsSimpleGroup (generalizedFitting G)]
    (e : Sp F ≃* generalizedFitting G)
    (T : Sylow 2 G) (hLT : generalizedFitting G ⊔ (T : Subgroup G) = ⊤)
    (hq : 2 < Nat.card F)
    (hgen : IsEGenerated f (diagramKernel (generalizedFitting G) e hq))
    (hfixed : ∀ (A : Subgroup G), IsElementaryAbelian 2 A → A ≤ (T : Subgroup G) →
      A ≤ diagramKernel (generalizedFitting G) e hq →
      ∀ x ∈ (T : Subgroup G), ¬ PreservesDiagram (extensionAction (generalizedFitting G) e x) →
        x ∈ centralizer (A : Set G) → Group.rank A ≤ f)
    (hout : Odd f → ∀ A : Subgroup G, IsElementaryAbelian 2 A → A ≤ (T : Subgroup G) →
      ¬ A ≤ diagramKernel (generalizedFitting G) e hq → f < Group.rank A →
      ∃ K : Subgroup G, IsEMemberAt f (T : Subgroup G) A K ∧ K ⊔ (T : Subgroup G) = ⊤) :
    IsEGenerated f G := by
  have hq' : 2 < Nat.card F := by
    rw [hF]
    exact (show 2 ^ 1 < 2 ^ f from Nat.pow_lt_pow_right (by decide) hf)
  apply isEGenerated_of_normal_subgroup_and_external_members T
    (diagramKernel (generalizedFitting G) e hq)
    (diagramKernel_sup_sylow _ e hq T hLT) hgen
  · intro A hA hAT hne hr
    exact RankOneUpper.isEMemberAt_top_of_simple_generalizedFitting
      (symplectic_socle_nonabelian e hq') T hLT T A hA hAT hne hr
  · intro A hA hAT hAH hr
    exact tau_le_diagramKernel_of_fixed_rank e hq T hLT hfixed A hA hAT hAH hr
  · intro A hA hAT hAH hr
    let := hA
    exact hout (odd_of_elementary_not_le_diagramKernel _ e hF hf hq A hAH)
      A hA hAT hAH hr

end CFSG.Quasithin.ChapterE.ValuesEvenClassical.RankTwoUpper.SymplecticFour.Swapping
