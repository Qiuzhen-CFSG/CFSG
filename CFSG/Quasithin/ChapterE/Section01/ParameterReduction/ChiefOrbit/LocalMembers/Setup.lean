module

public import CFSG.Quasithin.ChapterE.Section01.ParameterReduction.ChiefOrbit.LocalAction

/-!
# Residuals of the local E-members in E.1.11

The two-residual of any subgroup of `JS` lies in J, since `JS/J` is a
2-group. An E-member P is generated by its two-residual and its prescribed
Sylow subgroup. Thus containment of the residual orbit `P_A` joined with
ambient tau suffices to put P in the ambient generation target; no claim
that the whole P lies in this orbit group is needed.

The final actor-transfer reduction retains the literal intersection family.
Its actor-placement premise is an outstanding mathematical obligation: an
arbitrary member `A ∩ JS` does not itself provide a witness A inside T.
The final E.1.11 assembly must discharge that premise.

Source: Aschbacher--Smith, *The Classification of Quasithin Groups*, combined
manuscript of 1 March 2004, E.1.11, printed p.213.
-/

@[expose] public section

open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterE.ChiefOrbit
variable {G : Type*} [Group G] [Finite G]

/-- The residual of a local subgroup, mapped through both literal inclusions. -/
def localMemberResidual (T : Sylow 2 G) (J : Subgroup G)
    (P : Subgroup (localGroup T J)) : Subgroup G :=
  ((pResidual 2 P).map P.subtype).map (localGroup T J).subtype

/-- The orbit of the local residual under the ambient tau. -/
def memberResidualOrbit (T : Sylow 2 G) (J A : Subgroup G)
    (P : Subgroup (localGroup T J)) : Subgroup G :=
  conjugateJoin (tau (T : Subgroup G) A) (localMemberResidual T J P)

/-- The source group `K_A`, using the residual orbit and the ambient tau. -/
def memberOrbitGroup (T : Sylow 2 G) (J A : Subgroup G)
    (P : Subgroup (localGroup T J)) : Subgroup G :=
  memberResidualOrbit T J A P ⊔ tau (T : Subgroup G) A

omit [Finite G] in
/-- The residual really lies in the component containing the local subgroup. -/
theorem localMemberResidual_le_component (T : Sylow 2 G) (J : Subgroup G)
    (P : Subgroup (localGroup T J)) : localMemberResidual T J P ≤ J := by
  let H := localGroup T J
  let S := stabilizer T J
  have hJH : J ≤ H := le_sup_left
  have hSH : S ≤ H := le_sup_right
  let _ : (J.subgroupOf H).Normal :=
    normal_subgroupOf_of_le_normalizer (sup_le J.le_normalizer inf_le_right)
  have hcover : J.subgroupOf H ⊔ S.subgroupOf H = ⊤ := by
    apply map_injective H.subtype_injective
    rw [Subgroup.map_sup, map_subgroupOf_eq_of_le hJH, map_subgroupOf_eq_of_le hSH,
      ← MonoidHom.range_eq_map, range_subtype]
    rfl
  have hq := isPGroup_quotient_of_sup_eq_top (J.subgroupOf H) (S.subgroupOf H)
    ((T.isPGroup'.to_le (show S ≤ (T : Subgroup G) from inf_le_left)).comap_subtype)
    hcover
  have hr : pResidual 2 H ≤ J.subgroupOf H := sInf_le ⟨inferInstance, hq⟩
  have hm := map_mono (f := H.subtype) ((map_pResidual_le 2 P.subtype).trans hr)
  rw [map_subgroupOf_eq_of_le hJH] at hm
  exact hm

omit [Finite G] in
/-- The identity conjugate embeds the residual into the source orbit group. -/
theorem localMemberResidual_le_orbitGroup (T : Sylow 2 G) (J A : Subgroup G)
    (P : Subgroup (localGroup T J)) :
    localMemberResidual T J P ≤ memberOrbitGroup T J A P := by
  apply le_trans _ le_sup_left
  exact le_componentOrbit _ _

omit [Finite G] in
/-- The source orbit group contains the ambient tau, for later inheritance. -/
theorem tau_le_memberOrbitGroup (T : Sylow 2 G) (J A : Subgroup G)
    (P : Subgroup (localGroup T J)) :
    tau (T : Subgroup G) A ≤ memberOrbitGroup T J A P := le_sup_right

/-- Sylow supplementation reduces an E-member containment to its residual. -/
theorem local_member_le_of_residual_le {n : ℕ} (T : Sylow 2 G) (J : Subgroup G)
    {V P : Subgroup (localGroup T J)}
    (hP : IsEMemberAt n ((stabilizer T J).subgroupOf (localGroup T J)) V P)
    {M : Subgroup G} (hTM : (T : Subgroup G) ≤ M)
    (hres : localMemberResidual T J P ≤ M) : P.map (localGroup T J).subtype ≤ M := by
  obtain ⟨R, hR⟩ := hP.1.2.2.2.2.1
  have hs := congrArg (fun N : Subgroup P => N.map
    ((localGroup T J).subtype.comp P.subtype)) (pResidual_sup_sylow_eq_top R)
  rw [Subgroup.map_sup, ← MonoidHom.range_eq_map, MonoidHom.range_comp, range_subtype] at hs
  rw [← hs]
  apply sup_le
  · simpa only [localMemberResidual, map_map] using hres
  · rw [hR]
    rintro _ ⟨x, hx, rfl⟩
    exact hTM hx.1

/-- The actual local E-member application of the orbit-group containment. -/
theorem local_member_le_of_orbitGroup_le {n : ℕ} (T : Sylow 2 G) (J A : Subgroup G)
    {V P : Subgroup (localGroup T J)}
    (hP : IsEMemberAt n ((stabilizer T J).subgroupOf (localGroup T J)) V P)
    {M : Subgroup G} (hTM : (T : Subgroup G) ≤ M)
    (hK : memberOrbitGroup T J A P ≤ M) : P.map (localGroup T J).subtype ≤ M :=
  local_member_le_of_residual_le T J hP hTM
    ((localMemberResidual_le_orbitGroup T J A P).trans hK)

omit [Finite G] in
/-- For an actor already inside T, the literal local intersection is `N_A(J)`. -/
theorem map_local_actor_eq_stabilizer_intersection (T : Sylow 2 G) (J A : Subgroup G)
    (hAT : A ≤ (T : Subgroup G)) :
    (A.subgroupOf (localGroup T J)).map (localGroup T J).subtype =
      A ⊓ normalizer (J : Set G) := by
  rw [subgroupOf_map_subtype]
  apply le_antisymm
  · exact le_inf inf_le_left (inf_le_right.trans (sup_le J.le_normalizer inf_le_right))
  · exact le_inf inf_le_left ((le_inf (inf_le_left.trans hAT) inf_le_right).trans
      (show stabilizer T J ≤ localGroup T J from le_sup_right))

/-- The residual reduction summed over the literal intersection family. -/
theorem localEFamily_le_of_member_residuals {n : ℕ} (T : Sylow 2 G) (J : Subgroup G)
    {Ω : Set (Subgroup G)} {M : Subgroup G} (hTM : (T : Subgroup G) ≤ M)
    (hres : ∀ V ∈ intersectionFamily (localGroup T J) Ω,
      V ≤ (stabilizer T J).subgroupOf (localGroup T J) →
      ∀ P, IsEMemberAt n ((stabilizer T J).subgroupOf (localGroup T J)) V P →
        localMemberResidual T J P ≤ M) : localEFamily n T J Ω ≤ M := by
  apply map_le_iff_le_comap.mpr
  apply iSup_le
  intro V
  apply sSup_le
  intro P hP
  exact map_le_iff_le_comap.mp (local_member_le_of_residual_le T J hP hTM
    (hres V.val V.property.1 V.property.2 P hP))

/-- Assembly from an explicit escaping-actor transfer and the ambient-actor
member branch. The transfer is a premise, not an asserted restriction identity. -/
theorem localEFamily_le_of_actor_transfer {n : ℕ} (T : Sylow 2 G) (J : Subgroup G)
    {Ω : Set (Subgroup G)} {M : Subgroup G}
    (hactors : ∀ V ∈ intersectionFamily (localGroup T J) Ω,
      V ≤ (stabilizer T J).subgroupOf (localGroup T J) →
      ∀ P, IsEMemberAt n ((stabilizer T J).subgroupOf (localGroup T J)) V P →
        ¬ P.map (localGroup T J).subtype ≤ M →
        ∃ A ∈ Ω, A ≤ (T : Subgroup G) ∧
          ∃ Q, IsEMemberAt n ((stabilizer T J).subgroupOf (localGroup T J))
            (A.subgroupOf (localGroup T J)) Q ∧ ¬ Q.map (localGroup T J).subtype ≤ M)
    (hmembers : ∀ A ∈ Ω, A ≤ (T : Subgroup G) →
      ∀ P, IsEMemberAt n ((stabilizer T J).subgroupOf (localGroup T J))
        (A.subgroupOf (localGroup T J)) P → P.map (localGroup T J).subtype ≤ M) :
    localEFamily n T J Ω ≤ M := by
  apply map_le_iff_le_comap.mpr
  apply iSup_le
  intro V
  apply sSup_le
  intro P hP
  apply map_le_iff_le_comap.mp
  by_contra hPM
  obtain ⟨A, hA, hAT, Q, hQ, hQM⟩ := hactors V.val V.property.1 V.property.2 P hP hPM
  exact hQM (hmembers A hA hAT Q hQ)

end CFSG.Quasithin.ChapterE.ChiefOrbit
