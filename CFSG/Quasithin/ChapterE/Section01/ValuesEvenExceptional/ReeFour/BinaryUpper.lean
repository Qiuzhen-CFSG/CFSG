public import CFSG.Quasithin.ChapterE.Section01.Inheritance
public import CFSG.Quasithin.ChapterE.Section01.ValuesEvenExceptional.ReeFour.Ambient
public import CFSG.Quasithin.ChapterE.Section01.ParameterReduction.ChiefOrbit.NormalizerDiagonal.Overgroups
public import Theory.SpecificGroups.Tits.ExceptionalParabolics.FullRee.Automorphisms
public import Mathlib.GroupTheory.SpecificGroups.ZGroup

/-!
# Rank-one E-generation at the binary Ree endpoint

The full binary Ree parabolics are solvable: their proved two-core quotients
are Sz(2) of order twenty and PSL₂(2) of order six. Their marked intersections
with the Tits group are therefore solvable as well. In each carrier the two
parabolics contain the specified Sylow subgroup and generate the whole group.
Solvable E-generation and the proved E.1.12 containment give rank-one generation.

For an arbitrary finite ambient group with F*(G) isomorphic to the derived
binary Ree group, conjugation embeds G in Aut(Tits). Its image contains the
inner subgroup, whose index is two, so G is isomorphic to Tits or full ²F₄(2).
Both cases are retained. This proves a stronger upper bound than E.1.14(1)
requires: the SQTK and Sylow-supplement hypotheses are unnecessary here.

Source: Aschbacher--Smith, E.1.12--14, printed p.214 (PDF p.225) of
`refs/quasithin.pdf`, citing Aschbacher (1982), Lemma 4.7. E-member transfer
uses the corrected local-tau convention of E.1.2 on printed pp.209--210.
The concrete model comparisons and Parrott generator conventions are proved
in the imported Ree/Tits modules; no abstract group is substituted by order.
-/

public section

namespace CFSG.Quasithin.ChapterE.ExceptionalValues.ReeFour
open Subgroup Theory.GroupTheory Tits.ExceptionalParabolics

private theorem full_first_isSolvable : Group.IsSolvable FullRee.first := by
  let : Group.IsSolvable (BenderSuzuki.MatrixGroups.SuzukiMatrixGroup 0) :=
    BenderSuzuki.MatrixGroups.suzukiZero_isSolvable
  let : Group.IsSolvable (FullRee.first ⧸ pCore 2 FullRee.first) :=
    Group.isSolvable_of_surjective
      (f := FullRee.firstCoreQuotientEquiv.symm.toMonoidHom)
      FullRee.firstCoreQuotientEquiv.symm.surjective
  let : Group.IsNilpotent (pCore 2 FullRee.first) := pCore_isPGroup.isNilpotent
  exact (Group.isSolvable_iff_subgroup_quotient (pCore 2 FullRee.first)).mpr
    ⟨inferInstance, inferInstance⟩

private theorem full_second_isSolvable : Group.IsSolvable FullRee.second := by
  have hc : Nat.card (FullRee.second ⧸ pCore 2 FullRee.second) = 6 := by
    have h := (pCore 2 FullRee.second).card_eq_card_quotient_mul_card_subgroup
    rw [FullRee.second_card, FullRee.second_core_card] at h
    omega
  let : IsZGroup (FullRee.second ⧸ pCore 2 FullRee.second) :=
    IsZGroup.of_squarefree (by
      rw [hc, show (6 : ℕ) = 2 * 3 from rfl,
        Nat.squarefree_mul (by decide : Nat.Coprime 2 3)]
      exact ⟨Nat.prime_two.squarefree, Nat.prime_three.squarefree⟩)
  let : Group.IsNilpotent (pCore 2 FullRee.second) := pCore_isPGroup.isNilpotent
  exact (Group.isSolvable_iff_subgroup_quotient (pCore 2 FullRee.second)).mpr
    ⟨inferInstance, inferInstance⟩

private theorem generated_by_solvable_overgroups {G : Type*} [Group G] [Finite G] (T : Sylow 2 G)
    (H K : Subgroup G) [Group.IsSolvable H] [Group.IsSolvable K]
    (hH : (T : Subgroup G) ≤ H) (hK : (T : Subgroup G) ≤ K)
    (hgen : H ⊔ K = ⊤) : IsEGenerated 1 G := by
  apply IsEGeneratedAt.isEGenerated (T := T)
  intro Ω hΩ
  apply top_unique
  change ⊤ ≤ ChiefOrbit.generationTarget 1 T Ω
  rw [← hgen]
  exact sup_le
    (ChiefOrbit.solvable_overgroup_le_generationTarget Nat.zero_lt_one T H hH hΩ)
    (ChiefOrbit.solvable_overgroup_le_generationTarget Nat.zero_lt_one T K hK hΩ)

private theorem tits_first_isSolvable : Group.IsSolvable first := by
  let : Group.IsSolvable FullRee.first := full_first_isSolvable
  let f : first →* FullRee.first :=
    (FullRee.atlasEmbedding.comp first.subtype).codRestrict FullRee.first
      (fun x => FullRee.atlas_first_map_le (mem_map_of_mem _ x.property))
  exact Group.isSolvable_of_isSolvable_injective (f := f)
    (fun x y h => Subtype.ext (FullRee.atlasEmbedding_injective (congrArg Subtype.val h)))

private theorem tits_second_isSolvable : Group.IsSolvable second := by
  let : Group.IsSolvable FullRee.second := full_second_isSolvable
  let f : second →* FullRee.second :=
    (FullRee.atlasEmbedding.comp second.subtype).codRestrict FullRee.second
      (fun x => FullRee.atlas_second_map_le (mem_map_of_mem _ x.property))
  exact Group.isSolvable_of_isSolvable_injective (f := f)
    (fun x y h => Subtype.ext (FullRee.atlasEmbedding_injective (congrArg Subtype.val h)))

/-- The full binary Ree group is rank-one E-generated by its actual
solvable Sylow overgroups. -/
theorem binary_full_isEGenerated_one : IsEGenerated 1 (ReeF4.Model 0) := by
  let : Group.IsSolvable FullRee.first := full_first_isSolvable
  let : Group.IsSolvable FullRee.second := full_second_isSolvable
  apply generated_by_solvable_overgroups FullRee.sylow FullRee.first FullRee.second
  · rw [FullRee.sylow_coe]
    exact FullRee.sylow_le_first
  · rw [FullRee.sylow_coe]
    exact FullRee.sylow_le_second
  · exact FullRee.generate

/-- The Tits derived group is independently rank-one E-generated by the
marked Parrott overgroups of its smaller Sylow subgroup. -/
theorem binary_tits_isEGenerated_one : IsEGenerated 1 Tits.Atlas1600Group := by
  let : Group.IsSolvable first := tits_first_isSolvable
  let : Group.IsSolvable second := tits_second_isSolvable
  apply generated_by_solvable_overgroups Tits.atlas1600SylowTwo first second
  · rw [Tits.atlas1600SylowTwo_coe]
    exact sylow_le_first
  · rw [Tits.atlas1600SylowTwo_coe]
    exact sylow_le_second
  · exact generate

private theorem inner_injective :
    Function.Injective (MulAut.conj : Tits.Atlas1600Group →* MulAut Tits.Atlas1600Group) := by
  intro x y h
  apply FullRee.atlasEmbedding_injective
  apply FullRee.atlasAutEquiv.injective
  simpa only [FullRee.atlasAutEquiv_embedding] using h

/-- The source ambient group is the Tits group or its full Ree extension.
The faithful conjugation action contains the index-two inner subgroup. -/
theorem binaryAmbient_equiv_tits_or_full {G : Type*} [Group G] [Finite G] (L : Subgroup G)
    (hL : L = generalizedFitting G) (e : L ≃* commutator (ReeF4.Model 0)) :
    Nonempty (G ≃* Tits.Atlas1600Group) ∨ Nonempty (G ≃* ReeF4.Model 0) := by
  let : L.Normal := hL ▸ inferInstance
  let eL := e.trans FullRee.atlasDerivedEquiv.symm
  let a : G →* MulAut Tits.Atlas1600Group :=
    (MulAut.congr eL).toMonoidHom.comp (MulAut.conjNormal (H := L))
  have haL (l : L) : a (l : G) = MulAut.conj (eL l) := by
    change MulAut.congr eL (MulAut.conjNormal (l : G)) = _
    rw [MulAut.conjNormal_val]
    ext x
    simp [MulAut.congr, MulAut.conj_apply]
  have ha : Function.Injective a := by
    apply (MonoidHom.ker_eq_bot_iff a).mp
    apply bot_unique
    intro g hg
    have hag : a g = 1 := hg
    have hgact : MulAut.conjNormal (H := L) g = 1 := by
      apply (MulAut.congr eL).injective
      change (MulAut.congr eL) (MulAut.conjNormal (H := L) g) = 1 at hag
      simpa only [map_one] using hag
    have hc : g ∈ centralizer (L : Set G) := by
      rw [mem_centralizer_iff]
      intro l hl
      have he := congrArg (fun b : MulAut L => ((b ⟨l, hl⟩ : L) : G)) hgact
      change g * l * g⁻¹ = l at he
      exact (mul_inv_eq_iff_eq_mul.mp he).symm
    have hgL : g ∈ L := by
      have hcent : centralizer (L : Set G) ≤ L := by
        simpa only [hL] using centralizer_generalizedFitting_le G
      exact hcent hc
    have he : eL ⟨g, hgL⟩ = 1 := by
      apply inner_injective
      rw [← haL, map_one]
      exact hag
    have he' : (⟨g, hgL⟩ : L) = 1 := eL.injective (he.trans eL.map_one.symm)
    exact congrArg Subtype.val he'
  have hi : (MulAut.conj : Tits.Atlas1600Group →* MulAut Tits.Atlas1600Group).range ≤
      a.range := by
    rintro x ⟨l, rfl⟩
    refine ⟨(eL.symm l : G), ?_⟩
    rw [haL, MulEquiv.apply_symm_apply]
  have hd : a.range.index ∣ 2 := FullRee.inner_index ▸ index_dvd_of_le hi
  rcases (Nat.dvd_prime (by decide : Nat.Prime 2)).mp hd with hh | hh
  · right
    have hs : Function.Surjective a := MonoidHom.range_eq_top.mp (index_eq_one.mp hh)
    exact ⟨(MulEquiv.ofBijective a ⟨ha, hs⟩).trans FullRee.atlasAutEquiv.symm⟩
  · left
    have hm := relIndex_mul_index hi
    rw [hh, FullRee.inner_index] at hm
    have hr : (MulAut.conj : Tits.Atlas1600Group →* MulAut Tits.Atlas1600Group).range.relIndex
        a.range = 1 := by omega
    have heq : a.range = (MulAut.conj : Tits.Atlas1600Group →* MulAut Tits.Atlas1600Group).range :=
      le_antisymm (relIndex_eq_one.mp hr) hi
    exact ⟨(MonoidHom.ofInjective ha).trans
      ((MulEquiv.subgroupCongr heq).trans (MonoidHom.ofInjective inner_injective).symm)⟩

/-- Binary E.1.14(1), upper bound, including both the Tits group and its
full Ree extension. The source assumptions on SQTK, simplicity and G = LT
are not needed beyond the actual identification of F*(G). -/
theorem binary_isEGenerated_one {G : Type*} [Group G] [Finite G]
    (L : Subgroup G) (hL : L = generalizedFitting G)
    (e : L ≃* commutator (ReeF4.Model 0)) : IsEGenerated 1 G := by
  rcases binaryAmbient_equiv_tits_or_full L hL e with h | h
  · obtain ⟨a⟩ := h
    exact binary_tits_isEGenerated_one.map_equiv a.symm
  · obtain ⟨a⟩ := h
    exact binary_full_isEGenerated_one.map_equiv a.symm

end CFSG.Quasithin.ChapterE.ExceptionalValues.ReeFour
