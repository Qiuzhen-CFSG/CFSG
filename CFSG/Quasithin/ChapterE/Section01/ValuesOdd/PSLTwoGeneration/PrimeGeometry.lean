public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSLTwoGeneration.PrimeGeometry.LinearModels
public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSLTwoGeneration.PrimeGeometry.Reduction
public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSLTwoGeneration.PrimeGeometry.Inner
public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSLTwoGeneration.PrimeGeometry.Diagonal
public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSLTwoGeneration.PrimeGeometry.OddSections

/-!
# Assembly of the prime-field local calculation

The self-centralizing prime-field socle gives an actual PSL₂ or PGL₂ model.
Both models have self-centralizing four-groups; with O₂(G)=1, their ambient
tau is the actor itself. The PSL₂ and PGL₂ placement theorems construct actual
S₄ or prime dihedral local subgroups with the specified Sylow intersection.
Their intrinsic E1 quotients have a nontrivial odd core generated by its
commutators with the rank-one actor image. These calculations assemble into
`LargeFamilyEscapeAt` for every ambient Sylow two-subgroup.

The final theorem discharges all three local calculations. Its structural
centralizer and two-core premises are the ones discharged by the parent
E.1.14(6) assembly's simple-socle theorem. The prime-square and small-actor
branches of that source theorem remain with that assembly.

Source: Aschbacher--Smith, E.1.2 and E.1.14(6), pp.210 and 214;
Aschbacher (1982), Lemma 4.10.
-/

public section

namespace CFSG.Quasithin.ChapterE.ValuesOdd.PSLTwoGeneration.PrimeGeometry

open Subgroup GorensteinWalter Theory.GroupTheory

/-- The actual prime-socle application of the model reduction and local E1
assembly. The three local calculations must still be proved independently. -/
theorem largeFamilyEscape_of_prime_local_calculations
    {G : Type*} [Group G] [Finite G] {p : ℕ}
    (hp : p.Prime) (hpo : Odd p) (hp5 : 5 < p)
    (hL : ClassicalGroup.IsPSL (generalizedFitting G) 2 p)
    (hC : centralizer (generalizedFitting G : Set G) = ⊥)
    (hcore : pCore 2 G = ⊥)
    (hodd : ∀ A H : Subgroup G, IsKleinFour A → A ≤ H →
      LocalModel A H → ECaseOdd A H)
    (hinner : ∀ (F : Type) [Field F] [Finite F], Nat.card F = p →
      (G ≃* PSL2 F) → ∀ T : Sylow 2 G, ConcreteLocalGeometryAt T)
    (hdiagonal : ∀ (F : Type) [Field F] [Finite F], Nat.card F = p →
      (G ≃* PGL2 F) → ∀ T : Sylow 2 G, ConcreteLocalGeometryAt T) :
    ∀ T : Sylow 2 G, LargeFamilyEscapeAt T := by
  obtain ⟨F, _, _, hF, he⟩ := linear_models_of_prime_socle hp hpo hp5 hL hC
  intro T
  apply largeFamilyEscapeAt_of_concrete_geometry T hcore
    (kleinFour_selfCentralizing_of_prime_socle hp hpo hp5 hL hC) hodd
  rcases he with he | he
  · exact hinner F hF he.some T
  · exact hdiagonal F hF he.some T

/-- The prime-field large-family branch of E.1.14(6), including diagonal
extensions. Every proper Sylow overgroup containing the literal weak-closure
normalizer misses an actual rank-one E1 member for a member of the family.

Only the ambient structural premises remain explicit: the parent source
assembly supplies them from its simple generalized Fitting subgroup. No
additional local placement, quotient or generation premise is required. -/
theorem largeFamilyEscape_of_prime_socle
    {G : Type*} [Group G] [Finite G] {p : ℕ}
    (hp : p.Prime) (hpo : Odd p) (hp5 : 5 < p)
    (hL : ClassicalGroup.IsPSL (generalizedFitting G) 2 p)
    (hC : centralizer (generalizedFitting G : Set G) = ⊥)
    (hcore : pCore 2 G = ⊥) :
    ∀ T : Sylow 2 G, LargeFamilyEscapeAt T := by
  apply largeFamilyEscape_of_prime_local_calculations hp hpo hp5 hL hC hcore
  · exact eCaseOdd_of_localModel
  · intro F _ _ hF e T
    exact Inner.concreteLocalGeometryAt_of_prime_field hp hpo hp5 hF e T
  · intro F _ _ hF e T
    exact Diagonal.concreteLocalGeometryAt_of_prime_field hp hpo hp5 hF e T

end CFSG.Quasithin.ChapterE.ValuesOdd.PSLTwoGeneration.PrimeGeometry
