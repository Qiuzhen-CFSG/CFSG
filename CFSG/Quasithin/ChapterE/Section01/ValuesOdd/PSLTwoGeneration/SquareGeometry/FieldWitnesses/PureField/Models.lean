module

public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSLTwoGeneration.SquareGeometry.FieldWitnesses.ActorGeometry
public import GorensteinWalter.FiniteFieldFixedSubfieldCard
public import Theory.ElementaryAbelian.Join
public import Theory.GroupTheory.NormalizedSupCard

/-!
# Canonical quadratic models containing a pure field involution

The field-automorphism group of a field of order p² has order two. Removing
the pure field coordinate therefore identifies each subgroup containing σ
with the join of its literal linear kernel and ⟨σ⟩. The index-two inclusion
PSL₂ ≤ PGL₂ shows that an overgroup of the canonical PSL₂ layer is either
`innerModel F σ` or all of PΓL₂(F). These are equalities of the embedded
matrix subgroups, not just abstract group-family identifications.

The fixed field has p elements. A proved projective matrix construction
supplies a four-group in PSL₂ centralized by σ. Its join with ⟨σ⟩ has order
eight, since the field projection separates the factors. Choosing a Sylow
containing this join gives an actual rank-three actor with centralizer and
tau equal to itself. This does not assert membership in an arbitrary Ω.

`PureField` consumes the exact model dichotomy in its conditional escape
assembly. The two model-specific escape calculations, including all family
and local-subgroup placement, remain separate proof obligations.

Source: Aschbacher--Smith, *The Classification of Quasithin Groups*,
A.2.3(2), E.1.2 and E.1.14(6), printed pp.33, 209--210 and 214.
The local calculation in E.1.14(6) cites Aschbacher (1982), Lemma 4.10.
-/

public section
open Subgroup GorensteinWalter
namespace CFSG.Quasithin.ChapterE.ValuesOdd.PSLTwoGeneration.SquareGeometry.FieldWitnesses.PureField
universe u
variable {F : Type u} [Field F] [Finite F]

/-- The actual subgroup generated by the canonical PSL₂ layer and σ. -/
@[expose] def innerModel (F : Type u) [Field F] (σ : F ≃+* F) : Subgroup (PGammaL2 F) :=
  pGammaL2PSLRange F ⊔ zpowers (SemidirectProduct.inr σ)

/-- A nontrivial automorphism generates the quadratic field-automorphism group. -/
theorem fieldAut_eq_one_or {p : ℕ} (hp : p.Prime) (hF : Nat.card F = p ^ 2)
    (σ : F ≃+* F) (hne : σ ≠ 1) (τ : F ≃+* F) : τ = 1 ∨ τ = σ := by
  obtain ⟨z, hz, hu⟩ := (Nat.card_eq_two_iff' (1 : F ≃+* F)).mp
    (FiniteField.card_ringAut_of_card_prime_pow hp hF)
  by_cases ht : τ = 1
  · exact Or.inl ht
  · exact Or.inr ((hu τ ht).trans (hu σ hne).symm)

/-- The fixed field of the supplied involution has exactly p elements. -/
theorem fixedSubfield_card {p : ℕ} (hF : Nat.card F = p ^ 2)
    (σ : F ≃+* F) (hsq : σ ^ 2 = 1) (hne : σ ≠ 1) :
    Nat.card (FixedPoints.subfield (zpowers σ) F) = p := by
  have ho : orderOf σ = 2 := (orderOf_eq_prime_iff (x := σ)).mpr ⟨hsq, hne⟩
  have hc := nat_card_eq_fixedSubfield_card_pow_orderOf F σ
  rw [ho, hF] at hc
  nlinarith

/-- Every subgroup containing the pure field involution is generated by its
literal linear kernel and that involution. -/
theorem eq_kernel_sup_pure {p : ℕ} (hp : p.Prime) (hF : Nat.card F = p ^ 2)
    (S : Subgroup (PGammaL2 F)) (σ : F ≃+* F) (hne : σ ≠ 1)
    (hσ : SemidirectProduct.inr σ ∈ S) :
    S = (pGammaL2LinearKernel F S).map S.subtype ⊔ zpowers (SemidirectProduct.inr σ) := by
  have hr (x : PGammaL2 F) : SemidirectProduct.inr x.right ∈ zpowers (SemidirectProduct.inr σ : PGammaL2 F) := by
    rcases fieldAut_eq_one_or hp hF σ hne x.right with h | h
    · rw [h, map_one]; exact one_mem _
    · rw [h]; exact mem_zpowers _
  have hZS : zpowers (SemidirectProduct.inr σ) ≤ S := zpowers_le.mpr hσ
  apply le_antisymm
  · intro x hx
    have hlS : SemidirectProduct.inl x.left ∈ S := by
      have hm := S.mul_mem hx (S.inv_mem (hZS (hr x)))
      rw [← SemidirectProduct.inl_left_mul_inr_right x] at hm
      simpa only [SemidirectProduct.mul_right, SemidirectProduct.right_inl,
        SemidirectProduct.right_inr, one_mul, mul_inv_cancel_right] using hm
    have hlK : SemidirectProduct.inl x.left ∈ (pGammaL2LinearKernel F S).map S.subtype := by
      refine ⟨⟨SemidirectProduct.inl x.left, hlS⟩, ?_, rfl⟩
      apply (mem_pGammaL2LinearKernel_iff F S ⟨SemidirectProduct.inl x.left, hlS⟩).mpr
      rfl
    rw [← SemidirectProduct.inl_left_mul_inr_right x]
    exact mul_mem_sup hlK (hr x)
  · exact sup_le (map_subtype_le _) hZS

/-- The alternatives identify the actual embedded linear kernel. -/
theorem kernel_image_eq_psl_or_pgl {p : ℕ} (hp : p.Prime) (hodd : Odd p)
    (hF : Nat.card F = p ^ 2) (S : Subgroup (PGammaL2 F))
    (hS : pGammaL2PSLRange F ≤ S) :
    (pGammaL2LinearKernel F S).map S.subtype = pGammaL2PSLRange F ∨
    (pGammaL2LinearKernel F S).map S.subtype = pGammaL2PGLRange F := by
  let K := (pGammaL2LinearKernel F S).map S.subtype
  have hLK : pGammaL2PSLRange F ≤ K := by
    intro x hx
    refine ⟨⟨x, hS hx⟩, ?_, rfl⟩
    apply (mem_pGammaL2LinearKernel_iff F S ⟨x, hS hx⟩).mpr
    obtain ⟨y, rfl⟩ := (mem_pGammaL2PSLRange_iff F x).mp hx
    rfl
  have hKP : K ≤ pGammaL2PGLRange F := by
    rintro _ ⟨x, hx, rfl⟩
    rw [pGammaL2PGLRange, SemidirectProduct.range_inl_eq_ker_rightHom]
    exact (mem_pGammaL2LinearKernel_iff F S x).mp hx
  have hmul := relIndex_mul_relIndex (pGammaL2PSLRange F) K (pGammaL2PGLRange F) hLK hKP
  rw [pGammaL2_psl_range_relIndex_pgl_eq_two F ⟨p, 2, hp, hodd, by decide, hF⟩] at hmul
  have hd : (pGammaL2PSLRange F).relIndex K ∣ 2 := ⟨K.relIndex (pGammaL2PGLRange F), hmul.symm⟩
  rcases (Nat.dvd_prime Nat.prime_two).mp hd with h | h
  · exact Or.inl (le_antisymm (relIndex_eq_one.mp h) hLK)
  · have hi : K.relIndex (pGammaL2PGLRange F) = 1 := by rw [h] at hmul; omega
    exact Or.inr (le_antisymm hKP (relIndex_eq_one.mp hi))

/-- There are exactly two possible actual matrix overgroups of the canonical
PSL₂ layer containing the specified pure field involution. -/
theorem eq_innerModel_or_top {p : ℕ} (hp : p.Prime) (hodd : Odd p)
    (hF : Nat.card F = p ^ 2) (S : Subgroup (PGammaL2 F))
    (hS : pGammaL2PSLRange F ≤ S) (σ : F ≃+* F) (hne : σ ≠ 1)
    (hσ : SemidirectProduct.inr σ ∈ S) : S = innerModel F σ ∨ S = ⊤ := by
  have he := eq_kernel_sup_pure hp hF S σ hne hσ
  rcases kernel_image_eq_psl_or_pgl hp hodd hF S hS with h | h
  · rw [h] at he
    exact Or.inl he
  · right
    rw [h] at he
    apply top_unique
    intro x _
    rw [he, ← SemidirectProduct.inl_left_mul_inr_right x]
    apply mul_mem_sup (show SemidirectProduct.inl x.left ∈ pGammaL2PGLRange F from ⟨_, rfl⟩)
    rcases fieldAut_eq_one_or hp hF σ hne x.right with ht | ht
    · rw [ht, map_one]; exact one_mem _
    · rw [ht]; exact mem_zpowers _

/-- The pure involution belongs to an actual elementary subgroup of order eight.
This supplies a convenient Sylow containing both the field and linear actors. -/
theorem exists_rank_three_actor {p : ℕ} (hp : p.Prime) (hodd : Odd p)
    (hF : Nat.card F = p ^ 2) (hlarge : 5 < p ^ 2)
    (S : Subgroup (PGammaL2 F)) [Finite S]
    (hS : pGammaL2PSLRange F ≤ S) (σ : F ≃+* F)
    (hsq : σ ^ 2 = 1) (hne : σ ≠ 1) (hσ : SemidirectProduct.inr σ ∈ S) :
    ∃ (T : Sylow 2 S) (A : Subgroup S), IsElementaryAbelian 2 A ∧
      A ≤ (T : Subgroup S) ∧ Group.rank A = 3 ∧
      (⟨SemidirectProduct.inr σ, hσ⟩ : S) ∈ A ∧
      centralizer (A : Set S) = A ∧ tau (T : Subgroup S) A = A := by
  classical
  obtain ⟨V, hV, hVL, hσV⟩ := pure_field_involution_centralizes_psl_kleinFour
    (K := F) ⟨p, 2, hp, hodd, by decide, hF⟩ σ hsq hne
  let t : S := ⟨SemidirectProduct.inr σ, hσ⟩
  let D := V.subgroupOf S
  let C := zpowers t
  have hVS : V ≤ S := hVL.trans hS
  let e : D ≃* V := subgroupOfEquivOfLe hVS
  have hD : IsKleinFour D := {
    card_four := (Nat.card_congr e.toEquiv).trans hV.card_four
    exponent_two := (Monoid.exponent_eq_of_mulEquiv e).trans hV.exponent_two }
  let : IsKleinFour D := hD
  let : IsElementaryAbelian 2 D := {
    toIsMulCommutative := IsKleinFour.isMulCommutative
    exponent_dvd_p := by rw [hD.exponent_two] }
  have htsq : t ^ 2 = 1 := by
    apply Subtype.ext
    change (SemidirectProduct.inr σ : PGammaL2 F) ^ 2 = 1
    rw [← map_pow, hsq, map_one]
  have htne : t ≠ 1 := by
    intro h
    exact hne (congrArg (pGammaL2FieldProjection F S) h)
  have hto : orderOf t = 2 := (orderOf_eq_prime_iff (x := t)).mpr ⟨htsq, htne⟩
  let : IsElementaryAbelian 2 C := IsElementaryAbelian.zpowers_of_pow_eq_one htsq
  have hCD : C ≤ centralizer (D : Set S) := by
    apply zpowers_le.mpr
    rw [mem_centralizer_iff]
    intro d hd
    exact Subtype.ext (mem_centralizer_iff.mp hσV d hd)
  have hDC : Disjoint D C := by
    apply disjoint_iff.mpr
    apply le_antisymm _ bot_le
    rintro x ⟨hxD, hxC⟩
    have hxker : pGammaL2FieldProjection F S x = 1 := by
      have hxL := hVL hxD
      obtain ⟨y, hy⟩ := (mem_pGammaL2PSLRange_iff F x).mp hxL
      change (x : PGammaL2 F).right = 1
      rw [← hy]
      rfl
    obtain ⟨z, rfl⟩ := mem_zpowers_iff.mp hxC
    have hz : σ ^ z = 1 := by
      simpa [map_zpow, t, pGammaL2FieldProjection] using hxker
    apply mem_bot.mpr
    apply Subtype.ext
    change (SemidirectProduct.inr σ : PGammaL2 F) ^ z = 1
    rw [← map_zpow, hz, map_one]
  let A := D ⊔ C
  let : IsElementaryAbelian 2 A := IsElementaryAbelian.sup_of_le_centralizer hCD
  have hAc : Nat.card A = 8 := by
    rw [card_sup_eq_mul_of_normalizes_of_disjoint D C
      (hCD.trans (Subgroup.centralizer_le_normalizer _)) hDC, hD.card_four]
    change 4 * Nat.card (zpowers t) = 8
    rw [Nat.card_zpowers, hto]
  have hr : Group.rank A = 3 := le_antisymm
    (IsElementaryAbelian.rank_le_of_card_le (p := 2) A (by simpa using hAc.le))
    (IsElementaryAbelian.rank_ge_of_card (p := 2) (by simpa using hAc))
  obtain ⟨T, hAT⟩ := IsPGroup.exists_le_sylow (IsElementaryAbelian.isPGroup 2 A)
  exact ⟨T, A, inferInstance, hAT, hr, (le_sup_right : C ≤ A) (mem_zpowers t),
    rank_three_selfCentralizing hp hodd hF S hS A inferInstance hr,
    tau_eq_of_rank_three hp hodd hF hlarge S hS T A inferInstance hAT hr⟩

end CFSG.Quasithin.ChapterE.ValuesOdd.PSLTwoGeneration.SquareGeometry.FieldWitnesses.PureField
