module

public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSLTwoGeneration.SquareGeometry.FieldWitnesses.PureField.InnerEscape.TwentyFive.Geometry.ActorFusion.Inputs
public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSLTwoGeneration.SquareGeometry.FieldWitnesses.PureField.InnerEscape.TwentyFive.Geometry.ActorFusion.PairIntersection.Inputs
public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSLTwoGeneration.SquareGeometry.FieldWitnesses.PureField.InnerEscape.TwentyFive.Geometry.ActorFusion.PairIntersection.LinearRoots
public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSLTwoGeneration.SquareGeometry.FieldWitnesses.PureField.InnerEscape.TwentyFive.Geometry.ActorFusion.PairIntersection.LocalRoots

/-!
# Projected overlap from linear square roots of order four

A nontrivial linear element in both marked large subgroups has square
roots of order four in both centralizers. If linear roots with the same square differ
only by inversion, one root belongs to both centralizers and commutes
with the twist z. Uniqueness of the commuting linear involution forces
its square to be z. Multiplication by the twisted field involution
reduces every common element to this linear case. The original pure-field
projection therefore lands in the cyclic subgroup generated by the image
of z, of order at most two. The last theorem applies the published actor
coverage consumer to this literal bound.

The final assembly discharges both root calculations using `LinearRoots`
and `LocalRoots`, proving the intersection bound for every frame over the
field of order 25. `Intrinsic` proves invariance under arbitrary supplied
comparisons. The coverage corollary supplies the pair calculation needed
by actor fusion; the full source E-generation theorem has further inputs.

Source: Aschbacher--Smith E.1.5, E.1.8 and E.1.14(6), printed pp.210--214;
the last cites Asc82a, Lemma 4.10.
-/

public section
noncomputable section
open Subgroup GorensteinWalter Matrix

namespace CFSG.Quasithin.ChapterE.ValuesOdd.PSLTwoGeneration.SquareGeometry.FieldWitnesses.PureField.InnerEscape.TwentyFive.Geometry.Frame
variable {F : Type*} [Field F] [Finite F] {σ : F ≃+* F}
variable (c : Frame σ) (hF : Nat.card F = 5 ^ 2) (hσ : orderOf σ = 2)

omit [Finite F] in
private theorem pair_twist_mem (hσ : orderOf σ = 2) :
    c.z ∈ c.centralizerAt false := by
  have hz : c.z * c.z = 1 := by
    simpa only [c.z_order, pow_two] using pow_orderOf_eq_one c.z
  have hs : pure σ * pure σ = 1 := by
    have h := pow_orderOf_eq_one (c.involution false)
    rw [c.involution_order hσ false] at h
    simpa only [involution, pow_two] using h
  have ht : (c.z * pure σ) * (c.z * pure σ) = 1 := by
    simpa only [c.twist_order, pow_two] using pow_orderOf_eq_one (c.z * pure σ)
  rw [centralizerAt, mem_centralizer_singleton_iff]
  change c.z * pure σ = pure σ * c.z
  calc
    c.z * pure σ = (c.z * pure σ)⁻¹ := (inv_eq_of_mul_eq_one_left ht).symm
    _ = pure σ * c.z := by
      rw [_root_.mul_inv_rev, inv_eq_of_mul_eq_one_left hs, inv_eq_of_mul_eq_one_left hz]

omit [Finite F] in
private theorem pair_commute_twist {r : innerModel F σ}
    (h0 : r ∈ c.centralizerAt false) (h1 : r ∈ c.centralizerAt true) :
    Commute c.z r := by
  have hp : r * pure σ = pure σ * r := mem_centralizer_singleton_iff.mp h0
  have ht : r * (c.z * pure σ) = (c.z * pure σ) * r :=
    mem_centralizer_singleton_iff.mp h1
  have hz : r * c.z = c.z * r := by
    apply mul_right_cancel (b := pure σ)
    calc
      r * c.z * pure σ = r * (c.z * pure σ) := mul_assoc _ _ _
      _ = (c.z * pure σ) * r := ht
      _ = c.z * r * pure σ := by rw [mul_assoc, ← hp, ← mul_assoc]
  exact hz.symm

/-- Linear elements in the overlap are determined by the two independent
root calculations. No generation or actor-fusion premise is used. -/
theorem linear_common_eq_one_or_twist
    (hl : PairIntersection.LocalSquareRoots c hF hσ)
    (hr : PairIntersection.LinearRootRigidity F σ)
    {x : innerModel F σ}
    (hx : x ∈ c.large hF hσ false ⊓ c.large hF hσ true)
    (hxr : (x : PGammaL2 F).right = 1) : x = 1 ∨ x = c.z := by
  by_cases hx1 : x = 1
  · exact Or.inl hx1
  obtain ⟨r, hrC, hrr, hr2, hr4⟩ := hl.roots false x hx.1 hxr hx1
  obtain ⟨s, hsC, hsr, hs2, _⟩ := hl.roots true x hx.2 hxr hx1
  have hrD : r ∈ c.centralizerAt true := by
    rcases hr.same_square r s hrr hsr hr4 (hr2.trans hs2.symm) with hs | hs
    · simpa only [hs] using hsC
    · have hh := (c.centralizerAt true).inv_mem hsC
      simpa only [hs, inv_inv] using hh
  exact Or.inr ((hr.central_involution r c.z hrr c.z_linear hr4 c.z_order
    (pair_commute_twist c hrC hrD)).trans hr2).symm

private theorem pair_projection_pure :
    c.projection hF hσ false
      ⟨pure σ, mem_centralizer_singleton_iff.mpr rfl⟩ = 1 := by
  let e := pureCentralizerEquiv (by decide : Nat.Prime 5) (by decide) hF σ hσ
  let s : zpowers σ := ⟨σ, mem_zpowers σ⟩
  have he : e.symm (1, s) =
      (⟨pure σ, mem_centralizer_singleton_iff.mpr rfl⟩ :
        centralizer ({pure σ} : Set (innerModel F σ))) := by
    apply Subtype.ext
    apply Subtype.ext
    rw [pureCentralizerEquiv_symm_coe]
    simp [fixedProductMap, fixedProjectiveMap, s, pure]
  change (e ⟨pure σ, mem_centralizer_singleton_iff.mpr rfl⟩).1 = 1
  rw [← he, e.apply_symm_apply]

/-- The local and linear root calculations imply the exact projected
intersection bound. -/
theorem pairIntersectionBound_of_squareRoots
    (hl : PairIntersection.LocalSquareRoots c hF hσ)
    (hr : PairIntersection.LinearRootRigidity F σ) :
    ActorFusion.PairIntersectionBound c hF hσ := by
  classical
  let C := c.centralizerAt false
  let q := c.projection hF hσ false
  let z : C := ⟨c.z, pair_twist_mem c hσ⟩
  let s : C := ⟨pure σ, mem_centralizer_singleton_iff.mpr rfl⟩
  let J := c.large hF hσ false ⊓ c.large hF hσ true
  have hs : q s = 1 := pair_projection_pure c hF hσ
  have hz2 : (q z) ^ 2 = 1 := by
    rw [← map_pow]
    have hh : z ^ 2 = 1 := Subtype.ext (by
      change c.z ^ 2 = 1
      simpa only [c.z_order] using pow_orderOf_eq_one c.z)
    rw [hh, map_one]
  have hq (x : C) (hx : x ∈ J.subgroupOf C) : q x ∈ zpowers (q z) := by
    have hxc : (x : innerModel F σ) ∈ J := hx
    rcases fieldAut_eq_one_or (by decide : Nat.Prime 5) hF σ
        ((orderOf_eq_prime_iff (x := σ)).mp hσ).2
        ((x : innerModel F σ) : PGammaL2 F).right with hx1 | hxσ
    · rcases linear_common_eq_one_or_twist c hF hσ hl hr hxc hx1 with h | h
      · have he : x = 1 := Subtype.ext h
        simp only [he, map_one, one_mem]
      · have he : x = z := Subtype.ext h
        exact he ▸ mem_zpowers (q z)
    · let y : innerModel F σ := (x : innerModel F σ) * c.involution true
      have hyJ : y ∈ J := J.mul_mem hxc ⟨hl.twist_mem false, hl.twist_mem true⟩
      have hyr : (y : PGammaL2 F).right = 1 := by
        change ((x : innerModel F σ) : PGammaL2 F).right *
          ((c.z : PGammaL2 F).right * σ) = 1
        rw [hxσ, c.z_linear, one_mul]
        simpa only [pow_two] using ((orderOf_eq_prime_iff (x := σ)).mp hσ).1
      have hqmul : q (x * (z * s)) = q x * q z := by simp only [map_mul, hs, mul_one]
      rcases linear_common_eq_one_or_twist c hF hσ hl hr hyJ hyr with hy | hy
      · have hh : x * (z * s) = 1 := Subtype.ext hy
        have h : q x * q z = 1 := by rw [← hqmul, hh, map_one]
        have hqz : q x = (q z)⁻¹ := eq_inv_of_mul_eq_one_left h
        rw [hqz]
        exact (zpowers (q z)).inv_mem (mem_zpowers _)
      · have hh : x * (z * s) = z := Subtype.ext hy
        have h : q x * q z = q z := by rw [← hqmul, hh]
        have hqx : q x = 1 := mul_right_cancel (h.trans (one_mul _).symm)
        rw [hqx]
        exact one_mem _
  let : Finite (zpowers (q z)) := Nat.finite_of_card_ne_zero (by
    rw [Nat.card_zpowers]
    exact orderOf_ne_zero_iff.mpr (isOfFinOrder_iff_pow_eq_one.mpr ⟨2, by decide, hz2⟩))
  have hle : (J.subgroupOf C).map q ≤ zpowers (q z) := by
    rintro _ ⟨x, hx, rfl⟩
    exact hq x hx
  change Nat.card ((J.subgroupOf C).map q) ≤ 2
  exact (Nat.card_le_card_of_injective (Subgroup.inclusion hle)
    (Subgroup.inclusion_injective hle)).trans (by
      rw [Nat.card_zpowers]
      exact Nat.le_of_dvd (by decide) ((orderOf_dvd_iff_pow_eq_one).mpr hz2))

/-- The root calculations supply the coverage clause used by actor fusion. -/
theorem positioned_coverage_of_squareRoots [Finite (innerModel F σ)]
    (hl : PairIntersection.LocalSquareRoots c hF hσ)
    (hr : PairIntersection.LinearRootRigidity F σ)
    {A : Subgroup (innerModel F σ)} (hA : c.Eligible A) :
    c.IsPositioned hF hσ false A ∨ c.IsPositioned hF hσ true A :=
  c.positioned_coverage_of_intersection_bound hF hσ
    (c.pairIntersectionBound_of_squareRoots hF hσ hl hr) hA

/-- The literal projected overlap of the two marked large subgroups has
order at most two, for every supplied comparison of the centralizers. -/
theorem pairIntersectionBound [Finite (innerModel F σ)] :
    ActorFusion.PairIntersectionBound c hF hσ :=
  c.pairIntersectionBound_of_squareRoots hF hσ
    (c.localSquareRoots hF hσ) (PairIntersection.linearRootRigidity F σ hF)

/-- Every eligible actor is directly positioned on at least one side.
This discharges the pair-intersection input to the actor-fusion coverage. -/
theorem positioned_coverage [Finite (innerModel F σ)]
    {A : Subgroup (innerModel F σ)} (hA : c.Eligible A) :
    c.IsPositioned hF hσ false A ∨ c.IsPositioned hF hσ true A :=
  c.positioned_coverage_of_intersection_bound hF hσ
    (c.pairIntersectionBound hF hσ) hA

end CFSG.Quasithin.ChapterE.ValuesOdd.PSLTwoGeneration.SquareGeometry.FieldWitnesses.PureField.InnerEscape.TwentyFive.Geometry.Frame
