module

public import Mathlib.GroupTheory.SpecificGroups.Alternating
public import Mathlib.GroupTheory.Sylow
public import Mathlib.Tactic.NormNum

/-!
# Five-point calculations for the characteristic-five square roots

The Sylow marking consists of the eight words generated by (01), (23),
and (02)(13), as in `Theory.SpecificGroups.SymmetricFive.OuterFourGeometry`.
Conjugating to this marking shows that an element centralizing a Sylow is
an even permutation. For an even element whose fourth power is one, the
first two moved pairs give an explicit four-cycle square root (with the
identity handled separately). All finite checks concern permutations or
eight words; no subgroup-lattice enumeration is used.

These are the permutation calculations transported to the literal field
centralizers in `LocalRoots`, supporting Aschbacher--Smith E.1.14(6),
printed p.214, citing Aschbacher (1982), Lemma 4.10.
-/

public section
open Subgroup
namespace CFSG.Quasithin.ChapterE.ValuesOdd.PSLTwoGeneration.SquareGeometry.FieldWitnesses.PureField.InnerEscape.TwentyFive.Geometry.Frame.LocalRoots
private abbrev D := Equiv.Perm (Fin 5)
private def a : D := Equiv.swap 0 1
private def b : D := Equiv.swap 2 3
private def c : D := Equiv.swap 0 2 * Equiv.swap 1 3
private def word : Fin 8 → D := ![1, a, b, a*b, c, a*c, b*c, a*b*c]
private def eight : Subgroup D where
  carrier := Set.range word
  one_mem' := ⟨0, rfl⟩
  mul_mem' := by
    have hc : ∀ i j, ∃ k, word i * word j = word k := by decide +kernel
    rintro x y ⟨i, rfl⟩ ⟨j, rfl⟩
    obtain ⟨k, hk⟩ := hc i j
    exact ⟨k, hk.symm⟩
  inv_mem' := by
    have hc : ∀ i, ∃ j, (word i)⁻¹ = word j := by decide +kernel
    rintro x ⟨i, rfl⟩
    obtain ⟨j, hj⟩ := hc i
    exact ⟨j, hj.symm⟩
private theorem eight_card : Nat.card eight = 8 := by
  have hi : Function.Injective word := by decide +kernel
  change Nat.card (Set.range word) = 8
  rw [← Nat.card_congr (Equiv.ofInjective _ hi)]
  simp
private noncomputable def standardSylow : Sylow 2 D := Sylow.ofCard eight (by
  rw [eight_card, Nat.card_perm]
  norm_num [Nat.card_eq_fintype_card, Nat.factorial]
  have hfac : (120 : ℕ).factorization 2 = 3 := by
    rw [show 120 = 2 ^ 3 * 15 from rfl, Nat.factorization_mul (by decide) (by decide),
      Finsupp.add_apply, Nat.factorization_pow_self (by decide),
      Nat.factorization_eq_zero_of_not_dvd (by decide : ¬2 ∣ 15)]
  rw [hfac]
  norm_num)

/-- An element centralizing a Sylow two-subgroup of S₅ is even. -/
theorem even_of_centralizes_sylow (P : Sylow 2 (Equiv.Perm (Fin 5)))
    (x : Equiv.Perm (Fin 5))
    (hc : ∀ y ∈ (P : Subgroup (Equiv.Perm (Fin 5))), y * x = x * y) :
    x ∈ alternatingGroup (Fin 5) := by
  classical
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq D P standardSylow
  let e := MulAut.conj g
  have hP : (P : Subgroup (Equiv.Perm (Fin 5))).map e.toMonoidHom = eight :=
    congrArg (fun Q : Sylow 2 D => (Q : Subgroup D)) hg
  have ht (y : D) (hy : y ∈ eight) : y * e x = e x * y := by
    rw [← hP] at hy
    obtain ⟨z, hz, rfl⟩ := hy
    simpa only [map_mul, MulEquiv.coe_toMonoidHom] using congrArg e (hc z hz)
  have he : (e x).sign = 1 := by
    have hcheck : ∀ t : D, a * t = t * a → b * t = t * b → c * t = t * c →
        t.sign = 1 := by decide +kernel
    exact hcheck (e x) (ht a ⟨1, rfl⟩) (ht b ⟨2, rfl⟩) (ht c ⟨4, rfl⟩)
  apply Equiv.Perm.mem_alternatingGroup.mpr
  change (g * x * g⁻¹).sign = 1 at he
  simpa only [map_mul, map_inv, mul_comm (Equiv.Perm.sign g) (Equiv.Perm.sign x),
    mul_inv_cancel_right] using he

private def chosenRoot (x : D) : D :=
  if x = 1 then 1 else
    let a := ((List.finRange 5).find? (fun a => x a ≠ a)).getD 0
    let b := x a
    let c := ((List.finRange 5).find? (fun c => x c ≠ c ∧ c ≠ a ∧ c ≠ b)).getD 0
    let d := x c
    Equiv.swap a c * Equiv.swap c b * Equiv.swap b d

/-- The even elements of two-power order in S₅ are involutions and squares. -/
theorem even_fourth_roots (x : Equiv.Perm (Fin 5)) (hx : x ^ 4 = 1) (he : x.sign = 1) :
    x ^ 2 = 1 ∧ ∃ r : Equiv.Perm (Fin 5), r ^ 2 = x := by
  have hc : ∀ t : D, t ^ 4 = 1 → t.sign = 1 →
      t ^ 2 = 1 ∧ chosenRoot t ^ 2 = t := by decide +kernel
  exact ⟨(hc x hx he).1, chosenRoot x, (hc x hx he).2⟩
end CFSG.Quasithin.ChapterE.ValuesOdd.PSLTwoGeneration.SquareGeometry.FieldWitnesses.PureField.InnerEscape.TwentyFive.Geometry.Frame.LocalRoots
