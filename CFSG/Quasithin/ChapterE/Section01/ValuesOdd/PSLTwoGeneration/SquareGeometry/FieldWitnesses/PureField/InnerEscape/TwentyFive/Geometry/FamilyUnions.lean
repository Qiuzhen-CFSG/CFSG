module

public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSLTwoGeneration.SquareGeometry.FieldWitnesses.PureField.InnerEscape.TwentyFive.Reduction

/-!
# Weak closure for unions of ambient actor orbits

An invariant family contains every ambient conjugate of each of its actors.
Consequently its weak closure contains the span of each orbit in the chosen
Sylow subgroup. If all nontrivial orbit spans have one of two nested values,
the weak closure has one of those values as well. This establishes the
union step without making a false monotonicity claim about normalizers.

The characteristic-five assembly applies this to families whose actors
cannot be positioned in one of the two subfield centralizers.
Source convention: Aschbacher--Smith E.1.5, printed p.210.
-/

public section
open Subgroup
namespace CFSG.Quasithin.ChapterE.ValuesOdd.PSLTwoGeneration.SquareGeometry.FieldWitnesses.PureField.InnerEscape.TwentyFive.Geometry

variable {G : Type*} [Group G]

/-- Actual ambient conjugates of `A` lying in `T`. -/
@[expose] def conjugatesIn (T A : Subgroup G) : Set (Subgroup G) :=
  {B | B ≤ T ∧ ∃ g : G, A.map (MulAut.conj g).toMonoidHom = B}

/-- The subgroup generated by all such conjugates, not merely their union. -/
@[expose] def orbitSpan (T A : Subgroup G) : Subgroup G := sSup (conjugatesIn T A)

theorem le_orbitSpan {T A : Subgroup G} (hAT : A ≤ T) : A ≤ orbitSpan T A := by
  apply le_sSup
  refine ⟨hAT, 1, ?_⟩
  have he : (MulAut.conj (1 : G)).toMonoidHom = MonoidHom.id G := by
    ext x
    simp
  rw [he]
  exact A.map_id

theorem orbitSpan_le_weakClosure {T A : Subgroup G} {Ω : Set (Subgroup G)}
    (hΩ : IsElementaryFamily Ω) (hA : A ∈ Ω) : orbitSpan T A ≤ weakClosure T Ω := by
  apply sSup_le
  rintro B ⟨hBT, g, rfl⟩
  exact le_sSup ⟨hΩ.2 g A hA, hBT⟩

/-- A nonempty invariant family with two nested orbit spans has one of those
two weak closures. The trivial subgroup, if present, has no effect. -/
theorem weakClosure_eq_of_two_orbitSpans (T U V : Subgroup G)
    {Ω : Set (Subgroup G)} (hΩ : IsElementaryFamily Ω) (hUV : U ≤ V)
    (hne : ∃ A ∈ Ω, A ≤ T ∧ A ≠ ⊥)
    (hspans : ∀ A ∈ Ω, A ≤ T → A ≠ ⊥ → orbitSpan T A = U ∨ orbitSpan T A = V) :
    weakClosure T Ω = U ∨ weakClosure T Ω = V := by
  classical
  have hupper (W : Subgroup G)
      (hW : ∀ A ∈ Ω, A ≤ T → A ≠ ⊥ → orbitSpan T A ≤ W) : weakClosure T Ω ≤ W := by
    apply sSup_le
    rintro A ⟨hA, hAT⟩
    by_cases hbot : A = ⊥
    · simp [hbot]
    · exact (le_orbitSpan hAT).trans (hW A hA hAT hbot)
  by_cases hV : ∃ A ∈ Ω, A ≤ T ∧ A ≠ ⊥ ∧ orbitSpan T A = V
  · obtain ⟨A, hA, hAT, hbot, hAV⟩ := hV
    right
    apply le_antisymm
    · apply hupper
      intro B hB hBT hBne
      rcases hspans B hB hBT hBne with h | h
      · exact h.le.trans hUV
      · exact h.le
    · rw [← hAV]
      exact orbitSpan_le_weakClosure hΩ hA
  · have hU (A : Subgroup G) (hA : A ∈ Ω) (hAT : A ≤ T) (hbot : A ≠ ⊥) :
        orbitSpan T A = U :=
      (hspans A hA hAT hbot).resolve_right (fun h => hV ⟨A, hA, hAT, hbot, h⟩)
    obtain ⟨A, hA, hAT, hbot⟩ := hne
    left
    apply le_antisymm (hupper U fun B hB hBT hBne => (hU B hB hBT hBne).le)
    rw [← hU A hA hAT hbot]
    exact orbitSpan_le_weakClosure hΩ hA

end CFSG.Quasithin.ChapterE.ValuesOdd.PSLTwoGeneration.SquareGeometry.FieldWitnesses.PureField.InnerEscape.TwentyFive.Geometry
