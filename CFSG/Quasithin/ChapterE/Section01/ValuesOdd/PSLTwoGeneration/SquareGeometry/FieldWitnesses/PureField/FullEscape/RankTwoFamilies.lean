module
public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSLTwoGeneration.SquareGeometry.FieldWitnesses.PureField.FullEscape.RankTwoFamilies.Coordinates
public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSLTwoGeneration.SquareGeometry.FieldWitnesses.PureField.FullEscape.RankTwoFamilies.LinearActors
public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSLTwoGeneration.SquareGeometry.FieldWitnesses.PureField.FullEscape.RankTwoFamilies.MarkedActors

/-!
# The linear and marked-mixed cases of rank-two family escape

The coordinate theorem straightens every non-linear four-group to
B⟨σ⟩, where B is generated by an actual involution of the fixed-field
PGL₂. The reduction below applies this conjugation to the Sylow subgroup,
the entire invariant family, and the maximal overgroup. The weak closure
and its normalizer are transported exactly, and the final E-member is
carried back through the inverse map. No rank-selected subfamily is used.

The final theorem `escape` discharges both placement inputs with
`LinearActors.escape` and `MarkedActors.escape`. It constructs the intrinsic
E1/E2 member, its literal Sylow intersection and escape from the prescribed
overgroup, including characteristics three and five. Its conclusion has the
exact htwo signature of `FullEscape.largeFamilyEscape_of_rank_branches`,
using the actual `Subgroup.topEquiv`. The escaping actor stays in the original
family and may have rank three. Full-model assembly remains with `FullEscape`.

Source: Aschbacher–Smith, A.2.3(2), E.1.2 and E.1.14(6), printed pp.33,
209–210 and 214; the last cites Aschbacher (1982), Lemma 4.10.
-/

public section
open Subgroup GorensteinWalter
namespace CFSG.Quasithin.ChapterE.ValuesOdd.PSLTwoGeneration.SquareGeometry.FieldWitnesses.PureField.FullEscape.RankTwoFamilies
variable {F : Type*} [Field F] [Finite F] [Finite (PGammaL2 F)]

omit [Finite F] in
private theorem top_escape_of_ambient
    (h : ∀ (T : Sylow 2 (PGammaL2 F)) (Ω : Set (Subgroup (PGammaL2 F))),
      IsElementaryFamily Ω →
      (∀ A ∈ Ω, A ≤ (T : Subgroup _) → A ≠ ⊥ → Group.rank A = 2 ∨ Group.rank A = 3) →
      (∃ A ∈ Ω, A ≤ (T : Subgroup _) ∧ Group.rank A = 2) →
      ∀ M : Subgroup (PGammaL2 F), IsCoatom M → (T : Subgroup _) ≤ M →
        normalizer (weakClosure (T : Subgroup _) Ω : Set _) ≤ M →
        ∃ A ∈ Ω, A ≤ (T : Subgroup _) ∧ ∃ H, IsEMemberAt 1 (T : Subgroup _) A H ∧ ¬ H ≤ M) :
    ∀ (T : Sylow 2 (⊤ : Subgroup (PGammaL2 F)))
      (Ω : Set (Subgroup (⊤ : Subgroup (PGammaL2 F)))), IsElementaryFamily Ω →
      (∀ A ∈ Ω, A ≤ (T : Subgroup _) → A ≠ ⊥ → Group.rank A = 2 ∨ Group.rank A = 3) →
      (∃ A ∈ Ω, A ≤ (T : Subgroup _) ∧ Group.rank A = 2) →
      ∀ M : Subgroup (⊤ : Subgroup (PGammaL2 F)), IsCoatom M → (T : Subgroup _) ≤ M →
        normalizer (weakClosure (T : Subgroup _) Ω : Set _) ≤ M →
        ∃ A ∈ Ω, A ≤ (T : Subgroup _) ∧ ∃ H, IsEMemberAt 1 (T : Subgroup _) A H ∧ ¬ H ≤ M := by
  intro T Ω hΩ hrange htwo M hM hTM hNM
  let e : (⊤ : Subgroup (PGammaL2 F)) ≃* PGammaL2 F := Subgroup.topEquiv
  let T' := T.mapSurjective (f := e.toMonoidHom) e.surjective
  let Ω' : Set (Subgroup (PGammaL2 F)) := {B | B.map e.symm.toMonoidHom ∈ Ω}
  have hrange' : ∀ B ∈ Ω', B ≤ (T' : Subgroup _) → B ≠ ⊥ →
      Group.rank B = 2 ∨ Group.rank B = 3 := by
    intro B hB hBT hBne
    have hDT : B.map e.symm.toMonoidHom ≤ (T : Subgroup _) := by
      have hh := map_mono (f := e.symm.toMonoidHom) hBT
      simpa [T', map_map] using hh
    have hDne : B.map e.symm.toMonoidHom ≠ ⊥ := by
      intro hh
      have hi := congrArg (Subgroup.map e.toMonoidHom) hh
      simp [map_map] at hi
      exact hBne hi
    have hh := hrange _ hB hDT hDne
    rwa [← Group.rank_congr (B.equivMapOfInjective e.symm.toMonoidHom e.symm.injective)] at hh
  have htwo' : ∃ A ∈ Ω', A ≤ (T' : Subgroup _) ∧ Group.rank A = 2 := by
    obtain ⟨A, hA, hAT, hr⟩ := htwo
    refine ⟨A.map e.toMonoidHom, ?_, map_mono hAT, ?_⟩
    · change (A.map e.toMonoidHom).map e.symm.toMonoidHom ∈ Ω
      simpa [map_map] using hA
    · exact (Group.rank_congr (A.equivMapOfInjective e.toMonoidHom e.injective)).symm.trans hr
  have hNM' : normalizer (weakClosure (T' : Subgroup _) Ω' : Set _) ≤ M.map e.toMonoidHom := by
    apply (map_le_map_iff_of_injective (f := e.symm.toMonoidHom) e.symm.injective).mp
    rw [map_normalizer_eq_of_bijective _ e.symm.bijective, map_weakClosure_equiv e.symm]
    simpa [T', map_map] using hNM
  obtain ⟨B, hBΩ, hBT, H, hH, hHM⟩ := h T' Ω' (hΩ.comap_equiv e.symm)
    hrange' htwo' (M.map e.toMonoidHom) ((e.mapSubgroup.isCoatom_iff _).mpr hM)
      (map_mono hTM) hNM'
  refine ⟨B.map e.symm.toMonoidHom, hBΩ, ?_, H.map e.symm.toMonoidHom, ?_, ?_⟩
  · have hh := map_mono (f := e.symm.toMonoidHom) hBT
    simpa [T', map_map] using hh
  · have hh := hH.map_equiv e.symm
    simpa [T', map_map] using hh
  · intro hh
    apply hHM
    have hi := map_mono (f := e.toMonoidHom) hh
    simpa [map_map] using hi

/-- Conditional assembly of linear-actor placement and marked-mixed placement.
Both inputs preserve the original family and allow the escaping actor to differ
from the distinguished four-group. The actual mixed-actor conjugation and all
family, normalizer, Sylow and E-member transports are discharged here. -/
theorem escape_of_linear_and_marked {p : ℕ} (hp : p.Prime) (hodd : Odd p)
    (hF : Nat.card F = p ^ 2) (σ : F ≃+* F) (hsq : σ ^ 2 = 1) (hne : σ ≠ 1)
    (hlinear : ∀ (T : Sylow 2 (PGammaL2 F)) (Ω : Set (Subgroup (PGammaL2 F))),
      IsElementaryFamily Ω →
      (∀ A ∈ Ω, A ≤ (T : Subgroup _) → A ≠ ⊥ → Group.rank A = 2 ∨ Group.rank A = 3) →
      (∃ A ∈ Ω, A ≤ (T : Subgroup _) ∧ Group.rank A = 2 ∧ A ≤ pGammaL2PGLRange F) →
      ∀ M : Subgroup (PGammaL2 F), IsCoatom M → (T : Subgroup _) ≤ M →
        normalizer (weakClosure (T : Subgroup _) Ω : Set _) ≤ M →
        ∃ A ∈ Ω, A ≤ (T : Subgroup _) ∧ ∃ H, IsEMemberAt 1 (T : Subgroup _) A H ∧ ¬ H ≤ M)
    (hmarked : ∀ (T : Sylow 2 (PGammaL2 F)) (Ω : Set (Subgroup (PGammaL2 F))),
      IsElementaryFamily Ω →
      (∀ A ∈ Ω, A ≤ (T : Subgroup _) → A ≠ ⊥ → Group.rank A = 2 ∨ Group.rank A = 3) →
      ∀ b : PGL2 (FixedPoints.subfield (zpowers σ) F), orderOf b = 2 →
      (zpowers b).map (subfieldEmbedding σ) ⊔ zpowers (SemidirectProduct.inr σ) ∈ Ω →
      (zpowers b).map (subfieldEmbedding σ) ⊔ zpowers (SemidirectProduct.inr σ) ≤
        (T : Subgroup _) →
      ∀ M : Subgroup (PGammaL2 F), IsCoatom M → (T : Subgroup _) ≤ M →
        normalizer (weakClosure (T : Subgroup _) Ω : Set _) ≤ M →
        ∃ A ∈ Ω, A ≤ (T : Subgroup _) ∧ ∃ H, IsEMemberAt 1 (T : Subgroup _) A H ∧ ¬ H ≤ M) :
    ∀ (T : Sylow 2 (⊤ : Subgroup (PGammaL2 F)))
      (Ω : Set (Subgroup (⊤ : Subgroup (PGammaL2 F)))), IsElementaryFamily Ω →
      (∀ A ∈ Ω, A ≤ (T : Subgroup _) → A ≠ ⊥ → Group.rank A = 2 ∨ Group.rank A = 3) →
      (∃ A ∈ Ω, A ≤ (T : Subgroup _) ∧ Group.rank A = 2) →
      ∀ M : Subgroup (⊤ : Subgroup (PGammaL2 F)), IsCoatom M → (T : Subgroup _) ≤ M →
        normalizer (weakClosure (T : Subgroup _) Ω : Set _) ≤ M →
        ∃ A ∈ Ω, A ≤ (T : Subgroup _) ∧ ∃ H, IsEMemberAt 1 (T : Subgroup _) A H ∧ ¬ H ≤ M := by
  apply top_escape_of_ambient
  intro T Ω hΩ hrange htwo M hM hTM hNM
  classical
  obtain ⟨A, hAΩ, hAT, hrA⟩ := htwo
  by_cases hAL : A ≤ pGammaL2PGLRange F
  · exact hlinear T Ω hΩ hrange ⟨A, hAΩ, hAT, hrA, hAL⟩ M hM hTM hNM
  obtain ⟨c, b, hb, hcoord⟩ := mixed_rank_two_coordinates hp hodd hF σ hsq hne
    A (hΩ.1 A hAΩ) hrA hAL
  let e := MulAut.conj (SemidirectProduct.inl c : PGammaL2 F)⁻¹
  let T' := T.mapSurjective (f := e.toMonoidHom) e.surjective
  let Ω' : Set (Subgroup (PGammaL2 F)) := {B | B.map e.symm.toMonoidHom ∈ Ω}
  have hΩ' : IsElementaryFamily Ω' := hΩ.comap_equiv e.symm
  have hrange' : ∀ B ∈ Ω', B ≤ (T' : Subgroup _) → B ≠ ⊥ →
      Group.rank B = 2 ∨ Group.rank B = 3 := by
    intro B hB hBT hBne
    have hDT : B.map e.symm.toMonoidHom ≤ (T : Subgroup _) := by
      have hh := map_mono (f := e.symm.toMonoidHom) hBT
      simpa [T', map_map] using hh
    have hDne : B.map e.symm.toMonoidHom ≠ ⊥ := by
      intro hh
      have hi := congrArg (Subgroup.map e.toMonoidHom) hh
      simp [map_map] at hi
      exact hBne hi
    have hh := hrange _ hB hDT hDne
    rwa [← Group.rank_congr (B.equivMapOfInjective e.symm.toMonoidHom e.symm.injective)] at hh
  have hNM' : normalizer (weakClosure (T' : Subgroup _) Ω' : Set _) ≤ M.map e.toMonoidHom := by
    apply (map_le_map_iff_of_injective (f := e.symm.toMonoidHom) e.symm.injective).mp
    rw [map_normalizer_eq_of_bijective _ e.symm.bijective,
      map_weakClosure_equiv e.symm]
    simpa [T', map_map] using hNM
  have hAΩ' : A.map e.toMonoidHom ∈ Ω' := by
    change (A.map e.toMonoidHom).map e.symm.toMonoidHom ∈ Ω
    simpa [map_map] using hAΩ
  have hAT' : A.map e.toMonoidHom ≤ (T' : Subgroup _) := map_mono hAT
  have hcoord' : A.map e.toMonoidHom =
      (zpowers b).map (subfieldEmbedding σ) ⊔ zpowers (SemidirectProduct.inr σ) := hcoord
  rw [hcoord'] at hAΩ' hAT'
  obtain ⟨B, hBΩ, hBT, H, hH, hHM⟩ := hmarked T' Ω' hΩ' hrange'
    b hb hAΩ' hAT' (M.map e.toMonoidHom) ((e.mapSubgroup.isCoatom_iff _).mpr hM)
      (map_mono hTM) hNM'
  refine ⟨B.map e.symm.toMonoidHom, hBΩ, ?_, H.map e.symm.toMonoidHom, ?_, ?_⟩
  · have hh := map_mono (f := e.symm.toMonoidHom) hBT
    simpa [T', map_map] using hh
  · have hh := hH.map_equiv e.symm
    simpa [T', map_map] using hh
  · intro hh
    apply hHM
    have hi := map_mono (f := e.toMonoidHom) hh
    simpa [map_map] using hi

/-- The rank-two-family branch of full semilinear escape, with both linear
and marked-mixed placement discharged. This is the literal htwo input of
`FullEscape.largeFamilyEscape_of_rank_branches`, including p=3 and p=5.
The original family, its weak closure and every intrinsic E1/E2 clause are
preserved; the escaping actor need not be the distinguished four-group. -/
theorem escape {p : ℕ} (hp : p.Prime) (hodd : Odd p)
    (hF : Nat.card F = p ^ 2) (hlarge : 5 < p ^ 2)
    (σ : F ≃+* F) (hsq : σ ^ 2 = 1) (hne : σ ≠ 1) :
    ∀ (T : Sylow 2 (⊤ : Subgroup (PGammaL2 F)))
      (Ω : Set (Subgroup (⊤ : Subgroup (PGammaL2 F)))), IsElementaryFamily Ω →
      (∀ A ∈ Ω, A ≤ (T : Subgroup _) → A ≠ ⊥ →
        Group.rank A = 2 ∨ Group.rank A = 3) →
      (∃ A ∈ Ω, A ≤ (T : Subgroup _) ∧ Group.rank A = 2) →
      ∀ M : Subgroup (⊤ : Subgroup (PGammaL2 F)), IsCoatom M →
        (T : Subgroup _) ≤ M → normalizer (weakClosure (T : Subgroup _) Ω : Set _) ≤ M →
        ∃ A ∈ Ω, A ≤ (T : Subgroup _) ∧
          ∃ H, IsEMemberAt 1 (T : Subgroup _) A H ∧ ¬ H ≤ M := by
  exact escape_of_linear_and_marked hp hodd hF σ hsq hne
    (LinearActors.escape hp hodd hF hlarge)
    (MarkedActors.escape hp hodd hF hlarge σ hsq hne)

end CFSG.Quasithin.ChapterE.ValuesOdd.PSLTwoGeneration.SquareGeometry.FieldWitnesses.PureField.FullEscape.RankTwoFamilies
