module

public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSLTwoGeneration.PrimeGeometry.LocalModels
public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSLTwoGeneration.PrimeGeometry.Reduction
public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSLTwoGeneration.PrimeGeometry.OddSections.Symmetric
public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSLTwoGeneration.PrimeGeometry.OddSections.Dihedral

/-!
# Intrinsic odd sections of the concrete prime-field local models

For an S₄ local subgroup the actor is explicitly nonnormal, so it has a
nontrivial image in the S₃ quotient. For D₄p, the central two-core has
order two and the quotient is D₂p. In each quotient the odd-prime core is
nontrivial, is generated by its commutators with the actor image, and has
two-group quotient; the actor image has rank one.

The model leaves transport through actual isomorphisms and the literal
intrinsic two-core quotient. The resulting escape theorem discharges the
entire odd-section premise of the concrete-geometry reduction. Ambient
two-core triviality, four-group centralizers, and local placement remain
exactly the geometric inputs supplied by their independent producers.

Source: Aschbacher–Smith, E.1.2(E1) and E.1.5, printed p.210.
-/

public section

open Subgroup
namespace CFSG.Quasithin.ChapterE.ValuesOdd.PSLTwoGeneration.PrimeGeometry
variable {G : Type*} [Group G] [Finite G]

/-- Both actual local models satisfy E.1.2(E1), with the specified actor. -/
theorem eCaseOdd_of_localModel (A H : Subgroup G) (hA : IsKleinFour A)
    (hAH : A ≤ H) (hmodel : LocalModel A H) : ECaseOdd A H := by
  let : IsKleinFour A := hA
  let : IsElementaryAbelian 2 A :=
    { toIsMulCommutative := IsKleinFour.isMulCommutative
      exponent_dvd_p := by simp }
  let : IsElementaryAbelian 2 (A.subgroupOf H) := IsElementaryAbelian.subgroupOf hAH
  have hc : Nat.card (A.subgroupOf H) = 4 := by
    rw [Nat.card_congr (subgroupOfEquivOfLe hAH).toEquiv]
    exact IsKleinFour.card_four
  rcases hmodel with ⟨⟨e⟩, hn⟩ | ⟨p, hp, ho, ⟨e⟩⟩
  · exact ⟨3, Nat.prime_three, by decide,
      OddSections.symmetric_intrinsic (A.subgroupOf H) hc hn e⟩
  · exact ⟨p, hp, ho, OddSections.dihedral_intrinsic hp ho (A.subgroupOf H) hc e⟩

/-- Concrete placement supplies the local escape once the ambient two-core
and four-group centralizer hypotheses hold; the intrinsic E1 calculation is discharged. -/
theorem largeFamilyEscapeAt_of_concrete_localModels (T : Sylow 2 G)
    (hcore : pCore 2 G = ⊥)
    (hcent : ∀ A : Subgroup G, IsKleinFour A → centralizer (A : Set G) = A)
    (hgeometry : ConcreteLocalGeometryAt T) : LargeFamilyEscapeAt T :=
  largeFamilyEscapeAt_of_concrete_geometry T hcore hcent eCaseOdd_of_localModel hgeometry

end CFSG.Quasithin.ChapterE.ValuesOdd.PSLTwoGeneration.PrimeGeometry
