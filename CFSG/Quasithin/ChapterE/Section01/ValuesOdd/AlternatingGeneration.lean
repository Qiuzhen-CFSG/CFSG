module

public import CFSG.Quasithin.ChapterE.Section01.Basic
public import Theory.SpecificGroups.Alternating.SevenSolvableOvergroups
public import CFSG.Quasithin.ChapterE.Section01.ParameterReduction.ChiefOrbit.NormalizerDiagonal.Overgroups
public import CFSG.Quasithin.Defs

/-!
# Rank-one E-generation for the A₇ almost-simple case

The two solvable overgroups constructed from the faithful seven-letter action
contain the supplied Sylow two-subgroup and generate G. Solvable groups are
E₁-generated, and restriction of an elementary family together with E.1.8
places each overgroup in the ambient E-generation target. This proves the
upper-generation assertion in E.1.14(3), with no additional local premises.

The corrected intrinsic tau orbit and every E-member clause are retained
through the proved solvable-generation and inheritance theorems. The lower
bound and the conclusion n(G) = 1 remain with the ValuesOdd assembly.

Source: Aschbacher--Smith, *The Classification of Quasithin Groups*, combined
manuscript of 1 March 2004, E.1.12--14, printed p.214; E.1.14(3) cites
Aschbacher, *GF(2)-representations of finite groups*, Lemma 4.8.
-/

public section

open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterE

universe u
variable {G : Type u} [Group G] [Finite G]

/-- Rank-one E-generation for every finite extension generated by its A₇
socle and a Sylow two-subgroup. -/
theorem isEGenerated_one_of_alternatingSeven_generalizedFitting
    (L : Subgroup G) (hL : L = generalizedFitting G) (T : Sylow 2 G)
    (hLT : L ⊔ (T : Subgroup G) = ⊤) (e : L ≃* alternatingGroup (Fin 7)) :
    IsEGenerated 1 G := by
  obtain ⟨P, Q, hTP, hTQ, hPQ, hP, hQ⟩ :=
    alternatingGroup.SevenSolvableGeneration.exists_solvable_overgroups L T hL hLT e
  let _ := hP
  let _ := hQ
  apply IsEGeneratedAt.isEGenerated (T := T)
  intro Ω hΩ
  apply top_unique
  change ⊤ ≤ ChiefOrbit.generationTarget 1 T Ω
  rw [← hPQ]
  exact sup_le
    (ChiefOrbit.solvable_overgroup_le_generationTarget (by decide) T P hTP hΩ)
    (ChiefOrbit.solvable_overgroup_le_generationTarget (by decide) T Q hTQ hΩ)

/-- The upper-generation assertion in E.1.14(3), including the almost-simple
extensions allowed by the original SQTK hypotheses. -/
theorem isEGenerated_one_of_sqtk_alternatingSeven {K : GroupClass.{u}}
    (_hG : IsSQTK K G) (L : Subgroup G) (hL : L = generalizedFitting G)
    [IsSimpleGroup L] (T : Sylow 2 G) (hLT : L ⊔ (T : Subgroup G) = ⊤)
    (e : L ≃* alternatingGroup (Fin 7)) : IsEGenerated 1 G :=
  isEGenerated_one_of_alternatingSeven_generalizedFitting L hL T hLT e

end CFSG.Quasithin.ChapterE
