module

public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSUThreeGeneration.InnerFamilies.Geometry.SemidihedralTorus.ActorCoordinates.Setup
public import Theory.SpecificGroups.SU3.ProjectiveOuterInvolutions.UnitaryConjugation
public import Theory.GroupTheory.SpecificGroups.KleinFourGenerators

/-!
# Placement of a marked projective unitary four-group

Lift the whole four-group through the odd scalar kernel, keeping its marked
involution `diag(-1,-1,1)`. A second involution has a unit positive eigenvector
by the finite-field unitary eigenbasis theorem. Its matrix is `2vv* - I`;
commutation with the marked involution forces this vector into the negative
two-plane. Completing it by its Hermitian perpendicular gives one unitary
basis change which fixes the marked involution and diagonalizes both generators.

The final argument identifies the image with the subgroup generated by the
literal projective sign matrices in `standardFour`, including the scalar
identifications of the odd-determinant signs. It discharges the
`MarkedFourPlacement` premise of `exists_sign_coordinates_of_model_inputs`;
the independent pointwise-fixer calculation is not used.

Source: Aschbacher--Smith, E.1.14(7), printed p.214, and A.3.21(a),
printed p.55; Aschbacher (1982), Lemma 4.11.
-/

public section

open Matrix Subgroup BenderSuzuki.MatrixGroups
open scoped Matrix
namespace CFSG.Quasithin.ChapterE.ValuesOdd.PSUThreeGeneration.InnerGeometry.SemidihedralTorus
namespace MarkedFour
variable {F : Type*} [Field F]

private theorem unitary_inverse (J : HermitianForm 3 F) (hJ : J.form = 1)
    (U : J.unitarySubgroup) : (U.val⁻¹).val = J.conjTranspose U.val.val := by
  have hu := (J.mem_unitarySubgroup_iff U.val).mp U.property
  rw [hJ, mul_one] at hu
  exact (Units.mul_left_inj U.val).mp ((Units.inv_mul U.val).trans hu.symm)

private theorem reflection_formula (J : HermitianForm 3 F) (hJ : J.form = 1)
    (U : J.unitarySubgroup) (A : J.specialSubgroup)
    (hU : U.val * (Matrix.SU3.standardInvolution J hJ).val * U.val⁻¹ = A.val)
    (i j : Fin 3) :
    A.val.val i j = 2 * U.val.val i 2 * J.conj (U.val.val j 2) - (1 : Matrix (Fin 3) (Fin 3) F) i j := by
  have hh : U.val.val * J.conjTranspose U.val.val = 1 := by
    rw [← unitary_inverse J hJ U]
    exact Units.mul_inv U.val
  have hrow := congrArg (fun M : Matrix (Fin 3) (Fin 3) F => M i j) hh
  have he := congrArg (fun M : GL (Fin 3) F => M.val i j) hU
  simp only [Units.val_mul, unitary_inverse J hJ U, Matrix.SU3.standardInvolution_val] at he
  simp [Matrix.mul_apply, Fin.sum_univ_three, HermitianForm.conjTranspose] at he hrow
  linear_combination -he - hrow

private theorem positive_vector_in_plane (J : HermitianForm 3 F) (hJ : J.form = 1)
    (h2 : (2 : F) ≠ 0) (U : J.unitarySubgroup) (A : J.specialSubgroup)
    (hU : U.val * (Matrix.SU3.standardInvolution J hJ).val * U.val⁻¹ = A.val)
    (hcomm : Commute A (Matrix.SU3.standardInvolution J hJ))
    (hne : A ≠ Matrix.SU3.standardInvolution J hJ) :
    U.val.val 2 2 = 0 ∧
      U.val.val 0 2 * J.conj (U.val.val 0 2) +
        U.val.val 1 2 * J.conj (U.val.val 1 2) = 1 := by
  have hn := (J.mem_unitarySubgroup_iff U.val).mp U.property
  rw [hJ, mul_one] at hn
  have hnorm := congrArg (fun M : Matrix (Fin 3) (Fin 3) F => M 2 2) hn
  simp [Matrix.mul_apply, Fin.sum_univ_three, HermitianForm.conjTranspose] at hnorm
  have hz (i : Fin 3) (hi : i ≠ 2) : A.val.val i 2 = 0 := by
    have he := congrArg (fun M : J.specialSubgroup => M.val.val i 2) hcomm.eq
    simp only [Subgroup.coe_mul, Units.val_mul, Matrix.SU3.standardInvolution_val] at he
    fin_cases i
    · simp [Matrix.mul_apply, Fin.sum_univ_three] at he
      exact (mul_eq_zero.mp (show (2 : F) * A.val.val 0 2 = 0 by linear_combination he)).resolve_left h2
    · simp [Matrix.mul_apply, Fin.sum_univ_three] at he
      exact (mul_eq_zero.mp (show (2 : F) * A.val.val 1 2 = 0 by linear_combination he)).resolve_left h2
    · exact False.elim (hi rfl)
  have hlast : U.val.val 2 2 = 0 := by
    by_contra hlast
    have hconj : J.conj (U.val.val 2 2) ≠ 0 := by simpa using hlast
    have hzero (i : Fin 3) (hi : i ≠ 2) : U.val.val i 2 = 0 := by
      have he := reflection_formula J hJ U A hU i 2
      rw [hz i hi, Matrix.one_apply_ne hi, sub_zero] at he
      exact (mul_eq_zero.mp ((mul_eq_zero.mp he.symm).resolve_right hconj)).resolve_left h2
    have h0 := hzero 0 (by decide)
    have h1 := hzero 1 (by decide)
    have hnorm' : U.val.val 2 2 * J.conj (U.val.val 2 2) = 1 := by
      simpa [h0, h1, mul_comm] using hnorm
    apply hne
    apply Subtype.ext
    apply Units.ext
    ext i j
    rw [reflection_formula J hJ U A hU i j, Matrix.SU3.standardInvolution_val]
    fin_cases i <;> fin_cases j <;> simp [h0, h1]
    linear_combination 2 * hnorm'
  refine ⟨hlast, ?_⟩
  simpa [hlast, mul_comm] using hnorm

private def secondInvolution (J : HermitianForm 3 F) (hJ : J.form = 1) :
    J.specialSubgroup :=
  ⟨signGL ![false, true, true], by
    rw [J.mem_specialSubgroup_iff, hJ]
    constructor
    · ext i j
      fin_cases i <;> fin_cases j <;>
        simp [signGL, UnitaryThree.OddTorusNormalizer.diagonalHom,
          HermitianForm.conjTranspose, Matrix.mul_apply, Fin.sum_univ_three]
    · apply Units.ext
      simp [signGL, UnitaryThree.OddTorusNormalizer.diagonalHom,
        Matrix.det_diagonal, Fin.prod_univ_three]⟩

private theorem secondInvolution_val (J : HermitianForm 3 F) (hJ : J.form = 1) :
    (secondInvolution J hJ).val.val = !![1,0,0;0,-1,0;0,0,-1] := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [secondInvolution, signGL, UnitaryThree.OddTorusNormalizer.diagonalHom]

private def planeChange (J : HermitianForm 3 F) (hJ : J.form = 1)
    (a b : F) (hn : a * J.conj a + b * J.conj b = 1) : J.unitarySubgroup :=
  ⟨⟨!![a, -J.conj b, 0; b, J.conj a, 0; 0, 0, 1],
      !![J.conj a, J.conj b, 0; -b, a, 0; 0, 0, 1], by
        ext i j
        fin_cases i <;> fin_cases j <;>
          simp [Matrix.mul_apply, Fin.sum_univ_three] <;> first | linear_combination hn | ring,
      by
        ext i j
        fin_cases i <;> fin_cases j <;>
          simp [Matrix.mul_apply, Fin.sum_univ_three] <;> first | linear_combination hn | ring⟩, by
    rw [J.mem_unitarySubgroup_iff, hJ, mul_one]
    have hinv (x : F) : J.conj (J.conj x) = x := J.conj_involutive x
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [Matrix.mul_apply, Fin.sum_univ_three, HermitianForm.conjTranspose, hinv] <;> first | linear_combination hn | ring⟩

private theorem planeChange_commutes (J : HermitianForm 3 F) (hJ : J.form = 1)
    (a b : F) (hn : a * J.conj a + b * J.conj b = 1) :
    Commute (planeChange J hJ a b hn).val (Matrix.SU3.standardInvolution J hJ).val := by
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [planeChange, Matrix.SU3.standardInvolution_val, Matrix.mul_apply, Fin.sum_univ_three]

private theorem planeChange_conjugates (J : HermitianForm 3 F) (hJ : J.form = 1)
    (U : J.unitarySubgroup) (A : J.specialSubgroup)
    (hU : U.val * (Matrix.SU3.standardInvolution J hJ).val * U.val⁻¹ = A.val)
    (hz : U.val.val 2 2 = 0)
    (hn : U.val.val 0 2 * J.conj (U.val.val 0 2) +
      U.val.val 1 2 * J.conj (U.val.val 1 2) = 1) :
    let C := planeChange J hJ (U.val.val 0 2) (U.val.val 1 2) hn
    C.val * (secondInvolution J hJ).val * C.val⁻¹ = A.val := by
  apply Units.ext
  ext i j
  rw [reflection_formula J hJ U A hU i j]
  change ((planeChange J hJ _ _ hn).val.val * (secondInvolution J hJ).val.val *
    ((planeChange J hJ _ _ hn).val⁻¹).val) i j = _
  rw [secondInvolution_val]
  fin_cases i <;> fin_cases j <;>
    simp [planeChange, Matrix.mul_apply, Fin.sum_univ_three, hz] <;>
    first | linear_combination -hn | ring

private theorem exists_marked_conjugator [Finite F]
    (J : HermitianForm 3 F) (hJ : J.form = 1) {p : ℕ} [Fact p.Prime] [CharP F p]
    (hp : p ≠ 2) (hcard : Nat.card F = p ^ 2) (hc : ∀ x, J.conj x = x ^ p)
    (A : J.specialSubgroup) (hA : orderOf A = 2)
    (hcomm : Commute A (Matrix.SU3.standardInvolution J hJ))
    (hne : A ≠ Matrix.SU3.standardInvolution J hJ) :
    ∃ C : J.unitarySubgroup,
      J.specialUnitaryConj C (Matrix.SU3.standardInvolution J hJ) =
        Matrix.SU3.standardInvolution J hJ ∧
      J.specialUnitaryConj C A = secondInvolution J hJ := by
  have h2 : (2 : F) ≠ 0 := CharP.cast_ne_zero_of_ne_of_prime F Nat.prime_two hp
  obtain ⟨U, hU⟩ := Matrix.SU3.exists_unitary_involution_conjugator hp hcard J hJ hc A hA
  obtain ⟨hz, hn⟩ := positive_vector_in_plane J hJ h2 U A hU hcomm hne
  let C := planeChange J hJ (U.val.val 0 2) (U.val.val 1 2) hn
  have hCs := planeChange_commutes J hJ (U.val.val 0 2) (U.val.val 1 2) hn
  have hCA := planeChange_conjugates J hJ U A hU hz hn
  change Commute C.val (Matrix.SU3.standardInvolution J hJ).val at hCs
  change C.val * (secondInvolution J hJ).val * C.val⁻¹ = A.val at hCA
  refine ⟨C⁻¹, ?_, ?_⟩
  · apply Subtype.ext
    rw [J.specialUnitaryConj_val]
    change C.val⁻¹ * (Matrix.SU3.standardInvolution J hJ).val * (C.val⁻¹)⁻¹ = _
    rw [hCs.inv_left.eq]
    simp [mul_assoc]
  · apply Subtype.ext
    rw [J.specialUnitaryConj_val]
    change C.val⁻¹ * A.val * (C.val⁻¹)⁻¹ = _
    rw [← hCA]
    simp [mul_assoc]

private theorem standardFour_eq_closure (J : HermitianForm 3 F) (hJ : J.form = 1) :
    standardFour J = closure ({J.specialToProjective (Matrix.SU3.standardInvolution J hJ),
      J.specialToProjective (secondInvolution J hJ)} : Set (ProjectiveSpecialUnitaryMatrixGroup J)) := by
  let s := J.specialToProjective (Matrix.SU3.standardInvolution J hJ)
  let t := J.specialToProjective (secondInvolution J hJ)
  have hsval : s.val = ProjGenLinGroup.mk (Matrix.SU3.standardInvolution J hJ).val :=
    J.specialToProjective_apply_val _
  have htval : t.val = ProjGenLinGroup.mk (secondInvolution J hJ).val :=
    J.specialToProjective_apply_val _
  have ht : t ∈ standardFour J := by
    apply subset_closure
    exact ⟨![false, true, true], htval⟩
  apply le_antisymm
  · apply (closure_le _).mpr
    rintro x ⟨ε, hε⟩
    have hs : s ∈ closure ({s,t} : Set (ProjectiveSpecialUnitaryMatrixGroup J)) :=
      subset_closure (by simp)
    have ht : t ∈ closure ({s,t} : Set (ProjectiveSpecialUnitaryMatrixGroup J)) :=
      subset_closure (by simp)
    have he : x = 1 ∨ x = s ∨ x = t ∨ x = s * t := by
      have heps : ε = ![ε 0, ε 1, ε 2] := by ext i; fin_cases i <;> rfl
      rw [heps] at hε
      generalize ε 0 = a at hε
      generalize ε 1 = b at hε
      generalize ε 2 = c at hε
      cases a <;> cases b <;> cases c
      · left
        apply Subtype.ext
        rw [hε]
        change ProjGenLinGroup.mk _ = ProjGenLinGroup.mk 1
        apply congrArg ProjGenLinGroup.mk
        apply Units.ext
        ext i j
        fin_cases i <;> fin_cases j <;>
          simp [signGL, UnitaryThree.OddTorusNormalizer.diagonalHom]
      · right; left
        apply Subtype.ext
        rw [hε, hsval]
        apply ProjGenLinGroup.mk_eq_mk_iff.mpr
        refine ⟨-1, Units.ext ?_⟩
        ext i j
        fin_cases i <;> fin_cases j <;>
          simp [Matrix.SU3.standardInvolution_val,
            signGL, UnitaryThree.OddTorusNormalizer.diagonalHom,
            GeneralLinearGroup.coe_scalar, Matrix.mul_apply, Fin.sum_univ_three]
      · right; right; right
        apply Subtype.ext
        rw [hε, Subgroup.coe_mul, hsval, htval]
        change ProjGenLinGroup.mk _ = ProjGenLinGroup.mk _ * ProjGenLinGroup.mk _
        rw [← map_mul]
        apply ProjGenLinGroup.mk_eq_mk_iff.mpr
        refine ⟨-1, Units.ext ?_⟩
        ext i j
        fin_cases i <;> fin_cases j <;>
          simp [Matrix.SU3.standardInvolution_val, secondInvolution_val,
            signGL, UnitaryThree.OddTorusNormalizer.diagonalHom,
            GeneralLinearGroup.coe_scalar, Matrix.mul_apply, Fin.sum_univ_three]
      · right; right; left
        exact Subtype.ext (hε.trans htval.symm)
      · right; right; left
        apply Subtype.ext
        rw [hε, htval]
        apply ProjGenLinGroup.mk_eq_mk_iff.mpr
        refine ⟨-1, Units.ext ?_⟩
        ext i j
        fin_cases i <;> fin_cases j <;>
          simp [secondInvolution_val, signGL, UnitaryThree.OddTorusNormalizer.diagonalHom,
            GeneralLinearGroup.coe_scalar, Matrix.mul_apply, Fin.sum_univ_three]
      · right; right; right
        apply Subtype.ext
        rw [hε, Subgroup.coe_mul, hsval, htval]
        change ProjGenLinGroup.mk _ = ProjGenLinGroup.mk _ * ProjGenLinGroup.mk _
        rw [← map_mul]
        apply congrArg ProjGenLinGroup.mk
        apply Units.ext
        ext i j
        fin_cases i <;> fin_cases j <;>
          simp [Matrix.SU3.standardInvolution_val, secondInvolution_val,
            signGL, UnitaryThree.OddTorusNormalizer.diagonalHom,
            Matrix.mul_apply, Fin.sum_univ_three]
      · right; left
        apply Subtype.ext
        rw [hε, hsval]
        apply congrArg ProjGenLinGroup.mk
        apply Units.ext
        ext i j
        fin_cases i <;> fin_cases j <;>
          simp [Matrix.SU3.standardInvolution_val,
            signGL, UnitaryThree.OddTorusNormalizer.diagonalHom]
      · left
        apply Subtype.ext
        rw [hε]
        change ProjGenLinGroup.mk _ = ProjGenLinGroup.mk 1
        apply ProjGenLinGroup.mk_eq_mk_iff.mpr
        refine ⟨-1, Units.ext ?_⟩
        ext i j
        fin_cases i <;> fin_cases j <;>
          simp [signGL, UnitaryThree.OddTorusNormalizer.diagonalHom,
            GeneralLinearGroup.coe_scalar, Matrix.mul_apply, Fin.sum_univ_three]
    rcases he with rfl | rfl | rfl | rfl
    · exact one_mem _
    · exact hs
    · exact ht
    · exact (closure ({s,t} : Set _)).mul_mem hs ht
  · apply (closure_le _).mpr
    intro x hx
    rcases hx with rfl | rfl
    · exact standardInvolution_mem_standardFour J hJ
    · exact ht

private theorem exists_second_generator {G : Type*} [Group G] [Finite G]
    (V : Subgroup G) [IsElementaryAbelian 2 V] (hV : Nat.card V = 4)
    (s : G) (hs : s ∈ V) (hs2 : orderOf s = 2) :
    ∃ A : G, A ∈ V ∧ orderOf A = 2 ∧ A ≠ s ∧ Commute A s ∧
      closure ({s,A} : Set G) = V := by
  classical
  let := Fintype.ofFinite V
  have hlt : ({1, ⟨s, hs⟩} : Finset V).card < (Finset.univ : Finset V).card := by
    have hh := Finset.card_le_two (a := (1 : V)) (b := ⟨s, hs⟩)
    rw [Finset.card_univ, ← Nat.card_eq_fintype_card, hV]
    omega
  obtain ⟨A, _, hA⟩ := Finset.exists_mem_notMem_of_card_lt_card hlt
  have hA1 : (A : G) ≠ 1 := by
    intro h
    apply hA
    simp [show A = 1 from Subtype.ext h]
  have hAs : (A : G) ≠ s := by
    intro h
    apply hA
    simp [show A = ⟨s,hs⟩ from Subtype.ext h]
  have hA2 : orderOf (A : G) = 2 :=
    orderOf_eq_prime (elemPow_eq_one_of_isElementaryAbelian (A : G) A.property) hA1
  have hcomm : Commute (A : G) s :=
    congrArg Subtype.val (mul_comm' A (⟨s, hs⟩ : V))
  refine ⟨A, A.property, hA2, hAs, hcomm, ?_⟩
  let : IsKleinFour (closure ({s,(A : G)} : Set G)) :=
    isKleinFour_closure_pair_of_orderOf s A hs2 hA2 hAs.symm hcomm.symm
  apply eq_of_le_of_card_ge
  · apply (closure_le _).mpr
    intro x hx
    rcases hx with rfl | rfl
    · exact hs
    · exact A.property
  · rw [hV, IsKleinFour.card_four]

end MarkedFour

variable {F : Type*} [Field F]

/-- A single automorphism places a marked projective four-group in the literal
sign subgroup while fixing its specified involution. -/
theorem markedFourPlacement [Finite F] (J : HermitianForm 3 F) (hJ : J.form = 1)
    {p : ℕ} (hp : p.Prime) (ho : Odd p) (hcard : Nat.card F = p ^ 2)
    (hc : ∀ x, J.conj x = x ^ p) : MarkedFourPlacement J hJ := by
  let : Fact p.Prime := ⟨hp⟩
  let := Fintype.ofFinite F
  let : CharP F p := charP_of_card_eq_prime_pow (by
    simpa only [Nat.card_eq_fintype_card] using hcard)
  have h2 : (2 : F) ≠ 0 := Field.two_ne_zero_of_odd_card F (by rw [hcard]; exact ho.pow)
  have hp2 : p ≠ 2 := fun h => ho.not_two_dvd_nat (h ▸ dvd_rfl)
  intro B hBe hB hs
  let := hBe
  obtain ⟨V, hVe, hV, hvB, hsV, _⟩ := exists_marked_special_four J hJ B hB hs
  let := hVe
  obtain ⟨A, _, hA, hAs, hcomm, hgen⟩ := MarkedFour.exists_second_generator V hV
    (Matrix.SU3.standardInvolution J hJ) hsV (Matrix.SU3.standardInvolution_orderOf J hJ h2)
  obtain ⟨C, hCs, hCA⟩ := MarkedFour.exists_marked_conjugator J hJ hp2 hcard hc A hA hcomm hAs
  refine ⟨J.unitaryConj C, ?_, ?_⟩
  · rw [J.unitaryConj_specialToProjective, hCs]
  · rw [← hvB, ← hgen, Subgroup.map_map, MonoidHom.map_closure,
      Set.image_pair]
    change closure ({J.unitaryConj C (J.specialToProjective (Matrix.SU3.standardInvolution J hJ)),
      J.unitaryConj C (J.specialToProjective A)} : Set _) = _
    rw [J.unitaryConj_specialToProjective, J.unitaryConj_specialToProjective, hCs, hCA,
      MarkedFour.standardFour_eq_closure]

end CFSG.Quasithin.ChapterE.ValuesOdd.PSUThreeGeneration.InnerGeometry.SemidihedralTorus
