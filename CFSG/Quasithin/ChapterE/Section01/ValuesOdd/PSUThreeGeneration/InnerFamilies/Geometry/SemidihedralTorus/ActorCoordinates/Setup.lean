module

public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSUThreeGeneration.InnerFamilies.Geometry.SemidihedralTorus.Coordinates
public import Theory.LinearAlgebra.Hermitian.IdentityGramEquivalence
public import Theory.SpecificGroups.SU3.FourActorInvolutionConjugacy
public import Theory.GroupTheory.CoprimeQuotientSubgroups
public import Theory.GroupTheory.OddCentralInvolutionLifting.Centralizers
public import Theory.SpecificGroups.ProjectiveLinearInvolutions

/-!
# Marked four-groups before simultaneous actor placement

Normalize an arbitrary Hermitian form over its original field, then conjugate
its marked projective involution to diag(-1,-1,1). The odd scalar kernel
also permits lifting a whole elementary four-group, with its marked
involution and its exact centralizer preimage retained.

The standard four-group is defined using the literal projective diagonal
sign matrices. Two remaining model contracts separate the orthonormal
placement of a marked four-group from Sylow conjugacy inside its full
pointwise automorphism fixer. These contracts are not asserted here.

Source: Aschbacher--Smith E.1.14(7), printed p.214, and A.3.21(a)--(b),
printed p.55; Aschbacher (1982), Lemma 4.11. The arbitrary-form normalization
uses the checked finite-field Hermitian orthonormalization theorem.
-/

public section

open Matrix Subgroup BenderSuzuki.MatrixGroups
namespace CFSG.Quasithin.ChapterE.ValuesOdd.PSUThreeGeneration.InnerGeometry.SemidihedralTorus
variable {F : Type*} [Field F]

/-- The subgroup generated by the literal projective diagonal signs. -/
@[expose] def standardFour (J : HermitianForm 3 F) :
    Subgroup (ProjectiveSpecialUnitaryMatrixGroup J) :=
  closure {x | ∃ ε : Fin 3 → Bool, x.val = ProjGenLinGroup.mk (signGL ε)}

theorem standardInvolution_mem_standardFour (J : HermitianForm 3 F)
    (hJ : J.form = 1) :
    J.specialToProjective (Matrix.SU3.standardInvolution J hJ) ∈ standardFour J := by
  apply subset_closure
  refine ⟨![true, true, false], ?_⟩
  rw [J.specialToProjective_apply_val]
  apply congrArg ProjGenLinGroup.mk
  apply Units.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.SU3.standardInvolution_val,
      signGL, UnitaryThree.OddTorusNormalizer.diagonalHom]

theorem projective_standardInvolution_orderOf [Finite F]
    (J : HermitianForm 3 F) (hJ : J.form = 1) (h2 : (2 : F) ≠ 0) :
    orderOf (J.specialToProjective (Matrix.SU3.standardInvolution J hJ)) = 2 := by
  apply orderOf_eq_prime
  · rw [← map_pow, Matrix.SU3.standardInvolution_sq, map_one]
  · intro h
    have hs := OddCentralLifting.kernel_involution_eq_one J.specialToProjective
      J.odd_card_specialToProjective_ker h (Matrix.SU3.standardInvolution_sq J hJ)
    have ho := Matrix.SU3.standardInvolution_orderOf J hJ h2
    rw [hs, orderOf_one] at ho
    contradiction

theorem exists_marked_identityGram_equiv [Finite F]
    {K : Type*} [Group K] (J : HermitianForm 3 F)
    {p : ℕ} (hp : p.Prime) (ho : Odd p)
    (hcard : Nat.card F = p ^ 2) (hc : ∀ x, J.conj x = x ^ p)
    (e₀ : K ≃* ProjectiveSpecialUnitaryMatrixGroup J)
    (z : K) (hz : orderOf z = 2) :
    ∃ e : K ≃* ProjectiveSpecialUnitaryMatrixGroup (HermitianForm.IdentityGram.identityGram J),
      e z = (HermitianForm.IdentityGram.identityGram J).specialToProjective
        (Matrix.SU3.standardInvolution (HermitianForm.IdentityGram.identityGram J) rfl) := by
  let : Fact p.Prime := ⟨hp⟩
  let := Fintype.ofFinite F
  let : CharP F p := charP_of_card_eq_prime_pow (by
    simpa only [Nat.card_eq_fintype_card] using hcard)
  obtain ⟨C, es, ep, hC, hes, hep⟩ :=
    HermitianForm.IdentityGram.exists_identityGram_transport J p hp hcard hc
  let J₁ := HermitianForm.IdentityGram.identityGram J
  let e₁ := e₀.trans ep
  have h2 : (2 : F) ≠ 0 :=
    Field.two_ne_zero_of_odd_card F (by rw [hcard]; exact ho.pow)
  have hp2 : p ≠ 2 := fun h => ho.not_two_dvd_nat (h ▸ dvd_rfl)
  have hz₁ : orderOf (e₁ z) = 2 := by rw [e₁.orderOf_eq, hz]
  have he := Matrix.SU3.projective_involutions_isConj hp2 hcard J₁ rfl hc
    (e₁ z) (J₁.specialToProjective (Matrix.SU3.standardInvolution J₁ rfl)) hz₁
    (projective_standardInvolution_orderOf J₁ rfl h2)
  obtain ⟨c, hc⟩ := isConj_iff.mp he
  exact ⟨e₁.trans (MulAut.conj c), hc⟩

/-- Lift the whole marked four-group, retaining its literal projective image
and its complete centralizer preimage. -/
theorem exists_marked_special_four [Finite F]
    (J : HermitianForm 3 F) (hJ : J.form = 1)
    (B : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J))
    [IsElementaryAbelian 2 B] (hB : Nat.card B = 4)
    (hz : J.specialToProjective (Matrix.SU3.standardInvolution J hJ) ∈ B) :
    ∃ V : Subgroup J.specialSubgroup, IsElementaryAbelian 2 V ∧ Nat.card V = 4 ∧
      V.map J.specialToProjective = B ∧ Matrix.SU3.standardInvolution J hJ ∈ V ∧
      centralizer (V : Set J.specialSubgroup) =
        (centralizer (B : Set (ProjectiveSpecialUnitaryMatrixGroup J))).comap
          J.specialToProjective := by
  obtain ⟨V, hV, hvB, hcard⟩ := exists_elementaryAbelian_map_eq_of_surjective_coprime
    J.specialToProjective J.specialToProjective_surjective
    J.odd_card_specialToProjective_ker.coprime_two_left B
  let := hV
  have hs : Matrix.SU3.standardInvolution J hJ ∈ V := by
    obtain ⟨v, hv, he⟩ := show
      J.specialToProjective (Matrix.SU3.standardInvolution J hJ) ∈ V.map J.specialToProjective
      from hvB.symm ▸ hz
    have heq := OddCentralLifting.involution_lift_unique J.specialToProjective
      J.odd_card_specialToProjective_ker J.specialToProjective_ker_le_center
      (elemPow_eq_one_of_isElementaryAbelian v hv)
      (Matrix.SU3.standardInvolution_sq J hJ) he
    exact heq ▸ hv
  refine ⟨V, hV, hcard.trans hB, hvB, hs, ?_⟩
  ext x
  constructor
  · intro hx b hb
    obtain ⟨v, hv, rfl⟩ := show b ∈ V.map J.specialToProjective from hvB.symm ▸ hb
    simpa only [map_mul] using congrArg J.specialToProjective (hx v hv)
  · intro hx v hv
    exact (OddCentralLifting.centralizes_of_image J.specialToProjective
      J.odd_card_specialToProjective_ker J.specialToProjective_ker_le_center
      (elemPow_eq_one_of_isElementaryAbelian v hv)
      (hx (J.specialToProjective v) (hvB ▸ mem_map_of_mem J.specialToProjective hv)).symm).symm
/-- Placement of a four-group which already contains the marked involution.
This is a matrix theorem still needed by the source assembly. -/
@[expose] def MarkedFourPlacement (J : HermitianForm 3 F) (hJ : J.form = 1) : Prop :=
  ∀ (B : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J)),
    IsElementaryAbelian 2 B → Nat.card B = 4 →
    J.specialToProjective (Matrix.SU3.standardInvolution J hJ) ∈ B →
    ∃ c : MulAut (ProjectiveSpecialUnitaryMatrixGroup J),
      c (J.specialToProjective (Matrix.SU3.standardInvolution J hJ)) =
        J.specialToProjective (Matrix.SU3.standardInvolution J hJ) ∧
      B.map c.toMonoidHom = standardFour J

/-- One conjugator for an entire two-subgroup of the literal pointwise fixer.
The conjugator must preserve all marked signs. -/
@[expose] def StandardFixerCoordinates (J : HermitianForm 3 F) : Prop :=
  ∀ U : Subgroup (MulAut (ProjectiveSpecialUnitaryMatrixGroup J)), IsPGroup 2 U →
    (∀ a ∈ U, ∀ x ∈ standardFour J, a x = x) →
    ∃ c : MulAut (ProjectiveSpecialUnitaryMatrixGroup J),
      (∀ x ∈ standardFour J, c x = x) ∧
      ∀ a ∈ U, HasSignSemilinearForm J (MulAut.congr c a)

end CFSG.Quasithin.ChapterE.ValuesOdd.PSUThreeGeneration.InnerGeometry.SemidihedralTorus
