module

public import CFSG.Quasithin.ClassicalModels
public import Theory.SpecificGroups.SU3.FiveCentralizerRadical.Inner

/-!
# The intrinsic residual centralizer in the PSU₃(5) source model

The actual equivalence in `ClassicalGroup.IsPSU` transports the matrix theorem
for arbitrary nondegenerate Hermitian forms over fields of order 25. The result
bounds the centralizer of the embedded terminal derived subgroup of the full
involution centralizer. No radical or quotient-structure premise is assumed.

This discharges `hinner` in `centralizer_radical_isMulCommutative_of_inner_bound`.
Source: Aschbacher--Smith A.3.21(a), printed p.55, and E.1.14(7), printed p.214,
citing Aschbacher (1982), Lemma 4.11.
-/

public section
open Subgroup BenderSuzuki.MatrixGroups
namespace CFSG.Quasithin.ChapterE.ValuesOdd.PSUThreeGeneration.OuterFamilies.EightActors

/-- The centralizer of the embedded solvable residual of an involution
centralizer in PSU₃(5) lies in the group generated by that involution. -/
theorem inner_residual_centralizer_le_zpowers {H : Type*} [Group H]
    (hmodel : ClassicalGroup.IsPSU H 3 5) (z : H) (hz : orderOf z = 2) :
    let C := centralizer ({z} : Set H)
    centralizer ((solvableResidual C).map C.subtype : Set H) ≤ zpowers z := by
  obtain ⟨F, _, _, J, hcard, hc, ⟨e⟩⟩ := hmodel
  exact Matrix.SU3.FiveCentralizerRadical.residual_centralizer_bound_of_equiv e z
    (Matrix.SU3.FiveCentralizerRadical.residual_centralizer_bound F J hcard hc
      (e z) ((e.orderOf_eq z).trans hz))

end CFSG.Quasithin.ChapterE.ValuesOdd.PSUThreeGeneration.OuterFamilies.EightActors
