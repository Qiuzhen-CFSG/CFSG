module

public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSUThreeGeneration.OuterFamilies.FourActors.CentralizerGeometry.InvertedOddSubgroup.ActorCoordinates.AbelianReselection.Setup
public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSUThreeGeneration.OuterFamilies.FourActors.Reduction
public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSUThreeGeneration.OuterFamilies.ActorGeometry
public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSUThreeGeneration.OuterFamilies.FourActors.CentralizerGeometry.InvertedOddSubgroup.ActorCoordinates.AbelianReselection.CyclicCore.Model
public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSUThreeGeneration.OuterFamilies.FourActors.CentralizerGeometry.InvertedOddSubgroup.ActorCoordinates.AbelianReselection.CyclicCore.Ambient
public import Theory.GroupTheory.CyclicByFourOuterInvolutions

/-!
# The cyclic core in an outer extension of odd-prime PSU₃

The two power actions and four normal forms imply the exact exceptional-pair
dichotomy. The core is the literal cyclic subgroup generated by the rotation;
its index bound is proved by counting the normal forms. This leaf constructs
every field of the published `CyclicCoreData` record from those coordinates.

For primes congruent to one modulo four, the concrete hyperbolic matrix
construction supplies these coordinates in a full automorphism Sylow. Faithful
ambient transport places them in the supplied Sylow and identifies their marked
half-power with the original centralizing inner involution. Combining those
proofs constructs the record with no remaining model or transport premise.
The four-actor application supplies the outer element and the marked involution
directly from the source's positioned actor. Exceptional fusion is separate.

Source: Aschbacher--Smith E.1.14(7), printed p.214, and A.3.21(b), p.55;
Aschbacher (1982), Lemma 4.11.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterE.ValuesOdd.PSUThreeGeneration.OuterFamilies.FourActors.CentralizerGeometry.InvertedOddSubgroup.AbelianReselection
variable {G : Type*} [Group G] [Finite G] {L T : Subgroup G} {z : G}

/-- The cyclic core and its full outer-involution dichotomy follow from the
two concrete generator actions and four normal forms. -/
theorem nonempty_cyclicCoreData_of_coordinates
    (d : CyclicByFourCoordinates L T z) : Nonempty (CyclicCoreData L T z) := by
  refine ⟨{
    core := zpowers d.a
    cyclic := inferInstance
    core_le_inner := zpowers_le.mpr d.a_inner
    core_le_sylow := zpowers_le.mpr d.a_mem
    core_relIndex := d.core_relIndex
    z_mem := ?_
    exceptional := d.c
    exceptional_mem := d.c_mem
    exceptional_not_inner := d.c_outer
    exceptional_sq := d.c_sq
    dichotomy := d.outer_dichotomy }⟩
  simpa only [d.marked] using
    (zpowers d.a).pow_mem (mem_zpowers d.a) (2 ^ (d.n + 2))

/-- Apply the generator calculation through a faithful ambient action,
retaining the literal inner and Sylow images and the marked involution. -/
theorem nonempty_cyclicCoreData_of_faithful_coordinates
    {H : Type*} [Group H] (f : G →* H) (hf : Function.Injective f)
    (d : CyclicByFourCoordinates (L.map f) (T.map f) (f z)) :
    Nonempty (CyclicCoreData L T z) := by
  obtain ⟨d₀⟩ := CyclicByFourCoordinates.of_map f hf d
  exact nonempty_cyclicCoreData_of_coordinates d₀

/-- The actual unitary model supplies a cyclic core of relative index at most
four, containing the prescribed involution, with the full outer-involution
dichotomy. All permitted ambient extensions with an outer Sylow element are
retained; no SQTK or supplement hypothesis is needed. -/
theorem nonempty_cyclicCoreData [IsSimpleGroup (generalizedFitting G)]
    {p : ℕ} (hp : p.Prime) (ho : Odd p) (hmod : p % 4 = 1)
    (hmodel : ClassicalGroup.IsPSU (generalizedFitting G) 3 p)
    (T : Sylow 2 G) (hout : ¬ (T : Subgroup G) ≤ generalizedFitting G)
    {z : G} (hz : orderOf z = 2) (hzL : z ∈ generalizedFitting G) (hzT : z ∈ T)
    (hTz : (T : Subgroup G) ≤ centralizer ({z} : Set G)) :
    Nonempty (CyclicCoreData (generalizedFitting G) (T : Subgroup G) z) := by
  obtain ⟨d⟩ := cyclicByFourCoordinates_of_modelInput
    (cyclicCoreModelInput hp ho hmod) hp ho hmodel T hout hz hzL hzT hTz
  exact nonempty_cyclicCoreData_of_coordinates d

/-- Discharge the cyclic-core witness for the positioned outer four-actor in
the E.1.14(7) reselection argument. Only containment, noncontainment and the
marked involution are used, so actor-cardinality assumptions are unnecessary. -/
theorem nonempty_cyclicCoreData_four_actor [IsSimpleGroup (generalizedFitting G)]
    {p : ℕ} (hp : p.Prime) (ho : Odd p) (hmod : p % 4 = 1)
    (hmodel : ClassicalGroup.IsPSU (generalizedFitting G) 3 p)
    (T : Sylow 2 G) (A : Subgroup G) (hAT : A ≤ (T : Subgroup G))
    (hout : ¬ A ≤ generalizedFitting G)
    {z : G} (hz : orderOf z = 2) (hzL : z ∈ generalizedFitting G) (hzA : z ∈ A)
    (hTz : (T : Subgroup G) ≤ centralizer ({z} : Set G)) :
    Nonempty (CyclicCoreData (generalizedFitting G) (T : Subgroup G) z) :=
  nonempty_cyclicCoreData hp ho hmod hmodel T (fun h => hout (hAT.trans h))
    hz hzL (hAT hzA) hTz

end CFSG.Quasithin.ChapterE.ValuesOdd.PSUThreeGeneration.OuterFamilies.FourActors.CentralizerGeometry.InvertedOddSubgroup.AbelianReselection
