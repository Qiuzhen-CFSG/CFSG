/-!
# Solvability of the literal split monomial subgroup with graph adjoined

The coordinate-axis stabilizer in SL₃(5) has a normal diagonal four-group
with abelian centralizer. Its conjugation action on the three nonidentity
signs therefore has abelian kernel and solvable permutation image.

Each monomial matrix has one nonzero entry in every column; invertibility
makes the support map a permutation. Transposition preserves the punctured
coordinate axes, as does inversion. The literal graph conjugation formula
thus shows that the graph element normalizes the embedded linear subgroup.
The solvable extension theorem is applied inside their join: its quotient
is an image of the cyclic subgroup generated by graph. No ambient normality
of the linear monomial subgroup is asserted.

This proves the solvability premise of
`MonomialWitness.monomial_escape_of_simultaneous_sylow`. The separate
simultaneous Sylow-placement premise remains with the witness assembly.

Source: GLS III, Theorem 6.5.3(b), `refs/KGroup/GLS3/chapter6.tex`, and
Aschbacher--Smith E.1.14(7), printed p.214. The concrete model and matrices
are specified in `FiveSourceAudit/source/README.md`.
-/

public section

open Subgroup
open scoped MatrixGroups Matrix Pointwise IsMulCommutative
namespace CFSG.Quasithin.ChapterE.ValuesOdd.PSLThreeGeneration.ProperExtension.GraphLarge.OuterFamilies.EightActors.FiveSourceAudit
local instance : Fact (Nat.Prime 5) := ⟨by decide⟩

private theorem linear_solvable : Group.IsSolvable (Matrix.SL3.SplitMonomial.linear (ZMod 5)) := by
  obtain ⟨V, hV, hc, hC⟩ := Matrix.SL3.SplitMonomial.linear_normal_four (ZMod 5)
    (by simpa using (show Odd 5 by decide))
  let := hV
  let D := Matrix.SL3.SplitMonomial.LocalCore.threePointStructureOfNormalFour V hc hC
  let : IsMulCommutative D.action.ker := D.kernel_commutative
  let : Group.IsSolvable D.action.ker := Group.isSolvable_of_comm (fun _ _ => mul_comm _ _)
  let : Group.IsSolvable (Equiv.Perm (Fin 4)) := Equiv.Perm.isSolvable_fin_four
  let e : Fin 3 ↪ Fin 4 := ⟨Fin.castSucc, Fin.castSucc_injective 3⟩
  let : Group.IsSolvable (Equiv.Perm (Fin 3)) :=
    Group.isSolvable_of_isSolvable_injective (Equiv.Perm.viaEmbeddingHom_injective e)
  exact Group.isSolvable_of_ker_le_range D.action.ker.subtype D.action (by rw [range_subtype])

open Matrix.SL3.SplitMonomial in
private theorem column_support (g : linear (ZMod 5)) (j : Fin 3) :
    ∃ i, g.val i j ≠ 0 ∧ ∀ r, r ≠ i → g.val r j = 0 := by
  have hstab : g.val • coordinateVectors (ZMod 5) = coordinateVectors (ZMod 5) :=
    MulAction.mem_stabilizer_iff.mp g.property
  have hv : g.val • Pi.single j (1 : ZMod 5) ∈ coordinateVectors (ZMod 5) := by
    rw [← hstab]
    exact Set.smul_mem_smul_set (single_mem_coordinateVectors (ZMod 5) j one_ne_zero)
  simpa only [Matrix.SpecialLinearGroup.smul_def, Matrix.smul_eq_mulVec,
    Matrix.mulVec_single_one, coordinateVectors, Set.mem_ofPred_eq, Matrix.col_apply] using hv

open Matrix.SL3.SplitMonomial in
private theorem column_permutation (g : linear (ZMod 5)) :
    ∃ σ : Equiv.Perm (Fin 3), ∀ j,
      g.val (σ j) j ≠ 0 ∧ ∀ i, i ≠ σ j → g.val i j = 0 := by
  classical
  let p : Fin 3 → Fin 3 := fun j => (column_support g j).choose
  have hp (j r : Fin 3) (h : r ≠ p j) : g.val r j = 0 :=
    (column_support g j).choose_spec.2 r h
  have hs : Function.Surjective p := by
    intro i
    by_contra h
    have hz (j : Fin 3) : g.val i j = 0 := hp j i (fun he => h ⟨j, he.symm⟩)
    have hh := congrArg (fun A : SL(3, ZMod 5) => A i i) (mul_inv_cancel g.val)
    change (g.val.val * (g.val⁻¹).val) i i = (1 : Matrix (Fin 3) (Fin 3) (ZMod 5)) i i at hh
    simp only [Matrix.one_apply_eq, Matrix.mul_apply, hz, zero_mul, Finset.sum_const_zero] at hh
    exact zero_ne_one hh
  exact ⟨Equiv.ofBijective p ⟨Finite.injective_iff_surjective.mpr hs, hs⟩,
    fun j => (column_support g j).choose_spec⟩

open Matrix.SL3.SplitMonomial in
private theorem transpose_preserves (g : linear (ZMod 5)) {v : Fin 3 → ZMod 5}
    (hv : v ∈ coordinateVectors (ZMod 5)) :
    Matrix.SpecialLinearGroup.transpose g.val • v ∈ coordinateVectors (ZMod 5) := by
  classical
  obtain ⟨σ, hσ⟩ := column_permutation g
  obtain ⟨j, hj, hv⟩ := hv
  have he : v = Pi.single j (v j) := by
    ext i
    by_cases hi : i = j
    · simp [hi]
    · simp [hi, hv i hi]
  rw [he]
  have heval (r : Fin 3) :
      (Matrix.SpecialLinearGroup.transpose g.val • (Pi.single j (v j) : Fin 3 → ZMod 5)) r = g.val j r * v j := by
    simp [Matrix.SpecialLinearGroup.smul_def, Matrix.smul_eq_mulVec, Matrix.mulVec_single,
      Matrix.SpecialLinearGroup.coe_transpose]
  refine ⟨σ.symm j, ?_, ?_⟩
  · rw [heval]
    exact mul_ne_zero (by simpa using (hσ (σ.symm j)).1) hj
  · intro r hr
    rw [heval, (hσ r).2 j (by intro h; apply hr; exact (σ.symm_apply_eq.mpr h).symm), zero_mul]

open Matrix.SL3.SplitMonomial in
private theorem transpose_mem_linear (g : SL(3, ZMod 5)) (hg : g ∈ linear (ZMod 5)) :
    Matrix.SpecialLinearGroup.transpose g ∈ linear (ZMod 5) := by
  change Matrix.SpecialLinearGroup.transpose g ∈ MulAction.stabilizer _ (coordinateVectors (ZMod 5))
  rw [MulAction.mem_stabilizer_iff]
  apply Set.Subset.antisymm
  · exact Set.smul_set_subset_iff.mpr (fun _ hv => transpose_preserves ⟨g, hg⟩ hv)
  · rw [Set.subset_smul_set_iff]
    have hi : (Matrix.SpecialLinearGroup.transpose g)⁻¹ = Matrix.SpecialLinearGroup.transpose g⁻¹ :=
      Subtype.ext (Matrix.adjugate_transpose g.val).symm
    rw [hi]
    exact Set.smul_set_subset_iff.mpr
      (fun _ hv => transpose_preserves ⟨g⁻¹, (linear (ZMod 5)).inv_mem hg⟩ hv)

/-- The actual graph element normalizes the embedded coordinate-axis stabilizer. -/
theorem graphElement_normalizes_linear_monomial :
    graphElement ∈ normalizer ((Matrix.SL3.SplitMonomial.linear (ZMod 5)).map innerSL : Set Model) := by
  apply mem_normalizer_fintype
  rintro _ ⟨g, hg, rfl⟩
  rw [graph_innerSL, mul_inv_cancel_right]
  exact ⟨(Matrix.SpecialLinearGroup.transpose g)⁻¹,
    (Matrix.SL3.SplitMonomial.linear (ZMod 5)).inv_mem (transpose_mem_linear g hg), rfl⟩

/-- The literal split monomial subgroup with inverse transpose adjoined is solvable. -/
theorem monomialOvergroup_solvable : Group.IsSolvable monomialOvergroup := by
  let : Group.IsSolvable (Matrix.SL3.SplitMonomial.linear (ZMod 5)) := linear_solvable
  let : Group.IsSolvable ((Matrix.SL3.SplitMonomial.linear (ZMod 5)).map innerSL) :=
    Group.isSolvable_of_surjective (innerSL.subgroupMap_surjective _)
  exact Group.isSolvable_sup_of_normalizes _ _ (zpowers_le.mpr graphElement_normalizes_linear_monomial)
end CFSG.Quasithin.ChapterE.ValuesOdd.PSLThreeGeneration.ProperExtension.GraphLarge.OuterFamilies.EightActors.FiveSourceAudit
