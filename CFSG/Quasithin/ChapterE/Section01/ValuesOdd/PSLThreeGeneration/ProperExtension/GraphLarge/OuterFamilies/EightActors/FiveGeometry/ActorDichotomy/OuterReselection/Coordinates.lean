module

public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSLThreeGeneration.ProperExtension.GraphLarge.OuterFamilies.EightActors.FiveGeometry.ActorDichotomy.Families
import all CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSLThreeGeneration.ProperExtension.GraphLarge.OuterFamilies.EightActors.FiveSourceAudit.MonomialWitness.SylowPlacement
public import Theory.SpecificGroups.PSL3.CartanActions.BorelQuotient
public import Theory.GroupTheory.NormalizingInvolutionCard

/-!
# Explicit coordinates for outer-actor reselection

The literal Sylow is generated by the diagonal torus, the signed swap of the
last two coordinates and inverse transpose. Its order is 64. The second actor
uses the two diagonal signs and `FiveSourceAudit.innerSL diag(2,3,1) * graphElement`.

This is an internal adapter of the existing Sylow construction. The intentional
`import all` reuses its private cardinality and index proofs; the public coordinate
formulas below do not expose private names or change the original boundary.
The concrete checks use small tuples of field elements; no enumeration of the ambient automorphism group is used.

Source: Aschbacher--Smith E.1.1--5, E.1.8, E.1.10 and E.1.14(7),
printed pp.209--214. The matrix and projective carriers retain their ATLAS
attribution and the license in `LICENSES/ATLAS.txt`.
-/

public section
open Subgroup Theory.GroupTheory
open scoped MatrixGroups Matrix Pointwise IsMulCommutative
open Matrix.PSL3.OddPrimeGraphExtension.GraphLargeStructure
open Matrix.PSL3.CartanActions Matrix.PSL3.CartanActions.BorelQuotient
namespace CFSG.Quasithin.ChapterE.ValuesOdd.PSLThreeGeneration.ProperExtension.GraphLarge.OuterFamilies.EightActors.ActorDichotomy.OuterReselection
open FiveSourceAudit PSUThreeGeneration
local instance : Fact (Nat.Prime 5) := ⟨by decide⟩
local instance : IsSimpleGroup PSL(3, ZMod 5) := Atlas.psl_simple_high_rank 3 (by decide)

/-- The full diagonal torus before its faithful embedding. -/
abbrev diagonalSL := (torusSL (ZMod 5)).range

/-- The signed transposition of the last two coordinates. -/
@[expose] def signedSwap : SL(3, ZMod 5) :=
  ⟨!![4,0,0;0,0,4;0,4,0], by decide +kernel⟩

/-- The monomial Sylow in the special linear group. -/
@[expose] noncomputable def linearTwo : Subgroup SL(3, ZMod 5) :=
  diagonalSL ⊔ zpowers signedSwap

/-- Its faithful image in the marked inner subgroup. -/
@[expose] noncomputable def linearTwoInner : Subgroup Model :=
  linearTwo.map FiveSourceAudit.innerSL

/-- The explicit order-64 subgroup, with inverse transpose adjoined. -/
@[expose] noncomputable def standardTwoGroup : Subgroup Model :=
  linearTwoInner ⊔ zpowers graphElement

theorem card_standardTwoGroup : Nat.card standardTwoGroup = 64 :=
  FiveSourceAudit.card_commonTwo

private theorem standardTwoGroup_odd_index : ¬ 2 ∣ standardTwoGroup.index :=
  FiveSourceAudit.commonTwo_odd_index

private theorem graph_sq : graphElement ^ 2 = 1 :=
  Subtype.ext (Matrix.PSL3.OuterSolvable.graph_sq (ZMod 5))

/-- The explicit torus--swap--graph Sylow, as a Sylow of the literal model. -/
noncomputable def standardSylow : Sylow 2 Model :=
  (IsPGroup.of_card (p := 2) (n := 6) card_standardTwoGroup).toSylow
    standardTwoGroup_odd_index

@[simp] theorem standardSylow_coe : (standardSylow : Subgroup Model) = standardTwoGroup := by
  exact IsPGroup.toSylow_coe _ _

/-- The nonsquare determinant twist of the graph generator. -/
@[expose] def twistDiagonal : SL(3, ZMod 5) :=
  ⟨!![2,0,0;0,3,0;0,0,1], by decide +kernel⟩

/-- The central inner involution in these Sylow coordinates. -/
@[expose] noncomputable def centralElement : Model := FiveSourceAudit.innerSL secondDiagonal

/-- An outer involution with the required nonsquare block determinant. -/
@[expose] noncomputable def twistedGraph : Model := FiveSourceAudit.innerSL twistDiagonal * graphElement

/-- The full eight-actor to which the second orbit will be fused. -/
@[expose] noncomputable def representative : Subgroup Model :=
  closure ({FiveSourceAudit.innerSL (Matrix.SL3.standardInvolution (ZMod 5)), centralElement,
    twistedGraph} : Set Model)

private def unitFour : (ZMod 5)ˣ := ⟨4,4,by decide,by decide⟩
private def unitTwo : (ZMod 5)ˣ := ⟨2,3,by decide,by decide⟩

theorem diagonal_mem_standardSylow (d : (ZMod 5)ˣ × (ZMod 5)ˣ) :
    FiveSourceAudit.innerSL (torusSL (ZMod 5) d) ∈ standardSylow :=
  mem_sup_left ⟨_, mem_sup_left ⟨_, rfl⟩, rfl⟩

theorem signedSwap_mem_standardSylow : FiveSourceAudit.innerSL signedSwap ∈ standardSylow :=
  mem_sup_left ⟨_, mem_sup_right (mem_zpowers _), rfl⟩

theorem graph_mem_standardSylow : graphElement ∈ standardSylow :=
  mem_sup_right (mem_zpowers _)

theorem twist_mem_standardSylow : FiveSourceAudit.innerSL twistDiagonal ∈ standardSylow := by
  have he : torusSL (ZMod 5) (unitTwo, 1) = twistDiagonal := by decide +kernel
  exact he ▸ diagonal_mem_standardSylow _

theorem centralElement_mem_standardSylow : centralElement ∈ standardSylow := by
  have he : torusSL (ZMod 5) (1, unitFour) = secondDiagonal := by decide +kernel
  change FiveSourceAudit.innerSL secondDiagonal ∈ standardSylow
  exact he ▸ diagonal_mem_standardSylow _

theorem representative_le_standardSylow : representative ≤ (standardSylow : Subgroup Model) := by
  rw [representative, closure_le]
  intro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl | rfl
  · have he : torusSL (ZMod 5) (unitFour, 1) = Matrix.SL3.standardInvolution (ZMod 5) := by decide +kernel
    exact he ▸ diagonal_mem_standardSylow _
  · exact centralElement_mem_standardSylow
  · exact standardSylow.mul_mem twist_mem_standardSylow graph_mem_standardSylow

private theorem second_sq : secondDiagonal ^ 2 = 1 := by decide +kernel
private theorem second_ne : secondDiagonal ≠ 1 := by decide +kernel

theorem centralElement_orderOf : orderOf centralElement = 2 := by
  rw [centralElement, orderOf_injective _ innerSL_injective]
  exact orderOf_eq_prime second_sq second_ne

theorem centralElement_mem_inner : centralElement ∈ FiveSourceAudit.inner := by
  rw [← innerSL_range]
  exact ⟨secondDiagonal, rfl⟩

private theorem graph_commutes_second : Commute graphElement centralElement := by
  change graphElement * FiveSourceAudit.innerSL secondDiagonal = FiveSourceAudit.innerSL secondDiagonal * graphElement
  rw [graph_innerSL]
  congr 2
  decide +kernel

theorem standardSylow_le_centralizer :
    (standardSylow : Subgroup Model) ≤ centralizer ({centralElement} : Set Model) := by
  change linearTwoInner ⊔ zpowers graphElement ≤ _
  apply sup_le _ (zpowers_le.mpr (mem_centralizer_singleton_iff.mpr graph_commutes_second.eq))
  rw [linearTwoInner, map_le_iff_le_comap, linearTwo]
  apply sup_le
  · rintro _ ⟨d, rfl⟩
    apply mem_centralizer_singleton_iff.mpr
    change FiveSourceAudit.innerSL (torusSL (ZMod 5) d) * FiveSourceAudit.innerSL secondDiagonal = _
    change FiveSourceAudit.innerSL (torusSL (ZMod 5) d) * FiveSourceAudit.innerSL secondDiagonal = FiveSourceAudit.innerSL secondDiagonal * FiveSourceAudit.innerSL (torusSL (ZMod 5) d)
    rw [← map_mul, ← map_mul]
    congr 1
    revert d
    decide +kernel
  · apply zpowers_le.mpr
    apply mem_centralizer_singleton_iff.mpr
    change FiveSourceAudit.innerSL signedSwap * FiveSourceAudit.innerSL secondDiagonal = FiveSourceAudit.innerSL secondDiagonal * FiveSourceAudit.innerSL signedSwap
    rw [← map_mul, ← map_mul]
    congr 1
    decide +kernel

private theorem twistedGraph_sq : twistedGraph ^ 2 = 1 := by
  have he : (Matrix.SpecialLinearGroup.transpose twistDiagonal)⁻¹ = twistDiagonal⁻¹ := by
    decide +kernel
  change (FiveSourceAudit.innerSL twistDiagonal * graphElement) * (FiveSourceAudit.innerSL twistDiagonal * graphElement) = 1
  rw [mul_assoc, ← mul_assoc graphElement, graph_innerSL, he]
  simpa only [← mul_assoc, ← map_mul, mul_inv_cancel, map_one, one_mul, pow_two] using graph_sq

private theorem twistedGraph_out : twistedGraph ∉ FiveSourceAudit.inner := by
  intro h
  apply graphElement_not_mem_inner
  have hd : FiveSourceAudit.innerSL twistDiagonal ∈ FiveSourceAudit.inner := by
    rw [← innerSL_range]
    exact ⟨_, rfl⟩
  simpa [twistedGraph] using FiveSourceAudit.inner.mul_mem (FiveSourceAudit.inner.inv_mem hd) h

private theorem twistedGraph_commutes_sign (d : SL(3, ZMod 5))
    (hg : (Matrix.SpecialLinearGroup.transpose d)⁻¹ = d)
    (hd : Commute twistDiagonal d) : Commute twistedGraph (FiveSourceAudit.innerSL d) := by
  change (FiveSourceAudit.innerSL twistDiagonal * graphElement) * FiveSourceAudit.innerSL d = FiveSourceAudit.innerSL d * (FiveSourceAudit.innerSL twistDiagonal * graphElement)
  rw [mul_assoc, graph_innerSL, hg, ← mul_assoc, ← map_mul, hd.eq, map_mul, mul_assoc]

instance representative_elementary : IsElementaryAbelian 2 representative := by
  have h1 := Matrix.SL3.standardInvolution_sq (ZMod 5)
  have hc : Commute (FiveSourceAudit.innerSL (Matrix.SL3.standardInvolution (ZMod 5))) centralElement :=
    (show Commute (Matrix.SL3.standardInvolution (ZMod 5)) secondDiagonal from by
      change Matrix.SL3.standardInvolution (ZMod 5) * secondDiagonal = secondDiagonal * Matrix.SL3.standardInvolution (ZMod 5)
      decide +kernel).map FiveSourceAudit.innerSL
  have hc1 := (twistedGraph_commutes_sign (Matrix.SL3.standardInvolution (ZMod 5))
    (by decide +kernel) (by unfold Commute SemiconjBy; decide +kernel)).eq
  have hc2 := (twistedGraph_commutes_sign secondDiagonal
    (by decide +kernel) (by unfold Commute SemiconjBy; decide +kernel)).eq
  let : IsMulCommutative (closure ({FiveSourceAudit.innerSL (Matrix.SL3.standardInvolution (ZMod 5)), centralElement, twistedGraph} : Set Model)) := isMulCommutative_closure (by
    intro x hx y hy
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx hy
    rcases hx with rfl | rfl | rfl <;> rcases hy with rfl | rfl | rfl
    all_goals first | rfl | exact hc.eq | exact hc.symm.eq | exact hc1 | exact hc1.symm | exact hc2 | exact hc2.symm)
  apply IsElementaryAbelian.closure_of_isMulCommutative
  intro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl | rfl
  · rw [← map_pow, h1, map_one]
  · change FiveSourceAudit.innerSL secondDiagonal ^ 2 = 1
    rw [← map_pow, second_sq, map_one]
  · exact twistedGraph_sq

private def signHom : Multiplicative (ZMod 2 × ZMod 2) →* SL(3, ZMod 5) where
  toFun x := Matrix.SL3.standardInvolution (ZMod 5) ^ x.toAdd.1.val * secondDiagonal ^ x.toAdd.2.val
  map_one' := by decide +kernel
  map_mul' := by decide +kernel
private theorem signHom_injective : Function.Injective signHom := by decide +kernel
private noncomputable def signFour : Subgroup Model := signHom.range.map FiveSourceAudit.innerSL
private theorem signFour_le_representative : signFour ≤ representative := by
  rintro _ ⟨_, ⟨a, rfl⟩, rfl⟩
  change FiveSourceAudit.innerSL (Matrix.SL3.standardInvolution (ZMod 5) ^ a.toAdd.1.val * secondDiagonal ^ a.toAdd.2.val) ∈ _
  rw [map_mul, map_pow, map_pow]
  exact representative.mul_mem
    (representative.pow_mem (subset_closure (by simp)) _)
    (representative.pow_mem (subset_closure (by simp [centralElement])) _)
private theorem signFour_le_inner : signFour ≤ FiveSourceAudit.inner := by
  rw [← innerSL_range]
  exact map_le_range _ _
private theorem representative_eq : representative = signFour ⊔ zpowers twistedGraph := by
  apply le_antisymm
  · rw [representative, closure_le]
    intro x hx
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl
    · exact mem_sup_left ⟨_, ⟨Multiplicative.ofAdd (1,0), rfl⟩, congrArg FiveSourceAudit.innerSL (by decide +kernel)⟩
    · exact mem_sup_left ⟨_, ⟨Multiplicative.ofAdd (0,1), rfl⟩, congrArg FiveSourceAudit.innerSL (by decide +kernel)⟩
    · exact mem_sup_right (mem_zpowers _)
  · exact sup_le signFour_le_representative (zpowers_le.mpr (subset_closure (by simp)))

theorem card_representative : Nat.card representative = 8 := by
  have hn : twistedGraph ∈ normalizer (signFour : Set Model) := by
    apply Subgroup.centralizer_le_normalizer
    intro x hx
    exact congrArg Subtype.val (mul_comm (⟨x, signFour_le_representative hx⟩ : representative)
      ⟨twistedGraph, subset_closure (by simp)⟩)
  rw [representative_eq, card_sup_zpowers_of_normalizing_involution _ _ twistedGraph_sq
    (fun h => twistedGraph_out (signFour_le_inner h)) hn,
    signFour, card_map_of_injective innerSL_injective,
    ← Nat.card_congr (MonoidHom.ofInjective signHom_injective).toEquiv]
  change 2 * Nat.card (ZMod 2 × ZMod 2) = 8
  simp


private theorem matrix_central_involution_unique (x : SL(3, ZMod 5))
    (hd : Commute x twistDiagonal) (hw : Commute x signedSwap)
    (hx : x ^ 2 = 1) (hne : x ≠ 1) : x = secondDiagonal := by
  have ht : twistDiagonal.val = Matrix.diagonal ![2,3,1] := by decide +kernel
  have he (i j : Fin 3) : x.val i j * ![2,3,1] j = ![2,3,1] i * x.val i j := by
    have h := congrArg (fun a : SL(3, ZMod 5) => a.val i j) hd.eq
    simpa only [Matrix.SpecialLinearGroup.coe_mul, ht,
      Matrix.mul_diagonal, Matrix.diagonal_mul] using h
  have distinct : ∀ (i j : Fin 3), i ≠ j → ∀ a : ZMod 5,
      a * ![2,3,1] j = ![2,3,1] i * a → a = 0 := by decide +kernel
  have hz (i j : Fin 3) (hij : i ≠ j) : x.val i j = 0 :=
    distinct i j hij _ (he i j)
  have hdiag : x.val = Matrix.diagonal ![x.val 0 0, x.val 1 1, x.val 2 2] := by
    ext i j
    fin_cases i <;> fin_cases j <;> simp [Matrix.diagonal, hz]
  have hdet : Matrix.det (Matrix.diagonal ![x.val 0 0, x.val 1 1, x.val 2 2]) = 1 :=
    hdiag ▸ x.property
  have hsq : (Matrix.diagonal ![x.val 0 0, x.val 1 1, x.val 2 2]) ^ 2 = 1 := by
    have h := congrArg (fun a : SL(3, ZMod 5) => a.val) hx
    change x.val ^ 2 = 1 at h
    rwa [hdiag] at h
  have hn : Matrix.diagonal ![x.val 0 0, x.val 1 1, x.val 2 2] ≠ 1 := by
    intro h
    exact hne (Subtype.ext (hdiag.trans h))
  have hw' := congrArg (fun a : SL(3, ZMod 5) => a.val) hw.eq
  change x.val * signedSwap.val = signedSwap.val * x.val at hw'
  rw [hdiag] at hw'
  have finite_check : ∀ a b c : ZMod 5,
      Matrix.det (Matrix.diagonal ![a,b,c]) = 1 →
      (Matrix.diagonal ![a,b,c]) ^ 2 = 1 → Matrix.diagonal ![a,b,c] ≠ 1 →
      Matrix.diagonal ![a,b,c] * signedSwap.val = signedSwap.val * Matrix.diagonal ![a,b,c] →
      Matrix.diagonal ![a,b,c] = secondDiagonal.val := by decide +kernel
  exact Subtype.ext (hdiag.trans (finite_check _ _ _ hdet hsq hn hw'))

/-- Any inner involution centralized by the explicit Sylow is its indicated
central sign. No actor enumeration or radical calculation is needed. -/
theorem centralElement_unique (z : Model) (hz : orderOf z = 2)
    (hi : z ∈ FiveSourceAudit.inner)
    (hT : (standardSylow : Subgroup Model) ≤ centralizer ({z} : Set Model)) :
    z = centralElement := by
  rw [← innerSL_range] at hi
  obtain ⟨x, rfl⟩ := hi
  have hd : Commute x twistDiagonal := by
    apply Commute.symm
    apply innerSL_injective
    simpa only [map_mul] using mem_centralizer_singleton_iff.mp (hT twist_mem_standardSylow)
  have hw : Commute x signedSwap := by
    apply Commute.symm
    apply innerSL_injective
    simpa only [map_mul] using mem_centralizer_singleton_iff.mp (hT signedSwap_mem_standardSylow)
  have hs : x ^ 2 = 1 := innerSL_injective (by
    rw [map_pow, map_one, ← hz, pow_orderOf_eq_one])
  have hn : x ≠ 1 := by
    intro he
    simp [he] at hz
  exact congrArg FiveSourceAudit.innerSL (matrix_central_involution_unique x hd hw hs hn)

/-- The finite fusion calculation only concerns elementary eights in the
explicit order-64 Sylow, and retains an actual ambient conjugator. -/
@[expose] def StandardFusion : Prop :=
  ∀ A : Subgroup Model, IsElementaryAbelian 2 A → A ≤ (standardSylow : Subgroup Model) →
    Nat.card A = 8 → A ∈ family ∨ ∃ g : Model,
      A.map (MulAut.conj g).toMonoidHom = representative

/-- The remaining quotient calculation concerns this one literal actor and
this one literal residual supplement. The S₅ model is an allowed premise. -/
@[expose] def StandardPosition : Prop :=
  (let K := centralizerResidualOvergroup standardSylow centralElement;
    Nonempty ((K ⧸ solvableRadical K) ≃* Equiv.Perm (Fin 5))) →
  QuotientActor (centralizerResidualOvergroup standardSylow centralElement) representative


end CFSG.Quasithin.ChapterE.ValuesOdd.PSLThreeGeneration.ProperExtension.GraphLarge.OuterFamilies.EightActors.ActorDichotomy.OuterReselection
