variable {F : Type*} [Field F]

private theorem diagonal_involution (y : SL(3,F)) (hy : y ^ 2 = 1)
    (hd : y.val = Matrix.diagonal (fun i => y.val i i)) (h2 : (2 : F) ≠ 0) :
    y = 1 ∨ ∃ k : Fin 3, y = signSL k := by
  have he (i : Fin 3) : y.val i i ^ 2 = 1 := by
    have hm : y.val * y.val = 1 := congrArg Subtype.val
      (show y * y = 1 by simpa only [pow_two] using hy)
    rw [hd, Matrix.diagonal_mul_diagonal] at hm
    have h := congrArg (fun M : Matrix (Fin 3) (Fin 3) F => M i i) hm
    simpa [pow_two] using h
  have hdet := y.property
  rw [hd, Matrix.det_diagonal, Fin.prod_univ_three] at hdet
  have hnot : (-1 : F) ≠ 1 := by intro h; apply h2; linear_combination -h
  rcases sq_eq_one_iff.mp (he 0) with h0 | h0 <;>
    rcases sq_eq_one_iff.mp (he 1) with h1 | h1 <;>
    rcases sq_eq_one_iff.mp (he 2) with h3 | h3 <;>
    simp only [h0, h1, h3, mul_one, mul_neg, neg_neg] at hdet
  all_goals try exact (hnot hdet).elim
  · left
    apply Subtype.ext
    rw [hd]
    ext i j
    fin_cases i <;> fin_cases j <;> simp [h0, h1, h3]
  · right
    refine ⟨0, ?_⟩
    apply Subtype.ext
    rw [hd]
    ext i j
    fin_cases i <;> fin_cases j <;> simp [signSL, h0, h1, h3]
  · right
    refine ⟨1, ?_⟩
    apply Subtype.ext
    rw [hd]
    ext i j
    fin_cases i <;> fin_cases j <;> simp [signSL, h0, h1, h3]
  · right
    refine ⟨2, ?_⟩
    apply Subtype.ext
    rw [hd]
    ext i j
    fin_cases i <;> fin_cases j <;> simp [signSL, h0, h1, h3]

private theorem sign_two : signSL (F := F) 2 = SL3.standardInvolution F := by
  apply Subtype.ext
  ext i j
  fin_cases i <;> fin_cases j <;> simp [signSL, SL3.standardInvolution]

private theorem coordinateFour_sup (k : Fin 3) (hk : k ≠ 2) :
    coordinateFour F = zpowers (standardInner F) ⊔ zpowers (innerSL F (signSL k)) := by
  have h01 : SL3.standardInvolution F * signSL 0 = signSL (F := F) 1 := by
    apply Subtype.ext
    change (SL3.standardInvolution F).val * (signSL _).val = (signSL _).val
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [signSL, SL3.standardInvolution, Matrix.mul_apply, Fin.sum_univ_three]
  have h10 : SL3.standardInvolution F * signSL 1 = signSL (F := F) 0 := by
    apply Subtype.ext
    change (SL3.standardInvolution F).val * (signSL _).val = (signSL _).val
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [signSL, SL3.standardInvolution, Matrix.mul_apply, Fin.sum_univ_three]
  have hzmem : standardInner F ∈ coordinateFour F := by
    change innerSL F (SL3.standardInvolution F) ∈ coordinateFour F
    rw [← sign_two (F := F)]
    exact subset_closure ⟨2, rfl⟩
  have hkmem : innerSL F (signSL k) ∈ coordinateFour F := subset_closure ⟨k, rfl⟩
  apply le_antisymm
  · apply (Subgroup.closure_le _).mpr
    rintro x ⟨j, rfl⟩
    have hz : standardInner F ∈ zpowers (standardInner F) ⊔ zpowers (innerSL F (signSL k)) :=
      mem_sup_left (mem_zpowers _)
    have hw : innerSL F (signSL k) ∈ zpowers (standardInner F) ⊔ zpowers (innerSL F (signSL k)) :=
      mem_sup_right (mem_zpowers _)
    have hzw := mul_mem hz hw
    change innerSL F (SL3.standardInvolution F) * innerSL F (signSL k) ∈ _ at hzw
    rw [← map_mul] at hzw
    fin_cases k
    · fin_cases j
      · exact hw
      · change innerSL F (signSL 1) ∈ _
        rw [← h01]
        exact hzw
      · change innerSL F (signSL 2) ∈ _
        rw [sign_two]
        exact hz
    · fin_cases j
      · change innerSL F (signSL 0) ∈ _
        rw [← h10]
        exact hzw
      · exact hw
      · change innerSL F (signSL 2) ∈ _
        rw [sign_two]
        exact hz
    · exact (hk rfl).elim
  · exact sup_le (zpowers_le.mpr hzmem) (zpowers_le.mpr hkmem)

private theorem four_generators {G : Type*} [Group G] [Finite G]
    (A : Subgroup G) (hA : Nat.card A = 4) (z : G) (hz : orderOf z = 2) (hzA : z ∈ A) :
    ∃ y ∈ A, y ∉ zpowers z ∧ A = zpowers z ⊔ zpowers y := by
  obtain ⟨y, hyA, hy⟩ : ∃ y ∈ A, y ∉ zpowers z := by
    by_contra h
    push Not at h
    have hc := Subgroup.card_le_of_le h
    rw [hA, Nat.card_zpowers, hz] at hc
    omega
  refine ⟨y, hyA, hy, ?_⟩
  let H := zpowers z ⊔ zpowers y
  have hHA : H ≤ A := sup_le (zpowers_le.mpr hzA) (zpowers_le.mpr hyA)
  have hH2 : 2 < Nat.card H := by
    by_contra h
    have he : zpowers z = H := eq_of_le_of_card_ge le_sup_left (by
      rw [Nat.card_zpowers, hz]
      omega)
    apply hy
    rw [he]
    exact mem_sup_right (mem_zpowers _)
  have hH4 := Subgroup.card_le_of_le hHA
  have hdiv := Subgroup.card_dvd_of_le hHA
  rw [hA] at hH4 hdiv
  have hn : Nat.card H = 3 ∨ Nat.card H = 4 := by omega
  have hH : Nat.card H = 4 := by
    rcases hn with h | h
    · norm_num [h] at hdiv
    · exact h
  exact (eq_of_le_of_card_ge hHA (by omega)).symm

variable [Finite F] [IsSimpleGroup PSL(3,F)]
private theorem inner_lift (y : graphExtension F) (hy : orderOf y = 2)
    (hyI : y ∈ innerPart F) :
    ∃ v : SL(3,F), orderOf v = 2 ∧ innerSL F v = y := by
  let w : innerPart F := ⟨y, hyI⟩
  let a := (innerPartEquiv F).symm w
  have ha : orderOf a = 2 := by
    rw [MulEquiv.orderOf_eq, ← orderOf_submonoid]
    exact hy
  obtain ⟨v, hv, hproj⟩ := Matrix.PSL3.OddInvolutionFixed.involution_lift a ha
  refine ⟨v, hv, ?_⟩
  apply Subtype.ext
  change MulAut.conj (Matrix.PSL3.projection F v) = y.val
  rw [hproj]
  exact innerPartEquiv_symm_conj F w

omit [Finite F] in
private theorem projection_eq_of_innerSL_eq {x y : SL(3,F)}
    (h : innerSL F x = innerSL F y) : Matrix.PSL3.projection F x = Matrix.PSL3.projection F y := by
  apply (innerPartEquiv F).injective
  apply Subtype.ext
  apply Subtype.ext
  rw [innerPartEquiv_apply_coe, innerPartEquiv_apply_coe]
  exact congrArg Subtype.val h

variable (F)

/-- Simultaneous coordinates for an arbitrary inner four-group, retaining its
specified involution and the literal inverse-conjugation map. -/
theorem fourGroupCoordinates_of_char_ne_two (h2 : (2 : F) ≠ 0) : FourGroupCoordinates F := by
  intro A hAe hAc hAI z hz hzA
  let := hAe
  obtain ⟨y, hyA, hy, hgen⟩ := four_generators A hAc z hz hzA
  have hy1 : y ≠ 1 := fun he => hy (he ▸ one_mem _)
  have hyz : y ≠ z := fun he => hy (he ▸ mem_zpowers _)
  have hy2 : orderOf y = 2 := orderOf_eq_prime
    (elemPow_eq_one_of_isElementaryAbelian y hyA) hy1
  obtain ⟨u, hu, huz⟩ := inner_lift z hz (hAI hzA)
  obtain ⟨v, hv, hvy⟩ := inner_lift y hy2 (hAI hyA)
  have hcomm : v * u = u * v := by
    apply Matrix.PSL3.OddInvolutionFixed.commutes_of_projective_commutes u v
      (hu ▸ pow_orderOf_eq_one u)
    rw [← map_mul, ← map_mul]
    apply projection_eq_of_innerSL_eq
    rw [map_mul, map_mul, huz, hvy]
    exact congrArg Subtype.val (mul_comm (⟨y, hyA⟩ : A) ⟨z, hzA⟩)
  obtain ⟨r, hr⟩ := SL3.exists_standardInvolution_conjugator F u hu h2
  let w := r⁻¹ * v * r
  have hw2 : w ^ 2 = 1 := by
    have hh := congrArg (MulAut.conj r⁻¹) (hv ▸ pow_orderOf_eq_one v)
    simpa only [map_pow, map_one, MulAut.conj_apply, inv_inv] using hh
  have hwc : w * SL3.standardInvolution F = SL3.standardInvolution F * w := by
    have hu' : r⁻¹ * u * r = SL3.standardInvolution F := by rw [← hr]; group
    rw [← hu']
    dsimp [w]
    calc
      _ = r⁻¹ * (v * u) * r := by group
      _ = r⁻¹ * (u * v) * r := by rw [hcomm]
      _ = _ := by group
  obtain ⟨t, ht, hdt⟩ := block_diagonalizer w hw2 hwc h2
  let s := r * t
  have hs : s * SL3.standardInvolution F * s⁻¹ = u := by
    dsimp [s]
    calc
      _ = r * (t * SL3.standardInvolution F * t⁻¹) * r⁻¹ := by group
      _ = u := by rw [ht, hr]
  have hdiag : (s⁻¹ * v * s).val = Matrix.diagonal (fun i => (s⁻¹ * v * s).val i i) := by
    have he : s⁻¹ * v * s = t⁻¹ * w * t := by dsimp [s, w]; group
    simpa only [he] using hdt
  have hs2 : (s⁻¹ * v * s) ^ 2 = 1 := by
    have hh := congrArg (MulAut.conj s⁻¹) (hv ▸ pow_orderOf_eq_one v)
    simpa only [map_pow, map_one, MulAut.conj_apply, inv_inv] using hh
  obtain he | ⟨k, hk⟩ := diagonal_involution (s⁻¹ * v * s) hs2 hdiag h2
  · exfalso
    apply hy1
    have he' : v = 1 := by
      have hh := congrArg (MulAut.conj s) he
      simpa [MulAut.conj_apply, mul_assoc] using hh
    rw [← hvy, he', map_one]
  have hk2 : k ≠ 2 := by
    intro hk2
    apply hyz
    rw [hk2, sign_two] at hk
    have hvu : v = u := by
      rw [← hs, ← hk]
      group
    rw [← hvy, ← huz, hvu]
  refine ⟨s, ?_, ?_⟩
  · change innerSL F s * innerSL F (SL3.standardInvolution F) * (innerSL F s)⁻¹ = z
    rw [← map_inv, ← map_mul, ← map_mul, hs, huz]
  · let e := MulAut.conj (innerSL F s)⁻¹
    have hez : e z = standardInner F := by
      rw [← huz]
      change (innerSL F s)⁻¹ * innerSL F u * ((innerSL F s)⁻¹)⁻¹ = _
      rw [inv_inv, ← map_inv, ← map_mul, ← map_mul]
      have hh : s⁻¹ * u * s = SL3.standardInvolution F := by rw [← hs]; group
      rw [hh]
      rfl
    have hey : e y = innerSL F (signSL k) := by
      rw [← hvy]
      change (innerSL F s)⁻¹ * innerSL F v * ((innerSL F s)⁻¹)⁻¹ = _
      rw [inv_inv, ← map_inv, ← map_mul, ← map_mul, hk]
    change A.map e.toMonoidHom = _
    rw [hgen, Subgroup.map_sup, MonoidHom.map_zpowers, MonoidHom.map_zpowers]
    exact (congrArg₂ (· ⊔ ·) (congrArg zpowers hez) (congrArg zpowers hey)).trans
      (coordinateFour_sup k hk2).symm

/-- The simultaneous coordinates apply over every finite field of odd order. -/
theorem fourGroupCoordinates_of_odd_card (hodd : Odd (Nat.card F)) : FourGroupCoordinates F := by
  apply fourGroupCoordinates_of_char_ne_two F
  let := Fintype.ofFinite F
  intro hz
  have hc : ringChar F = 2 := CharP.ringChar_of_prime_eq_zero Nat.prime_two hz
  have he := FiniteField.even_card_iff_char_two.mp hc
  rw [← Nat.card_eq_fintype_card] at he
  have ho := Nat.odd_iff.mp hodd
  omega

/-- The four-group coordinate input is discharged in the actual odd-torus construction. -/
theorem fourGroupOddMixing_of_diagonalTwoControl {p : ℕ}
    (hp : p.Prime) (hbig : 3 < p) (hF : Nat.card F = p) (hp4 : p % 4 = 3)
    (hcontrol : DiagonalTwoControl F) : FourGroupOddMixing F := by
  apply fourGroupOddMixing_of_inputs F hp hbig hF hp4 _ hcontrol
  apply fourGroupCoordinates_of_odd_card F
  rw [hF, Nat.odd_iff]
  omega
end CFSG.Quasithin.ChapterE.ValuesOdd.PSLThreeGeneration.ProperExtension.GraphLarge.InnerGenerationGeometry.OddTorus

end
