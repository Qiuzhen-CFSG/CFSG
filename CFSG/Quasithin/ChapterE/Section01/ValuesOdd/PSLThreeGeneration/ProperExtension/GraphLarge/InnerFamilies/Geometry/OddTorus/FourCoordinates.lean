variable {F : Type*} [Field F]

private theorem involution_compl {V : Type*} [AddCommGroup V] [Module F V]
    (f : Module.End F V) (hf : Function.Involutive f) (h2 : (2 : F) ≠ 0) :
    IsCompl (f.eigenspace (-1)) (f.eigenspace 1) := by
  constructor
  · rw [Submodule.disjoint_def]
    intro x hx hy
    have hx := Module.End.mem_eigenspace_iff.mp hx
    have hy := Module.End.mem_eigenspace_iff.mp hy
    have hz : (2 : F) • x = 0 := by
      have he : -x = x := by simpa using hx.symm.trans hy
      rw [two_smul]
      exact neg_eq_iff_add_eq_zero.mp he
    exact (smul_eq_zero.mp hz).resolve_left h2
  · rw [codisjoint_iff, eq_top_iff]
    intro x _
    apply Submodule.mem_sup.mpr
    refine ⟨(2 : F)⁻¹ • (x - f x), ?_, (2 : F)⁻¹ • (x + f x), ?_, ?_⟩
    · rw [Module.End.mem_eigenspace_iff]
      simp only [map_smul, map_sub, hf x, neg_one_smul, ← smul_neg, neg_sub]
    · rw [Module.End.mem_eigenspace_iff]
      simp only [map_smul, map_add, hf x, one_smul, add_comm]
    · rw [← smul_add]
      have he : (x - f x) + (x + f x) = (2 : F) • x := by rw [two_smul]; abel
      rw [he, smul_smul, inv_mul_cancel₀ h2, one_smul]

private theorem involution_basis (B : GL (Fin 2) F) (hB : B ^ 2 = 1)
    (h2 : (2 : F) ≠ 0) :
    ∃ b : Basis (Fin 2) F (Fin 2 → F), ∃ d : Fin 2 → F,
      ∀ i, B.val *ᵥ b i = d i • b i := by
  let f : Module.End F (Fin 2 → F) := Matrix.toLin' B.val
  have hf : Function.Involutive f := by
    intro x
    change B.val *ᵥ (B.val *ᵥ x) = x
    rw [Matrix.mulVec_mulVec, ← Units.val_mul]
    have he : B * B = 1 := by simpa [pow_two] using hB
    rw [he]
    exact Matrix.one_mulVec x
  let N := f.eigenspace (-1)
  let P := f.eigenspace 1
  have hc : IsCompl N P := involution_compl f hf h2
  have hd : finrank F N + finrank F P = 2 := by
    simpa using Submodule.finrank_add_eq_of_isCompl hc
  let bn := Module.finBasis F N
  let bp := Module.finBasis F P
  let e := Submodule.prodEquivOfIsCompl N P hc
  let b0 := (bn.prod bp).map e
  let b := b0.reindex (finSumFinEquiv.trans (finCongr hd))
  have hb (i : Fin 2) : ∃ a : F, f (b i) = a • b i := by
    dsimp [b]
    rw [Basis.reindex_apply]
    generalize (finSumFinEquiv.trans (finCongr hd)).symm i = j
    cases j with
    | inl k =>
      refine ⟨-1, ?_⟩
      simpa [b0, e] using Module.End.mem_eigenspace_iff.mp (bn k).property
    | inr k =>
      refine ⟨1, ?_⟩
      simpa [b0, e] using Module.End.mem_eigenspace_iff.mp (bp k).property
  choose d hd using hb
  exact ⟨b, d, hd⟩

private theorem involution_diagonalizer (B : GL (Fin 2) F) (hB : B ^ 2 = 1)
    (h2 : (2 : F) ≠ 0) :
    ∃ P : GL (Fin 2) F, ∃ d : Fin 2 → F,
      (P⁻¹ * B * P).val = Matrix.diagonal d := by
  classical
  obtain ⟨b, d, hd⟩ := involution_basis B hB h2
  let s := Pi.basisFun F (Fin 2)
  let P : GL (Fin 2) F :=
    ⟨s.toMatrix b, b.toMatrix s,
      s.toMatrix_mul_toMatrix_flip b, b.toMatrix_mul_toMatrix_flip s⟩
  refine ⟨P, d, ?_⟩
  have hm : LinearMap.toMatrix b b (Matrix.toLin' B.val) = Matrix.diagonal d := by
    ext i j
    by_cases hij : i = j <;> simp [LinearMap.toMatrix_apply, Matrix.toLin'_apply, hd, hij]
  change b.toMatrix s * B.val * s.toMatrix b = Matrix.diagonal d
  rw [← hm]
  have he := basis_toMatrix_mul_linearMap_toMatrix_mul_basis_toMatrix b s b s
    (Matrix.toLin' B.val)
  simpa [s, LinearMap.toMatrix_eq_toMatrix'] using he

private theorem block_diagonalizer (y : SL(3,F)) (hy : y ^ 2 = 1)
    (hc : y * SL3.standardInvolution F = SL3.standardInvolution F * y)
    (h2 : (2 : F) ≠ 0) :
    ∃ t : SL(3,F),
      t * SL3.standardInvolution F * t⁻¹ = SL3.standardInvolution F ∧
      (t⁻¹ * y * t).val = Matrix.diagonal (fun i => (t⁻¹ * y * t).val i i) := by
  have hymem : y ∈ Subgroup.centralizer ({SL3.standardInvolution F} : Set SL(3,F)) :=
    Subgroup.mem_centralizer_singleton_iff.mpr hc
  rw [← SL3.blockEmbedding_range F h2] at hymem
  obtain ⟨B, rfl⟩ := hymem
  have hB : B ^ 2 = 1 := by
    apply SL3.blockEmbedding_injective F
    simpa only [map_pow, map_one] using hy
  obtain ⟨P, d, hd⟩ := involution_diagonalizer B hB h2
  refine ⟨SL3.blockEmbedding F P, ?_, ?_⟩
  · have hm : SL3.blockEmbedding F P * SL3.standardInvolution F =
        SL3.standardInvolution F * SL3.blockEmbedding F P := by
      apply Subgroup.mem_centralizer_singleton_iff.mp
      rw [← SL3.blockEmbedding_range F h2]
      exact ⟨P, rfl⟩
    rw [hm, mul_assoc, mul_inv_cancel, mul_one]
  · rw [← map_inv, ← map_mul, ← map_mul]
    change SL3.blockMatrix F (P⁻¹ * B * P) =
      Matrix.diagonal (fun i => SL3.blockMatrix F (P⁻¹ * B * P) i i)
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [SL3.blockMatrix, show (P⁻¹ * B * P).val = _ from hd]
end CFSG.Quasithin.ChapterE.ValuesOdd.PSLThreeGeneration.ProperExtension.GraphLarge.InnerGenerationGeometry.OddTorus

