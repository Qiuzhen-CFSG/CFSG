module

public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSLThreeGeneration.ProperExtension.GraphLarge.InnerFamilies.Geometry.Reduction
public import Theory.SpecificGroups.PSL3.OuterSolvable.OddPrimeCoverage.RootOrientation.Signs

/-!
# Coordinate inputs for the controlled odd torus

The first input simultaneously diagonalizes the original inner four-group,
retaining the specified involution and an actual determinant-one conjugator.
The second controls a two-subgroup centralizing the coordinate four-group:
its inner elements have diagonal ratio ±1, and its outer elements have one
common diagonal ratio up to sign. Neither input asserts torus normalization,
odd-subgroup existence, commutator membership, or generation.

These are the two remaining geometric inputs to the odd-torus construction
for Aschbacher--Smith E.1.14(7), printed p.214, via E.1.2 and E.1.5,
printed pp.209--210, and Aschbacher (1982), Lemma 4.11.
-/

public section
open Subgroup Matrix Theory.GroupTheory
open scoped MatrixGroups
open Matrix.PSL3.OddPrimeGraphExtension
open Matrix.PSL3.OddPrimeGraphExtension.GraphLargeStructure

namespace CFSG.Quasithin.ChapterE.ValuesOdd.PSLThreeGeneration.ProperExtension.GraphLarge.InnerGenerationGeometry.OddTorus
variable (F : Type*) [Field F]

/-- The subgroup generated by the three actual coordinate sign involutions. -/
@[expose] def coordinateFour : Subgroup (graphExtension F) :=
  closure (Set.range (fun k : Fin 3 =>
    innerSL F (Matrix.PSL3.OuterSolvable.OddPrimeCoverage.signSL k)))

/-- Simultaneous coordinates for the original four-group, with the chosen
involution aligned with `standardInner`. -/
@[expose] def FourGroupCoordinates : Prop :=
  ∀ A : Subgroup (graphExtension F),
    IsElementaryAbelian 2 A → Nat.card A = 4 → A ≤ innerPart F →
    ∀ z : graphExtension F, orderOf z = 2 → z ∈ A →
    ∃ s : SL(3,F),
      innerSL F s * standardInner F * (innerSL F s)⁻¹ = z ∧
      A.map (MulAut.conj (innerSL F s)⁻¹).toMonoidHom = coordinateFour F

/-- Literal diagonal lifts of the inner and outer elements, with only the
ratio on coordinates 1 and 2 retained. -/
@[expose] def DiagonalControl (D : Subgroup (graphExtension F)) : Prop :=
  ∃ δ : Fˣ, ∀ g ∈ D, ∃ d : SL(3,F),
    d.val = Matrix.diagonal (fun i => d.val i i) ∧
    ((g = innerSL F d ∧ (d.val 2 2 = d.val 1 1 ∨ d.val 2 2 = -d.val 1 1)) ∨
      (g = innerSL F d * graphElement F ∧
        (d.val 2 2 = (δ : F) * d.val 1 1 ∨ d.val 2 2 = -((δ : F) * d.val 1 1))))

/-- The required centralizer calculation involves arbitrary two-subgroups,
so it can be applied after conjugating the full `C_T(A)`. -/
@[expose] def DiagonalTwoControl : Prop :=
  ∀ D : Subgroup (graphExtension F), IsPGroup 2 D →
    D ≤ centralizer (coordinateFour F : Set (graphExtension F)) → DiagonalControl F D

end CFSG.Quasithin.ChapterE.ValuesOdd.PSLThreeGeneration.ProperExtension.GraphLarge.InnerGenerationGeometry.OddTorus
