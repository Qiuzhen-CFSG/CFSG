variable {F : Type*} [Field F]

private theorem matrix_form_matrix [Invertible (2 : F)] {n : ℕ}
    (S : Matrix (Fin n) (Fin n) F) (hs : S.transpose = S) :
    S.toQuadraticForm'.toMatrix' = S := by
  have hB := Matrix.isSymm_toBilin'_iff_isSymm.mpr hs
  change LinearMap.toMatrix₂' F (QuadraticMap.associated S.toBilin'.toQuadraticMap) = S
  rw [QuadraticMap.associated_left_inverse F (fun x y => hB.eq x y)]
  exact LinearMap.toMatrix'_toLinearMap₂' S

private theorem polar_nondegenerate [Invertible (2 : F)] {n : ℕ}
    (Q : QuadraticForm F (Fin n → F)) (h2 : (2 : F) ≠ 0)
    (hQ : Q.toMatrix'.det ≠ 0) : Q.polarBilin.Nondegenerate := by
  have ha : Q.associated.Nondegenerate :=
    LinearMap.BilinForm.nondegenerate_toMatrix'_iff.mp
      (Matrix.nondegenerate_iff_det_ne_zero.mpr hQ)
  constructor
  · intro x hx
    apply ha.1
    intro y
    have h := congrArg (fun B => B x y) (QuadraticMap.two_nsmul_associated (S := F) Q)
    simp only [LinearMap.smul_apply, nsmul_eq_mul, hx] at h
    exact (mul_eq_zero.mp h).resolve_left h2
  · intro x hx
    apply ha.2
    intro y
    have h := congrArg (fun B => B y x) (QuadraticMap.two_nsmul_associated (S := F) Q)
    simp only [LinearMap.smul_apply, nsmul_eq_mul, hx] at h
    exact (mul_eq_zero.mp h).resolve_left h2

private theorem binary_congruence [Finite F] (h2 : (2 : F) ≠ 0)
    (B : Matrix (Fin 2) (Fin 2) F) (hs : B.transpose = B)
    (d : Fˣ) (hd : B.det = (d : F)⁻¹) :
    ∃ C : Matrix (Fin 2) (Fin 2) F,
      C.transpose * B * C = !![(d : F), 0; 0, ((d⁻¹ : Fˣ) : F)^2] ∧ C.det ^ 2 = 1 := by
  let := invertibleOfNonzero h2
  let D : Matrix (Fin 2) (Fin 2) F := !![(d : F), 0; 0, ((d⁻¹ : Fˣ) : F)^2]
  have hD : D.transpose = D := by ext i j; fin_cases i <;> fin_cases j <;> rfl
  have hdD : D.det = (d : F)⁻¹ := by
    simp [D, Matrix.det_fin_two, pow_two]
  have hd0 : B.det ≠ 0 := by rw [hd]; exact inv_ne_zero d.ne_zero
  let Q := B.toQuadraticForm'
  let R := D.toQuadraticForm'
  have hQ : Q.toMatrix' = B := matrix_form_matrix B hs
  have hR : R.toMatrix' = D := matrix_form_matrix D hD
  obtain ⟨e⟩ := (BenderSuzuki.MatrixGroups.HermitianForm.OddPrimeSylow.NormalizedOuter.Descent.SymmetricSimilarity.finite_nondegenerate_isometry_iff_discr_square h2 1 R Q
    (polar_nondegenerate R h2 (by rw [hR, hdD]; exact inv_ne_zero d.ne_zero))
    (polar_nondegenerate Q h2 (by rwa [hQ]))).mpr (by
      change IsSquare (R.toMatrix'.det / Q.toMatrix'.det)
      rw [hQ, hR, hdD, hd, div_self (inv_ne_zero d.ne_zero)]
      exact ⟨1, by simp⟩)
  let C := LinearMap.toMatrix' e.toLinearEquiv.toLinearMap
  have he : Q.comp e.toLinearEquiv.toLinearMap = R := by
    ext v
    exact e.map_app v
  have hc := congrArg QuadraticForm.toMatrix' he
  rw [QuadraticForm.toMatrix'_comp, hQ, hR] at hc
  refine ⟨C, hc, ?_⟩
  have hh := congrArg Matrix.det hc
  rw [Matrix.det_mul, Matrix.det_mul, Matrix.det_transpose, hd, hdD] at hh
  apply mul_right_cancel₀ (inv_ne_zero d.ne_zero)
  change C.det ^ 2 * (d : F)⁻¹ = 1 * (d : F)⁻¹
  calc
    _ = C.det * (d : F)⁻¹ * C.det := by ring
    _ = (d : F)⁻¹ := hh
    _ = _ := (one_mul _).symm

/-- A symmetric special linear matrix commuting with the fixed reflection has
an actual determinant-one congruence to the displayed diagonal twist. -/
private theorem symmetric_reflection_normal_form [Finite F] (h2 : (2 : F) ≠ 0)
    (s : SL(3,F)) (hs : s.val.transpose = s.val)
    (hw : s * reflectionSL F = reflectionSL F * s) :
    ∃ (t : SL(3,F)) (d : Fˣ),
      t * reflectionSL F = reflectionSL F * t ∧
      t.val * s.val * t.val.transpose = (twistSL F d).val := by
  have hc (i j : Fin 3) := congrArg (fun x : SL(3,F) => x.val i j) hw
  have h01 : s.val 0 1 = 0 := by
    have hh := hc 0 1
    change (s.val * (reflectionSL F).val) 0 1 = ((reflectionSL F).val * s.val) 0 1 at hh
    simp [reflectionSL, Matrix.mul_apply, Fin.sum_univ_three] at hh
    exact (mul_eq_zero.mp (show (2 : F) * s.val 0 1 = 0 by linear_combination -hh)).resolve_left h2
  have h02 : s.val 0 2 = 0 := by
    have hh := hc 0 2
    change (s.val * (reflectionSL F).val) 0 2 = ((reflectionSL F).val * s.val) 0 2 at hh
    simp [reflectionSL, Matrix.mul_apply, Fin.sum_univ_three] at hh
    exact (mul_eq_zero.mp (show (2 : F) * s.val 0 2 = 0 by linear_combination -hh)).resolve_left h2
  have h10 : s.val 1 0 = 0 := by
    have hh := congr_fun₂ hs 0 1
    simpa [Matrix.transpose_apply, h01] using hh
  have h20 : s.val 2 0 = 0 := by
    have hh := congr_fun₂ hs 0 2
    simpa [Matrix.transpose_apply, h02] using hh
  let B : Matrix (Fin 2) (Fin 2) F := !![s.val 1 1, s.val 1 2; s.val 2 1, s.val 2 2]
  have hb : B.transpose = B := by
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [B, Matrix.transpose_apply]
    · exact congr_fun₂ hs 1 2
    · exact congr_fun₂ hs 2 1
  have hdB : s.val 0 0 * B.det = 1 := by
    have hh := s.property
    simp only [Matrix.det_fin_three, h01, h02, h10, h20, mul_zero, zero_mul,
      add_zero, sub_zero] at hh
    simpa [B, Matrix.det_fin_two, mul_sub, mul_assoc] using hh
  have hd0 : s.val 0 0 ≠ 0 := by intro h; rw [h, zero_mul] at hdB; exact zero_ne_one hdB
  let d : Fˣ := Units.mk0 (s.val 0 0) hd0
  have hbd : B.det = (d : F)⁻¹ := by
    exact eq_inv_of_mul_eq_one_right hdB
  obtain ⟨C, hC, hdetC⟩ := binary_congruence h2 B hb d hbd
  let T : Matrix (Fin 3) (Fin 3) F :=
    !![C.det, 0, 0; 0, C 0 0, C 1 0; 0, C 0 1, C 1 1]
  have hT : T.det = 1 := by
    have hh : T.det = C.det ^ 2 := by
      simp [T, Matrix.det_fin_three, Matrix.det_fin_two]
      ring
    exact hh.trans hdetC
  refine ⟨⟨T, hT⟩, d, ?_, ?_⟩
  · apply Subtype.ext
    change T * (reflectionSL F).val = (reflectionSL F).val * T
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [T, reflectionSL, Matrix.mul_apply, Fin.sum_univ_three]
  · have h00 : C.det * s.val 0 0 * C.det = (d : F) := by
      change _ = s.val 0 0
      calc
        _ = s.val 0 0 * C.det ^ 2 := by ring
        _ = _ := by rw [hdetC, mul_one]
    have hh (i j : Fin 2) := congr_fun₂ hC i j
    ext i j
    fin_cases i <;> fin_cases j
    all_goals simp [T, twistSL, Matrix.mul_apply, Matrix.vecMul, dotProduct, Fin.sum_univ_three,
      Matrix.transpose_apply, h01, h02, h10, h20]
    · exact h00
    · simpa [Matrix.mul_apply, Fin.sum_univ_two, B] using hh 0 0
    · simpa [Matrix.mul_apply, Fin.sum_univ_two, B] using hh 0 1
    · simpa [Matrix.mul_apply, Fin.sum_univ_two, B] using hh 1 0
    · simpa [Matrix.mul_apply, Fin.sum_univ_two, B] using hh 1 1
end CFSG.Quasithin.ChapterE.ValuesOdd.PSLThreeGeneration.ProperExtension.GraphLarge.OuterFamilies.ConjugateFusion


open Matrix Subgroup
open scoped MatrixGroups IsMulCommutative
open Matrix.PSL3 Matrix.PSL3.OuterSolvable
open Matrix.PSL3.OddPrimeGraphExtension
open Matrix.PSL3.OddPrimeGraphExtension.GraphLargeStructure
open CFSG.Quasithin.ChapterE.ValuesOdd.PSLThreeGeneration.ProperExtension.GraphLarge.InnerGenerationGeometry
namespace CFSG.Quasithin.ChapterE.ValuesOdd.PSLThreeGeneration.ProperExtension.GraphLarge.OuterFamilies.ConjugateFusion
variable {F : Type*} [Field F]

private theorem graph_inner (x : SL(3,F)) :
    graphElement F * innerSL F x * (graphElement F)⁻¹ = innerSL F (graphSL F x) := by
  symm
  apply Subtype.ext
  change MulAut.conj (projection F (graphSL F x)) =
    graph F * MulAut.conj (projection F x) * (graph F)⁻¹
  have he : projection F (graphSL F x) = graph F (projection F x) := rfl
  rw [he]
  ext y
  simp only [MulAut.mul_apply, MulAut.inv_apply, MulAut.conj_apply, map_mul, map_inv,
    MulEquiv.apply_symm_apply]

private theorem reflectionSL_sq : reflectionSL F ^ 2 = 1 := by
  rw [pow_two]
  apply Subtype.ext
  change (reflectionSL F).val * (reflectionSL F).val = 1
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [reflectionSL, Matrix.mul_apply, Fin.sum_univ_three]

private theorem graph_reflection :
    graphElement F * reflection F = reflection F * graphElement F := by
  have ht : SpecialLinearGroup.transpose (reflectionSL F) = reflectionSL F := by
    apply Subtype.ext
    ext i j
    fin_cases i <;> fin_cases j <;> rfl
  have hi : (reflectionSL F)⁻¹ = reflectionSL F :=
    inv_eq_of_mul_eq_one_right (by simpa [pow_two] using (reflectionSL_sq (F := F)))
  have hg : graphSL F (reflectionSL F) = reflectionSL F := by
    change (SpecialLinearGroup.transpose _)⁻¹ = _
    rw [ht, hi]
  apply mul_inv_eq_iff_eq_mul.mp
  change graphElement F * innerSL F (reflectionSL F) * (graphElement F)⁻¹ = _
  rw [graph_inner, hg]
  rfl

private theorem projection_eq_of_innerSL_eq [IsSimpleGroup PSL(3,F)]
    {x y : SL(3,F)} (h : innerSL F x = innerSL F y) :
    projection F x = projection F y := by
  apply (innerPartEquiv F).injective
  apply Subtype.ext
  apply Subtype.ext
  simp only [innerPartEquiv_apply_coe]
  exact congrArg Subtype.val h

private theorem powers_two {G : Type*} [Group G] {g z : G}
    (hg : g ^ 2 = 1) (hz : z ∈ zpowers g) : z = 1 ∨ z = g := by
  by_cases hg1 : g = 1
  · simpa [hg1] using hz
  have ho : orderOf g = 2 := orderOf_eq_prime hg hg1
  obtain ⟨n, rfl⟩ := hz
  have he : g ^ n = g ^ (n % 2) := by
    simpa [ho] using (zpow_mod_orderOf g n).symm
  rcases (show n % 2 = 0 ∨ n % 2 = 1 by omega) with hn | hn
  · left; change g ^ n = 1; rw [he, hn, zpow_zero]
  · right; change g ^ n = g; rw [he, hn, zpow_one]

private theorem outer_presentation (a : graphExtension F) (ha : a ∉ innerPart F) :
    ∃ s : SL(3,F), a = innerSL F s * graphElement F := by
  obtain ⟨y, hy, z, hz, he⟩ := mem_sup_of_normal_left.mp a.property
  rcases powers_two (graph_sq F) hz with rfl | rfl
  · apply (ha ?_).elim
    change a.val ∈ MulAut.innerSubgroup PSL(3,F)
    rw [← he, mul_one]
    exact hy
  obtain ⟨x, rfl⟩ := hy
  obtain ⟨s, rfl⟩ := projection_surjective F x
  exact ⟨s, Subtype.ext he.symm⟩

private theorem inner_coordinates [Finite F] [IsSimpleGroup PSL(3,F)]
    (h2 : (2 : F) ≠ 0) (w : graphExtension F)
    (hw : orderOf w = 2) (hwL : w ∈ innerPart F) :
    ∃ g : graphExtension F, MulAut.conj g w = reflection F := by
  let wL : innerPart F := ⟨w, hwL⟩
  let y := (innerPartEquiv F).symm wL
  have hy : orderOf y = 2 := by
    rw [MulEquiv.orderOf_eq, ← orderOf_submonoid]
    exact hw
  obtain ⟨u, hu, hproj⟩ := OddInvolutionFixed.involution_lift y hy
  have hwref : orderOf (reflectionSL F) = 2 := by
    apply orderOf_eq_prime reflectionSL_sq
    intro h
    have he := congrArg (fun x : SL(3,F) => x.val 1 1) h
    have hh : (-1 : F) = 1 := he
    apply h2
    linear_combination -hh
  obtain ⟨s, hs⟩ := isConj_iff.mp (SL3.involutions_isConj F u (reflectionSL F) hu hwref h2)
  have he : innerSL F u = w := by
    apply Subtype.ext
    change MulAut.conj (projection F u) = w.val
    rw [hproj]
    exact innerPartEquiv_symm_conj F wL
  refine ⟨innerSL F s, ?_⟩
  rw [← he]
  change innerSL F s * innerSL F u * (innerSL F s)⁻¹ = innerSL F (reflectionSL F)
  rw [← map_inv, ← map_mul, ← map_mul, hs]

private theorem pair_generates {G : Type*} [Group G] [Finite G]
    (L A : Subgroup G) [IsElementaryAbelian 2 A]
    (hfour : Nat.card A = 4) {w a : G} (hwA : w ∈ A) (haA : a ∈ A)
    (hw : orderOf w = 2) (hwL : w ∈ L) (haL : a ∉ L) :
    A = zpowers w ⊔ zpowers a := by
  have ha2 : a ^ 2 = 1 := elemPow_eq_one_of_isElementaryAbelian a haA
  have ha1 : a ≠ 1 := fun h => haL (h ▸ L.one_mem)
  have hwa : Commute w a :=
    congrArg Subtype.val (mul_comm (⟨w, hwA⟩ : A) (⟨a, haA⟩ : A))
  let : IsKleinFour (closure ({w, a} : Set G)) :=
    isKleinFour_closure_pair_of_orderOf w a hw (orderOf_eq_prime ha2 ha1)
      (fun h => haL (h ▸ hwL)) hwa
  have hc : closure ({w, a} : Set G) = A := by
    apply eq_of_le_of_card_ge
    · apply (closure_le A).mpr
      simp only [Set.insert_subset_iff, Set.singleton_subset_iff, SetLike.mem_coe]
      exact ⟨hwA, haA⟩
    · rw [hfour, IsKleinFour.card_four]
  rw [← hc, zpowers_eq_closure, zpowers_eq_closure, ← Subgroup.closure_union]
  rfl

/-- The original actor admits an actual conjugate generated by the fixed inner
reflection and an outer actor whose SL₃ coefficient is symmetric and commutes
exactly with that reflection. -/
private theorem exists_symmetric_actor [Finite F] [IsSimpleGroup PSL(3,F)]
    (h2 : (2 : F) ≠ 0) (A : Subgroup (graphExtension F))
    [IsElementaryAbelian 2 A] (hfour : Nat.card A = 4)
    (hinter : Nat.card (A ⊓ innerPart F : Subgroup _) = 2) :
    ∃ (g : graphExtension F) (s : SL(3,F)),
      s.val.transpose = s.val ∧ s * reflectionSL F = reflectionSL F * s ∧
      A.map (MulAut.conj g).toMonoidHom =
        zpowers (reflection F) ⊔ zpowers (innerSL F s * graphElement F) := by
  obtain ⟨w, hw⟩ := exists_prime_orderOf_dvd_card' (G := (A ⊓ innerPart F : Subgroup _)) 2
    (by rw [hinter])
  have hw' : orderOf (w : graphExtension F) = 2 := by simpa only [orderOf_coe] using hw
  obtain ⟨g, hg⟩ := inner_coordinates h2 w hw' w.property.2
  have hout : ¬ A ≤ innerPart F := by
    intro h
    rw [inf_eq_left.mpr h, hfour] at hinter
    omega
  obtain ⟨a, haA, haL⟩ := SetLike.not_le_iff_exists.mp hout
  let e := MulAut.conj g
  let B := A.map e.toMonoidHom
  let : IsElementaryAbelian 2 B := IsElementaryAbelian.map e.toMonoidHom
  have hrefB : reflection F ∈ B := hg ▸ mem_map_of_mem e.toMonoidHom w.property.1
  have haB : e a ∈ B := mem_map_of_mem e.toMonoidHom haA
  have haL' : e a ∉ innerPart F := by
    intro h
    have hh := (inferInstance : (innerPart F).Normal).conj_mem (e a) h g⁻¹
    apply haL
    simpa [e, MulAut.conj_apply, mul_assoc] using hh
  obtain ⟨s, hs⟩ := outer_presentation (e a) haL'
  have ha2 : (e a) ^ 2 = 1 := elemPow_eq_one_of_isElementaryAbelian (e a) haB
  have hsSym : s.val.transpose = s.val := by
    have hh := congrArg Subtype.val ha2
    rw [hs] at hh
    change (MulAut.conj (projection F s) * graph F) ^ 2 = 1 at hh
    change (MulAut.conj (QuotientGroup.mk s) * graph F) ^ 2 = 1 at hh
    rw [← linearConj_toGL F s] at hh
    exact OddInvolutionFixed.graph_involution_symmetric (SpecialLinearGroup.toGL s) hh
  have hcomm : innerSL F s * reflection F = reflection F * innerSL F s := by
    have hh : (innerSL F s * graphElement F) * reflection F =
        reflection F * (innerSL F s * graphElement F) := by
      rw [← hs]
      exact congrArg Subtype.val (mul_comm (⟨e a, haB⟩ : B) (⟨reflection F, hrefB⟩ : B))
    apply mul_right_cancel (b := graphElement F)
    calc
      _ = innerSL F s * (reflection F * graphElement F) := mul_assoc _ _ _
      _ = innerSL F s * (graphElement F * reflection F) := by rw [graph_reflection]
      _ = _ := by simpa only [mul_assoc] using hh
  have hsComm : s * reflectionSL F = reflectionSL F * s := by
    apply OddInvolutionFixed.commutes_of_projective_commutes (reflectionSL F) s reflectionSL_sq
    rw [← map_mul, ← map_mul]
    apply projection_eq_of_innerSL_eq
    simpa only [map_mul, reflection] using hcomm
  have hwref : orderOf (reflection F) = 2 := by
    rw [← hg]
    exact (e.orderOf_eq (w : graphExtension F)).trans hw'
  have hgen := pair_generates (innerPart F) B
    ((card_map_of_injective e.injective).trans hfour) hrefB haB
    hwref
    (show reflection F ∈ innerPart F from ⟨projection F (reflectionSL F), rfl⟩) haL'
  exact ⟨g, s, hsSym, hsComm, by change B = _; rw [hgen, hs]⟩

private theorem inner_conj_graph (t s : SL(3,F)) :
    MulAut.conj (innerSL F t) (innerSL F s * graphElement F) =
      innerSL F (t * s * SpecialLinearGroup.transpose t) * graphElement F := by
  have hg : graphSL F t⁻¹ = SpecialLinearGroup.transpose t := by
    rw [map_inv]
    exact inv_inv _
  have hh := graph_inner (F := F) t⁻¹
  rw [hg, map_inv] at hh
  have h := mul_inv_eq_iff_eq_mul.mp hh
  change innerSL F t * (innerSL F s * graphElement F) * (innerSL F t)⁻¹ = _
  calc
    _ = (innerSL F t * innerSL F s) * (graphElement F * (innerSL F t)⁻¹) := by group
    _ = (innerSL F t * innerSL F s) *
        (innerSL F (SpecialLinearGroup.transpose t) * graphElement F) := by rw [h]
    _ = _ := by rw [← mul_assoc, ← map_mul, ← map_mul]

variable (F)

/-- Every original outer four-group has the explicit simultaneous normal form.
Only finiteness and odd characteristic are needed. -/
theorem standardActorCoverage [Finite F] [IsSimpleGroup PSL(3,F)]
    (h2 : (2 : F) ≠ 0) : StandardActorCoverage F := by
  intro A hAE hfour hinter
  let : IsElementaryAbelian 2 A := hAE
  obtain ⟨g, s, hs, hw, hA⟩ := exists_symmetric_actor h2 A hfour hinter
  obtain ⟨t, d, htw, hts⟩ := symmetric_reflection_normal_form h2 s hs hw
  have hfix : MulAut.conj (innerSL F t) (reflection F) = reflection F := by
    change innerSL F t * innerSL F (reflectionSL F) * (innerSL F t)⁻¹ = _
    rw [← map_inv, ← map_mul, ← map_mul, htw, mul_inv_cancel_right]
    rfl
  have hgraph : MulAut.conj (innerSL F t) (innerSL F s * graphElement F) =
      twistedGraph F d := by
    rw [inner_conj_graph]
    have he : t * s * SpecialLinearGroup.transpose t = twistSL F d := Subtype.ext hts
    rw [he]
    rfl
  refine ⟨innerSL F t * g, d, ?_⟩
  have hmap : A.map (MulAut.conj (innerSL F t * g)).toMonoidHom =
      (A.map (MulAut.conj g).toMonoidHom).map (MulAut.conj (innerSL F t)).toMonoidHom := by
    rw [Subgroup.map_map]
    congr 1
  rw [hmap, hA, Subgroup.map_sup, MonoidHom.map_zpowers, MonoidHom.map_zpowers]
  change zpowers (MulAut.conj (innerSL F t) (reflection F)) ⊔
    zpowers (MulAut.conj (innerSL F t) (innerSL F s * graphElement F)) = _
  rw [hfix, hgraph]
  rfl

/-- The source's odd-prime field hypotheses supply the odd-characteristic input;
no Sylow, ambient generation, quasithinness, or fusion premise is needed. -/
theorem standardActorCoverage_of_odd_card [Finite F] [IsSimpleGroup PSL(3,F)]
