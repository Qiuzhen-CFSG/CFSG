module

public import CFSG.Quasithin.ChapterE.Section01.ValuesOdd.PSLThreeGeneration.ProperExtension.GraphLarge.InnerFamilies.Geometry.SplitMonomial.Model
import Theory.SpecificGroups.GL2.DiagonalSwap
import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Card

/-!
# Odd monomial index in the full involution centralizer

The GL₂ diagonal-and-swap subgroup generated by a multiplicative generator
has order twice the square of the unit-group order. Comparing with the GL₂
order proves its index odd when the field order is one modulo four. Its
literal determinant-corrected block image lies in the SL₃ coordinate-axis
stabilizer.

The block homomorphism maps onto the inner part of the standard involution
centralizer: projective commutation with the involution lifts to exact linear
commutation. The full centralizer is generated by this normal inner part
and inverse transpose. Since graph already lies in the monomial overgroup,
relative index and comap index transfer the odd GL₂ index to the full group.

Source: Aschbacher--Smith E.1.14(7), printed p.214, via Aschbacher (1982),
Lemma 4.11; the involution block calculation is A.3.21(a), printed p.55.
-/

public section
open Subgroup Matrix
open scoped MatrixGroups Pointwise
open Matrix.PSL3.OddPrimeGraphExtension
open Matrix.PSL3.OddPrimeGraphExtension.GraphLargeStructure
namespace CFSG.Quasithin.ChapterE.ValuesOdd.PSLThreeGeneration.ProperExtension.GraphLarge.InnerGenerationGeometry
variable (F : Type*) [Field F] [Finite F]

private theorem mem_linear_of_support (x : SL(3,F)) (σ : Equiv.Perm (Fin 3))
    (hn : ∀ j, x.val (σ j) j ≠ 0)
    (hz : ∀ i j, i ≠ σ j → x.val i j = 0) :
    x ∈ SL3.SplitMonomial.linear F := by
  change x ∈ MulAction.stabilizer _ (SL3.SplitMonomial.coordinateVectors F)
  rw [MulAction.mem_stabilizer_iff]
  apply Set.eq_of_subset_of_ncard_le
  · apply Set.smul_set_subset_iff.mpr
    rintro v ⟨j, hj, hv⟩
    have he : v = Pi.single j (v j) := by
      ext i
      by_cases hi : i = j
      · simp [hi]
      · simp [hi, hv i hi]
    refine ⟨σ j, ?_, ?_⟩
    · change (x.val *ᵥ v) (σ j) ≠ 0
      rw [he, Matrix.mulVec_single]
      exact mul_ne_zero (hn j) hj
    · intro i hi
      change (x.val *ᵥ v) i = 0
      rw [he, Matrix.mulVec_single]
      change x.val i j * v j = 0
      rw [hz i j hi, zero_mul]
  · exact le_of_eq (Set.ncard_smul_set _ _).symm
  · exact Set.toFinite _

private theorem block_diagonal_mem_linear (a b : Fˣ) :
    SL3.blockEmbedding F (GeneralLinearGroup.diagonalPair F (a,b)) ∈ SL3.SplitMonomial.linear F := by
  apply mem_linear_of_support F _ (Equiv.refl _)
  · intro j
    fin_cases j
    · exact Units.ne_zero a
    · exact Units.ne_zero b
    · change (↑((GeneralLinearGroup.det (GeneralLinearGroup.diagonalPair F (a,b)))⁻¹) : F) ≠ 0
      exact Units.ne_zero _
  · intro i j hij
    change SL3.blockMatrix F (GeneralLinearGroup.diagonalPair F (a,b)) i j = 0
    fin_cases i <;> fin_cases j <;>
      simp_all [SL3.blockMatrix, GeneralLinearGroup.diagonalPair]

private theorem block_swap_mem_linear :
    SL3.blockEmbedding F (GeneralLinearGroup.coordinateSwap F) ∈ SL3.SplitMonomial.linear F := by
  apply mem_linear_of_support F _ (Equiv.swap 0 1)
  · intro j
    fin_cases j
    · exact one_ne_zero
    · exact one_ne_zero
    · change (↑((GeneralLinearGroup.det (GeneralLinearGroup.coordinateSwap F))⁻¹) : F) ≠ 0
      exact Units.ne_zero _
  · intro i j hij
    change SL3.blockMatrix F (GeneralLinearGroup.coordinateSwap F) i j = 0
    fin_cases i <;> fin_cases j <;>
      simp_all [SL3.blockMatrix, GeneralLinearGroup.coordinateSwap,
        Equiv.swap_apply_def]

private theorem diagonalSwap_le_block_comap (ζ : Fˣ) :
    GeneralLinearGroup.diagonalSwapSubgroup F ζ ≤
      (SL3.SplitMonomial.linear F).comap (SL3.blockEmbedding F) := by
  rw [GeneralLinearGroup.diagonalSwapSubgroup, closure_le]
  intro x hx
  rcases (by simpa using hx : x = GeneralLinearGroup.diagonalPair F (ζ,1) ∨
    x = GeneralLinearGroup.diagonalPair F (1,ζ) ∨ x = GeneralLinearGroup.coordinateSwap F) with
    rfl | rfl | rfl
  · exact block_diagonal_mem_linear F ζ 1
  · exact block_diagonal_mem_linear F 1 ζ
  · exact block_swap_mem_linear F

private theorem gl2_card_factored :
    Nat.card (GL (Fin 2) F) = Nat.card F * (Nat.card F - 1)^2 * (Nat.card F + 1) := by
  let : Fintype F := Fintype.ofFinite F
  rw [Matrix.card_GL_field]
  simp only [Fin.prod_univ_two, Fin.val_zero, Fin.val_one, pow_zero, pow_one,
    ← Nat.card_eq_fintype_card]
  let q := Nat.card F
  have hq : 1 < q := Finite.one_lt_card
  have hq1 : q - 1 + 1 = q := Nat.sub_add_cancel (by omega)
  have hq2 : 1 ≤ q^2 := by nlinarith
  have h₁ : q^2 - 1 = (q-1)*(q+1) := by
    have h := Nat.sub_add_cancel hq2
    nlinarith
  have h₂ : q^2-q = q*(q-1) := by
    rw [Nat.mul_sub_left_distrib, mul_one, pow_two]
  change (q^2-1)*(q^2-q) = q*(q-1)^2*(q+1)
  rw [h₁,h₂]
  ring

private theorem block_monomial_odd_index (hmod : Nat.card F % 4 = 1) :
    ¬ 2 ∣ ((SL3.SplitMonomial.linear F).comap (SL3.blockEmbedding F)).index := by
  obtain ⟨ζ, hζ⟩ := IsCyclic.exists_ofOrder_eq_natCard (α := Fˣ)
  let N := GeneralLinearGroup.diagonalSwapSubgroup F ζ
  have hN : Nat.card N = 2 * (Nat.card F - 1)^2 := by
    rw [GeneralLinearGroup.diagonalSwapSubgroup_card, hζ, Nat.card_units]
  have hq : 1 < Nat.card F := Finite.one_lt_card
  have he : 2 * N.index = Nat.card F * (Nat.card F + 1) := by
    apply Nat.eq_of_mul_eq_mul_left (pow_pos (Nat.sub_pos_of_lt hq) 2)
    calc
      _ = Nat.card N * N.index := by rw [hN]; ring
      _ = Nat.card (GL (Fin 2) F) := N.card_mul_index
      _ = _ := by rw [gl2_card_factored F]; ring
  have hNi : ¬ 2 ∣ N.index := by
    intro hi
    obtain ⟨k, hk⟩ := hi
    have hm : (Nat.card F * (Nat.card F + 1)) % 4 = 2 := by
      simp [Nat.mul_mod, Nat.add_mod, hmod]
    rw [← he, hk] at hm
    omega
  exact fun hd => hNi (hd.trans (index_dvd_of_le (diagonalSwap_le_block_comap F ζ)))

variable [IsSimpleGroup PSL(3,F)]

omit [Finite F] [IsSimpleGroup PSL(3,F)] in
private theorem index_innerSL_range : (innerSL F).range = innerPart F := by
  ext x
  constructor
  · rintro ⟨g, rfl⟩
    exact ⟨Matrix.PSL3.projection F g, rfl⟩
  · intro hx
    obtain ⟨y, hy⟩ := hx
    obtain ⟨g, rfl⟩ := Matrix.PSL3.projection_surjective F y
    exact ⟨g, Subtype.ext hy⟩

omit [Finite F] in
private theorem projective_eq_of_innerSL_eq {x y : SL(3,F)}
    (h : innerSL F x = innerSL F y) : Matrix.PSL3.projection F x = Matrix.PSL3.projection F y := by
  apply (innerPartEquiv F).injective
  apply Subtype.ext
  apply Subtype.ext
  rw [innerPartEquiv_apply_coe, innerPartEquiv_apply_coe]
  exact congrArg Subtype.val h

private def blockToStandardCentralizer (h2 : (2 : F) ≠ 0) :
    GL (Fin 2) F →* centralizer ({standardInner F} : Set (graphExtension F)) :=
  ((innerSL F).comp (SL3.blockEmbedding F)).codRestrict _ (by
    intro A
    apply mem_centralizer_singleton_iff.mpr
    change innerSL F (SL3.blockEmbedding F A) * innerSL F (SL3.standardInvolution F) =
      innerSL F (SL3.standardInvolution F) * innerSL F (SL3.blockEmbedding F A)
    rw [← map_mul, ← map_mul]
    apply congrArg (innerSL F)
    apply mem_centralizer_singleton_iff.mp
    rw [← SL3.blockEmbedding_range F h2]
    exact ⟨A,rfl⟩)

private theorem blockToStandardCentralizer_range (h2 : (2 : F) ≠ 0) :
    (blockToStandardCentralizer F h2).range = (innerPart F).subgroupOf
      (centralizer ({standardInner F} : Set (graphExtension F))) := by
  apply le_antisymm
  · rintro _ ⟨A,rfl⟩
    change innerSL F (SL3.blockEmbedding F A) ∈ innerPart F
    rw [← index_innerSL_range F]
    exact ⟨_,rfl⟩
  · intro c hc
    obtain ⟨x, hx⟩ := (index_innerSL_range F).symm ▸ hc
    change innerSL F x = c.val at hx
    have hxcomm : x * SL3.standardInvolution F = SL3.standardInvolution F * x := by
      apply Matrix.PSL3.OddInvolutionFixed.commutes_of_projective_commutes _ _ (SL3.standardInvolution_sq F)
      rw [← map_mul, ← map_mul]
      apply projective_eq_of_innerSL_eq F
      rw [map_mul, map_mul, hx]
      exact mem_centralizer_singleton_iff.mp c.property
    obtain ⟨A, hA⟩ := (SL3.blockEmbedding_range F h2).symm ▸
      (mem_centralizer_singleton_iff.mpr hxcomm)
    refine ⟨A, Subtype.ext ?_⟩
    change innerSL F (SL3.blockEmbedding F A) = c.val
    rw [hA,hx]

omit [Finite F] [IsSimpleGroup PSL(3,F)] in
private theorem index_inner_sup_graph : innerPart F ⊔ zpowers (graphElement F) = ⊤ := by
  apply Subgroup.map_injective (graphExtension F).subtype_injective
  rw [Subgroup.map_sup, MonoidHom.map_zpowers]
  change ((MulAut.innerSubgroup PSL(3,F)).subgroupOf (graphExtension F)).map _ ⊔
    zpowers (Matrix.PSL3.OuterSolvable.graph F) = _
  rw [map_subgroupOf_eq_of_le (show MulAut.innerSubgroup PSL(3,F) ≤ graphExtension F from le_sup_left)]
  rw [← MonoidHom.range_eq_map, range_subtype]
  rfl

/-- Only the GL₂ block index is needed for placement of the full ambient Sylow. -/
theorem splitMonomial_odd_relIndex (hodd : Odd (Nat.card F))
    (hmod : Nat.card F % 4 = 1) :
    ¬ 2 ∣ (splitMonomialOvergroup F).relIndex
      (centralizer ({standardInner F} : Set (graphExtension F))) := by
  let C := centralizer ({standardInner F} : Set (graphExtension F))
  let K := (splitMonomialOvergroup F).subgroupOf C
  let I := (innerPart F).subgroupOf C
  have h2 := Field.two_ne_zero_of_odd_card F hodd
  let f := blockToStandardCentralizer F h2
  have hf : f.range = I := blockToStandardCentralizer_range F h2
  have hIK : I ⊔ K = ⊤ := by
    apply top_unique
    intro c _
    have hc : c.val ∈ innerPart F ⊔ zpowers (graphElement F) :=
      index_inner_sup_graph F ▸ mem_top c.val
    obtain ⟨u, hu, v, hv, huv⟩ := mem_sup_of_normal_left.mp hc
    have hvC : v ∈ C := zpowers_le.mpr (split_graph_centralizes_standard F) hv
    have huC : u ∈ C := by
      have h : u = c.val * v⁻¹ := by rw [← huv]; simp
      rw [h]
      exact C.mul_mem c.property (C.inv_mem hvC)
    have hvK : (⟨v,hvC⟩ : C) ∈ K := mem_sup_right hv
    have huI : (⟨u,huC⟩ : C) ∈ I := hu
    have he : (⟨u,huC⟩ : C) * ⟨v,hvC⟩ = c := Subtype.ext huv
    exact he ▸ mul_mem_sup huI hvK
  have hindex : K.index = (K.comap f).index := by
    rw [index_comap, hf, ← relIndex_sup_of_normalizes I K (le_normalizer_of_normal), hIK,
      relIndex_top_right]
  have hle : (SL3.SplitMonomial.linear F).comap (SL3.blockEmbedding F) ≤ K.comap f := by
    intro A hA
    exact mem_sup_left (mem_map_of_mem (innerSL F) hA)
  change ¬ 2 ∣ K.index
  rw [hindex]
  exact fun hd => block_monomial_odd_index F hmod (hd.trans (index_dvd_of_le hle))

end CFSG.Quasithin.ChapterE.ValuesOdd.PSLThreeGeneration.ProperExtension.GraphLarge.InnerGenerationGeometry
