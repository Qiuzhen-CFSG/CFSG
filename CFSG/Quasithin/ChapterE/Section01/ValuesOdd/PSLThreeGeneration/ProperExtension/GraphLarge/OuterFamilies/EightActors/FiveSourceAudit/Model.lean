module

public import Theory.SpecificGroups.PSL3.OddPrimeGraphExtension.GraphLargeStructure.Action
public import Theory.SpecificGroups.SL3.InvolutionBlock
public import Theory.SpecificGroups.SL3.SplitMonomial
public import Theory.AtlasPort.ExceptionalIsomorphisms.Simplicity
public import Theory.ElementaryAbelian.AbelianNormalClosure
public import CFSG.Quasithin.ChapterE.Defs

/-!
# The literal five-prime diagnostic actor

The carrier is the subgroup of Aut(PSL₃(ZMod 5)) generated by inner
automorphisms and inverse transpose. The marked inner subgroup and the actual
split monomial overgroup retain their matrix meanings. The actor is generated
by the inner images of diag(-1,-1,1), diag(1,-1,-1), and inverse transpose.

The diagonal matrices commute and are fixed by inverse transpose, so their
three images generate an elementary abelian two-group. Its full ambient
conjugacy class is therefore a legitimate family for E.1.5. These proofs do not
certify its order, the Sylow placement, or the movement of its weak closure.
Those additional concrete facts are not supplied by the GAP diagnostics.

Source: Aschbacher--Smith E.1.1--5 and E.1.14(7), pp.209--214. The matrix
carriers and simplicity theorem are reused from the attributed ATLAS imports;
their license remains in `LICENSES/ATLAS.txt`.
-/

public section
open Subgroup Theory.GroupTheory
open scoped MatrixGroups Matrix IsMulCommutative
open Matrix.PSL3.OddPrimeGraphExtension
open Matrix.PSL3.OddPrimeGraphExtension.GraphLargeStructure
namespace CFSG.Quasithin.ChapterE.ValuesOdd.PSLThreeGeneration.ProperExtension.GraphLarge.OuterFamilies.EightActors.FiveSourceAudit

local instance : Fact (Nat.Prime 5) := ⟨by decide⟩

abbrev Model := graphExtension (ZMod 5)
local instance : IsSimpleGroup PSL(3, ZMod 5) := Atlas.psl_simple_high_rank 3 (by decide)

/-- The marked inner copy, in the literal automorphism carrier. -/
@[expose] def inner : Subgroup Model := innerPart (ZMod 5)

/-- The inner image of a determinant-one matrix. -/
@[expose] noncomputable def innerSL : SL(3, ZMod 5) →* Model :=
  (innerPart (ZMod 5)).subtype.comp
    ((innerPartEquiv (ZMod 5)).toMonoidHom.comp (Matrix.PSL3.projection (ZMod 5)))

/-- The second diagonal involution from the diagnostic. -/
@[expose] def secondDiagonal : SL(3, ZMod 5) :=
  ⟨!![1, 0, 0; 0, -1, 0; 0, 0, -1], by decide +kernel⟩

/-- The actual inverse-transpose element of the graph extension. -/
@[expose] def graphElement : Model :=
  ⟨Matrix.PSL3.OuterSolvable.graph (ZMod 5), (show zpowers (Matrix.PSL3.OuterSolvable.graph (ZMod 5)) ≤ graphExtension (ZMod 5) from le_sup_right) (mem_zpowers _)⟩

/-- The actual split monomial subgroup with inverse transpose adjoined.
Its solvability and the Sylow placement are separate proof obligations. -/
@[expose] noncomputable def monomialOvergroup : Subgroup Model :=
  (Matrix.SL3.SplitMonomial.linear (ZMod 5)).map innerSL ⊔ zpowers graphElement

/-- Exactly the three-generator actor specified in the source audit task. -/
@[expose] noncomputable def actor : Subgroup Model :=
  closure ({innerSL (Matrix.SL3.standardInvolution (ZMod 5)),
    innerSL secondDiagonal, graphElement} : Set Model)

/-- The full ambient conjugacy family, with the eight-group itself retained. -/
@[expose] noncomputable def family : Set (Subgroup Model) :=
  {B | ∃ g : Model, B = actor.map (MulAut.conj g).toMonoidHom}

private theorem secondDiagonal_sq : secondDiagonal ^ 2 = 1 := by decide +kernel

private theorem diagonal_commute :
    Commute (Matrix.SL3.standardInvolution (ZMod 5)) secondDiagonal := by
  change Matrix.SL3.standardInvolution (ZMod 5) * secondDiagonal =
    secondDiagonal * Matrix.SL3.standardInvolution (ZMod 5)
  decide +kernel

private theorem graph_commute_innerSL (d : SL(3, ZMod 5))
    (ht : Matrix.SpecialLinearGroup.transpose d = d) (hs : d ^ 2 = 1) :
    Commute graphElement (innerSL d) := by
  have hi : d⁻¹ = d := (inv_eq_iff_mul_eq_one).mpr (by simpa only [pow_two] using hs)
  have hf : Matrix.PSL3.OuterSolvable.graph (ZMod 5) (Matrix.PSL3.projection (ZMod 5) d) =
      Matrix.PSL3.projection (ZMod 5) d := by
    change Matrix.PSL3.OuterSolvable.graph (ZMod 5) (QuotientGroup.mk d) = QuotientGroup.mk d
    rw [Matrix.PSL3.OuterSolvable.graph_mk, ht, hi]
  apply Subtype.ext
  change Matrix.PSL3.OuterSolvable.graph (ZMod 5) *
      ((innerPartEquiv (ZMod 5) (Matrix.PSL3.projection (ZMod 5) d) : innerPart (ZMod 5)) : Model).val =
    ((innerPartEquiv (ZMod 5) (Matrix.PSL3.projection (ZMod 5) d) : innerPart (ZMod 5)) : Model).val *
      Matrix.PSL3.OuterSolvable.graph (ZMod 5)
  rw [innerPartEquiv_apply_coe]
  ext x
  simp only [MulAut.mul_apply, MulAut.conj_apply, map_mul, map_inv, hf]

/-- The specified actor is elementary abelian on the literal Lean carrier. -/
instance actor_elementary : IsElementaryAbelian 2 actor := by
  have h1 := Matrix.SL3.standardInvolution_sq (ZMod 5)
  have h2 := secondDiagonal_sq
  have h3 : graphElement ^ 2 = 1 := Subtype.ext (Matrix.PSL3.OuterSolvable.graph_sq (ZMod 5))
  have hc := (diagonal_commute.map innerSL).eq
  have hc1 := (graph_commute_innerSL (Matrix.SL3.standardInvolution (ZMod 5))
    (by apply Subtype.ext; ext i j; fin_cases i <;> fin_cases j <;> rfl) h1).eq
  have hc2 := (graph_commute_innerSL secondDiagonal
    (by apply Subtype.ext; ext i j; fin_cases i <;> fin_cases j <;> rfl) h2).eq
  let : IsMulCommutative (closure ({innerSL (Matrix.SL3.standardInvolution (ZMod 5)),
      innerSL secondDiagonal, graphElement} : Set Model)) := isMulCommutative_closure (by
    intro x hx y hy
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx hy
    rcases hx with rfl | rfl | rfl <;> rcases hy with rfl | rfl | rfl
    all_goals first | rfl | exact hc | exact hc.symm | exact hc1 | exact hc1.symm | exact hc2 | exact hc2.symm)
  apply IsElementaryAbelian.closure_of_isMulCommutative
  intro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  rcases hx with rfl | rfl | rfl
  · rw [← map_pow, h1, map_one]
  · rw [← map_pow, h2, map_one]
  · exact h3

/-- Conjugation gives a legitimate E.1 family without replacing actors by
intersections with the inner subgroup. -/
theorem family_elementary : IsElementaryFamily family := by
  constructor
  · rintro B ⟨g, rfl⟩
    exact IsElementaryAbelian.map _
  · rintro g B ⟨h, rfl⟩
    refine ⟨g * h, ?_⟩
    rw [Subgroup.map_map]
    congr 1

end CFSG.Quasithin.ChapterE.ValuesOdd.PSLThreeGeneration.ProperExtension.GraphLarge.OuterFamilies.EightActors.FiveSourceAudit
