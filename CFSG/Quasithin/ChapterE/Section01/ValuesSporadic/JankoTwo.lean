module

public import CFSG.Quasithin.ChapterE.Section01.ValuesSporadic.JankoTwo.LocalGeneration
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.SimpleFittingExtensions
public import CFSG.Quasithin.Defs

/-!
# The Hall--Janko upper bound in E.1.14(5)

The concrete J₂ carrier and its full automorphism extension are rank-two
E-generated by their two checked Sylow overgroups. Faithful conjugation on
the simple generalized Fitting subgroup identifies every source ambient
group with one of these two carriers. E-generation transports along these
actual multiplicative equivalences, yielding the source parameter bound.

The first theorem is stronger than the source clause: the simple-Fitting
hypothesis and model equivalence suffice. The source adapters retain SQTK,
the specified Sylow subgroup, L = F*(G), and G = LT explicitly. Every local
bound, quotient identification and outer-extension input is discharged.

Source: Aschbacher--Smith, *The Classification of Quasithin Groups*,
E.1.14(5), printed p.214, citing Aschbacher, *GF(2)-representations of finite
groups* (1982), Lemma 4.9. Definitions use E.1.2's corrected local tau.
-/

public section

namespace CFSG.Quasithin.ChapterE.JankoTwo
open Subgroup Theory.GroupTheory Sporadic.LeechRelated.J2

variable {G : Type*} [Group G] [Finite G]

theorem isEGenerated_of_simple_generalizedFitting
    [IsSimpleGroup (generalizedFitting G)] (e : generalizedFitting G ≃* Carrier) :
    IsEGenerated 2 G := by
  rcases SimpleFittingExtensions.ambient_equiv_cases e with h | h
  · obtain ⟨d⟩ := h
    exact carrier_isEGenerated.map_equiv d.symm
  · obtain ⟨d⟩ := h
    exact extension_isEGenerated.map_equiv d.symm

theorem isEGenerated_of_source {K : GroupClass} (_hSQTK : IsSQTK K G)
    (L : Subgroup G) (hL : L = generalizedFitting G) [IsSimpleGroup L]
    (T : Sylow 2 G) (_hgen : L ⊔ (T : Subgroup G) = ⊤)
    (e : L ≃* Carrier) : IsEGenerated 2 G := by
  subst L
  exact isEGenerated_of_simple_generalizedFitting e

theorem generationParameter_le_two_of_source {K : GroupClass} (hSQTK : IsSQTK K G)
    (L : Subgroup G) (hL : L = generalizedFitting G) [IsSimpleGroup L]
    (T : Sylow 2 G) (hgen : L ⊔ (T : Subgroup G) = ⊤)
    (e : L ≃* Carrier) : generationParameter G ≤ 2 :=
  generationParameter_le (by decide) (isEGenerated_of_source hSQTK L hL T hgen e)

end CFSG.Quasithin.ChapterE.JankoTwo
