module

public import CFSG.Quasithin.ChapterE.Section01.ReverseLift
public import CFSG.Quasithin.ChapterE.Section01.QuotientLifting.Hyperplanes
public import Theory.GroupTheory.PResidual.SylowSupplement

/-!
# Quotient lifting and E-generation

The imported reverse lifting theorem proves E.1.10(7) with the literal
quotient map and intrinsic two-residuals. Its application here places the
two-residual of every quotient E-member in the image of the E-generated
subgroup upstairs. Each odd hyperplane commutator lies in the two-residual
of its local E1-member. Lifting these residuals proves E.1.10(6). The same
hyperplane argument bounds the action commutator of any normal odd-prime
subgroup, as needed in E.1.10(8).

Source: Aschbacher--Smith, *The Classification of Quasithin Groups*,
E.1.10(6)--(7), printed pp.211--212.
-/

public section
open Subgroup
namespace CFSG.Quasithin.ChapterE
variable {G : Type*} [Group G] [Finite G]

/-- The two-residual of a quotient E-member is contained in the image of
the E-generated subgroup with the same actor and rank bound upstairs. -/
theorem IsEMemberAt.quotient_residual_le_map_eSubgroup {i : ℕ} (T : Sylow 2 G)
    (A Y : Subgroup G) [Y.Normal] [IsElementaryAbelian 2 A]
    (hAT : A ≤ (T : Subgroup G)) {I : Subgroup (G ⧸ Y)}
    (hI : IsEMemberAt i ((T : Subgroup G).map (QuotientGroup.mk' Y))
      (A.map (QuotientGroup.mk' Y)) I) :
    (pResidual 2 I).map I.subtype ≤
      (eSubgroup i (T : Subgroup G) A).map (QuotientGroup.mk' Y) := by
  obtain ⟨J, hJ, hres⟩ := hI.exists_quotient_lift T A Y hAT
  rw [← hres]
  exact map_mono ((map_subtype_le (pResidual 2 J)).trans (le_sSup hJ))

private theorem odd_normal_commutator_le_of_residual_le
    {p : ℕ} [Fact p.Prime] (hp : p ≠ 2)
    (T : Sylow 2 G) (X A H : Subgroup G) [X.Normal] (hX : IsPGroup p X)
    [IsElementaryAbelian 2 A] (hAT : A ≤ (T : Subgroup G))
    (hH : ∀ I, IsEMemberAt 1 (T : Subgroup G) A I →
      (pResidual 2 I).map I.subtype ≤ H) : ⁅X,A⁆ ≤ H := by
  rw [← iSup_hyperplane_centralizer_commutator hp X A hX
    (by rw [normalizer_eq_top]; exact le_top)]
  apply iSup₂_le
  intro B hB
  let D := ⁅X ⊓ centralizer (B.map A.subtype : Set G), A⁆
  by_cases he : D = ⊥
  · rw [show ⁅X ⊓ centralizer (B.map A.subtype : Set G), A⁆ = ⊥ from he]
    exact bot_le
  let I := D ⊔ tau (T : Subgroup G) A
  have hI : IsEMemberAt 1 (T : Subgroup G) A I :=
    hyperplane_tau_isEMemberAt hp T X A hX hAT B hB he
  apply le_trans (b := (pResidual 2 I).map I.subtype) _ (hH I hI)
  have hD : IsPGroup p D := hX.to_le
    ((commutator_mono inf_le_left le_rfl).trans (commutator_le_left X A))
  have hres : pResidual 2 D = ⊤ := by
    apply top_unique
    intro d _
    exact mem_pResidual_of_orderOf_coprime
      (hD.orderOf_coprime ((Nat.coprime_primes (Fact.out : p.Prime) Nat.prime_two).mpr hp) d).symm
  have h := map_mono (f := I.subtype) (map_pResidual_le 2 (inclusion (show D ≤ I from le_sup_left)))
  rw [hres, map_map, subtype_comp_inclusion, ← MonoidHom.range_eq_map, range_subtype] at h
  exact h

/-- The action commutator of a normal odd-prime subgroup is generated by E1 members. -/
theorem odd_normal_commutator_le_eSubgroup_one
    {p : ℕ} [Fact p.Prime] (hp : p ≠ 2)
    (T : Sylow 2 G) (X A : Subgroup G) [X.Normal] (hX : IsPGroup p X)
    [IsElementaryAbelian 2 A] (hAT : A ≤ (T : Subgroup G)) :
    ⁅X,A⁆ ≤ eSubgroup 1 (T : Subgroup G) A := by
  exact odd_normal_commutator_le_of_residual_le hp T X A _ hX hAT
    (fun I hI => (map_subtype_le _).trans (le_sSup hI))

/-- E.1.10(6), with the literal quotient map and the source normal section. -/
theorem odd_section_le_eSubgroup_one_sup
    {p : ℕ} [Fact p.Prime] (hp : p ≠ 2)
    (T : Sylow 2 G) (X Y A : Subgroup G) [X.Normal] [Y.Normal]
    (_hYX : Y ≤ X) (hX : IsPGroup p (X ⧸ Y.subgroupOf X))
    [IsElementaryAbelian 2 A] (hAT : A ≤ (T : Subgroup G))
    (hcomm : X.map (QuotientGroup.mk' Y) =
      ⁅X.map (QuotientGroup.mk' Y), A.map (QuotientGroup.mk' Y)⁆) :
    X ≤ eSubgroup 1 (T : Subgroup G) A ⊔ Y := by
  let q := QuotientGroup.mk' Y
  let _ : (X.map q).Normal := Normal.map inferInstance q (QuotientGroup.mk'_surjective Y)
  let _ : IsElementaryAbelian 2 (A.map q) := IsElementaryAbelian.map q
  have hmap : X.map q ≤ (eSubgroup 1 (T : Subgroup G) A).map q := by
    rw [hcomm]
    exact odd_normal_commutator_le_of_residual_le hp
      (T.mapSurjective (f := q) (QuotientGroup.mk'_surjective Y)) (X.map q) (A.map q) _
      (hX.of_equiv (quotientSubgroupRangeEquiv X Y)) (map_mono hAT)
      (fun I hI => hI.quotient_residual_le_map_eSubgroup T A Y hAT)
  have hc := map_le_iff_le_comap.mp hmap
  simpa only [comap_map_eq, q, QuotientGroup.ker_mk'] using hc
/-- Quotient E-members are generated by lifted residuals and the quotient Sylow group. -/
theorem quotient_eSubgroup_le_map_sup_sylow {i : ℕ} (T : Sylow 2 G)
    (A Y : Subgroup G) [Y.Normal] [IsElementaryAbelian 2 A]
    (hAT : A ≤ (T : Subgroup G)) :
    eSubgroup i ((T : Subgroup G).map (QuotientGroup.mk' Y))
      (A.map (QuotientGroup.mk' Y)) ≤
      (eSubgroup i (T : Subgroup G) A ⊔ (T : Subgroup G)).map (QuotientGroup.mk' Y) := by
  apply sSup_le
  intro I hI
  obtain ⟨S, hS⟩ := hI.1.2.2.2.2.1
  have he := congrArg (map I.subtype) (pResidual_sup_sylow_eq_top S)
  rw [Subgroup.map_sup, hS, subgroupOf_map_subtype, ← MonoidHom.range_eq_map, range_subtype] at he
  rw [← he]
  exact sup_le ((hI.quotient_residual_le_map_eSubgroup T A Y hAT).trans (map_mono le_sup_left))
    (inf_le_left.trans (map_mono le_sup_right))

end CFSG.Quasithin.ChapterE
