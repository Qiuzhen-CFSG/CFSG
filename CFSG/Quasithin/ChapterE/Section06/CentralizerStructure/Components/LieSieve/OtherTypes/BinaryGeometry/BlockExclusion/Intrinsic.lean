private theorem not_short_nested {D : Type*} [Group D]
    (W U : Submodule (ZMod 2) (Space 5))
    (hW : W ≠ ⊥ ∧ W ≠ ⊤) (hU : U ≠ ⊥ ∧ U ≠ ⊤) (hWU : W ≤ U)
    (hcomm : BinaryLinear.radical W ⊓ BinaryLinear.radical U ≤
      ⁅BinaryLinear.radical W, BinaryLinear.radical U⁆)
    (f : D →* (BinaryLinear.parabolic W ⊓ BinaryLinear.parabolic U : Subgroup _))
    (hf : Function.Injective f) (hs : f.range.IsSubnormal) : ¬ ChapterC.IsShort D := by
  let : Finite (LinearGroup 5) := Finite.of_injective
    (fun g : LinearGroup 5 => (g : Space 5 → Space 5)) DFunLike.coe_injective
  let P := BinaryLinear.parabolic W ⊓ BinaryLinear.parabolic U
  let R := (BinaryLinear.radical W).subgroupOf P
  let S := (BinaryLinear.radical U).subgroupOf P
  have hRP : BinaryLinear.radical W ≤ P := le_inf
    (BinaryLinear.radical_le_parabolic W) (BinaryLinear.radical_le_nested_parabolic hWU)
  have hSP : BinaryLinear.radical U ≤ P := le_inf
    (BinaryLinear.radical_le_smaller_parabolic hWU) (BinaryLinear.radical_le_parabolic U)
  let : R.Normal := normal_subgroupOf_of_le_normalizer
    ((show P ≤ BinaryLinear.parabolic W from inf_le_left).trans
      (BinaryLinear.parabolic_le_normalizer W))
  let : S.Normal := normal_subgroupOf_of_le_normalizer
    ((show P ≤ BinaryLinear.parabolic U from inf_le_right).trans
      (BinaryLinear.parabolic_le_normalizer U))
  have hmR : R.map P.subtype = BinaryLinear.radical W := map_subgroupOf_eq_of_le hRP
  have hmS : S.map P.subtype = BinaryLinear.radical U := map_subgroupOf_eq_of_le hSP
  have haR : ⁅R, R⁆ = ⊥ := by
    apply map_injective P.subtype_injective
    rw [map_commutator, hmR, BinaryLinear.radical_commutative, Subgroup.map_bot]
  have haS : ⁅S, S⁆ = ⊥ := by
    apply map_injective P.subtype_injective
    rw [map_commutator, hmS, BinaryLinear.radical_commutative, Subgroup.map_bot]
  have central (X : Submodule (ZMod 2) (Space 5)) (hX : X ≠ ⊥ ∧ X ≠ ⊤)
      (hXP : BinaryLinear.radical X ≤ P) :
      centralizer ((BinaryLinear.radical X).subgroupOf P : Set P) ≤
        (BinaryLinear.radical X).subgroupOf P := by
    intro g hg
    apply BinaryLinear.centralizer_radical_le hX.1 hX.2
    rw [mem_centralizer_iff]
    intro r hr
    have hh := mem_centralizer_iff.mp hg (⟨r, hXP hr⟩ : P) hr
    exact congrArg Subtype.val hh
  have hRS : R ⊓ S ≤ ⁅R, S⁆ := by
    apply (map_le_map_iff_of_injective P.subtype_injective).mp
    rw [map_inf _ _ _ P.subtype_injective, map_commutator, hmR, hmS]
    exact hcomm
  exact ChapterC.not_isShort_of_radical_pair R S
    (BinaryLinear.radical_two W).comap_subtype (BinaryLinear.radical_two U).comap_subtype
    haR haS (central W hW hRP) (central U hU hSP) hRS f hf hs

/-- Both reversal-invariant five-dimensional flags exclude every short subnormal embedding. -/
theorem fivePairedParabolic_not_short {D : Type*} [Group D]
    (b : BinaryLinear.FiveFlagGeometry.FiveBasis) (i : Fin 2)
    (f : D →* fivePairedParabolic b i) (hf : Function.Injective f)
    (hs : f.range.IsSubnormal) : ¬ ChapterC.IsShort D := by
  let s : Fin 4 := if i = 0 then 0 else 1
  let t : Fin 4 := if i = 0 then 3 else 2
  let W := BinaryLinear.FiveFlagGeometry.flagSpace b s
  let U := BinaryLinear.FiveFlagGeometry.flagSpace b t
  have hdim (j : Fin 4) : Module.finrank (ZMod 2) (BinaryLinear.FiveFlagGeometry.flagSpace b j) = j.val + 1 :=
    BinaryLinear.InvariantNodeActions.cutSpace_finrank b j
  have hWU : W ≤ U := BinaryLinear.InvariantNodeActions.cutSpace_mono b
    (by dsimp [s, t]; split_ifs <;> decide)
  have hlt : W < U := lt_of_le_of_ne hWU (by
    intro he
    have hh := congrArg (fun X : Submodule (ZMod 2) (Space 5) => Module.finrank (ZMod 2) X) he
    dsimp only [W, U] at hh
    rw [hdim, hdim] at hh
    dsimp [s, t] at hh
    split_ifs at hh <;> norm_num at hh)
  have hcomm : BinaryLinear.radical W ⊓ BinaryLinear.radical U ≤
      ⁅BinaryLinear.radical W, BinaryLinear.radical U⁆ := by
    by_cases hi : i = 0
    · exact BinaryLinear.radical_inf_le_commutator_of_finrank_one
        (by simpa [W, s, hi] using hdim s) hlt
    · exact BinaryLinear.radical_inf_le_commutator_of_finrank_two
        (by simpa [W, s, hi] using hdim s) hlt
  have he : fivePairedParabolic b i = BinaryLinear.parabolic W ⊓ BinaryLinear.parabolic U := by
    dsimp [fivePairedParabolic, W, U, s, t]
    split_ifs <;> ext g <;> simp [BinaryLinear.FiveFlagGeometry.mem_flagStabilizer_iff, BinaryLinear.parabolic, forall_eq_or_imp]
  let e := MulEquiv.subgroupCongr he
  let g := e.toMonoidHom.comp f
  apply not_short_nested W U
    ⟨BinaryLinear.FiveFlagGeometry.flagSpace_ne_bot b s, BinaryLinear.FiveFlagGeometry.flagSpace_ne_top b s⟩
    ⟨BinaryLinear.FiveFlagGeometry.flagSpace_ne_bot b t, BinaryLinear.FiveFlagGeometry.flagSpace_ne_top b t⟩
    hWU hcomm g (e.injective.comp hf)
  rw [MonoidHom.range_comp]
  exact hs.map e.surjective

private theorem linearThree_card : Nat.card (LinearGroup 3) = 168 :=
  (Nat.card_congr (slEquivLinear 3).symm.toEquiv).trans Matrix.PSL3Two.card_SL

/-- A simple Levi factor of order 168 excludes all relatively subnormal chi-zero embeddings. -/
private theorem not_chiZero_of_linearThree_quotient {A D : Type*} [Group A] [Group D]
    (q : A →* LinearGroup 3) (hq : Function.Surjective q) (hk : IsPGroup 2 q.ker)
    (f : D →* A) (hf : Function.Injective f) (hs : f.range.IsSubnormal) :
    ¬ ChapterC.IsChiZeroBlock D := by
  intro hD
  let : IsSimpleGroup (Matrix.ProjectiveSpecialLinearGroup (Fin 3) (ZMod 2)) :=
    Atlas.psl_simple_high_rank (F := ZMod 2) 3 (by decide)
  let : IsSimpleGroup (LinearGroup 3) := linearThreeEquivProjective.isSimpleGroup
  have hcenter : center (LinearGroup 3) = ⊥ := by
    apply eq_bot_iff.mpr
    intro z hz
    have hc : (slEquivLinear 3).symm z ∈ center (Matrix.SpecialLinearGroup (Fin 3) (ZMod 2)) :=
      ((Subgroup.centerCongr (slEquivLinear 3)).symm ⟨z, hz⟩).property
    rw [binary_center_eq_bot (by decide : 0 < 3), mem_bot] at hc
    apply mem_bot.mpr
    apply (slEquivLinear 3).symm.injective
    simpa using hc
  let : Finite (LinearGroup 3) := Finite.of_injective
    (fun g : LinearGroup 3 => (g : Space 3 → Space 3)) DFunLike.coe_injective
  have htwo : ¬ IsPGroup 2 (LinearGroup 3) := by
    intro ht
    obtain ⟨k, hk⟩ := ht.exists_card_dvd_pow
    rw [linearThree_card] at hk
    have hthree : 3 ∣ 2 ^ k := (by decide : 3 ∣ 168).trans hk
    have hh := Nat.prime_three.dvd_of_dvd_pow hthree
    norm_num at hh
  let g : D →* (Fin 1 → LinearGroup 3) := MonoidHom.pi (fun _ => q.comp f)
  have hgker : IsPGroup 2 g.ker := by
    have he : g.ker = q.ker.comap f := by
      ext d
      simp only [MonoidHom.mem_ker, MonoidHom.pi_apply, funext_iff, Pi.one_apply,
        mem_comap, MonoidHom.comp_apply, g, Fin.forall_fin_one]
    rw [he]
    exact hk.comap_of_injective f hf
  have hc : ∀ j, (Pi.evalMonoidHom _ j).comp g = 1 ∨
      Function.Surjective ((Pi.evalMonoidHom _ j).comp g) := by
    intro j
    have hs' : (q.comp f).range.IsSubnormal := by
      rw [MonoidHom.range_comp]
      exact hs.map hq
    rcases hs'.eq_bot_or_top_of_isSimpleGroup inferInstance with ht | ht
    · exact Or.inl (MonoidHom.range_eq_bot_iff.mp ht)
    · exact Or.inr (MonoidHom.range_eq_top.mp ht)
  obtain ⟨e⟩ := hD.chi.short.quotient_equiv_of_simple_coordinates hcenter htwo g hgker hc
  exact Chapter2.ComponentRefinement.LieType.not_chiZero_of_quotient_card_168
    ((Nat.card_congr e.toEquiv).trans linearThree_card) hD

private noncomputable def fourCutCoordinates (b : BinaryLinear.InvariantNodeActions.Basis 3) (j : Fin 3) :
    BinaryLinear.InvariantNodeActions.cutSpace b j ≃ₗ[ZMod 2] Space (j.val + 1) :=
  LinearEquiv.ofFinrankEq _ _ (by rw [BinaryLinear.InvariantNodeActions.cutSpace_finrank, Module.finrank_fin_fun])

private noncomputable def fourQuotientCoordinates (b : BinaryLinear.InvariantNodeActions.Basis 3) (j : Fin 3) :
    (Space 4 ⧸ BinaryLinear.InvariantNodeActions.cutSpace b j) ≃ₗ[ZMod 2] Space (3 - j.val) :=
  LinearEquiv.ofFinrankEq _ _ (by
    rw [Module.finrank_fin_fun]
    have hd := (BinaryLinear.InvariantNodeActions.cutSpace b j).finrank_quotient_add_finrank
    change Module.finrank (ZMod 2) (Space 4 ⧸ BinaryLinear.InvariantNodeActions.cutSpace b j) +
      Module.finrank (ZMod 2) (BinaryLinear.InvariantNodeActions.cutSpace b j) =
        Module.finrank (ZMod 2) (Space 4) at hd
    rw [BinaryLinear.InvariantNodeActions.cutSpace_finrank, Module.finrank_fin_fun] at hd
    omega)

private noncomputable def fourEndQuotientEquiv (b : BinaryLinear.InvariantNodeActions.Basis 3)
    (i : Fin 2) : (fourEndParabolic b i ⧸ pCore 2 (fourEndParabolic b i)) ≃* LinearGroup 3 := by
  let : Unique (LinearGroup 1) :=
    { default := 1
      uniq := fun _g => (slEquivLinear 1).symm.injective (Subsingleton.elim _ _) }
  by_cases hi : i = 0
  · let a : fourEndParabolic b i ≃* BinaryLinear.parabolic (BinaryLinear.InvariantNodeActions.cutSpace b 0) :=
      MulEquiv.subgroupCongr (by simp only [fourEndParabolic, if_pos hi])
    exact (QuotientGroup.congr _ _ a (pCore_map_iso 2 a)).trans
      ((quotientTwoCoreEquivOfCoordinates _ (fourCutCoordinates b 0) (fourQuotientCoordinates b 0)).trans
        (MulEquiv.uniqueProd (N := LinearGroup 1) (M := LinearGroup 3)))
  · let a : fourEndParabolic b i ≃* BinaryLinear.parabolic (BinaryLinear.InvariantNodeActions.cutSpace b 2) :=
      MulEquiv.subgroupCongr (by simp only [fourEndParabolic, if_neg hi])
    exact (QuotientGroup.congr _ _ a (pCore_map_iso 2 a)).trans
      ((quotientTwoCoreEquivOfCoordinates _ (fourCutCoordinates b 2) (fourQuotientCoordinates b 2)).trans
        (MulEquiv.prodUnique (N := LinearGroup 1) (M := LinearGroup 3)))

/-- Either end parabolic of binary four-space excludes every chi-zero subnormal embedding. -/
theorem fourEndParabolic_not_chiZero {D : Type*} [Group D]
    (b : BinaryLinear.InvariantNodeActions.Basis 3) (i : Fin 2)
    (f : D →* fourEndParabolic b i) (hf : Function.Injective f)
    (hs : f.range.IsSubnormal) : ¬ ChapterC.IsChiZeroBlock D := by
  let P := fourEndParabolic b i
  let e := fourEndQuotientEquiv b i
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 P))
  apply not_chiZero_of_linearThree_quotient q
    (e.surjective.comp (QuotientGroup.mk'_surjective _)) _ f hf hs
  have he : q.ker = pCore 2 P := by
    rw [MonoidHom.ker_comp_of_injective _ _ e.injective, QuotientGroup.ker_mk']
  rw [he]
  exact pCore_isPGroup

