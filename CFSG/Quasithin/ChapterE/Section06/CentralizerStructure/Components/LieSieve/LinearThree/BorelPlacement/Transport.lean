module

public import CFSG.Quasithin.ChapterE.Section06.CentralizerStructure.Components.LieSieve.LinearThree.Reduction
public import Theory.GroupTheory.ComponentLocalOrbitEmbedding
public import CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.BlockSelection.Contracts
public import Theory.GroupAction.PerfectCentralQuotient
public import Theory.GroupTheory.PResidual.PrimeToMonotone
public import Theory.AtlasPort.ExceptionalIsomorphisms.Elementary
public import Mathlib.GroupTheory.GroupAction.FixingSubgroup


/-!
# Marked Borel and quotient-residual reductions for E.6.8

The Sylow intersection marks a Borel candidate in the component. Its ambient
normalizer description shows that N_Q(L) preserves it even when Q permutes
components. If this candidate has characteristic two, the component-orbit
centralizer theorem constructs the characteristic-two overgroup generated by
it and Q, to which the full universally quantified E.6.7 input applies.

The central quotient retains both the Sylow marking and the actual intersection
L ∩ M whenever Z(L) is a two-group. The residual is computed inside that
intersection before taking its quotient image. Surjective images preserve the
prime-to-two residual. Since V centralizes that residual and acts nontrivially
on L, faithfulness of the central quotient action for perfect groups gives a
nontrivial automorphism fixing the quotient residual pointwise. This is the
obstruction needed to exclude larger PSL₃ parabolics.

For ordinary PSL₃, the matrix model proves the center trivial and constructs
its central quotient model. No nontriviality assumption is imposed on a
covering center. These are setup and transport results: Borel containment and
the intrinsic residual-fixer calculation remain unproved here.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), E.6.7–8,
printed pp.246–248 (PDF pp.257–259), especially the residual exclusion on p.248.
-/

public section

open Subgroup Theory.GroupTheory
open scoped MatrixGroups
namespace CFSG.Quasithin.ChapterE.Section06.Components.LieSieve.LinearThree.BorelPlacement
variable {G : Type*} [Group G] [Finite G]
variable {K : GroupClass} {T : Sylow 2 G} {M V U L : Subgroup G}

private theorem map_residual_surjective {A D : Type*} [Group A] [Group D]
    [Finite A] (f : A →* D) (hf : Function.Surjective f) :
    (primeToResidual 2 A).map f = primeToResidual 2 D := by
  apply le_antisymm (map_primeToResidual_le f hf)
  let _ : ((primeToResidual 2 A).map f).Normal :=
    Subgroup.Normal.map inferInstance f hf
  apply primeToResidual_le
  exact (primeToResidual_index_coprime (G := A) 2).coprime_dvd_right
    ((primeToResidual 2 A).index_map_dvd hf)

/-- The intersection inside the component, then mapped to the central quotient. -/
@[expose] def quotientIntersection (L M : Subgroup G) : Subgroup (L ⧸ center L) :=
  (M.subgroupOf L).map (QuotientGroup.mk' (center L))

/-- The image of the marked Sylow subgroup in the actual central quotient. -/
@[expose] noncomputable def quotientSylow (S : Sylow 2 L) : Sylow 2 (L ⧸ center L) :=
  S.mapSurjective (f := QuotientGroup.mk' (center L)) (QuotientGroup.mk'_surjective _)

/-- The source Sylow intersection is contained in M inside L. -/
theorem sylow_le_intersection (h : HypothesisE61 K T M V) (S : Sylow 2 L)
    (hS : (S : Subgroup L).map L.subtype = L ⊓ sylowCentralizer (T : Subgroup G) V) :
    (S : Subgroup L) ≤ M.subgroupOf L := by
  intro x hx
  have hxQ := (hS ▸ mem_map_of_mem L.subtype hx).2
  exact h.sylow_le hxQ.1

/-- A two-group center lies in the marked Sylow subgroup and hence in M. -/
theorem center_le_intersection (h : HypothesisE61 K T M V) (S : Sylow 2 L)
    (hS : (S : Subgroup L).map L.subtype = L ⊓ sylowCentralizer (T : Subgroup G) V)
    (hz : IsPGroup 2 (center L)) : center L ≤ M.subgroupOf L :=
  (hz.le_sylow_of_normal S).trans (sylow_le_intersection h S hS)

/-- The quotient intersection has exactly the original intersection as preimage. -/
theorem quotientIntersection_comap (h : HypothesisE61 K T M V) (S : Sylow 2 L)
    (hS : (S : Subgroup L).map L.subtype = L ⊓ sylowCentralizer (T : Subgroup G) V)
    (hz : IsPGroup 2 (center L)) :
    (quotientIntersection L M).comap (QuotientGroup.mk' (center L)) = M.subgroupOf L := by
  apply comap_map_eq_self
  simpa only [QuotientGroup.ker_mk'] using center_le_intersection h S hS hz

/-- The quotient Sylow normalizer lifts to the marked Sylow normalizer. -/
theorem quotient_normalizer_comap (S : Sylow 2 L) (hz : IsPGroup 2 (center L)) :
    (normalizer (quotientSylow S : Set (L ⧸ center L))).comap
      (QuotientGroup.mk' (center L)) = normalizer (S : Set L) := by
  change (normalizer ((S : Subgroup L).map (QuotientGroup.mk' (center L)) :
    Set (L ⧸ center L))).comap (QuotientGroup.mk' (center L)) = _
  rw [comap_normalizer_eq_of_surjective _ (QuotientGroup.mk'_surjective _)]
  rw [comap_map_eq_self (show (QuotientGroup.mk' (center L)).ker ≤ (S : Subgroup L) by
    simpa only [QuotientGroup.ker_mk'] using hz.le_sylow_of_normal S)]
  rfl

omit [Finite G] in
/-- The actual PSL₃ matrix quotient is centerless by perfectness of SL₃. -/
theorem ordinary_center_eq_bot {n : ℕ} (iso : ClassicalGroup.IsPSL L 3 (2 ^ n)) :
    center L = ⊥ := by
  obtain ⟨F, _, _, _, ⟨e⟩⟩ := iso
  let _ := Atlas.sl_perfect (F := F) 3 (by decide)
  have hz : center PSL(3,F) = ⊥ :=
    Group.IsPerfect.center_quotient_center_eq_bot SL(3,F)
  apply (center L).eq_bot_iff_forall.mpr
  intro x hx
  apply e.injective
  rw [map_one]
  have he : e x ∈ center PSL(3,F) := (centerCongr e ⟨x, hx⟩).property
  simpa only [hz, mem_bot] using he

omit [Finite G] in
/-- The trivial center supplies the two-group hypothesis in the ordinary branch. -/
theorem ordinary_center_isTwoGroup {n : ℕ} (iso : ClassicalGroup.IsPSL L 3 (2 ^ n)) :
    IsPGroup 2 (center L) := by
  rw [ordinary_center_eq_bot iso]
  exact IsPGroup.of_bot

omit [Finite G] in
/-- Restrict the obstruction residual to the intersection as a subgroup of L. -/
theorem residual_le_centralizer (hU : U ∈ obstructionFamily M V)
    (hL : ComponentIn (centralizer (U : Set G)) L) :
    (primeToResidual 2 (M.subgroupOf L)).map (M.subgroupOf L).subtype ≤
      (centralizer (V : Set G)).subgroupOf L := by
  let f : M.subgroupOf L →* ↥(L ⊓ M) := {
    toFun x := ⟨x.val, x.val.property, x.property⟩
    map_one' := rfl
    map_mul' _ _ := rfl }
  rintro _ ⟨x,hx,rfl⟩
  exact (component_intersection_residual hU hL.1
    (mem_map_of_mem (L ⊓ M).subtype
      ((map_primeToResidual_le_of_hom 2 f) (mem_map_of_mem f hx)))).2

omit [Finite G] in
/-- Describe the marked Borel using its actual ambient Sylow intersection. -/
theorem markedBorel_eq_relative_normalizer (S : Sylow 2 L) {Q : Subgroup G}
    (hS : (S : Subgroup L).map L.subtype = L ⊓ Q) :
    markedBorel L S = L ⊓ normalizer ((L ⊓ Q : Subgroup G) : Set G) := by
  have hi : (S : Subgroup L) = (L ⊓ Q : Subgroup G).subgroupOf L := by
    rw [← hS, ← comap_subtype, comap_map_eq_self_of_injective L.subtype_injective]
  change (normalizer ((S : Subgroup L) : Set L)).map L.subtype = _
  rw [hi, ← subgroupOf_normalizer_eq inf_le_left,
    subgroupOf_map_subtype, inf_comm]

omit [Finite G] in
/-- Only the stabilizer of L in Q is needed to normalize the marked Borel. -/
theorem markedBorel_stable (S : Sylow 2 L) {Q : Subgroup G}
    (hS : (S : Subgroup L).map L.subtype = L ⊓ Q) :
    Q ⊓ normalizer (L : Set G) ≤ normalizer (markedBorel L S : Set G) := by
  rw [markedBorel_eq_relative_normalizer S hS]
  have hN : Q ⊓ normalizer (L : Set G) ≤
      normalizer ((L ⊓ Q : Subgroup G) : Set G) :=
    (le_inf inf_le_right (inf_le_left.trans Q.le_normalizer)).trans
      inf_normalizer_le_normalizer_inf
  exact (le_inf inf_le_right (hN.trans (normalizer _).le_normalizer)).trans
    inf_normalizer_le_normalizer_inf

/-- Quotient Borel equality lifts to the requested marked ambient equality. -/
theorem quotientIntersection_eq_normalizer_iff
    (h : HypothesisE61 K T M V) (S : Sylow 2 L)
    (hS : (S : Subgroup L).map L.subtype = L ⊓ sylowCentralizer (T : Subgroup G) V)
    (hz : IsPGroup 2 (center L)) :
    quotientIntersection L M = normalizer (quotientSylow S : Set (L ⧸ center L)) ↔
      L ⊓ M = markedBorel L S := by
  have hmap : (M.subgroupOf L).map L.subtype = L ⊓ M := by
    rw [subgroupOf_map_subtype, inf_comm]
  constructor
  · intro he
    have hc := congrArg (Subgroup.comap (QuotientGroup.mk' (center L))) he
    rw [quotientIntersection_comap h S hS hz, quotient_normalizer_comap S hz] at hc
    rw [← hmap, hc]
    rfl
  · intro he
    apply comap_injective (QuotientGroup.mk'_surjective _)
    rw [quotientIntersection_comap h S hS hz, quotient_normalizer_comap S hz]
    apply map_injective L.subtype_injective
    exact hmap.trans he

/-- Borel containment is equivalent upstairs and in the central quotient. -/
theorem quotient_normalizer_le_intersection_iff
    (h : HypothesisE61 K T M V) (S : Sylow 2 L)
    (hS : (S : Subgroup L).map L.subtype = L ⊓ sylowCentralizer (T : Subgroup G) V)
    (hz : IsPGroup 2 (center L)) :
    normalizer (quotientSylow S : Set (L ⧸ center L)) ≤ quotientIntersection L M ↔
      markedBorel L S ≤ M := by
  rw [← comap_le_comap_of_surjective (QuotientGroup.mk'_surjective (center L)),
    quotient_normalizer_comap S hz, quotientIntersection_comap h S hS hz]
  exact (map_le_iff_le_comap : (normalizer (S : Set L)).map L.subtype ≤ M ↔
    normalizer (S : Set L) ≤ M.comap L.subtype).symm

/-- The quotient intersection remains proper because its full preimage is L ∩ M. -/
theorem quotientIntersection_ne_top (h : HypothesisE61 K T M V)
    (earlier : EarlierLocalFacts T) (hU : U ∈ obstructionFamily M V)
    (hL : ComponentIn (centralizer (U : Set G)) L)
    (S : Sylow 2 L)
    (hS : (S : Subgroup L).map L.subtype = L ⊓ sylowCentralizer (T : Subgroup G) V)
    (hz : IsPGroup 2 (center L)) : quotientIntersection L M ≠ ⊤ := by
  intro ht
  have hc := quotientIntersection_comap h S hS hz
  rw [ht, comap_top] at hc
  apply component_not_le h earlier hU hL
  intro x hx
  change (⟨x,hx⟩ : L) ∈ M.subgroupOf L
  rw [← hc]
  trivial

omit [Finite G] in
/-- The ordinary branch supplies a genuine PSL₃ model for its central quotient. -/
theorem ordinary_quotient_model {n : ℕ} (iso : ClassicalGroup.IsPSL L 3 (2 ^ n)) :
    ClassicalGroup.IsPSL (L ⧸ center L) 3 (2 ^ n) := by
  have hz := ordinary_center_eq_bot iso
  obtain ⟨F, hfield, hfinite, hF, ⟨e⟩⟩ := iso
  exact ⟨F, hfield, hfinite, hF,
    ⟨((QuotientGroup.quotientMulEquivOfEq hz).trans QuotientGroup.quotientBot).trans e⟩⟩

/-- A characteristic-two marked Borel generates a characteristic-two subgroup with Q.
The component-orbit theorem allows Q to permute the components. -/
theorem markedBorel_adjoin_characteristicTwo
    (hU : U ∈ obstructionFamily M V)
    (hL : ComponentIn (centralizer (U : Set G)) L)
    (S : Sylow 2 L)
    (hS : (S : Subgroup L).map L.subtype = L ⊓ sylowCentralizer (T : Subgroup G) V)
    (hB : HasCharacteristicTwo (markedBorel L S)) :
    HasCharacteristicTwo ↥(markedBorel L S ⊔ sylowCentralizer (T : Subgroup G) V) := by
  apply (inf_centralizer_pCoreIn_le_iff 2 _).mp
  apply hL.2.relative_local_adjoin_centralizer hL.1 (map_subtype_le _)
    (inf_le_right.trans (Subgroup.centralizer_le hU.1)) (T.isPGroup'.to_le inf_le_left)
    (markedBorel_stable S hS)
  exact (inf_centralizer_pCoreIn_le_iff 2 _).mpr hB

/-- Apply the complete E.6.7 source input to the constructed overgroup.
Characteristic two of the intrinsic Borel remains an explicit model premise. -/
theorem markedBorel_adjoin_decomposition
    (h67 : InvariantSubspaces.BlockSelection.E67Input T M V)
    (hU : U ∈ obstructionFamily M V)
    (hL : ComponentIn (centralizer (U : Set G)) L)
    (S : Sylow 2 L)
    (hS : (S : Subgroup L).map L.subtype = L ⊓ sylowCentralizer (T : Subgroup G) V)
    (hB : HasCharacteristicTwo (markedBorel L S)) :
    Nonempty (InvariantSubspaces.BlockSelection.E67Decomposition
      (sylowCentralizer (T : Subgroup G) V) M V U
      (markedBorel L S ⊔ sylowCentralizer (T : Subgroup G) V)) := by
  apply h67 U hU _ le_sup_right
    (sup_le ((map_subtype_le _).trans hL.1)
      (inf_le_right.trans (Subgroup.centralizer_le hU.1)))
  exact markedBorel_adjoin_characteristicTwo hU hL S hS hB

/-- The actual quotient intersection has a nontrivial pointwise residual fixer.
Perfectness retains the nontrivial V-action after factoring out the center. -/
theorem residual_fixer_ne_bot (h : HypothesisE61 K T M V)
    (earlier : EarlierLocalFacts T) (hU : U ∈ obstructionFamily M V)
    (hL : ComponentIn (centralizer (U : Set G)) L) :
    fixingSubgroup (MulAut (L ⧸ center L))
      ((primeToResidual 2 (quotientIntersection L M)).map
        (quotientIntersection L M).subtype : Set (L ⧸ center L)) ≠ ⊥ := by
  let _ := hL.2.2
  let _ : IsQuasisimple L := IsQuasisimple.of_mulEquiv (subgroupOfEquivOfLe hL.1)
  let hVL := component_normalized_by_V h hU hL
  let ρ := L.normalizerMonoidHom.comp (inclusion hVL)
  let e := MulEquiv.refl (L ⧸ center L)
  let q := QuotientGroup.mk' (center L)
  let qJ := q.subgroupMap (M.subgroupOf L)
  have hfix (v : V) : MulAut.centralQuotientAction e (ρ v) ∈
      fixingSubgroup (MulAut (L ⧸ center L))
        ((primeToResidual 2 (quotientIntersection L M)).map
          (quotientIntersection L M).subtype : Set (L ⧸ center L)) := by
    rw [mem_fixingSubgroup_iff]
    rintro _ ⟨x,hx,rfl⟩
    have hres := map_residual_surjective qJ (q.subgroupMap_surjective (M.subgroupOf L))
    obtain ⟨y,hy,rfl⟩ := hres.symm ▸ hx
    change MulAut.centralQuotientAction e (ρ v) (e (q (y : L))) = e (q (y : L))
    rw [MulAut.centralQuotientAction_apply]
    congr 2
    apply Subtype.ext
    have hc := residual_le_centralizer hU hL (mem_map_of_mem (M.subgroupOf L).subtype hy)
    change (v : G) * ((y : L) : G) * (v : G)⁻¹ = ((y : L) : G)
    have hc' : (v : G) * ((y : L) : G) = ((y : L) : G) * v :=
      (mem_centralizer_iff.mp hc) v v.property
    rw [hc', mul_inv_cancel_right]
  intro hbot
  have hV : V ≤ centralizer (L : Set G) := by
    intro v hv
    have ha : MulAut.centralQuotientAction e (ρ ⟨v,hv⟩) = 1 :=
      mem_bot.mp (hbot ▸ hfix ⟨v,hv⟩)
    have hb : ρ ⟨v,hv⟩ = 1 := MulAut.centralQuotientAction_injective e
      (ha.trans (map_one (MulAut.centralQuotientAction e)).symm)
    change L.normalizerMonoidHom (inclusion hVL ⟨v,hv⟩) = 1 at hb
    rw [← MonoidHom.mem_ker, normalizerMonoidHom_ker] at hb
    exact hb
  exact component_not_le h earlier hU hL ((le_centralizer_iff.mp hV).trans h.centralizer_le)

end CFSG.Quasithin.ChapterE.Section06.Components.LieSieve.LinearThree.BorelPlacement
