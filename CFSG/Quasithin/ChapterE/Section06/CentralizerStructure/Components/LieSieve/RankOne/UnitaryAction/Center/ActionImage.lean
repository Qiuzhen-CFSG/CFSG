module
public import CFSG.Quasithin.ChapterE.Section06.CentralizerStructure.Components.LieSieve.RankOne.UnitaryAction.Transport

/-!
# Identifying an induced action from its torus parameters

A subgroup fixing W pointwise contributes nothing to the induced conjugation
group. If it and a parametrized torus generate the actors, the torus covers
the whole induced group. Matching its pointwise kernel with the kernel of a
surjective homomorphism then identifies the induced group by the first
isomorphism theorem. The unitary application uses the inverse field norm.

Source: the root–torus calculation of Huppert II.10.12 used in
Aschbacher–Smith E.6.8(1), printed pp.247–248.
-/

public section
open Subgroup
namespace CFSG.Quasithin.ChapterE.Section06.Components.LieSieve.RankOne.UnitaryAction
variable {G D K : Type*} [Group G] [Group D] [Group K]

private noncomputable def centerActor (W B : Subgroup G)
    (hB : B ≤ normalizer (W : Set G)) : B →* inducedAutomizer W B :=
  (W.normalizerMonoidHom.rangeRestrict.subgroupMap
    (B.subgroupOf (normalizer (W : Set G)))).comp
      (subgroupOfEquivOfLe hB).symm.toMonoidHom

private theorem centerActor_surjective (W B : Subgroup G)
    (hB : B ≤ normalizer (W : Set G)) : Function.Surjective (centerActor W B hB) :=
  (MonoidHom.subgroupMap_surjective _ _).comp (subgroupOfEquivOfLe hB).symm.surjective

private theorem centerActor_eq_one_iff (W B : Subgroup G)
    (hB : B ≤ normalizer (W : Set G)) (b : B) :
    centerActor W B hB b = 1 ↔ (b : G) ∈ centralizer (W : Set G) := by
  constructor
  · intro he
    have he' : W.normalizerMonoidHom ⟨b, hB b.property⟩ = 1 :=
      congrArg (fun z => z.val.val) he
    change (⟨b, hB b.property⟩ : normalizer (W : Set G)) ∈ W.normalizerMonoidHom.ker at he'
    rwa [normalizerMonoidHom_ker] at he'
  · intro hb
    apply Subtype.ext
    apply Subtype.ext
    change (⟨b, hB b.property⟩ : normalizer (W : Set G)) ∈ W.normalizerMonoidHom.ker
    rwa [normalizerMonoidHom_ker]

/-- When a group is generated by a subgroup fixing W and a parametrized torus,
the torus supplies the whole induced action. Matching its kernel with a
surjective homomorphism identifies the actual induced group. -/
theorem exists_inducedEquiv_of_torus
    (W R B : Subgroup G) (t : D →* G) (v : D →* K)
    (hv : Function.Surjective v)
    (hB : B ≤ normalizer (W : Set G))
    (hgen : B = R ⊔ t.range)
    (hR : R ≤ centralizer (W : Set G))
    (hker : ∀ d, t d ∈ centralizer (W : Set G) ↔ v d = 1) :
    Nonempty (inducedAutomizer W B ≃* K) := by
  let a := centerActor W B hB
  have htB : ∀ d, t d ∈ B := by
    intro d
    rw [hgen]
    exact (show t.range ≤ R ⊔ t.range from le_sup_right) ⟨d, rfl⟩
  let tB : D →* B := t.codRestrict B htB
  let f := a.comp tB
  have hf : Function.Surjective f := by
    let C : Subgroup B := f.range.comap a
    have hcover : B ≤ C.map B.subtype := by
      apply le_trans (le_of_eq hgen)
      apply sup_le
      · intro r hr
        have hrB : r ∈ B := by rw [hgen]; exact (show R ≤ R ⊔ t.range from le_sup_left) hr
        refine ⟨⟨r, hrB⟩, ?_, rfl⟩
        change a ⟨r, hrB⟩ ∈ f.range
        rw [(centerActor_eq_one_iff W B hB _).mpr (hR hr)]
        exact f.range.one_mem
      · rintro _ ⟨d, rfl⟩
        exact ⟨tB d, ⟨d, rfl⟩, rfl⟩
    intro x
    obtain ⟨b, rfl⟩ := centerActor_surjective W B hB x
    obtain ⟨c, hc, he⟩ := hcover b.property
    have hcb : c = b := Subtype.ext he
    subst c
    exact hc
  have hk : f.ker = v.ker := by
    ext d
    exact (centerActor_eq_one_iff W B hB (tB d)).trans (hker d)
  exact ⟨(QuotientGroup.quotientKerEquivOfSurjective f hf).symm.trans
    ((QuotientGroup.quotientMulEquivOfEq hk).trans
      (QuotientGroup.quotientKerEquivOfSurjective v hv))⟩

end CFSG.Quasithin.ChapterE.Section06.Components.LieSieve.RankOne.UnitaryAction
