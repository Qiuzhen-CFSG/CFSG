module

public import CFSG.Quasithin.ChapterE.Section06.CentralizerStructure.Components.RemainingSieve.Sporadic.SeedTransport
public import Theory.Mathieu.M12.BlockGeometry
public import Theory.Mathieu.M12.SmallParabolicPair.ThreeResidualFixer

/-!
# The original M₁₂ exclusion in E.6.8

The second M₁₂ parabolic is invariant under the stabilizer of a Sylow
subgroup. Its checked abelian-square control excludes all subnormal short
groups in the lifted component-orbit overgroup. E.6.7 therefore places that
lift in M. The parabolic is generated by two-elements, since its full
quotient by O₂ is S₃. Consequently the source O^{2′}(L∩M) condition makes V
fix it pointwise. Its checked automorphism fixer is trivial, contradicting
the nontrivial component action. Central two-covers and the original Q are
retained throughout; no ambient involution-centralizer containment is used.

Source: Aschbacher–Smith, E.6.8, printed p.248 (PDF p.259), and GLS3
Table 5.3b, the (4 × 4).D₁₂ local of M₁₂.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterE.Section06.Components.RemainingSieve.Sporadic
open _root_.Sporadic.Mathieu _root_.Sporadic.Mathieu.M12SmallPair

private theorem symmetricThree_residual : primeToResidual 2 (Equiv.Perm (Fin 3)) = ⊤ := by
  apply top_unique
  intro x _
  refine Equiv.Perm.swap_induction_on x (primeToResidual 2 _).one_mem ?_
  intro y a b _ hy
  apply (primeToResidual 2 _).mul_mem _ hy
  apply mem_primeToResidual_of_pow (n := 1)
  simp [pow_two]

/-- The whole second parabolic is generated by its two-elements. -/
theorem m12_second_primeToResidual : primeToResidual 2 secondParabolic = ⊤ := by
  apply primeToResidual_top_of_two_kernel ValueBoundParabolics.secondQuotientMap
    ValueBoundParabolics.secondQuotientMap_surjective _ symmetricThree_residual
  rw [← ValueBoundParabolics.second_pCore_eq_kernel]
  exact pCore_isPGroup

/-- Native invariant seeds for any prescribed Sylow subgroup. Both the model
isomorphism and the ambient automorphism fixer use the same conjugation. -/
theorem m12_invariant_seed (R : Sylow 2 M12) :
    ∃ P : Subgroup M12, ∃ _b : P ≃* secondParabolic,
      (∀ a : MulAut M12, (R : Subgroup M12).map a.toMonoidHom = R →
        P.map a.toMonoidHom = P) ∧
      primeToResidual 2 P = ⊤ ∧
      (∀ a : MulAut M12, (∀ p ∈ P, a p = p) → a = 1) := by
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq M12 commonSylow R
  let e := MulAut.conj g
  let P := secondParabolic.map e.toMonoidHom
  let b : P ≃* secondParabolic := (e.subgroupMap secondParabolic).symm
  have hR : sylowCandidate.map e.toMonoidHom = (R : Subgroup M12) := by
    change ((g • commonSylow : Sylow 2 M12) : Subgroup M12) = R
    rw [hg]
  have hRinv : (R : Subgroup M12).map e.symm.toMonoidHom = sylowCandidate := by
    rw [← hR]
    simp [map_map]
  have pullback (a : MulAut M12) (W : Subgroup M12) :
      W.map (e.trans (a.trans e.symm)).toMonoidHom =
        ((W.map e.toMonoidHom).map a.toMonoidHom).map e.symm.toMonoidHom := by
    rw [map_map, map_map]
    rfl
  refine ⟨P, b, ?_, ?_, ?_⟩
  · intro a ha
    let a' : MulAut M12 := e.trans (a.trans e.symm)
    have hs : sylowCandidate.map a'.toMonoidHom = sylowCandidate := by
      rw [pullback, hR, ha, hRinv]
    apply map_injective (f := e.symm.toMonoidHom) e.symm.injective
    change ((secondParabolic.map e.toMonoidHom).map a.toMonoidHom).map e.symm.toMonoidHom =
      (secondParabolic.map e.toMonoidHom).map e.symm.toMonoidHom
    rw [← pullback, BlockGeometry.secondParabolic_invariant a' hs]
    simp [map_map]
  · apply map_injective (f := b.toMonoidHom) b.injective
    rw [map_primeToResidual b, m12_second_primeToResidual, map_top_of_surjective _ b.surjective]
  · intro a ha
    let a' : MulAut M12 := e.trans (a.trans e.symm)
    have ht : a' = 1 := eq_one_of_fixes_second_threeResidual a' (by
      intro p hp
      have hpP : p ∈ secondParabolic := map_subtype_le _ hp
      change e.symm (a (e p)) = p
      have he : a (e p) = e p := ha _ (mem_map_of_mem e.toMonoidHom hpP)
      rw [he, e.symm_apply_apply])
    apply MulEquiv.ext
    intro p
    have he := DFunLike.congr_fun ht (e.symm p)
    change e.symm (a (e (e.symm p))) = e.symm p at he
    rw [e.apply_symm_apply] at he
    exact e.symm.injective he

variable {G : Type*} [Group G] [Finite G]
variable {K : GroupClass} {T : Sylow 2 G} {M V U L : Subgroup G}

/-- The M₁₂ quotient is excluded from the original E.6.8 component. All
intrinsic local, block, generation and residual-fixer premises are discharged. -/
theorem m12_excluded (h : HypothesisE61 K T M V) (earlier : EarlierLocalFacts T)
    (h67 : InvariantSubspaces.BlockSelection.E67Input T M V)
    (hU : U ∈ obstructionFamily M V)
    (hL : ComponentIn (centralizer (U : Set G)) L)
    (e : (L ⧸ pCore 2 L) ≃* M12) : False := by
  obtain ⟨S, hS⟩ := component_sylow_intersection h hU hL
  let R := S.mapSurjective (f := modelMap e) (modelMap_surjective e)
  obtain ⟨P,b,hinv,hres,hfix⟩ := m12_invariant_seed R
  have hplace := seedLift_le_M_of_squareControl h67 hU hL e m12_center_eq_bot S hS
    P hinv b SecondSquareControl.control
  exact false_of_seedLift_le_M h earlier hU hL e P hplace hres hfix

end CFSG.Quasithin.ChapterE.Section06.Components.RemainingSieve.Sporadic
