module
public import CFSG.Quasithin.ChapterE.Section06.CentralizerStructure.Components.RemainingSieve.Sporadic.CentralPlacement
public import CFSG.Quasithin.Chapter2.Section01To03.ComponentRefinement.SurvivingIntersections.MathieuTwentyTwo.HexadLocals.BlockExclusion
public import CFSG.Quasithin.Chapter2.Section01To03.ComponentRefinement.SurvivingIntersections.MathieuTwentyThree.BlockOrders
import all CFSG.Quasithin.Chapter2.Section01To03.ComponentRefinement.SporadicExclusions.M24.BlockObstruction.Octad

/-!
# The alternating local quotients used by the M₂₂ and M₂₃ source exclusions

The native hexad and heptad stabilizers have two-kernel quotients A₆ and A₇.
Neither order occurs among chi-zero block quotients. The existing central
coordinate argument identifies any putative block quotient with this simple
alternating quotient. Both locals are generated by two-elements, since their
simple even quotient and complete two-kernel are so generated.
The internal import shares the original simple-coordinate proof with the
M₂₄ octad calculation, without importing its stronger ambient setup.

Source: Aschbacher–Smith E.6.8, printed p.248; 2.3.9(7)(f), pp.525–526.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterE.Section06.Components.RemainingSieve.Sporadic

private theorem alternating_card {n : ℕ} (hn : n = 6 ∨ n = 7) :
    Nat.card (alternatingGroup (Fin n)) = 360 ∨ Nat.card (alternatingGroup (Fin n)) = 2520 := by
  rcases hn with rfl | rfl
  · left; rw [nat_card_alternatingGroup]; norm_num
  · right; rw [nat_card_alternatingGroup]; norm_num

theorem no_chiZero_central_coordinates_alternating {B P : Type*} [Group B] [Group P] [Finite P]
    (hB : ChapterC.IsChiZeroBlock B) {n : ℕ} (hn : n = 6 ∨ n = 7)
    (f : P →* alternatingGroup (Fin n)) (hf : Function.Surjective f) (hk : IsPGroup 2 f.ker)
    {k : ℕ} (q : B →* (Fin k → P)) (hqc : q.ker ≤ center B) (hqs : q.range.IsSubnormal) : False := by
  have hn5 : 5 ≤ n := by omega
  let : IsSimpleGroup (alternatingGroup (Fin n)) := alternatingGroup.isSimpleGroup (by simpa)
  have htwo : ¬ IsPGroup 2 (alternatingGroup (Fin n)) := by
    intro hp
    obtain ⟨k,hk⟩ := hp.exists_card_dvd_pow
    have hd : 3 ∣ Nat.card (alternatingGroup (Fin n)) := by
      rcases alternating_card hn with h | h <;> rw [h] <;> decide
    exact (by decide : ¬ 3 ∣ 2) (Nat.prime_three.dvd_of_dvd_pow (hd.trans hk))
  obtain ⟨e⟩ := Chapter2.ComponentRefinement.M24Exclusion.quotient_equiv_of_central_coordinates
    hB.chi.short (alternatingGroup.center_eq_bot (by simpa using (show 4 ≤ n by omega)))
    htwo q hqc hqs f hf hk
  have hc := Nat.card_congr e.toEquiv
  rcases alternating_card hn with h | h
  · exact Chapter2.ComponentRefinement.not_chiZero_of_quotient_card_360
      (hc.trans h) hB
  · exact Chapter2.ComponentRefinement.not_chiZero_of_quotient_card_2520 (hc.trans h) hB

theorem primeToResidual_top_of_alternating_two_kernel {P : Type*} [Group P] [Finite P]
    {n : ℕ} (hn : n = 6 ∨ n = 7)
    (f : P →* alternatingGroup (Fin n)) (hf : Function.Surjective f) (hk : IsPGroup 2 f.ker) :
    primeToResidual 2 P = ⊤ := by
  have hn5 : 5 ≤ n := by omega
  let : IsSimpleGroup (alternatingGroup (Fin n)) := alternatingGroup.isSimpleGroup (by simpa)
  apply primeToResidual_top_of_two_kernel f hf hk
  rcases (inferInstance : (primeToResidual 2 (alternatingGroup (Fin n))).Normal).eq_bot_or_eq_top with h | h
  · have hp := primeToResidual_index_coprime (G := alternatingGroup (Fin n)) 2
    rw [h, index_bot] at hp
    have hd : 2 ∣ Nat.card (alternatingGroup (Fin n)) := by
      rcases alternating_card hn with h | h <;> rw [h] <;> decide
    exact ((Nat.prime_two.coprime_iff_not_dvd.mp hp) hd).elim
  · exact h
end CFSG.Quasithin.ChapterE.Section06.Components.RemainingSieve.Sporadic
