/-!
# The original Rudvalis exclusion in E.6.8

The actual max4 local has intrinsic quotient PSL₃(2). Its Sylow-invariant
conjugate therefore satisfies the proved linear-three block obstruction,
so E.6.7 places the full covering lift in M. The quotient and its two-core
make the entire local generated by two-elements. The original residual
condition makes the marked involution fix it, contradicting its checked
generation with the actual involution centralizer.

The native generation theorem's simplicity hypothesis is supplied by the
source component, not by a separate classification assumption. The quotient
has trivial two-core; its center embeds in the known two-group center of
max6 and is therefore trivial. Quasisimplicity of the source component then
identifies its central quotient with the original Rudvalis carrier. The
full central covering two-kernel is retained throughout.

Source: Aschbacher–Smith E.6.8, printed p.248 (PDF p.259), GLS3 Table 5.3r
and its max4 justification, pp.291–292.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterE.Section06.Components.RemainingSieve.Sporadic
open _root_.Rudvalis
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {M V U L : Subgroup G}

private theorem rudvalis_model_center (e : (L ⧸ pCore 2 L) ≃* Model) :
    center Model = ⊥ := by
  have he := pCore_map_iso 2 e
  rw [pCore_quotient_pCore_eq_bot, Subgroup.map_bot] at he
  have hle : center Model ≤ SylowOvergroups.max6 := by
    rw [LowCentralizers.max6_eq_centralizer]
    exact center_le_centralizer _
  let f : center Model →* center SylowOvergroups.max6 := {
    toFun x := ⟨⟨x, hle x.property⟩, mem_center_iff.mpr (fun y =>
      Subtype.ext (mem_center_iff.mp x.property y))⟩
    map_one' := rfl
    map_mul' _ _ := rfl }
  have hf : Function.Injective f := by
    intro x y he
    exact Subtype.ext (congrArg (fun t : center SylowOvergroups.max6 => t.val.val) he)
  have hp : IsPGroup 2 (center Model) := LowCentralizers.max6_center_isPGroup.of_injective f hf
  exact le_bot_iff.mp ((show center Model ≤ pCore 2 Model from
    le_sSup ⟨inferInstance, hp⟩).trans he.symm.le)

private theorem rudvalis_model_simple (hL : ComponentIn (centralizer (U : Set G)) L)
    (e : (L ⧸ pCore 2 L) ≃* Model) : IsSimpleGroup Model := by
  let _ := hL.2.2
  let _ : IsQuasisimple L := IsQuasisimple.of_mulEquiv (subgroupOfEquivOfLe hL.1)
  have hZ : center L = pCore 2 L := by
    apply le_antisymm _ (IsQuasisimple.pCore_le_center 2)
    intro x hx
    rw [← modelMap_ker e]
    apply MonoidHom.mem_ker.mpr
    have hc : modelMap e x ∈ center Model := by
      apply mem_center_iff.mpr
      intro y
      obtain ⟨y,rfl⟩ := modelMap_surjective e y
      simpa only [map_mul] using congrArg (modelMap e) (mem_center_iff.mp hx y)
    simpa only [rudvalis_model_center e, mem_bot] using hc
  let d : (L ⧸ center L) ≃* Model :=
    (QuotientGroup.quotientMulEquivOfEq hZ).trans e
  let _ : IsSimpleGroup (L ⧸ center L) := IsQuasisimple.simple
  exact (MulEquiv.isSimpleGroup_congr d).mp inferInstance

variable {K : GroupClass} {z : G}
open Chapter15.Section03.Candidates.ComponentStructure
open Chapter2.ComponentRefinement.RudvalisCase.CentralizerGeometry

theorem rudvalis_excluded (h : HypothesisE61 K T M V)
    (h67 : InvariantSubspaces.BlockSelection.E67Input T M V)
    (hU : U ∈ obstructionFamily M V)
    (hL : ComponentIn (centralizer (U : Set G)) L)
    (hz : z ∈ sylowFixedSpace (T : Subgroup G) V)
    (α : MulAut L) (hα : ∀ x : L, (α x : G) = z * (x : G) * z⁻¹)
    (ha : TwoCentralInner α) (e : (L ⧸ pCore 2 L) ≃* Model) : False := by
  let _ : IsSimpleGroup Model := rudvalis_model_simple hL e
  obtain ⟨S,hS⟩ := component_sylow_intersection h hU hL
  let R := S.mapSurjective (f := modelMap e) (modelMap_surjective e)
  let a := modelAction e α
  have ho : orderOf a = 2 :=
    (orderOf_injective (modelAction e) (modelAction_injective hL e) α).trans ha.2.1
  have hi : a ∈ (MulAut.conj (G := Model)).range := by
    obtain ⟨l,hl⟩ := ha.1
    exact ⟨modelMap e l, by dsimp [a]; rw [← hl, modelAction_conj]⟩
  obtain ⟨s⟩ := nonempty_modelSeed (rudvalis_model_center e) R a ho hi
    (modelAction_fixed_sylow e hz α hα S hS)
  let qP := ((LocalCoreTransport.quotientEquiv 2 s.modelIso).trans
    CoreQuotients.max4QuotientEquiv).trans Matrix.PSL3Two.equiv.symm
  have hplace := seedLift_le_M_of_linearThreeQuotient h67 hU hL e S hS
    s.localSubgroup s.invariant s.selfCentralizing qP
  exact false_of_seedLift_and_generation hU hL e s.localSubgroup hplace
    (primeToResidual_top_of_linearThreeQuotient qP) hz.1 α hα ha.2.1 s.generated
end CFSG.Quasithin.ChapterE.Section06.Components.RemainingSieve.Sporadic
