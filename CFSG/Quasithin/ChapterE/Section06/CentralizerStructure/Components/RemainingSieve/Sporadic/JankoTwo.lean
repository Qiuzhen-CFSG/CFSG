public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.ExceptionalParabolics.CubicBlockGeometry

/-!
# The original Hall–Janko exclusion in E.6.8

The canonical local is the normal closure of the prescribed Sylow subgroup
inside its second radical normalizer. Its actual quotient is S₃, so the
whole local is generated by two-elements. The full normalizer's proved
subnormal-order calculation excludes all chi-zero blocks after central-kernel
component-orbit transport. E.6.7 therefore places the original local lift
in M, and the source residual condition makes the marked involution fix it.
The native local and its involution centralizer generate J₂, contradicting
the nontrivial original action. The original pair, quotient, Sylow subgroup
and complete two-kernel are preserved throughout.

Source: Aschbacher–Smith E.6.8, printed p.248 (PDF p.259); GLS3 Table 5.3g.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterE.Section06.Components.RemainingSieve.Sporadic
open _root_.Sporadic.LeechRelated.J2 _root_.Sporadic.LeechRelated.J2.ExceptionalParabolics
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {M V U L : Subgroup G}

private theorem symmetricThree_residual : primeToResidual 2 (Equiv.Perm (Fin 3)) = ⊤ := by
  apply top_unique
  intro x _
  refine Equiv.Perm.swap_induction_on x (primeToResidual 2 _).one_mem ?_
  intro y a b _ hy
  apply (primeToResidual 2 _).mul_mem _ hy
  apply mem_primeToResidual_of_pow (n := 1)
  simp [pow_two]

theorem primeToResidual_top_of_symmetricThreeQuotient {P : Type*} [Group P] [Finite P]
    (e : (P ⧸ pCore 2 P) ≃* Equiv.Perm (Fin 3)) : primeToResidual 2 P = ⊤ := by
  let f := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 P))
  apply primeToResidual_top_of_two_kernel f
    (e.surjective.comp (QuotientGroup.mk'_surjective _)) _ symmetricThree_residual
  have he : f.ker = pCore 2 P := by
    rw [MonoidHom.ker_comp_of_injective _ _ e.injective, QuotientGroup.ker_mk']
  rw [he]
  exact pCore_isPGroup

variable {K : GroupClass} {z : G}
open Chapter15.Section03.Candidates.ComponentStructure

theorem jankoTwo_excluded (h : HypothesisE61 K T M V)
    (h67 : InvariantSubspaces.BlockSelection.E67Input T M V)
    (hU : U ∈ obstructionFamily M V)
    (hL : ComponentIn (centralizer (U : Set G)) L)
    (hz : z ∈ sylowFixedSpace (T : Subgroup G) V)
    (α : MulAut L) (hα : ∀ x : L, (α x : G) = z * (x : G) * z⁻¹)
    (ha : TwoCentralInner α) (e : (L ⧸ pCore 2 L) ≃* Carrier) : False := by
  obtain ⟨S,hS⟩ := component_sylow_intersection h hU hL
  let R := S.mapSurjective (f := modelMap e) (modelMap_surjective e)
  let a := modelAction e α
  have ho : orderOf a = 2 :=
    (orderOf_injective (modelAction e) (modelAction_injective hL e) α).trans ha.2.1
  have hi : a ∈ (MulAut.conj (G := Carrier)).range := by
    obtain ⟨l,hl⟩ := ha.1
    exact ⟨modelMap e l, by dsimp [a]; rw [← hl, modelAction_conj]⟩
  obtain ⟨s⟩ := CubicBlockGeometry.seed R a ho hi
    (modelAction_fixed_sylow e hz α hα S hS)
  have hplace := seedLift_le_M_of_largeOrders h67 hU hL e BlockGeometry.center_eq_bot
    S hS s.localSubgroup s.invariant s.selfCentralizing s.modelIso
    CubicBlockGeometry.subnormal_orders
  obtain ⟨q⟩ := SecondParabolic.l₂_quotient
  let qP := (LocalCoreTransport.quotientEquiv 2 s.modelIso).trans q
  exact false_of_seedLift_and_generation hU hL e s.localSubgroup hplace
    (primeToResidual_top_of_symmetricThreeQuotient qP) hz.1 α hα ha.2.1 s.generated
end CFSG.Quasithin.ChapterE.Section06.Components.RemainingSieve.Sporadic
