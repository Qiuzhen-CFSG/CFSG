module

public import CFSG.Quasithin.ChapterE.Section06.CentralizerStructure.Components.RemainingSieve.Sporadic.SeedTransport
public import CFSG.Quasithin.ChapterE.Section06.CentralizerStructure.Components.RemainingSieve.SourceInputs

/-!
# The source involution on a placed sporadic seed

The actual conjugation action descends through the retained two-core and fixes
the image of L∩Q pointwise. A placed seed generated by two-elements lies in
the actual O^{2′}(L∩M), so the source involution fixes that seed as well.
If the seed generates the model with the involution fixed subgroup, the
quotient action is trivial. Perfectness then contradicts its order two.
This is the residual step of E.6.8, printed p.248 (PDF p.259).
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterE.Section06.Components.RemainingSieve.Sporadic
variable {G A : Type*} [Group G] [Finite G] [Group A]
variable {T : Sylow 2 G} {M V U L : Subgroup G} {z : G}

omit [Finite G] in
/-- The quotient action sends an inner automorphism to its actual inner image. -/
theorem modelAction_conj (e : (L ⧸ pCore 2 L) ≃* A) (x : L) :
    modelAction e (MulAut.conj x) = MulAut.conj (modelMap e x) := by
  apply MulEquiv.ext
  intro y
  obtain ⟨l, rfl⟩ := modelMap_surjective e y
  rw [modelAction_apply]
  simp only [MulAut.conj_apply, map_mul, map_inv]

omit [Finite G] in
/-- The original source fixed point fixes the quotient Sylow pointwise. -/
theorem modelAction_fixed_sylow (e : (L ⧸ pCore 2 L) ≃* A)
    (hz : z ∈ sylowFixedSpace (T : Subgroup G) V)
    (α : MulAut L) (hα : ∀ x : L, (α x : G) = z * (x : G) * z⁻¹)
    (S : Sylow 2 L)
    (hS : (S : Subgroup L).map L.subtype = L ⊓ sylowCentralizer (T : Subgroup G) V) :
    ∀ x ∈ (S : Subgroup L).map (modelMap e), modelAction e α x = x := by
  rintro x ⟨l,hl,rfl⟩
  rw [modelAction_apply]
  congr 1
  apply Subtype.ext
  rw [hα]
  have ht : (l : G) ∈ (T : Subgroup G) := (hS ▸ mem_map_of_mem L.subtype hl).2.1
  rw [← hz.2 l ht, mul_inv_cancel_right]

/-- A placed seed generated by two-elements is fixed by the original action. -/
theorem modelAction_fixes_placed_seed
    (hU : U ∈ obstructionFamily M V)
    (hL : ComponentIn (centralizer (U : Set G)) L)
    (e : (L ⧸ pCore 2 L) ≃* A) (P : Subgroup A)
    (hplace : seedLift e P ≤ M) (hres : primeToResidual 2 P = ⊤)
    (hz : z ∈ V) (α : MulAut L)
    (hα : ∀ x : L, (α x : G) = z * (x : G) * z⁻¹) :
    ∀ p ∈ P, modelAction e α p = p := by
  have hr : primeToResidual 2 (seedLift e P) = ⊤ :=
    primeToResidual_top_of_two_kernel (seedProjection e P)
      (seedProjection_surjective e P) (seedProjection_ker_two e P) hres
  have hc : seedLift e P ≤ centralizer (V : Set G) := by
    let f : seedLift e P →* (L ⊓ M : Subgroup G) :=
      inclusion (le_inf (seedLift_le e P) hplace)
    intro x hx
    have hxR : (⟨x,hx⟩ : seedLift e P) ∈ primeToResidual 2 (seedLift e P) := by
      rw [hr]
      trivial
    exact (component_intersection_residual hU hL.1
      (mem_map_of_mem (L ⊓ M).subtype ((map_primeToResidual_le_of_hom 2 f)
        (mem_map_of_mem f hxR)))).2
  intro p hp
  obtain ⟨x,hx⟩ := seedProjection_surjective e P ⟨p,hp⟩
  have he : modelMap e (inclusion (seedLift_le e P) x) = p := congrArg Subtype.val hx
  rw [← he, modelAction_apply]
  congr 1
  apply Subtype.ext
  rw [hα]
  change z * (x : G) * z⁻¹ = (x : G)
  rw [hc x.property z hz, mul_inv_cancel_right]

/-- The fixed-subgroup generation identity replaces an unproved global
centralizer containment or an unrelated automorphism-fixer assumption. -/
theorem false_of_seedLift_and_generation
    (hU : U ∈ obstructionFamily M V)
    (hL : ComponentIn (centralizer (U : Set G)) L)
    (e : (L ⧸ pCore 2 L) ≃* A) (P : Subgroup A)
    (hplace : seedLift e P ≤ M) (hres : primeToResidual 2 P = ⊤)
    (hz : z ∈ V) (α : MulAut L)
    (hα : ∀ x : L, (α x : G) = z * (x : G) * z⁻¹) (ho : orderOf α = 2)
    (hgen : (modelAction e α).fixedSubgroup ⊔ P = ⊤) : False := by
  have hp : P ≤ (modelAction e α).fixedSubgroup := by
    intro p hp
    exact (MulAut.mem_fixedSubgroup _ _).mpr
      (modelAction_fixes_placed_seed hU hL e P hplace hres hz α hα p hp)
  have hf : (modelAction e α).fixedSubgroup = ⊤ := by
    rwa [sup_eq_left.mpr hp] at hgen
  have hq : modelAction e α = 1 := by
    apply MulEquiv.ext
    intro x
    exact (MulAut.mem_fixedSubgroup _ _).mp (hf.symm ▸ mem_top x)
  have ha : α = 1 := modelAction_injective hL e (hq.trans (map_one _).symm)
  rw [ha, orderOf_one] at ho
  omega

end CFSG.Quasithin.ChapterE.Section06.Components.RemainingSieve.Sporadic
