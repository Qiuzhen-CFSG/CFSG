/-!
# The Janko four exclusion in the original E.6.8 setup

The actual E₂₀₄₈.M₂₄ local is invariant under the prescribed Sylow stabilizer.
Its lifted component orbit has a genuine Mathieu two-layer, so its relatively
subnormal chi-zero blocks are excluded by the checked M₂₄ quotient orders.
E.6.7 places this lift in M. The local is generated by two-elements, hence
the original residual condition makes the source involution fix it. The
native centralizer-generation theorem then contradicts the nontrivial inner
action. The full two-kernel and all component permutations are retained.

Source: Aschbacher–Smith, E.6.8, printed p.248 (PDF p.259); GLS3 Table 5.3i.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterE.Section06.Components.RemainingSieve.Sporadic
open _root_.Sporadic.Mathieu
variable {G A : Type*} [Group G] [Finite G] [Group A] [Finite A]
variable {T : Sylow 2 G} {M V U L : Subgroup G}

private theorem mathieu_primeToResidual : primeToResidual 2 M24 = ⊤ := by
  let _ := m24_isSimpleGroup
  rcases (inferInstance : (primeToResidual 2 M24).Normal).eq_bot_or_eq_top with hb | ht
  · have hc := primeToResidual_index_coprime (G := M24) 2
    rw [hb, index_bot, m24_order] at hc
    norm_num at hc
  · exact ht

/-- The actual Mathieu quotient makes the native seed two-generated. -/
theorem primeToResidual_top_of_mathieuQuotient {P : Type*} [Group P] [Finite P]
    (e : (P ⧸ pCore 2 P) ≃* M24) : primeToResidual 2 P = ⊤ := by
  let f := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 P))
  apply primeToResidual_top_of_two_kernel f
    (e.surjective.comp (QuotientGroup.mk'_surjective _)) _ mathieu_primeToResidual
  have he : f.ker = pCore 2 P := by
    rw [MonoidHom.ker_comp_of_injective _ _ e.injective, QuotientGroup.ker_mk']
  rw [he]
  exact pCore_isPGroup

/-- Native Mathieu local quotients exclude every E.6.7 block after component-orbit lift. -/
theorem seedLift_le_M_of_mathieuQuotient
    (h67 : InvariantSubspaces.BlockSelection.E67Input T M V)
    (hU : U ∈ obstructionFamily M V)
    (hL : ComponentIn (centralizer (U : Set G)) L)
    (e : (L ⧸ pCore 2 L) ≃* A) (S : Sylow 2 L)
    (hS : (S : Subgroup L).map L.subtype = L ⊓ sylowCentralizer (T : Subgroup G) V)
    (P : Subgroup A)
    (hinv : ∀ a : MulAut A, ((S : Subgroup L).map (modelMap e)).map a.toMonoidHom =
      (S : Subgroup L).map (modelMap e) → P.map a.toMonoidHom = P)
    (hP : HasCharacteristicTwo P) (eqP : (P ⧸ pCore 2 P) ≃* M24) : seedLift e P ≤ M := by
  let Q := sylowCentralizer (T : Subgroup G) V
  have hQ : Q ≤ centralizer (U : Set G) := inf_le_right.trans (centralizer_le hU.1)
  have htwo : IsPGroup 2 Q := T.isPGroup'.to_le inf_le_left
  have hn := seedLift_stable e S hS P hinv
  have hp := seedLift_characteristicTwo e P hP
  have hjoin : HasCharacteristicTwo (seedLift e P ⊔ Q : Subgroup G) := by
    apply (inf_centralizer_pCoreIn_le_iff 2 _).mp
    exact hL.2.relative_local_adjoin_centralizer hL.1 (seedLift_le e P) hQ htwo hn
      ((inf_centralizer_pCoreIn_le_iff 2 _).mpr hp)
  let eqLift := (ComponentLocalCoreSection.quotientCoreEquiv 2 (seedProjection e P)
    (seedProjection_surjective e P) (seedProjection_ker_two e P)).trans eqP
  let f := eqLift.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 (seedLift e P)))
  have hf : Function.Surjective f := eqLift.surjective.comp (QuotientGroup.mk'_surjective _)
  have hk : IsPGroup 2 f.ker := by
    rw [MonoidHom.ker_comp_of_injective _ _ eqLift.injective, QuotientGroup.ker_mk']
    exact pCore_isPGroup
  have hlayer := hL.2.relative_local_adjoin_hasMathieuTwoLayer hL.1
    (seedLift_le e P) hQ htwo hn f hf hk
  obtain ⟨d⟩ := h67 U hU _ le_sup_right
    (sup_le ((seedLift_le e P).trans hL.1) hQ) hjoin
  apply le_sup_left.trans (OtherTypes.le_of_blockDecomposition d ?_)
  intro B hB hs hb
  exact Chapter2.ComponentRefinement.JankoFour.not_chiZero_subnormal_of_mathieuTwoLayer
    hlayer (B.subgroupOf _) hs (hb.of_mulEquiv (subgroupOfEquivOfLe hB).symm)

variable {K : GroupClass} {z : G}
set_option backward.isDefEq.respectTransparency true
attribute [local irreducible] Janko4.modelGroup Janko4.matrixA Janko4.matrixB
  Janko4.Cardinality.max1Subgroup Janko4.Cardinality.localKernel
open Chapter15.Section03.Candidates.ComponentStructure

/-- The J₄ source model/action row is excluded with all local geometry discharged. -/
theorem jankoFour_excluded (h : HypothesisE61 K T M V)
    (h67 : InvariantSubspaces.BlockSelection.E67Input T M V)
    (hU : U ∈ obstructionFamily M V)
    (hL : ComponentIn (centralizer (U : Set G)) L)
    (hz : z ∈ sylowFixedSpace (T : Subgroup G) V)
    (α : MulAut L) (hα : ∀ x : L, (α x : G) = z * (x : G) * z⁻¹)
    (ha : TwoCentralInner α) (e : (L ⧸ pCore 2 L) ≃* Janko4.Model) : False := by
  obtain ⟨S,hS⟩ := component_sylow_intersection h hU hL
  let R := S.mapSurjective (f := modelMap e) (modelMap_surjective e)
  let a := modelAction e α
  have ho : orderOf a = 2 :=
    (orderOf_injective (modelAction e) (modelAction_injective hL e) α).trans ha.2.1
  obtain ⟨P,_,⟨b⟩,hinv,hgen⟩ := Janko4.LocalStructure.exists_sylow_mathieu_seed R
  let X := Janko4.Cardinality.max1Subgroup Janko4.matrixA_mul_self Janko4.matrixB_pow_four
  have hk : Janko4.Cardinality.localKernel Janko4.matrixA_mul_self Janko4.matrixB_pow_four =
      pCore 2 X := Janko4.LocalStructure.localKernel_eq_twoCore _ _
  let eX : (X ⧸ pCore 2 X) ≃* M24 :=
    (QuotientGroup.quotientMulEquivOfEq hk.symm).trans
      (Janko4.LocalStructure.localQuotientEquivM24 _ _)
  let b' : P ≃* X := b
  let eP : (P ⧸ pCore 2 P) ≃* M24 :=
    (QuotientGroup.congr (pCore 2 P) (pCore 2 X) b' (pCore_map_iso 2 b')).trans eX
  have hchar : HasCharacteristicTwo P := by
    apply (Theory.Quasithin.centralizer_pCore_le_iff 2 b).mpr
    rw [← hk]
    exact (Janko4.LocalStructure.centralizer_localKernel _ _).le
  have hplace := seedLift_le_M_of_mathieuQuotient h67 hU hL e S hS P hinv hchar eP
  apply false_of_seedLift_and_generation hU hL e P hplace
    (primeToResidual_top_of_mathieuQuotient eP) hz.1 α hα ha.2.1
  obtain ⟨l,hl⟩ := ha.1
  have hae : a = MulAut.conj (modelMap e l) := by
    dsimp [a]
    rw [← hl, modelAction_conj]
  have ht : modelMap e l ≠ 1 := by
    intro ht
    rw [hae, ht, map_one, orderOf_one] at ho
    omega
  have hc : modelMap e l ∈ centralizer (R : Set Janko4.Model) := by
    intro r hr
    have hf := modelAction_fixed_sylow e hz α hα S hS r hr
    change a r = r at hf
    rw [hae] at hf
    exact (mul_inv_eq_iff_eq_mul.mp hf).symm
  change a.fixedSubgroup ⊔ P = ⊤
  rw [hae, MulAut.fixedSubgroup_conj]
  exact hgen _ ht hc

end CFSG.Quasithin.ChapterE.Section06.Components.RemainingSieve.Sporadic
