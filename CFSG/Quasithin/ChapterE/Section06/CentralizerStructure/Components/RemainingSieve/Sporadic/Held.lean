/-!
# The original Held exclusion in E.6.8

Use the canonical normalizer of the join of the two normal elementary
order-64 Sylow subgroups. Its actual quotient map onto S₃ × S₃ has a
two-group kernel, so the entire local is generated by two-elements. The
proved native subnormal-order trichotomy excludes chi-zero blocks in the
lifted component orbit; E.6.7 places that lift in M. The original source
residual condition therefore makes the marked involution fix the local.
Its other generating local centralizes the Sylow center and is fixed by
this inner involution. The two locals generate Held, a contradiction.

No choice between the elementary subgroups is made, so automorphisms that
exchange them are retained. The complete covering two-kernel and the
original Sylow subgroup and component action are preserved throughout.
Source: Aschbacher–Smith E.6.8, printed p.248 (PDF p.259), GLS3 Table 5.3p.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterE.Section06.Components.RemainingSieve.Sporadic
open _root_.Held _root_.Held.AutomorphismLocalPair

private theorem symmetricThreeProduct_residual :
    primeToResidual 2 (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3)) = ⊤ := by
  let P := primeToResidual 2 (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3))
  have h (f : Equiv.Perm (Fin 3) →* (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3)))
      (x : Equiv.Perm (Fin 3)) : f x ∈ P := by
    refine Equiv.Perm.swap_induction_on x ?_ ?_
    · rw [map_one]; exact P.one_mem
    · intro y a b _ hy
      rw [map_mul]
      apply P.mul_mem _ hy
      apply mem_primeToResidual_of_pow (n := 1)
      rw [← map_pow]
      simp [pow_two]
  apply top_unique
  rintro ⟨x,y⟩ _
  exact P.mul_mem (h (MonoidHom.inl _ _) x) (h (MonoidHom.inr _ _) y)

theorem held_largeLocal_primeToResidual (R : Sylow 2 He) :
    primeToResidual 2 (largeLocal R) = ⊤ := by
  obtain ⟨g,hg⟩ := exists_conjugate_representative R
  let b := (largeLocalEquivOfConjugate R g hg).symm
  let c : representativeLargeLocal ≃*
      LocalPairs.PairCoverage.LocalActions.Exhaustion.candidateProduct false 0 :=
    (representativeLargeLocal.equivMapOfInjective
      (MulAut.conj ResidualNine.pairConjugator).toMonoidHom
      (MulAut.conj ResidualNine.pairConjugator).injective).trans
      (MulEquiv.subgroupCongr ResidualNine.representative_map_pairConjugator)
  let d := b.trans c
  let f := ResidualNine.pairQuotient.comp d.toMonoidHom
  have hf : Function.Surjective f := ResidualNine.pairQuotient_surjective.comp d.surjective
  have hk : IsPGroup 2 f.ker :=
    ResidualNine.pairQuotient_kernel_isPGroup.comap_of_injective d.toMonoidHom d.injective
  exact primeToResidual_top_of_two_kernel f hf hk symmetricThreeProduct_residual

theorem held_fixed_sup_largeLocal (R : Sylow 2 He) (a : MulAut He)
    (hi : a ∈ (MulAut.conj (G := He)).range)
    (hf : ∀ r ∈ (R : Subgroup He), a r = r) : a.fixedSubgroup ⊔ largeLocal R = ⊤ := by
  obtain ⟨t, ht⟩ := hi
  have hc : t ∈ centralizer (R : Set He) := by
    intro y hy
    have he := hf y hy
    rw [← ht] at he
    exact (mul_inv_eq_iff_eq_mul.mp he).symm
  have hn := centralizer_le_normalizer (R : Set He) hc
  rw [LocalPairs.SylowGeometry.Calculations.inner_self_normalizing] at hn
  have htseed : t ∈ centerSeed R :=
    (mem_centerSeed _ _).mpr ⟨hn, fun y hy => hc y hy⟩
  have hfixed : centerLocal R ≤ a.fixedSubgroup := by
    intro x hx
    apply (MulAut.mem_fixedSubgroup _ _).mpr
    rw [← ht]
    change t * x * t⁻¹ = x
    have he := (mem_centerLocal _ _).mp hx t htseed
    rw [he, mul_inv_cancel_right]
  apply top_unique
  rw [← locals_generate R]
  exact sup_le_sup_right hfixed _

variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {M V U L : Subgroup G} {K : GroupClass} {z : G}
open Chapter15.Section03.Candidates.ComponentStructure

theorem held_excluded (h : HypothesisE61 K T M V)
    (h67 : InvariantSubspaces.BlockSelection.E67Input T M V)
    (hU : U ∈ obstructionFamily M V)
    (hL : ComponentIn (centralizer (U : Set G)) L)
    (hz : z ∈ sylowFixedSpace (T : Subgroup G) V)
    (α : MulAut L) (hα : ∀ x : L, (α x : G) = z * (x : G) * z⁻¹)
    (ha : TwoCentralInner α) (e : (L ⧸ pCore 2 L) ≃* He) : False := by
  obtain ⟨S,hS⟩ := component_sylow_intersection h hU hL
  let R := S.mapSurjective (f := modelMap e) (modelMap_surjective e)
  let a := modelAction e α
  have hi : a ∈ (MulAut.conj (G := He)).range := by
    obtain ⟨l,hl⟩ := ha.1
    exact ⟨modelMap e l, by dsimp [a]; rw [← hl, modelAction_conj]⟩
  have hplace := seedLift_le_M_of_largeOrders h67 hU hL e LocalPairs.center_eq_bot
    S hS (largeLocal R) (fun b hb => (locals_invariant (R : Subgroup He) b hb).2)
    (largeLocal_selfCentralizingCore_of_sylow R) (MulEquiv.refl (largeLocal R))
    (subnormal_largeLocal_orders R)
  exact false_of_seedLift_and_generation hU hL e (largeLocal R) hplace
    (held_largeLocal_primeToResidual R) hz.1 α hα ha.2.1
    (held_fixed_sup_largeLocal R a hi (modelAction_fixed_sylow e hz α hα S hS))
end CFSG.Quasithin.ChapterE.Section06.Components.RemainingSieve.Sporadic
