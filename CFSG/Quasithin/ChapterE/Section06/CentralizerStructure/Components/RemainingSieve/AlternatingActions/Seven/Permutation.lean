module

public import Theory.Alternating.Aut
public import Mathlib.GroupTheory.Sylow
public import Mathlib.Tactic.FinCases
public import Mathlib.Tactic.NormNum
/-!
# The Sylow fixer on seven letters

The displayed eight-element subgroup is Sylow in A₇. Its centralizer in S₇
is exactly the four permutations generated by `(01)(23)` and `(45)`.
Their fixed subgroups in A₇ generate: `(012)`, `(013)`, and `(016)` commute
with `(45)`, while `(456)` commutes with `(01)(23)` and conjugates `(016)`
to the remaining standard generators.

The eight-element subgroup uses the coordinates of Chapter 2'singleSwap
`ComponentRefinement.AlternatingSeven.Rigidity`. All finite computations below
are kernel checked calculations on at most eight displayed elements.

Source: Aschbacher--Smith, combined manuscript (1 March 2004), E.6.8(4),
printed p.248, and 1.1.5(3)(d), printed pp.501--502.
-/

public section
open Equiv Subgroup
namespace CFSG.Quasithin.ChapterE.Section06.Components.RemainingSieve.AlternatingActions.Seven
abbrev A7 := alternatingGroup (Fin 7)
abbrev S7 := Perm (Fin 7)
@[expose] def doubleSwap : A7 := ⟨swap 0 1 * swap 2 3, by change Perm.sign _ = 1; decide⟩
private def secondDoubleSwap : A7 := ⟨swap 0 1 * swap 4 5, by change Perm.sign _ = 1; decide⟩
private def pairExchange : A7 := ⟨swap 0 2 * swap 1 3, by change Perm.sign _ = 1; decide⟩
@[expose] def singleSwap : S7 := swap 4 5
private def sylowEntry : Fin 8 → A7 :=
  ![1, doubleSwap, secondDoubleSwap, doubleSwap * secondDoubleSwap,
    pairExchange, doubleSwap * pairExchange, secondDoubleSwap * pairExchange,
    doubleSwap * secondDoubleSwap * pairExchange]

/-- The displayed dihedral subgroup of order eight. -/
def standardSylowGroup : Subgroup A7 where
  carrier := Set.range sylowEntry
  one_mem' := ⟨0, rfl⟩
  mul_mem' := by
    rintro x y ⟨i, rfl⟩ ⟨j, rfl⟩
    change ∃ l, sylowEntry l = sylowEntry i * sylowEntry j
    fin_cases i <;> fin_cases j <;> decide
  inv_mem' := by
    rintro x ⟨i, rfl⟩
    change ∃ j, sylowEntry j = (sylowEntry i)⁻¹
    fin_cases i <;> decide

private def four : Fin 4 → S7 := ![1, doubleSwap, singleSwap, (doubleSwap : S7)*singleSwap]

private theorem centralizer_calc (g : S7)
    (ha : g * doubleSwap = doubleSwap * g)
    (hb : g * secondDoubleSwap = secondDoubleSwap * g)
    (hr : g * pairExchange = pairExchange * g) :
    ∃ i, four i = g := by
  have ha' (j) := congrArg (fun t : S7 => t j) ha
  have hb' (j) := congrArg (fun t : S7 => t j) hb
  have hr' (j) := congrArg (fun t : S7 => t j) hr
  simp only [Perm.mul_apply] at ha' hb' hr'
  have h0 : g 0 = 0 ∨ g 0 = 1 := by
    have hab : (doubleSwap : S7) (g 0) = (secondDoubleSwap : S7) (g 0) := (ha' 0).symm.trans (hb' 0)
    have han : (doubleSwap : S7) (g 0) ≠ g 0 := by
      rw [← ha' 0]
      exact g.injective.ne (by decide : (doubleSwap : S7) 0 ≠ 0)
    revert hab han
    generalize g 0 = j
    fin_cases j <;> decide
  have h4 : g 4 = 4 ∨ g 4 = 5 := by
    have haf : (doubleSwap : S7) (g 4) = g 4 := (ha' 4).symm
    have hbf : (secondDoubleSwap : S7) (g 4) ≠ g 4 := by
      rw [← hb' 4]
      exact g.injective.ne (by decide : (secondDoubleSwap : S7) 4 ≠ 4)
    revert haf hbf
    generalize g 4 = j
    fin_cases j <;> decide
  have h6 : g 6 = 6 := by
    have haf : (doubleSwap : S7) (g 6) = g 6 := (ha' 6).symm
    have hbf : (secondDoubleSwap : S7) (g 6) = g 6 := (hb' 6).symm
    revert haf hbf
    generalize g 6 = j
    fin_cases j <;> decide
  have h1 : g 1 = (doubleSwap : S7) (g 0) := ha' 0
  have h2 : g 2 = (pairExchange : S7) (g 0) := hr' 0
  have h3 : g 3 = (doubleSwap : S7) ((pairExchange : S7) (g 0)) := (ha' 2).trans (congrArg (doubleSwap : S7) h2)
  have h5 : g 5 = (secondDoubleSwap : S7) (g 4) := hb' 4
  rcases h0 with h0 | h0 <;> rcases h4 with h4 | h4
  · refine ⟨0, ?_⟩
    ext j
    fin_cases j <;> simp [four, h0, h1, h2, h3, h4, h5, h6, doubleSwap, secondDoubleSwap, pairExchange, singleSwap] <;> decide
  · refine ⟨2, ?_⟩
    ext j
    fin_cases j <;> simp [four, h0, h1, h2, h3, h4, h5, h6, doubleSwap, secondDoubleSwap, pairExchange, singleSwap] <;> decide
  · refine ⟨1, ?_⟩
    ext j
    fin_cases j <;> simp [four, h0, h1, h2, h3, h4, h5, h6, doubleSwap, secondDoubleSwap, pairExchange, singleSwap] <;> decide
  · refine ⟨3, ?_⟩
    ext j
    fin_cases j <;> simp [four, h0, h1, h2, h3, h4, h5, h6, doubleSwap, secondDoubleSwap, pairExchange, singleSwap] <;> decide

private theorem standardSylowGroup_card : Nat.card standardSylowGroup = 8 := by
  let f : Fin 8 → standardSylowGroup := fun i => ⟨sylowEntry i, ⟨i, rfl⟩⟩
  have hi : Function.Injective f := by
    intro i j he
    exact (by decide : ∀ i j, sylowEntry i = sylowEntry j → i = j) i j
      (congrArg (fun x : standardSylowGroup => (x : A7)) he)
  have hs : Function.Surjective f := by
    rintro ⟨x, i, rfl⟩
    exact ⟨i, rfl⟩
  exact (Nat.card_congr (Equiv.ofBijective f ⟨hi, hs⟩)).symm.trans (by simp)

@[expose] def standardSylow : Sylow 2 A7 := Sylow.ofCard standardSylowGroup (by
  rw [standardSylowGroup_card, nat_card_alternatingGroup]
  norm_num [Nat.factorial]
  rw [Nat.factorization_def _ Nat.prime_two]
  have hzero : padicValNat 2 315 = 0 :=
    padicValNat.eq_zero_iff.mpr (Or.inr (Or.inr (by decide)))
  rw [show 2520 = 2 ^ 3 * 315 by decide,
    padicValNat_base_pow_mul (by decide) (by decide) 3, hzero]
  decide)

/-- The pointwise permutation centralizer of the displayed Sylow subgroup. -/
@[expose] def permutationFixer : Subgroup S7 :=
  centralizer (standardSylowGroup.map (alternatingGroup (Fin 7)).subtype : Set S7)

private theorem mem_permutationFixer (g : S7) : g ∈ permutationFixer ↔ ∃ i, four i = g := by
  constructor
  · intro h
    apply centralizer_calc
    · exact (h _ (mem_map_of_mem _ (show doubleSwap ∈ standardSylowGroup from ⟨1, rfl⟩))).symm
    · exact (h _ (mem_map_of_mem _ (show secondDoubleSwap ∈ standardSylowGroup from ⟨2, rfl⟩))).symm
    · exact (h _ (mem_map_of_mem _ (show pairExchange ∈ standardSylowGroup from ⟨4, rfl⟩))).symm
  · rintro ⟨i, rfl⟩ x ⟨y, ⟨j, rfl⟩, rfl⟩
    change (sylowEntry j : S7) * four i = four i * (sylowEntry j : S7)
    fin_cases i <;> fin_cases j <;> decide

theorem permutationFixer_card : Nat.card permutationFixer = 4 := by
  let f : Fin 4 → permutationFixer := fun i => ⟨four i, (mem_permutationFixer _).mpr ⟨i, rfl⟩⟩
  have hi : Function.Injective f := by
    intro i j he
    exact (by decide : ∀ i j, four i = four j → i = j) i j
      (congrArg (fun x : permutationFixer => (x : S7)) he)
  have hs : Function.Surjective f := by
    intro x
    obtain ⟨i, hi⟩ := (mem_permutationFixer x).mp x.property
    exact ⟨i, Subtype.ext hi⟩
  exact (Nat.card_congr (Equiv.ofBijective f ⟨hi, hs⟩)).symm.trans (by simp)

private def c : A7 := ⟨swap 4 5 * swap 5 6, by change Perm.sign _ = 1; decide⟩

theorem doubleSwap_mem_permutationFixer : (doubleSwap : S7) ∈ permutationFixer :=
  (mem_permutationFixer _).mpr ⟨1, rfl⟩

theorem singleSwap_mem_permutationFixer : singleSwap ∈ permutationFixer :=
  (mem_permutationFixer _).mpr ⟨2, rfl⟩

/-- The fixed subgroups of these two nonidentity Sylow-fixing automorphisms
already generate the whole alternating group. -/
theorem centralizers_generate (H : Subgroup A7)
    (ha : ∀ x : A7, (x : S7) * doubleSwap = doubleSwap * (x : S7) → x ∈ H)
    (hs : ∀ x : A7, (x : S7) * singleSwap = singleSwap * (x : S7) → x ∈ H) :
    ⊤ ≤ H := by
  have hc : c ∈ H := ha c (by decide)
  let g (i : Fin 7) (h0 : i ≠ 0) (h1 : i ≠ 1) :=
    GroupTheory.AutAlternating.gen 7 (by decide) i h0 h1
  have h2 : g 2 (by decide) (by decide) ∈ H := hs _ (by decide)
  have h3 : g 3 (by decide) (by decide) ∈ H := hs _ (by decide)
  have h6 : g 6 (by decide) (by decide) ∈ H := hs _ (by decide)
  have h4 : g 4 (by decide) (by decide) ∈ H := by
    have he : g 4 (by decide) (by decide) = c * g 6 (by decide) (by decide) * c⁻¹ := by decide
    rw [he]
    exact H.mul_mem (H.mul_mem hc h6) (H.inv_mem hc)
  have h5 : g 5 (by decide) (by decide) ∈ H := by
    have he : g 5 (by decide) (by decide) = c⁻¹ * g 6 (by decide) (by decide) * c := by decide
    rw [he]
    exact H.mul_mem (H.mul_mem (H.inv_mem hc) h6) hc
  rw [← GroupTheory.AutAlternating.gen_closure_alternatingGroup_eq_top (by decide : 5 ≤ 7)]
  apply (closure_le H).mpr
  rintro x ⟨⟨i, h0, h1⟩, rfl⟩
  fin_cases i
  · exact (h0 rfl).elim
  · exact (h1 rfl).elim
  · exact h2
  · exact h3
  · exact h4
  · exact h5
  · exact h6
end CFSG.Quasithin.ChapterE.Section06.Components.RemainingSieve.AlternatingActions.Seven
