module

public import CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.BlockSelection.Contracts
public import CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.BlockSelection.ThreeElements
public import Theory.GroupTheory.PResidual.PrimeToSubnormal
public import Mathlib.LinearAlgebra.Projectivization.PSL.PSL2
public import Mathlib.GroupTheory.SpecificGroups.Alternating.Simple

/-!
# Intrinsic three-generation of the selected blocks

Each chi-zero block is its own prime-to-three residual. Its actual quotient
by O₂ is simple and has order divisible by three, while the block has no
nontrivial two-group quotient. This proves three-generation without assuming
ambient normality or any restriction on other three-elements.

Consequently the residual step in E.6.14 reduces to proving that the chosen
subnormal block has index prime to three in C_G(W). Normality follows from
the subnormal-chain residual argument.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), C.1.7, C.1.12,
and the proof of E.6.14, printed pp.123–124 and 251.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.BlockSelection

private theorem simple_core_quotient {L : Type*} [Group L]
    (h : ChapterC.IsChiZeroBlock L) : IsSimpleGroup (L ⧸ pCore 2 L) := by
  rcases h with ⟨n, hn, _, F, _, _, _, hmodel, _⟩ | ha | ha
  · obtain ⟨F', _, _, hcard, ⟨e⟩⟩ := hmodel
    have hfour : 4 ≤ Nat.card F' := by
      rw [hcard]
      exact show 2 ^ 2 ≤ 2 ^ n from Nat.pow_le_pow_right (by decide) hn
    let : IsSimpleGroup (Matrix.ProjectiveSpecialLinearGroup (Fin 2) F') :=
      Matrix.ProjectiveSpecialLinearGroup.rank_two_simple hfour
    exact e.isSimpleGroup
  · obtain ⟨e⟩ := ha.2.2.quotient_iso
    apply isSimpleGroup_of_prime_card (p := 3)
    rw [Nat.card_congr e.toEquiv, nat_card_alternatingGroup]
    norm_num
  · obtain ⟨e⟩ := ha.2.2.quotient_iso
    exact e.isSimpleGroup

/-- Every chi-zero block is intrinsically generated by its three-elements. -/
theorem chiZero_primeToResidual_eq_top {L : Type*} [Group L]
    (h : ChapterC.IsChiZeroBlock L) : primeToResidual 3 L = ⊤ := by
  let : Finite L := h.chi.short.finite
  let : IsSimpleGroup (L ⧸ pCore 2 L) := simple_core_quotient h
  obtain ⟨x, hx⟩ := exists_order_three h
  have hd : 3 ∣ Nat.card L := hx ▸ orderOf_dvd_natCard x
  have hc : Nat.Coprime 3 (Nat.card (pCore 2 L)) := by
    obtain ⟨n, hn⟩ := (pCore_isPGroup (p := 2) (G := L)).exists_card_eq
    rw [hn]
    exact (by decide : Nat.Coprime 3 2).pow_right n
  have hquot : 3 ∣ Nat.card (L ⧸ pCore 2 L) := by
    rw [← (pCore 2 L).card_mul_index] at hd
    rw [← index_eq_card]
    exact (Nat.prime_three.dvd_mul.mp hd).resolve_left
      (Nat.prime_three.coprime_iff_not_dvd.mp hc)
  exact primeToResidual_eq_top_of_simple_quotient 3 2 (pCore 2 L)
    pCore_isPGroup h.chi.short.twoPerfect hquot

variable {G : Type*} [Group G]

/-- A subnormal chi-zero block of index prime to three is the ambient
three-prime residual. Its normality is proved, not required. -/
theorem chiZero_eq_primeToResidual_of_index {H L : Subgroup G}
    (hLH : L ≤ H) (hL : ChapterC.IsChiZeroBlock L)
    (hsub : (L.subgroupOf H).IsSubnormal) (hindex : Nat.Coprime 3 (L.relIndex H)) :
    L = (primeToResidual 3 H).map H.subtype := by
  let e := (subgroupOfEquivOfLe hLH).symm
  have hres : primeToResidual 3 (L.subgroupOf H) = ⊤ := by
    have he := map_primeToResidual (p := 3) e
    rw [chiZero_primeToResidual_eq_top hL, map_top_of_surjective _ e.surjective] at he
    exact he.symm
  rw [primeToResidual_eq_of_subnormal_coprime_index 3 (L.subgroupOf H)
    hsub hres hindex, map_subgroupOf_eq_of_le hLH]

/-- This inclusion holds for every selected block, independently of
ThreeCondition and of the number of blocks. -/
theorem E67Decomposition.block_le_primeToResidual {Q M V W H : Subgroup G}
    (d : E67Decomposition Q M V W H) (i : Fin d.count) :
    d.block i ≤ (primeToResidual 3 H).map H.subtype := by
  let e := (subgroupOfEquivOfLe (d.le i)).symm
  have hres : primeToResidual 3 ((d.block i).subgroupOf H) = ⊤ := by
    have he := map_primeToResidual (p := 3) e
    rw [chiZero_primeToResidual_eq_top (d.type i),
      map_top_of_surjective _ e.surjective] at he
    exact he.symm
  have hle := map_mono (f := H.subtype)
    (le_primeToResidual_of_eq_top 3 ((d.block i).subgroupOf H) hres)
  rwa [map_subgroupOf_eq_of_le (d.le i)] at hle

end CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.BlockSelection
