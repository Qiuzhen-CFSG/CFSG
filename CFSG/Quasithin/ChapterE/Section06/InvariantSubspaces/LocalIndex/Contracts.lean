module

public import CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.Reduction
public import CFSG.Quasithin.ChapterB.Section02.Thompson
public import Stellmacher.BaumannNormalizer
public import Mathlib.GroupTheory.Frattini

/-!
# Local contracts for the single-block argument

Source: Aschbacher–Smith, combined manuscript (1 March 2004), C.5.4–7,
printed pp.155–160, and the application in E.6.14, printed p.251.

Here `R` is the whole Sylow two-subgroup of `H`, and `L = O²(H)` is
already an actual chi-zero block. The ambient group is only finite; SQTK
is required of `A` and `H` separately. The two inputs below isolate the
local Baumann calculation and the conjugate-module calculation. Neither
is asserted here. Their discharge, and not the elementary index argument
alone, is necessary for the localized C.5.7 theorem.

All objects are actual subgroups: `U = [O₂(L),L]`, `S = Baum(R)`,
`Q = O₂(LS)`, `D = C_S(L)`, and `F = Φ(D)`. The family is precisely the
`R`-invariant members of the maximum-order elementary abelian family of `S`.

In the source C.5.3 invokes C.1.26 on the local group `H` (since here
`R = T_H`). Its characteristic-subgroup obstruction is proved in `Assembly`.
C.5.4 additionally needs the actual block action and Baumann calculations;
the type of the block by itself is not a proof of those assertions. For
C.5.6 only (4) and the elementary-family calculation from the proof of (5)
are requested here. The two-block analysis and the extra conclusions of
C.5.6(6),(7) and C.5.8 are not needed for this index argument.
-/

@[expose] public section

namespace CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.LocalIndex

open Subgroup
universe u
variable {G : Type u} [Group G] [Finite G]

/-- Exactly the local hypotheses in `SingleBlockIndexInput`. -/
structure Configuration (K : GroupClass.{u}) (A H R L : Subgroup G) : Prop where
  sqtk_A : IsSQTK K A
  sqtk_H : IsSQTK K H
  characteristicTwo : HasCharacteristicTwo H
  sylow : Chapter1.IsSylowIn 2 R H
  unique : Order.HasUniqueMaximalOver R H
  le_A : R ≤ A
  normalizes_R : A ≤ normalizer (R : Set G)
  no_common : ¬ ∃ N : Subgroup G, N ≤ R ∧ N ≠ ⊥ ∧
    Chapter3.NormalIn N (Chapter3.generated A H)
  residual : (pResidual 2 H).map H.subtype = L
  block : ChapterC.IsChiZeroBlock L
  maximal : localNormalizer A L ⋖ A

/-- The embedded commutator module of the actual block. -/
def U (L : Subgroup G) : Subgroup G := (ChapterC.blockU L).map L.subtype

/-- The actual Baumann subgroup, with the elementary Thompson convention. -/
noncomputable def S (R : Subgroup G) : Subgroup G := ChapterB.baumann R

/-- The embedded two-core of the group generated by the block and Baumann subgroup. -/
noncomputable def Q (R L : Subgroup G) : Subgroup G := pCoreIn 2 (L ⊔ S R)

/-- The centralizer of the block inside the Baumann subgroup. -/
noncomputable def D (R L : Subgroup G) : Subgroup G := S R ⊓ centralizer (L : Set G)

/-- The embedded Frattini subgroup of that centralizer. -/
noncomputable def F (R L : Subgroup G) : Subgroup G :=
  (frattini (D R L)).map (D R L).subtype

/-- The normal members of the maximum-order elementary abelian family of `S`. -/
def invariantFamily (R S : Subgroup G) : Set (Subgroup G) :=
  {E | E ∈ Stellmacher.elementaryAbelianMaxSubgroups S ∧ R ≤ normalizer (E : Set G)}

/-- The part of C.5.4 needed to select a noncommuting conjugate in C.5.5.
The source proof must establish this using the actual block action. -/
structure BaumannStructure (H R L : Subgroup G) : Prop where
  module_le : U L ≤ S R
  centralizer_le : R ⊓ centralizer (U L : Set G) ≤ pCoreIn 2 H
  core_eq : Q R L = S R ⊓ centralizer (U L : Set G)

/-- Required localization of C.5.4; no SQTK assertion about the join occurs. -/
def BaumannInput (K : GroupClass.{u}) : Prop :=
  ∀ A H R L : Subgroup G, Configuration K A H R L → BaumannStructure H R L

/-- The needed C.5.6(4) and maximum-elementary-family calculations, before
the maximality argument kills `Φ(D)`. In the alternating-five case this
requires identifying the two `R`-invariant members of the four-member family.
The explicit `BaumannStructure` input permits independent development. -/
def ConjugateInput (K : GroupClass.{u}) : Prop :=
  ∀ A H R L : Subgroup G, Configuration K A H R L → BaumannStructure H R L →
    ∀ x ∈ A, ¬ (U L).map (MulAut.conj x).toMonoidHom ≤ centralizer (U L : Set G) →
      (F R L).map (MulAut.conj x).toMonoidHom = F R L ∧
      (F R L = ⊥ → invariantFamily R (S R) =
        {Q R L, (Q R L).map (MulAut.conj x).toMonoidHom})

end CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.LocalIndex

end
