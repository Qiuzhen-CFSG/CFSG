module

public import CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.LocalIndex.Baumann.Reduction
public import CFSG.Quasithin.ChapterB.Section06To07.Elementary
public import Theory.GroupTheory.MinimalParabolicResidual
public import Stellmacher.ElementaryAbelianMaxJMap

/-!
# The conjugate closure needed for the rank-one Baumann calculation

The local group H is a minimal parabolic over its specified Sylow subgroup.
Thompson escape from O₂(H), already proved in `Reduction`, and the elementary
residual-commutator theorem give [L,J(R)] = L. Since J(R) ≤ Baum(R), the
L-conjugate closure of Baum(R) is therefore exactly L·Baum(R).

Consequently the precise Sylow assertion in B.6.10(2) implies the desired
local core containment. The natural-module hypotheses of that proposition
still need to be supplied; no Sylow assertion is proved in this module.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), C.5.3–4,
printed pp.154–155, and B.6.10(2), printed p.117.
-/

public section
namespace CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.LocalIndex.Baumann
open Subgroup Stellmacher

private theorem coatom_iff_covBy_map {G : Type*} [Group G] (H : Subgroup G)
    (M : Subgroup H) : IsCoatom M ↔ M.map H.subtype ⋖ H := by
  have htop : (⊤ : Subgroup H).map H.subtype = H := by
    rw [← MonoidHom.range_eq_map, range_subtype]
  constructor
  · intro hm
    refine ⟨?_, ?_⟩
    · simpa only [htop] using
        (map_lt_map_iff_of_injective H.subtype_injective).mpr hm.lt_top
    · intro B hMB hBH
      have hB : (B.subgroupOf H).map H.subtype = B := map_subgroupOf_eq_of_le hBH.le
      have hlt : M < B.subgroupOf H := by
        apply (map_lt_map_iff_of_injective H.subtype_injective).mp
        rwa [hB]
      have he := hm.lt_iff.mp hlt
      have he' := congrArg (map H.subtype) he
      rw [hB, htop] at he'
      exact hBH.ne he'
  · intro hm
    refine ⟨?_, ?_⟩
    · intro he
      exact hm.ne (by rw [he, htop])
    · intro B hMB
      apply map_injective H.subtype_injective
      rw [htop]
      exact (hm.eq_or_eq (map_mono hMB.le) (map_subtype_le B)).resolve_left
        (ne_of_gt ((map_lt_map_iff_of_injective H.subtype_injective).mpr hMB))

/-- The unique maximal overgroup and the nonnormality condition are internal to H. -/
theorem minimalParabolic {G : Type*} [Group G] [Finite G]
    {K : GroupClass} {A H R L : Subgroup G} (h : Configuration K A H R L) (T : Sylow 2 H)
    (hT : (T : Subgroup H).map H.subtype = R) :
    ChapterB.IsMinimalParabolicOver T ⊤ := by
  apply (ChapterB.isMinimalParabolicOver_top_iff T).mpr
  obtain ⟨M, hM, hu⟩ := h.unique.2
  have hm : (M.subgroupOf H).map H.subtype = M := map_subgroupOf_eq_of_le hM.2.le
  refine ⟨⟨M.subgroupOf H, ⟨?_, ?_⟩, ?_⟩, ?_⟩
  · exact (coatom_iff_covBy_map H _).mpr (by simpa only [hm] using hM.2)
  · apply (map_le_map_iff_of_injective H.subtype_injective).mp
    simpa only [hm, hT] using hM.1
  · intro N hN
    apply map_injective H.subtype_injective
    rw [hm]
    apply hu
    exact ⟨hT ▸ map_mono hN.2, (coatom_iff_covBy_map H N).mp hN.1⟩
  · intro hn
    have hnorm := (T : Subgroup H).le_normalizer_map H.subtype
    rw [normalizer_eq_top, ← MonoidHom.range_eq_map, range_subtype, hT] at hnorm
    exact sylow_not_normalized_by_H h hnorm

private theorem normalizer_le_normalizer_thompson {G : Type*} [Group G] (B : Subgroup G) :
    normalizer (B : Set G) ≤ normalizer (elementaryAbelianMaxJ B : Set G) := by
  intro g hg
  rw [mem_normalizer_iff_map_conj_eq] at hg ⊢
  change B.map (MulAut.conj g).toMonoidHom = B at hg
  change (elementaryAbelianMaxJ B).map (MulAut.conj g).toMonoidHom = elementaryAbelianMaxJ B
  rw [← elementaryAbelianMaxJ_map_equiv, hg]

/-- The single block is generated by its commutators with J(R), as in C.5.3. -/
theorem block_eq_thompson_commutator {G : Type*} [Group G] [Finite G]
    {K : GroupClass} {A H R L : Subgroup G} (h : Configuration K A H R L) :
    ⁅L, elementaryAbelianMaxJ R⁆ = L := by
  obtain ⟨T, hT⟩ := h.sylow
  have hmap : (elementaryAbelianMaxJ (T : Subgroup H)).map H.subtype =
      elementaryAbelianMaxJ R := by
    rw [← elementaryAbelianMaxJ_map_injective H.subtype H.subtype_injective, hT]
  have hnot : ¬ elementaryAbelianMaxJ (T : Subgroup H) ≤ pCore 2 H := by
    intro hj
    apply thompson_not_le_HCore h
    rw [← hmap]
    exact map_mono hj
  have hcomm := commutator_twoResidual_eq_of_normal_sylow_subgroup T
    (minimalParabolic h T hT).1 (elementaryAbelianMaxJ (T : Subgroup H))
    (sSup_le fun _ hE => hE.1)
    ((T : Subgroup H).le_normalizer.trans (normalizer_le_normalizer_thompson _)) hnot
  have hm := congrArg (map H.subtype) hcomm
  rwa [map_commutator, h.residual, hmap] at hm

private theorem thompson_le_baumann {G : Type*} [Group G] (R : Subgroup G) :
    elementaryAbelianMaxJ R ≤ S R := by
  refine le_inf (sSup_le fun _ hE => hE.1) ?_
  intro j hj
  rw [mem_centralizer_iff]
  intro w hw
  obtain ⟨wJ, hwJ, rfl⟩ := hw
  obtain ⟨wZ, _, rfl⟩ := hwJ
  exact congrArg Subtype.val
    ((mem_center_iff.mp wZ.property) ⟨j, hj⟩).symm

/-- The L-conjugate closure in B.6.10(2) is exactly LS in this configuration. -/
theorem baumann_conjugateClosure_eq {G : Type*} [Group G] [Finite G]
    {K : GroupClass} {A H R L : Subgroup G} (h : Configuration K A H R L) :
    conjugateClosure (S R) L = L ⊔ S R := by
  have hseed : S R ≤ conjugateClosure (S R) L := by
    intro x hx
    exact subset_closure ⟨1, ⟨x, hx⟩, by simp⟩
  apply le_antisymm
  · rw [conjugateClosure, closure_le]
    rintro x ⟨l, s, rfl⟩
    exact (L ⊔ S R).mul_mem
      ((L ⊔ S R).mul_mem (mem_sup_left l.property) (mem_sup_right s.property))
      (mem_sup_left (L.inv_mem l.property))
  · apply sup_le ?_ hseed
    apply (block_eq_thompson_commutator h).symm.le.trans
    apply commutator_le.mpr
    intro l hl j hj
    have hc : l * j * l⁻¹ ∈ conjugateClosure (S R) L :=
      subset_closure ⟨⟨l, hl⟩, ⟨j, thompson_le_baumann R hj⟩, rfl⟩
    exact (conjugateClosure (S R) L).mul_mem hc
      ((conjugateClosure (S R) L).inv_mem (hseed (thompson_le_baumann R hj)))

/-- The precise Sylow conclusion of B.6.10(2) suffices for the local core bound. -/
theorem localCore_le_baumann_of_conjugateClosure_sylow
    {G : Type*} [Group G] [Finite G]
    {K : GroupClass} {A H R L : Subgroup G} (h : Configuration K A H R L)
    (hs : Chapter1.IsSylowIn 2 (S R) (conjugateClosure (S R) L)) : Q R L ≤ S R := by
  rw [baumann_conjugateClosure_eq h] at hs
  obtain ⟨T, hT⟩ := hs
  exact hT ▸ pCoreIn_le_sylow (L ⊔ S R) T

end CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.LocalIndex.Baumann
end
