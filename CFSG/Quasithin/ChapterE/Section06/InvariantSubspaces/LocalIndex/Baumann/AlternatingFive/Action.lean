module

public import CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.LocalIndex.Baumann.Reduction
public import CFSG.Quasithin.ChapterB.Section03.Offenders.Defs

/-!
# The actual action needed for the alternating-five Baumann calculation

The defining block model identifies only U/C_U(L). The calculation in C.5.4
uses U itself, together with the action of H, extending the alternating action
of L to a subgroup of S₅. `NaturalActionModel` records precisely this additional
identification. Its construction is an outstanding mathematical obligation;
the definition does not assert that it exists.

The two input propositions separate construction of the action from the
Thompson-image calculation. The latter may use the former as an explicit
witness, so their proofs can be developed independently. Neither assumes an
alpha decomposition or a Baumann-subgroup containment.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), C.1.13(c),
printed pp.124–125; C.5.4(3), p.155; B.3.2(4), pp.83–84.
-/

@[expose] public section

namespace CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.LocalIndex.Baumann.AlternatingFive

open Subgroup
universe u
variable {G : Type u} [Group G]

/-- A faithful permutation model for the conjugation action of H on the
actual U(L). It permits a central extension in O₂(L); only U is identified
with the natural module. Surjectivity onto S₅ is not assumed. -/
structure NaturalActionModel (H L : Subgroup G) where
  quotient : H →* Equiv.Perm (Fin 5)
  kernel : quotient.ker = pCore 2 H
  block_image : (L.subgroupOf H).map quotient = alternatingGroup (Fin 5)
  moduleEquiv : U L ≃* Multiplicative (BinaryPermutation.natural (Fin 5))
  intertwining : ∀ (x : H) (v : U L),
    (moduleEquiv.symm (Multiplicative.ofAdd
      (BinaryPermutation.naturalRepresentation (Fin 5) (quotient x)
        (Multiplicative.toAdd (moduleEquiv v)))) : G) =
      (x : G) * (v : G) * (x : G)⁻¹

/-- The missing lift from the defining quotient module to the actual
H-action on U. The centralizer theorem remains an explicit earlier input. -/
def NaturalActionInput [Finite G] (K : GroupClass.{u}) : Prop :=
  ∀ A H R L : Subgroup G, Configuration K A H R L →
    H ⊓ centralizer (U L : Set G) = pCoreIn 2 H →
    ChapterC.IsAlternatingBlock L 5 → Nonempty (NaturalActionModel H L)

/-- The source offender calculation must identify the image of the actual
Thompson subgroup, not just the group generated by all abstract offenders. -/
def ThompsonImageInput [Finite G] (K : GroupClass.{u}) : Prop :=
  ∀ A H R L : Subgroup G, Configuration K A H R L →
    H ⊓ centralizer (U L : Set G) = pCoreIn 2 H →
    ChapterC.IsAlternatingBlock L 5 → ∀ m : NaturalActionModel H L,
      ChapterB.Offenders.IsConjugateTo
        ((Stellmacher.elementaryAbelianMaxJ R).subgroupOf H |>.map m.quotient)
        (ChapterB.Offenders.D 5)

end CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.LocalIndex.Baumann.AlternatingFive

end
