module

public import CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.LocalIndex.Baumann.AlternatingFive.Transport
public import CFSG.Quasithin.ChapterB.Section02.RankLifting
public import CFSG.Quasithin.ChapterB.Section03.Offenders.SourceSylow


/-!
# The actual Thompson image in the alternating-five action

For each maximum-order elementary subgroup E of the supplied Sylow subgroup,
B.2.4 bounds the fixed codimension of its actual image. The absence of strong
offenders makes the bound an equality, so B.3.2(4) identifies every nontrivial
such image as a group generated by disjoint transpositions.

The common-normal exclusion supplies a nontrivial actual image, hence a
transposition in J(R)'s image. Together with the alternating image of L this
proves surjectivity onto S₅. Conjugating the actual Sylow image to the source
Sylow model puts all the maximum-elementary images, and therefore their
supremum, inside D. Characteristicity of J(R) transports to normalization by
that Sylow image. Its pair-interchange element sends either transposition
in D to the other one, proving equality with D.

The action model remains an explicit input, exactly as in `ThompsonImageInput`.
No arbitrary quotient offender is lifted and no Baumann containment is assumed.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
1 March 2004 manuscript, C.5.4(3), printed p.155; B.2.4, pp.75–76;
B.3.2(4), pp.83–84.
-/

public section

namespace CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.LocalIndex.Baumann.AlternatingFive
open Subgroup Stellmacher BinaryPermutation Representation.BinaryOffender ChapterB.Offenders
universe u
variable {G : Type u} [Group G] [Finite G]
variable {K : GroupClass.{u}} {A H R L : Subgroup G}

omit [Finite G] in
private theorem map_relative_fixed (V : Subgroup G) (hV : V ≤ H) (E : Subgroup H) :
    ((V.subgroupOf H) ⊓ centralizer (E : Set H)).map H.subtype =
      V ⊓ centralizer (E.map H.subtype : Set G) := by
  ext g
  constructor
  · rintro ⟨s, ⟨hsV, hsC⟩, rfl⟩
    refine ⟨hsV, ?_⟩
    rintro y ⟨b, hb, rfl⟩
    exact congrArg Subtype.val (hsC b hb)
  · rintro ⟨hgV, hgC⟩
    refine ⟨⟨g, hV hgV⟩, ⟨hgV, ?_⟩, rfl⟩
    intro b hb
    exact Subtype.ext (hgC b.val (mem_map_of_mem H.subtype hb))

private theorem actual_max_image_caseA (h : Configuration K A H R L)
    (hc : H ⊓ centralizer (U L : Set G) = pCoreIn 2 H)
    (m : NaturalActionModel H L) (E : Subgroup H)
    (hE : E ∈ elementaryAbelianMaxSubgroups (R.subgroupOf H))
    (hne : E.map m.quotient ≠ ⊥) : CaseAFamily 5 (E.map m.quotient) := by
  have hVH : U L ≤ H := module_le_L.trans (h.join_eq ▸ le_sup_left)
  let V := (U L).subgroupOf H
  let _ : V.Normal := (normal_subgroupOf_iff_le_normalizer hVH).mpr (normalizes_module h)
  let _ : IsElementaryAbelian 2 (U L) := module_elementary h
  let _ : IsElementaryAbelian 2 V := IsElementaryAbelian.subgroupOf hVH
  let _ : IsElementaryAbelian 2 E := hE.2.1
  have hker : m.quotient.ker = centralizer (V : Set H) := by
    rw [m.kernel]
    apply map_injective H.subtype_injective
    change pCoreIn 2 H = _
    rw [← hc]
    ext g
    constructor
    · rintro ⟨hgH, hgC⟩
      refine ⟨⟨g, hgH⟩, ?_, rfl⟩
      intro v hv
      exact Subtype.ext (hgC v.val hv)
    · rintro ⟨g, hgC, rfl⟩
      refine ⟨g.property, ?_⟩
      intro v hv
      exact congrArg Subtype.val (hgC ⟨v, hVH hv⟩ hv)
  have hrank : Nat.log 2 (Nat.card E) =
      Nat.log 2 (elementaryAbelianMaxOrder (R.subgroupOf H)) - 0 := by
    rw [maxOrder_eq_card_of_mem _ _ hE, Nat.sub_zero]
  have hbound := ChapterB.lemma_B_2_4_1 (R.subgroupOf H) V E
    (comap_mono (module_le_R h)) hE.1 0 hrank m.quotient hker hne
  have hvcard : Nat.card V = Nat.card (U L) :=
    Nat.card_congr (subgroupOfEquivOfLe hVH).toEquiv
  have hfcard : Nat.card (V ⊓ centralizer (E : Set H) : Subgroup H) =
      Nat.card (U L ⊓ centralizer (E.map H.subtype : Set G) : Subgroup G) := by
    rw [← map_relative_fixed (U L) hVH E]
    exact (card_map_of_injective H.subtype_injective).symm
  rw [Nat.sub_zero, hvcard, hfcard, fixed_codimension m E] at hbound
  have hel : IsElementaryTwo (E.map m.quotient) := ⟨hne, IsElementaryAbelian.map _⟩
  have hreverse := image_rank_le_fixed_codimension m E hel
  rw [fixed_codimension m E] at hreverse
  apply Odd.caseAFamily_of_elementary_and_fixedCodim_full_eq_rank (Or.inl rfl) hel
  rw [← fixedCodim_natural_eq_full_odd (Fin 5) (by decide)]
  exact le_antisymm hbound hreverse

private theorem caseA_contains_swap {B : Subgroup (Equiv.Perm (Fin 5))}
    (hB : CaseAFamily 5 B) : ∃ t ∈ B, t.IsSwap := by
  obtain ⟨n, hn, _, g, rfl⟩ := hB
  refine ⟨(MulAut.conj g) (pairSwap 5 0),
    mem_map.mpr ⟨_, pairSwap_mem 0 hn, rfl⟩, ?_⟩
  refine ⟨g 0, g 1, g.injective.ne (by decide), ?_⟩
  exact Equiv.symm_trans_swap_trans (0 : Fin 5) 1 g

private theorem caseA_map_conj {B : Subgroup (Equiv.Perm (Fin 5))}
    (hB : CaseAFamily 5 B) (c : Equiv.Perm (Fin 5)) :
    CaseAFamily 5 (B.map (MulAut.conj c).toMonoidHom) := by
  obtain ⟨n, hn, hn', g, rfl⟩ := hB
  refine ⟨n, hn, hn', c * g, ?_⟩
  rw [map_map]
  congr 1

private theorem actual_thompson_contains_swap (h : Configuration K A H R L)
    (hc : H ⊓ centralizer (U L : Set G) = pCoreIn 2 H)
    (m : NaturalActionModel H L) :
    ∃ t ∈ (elementaryAbelianMaxJ (R.subgroupOf H)).map m.quotient, t.IsSwap := by
  have hne : (elementaryAbelianMaxJ (R.subgroupOf H)).map m.quotient ≠ ⊥ := by
    rw [intrinsic_thompson (h.join_eq ▸ le_sup_right)]
    exact thompson_image_ne_bot h m
  have hex : ∃ E ∈ elementaryAbelianMaxSubgroups (R.subgroupOf H), E.map m.quotient ≠ ⊥ := by
    by_contra! hall
    apply hne
    apply (Subgroup.map_eq_bot_iff _).mpr
    exact sSup_le fun E hE => (Subgroup.map_eq_bot_iff _).mp (hall E hE)
  obtain ⟨E, hE, hEn⟩ := hex
  obtain ⟨t, ht, hswap⟩ := caseA_contains_swap (actual_max_image_caseA h hc m E hE hEn)
  exact ⟨t, map_mono (le_sSup hE) ht, hswap⟩

private theorem actual_quotient_surjective (h : Configuration K A H R L)
    (hc : H ⊓ centralizer (U L : Set G) = pCoreIn 2 H)
    (m : NaturalActionModel H L) : Function.Surjective m.quotient := by
  obtain ⟨t, ht, hs⟩ := actual_thompson_contains_swap h hc m
  have htR : t ∈ m.quotient.range := map_le_range _ _ ht
  have hAR : alternatingGroup (Fin 5) ≤ m.quotient.range := by
    rw [← m.block_image]
    exact map_le_range _ _
  have hdvd := index_dvd_of_le hAR
  rw [alternatingGroup.index_eq_two] at hdvd
  rcases (Nat.dvd_prime Nat.prime_two).mp hdvd with hi | hi
  · exact MonoidHom.range_eq_top.mp (index_eq_one.mp hi)
  · have he := Equiv.Perm.eq_alternatingGroup_of_index_eq_two hi
    rw [he, Equiv.Perm.mem_alternatingGroup, hs.sign_eq] at htR
    exact (by decide : (-1 : ℤˣ) ≠ 1) htR |>.elim

private theorem swap_in_D_cases {t : Equiv.Perm (Fin 5)}
    (ht : t ∈ ChapterB.Offenders.D 5) (hs : t.IsSwap) : t = pairSwap 5 0 ∨ t = pairSwap 5 1 := by
  let _ := Odd.elementary_disjointTranspositions (n := 5) (m := 2) (Or.inl rfl) (by decide)
  have hc := (le_centralizer_iff_isMulCommutative.mpr inferInstance :
    ChapterB.Offenders.D 5 ≤ centralizer (ChapterB.Offenders.D 5 : Set (Equiv.Perm (Fin 5)))) ht
  obtain ⟨a, b, hab, rfl⟩ := hs
  have hfinite : ∀ a b : Fin 5, a ≠ b →
      pairSwap 5 0 * Equiv.swap a b = Equiv.swap a b * pairSwap 5 0 →
      pairSwap 5 1 * Equiv.swap a b = Equiv.swap a b * pairSwap 5 1 →
      Equiv.swap a b = pairSwap 5 0 ∨ Equiv.swap a b = pairSwap 5 1 := by
    decide +kernel
  exact hfinite a b hab (hc _ (pairSwap_mem 0 (by decide)))
    (hc _ (pairSwap_mem 1 (by decide)))

private theorem eq_D_of_normalized_contains_swap
    (B : Subgroup (Equiv.Perm (Fin 5))) (hBD : B ≤ ChapterB.Offenders.D 5)
    (hn : ChapterB.Offenders.D 5 ⊔ exceptional 5 (by decide) ≤
      normalizer (B : Set (Equiv.Perm (Fin 5))))
    (ht : ∃ t ∈ B, t.IsSwap) : B = ChapterB.Offenders.D 5 := by
  have hk : kleinSecond 5 (by decide) ∈ normalizer (B : Set (Equiv.Perm (Fin 5))) :=
    hn (mem_sup_right (subset_closure (Or.inl (Or.inr (Set.mem_singleton _)))))
  have hconj {t : Equiv.Perm (Fin 5)} (ht : t ∈ B) :
      (MulAut.conj (kleinSecond 5 (by decide))) t ∈ B := by
    rw [mem_normalizer_iff_map_conj_eq] at hk
    rw [← hk]
    exact mem_map.mpr ⟨t, ht, rfl⟩
  have h01 : (MulAut.conj (kleinSecond 5 (by decide))) (pairSwap 5 0) = pairSwap 5 1 := by
    decide +kernel
  have h10 : (MulAut.conj (kleinSecond 5 (by decide))) (pairSwap 5 1) = pairSwap 5 0 := by
    decide +kernel
  obtain ⟨t, ht, hs⟩ := ht
  have hp : pairSwap 5 0 ∈ B ∧ pairSwap 5 1 ∈ B := by
    rcases swap_in_D_cases (hBD ht) hs with rfl | rfl
    · exact ⟨ht, h01 ▸ hconj ht⟩
    · exact ⟨h10 ▸ hconj ht, ht⟩
  apply le_antisymm hBD
  apply (closure_le _).mpr
  rintro g ⟨i, _, rfl⟩
  fin_cases i
  · exact hp.1
  · exact hp.2

omit [Finite G] in
private theorem sylow_normalizes_thompson (S : Subgroup H) :
    S ≤ normalizer (elementaryAbelianMaxJ S : Set H) := by
  intro x hx
  have hn := S.le_normalizer hx
  rw [mem_normalizer_iff_map_conj_eq] at hn ⊢
  change S.map (MulAut.conj x).toMonoidHom = S at hn
  change (elementaryAbelianMaxJ S).map (MulAut.conj x).toMonoidHom = elementaryAbelianMaxJ S
  rw [← elementaryAbelianMaxJ_map_equiv, hn]

private theorem swap_conj (c : Equiv.Perm (Fin 5)) {t : Equiv.Perm (Fin 5)}
    (hs : t.IsSwap) : ((MulAut.conj c) t).IsSwap := by
  obtain ⟨a, b, hab, rfl⟩ := hs
  exact ⟨c a, c b, c.injective.ne hab, Equiv.symm_trans_swap_trans a b c⟩

/-- The actual maximum-elementary Thompson subgroup has image conjugate to
    the group generated by two disjoint transpositions. -/
theorem thompsonImageInput : ThompsonImageInput (G := G) K := by
  intro A H R L h hc _ m
  have hRH : R ≤ H := h.join_eq ▸ le_sup_right
  have hsurj := actual_quotient_surjective h hc m
  obtain ⟨P, hP⟩ := h.sylow
  have hRP : R.subgroupOf H = (P : Subgroup H) := by
    apply map_injective H.subtype_injective
    rw [map_subgroupOf_eq_of_le hRH]
    exact hP.symm
  let P' := P.mapSurjective hsurj
  have hPimage : (R.subgroupOf H).map m.quotient = (P' : Subgroup (Equiv.Perm (Fin 5))) := by
    rw [hRP, Sylow.coe_mapSurjective]
  obtain ⟨T, hT⟩ := Odd.exists_sylow_containing_D_exceptional (n := 5) (Or.inl rfl)
  obtain ⟨c, hcP⟩ := MulAction.exists_smul_eq (Equiv.Perm (Fin 5)) P' T
  let f := (MulAut.conj c).toMonoidHom.comp m.quotient
  have hST : (R.subgroupOf H).map f = (T : Subgroup (Equiv.Perm (Fin 5))) := by
    dsimp only [f]
    rw [← map_map, hPimage]
    exact congrArg Sylow.toSubgroup hcP
  let J := elementaryAbelianMaxJ (R.subgroupOf H)
  -- Only images of actual maximum elementary subgroups enter this supremum.
  have hJD : J.map f ≤ ChapterB.Offenders.D 5 := by
    apply map_le_iff_le_comap.mpr
    apply sSup_le
    intro E hE
    apply map_le_iff_le_comap.mp
    by_cases hEn : E.map m.quotient = ⊥
    · dsimp only [f]
      rw [← map_map, hEn, Subgroup.map_bot]
      exact bot_le
    · apply Odd.caseAFamily_le_D_of_le_sylow (Or.inl rfl) T
        (hT ▸ le_sup_left)
      · dsimp only [f]
        rw [← map_map]
        exact caseA_map_conj (actual_max_image_caseA h hc m E hE hEn) c
      · rw [← hST]
        exact map_mono hE.1
  have hnorm : ChapterB.Offenders.D 5 ⊔ exceptional 5 (by decide) ≤
      normalizer (J.map f : Set (Equiv.Perm (Fin 5))) := by
    rw [← hT, ← hST]
    exact (map_mono (sylow_normalizes_thompson (R.subgroupOf H))).trans (le_normalizer_map f)
  -- The transposition witness excludes the central diagonal subgroup of D.
  have hswap : ∃ t ∈ J.map f, t.IsSwap := by
    obtain ⟨t, ht, hs⟩ := actual_thompson_contains_swap h hc m
    refine ⟨(MulAut.conj c) t, ?_, swap_conj c hs⟩
    dsimp only [f]
    rw [← map_map]
    exact mem_map.mpr ⟨t, ht, rfl⟩
  have hJ : J.map f = ChapterB.Offenders.D 5 := eq_D_of_normalized_contains_swap _ hJD hnorm hswap
  refine ⟨c⁻¹, ?_⟩
  rw [← intrinsic_thompson hRH]
  change J.map m.quotient = _
  apply map_injective (f := (MulAut.conj c).toMonoidHom) (MulAut.conj c).injective
  rw [map_map]
  change J.map f =
    ((ChapterB.Offenders.D 5).map (MulAut.conj c⁻¹).toMonoidHom).map (MulAut.conj c).toMonoidHom
  rw [hJ, map_map]
  have hinv : (MulAut.conj c).toMonoidHom.comp (MulAut.conj c⁻¹).toMonoidHom = MonoidHom.id _ := by
    ext x
    simp [MulAut.conj_apply]
  rw [hinv, map_id]

end CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.LocalIndex.Baumann.AlternatingFive

end
