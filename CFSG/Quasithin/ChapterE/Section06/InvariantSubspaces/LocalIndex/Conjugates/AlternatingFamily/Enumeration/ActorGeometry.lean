module

public import CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.LocalIndex.Conjugates.AlternatingFamily.Coordinates
public import CFSG.Quasithin.ChapterB.Section03.Offenders.Odd

/-!
# The five images in the alternating-five enumeration

The subgroup generated by `(0 1)` and `(2 3)` has exactly five subgroups.
The two transposition lines have fixed-space index two on the even-weight
module; the double-transposition line and the whole actor have index four.
In particular the double transposition detects the full actor's fixed space.
These are calculations in the actual permutation module, before transport to
centralizers in the source group.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), B.3.2,
printed pp.83–84, and the proof of C.5.6, printed pp.157–158.
-/

@[expose] public section
namespace CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.LocalIndex.Conjugates.AlternatingFamily.Enumeration
open Subgroup Representation.BinaryOffender

/-- The third nonidentity element of the commuting-transposition actor. -/
def doubleSwap : Perm := transposition 0 * transposition 1

/-- The line omitted from the maximum elementary family. -/
def diagonal : Subgroup Perm := zpowers doubleSwap

theorem transposition_order (i : Fin 2) : orderOf (transposition i) = 2 := by
  apply orderOf_eq_prime
  · fin_cases i <;> decide +kernel
  · fin_cases i <;> decide +kernel

theorem doubleSwap_order : orderOf doubleSwap = 2 := by
  apply orderOf_eq_prime <;> decide +kernel

theorem mem_diagonal (p : Perm) : p ∈ diagonal ↔ p = 1 ∨ p = doubleSwap := by
  rw [diagonal, mem_zpowers_iff_mem_range_orderOf, doubleSwap_order]
  simp [Finset.range_add_one, or_comm]

theorem line_card (i : Fin 2) : Nat.card (line i) = 2 := by
  rw [line, Nat.card_zpowers, transposition_order]

theorem diagonal_card : Nat.card diagonal = 2 := by
  rw [diagonal, Nat.card_zpowers, doubleSwap_order]

theorem actor_card : Nat.card (ChapterB.Offenders.D 5) = 4 := by
  exact ChapterB.Offenders.Odd.card_disjointTranspositions (Or.inl rfl) (by decide)

theorem actor_eq_sup : ChapterB.Offenders.D 5 = line 0 ⊔ line 1 := by
  apply le_antisymm
  · apply (closure_le _).mpr
    rintro g ⟨i, _, rfl⟩
    fin_cases i
    · exact mem_sup_left (mem_zpowers _)
    · exact mem_sup_right (mem_zpowers _)
  · exact sup_le
      (zpowers_le.mpr (ChapterB.Offenders.pairSwap_mem 0 (by decide)))
      (zpowers_le.mpr (ChapterB.Offenders.pairSwap_mem 1 (by decide)))

private def word : Fin 4 → Perm := ![1, transposition 0, transposition 1, doubleSwap]

/-- An elementwise description avoiding any decidability assumption on a subgroup. -/
theorem mem_actor (p : Perm) : p ∈ ChapterB.Offenders.D 5 ↔
    p = 1 ∨ p = transposition 0 ∨ p = transposition 1 ∨ p = doubleSwap := by
  have hrange : ∀ g ∈ ChapterB.Offenders.D 5, ∃ i, word i = g := by
    intro g hg
    induction hg using closure_induction with
    | mem g hg =>
      obtain ⟨i, _, rfl⟩ := hg
      fin_cases i
      · exact ⟨1, rfl⟩
      · exact ⟨2, rfl⟩
    | one => exact ⟨0, rfl⟩
    | mul g h _ _ hg hh =>
      obtain ⟨i, rfl⟩ := hg
      obtain ⟨j, rfl⟩ := hh
      have ht : ∀ i j, ∃ k, word k = word i * word j := by decide +kernel
      exact ht i j
    | inv g _ hg =>
      obtain ⟨i, rfl⟩ := hg
      have ht : ∀ i, ∃ j, word j = (word i)⁻¹ := by decide +kernel
      exact ht i
  constructor
  · intro hp
    obtain ⟨i, rfl⟩ := hrange p hp
    fin_cases i <;> simp [word]
  · rintro (rfl | rfl | rfl | rfl)
    · exact one_mem _
    · exact ChapterB.Offenders.pairSwap_mem 0 (by decide)
    · exact ChapterB.Offenders.pairSwap_mem 1 (by decide)
    · exact mul_mem (ChapterB.Offenders.pairSwap_mem 0 (by decide))
        (ChapterB.Offenders.pairSwap_mem 1 (by decide))

/-- Exhaustion of all subgroups of the order-four actor. -/
theorem subgroup_cases (B : Subgroup Perm) (hB : B ≤ ChapterB.Offenders.D 5) :
    B = ⊥ ∨ B = line 0 ∨ B = line 1 ∨ B = diagonal ∨ B = ChapterB.Offenders.D 5 := by
  classical
  have h01 : transposition 0 * doubleSwap = transposition 1 := by decide +kernel
  have h10 : transposition 1 * doubleSwap = transposition 0 := by decide +kernel
  by_cases h0 : transposition 0 ∈ B
  · by_cases h1 : transposition 1 ∈ B
    · right; right; right; right
      apply le_antisymm hB
      rw [actor_eq_sup]
      exact sup_le (zpowers_le.mpr h0) (zpowers_le.mpr h1)
    · right; left
      apply le_antisymm _ (zpowers_le.mpr h0)
      intro p hp
      rcases (mem_actor p).mp (hB hp) with rfl | rfl | rfl | rfl
      · exact one_mem _
      · exact mem_zpowers _
      · exact (h1 hp).elim
      · exact (h1 (h01 ▸ B.mul_mem h0 hp)).elim
  · by_cases h1 : transposition 1 ∈ B
    · right; right; left
      apply le_antisymm _ (zpowers_le.mpr h1)
      intro p hp
      rcases (mem_actor p).mp (hB hp) with rfl | rfl | rfl | rfl
      · exact one_mem _
      · exact (h0 hp).elim
      · exact mem_zpowers _
      · exact (h0 (h10 ▸ B.mul_mem h1 hp)).elim
    · by_cases hd : doubleSwap ∈ B
      · right; right; right; left
        apply le_antisymm _ (zpowers_le.mpr hd)
        intro p hp
        rcases (mem_actor p).mp (hB hp) with rfl | rfl | rfl | rfl
        · exact one_mem _
        · exact (h0 hp).elim
        · exact (h1 hp).elim
        · exact mem_zpowers _
      · left
        apply eq_bot_iff.mpr
        intro p hp
        rcases (mem_actor p).mp (hB hp) with rfl | rfl | rfl | rfl
        · exact one_mem _
        · exact (h0 hp).elim
        · exact (h1 hp).elim
        · exact (hd hp).elim

private theorem mem_fixed_zpowers (p : Perm) (v : Vector) :
    v ∈ fixedSpace (BinaryPermutation.coreRepresentation (Fin 5)) (zpowers p) ↔
      BinaryPermutation.coreRepresentation (Fin 5) p v = v := by
  rw [zpowers_eq_closure, mem_fixedSpace_closure_iff]
  simp

theorem mem_fixed_line_zero (v : Vector) :
    v ∈ fixedSpace (BinaryPermutation.coreRepresentation (Fin 5)) (line 0) ↔
      v.val 0 = v.val 1 := by
  rw [line, mem_fixed_zpowers, Subtype.ext_iff]
  exact BinaryPermutation.swap_fixed_iff (0 : Fin 5) 1 v.val

theorem mem_fixed_line_one (v : Vector) :
    v ∈ fixedSpace (BinaryPermutation.coreRepresentation (Fin 5)) (line 1) ↔
      v.val 2 = v.val 3 := by
  rw [line, mem_fixed_zpowers, Subtype.ext_iff]
  exact BinaryPermutation.swap_fixed_iff (2 : Fin 5) 3 v.val

theorem mem_fixed_actor (v : Vector) :
    v ∈ fixedSpace (BinaryPermutation.coreRepresentation (Fin 5)) (ChapterB.Offenders.D 5) ↔
      v.val 0 = v.val 1 ∧ v.val 2 = v.val 3 := by
  rw [ChapterB.Offenders.core_fixed_disjointTranspositions_iff]
  constructor
  · intro h
    exact ⟨h 0 (by decide), h 1 (by decide)⟩
  · rintro ⟨h0, h1⟩ i _
    fin_cases i
    · exact h0
    · exact h1

theorem mem_fixed_diagonal (v : Vector) :
    v ∈ fixedSpace (BinaryPermutation.coreRepresentation (Fin 5)) diagonal ↔
      v.val 0 = v.val 1 ∧ v.val 2 = v.val 3 := by
  rw [diagonal, mem_fixed_zpowers, Subtype.ext_iff]
  change (fun i => v.val (doubleSwap.symm i)) = v.val ↔ _
  constructor
  · intro hv
    exact ⟨(congrFun hv 0).symm, (congrFun hv 2).symm⟩
  · rintro ⟨h0, h1⟩
    funext i
    fin_cases i
    · exact h0.symm
    · exact h0
    · exact h1.symm
    · exact h1
    · rfl

/-- The double transposition is a single actor detecting the whole fixed space. -/
theorem fixed_actor_eq_diagonal :
    fixedSpace (BinaryPermutation.coreRepresentation (Fin 5)) (ChapterB.Offenders.D 5) =
      fixedSpace (BinaryPermutation.coreRepresentation (Fin 5)) diagonal := by
  ext v
  rw [mem_fixed_actor, mem_fixed_diagonal]

/-- The module really has sixteen elements. -/
theorem vector_card : Nat.card Vector = 16 := by
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2), BinaryPermutation.finrank_core]
  norm_num

private def fixedTest (i : Fin 2) (v : Fin 5 → ZMod 2) : Prop :=
  (∑ j, v j) = 0 ∧ if i = 0 then v 0 = v 1 else v 2 = v 3

private instance (i : Fin 2) (v : Fin 5 → ZMod 2) : Decidable (fixedTest i v) :=
  inferInstanceAs (Decidable (_ ∧ _))

set_option maxRecDepth 4096 in
/-- The two transpositions each fix eight vectors in the actual even-weight core. -/
theorem fixed_line_card (i : Fin 2) :
    Nat.card (fixedSpace (BinaryPermutation.coreRepresentation (Fin 5)) (line i)) = 8 := by
  let e : {v : Fin 5 → ZMod 2 // fixedTest i v} ≃
      fixedSpace (BinaryPermutation.coreRepresentation (Fin 5)) (line i) :=
    { toFun := fun v => ⟨⟨v.val, v.property.1⟩, by
        fin_cases i
        · exact (mem_fixed_line_zero _).mpr v.property.2
        · exact (mem_fixed_line_one _).mpr v.property.2⟩
      invFun := fun v => ⟨v.val.val, ⟨v.val.property, by
        fin_cases i
        · exact (mem_fixed_line_zero _).mp v.property
        · exact (mem_fixed_line_one _).mp v.property⟩⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  rw [← Nat.card_congr e, Nat.card_eq_fintype_card]
  fin_cases i <;> decide +kernel

/-- Both the whole actor and its diagonal line fix exactly four vectors. -/
theorem fixed_actor_card :
    Nat.card (fixedSpace (BinaryPermutation.coreRepresentation (Fin 5))
      (ChapterB.Offenders.D 5)) = 4 := by
  have hc := ChapterB.Offenders.Odd.fixedCodim_core_disjointTranspositions
    (n := 5) (m := 2) (Or.inl rfl) (by decide)
  have hd := fixedCodim_add_finrank (BinaryPermutation.coreRepresentation (Fin 5))
    (ChapterB.Offenders.D 5)
  rw [hc, BinaryPermutation.finrank_core] at hd
  have hdim : Module.finrank (ZMod 2)
      (fixedSpace (BinaryPermutation.coreRepresentation (Fin 5)) (ChapterB.Offenders.D 5)) = 2 := by
    norm_num at hd ⊢
    omega
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2), hdim]
  norm_num

theorem fixed_diagonal_card :
    Nat.card (fixedSpace (BinaryPermutation.coreRepresentation (Fin 5)) diagonal) = 4 := by
  rw [← fixed_actor_eq_diagonal, fixed_actor_card]

/-- The actual fixed-space index in the sixteen-element core. -/
noncomputable def fixedIndex (B : Subgroup Perm) : ℕ :=
  Nat.card Vector / Nat.card (fixedSpace (BinaryPermutation.coreRepresentation (Fin 5)) B)

theorem fixedIndex_bot : fixedIndex ⊥ = 1 := by
  rw [fixedIndex, fixedSpace_bot]
  rw [Nat.card_congr (Submodule.topEquiv : (⊤ : Submodule (ZMod 2) Vector) ≃ₗ[ZMod 2] Vector).toEquiv,
    vector_card]

theorem fixedIndex_line (i : Fin 2) : fixedIndex (line i) = 2 := by
  rw [fixedIndex, vector_card, fixed_line_card]

theorem fixedIndex_diagonal : fixedIndex diagonal = 4 := by
  rw [fixedIndex, vector_card, fixed_diagonal_card]

theorem fixedIndex_actor : fixedIndex (ChapterB.Offenders.D 5) = 4 := by
  rw [fixedIndex, vector_card, fixed_actor_card]

/-- Every possible image has order at most its fixed-space index. -/
theorem card_le_fixedIndex (B : Subgroup Perm) (hB : B ≤ ChapterB.Offenders.D 5) :
    Nat.card B ≤ fixedIndex B := by
  rcases subgroup_cases B hB with rfl | rfl | rfl | rfl | rfl
  · simp [fixedIndex_bot]
  · rw [line_card, fixedIndex_line]
  · rw [line_card, fixedIndex_line]
  · rw [diagonal_card, fixedIndex_diagonal]; decide
  · rw [actor_card, fixedIndex_actor]

/-- Exactly the double-transposition line gives a strict order deficit. -/
theorem card_eq_fixedIndex_iff (B : Subgroup Perm) (hB : B ≤ ChapterB.Offenders.D 5) :
    Nat.card B = fixedIndex B ↔ B ≠ diagonal := by
  have h0 : (⊥ : Subgroup Perm) ≠ diagonal := by
    intro he
    have hc := congrArg (fun X : Subgroup Perm => Nat.card X) he
    simp [diagonal_card] at hc
  have hl (i : Fin 2) : line i ≠ diagonal := by
    intro he
    have hm : transposition i ∈ diagonal := he ▸ mem_zpowers _
    rcases (mem_diagonal _).mp hm with hm | hm
    · have hn : transposition i ≠ 1 := by fin_cases i <;> decide +kernel
      exact hn hm
    · have hn : transposition i ≠ doubleSwap := by fin_cases i <;> decide +kernel
      exact hn hm
  have hD : ChapterB.Offenders.D 5 ≠ diagonal := by
    intro he
    have hc := congrArg (fun X : Subgroup Perm => Nat.card X) he
    rw [actor_card, diagonal_card] at hc
    omega
  rcases subgroup_cases B hB with rfl | rfl | rfl | rfl | rfl
  · simp [fixedIndex_bot, h0]
  · simp [line_card, fixedIndex_line, hl]
  · simp [line_card, fixedIndex_line, hl]
  · simp [diagonal_card, fixedIndex_diagonal]
  · simp [actor_card, fixedIndex_actor, hD]

end CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.LocalIndex.Conjugates.AlternatingFamily.Enumeration
end
