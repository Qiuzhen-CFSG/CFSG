module
public import Theory.GroupTheory.InvertingSupplement
public import CFSG.Quasithin.ChapterE.Section06.FixedPointBounds.ParabolicCartan.MarkedModels.Source
public import CFSG.Quasithin.ChapterE.Section06.FixedPointBounds.ParabolicCartan.MarkedModels.Tori.Reflections.RankOne

/-!
# Full Borel inversion data for the exchanged rank-one models

The binary PSL₂ and Suzuki Borels are generated by their normal root
two-subgroups and their full split tori. The concrete Weyl elements lie outside
the same Borels and invert every torus element. Transport through the original
marked model identifies this data in the source component image and its exact
overlap. Thus the source consumer obtains an inverted supplement whose index
is prime to each odd prime, without selecting a cyclic axis or changing the
specified overlap.

Source: Aschbacher–Smith, 4.4.13(1), printed pp.623–624, exchanged rank-one rows;
E.2.2 supplies the marked Borel models and E.6.27 their reflections.
-/

public noncomputable section
open Subgroup Theory.GroupTheory BenderSuzuki.Converse BenderSuzuki.MatrixGroups
namespace CFSG.Quasithin.ChapterE.Section06.FixedPointBounds.ParabolicCartan.NormalizerEscape
open MarkedModels

/-- The full binary projective linear Borel has an externally inverted
supplement to its normal root two-group. -/
theorem psl2_borel_inverting_supplement {F : Type*} [Field F] [Finite F] [CharP F 2]
    {f : ℕ} (hF : Nat.card F = 2 ^ f) : HasInvertingSupplement (PBorel F) := by
  obtain ⟨w,hw,hinv⟩ := Tori.exists_psl2Torus_reflection (F := F)
  have hgen : PUnip F ⊔ PTorus F = PBorel F := PUnip_sup_PTorus
  refine ⟨PUnip F,PTorus F,hgen ▸ le_sup_left,hgen ▸ le_sup_right,
    IsPGroup.of_card (by rw [PUnip_card,hF]),PUnip_normal_in_PBorel,hgen,w,hw,?_⟩
  intro c hc
  change c ∈ (Torus F).map (pi F) at hc
  rw [Torus_eq_range,MonoidHom.map_range] at hc
  obtain ⟨a,rfl⟩ := hc
  exact hinv a

/-- The literal Suzuki Borel has an externally inverted full split torus
supplement to its normal root two-group. -/
theorem suzuki_borel_inverting_supplement (m : ℕ) (hm : 0 < m) :
    HasInvertingSupplement (SuzukiBorelSubgroup m) := by
  obtain ⟨w,hw,hinv⟩ := Tori.exists_suzukiTorus_reflection m hm
  have hgen : SuzukiRootSubgroup m ⊔ SuzukiSplitTorus m = SuzukiBorelSubgroup m :=
    (suzukiBorelSubgroup_eq_sup m).symm
  refine ⟨SuzukiRootSubgroup m,SuzukiSplitTorus m,hgen ▸ le_sup_left,hgen ▸ le_sup_right,
    suzukiRootSubgroup_isPGroup m hm,suzukiRootSubgroup_normal_in_borel m,hgen,w,hw,?_⟩
  intro c hc
  obtain ⟨a,ha⟩ := (suzukiSplitTorus_equiv_units m hm).some.surjective ⟨c,hc⟩
  have he : (Tori.suzukiTorus m hm a : SuzukiMatrixGroup m) = c := congrArg Subtype.val ha
  rw [← he]
  exact hinv a

/-- The actual marked source overlap has the full Borel inversion data. -/
theorem ExchangedModel.inverting_supplement {X : Type*} [Group X]
    {M K : Subgroup X} {f : ℕ} (hm : ExchangedModel M K f) :
    HasInvertingSupplement (componentOverlap M K) := by
  rcases hm with ⟨F,hfield,hfin,hchar,_,hF,e,he⟩ | ⟨m,hm,_,e,he⟩
  · let := hfield
    let := hfin
    let := hchar
    have h : HasInvertingSupplement ((componentOverlap M K).map e.toMonoidHom) :=
      he ▸ psl2_borel_inverting_supplement hF
    simpa only [Subgroup.map_map,MulEquiv.toMonoidHom_eq_coe,
      MulEquiv.coe_monoidHom_symm_comp_coe_monoidHom,
      Subgroup.map_id] using h.map e.symm
  · have h : HasInvertingSupplement ((componentOverlap M K).map e.toMonoidHom) :=
      he ▸ suzuki_borel_inverting_supplement m (by omega)
    simpa only [Subgroup.map_map,MulEquiv.toMonoidHom_eq_coe,
      MulEquiv.coe_monoidHom_symm_comp_coe_monoidHom,
      Subgroup.map_id] using h.map e.symm

/-- The literal source component admits an outside inverting element for a
full supplement of index prime to every odd prime. This is the interface for
the subsequent full-Hall product and conjugacy argument. -/
theorem ExchangedModel.odd_index_inversion {X : Type*} [Group X] [Finite X]
    {M K : Subgroup X} {f : ℕ} (hm : ExchangedModel M K f) :
    ∃ C : Subgroup (sourceImage M K), C ≤ componentOverlap M K ∧
      (∀ (p : ℕ) [Fact p.Prime], Odd p →
        ¬ p ∣ (C.subgroupOf (componentOverlap M K)).index) ∧
      ∃ w : sourceImage M K, w ∉ componentOverlap M K ∧
        ∀ c ∈ C, w * c * w⁻¹ = c⁻¹ :=
  (ExchangedModel.inverting_supplement hm).odd_index_data

end CFSG.Quasithin.ChapterE.Section06.FixedPointBounds.ParabolicCartan.NormalizerEscape
