module

public import CFSG.Quasithin.ChapterE.Section06.Hyperplanes.SignalizerElimination.Terminal
public import Theory.GroupTheory.Fitting.Core
public import CFSG.Quasithin.ChapterE.Section06.Hyperplanes.SignalizerElimination.Contracts

/-!
# Maximal prime-core globalization in E.6.20

For an odd prime p, coprime fixed-point generation places O_p(C_G(A))
inside the closure generated by the hyperplane p-cores above A. Choose a
centralizer p-core of maximal order among subspaces of corank at most two.
Any hyperplane and that subspace have an intersection containing a subspace
of corank three. If the local identity (*) is available there, maximality
makes its local closure equal the chosen core. This proves the global
identity (**), without the false direct-sum clause of the printed A.1.17.

A nonzero odd core supplies a nonzero odd-prime core via its solvable Fitting
subgroup. The final conditional theorem combines globalization with E.6.16–17
and the terminal obstruction to eliminate every hyperplane odd core. Local
prime localization remains an explicit intermediate premise; this module
therefore does not claim the source E.6.20 until the signalizer lifting,
inversion and rank argument have supplied that premise.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), E.6.20,
printed pp.252–253 (PDF pp.263–264), especially identity (**).
-/

public section

open Subgroup
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterE.Section06.Hyperplanes.SignalizerElimination
variable {G : Type*} [Group G] [Finite G] {V : Subgroup G}

private theorem relIndex_pow [IsElementaryAbelian 2 V] (A : Subgroup G) :
    A.relIndex V = 2 ^ subgroupCorank V A := by
  rw [subgroupCorank_eq_quotient_finrank]
  exact Subgroup.relIndex_eq_two_pow_quotient_finrank V A

/-- A subspace of corank at most k contains one of corank exactly k. -/
theorem exists_subspace_corank [IsElementaryAbelian 2 V]
    {A : Subgroup G} (hAV : A ≤ V) {k : ℕ}
    (hk : k ≤ Module.finrank (ZMod 2) (Additive V)) (hA : subgroupCorank V A ≤ k) :
    ∃ U₀ : Subgroup G, U₀ ≤ A ∧ subgroupCorank V U₀ = k := by
  let n := Module.finrank (ZMod 2) (Additive V)
  obtain ⟨a, ha⟩ := ((IsElementaryAbelian.isPGroup 2 V).to_le hAV).exists_card_eq
  have hcard := Subgroup.relIndex_mul_relIndex (⊥ : Subgroup G) A V bot_le hAV
  simp only [Subgroup.relIndex_bot_left] at hcard
  have hVcard : Nat.card V = 2 ^ n := by
    rw [← Subgroup.relIndex_bot_left, relIndex_pow, corank_bot]
  rw [ha, relIndex_pow, hVcard, ← pow_add] at hcard
  have hn : a + subgroupCorank V A = n := (Nat.pow_right_injective (by decide : 2 ≤ 2)) hcard
  obtain ⟨B, hB⟩ := Sylow.exists_subgroup_card_pow_prime_of_le_card Nat.prime_two
    ((IsElementaryAbelian.isPGroup 2 V).to_le hAV)
    (show 2 ^ (n - k) ≤ Nat.card A by rw [ha]; exact Nat.pow_le_pow_right (by decide) (by omega))
  let U₀ := B.map A.subtype
  have hU : U₀ ≤ A := map_subtype_le B
  have hUcard : Nat.card U₀ = 2 ^ (n - k) := by
    rw [Subgroup.card_map_of_injective A.subtype_injective, hB]
  refine ⟨U₀, hU, ?_⟩
  have hmul := Subgroup.relIndex_mul_relIndex (⊥ : Subgroup G) U₀ V bot_le (hU.trans hAV)
  rw [Subgroup.relIndex_bot_left, Subgroup.relIndex_bot_left, hUcard, relIndex_pow,
    hVcard, ← pow_add] at hmul
  have he := (Nat.pow_right_injective (by decide : 2 ≤ 2)) hmul
  dsimp [n] at he
  omega

omit [Finite G] in
/-- Restricting a relatively normal prime core to a smaller centralizer. -/
theorem primeCentralizer_inter_le (p : ℕ) {A B : Subgroup G} (hAB : A ≤ B) :
    primeCentralizer p A ⊓ centralizer (B : Set G) ≤ primeCentralizer p B := by
  apply le_pCoreIn_of_normalizes
  · exact (isPGroup_pCoreIn p (centralizer (A : Set G))).to_le inf_le_left
  · exact inf_le_right
  · exact (le_inf ((Subgroup.centralizer_le hAB).trans
      (centralizer_le_normalizer_primeCentralizer p A))
      (centralizer (B : Set G)).le_normalizer).trans inf_normalizer_le_normalizer_inf

private theorem cyclic_corank [IsElementaryAbelian 2 V]
    (B : Subgroup V) (hB : IsCyclic (V ⧸ B)) :
    subgroupCorank V (B.map V.subtype) ≤ 1 := by
  let _ := hB
  have hd : Nat.card (V ⧸ B) ∣ 2 := by
    rw [← IsCyclic.exponent_eq_card]
    exact IsElementaryAbelian.exponent_dvd_p 2 (V ⧸ B)
  have hrel : (B.map V.subtype).relIndex V = Nat.card (V ⧸ B) := by
    rw [Subgroup.relIndex, Subgroup.subgroupOf, Subgroup.comap_map_eq,
      V.ker_subtype, sup_bot_eq, Subgroup.index_eq_card]
  have hle := Nat.le_of_dvd (by decide : 0 < 2) hd
  rw [← hrel, relIndex_pow] at hle
  exact (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp (by simpa using hle)

/-- The valid coprime generation clause puts each prime core into the local
hyperplane closure, with no direct-sum assertion. -/
theorem primeCentralizer_le_localPrimeClosure [IsElementaryAbelian 2 V]
    (p : ℕ) [Fact p.Prime] (hp : Odd p)
    (hzero : primeCentralizer p V = ⊥)
    {U₀ A : Subgroup G} (hUA : U₀ ≤ A) (hAV : A ≤ V) :
    primeCentralizer p A ≤ localPrimeClosure p V U₀ := by
  let C := centralizer (A : Set G)
  let P := pCore p C
  have hVC : V ≤ C := V.le_centralizer.trans (Subgroup.centralizer_le hAV)
  let f : V →* C := inclusion hVC
  let act : V →* MulAut P := (MulAut.conjNormal : C →* MulAut P).comp f
  let _ : MulDistribMulAction V P := MulDistribMulAction.compHom P act
  let _ : Fact (IsPGroup 2 V) := ⟨IsElementaryAbelian.isPGroup 2 V⟩
  have hodd : Nat.Coprime 2 (Nat.card P) := by
    obtain ⟨n, hn⟩ := IsPGroup.iff_card.mp (pCore_isPGroup (p := p) (G := C))
    rw [hn]
    exact hp.pow.coprime_two_left
  have hgen := iSup_fixedPoints_cyclicQuot_eq_top_of_coprime_abelian_pGroup_action
    (G := P) (A := V) 2 hodd
  let L := localPrimeClosure p V U₀
  have htop : (⊤ : Subgroup P) ≤ L.comap (C.subtype.comp P.subtype) := by
    rw [← hgen]
    refine iSup₂_le fun B hB => ?_
    intro y hy
    let W := B.map V.subtype
    have hWV : W ≤ V := Subgroup.map_subtype_le B
    have hcor : subgroupCorank V (A ⊔ W) ≤ 1 :=
      (subgroupCorank_antitone (show W ≤ A ⊔ W from le_sup_right)).trans
        (cyclic_corank B hB)
    have hfix : ((y : C) : G) ∈ centralizer (W : Set G) := by
      rintro w ⟨b, hb, rfl⟩
      have he := (show ∀ a : B, a • y = y from hy) ⟨b, hb⟩
      have he' : (b : G) * ((y : C) : G) * (b : G)⁻¹ = ((y : C) : G) :=
        congrArg (fun x : P => ((x : C) : G)) he
      exact mul_inv_eq_iff_eq_mul.mp he'
    have hcentral : ((y : C) : G) ∈ centralizer (↑(A ⊔ W) : Set G) := by
      have hcy : A ⊔ W ≤ centralizer ({((y : C) : G)} : Set G) := by
        apply sup_le
        · intro a ha
          exact mem_centralizer_singleton_iff.mpr (y.val.property a ha)
        · intro w hw
          exact mem_centralizer_singleton_iff.mpr (hfix w hw)
      intro x hx
      exact mem_centralizer_singleton_iff.mp (hcy hx)
    have hm : ((y : C) : G) ∈ primeCentralizer p (A ⊔ W) :=
      primeCentralizer_inter_le p le_sup_left ⟨⟨y, y.property, rfl⟩, hcentral⟩
    change ((y : C) : G) ∈ L
    by_cases h0 : subgroupCorank V (A ⊔ W) = 0
    · have heq : A ⊔ W = V := le_antisymm (sup_le hAV hWV)
        ((corank_eq_zero_iff (A ⊔ W)).mp h0)
      rw [heq, hzero, mem_bot] at hm
      exact hm ▸ L.one_mem
    · exact (le_iSup (fun W : {W : Subgroup G // U₀ ≤ W ∧ IsHyperplane V W} =>
        primeCentralizer p W.val) ⟨A ⊔ W, hUA.trans le_sup_left,
          sup_le hAV hWV, by omega⟩) hm
  rintro x ⟨y, hy, rfl⟩
  exact htop (mem_top (⟨y, hy⟩ : P))

/-- Maximal core order turns the corank-three local identities into (**). -/
theorem exists_global_prime_core [IsElementaryAbelian 2 V]
    (p : ℕ) [Fact p.Prime] (hp : Odd p)
    (hdim : 3 ≤ Module.finrank (ZMod 2) (Additive V))
    (hzero : primeCentralizer p V = ⊥)
    (hlocal : LocalPrimeLocalization p V) :
    ∃ U₄ : Subgroup G, U₄ ≤ V ∧ subgroupCorank V U₄ ≤ 2 ∧
      globalPrimeClosure p V = primeCentralizer p U₄ := by
  let S : Set (Subgroup G) := {A | A ≤ V ∧ subgroupCorank V A ≤ 2}
  have hS : S.Nonempty := ⟨V, le_rfl, by
    have hz : subgroupCorank V V = 0 := (corank_eq_zero_iff V).mpr le_rfl
    simp only [hz, zero_le]⟩
  obtain ⟨U₄, hU₄, hmax⟩ := Set.exists_max_image S
    (fun A => Nat.card (primeCentralizer p A)) (Set.toFinite S) hS
  refine ⟨U₄, hU₄.1, hU₄.2, le_antisymm ?_ ?_⟩
  · refine iSup_le fun W => ?_
    have hc : subgroupCorank V (U₄ ⊓ W.val) ≤ 3 :=
      (corank_inf_le U₄ W.val).trans (by have hw := W.property.2; have hu := hU₄.2; omega)
    obtain ⟨U₀, hU₀, hc₀⟩ := exists_subspace_corank
      (show U₄ ⊓ W.val ≤ V from inf_le_left.trans hU₄.1) hdim hc
    obtain ⟨U₅, h05, h5V, hc5, heq⟩ := hlocal U₀
      (hU₀.trans (inf_le_left.trans hU₄.1)) hc₀
    have hY : primeCentralizer p U₄ ≤ primeCentralizer p U₅ := by
      rw [← heq]
      exact primeCentralizer_le_localPrimeClosure p hp hzero
        (hU₀.trans inf_le_left) hU₄.1
    have h54 : primeCentralizer p U₄ = primeCentralizer p U₅ :=
      eq_of_le_of_card_ge hY (hmax U₅ ⟨h5V, hc5⟩)
    rw [h54, ← heq]
    exact le_iSup (fun W : {W : Subgroup G // U₀ ≤ W ∧ IsHyperplane V W} =>
      primeCentralizer p W.val) ⟨W.val, hU₀.trans inf_le_right, W.property⟩
  · exact (primeCentralizer_le_localPrimeClosure p hp hzero
      (U₀ := ⊥) bot_le hU₄.1).trans (localPrimeClosure_le_global p V ⊥)

/-- A nontrivial odd core has a nontrivial characteristic prime core at an odd prime. -/
theorem exists_odd_prime_core_of_oddCentralizer_ne_bot {A : Subgroup G}
    (hne : oddCentralizer A ≠ ⊥) :
    ∃ p : ℕ, p.Prime ∧ Odd p ∧ primeCentralizer p A ≠ ⊥ := by
  classical
  let C := centralizer (A : Set G)
  let O := pPrimeCore 2 C
  have hO : O ≠ ⊥ := mt (oddCentralizer_eq_bot_iff A).mpr hne
  have hodd : Odd (Nat.card O) := Nat.coprime_two_left.mp pPrimeCore_coprime_card
  let _ : Group.IsSolvable O := odd_order_theorem O hodd
  have hfit : fittingSubgroup O ≠ ⊥ := by
    intro he
    have hc := (fitting_eq_bot_iff_card_eq_one_of_solvable O).mp he
    exact hO (O.eq_bot_of_card_le hc.le)
  have hex : ∃ q : (Nat.card O).primeFactors.attach, pCore q.val.val O ≠ ⊥ := by
    by_contra! hn
    apply hfit
    rw [fitting_eq_sup_pCore]
    exact le_bot_iff.mp (iSup_le fun q => (hn q).le)
  obtain ⟨q, hq⟩ := hex
  let p := q.val.val
  have hp : p.Prime := Nat.prime_of_mem_primeFactors q.val.property
  let _ : Fact p.Prime := ⟨hp⟩
  have hple : (pCore p O).map O.subtype ≤ pCore p C :=
    le_sSup ⟨inferInstance, pCore_isPGroup.map O.subtype⟩
  refine ⟨p, hp, hodd.of_dvd_nat (Nat.dvd_of_mem_primeFactors q.val.property), ?_⟩
  intro he
  have hC : pCore p C = ⊥ := Subgroup.map_injective C.subtype_injective
    (by simpa only [primeCentralizer, pCoreIn, Subgroup.map_bot] using he)
  have hmap : (pCore p O).map O.subtype = ⊥ := le_bot_iff.mp (hC ▸ hple)
  exact hq (Subgroup.map_injective O.subtype_injective (by simpa using hmap))

/-- Conditional assembly after local prime localization. The source E.6.20
remains open until that localization has been proved from the lifted signalizer. -/
theorem oddCentralizer_eq_bot_of_localization
    {K : CFSG.Quasithin.GroupClass} {T : Sylow 2 G} {M : Subgroup G}
    [IsElementaryAbelian 2 V] (h : HypothesisE61 K T M V)
    (h15 : HypothesisE615 V)
    (h6 : ∀ A : Subgroup G, A ≠ ⊥ → A ≤ M → IsPGroup 2 A →
      HasCharacteristicTwo ↥(M ⊓ centralizer (A : Set G)))
    (h13 : ∀ A ∈ obstructionFamily M V, ¬ (T : Subgroup G) ≤ normalizer (A : Set G))
    (hlocal : 2 < localM V →
      6 ≤ Module.finrank (ZMod 2) (Additive V) →
      ∀ p : ℕ, p.Prime → Odd p → LocalPrimeLocalization p V)
    {U : Subgroup G} (hU : IsHyperplane V U) : oddCentralizer U = ⊥ := by
  by_contra hne
  have hUne : U ≠ ⊥ := by
    intro he
    have hc : 1 < globalR V ∨ 2 < localM V := h15
    have hz : subgroupCorank V U = 1 := hU.2
    rw [he, corank_bot] at hz
    rcases hc with hr | hm
    · have hcentral : centralizer (U : Set G) ≤ normalizer (V : Set G) :=
        centralizer_le_normalizer_of_corank_lt_globalR hU.1 (by rw [hU.2]; exact hr)
      have hM : M = ⊤ := top_unique (by
        intro g _
        apply h.normalizer_le
        apply hcentral
        intro a ha
        have ha1 : a = 1 := by
          change a ∈ U at ha
          rw [he, mem_bot] at ha
          exact ha
        simp only [ha1, one_mul, mul_one])
      let _ := h.simpleQTKE.simple
      exact twoLocal_ne_top_of_nonabelian_simple h.simpleQTKE.nonabelian
        h.maximalTwoLocal.1 hM
    · have hbound := moduleM_le_dimension (automizerRepresentation V)
      change localM V ≤ _ at hbound
      omega
  have hescape : ¬ centralizer (U : Set G) ≤ M :=
    fun hc => hne (oddCentralizer_eq_bot_of_le_M h h6 hUne hU.1 hc)
  obtain ⟨hr, _, _⟩ := lemma_E_6_16_1 h h15 hU hescape
  obtain ⟨hm, hdim⟩ := lemma_E_6_17 h h15 h13 hr
  obtain ⟨p, hp, hpodd, hpne⟩ := exists_odd_prime_core_of_oddCentralizer_ne_bot hne
  let _ : Fact p.Prime := ⟨hp⟩
  have hVzero : oddCentralizer V = ⊥ :=
    oddCentralizer_eq_bot_of_le_M h h6 h.nontrivial le_rfl h.centralizer_le
  have hpVzero : primeCentralizer p V = ⊥ := le_bot_iff.mp
    (hVzero ▸ primeCentralizer_le_oddCentralizer p hpodd V)
  obtain ⟨U₄, h4V, hc4, hglobal⟩ := exists_global_prime_core p hpodd (by omega)
    hpVzero (hlocal hm hdim p hp hpodd)
  have h4ne : primeCentralizer p U₄ ≠ ⊥ := by
    intro he
    have hle : primeCentralizer p U ≤ globalPrimeClosure p V :=
      le_iSup (fun W : {W : Subgroup G // IsHyperplane V W} => primeCentralizer p W.val)
        ⟨U, hU⟩
    rw [hglobal, he] at hle
    exact hpne (le_bot_iff.mp hle)
  exact false_of_global_prime_core h h6 h13 p hpodd U₄ h4V (by omega) h4ne hglobal

end CFSG.Quasithin.ChapterE.Section06.Hyperplanes.SignalizerElimination

