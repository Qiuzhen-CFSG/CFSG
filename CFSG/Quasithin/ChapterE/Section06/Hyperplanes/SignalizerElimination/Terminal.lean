module

public import CFSG.Quasithin.ChapterE.Section06.Hyperplanes.Preliminaries
public import CFSG.Quasithin.ChapterE.Section06.Hyperplanes.OddCoreGeneration
public import CFSG.Quasithin.ChapterE.Section06.Hyperplanes.QuotientGeometry
public import CFSG.Quasithin.ChapterE.Section06.Hyperplanes.SignalizerElimination.Setup
public import Theory.Quasithin.EvenCharacteristic
public import Theory.GroupTheory.SylowKernelCore

/-!
# The terminal obstruction in the E.6.20 signalizer argument

Conjugation by N_G(V) permutes the hyperplanes and their embedded prime
cores, hence normalizes their generated subgroup. If this generated subgroup
is a nontrivial prime core of a centralizer of corank below m, its centralizer
in V is a T-invariant member of Γ. E.6.13 excludes it. The escaping-centralizer
clause follows from E.6.6(2), with all core normality relative to the displayed
centralizers.

The maximal-prime-core generation equality remains an explicit intermediate
input here. Establishing that equality from the completed signalizer, and
transporting E.6.19 balance to the quotient, are still required for E.6.20.
The exact earlier E.6.6(2) and E.6.13 statements are explicit source inputs.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), E.6.20,
printed pp.252–253 (PDF pp.263–264), especially the final paragraph.
-/

public section

open Subgroup
open scoped IsMulCommutative

namespace CFSG.Quasithin.ChapterE.Section06.Hyperplanes.SignalizerElimination

variable {G : Type*} [Group G]

/-- The group generated by the hyperplane p-cores is normalized by N_G(V).
This assertion concerns its generation formula, without assuming it is a p-group. -/
theorem normalizer_le_normalizer_globalPrimeClosure (p : ℕ) (V : Subgroup G) :
    normalizer (V : Set G) ≤ normalizer (globalPrimeClosure p V : Set G) := by
  apply Subgroup.le_normalizer_iff.mpr
  intro g hg x hx
  have hmap : (globalPrimeClosure p V).map (MulAut.conj g).toMonoidHom ≤
      globalPrimeClosure p V := by
    rw [globalPrimeClosure, Subgroup.map_iSup]
    refine iSup_le fun W => ?_
    change ((centralizer (W.val : Set G)).pCoreIn p).map (MulAut.conj g).toMonoidHom ≤ _
    rw [map_pCoreIn_of_injective p _ _ (MulAut.conj g).injective,
      Theory.Quasithin.map_centralizer]
    have hW : IsHyperplane V (W.val.map (MulAut.conj g).toMonoidHom) := by
      refine ⟨?_, (corank_conjugate V W.val g hg).trans W.property.2⟩
      have hle := Subgroup.map_mono (f := (MulAut.conj g).toMonoidHom) W.property.1
      have heq : V.map (MulAut.conj g).toMonoidHom = V :=
        mem_normalizer_iff_map_conj_eq.mp hg
      exact hle.trans heq.le
    exact le_iSup (fun A : {A : Subgroup G // IsHyperplane V A} =>
      primeCentralizer p A.val) ⟨_, hW⟩
  exact hmap (mem_map_of_mem (MulAut.conj g).toMonoidHom hx)

/-- The p-core is normal in its centralizer, not necessarily in G. -/
theorem centralizer_le_normalizer_primeCentralizer (p : ℕ) (A : Subgroup G) :
    centralizer (A : Set G) ≤ normalizer (primeCentralizer p A : Set G) :=
  (centralizer (A : Set G)).le_normalizer.trans
    (normalizer_le_normalizer_characteristic_image _ (pCore p (centralizer (A : Set G))))

variable [Finite G]

/-- An odd-prime core is contained in the odd core of the same centralizer. -/
theorem primeCentralizer_le_oddCentralizer (p : ℕ) [Fact p.Prime]
    (hp : Odd p) (A : Subgroup G) : primeCentralizer p A ≤ oddCentralizer A := by
  apply Subgroup.map_mono
  apply le_sSup
  refine ⟨inferInstance, ?_⟩
  obtain ⟨n, hn⟩ := IsPGroup.iff_card.mp (pCore_isPGroup (p := p) (G := centralizer (A : Set G)))
  rw [hn]
  exact Nat.coprime_two_left.mpr hp.pow

/-- E.6.6(2) forces vanishing of the odd core whenever the subspace centralizer
is contained in M. This is an earlier input, stated in the self-centralizing-core convention. -/
theorem oddCentralizer_eq_bot_of_le_M
    {K : CFSG.Quasithin.GroupClass} {T : Sylow 2 G} {M V : Subgroup G}
    [IsElementaryAbelian 2 V] (h : HypothesisE61 K T M V)
    (h6 : ∀ A : Subgroup G, A ≠ ⊥ → A ≤ M → IsPGroup 2 A →
      HasCharacteristicTwo ↥(M ⊓ centralizer (A : Set G)))
    {A : Subgroup G} (hA : A ≠ ⊥) (hAV : A ≤ V)
    (hCM : centralizer (A : Set G) ≤ M) : oddCentralizer A = ⊥ := by
  have hchar := h6 A hA (hAV.trans (h.le_sylow.trans h.sylow_le))
    ((IsElementaryAbelian.isPGroup 2 V).to_le hAV)
  rw [inf_eq_right.mpr hCM] at hchar
  exact (oddCentralizer_eq_bot_iff A).mpr
    (Theory.GroupTheory.pPrimeCore_eq_bot_of_centralizer_pCore_le 2 hchar)

/-- The completed maximal-core generation identity produces the forbidden
T-invariant member of Γ. The identity itself is still a proof obligation. -/
theorem false_of_global_prime_core
    {K : CFSG.Quasithin.GroupClass} {T : Sylow 2 G} {M V : Subgroup G}
    [IsElementaryAbelian 2 V] (h : HypothesisE61 K T M V)
    (h6 : ∀ A : Subgroup G, A ≠ ⊥ → A ≤ M → IsPGroup 2 A →
      HasCharacteristicTwo ↥(M ⊓ centralizer (A : Set G)))
    (h13 : ∀ A ∈ obstructionFamily M V, ¬ (T : Subgroup G) ≤ normalizer (A : Set G))
    (p : ℕ) [Fact p.Prime] (hp : Odd p)
    (U₄ : Subgroup G) (hU : U₄ ≤ V) (hsmall : subgroupCorank V U₄ < localM V)
    (hne : primeCentralizer p U₄ ≠ ⊥)
    (hgen : globalPrimeClosure p V = primeCentralizer p U₄) : False := by
  let Y := primeCentralizer p U₄
  let C := V ⊓ centralizer (Y : Set G)
  have hUC : U₄ ≤ C :=
    le_inf hU (le_centralizer_iff.mpr (pCoreIn_le p (centralizer (U₄ : Set G))))
  have hCsmall : subgroupCorank V C < localM V :=
    (subgroupCorank_antitone hUC).trans_lt hsmall
  have hCne : C ≠ ⊥ := nontrivial_of_corank_lt_localM hCsmall
  have hCY : centralizer (C : Set G) ≤ normalizer (Y : Set G) :=
    (Subgroup.centralizer_le hUC).trans (centralizer_le_normalizer_primeCentralizer p U₄)
  have hYcore : Y ≤ primeCentralizer p C :=
    le_pCoreIn_of_normalizes (isPGroup_pCoreIn p (centralizer (U₄ : Set G)))
      (le_centralizer_iff.mpr (show C ≤ centralizer (Y : Set G) from inf_le_right)) hCY
  have hescape : ¬ centralizer (C : Set G) ≤ M := by
    intro hCM
    have hzero := oddCentralizer_eq_bot_of_le_M h h6 hCne inf_le_left hCM
    exact hne (le_bot_iff.mp (hzero ▸ hYcore.trans (primeCentralizer_le_oddCentralizer p hp C)))
  have hCGamma : C ∈ obstructionFamily M V := small_escape_mem h inf_le_left hCsmall hescape
  have hTY : (T : Subgroup G) ≤ normalizer (Y : Set G) := by
    change (T : Subgroup G) ≤ normalizer (primeCentralizer p U₄ : Set G)
    rw [← hgen]
    exact h.sylow_le_normalizer.trans (normalizer_le_normalizer_globalPrimeClosure p V)
  have hTCY : (T : Subgroup G) ≤ normalizer (centralizer (Y : Set G) : Set G) := by
    intro t ht
    apply mem_normalizer_iff_map_conj_eq.mpr
    change (centralizer (Y : Set G)).map (MulAut.conj t).toMonoidHom = _
    rw [Theory.Quasithin.map_centralizer]
    exact congrArg (fun B : Subgroup G => centralizer (B : Set G))
      (mem_normalizer_iff_map_conj_eq.mp (hTY ht))
  exact h13 C hCGamma ((le_inf h.sylow_le_normalizer hTCY).trans
    inf_normalizer_le_normalizer_inf)

end CFSG.Quasithin.ChapterE.Section06.Hyperplanes.SignalizerElimination
