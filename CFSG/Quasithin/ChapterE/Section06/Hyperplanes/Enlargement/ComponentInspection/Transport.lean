module
public import CFSG.Quasithin.ChapterE.Section06.Hyperplanes.Enlargement.ComponentInspection.Setup
public import Theory.GroupAction.AutomorphismFixedTransport
public import Theory.GroupTheory.GeneralizedFitting.ComponentExclusion

/-!
# Transport of the Sylow-central component inspection

An automorphism group of order two is generated by one involution. Its common
fixed subgroup is exactly that involution's fixed subgroup. Transporting this
subgroup through an actual model equivalence preserves ordinary components.

Source: Aschbacher–Smith, E.6.22, printed p.254 (PDF p.265).
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterE.Section06.Hyperplanes.Enlargement.ComponentInspection

variable {Y Z : Type*} [Group Y] [Group Z] [Finite Y]

/-- Reduce the intrinsic inspection to the fixed subgroup in an actual model. -/
theorem noCentralInvolutionComponent_of_fixedSubgroup
    (e : Y ≃* Z)
    (hc : ∀ (a : MulAut Z), orderOf a = 2 → ∀ S : Sylow 2 Z,
      (∀ x ∈ (S : Subgroup Z), a x = x) →
      ∀ D : Subgroup a.fixedSubgroup, ¬ IsComponent a.fixedSubgroup D) :
    NoCentralInvolutionComponent Y := by
  intro P hP hS D hD
  obtain ⟨S, hS⟩ := hS
  let : IsCyclic P := isCyclic_of_prime_card hP
  obtain ⟨a, ha⟩ := IsCyclic.exists_generator (α := P)
  have hao : orderOf (a : MulAut Y) = 2 := by
    rw [orderOf_coe]
    exact (orderOf_eq_card_of_forall_mem_zpowers ha).trans hP
  have hfixed : FixedPoints.subgroup P Y = (a : MulAut Y).fixedSubgroup := by
    ext x
    rw [MulAut.mem_fixedSubgroup]
    constructor
    · intro hx
      exact hx a
    · intro hx b
      have hle : zpowers a ≤ MulAction.stabilizer P x := zpowers_le.mpr hx
      exact hle (ha b)
  let b := MulAut.congr e (a : MulAut Y)
  let R := S.mapSurjective (f := e.toMonoidHom) e.surjective
  have hb : orderOf b = 2 := ((MulAut.congr e).orderOf_eq _).trans hao
  have hR : ∀ x ∈ (R : Subgroup Z), b x = x := by
    rintro x ⟨y, hy, rfl⟩
    change e ((a : MulAut Y) (e.symm (e y))) = e y
    rw [e.symm_apply_apply, hS a ⟨y, hy⟩]
  let c := (MulEquiv.subgroupCongr hfixed).trans (MulAut.fixedSubgroupCongr e a)
  exact hc b hb R hR _ (hD.2.map_equiv c)

end CFSG.Quasithin.ChapterE.Section06.Hyperplanes.Enlargement.ComponentInspection
