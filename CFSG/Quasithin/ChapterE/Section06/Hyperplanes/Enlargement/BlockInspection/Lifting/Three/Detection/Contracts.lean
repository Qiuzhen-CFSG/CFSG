module

public import CFSG.Quasithin.ChapterE.Section06.Hyperplanes.Enlargement.BlockInspection.Lifting.Three.Setup
public import CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.BlockSelection.Contracts

/-!
# Centralizer factorization for the A₃ envelope

The remaining geometric obligation concerns the whole centralizer of U
inside R = C_H(E(H))Q. Its factors are the actual E.6.7 blocks centralized
by U, with their original module structures. No original A₃ block occurs
in this obligation, and neither block persistence nor a containing block
is an input. The detection reduction uses this product and exact C.1.9
to identify the escaping block with one of these factors.

This is a new obligation, not an assertion of an earlier source theorem.
It must be discharged using the E.6.7 action and Borel clauses before
the envelope-detection theorem can be assembled.
Source: Aschbacher–Smith, combined manuscript (1 March 2004), E.6.7
and E.6.23, printed pp.246 and 254; C.1.7–13, printed pp.123–125.
-/

@[expose] public section

open Subgroup
open scoped Pointwise
namespace CFSG.Quasithin.ChapterE.Section06.Hyperplanes.Enlargement.BlockInspection.Lifting.Three.Detection
open InvariantSubspaces.BlockSelection

variable {G : Type*} [Group G]

/-- The selected envelope factors on which U acts trivially. -/
def FixedFactors {Q M V A R : Subgroup G}
    (d : E67Decomposition Q M V A R) (U : Subgroup G) :=
  {i : Fin d.count // d.block i ≤ centralizer (U : Set G)}

/-- The group generated by those literal factors, not by their quotients. -/
def fixedFactorJoin {Q M V A R : Subgroup G}
    (d : E67Decomposition Q M V A R) (U : Subgroup G) : Subgroup G :=
  ⨆ i : FixedFactors d U, d.block i.val

/-- Outstanding centralizer geometry. The smaller centralizer is factored
using C_R(V) and the E.6.7 factors centralized by U. This universal statement
contains no small block L and does not assume the detection conclusion. -/
def EnvelopeCentralizerProduct (T : Sylow 2 G) (M V : Subgroup G) : Prop :=
  ∀ U ∈ obstructionFamily M V, IsHyperplane V U →
    ∀ A ∈ obstructionFamily M V, A ≤ U → subgroupCorank V A = 2 →
      ∀ d : E67Decomposition (sylowCentralizer (T : Subgroup G) V) M V A
          (layerEnvelope (centralizer (A : Set G))
            (sylowCentralizer (T : Subgroup G) V)),
        ((layerEnvelope (centralizer (A : Set G))
          (sylowCentralizer (T : Subgroup G) V) ⊓ centralizer (U : Set G) : Subgroup G) : Set G) =
        ((layerEnvelope (centralizer (A : Set G))
          (sylowCentralizer (T : Subgroup G) V) ⊓ centralizer (V : Set G) : Subgroup G) : Set G) *
          (fixedFactorJoin d U : Set G)

end CFSG.Quasithin.ChapterE.Section06.Hyperplanes.Enlargement.BlockInspection.Lifting.Three.Detection
