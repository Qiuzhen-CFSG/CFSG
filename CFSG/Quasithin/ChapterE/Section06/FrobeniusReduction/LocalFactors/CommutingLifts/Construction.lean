module

public import CFSG.Quasithin.ChapterE.Section06.FrobeniusReduction.LocalFactors.Conjugates
public import Theory.GroupTheory.IndependentOddLifts
public import Theory.GroupTheory.LocalNormalizerUniqueness
public import Theory.GroupTheory.PCoreRestriction

/-!
# Simultaneously correcting the cyclic lifts in E.6.25

The decomposition first supplies genuine cyclic conjugates with faithful,
independent action images in N_G(U). To make them commute, it suffices to
supply local subgroups normalized by all the candidates and containing
each cross commutator in their intrinsic two-cores. Restrict those cores
to the generated group. They are normal two-subgroups, so all cross
commutators lie in its two-core. Independence of the action images then
makes the entire action kernel a two-group. One Schur–Zassenhaus section
of the odd image corrects every candidate simultaneously.

The exported reductions construct actual commuting subgroups and feed
`factor_count_le_two_of_cyclicLifts`. The source local commutator
calculations are still explicit obligations; this module does not yet
prove their E.6.11 model premises or the unconditional lift assertion.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), proof of
E.6.25, printed p.255 (PDF p.266).
-/

@[expose] public section

open Subgroup
open scoped IsMulCommutative commutatorElement

set_option backward.isDefEq.respectTransparency false

namespace CFSG.Quasithin.ChapterE.Section06.FrobeniusReduction.LocalFactors.CommutingLifts

variable {G : Type*} [Group G] {V U X : Subgroup G} [IsElementaryAbelian 2 V]

/-- Cyclic candidates before the simultaneous correction. No ambient
commutation is assumed here. The candidates may be genuine conjugates or
cyclic subgroups selected using the local models. -/
structure Candidates (U X : Subgroup G)
    (D : Representation.RegularCyclicNormalClosure.Decomposition
      (automizerRepresentation V) (inducedAutomizer V X)) where
  subgroup : Fin D.size → Subgroup (normalizer (V : Set G))
  local_containment : ∀ i, (subgroup i).map (normalizer (V : Set G)).subtype ≤
    normalizer (U : Set G)
  cyclic : ∀ i, IsCyclic (subgroup i)
  card_eq : ∀ i, Nat.card (subgroup i) = Nat.card X
  faithful : ∀ i, Function.Injective
    (V.normalizerMonoidHom.rangeRestrict.comp (subgroup i).subtype)
  image_le : ∀ i, (subgroup i).map V.normalizerMonoidHom.rangeRestrict ≤ D.factor i

variable {D : Representation.RegularCyclicNormalClosure.Decomposition
  (automizerRepresentation V) (inducedAutomizer V X)}

/-- Transitivity supplies one genuine conjugate in every factor. -/
theorem exists_candidates {M : Subgroup G} (hX : RegularCyclicSection M V U X)
    (D : Representation.RegularCyclicNormalClosure.Decomposition
      (automizerRepresentation V) (inducedAutomizer V X)) : Nonempty (Candidates U X D) := by
  choose n hn hc ho hf hi using exists_conjugate_cyclic_lift hX D
  exact ⟨⟨fun i => (X.subgroupOf (normalizer (V : Set G))).map
    (MulAut.conj (n i)).toMonoidHom, hn, hc, ho, hf, hi⟩⟩

namespace Candidates

/-- The subgroup generated by all chosen conjugates, inside N_G(V). -/
def generated (F : Candidates U X D) : Subgroup (normalizer (V : Set G)) :=
  ⨆ i, F.subgroup i

theorem le_generated (F : Candidates U X D) (i : Fin D.size) :
    F.subgroup i ≤ F.generated := le_iSup F.subgroup i

/-- The actual conjugation action of the generated subgroup on V. -/
def action (F : Candidates U X D) : F.generated →* Automizer V :=
  V.normalizerMonoidHom.rangeRestrict.comp F.generated.subtype

/-- The local normalization is preserved when generating all candidates. -/
theorem generated_local (F : Candidates U X D) :
    F.generated.map (normalizer (V : Set G)).subtype ≤ normalizer (U : Set G) := by
  rw [generated, Subgroup.map_iSup]
  exact iSup_le F.local_containment

/-- The distinct candidate actions commute, even before correcting the lifts. -/
theorem image_commuting (F : Candidates U X D) :
    Pairwise fun i j => ∀ a : F.subgroup i, ∀ b : F.subgroup j,
      Commute (V.normalizerMonoidHom.rangeRestrict a)
        (V.normalizerMonoidHom.rangeRestrict b) := by
  intro i j hij a b
  exact D.commuting hij _ (F.image_le i (mem_map_of_mem _ a.property))
    _ (F.image_le j (mem_map_of_mem _ b.property))

/-- The candidates viewed inside the group they generate. -/
def restricted (F : Candidates U X D) (i : Fin D.size) : Subgroup F.generated :=
  (F.subgroup i).subgroupOf F.generated

theorem restricted_generates (F : Candidates U X D) : iSup F.restricted = ⊤ := by
  apply map_injective F.generated.subtype_injective
  rw [Subgroup.map_iSup, ← MonoidHom.range_eq_map, range_subtype]
  simp only [restricted, map_subgroupOf_eq_of_le (F.le_generated _)]
  rfl

theorem restricted_image (F : Candidates U X D) (i : Fin D.size) :
    (F.restricted i).map F.action =
      (F.subgroup i).map V.normalizerMonoidHom.rangeRestrict := by
  rw [action, ← map_map]
  rw [restricted, map_subgroupOf_eq_of_le (F.le_generated i)]

theorem restricted_faithful (F : Candidates U X D) (i : Fin D.size) :
    Function.Injective (F.action.comp (F.restricted i).subtype) := by
  intro a b he
  have hh : (⟨a.val.val, a.property⟩ : F.subgroup i) = ⟨b.val.val, b.property⟩ :=
    F.faithful i he
  apply Subtype.ext
  apply Subtype.ext
  exact congrArg (fun z : F.subgroup i => (z : normalizer (V : Set G))) hh

theorem restricted_commuting (F : Candidates U X D) :
    Pairwise fun i j => ∀ a : F.restricted i, ∀ b : F.restricted j,
      Commute (F.action a) (F.action b) := by
  intro i j hij a b
  exact F.image_commuting hij ⟨a.val.val, a.property⟩ ⟨b.val.val, b.property⟩

theorem restricted_odd (F : Candidates U X D) (ho : Odd (Nat.card X))
    (i : Fin D.size) : Odd (Nat.card (F.restricted i)) := by
  rw [restricted, Nat.card_congr (subgroupOfEquivOfLe (F.le_generated i)).toEquiv,
    F.card_eq i]
  exact ho

variable [Finite G]

/-- The simultaneous correction uses a single section of the whole action
image, so its commutation holds in the ambient group. -/
theorem cyclicLifts_of_kernel_two (F : Candidates U X D) (ho : Odd (Nat.card X))
    (hk : IsPGroup 2 F.action.ker) : Nonempty (CyclicLifts U X D) := by
  have hodd := F.action.odd_range_of_commuting_generators F.restricted
    F.restricted_generates (F.restricted_odd ho) F.restricted_commuting
  obtain ⟨s, hs⟩ := F.action.exists_section_of_two_kernel_odd_range hk hodd
  let t (i) : F.subgroup i →* F.action.range :=
    F.action.rangeRestrict.comp (inclusion (F.le_generated i))
  let g (i) : F.subgroup i →* normalizer (V : Set G) :=
    F.generated.subtype.comp (s.comp (t i))
  have hg (i) (a : F.subgroup i) :
      V.normalizerMonoidHom.rangeRestrict (g i a) =
        V.normalizerMonoidHom.rangeRestrict a :=
    congrArg Subtype.val (DFunLike.congr_fun hs (t i a))
  have hgi (i) : Function.Injective (g i) := by
    intro a b hab
    apply F.faithful i
    exact (hg i a).symm.trans ((congrArg V.normalizerMonoidHom.rangeRestrict hab).trans
      (hg i b))
  have hfaith (i) : Function.Injective
      (V.normalizerMonoidHom.rangeRestrict.comp (g i).range.subtype) := by
    intro a b hab
    obtain ⟨a', ha⟩ := a.property
    obtain ⟨b', hb⟩ := b.property
    have he : a' = b' := F.faithful i (by
      change V.normalizerMonoidHom.rangeRestrict (a' : normalizer (V : Set G)) =
        V.normalizerMonoidHom.rangeRestrict (b' : normalizer (V : Set G))
      rw [← hg i a', ← hg i b', ha, hb]
      exact hab)
    exact Subtype.ext (ha.symm.trans ((congrArg (g i) he).trans hb))
  refine ⟨⟨fun i => (g i).range, ?_, ?_, ?_, hfaith, ?_, ?_⟩⟩
  · intro i
    apply le_trans (map_mono ?_) F.generated_local
    rintro a ⟨x, rfl⟩
    exact (s (t i x)).property
  · intro i
    let _ := F.cyclic i
    exact isCyclic_of_surjective (g i).rangeRestrict (g i).rangeRestrict_surjective
  · intro i
    exact (Nat.card_congr (MonoidHom.ofInjective (hgi i)).toEquiv).symm.trans
      (F.card_eq i)
  · intro i b hb
    obtain ⟨a, ⟨a', rfl⟩, rfl⟩ := hb
    rw [hg]
    exact F.image_le i (mem_map_of_mem _ a'.property)
  · intro i j hij a ha b hb
    obtain ⟨a', rfl⟩ := ha
    obtain ⟨b', rfl⟩ := hb
    have hc : Commute (t i a') (t j b') := by
      apply Subtype.ext
      exact (F.image_commuting hij a' b').eq
    exact (hc.map s).map F.generated.subtype

/-- The local normalization and commutator calculations suffice for a
simultaneous correction. No assertion about the full automizer preimage
or the order of a component centralizer is used. -/
theorem kernel_two_of_local_calculations (F : Candidates U X D)
    (ho : Odd (Nat.card X)) (B : Fin D.size → Subgroup (normalizer (V : Set G)))
    (hn : ∀ i j, F.subgroup i ≤ normalizer (B j : Set (normalizer (V : Set G))))
    (hc : Pairwise fun i j => ⁅F.subgroup i, F.subgroup j⁆ ≤ (B i).pCoreIn 2) :
    IsPGroup 2 F.action.ker := by
  have hind : iSupIndep fun i => (F.restricted i).map F.action := by
    simpa only [F.restricted_image] using D.group_independent.mono F.image_le
  apply F.action.isPGroup_ker_of_independent_images_commutators F.restricted
    F.restricted_generates hind F.restricted_faithful F.restricted_commuting
    (F.restricted_odd ho)
  intro i j hij
  let R := (B i).pCoreIn 2
  have hNR : F.generated ≤ normalizer (R : Set (normalizer (V : Set G))) := by
    apply (iSup_le fun k => hn k i).trans
    exact normalizer_le_normalizer_characteristic_image (B i) (pCore 2 (B i))
  have hRnormal : (R.subgroupOf F.generated).Normal :=
    normal_subgroupOf_of_le_normalizer hNR
  have hRtwo : IsPGroup 2 (R.subgroupOf F.generated) :=
    (pCore_isPGroup.map (B i).subtype).comap_subtype
  have hRcore : R.subgroupOf F.generated ≤ pCore 2 F.generated :=
    le_sSup ⟨hRnormal, hRtwo⟩
  apply le_trans ?_ hRcore
  apply map_le_iff_le_comap.mp
  rw [map_commutator]
  simpa only [restricted, map_subgroupOf_eq_of_le (F.le_generated _)] using hc hij

/-- Once the local calculations are proved, this constructs the actual
commuting family required by the prime-rank argument. -/
theorem cyclicLifts_of_local_calculations (F : Candidates U X D)
    (ho : Odd (Nat.card X)) (B : Fin D.size → Subgroup (normalizer (V : Set G)))
    (hn : ∀ i j, F.subgroup i ≤ normalizer (B j : Set (normalizer (V : Set G))))
    (hc : Pairwise fun i j => ⁅F.subgroup i, F.subgroup j⁆ ≤ (B i).pCoreIn 2) :
    Nonempty (CyclicLifts U X D) :=
  F.cyclicLifts_of_kernel_two ho (F.kernel_two_of_local_calculations ho B hn hc)

end Candidates

/-- The completed algebraic correction feeds the existing prime-rank bound.
The source local calculations remain explicit in this conditional reduction. -/
theorem factor_count_le_two_of_local_calculations {K : GroupClass} {T : Sylow 2 G}
    [Finite G] {M : Subgroup G} (h : HypothesisE61 K T M V)
    (hU : U ∈ obstructionFamily M V) (hX : RegularCyclicSection M V U X)
    (hr : 1 < subgroupCorank V U) (F : Candidates U X D)
    (B : Fin D.size → Subgroup (normalizer (V : Set G)))
    (hn : ∀ i j, F.subgroup i ≤ normalizer (B j : Set (normalizer (V : Set G))))
    (hc : Pairwise fun i j => ⁅F.subgroup i, F.subgroup j⁆ ≤ (B i).pCoreIn 2) :
    D.size ≤ 2 := by
  obtain ⟨lifts⟩ := F.cyclicLifts_of_local_calculations
    (regularCyclicSection_odd hX (by omega)) B hn hc
  exact factor_count_le_two_of_cyclicLifts h hU hX hr D lifts

end CFSG.Quasithin.ChapterE.Section06.FrobeniusReduction.LocalFactors.CommutingLifts
