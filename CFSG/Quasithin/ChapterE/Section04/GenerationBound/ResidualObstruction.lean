module

public import Theory.GroupTheory.PResidual.FiniteImage

/-!
# An obstruction to the blanket local residual identity

A surjection onto a nontrivial odd abelian group sends the two-residual onto
the entire quotient and kills every commutator. Thus the residual cannot
be generated by commutators with any subgroup. This isolates a necessary
restriction on attempts to justify the local identity in the E.4.2 proof;
it does not refute E.4.2 or its full fixed-space-family hypotheses.

Source context: Aschbacher–Smith, combined manuscript of 1 March 2004,
E.4.2, printed p.241 (PDF p.252).
-/

public section
open Subgroup
namespace CFSG.Quasithin.ChapterE.ValueBound
variable {G C : Type*} [Group G] [Finite G] [CommGroup C] [Nontrivial C]

/-- An odd abelian quotient detects residual elements that no commutator can generate. -/
theorem residual_commutator_ne_of_odd_abelian_quotient
    (f : G →* C) (hf : Function.Surjective f) (hodd : Nat.Coprime 2 (Nat.card C))
    (B : Subgroup G) : ⁅pResidual 2 G, B⁆ ≠ pResidual 2 G := by
  have hR : pResidual 2 C = ⊤ := by
    apply top_unique
    intro c _
    exact mem_pResidual_of_orderOf_coprime (hodd.coprime_dvd_right (orderOf_dvd_natCard c))
  intro he
  have hm := congrArg (Subgroup.map f) he
  rw [map_commutator, map_pResidual_of_surjective 2 f hf, hR] at hm
  have hz : ⁅(⊤ : Subgroup C), B.map f⁆ = ⊥ := by
    apply le_bot_iff.mp
    apply commutator_le.mpr
    intro x _ y _
    simp only [mem_bot, commutatorElement_eq_one_iff_mul_comm, mul_comm]
  rw [hz] at hm
  exact bot_ne_top hm
end CFSG.Quasithin.ChapterE.ValueBound
