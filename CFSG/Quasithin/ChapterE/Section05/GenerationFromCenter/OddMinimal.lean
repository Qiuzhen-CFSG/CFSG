module

public import CFSG.Quasithin.ChapterE.Section05.GenerationFromCenter.MinimalMembers
public import CFSG.Quasithin.ChapterE.Section05.GenerationFromCenter.OddMinimal.Defs
public import CFSG.Quasithin.ChapterE.Section05.GenerationFromCenter.OddMinimal.Structure
public import CFSG.Quasithin.ChapterE.Section05.GenerationFromCenter.OddMinimal.ProperGeneration
public import Theory.GroupTheory.PResidual.FrattiniCentralizer

/-!
# The odd minimal-member reduction in E.5.2

The actual E1 structure identifies the residual image with F*(K/O₂(K)).
Irreducibility on its Frattini quotient then gives exactly the intrinsic
centralizer dichotomy required by E.5.2, with the published Frattini
preimage `weakClosureOddRadical`.

The proper-member construction proves that a reducible E1 member is
generated by genuine proper E-members. For a minimal member escaping a
subgroup containing the prescribed Sylow intersection, all those proper
members lie in the subgroup, a contradiction. Hence minimality forces
irreducibility and discharges the odd structural premise of E.5.2.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), E.5.2,
printed p.243, using E.1.2 on printed pp.209–210.
-/

open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterE
variable {G : Type*} [Group G] [Finite G]

/-- The terminal Frattini implication, with irreducibility still explicit. -/
public theorem ECaseOdd.residual_centralizer_dichotomy_of_irreducible
    {A K : Subgroup G} (hodd : ECaseOdd A K) (hirr : OddFrattiniIrreducible K) :
    pResidual 2 K ≤ centralizer (pCore 2 K : Set K) ∨
      pResidual 2 K ⊓ centralizer (pCore 2 K : Set K) ≤ weakClosureOddRadical K :=
  pResidual_centralizer_dichotomy_of_frattini_section _
    hodd.residual_image_eq_generalizedFitting hirr

/-- Proper-member generation is incompatible with minimal escape from a
subgroup containing the ambient Sylow subgroup. -/
public theorem IsMinimalEscapingEMember.irreducible_of_proper_generation
    {j : ℕ} {P A M K : Subgroup G}
    (hmin : IsMinimalEscapingEMember j P A M K) (hPM : P ≤ M)
    (hgen : ¬ OddFrattiniIrreducible K →
      K ≤ (P ⊓ K) ⊔ sSup {L : Subgroup G | L < K ∧ IsEMemberAt j P A L}) :
    OddFrattiniIrreducible K := by
  by_contra hnot
  apply hmin.1.2
  apply (hgen hnot).trans
  refine sup_le (inf_le_left.trans hPM) (sSup_le ?_)
  intro L hL
  by_contra hLM
  exact hL.1.not_ge (hmin.2 ⟨hL.2, hLM⟩ hL.1.le)

/-- Assembly of the odd structural reduction from genuine proper E-member
generation in the reducible case. -/
public theorem IsMinimalEscapingEMember.odd_centralizer_dichotomy_of_proper_generation
    {j : ℕ} {P A M K : Subgroup G}
    (hmin : IsMinimalEscapingEMember j P A M K) (hPM : P ≤ M)
    (hodd : ECaseOdd A K)
    (hgen : ¬ OddFrattiniIrreducible K →
      K ≤ (P ⊓ K) ⊔ sSup {L : Subgroup G | L < K ∧ IsEMemberAt j P A L}) :
    pResidual 2 K ≤ centralizer (pCore 2 K : Set K) ∨
      pResidual 2 K ⊓ centralizer (pCore 2 K : Set K) ≤ weakClosureOddRadical K :=
  hodd.residual_centralizer_dichotomy_of_irreducible
    (hmin.irreducible_of_proper_generation hPM hgen)

/-- A minimal escaping odd E-member acts irreducibly on its actual odd
Frattini section: reducibility would generate it by proper E-members. -/
public theorem IsMinimalEscapingEMember.odd_frattini_irreducible
    {j : ℕ} {P A M K : Subgroup G}
    (hmin : IsMinimalEscapingEMember j P A M K) (hj : 0 < j)
    (hPM : P ≤ M) (hodd : ECaseOdd A K) : OddFrattiniIrreducible K :=
  hmin.irreducible_of_proper_generation hPM
    (proper_generation_of_reducible_odd hj hmin.1.1 hodd)

/-- The odd structural reduction for minimal escaping E-members, with no
extra irreducibility or proper-generation hypothesis. -/
public theorem IsMinimalEscapingEMember.odd_centralizer_dichotomy
    {j : ℕ} {P A M K : Subgroup G}
    (hmin : IsMinimalEscapingEMember j P A M K) (hj : 0 < j)
    (hPM : P ≤ M) (hodd : ECaseOdd A K) :
    pResidual 2 K ≤ centralizer (pCore 2 K : Set K) ∨
      pResidual 2 K ⊓ centralizer (pCore 2 K : Set K) ≤ weakClosureOddRadical K :=
  hodd.residual_centralizer_dichotomy_of_irreducible
    (hmin.odd_frattini_irreducible hj hPM hodd)

/-- The exact odd-member centralizer dichotomy used in E.5.2. The rank and
Thompson-family hypotheses belong to that consumer; the structural argument
only needs positive E-index and containment of P in the generating subgroup. -/
public theorem minimal_odd_thompson_centralizer_dichotomy
    (P : Sylow 2 G) (i j : ℕ) (hj : 0 < j)
    (_hij : i + j < ChapterB.twoRank (P : Subgroup G))
    (A K : Subgroup G) (_hA : A ∈ ChapterB.thompsonFamily (P : Subgroup G) i)
    (hmin : IsMinimalEscapingEMember j (P : Subgroup G) A
      (thompsonCentralizerGenerators (P : Subgroup G) i j) K)
    (hodd : ECaseOdd A K) :
    pResidual 2 K ≤ centralizer (pCore 2 K : Set K) ∨
      pResidual 2 K ⊓ centralizer (pCore 2 K : Set K) ≤ weakClosureOddRadical K := by
  apply hmin.odd_centralizer_dichotomy hj ?_ hodd
  exact (P : Subgroup G).le_normalizer.trans
    ((normalizer_le_normalizer_thompsonJ _ i).trans le_sup_left)

end CFSG.Quasithin.ChapterE
