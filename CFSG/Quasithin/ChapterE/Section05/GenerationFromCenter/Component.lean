module

public import CFSG.Quasithin.ChapterE.Defs
public import Theory.GroupTheory.GeneralizedFitting.ComponentCalculus
public import Theory.GroupTheory.SolvableRadical.Transport
public import Theory.GroupTheory.QuaternionCentralProductResidualRecognition.Residual

/-!
# The component-orbit centralizer step of E.5.2

In the radical quotient of an E2 member, its two-residual lies in the layer,
which is generated by a single orbit of components. A normal subgroup inside
this orbit either contains it or centralizes it. In the latter case the normal
subgroup is abelian and hence trivial in the radical-free quotient.

Apply this to the image of C = C_{O²(K)}(O₂(K)). If its image contains the
layer, O²(K) lies in C O∞(K); perfectness removes the solvable factor and gives
O²(K) ≤ C. Otherwise C lies in O∞(K), exactly the E2 centralizer hypothesis
of E.5.1. The orbit uses the intrinsic local tau from Definition E.1.2.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
1 March 2004 manuscript, E.5.2, printed p.243.
-/

open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterE
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
private theorem normal_le_orbit_eq_bot_or_eq
    (L D N : Subgroup G) (hL : IsComponent G L) [N.Normal]
    (hR : solvableRadical G = ⊥) (hN : N ≤ conjugateJoin D L) :
    N = ⊥ ∨ N = conjugateJoin D L := by
  rcases hL.normal_dichotomy N with hLN | hLC
  · right
    apply le_antisymm hN
    exact iSup_conjugates_le_of_le_normalizer L D N hLN (by rw [normalizer_eq_top]; exact le_top)
  · left
    have hOC : conjugateJoin D L ≤ centralizer (N : Set G) :=
      iSup_conjugates_le_centralizer L D N (by rw [normalizer_eq_top]; exact le_top) hLC
    have hNC : N ≤ centralizer (N : Set G) := hN.trans hOC
    have hNR := le_solvableRadical N inferInstance
      (Group.isSolvable_of_comm (fun a b =>
        Subtype.ext (mem_centralizer_iff.mp (hNC b.property) a a.property)))
    exact le_bot_iff.mp (hR ▸ hNR)

omit [Finite G] in
private theorem perfect_le_normal_of_le_sup_solvable
    (H N R : Subgroup G) [Group.IsPerfect H] [N.Normal]
    [Group.IsSolvable R] (h : H ≤ N ⊔ R) : H ≤ N := by
  let q := QuotientGroup.mk' N
  have hi : H.map q ≤ R.map q := by
    have hm := map_mono (f := q) h
    simpa only [Subgroup.map_sup, q, QuotientGroup.map_mk'_self, bot_sup_eq] using hm
  let _ : Group.IsPerfect (H.map q) := Group.IsPerfect.map q
  let _ : Group.IsSolvable (R.map q) :=
    Group.isSolvable_of_surjective (q.subgroupMap_surjective R)
  have hz : H.map q ≤ ⊥ := by
    simpa only [solvableResidual_eq_bot, Subgroup.map_bot] using
      le_map_solvableResidual_of_isPerfect (H.map q) (R.map q) hi
  simpa only [q, le_bot_iff, Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] using hz

/-- The E2 component orbit controls the centralizer of the local core. -/
public theorem ECaseComponent.residual_centralizer_dichotomy {P A K : Subgroup G}
    (hK : ECaseComponent P A K) :
    pResidual 2 K ≤ centralizer (pCore 2 K : Set K) ∨
      pResidual 2 K ⊓ centralizer (pCore 2 K : Set K) ≤ solvableRadical K := by
  obtain ⟨_, ⟨hEn, hquot⟩, hres, L, hL, horbit, _⟩ := hK
  let H := pResidual 2 K
  let R := solvableRadical K
  let q := QuotientGroup.mk' R
  let C := H ⊓ centralizer (pCore 2 K : Set K)
  let _ : (C.map q).Normal := Normal.map inferInstance q (QuotientGroup.mk'_surjective _)
  let _ := hEn
  have hHE : H.map q ≤ componentLayer (K ⧸ R) := by
    apply (map_pResidual_le 2 q).trans
    exact sInf_le ⟨hEn, hquot⟩
  have hCE : C.map q ≤ conjugateJoin
      ((tau (P.subgroupOf K) (A.subgroupOf K)).map q) L := by
    exact ((map_mono inf_le_left).trans hHE).trans horbit.le
  rcases normal_le_orbit_eq_bot_or_eq L _ (C.map q) hL
      solvableRadical_quotient_solvableRadical hCE with hbot | heq
  · right
    simpa only [q, Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk'] using hbot
  · left
    have hHC : H.map q ≤ C.map q := by rw [heq]; exact hHE.trans horbit.le
    have hHCR : H ≤ C ⊔ R := by
      have hm := (le_comap_map q H).trans (comap_mono hHC)
      simpa only [comap_map_eq, q, QuotientGroup.ker_mk', sup_comm] using hm
    let _ : Group.IsPerfect H := by
      change Group.IsPerfect (pResidual 2 K)
      exact hres ▸ (inferInstance : Group.IsPerfect (solvableResidual K))
    exact (perfect_le_normal_of_le_sup_solvable H C R hHCR).trans inf_le_right

end CFSG.Quasithin.ChapterE
