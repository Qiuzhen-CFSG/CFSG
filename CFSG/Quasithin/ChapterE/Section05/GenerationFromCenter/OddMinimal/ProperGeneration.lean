module

public import CFSG.Quasithin.ChapterE.Section05.GenerationFromCenter.OddMinimal.ProperGeneration.Lifting
public import CFSG.Quasithin.ChapterE.Section05.GenerationFromCenter.OddMinimal.ProperGeneration.ActorCentrality
public import CFSG.Quasithin.ChapterE.Section05.GenerationFromCenter.OddMinimal.ProperGeneration.QuotientSplitting

/-!
# Proper E-member generation for a reducible odd Frattini section

Two proper odd quotient pieces generate K/O₂(K). Their full preimages in K
therefore generate K, and `Lifting` proves that both preimages are genuine
members of the original E-family, with the same actor and index.

For an odd E-member, its Sylow intersection maps onto a Sylow subgroup
of K/O₂(K), and its rank-one actor centralizes that Sylow subgroup.
Identifying the generalized Fitting subgroup with the odd prime core turns
failure of `OddFrattiniIrreducible` into the normal-subgroup witness for
the invariant-complement construction. This discharges every premise of
the quotient cover and proves the proper-generation step used in E.5.2.

Source: Aschbacher–Smith, E.5.2, printed p.243 (1 March 2004 manuscript).
-/

open Subgroup
namespace CFSG.Quasithin.ChapterE
variable {G : Type*} [Group G] [Finite G]

/-- Two proper quotient pieces lift to a cover by genuine proper E-members. -/
public theorem proper_member_cover_of_quotient_cover {j p : ℕ} (hj : 0 < j)
    (hp : p.Prime) (hpodd : Odd p) {T A K : Subgroup G}
    (hK : IsEMemberAt j T A K)
    (hrank : Group.rank ((A.subgroupOf K).map (QuotientGroup.mk' (pCore 2 K))) = 1)
    (J₁ J₂ : Subgroup (K ⧸ pCore 2 K))
    (hJ₁ : OddQuotientPiece p
      ((A.subgroupOf K).map (QuotientGroup.mk' (pCore 2 K)))
      ((T.subgroupOf K).map (QuotientGroup.mk' (pCore 2 K))) J₁)
    (hJ₂ : OddQuotientPiece p
      ((A.subgroupOf K).map (QuotientGroup.mk' (pCore 2 K)))
      ((T.subgroupOf K).map (QuotientGroup.mk' (pCore 2 K))) J₂)
    (hcover : J₁ ⊔ J₂ = ⊤) :
    ∃ L₁ L₂ : Subgroup G,
      (L₁ < K ∧ IsEMemberAt j T A L₁) ∧
      (L₂ < K ∧ IsEMemberAt j T A L₂) ∧ L₁ ⊔ L₂ = K := by
  let q := QuotientGroup.mk' (pCore 2 K)
  let L₁ := (J₁.comap q).map K.subtype
  let L₂ := (J₂.comap q).map K.subtype
  refine ⟨L₁, L₂, proper_member_of_quotient_piece hj hp hpodd hK hrank J₁ hJ₁,
    proper_member_of_quotient_piece hj hp hpodd hK hrank J₂ hJ₂, ?_⟩
  change (J₁.comap q).map K.subtype ⊔ (J₂.comap q).map K.subtype = K
  rw [← Subgroup.map_sup, comap_sup_eq q J₁ J₂ (QuotientGroup.mk'_surjective _),
    hcover, comap_top, ← MonoidHom.range_eq_map, K.range_subtype]

/-- The requested generation bound, conditional only on the quotient splitting. -/
public theorem proper_generation_of_quotient_cover {j p : ℕ} (hj : 0 < j)
    (hp : p.Prime) (hpodd : Odd p) {T A K : Subgroup G}
    (hK : IsEMemberAt j T A K)
    (hrank : Group.rank ((A.subgroupOf K).map (QuotientGroup.mk' (pCore 2 K))) = 1)
    (hcover : ∃ J₁ J₂ : Subgroup (K ⧸ pCore 2 K),
      OddQuotientPiece p
        ((A.subgroupOf K).map (QuotientGroup.mk' (pCore 2 K)))
        ((T.subgroupOf K).map (QuotientGroup.mk' (pCore 2 K))) J₁ ∧
      OddQuotientPiece p
        ((A.subgroupOf K).map (QuotientGroup.mk' (pCore 2 K)))
        ((T.subgroupOf K).map (QuotientGroup.mk' (pCore 2 K))) J₂ ∧ J₁ ⊔ J₂ = ⊤) :
    K ≤ (T ⊓ K) ⊔ sSup {L : Subgroup G | L < K ∧ IsEMemberAt j T A L} := by
  obtain ⟨J₁, J₂, hJ₁, hJ₂, hgen⟩ := hcover
  obtain ⟨L₁, L₂, hL₁, hL₂, hL⟩ :=
    proper_member_cover_of_quotient_cover hj hp hpodd hK hrank J₁ J₂ hJ₁ hJ₂ hgen
  calc
    K = L₁ ⊔ L₂ := hL.symm
    _ ≤ sSup {L : Subgroup G | L < K ∧ IsEMemberAt j T A L} :=
      sup_le (le_sSup hL₁) (le_sSup hL₂)
    _ ≤ _ := le_sup_right

/-- A reducible odd E-member is generated by two genuine proper members of
the same E-family. No minimality or additional Thompson-family input is needed. -/
public theorem proper_member_cover_of_reducible_odd {j : ℕ} (hj : 0 < j)
    {T A K : Subgroup G} (hK : IsEMemberAt j T A K) (hodd : ECaseOdd A K)
    (hred : ¬ OddFrattiniIrreducible K) :
    ∃ L₁ L₂ : Subgroup G,
      (L₁ < K ∧ IsEMemberAt j T A L₁) ∧
      (L₂ < K ∧ IsEMemberAt j T A L₂) ∧ L₁ ⊔ L₂ = K := by
  classical
  obtain ⟨p, hp, hpodd, hq, hne, hcomm, hrank⟩ := hodd
  let : Fact p.Prime := ⟨hp⟩
  let Q := K ⧸ pCore 2 K
  let q := QuotientGroup.mk' (pCore 2 K)
  let a := (A.subgroupOf K).map q
  obtain ⟨S, hS⟩ := hK.1.2.2.2.2.1
  let Sbar : Sylow 2 Q := S.mapSurjective (QuotientGroup.mk'_surjective _)
  have hSbar : (Sbar : Subgroup Q) = (T.subgroupOf K).map q := by
    simp only [Sbar, Sylow.coe_mapSurjective, hS, q]
  let : IsElementaryAbelian 2 A := hK.1.1
  let : IsElementaryAbelian 2 (A.subgroupOf K) :=
    IsElementaryAbelian.subgroupOf hK.1.2.2.1
  have ha : IsElementaryAbelian 2 a := IsElementaryAbelian.map q
  have haS : a ≤ (Sbar : Subgroup Q) := by
    rw [hSbar]
    exact map_mono (fun x hx => hK.1.2.1 hx)
  have hcentral := sylow_le_centralizer_of_rank_one_odd_core_actor
    hp hpodd Sbar a (pCore_quotient_pCore_eq_bot 2) hq hne ha haS hrank hcomm
  have hF := generalizedFitting_quotient_eq_pCore K p hq
  rw [OddFrattiniIrreducible, hF] at hred
  push Not at hred
  obtain ⟨U, hUnormal, hUR, hUzero, hUfull⟩ := hred
  obtain ⟨J₁, J₂, hJ₁, hJ₂, hcover⟩ :=
    odd_quotient_pieces_of_reducible_frattini hp hpodd Sbar a hq hne ha haS hrank
      hcomm hcentral U hUnormal hUR hUzero hUfull
  rw [hSbar] at hJ₁ hJ₂
  exact proper_member_cover_of_quotient_cover hj hp hpodd hK hrank
    J₁ J₂ hJ₁ hJ₂ hcover

/-- Proper-member generation for the odd-case minimality argument in E.5.2.
In particular this applies with `T` the prescribed ambient Sylow subgroup. -/
public theorem proper_generation_of_reducible_odd {j : ℕ} (hj : 0 < j)
    {T A K : Subgroup G} (hK : IsEMemberAt j T A K) (hodd : ECaseOdd A K)
    (hred : ¬ OddFrattiniIrreducible K) :
    K ≤ (T ⊓ K) ⊔ sSup {L : Subgroup G | L < K ∧ IsEMemberAt j T A L} := by
  obtain ⟨L₁, L₂, hL₁, hL₂, hgen⟩ :=
    proper_member_cover_of_reducible_odd hj hK hodd hred
  calc
    K = L₁ ⊔ L₂ := hgen.symm
    _ ≤ sSup {L : Subgroup G | L < K ∧ IsEMemberAt j T A L} :=
      sup_le (le_sSup hL₁) (le_sSup hL₂)
    _ ≤ _ := le_sup_right

end CFSG.Quasithin.ChapterE
