module
public import CFSG.Quasithin.ChapterE.Section05.RankCover
public import Mathlib.GroupTheory.Schreier

/-!
# From E-member rank bounds to local Thompson generation

The rank restriction in E.1.5 concerns the image of A, not the full quotient
K/O₂(K). In the component case the defining quotient is K/O∞(K). Since
O∞(K) is two-closed, every two-subgroup of that radical lies in O₂(K), so
the image of A modulo O₂(K) has the same rank bound.

A∩O₂(K) therefore has rank at least m₂(P)-i-j. Its subgroups of that fixed
positive rank generate it and belong to W. This supplies the elementary
cover in the last paragraph of E.5.2 as soon as the E.5.1 inclusion
D ≤ Ω₁(Z(W)) is known. That inclusion remains an explicit hypothesis;
the source theorem's assembly must discharge it.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), Definition
E.1.5 and Proposition E.5.2, printed pp.210 and 243. The two-closed subgroup
argument also occurs in Section01.MinimalStructure.Radical; this local
version avoids importing the unrelated minimal-supplement development.
-/

open Subgroup Stellmacher
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterE
open ChapterB
variable {G : Type*} [Group G] [Finite G]

private theorem log_card_le_rank (E : Type*) [Group E] [Finite E]
    [IsElementaryAbelian 2 E] : Nat.log 2 (Nat.card E) ≤ Group.rank E := by
  have hd := card_dvd_exponent_pow_rank' E
    (Monoid.exponent_dvd_iff_forall_pow_eq_one.mp (IsElementaryAbelian.exponent_dvd_p 2 E))
  have hl := Nat.log_mono_right (b := 2) (Nat.le_of_dvd (by positivity : 0 < 2 ^ Group.rank E) hd)
  rwa [Nat.log_pow Nat.one_lt_two] at hl

private theorem two_subgroup_le_core {N U : Subgroup G} [N.Normal]
    (hN : IsTwoClosed N) (hU : IsPGroup 2 U) (hUN : U ≤ N) : U ≤ pCore 2 G := by
  obtain ⟨S, hS⟩ := hN
  let _ : (S : Subgroup N).Characteristic := S.characteristic_of_normal hS
  have hsn : ((S : Subgroup N).map N.subtype).Normal := inferInstance
  have hle : U.subgroupOf N ≤ (S : Subgroup N) := by
    let _ := hS
    have hpg := hU.comap_of_injective N.subtype N.subtype_injective
    obtain ⟨T, hT⟩ := hpg.exists_le_sylow
    have hST : S = T := by
      apply Sylow.ext
      exact (S.is_maximal' T.isPGroup' (S.isPGroup'.le_sylow_of_normal T)).symm
    simpa only [hST, subgroupOf] using hT
  calc
    U = (U.subgroupOf N).map N.subtype := (map_subgroupOf_eq_of_le hUN).symm
    _ ≤ (S : Subgroup N).map N.subtype := map_mono hle
    _ ≤ pCore 2 G := le_sSup ⟨hsn, S.isPGroup'.map N.subtype⟩

/-- The exact image-rank bound needed in E.5.1–2, in either E-member branch. -/
public theorem IsEMemberAt.core_rank_le {P A K : Subgroup G} {j : ℕ}
    (hK : IsEMemberAt j P A K) :
    Nat.log 2 ((A ⊓ (pCore 2 K).map K.subtype).relIndex A) ≤ j := by
  let a := A.subgroupOf K
  let _ : IsElementaryAbelian 2 A := hK.1.1
  have hAK : A ≤ K := hK.1.2.2.1
  let _ : IsElementaryAbelian 2 a := IsElementaryAbelian.subgroupOf hAK
  have hm : a.map K.subtype = A := map_subgroupOf_eq_of_le hAK
  rw [inf_relIndex_left, ← hm, relIndex_map_map_of_injective _ _ K.subtype_injective]
  rcases hK.2 with ⟨_, hr⟩ | ⟨hc, hr⟩
  · let f := QuotientGroup.mk' (pCore 2 K)
    let _ : IsElementaryAbelian 2 (a.map f) := IsElementaryAbelian.map _
    have he : (pCore 2 K).relIndex a = Nat.card (a.map f) := by
      simpa only [f, QuotientGroup.ker_mk'] using relIndex_ker a f
    rw [he]
    exact (log_card_le_rank (a.map f)).trans hr
  · let R := solvableRadical K
    have hRQ : R ⊓ a ≤ pCore 2 K :=
      two_subgroup_le_core hc.1 (IsElementaryAbelian.isPGroup 2 a).to_inf_right inf_le_left
    have hindex : (pCore 2 K).relIndex a ≤ R.relIndex a := by
      have hd := relIndex_dvd_of_le_left a hRQ
      rw [inf_relIndex_right] at hd
      exact Nat.le_of_dvd (Nat.pos_of_ne_zero (R.subgroupOf a).index_ne_zero_of_finite) hd
    let f := QuotientGroup.mk' R
    let _ : IsElementaryAbelian 2 (a.map f) := IsElementaryAbelian.map _
    have he : R.relIndex a = Nat.card (a.map f) := by
      simpa only [f, QuotientGroup.ker_mk'] using relIndex_ker a f
    apply (Nat.log_mono_right hindex).trans
    rw [he]
    exact (log_card_le_rank (a.map f)).trans hr

/-- A large elementary subgroup of the local core is generated by the
fixed-rank family defining W. -/
public theorem inf_core_le_higherThompsonCore (P A K : Subgroup G) (i j : ℕ)
    (hA : A ∈ thompsonFamily P i) (hij : i + j < twoRank P)
    (hr : Nat.log 2 ((A ⊓ (pCore 2 K).map K.subtype).relIndex A) ≤ j) :
    A ⊓ (pCore 2 K).map K.subtype ≤ higherThompsonCore P K (i + j) := by
  let B := A ⊓ (pCore 2 K).map K.subtype
  let _ : IsElementaryAbelian 2 A := hA.2.1
  let _ : IsElementaryAbelian 2 B := IsElementaryAbelian.of_le (show B ≤ A from inf_le_left)
  obtain ⟨b, hb⟩ := (IsElementaryAbelian.isPGroup 2 B).exists_card_eq
  have hrank := ((mem_thompsonFamily_iff_rank P A i).mp hA).2.2
  have hdiff := log_card_sub_log_card_eq_log_relIndex A B inf_le_left
  change Nat.log 2 (B.relIndex A) ≤ j at hr
  rw [← hdiff, hb, Nat.log_pow Nat.one_lt_two] at hr
  have hcard : 2 ^ (twoRank P - (i + j)) ≤ Nat.card B := by
    rw [hb]
    exact Nat.pow_le_pow_right (by decide) (by omega)
  intro x hx
  obtain ⟨C, hCB, hC, hcardC, hxC⟩ :=
    IsElementaryAbelian.exists_two_power_subgroup_mem B (by omega) hcard x hx
  exact (le_sSup (show C ∈ {C : Subgroup G |
    C ∈ thompsonFamily P (i + j) ∧ C ≤ (pCore 2 K).map K.subtype} from
      ⟨⟨hCB.trans (inf_le_left.trans hA.1), hC, hij.le, hcardC⟩,
        hCB.trans inf_le_right⟩)) hxC

/-- The local residual is controlled once the genuine E.5.1 center containment
has been established. All rank and normality premises of the cover are proved. -/
public theorem residual_le_generators_of_core_center
    (P : Sylow 2 G) (i j : ℕ) (hij : i + j < twoRank (P : Subgroup G))
    (A K : Subgroup G) (hA : A ∈ thompsonFamily (P : Subgroup G) i)
    (hK : IsEMemberAt j (P : Subgroup G) A K)
    (hD : higherThompsonCenter (P : Subgroup G) (i + j) ≤
      omegaOneCenterAmbient (higherThompsonCore (P : Subgroup G) K (i + j))) :
    (pResidual 2 K).map K.subtype ≤
      thompsonCentralizerGenerators (P : Subgroup G) i j := by
  let W := higherThompsonCore (P : Subgroup G) K (i + j)
  let E := omegaOneCenterAmbient W
  let B := A ⊓ (pCore 2 K).map K.subtype
  let _ : IsElementaryAbelian 2 E := omegaOneCenterAmbient_elementaryAbelian W
  have hEW : E ≤ W := fun x hx => ((mem_omegaOneCenterAmbient_iff W x).mp hx).1
  have hWE : W ≤ centralizer (E : Set G) := by
    apply le_centralizer_iff.mp
    intro x hx
    exact mem_centralizer_iff.mpr ((mem_omegaOneCenterAmbient_iff W x).mp hx).2.2
  have hKE : K ≤ normalizer (E : Set G) := by
    have hn : K ≤ normalizer (W : Set G) :=
      (normal_subgroupOf_iff_le_normalizer (higherThompsonCore_le _ K _)).mp
        (higherThompsonCore_normal _ K _ hK.1.core_le)
    intro k hk
    have hkW := hn hk
    rw [mem_normalizer_iff_map_conj_eq] at hkW ⊢
    change W.map (MulAut.conj k).toMonoidHom = W at hkW
    change (omegaOneCenterAmbient W).map (MulAut.conj k).toMonoidHom = _
    rw [← omegaOneCenterAmbient_map_injective (MulAut.conj k).toMonoidHom (MulAut.conj k).injective, hkW]
  exact residual_le_generators_of_elementary_cover P i j hij A K B E hA hK.1
    inf_le_left hK.core_rank_le
    (hEW.trans ((higherThompsonCore_le_core _ K _).trans hK.1.core_le))
    ((inf_core_le_higherThompsonCore _ A K i j hA hij hK.core_rank_le).trans hWE)
    hD hKE

end CFSG.Quasithin.ChapterE
