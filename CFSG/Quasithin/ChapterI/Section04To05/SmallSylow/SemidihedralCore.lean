module

public import CFSG.Quasithin.ChapterI.Section04To05.SmallSylow.SemidihedralLocal
public import ABG.ChapterII.Section1.MaximalModels
public import ABG.ChapterII.Section1.NormalQuaternionCenter
public import Theory.GroupTheory.PCoreSurjective

/-!
# The marked quaternion core in I.4.3

In the semidihedral branch of I.4.3 the Sylow subgroup has order sixteen.
The literal centralizer of its central involution has two-core equal to
the image of the quaternion subgroup generated by `a²` and `ab`.

The normal closure of the marked involution in the central quotient lies
in the center of its two-core. Transfer places the image of `ab` in that
closure. Lifting the quotient core puts both quaternion generators in the
original two-core. The quaternion subgroup has index two in the Sylow
subgroup, and the larger possibility contradicts centrality of `ab` in
the quotient core. The quaternion center and even characteristic then
identify the centralizer kernel with the original central involution.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, I.4.3,
printed pp.416–417. The subsequent automorphism image and GL₂(3) extension
recognition are separate from this marked core calculation.
-/

namespace CFSG.Quasithin.ChapterI.SemidihedralCore
open Subgroup Stellmacher SemidihedralLocal

/-- The actual two-core is the image of the specified quaternion subgroup,
with an actual equivalence to Q₈. -/
public theorem core_identity_of_presentation {G : Type*} [Group G] [Finite G] (T : Sylow 2 G)
    (hE : IsEvenCharacteristicAt T)
    (hno : ∀ K : Subgroup G, K.Normal → K.index ≠ 2)
    (hcard : Nat.card T = 16)
    (a b : T) (ha : orderOf a = 8) (hb : orderOf b = 2)
    (hconj : b * a * b⁻¹ = a ^ 3)
    (hgen : closure ({a, b} : Set T) = ⊤) :
    let z : G := ((a ^ 4 : T) : G)
    ∃ hTH : (T : Subgroup G) ≤ centralizer ({z} : Set G),
      let H := centralizer ({z} : Set G)
      pCore 2 H = (closure ({a ^ 2, a * b} : Set T)).map (inclusion hTH) ∧
      Nonempty ((pCore 2 H) ≃* QuaternionGroup 2) := by
  obtain ⟨hz, hTH, hZ, hdata⟩ := quotient_setup T hE (n := 4) (by decide)
    hcard a b ha hb hconj hgen
  obtain ⟨_, hsquare, habsquare, _, _⟩ :=
    semidihedral_centralizer_quotient_geometry T (n := 4) (by decide)
      hcard a b ha hb hconj hgen
  let z : G := ((a ^ 4 : T) : G)
  let H := centralizer ({z} : Set G)
  let zH : H := ⟨z, mem_centralizer_singleton_iff.mpr rfl⟩
  let _ : (zpowers zH).Normal := hZ
  let X := H ⧸ zpowers zH
  let q : H →* X := QuotientGroup.mk' (zpowers zH)
  let ι : T →* H := inclusion hTH
  let f : T →* X := q.comp ι
  obtain ⟨_, S, _, _, _, j, hjmap, _, _, _, hNV, hV⟩ := hdata
  let V := normalClosure ({(j : X)} : Set X)
  let _ : IsElementaryAbelian 2 V := hV
  have hzH : orderOf zH = 2 := (Subgroup.orderOf_coe zH).symm.trans hz
  have hk : ∀ t : T, f t = 1 → t ^ 2 = 1 := by
    intro t ht
    have htmem : ι t ∈ zpowers zH := (QuotientGroup.eq_one_iff _).mp ht
    have hp : (ι t) ^ 2 = 1 := by
      apply orderOf_dvd_iff_pow_eq_one.mp
      exact (orderOf_dvd_of_mem_zpowers htmem).trans (by rw [hzH])
    apply inclusion_injective hTH
    simpa only [map_pow, map_one] using hp
  have hjV : f (a ^ 2) ∈ V := by
    change (j : X) = q (ι (a ^ 2)) at hjmap
    change q (ι _) ∈ V
    rw [← hjmap]
    exact subset_normalClosure (Set.mem_singleton _)
  have hfusion := semidihedral_order_four_generators_isConj hno T 4 (by decide) hcard
    a b ha hb hconj hgen
  change IsConj (((a ^ 2) : T) : G) (((a * b) : T) : G) at hfusion
  obtain ⟨g, hg⟩ := isConj_iff.mp hfusion
  have hs : g * z * g⁻¹ = z := by
    have h := congrArg (fun t : G => t ^ 2) hg
    rw [conj_pow] at h
    have hj2 : (((a ^ 2) : T) : G) ^ 2 = z :=
      congrArg (fun t : T => (t : G)) hsquare
    have hab2 : (((a * b) : T) : G) ^ 2 = z :=
      congrArg (fun t : T => (t : G)) habsquare
    simpa only [hj2, hab2] using h
  have hgH : g ∈ H := mem_centralizer_singleton_iff.mpr
    (mul_inv_eq_iff_eq_mul.mp hs)
  let gH : H := ⟨g, hgH⟩
  have hlocal : gH * ι (a ^ 2) * gH⁻¹ = ι (a * b) := Subtype.ext hg
  have hquot : q gH * f (a ^ 2) * (q gH)⁻¹ = f (a * b) := by
    simpa only [map_mul, map_inv, f, MonoidHom.comp_apply] using congrArg q hlocal
  have habV : f (a * b) ∈ V := hquot ▸
    Subgroup.Normal.conj_mem inferInstance _ hjV (q gH)
  have hker : IsPGroup 2 q.ker := by
    change IsPGroup 2 (QuotientGroup.mk' (zpowers zH)).ker
    rw [QuotientGroup.ker_mk']
    apply IsPGroup.of_card (n := 1)
    simp only [Nat.card_zpowers, hzH, pow_one]
  have hcore : (pCore 2 X).comap q = pCore 2 H :=
    q.comap_pCore_of_ker_isPGroup (QuotientGroup.mk'_surjective _) hker
  let R : Subgroup T := (pCore 2 H).comap ι
  let Y : Subgroup T := closure ({a ^ 2, a * b} : Set T)
  have hVR : ∀ t : T, f t ∈ V → t ∈ R := by
    intro t ht
    change ι t ∈ pCore 2 H
    rw [← hcore]
    exact ((mem_omegaOneCenterAmbient_iff _ _).mp (hNV ht)).1
  have hYR : Y ≤ R := (closure_le _).mpr (by
    intro t ht
    rcases Set.mem_insert_iff.mp ht with rfl | ht
    · exact hVR _ hjV
    · exact Set.mem_singleton_iff.mp ht ▸ hVR _ habV)
  have hRne : R ≠ ⊤ := by
    intro ht
    have haR : a ∈ R := ht ▸ mem_top a
    have haQ : f a ∈ pCore 2 X := by
      change ι a ∈ (pCore 2 X).comap q
      rw [hcore]
      exact haR
    have hcomm := ((mem_omegaOneCenterAmbient_iff _ _).mp (hNV habV)).2.2 _ haQ
    have hcomm_b : f a * f b = f b * f a := by
      apply mul_left_cancel (a := f a)
      simpa only [map_mul, mul_assoc] using hcomm
    have he : (f a) ^ 3 = f a := by
      calc
        (f a) ^ 3 = f b * f a * (f b)⁻¹ := by
          simpa only [map_mul, map_inv, map_pow] using (congrArg f hconj).symm
        _ = f a := by rw [← hcomm_b]; group
    have hf2 : f (a ^ 2) = 1 := by
      rw [map_pow]
      apply mul_left_cancel (a := f a)
      simpa only [← pow_succ', mul_one] using he
    have hp := hk (a ^ 2) hf2
    have hd := orderOf_dvd_of_pow_eq_one (show a ^ 4 = 1 by simpa only [← pow_mul] using hp)
    rw [ha] at hd
    norm_num at hd
  obtain ⟨_, _, hYi, _, _, hYe⟩ := ABG.QuasiDihedral.explicit_subgroup_models
    (n := 4) (by decide) a b hcard ha hb hconj hgen
  have hYcard : Nat.card Y = 8 := by
    have hh := Y.card_mul_index
    change Nat.card Y * (closure ({a ^ 2, a * b} : Set T)).index = Nat.card T at hh
    rw [hYi, hcard] at hh
    omega
  have hRcard : Nat.card R ≤ 8 := by
    have hi := one_lt_index_of_ne_top hRne
    have hc := R.card_mul_index
    rw [hcard] at hc
    nlinarith
  have hYR_eq : Y = R := eq_of_le_of_card_ge hYR (hYcard ▸ hRcard)
  have hQrange : pCore 2 H ≤ ι.range := by
    rw [show ι.range = ((T : Subgroup G).subgroupOf H) from inclusion_range hTH]
    exact pCore_isPGroup.le_sylow_of_normal (T.subtype hTH)
  have hReq : R.map ι = pCore 2 H := map_comap_eq_self hQrange
  refine ⟨hTH, ?_, ?_⟩
  · exact hReq.symm.trans (congrArg (fun U : Subgroup T => U.map ι) hYR_eq.symm)
  · obtain ⟨eY⟩ := hYe
    exact ⟨(MulEquiv.subgroupCongr hReq.symm).trans
      ((R.equivMapOfInjective ι (inclusion_injective hTH)).symm.trans
        ((MulEquiv.subgroupCongr hYR_eq.symm).trans eY))⟩

private theorem quaternion_core_centralizer {H : Type*} [Group H] [Finite H]
    (Q : Subgroup H) (hc : centralizer (Q : Set H) ≤ Q)
    (eQ : Q ≃* QuaternionGroup 2)
    (z : H) (hz : orderOf z = 2) (hzZ : z ∈ center H) :
    centralizer (Q : Set H) = zpowers z ∧ center H = zpowers z := by
  let C := centralizer (Q : Set H)
  let f : C → center Q := fun c =>
    ⟨⟨c, hc c.property⟩, mem_center_iff.mpr fun x =>
      Subtype.ext (c.property x x.property)⟩
  have hf : Function.Injective f := by
    intro x y hxy
    apply Subtype.ext
    exact congrArg (fun t : center Q => ((t : Q) : H)) hxy
  have hCcard : Nat.card C ≤ 2 := by
    calc
      Nat.card C ≤ Nat.card (center Q) := Nat.card_le_card_of_injective f hf
      _ = Nat.card (center (QuaternionGroup 2)) :=
        Nat.card_congr (Subgroup.centerCongr eQ).toEquiv
      _ = 2 := QuaternionGroup.card_center_of_two_le 2 (by decide)
  have hZle : zpowers z ≤ C := zpowers_le.mpr (center_le_centralizer _ hzZ)
  have hZcard : Nat.card (zpowers z) = 2 := by rw [Nat.card_zpowers, hz]
  have heq : zpowers z = C := eq_of_le_of_card_ge hZle (hZcard ▸ hCcard)
  exact ⟨heq.symm, le_antisymm ((center_le_centralizer _).trans heq.ge)
    (zpowers_le.mpr hzZ)⟩

/-- Marked core identity, Q₈ equivalence, and exact conjugation kernel in
the original involution centralizer. -/
public theorem core_structure_of_presentation
    {G : Type*} [Group G] [Finite G] (T : Sylow 2 G)
    (hE : IsEvenCharacteristicAt T)
    (hno : ∀ K : Subgroup G, K.Normal → K.index ≠ 2)
    (hcard : Nat.card T = 16)
    (a b : T) (ha : orderOf a = 8) (hb : orderOf b = 2)
    (hconj : b * a * b⁻¹ = a ^ 3)
    (hgen : closure ({a, b} : Set T) = ⊤) :
    let z : G := ((a ^ 4 : T) : G)
    orderOf z = 2 ∧
    ∃ hTH : (T : Subgroup G) ≤ centralizer ({z} : Set G),
      let H := centralizer ({z} : Set G)
      let zH : H := ⟨z, mem_centralizer_singleton_iff.mpr rfl⟩
      pCore 2 H = (closure ({a ^ 2, a * b} : Set T)).map (inclusion hTH) ∧
      Nonempty ((pCore 2 H) ≃* QuaternionGroup 2) ∧
      centralizer (pCore 2 H : Set H) = zpowers zH ∧ center H = zpowers zH := by
  have hz : orderOf (((a ^ 4 : T) : G)) = 2 := by
    rw [Subgroup.orderOf_coe, orderOf_pow_of_dvd (by decide) (by rw [ha]; decide), ha]
  obtain ⟨hTH, hcore, ⟨eQ⟩⟩ :=
    core_identity_of_presentation T hE hno hcard a b ha hb hconj hgen
  let z : G := ((a ^ 4 : T) : G)
  let H := centralizer ({z} : Set G)
  let zH : H := ⟨z, mem_centralizer_singleton_iff.mpr rfl⟩
  have hzH : orderOf zH = 2 := (Subgroup.orderOf_coe zH).symm.trans hz
  have hzZ : zH ∈ center H := mem_center_iff.mpr fun x =>
    Subtype.ext (mem_centralizer_singleton_iff.mp x.property)
  have hc : centralizer (pCore 2 H : Set H) ≤ pCore 2 H :=
    Chapter1.mem_He_iff.mp (Chapter1.twoLocal_mem_He_of_sylow_le T hE
      (Theory.GroupTheory.isTwoLocal_involution_centralizer hz) hTH)
  exact ⟨hz, hTH, hcore, ⟨eQ⟩,
    quaternion_core_centralizer (pCore 2 H) hc eQ zH hzH hzZ⟩

/-- The complete marked quaternion-core input to the automorphism argument
of I.4.3, derived from its original source hypotheses. -/
public theorem source_core_structure
    {G : Type*} [Group G] [Finite G] (T : Sylow 2 G)
    (hE : IsEvenCharacteristicAt T)
    (hno : ∀ K : Subgroup G, K.Normal → K.index ≠ 2)
    (hT : IsSemidihedralGroup T) :
    Nat.card T = 16 ∧
    ∃ a b : T, orderOf a = 8 ∧ orderOf b = 2 ∧
      b * a * b⁻¹ = a ^ 3 ∧ closure ({a, b} : Set T) = ⊤ ∧
      let z : G := ((a ^ 4 : T) : G)
      orderOf z = 2 ∧
      ∃ hTH : (T : Subgroup G) ≤ centralizer ({z} : Set G),
        let H := centralizer ({z} : Set G)
        let zH : H := ⟨z, mem_centralizer_singleton_iff.mpr rfl⟩
        pCore 2 H = (closure ({a ^ 2, a * b} : Set T)).map (inclusion hTH) ∧
        Nonempty ((pCore 2 H) ≃* QuaternionGroup 2) ∧
        centralizer (pCore 2 H : Set H) = zpowers zH ∧ center H = zpowers zH := by
  have hcard := sylow_card_sixteen T hE hno hT
  obtain ⟨n, _, hc, a, b, ha, hb, hab, hg⟩ := hT
  have hn4 : n = 4 := Nat.pow_right_injective (by decide : 2 ≤ 2)
    (show 2 ^ n = 2 ^ 4 from hc.symm.trans hcard)
  subst n
  refine ⟨hcard, a, b, ha, hb, hab, hg, ?_⟩
  exact core_structure_of_presentation T hE hno hcard a b ha hb hab hg

end CFSG.Quasithin.ChapterI.SemidihedralCore
