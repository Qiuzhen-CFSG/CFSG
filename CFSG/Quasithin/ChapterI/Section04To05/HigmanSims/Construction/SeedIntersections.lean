module

public import CFSG.Quasithin.ChapterI.Section04To05.HigmanSims.Construction.OverlapCores
public import CFSG.Quasithin.ChapterI.Section04To05.HigmanSims.Construction.CubicCore
public import Theory.GroupAction.CardFourCubic

/-!
# Intersections of the five original HS seeds

In the involution centralizer's five-point action, two point stabilizers
have a common cubic. Lifting and applying Cauchy's theorem gives an actual
cubic normalizing both corresponding seed subgroups. Its fixed points on
the original seed are precisely the distinguished involution subgroup.
A cubic cannot preserve a plane containing that fixed point without fixing
the whole plane, so distinct seeds meet in that involution subgroup.

These are consequences of the original HS1--HS2 local data preceding
Aschbacher--Smith I.4.8, printed p.418.
-/

public noncomputable section

open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.HigmanSims

private theorem five_pair_cubic (i j : Fin 5) :
    ∃ a : Equiv.Perm (Fin 5), a i = i ∧ a j = j ∧ orderOf a = 3 := by
  have he : ∀ i j : Fin 5, ∃ a : Equiv.Perm (Fin 5),
      a i = i ∧ a j = j ∧ a ^ 3 = 1 ∧ a ≠ 1 := by decide +kernel
  obtain ⟨a, hi, hj, ha, hn⟩ := he i j
  exact ⟨a, hi, hj, orderOf_eq_prime ha hn⟩

variable {G : Type*} [Group G] [Finite G] {z : G} {V : Subgroup G}

/-- Two seeds in the original involution-centralizer orbit have an actual
common normalizing cubic in that same centralizer. -/
theorem TypeAt.exists_cubic_normalizing_seed_pair (h : TypeAt z V)
    (g : G) (hg : g ∈ involutionCentralizer z) :
    ∃ x : G, x ∈ involutionCentralizer z ⊓ normalizer (V : Set G) ∧
      x ∈ normalizer (V.map (MulAut.conj g).toMonoidHom : Set G) ∧
      orderOf x = 3 := by
  obtain ⟨f, i, hf, _, hi⟩ := h.exists_overlap_five_marking
  let gH : involutionCentralizer z := ⟨g, hg⟩
  obtain ⟨a, hai, haj, ha3⟩ := five_pair_cubic i (f gH i)
  obtain ⟨y, hy⟩ := hf a
  have hyV : (y : G) ∈ normalizer (V : Set G) := by
    change y ∈ (normalizer (V : Set G)).subgroupOf (involutionCentralizer z)
    rw [hi]
    change f y i = i
    rw [hy, hai]
  have hygV : ((gH⁻¹ * y * gH : involutionCentralizer z) : G) ∈
      normalizer (V : Set G) := by
    change gH⁻¹ * y * gH ∈
      (normalizer (V : Set G)).subgroupOf (involutionCentralizer z)
    rw [hi]
    change f (gH⁻¹ * y * gH) i = i
    simp only [map_mul, map_inv, Equiv.Perm.mul_apply, hy, haj]
    exact (f gH).symm_apply_apply i
  have hyVg : (y : G) ∈
      normalizer (V.map (MulAut.conj g).toMonoidHom : Set G) := by
    rw [← map_equiv_normalizer_eq]
    refine ⟨g⁻¹ * (y : G) * g, hygV, ?_⟩
    simp [MulAut.conj_apply, mul_assoc]
  let J := involutionCentralizer z ⊓ normalizer (V : Set G) ⊓
    normalizer (V.map (MulAut.conj g).toMonoidHom : Set G)
  let yJ : J := ⟨y, ⟨y.property, hyV⟩, hyVg⟩
  have hd : 3 ∣ orderOf yJ := by
    rw [← orderOf_coe yJ]
    change 3 ∣ orderOf (y : G)
    rw [orderOf_coe y]
    have hd := orderOf_map_dvd f y
    rwa [hy, ha3] at hd
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := J) 3
    (hd.trans (orderOf_dvd_natCard yJ))
  exact ⟨x, x.property.1, x.property.2, (orderOf_coe x).trans hx⟩

/-- Distinct seeds in the original involution-centralizer orbit meet exactly
in the subgroup generated by the original marked involution. -/
theorem TypeAt.seed_conjugate_intersection (h : TypeAt z V)
    (g : G) (hg : g ∈ involutionCentralizer z)
    (hgn : g ∉ normalizer (V : Set G)) :
    V ⊓ V.map (MulAut.conj g).toMonoidHom = zpowers z := by
  let Vg := V.map (MulAut.conj g).toMonoidHom
  let W := V ⊓ Vg
  have hzW : z ∈ W := by
    refine ⟨h.involution_mem_seed, z, h.involution_mem_seed, ?_⟩
    change g * z * g⁻¹ = z
    rw [mem_centralizer_singleton_iff.mp hg, mul_inv_cancel_right]
  have hZW : zpowers z ≤ W := zpowers_le.mpr hzW
  have hWlower : 2 ≤ Nat.card W := by
    have hc := card_le_of_le hZW
    rwa [Nat.card_zpowers, h.involution] at hc
  have hWV : Nat.card W ∣ 8 := by
    have hc := card_dvd_of_le (show W ≤ V from inf_le_left)
    rwa [h.seed_card] at hc
  have hWcases : Nat.card W = 1 ∨ Nat.card W = 2 ∨
      Nat.card W = 4 ∨ Nat.card W = 8 := by
    have hm := (Nat.mem_divisors (m := 8) (n := Nat.card W)).mpr ⟨hWV, by decide⟩
    rw [show Nat.divisors 8 = {1, 2, 4, 8} from by decide] at hm
    simpa only [Finset.mem_insert, Finset.mem_singleton] using hm
  obtain ⟨x, hx, hxVg, hx3⟩ := h.exists_cubic_normalizing_seed_pair g hg
  have hxW : x ∈ normalizer (W : Set G) :=
    inf_normalizer_le_normalizer_inf ⟨hx.2, hxVg⟩
  have hWne4 : Nat.card W ≠ 4 := by
    intro hc4
    let a := W.normalizerMonoidHom ⟨x, hxW⟩
    have ha3 : a ^ 3 = 1 := by
      rw [← map_pow]
      have he : (⟨x, hxW⟩ : normalizer (W : Set G)) ^ 3 = 1 :=
        Subtype.ext (hx3 ▸ pow_orderOf_eq_one x)
      rw [he, map_one]
    let zW : W := ⟨z, hzW⟩
    have hzne : zW ≠ 1 := by
      intro he
      have hz : z = 1 := congrArg Subtype.val he
      have hh := h.involution
      simp [hz] at hh
    have haz : a zW = zW := Subtype.ext (by
      change x * z * x⁻¹ = z
      rw [mem_centralizer_singleton_iff.mp hx.1, mul_inv_cancel_right])
    have ha : a = 1 := by
      by_contra hn
      exact Theory.GroupAction.CardFourCubic.moves_nonidentity hc4 a ha3 hn zW hzne haz
    have hWfix : W ≤ V ⊓ centralizer ({x} : Set G) := by
      intro w hw
      refine ⟨hw.1, mem_centralizer_singleton_iff.mpr ?_⟩
      have he := congrArg (fun f : MulAut W => (f ⟨w, hw⟩ : G)) ha
      change x * w * x⁻¹ = w at he
      exact (mul_inv_eq_iff_eq_mul.mp he).symm
    rw [h.cubic_seed_fixed x hx hx3] at hWfix
    have hh := card_le_of_le hWfix
    rw [hc4, Nat.card_zpowers, h.involution] at hh
    omega
  have hWne8 : Nat.card W ≠ 8 := by
    intro hc8
    have he : W = V := eq_of_le_of_card_ge inf_le_left (by rw [hc8, h.seed_card])
    have hVVg : V ≤ Vg := he ▸ (show W ≤ Vg from inf_le_right)
    have hVgc : Nat.card Vg = 8 := by
      rw [card_map_of_injective (MulAut.conj g).injective, h.seed_card]
    have heV : V = Vg := eq_of_le_of_card_ge hVVg (by rw [h.seed_card, hVgc])
    exact hgn (mem_normalizer_iff_map_conj_eq.mpr heV.symm)
  have hW2 : Nat.card W = 2 := by
    rcases hWcases with h1 | h2 | h4 | h8
    · omega
    · exact h2
    · exact (hWne4 h4).elim
    · exact (hWne8 h8).elim
  exact (eq_of_le_of_card_ge hZW (by rw [hW2, Nat.card_zpowers, h.involution])).symm

end CFSG.Quasithin.HigmanSims
