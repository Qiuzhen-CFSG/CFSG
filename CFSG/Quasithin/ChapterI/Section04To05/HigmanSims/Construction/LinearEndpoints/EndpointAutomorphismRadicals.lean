module

public import CFSG.Quasithin.ChapterI.Section04To05.HigmanSims.Construction.LinearEndpoints.OppositeRadicalMarking

/-!
# Endpoint automorphisms retain both actual elementary radicals

An automorphism preserving the original natural quotient preserves its full
kernel. It also preserves the original opposite elementary sixteen: its image
is again an elementary sixteen with the same full root image, so affine
uniqueness identifies it with the same physical subgroup. Fixing the chosen
torus actor consequently preserves the subgroup generated by both radicals
and that actor.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Matrix SemidirectProduct
namespace CFSG.Quasithin.HigmanSims
open Representation.SL2FourNatural Representation.SL2FourNatural.BorelFactors
variable {G : Type*} [Group G]

/-- Preserving the original quotient preserves its entire physical kernel. -/
theorem NaturalEndpointData.quotient_automorphism_preserves_kernel {A : Subgroup G}
    [IsElementaryAbelian 2 A] (d : NaturalEndpointData A)
    (α : MulAut d.carrier) (hα : ∀ g, d.quotient (α g) = d.quotient g) :
    (A.subgroupOf d.carrier).map α.toMonoidHom = A.subgroupOf d.carrier := by
  rw [← d.quotient_kernel]
  ext x
  constructor
  · rintro ⟨g, hg, rfl⟩
    change d.quotient (α g) = 1
    exact (hα g).trans hg
  · intro hx
    refine ⟨α.symm x, ?_, α.apply_symm_apply x⟩
    change d.quotient (α.symm x) = 1
    rw [← hα (α.symm x), α.apply_symm_apply]
    exact hx

/-- Every quotient-preserving endpoint automorphism retains the entire
original opposite radical, with no restriction on its displacement cocycle. -/
theorem NaturalEndpointData.quotient_automorphism_preserves_opposite {A : Subgroup G}
    [IsElementaryAbelian 2 A] (d : NaturalEndpointData A)
    (B : Subgroup G) [IsElementaryAbelian 2 B] (hB16 : Nat.card B = 16)
    (hBP : B ≤ d.carrier) (hBA : B ≤ normalizer (A : Set G))
    (hR : U0.map d.embedding = ((d.symplectic_quotient.toMonoidHom.comp
      (QuotientGroup.mk' (A.subgroupOf (normalizer (A : Set G))))).comp
        (inclusion hBA)).range)
    (α : MulAut d.carrier) (hα : ∀ g, d.quotient (α g) = d.quotient g) :
    (B.subgroupOf d.carrier).map α.toMonoidHom = B.subgroupOf d.carrier := by
  obtain ⟨f, hfq, _, _, hfB, _⟩ :=
    d.exists_opposite_radical_marking B hB16 hBP hBA hR
  let e : d.carrier ≃* Matrix.SL2.Affine F := α.trans f
  let C := (B.subgroupOf d.carrier).map e.toMonoidHom
  let eB : B ≃* C := (subgroupOfEquivOfLe hBP).symm.trans
    ((B.subgroupOf d.carrier).equivMapOfInjective e.toMonoidHom e.injective)
  let : IsElementaryAbelian 2 C :=
    IsElementaryAbelian.of_surjective eB.toMonoidHom eB.surjective
  have hC : C = Matrix.SL2.oppositeRoot := by
    apply Matrix.SL2.elementary_oppositeRoot_of_image C
    · exact (Nat.card_congr eB.toEquiv).symm.trans hB16
    · change ((B.subgroupOf d.carrier).map e.toMonoidHom).map rightHom = U0
      rw [Subgroup.map_map]
      have he : (rightHom : Matrix.SL2.Affine F →* SL).comp e.toMonoidHom =
          d.quotient := by
        apply MonoidHom.ext
        intro g
        exact (hfq (α g)).trans (hα g)
      rw [he]
      have hrange : (B.subgroupOf d.carrier).map d.quotient =
          (d.quotient.comp (inclusion hBP)).range := by
        ext x
        constructor
        · rintro ⟨g, hg, rfl⟩
          exact ⟨⟨g, hg⟩, rfl⟩
        · rintro ⟨b, rfl⟩
          exact ⟨inclusion hBP b, b.property, rfl⟩
      rw [hrange]
      exact d.opposite_quotient_range B hBP hBA hR
  apply Subgroup.map_injective (show Function.Injective f.toMonoidHom from f.injective)
  rw [Subgroup.map_map, hfB]
  exact hC

/-- Fixing the chosen actor also preserves the whole subgroup generated by
the two original radicals and that actor. -/
theorem NaturalEndpointData.quotient_automorphism_preserves_borel {A : Subgroup G}
    [IsElementaryAbelian 2 A] (d : NaturalEndpointData A)
    (B : Subgroup G) [IsElementaryAbelian 2 B] (hB16 : Nat.card B = 16)
    (hBP : B ≤ d.carrier) (hBA : B ≤ normalizer (A : Set G))
    (hR : U0.map d.embedding = ((d.symplectic_quotient.toMonoidHom.comp
      (QuotientGroup.mk' (A.subgroupOf (normalizer (A : Set G))))).comp
        (inclusion hBA)).range)
    (α : MulAut d.carrier) (hα : ∀ g, d.quotient (α g) = d.quotient g)
    (t : d.carrier) (ht : α t = t) :
    ((A.subgroupOf d.carrier ⊔ B.subgroupOf d.carrier) ⊔ zpowers t).map
      α.toMonoidHom = (A.subgroupOf d.carrier ⊔ B.subgroupOf d.carrier) ⊔ zpowers t := by
  rw [Subgroup.map_sup, Subgroup.map_sup,
    d.quotient_automorphism_preserves_kernel α hα,
    d.quotient_automorphism_preserves_opposite B hB16 hBP hBA hR α hα,
    MonoidHom.map_zpowers]
  change _ ⊔ zpowers (α t) = _
  rw [ht]

end CFSG.Quasithin.HigmanSims
