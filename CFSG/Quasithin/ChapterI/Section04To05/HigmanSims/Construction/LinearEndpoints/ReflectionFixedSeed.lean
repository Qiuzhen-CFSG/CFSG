module

public import CFSG.Quasithin.ChapterI.Section04To05.HigmanSims.Construction.LinearEndpoints.ReflectionSeedMovement
public import CFSG.Quasithin.ChapterI.Section04To05.HigmanSims.Construction.LinearEndpoints.CubicReflectionAction
public import Theory.GroupAction.PrimeOrderConjugation
import all CFSG.Quasithin.ChapterI.Section04To05.HigmanSims.Construction.LinearEndpoints.ReflectionSeedMovement

/-!
# A literal seed at the endpoint reflection's commuting involution

The full normalizer cubic centralizer has order18, and the reflection fixes
exactly two of its elements. Its unique involution is conjugate there to
the original seed involution. That same conjugator transports the original
seed to the join of the fixed involution and its fixed plane on the radical.
No replacement seed, involution class, or fixed-plane hypothesis is assumed.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.HigmanSims
variable {G : Type*} [Group G] [Finite G] {z : G} {V : Subgroup G}

/-- The involution fixed by the same endpoint reflection has the literal
conjugate original seed generated by it and its fixed plane on A. -/
theorem TypeAt.endpoint_reflection_fixed_seed (h : TypeAt z V)
    (W A : Subgroup G) [IsElementaryAbelian 2 A]
    (hWV : W≤V) (hW4 : Nat.card W=4)
    (hAC : A≤centralizer (W:Set G))
    (hAP : A⊓(normalizer (V:Set G)).pCoreIn 2=W)
    (d : NaturalEndpointData A) (u t r : G)
    (huV : u∈V) (huW : u∉W) (huN : u∈normalizer (A:Set G))
    (hut : Commute u t) (ht : t∈d.carrier) (ht3 : orderOf t=3)
    (hr : r∈d.carrier) (hr2 : orderOf r=2) (hinv : r*t*r⁻¹=t⁻¹) :
    let E := normalizer (A:Set G)⊓centralizer ({t}:Set G)
    ∃ v g:G, v∈E ∧ orderOf v=2 ∧ Commute v r ∧ g∈E ∧ g*u*g⁻¹=v ∧
      TypeAt v (V.map (MulAut.conj g).toMonoidHom) ∧
      V.map (MulAut.conj g).toMonoidHom = zpowers v⊔(A⊓centralizer ({v}:Set G)) ∧
      Nat.card (A⊓centralizer ({v}:Set G):Subgroup G)=4 := by
  classical
  let E := normalizer (A:Set G)⊓centralizer ({t}:Set G)
  let F := E⊓centralizer ({r}:Set G)
  obtain ⟨_,hF2,_⟩ := d.cubic_reflection_action t r ht ht3 hr hr2 hinv
  obtain ⟨v,hv2⟩ := exists_prime_orderOf_dvd_card' (G:=F) 2 (by rw [hF2])
  let vE : E := ⟨v,v.property.1⟩
  have hvE2 : orderOf vE=2 := (orderOf_coe vE).symm.trans ((orderOf_coe v).trans hv2)
  have hu1 : u≠1 := fun he => huW (he ▸ W.one_mem)
  have huT := h.at_seed_point u huV hu1
  let uE : E := ⟨u,huN,mem_centralizer_singleton_iff.mpr hut.eq⟩
  have huE2 : orderOf uE=2 := (orderOf_coe uE).symm.trans huT.involution
  have hE18 : Nat.card E=18 := (d.cubic_full_normalizer_centralizer t ht ht3).1
  have hi : (zpowers uE).index=9 := by
    have hh := (zpowers uE).card_mul_index
    rw [Nat.card_zpowers,huE2,hE18] at hh
    omega
  obtain ⟨g,hg⟩ := Theory.GroupAction.exists_conjugate_mem_of_prime_order
    (zpowers uE) Nat.prime_two hvE2 (by rw [hi]; decide)
  have hgu : g⁻¹*vE*g=uE := by
    rw [mem_zpowers_iff_mem_range_orderOf,huE2] at hg
    obtain ⟨n,hn,he⟩ := Finset.mem_image.mp hg
    have hn2 : n<2 := Finset.mem_range.mp hn
    interval_cases n
    · have hv1 : vE=1 := by
        have hh := congrArg (fun x:E => g*x*g⁻¹) he
        simpa only [pow_zero,mul_one,one_mul,mul_inv_cancel,
          mul_assoc,mul_inv_cancel_left,inv_mul_cancel_left] using hh.symm
      simp [hv1] at hvE2
    · simpa only [pow_one] using he.symm
  have heuv : (g:G)*u*(g:G)⁻¹=(v:G) := by
    have hh := congrArg (fun x:E => (x:G)) hgu
    change (g:G)⁻¹*(v:G)*(g:G)=u at hh
    calc
      (g:G)*u*(g:G)⁻¹ = (g:G)*((g:G)⁻¹*(v:G)*(g:G))*(g:G)⁻¹ := by rw [hh]
      _ = (v:G) := by group
  let a := MulAut.conj (g:G)
  have haA : A.map a.toMonoidHom=A := mem_normalizer_iff_map_conj_eq.mp g.property.1
  have hAW : A⊓centralizer ({u}:Set G)=W :=
    radical_seed_centralizer h W A hWV hW4 hAC hAP u huV huW
  have hfix : W.map a.toMonoidHom=A⊓centralizer ({(v:G)}:Set G) := by
    rw [←hAW,map_inf _ _ _ a.injective,haA]
    congr 1
    simpa only [Set.image_singleton,show a u=(v:G) from heuv] using
      map_centralizer_equiv ({u}:Set G) a
  have hV : zpowers u⊔W=V := by
    have hnorm : u∈normalizer (W:Set G) := centralizer_le_normalizer _
      (fun w hw => by let := h.elementary; exact setLike_mul_comm (hWV hw) huV)
    apply eq_of_le_of_card_ge (sup_le (zpowers_le.mpr huV) hWV)
    rw [sup_comm,card_sup_zpowers_of_normalizing_involution W u
      (huT.involution ▸ pow_orderOf_eq_one u) huW hnorm,hW4,h.seed_card]
  have hseed : V.map a.toMonoidHom=zpowers (v:G)⊔(A⊓centralizer ({(v:G)}:Set G)) := by
    rw [←hV,Subgroup.map_sup,MonoidHom.map_zpowers,hfix]
    exact congrArg (fun x:G => zpowers x⊔(A⊓centralizer ({(v:G)}:Set G))) heuv
  refine ⟨v,g,v.property.1,(orderOf_coe v).trans hv2,
    mem_centralizer_singleton_iff.mp v.property.2,g.property,heuv,?_,hseed,?_⟩
  · simpa only [a,MulAut.conj_apply,heuv] using huT.map a
  · rw [←hfix,card_map_of_injective a.injective,hW4]

end CFSG.Quasithin.HigmanSims
