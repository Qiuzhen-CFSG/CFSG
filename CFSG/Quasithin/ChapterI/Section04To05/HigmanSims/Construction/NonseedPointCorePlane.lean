module

public import CFSG.Quasithin.ChapterI.Section04To05.HigmanSims.Construction.PointCoreE8Orbit
public import CFSG.Quasithin.ChapterI.Section04To05.HigmanSims.Construction.PointCoreIntersectionSeeds

/-!
# Original point-core intersections inside a nonseed eight

For a noncentral point v of an original nonseed eight E, the literal
intersection E∩Q_v is precisely the plane generated by the marked point
and v. The whole intersection Q_z∩Q_v is an original conjugate seed;
an intersection larger than the displayed plane would identify E with
that seed, contradicting its nonseed membership.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.HigmanSims
variable {G : Type*} [Group G] [Finite G] {z : G} {V : Subgroup G}

omit [Finite G] in
private theorem involution_mem_own_core (v : G) (hv : orderOf v = 2) :
    v ∈ (involutionCentralizer v).pCoreIn 2 := by
  let H := involutionCentralizer v
  let vH : H := ⟨v, mem_centralizer_singleton_iff.mpr rfl⟩
  have hz : zpowers vH ≤ center H := by
    apply zpowers_le.mpr
    exact mem_center_iff.mpr fun x => Subtype.ext
      (mem_centralizer_singleton_iff.mp x.property)
  have hp : IsPGroup 2 (zpowers vH) := IsPGroup.of_card (n := 1) (by
    rw [Nat.card_zpowers, ← orderOf_coe, show (vH : G) = v from rfl, hv, pow_one])
  have hn : (zpowers vH).Normal := ⟨fun x hx g => by
    rw [mem_center_iff.mp (hz hx) g, mul_inv_cancel_right]
    exact hx⟩
  have hc : zpowers vH ≤ pCore 2 H := le_sSup ⟨hn, hp⟩
  exact ⟨vH, hc (mem_zpowers vH), rfl⟩

private theorem generated_plane_card (h : TypeAt z V) (E : pointCoreEights z)
    (v : G) (hv : v ∈ E.val) (hvz : v ∉ zpowers z) :
    Nat.card (zpowers z ⊔ zpowers v : Subgroup G) = 4 := by
  let : IsElementaryAbelian 2 E.val := E.property.2.2.1
  rw [card_sup_zpowers_of_normalizing_involution _ _
    (elemPow_eq_one_of_isElementaryAbelian v hv) hvz]
  · rw [Nat.card_zpowers, h.involution]
  · apply centralizer_le_normalizer
    rw [zpowers_eq_closure, centralizer_closure]
    exact mem_centralizer_singleton_iff.mpr (setLike_mul_comm hv E.property.2.1)

/-- A point of a nonseed eight outside the marked line has precisely the
generated plane as its literal point-core intersection with that eight. -/
theorem TypeAt.nonseed_eight_point_core_intersection (h : TypeAt z V)
    (E : pointCoreEights z) (hEn : E.val ∉ pointCoreSeedOrbit z V)
    (v : G) (hv : v ∈ E.val) (hvz : v ∉ zpowers z) :
    E.val ⊓ (involutionCentralizer v).pCoreIn 2 = zpowers z ⊔ zpowers v := by
  let : IsElementaryAbelian 2 E.val := E.property.2.2.1
  let Q := (involutionCentralizer z).pCoreIn 2
  let R := (involutionCentralizer v).pCoreIn 2
  let D := E.val ⊓ R
  have hv1 : v ≠ 1 := fun he => hvz (he ▸ (zpowers z).one_mem)
  have hvne : v ≠ z := fun he => hvz (he ▸ mem_zpowers z)
  have hv2 : orderOf v = 2 := orderOf_eq_prime
    (elemPow_eq_one_of_isElementaryAbelian v hv) hv1
  have hzR : z ∈ R := h.centralizer_core_involution_reciprocal v (E.property.1 hv) hv2
  have hvR : v ∈ R := involution_mem_own_core v hv2
  have hplane : zpowers z ⊔ zpowers v ≤ D := by
    apply sup_le <;> apply zpowers_le.mpr
    · exact ⟨E.property.2.1, hzR⟩
    · exact ⟨hv, hvR⟩
  obtain ⟨g, hg⟩ := h.point_core_intersection_seed v (E.property.1 hv) hv2 hvne
  have hDne : D ≠ E.val := by
    intro he
    have hES : E.val ≤ V.map (MulAut.conj (g : G)).toMonoidHom := by
      rw [← hg, ← he]
      exact le_inf (inf_le_left.trans E.property.1) inf_le_right
    have hSc : Nat.card (V.map (MulAut.conj (g : G)).toMonoidHom) = 8 := by
      rw [card_map_of_injective (MulAut.conj (g : G)).injective, h.seed_card]
    have heS := eq_of_le_of_card_ge hES (by rw [hSc, E.property.2.2.2])
    exact hEn ⟨g, heS.symm⟩
  have hD4 : Nat.card D ≤ 4 := by
    have hh := (D.subgroupOf E.val).card_mul_index
    rw [Nat.card_congr (subgroupOfEquivOfLe (show D ≤ E.val from inf_le_left)).toEquiv,
      E.property.2.2.2] at hh
    change Nat.card D * D.relIndex E.val = 8 at hh
    have hi : D.relIndex E.val ≠ 1 := fun he => hDne
      (le_antisymm inf_le_left (relIndex_eq_one.mp he))
    have hip : D.relIndex E.val ≠ 0 := index_ne_zero_of_finite
    have hi2 : 2 ≤ D.relIndex E.val := by omega
    have hb := Nat.mul_le_mul_left (Nat.card D) hi2
    rw [hh] at hb
    omega
  exact (eq_of_le_of_card_ge hplane
    (hD4.trans_eq (generated_plane_card h E v hv hvz).symm)).symm

/-- The same actual point-core intersection has order four. -/
theorem TypeAt.nonseed_eight_point_core_intersection_card (h : TypeAt z V)
    (E : pointCoreEights z) (hEn : E.val ∉ pointCoreSeedOrbit z V)
    (v : G) (hv : v ∈ E.val) (hvz : v ∉ zpowers z) :
    Nat.card (E.val ⊓ (involutionCentralizer v).pCoreIn 2 : Subgroup G) = 4 := by
  rw [h.nonseed_eight_point_core_intersection E hEn v hv hvz]
  exact generated_plane_card h E v hv hvz

end CFSG.Quasithin.HigmanSims
