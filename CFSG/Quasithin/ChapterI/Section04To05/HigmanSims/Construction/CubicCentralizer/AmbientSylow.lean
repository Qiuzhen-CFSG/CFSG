module

public import CFSG.Quasithin.ChapterI.Section04To05.HigmanSims.Construction.CubicCentralizer.DihedralShape
public import Theory.GroupTheory.CharacteristicCentralizerFusion
public import Theory.GroupTheory.RelativeSylowNormalizer

/-!
# A dihedral Sylow subgroup of the full original cubic centralizer

The constructed dihedral eight has center generated by the original marked
involution. Its full normalizer therefore centralizes that involution. Its
index three in the proved local cubic centralizer promotes the same actual
eight to Sylow in the whole ambient cubic centralizer.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.HigmanSims
variable {G : Type*} [Group G] [Finite G] {z : G} {V : Subgroup G}

/-- The full ambient cubic centralizer has a literal dihedral Sylow eight
whose ambient center is generated by the original marked involution. -/
theorem TypeAt.cubic_centralizer_ambient_sylow (h : TypeAt z V) (t : G)
    (ht : t ∈ involutionCentralizer z) (ht3 : orderOf t = 3) :
    ∃ S : Sylow 2 (centralizer ({t} : Set G)), Nat.card S = 8 ∧
      Nonempty (S ≃* DihedralGroup 4) ∧
      let D := (S : Subgroup (centralizer ({t} : Set G))).map
        (centralizer ({t} : Set G)).subtype
      (center D).map D.subtype = zpowers z := by
  obtain ⟨c,b,hc4,hc2,_,_,hbH,hct,hbt,_,hD8,⟨eD⟩,hL24,_,_⟩ :=
    h.cubic_point_centralizer_dihedral_shape t ht ht3
  let C := centralizer ({t} : Set G)
  let L := involutionCentralizer z ⊓ C
  let D : Subgroup G := zpowers c ⊔ zpowers b
  have hcH : c ∈ involutionCentralizer z := by
    apply mem_centralizer_singleton_iff.mpr
    rw [←hc2]
    exact (Commute.self_pow c 2).eq
  have hDH : D ≤ involutionCentralizer z := sup_le (zpowers_le.mpr hcH) (zpowers_le.mpr hbH)
  have hDC : D ≤ C := sup_le
    (zpowers_le.mpr (mem_centralizer_singleton_iff.mpr hct.eq))
    (zpowers_le.mpr (mem_centralizer_singleton_iff.mpr hbt.eq))
  have hDL : D ≤ L := le_inf hDH hDC
  have hzD : z ∈ D := hc2 ▸ D.pow_mem
    (show c ∈ D from mem_sup_left (mem_zpowers c)) 2
  have hzZ : (⟨z,hzD⟩ : D) ∈ center D := by
    apply mem_center_iff.mpr
    intro x
    exact Subtype.ext (mem_centralizer_singleton_iff.mp (hDH x.property))
  have hZ2 : Nat.card (center D)=2 := DihedralGroup.center_card_of_equiv (n:=2) (by decide) eD
  have hcenter : (center D).map D.subtype = zpowers z := by
    have hle : zpowers z ≤ (center D).map D.subtype :=
      zpowers_le.mpr ⟨⟨z,hzD⟩,hzZ,rfl⟩
    apply (eq_of_le_of_card_ge hle ?_).symm
    rw [card_map_of_injective D.subtype_injective,hZ2,Nat.card_zpowers,h.involution]
  have hN : normalizer (D : Set G) ≤ involutionCentralizer z :=
    normalizer_le_centralizer_of_characteristic_involution D (center D) z h.involution hcenter
  let DL := D.subgroupOf L
  have hDL8 : Nat.card DL=8 := (Nat.card_congr (subgroupOfEquivOfLe hDL).toEquiv).trans hD8
  have hDL3 : DL.index=3 := by
    have hh := DL.card_mul_index
    rw [hDL8,show Nat.card L=24 from hL24] at hh
    omega
  have hp : IsPGroup 2 DL := IsPGroup.of_card (n:=3) hDL8
  let R : Sylow 2 L := hp.toSylow (by rw [hDL3]; decide)
  have hR : (R : Subgroup L).map L.subtype=D := map_subgroupOf_eq_of_le hDL
  obtain ⟨S,hS⟩ := exists_sylow_eq_of_relative_normalizer_le
    (H:=C) (K:=L) ⟨R,hR⟩ inf_le_right (fun x hx => ⟨hN hx.2,hx.1⟩)
  let e : S ≃* D := ((S : Subgroup C).equivMapOfInjective C.subtype C.subtype_injective).trans
    (MulEquiv.subgroupCongr hS)
  refine ⟨S,(Nat.card_congr e.toEquiv).trans hD8,⟨e.trans eD⟩,?_⟩
  change (center ((S : Subgroup C).map C.subtype)).map
    ((S : Subgroup C).map C.subtype).subtype = zpowers z
  have hS' : (S : Subgroup C).map C.subtype = D := hS
  rw [hS']
  exact hcenter

end CFSG.Quasithin.HigmanSims
