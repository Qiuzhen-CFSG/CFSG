module

public import CFSG.Quasithin.ChapterI.Section04To05.HigmanSims.Construction.CubicCentralizer.Reflection
public import Theory.GroupTheory.DihedralGeneratedFactor
public import Theory.GroupTheory.DisjointCommutingProduct

/-!
# The actual order-24 local cubic centralizer

The cyclic four and its inverting involution generate a literal dihedral eight.
The proved order-24 centralizer then forces its direct product with the
cubic cyclic three to be the whole original local centralizer.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.HigmanSims
variable {G : Type*} [Group G] [Finite G] {z : G} {V : Subgroup G}

/-- The original local cubic centralizer contains, and is generated by, the
actual cubic, its central cyclic four, and an actual inverting involution. -/
theorem TypeAt.cubic_point_centralizer_dihedral_shape (h : TypeAt z V) (t : G)
    (ht : t ∈ involutionCentralizer z) (ht3 : orderOf t = 3) :
    ∃ c b : G, orderOf c = 4 ∧ c ^ 2 = z ∧
      c ∈ (center ((involutionCentralizer z).pCoreIn 2)).map
        ((involutionCentralizer z).pCoreIn 2).subtype ∧
      orderOf b = 2 ∧ b ∈ involutionCentralizer z ∧
      Commute c t ∧ Commute b t ∧ b * c * b⁻¹ = c⁻¹ ∧
      Nat.card (zpowers c ⊔ zpowers b : Subgroup G) = 8 ∧
      Nonempty ((zpowers c ⊔ zpowers b : Subgroup G) ≃* DihedralGroup 4) ∧
      Nat.card (involutionCentralizer z ⊓ centralizer ({t} : Set G) : Subgroup G) = 24 ∧
      Nonempty ((involutionCentralizer z ⊓ centralizer ({t} : Set G) : Subgroup G) ≃*
        (Multiplicative (ZMod 3) × DihedralGroup 4)) ∧
      ∃ e : (zpowers t × (zpowers c ⊔ zpowers b : Subgroup G)) ≃*
          ↥(involutionCentralizer z ⊓ (centralizer ({t} : Set G) : Subgroup G)),
        ∀ x y, (e (x, y) : G) = (x : G) * (y : G) := by
  classical
  obtain ⟨c, b, hc4, hc2, hcZ, hct, hb2, hbH, hbt, hbc, hbQ⟩ :=
    h.cubic_point_centralizer_reflection t ht ht3
  let H := involutionCentralizer z
  let Q := H.pCoreIn 2
  have hcQ : c ∈ Q := by
    obtain ⟨cQ, hcQ, heq⟩ := hcZ
    exact heq ▸ cQ.property
  have hcH : c ∈ H := pCoreIn_le 2 H hcQ
  have hbout : b ∉ zpowers c := by
    intro hb
    exact hbQ (zpowers_le.mpr hcQ hb)
  have hbSq : b ^ 2 = 1 := by
    simpa [hb2] using pow_orderOf_eq_one b
  obtain ⟨hD8, hD⟩ := DihedralGroup.sup_zpowers_equiv_of_inversion
    (by decide : 0 < 4) c b hc4 hbSq hbout hbc
  let D : Subgroup G := zpowers c ⊔ zpowers b
  have hDle : D ≤ H := by
    dsimp [D]
    apply sup_le
    · exact zpowers_le.mpr hcH
    · exact zpowers_le.mpr hbH
  have hDct : D ≤ centralizer ({t} : Set G) := by
    dsimp [D]
    apply sup_le
    · exact zpowers_le.mpr (mem_centralizer_singleton_iff.mpr hct.eq)
    · exact zpowers_le.mpr (mem_centralizer_singleton_iff.mpr hbt.eq)
  have htd : Disjoint (zpowers t) D :=
    disjoint_of_coprime_natCard (by rw [Nat.card_zpowers, ht3, hD8]; decide)
  have htD : zpowers t ≤ centralizer (D : Set G) := by
    apply zpowers_le.mpr
    rw [mem_centralizer_iff]
    intro y hy
    exact mem_centralizer_singleton_iff.mp (hDct hy)
  obtain ⟨e, he⟩ := exists_mulEquiv_prod_sup_of_disjoint_of_commuting
    (zpowers t) D htd htD
  have hle : (zpowers t ⊔ D : Subgroup G) ≤ H ⊓ centralizer ({t} : Set G) := by
    apply sup_le
    · exact le_inf (zpowers_le.mpr ht)
        (zpowers_le.mpr (mem_centralizer_singleton_iff.mpr rfl))
    · exact le_inf hDle hDct
  have hcardC := (h.cubic_point_centralizer_order t ht ht3).1
  have hcardK : Nat.card (zpowers t ⊔ D : Subgroup G) = 24 := by
    rw [← Nat.card_congr e.toEquiv, Nat.card_prod, Nat.card_zpowers, ht3, hD8]
  have heq : zpowers t ⊔ D = H ⊓ (centralizer ({t} : Set G) : Subgroup G) :=
    eq_of_le_of_card_ge hle (by rw [hcardC, hcardK])
  have hD8' : Nat.card D = 8 := by simpa [D] using hD8
  have hDihedral : Nonempty (D ≃* DihedralGroup 4) := by simpa [D] using hD
  let k := e.trans (MulEquiv.subgroupCongr heq)
  let f : zpowers t ≃* Multiplicative (ZMod 3) := mulEquivOfCyclicCardEq (by
    rw [Nat.card_zpowers, ht3]
    simp)
  refine ⟨c, b, hc4, hc2, hcZ, hb2, hbH, hct, hbt, hbc, hD8', hDihedral,
    hcardC, ⟨k.symm.trans (MulEquiv.prodCongr f hDihedral.some)⟩, k, ?_⟩
  intro x y
  change ((e (x, y) : G)) = (x : G) * (y : G)
  exact he x y

end CFSG.Quasithin.HigmanSims
