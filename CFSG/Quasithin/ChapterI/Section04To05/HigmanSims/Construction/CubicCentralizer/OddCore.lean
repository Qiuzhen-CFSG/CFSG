module

public import CFSG.Quasithin.ChapterI.Section04To05.HigmanSims.Construction.CubicCentralizer.PureFour
public import CFSG.Quasithin.ChapterI.Section04To05.HigmanSims.Construction.CubicCentralizer.OddElements
public import CFSG.Quasithin.ChapterI.Section04To05.HigmanSims.Construction.SeedConjugateTypes
public import Theory.GroupTheory.OddThreeCentralizerContainment
public import Theory.GroupTheory.CentralizerOddCore

/-!
# The full ambient cubic centralizer has precisely its original cubic odd core

The actual pure Klein four constructed inside C_G(t) normalizes its odd core.
Each of the three involution centralizers has its original TypeAt marking,
so every odd-order element in that fixed subgroup lies in the same <t>.
Three-centralizer generation bounds the whole odd core by <t>; centrality
of t supplies the reverse containment.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.HigmanSims
variable {G : Type*} [Group G] [Finite G] {z : G} {V : Subgroup G}

/-- The odd core of the FULL ambient cubic centralizer is the literal
original cyclic subgroup generated by the specified cubic. -/
theorem TypeAt.cubic_centralizer_oddCore (h : TypeAt z V) (t : G)
    (ht : t ∈ involutionCentralizer z) (ht3 : orderOf t = 3) :
    (pPrimeCore 2 (centralizer ({t} : Set G))).map
      (centralizer ({t} : Set G)).subtype = zpowers t := by
  obtain ⟨E,hE,hE4,hEC,_,hpure,_⟩ := h.exists_pure_cubic_four t ht ht3
  let := hE
  let C := centralizer ({t} : Set G)
  let O := (pPrimeCore 2 C).map C.subtype
  have hOC : O ≤ C := map_subtype_le _
  have hCO : C ≤ normalizer (O : Set G) := by
    simpa only [normalizer_eq_top,←MonoidHom.range_eq_map,range_subtype] using
      (pPrimeCore 2 C).le_normalizer_map C.subtype
  have hodd : Odd (Nat.card O) := by
    rw [show Nat.card O=Nat.card (pPrimeCore 2 C) from card_map_of_injective C.subtype_injective]
    exact Nat.coprime_two_left.mp pPrimeCore_coprime_card
  have hfix (x : E) (hx : x ≠ 1) : O ⊓ centralizer ({(x : G)} : Set G) ≤ zpowers t := by
    have hx1 : (x : G) ≠ 1 := fun he => hx (Subtype.ext he)
    obtain ⟨Vx,hxT⟩ := h.exists_typeAt_of_isConj x (hpure x x.property hx1)
    have htx : t ∈ involutionCentralizer (x : G) :=
      mem_centralizer_singleton_iff.mpr (mem_centralizer_singleton_iff.mp (hEC x.property)).symm
    rintro a ⟨haO,haX⟩
    have hao : Odd (orderOf a) := by
      have hd := orderOf_dvd_natCard (⟨a,haO⟩ : O)
      rw [←orderOf_coe] at hd
      exact hodd.of_dvd_nat hd
    exact hxT.cubic_point_centralizer_odd_mem t htx ht3 a haX
      (mem_centralizer_singleton_iff.mp (hOC haO)) hao
  have square (x : E) : x^2=1 :=
    Monoid.exponent_dvd_iff_forall_pow_eq_one.mp (IsElementaryAbelian.exponent_dvd_p 2 E) x
  let : Nontrivial E := Finite.one_lt_card_iff_nontrivial.mp (by rw [hE4]; decide)
  obtain ⟨a,ha⟩ := exists_ne (1 : E)
  obtain ⟨b,hb,hba⟩ := ENat.exists_ne_ne_of_three_le (α:=E)
    (by rw [ENat.card_eq_coe_natCard,hE4]; norm_num) 1 a
  have hab : a*b≠1 := by
    intro he
    apply hba
    exact (eq_inv_of_mul_eq_one_right he).trans
      (inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using square a))
  let f : E →* normalizer (O : Set G) := inclusion (hEC.trans hCO)
  apply le_antisymm
  · apply le_of_three_odd_centralizers O (zpowers t) hodd (f a) (f b)
      (by rw [←map_pow,square,map_one]) (by rw [←map_pow,square,map_one])
      ((show Commute a b from (IsMulCommutative.is_comm (M:=E)).comm a b).map f)
    intro x hx
    simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl
    · exact hfix a ha
    · exact hfix b hb
    · exact hfix (a*b) hab
  · exact zpowers_le.mpr (mem_pPrimeCore_centralizer 2 t (by rw [ht3]; decide))

end CFSG.Quasithin.HigmanSims
