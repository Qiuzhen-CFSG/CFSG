module

public import CFSG.Quasithin.ChapterF.Section01.GreenBook.LieModels.LinearThree
public import Theory.SpecificGroups.PSL3Four.FieldExtension.Basic
public import Theory.GroupTheory.Amalgam.GeneratedCompletion

/-!
# The missing small-completion input and its marked subgroup application

The L₃(4) step requires the finite specialization of F.4.26 for the actual
projective flag amalgam over the field with four elements. Its input is a
faithful completion and two endpoint involutions outside the whole common
overlap, whose product has order three. Its conclusion identifies the
completion and both endpoint ranges with the actual matrix model.

The proposition below specifies this outstanding independent input; it is
not a proof of F.4.26. The adapter applies it to the subgroup generated by
two literally embedded endpoints and a compatible marking of their whole
intersection. Generation holds inside this join by construction. No
generation assertion about the larger ambient group is used.

The type-HS owner must still construct these endpoints, their marking and
the involutions from HS1–HS2. The independent Chapter F recognition producer
can work solely with the native flag amalgam and need not import this module.
Source: Aschbacher–Smith F.3.6, F.4.8 and F.4.26, especially printed p.288,
and the L₃(4) construction cited at I.4.8, printed p.418.
-/

@[expose] public section

open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.HigmanSims
open ChapterF.GreenBook.LieModels

/-- The unproved independent recognition input, with the actual endpoint ranges. -/
def LinearThreeFourSmallCompletionRecognition.{u} : Prop :=
  ∀ (X : Type u) [Group X] [Finite X]
    (c : RankTwoAmalgam.FaithfulCompletion (LinearThree.amalgam Matrix.PSL3Four.F) (G := X))
    (s t : X), s ∈ c.left.range → t ∈ c.right.range →
    s ∉ c.middle.range → t ∉ c.middle.range →
    orderOf s = 2 → orderOf t = 2 → orderOf (s * t) = 3 →
    ∃ e : X ≃* Matrix.PSL3Four.PSL,
      c.left.range.map e.toMonoidHom = Matrix.PSL3.LinearThree.pointParabolic Matrix.PSL3Four.F ∧
      c.right.range.map e.toMonoidHom = Matrix.PSL3.LinearThree.lineParabolic Matrix.PSL3Four.F

universe u

/-- Apply the missing recognition theorem to the actual generated subgroup, preserving both endpoints. -/
theorem linearThree_subgroup_of_marked_pair
    (recognize : LinearThreeFourSmallCompletionRecognition.{u})
    {G : Type u} [Group G] [Finite G] (P₁ P₂ : Subgroup G)
    (marking : RankTwoAmalgam.Iso
      (RankTwoAmalgam.ofSubgroups P₁ (P₁ ⊓ P₂) P₂ inf_le_left inf_le_right)
      (LinearThree.amalgam Matrix.PSL3Four.F))
    (s t : G) (hs : s ∈ P₁) (ht : t ∈ P₂)
    (hsout : s ∉ P₁ ⊓ P₂) (htout : t ∉ P₁ ⊓ P₂)
    (hs2 : orderOf s = 2) (ht2 : orderOf t = 2) (hst : orderOf (s*t) = 3) :
    ∃ e : (P₁ ⊔ P₂ : Subgroup G) ≃* Matrix.PSL3Four.PSL,
      (P₁.subgroupOf (P₁ ⊔ P₂)).map e.toMonoidHom =
        Matrix.PSL3.LinearThree.pointParabolic Matrix.PSL3Four.F ∧
      (P₂.subgroupOf (P₁ ⊔ P₂)).map e.toMonoidHom =
        Matrix.PSL3.LinearThree.lineParabolic Matrix.PSL3Four.F := by
  let d := RankTwoAmalgam.FaithfulCompletion.ofGeneratedSubgroups
    P₁ (P₁ ⊓ P₂) P₂ inf_le_left inf_le_right
  let c := d.comapIso marking.symm
  let s' : (P₁ ⊔ P₂ : Subgroup G) := ⟨s, (show P₁ ≤ P₁ ⊔ P₂ from le_sup_left) hs⟩
  let t' : (P₁ ⊔ P₂ : Subgroup G) := ⟨t, (show P₂ ≤ P₁ ⊔ P₂ from le_sup_right) ht⟩
  have hsl : s' ∈ c.left.range := by
    rw [RankTwoAmalgam.FaithfulCompletion.comapIso_left_range]
    refine ⟨⟨s, hs⟩, Subtype.ext ?_⟩
    exact RankTwoAmalgam.FaithfulCompletion.ofGeneratedSubgroups_left
      P₁ (P₁ ⊓ P₂) P₂ inf_le_left inf_le_right ⟨s, hs⟩
  have htr : t' ∈ c.right.range := by
    rw [RankTwoAmalgam.FaithfulCompletion.comapIso_right_range]
    refine ⟨⟨t, ht⟩, Subtype.ext ?_⟩
    exact RankTwoAmalgam.FaithfulCompletion.ofGeneratedSubgroups_right
      P₁ (P₁ ⊓ P₂) P₂ inf_le_left inf_le_right ⟨t, ht⟩
  have hso : s' ∉ c.middle.range := by
    rw [RankTwoAmalgam.FaithfulCompletion.comapIso_middle_range]
    rintro ⟨b, hb⟩
    have he : (b : G) = s :=
      (RankTwoAmalgam.FaithfulCompletion.ofGeneratedSubgroups_left
        P₁ (P₁ ⊓ P₂) P₂ inf_le_left inf_le_right ⟨b.val, b.property.1⟩).symm.trans
        (congrArg Subtype.val hb)
    exact hsout (he ▸ b.property)
  have hto : t' ∉ c.middle.range := by
    rw [RankTwoAmalgam.FaithfulCompletion.comapIso_middle_range]
    rintro ⟨b, hb⟩
    have he : (b : G) = t :=
      (RankTwoAmalgam.FaithfulCompletion.ofGeneratedSubgroups_left
        P₁ (P₁ ⊓ P₂) P₂ inf_le_left inf_le_right ⟨b.val, b.property.1⟩).symm.trans
        (congrArg Subtype.val hb)
    exact htout (he ▸ b.property)
  obtain ⟨e, he₁, he₂⟩ := recognize (P₁ ⊔ P₂ : Subgroup G) c s' t' hsl htr hso hto
    (by simpa only [← orderOf_coe] using hs2)
    (by simpa only [← orderOf_coe] using ht2)
    (by simpa only [← orderOf_coe, Subgroup.coe_mul] using hst)
  refine ⟨e, ?_, ?_⟩
  · simpa only [c, RankTwoAmalgam.FaithfulCompletion.comapIso_left_range,
      d, RankTwoAmalgam.FaithfulCompletion.ofGeneratedSubgroups_left_range] using he₁
  · simpa only [c, RankTwoAmalgam.FaithfulCompletion.comapIso_right_range,
      d, RankTwoAmalgam.FaithfulCompletion.ofGeneratedSubgroups_right_range] using he₂
end CFSG.Quasithin.HigmanSims
