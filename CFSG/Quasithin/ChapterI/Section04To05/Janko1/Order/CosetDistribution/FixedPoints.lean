module

public import CFSG.Quasithin.ChapterI.Section04To05.Janko1.Order.CountingData

/-!
# The mod-five fixed-point count in Bender's J₁ argument

Conjugation by the cyclic group generated by an element of order five
preserves the actual involution set. Its fixed points are exactly the
involutions commuting with that element. The p-group orbit congruence,
combined with `BenderPrimeData.commuting_five`, gives `|J| ≡ d (mod 5)`.
An element of order five exists because the distinguished centralizer has
order 120. No group order or coset distribution is assumed.

Source: Bender, *Finite groups with large subgroups* (1974), §4, p.227,
the fixed-point argument immediately preceding (4.6).
-/

open Subgroup MulAction
namespace CFSG.Quasithin.Janko1CentralizerData

private theorem involutions_mod_five_of_order_five {G : Type*} [Group G] [Finite G] (x : G) (hx : orderOf x = 5) :
    Nat.card {t : G // orderOf t = 2} ≡
      Nat.card {t : G // orderOf t = 2 ∧ Commute t x} [MOD 5] := by
  let J := {t : G // orderOf t = 2}
  let P := zpowers x
  let : MulAction P J := {
    smul a t := ⟨(MulAut.conj (a : G)) t, ((MulAut.conj (a : G)).orderOf_eq t).trans t.property⟩
    one_smul t := Subtype.ext (by change (1 : G) * (t : G) * 1⁻¹ = (t : G); simp)
    mul_smul a b t := Subtype.ext (by
      change ((a : G) * (b : G)) * (t : G) * ((a : G) * (b : G))⁻¹ =
        (a : G) * ((b : G) * (t : G) * (b : G)⁻¹) * (a : G)⁻¹
      group) }
  have hf (t : J) : t ∈ fixedPoints P J ↔ Commute (t : G) x := by
    constructor
    · intro ht
      have he := congrArg Subtype.val (ht (⟨x, mem_zpowers x⟩ : P))
      change x * (t : G) * x⁻¹ = (t : G) at he
      exact (mul_inv_eq_iff_eq_mul.mp he).symm
    · intro ht a
      apply Subtype.ext
      change (a : G) * (t : G) * (a : G)⁻¹ = (t : G)
      apply mul_inv_eq_iff_eq_mul.mpr
      have hle : P ≤ centralizer ({(t : G)} : Set G) :=
        zpowers_le.mpr (mem_centralizer_singleton_iff.mpr ht.symm.eq)
      exact mem_centralizer_singleton_iff.mp (hle a.property)
  let e : fixedPoints P J ≃ {t : G // orderOf t = 2 ∧ Commute t x} :=
    { toFun := fun t => ⟨t.1.1, t.1.2, (hf t.1).mp t.2⟩
      invFun := fun t => ⟨⟨t.1, t.2.1⟩, (hf _).mpr t.2.2⟩
      left_inv := by intro t; rfl
      right_inv := by intro t; rfl }
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  have hp : IsPGroup 5 P := IsPGroup.of_card (n := 1) (by simpa [P, Nat.card_zpowers] using hx)
  simpa only [Nat.card_congr e] using hp.card_modEq_card_fixedPoints J


/-- The involution count is congruent to the odd-prime parameter modulo five. -/
public theorem bender_involutions_mod_five {G : Type*} [Group G] [Finite G]
    (h : Janko1CentralizerData G) {d : ℕ} (localData : BenderPrimeData G d) :
    Nat.card {t : G // orderOf t = 2} ≡ d [MOD 5] := by
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  have hd : 5 ∣ Nat.card G := (show 5 ∣ 120 by decide).trans
    (h.centralizer_card ▸ (Subgroup.centralizer ({h.z} : Set G)).card_subgroup_dvd_card)
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := G) 5 hd
  simpa only [localData.commuting_five x hx] using involutions_mod_five_of_order_five x hx

end CFSG.Quasithin.Janko1CentralizerData
