module

public import CFSG.Quasithin.ChapterI.Section04To05.Janko1.Order.OddPrimeCentralizers.Structure.Alternatives.ComplementAction
public import CFSG.Quasithin.ChapterI.Section04To05.Janko1.Order.OddPrimeCentralizers.Structure.FourCentralizers
public import Theory.AtlasPort.OtherSporadic.GroupTheory.SmallIndexSimple
public import Mathlib.GroupTheory.SpecificGroups.Alternating.Simple

/-!
# Local involutions acting on odd centralizer complements

The actual A₅ factor contains an involution inverting any element of order
three or five. Transport through the specified centralizer isomorphism gives
an inverter in C_G(z), outside the central subgroup generated by z.

An odd subgroup of an involution centralizer projects injectively into A₅.
A proper A₅ subgroup has index at least five by its faithful coset action;
Lagrange's theorem then restricts the odd subgroup order to one, three or five.
Involution fusion transports this restriction to every ambient involution.

These supply the second involution and the fixed-subgroup orders in the
four-group approach to Bender, *Finite groups with large subgroups* (1974),
proof of (4.1), printed p.225, citing Janko (1966), proof of Lemma 3.1.
They do not assume the shape or commutativity of the odd complement.
-/

open Subgroup
namespace CFSG.Quasithin.Janko1CentralizerData
private abbrev AF := alternatingGroup (Fin 5)
private abbrev M := AF × Multiplicative (ZMod 2)

private theorem model_inverter : ∀ r : AF, r ^ 3 = 1 ∨ r ^ 5 = 1 →
    ∃ t : AF, t ^ 2 = 1 ∧ t * r * t⁻¹ = r⁻¹ := by
  decide +kernel

variable {G : Type*} [Group G] [Finite G] (h : Janko1CentralizerData G)

/-- An involution in the distinguished centralizer inverts the marked prime element. -/
public theorem exists_local_inverter (p : ℕ) (hp : p = 3 ∨ p = 5)
    (x : G) (hxC : x ∈ centralizer ({h.z} : Set G)) (hx : orderOf x = p) :
    ∃ t : G, t ∈ centralizer ({h.z} : Set G) ∧ orderOf t = 2 ∧
      t ∉ zpowers h.z ∧ t * x * t⁻¹ = x⁻¹ := by
  let C := centralizer ({h.z} : Set G)
  let xC : C := ⟨x, hxC⟩
  let e := h.alternatingCentralizerEquiv
  have hpow : (e xC) ^ p = 1 := by
    rw [← map_pow, show xC ^ p = 1 from Subtype.ext (hx ▸ pow_orderOf_eq_one x), map_one]
  have hsnd : (e xC).2 = 1 := by
    have ht := congrArg Prod.snd hpow
    rcases hp with rfl | rfl
    · exact (by decide : ∀ u : Multiplicative (ZMod 2), u ^ 3 = 1 → u = 1) _ ht
    · exact (by decide : ∀ u : Multiplicative (ZMod 2), u ^ 5 = 1 → u = 1) _ ht
  have hfst : (e xC).1 ^ 3 = 1 ∨ (e xC).1 ^ 5 = 1 := by
    rcases hp with rfl | rfl
    · exact Or.inl (congrArg Prod.fst hpow)
    · exact Or.inr (congrArg Prod.fst hpow)
  obtain ⟨u, hu2, hu⟩ := model_inverter (e xC).1 hfst
  let tC : C := e.symm (u, 1)
  have ht2 : tC ^ 2 = 1 := by
    apply e.injective
    simp only [map_pow, map_one, tC, e.apply_symm_apply]
    exact Prod.ext hu2 (by simp)
  have hti : tC * xC * tC⁻¹ = xC⁻¹ := by
    apply e.injective
    simp only [map_mul, map_inv, tC, e.apply_symm_apply]
    exact Prod.ext hu (by simp [hsnd])
  have hinv : x ≠ x⁻¹ := by
    intro he
    have h2 : x ^ 2 = 1 := by
      rw [pow_two]
      calc x * x = x⁻¹ * x := congrArg (· * x) he
           _ = 1 := inv_mul_cancel x
    have hd := orderOf_dvd_of_pow_eq_one h2
    rw [hx] at hd
    rcases hp with rfl | rfl <;> norm_num at hd
  have hnot : (tC : G) ∉ zpowers h.z := by
    intro htZ
    have hcomm : Commute (tC : G) x := by
      obtain ⟨n, hn⟩ := mem_zpowers_iff.mp htZ
      rw [← hn]
      exact (show Commute h.z x from
        (mem_centralizer_singleton_iff.mp hxC).symm).zpow_left n
    apply hinv
    calc
      x = (tC : G) * x * (tC : G)⁻¹ := by rw [hcomm.eq, mul_assoc, mul_inv_cancel, mul_one]
      _ = x⁻¹ := congrArg Subtype.val hti
  refine ⟨tC, tC.property, ?_, hnot, congrArg Subtype.val hti⟩
  apply orderOf_eq_prime_iff.mpr
  exact ⟨congrArg Subtype.val ht2, fun he => hnot (he ▸ (zpowers h.z).one_mem)⟩


private theorem odd_model_embedding_card {H : Type*} [Group H] [Finite H]
    (hodd : Odd (Nat.card H)) (f : H →* M) (hf : Function.Injective f) :
    Nat.card H = 1 ∨ Nat.card H = 3 ∨ Nat.card H = 5 := by
  let f₂ : H →* Multiplicative (ZMod 2) := (MonoidHom.snd AF _).comp f
  have hsnd (y : H) : f₂ y = 1 := by
    have hdH := (orderOf_map_dvd f₂ y).trans (orderOf_dvd_natCard y)
    have hd2 : orderOf (f₂ y) ∣ 2 := by
      simpa using orderOf_dvd_natCard (f₂ y)
    exact orderOf_eq_one_iff.mp
      (Nat.eq_one_of_dvd_coprimes hodd.coprime_two_right hdH hd2)
  let f₁ : H →* AF := (MonoidHom.fst AF _).comp f
  have hinj : Function.Injective f₁ := by
    intro u v huv
    apply hf
    exact Prod.ext huv ((hsnd u).trans (hsnd v).symm)
  let K := f₁.range
  have hcard : Nat.card K = Nat.card H :=
    (Nat.card_congr (Equiv.ofInjective f₁ hinj)).symm
  have hAF : Nat.card AF = 60 := by
    rw [nat_card_alternatingGroup]
    norm_num [Nat.factorial]
  have hd : Nat.card H ∣ 60 := by
    rw [← hcard, ← hAF]
    exact K.card_subgroup_dvd_card
  have hproper : K ≠ ⊤ := by
    intro he
    have hc : Nat.card H = 60 := by rw [← hcard, he, Nat.card_congr topEquiv.toEquiv, hAF]
    rw [hc] at hodd
    obtain ⟨k, hk⟩ := hodd
    omega
  have hidx : 5 ≤ K.index := by
    by_contra hn
    apply hproper
    apply Atlas.GroupTheory.subgroup_eq_top_of_index_factorial_lt
    have hb := Nat.factorial_le (show K.index ≤ 4 by omega)
    rw [hAF]
    norm_num [Nat.factorial] at hb ⊢
    omega
  have hm := K.card_mul_index
  rw [hcard, hAF] at hm
  have hb : Nat.card H ≤ 12 := by nlinarith
  have arithmetic : ∀ n : ℕ, n ≤ 12 → n ∣ 60 → Odd n → n = 1 ∨ n = 3 ∨ n = 5 := by
    intro n hn hd ho
    obtain ⟨k, hk⟩ := ho
    interval_cases n <;> norm_num at hd <;> omega
  exact arithmetic _ hb hd hodd

include h in
/-- Every odd subgroup centralizing an involution has order one, three or five. -/
public theorem odd_subgroup_centralizing_involution_card [IsSimpleGroup G]
    (B : Subgroup G) (hB : Odd (Nat.card B)) (t : G) (ht : orderOf t = 2)
    (hBt : B ≤ centralizer ({t} : Set G)) :
    Nat.card B = 1 ∨ Nat.card B = 3 ∨ Nat.card B = 5 := by
  obtain ⟨g, hg⟩ := h.involutions_conjugate t ht
  let e := MulAut.conj g
  have he : e t = h.z := hg
  let f : B →* centralizer ({h.z} : Set G) := {
    toFun := fun y => ⟨e y, by
      rw [mem_centralizer_singleton_iff, ← he, ← map_mul, ← map_mul]
      exact congrArg e (mem_centralizer_singleton_iff.mp (hBt y.property))⟩
    map_one' := Subtype.ext e.map_one
    map_mul' := fun u v => Subtype.ext (e.map_mul u v) }
  have hf : Function.Injective f := by
    intro u v huv
    exact Subtype.ext (e.injective (congrArg Subtype.val huv))
  exact odd_model_embedding_card hB (h.alternatingCentralizerEquiv.toMonoidHom.comp f)
    (h.alternatingCentralizerEquiv.injective.comp hf)

end CFSG.Quasithin.Janko1CentralizerData
