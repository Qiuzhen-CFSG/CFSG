module

public import CFSG.Quasithin.ChapterI.Section04To05.Janko1.Basic
public import Theory.SpecificGroups.SL2.CardFourEquiv
public import Theory.ElementaryAbelian.Basic
public import Mathlib.GroupTheory.Subgroup.Center

/-!
# Local consequences of a J₁ involution centralizer

The projective-line isomorphism `PSL₂(4) ≃ A₅` gives a centralizer of order
120. Its Sylow two-subgroups have order eight and exponent two. Transport
and Sylow conjugacy therefore make every ambient Sylow two-subgroup
elementary abelian of order eight. The center of the involution centralizer
is exactly the cyclic subgroup generated by the distinguished involution;
its characteristicity then makes the centralizer self-normalizing.

These are preliminary deductions from the hypotheses of Aschbacher–Smith,
I.4.9, printed p.418. They do not establish the global uniqueness theorem.
The remaining order and recognition arguments are described in Z. Janko,
*A new finite simple group with abelian Sylow 2-subgroups and its
characterization*, J. Algebra 3 (1966), 147–186, and H. Bender, *Finite
groups with large subgroups*, Illinois J. Math. 18 (1974), 223–228, §4.
-/

namespace CFSG.Quasithin

namespace Janko1CentralizerData
variable {G : Type*} [Group G] [Finite G] (h : Janko1CentralizerData G)

include h

/-- The projective-line action rewrites the source centralizer as `A₅ × C₂`. -/
public noncomputable def alternatingCentralizerEquiv :
    Subgroup.centralizer ({h.z} : Set G) ≃*
      (alternatingGroup (Fin 5) × Multiplicative (ZMod 2)) :=
  h.centralizer_equiv.some.trans (MulEquiv.prodCongr
    (Matrix.ProjectiveSpecialLinearGroup.equiv_alternatingGroup_of_card_four
      (by rw [GaloisField.card 2 2 (by decide)]; norm_num)).some
    (MulEquiv.refl _))

/-- The involution centralizer has order 120. -/
public theorem centralizer_card : Nat.card (Subgroup.centralizer ({h.z} : Set G)) = 120 := by
  rw [Nat.card_congr h.alternatingCentralizerEquiv.toEquiv, Nat.card_prod,
    nat_card_alternatingGroup]
  norm_num [Nat.factorial, Nat.card_eq_fintype_card]

/-- The ambient Sylow subgroup lies in the distinguished involution centralizer. -/
public theorem sylow_le_centralizer : (h.sylow : Subgroup G) ≤
    Subgroup.centralizer ({h.z} : Set G) := by
  intro x hx
  exact Subgroup.mem_centralizer_singleton_iff.mpr (h.central x hx).symm.eq

/-- The full two-part of the centralizer order is eight. -/
public theorem sylow_card : Nat.card h.sylow = 8 := by
  let S := h.sylow.subtype h.sylow_le_centralizer
  calc
    Nat.card h.sylow = Nat.card S :=
      (Nat.card_congr (Subgroup.subgroupOfEquivOfLe h.sylow_le_centralizer).toEquiv).symm
    _ = 2 ^ (Nat.card (Subgroup.centralizer ({h.z} : Set G))).factorization 2 :=
      S.card_eq_multiplicity
    _ = 8 := by rw [h.centralizer_card]; decide +kernel

omit h [Group G] [Finite G] in
private theorem alternating_five_square_of_eighth_power :
    ∀ x : alternatingGroup (Fin 5), x ^ 8 = 1 → x ^ 2 = 1 := by
  decide +kernel

/-- Every element of the distinguished Sylow subgroup squares to the identity. -/
public theorem sylow_square (x : h.sylow) : x ^ 2 = 1 := by
  let xC : Subgroup.centralizer ({h.z} : Set G) := ⟨x, h.sylow_le_centralizer x.property⟩
  have hx8 : xC ^ 8 = 1 := by
    apply Subtype.ext
    have hx : x ^ 8 = 1 := h.sylow_card ▸ pow_card_eq_one' (x := x)
    exact congrArg (fun a : h.sylow => (a : G)) hx
  have he8 := congrArg h.alternatingCentralizerEquiv hx8
  rw [map_pow, map_one] at he8
  have hfirst := congrArg Prod.fst he8
  change (h.alternatingCentralizerEquiv xC).1 ^ 8 = 1 at hfirst
  have hpair : (h.alternatingCentralizerEquiv xC) ^ 2 = 1 := by
    apply Prod.ext
    · exact alternating_five_square_of_eighth_power _ hfirst
    · exact (by decide : ∀ a : Multiplicative (ZMod 2), a ^ 2 = 1) _
  have hx2 : xC ^ 2 = 1 := h.alternatingCentralizerEquiv.injective
    (by simpa only [map_pow, map_one] using hpair)
  apply Subtype.ext
  exact congrArg (fun a : Subgroup.centralizer ({h.z} : Set G) => (a : G)) hx2

/-- The distinguished Sylow subgroup is elementary abelian. -/
public theorem sylow_elementaryAbelian : IsElementaryAbelian 2 h.sylow := by
  exact {
    toIsMulCommutative := ⟨⟨fun x y => (Commute.of_orderOf_dvd_two
      (fun a => orderOf_dvd_of_pow_eq_one (h.sylow_square a)) x y).eq⟩⟩
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr h.sylow_square }

/-- Sylow conjugacy gives order eight for every ambient Sylow two-subgroup. -/
public theorem any_sylow_card (S : Sylow 2 G) : Nat.card S = 8 :=
  (Nat.card_congr (Sylow.equiv S h.sylow).toEquiv).trans h.sylow_card

/-- Every ambient Sylow two-subgroup has exponent dividing two. -/
public theorem any_sylow_square (S : Sylow 2 G) (x : S) : x ^ 2 = 1 := by
  apply (Sylow.equiv S h.sylow).injective
  simpa only [map_pow, map_one] using h.sylow_square ((Sylow.equiv S h.sylow) x)

/-- Every ambient Sylow two-subgroup is elementary abelian. -/
public theorem any_sylow_elementaryAbelian (S : Sylow 2 G) : IsElementaryAbelian 2 S := by
  exact {
    toIsMulCommutative := ⟨⟨fun x y => (Commute.of_orderOf_dvd_two
      (fun a => orderOf_dvd_of_pow_eq_one (h.any_sylow_square S a)) x y).eq⟩⟩
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr
      (h.any_sylow_square S) }

/-- The involution centralizer has odd index because it contains a Sylow two-subgroup. -/
public theorem centralizer_index_odd : Odd (Subgroup.centralizer ({h.z} : Set G)).index := by
  apply Nat.not_even_iff_odd.mp
  intro heven
  exact h.sylow.not_dvd_index ((even_iff_two_dvd.mp heven).trans
    (Subgroup.index_dvd_of_le h.sylow_le_centralizer))

/-- The only central factor of `A₅ × C₂` has order two. -/
public theorem centralizer_center_card :
    Nat.card (Subgroup.center (Subgroup.centralizer ({h.z} : Set G))) = 2 := by
  rw [Nat.card_congr (Subgroup.centerCongr h.alternatingCentralizerEquiv).toEquiv,
    Subgroup.center_prod,
    Nat.card_congr (Subgroup.prodEquiv _ _).toEquiv, Nat.card_prod,
    alternatingGroup.center_eq_bot (by simp : 4 ≤ Nat.card (Fin 5)),
    Subgroup.card_bot, one_mul, Subgroup.center_eq_top]
  simp [Nat.card_eq_fintype_card]

/-- The distinguished involution is nonidentity. -/
public theorem z_ne_one : h.z ≠ 1 := by
  intro hz
  have ho := h.involution
  simp [hz] at ho

/-- The distinguished involution belongs to its centralizer. -/
public theorem z_mem_centralizer : h.z ∈ Subgroup.centralizer ({h.z} : Set G) :=
  Subgroup.mem_centralizer_singleton_iff.mpr rfl

/-- The distinguished involution is central in its centralizer. -/
public theorem z_mem_center_centralizer :
    (⟨h.z, h.z_mem_centralizer⟩ : Subgroup.centralizer ({h.z} : Set G)) ∈
      Subgroup.center (Subgroup.centralizer ({h.z} : Set G)) := by
  apply Subgroup.mem_center_iff.mpr
  intro x
  exact Subtype.ext (Subgroup.mem_centralizer_singleton_iff.mp x.property)

/-- The center of the centralizer, mapped into `G`, is precisely `⟨z⟩`. -/
public theorem center_image_eq_zpowers :
    (Subgroup.center (Subgroup.centralizer ({h.z} : Set G))).map
      (Subgroup.centralizer ({h.z} : Set G)).subtype = Subgroup.zpowers h.z := by
  apply (Subgroup.eq_of_le_of_card_ge ?_ ?_).symm
  · apply Subgroup.zpowers_le.mpr
    exact Subgroup.mem_map_of_mem _ h.z_mem_center_centralizer
  · rw [Subgroup.card_map_of_injective Subtype.val_injective,
      h.centralizer_center_card, Nat.card_zpowers, h.involution]

/-- Normalizing the centralizer fixes its unique nonidentity central element. -/
public theorem centralizer_self_normalizing :
    Subgroup.normalizer (Subgroup.centralizer ({h.z} : Set G) : Set G) =
      Subgroup.centralizer ({h.z} : Set G) := by
  classical
  apply le_antisymm ?_ (Subgroup.le_normalizer)
  intro g hg
  let C := Subgroup.centralizer ({h.z} : Set G)
  let zC : C := ⟨h.z, h.z_mem_centralizer⟩
  let a : MulAut C := C.normalizerMonoidHom ⟨g, hg⟩
  have hac : a zC ∈ Subgroup.center C := by
    exact (Subgroup.characteristic_iff_map_le.mp
      (inferInstance : (Subgroup.center C).Characteristic) a)
      (Subgroup.mem_map_of_mem a.toMonoidHom h.z_mem_center_centralizer)
  have hcyc : (a zC : G) ∈ Subgroup.zpowers h.z := by
    rw [← h.center_image_eq_zpowers]
    exact Subgroup.mem_map_of_mem C.subtype hac
  have hne : (a zC : G) ≠ 1 := by
    intro heq
    have : zC = 1 := a.injective ((Subtype.ext heq).trans a.map_one.symm)
    exact h.z_ne_one (congrArg Subtype.val this)
  rw [mem_zpowers_iff_mem_range_orderOf, h.involution] at hcyc
  obtain ⟨n, hn, heq⟩ := Finset.mem_image.mp hcyc
  have hnlt := Finset.mem_range.mp hn
  have hfix : (a zC : G) = h.z := by
    interval_cases n
    · exact (hne (by simpa using heq.symm)).elim
    · simpa using heq.symm
  apply Subgroup.mem_centralizer_singleton_iff.mpr
  exact mul_inv_eq_iff_eq_mul.mp hfix

/-- Every involution is 2-central, since all ambient Sylow two-subgroups are abelian. -/
public theorem involution_is_two_central (x : G) (hx : orderOf x = 2) :
    ∃ S : Sylow 2 G, x ∈ (S : Subgroup G) ∧
      ∀ y : G, y ∈ (S : Subgroup G) → Commute x y := by
  have hp : IsPGroup 2 (Subgroup.zpowers x) :=
    IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, hx, pow_one])
  obtain ⟨S, hS⟩ := hp.exists_le_sylow
  have hxS : x ∈ (S : Subgroup G) := hS (Subgroup.mem_zpowers x)
  refine ⟨S, hxS, ?_⟩
  intro y hy
  exact congrArg Subtype.val (Commute.of_orderOf_dvd_two
    (fun a => orderOf_dvd_of_pow_eq_one (h.any_sylow_square S a))
      (⟨x, hxS⟩ : S) ⟨y, hy⟩).eq

/-- In a simple ambient group this centralizer is proper. -/
public theorem centralizer_ne_top [IsSimpleGroup G] :
    Subgroup.centralizer ({h.z} : Set G) ≠ ⊤ := by
  intro htop
  have hG : Nat.card G = 120 := by
    simpa only [htop, Nat.card_congr Subgroup.topEquiv.toEquiv] using h.centralizer_card
  have hZ : Nat.card (Subgroup.center G) = 2 := by
    have hcard := h.centralizer_center_card
    rw [htop, Nat.card_congr (Subgroup.centerCongr Subgroup.topEquiv).toEquiv] at hcard
    exact hcard
  rcases (inferInstance : (Subgroup.center G).Normal).eq_bot_or_eq_top with hbot | htop
  · rw [hbot, Subgroup.card_bot] at hZ
    omega
  · rw [htop, Nat.card_congr Subgroup.topEquiv.toEquiv, hG] at hZ
    omega

/-- The centralizer equivalence automatically marks the distinguished involution. -/
public theorem alternatingCentralizerEquiv_z :
    h.alternatingCentralizerEquiv ⟨h.z, h.z_mem_centralizer⟩ =
      (1, Multiplicative.ofAdd (1 : ZMod 2)) := by
  let zC : Subgroup.centralizer ({h.z} : Set G) := ⟨h.z, h.z_mem_centralizer⟩
  let e := h.alternatingCentralizerEquiv
  have hcenter : e zC ∈ Subgroup.center
      (alternatingGroup (Fin 5) × Multiplicative (ZMod 2)) :=
    (Subgroup.centerCongr e ⟨zC, h.z_mem_center_centralizer⟩).property
  rw [Subgroup.center_prod] at hcenter
  have hfst : (e zC).1 = 1 := by
    have hf := hcenter.1
    rw [alternatingGroup.center_eq_bot (by simp : 4 ≤ Nat.card (Fin 5))] at hf
    exact hf
  have hsnd : (e zC).2 ≠ 1 := by
    intro heq
    have he : e zC = 1 := Prod.ext hfst heq
    exact h.z_ne_one (congrArg Subtype.val (e.injective (he.trans e.map_one.symm)))
  apply Prod.ext hfst
  exact (by decide : ∀ a : Multiplicative (ZMod 2), a ≠ 1 →
    a = Multiplicative.ofAdd (1 : ZMod 2)) _ hsnd

end Janko1CentralizerData
end CFSG.Quasithin
