module
public import CFSG.Quasithin.ChapterI.Section04To05.G2Recognition.AmbientNormal
public import BenderSuzuki.SE.InvolutionsInTwoSubgroups
public import Theory.GroupTheory.GeneralizedFitting.CentralCoverLift

/-!
# Generation by the marked G₂(3) local subgroups

The quaternion core is generated by its square-one elements and has a
proper center. The Bender–Suzuki theorem therefore excludes strongly
embedded subgroups: its involution-commutation corollary would make that
core commutative. The elementary eight supplies the required two-rank.

The original configuration restricts to any subgroup containing H and M,
with the factor normality, quotient and ambient centralizer transported
through the actual inclusions. More generally, a subgroup carrying another
such configuration has one internal involution class, and its involution
centralizers have the same order 576 as the ambient ones. A proper subgroup
of this kind would be strongly embedded. Consequently it is the whole group.
Applying this to ⟨H,M⟩ proves generation. Conjugating the second local group
retains generation, so the aligned pair of indices three and seven is a
faithful generating pair of actual subgroups of G.

This is a global generation step for Aschbacher–Smith I.4.5, printed p.417.
It does not identify the completion with the octonion model. The unresolved
three-local recognition, including the q=3 step referred by Fong §6 to
Janko, remains distinct from the two-strong-embedding exclusion here.
Sources: Bender–Suzuki Theorem SE; Fong–Wong, Nagoya Math. J.36 (1969),
§2F, pp.153–154; Fong, Nagoya Math. J.39 (1970), §6, p.74.
The Chapter 14 consumer is `Chapter14Generation`.
-/

@[expose] public section
open Subgroup Theory.GroupTheory
open BenderSuzuki.PFchapter1section1
namespace CFSG.Quasithin.ChapterI.Section04To05.G2Recognition
open Chapter14.Section04.DimensionFour
variable {G : Type*} [Group G] [Finite G] (c : G2ThreeConfiguration G)
attribute [local instance] G2ThreeConfiguration.H₁_normal G2ThreeConfiguration.H₂_normal
  G2ThreeConfiguration.V_normal V_elementary

include c in
/-- The full Bender–Suzuki theorem excludes strongly two-embedded subgroups. -/
theorem no_strongly_embedded (R : Subgroup G) : ¬ BenderSuzuki.IsStronglyEmbedded R := by
  intro hR
  obtain ⟨E,hE⟩ := Sylow.exists_subgroup_card_pow_prime (G := c.V) 2
    (n := 2) (by rw [V_card c]; decide)
  let f : c.V →* G := c.M.subtype.comp c.V.subtype
  have hf : Function.Injective f := c.M.subtype_injective.comp c.V.subtype_injective
  have hr : TwoRankAtLeastTwo G := by
    refine ⟨E.map f, ?_, ?_⟩
    · rw [card_map_of_injective hf,hE]
      rfl
    · rintro ⟨x,y,hy,rfl⟩
      apply Subtype.ext
      change f y ^ 2 = 1
      rw [← map_pow, Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
        (IsElementaryAbelian.exponent_dvd_p 2 c.V) y, map_one]
  let Q := quaternionCore c
  let d := quaternionCoreData c
  let j : Q →* G := c.H.subtype.comp Q.subtype
  have hj : Function.Injective j := c.H.subtype_injective.comp Q.subtype_injective
  have hQ : IsPGroup 2 Q := IsPGroup.of_card (n := 5) (quaternionCore_card c)
  have hs (a b : Q) (ha : a ^ 2 = 1) (hb : b ^ 2 = 1) : a*b=b*a := by
    apply hj
    simpa only [map_mul] using (hR.squares_commute_in_twoSubgroup hr
      ((⊤ : Subgroup Q).map j) ((hQ.to_subgroup ⊤).map j) (j a) (j b)
      (mem_map_of_mem _ (mem_top _)) (mem_map_of_mem _ (mem_top _))
      (by rw [← map_pow,ha,map_one]) (by rw [← map_pow,hb,map_one])).eq
  have hgen := quaternion_central_product_involutions_generate d.left d.right
    d.left_model d.right_model d.intersection_card d.commute
  rw [d.span] at hgen
  have hc : IsMulCommutative (closure {x : Q | x ∈ (⊤ : Subgroup Q) ∧ x^2=1}) :=
    isMulCommutative_closure (fun a ha b hb => hs a b ha.2 hb.2)
  rw [hgen] at hc
  have hZ : center Q = ⊤ := by
    apply top_unique
    intro x _
    rw [mem_center_iff]
    intro y
    exact congrArg (fun w : (⊤ : Subgroup Q) => (w : Q))
      (hc.is_comm.comm ⟨y,mem_top _⟩ ⟨x,mem_top _⟩)
  have hn := d.center_card
  rw [hZ,Nat.card_congr (topEquiv : (⊤ : Subgroup Q) ≃* Q).toEquiv,d.card] at hn
  omega

/-- Restrict both original local subgroups to a common overgroup. -/
noncomputable def restrictConfiguration (K : Subgroup G) (hHK : c.H ≤ K) (hMK : c.M ≤ K) :
    G2ThreeConfiguration K := by
  let H' := c.H.subgroupOf K
  let M' := c.M.subgroupOf K
  let eH : c.H ≃* H' := (subgroupOfEquivOfLe hHK).symm
  let eM : c.M ≃* M' := (subgroupOfEquivOfLe hMK).symm
  let A := c.H₁.map eH.toMonoidHom
  let B := c.H₂.map eH.toMonoidHom
  let W := c.V.map eM.toMonoidHom
  let : A.Normal := Subgroup.Normal.map c.H₁_normal eH.toMonoidHom eH.surjective
  let : B.Normal := Subgroup.Normal.map c.H₂_normal eH.toMonoidHom eH.surjective
  let : W.Normal := Subgroup.Normal.map c.V_normal eM.toMonoidHom eM.surjective
  refine {
    H := H', M := M', H₁ := A, H₂ := B
    H₁_normal := inferInstance, H₂_normal := inferInstance
    H₁_model := ⟨(eH.subgroupMap c.H₁).symm.trans c.H₁_model.some⟩
    H₂_model := ⟨(eH.subgroupMap c.H₂).symm.trans c.H₂_model.some⟩
    commute := ?_, index := ?_, intersection_model := ?_, centralizer := ?_
    V := W, V_normal := inferInstance, fitting := ?_
    V_model := ⟨(eM.subgroupMap c.V).symm.trans c.V_model.some⟩
    quotient_model := ⟨(QuotientGroup.congr c.V W eM (by simp [W])).symm.trans c.quotient_model.some⟩ }
  · rintro x ⟨a,ha,rfl⟩ y ⟨b,hb,rfl⟩
    simpa using congrArg eH (c.commute a ha b hb)
  · change (c.H₁.map eH.toMonoidHom ⊔ c.H₂.map eH.toMonoidHom).index = 2
    rw [← Subgroup.map_sup, MulEquiv.toMonoidHom_eq_coe,index_map_equiv,c.index]
  · have hi : A ⊓ B = (c.H₁ ⊓ c.H₂).map eH.toMonoidHom :=
      (map_inf _ _ _ eH.injective).symm
    exact ⟨(MulEquiv.subgroupCongr hi).trans
      ((eH.subgroupMap (c.H₁ ⊓ c.H₂)).symm.trans c.intersection_model.some)⟩
  · have hi : A ⊓ B = (c.H₁ ⊓ c.H₂).map eH.toMonoidHom :=
      (map_inf _ _ _ eH.injective).symm
    rw [hi]
    ext x
    change (x : G) ∈ c.H ↔ _
    conv_lhs => rw [c.centralizer]
    constructor
    · intro hx y hy
      obtain ⟨a,ha,rfl⟩ := hy
      obtain ⟨b,hb,rfl⟩ := ha
      apply Subtype.ext
      exact hx (b : G) (mem_map_of_mem c.H.subtype hb)
    · intro hx y hy
      obtain ⟨a,ha,rfl⟩ := hy
      have hh := hx ((eH a : H') : K)
        (mem_map_of_mem H'.subtype (mem_map_of_mem eH.toMonoidHom ha))
      exact congrArg (fun w : K => (w : G)) hh
  · change c.V.map eM.toMonoidHom = generalizedFitting M'
    rw [c.fitting]
    apply le_antisymm (map_generalizedFitting_le_of_surjective eM.toMonoidHom eM.surjective)
    have hh := map_generalizedFitting_le_of_surjective eM.symm.toMonoidHom eM.symm.surjective
    have hm := map_mono (f := eM.toMonoidHom) hh
    simpa [map_map] using hm

include c in
/-- No proper subgroup can carry the same local configuration. -/
theorem subgroup_eq_top_of_configuration (K : Subgroup G) (d : G2ThreeConfiguration K) :
    K = ⊤ := by
  by_contra hK
  apply no_strongly_embedded c K
  have hcentral (x : K) (hx : orderOf x = 2) :
      centralizer ({(x : G)} : Set G) ≤ K := by
    have hle : (centralizer ({x} : Set K)).map K.subtype ≤
        centralizer ({(x : G)} : Set G) := by
      rintro y ⟨a,ha,rfl⟩
      apply mem_centralizer_singleton_iff.mpr
      exact congrArg Subtype.val (mem_centralizer_singleton_iff.mp ha)
    have he := eq_of_le_of_card_ge hle (by
      rw [card_map_of_injective K.subtype_injective,
        involution_centralizer_card d x hx,
        involution_centralizer_card c x ((orderOf_coe x).trans hx)])
    rw [← he]
    exact map_subtype_le _
  obtain ⟨z,hz,_⟩ := exists_involution_centralizer d
  refine ⟨hK, ⟨z,z.property,?_,?_⟩, ?_⟩
  · intro he
    have hh := (orderOf_coe z).trans hz
    simp [he] at hh
  · exact congrArg Subtype.val (hz ▸ pow_orderOf_eq_one z)
  · intro g hg x hx hxc hxi
    change x ∈ K.map (MulAut.conj g⁻¹).toMonoidHom at hxc
    obtain ⟨y,hy,he⟩ := hxc
    have hx2 : orderOf x = 2 := orderOf_eq_prime hxi.2 hxi.1
    have hy2 : orderOf y = 2 := by
      have hh : (MulAut.conj g⁻¹) y = x := by simpa using he
      rw [← (MulAut.conj g⁻¹).orderOf_eq y, hh]
      exact hx2
    obtain ⟨k,hk⟩ := isConj_iff.mp (involutions_conjugate d ⟨y,hy⟩ ⟨x,hx⟩
      (by simpa using hy2) (by simpa using hx2))
    have hkG : (k:G)*y*(k:G)⁻¹=x := congrArg Subtype.val hk
    have hfix : (g*(k:G))*y*(g*(k:G))⁻¹=y := by
      calc
        _ = g*((k:G)*y*(k:G)⁻¹)*g⁻¹ := by group
        _ = g*x*g⁻¹ := by rw [hkG]
        _ = y := by rw [←he]; simp [mul_assoc]
    have hmem : g*(k:G) ∈ K := by
      apply hcentral ⟨y,hy⟩ (by simpa using hy2)
      rw [mem_centralizer_singleton_iff]
      simpa [mul_assoc] using congrArg (fun a:G => a*(g*(k:G))) hfix
    exact hg ((K.mul_mem_cancel_right k.property).mp hmem)

/-- The actual two local subgroups generate the ambient group. -/
theorem local_pair_generates : c.H ⊔ c.M = ⊤ :=
  subgroup_eq_top_of_configuration c (c.H ⊔ c.M)
    (restrictConfiguration c _ le_sup_left le_sup_right)

/-- Conjugate only the second marked local subgroup, retaining its actual inclusion. -/
noncomputable def conjugateConfiguration (g : G) : G2ThreeConfiguration G := by
  let M' := c.M.map (MulAut.conj g).toMonoidHom
  let e : c.M ≃* M' := c.M.equivMapOfInjective (MulAut.conj g).toMonoidHom
    (MulAut.conj g).injective
  let W := c.V.map e.toMonoidHom
  let : W.Normal := Subgroup.Normal.map c.V_normal e.toMonoidHom e.surjective
  refine { c with
    M := M', V := W, V_normal := inferInstance, fitting := ?_
    V_model := ⟨(e.subgroupMap c.V).symm.trans c.V_model.some⟩
    quotient_model := ⟨(QuotientGroup.congr c.V W e (by simp [W])).symm.trans
      c.quotient_model.some⟩ }
  change c.V.map e.toMonoidHom = generalizedFitting M'
  rw [c.fitting]
  apply le_antisymm (map_generalizedFitting_le_of_surjective e.toMonoidHom e.surjective)
  have hh := map_generalizedFitting_le_of_surjective e.symm.toMonoidHom e.symm.surjective
  have hm := map_mono (f := e.toMonoidHom) hh
  simpa [map_map] using hm

/-- H generates G with every conjugate of the marked second local subgroup. -/
theorem conjugate_local_pair_generates (g : G) :
    c.H ⊔ c.M.map (MulAut.conj g).toMonoidHom = ⊤ :=
  local_pair_generates (conjugateConfiguration c g)

/-- The aligned (3,7) local pair is a generating pair of actual subgroups. -/
theorem exists_generating_local_pair (T : Sylow 2 c.H) :
    ∃ g : G,
      (T : Subgroup c.H).map c.H.subtype ≤ c.M.map (MulAut.conj g).toMonoidHom ∧
      Nat.card (c.H ⊓ c.M.map (MulAut.conj g).toMonoidHom : Subgroup G) = 192 ∧
      (c.H ⊓ c.M.map (MulAut.conj g).toMonoidHom).relIndex c.H = 3 ∧
      (c.H ⊓ c.M.map (MulAut.conj g).toMonoidHom).relIndex
        (c.M.map (MulAut.conj g).toMonoidHom) = 7 ∧
      c.H ⊔ c.M.map (MulAut.conj g).toMonoidHom = ⊤ := by
  obtain ⟨g,hT,hcard,hH,hM⟩ := exists_local_pair c T
  exact ⟨g,hT,hcard,hH,hM,conjugate_local_pair_generates c g⟩


end CFSG.Quasithin.ChapterI.Section04To05.G2Recognition
