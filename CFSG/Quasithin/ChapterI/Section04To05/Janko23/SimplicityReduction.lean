module

public import CFSG.Quasithin.ChapterI.Section04To05.Janko23.LocalStructure
public import Theory.GroupTheory.ExtraspecialCentralizerSimplicity

/-!
# Reduction of Janko simplicity to local action and fusion

The extraspecial-centralizer criterion reduces simplicity to two concrete
local assertions: irreducibility of the centralizer action on `Q/⟨z⟩`,
and a conjugate of `z` in `H` outside `Q`. The latter forces the subgroup
generated by `zᴳ ∩ H` to differ from `Q`. The former is expressed using
the subgroups between the central involution line and `Q`.

These assertions still have to be proved from the hypotheses of I.4.7;
they are not part of `HTypeAt`, `J2Type`, or `J3Type`. The present module
discharges the generic simplicity argument once they are supplied.

Sources: Aschbacher–Smith, *The Classification of Quasithin Groups*, I.4.7,
printed p. 418; Aschbacher, *Sporadic Groups*, Exercise 2.4, as formalized
in `Theory.GroupTheory.ExtraspecialCentralizerSimplicity`.
-/

namespace CFSG.Quasithin.Janko23

open Subgroup Theory.GroupTheory.ExtraspecialCentralizerSimplicity

variable {G : Type*} [Group G]

/-- Irreducibility on `Q/⟨z⟩`, written at the ambient subgroup lattice. -/
@[expose] public def CoreActionIrreducible (z : G) : Prop :=
  ∀ R : Subgroup G, zpowers z ≤ R → R ≤ ambientCore z →
    involutionCentralizer z ≤ normalizer (R : Set G) →
    R = zpowers z ∨ R = ambientCore z

/-- Ambient fusion of the distinguished involution into `H \ Q`. -/
@[expose] public def HasFusionOutsideCore (z : G) : Prop :=
  ∃ t ∈ involutionCentralizer z, IsConj z t ∧ t ∉ ambientCore z

/-- An outside conjugate prevents the local weak closure from being `Q`. -/
public theorem HasFusionOutsideCore.weakClosure_ne {z : G}
    (hf : HasFusionOutsideCore z) :
    weakClosure z (involutionCentralizer z) ≠ ambientCore z := by
  obtain ⟨t, htH, ht, htQ⟩ := hf
  intro he
  exact htQ (he ▸ subset_closure ⟨htH, ht⟩)

variable [Finite G] {z : G}

/-- Conditional local-to-global simplicity, with both remaining local
obligations explicit. No simplicity assumption is used. -/
public theorem HTypeAt.isSimpleGroup_of_local_action_fusion (h : HTypeAt z)
    (hirr : CoreActionIrreducible z) (hf : HasFusionOutsideCore z) : IsSimpleGroup G := by
  let := h.ambientCore_isExtraspecial
  let := h.quotient_isSimpleGroup
  exact isSimpleGroup_of_generalizedFitting z h.involution (ambientCore z)
    (ambientCore_le z) (ambientCore_subgroupOf z) hirr
    h.exists_returning_conjugate hf.weakClosure_ne

end CFSG.Quasithin.Janko23
