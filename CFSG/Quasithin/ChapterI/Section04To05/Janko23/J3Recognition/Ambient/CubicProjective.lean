module
public import CFSG.Quasithin.ChapterI.Section04To05.Janko23.J3Recognition.Ambient.CubicActors
public import Theory.SpecificGroups.Janko3.SourceRecognition.AlternatingExtension
public import Theory.GroupTheory.NormalizingInvolutionCard
public import Theory.GroupTheory.PrimeOrderLift

/-!
# The actual cubic normalizer quotient is PGL₂(9)

The constructed involutory inverter complements the cubic centralizer.
Its image supplements the embedded A₆ in the quotient by the same cubic,
and the order-eight actor survives this odd kernel. The alternating
extension theorem proves faithful conjugation and excludes S₆ before
identifying the literal quotient with PGL₂ over the nine-element field.
The preimage theorem records the original inclusion and quotient maps.

This proves the normalizer-quotient part of Baumeister Lemma 2.4. The
subsequent cubic-fusion argument must still split the extension over the
cubic kernel; splitting over the index-two centralizer does not supply it.

Source: Baumeister, *A geometry for groups of J₃-type* (2007),
Lemma 2.4, p.495.
-/

public noncomputable section
open Subgroup
namespace CFSG.Quasithin.Janko23.J3Recognition.Ambient
open LocalSixteen
variable {G : Type*} [Group G] [Finite G] {D : Seed G}

omit [Finite G] in
private theorem inverter_not_centralizer (s r : G) (hs : orderOf s = 3)
    (hi : r*s*r⁻¹=s⁻¹) : r ∉ centralizer ({s} : Set G) := by
  intro hr
  have he : s=s⁻¹ := by
    rw [mem_centralizer_singleton_iff] at hr
    rw [hr,mul_inv_cancel_right] at hi
    exact hi
  have hh : s^2=1 := by
    rw [pow_two]
    nth_rw 1 [he]
    exact inv_mul_cancel _
  have hd := orderOf_dvd_of_pow_eq_one hh
  norm_num [hs] at hd

omit [Finite G] in
/-- The same original cubic kernel has order three in the full normalizer. -/
theorem cubicNormalizerKernel_card (s : G) (hs : orderOf s = 3) :
    Nat.card (cubicNormalizerKernel s) = 3 :=
  (Nat.card_congr (subgroupOfEquivOfLe (zpowers s).le_normalizer).toEquiv).trans
    ((Nat.card_zpowers s).trans hs)

omit [Finite G] in
/-- The inverse image of the embedded alternating centralizer quotient is the
literal centralizer, with the original inclusion and quotient maps. -/
theorem cubicQuotientInclusion_preimage (s : G)
    (r : normalizer (zpowers s : Set G)) :
    QuotientGroup.mk' (cubicNormalizerKernel s) r ∈ (cubicQuotientInclusion s).range ↔
      (r : G) ∈ centralizer ({s} : Set G) := by
  let N := normalizer (zpowers s : Set G)
  let q := QuotientGroup.mk' (cubicNormalizerKernel s)
  constructor
  · rintro ⟨c,hc⟩
    obtain ⟨c,rfl⟩ := QuotientGroup.mk'_surjective (cubicKernel s) c
    rw [cubicQuotientInclusion_mk] at hc
    let cN : N := ⟨c,cubic_centralizer_le_normalizer s c.property⟩
    have hh : r / cN ∈ cubicNormalizerKernel s :=
      QuotientGroup.eq_iff_div_mem.mp hc.symm
    have hC : ((r / cN : N) : G) ∈ centralizer ({s} : Set G) := by
      have hle : zpowers s ≤ centralizer ({s} : Set G) :=
        zpowers_le.mpr (mem_centralizer_singleton_iff.mpr rfl)
      exact hle hh
    have hm := (centralizer ({s} : Set G)).mul_mem hC c.property
    simpa only [coe_div,cN,div_mul_cancel] using hm
  · intro hr
    refine ⟨QuotientGroup.mk' (cubicKernel s) ⟨r,hr⟩,?_⟩
    rw [cubicQuotientInclusion_mk]

/-- The selected involution complements the actual cubic centralizer. This is
splitting over the centralizer, not yet splitting over the cubic kernel. -/
theorem cubic_normalizer_involution_complement (h : HTypeAt D.z) (hc : OneInvolutionClass G)
    (s : G) (hs : orderOf s = 3)
    (e : (centralizer ({s} : Set G) ⧸ cubicKernel s) ≃* alternatingGroup (Fin 6))
    (r : normalizer (zpowers s : Set G)) (hr : orderOf r = 2)
    (hi : (r:G)*s*(r:G)⁻¹=s⁻¹) :
    ((centralizer ({s} : Set G)).subgroupOf (normalizer (zpowers s : Set G))).IsComplement'
      (zpowers r) := by
  classical
  apply isComplement'_of_card_mul_and_disjoint
  · rw [Nat.card_congr (subgroupOfEquivOfLe (cubic_centralizer_le_normalizer s)).toEquiv,
      cubic_centralizer_card s hs e,Nat.card_zpowers,hr,cubic_normalizer_card h hc s hs e]
  · apply disjoint_def.mpr
    intro x hxC hxR
    rw [mem_zpowers_iff_mem_range_orderOf,hr] at hxR
    obtain ⟨n,hn,rfl⟩ := Finset.mem_image.mp hxR
    have hn2 : n<2 := Finset.mem_range.mp hn
    interval_cases n
    · exact pow_zero r
    · exact (inverter_not_centralizer s r hs hi (by simpa only [pow_one,mem_subgroupOf] using hxC)).elim

/-- The literal normalizer quotient is generated by its embedded A₆ and the
image of the selected inverting involution, and contains an element of order eight. -/
theorem cubic_normalizer_quotient_actors (P : ReturningPair D) (hc : OneInvolutionClass G)
    (s : G) (hs : orderOf s = 3)
    (e : (centralizer ({s} : Set G) ⧸ cubicKernel s) ≃* alternatingGroup (Fin 6)) :
    ∃ r : normalizer (zpowers s : Set G), orderOf r=2 ∧ (r:G)*s*(r:G)⁻¹=s⁻¹ ∧
      let q := QuotientGroup.mk' (cubicNormalizerKernel s)
      orderOf (q r)=2 ∧ (cubicQuotientInclusion s).range ⊔ zpowers (q r)=⊤ ∧
      ∃ x : normalizer (zpowers s : Set G) ⧸ cubicNormalizerKernel s, orderOf x=8 := by
  have hC := cubic_centralizer_card s hs e
  obtain ⟨t,ht⟩ := exists_prime_orderOf_dvd_card' (G := centralizer ({s} : Set G))
    2 (by rw [hC]; decide)
  have htG : orderOf (t:G)=2 := (orderOf_coe t).trans ht
  have hst : Commute s (t:G) := (mem_centralizer_singleton_iff.mp t.property).symm
  obtain ⟨r,hr,hri⟩ := cubic_involutory_inverter P hc s t hs htG hst
  obtain ⟨x,hx⟩ := cubic_normalizer_eight P hc s t hs htG hst
  let q := QuotientGroup.mk' (cubicNormalizerKernel s)
  have hp : IsPGroup 3 q.ker := by
    rw [QuotientGroup.ker_mk']
    exact IsPGroup.of_card (n := 1) (by simpa using cubicNormalizerKernel_card s hs)
  have hqr : orderOf (q r)=2 := by
    rw [q.orderOf_map_eq_of_coprime_of_isPGroup_ker hp r (by rw [hr]; decide),hr]
  have hqx : orderOf (q x)=8 := by
    rw [q.orderOf_map_eq_of_coprime_of_isPGroup_ker hp x (by rw [hx]; decide),hx]
  let L := (cubicQuotientInclusion s).range
  have hLi : L.index=2 := cubicQuotientInclusion_index D.localType hc s hs e
  let : L.Normal := normal_of_index_eq_two hLi
  have hrout : q r ∉ L := by
    rw [cubicQuotientInclusion_preimage]
    exact inverter_not_centralizer s r hs hri
  have hgen : L ⊔ zpowers (q r)=⊤ := by
    apply eq_top_of_card_eq
    rw [card_sup_zpowers_of_normalizing_involution L (q r)
      (hqr ▸ pow_orderOf_eq_one (q r)) hrout
      (by rw [L.normalizer_eq_top]; exact mem_top _)]
    exact hLi ▸ L.index_mul_card
  exact ⟨r,hr,hri,hqr,hgen,q x,hqx⟩

/-- Baumeister Lemma 2.4's actual PGL₂(9) quotient, for the same chosen cubic.
Splitting the extension by that cubic remains a separate source step. -/
theorem cubic_normalizer_quotient_pgl_nine (P : ReturningPair D) (hc : OneInvolutionClass G)
    (s : G) (hs : orderOf s = 3)
    (e : (centralizer ({s} : Set G) ⧸ cubicKernel s) ≃* alternatingGroup (Fin 6)) :
    Nonempty ((normalizer (zpowers s : Set G) ⧸ cubicNormalizerKernel s) ≃*
      GorensteinWalter.PGL2 Atlas.Comparisons.Exceptional.Nine.F) := by
  obtain ⟨r,hr,hri,hqr,hgen,x,hx⟩ := cubic_normalizer_quotient_actors P hc s hs e
  let L := (cubicQuotientInclusion s).range
  let : L.Normal := normal_of_index_eq_two (cubicQuotientInclusion_index D.localType hc s hs e)
  let eL : L ≃* alternatingGroup (Fin 6) :=
    (MonoidHom.ofInjective (cubicQuotientInclusion_injective s)).symm.trans e
  exact Sporadic.Janko3.SourceRecognition.pgl_nine_of_alternating_involution_eight
    L eL (QuotientGroup.mk' (cubicNormalizerKernel s) r) hqr hgen x hx
end CFSG.Quasithin.Janko23.J3Recognition.Ambient

