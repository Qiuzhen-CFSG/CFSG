module
public import Theory.SpecificGroups.Janko3.SourceRecognition.BaumeisterParabolics
public import CFSG.Quasithin.ChapterI.Section04To05.Janko23.J3Recognition.Ambient.Seventeen

/-!
# The original point group and the parabolic intersections

The faithful field embedding supplies the literal L₁, L₁₂, cubic s and
involution f preceding Baumeister Lemma 2.5. We prove the first intersection
and identify the point group and its self-centralizing two-core. The other
two intersections are exactly the corresponding centralizers of f, since
L₃ is generated by those centralizers inside C_G(f).

The fixed-field calculation identifies the first centralizer with A₄ × C₂.
Once L₂ is identified with S₃ × D₁₀, the chosen commuting cubic identifies
its involution centralizer with S₃ × C₂. Thus both remaining literal
intersections are proved, the second conditional only on Lemma 2.5.
`original_marking_of_pair_triangle` retains exactly the still-unproved
L₂ and L₃ model maps; their construction remains the source obligation.

Source: Baumeister, *A geometry for groups of J₃-type* (2007), p.496.
-/

@[expose] public noncomputable section
open Subgroup
namespace CFSG.Quasithin.Janko23.J3Recognition.Ambient.BaumeisterParabolics
open Sporadic.Janko3.SourceRecognition
open Sporadic.Janko3.SourceRecognition.SingerField hiding normalizer
open CFSG.Quasithin.Janko23.J3Recognition.Ambient.Seventeen
open Sporadic.Janko3.SourceRecognition.Seventeen
open Sporadic.Janko3.SourceRecognition.BaumeisterParabolics
variable {G : Type*} [Group G]

/-- The literal third parabolic lies in the centralizer of the selected involution. -/
theorem third_le_centralizer (L1 L12 : Subgroup G) (f : G) :
    third L1 L12 f ≤ centralizer ({f} : Set G) :=
  sup_le inf_le_right inf_le_right

/-- The first/third overlap is the actual centralizer in the first parabolic. -/
theorem intersection13 (L1 L12 : Subgroup G) (f : G) :
    L1 ⊓ third L1 L12 f = L1 ⊓ centralizer ({f} : Set G) :=
  le_antisymm (inf_le_inf_left _ (third_le_centralizer L1 L12 f))
    (le_inf inf_le_left le_sup_left)

/-- The second/third overlap is the actual centralizer in the second parabolic. -/
theorem intersection23 (L1 L12 : Subgroup G) (f : G) :
    second L12 ⊓ third L1 L12 f = second L12 ⊓ centralizer ({f} : Set G) :=
  le_antisymm (inf_le_inf_left _ (third_le_centralizer L1 L12 f))
    (le_inf inf_le_left le_sup_right)

/-- The point-side marking, on the original faithful field-affine image.
The remaining model identifications for `second` and `third` are still required
before this can be extended to `OriginalMarking`. -/
theorem point_marking (j : SingerField.Model →* G) (hj : Function.Injective j) :
    ∃ (L12 : Subgroup G) (f s : G),
      L12 ≤ j.range ∧ f ∈ L12 ∧ orderOf f = 2 ∧ s ∈ L12 ∧ orderOf s = 3 ∧
      Commute s f ∧
      j.range ⊓ second L12 = L12 ∧
      Nonempty (j.range ≃* Sporadic.Janko3.SourceRecognition.Seventeen.Plane ⋊[pointAction]
        Complement) ∧
      centralizer (pCore 2 j.range : Set j.range) = pCore 2 j.range ∧
      Nonempty (L12 ≃* Complement) ∧
      second L12 ≤ normalizer (zpowers s : Set G) ∧
      j.range ⊓ third j.range L12 f = j.range ⊓ centralizer ({f} : Set G) ∧
      second L12 ⊓ third j.range L12 f = second L12 ⊓ centralizer ({f} : Set G) := by
  refine ⟨overlap j, j SingerField.fieldElement, j cubic, overlap_le j,
    image_involution_mem j, image_involution_order j hj, mem_map_of_mem j cubic_mem,
    (orderOf_injective j hj _).trans cubic_order, ?_,
    point_intersection_normalizer j hj,
    ⟨(MonoidHom.ofInjective hj).symm.trans pointEquiv⟩,
    image_core_centralizer j hj, ⟨overlapEquiv j hj⟩,
    overlap_normalizer_le_cubic j hj, intersection13 _ _ _, intersection23 _ _ _⟩
  exact (cubic_commutes_complement
    ⟨SingerField.fieldElement, (mem_pointComplement _).mpr rfl⟩).map j

/-! The following assembly keeps the two model identifications as literal
source premises.  The preceding point construction discharges every field
attached to `L₁` and `L₁₂`; the two maps below are the remaining Lemmas
2.5--2.6 inputs and are transported through the actual subgroup equalities. -/

noncomputable def original_marking_of_model_maps
    (j : SingerField.Model →* G) (hj : Function.Injective j)
    (hpair : second (overlap j) ≃* PairGroup)
    (htri : third j.range (overlap j) (j fieldElement) ≃* TriangleGroup)
    (h13 : (j.range ⊓ centralizer ({j fieldElement} : Set G) : Subgroup G) ≃*
      (alternatingGroup (Fin 4) × Multiplicative (ZMod 2)))
    (h23 : (second (overlap j) ⊓ centralizer ({j fieldElement} : Set G) :
      Subgroup G) ≃* (Equiv.Perm (Fin 3) × Multiplicative (ZMod 2))) :
    OriginalMarking j.range (overlap j) (j fieldElement) := by
  let ep : j.range ≃* Model := (MonoidHom.ofInjective hj).symm
  refine
    { overlap_le := overlap_le j
      involution_mem := image_involution_mem j
      involution_order := image_involution_order j hj
      intersection12 := point_intersection_normalizer j hj
      action := pointAction
      pointEquiv := ep.trans pointEquiv
      core_centralizer := image_core_centralizer j hj
      pairEquiv := hpair
      triangleEquiv := htri
      overlap12 := overlapEquiv j hj
      overlap13 := ?_
      overlap23 := ?_ }
  · exact (MulEquiv.subgroupCongr (intersection13 j.range (overlap j)
      (j fieldElement))).trans h13
  · exact (MulEquiv.subgroupCongr (intersection23 j.range (overlap j)
      (j fieldElement))).trans h23

/-- The pair-side centralizer is forced by the chosen commuting cubic.
Only the Lemma 2.5 pair identification remains an input. -/
noncomputable def pair_centralizer_equiv
    (j : SingerField.Model →* G) (hj : Function.Injective j)
    (hpair : second (overlap j) ≃* PairGroup) :
    (second (overlap j) ⊓ centralizer ({j fieldElement} : Set G) : Subgroup G) ≃*
      (Equiv.Perm (Fin 3) × Multiplicative (ZMod 2)) := by
  let L2 := second (overlap j)
  let f : L2 := ⟨j fieldElement, (overlap j).le_normalizer (image_involution_mem j)⟩
  let s : L2 := ⟨j cubic, (overlap j).le_normalizer (mem_map_of_mem j cubic_mem)⟩
  have hf : orderOf f = 2 :=
    (Subgroup.orderOf_coe f).symm.trans (image_involution_order j hj)
  have hs : orderOf s = 3 :=
    (Subgroup.orderOf_coe s).symm.trans ((orderOf_injective j hj _).trans cubic_order)
  have hc : Commute s f := by
    apply Subtype.ext
    exact ((cubic_commutes_complement
      ⟨fieldElement,(mem_pointComplement _).mpr rfl⟩).map j).eq
  let e0 : (L2 ⊓ centralizer ({j fieldElement} : Set G) : Subgroup G) ≃*
      centralizer ({f} : Set L2) := by
    have he : L2.subtype.range ⊓ centralizer ({L2.subtype f} : Set G) =
        L2 ⊓ centralizer ({j fieldElement} : Set G) := by
      rw [Subgroup.range_subtype]
      rfl
    exact (MulEquiv.subgroupCongr he.symm).trans
      (PointCentralizer.imageCentralizerEquiv L2.subtype L2.subtype_injective f)
  exact e0.trans ((Theory.GroupTheory.CentralizerSmallKernelTransport.centralizerEquiv
    hpair f).trans (PairCentralizer.pairCentralizerEquiv (hpair f) (hpair s)
      ((hpair.orderOf_eq f).trans hf) ((hpair.orderOf_eq s).trans hs)
      (hc.map hpair.toMonoidHom)))

/-- The first/third intersection on the actual source subgroups. -/
noncomputable def overlap13Equiv
    (j : SingerField.Model →* G) (hj : Function.Injective j) :
    (j.range ⊓ third j.range (overlap j) (j fieldElement) : Subgroup G) ≃*
      (alternatingGroup (Fin 4) × Multiplicative (ZMod 2)) :=
  (MulEquiv.subgroupCongr (intersection13 _ _ _)).trans
    (PointCentralizer.imagePointCentralizerEquiv j hj)

/-- The second/third intersection on the actual source subgroups, conditional
only on the still-required Lemma 2.5 identification. -/
noncomputable def overlap23Equiv
    (j : SingerField.Model →* G) (hj : Function.Injective j)
    (hpair : second (overlap j) ≃* PairGroup) :
    (second (overlap j) ⊓ third j.range (overlap j) (j fieldElement) : Subgroup G) ≃*
      (Equiv.Perm (Fin 3) × Multiplicative (ZMod 2)) :=
  (MulEquiv.subgroupCongr (intersection23 _ _ _)).trans
    (pair_centralizer_equiv j hj hpair)

/-- Assemble the original marking once Lemmas 2.5 and 2.6 identify the actual
second and third groups. Both centralizer and all overlap premises are discharged
here. The two retained model maps remain source obligations. -/
noncomputable def original_marking_of_pair_triangle
    (j : SingerField.Model →* G) (hj : Function.Injective j)
    (hpair : second (overlap j) ≃* PairGroup)
    (htri : third j.range (overlap j) (j fieldElement) ≃* TriangleGroup) :
    OriginalMarking j.range (overlap j) (j fieldElement) :=
  original_marking_of_model_maps j hj hpair htri
    (PointCentralizer.imagePointCentralizerEquiv j hj)
    (pair_centralizer_equiv j hj hpair)

end CFSG.Quasithin.Janko23.J3Recognition.Ambient.BaumeisterParabolics
