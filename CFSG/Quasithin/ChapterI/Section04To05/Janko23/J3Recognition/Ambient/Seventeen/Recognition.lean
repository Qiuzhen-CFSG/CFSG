module
public import CFSG.Quasithin.ChapterI.Section04To05.Janko23.J3Recognition.Ambient.Seventeen
public import CFSG.Quasithin.ChapterI.Section04To05.Janko23.J3Recognition.Ambient.BaumeisterParabolics
public import CFSG.Quasithin.ChapterI.Section04To05.Janko23.J3Recognition.SourceGenerators.LinearSubgroup

/-!
# Marked recognition on the original subgroup ⟨L₁,L₂⟩

The constructed model amalgam discharges the model premise in Baumeister's
completion comparison. The original involution is carried to fourth-power
Frobenius, and all three local subgroups are preserved. The inverse gives an
actual embedding of PSL₂(16):2 in G, then the existing linear-factor transport
supplies its normal order-4080 subgroup and the literal field conjugation.

The genuine preceding-source normalizer and intersection markings in
`OriginalMarking` remain inputs of the ambient-recognition owner. No plane-data
recognition, presentation comparison or J₃ conclusion is asserted here.

Sources: Baumeister, *A geometry for groups of J₃-type* (2007), pp.497–498,
Corollary 2.10; Aschbacher–Smith I.4.7(2), p.418.
-/

public noncomputable section
open Subgroup
open Sporadic.Janko3.SourceRecognition.Seventeen
open Theory.PSL2 Theory.PSL2.BinaryFourFieldExtension
namespace CFSG.Quasithin.Janko23.J3Recognition.Ambient.Seventeen
variable {G : Type*} [Group G]

/-- The literal original completion is the marked fourth-power extension,
including its actual third subgroup generated by involution centralizers. -/
theorem OriginalMarking.recognition {L1 L12 : Subgroup G} {f : G}
    (M : OriginalMarking L1 L12 f) :
    ∃ e : completion L1 L12 ≃* Model,
      (L1.subgroupOf (completion L1 L12)).map e.toMonoidHom = ModelAmalgam.point ∧
      ((second L12).subgroupOf (completion L1 L12)).map e.toMonoidHom = ModelAmalgam.pair ∧
      ((third L1 L12 f).subgroupOf (completion L1 L12)).map e.toMonoidHom = ModelAmalgam.Triangle ∧
      e M.involutionInCompletion = involution := by
  obtain ⟨e,h1,h2,hf⟩ := M.completion_equiv_preserving_involution ModelAmalgam.source
    involution ModelAmalgam.involution_mem_overlap Theory.PSL2.BinaryFourFieldExtension.involution_order
  refine ⟨e,h1,h2,?_,hf⟩
  have hle : ((third L1 L12 f).subgroupOf (completion L1 L12)).map e.toMonoidHom ≤
      ModelAmalgam.Triangle := by
    rintro _ ⟨x,hx,rfl⟩
    rw [mem_centralizer_singleton_iff, ← hf]
    change e x * e M.involutionInCompletion = e M.involutionInCompletion * e x
    rw [← map_mul, ← map_mul]
    apply congrArg e
    apply Subtype.ext
    have hc : third L1 L12 f ≤ centralizer ({f} : Set G) := sup_le inf_le_right inf_le_right
    exact mem_centralizer_singleton_iff.mp (hc hx)
  apply eq_of_le_of_card_ge hle
  rw [card_map_of_injective e.injective, ModelAmalgam.triangle_card]
  change 120 ≤ Nat.card M.localSource.H3
  rw [M.localSource.third_card]

/-- The actual extension embedding has the original completion as its image. -/
theorem OriginalMarking.exists_model_embedding {L1 L12 : Subgroup G} {f : G}
    (M : OriginalMarking L1 L12 f) :
    ∃ j : Model →* G, Function.Injective j ∧ j involution = f ∧ j.range = completion L1 L12 := by
  obtain ⟨e,_,_,_,hf⟩ := M.recognition
  let j : Model →* G := (completion L1 L12).subtype.comp e.symm.toMonoidHom
  refine ⟨j, (completion L1 L12).subtype_injective.comp e.symm.injective, ?_, ?_⟩
  · have he : e.symm involution = M.involutionInCompletion := by
      rw [← hf, e.symm_apply_apply]
    exact congrArg (fun x : completion L1 L12 => (x : G)) he
  · ext x
    constructor
    · rintro ⟨y,rfl⟩
      exact (e.symm y).property
    · intro hx
      refine ⟨e ⟨x,hx⟩, ?_⟩
      change ((e.symm (e ⟨x,hx⟩) : completion L1 L12) : G) = x
      rw [e.symm_apply_apply]

/-- The existing linear-factor transport now receives the proved embedding.
Its subgroup is normal in the literal L and has the prescribed field action. -/
theorem OriginalMarking.exists_linear_subgroup {L1 L12 : Subgroup G} {f : G}
    (M : OriginalMarking L1 L12 f) :
    ∃ (J : Subgroup G) (e : J ≃* BinaryGroup 4),
      J ≤ completion L1 L12 ∧ (J.subgroupOf (completion L1 L12)).Normal ∧
      Nat.card J = 4080 ∧ f ∉ J ∧ orderOf f = 2 ∧
      f ∈ normalizer (J : Set G) ∧ J ⊔ zpowers f = completion L1 L12 ∧
      ∀ x : BinaryGroup 4, f * (e.symm x : G) * f⁻¹ =
        (e.symm (fieldAut fieldInvolution x) : G) := by
  obtain ⟨j,hj,hf,hrange⟩ := M.exists_model_embedding
  let J := LinearSubgroup.linearSubgroup j
  let e := LinearSubgroup.linearEquiv j hj
  have hgen : J ⊔ zpowers f = completion L1 L12 := by
    rw [← hf, ← LinearSubgroup.range_eq_generated, hrange]
  have hn : f ∈ normalizer (J : Set G) := hf ▸ LinearSubgroup.involution_image_normalizes j
  have hJ : J ≤ completion L1 L12 := hgen ▸ le_sup_left
  have hnormal : (J.subgroupOf (completion L1 L12)).Normal := by
    apply (normal_subgroupOf_iff_le_normalizer hJ).mpr
    rw [← hgen]
    exact sup_le J.le_normalizer (zpowers_le.mpr hn)
  refine ⟨J,e,hJ,hnormal,LinearSubgroup.linearSubgroup_card j hj,?_,M.involution_order,hn,hgen,?_⟩
  · rw [← hf]
    exact LinearSubgroup.involution_image_not_mem j hj
  · intro x
    rw [← hf]
    exact LinearSubgroup.conjugation_equiv j hj x

/-- Apply the proved recognition to the original field-affine image and the
literal earlier-source parabolic maps. The point-side marking is constructed
by the existing Baumeister-parabolic theorem, rather than supplied afresh. -/
theorem model_embedding_of_parabolic_maps
    (j : Sporadic.Janko3.SourceRecognition.SingerField.Model →* G) (hj : Function.Injective j)
    (hpair : second (Sporadic.Janko3.SourceRecognition.BaumeisterParabolics.overlap j) ≃* PairGroup)
    (htri : third j.range (Sporadic.Janko3.SourceRecognition.BaumeisterParabolics.overlap j)
      (j Sporadic.Janko3.SourceRecognition.SingerField.fieldElement) ≃* TriangleGroup)
    (h13 : (j.range ⊓ centralizer ({j Sporadic.Janko3.SourceRecognition.SingerField.fieldElement} : Set G) :
      Subgroup G) ≃* (alternatingGroup (Fin 4) × Multiplicative (ZMod 2)))
    (h23 : (second (Sporadic.Janko3.SourceRecognition.BaumeisterParabolics.overlap j) ⊓
      centralizer ({j Sporadic.Janko3.SourceRecognition.SingerField.fieldElement} : Set G) :
      Subgroup G) ≃* (Equiv.Perm (Fin 3) × Multiplicative (ZMod 2))) :
    ∃ k : Model →* G, Function.Injective k ∧
      k involution = j Sporadic.Janko3.SourceRecognition.SingerField.fieldElement ∧
      k.range = completion j.range (Sporadic.Janko3.SourceRecognition.BaumeisterParabolics.overlap j) :=
  (CFSG.Quasithin.Janko23.J3Recognition.Ambient.BaumeisterParabolics.original_marking_of_model_maps
    j hj hpair htri h13 h23).exists_model_embedding

end CFSG.Quasithin.Janko23.J3Recognition.Ambient.Seventeen
