module

public import CFSG.Quasithin.ChapterI.Section04To05.Janko23.J2Recognition.SourceLocal.SourceOrbits.Completion
public import Theory.SpecificGroups.Alternating.FourPairFixer
public import Theory.SpecificGroups.Alternating.FourPairCore
public import Theory.SpecificGroups.Alternating.FiveInvolutionFusion
public import Theory.GroupTheory.LocalNormalizerUniqueness

/-!
# Identifying the fixer of a root-four pair

The root of a pair is the ambient image of O₂ of its actual join. If the
root normalizer splits as that A₄ join times A₅, compatibly with its literal
inclusion, the pointwise pair fixer is exactly the second factor. The
intrinsic layer marking retains its identity as the root-normalizer
component. Meeting the distinguished involution class once then suffices:
all involutions in the fixer are conjugate to that distinguished involution.

`RootPairCoordinates` is an intermediate construction contract for 47.5,
not an earlier-source hypothesis and not yet a construction from `Seed`.
The five-local pair producer must identify the join's root with an actual
47.1 root and construct these coordinates from the earlier-source models.
In particular the record assumes neither the pair fixer nor its order,
and only asks that the component meet the z-class, not that all its
involutions belong to that class.

Source: Aschbacher, *Sporadic Groups* (1994), 47.1 and the second paragraph
of the proof of 47.5, printed pp.259–260, 263.
-/

@[expose] public section

open Subgroup MulAction Theory.GroupTheory
open Theory.GroupTheory.GraphUniquenessSystem
namespace CFSG.Quasithin.Janko23.J2Recognition.SourceLocal.Representatives
variable {G : Type*} [Group G] [Finite G]

/-- The literal subgroup generated by the two endpoints. -/
abbrev pairJoin (D : Seed G) (Y : D.Vertex) : Subgroup G := D.X ⊔ Y.val
/-- The intrinsic two-core of the join, embedded into the original group. -/
abbrev pairRoot (D : Seed G) (Y : D.Vertex) : Subgroup G := (pairJoin D Y).pCoreIn 2
abbrev rootNormalizer (D : Seed G) (Y : D.Vertex) : Subgroup G :=
  normalizer (pairRoot D Y : Set G)
/-- The intrinsic layer of the root normalizer, with its ambient embedding. -/
def rootComponent (D : Seed G) (Y : D.Vertex) : Subgroup G :=
  (componentLayer (rootNormalizer D Y)).map (rootNormalizer D Y).subtype

theorem join_le_rootNormalizer (D : Seed G) (Y : D.Vertex) :
    pairJoin D Y ≤ rootNormalizer D Y :=
  (pairJoin D Y).le_normalizer.trans
    (normalizer_le_normalizer_characteristic_image _ (pCore 2 (pairJoin D Y)))

theorem fixer_le_rootNormalizer (D : Seed G) (Y : D.Vertex) :
    edgeFixer G D.base Y ≤ rootNormalizer D Y := by
  rw [edgeFixer, D.stabilizer_eq_normalizer, D.stabilizer_eq_normalizer]
  exact (normalizer_inf_normalizer_le_normalizer_sup D.X Y.val).trans
    (normalizer_le_normalizer_characteristic_image _ (pCore 2 (pairJoin D Y)))

/-- Compatible product coordinates to be constructed by the five-local branch. -/
structure RootPairCoordinates (D : Seed G) (Y : D.Vertex) where
  joinEquiv : pairJoin D Y ≃* alternatingGroup (Fin 4)
  normalizerEquiv : rootNormalizer D Y ≃* (pairJoin D Y × alternatingGroup (Fin 5))
  normalizer_on_join : ∀ j : pairJoin D Y,
    normalizerEquiv (inclusion (join_le_rootNormalizer D Y) j) = (j, 1)
  component_marking :
    ((⊥ : Subgroup (pairJoin D Y)).prod (⊤ : Subgroup (alternatingGroup (Fin 5)))).map
      ((rootNormalizer D Y).subtype.comp normalizerEquiv.symm.toMonoidHom) =
        rootComponent D Y
  component_meets_z_class : ∃ u ∈ rootComponent D Y, IsConj D.z u

namespace RootPairCoordinates
variable {D : Seed G} {Y : D.Vertex} (R : RootPairCoordinates D Y)
include R

noncomputable def secondFactor : Subgroup G :=
  ((⊥ : Subgroup (pairJoin D Y)).prod (⊤ : Subgroup (alternatingGroup (Fin 5)))).map
    ((rootNormalizer D Y).subtype.comp R.normalizerEquiv.symm.toMonoidHom)

theorem edge_adjacent : D.graph.Adj D.base Y :=
  (D.graph_adj_iff D.base Y).mpr ⟨R.joinEquiv⟩

/-- The root in these coordinates is an actual subgroup of order four. -/
theorem pairRoot_card : Nat.card (pairRoot D Y) = 4 := by
  change Nat.card ((pCore 2 (pairJoin D Y)).map (pairJoin D Y).subtype) = 4
  rw [card_map_of_injective (pairJoin D Y).subtype_injective,
    ← card_map_of_injective (K := pCore 2 (pairJoin D Y))
      (f := R.joinEquiv.toMonoidHom) R.joinEquiv.injective,
    pCore_map_iso, AlternatingFourPair.twoCore_eq_kleinFour,
    alternatingGroup.kleinFour_card_of_card_eq_four (by norm_num : Nat.card (Fin 4) = 4)]

theorem fixer_eq_secondFactor : edgeFixer G D.base Y = R.secondFactor := by
  have hFN := fixer_le_rootNormalizer D Y
  rw [edgeFixer, D.stabilizer_eq_normalizer, D.stabilizer_eq_normalizer] at hFN ⊢
  exact Theory.SpecificGroups.Alternating.FourPairFixer.pair_normalizer_second_factor
    D.X Y.val (rootNormalizer D Y) (join_le_rootNormalizer D Y) hFN
    R.joinEquiv R.normalizerEquiv R.normalizer_on_join D.card_X (D.vertex_card Y)

/-- The pair fixer is the actual embedded layer of its root normalizer. -/
theorem fixer_eq_component : edgeFixer G D.base Y = rootComponent D Y :=
  R.fixer_eq_secondFactor.trans R.component_marking

/-- The actual A₅ model of the ambient pair fixer. -/
noncomputable def fixerEquiv : edgeFixer G D.base Y ≃* alternatingGroup (Fin 5) := by
  let B := (⊥ : Subgroup (pairJoin D Y)).prod (⊤ : Subgroup (alternatingGroup (Fin 5)))
  let f := (rootNormalizer D Y).subtype.comp R.normalizerEquiv.symm.toMonoidHom
  have hf : Function.Injective f :=
    (rootNormalizer D Y).subtype_injective.comp R.normalizerEquiv.symm.injective
  exact (MulEquiv.subgroupCongr R.fixer_eq_secondFactor).trans
    ((B.equivMapOfInjective f hf).symm.trans
      ((Subgroup.prodEquiv _ _).trans ((MulEquiv.uniqueProd).trans Subgroup.topEquiv)))

/-- One z-class element in the component determines all fixer involutions. -/
theorem fixer_involutions_conjugate {u : G} (hu : u ∈ edgeFixer G D.base Y)
    (ho : orderOf u = 2) : IsConj D.z u := by
  obtain ⟨v, hv, hzv⟩ := R.component_meets_z_class
  have hvF : v ∈ edgeFixer G D.base Y := R.fixer_eq_component.symm ▸ hv
  have hov : orderOf v = 2 := by
    obtain ⟨g, rfl⟩ := isConj_iff.mp hzv
    exact ((MulAut.conj g).orderOf_eq D.z).trans D.localType.involution
  let a : edgeFixer G D.base Y := ⟨v, hvF⟩
  let b : edgeFixer G D.base Y := ⟨u, hu⟩
  have ha : orderOf (R.fixerEquiv a) = 2 :=
    (R.fixerEquiv.orderOf_eq a).trans ((Subgroup.orderOf_coe a).symm.trans hov)
  have hb : orderOf (R.fixerEquiv b) = 2 :=
    (R.fixerEquiv.orderOf_eq b).trans ((Subgroup.orderOf_coe b).symm.trans ho)
  have hc := R.fixerEquiv.symm.toMonoidHom.map_isConj
    (alternatingGroup.five_involutions_isConj _ _ ha hb)
  have hab : IsConj a b := by simpa only [MulEquiv.coe_toMonoidHom,
    MulEquiv.symm_apply_apply] using hc
  exact hzv.trans ((edgeFixer G D.base Y).subtype.map_isConj hab)

end RootPairCoordinates
end CFSG.Quasithin.Janko23.J2Recognition.SourceLocal.Representatives
