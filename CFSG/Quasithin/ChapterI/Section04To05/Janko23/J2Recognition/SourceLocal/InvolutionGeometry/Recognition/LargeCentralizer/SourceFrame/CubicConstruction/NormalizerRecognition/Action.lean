module

public import CFSG.Quasithin.ChapterI.Section04To05.Janko23.J2Recognition.SourceLocal.InvolutionGeometry.Recognition.LargeCentralizer.SourceFrame.CubicConstruction.Identification
public import CFSG.Quasithin.ChapterI.Section04To05.Janko23.J2Recognition.SourceLocal.InvolutionGeometry.Recognition.LargeCentralizer.SourceFrame.CubicConstruction.NormalizerRecognition.RootQuotient

/-!
# Separating the source action from its splitting

`RootAction` specifies coordinates on the actual R, its self-centralizing
property, and the image of the full normalizer's conjugation action. The image
is the subgroup of Aut(UT₃(F₄)) generated by inner automorphisms and the explicit
diagonal and graph-field actors. No isomorphism of normalizers is assumed.

`SplitAction` instead asks for actual lifts of those actors to N_G(R), with
their multiplication, conjugation action, trivial intersection and generation.
The construction in the parent module turns these lifts into the marked
normalizer isomorphism. Existence of either structure remains a separate
mathematical obligation; neither structure is a source theorem.

Source: Aschbacher, *Sporadic Groups* (1994), 8.15, 46.3 and 46.14,
printed pp.29–30, 251 and 257–258.
-/

@[expose] public section

open Subgroup Matrix.PSL3Four

namespace CFSG.Quasithin.Janko23.J2Recognition.SourceLocal.InvolutionGeometry.Recognition.LargeCentralizer.SourceFrame.NormalizerRecognition

variable {G : Type*} [Group G] [Finite G] {D : Seed G} (P : ReturningPair D)

/-- Conjugation by the full normalizer, expressed in the given root coordinates. -/
noncomputable def conjugation (e : P.R ≃* RootNormalizerModel.Root) :
    normalizer (P.R : Set G) →* MulAut RootNormalizerModel.Root :=
  (MulAut.congr e).toMonoidHom.comp P.R.normalizerMonoidHom

/-- The action-recognition obligation, before constructing any complement. -/
structure RootAction where
  coordinates : P.R ≃* RootNormalizerModel.Root
  selfCentralizing : centralizer (P.R : Set G) ≤ P.R
  image : (conjugation P coordinates).range =
    (MulAut.conj : RootNormalizerModel.Root →* MulAut RootNormalizerModel.Root).range ⊔
      RootNormalizerModel.actor

namespace RootAction

variable {P} (A : RootAction P)
include A

/-- Root coordinates suffice to identify the full center; normalizer splitting
is not used in this deduction. -/
theorem E_center : (center P.R).map P.R.subtype = P.E := by
  have hc : Nat.card (center P.R) = 4 :=
    (Nat.card_congr (centerCongr
      (A.coordinates.trans RootNormalizerModel.rootEquiv)).toEquiv).trans
      RootNormalizerModel.root_center_card
  apply (eq_of_le_of_card_ge P.E_le_center_image ?_).symm
  rw [card_map_of_injective P.R.subtype_injective, hc, P.E_card]

/-- The action's self-centralizing assertion identifies the full ambient
centralizer, with the original four-group marking. -/
theorem centralizer_eq_E : centralizer (P.R : Set G) = P.E := by
  rw [← A.E_center]
  apply le_antisymm
  · intro x hx
    exact mem_map.mpr ⟨⟨x, A.selfCentralizing hx⟩,
      mem_center_iff.mpr (fun r => Subtype.ext (hx r r.property)), rfl⟩
  · rintro x ⟨r, hr, rfl⟩ y hy
    exact congrArg (fun r : P.R => (r : G)) (mem_center_iff.mp hr ⟨y, hy⟩)

/-- The exact kernel needed when lifting the model actor is the marked E. -/
theorem conjugation_kernel :
    (conjugation P A.coordinates).ker =
      P.E.subgroupOf (normalizer (P.R : Set G)) := by
  rw [conjugation, MonoidHom.ker_comp_of_injective _ _ (MulAut.congr A.coordinates).injective,
    normalizerMonoidHom_ker, A.centralizer_eq_E]

end RootAction

/-- The literal inclusion of the root coordinates into the full normalizer. -/
noncomputable def rootEmbedding (e : P.R ≃* RootNormalizerModel.Root) :
    RootNormalizerModel.Root →* normalizer (P.R : Set G) :=
  (inclusion (le_normalizer : P.R ≤ normalizer (P.R : Set G))).comp e.symm.toMonoidHom

theorem rootEmbedding_injective (e : P.R ≃* RootNormalizerModel.Root) :
    Function.Injective (rootEmbedding P e) := by
  intro x y h
  apply e.symm.injective
  exact Subtype.ext (congrArg (fun n : normalizer (P.R : Set G) => (n : G)) h)

theorem rootEmbedding_range (e : P.R ≃* RootNormalizerModel.Root) :
    (rootEmbedding P e).range = P.R.subgroupOf (normalizer (P.R : Set G)) := by
  ext x
  constructor
  · rintro ⟨r, rfl⟩
    exact (e.symm r).property
  · intro hx
    refine ⟨e ⟨x, hx⟩, ?_⟩
    apply Subtype.ext
    exact congrArg (fun r : P.R => (r : G)) (e.symm_apply_apply ⟨x, hx⟩)

/-- Actual lifts with the prescribed action; this includes the source splitting
and generation assertions, and has no existence instance. -/
structure SplitAction (e : P.R ≃* RootNormalizerModel.Root) where
  lift : RootNormalizerModel.actor →* normalizer (P.R : Set G)
  action : ∀ a, conjugation P e (lift a) = a.val
  disjoint : ∀ a, (lift a : G) ∈ P.R → a = 1
  generation : P.R.subgroupOf (normalizer (P.R : Set G)) ⊔ lift.range = ⊤

namespace SplitAction

variable {P} {e : P.R ≃* RootNormalizerModel.Root} (S : SplitAction P e)

/-- The lift's conjugation equation uses the actual root inclusion. -/
theorem compatible (a : RootNormalizerModel.actor) :
    (rootEmbedding P e).comp a.val.toMonoidHom =
      (MulAut.conj (S.lift a)).toMonoidHom.comp (rootEmbedding P e) := by
  ext x
  have h := DFunLike.congr_fun (S.action a) x
  change e (P.R.normalizerMonoidHom (S.lift a) (e.symm x)) = a.val x at h
  have he := congrArg e.symm h
  rw [e.symm_apply_apply] at he
  exact (congrArg (fun r : P.R => (r : G)) he).symm

end SplitAction
end CFSG.Quasithin.Janko23.J2Recognition.SourceLocal.InvolutionGeometry.Recognition.LargeCentralizer.SourceFrame.NormalizerRecognition
