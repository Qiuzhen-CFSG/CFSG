module

public import CFSG.Quasithin.ChapterI.Section04To05.Janko23.J2Recognition.SourceLocal.PrimeNormalizers.FiveLocal.TwoCentral.MarkedLocal.Factors
public import Theory.SpecificGroups.Alternating.FiveLocalGeometry.PentagonNormalizer

/-!
# The exact normalizer in the marked A₅ component

The component equivalence from the original root-five product transports the
pentagon normalizer theorem to Y ≤ E(C_G(E)). Mapping the internal normalizer
back along the component inclusion gives the literal ambient intersection
E(C_G(E)) ∩ N_G(Y), generated by Y and an involution inverting Y.

The last theorem applies this to Y = P ∩ E(C_G(E)), whose order five is already
proved in `Factors`. It supplies the component-normalizer premise of the
marked-local assembly, independently of the extraspecial fixed-subgroup input.

Source: Aschbacher, *Sporadic Groups* (1994), 47.2, printed p.261,
the paragraph beginning with Y = P ∩ E(M).
-/

public section

open Subgroup
namespace CFSG.Quasithin.Janko23.J2Recognition.SourceLocal.PrimeNormalizers.FiveLocal.TwoCentral.MarkedLocal
variable {G : Type*} [Group G] [Finite G] {D : Seed G} {E : Subgroup G}

/-- The full normalizer of a five-line in the literal marked component is
 generated by that line and an involution inverting it. -/
theorem component_normalizer (W : RootFiveWitness D E) (Y : Subgroup G)
    (hY : Y ≤ fiveComponent E) (hcard : Nat.card Y = 5) :
    ∃ t ∈ fiveComponent E, orderOf t = 2 ∧
      (∀ y ∈ Y, t * y * t⁻¹ = y⁻¹) ∧
      fiveComponent E ⊓ normalizer (Y : Set G) = Y ⊔ zpowers t := by
  have hc : Nat.card (Y.subgroupOf (fiveComponent E)) = 5 := by
    rw [Nat.card_congr (subgroupOfEquivOfLe hY).toEquiv, hcard]
  obtain ⟨t, ht, hinv, hN⟩ :=
    alternatingGroup.FiveLocalGeometry.exists_five_normalizer_inverter
      (componentEquiv W) (Y.subgroupOf (fiveComponent E)) hc
  refine ⟨t, t.property, (orderOf_coe t).trans ht, ?_, ?_⟩
  · intro y hy
    exact congrArg Subtype.val (hinv ⟨y, hY hy⟩ hy)
  · have h := congrArg (Subgroup.map (fiveComponent E).subtype) hN
    rw [← subgroupOf_normalizer_eq hY, subgroupOf_map_subtype,
      Subgroup.map_sup, map_subgroupOf_eq_of_le hY, MonoidHom.map_zpowers] at h
    exact (inf_comm _ _).trans h

/-- The `hN` input of the marked-local assembly, for its exact intersection
`Y = P ∩ E(C_G(E))`. -/
theorem component_intersection_normalizer (hG : Nat.card G = 604800)
    (W : RootFiveWitness D E) (P : Sylow 5 G) (hEP : E ≤ (P : Subgroup G)) :
    ∃ t ∈ fiveComponent E, orderOf t = 2 ∧
      (∀ y ∈ (P : Subgroup G) ⊓ fiveComponent E, t * y * t⁻¹ = y⁻¹) ∧
      fiveComponent E ⊓ normalizer (((P : Subgroup G) ⊓ fiveComponent E : Subgroup G) : Set G) =
        ((P : Subgroup G) ⊓ fiveComponent E) ⊔ zpowers t :=
  component_normalizer W _ inf_le_right (intersection_card hG W P hEP)

end CFSG.Quasithin.Janko23.J2Recognition.SourceLocal.PrimeNormalizers.FiveLocal.TwoCentral.MarkedLocal
