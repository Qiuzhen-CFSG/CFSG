module

public import CFSG.Quasithin.ChapterI.Section04To05.Janko23.J2Recognition.SourceLocal.PrimeNormalizers.ThreeLocal.Basic
public import Theory.SpecificGroups.AlternatingSix.OuterInvolutionExtension.PGLComparison

/-!
# Repairing the source PGL₂(9) identification

Conjugation on the perfect centralizer descends faithfully modulo X. Its
image is generated by Inn(A₆) and the actual inverting involution. The
order-eight witness survives the odd kernel, excluding the natural S₆.
Exceptional-involution conjugacy then identifies the image with the checked
canonical PGL₂ over the nine-element field.

This proves an implication from `CentralizerCalculation`, whose construction
from 47.1–47.2 remains separate. In particular no semidihedral assertion is
used to justify the projective-linear identification.

Source: Aschbacher, *Sporadic Groups* (1994), 47.3(1), pp.261–262;
GLS III, Proposition 5.2.7(a), for the exceptional automorphism calculation.
-/

public section

open Subgroup Equiv
open AlternatingSix.ShadowLocal AlternatingSix.OuterInvolutionExtension
namespace CFSG.Quasithin.Janko23.J2Recognition.SourceLocal.PrimeNormalizers.ThreeLocal
variable {G : Type*} [Group G] [Finite G] {D : Seed G}

private theorem natural_no_eight (a : AutA6) (ha : a ∈ natural) : orderOf a ≠ 8 := by
  obtain ⟨s, rfl⟩ := ha
  change orderOf (permutationAction s) ≠ 8
  rw [orderOf_injective permutationAction permutationAction_injective]
  intro h
  have hd : orderOf s ∣ 4 := by
    rw [← s.lcm_cycleType, Multiset.lcm_dvd]
    intro n hn
    have hn8 : n ∣ 8 := h ▸ Equiv.Perm.dvd_of_mem_cycleType hn
    have hn6 : n ≤ 6 := (Multiset.le_sum_of_mem hn).trans s.sum_cycleType_le
    interval_cases n <;> norm_num at hn8 <;> norm_num
  norm_num [h] at hd

namespace CentralizerCalculation
variable (H : CentralizerCalculation D)

/-- The image of the literal centralizer is precisely Inn(A₆). -/
theorem quotientAction_map_CM : (CM D).map H.quotientAction = AlternatingSix.ShadowLocal.inner := by
  ext a
  constructor
  · rintro ⟨m, hm, rfl⟩
    refine ⟨H.coverMap ⟨m, hm⟩, ?_⟩
    exact (H.quotientAction_on_C ⟨m, hm⟩).symm
  · rintro ⟨x, rfl⟩
    obtain ⟨c, rfl⟩ := H.coverMap_surjective x
    exact ⟨⟨c, C_le_M D c.property⟩, c.property, H.quotientAction_on_C c⟩

/-- This is the whole normalizer image, using the already proved splitting. -/
theorem quotientAction_range : H.quotientAction.range =
    AlternatingSix.ShadowLocal.inner ⊔ zpowers (H.quotientAction H.inverter) := by
  rw [MonoidHom.range_eq_map, ← H.split.sup_eq_top, Subgroup.map_sup,
    H.quotientAction_map_CM, MonoidHom.map_zpowers]

/-- The exceptional actor is detected by order eight, without a claim about
the isomorphism type of a Sylow two-subgroup. -/
theorem quotientAction_inverter_not_natural : H.quotientAction H.inverter ∉ natural := by
  intro hn
  have hle : H.quotientAction.range ≤ natural := by
    rw [H.quotientAction_range]
    exact sup_le inner_le_natural (zpowers_le.mpr hn)
  obtain ⟨s, hs⟩ := H.eight
  have hp : IsPGroup 3 H.quotientAction.ker := by
    rw [H.quotientAction_ker]
    exact IsPGroup.of_card (n := 1) (by simpa using card_XM (D := D))
  have he : orderOf (H.quotientAction s) = 8 := by
    rw [H.quotientAction.orderOf_map_eq_of_coprime_of_isPGroup_ker hp s
      (by rw [hs]; decide), hs]
  exact natural_no_eight _ (hle ⟨s, rfl⟩) he

/-- The source normalizer modulo the actual relatively normal X is genuine
PGL₂(9). The map factors its literal conjugation action on C/X. -/
noncomputable def normalizerQuotientEquiv :
    (M D ⧸ XM D) ≃* GorensteinWalter.PGL2 Atlas.Comparisons.Exceptional.Nine.F := by
  have hsq : H.quotientAction H.inverter ^ 2 = 1 := by
    rw [← map_pow, ← H.inverter_order, pow_orderOf_eq_one, map_one]
  let e := (exceptional_extension_equiv_canonical (H.quotientAction H.inverter)
    hsq H.quotientAction_inverter_not_natural).some
  exact (QuotientGroup.quotientMulEquivOfEq H.quotientAction_ker.symm).trans
    ((QuotientGroup.quotientKerEquivRange H.quotientAction).trans
      ((MulEquiv.subgroupCongr H.quotientAction_range).trans
        (e.trans canonicalExtension_equiv_pgl2.some)))

end CentralizerCalculation
end CFSG.Quasithin.Janko23.J2Recognition.SourceLocal.PrimeNormalizers.ThreeLocal
