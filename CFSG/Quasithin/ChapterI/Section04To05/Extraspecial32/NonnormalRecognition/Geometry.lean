module

public import CFSG.Quasithin.ChapterI.Section04To05.Extraspecial32.NonnormalRecognition.Geometry.Assembly

/-!
# Conditional assembly of the thirteen-element fusion and A₃-system branch

The subgroup L is generated by the normalizers of the two literal core
intersections. `Geometry.Assembly` proves the count, generation, Sylow
conditions, vertex-core identifications, quotient transport and trivial
chamber core. The source configuration and the local parabolics remain
explicit inputs here; this is not yet the unconditional source theorem.

The construction of `A3Configuration` from nonsaturation (source 3.1) and
`A3ParabolicData` from that configuration (source 3.2) must both be supplied
before the original geometry task is complete. No A₈ isomorphism is assumed.

Source: M. Aschbacher, “A 2-local characterization of M12”, Illinois J. Math.
47 (2003), Lemmas 3.1–3.2, printed pp.36–37.
-/

namespace CFSG.Quasithin.Extraspecial32.NonnormalRecognition

variable {G : Type*} [Group G] [Finite G] {z g : G}

/-- The actual consumer of the two remaining source steps, with the local
intersection family discharged at both conjugators. -/
public theorem geometry_of_configuration (h : Hypotheses z)
    (local_intersections : ∀ y : G, y * z * y⁻¹ ∈ coreInG z → y * z * y⁻¹ ≠ z →
      IntersectionData z y)
    (hgQ : g * z * g⁻¹ ∈ coreInG z) (hg : g * z * g⁻¹ ≠ z)
    (c : A3Configuration z g) (p : A3ParabolicData z g c.y c.A) :
    Nat.card (CoreFusion z) = 13 ∧
      ∃ L : Subgroup G, Centralizer z ≤ L ∧ Nonempty (Quasithin.I5.DSystem .A3 L) := by
  have d := local_intersections g hgQ hg
  have dy := local_intersections c.y c.conjugate_mem c.conjugate_ne
  exact ⟨configuration_fusion_card h d c dy, geometryGroup z g c.y,
    geometry_centralizer_le d c.y, ⟨configuration_system h d c dy p⟩⟩

end CFSG.Quasithin.Extraspecial32.NonnormalRecognition
