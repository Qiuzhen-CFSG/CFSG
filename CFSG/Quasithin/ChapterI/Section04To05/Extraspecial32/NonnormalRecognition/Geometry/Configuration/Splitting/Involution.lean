module

public import CFSG.Quasithin.ChapterI.Section04To05.Extraspecial32.NonnormalRecognition.Geometry.Configuration.Endpoints
public import Theory.GroupTheory.QuaternionCentralProductInvolutions
public import Theory.GroupAction.ElementaryEightInvolution

/-!
# An outside involution from the elementary-eight normalizer

The quaternion central product is generated by involutions, so one lies
outside E. Its nontrivial action on E fixes a four-group. Choose a fixed
point off the distinguished involution line and fuse it to z inside N_G(E).
The resulting conjugate centralizes z. It cannot belong to Q: otherwise
its nontrivial commutator line would be both the original line and the
chosen distinct line.

This supplies the involution used by the local splitting argument without
assuming ambient fusion saturation or splitting a central extension of S3.
Source: M. Aschbacher, “A 2-local characterization of M12”, Illinois
J. Math. 47 (2003), Lemmas 2.2, 2.8 and 3.1, printed pp.33, 36–37.
-/

namespace CFSG.Quasithin.Extraspecial32.NonnormalRecognition.Configuration
open Subgroup
open scoped commutatorElement
variable {G : Type*} [Group G] [Finite G] {z g : G}

private theorem normalizer_fuses_point (h : Hypotheses z) (d : IntersectionData z g)
    {x : G} (hx : x ∈ coreIntersection z g) (hx1 : x ≠ 1) :
    ∃ m : normalizer (coreIntersection z g : Set G), (m : G) * z * (m : G)⁻¹ = x := by
  let E := coreIntersection z g
  let M := normalizer (E : Set G)
  let : MulDistribMulAction M G :=
    MulDistribMulAction.compHom G (MulAut.conj.comp M.subtype)
  let : MulAction M G := (inferInstance : MulDistribMulAction M G).toMulAction
  have hstab : MulAction.stabilizer M z = (Centralizer z).subgroupOf M := by
    ext m
    change (m : G) * z * (m : G)⁻¹ = z ↔ (m : G) ∈ Centralizer z
    rw [mem_centralizer_singleton_iff, mul_inv_eq_iff_eq_mul]
  have hcard : Nat.card (MulAction.orbit M z) = 7 := by
    have he := Nat.card_congr (MulAction.orbitProdStabilizerEquivGroup M z)
    rw [Nat.card_prod, hstab,
      Nat.card_congr (subgroupOfEquivOfLe (intersection_centralizer_le_normalizer d)).toEquiv,
      h.centralizer_card, intersection_normalizer_card d] at he
    omega
  have hsub : MulAction.orbit M z ⊆ (E : Set G) \ {1} := by
    rintro a ⟨m, rfl⟩
    constructor
    · exact ((m.property) z).mp (distinguished_mem_intersection d)
    · change ¬ (m : G) * z * (m : G)⁻¹ = 1
      intro he
      have hz : z = 1 := (MulAut.conj (m : G)).injective (he.trans (map_one _).symm)
      have ho := h.involution
      rw [hz, orderOf_one] at ho
      omega
  have hsame : MulAction.orbit M z = (E : Set G) \ {1} := by
    apply Set.eq_of_subset_of_ncard_le hsub
    change ((E : Set G) \ {1}).ncard ≤ Nat.card (MulAction.orbit M z)
    rw [Set.ncard_sdiff_singleton_of_mem E.one_mem, hcard]
    change Nat.card E - 1 ≤ 7
    rw [d.card]
  obtain ⟨m, hm⟩ := hsame.symm ▸ (show x ∈ (E : Set G) \ {1} from ⟨hx, hx1⟩)
  exact ⟨m, hm⟩

private theorem exists_core_involution_outside (h : Hypotheses z)
    (d : IntersectionData z g) :
    ∃ t : G, t ∈ coreInG z ∧ t ^ 2 = 1 ∧ t ∉ coreIntersection z g := by
  classical
  by_contra! hnone
  have hcontain : coreInG z ≤ coreIntersection z g := by
    obtain ⟨q⟩ := h.quaternionCentralProduct
    have hgen := quaternion_central_product_involutions_generate q.left q.right
      q.left_model q.right_model q.intersection_card q.commute
    rw [q.span] at hgen
    have hle : (⊤ : Subgroup (Core z)) ≤
        (coreIntersection z g).comap ((Centralizer z).subtype.comp (Core z).subtype) := by
      rw [← hgen]
      apply (closure_le _).mpr
      intro x hx
      exact hnone _ (mem_map_of_mem (Centralizer z).subtype x.property)
        (congrArg (fun a : Core z => ((a : Centralizer z) : G)) hx.2)
    rintro _ ⟨x, hx, rfl⟩
    exact hle (mem_top (⟨x, hx⟩ : Core z))
  have hc := card_le_of_le hcontain
  rw [h.coreInG_card, d.card] at hc
  omega

private theorem core_commutator_line (h : Hypotheses z)
    {x y : G} (hx : x ∈ coreInG z) (hy : y ∈ coreInG z) :
    ⁅x, y⁆ ∈ zpowers z := by
  let Q := coreInG z
  let _ := h.coreInG_extraspecial
  let _ := IsExtraspecial.quotient_elementary_abelian 2 Q
  have hc : ⁅(⟨x, hx⟩ : Q), ⟨y, hy⟩⁆ ∈ center Q := by
    apply (QuotientGroup.eq_one_iff _).mp
    change (QuotientGroup.mk' (center Q)) ⁅(⟨x, hx⟩ : Q), ⟨y, hy⟩⁆ = 1
    rw [map_commutatorElement]
    exact commutatorElement_eq_one_iff_mul_comm.mpr
      ((IsMulCommutative.is_comm (M := Q ⧸ center Q)).comm _ _)
  rw [← h.coreInG_center_image]
  exact mem_map_of_mem Q.subtype hc

private theorem line_cases (h : Hypotheses z) {v : G} (hv : v ∈ zpowers z) :
    v = 1 ∨ v = z := by
  classical
  rw [mem_zpowers_iff_mem_range_orderOf, h.involution] at hv
  obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hv
  have hnlt := Finset.mem_range.mp hn
  interval_cases n <;> simp

private theorem fixed_point_outside_line (h : Hypotheses z) (d : IntersectionData z g)
    (t : G) (htQ : t ∈ coreInG z) (ht : t ^ 2 = 1) (htE : t ∉ coreIntersection z g) :
    ∃ e : G, e ∈ coreIntersection z g ∧ e * t = t * e ∧ e ∉ zpowers z := by
  let E := coreIntersection z g
  let N := normalizer (E : Set G)
  let tN : N := ⟨t, intersection_centralizer_le_normalizer d (coreInG_le z htQ)⟩
  let A := zpowers tN
  let : MulDistribMulAction A E := MulDistribMulAction.compHom E
    (E.normalizerMonoidHom.comp A.subtype)
  let _ := d.elementary
  let tA : A := ⟨tN, mem_zpowers tN⟩
  have htne : tA ≠ 1 := by
    intro he
    have ht1 : t = 1 := congrArg (fun a : A => ((a : N) : G)) he
    exact htE (ht1 ▸ E.one_mem)
  have ht2 : tA ^ 2 = 1 := Subtype.ext (Subtype.ext ht)
  have hA : Nat.card A = 2 := by
    rw [Nat.card_zpowers, orderOf_eq_prime (Subtype.ext ht) ?_]
    exact fun he => htne (Subtype.ext he)
  have hmoved : ∃ e : E, tA • e ≠ e := by
    by_contra! he
    apply htE
    rw [← d.self_centralizing]
    intro e heE
    have hh := congrArg Subtype.val (he ⟨e, heE⟩)
    change t * e * t⁻¹ = e at hh
    exact (mul_inv_eq_iff_eq_mul.mp hh).symm
  let F := FixedPoints.subgroup A E
  have hF : Nat.card F = 4 :=
    fixed_subgroup_card_four_of_nontrivial_involution_on_eight tA ⟨htne, ht2⟩ hA d.card hmoved
  have hnot : ¬ F.map E.subtype ≤ zpowers z := by
    intro hle
    have hc := card_le_of_le hle
    rw [card_map_of_injective E.subtype_injective, hF, Nat.card_zpowers, h.involution] at hc
    omega
  obtain ⟨e, heF, hez⟩ := SetLike.not_le_iff_exists.mp hnot
  obtain ⟨v, hv, rfl⟩ := heF
  refine ⟨v, v.property, ?_, hez⟩
  have he := congrArg Subtype.val (hv tA)
  change t * (v : G) * t⁻¹ = v at he
  exact (mul_inv_eq_iff_eq_mul.mp he).symm

/-- A literal intersection normalizer supplies an involution in H outside Q. -/
public theorem exists_outside_involution (h : Hypotheses z) (d : IntersectionData z g) :
    ∃ a : G, a ∈ Centralizer z ∧ a ^ 2 = 1 ∧ a ∉ coreInG z := by
  classical
  obtain ⟨t, htQ, ht2, htE⟩ := exists_core_involution_outside h d
  obtain ⟨e, heE, het, hez⟩ := fixed_point_outside_line h d t htQ ht2 htE
  have he1 : e ≠ 1 := fun hh => hez (hh ▸ (zpowers z).one_mem)
  obtain ⟨m, hm⟩ := normalizer_fuses_point h d heE he1
  let α := MulAut.conj (m : G)
  let a := α.symm t
  have hαz : α z = e := hm
  have hαE : ∀ v ∈ coreIntersection z g, α.symm v ∈ coreIntersection z g := by
    intro v hv
    simpa [α] using
      ((m⁻¹).property v).mp hv
  have hz1 : z ≠ 1 := by intro he; simpa [he] using h.involution
  refine ⟨a, mem_centralizer_singleton_iff.mpr ?_, ?_, ?_⟩
  · apply α.injective
    simpa only [a, map_mul, MulEquiv.apply_symm_apply, hαz] using het.symm
  · change (α.symm t) ^ 2 = 1
    rw [← map_pow, ht2, map_one]
  · intro haQ
    have hncent : t ∉ centralizer (coreIntersection z g : Set G) := by
      rwa [d.self_centralizing]
    obtain ⟨v, hvE, hv⟩ : ∃ v ∈ coreIntersection z g, v * t ≠ t * v := by
      by_contra! hh
      exact hncent (fun v hv => hh v hv)
    have hc : ⁅t, v⁆ = z := by
      rcases line_cases h (core_commutator_line h htQ (coreIntersection_le z g hvE)) with hc | hc
      · exact (hv (commutatorElement_eq_one_iff_mul_comm.mp hc).symm).elim
      · exact hc
    have hca := core_commutator_line h haQ (coreIntersection_le z g (hαE v hvE))
    have heq : α ⁅a, α.symm v⁆ = z := by
      simpa only [map_commutatorElement, a, MulEquiv.apply_symm_apply] using hc
    rcases line_cases h hca with hca | hca
    · rw [hca, map_one] at heq
      exact hz1 heq.symm
    · rw [hca, hαz] at heq
      exact hez (heq ▸ mem_zpowers z)

end CFSG.Quasithin.Extraspecial32.NonnormalRecognition.Configuration
