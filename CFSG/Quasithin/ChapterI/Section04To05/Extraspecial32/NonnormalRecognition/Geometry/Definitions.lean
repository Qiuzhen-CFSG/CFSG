module

public import CFSG.Quasithin.ChapterI.Section04To05.Extraspecial32.NonnormalRecognition.Fusion
public import CFSG.Quasithin.ChapterI.Section04To05.DSystem
public import Mathlib.GroupTheory.Complement

/-!
# The actual subgroups in the nonnormal A₃ construction

The source first constructs the second intersection F and the elementary
sixteen A (Lemma 3.1), then identifies the local parabolics (Lemma 3.2).
These interfaces separate those two arguments. They assert neither recognition
nor the existence of a D-system. Their producers must prove the splitting,
fusion and local subgroup assertions from the original centralizer hypotheses.

All normalizers are ambient normalizers, and the geometry group is literally
`N_G(E) ⊔ N_G(F)`. Its vertex subgroups use the inclusion into G; the separate
containment of `N_G(A)` prevents truncating the middle normalizer silently.

Source: M. Aschbacher, “A 2-local characterization of M12”, Illinois J. Math.
47 (2003), Lemmas 3.1–3.2, printed pp.36–37.
-/

@[expose] public section

namespace CFSG.Quasithin.Extraspecial32.NonnormalRecognition

open Subgroup

variable {G : Type*} [Group G]

/-- The group generated by the two endpoint normalizers in source 3.2. -/
def geometryGroup (z g y : G) : Subgroup G :=
  normalizer (coreIntersection z g : Set G) ⊔
    normalizer (coreIntersection z y : Set G)

/-- The actual three normalizers, restricted along the inclusion of L in G. -/
def geometryFamily (z g y : G) (A : Subgroup G) :
    Fin 3 → Subgroup (geometryGroup z g y) :=
  ![(normalizer (coreIntersection z g : Set G)).subgroupOf (geometryGroup z g y),
    (normalizer (A : Set G)).subgroupOf (geometryGroup z g y),
    (normalizer (coreIntersection z y : Set G)).subgroupOf (geometryGroup z g y)]

/-- The subgroup construction and fusion assertions used from source 3.1.
This is a prerequisite interface, not a proved existence assertion. The Sylow
subgroup is intrinsic to H, and both splitting clauses use literal embeddings. -/
structure A3Configuration (z g : G) where
  y : G
  conjugate_mem : y * z * y⁻¹ ∈ coreInG z
  conjugate_ne : y * z * y⁻¹ ≠ z
  endpoint_intersection : coreIntersection z g ⊓ coreIntersection z y = zpowers z
  fusion_union : ∀ x : G, (x ∈ coreInG z ∧ IsConj z x) ↔
    (x ∈ coreIntersection z g ∨ x ∈ coreIntersection z y) ∧ x ≠ 1
  A : Subgroup G
  elementary : IsElementaryAbelian 2 A
  card : Nat.card A = 16
  self_centralizing : centralizer (A : Set G) = A
  normalizer_quotient : Nonempty
    ((normalizer (A : Set G) ⧸ A.subgroupOf (normalizer (A : Set G))) ≃*
      (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3)))
  S : Sylow 2 (Centralizer z)
  A_le_sylow : A ≤ (S : Subgroup (Centralizer z)).map (Centralizer z).subtype
  normalizer_intersection : Centralizer z ⊓ normalizer (A : Set G) =
    (S : Subgroup (Centralizer z)).map (Centralizer z).subtype
  point_split : ∃ K : Subgroup (normalizer (coreIntersection z g : Set G)),
    IsComplement' ((coreIntersection z g).subgroupOf
      (normalizer (coreIntersection z g : Set G))) K
  plane_split : ∃ K : Subgroup (normalizer (coreIntersection z y : Set G)),
    IsComplement' ((coreIntersection z y).subgroupOf
      (normalizer (coreIntersection z y : Set G))) K

/-- The remaining local assertions of source 3.2, before generation and D4.
The parabolics are intrinsic to the literal embedded vertices. The two-cores,
Sylow condition, generation and trivial chamber core are proved in `Assembly`.
No core or recognition assertion is included. -/
structure A3ParabolicData (z g y : G) (A : Subgroup G) : Prop where
  middle_le : normalizer (A : Set G) ≤ geometryGroup z g y
  point_parabolics : Quasithin.I5.RankTwoParabolics (geometryFamily z g y A 0)
    ((Quasithin.I5.chamberSubgroup (geometryFamily z g y A)).subgroupOf
      (geometryFamily z g y A 0))
    (Quasithin.I5.localParabolic (geometryFamily z g y A) 0 1)
    (Quasithin.I5.localParabolic (geometryFamily z g y A) 0 2)
  line_parabolics : Quasithin.I5.RankTwoParabolics (geometryFamily z g y A 1)
    ((Quasithin.I5.chamberSubgroup (geometryFamily z g y A)).subgroupOf
      (geometryFamily z g y A 1))
    (Quasithin.I5.localParabolic (geometryFamily z g y A) 1 0)
    (Quasithin.I5.localParabolic (geometryFamily z g y A) 1 2)
  plane_parabolics : Quasithin.I5.RankTwoParabolics (geometryFamily z g y A 2)
    ((Quasithin.I5.chamberSubgroup (geometryFamily z g y A)).subgroupOf
      (geometryFamily z g y A 2))
    (Quasithin.I5.localParabolic (geometryFamily z g y A) 2 0)
    (Quasithin.I5.localParabolic (geometryFamily z g y A) 2 1)

end CFSG.Quasithin.Extraspecial32.NonnormalRecognition

end
