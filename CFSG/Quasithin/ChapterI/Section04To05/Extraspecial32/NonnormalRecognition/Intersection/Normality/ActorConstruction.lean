module

public import CFSG.Quasithin.ChapterI.Section04To05.Extraspecial32.NonnormalRecognition.Intersection.Normality.Contracts
public import Theory.GroupTheory.NormalizingInvolutionCard
public import Theory.GroupTheory.QuaternionCentralProductInvolutionCentralizers
public import Theory.GroupTheory.SymmetricThreeQuotientInverter

/-!
# Constructing the arranged quaternion-swapping actor

The centralizer of the original involution inside the conjugate core has
order at least sixteen and is generated by involutions. Its intersection
with the original core has order eight, so one of these involutions lies
outside the original core. The symmetric-three quotient supplies a cubic
subgroup inverted by this involution; Sylow conjugacy transports that
subgroup to the original chosen `h.X`, conjugating the actor and the second
core together by the same element of H.

An outside involution generates H together with Q and X by the local orders.
Q and X preserve both intrinsic quaternion factors, so nonnormality of the
factors forces this involution to interchange them. This constructs every
field of `ArrangedSwapWitness`, with literal left conjugation by `a * g`.
No actor, inversion, or intersection-normality premise is added.

Source: Aschbacher, “A 2-local characterization of M12”, Illinois J. Math.
47 (2003), Lemmas 2.2–2.4, pp.33–34; Aschbacher–Smith, I.4.6,
combined manuscript of 1 March 2004, printed p.417.
-/

namespace CFSG.Quasithin.Extraspecial32.NonnormalRecognition
open Subgroup
variable {G : Type*} [Group G] [Finite G] {z : G}

private theorem outside_involution_generates (h : Hypotheses z)
    (u : Centralizer z) (hu : u ^ 2 = 1) (hout : u ∉ Core z) :
    Core z ⊔ (h.X : Subgroup (Centralizer z)) ⊔ zpowers u = ⊤ := by
  let S := Core z ⊔ (h.X : Subgroup (Centralizer z)) ⊔ zpowers u
  have h64 : Nat.card (Core z ⊔ zpowers u : Subgroup (Centralizer z)) = 64 := by
    rw [card_sup_zpowers_of_normalizing_involution (Core z) u hu hout
      (le_normalizer_of_normal (mem_top u)), h.core_card]
  have hd64 : 64 ∣ Nat.card S := h64 ▸ card_dvd_of_le
    (show Core z ⊔ zpowers u ≤ S from sup_le (le_sup_left.trans le_sup_left) le_sup_right)
  have hd3 : 3 ∣ Nat.card S := h.sylow_three_card ▸ card_dvd_of_le
    (show (h.X : Subgroup (Centralizer z)) ≤ S from le_sup_right.trans le_sup_left)
  have hd : 192 ∣ Nat.card S :=
    (show Nat.Coprime 64 3 by decide).mul_dvd_of_dvd_of_dvd hd64 hd3
  apply S.eq_top_of_card_eq
  apply Nat.dvd_antisymm S.card_subgroup_dvd_card
  simpa only [h.centralizer_card] using hd

private theorem intrinsic_factor_normal (Q : Type*) [Group Q]
    (d : QuaternionCentralProductData Q) : d.left.Normal := by
  apply normalizer_eq_top_iff.mp
  apply top_unique
  rw [← d.span]
  apply sup_le d.left.le_normalizer
  apply le_trans ?_ (centralizer_le_normalizer _)
  intro c hc b hb
  exact d.commute b hb c hc

private theorem embedded_factor_conj (d : QuaternionCentralProductData (Core z))
    (u : Centralizer z) :
    (d.left.map (MulAut.conjNormal u).toMonoidHom).map (Core z).subtype =
      (d.left.map (Core z).subtype).map (MulAut.conj u).toMonoidHom := by
  rw [map_map, map_map]
  rfl

private theorem cubic_normalizes_quaternion_factor (h : Hypotheses z)
    (d : QuaternionCentralProductData (Core z)) :
    (h.X : Subgroup (Centralizer z)) ≤ normalizer (d.left.map (Core z).subtype : Set (Centralizer z)) := by
  intro x hx
  have hx3 : x ^ 3 = 1 := by
    have hp := pow_card_eq_one' (x := (⟨x, hx⟩ : h.X))
    change (⟨x, hx⟩ : h.X) ^ Nat.card (h.X : Subgroup (Centralizer z)) = 1 at hp
    rw [h.sylow_three_card] at hp
    exact congrArg (fun a : h.X => (a : Centralizer z)) hp
  have hα3 : (MulAut.conjNormal x : MulAut (Core z)) ^ 3 = 1 := by
    rw [← map_pow, hx3, map_one]
  have hcube (q : Core z) :
      (MulAut.conjNormal x) ((MulAut.conjNormal x) ((MulAut.conjNormal x) q)) = q := by
    simpa only [pow_succ, pow_zero, MulAut.mul_apply, MulAut.one_apply] using
      DFunLike.congr_fun hα3 q
  have hmap := (quaternion_factors_invariant_of_cube_eq_one d.left d.right
    d.left_model d.right_model d.intersection_card d.commute (MulAut.conjNormal x)
    (by rw [d.span]; exact map_top_of_surjective _ (MulAut.conjNormal x).surjective)
    hcube).1
  apply mem_normalizer_iff_map_conj_eq.mpr
  change (d.left.map (Core z).subtype).map (MulAut.conj x).toMonoidHom = _
  rw [← embedded_factor_conj d x, hmap]

private theorem outside_involution_swaps (h : Hypotheses z) (hn : QuaternionSubgroupsNonnormal z)
    (d : QuaternionCentralProductData (Core z))
    (u : Centralizer z) (hu : u ^ 2 = 1) (hout : u ∉ Core z) :
    d.left.map (MulAut.conjNormal u).toMonoidHom = d.right := by
  have himage := (d.quaternion_subgroup_iff
    (d.left.map (MulAut.conjNormal u).toMonoidHom)).mp
      ⟨((MulAut.conjNormal u).subgroupMap d.left).symm.trans d.left_model.some⟩
  rcases himage with hfix | hswap
  · exfalso
    apply hn d.left d.left_model
    apply normalizer_eq_top_iff.mp
    apply top_unique
    rw [← outside_involution_generates h u hu hout]
    refine sup_le (sup_le ?_ (cubic_normalizes_quaternion_factor h d)) ?_
    · apply (normal_subgroupOf_iff_le_normalizer (map_subtype_le d.left)).mp
      change ((d.left.map (Core z).subtype).comap (Core z).subtype).Normal
      rw [comap_map_eq_self_of_injective (Core z).subtype_injective]
      exact intrinsic_factor_normal (Core z) d
    · apply zpowers_le.mpr
      apply mem_normalizer_iff_map_conj_eq.mpr
      change (d.left.map (Core z).subtype).map (MulAut.conj u).toMonoidHom = _
      rw [← embedded_factor_conj d u, hfix]
  · exact hswap

/-- Source 2.4: the second core supplies an involution outside the first core. -/
private theorem exists_unarranged_involution (h : Hypotheses z) (g : G)
    (hgQ : g * z * g⁻¹ ∈ coreInG z) (hg : g * z * g⁻¹ ≠ z) :
    ∃ v : Centralizer z, v ^ 2 = 1 ∧ v ∉ Core z ∧
      (v : G) ∈ (coreInG z).map (MulAut.conj g).toMonoidHom := by
  classical
  obtain ⟨q, hq, hqz⟩ := (involution_mem_coreIntersection h g hgQ hg).2
  obtain ⟨r, hr, hrq⟩ := hq
  let t : Core z := ⟨r, hr⟩
  let zQ : Core z := ⟨distinguished z, h.distinguished_mem_core⟩
  let f : Core z →* G := (MulAut.conj g).toMonoidHom.comp
    ((Centralizer z).subtype.comp (Core z).subtype)
  have hf : Function.Injective f := (MulAut.conj g).injective.comp
    ((Centralizer z).subtype_injective.comp (Core z).subtype_injective)
  have hft : f t = z := by
    change (MulAut.conj g) ((r : Centralizer z) : G) = z
    exact (congrArg (MulAut.conj g) hrq).trans hqz
  have hfz : f zQ = g * z * g⁻¹ := rfl
  have ht : orderOf t = 2 := by
    rw [← orderOf_injective f hf, hft, h.involution]
  have hzQ : orderOf zQ = 2 := (Subgroup.orderOf_coe zQ).symm.trans h.distinguished_order
  have hzC : zQ ∈ center (Core z) := by
    apply mem_center_iff.mpr
    intro x
    apply Subtype.ext
    apply Subtype.ext
    exact mem_centralizer_singleton_iff.mp x.val.property
  have htz : t ≠ zQ := by
    intro he
    apply hg
    rw [← hfz, ← he, hft]
  let D : Subgroup (Core z) := centralizer ({t} : Set (Core z))
  obtain ⟨d⟩ := h.quaternionCentralProduct
  have hgen : closure {x : Core z | x ∈ D ∧ orderOf x = 2} = D :=
    (quaternion_central_product_involution_centralizer_geometry
      d.left d.right d.left_model.some d.right_model.some d.span
      d.intersection_card d.commute zQ t hzQ hzC ht htz).1
  have hconj (x : Core z) : f x ∈ (coreInG z).map (MulAut.conj g).toMonoidHom :=
    mem_map_of_mem _ (mem_map_of_mem (Centralizer z).subtype x.property)
  have hH {x : Core z} (hx : x ∈ D) : f x ∈ Centralizer z := by
    apply mem_centralizer_singleton_iff.mpr
    simpa only [map_mul, hft] using congrArg f (mem_centralizer_singleton_iff.mp hx)
  by_contra hn
  have hsmall : D ≤ (coreInG z).comap f := by
    rw [← hgen]
    apply (closure_le _).mpr
    intro x hx
    by_contra hout
    let v : Centralizer z := ⟨f x, hH hx.1⟩
    apply hn
    refine ⟨v, ?_, ?_, hconj x⟩
    · apply Subtype.ext
      change (f x) ^ 2 = 1
      rw [← map_pow, ← hx.2, pow_orderOf_eq_one, map_one]
    · intro hv
      exact hout (mem_map_of_mem (Centralizer z).subtype hv)
  have hmap : D.map f ≤ coreIntersection z g := by
    rintro _ ⟨x, hx, rfl⟩
    exact ⟨hsmall hx, hconj x⟩
  have hcard : Nat.card D ≤ 8 := by
    have hc := card_le_of_le hmap
    rw [card_map_of_injective hf, coreIntersection_card h g hgQ hg] at hc
    exact hc
  let : IsExtraspecial 2 (Core z) := h.extraspecial
  have hlarge := IsExtraspecial.centralizer_card_ge_sixteen_of_card_thirty_two h.core_card t
  change 16 ≤ Nat.card D at hlarge
  omega

/-- Every outside involution has an H-conjugate inverting the specified Sylow three. -/
private theorem exists_conjugate_inverting_chosen_three (h : Hypotheses z)
    (v : Centralizer z) (hv2 : v ^ 2 = 1) (hvQ : v ∉ Core z) :
    ∃ a : Centralizer z, ∀ x ∈ (h.X : Subgroup (Centralizer z)),
      (MulAut.conj a v) * x * (MulAut.conj a v)⁻¹ = x⁻¹ := by
  have hv : orderOf v = 2 := orderOf_eq_prime hv2
    (fun he => hvQ (he ▸ (Core z).one_mem))
  obtain ⟨P, hP, hinv⟩ := exists_inverted_three_of_symmetric_three_quotient
    (Core z) (IsPGroup.of_card (p := 2) (n := 5) h.core_card)
    h.quotient_model v hv hvQ
  have hi : P.index = 64 := by
    have he := P.card_mul_index
    rw [hP, h.centralizer_card] at he
    omega
  let Y : Sylow 3 (Centralizer z) :=
    (IsPGroup.of_card (p := 3) (n := 1) (by simpa using hP)).toSylow
      (by rw [hi]; decide)
  obtain ⟨a, ha⟩ := MulAction.exists_smul_eq (Centralizer z) Y h.X
  have hmap : P.map (MulAut.conj a).toMonoidHom = (h.X : Subgroup (Centralizer z)) := by
    have he := congrArg (fun R : Sylow 3 (Centralizer z) => (R : Subgroup (Centralizer z))) ha
    exact he
  refine ⟨a, ?_⟩
  intro x hx
  rw [← hmap] at hx
  obtain ⟨y, hy, rfl⟩ := hx
  change (MulAut.conj a v) * (MulAut.conj a y) * (MulAut.conj a v)⁻¹ =
    (MulAut.conj a y)⁻¹
  simpa only [map_mul, map_inv] using congrArg (MulAut.conj a) (hinv y hy)

/-- The arranged actor of source 2.4 and its swap and generation assertions. -/
public theorem nonempty_arrangedSwapWitness (h : Hypotheses z)
    (hn : QuaternionSubgroupsNonnormal z) (g : G)
    (hgQ : g * z * g⁻¹ ∈ coreInG z) (hg : g * z * g⁻¹ ≠ z) :
    Nonempty (ArrangedSwapWitness h g) := by
  obtain ⟨v, hv2, hvQ, hvg⟩ := exists_unarranged_involution h g hgQ hg
  obtain ⟨a, ha⟩ := exists_conjugate_inverting_chosen_three h v hv2 hvQ
  let u := MulAut.conj a v
  have hu2 : u ^ 2 = 1 := by
    change (MulAut.conj a v) ^ 2 = 1
    rw [← map_pow, hv2, map_one]
  have huQ : u ∉ Core z := by
    intro hu
    have hv := (inferInstance : (Core z).Normal).conj_mem u hu a⁻¹
    apply hvQ
    simpa only [u, MulAut.conj_apply, inv_inv, mul_assoc, inv_mul_cancel_left,
      mul_inv_cancel_right, inv_mul_cancel, mul_one] using hv
  have hug : (u : G) ∈ (coreInG z).map (MulAut.conj ((a : G) * g)).toMonoidHom := by
    obtain ⟨q, hq, hqv⟩ := hvg
    refine ⟨q, hq, ?_⟩
    change ((a : G) * g) * q * ((a : G) * g)⁻¹ =
      (a : G) * (v : G) * (a : G)⁻¹
    have he : g * q * g⁻¹ = (v : G) := hqv
    rw [mul_inv_rev]
    calc
      _ = (a : G) * (g * q * g⁻¹) * (a : G)⁻¹ := by group
      _ = _ := by rw [he]
  obtain ⟨d⟩ := h.quaternionCentralProduct
  exact ⟨{
    a := a
    u := u
    factors := d
    square := hu2
    outside := by
      intro hu
      exact huQ ((coreInG_subgroupOf z).le hu)
    in_conjugate_core := hug
    inverts := ha
    swaps := outside_involution_swaps h hn d u hu2 huQ
    generates := outside_involution_generates h u hu2 huQ }⟩

end CFSG.Quasithin.Extraspecial32.NonnormalRecognition
