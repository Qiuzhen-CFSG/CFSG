module

public import CFSG.Quasithin.ChapterI.Section04To05.Extraspecial32.NonnormalRecognition.Fusion
public import Theory.GroupTheory.SetStrongClosure
public import Theory.GroupTheory.PCoreFromTwoNormalizers
public import Theory.GroupTheory.QuaternionCentralProductInvolutions
import Mathlib.Tactic.Group
public import Theory.SpecificGroups.PSL3Two.Parabolics.LinearModel
public import CFSG.Quasithin.ChapterI.Section06To08.Basic

/-!
# Strong closure and trivial intersections in the saturated branch

Put E = Q ∩ Qᵍ and M = N_G(E). Saturation and the supplied involution
fusion first identify every conjugate of z in its centralizer as an element
of E. A fixed-coset argument using odd index extends this to M, proving
strong closure. The orders |M| = 1344 and |C_G(z)| = 192 make M transitive
on the seven nonidentity elements of E. This gives their centralizer
containment and the TI property. Finally Q₈ ◦ Q₈ is generated by its
involutions, so M contains an involution outside E.

These are the first steps of Aschbacher, “A 2-local characterization of M12”,
Illinois J. Math. 47 (2003), Lemma 2.8(1), printed pp.35–36. They use the
literal fusion intersection and relative normality in H. Global normality
of E is not asserted here.
-/

@[expose] public section

open Subgroup
open Theory.GroupTheory
namespace CFSG.Quasithin.Extraspecial32.NonnormalRecognition
variable {G : Type*} [Group G] [Finite G] {z g : G}

omit [Finite G] in
private theorem orderOf_eq_of_isConj {x y : G} (hc : IsConj x y) : orderOf x = orderOf y := by
  obtain ⟨a, ha⟩ := hc
  exact ha.orderOf_eq (a : G)

theorem mem_intersection_of_conjugate_in_centralizer (h : Hypotheses z)
    (d : IntersectionData z g) (hs : FusionSaturated z g)
    {t : G} (ht : t ∈ Centralizer z) (hc : IsConj z t) :
    t ∈ coreIntersection z g := by
  have horder : orderOf t = 2 := (orderOf_eq_of_isConj hc).symm.trans h.involution
  obtain ⟨m, hm⟩ := d.involution_fusion t ht horder
  have hconj : IsConj z ((m : G) * t * (m : G)⁻¹) :=
    hc.trans (isConj_iff.mpr ⟨m, rfl⟩)
  exact (m.property t).mpr ((hs _).mpr ⟨hm, hconj⟩).1

omit [Finite G] in
theorem centralizer_le_intersection_normalizer (d : IntersectionData z g) :
    Centralizer z ≤ normalizer (coreIntersection z g : Set G) :=
  (normal_subgroupOf_iff_le_normalizer
    ((coreIntersection_le z g).trans (coreInG_le z))).mp d.normal_in_centralizer

theorem mem_intersection_of_conjugate_in_normalizer (h : Hypotheses z)
    (d : IntersectionData z g) (hs : FusionSaturated z g)
    {t : G} (ht : t ∈ normalizer (coreIntersection z g : Set G)) (hc : IsConj z t) :
    t ∈ coreIntersection z g := by
  let M := normalizer (coreIntersection z g : Set G)
  let H := (Centralizer z).subgroupOf M
  let tM : M := ⟨t, ht⟩
  have horder : orderOf tM = 2 := by
    rw [← Subgroup.orderOf_coe]
    exact (orderOf_eq_of_isConj hc).symm.trans h.involution
  have hp : IsPGroup 2 (zpowers tM) :=
    IsPGroup.of_card (n := 1) (by simpa only [Nat.card_zpowers, pow_one] using horder)
  have hodd : ¬ 2 ∣ H.index := by
    intro he
    exact d.centralizer_odd_index.not_two_dvd_nat
      (he.trans (relIndex_dvd_index_of_le (centralizer_le_intersection_normalizer d)))
  obtain ⟨m, hm⟩ := exists_conj_overgroup_of_index_primeTo (zpowers tM) H hp hodd
  have hmH : (m : G) * t * (m : G)⁻¹ ∈ Centralizer z := hm (mem_zpowers tM)
  have hmE := mem_intersection_of_conjugate_in_centralizer h d hs hmH
    (hc.trans (isConj_iff.mpr ⟨m, rfl⟩))
  exact (m.property t).mpr hmE

theorem stronglyClosed_intersection_normalizer (h : Hypotheses z)
    (d : IntersectionData z g) (hs : FusionSaturated z g) :
    IsStronglyClosedSet (coreIntersection z g : Set G)
      (normalizer (coreIntersection z g : Set G)) ⊤ := by
  refine ⟨(coreIntersection z g).le_normalizer, ?_⟩
  intro x hx a _ ha
  by_cases hx1 : x = 1
  · simp [hx1]
  · apply mem_intersection_of_conjugate_in_normalizer h d hs ha
    exact ((hs x).mp ⟨hx, hx1⟩).2.trans
      (isConj_iff.mpr ⟨a⁻¹, by simp⟩)

omit [Finite G] in
theorem normalizer_card (d : IntersectionData z g) :
    Nat.card (normalizer (coreIntersection z g : Set G)) = 1344 := by
  let E := coreIntersection z g
  let M := normalizer (E : Set G)
  have hE : Nat.card (E.subgroupOf M) = 8 :=
    (Nat.card_congr (subgroupOfEquivOfLe E.le_normalizer).toEquiv).trans d.card
  have hquot : Nat.card (M ⧸ E.subgroupOf M) = 168 :=
    (Nat.card_congr d.normalizer_quotient.some.toEquiv).trans Matrix.PSL3Two.card_PSL
  change Nat.card M = 1344
  rw [card_eq_card_quotient_mul_card_subgroup (E.subgroupOf M), hquot, hE]

theorem normalizer_transitive (h : Hypotheses z) (d : IntersectionData z g)
    (hs : FusionSaturated z g) {x : G} (hx : x ∈ coreIntersection z g) (hx1 : x ≠ 1) :
    ∃ m : normalizer (coreIntersection z g : Set G), (m : G) * z * (m : G)⁻¹ = x := by
  classical
  let E := coreIntersection z g
  let M := normalizer (E : Set G)
  let : MulDistribMulAction M E := MulDistribMulAction.compHom E E.normalizerMonoidHom
  have hzE : z ∈ E := ((hs z).mpr ⟨h.involution_mem_coreInG, IsConj.refl z⟩).1
  let zE : E := ⟨z, hzE⟩
  have hz1 : zE ≠ 1 := by
    intro he
    have hz : z = 1 := congrArg Subtype.val he
    simpa [hz] using h.involution
  have hstab : MulAction.stabilizer M zE = (Centralizer z).subgroupOf M := by
    ext m
    change E.normalizerMonoidHom m zE = zE ↔ (m : G) ∈ Centralizer z
    rw [Subtype.ext_iff]
    change (m : G) * z * (m : G)⁻¹ = z ↔ _
    rw [mul_inv_eq_iff_eq_mul, mem_centralizer_singleton_iff]
  have hstabcard : Nat.card (MulAction.stabilizer M zE) = 192 := by
    rw [hstab, Nat.card_congr
      (subgroupOfEquivOfLe (centralizer_le_intersection_normalizer d)).toEquiv]
    exact h.centralizer_card
  have horbitcard : Nat.card (MulAction.orbit M zE) = 7 := by
    have hh := Nat.card_congr (MulAction.orbitProdStabilizerEquivGroup M zE)
    rw [Nat.card_prod, hstabcard, normalizer_card d] at hh
    omega
  have hsub : MulAction.orbit M zE ⊆ {y : E | y ≠ 1} := by
    rintro y ⟨m, rfl⟩ hy
    apply hz1
    exact (E.normalizerMonoidHom m).injective (hy.trans (map_one _).symm)
  have hsharp : Nat.card {y : E // y ≠ 1} = 7 := by
    change ({1}ᶜ : Set E).ncard = 7
    rw [Set.ncard_compl, Set.ncard_singleton]
    rw [d.card]
  have heq : MulAction.orbit M zE = {y : E | y ≠ 1} :=
    Set.eq_of_subset_of_ncard_le hsub (hsharp.trans horbitcard.symm).le
  have hxorb : (⟨x, hx⟩ : E) ∈ MulAction.orbit M zE := by
    rw [heq]
    exact fun he => hx1 (congrArg Subtype.val he)
  obtain ⟨m, hm⟩ := hxorb
  exact ⟨m, congrArg Subtype.val hm⟩

theorem centralizer_le_normalizer_of_mem_intersection (h : Hypotheses z)
    (d : IntersectionData z g) (hs : FusionSaturated z g)
    {x : G} (hx : x ∈ coreIntersection z g) (hx1 : x ≠ 1) :
    Centralizer x ≤ normalizer (coreIntersection z g : Set G) := by
  obtain ⟨m, hm⟩ := normalizer_transitive h d hs hx hx1
  intro a ha
  have hc : (m : G)⁻¹ * a * (m : G) ∈ Centralizer z := by
    apply mem_centralizer_singleton_iff.mpr
    have he := mem_centralizer_singleton_iff.mp ha
    have he' : z = (m : G)⁻¹ * x * (m : G) := by rw [← hm]; group
    calc
      (m : G)⁻¹ * a * (m : G) * z =
          (m : G)⁻¹ * a * (m : G) * ((m : G)⁻¹ * x * (m : G)) :=
            congrArg (fun w : G => (m : G)⁻¹ * a * (m : G) * w) he'
      _ =
          (m : G)⁻¹ * (a * x) * (m : G) := by group
      _ = (m : G)⁻¹ * (x * a) * (m : G) := by rw [he]
      _ = ((m : G)⁻¹ * x * (m : G)) * ((m : G)⁻¹ * a * (m : G)) := by group
      _ = z * ((m : G)⁻¹ * a * (m : G)) :=
        congrArg (fun w : G => w * ((m : G)⁻¹ * a * (m : G))) he'.symm
  have hcM := centralizer_le_intersection_normalizer d hc
  have hh := (normalizer (coreIntersection z g : Set G)).mul_mem
    ((normalizer (coreIntersection z g : Set G)).mul_mem m.property hcM)
    ((normalizer (coreIntersection z g : Set G)).inv_mem m.property)
  simpa only [mul_assoc, mul_inv_cancel_left, mul_inv_cancel_right, mul_inv_cancel, mul_one] using hh

theorem intersection_isTI (h : Hypotheses z) (d : IntersectionData z g)
    (hs : FusionSaturated z g) :
    CFSG.Quasithin.ChapterI.Section06To08.IsTISubgroup (coreIntersection z g) := by
  apply CFSG.Quasithin.ChapterI.Section06To08.lemma_I_6_1_1_of_mem_normalizer
  · exact fun x hx hx1 => centralizer_le_normalizer_of_mem_intersection h d hs hx hx1
  · intro x y hx hy hxy
    by_cases hx1 : x = 1
    · obtain ⟨a, ha⟩ := hxy
      have hy1 : y = 1 := by simpa [hx1] using ha.symm
      exact ⟨1, by simp [hx1, hy1]⟩
    have hy1 : y ≠ 1 := by
      rintro rfl
      obtain ⟨a, ha⟩ := hxy
      apply hx1
      exact (MulAut.conj a).map_eq_one_iff.mp ha
    obtain ⟨a, ha⟩ := normalizer_transitive h d hs hx hx1
    obtain ⟨b, hb⟩ := normalizer_transitive h d hs hy hy1
    refine ⟨b * a⁻¹, ?_⟩
    change ((b : G) * (a : G)⁻¹) * x * ((b : G) * (a : G)⁻¹)⁻¹ = y
    rw [← ha, ← hb]
    group

theorem exists_involution_outside_intersection (h : Hypotheses z)
    (d : IntersectionData z g) :
    ∃ t : G, t ∈ normalizer (coreIntersection z g : Set G) ∧
      orderOf t = 2 ∧ t ∉ coreIntersection z g := by
  classical
  by_contra hnone
  push Not at hnone
  have hcontain : coreInG z ≤ coreIntersection z g := by
    obtain ⟨q⟩ := h.quaternionCentralProduct
    have hgen := quaternion_central_product_involutions_generate q.left q.right
      q.left_model q.right_model q.intersection_card q.commute
    rw [q.span] at hgen
    have hmap : ∀ x : Core z, x ^ 2 = 1 →
        ((x : Centralizer z) : G) ∈ coreIntersection z g := by
      intro x hx
      by_cases hx1 : ((x : Centralizer z) : G) = 1
      · rw [hx1]
        exact (coreIntersection z g).one_mem
      apply hnone _ (centralizer_le_intersection_normalizer d x.val.property)
      apply orderOf_eq_prime _ hx1
      exact congrArg (fun a : Core z => ((a : Centralizer z) : G)) hx
    have hle : (⊤ : Subgroup (Core z)) ≤
        (coreIntersection z g).comap ((Centralizer z).subtype.comp (Core z).subtype) := by
      rw [← hgen]
      exact (closure_le _).mpr (fun x hx => hmap x hx.2)
    rintro _ ⟨x, hx, rfl⟩
    exact hle (mem_top (⟨x, hx⟩ : Core z))
  have hc := Subgroup.card_dvd_of_le hcontain
  rw [h.coreInG_card, d.card] at hc
  norm_num at hc

end CFSG.Quasithin.Extraspecial32.NonnormalRecognition

end
