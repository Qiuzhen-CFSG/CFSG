module

public import CFSG.Quasithin.ChapterI.Section04To05.Extraspecial32.LocalStructure
public import Theory.GroupTheory.SharpTransitivity

/-!+# The fusion subgroup in the normal-quaternion branch

The canonical subgroup below is generated by the ambient conjugates of `z`
lying in the literal core. It is contained in that core and is normalized by
the involution centralizer. It is normal in the ambient group precisely when
every ambient conjugate of `z` lies in the core.

`FusionEightData` records the additional local conclusions needed from
Aschbacher's fusion analysis. `DegreeTwelveAction` records the permutation
action constructed later in the nonnormal case. These are explicit intermediate
contracts; this module does not assert that the source hypotheses supply them.

Source: M. Aschbacher, “A 2-local characterization of M12”, Illinois J. Math.
47 (2003), 31–47, Lemmas 2.7–2.8 and 4.1, 4.10–4.11. The source's `A(z)`
is the nonidentity fusion set with the identity adjoined, once closure is proved.
-/

namespace CFSG.Quasithin.Extraspecial32

open Subgroup Theory.GroupTheory

variable {G : Type*} [Group G] {z : G}

/-- The subgroup generated by the conjugates of `z` lying in the actual core. -/
@[expose] public def fusionCore (z : G) : Subgroup G :=
  closure {x : G | x ∈ coreInG z ∧ IsConj z x}

public theorem fusionCore_le (z : G) : fusionCore z ≤ coreInG z :=
  (closure_le _).mpr (fun _ hx => hx.1)

public theorem fusionCore_le_normalClosure (z : G) :
    fusionCore z ≤ normalClosure ({z} : Set G) := by
  apply (closure_le _).mpr
  rintro x ⟨_, hx⟩
  obtain ⟨g, rfl⟩ := isConj_iff.mp hx
  exact (inferInstance : (normalClosure ({z} : Set G)).Normal).conj_mem z
    (subset_normalClosure (Set.mem_singleton z)) g

namespace Hypotheses

variable [Finite G]

public theorem involution_mem_fusionCore (h : Hypotheses z) : z ∈ fusionCore z :=
  subset_closure ⟨h.involution_mem_coreInG, IsConj.refl z⟩

/-- Normality here is relative to `H = C_G(z)`. -/
public theorem centralizer_le_normalizer_fusionCore (h : Hypotheses z) :
    Centralizer z ≤ normalizer (fusionCore z : Set G) := by
  apply le_normalizer_closure_iff.mpr
  intro a ha x hx
  apply Subgroup.subset_closure
  refine ⟨?_, hx.2.trans (isConj_iff.mpr ⟨a, rfl⟩)⟩
  have hn : a ∈ normalizer (coreInG z : Set G) := h.normalizer_core.symm ▸ ha
  exact (mem_normalizer_iff.mp hn x).mp hx.1

public theorem fusionCore_normal_in_centralizer (h : Hypotheses z) :
    ((fusionCore z).subgroupOf (Centralizer z)).Normal :=
  (normal_subgroupOf_iff_le_normalizer ((fusionCore_le z).trans (coreInG_le z))).mpr
    h.centralizer_le_normalizer_fusionCore

/-- In the normal case the local fusion subgroup is the global normal closure. -/
public theorem fusionCore_eq_normalClosure (h : Hypotheses z) [(fusionCore z).Normal] :
    fusionCore z = normalClosure ({z} : Set G) :=
  le_antisymm (fusionCore_le_normalClosure z)
    (normalClosure_le_normal (Set.singleton_subset_iff.mpr h.involution_mem_fusionCore))

public theorem fusionCore_normal_iff (h : Hypotheses z) :
    (fusionCore z).Normal ↔ ∀ x : G, IsConj z x → x ∈ coreInG z := by
  constructor
  · intro hn x hx
    obtain ⟨g, rfl⟩ := isConj_iff.mp hx
    exact fusionCore_le z (hn.conj_mem z h.involution_mem_fusionCore g)
  · intro hf
    have he : fusionCore z = normalClosure ({z} : Set G) := by
      apply le_antisymm (fusionCore_le_normalClosure z)
      apply (closure_le _).mpr
      intro x hx
      obtain ⟨y, hy, hyx⟩ := Group.mem_conjugatesOfSet_iff.mp hx
      have hyz : y = z := Set.mem_singleton_iff.mp hy
      subst y
      exact subset_closure ⟨hf x hyx, hyx⟩
    rw [he]
    infer_instance

end Hypotheses

/-- Local conclusions about the canonical fusion subgroup, still to be supplied
from the normal-quaternion hypotheses. -/
public structure FusionEightData (z : G) : Prop where
  elementary : IsElementaryAbelian 2 (fusionCore z)
  card : Nat.card (fusionCore z) = 8
  fusion : ∀ x ∈ fusionCore z, x ≠ 1 → IsConj z x
  centralizer_eq : centralizer (fusionCore z : Set G) = fusionCore z

/-- The data identify the literal source fusion set, not just an abstract eight. -/
public theorem FusionEightData.mem_iff (d : FusionEightData z) (x : G) :
    x ∈ fusionCore z ↔ x = 1 ∨ (x ∈ coreInG z ∧ IsConj z x) := by
  constructor
  · intro hx
    by_cases he : x = 1
    · exact Or.inl he
    · exact Or.inr ⟨fusionCore_le z hx, d.fusion x hx he⟩
  · rintro (rfl | hx)
    · exact (fusionCore z).one_mem
    · exact subset_closure hx

/-- The faithful sharp action constructed in Aschbacher 4.10–4.11. Recognition
as the actual Witt-design automorphism group is a separate assertion. -/
public structure DegreeTwelveAction (G : Type*) [Group G] where
  action : MulAction G (Fin 12)
  faithful : letI := action; FaithfulSMul G (Fin 12)
  sharp : letI := action;
    Theory.GroupTheory.MulAction.IsSharplyMultiplyPretransitive G (Fin 12) 5

end CFSG.Quasithin.Extraspecial32
