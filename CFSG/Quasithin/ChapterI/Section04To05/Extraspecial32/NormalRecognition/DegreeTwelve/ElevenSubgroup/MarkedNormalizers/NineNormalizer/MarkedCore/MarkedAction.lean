module

public import CFSG.Quasithin.ChapterI.Section04To05.Extraspecial32.NormalRecognition.DegreeTwelve.ElevenSubgroup.MarkedNormalizers.NineNormalizer.Preparation
public import Theory.SpecificGroups.AlternatingSix.ShadowLocal.QuaternionInvolutionAction

/-!
# The marked quaternion commutator calculation

The full normalizer equivalence embeds the two-group generated by P and the
literal r in a Sylow subgroup of Aut(A₆). Its index-two subgroup L contains
the inner automorphisms. The quaternion action calculation there shows that
an involution of L centralizing (P ∩ L)/⟨uz⟩ would belong to P ∩ L, contrary
to the choice of r. This supplies the commutator premise in the core assembly.

Source: M. Aschbacher, “A 2-local characterization of M12”, Illinois J.
Math. 47 (2003), the proof of Lemma 4.10, p.42.
-/


public section

open Subgroup
open scoped commutatorElement
namespace CFSG.Quasithin.Extraspecial32.DegreeTwelve.ElevenSubgroup.NineNormalizer.MarkedCore
variable {G : Type*} [Group G] [Finite G] {z : G}
variable {h : Hypotheses z} {a : SourceGeometry h}

/-- The original involution r acts nontrivially on the marked quaternion
quotient. No core-coset identity or recognition theorem is assumed. -/
theorem exists_noncentral_commutator (s : SymmetricSixData h a)
    (n : SymmetricNormalizerData s) (m : M10NormalizerGeometry s) :
    ∃ x ∈ m.P ⊓ m.L, ⁅m.r, x⁆ ∉ zpowers (s.u * z) := by
  classical
  by_contra! hc
  let N := normalizer (s.S : Set G)
  have hPN : m.P ≤ N := by
    intro x hx
    have hx' : x ∈ normalizer (s.S : Set G) ⊓ normalizer (s.markedNine : Set G) :=
      m.intersection.symm ▸ (show x ∈ s.markedNine ⊔ m.P from (show m.P ≤ s.markedNine ⊔ m.P from le_sup_right) hx)
    exact hx'.1
  let T := m.P ⊔ zpowers m.r
  have hrT : m.r ∈ T := (show zpowers m.r ≤ T from le_sup_right) (mem_zpowers m.r)
  have hTN : T ≤ N := sup_le hPN (zpowers_le.mpr (m.L_le m.r_mem))
  have hPt : IsPGroup 2 m.P := IsPGroup.of_card (p := 2) (n := 4) m.card_P
  have hrt : IsPGroup 2 (zpowers m.r) := by
    apply IsPGroup.of_card_dvd_pow (n := 1)
    rw [Nat.card_zpowers, pow_one]
    exact orderOf_dvd_of_pow_eq_one (by simpa only [pow_two] using m.r_sq)
  have hTt : IsPGroup 2 T :=
    hPt.to_sup_of_normal_left' hrt (zpowers_le.mpr m.r_normalizes_P)
  obtain ⟨V, hV⟩ := ((hTt.comap_subtype (K := N)).map n.equiv.toMonoidHom).exists_le_sylow
  let j : T →* V := {
    toFun t := ⟨n.equiv ⟨t, hTN t.property⟩,
      hV ⟨⟨t, hTN t.property⟩, t.property, rfl⟩⟩
    map_one' := Subtype.ext n.equiv.map_one
    map_mul' x y := Subtype.ext (n.equiv.map_mul ⟨x, hTN x.property⟩ ⟨y, hTN y.property⟩) }
  have hj : Function.Injective j := by
    intro x y he
    exact Subtype.ext (congrArg (fun w : N => (w : G))
      (n.equiv.injective (congrArg (fun w : V => (w : AlternatingSix.ShadowLocal.AutA6)) he)))
  let L := (m.L.subgroupOf N).map n.equiv.toMonoidHom
  have hL : Nat.card L = 720 := by
    rw [card_map_of_injective n.equiv.injective,
      Nat.card_congr (subgroupOfEquivOfLe m.L_le).toEquiv, m.card_L]
  obtain ⟨e⟩ := m.quaternion
  let q : QuaternionGroup 2 →* T :=
    (Subgroup.inclusion (show m.P ⊓ m.L ≤ T from inf_le_left.trans le_sup_left)).comp
      e.symm.toMonoidHom
  let f := j.comp q
  have hf : Function.Injective f := by
    intro x y he
    apply e.symm.injective
    exact Subtype.ext (congrArg (fun t : T => (t : G)) (hj he))
  have hfL (x : QuaternionGroup 2) : (f x : AlternatingSix.ShadowLocal.AutA6) ∈ L :=
    ⟨⟨e.symm x, m.L_le (e.symm x).property.2⟩, (e.symm x).property.2, rfl⟩
  let rT : T := ⟨m.r, hrT⟩
  have hrL : (j rT : AlternatingSix.ShadowLocal.AutA6) ∈ L :=
    ⟨⟨m.r, m.L_le m.r_mem⟩, m.r_mem, rfl⟩
  have hr2 : (j rT) ^ 2 = 1 := by
    rw [← map_pow]
    have he : rT ^ 2 = 1 := by
      apply Subtype.ext
      change m.r ^ 2 = 1
      simpa only [pow_two] using m.r_sq
    rw [he, map_one]
  let b := s.u * z
  have hbP : b ∈ m.P := by
    apply map_subtype_le (center m.P)
    rw [m.center_P]
    exact mem_zpowers b
  have hbR : b ∈ m.P ⊓ m.L := ⟨hbP, m.b_mem_K.1⟩
  let bR : (m.P ⊓ m.L : Subgroup G) := ⟨b, hbR⟩
  have hbne : e bR ≠ 1 := by
    intro he
    exact s.uz_ne_one (congrArg Subtype.val (e.injective (he.trans e.map_one.symm)))
  have hb2 : (e bR) ^ 2 = 1 := by
    rw [← map_pow]
    have he : bR ^ 2 = 1 := Subtype.ext s.uz_sq
    rw [he, map_one]
  have unique : ∀ v : QuaternionGroup 2, v ≠ 1 → v ^ 2 = 1 → v = .a 2 := by decide
  have hqb : ((q (.a 2) : T) : G) = b := by
    change (e.symm (.a 2) : G) = b
    rw [← unique (e bR) hbne hb2, e.symm_apply_apply]
  have hmem (x : G) (hx : x ∈ zpowers b) : x = 1 ∨ x = b := by
    rw [mem_zpowers_iff_mem_range_orderOf, s.uz_order] at hx
    obtain ⟨k, hk, he⟩ := Finset.mem_image.mp hx
    have hk' := Finset.mem_range.mp hk
    interval_cases k
    · exact Or.inl (by simpa only [pow_zero] using he.symm)
    · exact Or.inr (by simpa only [pow_one] using he.symm)
  have hcf (x : QuaternionGroup 2) : ⁅j rT, f x⁆ = 1 ∨ ⁅j rT, f x⁆ = f (.a 2) := by
    change ⁅j rT, j (q x)⁆ = 1 ∨ ⁅j rT, j (q x)⁆ = j (q (.a 2))
    have hx := hmem _ (hc (e.symm x) (e.symm x).property)
    have he : ⁅rT, q x⁆ = 1 ∨ ⁅rT, q x⁆ = q (.a 2) := by
      rcases hx with hx | hx
      · exact Or.inl (Subtype.ext hx)
      · exact Or.inr (Subtype.ext (hx.trans hqb.symm))
    rcases he with he | he
    · exact Or.inl (by simpa only [map_commutatorElement, map_one] using congrArg j he)
    · exact Or.inr (by simpa only [map_commutatorElement] using congrArg j he)
  obtain ⟨x, hx⟩ := AlternatingSix.ShadowLocal.QuaternionInvolutionAction.involution_mem_quaternion
    L hL V f hf hfL (j rT) hrL hr2 hcf
  have he : (e.symm x : G) = m.r := congrArg Subtype.val (hj hx)
  exact m.r_not_mem_P (he ▸ (e.symm x).property.1)

end CFSG.Quasithin.Extraspecial32.DegreeTwelve.ElevenSubgroup.NineNormalizer.MarkedCore

end
