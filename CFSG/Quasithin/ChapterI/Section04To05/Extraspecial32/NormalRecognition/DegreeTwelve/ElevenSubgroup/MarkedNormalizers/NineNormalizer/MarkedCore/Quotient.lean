module

public import CFSG.Quasithin.ChapterI.Section04To05.Extraspecial32.NormalRecognition.DegreeTwelve.ElevenSubgroup.MarkedNormalizers.NineNormalizer.Preparation

/-!
# The marked coset calculation in the involution centralizer

Assume the quaternion intersection is contained in the intrinsic core at b.
The semidihedral subgroup cannot be contained in that core, whose exponent
divides four. Its intersection with the core is therefore the quaternion
eight, so the marked z lies outside the core. A noncentral commutator of r
with that eight also places r outside the core. The two-group generated by
P and r has image in a Sylow two-subgroup of the S₃ quotient, of order two.
Thus r and z have the same image and rz belongs to the actual core.

The quaternion containment and the noncentral commutator remain explicit
premises here. This module does not claim their source proofs.

Source: M. Aschbacher, “A 2-local characterization of M12”, Illinois J.
Math. 47 (2003), the Q_b calculation in Lemma 4.10, p.42.
-/

public section

open Subgroup
open scoped commutatorElement
namespace CFSG.Quasithin.Extraspecial32.DegreeTwelve.ElevenSubgroup.NineNormalizer.MarkedCore
variable {G : Type*} [Group G] [Finite G] {z : G}
variable {h : Hypotheses z} {a : SourceGeometry h} {s : SymmetricSixData h a}

private theorem core_fourth (hb : Hypotheses (s.u * z)) {x : G} (hx : x ∈ coreInG (s.u * z)) :
    x ^ 4 = 1 := by
  let Q := coreInG (s.u * z)
  let : IsExtraspecial 2 Q := hb.coreInG_extraspecial
  have hc := IsExtraspecial.square_mem_center (⟨x, hx⟩ : Q)
  have hh := pow_card_eq_one' (x := (⟨(⟨x, hx⟩ : Q) ^ 2, hc⟩ : center Q))
  rw [IsExtraspecial.center_order_p 2 Q] at hh
  have he := congrArg (fun y : center Q => ((y : Q) : G)) hh
  simpa only [Subgroup.coe_pow, Subgroup.coe_one, ← pow_mul] using he

theorem z_not_core (m : M10NormalizerGeometry s) (hb : Hypotheses (s.u * z))
    (hRQ : m.P ⊓ m.L ≤ coreInG (s.u * z)) : z ∉ coreInG (s.u * z) := by
  let J := m.P ⊓ coreInG (s.u * z)
  have hRcard : Nat.card (m.P ⊓ m.L : Subgroup G) = 8 := by
    obtain ⟨e⟩ := m.quaternion
    rw [Nat.card_congr e.toEquiv, Nat.card_eq_fintype_card, QuaternionGroup.card]
  have hRJ : m.P ⊓ m.L ≤ J := le_inf inf_le_left hRQ
  have hJP : J ≤ m.P := inf_le_left
  have hd : Nat.card J ∣ 16 := m.card_P ▸ card_dvd_of_le hJP
  have hge : 8 ≤ Nat.card J := hRcard ▸ card_le_of_le hRJ
  have hle : Nat.card J ≤ 16 := m.card_P ▸ card_le_of_le hJP
  have hne : Nat.card J ≠ 16 := by
    intro hj
    have hJP' : J = m.P := eq_of_le_of_card_ge hJP (by rw [m.card_P, hj])
    obtain ⟨p, _, hp, _⟩ := m.semidihedral
    have hpQ : (p : G) ∈ coreInG (s.u * z) := (hJP'.symm ▸ p.property : (p : G) ∈ J).2
    have hp4 := core_fourth hb hpQ
    have hd := orderOf_dvd_of_pow_eq_one hp4
    rw [Subgroup.orderOf_coe p, hp] at hd
    norm_num at hd
  have hj : Nat.card J = 8 := by
    have hl : Nat.card J ≤ 15 := by omega
    interval_cases Nat.card J
    all_goals norm_num at hd
    all_goals rfl
  have hRJ' : m.P ⊓ m.L = J := eq_of_le_of_card_ge hRJ (by rw [hRcard, hj])
  intro hz
  have hzJ : z ∈ J := ⟨m.z_mem_P, hz⟩
  exact m.z_not_mem ((hRJ' ▸ hzJ : z ∈ m.P ⊓ m.L).2)

theorem r_not_core (m : M10NormalizerGeometry s) (hb : Hypotheses (s.u * z))
    (hRQ : m.P ⊓ m.L ≤ coreInG (s.u * z))
    (hmoved : ∃ x ∈ m.P ⊓ m.L, ⁅m.r, x⁆ ∉ zpowers (s.u * z)) :
    m.r ∉ coreInG (s.u * z) := by
  intro hr
  obtain ⟨x, hx, hn⟩ := hmoved
  let Q := coreInG (s.u * z)
  let : IsExtraspecial 2 Q := hb.coreInG_extraspecial
  have hc : ⁅(⟨m.r, hr⟩ : Q), (⟨x, hRQ hx⟩ : Q)⁆ ∈ center Q := by
    apply (IsExtraspecial.quotient_elementary_abelian 2 Q).commutator_le_center_of_central_quotient
    exact commutator_mem_commutator (mem_top _) (mem_top _)
  apply hn
  rw [← hb.coreInG_center_image]
  exact mem_map_of_mem Q.subtype hc

theorem rz_mem_core (m : M10NormalizerGeometry s) (hb : Hypotheses (s.u * z))
    (hzQ : z ∉ coreInG (s.u * z)) (hrQ : m.r ∉ coreInG (s.u * z)) :
    m.r * z ∈ coreInG (s.u * z) := by
  let b := s.u * z
  have hPH : m.P ≤ Centralizer b := by
    intro x hx
    have hbZ : b ∈ (center m.P).map m.P.subtype := m.center_P.symm ▸ mem_zpowers b
    obtain ⟨y, hy, hyb⟩ := hbZ
    exact mem_centralizer_singleton_iff.mpr (by
      rw [← hyb]
      exact congrArg Subtype.val (mem_center_iff.mp hy ⟨x, hx⟩))
  have hrH : m.r ∈ Centralizer b :=
    normalizer_le_centralizer_of_characteristic_involution
      m.P (center m.P) b s.uz_order m.center_P m.r_normalizes_P
  let T := m.P ⊔ zpowers m.r
  have hTr : m.r ∈ T := (show zpowers m.r ≤ T from le_sup_right) (mem_zpowers m.r)
  have hTz : z ∈ T := (show m.P ≤ T from le_sup_left) m.z_mem_P
  have hPtwo : IsPGroup 2 m.P := IsPGroup.of_card (p := 2) (n := 4) m.card_P
  have hrtwo : IsPGroup 2 (zpowers m.r) := by
    apply IsPGroup.of_card_dvd_pow (n := 1)
    rw [Nat.card_zpowers, pow_one]
    exact orderOf_dvd_of_pow_eq_one (by simpa only [pow_two] using m.r_sq)
  have hTtwo : IsPGroup 2 T := by
    exact hPtwo.to_sup_of_normal_left' hrtwo (zpowers_le.mpr m.r_normalizes_P)
  let U := T.subgroupOf (Centralizer b)
  have hUtwo : IsPGroup 2 U := hTtwo.comap_subtype
  let π := QuotientGroup.mk' (Core b)
  obtain ⟨S, hUS⟩ := (hUtwo.map π).exists_le_sylow
  have hScard : Nat.card S = 2 := by
    rw [S.card_eq_multiplicity, hb.quotient_card]
    decide +kernel
  let rH : Centralizer b := ⟨m.r, hrH⟩
  let zH : Centralizer b := ⟨z, hPH m.z_mem_P⟩
  have hrS : π rH ∈ S := hUS (mem_map_of_mem π hTr)
  have hzS : π zH ∈ S := hUS (mem_map_of_mem π hTz)
  have hrne : (⟨π rH, hrS⟩ : S) ≠ 1 := by
    intro he
    have hm := (QuotientGroup.eq_one_iff rH).mp (congrArg Subtype.val he)
    exact hrQ (mem_map_of_mem (Centralizer b).subtype hm)
  have hzne : (⟨π zH, hzS⟩ : S) ≠ 1 := by
    intro he
    have hm := (QuotientGroup.eq_one_iff zH).mp (congrArg Subtype.val he)
    exact hzQ (mem_map_of_mem (Centralizer b).subtype hm)
  obtain ⟨w, _, hw⟩ := (Nat.card_eq_two_iff' (1 : S)).mp hScard
  have he : π rH = π zH := congrArg Subtype.val ((hw _ hrne).trans (hw _ hzne).symm)
  have hzsq : zH * zH = 1 := Subtype.ext (by
    change z * z = 1
    simpa only [h.involution, pow_two] using pow_orderOf_eq_one z)
  have hm : rH * zH ∈ Core b := (QuotientGroup.eq_one_iff _).mp (by
    change π (rH * zH) = 1
    rw [map_mul, he, ← map_mul, hzsq, map_one])
  exact mem_map_of_mem (Centralizer b).subtype hm

end CFSG.Quasithin.Extraspecial32.DegreeTwelve.ElevenSubgroup.NineNormalizer.MarkedCore

end
