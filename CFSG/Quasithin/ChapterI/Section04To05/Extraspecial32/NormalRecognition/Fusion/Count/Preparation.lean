module

public import CFSG.Quasithin.ChapterI.Section04To05.Extraspecial32.NormalRecognition.Defs
public import Theory.GroupTheory.PGroup.ExtraspecialIndexTwoTransport

/-!
# A necessary centralizer bound for core fusion

Write H = C_G(z) and Q for the literal core in G. If x lies in Q and is
conjugate to z, then C_H(x) is not contained in Q. Otherwise C_H(x) equals
C_Q(x), whose derived subgroup is the characteristic line generated by z.
Its ambient normalizer would fix z. The normalizer condition in a Sylow
two-subgroup of C_G(x) contradicts this, since C_H(x) has order at most 32
and those Sylow subgroups have order 64.

Since C_Q(x) has order at least 16, crossing Q forces |C_H(x)| at least 32.
This excludes the local orbit of length twelve without constructing Q ∩ Qᵍ.
The remaining local action calculation must show that the noncentral core
involutions satisfying this bound form one H-orbit of size six.

Source: M. Aschbacher, “A 2-local characterization of M12”, Illinois J.
Math. 47 (2003), 31–47, Lemmas 2.3–2.7. The characteristic-derived-subgroup
argument here replaces the intersection argument used to obtain 2.4(1).
-/

namespace CFSG.Quasithin.Extraspecial32

open Subgroup

variable {G : Type*} [Group G] {z : G}

namespace FusionCount

/-- The noncentral core involutions whose common centralizer with z has
order at least 32. Membership contains no ambient fusion assertion. -/
@[expose] public def countCandidates (z : G) : Set G :=
  {x | x ∈ coreInG z ∧ orderOf x = 2 ∧ x ≠ z ∧
    32 ≤ Nat.card (Centralizer z ⊓ Centralizer x : Subgroup G)}

end FusionCount

namespace Hypotheses

open FusionCount

variable [Finite G]

/-- Ambient fusion forces the common centralizer to cross the core. This
holds in both quaternion-normality branches. -/
public theorem common_centralizer_not_le_core_of_isConj (h : Hypotheses z)
    {x : G} (hx : x ∈ coreInG z) (hf : IsConj z x) :
    ¬ Centralizer z ⊓ Centralizer x ≤ coreInG z := by
  let Q := coreInG z
  let C := Centralizer z ⊓ Centralizer x
  let D := centralizer ({(⟨x, hx⟩ : Q)} : Set Q)
  let : IsExtraspecial 2 Q := h.coreInG_extraspecial
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  intro hCQ
  have hm : D.map Q.subtype = C := by
    rw [map_subtype_centralizer_singleton]
    exact le_antisymm (inf_le_inf_right _ (coreInG_le z)) (le_inf hCQ inf_le_right)
  have hd : (_root_.commutator C).map C.subtype = zpowers z := by
    rw [map_subtype_commutator, ← hm, ← map_commutator,
      ← map_subtype_commutator,
      IsExtraspecial.centralizer_commutator_image_eq_center_of_card_thirty_two
        h.coreInG_card,
      h.coreInG_center_image]
  have hN : normalizer (C : Set G) ≤ Centralizer z :=
    normalizer_le_centralizer_of_characteristic_involution C (_root_.commutator C)
      z h.involution hd
  have hpQ : IsPGroup 2 Q := IsPGroup.of_card (p := 2) (n := 5) h.coreInG_card
  have hpC : IsPGroup 2 C :=
    hpQ.of_injective (inclusion hCQ) (inclusion_injective hCQ)
  let S : Sylow 2 (Centralizer z) := Classical.choice inferInstance
  have hsmall : Nat.card C < Nat.card S := by
    have hle : Nat.card C ≤ Nat.card Q := card_le_of_le hCQ
    rw [h.coreInG_card] at hle
    rw [h.centralizer_sylow_two_card S]
    omega
  exact not_isConj_of_small_common_centralizer_normalizer z x hpC S hsmall hN hf

/-- The common centralizer of a core conjugate of z has order at least 32,
without any assumption on the normality of quaternion subgroups. -/
public theorem common_centralizer_card_ge_thirty_two_of_isConj (h : Hypotheses z)
    {x : G} (hx : x ∈ coreInG z) (hf : IsConj z x) :
    32 ≤ Nat.card (Centralizer z ⊓ Centralizer x : Subgroup G) := by
  let Q := coreInG z
  let C := Centralizer z ⊓ Centralizer x
  let D := centralizer ({(⟨x, hx⟩ : Q)} : Set Q)
  let K := Q.subgroupOf C
  let : IsExtraspecial 2 Q := h.coreInG_extraspecial
  have hD : 16 ≤ Nat.card D :=
    IsExtraspecial.centralizer_card_ge_sixteen_of_card_thirty_two h.coreInG_card _
  have hmD : D.map Q.subtype = Q ⊓ Centralizer x :=
    map_subtype_centralizer_singleton Q ⟨x, hx⟩
  have hmK : K.map C.subtype = Q ⊓ Centralizer x := by
    ext y
    constructor
    · rintro ⟨y, hy, rfl⟩
      exact ⟨hy, y.property.2⟩
    · rintro ⟨hyQ, hyC⟩
      exact ⟨⟨y, coreInG_le z hyQ, hyC⟩, hyQ, rfl⟩
  have hK : 16 ≤ Nat.card K := by
    rw [← card_map_of_injective C.subtype_injective, hmK, ← hmD,
      card_map_of_injective Q.subtype_injective]
    exact hD
  have hindex : 2 ≤ K.index := by
    have hn : K.index ≠ 1 := fun he =>
      h.common_centralizer_not_le_core_of_isConj hx hf (relIndex_eq_one.mp he)
    have hp : K.index ≠ 0 := index_ne_zero_of_finite
    omega
  have hcount := K.card_mul_index
  nlinarith [Nat.mul_le_mul hK hindex]

/-- Every noncentral core conjugate is among the candidates for the short
local orbit. The converse needs the local action calculation. -/
public theorem mem_countCandidates_of_isConj (h : Hypotheses z)
    {x : G} (hx : x ∈ coreInG z) (hf : IsConj z x) (hne : x ≠ z) :
    x ∈ countCandidates z := by
  refine ⟨hx, ?_, hne, h.common_centralizer_card_ge_thirty_two_of_isConj hx hf⟩
  obtain ⟨g, rfl⟩ := isConj_iff.mp hf
  exact ((MulAut.conj g).orderOf_eq z).trans h.involution

end Hypotheses
end CFSG.Quasithin.Extraspecial32
