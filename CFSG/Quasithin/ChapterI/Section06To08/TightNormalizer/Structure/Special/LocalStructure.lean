module

public import CFSG.Quasithin.ChapterI.Section06To08.TightNormalizer.Structure.Special.LocalStructure.FixedPoints
public import Theory.Frattini.BinarySquares
public import Theory.ElementaryAbelian.Join
/-!
# Internal structure of the special subgroup in I.7.7

For the actual escaping conjugate `B = Rʸ`, put `N = N_S(R)`,
`S₁ = S ∩ Kᵍ ∩ N_G(R)`, `U = N ⊔ B`, and `P = S₁ ⊔ B`.
The fixed-point calculation gives `C_N(a) = [N, ⟨a⟩] = S₁` for
nonidentity `a ∈ B`. It follows that the center, derived subgroup and
Frattini subgroup of `U` all coincide with the copy of `S₁` inside `U`.
The center is elementary abelian, and its image under the literal inclusion
`U → G` is `S₁`.

Write an element of `U` as `n*b`. Since both factors have exponent two,
its square is `[n,b] ∈ S₁`. The Frattini subgroup of a finite two-group is
generated by squares, which proves the Frattini assertion. If `n*b` has
square one and `b ≠ 1`, then `n ∈ C_N(b) = S₁`. Thus the elements of square
one lie in `N ∪ P`. A subgroup contained in the union of two subgroups lies
in one of them, giving the exhaustive elementary-subgroup statement.

The two elementary-subgroup exports supply the explicit local premises of
`Special.Closure`; the parent retains the normal-closure and index-two assembly.
No specialness or elementary-subgroup conclusion is assumed here.

Source: Aschbacher--Smith, *The Classification of Quasithin Groups*, combined
1 March 2004 manuscript, I.7.7, printed p.428 (PDF p.439).
-/

open Subgroup
open scoped IsMulCommutative commutatorElement Pointwise
variable {G : Type*} [Group G] [Finite G]

private theorem binary_split_structure (N B Z : Subgroup G)
    [IsElementaryAbelian 2 N] [IsElementaryAbelian 2 B]
    (hn : B ≤ normalizer (N : Set G)) (hz : Z ≤ N)
    (hproper : ¬ N ≤ Z) (hb : B ≠ ⊥)
    (hfixed : ∀ a ∈ B, a ≠ 1 → N ⊓ centralizer ({a} : Set G) = Z)
    (hcomm : ∀ a ∈ B, a ≠ 1 → ⁅N, zpowers a⁆ = Z)
    (hp : IsPGroup 2 ↥(N ⊔ B)) :
    (center ↥(N ⊔ B)).map (N ⊔ B).subtype = Z ∧
    (_root_.commutator ↥(N ⊔ B)).map (N ⊔ B).subtype = Z ∧
    (frattini ↥(N ⊔ B)).map (N ⊔ B).subtype = Z ∧
    IsElementaryAbelian 2 ↥(Z ⊔ B) ∧
    (∀ x ∈ N ⊔ B, x ^ 2 = 1 → x ∈ N ∨ x ∈ Z ⊔ B) := by
  let U := N ⊔ B
  have hNU : N ≤ U := le_sup_left
  have hBU : B ≤ U := le_sup_right
  have hZU : Z ≤ U := hz.trans hNU
  have hdecomp (x : G) (hx : x ∈ U) : ∃ n ∈ N, ∃ b ∈ B, n * b = x := by
    have hx' : x ∈ (N : Set G) * (B : Set G) := by
      rw [← coe_mul_of_right_le_normalizer_left N B hn]
      exact hx
    exact hx'
  have hNcomm (n m : G) (hn : n ∈ N) (hm : m ∈ N) : n * m = m * n :=
    congrArg Subtype.val (mul_comm (⟨n,hn⟩ : N) (⟨m,hm⟩ : N))
  have hcentral : Z ≤ centralizer (U : Set G) := by
    intro z hzZ
    have hUc : U ≤ centralizer ({z} : Set G) := by
      apply sup_le
      · intro n hn
        apply mem_centralizer_iff.mpr
        intro t ht
        have ht : t = z := Set.mem_singleton_iff.mp ht
        subst t
        exact hNcomm z n (hz hzZ) hn
      · intro b hbB
        apply mem_centralizer_iff.mpr
        intro t ht
        have ht : t = z := Set.mem_singleton_iff.mp ht
        subst t
        by_cases hbone : b = 1
        · simp [hbone]
        · have hzf : z ∈ N ⊓ centralizer ({b} : Set G) := (hfixed b hbB hbone).symm ▸ hzZ
          exact (hzf.2 b (Set.mem_singleton _)).symm
    intro x hxU
    exact (hUc hxU z (Set.mem_singleton _)).symm
  have hmapcenter : (center U).map U.subtype = Z := by
    apply le_antisymm
    · rintro x ⟨u, hu, rfl⟩
      have huc (v : G) (hv : v ∈ U) : v * (u : G) = (u : G) * v :=
        congrArg Subtype.val (mem_center_iff.mp hu (⟨v,hv⟩ : U))
      obtain ⟨n, hnN, b, hbB, he⟩ := hdecomp u u.property
      have hbone : b = 1 := by
        by_contra hbne
        apply hproper
        intro m hm
        rw [← hfixed b hbB hbne]
        refine ⟨hm, ?_⟩
        apply mem_centralizer_iff.mpr
        intro t ht
        have ht : t = b := Set.mem_singleton_iff.mp ht
        subst t
        have hc := huc m (hNU hm)
        rw [← he, ← mul_assoc, hNcomm m n hm hnN, mul_assoc, mul_assoc] at hc
        exact (mul_left_cancel hc).symm
      have huN : (u : G) ∈ N := by
        have hnu : n = (u : G) := by simpa only [hbone, mul_one] using he
        exact hnu ▸ hnN
      obtain ⟨a, ha⟩ := ne_bot_iff_exists_ne_one.mp hb
      rw [← hfixed a a.property (fun he => ha (Subtype.ext he))]
      refine ⟨huN, ?_⟩
      apply mem_centralizer_iff.mpr
      intro t ht
      have ht : t = (a : G) := Set.mem_singleton_iff.mp ht
      subst t
      exact huc a (hBU a.property)
    · intro z hzZ
      refine ⟨⟨z,hZU hzZ⟩, ?_, rfl⟩
      apply mem_center_iff.mpr
      intro u
      apply Subtype.ext
      exact hcentral hzZ u u.property
  have hcross (n b : G) (hnN : n ∈ N) (hbB : b ∈ B) : ⁅n,b⁆ ∈ Z := by
    by_cases hbne : b = 1
    · simp [hbne]
    · rw [← hcomm b hbB hbne]
      exact commutator_mem_commutator hnN (mem_zpowers b)
  have hsquare (n b : G) (hnN : n ∈ N) (hbB : b ∈ B) : (n*b)^2 = ⁅n,b⁆ := by
    have hni : n⁻¹ = n := (inv_eq_iff_mul_eq_one.mpr (by
      simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) n hnN))
    have hbi : b⁻¹ = b := (inv_eq_iff_mul_eq_one.mpr (by
      simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) b hbB))
    simp only [commutatorElement_def, hni, hbi, pow_two, mul_assoc]
  have hfrattini : frattini U ≤ Z.subgroupOf U := by
    rw [hp.frattini_eq_closure_squares, closure_le]
    rintro _ ⟨x, rfl⟩
    change (x : G)^2 ∈ Z
    obtain ⟨n, hnN, b, hbB, he⟩ := hdecomp x x.property
    rw [← he, hsquare n b hnN hbB]
    exact hcross n b hnN hbB
  let : Fact (IsPGroup 2 U) := ⟨hp⟩
  have hcf : _root_.commutator U ≤ frattini U := commutator_le_frattini_of_isPGroup (p := 2)
  have hzc : Z ≤ (_root_.commutator U).map U.subtype := by
    obtain ⟨a, ha⟩ := ne_bot_iff_exists_ne_one.mp hb
    rw [map_subtype_commutator, ← hcomm a a.property (fun he => ha (Subtype.ext he))]
    exact commutator_mono hNU (zpowers_le.mpr (hBU a.property))
  have hmapphi : (frattini U).map U.subtype = Z := by
    apply le_antisymm
    · exact (map_mono hfrattini).trans_eq (map_subgroupOf_eq_of_le hZU)
    · exact hzc.trans (map_mono hcf)
  have hmapcomm : (_root_.commutator U).map U.subtype = Z :=
    le_antisymm ((map_mono hcf).trans_eq hmapphi) hzc
  have hZelem : IsElementaryAbelian 2 Z := by
    let : IsMulCommutative Z := ⟨⟨fun x y => Subtype.ext
      (hNcomm x y (hz x.property) (hz y.property))⟩⟩
    refine ⟨Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr ?_⟩
    intro z
    apply Subtype.ext
    exact elemPow_eq_one_of_isElementaryAbelian _ (hz z.property)
  let := hZelem
  refine ⟨hmapcenter, hmapcomm, hmapphi, ?_, ?_⟩
  · apply IsElementaryAbelian.sup_of_le_centralizer
    intro b hbB z hzZ
    exact (hcentral hzZ b (hBU hbB)).symm
  · intro x hxU hx2
    obtain ⟨n, hnN, b, hbB, rfl⟩ := hdecomp x hxU
    by_cases hbne : b = 1
    · left
      simpa only [hbne, mul_one] using hnN
    · right
      have hnZ : n ∈ Z := by
        rw [← hfixed b hbB hbne]
        refine ⟨hnN, ?_⟩
        apply mem_centralizer_iff.mpr
        intro t ht
        have ht : t = b := Set.mem_singleton_iff.mp ht
        subst t
        rw [hsquare n b hnN hbB] at hx2
        exact (commutatorElement_eq_one_iff_mul_comm.mp hx2).symm
      exact (Z ⊔ B).mul_mem ((le_sup_left : Z ≤ Z ⊔ B) hnZ) ((le_sup_right : B ≤ Z ⊔ B) hbB)

namespace CFSG.Quasithin.ChapterI.Section06To08.TightNormalizerSetup
variable {K : Subgroup G} {g : G} {R S : Subgroup G}
variable (h : TightNormalizerSetup K g R S) [IsElementaryAbelian 2 R]
include h
local notation "S₁" => ((S ⊓ conjSubgroup K g) ⊓ normalizer (R : Set G))
local notation "N" => (S ⊓ normalizer (R : Set G))

private theorem specialJoin_local_data
    (e : ↥S₁ ≃* R) {y : G}
    (hyN : conjSubgroup R y ≤ S ⊓ normalizer (N : Set G))
    (htriv : conjSubgroup R y ⊓ normalizer (R : Set G) = ⊥) :
    (center ↥(N ⊔ conjSubgroup R y)).map (N ⊔ conjSubgroup R y).subtype = S₁ ∧
    (_root_.commutator ↥(N ⊔ conjSubgroup R y)).map (N ⊔ conjSubgroup R y).subtype = S₁ ∧
    (frattini ↥(N ⊔ conjSubgroup R y)).map (N ⊔ conjSubgroup R y).subtype = S₁ ∧
    IsElementaryAbelian 2 ↥(S₁ ⊔ conjSubgroup R y) ∧
    (∀ x ∈ N ⊔ conjSubgroup R y, x ^ 2 = 1 → x ∈ N ∨ x ∈ S₁ ⊔ conjSubgroup R y) := by
  let : IsElementaryAbelian 2 ↥N := h.special_normalizer_elementary e
  let : IsElementaryAbelian 2 (conjSubgroup R y) :=
    IsElementaryAbelian.map (MulAut.conj y).toMonoidHom
  have hz : S₁ ≤ N := le_inf (inf_le_left.trans inf_le_left) inf_le_right
  have hproper : ¬ N ≤ S₁ := by
    intro hle
    have hc := card_le_of_le hle
    rw [h.special_normalizer_card e, Nat.card_congr e.toEquiv] at hc
    have hr := (one_lt_card_iff_ne_bot R).mpr h.hRne
    nlinarith
  have hb : conjSubgroup R y ≠ ⊥ := by
    intro he
    have hc := card_conjSubgroup R y
    rw [he, card_bot] at hc
    have hr := (one_lt_card_iff_ne_bot R).mpr h.hRne
    omega
  have hUS : N ⊔ conjSubgroup R y ≤ S := sup_le inf_le_left (hyN.trans inf_le_left)
  exact binary_split_structure N (conjSubgroup R y) S₁ (hyN.trans inf_le_right) hz hproper hb
    (fun a ha hne => (h.special_fixed_commutator_eq_intersection e hyN htriv
      ⟨a,ha⟩ (fun he => hne (congrArg Subtype.val he))).1)
    (fun a ha hne => (h.special_fixed_commutator_eq_intersection e hyN htriv
      ⟨a,ha⟩ (fun he => hne (congrArg Subtype.val he))).2)
    (h.hSp.of_injective (inclusion hUS) (inclusion_injective hUS))

/-- Every element of square one in the constructed `U` lies in `N` or `S₁ Rʸ`. -/
public theorem specialJoin_involution_mem
    (e : ↥S₁ ≃* R) {y : G}
    (hyN : conjSubgroup R y ≤ S ⊓ normalizer (N : Set G))
    (htriv : conjSubgroup R y ⊓ normalizer (R : Set G) = ⊥)
    {x : G} (hx : x ∈ N ⊔ conjSubgroup R y) (hx2 : x ^ 2 = 1) :
    x ∈ N ∨ x ∈ S₁ ⊔ conjSubgroup R y :=
  (h.specialJoin_local_data e hyN htriv).2.2.2.2 x hx hx2

/-- The two elementary abelian subgroups exhaust all elementary abelian
subgroups of the actual constructed join. This supplies the cover premise
of `specialJoin_closure_exhaustion`. -/
public theorem specialJoin_elementary_subgroup_le
    (e : ↥S₁ ≃* R) {y : G}
    (hyN : conjSubgroup R y ≤ S ⊓ normalizer (N : Set G))
    (htriv : conjSubgroup R y ⊓ normalizer (R : Set G) = ⊥)
    (A : Subgroup G) (hA : IsElementaryAbelian 2 A)
    (hAU : A ≤ N ⊔ conjSubgroup R y) :
    A ≤ N ∨ A ≤ S₁ ⊔ conjSubgroup R y := by
  let := hA
  apply SubgroupClass.subset_union.mp
  intro x hx
  exact h.specialJoin_involution_mem e hyN htriv (hAU hx)
    (elemPow_eq_one_of_isElementaryAbelian x hx)

/-- The second maximal elementary subgroup in I.7.7 is elementary abelian.
This discharges the other local-structure premise of the closure argument. -/
public theorem specialJoin_second_elementary
    (e : ↥S₁ ≃* R) {y : G}
    (hyN : conjSubgroup R y ≤ S ⊓ normalizer (N : Set G))
    (htriv : conjSubgroup R y ⊓ normalizer (R : Set G) = ⊥) :
    IsElementaryAbelian 2 ↥(S₁ ⊔ conjSubgroup R y) :=
  (h.specialJoin_local_data e hyN htriv).2.2.2.1

/-- Under the literal ambient inclusion, the center of `U` is exactly `S₁`. -/
public theorem specialJoin_center_map
    (e : ↥S₁ ≃* R) {y : G}
    (hyN : conjSubgroup R y ≤ S ⊓ normalizer (N : Set G))
    (htriv : conjSubgroup R y ⊓ normalizer (R : Set G) = ⊥) :
    (center ↥(N ⊔ conjSubgroup R y)).map (N ⊔ conjSubgroup R y).subtype = S₁ :=
  (h.specialJoin_local_data e hyN htriv).1

/-- The center and derived subgroup of the constructed `U` coincide. -/
public theorem specialJoin_center_eq_commutator
    (e : ↥S₁ ≃* R) {y : G}
    (hyN : conjSubgroup R y ≤ S ⊓ normalizer (N : Set G))
    (htriv : conjSubgroup R y ⊓ normalizer (R : Set G) = ⊥) :
    center ↥(N ⊔ conjSubgroup R y) = _root_.commutator ↥(N ⊔ conjSubgroup R y) := by
  obtain ⟨hc, hd, _⟩ := h.specialJoin_local_data e hyN htriv
  exact map_subtype_inj.mp (hc.trans hd.symm)

/-- The derived and Frattini subgroups of the constructed `U` coincide. -/
public theorem specialJoin_commutator_eq_frattini
    (e : ↥S₁ ≃* R) {y : G}
    (hyN : conjSubgroup R y ≤ S ⊓ normalizer (N : Set G))
    (htriv : conjSubgroup R y ⊓ normalizer (R : Set G) = ⊥) :
    _root_.commutator ↥(N ⊔ conjSubgroup R y) = frattini ↥(N ⊔ conjSubgroup R y) := by
  obtain ⟨_, hd, hf, _⟩ := h.specialJoin_local_data e hyN htriv
  exact map_subtype_inj.mp (hd.trans hf.symm)

/-- The common center, derived subgroup and Frattini subgroup of `U` is
an elementary abelian two-group. -/
public theorem specialJoin_center_elementary
    (e : ↥S₁ ≃* R) {y : G}
    (hyN : conjSubgroup R y ≤ S ⊓ normalizer (N : Set G))
    (htriv : conjSubgroup R y ⊓ normalizer (R : Set G) = ⊥) :
    IsElementaryAbelian 2 (center ↥(N ⊔ conjSubgroup R y)) := by
  let U := N ⊔ conjSubgroup R y
  let : IsElementaryAbelian 2 ↥N := h.special_normalizer_elementary e
  have hc : (center U).map U.subtype = S₁ := h.specialJoin_center_map e hyN htriv
  refine ⟨Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr ?_⟩
  intro z
  apply Subtype.ext
  apply Subtype.ext
  have hz : ((z : U) : G) ∈ S₁ := hc ▸ (show ((z : U) : G) ∈ (center U).map U.subtype from
    ⟨z, z.property, rfl⟩)
  exact elemPow_eq_one_of_isElementaryAbelian _ (show ((z : U) : G) ∈ N from ⟨hz.1.1, hz.2⟩)

end CFSG.Quasithin.ChapterI.Section06To08.TightNormalizerSetup
