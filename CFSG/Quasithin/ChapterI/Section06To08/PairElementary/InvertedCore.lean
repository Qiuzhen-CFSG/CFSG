module
public import CFSG.Quasithin.ChapterI.Section06To08.PairElementary.FullAxis
public import CFSG.Quasithin.ChapterI.Section06To08.TIConjugates
public import Theory.GroupTheory.ElementaryConjugatePrimePair
public import Theory.GroupTheory.CharacteristicCentralizerFusion
public import Theory.GroupTheory.Commutator.FixedPointFree

public import Theory.GroupTheory.DihedralGeneratedFactor
public import Theory.GroupTheory.SpecificGroups.OddDihedralAction
public import Theory.GroupTheory.ConjugatePairSeed.Generators

/-!
# The two-core of an inverted odd-prime TI pair

For an elementary abelian TI subgroup V and an odd-prime element g inverted
by v in V, the two mutual normalizers form a module Y. Its two conjugate
axes generate Y; the rotation has no fixed points, and its commutator is Y.
The commutator and centralizer for V are exactly the first axis.

When the first axis has index two in V, the pair is Y times the dihedral
subgroup generated by g and v. The quotient is that actual odd dihedral
group, whose two-core is trivial. Thus Y is the literal two-core of the
pair. This supplies the I.6.2 input used in the construction after 12.2.21.
Source: Aschbacher–Smith, printed pp.424–425 and 802–803.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.ChapterI.Section06To08
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
/-- The two mutual normalizers meet the original factor in its own normalizer. -/
theorem ti_pair_mutual_module_inf_left (V A : Subgroup G) (hd : Disjoint V A) :
    ((V ⊓ normalizer (A : Set G)) ⊔ (A ⊓ normalizer (V : Set G))) ⊓ V =
      V ⊓ normalizer (A : Set G) := by
  apply le_antisymm
  · intro x hx
    obtain ⟨e, he⟩ := ti_pair_mutual_normalizers_mulEquiv V A hd
    obtain ⟨⟨u, b⟩, hab⟩ := e.surjective ⟨x, hx.1⟩
    have hprod : (u : G) * (b : G) = x := (he u b).symm.trans (congrArg Subtype.val hab)
    have hbV : (b : G) ∈ V := by
      have hm := V.mul_mem (V.inv_mem u.property.1) hx.2
      rwa [← hprod, inv_mul_cancel_left] at hm
    have hb1 : (b : G) = 1 := hd.le_bot ⟨hbV, b.property.1⟩
    rw [hb1, mul_one] at hprod
    exact hprod ▸ u.property
  · exact le_inf le_sup_left inf_le_left

/-- For an inverted odd conjugator, the actual mutual-normalizer module is the
sum of two conjugate axes, has no fixed rotation points, and is fully moved. -/
theorem ti_inverted_pair_module (V : Subgroup G) [IsElementaryAbelian 2 V]
    (hTI : IsTISubgroup V) (g v : G) (ho : Odd (orderOf g)) (hg : g ≠ 1)
    (hv : v ∈ V) (hinv : v * g * v⁻¹ = g⁻¹)
    (hd : Disjoint V (V.map (MulAut.conj g).toMonoidHom)) :
    let A := V.map (MulAut.conj g).toMonoidHom
    let Y := (V ⊓ normalizer (A : Set G)) ⊔ (A ⊓ normalizer (V : Set G))
    Y = (Y ⊓ V) ⊔ (Y ⊓ V).map (MulAut.conj g).toMonoidHom ∧
      Y ⊓ centralizer (zpowers g : Set G) = ⊥ ∧ ⁅Y, zpowers g⁆ = Y ∧
      ⁅Y, V⁆ = Y ⊓ V ∧ Y ⊓ centralizer (V : Set G) = Y ⊓ V ∧ v ∉ Y := by
  let A := V.map (MulAut.conj g).toMonoidHom
  let N := V ⊓ normalizer (A : Set G)
  let B := A ⊓ normalizer (V : Set G)
  let Y := N ⊔ B
  let I := V ⊔ A
  let : IsElementaryAbelian 2 A := IsElementaryAbelian.map _
  have hcard : Nat.card V = Nat.card A := (card_map_of_injective (MulAut.conj g).injective).symm
  have hYN : Y ⊓ V = N := ti_pair_mutual_module_inf_left V A hd
  have hYB : Y ⊓ A = B := by
    simpa only [Y, N, B, sup_comm] using ti_pair_mutual_module_inf_left A V hd.symm
  have hIY : I ≤ normalizer (Y : Set G) := ti_pair_sup_le_normalizer V A hd hTI (hTI.map_equiv _)
  have hgI : g ∈ I := by
    change g ∈ V ⊔ V.map (MulAut.conj g).toMonoidHom
    rw [conjugate_join_eq_cyclic_sup V g v hv ho hinv]
    exact mem_sup_left (mem_zpowers g)
  have hgY : Y.map (MulAut.conj g).toMonoidHom = Y :=
    mem_normalizer_iff_map_conj_eq.mp (hIY hgI)
  have hNY : N.map (MulAut.conj g).toMonoidHom = B := by
    rw [← hYN, map_inf _ _ _ (MulAut.conj g).injective, hgY]
    exact hYB
  have hY2 : IsPGroup 2 Y := (isPGroup_pCoreIn 2 I).to_le
    (ti_pair_mutual_normalizers_le_twoCore V A hd hTI (hTI.map_equiv _))
  have hgnotY : g ∉ Y := by
    intro hm
    obtain ⟨n, hn⟩ := hY2 ⟨g, hm⟩
    have hpow := congrArg Subtype.val hn
    exact hg (orderOf_eq_one_iff.mp (Nat.eq_one_of_dvd_coprimes
      (ho.coprime_two_right.pow_right n) dvd_rfl (orderOf_dvd_of_pow_eq_one hpow)))
  have hvN : v ∉ N := by
    intro hn
    have hconj : g * v * g⁻¹ ∈ Y :=
      (mem_normalizer_iff.mp (hIY hgI) v).mp (mem_sup_left hn)
    have he : (g * v * g⁻¹) * v⁻¹ = g^2 := by
      have hinv' : v * g⁻¹ * v⁻¹ = g := by
        simpa only [mul_inv_rev, inv_inv, mul_assoc] using congrArg Inv.inv hinv
      rw [mul_assoc g v, mul_assoc g, hinv', pow_two]
    have hsq : g^2 ∈ Y := he ▸ Y.mul_mem hconj (Y.inv_mem (mem_sup_left hn))
    exact hgnotY ((zpowers_le.mpr hsq)
      (mem_zpowers_pow_iff.mpr (Nat.coprime_two_left.mpr ho)))
  have hCv : Y ⊓ centralizer ({v} : Set G) = N := ti_pair_centralizer_eq V A hd (hTI.map_equiv _) hv hvN
  have hcomm : ⁅Y, V⁆ = N := le_antisymm
    (ti_pair_commutator_le_left V A hd (hTI.map_equiv _))
    ((ti_pair_commutator_eq V A hd hTI (hTI.map_equiv _) hcard hv hvN).symm.le.trans
      (commutator_mono le_rfl (zpowers_le.mpr hv)))
  let C := Y ⊓ centralizer (zpowers g : Set G)
  have hCN : C ⊓ N = ⊥ := by
    apply bot_unique
    intro x hx
    have hfix : g * x * g⁻¹ = x :=
      mul_inv_eq_iff_eq_mul.mpr (hx.1.2 g (mem_zpowers g))
    have hxA : x ∈ A := by
      rw [← hfix]
      exact mem_map_of_mem (MulAut.conj g).toMonoidHom hx.2.1
    exact hd.le_bot ⟨hx.2.1, hxA⟩
  have hvZ : v ∈ normalizer (zpowers g : Set G) := by
    rw [mem_normalizer_iff_map_conj_eq, MonoidHom.map_zpowers]
    change zpowers (v * g * v⁻¹) = zpowers g
    rw [hinv, zpowers_inv]
  have hvC : v ∈ normalizer (C : Set G) :=
    inf_normalizer_le_normalizer_inf ⟨hIY (mem_sup_left hv),
      normalizer_le_normalizer_centralizer _ hvZ⟩
  have hCcomm : ⁅C, zpowers v⁆ = ⊥ := by
    apply bot_unique
    rw [← hCN]
    exact le_inf (le_normalizer_iff_commutator_le_left.mp (zpowers_le.mpr hvC))
      ((commutator_mono inf_le_left (zpowers_le.mpr hv)).trans_eq hcomm)
  have hCleN : C ≤ N := by
    rw [← hCv]
    exact le_inf inf_le_left
      ((commutator_eq_bot_iff_le_centralizer.mp hCcomm).trans
        (centralizer_le (show ({v} : Set G) ⊆ (zpowers v : Set G) from
          fun x hx => (Set.mem_singleton_iff.mp hx) ▸ mem_zpowers v)))
  have hC : C = ⊥ := bot_unique ((le_inf le_rfl hCleN).trans_eq hCN)
  refine ⟨?_, hC, ?_, hcomm.trans hYN.symm, ?_, ?_⟩
  · rw [hYN, hNY]
  · apply commutator_eq_of_fixedPointFree Y (zpowers g) (zpowers_le.mpr (hIY hgI)) g (mem_zpowers g)
    intro x hx hcx
    apply mem_bot.mp
    rw [← hC]
    refine ⟨hx, ?_⟩
    rw [zpowers_eq_closure, centralizer_closure]
    exact mem_centralizer_singleton_iff.mpr hcx.symm
  · rw [hYN]
    apply le_antisymm
    · intro x hx
      rw [← hCv]
      exact ⟨hx.1, mem_centralizer_singleton_iff.mpr (hx.2 v hv).symm⟩
    · exact le_inf le_sup_left
        (inf_le_left.trans (le_centralizer_iff_isMulCommutative.mpr inferInstance))
  · intro hvY
    exact hvN (hYN ▸ (show v ∈ Y ⊓ V from ⟨hvY, hv⟩))
end CFSG.Quasithin.ChapterI.Section06To08

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory
open scoped Pointwise
namespace CFSG.Quasithin.ChapterI.Section06To08
variable {G : Type*} [Group G] [Finite G]

theorem ti_inverted_prime_pair_core
    (V : Subgroup G) [IsElementaryAbelian 2 V] (hTI : IsTISubgroup V)
    {p : ℕ} (hp : p.Prime) (ho : Odd p)
    (g v : G) (hg : orderOf g = p) (hv : v ∈ V) (hinv : v * g * v⁻¹ = g⁻¹)
    (hd : Disjoint V (V.map (MulAut.conj g).toMonoidHom))
    (hi : (normalizer (V.map (MulAut.conj g).toMonoidHom : Set G)).relIndex V = 2) :
    (V ⊔ V.map (MulAut.conj g).toMonoidHom).pCoreIn 2 =
      (V ⊓ normalizer (V.map (MulAut.conj g).toMonoidHom : Set G)) ⊔
        (V.map (MulAut.conj g).toMonoidHom ⊓ normalizer (V : Set G)) := by
  let A := V.map (MulAut.conj g).toMonoidHom
  let N := V ⊓ normalizer (A : Set G)
  let Y := N ⊔ (A ⊓ normalizer (V : Set G))
  let I := V ⊔ A
  let D := zpowers g ⊔ zpowers v
  let : IsElementaryAbelian 2 A := IsElementaryAbelian.map _
  have hgo : Odd (orderOf g) := hg.symm ▸ ho
  have hg1 : g ≠ 1 := by
    intro he
    apply hp.ne_one
    simpa only [he, orderOf_one] using hg.symm
  have hdata := ti_inverted_pair_module V hTI g v hgo hg1 hv hinv hd
  have hvY : v ∉ Y := hdata.2.2.2.2.2
  have hvN : v ∉ N := fun h => hvY (mem_sup_left h)
  have hYN : Y ⊓ V = N := ti_pair_mutual_module_inf_left V A hd
  have hYI : Y ≤ I := sup_le (inf_le_left.trans le_sup_left) (inf_le_left.trans le_sup_right)
  have hIY : I ≤ normalizer (Y : Set G) := ti_pair_sup_le_normalizer V A hd hTI (hTI.map_equiv _)
  have hYcore : Y ≤ I.pCoreIn 2 := ti_pair_mutual_normalizers_le_twoCore V A hd hTI (hTI.map_equiv _)
  have hY2 : IsPGroup 2 Y := (isPGroup_pCoreIn 2 I).to_le hYcore
  have hIgen : I = zpowers g ⊔ V := conjugate_join_eq_cyclic_sup V g v hv hgo hinv
  have hVgen : N ⊔ zpowers v = V := sup_zpowers_eq_of_relIndex_prime inf_le_left Nat.prime_two
    (by simpa only [N, inf_relIndex_left] using hi) hv hvN
  have hDI : D ≤ I := sup_le
    (hIgen.symm ▸ le_sup_left) ((zpowers_le.mpr hv).trans le_sup_left)
  have hgen : Y ⊔ D = I := by
    apply le_antisymm (sup_le hYI hDI)
    rw [hIgen, ← hVgen]
    exact sup_le (le_sup_left.trans le_sup_right)
      (sup_le (le_sup_left.trans le_sup_left) (le_sup_right.trans le_sup_right))
  have hv2 : v^2 = 1 := elemPow_eq_one_of_isElementaryAbelian (p := 2) v hv
  have hv1 : v ≠ 1 := fun he => hvY (he ▸ Y.one_mem)
  have hvorder : orderOf v = 2 := orderOf_eq_prime hv2 hv1
  have hvnotg : v ∉ zpowers g := by
    intro hm
    have hdv : orderOf v ∣ Nat.card (zpowers g) :=
      (Subgroup.orderOf_coe (⟨v, hm⟩ : zpowers g)) ▸ orderOf_dvd_natCard (⟨v, hm⟩ : zpowers g)
    rw [hvorder, Nat.card_zpowers, hg] at hdv
    exact ho.not_two_dvd_nat hdv
  obtain ⟨_, ⟨eD⟩⟩ := DihedralGroup.sup_zpowers_equiv_of_inversion hp.pos g v hg hv2 hvnotg hinv
  let Q := Y.subgroupOf I
  let : Q.Normal := normal_subgroupOf_of_le_normalizer hIY
  let q := QuotientGroup.mk' Q
  let f : D →* I ⧸ Q := q.comp (inclusion hDI)
  have hf2 : IsPGroup 2 f.ker := by
    have he : f.ker = Y.subgroupOf D := by
      ext x
      exact QuotientGroup.eq_one_iff (inclusion hDI x)
    rw [he]
    exact hY2.comap_subtype
  have hfi : Function.Injective f := odd_dihedral_injective_of_two_kernel ho hp.ne_one eD f hf2
  have hfs : Function.Surjective f := by
    intro z
    obtain ⟨i, rfl⟩ := QuotientGroup.mk'_surjective Q z
    have hprod : (i : G) ∈ (Y : Set G) * (D : Set G) := by
      rw [← coe_mul_of_right_le_normalizer_left Y D (hDI.trans hIY), hgen]
      exact i.property
    obtain ⟨y, hy, x, hx, he⟩ := hprod
    refine ⟨⟨x, hx⟩, ?_⟩
    have hi : i = (⟨y, hYI hy⟩ : I) * ⟨x, hDI hx⟩ := Subtype.ext he.symm
    change q ⟨x, hDI hx⟩ = q i
    rw [hi, map_mul, show q ⟨y, hYI hy⟩ = 1 from (QuotientGroup.eq_one_iff _).mpr hy, one_mul]
  let e : D ≃* I ⧸ Q := MulEquiv.ofBijective f ⟨hfi, hfs⟩
  have hcore : pCore 2 (I ⧸ Q) = ⊥ := odd_dihedral_twoCore_eq_bot ho hp.ne_one (e.symm.trans eD)
  have hmap : (pCore 2 I).map q ≤ pCore 2 (I ⧸ Q) :=
    le_sSup ⟨Subgroup.Normal.map inferInstance q (QuotientGroup.mk'_surjective Q),
      pCore_isPGroup.map q⟩
  rw [hcore] at hmap
  have hk : pCore 2 I ≤ Q := by
    have hle := (map_eq_bot_iff (pCore 2 I) (f := q)).mp (bot_unique hmap)
    simpa only [q, QuotientGroup.ker_mk'] using hle
  apply le_antisymm _ hYcore
  exact (map_mono (f := I.subtype) hk).trans_eq (map_subgroupOf_eq_of_le hYI)
end CFSG.Quasithin.ChapterI.Section06To08
