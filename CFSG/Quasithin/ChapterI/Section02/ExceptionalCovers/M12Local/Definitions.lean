module

public import CFSG.Quasithin.ChapterI.Section02.ExceptionalCovers.Definitions
public import Theory.LinearAlgebra.QuadraticForm.BinaryCubicOrbits
public import Theory.Mathieu.M12.SmallParabolicPair.CoverOrbitData

/-!
# Structural inputs for the M₁₂ double-cover square argument

The core here is literally O₂(O²(C_K(u))). The coordinates are its quotient
by its own center, and the square kernel is the actual cyclic subgroup
generated by the chosen fourth-orbit square. The equality for the center
retains the ambient Z(K), so subsequent double quotients use the source's
Z-bar rather than an unproved replacement by Z(R).

These are conditional structural contracts. Constructing them on a finite
quasisimple cover, realizing the cubic action and its fusion marks, and
constructing the retraction in the elementary branch remain obligations of
the cover proof. No existence or source theorem is asserted here.

Source: Aschbacher–Smith, I.2.2(5), printed pp.411–412 / PDF pp.422–423.
-/

@[expose] public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterI.Section02.ExceptionalCovers.M12Local
open Theory.LinearAlgebra.BinaryCubicOrbits
variable {K : Type*} [Group K]

structure SquareCoordinates (u : K) where
  coordinates : centralizerCore u →* Multiplicative Space
  coordinates_surjective : Function.Surjective coordinates
  coordinates_ker : coordinates.ker = center (centralizerCore u)
  root : centralizerCore u
  root_coordinates : (coordinates root).toAdd = rep 3
  ambient_center_le : center K ≤ centralizerCore u
  center_eq : center (centralizerCore u) =
    zpowers (root ^ 2) ⊔ (center K).subgroupOf (centralizerCore u)
  fourth_power : ∀ r : centralizerCore u, r ^ 4 = 1
  square_central : ∀ r : centralizerCore u, r ^ 2 ∈ center (centralizerCore u)
  quadratic : QuadraticForm (ZMod 2) Space
  invariant : ∀ v, quadratic (cubic v) = quadratic v
  square_kernel : ∀ r : centralizerCore u,
    quadratic (coordinates r).toAdd = 0 ↔ r ^ 2 ∈ zpowers (root ^ 2)
  square_over_u : ∀ r : centralizerCore u,
    QuotientGroup.mk' (center K) ((r : K) ^ 2) = QuotientGroup.mk' (center K) u ↔
      quaternionSquare (coordinates r).toAdd = 1
  noncentral_fusion : quadratic (rep 0) = quadratic (rep 1)
  central_lift : quadratic (rep 2) = 0

/-- Compatibility with the actual marked quotient model, needed when constructing
and transporting the binary extension. No centralizer is replaced by its order. -/
structure MarkedSquareCoordinates
    (e : (K ⧸ center K) ≃* Sporadic.Mathieu.M12) (u : K)
    (m : Sporadic.Mathieu.M12SmallPair.CoverOrbitData) extends SquareCoordinates u where
  quotient_mark : e (QuotientGroup.mk' (center K) u) = Sporadic.Mathieu.M12SmallPair.z
  cubic_lift : centralizerTwoResidual u
  cubic_lift_order : orderOf cubic_lift = 3
  cubic_lift_image : e (QuotientGroup.mk' (center K) (cubic_lift : K)) =
    Sporadic.Mathieu.M12SmallPair.cubicActor
  core_action : MulAut (centralizerCore u)
  core_action_apply : ∀ r : centralizerCore u,
    (core_action r : K) = (cubic_lift : K) * r * (cubic_lift : K)⁻¹
  cubic_equivariance : ∀ r : centralizerCore u,
    (coordinates (core_action r)).toAdd = cubic (coordinates r).toAdd
  core_image : ∀ r : centralizerCore u,
    e (QuotientGroup.mk' (center K) (r : K)) ∈ Sporadic.Mathieu.M12SmallPair.core
  coordinate_compatibility : ∀ r : centralizerCore u,
    m.coordinates ⟨e (QuotientGroup.mk' (center K) (r : K)), core_image r⟩ = coordinates r
  centralizer_image :
    (centralizer ({u} : Set K)).map (e.toMonoidHom.comp (QuotientGroup.mk' (center K))) =
      Sporadic.Mathieu.M12SmallPair.firstParabolic
  residual_image :
    (centralizerTwoResidual u).map (e.toMonoidHom.comp (QuotientGroup.mk' (center K))) =
      Sporadic.Mathieu.M12SmallPair.coverResidual

/-- The first clause of source restriction (i), stated for literal preimages.
The containment of the center is equivalent to being a full preimage. -/
def CentralCoverRestriction (K : Type*) [Group K] : Prop :=
  ∀ H : Subgroup K, center K ≤ H →
    ¬ 2 ∣ (H.map (QuotientGroup.mk' (center K))).index →
      center K ≤ (_root_.commutator H).map H.subtype

def centerToCentralizer (u : K) : center K →* centralizer ({u} : Set K) :=
  Subgroup.inclusion (by
    intro z hz
    exact mem_centralizer_singleton_iff.mpr ((mem_center_iff.mp hz u).symm))

structure CentralizerRetraction (u : K) where
  hom : centralizer ({u} : Set K) →* center K
  retracts : ∀ z : center K, hom (centerToCentralizer u z) = z

end CFSG.Quasithin.ChapterI.Section02.ExceptionalCovers.M12Local
