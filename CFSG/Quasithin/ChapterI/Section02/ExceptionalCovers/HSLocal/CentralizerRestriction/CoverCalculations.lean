module

public import CFSG.Quasithin.ChapterI.Section02.ExceptionalCovers.HSLocal.CentralizerRestriction.CoverStructure

/-!
# The HS cover core commutator and Frattini calculations

Every square in the core is either one or the distinguished involution v.
The two-group Frattini formula gives Φ(R)=⟨v⟩. Lifting the two quaternion
generators supplies a nontrivial commutator, hence [R,R]=⟨v⟩ as well.
In the ambient group, adjoining Z(K) gives exactly ⟨u⟩Z(K), as in the common
source paragraph. These calculations include all central elements of R.

Source: Aschbacher–Smith I.2.2(5), printed pp.411–412 / PDF pp.422–423.
-/

public section
open Subgroup Theory.GroupTheory
open scoped commutatorElement
open Theory.GroupTheory.DoubleCoverCentralizer
open Sporadic.LeechRelated.HS Sporadic.LeechRelated.HS.EvenLocalCandidates
open Sporadic.LeechRelated.HS.EvenLocalCandidates.CentralInvolutionCore
open CFSG.Quasithin.Chapter16.OtherPreliminaries.JankoTwoHigmanSims.HSInner
open CFSG.Quasithin.Chapter16.OtherPreliminaries.JankoTwoHigmanSims.HSInner.CoreStructure
namespace CFSG.Quasithin.ChapterI.Section02.ExceptionalCovers.HSLocal.CentralizerRestriction
variable {K : Type*} [Group K] [Finite K]

/-- The whole cover core has a single nontrivial square; its derived and
Frattini subgroups are precisely the line generated by that square. -/
theorem cover_core_square_structure
    (e : (K ⧸ center K) ≃* Carrier) (hZ : Nat.card (center K) = 2)
    (u : K) (hu : modelMap e u = e0) :
    ∃ v : centralizerCore u, orderOf v = 2 ∧ modelMap e v = e0 ∧
      _root_.commutator (centralizerCore u) = zpowers v ∧
      frattini (centralizerCore u) = zpowers v ∧
      ∀ r : centralizerCore u, r ^ 2 = 1 ∨ r ^ 2 = v := by
  classical
  obtain ⟨a,ha,haimage⟩ := exists_central_core_root e hZ u hu
  let v := a ^ 2
  have hvimage : modelMap e v = e0 := haimage.trans hu
  have hv2 : v ^ 2 = 1 := by
    apply Subtype.ext
    exact core_square_one_of_image_square_one e hZ u
      (by rw [hu]; exact central_involution_order) (hu.symm ▸ e0_twoCentral)
      v v.property (by rw [hvimage, ← central_involution_order, pow_orderOf_eq_one])
  have hvne : v ≠ 1 := by
    intro he
    have hh := hvimage
    rw [he,coe_one,map_one] at hh
    exact e0_nontrivial hh.symm
  have hvorder : orderOf v = 2 := orderOf_eq_prime hv2 hvne
  have hsquare (r : centralizerCore u) : r ^ 2 = 1 ∨ r ^ 2 = v := by
    have hr : modelMap e r ∈ centralizerCore e0 := by
      rw [← cover_core_image e hZ u hu]
      exact mem_map_of_mem _ r.property
    let s := markedCoreEquiv.symm ⟨modelMap e r,hr⟩
    have hsval : s.val.val = modelMap e r :=
      congrArg Subtype.val (markedCoreEquiv.apply_symm_apply ⟨modelMap e r,hr⟩)
    have hs := model_core_square_carrier s
    rw [hsval] at hs
    rcases hs with hs | hs
    · exact Or.inl (Subtype.ext (core_square_one_of_image_square_one e hZ u
        (by rw [hu]; exact central_involution_order) (hu.symm ▸ e0_twoCentral) r r.property hs))
    · right
      obtain ⟨w,hw,huniq⟩ := hasUniqueCoreSquareLift_of_central_root e hZ u
        (by rw [hu]; exact central_involution_order) (hu.symm ▸ e0_twoCentral) a ha haimage
      apply Subtype.ext
      apply (huniq _ ⟨e.injective (by simpa only [modelMap,map_pow,MonoidHom.comp_apply,
        MulEquiv.coe_toMonoidHom] using hs.trans hu.symm),r,r.property,rfl⟩).trans
      exact (huniq _ ⟨e.injective haimage,a,a.property,rfl⟩).symm
  have hclosure : closure (Set.range (fun r : centralizerCore u => r ^ 2)) = zpowers v := by
    apply le_antisymm
    · apply (closure_le _).mpr
      rintro _ ⟨r,rfl⟩
      change r ^ 2 ∈ zpowers v
      rcases hsquare r with h | h <;> rw [h]
      · exact one_mem _
      · exact mem_zpowers _
    · exact zpowers_le.mpr (subset_closure ⟨a,rfl⟩)
  have hD : _root_.commutator (centralizerCore u) ≤ zpowers v := by
    rw [← hclosure]
    exact commutator_le_closure_squares
  have lift (s : core) : ∃ r : centralizerCore u, modelMap e r = s.val.val := by
    have hs : s.val.val ∈ (centralizerCore u).map (modelMap e) := by
      rw [cover_core_image e hZ u hu,marked_centralizer_core_eq]
      exact mem_map_of_mem _ s.property
    obtain ⟨r,hr,he⟩ := mem_map.mp hs
    exact ⟨⟨r,hr⟩,he⟩
  obtain ⟨b,hb⟩ := lift leftI
  obtain ⟨c,hc⟩ := lift leftJ
  let d := ⁅b,c⁆
  have hd : d ∈ _root_.commutator (centralizerCore u) :=
    commutator_mem_commutator (mem_top _) (mem_top _)
  have hdimage : modelMap e d = e0 := by
    change (modelMap e).comp (centralizerCore u).subtype ⁅b,c⁆ = e0
    rw [map_commutatorElement]
    change ⁅modelMap e b,modelMap e c⁆ = e0
    rw [hb,hc]
    have hh : ⁅leftI,leftJ⁆ = commonInvolution := by decide +kernel
    exact (congrArg (fun x : core => x.val.val) hh).trans commonInvolution_eq_e0
  have hdor : d = 1 ∨ d = v := by
    have hm := hD hd
    rw [mem_zpowers_iff_mem_range_orderOf,hvorder] at hm
    obtain ⟨n,hn,he⟩ := Finset.mem_image.mp hm
    have hn2 := Finset.mem_range.mp hn
    have hn01 : n = 0 ∨ n = 1 := by omega
    rcases hn01 with rfl | rfl
    · exact Or.inl (by simpa only [pow_zero] using he.symm)
    · exact Or.inr (by simpa only [pow_one] using he.symm)
  have hdv : d = v := hdor.resolve_left (by
    intro he
    rw [he,coe_one,map_one] at hdimage
    exact e0_nontrivial hdimage.symm)
  have hderived : _root_.commutator (centralizerCore u) = zpowers v :=
    le_antisymm hD (zpowers_le.mpr (hdv ▸ hd))
  have hR : IsPGroup 2 (centralizerCore u) :=
    pCore_isPGroup.map (centralizerTwoResidual u).subtype
  exact ⟨v,hvorder,hvimage,hderived,(hR.frattini_eq_closure_squares).trans hclosure,hsquare⟩

/-- The common-source identities in K, for any two-central marking. -/
theorem twoCentral_commutator_frattini
    (e : (K ⧸ center K) ≃* Carrier) (hZ : Nat.card (center K) = 2)
    (u : K) (hu : orderOf (modelMap e u) = 2) (hc : TwoCentral (modelMap e u)) :
    ∃ v : centralizerCore u, orderOf v = 2 ∧
      QuotientGroup.mk' (center K) (v : K) = QuotientGroup.mk' (center K) u ∧
      _root_.commutator (centralizerCore u) = zpowers v ∧
      frattini (centralizerCore u) = zpowers v ∧
      (∀ r : centralizerCore u, r ^ 2 = 1 ∨ r ^ 2 = v) ∧
      ⁅centralizerCore u,centralizerCore u⁆ ⊔ center K = zpowers u ⊔ center K ∧
      (frattini (centralizerCore u)).map (centralizerCore u).subtype ⊔ center K =
        zpowers u ⊔ center K := by
  obtain ⟨g,hg⟩ := isConj_iff.mp ((twoCentral_iff_isConj_e0 _ hu).mp hc).symm
  let e' := e.trans (MulAut.conj g)
  have hmark : modelMap e' u = e0 := hg
  obtain ⟨v,hv,himage,hd,hf,hs⟩ := cover_core_square_structure e' hZ u hmark
  have hq : QuotientGroup.mk' (center K) (v : K) = QuotientGroup.mk' (center K) u :=
    e'.injective (himage.trans hmark.symm)
  have hjoin : zpowers (v : K) ⊔ center K = zpowers u ⊔ center K := by
    have hh : (zpowers (v : K)).map (QuotientGroup.mk' (center K)) =
        (zpowers u).map (QuotientGroup.mk' (center K)) := by
      rw [MonoidHom.map_zpowers,MonoidHom.map_zpowers,hq]
    have hh' := congrArg (fun S : Subgroup (K ⧸ center K) =>
      S.comap (QuotientGroup.mk' (center K))) hh
    simpa only [comap_map_eq,QuotientGroup.ker_mk'] using hh'
  refine ⟨v,hv,hq,hd,hf,hs,?_,?_⟩
  · rw [← map_subtype_commutator,hd,MonoidHom.map_zpowers]
    exact hjoin
  · rw [hf,MonoidHom.map_zpowers]
    exact hjoin

end CFSG.Quasithin.ChapterI.Section02.ExceptionalCovers.HSLocal.CentralizerRestriction
