module

public import Theory.GroupTheory.Commutator.TwoCoverComparison
public import GorensteinWalter.SL2ProjectiveCover
public import Theory.AtlasPort.ExceptionalIsomorphisms.Order168
public import Theory.SpecificGroups.GL2.ProjectiveFourGroupObstruction

/-!
# The central double-cover obstruction for SL₃(2)

The actual PSL₂(7)–SL₃(2) equivalence and the comparison of central two-covers
identify every finite perfect central double cover with SL₂(7). Its only
nonidentity involution is scalar, so every involution lies in the kernel.

Applied to H/[Q,H], this rules out disjointness of [Q,H] from a central
kernel Z of order two when Q=[Q,H]Z and H has an involution outside Q.
Both the quotient projection and its kernel order are constructed here.
No extension-recognition or multiplier hypothesis is assumed.

Source: the nonsplitting argument in Aschbacher–Smith I.2.2(5), printed
p.412 / PDF p.423. The comparison theorem uses central Sylow transfer.
-/

@[expose] public section

open Subgroup
local instance : Fact (Nat.Prime 7) := ⟨by decide⟩
namespace CFSG.Quasithin.ChapterI.Section02.ExceptionalCovers.HSLocal.Nonsplit
variable {H : Type*} [Group H] [Finite H] [Group.IsPerfect H]

theorem perfect_double_cover_equiv
    (f : H →* Matrix.SpecialLinearGroup (Fin 3) (ZMod 2))
    (hf : Function.Surjective f) (hc : f.ker ≤ center H)
    (hk : Nat.card f.ker = 2) :
    Nonempty (H ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod 7)) := by
  let e := Atlas.Comparisons.Exceptional.psl2SevenEquivSl3Two
  let q := e.symm.toMonoidHom.comp f
  have hq : Function.Surjective q := e.symm.surjective.comp hf
  have hqker : q.ker = f.ker :=
    MonoidHom.ker_comp_of_injective f e.symm.toMonoidHom e.symm.injective
  obtain ⟨hg, hgc, hgcard, hg2, hp, hd⟩ :=
    GorensteinWalter.sl2_projective_cover_model (ZMod 7)
      (by rw [Nat.card_zmod]; decide) (by rw [Nat.card_zmod]; decide)
  let : Group.IsPerfect (Matrix.SpecialLinearGroup (Fin 2) (ZMod 7)) := hp
  have hn : q.ker ⊓ _root_.commutator H ≠ ⊥ := by
    rw [Group.IsPerfect.commutator_eq_top, inf_top_eq, hqker]
    intro h
    have : Nat.card f.ker = 1 := by rw [h]; exact Nat.card_unique
    omega
  obtain ⟨a⟩ := CentralExtension.commutator_mulEquiv_of_central_two_covers
    q (GorensteinWalter.sl2ProjectiveProjection (ZMod 7)) hq hg
    (by rwa [hqker]) hgc
    (IsPGroup.of_card (n := 1) (by rw [hqker, hk, pow_one])) hg2 hn hgcard hd
  exact ⟨((MulEquiv.subgroupCongr Group.IsPerfect.commutator_eq_top).trans
    (Subgroup.topEquiv : (⊤ : Subgroup H) ≃* H)).symm.trans a⟩

private theorem sl2_square_one_cases (x : Matrix.SpecialLinearGroup (Fin 2) (ZMod 7))
    (hx : x ^ 2 = 1) : x = 1 ∨ x = -1 := by
  have hd : (Matrix.SpecialLinearGroup.toGL x).det = 1 := by
    apply Units.ext
    exact x.property
  rcases Matrix.GeneralLinearGroup.eq_one_or_neg_one_of_sq_eq_one_of_det_eq_one
    (by decide : (2 : ZMod 7) ≠ 0) (Matrix.SpecialLinearGroup.toGL x)
    (by rw [← map_pow, hx, map_one]) hd with h | h
  · exact Or.inl (Matrix.SpecialLinearGroup.toGL_injective (by simpa using h))
  · exact Or.inr (Subtype.ext (congrArg Units.val h))

/-- A lifted involution outside the kernel rules out a perfect central double
cover of the actual SL₃(2). The recognition is proved by comparison of covers. -/
theorem involution_mem_kernel
    (f : H →* Matrix.SpecialLinearGroup (Fin 3) (ZMod 2))
    (hf : Function.Surjective f) (hc : f.ker ≤ center H)
    (hk : Nat.card f.ker = 2) (x : H) (hx : x ^ 2 = 1) : x ∈ f.ker := by
  obtain ⟨a⟩ := perfect_double_cover_equiv f hf hc hk
  obtain ⟨z, hz⟩ := exists_prime_orderOf_dvd_card' (G := f.ker) 2 (by rw [hk])
  have hzs : (z : H) ^ 2 = 1 := congrArg Subtype.val
    (show z ^ 2 = 1 by simpa only [hz] using pow_orderOf_eq_one z)
  have hzne : a (z : H) ≠ 1 := by
    intro h
    have : z = 1 := Subtype.ext (a.injective (h.trans a.map_one.symm))
    simp [this] at hz
  have haz : a (z : H) = -1 :=
    (sl2_square_one_cases _ (by rw [← map_pow, hzs, map_one])).resolve_left hzne
  rcases sl2_square_one_cases (a x) (by rw [← map_pow, hx, map_one]) with h | h
  · exact (a.injective (h.trans a.map_one.symm)) ▸ f.ker.one_mem
  · exact (a.injective (h.trans haz.symm)).symm ▸ z.property

/-- If the core is generated by its commutators and a central involution,
an involution outside the core prevents that central factor from being
disjoint from the commutators. -/
theorem not_disjoint_commutator_center
    (Q Z : Subgroup H) [Q.Normal] (hZ : Z ≤ center H)
    (hZcard : Nat.card Z = 2) (hgen : ⁅Q, ⊤⁆ ⊔ Z = Q)
    (e : (H ⧸ Q) ≃* Matrix.SpecialLinearGroup (Fin 3) (ZMod 2))
    (x : H) (hx : x ^ 2 = 1) (hxQ : x ∉ Q) :
    ¬ Disjoint ⁅Q, ⊤⁆ Z := by
  intro hdis
  let D : Subgroup H := ⁅Q, ⊤⁆
  have hDQ : D ≤ Q := commutator_le_left _ _
  let p := QuotientGroup.mk' D
  let q : (H ⧸ D) →* (H ⧸ Q) :=
    QuotientGroup.map D Q (MonoidHom.id H) (by simpa only [comap_id] using hDQ)
  have hq : Function.Surjective q := by
    intro y
    obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective Q y
    exact ⟨p y, rfl⟩
  have hker : q.ker = Z.map p := by
    dsimp only [q]
    rw [QuotientGroup.ker_map, comap_id]
    change Q.map p = Z.map p
    rw [show Q.map p = (D ⊔ Z).map p from
      congrArg (fun U : Subgroup H => U.map p) hgen.symm, Subgroup.map_sup]
    have hD : D.map p = ⊥ := by
      apply le_bot_iff.mp
      rintro _ ⟨a, ha, rfl⟩
      exact (QuotientGroup.eq_one_iff a).mpr ha
    change D.map p ⊔ Z.map p = Z.map p
    rw [hD, bot_sup_eq]
  have hpZ : Function.Injective (p.subgroupMap Z) := by
    intro a b hab
    apply Subtype.ext
    apply div_eq_one.mp
    have hd : (a : H) / b ∈ D :=
      QuotientGroup.eq_iff_div_mem.mp (congrArg Subtype.val hab)
    exact hdis.le_bot ⟨hd, Z.div_mem a.property b.property⟩
  have hcard : Nat.card q.ker = 2 := by
    rw [hker, ← Nat.card_congr
      (MulEquiv.ofBijective (p.subgroupMap Z)
        ⟨hpZ, p.subgroupMap_surjective Z⟩).toEquiv]
    exact hZcard
  have hc : q.ker ≤ center (H ⧸ D) := by
    rw [hker]
    rintro _ ⟨z, hz, rfl⟩
    apply mem_center_iff.mpr
    intro y
    obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective D y
    simpa only [map_mul] using congrArg p (mem_center_iff.mp (hZ hz) y)
  let f := e.toMonoidHom.comp q
  have hfker : f.ker = q.ker :=
    MonoidHom.ker_comp_of_injective q e.toMonoidHom e.injective
  have hm := involution_mem_kernel f (e.surjective.comp hq)
    (by rwa [hfker]) (by rwa [hfker]) (p x)
    (by rw [← map_pow, hx, map_one])
  have hqx : q (p x) = 1 := by
    change p x ∈ f.ker at hm
    rwa [hfker] at hm
  exact hxQ ((QuotientGroup.eq_one_iff x).mp hqx)
end CFSG.Quasithin.ChapterI.Section02.ExceptionalCovers.HSLocal.Nonsplit
