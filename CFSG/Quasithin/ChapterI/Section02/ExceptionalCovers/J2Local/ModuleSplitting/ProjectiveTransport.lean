module

public import CFSG.Quasithin.ChapterI.Section02.ExceptionalCovers.J2Local.Restriction
public import CFSG.Quasithin.ChapterI.Section02.ExceptionalCovers.J2Local.ModuleSplitting.ElementaryQuotient
public import Theory.GroupTheory.DoubleCoverCentralizer.ProjectiveRadicalSplitting

/-!
# Projective splitting in the literal J₂ local cover

Apply the projective radical theorem to the preimage of the marked J₂
centralizer, its actual five-point A₅ map, and the subgroup generated by the
distinguished involution square. The square-orbit results give the elementary
quotient, centrality, independence from the covering kernel, and membership
in the intrinsic commutator. The restriction identifies that kernel with
the ambient center inside the preimage.

The explicit surjective radical map, its kernel, and its equivariance remain
the independent module-identification input. With those three properties,
the two literal subgroup conclusions needed by
`commutator_quotient_of_central_complement` follow without any further
splitting or recognition premise. This module does not import that assembly.

Source: Aschbacher–Smith I.2.2(5), printed pp.411–412 / PDF pp.422–423,
combined manuscript of 1 March 2004.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterI.Section02.ExceptionalCovers.J2Local
open Sporadic.LeechRelated.J2
open ExceptionalParabolics ExceptionalParabolics.Seed ExceptionalParabolics.FirstParabolic

variable {K : Type*} [Group K] [Finite K]
variable (e : (K ⧸ center K) ≃* Carrier) (hZ : Nat.card (center K) = 2)
variable [Group.IsPerfect (preimage e)]
variable (hex : ∃ r ∈ pCore 2 l₁, r ^ 2 = marked)
variable (horbit : ∀ r ∈ pCore 2 l₁, ∀ s ∈ pCore 2 l₁,
  r ^ 2 = marked → s ^ 2 = marked → IsConj r s)

/-- The concrete equivariant radical map discharges the central-splitting
premises of the subsequent SL₂(5) recognition step. -/
theorem core_central_complement_of_module_map
    (b : pCore 2 (preimage e) →* Multiplicative (BinaryPermutation.core (Fin 5)))
    (hb : Function.Surjective b)
    (hbker : b.ker = (squareSubgroup e hZ hex horbit ⊔
      (center K).subgroupOf (preimage e)).subgroupOf (pCore 2 (preimage e)))
    (hbe : ∀ h : preimage e, ∀ r : pCore 2 (preimage e),
      (b (MulAut.conjNormal h r)).toAdd =
        BinaryPermutation.alternatingCoreRepresentation (Fin 5) (a5Action e h) (b r).toAdd) :
    pCore 2 (preimage e) =
      ⁅pCore 2 (preimage e), (⊤ : Subgroup (preimage e))⁆ ⊔
        (center K).subgroupOf (preimage e) ∧
    Disjoint ⁅pCore 2 (preimage e), (⊤ : Subgroup (preimage e))⁆
      ((center K).subgroupOf (preimage e)) := by
  let := core_quotient_elementary e hZ hex horbit
  have hc : (center K).subgroupOf (preimage e) ≤ center (preimage e) := by
    rw [← restriction_ker]
    exact restriction_ker_central e
  have hZR : (center K).subgroupOf (preimage e) ≤ pCore 2 (preimage e) := by
    rw [← restriction_ker, ← core_preimage e hZ]
    intro x hx
    change restriction e x ∈ pCore 2 l₁
    rw [MonoidHom.mem_ker.mp hx]
    exact one_mem _
  have hVD : squareSubgroup e hZ hex horbit ≤
      ⁅pCore 2 (preimage e), (⊤ : Subgroup (preimage e))⁆ :=
    zpowers_le.mpr (distinguishedSquare_mem_commutator e hZ hex horbit)
  have hVZ : Disjoint (squareSubgroup e hZ hex horbit)
      ((center K).subgroupOf (preimage e)) := by
    rw [← restriction_ker]
    exact squareSubgroup_disjoint_kernel e hZ hex horbit
  exact ProjectiveRadicalSplitting.radical_splitting
    (pCore 2 (preimage e)) (squareSubgroup e hZ hex horbit)
    ((center K).subgroupOf (preimage e)) (a5Action e) (a5Action_surjective e)
    (a5Action_ker e hZ) (squareSubgroup_le_center e hZ hex horbit) hc hZR hVD hVZ
    b hb hbker hbe

end CFSG.Quasithin.ChapterI.Section02.ExceptionalCovers.J2Local
