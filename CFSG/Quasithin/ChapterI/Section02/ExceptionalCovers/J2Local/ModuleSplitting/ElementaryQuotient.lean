module

public import CFSG.Quasithin.ChapterI.Section02.ExceptionalCovers.J2Local.Restriction
public import Theory.GroupTheory.DoubleCoverCentralizer.SquareGenerators
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.ExceptionalParabolics.FirstParabolic.RadicalSquareGenerators
public import Theory.GroupAction.Quotient

/-!
# The elementary quotient in the J₂ local double cover

The nonempty quotient square-root orbit constructs a distinguished involution
square in the perfect local cover. Four checked square-root generators of
the actual radical, and their pairwise products, then show that dividing
by this square makes the whole two-core elementary abelian. All maps are
the literal restrictions of the central quotient of the ambient group.

The identification of the conjugation module, its projective splitting,
and recognition of the commutator quotient as SL₂(5) remain separate
mathematical obligations; they are not assumptions of the results here.
Perfection of the local preimage and the quotient square-root orbit are
the explicit inputs supplied by the independent orbit branch.

Source: Aschbacher--Smith I.2.2(5), printed pp.411--412 / PDF pp.422--423,
combined manuscript of 1 March 2004.
-/

@[expose] public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterI.Section02.ExceptionalCovers.J2Local
open Sporadic.LeechRelated.J2
open ExceptionalParabolics ExceptionalParabolics.Seed ExceptionalParabolics.FirstParabolic
variable {K : Type*} [Group K] [Finite K]
variable (e : (K ⧸ center K) ≃* Carrier) (hZ : Nat.card (center K) = 2)
variable [Group.IsPerfect (preimage e)]
variable (hex : ∃ r ∈ pCore 2 l₁, r ^ 2 = marked)
variable (horbit : ∀ r ∈ pCore 2 l₁, ∀ s ∈ pCore 2 l₁,
  r ^ 2 = marked → s ^ 2 = marked → IsConj r s)

/-- The involution square constructed from the nonempty orbit downstairs. -/
noncomputable def distinguishedSquare : preimage e :=
  ((perfectRestriction e).core_square_order_two
    (restriction_kernel_two_group e hZ) (restriction_kernel_exponent_two e hZ)
    marked marked_central marked_order hex horbit).choose

theorem distinguishedSquare_spec :
    orderOf (distinguishedSquare e hZ hex horbit) = 2 ∧
    restriction e (distinguishedSquare e hZ hex horbit) = marked ∧
    (∃ x ∈ pCore 2 (preimage e), x ^ 2 = distinguishedSquare e hZ hex horbit) ∧
    ∀ w : preimage e, restriction e w = marked →
      (∃ x ∈ pCore 2 (preimage e), x ^ 2 = w) →
        w = distinguishedSquare e hZ hex horbit :=
  ((perfectRestriction e).core_square_order_two
    (restriction_kernel_two_group e hZ) (restriction_kernel_exponent_two e hZ)
    marked marked_central marked_order hex horbit).choose_spec

theorem distinguishedSquare_central :
    distinguishedSquare e hZ hex horbit ∈ center (preimage e) := by
  rw [← (perfectRestriction e).comap_center]
  change restriction e (distinguishedSquare e hZ hex horbit) ∈ center l₁
  rw [(distinguishedSquare_spec e hZ hex horbit).2.1]
  exact marked_central

theorem distinguishedSquare_mem_core :
    distinguishedSquare e hZ hex horbit ∈ pCore 2 (preimage e) := by
  obtain ⟨x, hx, he⟩ := (distinguishedSquare_spec e hZ hex horbit).2.2.1
  exact he ▸ (pCore 2 (preimage e)).pow_mem hx 2

/-- The central order-two subgroup generated by the distinguished square. -/
noncomputable def squareSubgroup : Subgroup (preimage e) :=
  zpowers (distinguishedSquare e hZ hex horbit)

theorem squareSubgroup_le_center : squareSubgroup e hZ hex horbit ≤ center (preimage e) :=
  zpowers_le.mpr (distinguishedSquare_central e hZ hex horbit)

instance squareSubgroup_normal : (squareSubgroup e hZ hex horbit).Normal where
  conj_mem x hx g := by
    rw [mem_center_iff.mp (squareSubgroup_le_center e hZ hex horbit hx) g]
    simpa using hx

theorem squareSubgroup_le_core : squareSubgroup e hZ hex horbit ≤ pCore 2 (preimage e) :=
  zpowers_le.mpr (distinguishedSquare_mem_core e hZ hex horbit)

theorem squareSubgroup_card : Nat.card (squareSubgroup e hZ hex horbit) = 2 := by
  rw [squareSubgroup, Nat.card_zpowers]
  exact (distinguishedSquare_spec e hZ hex horbit).1

/-- The distinguished square and the original covering kernel are independent. -/
theorem squareSubgroup_disjoint_kernel :
    Disjoint (squareSubgroup e hZ hex horbit) (restriction e).ker := by
  classical
  apply disjoint_iff.mpr
  apply eq_bot_iff.mpr
  rintro x ⟨hx, hk⟩
  change x ∈ zpowers (distinguishedSquare e hZ hex horbit) at hx
  rw [mem_zpowers_iff_mem_range_orderOf,
    (distinguishedSquare_spec e hZ hex horbit).1] at hx
  obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hx
  have hn2 : n < 2 := Finset.mem_range.mp hn
  interval_cases n
  · simp
  · simp only [pow_one] at hk ⊢
    have hm : marked = 1 :=
      (distinguishedSquare_spec e hZ hex horbit).2.1.symm.trans (MonoidHom.mem_ker.mp hk)
    have ho := marked_order
    simp [hm] at ho

/-- Lifts of the four fixed radical generators through the actual restriction. -/
noncomputable def squareGeneratorLift (i : Fin 4) : preimage e :=
  (restriction_surjective e (squareGenerator i)).choose

omit [Finite K] [Group.IsPerfect (preimage e)] in
theorem restriction_squareGeneratorLift (i : Fin 4) :
    restriction e (squareGeneratorLift e i) = squareGenerator i :=
  (restriction_surjective e (squareGenerator i)).choose_spec

include hZ in
omit [Group.IsPerfect (preimage e)] in
theorem squareGeneratorLift_mem_core (i : Fin 4) :
    squareGeneratorLift e i ∈ pCore 2 (preimage e) := by
  rw [← core_preimage e hZ]
  change restriction e (squareGeneratorLift e i) ∈ pCore 2 l₁
  rw [restriction_squareGeneratorLift]
  exact squareGenerator_mem_core i

theorem squareGeneratorLift_square (i : Fin 4) :
    squareGeneratorLift e i ^ 2 = distinguishedSquare e hZ hex horbit := by
  apply (distinguishedSquare_spec e hZ hex horbit).2.2.2
  · rw [map_pow, restriction_squareGeneratorLift]
    exact Subtype.ext (squareGenerator_square i)
  · exact ⟨_, squareGeneratorLift_mem_core e hZ i, rfl⟩

theorem squareGeneratorLift_mul_square (i j : Fin 4) (hij : i ≠ j) :
    (squareGeneratorLift e i * squareGeneratorLift e j) ^ 2 =
      distinguishedSquare e hZ hex horbit := by
  apply (distinguishedSquare_spec e hZ hex horbit).2.2.2
  · rw [map_pow, map_mul, restriction_squareGeneratorLift, restriction_squareGeneratorLift]
    exact Subtype.ext (squareGenerator_mul_square i j hij)
  · exact ⟨_, (pCore 2 (preimage e)).mul_mem
      (squareGeneratorLift_mem_core e hZ i) (squareGeneratorLift_mem_core e hZ j), rfl⟩

/-- The distinguished square already belongs to the intrinsic `[R,H]`. -/
theorem distinguishedSquare_mem_commutator :
    distinguishedSquare e hZ hex horbit ∈ ⁅pCore 2 (preimage e), (⊤ : Subgroup (preimage e))⁆ := by
  let D : Subgroup (preimage e) := ⁅pCore 2 (preimage e), (⊤ : Subgroup (preimage e))⁆
  let q := QuotientGroup.mk' D
  let x := squareGeneratorLift e 0
  let y := squareGeneratorLift e 1
  let v := distinguishedSquare e hZ hex horbit
  have hx : x ^ 2 = v := squareGeneratorLift_square e hZ hex horbit 0
  have hy : y ^ 2 = v := squareGeneratorLift_square e hZ hex horbit 1
  have hxy : (x * y) ^ 2 = v :=
    squareGeneratorLift_mul_square e hZ hex horbit 0 1 (by decide)
  have hv : v ^ 2 = 1 := by
    have h := pow_orderOf_eq_one v
    rwa [(distinguishedSquare_spec e hZ hex horbit).1] at h
  have hc : Commute (q x) (q y) := by
    apply commutatorElement_eq_one_iff_commute.mp
    rw [← map_commutatorElement]
    apply (QuotientGroup.eq_one_iff _).mpr
    exact commutator_mem_commutator (squareGeneratorLift_mem_core e hZ 0) (mem_top _)
  apply (QuotientGroup.eq_one_iff _).mp
  change q v = 1
  calc
    q v = (q x * q y) ^ 2 := by rw [← map_mul, ← map_pow, hxy]
    _ = q (x ^ 2) * q (y ^ 2) := by rw [hc.mul_pow, map_pow, map_pow]
    _ = 1 := by rw [hx, hy, ← map_mul, ← pow_two, hv, map_one]

/-- The literal image of the two-core after killing the distinguished square. -/
theorem core_image_elementary :
    IsElementaryAbelian 2 ((pCore 2 (preimage e)).map
      (QuotientGroup.mk' (squareSubgroup e hZ hex horbit))) := by
  classical
  let f := restriction e
  let q := QuotientGroup.mk' (squareSubgroup e hZ hex horbit)
  let a := squareGeneratorLift e
  have ha (i : Fin 4) : q (a i) ^ 2 = 1 := by
    rw [← map_pow, squareGeneratorLift_square e hZ hex horbit]
    exact (QuotientGroup.eq_one_iff _).mpr (mem_zpowers _)
  have hab (i j : Fin 4) : (q (a i) * q (a j)) ^ 2 = 1 := by
    by_cases hij : i = j
    · subst j
      rw [← pow_two, ha, one_pow]
    · rw [← map_mul, ← map_pow, squareGeneratorLift_mul_square e hZ hex horbit i j hij]
      exact (QuotientGroup.eq_one_iff _).mpr (mem_zpowers _)
  have he := PerfectCentralCovering.elementary_image_of_square_generators f q
    (restriction_ker_central e) (restriction_kernel_exponent_two e hZ) a ha hab
  have hgen : closure (Set.range (fun i => f (a i))) = pCore 2 l₁ := by
    simp_rw [show ∀ i, f (a i) = squareGenerator i from restriction_squareGeneratorLift e]
    exact core_eq_closure_squareGenerator.symm
  rw [hgen, core_preimage e hZ] at he
  exact he

/-- The source's intrinsic quotient `R/⟨v⟩` is elementary abelian. -/
theorem core_quotient_elementary :
    IsElementaryAbelian 2 ((pCore 2 (preimage e)) ⧸
      (squareSubgroup e hZ hex horbit).subgroupOf (pCore 2 (preimage e))) := by
  let := core_image_elementary e hZ hex horbit
  let j := quotientSubgroupRangeEquiv (pCore 2 (preimage e)) (squareSubgroup e hZ hex horbit)
  refine {
    toIsMulCommutative := ⟨⟨fun x y => j.injective (by
      rw [map_mul, map_mul]
      exact IsMulCommutative.is_comm.comm _ _)⟩⟩
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr ?_ }
  intro x
  apply j.injective
  rw [map_pow, map_one]
  exact Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
    (IsElementaryAbelian.exponent_dvd_p 2 _) (j x)

end CFSG.Quasithin.ChapterI.Section02.ExceptionalCovers.J2Local
