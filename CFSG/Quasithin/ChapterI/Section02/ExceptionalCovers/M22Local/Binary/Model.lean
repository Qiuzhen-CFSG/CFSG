module

public import CFSG.Quasithin.ChapterI.Section02.ExceptionalCovers.M22Local.Binary.Splitting
public import CFSG.Quasithin.ChapterI.Section02.ExceptionalCovers.M22Local.Binary.Coordinates
public import Theory.Representation.BinaryPermutation.SixCoreExtension

/-!
# The marked binary hexad model

The lifted native section and the native natural quotient determine the
augmentation-core representation on the actual radical. Perfectness forces
commutator generation, and the universal module-cover theorem identifies the
radical of order 32 with the five-dimensional core. The resulting semidirect
product isomorphism carries the ambient center to the constant line.

The construction assumes only the earlier perfectness restriction and A₆
covering identification permitted in the I.2.2(6) argument. The complement,
equivariance, quotient coordinates, and center identification are conclusions.

Source: Aschbacher–Smith I.2.2(6), printed pp.410 and 412.
-/

public section
namespace CFSG.Quasithin.ChapterI.Section02.ExceptionalCovers.M22Local.Binary
open Subgroup Sporadic.Mathieu Sporadic.Mathieu.M22CentralCover
open BinaryPermutation.SixCoreExtension
open scoped Pointwise
universe u
variable {K : Type u} [Group K]
noncomputable section

/-- A marked recognition of the actual radical and a constructed native section.
`exists_hexadRecognition` constructs this data from the earlier source inputs. -/
structure HexadRecognition (e : (K ⧸ center K) ≃* M22)
    {B : Finset (Fin 22)} (hB : B ∈ m22Blocks) where
  sectionHom : alternatingGroup (Fin 6) →* hexadPreimage e B
  section_marking : ∀ a, hexadSixMap e hB (sectionHom a) = m22HexadMarking hB a
  section_projection :
    (localProjection e (MulAction.stabilizer M22 B)).comp sectionHom = m22HexadSection hB
  radicalEquiv : hexadRadical e B ≃* Multiplicative (BinaryPermutation.core (Fin 6))
  equivariant : ∀ a r, (radicalEquiv (hexadConjugation e B (sectionHom a) r)).toAdd =
    BinaryPermutation.coreRepresentation (Fin 6) a.val (radicalEquiv r).toAdd
  natural_projection : ∀ r,
    BinaryPermutation.coreToNatural (Fin 6) (radicalEquiv r).toAdd = (naturalMap e hB r).toAdd

/-- Construct the complement and core representation; neither is an input. -/
theorem exists_hexadRecognition [Finite K]
    (e : (K ⧸ center K) ≃* M22) (hZ : Nat.card (center K) = 2)
    {B : Finset (Fin 22)} (hB : B ∈ m22Blocks)
    [Group.IsPerfect (hexadPreimage e B)]
    (hcover : CentralExtension.TwoPrimaryInvolutionData.{u} (alternatingGroup (Fin 6))) :
    Nonempty (HexadRecognition e hB) := by
  obtain ⟨s, hs, hnative⟩ := exists_naturally_marked_section e hZ hB hcover
  obtain ⟨E, hE, hq, _⟩ := hexadRadical_core_of_section e hZ hB
    (m22HexadMarking hB) s hs (naturalMap e hB) (naturalMap_surjective e hB)
      (naturalMap_ker e hB) (naturalMap_conjugation e hB s hnative)
  exact ⟨⟨s, hs, hnative, E, hE, hq⟩⟩

namespace HexadRecognition
variable {e : (K ⧸ center K) ≃* M22} {B : Finset (Fin 22)} {hB : B ∈ m22Blocks}
variable (d : HexadRecognition e hB)

/-- The section range is a complement in the actual hexad preimage. -/
theorem isComplement :
    ((hexadRadical e B).subgroupOf (hexadPreimage e B)).IsComplement' d.sectionHom.range :=
  hexadSection_isComplement e hB (m22HexadMarking hB) d.sectionHom d.section_marking

/-- The complement is isomorphic to A₆, with the specified parametrization. -/
def complementEquiv : alternatingGroup (Fin 6) ≃* d.sectionHom.range :=
  MonoidHom.ofInjective
    (hexadSection_injective e hB (m22HexadMarking hB) d.sectionHom d.section_marking)

/-- The same complement, embedded in the original ambient group. -/
@[expose] def complement : Subgroup K := d.sectionHom.range.map (hexadPreimage e B).subtype

/-- The ambient complement is an actual copy of A₆. -/
def ambientComplementEquiv : alternatingGroup (Fin 6) ≃* d.complement :=
  d.complementEquiv.trans (d.sectionHom.range.equivMapOfInjective
    (hexadPreimage e B).subtype Subtype.val_injective)

/-- The literal ambient radical is generated by its commutators with the complement. -/
theorem eq_commutator [Finite K] (hZ : Nat.card (center K) = 2)
    [Group.IsPerfect (hexadPreimage e B)] :
    hexadRadical e B =
      ⁅hexadRadical e B, d.sectionHom.range.map (hexadPreimage e B).subtype⁆ :=
  hexadRadical_eq_commutator_of_section e hZ hB
    (m22HexadMarking hB) d.sectionHom d.section_marking

/-- In these coordinates the ambient center is exactly the constant line. -/
theorem center_iff (r : hexadRadical e B) :
    r.val ∈ center K ↔ BinaryPermutation.coreToNatural (Fin 6) (d.radicalEquiv r).toAdd = 0 := by
  rw [d.natural_projection]
  change r ∈ (center K).subgroupOf (hexadRadical e B) ↔ naturalMap e hB r = 1
  rw [← naturalMap_ker]
  rfl

/-- The center is the constant line inside the six-letter permutation space. -/
theorem center_iff_constants (r : hexadRadical e B) :
    r.val ∈ center K ↔ (d.radicalEquiv r).toAdd.val ∈ BinaryPermutation.constants (Fin 6) := by
  rw [d.center_iff, ← Subtype.val_inj]
  exact Submodule.Quotient.mk_eq_zero _

private def splitEquiv :
    hexadRadical e B ⋊[(hexadConjugation e B).comp d.sectionHom] alternatingGroup (Fin 6) ≃*
      hexadPreimage e B :=
  MulEquiv.ofBijective (hexadSplitHom e B d.sectionHom)
    (hexadSplitHom_bijective e hB (m22HexadMarking hB) d.sectionHom d.section_marking)

private def coordinateEquiv :
    hexadRadical e B ⋊[(hexadConjugation e B).comp d.sectionHom] alternatingGroup (Fin 6) ≃*
      Model :=
  SemidirectProduct.congr d.radicalEquiv (MulEquiv.refl _) (fun a => by
    apply MulEquiv.ext
    intro r
    exact d.equivariant a r)

/-- A genuine isomorphism from the actual hexad preimage to the explicit model. -/
def modelEquiv : hexadPreimage e B ≃* Model :=
  (splitEquiv d).symm.trans (coordinateEquiv d)

/-- The model isomorphism retains the literal inclusion of the radical. -/
@[simp] theorem modelEquiv_radical (r : hexadRadical e B) :
    d.modelEquiv (Subgroup.inclusion (hexadRadical_le e B) r) = vector (d.radicalEquiv r) := by
  have hr : splitEquiv d (SemidirectProduct.inl r) =
      Subgroup.inclusion (hexadRadical_le e B) r := by
    apply Subtype.ext
    simp [splitEquiv, hexadSplitHom]
  change coordinateEquiv d ((splitEquiv d).symm _) = _
  rw [← hr, MulEquiv.symm_apply_apply]
  rfl

/-- The image of Z(K), rather than an unspecified local center, is the marked line. -/
theorem modelEquiv_center :
    ((center K).subgroupOf (hexadPreimage e B)).map d.modelEquiv.toMonoidHom = centralLine := by
  ext x
  constructor
  · rintro ⟨z, hz, rfl⟩
    let r : hexadRadical e B := ⟨z.val, center_le_hexadRadical e B hz⟩
    have he : z = Subgroup.inclusion (hexadRadical_le e B) r := rfl
    rw [he]
    change d.modelEquiv (Subgroup.inclusion (hexadRadical_le e B) r) ∈ centralLine
    rw [d.modelEquiv_radical]
    exact ⟨d.radicalEquiv r, (d.center_iff r).mp hz, rfl⟩
  · rintro ⟨v, hv, rfl⟩
    change BinaryPermutation.coreToNatural (Fin 6) v.toAdd = 0 at hv
    let r := d.radicalEquiv.symm v
    have hr : r.val ∈ center K := (d.center_iff r).mpr (by
      simpa only [r, MulEquiv.apply_symm_apply] using hv)
    refine ⟨Subgroup.inclusion (hexadRadical_le e B) r, hr, ?_⟩
    change d.modelEquiv (Subgroup.inclusion (hexadRadical_le e B) r) = vector v
    rw [d.modelEquiv_radical, MulEquiv.apply_symm_apply]

end HexadRecognition
end
end CFSG.Quasithin.ChapterI.Section02.ExceptionalCovers.M22Local.Binary
