module

public import Theory.GroupAction.FixedPointHom
public import Theory.GroupTheory.CComponent.TwoComponent.CoreQuotient
public import Theory.GroupTheory.CComponent.QuotientLifting
public import Theory.GroupTheory.PPrimeCoreReduction
public import FeitThompson.FinalTheorem
public import CFSG.Quasithin.ChapterI.Section03.Balance

/-!
# Quotient preservation in GLS 5.22

An equivariant central-kernel surjection has normal image on fixed subgroups:
a lift of a fixed quotient element has central displacement, so conjugating
a fixed element by that lift is still fixed. Solvable-kernel transport and
subnormal ascent therefore preserve individual fixed two-components without
asserting surjectivity of the full fixed-subgroup map.

In a group generated by two-components, O_{2',2} is central modulo O_{2'}.
For an invariant normal N in that literal iterated core, factor the original
quotient through N intersect O_{2'}. Its first kernel is odd and its second
kernel is central. Applying the two preservation arguments proves GLS II,
Chapter B, Proposition 5.22(iv), for the actual induced quotient action.
The actor need only be a two-group; no classification input is used here.
-/

public section
open Subgroup Theory.GroupTheory
open scoped commutatorElement
namespace CFSG.Quasithin.ChapterI.GeneralTwoOrbit
variable {G H : Type*} [Group G] [Group H] [Finite G]

/-- Solvable kernels preserve two-components, with the original image subgroup. -/
theorem map_twoComponent_of_surjective_solvable_kernel
    {I : Subgroup G} (hI : I.IsTwoComponent)
    (f : G →* H) (hf : Function.Surjective f) [Group.IsSolvable f.ker] :
    (I.map f).IsTwoComponent := by
  let : Finite H := Finite.of_surjective f hf
  let J := I.map f
  have hJ : J.IsCComponent := cComponent_map_of_solvable_ker hI.1 f hf
  let fI := f.subgroupMap I
  let Q := J ⧸ pPrimeCore 2 J
  have hproper : pPrimeCore 2 J ≠ ⊤ := by
    intro he
    let : Group.IsSolvable (pPrimeCore 2 J) := odd_order_theorem _
      (Nat.coprime_two_left.mp pPrimeCore_coprime_card)
    let : Group.IsSolvable (⊤ : Subgroup J) := he ▸ inferInstanceAs
      (Group.IsSolvable (pPrimeCore 2 J))
    exact hJ.not_isSolvable (Group.isSolvable_of_surjective
      (f := (topEquiv : (⊤ : Subgroup J) ≃* J).toMonoidHom) topEquiv.surjective)
  let : Nontrivial Q := QuotientGroup.nontrivial_iff.mpr hproper
  let q := (QuotientGroup.mk' (pPrimeCore 2 J)).comp fI
  have hker : pPrimeCore 2 I ≤ q.ker := by
    intro x hx
    apply (QuotientGroup.eq_one_iff _).mpr
    exact pPrimeCore_map_le fI (f.subgroupMap_surjective I) (mem_map_of_mem fI hx)
  let qbar : (I ⧸ pPrimeCore 2 I) →* Q := QuotientGroup.lift _ q hker
  have hqbar : Function.Surjective qbar := by
    intro y
    obtain ⟨x, rfl⟩ := (QuotientGroup.mk'_surjective (pPrimeCore 2 J)).comp
      (f.subgroupMap_surjective I) y
    exact ⟨QuotientGroup.mk' (pPrimeCore 2 I) x, rfl⟩
  let := hI.2
  exact ⟨hJ, IsQuasisimple.of_surjective qbar hqbar⟩

/-- The corresponding image theorem also permits a subnormal image ambient. -/
theorem map_twoComponent_of_subnormal_range_solvable_kernel
    {I : Subgroup G} (hI : I.IsTwoComponent)
    (f : G →* H) (hr : f.range.IsSubnormal) [Group.IsSolvable f.ker] :
    (I.map f).IsTwoComponent := by
  let : Group.IsSolvable f.rangeRestrict.ker := by
    rw [MonoidHom.ker_rangeRestrict]
    infer_instance
  have h := (map_twoComponent_of_surjective_solvable_kernel hI f.rangeRestrict
    f.rangeRestrict_surjective).map_subtype hr
  simpa only [map_map, MonoidHom.subtype_comp_rangeRestrict] using h


/-- In a group generated by two-components, the two-core modulo the odd core
is central. This is the precise kernel condition for GLS 5.22(iv). -/
theorem oddTwoCore_commutator_le_oddCore (hG : twoComponentLayer G = ⊤) :
    ⁅oddTwoCore G, ⊤⁆ ≤ pPrimeCore 2 G := by
  let O := pPrimeCore 2 G
  let Q := G ⧸ O
  let q := QuotientGroup.mk' O
  have hE : componentLayer Q = ⊤ := by
    rw [← Balance.map_twoComponentLayer_oddCore, hG,
      map_top_of_surjective _ (QuotientGroup.mk'_surjective _)]
  let : Group.IsNilpotent (pCore 2 Q) := pCore_isPGroup.isNilpotent
  have hcent : componentLayer Q ≤ centralizer (pCore 2 Q : Set Q) := by
    refine sSup_le fun K hK => ?_
    rcases hK.normal_dichotomy (pCore 2 Q) with h | h
    · exact (hK.isCComponent.not_isSolvable
        (Group.isSolvable_of_isSolvable_injective (inclusion_injective h))).elim
    · exact commutator_eq_bot_iff_le_centralizer.mp h
  have hZ : pCore 2 Q ≤ center Q := by
    simpa only [hE, coe_top, centralizer_univ] using le_centralizer_iff.mp hcent
  have hmap : (oddTwoCore G).map q ≤ center Q := (map_comap_le _ _).trans hZ
  have hz : ⁅oddTwoCore G, (⊤ : Subgroup G)⁆.map q = ⊥ := by
    apply le_bot_iff.mp
    rw [map_commutator]
    exact (commutator_mono hmap le_top).trans (commutator_center_left (⊤ : Subgroup Q)).le
  simpa only [Subgroup.map_eq_bot_iff, q, QuotientGroup.ker_mk'] using hz

variable {A : Type*} [Group A]
    [MulDistribMulAction A G] [MulDistribMulAction A H]

omit [Finite G] in
/-- A central kernel makes the image of the full fixed subgroup normal.
This asserts no surjectivity of the fixed-subgroup homomorphism. -/
theorem fixed_map_range_normal_of_central_kernel
    (f : G →* H) (hf : Function.Surjective f)
    (he : ∀ (a : A) (x : G), f (a • x) = a • f x)
    (hc : f.ker ≤ center G) : (FixedPoints.mapHom f he).range.Normal := by
  constructor
  intro z hz y
  obtain ⟨x, hx⟩ := hf (y : H)
  obtain ⟨w, rfl⟩ := hz
  refine ⟨⟨x * w * x⁻¹, ?_⟩, ?_⟩
  · intro a
    have hd : a • x * x⁻¹ ∈ f.ker := by
      rw [MonoidHom.mem_ker, map_mul, map_inv, he, hx, y.property a, mul_inv_cancel]
    have hc' := mem_center_iff.mp (hc hd) (x * (w : G) * x⁻¹)
    have ha : a • x = (a • x * x⁻¹) * x := by group
    change a • (x * (w : G) * x⁻¹) = x * (w : G) * x⁻¹
    rw [smul_mul', smul_mul', smul_inv', w.property a, ha]
    calc
      _ = (a • x * x⁻¹) * (x * (w : G) * x⁻¹) * (a • x * x⁻¹)⁻¹ := by group
      _ = x * (w : G) * x⁻¹ := by rw [← hc', mul_inv_cancel_right]
  · apply Subtype.ext
    change f (x * (w : G) * x⁻¹) = (y : H) * f w * (y : H)⁻¹
    rw [map_mul, map_mul, map_inv, hx]

/-- Fixed two-components survive every equivariant central-kernel surjection. -/
theorem map_fixed_twoComponent_of_central_kernel
    (f : G →* H) (hf : Function.Surjective f)
    (he : ∀ (a : A) (x : G), f (a • x) = a • f x)
    (hc : f.ker ≤ center G)
    {I : Subgroup (fixedPointSubgroup A G)} (hI : I.IsTwoComponent) :
    (I.map (FixedPoints.mapHom f he)).IsTwoComponent := by
  have hk : (FixedPoints.mapHom f he).ker ≤ center (fixedPointSubgroup A G) := by
    intro x hx
    apply mem_center_iff.mpr
    intro y
    apply Subtype.ext
    exact mem_center_iff.mp (hc (congrArg Subtype.val hx)) y
  let : Group.IsSolvable (center (fixedPointSubgroup A G)) := Group.isSolvable_of_comm
    (fun a b => Subtype.ext (mem_center_iff.mp a.property b).symm)
  let : Group.IsSolvable (FixedPoints.mapHom f he).ker :=
    Group.isSolvable_of_isSolvable_injective (inclusion_injective hk)
  exact map_twoComponent_of_subnormal_range_solvable_kernel hI _
    (fixed_map_range_normal_of_central_kernel f hf he hc).isSubnormal

/-- Odd equivariant kernels preserve individual fixed two-components. -/
theorem map_fixed_twoComponent_of_odd_kernel
    (hA : IsPGroup 2 A) (f : G →* H) (hf : Function.Surjective f)
    (he : ∀ (a : A) (x : G), f (a • x) = a • f x)
    (hk : Odd (Nat.card f.ker))
    {I : Subgroup (fixedPointSubgroup A G)} (hI : I.IsTwoComponent) :
    (I.map (FixedPoints.mapHom f he)).IsTwoComponent := by
  have hk' : Odd (Nat.card (FixedPoints.mapHom f he).ker) :=
    Nat.coprime_two_left.mp (hk.coprime_two_left.of_dvd_right
      (FixedPoints.mapHom_ker_card_dvd f he))
  let : Group.IsSolvable (FixedPoints.mapHom f he).ker := odd_order_theorem _ hk'
  exact map_twoComponent_of_surjective_solvable_kernel hI _
    (FixedPoints.mapHom_surjective_of_coprime_kernel hA f hf he hk.not_two_dvd_nat)

/-- An odd normal subgroup followed by a central kernel preserves each fixed
component. The factorization retains the original equivariant homomorphism. -/
theorem map_fixed_twoComponent_of_odd_central_kernel
    (hA : IsPGroup 2 A) (f : G →* H) (hf : Function.Surjective f)
    (he : ∀ (a : A) (x : G), f (a • x) = a • f x)
    (O : Subgroup G) [O.Normal] (hO : IsInvariant A G O)
    (ho : Odd (Nat.card O)) (hOf : O ≤ f.ker) (hc : ⁅f.ker, ⊤⁆ ≤ O)
    {I : Subgroup (fixedPointSubgroup A G)} (hI : I.IsTwoComponent) :
    (I.map (FixedPoints.mapHom f he)).IsTwoComponent := by
  let : MulDistribMulAction A (G ⧸ O) := quotientMulDistribMulAction O hO
  let q := QuotientGroup.mk' O
  let r : G ⧸ O →* H := QuotientGroup.lift O f hOf
  have hr : Function.Surjective r := by
    intro y
    obtain ⟨x, rfl⟩ := hf y
    exact ⟨q x, rfl⟩
  have heq (a : A) (x : G) : q (a • x) = a • q x := rfl
  have her (a : A) (x : G ⧸ O) : r (a • x) = a • r x := by
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective O x
    exact he a x
  have hrc : r.ker ≤ center (G ⧸ O) := by
    intro x hx
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective O x
    have hxf : x ∈ f.ker := hx
    apply mem_center_iff.mpr
    intro y
    obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective O y
    apply (commutatorElement_eq_one_iff_mul_comm.mp ?_).symm
    rw [← map_commutatorElement]
    exact (QuotientGroup.eq_one_iff _).mpr
      (hc (commutator_mem_commutator hxf (mem_top y)))
  have hIq := map_fixed_twoComponent_of_odd_kernel hA q (QuotientGroup.mk'_surjective O)
    heq (by simpa only [q, QuotientGroup.ker_mk'] using ho) hI
  have hIr := map_fixed_twoComponent_of_central_kernel r hr her hrc hIq
  have hcomp : (FixedPoints.mapHom r her).comp (FixedPoints.mapHom q heq) =
      FixedPoints.mapHom f he := by
    ext x
    rfl
  simpa only [map_map, hcomp] using hIr

/-- GLS 5.22(iv) for any two-component-generated group and any finite two-group
action, with the literal iterated core and induced quotient action. -/
theorem map_fixed_twoComponent_oddTwoCore_quotient
    (hG : twoComponentLayer G = ⊤) (hA : IsPGroup 2 A)
    (N : Subgroup G) [N.Normal] (hN : IsInvariant A G N)
    (hNcore : N ≤ oddTwoCore G)
    {I : Subgroup (fixedPointSubgroup A G)} (hI : I.IsTwoComponent) :
    letI : MulDistribMulAction A (G ⧸ N) := quotientMulDistribMulAction N hN
    (I.map (FixedPoints.quotientMap N hN)).IsTwoComponent := by
  let : MulDistribMulAction A (G ⧸ N) := quotientMulDistribMulAction N hN
  let O := N ⊓ pPrimeCore 2 G
  have hOinv : IsInvariant A G O := ⟨fun a g =>
    and_congr (hN.invariant a g)
      ((isInvariant_of_characteristic (A := A) (pPrimeCore 2 G)).invariant a g)⟩
  have ho : Odd (Nat.card O) := Nat.coprime_two_left.mp
    ((pPrimeCore_coprime_card (p := 2) (G := G)).of_dvd_right
      (card_dvd_of_le (show O ≤ pPrimeCore 2 G from inf_le_right)))
  have hc : ⁅N, (⊤ : Subgroup G)⁆ ≤ O := le_inf (commutator_le_left _ _)
    ((commutator_mono hNcore le_rfl).trans (oddTwoCore_commutator_le_oddCore hG))
  exact map_fixed_twoComponent_of_odd_central_kernel hA (QuotientGroup.mk' N)
    (QuotientGroup.mk'_surjective N) (fun _ _ => rfl) O hOinv ho
    (by simpa only [QuotientGroup.ker_mk'] using (show O ≤ N from inf_le_left))
    (by simpa only [QuotientGroup.ker_mk'] using hc) hI

end CFSG.Quasithin.ChapterI.GeneralTwoOrbit
