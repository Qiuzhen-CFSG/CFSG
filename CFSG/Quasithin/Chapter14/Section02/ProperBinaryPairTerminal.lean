module
public import CFSG.Quasithin.Chapter14.Section02.ProperQuasisimpleTerminal
public import CFSG.Quasithin.Chapter14.Section02.ProperNormalizer
public import CFSG.Quasithin.ChapterE.Section02.Structure.PairedBinaryThree

/-!
# The original binary pair in the proper quasisimple branch

The selected binary C-component and its conjugate generate the full two-residual
of the original minimal parabolic. The lower paired theorem supplies cubic rank
at least two and shows that this residual is generated by three-elements.
The original omega-center control then places it in the centralizer of
`C_{Ω₁Z(S)}(L)`. Once the later containing local overgroup has prime-to-three
residual equal to the canonical `L`, functoriality places the full pair in `L`.
This supplies both pair inputs of the intrinsic proper-quasisimple terminal.

The binary selection and the later containing-overgroup residual identity remain
explicit. They occur after the containing-row comparison and A.3.18 in the
source; the earlier prefix also permits paired Suzuki factors and does not
imply cubic rank two.

Source: Aschbacher--Smith 14.2.15, printed pp.985--986, the paragraph beginning
with the remaining triality and sporadic possibilities.
-/

public section
open Subgroup Theory.GroupTheory Stellmacher
open scoped MatrixGroups
namespace CFSG.Quasithin.Chapter14.Section02
open SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
open Chapter15.Section03.Candidates.ComponentStructure
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
private theorem paired_residual_placement
    (H M₁ L : Subgroup G)
    (hthree : primeToResidual 3 (pResidual 2 H) = ⊤)
    (hDM : (pResidual 2 H).map H.subtype ≤ M₁)
    (hL : (primeToResidual 3 M₁).map M₁.subtype = L) :
    (pResidual 2 H).map H.subtype ≤ L := by
  let f : (pResidual 2 H) →* M₁ :=
    (H.subtype.comp (pResidual 2 H).subtype).codRestrict M₁
      (fun x => hDM ⟨x,x.property,rfl⟩)
  have hf := map_primeToResidual_le_of_hom 3 f
  rw [hthree] at hf
  rintro x ⟨a,ha,rfl⟩
  rw [←hL]
  exact ⟨f ⟨a,ha⟩,hf ⟨⟨a,ha⟩,trivial,rfl⟩,rfl⟩

/-- The binary selected-pair terminal, using the literal later A.3.18 residual packet. -/
theorem source_proper_quasisimple_binary_pair_terminal
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (H : Subgroup G) (hH : H ∈ Chapter3.HStar (T : Subgroup G) M)
    (K S : Subgroup G) (hST : S ≤ (T : Subgroup G))
    (hi : S.relIndex (T : Subgroup G) = 2)
    (hplacement : ∀ P : Sylow 2 Mc, S ≤ (P : Subgroup Mc).map Mc.subtype →
      maximalTwoLocalOvergroups (K ⊔ (P : Subgroup Mc).map Mc.subtype) = {Mc})
    (hgen : K ⊔ (T : Subgroup G) = H)
    (hK : K ∈ Chapter1.L G S) (hSN : S ≤ normalizer (K : Set G))
    (hZS : centralInvolutions T ≤ S)
    (hcore : pCore 2 (K ⊔ sourceResidual M Mc ⊔ S : Subgroup G) ≠ ⊥)
    (A : Subgroup H) (hAK : A.map H.subtype = K)
    (hA : A.IsCComponent) (hqA : IsQuasisimple (A ⧸ pCore 2 A))
    (hnA : ¬ A.Normal)
    {F : Type*} [Field F] [Finite F] [CharP F 2]
    (eA : (A ⧸ pCore 2 A) ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 2) F)
    (hS : S = (T : Subgroup G) ⊓ normalizer (K : Set G))
    (M₁ : Subgroup G)
    (hCM₁ : centralizer ((omegaOneCenterAmbient S ⊓
      centralizer (((solvableResidual (K ⊔ sourceResidual M Mc ⊔ S : Subgroup G)).map
        (K ⊔ sourceResidual M Mc ⊔ S : Subgroup G).subtype) : Set G)) : Set G) ≤ M₁)
    (hL₃ : (primeToResidual 3 M₁).map M₁.subtype =
      (solvableResidual (K ⊔ sourceResidual M Mc ⊔ S : Subgroup G)).map
        (K ⊔ sourceResidual M Mc ⊔ S : Subgroup G).subtype) :
    let X := K ⊔ sourceResidual M Mc ⊔ S
    let L := (solvableResidual X).map X.subtype
    IsQuasisimple L → ¬ClassificationModels.IsBenderModel L ∧
      ∃ z : G, z ∈ centralInvolutions T ∧ orderOf z = 2 ∧
      L = ⁅L,zpowers z⁆ ∧ ¬L ≤ Mc ∧
      ∃ α : MulAut L, (∀ x : L, (α x : G) = z * (x : G) * z⁻¹) ∧
        ModelAction115 L α ∧
        (∀ n : ℕ, 0 < n → Triality.Standard.IsTrialityGroupAt (2^n) L →
          α ∉ (MulAut.conj (G := L)).range) ∧
        (∀ _f : (L ⧸ pCore 2 L) ≃* Rudvalis.Model, ¬TwoCentralInner α) := by
  let X := K ⊔ sourceResidual M Mc ⊔ S
  let L := (solvableResidual X).map X.subtype
  let D := (pResidual 2 H).map H.subtype
  have hAgen : A ⊔ (T.subtype hH.1.1.2 : Subgroup H) = ⊤ := by
    apply Subgroup.map_injective H.subtype_injective
    change (A ⊔ (T : Subgroup G).subgroupOf H).map H.subtype =
      (⊤ : Subgroup H).map H.subtype
    rw [Subgroup.map_sup,map_subgroupOf_eq_of_le hH.1.1.2,hAK,
      ←MonoidHom.range_eq_map,range_subtype,hgen]
  have hns : ¬Group.IsSolvable H := by
    intro hs
    let := hs
    exact hA.not_isSolvable (Group.isSolvable_of_isSolvable_injective A.subtype_injective)
  obtain ⟨_,hP,_,hsq,_,_⟩ := source_lemma_14_2_2_8_minimal hG T hempty hM hu hmany
    hcard e H hH
  have hr : 2 ≤ primeRank 3 D := by
    rw [←primeRank_equiv 3 ((pResidual 2 H).equivMapOfInjective H.subtype H.subtype_injective)]
    exact ChapterE.Structure.source_paired_binary_residual_three_rank
      (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple) hsq (T.subtype hH.1.1.2)
      hP hns hA hqA hAgen hnA eA
  have hthree : primeToResidual 3 (pResidual 2 H) = ⊤ :=
    ChapterE.Structure.source_paired_binary_residual_three_generated
      (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple) hsq (T.subtype hH.1.1.2)
      hP hns hA hqA hAgen hnA eA
  have hiA : ((T : Subgroup G) ⊓ normalizer (A.map H.subtype : Set G)).relIndex
      (T : Subgroup G) = 2 := by simpa only [hAK,←hS] using hi
  have hcontrol : D ≤ centralizer (omegaOneCenterAmbient S : Set G) ∧
      normalizer (omegaOneCenterAmbient S : Set G) ≤ Mc := by
    simpa only [hAK,←hS] using source_paired_omega_normalizer hG T hempty hM hu hmany
      hcard e H hH A hA hAgen hiA
  have hDM : D ≤ M₁ := (hcontrol.1.trans (centralizer_le
    (inf_le_left : omegaOneCenterAmbient S ⊓ centralizer (L : Set G) ≤
      omegaOneCenterAmbient S))).trans hCM₁
  have hpair : D ≤ L := paired_residual_placement H M₁ L hthree hDM hL₃
  exact source_proper_quasisimple_pair_terminal_intrinsic hG T hempty hM hu hmany hcard e
    H hH K S hST hi hcontrol.2 hplacement hgen hK hSN hZS hcore hpair hr

end CFSG.Quasithin.Chapter14.Section02
