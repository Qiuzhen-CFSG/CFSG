module
public import CFSG.Quasithin.Chapter14.Section01.SourcePreliminaries.PlaneSource
public import CFSG.Quasithin.Chapter14.Section02
public import Stellmacher.BaumannNormalizer

/-!
# The literal14.2 overgroup and amalgam consumers

The full14.1.18 source supplies the two actual maximal locals and uniqueness
above the original YT. Thus every original H above T and outside M has Mc
as its unique maximal local and lies in C_G(Z). The amalgam generated by
this H and the actual YT has trivial two-core. All prior14.1.18 callbacks
in these14.2 consumers are discharged.
Source: Aschbacher--Smith14.2.3 and the setup before14.2.21, pp.982,988.
-/

public section
open Subgroup Stellmacher Theory.GroupTheory
namespace CFSG.Quasithin.Chapter14.Section02
open SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
variable {G : Type*} [Group G] [Finite G]

/-- Original14.2.3 from the original plane source hypotheses. -/
theorem source_lemma_14_2_3
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃*
      Equiv.Perm (Fin 3))
    (H : Subgroup G) (hH : H ∈ Chapter1.HOver G (T : Set G)) (hout : ¬ H ≤ M) :
    maximalTwoLocalOvergroups H = {Mc} ∧ H ≤ centralizer (centralInvolutions T : Set G) := by
  obtain ⟨_,_,_,_,_,_,_,_,_,_,_,_,_,hMc,hfam⟩ :=
    source_lemma_14_1_18 hG T hempty hM hu hmany hcard e
  have hcore : pCore 2 H ≠ ⊥ := fun he => hH.1 (by simp [pCoreIn,he])
  have huniq : maximalTwoLocalOvergroups H = {Mc} := unique_overgroup_of_two_maximalTwoLocals
    (T : Subgroup G) H M Mc hfam hH.2 hout hcore
  have hmem : Mc ∈ maximalTwoLocalOvergroups H := huniq ▸ Set.mem_singleton Mc
  exact ⟨huniq,hmem.2.trans_eq hMc⟩

/-- The actual generated amalgam has trivial two-core, without a uniqueness callback. -/
theorem source_solvable_amalgam_twoCore_eq_bot
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃*
      Equiv.Perm (Fin 3))
    (H : Subgroup G) (hout : ¬ H ≤ M) :
    pCore 2 (H ⊔ (sourceResidual M Mc ⊔ (T : Subgroup G)) : Subgroup G) = ⊥ := by
  obtain ⟨_,_,_,_,_,_,huniq,rest⟩ := source_lemma_14_1_18 hG T hempty hM hu hmany hcard e
  exact solvable_amalgam_twoCore_eq_bot H (sourceResidual M Mc) (T : Subgroup G) M huniq hout

/-- Original14.2.2(7): the full Sylow normalizer lies in both actual locals. -/
theorem source_lemma_14_2_2_7
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃*
      Equiv.Perm (Fin 3)) : normalizer (T : Set G) ≤ M ⊓ Mc := by
  have hZ := plane_centralInvolutions_card T M hM.1.2 hcard e
  obtain ⟨D,hD,Mf,hMf,hne,hmax,hBaum,hdom,hoff,hall,hC⟩ :=
    InitialSource.UniformControl.source_lemma_14_1_12_selection hG T hempty hu hmany
  have hMfM : M = Mf := hall hZ M hM
  subst Mf
  have hNZ : normalizer (T : Set G) ≤ normalizer (centralInvolutions T : Set G) := by
    intro g hg
    apply mem_normalizer_iff_map_conj_eq.mpr
    change (omegaOneCenterAmbient (T : Subgroup G)).map (MulAut.conj g).toMonoidHom = _
    rw [←omegaOneCenterAmbient_map_injective _ (MulAut.conj g).injective]
    exact congrArg omegaOneCenterAmbient ((mem_normalizer_iff_map_conj_eq).mp hg)
  exact le_inf ((normalizer_le_normalizer_baumann (T : Subgroup G)).trans hBaum)
    ((hNZ.trans (normalizer_le_centralizer_of_card_two _ hZ)).trans
      (InitialSource.centralizer_le_partner T hu))

end CFSG.Quasithin.Chapter14.Section02
