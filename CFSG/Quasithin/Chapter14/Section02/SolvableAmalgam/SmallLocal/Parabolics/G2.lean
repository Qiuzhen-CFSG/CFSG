/-!
# Actual binary G₂ parabolic pairs for the small-local argument

The computed full and derived pairs are compatibly isomorphic to the incident
null-plane/point stabilizers. Their whole intersections are the marked Sylow
two-subgroups, of orders 64 and 32. The two first cores are the embedded
quaternion central product and Q₈ ◦ C₄. In both pairs, the distinguished
root subgroup is Ω₁ of the Sylow center and its second-parabolic normal
closure is the natural four-group.

Both first-parabolic two-residuals have the same ambient image: the order-24
subgroup generated by the right quaternion factor and the specified cubic.
Its action fixes the left factor and has exactly the marked involution as
kernel on the right factor. The explicit derived core isomorphism intertwines
the cubic and central quotient; applying the intrinsic quaternion–cyclic
calculation gives the actual residual action A₄ and its cyclic quotient image.

These concrete inputs discharge the G₂ model calculations in Aschbacher–Smith
Lemma 14.2.21, printed p.988. The ambient argument proving H = Mc and M = YT
remains with the source theorem's assembly owner. The V and Z conventions
are those of Hypothesis 14.2.1, printed p.981; the compatible geometric pair
comes from F.1.12(I)(3), printed p.263.
-/

namespace CFSG.Quasithin.Chapter14.Section02.SolvableAmalgam.SmallLocal.Parabolics
open Atlas.G2 Atlas.G2.BinaryCore Atlas.G2.BinaryParabolicPair

public theorem g2_first_core_and_overlap :
    firstParabolic.pCoreIn 2 = core ∧
      firstParabolic ⊓ secondParabolic = (commonSylow : Subgroup (Model (ZMod 2))) ∧
      (commonSylow : Subgroup (Model (ZMod 2))) ≤ firstParabolic ∧
      (commonSylow : Subgroup (Model (ZMod 2))) ≤ secondParabolic :=
  ⟨firstParabolic_pCore, parabolic_intersection, commonSylow_le_first,
    commonSylow_le_second⟩

public theorem g2_sylow_marked_center :
    ((omega₁ (Subgroup.center (unipotent (K := ZMod 2))) (p := 2)).map
      (Subgroup.center (unipotent (K := ZMod 2))).subtype).map unipotent.subtype =
      distinguished := commonSylow_omega_center

public theorem g2_first_residual_cubic_action :
    (⟨cubicActor,cubicActor_mem⟩ : firstParabolic) ∈ pResidual 2 firstParabolic ∧
      orderOf cubicActor = 3 ∧
      (∀ q : QuaternionGroup 2,
        cubicActor * embedding (leftEmbedding q) * cubicActor⁻¹ = embedding (leftEmbedding q)) ∧
      cubicActor * embedding rightI * cubicActor⁻¹ = embedding ((rightI*rightJ)⁻¹) ∧
      cubicActor * embedding rightJ * cubicActor⁻¹ = embedding rightI :=
  ⟨cubicActor_residual, cubicActor_order, cubic_fixes_left, cubic_rightI, cubic_rightJ⟩

/-- The actual intrinsic two-core, not an unconnected group-family label. -/
public noncomputable def g2_derived_first_core_model :
    pCore 2 derivedFirst ≃* QuaternionCyclic.Model := derivedIntrinsicCoreEquiv

public theorem g2_derived_embedded_core :
    (derivedFirst.pCoreIn 2).map DerivedModel.subtype =
      core ⊓ commutator (Model (ZMod 2)) :=
  derivedFirst_pCore_in_model.trans derivedCore_eq_intersection

public theorem g2_derived_cubic_action (x : QuaternionCyclic.Model) :
    (⟨⟨cubicActor,cubicActor_mem_derived⟩,cubicActor_mem_derivedFirst⟩ : derivedFirst) ∈
        pResidual 2 derivedFirst ∧
      cubicActor * (derivedFirstCoreEquiv x : Model (ZMod 2)) * cubicActor⁻¹ =
        (derivedFirstCoreEquiv (QuaternionCyclic.cubic x) : Model (ZMod 2)) ∧
      derivedFirstCoreCentralQuotient (derivedFirstCoreEquiv (QuaternionCyclic.cubic x)) =
        QuaternionCyclic.cubicQuotient
          (derivedFirstCoreCentralQuotient (derivedFirstCoreEquiv x)) :=
  ⟨cubicActor_derived_residual, cubic_derivedFirstCore x, derivedFirstCoreCentralQuotient_cubic x⟩

public theorem g2_derived_central_quotient :
    Function.Surjective derivedFirstCoreCentralQuotient ∧
      derivedFirstCoreCentralQuotient.ker =
        Subgroup.center ((derivedFirst.pCoreIn 2).map DerivedModel.subtype) :=
  ⟨derivedFirstCoreCentralQuotient_surjective, derivedFirstCoreCentralQuotient_ker⟩

end CFSG.Quasithin.Chapter14.Section02.SolvableAmalgam.SmallLocal.Parabolics

namespace CFSG.Quasithin.Chapter14.Section02.SolvableAmalgam.SmallLocal.Parabolics
open Atlas.G2 Atlas.G2.BinaryCore Atlas.G2.BinaryParabolicPair
open Theory.GroupTheory

/-- The computed pair is the full binary specialization of the F.1.12 pair,
with both maps on the entire intersection retained. -/
public noncomputable def g2_source_pair_iso : RankTwoAmalgam.Iso concreteAmalgam
    (ChapterF.GreenBook.LieModels.G2.amalgam (F := ZMod 2)) where
  left := MulEquiv.subgroupCongr LieParabolicSetup.parabolic₁_binary.symm
  middle := MulEquiv.subgroupCongr (by
    change (commonSylow : Subgroup (Model (ZMod 2))) =
      LieParabolicSetup.parabolic₁ ⊓ LieParabolicSetup.parabolic₂
    rw [LieParabolicSetup.parabolic₁_binary]
    exact parabolic_intersection.symm)
  right := MulEquiv.refl _
  left_commutes _ := by apply Subtype.ext; rfl
  right_commutes _ := by apply Subtype.ext; rfl

/-- The same two subgroups are the standard incident geometric stabilizers. -/
public noncomputable def g2_geometric_pair_iso :
    RankTwoAmalgam.Iso concreteAmalgam geometricPair := geometricPairIso

/-- Restriction uses the actual commutator subgroup and the whole restricted overlap. -/
public noncomputable def g2_derived_geometric_pair_iso :
    RankTwoAmalgam.Iso derivedAmalgam derivedGeometricPair := derivedGeometricPairIso

private theorem binaryLeft_eq_derivedFirst :
    LieAutomorphismExtensions.BinaryLeft = derivedFirst := by
  simp [LieAutomorphismExtensions.BinaryLeft, LieAutomorphismExtensions.binaryMarkedParabolic,
    LieParabolicSetup.parabolic₁_binary, derivedFirst]

private theorem binaryRight_eq_derivedSecond :
    LieAutomorphismExtensions.BinaryRight = derivedSecond := by
  simp [LieAutomorphismExtensions.BinaryRight, LieAutomorphismExtensions.binaryMarkedParabolic,
    derivedSecond, LieParabolicSetup.parabolic₂, secondParabolic]

/-- Compatibility with the derived pair used in the binary automorphism theorem. -/
public noncomputable def g2_derived_source_pair_iso :
    RankTwoAmalgam.Iso derivedAmalgam LieAutomorphismExtensions.binaryAmalgam where
  left := MulEquiv.subgroupCongr binaryLeft_eq_derivedFirst.symm
  middle := MulEquiv.subgroupCongr (by
    rw [LieAutomorphismExtensions.binaryOverlap, binaryLeft_eq_derivedFirst,
      binaryRight_eq_derivedSecond, derived_parabolic_intersection_in_model])
  right := MulEquiv.subgroupCongr binaryRight_eq_derivedSecond.symm
  left_commutes _ := by apply Subtype.ext; rfl
  right_commutes _ := by apply Subtype.ext; rfl

public theorem g2_pair_orders :
    Nat.card firstParabolic = 192 ∧ Nat.card secondParabolic = 192 ∧
      Nat.card (commonSylow : Subgroup (Model (ZMod 2))) = 64 ∧
      ((commonSylow : Subgroup (Model (ZMod 2))).subgroupOf firstParabolic).index = 3 ∧
      ((commonSylow : Subgroup (Model (ZMod 2))).subgroupOf secondParabolic).index = 3 :=
  ⟨card_firstParabolic, secondParabolic_card, card_unipotent_binary,
    commonSylow_index_in_first, unipotent_index_in_second⟩

public theorem g2_derived_pair_orders_and_overlap :
    Nat.card derivedFirst = 96 ∧ Nat.card derivedSecond = 96 ∧
      Nat.card derivedSylow = 32 ∧
      derivedFirst ⊓ derivedSecond = (derivedSylow : Subgroup DerivedModel) ∧
      ((derivedSylow : Subgroup DerivedModel).subgroupOf derivedFirst).index = 3 ∧
      ((derivedSylow : Subgroup DerivedModel).subgroupOf derivedSecond).index = 3 :=
  ⟨card_derivedFirst, card_derivedSecond, card_derivedSylow,
    derived_parabolic_intersection_in_model, derivedSylow_index_in_first,
    derivedSylow_index_in_second⟩

/-- The intrinsic Sylow subgroups in the two restricted parabolics have
the very same embedding into G₂(2)′. -/
public theorem g2_derived_sylow_embeddings :
    (derivedFirstSylow : Subgroup derivedFirst).map derivedFirst.subtype = derivedSylow ∧
      (derivedSecondSylow : Subgroup derivedSecond).map derivedSecond.subtype = derivedSylow ∧
      (derivedSylow : Subgroup DerivedModel).map DerivedModel.subtype =
        unipotent ⊓ commutator (Model (ZMod 2)) :=
  ⟨derivedFirstSylow_map_subtype, derivedSecondSylow_map_subtype, derivedSylow_map_subtype⟩

public theorem g2_derived_sylow_marked_center :
    ((omega₁ (Subgroup.center (derivedSylow : Subgroup DerivedModel)) (p := 2)).map
      (Subgroup.center (derivedSylow : Subgroup DerivedModel)).subtype).map
      (derivedSylow : Subgroup DerivedModel).subtype = derivedDistinguished ∧
      derivedDistinguished.map DerivedModel.subtype = distinguished :=
  ⟨derivedSylow_omega_center_in_model, derivedDistinguished_map_subtype⟩

/-- The literal normal closures realize V = ⟨Z^A⟩ in both concrete groups. -/
public theorem g2_natural_planes_generated :
    (Subgroup.normalClosure
      ({⟨z, elementary_le_secondParabolic z_mem_elementary⟩} : Set secondParabolic)).map
      secondParabolic.subtype = natural ∧
    (Subgroup.normalClosure
      ({⟨⟨z, rootA_one_mem_commutator⟩, elementary_le_secondParabolic z_mem_elementary⟩} :
        Set derivedSecond)).map derivedSecond.subtype = derivedNatural :=
  ⟨natural_eq_normalClosure, derivedNatural_eq_normalClosure⟩

public theorem g2_derived_natural_plane_action :
    Nat.card derivedNatural = 4 ∧ IsElementaryAbelian 2 derivedNatural ∧
      derivedDistinguished ≤ derivedNatural ∧
      derivedNatural ≤ (derivedSylow : Subgroup DerivedModel) ∧
      (derivedNatural.subgroupOf derivedSecond).Normal ∧
      ∃ y : derivedSecond, y ∈ pResidual 2 derivedSecond ∧
        (y : DerivedModel) * ⟨z, rootA_one_mem_commutator⟩ * (y : DerivedModel)⁻¹ ≠
          ⟨z, rootA_one_mem_commutator⟩ :=
  ⟨card_derivedNatural, inferInstance, derivedDistinguished_le_natural,
    derivedNatural_le_sylow, inferInstance,
    ⟨⟨movingActor, movingActor_mem_derived⟩, movingActor_mem_derivedSecond⟩,
    movingActor_derived_residual, movingActor_derived_moves⟩

/-- Both first-parabolic residuals have the same actual order-24 ambient image. -/
public theorem g2_first_residuals :
    (pResidual 2 firstParabolic).map firstParabolic.subtype = ResidualAction.K ∧
      ((pResidual 2 derivedFirst).map derivedFirst.subtype).map DerivedModel.subtype =
        ResidualAction.K ∧ Nat.card ResidualAction.K = 24 :=
  ⟨ResidualAction.first_residual, ResidualAction.derived_residual, ResidualAction.card_K⟩

/-- The entire residual fixes the first quaternion factor, and acts on the
second by its inner automorphisms and the specified cubic, with kernel Z. -/
public theorem g2_residual_quaternion_action :
    ResidualAction.K ≤ Subgroup.centralizer
        (ResidualAction.left.range : Set (Model (ZMod 2))) ∧
      ResidualAction.K ≤ Subgroup.normalizer
        (ResidualAction.right.range : Set (Model (ZMod 2))) ∧
      ResidualAction.action.range =
        (MulAut.conj : QuaternionGroup 2 →* MulAut (QuaternionGroup 2)).range ⊔
          Subgroup.zpowers ResidualAction.rightCubic ∧
      ResidualAction.action.ker.map ResidualAction.K.subtype = distinguished ∧
      ResidualAction.action ResidualAction.cubicInK = ResidualAction.rightCubic :=
  ⟨ResidualAction.K_fixes_left, ResidualAction.K_normalizes_right,
    ResidualAction.action_range, ResidualAction.action_kernel, ResidualAction.action_cubic⟩

public theorem g2_residual_core_action (k : ResidualAction.K) (q r : QuaternionGroup 2) :
    (k : Model (ZMod 2)) * (ResidualAction.left q * ResidualAction.right r) *
      (k : Model (ZMod 2))⁻¹ =
        ResidualAction.left q * ResidualAction.right (ResidualAction.action k r) :=
  ResidualAction.conjugate_core_product k q r

private theorem intrinsicCore_ambient (x : pCore 2 derivedFirst) :
    (derivedFirstCoreEquiv (g2_derived_first_core_model x) : Model (ZMod 2)) = x.val.val.val := by
  change (derivedFirstCoreEquiv (derivedFirstCoreEquiv.symm _) : Model (ZMod 2)) = _
  rw [MulEquiv.apply_symm_apply]
  rfl

/-- The specified cubic acts through the explicit isomorphism on the intrinsic O₂(H). -/
public theorem g2_derived_intrinsic_cubic_action (x : pCore 2 derivedFirst) :
    (⟨⟨cubicActor, cubicActor_mem_derived⟩, cubicActor_mem_derivedFirst⟩ : derivedFirst) *
      (x : derivedFirst) *
      (⟨⟨cubicActor, cubicActor_mem_derived⟩, cubicActor_mem_derivedFirst⟩ : derivedFirst)⁻¹ =
      (quaternionCyclicActor g2_derived_first_core_model x : derivedFirst) := by
  apply Subtype.ext
  apply Subtype.ext
  change cubicActor * x.val.val.val * cubicActor⁻¹ = _
  have hx := intrinsicCore_ambient x
  have hc := cubic_derivedFirstCore (g2_derived_first_core_model x)
  have hy := intrinsicCore_ambient (quaternionCyclicActor g2_derived_first_core_model x)
  have he : g2_derived_first_core_model (quaternionCyclicActor g2_derived_first_core_model x) =
      QuaternionCyclic.cubic (g2_derived_first_core_model x) :=
    g2_derived_first_core_model.apply_symm_apply _
  have hy' := (congrArg (fun y : QuaternionCyclic.Model =>
    (derivedFirstCoreEquiv y : Model (ZMod 2))) he).symm.trans hy
  exact ((congrArg (fun g : Model (ZMod 2) => cubicActor * g * cubicActor⁻¹) hx).symm.trans
    hc).trans hy'

/-- The actual derived parabolic discharges the cubic-realization premise of
the quaternion–cyclic source adapter. No automorphism-image premise remains. -/
public theorem g2_derived_residual_automorphisms :
    (pResidual 2 derivedFirst).map (MulAut.conjNormal (H := pCore 2 derivedFirst)) =
      pResidual 2 (MulAut (pCore 2 derivedFirst)) :=
  quaternionCyclic_normal_core_residual_image (pCore 2 derivedFirst)
    g2_derived_first_core_model
    ⟨⟨cubicActor, cubicActor_mem_derived⟩, cubicActor_mem_derivedFirst⟩
    g2_derived_intrinsic_cubic_action

/-- The first derived parabolic's residual acts as A₄ on its actual two-core. -/
public noncomputable def g2_derived_residual_action_equiv :
    (pResidual 2 derivedFirst).map (MulAut.conjNormal (H := pCore 2 derivedFirst)) ≃*
      alternatingGroup (Fin 4) :=
  (MulEquiv.subgroupCongr g2_derived_residual_automorphisms).trans
    (quaternionCyclicResidualEquiv g2_derived_first_core_model)

/-- The same action on the specified central quotient has precisely the
specified order-three image. -/
public theorem g2_derived_residual_quotient_action :
    (pResidual 2 derivedFirst).map
      ((quaternionCyclicQuotientAction g2_derived_first_core_model).comp
        (MulAut.conjNormal (H := pCore 2 derivedFirst))) =
      Subgroup.zpowers QuaternionCyclic.cubicQuotient := by
  rw [← Subgroup.map_map, g2_derived_residual_automorphisms,
    quaternionCyclic_residual_quotient_image]

/-- The elementary eight is normal in the second parabolic and self-centralizing
in the common Sylow subgroup, as required by the enlarged point-stabilizer argument. -/
public theorem g2_elementary_normal_and_centralizer :
    (elementary.subgroupOf secondParabolic).Normal ∧
      secondParabolic ≤ Subgroup.normalizer (elementary : Set (Model (ZMod 2))) ∧
      (commonSylow : Subgroup (Model (ZMod 2))) ⊓
        Subgroup.centralizer (elementary : Set (Model (ZMod 2))) = elementary :=
  ⟨inferInstance,
    (Subgroup.normal_subgroupOf_iff_le_normalizer elementary_le_secondParabolic).mp
      inferInstance,
    unipotent_centralizer_elementary⟩

/-- A compatible pair isomorphism preserves the same ambient marking of every
subgroup of the actual first core. -/
public theorem g2_marked_images_compatible {G : Type*} [Group G]
    (H' A' : Subgroup G) (eH : firstParabolic ≃* H') (eA : secondParabolic ≃* A')
    (hcompat : ∀ t : (commonSylow : Subgroup (Model (ZMod 2))),
      (eH ⟨t, commonSylow_le_first t.property⟩ : G) =
        (eA ⟨t, commonSylow_le_second t.property⟩ : G))
    (D : Subgroup (Model (ZMod 2))) (hD : D ≤ core) :
    ((D.subgroupOf firstParabolic).map eH.toMonoidHom).map H'.subtype =
      ((D.subgroupOf secondParabolic).map eA.toMonoidHom).map A'.subtype :=
  Subgroup.pair_map_eq_of_compatible firstParabolic secondParabolic commonSylow H' A'
    commonSylow_le_first commonSylow_le_second eH eA hcompat D
    (hD.trans core_le_unipotent)

end CFSG.Quasithin.Chapter14.Section02.SolvableAmalgam.SmallLocal.Parabolics
