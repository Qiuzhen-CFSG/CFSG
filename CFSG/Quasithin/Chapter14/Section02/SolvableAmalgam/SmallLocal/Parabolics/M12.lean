module

public import Theory.Mathieu.M12.SmallParabolicPair

/-!
# M₁₂ concrete input for the small-local argument

These witnesses retain the embedded quaternion factors, the marked elementary
subgroups, and the actual residual actors. Their permutations are certified
words in the standard M₁₂ generators. The first two-core is identified with
the quaternion product, the parabolics have a common Sylow two-subgroup,
and its omega center generates the natural four under the second parabolic.
The elementary eight is normal in that parabolic and self-centralizing in
the common Sylow subgroup. These are concrete model inputs for the chapter's
recognition and enlarged-local argument.

Source: Aschbacher–Smith, Lemma 14.2.21, printed p.988 (PDF p.1005).
-/

namespace CFSG.Quasithin.Chapter14.Section02.SolvableAmalgam.SmallLocal.Parabolics
open Sporadic.Mathieu Sporadic.Mathieu.M12SmallPair

public noncomputable def m12_core_factors : Subgroup.QuaternionCentralProductData core :=
  coreQuaternionData

public noncomputable def m12_local_cubic :
    Subgroup.QuaternionLocalCubic core firstParabolic coreQuaternionData := localCubic

/-- The actual two-core, with its ambient embedding preserved below. -/
public noncomputable def m12_first_core_model : pCore 2 firstParabolic ≃* core :=
  firstCoreEquiv

public theorem m12_first_core_model_apply (q : pCore 2 firstParabolic) :
    (m12_first_core_model q : M12) = (q.val : M12) := firstCoreEquiv_apply q

public noncomputable def m12_first_core_quotient :
    firstParabolic ⧸ pCore 2 firstParabolic ≃* Equiv.Perm (Fin 3) := firstCoreQuotient

public theorem m12_parabolic_orders :
    Nat.card firstParabolic = 192 ∧ Nat.card secondParabolic = 192 ∧
      Nat.card commonSylow = 64 :=
  ⟨card_firstParabolic, card_secondParabolic, card_sylowCandidate⟩

public theorem m12_first_core_and_overlap :
    (pCore 2 firstParabolic).map firstParabolic.subtype = core ∧
      firstParabolic ⊓ secondParabolic = (commonSylow : Subgroup M12) ∧
      (commonSylow : Subgroup M12) ≤ firstParabolic ∧
      (commonSylow : Subgroup M12) ≤ secondParabolic :=
  ⟨mapped_pCore_eq_core, commonSylow_intersection, inf_le_left, inf_le_right⟩

public theorem m12_common_sylows :
    (firstParabolicSylow : Subgroup firstParabolic).map firstParabolic.subtype =
        (commonSylow : Subgroup M12) ∧
      (secondParabolicSylow : Subgroup secondParabolic).map secondParabolic.subtype =
        (commonSylow : Subgroup M12) := by
  constructor
  · exact Subgroup.map_subgroupOf_eq_of_le (show sylowCandidate ≤ firstParabolic from inf_le_left)
  · exact Subgroup.map_subgroupOf_eq_of_le (show sylowCandidate ≤ secondParabolic from inf_le_right)

public theorem m12_sylow_marked_center :
    ((omega₁ (Subgroup.center commonSylow) (p := 2)).map
      (Subgroup.center commonSylow).subtype).map
        (commonSylow : Subgroup M12).subtype = distinguished := commonSylow_omega_center

public theorem m12_elementary_geometry :
    Nat.card core = 32 ∧ IsExtraspecial 2 core ∧
      Nat.card elementary = 8 ∧ IsElementaryAbelian 2 elementary ∧
      natural ≤ elementary ∧ elementary ≤ core ∧
      Nat.card natural = 4 ∧ z ∈ natural ∧ orderOf z = 2 :=
  ⟨card_core,extraspecial_core,card_elementary,inferInstance,
    natural_le_elementary,elementary_le_core,card_natural,z_mem_natural,z_order⟩

public theorem m12_marked_subgroups :
    Nat.card distinguished = 2 ∧ distinguished ≤ natural ∧
      natural ≤ elementary ∧ elementary ≤ core ∧ elementary ≤ secondParabolic :=
  ⟨card_distinguished,distinguished_le_natural,natural_le_elementary,
    elementary_le_core,elementary_le_secondParabolic⟩

public theorem m12_residual_actors :
    (⟨cubicActor,cubicActor_mem⟩ : firstParabolic) ∈ pResidual 2 firstParabolic ∧
    (⟨movingActor,movingActor_mem⟩ : secondParabolic) ∈ pResidual 2 secondParabolic ∧
    orderOf cubicActor = 3 ∧ orderOf movingActor = 3 ∧
    movingActor ∈ Subgroup.normalizer (elementary : Set M12) ∧
    movingActor * z * movingActor⁻¹ ≠ z :=
  ⟨cubicActor_residual,movingActor_residual,cubicActor_order,movingActor_order,
    movingActor_normalizes_elementary,movingActor_moves⟩

public theorem m12_natural_conjugate_generated : natural = Subgroup.closure
    {w : M12 | ∃ a ∈ secondParabolic, a * z * a⁻¹ = w} :=
  natural_eq_conjugateClosure

/-- The natural four is generated by the conjugates of Ω₁(Z(T)), as in 14.2.1. -/
public theorem m12_natural_source_generation : natural = Subgroup.closure
    {w : M12 | ∃ a ∈ secondParabolic,
      ∃ x ∈ ((omega₁ (Subgroup.center commonSylow) (p := 2)).map
        (Subgroup.center commonSylow).subtype).map (commonSylow : Subgroup M12).subtype,
      a * x * a⁻¹ = w} := natural_eq_omega_center_conjugateClosure

public theorem m12_elementary_normal_and_centralizer :
    (elementary.subgroupOf secondParabolic).Normal ∧
      secondParabolic ≤ Subgroup.normalizer (elementary : Set M12) ∧
      sylowCandidate ⊓ Subgroup.centralizer (elementary : Set M12) = elementary :=
  ⟨elementary_normal_secondParabolic, secondParabolic_normalizes_elementary,
    sylowCandidate_centralizer_elementary⟩

public theorem m12_sylow_elementary_action :
    (∀ t : sylowCandidate, ∀ e : elementary,
      (sylowElementaryAction t e : M12) = (t : M12) * e * (t : M12)⁻¹) ∧
      sylowElementaryAction.ker = elementary.subgroupOf sylowCandidate ∧
      Nat.card sylowElementaryAction.range = 8 :=
  ⟨sylowElementaryAction_apply, sylowElementaryAction_ker, card_sylowElementaryAction_range⟩

public theorem m12_first_residual_action (g : pResidual 2 firstParabolic) (q : core) :
    (residualCoreAction g q : M12) = (g.val : M12) * q * (g.val : M12)⁻¹ ∧
      (q ∈ coreQuaternionData.left → residualCoreAction g q ∈ coreQuaternionData.left) ∧
      (q ∈ coreQuaternionData.right → residualCoreAction g q ∈ coreQuaternionData.right) :=
  ⟨residualCoreAction_apply g q, residualCoreAction_preserves_left g q,
    residualCoreAction_preserves_right g q⟩

public theorem m12_cubic_factor_actions :
    residualLeftAction residualCubic = localCubic.actionLeft ∧
      residualRightAction residualCubic = localCubic.actionRight ∧
      residualLeftAction residualCubic ≠ 1 ∧ residualRightAction residualCubic ≠ 1 :=
  ⟨residualLeftAction_cubic, residualRightAction_cubic,
    residualLeftAction_cubic_ne_one, residualRightAction_cubic_ne_one⟩

public theorem m12_moving_point_transport {A : Type*} [Group A] (e : secondParabolic ≃* A) :
    let E := (elementary.subgroupOf secondParabolic).map e.toMonoidHom
    let zA := e ⟨z,elementary_le_secondParabolic (natural_le_elementary z_mem_natural)⟩
    zA ∈ E ∧ ∃ y : A, y ∈ pResidual 2 A ∧
      y ∈ Subgroup.normalizer (E : Set A) ∧ y * zA * y⁻¹ ≠ zA :=
  moving_point_transport e

/-- The constructed core lies in both parabolics, and its elementary eight
is self-centralizing inside the core. -/
public theorem m12_core_intersection_geometry :
    core ≤ sylowCandidate ∧ elementary ≤ sylowCandidate ∧
      core ⊓ Subgroup.centralizer (elementary : Set M12) = elementary ∧
      (∀ g : core, g ∈ Subgroup.center core ↔ (g : M12) = 1 ∨ (g : M12) = z) :=
  ⟨core_le_sylowCandidate, elementary_le_sylowCandidate,
    core_centralizer_elementary, core_center_mem⟩

public theorem m12_core_center_and_centralizer :
    (Subgroup.center core).map core.subtype = distinguished ∧
      firstParabolic = Subgroup.centralizer (distinguished : Set M12) ∧
      firstParabolic ⊓ Subgroup.centralizer (core : Set M12) = distinguished :=
  ⟨core_center_image, firstParabolic_eq_centralizer_distinguished,
    firstParabolic_centralizer_core⟩

/-- Compatible parabolic isomorphisms preserve the same embedded image of
each marked subgroup of the constructed core. -/
public theorem m12_marked_images_compatible {G : Type*} [Group G]
    (H' A' : Subgroup G) (eH : firstParabolic ≃* H') (eA : secondParabolic ≃* A')
    (hcompat : ∀ t : sylowCandidate,
      (eH ⟨t, t.property.1⟩ : G) = (eA ⟨t, t.property.2⟩ : G))
    (D : Subgroup M12) (hD : D ≤ core) :
    ((D.subgroupOf firstParabolic).map eH.toMonoidHom).map H'.subtype =
      ((D.subgroupOf secondParabolic).map eA.toMonoidHom).map A'.subtype :=
  Subgroup.pair_map_eq_of_compatible firstParabolic secondParabolic sylowCandidate
    H' A' inf_le_left inf_le_right eH eA hcompat D (hD.trans core_le_sylowCandidate)

end CFSG.Quasithin.Chapter14.Section02.SolvableAmalgam.SmallLocal.Parabolics
