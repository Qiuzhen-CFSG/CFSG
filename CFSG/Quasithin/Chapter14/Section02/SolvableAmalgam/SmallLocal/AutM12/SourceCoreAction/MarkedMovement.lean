module
public import Theory.GroupTheory.QuaternionSwapModel.MarkedCubic
public import Theory.GroupTheory.QuaternionSwapModel.MarkedSylow.SecondParabolic
public import Theory.GroupTheory.PResidual.Defs

/-!
# Marked movement in the normalizer of the actual Thompson subgroup

For a compatible local pair, the whole-overlap normal forms force its unique
largest elementary subgroup to be the displayed sixteen. Four equations for
the second-parabolic generator make this actual Thompson subgroup normal in
that parabolic and identify the conjugate-generated source V with the marked
plane. The product of two compatible binary-tetrahedral cubics belongs to
the actual embedded O²(Mc), normalizes this Thompson subgroup, and moves V.
No whole SL₂(3) factor is required to normalize the Thompson subgroup.

Source: Aschbacher--Smith, proof of 14.2.21, printed p.988 (PDF p.1005),
final Aut(M12) paragraph. This is the conditional geometry theorem; the
source assembly owner must instantiate all of the following model equations:

* The injective swap map sends the marked center, quaternion core and both
  quaternion factors to the actual specified subgroups. Its two cosets with
  the extra involution fill the actual whole-overlap Sylow subgroup. That
  involution acts by `MarkedSylow.twist`: i ↦ ji, j ↦ -j and swap ↦ z * swap.
* The second parabolic is generated by this whole overlap and y. On the four
  ordered generators `(diagonal i, diagonal j, z, swap)`, y acts as
  `(diagonal i, diagonal j * z, diagonal j, diagonal j * swap)`.
* V has its source conjugate-generation definition from the actual Z and YT.
* The two literal binary-tetrahedral embeddings commute, meet in the marked
  center, span the embedded O²(Mc), extend the specified quaternion maps,
  and are exchanged by the marked swapping involution.

The swap subgroup is not identified with O₂(H). No assumed Thompson
structure, Thompson normality, moving witness, or legacy marked-residual
record is used. The concrete M12 core comparison for the marked plane is
proved separately in `M12SmallPair.MarkedMovementCoordinates.markedPlane_image`.
The compatible outer pair and residual-embedding constructions remain with
the parent task; the main theorem below proves all movement conclusions
from these explicit structural equations.
-/

namespace CFSG.Quasithin.Chapter14.Section02.SolvableAmalgam.SmallLocal.AutM12.SourceCoreAction.MarkedMovement
open QuaternionSwapModel QuaternionSwapModel.MarkedCubic
open GLS3.Chapter5.SchurPresentation

/-- Literal residual embeddings and their compatibility with the marked swap.
The central-product overlap and span refer to the actual ambient subgroups.
The swapping equation is on the factors, not on a proposed moving element. -/
public structure CompatibleResidualSwap
    {G : Type*} [Group G] (f : QH →* G) (Kc : Subgroup G) where
  left : BinaryTetrahedral →* G
  right : BinaryTetrahedral →* G
  left_injective : Function.Injective left
  right_injective : Function.Injective right
  commute : ∀ l r, left l * right r = right r * left l
  left_quaternion : ∀ q, left (quaternion q) = f (leftEmbedding q)
  right_quaternion : ∀ q, right (quaternion q) = f (rightEmbedding q)
  intersection : left.range ⊓ right.range = Z.map f
  span : left.range ⊔ right.range = Kc
  swap_left : ∀ b, f swap * left b * (f swap)⁻¹ = right b

variable {G : Type*} [Group G] {f : QH →* G} {Kc : Subgroup G}

/-- The two compatible cubic factors determine the element; it is not a witness input. -/
public def diagonalCubic (d : CompatibleResidualSwap f Kc) : G :=
  d.left cubic * d.right cubic

public theorem diagonalCubic_mem (d : CompatibleResidualSwap f Kc) :
    diagonalCubic d ∈ Kc := by
  apply d.span.le
  exact Subgroup.mul_mem _
    ((show d.left.range ≤ d.left.range ⊔ d.right.range from le_sup_left) ⟨cubic, rfl⟩)
    ((show d.right.range ≤ d.left.range ⊔ d.right.range from le_sup_right) ⟨cubic, rfl⟩)

private theorem swap_right (d : CompatibleResidualSwap f Kc) (b : BinaryTetrahedral) :
    f swap * d.right b * (f swap)⁻¹ = d.left b := by
  have hs : f swap * f swap = 1 := by
    rw [← map_mul, ← pow_two, swap_square, map_one]
  rw [← d.swap_left b]
  calc
    f swap * (f swap * d.left b * (f swap)⁻¹) * (f swap)⁻¹ =
        (f swap * f swap) * d.left b * (f swap * f swap)⁻¹ := by group
    _ = d.left b := by rw [hs]; simp

private theorem diagonalCubic_swap (d : CompatibleResidualSwap f Kc) :
    diagonalCubic d * f swap * (diagonalCubic d)⁻¹ = f swap := by
  have h : f swap * diagonalCubic d * (f swap)⁻¹ = diagonalCubic d := by
    calc
      f swap * diagonalCubic d * (f swap)⁻¹ =
          (f swap * d.left cubic * (f swap)⁻¹) *
            (f swap * d.right cubic * (f swap)⁻¹) := by unfold diagonalCubic; group
      _ = d.right cubic * d.left cubic := by rw [d.swap_left, swap_right d]
      _ = diagonalCubic d := (d.commute cubic cubic).symm
  have hc : f swap * diagonalCubic d = diagonalCubic d * f swap := by
    simpa only [mul_assoc, inv_mul_cancel, mul_one] using congrArg (fun x => x * f swap) h
  rw [← hc, mul_assoc, mul_inv_cancel, mul_one]

private theorem diagonalCubic_left (d : CompatibleResidualSwap f Kc)
    (q : QuaternionGroup 2) :
    diagonalCubic d * f (leftEmbedding q) * (diagonalCubic d)⁻¹ =
      f (leftEmbedding (q8Cycle q)) := by
  rw [← d.left_quaternion, ← d.left_quaternion]
  calc
    diagonalCubic d * d.left (quaternion q) * (diagonalCubic d)⁻¹ =
        d.left cubic * (d.right cubic * d.left (quaternion q)) *
          (d.right cubic)⁻¹ * (d.left cubic)⁻¹ := by unfold diagonalCubic; group
    _ = d.left cubic * d.left (quaternion q) * (d.left cubic)⁻¹ := by
      rw [← d.commute]; group
    _ = d.left (quaternion (q8Cycle q)) := by
      simpa only [map_mul, map_inv] using congrArg d.left (cubic_quaternion q)

private theorem diagonalCubic_right (d : CompatibleResidualSwap f Kc)
    (q : QuaternionGroup 2) :
    diagonalCubic d * f (rightEmbedding q) * (diagonalCubic d)⁻¹ =
      f (rightEmbedding (q8Cycle q)) := by
  rw [← d.right_quaternion, ← d.right_quaternion]
  calc
    diagonalCubic d * d.right (quaternion q) * (diagonalCubic d)⁻¹ =
        d.left cubic * (d.right cubic * d.right (quaternion q) * (d.right cubic)⁻¹) *
          (d.left cubic)⁻¹ := by unfold diagonalCubic; group
    _ = d.left cubic * d.right (quaternion (q8Cycle q)) * (d.left cubic)⁻¹ := by
      rw [← map_inv, ← map_mul, ← map_mul, cubic_quaternion]
    _ = d.right (quaternion (q8Cycle q)) := by
      rw [d.commute, mul_assoc, mul_inv_cancel, mul_one]

set_option maxRecDepth 100000 in
set_option maxHeartbeats 2000000 in
private theorem raw_decomposition (w : Raw) :
    w = leftRaw (w.left 1) * rightRaw (w.left turn) *
      swapRaw ^ w.right.toAdd.val := by
  have h : ∀ w : Raw, w = leftRaw (w.left 1) * rightRaw (w.left turn) *
      swapRaw ^ w.right.toAdd.val := by decide +kernel
  exact h w

/-- Conjugation by the constructed element is the diagonal quaternion cubic
on the entire embedded swap subgroup, with the original embedding unchanged. -/
public theorem diagonalCubic_action (d : CompatibleResidualSwap f Kc) (x : QH) :
    diagonalCubic d * f x * (diagonalCubic d)⁻¹ = f (cycle x) := by
  let F : Raw →* G := (MulAut.conj (diagonalCubic d)).toMonoidHom.comp (f.comp projection)
  let H : Raw →* G := (f.comp projection).comp rawCycle
  have hl (q : QuaternionGroup 2) : F (leftRaw q) = H (leftRaw q) := by
    have he : rawCycle (leftRaw q) = leftRaw (q8Cycle q) := by
      have h : ∀ q : QuaternionGroup 2, rawCycle (leftRaw q) = leftRaw (q8Cycle q) := by
        decide +kernel
      exact h q
    change diagonalCubic d * f (leftEmbedding q) * (diagonalCubic d)⁻¹ =
      f (projection (rawCycle (leftRaw q)))
    rw [he]
    exact diagonalCubic_left d q
  have hr (q : QuaternionGroup 2) : F (rightRaw q) = H (rightRaw q) := by
    have he : rawCycle (rightRaw q) = rightRaw (q8Cycle q) := by
      have h : ∀ q : QuaternionGroup 2, rawCycle (rightRaw q) = rightRaw (q8Cycle q) := by
        decide +kernel
      exact h q
    change diagonalCubic d * f (rightEmbedding q) * (diagonalCubic d)⁻¹ =
      f (projection (rawCycle (rightRaw q)))
    rw [he]
    exact diagonalCubic_right d q
  have hs : F swapRaw = H swapRaw := by
    have he : rawCycle swapRaw = swapRaw := by decide +kernel
    change diagonalCubic d * f swap * (diagonalCubic d)⁻¹ =
      f (projection (rawCycle swapRaw))
    rw [he]
    exact diagonalCubic_swap d
  obtain ⟨w, rfl⟩ := QuotientGroup.mk'_surjective diagonalCenter x
  change F w = H w
  conv_lhs => rw [raw_decomposition w]
  conv_rhs => rw [raw_decomposition w]
  simp only [map_mul, map_pow, hl, hr, hs]

/-- This element lies in the normalizer of the literal image of the sixteen. -/
public theorem diagonalCubic_normalizes (d : CompatibleResidualSwap f Kc) :
    diagonalCubic d ∈ Subgroup.normalizer (A.map f : Set G) := by
  apply Subgroup.mem_normalizer_iff_map_conj_eq.mpr
  change (A.map f).map (MulAut.conj (diagonalCubic d)).toMonoidHom = A.map f
  have hc : (MulAut.conj (diagonalCubic d)).toMonoidHom.comp f = f.comp cycle := by
    ext x
    exact diagonalCubic_action d x
  rw [Subgroup.map_map, hc, ← Subgroup.map_map, cycle_preserves_A]

/-- The same element fails to preserve the literal image of the marked plane. -/
public theorem diagonalCubic_moves (d : CompatibleResidualSwap f Kc)
    (hf : Function.Injective f) :
    (markedPlane.map f).map (MulAut.conj (diagonalCubic d)).toMonoidHom ≠ markedPlane.map f := by
  intro he
  have hc : (MulAut.conj (diagonalCubic d)).toMonoidHom.comp f = f.comp cycle := by
    ext x
    exact diagonalCubic_action d x
  rw [Subgroup.map_map, hc, ← Subgroup.map_map] at he
  apply cycle_moves_markedPlane
  apply le_antisymm
  · exact (Subgroup.map_le_map_iff_of_injective hf).mp he.le
  · exact (Subgroup.map_le_map_iff_of_injective hf).mp he.ge

/-- The intrinsic movement conclusion. The natural subgroup remains the
specified ambient `V`; its compatibility with the marked plane is explicit.
No statement identifying `A.map f` with `J(T)` is presumed here. -/
public theorem movement_on_embedded_sixteen (d : CompatibleResidualSwap f Kc)
    (hf : Function.Injective f) (V : Subgroup G) (hV : V = markedPlane.map f) :
    Nonempty ((A.map f) ≃* E16) ∧
      ∃ g : (Kc ⊓ Subgroup.normalizer (A.map f : Set G) : Subgroup G),
        V.map (MulAut.conj (g : G)).toMonoidHom ≠ V := by
  refine ⟨⟨(A.equivMapOfInjective f hf).symm.trans elementaryEquiv⟩, ?_⟩
  refine ⟨⟨diagonalCubic d, diagonalCubic_mem d, diagonalCubic_normalizes d⟩, ?_⟩
  subst V
  exact diagonalCubic_moves d hf


/-- The compatible local pair, with the actual whole overlap, marked center,
quaternion core and both of its prescribed factors. The two-coset Sylow
normal forms and four second-parabolic equations are inherited explicitly.
`natural` is the source definition of V as the conjugate-generated subgroup;
there is no premise identifying V with the coordinate plane. -/
public structure CompatibleMarkedPair
    {G : Type*} [Group G] (f : QH →* G) (T : Sylow 2 G)
    (H YT Z₀ V Q₀ B C : Subgroup G)
    extends MarkedSylow.SecondGeometry f (T : Subgroup G) YT where
  whole_overlap : H ⊓ YT = (T : Subgroup G)
  marked : Z₀ = Z.map f
  marked_normal : (Z₀.subgroupOf (T : Subgroup G)).Normal
  core : Q₀ = QK.map f
  left_factor : B = leftFactor.map f
  right_factor : C = rightFactor.map f
  natural : V = Subgroup.closure
    {w : G | ∃ a ∈ YT, ∃ x ∈ Z₀, a * x * a⁻¹ = w}

/-- The actual source natural subgroup is the marked coordinate plane, derived
from its conjugate-generation definition and the second-parabolic equations. -/
public theorem marked_pair_natural
    {G : Type*} [Group G] [Finite G] {f : QH →* G} {T : Sylow 2 G}
    {H YT Z₀ V Q₀ B C : Subgroup G}
    (p : CompatibleMarkedPair f T H YT Z₀ V Q₀ B C) : V = markedPlane.map f := by
  rw [p.natural,p.marked]
  exact p.toSecondGeometry.conjugateClosure_eq_plane

/-- The marked normalizer conclusion of the final Aut(M12) paragraph of
14.2.21, conditional only on the displayed compatible-map equations.
The residual input is an embedding onto the actual O²(Mc), extending both
marked quaternion factors and their common center. The element is the product
of the two canonical cubics. Its membership in the residual, normalization
of the actual J(T), and movement of the actual conjugate-generated V are all
conclusions. The assembly owner must instantiate `CompatibleMarkedPair` and
`CompatibleResidualSwap`; this theorem does not identify a concrete outer
parabolic pair by itself. -/
public theorem marked_thompson_normalizer_movement
    {G : Type*} [Group G] [Finite G] {f : QH →* G} {T : Sylow 2 G}
    {H YT Z₀ V Q₀ B C : Subgroup G} (Mc : Subgroup G)
    (p : CompatibleMarkedPair f T H YT Z₀ V Q₀ B C)
    (r : CompatibleResidualSwap f ((pResidual 2 Mc).map Mc.subtype)) :
    Nat.card Z₀ = 2 ∧
    Nonempty (Stellmacher.elementaryAbelianMaxJ (T : Subgroup G) ≃* E16) ∧
    Stellmacher.elementaryAbelianMaxJ (T : Subgroup G) ≤ YT ∧
    ((Stellmacher.elementaryAbelianMaxJ (T : Subgroup G)).subgroupOf YT).Normal ∧
    ∃ g : ((pResidual 2 Mc).map Mc.subtype ⊓
        Subgroup.normalizer (Stellmacher.elementaryAbelianMaxJ (T : Subgroup G) : Set G)
        : Subgroup G),
      V.map (MulAut.conj (g : G)).toMonoidHom ≠ V := by
  have hZ : Nat.card Z₀ = 2 := by
    rw [p.marked,Subgroup.card_map_of_injective p.injective,card_Z]
  have hJ := p.toSecondGeometry.toGeometry.thompson_eq
  have hV := marked_pair_natural p
  obtain ⟨hE,hm⟩ := movement_on_embedded_sixteen r p.injective V hV
  rw [hJ]
  refine ⟨hZ,hE,?_,p.toSecondGeometry.A_normal,hm⟩
  exact p.toSecondGeometry.toGeometry.A_le.trans (p.span.ge.trans' le_sup_left)

end CFSG.Quasithin.Chapter14.Section02.SolvableAmalgam.SmallLocal.AutM12.SourceCoreAction.MarkedMovement
