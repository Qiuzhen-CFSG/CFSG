module

public import Theory.GroupTheory.SpecificGroups.QuaternionCyclicResidual
public import Mathlib.GroupTheory.GroupAction.ConjAct

/-!
# The quaternion–cyclic core in Lemma 14.2.21

The concrete core is the central product of its embedded Q₈ and C₄ factors.
An explicit identification of a local core with this model transports both
the cubic action and its central quotient map. The displayed equivariance
equation retains the action needed to compare the parabolic with the larger
local group.

The intrinsic two-residual is A₄, generated by the inner actions and this
cubic. If these generators lie in a parabolic residual image, that image
equals the full intrinsic residual. For a finite acting group it suffices
that its full image contains the generators. The quotient image is the
specified cyclic group of order three. The concrete parabolic identification
and its generator witnesses are supplied by the application.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
Lemma 14.2.21, printed p.988 (PDF page 1005).
-/

namespace CFSG.Quasithin.Chapter14.Section02.SolvableAmalgam.SmallLocal

open QuaternionCyclic

/-- A concrete central product with actual inclusions of both factors. -/
public theorem quaternion_cyclic_model_geometry :
    Nat.card Model = 16 ∧
      Function.Injective quaternionEmbedding ∧
      Function.Injective cyclicEmbedding ∧
      quaternionEmbedding.range ⊔ cyclicEmbedding.range = ⊤ ∧
      Nat.card (quaternionEmbedding.range ⊓ cyclicEmbedding.range : Subgroup Model) = 2 ∧
      Subgroup.center Model = cyclicEmbedding.range :=
  ⟨card_model, quaternionEmbedding_injective, cyclicEmbedding_injective,
    factors_generate, card_factor_intersection, center_eq_cyclic⟩

/-- The specified cubic actor on a core identified with Q₈ ◦ C₄. -/
@[expose] public def quaternionCyclicActor {Q : Type*} [Group Q]
    (e : Q ≃* Model) : MulAut Q := (MulAut.congr e).symm cubic

/-- Its specified quotient map, rather than an unmarked elementary group. -/
@[expose] public def quaternionCyclicQuotient {Q : Type*} [Group Q]
    (e : Q ≃* Model) : Q →* CentralQuotient := centralQuotient.comp e.toMonoidHom

public theorem quaternionCyclicActor_order {Q : Type*} [Group Q]
    (e : Q ≃* Model) : orderOf (quaternionCyclicActor e) = 3 := by
  rw [quaternionCyclicActor, (MulAut.congr e).symm.orderOf_eq, cubic_order]

/-- The quotient action is the actual action induced by the cubic actor. -/
public theorem quaternionCyclicActor_quotient {Q : Type*} [Group Q]
    (e : Q ≃* Model) (x : Q) :
    quaternionCyclicQuotient e (quaternionCyclicActor e x) =
      cubicQuotient (quaternionCyclicQuotient e x) := by
  change centralQuotient (e (e.symm (cubic (e x)))) =
    cubicQuotient (centralQuotient (e x))
  rw [e.apply_symm_apply]
  exact cubic_centralQuotient (e x)

public theorem quaternionCyclicQuotient_surjective {Q : Type*} [Group Q]
    (e : Q ≃* Model) : Function.Surjective (quaternionCyclicQuotient e) :=
  centralQuotient_surjective.comp e.surjective

public theorem quaternionCyclicQuotient_ker {Q : Type*} [Group Q]
    (e : Q ≃* Model) : (quaternionCyclicQuotient e).ker = Subgroup.center Q := by
  ext x
  change centralQuotient (e x) = 1 ↔ x ∈ Subgroup.center Q
  rw [← MonoidHom.mem_ker, centralQuotient_ker]
  constructor
  · intro hx
    have h := (Subgroup.centerCongr e.symm ⟨e x, hx⟩).property
    change e.symm (e x) ∈ Subgroup.center Q at h
    simpa only [MulEquiv.symm_apply_apply] using h
  · intro hx
    exact (Subgroup.centerCongr e ⟨x, hx⟩).property

/-- The intrinsic two-residual of a quaternion–cyclic core is A₄. -/
public noncomputable def quaternionCyclicResidualEquiv {Q : Type*} [Group Q]
    (e : Q ≃* Model) : pResidual 2 (MulAut Q) ≃* alternatingGroup (Fin 4) :=
  ((MulAut.congr e).subgroupMap _).trans
    ((MulEquiv.subgroupCongr (Subgroup.map_pResidual 2 (MulAut.congr e))).trans
      QuaternionCyclic.residualEquivAlternating)

/-- The A₄ identification is the four-diagonal action of the restricted
quaternion automorphism, after the specified transport of the core. -/
public theorem quaternionCyclicResidualEquiv_apply {Q : Type*} [Group Q]
    (e : Q ≃* Model) (a : pResidual 2 (MulAut Q)) :
    (quaternionCyclicResidualEquiv e a : Equiv.Perm (Fin 4)) =
      QuaternionGroup.Residual.autEquivPerm
        (QuaternionCyclic.restrictionHom (MulAut.congr e a)) :=
  QuaternionCyclic.residualEquivAlternating_apply _

private theorem map_inner_congr {Q : Type*} [Group Q] (e : Q ≃* Model) :
    ((MulAut.conj : Q →* MulAut Q).range).map (MulAut.congr e).toMonoidHom =
      (MulAut.conj : Model →* MulAut Model).range := by
  have h (x : Q) : MulAut.congr e (MulAut.conj x) = MulAut.conj (e x) := by
    apply MulEquiv.ext
    intro y
    change e (x * e.symm y * x⁻¹) = e x * y * (e x)⁻¹
    simp only [map_mul, map_inv, e.apply_symm_apply]
  apply le_antisymm
  · rintro _ ⟨_, ⟨x, rfl⟩, rfl⟩
    exact ⟨e x, (h x).symm⟩
  · rintro _ ⟨x, rfl⟩
    refine ⟨MulAut.conj (e.symm x), ⟨e.symm x, rfl⟩, ?_⟩
    change MulAut.congr e (MulAut.conj (e.symm x)) = MulAut.conj x
    rw [h, e.apply_symm_apply]

/-- The residual is generated by the actual inner actions and the specified
cubic actor, with no assumed automorphism image. -/
public theorem quaternionCyclic_residual_eq_join {Q : Type*} [Group Q]
    (e : Q ≃* Model) : pResidual 2 (MulAut Q) =
      (MulAut.conj : Q →* MulAut Q).range ⊔
        Subgroup.zpowers (quaternionCyclicActor e) := by
  apply Subgroup.map_injective (f := (MulAut.congr e).toMonoidHom)
    (MulAut.congr e).injective
  rw [Subgroup.map_pResidual, Subgroup.map_sup, map_inner_congr,
    MonoidHom.map_zpowers]
  have h : MulAut.congr e (quaternionCyclicActor e) = cubic :=
    (MulAut.congr e).apply_symm_apply cubic
  rw [show (MulAut.congr e).toMonoidHom (quaternionCyclicActor e) = cubic from h]
  exact QuaternionCyclic.residual_eq_join

/-- If a parabolic residual supplies the inner actions and the cubic actor,
its image is the entire intrinsic two-residual of the core automorphism group. -/
public theorem quaternionCyclic_residual_image {P Q : Type*} [Group P] [Group Q]
    (e : Q ≃* Model) (ρ : P →* MulAut Q)
    (hi : (MulAut.conj : Q →* MulAut Q).range ≤ (pResidual 2 P).map ρ)
    (hc : quaternionCyclicActor e ∈ (pResidual 2 P).map ρ) :
    (pResidual 2 P).map ρ = pResidual 2 (MulAut Q) := by
  apply le_antisymm (Subgroup.map_pResidual_le 2 ρ)
  rw [quaternionCyclic_residual_eq_join e]
  exact sup_le hi (Subgroup.zpowers_le.mpr hc)

/-- For a finite parabolic, containment of the generators in the full action
image already determines its residual image. -/
public theorem quaternionCyclic_residual_image_of_range_contains
    {P Q : Type*} [Group P] [Finite P] [Group Q]
    (e : Q ≃* Model) (ρ : P →* MulAut Q)
    (hi : (MulAut.conj : Q →* MulAut Q).range ≤ ρ.range)
    (hc : quaternionCyclicActor e ∈ ρ.range) :
    (pResidual 2 P).map ρ = pResidual 2 (MulAut Q) := by
  apply Subgroup.map_injective (f := (MulAut.congr e).toMonoidHom)
    (MulAut.congr e).injective
  rw [Subgroup.map_map, Subgroup.map_pResidual]
  apply QuaternionCyclic.residual_image_of_range_contains
  · rw [← map_inner_congr e, MonoidHom.range_comp]
    exact Subgroup.map_mono hi
  · obtain ⟨p, hp⟩ := hc
    refine ⟨p, ?_⟩
    change MulAut.congr e (ρ p) = cubic
    rw [hp]
    exact (MulAut.congr e).apply_symm_apply cubic

/-- Applied to an actual normal core, a conjugating element realizing the
specified cubic suffices; the core itself supplies all inner actions. -/
public theorem quaternionCyclic_normal_core_residual_image
    {P : Type*} [Group P] [Finite P] (Q : Subgroup P) [Q.Normal]
    (e : Q ≃* Model) (c : P)
    (hc : ∀ x : Q, c * (x : P) * c⁻¹ = (quaternionCyclicActor e x : P)) :
    (pResidual 2 P).map (MulAut.conjNormal (H := Q)) = pResidual 2 (MulAut Q) := by
  apply quaternionCyclic_residual_image_of_range_contains e
  · rintro _ ⟨x, rfl⟩
    exact ⟨(x : P), MulAut.conjNormal_val⟩
  · refine ⟨c, ?_⟩
    apply MulEquiv.ext
    intro x
    apply Subtype.ext
    exact hc x

/-- A₄ as the actual residual action image of the parabolic on its core. -/
public noncomputable def quaternionCyclicParabolicResidualImageEquiv
    {P Q : Type*} [Group P] [Group Q] (e : Q ≃* Model) (ρ : P →* MulAut Q)
    (hi : (MulAut.conj : Q →* MulAut Q).range ≤ (pResidual 2 P).map ρ)
    (hc : quaternionCyclicActor e ∈ (pResidual 2 P).map ρ) :
    (pResidual 2 P).map ρ ≃* alternatingGroup (Fin 4) :=
  (MulEquiv.subgroupCongr (quaternionCyclic_residual_image e ρ hi hc)).trans
    (quaternionCyclicResidualEquiv e)

/-- The automorphism action on the specified central quotient coordinates. -/
public noncomputable def quaternionCyclicQuotientAction {Q : Type*} [Group Q]
    (e : Q ≃* Model) : MulAut Q →* MulAut CentralQuotient :=
  QuaternionCyclic.quotientAction.comp (MulAut.congr e).toMonoidHom

public theorem quaternionCyclicQuotientAction_apply {Q : Type*} [Group Q]
    (e : Q ≃* Model) (a : MulAut Q) (x : Q) :
    quaternionCyclicQuotientAction e a (quaternionCyclicQuotient e x) =
      quaternionCyclicQuotient e (a x) := by
  change QuaternionCyclic.quotientAction (MulAut.congr e a) (centralQuotient (e x)) = _
  rw [QuaternionCyclic.quotientAction_apply]
  change centralQuotient (e (a (e.symm (e x)))) = centralQuotient (e (a x))
  rw [e.symm_apply_apply]

/-- The residual quotient image is the specified cyclic group of order three. -/
public theorem quaternionCyclic_residual_quotient_image {Q : Type*} [Group Q]
    (e : Q ≃* Model) :
    (pResidual 2 (MulAut Q)).map (quaternionCyclicQuotientAction e) =
      Subgroup.zpowers cubicQuotient := by
  change (pResidual 2 (MulAut Q)).map
    (QuaternionCyclic.quotientAction.comp (MulAut.congr e).toMonoidHom) = _
  rw [← Subgroup.map_map, Subgroup.map_pResidual, QuaternionCyclic.residual_quotient_image]

/-- The same marked quotient action for the residual image of the parabolic. -/
public theorem quaternionCyclic_parabolic_quotient_image {P Q : Type*} [Group P] [Group Q]
    (e : Q ≃* Model) (ρ : P →* MulAut Q)
    (hi : (MulAut.conj : Q →* MulAut Q).range ≤ (pResidual 2 P).map ρ)
    (hc : quaternionCyclicActor e ∈ (pResidual 2 P).map ρ) :
    (pResidual 2 P).map ((quaternionCyclicQuotientAction e).comp ρ) =
      Subgroup.zpowers cubicQuotient := by
  rw [← Subgroup.map_map, quaternionCyclic_residual_image e ρ hi hc,
    quaternionCyclic_residual_quotient_image]

end CFSG.Quasithin.Chapter14.Section02.SolvableAmalgam.SmallLocal
