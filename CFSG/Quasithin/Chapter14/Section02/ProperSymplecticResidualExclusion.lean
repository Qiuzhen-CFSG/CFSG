module
public import CFSG.Quasithin.Chapter14.Section02.ProperSymplecticBorelExclusion
public import CFSG.Quasithin.Chapter14.Section02.ProperOutsideSylow
public import CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels.SymplecticCubicResidual
public import Theory.GroupTheory.PResidual.PrimeToPerfect

/-!
# The symplectic source residual and Borel contradiction

The literal source subgroup Y is two-perfect and has a two-group kernel
with quotient of order three, so it is generated by its three-elements.
For the cubic symplectic component, the proved A.3.18 field-action
calculation identifies the ambient prime-to-three residual with L. It
therefore places Y in L, discharging that premise of the actual Borel
consumer. The central two-kernel is recovered from the marked quotient;
no centerlessness of the original quasisimple component is assumed.

Source: Aschbacher--Smith A.3.18 and 14.2.15, printed pp.985--986.
The remaining containing-row selection is separate. All fields of order
at least four are covered.
-/

public section
open Subgroup Theory.GroupTheory Stellmacher
namespace CFSG.Quasithin.Chapter14.Section02
open SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
variable {G : Type*} [Group G] [Finite G]

/-- The literal source residual is generated by its three-elements. -/
private theorem symplectic_source_residual_three_generated
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    : primeToResidual 3 (sourceResidual M Mc) = ⊤ := by
  have hc := source_residual_twoCore_quotient_card hG T hempty hM hu hmany hcard e
  have hp : IsPGroup 3 (sourceResidual M Mc ⧸ pCore 2 (sourceResidual M Mc)) :=
    isPGroup_iff_card_dvd_pow.mpr ⟨1, by rw [hc]; norm_num⟩
  exact primeToResidual_eq_top_of_pGroup_quotient 3 2 _ pCore_isPGroup hp
    (residualY_isPPerfect M Mc)

/-- The complete symplectic branch derives its earlier A.3.18 placement. -/
theorem source_proper_completion_symplectic_exclusion
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (H : Subgroup G) (hH : H ∈ Chapter3.HStar (T : Subgroup G) M)
    (K S : Subgroup G) (hST : S ≤ (T : Subgroup G))
    (hi : S.relIndex (T : Subgroup G) = 2)
    (hN : normalizer (omegaOneCenterAmbient S : Set G) ≤ Mc)
    (hplacement : ∀ P : Sylow 2 Mc, S ≤ (P : Subgroup Mc).map Mc.subtype →
      maximalTwoLocalOvergroups (K ⊔ (P : Subgroup Mc).map Mc.subtype) = {Mc})
    (hgen : K ⊔ (T : Subgroup G) = H)
    (hK : K ∈ Chapter1.L G S) (hSN : S ≤ normalizer (K : Set G))
    (hcore : pCore 2 (K ⊔ sourceResidual M Mc ⊔ S : Subgroup G) ≠ ⊥)
    {F : Type*} [Field F] [Finite F] [CharP F 2]
    {n : ℕ} (hF : Nat.card F = 2 ^ n) (hn : 2 ≤ n) :
    let X := K ⊔ sourceResidual M Mc ⊔ S
    let L := (solvableResidual X).map X.subtype
    IsQuasisimple L →
      Nonempty ((L ⧸ pCore 2 L) ≃* Matrix.symplecticGroup (Fin 2) F) → False := by
  let X := K ⊔ sourceResidual M Mc ⊔ S
  let L := (solvableResidual X).map X.subtype
  let Y := sourceResidual M Mc
  change IsQuasisimple L → Nonempty ((L ⧸ pCore 2 L) ≃* Matrix.symplecticGroup (Fin 2) F) → False
  rintro hq ⟨eL⟩
  let := hq
  have hcorea : X.pCoreIn 2 ≠ ⊥ := fun hh =>
    hcore (((pCore 2 X).map_eq_bot_iff_of_injective X.subtype_injective).mp hh)
  have hs := source_proper_completion_sylow hG T hempty hM hu hmany hcard e H hH
    K S hST hi hN hplacement hcore
  obtain ⟨hL,_,_⟩ := source_proper_completion_component hG T hempty hM hu hmany
    hcard e K S hST hK hSN hcorea hs
  let C := L.subgroupOf X
  let d := subgroupOfEquivOfLe hL.1
  let : IsQuasisimple C := IsQuasisimple.of_mulEquiv d.symm
  have hC : IsComponent X C := ⟨hL.2.subnormal,inferInstance⟩
  have hsq := Chapter1.RadicalExclusions.sqtk_of_mem_H hG hcorea
  let eC := (QuotientGroup.congr _ _ d (pCore_map_iso 2 d)).trans eL
  have hres : C = primeToResidual 3 X :=
    ChapterA.Section03.OddPrime.SourceModels.SymplecticCubicResidual.component_eq_cubic_residual_of_twoCore_model
      hsq hC (by rw [hF]; exact (by norm_num : 2 = 2 ^ 1) ▸ Nat.pow_lt_pow_right (by decide) (by omega)) eC
  have hYX : Y ≤ X := le_sup_right.trans le_sup_left
  have hy := symplectic_source_residual_three_generated hG T hempty hM hu hmany hcard e
  have hyX : primeToResidual 3 (Y.subgroupOf X) = ⊤ := by
    rw [←map_primeToResidual_of_surjective 3 (subgroupOfEquivOfLe hYX).symm.toMonoidHom
      (subgroupOfEquivOfLe hYX).symm.surjective,hy,←MonoidHom.range_eq_map]
    exact (subgroupOfEquivOfLe hYX).symm.range_eq_top
  have hYC : Y.subgroupOf X ≤ C := hres.symm ▸ le_primeToResidual_of_eq_top 3 _ hyX
  have hYL : Y ≤ L := by
    intro y hy
    exact hYC (show (⟨y,hYX hy⟩ : X) ∈ Y.subgroupOf X from hy)
  exact source_proper_completion_symplectic_borel_exclusion hG T hempty hM hu hmany
    hcard e H hH K S hST hi hN hplacement hgen hK hSN hcore hF hn hYL ⟨eL⟩

/-- Compatibility specialization for split cubic fields. -/
theorem source_proper_completion_symplectic_split_cubic_exclusion
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (H : Subgroup G) (hH : H ∈ Chapter3.HStar (T : Subgroup G) M)
    (K S : Subgroup G) (hST : S ≤ (T : Subgroup G))
    (hi : S.relIndex (T : Subgroup G) = 2)
    (hN : normalizer (omegaOneCenterAmbient S : Set G) ≤ Mc)
    (hplacement : ∀ P : Sylow 2 Mc, S ≤ (P : Subgroup Mc).map Mc.subtype →
      maximalTwoLocalOvergroups (K ⊔ (P : Subgroup Mc).map Mc.subtype) = {Mc})
    (hgen : K ⊔ (T : Subgroup G) = H)
    (hK : K ∈ Chapter1.L G S) (hSN : S ≤ normalizer (K : Set G))
    (hcore : pCore 2 (K ⊔ sourceResidual M Mc ⊔ S : Subgroup G) ≠ ⊥)
    {F : Type*} [Field F] [Finite F] [CharP F 2]
    {n : ℕ} (hF : Nat.card F = 2 ^ n) (hn : 2 ≤ n) (_hd : 3 ∣ 2 ^ n - 1) :
    let X := K ⊔ sourceResidual M Mc ⊔ S
    let L := (solvableResidual X).map X.subtype
    IsQuasisimple L →
      Nonempty ((L ⧸ pCore 2 L) ≃* Matrix.symplecticGroup (Fin 2) F) → False := by
  exact source_proper_completion_symplectic_exclusion hG T hempty hM hu hmany hcard e
    H hH K S hST hi hN hplacement hgen hK hSN hcore hF hn

/-- The literal projective symplectic model in the 1.1.5 list. -/
theorem source_proper_completion_psp_four_exclusion
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (H : Subgroup G) (hH : H ∈ Chapter3.HStar (T : Subgroup G) M)
    (K S : Subgroup G) (hST : S ≤ (T : Subgroup G))
    (hi : S.relIndex (T : Subgroup G) = 2)
    (hN : normalizer (omegaOneCenterAmbient S : Set G) ≤ Mc)
    (hplacement : ∀ P : Sylow 2 Mc, S ≤ (P : Subgroup Mc).map Mc.subtype →
      maximalTwoLocalOvergroups (K ⊔ (P : Subgroup Mc).map Mc.subtype) = {Mc})
    (hgen : K ⊔ (T : Subgroup G) = H)
    (hK : K ∈ Chapter1.L G S) (hSN : S ≤ normalizer (K : Set G))
    (hcore : pCore 2 (K ⊔ sourceResidual M Mc ⊔ S : Subgroup G) ≠ ⊥)
    {n : ℕ} (hn : 2 ≤ n) :
    let X := K ⊔ sourceResidual M Mc ⊔ S
    let L := (solvableResidual X).map X.subtype
    IsQuasisimple L → ClassicalGroup.IsPSp L 2 (2^n) → False := by
  let X := K ⊔ sourceResidual M Mc ⊔ S
  let L := (solvableResidual X).map X.subtype
  change IsQuasisimple L → ClassicalGroup.IsPSp L 2 (2^n) → False
  intro hq hm
  let := hq
  obtain ⟨F,_,_,hF,⟨eP⟩⟩ := hm
  let : CharP F 2 := Theory.SpecificGroups.SymplecticFour.EvenProjective.charTwo_of_card hF
  let d := eP.trans Theory.SpecificGroups.SymplecticFour.EvenProjective.equiv.symm
  have hz : center L = ⊥ := by
    apply eq_bot_iff.mpr
    intro x hx
    have hc := (centerCongr d ⟨x,hx⟩).property
    change d x ∈ center (Theory.SpecificGroups.SymplecticFour.Sp F) at hc
    rw [Theory.SpecificGroups.SymplecticFour.EvenProjective.center_eq_bot,mem_bot] at hc
    exact mem_bot.mpr (d.map_eq_one_iff.mp hc)
  have hk : pCore 2 L = ⊥ := eq_bot_iff.mpr (hz ▸ IsQuasisimple.pCore_le_center 2)
  let dQ : (L ⧸ pCore 2 L) ≃* Matrix.symplecticGroup (Fin 2) F :=
    ((QuotientGroup.quotientMulEquivOfEq hk).trans QuotientGroup.quotientBot).trans d
  exact source_proper_completion_symplectic_exclusion hG T hempty hM hu hmany hcard e
    H hH K S hST hi hN hplacement hgen hK hSN hcore hF hn hq ⟨dQ⟩


end CFSG.Quasithin.Chapter14.Section02
