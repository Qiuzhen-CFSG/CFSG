module
public import CFSG.Quasithin.Chapter14.Section02.RankTwoLocal
public import CFSG.Quasithin.Chapter12.Section08.Parabolic.BinaryGeneration
public import CFSG.Quasithin.Chapter12.Section08.Preliminary.LocalKernel.Forms
public import CFSG.Quasithin.ChapterG.Section02.CentralClosureConsequences
public import Theory.GroupTheory.PCoreImage


/-!
# The actual two-core in the nonabelian exceptional diagram case

In the original rank-two source setup, the canonical flag point is
Ω₁(Z(T)), so its normalizer is the specified subgroup Mc. Its local
closure is therefore exactly the closure of the original V under Mc.
If that closure is nonabelian, the proved binary parabolic geometry gives
an invariant two-core Q, generated by its two conjugate closure pieces,
with O₂(Y) ≤ Q ≤ T. These are the literal groups used in the exceptional
PSL₃(4) paragraph, without changing the marked quotient or local module.

Source: Aschbacher–Smith, 14.2.13, printed p.984, using 12.8.9.
-/

public section
open Subgroup Stellmacher Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter14.Section02.ExceptionalDiagram
open SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
open Chapter12.Section08
variable {G : Type*} [Group G] [Finite G]

theorem source_nonabelian_core_geometry
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hne : ¬ IsMulCommutative (conjugateSpanBy (localModule T M) Mc)) :
    ∃ he : IsElementaryAbelian 2 (rankTwoSeed T M), letI := he
    ∃ (F : InvariantFlag T (rankTwoSeed T M) 2) (g : G),
      F.H = Mc ∧ F.U = conjugateSpanBy (localModule T M) Mc ∧
      F.U ≤ Mc.pCoreIn 2 ∧
      g ∈ F.P (sourceResidual M Mc) ∧ g ∉ F.H ∧
      (⁅F.U, F.U⁆ ≤ F.Vi 1 ∧ ∀ u ∈ F.U, u ^ 2 ∈ F.Vi 1) ∧
      (sourceResidual M Mc).pCoreIn 2 ≤ (F.I₂ (sourceResidual M Mc)).pCoreIn 2 ∧
      (F.I₂ (sourceResidual M Mc)).pCoreIn 2 ≤ (T : Subgroup G) ∧
      (T : Subgroup G) ≤ normalizer ((F.I₂ (sourceResidual M Mc)).pCoreIn 2 : Set G) ∧
      (F.I₂ (sourceResidual M Mc)).pCoreIn 2 = F.W ⊔ F.X g := by
  let h := source_lemma_14_2_4 hG T hempty hM hu hmany hcard e
  let he := rankTwoSeed_elementary h
  let := he
  obtain ⟨_, F, _, z, _, _, g, hgP, hgH⟩ := h.exists_flag_geometry
  have hp : F.Vi 1 = centralInvolutions T :=
    (h.sylowOmega_eq_point F).symm.trans (sylowOmega_eq_centralInvolutions T)
  obtain ⟨_, _, _, _, _, _, _, _, _, _, _, _, _, hMc, _⟩ :=
    source_lemma_14_1_18 hG T hempty hM hu hmany hcard e
  have hFH : F.H = Mc := by
    change normalizer (F.Vi 1 : Set G) = _
    rw [hp, hMc]
    exact le_antisymm (normalizer_le_centralizer_of_card_two _
      (plane_centralInvolutions_card T M hM.1.2 hcard e)) (Subgroup.centralizer_le_normalizer _)
  have hU : F.U = conjugateSpanBy (localModule T M) Mc := by
    change conjugateSpanBy (rankTwoSeed T M) F.H = _
    exact congrArg₂ conjugateSpanBy (rankTwoSeed_eq_localModule T M) hFH
  have hnat : 3 ≤ 2 → Nonempty (InvariantFlag.AmbientNaturalMarking
      (sourceResidual M Mc) h.L_normalizes_seed 2) := by omega
  have hJ := h.pointNormalizer_mem_Hz F
  have hlocal := F.localKernel_hypothesis hG _ M F.H (by decide)
    h.seed_le_sylow h.L_normalizes_seed h.sylow_normalizes_L h.L_residual hnat hJ
  have hUc : F.U ≤ Mc.pCoreIn 2 := by
    rw [← hFH]
    exact hlocal.U_le_core
  have hbounds := F.localKernel_commutator_squares hG _ M (by decide)
    h.seed_le_sylow h.L_normalizes_seed h.sylow_normalizes_L h.L_residual hnat (h.flag_escape F)
  have hspan : F.U = conjugateSpanBy (F.Vi 2) F.H := by rw [F.last]; rfl
  have hneF : ¬ IsMulCommutative F.U := hU ▸ hne
  obtain ⟨_, hgen, _, _, hIG, hIN, _, _, _, _, _, _, _⟩ :=
    F.binary_generation (by decide) _ h.L_normalizes_seed (h.binarySeedAction_surjective F)
      h.centralizer hbounds.1 hbounds.2 hspan hneF g hgP hgH
  have hcore := (F.binary_source_core_and_intersection (by decide) _ h.L_normalizes_seed
    (h.binarySeedAction_surjective F) h.centralizer hbounds.1 hbounds.2 hspan hneF g hgP hgH).1
  have hnorm : (T : Subgroup G) ≤ normalizer ((F.I₂ (sourceResidual M Mc)).pCoreIn 2 : Set G) :=
    (F.invariant 2).trans (((normal_subgroupOf_iff_le_normalizer hIG).mp hIN).trans
      (normalizer_le_normalizer_characteristic_image (F.I₂ (sourceResidual M Mc))
        (pCore 2 (F.I₂ (sourceResidual M Mc)))))
  have hQT := (isPGroup_pCoreIn 2 (F.I₂ (sourceResidual M Mc))).le_sylow_of_normalized T hnorm
  have hres : (pResidual 2 (F.P (sourceResidual M Mc))).map
      (F.P (sourceResidual M Mc)).subtype = sourceResidual M Mc := by
    rw [F.P_rankTwo]
    exact embedded_pResidual_join_pGroup _ _ ((pResidual_eq_top_iff 2 _).mp h.L_residual)
      T.isPGroup' h.sylow_normalizes_L
  have hYI : sourceResidual M Mc ≤ F.I₂ (sourceResidual M Mc) := by
    rw [hgen, hres]
    exact le_sup_left
  have hIP : F.I₂ (sourceResidual M Mc) ≤ F.P (sourceResidual M Mc) :=
    conjugateSpanBy_le_self (F.binary_U_le_P (by decide) _ hbounds.2)
  have hYN : F.I₂ (sourceResidual M Mc) ≤ normalizer (sourceResidual M Mc : Set G) := by
    apply hIP.trans
    rw [F.P_rankTwo]
    exact sup_le (sourceResidual M Mc).le_normalizer h.sylow_normalizes_L
  exact ⟨he, F, g, hFH, hU, hUc, hgP, hgH, hbounds,
    pCoreIn_mono_of_normalizes hYI hYN, hQT, hnorm, hcore⟩

end CFSG.Quasithin.Chapter14.Section02.ExceptionalDiagram
