variable {G : Type*} [Group G] {L : Fin 2 → Subgroup G} {S : Subgroup G}
local notation "A" => reducedAmalgam L S
local notation "F" => Universal.cosetFamily A
local notation "RF" => reducedFamily L S
local notation "P" => RankTwo.stabilizer F (base F true)

private theorem apartment_noBranching
    (c : CompatibleCartans L (reducedSylow L S)) (d : SixPathSmallActorGeometry c) (i : Bool) :
    NoBranchingIn (sourceGraph A) (cartanApartment A (reflectionGroup c d.reflection)) := by
  have ht := (Universal.cosetGraph_isTree A
    (inclusion_injective (commonBorel_le_parabolic 0))
    (inclusion_injective (commonBorel_le_parabolic 1))).isAcyclic
  have hab : (sourceGraph A).Adj (base F i) (base F (!i)) :=
    ⟨by change i≠(!i); cases i <;> decide, incident_base _ _ _⟩
  let l := (localMoversTrack ht ⟨source_action A⟩ hab (d.fixes i) (d.fixes (!i))
    (d.moves i) (by simpa only [Bool.not_not] using d.moves (!i))).toLine
  rw [reflectionApartment_eq_oriented_line c d.reflection d.fixes d.squares d.normalizes i]
  exact line_noBranching ht l

private theorem apartment_neighbor_cases
    (c : CompatibleCartans L (reducedSylow L S)) (d : SixPathSmallActorGeometry c) (i : Bool)
    (v : SourceVertex A) (hv : v∈cartanApartment A (reflectionGroup c d.reflection))
    (ha : (sourceGraph A).Adj (base F i) v) :
    v=base F (!i) ∨ v=d.reflection i • base F (!i) := by
  let N := reflectionGroup c d.reflection
  have hb : (sourceGraph A).Adj (base F i) (base F (!i)) :=
    ⟨by change i≠(!i); cases i <;> decide, incident_base _ _ _⟩
  have ht : (sourceGraph A).Adj (base F i) (d.reflection i • base F (!i)) := by
    simpa only [d.fixes i] using source_action A (d.reflection i) hb
  exact apartment_noBranching c d i _ (cartanApartment_base A N i)
    _ (cartanApartment_base A N (!i))
    _ (cartanApartment_preserves A N (reflectionGroup_mem c d.reflection i)
      (cartanApartment_base A N (!i))) _ hv hb ht ha (d.moves i).symm

/-- The literal supplied reflection reverses every supported twelve-path
centered at its marked vertex, in either orientation. -/
theorem centered_reflection_reverses
    (c : CompatibleCartans L (reducedSylow L S)) (d : SixPathSmallActorGeometry c)
    {a b : SourceVertex A} (p : (sourceGraph A).Walk a b) (hp : p.IsPath) (hl : p.length=12)
    (hT : ∀ z∈p.support,z∈cartanApartment A (reflectionGroup c d.reflection))
    (i : Bool) (hm : p.getVert 6=base F i) :
    ∀ k≤12,d.reflection i • p.getVert k=p.getVert (12-k) := by
  have hn := apartment_neighbor_cases c d i (p.getVert 7) (hT _ (p.getVert_mem_support 7))
    (hm ▸ p.adj_getVert_succ (by omega : 6<p.length))
  have hmove : d.reflection i • p.getVert 7 ≠ p.getVert 7 := by
    rcases hn with hn | hn
    · rw [hn]
      exact d.moves i
    · rw [hn, ←mul_smul,d.squares i,one_smul]
      exact (d.moves i).symm
  exact reverses_path_of_moves_midpoint_neighbor (source_action A)
    (apartment_noBranching c d i) p hp 6 (by decide) hl hT (d.reflection i) (d.squares i)
    (fun _ hz => cartanApartment_preserves A (reflectionGroup c d.reflection)
      (reflectionGroup_mem c d.reflection i) hz)
    (by rw [hm]; exact d.fixes i) hmove

private theorem half_actor_reverse
    {a b : SourceVertex A} (p : (sourceGraph A).Walk a b) (hl : p.length=12) :
    halfPathActor (X := (A).Universal) p.reverse 6=halfPathActor (X := (A).Universal) p 6 := by
  have identity : (MulAut.conj (1 : (A).Universal)).toMonoidHom=MonoidHom.id _ := by ext x; simp
  have hd : pathRoot (X := (A).Universal) (p.reverse.drop 6)=pathRoot (X := (A).Universal) (p.take 6) := by
    have hh := pathRoot_map_conj (X := (A).Universal) (p.reverse.drop 6) (p.take 6).reverse 1
      (by simp only [drop_length,length_reverse,take_length,hl]; decide) (by
        intro k hk
        simp only [drop_length,length_reverse,hl] at hk
        simp only [one_smul,drop_getVert,getVert_reverse,take_length,hl,take_getVert]
        congr 1
        omega)
    simpa only [identity,Subgroup.map_id,pathRoot_reverse] using hh
  have ht : pathRoot (X := (A).Universal) (p.reverse.take 6)=pathRoot (X := (A).Universal) (p.drop 6) := by
    have hh := pathRoot_map_conj (X := (A).Universal) (p.reverse.take 6) (p.drop 6).reverse 1
      (by simp only [take_length,length_reverse,drop_length,hl]; decide) (by
        intro k hk
        simp only [take_length,length_reverse,hl] at hk
        simp only [one_smul,take_getVert,getVert_reverse,drop_length,hl,drop_getVert]
        congr 1
        omega)
    simpa only [identity,Subgroup.map_id,pathRoot_reverse] using hh
  change _ ⊔ _ = _ ⊔ _
  rw [hd,ht,sup_comm]

private theorem half_actor_le_corrected
    (c : CompatibleCartans L (reducedSylow L S)) (d : SixPathSmallActorGeometry c)
    {a b : SourceVertex A} (p : (sourceGraph A).Walk a b) (hp : p.IsPath) (hl : p.length=12)
    (hT : ∀ z∈p.support,z∈cartanApartment A (reflectionGroup c d.reflection))
    (hm : p.getVert 6=base F true) :
    halfPathActor (X := (A).Universal) p 6 ≤
      pathRoot (X := (A).Universal)
        (reflectionPath c d.reflection d.fixes d.moves d.normalizes 6 (by decide) true).walk ⊔
          zpowers (d.reflection true) := by
  have hrev := centered_reflection_reverses c d p hp hl hT true hm
  have hn := apartment_neighbor_cases c d true (p.getVert 7) (hT _ (p.getVert_mem_support 7))
    (hm ▸ p.adj_getVert_succ (by omega : 6<p.length))
  rcases hn with hn | hn
  · exact SourceEightCorrectedGeometry.half_actor_generated_by_root_reflection c d p hp hl hm hn hT hrev
  · have hmr : p.reverse.getVert 6=base F true := by rw [getVert_reverse,hl]; exact hm
    have hnr : p.reverse.getVert 7=base F false := by
      rw [getVert_reverse,hl]
      have he := hrev 7 (by decide)
      rw [hn,←mul_smul,d.squares true,one_smul] at he
      exact he.symm
    have hTr : ∀ z∈p.reverse.support,z∈cartanApartment A (reflectionGroup c d.reflection) := by
      simpa only [support_reverse,List.mem_reverse] using hT
    have hlr : p.reverse.length=12 := by rw [length_reverse,hl]
    rw [←half_actor_reverse p hl]
    exact SourceEightCorrectedGeometry.half_actor_generated_by_root_reflection c d p.reverse hp.reverse hlr
      hmr hnr hTr (centered_reflection_reverses c d p.reverse hp.reverse hlr hTr true hmr)

/-- Onto the full local quotient and contained in its prescribed complement,
the literal centered half-path actor is that same complement. -/
theorem centered_half_actor_eq_corrected
    (h : HypothesisF11 L S)
    (hactor : graphLocalGroup RF (base RF true)=RankTwo.stabilizer RF (base RF true))
    (c : CompatibleCartans L (reducedSylow L S)) (d : SixPathSmallActorGeometry c)
    {a b : SourceVertex A} (p : (sourceGraph A).Walk a b) (hp : p.IsPath) (hl : p.length=12)
    (hT : ∀ z∈p.support,z∈cartanApartment A (reflectionGroup c d.reflection))
    (hm : p.getVert 6=base F true)
    {k : Type*} [Field k] [Finite k] [CharP k 2]
    (e : (graphLocalGroup RF ((bOne_tree_cover h).vertex (p.getVert 6)) ⧸
      pCore 2 (graphLocalGroup RF ((bOne_tree_cover h).vertex (p.getVert 6)))) ≃* SL(2,k))
    (hval : Nat.card ((sourceGraph A).neighborSet (p.getVert 6))=Nat.card k+1)
    (hKP : (pathRoot (X := (A).Universal)
      (reflectionPath c d.reflection d.fixes d.moves d.normalizes 6 (by decide) true).walk ⊔
        zpowers (d.reflection true))≤P)
    (hcomp : (pCore 2 P).IsComplement'
      ((pathRoot (X := (A).Universal)
        (reflectionPath c d.reflection d.fixes d.moves d.normalizes 6 (by decide) true).walk ⊔
          zpowers (d.reflection true)).subgroupOf P)) :
    halfPathActor (X := (A).Universal) p 6=
      pathRoot (X := (A).Universal)
        (reflectionPath c d.reflection d.fixes d.moves d.normalizes 6 (by decide) true).walk ⊔
          zpowers (d.reflection true) := by
  let D := halfPathActor (X := (A).Universal) p 6
  let K := pathRoot (X := (A).Universal)
    (reflectionPath c d.reflection d.fixes d.moves d.normalizes 6 (by decide) true).walk ⊔
      zpowers (d.reflection true)
  let J := graphLocalGroup RF ((bOne_tree_cover h).vertex (p.getVert 6))
  have hDK : D≤K := half_actor_le_corrected c d p hp hl hT hm
  have hDP : D≤P := hDK.trans hKP
  have hfull : J=RankTwo.stabilizer RF ((bOne_tree_cover h).vertex (p.getVert 6)) := by
    dsimp only [J]
    rw [hm,(bOne_tree_cover h).vertex_base]
    exact hactor
  let g : P≃*J := (MulEquiv.subgroupCongr (congrArg (RankTwo.stabilizer F) hm).symm).trans
    (((bOne_tree_cover h).stabilizerEquiv (p.getVert 6)).trans (MulEquiv.subgroupCongr hfull.symm))
  let j : D→*P := inclusion hDP
  have hg (x:D) : g (j x)=halfPathLocalMap h p 6 hl x := rfl
  have hsurj := source_six_halfPathLinearMap_surjective h c d p hp hl hT e hval
  apply le_antisymm hDK
  intro x hx
  let xP : P := ⟨x,hKP hx⟩
  obtain ⟨y,hy⟩ := hsurj (e (QuotientGroup.mk' (pCore 2 J) (g xP)))
  have hyq : QuotientGroup.mk' (pCore 2 J) (g (j y))=
      QuotientGroup.mk' (pCore 2 J) (g xP) := by
    apply e.injective
    rw [hg]
    exact hy
  have hcore : xP/(j y)∈pCore 2 P := by
    have hmap : g (xP/(j y))∈pCore 2 J := by
      apply (QuotientGroup.eq_one_iff _).mp
      change QuotientGroup.mk' (pCore 2 J) (g (xP/(j y)))=1
      rw [map_div,map_div,hyq,div_self']
    rw [←pCore_map_iso 2 g] at hmap
    obtain ⟨w,hw,hwg⟩ := hmap
    exact g.injective hwg ▸ hw
  have hK : xP/(j y)∈K.subgroupOf P := K.div_mem hx (hDK y.property)
  have he : xP/(j y)=1 := hcomp.disjoint.le_bot ⟨hcore,hK⟩
  have hxy : x=(y:(A).Universal) := congrArg Subtype.val (div_eq_one.mp he)
  exact hxy.symm ▸ y.property

end Geometry

open SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
variable {G : Type*} [Group G] [Finite G]
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (H : Subgroup G) (hH : H ∈ Chapter3.HStar (T : Subgroup G) M)
    (eR : (pResidual 2 H ⧸ pCore 2 (pResidual 2 H)) ≃* Theory.PSL2.BinaryGroup 3)
include hG hempty hM hu hmany hcard e hH eR
local notation "Lₛ" => ![locals T M Mc H 1,locals T M Mc H 0]
local notation "Sₛ" => (T : Subgroup G)
local notation "Aₛ" => reducedAmalgam Lₛ Sₛ
local notation "Fₛ" => Universal.cosetFamily Aₛ
local notation "Pₛ" => RankTwo.stabilizer Fₛ (base Fₛ true)

/-- The actual original source discharges the local marking, valence and full
endpoint identification for every supplied corrected eight geometry. -/
theorem source_centered_half_actor_eq_corrected
    (c : CompatibleCartans Lₛ (reducedSylow Lₛ Sₛ)) (d : SixPathSmallActorGeometry c)
    {a b : SourceVertex Aₛ} (p : (sourceGraph Aₛ).Walk a b) (hp : p.IsPath) (hl : p.length=12)
    (hT : ∀ z∈p.support,z∈cartanApartment Aₛ (reflectionGroup c d.reflection))
    (hm : p.getVert 6=base Fₛ true)
    (hKP : (pathRoot (X := (Aₛ).Universal)
      (reflectionPath c d.reflection d.fixes d.moves d.normalizes 6 (by decide) true).walk ⊔
        zpowers (d.reflection true))≤Pₛ)
    (hcomp : (pCore 2 Pₛ).IsComplement'
      ((pathRoot (X := (Aₛ).Universal)
        (reflectionPath c d.reflection d.fixes d.moves d.normalizes 6 (by decide) true).walk ⊔
          zpowers (d.reflection true)).subgroupOf Pₛ)) :
    halfPathActor (X := (Aₛ).Universal) p 6=
      pathRoot (X := (Aₛ).Universal)
        (reflectionPath c d.reflection d.fixes d.moves d.normalizes 6 (by decide) true).walk ⊔
          zpowers (d.reflection true) := by
  let h : HypothesisF11 Lₛ Sₛ :=
    (source_hypothesis hG T hempty hM hu hmany hcard e H hH eR).1.swap
  obtain ⟨_,_,k,fk,fink,chk,hk,em,_⟩ :=
    SourceHalfPathQuotients.source_half_path_quotients hG T hempty hM hu hmany hcard e H hH eR c
  let _ := fk
  let _ := fink
  let _ := chk
  have hval : Nat.card ((sourceGraph Aₛ).neighborSet (p.getVert 6))=
      Nat.card (k ((bOne_tree_cover h).vertex (p.getVert 6)).type)+1 := by
    rw [SourceCartanPaths.source_tree_neighbor_cards hG T hempty hM hu hmany hcard e H hH eR,hk]
    change (if (p.getVert 6).type then 9 else 3)=(if (p.getVert 6).type then 8 else 2)+1
    cases (p.getVert 6).type <;> rfl
  exact centered_half_actor_eq_corrected h
    (SourceEightTreeEndpoint.source_eight_tree_endpoint hG T hempty hM hu hmany hcard e H hH eR).2
    c d p hp hl hT hm (em _) hval hKP hcomp

/-- The same corrected eight reflection belongs to every literal supported
half-path actor centered at its original endpoint, in either orientation. -/
theorem source_eight_reflection_mem_halfactor
    (c : CompatibleCartans Lₛ (reducedSylow Lₛ Sₛ)) (d : SixPathSmallActorGeometry c)
    {a b : SourceVertex Aₛ} (p : (sourceGraph Aₛ).Walk a b) (hp : p.IsPath) (hl : p.length=12)
    (hT : ∀ z∈p.support,z∈cartanApartment Aₛ (reflectionGroup c d.reflection))
    (hm : p.getVert 6=base Fₛ true)
    (hKP : (pathRoot (X := (Aₛ).Universal)
      (reflectionPath c d.reflection d.fixes d.moves d.normalizes 6 (by decide) true).walk ⊔
        zpowers (d.reflection true))≤Pₛ)
    (hcomp : (pCore 2 Pₛ).IsComplement'
      ((pathRoot (X := (Aₛ).Universal)
        (reflectionPath c d.reflection d.fixes d.moves d.normalizes 6 (by decide) true).walk ⊔
          zpowers (d.reflection true)).subgroupOf Pₛ)) :
    d.reflection true∈halfPathActor (X := (Aₛ).Universal) p 6 := by
  rw [source_centered_half_actor_eq_corrected hG T hempty hM hu hmany hcard e H hH eR
    c d p hp hl hT hm hKP hcomp]
  exact mem_sup_right (mem_zpowers _)

end CFSG.Quasithin.Chapter14.Section02.EightLargeParabolic.SourceEightCenteredReflection
