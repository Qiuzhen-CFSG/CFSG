variable {G : Type*} [Group G] {L : Fin 2 → Subgroup G} {S : Subgroup G}
local notation "A" => reducedAmalgam L S
local notation "F" => reducedFamily L S
local notation "UP" => Universal.cosetFamily A

/-- All original mixed-field quotient and torus data for one geometry,
with perfectness and full two-residual at every eight midpoint. -/
@[expose] def HasPerfectEightHalfPathActors (h : HypothesisF11 L S)
    (c : CompatibleCartans L (reducedSylow L S)) : Prop :=
  ∃ d : SixPathSmallActorGeometry c,
    (∀ i, Nonempty (BinarySixPathReflectionClass h i (d.reflection i))) ∧
    ∃ (K : Bool → Type) (_ : ∀ i, Field (K i)) (_ : ∀ i, Finite (K i))
      (_ : ∀ i, CharP (K i) 2),
      (∀ i, Nat.card (K i)=if i then 8 else 2) ∧
      ∃ e : ∀ v : Vertex F,
        (graphLocalGroup F v ⧸ pCore 2 (graphLocalGroup F v)) ≃* SL(2,K v.type),
      ∀ {a b} (p : (sourceGraph A).Walk a b) (_hp : p.IsPath) (hl : p.length=12),
        (∀ z∈p.support, z∈cartanApartment A (reflectionGroup c d.reflection)) →
        Function.Surjective (halfPathLinearMap h p 6 hl
          (e ((bOne_tree_cover h).vertex (p.getVert 6)))) ∧
        (halfPathLinearMap h p 6 hl (e ((bOne_tree_cover h).vertex (p.getVert 6)))).ker =
          pCore 2 (halfPathActor (X := (A).Universal) p 6) ∧
        (halfPathActor (X := (A).Universal) p 6).map (bOne_tree_map h) ⊔
          Q F ((bOne_tree_cover h).vertex (p.getVert 6)) =
            graphLocalGroup F ((bOne_tree_cover h).vertex (p.getVert 6)) ∧
        (∃ E : (halfPathActor (X := (A).Universal) p 6 ⧸
            pCore 2 (halfPathActor (X := (A).Universal) p 6)) ≃*
              SL(2,K ((bOne_tree_cover h).vertex (p.getVert 6)).type),
          ∀ x : halfPathActor (X := (A).Universal) p 6,
            E (QuotientGroup.mk' _ x) =
              e _ (QuotientGroup.mk' _ (halfPathLocalMap h p 6 hl x))) ∧
        (let D := halfPathActor (X := (A).Universal) p 6
         let R := (pathRoot (X := (A).Universal) (p.drop 6)).subgroupOf D
         let V := (pathRoot (X := (A).Universal) (p.take 6)).subgroupOf D
         let f := halfPathLinearMap h p 6 hl (e ((bOne_tree_cover h).vertex (p.getVert 6)))
         R ⊓ f.ker=⊥ ∧ V ⊓ f.ker=⊥ ∧
           ∃ z : SL(2,K ((bOne_tree_cover h).vertex (p.getVert 6)).type),
             R.map ((MulAut.conj z).toMonoidHom.comp f)=
               Matrix.SpecialLinearGroup.upperUnipotent _ ∧
             (∀ y, y∈V.map ((MulAut.conj z).toMonoidHom.comp f) ↔
               ∃ a, Matrix.SpecialLinearGroup.transvection
                 (i := (1 : Fin 2)) (j := 0) one_ne_zero a=y) ∧
             ∀ a, ∀ ha : a≠0, Matrix.SpecialLinearGroup.diag2 a ha∈
               ((cartan c).subgroupOf D).map ((MulAut.conj z).toMonoidHom.comp f)) ∧
        (cartan c ⊓ (graphLocalGroup F ((bOne_tree_cover h).vertex (p.getVert 6))).comap
          (bOne_tree_map h) ≤ halfPathActor (X := (A).Universal) p 6) ∧
        ((p.getVert 6).type=true → cartan c ≤ halfPathActor (X := (A).Universal) p 6) ∧
        cartan c ⊓ centralizer (halfPathActor (X := (A).Universal) p 6 : Set (A).Universal) =
          cartan c ⊓ (U F ((bOne_tree_cover h).vertex (p.getVert 6))).comap (bOne_tree_map h) ∧
        ((p.getVert 6).type=false →
          cartan c ≤ centralizer (halfPathActor (X := (A).Universal) p 6 : Set (A).Universal)) ∧
        ((p.getVert 6).type=true →
          Group.IsPerfect (halfPathActor (X := (A).Universal) p 6) ∧
          pResidual 2 (halfPathActor (X := (A).Universal) p 6)=⊤)

private theorem actors_of_torus_coordinates (h : HypothesisF11 L S)
    (c : CompatibleCartans L (reducedSylow L S))
    (hq : HasTorusMarkedHalfPathQuotients h c) :
    HasPerfectEightHalfPathActors h c := by
  obtain ⟨d,hclass,K,fK,finK,chK,hK,e,hpaths⟩ := hq
  let _ := fK
  let _ := finK
  let _ := chK
  refine ⟨d,hclass,K,fK,finK,chK,hK,e,?_⟩
  intro a b p hp hl hT
  obtain ⟨hsurj,hker,hsupp,hE,hcoords,hCD,hcontain,hcent,hbinary⟩ := hpaths p hp hl hT
  obtain ⟨hRk,hVk,z,hR,hV,hfull⟩ := hcoords
  refine ⟨hsurj,hker,hsupp,hE,⟨hRk,hVk,z,hR,hV,hfull⟩,hCD,hcontain,hcent,hbinary,?_⟩
  intro ht
  have hk : Nat.card (K ((bOne_tree_cover h).vertex (p.getVert 6)).type)=8 := by
    rw [hK]
    change (if (p.getVert 6).type then 8 else 2)=8
    rw [ht]
    rfl
  let D := halfPathActor (X := (A).Universal) p 6
  let R := (pathRoot (X := (A).Universal) (p.drop 6)).subgroupOf D
  let V := (pathRoot (X := (A).Universal) (p.take 6)).subgroupOf D
  let C := (cartan c).subgroupOf D
  let k := K ((bOne_tree_cover h).vertex (p.getVert 6)).type
  let f := (MulAut.conj z).toMonoidHom.comp
    (halfPathLinearMap h p 6 hl (e ((bOne_tree_cover h).vertex (p.getVert 6))))
  have hker : f.ker=(halfPathLinearMap h p 6 hl (e ((bOne_tree_cover h).vertex (p.getVert 6)))).ker :=
    MonoidHom.ker_comp_of_injective _ _ (MulAut.conj z).injective
  have hRk' : R ⊓ f.ker=⊥ := by rw [hker]; exact hRk
  have hVk' : V ⊓ f.ker=⊥ := by rw [hker]; exact hVk
  have hoddC : Odd (Nat.card C) := by
    rw [←card_map_of_injective (f := D.subtype) (K := C) D.subtype_injective]
    change Odd (Nat.card (((cartan c).subgroupOf D).map D.subtype))
    rw [subgroupOf_map_subtype]
    exact (Nat.coprime_two_left.mp (cartan_odd c)).of_dvd_nat
      (card_dvd_of_le (show cartan c ⊓ D ≤ cartan c from inf_le_left))
  have hoim : Odd (Nat.card (C.map f)) := hoddC.of_dvd_nat (C.card_map_dvd f)
  have hCne : C.map f≠⊥ := by
    let : Nontrivial kˣ := Finite.one_lt_card_iff_nontrivial.mp (by
      rw [Nat.card_units]
      rw [show Nat.card k=8 from hk]
      decide)
    obtain ⟨s,hs⟩ := exists_ne (1:kˣ)
    intro he
    have hm := hfull (s:k) s.ne_zero
    change Matrix.SpecialLinearGroup.diag2 (s:k) s.ne_zero∈C.map f at hm
    have hm1 := he.le hm
    have heq := congrArg (fun x : SL(2,k) => x.val 0 0) hm1
    apply hs
    apply Units.ext
    simpa [Matrix.SpecialLinearGroup.diag2_coe'] using heq
  have hfix (x : D) (hx : x∈C) (j : ℕ) :
      x.val • p.getVert j=p.getVert j :=
    reflectionApartment_fixed c d.reflection d.normalizes x.val hx _ (hT _ (p.getVert_mem_support j))
  have hCR : C ≤ normalizer (R : Set D) := by
    intro x hx
    have hpath : x.val∈pathFixer (X := (A).Universal) (p.drop 6) := by
      intro j _
      rw [drop_getVert]
      exact hfix x hx _
    have hn := pathFixer_le_normalizer_pathRoot (p.drop 6) hpath
    exact mem_normalizer_iff.mpr (fun y => mem_normalizer_iff.mp hn y.val)
  have hCV : C ≤ normalizer (V : Set D) := by
    intro x hx
    have hpath : x.val∈pathFixer (X := (A).Universal) (p.take 6) := by
      intro j _
      rw [take_getVert]
      exact hfix x hx _
    have hn := pathFixer_le_normalizer_pathRoot (p.take 6) hpath
    exact mem_normalizer_iff.mpr (fun y => mem_normalizer_iff.mp hn y.val)
  have hRd : R ≤ _root_.commutator D := Matrix.SpecialLinearGroup.sylow_lift_le_commutator
    f R C (Matrix.SpecialLinearGroup.upperUnipotentSylow k 2) hR hRk' hCR hoim hCne
  have hVcard : Nat.card (V.map f)=Nat.card k := by
    let j : k → V.map f := fun a => ⟨NaturalCubic.lower a,(hV _).mpr ⟨a,rfl⟩⟩
    have hj : Function.Bijective j := by
      constructor
      · intro x y he
        have he' := congrArg (fun z : V.map f => z.val.val 1 0) he
        simpa [j,NaturalCubic.lower,Matrix.SpecialLinearGroup.transvection_coe] using he'
      · intro x
        obtain ⟨a,ha⟩ := (hV x.val).mp x.property
        exact ⟨a,Subtype.ext ha⟩
    exact (Nat.card_congr (Equiv.ofBijective j hj)).symm
  obtain ⟨Q,hQ⟩ := ((pathRoot_isTwo (X := (A).Universal) (p.take 6)).comap_subtype.map f).exists_le_sylow
  have hQeq : V.map f=(Q : Subgroup SL(2,k)) := by
    apply eq_of_le_of_card_ge hQ
    change Nat.card Q ≤ Nat.card (V.map f)
    rw [hVcard,←Nat.card_congr (Matrix.SpecialLinearGroup.sylowEquivAdditive k 2 Q).toEquiv]
    rfl
  have hVd : V ≤ _root_.commutator D := Matrix.SpecialLinearGroup.sylow_lift_le_commutator
    f V C Q hQeq hVk' hCV hoim hCne
  have hgen : R ⊔ V=⊤ := by
    apply Subgroup.map_injective D.subtype_injective
    rw [Subgroup.map_sup,map_subgroupOf_eq_of_le
      (show pathRoot (X := (A).Universal) (p.drop 6) ≤ D from le_sup_left),
      map_subgroupOf_eq_of_le
      (show pathRoot (X := (A).Universal) (p.take 6) ≤ D from le_sup_right),
      ←MonoidHom.range_eq_map,range_subtype]
  have hperfect : Group.IsPerfect D := ⟨top_unique (hgen ▸ sup_le hRd hVd)⟩
  let _ : ∀ i, Finite (F i) := finite_endpoints (reduced_triple h)
  let J := graphLocalGroup F ((bOne_tree_cover h).vertex (p.getVert 6))
  let _ : Finite J := Finite.of_injective (inclusion (sylowGenerated_le _)) (inclusion_injective _)
  let _ : Finite D := Finite.of_injective _ (halfPathLocalMap_injective h p 6 hl)
  let _ := hperfect
  exact ⟨hperfect,pResidual_eq_top_of_isPerfect 2⟩

open SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
variable [Finite G]
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (H : Subgroup G) (hH : H ∈ Chapter3.HStar (T : Subgroup G) M)
    (eR : (pResidual 2 H ⧸ pCore 2 (pResidual 2 H)) ≃* Theory.PSL2.BinaryGroup 3)
include hG hempty hM hu hmany hcard e hH eR
local notation "Lₛ" => ![locals T M Mc H 1,locals T M Mc H 0]


set_option maxHeartbeats 800000 in
/-- The original mixed source constructs one geometry whose eight-midpoint
half-path actors are perfect and contain the whole Cartan, while at binary
midpoints the same Cartan centralizes the actual half-path actor. -/
theorem source_half_path_actors
    (c : CompatibleCartans Lₛ (reducedSylow Lₛ (T : Subgroup G))) :
    HasPerfectEightHalfPathActors
      (show HypothesisF11 Lₛ (T : Subgroup G) from
        (source_hypothesis hG T hempty hM hu hmany hcard e H hH eR).1.swap) c := by
  exact actors_of_torus_coordinates _ c
    (source_half_path_torus hG T hempty hM hu hmany hcard e H hH eR c)

end CFSG.Quasithin.Chapter14.Section02.EightLargeParabolic.SourceHalfPathActors
