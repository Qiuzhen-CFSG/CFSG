module
public import Theory.SpecificGroups.Triality.ShortRootCentralizer.BinaryOrbit
public import CFSG.Quasithin.Chapter14.Section02.EightLargeParabolic.ShortCentralizer
public import CFSG.Quasithin.Chapter14.Section02.EightLargeParabolic.ExtendedEndpoints
public import Theory.GroupTheory.NormalizedSupCard

/-!
# The short centralizer in the original cubic endpoint extension

The characteristic noncentral derived class in the native second two-core
is preserved by every endpoint automorphism. Transport through the original
right marking therefore realizes every normalizer conjugate of the selected
short root inside that same endpoint. The full endpoint is its product with
the short centralizer, so both relative indices agree; this index is three
in the cubic case. Relative normality and the original ambient Sylow also
put every involution of each enlarged endpoint in its marked base endpoint.

These discharge the cubic class and index comparison inputs of
Aschbacher--Smith F.4.42 and 14.2.18, printed pp.295,987
(`refs/quasithin.pdf`). Both original endpoint markings remain intact.
The literal component consumer is TerminalSolvable/EightBorelShortExtension;
full ambient short-centralizer containment and recognition remain separate.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped Pointwise
namespace CFSG.Quasithin.Chapter14.Section02.EightLargeParabolic
open SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
open _root_.Triality.Standard _root_.Triality.Standard.Parabolics
local notation "P" => binaryParameters 1 Nat.zero_lt_one
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {M Mc H : Subgroup G}

omit [Finite G] in
/-- Every automorphism supplied by the actual endpoint normalizer fixes the
selected short-root conjugacy class within the same original endpoint. -/
theorem marked_short_normalizer_conjugate (r : MarkedTriality T M Mc H)
    (d : ExtensionField P) (hd : d ≠ 0)
    (n : normalizer (secondParabolic T M Mc H : Set G)) :
    ∃ l : secondParabolic T M Mc H,
      l.val * (markedShortRoot r d : G) * l.val⁻¹ =
        n.val * (markedShortRoot r d : G) * n.val⁻¹ := by
  let L := secondParabolic T M Mc H
  let a := L.normalizerMonoidHom n
  let f := (r.right.symm.trans a).trans r.right
  have hf : f (r.right (markedShortRoot r d)) = r.right (a (markedShortRoot r d)) := by
    simp only [f,MulEquiv.trans_apply,MulEquiv.symm_apply_apply]
  obtain ⟨u,hu⟩ := isConj_iff.mp (ShortRootCentralizer.BinaryOrbit.parabolic_automorphism_conjugate
    f d hd (r.right (markedShortRoot r d)) (markedShortRoot_image r d))
  have he : r.right.symm u * markedShortRoot r d * (r.right.symm u)⁻¹ =
      a (markedShortRoot r d) := by
    apply r.right.injective
    simpa only [map_mul,map_inv,r.right.apply_symm_apply,hf] using hu
  exact ⟨r.right.symm u,congrArg Subtype.val he⟩

variable
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hempty : MainForward.faithfulLocalComponents T = ∅)
    (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) M)
include hG hempty hM hu hmany hcard e hH

/-- Relative normality of the original second endpoint in its full extension. -/
theorem source_second_normalized (r : MarkedTriality T M Mc H) :
    M ≤ normalizer (secondParabolic T M Mc H : Set G) := by
  by_cases he : Mc = H
  · rw [source_second_eq_of_partner_eq hG hempty hM hu hmany hcard e hH r he]
    exact M.le_normalizer
  · obtain ⟨A,_,_,_,hAP,_,_,_,hMP,_⟩ :=
      source_split_endpoint_data hG hempty hM hu hmany hcard e hH r he
    calc
      M = secondParabolic T M Mc H ⊔ A := hMP
      _ ≤ _ := sup_le (secondParabolic T M Mc H).le_normalizer hAP

/-- The cubic endpoint is generated by the original endpoint and its actual
short-root centralizer. No replacement extension or ambient class assumption is used. -/
theorem source_short_centralizer_factorization (r : MarkedTriality T M Mc H)
    (d : ExtensionField P) (hd : d ≠ 0) :
    M = secondParabolic T M Mc H ⊔
      (M ⊓ centralizer ({(markedShortRoot r d : G)} : Set G)) := by
  let L := secondParabolic T M Mc H
  let t : G := markedShortRoot r d
  have hLM := (source_parabolics hG T hempty hM hu hmany hcard e H hH
    (firstResidualQuotientEquiv r)).2.2.2.2
  have hn := source_second_normalized hG hempty hM hu hmany hcard e hH r
  apply le_antisymm
  · intro m hm
    obtain ⟨l,hl⟩ := marked_short_normalizer_conjugate r d hd ⟨m,hn hm⟩
    have hcm : l.val⁻¹*m ∈ M := M.mul_mem (M.inv_mem (hLM l.property)) hm
    have hc : l.val⁻¹*m ∈ centralizer ({t} : Set G) := by
      apply mem_centralizer_singleton_iff.mpr
      calc
        (l.val⁻¹*m)*t = l.val⁻¹*(m*t*m⁻¹)*m := by group
        _ = l.val⁻¹*(l.val*t*l.val⁻¹)*m := by rw [←hl]
        _ = t*(l.val⁻¹*m) := by group
    have hh := mul_mem_sup l.property (show l.val⁻¹*m ∈ M ⊓ centralizer ({t} : Set G) from ⟨hcm,hc⟩)
    simpa only [mul_inv_cancel_left] using hh
  · exact sup_le hLM inf_le_left

/-- The local short centralizer acquires exactly the same index as its endpoint. -/
theorem source_short_centralizer_index (r : MarkedTriality T M Mc H)
    (d : ExtensionField P) (hd : d ≠ 0) :
    let C := centralizer ({(markedShortRoot r d : G)} : Set G)
    (secondParabolic T M Mc H ⊓ C).relIndex (M ⊓ C) =
      (secondParabolic T M Mc H).relIndex M := by
  dsimp only
  let L := secondParabolic T M Mc H
  let C := centralizer ({(markedShortRoot r d : G)} : Set G)
  have hLM := (source_parabolics hG T hempty hM hu hmany hcard e H hH
    (firstResidualQuotientEquiv r)).2.2.2.2
  have hn := source_second_normalized hG hempty hM hu hmany hcard e hH r
  let : (L.subgroupOf M).Normal := normal_subgroupOf_of_le_normalizer hn
  have hi := relIndex_sup_left ((M ⊓ C).subgroupOf M) (L.subgroupOf M)
  rw [←subgroupOf_sup hLM inf_le_left,
    ←source_short_centralizer_factorization hG hempty hM hu hmany hcard e hH r d hd,
    relIndex_subgroupOf le_rfl,relIndex_subgroupOf inf_le_left] at hi
  have hinf : L ⊓ (M ⊓ C) = L ⊓ C := by
    rw [←inf_assoc,inf_eq_left.mpr hLM]
  exact (hinf ▸ inf_relIndex_right L (M ⊓ C)).trans hi.symm

/-- In the genuine cubic case the enlarged short centralizer has index three. -/
theorem source_short_centralizer_index_three (r : MarkedTriality T M Mc H)
    (hne : Mc ≠ H) (d : ExtensionField P) (hd : d ≠ 0) :
    let C := centralizer ({(markedShortRoot r d : G)} : Set G)
    (secondParabolic T M Mc H ⊓ C).relIndex (M ⊓ C) = 3 := by
  dsimp only
  rw [source_short_centralizer_index hG hempty hM hu hmany hcard e hH r d hd]
  obtain ⟨A,_,hA,_,hn,_,hdA,_,hM',_⟩ :=
    source_split_endpoint_data hG hempty hM hu hmany hcard e hH r hne
  have hL := (source_parabolics hG T hempty hM hu hmany hcard e H hH
    (firstResidualQuotientEquiv r)).2.2.2.2
  have hc := card_sup_eq_mul_of_normalizes_of_disjoint (secondParabolic T M Mc H) A hn hdA
  rw [←hM',hA] at hc
  have hi := relIndex_mul_relIndex (⊥ : Subgroup G) (secondParabolic T M Mc H) M bot_le hL
  simp only [relIndex_bot_left] at hi
  exact Nat.eq_of_mul_eq_mul_left (Nat.card_pos (α := secondParabolic T M Mc H)) (hi.trans hc)

omit hG hempty hM hu hmany hcard e hH in
private theorem involution_mem_normal_sylow_overgroup {A E : Subgroup G}
    (hTA : (T : Subgroup G) ≤ A) (hAE : A ≤ E)
    (hn : E ≤ normalizer (A : Set G)) {x : G} (hx : x ∈ E) (hx2 : orderOf x = 2) :
    x ∈ A := by
  have hp : IsPGroup 2 (zpowers x) := IsPGroup.of_card (n := 1)
    (by rw [Nat.card_zpowers,hx2,pow_one])
  obtain ⟨m,hm,hmt⟩ := UniqueFixedCoset.p_element_conjugate_into_sylow T (hTA.trans hAE) hx hp
  exact (mem_normalizer_iff.mp (hn hm) x).mpr (hTA hmt)

/-- Every involution of either enlarged endpoint already lies in its original
marked endpoint. This includes the genuine cubic extension. -/
theorem source_endpoint_involutions (r : MarkedTriality T M Mc H) :
    (∀ x ∈ Mc, orderOf x = 2 → x ∈ H) ∧
    (∀ x ∈ M, orderOf x = 2 → x ∈ secondParabolic T M Mc H) := by
  constructor
  · intro x hx hx2
    exact involution_mem_normal_sylow_overgroup hH.1.1.2
      (source_first_le_partner hG hempty hM hu hmany hcard e hH)
      (source_partner_le_first_normalizer hG hempty hM hu hmany hcard e hH r) hx hx2
  · intro x hx hx2
    exact involution_mem_normal_sylow_overgroup (le_sup_right.trans le_sup_left)
      (source_parabolics hG T hempty hM hu hmany hcard e H hH
        (firstResidualQuotientEquiv r)).2.2.2.2
      (source_second_normalized hG hempty hM hu hmany hcard e hH r) hx hx2

/-- Both literal endpoint extensions have the same relative index. -/
theorem source_endpoint_indices (r : MarkedTriality T M Mc H) :
    (secondParabolic T M Mc H).relIndex M = H.relIndex Mc := by
  by_cases he : Mc = H
  · have hL := source_second_eq_of_partner_eq hG hempty hM hu hmany hcard e hH r he
    rw [hL,he,relIndex_self,relIndex_self]
  · obtain ⟨A,_,hA,hAH,hAL,hdH,hdL,hMc,hM',_⟩ :=
      source_split_endpoint_data hG hempty hM hu hmany hcard e hH r he
    have hHMc := source_first_le_partner hG hempty hM hu hmany hcard e hH
    have hLM := (source_parabolics hG T hempty hM hu hmany hcard e H hH
      (firstResidualQuotientEquiv r)).2.2.2.2
    have hcardH := card_sup_eq_mul_of_normalizes_of_disjoint H A hAH hdH
    have hcardL := card_sup_eq_mul_of_normalizes_of_disjoint (secondParabolic T M Mc H) A hAL hdL
    rw [←hMc] at hcardH
    rw [←hM'] at hcardL
    have hidxH := relIndex_mul_relIndex (⊥ : Subgroup G) H Mc bot_le hHMc
    have hidxL := relIndex_mul_relIndex (⊥ : Subgroup G) (secondParabolic T M Mc H) M bot_le hLM
    simp only [relIndex_bot_left] at hidxH hidxL
    have hH' := Nat.eq_of_mul_eq_mul_left (Nat.card_pos (α := H)) (hidxH.trans hcardH)
    have hL' := Nat.eq_of_mul_eq_mul_left (Nat.card_pos (α := secondParabolic T M Mc H))
      (hidxL.trans hcardL)
    exact hL'.trans hH'.symm

end CFSG.Quasithin.Chapter14.Section02.EightLargeParabolic
