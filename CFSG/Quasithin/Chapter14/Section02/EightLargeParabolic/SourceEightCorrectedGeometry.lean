/-!
# Actual corrected eight-reflection geometry with faithful generated actor

The original selected half-path actor is generated by its forward root and
the old reversing reflection. The source root comparison identifies the
corrected six-path root, and projection off the actual central factor gives
exactly the same full-core complement. The opposite reflection is retained.
-/

public noncomputable section
set_option backward.isDefEq.respectTransparency false
open Subgroup Theory.GroupTheory RankTwoAmalgam SimpleGraph SimpleGraph.Walk
open Subgroup.CosetGeometry Theory.GroupTheory.WeakBNPair.RegularTree
open Theory.GroupAction.CubicTree
namespace CFSG.Quasithin.Chapter14.Section02.EightLargeParabolic.SourceEightCorrectedGeometry
open ChapterF.Source ChapterF.Source.SuzukiContainment ChapterF.Source.DGS85
open OriginalExtension Reduction NoncommutingProfile
open CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.ApartmentExchange
open ReducedCartan
section Geometry
variable {G : Type*} [Group G] {L : Fin 2 → Subgroup G} {S : Subgroup G}
local notation "A" => reducedAmalgam L S
local notation "F" => Universal.cosetFamily A
local notation "RF" => reducedFamily L S
local notation "P" => RankTwo.stabilizer F (base F true)

private theorem reflection_root_eq_forward_half
    (c : CompatibleCartans L (reducedSylow L S)) (d : SixPathSmallActorGeometry c)
    {a b : SourceVertex A} (p : (sourceGraph A).Walk a b) (hp:p.IsPath) (hl:p.length=12)
    (hm:p.getVert 6=base F true) (hn:p.getVert 7=base F false)
    (hs:∀ z∈p.support,z∈cartanApartment A (reflectionGroup c d.reflection)) :
    pathRoot (X := (A).Universal)
      (reflectionPath c d.reflection d.fixes d.moves d.normalizes 6 (by decide) true).walk=
        pathRoot (X := (A).Universal) (p.drop 6) := by
  let r := reflectionPath c d.reflection d.fixes d.moves d.normalizes 6 (by decide) true
  have ht := (Universal.cosetGraph_isTree A
    (inclusion_injective (commonBorel_le_parabolic 0))
    (inclusion_injective (commonBorel_le_parabolic 1))).isAcyclic
  have hab : (sourceGraph A).Adj (base F true) (base F false) :=
    ⟨by change true≠false;decide,incident_base _ _ _⟩
  let l := (localMoversTrack ht ⟨source_action A⟩ hab (d.fixes true) (d.fixes false)
    (d.moves true) (d.moves false)).toLine
  have hcoords : ∀ k≤(p.drop 6).length,(p.drop 6).getVert k=l.vertex (k:ℤ) := by
    apply path_getVert_eq_line ht l (p.drop 6) (hp.drop 6)
    · simpa only [l,localMoversTrack_zero] using hm
    · simpa only [Walk.drop_getVert,l,Track.toLine,localMoversTrack_one] using hn
    · intro z hz
      have hz' : z∈p.support := by
        rw [Walk.drop_support_eq_support_drop_min] at hz
        exact List.mem_of_mem_drop hz
      have hz'' := hs z hz'
      rw [reflectionApartment_eq_oriented_line c d.reflection d.fixes d.squares d.normalizes true] at hz''
      exact hz''
  have he := pathRoot_map_conj (X := (A).Universal) (p.drop 6) r.walk.reverse 1
    (by rw [Walk.drop_length,hl,Walk.length_reverse,r.length_eq]) (by
      intro k hk
      rw [one_smul,hcoords k hk]
      exact (reflectionPath_reverse_getVert c d.reflection d.fixes d.moves d.squares
        d.normalizes 6 (by decide) true k (by simpa only [Walk.drop_length,hl] using hk)).symm)
  have hroot : pathRoot (X := (A).Universal) (p.drop 6)=pathRoot r.walk := by
    have hc : (MulAut.conj (1 : (A).Universal)).toMonoidHom=MonoidHom.id _ := by
      ext x
      simp
    simpa only [hc,Subgroup.map_id,pathRoot_reverse] using he
  exact hroot.symm

private theorem half_actor_generated_by_root_reflection
    (c : CompatibleCartans L (reducedSylow L S)) (d : SixPathSmallActorGeometry c)
    {a b : SourceVertex A} (p : (sourceGraph A).Walk a b) (hp:p.IsPath) (hl:p.length=12)
    (hm:p.getVert 6=base F true) (hn:p.getVert 7=base F false)
    (hs:∀ z∈p.support,z∈cartanApartment A (reflectionGroup c d.reflection))
    (hrev:∀ k≤12,d.reflection true • p.getVert k=p.getVert (12-k)) :
    halfPathActor (X := (A).Universal) p 6≤
      pathRoot (X := (A).Universal)
        (reflectionPath c d.reflection d.fixes d.moves d.normalizes 6 (by decide) true).walk ⊔
          zpowers (d.reflection true) := by
  rw [reflection_root_eq_forward_half c d p hp hl hm hn hs]
  let R := pathRoot (X := (A).Universal) (p.drop 6)
  let t := d.reflection true
  let J := R⊔zpowers t
  obtain ⟨_,he⟩ := pathRoot_halves_reflection p 6 hl t hrev
  apply sup_le le_sup_left
  rw [←he]
  rintro _ ⟨x,hx,rfl⟩
  exact J.mul_mem (J.mul_mem (mem_sup_right (mem_zpowers t)) (mem_sup_left hx))
    (J.inv_mem (mem_sup_right (mem_zpowers t)))

/-- The corrected actual root and reflection generate the same faithful
full-core complement; the original binary reflection class is retained. -/
@[expose] def HasCorrectedEightGeometry (h:HypothesisF11 L S)
    (c:CompatibleCartans L (reducedSylow L S)) : Prop :=
  ∃ d:SixPathSmallActorGeometry c,
    Nonempty (BinarySixPathReflectionClass h false (d.reflection false)) ∧
    let R := pathRoot (X := (A).Universal)
      (reflectionPath c d.reflection d.fixes d.moves d.normalizes 6 (by decide) true).walk
    let K := R⊔zpowers (d.reflection true)
    K≤P ∧ cartan c≤K ∧ (pCore 2 P).IsComplement' (K.subgroupOf P) ∧ pCore 2 K=⊥

private theorem assemble (h:HypothesisF11 L S) (H:Subgroup G)
    (hactor:graphLocalGroup RF (RankTwo.base RF true)=RankTwo.stabilizer RF (RankTwo.base RF true))
    (hN:SourceEightTreeNormalizer.HasEightTreeNormalizer h H)
    (c:CompatibleCartans L (reducedSylow L S))
    (hhalf:SourceEightHalfActor.HasEightHalfActor h c)
    (heq:SourceReflectedRootEquality.HasReflectedRootEquality c) :
    HasCorrectedEightGeometry h c := by
  obtain ⟨d,hclass,_,K,fK,finK,chK,_,em,hpaths,a,b,p,hp,hl,hmid,hnext,hT,hrev,_,hcore,_,hcomp,_⟩ := hhalf
  let _ := fK
  let _ := finK
  let _ := chK
  let D := halfPathActor (X := (A).Universal) p 6
  have hC:cartan c≤D := by
    have hh := (hpaths p hp hl hT).2.2.2.2.2.2.1
    exact hh (by rw [hmid];rfl)
  have hDP:D≤P := by
    intro x hx
    change x • RankTwo.base F true=RankTwo.base F true
    rw [←hmid]
    exact halfPathActor_le_midpoint_stabilizer hl hx
  have hfull:graphLocalGroup RF ((bOne_tree_cover h).vertex (p.getVert 6))=
      RankTwo.stabilizer RF ((bOne_tree_cover h).vertex (p.getVert 6)) := by
    rw [hmid,(bOne_tree_cover h).vertex_base]
    exact hactor
  have hDcomp:(pCore 2 P).IsComplement' (D.subgroupOf P) :=
    SourceEightReflectionChange.complement_subgroupOf_congr D _ P
      (congrArg (RankTwo.stabilizer F) hmid)
      (SourceEightReflectionChange.half_complement_in_stabilizer h p hl hfull hcomp)
  have hroot := SourceRootHalfActor.original_reflection_root_le_half_actor c d p hp hl hmid hnext hT
  have hgen := half_actor_generated_by_root_reflection c d p hp hl hmid hnext hT hrev
  obtain ⟨J,hDJ,hCJ,hdis,htprod,hball⟩ :=
    SourceEightReflectionChange.correction_frame h H hactor hN c d p hl hmid hC hrev hcomp
  have hchoices:SixPathReplacementAlternatives c d.reflection d.fixes d.moves d.normalizes true D := by
    constructor
    intro t' hf hm hs hn _ht ho _hprefix
    let d':SixPathSmallActorGeometry c :=
      {reflection:=t',fixes:=hf,moves:=hm,squares:=hs,normalizes:=hn,
       transitive:=d.transitive,thick:=Assembly.BTwoSource.strict_path_thickness_source h t' hf hm,
       odd:=d.odd}
    exact Or.inl (heq d d' ho D hDP hDcomp hC hroot)
  obtain ⟨t',hf,hm,hs,hn,_,ho,_,_,hgen',hcore'⟩ :=
    source_six_central_replacement_root c d.reflection d.fixes d.moves d.squares d.normalizes
      h true J D hDJ hCJ hdis htprod hball hroot hgen hcore hchoices d.transitive d.thick d.odd
  let d':SixPathSmallActorGeometry c :=
    {reflection:=t',fixes:=hf,moves:=hm,squares:=hs,normalizes:=hn,
     transitive:=d.transitive,thick:=Assembly.BTwoSource.strict_path_thickness_source h t' hf hm,
     odd:=d.odd}
  refine ⟨d',?_,?_⟩
  · change Nonempty (BinarySixPathReflectionClass h false (t' false))
    have ho' : t' false=d.reflection false := ho
    rw [ho']
    exact hclass false
  · change (_⊔zpowers (t' true):Subgroup (A).Universal)≤P ∧ _
    rw [hgen']
    exact ⟨hDP,hC,hDcomp,hcore⟩
end Geometry

open SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
variable {G : Type*} [Group G] [Finite G]
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (H : Subgroup G) (hH : H ∈ Chapter3.HStar (T : Subgroup G) M)
    (eR : (pResidual 2 H ⧸ pCore 2 (pResidual 2 H)) ≃* Theory.PSL2.BinaryGroup 3)
include hG hempty hM hu hmany hcard e hH eR


local notation "Lₛ" => ![locals T M Mc H 1,locals T M Mc H 0]
local notation "Sₛ" => (T : Subgroup G)
set_option maxHeartbeats 800000 in
/-- The original source constructs corrected reflection geometry with a
faithful eight-root/reflection group and unchanged binary reflection. -/
theorem source_corrected_eight_geometry
    (c:CompatibleCartans Lₛ (reducedSylow Lₛ Sₛ)) :
    HasCorrectedEightGeometry
      (show HypothesisF11 Lₛ Sₛ from
        (source_hypothesis hG T hempty hM hu hmany hcard e H hH eR).1.swap) c := by
  exact assemble (L := Lₛ) (S := Sₛ)
    (source_hypothesis hG T hempty hM hu hmany hcard e H hH eR).1.swap H
    (SourceEightTreeEndpoint.source_eight_tree_endpoint hG T hempty hM hu hmany hcard e H hH eR).2
    (SourceEightTreeNormalizer.source_eight_tree_normalizer hG T hempty hM hu hmany hcard e H hH eR) c
    (SourceEightHalfActor.source_eight_halfactor hG T hempty hM hu hmany hcard e H hH eR c)
    (SourceReflectedRootEquality.source_reflected_root_equality hG T hempty hM hu hmany hcard e H hH eR c)
end CFSG.Quasithin.Chapter14.Section02.EightLargeParabolic.SourceEightCorrectedGeometry
