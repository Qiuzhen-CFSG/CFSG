module
public import CFSG.Quasithin.Chapter14.Section02.ProperComponent
public import Theory.GroupAction.ComponentRankAction.OuterTwo
public import CFSG.Quasithin.Chapter14.Section02.ProperOutsideSylow

/-!
# The first three-residual calculation in the proper completion

The original plane-source residual Y is two-perfect, and Y/O₂(Y) has
order three. Thus Y is generated by three-elements. Functoriality places
Y in the three-residual of each containing subgroup. In the canonical
completion X=K₁YS, the already constructed C-component L is therefore
large enough to contain Y as soon as A.3.18 identifies O^{3′}(X) with L.

The final theorem supplies this identity, Y≤L, and X=LS for the
centerless quasisimple rows with cubic rank two and two-group outer
automorphisms. No maximality in a later overgroup is needed here. Model
identification remains explicit; the triality cubic action is separate.

Source: Aschbacher--Smith 14.1.18 and 14.2.15, printed pp.980--981,985;
A.3.18, printed pp.51--53.
-/

public section
open Subgroup Theory.GroupTheory Stellmacher
namespace CFSG.Quasithin.Chapter14.Section02
open SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
variable {G : Type*} [Group G] [Finite G]

private theorem three_generated_of_two_perfect
    {Y : Type*} [Group Y] [Finite Y]
    (hp : IsPPerfect 2 Y) (hc : Nat.card (Y ⧸ pCore 2 Y) = 3) :
    primeToResidual 3 Y = ⊤ := by
  let Q := pCore 2 Y
  let N := primeToResidual 3 Y
  let q := QuotientGroup.mk' Q
  have hq : IsPGroup 3 (Y ⧸ Q) := IsPGroup.of_card (n := 1) (by simpa using hc)
  have hr : primeToResidual 3 (Y ⧸ Q) = ⊤ := by
    apply top_unique
    intro y _
    obtain ⟨n, hn⟩ := hq y
    exact mem_primeToResidual_of_pow hn
  have hm : N.map q = ⊤ := by
    rw [map_primeToResidual_of_surjective 3 q (QuotientGroup.mk'_surjective Q),hr]
  have hs : N ⊔ Q = ⊤ := by
    have hh := congrArg (fun A : Subgroup (Y ⧸ Q) => A.comap q) hm
    simpa only [comap_map_eq,q,QuotientGroup.ker_mk',comap_top] using hh
  exact hp N inferInstance (isPGroup_quotient_of_sup_eq_top N Q pCore_isPGroup hs)

/-- The literal plane-source residual is generated by three-elements. -/
theorem source_residual_three_generated
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3)) :
    primeToResidual 3 (sourceResidual M Mc) = ⊤ :=
  three_generated_of_two_perfect (residualY_isPPerfect M Mc)
    (source_residual_twoCore_quotient_card hG T hempty hM hu hmany hcard e)

/-- Its image lies in the actual three-residual of every containing subgroup. -/
theorem source_residual_le_three_residual
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (X : Subgroup G) (hYX : sourceResidual M Mc ≤ X) :
    sourceResidual M Mc ≤ (primeToResidual 3 X).map X.subtype := by
  let f := inclusion hYX
  have hm := map_primeToResidual_le_of_hom 3 f
  rw [source_residual_three_generated hG T hempty hM hu hmany hcard e] at hm
  intro y hy
  exact ⟨f ⟨y,hy⟩,hm ⟨⟨y,hy⟩,trivial,rfl⟩,rfl⟩

/-- The first A.3.18 identity absorbs Y and gives the exact join LS=X. -/
theorem source_proper_completion_sylow_join_of_three_residual
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (K S : Subgroup G) :
    let X := K ⊔ sourceResidual M Mc ⊔ S
    let L := (solvableResidual X).map X.subtype
    K ≤ L → (primeToResidual 3 X).map X.subtype = L →
    sourceResidual M Mc ≤ L ∧ L ⊔ S = X := by
  let X := K ⊔ sourceResidual M Mc ⊔ S
  let L := (solvableResidual X).map X.subtype
  dsimp only
  intro hKL hr
  have hYX : sourceResidual M Mc ≤ X := le_sup_right.trans le_sup_left
  have hYL : sourceResidual M Mc ≤ L := by
    have hy := source_residual_le_three_residual hG T hempty hM hu hmany hcard e X hYX
    change (primeToResidual 3 X).map X.subtype = L at hr
    rwa [hr] at hy
  refine ⟨hYL,le_antisymm (sup_le (map_subtype_le _) le_sup_right) ?_⟩
  exact sup_le (sup_le (hKL.trans le_sup_left) (hYL.trans le_sup_left)) le_sup_right

private theorem ambient_component_three_residual_of_outer_two
    (X L : Subgroup G) (hL : L ∈ Chapter1.cComponentsIn X)
    (hq : IsQuasisimple L) (hz : center L = ⊥) (hr : 2 ≤ primeRank 3 L)
    (hbound : primeRank 3 X ≤ 2) (ho : IsPGroup 2 (MulAut.Outer L)) :
    (primeToResidual 3 X).map X.subtype = L := by
  let B := L.subgroupOf X
  let eB : B ≃* L := subgroupOfEquivOfLe hL.1
  let := hq
  let : IsQuasisimple B := IsQuasisimple.of_mulEquiv eB.symm
  have hc : center B = ⊥ := by
    apply eq_bot_iff.mpr
    intro b hb
    have hh : eB b ∈ center L := (centerCongr eB ⟨b,hb⟩).property
    rw [hz,mem_bot] at hh
    exact mem_bot.mpr (eB.map_eq_one_iff.mp hh)
  have hB : IsComponent X B := ⟨hL.2.subnormal,inferInstance⟩
  have hrB : 2 ≤ primeRank 3 B := by rwa [primeRank_equiv 3 eB]
  let e : (B ⧸ center B) ≃* L :=
    ((QuotientGroup.quotientMulEquivOfEq hc).trans QuotientGroup.quotientBot).trans eB
  have he := (Theory.GroupAction.ComponentRankAction.component_eq_primeClosure_and_residual_of_outer_twoGroup
    hB (by rw [hc]; simp) hrB hbound e (by decide) ho).2
  rw [←he,map_subgroupOf_eq_of_le hL.1]

/-- The original first residual identity, Y-placement, and Sylow join for outer-two rows. -/
theorem source_proper_completion_three_residual_of_outer_two
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (K S : Subgroup G) (hST : S ≤ (T : Subgroup G))
    (hK : K ∈ Chapter1.L G S) (hSN : S ≤ normalizer (K : Set G))
    (hcore : (K ⊔ sourceResidual M Mc ⊔ S).pCoreIn 2 ≠ ⊥)
    (hs : Chapter1.IsSylowIn 2 S (K ⊔ sourceResidual M Mc ⊔ S)) :
    let X := K ⊔ sourceResidual M Mc ⊔ S
    let L := (solvableResidual X).map X.subtype
    IsQuasisimple L → center L = ⊥ → 2 ≤ primeRank 3 L →
    IsPGroup 2 (MulAut.Outer L) →
    (primeToResidual 3 X).map X.subtype = L ∧
      sourceResidual M Mc ≤ L ∧ L ⊔ S = X := by
  let X := K ⊔ sourceResidual M Mc ⊔ S
  let L := (solvableResidual X).map X.subtype
  dsimp only
  intro hq hz hr ho
  obtain ⟨hL,hKL,_⟩ := source_proper_completion_component hG T hempty hM hu hmany
    hcard e K S hST hK hSN hcore hs
  have hXN : X ≤ normalizer (X.pCoreIn 2 : Set G) :=
    X.le_normalizer.trans (normalizer_le_normalizer_characteristic_image X (pCore 2 X))
  have hlocal := hG.twoLocal_sqtk
    (show IsTwoLocal (normalizer (X.pCoreIn 2 : Set G)) from
      ⟨X.pCoreIn 2,hcore,isPGroup_pCoreIn 2 X,rfl⟩)
  have hbound : primeRank 3 X ≤ 2 :=
    (Theory.GroupTheory.primeRank_le_of_injective 3 (inclusion hXN) (inclusion_injective hXN)).trans
      (hlocal.stronglyQuasithin 3 Nat.prime_three (by decide))
  have he := ambient_component_three_residual_of_outer_two X L hL hq hz hr hbound ho
  exact ⟨he,source_proper_completion_sylow_join_of_three_residual hG T hempty hM hu hmany
    hcard e K S hKL he⟩
end CFSG.Quasithin.Chapter14.Section02
