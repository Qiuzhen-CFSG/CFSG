module
public import CFSG.Quasithin.Chapter14.Section02.ProperCompletionThreeResidual
public import CFSG.Quasithin.Chapter14.Section02.ProperContainingThreeResidual
public import CFSG.Quasithin.ChapterA.Section03.OddPrime.SourceModels.FourSporadic
public import Theory.SpecificGroups.Triality.CubicComponentAction

/-!
# The two cubic residual identities in the five remaining completion rows

For the literal triality(2), J₂, J₄, HS and Ru models, the concrete component
action gives O^{3′}(X)=L. The original residual Y is generated by cubic
elements, so Y≤L and LS=X. The fixed central omega subgroup consequently
places X in the later maximal two-local M₁, and the original Sylow argument
applies there as well.

The exact source 1.2.8(4) conclusion L∈L*(G,S) identifies the unique normal
containing C-component supplied by 1.2.4. The same five model calculations
then prove the literal identity O^{3′}(M₁)=L required by
`ProperBinaryPairTerminal`. No cubic-rank or outer-action assumption remains.
Local maximality, the actual model-row selection, and the preceding source
inputs remain explicit; this is not a proof of 1.2.8(4). The first identity
here is specialized to the five rows and does not replace the earlier
larger-field Lie comparison that leads to those rows.

Source: Aschbacher--Smith 14.2.15, pp.985--986, using 1.2.4, 1.2.8(4),
and A.3.18.
-/

public section
open Subgroup Theory.GroupTheory Stellmacher
namespace CFSG.Quasithin.Chapter14.Section02
open SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
variable {G : Type*} [Group G] [Finite G]

/-- A.3.18 for the original subgroup, with all five model action calculations discharged. -/
theorem proper_five_row_component_three_residual
    (X L : Subgroup G) (hL : L ∈ Chapter1.cComponentsIn X)
    (hq : IsQuasisimple L) (hz : center L = ⊥) (hbound : primeRank 3 X ≤ 2)
    (hm : Triality.Standard.IsTrialityGroupAt 2 L ∨
      Nonempty (L ≃* Sporadic.LeechRelated.J2.Carrier) ∨
      Nonempty (L ≃* Janko4.Model) ∨
      Nonempty (L ≃* Sporadic.LeechRelated.HS.Carrier) ∨
      Nonempty (L ≃* Rudvalis.Model)) :
    (primeToResidual 3 X).map X.subtype = L := by
  let B := L.subgroupOf X
  let eB : B ≃* L := subgroupOfEquivOfLe hL.1
  let := hq
  let : IsQuasisimple B := IsQuasisimple.of_mulEquiv eB.symm
  have hc : center B = ⊥ := by
    apply eq_bot_iff.mpr
    intro b hb
    have hh : eB b ∈ center L := (centerCongr eB ⟨b,hb⟩).property
    rw [hz,mem_bot] at hh
    exact mem_bot.mpr (eB.map_eq_one_iff.mp hh)
  have hB : IsComponent X B := ⟨hL.2.subnormal,inferInstance⟩
  let e : (B ⧸ center B) ≃* L :=
    ((QuotientGroup.quotientMulEquivOfEq hc).trans QuotientGroup.quotientBot).trans eB
  have he : B = primeToResidual 3 X := by
    rcases hm with ht | hs
    · obtain ⟨et⟩ := (Triality.Standard.isTrialityGroupAt_binary_iff L 1 (by decide)).mp
        (show Triality.Standard.IsTrialityGroupAt (2^1) L from ht)
      exact (Triality.Standard.CubicComponentAction.component_eq_primeClosure_and_residual
        hbound hB (by rw [hc]; simp) 1 (by decide) (e.trans et)).2
    · obtain ⟨hr,ho⟩ := ChapterA.Section03.OddPrime.SourceModels.FourSporadic.three_rank_and_outer_two hz hs
      have hrB : 2 ≤ primeRank 3 B := by rwa [primeRank_equiv 3 eB]
      exact (Theory.GroupAction.ComponentRankAction.component_eq_primeClosure_and_residual_of_outer_twoGroup
        hB (by rw [hc]; simp) hrB hbound e (by decide) ho).2
  rw [←he,map_subgroupOf_eq_of_le hL.1]

/-- The first identity absorbs the original Y and gives LS=X in the five rows. -/
theorem source_proper_completion_three_residual_of_five_rows
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (K S : Subgroup G) (hST : S ≤ (T : Subgroup G))
    (hK : K ∈ Chapter1.L G S) (hSN : S ≤ normalizer (K : Set G))
    (hcore : (K ⊔ sourceResidual M Mc ⊔ S).pCoreIn 2 ≠ ⊥)
    (hs : Chapter1.IsSylowIn 2 S (K ⊔ sourceResidual M Mc ⊔ S)) :
    let X := K ⊔ sourceResidual M Mc ⊔ S
    let L := (solvableResidual X).map X.subtype
    IsQuasisimple L → center L = ⊥ →
    (Triality.Standard.IsTrialityGroupAt 2 L ∨
      Nonempty (L ≃* Sporadic.LeechRelated.J2.Carrier) ∨
      Nonempty (L ≃* Janko4.Model) ∨
      Nonempty (L ≃* Sporadic.LeechRelated.HS.Carrier) ∨
      Nonempty (L ≃* Rudvalis.Model)) →
    (primeToResidual 3 X).map X.subtype = L ∧
      sourceResidual M Mc ≤ L ∧ L ⊔ S = X := by
  let X := K ⊔ sourceResidual M Mc ⊔ S
  let L := (solvableResidual X).map X.subtype
  dsimp only
  intro hq hz hm
  obtain ⟨hL,hKL,_⟩ := source_proper_completion_component hG T hempty hM hu hmany
    hcard e K S hST hK hSN hcore hs
  have hXN : X ≤ normalizer (X.pCoreIn 2 : Set G) :=
    X.le_normalizer.trans (normalizer_le_normalizer_characteristic_image X (pCore 2 X))
  have hlocal := hG.twoLocal_sqtk
    (show IsTwoLocal (normalizer (X.pCoreIn 2 : Set G)) from
      ⟨X.pCoreIn 2,hcore,isPGroup_pCoreIn 2 X,rfl⟩)
  have hbound : primeRank 3 X ≤ 2 :=
    (Theory.GroupTheory.primeRank_le_of_injective 3 (inclusion hXN) (inclusion_injective hXN)).trans
      (hlocal.stronglyQuasithin 3 Nat.prime_three (by decide))
  have he := proper_five_row_component_three_residual X L hL hq hz hbound hm
  exact ⟨he,source_proper_completion_sylow_join_of_three_residual hG T hempty hM hu hmany
    hcard e K S hKL he⟩

/-- The later residual identity once source 1.2.8(4) supplies local maximality. -/
theorem proper_five_row_containing_three_residual
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (M₁ L S : Subgroup G) (hM₁ : IsMaximalTwoLocal M₁)
    (hs : Chapter1.IsSylowIn 2 S M₁) (hLM₁ : L ≤ M₁)
    (hmax : L ∈ Chapter1.LStar G S) (hSN : S ≤ normalizer (L : Set G))
    (hq : IsQuasisimple L) (hz : center L = ⊥)
    (hm : Triality.Standard.IsTrialityGroupAt 2 L ∨
      Nonempty (L ≃* Sporadic.LeechRelated.J2.Carrier) ∨
      Nonempty (L ≃* Janko4.Model) ∨
      Nonempty (L ≃* Sporadic.LeechRelated.HS.Carrier) ∨
      Nonempty (L ≃* Rudvalis.Model)) :
    L ∈ Chapter1.cComponentsIn M₁ ∧ (primeToResidual 3 M₁).map M₁.subtype = L := by
  obtain ⟨hL,_⟩ := proper_containing_component_of_local_maximal hG M₁ L S hM₁ hs hLM₁ hmax hSN
  exact ⟨hL,proper_five_row_component_three_residual M₁ L hL hq hz
    ((hG.twoLocal_sqtk hM₁.1).stronglyQuasithin 3 Nat.prime_three (by decide)) hm⟩

/-- Both literal residual identities at the original fixed-omega centralizer consumer. -/
theorem source_proper_five_row_containing_three_residual
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (H : Subgroup G) (hH : H ∈ Chapter3.HStar (T : Subgroup G) M)
    (K S : Subgroup G) (hST : S ≤ (T : Subgroup G))
    (hi : S.relIndex (T : Subgroup G) = 2)
    (hN : normalizer (omegaOneCenterAmbient S : Set G) ≤ Mc)
    (hplacement : ∀ P : Sylow 2 Mc, S ≤ (P : Subgroup Mc).map Mc.subtype →
      maximalTwoLocalOvergroups (K ⊔ (P : Subgroup Mc).map Mc.subtype) = {Mc})
    (hK : K ∈ Chapter1.L G S) (hSN : S ≤ normalizer (K : Set G))
    (hcore : (K ⊔ sourceResidual M Mc ⊔ S).pCoreIn 2 ≠ ⊥)
    (hs : Chapter1.IsSylowIn 2 S (K ⊔ sourceResidual M Mc ⊔ S))
    (M₁ : Subgroup G) (hM₁ : IsMaximalTwoLocal M₁) :
    let X := K ⊔ sourceResidual M Mc ⊔ S
    let L := (solvableResidual X).map X.subtype
    centralizer ((omegaOneCenterAmbient S ⊓ centralizer (L : Set G)) : Set G) ≤ M₁ →
    L ∈ Chapter1.LStar G S → IsQuasisimple L → center L = ⊥ →
    (Triality.Standard.IsTrialityGroupAt 2 L ∨
      Nonempty (L ≃* Sporadic.LeechRelated.J2.Carrier) ∨
      Nonempty (L ≃* Janko4.Model) ∨
      Nonempty (L ≃* Sporadic.LeechRelated.HS.Carrier) ∨
      Nonempty (L ≃* Rudvalis.Model)) →
    (primeToResidual 3 X).map X.subtype = L ∧
      sourceResidual M Mc ≤ L ∧ L ⊔ S = X ∧
      L ∈ Chapter1.cComponentsIn M₁ ∧ (primeToResidual 3 M₁).map M₁.subtype = L := by
  let X := K ⊔ sourceResidual M Mc ⊔ S
  let L := (solvableResidual X).map X.subtype
  dsimp only
  intro hC hmax hq hz hm
  obtain ⟨hX₃,hYL,hLS⟩ := source_proper_completion_three_residual_of_five_rows
    hG T hempty hM hu hmany hcard e K S hST hK hSN hcore hs hq hz hm
  have hXM₁ : X ≤ M₁ := by
    change L ⊔ S = X at hLS
    rw [←hLS]
    exact (proper_sylow_join_le_fixed_center_centralizer L S).trans hC
  have hs₁ := source_proper_completion_contained_sylow hG T hempty hM hu hmany hcard e H hH K S hST hi
    hN hplacement M₁ hM₁ hXM₁
  have hLN : X ≤ normalizer (L : Set G) := by
    have hh := (solvableResidual X).le_normalizer_map X.subtype
    rwa [normalizer_eq_top,←MonoidHom.range_eq_map,range_subtype] at hh
  exact ⟨hX₃,hYL,hLS,proper_five_row_containing_three_residual hG M₁ L S hM₁ hs₁
    ((map_subtype_le _).trans hXM₁) hmax ((le_sup_right : S ≤ X).trans hLN) hq hz hm⟩
end CFSG.Quasithin.Chapter14.Section02
