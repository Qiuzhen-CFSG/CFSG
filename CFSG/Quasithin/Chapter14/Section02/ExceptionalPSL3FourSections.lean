/-!
# Selected quadratic sections in the exceptional PSL₃(4) case

A faithful quadratic actor with fixed codimension at most twice its binary
rank remains the same actor on a surviving component-irreducible subquotient.
On its faithful action image, the PSL₃(4) field-cover exclusion forces the
quadratic ratio to exceed two. This contradicts the retained bound.

The restriction to the subgroup generated by the component and actor retains
all literal inclusions, and its quotient by the component is a two-group.
This is the selected F.9.18(3–4) and B.4 route used in the abelian branch of
Aschbacher–Smith 14.2.13, printed p.984; no universal section selector is assumed.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
namespace CFSG.Quasithin.Chapter14.Section02
open Chapter15.Section03.AbelianAmalgam.GenerationOne.RepresentationReduction.SourceRestrictions
open Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.ExternalModules.FFSections.SourceOrbit.ActionImage.Structure
universe u
variable {G V : Type u} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
    [Finite V] {κ : GroupClass.{u}}

theorem false_of_psl3Four_quadratic_supplement
    (ρ : Representation (ZMod 2) G V) (K A : Subgroup G)
    [K.Normal] [IsQuasisimple K] (hsq : IsSQTK κ G)
    (hm : ClassicalGroup.IsPSL K 3 4) (hZ : center K = ⊥)
    (hgen : K ⊔ A = ⊤) (hquot : IsPGroup 2 (G ⧸ K))
    (hA : IsElementaryTwo A) (hq : IsQuadratic ρ A)
    (hc : fixedCodim ρ A ≤ 2 * rank A)
    (hAC : A ⊓ centralizer (K : Set G) = ⊥) (hn : ¬ K ≤ ρ.ker) : False := by
  let : FiniteDimensional (ZMod 2) V := Module.Finite.of_finite
  obtain ⟨U,N,hi,hn,hq,hc⟩ := exists_component_irreducible_quadratic_section
    ρ K A hZ hgen hA hq hc hAC hn
  let : Finite (U ⧸ N.toSubmodule) := Module.finite_of_finite (ZMod 2)
  let σ := N.quotientRepresentation
  have hnact : ¬ ∀ k ∈ K, ∀ v, σ k v = v := by
    intro h
    apply hn
    intro k hk
    rw [MonoidHom.mem_ker]
    exact LinearMap.ext (h k hk)
  have hsurvive : ¬ K ≤ (actionHom σ).ker := by
    intro h
    exact hnact (fun k hk v => (actionHom_eq_one_iff σ k).mp (h hk) v)
  have hfaith := faithful_on_section_of_central_kernel σ K A hAC
    (central_kernel_of_quasisimple σ K hnact)
  have hbound : quadraticRatio (imageRepresentation σ) ≤ 2 := by
    apply (quadraticRatio_le_two_iff _).mpr
    refine ⟨actionSubgroup σ A, hA.actionSubgroup σ hfaith, ?_, ?_⟩
    · rintro a ⟨x,hx,rfl⟩ b ⟨y,hy,rfl⟩ v
      exact hq x hx y hy v
    · rw [fixedCodim_actionSubgroup,actionSubgroup_rank σ A hfaith]
      exact hc
  obtain ⟨_,hirr,hfit⟩ := image_structure σ K hsurvive hquot hi
  let e : K ≃* generalizedFitting (actionImage σ) :=
    (componentEquiv σ K hsurvive hZ).trans (MulEquiv.subgroupCongr hfit.symm)
  have hmodel : ClassicalGroup.IsPSL (generalizedFitting (actionImage σ)) 3 4 :=
    hm.of_mulEquiv e.symm
  have his : IsIrreducible ((imageRepresentation σ).comp
      (generalizedFitting (actionImage σ)).subtype) := hfit.symm ▸ hirr
  exact not_le_of_gt (ChapterK.Linear.Recognition.PSL3FourExclusion.quadraticRatio_gt_two
    (image_sqtk σ K hsurvive hsq hquot hZ) rfl hmodel
    (imageRepresentation_injective σ) his) hbound

open Chapter15.Section03.AbelianAmalgam.GenerationOne.OriginalModule.Normal

theorem false_of_psl3Four_faithful_quadratic_actor
    (ρ : Representation (ZMod 2) G V) (K A : Subgroup G) [K.Normal]
    (hsq : IsSQTK κ G) (hm : ClassicalGroup.IsPSL K 3 4)
    (hf : Function.Injective ρ)
    (hA : IsElementaryTwo A) (hq : IsQuadratic ρ A)
    (hc : fixedCodim ρ A ≤ 2 * rank A)
    (hAC : A ⊓ centralizer (K : Set G) = ⊥) : False := by
  let D := K ⊔ A
  let L := K.subgroupOf D
  let B := A.subgroupOf D
  let σ := ρ.comp D.subtype
  have hmL : ClassicalGroup.IsPSL L 3 4 := hm.of_mulEquiv (componentInSupEquiv K A)
  obtain ⟨hqs,hZ,_⟩ := ChapterK.Linear.Recognition.PSL3FourExclusion.model_facts hmL
  let := hqs
  have hn : ¬ L ≤ σ.ker := by
    intro h
    have hL : L = ⊥ := by
      apply _root_.eq_bot_iff.mpr
      intro l hl
      have he : ρ l.val = ρ 1 := by
        have hv := h hl
        change ρ l.val = 1 at hv
        simpa only [map_one] using hv
      have hl1 := hf he
      exact Subtype.ext hl1
    let : IsSimpleGroup (L ⧸ center L) := IsQuasisimple.simple
    let : Nontrivial L := (QuotientGroup.mk'_surjective (center L)).nontrivial
    exact (Subgroup.nontrivial_iff_ne_bot L).mp this hL
  exact false_of_psl3Four_quadratic_supplement σ L B (hsq.subgroup D) hmL hZ
    (componentInSup_generated K A) (componentInSup_quotient K A hA)
    (actorInSup_elementary K A hA) (actorInSup_quadratic ρ K A hq)
    (actorInSup_bound ρ K A hc) (actorInSup_faithful K A hAC) hn

end CFSG.Quasithin.Chapter14.Section02
