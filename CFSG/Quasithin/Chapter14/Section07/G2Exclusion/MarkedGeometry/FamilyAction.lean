module

public import Theory.GroupTheory.Commutator.ConjugateGeneration

/-!
# The line-family action in 14.7.56

The earlier local identities say `[V,L₂]=V₂` and that Y normalizes L₂ and
centralizes V₂. Conjugating the commutator equality gives `[Vʸ,L₂]=V₂`
for every y in Y. Hence L₂ stabilizes each member of the family Vʸ,
and its commutator with the subgroup generated by that family is V₂.
This is pointwise fixation of a family of subgroups, not pointwise fixation
of the vectors of those subgroups.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), Lemma 14.7.56,
printed p.1066. The quotient action image and conjugate coverage are separate
source obligations; this module proves the commutator and family-fixation step.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter14.Section07.G2Exclusion.MarkedGeometry
open Subgroup
variable {G : Type*} [Group G]

/-- The literal family `V^Y` from 14.7.56. -/
def conjugateLineFamily (V Y : Subgroup G) : Set (Subgroup G) :=
  Set.range (fun y : Y => V.map (MulAut.conj (y : G)).toMonoidHom)

/-- The subgroup `U(V₂)=⟨V^Y⟩` once the preceding geometric orbit calculation
has identified the family with the preimages of the three lines. -/
def generatedLineFamily (V Y : Subgroup G) : Subgroup G :=
  ⨆ y : Y, V.map (MulAut.conj (y : G)).toMonoidHom

/-- The source commutator identity transports to every member of the Y-family. -/
theorem conjugate_line_commutator (V V₂ L₂ Y : Subgroup G)
    (hcomm : ⁅V,L₂⁆ = V₂) (hYL : Y ≤ normalizer L₂) (hYV : Y ≤ normalizer V₂)
    (y : Y) : ⁅V.map (MulAut.conj (y : G)).toMonoidHom,L₂⁆ = V₂ := by
  have h := congrArg (fun S : Subgroup G => S.map (MulAut.conj (y : G)).toMonoidHom) hcomm
  have hL : L₂.map (MulAut.conj (y : G)).toMonoidHom = L₂ :=
    mem_normalizer_iff_map_conj_eq.mp (hYL y.property)
  have hV : V₂.map (MulAut.conj (y : G)).toMonoidHom = V₂ :=
    mem_normalizer_iff_map_conj_eq.mp (hYV y.property)
  simpa only [map_commutator, hL, hV] using h

/-- Lemma 14.7.56(2)'s family fixation: L₂ normalizes each line preimage.
The nontrivial commutator `V₂` is retained, so this does not assert that
L₂ centralizes its vectors. -/
theorem fixes_conjugate_line_family (V V₂ L₂ Y : Subgroup G)
    (hV₂ : V₂ ≤ V) (hcomm : ⁅V,L₂⁆ = V₂)
    (hYL : Y ≤ normalizer L₂) (hYV : Y ≤ normalizer V₂) :
    ∀ P ∈ conjugateLineFamily V Y, L₂ ≤ normalizer P := by
  rintro P ⟨y,rfl⟩
  apply le_normalizer_iff_commutator_le_left.mpr
  rw [conjugate_line_commutator V V₂ L₂ Y hcomm hYL hYV y]
  rw [← mem_normalizer_iff_map_conj_eq.mp (hYV y.property)]
  exact map_mono hV₂

/-- The commutator of the full three-line span with L₂ is exactly V₂,
using the same earlier identities as the printed proof. -/
theorem generated_line_commutator (V V₂ L₂ Y : Subgroup G)
    (hcomm : ⁅V,L₂⁆ = V₂) (hYL : Y ≤ normalizer L₂) (hYV : Y ≤ normalizer V₂) :
    ⁅generatedLineFamily V Y,L₂⁆ = V₂ := by
  let F := fun y : Y => V.map (MulAut.conj (y : G)).toMonoidHom
  have hF (y : Y) : ⁅F y,L₂⁆ = V₂ :=
    conjugate_line_commutator V V₂ L₂ Y hcomm hYL hYV y
  have hnorm : generatedLineFamily V Y ≤ normalizer V₂ := by
    apply iSup_le
    intro y
    rw [← hF y]
    exact normalizer_commutator_ge_left (F y) L₂
  apply le_antisymm
  · apply commutator_le.mpr
    intro x hx l hl
    change x ∈ ⨆ y : Y, F y at hx
    revert l
    induction hx using iSup_induction' with
    | hp y x hx =>
        intro l hl
        rw [← hF y]
        exact commutator_mem_commutator hx hl
    | h1 =>
        intro l hl
        simpa only [commutatorElement_one_left] using V₂.one_mem
    | hmul x y hx _ ihx ihy =>
        intro l hl
        rw [commutatorElement_mul_left_eq_conj_mul]
        exact V₂.mul_mem ((mem_normalizer_iff.mp (hnorm hx) _).mp (ihy l hl)) (ihx l hl)
  · rw [← hF 1]
    exact commutator_mono (le_iSup F 1) le_rfl

/-- Actual source application: the printed Y is contained in C_H(V₂),
so the required normalization of V₂ follows without an extra hypothesis. -/
theorem source_family_action (V V₂ L₂ Y : Subgroup G)
    (hV₂ : V₂ ≤ V) (hcomm : ⁅V,L₂⁆ = V₂)
    (hYL : Y ≤ normalizer L₂) (hYV : Y ≤ centralizer (V₂ : Set G)) :
    (∀ P ∈ conjugateLineFamily V Y, L₂ ≤ normalizer P) ∧
      ⁅generatedLineFamily V Y,L₂⁆ = V₂ := by
  have hnorm : Y ≤ normalizer V₂ := hYV.trans (centralizer_le_normalizer (G := G) (V₂ : Set G))
  exact ⟨fixes_conjugate_line_family V V₂ L₂ Y hV₂ hcomm hYL hnorm,
    generated_line_commutator V V₂ L₂ Y hcomm hYL hnorm⟩

end CFSG.Quasithin.Chapter14.Section07.G2Exclusion.MarkedGeometry
