module

public import CFSG.Quasithin.Chapter14.Section07.G2Exclusion.MarkedGeometry.Models
public import CFSG.Quasithin.Chapter14.Section07.G2Exclusion.MarkedGeometry.MarkedPencil


/-!
# Singular points in the literal source quotient

An order-two subgroup of the binary natural model is generated by one nonzero
vector; its singular lift gives the point marking. In either model, an
order-two subgroup of a doubly singular line is singular. These deductions
apply the published pencil theorem to the literal quotient U/(V₁.subgroupOf U),
discharging its point-marking premise from earlier local order and containment
information. The Weyl application still requires the separate line marking.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), 14.7.55(2),(3),
printed p.1066, PDF p.1083. Models and coordinates use the existing attributed
ATLAS port (LICENSES/ATLAS.txt); no additional source is copied here.
-/

@[expose] public noncomputable section
namespace CFSG.Quasithin.Chapter14.Section07.G2Exclusion.MarkedGeometry.MarkedPencil.SourceActions
open Atlas.G2 Atlas.SplitOctonion Atlas.G2.Natural
open Atlas.G2.EvenLocal.NormalizerCover.OctonionHexagon
open Atlas.G2.EvenLocal.NormalizerCover.OctonionHexagon.CosetIdentification
open Subgroup
variable {W Q : Type*} [AddCommGroup W] [Module (ZMod 2) W] [Group Q]

private theorem span_map_le (e : Multiplicative W ≃* Q) (P : Subgroup Q)
    (v : W) (hv : e (Multiplicative.ofAdd v) ∈ P) :
    ((ZMod 2) ∙ v).toAddSubgroup.toSubgroup.map e.toMonoidHom ≤ P := by
  rintro _ ⟨x,hx,rfl⟩
  change e x ∈ P
  change Multiplicative.toAdd x ∈ (ZMod 2) ∙ v at hx
  obtain ⟨a,ha⟩ := Submodule.mem_span_singleton.mp hx
  change a • v = Multiplicative.toAdd x at ha
  have hb : ∀ a : ZMod 2, a = 0 ∨ a = 1 := by decide
  rcases hb a with rfl | rfl
  · have hx0 : x = 1 := by simpa using ha.symm
    simpa only [hx0, map_one] using P.one_mem
  · have hxv : x = Multiplicative.ofAdd v := by
      exact congrArg (Multiplicative.ofAdd : W → Multiplicative W)
        (show Multiplicative.toAdd x = v by simpa only [one_smul] using ha.symm)
    simpa only [hxv] using hv

/-- Every order-two subgroup of the natural module is a singular point. -/
theorem natural_point_of_card_two (e : Multiplicative (Space (ZMod 2)) ≃* Q)
    (P : Subgroup Q) (hP : Nat.card P = 2) :
    ∃ p, (transportGeometry naturalMap.geometry e).point p = P := by
  let : Finite P := Nat.finite_of_card_ne_zero (by omega)
  have hbot : P ≠ ⊥ := by
    intro h
    rw [h, Subgroup.card_bot] at hP
    omega
  obtain ⟨x,hx,hx1⟩ := (Subgroup.bot_or_exists_ne_one P).resolve_left hbot
  let v : Space (ZMod 2) := Multiplicative.toAdd (e.symm x)
  have hv : v ≠ 0 := by
    intro h
    apply hx1
    apply e.symm.injective
    simpa [v] using h
  obtain ⟨p,hp⟩ := natural_point_of_nonzero v hv
  refine ⟨p, Subgroup.eq_of_le_of_card_ge ?_ ?_⟩
  · change (naturalMap.point p).toAddSubgroup.toSubgroup.map e.toMonoidHom ≤ P
    rw [hp]
    exact span_map_le e P v (by simpa [v] using hx)
  · rw [(transportGeometry naturalMap.geometry e).point_card, hP]

/-- In either model, an order-two subgroup of a doubly singular line is a
singular point. This is also the needed Weyl-model point deduction. -/
theorem point_of_card_two_le_line (f : SingularMap W) (e : Multiplicative W ≃* Q)
    (P : Subgroup Q) (hP : Nat.card P = 2) (L : ZeroProductLine (ZMod 2))
    (hPL : P ≤ (transportGeometry f.geometry e).line L) :
    ∃ p, (transportGeometry f.geometry e).point p = P ∧ pointOnLine p L := by
  let : Finite P := Nat.finite_of_card_ne_zero (by omega)
  have hbot : P ≠ ⊥ := by
    intro h
    rw [h, Subgroup.card_bot] at hP
    omega
  obtain ⟨a,ha,ha1⟩ := (Subgroup.bot_or_exists_ne_one P).resolve_left hbot
  obtain ⟨v,hv,hev⟩ := hPL ha
  change e v = a at hev
  change Multiplicative.toAdd v ∈ f.line L at hv
  obtain ⟨x,hx,hfx⟩ := hv
  have hx0 : x.val ≠ 0 := by
    intro hz
    have : x = 0 := Subtype.ext hz
    rw [this,map_zero] at hfx
    have hv1 : v = 1 := by simpa using hfx.symm
    rw [hv1,map_one] at hev
    exact ha1 hev.symm
  have hxn := (line_singular L x.val hx).2
  let p := singularPointMk (ZMod 2) x.val hx0 x.property hxn
  have hp : f.point p = (ZMod 2) ∙ f.linear x := f.point_mk x hx0 hxn
  have heq : (transportGeometry f.geometry e).point p = P := by
    apply Subgroup.eq_of_le_of_card_ge
    · change (f.point p).toAddSubgroup.toSubgroup.map e.toMonoidHom ≤ P
      rw [hp]
      apply span_map_le e P (f.linear x)
      have hf : Multiplicative.ofAdd (f.linear x) = v := congrArg Multiplicative.ofAdd hfx
      rw [hf,hev]
      exact ha
    · rw [(transportGeometry f.geometry e).point_card,hP]
  exact ⟨p,heq, ((transportGeometry f.geometry e).incidence p L).mpr (heq ▸ hPL)⟩

/-- Clause (2), then clause (3), for the literal natural quotient. The only
point input is its earlier local order, not marked singularity. -/
theorem natural_source_point_and_pencil (U V₁ V₂ : Subgroup Q)
    [(V₁.subgroupOf U).Normal]
    (e : Multiplicative (Space (ZMod 2)) ≃* U ⧸ V₁.subgroupOf U)
    (hcard : Nat.card ((V₂.subgroupOf U).map (QuotientGroup.mk' (V₁.subgroupOf U))) = 2) :
    (∃ p, (naturalQuotientGeometry (V₁.subgroupOf U) e).point p =
      (V₂.subgroupOf U).map (QuotientGroup.mk' (V₁.subgroupOf U))) ∧
    Nat.card (quotientPencil (naturalQuotientGeometry (V₁.subgroupOf U) e)
      ((V₂.subgroupOf U).map (QuotientGroup.mk' (V₁.subgroupOf U)))) = 3 ∧
    Nat.card (quotientPencilSpan (naturalQuotientGeometry (V₁.subgroupOf U) e)
      ((V₂.subgroupOf U).map (QuotientGroup.mk' (V₁.subgroupOf U)))) = 8 := by
  obtain ⟨p,hp⟩ := natural_point_of_card_two e _ hcard
  exact ⟨⟨p,hp⟩,natural_source_pencil U V₁ V₂ e p hp.symm⟩

/-- The Weyl point and pencil follow from the marked line and `V₂ ≤ V`.
The line marking itself is a separate deduction from the local actors. -/
theorem weyl_source_point_and_pencil (U V₁ V₂ V : Subgroup Q)
    [(V₁.subgroupOf U).Normal]
    (e : Multiplicative (TraceZero (ZMod 2)) ≃* U ⧸ V₁.subgroupOf U)
    (hcard : Nat.card ((V₂.subgroupOf U).map (QuotientGroup.mk' (V₁.subgroupOf U))) = 2)
    (hV₂ : V₂ ≤ V) (L : ZeroProductLine (ZMod 2))
    (hV : (V.subgroupOf U).map (QuotientGroup.mk' (V₁.subgroupOf U)) =
      (weylQuotientGeometry (V₁.subgroupOf U) e).line L) :
    (∃ p, (weylQuotientGeometry (V₁.subgroupOf U) e).point p =
      (V₂.subgroupOf U).map (QuotientGroup.mk' (V₁.subgroupOf U)) ∧ pointOnLine p L) ∧
    Nat.card (quotientPencil (weylQuotientGeometry (V₁.subgroupOf U) e)
      ((V₂.subgroupOf U).map (QuotientGroup.mk' (V₁.subgroupOf U)))) = 3 ∧
    Nat.card (quotientPencilSpan (weylQuotientGeometry (V₁.subgroupOf U) e)
      ((V₂.subgroupOf U).map (QuotientGroup.mk' (V₁.subgroupOf U)))) = 8 := by
  have hle : (V₂.subgroupOf U).map (QuotientGroup.mk' (V₁.subgroupOf U)) ≤
      (transportGeometry weylMap.geometry e).line L := by
    change _ ≤ (weylQuotientGeometry (V₁.subgroupOf U) e).line L
    rw [← hV]
    exact Subgroup.map_mono (Subgroup.comap_mono hV₂)
  obtain ⟨p,hp,hpL⟩ := point_of_card_two_le_line weylMap e _ hcard L hle
  exact ⟨⟨p,hp,hpL⟩,weyl_source_pencil U V₁ V₂ e p hp.symm⟩
end CFSG.Quasithin.Chapter14.Section07.G2Exclusion.MarkedGeometry.MarkedPencil.SourceActions
