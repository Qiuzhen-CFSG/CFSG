module

public import CFSG.Quasithin.Chapter14.Section07.G2Exclusion.MarkedGeometry.LocalParabolics.SpanSourceActions.ResidualSeed
public import CFSG.Quasithin.Chapter14.Section07.G2Exclusion.MarkedGeometry.LocalParabolics.SpanSaturation
public import Theory.GroupTheory.PPerfectHom
public import Mathlib.LinearAlgebra.Isomorphisms

/-!
# The full quotient block in 14.7.56

A group whose two-core quotient is S₃ has no image of order three:
a homomorphism to C₃ kills its two-core, and S₃ is generated by involutions.
Consequently an image in GL₂(2) which is not a two-group is the whole GL₂(2).

Apply this to YT on W/V₂. If that image were a two-group, then the
Y-image on W would be a two-group as well: Y fixes V₂ and the joint
block kernel is a two-group. Since Y is the actual two-residual, its image
would be trivial, contradicting the independently proved nontrivial
image two-core. The conclusion concerns the literal quotient block map.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), 14.7.55(6)
and 14.7.56(2), printed p.1066. No arbitrary S₃-family tag is used.
-/

@[expose] public noncomputable section
namespace CFSG.Quasithin.Chapter14.Section07.G2Exclusion.MarkedGeometry.LocalParabolics.SpanSourceActions

open Subgroup
open BinaryLinear BinaryLinear.FourParabolicRadical BinaryLinear.SmallParabolicLevi
open CFSG.Quasithin.Chapter14.Section07.G2Exclusion.MarkedGeometry
open CFSG.Quasithin.Chapter14.Section07.G2Exclusion.MarkedGeometry.LocalParabolics
open SpanSaturation
private theorem symmetric_three_no_cubic_quotient {A : Type*} [Group A] [Finite A]
    (hA : Nat.card A = 3) (f : Equiv.Perm (Fin 3) →* A) : f = 1 := by
  have hinv (g : Equiv.Perm (Fin 3)) (hg : g ^ 2 = 1) : f g = 1 := by
    apply orderOf_eq_one_iff.mp
    apply Nat.eq_one_of_dvd_coprimes (by decide : Nat.Coprime 2 3)
    · exact orderOf_dvd_of_pow_eq_one (by rw [← map_pow,hg,map_one])
    · simpa only [hA] using orderOf_dvd_natCard (f g)
  have hfactors : ∀ g : Equiv.Perm (Fin 3), ∃ a b : Equiv.Perm (Fin 3),
      a ^ 2 = 1 ∧ b ^ 2 = 1 ∧ a * b = g := by decide +kernel
  ext g
  obtain ⟨a,b,ha,hb,rfl⟩ := hfactors g
  rw [map_mul,hinv a ha,hinv b hb,mul_one]
  rfl

private theorem symmetric_three_image_full {B : Type*} [Group B] [Finite B]
    (e : (B ⧸ pCore 2 B) ≃* Equiv.Perm (Fin 3))
    (f : B →* Equiv.Perm (Fin 3)) (hnot : ¬ IsPGroup 2 f.range) :
    Function.Surjective f := by
  have hcard : Nat.card (Equiv.Perm (Fin 3)) = 6 := by
    simp [Nat.card_eq_fintype_card,Fintype.card_perm,Nat.factorial]
  have hd := f.range.card_subgroup_dvd_card
  rw [hcard] at hd
  have hc : Nat.card f.range = 1 ∨ Nat.card f.range = 2 ∨ Nat.card f.range = 3 ∨
      Nat.card f.range = 6 := by
    have hl := Nat.le_of_dvd (by decide : 0 < 6) hd
    have hp := Nat.card_pos (α := f.range)
    interval_cases h : Nat.card f.range <;> norm_num at *
  rcases hc with h1 | h2 | h3 | h6
  · exact (hnot (IsPGroup.of_card (n := 0) (by simpa using h1))).elim
  · exact (hnot (IsPGroup.of_card (n := 1) (by simpa using h2))).elim
  · have hp3 : IsPGroup 3 f.range := IsPGroup.of_card (n := 1) (by simpa using h3)
    have hz : (pCore 2 B).map f.rangeRestrict = ⊥ := by
      have hdj := (pCore_isPGroup (p := 2) (G := B)).map f.rangeRestrict |>.disjoint_of_coprime
        (hp3.to_subgroup ⊤) (by decide : Nat.Coprime 2 3)
      exact disjoint_top.mp hdj
    have hk := (map_eq_bot_iff (pCore 2 B)).mp hz
    let q := QuotientGroup.lift (pCore 2 B) f.rangeRestrict hk
    have htriv := symmetric_three_no_cubic_quotient h3 (q.comp e.symm.toMonoidHom)
    have hfall : f.rangeRestrict = 1 := by
      apply MonoidHom.ext
      intro b
      have h := DFunLike.congr_fun htriv (e (QuotientGroup.mk' (pCore 2 B) b))
      change q (QuotientGroup.mk' (pCore 2 B) b) = 1
      simpa only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
        e.symm_apply_apply, MonoidHom.one_apply, QuotientGroup.lift_mk] using h
    have hs : Subsingleton f.range := by
      refine ⟨fun a b => ?_⟩
      obtain ⟨x,rfl⟩ := f.rangeRestrict_surjective a
      obtain ⟨y,rfl⟩ := f.rangeRestrict_surjective b
      rw [hfall]
      rfl
    let := hs
    have hone : Nat.card f.range = 1 := Nat.card_unique
    omega
  · exact MonoidHom.range_eq_top.mp (eq_top_of_card_eq f.range (h6.trans hcard.symm))

private theorem twoPerfect_parabolic_trivial {Y : Type*} [Group Y]
    (hp : IsPPerfect 2 Y) (f : Y →* parabolic plane)
    (hfirst : (subspaceAction plane).comp f = 1)
    (hsecond : IsPGroup 2 ((quotientAction plane).comp f).range) : f = 1 := by
  let R := ((quotientAction plane).comp f).range
  let K : Subgroup (BinaryLinear.GL plane × BinaryLinear.GL (BSpace ⧸ plane)) :=
    (⊥ : Subgroup (BinaryLinear.GL plane)).prod R
  have hK : IsPGroup 2 K := by
    intro x
    obtain ⟨n,hn⟩ := hsecond ⟨x.val.2,x.property.2⟩
    refine ⟨n,Subtype.ext (Prod.ext ?_ (congrArg Subtype.val hn))⟩
    change x.val.1 ^ 2 ^ n = 1
    rw [show x.val.1 = 1 from x.property.1,one_pow]
  have hk : IsPGroup 2 (blockAction plane).ker := by
    rw [ker_blockAction_eq_twoCore]
    exact pCore_isPGroup
  have hpre := hK.comap_of_ker_isPGroup (blockAction plane) hk
  have hle : f.range ≤ K.comap (blockAction plane) := by
    rintro _ ⟨y,rfl⟩
    exact ⟨DFunLike.congr_fun hfirst y,⟨y,rfl⟩⟩
  have ht := hp.hom_eq_one_of_isPGroup (hpre.to_le hle) f.rangeRestrict
  apply MonoidHom.ext
  intro y
  change (f.rangeRestrict y : parabolic plane) = 1
  exact congrArg Subtype.val (DFunLike.congr_fun ht y)

private def quotientPlaneCoordinates : (BSpace ⧸ plane) ≃ₗ[ZMod 2] Vec :=
  LinearMap.quotKerEquivOfSurjective (LinearMap.snd (ZMod 2) Vec Vec) LinearMap.snd_surjective

private def quotientGLThree : BinaryLinear.GL (BSpace ⧸ plane) ≃* Equiv.Perm (Fin 3) :=
  (linearGroupCongr quotientPlaneCoordinates).trans linearTwoEquivSymmetricThree

private theorem quotient_block_full {B : Type*} [Group B] [Finite B]
    (e : (B ⧸ pCore 2 B) ≃* Equiv.Perm (Fin 3))
    (f : B →* BinaryLinear.GL (BSpace ⧸ plane)) (hnot : ¬ IsPGroup 2 f.range) :
    Function.Surjective f := by
  have hn : ¬ IsPGroup 2 (quotientGLThree.toMonoidHom.comp f).range := by
    intro hp
    have he : f.range.map quotientGLThree.toMonoidHom =
        (quotientGLThree.toMonoidHom.comp f).range := (MonoidHom.range_comp _ _).symm
    apply hnot
    exact (he.symm ▸ hp).of_equiv
      (f.range.equivMapOfInjective quotientGLThree.toMonoidHom quotientGLThree.injective).symm
  have hs := symmetric_three_image_full e (quotientGLThree.toMonoidHom.comp f) hn
  intro x
  obtain ⟨b,hb⟩ := hs (quotientGLThree x)
  exact ⟨b,quotientGLThree.injective hb⟩

/-- The actual YT two-core quotient and residual seed give the full action
on W/V₂, expressed by the specified coordinate quotient block. -/
theorem source_quotient_block_surjective {G : Type*} [Group G] [Finite G]
    (H V D Y T : Subgroup G) (hY : Y = localResidual H D)
    (hD : D ≤ V)
    (hspan : normalizer (D : Set G) ≤ normalizer (generatedLineFamily V Y : Set G))
    (hYV : Y ≤ normalizer (D : Set G)) (hTV : T ≤ normalizer (D : Set G))
    (E : generatedLineFamily V Y ≃* Multiplicative BSpace)
    (hE : (D.subgroupOf (generatedLineFamily V Y)).map E.toMonoidHom =
      plane.toAddSubgroup.toSubgroup)
    (e : ((Y ⊔ T : Subgroup G) ⧸ pCore 2 (Y ⊔ T : Subgroup G)) ≃* Equiv.Perm (Fin 3))
    (hseed : (ambientAction Y (generatedLineFamily V Y)
      (hYV.trans hspan)).range.pCoreIn 2 ≠ ⊥) :
    Function.Surjective ((quotientAction plane).comp
      (spanCoordinateAction V D Y hD hspan E hE)) := by
  let c := spanCoordinateAction V D Y hD hspan E hE
  let B : Subgroup G := Y ⊔ T
  have hBN : B ≤ normalizer (D : Set G) := sup_le hYV hTV
  let fB := c.comp (inclusion hBN)
  let fY := c.comp (inclusion hYV)
  have hp : IsPPerfect 2 Y := by
    rw [hY,localResidual]
    exact isPPerfect_embedded_pResidual 2 _
  have hYC : Y ≤ centralizer (D : Set G) := by
    rw [hY]
    exact localResidual_le_centralizer H D
  have hfirst : (subspaceAction plane).comp fY = 1 := by
    apply MonoidHom.ext
    intro y
    apply LinearEquiv.ext
    intro d
    apply Subtype.ext
    let W := generatedLineFamily V Y
    let w := E.symm (Multiplicative.ofAdd d.val)
    have hw : (w : G) ∈ D := by
      have hd : E w ∈ plane.toAddSubgroup.toSubgroup := by
        change (E w).toAdd ∈ plane
        simpa only [w,E.apply_symm_apply,toAdd_ofAdd] using d.property
      rw [← hE,mem_map_equiv,E.symm_apply_apply] at hd
      exact hd
    have hfix : ambientAction Y W (hYV.trans hspan) y w = w := by
      apply Subtype.ext
      change (y : G) * (w : G) * (y : G)⁻¹ = w
      rw [← hYC y.property w hw,mul_inv_cancel_right]
    change (E (ambientAction Y W (hYV.trans hspan) y w)).toAdd = d.val
    rw [hfix]
    exact congrArg Multiplicative.toAdd (E.apply_symm_apply _)
  have hnot : ¬ IsPGroup 2 ((quotientAction plane).comp fB).range := by
    intro ht
    have hle : ((quotientAction plane).comp fY).range ≤
        ((quotientAction plane).comp fB).range := by
      rintro _ ⟨y,rfl⟩
      exact ⟨inclusion (show Y ≤ B from le_sup_left) y,rfl⟩
    have he := twoPerfect_parabolic_trivial hp fY hfirst (ht.to_le hle)
    have hρ : ambientAction Y (generatedLineFamily V Y) (hYV.trans hspan) = 1 := by
      apply MonoidHom.ext
      intro y
      exact (autCoordinates E).injective (by
        have hz := DFunLike.congr_fun he y
        change (spanCoordinateAction V D Y hD hspan E hE) ⟨y, hYV y.property⟩ = 1 at hz
        convert congrArg Subtype.val hz using 1 <;> simp [spanCoordinateAction, ambientAction]
        · rfl)
    apply hseed
    rw [hρ,MonoidHom.range_one]
    apply le_antisymm
    · exact pCoreIn_le 2 ⊥
    · exact bot_le
  have hfullB := quotient_block_full e ((quotientAction plane).comp fB) hnot
  intro a
  obtain ⟨b,hb⟩ := hfullB a
  exact ⟨inclusion hBN b,hb⟩

end CFSG.Quasithin.Chapter14.Section07.G2Exclusion.MarkedGeometry.LocalParabolics.SpanSourceActions
