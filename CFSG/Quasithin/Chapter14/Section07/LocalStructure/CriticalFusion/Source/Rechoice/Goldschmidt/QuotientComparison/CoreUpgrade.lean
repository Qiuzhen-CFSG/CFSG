module
public import CFSG.Quasithin.ChapterF.Section06.Elementary.PrimeToThree
public import Theory.GroupTheory.Commutator.PerfectSolvableSupplement
public import Theory.AtlasPort.ExceptionalIsomorphisms.Simplicity
public import Theory.SpecificGroups.PSL3Two.Parabolics.LinearModel
public import Mathlib.GroupTheory.Complement

/-!
# Removing the remaining prime-to-three kernel

A Goldschmidt triple has no nontrivial odd quotient: every homomorphism
from either local group to an odd-order group kills its two-core, and the
remaining S₃ is generated by involutions. When the ambient two-core is
trivial, F.6.11 says that its prime-to-three core has odd order and is solvable.

Suppose both the quotient by that core and an actual subnormal subgroup
K are PSL₃(2). Simplicity makes the quotient map injective on K, and the
equal orders make it surjective. Thus K supplements the solvable core.
Perfect subnormal supplement theory makes K the solvable residual and
hence normal. Its index is odd, so the preceding argument gives K = G
and makes the prime-to-three core trivial.

The actual 14.7.70 consumer is `core_and_marking_of_bangRecognition` in
the parent module. It must supply both recognition outputs; neither is
proved here by a group-family label or an order-only recognition argument.
Source: Aschbacher–Smith, combined manuscript, 1 March 2004,
Lemma 14.7.70, printed p.1075; F.6.1 and F.6.11, pp.304, 306–307.
-/

@[expose] public section
noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.Source.Rechoice.Goldschmidt.QuotientComparison

private theorem symmetricThree_two_factors : ∀ x : Equiv.Perm (Fin 3),
    ∃ a b : Equiv.Perm (Fin 3), a ^ 2 = 1 ∧ b ^ 2 = 1 ∧ x = a * b := by
  decide +kernel

private theorem local_hom_to_odd_trivial
    {A D : Type*} [Group A] [Finite A] [Group D] [Finite D]
    (e : (A ⧸ pCore 2 A) ≃* Equiv.Perm (Fin 3))
    (f : A →* D) (hodd : Odd (Nat.card D)) : ∀ a, f a = 1 := by
  have hp (x : A) (hx : x ∈ pCore 2 A) : f x = 1 := by
    obtain ⟨n, hn⟩ := (isPGroup_iff_pow_pow_eq_one.mp
      (pCore_isPGroup (p := 2) (G := A))) (⟨x, hx⟩ : pCore 2 A)
    have he : f x ^ 2 ^ n = 1 := by
      rw [← map_pow]
      exact congrArg f (congrArg Subtype.val hn) |>.trans (map_one f)
    exact orderOf_eq_one_iff.mp (Nat.eq_one_of_dvd_coprimes
      (hodd.coprime_two_left.pow_left n) (orderOf_dvd_of_pow_eq_one he)
        (orderOf_dvd_natCard (f x)))
  let fbar := QuotientGroup.lift (pCore 2 A) f hp
  let g := fbar.comp e.symm.toMonoidHom
  have hi (a : Equiv.Perm (Fin 3)) (ha : a ^ 2 = 1) : g a = 1 := by
    apply orderOf_eq_one_iff.mp
    exact Nat.eq_one_of_dvd_coprimes hodd.coprime_two_left
      (orderOf_dvd_of_pow_eq_one (by rw [← map_pow, ha, map_one]))
      (orderOf_dvd_natCard (g a))
  have hg : ∀ a, g a = 1 := by
    intro x
    obtain ⟨a, b, ha, hb, rfl⟩ := symmetricThree_two_factors x
    rw [map_mul, hi a ha, hi b hb, one_mul]
  intro a
  have hh := hg (e (QuotientGroup.mk' (pCore 2 A) a))
  change fbar (e.symm (e (QuotientGroup.mk' (pCore 2 A) a))) = 1 at hh
  rw [e.symm_apply_apply] at hh
  exact hh


/-- A Goldschmidt triple admits no nontrivial odd-order quotient. Both
local S₃ quotients, rather than an ambient solvability assumption, are used. -/
theorem normal_eq_top_of_odd_index
    {D : Type*} [Group D] [Finite D] {A B : Subgroup D}
    (h : ChapterF.IsGoldschmidtTriple A B) (N : Subgroup D) [N.Normal]
    (hodd : Odd N.index) : N = ⊤ := by
  let f := QuotientGroup.mk' N
  have ho : Odd (Nat.card (D ⧸ N)) := hodd
  have ha : A ≤ N := by
    intro a ha
    exact (QuotientGroup.eq_one_iff _).mp
      (local_hom_to_odd_trivial h.quotient_left.some (f.comp A.subtype) ho ⟨a, ha⟩)
  have hb : B ≤ N := by
    intro b hb
    exact (QuotientGroup.eq_one_iff _).mp
      (local_hom_to_odd_trivial h.quotient_right.some (f.comp B.subtype) ho ⟨b, hb⟩)
  exact top_le_iff.mp (h.generated ▸ sup_le ha hb)

/-- In a Goldschmidt amalgam the prime-to-three core has odd order. -/
theorem primeToThreeCore_odd_of_twoCore_trivial
    {D : Type*} [Group D] [Finite D] {A B : Subgroup D}
    (h : ChapterF.IsGoldschmidtTriple A B) (hcore : pCore 2 D = ⊥) :
    Odd (Nat.card (pPrimeCore 3 D)) := by
  obtain ⟨S, hS⟩ := h.primeToThreeCore_sylow
  have hb : (S : Subgroup (pPrimeCore 3 D)) = ⊥ := by
    apply map_injective (pPrimeCore 3 D).subtype_injective
    rw [hS, hcore, Subgroup.map_bot]
  have hn := S.not_dvd_index
  rw [hb, index_bot] at hn
  exact Nat.not_even_iff_odd.mp (by simpa only [even_iff_two_dvd] using hn)

/-- A subnormal PSL₃(2) in the two-core-free amalgam, together with the
recognized prime-to-three quotient, removes the remaining prime-to-three
kernel. The two quotients are not identified by an assumed equality. -/
theorem plus_equiv_of_subnormal_and_bang
    {D : Type*} [Group D] [Finite D] {A B : Subgroup D}
    (h : ChapterF.IsGoldschmidtTriple A B) (hcore : pCore 2 D = ⊥)
    (e : (D ⧸ pPrimeCore 3 D) ≃* Matrix.PSL3Two.PSL)
    (K : Subgroup D) (hK : K.IsSubnormal) (eK : K ≃* Matrix.PSL3Two.PSL) :
    pPrimeCore 3 D = ⊥ ∧ Nonempty (D ≃* Matrix.PSL3Two.PSL) := by
  let : IsSimpleGroup Matrix.PSL3Two.PSL :=
    Atlas.psl_simple_high_rank (F := ZMod 2) 3 (by decide)
  let : Group.IsPerfect Matrix.PSL3Two.PSL := Atlas.psl_perfect (F := ZMod 2) 3 (by decide)
  let : IsSimpleGroup K := eK.isSimpleGroup
  let : Group.IsPerfect K := Group.IsPerfect.ofSurjective (f := eK.symm.toMonoidHom) eK.symm.surjective
  let R := pPrimeCore 3 D
  let q := QuotientGroup.mk' R
  let f := q.comp K.subtype
  have hcK : Nat.card K = 168 := (Nat.card_congr eK.toEquiv).trans Matrix.PSL3Two.card_PSL
  have hf : Function.Injective f := by
    apply (MonoidHom.ker_eq_bot_iff _).mp
    rcases (inferInstance : f.ker.Normal).eq_bot_or_eq_top with hbot | htop
    · exact hbot
    · have hKR : K ≤ R := by
        intro x hx
        exact (QuotientGroup.eq_one_iff _).mp
          (MonoidHom.mem_ker.mp (show (⟨x, hx⟩ : K) ∈ f.ker by rw [htop]; trivial))
      have hd := card_dvd_of_le hKR
      rw [hcK] at hd
      have hthree : 3 ∣ Nat.card R := (by decide : 3 ∣ 168).trans hd
      exact False.elim (Nat.prime_three.ne_one
        ((pPrimeCore_coprime_card (p := 3) (G := D)).eq_one_of_dvd hthree))
  have hfonto : Function.Surjective f :=
    (hf.bijective_of_nat_card_le (by
      rw [hcK, Nat.card_congr e.toEquiv, Matrix.PSL3Two.card_PSL])).surjective
  have hsup : K ⊔ R = ⊤ := by
    have hm : K.map q = ⊤ := by
      simpa only [f, MonoidHom.range_comp, range_subtype] using
        MonoidHom.range_eq_top.mpr hfonto
    have hh := congrArg (Subgroup.comap q) hm
    simpa only [comap_map_eq, q, QuotientGroup.ker_mk', comap_top] using hh
  let : Group.IsSolvable R := h.primeToThreeCore_solvable
  have hres := hK.eq_solvableResidual_of_sup_eq_top R hsup
  let : K.Normal := by rw [hres]; infer_instance
  have hdis : Disjoint K R := by
    rw [disjoint_iff]
    apply le_bot_iff.mp
    intro x hx
    have he : f (⟨x, hx.1⟩ : K) = f 1 := by
      rw [map_one]
      exact (QuotientGroup.eq_one_iff _).mpr hx.2
    exact congrArg Subtype.val (hf he)
  have hcomp : K.IsComplement' R :=
    isComplement'_of_disjoint_and_mul_eq_univ hdis (by rw [← mul_normal, hsup]; rfl)
  have hindex : Odd K.index := by
    rw [hcomp.symm.index_eq_card]
    exact primeToThreeCore_odd_of_twoCore_trivial h hcore
  have ht : K = ⊤ := normal_eq_top_of_odd_index h K hindex
  have hR : R = ⊥ := by simpa only [ht, top_inf_eq] using hdis.eq_bot
  exact ⟨hR, ⟨((MulEquiv.subgroupCongr ht).trans Subgroup.topEquiv).symm.trans eK⟩⟩

end CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.Source.Rechoice.Goldschmidt.QuotientComparison
