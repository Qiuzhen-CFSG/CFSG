module

public import CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.Source.Rechoice.Goldschmidt.QuotientComparison.Alternatives.Preparation
public import Theory.AtlasPort.ExceptionalIsomorphisms.Simplicity
public import Mathlib.GroupTheory.Complement
public import Mathlib.GroupTheory.SpecificGroups.Alternating.Simple

/-!
# The literal row-(2) quotient transport

The canonical map from I/O₂(I) to I/O₃′(I) has kernel O₃′(I/O₂(I)).
F.6.11 makes its order prime to both two and three. An actual S₃ in the
plus quotient therefore embeds in the bang quotient, preserving subnormality.
The two simple witnesses also embed, since each has order divisible by three;
the row-(2) orders 36 and 108 exclude both of them.

If the bang image of a subnormal S₃ is normal, normality lifts to the original
plus quotient. In its full preimage, the S₃ is a complement to the odd kernel
and is generated by involutions, so it is the prime-to-two residual. This
makes it characteristic in that normal preimage. Normality of the finite
model image remains a separate mathematical obligation.

Source: Aschbacher–Smith, combined manuscript, 1 March 2004,
Lemma 14.7.70, printed pp.1074–1075; F.6.11, printed pp.306–307.
-/

@[expose] public section
open Subgroup Theory.GroupTheory
noncomputable section
namespace CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.Source.Rechoice.Goldschmidt.QuotientComparison.Alternatives.RowTwo

private theorem symmetricThree_two_factors : ∀ x : Equiv.Perm (Fin 3),
    ∃ a b : Equiv.Perm (Fin 3), a ^ 2 = 1 ∧ b ^ 2 = 1 ∧ x = a * b := by
  decide +kernel

private theorem symmetricThree_primeToResidual {D : Type*} [Group D]
    (e : D ≃* Equiv.Perm (Fin 3)) : primeToResidual 2 D = ⊤ := by
  apply top_unique
  intro x _
  obtain ⟨a, b, ha, hb, he⟩ := symmetricThree_two_factors (e x)
  have hpow (a : Equiv.Perm (Fin 3)) (ha : a ^ 2 = 1) :
      e.symm a ∈ primeToResidual 2 D := by
    apply mem_primeToResidual_of_pow (n := 1)
    simpa only [pow_one, map_pow, map_one] using congrArg e.symm ha
  have hx := (primeToResidual 2 D).mul_mem (hpow a ha) (hpow b hb)
  simpa only [← map_mul, ← he, e.symm_apply_apply] using hx

private theorem injective_on_coprime_subgroup
    {D B : Type*} [Group D] [Finite D] [Group B]
    (f : D →* B) (K : Subgroup D)
    (hc : Nat.Coprime (Nat.card K) (Nat.card f.ker)) :
    Function.Injective (f.comp K.subtype) := by
  apply (MonoidHom.ker_eq_bot_iff _).mp
  apply card_eq_one.mp
  apply Nat.eq_one_of_dvd_coprimes hc
  · exact (f.comp K.subtype).ker.card_subgroup_dvd_card
  · exact f.ker.card_comap_dvd_of_injective K.subtype K.subtype_injective

private theorem injective_on_simple_subgroup
    {D B : Type*} [Group D] [Finite D] [Group B]
    (f : D →* B) (hker : Nat.Coprime 3 (Nat.card f.ker))
    (K : Subgroup D) [IsSimpleGroup K] (hthree : 3 ∣ Nat.card K) :
    Function.Injective (f.comp K.subtype) := by
  apply (MonoidHom.ker_eq_bot_iff _).mp
  rcases (inferInstance : (f.comp K.subtype).ker.Normal).eq_bot_or_eq_top with hz | ht
  · exact hz
  · have hd := f.ker.card_comap_dvd_of_injective K.subtype K.subtype_injective
    change Nat.card (f.comp K.subtype).ker ∣ Nat.card f.ker at hd
    rw [ht, card_top] at hd
    exact (Nat.prime_three.ne_one (hker.eq_one_of_dvd (hthree.trans hd))).elim

private def equivMapOfInjectiveOn
    {D B : Type*} [Group D] [Group B] (f : D →* B) (K : Subgroup D)
    (hi : Function.Injective (f.comp K.subtype)) : K ≃* K.map f :=
  MulEquiv.ofBijective (f.subgroupMap K) ⟨fun _ _ he => hi (congrArg Subtype.val he),
    f.subgroupMap_surjective K⟩

private theorem normal_lift
    {D B : Type*} [Group D] [Finite D] [Group B]
    (f : D →* B) (hodd : Nat.Coprime 2 (Nat.card f.ker))
    (K : Subgroup D) (hK : K.IsSubnormal) (e : K ≃* Equiv.Perm (Fin 3))
    (hi : Function.Injective (f.comp K.subtype)) [(K.map f).Normal] : K.Normal := by
  let P := (K.map f).comap f
  have hP : P = K ⊔ f.ker := comap_map_eq f K
  have hKP : K ≤ P := hP ▸ le_sup_left
  have hRP : f.ker ≤ P := hP ▸ le_sup_right
  let A := K.subgroupOf P
  let R := f.ker.subgroupOf P
  have hdis : Disjoint A R := by
    apply disjoint_iff.mpr
    apply le_bot_iff.mp
    intro x hx
    have he : f (⟨x.val, hx.1⟩ : K) = f 1 := by
      rw [map_one]
      exact hx.2
    change x = 1
    apply Subtype.ext
    exact congrArg (fun z : K => (z : D)) (@hi ⟨x.val, hx.1⟩ 1 he)
  have hs : A ⊔ R = ⊤ := by
    rw [← subgroupOf_sup hKP hRP, ← hP, subgroupOf_self]
  have hcomp : A.IsComplement' R :=
    isComplement'_of_disjoint_and_mul_eq_univ hdis (by rw [← mul_normal, hs]; rfl)
  have hc : Nat.Coprime 2 A.index := by
    rw [hcomp.symm.index_eq_card,
      Nat.card_congr (subgroupOfEquivOfLe hRP).toEquiv]
    exact hodd
  have he : (primeToResidual 2 P).map P.subtype = K := by
    rw [primeToResidual_eq_of_subnormal_coprime_index 2 A hK.subgroupOf
      (symmetricThree_primeToResidual ((subgroupOfEquivOfLe hKP).trans e)) hc,
      map_subgroupOf_eq_of_le hKP]
  rw [← he]
  infer_instance

open Representation Chapter12.Section08
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  {F : InvariantFlag T V 3} {W : Type u} [AddCommGroup W] [Module (ZMod 2) W]
  (d : Data T L V F W) (c : CriticalPath (L := L) F)

/-- The canonical comparison is a homomorphism, not an identification of quotients. -/
def comparisonMap : ((I c) ⧸ pCore 2 (I c)) →* ((I c) ⧸ pPrimeCore 3 (I c)) :=
  QuotientGroup.map _ _ (MonoidHom.id _)
    (by simpa only [comap_id] using (ChapterF.twoCore_le_primeToThreeCore (G := I c)))

@[simp] theorem comparisonMap_plus (x : I c) :
    comparisonMap c (plusMap c x) = bangMap c x := rfl

theorem comparisonMap_surjective : Function.Surjective (comparisonMap c) := by
  intro y
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (pPrimeCore 3 (I c)) y
  exact ⟨plusMap c x, rfl⟩

theorem comparisonMap_kernel :
    (comparisonMap c).ker = pPrimeCore 3 ((I c) ⧸ pCore 2 (I c)) := by
  rw [comparisonMap, QuotientGroup.ker_map, comap_id,
    ChapterF.primeToThreeCore_map_quotientTwoCore]

theorem comparisonMap_kernel_coprime (k : CoreFacts c) :
    Nat.Coprime 2 (Nat.card (comparisonMap c).ker) ∧
      Nat.Coprime 3 (Nat.card (comparisonMap c).ker) := by
  rw [comparisonMap_kernel]
  refine ⟨?_, pPrimeCore_coprime_card⟩
  obtain ⟨S, hS⟩ := k.triple.quotient_twoCore.primeToThreeCore_sylow
  have hb : (S : Subgroup (pPrimeCore 3 ((I c) ⧸ pCore 2 (I c)))) = ⊥ := by
    apply map_injective (pPrimeCore 3 ((I c) ⧸ pCore 2 (I c))).subtype_injective
    rw [hS, k.triple.quotient_twoCore_eq_bot, Subgroup.map_bot]
  have hn := S.not_dvd_index
  rw [hb, index_bot] at hn
  exact Nat.prime_two.coprime_iff_not_dvd.mpr hn

/-- The original S₃ witness embeds through the comparison map. -/
theorem comparisonMap_injective_symmetricThree (k : CoreFacts c)
    (K : Subgroup ((I c) ⧸ pCore 2 (I c))) (e : K ≃* Equiv.Perm (Fin 3)) :
    Function.Injective ((comparisonMap c).comp K.subtype) := by
  apply injective_on_coprime_subgroup
  have hc : Nat.card K = 6 := by
    rw [Nat.card_congr e.toEquiv]
    simp [Nat.card_eq_fintype_card, Fintype.card_perm, Nat.factorial]
  rw [hc]
  exact Nat.Coprime.mul_left (comparisonMap_kernel_coprime c k).1
    (comparisonMap_kernel_coprime c k).2

/-- Subnormality plus normality of the actual bang image gives normality
in the original plus quotient. The odd kernel is removed by the prime-to-two residual. -/
theorem comparisonMap_normal_lift (k : CoreFacts c)
    (K : Subgroup ((I c) ⧸ pCore 2 (I c))) (hK : K.IsSubnormal)
    (e : K ≃* Equiv.Perm (Fin 3)) [(K.map (comparisonMap c)).Normal] : K.Normal :=
  normal_lift (comparisonMap c) (comparisonMap_kernel_coprime c k).1 K hK e
    (comparisonMap_injective_symmetricThree c k K e)

/-- The literal image of the S₃ witness is again a subnormal S₃. -/
theorem comparisonMap_small_image (k : CoreFacts c)
    (K : Subgroup ((I c) ⧸ pCore 2 (I c))) (hK : K.IsSubnormal)
    (e : K ≃* Equiv.Perm (Fin 3)) :
    (K.map (comparisonMap c)).IsSubnormal ∧
      Nonempty ((K.map (comparisonMap c)) ≃* Equiv.Perm (Fin 3)) :=
  ⟨hK.map (comparisonMap_surjective c),
    ⟨(equivMapOfInjectiveOn (comparisonMap c) K
      (comparisonMap_injective_symmetricThree c k K e)).symm.trans e⟩⟩

/-- Row (2) has one of its two literal orders. -/
theorem rowTwo_card {D : Type*} [Group D] [Finite D] (row : RowTwoModel D) :
    Nat.card D = 36 ∨ Nat.card D = 108 := by
  unfold RowTwoModel at row
  rcases row with hp | hn
  · obtain ⟨e⟩ := hp
    left
    rw [Nat.card_congr e.toEquiv]
    simp [Nat.card_eq_fintype_card, Fintype.card_perm, Nat.factorial]
  · obtain ⟨N, hN, _, hcard, _, ⟨e⟩⟩ := hn
    let := hN
    right
    rw [card_eq_card_quotient_mul_card_subgroup N, hcard, Nat.card_congr e.toEquiv]
    norm_num [Chapter15.Section03.AbelianAmalgam.GoldschmidtCore.Centrality.Semilinear.Recognition.FSource.E4,
      Chapter15.Section03.AbelianAmalgam.GoldschmidtCore.Centrality.Semilinear.Recognition.FSource.C]

/-- The two simple alternatives cannot occur over either row-(2) order.
The kernel has order prime to three, so simplicity makes their maps injective. -/
theorem rowTwo_small_symmetricThree (k : CoreFacts c) (small : SmallSubnormal c)
    (row : RowTwoModel ((I c) ⧸ pPrimeCore 3 (I c))) :
    ∃ K : Subgroup ((I c) ⧸ pCore 2 (I c)), K.IsSubnormal ∧
      Nonempty (K ≃* Equiv.Perm (Fin 3)) := by
  obtain ⟨K, hK, he | he | he⟩ := small
  · exact ⟨K, hK, he⟩
  · obtain ⟨e⟩ := he
    let : IsSimpleGroup Matrix.PSL3Two.PSL := Atlas.psl_simple_high_rank (F := ZMod 2) 3 (by decide)
    let : IsSimpleGroup Matrix.PSL3Two.SL := Matrix.PSL3Two.equiv.isSimpleGroup
    let : IsSimpleGroup K := e.isSimpleGroup
    have hc : Nat.card K = 168 := (Nat.card_congr e.toEquiv).trans Matrix.PSL3Two.card_SL
    have hi := injective_on_simple_subgroup (comparisonMap c)
      (comparisonMap_kernel_coprime c k).2 K (by rw [hc]; decide)
    have hd := card_subgroup_dvd_card (K.map (comparisonMap c))
    rw [← Nat.card_congr (equivMapOfInjectiveOn (comparisonMap c) K hi).toEquiv] at hd
    rw [hc] at hd
    rcases rowTwo_card row with ho | ho <;> rw [ho] at hd <;> norm_num at hd
  · obtain ⟨e⟩ := he
    let : IsSimpleGroup (alternatingGroup (Fin 5)) := alternatingGroup.isSimpleGroup (by simp)
    let : IsSimpleGroup K := e.isSimpleGroup
    have hc : Nat.card K = 60 := by
      rw [Nat.card_congr e.toEquiv, nat_card_alternatingGroup]
      norm_num [Nat.factorial]
    have hi := injective_on_simple_subgroup (comparisonMap c)
      (comparisonMap_kernel_coprime c k).2 K (by rw [hc]; decide)
    have hd := card_subgroup_dvd_card (K.map (comparisonMap c))
    rw [← Nat.card_congr (equivMapOfInjectiveOn (comparisonMap c) K hi).toEquiv] at hd
    rw [hc] at hd
    rcases rowTwo_card row with ho | ho <;> rw [ho] at hd <;> norm_num at hd

end CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.Source.Rechoice.Goldschmidt.QuotientComparison.Alternatives.RowTwo
