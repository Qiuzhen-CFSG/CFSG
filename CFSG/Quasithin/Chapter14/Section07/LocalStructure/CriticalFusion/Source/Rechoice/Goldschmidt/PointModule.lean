module

public import CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.Source.Rechoice.Goldschmidt
public import Theory.Representation.PSL3Two.ParabolicCyclic.PointRecognition
public import Theory.ElementaryAbelian.GeneratorRank
public import Theory.GroupTheory.PrimeRankFixedJoin

/-!
# The actual point-generated module in the terminal branch of 14.7.70

Conjugation on the literal subgroup V_I descends through I → I/O₂(I),
since the core centralizes V_I. The marked quotient then acts as SL₃(2)
on Additive V_I. The source element z is a nonzero point-parabolic fixed
vector. Linear orbit spans coincide with ambient conjugate spans: its full
orbit generates V_I, and its line-parabolic orbit is exactly E, of rank two.
Thus H.5.5 supplies equivariant natural coordinates on the original subgroup
and proves that its prime rank is three.

The final coordinate construction and rank theorem take only Source.Data,
CriticalPath, Geometry, CoreFacts and ParabolicMarking. The elementary instance
used by the linear helpers is discharged from CoreFacts.elementary. The
independent constructions of CoreFacts and ParabolicMarking remain with the
Goldschmidt assembly owner; the rank-four contradiction is a separate step.

Source: Aschbacher–Smith, combined manuscript, 1 March 2004,
Lemma 14.7.70, printed p.1075 (PDF p.1092), applying H.5.5,
printed p.386 (PDF p.397).
-/

@[expose] public section

noncomputable section
open Subgroup Representation
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.Source.Rechoice.Goldschmidt.PointModule
open Chapter12.Section08 BinaryLinearThree.ParabolicCyclic
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  {F : InvariantFlag T V 3} {W : Type u} [AddCommGroup W] [Module (ZMod 2) W]
  (d : Data T L V F W) (c : CriticalPath (L := L) F)

/-- Conjugation on the literal subgroup generated by the source point. -/
def conjugation : I c →* MulAut (VI c) :=
  (VI c).normalizerMonoidHom.comp (inclusion (le_normalizer_conjugateSpanBy _ _))

variable (core : CoreFacts c) (mark : ParabolicMarking c)

include d core in
private theorem core_le_ker : pCore 2 (I c) ≤ (conjugation c).ker := by
  intro a ha
  apply MulEquiv.ext
  intro v
  apply Subtype.ext
  change (a : G) * (v : G) * (a : G)⁻¹ = (v : G)
  have hc := mem_centralizer_iff.mp (core.centralizes ha)
    (⟨v, VI_le_I d c v.property⟩ : I c) v.property
  have he := congrArg Subtype.val hc
  change (v : G) * (a : G) = (a : G) * (v : G) at he
  rw [← he, mul_inv_cancel_right]

/-- The core acts trivially, so conjugation descends through the literal plus map. -/
def quotientAction : ((I c) ⧸ pCore 2 (I c)) →* MulAut (VI c) :=
  QuotientGroup.lift _ (conjugation c) (by exact core_le_ker d c core)

/-- The marked quotient projection to the actual binary matrix group. -/
def markedMap : I c →* Matrix.PSL3Two.SL := mark.equiv.toMonoidHom.comp (plusMap c)

/-- The source nonidentity element, viewed in the actual elementary subgroup. -/
def seed : Additive (VI c) := Additive.ofMul ⟨d.z, le_conjugateSpanBy _ _ (by
  rw [d.point]
  exact mem_zpowers d.z)⟩

theorem seed_ne_zero : seed d c ≠ 0 := by
  intro he
  exact d.z_ne_one (congrArg (fun v : Additive (VI c) => (v.toMul : G)) he)

/-- Image of an ambient subgroup in the marked quotient. -/
def markedImage (A : Subgroup G) : Subgroup Matrix.PSL3Two.SL :=
  (A.subgroupOf (I c)).map (markedMap c mark)

omit [Finite G] in
theorem markedImage_eq (A : Subgroup G) :
    markedImage c mark A = (plus c A).map mark.equiv.toMonoidHom := by
  rw [markedImage, markedMap, plus, map_map]

omit [Finite G] in
/-- Surjectivity of the literal marked quotient map. -/
theorem markedMap_surjective : Function.Surjective (markedMap c mark) :=
  mark.equiv.surjective.comp (QuotientGroup.mk'_surjective _)

private theorem rank_eq_finrank (A : Type*) [Group A] [Finite A]
    [IsElementaryAbelian 2 A] : primeRank 2 A = Module.finrank (ZMod 2) (Additive A) := by
  have hc : Nat.card A = 2 ^ Module.finrank (ZMod 2) (Additive A) :=
    (Module.natCard_eq_pow_finrank (K := ZMod 2) (V := Additive A)).trans
      (by rw [Nat.card_zmod])
  apply le_antisymm
  · exact IsElementaryAbelian.primeRank_le_of_card_le A hc.le
  · let : IsElementaryAbelian 2 (⊤ : Subgroup A) := {
      toIsMulCommutative := inferInstance
      exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr (fun x => by
        apply Subtype.ext
        exact Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
          (IsElementaryAbelian.exponent_dvd_p 2 A) x.val) }
    exact IsElementaryAbelian.primeRank_ge_of_card (⊤ : Subgroup A)
      ((Nat.card_congr Subgroup.topEquiv.toEquiv).trans hc)

section Binary
variable [IsElementaryAbelian 2 (VI c)]

/-- The marked binary representation still has the original VI as its carrier. -/
def representation : Representation (ZMod 2) Matrix.PSL3Two.SL (Additive (VI c)) where
  toFun g := ((quotientAction d c core) (mark.equiv.symm g)).toMonoidHom.toAdditive.toZModLinearMap 2
  map_one' := by
    apply LinearMap.ext
    intro v
    change Additive.ofMul ((quotientAction d c core) (mark.equiv.symm 1) v.toMul) = v
    rw [map_one, map_one]
    rfl
  map_mul' a b := by
    apply LinearMap.ext
    intro v
    change Additive.ofMul ((quotientAction d c core) (mark.equiv.symm (a * b)) v.toMul) =
      Additive.ofMul ((quotientAction d c core) (mark.equiv.symm a)
        ((quotientAction d c core) (mark.equiv.symm b) v.toMul))
    rw [map_mul, map_mul]
    rfl

/-- Pointwise compatibility with ambient conjugation, with the specified quotient map. -/
theorem representation_apply (g : I c) (v : Additive (VI c)) :
    ((representation d c core mark (markedMap c mark g) v).toMul : G) =
      (g : G) * (v.toMul : G) * (g : G)⁻¹ := by
  change (((quotientAction d c core) (mark.equiv.symm (mark.equiv (plusMap c g)))) v.toMul : G) = _
  rw [mark.equiv.symm_apply_apply]
  rfl

theorem point_fixed (g : Matrix.PSL3Two.SL) (hg : g ∈ Matrix.PSL3Two.pointParabolicSL) :
    representation d c core mark g (seed d c) = seed d c := by
  rw [← mark.point, ← markedImage_eq] at hg
  obtain ⟨a, ha, rfl⟩ := hg
  apply Additive.toMul.injective
  apply Subtype.ext
  rw [representation_apply]
  change (a : G) * d.z * (a : G)⁻¹ = d.z
  have hz : d.z ∈ F.Vi 1 := by rw [d.point]; exact mem_zpowers _
  have hc : d.z * (a : G) = (a : G) * d.z :=
    mem_centralizer_iff.mp (group_centralizes_point d ha) d.z hz
  rw [← hc, mul_inv_cancel_right]

/-- The subspace defined by literal ambient membership. -/
def space (A : Subgroup G) : Submodule (ZMod 2) (Additive (VI c)) :=
  AddSubgroup.toZModSubmodule 2 (A.subgroupOf (VI c)).toAddSubgroup

/-- Linear orbit spans and ambient conjugate spans agree under the marked action. -/
theorem orbitSpan_eq_space (A : Subgroup G) (hA : A ≤ I c) :
    orbitSpan (representation d c core mark) (markedImage c mark A) (seed d c) =
      space c (conjugateSpanBy (F.Vi 1) A) := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro v ⟨g, hg, rfl⟩
    obtain ⟨a, ha, rfl⟩ := hg
    change ((representation d c core mark (markedMap c mark a) (seed d c)).toMul : G) ∈ conjugateSpanBy (F.Vi 1) A
    rw [representation_apply]
    exact subset_closure ⟨a, ha, d.z, by rw [d.point]; exact mem_zpowers _, rfl⟩
  · let O := orbitSpan (representation d c core mark) (markedImage c mark A) (seed d c)
    let S : Subgroup (VI c) := O.toAddSubgroup.toSubgroup'
    have hspan : conjugateSpanBy (F.Vi 1) A ≤ S.map (VI c).subtype := by
      apply (closure_le _).mpr
      rintro _ ⟨a, ha, z, hz, rfl⟩
      rw [d.point] at hz
      obtain ⟨n, rfl⟩ := mem_zpowers_iff.mp hz
      have hm : a * d.z * a⁻¹ ∈ S.map (VI c).subtype := by
        let aI : I c := ⟨a, hA ha⟩
        refine ⟨(representation d c core mark (markedMap c mark aI) (seed d c)).toMul, ?_, ?_⟩
        · exact orbit_mem _ _ _ _ (mem_map_of_mem _ ha)
        · exact representation_apply d c core mark aI (seed d c)
      change MulAut.conj a (d.z ^ n) ∈ S.map (VI c).subtype
      rw [map_zpow]
      exact (S.map (VI c).subtype).zpow_mem hm n
    intro v hv
    obtain ⟨w, hw, he⟩ := hspan hv
    have he' : w = v.toMul := Subtype.ext he
    change v.toMul ∈ S
    rwa [he'] at hw

/-- The source identity VI = ⟨V₁^I⟩ gives cyclic generation of the entire representation. -/
theorem seed_generates : orbitSpan (representation d c core mark) ⊤ (seed d c) = ⊤ := by
  have ht : markedImage c mark (I c) = ⊤ := by
    rw [markedImage, subgroupOf_self]
    exact map_top_of_surjective _ (markedMap_surjective c mark)
  rw [← ht, orbitSpan_eq_space d c core mark (I c) le_rfl]
  ext v
  change (v.toMul : G) ∈ VI c ↔ True
  exact iff_true_intro v.toMul.property

/-- The line-parabolic orbit is precisely the original rank-two group E. -/
theorem line_orbit_eq (geometry : Geometry d c) :
    orbitSpan (representation d c core mark) Matrix.PSL3Two.lineParabolicSL (seed d c) =
      space c (E c) := by
  rw [← mark.line, ← markedImage_eq, orbitSpan_eq_space d c core mark _ (YT_le_I c),
    geometry.span_point_YT]

/-- The subgroup-to-subspace identification preserves the literal elements. -/
def spaceEquiv (A : Subgroup G) (hA : A ≤ VI c) : space c A ≃ A where
  toFun v := ⟨v.val.toMul.val, v.property⟩
  invFun a := ⟨Additive.ofMul ⟨a.val, hA a.property⟩, a.property⟩
  left_inv _ := rfl
  right_inv _ := rfl

theorem line_orbit_finrank (geometry : Geometry d c) :
    Module.finrank (ZMod 2)
      (orbitSpan (representation d c core mark) Matrix.PSL3Two.lineParabolicSL (seed d c)) = 2 := by
  rw [line_orbit_eq d c core mark geometry]
  let : IsElementaryAbelian 2 (E c) := geometry.elementary
  have he : Nat.card (space c (E c)) = Nat.card (E c) :=
    Nat.card_congr (spaceEquiv c (E c) geometry.E_le_VI)
  have hr : Module.finrank (ZMod 2) (Additive (E c)) = 2 :=
    (rank_eq_finrank (E c)).symm.trans geometry.rank_two
  have hc := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := space c (E c))
  have hcE := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := Additive (E c))
  rw [Nat.card_zmod] at hc hcE
  exact Nat.pow_right_injective (by decide : 2 ≤ 2)
    (hc.symm.trans (he.trans (hcE.trans (congrArg (2 ^ ·) hr))))

/-- H.5.5 applied to the actual source conjugation module, with all seed premises discharged. -/
theorem equiv_natural (geometry : Geometry d c) :
    Nonempty ((representation d c core mark).Equiv BinaryLinearThree.W) :=
  point_seed_equiv_natural _ (seed d c) (seed_ne_zero d c)
    (point_fixed d c core mark) (seed_generates d c core mark)
    (line_orbit_finrank d c core mark geometry)

end Binary

/-- Chosen equivariant natural coordinates on the original multiplicative subgroup. -/
def naturalCoordinates (geometry : Geometry d c) :
    VI c ≃* Multiplicative BinaryLinearThree.Vector := by
  let : IsElementaryAbelian 2 (VI c) := core.elementary
  exact (Classical.choice (equiv_natural d c core mark geometry)).toLinearEquiv.toAddEquiv.toMultiplicativeRight

/-- These coordinates intertwine the actual ambient conjugation and the marked
natural matrix action. -/
theorem naturalCoordinates_conjugation (geometry : Geometry d c) (g : I c) (v : VI c) :
    (naturalCoordinates d c core mark geometry (conjugation c g v)).toAdd =
      BinaryLinearThree.W (mark.equiv (plusMap c g))
        (naturalCoordinates d c core mark geometry v).toAdd := by
  let : IsElementaryAbelian 2 (VI c) := core.elementary
  let e := Classical.choice (equiv_natural d c core mark geometry)
  have he := Representation.IntertwiningMap.isIntertwining _ _ e.toIntertwiningMap
    (markedMap c mark g) (Additive.ofMul v)
  have ha : representation d c core mark (markedMap c mark g) (Additive.ofMul v) =
      Additive.ofMul (conjugation c g v) := by
    apply Additive.toMul.injective
    apply Subtype.ext
    exact representation_apply d c core mark g (Additive.ofMul v)
  rw [ha] at he
  exact he

include core mark in
/-- The terminal rank-three assertion of 14.7.70, conditional only on the preceding
geometry and the two independent classification outputs. -/
theorem primeRank_VI (geometry : Geometry d c) : primeRank 2 (VI c) = 3 := by
  let : IsElementaryAbelian 2 (VI c) := core.elementary
  obtain ⟨e⟩ := equiv_natural d c core mark geometry
  rw [rank_eq_finrank (VI c), e.toLinearEquiv.finrank_eq]
  simp [BinaryLinearThree.Vector]

end CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.Source.Rechoice.Goldschmidt.PointModule
