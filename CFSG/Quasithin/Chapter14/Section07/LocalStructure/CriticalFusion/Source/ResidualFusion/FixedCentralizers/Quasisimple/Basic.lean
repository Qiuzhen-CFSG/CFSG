module

public import CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.Source.ResidualFusion.FixedCentralizers.Setup
public import CFSG.Quasithin.Chapter1.Section01.ModelActions115
public import Theory.GroupTheory.PResidual.SylowSupplement

/-!
# The quasisimple fixed-centralizer branch: source reductions and normalizer assembly

Let G_u = C_G(u), T_u = C_T(u), and let L_u be the actual relatively
normal component. Relative normality and quasisimplicity make it an ordinary
component, so the universal 1.1.5 action clause applies through the proved
1.1.6 setup. The earlier commutator-generation identity places u in L_u
and hence in its even center. This generation identity is still explicit;
its source producer is qt-14-07-components (14.7.48(2)).

The ambient image of N_{L_u}(V) is defined literally as L_u intersect N_G(V).
If this group is two-perfect and its two-core quotient is L₃(2), expressed
as an isomorphism to Aut(V), its actual conjugation action is onto: its
kernel is a two-group by the plane-centralizer bound. This factors N_G(V)
through it and T. The index-two fixed centralizer, relative normality, and
two-perfectness then identify it with L. Its center of order two is the
original line generated by u. Characteristicity makes that line T-invariant,
contradicting the supplied Sylow status of T_u.

`FixedRudvalisCover` retains an actual surjection to the Rudvalis carrier
and identifies its kernel in G. Its intrinsic quotient isomorphism, central
kernel, and kernel order are proved here. No recognition result is assumed
in Data. The source chief-factor sieve producing this cover, and the
intrinsic normalizer model (perfectness, quotient, center), remain missing.
`false_of_fixedNormalizer_model` is the conditional downstream assembly,
not the completed quasisimple exclusion or Lemma 14.7.68.

Besides the model inputs, the precise universal earlier 1.1.5 implication,
ModuleSeparation (14.7.2), and Structural1222 retain their original source
owners qt-1-01/qt-1-01-quasisimple-involutions, qt-14-07-solvable, and
qt-12-02. The actual ordinary-component and Sylow hypotheses are verified
at the consumer, not added to the universal earlier statement.

Source: Aschbacher–Smith, combined manuscript, 1 March 2004,
14.7.68(2), printed p.1071 (PDF p.1088), and 14.7.67(5).
-/

@[expose] public section
noncomputable section
open Subgroup Representation Theory.GroupTheory
open scoped commutatorElement
namespace CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.Source
open Chapter12.Section08
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  {F : InvariantFlag T V 3} {W : Type u} [AddCommGroup W] [Module (ZMod 2) W]
namespace Data
variable (d : Data T L V F W)

-- The source commutator always lies in K, before selecting the component.
include d in
theorem U_commutator_K_le : ⁅F.U, K F⁆ ≤ K F :=
  le_normalizer_iff_commutator_le_right.mp
    (d.conjugationSection.section_le.trans (H_normalizes_K F))

-- Generation is an earlier source obligation, not a new field of Data.
include d in
theorem fixed_mem_component_of_commutator (hgen : F.U = ⁅F.U, K F⁆)
    (u : F.U) {Lu : Subgroup G} (hKLu : K F ≤ Lu) : (u : G) ∈ Lu := by
  exact hKLu (d.U_commutator_K_le (hgen ▸ u.property))

theorem fixed_mem_center_component (u : F.U) {Lu : Subgroup G}
    (hLu : Lu ≤ d.fixedCentralizer u) (huLu : (u : G) ∈ Lu) :
    (⟨(u : G), huLu⟩ : Lu) ∈ center Lu := by
  apply mem_center_iff.mpr
  intro x
  apply Subtype.ext
  exact mem_centralizer_singleton_iff.mp (hLu x.property)

theorem fixed_component_center_even (u : F.U) (hne : (u : G) ≠ 1)
    {Lu : Subgroup G} (hLu : Lu ≤ d.fixedCentralizer u) (huLu : (u : G) ∈ Lu) :
    2 ∣ Nat.card (center Lu) := by
  let v : center Lu := ⟨⟨u, huLu⟩, d.fixed_mem_center_component u hLu huLu⟩
  have hv : orderOf v = 2 := by
    rw [← orderOf_injective (center Lu).subtype (center Lu).subtype_injective,
      ← orderOf_injective Lu.subtype Lu.subtype_injective]
    exact d.fixedElement_order u hne
  exact hv ▸ _root_.orderOf_dvd_natCard v


/-- Relative normality and genuine quasisimplicity give an ordinary component
of the original element centralizer. No ambient normality is used. -/
theorem fixedComponent_isComponent (u : F.U) {Lu : Subgroup G}
    (hLu : Lu ≤ d.fixedCentralizer u)
    (hn : (Lu.subgroupOf (d.fixedCentralizer u)).Normal) (hq : IsQuasisimple Lu) :
    Theory.GroupTheory.IsComponent (d.fixedCentralizer u)
      (Lu.subgroupOf (d.fixedCentralizer u)) := by
  let := hq
  exact ⟨hn.isSubnormal, IsQuasisimple.of_mulEquiv (subgroupOfEquivOfLe hLu).symm⟩

/-- Apply the universal earlier 1.1.5 action clause to this very component.
The source hypotheses are verified by Setup.fixedCentralizer_lemma115.
The universal implication belongs to qt-1-01 and its quasisimple producer. -/
theorem fixedComponent_modelAction115
    (h115 : ∀ (H : Subgroup G) (S : Sylow 2 H) (M : Subgroup G) (z : G),
      Chapter1.Lemma115Hypotheses H S M z →
        ∀ A : Subgroup H, Theory.GroupTheory.IsComponent H A →
          Chapter15.Section03.Candidates.ComponentStructure.HasModelAction115 A z)
    (u : F.U) (hne : (u : G) ≠ 1) (hmax : IsMaximalTwoLocal F.H)
    (hsyl : Chapter1.IsSylowIn 2 (d.fixedSylow u) (d.fixedCentralizer u))
    {Lu : Subgroup G} (hLu : Lu ≤ d.fixedCentralizer u)
    (hn : (Lu.subgroupOf (d.fixedCentralizer u)).Normal) (hq : IsQuasisimple Lu) :
    Chapter15.Section03.Candidates.ComponentStructure.HasModelAction115
      (Lu.subgroupOf (d.fixedCentralizer u)) d.z := by
  obtain ⟨S, hS⟩ := hsyl
  exact h115 _ S F.H d.z (d.fixedCentralizer_lemma115 u hne hmax S hS)
    _ (d.fixedComponent_isComponent u hLu hn hq)


/-- An escaping fixed centralizer cannot come from a nonidentity element of V:
its U₀-intersection is the original point. -/
theorem fixed_not_mem_seed_of_escape (earlier : d.ModuleSeparation)
    (u : F.U) (hu : (u : G) ∈ d.U₀) (hne : (u : G) ≠ 1)
    (hout : ¬ d.fixedCentralizer u ≤ F.H) : (u : G) ∉ V := by
  intro hv
  have hp : (u : G) ∈ F.Vi 1 := d.seed_inf_U₀ earlier ▸ (show (u : G) ∈ V ⊓ d.U₀ from ⟨hv, hu⟩)
  have he : zpowers (u : G) = F.Vi 1 := eq_of_le_of_card_ge (zpowers_le.mpr hp) (by
    rw [Nat.card_zpowers, d.fixedElement_order u hne, F.card 1 (by decide)]
    decide)
  have hH : F.H = d.fixedCentralizer u := by
    change normalizer (F.Vi 1 : Set G) = centralizer ({(u : G)} : Set G)
    rw [← he, normalizer_zpowers_eq_centralizer_of_order_two _ (d.fixedElement_order u hne)]
  exact hout hH.ge

/-- The central covering line and the original V meet trivially. -/
theorem fixed_line_inf_seed_eq_bot (earlier : d.ModuleSeparation)
    (u : F.U) (hu : (u : G) ∈ d.U₀) (hne : (u : G) ≠ 1)
    (hout : ¬ d.fixedCentralizer u ≤ F.H) : zpowers (u : G) ⊓ V = ⊥ := by
  classical
  apply bot_unique
  intro x hx
  have hxline : x ∈ zpowers (u : G) := hx.1
  rw [mem_zpowers_iff_mem_range_orderOf, d.fixedElement_order u hne] at hxline
  obtain ⟨n, hn, he⟩ := Finset.mem_image.mp hxline
  have hn2 := Finset.mem_range.mp hn
  interval_cases n
  · simpa using he.symm
  · have hxu : x = (u : G) := by simpa using he.symm
    exact (d.fixed_not_mem_seed_of_escape earlier u hu hne hout (hxu ▸ hx.2)).elim

-- The marked normalizer is an actual ambient intersection.
def fixedComponentNormalizer (_d : Data T L V F W) (Lu : Subgroup G) : Subgroup G :=
  Lu ⊓ normalizer (V : Set G)

theorem fixed_mem_componentNormalizer (u : F.U) {Lu : Subgroup G}
    (huLu : (u : G) ∈ Lu) : (u : G) ∈ d.fixedComponentNormalizer Lu := by
  let := d.abelian
  exact ⟨huLu, Subgroup.centralizer_le_normalizer _
    (centralizer_le (V_le_U F) (le_centralizer F.U u.property))⟩

theorem fixed_componentNormalizer_center (u : F.U) (hne : (u : G) ≠ 1)
    {Lu : Subgroup G} (hLu : Lu ≤ d.fixedCentralizer u) (huLu : (u : G) ∈ Lu)
    (hcard : Nat.card (center (d.fixedComponentNormalizer Lu)) = 2) :
    Chapter12.Section08.centerIn (d.fixedComponentNormalizer Lu) = zpowers (u : G) := by
  have huJ := d.fixed_mem_componentNormalizer u huLu
  have huZ : (u : G) ∈ Chapter12.Section08.centerIn (d.fixedComponentNormalizer Lu) :=
    mem_map.mpr ⟨⟨u, huJ⟩,
      d.fixed_mem_center_component u (inf_le_left.trans hLu) huJ, rfl⟩
  apply (eq_of_le_of_card_ge (zpowers_le.mpr huZ) ?_).symm
  rw [Chapter12.Section08.centerIn, card_map_of_injective (d.fixedComponentNormalizer Lu).subtype_injective,
    hcard, Nat.card_zpowers, d.fixedElement_order u hne]

-- Escape forces T_u to be proper: otherwise the maximal two-local H lies in G_u.
theorem fixedSylow_ne_sylow_of_escape (u : F.U) (hu : (u : G) ∈ d.U₀)
    (hne : (u : G) ≠ 1) (hmax : IsMaximalTwoLocal F.H)
    (hout : ¬ d.fixedCentralizer u ≤ F.H) : d.fixedSylow u ≠ (T : Subgroup G) := by
  intro he
  have hTG : (T : Subgroup G) ≤ d.fixedCentralizer u := he ▸ inf_le_right
  have hHG : F.H ≤ d.fixedCentralizer u := by
    rw [d.residual_product]
    exact sup_le (d.K_le_fixedCentralizer u hu) hTG
  exact hout (hmax.2
    (Theory.GroupTheory.isTwoLocal_involution_centralizer (d.fixedElement_order u hne)) hHG)

theorem fixedSylow_index_two_of_escape (u : F.U) (hu : (u : G) ∈ d.U₀)
    (hne : (u : G) ≠ 1) (hfix : d.FixedModuloPoint u)
    (hmax : IsMaximalTwoLocal F.H) (hout : ¬ d.fixedCentralizer u ≤ F.H) :
    (d.fixedSylow u).relIndex (T : Subgroup G) = 2 := by
  have hi : (d.fixedSylow u).relIndex (T : Subgroup G) ≤ 2 := by
    rw [fixedSylow, inf_relIndex_left]
    exact d.fixedModuloPoint_centralizer_index u hfix
  have hn : (d.fixedSylow u).relIndex (T : Subgroup G) ≠ 0 :=
    ((d.fixedSylow u).subgroupOf (T : Subgroup G)).index_ne_zero_of_finite
  have h1 : (d.fixedSylow u).relIndex (T : Subgroup G) ≠ 1 := by
    intro h
    exact d.fixedSylow_ne_sylow_of_escape u hu hne hmax hout
      (le_antisymm inf_le_left (relIndex_eq_one.mp h))
  omega

theorem fixed_line_not_T_invariant (u : F.U) (hu : (u : G) ∈ d.U₀)
    (hne : (u : G) ≠ 1) (hmax : IsMaximalTwoLocal F.H)
    (hout : ¬ d.fixedCentralizer u ≤ F.H)
    (hsyl : Chapter1.IsSylowIn 2 (d.fixedSylow u) (d.fixedCentralizer u)) :
    ¬ (T : Subgroup G) ≤ normalizer (zpowers (u : G) : Set G) := by
  intro hn
  rw [normalizer_zpowers_eq_centralizer_of_order_two _ (d.fixedElement_order u hne)] at hn
  have he := (Chapter1.isSylowIn_iff.mp hsyl).2.2 (T : Subgroup G)
    T.isPGroup' inf_le_left hn
  exact d.fixedSylow_ne_sylow_of_escape u hu hne hmax hout he.symm


/-- A marking of the actual double covering, including its ambient kernel.
This is an output of recognition, not a recognition hypothesis in Data. -/
structure FixedRudvalisCover (_d : Data T L V F W) (u : F.U) (Lu : Subgroup G) where
  projection : Lu →* Rudvalis.Model
  onto : Function.Surjective projection
  kernel : projection.ker.map Lu.subtype = zpowers (u : G)

theorem FixedRudvalisCover.mem_component {u : F.U} {Lu : Subgroup G}
    (r : d.FixedRudvalisCover u Lu) : (u : G) ∈ Lu := by
  have hk : (u : G) ∈ r.projection.ker.map Lu.subtype := r.kernel.symm ▸ mem_zpowers _
  exact map_subtype_le _ hk

/-- The quotient identification retains the actual covering homomorphism. -/
def FixedRudvalisCover.quotientEquiv {u : F.U} {Lu : Subgroup G}
    (r : d.FixedRudvalisCover u Lu) : (Lu ⧸ r.projection.ker) ≃* Rudvalis.Model :=
  QuotientGroup.quotientKerEquivOfSurjective r.projection r.onto


/-- The marked ambient kernel is exactly the intrinsic involution line. -/
theorem FixedRudvalisCover.kernel_eq_zpowers {u : F.U} {Lu : Subgroup G}
    (r : d.FixedRudvalisCover u Lu) :
    r.projection.ker = zpowers (⟨(u : G), r.mem_component⟩ : Lu) := by
  apply map_injective Lu.subtype_injective
  rw [r.kernel, MonoidHom.map_zpowers]
  rfl

/-- The actual homomorphism has a central kernel, using the source centralizer. -/
theorem FixedRudvalisCover.kernel_le_center {u : F.U} {Lu : Subgroup G}
    (r : d.FixedRudvalisCover u Lu) (hLu : Lu ≤ d.fixedCentralizer u) :
    r.projection.ker ≤ center Lu := by
  rw [r.kernel_eq_zpowers]
  exact zpowers_le.mpr (d.fixed_mem_center_component u hLu r.mem_component)

/-- Nonidentity of the original u makes this an actual double cover. -/
theorem FixedRudvalisCover.kernel_card_two {u : F.U} {Lu : Subgroup G}
    (r : d.FixedRudvalisCover u Lu) (hne : (u : G) ≠ 1) :
    Nat.card r.projection.ker = 2 := by
  rw [← card_map_of_injective Lu.subtype_injective (K := r.projection.ker),
    r.kernel, Nat.card_zpowers, d.fixedElement_order u hne]

private theorem twoPerfect_le_of_index_dvd_two {X : Type*} [Group X] [Finite X]
    (A B : Subgroup X) (hp : IsPPerfect 2 A) (hi : B.index ∣ 2) : A ≤ B := by
  have hc := (Nat.dvd_prime (by decide : Nat.Prime 2)).mp hi
  rcases hc with hc | hc
  · rw [index_eq_one.mp hc]
    exact le_top
  · let := B.normal_of_index_eq_two hc
    have hquot : IsPGroup 2 (X ⧸ B) := IsPGroup.of_card (n := 1) (by
      simpa only [index_eq_card, pow_one] using hc)
    exact (le_pResidual_of_isPPerfect A hp).trans (sInf_le ⟨inferInstance, hquot⟩)

/-- 67(5) and two-perfectness place the actual local normalizer in L. -/
theorem fixedComponentNormalizer_le_L
    (earlier : d.ModuleSeparation)
    (structural : Chapter12.Section02.Structural1222 KnownSimple.IsKnownSimple.{u})
    (Lu : Subgroup G) (hp : IsPPerfect 2 (d.fixedComponentNormalizer Lu)) :
    d.fixedComponentNormalizer Lu ≤ L := by
  have hle : d.fixedComponentNormalizer Lu ≤ L ⊔ (T : Subgroup G) := by
    rw [d.lemma_14_7_67_five earlier]
    exact inf_le_right
  have hr := embedded_pResidual_mono 2 hle
  rw [(pResidual_eq_top_iff 2 _).mpr hp, ← MonoidHom.range_eq_map, range_subtype,
    embedded_pResidual_join_pGroup L (T : Subgroup G)
      ((pResidual_eq_top_iff 2 _).mp d.natural.residual) T.isPGroup'
      (d.natural.sylow_normalizes structural)] at hr
  exact hr

/-- Conjugation on the original V, restricted to the actual component normalizer. -/
def fixedComponentNormalizerAction (Lu : Subgroup G) :
    d.fixedComponentNormalizer Lu →* MulAut V :=
  V.normalizerMonoidHom.comp (inclusion inf_le_right)

/-- The original plane-centralizer bound makes the kernel a two-group. -/
theorem fixedComponentNormalizerAction_kernel_twoGroup (earlier : d.ModuleSeparation)
    (Lu : Subgroup G) : IsPGroup 2 (d.fixedComponentNormalizerAction Lu).ker := by
  let f := d.fixedComponentNormalizerAction Lu
  have hkT : ∀ x ∈ f.ker, (x : G) ∈ (T : Subgroup G) := by
    intro x hx
    have hc : inclusion (show d.fixedComponentNormalizer Lu ≤ normalizer (V : Set G)
        from inf_le_right) x ∈ V.normalizerMonoidHom.ker := hx
    rw [normalizerMonoidHom_ker] at hc
    exact d.plane_centralizer_le earlier (centralizer_le (F.le_seed 2) hc)
  let i : f.ker →* T := ( (d.fixedComponentNormalizer Lu).subtype.comp f.ker.subtype).codRestrict
    (T : Subgroup G) (fun x => hkT x x.property)
  apply T.isPGroup'.of_injective i
  intro x y he
  exact Subtype.ext (Subtype.ext (congrArg (fun t : T => (t : G)) he))

/-- The L₃(2) quotient supplies the full action on V, with no assumed image certificate. -/
theorem fixedComponentNormalizerAction_surjective (earlier : d.ModuleSeparation)
    (Lu : Subgroup G)
    (e : (d.fixedComponentNormalizer Lu ⧸ pCore 2 (d.fixedComponentNormalizer Lu)) ≃* MulAut V) :
    Function.Surjective (d.fixedComponentNormalizerAction Lu) := by
  let f := d.fixedComponentNormalizerAction Lu
  have hk : f.ker ≤ pCore 2 (d.fixedComponentNormalizer Lu) :=
    le_sSup ⟨inferInstance, d.fixedComponentNormalizerAction_kernel_twoGroup earlier Lu⟩
  have hi := index_dvd_of_le hk
  rw [index_ker] at hi
  have hc : Nat.card (MulAut V) ≤ Nat.card f.range := by
    apply Nat.le_of_dvd Nat.card_pos
    simpa only [index_eq_card, Nat.card_congr e.toEquiv] using hi
  apply MonoidHom.range_eq_top.mp
  apply eq_of_le_of_card_ge le_top
  simpa only [Nat.card_congr (Subgroup.topEquiv : (⊤ : Subgroup (MulAut V)) ≃* MulAut V).toEquiv] using hc

/-- The genuine L₃(2) quotient factors N_G(V) through the local normalizer and T. -/
theorem fixedComponentNormalizer_factorization (earlier : d.ModuleSeparation)
    (Lu : Subgroup G)
    (e : (d.fixedComponentNormalizer Lu ⧸ pCore 2 (d.fixedComponentNormalizer Lu)) ≃* MulAut V)
    (x : G) (hx : x ∈ normalizer (V : Set G)) :
    ∃ j ∈ d.fixedComponentNormalizer Lu, ∃ t ∈ (T : Subgroup G), x = j * t := by
  obtain ⟨j, hj⟩ := d.fixedComponentNormalizerAction_surjective earlier Lu e
    (V.normalizerMonoidHom ⟨x, hx⟩)
  let j' : normalizer (V : Set G) := inclusion inf_le_right j
  have hk : j'⁻¹ * ⟨x, hx⟩ ∈ V.normalizerMonoidHom.ker := by
    change V.normalizerMonoidHom (j'⁻¹ * ⟨x, hx⟩) = 1
    rw [map_mul, map_inv, show V.normalizerMonoidHom j' = _ from hj, inv_mul_cancel]
  rw [normalizerMonoidHom_ker] at hk
  have ht : (j : G)⁻¹ * x ∈ (T : Subgroup G) :=
    d.plane_centralizer_le earlier (centralizer_le (F.le_seed 2) hk)
  exact ⟨j, j.property, (j : G)⁻¹ * x, ht, (mul_inv_cancel_left _ _).symm⟩


/-- The source index-two argument identifies the local normalizer with L.
Its hypotheses are the intrinsic perfectness and quotient model, not the
ambient identification being proved. -/
theorem fixedComponentNormalizer_eq_L
    (earlier : d.ModuleSeparation)
    (structural : Chapter12.Section02.Structural1222 KnownSimple.IsKnownSimple.{u})
    (u : F.U) (hu : (u : G) ∈ d.U₀) (hne : (u : G) ≠ 1)
    (hfix : d.FixedModuloPoint u) (hmax : IsMaximalTwoLocal F.H)
    {Lu : Subgroup G} (hLu : Lu ≤ d.fixedCentralizer u)
    (hn : (Lu.subgroupOf (d.fixedCentralizer u)).Normal) (hout : ¬ Lu ≤ F.H)
    (hp : IsPPerfect 2 (d.fixedComponentNormalizer Lu))
    (e : (d.fixedComponentNormalizer Lu ⧸ pCore 2 (d.fixedComponentNormalizer Lu)) ≃* MulAut V) :
    d.fixedComponentNormalizer Lu = L := by
  let N := normalizer (V : Set G)
  let J := d.fixedComponentNormalizer Lu
  have hLN : L ≤ N := d.natural.chosen.normalizes
  have hTN : (T : Subgroup G) ≤ N := by simpa only [F.last] using F.invariant 3
  have hJG : J ≤ d.fixedCentralizer u := inf_le_left.trans hLu
  have hJL : J ≤ L := d.fixedComponentNormalizer_le_L earlier structural Lu hp
  have hindex : (d.fixedCentralizer u).relIndex N ∣ 2 := by
    have hi := d.fixedSylow_index_two_of_escape u hu hne hfix hmax
      (fun h => hout (hLu.trans h))
    have hid : (d.fixedSylow u).relIndex (T : Subgroup G) ∣ 2 := by rw [hi]
    obtain ⟨a, ha, hacoset⟩ := relIndex_dvd_two_iff.mp hid
    apply relIndex_dvd_two_iff.mpr
    refine ⟨a, hTN ha, ?_⟩
    intro x hx
    obtain ⟨j, hj, t, ht, rfl⟩ := d.fixedComponentNormalizer_factorization earlier Lu e x hx
    rcases hacoset t ht with hta | ht'
    · exact Or.inl (by simpa only [mul_assoc] using
        (d.fixedCentralizer u).mul_mem (hJG hj) hta.2)
    · exact Or.inr ((d.fixedCentralizer u).mul_mem (hJG hj) ht'.2)
  have hLG : L ≤ d.fixedCentralizer u := by
    have hpL : IsPPerfect 2 (L.subgroupOf N) :=
      ((pResidual_eq_top_iff 2 _).mp d.natural.residual).of_surjective
        (subgroupOfEquivOfLe hLN).symm.toMonoidHom (subgroupOfEquivOfLe hLN).symm.surjective
    have hc := twoPerfect_le_of_index_dvd_two (L.subgroupOf N)
      ((d.fixedCentralizer u).subgroupOf N) hpL hindex
    intro x hx
    exact hc (show (⟨x, hLN hx⟩ : N) ∈ L.subgroupOf N from hx)
  have hJn : (J.subgroupOf L).Normal := by
    apply (normal_subgroupOf_iff_le_normalizer hJL).mpr
    exact (le_inf (hLG.trans ((normal_subgroupOf_iff_le_normalizer hLu).mp hn))
      (hLN.trans N.le_normalizer)).trans inf_normalizer_le_normalizer_inf
  let := hJn
  have hsup : J.subgroupOf L ⊔ (T : Subgroup G).subgroupOf L = ⊤ := by
    apply top_unique
    intro x _
    obtain ⟨j, hj, t, ht, he⟩ := d.fixedComponentNormalizer_factorization earlier Lu e x (hLN x.property)
    have htL : t ∈ L := by
      have hh := L.mul_mem (L.inv_mem (hJL hj)) x.property
      simpa only [he, inv_mul_cancel_left] using hh
    have heL : x = (⟨j, hJL hj⟩ : L) * ⟨t, htL⟩ := Subtype.ext he
    rw [heL]
    exact mul_mem_sup hj ht
  have hquot := isPGroup_quotient_of_sup_eq_top (J.subgroupOf L)
    ((T : Subgroup G).subgroupOf L) T.isPGroup'.comap_subtype hsup
  have ht : J.subgroupOf L = ⊤ :=
    top_unique (d.natural.residual ▸ (show pResidual 2 L ≤ J.subgroupOf L from
      sInf_le ⟨hJn, hquot⟩))
  have hm := congrArg (map L.subtype) ht
  simpa only [map_subgroupOf_eq_of_le hJL, ← MonoidHom.range_eq_map, range_subtype] using hm

-- This is only the final, general step, not the source recognition theorem.
private theorem false_of_componentNormalizer_eq_and_center
    (structural : Chapter12.Section02.Structural1222 KnownSimple.IsKnownSimple.{u})
    (u : F.U) (hu : (u : G) ∈ d.U₀) (hne : (u : G) ≠ 1)
    (hmax : IsMaximalTwoLocal F.H)
    (hsyl : Chapter1.IsSylowIn 2 (d.fixedSylow u) (d.fixedCentralizer u))
    {Lu : Subgroup G} (hLu : Lu ≤ d.fixedCentralizer u) (huLu : (u : G) ∈ Lu)
    (hout : ¬ Lu ≤ F.H) (heq : d.fixedComponentNormalizer Lu = L)
    (hcard : Nat.card (center (d.fixedComponentNormalizer Lu)) = 2) : False := by
  have hz := d.fixed_componentNormalizer_center u hne hLu huLu hcard
  rw [heq] at hz
  apply d.fixed_line_not_T_invariant u hu hne hmax (fun h => hout (hLu.trans h)) hsyl
  rw [← hz]
  exact (d.natural.sylow_normalizes structural).trans
    (normalizer_le_normalizer_characteristic_image L (center L))

/-- The actual component application. Recognition and the intrinsic normalizer
model remain to be supplied; the ambient identification and Sylow contradiction
are proved here. -/
theorem false_of_fixedNormalizer_model
    (earlier : d.ModuleSeparation)
    (structural : Chapter12.Section02.Structural1222 KnownSimple.IsKnownSimple.{u})
    (u : F.U) (hu : (u : G) ∈ d.U₀) (hne : (u : G) ≠ 1)
    (hfix : d.FixedModuloPoint u) (hmax : IsMaximalTwoLocal F.H)
    (hsyl : Chapter1.IsSylowIn 2 (d.fixedSylow u) (d.fixedCentralizer u))
    {Lu : Subgroup G} (hLu : Lu ≤ d.fixedCentralizer u)
    (hn : (Lu.subgroupOf (d.fixedCentralizer u)).Normal) (hout : ¬ Lu ≤ F.H)
    (r : d.FixedRudvalisCover u Lu)
    (hp : IsPPerfect 2 (d.fixedComponentNormalizer Lu))
    (e : (d.fixedComponentNormalizer Lu ⧸ pCore 2 (d.fixedComponentNormalizer Lu)) ≃* MulAut V)
    (hcard : Nat.card (center (d.fixedComponentNormalizer Lu)) = 2) : False :=
  d.false_of_componentNormalizer_eq_and_center structural u hu hne hmax hsyl hLu r.mem_component hout
    (d.fixedComponentNormalizer_eq_L earlier structural u hu hne hfix hmax hLu hn hout hp e) hcard

