module

public import CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.Source.ResidualFusion.FixedCentralizers.Characteristic.OddAction
public import CFSG.Quasithin.Chapter1.Section02.LocalComponents.Classification.SourceObstruction

/-!
# Scope of the proposed elementary odd-action obstruction

The intrinsic A.3.6 nilpotent models admit nontrivial elementary inner
actions. In the existing concrete (C₁₂₁ × C₁₂₁) ⋊ SL₂(5) model, the scalar
involution inverts the vector kernel. Its cyclic subgroup is elementary
abelian and acts nontrivially by conjugation on the whole component. That
component satisfies A.3.6 and all the proved omega-action assertions.

Consequently `EarlierOddAction` cannot be supplied as a universal consequence
of those intrinsic assertions and elementary nontriviality. The genuine
14.7.68 argument must use the specific critical subgroup, its R₁ placement,
and the literal star quotient. This example is not a counterexample to
14.7.68 or a realization in its simple QTKE ambient configuration.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
A.3.6(4), pp.43–45; proof of 14.7.68(2), p.1071.
-/

@[expose] public section
noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.Source.OddAction
open Chapter1.Section02 Chapter1.Section02.CenterFrattiniSource

namespace IntrinsicExample

private theorem inverter_sq : inverter ^ 2 = 1 := by
  have hr : inverter.right ^ 2 = 1 := by
    apply action_injective
    rw [map_pow, map_one, pow_two]
    apply MulEquiv.ext
    intro v
    simp only [MulAut.mul_apply, MulAut.one_apply, inverter_action, inv_inv]
  calc
    inverter ^ 2 = (SemidirectProduct.inr : complement →* Candidate) (inverter.right ^ 2) :=
      (map_pow (SemidirectProduct.inr : complement →* Candidate) inverter.right 2).symm
    _ = 1 := by rw [hr, map_one]

private theorem inverter_ne_one : inverter ≠ 1 := by
  intro hi
  have h := inverter_action (Multiplicative.ofAdd (fun _ : Fin 2 => (1 : ZMod 121)))
  rw [hi] at h
  have he := congrArg (fun v : Vector => v.toAdd (0 : Fin 2)) h
  exact (by decide : (1 : ZMod 121) ≠ -1) he

/-- The genuine order-two subgroup generated by the scalar inverter. -/
def actor : Subgroup Candidate := zpowers inverter

/-- Its actual inner action on the top-subgroup carrier of the component. -/
def innerAction : actor →* MulAut (⊤ : Subgroup Candidate) :=
  componentTransportAction (topEquiv : (⊤ : Subgroup Candidate) ≃* Candidate).symm
    (MulAut.conj.comp actor.subtype)

/-- The nontrivial elementary action exists in a genuine nilpotent A.3.6 model. -/
theorem inner_witness : Witness actor (⊤ : Subgroup Candidate) innerAction := by
  refine ⟨?_, IsElementaryAbelian.zpowers_of_pow_eq_one inverter_sq, ?_⟩
  · intro hb
    exact inverter_ne_one (show inverter ∈ (⊥ : Subgroup Candidate) from
      hb ▸ (mem_zpowers inverter))
  · intro h
    have hc : inverter ∈ center Candidate := by
      apply mem_center_iff.mpr
      intro g
      have he := congrArg (fun f : actor →* MulAut (⊤ : Subgroup Candidate) =>
        (f ⟨inverter, mem_zpowers inverter⟩ ⟨g, mem_top g⟩).val) h
      change inverter * g * inverter⁻¹ = g at he
      exact (mul_inv_eq_iff_eq_mul.mp he).symm
    rw [center_eq_bot] at hc
    exact inverter_ne_one hc

/-- The proposed intrinsic obstruction fails even with the actual omega data.
This identifies a missing ambient hypothesis, not a failure of the source theorem. -/
theorem no_earlierOddAction :
    ¬ EarlierOddAction (⊤ : Subgroup Candidate) actor innerAction := by
  intro h
  obtain ⟨_, _, _, _, _, hn, hω, _, _⟩ := intrinsic_counterexample_with_omega_actions
  exact h.nilpotent hn hω inner_witness

end IntrinsicExample
end CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.Source.OddAction
