module
public import CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.IrreducibleQuotient
public import CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.OriginalAt.Alternating.ChiefExclusion

public import CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.ChiefExclusion
public import Theory.Representation.BinaryOffender.IrreducibleFixedQuotient
public import Theory.Representation.BinaryOffender.SmallMovedProducts

/-!
# The literal irreducible fixed quotient at the same G,T

The chief-factor exclusion and full commutator generation give Irr⁺ on the original section. Its fixed quotient is irreducible with a faithful full S₅ action, and the projection kernel is exactly the original K-fixed space.

Only Structural1222At at the original G,T is used. Independent model and
section lemmas are reused from LocalReduction; its universal APIs are preserved.
Source: Aschbacher–Smith, final paragraph of 14.7.40, printed p.1063,
and 14.7.52–63, printed pp.1065–1069. Earlier structural source discharge
and the unconditional classification remain with their existing owners.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction
open Chapter12.Section08 CriticalFusion.Source
open Chapter13.Section08.TransvectionRecognition.Component.ModelExtension
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  {F : InvariantFlag T V 3} {W : Type u} [AddCommGroup W] [Module (ZMod 2) W]
  {ρ : Representation (ZMod 2) F.H W}
local notation "A5" => alternatingGroup (Fin 5)

/-- On the original section, the quotient by precisely the alternating fixed
space is irreducible and the whole section is generated by commutators. -/
theorem alternating_section_isIrrPlus_at
    (h : HigherRankHypothesis KnownSimple.IsKnownSimple T L V 3)
    (hab : IsMulCommutative F.U)
    (structural : Chapter12.Section02.Structural1222At KnownSimple.IsKnownSimple T)
    (hAlt : AlternatingResidual F)
    (s : BinaryConjugationSection F.H F.U (F.Vi 1) ρ)
    (e : HStar F.H ≃* ChapterJ.S5) (σ : Representation (ZMod 2) ChapterJ.S5 W)
    (hσ : σ.comp (quotientMarking e) = ρ) (hf : Function.Injective σ) :
    IsIrrPlus σ A5 ⊤ := by
  let τ := σ.comp (A5).subtype
  have hKH : K F ≤ F.H := map_subtype_le _
  have hfull : Coinvariants.ker τ = ⊤ :=
    s.coinvariants_eq_top_of_group_generation (K F) hKH τ
      (alternatingResidualMap e) (fun k w => by
        change ρ ⟨k,hKH k.property⟩ w = σ (alternatingResidualMap e k) w
        rw [alternatingResidualMap_coe]
        exact (LinearMap.congr_fun
          (congrArg (fun π : Representation (ZMod 2) F.H W => π ⟨k,hKH k.property⟩) hσ) w).symm)
      (by rw [commutator_comm,commutator_U h F,sup_eq_left.mpr s.kernel_le])
  have hm : subspaceCommutator σ ⊤ A5 = ⊤ := by
    rw [subspaceCommutator_top_eq_coinvariants]
    exact hfull
  apply isIrrPlus_of_minimal σ (by
    apply le_subspaceStabilizer
    intro g hg v hv
    trivial) hm
  · intro hfix
    obtain ⟨a,ha⟩ := exists_ne (1 : A5)
    apply ha
    apply Subtype.ext
    apply hf
    change σ a.val = σ 1
    rw [map_one]
    apply LinearMap.ext
    intro v
    exact hfix Submodule.mem_top a
  · intro J hJ _
    let P : Subrepresentation τ := ⟨J,fun a v hv => (hJ a.property v).2 hv⟩
    rcases alternating_section_submodule_dichotomy_at h hab structural hAlt s e σ hσ P with hp | hq
    · right
      intro v hv a
      have he := LinearMap.congr_fun (congrArg (fun π => π a) hp) ⟨v,hv⟩
      exact congrArg Subtype.val he
    · left
      have hle : subspaceCommutator σ ⊤ A5 ≤ J := by
        apply Submodule.span_le.mpr
        rintro _ ⟨g,hg,v,_,rfl⟩
        have he := LinearMap.congr_fun (congrArg (fun π => π (⟨g,hg⟩ : A5)) hq) (J.mkQ v)
        apply (Submodule.Quotient.mk_eq_zero _).mp
        change J.mkQ (σ g v - v) = 0
        rw [map_sub]
        change P.quotientRepresentation ⟨g,hg⟩ (J.mkQ v) - J.mkQ v = 0
        rw [he]
        exact sub_self _
      rw [hm] at hle
      exact top_unique hle

/-- The source Irr⁺ conclusion with the literal star marking and original
coordinates, before identifying its remaining irreducible module. -/
theorem exists_faithful_symmetric_irrPlus_at
    (h : HigherRankHypothesis KnownSimple.IsKnownSimple T L V 3)
    (hab : IsMulCommutative F.U)
    (structural : Chapter12.Section02.Structural1222At KnownSimple.IsKnownSimple T)
    (hAlt : AlternatingResidual F)
    (s : BinaryConjugationSection F.H F.U (F.Vi 1) ρ) :
    ∃ (e : HStar F.H ≃* ChapterJ.S5) (σ : Representation (ZMod 2) ChapterJ.S5 W),
      σ.comp (quotientMarking e) = ρ ∧ Function.Injective σ ∧ IsIrrPlus σ A5 ⊤ := by
  obtain ⟨e⟩ := exists_symmetric_star_at h structural hAlt
  obtain ⟨σ,hσ,hf⟩ := exists_faithful_symmetric_representation h e s
  exact ⟨e,σ,hσ,hf,alternating_section_isIrrPlus_at h hab structural hAlt s e σ hσ hf⟩

/-- Irreducibility on the actual fixed quotient, using its canonical carrier
comparison with the quotient of the top subspace. -/
theorem alternating_fixedQuotient_irreducible_at
    (h : HigherRankHypothesis KnownSimple.IsKnownSimple T L V 3)
    (hab : IsMulCommutative F.U)
    (structural : Chapter12.Section02.Structural1222At KnownSimple.IsKnownSimple T)
    (hAlt : AlternatingResidual F)
    (s : BinaryConjugationSection F.H F.U (F.Vi 1) ρ)
    (e : HStar F.H ≃* ChapterJ.S5) (σ : Representation (ZMod 2) ChapterJ.S5 W)
    (hσ : σ.comp (quotientMarking e) = ρ) (hf : Function.Injective σ) :
    IsIrreducible ((fixedQuotient σ A5).comp (A5).subtype) := by
  exact (alternating_section_isIrrPlus_at h hab structural hAlt s e σ hσ hf).fixedQuotient_irreducible σ A5

/-- The literal section surjects equivariantly onto its irreducible fixed
quotient, with the full symmetric outer action and exactly its K-fixed kernel. -/
theorem exists_faithful_irreducible_fixed_quotient_at
    (h : HigherRankHypothesis KnownSimple.IsKnownSimple T L V 3)
    (hab : IsMulCommutative F.U)
    (structural : Chapter12.Section02.Structural1222At KnownSimple.IsKnownSimple T)
    (hAlt : AlternatingResidual F)
    (s : BinaryConjugationSection F.H F.U (F.Vi 1) ρ) :
    ∃ (e : HStar F.H ≃* ChapterJ.S5) (σ : Representation (ZMod 2) ChapterJ.S5 W),
      σ.comp (quotientMarking e) = ρ ∧ IsIrrPlus σ A5 ⊤ ∧
      Function.Injective (fixedQuotient σ A5) ∧
      IsIrreducible ((fixedQuotient σ A5).comp (A5).subtype) ∧
      ∃ p : ρ.IntertwiningMap ((fixedQuotient σ A5).comp (quotientMarking e)),
        Function.Surjective p ∧ p.toLinearMap.ker =
          Representation.invariants (ρ.comp ((K F).subgroupOf F.H).subtype) := by
  obtain ⟨e,σ,hσ,hf,hi⟩ := exists_faithful_symmetric_irrPlus_at h hab structural hAlt s
  let C := fixedSpace σ A5
  let p : ρ.IntertwiningMap ((fixedQuotient σ A5).comp (quotientMarking e)) := {
    toLinearMap := C.mkQ
    isIntertwining' := by
      intro g
      apply LinearMap.ext
      intro w
      have he := LinearMap.congr_fun (congrArg (fun π => π g) hσ) w
      change C.mkQ (ρ g w) = C.mkQ (σ (quotientMarking e g) w)
      exact congrArg C.mkQ he.symm }
  refine ⟨e,σ,hσ,hi,alternating_fixedQuotient_faithful σ hf hi,
    hi.fixedQuotient_irreducible σ A5,p,C.mkQ_surjective,?_⟩
  change C.mkQ.ker = fixedSpace ρ ((K F).subgroupOf F.H)
  rw [Submodule.ker_mkQ,←hσ,fixedSpace_comp_map,residual_image]

end CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction
