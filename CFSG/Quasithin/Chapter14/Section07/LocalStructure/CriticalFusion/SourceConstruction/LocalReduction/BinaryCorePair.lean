universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  {F : InvariantFlag T V 3}

omit [Finite G] in
private theorem point_generator (P : Subgroup G) (hP : Nat.card P = 2) :
    ∃ v : G, orderOf v = 2 ∧ zpowers v = P := by
  let : Nontrivial P := (nontrivial_iff_ne_bot _).mpr (by intro hz; simp [hz] at hP)
  obtain ⟨v,hv⟩ := exists_ne (1 : P)
  have hn : (v : G) ≠ 1 := fun he => hv (Subtype.ext he)
  have hp : (v : G) ^ 2 = 1 := by
    have he := pow_card_eq_one' (x := v)
    rw [hP] at he
    exact congrArg Subtype.val he
  refine ⟨v,orderOf_eq_prime hp hn,?_⟩
  have hh := congrArg (Subgroup.map P.subtype) (zpowers_eq_top_of_prime_card hP hv)
  rw [MonoidHom.map_zpowers,←MonoidHom.range_eq_map,range_subtype] at hh
  exact hh

/-- The original opposite movements give precisely the intrinsic point-core
pair of A.1.14 on the selected reciprocal plane. -/
theorem critical_fourGroupCorePair
    (c : CriticalPath (L := L) F)
    (hcross : ⁅c.Zα,F.H.pCoreIn 2⁆ = F.Vi 1)
    (hreverse : ⁅F.Vi 1,c.Qα⁆ = c.Zα)
    (hdisj : Disjoint (F.Vi 1) c.Zα)
    (hfour : Nat.card (F.Vi 1 ⊔ c.Zα : Subgroup G) = 4)
    [IsElementaryAbelian 2 (F.Vi 1 ⊔ c.Zα : Subgroup G)] :
    ∃ v₁ v₂ : G, FourGroupCorePair (F.Vi 1 ⊔ c.Zα) v₁ v₂ ∧
      FourGroupCorePair.core v₁ = F.H.pCoreIn 2 ∧
      FourGroupCorePair.core v₂ = c.Qα := by
  have hp : Nat.card (F.Vi 1) = 2 := by simpa using F.card 1 (by decide)
  have hz : Nat.card c.Zα = 2 := by
    rw [CriticalPath.Zα,conjugate,card_map_of_injective (MulAut.conj c.conjugator⁻¹).injective]
    exact hp
  obtain ⟨v₁,ho₁,hv₁⟩ := point_generator (F.Vi 1) hp
  obtain ⟨v₂,ho₂,hv₂⟩ := point_generator c.Zα hz
  have hN : normalizer (c.Zα : Set G) = conjugate F.H c.conjugator := by
    exact (map_equiv_normalizer_eq (F.Vi 1) (MulAut.conj c.conjugator⁻¹)).symm
  have hcore₁ : FourGroupCorePair.core v₁ = F.H.pCoreIn 2 := by
    unfold FourGroupCorePair.core
    rw [←normalizer_zpowers_eq_centralizer_of_order_two v₁ ho₁,hv₁]
    rfl
  have hcore₂ : FourGroupCorePair.core v₂ = c.Qα := by
    unfold FourGroupCorePair.core
    rw [←normalizer_zpowers_eq_centralizer_of_order_two v₂ ho₂,hv₂,hN]
    rfl
  have hPcent : ⁅F.Vi 1,F.H.pCoreIn 2⁆ = ⊥ := by
    rw [commutator_comm]
    exact commutator_eq_bot_iff_le_centralizer.mpr
      ((pCoreIn_le 2 F.H).trans (normalizer_le_centralizer_of_card_two _ hp))
  have hZcent : ⁅c.Zα,c.Qα⁆ = ⊥ := by
    rw [commutator_comm]
    exact commutator_eq_bot_iff_le_centralizer.mpr
      ((pCoreIn_le 2 (conjugate F.H c.conjugator)).trans
        (hN ▸ normalizer_le_centralizer_of_card_two _ hz))
  have hself : (F.Vi 1 ⊔ c.Zα : Subgroup G) ≤
      centralizer ((F.Vi 1 ⊔ c.Zα : Subgroup G) : Set G) :=
    le_centralizer_iff_isMulCommutative.mpr inferInstance
  have hPH : (F.Vi 1 ⊔ c.Zα : Subgroup G) ≤ F.H :=
    (hself.trans (centralizer_le (show F.Vi 1 ≤ (F.Vi 1 ⊔ c.Zα : Subgroup G) from le_sup_left))).trans (Subgroup.centralizer_le_normalizer _)
  have hPZ : (F.Vi 1 ⊔ c.Zα : Subgroup G) ≤ normalizer (c.Zα : Set G) :=
    (hself.trans (centralizer_le (show c.Zα ≤ (F.Vi 1 ⊔ c.Zα : Subgroup G) from le_sup_right))).trans (Subgroup.centralizer_le_normalizer _)
  have hcomm₁ : ⁅F.Vi 1 ⊔ c.Zα,F.H.pCoreIn 2⁆ = F.Vi 1 := by
    apply le_antisymm _ (hcross ▸ commutator_mono le_sup_right le_rfl)
    exact commutator_sup_le_of_relative_normal F.H (F.Vi 1) c.Zα (F.H.pCoreIn 2)
      (F.Vi 1) le_rfl (le_sup_left.trans hPH)
      (le_sup_right.trans hPH) (hPcent.le.trans bot_le) hcross.le
  have hcomm₂ : ⁅F.Vi 1 ⊔ c.Zα,c.Qα⁆ = c.Zα := by
    apply le_antisymm _ (hreverse ▸ commutator_mono le_sup_left le_rfl)
    exact commutator_sup_le_of_relative_normal (normalizer (c.Zα : Set G))
      (F.Vi 1) c.Zα c.Qα c.Zα le_rfl
      (le_sup_left.trans hPZ)
      (le_sup_right.trans hPZ)
      hreverse.le (hZcent.le.trans bot_le)
  let : Nontrivial (F.Vi 1 ⊔ c.Zα : Subgroup G) :=
    (nontrivial_iff_ne_bot _).mpr (by intro he; simp [he] at hfour)
  refine ⟨v₁,v₂,⟨⟨hfour,IsElementaryAbelian.exponent_eq_prime⟩,?_,?_,ho₁,ho₂,?_,?_,?_⟩,hcore₁,hcore₂⟩
  · exact mem_sup_left (hv₁ ▸ mem_zpowers v₁)
  · exact mem_sup_right (hv₂ ▸ mem_zpowers v₂)
  · intro he
    have hv : v₁ ∈ (F.Vi 1 ⊓ c.Zα : Subgroup G) :=
      ⟨hv₁ ▸ mem_zpowers v₁, he ▸ (hv₂ ▸ mem_zpowers v₂)⟩
    have hone : v₁ = 1 := hdisj.le_bot hv
    simp [hone] at ho₁
  · rwa [hcore₁,hv₁]
  · rwa [hcore₂,hv₂]

/-- The original selected plane has the full source Y₀ action: its two
intrinsic point cores generate all plane automorphisms, and their fixed
product is exactly O₂(Y₀). -/
theorem local_nonnormal_component_core_pair_action
    (d : Counterexample T L)
    (h : HigherRankHypothesis KnownSimple.IsKnownSimple T L V 3)
    (hab : IsMulCommutative F.U)
    (structural : Chapter12.Section02.Structural1222 KnownSimple.IsKnownSimple.{u})
    (previous : Chapter12.Section02.Theorem12213 KnownSimple.IsKnownSimple.{u})
    (faithful : EarlierFaithfulClassification G (T : Subgroup G))
    (earlier : ResidualNormalizer.LocalControl.Earlier14710.{u})
    (I K : Subgroup G) (hI : I ∈ F.Hz L (normalizer (L : Set G)))
    (hKI : K ≤ I) (hK : (K.subgroupOf I).IsCComponent)
    (hnormal : ¬ (K.subgroupOf I).Normal) :
    ∃ c : CriticalPath (L := L) F, c.RankSelection ∧ c.Uα ≤ F.Ri L 1 ∧
      Nat.card (star F c.Uα) = 2 ∧ (F.U ⊓ c.Qα).relIndex F.U = 2 ∧
      let P := F.Vi 1 ⊔ c.Zα
      let Y₀ := F.H.pCoreIn 2 ⊔ c.Qα
      IsElementaryAbelian 2 P ∧ Nat.card P = 4 ∧
      P ≤ F.U ⊓ c.Uα ∧
      Y₀ ≤ normalizer (P : Set G) ∧
      normalizer (P : Set G) ≤ normalizer (Y₀ : Set G) ∧
      Y₀.pCoreIn 2 = Y₀ ⊓ centralizer (P : Set G) ∧
      Y₀.pCoreIn 2 = (F.H.pCoreIn 2 ⊓ centralizer (P : Set G)) ⊔
        (c.Qα ⊓ centralizer (P : Set G)) ∧
      Y₀.pCoreIn 2 ≤ (centralizer (P : Set G)).pCoreIn 2 ∧
      ∃ σ : Y₀ →* MulAut P, Function.Surjective σ ∧ σ.ker = pCore 2 Y₀ ∧
        (∀ (y : Y₀) (v : P), (σ y v : G) = (y : G) * v * (y : G)⁻¹) ∧
        Nonempty (Y₀ ⧸ pCore 2 Y₀ ≃* Equiv.Perm (Fin 3)) := by
  obtain ⟨hfixed,c,hs,hR,hcard,hindex,hcross,hreverse,hdisj,hplane,hcomm,hE,hfour,hfull⟩ :=
    local_nonnormal_component_cross_core_plane d h hab structural previous faithful earlier
      I K hI hKI hK hnormal
  let := hE
  obtain ⟨v₁,v₂,hpair,hcore₁,hcore₂⟩ :=
    critical_fourGroupCorePair c hcross hreverse hdisj hfour
  let P := F.Vi 1 ⊔ c.Zα
  let Y₀ := F.H.pCoreIn 2 ⊔ c.Qα
  have hy : FourGroupCorePair.generated v₁ v₂ = Y₀ := by
    simp only [FourGroupCorePair.generated,hcore₁,hcore₂,Y₀]
  have hYn : Y₀ ≤ normalizer (P : Set G) := hy ▸ hpair.generated_le_normalizer
  have hNY : normalizer (P : Set G) ≤ normalizer (Y₀ : Set G) :=
    hy ▸ hpair.normalizer_le_normalizer_generated
  have hkernel : Y₀.pCoreIn 2 = Y₀ ⊓ centralizer (P : Set G) :=
    hy ▸ hpair.twoCore_eq_generated_inf_centralizer
  have hproduct : Y₀.pCoreIn 2 = (F.H.pCoreIn 2 ⊓ centralizer (P : Set G)) ⊔
      (c.Qα ⊓ centralizer (P : Set G)) := by
    have hh := hpair.twoCore_eq_kernelJoin
    simpa only [hy,FourGroupCorePair.kernelJoin,FourGroupCorePair.pointKernel,hcore₁,hcore₂] using hh
  have hbound : Y₀.pCoreIn 2 ≤ (centralizer (P : Set G)).pCoreIn 2 :=
    le_pCoreIn_of_normalizes (isPGroup_pCoreIn 2 Y₀) (hkernel ▸ inf_le_right)
      (((Subgroup.centralizer_le_normalizer _).trans hNY).trans
        (normalizer_le_normalizer_characteristic_image Y₀ (pCore 2 Y₀)))
  have haction : ∃ σ : Y₀ →* MulAut P, Function.Surjective σ ∧ σ.ker = pCore 2 Y₀ ∧
      ∀ (y : Y₀) (v : P), (σ y v : G) = (y : G) * v * (y : G)⁻¹ := by
    rw [←hy]
    exact ⟨hpair.action,hpair.action_surjective,hpair.action_ker_eq_twoCore,hpair.action_apply⟩
  obtain ⟨σ,hσ,hker,hconj⟩ := haction
  let : IsKleinFour P := hpair.four
  let e : Y₀ ⧸ pCore 2 Y₀ ≃* Equiv.Perm (Fin 3) :=
    ((QuotientGroup.quotientMulEquivOfEq hker.symm).trans
      (QuotientGroup.quotientKerEquivOfSurjective σ hσ)).trans (IsKleinFour.autEquivPermThree P)
  exact ⟨c,hs,hR,hcard,hindex,hE,hfour,hplane.trans hcomm,hYn,hNY,hkernel,hproduct,hbound,
    σ,hσ,hker,hconj,⟨e⟩⟩

end CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction
