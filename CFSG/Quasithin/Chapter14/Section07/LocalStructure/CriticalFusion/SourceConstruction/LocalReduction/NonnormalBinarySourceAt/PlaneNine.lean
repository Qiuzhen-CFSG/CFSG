module

public import CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.NonnormalBinarySourceAt.PlaneEscape
public import Theory.GroupTheory.CubicNormalizerNine.Faithful
public import Theory.GroupTheory.CubicNormalizerNine.Generation
public import Theory.GroupTheory.PResidual.NormalSubgroup

/-!
# The actual cubic pair in the exchanged-component local

Keep the same critical path, reciprocal plane, Y and I₀ from the escape
construction. The lifted cubic l centralizes the plane and normalizes Y.
It lies outside Y because C_Y(P)=O₂(Y). Since Y/O₂(Y) is S₃, an invariant
Sylow three-subgroup supplies a commuting cubic y in Y; the two-group
quotient Y/Y₀ puts y in the original Y₀. Thus ⟨y,l⟩ is an actual elementary
abelian subgroup of order nine.

The original L₁ is two-perfect and generated by l and its two-core, so
its nonzero image on V_I detects l. The other cubic is detected by the
plane action. These facts prove that the same nine-group has order nine
in the literal quotient I₀/C_{I₀}(V_I). It supplements L₁T to I₀ and its
image cannot normalize L₁⁺, by the established non-subnormality of L₁⁺.

This discharges the cubic-pair construction and its exact quotient and
generation clauses in the proof of 14.7.32. Thompson movement, small-factor
selection and the final contradiction remain open, as do the guarded
specialization and later reductions through 14.7.52. No recognition or
fixed-cubic premise is added.

Source: Aschbacher–Smith, proof of 14.7.32, printed pp.1058–1059,
refs/quasithin.pdf.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction
open Chapter12.Section08 CriticalFusion.Source
open Chapter13.Section08.TransvectionRecognition.Component.ModelExtension
open Chapter13.Section08.Components Swapped Swapped.LinearTwo ModuleAlternatives
open Chapter15.Section03.AbelianAmalgam
open Chapter14.Section04.LargerDimension.LocalAction.Components
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  {F : InvariantFlag T V 3}

/-- The same constructed local contains an actual elementary nine-group,
faithful in its plus quotient, supplementing L₁T, and not normalizing L₁⁺. -/
theorem local_nonnormal_component_weakClosure_nine_at
    (d : Counterexample T L)
    (h : HigherRankHypothesis KnownSimple.IsKnownSimple T L V 3)
    (hab : IsMulCommutative F.U)
    (structural : Chapter12.Section02.Structural1222At KnownSimple.IsKnownSimple T)
    (previous : Chapter12.Section02.Theorem12213At KnownSimple.IsKnownSimple T)
    (faithful : EarlierFaithfulClassification G (T : Subgroup G))
    (earlier : ResidualNormalizer.LocalControl.Earlier14710.{u})
    (I K : Subgroup G) (hI : I ∈ F.Hz L (normalizer (L : Set G)))
    (hKI : K ≤ I) (hK : (K.subgroupOf I).IsCComponent)
    (hnormal : ¬ (K.subgroupOf I).Normal) :
    ∃ c : CriticalPath (L := L) F, c.RankSelection ∧ c.Uα ≤ F.Ri L 1 ∧
      Nat.card (star F c.Uα) = 2 ∧
      let P := F.Vi 1 ⊔ c.Zα
      let J := F.Li L 1 ⊔ (T : Subgroup G)
      let R := F.H.pCoreIn 2 ⊔ conjugateSpanBy c.Uα J
      let Y := (F.H.pCoreIn 2 ⊔ c.Qα) ⊔ R
      let I₀ := J ⊔ Y
      let W₀ := ChapterE.indexedWeakClosure V R 0
      IsElementaryAbelian 2 P ∧ Nat.card P = 4 ∧ P ≤ F.U ⊓ c.Uα ∧
      R ≤ (T : Subgroup G) ∧ J ≤ normalizer (R : Set G) ∧
      R ≤ normalizer (P : Set G) ∧ Chapter1.IsSylowIn 2 R Y ∧
      Y ⊓ centralizer (P : Set G) = Y.pCoreIn 2 ∧
      Nonempty (Y ⧸ pCore 2 Y ≃* Equiv.Perm (Fin 3)) ∧
      V ≤ W₀ ∧ W₀ ≤ R ∧ I₀ ≤ normalizer (W₀ : Set G) ∧
      IsTwoLocal (normalizer (W₀ : Set G)) ∧ normalizer (W₀ : Set G) ≠ ⊤ ∧
      I₀ = J ⊔ c.Qα ∧ HasCharacteristicTwo I₀ ∧
      IsSQTK KnownSimple.IsKnownSimple I₀ ∧
      IsPReduced 2 ((conjugateSpanBy (F.Vi 1) I₀).subgroupOf I₀) ∧
      P ≤ conjugateSpanBy (F.Vi 1) I₀ ∧ conjugateSpanBy (F.Vi 1) I₀ ≤ W₀ ∧
      letI : ((conjugateSpanBy (F.Vi 1) I₀).subgroupOf I₀).Normal :=
        normal_subgroupOf_of_le_normalizer (le_normalizer_conjugateSpanBy _ _)
      let q := QuotientGroup.mk'
        (centralizer ((conjugateSpanBy (F.Vi 1) I₀).subgroupOf I₀ : Set I₀))
      ¬ (((F.Li L 1).subgroupOf I₀).map q).IsSubnormal ∧
        ((F.Li L 1).subgroupOf I₀).map q ≠ ⊥ ∧
        ¬ F.H.pCoreIn 2 ⊔ c.Qα ≤ normalizer (F.Li L 1 : Set G) ∧
        ¬ F.H.pCoreIn 2 ⊔ c.Qα ≤ normalizer (L : Set G) ∧
        Y ≤ normalizer ((pResidual 2 (F.Li L 1 ⊓ centralizer (P : Set G) : Subgroup G)).map
          (F.Li L 1 ⊓ centralizer (P : Set G)).subtype : Set G) ∧
        let RY := (pResidual 2 (F.Li L 1 ⊓ centralizer (P : Set G) : Subgroup G)).map
          (F.Li L 1 ⊓ centralizer (P : Set G)).subtype
        RY ⊔ (F.Li L 1).pCoreIn 2=F.Li L 1 ∧
          ∃ l : F.H, (l:G) ∈ RY ∧ orderOf (l:G)=3 ∧
            zpowers (l:G) ⊔ (F.Li L 1).pCoreIn 2=F.Li L 1 ∧
            ∃ y ∈ F.H.pCoreIn 2 ⊔ c.Qα, orderOf y = 3 ∧ Commute (l : G) y ∧
              IsElementaryAbelian 3 (zpowers y ⊔ zpowers (l : G) : Subgroup G) ∧
              Nat.card (zpowers y ⊔ zpowers (l : G) : Subgroup G) = 9 ∧
              Nat.card (((zpowers y ⊔ zpowers (l : G)).subgroupOf I₀).map q) = 9 ∧
              J ⊔ (zpowers y ⊔ zpowers (l : G)) = I₀ ∧
              ¬ ((zpowers y ⊔ zpowers (l : G)).subgroupOf I₀).map q ≤
                normalizer (((F.Li L 1).subgroupOf I₀).map q : Set _) := by
  obtain ⟨c,hs,hR,ha,hE,hfour,hplane,hRT,hJR,hRN,hSylow,hcore,he,hVW,hWR,hIW,
    hlocal,hproper,hIeq,hcharI,hsqtk,hred,hPVI,hVIW,hsub,hne,hYn,hescape,hres,hgen,l,hl,hl3,hlgen⟩ :=
    local_nonnormal_component_weakClosure_escape_at d h hab structural previous
      faithful earlier I K hI hKI hK hnormal
  let P := F.Vi 1 ⊔ c.Zα
  let J := F.Li L 1 ⊔ (T : Subgroup G)
  let R := F.H.pCoreIn 2 ⊔ conjugateSpanBy c.Uα J
  let Y₀ := F.H.pCoreIn 2 ⊔ c.Qα
  let Y := Y₀ ⊔ R
  obtain ⟨hY₀P,hNY⟩ := local_nonnormal_component_selected_plane_normalizers_at
    d h hab structural previous faithful earlier I K hI hKI hK hnormal c hs ha hE hfour
  have hlC : (l : G) ∈ F.Li L 1 ⊓ centralizer (P : Set G) := map_subtype_le _ hl
  have hCP : F.Li L 1 ⊓ centralizer (P : Set G) ≤ normalizer (P : Set G) :=
    inf_le_right.trans (Subgroup.centralizer_le_normalizer _)
  have hCY : F.Li L 1 ⊓ centralizer (P : Set G) ≤ normalizer (Y : Set G) :=
    (le_inf (hCP.trans hNY) (inf_le_left.trans (le_sup_left.trans hJR))).trans
      (normalizer_inf_normalizer_le_normalizer_sup _ _)
  have hlnot : (l : G) ∉ Y := by
    intro hlY
    have hc : (l : G) ∈ Y.pCoreIn 2 := hcore ▸ ⟨hlY,hlC.2⟩
    have hh := (isPGroup_pCoreIn 2 Y).orderOf_coprime
      (by decide : Nat.Coprime 2 3) ⟨l,hc⟩
    rw [Subgroup.orderOf_mk,hl3] at hh
    norm_num at hh
  have hcY : Nat.card (Y ⧸ pCore 2 Y) = 6 := by
    obtain ⟨e⟩ := he
    rw [Nat.card_congr e.toEquiv,Nat.card_eq_fintype_card,Fintype.card_perm,Fintype.card_fin]
    rfl
  obtain ⟨y,hy,hy3,hly,hE9,hcard⟩ :=
    exists_elementary_nine_of_normalizing_cubic_of_quotient_six Y hcY l hl3 hlnot (hCY hlC)
  have hYY₀ : Y ≤ normalizer (Y₀ : Set G) := (sup_le hY₀P hRN).trans hNY
  let : (Y₀.subgroupOf Y).Normal := normal_subgroupOf_of_le_normalizer hYY₀
  have hquot : IsPGroup 2 (Y ⧸ Y₀.subgroupOf Y) := by
    apply isPGroup_quotient_of_sup_eq_top (Y₀.subgroupOf Y) (R.subgroupOf Y)
      (T.isPGroup'.to_le hRT).comap_subtype
    apply map_injective Y.subtype_injective
    rw [Subgroup.map_sup,map_subgroupOf_eq_of_le (show Y₀ ≤ Y from le_sup_left),
      map_subgroupOf_eq_of_le (show R ≤ Y from le_sup_right),
      ←MonoidHom.range_eq_map,range_subtype]
  have hy₀ : y ∈ Y₀ := by
    let yY : Y := ⟨y,hy⟩
    have hyY3 : orderOf yY = 3 := (Y.orderOf_coe yY).symm.trans hy3
    have hyres : yY ∈ pResidual 2 Y := mem_pResidual_of_orderOf_coprime
      (by rw [hyY3]; decide)
    exact (show pResidual 2 Y ≤ Y₀.subgroupOf Y from sInf_le ⟨inferInstance,hquot⟩) hyres
  let I₀ := J ⊔ Y
  let W := conjugateSpanBy (F.Vi 1) I₀
  let : (W.subgroupOf I₀).Normal := normal_subgroupOf_of_le_normalizer
    (le_normalizer_conjugateSpanBy _ _)
  let q := QuotientGroup.mk' (centralizer (W.subgroupOf I₀ : Set I₀))
  have hLI : F.Li L 1 ≤ I₀ := le_sup_left.trans le_sup_left
  have hYI : Y ≤ I₀ := le_sup_right
  have hWI : W ≤ I₀ := hVIW.trans (hWR.trans (hRT.trans
    (show (T : Subgroup G) ≤ I₀ from le_sup_right.trans le_sup_left)))
  have hlI : (l : G) ∈ I₀ := hLI hlC.1
  let lI : I₀ := ⟨l,hlI⟩
  let yI : I₀ := ⟨y,hYI hy⟩
  let A := (F.Li L 1).subgroupOf I₀
  have hpow : (zpowers (l : G)).subgroupOf I₀ = zpowers lI := by
    apply map_injective I₀.subtype_injective
    rw [map_subgroupOf_eq_of_le (zpowers_le.mpr hlI),MonoidHom.map_zpowers]
    rfl
  have hgenA : zpowers lI ⊔ A.pCoreIn 2 = A := by
    rw [show A = (F.Li L 1).subgroupOf I₀ from rfl,
      pCoreIn_subgroupOf 2 _ I₀ hLI,←hpow,
      ←subgroupOf_sup (zpowers_le.mpr hlI) ((pCoreIn_le 2 _).trans hLI),hlgen]
  have hpA : IsPPerfect 2 A :=
    (show IsPPerfect 2 (F.Li L 1) from isPPerfect_embedded_pResidual 2 _).of_surjective
      (subgroupOfEquivOfLe hLI).symm.toMonoidHom (subgroupOfEquivOfLe hLI).symm.surjective
  have hql : q lI ≠ 1 := cubic_image_ne_one_of_twoPerfect q A hpA lI hgenA hne
  let C := (centralizer (P : Set G)).subgroupOf I₀
  have hker : q.ker ≤ C := by
    rw [QuotientGroup.ker_mk']
    intro x hx p hp
    exact congrArg Subtype.val (hx ⟨p,(hPVI.trans hWI) hp⟩ (hPVI hp))
  have hYC : IsPGroup 2 (Y.subgroupOf I₀ ⊓ C : Subgroup I₀) := by
    change IsPGroup 2 ((Y ⊓ centralizer (P : Set G)).subgroupOf I₀)
    rw [hcore]
    exact (isPGroup_pCoreIn 2 Y).comap_subtype
  have hi := injective_on_cubic_pair_of_twoGroup_intersection q (Y.subgroupOf I₀) C
    hker hYC lI yI ((I₀.orderOf_coe lI).symm.trans hl3)
    ((I₀.orderOf_coe yI).symm.trans hy3) hlC.2 hy
    (Subtype.ext hly) hql
  have hpowy : (zpowers y).subgroupOf I₀ = zpowers yI := by
    apply map_injective I₀.subtype_injective
    rw [map_subgroupOf_eq_of_le (zpowers_le.mpr (hYI hy)),MonoidHom.map_zpowers]
    rfl
  let E := zpowers y ⊔ zpowers (l : G)
  have hEI : E ≤ I₀ := sup_le (zpowers_le.mpr (hYI hy)) (zpowers_le.mpr hlI)
  have hEsub : E.subgroupOf I₀ = zpowers yI ⊔ zpowers lI := by
    rw [show E = zpowers y ⊔ zpowers (l : G) from rfl,
      subgroupOf_sup (zpowers_le.mpr (hYI hy)) (zpowers_le.mpr hlI),hpowy,hpow]
  have hplus : Nat.card ((E.subgroupOf I₀).map q) = 9 := by
    have hEq : Nat.card ((E.subgroupOf I₀).map q) = Nat.card (E.subgroupOf I₀) := by
      rw [hEsub]
      exact Nat.card_congr (MulEquiv.ofBijective (q.subgroupMap _) ⟨by
        intro a b hab
        exact hi (congrArg Subtype.val hab),q.subgroupMap_surjective _⟩).toEquiv.symm
    rw [hEq,Nat.card_congr (subgroupOfEquivOfLe hEI).toEquiv]
    exact hcard
  have hYgen : R ⊔ zpowers y = Y := by
    obtain ⟨S,hS⟩ := hSylow
    have hh := S.sup_cubic_eq_top_of_twoCore_quotient_six hcY (⟨y,hy⟩ : Y)
      ((Y.orderOf_coe ⟨y,hy⟩).symm.trans hy3)
    have hm := congrArg (Subgroup.map Y.subtype) hh
    have hS' : (S : Subgroup Y).map Y.subtype = R := hS
    rw [Subgroup.map_sup,MonoidHom.map_zpowers,←MonoidHom.range_eq_map,range_subtype,hS'] at hm
    exact hm
  have hIgen : J ⊔ E = I₀ := by
    apply le_antisymm (sup_le le_sup_left hEI)
    apply sup_le le_sup_left
    rw [←hYgen]
    exact sup_le (hRT.trans (le_sup_right.trans le_sup_left))
      (le_sup_left.trans le_sup_right)
  have hJLI : J ≤ normalizer (F.Li L 1 : Set G) :=
    sup_le (F.Li L 1).le_normalizer (ResidualNormalizer.T_normalizes_Li (h.sylow_normalizes_at structural))
  have hJn : J.subgroupOf I₀ ≤ normalizer (A : Set I₀) := by
    rw [show A = (F.Li L 1).subgroupOf I₀ from rfl,←subgroupOf_normalizer_eq hLI]
    exact subgroupOf_mono _ hJLI
  have hplusNot : ¬ (E.subgroupOf I₀).map q ≤ normalizer (A.map q : Set _) := by
    intro hEP
    have hgenq : (J.subgroupOf I₀).map q ⊔ (E.subgroupOf I₀).map q = ⊤ := by
      rw [←Subgroup.map_sup,←subgroupOf_sup (show J ≤ I₀ from le_sup_left) hEI,
        hIgen,subgroupOf_self,map_top_of_surjective q (QuotientGroup.mk'_surjective _)]
    have hn : (A.map q).Normal := normalizer_eq_top_iff.mp (top_unique (hgenq ▸
      sup_le ((map_mono hJn).trans (A.le_normalizer_map q)) hEP))
    exact hsub hn.isSubnormal
  exact ⟨c,hs,hR,ha,hE,hfour,hplane,hRT,hJR,hRN,hSylow,hcore,he,hVW,hWR,hIW,
    hlocal,hproper,hIeq,hcharI,hsqtk,hred,hPVI,hVIW,hsub,hne,hYn,hescape,hres,hgen,
    l,hl,hl3,hlgen,y,hy₀,hy3,hly,hE9,hcard,hplus,hIgen,hplusNot⟩

end CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction
