module
public import CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.OriginalComponentStatement.BinaryThreeContainment.Module
public import CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.OriginalComponentStatement.OutsideReduction

/-!
# The original point lies in each binary linear-three component

Reduce the original local to the subgroup generated by the same component,
the point residual, and the original Sylow. Normality and the component's
intrinsic two-core quotient are preserved by the established reduction.
The outside binary linear-three module configuration is impossible there,
so the point lies in the original component.

This is the binary L₃(2) containment case of 14.7.47. The statement retains
the established universal structural and preceding-theorem interfaces used
by the normal-component reduction; the reduced-local theorem itself uses
only their same-group versions. No 14.7.47 conclusion is an input.
Source: Aschbacher–Smith, 14.7.47, printed pp.1062–1063, refs/quasithin.pdf.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.OriginalComponentStatement
open Chapter12.Section08 CriticalFusion.Source
open Chapter13.Section08.TransvectionRecognition.Component.ModelExtension
open Chapter14.Section04.LargerDimension.LocalAction.Components
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  {F : InvariantFlag T V 3}

/-- The original point residual lies in every actual binary linear-three
component, without additional normality or generation assumptions. -/
theorem local_binaryThree_component_contains_point
    (d : Counterexample T L)
    (h : HigherRankHypothesis KnownSimple.IsKnownSimple T L V 3)
    (hab : IsMulCommutative F.U)
    (structural : Chapter12.Section02.Structural1222 KnownSimple.IsKnownSimple.{u})
    (previous : Chapter12.Section02.Theorem12213 KnownSimple.IsKnownSimple.{u})
    (faithful : EarlierFaithfulClassification G (T : Subgroup G))
    (earlier : ResidualNormalizer.LocalControl.Earlier14710.{u})
    (I : Subgroup G) (hI : I ∈ F.Hz L (normalizer (L : Set G)))
    (C : Subgroup I) (hC : C.IsCComponent)
    (e : (C ⧸ pCore 2 C) ≃* Matrix.PSL3Two.PSL) :
    F.Li L 1 ≤ C.map I.subtype := by
  by_contra hout
  obtain ⟨J,_,hJ,CJ,hCJ,hn,_,hgen,houtJ,_,_,⟨eQ⟩⟩ :=
    local_outside_component_reduction d h hab structural previous faithful earlier I hI C hC hout
  let : CJ.Normal := hn
  exact houtJ (BinaryThreeContainment.reduced_containment_at d h hab (structural.at T)
    (previous.at T) faithful earlier J hJ CJ hCJ hgen (eQ.symm.trans e))

end CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.OriginalComponentStatement
