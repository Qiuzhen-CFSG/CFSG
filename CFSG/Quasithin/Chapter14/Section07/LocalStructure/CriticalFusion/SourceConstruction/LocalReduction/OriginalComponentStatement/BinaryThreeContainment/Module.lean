/-!
# The outside binary linear-three component on the actual local section

If the point residual lies outside a binary linear-three component, its
image is a commuting normal cubic subgroup. The original Sylow contains
an outer component actor, so the full local conjugation image is Aut(L₃(2)).
The actual section is generated by the cubic subgroup and has quadratic
ratio at most two. The proved chief-factor pairing and outer-actor bound
then contradict the strict Steinberg and natural-dual fixed-codimension
bounds. Every structural and representation input is constructed on this
same reduced local.

Source: Aschbacher–Smith, 14.7.47, printed pp.1062–1063, refs/quasithin.pdf.
The paired-module argument reuses the proved representation exclusion
from 13.8.21 and the binary linear-three bounds from B.4.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.OriginalComponentStatement.BinaryThreeContainment
open Chapter12.Section08 CriticalFusion.Source
open Chapter13.Section08.TransvectionRecognition.Component.ModelExtension
open Chapter14.Section04.LargerDimension.LocalAction.Components
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  {F : InvariantFlag T V 3}

private theorem steinberg_bound (A : Subgroup BinaryLinearThree.Group)
    (hA : IsElementaryTwo A) : rank A < fixedCodim BinaryLinearThree.S A := by
  by_contra! hb
  let : IsIrreducible BinaryLinearThree.S := BinaryLinearThree.IrreducibleCatalogue.steinberg_irreducible
  have hne : BinaryLinearThree.S ≠ 1 := by
    intro he
    have hi : Function.Injective (1 : Representation (ZMod 2) BinaryLinearThree.Group BinaryLinearThree.Steinberg) :=
      he ▸ BinaryLinearThree.steinberg_injective
    have : Subsingleton BinaryLinearThree.Group := ⟨fun a b => hi (by rfl)⟩
    have hc : Nat.card BinaryLinearThree.Group = 1 :=
      Nat.card_eq_one_iff_unique.mpr ⟨this,inferInstance⟩
    rw [Matrix.PSL3Two.card_SL] at hc
    omega
  have hd := BinaryLinearThree.ResidualFFForms.ConstituentBudget.finrank_le_six_of_irreducible
    BinaryLinearThree.S hne ⟨A,hA,hb⟩
  rw [BinaryLinearThree.finrank_steinberg] at hd
  omega

/-- The original point is contained in a binary linear-three component of
its literal reduced local, using only the same-group earlier hypotheses. -/
theorem reduced_containment_at
    (d : Counterexample T L)
    (h : HigherRankHypothesis KnownSimple.IsKnownSimple T L V 3)
    (hab : IsMulCommutative F.U)
    (structural : Chapter12.Section02.Structural1222At KnownSimple.IsKnownSimple T)
    (previous : Chapter12.Section02.Theorem12213At KnownSimple.IsKnownSimple T)
    (faithful : EarlierFaithfulClassification G (T : Subgroup G))
    (earlier : ResidualNormalizer.LocalControl.Earlier14710.{u})
    (I : Subgroup G) (hI : I ∈ F.Hz L (normalizer (L : Set G)))
    (C : Subgroup I) [C.Normal] (hC : C.IsCComponent)
    (hgen : I = C.map I.subtype ⊔ F.Li L 1 ⊔ (T : Subgroup G))
    (e : (C ⧸ pCore 2 C) ≃* Matrix.PSL3Two.PSL) :
    F.Li L 1 ≤ C.map I.subtype := by
  by_contra hout
  let q := QuotientGroup.mk' (pCore 2 I)
  let K := C.map q
  let X := ((F.Li L 1).subgroupOf I).map q
  let ec := cComponentTwoCoreQuotientEquiv hC
  let eSL := e.trans Matrix.PSL3Two.equiv.symm
  let eK : K ≃* BinaryLinearThree.Group := ec.symm.trans eSL
  have hz : center (C ⧸ pCore 2 C) = ⊥ := by
    apply bot_unique
    intro z hz
    have hh := (centerCongr eSL ⟨z,hz⟩).property
    change eSL z ∈ center Matrix.PSL3Two.SL at hh
    rw [Matrix.PSL3Two.center_eq_bot,mem_bot] at hh
    exact eSL.map_eq_one_iff.mp hh
  obtain ⟨_,hn⟩ := local_outside_action_trivial_at h structural I hI C hout e
  obtain ⟨hAn,hKn,hXn,hK,hcard,hcomm,hdis,hF,_⟩ :=
    OutsideActors.local_structure_at d h hab structural previous faithful earlier I hI C hC hgen hn hz
  let := hAn
  let := hKn
  let := hXn
  obtain ⟨t,_,ht⟩ := local_outside_outer_at d h hab structural previous faithful earlier I hI C hC hout e
  have hsurj := full_action C eSL t ht
  have hfull : Function.Surjective (MulAut.conjNormal : HStar I →* MulAut K) := by
    intro α
    obtain ⟨x,hx⟩ := hsurj ((MulAut.congr ec).symm α)
    refine ⟨q x,?_⟩
    rw [←Theory.GroupTheory.CComponentPrimeRank.twoCoreQuotientAction_compatible C hC x,hx]
    exact (MulAut.congr ec).apply_symm_apply α
  have hIgen : C ⊔ (F.Li L 1 ⊔ (T : Subgroup G)).subgroupOf I = ⊤ := by
    apply map_injective I.subtype_injective
    rw [Subgroup.map_sup,map_subgroupOf_eq_of_le
      (sup_le (F.Li_one_le_of_mem_Hz hI) (F.sylow_le_of_mem_Hz hI)),
      ←sup_assoc,←hgen,←MonoidHom.range_eq_map,range_subtype]
  have hQgen : K ⊔ ((F.Li L 1 ⊔ (T : Subgroup G)).subgroupOf I).map q = ⊤ := by
    rw [←Subgroup.map_sup,hIgen,map_top_of_surjective q (QuotientGroup.mk'_surjective _)]
  obtain ⟨hU,a,hq,_⟩ := WholeResidualAssembly.GuardedSource.local_prime_supplement_quadratic_actor
    h hab structural previous I hI K hQgen
  let := hU
  have hmove := OutsideActors.local_point_movement_at h I (F.Li_one_le_of_mem_Hz hI) hAn a
  have hnon : ∃ k : K, ∃ v, a.representation k v ≠ v := by
    by_contra! hzρ
    have hzero : K = ⊥ := by
      apply bot_unique
      intro k hk
      apply a.faithful
      rw [map_one]
      exact LinearMap.ext (hzρ ⟨k,hk⟩)
    exact hK.isCComponent.ne_bot hzero
  apply Chapter13.Section08.ComponentSieve.FieldComponents.LinearThree.ExternalModules.paired_configuration_exclusion
    a.representation K X eK
    ⟨hcard,hcomm,hdis,hF,hfull⟩ hmove hnon
  · intro A hA _
    exact steinberg_bound A hA
  · intro A hA _
    change rank A < fixedCodim (BinaryLinearThree.W.prod BinaryLinearThree.W.dual) A
    rw [fixedCodim_prod]
    exact BinaryLinearThree.ResidualFFForms.ConstituentBudget.rank_lt_natural_add_dual_fixedCodim A hA
  · exact hq


end CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.OriginalComponentStatement.BinaryThreeContainment
