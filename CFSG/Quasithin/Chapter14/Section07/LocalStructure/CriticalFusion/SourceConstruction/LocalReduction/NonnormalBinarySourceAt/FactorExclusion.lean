module
public import CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.NonnormalBinarySourceAt.SeedMarkings
public import CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.NonnormalBinarySourceAt.Chief
public import CFSG.Quasithin.Chapter13.Section08.LocalAnalysis.Components.Swapped.LinearTwo.ModuleAlternatives.FactorSpaces
public import Theory.Representation.BinaryConjugationSection.CommutatorImage

/-!
# Excluding split factor modules in the original exchanged branch

The original Borel marking fixes the seed and covers the point group
modulo the second component. The seed has nonzero image in every proper
quotient, is generated by point-group commutators, and is preserved by the
actual factor-exchanging Sylow element. These properties pass through the
literal quotient projection.

Restricting to the component orbit makes the two component commutator
spaces subrepresentations. If each were fixed by the opposite component,
full movement would make their sum the whole quotient. The diagonal-seed
projection theorem then gives a contradiction. No directness of this sum
or representation classification is assumed.

Source: Aschbacher–Smith, proof of 14.7.32, printed p.1057,
refs/quasithin.pdf. Orthogonal recognition, the whole-module comparison
and the subsequent weak-closure contradiction remain separate source steps.
-/

/-! This same-G,T source replay uses only Structural1222At and Theorem12213At
at the original Sylow; it does not infer universal earlier records. -/

public noncomputable section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction
open Chapter12.Section08 CriticalFusion.Source
open Chapter13.Section08.TransvectionRecognition.Component.ModelExtension
open Chapter14.Section04.LargerDimension.LocalAction.Components
open Chapter13.Section08.Components Swapped Swapped.LinearTwo ModuleAlternatives
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  {F : InvariantFlag T V 3}

/-- No proper quotient of the literal U/V₁ section has the split-factor
movement of the source module alternatives. The actual seed and Borel
centralizer residual provide every projection premise. -/
theorem local_nonnormal_component_no_cross_quotient_at
    (d : Counterexample T L)
    (h : HigherRankHypothesis KnownSimple.IsKnownSimple T L V 3)
    (hab : IsMulCommutative F.U)
    (structural : Chapter12.Section02.Structural1222At KnownSimple.IsKnownSimple T)
    (previous : Chapter12.Section02.Theorem12213At KnownSimple.IsKnownSimple T)
    (faithful : EarlierFaithfulClassification G (T : Subgroup G))
    (earlier : ResidualNormalizer.LocalControl.Earlier14710.{u})
    (I K : Subgroup G) (hI : I ∈ F.Hz L (normalizer (L : Set G)))
    (hKI : K ≤ I) (hK : (K.subgroupOf I).IsCComponent)
    (hnormal : ¬ (K.subgroupOf I).Normal)
    {W : Type u} [AddCommGroup W] [Module (ZMod 2) W]
    (σ : Representation (ZMod 2) (HStar F.H) W)
    (c : BinaryConjugationSection F.H F.U (F.Vi 1) (σ.comp (starMap F)))
    {t : G} (ht : t ∈ T) (htn : t ∉ normalizer (K : Set G)) :
    ¬ HasCrossFactorQuotient σ (Chapter13.Section08.Source.starImage F.H K)
      (Chapter13.Section08.Source.starImage F.H (K.conjBy t)) := by
  have hEq := (local_nonnormal_component_eq_full_point_at d h hab structural previous faithful earlier
    I K hI hKI hK hnormal).2.1
  subst I
  have hTH := F.sylow_le_of_mem_Hz hI
  have hi := ((Chapter1.Section02.proposition_1_2_1_three_index_knownSimple
    (local_star_sqtk h F.H hI) hK).resolve_left hnormal).1
  obtain ⟨s,hs,hsn,Z,hZN,hZV,hcosets⟩ := local_nonnormal_component_seed_cosets_at
    d h hab structural previous faithful earlier F.H K hI hKI hK hnormal
  have hst : K.conjBy s = K.conjBy t := by
    rcases SourceActions.component_permutation F.H K hKI hi (hTH hs) (hTH ht) hsn with hh | hh
    · exact (htn (mem_normalizer_iff_map_conj_eq.mpr hh.1)).elim
    · exact hh.1.symm
  rw [hst] at hcosets
  have horbit := orbit_eq_two_conjugates F.H K T hKI hTH hi ht htn
  obtain ⟨hJH,hJ⟩ := conjugate_isCComponent F.H K hKI hK (hTH ht)
  let N := Chapter13.Section08.Source.starImage F.H (conjugateSpanBy K (T : Subgroup G))
  let A := Chapter13.Section08.Source.starImage F.H K
  let B := Chapter13.Section08.Source.starImage F.H (K.conjBy t)
  let P := Chapter13.Section08.Source.starImage F.H (F.Li L 1)
  let Zs := Chapter13.Section08.Source.starImage F.H Z
  have hAB : A ⊔ B = N := by
    rw [show N = Chapter13.Section08.Source.starImage F.H (K ⊔ K.conjBy t) from
      congrArg (Chapter13.Section08.Source.starImage F.H) horbit,starImage_sup F.H K _ hKI hJH]
  have hAN : A ≤ N := hAB ▸ le_sup_left
  have hBN : B ≤ N := hAB ▸ le_sup_right
  have hZsN : Zs ≤ N := map_mono (subgroupOf_mono F.H hZN)
  have hPN : P ≤ N := map_mono (subgroupOf_mono F.H
    (local_nonnormal_component_point_le_orbit_at d h hab structural previous faithful earlier
      F.H K hI hKI hK hnormal))
  have hAc := starImage_isCComponent F.H K hK
  have hBc := starImage_isCComponent F.H (K.conjBy t) hJ
  let : (A.subgroupOf N).Normal := normal_subgroupOf_of_le_normalizer (by
    rw [←hAB]
    exact sup_le A.le_normalizer ((le_cComponentLayer hBc).trans (cComponentLayer_le_normalizer hAc)))
  let : (B.subgroupOf N).Normal := normal_subgroupOf_of_le_normalizer (by
    rw [←hAB]
    exact sup_le ((le_cComponentLayer hAc).trans (cComponentLayer_le_normalizer hBc)) B.le_normalizer)
  let ts := starMap F ⟨t,hTH ht⟩
  have hswap : B.conjBy ts = A := by
    have ht2 := (normalizer (K.subgroupOf F.H : Set F.H)).sq_mem_of_index_two hi ⟨t,hTH ht⟩
    rw [←subgroupOf_normalizer_eq hKI] at ht2
    change t ^ 2 ∈ normalizer (K : Set G) at ht2
    have he : (K.conjBy t).conjBy t = K := by
      rw [←conjBy_mul]
      exact mem_normalizer_iff_map_conj_eq.mp (by simpa only [pow_two] using ht2)
    change (Chapter13.Section08.Source.starImage F.H (K.conjBy t)).map
      (MulAut.conj (QuotientGroup.mk' (pCore 2 F.H) ⟨t,hTH ht⟩)).toMonoidHom = A
    rw [starImage_conjBy F.H _ hJH (hTH ht),he]
  let X := c.imageSpace V
  have hXgen : subspaceCommutator σ X P = X := by
    change subspaceCommutator σ X (((F.Li L 1).subgroupOf F.H).map (starMap F)) = X
    rw [←subspaceCommutator_comp_map,←c.imageSpace_commutator (F.Li L 1) V
      ((F.Li_le L 1).trans inf_le_right) (le_conjugateSpanBy V F.H),commutator_comm,
      ←seed_commutator h F]
  have hXfix : X ≤ fixedSpace σ Zs := by
    intro w hw z
    obtain ⟨a,ha,he⟩ := z.property
    change σ (z : HStar F.H) w = w
    rw [←he]
    exact c.fixed_on_imageSpace_of_commutator_le Z V
      ((commutator_eq_bot_iff_le_centralizer.mpr hZV).le.trans bot_le) a ha w hw
  have hXstable : X.map (operator σ ts).toLinearMap = X := by
    apply le_antisymm
    · rintro _ ⟨w,hw,rfl⟩
      exact c.imageSpace_apply_mem V ⟨t,hTH ht⟩ (h.sylow_normalizes_seed_at structural ht) w hw
    · intro w hw
      refine ⟨σ ts⁻¹ w,?_,σ.self_inv_apply ts w⟩
      exact c.imageSpace_apply_mem V (⟨t,hTH ht⟩ : F.H)⁻¹
        (h.sylow_normalizes_seed_at structural ((T : Subgroup G).inv_mem ht)) w hw
  rintro ⟨Q,hQ,hcrossA,hcrossB⟩
  let ρ := Q.quotientRepresentation
  let τ := ρ.comp N.subtype
  have hc (Y : Submodule (ZMod 2) (W ⧸ Q.toSubmodule)) (C : Subgroup (HStar F.H)) (hCN : C ≤ N) :
      subspaceCommutator τ Y (C.subgroupOf N) = subspaceCommutator ρ Y C := by
    rw [subspaceCommutator_comp_map,map_subgroupOf_eq_of_le hCN]
  have hf (C : Subgroup (HStar F.H)) (hCN : C ≤ N) :
      fixedSpace τ (C.subgroupOf N) = fixedSpace ρ C := by
    ext w
    exact ⟨fun hw c => hw ⟨⟨c,hCN c.property⟩,c.property⟩,fun hw c => hw ⟨c,c.property⟩⟩
  have hrel : A.subgroupOf N ⊔ B.subgroupOf N = ⊤ := by
    rw [←subgroupOf_sup hAN hBN,hAB,subgroupOf_self]
  have hfull : subspaceCommutator τ ⊤ ⊤ = ⊤ := by
    rw [subspaceCommutator_comp_map,←MonoidHom.range_eq_map,range_subtype]
    have hm := quotient_seed_commutator σ Q ⊤ N
      (local_nonnormal_component_star_moved_at d h hab structural previous faithful earlier
        F.H K hI hKI hK hnormal σ c)
    simpa only [Submodule.map_top,Submodule.range_mkQ] using hm
  have hXne : X.map Q.toSubmodule.mkQ ≠ ⊥ := by
    intro hz
    have hVP : V ≤ F.Vi 1 := by
      intro v hv
      let vU : F.U := ⟨v,le_conjugateSpanBy V F.H hv⟩
      have hm : Q.toSubmodule.mkQ (c.coordinates vU).toAdd = 0 := by
        have hh : Q.toSubmodule.mkQ (c.coordinates vU).toAdd ∈ X.map Q.toSubmodule.mkQ :=
          Submodule.mem_map_of_mem ((c.mem_imageSpace_iff V _).mpr ⟨vU,hv,rfl⟩)
        simpa only [hz,Submodule.mem_bot] using hh
      apply (seed_intersection h c Q.toSubmodule
        (fun g w hw => Q.apply_mem_toSubmodule (starMap F g) hw)
        (fun he => hQ (Subrepresentation.toSubmodule_injective he)) vU hv).mp
      exact (Submodule.Quotient.mk_eq_zero Q.toSubmodule).mp hm
    have hc := card_le_of_le hVP
    have hV : Nat.card V = 8 := by simpa only [F.last,Nat.reducePow] using F.card 3 (by decide)
    have hP : Nat.card (F.Vi 1) = 2 := by simpa using F.card 1 (by decide)
    omega
  apply not_sum_of_diagonal_seed τ (movedSubrepresentation τ (A.subgroupOf N))
    (movedSubrepresentation τ (B.subgroupOf N)) (X.map Q.toSubmodule.mkQ)
    (A.subgroupOf N) (B.subgroupOf N) (Zs.subgroupOf N) (P.subgroupOf N)
    (operator ρ ts) (factor_spaces_sum τ _ _ hrel hfull) hXne
  · rw [hc _ P hPN]
    exact quotient_seed_commutator σ Q X P hXgen
  · rw [hrel]; exact le_top
  · change subspaceCommutator τ ⊤ (B.subgroupOf N) ≤ fixedSpace τ (A.subgroupOf N)
    rw [hc _ B hBN,hf A hAN]
    exact hcrossB
  · change subspaceCommutator τ ⊤ (A.subgroupOf N) ≤ fixedSpace τ (B.subgroupOf N)
    rw [hc _ A hAN,hf B hBN]
    exact hcrossA
  · exact quotient_seed_swap σ Q X ts hXstable
  · change (subspaceCommutator τ ⊤ (B.subgroupOf N)).map (operator ρ ts).toLinearMap ≤
      subspaceCommutator τ ⊤ (A.subgroupOf N)
    rw [hc _ B hBN,hc _ A hAN,moved_map_automorphism ρ (MulAut.conj ts) (operator ρ ts) ?_ B]
    · change subspaceCommutator ρ ⊤ (B.conjBy ts) ≤ subspaceCommutator ρ ⊤ A
      rw [hswap]
    · intro g w
      change ρ ts (ρ g w) = ρ (ts*g*ts⁻¹) (ρ ts w)
      simp only [map_mul,Module.End.mul_apply,inv_self_apply]
  · rw [←subgroupOf_sup hZsN hBN]
    exact subgroupOf_mono N hcosets
  · rw [hf Zs hZsN]
    exact quotient_seed_fixed σ Q X Zs hXfix

end CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction
