module
public import CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.WholeResidualAssembly.At.Source.SolvableConclusion
public import CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.ComponentEscapeAt

/-!
# Transport of the actual outside component to its reduced local

An arbitrary original local with a normal component can be replaced by the subgroup generated by
the same ambient component, the point residual, and the original Sylow.
Only the original group and Sylow structural facts are used.
The component remains normal and retains its intrinsic two-core quotient.
Exact equality of the ambient component images preserves the outside
condition and allows a reduced-local conclusion to return to the original
component.
Source: Aschbacher–Smith, 14.7.32,40–43, printed pp.1056–1062,
refs/quasithin.pdf.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.OriginalComponentStatement
open Chapter12.Section08 CriticalFusion.Source
open Chapter13.Section08.TransvectionRecognition.Component.ModelExtension
open Chapter14.Section04.LargerDimension.LocalAction.Components
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  {F : InvariantFlag T V 3}

/-- Reduce an arbitrary original outside component while keeping its exact
ambient image and its intrinsic two-core quotient. -/
theorem local_outside_normal_component_reduction_at
    (h : HigherRankHypothesis KnownSimple.IsKnownSimple T L V 3)
    (structural : Chapter12.Section02.Structural1222At KnownSimple.IsKnownSimple T)
    (I : Subgroup G) (hI : I ∈ F.Hz L (normalizer (L : Set G)))
    (C : Subgroup I) [C.Normal] (hC : C.IsCComponent)
    (hout : ¬ F.Li L 1 ≤ C.map I.subtype) :
    ∃ J : Subgroup G, J ≤ I ∧ J ∈ F.Hz L (normalizer (L : Set G)) ∧
      ∃ CJ : Subgroup J, CJ.IsCComponent ∧ CJ.Normal ∧
        CJ.map J.subtype = C.map I.subtype ∧
        J = CJ.map J.subtype ⊔ F.Li L 1 ⊔ (T : Subgroup G) ∧
        (¬ F.Li L 1 ≤ CJ.map J.subtype) ∧
        ∃ e : C ≃* CJ, (∀ c : C, ((e c : J) : G) = ((c : I) : G)) ∧
          Nonempty ((C ⧸ pCore 2 C) ≃* (CJ ⧸ pCore 2 CJ)) := by
  let K := C.map I.subtype
  have hK : (K.subgroupOf I).IsCComponent := by
    simpa only [K,subgroupOf,comap_map_eq_self_of_injective I.subtype_injective] using hC
  let J := K ⊔ (F.Li L 1 ⊔ (T : Subgroup G))
  let CJ := K.subgroupOf J
  have hKI : K ≤ I := map_subtype_le C
  have hKN : (K.subgroupOf I).Normal := by
    simpa only [K,subgroupOf,comap_map_eq_self_of_injective I.subtype_injective] using
      (inferInstance : C.Normal)
  have hIN : I ≤ normalizer (K : Set G) :=
    (normal_subgroupOf_iff_le_normalizer hKI).mp hKN
  have hspan : conjugateSpanBy K (T : Subgroup G) = K :=
    le_antisymm (conjugateSpanBy_le le_rfl ((F.sylow_le_of_mem_Hz hI).trans hIN))
      (le_conjugateSpanBy K (T : Subgroup G))
  obtain ⟨_,hJI,hJ⟩ := local_component_reduced_mem_Hz_at
    h structural I hI C hC
  change conjugateSpanBy K (T : Subgroup G) ⊔ (F.Li L 1 ⊔ (T : Subgroup G)) ≤ I at hJI
  change conjugateSpanBy K (T : Subgroup G) ⊔ (F.Li L 1 ⊔ (T : Subgroup G)) ∈
    F.Hz L (normalizer (L : Set G)) at hJ
  rw [hspan] at hJI hJ
  have hCJ : CJ.IsCComponent := hK.subgroupOf_of_le le_sup_left hJI
  have hn : CJ.Normal := normal_subgroupOf_of_le_normalizer (hJI.trans hIN)
  have hKJ : K ≤ J := le_sup_left
  have hambient : CJ.map J.subtype = C.map I.subtype :=
    map_subgroupOf_eq_of_le hKJ
  let e : C ≃* CJ := (equivMapOfInjective C I.subtype I.subtype_injective).trans
    (subgroupOfEquivOfLe hKJ).symm
  refine ⟨J,hJI,hJ,CJ,hCJ,hn,hambient,?_,?_,e,?_,?_⟩
  · rw [hambient,sup_assoc]
  · rwa [hambient]
  · intro c
    rfl
  · exact ⟨QuotientGroup.congr _ _ e (pCore_map_iso 2 e)⟩

end CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.OriginalComponentStatement
