module
public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.ExternalModules.Structure.Centralizer
public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.LinearThree.Geometry.CoveredProduct.ResidualPlacement.QuotientActions
public import Theory.GroupTheory.CComponent.NormalQuotientActionKernel

/-!
# The actual symmetric-three subgroup supplied by an outside inverter

The original inverter centralizes the intrinsic component quotient and
inverts the intrinsic point quotient. Their literal images in the local
two-core quotient retain these actions. The component centralizer then
contains an actual symmetric-three subgroup whose alternating subgroup is
the point image. No splitting or chosen complement to the two-core is
assumed.
Source: Aschbacher–Smith 14.7.41–42, printed pp.1061–1062.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.OriginalComponentStatement
open Chapter13.Section08
open ComponentSieve.FieldComponents.HigherFieldReduction.ExternalModules
open ComponentSieve.FieldComponents.LinearThree.Geometry.CoveredProduct.ResidualPlacement
universe u
variable {G : Type u} [Group G] [Finite G]

/-- The original intrinsic quotient actions give the corresponding literal
centralizer and inversion statements in the local two-core quotient. -/
theorem outside_inverter_star
    (I : Subgroup G) (C : Subgroup I) [C.Normal] (hC : C.IsCComponent)
    (X : Subgroup G) (hXI : X ≤ I) [(X.subgroupOf I).Normal]
    (s : I) (hsX : (s : G) ∈ normalizer (X : Set G))
    (hsC : normalQuotientAction C (pCore 2 C) s = 1)
    (hsinv : ∀ y : X ⧸ pCore 2 X, coreAction X ⟨s,hsX⟩ y = y⁻¹) :
    QuotientGroup.mk' (pCore 2 I) s ∈ centralizer
      (C.map (QuotientGroup.mk' (pCore 2 I)) : Set (I ⧸ pCore 2 I)) ∧
    ∀ x ∈ Source.starImage I X,
      QuotientGroup.mk' (pCore 2 I) s * x * (QuotientGroup.mk' (pCore 2 I) s)⁻¹ = x⁻¹ := by
  let q := QuotientGroup.mk' (pCore 2 I)
  let e := cComponentTwoCoreQuotientEquiv hC
  have ha (z : C ⧸ pCore 2 C) :
      (e (normalQuotientAction C (pCore 2 C) s z) : I ⧸ pCore 2 I) =
        q s * (e z : I ⧸ pCore 2 I) * (q s)⁻¹ := by
    obtain ⟨c,rfl⟩ := QuotientGroup.mk'_surjective (pCore 2 C) z
    rw [normalQuotientAction_apply_mk]
    change q (s * (c : I) * s⁻¹) = q s * q (c : I) * (q s)⁻¹
    rw [map_mul,map_mul,map_inv]
  constructor
  · intro z hz
    obtain ⟨w,hw⟩ := e.surjective ⟨z,hz⟩
    have hh := ha w
    rw [hsC] at hh
    change (e w : I ⧸ pCore 2 I) = q s * (e w : I ⧸ pCore 2 I) * (q s)⁻¹ at hh
    rw [hw] at hh
    exact (mul_inv_eq_iff_eq_mul.mp hh.symm).symm
  · let ex := Structure.quotientStarEquiv I X hXI
      (Subgroup.Normal.isSubnormal inferInstance)
    intro x hx
    obtain ⟨y,hy⟩ := ex.surjective ⟨x,hx⟩
    have he (z : X ⧸ pCore 2 X) :
        (ex (coreAction X ⟨s,hsX⟩ z) : I ⧸ pCore 2 I) =
          q s * (ex z : I ⧸ pCore 2 I) * (q s)⁻¹ := by
      obtain ⟨a,rfl⟩ := QuotientGroup.mk'_surjective (pCore 2 X) z
      rw [coreAction_mk]
      change q (s * inclusion hXI a * s⁻¹) = q s * q (inclusion hXI a) * (q s)⁻¹
      rw [map_mul,map_mul,map_inv]
    have hh := he y
    rw [hsinv,map_inv,hy] at hh
    exact hh.symm

/-- A centralizing original inverter produces the required actual symmetric
subgroup when the original local group is generated by component, point,
and Sylow two-subgroup. -/
theorem outside_symmetric_embedding
    (I : Subgroup G) (C : Subgroup I) [C.Normal] (hC : C.IsCComponent)
    (X : Subgroup G) (hXI : X ≤ I) [(X.subgroupOf I).Normal]
    (T : Subgroup G) (hTI : T ≤ I) (hT : IsPGroup 2 T)
    (hgen : I = C.map I.subtype ⊔ X ⊔ T)
    (hcent : Source.starImage I X ≤ centralizer
      (C.map (QuotientGroup.mk' (pCore 2 I)) : Set (I ⧸ pCore 2 I)))
    (hz : center (C.map (QuotientGroup.mk' (pCore 2 I))) = ⊥)
    (hcard : Nat.card (Source.starImage I X) = 3)
    (s : I) (hsX : (s : G) ∈ normalizer (X : Set G))
    (hsC : normalQuotientAction C (pCore 2 C) s = 1)
    (hsinv : ∀ y : X ⧸ pCore 2 X, coreAction X ⟨s,hsX⟩ y = y⁻¹) :
    ∃ σ : Equiv.Perm (Fin 3) →* (I ⧸ pCore 2 I),
      Function.Injective σ ∧
      σ.range ≤ centralizer (C.map (QuotientGroup.mk' (pCore 2 I)) : Set (I ⧸ pCore 2 I)) ∧
      (alternatingGroup (Fin 3)).map σ = Source.starImage I X := by
  have hsub : (C.map I.subtype).subgroupOf I = C :=
    comap_map_eq_self_of_injective I.subtype_injective C
  let : ((C.map I.subtype).subgroupOf I).Normal := by rw [hsub]; infer_instance
  have hmark : Source.starImage I (C.map I.subtype) = C.map (QuotientGroup.mk' (pCore 2 I)) := by
    change ((C.map I.subtype).subgroupOf I).map _ = _
    rw [hsub]
  have hTs : IsPGroup 2 (Source.starImage I T) :=
    hT.comap_subtype.map _
  have hgens : (Source.starImage I (C.map I.subtype) ⊔ Source.starImage I X) ⊔
      Source.starImage I T = ⊤ := by
    unfold Source.starImage
    rw [←Subgroup.map_sup,←Subgroup.map_sup,
      ←subgroupOf_sup (map_subtype_le C) hXI,
      ←subgroupOf_sup (sup_le (map_subtype_le C) hXI) hTI,←hgen,
      subgroupOf_self,map_top_of_surjective _ (QuotientGroup.mk'_surjective _)]
  obtain ⟨hsc,hsi⟩ := outside_inverter_star I C hC X hXI s hsX hsC hsinv
  simpa only [hmark] using Structure.symmetric_embedding I (C.map I.subtype) X
    (hmark ▸ hcent) (hmark ▸ hz) hcard (Source.starImage I T) hTs hgens
    ⟨QuotientGroup.mk' (pCore 2 I) s,hmark ▸ hsc,hsi⟩

end CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.OriginalComponentStatement
