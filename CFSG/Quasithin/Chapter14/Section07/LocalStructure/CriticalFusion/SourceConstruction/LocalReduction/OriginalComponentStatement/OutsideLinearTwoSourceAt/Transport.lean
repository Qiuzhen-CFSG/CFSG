module
public import CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.OriginalComponentStatement.OutsideLinearTwoSourceAt.Module
public import CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.OriginalComponentStatement.OutsideLinearTwoSourceAt.SectionRank

/-!
# Field four and rank eight for every original normal outside component

Reduce to the subgroup generated by the same component, original point,
and original Sylow. The literal component quotient is unchanged. The
rank-eight section in this reduced local embeds in the larger original
section, as verified by their common coordinate kernel.
Source: Aschbacher–Smith 14.7.42, printed pp.1061–1062.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation
open scoped IsMulCommutative MatrixGroups
namespace CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.OriginalComponentStatement.OutsideLinearTwoSourceAt
open Chapter12.Section08 CriticalFusion.Source
open Chapter13.Section08.TransvectionRecognition.Component.ModelExtension
open Chapter14.Section04.LargerDimension.LocalAction.Components
open Chapter15.Section03.AbelianAmalgam
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  {F : InvariantFlag T V 3}

/-- An actual normal outside binary linear-two component forces field four
and rank at least eight in an action on the original local section. -/
theorem local_normal_field_four_rank_ge_eight_at
    (d : Counterexample T L)
    (h : HigherRankHypothesis KnownSimple.IsKnownSimple T L V 3)
    (hab : IsMulCommutative F.U)
    (structural : Chapter12.Section02.Structural1222At KnownSimple.IsKnownSimple T)
    (previous : Chapter12.Section02.Theorem12213At KnownSimple.IsKnownSimple T)
    (faithful : EarlierFaithfulClassification G (T : Subgroup G))
    (earlier : ResidualNormalizer.LocalControl.Earlier14710.{u})
    (I : Subgroup G) (hI : I ∈ F.Hz L (normalizer (L : Set G)))
    (C : Subgroup I) [C.Normal] (hC : C.IsCComponent)
    (hout : ¬ F.Li L 1 ≤ C.map I.subtype)
    {E : Type} [Field E] [Finite E] [CharP E 2]
    {n : ℕ} (hE : Nat.card E = 2^n) (hn : 1 < n)
    (e : (C ⧸ pCore 2 C) ≃* PSL(2,E)) :
    n = 2 ∧ ∃ hU : IsElementaryAbelian 2 (F.UH I),
      let := hU
      ∃ _a : LocalQuotientAction I (F.UH I) (F.Vi 1),
        8 ≤ Module.finrank (ZMod 2) (Additive ((F.UH I) ⧸ (F.Vi 1).subgroupOf (F.UH I))) := by
  obtain ⟨J,hJI,hJ,CJ,hCJ,hCN,_,hgen,houtJ,_,_,⟨ec⟩⟩ :=
    local_outside_normal_component_reduction_at h structural I hI C hC hout
  let := hCN
  obtain ⟨hn2,hUJ,aJ,hdJ⟩ := local_reduced_field_four_rank_ge_eight_at d h hab
    structural previous faithful earlier J hJ CJ hCJ houtJ hgen hE hn (ec.symm.trans e)
  let := hUJ
  obtain ⟨hUI,aI,_⟩ := WholeResidualAssembly.local_quadratic_bound_at h structural hab I hI
  let := hUI
  exact ⟨hn2,hUI,aI,hdJ.trans (local_section_finrank_mono hJI aI aJ)⟩

end CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.OriginalComponentStatement.OutsideLinearTwoSourceAt
