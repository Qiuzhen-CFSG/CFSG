module

public import CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.EightNatural
public import Theory.Quasithin.TwoKernelSubgroupRank

/-!
# Rank-two lifting for the deleted eight-letter section

The stabilizer of the relevant vector in the deleted (S_8)-module has
elementary (3^2)-sections, but its Sylow action need not preserve a cubic
line.  The rank-transfer argument below accepts fixation of the full
stabilizer preimage, or just its subgroup generated by order-three elements.
Once that input is available, odd-prime rank transport through the two-core
kernel and the literal binary section give the required rank-two centralizer.

The source-specific construction of the fixing preimage remains an additional
geometric obligation.  The actor-specific statement 14.7.2(3) does not by
itself supply fixation by the whole preimage or its cubic closure.  This file
only supplies the conditional rank transfer and its actual binary-section
consumer.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation
open BinaryNaturalDual.VectorStabilizers
namespace CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction
open Chapter12.Section08 CriticalFusion.Source
universe u
variable {G A W : Type*} [Group G] [Finite G] [Group A] [Finite A]
  [AddCommGroup W] [Module (ZMod 2) W]
  {H U Z P : Subgroup G} {ρ : Representation (ZMod 2) H W}

private theorem eight_rank_two_stabilizer
    (w : BinaryPermutation.natural (Fin 8)) :
    2 ≤ primeRank 3 (representationStabilizer
      (BinaryPermutation.naturalRepresentation (Fin 8)) w) := by
  let S := representationStabilizer
    (BinaryPermutation.alternatingNaturalRepresentation (Fin 8)) w
  let R := representationStabilizer
    (BinaryPermutation.naturalRepresentation (Fin 8)) w
  let f : S →* R := ((alternatingGroup (Fin 8)).subtype.comp S.subtype).codRestrict R
    (fun a => a.property)
  have hf : Function.Injective f := by
    intro a b he
    apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun r : R => (r : Equiv.Perm (Fin 8))) he
  exact (BinaryPermutation.PointStabilizerRank.two_le_natural_stabilizer
    (by simp : 8 ≤ Fintype.card (Fin 8)) w).trans
      (Theory.GroupTheory.primeRank_le_of_injective 3 f hf)

/-- A rank-two quotient stabilizer lifts when its whole two-group preimage
fixes the original point.  The conclusion is the centralizer rank bound used
in the (S_8) branch of 14.7.51. -/
theorem point_threeRank_le_of_rankTwo_lift
    (c : BinaryConjugationSection H U Z ρ)
    (π : H →* A)
    (hπ : Function.Surjective π) (hker : IsPGroup 2 π.ker)
    (E : Subgroup A)
    (hZP : Z ≤ P) (hi : Z.relIndex P = 2)
    (hZ : Nat.card Z = 2) (hHZ : H ≤ centralizer (Z : Set G))
    (v : U) (hv : (v : G) ∈ P) (hvZ : (v : G) ∉ Z)
    (hfixv : E.comap π ≤ representationStabilizer ρ (c.coordinates v).toAdd) :
    primeRank 3 E ≤ primeRank 3 (centralizer (P : Set G)) := by
  have hcomap : primeRank 3 (E.comap π) = primeRank 3 E :=
    primeRank_comap_eq_of_isTwoGroup_ker 3 (by decide) π hπ hker E
  have hpoint := c.point_threeRank_le ρ (MonoidHom.id H) Function.surjective_id
    (by rw [MonoidHom.ker_id]; exact IsPGroup.of_bot) P hZP hi hZ hHZ v hv hvZ
  have hsub : E.comap π ≤ representationStabilizer ρ (c.coordinates v).toAdd := hfixv
  have hle := (primeRank_mono 3 hsub).trans hpoint
  exact hcomap ▸ hle

/-- The rank-two lift only needs fixation by the cubic elements in the
quotient stabilizer preimage.  Containment of their generated closure in the
original point stabilizer is an explicit geometric premise; the actor-specific
source lifting lemma 14.7.2(3) does not alone establish this premise. -/
theorem point_threeRank_le_of_cubicClosure_lift
    (c : BinaryConjugationSection H U Z ρ)
    (π : H →* A)
    (hπ : Function.Surjective π) (hker : IsPGroup 2 π.ker)
    (E : Subgroup A)
    (hZP : Z ≤ P) (hi : Z.relIndex P = 2)
    (hZ : Nat.card Z = 2) (hHZ : H ≤ centralizer (Z : Set G))
    (v : U) (hv : (v : G) ∈ P) (hvZ : (v : G) ∉ Z)
    (hfixv : closure {a : H | a ∈ E.comap π ∧ orderOf a = 3} ≤
      representationStabilizer ρ (c.coordinates v).toAdd) :
    primeRank 3 E ≤ primeRank 3 (centralizer (P : Set G)) := by
  have hcomap : primeRank 3 (E.comap π) = primeRank 3 E :=
    primeRank_comap_eq_of_isTwoGroup_ker 3 (by decide) π hπ hker E
  have hpoint := c.point_threeRank_le ρ (MonoidHom.id H) Function.surjective_id
    (by rw [MonoidHom.ker_id]; exact IsPGroup.of_bot) P hZP hi hZ hHZ v hv hvZ
  let C := closure {a : H | a ∈ E.comap π ∧ orderOf a = 3}
  have hC : primeRank 3 C = primeRank 3 (E.comap π) :=
    primeRank_primeOrderClosure 3 (E.comap π)
  have hle : primeRank 3 C ≤ primeRank 3 (centralizer (P : Set G)) :=
    (primeRank_mono 3 hfixv).trans hpoint
  calc
    primeRank 3 E = primeRank 3 (E.comap π) := hcomap.symm
    _ = primeRank 3 C := hC.symm
    _ ≤ primeRank 3 (centralizer (P : Set G)) := hle

open Chapter14.Section04.LargerDimension.LocalAction.Components
open BinaryNaturalDual.VectorStabilizers
variable {T : Sylow 2 G} {L V : Subgroup G} {F : InvariantFlag T V 3}

/-- The (S_8) rank-two consumer.  The only additional premise is the
source-geometric assertion that the full preimage of each quotient vector
stabilizer fixes its original lift. -/
theorem local_eight_rankTwo_lift_impossible_at
    (h : HigherRankHypothesis KnownSimple.IsKnownSimple T L V 3)
    (structural : Chapter12.Section02.Structural1222At KnownSimple.IsKnownSimple T)
    (hm : ⁅F.Vi 2,F.H.pCoreIn 2⁆ ≠ ⊥)
    (I : Subgroup G) (hI : I ∈ F.Hz L (normalizer (L : Set G)))
    (e : HStar I ≃* Equiv.Perm (Fin 8))
    {W : Type u} [AddCommGroup W] [Module (ZMod 2) W]
    {ρ : Representation (ZMod 2) I W}
    (c : BinaryConjugationSection I (F.UH I) (F.Vi 1) ρ)
    (p : ρ.IntertwiningMap ((BinaryPermutation.naturalRepresentation (Fin 8)).comp
      (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 I)))))
    (hlift : ∀ (vU : F.UH I), (vU : G) ∈ F.Vi 2 → (vU : G) ∉ F.Vi 1 →
      let w := p (c.coordinates vU).toAdd
      let E := representationStabilizer
        (BinaryPermutation.naturalRepresentation (Fin 8)) w
      E.comap (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 I))) ≤
        representationStabilizer ρ (c.coordinates vU).toAdd) : False := by
  let π := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 I))
  have hπ : Function.Surjective π := e.surjective.comp (QuotientGroup.mk'_surjective _)
  have hπk : IsPGroup 2 π.ker := by
    change IsPGroup 2 (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 I))).ker
    rw [MonoidHom.ker_comp_of_injective _ _ e.injective,QuotientGroup.ker_mk']
    exact pCore_isPGroup
  have hp : Nat.card (F.Vi 1) = 2 := by simpa using F.card 1 (by decide)
  have hplane : (F.Vi 1).relIndex (F.Vi 2) = 2 := by
    have hh := ((F.Vi 1).subgroupOf (F.Vi 2)).card_mul_index
    rw [Nat.card_congr (subgroupOfEquivOfLe (F.monotone (by decide : 1 ≤ 2))).toEquiv,hp] at hh
    have hc : Nat.card (F.Vi 2) = 4 := by simpa using F.card 2 (by decide)
    change 2 * (F.Vi 1).relIndex (F.Vi 2) = Nat.card (F.Vi 2) at hh
    omega
  have hnot : ¬ F.Vi 2 ≤ F.Vi 1 := by
    intro hle
    have heq := le_antisymm hle (F.monotone (by decide : 1 ≤ 2))
    rw [heq,relIndex_self] at hplane
    omega
  obtain ⟨v,hv,hvZ⟩ := SetLike.not_le_iff_exists.mp hnot
  let vU : F.UH I := ⟨v,(le_conjugateSpanBy V I) (F.le_seed 2 hv)⟩
  let w := p (c.coordinates vU).toAdd
  let E := representationStabilizer
    (BinaryPermutation.naturalRepresentation (Fin 8)) w
  have hr := point_threeRank_le_of_rankTwo_lift (P := F.Vi 2) c π hπ hπk E
    (F.monotone (by decide : 1 ≤ 2)) hplane hp
    (hI.2.1.trans (normalizer_le_centralizer_of_card_two _ hp)) vU hv hvZ
    (hlift vU hv hvZ)
  have hl : 2 ≤ primeRank 3 E := eight_rank_two_stabilizer w
  have hbound := plane_centralizer_three_rank_le_one_at h structural hm
  omega

/-- The same conditional (S_8) contradiction with a cubic-closure lifting
premise.  Only the subgroup generated by order-three elements in each quotient
stabilizer preimage is required to fix the original coordinate; constructing
that fixation from the original source hypotheses remains a separate step. -/
theorem local_eight_rankTwo_cubicClosure_lift_impossible_at
    (h : HigherRankHypothesis KnownSimple.IsKnownSimple T L V 3)
    (structural : Chapter12.Section02.Structural1222At KnownSimple.IsKnownSimple T)
    (hm : ⁅F.Vi 2,F.H.pCoreIn 2⁆ ≠ ⊥)
    (I : Subgroup G) (hI : I ∈ F.Hz L (normalizer (L : Set G)))
    (e : HStar I ≃* Equiv.Perm (Fin 8))
    {W : Type u} [AddCommGroup W] [Module (ZMod 2) W]
    {ρ : Representation (ZMod 2) I W}
    (c : BinaryConjugationSection I (F.UH I) (F.Vi 1) ρ)
    (p : ρ.IntertwiningMap ((BinaryPermutation.naturalRepresentation (Fin 8)).comp
      (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 I)))))
    (hlift : ∀ (vU : F.UH I), (vU : G) ∈ F.Vi 2 → (vU : G) ∉ F.Vi 1 →
      let w := p (c.coordinates vU).toAdd
      let E := representationStabilizer
        (BinaryPermutation.naturalRepresentation (Fin 8)) w
      closure {a : I | a ∈ E.comap (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 I))) ∧
        orderOf a = 3} ≤ representationStabilizer ρ (c.coordinates vU).toAdd) : False := by
  let π := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 I))
  have hπ : Function.Surjective π := e.surjective.comp (QuotientGroup.mk'_surjective _)
  have hπk : IsPGroup 2 π.ker := by
    change IsPGroup 2 (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 I))).ker
    rw [MonoidHom.ker_comp_of_injective _ _ e.injective,QuotientGroup.ker_mk']
    exact pCore_isPGroup
  have hp : Nat.card (F.Vi 1) = 2 := by simpa using F.card 1 (by decide)
  have hplane : (F.Vi 1).relIndex (F.Vi 2) = 2 := by
    have hh := ((F.Vi 1).subgroupOf (F.Vi 2)).card_mul_index
    rw [Nat.card_congr (subgroupOfEquivOfLe (F.monotone (by decide : 1 ≤ 2))).toEquiv,hp] at hh
    have hc : Nat.card (F.Vi 2) = 4 := by simpa using F.card 2 (by decide)
    change 2 * (F.Vi 1).relIndex (F.Vi 2) = Nat.card (F.Vi 2) at hh
    omega
  have hnot : ¬ F.Vi 2 ≤ F.Vi 1 := by
    intro hle
    have heq := le_antisymm hle (F.monotone (by decide : 1 ≤ 2))
    rw [heq,relIndex_self] at hplane
    omega
  obtain ⟨v,hv,hvZ⟩ := SetLike.not_le_iff_exists.mp hnot
  let vU : F.UH I := ⟨v,(le_conjugateSpanBy V I) (F.le_seed 2 hv)⟩
  let w := p (c.coordinates vU).toAdd
  let E := representationStabilizer
    (BinaryPermutation.naturalRepresentation (Fin 8)) w
  have hr := point_threeRank_le_of_cubicClosure_lift (P := F.Vi 2) c π hπ hπk E
    (F.monotone (by decide : 1 ≤ 2)) hplane hp
    (hI.2.1.trans (normalizer_le_centralizer_of_card_two _ hp)) vU hv hvZ
    (hlift vU hv hvZ)
  have hl : 2 ≤ primeRank 3 E := eight_rank_two_stabilizer w
  have hbound := plane_centralizer_three_rank_le_one_at h structural hm
  omega

end CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction
