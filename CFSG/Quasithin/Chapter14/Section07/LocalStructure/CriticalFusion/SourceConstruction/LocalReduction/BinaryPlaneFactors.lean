/-- The solvable literal Thompson image consists of one or two S₃ factors. -/
theorem solvable_reduced_thompson_models
    (U : Subgroup D) [U.Normal] [IsElementaryAbelian 2 U]
    (hD : IsSQTK KnownSimple.IsKnownSimple D)
    (hcore : pCore 2 (ActionQuotient U) = ⊥)
    (hne : thompsonImage U ≠ ⊥) (hsol : Group.IsSolvable (thompsonImage U)) :
    Nonempty (thompsonImage U ≃* Equiv.Perm (Fin 3)) ∨
      Nonempty (thompsonImage U ≃* (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3))) := by
  let J := thompsonImage U
  let ρ := thompsonAction U
  let : Nontrivial J := (Subgroup.nontrivial_iff_ne_bot _).mpr hne
  have hh := thompson_hypothesis U hD hcore
  have hff : IsFFModule ρ := by
    by_contra hn
    have hz : offenderSubgroup ρ = ⊥ := by
      apply bot_unique
      apply iSup_le
      intro A
      apply iSup_le
      rintro ⟨hA,_⟩
      exact (hn ⟨A,hA.isOffender ρ⟩).elim
    exact top_ne_bot (hh.generated.symm.trans hz)
  obtain ⟨d⟩ := ChapterB.solvableFFStructure_nonempty ρ hsol hh.twoCore hh.faithful hff
  let q := actionMk U
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective _
  have hrank : primeRank 3 (J.comap q) ≤ 2 :=
    (hD.subgroup _).stronglyQuasithin 3 (by decide) (by decide)
  have hc := d.toSolvableFFFactors.count_eq_one_or_two_of_surjective_threeRank
    (q.subgroupComap J) (q.subgroupComap_surjective_of_surjective J hq) hrank
  have hnon : (Set.univ : Set (Fin d.count)).Nonempty :=
    ⟨⟨0,d.count_pos⟩,Set.mem_univ _⟩
  have he : (⨆ i ∈ (Set.univ : Set (Fin d.count)),d.factor i : Subgroup J) = ⊤ := by
    simpa only [Set.mem_univ,iSup_pos] using
      d.toSolvableFFFactors.iSup_factor.trans hh.generated
  have hm := d.toSolvableFFFactors.nonempty_subproduct_models hc Set.univ hnon
  rw [he] at hm
  exact hm.imp (fun ⟨e⟩ => ⟨topEquiv.symm.trans e⟩)
    (fun ⟨e⟩ => ⟨topEquiv.symm.trans e⟩)

private def first_coordinate_equiv {X : Type*} [Group X]
    (e : X ≃* (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3))) :
    (((⊤ : Subgroup (Equiv.Perm (Fin 3))).prod ⊥).comap e.toMonoidHom) ≃*
      Equiv.Perm (Fin 3) where
  toFun x := (e x).1
  invFun x := ⟨e.symm (x,1),by simp [Subgroup.mem_prod]⟩
  left_inv x := by
    apply Subtype.ext
    apply e.injective
    simp only [e.apply_symm_apply]
    exact Prod.ext rfl x.property.2.symm
  right_inv x := by simp
  map_mul' x y := congrArg Prod.fst (e.map_mul (x : X) (y : X))

private theorem symmetric_factor_normalizer {Q : Type*} [Group Q]
    (K : Subgroup Q) (e : K ≃* Equiv.Perm (Fin 3)) :
    normalizer (K : Set Q) = K ⊔ centralizer (K : Set Q) := by
  let N := normalizer (K : Set Q)
  let A := K.subgroupOf N
  let : A.Normal := normal_subgroupOf_of_le_normalizer le_rfl
  have hg := NormalSymmetricThree.sup_centralizer_eq_top A
    ((subgroupOfEquivOfLe K.le_normalizer).trans e)
  apply le_antisymm _ (sup_le K.le_normalizer (Subgroup.centralizer_le_normalizer _))
  intro x hx
  have hm : (A ⊔ centralizer (A : Set N)).map N.subtype ≤
      K ⊔ centralizer (K : Set Q) := by
    rw [Subgroup.map_sup,map_subgroupOf_eq_of_le K.le_normalizer]
    apply sup_le le_sup_left
    apply le_trans _ le_sup_right
    rintro _ ⟨a,ha,rfl⟩
    intro k hk
    exact congrArg Subtype.val (ha ⟨k,K.le_normalizer hk⟩ hk)
  exact hm (mem_map_of_mem N.subtype
    (show (⟨x,hx⟩ : N) ∈ A ⊔ centralizer (A : Set N) by rw [hg]; trivial))

/-- Select an actual subnormal S₃ preserved by every two-perfect actor. -/
theorem solvable_reduced_thompson_factor
    (U : Subgroup D) [U.Normal] [IsElementaryAbelian 2 U]
    (hD : IsSQTK KnownSimple.IsKnownSimple D)
    (hcore : pCore 2 (ActionQuotient U) = ⊥)
    (hne : thompsonImage U ≠ ⊥) (hsol : Group.IsSolvable (thompsonImage U)) :
    ∃ K : Subgroup (ActionQuotient U), K ≤ thompsonImage U ∧
      (K.subgroupOf (thompsonImage U)).Normal ∧ K.IsSubnormal ∧
      Nonempty (K ≃* Equiv.Perm (Fin 3)) ∧
      normalizer (K : Set (ActionQuotient U)) = K ⊔ centralizer (K : Set _) ∧
      Disjoint K (centralizer (K : Set (ActionQuotient U))) ∧
      ∀ B : Subgroup (ActionQuotient U), IsPPerfect 2 B →
        B ≤ normalizer (K : Set (ActionQuotient U)) := by
  let J := thompsonImage U
  let : (elementaryAbelianMaxJ (⊤ : Subgroup D)).Characteristic :=
    elementaryAbelianMaxJ_top_characteristic
  let : J.Normal := (inferInstance : (elementaryAbelianMaxJ (⊤ : Subgroup D)).Normal).map
    (actionMk U) (QuotientGroup.mk'_surjective _)
  rcases solvable_reduced_thompson_models U hD hcore hne hsol with he | he
  · obtain ⟨e⟩ := he
    exact ⟨J,le_rfl,by rw [subgroupOf_self]; infer_instance,
      (inferInstance : J.Normal).isSubnormal,⟨e⟩,symmetric_factor_normalizer J e,
      NormalSymmetricThree.centralizer_disjoint J e,fun _ _ => le_normalizer_of_normal⟩
  · obtain ⟨e⟩ := he
    let C := (((⊤ : Subgroup (Equiv.Perm (Fin 3))).prod ⊥).comap e.toMonoidHom)
    let K := NormalSymmetricThreePairRank.firstFactor J e
    let : C.Normal := inferInstanceAs
      ((((⊤ : Subgroup (Equiv.Perm (Fin 3))).prod ⊥).comap e.toMonoidHom).Normal)
    have hsub : K.IsSubnormal :=
      (inferInstance : C.Normal).isSubnormal.trans' (inferInstance : J.Normal).isSubnormal
    let ek : K ≃* Equiv.Perm (Fin 3) :=
      (C.equivMapOfInjective J.subtype J.subtype_injective).symm.trans (first_coordinate_equiv e)
    have hKn : (K.subgroupOf J).Normal := by
      have he : K.subgroupOf J = C := comap_map_eq_self_of_injective J.subtype_injective C
      rw [he]
      infer_instance
    exact ⟨K,map_subtype_le _,hKn,hsub,⟨ek⟩,symmetric_factor_normalizer K ek,
      NormalSymmetricThree.centralizer_disjoint K ek,
      NormalSymmetricThreePairRank.twoPerfect_normalizes_first J e⟩

