open Chapter14.Section04.LargerDimension.LocalAction.Components
open scoped IsMulCommutative
universe u
variable {G : Type u} [Group G] [Finite G]

private theorem dihedral_five_le_normal_of_contains_two
    (D A N : Subgroup G) (e : D ≃* DihedralGroup 5)
    (hAD : A ≤ D) (hA : Nat.card A = 2) [N.Normal] (hAN : A ≤ N) : D ≤ N := by
  let B := N.subgroupOf D
  let : B.Normal := inferInstance
  have hBD : Nat.card B ∣ 10 := by
    have hd := B.card_subgroup_dvd_card
    rwa [Nat.card_congr e.toEquiv,DihedralGroup.nat_card] at hd
  have hAB : Nat.card (A.subgroupOf D) = 2 :=
    (Nat.card_congr (subgroupOfEquivOfLe hAD).toEquiv).trans hA
  have h2 : 2 ∣ Nat.card B := by
    rw [←hAB]
    exact card_dvd_of_le (show A.subgroupOf D ≤ B from comap_mono hAN)
  have hc : Nat.card B = 2 ∨ Nat.card B = 10 := by
    have hb := Nat.le_of_dvd (by decide : 0 < 10) hBD
    have hb0 := Nat.card_pos (α := B)
    interval_cases n : Nat.card B <;> omega
  rcases hc with hc | hc
  · have hn := odd_dihedral_two_subgroup_normalizer 5 (by decide) e B
      (IsPGroup.of_card (n := 1) hc)
      (by intro hb; rw [hb,card_bot] at hc; omega)
    rw [normalizer_eq_top] at hn
    have htop := congrArg (fun C : Subgroup D => Nat.card C) hn
    rw [card_top,hc,Nat.card_congr e.toEquiv,DihedralGroup.nat_card] at htop
    norm_num at htop
  · have ht : B = ⊤ := eq_of_le_of_card_ge le_top (by
      rw [card_top,hc,Nat.card_congr e.toEquiv,DihedralGroup.nat_card])
    intro x hx
    exact (show (⟨x,hx⟩ : D) ∈ B from ht ▸ mem_top _)

/-- A common commutator centralized by the local core forces the selected
full dihedral factor into the star image of the literal radical-action kernel. -/
theorem local_cubic_factor_radical_kernel
    {I U Z : Subgroup G} [IsElementaryAbelian 2 U]
    (a : LocalQuotientAction I U Z)
    (B : Subgroup G) (hBI : B ≤ I)
    (hc : I.pCoreIn 2 ≤ centralizer ((⁅U,B⁆ : Subgroup G) : Set G)) :
    let := BinaryGroupAction.action a.representation
    ∀ (f : CanonicalFiveDihedralFamily (G := HStar I)
        (V := Multiplicative (Additive (U ⧸ Z.subgroupOf U))))
      (i : smallSupportFactors (HStar I)
        (Multiplicative (Additive (U ⧸ Z.subgroupOf U))) 2),
      actorImage I B ≤ f.factor i → Nat.card (actorImage I B) = 2 →
      f.factor i ≤ actorImage I (commutatorPreimage I U
        (U ⊓ centralizer (I.pCoreIn 2 : Set G))) := by
  intro _ f i hAi hAc
  let R := U ⊓ centralizer (I.pCoreIn 2 : Set G)
  let N := commutatorPreimage I U R
  have hIQ : I ≤ normalizer (I.pCoreIn 2 : Set G) :=
    I.le_normalizer.trans (normalizer_le_normalizer_characteristic_image I (pCore 2 I))
  have hIR : I ≤ normalizer (R : Set G) :=
    le_normalizer_inf a.normalizes (hIQ.trans (normalizer_le_normalizer_centralizer _))
  have hIN : I ≤ normalizer (N : Set G) :=
    commutatorPreimage_normalized I U R I hIR I.le_normalizer a.normalizes hIR
  let : (N.subgroupOf I).Normal := normal_subgroupOf_of_le_normalizer hIN
  let : (actorImage I N).Normal := Normal.map inferInstance _ (QuotientGroup.mk'_surjective _)
  have hBN : B ≤ N := by
    apply le_commutatorPreimage hBI
    rw [commutator_comm]
    exact le_inf (le_normalizer_iff_commutator_le_left.mp (hBI.trans a.normalizes))
      (le_centralizer_iff.mp hc)
  exact dihedral_five_le_normal_of_contains_two (f.factor i) (actorImage I B)
    (actorImage I N) (f.model i).some hAi hAc (map_mono (comap_mono hBN))


/-- Minimality propagates trivial action from one canonical factor to the
whole original five-core, and lifts it through the full two-core kernel. -/
theorem local_minimal_five_lift_radical
    {I U Z : Subgroup G} [IsElementaryAbelian 2 U]
    (a : LocalQuotientAction I U Z)
    (hcomm : ⁅I.pCoreIn 2,U⁆ ≤ Z)
    (hZ : Z ≤ centralizer (I : Set G))
    (X : Subgroup (HStar I)) (hcore : X = pCore 5 (HStar I))
    (hmin : ∀ N : Subgroup (HStar I), N.Normal → N ≤ X → N = ⊥ ∨ N = X)
    (Y : Subgroup I) (hY : Y.map (QuotientGroup.mk' (pCore 2 I)) = X)
    (B : Subgroup G) (hBI : B ≤ I)
    (hc : I.pCoreIn 2 ≤ centralizer ((⁅U,B⁆ : Subgroup G) : Set G)) :
    let := BinaryGroupAction.action a.representation
    ∀ (f : CanonicalFiveDihedralFamily (G := HStar I)
        (V := Multiplicative (Additive (U ⧸ Z.subgroupOf U))))
      (i : smallSupportFactors (HStar I)
        (Multiplicative (Additive (U ⧸ Z.subgroupOf U))) 2),
      actorImage I B ≤ f.factor i → Nat.card (actorImage I B) = 2 →
      ⁅Y.map I.subtype,U⁆ ≤ U ⊓ centralizer (I.pCoreIn 2 : Set G) := by
  intro _ f i hAi hAc
  let R := U ⊓ centralizer (I.pCoreIn 2 : Set G)
  let N := commutatorPreimage I U R
  have hIQ : I ≤ normalizer (I.pCoreIn 2 : Set G) :=
    I.le_normalizer.trans (normalizer_le_normalizer_characteristic_image I (pCore 2 I))
  have hIR : I ≤ normalizer (R : Set G) :=
    le_normalizer_inf a.normalizes (hIQ.trans (normalizer_le_normalizer_centralizer _))
  have hIN : I ≤ normalizer (N : Set G) :=
    commutatorPreimage_normalized I U R I hIR I.le_normalizer a.normalizes hIR
  let : (N.subgroupOf I).Normal := normal_subgroupOf_of_le_normalizer hIN
  let : (actorImage I N).Normal := Normal.map inferInstance _ (QuotientGroup.mk'_surjective _)
  let : X.Normal := hcore.symm ▸ inferInstance
  have hiN := (f.contains i).trans
    (local_cubic_factor_radical_kernel a B hBI hc f i hAi hAc)
  have hiX : i.val ≤ X := by
    rw [hcore]
    exact IsPGroup.le_pCore_of_le_fitting
      (IsPGroup.of_card (n := 1) (by simpa using i.property.2.1)) i.property.1
  have hXN : X ≤ actorImage I N := by
    have hne : X ⊓ actorImage I N ≠ ⊥ := by
      intro he
      have hz : i.val = ⊥ := bot_unique ((le_inf hiX hiN).trans he.le)
      have hi := i.property.2.1
      rw [hz,card_bot] at hi
      norm_num at hi
    exact ((hmin _ inferInstance inf_le_left).resolve_left hne).ge.trans inf_le_right
  have hZR : Z ≤ R := le_inf a.kernel_le (hZ.trans (centralizer_le (pCoreIn_le 2 I)))
  have hQN : I.pCoreIn 2 ≤ N := le_commutatorPreimage (pCoreIn_le 2 I) (hcomm.trans hZR)
  have hker : (QuotientGroup.mk' (pCore 2 I)).ker ≤ N.subgroupOf I := by
    rw [QuotientGroup.ker_mk']
    intro x hx
    exact hQN (mem_map_of_mem I.subtype hx)
  have hYN : Y ≤ N.subgroupOf I := by
    have hm : Y.map (QuotientGroup.mk' (pCore 2 I)) ≤
        (N.subgroupOf I).map (QuotientGroup.mk' (pCore 2 I)) := hY.symm ▸ hXN
    have hh := map_le_map_iff.mp hm
    simpa only [sup_eq_left.mpr hker] using hh
  have hYNg : Y.map I.subtype ≤ N := by
    rintro x ⟨y,hy,rfl⟩
    exact hYN hy
  exact (commutator_mono hYNg le_rfl).trans (commutator_commutatorPreimage_le I U R hIR)

/-- Once the actual five-lift fixes the pairing quotient, that quotient
is generated by the unchanged seed alone. -/
theorem local_span_eq_seed_sup_radical
    {T : Sylow 2 G} {L V : Subgroup G} {F : InvariantFlag T V 3}
    (h : HigherRankHypothesis KnownSimple.IsKnownSimple T L V 3)
    (I : Subgroup G) (Y : Subgroup I)
    (hgen : I = Y.map I.subtype ⊔ (F.Li L 1 ⊔ (T : Subgroup G)))
    (hm : ⁅Y.map I.subtype,F.UH I⁆ ≤
      F.UH I ⊓ centralizer (I.pCoreIn 2 : Set G)) :
    V ⊔ (F.UH I ⊓ centralizer (I.pCoreIn 2 : Set G)) = F.UH I := by
  let R := F.UH I ⊓ centralizer (I.pCoreIn 2 : Set G)
  have hIU : I ≤ normalizer (F.UH I : Set G) := le_normalizer_conjugateSpanBy V I
  have hIQ : I ≤ normalizer (I.pCoreIn 2 : Set G) :=
    I.le_normalizer.trans (normalizer_le_normalizer_characteristic_image I (pCore 2 I))
  have hIR : I ≤ normalizer (R : Set G) :=
    le_normalizer_inf hIU (hIQ.trans (normalizer_le_normalizer_centralizer _))
  have hVU : V ≤ F.UH I := le_conjugateSpanBy V I
  have hYN : Y.map I.subtype ≤ normalizer ((V ⊔ R : Subgroup G) : Set G) := by
    apply le_normalizer_iff_commutator_le_right.mpr
    exact ((commutator_mono le_rfl (sup_le hVU inf_le_left)).trans hm).trans le_sup_right
  have hBV : F.Li L 1 ⊔ (T : Subgroup G) ≤ normalizer (V : Set G) :=
    sup_le ((F.Li_le L 1).trans (inf_le_left.trans h.chosen.normalizes))
      (by simpa only [F.last] using F.invariant 3)
  have hBN : F.Li L 1 ⊔ (T : Subgroup G) ≤ normalizer ((V ⊔ R : Subgroup G) : Set G) :=
    (le_inf hBV ((le_sup_right.trans hgen.ge).trans hIR)).trans
      (normalizer_inf_normalizer_le_normalizer_sup _ _)
  have hN : I ≤ normalizer ((V ⊔ R : Subgroup G) : Set G) := by
    rw [hgen]
    exact sup_le hYN hBN
  exact le_antisymm (sup_le hVU inf_le_left) (conjugateSpanBy_le le_sup_left hN)

/-- The pairing radical meets the original natural seed in exactly its
point; its nontrivial quotient is retained without a faithfulness premise. -/
theorem local_pairing_radical_seed_intersection
    {T : Sylow 2 G} {L V : Subgroup G} {F : InvariantFlag T V 3}
    (h : HigherRankHypothesis KnownSimple.IsKnownSimple T L V 3)
    (I : Subgroup G) (hLI : F.Li L 1 ≤ I)
    (hn : ((F.Li L 1).subgroupOf I).Normal)
    (hZ : F.Vi 1 ≤ centralizer (I : Set G)) :
    V ⊓ (F.UH I ⊓ centralizer (I.pCoreIn 2 : Set G)) = F.Vi 1 := by
  let := h.chosen.elementary
  let := F.localKernel_tilde_seed_elementary
  let R := F.UH I ⊓ centralizer (I.pCoreIn 2 : Set G)
  have hVU : V ≤ F.UH I := le_conjugateSpanBy V I
  have hIQ : I ≤ normalizer (I.pCoreIn 2 : Set G) :=
    I.le_normalizer.trans (normalizer_le_normalizer_characteristic_image I (pCore 2 I))
  have hIR : I ≤ normalizer (R : Set G) :=
    le_normalizer_inf (le_normalizer_conjugateSpanBy V I)
      (hIQ.trans (normalizer_le_normalizer_centralizer _))
  have hZR : F.Vi 1 ≤ R := le_inf ((F.le_seed 1).trans hVU)
    (hZ.trans (centralizer_le (pCoreIn_le 2 I)))
  have hNR : F.Li L 1 ≤ normalizer ((V ⊓ R : Subgroup G) : Set G) :=
    le_normalizer_inf ((F.Li_le L 1).trans (inf_le_left.trans h.chosen.normalizes))
      (hLI.trans hIR)
  rcases F.invariant_subgroup_of_ambient_natural h.naturalMarking (by decide : 3 ≤ 3)
      (V ⊓ R) (le_inf (F.le_seed 1) hZR) inf_le_left hNR with he | he
  · exact he
  · exfalso
    have hP : (F.Li L 1).pCoreIn 2 ≤ I.pCoreIn 2 :=
      pCoreIn_mono_of_normalizes hLI ((normal_subgroupOf_iff_le_normalizer hLI).mp hn)
    apply F.point_core_moves_seed_of_natural h.naturalMarking
    exact hP.trans (le_centralizer_iff.mp (he.ge.trans (inf_le_right.trans inf_le_right)))

/-- The remaining cubic branch has a literal pairing quotient of order four,
so the dual local-core quotient has the same order. -/
theorem local_cubic_pairing_index_four
    {T : Sylow 2 G} {L V : Subgroup G} {F : InvariantFlag T V 3}
    (h : HigherRankHypothesis KnownSimple.IsKnownSimple T L V 3)
    (I : Subgroup G) (hLI : F.Li L 1 ≤ I)
    (hn : ((F.Li L 1).subgroupOf I).Normal)
    [IsElementaryAbelian 2 (F.UH I)]
    (hf : (Chapter12.Section09.NaturalSource.naturalF9Setup F L I).Hypothesis)
    (hs : V ⊔ (F.UH I ⊓ centralizer (I.pCoreIn 2 : Set G)) = F.UH I) :
    (F.UH I ⊓ centralizer (I.pCoreIn 2 : Set G)).relIndex (F.UH I) = 4 ∧
      (centralizer (F.UH I : Set G)).relIndex (I.pCoreIn 2) = 4 := by
  let R := F.UH I ⊓ centralizer (I.pCoreIn 2 : Set G)
  have hVU : V ≤ F.UH I := le_conjugateSpanBy V I
  have hRU : R ≤ F.UH I := inf_le_left
  have hZ : F.Vi 1 ≤ centralizer (I : Set G) := le_centralizer_iff.mp hf.H_centralizes
  have hinter := local_pairing_radical_seed_intersection h I hLI hn hZ
  have hRV : R.subgroupOf V = (F.Vi 1).subgroupOf V := by
    ext v
    change (v : G) ∈ R ↔ (v : G) ∈ F.Vi 1
    constructor
    · intro hv
      exact hinter ▸ (show (v : G) ∈ V ⊓ R from ⟨v.property,hv⟩)
    · intro hv
      exact (show F.Vi 1 ≤ R from (hinter.ge.trans inf_le_right)) hv
  have hrel : R.relIndex (F.UH I) = (F.Vi 1).relIndex V := by
    have hh := relIndex_sup_right (V.subgroupOf (F.UH I)) (R.subgroupOf (F.UH I))
    rw [←subgroupOf_sup hVU hRU,hs,relIndex_subgroupOf le_rfl,relIndex_subgroupOf hVU] at hh
    exact hh.trans (congrArg Subgroup.index hRV)
  have hcard : (F.Vi 1).relIndex V = 4 := by
    have hm := card_mul_index ((F.Vi 1).subgroupOf V)
    have hc : Nat.card ((F.Vi 1).subgroupOf V) = 2 :=
      (Nat.card_congr (subgroupOfEquivOfLe (F.le_seed 1)).toEquiv).trans (by simpa using F.card 1 (by decide))
    have hv : Nat.card V = 8 := by simpa only [F.last, show (2 : ℕ)^3 = 8 from rfl] using F.card 3 (by decide)
    rw [hc,hv] at hm
    change (F.Vi 1).relIndex V = 4
    change 2 * (F.Vi 1).relIndex V = 8 at hm
    omega
  have hi : R.relIndex (F.UH I) = 4 := hrel.trans hcard
  obtain ⟨ρ,sU,sQ,hpair,hindex⟩ := local_core_duality I hf
  exact ⟨hi,((hindex (F.UH I) le_rfl).trans (sU.imageSpace_card_eq_relIndex _ le_rfl)).trans hi⟩

