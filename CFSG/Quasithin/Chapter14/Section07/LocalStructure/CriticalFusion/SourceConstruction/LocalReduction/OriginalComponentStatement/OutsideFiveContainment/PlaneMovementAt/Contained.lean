/-!
# A contained component supplies a chosen module with the original fixed point

Under contrary plane centrality, restrict to the literal component-Sylow
join J=C T. Its core centralizes the original seed because its action commutes
with the cubic point action. The seed span in J lies in the reduced subgroup
and is generated by C, so the reduced commutator contains the original point.
The faithful component's Thompson generation then constructs the chosen module.
No equality between J and the full point normalizer is assumed.
Source: Aschbacher–Smith 13.3.14(g) and 14.7.4, printed pp.893,1043.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.OriginalComponentStatement.OutsideFiveContainment.PlaneMovementAt
open Chapter12.Section08 CriticalFusion.Source WholeResidualAssembly
open Chapter12.Section02 ChapterA.Section04
open LinearThreeSource
open Chapter13.Section08.TransvectionRecognition.Component.ModelExtension
open Chapter14.Section04.LargerDimension.LocalAction.Components
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  {F : InvariantFlag T V 3}

/-- Contrary centrality constructs a chosen module on the actual reduced
commutator, retaining its nonzero original fixed point and faithful actor. -/
theorem contained_component_chosen_of_plane_centralized_at
    (d : Counterexample T L)
    (h : HigherRankHypothesis KnownSimple.IsKnownSimple T L V 3)
    (hab : IsMulCommutative F.U)
    (structural : Structural1222At KnownSimple.IsKnownSimple T)
    (previous : Theorem12213At KnownSimple.IsKnownSimple T)
    (faithful : EarlierFaithfulClassification G (T : Subgroup G))
    (earlier : ResidualNormalizer.LocalControl.Earlier14710.{u})
    (C : Subgroup F.H) (hC : C.IsCComponent)
    (hin : F.Li L 1 ≤ C.map F.H.subtype)
    (hc : ⁅F.Vi 2,F.H.pCoreIn 2⁆ = ⊥) :
    let B := C.map F.H.subtype
    let W := ⁅(reducedTwoSubgroup (B ⊔ (T : Subgroup G) : Subgroup G)).map
      (B ⊔ (T : Subgroup G) : Subgroup G).subtype,B⁆
    B ∈ MainForward.faithfulLocalComponents T ∧
      W ⊓ centralizer (B : Set G) ≠ ⊥ ∧ Nonempty (ChosenModule T B W) := by
  let := h.chosen.elementary
  let := hab
  let := elementary_U F
  let B := C.map F.H.subtype
  let W := ⁅(reducedTwoSubgroup (B ⊔ (T : Subgroup G) : Subgroup G)).map
      (B ⊔ (T : Subgroup G) : Subgroup G).subtype,B⁆
  have hH := h.point_mem_Hz_at F previous
  have hC' : ((C.map F.H.subtype).subgroupOf F.H).IsCComponent := by
    simpa only [subgroupOf,comap_map_eq_self_of_injective F.H.subtype_injective] using hC
  have hnC := local_cComponent_normal_at d h hab structural previous faithful earlier
    F.H B hH (map_subtype_le _) hC'
  let : C.Normal := by
    simpa only [B,subgroupOf,comap_map_eq_self_of_injective F.H.subtype_injective] using hnC
  let : IsQuasisimple (C ⧸ pCore 2 C) :=
    GuardedSource.local_component_twoCore_isQuasisimple h hab structural previous faithful F.H hH C hC
  let J := B ⊔ (T : Subgroup G)
  let UJ := F.UH J
  have hBJ : B ≤ J := le_sup_left
  have hTJ : (T : Subgroup G) ≤ J := le_sup_right
  have hJH : J ≤ F.H := sup_le (map_subtype_le _) (F.invariant 1)
  have hJN : J ≤ normalizer (B : Set G) :=
    hJH.trans ((normal_subgroupOf_iff_le_normalizer (map_subtype_le C)).mp hnC)
  have hUJ : UJ ≤ J := conjugateSpanBy_le_self (h.chosen.le_sylow.trans hTJ)
  have hUU : UJ ≤ F.U := conjugateSpanBy_mono le_rfl hJH
  have hm : ⁅UJ,B⁆ = UJ :=
    (conjugateSpanBy_eq_commutator_of_seed V J B (F.Li L 1) hBJ hJN hin
      (seed_commutator h F)).symm
  have hBH : B ≤ F.H := map_subtype_le _
  have hBC : (B.subgroupOf F.H).IsCComponent := by
    simpa only [B,subgroupOf,comap_map_eq_self_of_injective F.H.subtype_injective] using hC
  have hn : (B.subgroupOf F.H).Normal := by
    simpa only [B,subgroupOf,comap_map_eq_self_of_injective F.H.subtype_injective] using
      (inferInstance : C.Normal)
  have hHN : F.H ≤ normalizer (B : Set G) :=
    (normal_subgroupOf_iff_le_normalizer hBH).mp hn
  have hTH : (T : Subgroup G) ≤ F.H := F.invariant 1
  have hpCard : Nat.card (F.Vi 1) = 2 := by simpa using F.card 1 (by decide)
  have hp : F.Vi 1 ≠ ⊥ := by intro he; simp [he] at hpCard
  have hpUJ : F.Vi 1 ≤ UJ := (F.le_seed 1).trans (le_conjugateSpanBy V J)
  have hUne : UJ ≠ ⊥ := fun he => hp (le_bot_iff.mp (hpUJ.trans_eq he))
  have htwo : IsTwoLocal F.H := ⟨F.Vi 1,hp,
    T.isPGroup'.to_le ((F.le_seed 1).trans h.chosen.le_sylow),rfl⟩
  have hHe : F.H ∈ Chapter1.He G := Chapter1.twoLocal_mem_He_of_sylow_le T
    (h.source.simpleQTKE.toIsQTKE.evenCharacteristic T) htwo hTH
  have hω := original_point_span_le_omega_of_plane_centralized h hc
  have hωmap : (omegaOneCenterAmbient (pCore 2 F.H)).map F.H.subtype =
      omegaOneCenterAmbient (F.H.pCoreIn 2) :=
    (omegaOneCenterAmbient_map_injective F.H.subtype F.H.subtype_injective _).symm
  have hUi : F.U.subgroupOf F.H ≤ omegaOneCenterAmbient (pCore 2 F.H) := by
    intro a ha
    have hh := hω ha
    rw [←hωmap] at hh
    obtain ⟨b,hb,he⟩ := hh
    exact (F.H.subtype_injective he) ▸ hb
  have hmi : ⁅F.U.subgroupOf F.H,C⁆ ≠ ⊥ := by
    intro he
    have hh := congrArg (Subgroup.map F.H.subtype) he
    rw [map_commutator,map_subgroupOf_eq_of_le F.U_le_H,Subgroup.map_bot] at hh
    exact hUne (bot_unique (hm.symm.le.trans
      ((commutator_mono hUU le_rfl).trans hh.le)))
  obtain ⟨hBL,hBf⟩ := Chapter13.Section03.Noncentrality.source_component_faithful_local
    T F.H hTH (Chapter1.mem_H_of_isTwoLocal htwo) hHe C _ hC hUi hmi
  have hf : B ∈ MainForward.faithfulLocalComponents T :=
    (Chapter1.Section02.Adequate.mem_faithfulLocalComponents_iff T B).mpr ⟨hBL,hBf⟩
  have hstar := (faithful B hBL hBf).2.2
  have hTB : (T : Subgroup G) ≤ normalizer (B : Set G) := hTH.trans hHN
  have horb : componentOrbit B (T : Subgroup G) = B :=
    le_antisymm (iSup_conjugates_le_of_le_normalizer B _ B le_rfl hTB)
      (le_componentOrbit B _)
  have hmax : IsMaximalTwoLocal (normalizer (B : Set G)) := by
    rw [←horb]
    exact (Chapter1.Section02.nonsolvable_uniqueness_knownSimple
      h.source.simpleQTKE T hstar).normalizer_maximal
  have hTh : ⁅B,elementaryAbelianMaxJ (T : Subgroup G)⁆ = B :=
    Chapter13.Section03.SourceCompletion.unitary_component_thompson_generation
      h.source.simpleQTKE T (F.Vi 1) F.H (normalizer (L : Set G))
      ((F.le_seed 1).trans h.chosen.le_sylow) hpCard (F.invariant 1) rfl C
      inferInstance hf hstar hHN hmax (h.maximal_unique_at structural).1
      (h.sylow_normalizes_at structural)
      (local_component_not_le_normalizer_at h structural F.H hH C hC)
  have hBCJ : (B.subgroupOf J).IsCComponent := hBC.subgroupOf_of_le hBJ hJH
  let : (B.subgroupOf J).Normal := normal_subgroupOf_of_le_normalizer hJN
  let eC := (C.equivMapOfInjective F.H.subtype F.H.subtype_injective).trans
    (subgroupOfEquivOfLe hBJ).symm
  let : IsQuasisimple ((B.subgroupOf J) ⧸ pCore 2 (B.subgroupOf J)) :=
    IsQuasisimple.of_mulEquiv (QuotientGroup.congr _ _ eC (pCore_map_iso 2 eC))
  have hcoreB : B.pCoreIn 2 ≤ F.H.pCoreIn 2 :=
    pCoreIn_mono_of_normalizes hBH hHN
  have hQB : J.pCoreIn 2 ≤ normalizer (B : Set G) := (pCoreIn_le 2 J).trans hJN
  have hBQ : B ≤ normalizer (J.pCoreIn 2 : Set G) :=
    hBJ.trans (J.le_normalizer.trans (normalizer_le_normalizer_intrinsicCore J))
  have hcomm : ⁅B,J.pCoreIn 2⁆ ≤ B.pCoreIn 2 :=
    (le_inf (le_normalizer_iff_commutator_le_left.mp hQB)
      (le_normalizer_iff_commutator_le_right.mp hBQ)).trans (inf_pCoreIn_le_of_le 2 hBJ)
  have hBU : B.pCoreIn 2 ≤ centralizer (V : Set G) := by
    intro q hq v hv
    exact (((mem_omegaOneCenterAmbient_iff _ _).mp
      (hω (le_conjugateSpanBy V F.H hv))).2.2 q (hcoreB hq)).symm
  have hQT : J.pCoreIn 2 ≤ (T : Subgroup G) := by
    have hh := pCoreIn_le_sylow J (T.subtype hTJ)
    simpa only [Sylow.coe_subtype,map_subgroupOf_eq_of_le hTJ] using hh
  have hcoreV : J.pCoreIn 2 ≤ centralizer (V : Set G) :=
    centralizes_elementary_eight_of_commuting_cubic_section V (F.Li L 1) (J.pCoreIn 2)
      h.seed_card (isPPerfect_embedded_pResidual 2 _)
      (pointResidual_core_quotient_card_at h structural)
      ((F.Li_le L 1).trans (inf_le_left.trans h.chosen.normalizes))
      (hQT.trans (by simpa only [F.last] using F.invariant 3))
      (isPGroup_pCoreIn 2 J) ((commutator_mono hin le_rfl).trans (hcomm.trans hBU))
      (by intro he; have hv := (seed_commutator h F).trans he
          have hh := h.seed_card; simp [hv] at hh)
  let : IsElementaryAbelian 2 UJ := IsElementaryAbelian.of_le hUU
  let : IsElementaryAbelian 2 (UJ.subgroupOf J) :=
    IsElementaryAbelian.subgroupOf hUJ
  let : (UJ.subgroupOf J).Normal :=
    normal_subgroupOf_of_le_normalizer (le_normalizer_conjugateSpanBy V J)
  have hgeni : B.subgroupOf J ⊔ (T : Subgroup G).subgroupOf J = ⊤ := by
    apply map_injective J.subtype_injective
    rw [Subgroup.map_sup,map_subgroupOf_eq_of_le hBJ,map_subgroupOf_eq_of_le hTJ,
      ←MonoidHom.range_eq_map,range_subtype]
  have hVR : V ≤ (reducedTwoSubgroup J).map J.subtype := by
    have hVJ : V ≤ J := h.chosen.le_sylow.trans hTJ
    have hcV : pCore 2 J ≤ centralizer (V.subgroupOf J : Set J) := by
      intro q hq v hv
      exact Subtype.ext (hcoreV (mem_map_of_mem J.subtype hq) v hv)
    have hmV : ⁅V.subgroupOf J,B.subgroupOf J⁆ ≠ ⊥ := by
      intro he
      have hh := congrArg (Subgroup.map J.subtype) he
      rw [map_commutator,map_subgroupOf_eq_of_le hVJ,
        map_subgroupOf_eq_of_le hBJ,Subgroup.map_bot] at hh
      have hv : V = ⊥ := bot_unique ((seed_commutator h F).le.trans
        ((commutator_mono le_rfl hin).trans hh.le))
      have hcard := h.seed_card
      simp [hv] at hcard
    have hr := seed_le_reduced_of_component_supplement (B.subgroupOf J)
      ((T : Subgroup G).subgroupOf J) (UJ.subgroupOf J) (V.subgroupOf J)
      hBCJ T.isPGroup'.comap_subtype hgeni
      (subgroupOf_mono J (le_conjugateSpanBy V J)) hcV hmV
    have hh := map_mono (f := J.subtype) hr
    rwa [map_subgroupOf_eq_of_le hVJ] at hh
  have hUR : UJ ≤ (reducedTwoSubgroup J).map J.subtype :=
    conjugateSpanBy_le hVR (by
      simpa only [normalizer_eq_top,←MonoidHom.range_eq_map,range_subtype] using
        (reducedTwoSubgroup J).le_normalizer_map J.subtype)
  have hUW : UJ ≤ W := hm.symm.le.trans (commutator_mono hUR le_rfl)
  have hpC : F.Vi 1 ≤ centralizer (B : Set G) := by
    apply le_centralizer_iff.mp
    exact hBH.trans (normalizer_le_centralizer_of_card_two (F.Vi 1) hpCard)
  have hfixed : W ⊓ centralizer (B : Set G) ≠ ⊥ := by
    intro he
    exact hp (le_bot_iff.mp ((le_inf (hpUJ.trans hUW) hpC).trans_eq he))
  let e := C.equivMapOfInjective F.H.subtype F.H.subtype_injective
  have hqB : IsQuasisimple (B ⧸ pCore 2 B) := IsQuasisimple.of_mulEquiv
    (QuotientGroup.congr _ _ e (pCore_map_iso 2 e))
  exact ⟨hf,hfixed,chosen_moved_of_thompson_component J B
    ((IsSQTK.equiv (subgroupOfEquivOfLe hJH)).mp
      ((h.source.simpleQTKE.twoLocal_sqtk htwo).subgroup (J.subgroupOf F.H))) hTJ hBJ hJN hBCJ hqB hBf.2
    rfl hTh hfixed⟩

end CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.OriginalComponentStatement.OutsideFiveContainment.PlaneMovementAt
