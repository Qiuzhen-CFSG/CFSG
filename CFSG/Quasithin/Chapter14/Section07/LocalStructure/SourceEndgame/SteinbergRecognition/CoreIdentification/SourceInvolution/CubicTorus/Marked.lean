module

public import CFSG.Quasithin.Chapter14.Section07.LocalStructure.SourceEndgame.SteinbergRecognition.CoreIdentification.SourceInvolution.Basic
public import CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.Source.Rechoice.LocalGeometry.Preparation.MarkedSpans

/-!
# An actual cubic torus in the original L₁

The earlier cubic actor has order three modulo the original O₂(H), but its
lift need not have order three. Its cube lies in that two-group kernel.
Taking a suitable two-power kills this kernel part; a further power restores
the exact original diagonal image. The resulting cyclic subgroup of L₁ has
order three. We also record the concrete Weyl matrix and its action.

The only earlier input here is `MarkedSpans.LocalActors`, whose cubic actor
is produced by qt-14-03/qt-14-07. No splitting or involutory lift is used.
The independent normalizer and dual fixed-space proofs consume this same
marked torus.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
14.7.64–65, printed pp.1069–1070, and the involution step of 14.7.72,
printed p.1076 (PDF p.1093).
-/

public section
noncomputable section
open Subgroup Representation Matrix.SpecialLinearGroup
open scoped commutatorElement
namespace CFSG.Quasithin.Chapter14.Section07.LocalStructure.SourceEndgame.SteinbergRecognition.CoreIdentification.SourceInvolution.CubicTorus
open Chapter12.Section08 CriticalFusion.Source
open CriticalFusion.Source.Rechoice.LocalGeometry.Preparation
universe u
variable {G : Type u} [Group G] [Finite G]
  {T : Sylow 2 G} {L V : Subgroup G} {F : InvariantFlag T V 3}
  {W : Type u} [AddCommGroup W] [Module (ZMod 2) W] (d : Data T L V F W)

private theorem prime_lift {A B : Type*} [Group A] [Group B]
    (f : A →* B) (hk : IsPGroup 2 f.ker) (l : A) (hl : orderOf (f l) = 3) :
    ∃ t : A, t ∈ zpowers l ∧ orderOf t = 3 ∧ f t = f l := by
  have hl3 : f (l ^ 3) = 1 := by rw [map_pow, ← hl, pow_orderOf_eq_one]
  obtain ⟨k, hk⟩ := hk ⟨l ^ 3, hl3⟩
  have hp : (l ^ (2 ^ k)) ^ 3 = 1 := by
    have h := congrArg Subtype.val hk
    simpa only [Subgroup.coe_pow, Subgroup.coe_one, ← pow_mul, Nat.mul_comm] using h
  have hcop : Nat.Coprime (2 ^ k) (orderOf (f l)) := by
    rw [hl]
    exact (by decide : Nat.Coprime 2 3).pow_left k
  obtain ⟨m, hm⟩ := exists_pow_eq_self_of_coprime (x := f l) hcop
  refine ⟨(l ^ (2 ^ k)) ^ m, pow_mem (pow_mem (mem_zpowers l) _) _, ?_, ?_⟩
  · apply orderOf_eq_prime
    · rw [← pow_mul, Nat.mul_comm m 3, pow_mul, hp, one_pow]
    · intro h
      have he : f ((l ^ (2 ^ k)) ^ m) = f l := by simpa only [map_pow] using hm
      rw [h, map_one] at he
      have ho : orderOf (f l) = 1 := orderOf_eq_one_iff.mpr he.symm
      omega
  · simpa only [map_pow] using hm

private theorem diag_cube (a : SL2FourNatural.F) (ha : a ≠ 0) :
    (diag2 a ha) ^ 3 = 1 := by
  have h3 : a ^ 3 = 1 := by
    have h := FiniteField.pow_card_sub_one_eq_one a ha
    simpa only [SL2FourNatural.card_field] using h
  have hi3 : (a⁻¹) ^ 3 = 1 := by rw [inv_pow, h3, inv_one]
  apply Subtype.ext
  rw [Matrix.SpecialLinearGroup.coe_pow, diag2_coe, Matrix.diagonal_pow]
  apply Matrix.ext
  intro i j
  fin_cases i <;> fin_cases j <;> simp [h3, hi3]

private theorem diag_order (a : SL2FourNatural.F) (ha : a ≠ 0) (ha1 : a ≠ 1) :
    orderOf (diag2 a ha) = 3 := by
  apply orderOf_eq_prime (diag_cube a ha)
  intro hh
  have h := congrArg (fun g : SL2FourNatural.SL => g 0 0) hh
  exact ha1 (by simpa [diag2_coe'] using h)

/-- An actual order-three L₁-generator with its unchanged original diagonal image.
The generator is constructed from the earlier cubic actor; no torus normalizer
or fixed-centralizer assertion is part of this interface. -/
structure MarkedTorus where
  generator : F.H
  generator_mem : (generator : G) ∈ F.Li L 1
  generator_order : orderOf generator = 3
  scalar : SL2FourNatural.F
  scalar_ne_zero : scalar ≠ 0
  scalar_ne_one : scalar ≠ 1
  image : d.qH generator = alternatingActor d.naturalQuotient
    (diag2 scalar scalar_ne_zero)

/-- The literal ambient cyclic subgroup generated by the marked lift. -/
@[expose] def MarkedTorus.torus (t : MarkedTorus d) : Subgroup G :=
  zpowers (t.generator : G)

/-- The actual torus is contained in the original L₁. -/
theorem MarkedTorus.torus_le (t : MarkedTorus d) : t.torus ≤ F.Li L 1 :=
  zpowers_le.mpr t.generator_mem

/-- The torus has order three in G, not just in the quotient. -/
theorem MarkedTorus.torus_card (t : MarkedTorus d) : Nat.card t.torus = 3 := by
  rw [MarkedTorus.torus, Nat.card_zpowers, Subgroup.orderOf_coe, t.generator_order]

/-- Remove the two-part of the earlier actor by taking powers, then recover
its original diagonal image by a further power coprime to three. -/
theorem exists_markedTorus (actors : MarkedSpans.LocalActors d) :
    Nonempty (MarkedTorus d) := by
  obtain ⟨l, hl, a, ha, ha1, he⟩ := actors.cubic
  have hi : Function.Injective (alternatingActor d.naturalQuotient) :=
    Subtype.val_injective.comp d.naturalQuotient.marking.injective
  have ho : orderOf (d.qH l) = 3 := by
    rw [he, orderOf_injective _ hi, diag_order a ha ha1]
  have hk : IsPGroup 2 d.qH.ker := by
    rw [d.qH_ker]
    exact (isPGroup_pCoreIn 2 F.H).comap_subtype
  obtain ⟨t, ht, hto, hte⟩ := prime_lift d.qH hk l ho
  have hl' : zpowers l ≤ (F.Li L 1).subgroupOf F.H := zpowers_le.mpr hl
  exact ⟨⟨t, hl' ht, hto, a, ha, ha1, hte.trans he⟩⟩

/-- The Weyl matrix, with its actual natural action. -/
def weyl : SL2FourNatural.SL := ⟨!![0, 1; 1, 0], by decide +kernel⟩

/-- Inversion fixes the concrete Weyl matrix. -/
theorem weyl_inv : weyl⁻¹ = weyl :=
  inv_eq_of_mul_eq_one_right (by decide +kernel : weyl * weyl = 1)

/-- The Weyl matrix inverts the original diagonal cubic. -/
theorem weyl_diag (a : SL2FourNatural.F) (ha : a ≠ 0) :
    weyl * diag2 a ha * weyl⁻¹ = (diag2 a ha)⁻¹ := by
  rw [weyl_inv, diag2_inv]
  apply Subtype.ext
  simp only [Matrix.SpecialLinearGroup.coe_mul, diag2_coe']
  apply Matrix.ext
  intro i j
  fin_cases i <;> fin_cases j <;>
    simp [weyl, Matrix.mul_apply, Fin.sum_univ_two]

/-- The concrete Weyl matrix exchanges the two natural coordinate lines. -/
theorem weyl_action (v : SL2FourNatural.V) :
    SL2FourNatural.action weyl v = ![v 1, v 0] := by
  rw [SL2FourNatural.action_apply]
  funext i
  fin_cases i <;> simp [weyl, Matrix.mulVec, dotProduct, Fin.sum_univ_two]


end CFSG.Quasithin.Chapter14.Section07.LocalStructure.SourceEndgame.SteinbergRecognition.CoreIdentification.SourceInvolution.CubicTorus
