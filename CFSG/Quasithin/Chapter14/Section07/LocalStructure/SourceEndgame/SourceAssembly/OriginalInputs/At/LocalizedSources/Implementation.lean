/-!
# The original Rudvalis source with the local 14.7.10 proof

The existing source47, module-row and Data proofs transmit a universal
`Earlier14710` input. Their unique actual use is the original extraspecial
Baumann normalizer lemma. `Local14710Source.extraspecial_baumann_normalizer`
proves that leaf from the structural predecessor at the same G,T.

The internal `import all` edges deliberately expose the existing compiled
proofs, without re-exporting their private implementation scopes. The narrow
elaborator below removes exactly the literal `Earlier14710` argument, shares
private specialized declarations, and substitutes only the proved local leaf.
It checks the removed argument's original binder position and the replacement
leaf's full original type with that one argument deleted. Any other direct use
of the earlier proof is rejected. Every result is checked against its exact
specialized type and then independently submitted to Lean's ordinary kernel.

The shared closure consists of ordinary private theorems and the one existing
Mathieu setup constructor, whose safe status and reducibility metadata are
preserved. Its body changes only by specialization of proof dependencies.
There is no conversion from a same-Sylow theorem to a universal theorem and no
new axiom. All original source files and public contracts remain unchanged.
Only the four ordinary endpoint theorems form the public interface.

Source: Aschbacher--Smith 14.7.10,14.7.16(7),14.7.41--75 and J.1.1,
printed pp.1045,1048,1061--1078, refs/quasithin.pdf.
-/

open Lean Meta Elab Tactic

namespace CFSG.Quasithin.Chapter14.Section07.LocalStructure.SourceEndgame.SourceAssembly.Localized14710
universe u
open scoped IsMulCommutative

private theorem leaf
    {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    {F : CFSG.Quasithin.Chapter12.Section08.InvariantFlag T V 3}
    (_d : CFSG.Quasithin.Chapter13.Section08.TransvectionRecognition.Component.ModelExtension.Counterexample T L)
    (h : CFSG.Quasithin.Chapter12.Section08.HigherRankHypothesis
      CFSG.KnownSimple.IsKnownSimple T L V 3)
    (hab : IsMulCommutative F.U)
    (structural : CFSG.Quasithin.Chapter12.Section02.Structural1222At CFSG.KnownSimple.IsKnownSimple T)
    (previous : CFSG.Quasithin.Chapter12.Section02.Theorem12213At CFSG.KnownSimple.IsKnownSimple T)
    (he : Nonempty (((CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.Source.K F) ⧸
      pCore 2 (CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.Source.K F)) ≃*
        HeisenbergPrime 3)) :
    Subgroup.normalizer (CFSG.Quasithin.ChapterB.baumann (F.Ri L 1) : Set G) ≤
      Subgroup.normalizer (L : Set G) :=
  CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.WholeResidualAssembly.Local14710Source.extraspecial_baumann_normalizer
    h hab structural previous he

private meta def marker : Name :=
  ``CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.Source.ResidualNormalizer.LocalControl.Earlier14710

private meta def oldLeaf : Name :=
  ``CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.WholeResidualAssembly.GuardedSource.extraspecial_baumann_normalizer

mutual
private meta partial def specialize (owner n : Name) : MetaM Name := withoutExporting do
  let nn := mkPrivateName (← getEnv) (owner ++ `specialized ++ n)
  if (← getEnv).contains nn then return nn
  unless (privateToUserName n).toString.startsWith
      "CFSG.Quasithin.Chapter14.Section07.LocalStructure." do
    throwError "Declaration outside original 14.7 source proof cone: {n}"
  let ci ← getConstInfo n
  unless ci.type.getUsedConstants.contains marker do
    throwError "Refusing declaration without exact Earlier14710 binder: {n}"
  let expected ← typeBinders owner none ci.type
  if n == oldLeaf then
    let replacement := mkConst ``leaf (ci.levelParams.map Level.param)
    unless ← isDefEq (← inferType replacement) expected do
      throwError "Local leaf fails exact original type-minus-earlier check"
    return ``leaf
  let some v := ci.value? true | throwError "No compiled proof available: {n}"
  let value ← binders owner none v
  let actual ← inferType value
  unless ← isDefEq actual expected do
    throwError "Specialized proof has unexpected type for {n}:\n{actual}\nExpected:\n{expected}"
  if value.hasFVar || expected.hasFVar || value.hasMVar || expected.hasMVar then
    throwError "Open expression after specializing {n}"
  if expected.getUsedConstants.contains marker || value.getUsedConstants.contains marker then
    throwError "Universal Earlier14710 survived type of {n}"
  if ← isProp expected then
    addDecl (.thmDecl {name := nn, levelParams := ci.levelParams, type := expected, value := value})
  else
    unless n == ``CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.SourceConstruction.LocalReduction.localMathieuSetupAt do
      throwError "Unsupported non-theorem specialization: {n}"
    let .defnInfo original := ci | throwError "Expected an original definition for {n}"
    unless original.safety == .safe do throwError "Refusing unsafe original definition {n}"
    addDecl (.defnDecl { name := nn, levelParams := ci.levelParams, type := expected, value := value, hints := original.hints, safety := original.safety })
  return nn

private meta partial def binders (owner : Name) (bad : Option FVarId) (e : Expr) : MetaM Expr := do
  if let .lam n t b bi := e then
    if t.isConstOf marker then
      if bad.isSome then throwError "Multiple Earlier14710 binders"
      return ← withLocalDecl n bi t fun x => binders owner (some x.fvarId!) (b.instantiate1 x)
    let t ← match bad with | some bad => rewrite owner bad t | none => pure t
    withLocalDecl n bi t fun x => do
      mkLambdaFVars #[x] (← binders owner bad (b.instantiate1 x))
  else if let some bad := bad then rewrite owner bad e
  else throwError "No literal Earlier14710 lambda binder"

private meta partial def typeBinders (owner : Name) (bad : Option FVarId) (e : Expr) : MetaM Expr := do
  if let .forallE n t b bi := e then
    if t.isConstOf marker then
      if bad.isSome then throwError "Multiple Earlier14710 type binders"
      return ← withLocalDecl n bi t fun x => typeBinders owner (some x.fvarId!) (b.instantiate1 x)
    let t ← match bad with | some bad => rewrite owner bad t | none => pure t
    withLocalDecl n bi t fun x => do
      mkForallFVars #[x] (← typeBinders owner bad (b.instantiate1 x))
  else if let some bad := bad then rewrite owner bad e
  else throwError "No literal Earlier14710 forall binder"

private meta partial def rewrite (owner : Name) (bad : FVarId) (e : Expr) : MetaM Expr := do
  if !(e.find? fun x => x.isFVar && x.fvarId! == bad).isSome then return e
  let f := e.getAppFn
  let args := e.getAppArgs
  let hits := args.filter (fun x => x.isFVar && x.fvarId! == bad)
  if let .const n ls := f then
    if !hits.isEmpty then
      unless hits.size == 1 do throwError "Repeated Earlier14710 argument to {n}"
      let ci ← getConstInfo n
      let mut type := ci.type
      let mut position := 0
      let mut marked : Array Nat := #[]
      while let .forallE _ domain body _ := type do
        if domain.isConstOf marker then marked := marked.push position
        position := position + 1
        type := body
      unless marked.size == 1 do
        throwError "Expected one literal Earlier14710 binder in applied constant {n}"
      let index := marked[0]!
      unless index < args.size && args[index]!.isFVar && args[index]!.fvarId! == bad do
        throwError "Earlier14710 argument changed position in {n}"
      let nn ← specialize owner n
      return ← rewrite owner bad (mkAppN (.const nn ls)
        (args.filter (fun x => !(x.isFVar && x.fvarId! == bad))))
  match e with
  | .app f a => return .app (← rewrite owner bad f) (← rewrite owner bad a)
  | .lam n t b bi => return .lam n (← rewrite owner bad t) (← rewrite owner bad b) bi
  | .forallE n t b bi => return .forallE n (← rewrite owner bad t) (← rewrite owner bad b) bi
  | .letE n t v b nc =>
    return .letE n (← rewrite owner bad t) (← rewrite owner bad v) (← rewrite owner bad b) nc
  | .mdata md b => return .mdata md (← rewrite owner bad b)
  | .proj n i b => return .proj n i (← rewrite owner bad b)
  | _ => throwError "Unsupported direct Earlier14710 application: {e}"
end

end CFSG.Quasithin.Chapter14.Section07.LocalStructure.SourceEndgame.SourceAssembly.Localized14710


set_option maxRecDepth 8192 in
set_option maxHeartbeats 20000000 in
open Lean Elab Command in
run_cmd do
  liftTermElabM do
    discard <| CFSG.Quasithin.Chapter14.Section07.LocalStructure.SourceEndgame.SourceAssembly.Localized14710.specialize `Localized14710
      ``CFSG.Quasithin.Chapter14.Section07.LocalStructure.SourceEndgame.SourceAssembly.FullSource.source_rudvalis_of_original_module_sources_at

elab "localize_earlier14710% " n:ident : term => do
  let name ← realizeGlobalConstNoOverloadWithInfo n
  let nn := mkPrivateName (← getEnv) (`Localized14710 ++ `specialized ++ name)
  unless (← getEnv).contains nn do throwError "Endpoint was not pre-specialized: {name}"
