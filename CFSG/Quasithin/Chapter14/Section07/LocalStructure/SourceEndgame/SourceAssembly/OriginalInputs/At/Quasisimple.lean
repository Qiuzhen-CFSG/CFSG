module
public import CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.Source.ResidualFusion.FixedCentralizers.Quasisimple.CompleteSource
public import CFSG.Quasithin.Chapter12.Section02.SourceApplications

/-!
# The original quasisimple fixed component without universal structure

The literal chosen module already gives T-normalization of L. Thus the
normalizer of V in the recognized Rudvalis cover lies in L. Its actual
quotient action gives an index-two factorization, and two-perfectness
identifies it with L. Its center is the original line generated by u;
T-invariance contradicts the proved Sylow configuration in C_G(u).

The marked cover and normalizer model are constructed by the checked
original-component source theorems. Only the preceding residual-normalizer
identity, maximality and point commutator are retained for the same Data.
Source: AS 14.7.67(4–5), 14.7.68(2), printed pp.1070–1072.
-/

public noncomputable section
open Subgroup Representation Theory.GroupTheory
namespace CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.Source.Data
open Chapter12.Section08
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  {F : InvariantFlag T V 3} {W : Type u} [AddCommGroup W] [Module (ZMod 2) W]
  (d : Data T L V F W)

private theorem twoPerfect_le_of_index_dvd_two {X : Type*} [Group X] [Finite X]
    (A B : Subgroup X) (hp : IsPPerfect 2 A) (hi : B.index ∣ 2) : A ≤ B := by
  have hc := (Nat.dvd_prime (by decide : Nat.Prime 2)).mp hi
  rcases hc with hc | hc
  · rw [index_eq_one.mp hc]
    exact le_top
  · let := B.normal_of_index_eq_two hc
    have hquot : IsPGroup 2 (X ⧸ B) := IsPGroup.of_card (n := 1) (by
      simpa only [index_eq_card, pow_one] using hc)
    exact (le_pResidual_of_isPPerfect A hp).trans (sInf_le ⟨inferInstance, hquot⟩)

/-- 67(5) and two-perfectness place the actual local normalizer in L. -/
theorem fixedComponentNormalizer_le_L_from_chosen
    (earlier : d.ModuleSeparation)
    (Lu : Subgroup G) (hp : IsPPerfect 2 (d.fixedComponentNormalizer Lu)) :
    d.fixedComponentNormalizer Lu ≤ L := by
  have hle : d.fixedComponentNormalizer Lu ≤ L ⊔ (T : Subgroup G) := by
    rw [d.lemma_14_7_67_five earlier]
    exact inf_le_right
  have hr := embedded_pResidual_mono 2 hle
  rw [(pResidual_eq_top_iff 2 _).mpr hp, ← MonoidHom.range_eq_map, range_subtype,
    embedded_pResidual_join_pGroup L (T : Subgroup G)
      ((pResidual_eq_top_iff 2 _).mp d.natural.residual) T.isPGroup'
      d.natural.chosen.sylow_normalizes_component] at hr
  exact hr


/-- The source index-two argument identifies the local normalizer with L.
Its hypotheses are the intrinsic perfectness and quotient model, not the
ambient identification being proved. -/
theorem fixedComponentNormalizer_eq_L_from_chosen
    (earlier : d.ModuleSeparation)
    (u : F.U) (hu : (u : G) ∈ d.U₀) (hne : (u : G) ≠ 1)
    (hfix : d.FixedModuloPoint u) (hmax : IsMaximalTwoLocal F.H)
    {Lu : Subgroup G} (hLu : Lu ≤ d.fixedCentralizer u)
    (hn : (Lu.subgroupOf (d.fixedCentralizer u)).Normal) (hout : ¬ Lu ≤ F.H)
    (hp : IsPPerfect 2 (d.fixedComponentNormalizer Lu))
    (e : (d.fixedComponentNormalizer Lu ⧸ pCore 2 (d.fixedComponentNormalizer Lu)) ≃* MulAut V) :
    d.fixedComponentNormalizer Lu = L := by
  let N := normalizer (V : Set G)
  let J := d.fixedComponentNormalizer Lu
  have hLN : L ≤ N := d.natural.chosen.normalizes
  have hTN : (T : Subgroup G) ≤ N := by simpa only [F.last] using F.invariant 3
  have hJG : J ≤ d.fixedCentralizer u := inf_le_left.trans hLu
  have hJL : J ≤ L := d.fixedComponentNormalizer_le_L_from_chosen earlier Lu hp
  have hindex : (d.fixedCentralizer u).relIndex N ∣ 2 := by
    have hi := d.fixedSylow_index_two_of_escape u hu hne hfix hmax
      (fun h => hout (hLu.trans h))
    have hid : (d.fixedSylow u).relIndex (T : Subgroup G) ∣ 2 := by rw [hi]
    obtain ⟨a, ha, hacoset⟩ := relIndex_dvd_two_iff.mp hid
    apply relIndex_dvd_two_iff.mpr
    refine ⟨a, hTN ha, ?_⟩
    intro x hx
    obtain ⟨j, hj, t, ht, rfl⟩ := d.fixedComponentNormalizer_factorization earlier Lu e x hx
    rcases hacoset t ht with hta | ht'
    · exact Or.inl (by simpa only [mul_assoc] using
        (d.fixedCentralizer u).mul_mem (hJG hj) hta.2)
    · exact Or.inr ((d.fixedCentralizer u).mul_mem (hJG hj) ht'.2)
  have hLG : L ≤ d.fixedCentralizer u := by
    have hpL : IsPPerfect 2 (L.subgroupOf N) :=
      ((pResidual_eq_top_iff 2 _).mp d.natural.residual).of_surjective
        (subgroupOfEquivOfLe hLN).symm.toMonoidHom (subgroupOfEquivOfLe hLN).symm.surjective
    have hc := twoPerfect_le_of_index_dvd_two (L.subgroupOf N)
      ((d.fixedCentralizer u).subgroupOf N) hpL hindex
    intro x hx
    exact hc (show (⟨x, hLN hx⟩ : N) ∈ L.subgroupOf N from hx)
  have hJn : (J.subgroupOf L).Normal := by
    apply (normal_subgroupOf_iff_le_normalizer hJL).mpr
    exact (le_inf (hLG.trans ((normal_subgroupOf_iff_le_normalizer hLu).mp hn))
      (hLN.trans N.le_normalizer)).trans inf_normalizer_le_normalizer_inf
  let := hJn
  have hsup : J.subgroupOf L ⊔ (T : Subgroup G).subgroupOf L = ⊤ := by
    apply top_unique
    intro x _
    obtain ⟨j, hj, t, ht, he⟩ := d.fixedComponentNormalizer_factorization earlier Lu e x (hLN x.property)
    have htL : t ∈ L := by
      have hh := L.mul_mem (L.inv_mem (hJL hj)) x.property
      simpa only [he, inv_mul_cancel_left] using hh
    have heL : x = (⟨j, hJL hj⟩ : L) * ⟨t, htL⟩ := Subtype.ext he
    rw [heL]
    exact mul_mem_sup hj ht
  have hquot := isPGroup_quotient_of_sup_eq_top (J.subgroupOf L)
    ((T : Subgroup G).subgroupOf L) T.isPGroup'.comap_subtype hsup
  have ht : J.subgroupOf L = ⊤ :=
    top_unique (d.natural.residual ▸ (show pResidual 2 L ≤ J.subgroupOf L from
      sInf_le ⟨hJn, hquot⟩))
  have hm := congrArg (map L.subtype) ht
  simpa only [map_subgroupOf_eq_of_le hJL, ← MonoidHom.range_eq_map, range_subtype] using hm


/-- The actual quasisimple branch of 14.7.68, using the supplied Data's
chosen module instead of a universal structural theorem. -/
theorem false_of_quasisimple_fixedComponent_from_chosen
    (u : F.U) (hu : (u : G) ∈ d.U₀) (hne : (u : G) ≠ 1)
    (hfix : d.FixedModuloPoint u) (hNK : normalizer (K F : Set G) = F.H)
    (hmax : IsMaximalTwoLocal F.H)
    (hsyl : Chapter1.IsSylowIn 2 (d.fixedSylow u) (d.fixedCentralizer u))
    (Lu : Subgroup G) (hLu : Lu ≤ d.fixedCentralizer u)
    (hc : (Lu.subgroupOf (d.fixedCentralizer u)).IsCComponent)
    (hn : (Lu.subgroupOf (d.fixedCentralizer u)).Normal)
    (hKLu : K F < Lu) (hout : ¬ Lu ≤ F.H) (hq : IsQuasisimple Lu)
    (hcomm : ⁅F.U,F.H.pCoreIn 2⁆ = F.Vi 1) : False := by
  have earlier := Rechoice.SourceCompletion.moduleSeparation d
  obtain ⟨r⟩ := d.fixedRudvalisCover_of_original_component u hu hne hfix hNK hmax
    hsyl Lu hLu hc hn hKLu hout hq hcomm
  obtain ⟨hp,⟨e⟩,hcenter⟩ := d.fixedNormalizer_model_of_rudvalisCover earlier
    u hu hne hfix hNK hmax hsyl Lu hLu hc hn hKLu hout hq r
  have heq := d.fixedComponentNormalizer_eq_L_from_chosen earlier
    u hu hne hfix hmax hLu hn hout hp e
  have hz := d.fixed_componentNormalizer_center u hne hLu r.mem_component hcenter
  rw [heq] at hz
  apply d.fixed_line_not_T_invariant u hu hne hmax (fun h => hout (hLu.trans h)) hsyl
  rw [← hz]
  exact d.natural.chosen.sylow_normalizes_component.trans
    (normalizer_le_normalizer_characteristic_image L (center L))

end CFSG.Quasithin.Chapter14.Section07.LocalStructure.CriticalFusion.Source.Data
