module
public import CFSG.Quasithin.Chapter14.Section03.NonabelianSource.Recognition.QuaternionClosure
public import Theory.GroupTheory.CoprimeCentralizerDecomposition
public import Theory.GroupTheory.PResidual.PerfectCover

/-! The actual closure is generated by commutators with a Sylow three-group:
its fixed subgroup is the marked center, hence lies in its Frattini subgroup.
This puts U inside the embedded two-residual of H, as needed in14.3.18(5). -/

@[expose] public noncomputable section
open Subgroup Module Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter14.Section03.NonabelianSource.Recognition
open Chapter12.Section08 Chapter12.Section08.InvariantFlag
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {V : Subgroup G}

theorem U_le_embedded_twoResidual_of_full_orthogonal (F : InvariantFlag T V 2)
    [IsElementaryAbelian 2 V] [IsElementaryAbelian 2 F.Uhat]
    (d : ClosureGeometry F) (hZ : F.ZU=F.Vi 1) (hne : ¬IsMulCommutative F.U)
    (hr : ChapterG.Section09.FittingRecognition.OrthogonalRealization F.terminalRepresentation ⊤) :
    F.U ≤ (pResidual 2 F.H).map F.H.subtype := by
  let : IsExtraspecial 2 F.U := extraspecial_of_center_point F d (by omega) hZ hne
  let P : Sylow 3 F.H := default
  let q := QuotientGroup.mk' F.terminalHatAction.ker
  let P' := P.mapSurjective (f:=q) (QuotientGroup.mk'_surjective _)
  let action : F.H →* MulAut F.U := F.U.normalizerMonoidHom.comp
    (inclusion (le_normalizer_conjugateSpanBy V F.H))
  let : MulDistribMulAction P F.U := MulDistribMulAction.compHom F.U (action.comp (P : Subgroup F.H).subtype)
  have hfixed : ∀u:F.U, (∀a:P,a • u=u) ↔ u∈center F.U := by
    intro u
    constructor
    · intro hfix
      have hdot : ∀ a ∈ (P' : Subgroup F.TerminalHdot),
          F.terminalRepresentation a (Additive.ofMul (QuotientGroup.mk' (center F.U) u))=
            Additive.ofMul (QuotientGroup.mk' (center F.U) u) := by
        rintro a ⟨b,hb,rfl⟩
        apply Additive.toMul.injective
        rw [F.terminalRepresentation_apply_mk]
        change F.terminalHatAction b (QuotientGroup.mk' (center F.U) u) =
          QuotientGroup.mk' (center F.U) u
        rw [F.terminalHatAction_apply_mk]
        exact congrArg (QuotientGroup.mk' (center F.U)) (hfix ⟨b,hb⟩)
      have hz := ChapterG.Section09.FittingRecognition.Four.sylow_three_fixed_eq_zero_of_full_orthogonal
        F.terminalRepresentation hr P' _ hdot
      apply (QuotientGroup.eq_one_iff u).mp
      exact hz
    · intro hu a
      apply Subtype.ext
      change ((a.val : F.H) : G) * (u : G) * (((a.val : F.H) : G))⁻¹=(u : G)
      have hp : (u : G) ∈ F.Vi 1 := by
        rw [←hZ]
        exact mem_map_of_mem F.U.subtype hu
      have hcentral : (a.val : F.H).val ∈ centralizer (F.Vi 1 : Set G) :=
        normalizer_le_centralizer_of_card_two _ (by simpa using F.card 1 (by omega)) a.val.property
      have hh := hcentral (u:G) hp
      calc
        _ = (u:G) * (((a.val : F.H) : G) * (((a.val : F.H) : G))⁻¹) := by rw [←hh]; group
        _ = (u:G) := by simp
  
  let PH := (P:Subgroup F.H)
  let PG := PH.map F.H.subtype
  have hn : PG≤normalizer (F.U:Set G) := (map_subtype_le PH).trans
    (le_normalizer_conjugateSpanBy V F.H)
  have hcop : Nat.Coprime (Nat.card PG) (Nat.card F.U) :=
    IsPGroup.coprime_card_of_ne 3 2 (by decide) PG F.U (P.isPGroup'.map F.H.subtype) d.two
  have hC : F.U⊓centralizer (PG:Set G)≤(frattini F.U).map F.U.subtype := by
    rintro u ⟨hu,hc⟩
    refine ⟨⟨u,hu⟩,?_,rfl⟩
    rw [IsExtraspecial.frattini_eq_center_two]
    apply (hfixed ⟨u,hu⟩).mp
    intro a
    apply Subtype.ext
    change ((a.val:F.H):G)*u*(((a.val:F.H):G))⁻¹=u
    have he : ((a.val:F.H):G)*u=u*((a.val:F.H):G) :=
      hc _ (mem_map_of_mem F.H.subtype a.property)
    rw [he,mul_inv_cancel_right]
  have hsplit : F.U=⁅F.U,PG⁆⊔(F.U⊓centralizer (PG:Set G)) :=
    eq_commutator_sup_centralizer_of_solvable_coprime F.U PG hn
      (@IsNilpotent.to_isSolvable _ _ d.two.isNilpotent) hcop
  have hJU : ⁅F.U,PG⁆≤F.U := le_normalizer_iff_commutator_le_left.mp hn
  have htop : (⁅F.U,PG⁆.subgroupOf F.U)⊔frattini F.U=⊤ := by
    apply (Subgroup.map_injective (f:=F.U.subtype) F.U.subtype_injective)
    rw [Subgroup.map_sup,map_subgroupOf_eq_of_le hJU,←MonoidHom.range_eq_map,F.U.range_subtype]
    exact le_antisymm (sup_le hJU (map_subtype_le _))
      (hsplit.le.trans (sup_le_sup_left hC _))
  have hJ : ⁅F.U,PG⁆=F.U := by
    have he := congrArg (Subgroup.map F.U.subtype) (frattini_nongenerating htop)
    simpa only [map_subgroupOf_eq_of_le hJU,←MonoidHom.range_eq_map,F.U.range_subtype] using he
  have hP : PH≤pResidual 2 F.H := by
    intro x hx
    apply mem_pResidual_of_orderOf_coprime
    have hc := P.isPGroup'.orderOf_coprime (by decide : Nat.Coprime 3 2) (⟨x,hx⟩:P)
    rw [←Subgroup.orderOf_coe] at hc
    exact hc.symm
  have hPG : PG≤(pResidual 2 F.H).map F.H.subtype := map_mono hP
  rw [←hJ]
  let UH := F.U.subgroupOf F.H
  have hUH : UH.map F.H.subtype=F.U := map_subgroupOf_eq_of_le F.U_le_H
  have hm := map_mono (f:=F.H.subtype)
    (show ⁅UH,pResidual 2 F.H⁆≤pResidual 2 F.H from commutator_le_right _ _)
  rw [map_commutator,hUH] at hm
  exact (commutator_mono le_rfl hPG).trans hm

end CFSG.Quasithin.Chapter14.Section03.NonabelianSource.Recognition
