module
public import CFSG.Quasithin.Chapter14.Section03.NonabelianSource.Recognition.FactorNormalizerSylow
public import CFSG.Quasithin.Chapter14.Section03.NonabelianSource.Recognition.OriginalSolvable
public import Theory.GroupTheory.SylowLocalCore
public import Theory.GroupTheory.PResidual.SylowSupplement
public import Theory.GroupTheory.TransitiveInvolutionNormalizer
public import Theory.Representation.BinaryPermutation.SixTransitivity
public import CFSG.Quasithin.Chapter14.Section03.NonabelianSource.Recognition.FactorBlockCore

/-!
# Normalizers of the original alternating-six block

The literal natural A₆ action is transitive on the nonidentity elements of
A. Correcting an arbitrary element of N_G(A) by K therefore puts it in the
original point normalizer H. Its intersection N_H(A) is generated by its
two-residual Y and the actual Sylow subgroup RQ. Both normalize K: R and Y
lie in K, while Q normalizes the two residual generators of K. Thus N_G(A)
normalizes K. The characteristic identity O₂(K)=A gives the reverse inclusion.

Finally Q=U D, where D=Q∩C_G(U), and R,U,Y lie in K, giving N_G(K)=K D.
All actions and subgroups remain the original ones. The product identity
does not classify D or invoke a model for the whole automorphism group.

Source: Aschbacher–Smith, Quasithin Groups, 14.3.19(6)–(7), printed p.997.
-/

@[expose] public noncomputable section
open Subgroup Module Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter14.Section03.NonabelianSource.Recognition
open Chapter12.Section08 Chapter12.Section08.InvariantFlag
open Chapter14.Section02 SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
variable {G:Type*} [Group G] [Finite G]

/-- The original factor and its generated block have the same normalizer,
which is generated by the block and the original centralizing supplement. -/
theorem factor_block_normalizer_of_full_orthogonal
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hnot : ¬ ClassificationModels.IsTheoremEModel G)
    (F : InvariantFlag T (rankTwoSeed T M) 2)
    [IsElementaryAbelian 2 (rankTwoSeed T M)] [IsElementaryAbelian 2 F.Uhat]
    (dg : ClosureGeometry F) (hZ : F.ZU=F.Vi 1) (hne : ¬ IsMulCommutative F.U)
    (g : G) (hgP : g∈F.P (sourceResidual M Mc)) (hgH : g∉F.H)
    (hr : ChapterG.Section09.FittingRecognition.OrthogonalRealization F.terminalRepresentation ⊤)
    (A:Subgroup G) [IsElementaryAbelian 2 A]
    (hAR:A≤(F.I₂ (sourceResidual M Mc)).pCoreIn 2)
    (hVA:rankTwoSeed T M≤A) (hAc:Nat.card A=16)
    (hc8:Nat.card (A⊓F.U:Subgroup G)=8)
    (hAN:F.I₂ (sourceResidual M Mc)⊔F.H.pCoreIn 2≤normalizer (A:Set G)) :
    let N := F.H⊓normalizer (A:Set G)
    let Y := (pResidual 2 N).map N.subtype
    let K := sourceResidual M Mc⊔Y
    normalizer (K:Set G) = K ⊔ (F.H.pCoreIn 2 ⊓ centralizer (F.U:Set G)) ∧
      normalizer (A:Set G) = normalizer (K:Set G) := by
  intro N Y K
  let R := (F.I₂ (sourceResidual M Mc)).pCoreIn 2
  let Q := F.H.pCoreIn 2
  let S := R⊔Q
  let NG := normalizer (A:Set G)
  let D := Q⊓centralizer (F.U:Set G)
  let h := source_lemma_14_2_4 hG T hempty hM hu hmany hcard e
  obtain ⟨B,hBR,hEB,hAB,hRc⟩ : ∃ B:Subgroup G, B≤R ∧ IsElementaryAbelian 2 B ∧
      A⊔B=R ∧ Nat.card R=64 := by
    obtain ⟨C,B,hCR,hBR,hVC,hVB,hEC,hEB,hCc,hBc,hCBi,hCB,hRc,hCN,hBN,hmax⟩ :=
      maximal_elementary_factors_of_full_orthogonal hG T hempty hM hu hmany hcard e hnot
        F dg hZ hne g hgP hgH hr
    rcases hmax A inferInstance hAR with hac|hab
    · have heq:A=C := eq_of_le_of_card_ge hac (by rw [hAc,hCc])
      exact ⟨B,hBR,hEB,by simpa [heq] using hCB,hRc⟩
    · have heq:A=B := eq_of_le_of_card_ge hab (by rw [hAc,hBc])
      exact ⟨C,hCR,hEC,by simpa [heq,sup_comm] using hCB,hRc⟩
  let := hEB
  have hcore:K.pCoreIn 2=A := (factor_block_core_of_full_orthogonal
    hG T hempty hM hu hmany hcard e hnot F dg hZ hne g hgP hgH hr
    A B hAR hBR hVA hAc hc8 hAB hRc hAN).1
  obtain ⟨hKA,eA,qA,hqA⟩ := factor_alternating_natural_action_of_full_orthogonal
    hG T hempty hM hu hmany hcard e hnot F dg hZ hne g hgP hgH hr
    A B hAR hBR hVA hAc hc8 hAB hRc hAN
  have hNK:normalizer (K:Set G)≤NG := by
    have hh := normalizer_le_normalizer_characteristic_image K (pCore 2 K)
    change normalizer (K:Set G)≤normalizer (K.pCoreIn 2:Set G) at hh
    rwa [hcore] at hh
  have hFrattini:NG=K⊔N := normalizer_eq_sup_point_normalizer_of_transitive
    A K (F.Vi 1) hKA ((F.le_seed 1).trans hVA) (by simpa using F.card 1 (by decide))
    (BinaryPermutation.exists_conjugator_of_alternatingSix_natural_action A K hKA eA qA hqA)
  have hRU:R⊔F.U≤K := (factor_generated_residual_geometry_of_full_orthogonal
    hG T hempty hM hu hmany hcard e hnot F dg hZ hne g hgP hgH hr
    A hAR hVA hAc hc8 hAN).2.2.1
  have hRT:R≤(T:Subgroup G) := (parabolic_core_sylow_index_of_full_orthogonal
    hG T hempty hM hu hmany hcard e hnot F dg hZ hne g hgP hgH hr).1
  have hTH:(T:Subgroup G)≤F.H := F.invariant 1
  have hQT:Q≤(T:Subgroup G) := by
    have hh := pCoreIn_le_sylow F.H (T.subtype hTH)
    change Q≤((T:Subgroup G).subgroupOf F.H).map F.H.subtype at hh
    rwa [map_subgroupOf_eq_of_le hTH] at hh
  have hQN:Q≤N := le_inf (pCoreIn_le 2 _) (le_sup_right.trans hAN)
  have hQK:Q≤normalizer (K:Set G) :=
    (le_inf (hQT.trans h.sylow_normalizes_L)
      (hQN.trans (le_normalizer_embedded_pResidual 2 N))).trans
        (normalizer_inf_normalizer_le_normalizer_sup _ _)
  have hSN:S≤N := le_inf ((sup_le hRT hQT).trans hTH)
    ((sup_le_sup (pCoreIn_le 2 _) le_rfl).trans hAN)
  obtain ⟨_,_,P,hP⟩ := factor_normalizer_sylow_of_full_orthogonal
    hG T hempty hM hu hmany hcard e hnot F dg hZ hne g hgP hgH hr
    A hAR hVA hAc hc8 hAN
  obtain ⟨PN,hPN⟩ := P.exists_map_subtype_eq_of_le (H:=N) inf_le_right (by rw [hP];exact hSN)
  have hNS:N=Y⊔S := by
    have hh := congrArg (Subgroup.map N.subtype) (pResidual_sup_sylow_eq_top PN)
    rw [Subgroup.map_sup,←MonoidHom.range_eq_map,range_subtype,hPN,hP] at hh
    exact hh.symm
  have hRK:R≤K := le_sup_left.trans hRU
  have hYK:Y≤K := le_sup_right
  have hNGK:NG≤normalizer (K:Set G) := by
    rw [hFrattini,hNS]
    exact sup_le K.le_normalizer (sup_le (hYK.trans K.le_normalizer)
      (sup_le (hRK.trans K.le_normalizer) hQK))
  have hNGQ:NG=K⊔Q := by
    apply le_antisymm
    · rw [hFrattini,hNS]
      exact sup_le le_sup_left (sup_le (hYK.trans le_sup_left)
        (sup_le (hRK.trans le_sup_left) le_sup_right))
    · exact sup_le hKA (le_sup_right.trans hAN)
  obtain ⟨dU⟩ := quaternion_closure_of_full_orthogonal F dg hZ hne hr
  have hQD:Q=F.U⊔D := core_eq_U_sup_centralizer F dg hZ dU
  have hprod:NG=K⊔D := by
    rw [hNGQ,hQD,←sup_assoc,sup_eq_left.mpr (show F.U≤K from le_sup_right.trans hRU)]
  exact ⟨(le_antisymm hNK hNGK).trans hprod,(le_antisymm hNGK hNK)⟩

/-- The chosen-factor normalizer identities under the original solvable-source hypotheses. -/
theorem source_factor_block_normalizer_of_solvable
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hnot : ¬ ClassificationModels.IsTheoremEModel G)
    (F : InvariantFlag T (rankTwoSeed T M) 2)
    [IsElementaryAbelian 2 (rankTwoSeed T M)]
    (hne : ¬ IsMulCommutative F.U)
    (g : G) (hgP : g∈F.P (sourceResidual M Mc)) (hgH : g∉F.H)
    (hs : Group.IsSolvable F.TerminalHdot)
    (A:Subgroup G) [IsElementaryAbelian 2 A]
    (hAR:A≤(F.I₂ (sourceResidual M Mc)).pCoreIn 2)
    (hVA:rankTwoSeed T M≤A) (hAc:Nat.card A=16)
    (hc8:Nat.card (A⊓F.U:Subgroup G)=8)
    (hAN:F.I₂ (sourceResidual M Mc)⊔F.H.pCoreIn 2≤normalizer (A:Set G)) :
    let N := F.H⊓normalizer (A:Set G)
    let Y := (pResidual 2 N).map N.subtype
    let K := sourceResidual M Mc⊔Y
    normalizer (K:Set G) = K ⊔ (F.H.pCoreIn 2 ⊓ centralizer (F.U:Set G)) ∧
      normalizer (A:Set G) = normalizer (K:Set G) := by
  let h:=source_lemma_14_2_4 hG T hempty hM hu hmany hcard e
  obtain ⟨dg,he,_,_,_,_,_⟩:=rankTwo_terminal_hypothesis h F hne g hgP hgH
  let := he
  have hZ:=source_center_eq_point_of_solvable hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs
  have hr:=source_full_orthogonal_of_solvable hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs
  exact factor_block_normalizer_of_full_orthogonal
    hG T hempty hM hu hmany hcard e hnot F dg hZ hne g hgP hgH hr A hAR hVA hAc hc8 hAN

/-- Choose the actual elementary factor and discharge both normalizer identities. -/
theorem source_exists_factor_block_normalizer_of_solvable
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hnot : ¬ ClassificationModels.IsTheoremEModel G)
    (F : InvariantFlag T (rankTwoSeed T M) 2)
    [IsElementaryAbelian 2 (rankTwoSeed T M)]
    (hne : ¬ IsMulCommutative F.U)
    (g : G) (hgP : g∈F.P (sourceResidual M Mc)) (hgH : g∉F.H)
    (hs : Group.IsSolvable F.TerminalHdot) :
    ∃ A : Subgroup G,
      A≤(F.I₂ (sourceResidual M Mc)).pCoreIn 2 ∧ rankTwoSeed T M≤A ∧
      IsElementaryAbelian 2 A ∧ Nat.card A=16 ∧ Nat.card (A⊓F.U:Subgroup G)=8 ∧
      F.I₂ (sourceResidual M Mc)⊔F.H.pCoreIn 2≤normalizer (A:Set G) ∧
      let N := F.H⊓normalizer (A:Set G)
      let Y := (pResidual 2 N).map N.subtype
      let K := sourceResidual M Mc⊔Y
      normalizer (K:Set G) = K ⊔ (F.H.pCoreIn 2 ⊓ centralizer (F.U:Set G)) ∧
        normalizer (A:Set G) = normalizer (K:Set G) := by
  obtain ⟨_,A,hAR,hVA,hEA,hAc,hc8,hAN,_⟩ := source_factor_supplement_action_of_solvable
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs
  let := hEA
  exact ⟨A,hAR,hVA,hEA,hAc,hc8,hAN,source_factor_block_normalizer_of_solvable
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs A hAR hVA hAc hc8 hAN⟩

end CFSG.Quasithin.Chapter14.Section03.NonabelianSource.Recognition
