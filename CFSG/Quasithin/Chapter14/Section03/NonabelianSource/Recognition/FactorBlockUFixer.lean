module
public import CFSG.Quasithin.Chapter14.Section03.NonabelianSource.Recognition.FactorBlockPointMark
public import CFSG.Quasithin.Chapter14.Section03.NonabelianSource.Recognition.FactorBlockAutomorphisms
public import Theory.SpecificGroups.AlternatingSix.NaturalSplit.UFixer
public import Theory.GroupAction.AutomorphismFixerTransport

/-!
# The dihedral pointwise fixer of the original quaternion subgroup

The marked split isomorphism carries the original A and U simultaneously to
translations and the canonical intrinsic point core. Conjugating automorphisms
then carries the full pointwise fixer of U to the subgroup generated by the
explicit deleted-unit cocycle and coordinate transposition. In particular the
original fixer is dihedral of order eight, with the same ambient marking.

Source: Aschbacher–Smith 14.3.19(10), used in 14.3.20–22.
-/

public noncomputable section
open Subgroup Module Theory.GroupTheory
open scoped IsMulCommutative Pointwise
namespace CFSG.Quasithin.Chapter14.Section03.NonabelianSource.Recognition
open Chapter12.Section08 Chapter12.Section08.InvariantFlag
open Chapter14.Section02 SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
open BinaryPermutation.SixNaturalSplit
variable {G:Type*} [Group G] [Finite G]

theorem source_factor_block_U_fixer_of_solvable
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hnot : ¬ ClassificationModels.IsTheoremEModel G)
    (F : InvariantFlag T (rankTwoSeed T M) 2)
    [IsElementaryAbelian 2 (rankTwoSeed T M)]
    (hne : ¬ IsMulCommutative F.U)
    (g : G) (hgP : g∈F.P (sourceResidual M Mc)) (hgH : g∉F.H)
    (hs : Group.IsSolvable F.TerminalHdot)
    (A:Subgroup G) [IsElementaryAbelian 2 A]
    (hAR:A≤(F.I₂ (sourceResidual M Mc)).pCoreIn 2)
    (hVA:rankTwoSeed T M≤A) (hAc:Nat.card A=16)
    (hc8:Nat.card (A⊓F.U:Subgroup G)=8)
    (hAN:F.I₂ (sourceResidual M Mc)⊔F.H.pCoreIn 2≤normalizer (A:Set G)) :
    let N := F.H⊓normalizer (A:Set G)
    let Y := (pResidual 2 N).map N.subtype
    let K := sourceResidual M Mc⊔Y
    ∃f:K≃*Model,
      (A.subgroupOf K).map f.toMonoidHom=translations ∧
      (F.U.subgroupOf K).map f.toMonoidHom=canonicalCore ∧
      (fixingSubgroup (MulAut K) (F.U.subgroupOf K : Set K)).map
        (MulAut.congr f).toMonoidHom=closure ({alpha,beta} : Set (MulAut Model)) ∧
      Nonempty (fixingSubgroup (MulAut K) (F.U.subgroupOf K : Set K) ≃* DihedralGroup 4) ∧
      Nat.card (fixingSubgroup (MulAut K) (F.U.subgroupOf K : Set K))=8 := by
  intro N Y K
  obtain ⟨f,hA,hU⟩ := source_factor_block_marked_U_of_solvable
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs A hAR hVA hAc hc8 hAN
  have hU' : (F.U.subgroupOf K).map f.toMonoidHom=canonicalCore := hU
  let eU := MulAut.fixingSubgroupEquivOfMap f (F.U.subgroupOf K) canonicalCore hU'
  obtain ⟨eD⟩ := canonicalFixer_dihedral natural_block_normalizer
  refine ⟨f,hA,hU',?_,⟨eU.trans eD⟩,?_⟩
  · rw [MulAut.map_fixingSubgroup_congr,hU']
    exact canonicalFixer_eq_closure natural_block_normalizer
  · exact (Nat.card_congr eU.toEquiv).trans (canonicalFixer_card natural_block_normalizer)

end CFSG.Quasithin.Chapter14.Section03.NonabelianSource.Recognition
