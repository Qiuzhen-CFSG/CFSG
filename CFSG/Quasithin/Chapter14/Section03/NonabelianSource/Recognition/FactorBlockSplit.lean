module
public import CFSG.Quasithin.Chapter14.Section03.NonabelianSource.Recognition.FactorBlockCore
public import Theory.ElementaryAbelian.BinaryInvolutionPlaneComplement
public import Theory.GroupTheory.Gaschutz
public import Theory.GroupTheory.QuaternionProductOrderFourCentralizer
public import Theory.GroupTheory.QuaternionSplitBlockInvolutions
public import Theory.GroupTheory.SplitExtensionCoordinates.Normalizer
public import Theory.SpecificGroups.AlternatingSix.NaturalSplit.Basic

/-!
# Splitting the original alternating-six block

Choose an involution in the quaternion subgroup U outside R. It moves the
four-group A∩B, so the invariant-plane theorem supplies a normalized
complement D to A∩B inside B. The subgroup generated by D and the involution
has order eight and is disjoint from A. Thus A splits in RU, whose odd index
45 in K lets Gaschütz produce an actual complement in K.

The natural action coordinates then give a marked isomorphism with the
literal binary six-letter split model. The map on every element of the
original A is recorded, so the source factor becomes the canonical vector
subgroup without changing its action. All public statements retain the
caller's chosen A; its original partner is selected internally by maximality.

Source: Aschbacher–Smith, Quasithin Groups, 14.3.19(9), printed p.997.
-/

@[expose] public noncomputable section
open Subgroup Module Theory.GroupTheory
open scoped IsMulCommutative Pointwise commutatorElement
namespace CFSG.Quasithin.Chapter14.Section03.NonabelianSource.Recognition
open Chapter12.Section08 Chapter12.Section08.InvariantFlag
open Chapter14.Section02 SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
variable {G:Type*} [Group G] [Finite G]

private theorem factor_complement_of_marked_pair
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hnot : ¬ ClassificationModels.IsTheoremEModel G)
    (F : InvariantFlag T (rankTwoSeed T M) 2)
    [IsElementaryAbelian 2 (rankTwoSeed T M)] [IsElementaryAbelian 2 F.Uhat]
    (dg : ClosureGeometry F) (hZ : F.ZU=F.Vi 1) (hne : ¬ IsMulCommutative F.U)
    (g : G) (hgP : g∈F.P (sourceResidual M Mc)) (hgH : g∉F.H)
    (hr : ChapterG.Section09.FittingRecognition.OrthogonalRealization F.terminalRepresentation ⊤)
    (A B:Subgroup G) [IsElementaryAbelian 2 A] [IsElementaryAbelian 2 B]
    (hAR:A≤(F.I₂ (sourceResidual M Mc)).pCoreIn 2)
    (hBR:B≤(F.I₂ (sourceResidual M Mc)).pCoreIn 2)
    (hVA:rankTwoSeed T M≤A) (hAc:Nat.card A=16)
    (hc8:Nat.card (A⊓F.U:Subgroup G)=8)
    (hAB:A⊔B=(F.I₂ (sourceResidual M Mc)).pCoreIn 2)
    (hRc:Nat.card ((F.I₂ (sourceResidual M Mc)).pCoreIn 2)=64)
    (hAN:F.I₂ (sourceResidual M Mc)⊔F.H.pCoreIn 2≤normalizer (A:Set G))
    (hBc:Nat.card B=16) (hi:A⊓B=rankTwoSeed T M)
    (hBN:F.I₂ (sourceResidual M Mc)⊔F.H.pCoreIn 2≤normalizer (B:Set G)) :
    let N := F.H⊓normalizer (A:Set G)
    let Y := (pResidual 2 N).map N.subtype
    let K := sourceResidual M Mc⊔Y
    ∃C:Subgroup K,(A.subgroupOf K).IsComplement' C := by
  intro N Y K
  let R:=(F.I₂ (sourceResidual M Mc)).pCoreIn 2
  let S:=R⊔F.U
  let V:=rankTwoSeed T M
  have hVB:V≤B := hi.ge.trans inf_le_right
  obtain ⟨hcore,hKC,_,hKcard,hSyl⟩ := factor_block_core_of_full_orthogonal
    hG T hempty hM hu hmany hcard e hnot F dg hZ hne g hgP hgH hr
    A B hAR hBR hVA hAc hc8 hAB hRc hAN
  have hSK:S≤K := (factor_generated_residual_geometry_of_full_orthogonal
    hG T hempty hM hu hmany hcard e hnot F dg hZ hne g hgP hgH hr A hAR hVA hAc hc8 hAN).2.2.1
  have hSc:Nat.card S=128 := factor_join_order_of_full_orthogonal
    hG T hempty hM hu hmany hcard e hnot F dg hZ hne g hgP hgH hr
  have hAK:A≤K := hcore ▸ pCoreIn_le 2 K
  have hAS:A≤S := hAR.trans le_sup_left
  have hUQ:F.U≤F.H.pCoreIn 2 := le_pCoreIn_of_normalizes dg.two F.U_le_H
    (le_normalizer_conjugateSpanBy _ _)
  have hUR:¬F.U≤R := by
    intro hh
    have hs:S=R := sup_eq_left.mpr hh
    rw [hs,hRc] at hSc
    contradiction
  obtain ⟨dU⟩ := quaternion_closure_of_full_orthogonal F dg hZ hne hr
  obtain ⟨u,huU,huR,hu2⟩ := exists_involution_outside_of_quaternion_core R F.U dU hUR
  have huA:u∈normalizer (A:Set G) := (le_sup_right.trans hAN) (hUQ huU)
  have huB:u∈normalizer (B:Set G) := (le_sup_right.trans hBN) (hUQ huU)
  have huV:u∈normalizer (V:Set G) := by
    change u∈normalizer (rankTwoSeed T M:Set G)
    rw [←hi]
    exact inf_normalizer_le_normalizer_inf ⟨huA,huB⟩
  have hVc:Nat.card V=4 := by
    simpa only [F.last,show (2:ℕ)^2=4 from rfl] using F.card 2 le_rfl
  have hWR:F.W≤R :=
    (parabolic_core_intersection_of_full_orthogonal
      hG T hempty hM hu hmany hcard e hnot F dg hZ hne g hgP hgH hr).1.ge.trans inf_le_left
  have hmove:u∉centralizer (V:Set G) := by
    intro hc
    apply huR
    apply hWR
    refine ⟨huU,?_⟩
    intro v hv
    apply hc v
    change v∈rankTwoSeed T M
    exact F.last.le hv
  obtain ⟨D,hDB,hdis,hVD,huD⟩ := exists_invariant_complement_of_normalizing_involution_four
    B V hVB hVc u hu2 huB huV hmove
  have hDR:D≤R := hDB.trans hBR
  have hDV:D≤normalizer (V:Set G) := by
    apply le_trans ?_ (_root_.centralizer_le_normalizer V)
    intro d hd v hv
    exact congrArg Subtype.val (mul_comm (⟨v,hVB hv⟩:B) ⟨d,hDB hd⟩)
  have hDc:Nat.card D=4 := by
    have hh:=card_sup_eq_mul_of_normalizes_of_disjoint V D hDV hdis
    rw [hVD,hBc,hVc] at hh
    omega
  let E:=D⊔zpowers u
  have hEc:Nat.card E=8 := by
    rw [card_sup_zpowers_of_normalizing_involution D u hu2 (fun huD=>huR (hDR huD)) huD,hDc]
  have hES:E≤S := sup_le (hDR.trans le_sup_left) (zpowers_le.mpr ((show F.U≤S from le_sup_right) huU))
  have hAd:Disjoint A D := disjoint_def.mpr (by
    intro a ha hd
    apply disjoint_def.mp hdis ?_ hd
    exact hi.le (show a∈A⊓B from ⟨ha,hDB hd⟩))
  have hAE:Disjoint A E := disjoint_def.mpr (by
    intro a ha he
    have hd:a∈D := (inf_sup_zpowers_of_normalizing_involution R D hDR u hu2 huR huD).le
      ⟨hAR ha,he⟩
    exact disjoint_def.mp hAd ha hd)
  let AA:=A.subgroupOf K
  let SS:=S.subgroupOf K
  let EE:=(E.subgroupOf K).subgroupOf SS
  have hAAS:AA≤SS := fun _ hx=>hAS hx
  have hEES:E.subgroupOf K≤SS := fun _ hx=>hES hx
  have hEEc:Nat.card EE=8 := by
    rw [Nat.card_congr (subgroupOfEquivOfLe hEES).toEquiv,
      Nat.card_congr (subgroupOfEquivOfLe (hES.trans hSK)).toEquiv,hEc]
  have hAAc:Nat.card AA=16 := (Nat.card_congr (subgroupOfEquivOfLe hAK).toEquiv).trans hAc
  have hSSc:Nat.card SS=128 := (Nat.card_congr (subgroupOfEquivOfLe hSK).toEquiv).trans hSc
  have hlocal:(AA.subgroupOf SS).IsComplement' EE := by
    apply isComplement'_of_card_mul_and_disjoint
    · rw [Nat.card_congr (subgroupOfEquivOfLe hAAS).toEquiv,hAAc,hEEc,hSSc]
    · apply disjoint_def.mpr
      intro x hx hy
      apply Subtype.ext
      apply Subtype.ext
      exact disjoint_def.mp hAE hx hy
  have hpc:pCore 2 K=AA := by
    apply Subgroup.map_injective K.subtype_injective
    rw [map_subgroupOf_eq_of_le hAK]
    exact hcore
  let : AA.Normal := hpc ▸ (inferInstance:(pCore 2 K).Normal)
  let : IsElementaryAbelian 2 AA := IsElementaryAbelian.subgroupOf hAK
  have hind:SS.index=45 := by
    have hh:=SS.index_mul_card
    rw [hSSc,hKcard] at hh
    omega
  exact exists_complement_of_coprime_overgroup AA SS hAAS
    (by rw [hAAc,hind];decide) ⟨EE,hlocal⟩

theorem factor_block_split_of_full_orthogonal
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hnot : ¬ ClassificationModels.IsTheoremEModel G)
    (F : InvariantFlag T (rankTwoSeed T M) 2)
    [IsElementaryAbelian 2 (rankTwoSeed T M)] [IsElementaryAbelian 2 F.Uhat]
    (dg : ClosureGeometry F) (hZ : F.ZU=F.Vi 1) (hne : ¬ IsMulCommutative F.U)
    (g : G) (hgP : g∈F.P (sourceResidual M Mc)) (hgH : g∉F.H)
    (hr : ChapterG.Section09.FittingRecognition.OrthogonalRealization F.terminalRepresentation ⊤)
    (A:Subgroup G) [IsElementaryAbelian 2 A]
    (hAR:A≤(F.I₂ (sourceResidual M Mc)).pCoreIn 2)
    (hVA:rankTwoSeed T M≤A) (hAc:Nat.card A=16)
    (hc8:Nat.card (A⊓F.U:Subgroup G)=8)
    (hAN:F.I₂ (sourceResidual M Mc)⊔F.H.pCoreIn 2≤normalizer (A:Set G)) :
    let N := F.H⊓normalizer (A:Set G)
    let Y := (pResidual 2 N).map N.subtype
    let K := sourceResidual M Mc⊔Y
    ∃C:Subgroup K,(A.subgroupOf K).IsComplement' C := by
  obtain ⟨C,D,hCR,hDR,hVC,hVD,hEC,hED,hCc,hDc,hCDi,hCD,hRc,hCN,hDN,hmax⟩ :=
    maximal_elementary_factors_of_full_orthogonal hG T hempty hM hu hmany hcard e hnot
      F dg hZ hne g hgP hgH hr
  let := hEC
  let := hED
  have hb:∃B:Subgroup G,IsElementaryAbelian 2 B ∧
      B≤(F.I₂ (sourceResidual M Mc)).pCoreIn 2 ∧ Nat.card B=16 ∧
      A⊓B=rankTwoSeed T M ∧ A⊔B=(F.I₂ (sourceResidual M Mc)).pCoreIn 2 ∧
      F.I₂ (sourceResidual M Mc)⊔F.H.pCoreIn 2≤normalizer (B:Set G) := by
    rcases hmax A inferInstance hAR with hac|had
    · have heq:A=C := eq_of_le_of_card_ge hac (by rw [hAc,hCc])
      exact ⟨D,hED,hDR,hDc,heq ▸ hCDi,heq ▸ hCD,hDN⟩
    · have heq:A=D := eq_of_le_of_card_ge had (by rw [hAc,hDc])
      exact ⟨C,hEC,hCR,hCc,by simpa [heq,inf_comm] using hCDi,
        by simpa [heq,sup_comm] using hCD,hCN⟩
  obtain ⟨B,hEB,hBR,hBc,hi,hAB,hBN⟩:=hb
  let := hEB
  exact factor_complement_of_marked_pair
    hG T hempty hM hu hmany hcard e hnot F dg hZ hne g hgP hgH hr
    A B hAR hBR hVA hAc hc8 hAB hRc hAN hBc hi hBN

theorem factor_block_split_model_of_full_orthogonal
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hnot : ¬ ClassificationModels.IsTheoremEModel G)
    (F : InvariantFlag T (rankTwoSeed T M) 2)
    [IsElementaryAbelian 2 (rankTwoSeed T M)] [IsElementaryAbelian 2 F.Uhat]
    (dg : ClosureGeometry F) (hZ : F.ZU=F.Vi 1) (hne : ¬ IsMulCommutative F.U)
    (g : G) (hgP : g∈F.P (sourceResidual M Mc)) (hgH : g∉F.H)
    (hr : ChapterG.Section09.FittingRecognition.OrthogonalRealization F.terminalRepresentation ⊤)
    (A:Subgroup G) [IsElementaryAbelian 2 A]
    (hAR:A≤(F.I₂ (sourceResidual M Mc)).pCoreIn 2)
    (hVA:rankTwoSeed T M≤A) (hAc:Nat.card A=16)
    (hc8:Nat.card (A⊓F.U:Subgroup G)=8)
    (hAN:F.I₂ (sourceResidual M Mc)⊔F.H.pCoreIn 2≤normalizer (A:Set G)) :
    let N := F.H⊓normalizer (A:Set G)
    let Y := (pResidual 2 N).map N.subtype
    let K := sourceResidual M Mc⊔Y
    ∃ (hAK:A≤K) (qA:A≃*Multiplicative (BinaryPermutation.natural (Fin 6)))
      (eK:K≃*BinaryPermutation.SixNaturalSplit.Model),
      (∀u:A,eK (inclusion hAK u)=SemidirectProduct.inl (qA u)) ∧
      (A.subgroupOf K).map eK.toMonoidHom=
        (SemidirectProduct.inl:BinaryPermutation.SixNaturalSplit.Vector→*
          BinaryPermutation.SixNaturalSplit.Model).range := by
  intro N Y K
  let ρ:=BinaryPermutation.SixNaturalSplit.action
  obtain ⟨C,D,hCR,hDR,hVC,hVD,hEC,hED,hCc,hDc,hCDi,hCD,hRc,hCN,hDN,hmax⟩ :=
    maximal_elementary_factors_of_full_orthogonal hG T hempty hM hu hmany hcard e hnot
      F dg hZ hne g hgP hgH hr
  let := hEC
  let := hED
  have hb:∃B:Subgroup G,IsElementaryAbelian 2 B ∧
      B≤(F.I₂ (sourceResidual M Mc)).pCoreIn 2 ∧ Nat.card B=16 ∧
      A⊓B=rankTwoSeed T M ∧ A⊔B=(F.I₂ (sourceResidual M Mc)).pCoreIn 2 ∧
      F.I₂ (sourceResidual M Mc)⊔F.H.pCoreIn 2≤normalizer (B:Set G) := by
    rcases hmax A inferInstance hAR with hac|had
    · have heq:A=C := eq_of_le_of_card_ge hac (by rw [hAc,hCc])
      exact ⟨D,hED,hDR,hDc,heq ▸ hCDi,heq ▸ hCD,hDN⟩
    · have heq:A=D := eq_of_le_of_card_ge had (by rw [hAc,hDc])
      exact ⟨C,hEC,hCR,hCc,by simpa [heq,inf_comm] using hCDi,
        by simpa [heq,sup_comm] using hCD,hCN⟩
  obtain ⟨B,hEB,hBR,hBc,hi,hAB,hBN⟩:=hb
  let := hEB
  obtain ⟨hKA,eA,qA,hqA⟩ := factor_alternating_natural_action_of_full_orthogonal
    hG T hempty hM hu hmany hcard e hnot F dg hZ hne g hgP hgH hr
    A B hAR hBR hVA hAc hc8 hAB hRc hAN
  obtain ⟨hcore,hKC,_⟩ := factor_block_core_of_full_orthogonal
    hG T hempty hM hu hmany hcard e hnot F dg hZ hne g hgP hgH hr
    A B hAR hBR hVA hAc hc8 hAB hRc hAN
  have hAK:A≤K := hcore ▸ pCoreIn_le 2 K
  have hsplit:=factor_complement_of_marked_pair
    hG T hempty hM hu hmany hcard e hnot F dg hZ hne g hgP hgH hr
    A B hAR hBR hVA hAc hc8 hAB hRc hAN hBc hi hBN
  obtain ⟨eK,hem,hei⟩ := exists_marked_semidirect_equiv_of_normalizer_action A K hAK hKA hKC eA qA ρ
    (fun a v=>Multiplicative.toAdd.injective (hqA a v)) hsplit
  exact ⟨hAK,qA,eK,hem,hei⟩

theorem source_factor_block_split_of_solvable
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hnot : ¬ ClassificationModels.IsTheoremEModel G)
    (F : InvariantFlag T (rankTwoSeed T M) 2)
    [IsElementaryAbelian 2 (rankTwoSeed T M)]
    (hne : ¬ IsMulCommutative F.U)
    (g : G) (hgP : g∈F.P (sourceResidual M Mc)) (hgH : g∉F.H)
    (hs : Group.IsSolvable F.TerminalHdot)
    (A:Subgroup G) [IsElementaryAbelian 2 A]
    (hAR:A≤(F.I₂ (sourceResidual M Mc)).pCoreIn 2)
    (hVA:rankTwoSeed T M≤A) (hAc:Nat.card A=16)
    (hc8:Nat.card (A⊓F.U:Subgroup G)=8)
    (hAN:F.I₂ (sourceResidual M Mc)⊔F.H.pCoreIn 2≤normalizer (A:Set G)) :
    let N := F.H⊓normalizer (A:Set G)
    let Y := (pResidual 2 N).map N.subtype
    let K := sourceResidual M Mc⊔Y
    ∃C:Subgroup K,(A.subgroupOf K).IsComplement' C := by
  let h:=source_lemma_14_2_4 hG T hempty hM hu hmany hcard e
  obtain ⟨dg,he,_,_,_,_,_⟩:=rankTwo_terminal_hypothesis h F hne g hgP hgH
  let := he
  have hZ:=source_center_eq_point_of_solvable hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs
  have hr:=source_full_orthogonal_of_solvable hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs
  exact factor_block_split_of_full_orthogonal
    hG T hempty hM hu hmany hcard e hnot F dg hZ hne g hgP hgH hr A hAR hVA hAc hc8 hAN

theorem source_factor_block_split_model_of_solvable
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hnot : ¬ ClassificationModels.IsTheoremEModel G)
    (F : InvariantFlag T (rankTwoSeed T M) 2)
    [IsElementaryAbelian 2 (rankTwoSeed T M)]
    (hne : ¬ IsMulCommutative F.U)
    (g : G) (hgP : g∈F.P (sourceResidual M Mc)) (hgH : g∉F.H)
    (hs : Group.IsSolvable F.TerminalHdot)
    (A:Subgroup G) [IsElementaryAbelian 2 A]
    (hAR:A≤(F.I₂ (sourceResidual M Mc)).pCoreIn 2)
    (hVA:rankTwoSeed T M≤A) (hAc:Nat.card A=16)
    (hc8:Nat.card (A⊓F.U:Subgroup G)=8)
    (hAN:F.I₂ (sourceResidual M Mc)⊔F.H.pCoreIn 2≤normalizer (A:Set G)) :
    let N := F.H⊓normalizer (A:Set G)
    let Y := (pResidual 2 N).map N.subtype
    let K := sourceResidual M Mc⊔Y
    ∃ (hAK:A≤K) (qA:A≃*Multiplicative (BinaryPermutation.natural (Fin 6)))
      (eK:K≃*BinaryPermutation.SixNaturalSplit.Model),
      (∀u:A,eK (inclusion hAK u)=SemidirectProduct.inl (qA u)) ∧
      (A.subgroupOf K).map eK.toMonoidHom=
        (SemidirectProduct.inl:BinaryPermutation.SixNaturalSplit.Vector→*
          BinaryPermutation.SixNaturalSplit.Model).range := by
  let h:=source_lemma_14_2_4 hG T hempty hM hu hmany hcard e
  obtain ⟨dg,he,_,_,_,_,_⟩:=rankTwo_terminal_hypothesis h F hne g hgP hgH
  let := he
  have hZ:=source_center_eq_point_of_solvable hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs
  have hr:=source_full_orthogonal_of_solvable hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs
  exact factor_block_split_model_of_full_orthogonal
    hG T hempty hM hu hmany hcard e hnot F dg hZ hne g hgP hgH hr A hAR hVA hAc hc8 hAN

