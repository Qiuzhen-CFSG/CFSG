module
public import CFSG.Quasithin.Chapter14.Section03.NonabelianSource.SourceAbelianReduction.TerminalSolvable.SmallRows.SourceDegrees
public import CFSG.Quasithin.Chapter14.Section03.NonabelianSource.Recognition.NormalCubic
public import Theory.Representation.OrthogonalFourPlusMatrix.BorelGeneration

/-!
# Excluding the actual exchanged terminal tensor

The literal tensor Borel is generated by two overgroups of the dotted
Sylow group, each of Sylow index three. The original small-actor theorem
identifies the terminal kernel with O₂(H), so both overgroups lift with
index three over T. Original 14.3.5 puts those lifts in M. They therefore
fix the binary seed line, contradicting the tensor Borel's zero fixed space.

This proves the exchanged branch of original 14.3.15 directly from its
actual ActionModel, on the same K and T-conjugate span. It discharges this
branch without a full local wreath-quotient recognition premise.
Source: Aschbacher–Smith 14.3.5, 14.3.12 and 14.3.15, pp.991–994.
-/

public noncomputable section
open Subgroup Module Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter14.Section03.NonabelianSource.SourceAbelianReduction.TerminalSolvable
open Chapter12.Section08 Chapter12.Section08.InvariantFlag
open Chapter12.Section08.InvariantFlag.Symplectic
open Chapter14.Section02 SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06

section Source
variable {G : Type*} [Group G] [Finite G]
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hnot : ¬ ClassificationModels.IsTheoremEModel G)
    (F : InvariantFlag T (rankTwoSeed T M) 2)
    [IsElementaryAbelian 2 (rankTwoSeed T M)] [IsElementaryAbelian 2 F.Uhat]
    (hne : ¬ IsMulCommutative F.U) (g : G)
    [IsElementaryAbelian 2 (F.terminalDot (F.X g))]
    (hgP : g ∈ F.P (sourceResidual M Mc)) (hgH : g ∉ F.H)
    {B : LinearMap.BilinForm (ZMod 2) (Additive F.Uhat)} {v : Additive F.Uhat}
    (hyp : ChapterG.Section10.Hypothesis F.terminalRepresentation B v
      (hatSpace F (F.E g)) (F.terminalDot (F.X g))
      ((F.terminalDot (conjugate F.ZU g)).subgroupOf (F.terminalDot (F.X g))))
    {K : Subgroup G} (hK : ComponentLift F g K)
include hG hempty hM hu hmany hcard e hnot hne hgP hgH hyp hK

/-- The tensor Borel is generated by two Sylow-index-three overgroups.
Original 14.3.5 places both in M, so they fix the binary seed line,
contrary to the tensor Borel's zero fixed space. -/
theorem source_exchanged_a5_false (m : ExchangedA5.ActionModel F K) : False := by
  let h := source_lemma_14_2_4 hG T hempty hM hu hmany hcard e
  let d := Recognition.rankTwo_closure_geometry h F hne
  have hm := source_exchanged_a5_small_actor hG T hempty hM hu hmany hcard e hnot
    F hne g hgP hgH hyp hK m
  have hk := (Recognition.rankTwo_small_actor_geometry h F g d hne hgP hgH hyp hm).2.2.2.2
  let q := QuotientGroup.mk' F.terminalHatAction.ker
  let R : Sylow 2 F.H := T.subtype (F.invariant 1)
  let S := R.mapSurjective (f := q) (QuotientGroup.mk'_surjective _)
  let L := F.terminalDot (conjugateSpanBy K (T : Subgroup G))
  let : L.Normal := Normal.map hK.normal_span _ (QuotientGroup.mk'_surjective _)
  obtain ⟨J₁,J₂,hS₁,hS₂,hi₁,hi₂,hfixed⟩ :=
    ClassicalOrthogonal.FourPlusMatrix.Binary.tensor_borel_generation
      F.terminalRepresentation S L (by rw [normalizer_eq_top]; exact le_top)
      m.componentEquiv m.coordinates m.intertwines
  have hker : q.ker ≤ (R : Subgroup F.H) := by
    rw [QuotientGroup.ker_mk',hk]
    exact pCore_isPGroup.le_sylow_of_normal R
  have hline : finrank (ZMod 2) (hatSpace F (rankTwoSeed T M)) = 1 := by
    have hh := finrank_hatSpace_plane F (by decide) d.seed_center
    exact (congrArg (fun A : Subgroup G => finrank (ZMod 2) (hatSpace F A)) F.last).symm.trans hh
  let U := hatSpace F (rankTwoSeed T M)
  have hU : 0 < finrank (ZMod 2) U := by rw [hline]; decide
  let : Nontrivial U := Module.nontrivial_of_finrank_pos hU
  obtain ⟨w,hw⟩ := exists_ne (0 : U)
  have hw0 : (w : Additive F.Uhat) ≠ 0 := fun he => hw (Subtype.ext he)
  have hspan : U = Submodule.span (ZMod 2) {(w : Additive F.Uhat)} :=
    eq_span_singleton_of_mem_of_finrank_eq_one hline w.property hw0
  have hfix (Jd : Subgroup F.TerminalHdot) (hSJ : (S : Subgroup F.TerminalHdot) ≤ Jd)
      (hidx : (S : Subgroup F.TerminalHdot).relIndex Jd = 3) :
      (w : Additive F.Uhat) ∈ Representation.BinaryOffender.fixedSpace F.terminalRepresentation Jd := by
    let J₀ := Jd.comap q
    let J := J₀.map F.H.subtype
    have hRJ : (R : Subgroup F.H) ≤ J₀ := fun x hx => hSJ (mem_map_of_mem q hx)
    have hmapR : (R : Subgroup F.H).map F.H.subtype = (T : Subgroup G) :=
      map_subgroupOf_eq_of_le (F.invariant 1)
    have hTJ : (T : Subgroup G) ≤ J := hmapR ▸ map_mono hRJ
    have hJH : J ≤ F.H := map_subtype_le _
    have hJmem : J ∈ Chapter1.HOver G (T : Set G) :=
      Chapter3.mem_HOver_of_sylow_interval T hTJ hJH
        ⟨(h.pointNormalizer_mem_Hz F).1.1,F.invariant 1⟩
    have hindex : (T : Subgroup G).relIndex J = 3 := by
      rw [←hmapR]
      change ((R : Subgroup F.H).map F.H.subtype).relIndex (J₀.map F.H.subtype) = _
      rw [relIndex_map_map_of_injective _ _ F.H.subtype_injective]
      have hh := relIndex_map_map q (R : Subgroup F.H) J₀
      rw [sup_eq_left.mpr hker,sup_eq_left.mpr (ker_le_comap q Jd),
        map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective _)] at hh
      exact hh.symm.trans hidx
    have hJM : J ≤ M := by
      by_contra hout
      exact hnot (SolvableAmalgam.source_theoremE_of_index_three hG T hempty hM hu hmany
        hcard e J hJmem hout hindex)
    intro c
    obtain ⟨a,ha⟩ := QuotientGroup.mk'_surjective F.terminalHatAction.ker (c : F.TerminalHdot)
    have haJ : a ∈ J₀ := by change q a ∈ Jd; rw [ha]; exact c.property
    have haM : (a:G) ∈ M := hJM (mem_map_of_mem _ haJ)
    have hstable : F.terminalRepresentation c (w : Additive F.Uhat) ∈ U := by
      change (F.terminalRepresentation c (w : Additive F.Uhat)).toMul ∈ hatImage F (rankTwoSeed T M)
      obtain ⟨u,hu,he⟩ := w.property
      rw [←ha,F.terminalRepresentation_apply_mk,←he,F.terminalHatAction_apply_mk]
      refine ⟨_,?_,rfl⟩
      exact (mem_normalizer_iff.mp (RankTwoHypothesis.M_normalizes_seed haM) (u:G)).mp hu
    have hnz : F.terminalRepresentation c (w : Additive F.Uhat) ≠ 0 := by
      intro he
      apply hw0
      have hh := congrArg (F.terminalRepresentation (c : F.TerminalHdot)⁻¹) he
      simpa only [← Module.End.mul_apply,← map_mul,inv_mul_cancel,map_one,
        Module.End.one_apply,map_zero] using hh
    obtain ⟨b,hb⟩ := Submodule.mem_span_singleton.mp (hspan.le hstable)
    have hb0 : b ≠ 0 := by intro hh; exact hnz (by simpa [hh] using hb.symm)
    have hb1 : b = 1 := (by decide : ∀ b : ZMod 2, b ≠ 0 → b = 1) b hb0
    simpa [hb1] using hb.symm
  have hwf : (w : Additive F.Uhat) ∈
      Representation.BinaryOffender.fixedSpace F.terminalRepresentation (J₁ ⊔ J₂) := by
    change (w : Additive F.Uhat) ∈ Representation.invariants (F.terminalRepresentation.comp (J₁ ⊔ J₂).subtype)
    rw [F.terminalRepresentation.invariants_comp_sup]
    exact ⟨hfix J₁ hS₁ hi₁,hfix J₂ hS₂ hi₂⟩
  rw [hfixed] at hwf
  exact hw0 ((Submodule.mem_bot (R := ZMod 2)).mp hwf)
end Source
end CFSG.Quasithin.Chapter14.Section03.NonabelianSource.SourceAbelianReduction.TerminalSolvable
