module
public import CFSG.Quasithin.Chapter14.Section03.NonabelianSource.SourceAbelianReduction.TerminalSolvable.JankoRecognition.J3Ambient.TriangleModelSource

/-!
# A complement to the full involution core inside the actual triangle

The A₅ factor of the literal third parabolic embeds in the original
involution centralizer. Its intersection with the full normal core is
trivial by simplicity and the actual core order32. The full centralizer
order1920 then makes it an actual complement. This supplies the split
centralizer required by the J₃ amalgam construction from the original
quotient hypotheses, without changing the full core or ambient subgroup.
-/

public noncomputable section
open Subgroup
namespace CFSG.Quasithin.Chapter14.Section03.NonabelianSource.SourceAbelianReduction.TerminalSolvable.J3Ambient
open Janko23.J3Recognition.LocalSixteen Janko23.J3Recognition.Ambient
open Janko23.J3Recognition.Ambient.Seventeen
open Representation.CentralCubicNaturalFour
open Sporadic.Janko3.SourceRecognition
open Sporadic.Janko3.SourceRecognition.BaumeisterParabolics

private theorem complement_of_injective_alternating
    {H : Type*} [Group H] [Finite H] (Q : Subgroup H) [Q.Normal]
    (hQ : Nat.card Q = 32) (hH : Nat.card H = 1920)
    (t : alternatingGroup (Fin 5) →* H) (ht : Function.Injective t) :
    Q.IsComplement' t.range := by
  let : IsSimpleGroup (alternatingGroup (Fin 5)) :=
    alternatingGroup.isSimpleGroup (by simp)
  have hpre : Q.comap t = ⊥ := by
    rcases (inferInstance : (Q.comap t).Normal).eq_bot_or_eq_top with h | h
    · exact h
    · have hle : t.range ≤ Q := by
        rintro _ ⟨x,rfl⟩
        exact show x ∈ Q.comap t from h ▸ mem_top x
      have hd := card_dvd_of_le hle
      rw [←Nat.card_congr (MonoidHom.ofInjective ht).toEquiv,
        nat_card_alternatingGroup,hQ] at hd
      norm_num [Nat.factorial] at hd
  apply isComplement'_of_card_mul_and_disjoint
  · rw [hQ,←Nat.card_congr (MonoidHom.ofInjective ht).toEquiv,
      nat_card_alternatingGroup,hH]
    norm_num [Nat.factorial]
  · apply disjoint_def.mpr
    rintro y hyQ ⟨x,rfl⟩
    have hx : x ∈ Q.comap t := hyQ
    rw [hpre,mem_bot] at hx
    simp only [hx,map_one]

/-- The original centralizer has a complement to its full generalized Fitting
core, contained in the literal triangle generated by the two actual overlaps. -/
theorem literal_triangle_core_complement
    {G : Type*} [Group G] [Finite G] {D : Seed G}
    (P : ReturningPair D) (hc : Janko23.OneInvolutionClass G)
    (A : Subgroup G) (C : Subgroup (normalizer (A : Set G)))
    (a : A ≃* Plane) (j : SingerField.Model →* G)
    (hj : PlaneTransport.FieldEmbedding A C a j) :
    ∃ E : Subgroup (Janko23.involutionCentralizer (j SingerField.fieldElement)),
      (Janko23.localCore (j SingerField.fieldElement)).IsComplement' E ∧
      Nonempty (E ≃* alternatingGroup (Fin 5)) ∧
      E ≤ (third j.range (overlap j) (j SingerField.fieldElement)).subgroupOf
        (Janko23.involutionCentralizer (j SingerField.fieldElement)) := by
  let f := j SingerField.fieldElement
  let H := Janko23.involutionCentralizer f
  let Q := Janko23.localCore f
  let R := third j.range (overlap j) f
  have hf : orderOf f = 2 := image_involution_order j hj.1
  obtain ⟨⟨eQ⟩,_,⟨eA⟩⟩ := literal_involution_core_and_quotient (D := D) hc f hf
  have hQ : Nat.card Q = 32 := (Nat.card_congr eQ.toEquiv).trans MinusExtraspecial.card_model
  have hquot : Nat.card (H ⧸ Q) = 60 := by
    rw [Nat.card_congr eA.toEquiv,nat_card_alternatingGroup]
    norm_num [Nat.factorial]
  have hH : Nat.card H = 1920 := by
    have hh := Q.index_mul_card
    change Nat.card (H ⧸ Q) * Nat.card Q = Nat.card H at hh
    rw [hquot,hQ] at hh
    omega
  obtain ⟨eR⟩ := literal_triangle_equiv P hc A C a j hj
  have hRH : R ≤ H := sup_le inf_le_right inf_le_right
  let k : alternatingGroup (Fin 5) →* R :=
    eR.symm.toMonoidHom.comp (MonoidHom.inl _ (Multiplicative (ZMod 2)))
  have hk : Function.Injective k := by
    intro x y hxy
    have hp := eR.symm.injective hxy
    exact congrArg Prod.fst hp
  let t : alternatingGroup (Fin 5) →* H := (inclusion hRH).comp k
  have ht : Function.Injective t := (inclusion_injective hRH).comp hk
  refine ⟨t.range,complement_of_injective_alternating Q hQ hH t ht,
    ⟨(MonoidHom.ofInjective ht).symm⟩,?_⟩
  rintro _ ⟨x,rfl⟩
  exact (k x).property

end CFSG.Quasithin.Chapter14.Section03.NonabelianSource.SourceAbelianReduction.TerminalSolvable.J3Ambient
