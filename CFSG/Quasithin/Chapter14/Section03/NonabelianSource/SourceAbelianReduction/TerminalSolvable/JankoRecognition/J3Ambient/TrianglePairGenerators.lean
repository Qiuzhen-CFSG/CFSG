module
public import CFSG.Quasithin.Chapter14.Section03.NonabelianSource.SourceAbelianReduction.TerminalSolvable.JankoRecognition.J3Ambient.TrianglePairCoreIntersection

/-!
# An actual inverter generating the pair side of the triangle

The literal pair centralizer is S₃ × C₂. Its central involution and the
original field cubic therefore admit an involutory inverter generating
the whole pair centralizer with them. The full subgroup and both marked
elements retain the original field embedding.

The only finite certificate is the twelve-element S₃ × C₂ normal form.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter14.Section03.NonabelianSource.SourceAbelianReduction.TerminalSolvable.J3Ambient
open Janko23.J3Recognition.LocalSixteen Janko23.J3Recognition.Ambient
open Representation.CentralCubicNaturalFour
open Sporadic.Janko3.SourceRecognition
open Sporadic.Janko3.SourceRecognition.BaumeisterParabolics

set_option synthInstance.maxSize 2048 in
private theorem pair_normal_form :
    ∀ f s : Equiv.Perm (Fin 3) × Multiplicative (ZMod 2),
      f ^ 2 = 1 → f ≠ 1 → (∀ x, x * f = f * x) →
      s ^ 3 = 1 → s ≠ 1 →
      ∃ y, y ^ 2 = 1 ∧ y * s * y⁻¹ = s⁻¹ ∧
        ∀ x, ∃ (i : Fin 2) (j : Fin 3) (k : Fin 2),
          x = f ^ i.val * s ^ j.val * y ^ k.val := by
  decide +kernel

private theorem pair_generators {H : Type*} [Group H]
    (e : H ≃* (Equiv.Perm (Fin 3) × Multiplicative (ZMod 2)))
    (f s : H) (hf : orderOf f = 2) (hs : orderOf s = 3) (hfc : f ∈ center H) :
    ∃ y : H, y ^ 2 = 1 ∧ y * s * y⁻¹ = s⁻¹ ∧
      (zpowers f ⊔ zpowers s) ⊔ zpowers y = ⊤ := by
  have hfp : f ^ 2 = 1 := hf ▸ pow_orderOf_eq_one f
  have hsp : s ^ 3 = 1 := hs ▸ pow_orderOf_eq_one s
  have hfo : e f ^ 2 = 1 := by rw [←map_pow, hfp, map_one]
  have hso : e s ^ 3 = 1 := by rw [←map_pow, hsp, map_one]
  have hfn : e f ≠ 1 := by
    intro h
    have he : f = 1 := e.injective (h.trans e.map_one.symm)
    rw [he,orderOf_one] at hf
    omega
  have hsn : e s ≠ 1 := by
    intro h
    have he : s = 1 := e.injective (h.trans e.map_one.symm)
    rw [he,orderOf_one] at hs
    omega
  have hcf (x) : x * e f = e f * x := by
    obtain ⟨u,rfl⟩ := e.surjective x
    simpa only [map_mul] using congrArg e (mem_center_iff.mp hfc u)
  obtain ⟨y,hy,hi,hgen⟩ := pair_normal_form (e f) (e s) hfo hfn hcf hso hsn
  refine ⟨e.symm y, ?_, ?_, ?_⟩
  · apply e.injective
    simpa only [map_pow,map_one,e.apply_symm_apply] using hy
  · apply e.injective
    simpa only [map_mul,map_inv,e.apply_symm_apply] using hi
  · apply eq_top_iff.mpr
    intro x _
    obtain ⟨i,j,k,he⟩ := hgen (e x)
    have hx : x = f ^ i.val * s ^ j.val * (e.symm y) ^ k.val := by
      apply e.injective
      simpa only [map_mul,map_pow,e.apply_symm_apply] using he
    rw [hx]
    let L := (zpowers f ⊔ zpowers s) ⊔ zpowers (e.symm y)
    have hfL : zpowers f ≤ L := le_sup_left.trans le_sup_left
    have hsL : zpowers s ≤ L := le_sup_right.trans le_sup_left
    have hyL : zpowers (e.symm y) ≤ L := le_sup_right
    exact L.mul_mem (L.mul_mem
      (hfL (pow_mem (mem_zpowers f) i.val))
      (hsL (pow_mem (mem_zpowers s) j.val)))
      (hyL (pow_mem (mem_zpowers (e.symm y)) k.val))

variable {G : Type*} [Group G] [Finite G]

/-- The same pair centralizer is generated by the original field involution,
the original cubic and an actual involutory inverter of that cubic. -/
theorem literal_triangle_pair_generators
    {D : Seed G} (P : ReturningPair D) (hc : Janko23.OneInvolutionClass G)
    (A : Subgroup G) (C : Subgroup (normalizer (A : Set G)))
    (a : A ≃* Plane) (j : SingerField.Model →* G)
    (hj : PlaneTransport.FieldEmbedding A C a j) :
    let f := j SingerField.fieldElement
    let s := j cubic
    let Y := normalizer (overlap j : Set G) ⊓ centralizer ({f} : Set G)
    ∃ y ∈ Y, y ^ 2 = 1 ∧ y * s * y⁻¹ = s⁻¹ ∧
      Y = (zpowers f ⊔ zpowers s) ⊔ zpowers y := by
  let f := j SingerField.fieldElement
  let s := j cubic
  let Y := normalizer (overlap j : Set G) ⊓ centralizer ({f} : Set G)
  have hf : orderOf f = 2 := image_involution_order j hj.1
  have hs : orderOf s = 3 := (orderOf_injective j hj.1 _).trans cubic_order
  have hfY : f ∈ Y :=
    ⟨(overlap j).le_normalizer (image_involution_mem j), mem_centralizer_singleton_iff.mpr rfl⟩
  have hsY : s ∈ Y := by
    refine ⟨(overlap j).le_normalizer (mem_map_of_mem j cubic_mem), ?_⟩
    exact mem_centralizer_singleton_iff.mpr
      ((cubic_commutes_complement
        ⟨SingerField.fieldElement,(mem_pointComplement _).mpr rfl⟩).map j).eq
  let fY : Y := ⟨f,hfY⟩
  let sY : Y := ⟨s,hsY⟩
  have hfc : fY ∈ center Y := mem_center_iff.mpr fun y =>
    Subtype.ext (mem_centralizer_singleton_iff.mp y.property.2)
  obtain ⟨eP⟩ := literal_overlap_pair_equiv P hc A C a j hj
  let eY : Y ≃* (Equiv.Perm (Fin 3) × Multiplicative (ZMod 2)) :=
    Janko23.J3Recognition.Ambient.BaumeisterParabolics.pair_centralizer_equiv j hj.1 eP
  obtain ⟨y,hy,hi,hgen⟩ := pair_generators eY fY sY
    ((orderOf_coe fY).symm.trans hf) ((orderOf_coe sY).symm.trans hs) hfc
  refine ⟨y,y.property,congrArg Subtype.val hy,congrArg Subtype.val hi,?_⟩
  have hm := congrArg (Subgroup.map Y.subtype) hgen
  rw [Subgroup.map_sup,Subgroup.map_sup,MonoidHom.map_zpowers,MonoidHom.map_zpowers,
    MonoidHom.map_zpowers,←MonoidHom.range_eq_map,range_subtype] at hm
  exact hm.symm

end CFSG.Quasithin.Chapter14.Section03.NonabelianSource.SourceAbelianReduction.TerminalSolvable.J3Ambient
