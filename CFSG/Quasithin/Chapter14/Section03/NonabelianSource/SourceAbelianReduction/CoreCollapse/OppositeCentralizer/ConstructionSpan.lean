open Chapter12.Section08 Chapter12.Section08.InvariantFlag
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {V : Subgroup G}

omit [Finite G] in
private theorem conjugate_cube (a x : G) (ha : a ^ 3 = 1) :
    (MulAut.conj a⁻¹) ((MulAut.conj a⁻¹) ((MulAut.conj a⁻¹) x)) = x := by
  have hh : (MulAut.conj a⁻¹) ((MulAut.conj a⁻¹) ((MulAut.conj a⁻¹) x)) =
      (a ^ 3)⁻¹ * x * a ^ 3 := by
    simp only [MulAut.conj_apply, pow_succ, pow_zero, mul_inv_rev, inv_inv]
    group
  rw [hh, ha]
  simp

omit [Finite G] in
private theorem conjugate_square (a x : G) :
    (MulAut.conj a⁻¹) ((MulAut.conj a⁻¹) x) = (MulAut.conj (a ^ 2)⁻¹) x := by
  simp only [MulAut.conj_apply, pow_succ, pow_zero, mul_inv_rev, inv_inv]
  group

omit [Finite G] in
/-- The cubic actor cycles the three distinct involutions of the plane. -/
theorem CubicTriple.squares_distinct {F : InvariantFlag T V 2}
    {L : Subgroup G} {z d a : G} (s : CubicTriple F L z d a) :
    z ≠ (MulAut.conj a⁻¹) z ∧ z ≠ (MulAut.conj (a ^ 2)⁻¹) z ∧
      (MulAut.conj a⁻¹) z ≠ (MulAut.conj (a ^ 2)⁻¹) z := by
  have hz : z ∈ V := F.le_seed 1 (s.point.symm ▸ mem_zpowers z)
  have hz2 : orderOf z = 2 := by
    rw [← Nat.card_zpowers, ← s.point]
    simpa using F.card 1 (by decide)
  have hz1 : z ≠ 1 := by intro he; simp [he] at hz2
  have hne : z ≠ (MulAut.conj a⁻¹) z := by
    intro he
    have hc : z ∈ centralizer ({a} : Set G) := by
      apply mem_centralizer_singleton_iff.mpr
      have hh := congrArg (fun x : G => a * x) he
      simpa only [MulAut.conj_apply, inv_inv, ← mul_assoc, mul_inv_cancel, one_mul] using hh.symm
    exact hz1 (mem_bot.mp (s.actor_fixed ▸ ⟨s.seed_le_core hz, hc⟩))
  have ha3 : a ^ 3 = 1 := by simpa only [s.actor_order] using pow_orderOf_eq_one a
  refine ⟨hne, ?_, ?_⟩
  · intro he
    have hh := congrArg (MulAut.conj a⁻¹) he
    rw [← conjugate_square, conjugate_cube a z ha3] at hh
    exact hne hh.symm
  · rw [← conjugate_square]
    exact fun he => hne ((MulAut.conj a⁻¹).injective he)

/-- The exact source span is generated by the literal three cubic factors. -/
theorem CubicTriple.span_eq_three {F : InvariantFlag T V 2}
    {L : Subgroup G} {z d a : G} (s : CubicTriple F L z d a)
    (hc : CyclicTIInput F L) :
    span F = zpowers d ⊔ zpowers ((MulAut.conj a⁻¹) d) ⊔
      zpowers ((MulAut.conj (a ^ 2)⁻¹) d) := by
  have hd4 : orderOf d = 4 := by rw [← Nat.card_zpowers, s.generator, hc.card]
  have h14 : orderOf ((MulAut.conj a⁻¹) d) = 4 :=
    ((MulAut.conj a⁻¹).orderOf_eq d).trans hd4
  have h24 : orderOf ((MulAut.conj (a ^ 2)⁻¹) d) = 4 :=
    ((MulAut.conj (a ^ 2)⁻¹).orderOf_eq d).trans hd4
  have hsq := s.squares_distinct
  have hne (x y : G) (hx : orderOf x = 4) (hy : orderOf y = 4)
      (hxy : x ^ 2 ≠ y ^ 2) : zpowers x ≠ zpowers y := by
    intro he
    have hd := disjoint_zpowers_of_order_four_distinct_squares hx hy hxy
    rw [he, disjoint_self] at hd
    have hm : y ∈ (⊥ : Subgroup G) := hd ▸ mem_zpowers y
    have hy1 := mem_bot.mp hm
    simp [hy1] at hy
  have h01 := hne d ((MulAut.conj a⁻¹) d) hd4 h14 (by simpa only [← map_pow, s.square] using hsq.1)
  have h02 := hne d ((MulAut.conj (a ^ 2)⁻¹) d) hd4 h24 (by simpa only [← map_pow, s.square] using hsq.2.1)
  have h12 := hne ((MulAut.conj a⁻¹) d) ((MulAut.conj (a ^ 2)⁻¹) d) h14 h24
    (by simpa only [← map_pow, s.square] using hsq.2.2)
  let family : Set (Subgroup G) := {A | ∃ b ∈ L, conjugate (supplement F) b = A}
  have h0 : zpowers d ∈ family := by
    refine ⟨1, L.one_mem, ?_⟩
    rw [← s.generator]
    simp [conjugate]
  have h1 : zpowers ((MulAut.conj a⁻¹) d) ∈ family := by
    refine ⟨a, s.actor_mem, ?_⟩
    rw [conjugate, ← s.generator, MonoidHom.map_zpowers]
    rfl
  have h2 : zpowers ((MulAut.conj (a ^ 2)⁻¹) d) ∈ family := by
    refine ⟨a ^ 2, L.pow_mem s.actor_mem 2, ?_⟩
    rw [conjugate, ← s.generator, MonoidHom.map_zpowers]
    rfl
  have hfamily : family = {zpowers d, zpowers ((MulAut.conj a⁻¹) d),
      zpowers ((MulAut.conj (a ^ 2)⁻¹) d)} := by
    symm
    apply Set.eq_of_subset_of_ncard_le
    · intro B hB
      rcases hB with rfl | rfl | hB
      · exact h0
      · exact h1
      · exact Set.mem_singleton_iff.mp hB ▸ h2
    · rw [show family.ncard = 3 from hc.three]
      exact (Set.ncard_eq_three.mpr ⟨_, _, _, h01, h02, h12, rfl⟩).ge
    · exact Set.finite_of_ncard_pos (show 0 < family.ncard by rw [hc.three]; decide)
  rw [span_eq_sSup, hc.conjugates]
  change sSup family = _
  rw [hfamily]
  simp only [sSup_insert, sSup_singleton, sup_assoc]

/-- Replacing the third cyclic generator by the opposite involution preserves
the literal span. -/
theorem CubicTriple.span_eq_pair_sup_product {F : InvariantFlag T V 2}
    {L : Subgroup G} {z d a : G} (s : CubicTriple F L z d a)
    (hc : CyclicTIInput F L) :
    span F = zpowers d ⊔ zpowers ((MulAut.conj a⁻¹) d) ⊔ zpowers (tripleProduct d a) := by
  apply le_antisymm
  · rw [s.span_eq_three hc]
    apply sup_le le_sup_left
    apply zpowers_le.mpr
    let P := zpowers d ⊔ zpowers ((MulAut.conj a⁻¹) d) ⊔ zpowers (tripleProduct d a)
    have h0 : d ∈ P := mem_sup_left (mem_sup_left (mem_zpowers d))
    have h1 : (MulAut.conj a⁻¹) d ∈ P := mem_sup_left (mem_sup_right (mem_zpowers _))
    have hw : tripleProduct d a ∈ P := mem_sup_right (mem_zpowers _)
    have he : (MulAut.conj (a ^ 2)⁻¹) d =
        (d * (MulAut.conj a⁻¹) d)⁻¹ * tripleProduct d a := by
      dsimp only [tripleProduct]
      group
    exact he.symm ▸ P.mul_mem (P.inv_mem (P.mul_mem h0 h1)) hw
  · obtain ⟨h0, h1, _⟩ := s.factors_mem_span hc
    exact sup_le (sup_le (zpowers_le.mpr h0) (zpowers_le.mpr h1))
      (zpowers_le.mpr (s.product_mem_span hc))

/-- The actual span is C4 squared times C2. The cubic squares distinguish
the first two cyclic factors, and nonfusion excludes the opposite involution
from their square subgroup. -/
theorem CubicTriple.span_model {F : InvariantFlag T V 2}
    {L : Subgroup G} {z d a : G} (s : CubicTriple F L z d a)
    (hc : CyclicTIInput F L) (hLN : L ≤ normalizer (V : Set G))
    (hw : orderOf (tripleProduct d a) = 2) (hwV : tripleProduct d a ∉ V) :
    Nonempty (span F ≃*
      ((Multiplicative (ZMod 4) × Multiplicative (ZMod 4)) × Multiplicative (ZMod 2))) := by
  let := hc.abelian
  have hd4 : orderOf d = 4 := by rw [← Nat.card_zpowers, s.generator, hc.card]
  have h14 : orderOf ((MulAut.conj a⁻¹) d) = 4 :=
    ((MulAut.conj a⁻¹).orderOf_eq d).trans hd4
  obtain ⟨h0, h1, _⟩ := s.factors_mem_span hc
  have hcomm (x y : G) (hx : x ∈ span F) (hy : y ∈ span F) : Commute x y :=
    congrArg Subtype.val (mul_comm' (⟨x, hx⟩ : span F) ⟨y, hy⟩)
  have hsqV : zpowers (d ^ 2) ⊔ zpowers (((MulAut.conj a⁻¹) d) ^ 2) ≤ V := by
    have hzV : z ∈ V := F.le_seed 1 (s.point.symm ▸ mem_zpowers z)
    apply sup_le
    · exact zpowers_le.mpr (s.square.symm ▸ hzV)
    · apply zpowers_le.mpr
      rw [← map_pow, s.square]
      exact (mem_normalizer_iff.mp (hLN (L.inv_mem s.actor_mem)) z).mp hzV
  obtain ⟨e⟩ := three_cyclic_four_span_equiv d ((MulAut.conj a⁻¹) d) (tripleProduct d a)
    hd4 h14 hw (by simpa only [← map_pow, s.square] using s.squares_distinct.1)
    (hcomm _ _ h0 h1) (hcomm _ _ h0 (s.product_mem_span hc))
    (hcomm _ _ h1 (s.product_mem_span hc)) (fun hh => hwV (hsqV hh))
  exact ⟨(MulEquiv.subgroupCongr (s.span_eq_pair_sup_product hc)).trans e⟩


