/-- The span isomorphism for the literal source cubic triple. -/
theorem source_triple_span_model
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hnot : ¬ ClassificationModels.IsTheoremEModel G)
    (F : InvariantFlag T (rankTwoSeed T M) 2)
    [IsElementaryAbelian 2 (rankTwoSeed T M)]
    (hne : ¬ IsMulCommutative F.U)
    (g : G) (hgP : g ∈ F.P (sourceResidual M Mc)) (hgH : g ∉ F.H)
    (hs : Group.IsSolvable F.TerminalHdot)
    (hc : CyclicTIInput F (sourceResidual M Mc)) {z d a : G}
    (s : CubicTriple F (sourceResidual M Mc) z d a) :
    Nonempty (span F ≃*
      ((Multiplicative (ZMod 4) × Multiplicative (ZMod 4)) × Multiplicative (ZMod 2))) := by
  have hwL := source_triple_outside_residual
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s
  have hcore := (source_parabolic_residual_core_structure_of_solvable
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs).2.2.1
  have hVL : rankTwoSeed T M ≤ sourceResidual M Mc :=
    s.seed_le_core.trans (hcore ▸ pCoreIn_le 2 (sourceResidual M Mc))
  have hw1 : tripleProduct d a ≠ 1 := fun he => hwL (he ▸ (sourceResidual M Mc).one_mem)
  have h := source_lemma_14_2_4 hG T hempty hM hu hmany hcard e
  exact s.span_model hc h.L_normalizes_seed (s.involution_of_ne_one hc hw1).2
    (fun hv => hwL (hVL hv))

/-- The source construction, nonfusion, span model and moved plane for a
single literal opposite involution in the original T. The remaining local
centralizer structure and global recognition stay with the core-collapse owner. -/
theorem source_opposite_span_geometry
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hnot : ¬ ClassificationModels.IsTheoremEModel G)
    (F : InvariantFlag T (rankTwoSeed T M) 2)
    [IsElementaryAbelian 2 (rankTwoSeed T M)]
    (hne : ¬ IsMulCommutative F.U)
    (g : G) (hgP : g ∈ F.P (sourceResidual M Mc)) (hgH : g ∉ F.H)
    (hs : Group.IsSolvable F.TerminalHdot)
    (hself : FactorSelfCentralizing F (sourceResidual M Mc))
    (hproper : F.Vi 1 < supplement F) :
    ∃ z d a : G, CubicTriple F (sourceResidual M Mc) z d a ∧
      tripleProduct d a ∈ (T : Subgroup G) ∧ orderOf (tripleProduct d a) = 2 ∧
      ¬ IsConj z (tripleProduct d a) ∧
      Nonempty (span F ≃*
        ((Multiplicative (ZMod 4) × Multiplicative (ZMod 4)) × Multiplicative (ZMod 2))) ∧
      omegaOneAmbient (span F ⊓ F.U) = rankTwoSeed T M ∧
      rankTwoSeed T M ≤ centralizer ({tripleProduct d a} : Set G) ∧
      a ∈ centralizer ({tripleProduct d a} : Set G) ∧
      ⁅rankTwoSeed T M, F.I₂ (sourceResidual M Mc) ⊓
        centralizer ({tripleProduct d a} : Set G)⁆ = rankTwoSeed T M ∧
      z ∈ (_root_.commutator (centralizer ({tripleProduct d a} : Set G))).map
        (centralizer ({tripleProduct d a} : Set G)).subtype := by
  have hc := source_cyclicTIInput
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hself hproper
  obtain ⟨z, d, a, s, hwT, hw⟩ := source_triple_involution
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc
  have h := source_lemma_14_2_4 hG T hempty hM hu hmany hcard e
  exact ⟨z, d, a, s, hwT, hw,
    source_triple_nonfusion hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hself hc s,
    source_triple_span_model hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s,
    source_span_core_omega hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hself hc s,
    s.plane_centralizes_product hc, s.actor_centralizes_product hc,
    source_triple_plane_moved hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s,
    s.point_mem_global_commutator hc h.L_normalizes_seed⟩

