module
public import CFSG.Quasithin.Chapter14.Section03.NonabelianSource.SourceAbelianReduction.CoreCollapse.OppositeCentralizer.ConstructionPair
public import Theory.GroupTheory.QuaternionCentralProductOrderFourResidual
public import Theory.GroupTheory.QuaternionCentralProductTransport

/-!
# The marked opposite residual centralizer

The original quaternion closure U is self-centralizing in K=O²(H): an
actor fixing U has trivial terminal action, hence lies in Q, and K∩Q=U.
The checked order |K|=288 therefore supplies two commuting SL₂(3) factors.
For the literal t=dᵃdᵃ², its order four puts it in one quaternion factor;
the centralizer in K is ⟨t⟩ * SL₂(3), with overlap ⟨t²⟩=Z. Since K fixes d,
this is exactly C_K(w) for the original w=dt. Its order is 48, and its
normal Sylow two-subgroup is the literal C_U(w), of order sixteen.

The final local-geometry adapter combines this result with the earlier
triple, parabolic and transfer calculations. It retains only the two
unproved local premises, the omega-center and Sylow maximality in C_H(w).
Their discharge, global G₂(2) recognition and RQ marking remain with
qt-e-14322-core-collapse; no complete core-collapse theorem is asserted here.

Source: Aschbacher--Smith, 14.3.22, printed p.999.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter14.Section03.NonabelianSource.SourceAbelianReduction.CoreCollapse.OppositeCentralizer
open Chapter12.Section08 Chapter12.Section08.InvariantFlag
open Recognition Chapter14.Section02 SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
variable {G : Type*} [Group G] [Finite G]
variable
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hnot : ¬ ClassificationModels.IsTheoremEModel G)
    (F : InvariantFlag T (rankTwoSeed T M) 2)
    [IsElementaryAbelian 2 (rankTwoSeed T M)]
    (hne : ¬ IsMulCommutative F.U)
    (g : G) (hgP : g ∈ F.P (sourceResidual M Mc)) (hgH : g ∉ F.H)
    (hs : Group.IsSolvable F.TerminalHdot)
    (hc : CyclicTIInput F (sourceResidual M Mc)) {z d a : G}
    (s : CubicTriple F (sourceResidual M Mc) z d a)
include hG hempty hM hu hmany hcard e hnot hne hgP hgH hs


/-- The quaternion closure is self-centralizing inside the original two-residual. -/
theorem source_local_residual_selfcentralizing :
    centralizer (F.U.subgroupOf (localResidual F) : Set (localResidual F)) ≤
      F.U.subgroupOf (localResidual F) := by
  let h := source_lemma_14_2_4 hG T hempty hM hu hmany hcard e
  obtain ⟨dg,he,_,_,_,_,_⟩ := rankTwo_terminal_hypothesis h F hne g hgP hgH
  let := he
  have hZ := source_center_eq_point_of_solvable hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs
  have hr := source_full_orthogonal_of_solvable hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs
  let K := localResidual F
  have hUK : F.U ≤ K := U_le_embedded_twoResidual_of_full_orthogonal F dg hZ hne hr
  have hcore : F.U = K.pCoreIn 2 := twoResidual_core_eq_U_of_full_orthogonal
    hG T hempty hM hu hmany hcard e hnot F dg hZ hne g hgP hgH hr
  intro x hx
  have hxH : (x : G) ∈ F.H := (map_subtype_le (pResidual 2 F.H)) x.property
  have hxa : F.uAction ⟨x,hxH⟩ = 1 := by
    apply MulEquiv.ext
    intro u
    apply Subtype.ext
    change (x : G) * (u : G) * (x : G)⁻¹ = (u : G)
    have hh := congrArg Subtype.val (hx (⟨u,hUK u.property⟩ : K) u.property)
    change (u : G) * (x : G) = (x : G) * (u : G) at hh
    rw [←hh,mul_inv_cancel_right]
  have hxk : (⟨x,hxH⟩ : F.H) ∈ F.terminalHatAction.ker := by
    change quotientAut (center F.U) (F.uAction ⟨x,hxH⟩) = 1
    rw [hxa,map_one]
  rw [terminal_kernel_of_center_point F dg hZ] at hxk
  have hxQ : (x : G) ∈ F.H.pCoreIn 2 := mem_map_of_mem F.H.subtype hxk
  change (x : G) ∈ F.U
  rw [hcore]
  exact inf_pCoreIn_le_of_le 2 (map_subtype_le _) ⟨x.property,hxQ⟩

include hc s
/-- The opposite involution's actual residual centralizer is the marked
C₄ * SL₂(3), with cyclic factor generated by dᵃdᵃ² and overlap equal to Z. -/
theorem source_triple_residual_centralizer :
    let t := (MulAut.conj a⁻¹) d * (MulAut.conj (a ^ 2)⁻¹) d
    ∃ B : Subgroup G,
      Nonempty (zpowers t ≃* Multiplicative (ZMod 4)) ∧
      Nonempty (B ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod 3)) ∧
      zpowers t ≤ centralizer (B : Set G) ∧ zpowers t ⊓ B = F.Vi 1 ∧
      zpowers t ⊔ B = localResidual F ⊓ centralizer ({tripleProduct d a} : Set G) := by
  intro t
  let h := source_lemma_14_2_4 hG T hempty hM hu hmany hcard e
  obtain ⟨dg,he,_,_,_,_,_⟩ := rankTwo_terminal_hypothesis h F hne g hgP hgH
  let := he
  have hZ := source_center_eq_point_of_solvable hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs
  have hr := source_full_orthogonal_of_solvable hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs
  obtain ⟨dU⟩ := quaternion_closure_of_full_orthogonal F dg hZ hne hr
  let K := localResidual F
  have hKH : K ≤ F.H := map_subtype_le _
  have hUK : F.U ≤ K := U_le_embedded_twoResidual_of_full_orthogonal F dg hZ hne hr
  let Q := F.U.subgroupOf K
  let : Q.Normal := (normal_subgroupOf_iff_le_normalizer hUK).mpr
    (hKH.trans (le_normalizer_conjugateSpanBy _ _))
  let eQ : Q ≃* F.U := subgroupOfEquivOfLe hUK
  let dQ : QuaternionCentralProductData Q := dU.map eQ.symm
  obtain ⟨htU,ht2,ht4,_⟩ := source_triple_pair_geometry
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s
  let tq : Q := ⟨⟨t,hUK htU⟩,htU⟩
  have htq : orderOf tq = 4 := by
    rw [←orderOf_coe,←orderOf_coe]
    exact ht4
  have hKc : Nat.card K = 288 :=
    (source_local_residual_sylow hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs).2
  obtain ⟨B,hB,hcomm,hinter,hgen⟩ := quaternion_extension_order_four_centralizer Q dQ hKc
    (source_local_residual_selfcentralizing hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs) tq htq
  let BG := B.map K.subtype
  have hBmodel : Nonempty (BG ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod 3)) :=
    ⟨(B.equivMapOfInjective K.subtype K.subtype_injective).symm.trans hB.some⟩
  have heq : (zpowers (tq : K)).map K.subtype = zpowers t := MonoidHom.map_zpowers K.subtype _
  have hcentral : zpowers t ≤ centralizer (BG : Set G) := by
    rw [←heq]
    rintro _ ⟨x,hx,rfl⟩ _ ⟨b,hb,rfl⟩
    exact congrArg Subtype.val (hcomm hx b hb)
  have hI : zpowers t ⊓ BG = F.Vi 1 := by
    have hh := congrArg (Subgroup.map K.subtype) hinter
    rw [map_inf _ _ K.subtype K.subtype_injective,heq,MonoidHom.map_zpowers] at hh
    change zpowers t ⊓ BG = zpowers (t^2) at hh
    have ht2' : t^2=z := ht2
    rwa [ht2',←s.point] at hh
  have hJ : zpowers t ⊔ BG = K ⊓ centralizer ({t} : Set G) := by
    have hh := congrArg (Subgroup.map K.subtype) hgen
    rw [Subgroup.map_sup,heq] at hh
    refine hh.trans ?_
    ext x
    constructor
    · rintro ⟨y,hy,rfl⟩
      exact ⟨y.property,mem_centralizer_singleton_iff.mpr
        (congrArg Subtype.val (mem_centralizer_singleton_iff.mp hy))⟩
    · rintro ⟨hxK,hxc⟩
      exact ⟨⟨x,hxK⟩,mem_centralizer_singleton_iff.mpr
        (Subtype.ext (mem_centralizer_singleton_iff.mp hxc)),rfl⟩
  have hC := (source_triple_residual_centralizer_reduction
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s).2
  refine ⟨BG,⟨mulEquivOfCyclicCardEq ?_⟩,hBmodel,hcentral,hI,hJ.trans hC.symm⟩
  rw [Nat.card_zpowers,ht4]
  change 4 = Nat.card (ZMod 4)
  rw [Nat.card_zmod]

/-- The recognized residual centralizer has order 48. -/
theorem source_triple_residual_centralizer_card :
    Nat.card (localResidual F ⊓ centralizer ({tripleProduct d a} : Set G) : Subgroup G) = 48 := by
  let t := (MulAut.conj a⁻¹) d * (MulAut.conj (a ^ 2)⁻¹) d
  obtain ⟨B,hE,hB,hcomm,hinter,hgen⟩ := source_triple_residual_centralizer
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s
  have hEc : Nat.card (zpowers t) = 4 := by
    rw [Nat.card_congr hE.some.toEquiv]
    change Nat.card (ZMod 4) = 4
    rw [Nat.card_zmod]
  have hBc : Nat.card B = 24 := by
    rw [Nat.card_congr (hB.some.trans
      GLS3.Chapter5.SchurPresentation.binaryTetrahedralEquivSL.symm).toEquiv,
      Nat.card_congr SemidirectProduct.equivProd,Nat.card_prod,
      Nat.card_eq_fintype_card,QuaternionGroup.card]
    change 8 * Nat.card (ZMod 3) = 24
    rw [Nat.card_zmod]
  have hZc : Nat.card (F.Vi 1) = 2 := by simpa using F.card 1 (by decide)
  have he := card_mul_eq_card_inf_mul_card_sup_of_normalizes (zpowers t) B
    ((le_centralizer_iff.mp hcomm).trans (Subgroup.centralizer_le_normalizer _))
  rw [hEc,hBc,hinter,hgen,hZc] at he
  omega

/-- The original U-centralizer is the normal Sylow two-subgroup of the
residual centralizer, of order sixteen. Its embedded two-core is literal. -/
theorem source_triple_residual_centralizer_sylow :
    let C := localResidual F ⊓ centralizer ({tripleProduct d a} : Set G)
    let P := F.U ⊓ centralizer ({tripleProduct d a} : Set G)
    Nat.card P = 16 ∧ C.pCoreIn 2 = P ∧
      ∃ S : Sylow 2 C, (S : Subgroup C).map C.subtype = P := by
  intro C P
  let h := source_lemma_14_2_4 hG T hempty hM hu hmany hcard e
  obtain ⟨dg,he,_,_,_,_,_⟩ := rankTwo_terminal_hypothesis h F hne g hgP hgH
  let := he
  have hZ := source_center_eq_point_of_solvable hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs
  have hr := source_full_orthogonal_of_solvable hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs
  obtain ⟨dU⟩ := quaternion_closure_of_full_orthogonal F dg hZ hne hr
  let K := localResidual F
  have hKH : K ≤ F.H := map_subtype_le _
  have hUK : F.U ≤ K := U_le_embedded_twoResidual_of_full_orthogonal F dg hZ hne hr
  let Q := F.U.subgroupOf K
  let : Q.Normal := (normal_subgroupOf_iff_le_normalizer hUK).mpr
    (hKH.trans (le_normalizer_conjugateSpanBy _ _))
  have hQi : Q.index = 9 := by
    have hh := Q.card_mul_index
    rw [Nat.card_congr (subgroupOfEquivOfLe hUK).toEquiv,dU.card,
      (source_local_residual_sylow hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs).2] at hh
    omega
  have hPC : P ≤ C := inf_le_inf_right _ hUK
  have hPI : P.subgroupOf C = F.U.subgroupOf C := by
    ext x
    exact and_iff_left x.property.2
  have hidx : ¬ 2 ∣ (P.subgroupOf C).index := by
    rw [hPI]
    change ¬ 2 ∣ F.U.relIndex C
    have hd : F.U.relIndex C ∣ 9 := by
      rw [←relIndex_subgroupOf (show C ≤ K from inf_le_left)]
      exact (Q.relIndex_dvd_index_of_normal (C.subgroupOf K)).trans (hQi ▸ dvd_rfl)
    exact fun hh => (by decide : ¬ 2 ∣ 9) (hh.trans hd)
  have hp : IsPGroup 2 P := dg.two.to_inf_left
  let S : Sylow 2 C := (hp.of_equiv (subgroupOfEquivOfLe hPC).symm).toSylow hidx
  have hS : (S : Subgroup C).map C.subtype = P := map_subgroupOf_eq_of_le hPC
  have hPN : C ≤ normalizer (P : Set G) :=
    (le_inf ((inf_le_left.trans hKH).trans (le_normalizer_conjugateSpanBy _ _))
      (inf_le_right.trans (centralizer ({tripleProduct d a} : Set G)).le_normalizer)).trans
      inf_normalizer_le_normalizer_inf
  have hcore : C.pCoreIn 2 = P := le_antisymm
    ((pCoreIn_le_sylow C S).trans_eq hS) (le_pCoreIn_of_normalizes hp hPC hPN)
  have hCc : Nat.card C = 48 := source_triple_residual_centralizer_card
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s
  have hSc : Nat.card S = 16 := by
    rw [Sylow.card_eq_multiplicity,hCc]
    decide +kernel
  have hPc : Nat.card P = 16 := by
    rw [←hS,card_map_of_injective C.subtype_injective]
    exact hSc
  exact ⟨hPc,hcore,S,hS⟩

omit hc s in
/-- Construct the source triple and its marked residual central product,
including the literal normal Sylow two-subgroup. The cyclic-TI premise is discharged. -/
theorem source_opposite_residual_centralizer
    (hself : FactorSelfCentralizing F (sourceResidual M Mc))
    (hproper : F.Vi 1 < supplement F) :
    ∃ z d a t : G, CubicTriple F (sourceResidual M Mc) z d a ∧
      t = (MulAut.conj a⁻¹) d * (MulAut.conj (a ^ 2)⁻¹) d ∧
      t ∈ F.U ∧ t^2=z ∧ orderOf t=4 ∧ tripleProduct d a=d*t ∧
      orderOf (tripleProduct d a)=2 ∧
      ∃ B : Subgroup G,
        Nonempty (zpowers t ≃* Multiplicative (ZMod 4)) ∧
        Nonempty (B ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod 3)) ∧
        zpowers t ≤ centralizer (B : Set G) ∧ zpowers t ⊓ B = F.Vi 1 ∧
        zpowers t ⊔ B = localResidual F ⊓ centralizer ({tripleProduct d a} : Set G) ∧
        Nat.card (localResidual F ⊓ centralizer ({tripleProduct d a} : Set G) : Subgroup G)=48 ∧
        (localResidual F ⊓ centralizer ({tripleProduct d a} : Set G)).pCoreIn 2 =
          F.U ⊓ centralizer ({tripleProduct d a} : Set G) ∧
        Nat.card (F.U ⊓ centralizer ({tripleProduct d a} : Set G) : Subgroup G)=16 := by
  have hc := source_cyclicTIInput hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hself hproper
  obtain ⟨z,d,a,s,_,hw⟩ := source_triple_involution
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc
  obtain ⟨ht,ht2,ht4,hwt⟩ := source_triple_pair_geometry
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s
  obtain ⟨B,hB⟩ := source_triple_residual_centralizer
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s
  obtain ⟨hP,hcore,_⟩ := source_triple_residual_centralizer_sylow
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s
  exact ⟨z,d,a,_,s,rfl,ht,ht2,ht4,hwt,hw,B,hB.1,hB.2.1,hB.2.2.1,hB.2.2.2.1,hB.2.2.2.2,
    source_triple_residual_centralizer_card hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s,
    hcore,hP⟩

/-- Assemble every established local clause on the same literal triple.
Only the omega-center calculation and Sylow maximality in C_H(w) remain
explicit here; their discharge and global recognition belong to the same
core-collapse owner. -/
theorem source_triple_local_geometry_of_sylow_and_omega
    (hself : FactorSelfCentralizing F (sourceResidual M Mc))
    (homega : omegaCenterIn ((T : Subgroup G) ⊓ centralizer ({tripleProduct d a} : Set G)) =
      closure ({z, tripleProduct d a} : Set G))
    (hlocal : ∃ S : Sylow 2 (F.H ⊓ centralizer ({tripleProduct d a} : Set G) : Subgroup G),
      (S : Subgroup _).map (F.H ⊓ centralizer ({tripleProduct d a} : Set G)).subtype =
        (T : Subgroup G) ⊓ centralizer ({tripleProduct d a} : Set G)) :
    LocalGeometry F (sourceResidual M Mc) z (tripleProduct d a) := by
  have hwout := source_triple_outside_transfer
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s
  have hw1 : tripleProduct d a ≠ 1 := fun he => hwout (he ▸ Subgroup.one_mem _)
  obtain ⟨hwT,hw2⟩ := s.involution_of_ne_one hc hw1
  obtain ⟨hC,hCmodel⟩ := source_triple_core_centralizer
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hself hc s
  obtain ⟨B,hE,hB,hcomm,hinter,hgen⟩ := source_triple_residual_centralizer
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s
  exact {
    point := s.point
    triple := ⟨d,s.generator ▸ mem_zpowers d,a,s.actor_mem,s.generator,s.square,rfl⟩
    mem_sylow := hwT
    involution := hw2
    nonfusion := source_triple_nonfusion
      hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hself hc s
    product_fusion := source_triple_product_fusion
      hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hself hc s
    omega_center := homega
    local_sylow := hlocal
    span_model := source_triple_span_model
      hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s
    span_core_omega := source_span_core_omega
      hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hself hc s
    core_commutator := source_triple_core_commutator
      hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hself hc s
    core_centralizer := hC
    core_centralizer_model := hCmodel
    parabolic_frattini := source_triple_parabolic_frattini
      hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hself hc s
    parabolic_quotient := source_triple_parabolic_quotient
      hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hself hc s
    residual_centralizer := ⟨_,B,hE,hB,hcomm,hinter,hgen⟩
    plane_centralizes := s.plane_centralizes_product hc
    plane_moved := source_triple_plane_moved
      hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s
    quotient_normal := (source_transfer_subgroup_sylow
      hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs).1
    quotient_index := source_transfer_subgroup_index
      hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc
    outside_residual := hwout }

end CFSG.Quasithin.Chapter14.Section03.NonabelianSource.SourceAbelianReduction.CoreCollapse.OppositeCentralizer
