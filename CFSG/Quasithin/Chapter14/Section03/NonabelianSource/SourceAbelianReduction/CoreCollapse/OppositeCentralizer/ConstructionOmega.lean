/-!
# Complete local geometry of the three-factor opposite involution

A central involution of C_T(w) fixes C_U(w) pointwise. This subgroup has
index two in U; the involutive automorphism lemma therefore makes its
terminal action trivial and puts the involution in Q=UD. The extraspecial
double-centralizer calculation puts its U-coordinate in Z(U)⟨dᵃdᵃ²⟩.
Since D is cyclic of order four, its square-one elements in D⟨w⟩ are
exactly ⟨z,w⟩. This proves Ω₁Z(C_T(w))=⟨z,w⟩ on the original T.

The final theorems combine this with the checked Sylow, triple, parabolic,
residual and transfer calculations to construct every LocalGeometry clause.
Global G₂(2) quotient recognition and the RQ marking remain obligations of
qt-e-14322-core-collapse; they are not asserted by this local construction.

Source: Aschbacher--Smith 14.3.22, printed pp.998--999.
-/

public section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative Pointwise
namespace CFSG.Quasithin.Chapter14.Section03.NonabelianSource.SourceAbelianReduction.CoreCollapse.OppositeCentralizer
open Chapter12.Section08 Chapter12.Section08.InvariantFlag
open Recognition Chapter14.Section02 SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
variable {G : Type*} [Group G] [Finite G]
variable
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hnot : ¬ ClassificationModels.IsTheoremEModel G)
    (F : InvariantFlag T (rankTwoSeed T M) 2)
    [IsElementaryAbelian 2 (rankTwoSeed T M)]
    (hne : ¬ IsMulCommutative F.U)
    (g : G) (hgP : g ∈ F.P (sourceResidual M Mc)) (hgH : g ∉ F.H)
    (hs : Group.IsSolvable F.TerminalHdot)
    (hc : CyclicTIInput F (sourceResidual M Mc)) {z d a : G}
    (s : CubicTriple F (sourceResidual M Mc) z d a)
include hG hempty hM hu hmany hcard e hnot hne hgP hgH hs hc s


/-- The literal centralizer in T has omega-center generated by z and w. -/
theorem source_triple_omega_center :
    omegaCenterIn ((T : Subgroup G) ⊓ centralizer ({tripleProduct d a} : Set G)) =
      closure ({z,tripleProduct d a} : Set G) := by
  let h := source_lemma_14_2_4 hG T hempty hM hu hmany hcard e
  obtain ⟨dg,he,_,_,_,_,_⟩ := rankTwo_terminal_hypothesis h F hne g hgP hgH
  let := he
  have hZ := source_center_eq_point_of_solvable hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs
  have hr := source_full_orthogonal_of_solvable hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs
  obtain ⟨dU⟩ := quaternion_closure_of_full_orthogonal F dg hZ hne hr
  let : IsExtraspecial 2 F.U := dU.extraspecial
  let := hc.cyclic
  let w := tripleProduct d a
  let t := (MulAut.conj a⁻¹) d * (MulAut.conj (a ^ 2)⁻¹) d
  let D := supplement F
  let P := (T : Subgroup G) ⊓ centralizer ({w} : Set G)
  let J := closure ({z,w} : Set G)
  obtain ⟨htU,ht2,ht4,hwt⟩ := source_triple_pair_geometry
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s
  change w=d*t at hwt
  have hdD : d ∈ D := by
    change d ∈ supplement F
    rw [←s.generator]
    exact mem_zpowers d
  have hUT : F.U ≤ (T : Subgroup G) := normalized_pSubgroup_le_sylow T F.H F.U
    (F.invariant 1) F.U_le_H (le_normalizer_conjugateSpanBy _ _) dg.two
  have hUK : F.U ≤ localResidual F := U_le_embedded_twoResidual_of_full_orthogonal F dg hZ hne hr
  have hCC : F.U ⊓ centralizer ({w} : Set G) = F.U ⊓ centralizer ({t} : Set G) := by
    calc
      _ = F.U ⊓ (localResidual F ⊓ centralizer ({w} : Set G)) := by
        rw [←inf_assoc, inf_eq_left.mpr hUK]
      _ = F.U ⊓ (localResidual F ⊓ centralizer ({t} : Set G)) :=
        congrArg (F.U ⊓ ·) (source_triple_residual_centralizer_reduction
          hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s).2
      _ = _ := by rw [←inf_assoc, inf_eq_left.mpr hUK]
  let tt : F.U := ⟨t,htU⟩
  let C := centralizer ({tt} : Set F.U)
  have hmapC : C.map F.U.subtype = F.U ⊓ centralizer ({w} : Set G) :=
    (map_subtype_centralizer_singleton F.U tt).trans hCC.symm
  have hCP : C.map F.U.subtype ≤ P := hmapC ▸ inf_le_inf_right _ hUT
  have hCc : Nat.card C = 16 := by
    rw [←card_map_of_injective F.U.subtype_injective, hmapC]
    exact (source_triple_residual_centralizer_sylow
      hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s).1
  have hCi : C.index = 2 := by
    have hh := C.card_mul_index
    rw [hCc,dU.card] at hh
    omega
  have hZD : F.Vi 1 ≤ D := hc.strict.le
  have hzD : z ∈ D := hZD (s.point.symm ▸ mem_zpowers z)
  have hz2 : orderOf z = 2 := by
    rw [←Nat.card_zpowers, ←s.point]
    simpa using F.card 1 (by decide)
  have hw2 : w^2=1 := (s.product_mem_sylow_and_square hc).2
  have hwT : w ∈ (T : Subgroup G) := (s.product_mem_sylow_and_square hc).1
  have hzt : (T : Subgroup G) ≤ centralizer ({z} : Set G) :=
    (F.invariant 1).trans_eq (F.H_eq_centralizer (by decide) z s.point)
  have hzT : z ∈ (T : Subgroup G) :=
    h.seed_le_sylow (F.le_seed 1 (s.point.symm ▸ mem_zpowers z))
  have hzJ : z ∈ J := subset_closure (by simp)
  have hwJ : w ∈ J := subset_closure (by simp)
  apply le_antisymm
  · intro x hx
    obtain ⟨hxP,hxc,hx2⟩ := (mem_omegaCenterIn_iff P x).mp hx
    have hxH : x ∈ F.H := F.invariant 1 hxP.1
    let xx : F.H := ⟨x,hxH⟩
    let α := F.uAction xx
    have hα2 : α^2=1 := by
      rw [←map_pow]
      have hh : xx^2=1 := Subtype.ext hx2
      rw [hh,map_one]
    have hαfix (c : F.U) (hcC : c ∈ C) : α c=c := by
      apply Subtype.ext
      change x*(c:G)*x⁻¹=(c:G)
      rw [←hxc c (hCP (mem_map_of_mem F.U.subtype hcC)),mul_inv_cancel_right]
    have hαsq (u : F.U) : α (u^2)=u^2 :=
      dU.fixes_center α ⟨u^2,dU.square_mem_center u⟩
    have hαq := quotientAut_eq_one_of_involutive_fixed_index_two C hCi α hα2 hαfix hαsq
    have hxker : xx ∈ F.terminalHatAction.ker := hαq
    rw [terminal_kernel_of_center_point F dg hZ] at hxker
    have hxQ : x ∈ F.H.pCoreIn 2 := mem_map_of_mem F.H.subtype hxker
    rw [core_eq_U_sup_centralizer F dg hZ dU] at hxQ
    change x ∈ (↑(F.U ⊔ D) : Set G) at hxQ
    rw [coe_mul_of_right_le_normalizer_left _ _
      (show D ≤ normalizer (F.U : Set G) from inf_le_right.trans (Subgroup.centralizer_le_normalizer _))] at hxQ
    obtain ⟨u,hu,b,hb,hub⟩ := hxQ
    change u*b=x at hub
    have huC : (⟨u,hu⟩ : F.U) ∈ centralizer (C : Set F.U) := by
      intro c hcC
      apply Subtype.ext
      have hxcomm := hxc c (hCP (mem_map_of_mem F.U.subtype hcC))
      have hbcomm := hb.2 c c.property
      apply mul_right_cancel (b := b)
      calc
        (c:G)*u*b = (c:G)*x := by rw [mul_assoc,hub]
        _ = x*c := hxcomm
        _ = u*(b*c) := by rw [←hub,mul_assoc]
        _ = u*(c*b) := by rw [←hbcomm]
        _ = u*c*b := (mul_assoc _ _ _).symm
    have huZt := extraspecial_double_centralizer_le tt hCi huC
    have hZt : (center F.U ⊔ zpowers tt).map F.U.subtype ≤ D ⊔ zpowers t := by
      rw [Subgroup.map_sup,MonoidHom.map_zpowers]
      apply sup_le _ le_sup_right
      change F.ZU ≤ D ⊔ zpowers t
      rw [hZ]
      exact hZD.trans le_sup_left
    have huDt : u ∈ D ⊔ zpowers t := hZt (mem_map_of_mem F.U.subtype huZt)
    have hxDt : x ∈ D ⊔ zpowers t := hub ▸
      (D ⊔ zpowers t).mul_mem huDt (mem_sup_left hb)
    have htDw : t ∈ D ⊔ zpowers w := by
      have hh := (D ⊔ zpowers w).mul_mem (mem_sup_left (D.inv_mem hdD))
        (mem_sup_right (mem_zpowers w))
      have heq : d⁻¹*w=t := by rw [hwt]; simp
      exact heq ▸ hh
    have hxDw : x ∈ D ⊔ zpowers w :=
      (sup_le le_sup_left (zpowers_le.mpr htDw)) hxDt
    have hDw : D ≤ centralizer ({w} : Set G) := by
      intro q hq
      apply mem_centralizer_singleton_iff.mpr
      have hqd : Commute q d := congrArg Subtype.val (mul_comm' (⟨q,hq⟩ : D) ⟨d,hdD⟩)
      have hqt : Commute q t := (hq.2 t htU).symm
      exact hwt.symm ▸ (hqd.mul_right hqt).eq
    have hwDN : zpowers w ≤ normalizer (D : Set G) :=
      (zpowers_le.mpr
        (show w ∈ centralizer (D : Set G) from fun q hq =>
          mem_centralizer_singleton_iff.mp (hDw hq))).trans (Subgroup.centralizer_le_normalizer _)
    change x ∈ (↑(D ⊔ zpowers w) : Set G) at hxDw
    rw [coe_mul_of_right_le_normalizer_left _ _ hwDN] at hxDw
    obtain ⟨q,hq,y,hy,hqy⟩ := hxDw
    let : IsElementaryAbelian 2 (zpowers w) := IsElementaryAbelian.zpowers_of_pow_eq_one hw2
    have hy2 : y^2=1 := elemPow_eq_one_of_isElementaryAbelian y hy
    have hqycomm : Commute q y := by
      have hcq : zpowers w ≤ centralizer ({q} : Set G) := zpowers_le.mpr
        (mem_centralizer_singleton_iff.mpr (mem_centralizer_singleton_iff.mp (hDw hq)).symm)
      exact (mem_centralizer_singleton_iff.mp (hcq hy)).symm
    have hq2 : q^2=1 := by
      rw [←hqy,hqycomm.mul_pow,hy2,mul_one] at hx2
      exact hx2
    have hqJ : q ∈ J := by
      by_cases hq1 : q=1
      · exact hq1 ▸ J.one_mem
      have heq : (⟨q,hq⟩ : D) = ⟨z,hzD⟩ := IsCyclic.eq_of_orderOf_eq_two
        (orderOf_eq_prime (Subtype.ext hq2) (fun h => hq1 (congrArg Subtype.val h)))
        ((orderOf_coe (⟨z,hzD⟩ : D)).symm.trans hz2)
      have hqz : q=z := congrArg Subtype.val heq
      exact hqz.symm ▸ hzJ
    exact hqy ▸ J.mul_mem hqJ ((zpowers_le.mpr hwJ) hy)
  · apply (closure_le _).mpr
    intro x hx
    rcases Set.mem_insert_iff.mp hx with hx | hx
    · rw [hx]
      apply (mem_omegaCenterIn_iff P z).mpr
      exact ⟨⟨hzT,mem_centralizer_singleton_iff.mpr
        (mem_centralizer_singleton_iff.mp (hzt hwT)).symm⟩,
        (fun p hp => mem_centralizer_singleton_iff.mp (hzt hp.1)),hz2 ▸ pow_orderOf_eq_one z⟩
    · have heq : x=w := Set.mem_singleton_iff.mp hx
      subst x
      apply (mem_omegaCenterIn_iff P w).mpr
      exact ⟨⟨hwT,mem_centralizer_singleton_iff.mpr rfl⟩,
        (fun p hp => mem_centralizer_singleton_iff.mp hp.2),hw2⟩


/-- Every local clause of the original opposite-involution geometry holds
for the same literal three-factor product in the supplied Sylow subgroup. -/
theorem source_triple_local_geometry
    (hself : FactorSelfCentralizing F (sourceResidual M Mc)) :
    LocalGeometry F (sourceResidual M Mc) z (tripleProduct d a) :=
  source_triple_local_geometry_of_sylow_and_omega
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s hself
    (source_triple_omega_center hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s)
    (source_triple_local_sylow hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s hself)

omit s in
/-- Construct the complete local geometry from the explicit cyclic-TI input.
No omega-center, Sylow or other local-geometry premise remains. -/
theorem source_opposite_local_geometry_of_cyclicTI
    (hself : FactorSelfCentralizing F (sourceResidual M Mc)) :
    ∃ z w : G, LocalGeometry F (sourceResidual M Mc) z w := by
  obtain ⟨z,d,a,s,_,_⟩ := source_triple_involution
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc
  exact ⟨z,tripleProduct d a,source_triple_local_geometry
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s hself⟩

omit hc s in
/-- The proper-supplement branch supplies the opposite involution, its
complete local geometry and its actual global Sylow centralizer. -/
theorem source_opposite_local_geometry
    (hself : FactorSelfCentralizing F (sourceResidual M Mc))
    (hproper : F.Vi 1 < supplement F) :
    ∃ z w : G, LocalGeometry F (sourceResidual M Mc) z w ∧
      ∃ S : Sylow 2 (centralizer ({w} : Set G)),
        (S : Subgroup _).map (centralizer ({w} : Set G)).subtype =
          (T : Subgroup G) ⊓ centralizer ({w} : Set G) := by
  have hc := source_cyclicTIInput hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hself hproper
  obtain ⟨z,d,a,s,_,_⟩ := source_triple_involution
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc
  exact ⟨z,tripleProduct d a,source_triple_local_geometry
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s hself,
    source_triple_global_sylow hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs hc s hself⟩

