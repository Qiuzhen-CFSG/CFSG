module
public import CFSG.Quasithin.Chapter14.Section03.NonabelianSource.SourceAbelianReduction.FactorSelfCentralizing.Reduction

/-!
# The literal central quotient in the marked 14.3.20 argument

The denominator is the cyclic subgroup generated by the same marked d inside
C_G(d); its image, order, centrality and equality with the supplied two-core
are proved. The quotient map is injective on the original factor A.

An element centralizing the image of z can conjugate z upstairs only to z
or zd. The original five-free point centralizer separates z from d, whereas
the supplied product fusion conjugates d to zd. Thus the second case cannot
occur: the inverse image of the entire quotient centralizer is precisely
H intersect C_G(d), with the original subgroup maps.

The source consumer discharges nonfusion under the original hypotheses,
retaining solvability of TerminalHdot. The subsequent extension structure
and model exclusions remain separate obligations.
Source: Aschbacher--Smith, 14.3.20, printed pp.997--998.
-/

@[expose] public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter14.Section03.NonabelianSource.SourceAbelianReduction.SelfCentralizing
open Chapter12.Section08 Chapter12.Section08.InvariantFlag
open Chapter15.Section03.Candidates.ComponentStructure
variable {G : Type*} [Group G] {T : Sylow 2 G} {V : Subgroup G}
variable {F : InvariantFlag T V 2} {L A : Subgroup G}

namespace MarkedPoint
variable (P : MarkedPoint F L A)

abbrev pointInCentralizer : P.globalCentralizer :=
  ⟨P.element, mem_centralizer_singleton_iff.mpr rfl⟩

def pointKernel : Subgroup P.globalCentralizer := zpowers P.pointInCentralizer

theorem pointKernel_le_center : P.pointKernel ≤ center P.globalCentralizer := by
  apply zpowers_le.mpr
  exact mem_center_iff.mpr fun x =>
    Subtype.ext (mem_centralizer_singleton_iff.mp x.property)

instance pointKernel_normal : P.pointKernel.Normal where
  conj_mem x hx y := by
    rw [mem_center_iff.mp (P.pointKernel_le_center hx) y, mul_inv_cancel_right]
    exact hx

abbrev PointQuotient := P.globalCentralizer ⧸ P.pointKernel

abbrev pointQuotientMap : P.globalCentralizer →* P.PointQuotient :=
  QuotientGroup.mk' P.pointKernel

theorem pointKernel_map : P.pointKernel.map P.globalCentralizer.subtype = zpowers P.element := by
  exact MonoidHom.map_zpowers _ _

theorem pointKernel_eq_subgroupOf : P.pointKernel =
    (zpowers P.element).subgroupOf P.globalCentralizer := by
  apply map_injective P.globalCentralizer.subtype_injective
  rw [P.pointKernel_map, map_subgroupOf_eq_of_le]
  exact zpowers_le.mpr (mem_centralizer_singleton_iff.mpr rfl)

variable [Finite G]

omit [Finite G] in
theorem pointKernel_card : Nat.card P.pointKernel = 2 := by
  rw [←card_map_of_injective P.globalCentralizer.subtype_injective,
    P.pointKernel_map, Nat.card_zpowers, P.point_order]

private theorem pointKernel_cases {x : P.globalCentralizer} (hx : x ∈ P.pointKernel) :
    x = 1 ∨ x = P.pointInCentralizer := by
  classical
  have ho : orderOf P.pointInCentralizer = 2 :=
    (orderOf_injective P.globalCentralizer.subtype Subtype.val_injective _).symm.trans P.point_order
  change x ∈ zpowers P.pointInCentralizer at hx
  rw [mem_zpowers_iff_mem_range_orderOf, ho] at hx
  obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp hx
  have hn2 : n < 2 := Finset.mem_range.mp hn
  interval_cases n <;> simp

theorem factor_quotient_injective :
    Function.Injective (P.pointQuotientMap.comp (A.subgroupOf P.globalCentralizer).subtype) := by
  apply (MonoidHom.ker_eq_bot_iff _).mp
  apply (eq_bot_iff_forall _).mpr
  intro x hx
  have hk : (x : P.globalCentralizer) ∈ P.pointKernel :=
    (QuotientGroup.eq_one_iff _).mp hx
  rcases P.pointKernel_cases hk with h | h
  · exact Subtype.ext h
  · exact (P.outside_factor ((congrArg Subtype.val h) ▸ x.property)).elim

omit [Finite G] in
theorem pointQuotientMap_ker : P.pointQuotientMap.ker = P.pointKernel :=
  QuotientGroup.ker_mk' _

omit [Finite G] in
theorem pointKernel_eq_core
    (hcore : P.globalCentralizer.pCoreIn 2 = zpowers P.element) :
    P.pointKernel = pCore 2 P.globalCentralizer := by
  apply map_injective P.globalCentralizer.subtype_injective
  exact P.pointKernel_map.trans hcore.symm

omit [Finite G] in
theorem generator_mem (hVA : V ≤ A) (z : G) (hz : F.Vi 1 = zpowers z) :
    z ∈ P.blockCentralizer :=
  P.factor_le_blockCentralizer (hVA (F.le_seed 1 (hz.symm ▸ mem_zpowers z)))

abbrev markedGenerator (hVA : V ≤ A) (z : G) (hz : F.Vi 1 = zpowers z) :
    P.globalCentralizer := ⟨z, (P.generator_mem hVA z hz).2⟩

theorem quotient_centralizer_comap (hVA : V ≤ A) (z : G) (hz : F.Vi 1 = zpowers z)
    (hnf : ¬ IsConj z P.element) (hgeom : P.FourCenterGeometry z) :
    (centralizer ({P.pointQuotientMap (P.markedGenerator hVA z hz)} : Set P.PointQuotient)).comap
      P.pointQuotientMap = (F.H ⊓ P.globalCentralizer).subgroupOf P.globalCentralizer := by
  have hH : F.H = centralizer ({z} : Set G) := F.H_eq_centralizer (by decide) z hz
  ext x
  change P.pointQuotientMap x ∈ centralizer ({P.pointQuotientMap (P.markedGenerator hVA z hz)} :
    Set P.PointQuotient) ↔ (x : G) ∈ F.H ⊓ P.globalCentralizer
  rw [mem_centralizer_singleton_iff]
  constructor
  · intro hc
    have he : P.pointQuotientMap (x * P.markedGenerator hVA z hz * x⁻¹) =
        P.pointQuotientMap (P.markedGenerator hVA z hz) := by
      rw [map_mul, map_mul, map_inv, hc, mul_inv_cancel_right]
    have hk : (x * P.markedGenerator hVA z hz * x⁻¹) /
        P.markedGenerator hVA z hz ∈ P.pointKernel := QuotientGroup.eq_iff_div_mem.mp he
    have hfix : (x : G) * z * (x : G)⁻¹ = z := by
      rcases P.pointKernel_cases hk with h | h
      · exact congrArg Subtype.val (div_eq_one.mp h)
      · have hh : (x : G) * z * (x : G)⁻¹ = P.element * z :=
          congrArg Subtype.val (div_eq_iff_eq_mul.mp h)
        have hzd : P.element * z = z * P.element :=
          (mem_centralizer_singleton_iff.mp (P.generator_mem hVA z hz).2).symm
        have hconj : IsConj z (z * P.element) := isConj_iff.mpr ⟨x, hh.trans hzd⟩
        exact (hnf (hconj.trans hgeom.product_fusion.symm)).elim
    exact ⟨hH.symm ▸ mem_centralizer_singleton_iff.mpr
      (mul_inv_eq_iff_eq_mul.mp hfix), x.property⟩
  · intro hx
    have hc : x * P.markedGenerator hVA z hz = P.markedGenerator hVA z hz * x :=
      Subtype.ext (mem_centralizer_singleton_iff.mp (hH ▸ hx.1))
    exact (map_mul P.pointQuotientMap _ _).symm.trans
      ((congrArg P.pointQuotientMap hc).trans (map_mul P.pointQuotientMap _ _))

end MarkedPoint
end CFSG.Quasithin.Chapter14.Section03.NonabelianSource.SourceAbelianReduction.SelfCentralizing

namespace CFSG.Quasithin.Chapter14.Section03.NonabelianSource.SourceAbelianReduction.SelfCentralizing
open Subgroup Theory.GroupTheory
open Chapter12.Section08 Chapter12.Section08.InvariantFlag
open Chapter14.Section02 SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
variable {G : Type*} [Group G] [Finite G]

/-- Nonfusion identifies the full centralizer in the literal cyclic quotient. -/
theorem source_quotient_centralizer_comap
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hnot : ¬ ClassificationModels.IsTheoremEModel G)
    (F : InvariantFlag T (rankTwoSeed T M) 2)
    [IsElementaryAbelian 2 (rankTwoSeed T M)]
    (hne : ¬ IsMulCommutative F.U)
    (g : G) (hgP : g ∈ F.P (sourceResidual M Mc)) (hgH : g ∉ F.H)
    (hs : Group.IsSolvable F.TerminalHdot)
    (A : Subgroup G) (hA : ElementaryFactor F (sourceResidual M Mc) A)
    (P : MarkedPoint F (sourceResidual M Mc) A) (z : G) (hz : F.Vi 1 = zpowers z)
    (hgeom : P.FourCenterGeometry z) :
    (centralizer ({P.pointQuotientMap (P.markedGenerator hA.seed_le z hz)} :
      Set P.PointQuotient)).comap P.pointQuotientMap =
      (F.H ⊓ P.globalCentralizer).subgroupOf P.globalCentralizer := by
  have hz2 : orderOf z = 2 := by
    rw [← Nat.card_zpowers, ← hz]
    simpa using F.card 1 (by decide)
  have hz1 : z ≠ 1 := by intro he; simp [he] at hz2
  apply P.quotient_centralizer_comap hA.seed_le z hz _ hgeom
  exact Recognition.source_not_isConj_point_of_five_dvd_subgroup
    hG T hempty hM hu hmany hcard e hnot F hne g hgP hgH hs z P.element
    (hz.symm ▸ mem_zpowers z) hz1 P.blockCentralizer inf_le_right
    (by rw [P.blockCentralizer_card]; decide)

end CFSG.Quasithin.Chapter14.Section03.NonabelianSource.SourceAbelianReduction.SelfCentralizing
