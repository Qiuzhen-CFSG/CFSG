module

public import CFSG.Quasithin.Chapter14.Section04.CaseOneGeometry
public import CFSG.Quasithin.Chapter14.Section04.LargerDimension.LocalAction.SourceGeometry
public import CFSG.Quasithin.ChapterI.Section04To05.A3Recognition.LinearImage

/-!
# The actual large overgroup in 14.4.13

The source group in the last branch is the literal subgroup
`⟨LT, L₁XT, L_XT⟩`, rather than an ambient group merely known to contain the
three vertices.  `SourceGeometry.dSystem` is already a D-system on precisely
this subgroup.  This file performs the final recognition step on that actual
group and packages the result in the existential interface used by
`CaseOneGeometry.recognition_of_source_branches`.

The two inputs to A₃ recognition are deliberately explicit here: a genuine
`A3Recognition.GeometryData` and the nontrivial local core `S.Q 0`.  A
`DSystem` record alone does not provide either incidence geometry or the
I.5.7(2) core condition.  They are therefore left with the source owner,
while this module supplies the subgroup construction, its inclusion of `T`,
and the equivalence to `L₄(2)`.

Source: Aschbacher--Smith, 14.4.13 and I.5.8--I.5.10, printed pp.1012 and
422.
-/

@[expose] public section

open Subgroup

namespace CFSG.Quasithin.Chapter14.Section04.CaseOneLarge

open Chapter12.Section02
open Chapter12.Section08
open Chapter12.Section08.InvariantFlag
open Chapter13.Section08.TransvectionRecognition.Component.ModelExtension
open Chapter14.Section03.CaseOneSource
open LargerDimension
open LargerDimension.IntrinsicSource
open LargerDimension.LocalAction

universe u
variable {G : Type u} [Group G] [Finite G]
variable {T : Sylow 2 G} {L V : Subgroup G}

omit [Finite G] in
/-- Recognition of the actual group generated by the three source vertices.

The output uses the same literal `actualG0` as `SourceGeometry.dSystem`; in
particular, the subgroup containing `T` is not replaced by an isomorphic copy.
-/
theorem actual_overgroup_of_source_geometry
    (L L₁ L₂ X M : Subgroup G) (T : Sylow 2 G)
    (geometry : LargerDimension.LocalAction.SourceGeometry L L₁ L₂ X M T)
    (hQ : geometry.dSystem.Q 0 ≠ ⊥)
    (incidence : Quasithin.I5.A3Recognition.GeometryData geometry.dSystem) :
    ∃ G₀ : Subgroup G, (T : Subgroup G) ≤ G₀ ∧
      Nonempty (G₀ ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 4) (ZMod 2)) := by
  let G₀ : Subgroup G := actualG0 L (T : Subgroup G) L₁ L₂ X
  have hTG₀ : (T : Subgroup G) ≤ G₀ :=
    source_T_le_actualG0 L (T : Subgroup G) L₁ L₂ X
  have e : G₀ ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 4) (ZMod 2) := by
    exact Quasithin.I5.A3Recognition.equivPSL4_of_geometry incidence hQ
  exact ⟨G₀, hTG₀, ⟨e⟩⟩

/-- The large branch immediately contradicts the already proved source order
obstruction once the genuine A₃ geometry has been supplied.  The preceding
source lemmas (`source_closure_le_sylow` and
`source_extraspecial_order`) discharge the containment and the strict order
bound; this theorem keeps their exact hypotheses visible to the caller.
-/
theorem contradiction_of_source_geometry
    (d : Counterexample T L)
    (earlier : Earlier1332CaseOne.{u})
    (hq : ClassicalGroup.IsPSL (L ⧸ pCore 2 L) 3 2)
    (chosen : ChosenModule T L V)
    (structural : Structural1222 KnownSimple.IsKnownSimple.{u})
    (alternatives : Theorem12213 KnownSimple.IsKnownSimple.{u})
    (F : InvariantFlag T V 3) (hne : ¬ IsMulCommutative F.U)
    (hZ : F.ZU = F.Vi 1) (hlarge : 64 < Nat.card F.U)
    (L₁ L₂ X M : Subgroup G)
    (geometry : LargerDimension.LocalAction.SourceGeometry L L₁ L₂ X M T)
    (hQ : geometry.dSystem.Q 0 ≠ ⊥)
    (incidence : Quasithin.I5.A3Recognition.GeometryData geometry.dSystem) :
    False := by
  obtain ⟨G₀, hTG₀, e⟩ := actual_overgroup_of_source_geometry
    L L₁ L₂ X M T geometry hQ incidence
  obtain ⟨e⟩ := e
  exact CaseOneGeometry.source_large_overgroup_exclusion d earlier hq chosen
    structural alternatives F hne hZ (by omega) G₀ hTG₀ e

end CFSG.Quasithin.Chapter14.Section04.CaseOneLarge
