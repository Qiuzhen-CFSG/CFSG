module

public import Theory.SpecificGroups.PSL3Two.InvolutionConjugacy
public import Theory.GroupTheory.QuaternionProductOrderFourCentralizer
public import Theory.GroupTheory.ElementarySixteenExtensionGeometry

/-!
# Involution geometry of the binary nonsplit block

An embedded quaternion central product U has order 32 and is generated by
involutions. An order-eight normal subgroup V contained in U therefore misses
an involution of U. The single involution class in the actual quotient
L/V ≃ PSL₃(2) gives involution lifts and conjugates every involution of L into
U. Its quaternion factor then supplies a commuting element of order four.

The normal-supplement application retains the quotient maps from L/(A ∩ L)
and M/A. It discharges the lifting and order-four premises of the elementary
extension argument for Aschbacher–Smith 14.4.5, printed p.1008 of
`refs/quasithin.pdf`. The embedded U and V are supplied by 14.4.2 and
14.4.4(4–5); the separate rank and B.4.8 fixed-space inputs remain with the
source-theorem assembly. This module does not assert all of 14.4.5.
-/

open Subgroup

namespace CFSG.Quasithin.Chapter14.Section04.DimensionFour.NonsplitGeometry

/-- The actual binary quotient and embedded quaternion product give lifts
of order exactly two, actual conjugators into U, and commuting order-four
witnesses in L. No lifting or conjugacy premise is assumed. -/
public theorem binary_block_involution_geometry
    {L : Type*} [Group L] [Finite L]
    (V U : Subgroup L) [V.Normal] (d : QuaternionCentralProductData U)
    (hVU : V ≤ U) (hV : Nat.card V = 8)
    (e : (L ⧸ V) ≃* Matrix.PSL3Two.PSL) :
    (∀ q : L ⧸ V, orderOf q = 2 →
      ∃ y : L, orderOf y = 2 ∧ QuotientGroup.mk' V y = q) ∧
    (∀ y : L, orderOf y = 2 → ∃ g : L, MulAut.conj g y ∈ U) ∧
    (∀ y : L, orderOf y = 2 → ∃ r : L, Commute y r ∧ orderOf r = 4) := by
  have hproper : ¬ U ≤ V := by
    intro h
    have hc := card_le_of_le h
    rw [d.card, hV] at hc
    omega
  have hclass (a b : L ⧸ V) (ha : orderOf a = 2) (hb : orderOf b = 2) :
      IsConj a b := by
    have h := Matrix.PSL3Two.isConj_of_orderOf_eq_two (e a) (e b)
      ((e.orderOf_eq a).trans ha) ((e.orderOf_eq b).trans hb)
    have h' : IsConj (e.symm (e a)) (e.symm (e b)) := e.symm.toMonoidHom.map_isConj h
    simpa only [MulEquiv.symm_apply_apply] using h'
  obtain ⟨hlift, hconj⟩ := quaternion_involution_lifts_and_cover_of_single_quotient_class
    V U d hVU hproper hclass
  refine ⟨?_, hconj, ?_⟩
  · intro q hq
    obtain ⟨y, hy2, hyq⟩ := hlift q hq
    refine ⟨y, orderOf_eq_prime hy2 ?_, hyq⟩
    intro hy1
    have hq1 : q = 1 := by simpa only [hy1, map_one] using hyq.symm
    simp [hq1] at hq
  · intro y hy
    obtain ⟨g, hg⟩ := hconj y hy
    exact exists_commuting_order_four_of_conj_mem_quaternion U d y g hg

/-- The concrete binary model discharges the quotient-class premise of the
local elementary-extension argument, with the literal ambient quotient map.
Here the ambient G may itself be the source's local overgroup M. -/
public theorem involution_geometry_of_binary_quotient
    {G : Type*} [Group G] [Finite G]
    (L A : Subgroup G) [A.Normal] (U : Subgroup L)
    (d : QuaternionCentralProductData U)
    (hcover : L ⊔ A = ⊤) (hVU : A.subgroupOf L ≤ U)
    (hV : Nat.card (A.subgroupOf L) = 8)
    (e : (L ⧸ A.subgroupOf L) ≃* Matrix.PSL3Two.PSL) :
    (∀ q : G ⧸ A, orderOf q = 2 →
      ∃ y ∈ L, y ^ 2 = 1 ∧ QuotientGroup.mk' A y = q) ∧
    (∀ y : L, orderOf y = 2 → ∃ r : L, Commute y r ∧ orderOf r = 4) := by
  obtain ⟨hlift, _, hfour⟩ :=
    binary_block_involution_geometry (A.subgroupOf L) U d hVU hV e
  refine ⟨involution_lifts_of_normal_supplement L A hcover ?_, hfour⟩
  intro q hq
  obtain ⟨y, hy, hyq⟩ := hlift q hq
  exact ⟨y, by simpa only [hy] using pow_orderOf_eq_one y, hyq⟩

end CFSG.Quasithin.Chapter14.Section04.DimensionFour.NonsplitGeometry
