module

public import Theory.GroupAction.NormalizerQuotientPointStabilizer
public import Theory.SpecificGroups.BinaryFour.SplitBlockPair

/-!
# Compatible coordinates for the two local action images

The same isomorphism A ≃ E₁₆ marks both actions. The maps factor through
the literal N_G(A)/C_G(A), and the acting groups remain actual subgroups
of G. In the source application P = L₂T_L and R = K ∩ N_G(A).

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, proof of
14.4.4, printed p.1007. This publishes the coordinate interface for the
split-model calculation. Its existence is not asserted here.
-/

open Subgroup

namespace CFSG.Quasithin.Chapter14.Section04.DimensionFour.SplitImage

variable {G : Type*} [Group G]

/-- The faithful conjugation action in the selected coordinates on A. -/
@[expose] public def coordinateAction (A : Subgroup G) (e : A ≃* BinaryFourSplitPair.E) :
    NormalizerAction.Star A →* MulAut BinaryFourSplitPair.E :=
  (MulAut.congr e).toMonoidHom.comp (NormalizerAction.action A)

public theorem coordinateAction_injective (A : Subgroup G) (e : A ≃* BinaryFourSplitPair.E) :
    Function.Injective (coordinateAction A e) :=
  (MulAut.congr e).injective.comp (NormalizerAction.action_injective A)

public theorem coordinateAction_apply (A : Subgroup G) (e : A ≃* BinaryFourSplitPair.E)
    (x : NormalizerAction.Star A) (a : A) :
    coordinateAction A e x (e a) = e (NormalizerAction.action A x a) := by
  change e (NormalizerAction.action A x (e.symm (e a))) = _
  rw [e.symm_apply_apply]

/-- The actor's image in the literal quotient, before choosing coordinates. -/
@[expose] public def quotientImage (A P : Subgroup G) : Subgroup (NormalizerAction.Star A) :=
  (P.subgroupOf (normalizer (A : Set G))).map (NormalizerAction.quotient A)

/-- The subgroup generated by the two actual quotient images. -/
@[expose] public def generatedImage (A P R : Subgroup G) :
    Subgroup (NormalizerAction.Star A) := quotientImage A P ⊔ quotientImage A R

/-- The actual image of an ambient actor, restricted to the normalizer. -/
@[expose] public def actorImage (A P : Subgroup G) (e : A ≃* BinaryFourSplitPair.E) :
    Subgroup (MulAut BinaryFourSplitPair.E) :=
  (P.subgroupOf (normalizer (A : Set G))).map
    ((coordinateAction A e).comp (NormalizerAction.quotient A))

public theorem actorImage_le_range (A P : Subgroup G) (e : A ≃* BinaryFourSplitPair.E) :
    actorImage A P e ≤ (coordinateAction A e).range := by
  rintro _ ⟨n, _, rfl⟩
  exact ⟨NormalizerAction.quotient A n, rfl⟩

public theorem actorImage_eq_map (A P : Subgroup G) (e : A ≃* BinaryFourSplitPair.E) :
    actorImage A P e = (quotientImage A P).map (coordinateAction A e) := by
  rw [quotientImage, Subgroup.map_map]
  rfl

/-- A common marking, not just the two abstract isomorphism types.
The split-model producer must construct every field from its genuine local
hypotheses; neither an A₇ image nor a stabilizer conclusion is a field. -/
public structure MarkedLocalActions (A P R : Subgroup G) (z : A) where
  coordinates : A ≃* BinaryFourSplitPair.E
  point_eq : coordinates z = BinaryFourSplitPair.point
  parabolic_normalizes : P ≤ normalizer (A : Set G)
  quaternion_normalizes : R ≤ normalizer (A : Set G)
  parabolic_image : actorImage A P coordinates = BinaryFourSplitPair.parabolic
  quaternion_image : actorImage A R coordinates = BinaryFourSplitPair.quaternion

/-- The common marking identifies the generated subgroup itself. -/
public theorem MarkedLocalActions.generatedImage_map
    {A P R : Subgroup G} {z : A} (d : MarkedLocalActions A P R z) :
    (generatedImage A P R).map (coordinateAction A d.coordinates) =
      BinaryFourSplitPair.joined := by
  rw [generatedImage, Subgroup.map_sup, ← actorImage_eq_map, ← actorImage_eq_map,
    d.parabolic_image, d.quaternion_image]
  rfl

/-- A genuine equivalence from the actual generated quotient subgroup to
the concrete model, induced by conjugation in the chosen coordinates. -/
public noncomputable def MarkedLocalActions.generatedEquiv
    {A P R : Subgroup G} {z : A} (d : MarkedLocalActions A P R z) :
    generatedImage A P R ≃* BinaryFourSplitPair.joined :=
  ((generatedImage A P R).equivMapOfInjective (coordinateAction A d.coordinates)
    (coordinateAction_injective A d.coordinates)).trans
      (MulEquiv.subgroupCongr d.generatedImage_map)

/-- The generated concrete pair lies in the actual faithful action image. -/
public theorem MarkedLocalActions.joined_le_range
    {A P R : Subgroup G} {z : A} (d : MarkedLocalActions A P R z) :
    BinaryFourSplitPair.joined ≤ (coordinateAction A d.coordinates).range := by
  apply sup_le
  · rw [← d.parabolic_image]
    exact actorImage_le_range A P d.coordinates
  · rw [← d.quaternion_image]
    exact actorImage_le_range A R d.coordinates

/-- Lift the generated coordinate group through the injective quotient action. -/
public noncomputable def MarkedLocalActions.liftJoined
    {A P R : Subgroup G} {z : A} (d : MarkedLocalActions A P R z) :
    BinaryFourSplitPair.joined →* NormalizerAction.Star A :=
  (MonoidHom.ofInjective (coordinateAction_injective A d.coordinates)).symm.toMonoidHom.comp
    (Subgroup.inclusion d.joined_le_range)

public theorem MarkedLocalActions.liftJoined_injective
    {A P R : Subgroup G} {z : A} (d : MarkedLocalActions A P R z) :
    Function.Injective d.liftJoined :=
  (MonoidHom.ofInjective (coordinateAction_injective A d.coordinates)).symm.injective.comp
    (Subgroup.inclusion_injective d.joined_le_range)

public theorem MarkedLocalActions.coordinateAction_liftJoined
    {A P R : Subgroup G} {z : A} (d : MarkedLocalActions A P R z)
    (x : BinaryFourSplitPair.joined) :
    coordinateAction A d.coordinates (d.liftJoined x) = (x : MulAut BinaryFourSplitPair.E) := by
  exact congrArg Subtype.val
    ((MonoidHom.ofInjective (coordinateAction_injective A d.coordinates)).apply_symm_apply
      (Subgroup.inclusion d.joined_le_range x))

/-- Fixation of the model's marked point is exactly fixation of the source z. -/
public theorem MarkedLocalActions.liftJoined_mem_pointStabilizer_iff
    {A P R : Subgroup G} {z : A} (d : MarkedLocalActions A P R z)
    (x : BinaryFourSplitPair.joined) :
    d.liftJoined x ∈ NormalizerAction.pointStabilizer A z ↔
      (x : MulAut BinaryFourSplitPair.E) BinaryFourSplitPair.point = BinaryFourSplitPair.point := by
  rw [NormalizerAction.mem_pointStabilizer]
  constructor
  · intro h
    rw [← d.point_eq, ← d.coordinateAction_liftJoined x, coordinateAction_apply, h]
  · intro h
    apply d.coordinates.injective
    rw [← coordinateAction_apply, d.coordinateAction_liftJoined, d.point_eq]
    exact h

end CFSG.Quasithin.Chapter14.Section04.DimensionFour.SplitImage
