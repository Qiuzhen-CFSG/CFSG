module

public import Theory.GroupTheory.CommutatorPreimage

/-!
# The literal subgroups in the last paragraph of 14.4.7

Right conjugation defines D = C_{H^g}(U^g) and I = ⟨U^x : x ∈ L⟩.
The symmetric bounds [D,U^x] ≤ V₁^x ≤ V extend to I by the commutator
preimage subgroup. G.2.5(2)'s I = LU puts L and the displayed candidate
U^g C_U(V₂) C_{U^l}(V) in I. The candidate is defined as a join here;
its product factorization and Sylow property are not assumed by its definition.

These are conditional deductions from the genuine earlier-source identities,
not a replacement hypothesis record for 14.3.10. The two symmetric centralizer
bounds are the preceding paragraph's inputs, retained for its assembly owner.

Source: Aschbacher--Smith, combined manuscript of 1 March 2004,
12.8.8(4), G.2.5(2), and 14.4.7, printed pp.851--852,335,1009.
-/

@[expose] public section
open Subgroup
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter14.Section04.LargerDimension.RankCore.GaschutzComplement
variable {G : Type*} [Group G]

/-- Source exponent convention: U^g = g⁻¹ U g. -/
def rightConjugate (U : Subgroup G) (g : G) : Subgroup G :=
  U.map (MulAut.conj g⁻¹).toMonoidHom

/-- The actual relative centralizer D = C_{H^g}(U^g). -/
def conjugateCentralizer (H U : Subgroup G) (g : G) : Subgroup G :=
  rightConjugate H g ⊓ centralizer (rightConjugate U g : Set G)

/-- The subgroup I generated by all right L-conjugates of U. -/
def conjugateSpan (U L : Subgroup G) : Subgroup G :=
  ⨆ x : L, rightConjugate U x

/-- The join of the three displayed source factors. Its identification with
their set product and its Sylow property are separate obligations. -/
def candidateSylow (U V V₂ : Subgroup G) (g l : G) : Subgroup G :=
  rightConjugate U g ⊔ (U ⊓ centralizer (V₂ : Set G)) ⊔
    (rightConjugate U l ⊓ centralizer (V : Set G))

theorem conjugate_le_span (U L : Subgroup G) {x : G} (hx : x ∈ L) :
    rightConjugate U x ≤ conjugateSpan U L :=
  le_iSup (fun y : L => rightConjugate U y) ⟨x, hx⟩

theorem le_conjugateSpan (U L : Subgroup G) : U ≤ conjugateSpan U L := by
  have h := conjugate_le_span U L L.one_mem
  intro u hu
  apply h
  exact ⟨u, hu, by simp⟩

/-- The earlier G.2.5(2) generation identity puts both L and the displayed
three-factor candidate in I. -/
theorem actor_le_span (U V V₂ L : Subgroup G) {g l : G} (hg : g ∈ L) (hl : l ∈ L)
    (hgen : conjugateSpan U L = L ⊔ U) :
    L ⊔ candidateSylow U V V₂ g l ≤ conjugateSpan U L := by
  refine sup_le (hgen.symm ▸ le_sup_left) (sup_le (sup_le ?_ ?_) ?_)
  · exact conjugate_le_span U L hg
  · exact inf_le_left.trans (le_conjugateSpan U L)
  · exact inf_le_left.trans (conjugate_le_span U L hl)

/-- The symmetric commutator bounds extend from the generators to all of I. -/
theorem span_commutator_le (U V V₁ L D : Subgroup G)
    (hIV : conjugateSpan U L ≤ normalizer (V : Set G))
    (hbound : ∀ x ∈ L, ⁅D, rightConjugate U x⁆ ≤ rightConjugate V₁ x)
    (hline : ∀ x ∈ L, rightConjugate V₁ x ≤ V) :
    ⁅conjugateSpan U L, D⁆ ≤ V := by
  have hi : conjugateSpan U L ≤ commutatorPreimage (conjugateSpan U L) D V := by
    apply iSup_le
    intro x
    apply le_commutatorPreimage (conjugate_le_span U L x.property)
    rw [commutator_comm]
    exact (hbound x x.property).trans (hline x x.property)
  exact (commutator_mono hi le_rfl).trans
    (commutator_commutatorPreimage_le _ D V hIV)

/-- The two preceding symmetric centralizer conclusions make every factor
of the displayed candidate centralize the actual D. -/
theorem candidate_centralizes (H U V V₂ : Subgroup G) (g l : G)
    (hW : U ⊓ centralizer (V₂ : Set G) ≤
      centralizer (conjugateCentralizer H U g : Set G))
    (hl : rightConjugate U l ⊓ centralizer (V : Set G) ≤
      centralizer (conjugateCentralizer H U g : Set G)) :
    candidateSylow U V V₂ g l ≤ centralizer (conjugateCentralizer H U g : Set G) := by
  exact sup_le (sup_le (le_centralizer_iff.mp inf_le_right) hW) hl

/-- Adding an actor which fixes D leaves its relative centralizer unchanged. -/
theorem centralizer_actor_eq (L S D : Subgroup G)
    (hDS : S ≤ centralizer (D : Set G)) :
    D ⊓ centralizer ((L ⊔ S : Subgroup G) : Set G) = D ⊓ centralizer (L : Set G) := by
  apply le_antisymm (inf_le_inf_left _ (centralizer_le (show L ≤ L ⊔ S from le_sup_left)))
  refine le_inf inf_le_left ?_
  apply le_centralizer_iff.mp
  exact sup_le (le_centralizer_iff.mp inf_le_right)
    (hDS.trans (centralizer_le inf_le_left))

/-- The extraspecial center identifies the literal intersection D ∩ V. -/
theorem centralizer_intersection (H U V Z : Subgroup G) (g : G)
    (hVU : V ≤ rightConjugate U g) (hUH : rightConjugate U g ≤ rightConjugate H g)
    (hcenter : rightConjugate U g ⊓ centralizer (rightConjugate U g : Set G) = Z)
    (hZV : Z ≤ V) : conjugateCentralizer H U g ⊓ V = Z := by
  apply le_antisymm ?_ ?_
  · intro x hx
    exact hcenter ▸ (show x ∈ rightConjugate U g ⊓ centralizer (rightConjugate U g : Set G)
      from ⟨hVU hx.2, hx.1.2⟩)
  · intro x hx
    have hz : x ∈ rightConjugate U g ⊓ centralizer (rightConjugate U g : Set G) :=
      hcenter.symm ▸ hx
    exact ⟨⟨hUH hz.1, hz.2⟩, hZV hx⟩

end CFSG.Quasithin.Chapter14.Section04.LargerDimension.RankCore.GaschutzComplement
