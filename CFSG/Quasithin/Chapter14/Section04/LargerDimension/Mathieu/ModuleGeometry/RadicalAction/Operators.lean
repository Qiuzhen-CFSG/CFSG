module

public import CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ModuleGeometry.RadicalAction.Coordinates

/-!
# Native radical operators on the literal parabolic six-space

Small checked matrix identities identify an involution with Frobenius in
the adapted frame, and a component candidate with a field transvection.
The full second-actor image is generated by a cubic rotation and a
nontrivial involutory shear. Frobenius commutes with both.

The native involution therefore has equal fixed and moved spaces of binary
dimension three. Once its precise matrix is placed in the literal point
two-core, the full second image moves the marked binary line into the
radical moved span. No commutation is asserted on extraspecial lifts.

Source: Aschbacher–Smith 14.4.12, printed p.1012. Group placement in the
point radical and identification of the source residual with `secondImage`
remain explicit inputs for the actor-catalogue and source assembly owners.
-/

@[expose] public section

open Matrix Representation.SL2FourNatural
open Sporadic.Mathieu M22TripleCover M22TripleCover.Unitary
open Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreLinearModel
open Representation.BinaryOffender
open scoped Matrix

namespace CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ModuleGeometry.Native.RadicalAction

def frobeniusMatrix : MatSix := binaryRows ![9,18,36,8,16,32]
def scalarMatrix : MatSix := binaryRows ![8,16,32,9,18,36]
def rotationMatrix : MatSix := binaryRows ![2,3,4,16,24,32]
def rotationInverse : MatSix := binaryRows ![3,1,4,24,8,32]
def shearMatrix : MatSix := binaryRows ![5,2,4,40,16,32]
def transvectionMatrix : MatSix := binaryRows ![3,2,4,24,16,32]

def inverterMatrix : Matrix12 := fromRows
  ![1064,292,976,1015,472,1744,2312,3637,1282,995,1318,1717]
def nativeTransvectionMatrix : Matrix12 := fromRows
  ![1898,1438,146,158,3944,577,64,2802,3097,1802,3091,1423]

theorem inverter_square : inverterMatrix * inverterMatrix = 1 := by decide +kernel
theorem nativeTransvection_square : nativeTransvectionMatrix * nativeTransvectionMatrix = 1 := by
  decide +kernel

def inverterUnit : Matrix12ˣ := ⟨inverterMatrix, inverterMatrix, inverter_square, inverter_square⟩
def nativeTransvectionUnit : Matrix12ˣ :=
  ⟨nativeTransvectionMatrix, nativeTransvectionMatrix, nativeTransvection_square, nativeTransvection_square⟩

theorem inverter_frame : inverterMatrix * frame = frame * frobeniusMatrix := by decide +kernel
theorem transvection_frame : nativeTransvectionMatrix * frame = frame * transvectionMatrix := by
  decide +kernel
theorem scalar_frame : (1 + matrixJ) * frame = frame * scalarMatrix := by decide +kernel

def rotation : MatSixˣ :=
  ⟨rotationMatrix, rotationInverse, by decide +kernel, by decide +kernel⟩
def shear : MatSixˣ :=
  ⟨shearMatrix, shearMatrix, by decide +kernel, by decide +kernel⟩
def frobenius : MatSixˣ :=
  ⟨frobeniusMatrix, frobeniusMatrix, by decide +kernel, by decide +kernel⟩

/-- The full proposed restricted second-actor image, retaining its shears. -/
def secondMatrixGroup : Subgroup MatSixˣ := Subgroup.closure {rotation, shear}

theorem shear_ne_one : shear ≠ 1 := by
  intro h
  have hh := congrArg (fun g : MatSixˣ => (g : MatSix) 0 2) h
  exact (by decide : (1 : ZMod 2) ≠ 0) hh

theorem shear_square : shear * shear = 1 := by
  apply Units.ext
  exact shear.val_inv

theorem rotation_cube : rotation ^ 3 = 1 := by
  apply Units.ext
  change rotationMatrix ^ 3 = 1
  have hh : rotationMatrix * rotationMatrix = rotationInverse := by decide +kernel
  rw [pow_succ, pow_two, hh]
  exact rotation.inv_val

theorem second_centralizes_frobenius :
    secondMatrixGroup ≤ Subgroup.centralizer {frobenius} := by
  apply (Subgroup.closure_le _).mpr
  intro g hg
  rcases Set.mem_insert_iff.mp hg with rfl | hg
  · apply Subgroup.mem_centralizer_iff.mpr
    intro x hx
    rw [Set.mem_singleton_iff.mp hx]
    apply Units.ext
    change frobeniusMatrix * rotationMatrix = rotationMatrix * frobeniusMatrix
    decide +kernel
  · rw [Set.mem_singleton_iff.mp hg]
    apply Subgroup.mem_centralizer_iff.mpr
    intro x hx
    rw [Set.mem_singleton_iff.mp hx]
    apply Units.ext
    change frobeniusMatrix * shearMatrix = shearMatrix * frobeniusMatrix
    decide +kernel

noncomputable section

def modelAction : MatSix ≃ₐ[ZMod 2] Module.End (ZMod 2) parabolicSpace :=
  Matrix.toLinAlgEquiv'.trans (frameEquiv.conjAlgEquiv (ZMod 2))

def modelUnits : MatSixˣ →* (Module.End (ZMod 2) parabolicSpace)ˣ :=
  Units.map modelAction.toMonoidHom

def secondImage : Subgroup (Module.End (ZMod 2) parabolicSpace)ˣ :=
  secondMatrixGroup.map modelUnits

theorem modelAction_frameEquiv (M : MatSix) (v : Six) :
    modelAction M (frameEquiv v) = frameEquiv (M *ᵥ v) := by
  change frameEquiv (M *ᵥ frameEquiv.symm (frameEquiv v)) = _
  rw [frameEquiv.symm_apply_apply]

theorem restricted_action (g : parabolic) (M : MatSix)
    (h : ((g.val : Matrix12ˣ) : Matrix12) * frame = frame * M) :
    parabolicRepresentation g = modelAction M := by
  apply LinearMap.ext
  intro w
  obtain ⟨v, rfl⟩ := frameEquiv.surjective w
  rw [modelAction_frameEquiv]
  apply Subtype.ext
  change ((g.val : Matrix12ˣ) : Matrix12) *ᵥ (frame *ᵥ v) = frame *ᵥ (M *ᵥ v)
  simp only [mulVec_mulVec, h]

theorem stabilizes_of_square (g : Group) (M : MatSix) (hs : g * g = 1)
    (h : ((g : Matrix12ˣ) : Matrix12) * frame = frame * M) : g ∈ parabolic := by
  have hf : ∀ v ∈ parabolicSpace, representation g v ∈ parabolicSpace := by
    intro v hv
    rw [← embedding_range] at hv
    obtain ⟨u, rfl⟩ := hv
    have he : representation g (embedding u) = embedding (M *ᵥ u) := by
      change ((g : Matrix12ˣ) : Matrix12) *ᵥ (frame *ᵥ u) = frame *ᵥ (M *ᵥ u)
      simp only [mulVec_mulVec, h]
    rw [he]
    exact embedding_mem_parabolic _
  intro v
  refine ⟨fun hv => ?_, hf v⟩
  have hh := hf _ hv
  simpa only [← Module.End.mul_apply, ← map_mul, hs, map_one, Module.End.one_apply] using hh

def inverter (h : inverterUnit ∈ actionGroup) : Group := ⟨inverterUnit, h⟩
def nativeTransvection (h : nativeTransvectionUnit ∈ actionGroup) : Group :=
  ⟨nativeTransvectionUnit, h⟩

theorem inverter_mem_parabolic (h : inverterUnit ∈ actionGroup) : inverter h ∈ parabolic := by
  apply stabilizes_of_square (inverter h) frobeniusMatrix
  · apply Subtype.ext
    apply Units.ext
    exact inverter_square
  · exact inverter_frame

theorem nativeTransvection_mem_parabolic (h : nativeTransvectionUnit ∈ actionGroup) :
    nativeTransvection h ∈ parabolic := by
  apply stabilizes_of_square (nativeTransvection h) transvectionMatrix
  · apply Subtype.ext
    apply Units.ext
    exact nativeTransvection_square
  · exact transvection_frame

def parabolicInverter (h : inverterUnit ∈ actionGroup) : parabolic :=
  ⟨inverter h, inverter_mem_parabolic h⟩

def parabolicTransvection (h : nativeTransvectionUnit ∈ actionGroup) : parabolic :=
  ⟨nativeTransvection h, nativeTransvection_mem_parabolic h⟩

theorem inverter_action (h : inverterUnit ∈ actionGroup) :
    parabolicRepresentation (parabolicInverter h) = modelAction frobeniusMatrix :=
  restricted_action _ _ inverter_frame

theorem transvection_action (h : nativeTransvectionUnit ∈ actionGroup) :
    parabolicRepresentation (parabolicTransvection h) = modelAction transvectionMatrix :=
  restricted_action _ _ transvection_frame

theorem scalar_action : parabolicRepresentation parabolicScalar = modelAction scalarMatrix := by
  apply restricted_action
  change (scalarUnit : Matrix12) * frame = _
  rw [coe_scalarUnit]
  exact scalar_frame

theorem inverter_relations (h : inverterUnit ∈ actionGroup) :
    parabolicRepresentation (parabolicInverter h) *
        parabolicRepresentation (parabolicInverter h) = 1 ∧
    parabolicRepresentation (parabolicInverter h) * parabolicRepresentation parabolicScalar =
        parabolicRepresentation parabolicScalar ^ 2 *
          parabolicRepresentation (parabolicInverter h) := by
  rw [inverter_action, scalar_action]
  constructor
  · rw [← map_mul, show frobeniusMatrix * frobeniusMatrix = 1 by decide +kernel, map_one]
  · rw [← map_pow, ← map_mul, ← map_mul]
    congr 1
    decide +kernel

theorem inverter_fixed_moved (h : inverterUnit ∈ actionGroup) :
    LinearMap.range (parabolicRepresentation (parabolicInverter h) - 1) =
        LinearMap.ker (parabolicRepresentation (parabolicInverter h) - 1) ∧
      Module.finrank (ZMod 2)
        (LinearMap.range (parabolicRepresentation (parabolicInverter h) - 1)) = 3 :=
  parabolic_inverter_fixed_moved _ (inverter_relations h).1 (inverter_relations h).2


def markedInParabolic : parabolicSpace := ⟨markedVector, markedVector_mem_parabolic⟩

def markedLine : Submodule (ZMod 2) parabolicSpace :=
  Submodule.span (ZMod 2) {markedInParabolic}

theorem frameEquiv_marked : frameEquiv (Pi.single 0 1) = markedInParabolic :=
  Subtype.ext frame_marked

theorem inverter_fixes_markedLine (h : inverterUnit ∈ actionGroup) :
    ∀ v ∈ markedLine, parabolicRepresentation (parabolicInverter h) v = v := by
  intro v hv
  obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp hv
  rw [map_smul]
  congr 1
  rw [inverter_action, ← frameEquiv_marked, modelAction_frameEquiv]
  congr 1
  decide +kernel

theorem inverter_commutes_secondImage (h : inverterUnit ∈ actionGroup)
    (a : (Module.End (ZMod 2) parabolicSpace)ˣ) (ha : a ∈ secondImage) :
    Commute (parabolicRepresentation (parabolicInverter h)) (a : Module.End _ _) := by
  obtain ⟨g, hg, rfl⟩ := ha
  rw [inverter_action]
  change modelAction frobeniusMatrix * modelAction (g : MatSix) =
    modelAction (g : MatSix) * modelAction frobeniusMatrix
  rw [← map_mul, ← map_mul]
  congr 1
  exact congrArg (fun u : MatSixˣ => (u : MatSix))
    (Subgroup.mem_centralizer_iff.mp (second_centralizes_frobenius hg) _ rfl)

/-- Placement in the literal two-core is separate from the operator calculation. -/
theorem exists_radical_inverter
    (hW : inverterUnit ∈ pointRadical.map actionGroup.subtype) :
    ∃ x : parabolic, (x : Group) ∈ pointRadical ∧
      parabolicRepresentation x * parabolicRepresentation x = 1 ∧
      parabolicRepresentation x * parabolicRepresentation parabolicScalar =
        parabolicRepresentation parabolicScalar ^ 2 * parabolicRepresentation x ∧
      (∀ v ∈ markedLine, parabolicRepresentation x v = v) ∧
      (∀ a ∈ secondImage, Commute (parabolicRepresentation x) (a : Module.End _ _)) ∧
      LinearMap.range (parabolicRepresentation x - 1) =
        LinearMap.ker (parabolicRepresentation x - 1) ∧
      Module.finrank (ZMod 2) (LinearMap.range (parabolicRepresentation x - 1)) = 3 := by
  obtain ⟨g, hg, he⟩ := hW
  have hG : inverterUnit ∈ actionGroup := he ▸ g.property
  have hg' : inverter hG = g := Subtype.ext he.symm
  refine ⟨parabolicInverter hG, ?_, (inverter_relations hG).1,
    (inverter_relations hG).2, inverter_fixes_markedLine hG,
    inverter_commutes_secondImage hG, (inverter_fixed_moved hG).1,
    (inverter_fixed_moved hG).2⟩
  change inverter hG ∈ pointRadical
  rwa [hg']

/-- The full second image, including its two-part, moves the marked line into
    the moved span of the literal radical on the six-space. -/
theorem second_moved_le_radical
    (A : Subgroup parabolic)
    (hA : A.map parabolicRepresentation.asGroupHom = secondImage)
    (hW : inverterUnit ∈ pointRadical.map actionGroup.subtype) :
    subspaceCommutator parabolicRepresentation markedLine A ≤
      subspaceCommutator parabolicRepresentation ⊤ (pointRadical.subgroupOf parabolic) := by
  obtain ⟨x, hxW, hx, hxc, hP, hC, _, _⟩ := exists_radical_inverter hW
  apply subspaceCommutator_le_of_cubic_inversion parabolicRepresentation markedLine A
    (pointRadical.subgroupOf parabolic) parabolicScalar x
  · rw [← map_pow, parabolicScalar_cube, map_one]
  · exact fun v => (parabolicScalar_fixed_iff v).mp
  · exact hx
  · exact hxc
  · exact hP
  · intro a ha
    apply hC (parabolicRepresentation.asGroupHom a)
    rw [← hA]
    exact ⟨a, ha, rfl⟩
  · exact hxW

end
end CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ModuleGeometry.Native.RadicalAction
