module

public import CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ModuleGeometry.RadicalAction.Operators
public import CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ModuleGeometry.RadicalAction.FieldFrame

/-!
# The literal second-actor image on the marked F₄-line

The full six-space matrix group is generated by a rotation and a shear.
The shear acts trivially on the first two F₄ coordinates; all restrictions
are powers of the cubic rotation. The exact induced image on the actual
projective line is consequently cyclic of order three and has no nonzero
fixed vector. The full image still contains its nontrivial two-part.

The source residual is used only through equality of its complete
restricted action image with the explicit matrix subgroup.
Source: Aschbacher–Smith 14.4.12, printed p.1012.
-/

@[expose] public section

open Matrix Representation.SL2FourNatural
open Sporadic.Mathieu M22TripleCover M22TripleCover.Unitary
open M22TripleCover.Uniqueness.PointRestriction (fieldModule fieldTower)
open Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreLinearModel
open Representation.BinaryOffender
open scoped Matrix
namespace CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ModuleGeometry.Native.RadicalAction

noncomputable section
local instance lineActionFieldModule : Module F BinarySpace :=
  fieldModule binaryRepresentation binaryRepresentation_faithful
local instance lineActionFieldTower : IsScalarTower (ZMod 2) F BinarySpace :=
  fieldTower binaryRepresentation binaryRepresentation_faithful

def lineInsert : (Fin 2 → F) →ₗ[F] (Fin 3 → F) :=
  (!![1,0; 0,1; 0,0] : Matrix (Fin 3) (Fin 2) F).mulVecLin

def lineFrame : (Fin 2 → F) →ₗ[ZMod 2] parabolicSpace :=
  (fieldFrame.restrictScalars (ZMod 2)).toLinearMap.comp (lineInsert.restrictScalars (ZMod 2))

theorem lineFrame_val (u : Fin 2 → F) : (lineFrame u : BinarySpace) = fieldLineEmbedding u := rfl

theorem lineFrame_injective : Function.Injective lineFrame := by
  intro u v h
  exact fieldLineEmbedding_injective (congrArg Subtype.val h)

theorem lineFrame_range :
    lineFrame.range = (fieldLine.restrictScalars (ZMod 2)).comap parabolicSpace.subtype := by
  ext v
  constructor
  · rintro ⟨u, rfl⟩
    exact ⟨u, rfl⟩
  · rintro ⟨u, hu⟩
    exact ⟨u, Subtype.ext hu⟩

def lineRotationUnit : (Matrix (Fin 2) (Fin 2) F)ˣ :=
  ⟨!![0,1;1,1], !![1,1;1,0], by decide +kernel, by decide +kernel⟩

def lineRotation : (Fin 2 → F) ≃ₗ[F] (Fin 2 → F) :=
  (Matrix.GeneralLinearGroup.toLin lineRotationUnit).toLinearEquiv

theorem lineRotation_cube : lineRotation ^ 3 = 1 := by
  have he : ∀ u : Fin 2 → F, (lineRotation ^ 3) u = u := by decide +kernel
  exact LinearEquiv.ext he

theorem lineRotation_order : orderOf lineRotation = 3 := by
  have hn : lineRotation ≠ 1 := by
    intro h
    have he := LinearEquiv.congr_fun h ![1,0]
    have hh := congrFun he 0
    exact (by decide : (0 : F) ≠ 1) hh
  exact orderOf_eq_prime lineRotation_cube hn

def frameRepresentation : Representation (ZMod 2) MatSixˣ parabolicSpace :=
  modelAction.toMonoidHom.comp (Units.coeHom MatSix)

private theorem rotation_line (u : Fin 2 → F) :
    frameRepresentation rotation (lineFrame u) = lineFrame (lineRotation u) := by
  change modelAction rotationMatrix (fieldFrame (lineInsert u)) = fieldFrame (lineInsert (lineRotation u))
  rw [← frameEquiv_fieldSplit, modelAction_frameEquiv]
  have he : ∀ u : Fin 2 → F, rotationMatrix *ᵥ fieldSplit (lineInsert u) =
      fieldSplit (lineInsert (lineRotation u)) := by decide +kernel
  rw [he, frameEquiv_fieldSplit]

private theorem shear_line (u : Fin 2 → F) :
    frameRepresentation shear (lineFrame u) = lineFrame u := by
  change modelAction shearMatrix (fieldFrame (lineInsert u)) = fieldFrame (lineInsert u)
  rw [← frameEquiv_fieldSplit, modelAction_frameEquiv]
  have he : ∀ u : Fin 2 → F, shearMatrix *ᵥ fieldSplit (lineInsert u) =
      fieldSplit (lineInsert u) := by decide +kernel
  rw [he]

/-- Every element of the full image restricts to a cubic rotation on the
    projective line; the nontrivial shear is retained in the full six-space action. -/
theorem second_line_power (g : MatSixˣ) (hg : g ∈ secondMatrixGroup) :
    ∃ n : ℤ, ∀ u : Fin 2 → F,
      frameRepresentation g (lineFrame u) = lineFrame ((lineRotation ^ n) u) := by
  induction hg using Subgroup.closure_induction with
  | mem g hg =>
    rcases Set.mem_insert_iff.mp hg with rfl | hg
    · exact ⟨1, by simpa using rotation_line⟩
    · rw [Set.mem_singleton_iff.mp hg]
      exact ⟨0, by simpa using shear_line⟩
  | one => exact ⟨0, by intro u; simp⟩
  | mul g h hg hh ihg ihh =>
    obtain ⟨n, hn⟩ := ihg
    obtain ⟨m, hm⟩ := ihh
    refine ⟨n + m, ?_⟩
    intro u
    rw [map_mul, Module.End.mul_apply, hm, hn, zpow_add, LinearEquiv.mul_apply]
  | inv g hg ih =>
    obtain ⟨n, hn⟩ := ih
    refine ⟨-n, ?_⟩
    intro u
    have he := congrArg (frameRepresentation g⁻¹) (hn ((lineRotation ^ (-n)) u))
    have hr : (lineRotation ^ n) ((lineRotation ^ (-n)) u) = u := by
      rw [← LinearEquiv.mul_apply, ← zpow_add, add_neg_cancel, zpow_zero]
      rfl
    rw [hr] at he
    simpa only [← Module.End.mul_apply, ← map_mul, inv_mul_cancel,
      map_one, Module.End.one_apply] using he.symm

theorem source_second_line_power (A : Subgroup parabolic)
    (hA : A.map parabolicRepresentation.asGroupHom = secondImage)
    (a : parabolic) (ha : a ∈ A) :
    ∃ n : ℤ, ∀ u : Fin 2 → F,
      parabolicRepresentation a (lineFrame u) = lineFrame ((lineRotation ^ n) u) := by
  have ha' : parabolicRepresentation.asGroupHom a ∈ secondImage := by
    rw [← hA]
    exact ⟨a, ha, rfl⟩
  obtain ⟨g, hg, he⟩ := ha'
  have he' : frameRepresentation g = parabolicRepresentation a :=
    congrArg (fun t : (Module.End (ZMod 2) parabolicSpace)ˣ => t.val) he
  rw [← he']
  exact second_line_power g hg

/-- The literal induced image on the F₄-line is cyclic of order three.
    This does not identify the full second-actor image with a cyclic group. -/
theorem source_second_line_image (A : Subgroup parabolic)
    (hA : A.map parabolicRepresentation.asGroupHom = secondImage) :
    {e : (Fin 2 → F) ≃ₗ[F] (Fin 2 → F) | ∃ a ∈ A, ∀ u : Fin 2 → F,
      parabolicRepresentation a (lineFrame u) = lineFrame (e u)} =
      (Subgroup.zpowers lineRotation : Set ((Fin 2 → F) ≃ₗ[F] (Fin 2 → F))) := by
  classical
  ext e
  constructor
  · rintro ⟨a, ha, he⟩
    obtain ⟨n, hn⟩ := source_second_line_power A hA a ha
    have heq : e = lineRotation ^ n := by
      apply LinearEquiv.ext
      intro u
      apply lineFrame_injective
      exact (he u).symm.trans (hn u)
    rw [heq]
    exact Subgroup.zpow_mem _ (Subgroup.mem_zpowers _) _
  · intro he
    have hf : IsOfFinOrder lineRotation :=
      isOfFinOrder_iff_pow_eq_one.mpr ⟨3, by decide, lineRotation_cube⟩
    obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp (hf.mem_zpowers_iff_mem_range_orderOf.mp he)
    clear hn he hf
    have hr : modelUnits rotation ∈ A.map parabolicRepresentation.asGroupHom := by
      rw [hA]
      exact ⟨rotation, Subgroup.subset_closure (Or.inl rfl), rfl⟩
    obtain ⟨a, ha, he⟩ := hr
    have he' : parabolicRepresentation a = frameRepresentation rotation :=
      congrArg (fun t : (Module.End (ZMod 2) parabolicSpace)ˣ => t.val) he
    refine ⟨a ^ n, A.pow_mem ha n, ?_⟩
    intro u
    induction n generalizing u with
    | zero => simp
    | succ n ih =>
      rw [pow_succ, map_mul, Module.End.mul_apply, he', rotation_line, ih,
        pow_succ, LinearEquiv.mul_apply]


theorem source_second_stabilizes_line (A : Subgroup parabolic)
    (hA : A.map parabolicRepresentation.asGroupHom = secondImage) :
    A ≤ subspaceStabilizer parabolicRepresentation lineFrame.range := by
  apply le_subspaceStabilizer
  intro a ha v hv
  obtain ⟨u, rfl⟩ := hv
  obtain ⟨n, hn⟩ := source_second_line_power A hA a ha
  exact ⟨(lineRotation ^ n) u, (hn u).symm⟩

theorem source_second_line_fixed_zero (A : Subgroup parabolic)
    (hA : A.map parabolicRepresentation.asGroupHom = secondImage)
    (v : parabolicSpace) (hv : v ∈ lineFrame.range)
    (hf : ∀ a ∈ A, parabolicRepresentation a v = v) : v = 0 := by
  have hr : lineRotation ∈ (Subgroup.zpowers lineRotation : Set _) :=
    Subgroup.mem_zpowers lineRotation
  rw [← source_second_line_image A hA] at hr
  obtain ⟨a, ha, hr⟩ := hr
  obtain ⟨u, rfl⟩ := hv
  have he : lineRotation u = u := lineFrame_injective ((hr u).symm.trans (hf a ha))
  have hfree : ∀ u : Fin 2 → F, lineRotation u = u → u = 0 := by decide +kernel
  rw [hfree u he, map_zero]

end
end CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ModuleGeometry.Native.RadicalAction
