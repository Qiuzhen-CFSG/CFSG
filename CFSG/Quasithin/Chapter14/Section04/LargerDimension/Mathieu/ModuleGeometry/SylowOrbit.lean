module
public import CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ModuleGeometry.SylowOrbit.Certificate
public import CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ModuleGeometry.ConjugationCoordinates
public import Theory.Representation.BinaryOffender.EquivariantOffender
public import Mathlib.LinearAlgebra.GeneralLinearGroup.Basic

/-!
# Sylow marking and the native Mathieu parabolic quotient action

Six explicit triangular words and a 129-pair orbit certificate construct an
actual Sylow two-subgroup of the native matrix group. It lies in the literal
parabolic and fixes exactly the line generated by 1327. Genuine conjugation
and its representation operators transport this result to every Sylow subgroup.

The parabolic orbit of the marked line spans the already certified six-space.
Its intrinsic two-core lies in the marked Sylow. Normality therefore makes the
two-core fix every orbit vector, so the restricted action factors through the
literal quotient by this two-core.

For an actual conjugation quotient U → Q, equivariance and a nonzero fixed
image now supply the Sylow-line marking used by the existing first-actor
order-eight calculation. The source geometry and actor catalogue consume
these module facts in the assembly of Aschbacher–Smith 14.4.12, printed
pp.1011–1012; the fixed-line source is H.12.1(9), printed pp.393–394.
The original ATLAS attribution and numerical conventions are retained in
`SylowOrbit/source/README.md` and the imported native model.
-/

@[expose] public section
noncomputable section
open Subgroup Representation.BinaryOffender
open Sporadic.Mathieu M22TripleCover

namespace CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ModuleGeometry
namespace Native

def markedSylow : Sylow 2 Group := SylowCertificates.candidate_isSylow.choose

theorem markedSylow_coe : (markedSylow : Subgroup Group) = SylowCertificates.candidate :=
  SylowCertificates.candidate_isSylow.choose_spec

theorem markedSylow_le_parabolic : (markedSylow : Subgroup Group) ≤ parabolic := by
  rw [markedSylow_coe]
  exact SylowCertificates.candidate_le_parabolic

theorem markedSylow_fixedSpace :
    fixedSpace representation markedSylow = binaryLine markedVector := by
  rw [markedSylow_coe]
  exact SylowCertificates.fixedSpace_candidate

def actionEquiv (g : Group) : BinarySpace ≃ₗ[ZMod 2] BinarySpace :=
  LinearMap.GeneralLinearGroup.generalLinearEquiv (ZMod 2) BinarySpace
    (representation.asGroupHom g)

theorem actionEquiv_apply (g : Group) (v : BinarySpace) :
    actionEquiv g v = representation g v := rfl

theorem actionEquiv_equivariant (g a : Group) (v : BinarySpace) :
    actionEquiv g (representation a v) =
      representation ((MulAut.conj g) a) (actionEquiv g v) := by
  change representation g (representation a v) =
    representation (g * a * g⁻¹) (representation g v)
  simp only [← Module.End.mul_apply, ← map_mul, mul_assoc, inv_mul_cancel, mul_one]

theorem fixedSpace_map_conjugation (A : Subgroup Group) (g : Group) :
    (fixedSpace representation A).map (actionEquiv g).toLinearMap =
      fixedSpace representation (A.map (MulAut.conj g).toMonoidHom) :=
  fixedSpace_map_equivariant representation representation (MulAut.conj g).toMonoidHom
    (actionEquiv g) (actionEquiv_equivariant g) A

/-- The actual conjugating element supplies compatible linear coordinates. -/
theorem exists_sylow_coordinates (S : Sylow 2 Group) : ∃ g : Group,
    (S : Subgroup Group).map (MulAut.conj g).toMonoidHom = markedSylow ∧
    (fixedSpace representation S).map (actionEquiv g).toLinearMap = binaryLine markedVector := by
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq Group S markedSylow
  have hm : (S : Subgroup Group).map (MulAut.conj g).toMonoidHom = markedSylow :=
    congrArg Sylow.toSubgroup hg
  exact ⟨g, hm, by rw [fixedSpace_map_conjugation, hm, markedSylow_fixedSpace]⟩

theorem exists_sylow_fixedLine (S : Sylow 2 Group) : ∃ v : BinarySpace,
    v ≠ 0 ∧ fixedSpace representation S = binaryLine v := by
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq Group markedSylow S
  have hm : (markedSylow : Subgroup Group).map (MulAut.conj g).toMonoidHom = S :=
    congrArg Sylow.toSubgroup hg
  refine ⟨actionEquiv g markedVector, ?_, ?_⟩
  · exact fun h => markedVector_ne_zero ((actionEquiv g).injective
      (h.trans (map_zero _).symm))
  · have he := fixedSpace_map_conjugation (markedSylow : Subgroup Group) g
    rw [hm, markedSylow_fixedSpace] at he
    rw [← he, binaryLine, Submodule.map_span, Set.image_singleton]
    rfl

/-- A nonzero Sylow-fixed subspace is the entire, now proved, fixed line. -/
theorem nonzero_sylow_fixed_subspace (S : Sylow 2 Group)
    (I : Submodule (ZMod 2) BinarySpace) (hI : I ≠ ⊥)
    (hfix : I ≤ fixedSpace representation S) : ∃ v : BinarySpace,
    v ≠ 0 ∧ I = binaryLine v := by
  obtain ⟨v, hv, hS⟩ := exists_sylow_fixedLine S
  have ha : IsAtom (binaryLine v) :=
    Submodule.isAtom_iff_finrank_eq_one.mpr (finrank_span_singleton hv)
  exact ⟨v, hv, (ha.le_iff_eq hI).mp (hfix.trans_eq hS)⟩

/-- Normality and orbit generation make the intrinsic parabolic two-core trivial on the six-space. -/
theorem parabolic_twoCore_le_kernel : pCore 2 parabolic ≤ parabolicRepresentation.ker := by
  let N := (pCore 2 parabolic).map parabolic.subtype
  have hNT : N ≤ (markedSylow : Subgroup Group) := by
    rintro _ ⟨x, hx, rfl⟩
    exact pCore_isPGroup.le_sylow_of_normal (markedSylow.subtype markedSylow_le_parabolic) hx
  have hseed : binaryLine markedVector ≤ fixedSpace representation N := by
    rw [← markedSylow_fixedSpace]
    intro v hv n
    exact hv ⟨n, hNT n.property⟩
  have hnorm : parabolic ≤ normalizer (N : Set Group) := by
    intro g hg
    have hn : (⊤ : Subgroup parabolic) ≤ normalizer (pCore 2 parabolic : Set parabolic) :=
      le_normalizer_of_normal
    exact le_normalizer_map parabolic.subtype
      (mem_map_of_mem parabolic.subtype (hn (mem_top (⟨g, hg⟩ : parabolic))))
  have hspace : parabolicSpace ≤ fixedSpace representation N := by
    rw [parabolicSpace_eq_orbitSpan]
    exact Homogeneous.orbitSpan_le representation hseed
      (hnorm.trans (normalizer_le_stabilizer_fixedSpace representation N))
  intro g hg
  apply LinearMap.ext
  intro v
  apply Subtype.ext
  exact hspace v.property ⟨g, mem_map_of_mem parabolic.subtype hg⟩

def parabolicQuotientRepresentation :
    Representation (ZMod 2) (parabolic ⧸ pCore 2 parabolic) parabolicSpace :=
  QuotientGroup.lift (pCore 2 parabolic) parabolicRepresentation
    (fun _ hg => parabolic_twoCore_le_kernel hg)

theorem parabolicQuotientRepresentation_mk (g : parabolic) :
    parabolicQuotientRepresentation (QuotientGroup.mk' (pCore 2 parabolic) g) =
      parabolicRepresentation g := rfl

/-- The source two-local is usually a proper subgroup of the native parabolic.
    This is its literal restricted action; the kernel premise is left at the
    exact O₂(D)-position where the actor catalogue supplies it. -/
def subgroupRepresentation (D : Subgroup Group) (hD : D ≤ parabolic) :
    Representation (ZMod 2) D parabolicSpace :=
  parabolicRepresentation.comp (Subgroup.inclusion hD)

theorem subgroupRepresentation_apply (D : Subgroup Group) (hD : D ≤ parabolic)
    (g : D) (v : parabolicSpace) :
    subgroupRepresentation D hD g v = parabolicRepresentation ⟨g, hD g.property⟩ v := rfl

theorem pCore_subgroup_le_subgroupRepresentation_kernel
    (D : Subgroup Group) (hD : D ≤ parabolic)
    (hcore : (pCore 2 D).map (Subgroup.inclusion hD) ≤ pCore 2 parabolic) :
    pCore 2 D ≤ (subgroupRepresentation D hD).ker := by
  intro g hg
  have hm : (⟨g, hD g.property⟩ : parabolic) ∈ pCore 2 parabolic := by
    exact hcore (Subgroup.mem_map.mpr ⟨g, hg, rfl⟩)
  exact parabolic_twoCore_le_kernel hm

def subgroupQuotientRepresentation (D : Subgroup Group) (hD : D ≤ parabolic)
    (hO : pCore 2 D ≤ (subgroupRepresentation D hD).ker) :
    Representation (ZMod 2) (D ⧸ pCore 2 D) parabolicSpace :=
  QuotientGroup.lift (pCore 2 D) (subgroupRepresentation D hD) (fun _ hg => hO hg)

theorem subgroupQuotientRepresentation_mk (D : Subgroup Group) (hD : D ≤ parabolic)
    (hO : pCore 2 D ≤ (subgroupRepresentation D hD).ker) (g : D) :
    subgroupQuotientRepresentation D hD hO (QuotientGroup.mk' (pCore 2 D) g) =
      subgroupRepresentation D hD g := rfl

end Native

open scoped IsMulCommutative
variable {G Q : Type*} [Group G] [Group Q] [IsMulCommutative Q]
  [Module (ZMod 2) (Additive Q)]

/-- A literal equivariant conjugation quotient sends a nonzero fixed image to the proved Sylow line. -/
theorem quotientImage_sylow_marking
    (U V₂ T : Subgroup G) (hn : T ≤ normalizer (U : Set G))
    (q : U →* Q) (e : Additive Q ≃ₗ[ZMod 2] BinarySpace)
    (f : T →* Native.Group) (S : Sylow 2 Native.Group) (hS : f.range = S)
    (hact : ∀ (t : T) (u : U), Native.representation (f t) (e (Additive.ofMul (q u))) =
      e (Additive.ofMul (q ⟨(t : G) * u * (t : G)⁻¹,
        le_normalizer_iff.mp hn t t.property u u.property⟩)))
    (hfixed : ∀ (t : T) (u : U), u ∈ V₂.subgroupOf U →
      q ⟨(t : G) * u * (t : G)⁻¹,
        le_normalizer_iff.mp hn t t.property u u.property⟩ = q u)
    (hne : quotientImage U q V₂ ≠ ⊥) :
    ∃ v : BinarySpace, v ≠ 0 ∧
      (quotientImage U q V₂).map e.toLinearMap = Native.binaryLine v := by
  apply Native.nonzero_sylow_fixed_subspace S
  · intro hz
    apply hne
    apply (Submodule.eq_bot_iff _).mpr
    intro w hw
    have hm := Submodule.mem_map_of_mem (f := e.toLinearMap) hw
    rw [hz] at hm
    exact e.injective (hm.trans (map_zero e).symm)
  · rintro _ ⟨w, hw, rfl⟩ a
    have ha : (a : Native.Group) ∈ f.range := hS.symm ▸ a.property
    obtain ⟨t, ht⟩ := ha
    obtain ⟨u, hu, hqu⟩ := hw
    have hw' : w = Additive.ofMul (q u) := congrArg Additive.ofMul hqu.symm
    subst w
    change Native.representation (a : Native.Group) (e (Additive.ofMul (q u))) =
      e (Additive.ofMul (q u))
    rw [← ht, hact, hfixed t u hu]

/-- Consumer: the Sylow marking supplies the missing line premise of the first-actor calculation. -/
theorem firstActor_movedSpace_card_eight_of_sylow_image [Finite G]
    (H T U V₂ : Subgroup G) [IsExtraspecial 2 U]
    (hX : firstActor H ∈ XFamily H T) (hUT : U ≤ T)
    (hHU : H ≤ normalizer (U : Set G)) (hTU : T ≤ normalizer (U : Set G))
    (hVU : V₂ ≤ U) (hZV : center U ≤ V₂.subgroupOf U)
    (q : U →* Q) (hq : Function.Surjective q) (hker : q.ker = center U)
    (e : Additive Q ≃ₗ[ZMod 2] BinarySpace)
    (fT : T →* Native.Group) (S : Sylow 2 Native.Group) (hS : fT.range = S)
    (hTact : ∀ (t : T) (u : U), Native.representation (fT t) (e (Additive.ofMul (q u))) =
      e (Additive.ofMul (q ⟨(t : G) * u * (t : G)⁻¹,
        le_normalizer_iff.mp hTU t t.property u u.property⟩)))
    (hfixed : ∀ (t : T) (u : U), u ∈ V₂.subgroupOf U →
      q ⟨(t : G) * u * (t : G)⁻¹,
        le_normalizer_iff.mp hTU t t.property u u.property⟩ = q u)
    (hne : quotientImage U q V₂ ≠ ⊥)
    (f : firstActor H →* Native.Group)
    (hact : ∀ (x : firstActor H) (u : U),
      Native.representation (f x) (e (Additive.ofMul (q u))) =
      e (Additive.ofMul (q ⟨(x : G) * u * (x : G)⁻¹,
        le_normalizer_iff.mp (hX.le_H.trans hHU) x x.property u u.property⟩)))
    (hactor : f.range = zpowers Native.centralScalar) :
    Nat.card (movedSpace V₂ (firstActor H)) = 8 := by
  obtain ⟨v, hv, hmark⟩ := quotientImage_sylow_marking U V₂ T hTU q e fT S hS hTact hfixed hne
  exact firstActor_movedSpace_card_eight H T U V₂ hX hUT hHU hVU hZV
    q hq hker e f hact v hv hmark hactor

end CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ModuleGeometry
