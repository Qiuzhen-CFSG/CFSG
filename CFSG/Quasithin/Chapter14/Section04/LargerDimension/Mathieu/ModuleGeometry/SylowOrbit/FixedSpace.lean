module
public import CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ModuleGeometry.SylowOrbit.Generators
/-!
# Elimination of the native Mathieu fixed-space equations

Eleven independent scalar equations from the six certified two-subgroup
operators have a checked elimination matrix. Their common kernel is exactly
the line generated by the marked vector 1327. This is the fixed-space part
of H.12.1(9), used in 14.4.12, printed pp.393–394 and 1011–1012.
-/
@[expose] public section
noncomputable section
open Matrix Representation.SL2FourNatural
open Sporadic.Mathieu M22TripleCover
open Janko4.OuterReduction.FixedGenerator.NormalizerSquares.TwoCoreLinearModel
open Representation.BinaryOffender Subgroup
open scoped Matrix
namespace CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ModuleGeometry.Native
namespace SylowCertificates
open OrbitCertificates


/-- Eleven independent scalar equations from the six generator fixed-space equations. -/
def equationActor : Fin 11 → Fin 6 := ![0, 0, 0, 0, 0, 0, 1, 1, 2, 3, 5]
def equationRow : Fin 11 → Fin 12 := ![0, 1, 2, 3, 4, 6, 0, 4, 0, 1, 0]
def equationMatrix : Matrix12 := fromRows ![3448, 1772, 2693, 555, 3760, 461, 959, 1589, 619, 3532, 588, 0]
def eliminationMatrix : Matrix12 := fromRows ![0, 946, 165, 1337, 1113, 1559, 264, 234, 1118, 148, 767, 223]
def lineProjection : Matrix12 := fun i j => if j = 0 then markedVector i else 0

theorem equation_rows : ∀ i : Fin 11, ∀ j : Fin 12,
    equationMatrix i.castSucc j =
      (generatorMatrix (equationActor i) - 1) (equationRow i) j := by decide +kernel

theorem equation_last : ∀ j, equationMatrix 11 j = 0 := by decide +kernel

theorem fixed_elimination : eliminationMatrix * equationMatrix = 1 - lineProjection := by
  decide +kernel

theorem fixedSpace_candidate : fixedSpace representation candidate = binaryLine markedVector := by
  apply le_antisymm
  · intro v hv
    have heq : equationMatrix *ᵥ v = 0 := by
      ext i
      refine Fin.lastCases ?_ (fun j => ?_) i
      · simp [Matrix.mulVec, dotProduct, equation_last]
      · have hf := hv (⟨generator (equationActor j), subset_closure ⟨_, rfl⟩⟩ : candidate)
        change ((generator (equationActor j) : Matrix12ˣ) : Matrix12) *ᵥ v = v at hf
        rw [generator_matrix] at hf
        have hh : (generatorMatrix (equationActor j) - 1) *ᵥ v = 0 := by
          rw [Matrix.sub_mulVec, hf, one_mulVec, sub_self]
        have hrow := congrFun hh (equationRow j)
        simpa only [Matrix.mulVec, dotProduct, equation_rows, Pi.zero_apply] using hrow
    have helim := congrArg (fun w => eliminationMatrix *ᵥ w) heq
    rw [mulVec_mulVec, fixed_elimination, Matrix.sub_mulVec, one_mulVec, mulVec_zero] at helim
    have hproj : lineProjection *ᵥ v = v 0 • markedVector := by
      ext i
      simp [lineProjection, Matrix.mulVec, dotProduct, mul_comm]
    rw [hproj, sub_eq_zero] at helim
    exact Submodule.mem_span_singleton.mpr ⟨v 0, helim.symm⟩
  · intro v hv g
    exact (candidate_le_pointCentralizer g.property).2 v hv

end SylowCertificates
end CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ModuleGeometry.Native
