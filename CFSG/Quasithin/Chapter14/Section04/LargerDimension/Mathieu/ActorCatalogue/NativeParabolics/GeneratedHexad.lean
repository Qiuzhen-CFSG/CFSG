module

public import CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ActorCatalogue.NativeParabolics.HexadCover

/-!
# Marked quotient maps on an identified native hexad subgroup

An equality with the full native hexad preimage transports its six-point
projection to the literal subgroup generated by the source actors. The two-core
maps isomorphically onto the pointwise hexad kernel. Modulo that two-core the
six-point projection retains the cubic scalar kernel, and the full inverse
image of A₆ is the nonsplit quasisimple triple cover, marked over the six points.

The assembly in `NativeParabolics.Assembly` proves the required equality for
S ∨ O²(P₂) ∨ O²(B); these maps therefore apply to the actual source join.
Source: Aschbacher--Smith 14.4.12, printed pp.1011--1012, and H.12.1(4),
printed pp.393--394.
-/

@[expose] public section
open Subgroup Sporadic.Mathieu Theory.GroupTheory
open CFSG.Quasithin.Chapter14.Section04.LargerDimension
open CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ActorCatalogue.Native
namespace CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ActorCatalogue.NativeParabolics.GeneratedHexad

variable {D : Subgroup Model} {b : Finset (Fin 22)}

/-- The six-point map on the original subgroup, retaining its actual elements. -/
noncomputable def sixProjection (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b) :
    D →* Equiv.Perm (Fin 6) :=
  (HexadCover.sixProjection hb).comp (MulEquiv.subgroupCongr hD).toMonoidHom

theorem sixProjection_apply (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b) (x : D) :
    sixProjection hb hD x =
      M22OuterHexad.action hb ⟨designProjection x.val, hD ▸ x.property⟩ := rfl

theorem sixProjection_surjective (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b) :
    Function.Surjective (sixProjection hb hD) :=
  (HexadCover.sixProjection_surjective hb).comp (MulEquiv.subgroupCongr hD).surjective

theorem twoCore_le_sixKernel (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b) :
    pCore 2 D ≤ (sixProjection hb hD).ker := by
  subst D
  exact HexadCover.twoCore_le_sixKernel hb

/-- O₂ of the original subgroup with its marked pointwise-kernel identification. -/
noncomputable def twoCoreKernelEquiv (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b) :
    pCore 2 D ≃* (M22OuterHexad.action hb).ker := by
  subst D
  exact HexadCover.twoCoreKernelEquiv hb

/-- The marked isomorphism is the restriction of the original design projection. -/
theorem twoCoreKernelEquiv_apply (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b)
    (x : pCore 2 D) :
    (twoCoreKernelEquiv hb hD x).val.val = designProjection x.val.val := by
  subst D
  rfl

theorem twoCore_elementary (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b) :
    IsElementaryAbelian 2 (pCore 2 D) := by
  subst D
  exact HexadCover.twoCore_elementary hb

theorem twoCore_card (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b) :
    Nat.card (pCore 2 D) = 16 := by
  subst D
  exact HexadCover.twoCore_card hb

theorem twoCore_design_image (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b) :
    (D.pCoreIn 2).map designProjection =
      (m22HexadPointwiseKernel b).map M22ValueBound.Concrete.inclusion := by
  subst D
  exact HexadCover.twoCore_design_image hb

/-- Before quotienting, the six-point kernel is precisely O₂ times the cubic. -/
theorem sixProjection_kernel (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b) :
    (sixProjection hb hD).ker = pCore 2 D ⊔ cubic.subgroupOf D := by
  subst D
  exact (HexadCover.sixKernel_eq_twoCore_sup_cubic hb).trans
    (congrArg (pCore 2 (hexadPreimage b) ⊔ ·) (HexadCover.projection_kernel b))

noncomputable def quotientProjection (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b) :
    coreQuotient D →* Equiv.Perm (Fin 6) :=
  QuotientGroup.lift _ (sixProjection hb hD) (twoCore_le_sixKernel hb hD)

theorem quotientProjection_mk (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b) (x : D) :
    quotientProjection hb hD (QuotientGroup.mk' (pCore 2 D) x) =
      sixProjection hb hD x := rfl

theorem quotientProjection_surjective (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b) :
    Function.Surjective (quotientProjection hb hD) := by
  subst D
  exact HexadCover.quotientSixProjection_surjective hb

/-- The surviving cubic is the image of the literal scalar subgroup. -/
theorem quotientProjection_kernel (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b) :
    (quotientProjection hb hD).ker =
      (cubic.subgroupOf D).map (QuotientGroup.mk' (pCore 2 D)) := by
  subst D
  exact (HexadCover.quotientSixProjection_kernel hb).trans
    (congrArg (map (QuotientGroup.mk' (pCore 2 (hexadPreimage b))))
      (HexadCover.projection_kernel b))

theorem quotientProjection_kernel_card (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b) :
    Nat.card (quotientProjection hb hD).ker = 3 := by
  subst D
  exact HexadCover.quotientSixProjection_kernel_card hb

/-- The full even inverse image, inside the original subgroup's core quotient. -/
noncomputable def evenSubgroup (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b) :
    Subgroup (coreQuotient D) :=
  (alternatingGroup (Fin 6)).comap (quotientProjection hb hD)

noncomputable def evenProjection (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b) :
    evenSubgroup hb hD →* alternatingGroup (Fin 6) :=
  (quotientProjection hb hD).subgroupComap _

theorem evenProjection_surjective (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b) :
    Function.Surjective (evenProjection hb hD) := by
  subst D
  exact HexadCover.evenProjection_surjective hb

theorem evenProjection_kernel_eq_center (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b) :
    (evenProjection hb hD).ker = center (evenSubgroup hb hD) := by
  subst D
  exact HexadCover.evenProjection_kernel_eq_center hb

theorem evenProjection_kernel_card (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b) :
    Nat.card (evenProjection hb hD).ker = 3 := by
  subst D
  exact HexadCover.evenProjection_kernel_card hb

theorem evenSubgroup_isQuasisimple (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b) :
    IsQuasisimple (evenSubgroup hb hD) := by
  subst D
  exact HexadCover.evenQuotient_isQuasisimple hb

theorem exists_hexacode_equiv (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b) :
    ∃ e : evenSubgroup hb hD ≃* Atlas.Codes.HexEvenAutomorphisms,
      Atlas.Codes.hexEvenCoordinate.comp e.toMonoidHom = evenProjection hb hD := by
  subst D
  exact HexadCover.exists_hexacode_equiv hb

theorem evenProjection_nonsplit (hb : b ∈ m22Blocks) (hD : D = hexadPreimage b) :
    ¬ ∃ s : alternatingGroup (Fin 6) →* evenSubgroup hb hD,
      (evenProjection hb hD).comp s = MonoidHom.id _ := by
  subst D
  exact HexadCover.evenProjection_nonsplit hb

end CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ActorCatalogue.NativeParabolics.GeneratedHexad
