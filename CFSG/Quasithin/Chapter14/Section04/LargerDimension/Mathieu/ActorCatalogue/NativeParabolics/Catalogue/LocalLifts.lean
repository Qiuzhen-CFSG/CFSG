module

public import CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ActorCatalogue.NativeParabolics.Catalogue.Reduction
public import Theory.Mathieu.M22.ValueBoundParabolics.OddCoverLifting
public import Theory.GroupTheory.QuotientIntersection

/-!
# Existence and uniqueness of the native rank-one lifts

For a design overgroup whose even intersection has intrinsic two-core quotient
S₃, odd central splitting gives a characteristic complement inside the component.
Adjoining the prescribed Sylow subgroup constructs a lift disjoint from the cubic
kernel, with its exact image and relative index retained.

The complement is unique because its even part is generated by two-elements.
A two-element mapping into another complement lies in that complement: the
central cubic error has both odd order and two-power order. The original Sylow
then recovers the outer subgroup. Centrality is used only inside the component.

Source: Aschbacher--Smith, 14.4.12, printed pp.1011--1012, using the local odd
central splitting argument of E.4.3(2), printed pp.241--242. The existence proof
specializes the published OddCoverLifting.exists_local_lift argument to the
literal designProjection and also retains disjointness from its kernel.
-/

@[expose] public section
open Subgroup
open CFSG.Quasithin.Chapter14.Section04.LargerDimension
open CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ActorCatalogue.Native
open CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ActorCatalogue.NativeParabolics
namespace CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ActorCatalogue.NativeParabolics.Catalogue
open Sporadic.Mathieu
open Sporadic.Mathieu.M22ValueBound.OddCoverLifting
lemma exists_lift_of_inner_symmetricThree (T : Sylow 2 Model)
    (P : Subgroup m22DesignAut)
    (hTP : (T : Subgroup Model).map designProjection ≤ P)
    (e : ((P ⊓ M22ValueBound.Concrete.inner : Subgroup m22DesignAut) ⧸
      pCore 2 (P ⊓ M22ValueBound.Concrete.inner : Subgroup m22DesignAut)) ≃*
        Equiv.Perm (Fin 3)) :
    ∃ H : Subgroup Model, (T : Subgroup Model) ≤ H ∧
      H.map designProjection = P ∧ Disjoint cubic H ∧ Nonempty (H ≃* P) := by
  let q := designProjection
  let L := component
  let C := cubic
  have hCL : C ≤ L := cubic_le_component
  have hc : C ≤ centralizer (L : Set Model) := cubic_le_centralizer_component
  have hodd : Odd (Nat.card C) := by rw [show Nat.card C = 3 from cubic_card]; decide
  have hgen : L ⊔ (T : Subgroup Model) = ⊤ := component_sup_sylow T
  have hsplit := Sporadic.Mathieu.M22ValueBound.OddCoverLifting.oddCentralSplitting_three
  let A := P.comap q
  have hTA : (T : Subgroup Model) ≤ A := fun x hx => hTP (mem_map_of_mem q hx)
  have hCA : C ≤ A := by
    intro x hx
    change q x ∈ P
    rw [show q x = 1 from (show x ∈ designProjection.ker from designProjection_ker.symm ▸ hx)]
    exact P.one_mem
  let E := L.subgroupOf A
  let Z := C.subgroupOf A
  have hZE : Z ≤ E := fun x hx => hCL hx
  let F := P ⊓ L.map q
  let f : E →* F :=
    ((q.comp A.subtype).comp E.subtype).codRestrict F (by
      intro x
      exact ⟨x.val.property, mem_map_of_mem q x.property⟩)
  have hf : Function.Surjective f := by
    intro y
    obtain ⟨l, hl, hly⟩ := mem_map.mp y.property.2
    have hlA : l ∈ A := by change q l ∈ P; rw [hly]; exact y.property.1
    exact ⟨⟨⟨l, hlA⟩, hl⟩, Subtype.ext hly⟩
  have hker : f.ker = Z.subgroupOf E := by
    ext x
    change (f x = 1) ↔ (x.val.val ∈ cubic)
    rw [← designProjection_ker]
    exact Subtype.ext_iff
  have hkC : f.ker ≤ center E := by
    rw [hker]
    intro x hx
    apply mem_center_iff.mpr
    intro y
    apply Subtype.ext
    apply Subtype.ext
    exact (hc hx) y.val.val y.property
  have hoddZ : Odd (Nat.card Z) := by
    rw [Nat.card_congr (subgroupOfEquivOfLe hCA).toEquiv]
    exact hodd
  have hoddK : Odd (Nat.card f.ker) := by
    rw [hker, Nat.card_congr (subgroupOfEquivOfLe hZE).toEquiv]
    exact hoddZ
  have hF : F = P ⊓ M22ValueBound.Concrete.inner := by
    dsimp [F, L, q]
    rw [component_map_designProjection]
  let eF := (pCoreQuotientEquiv (MulEquiv.subgroupCongr hF)).trans e
  obtain ⟨D, hchar, hD⟩ := hsplit E F f hf hkC hoddK eF
  let := hchar
  have hET : E ⊔ (T.subtype hTA : Subgroup A) = ⊤ := by
    apply top_unique
    intro x _
    have hx : (x : Model) ∈ L ⊔ (T : Subgroup Model) := hgen ▸ mem_top _
    obtain ⟨l, hl, t, ht, hlt⟩ := mem_sup_of_normal_left.mp hx
    have hlA : l ∈ A := by
      have hltA : l * t ∈ A := hlt ▸ x.property
      exact (A.mul_mem_cancel_right (hTA ht)).mp hltA
    have hh : (⟨l, hlA⟩ : A) * ⟨t, hTA ht⟩ = x := Subtype.ext hlt
    rw [← hh]
    exact mul_mem_sup hl ht
  obtain ⟨K, hTK, hK⟩ := exists_complement_containing_sylow E Z hZE hoddZ
    (T.subtype hTA) hET D (hker ▸ hD)
  let H := K.map A.subtype
  have hTH : (T : Subgroup Model) ≤ H := by
    intro t ht
    exact mem_map.mpr ⟨⟨t, hTA ht⟩, hTK ht, rfl⟩
  have hCH : C ⊔ H = A := by
    have hh := congrArg (Subgroup.map A.subtype) hK.sup_eq_top
    simpa only [Z, Subgroup.map_sup, map_subgroupOf_eq_of_le hCA, ← MonoidHom.range_eq_map, range_subtype] using hh
  have hdis : Disjoint C H := by
    have hh := Subgroup.disjoint_map A.subtype_injective hK.disjoint
    simpa only [Z, map_subgroupOf_eq_of_le hCA] using hh
  have hHP : H.map q = P := by
    have hh := congrArg (Subgroup.map q) hCH
    simpa only [Subgroup.map_sup, (C.map_eq_bot_iff (f := q)).mpr (by change cubic ≤ designProjection.ker; rw [designProjection_ker]), bot_sup_eq,
      A, q, map_comap_eq_self_of_surjective designProjection_surjective] using hh
  have hi : Function.Injective (q.subgroupMap H) := by
    apply (MonoidHom.ker_eq_bot_iff _).mp
    apply bot_unique
    intro x hx
    apply Subtype.ext
    exact hdis.le_bot ⟨(show x.val ∈ cubic from designProjection_ker ▸
      (show x.val ∈ designProjection.ker from congrArg Subtype.val hx)), x.property⟩
  exact ⟨H, hTH, hHP, hdis, ⟨(MulEquiv.ofBijective (q.subgroupMap H)
    ⟨hi, q.subgroupMap_surjective H⟩).trans (MulEquiv.subgroupCongr hHP)⟩⟩

lemma inner_le_of_twoGenerated_image {P Q : Subgroup Model}
    (hQ : Q ≤ component) (hd : Disjoint cubic Q)
    (hg : twoGenerated P = ⊤) (hm : P.map designProjection ≤ Q.map designProjection) : P ≤ Q := by
  have hle : twoGenerated P ≤ Q.comap P.subtype := by
    apply (closure_le _).mpr
    rintro x ⟨n, hn⟩
    obtain ⟨y, hy, he⟩ := mem_map.mp (hm (mem_map_of_mem designProjection x.property))
    let c : Model := x.val * y⁻¹
    have hc : c ∈ cubic := by
      rw [← designProjection_ker]
      change designProjection (x.val * y⁻¹) = 1
      rw [map_mul, map_inv, ← he, mul_inv_cancel]
    have hcy : Commute c y := (cubic_le_centralizer_component hc y (hQ hy)).symm
    have hprod : c * y = x.val := by dsimp [c]; group
    have hpow : c ^ (2 ^ n) * y ^ (2 ^ n) = 1 := by
      rw [← hcy.mul_pow, hprod]
      exact congrArg Subtype.val hn
    have hcQ : c ^ (2 ^ n) ∈ Q := by
      have hh : c ^ (2 ^ n) = (y ^ (2 ^ n))⁻¹ := eq_inv_of_mul_eq_one_left hpow
      rw [hh]
      exact Q.inv_mem (Q.pow_mem hy _)
    have hcpow : c ^ (2 ^ n) = 1 := hd.le_bot ⟨cubic.pow_mem hc _, hcQ⟩
    have hodd : Odd (Nat.card cubic) := by rw [cubic_card]; decide
    have hc1 : c = 1 := by
      have hi := (hodd.coprime_two_right.pow_right n).pow_left_bijective (G := cubic)
      exact congrArg Subtype.val (hi.injective (a₁ := (⟨c, hc⟩ : cubic)) (a₂ := 1)
        (by apply Subtype.ext; simpa only [coe_pow, coe_one, one_pow] using hcpow))
    have hxy : x.val = y := by rw [← hprod, hc1, one_mul]
    change x.val ∈ Q
    rw [hxy]
    exact hy
  intro x hx
  exact hle (hg ▸ mem_top (⟨x, hx⟩ : P))

lemma inner_eq_of_image {P Q : Subgroup Model}
    (hP : P ≤ component) (hQ : Q ≤ component)
    (hdP : Disjoint cubic P) (hdQ : Disjoint cubic Q)
    (hgP : twoGenerated P = ⊤) (hgQ : twoGenerated Q = ⊤)
    (hm : P.map designProjection = Q.map designProjection) : P = Q :=
  le_antisymm (inner_le_of_twoGenerated_image hQ hdQ hgP hm.le)
    (inner_le_of_twoGenerated_image hP hdP hgQ hm.ge)

noncomputable def designEquivOfDisjoint (P : Subgroup Model) (hd : Disjoint cubic P) :
    P ≃* P.map designProjection := by
  refine MulEquiv.ofBijective (designProjection.subgroupMap P)
    ⟨?_, designProjection.subgroupMap_surjective P⟩
  intro x y h
  apply designProjection_injective_of_disjoint hd
  exact congrArg (fun z : P.map designProjection => (z : m22DesignAut)) h

lemma inner_map_designProjection (P : Subgroup Model) :
    (P ⊓ component).map designProjection = P.map designProjection ⊓ M22ValueBound.Concrete.inner := by
  rw [map_inf_of_ker_le designProjection P component
    (by rw [designProjection_ker]; exact cubic_le_component), component_map_designProjection]

lemma inner_sup_sylow (S : Sylow 2 Model) (P : Subgroup Model)
    (hSP : (S : Subgroup Model) ≤ P) : (P ⊓ component) ⊔ (S : Subgroup Model) = P := by
  apply le_antisymm (sup_le inf_le_left hSP)
  intro x hx
  have hx' : x ∈ component ⊔ (S : Subgroup Model) := component_sup_sylow S ▸ mem_top x
  obtain ⟨c, hc, t, ht, he⟩ := mem_sup_of_normal_left.mp hx'
  have hcP : c ∈ P := (P.mul_mem_cancel_right (hSP ht)).mp (he ▸ hx)
  rw [← he]
  exact mul_mem_sup ⟨hcP, hc⟩ ht

lemma lift_unique_of_inner_symmetricThree (S : Sylow 2 Model) (P Q : Subgroup Model)
    (hSP : (S : Subgroup Model) ≤ P) (hSQ : (S : Subgroup Model) ≤ Q)
    (hdP : Disjoint cubic P) (hdQ : Disjoint cubic Q)
    (hm : P.map designProjection = Q.map designProjection)
    (e : ((P.map designProjection ⊓ M22ValueBound.Concrete.inner : Subgroup m22DesignAut) ⧸
      pCore 2 (P.map designProjection ⊓ M22ValueBound.Concrete.inner : Subgroup m22DesignAut)) ≃*
        Equiv.Perm (Fin 3)) : P = Q := by
  let eP : (P ⊓ component : Subgroup Model) ≃*
      (P.map designProjection ⊓ M22ValueBound.Concrete.inner : Subgroup m22DesignAut) :=
    (designEquivOfDisjoint (P ⊓ component) (hdP.mono_right inf_le_left)).trans
    (MulEquiv.subgroupCongr (inner_map_designProjection P))
  let eQ : (Q ⊓ component : Subgroup Model) ≃*
      (P.map designProjection ⊓ M22ValueBound.Concrete.inner : Subgroup m22DesignAut) :=
    (designEquivOfDisjoint (Q ⊓ component) (hdQ.mono_right inf_le_left)).trans
    (MulEquiv.subgroupCongr ((inner_map_designProjection Q).trans (by rw [hm])))
  have hgp : twoGenerated (P ⊓ component : Subgroup Model) = ⊤ :=
    twoGenerated_of_symmetric_twoCore ((pCoreQuotientEquiv eP).trans e)
  have hgq : twoGenerated (Q ⊓ component : Subgroup Model) = ⊤ :=
    twoGenerated_of_symmetric_twoCore ((pCoreQuotientEquiv eQ).trans e)
  have he := inner_eq_of_image (P := P ⊓ component) (Q := Q ⊓ component)
    inf_le_right inf_le_right (hdP.mono_right inf_le_left) (hdQ.mono_right inf_le_left)
    hgp hgq (by rw [inner_map_designProjection, inner_map_designProjection, hm])
  rw [← inner_sup_sylow S P hSP, ← inner_sup_sylow S Q hSQ, he]

lemma exists_rankOne_lift (S : Sylow 2 Model) (P : Subgroup m22DesignAut)
    (hP : P ∈ rankOneOvergroups (S.mapSurjective designProjection_surjective))
    (e : ((P ⊓ M22ValueBound.Concrete.inner : Subgroup m22DesignAut) ⧸
      pCore 2 (P ⊓ M22ValueBound.Concrete.inner : Subgroup m22DesignAut)) ≃*
        Equiv.Perm (Fin 3)) :
    ∃ H : Subgroup Model, H ∈ rankOneOvergroups S ∧ H.map designProjection = P ∧
      Disjoint cubic H := by
  obtain ⟨H, hSH, hm, hd, _⟩ := exists_lift_of_inner_symmetricThree S P hP.1 e
  refine ⟨H, ⟨hSH, ?_⟩, hm, hd⟩
  rw [← relIndex_image_of_disjoint S hSH hd, hm]
  exact hP.2



end CFSG.Quasithin.Chapter14.Section04.LargerDimension.Mathieu.ActorCatalogue.NativeParabolics.Catalogue
