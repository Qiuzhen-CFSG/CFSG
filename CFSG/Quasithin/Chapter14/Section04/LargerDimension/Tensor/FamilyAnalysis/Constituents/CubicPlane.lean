module

public import CFSG.Quasithin.Chapter14.Section04.LargerDimension.Tensor.FamilyAnalysis.Coordinates
public import Theory.Representation.BinaryOffender.ConjugationImage

/-!
# The plane generated by the first tensor actor

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, the first
proof paragraph of Lemma 14.4.10, printed p.1010, under 14.4.2(5), p.1006.

The cubic norm vanishes on the actual natural-S₃ tensor action. Hence the
cubic orbit of a nonzero vector consists of v, rv and v + rv, and these
span a binary plane. We identify the commutator of the binary line with
this plane and prove its order is four. This works for both specified
four-dimensional constituents, before choosing an invariant constituent.
The literal quotient and extraspecial lifts are in Images.
-/

@[expose] public section

open Subgroup TensorProduct Representation.BinaryOffender
namespace CFSG.Quasithin.Chapter14.Section04.LargerDimension.Tensor
variable {D : Subgroup Five} {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]

/-- The fixed cubic in the S₃ direct factor. -/
abbrev cubicActor (D : Subgroup Five) : Three × D := (InvertedCubicTensor.cubic, 1)

/-- The marked tensor actor has order exactly three. -/
theorem cubicActor_order : orderOf (cubicActor D) = 3 := by
  rw [Prod.orderOf_mk, orderOf_one, Nat.lcm_one_right]
  apply orderOf_eq_prime
  · decide +kernel
  · decide +kernel

/-- Its cyclic subgroup has precisely these three words. -/
theorem cubicActor_words {a : Three × D} (ha : a ∈ zpowers (cubicActor D)) :
    a = 1 ∨ a = cubicActor D ∨ a = cubicActor D * cubicActor D := by
  classical
  rw [mem_zpowers_iff_mem_range_orderOf, cubicActor_order] at ha
  obtain ⟨n, hn, rfl⟩ := Finset.mem_image.mp ha
  have hn' : n < 3 := Finset.mem_range.mp hn
  interval_cases n <;> simp [pow_two]

/-- The plane with its two literal cubic orbit generators. -/
noncomputable def cubicPlane (σ : Representation (ZMod 2) D V)
    (v : BinaryPermutation.core (Fin 3) ⊗[ZMod 2] V) :
    Submodule (ZMod 2) (BinaryPermutation.core (Fin 3) ⊗[ZMod 2] V) :=
  Submodule.span (ZMod 2) {v, sourceTensorAction σ (cubicActor D) v}

private theorem binary_double (v : BinaryPermutation.core (Fin 3) ⊗[ZMod 2] V) :
    v + v = 0 := by
  simpa only [show (1 : ZMod 2) + 1 = 0 by decide, zero_smul, one_smul] using
    (add_smul (1 : ZMod 2) 1 v).symm

private theorem cubic_square (σ : Representation (ZMod 2) D V)
    (v : BinaryPermutation.core (Fin 3) ⊗[ZMod 2] V) :
    sourceTensorAction σ (cubicActor D) (sourceTensorAction σ (cubicActor D) v) =
      v + sourceTensorAction σ (cubicActor D) v := by
  have h := sourceTensor_cubic_displacement σ v
  have hn (w : BinaryPermutation.core (Fin 3) ⊗[ZMod 2] V) : -w = w :=
    neg_eq_iff_add_eq_zero.mpr (binary_double w)
  rw [sub_eq_add_neg, hn] at h
  have hh := congrArg (fun w => w + sourceTensorAction σ (cubicActor D) v) h
  simpa only [add_assoc, binary_double, add_zero] using hh

/-- The commutator of a binary line is its cubic orbit plane. -/
theorem cubic_moved_line (σ : Representation (ZMod 2) D V)
    (v : BinaryPermutation.core (Fin 3) ⊗[ZMod 2] V) :
    subspaceCommutator (sourceTensorAction σ) (Submodule.span (ZMod 2) {v})
      (zpowers (cubicActor D)) = cubicPlane σ v := by
  let r := sourceTensorAction σ (cubicActor D)
  have hv : v ∈ cubicPlane σ v := Submodule.subset_span (Set.mem_insert _ _)
  have hr : r v ∈ cubicPlane σ v :=
    Submodule.subset_span (Set.mem_insert_of_mem _ (Set.mem_singleton _))
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨a, ha, w, hw, rfl⟩
    obtain ⟨k, rfl⟩ := Submodule.mem_span_singleton.mp hw
    rw [map_smul, ← smul_sub]
    apply Submodule.smul_mem
    rcases cubicActor_words ha with rfl | rfl | rfl
    · simp only [map_one, Module.End.one_apply, sub_self, Submodule.zero_mem]
    · exact Submodule.sub_mem _ hr hv
    · rw [map_mul, Module.End.mul_apply, cubic_square]
      exact Submodule.sub_mem _ (Submodule.add_mem _ hv hr) hv
  · have h₁ : r v - v ∈ subspaceCommutator (sourceTensorAction σ)
        (Submodule.span (ZMod 2) {v}) (zpowers (cubicActor D)) :=
      Submodule.subset_span ⟨_, mem_zpowers _, v, Submodule.mem_span_singleton_self v, rfl⟩
    have h₂ : r (r v) - v ∈ subspaceCommutator (sourceTensorAction σ)
        (Submodule.span (ZMod 2) {v}) (zpowers (cubicActor D)) :=
      Submodule.subset_span ⟨cubicActor D * cubicActor D,
        (zpowers _).mul_mem (mem_zpowers _) (mem_zpowers _), v,
        Submodule.mem_span_singleton_self v, by
          simp only [map_mul, Module.End.mul_apply]; rfl⟩
    have hrv : r v ∈ subspaceCommutator (sourceTensorAction σ)
        (Submodule.span (ZMod 2) {v}) (zpowers (cubicActor D)) := by
      change sourceTensorAction σ (cubicActor D) _ - v ∈ _ at h₂
      rw [cubic_square, add_sub_cancel_left] at h₂
      exact h₂
    have hv' : v ∈ subspaceCommutator (sourceTensorAction σ)
        (Submodule.span (ZMod 2) {v}) (zpowers (cubicActor D)) := by
      have hh := Submodule.sub_mem _ hrv h₁
      simpa only [sub_sub_cancel] using hh
    apply Submodule.span_le.mpr
    intro w hw
    rcases (show w = v ∨ w = r v from hw) with he | he
    · exact he ▸ hv'
    · exact he ▸ hrv

/-- Every nonzero vector generates a plane under the fixed-point-free cubic. -/
theorem cubicPlane_finrank (σ : Representation (ZMod 2) D V)
    (v : BinaryPermutation.core (Fin 3) ⊗[ZMod 2] V) (hv : v ≠ 0) :
    Module.finrank (ZMod 2) (cubicPlane σ v) = 2 := by
  let r := sourceTensorAction σ (cubicActor D)
  have hr : r v ≠ 0 := by
    intro hz
    dsimp [r] at hz
    have hh := congrArg (sourceTensorAction σ (cubicActor D)⁻¹) hz
    simp only [← Module.End.mul_apply, ← map_mul, inv_mul_cancel,
      map_one, Module.End.one_apply, map_zero] at hh
    exact hv hh
  have hfix : r v ≠ v := fun he => hv (sourceTensor_cubic_fixed_free σ v he)
  have hsum : v + r v ≠ 0 := by
    intro he
    have hh := eq_neg_of_add_eq_zero_right he
    have hn : -v = v := neg_eq_iff_add_eq_zero.mpr (binary_double v)
    exact hfix (hh.trans hn)
  have hi : LinearIndependent (ZMod 2) ![v, r v] := by
    rw [LinearIndependent.pair_iff]
    intro a b he
    have hf : ∀ k : ZMod 2, k = 0 ∨ k = 1 := by decide
    rcases hf a with rfl | rfl <;> rcases hf b with rfl | rfl <;>
      simp only [zero_smul, one_smul, zero_add, add_zero] at he ⊢
    · trivial
    · exact (hr he).elim
    · exact (hv he).elim
    · exact (hsum he).elim
  have he : Set.range ![v, r v] = {v, r v} := by
    ext w
    simp only [Set.mem_range, Set.mem_insert_iff, Set.mem_singleton_iff]
    constructor
    · rintro ⟨i, rfl⟩
      fin_cases i <;> simp
    · rintro (rfl | rfl)
      · exact ⟨0, rfl⟩
      · exact ⟨1, rfl⟩
  have hh := finrank_span_eq_card hi
  change Module.finrank (ZMod 2) (Submodule.span (ZMod 2) (Set.range ![v, r v])) = 2 at hh
  rw [he] at hh
  exact hh

/-- The plane has four elements in either constituent alternative. -/
theorem cubicPlane_card (σ : Representation (ZMod 2) D V)
    (v : BinaryPermutation.core (Fin 3) ⊗[ZMod 2] V) (hv : v ≠ 0) :
    Nat.card (cubicPlane σ v) = 4 := by
  let : FiniteDimensional (ZMod 2) (cubicPlane σ v) :=
    Module.finite_of_finrank_pos (by rw [cubicPlane_finrank σ v hv]; decide)
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2), Nat.card_zmod,
    cubicPlane_finrank σ v hv]
  rfl

end CFSG.Quasithin.Chapter14.Section04.LargerDimension.Tensor

end
