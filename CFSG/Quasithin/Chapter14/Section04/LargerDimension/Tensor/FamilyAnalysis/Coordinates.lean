module

public import CFSG.Quasithin.Chapter14.Section04.LargerDimension.Tensor.Quotients
public import Theory.Representation.BinaryPermutation.FiveTensorQuadratic
public import Theory.Representation.SL2FourNaturalOrbits.Model
public import Theory.Representation.InvertedCubicTensor

/-!
# Literal coordinates for case 14.4.2(5)

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, printed
p.1006 and the first paragraph of Lemma 14.4.10 on p.1010.

The actor is the actual H/O₂(H), identified with S₃ × D, where D is the
whole symmetric five-group or its alternating subgroup. The module is the
actual U/Z(U), and its coordinate map intertwines literal conjugation by H
with the external tensor action. The four-dimensional constituent is marked
by either SL₂(4)'s binary natural action or the deleted five-point action.
In particular, these two source alternatives are not conflated by the word
"natural" in some permutation-module APIs.

The cubic norm on the even three-point core is zero. Tensoring this identity
proves that the marked cubic displacement is surjective for either constituent.
Its element lies in the image of the literal X₁, so the whole tensor module
is generated by X₁-displacements. No family classification or invariant
constituent conclusion is included in the coordinate hypotheses.

This is a local action contract, not an encoding or proof of all of Hypothesis
14.3.10. The source owner must retain Hypothesis 14.3.1, U = ⟨V^G₁⟩ nonabelian,
H = G₁, extraspeciality in §14.4, and the earlier 12.8/14.3 geometric inputs.
-/

@[expose] public section

open Subgroup TensorProduct
namespace CFSG.Quasithin.Chapter14.Section04.LargerDimension.Tensor

abbrev Five := Equiv.Perm (Fin 5)
abbrev AltFive := alternatingGroup (Fin 5)
abbrev Three := Equiv.Perm (Fin 3)

variable {D : Subgroup Five} (hAD : AltFive ≤ D)
variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]

/-- The natural SL₂(4) action, with an actual group and module identification. -/
def IsNaturalFour (σ : Representation (ZMod 2) D V) : Prop :=
  ∃ (e : AltFive ≃* Representation.SL2FourNatural.SL)
    (f : V ≃ₗ[ZMod 2] Representation.SL2FourNatural.V),
    ∀ (a : AltFive) (v : V), f (σ (inclusion hAD a) v) =
      Representation.SL2FourNatural.action (e a) (f v)

/-- The binary deleted permutation A₅ action, with its actual linear identification. -/
def IsDeletedFour (σ : Representation (ZMod 2) D V) : Prop :=
  ∃ f : V ≃ₗ[ZMod 2] BinaryPermutation.core (Fin 5),
    ∀ (a : AltFive) (v : V), f (σ (inclusion hAD a) v) =
      BinaryPermutation.coreRepresentation (Fin 5) a.val (f v)

/-- Precisely the two binary constituent alternatives in case (5). -/
def IsSourceConstituent (σ : Representation (ZMod 2) D V) : Prop :=
  IsNaturalFour hAD σ ∨ IsDeletedFour hAD σ

/-- Either specified constituent has binary dimension four. -/
theorem IsSourceConstituent.finrank_four {σ : Representation (ZMod 2) D V}
    (h : IsSourceConstituent hAD σ) : Module.finrank (ZMod 2) V = 4 := by
  rcases h with ⟨e, f, _⟩ | ⟨f, _⟩
  · exact f.finrank_eq.trans Representation.SL2FourNatural.finrank_vector
  · rw [f.finrank_eq, BinaryPermutation.finrank_core]
    norm_num

/-- The specified natural S₃ action tensor the four-dimensional constituent. -/
noncomputable def sourceTensorAction (σ : Representation (ZMod 2) D V) :
    Representation (ZMod 2) (Three × D) (BinaryPermutation.core (Fin 3) ⊗[ZMod 2] V) :=
  Representation.tprod
    ((BinaryPermutation.coreRepresentation (Fin 3)).comp (MonoidHom.fst _ _))
    (σ.comp (MonoidHom.snd _ _))


private theorem natural_cubic_norm (v : BinaryPermutation.core (Fin 3)) :
    BinaryPermutation.coreRepresentation (Fin 3) InvertedCubicTensor.cubic
      (BinaryPermutation.coreRepresentation (Fin 3) InvertedCubicTensor.cubic v) +
      BinaryPermutation.coreRepresentation (Fin 3) InvertedCubicTensor.cubic v + v = 0 := by
  have hv := v.property
  rw [BinaryPermutation.mem_core, Fin.sum_univ_three] at hv
  apply Subtype.ext
  funext i
  fin_cases i
  · change v.val 1 + v.val 2 + v.val 0 = 0
    calc
      _ = v.val 0 + v.val 1 + v.val 2 := by abel
      _ = 0 := hv
  · change v.val 2 + v.val 0 + v.val 1 = 0
    calc
      _ = v.val 0 + v.val 1 + v.val 2 := by abel
      _ = 0 := hv
  · exact hv

private theorem binary_double (v : V) : v + v = 0 := by
  simpa only [show (1 : ZMod 2) + 1 = 0 by decide, zero_smul, one_smul] using
    (add_smul (1 : ZMod 2) 1 v).symm

/-- The cubic norm vanishes on the entire tensor product. -/
theorem sourceTensor_cubic_norm (σ : Representation (ZMod 2) D V)
    (z : BinaryPermutation.core (Fin 3) ⊗[ZMod 2] V) :
    sourceTensorAction σ (InvertedCubicTensor.cubic, 1)
      (sourceTensorAction σ (InvertedCubicTensor.cubic, 1) z) +
      sourceTensorAction σ (InvertedCubicTensor.cubic, 1) z + z = 0 := by
  induction z using TensorProduct.induction_on with
  | zero => simp
  | tmul n v =>
    change TensorProduct.map _ (σ 1) (TensorProduct.map _ (σ 1) (n ⊗ₜ[ZMod 2] v)) +
      TensorProduct.map _ (σ 1) (n ⊗ₜ[ZMod 2] v) + n ⊗ₜ[ZMod 2] v = 0
    rw [map_one]
    simp only [TensorProduct.map_tmul, Module.End.one_apply]
    change (BinaryPermutation.coreRepresentation (Fin 3) InvertedCubicTensor.cubic
        (BinaryPermutation.coreRepresentation (Fin 3) InvertedCubicTensor.cubic n)) ⊗ₜ[ZMod 2] v +
      (BinaryPermutation.coreRepresentation (Fin 3) InvertedCubicTensor.cubic n) ⊗ₜ[ZMod 2] v +
      n ⊗ₜ[ZMod 2] v = 0
    rw [← TensorProduct.add_tmul, ← TensorProduct.add_tmul, natural_cubic_norm,
      TensorProduct.zero_tmul]
  | add x y hx hy =>
    simp only [map_add]
    calc
      _ = (sourceTensorAction σ (InvertedCubicTensor.cubic, 1)
          (sourceTensorAction σ (InvertedCubicTensor.cubic, 1) x) +
          sourceTensorAction σ (InvertedCubicTensor.cubic, 1) x + x) +
          (sourceTensorAction σ (InvertedCubicTensor.cubic, 1)
          (sourceTensorAction σ (InvertedCubicTensor.cubic, 1) y) +
          sourceTensorAction σ (InvertedCubicTensor.cubic, 1) y + y) := by abel
      _ = 0 := by rw [hx, hy, zero_add]

/-- The marked cubic acts without nonzero fixed vectors. -/
theorem sourceTensor_cubic_fixed_free (σ : Representation (ZMod 2) D V)
    (z : BinaryPermutation.core (Fin 3) ⊗[ZMod 2] V)
    (hz : sourceTensorAction σ (InvertedCubicTensor.cubic, 1) z = z) : z = 0 := by
  have h := sourceTensor_cubic_norm σ z
  simpa only [hz, binary_double, zero_add] using h

/-- Every tensor is a single cubic displacement, with an explicit preimage. -/
theorem sourceTensor_cubic_displacement (σ : Representation (ZMod 2) D V)
    (z : BinaryPermutation.core (Fin 3) ⊗[ZMod 2] V) :
    sourceTensorAction σ (InvertedCubicTensor.cubic, 1)
      (sourceTensorAction σ (InvertedCubicTensor.cubic, 1) z) -
      sourceTensorAction σ (InvertedCubicTensor.cubic, 1) z = z := by
  have hn (v : BinaryPermutation.core (Fin 3) ⊗[ZMod 2] V) : -v = v :=
    neg_eq_iff_add_eq_zero.mpr (binary_double v)
  rw [sub_eq_add_neg, hn]
  have h := eq_neg_of_add_eq_zero_left (sourceTensor_cubic_norm σ z)
  exact h.trans (hn z)

variable {G : Type*} [Group G]

/-- The exact quotient and conjugation coordinates of the tensor alternative. -/
structure CaseFiveCoordinates (H U : Subgroup G) where
  actor_case : D = ⊤ ∨ D = AltFive
  constituent : Representation (ZMod 2) D V
  constituent_model : IsSourceConstituent hAD constituent
  actor : coreQuotient H ≃* Three × D
  space : (U ⧸ center U) ≃* Multiplicative (BinaryPermutation.core (Fin 3) ⊗[ZMod 2] V)
  U_le_H : U ≤ H
  H_normalizes_U : H ≤ normalizer (U : Set G)
  equivariant : ∀ (h : H) (u : U),
    space (QuotientGroup.mk' (center U)
      ⟨(h : G) * u * (h : G)⁻¹,
        le_normalizer_iff.mp H_normalizes_U h h.property u u.property⟩) =
    Multiplicative.ofAdd (sourceTensorAction constituent
      (actor (QuotientGroup.mk' (pCore 2 H) h))
      (space (QuotientGroup.mk' (center U) u)).toAdd)

namespace CaseFiveCoordinates
variable {hAD} {H U : Subgroup G} (c : CaseFiveCoordinates hAD (V := V) H U)

/-- The quotient map U → U/Z(U) followed by the specified tensor coordinates. -/
noncomputable def quotientMap :
    U →* Multiplicative (BinaryPermutation.core (Fin 3) ⊗[ZMod 2] V) :=
  c.space.toMonoidHom.comp (QuotientGroup.mk' (center U))

/-- These coordinates retain exactly the central kernel. -/
theorem quotientMap_ker : c.quotientMap.ker = center U := by
  ext u
  change c.space (QuotientGroup.mk' (center U) u) = 1 ↔ u ∈ center U
  rw [map_eq_one_iff c.space c.space.injective]
  exact QuotientGroup.eq_one_iff u

/-- Every tensor has an actual lift in U. -/
theorem quotientMap_surjective : Function.Surjective c.quotientMap :=
  c.space.surjective.comp (QuotientGroup.mk'_surjective _)

include c in
/-- The coordinate actor supplies either actual model isomorphism used by the family APIs. -/
theorem actor_models :
    Nonempty (coreQuotient H ≃* Three × Five) ∨
      Nonempty (coreQuotient H ≃* Three × AltFive) := by
  rcases c.actor_case with hd | hd
  · exact Or.inl ⟨c.actor.trans (MulEquiv.prodCongr (MulEquiv.refl _)
      ((MulEquiv.subgroupCongr hd).trans topEquiv))⟩
  · exact Or.inr ⟨c.actor.trans (MulEquiv.prodCongr (MulEquiv.refl _)
      (MulEquiv.subgroupCongr hd))⟩

private theorem cubic_mem_threeCore : InvertedCubicTensor.cubic ∈ pCore 3 Three := by
  have hA : alternatingGroup (Fin 3) ≤ pCore 3 Three := by
    apply le_sSup
    refine ⟨inferInstance, IsPGroup.of_card (n := 1) ?_⟩
    rw [nat_card_alternatingGroup]
    norm_num
  apply hA
  rw [Equiv.Perm.mem_alternatingGroup]
  decide +kernel

/-- The marked cubic is in the image of the literal O²(O₂,₃(H)). -/
theorem marked_cubic_mem_star_first [Finite G] :
    c.actor.symm (InvertedCubicTensor.cubic, 1) ∈ star H (first H) := by
  rw [star_first]
  have hm : (InvertedCubicTensor.cubic, (1 : D)) ∈
      (pCore 3 (coreQuotient H)).map c.actor.toMonoidHom := by
    rw [pCore_map_iso, pCore_prod]
    exact ⟨cubic_mem_threeCore, one_mem _⟩
  exact mem_map_equiv.mp hm

/-- The source equality [Ũ,X₁] = Ũ in the specified tensor coordinates. -/
theorem first_moves_tensor [Finite G] :
    Representation.BinaryOffender.subspaceCommutator
      ((sourceTensorAction c.constituent).comp c.actor.toMonoidHom)
      ⊤ (star H (first H)) = ⊤ := by
  apply top_unique
  intro z _
  apply Submodule.subset_span
  refine ⟨c.actor.symm (InvertedCubicTensor.cubic, 1), c.marked_cubic_mem_star_first,
    sourceTensorAction c.constituent (InvertedCubicTensor.cubic, 1) z,
    Submodule.mem_top, ?_⟩
  change z = sourceTensorAction c.constituent
    (c.actor (c.actor.symm (InvertedCubicTensor.cubic, 1))) _ - _
  rw [c.actor.apply_symm_apply]
  exact (sourceTensor_cubic_displacement c.constituent z).symm

end CaseFiveCoordinates
end CFSG.Quasithin.Chapter14.Section04.LargerDimension.Tensor

end
