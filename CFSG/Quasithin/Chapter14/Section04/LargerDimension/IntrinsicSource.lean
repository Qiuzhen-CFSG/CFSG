module

public import CFSG.Quasithin.Chapter14.Section04.LargerDimension.SourceSylowBound
public import CFSG.Quasithin.ChapterI.Section04To05.Extraspecial32.NonnormalRecognition.Geometry.Parabolics.Quotient
public import Theory.GroupTheory.TwoLocalCoreObstruction
public import Theory.GroupTheory.QuaternionCentralProductResidualRecognition.Residual
public import Theory.GroupTheory.LocalNormalizerUniqueness

/-!
# Restricting the source A₃ configuration to its generated group

In Aschbacher--Smith, *The Classification of Quasithin Groups*, combined
manuscript of 1 March 2004, Lemma 14.4.13 (printed p. 1012), I.5.1 applies to
G₀ = ⟨LT, L₁XT, L_XT⟩. This module carries the literal vertex quotients,
Sylow subgroups, parabolics and conjugation actions into that subgroup.
Ambient uniqueness and a proper intersection with L_XT give O₂(G₀) = 1,
hence the core-free chamber condition D4. The residual-normalizer route to
that intersection retains O²(L ∩ L_XT) = L₂ as its precise premise.

The earlier source constructions of the three vertex models and parabolics
remain inputs. Neither the original local group H nor M is required to lie
in G₀; the uniqueness argument takes place in the original ambient group.
The final order obstruction uses the already proved L₄(2) bound of 64. Its
input 64 < |U| includes the source d = 8 case, where |U| = 512.
-/

@[expose] public section

open Subgroup

namespace CFSG.Quasithin.Chapter14.Section04.LargerDimension.IntrinsicSource

variable {G : Type*} [Group G]

/-- The actual group generated by the three vertices in 14.4.13. -/
def actualG0 (L T L₁ L₂ X : Subgroup G) : Subgroup G :=
  (L ⊔ T) ⊔ (L₁ ⊔ X ⊔ T) ⊔ (localJoin L₂ X ⊔ T)

/-- The source vertices, in the point, line, plane order of I.5. -/
def sourceVertex (L T L₁ L₂ X : Subgroup G) : Fin 3 → Subgroup G :=
  ![L ⊔ T, L₁ ⊔ X ⊔ T, localJoin L₂ X ⊔ T]

private theorem sourceVertex_le_actualG0 (L T L₁ L₂ X : Subgroup G) (i : Fin 3) :
    sourceVertex L T L₁ L₂ X i ≤ actualG0 L T L₁ L₂ X := by
  fin_cases i
  · exact le_sup_left.trans le_sup_left
  · exact le_sup_right.trans le_sup_left
  · exact le_sup_right

/-- The source Sylow subgroup lies in the group to which recognition applies. -/
theorem source_T_le_actualG0 (L T L₁ L₂ X : Subgroup G) :
    T ≤ actualG0 L T L₁ L₂ X := le_sup_right.trans (le_sup_left.trans le_sup_left)

private theorem generated_restriction (A B C : Subgroup G) :
    let K := A ⊔ B ⊔ C
    A.subgroupOf K ⊔ B.subgroupOf K ⊔ C.subgroupOf K = ⊤ := by
  dsimp
  rw [← subgroupOf_sup (le_sup_left.trans le_sup_left)
      (le_sup_right.trans le_sup_left),
    ← subgroupOf_sup le_sup_left le_sup_right, subgroupOf_self]

/-- Restricting the three actual vertices supplies intrinsic generatedness. -/
theorem source_vertices_generate_actualG0 (L T L₁ L₂ X : Subgroup G) :
    let K := actualG0 L T L₁ L₂ X
    (L ⊔ T).subgroupOf K ⊔ (L₁ ⊔ X ⊔ T).subgroupOf K ⊔
      (localJoin L₂ X ⊔ T).subgroupOf K = ⊤ :=
  generated_restriction (L ⊔ T) (L₁ ⊔ X ⊔ T) (localJoin L₂ X ⊔ T)

/-- Flattening a contained vertex transports the quotient by its own two-core. -/
noncomputable def coreQuotientRestriction {H K : Subgroup G} (hHK : H ≤ K) :
    (H.subgroupOf K ⧸ pCore 2 (H.subgroupOf K)) ≃* (H ⧸ pCore 2 H) :=
  QuotientGroup.congr _ _ (subgroupOfEquivOfLe hHK)
    (pCore_map_iso 2 (subgroupOfEquivOfLe hHK))

/-- The transported equivalence agrees with the literal quotient maps. -/
theorem coreQuotientRestriction_mk {H K : Subgroup G} (hHK : H ≤ K)
    (x : H.subgroupOf K) :
    coreQuotientRestriction hHK (QuotientGroup.mk' _ x) =
      QuotientGroup.mk' _ (subgroupOfEquivOfLe hHK x) := rfl

/-- The quotient equivalence intertwines conjugation by the actual vertex elements. -/
theorem coreQuotientRestriction_conj {H K : Subgroup G} (hHK : H ≤ K)
    (x : H.subgroupOf K) (q : H.subgroupOf K ⧸ pCore 2 (H.subgroupOf K)) :
    coreQuotientRestriction hHK
        (QuotientGroup.mk' _ x * q * (QuotientGroup.mk' _ x)⁻¹) =
      QuotientGroup.mk' _ (subgroupOfEquivOfLe hHK x) *
        coreQuotientRestriction hHK q *
        (QuotientGroup.mk' _ (subgroupOfEquivOfLe hHK x))⁻¹ := by
  simp only [map_mul, map_inv, coreQuotientRestriction_mk]

private theorem vertex_sylow_restriction {H K T : Subgroup G} (hHK : H ≤ K)
    (hT : ∃ S : Sylow 2 H, (S : Subgroup H) = T.subgroupOf H) :
    ∃ S₀ : Sylow 2 (H.subgroupOf K),
      (S₀ : Subgroup (H.subgroupOf K)) =
        (T.subgroupOf K).subgroupOf (H.subgroupOf K) := by
  obtain ⟨S, hS⟩ := hT
  let e := subgroupOfEquivOfLe hHK
  refine ⟨S.comapOfInjective e.toMonoidHom e.injective ?_, ?_⟩
  · intro x _
    obtain ⟨y, hy⟩ := e.surjective x
    exact ⟨y, hy⟩
  · change (S : Subgroup H).comap e.toMonoidHom = _
    rw [hS]
    rfl

/-- Each source vertex retains its literal model quotient, Sylow witness and
two specified parabolics after restriction to G₀. The input parabolics are
relative subgroups, so this transport does not impose extra containments on P or R. -/
theorem source_vertex_restriction
    (L T L₁ L₂ X P R : Subgroup G) (i : Fin 3) (Q : Type*) [Group Q]
    (hq : Nonempty (coreQuotient (sourceVertex L T L₁ L₂ X i) ≃* Q))
    (hS : ∃ S : Sylow 2 (sourceVertex L T L₁ L₂ X i),
      (S : Subgroup (sourceVertex L T L₁ L₂ X i)) =
        T.subgroupOf (sourceVertex L T L₁ L₂ X i))
    (hP : Quasithin.I5.RankTwoParabolics (sourceVertex L T L₁ L₂ X i)
      (T.subgroupOf (sourceVertex L T L₁ L₂ X i))
      (P.subgroupOf (sourceVertex L T L₁ L₂ X i))
      (R.subgroupOf (sourceVertex L T L₁ L₂ X i))) :
    let K := actualG0 L T L₁ L₂ X
    let H := sourceVertex L T L₁ L₂ X i
    Nonempty ((H.subgroupOf K ⧸ pCore 2 (H.subgroupOf K)) ≃* Q) ∧
      (∃ S₀ : Sylow 2 (H.subgroupOf K),
        (S₀ : Subgroup (H.subgroupOf K)) =
          (T.subgroupOf K).subgroupOf (H.subgroupOf K)) ∧
      Quasithin.I5.RankTwoParabolics (H.subgroupOf K)
        ((T.subgroupOf K).subgroupOf (H.subgroupOf K))
        ((P.subgroupOf K).subgroupOf (H.subgroupOf K))
        ((R.subgroupOf K).subgroupOf (H.subgroupOf K)) := by
  dsimp only
  have hHK := sourceVertex_le_actualG0 L T L₁ L₂ X i
  obtain ⟨e⟩ := hq
  refine ⟨⟨(coreQuotientRestriction hHK).trans e⟩,
    vertex_sylow_restriction hHK hS, ?_⟩
  exact CFSG.Quasithin.Extraspecial32.NonnormalRecognition.Parabolics.rankTwo_subgroupOf
    (sourceVertex L T L₁ L₂ X i) P R T (actualG0 L T L₁ L₂ X) hHK hP

/-- A source normalizer action on V commutes with restriction to G₀. Only V
must be contained in G₀; the actor H is restricted through its intersection. -/
theorem source_conjugation_restriction (L T L₁ L₂ X : Subgroup G)
    {V H : Subgroup G} (hVG₀ : V ≤ actualG0 L T L₁ L₂ X)
    (hHV : H ≤ normalizer (V : Set G))
    (a : H.subgroupOf (actualG0 L T L₁ L₂ X))
    (v : V.subgroupOf (actualG0 L T L₁ L₂ X)) :
    let a₀ : normalizer (V.subgroupOf (actualG0 L T L₁ L₂ X) :
        Set (actualG0 L T L₁ L₂ X)) :=
      ⟨a.val, (subgroupOf_normalizer_eq hVG₀) ▸ hHV a.property⟩
    (subgroupOfEquivOfLe hVG₀)
        ((V.subgroupOf (actualG0 L T L₁ L₂ X)).normalizerMonoidHom a₀ v) =
      V.normalizerMonoidHom ⟨a.val.val, hHV a.property⟩
        (subgroupOfEquivOfLe hVG₀ v) := rfl

/-- Ambient normality gives the required M-intersection once the actual
residual and relative normalizer have been identified. -/
theorem source_intersection_of_residual_normalizer (L L₂ T H₃ M : Subgroup G)
    (hLM : M ≤ normalizer (L : Set G))
    (hres : twoResidual (L ⊓ H₃) = L₂)
    (hnorm : H₃ ⊓ normalizer (L₂ : Set G) ≤ L₂ ⊔ T)
    (hPM : L₂ ⊔ T ≤ M) (hPH : L₂ ⊔ T ≤ H₃) :
    M ⊓ H₃ = L₂ ⊔ T := by
  apply le_antisymm _ (le_inf hPM hPH)
  have hn : M ⊓ H₃ ≤ normalizer ((L ⊓ H₃ : Subgroup G) : Set G) := by
    apply le_normalizer_iff.mpr
    intro a ha x hx
    exact ⟨(hLM ha.1 x).mp hx.1,
      H₃.mul_mem (H₃.mul_mem ha.2 hx.2) (H₃.inv_mem ha.2)⟩
  have hr := hn.trans (normalizer_le_normalizer_characteristic_image
    (L ⊓ H₃) (pResidual 2 (L ⊓ H₃ : Subgroup G)))
  change M ⊓ H₃ ≤ normalizer (twoResidual (L ⊓ H₃) : Set G) at hr
  rw [hres] at hr
  exact (le_inf inf_le_right hr).trans hnorm

private theorem generated_core_eq_bot [Finite G] (L T L₁ L₂ X M : Subgroup G)
    (hunique : ∀ K : Subgroup G, IsMaximalTwoLocal K → L ⊔ T ≤ K → K = M)
    (houtside : ¬ localJoin L₂ X ⊔ T ≤ M) :
    pCore 2 (actualG0 L T L₁ L₂ X) = ⊥ := by
  apply Theory.GroupTheory.twoCore_sup_eq_bot_of_unique_maximalTwoLocal_overgroup
    ((L ⊔ T) ⊔ (L₁ ⊔ X ⊔ T)) (localJoin L₂ X ⊔ T) M
  · intro K hK hle
    exact hunique K hK (le_sup_left.trans hle)
  · exact houtside

private theorem chamber_core_eq_bot {K : Type*} [Group K] (B : Subgroup K)
    (hB : IsPGroup 2 B) (hK : pCore 2 K = ⊥) : B.normalCore = ⊥ := by
  apply le_bot_iff.mp
  rw [← hK]
  exact le_sSup ⟨inferInstance, hB.to_le B.normalCore_le⟩

private theorem outside_of_source_intersection (L₂ X T M : Subgroup G)
    (hinter : M ⊓ (localJoin L₂ X ⊔ T) = L₂ ⊔ T)
    (hproper : IsCoatom ((L₂ ⊔ T).subgroupOf (localJoin L₂ X ⊔ T))) :
    ¬ localJoin L₂ X ⊔ T ≤ M := by
  intro hle
  have heq : L₂ ⊔ T = localJoin L₂ X ⊔ T :=
    hinter.symm.trans (inf_eq_right.mpr hle)
  exact hproper.1 (by rw [heq, subgroupOf_self])

/-- The D4 deduction of 14.4.13 on the actual G₀: ambient uniqueness and
the proper marked M-intersection force the intrinsic chamber to be core-free. -/
theorem source_intrinsic_core_free [Finite G] (L T L₁ L₂ X M : Subgroup G)
    (hunique : ∀ K : Subgroup G, IsMaximalTwoLocal K → L ⊔ T ≤ K → K = M)
    (hinter : M ⊓ (localJoin L₂ X ⊔ T) = L₂ ⊔ T)
    (hproper : IsCoatom ((L₂ ⊔ T).subgroupOf (localJoin L₂ X ⊔ T)))
    (hT : IsPGroup 2 T) :
    (T.subgroupOf (actualG0 L T L₁ L₂ X)).normalCore = ⊥ :=
  chamber_core_eq_bot _ hT.comap_subtype
    (generated_core_eq_bot L T L₁ L₂ X M hunique
      (outside_of_source_intersection L₂ X T M hinter hproper))

/-- The residual-normalizer source calculation feeds D4 without identifying
the whole intersection L ∩ L_XT with its two-residual. -/
theorem source_intrinsic_core_free_of_residual_normalizer [Finite G]
    (L T L₁ L₂ X M : Subgroup G)
    (hunique : ∀ K : Subgroup G, IsMaximalTwoLocal K → L ⊔ T ≤ K → K = M)
    (hLM : M ≤ normalizer (L : Set G))
    (hres : twoResidual (L ⊓ (localJoin L₂ X ⊔ T)) = L₂)
    (hnorm : (localJoin L₂ X ⊔ T) ⊓ normalizer (L₂ : Set G) ≤ L₂ ⊔ T)
    (hPM : L₂ ⊔ T ≤ M)
    (hproper : IsCoatom ((L₂ ⊔ T).subgroupOf (localJoin L₂ X ⊔ T)))
    (hT : IsPGroup 2 T) :
    (T.subgroupOf (actualG0 L T L₁ L₂ X)).normalCore = ⊥ := by
  apply source_intrinsic_core_free L T L₁ L₂ X M hunique _ hproper hT
  exact source_intersection_of_residual_normalizer L L₂ T (localJoin L₂ X ⊔ T) M
    hLM hres hnorm hPM (sup_le (le_sup_left.trans le_sup_left) le_sup_right)

/-- The adequate numerical contradiction after recognition of the actual G₀. -/
theorem source_order_contradiction [Finite G]
    (L T L₁ L₂ X U : Subgroup G) (hT : IsPGroup 2 T) (hUT : U ≤ T)
    (hU : 64 < Nat.card U)
    (e : actualG0 L T L₁ L₂ X ≃*
      Matrix.ProjectiveSpecialLinearGroup (Fin 4) (ZMod 2)) : False := by
  have hUTcard : Nat.card U ≤ Nat.card T :=
    Nat.card_le_card_of_injective (Subgroup.inclusion hUT)
      (Subgroup.inclusion_injective hUT)
  have hbound : L4TwoSylowBound T :=
    l4TwoSylowBound_of_recognized_overgroup hT (source_T_le_actualG0 L T L₁ L₂ X) e
  exact (not_lt_of_ge (hUTcard.trans hbound.card_le)) hU

/-- Both source dimensions d = 8 and d = 12 exceed the recognized model's
two-subgroup bound; the d = 8 branch has order exactly 512. -/
theorem source_large_card (d cardU : ℕ) (hd : d = 8 ∨ d = 12)
    (hU : cardU = 2 ^ (d + 1)) : 64 < cardU := by
  rcases hd with rfl | rfl <;> norm_num at hU ⊢ <;> omega

end CFSG.Quasithin.Chapter14.Section04.LargerDimension.IntrinsicSource
