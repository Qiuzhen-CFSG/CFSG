module
public import CFSG.Quasithin.Chapter14.Section04.LargerDimension.Orthogonal.Lift.Actions.ChiefModules.Equivariance
public import CFSG.Quasithin.Chapter14.Section04.LargerDimension.Orthogonal.ComponentSieve.Residual
public import Theory.Representation.BinaryPermutation.FiveConjugation
public import CFSG.Quasithin.ChapterC.Section01.BlockTypes.AlternatingFive.Intrinsic
public import Theory.GroupTheory.PCoreFrattiniTransport
public import CFSG.Quasithin.Chapter14.Section04.LargerDimension.Orthogonal.Lift.Assembly

/-!
# The deleted-five action on the actual orthogonal residual image

In the quotient of N_G(D) by its two-core, the kernel on K₀U is exactly
A = [U,i]⟨z⟩. Two-core functoriality and the original chief-factor marking
therefore identify the image core with U/A, with its literal deleted-five
conjugation action. The image is perfect: its core is generated by
commutators and its A₅ quotient is perfect. Consequently its solvable
residual has the same image. The proved residual comparison transfers this
to the corrected source subgroup (K₀UD)∞.

This constructs the image-action premise of the complete carrier sieve.
The selected involution and the earlier marked lift remain inputs; their
construction from the original invariant flag is a separate source step.

Source: Aschbacher--Smith, 14.4.9, printed p.1010. The corrected residual
and quotient conventions are those of ComponentSieve/Residual.lean.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter14.Section04.CaseOneLarge.Orthogonal
open LargerDimension.Orthogonal LargerDimension.Orthogonal.ComponentSieve
variable {G Q : Type*} [Group G] [Finite G] [Group Q] [Finite Q]

/-- Transport a literal binary factor through a surjection with its exact
kernel. The image's intrinsic two-core, quotient actor and conjugation all
come from the original maps. -/
private theorem binary_factor_image
    (P U A : Subgroup G) (hUP : U ≤ P) (hAU : A ≤ U)
    (hcore : pCore 2 P = U.subgroupOf P)
    (π : P →* alternatingGroup (Fin 5)) (hπ : Function.Surjective π)
    (hker : π.ker = U.subgroupOf P)
    (hPU : P ≤ normalizer (U : Set G)) [(A.subgroupOf U).Normal]
    (b : BinaryFactorModel P U A π hPU)
    (f : P →* Q) (hf : Function.Surjective f)
    (hk : f.ker = A.subgroupOf P) :
    Nonempty (BinaryPermutation.FiveConjugation Q (pCore 2 Q)) := by
  have hfk : IsPGroup 2 f.ker := by
    apply (pCore_isPGroup (p := 2) (G := P)).to_le
    rw [hk,hcore]
    exact subgroupOf_mono P hAU
  have hc : (pCore 2 Q).comap f = U.subgroupOf P :=
    (f.comap_pCore_of_ker_isPGroup hf hfk).trans hcore
  let fU : U →* pCore 2 Q := {
    toFun := fun u => ⟨f (inclusion hUP u), by
      change inclusion hUP u ∈ (pCore 2 Q).comap f
      rw [hc]
      exact u.property⟩
    map_one' := Subtype.ext (map_one f)
    map_mul' := fun a c => Subtype.ext (map_mul f (inclusion hUP a) (inclusion hUP c)) }
  have hfU : Function.Surjective fU := by
    intro v
    obtain ⟨p,hp⟩ := hf v
    have hpU : (p : G) ∈ U := by
      have hm : p ∈ (pCore 2 Q).comap f := by
        change f p ∈ pCore 2 Q
        rw [hp]
        exact v.property
      rw [hc] at hm
      exact hm
    exact ⟨⟨p,hpU⟩,Subtype.ext hp⟩
  have hkU : fU.ker = A.subgroupOf U := by
    ext u
    change fU u = 1 ↔ (u : G) ∈ A
    rw [Subtype.ext_iff]
    change f (inclusion hUP u) = 1 ↔ (u : G) ∈ A
    rw [← MonoidHom.mem_ker, hk]
    rfl
  let eU : (U ⧸ A.subgroupOf U) ≃* pCore 2 Q :=
    QuotientGroup.liftEquiv _ hfU hkU.symm
  let eP : (P ⧸ pCore 2 P) ≃* alternatingGroup (Fin 5) :=
    QuotientGroup.liftEquiv _ hπ (hcore.trans hker.symm)
  let eQ := (f.pCoreQuotientEquiv hf hfk).symm.trans eP
  let eV := eU.symm.trans b.equiv
  have hv (u : U) : eV (fU u) = b.equiv (QuotientGroup.mk' (A.subgroupOf U) u) := by
    change b.equiv (eU.symm (eU (QuotientGroup.mk' (A.subgroupOf U) u))) = _
    rw [eU.symm_apply_apply]
  have ha (p : P) : eQ (QuotientGroup.mk' (pCore 2 Q) (f p)) = π p := by
    change eP ((f.pCoreQuotientEquiv hf hfk).symm
      ((f.pCoreQuotientEquiv hf hfk) (QuotientGroup.mk' (pCore 2 P) p))) = _
    rw [MulEquiv.symm_apply_apply]
    rfl
  refine ⟨⟨eV,eQ,?_⟩⟩
  intro q v
  obtain ⟨p,rfl⟩ := hf q
  obtain ⟨u,rfl⟩ := hfU v
  let u' : U := ⟨(p : G) * (u : G) * (p : G)⁻¹,
    (mem_normalizer_iff.mp (hPU p.property) u).mp u.property⟩
  have hconj : (⟨f p * (fU u : Q) * (f p)⁻¹,
      (inferInstance : (pCore 2 Q).Normal).conj_mem (fU u) (fU u).property (f p)⟩ : pCore 2 Q) =
      fU u' := by
    apply Subtype.ext
    change f p * f (inclusion hUP u) * (f p)⁻¹ = f (inclusion hUP u')
    rw [← map_inv, ← map_mul, ← map_mul]
    rfl
  rw [hconj,hv,hv,ha]
  rw [← b.equivariant, b.formula]

/-- The binary core is generated by its commutators, and its A₅ quotient is
perfect; consequently the whole extension is perfect. -/
private theorem binary_five_perfect {X : Type*} [Group X]
    (m : BinaryPermutation.FiveConjugation X (pCore 2 X)) : Group.IsPerfect X := by
  have he (x : X) (v : pCore 2 X) := congrArg Multiplicative.toAdd (m.equivariant x v)
  have hc : pCore 2 X ≤ commutator X := by
    rw [← ChapterC.AlternatingFiveIntrinsic.blockU_eq_core m.actor m.coordinates he]
    exact commutator_mono le_top le_rfl
  let π := m.actor.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 X))
  have hπ : Function.Surjective π := m.actor.surjective.comp (QuotientGroup.mk'_surjective _)
  have hk : π.ker = pCore 2 X := by
    rw [MonoidHom.ker_comp_of_injective _ _ m.actor.injective,QuotientGroup.ker_mk']
  have ht : (⊤ : Subgroup X).map π = ⊤ :=
    MonoidHom.range_eq_map π ▸ MonoidHom.range_eq_top.mpr hπ
  have hm : (commutator X).map π = ⊤ := by
    rw [commutator_def,Subgroup.map_commutator,ht,← commutator_def]
    exact commutator_alternatingGroup_eq_top (by simp)
  have hh := congrArg (Subgroup.comap π) hm
  rw [Subgroup.comap_map_eq,hk,sup_eq_left.mpr hc,Subgroup.comap_top] at hh
  exact ⟨hh⟩
/-- The actual normalizer image of K₀U has the deleted binary-five action on
its own two-core. The lift computes its kernel as [U,i]⟨z⟩. -/
theorem source_actor_binary_image
    (U : Subgroup G) [IsExtraspecial 2 U] (T : Sylow 2 G) (z x : G)
    (hKU : diagonalResidual (centralizer ({z} : Set G)) (conjugateElement z x) ≤
      normalizer (U : Set G))
    (m : MovedCoreModel U
      (diagonalResidual (centralizer ({z} : Set G)) (conjugateElement z x))
      (conjugateElement z x) hKU)
    (r : LiftResult U T z x hKU m) :
    let D := centralizerLift U z (conjugateElement z x)
    let N := normalizer (D : Set G)
    let P := diagonalResidual (centralizer ({z} : Set G)) (conjugateElement z x) ⊔ U
    ∃ hPN : P ≤ N,
      let f := (QuotientGroup.mk' (pCore 2 N)).comp (inclusion hPN)
      Nonempty (BinaryPermutation.FiveConjugation f.range (pCore 2 f.range)) := by
  let i := conjugateElement z x
  let D := centralizerLift U z i
  let N := normalizer (D : Set G)
  let P := diagonalResidual (centralizer ({z} : Set G)) i ⊔ U
  let A := liftBase U z i
  have hPN : P ≤ N := le_sup_left.trans r.symmetric_normalizes
  let f := (QuotientGroup.mk' (pCore 2 N)).comp (inclusion hPN)
  let fR := f.rangeRestrict
  have hfR : Function.Surjective fR := f.rangeRestrict_surjective
  have hU : IsPGroup 2 U := IsExtraspecial.isPGroup 2 U
  have hcore : pCore 2 P = U.subgroupOf P := moved_actor_core m hU
  have hfk : IsPGroup 2 fR.ker := by
    have he : fR.ker = (pCore 2 N).comap (inclusion hPN) := by
      ext p
      change fR p = 1 ↔ inclusion hPN p ∈ pCore 2 N
      rw [Subtype.ext_iff]
      exact QuotientGroup.eq_one_iff _
    rw [he]
    exact pCore_isPGroup.comap_of_injective _ (inclusion_injective hPN)
  have hAU : A ≤ U := r.actions.base_self_centralizer.ge.trans inf_le_left
  have hAD : A ≤ D := r.actions.chief.series.strict.2.2.le
  let : IsElementaryAbelian 2 D := r.actions.chief.elementary_D
  have hUD : U ⊓ D ≤ A := by
    calc
      U ⊓ D ≤ U ⊓ centralizer (A : Set G) := le_inf inf_le_left
        (inf_le_right.trans (D.le_centralizer.trans (centralizer_le hAD)))
      _ = A := r.actions.base_self_centralizer
  have hk : fR.ker = A.subgroupOf P := by
    ext p
    constructor
    · intro hp
      have hpU : (p : G) ∈ U := by
        have hh : fR.ker ≤ pCore 2 P := le_sSup ⟨inferInstance,hfk⟩
        have hm := hh hp
        rw [hcore] at hm
        exact hm
      have hpN : (p : G) ∈ N.pCoreIn 2 := by
        exact mem_map.mpr ⟨inclusion hPN p,
          (QuotientGroup.eq_one_iff _).mp (congrArg Subtype.val (MonoidHom.mem_ker.mp hp)),rfl⟩
      have hpD : (p : G) ∈ D := r.normalizer_core.2.2.le
        ⟨(show U ≤ U ⊔ D from le_sup_left) hpU,hpN⟩
      exact hUD ⟨hpU,hpD⟩
    · intro hp
      apply MonoidHom.mem_ker.mpr
      apply Subtype.ext
      apply (QuotientGroup.eq_one_iff _).mpr
      have hNcore : (p : G) ∈ N.pCoreIn 2 := r.normalizer_core.1 (hAD hp)
      obtain ⟨a,ha,he⟩ := hNcore
      have ha' : a = inclusion hPN p := Subtype.ext he
      exact ha' ▸ ha
  let := r.actions.chief.normal_AU
  exact ⟨hPN,binary_factor_image P U A le_sup_right hAU hcore m.π m.surjective
    m.kernel (sup_le hKU U.le_normalizer) r.actions.chief.core fR hfR hk⟩

/-- The corrected solvable residual has the same image as K₀U. Thus its
literal image core carries the binary-five action needed by the full sieve. -/
theorem source_residual_binary_image
    (U : Subgroup G) [IsExtraspecial 2 U] (T : Sylow 2 G) (z x : G)
    (hzU : zpowers z ≤ U)
    (hiU : conjugateElement z x ∈ normalizer (U : Set G))
    (hKU : diagonalResidual (centralizer ({z} : Set G)) (conjugateElement z x) ≤
      normalizer (U : Set G))
    (m : MovedCoreModel U
      (diagonalResidual (centralizer ({z} : Set G)) (conjugateElement z x))
      (conjugateElement z x) hKU)
    (r : LiftResult U T z x hKU m) :
    let D := centralizerLift U z (conjugateElement z x)
    let N := normalizer (D : Set G)
    let J := diagonalResidual (centralizer ({z} : Set G)) (conjugateElement z x) ⊔ U ⊔ D
    let B := (solvableResidual J).map J.subtype
    let Bbar := (B.subgroupOf N).map (QuotientGroup.mk' (pCore 2 N))
    Nonempty (BinaryPermutation.FiveConjugation Bbar (pCore 2 Bbar)) := by
  let i := conjugateElement z x
  let D := centralizerLift U z i
  let N := normalizer (D : Set G)
  let A := diagonalResidual (centralizer ({z} : Set G)) i ⊔ U
  let J := A ⊔ D
  let B := (solvableResidual J).map J.subtype
  let q := QuotientGroup.mk' (pCore 2 N)
  obtain ⟨hAN,⟨c⟩⟩ := source_actor_binary_image U T z x hKU m r
  let f := (QuotientGroup.mk' (pCore 2 N)).comp (inclusion hAN)
  let : Group.IsPerfect f.range := binary_five_perfect c
  let : IsElementaryAbelian 2 D := r.actions.chief.elementary_D
  have heB : B = (solvableResidual A).map A.subtype :=
    corrected_residual_eq U z i hzU hiU (IsElementaryAbelian.isPGroup 2 D)
  have hBN : B ≤ N := by
    rw [heB]
    exact (map_subtype_le _).trans hAN
  have heN : (solvableResidual A).map (inclusion hAN) = B.subgroupOf N := by
    apply map_injective N.subtype_injective
    rw [map_map,map_subgroupOf_eq_of_le hBN,heB]
    rfl
  have hm : (solvableResidual A).map f = f.range := by
    have hR := map_solvableResidual_eq f.rangeRestrict f.rangeRestrict_surjective
    rw [solvableResidual_eq_top (G := f.range)] at hR
    have hh := congrArg (Subgroup.map f.range.subtype) hR
    simpa only [map_map, MonoidHom.subtype_comp_rangeRestrict,
      ← MonoidHom.range_eq_map,range_subtype] using hh
  have he : (B.subgroupOf N).map q = f.range := by
    rw [← heN,map_map]
    exact hm
  change Nonempty (BinaryPermutation.FiveConjugation
    ((B.subgroupOf N).map q) (pCore 2 ((B.subgroupOf N).map q)))
  rw [he]
  exact ⟨c⟩

end CFSG.Quasithin.Chapter14.Section04.CaseOneLarge.Orthogonal
