module

public import CFSG.Quasithin.Chapter14.Section04
public import CFSG.Quasithin.ChapterI.Section04To05.DSystem
public import CFSG.Quasithin.ChapterF.Section01.SourceDefs
public import Theory.SpecificGroups.ClassicalOrthogonal.SplitOdd
public import Theory.GroupTheory.PResidual.Defs

/-!
# The large extraspecial branch in §14.4

This file is the source-facing interface for the argument on pp. 1008--1012
of Aschbacher--Smith.  The six alternatives from 14.4.2 and the model
calculations used to eliminate them belong to the preceding G.11/local-list
development.  They are therefore inputs here, rather than opaque predicates
or labels.  The definitions below retain the actual two-residuals, actual
commutator modules, and actual subgroup joins used in 14.4.8--14.4.13.

The last theorem is deliberately conditional on the I.5.1 recognition map.
It constructs a literal `Quasithin.I5.DSystem` and then performs the final
Sylow order contradiction.  In particular, the J4 shadow cannot be passed to
this theorem merely from its involution centralizer: the supplied data must
include the source core-free condition (D4).
-/

@[expose] public section

open Subgroup

namespace CFSG.Quasithin.Chapter14.Section04.LargerDimension

universe u

variable {G : Type u} [Group G] [Finite G]

/-! ### The literal source families X and Y -/

/-- The two-core of a subgroup, embedded in the ambient group. -/
def twoCore (X : Subgroup G) : Subgroup G :=
  (pCore 2 X).map X.subtype

/-- The two-residual `O²(X)`, embedded in the ambient group. -/
def twoResidual (X : Subgroup G) : Subgroup G :=
  (pResidual 2 X).map X.subtype

/-- The source condition `X = O²(X)` together with the actual `T`-invariance
and the index-three condition `|X : O₂(X)| = 3`. -/
structure ThreeExtension (H T X : Subgroup G) : Prop where
  le_H : X ≤ H
  T_normalizes : T ≤ normalizer (X : Set G)
  residual_eq : twoResidual X = X
  index_three : (twoCore X).relIndex X = 3

/-- The set of all source `X`-subgroups in the local group `H`. -/
def XFamily (H T : Subgroup G) : Set (Subgroup G) :=
  {X | ThreeExtension H T X}

/-- The commutator module `V_X = [V₂, X]` from 14.4.8. -/
def movedSpace (V₂ X : Subgroup G) : Subgroup G := ⁅V₂, X⁆

/-- The source subfamily `Y`; rank three is represented by its actual order
`2³`, and containment is in the actual intersection module `E`. -/
def YFamily (H T V₂ E : Subgroup G) : Set (Subgroup G) :=
  {X | ThreeExtension H T X ∧ Nat.card (movedSpace V₂ X) = 8 ∧
    movedSpace V₂ X ≤ E}

/-- The local group `L_X = ⟨L₂, X⟩`.  Subgroup joins are the intrinsic
subgroup generated by the two source factors. -/
def localJoin (L₂ X : Subgroup G) : Subgroup G := L₂ ⊔ X

/-- Quotient by the intrinsic two-core of an ambient subgroup.  Naming this
type avoids elaboration ambiguity between a subgroup and its carrier type in
the source quotient notation. -/
abbrev coreQuotient (H : Subgroup G) : Type u :=
  H ⧸ pCore 2 H

/-! ### The elementary source consequences used repeatedly in 14.4.8 -/

structure FamilySetup (H T V₁ V₂ V E L₁ L₂ : Subgroup G) : Prop where
  L₁_three : ThreeExtension H T L₁
  V_eq : movedSpace V₂ L₁ = V
  V_card : Nat.card V = 8
  V_le_E : V ≤ E
  V₁_le_V : V₁ ≤ V

omit [Finite G] in
theorem familySetup_L₁_mem_Y
    {H T V₁ V₂ V E L₁ L₂ : Subgroup G}
    (h : FamilySetup H T V₁ V₂ V E L₁ L₂) :
    L₁ ∈ YFamily H T V₂ E := by
  refine ⟨h.L₁_three, ?_, ?_⟩
  · rw [h.V_eq, h.V_card]
  · rw [h.V_eq]
    exact h.V_le_E

omit [Finite G] in
theorem localJoin_le_of_mem_XFamily
    {H T L₂ X : Subgroup G} (hX : X ∈ XFamily H T) :
    localJoin L₂ X ≤ L₂ ⊔ H := by
  exact sup_le le_sup_left (hX.le_H.trans le_sup_right)

/-! ### The moved-rank dichotomy (14.4.6) -/

/-- Source data for the inspection of cases (3)--(6) in 14.4.2.  `HStar` is
the actual residual actor in the `S₃ × S₅` alternative, while `FStar` is the
actual subgroup carrying the `Ω⁺₄(4)` model.  The final field is the local
module calculation for the rank-two branch; it is kept as an earlier input
so that this declaration does not replace that calculation by a family tag. -/
structure MovedRankDichotomyInput
    (H U V₂ aStar HStar FStar : Subgroup G) (moved_rank : ℕ) : Prop where
  involution : Nat.card aStar = 2
  moved_card : Nat.card (movedSpace U aStar) = 2 ^ moved_rank
  model_case :
    Nonempty ((HStar : Type u) ≃* (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 5))) ∨
      ClassicalGroup.IsPOmegaPlus (FStar : Type u) 2 4
  low_rank_calculation : ¬ 2 < moved_rank →
    (¬ V₂ ≤ movedSpace U aStar ∧ moved_rank = 2)

omit [Finite G] in
/-- The precise disjunction in Lemma 14.4.6, with the actual model carriers
and the exact exclusion `Ṽ₂ ≰ [Ũ,a*]` in the exceptional branch. -/
theorem lemma_14_4_6_moved_rank
    {H U V₂ aStar HStar FStar : Subgroup G} {moved_rank : ℕ}
    (h : MovedRankDichotomyInput H U V₂ aStar HStar FStar moved_rank) :
    2 < moved_rank ∨
      ((Nonempty ((HStar : Type u) ≃* (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 5))) ∨
          ClassicalGroup.IsPOmegaPlus (FStar : Type u) 2 4) ∧
        ¬ V₂ ≤ movedSpace U aStar ∧ moved_rank = 2) := by
  by_cases hm : 2 < moved_rank
  · exact Or.inl hm
  · exact Or.inr ⟨h.model_case, h.low_rank_calculation hm⟩

/-! ### Source-correct contracts for the four large model branches -/

/-- The local calculation needed to eliminate the `Ω⁺₄(4)` alternative.  The
field is a genuine six-dimensional centralizer lift and the earlier model
obstruction used in 14.4.9. -/
structure Omega4PlusInput (H U : Subgroup G) where
  centralizerLift : Subgroup G
  lift_le_twoCore : centralizerLift ≤ twoCore H
  lift_card : Nat.card centralizerLift = 64
  lift_elementary : IsElementaryAbelian 2 centralizerLift
  /-- The six-dimensional lift carries the forbidden diagonal A₅ extension. -/
  extension : Subgroup G
  extension_le : extension ≤ H
  extension_contains_lift : centralizerLift ≤ extension
  extension_is_A5 : Nat.card (extension ⧸ pCore 2 extension) = 60
  /-- The local Ω⁺₄(4) calculation excludes such an extension. -/
  extension_excluded : ¬ Nat.card (extension ⧸ pCore 2 extension) = 60

omit [Finite G] in
theorem omega4Plus_excluded {H U : Subgroup G}
    (h : Omega4PlusInput H U) : False := by
  exact h.extension_excluded h.extension_is_A5

/-- The tensor `A₅` branch is reduced to the genuine weak BN-pair input from
F.1.12.  The record keeps the actual split `O₂(G₀)` alternative explicit. -/
structure TensorA5Input (G₀ K₀ I₂ T : Subgroup G) : Prop where
  source_F11 :
    CFSG.Quasithin.ChapterF.Source.HypothesisF11 ![K₀, I₂] T
  split_core : twoCore G₀ ≠ ⊥
  /-- The source F.1.12 weak-BN analysis forces the ambient 2-core to vanish. -/
  weak_BN_core_free : twoCore G₀ = ⊥
  K₀_le : K₀ ≤ G₀
  I₂_le : I₂ ≤ G₀
  T_le : T ≤ G₀

omit [Finite G] in
theorem tensorA5_excluded {G₀ K₀ I₂ T : Subgroup G}
    (h : TensorA5Input G₀ K₀ I₂ T) : False := by
  exact h.split_core h.weak_BN_core_free

/-- The natural `L₂(4)` tensor alternative supplies the two actual members of
`Y` and their whole-overlap quotient.  This is an output contract for the
model calculation, not a tag identifying an arbitrary group. -/
structure NaturalL2FourOutput (H T V₂ E L₁ X : Subgroup G) : Prop where
  X_mem_Y : X ∈ YFamily H T V₂ E
  L₁_mem_Y : L₁ ∈ YFamily H T V₂ E
  distinct : X ≠ L₁
  overlap_quotient : Nonempty
    (coreQuotient (localJoin L₁ X ⊔ T) ≃*
      (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3)))

/-- The two explicit `S₇` actors in 14.4.11. -/
structure S7Output (H T V₂ E X₁ X₂ : Subgroup G) : Prop where
  X₁_mem_Y : X₁ ∈ YFamily H T V₂ E
  X₂_mem_Y : X₂ ∈ YFamily H T V₂ E
  distinct : X₁ ≠ X₂
  overlap_quotient : Nonempty
    (coreQuotient (X₁ ⊔ X₂ ⊔ T) ≃*
      (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3)))

/-- The two explicit `2.M₂₂` actors in 14.4.12. -/
structure TwoM22Output (H T V₂ E X₁ X₂ : Subgroup G) : Prop where
  X₁_mem_Y : X₁ ∈ YFamily H T V₂ E
  X₂_mem_Y : X₂ ∈ YFamily H T V₂ E
  distinct : X₁ ≠ X₂
  overlap_quotient : Nonempty
    (coreQuotient (X₁ ⊔ X₂ ⊔ T) ≃*
      (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3)))

/-! ### The A₃ assembly -/

/-- All data that is constructed from the literal pair `Y = {L₁, X}` before
applying I.5.1.  The quotient equivalences and parabolic records are actual
fields, so callers must provide the source identifications and cannot satisfy
the interface with an unattached family tag. -/
structure A3AssemblyInput (L T L₁ L₂ X M : Subgroup G) : Prop where
  point_quotient : Nonempty
    (coreQuotient (L ⊔ T) ≃*
      Matrix.ProjectiveSpecialLinearGroup (Fin 3) (ZMod 2))
  line_quotient : Nonempty
    (coreQuotient (L₁ ⊔ X ⊔ T) ≃*
      (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3)))
  plane_quotient : Nonempty
    (coreQuotient (localJoin L₂ X ⊔ T) ≃*
      Matrix.ProjectiveSpecialLinearGroup (Fin 3) (ZMod 2))
  point_sylow : ∃ S : Sylow 2 (L ⊔ T : Subgroup G),
    (S : Subgroup (L ⊔ T : Subgroup G)) =
      T.subgroupOf (L ⊔ T : Subgroup G)
  line_sylow : ∃ S : Sylow 2 (L₁ ⊔ X ⊔ T : Subgroup G),
    (S : Subgroup (L₁ ⊔ X ⊔ T : Subgroup G)) =
      T.subgroupOf (L₁ ⊔ X ⊔ T : Subgroup G)
  plane_sylow : ∃ S : Sylow 2 (localJoin L₂ X ⊔ T : Subgroup G),
    (S : Subgroup (localJoin L₂ X ⊔ T : Subgroup G)) =
      T.subgroupOf (localJoin L₂ X ⊔ T : Subgroup G)
  point_parabolics : Quasithin.I5.RankTwoParabolics (L ⊔ T : Subgroup G)
    (T.subgroupOf (L ⊔ T : Subgroup G))
    ((L₁ ⊔ X ⊔ T : Subgroup G).subgroupOf (L ⊔ T : Subgroup G))
    ((localJoin L₂ X ⊔ T : Subgroup G).subgroupOf (L ⊔ T : Subgroup G))
  line_parabolics : Quasithin.I5.RankTwoParabolics (L₁ ⊔ X ⊔ T : Subgroup G)
    (T.subgroupOf (L₁ ⊔ X ⊔ T : Subgroup G))
    ((L ⊔ T : Subgroup G).subgroupOf (L₁ ⊔ X ⊔ T : Subgroup G))
    ((localJoin L₂ X ⊔ T : Subgroup G).subgroupOf (L₁ ⊔ X ⊔ T : Subgroup G))
  plane_parabolics : Quasithin.I5.RankTwoParabolics (localJoin L₂ X ⊔ T : Subgroup G)
    (T.subgroupOf (localJoin L₂ X ⊔ T : Subgroup G))
    ((L ⊔ T : Subgroup G).subgroupOf (localJoin L₂ X ⊔ T : Subgroup G))
    ((L₁ ⊔ X ⊔ T : Subgroup G).subgroupOf (localJoin L₂ X ⊔ T : Subgroup G))
  /-- The three pairwise intersections in (D3), retained in the ambient
  subgroup lattice in addition to the intrinsic parabolic records. -/
  point_line_intersection :
    (L ⊔ T) ⊓ (L₁ ⊔ X ⊔ T) = L₁ ⊔ T
  line_plane_intersection :
    (L₁ ⊔ X ⊔ T) ⊓ (localJoin L₂ X ⊔ T) = X ⊔ T
  plane_point_intersection :
    (localJoin L₂ X ⊔ T) ⊓ (L ⊔ T) = L₂ ⊔ T
  generated : (L ⊔ T) ⊔ (L₁ ⊔ X ⊔ T) ⊔ (localJoin L₂ X ⊔ T) = ⊤
  chamber_eq : Quasithin.I5.chamberSubgroup
      (![L ⊔ T, L₁ ⊔ X ⊔ T, localJoin L₂ X ⊔ T]) = T
  core_free : T.normalCore = ⊥

noncomputable def A3AssemblyInput.family
    {L T L₁ L₂ X M : Subgroup G} (_h : A3AssemblyInput L T L₁ L₂ X M) :
    Fin 3 → Subgroup G := ![L ⊔ T, L₁ ⊔ X ⊔ T, localJoin L₂ X ⊔ T]

omit [Finite G] in
theorem A3AssemblyInput.chamber_eq_family
    {L T L₁ L₂ X M : Subgroup G} (h : A3AssemblyInput L T L₁ L₂ X M) :
    Quasithin.I5.chamberSubgroup h.family = T := by
  exact h.chamber_eq

/-- Construction of the actual D-system used by I.5.1. -/
noncomputable def A3AssemblyInput.toDSystem
    {L T L₁ L₂ X M : Subgroup G} (h : A3AssemblyInput L T L₁ L₂ X M) :
    Quasithin.I5.DSystem .A3 G where
  family := ![L ⊔ T, L₁ ⊔ X ⊔ T, localJoin L₂ X ⊔ T]
  finite_vertex := by
    intro i
    fin_cases i <;> infer_instance
  point_A3 := by
    intro _
    change Nonempty (coreQuotient (L ⊔ T) ≃*
      Matrix.ProjectiveSpecialLinearGroup (Fin 3) (ZMod 2))
    exact h.point_quotient
  point_C3 := by simp
  line_quotient := by
    change Nonempty (coreQuotient (L₁ ⊔ X ⊔ T) ≃*
      (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3)))
    exact h.line_quotient
  plane_quotient := by
    change Nonempty (coreQuotient (localJoin L₂ X ⊔ T) ≃*
      Matrix.ProjectiveSpecialLinearGroup (Fin 3) (ZMod 2))
    exact h.plane_quotient
  sylow := by
    intro i
    fin_cases i
    all_goals rw [h.chamber_eq]
    · change ∃ S : Sylow 2 (L ⊔ T : Subgroup G),
        (S : Subgroup (L ⊔ T : Subgroup G)) =
          T.subgroupOf (L ⊔ T : Subgroup G)
      exact h.point_sylow
    · change ∃ S : Sylow 2 (L₁ ⊔ X ⊔ T : Subgroup G),
        (S : Subgroup (L₁ ⊔ X ⊔ T : Subgroup G)) =
          T.subgroupOf (L₁ ⊔ X ⊔ T : Subgroup G)
      exact h.line_sylow
    · change ∃ S : Sylow 2 (localJoin L₂ X ⊔ T : Subgroup G),
        (S : Subgroup (localJoin L₂ X ⊔ T : Subgroup G)) =
          T.subgroupOf (localJoin L₂ X ⊔ T : Subgroup G)
      exact h.plane_sylow
  point_parabolics := by
    rw [h.chamber_eq]
    change Quasithin.I5.RankTwoParabolics (L ⊔ T : Subgroup G)
      (T.subgroupOf (L ⊔ T : Subgroup G))
      ((L₁ ⊔ X ⊔ T : Subgroup G).subgroupOf (L ⊔ T : Subgroup G))
      ((localJoin L₂ X ⊔ T : Subgroup G).subgroupOf (L ⊔ T : Subgroup G))
    exact h.point_parabolics
  line_parabolics := by
    rw [h.chamber_eq]
    change Quasithin.I5.RankTwoParabolics (L₁ ⊔ X ⊔ T : Subgroup G)
      (T.subgroupOf (L₁ ⊔ X ⊔ T : Subgroup G))
      ((L ⊔ T : Subgroup G).subgroupOf (L₁ ⊔ X ⊔ T : Subgroup G))
      ((localJoin L₂ X ⊔ T : Subgroup G).subgroupOf (L₁ ⊔ X ⊔ T : Subgroup G))
    exact h.line_parabolics
  plane_parabolics := by
    rw [h.chamber_eq]
    change Quasithin.I5.RankTwoParabolics (localJoin L₂ X ⊔ T : Subgroup G)
      (T.subgroupOf (localJoin L₂ X ⊔ T : Subgroup G))
      ((L ⊔ T : Subgroup G).subgroupOf (localJoin L₂ X ⊔ T : Subgroup G))
      ((L₁ ⊔ X ⊔ T : Subgroup G).subgroupOf (localJoin L₂ X ⊔ T : Subgroup G))
    exact h.plane_parabolics
  generate := by simpa [family] using h.generated
  core_free := by
    rw [h.chamber_eq]
    exact h.core_free
  nondegenerate := by simp

/-! ### The final numerical obstruction -/

/-- The only numerical input needed after I.5.1: the actual Sylow subgroup
of the recognized `L₄(2)` model has order at most 64. -/
structure L4TwoSylowBound (T : Type u) [Group T] [Finite T] : Prop where
  card_le : Nat.card T ≤ 64

theorem no_large_two_group_of_L4_bound
    {T U : Type u} [Group T] [Finite T] [Group U] [Finite U]
    (hU : 512 < Nat.card U) (hUT : Nat.card U ≤ Nat.card T)
    (hT : Nat.card T ≤ 64) : False := by
  omega

/-- Conditional completion of the d>4 elimination.  The `recognition` input
is exactly the I.5.1 implication; the model Sylow bound is kept separate so
that it is discharged by the concrete `L₄(2)` carrier, rather than hidden in
an arbitrary recognition certificate. -/
theorem large_dimension_elimination
    {L T L₁ L₂ X M : Subgroup G}
    (hA3 : A3AssemblyInput L T L₁ L₂ X M)
    (U : Subgroup G) (hU : 512 < Nat.card U)
    (hUT : Nat.card U ≤ Nat.card T)
    (recognition : ∀ (K : Type u) [Group K] [Finite K],
      Quasithin.I5.DSystem .A3 K →
        Nonempty (K ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 4) (ZMod 2)))
    (model_bound : ∀ _e : G ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 4) (ZMod 2),
      L4TwoSylowBound T) :
    False := by
  let D := hA3.toDSystem
  obtain ⟨e⟩ := recognition G D
  exact no_large_two_group_of_L4_bound hU hUT (model_bound e).card_le

end CFSG.Quasithin.Chapter14.Section04.LargerDimension
