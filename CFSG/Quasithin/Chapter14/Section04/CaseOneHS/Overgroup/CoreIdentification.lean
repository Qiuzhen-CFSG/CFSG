module
public import CFSG.Quasithin.Chapter14.Section04.CaseOneHS.Overgroup.Core
public import Theory.GroupTheory.PCoreImage

/-!
# The original center span is O₂(L)

Transitivity on the nonzero seed vectors realizes each vector as the square
of an actual commutator in [P,L]. Since squaring on P has kernel V, these
commutators generate all of P. Relative normality of L in LT then puts P
inside L, and two-core maximality identifies P with O₂(L).

Source: Aschbacher--Smith, 14.3.33(1), printed p.1004.
-/

@[expose] public section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter14.Section04.CaseOneHS.Overgroup
open Chapter12.Section02 Chapter12.Section08 Chapter12.Section08.InvariantFlag
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}

/-- Every original seed vector is the square of a genuine L-commutator. -/
theorem seed_exists_commutator_square
    (h : HigherRankHypothesis KnownSimple.IsKnownSimple T L V 3)
    (structural : Structural1222At KnownSimple.IsKnownSimple T)
    (F : InvariantFlag T V 3) (s : LocalStructure L F)
    {v : G} (hv : v ∈ V) : ∃ c ∈ ⁅centerSpan L F, L⁆, c ^ 2 = v := by
  let := h.chosen.elementary
  let := centerSpan_abelian h structural F s
  by_cases hv1 : v = 1
  · exact ⟨1, one_mem _, by simp [hv1]⟩
  have ho : orderOf v = 2 := orderOf_eq_prime
    (elemPow_eq_one_of_isElementaryAbelian (p := 2) v hv) hv1
  have hvc : Nat.card V = 8 := by simpa [F.last] using F.card 3 (by decide)
  have hzc : Nat.card (zpowers v) = 2 := (Nat.card_zpowers v).trans ho
  have hn : ¬ V ≤ zpowers v := by
    intro hh
    have hc := card_le_of_le hh
    omega
  obtain ⟨a, ha, hav⟩ := SetLike.not_le_iff_exists.mp hn
  have ha1 : a ≠ 1 := fun he => hav (he ▸ (zpowers v).one_mem)
  have hva1 : v * a ≠ 1 := by
    intro he
    have he' : a = v⁻¹ := eq_inv_of_mul_eq_one_right he
    exact hav (he' ▸ (zpowers v).inv_mem (mem_zpowers v))
  obtain ⟨l, hl, he⟩ := h.vector_transitive ha (V.mul_mem hv ha) ha1 hva1
  obtain ⟨y, hy, hy2⟩ := seed_exists_centerSpan_square h F s ha
  have ht : l * y * l⁻¹ ∈ centerSpan L F :=
    (mem_normalizer_iff.mp (le_normalizer_conjugateSpanBy F.ZU L hl) y).mp hy
  have hc : Commute (l * y * l⁻¹) y⁻¹ := by
    exact congrArg Subtype.val (mul_comm (⟨_, ht⟩ : centerSpan L F)
      ⟨_, (centerSpan L F).inv_mem hy⟩)
  refine ⟨⁅l, y⁆, ?_, ?_⟩
  · rw [commutator_comm]
    exact commutator_mem_commutator hl hy
  · change (l * y * l⁻¹ * y⁻¹) ^ 2 = v
    rw [hc.mul_pow, ← MulAut.conj_apply, ← map_pow, hy2, MulAut.conj_apply, he,
      inv_pow, hy2, mul_inv_cancel_right]

/-- The source center span is generated by its commutators with the original L. -/
theorem centerSpan_eq_commutator
    (h : HigherRankHypothesis KnownSimple.IsKnownSimple T L V 3)
    (structural : Structural1222At KnownSimple.IsKnownSimple T)
    (alternatives : Theorem12213At KnownSimple.IsKnownSimple T)
    (F : InvariantFlag T V 3) (s : LocalStructure L F) (hne : ¬ IsMulCommutative F.U) :
    centerSpan L F = ⁅centerSpan L F, L⁆ := by
  let := centerSpan_abelian h structural F s
  let C := ⁅centerSpan L F, L⁆
  have hCP : C ≤ centerSpan L F := le_normalizer_iff_commutator_le_left.mp
    (le_normalizer_conjugateSpanBy _ _)
  have hVC : V ≤ C := by
    intro v hv
    obtain ⟨c, hc, rfl⟩ := seed_exists_commutator_square h structural F s hv
    exact C.pow_mem hc 2
  apply le_antisymm ?_ hCP
  intro x hx
  obtain ⟨c, hc, he⟩ := seed_exists_commutator_square h structural F s
    (centerSpan_square_mem_seed h structural F s hx)
  have hxc : Commute x c⁻¹ := by
    exact congrArg Subtype.val (mul_comm (⟨x, hx⟩ : centerSpan L F)
      ⟨_, (centerSpan L F).inv_mem (hCP hc)⟩)
  have hs : (x * c⁻¹) ^ 2 = 1 := by
    rw [hxc.mul_pow, inv_pow, he, mul_inv_cancel]
  have hxp := (centerSpan L F).mul_mem hx ((centerSpan L F).inv_mem (hCP hc))
  have hxV := (centerSpan_square_kernel_and_card h structural alternatives F s hne).1 _ hxp |>.mp hs
  have hm := C.mul_mem (hVC hxV) hc
  simpa only [inv_mul_cancel_right] using hm

/-- The literal center span lies in L, using relative normalization in LT. -/
theorem centerSpan_le_actor
    (h : HigherRankHypothesis KnownSimple.IsKnownSimple T L V 3)
    (structural : Structural1222At KnownSimple.IsKnownSimple T)
    (alternatives : Theorem12213At KnownSimple.IsKnownSimple T)
    (F : InvariantFlag T V 3) (s : LocalStructure L F) (hne : ¬ IsMulCommutative F.U) :
    centerSpan L F ≤ L := by
  rw [centerSpan_eq_commutator h structural alternatives F s hne]
  apply le_normalizer_iff_commutator_le_right.mp
  exact (centerSpan_le_core h structural F s).trans ((pCoreIn_le 2 _).trans
    (sup_le L.le_normalizer (h.sylow_normalizes_at structural)))

/-- Original 14.3.33(1): P=O₂(L) is precisely the L-span of Z(U). -/
theorem centerSpan_eq_core
    (h : HigherRankHypothesis KnownSimple.IsKnownSimple T L V 3)
    (structural : Structural1222At KnownSimple.IsKnownSimple T)
    (alternatives : Theorem12213At KnownSimple.IsKnownSimple T)
    (F : InvariantFlag T V 3) (s : LocalStructure L F) (hne : ¬ IsMulCommutative F.U) :
    centerSpan L F = L.pCoreIn 2 := by
  let := h.chosen.elementary
  apply le_antisymm
  · exact le_pCoreIn_of_normalizes
      ((isPGroup_pCoreIn 2 _).to_le (centerSpan_le_core h structural F s))
      (centerSpan_le_actor h structural alternatives F s hne)
      (le_normalizer_conjugateSpanBy _ _)
  · rw [centerSpan_eq_join_closure_core h structural alternatives F s hne]
    exact pCoreIn_mono_of_normalizes le_sup_left
      (sup_le L.le_normalizer ((closure_le_sylow F s).trans (h.sylow_normalizes_at structural)))

end CFSG.Quasithin.Chapter14.Section04.CaseOneHS.Overgroup
