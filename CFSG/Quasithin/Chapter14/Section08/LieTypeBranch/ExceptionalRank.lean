module

public import Theory.SpecificGroups.LieType.TheoremDRootNormalizer.SplitFamilies
public import Theory.SpecificGroups.LieType.TheoremDRootNormalizer.TwistedE6
public import CFSG.KnownSimple.ExceptionalModels
public import CFSG.Quasithin.Defs

/-!
# Direct exceptional-family exclusions for Theorem D

A quasithin group cannot be an actual F4, E6, E7, E8 or twisted E6 model over GF(2^n)
with n > 1. The proof transports the supplied model isomorphism and applies
an elementary rank-three torus inside a genuine root two-local normalizer.
These stronger quasithin-only statements apply in particular to the original
simple QTKE hypothesis with the full known-simple catalogue.

For twisted E6 the construction uses the pinned graph–field fixed group,
its subgroup generated by two-elements, and that subgroup's own center
quotient. The supplied model parameter is the fixed-field order, so the
binary exponent n equals m + 1 in the carrier `TwistedE6.Model 2 m`.

Source: Aschbacher–Smith A.2.18, printed p.40, and the higher-rank exclusions
in Theorem D/14.8.2(1), printed pp.1078–1079.
-/

public section

namespace CFSG.Quasithin.Chapter14.Section08.LieTypeBranch
universe u
variable {G : Type u} [Group G] [Finite G]

private theorem charTwo_of_card_pow_two {F : Type*} [Field F] [Finite F]
    {n : ℕ} (hn : 1 < n) (hcard : Nat.card F = 2 ^ n) : CharP F 2 := by
  let : Fintype F := Fintype.ofFinite F
  apply ringChar.of_eq
  apply FiniteField.even_card_iff_char_two.mpr
  rw [← Nat.card_eq_fintype_card, hcard]
  exact Nat.mod_eq_zero_of_dvd
    (even_iff_two_dvd.mp (even_two.pow_of_ne_zero (by omega)))

private theorem two_lt_card_of_pow_two {F : Type*} {n : ℕ}
    (hn : 1 < n) (hcard : Nat.card F = 2 ^ n) : 2 < Nat.card F := by
  rw [hcard]
  exact (by norm_num : (2 : ℕ) = 2 ^ 1) ▸ Nat.pow_lt_pow_right (by decide) hn

/-- The actual split F4 model at a field exponent greater than one is excluded
by quasithinness alone. -/
theorem not_isF4_of_quasithin (hG : IsQuasithin G) {n : ℕ} (hn : 1 < n) :
    ¬ ExceptionalGroup.IsF4 G (2 ^ n) := by
  rintro ⟨F, hF, hfin, hcard, ⟨e⟩⟩
  let : CharP F 2 := charTwo_of_card_pow_two hn hcard
  exact ExceptionalSplit.TheoremDRootNormalizer.not_quasithin_f4
    (two_lt_card_of_pow_two hn hcard) (Theory.GroupTheory.isQuasithin_of_equiv e hG)

/-- Apply the split F4 exclusion to the original simple QTKE input.
The known-simple class is unrestricted. -/
theorem not_isF4_of_isSimpleQTKE {K : GroupClass.{u}} (h : IsSimpleQTKE K G)
    {n : ℕ} (hn : 1 < n) : ¬ ExceptionalGroup.IsF4 G (2 ^ n) :=
  not_isF4_of_quasithin h.quasithin hn

/-- The actual split E6 model at a field exponent greater than one is excluded
by quasithinness alone. -/
theorem not_isE6_of_quasithin (hG : IsQuasithin G) {n : ℕ} (hn : 1 < n) :
    ¬ ExceptionalGroup.IsE6 G (2 ^ n) := by
  rintro ⟨F, hF, hfin, hcard, ⟨e⟩⟩
  let : CharP F 2 := charTwo_of_card_pow_two hn hcard
  exact ExceptionalSplit.TheoremDRootNormalizer.not_quasithin_e6
    (two_lt_card_of_pow_two hn hcard) (Theory.GroupTheory.isQuasithin_of_equiv e hG)

/-- Apply the split E6 exclusion to the original simple QTKE input.
The known-simple class is unrestricted. -/
theorem not_isE6_of_isSimpleQTKE {K : GroupClass.{u}} (h : IsSimpleQTKE K G)
    {n : ℕ} (hn : 1 < n) : ¬ ExceptionalGroup.IsE6 G (2 ^ n) :=
  not_isE6_of_quasithin h.quasithin hn

/-- The actual split E7 model at a field exponent greater than one is excluded
by quasithinness alone. -/
theorem not_isE7_of_quasithin (hG : IsQuasithin G) {n : ℕ} (hn : 1 < n) :
    ¬ ExceptionalGroup.IsE7 G (2 ^ n) := by
  rintro ⟨F, hF, hfin, hcard, ⟨e⟩⟩
  let : CharP F 2 := charTwo_of_card_pow_two hn hcard
  exact ExceptionalSplit.TheoremDRootNormalizer.not_quasithin_e7
    (two_lt_card_of_pow_two hn hcard) (Theory.GroupTheory.isQuasithin_of_equiv e hG)

/-- Apply the split E7 exclusion to the original simple QTKE input.
The known-simple class is unrestricted. -/
theorem not_isE7_of_isSimpleQTKE {K : GroupClass.{u}} (h : IsSimpleQTKE K G)
    {n : ℕ} (hn : 1 < n) : ¬ ExceptionalGroup.IsE7 G (2 ^ n) :=
  not_isE7_of_quasithin h.quasithin hn

/-- The actual split E8 model at a field exponent greater than one is excluded
by quasithinness alone. -/
theorem not_isE8_of_quasithin (hG : IsQuasithin G) {n : ℕ} (hn : 1 < n) :
    ¬ ExceptionalGroup.IsE8 G (2 ^ n) := by
  rintro ⟨F, hF, hfin, hcard, ⟨e⟩⟩
  let : CharP F 2 := charTwo_of_card_pow_two hn hcard
  exact ExceptionalSplit.TheoremDRootNormalizer.not_quasithin_e8
    (two_lt_card_of_pow_two hn hcard) (Theory.GroupTheory.isQuasithin_of_equiv e hG)

/-- Apply the split E8 exclusion to the original simple QTKE input.
The known-simple class is unrestricted. -/
theorem not_isE8_of_isSimpleQTKE {K : GroupClass.{u}} (h : IsSimpleQTKE K G)
    {n : ℕ} (hn : 1 < n) : ¬ ExceptionalGroup.IsE8 G (2 ^ n) :=
  not_isE8_of_quasithin h.quasithin hn

/-- The genuine pinned twisted E6 model at a fixed-field exponent greater
than one is excluded by quasithinness alone. -/
theorem not_isTwistedE6_of_quasithin (hG : IsQuasithin G) {n : ℕ} (hn : 1 < n) :
    ¬ ExceptionalGroup.IsTwistedE6 G (2 ^ n) := by
  rintro ⟨p, m, hp, hq, ⟨e⟩⟩
  change p ^ (m + 1) = 2 ^ n at hq
  have hp2 : p = 2 := (Nat.prime_dvd_prime_iff_eq hp.out Nat.prime_two).mp
    (hp.out.dvd_of_dvd_pow (hq ▸ dvd_pow_self p (Nat.succ_ne_zero m)))
  subst p
  have hmn : m + 1 = n := Nat.pow_right_injective (by decide : 2 ≤ 2) hq
  exact TwistedE6.TheoremDRootNormalizer.not_quasithin m (by omega)
    (Theory.GroupTheory.isQuasithin_of_equiv e hG)

/-- Apply the genuine twisted E6 exclusion to the original simple QTKE input.
The known-simple class is unrestricted. -/
theorem not_isTwistedE6_of_isSimpleQTKE {K : GroupClass.{u}} (h : IsSimpleQTKE K G)
    {n : ℕ} (hn : 1 < n) : ¬ ExceptionalGroup.IsTwistedE6 G (2 ^ n) :=
  not_isTwistedE6_of_quasithin h.quasithin hn

end CFSG.Quasithin.Chapter14.Section08.LieTypeBranch
