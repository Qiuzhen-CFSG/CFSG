module

public import CFSG.Quasithin.Chapter14.Section01.SourcePreliminaries.ResidualSplitting.InvertedLift
public import CFSG.Quasithin.Chapter14.Section01.SourcePreliminaries.ResidualSplitting.QuotientData
public import CFSG.Quasithin.Chapter14.Section01.SourcePreliminaries.ResidualSplitting.NormalClosureSplitting
public import CFSG.Quasithin.Chapter14.Section01.SourcePreliminaries.ResidualSplitting.ResidualIdentification

/-!
# Residual splitting calculations for Lemma 14.1.18

This module assembles the finite-group conclusions of parts (3) and (5) for
`sourceResidual M Mc = O²(⟨O₂(M ∩ Mc)^M⟩)`. The inputs are the actual S₃
centralizer quotient, noncentrality of the intersection core, its intersection
with the centralizer being `O₂(M)`, and the preceding commutator bound.

Modulo `O₂(M)`, the intersection core is generated by a reflection centralizing
the action kernel. Its normal closure is therefore the internal S₃ factor.
Residual functoriality identifies the residual image with the order-three
subgroup and identifies `O₂(Y)` with `C_Y(V)`. The isomorphism of the ambient
star quotient with S₃ times `C_M(V)/O₂(M)` and an actual inverted order-three
lift are included. This route proves the splitting without needing the
additional odd-central bound in 14.1.17(3).

The remaining rank assertion in part (5) belongs to the preceding local-control
input, 14.1.17(4), owned by `SourcePreliminaries`: a nonidentity element of
`Rc*` acting faithfully on `O₃(M*)` forces `m₃(C_M(V)) ≤ 1`. The normal C₃
factor and the reflection supplied here give that nontrivial action. The
quasithin hypothesis needed for this rank lemma is essential: the abstract
splitting inputs alone allow `S₃ × C₃^k` with unbounded centralizer 3-rank.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
manuscript (1 March 2004), printed pp.980–981, Lemmas 14.1.17–18.
-/

open Subgroup Stellmacher
namespace CFSG.Quasithin.Chapter14.SourcePreliminaries

/-- The source residual centralizes `C_M(V)` modulo the actual two-core of `M`. -/
public theorem sourceResidual_commutator_le_twoCore
    {G : Type*} [Group G] (M Mc V : Subgroup G)
    [((centralizer (V : Set G)).subgroupOf M).Normal]
    (hcomm : ⁅M ⊓ centralizer (V : Set G), (M ⊓ Mc).pCoreIn 2⁆ ≤ M.pCoreIn 2) :
    ⁅M ⊓ centralizer (V : Set G), sourceResidual M Mc⁆ ≤ M.pCoreIn 2 := by
  let C := (centralizer (V : Set G)).subgroupOf M
  let D := ((M ⊓ Mc).pCoreIn 2).subgroupOf M
  have hDM : (M ⊓ Mc).pCoreIn 2 ≤ M := (pCoreIn_le 2 _).trans inf_le_left
  have hC : C.map M.subtype = M ⊓ centralizer (V : Set G) := by
    rw [subgroupOf_map_subtype, inf_comm]
  have hD : D.map M.subtype = (M ⊓ Mc).pCoreIn 2 := map_subgroupOf_eq_of_le hDM
  have hc : ⁅C, D⁆ ≤ pCore 2 M := by
    intro x hx
    have hh : (x : G) ∈ M.pCoreIn 2 := hcomm (by
      rw [← hC, ← hD, ← map_commutator]
      exact mem_map_of_mem M.subtype hx)
    obtain ⟨y, hy, he⟩ := hh
    exact M.subtype_injective he ▸ hy
  have hres : ⁅C, twoResidualAmbient (normalClosure (D : Set M))⁆ ≤ pCore 2 M :=
    (commutator_mono le_rfl (map_subtype_le _)).trans
      (commutator_normalClosure_le_of_normal C D (pCore 2 M) hc)
  have hh := map_mono (f := M.subtype) hres
  rwa [map_commutator, hC] at hh
/-- Translate the preceding source inputs into the actual S₃ action on `M`. -/
public theorem source_quotient_inputs
    {G : Type*} [Group G] [Finite G] (M Mc V : Subgroup G)
    [((centralizer (V : Set G)).subgroupOf M).Normal]
    (e : (M ⧸ (centralizer (V : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hmeet : (M ⊓ Mc).pCoreIn 2 ⊓ centralizer (V : Set G) = M.pCoreIn 2)
    (hne : ¬ (M ⊓ Mc).pCoreIn 2 ≤ centralizer (V : Set G))
    (hcomm : ⁅M ⊓ centralizer (V : Set G), (M ⊓ Mc).pCoreIn 2⁆ ≤ M.pCoreIn 2) :
    ∃ f : M →* Equiv.Perm (Fin 3), Function.Surjective f ∧
      f.ker = (centralizer (V : Set G)).subgroupOf M ∧
      let D := ((M ⊓ Mc).pCoreIn 2).subgroupOf M
      IsPGroup 2 D ∧ ¬ D ≤ f.ker ∧ D ⊓ f.ker = pCore 2 M ∧
        ⁅f.ker, D⁆ ≤ pCore 2 M := by
  let C := (centralizer (V : Set G)).subgroupOf M
  let D := ((M ⊓ Mc).pCoreIn 2).subgroupOf M
  let f := e.toMonoidHom.comp (QuotientGroup.mk' C)
  have hf : Function.Surjective f := e.surjective.comp (QuotientGroup.mk'_surjective C)
  have hker : f.ker = C := by
    ext x
    change e (QuotientGroup.mk x) = 1 ↔ x ∈ C
    rw [← e.map_one, e.injective.eq_iff, QuotientGroup.eq_one_iff]
  have hDM : (M ⊓ Mc).pCoreIn 2 ≤ M := (pCoreIn_le 2 _).trans inf_le_left
  have hC : C.map M.subtype = M ⊓ centralizer (V : Set G) := by
    rw [subgroupOf_map_subtype, inf_comm]
  have hD : D.map M.subtype = (M ⊓ Mc).pCoreIn 2 := map_subgroupOf_eq_of_le hDM
  refine ⟨f, hf, hker, (isPGroup_pCoreIn 2 (M ⊓ Mc)).comap_subtype, ?_, ?_, ?_⟩
  · rw [hker]
    intro hh
    apply hne
    intro x hx
    exact hh (show (⟨x, hDM hx⟩ : M) ∈ D from hx)
  · apply map_injective M.subtype_injective
    rw [Subgroup.map_inf _ _ _ M.subtype_injective, hker, hD, hC,
      ← inf_assoc, inf_eq_left.mpr hDM]
    exact hmeet
  · apply (map_le_map_iff_of_injective M.subtype_injective).mp
    rw [map_commutator, hker, hC, hD]
    exact hcomm


private theorem quotient_normalClosure_splitting
    {H : Type*} [Group H] [Finite H]
    (f : H →* Equiv.Perm (Fin 3)) (hf : Function.Surjective f)
    (D Q : Subgroup H) [Q.Normal] (hQker : Q ≤ f.ker)
    (hD : IsPGroup 2 D) (hne : ¬ D ≤ f.ker)
    (hmeet : D ⊓ f.ker = Q) (hcomm : ⁅f.ker, D⁆ ≤ Q) :
    let q := QuotientGroup.mk' Q
    let fs := QuotientGroup.lift Q f hQker
    let Ns := (normalClosure (D : Set H)).map q
    Function.Bijective (fs.domRestrict Ns) ∧
      Ns ⊔ f.ker.map q = ⊤ ∧ Disjoint Ns (f.ker.map q) ∧
      ⁅Ns, f.ker.map q⁆ = ⊥ ∧
      Nonempty ((H ⧸ Q) ≃* Equiv.Perm (Fin 3) × (f.ker.map q)) := by
  obtain ⟨hfs, w, hwD, hwo, hfw, hc⟩ :=
    quotient_reflection_data f hf D Q hQker hD hne hmeet hcomm
  have hn : (normalClosure (D : Set H)).map (QuotientGroup.mk' Q) =
      normalClosure (zpowers w : Set (H ⧸ Q)) := by
    rw [map_normalClosure _ _ (QuotientGroup.mk'_surjective Q), ← coe_map, hwD]
  have hw : w ^ 2 = 1 := hwo ▸ pow_orderOf_eq_one w
  obtain ⟨hb, hs, hd, hc, e, _⟩ := normalClosure_s3_splitting
    (QuotientGroup.lift Q f hQker) hfs w hw hfw hc
  dsimp only
  rw [hn, ← QuotientGroup.ker_lift Q f hQker]
  exact ⟨hb, hs, hd, hc, ⟨e⟩⟩

private noncomputable def subgroupQuotientMapEquiv
    {H : Type*} [Group H] (C Q : Subgroup H) [Q.Normal] :
    (C ⧸ Q.subgroupOf C) ≃* C.map (QuotientGroup.mk' Q) := by
  let f := (QuotientGroup.mk' Q).domRestrict C
  have hk : f.ker = Q.subgroupOf C := by
    ext x
    exact QuotientGroup.eq_one_iff (x : H)
  exact (QuotientGroup.quotientMulEquivOfEq hk.symm).trans
    ((QuotientGroup.quotientKerEquivRange f).trans
      (MulEquiv.subgroupCongr (MonoidHom.domRestrict_range _ _)))

private theorem map_pCoreIn_injective
    {H K : Type*} [Group H] [Group K] (p : ℕ)
    (f : H →* K) (hf : Function.Injective f) (Y : Subgroup H) :
    (Y.pCoreIn p).map f = (Y.map f).pCoreIn p := by
  let e := Y.equivMapOfInjective f hf
  rw [pCoreIn, pCoreIn, ← pCore_map_iso p e, map_map, map_map]
  rfl


/-- The finite-group conclusions of 14.1.18(3),(5) for the actual source residual.
The bar image is the two-residual of the action quotient, both bar and star
images are cyclic of order three, and the two-core is the centralizer in `Y`.
The subgroup `B = Y* Rc*` is the internal S₃ factor, with the star centralizer
as its commuting direct complement. Finally, an element of the actual
intersection core inverts an order-three element of `Y` with faithful bar image.
The separate quasithin rank input from 14.1.17(4) is not asserted here. -/
public theorem sourceResidual_splitting
    {G : Type*} [Group G] [Finite G] (M Mc V : Subgroup G)
    [((centralizer (V : Set G)).subgroupOf M).Normal]
    (e : (M ⧸ (centralizer (V : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hmeet : (M ⊓ Mc).pCoreIn 2 ⊓ centralizer (V : Set G) = M.pCoreIn 2)
    (hne : ¬ (M ⊓ Mc).pCoreIn 2 ≤ centralizer (V : Set G))
    (hcomm : ⁅M ⊓ centralizer (V : Set G), (M ⊓ Mc).pCoreIn 2⁆ ≤ M.pCoreIn 2) :
    let C := (centralizer (V : Set G)).subgroupOf M
    let D := ((M ⊓ Mc).pCoreIn 2).subgroupOf M
    let Y := (sourceResidual M Mc).subgroupOf M
    let q := QuotientGroup.mk' (pCore 2 M)
    let B := Y.map q ⊔ D.map q
    Y.map (QuotientGroup.mk' C) = twoResidualAmbient (⊤ : Subgroup (M ⧸ C)) ∧
      Nat.card (Y.map q) = 3 ∧
      Nonempty ((Y.map q) ≃* Multiplicative (ZMod 3)) ∧
      Nonempty ((Y.map (QuotientGroup.mk' C)) ≃* Multiplicative (ZMod 3)) ∧
      (sourceResidual M Mc).pCoreIn 2 = sourceResidual M Mc ⊓ centralizer (V : Set G) ∧
      Nonempty (B ≃* Equiv.Perm (Fin 3)) ∧
      B ⊔ C.map q = ⊤ ∧ Disjoint B (C.map q) ∧ ⁅B, C.map q⁆ = ⊥ ∧
      Nonempty ((M ⧸ pCore 2 M) ≃*
        Equiv.Perm (Fin 3) × (C ⧸ (pCore 2 M).subgroupOf C)) ∧
      ∃ r y : M, r ∈ D ∧ (y : G) ∈ sourceResidual M Mc ∧
        orderOf (y : G) = 3 ∧ orderOf (QuotientGroup.mk' C y) = 3 ∧
        (r : G) * (y : G) * (r : G)⁻¹ = (y : G)⁻¹ := by
  classical
  let C := (centralizer (V : Set G)).subgroupOf M
  let D := ((M ⊓ Mc).pCoreIn 2).subgroupOf M
  let Q := pCore 2 M
  let N := normalClosure (D : Set M)
  let Y := twoResidualAmbient N
  let q := QuotientGroup.mk' Q
  have hY : (sourceResidual M Mc).subgroupOf M = Y := by
    change (Y.map M.subtype).comap M.subtype = Y
    rw [comap_map_eq, M.ker_subtype, sup_bot_eq]
  obtain ⟨f, hf, hker, hD, hneD, hmeetD, hcommD⟩ :=
    source_quotient_inputs M Mc V e hmeet hne hcomm
  have hQker : Q ≤ f.ker := by
    change pCore 2 M ≤ f.ker
    rw [← hmeetD]
    exact inf_le_right
  obtain ⟨hb, hs, hd, hc, he⟩ :=
    quotient_normalClosure_splitting f hf D Q hQker hD hneD hmeetD hcommD
  have hjoin : Y.map q ⊔ D.map q = N.map q :=
    residual_quotient_sup_reflection f N D Q hQker le_normalClosure hD hneD hb
  have hcore : (sourceResidual M Mc).pCoreIn 2 =
      sourceResidual M Mc ⊓ centralizer (V : Set G) := by
    have hh := congrArg (Subgroup.map M.subtype)
      (residual_two_core_eq f N Q hQker pCore_isPGroup hb)
    rw [map_pCoreIn_injective 2 M.subtype M.subtype_injective,
      Subgroup.map_inf _ _ _ M.subtype_injective, hker, subgroupOf_map_subtype] at hh
    change (sourceResidual M Mc).pCoreIn 2 =
      sourceResidual M Mc ⊓ (centralizer (V : Set G) ⊓ M) at hh
    rw [inf_comm (centralizer (V : Set G)) M, ← inf_assoc,
      inf_eq_left.mpr (sourceResidual_le M Mc)] at hh
    exact hh
  let b : (M ⧸ C) ≃* Equiv.Perm (Fin 3) :=
    (QuotientGroup.quotientMulEquivOfEq hker.symm).trans
      (QuotientGroup.quotientKerEquivOfSurjective f hf)
  have hbcomp : b.toMonoidHom.comp (QuotientGroup.mk' C) = f := by
    ext x
    rfl
  have hNbar : N.map (QuotientGroup.mk' C) = ⊤ := by
    apply map_injective (f := b.toMonoidHom) b.injective
    rw [map_map, hbcomp, map_top_of_surjective _ b.surjective]
    have hh := MonoidHom.range_eq_top.mpr hb.2
    rw [MonoidHom.domRestrict_range, map_map, QuotientGroup.lift_comp_mk'] at hh
    exact hh
  have hresbar : Y.map (QuotientGroup.mk' C) =
      twoResidualAmbient (⊤ : Subgroup (M ⧸ C)) :=
    map_twoResidualAmbient_of_subgroup_image N (QuotientGroup.mk' C) ⊤ hNbar
  have hbar : (Y.map (QuotientGroup.mk' C)).map b.toMonoidHom =
      alternatingGroup (Fin 3) := by
    rw [map_map, hbcomp]
    exact residual_image_of_quotient_bijective f N Q hQker hb
  have hbarcard : Nat.card (Y.map (QuotientGroup.mk' C)) = 3 := by
    rw [Nat.card_congr ((Y.map (QuotientGroup.mk' C)).equivMapOfInjective
      b.toMonoidHom b.injective).toEquiv, hbar, nat_card_alternatingGroup]
    norm_num
  have hprod : Nonempty ((M ⧸ Q) ≃*
      Equiv.Perm (Fin 3) × (C ⧸ Q.subgroupOf C)) := by
    obtain ⟨es⟩ := he
    have hk : f.ker.map q = C.map q := congrArg (Subgroup.map q) hker
    exact ⟨es.trans (MulEquiv.prodCongr (MulEquiv.refl _)
      ((MulEquiv.subgroupCongr hk).trans (subgroupQuotientMapEquiv C Q).symm))⟩
  dsimp only
  rw [hY]
  refine ⟨hresbar, residual_quotient_card f N Q hQker hb,
    ⟨residualQuotientCyclicEquiv f N Q hQker hb⟩,
    ⟨mulEquivOfPrimeCardEq hbarcard (by simp)⟩, hcore, ?_, ?_, ?_, ?_, hprod, ?_⟩
  · rw [hjoin]
    exact ⟨MulEquiv.ofBijective _ hb⟩
  · change (Y.map q ⊔ D.map q) ⊔ C.map q = ⊤
    rw [hjoin]
    simpa only [hker] using hs
  · change Disjoint (Y.map q ⊔ D.map q) (C.map q)
    rw [hjoin]
    simpa only [hker] using hd
  · change ⁅Y.map q ⊔ D.map q, C.map q⁆ = ⊥
    rw [hjoin]
    simpa only [hker] using hc
  · obtain ⟨r, hr, y, hy, hyo, hfyo, hinv⟩ :=
      residual_normalClosure_inverted_three_lift f D Q hQker pCore_isPGroup hD hneD hmeetD hb
    refine ⟨r, y, hr, mem_map_of_mem M.subtype hy, ?_, ?_, congrArg M.subtype hinv⟩
    · exact (orderOf_injective M.subtype M.subtype_injective y).trans hyo
    · have hh := orderOf_injective b.toMonoidHom b.injective (QuotientGroup.mk' C y)
      exact hh.symm.trans hfyo

end CFSG.Quasithin.Chapter14.SourcePreliminaries
