module

public import Theory.GroupTheory.TwoLocalCoreObstruction

/-!
# Local-overgroup reductions for the `L₂(2)` case

These are the elementary overgroup steps in Aschbacher–Smith, *The Classification
of Quasithin Groups*, combined manuscript of 1 March 2004, §14.2, printed
pp. 981–989. The section continues onto p. 989 through Lemma 14.2.22.

Lemma 14.2.2(5) leaves only `M` and `Mc` above `T`. A subgroup above `T` and
outside `M`, with nontrivial two-core, therefore has `Mc` as its unique maximal
two-local overgroup. This is the overgroup argument in Lemma 14.2.3. The
uniqueness in Lemma 14.2.2(3) also forces the group generated by `H` and `Y T`
to have trivial two-core, as required for the solvable-case amalgam on p. 988.

The earlier section's conclusions are explicit inputs here. These reductions
do not assert the classification Theorems 14.2.7 or 14.2.20.
-/

namespace CFSG.Quasithin.Chapter14.Section02

/-- The overgroup step in Lemma 14.2.3, from Lemma 14.2.2(5).
The nontrivial core ensures that the set of overgroups of `H` is nonempty. -/
public theorem unique_overgroup_of_two_maximalTwoLocals
    {G : Type*} [Group G] [Finite G] (T H M Mc : Subgroup G)
    (hpair : {K : Subgroup G | IsMaximalTwoLocal K ∧ T ≤ K} = {M, Mc})
    (hTH : T ≤ H) (hHM : ¬ H ≤ M) (hcore : pCore 2 H ≠ ⊥) :
    {K : Subgroup G | IsMaximalTwoLocal K ∧ H ≤ K} = {Mc} := by
  have only (K : Subgroup G) (hK : IsMaximalTwoLocal K) (hHK : H ≤ K) : K = Mc := by
    have hmem : K ∈ ({M, Mc} : Set (Subgroup G)) := hpair ▸ ⟨hK, hTH.trans hHK⟩
    rcases Set.mem_insert_iff.mp hmem with hKM | hKMc
    · exact (hHM (hKM ▸ hHK)).elim
    · exact Set.mem_singleton_iff.mp hKMc
  obtain ⟨K, hK, hHK⟩ :=
    Theory.GroupTheory.exists_maximalTwoLocal_overgroup_of_twoCore_ne_bot H hcore
  have hKMc := only K hK hHK
  subst K
  ext L
  constructor
  · exact fun hL => Set.mem_singleton_iff.mpr (only L hL.1 hL.2)
  · intro hL
    have hLMc := Set.mem_singleton_iff.mp hL
    subst L
    exact ⟨hK, hHK⟩

/-- The trivial two-core needed before Lemma 14.2.21, from the uniqueness
conclusion of Lemma 14.2.2(3). The join represents the generated subgroup,
and agrees with `Y T` when `T` normalizes `Y`. -/
public theorem solvable_amalgam_twoCore_eq_bot
    {G : Type*} [Group G] [Finite G] (H Y T M : Subgroup G)
    (hunique : {K : Subgroup G | IsMaximalTwoLocal K ∧ Y ⊔ T ≤ K} = {M})
    (hHM : ¬ H ≤ M) : pCore 2 (H ⊔ (Y ⊔ T) : Subgroup G) = ⊥ := by
  rw [sup_comm H]
  apply Theory.GroupTheory.twoCore_sup_eq_bot_of_unique_maximalTwoLocal_overgroup
    (Y ⊔ T) H M ?_ hHM
  intro K hK hYT
  exact Set.mem_singleton_iff.mp (hunique ▸ ⟨hK, hYT⟩)

end CFSG.Quasithin.Chapter14.Section02
