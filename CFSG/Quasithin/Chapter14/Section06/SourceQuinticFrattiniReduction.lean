module
public import CFSG.Quasithin.Chapter14.Section06.SourceQuinticDerivedReduction
public import Theory.Frattini.FiniteConjugateSpan
public import Theory.Frattini.PGroupMap
public import Theory.Frattini.SquareCover

/-!
# The original quintic Frattini reduction with its full kernel

The actual supplement is generated by conjugates of the elementary middle
span, so its squares lie in its derived subgroup. The derived-core reduction
and the remaining kernel squares give Phi(Q) = U join Phi(C), with both
Frattini subgroups embedded by their original subtype maps.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter14.Section06
open SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
variable {G : Type*} [Group G] [Finite G]

/-- The exact Frattini reduction retains the literal full centralizer kernel. -/
theorem source_quintic_core_frattini_reduction
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hu : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (H : Subgroup G) (hH : H ∈ Chapter3.HStar (T : Subgroup G) M)
    (hi : (T : Subgroup G).relIndex H = 5) :
    let U := conjugateSpanBy (localModule T M) H
    let Q := H.pCoreIn 2
    let C := H ⊓ centralizer (U : Set G)
    (frattini Q).map Q.subtype = U ⊔ (frattini C).map C.subtype := by
  classical
  let X := sourceResidual M Mc ⊔ (T : Subgroup G)
  let U := conjugateSpanBy (localModule T M) H
  let Q := H.pCoreIn 2
  let C := H ⊓ centralizer (U : Set G)
  let P := (frattini C).map C.subtype
  let D := U ⊔ P
  obtain ⟨g,hg,hWel,hWQ,hXW,hWU,hWUstar,hR,hRstar,hWcard,
      hcomm,hfixed,hWC,hWQcomm,hWnotC,hJQ,hHJ,hJC⟩ :=
    source_quintic_exact_span_full_core_supplement
      hG T hempty hM hu hmany hcard e H hH hi
  let R := U ⊓ Q.map (MulAut.conj g).toMonoidHom
  let W := conjugateSpanBy R X
  let J := conjugateSpanBy W H
  let : IsElementaryAbelian 2 W := hWel
  have hpQ : IsPGroup 2 Q := isPGroup_pCoreIn 2 H
  have hCQ : C ≤ Q := source_quintic_span_centralizer_le_core hG T hM H hH hi
  let : Fact (IsPGroup 2 Q) := ⟨hpQ⟩
  let : Fact (IsPGroup 2 C) := ⟨hpQ.to_le hCQ⟩
  let : Fact (IsPGroup 2 J) := ⟨hpQ.to_le hJQ⟩
  have hderC : ⁅C,C⁆ ≤ P := by
    have hh := map_mono (f := C.subtype)
      (commutator_le_frattini_of_isPGroup (p := 2) (R := C))
    rwa [map_subtype_commutator] at hh
  have hderQ : ⁅Q,Q⁆ ≤ D := by
    rw [source_quintic_core_derived_reduction hG T hempty hM hu hmany hcard e H hH hi]
    exact sup_le_sup_left hderC U
  have hphiJ : (frattini J).map J.subtype ≤ D :=
    finite_conjugateSpan_frattini_le W H D (hpQ.to_le hJQ)
      ((commutator_mono hJQ hJQ).trans hderQ)
  have hupper : (frattini Q).map Q.subtype ≤ D := by
    apply frattini_image_le_of_square_cover Q J C D hpQ hJC hderQ
    · intro x hx
      exact hphiJ (mem_map_of_mem J.subtype
        (pth_power_mem_frattini_of_isPGroup (p := 2) (⟨x,hx⟩ : J)))
    · intro x hx
      exact (show P ≤ D from le_sup_right) (mem_map_of_mem C.subtype
        (pth_power_mem_frattini_of_isPGroup (p := 2) (⟨x,hx⟩ : C)))
  have hQderPhi : ⁅Q,Q⁆ ≤ (frattini Q).map Q.subtype := by
    have hh := map_mono (f := Q.subtype)
      (commutator_le_frattini_of_isPGroup (p := 2) (R := Q))
    rwa [map_subtype_commutator] at hh
  have hUPhi : U ≤ (frattini Q).map Q.subtype :=
    (source_quintic_core_derived_contains_span hG T hempty hM hu hmany hcard e H hH hi).trans hQderPhi
  have hPPhi : P ≤ (frattini Q).map Q.subtype := by
    have hh := map_mono (f := Q.subtype)
      (frattini_map_le_of_isPGroup (p := 2) (inclusion hCQ))
    simpa only [map_map,subtype_comp_inclusion] using hh
  exact le_antisymm hupper (sup_le hUPhi hPPhi)

end CFSG.Quasithin.Chapter14.Section06
