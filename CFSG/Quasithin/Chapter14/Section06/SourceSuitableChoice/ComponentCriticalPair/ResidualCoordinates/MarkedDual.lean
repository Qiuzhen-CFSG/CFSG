module
public import CFSG.Quasithin.Chapter14.Section06.SourceSuitableChoice.ComponentCriticalPair.ResidualCoordinates
public import Theory.Representation.PSL3Two.DualResidualPlane

/-!
# Residual coordinates from the marked binary dual action

The literal point-centralizer action on B/Z identifies its two-residual
image with the checked binary point residual. Its annihilator plane has
order four and is generated by the commutators of the actual nonzero seed
vector. The source 14.6.2 lift therefore constructs the moving eight-group
and the independent fixed factor a=u*c. Rank four and escape from M are
applications, not premises. The full-action marking and seed projections
remain explicit here for the preceding source-module producer.

Source: Aschbacher--Smith,14.6.20--24 and printed p.1042.
-/

public section
open Subgroup Theory.GroupTheory
open scoped commutatorElement
namespace CFSG.Quasithin.Chapter14.Section06.ComponentCriticalPair
open SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
variable {G : Type*} [Group G] [Finite G]

theorem source_residual_span_of_marked_dual
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hunique : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hab : IsMulCommutative (conjugateSpanBy (localModule T M) Mc))
    (A B C : Subgroup G)
    (hAU : A ≤ conjugateSpanBy (localModule T M) Mc)
    (hBU : B ≤ conjugateSpanBy (localModule T M) Mc)
    (hCU : C ≤ conjugateSpanBy (localModule T M) Mc)
    (hsep : A ⊓ (B ⊔ C) ≤ centralInvolutions T)
    (hfixed : ∀ x ∈ Mc, ∀ c ∈ C, ⁅c,x⁆ ∈ centralInvolutions T)
    (u b c v : G) (huA : u ∈ A) (hb : b ∈ B) (hc : c ∈ C)
    (hv : v ∈ localModule T M) (hvZ : v ∉ centralInvolutions T)
    (hseed : v * (u * b * c)⁻¹ ∈ centralInvolutions T)
 :
    let h := ComponentSupports.terminal_hypothesis hG T hempty hM hunique hmany hcard e hab
    let P := h.kernel (zpowers u)
    let R := (pResidual 2 P).map P.subtype
    ComponentSupports.Suitable h Mc u →
    R ≤ ChapterA.Section04.twoGeneralizedFittingPreimage Mc →
    ∀ (f : P →* Matrix.PSL3Two.SL), f.range = Matrix.PSL3Two.pointParabolicSL →
    ∀ d : Representation.BinaryConjugationSection P B (centralInvolutions T)
      (Matrix.PSL3Two.MarkedAutomorphisms.AffineConstituents.fullDual.comp f),
    (d.coordinates ⟨b,hb⟩).toAdd 0 = 0 → d.coordinates ⟨b,hb⟩ ≠ 1 →
    ∃ coords : SourceResidualSpanCoordinates (localModule T M) (centralInvolutions T) R,
      coords.W = ⁅B,R⁆ ∧ coords.a = u*c ∧ coords.b = b ∧
      primeRank 2 (conjugateSpanBy (localModule T M) R) = 4 ∧ ¬R ≤ M := by
  dsimp only
  intro hu hRF f hf d hbplane hbzero
  have hi := Matrix.PSL3Two.MarkedAutomorphisms.AffineConstituents.dual_section_image f hf d
  apply source_residual_span_of_dual_images hG T hempty hM hunique hmany hcard e hab
    A B C hAU hBU hCU hsep hfixed u b c v huA hb hc hv hvZ hseed
    d.coordinates d.kernel_eq hu d.normalized hRF
  · change Nat.card (d.imageSpace _) = 4
    rw [hi]
    exact Matrix.PSL3Two.MarkedAutomorphisms.AffineConstituents.dual_plane_card
  · change (d.coordinates ⟨b,hb⟩).toAdd ∈ d.imageSpace _
    rw [hi]
    exact hbplane
  · exact Matrix.PSL3Two.MarkedAutomorphisms.AffineConstituents.dual_section_seed_generates
      f hf d ⟨b,hb⟩ hbplane hbzero

end CFSG.Quasithin.Chapter14.Section06.ComponentCriticalPair
