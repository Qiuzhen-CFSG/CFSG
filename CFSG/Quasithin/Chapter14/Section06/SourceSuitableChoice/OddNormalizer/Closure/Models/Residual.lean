module
public import CFSG.Quasithin.Chapter14.Section06.SourceSuitableChoice.OddNormalizer.Closure.Models.Orbit
public import Theory.GroupTheory.PResidual.PrimeToPerfect

/-!
# The remaining index in the prime-to-p residual identification

The primitive two-perfect subgroup is generated by p-elements: its two-core
quotient is a p-group. Functoriality and normality place its entire Mc-closure
in the embedded prime-to-p residual. Thus coprimality of the closure's relative
index is the only remaining premise for equality with O^{p′}(Mc).

The source application keeps the original H, prime, and quotient. The model
and rank arguments establishing this coprimality are separate; no such index
claim or full layer identification is asserted here.
Source: Aschbacher--Smith, proof of 14.6.14, printed p.1033.
-/

public section
open Subgroup Theory.GroupTheory Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter14.Section06.OddNormalizer
open Chapter1 Chapter1.XiEmbedding
open SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
open Chapter15.Section03.AbelianAmalgam
open Chapter15.Section03.AbelianAmalgam.GenerationOne
variable {G : Type*} [Group G] [Finite G]

/-- The two-perfect primitive subgroup and its normal closure lie in the
prime-to-p residual of the actual overgroup. -/
theorem localInput_closure_le_primeToResidual
    {p : ℕ} {T X P J : Subgroup G} (h : LocalInput p T X P J) :
    conjugateSpanBy X J ≤ (primeToResidual p J).map J.subtype := by
  let : Fact p.Prime := ⟨h.prime⟩
  have hx : primeToResidual p X = ⊤ :=
    primeToResidual_eq_top_of_pGroup_quotient p 2 (pCore 2 X)
      pCore_isPGroup h.quotient.isPGroup h.perfect
  have hle := embedded_primeToResidual_mono p (le_sup_left.trans h.overgroup)
  rw [hx, ← MonoidHom.range_eq_map, range_subtype] at hle
  apply conjugateSpanBy_le hle
  apply (normal_subgroupOf_iff_le_normalizer (map_subtype_le _)).mp
  rw [subgroupOf, comap_map_eq_self_of_injective J.subtype_injective]
  infer_instance

/-- Source O^{p′} equality reduces to the literal relative index being prime
 to p; the generated-by-p-elements direction is discharged above. -/
theorem localInput_closure_eq_primeToResidual_of_coprime_index
    {p : ℕ} {T X P J : Subgroup G} (h : LocalInput p T X P J)
    (hi : Nat.Coprime p ((conjugateSpanBy X J).relIndex J)) :
    conjugateSpanBy X J = (primeToResidual p J).map J.subtype := by
  apply le_antisymm (localInput_closure_le_primeToResidual h)
  have hXJ : X ≤ J := le_sup_left.trans h.overgroup
  have hKJ : conjugateSpanBy X J ≤ J := conjugateSpanBy_le_self hXJ
  let : ((conjugateSpanBy X J).subgroupOf J).Normal :=
    (normal_subgroupOf_iff_le_normalizer hKJ).mpr (le_normalizer_conjugateSpanBy X J)
  have he := map_mono (f := J.subtype)
    (primeToResidual_le ((conjugateSpanBy X J).subgroupOf J) hi)
  rwa [map_subgroupOf_eq_of_le hKJ] at he

variable (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hunique : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hab : IsMulCommutative (conjugateSpanBy (localModule T M) Mc))
    (H : Subgroup G) (hH : H ∈ Chapter1.HOutside G (T : Set G) (M : Set G))
    [IsElementaryAbelian 2 (conjugateSpanBy (localModule T M) H)]
    (a : LocalQuotientAction H (conjugateSpanBy (localModule T M) H) (centralInvolutions T))

include hG hempty hM hunique hmany hcard e hab hH

/-- The actual strict-closure application. Only the source coprime-index
argument remains in this residual equality, not a generation hypothesis. -/
theorem source_strict_closure_eq_primeToResidual_of_coprime_index
    (p : ℕ) (H0 H1 H2 : Subgroup G)
    (hprim : PrimitiveResidual H p)
    (d : ExchangedFactorSetup a (T : Subgroup G) p H0 H1 H2)
    (hne : residualClosure H Mc ≠ residual H)
    (hi : Nat.Coprime p ((residualClosure H Mc).relIndex Mc)) :
    residualClosure H Mc = (primeToResidual p Mc).map Mc.subtype := by
  obtain ⟨P,L,hlocal,_⟩ := source_strict_closure_component_orbit
    hG T hempty hM hunique hmany hcard e hab H hH a p H0 H1 H2 hprim d hne
  exact localInput_closure_eq_primeToResidual_of_coprime_index hlocal hi

end CFSG.Quasithin.Chapter14.Section06.OddNormalizer
