module
public import CFSG.Quasithin.Chapter14.Section06.SourceSuitableChoice.OddNormalizer.Closure.Source

/-!
# The detected component orbit is the literal strict closure

The intrinsic component detection theorem supplies an Mc-normal orbit which
contains the primitive residual and is generated by commutators with its odd
complement. The first property bounds the residual's Mc-closure from above.
The commutator identity bounds it from below, since that complement belongs
to the residual. Thus the two subgroups are equal, with relative component
membership and the ordinary component in Mc/O₂(Mc) retained.

The source consumer uses the original prime p, not a newly chosen prime from
the existential definition of Ξ. No component model list, prime bound, Suzuki
exclusion or maximal-prime hypothesis is needed for this step. The model
comparison and full quotient identification remain subsequent obligations.

Source: Aschbacher--Smith, proof of 14.6.14, printed p.1033, applying the
component-detection part of 1.3.4, printed pp.509--510.
-/

public section
open Subgroup Theory.GroupTheory Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter14.Section06.OddNormalizer
open Chapter1 Chapter1.XiEmbedding
open SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
open Chapter15.Section03.AbelianAmalgam
open Chapter15.Section03.AbelianAmalgam.GenerationOne
universe u
variable {G : Type u} [Group G] [Finite G]

/-- Strictness excludes the relative-normal branch of component detection.
The commutator identity then identifies the actual normal closure. -/
theorem localInput_strict_closure_component_orbit
    {p : ℕ} {T X P J : Subgroup G} (h : LocalInput p T X P J)
    (hsq : IsSQTK KnownSimple.IsKnownSimple J) (hT : IsSylowIn 2 T J)
    (hne : conjugateSpanBy X J ≠ X) :
    ∃ L : Subgroup G, ComponentDetection P J L ∧
      conjugateSpanBy X J = componentOrbit L T ∧
      ((componentOrbit L T).subgroupOf J).Normal ∧
      ⁅componentOrbit L T, P⁆ = componentOrbit L T := by
  let hA := fun (Y : Type u) [Group Y] [Finite Y] =>
    ChapterA.Section02.theoremA_knownSimple (G := Y)
  let hC := fun (Y : Type u) [Group Y] [Finite Y] =>
    ChapterA.Section02.theoremC_knownSimple (G := Y)
  rcases h.normal_or_detected_containment hA hC hsq hT with
    hn | ⟨L,hL,hn,hcomm,_hP,hX⟩
  · exact (hne (le_antisymm
      (conjugateSpanBy_le le_rfl
        ((normal_subgroupOf_iff_le_normalizer (le_sup_left.trans h.overgroup)).mp hn))
      (le_conjugateSpanBy X J))).elim
  · have hLJ : componentOrbit L T ≤ J :=
      (componentOrbit_le_sup L T).trans
        (sup_le hL.mem.1 (le_sup_right.trans h.overgroup))
    have hupper : conjugateSpanBy X J ≤ componentOrbit L T :=
      conjugateSpanBy_le hX ((normal_subgroupOf_iff_le_normalizer hLJ).mp hn)
    have hPcl : P ≤ conjugateSpanBy X J :=
      (le_sup_right.trans h.complement.le).trans (le_conjugateSpanBy X J)
    have hlower : componentOrbit L T ≤ conjugateSpanBy X J := by
      rw [← hcomm]
      exact (commutator_mono le_rfl hPcl).trans
        (le_normalizer_iff_commutator_le_right.mp
          (hLJ.trans (le_normalizer_conjugateSpanBy X J)))
    exact ⟨L,hL,le_antisymm hupper hlower,hn,hcomm⟩

variable (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hunique : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hab : IsMulCommutative (conjugateSpanBy (localModule T M) Mc))
    (H : Subgroup G) (hH : H ∈ Chapter1.HOutside G (T : Set G) (M : Set G))
    [IsElementaryAbelian 2 (conjugateSpanBy (localModule T M) H)]
    (a : LocalQuotientAction H (conjugateSpanBy (localModule T M) H) (centralInvolutions T))

include hG hempty hM hunique hmany hcard e hab hH

/-- The source strict closure is exactly the orbit of one detected relative
C-component. The intrinsic local input retains the original prime and actual
Sylow complement, for the later comparison with F.9.18. -/
theorem source_strict_closure_component_orbit
    (p : ℕ) (H0 H1 H2 : Subgroup G)
    (hprim : PrimitiveResidual H p)
    (d : ExchangedFactorSetup a (T : Subgroup G) p H0 H1 H2)
    (hne : residualClosure H Mc ≠ residual H) :
    ∃ P L : Subgroup G,
      LocalInput p (T : Subgroup G) (residual H) P Mc ∧
      ComponentDetection P Mc L ∧
      residualClosure H Mc = componentOrbit L (T : Subgroup G) ∧
      ((componentOrbit L (T : Subgroup G)).subgroupOf Mc).Normal ∧
      ⁅componentOrbit L (T : Subgroup G), P⁆ = componentOrbit L (T : Subgroup G) := by
  have hp : p.Prime := by rcases d.prime with h | h <;> rw [h] <;> decide
  have ho : Odd p := by rcases d.prime with h | h <;> rw [h] <;> decide
  let : Fact p.Prime := ⟨hp⟩
  let := hprim.elementary
  have hXi := residual_mem_Xi T H hH.1.2 hH.1.1 ho hprim d.residual_card
  have hF := source_rankTwo_f9_hypothesis hG T hempty hM hunique hmany hcard e hab H hH
  have hHMc : H ≤ Mc :=
    hF.H_centralizes.trans (InitialSource.centralizer_le_partner T hunique)
  have hMc : Mc ∈ maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) :=
    hunique.symm ▸ Set.mem_singleton Mc
  have hTMc : (T : Subgroup G) ≤ Mc := hH.1.2.trans hHMc
  have hSylow : IsSylowIn 2 (T : Subgroup G) Mc := by
    refine ⟨T.subtype hTMc,?_⟩
    simp only [Sylow.coe_subtype,map_subgroupOf_eq_of_le hTMc]
  obtain ⟨er,_her⟩ := residual_quotient_equiv ho H
    (IsElementaryAbelian.isPGroup p (pResidual 2 (H ⧸ pCore 2 H)))
  have hq : XiOddQuotient p (XiQuotient (residual H)) :=
    (show XiOddQuotient p (pResidual 2 (H ⧸ pCore 2 H)) from
      Or.inl ⟨inferInstance,d.residual_card⟩).of_mulEquiv er.symm
  let P : Sylow p (residual H) := default
  have hi := localInput_of_mem_Xi hXi hSylow
    (sup_le ((residual_le H).trans hHMc) hTMc) ho hq P
  obtain ⟨L,hL,he,hn,hcomm⟩ := localInput_strict_closure_component_orbit hi
    (hG.twoLocal_sqtk hMc.1.1) hSylow hne
  exact ⟨(P : Subgroup (residual H)).map (residual H).subtype,L,hi,hL,he,hn,hcomm⟩

/-- The actual strict-closure image is perfect and lies in the ordinary
layer of Mc/O₂(Mc). Equality with that layer, and vanishing of its Fitting
subgroup, still require the subsequent residual and prime arguments. -/
theorem source_strict_closure_image_in_layer
    (p : ℕ) (H0 H1 H2 : Subgroup G)
    (hprim : PrimitiveResidual H p)
    (d : ExchangedFactorSetup a (T : Subgroup G) p H0 H1 H2)
    (hne : residualClosure H Mc ≠ residual H) :
    Group.IsPerfect (quotientImage Mc (residualClosure H Mc)) ∧
      quotientImage Mc (residualClosure H Mc) ≤ componentLayer (Mc ⧸ pCore 2 Mc) := by
  obtain ⟨P,L,hi,hL,he,_hn,_hcomm⟩ := source_strict_closure_component_orbit
    hG T hempty hM hunique hmany hcard e hab H hH a p H0 H1 H2 hprim d hne
  rw [he,quotientImage_componentOrbit_source Mc L (T : Subgroup G) hL.mem.1
    (le_sup_right.trans hi.overgroup)]
  refine ⟨hL.component.orbit_isPerfect _,?_⟩
  exact iSup_le fun t => le_sSup (hL.component.map_conj (t : Mc ⧸ pCore 2 Mc))

end CFSG.Quasithin.Chapter14.Section06.OddNormalizer
