module
public import CFSG.Quasithin.Chapter14.Section06.SourceSuitableChoice.OddNormalizer.Quintic.ComponentExclusion.Preparation
public import CFSG.Quasithin.ChapterC.Section01.BlockTypes.AlternatingThreeQuintic
public import CFSG.Quasithin.ChapterC.Section02.SourceExtraction.MovedFittingProduct
public import CFSG.Quasithin.ChapterC.Section02.SourceExtraction.CharacteristicTwo
/-!
# Extracting the escaping component in the quintic second normalizer

The original residual closure K_z is generated by elements of order five.
The index-two intersection puts it inside G₂=N_G(K₂). Every A₃-block of
G₂ has at most two conjugates and has no nontrivial automorphism killed by
five, so K_z centralizes it. Since N_G(K_z)=Mc, each such block lies in
Mc∩G₂. The actual C.2.6 product now puts O₂,F(G₂) in that intersection.
Combined with the previously proved O₂,F*(G₂) escape, this constructs an
outside C-component with quasisimple two-core quotient and characteristic
two. Its orbit bound supplies K_z-normalization, while C.2.4 retains the
literal Sylow-intersection or radical-normalization alternative.

The module/centralizer geometry remains explicit. The Commutators, Rank and
Intersection extensions derive the commutator, five-rank and marked-normalizer
identities. The residual identification and terminal model comparisons remain
with qt-e-14615-quintic-exclusion before assembling EscapingComponent
and original 14.6.15. The earlier-source inputs in Context are discharged by
the final odd-normalizer owner, qt-e-suitable-odd-normalizer.

Source: Aschbacher--Smith 14.6.15, printed pp.1034--1035, using C.2.4(2)
and C.2.6, printed pp.144--145.
-/

@[expose] public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter14.Section06.OddNormalizer.Quintic.ComponentExtraction
open SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
open Chapter15.Section03.AbelianAmalgam
open Chapter15.Section03.AbelianAmalgam.GenerationOne
open ComponentExclusion Chapter1.RadicalExclusions
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {M Mc H H0 H1 H2 : Subgroup G}
    [IsElementaryAbelian 2 (conjugateSpanBy (localModule T M) H)]
    {a : LocalQuotientAction H (conjugateSpanBy (localModule T M) H) (centralInvolutions T)}
    (s : Context T M Mc H H0 H1 H2 a)
local instance : IsElementaryAbelian 2
    (ChapterF.Section09.Setup.UH
      ⟨T,sourceResidual M Mc,localModule T M,localModule T M,centralInvolutions T,H⟩) :=
  inferInstanceAs (IsElementaryAbelian 2 (conjugateSpanBy (localModule T M) H))
variable (d : NormalizerGeometry (T : Subgroup G) Mc H H1 H2
      (conjugateSpanBy (localModule T M) Mc) (centralInvolutions T)
      (firstSupport a H1) (firstSupport a H2) s.critical.endpoint.representative)

/-- The order-five generators lie in the index-two intersection. -/
theorem closure_le_secondNormalizer :
    residualClosure H Mc ≤ normalizer (d.K2 : Set G) := by
  let B := (Mc ⊓ normalizer (d.K2 : Set G)).subgroupOf Mc
  have hi : B.index = 2 := d.intersection_index
  have hgen (K : Subgroup G) (hK : K ≤ Mc)
      (hk : closure {x : G | x ∈ K ∧ orderOf x = 5} = K) :
      K ≤ normalizer (d.K2 : Set G) := by
    rw [←hk]
    apply (closure_le _).mpr
    rintro x ⟨hx,ho⟩
    let xM : Mc := ⟨x,hK hx⟩
    have hp : xM ^ 5 = 1 := Subtype.ext (ho ▸ pow_orderOf_eq_one x)
    have hm := B.pow_mem (B.sq_mem_of_index_two hi xM) 3
    rw [←pow_mul] at hm
    have he : xM ^ (2*3) = xM := by
      change xM ^ (5+1) = xM
      rw [pow_succ,hp,one_mul]
    rw [he] at hm
    exact hm.2
  rw [←d.join_eq]
  exact sup_le (hgen d.K1 d.first_le d.first_generated)
    (hgen d.K2 d.second_le d.second_generated)

/-- Every actual A₃-block of G₂ is contained in Mc∩G₂. -/
theorem alternatingThree_le_intersection
    (X : Subgroup (normalizer (d.K2 : Set G))) (hb : ChapterC.IsBlock X)
    (ha : ChapterC.IsAlternatingBlock X 3) :
    X ≤ (Mc ⊓ normalizer (d.K2 : Set G)).subgroupOf (normalizer (d.K2 : Set G)) := by
  let N := normalizer (d.K2 : Set G)
  have hs := (source_secondNormalizer_setup s.ambient T s.empty s.maximal s.unique
    s.many s.module_card s.action s.abelian H s.outside a H1 H2 s.critical d).2.2
  have hf := source_secondNormalizer_characteristicTwo s.ambient T s.empty s.maximal s.unique
    s.many s.module_card s.action s.abelian H s.outside a H1 H2 s.critical d
  have hr : primeRank 3 N ≤ 2 := hs.sqtk.stronglyQuasithin 3 Nat.prime_three (by decide)
  have hcentral : residualClosure H Mc ≤ centralizer (X.map N.subtype : Set G) := by
    have hgen (K : Subgroup G) (hK : K ≤ residualClosure H Mc)
        (hk : closure {x : G | x ∈ K ∧ orderOf x = 5} = K) :
        K ≤ centralizer (X.map N.subtype : Set G) := by
      rw [←hk]
      apply (closure_le _).mpr
      rintro k ⟨hk,ho⟩
      let kN : N := ⟨k,closure_le_secondNormalizer s d (hK hk)⟩
      have hc := ChapterC.fifth_power_centralizes_alternatingThree hf hr X hb ha
        (x := kN) (Subtype.ext (ho ▸ pow_orderOf_eq_one k))
      rintro x ⟨y,hy,rfl⟩
      exact congrArg N.subtype (hc y hy)
    rw [←d.join_eq]
    exact sup_le (hgen d.K1 (d.join_eq ▸ le_sup_left) d.first_generated)
      (hgen d.K2 (d.join_eq ▸ le_sup_right) d.second_generated)
  have hXMc : X.map N.subtype ≤ Mc :=
    (le_centralizer_iff.mp hcentral).trans
      ((Subgroup.centralizer_le_normalizer _).trans_eq d.closure_normalizer)
  intro x hx
  exact ⟨hXMc (mem_map_of_mem N.subtype hx),x.property⟩

/-- C.2.6 gives containment of the ordinary Fitting preimage. -/
theorem ordinary_fitting_le_intersection :
    twoFittingCore (normalizer (d.K2 : Set G)) ≤
      (Mc ⊓ normalizer (d.K2 : Set G)).subgroupOf (normalizer (d.K2 : Set G)) := by
  let N := normalizer (d.K2 : Set G)
  have hs := (source_secondNormalizer_setup s.ambient T s.empty s.maximal s.unique
    s.many s.module_card s.action s.abelian H s.outside a H1 H2 s.critical d).2.2
  have hf := source_secondNormalizer_characteristicTwo s.ambient T s.empty s.maximal s.unique
    s.many s.module_card s.action s.abelian H s.outside a H1 H2 s.critical d
  obtain ⟨n,_,L,hL,hprod⟩ := ChapterC.Section02Source.fitting_ordered_moved_product
    hs.sqtk ((Mc.pCoreIn 2).subgroupOf N) ((Mc ⊓ N).subgroupOf N)
    hs.radical hs.characteristic_control
    ((ChapterA.generalizedFitting_eq_pCore_iff 2).mp hf)
  have hn : n = 0 := by
    by_contra hn
    let i : Fin n := ⟨0,Nat.pos_of_ne_zero hn⟩
    exact (hL i).2.1 (alternatingThree_le_intersection s d (L i) (hL i).2.2.1
      (hL i).2.2.2.1)
  subst n
  intro x hx
  obtain ⟨m,hm,l,_,he⟩ := (hprod x).mp hx
  simp only [List.ofFn_zero,List.prod_nil,mul_one] at he
  rw [he]
  exact hm.1

private theorem normal_two_subgroup_sylow_closure {E : Type*} [Group E]
    (R B : Subgroup E) (hp : IsPGroup 2 R) (hRB : R ≤ B)
    [(R.subgroupOf B).Normal] : ChapterC.IsSylowInNormalClosure R B := by
  unfold ChapterC.IsSylowInNormalClosure
  rw [normalClosure_eq_self]
  let S : Sylow 2 (R.subgroupOf B) :=
    ⟨⊤,hp.comap_subtype.to_subgroup ⊤,fun _ h => top_unique h⟩
  refine ⟨S,?_⟩
  change ((⊤ : Subgroup (R.subgroupOf B)).map (R.subgroupOf B).subtype).map B.subtype = R
  apply le_antisymm
  · rintro x ⟨b,⟨r,_,rfl⟩,rfl⟩
    exact r.property
  · intro r hr
    exact ⟨⟨r,hRB hr⟩,⟨⟨⟨r,hRB hr⟩,hr⟩,mem_top _,rfl⟩,rfl⟩

/-- The original two-core is Sylow in its normal closure in the intersection. -/
theorem radical_sylow_in_normalClosure :
    ChapterC.IsSylowInNormalClosure
      ((Mc.pCoreIn 2).subgroupOf (normalizer (d.K2 : Set G)))
      ((Mc ⊓ normalizer (d.K2 : Set G)).subgroupOf (normalizer (d.K2 : Set G))) := by
  let N := normalizer (d.K2 : Set G)
  let R := (Mc.pCoreIn 2).subgroupOf N
  let B := (Mc ⊓ N).subgroupOf N
  have hRB : Mc.pCoreIn 2 ≤ Mc ⊓ N := by
    rw [←d.intersection_core]
    exact pCoreIn_le 2 _
  have hRB' : R ≤ B := comap_mono hRB
  have hn : B ≤ normalizer (R : Set N) := by
    intro b hb
    apply mem_normalizer_iff.mpr
    intro r
    have h := normalizer_le_normalizer_characteristic_image Mc (pCore 2 Mc)
      (Mc.le_normalizer hb.1)
    exact mem_normalizer_iff.mp h (r : G)
  let : (R.subgroupOf B).Normal := normal_subgroupOf_of_le_normalizer hn
  exact normal_two_subgroup_sylow_closure R B (isPGroup_pCoreIn 2 Mc).comap_subtype hRB'

/-- The actual second normalizer has an escaping quasisimple C-component;
its original radical either has full Sylow intersection or normalizes it. -/
theorem exists_component :
    ∃ J : Subgroup G, J ≤ normalizer (d.K2 : Set G) ∧
      (J.subgroupOf (normalizer (d.K2 : Set G))).IsCComponent ∧
      IsQuasisimple (J ⧸ pCore 2 J) ∧ generalizedFitting J = pCore 2 J ∧
      ¬J ≤ Mc ⊓ normalizer (d.K2 : Set G) ∧
      (Chapter1.IsSylowIn 2 (Mc.pCoreIn 2 ⊓ J) J ∨
        Mc.pCoreIn 2 ≤ normalizer (J : Set G)) := by
  let N := normalizer (d.K2 : Set G)
  let B := Mc ⊓ N
  have hs := (source_secondNormalizer_setup s.ambient T s.empty s.maximal s.unique
    s.many s.module_card s.action s.abelian H s.outside a H1 H2 s.critical d).2.2
  have hf := source_secondNormalizer_characteristicTwo s.ambient T s.empty s.maximal s.unique
    s.many s.module_card s.action s.abelian H s.outside a H1 H2 s.critical d
  have hc : centralizer (pCore 2 N : Set N) ≤ pCore 2 N :=
    (ChapterA.generalizedFitting_eq_pCore_iff 2).mp hf
  have hg : ¬ (generalizedFitting (N ⧸ pCore 2 N)).comap
      (QuotientGroup.mk' (pCore 2 N)) ≤ B.subgroupOf N := by
    intro h
    apply source_secondNormalizer_fitting_escape s.ambient T s.empty s.maximal s.unique
      s.many s.module_card s.action s.abelian H s.outside a H1 H2 s.critical d
    exact map_le_iff_le_comap.mpr h
  obtain ⟨L,hL,hq,hfL,hout⟩ := exists_characteristicTwo_cComponent_outside
    (B.subgroupOf N) hc (ordinary_fitting_le_intersection s d) hg
  let J := L.map N.subtype
  let e : L ≃* J := equivMapOfInjective L N.subtype N.subtype_injective
  have hJN : J ≤ N := map_subtype_le _
  have hJN' : J.subgroupOf N = L := comap_map_eq_self_of_injective N.subtype_injective L
  have hJ : (J.subgroupOf N).IsCComponent := hJN'.symm ▸ hL
  have hqJ : IsQuasisimple (J ⧸ pCore 2 J) := IsQuasisimple.of_mulEquiv
    (QuotientGroup.congr _ _ e (pCore_map_iso 2 e))
  let := hqJ
  have hfJ : generalizedFitting J = pCore 2 J :=
    generalizedFitting_eq_pCore_of_selfCentralizing 2
      ((Theory.Quasithin.centralizer_pCore_le_iff 2 e).mp
        ((ChapterA.generalizedFitting_eq_pCore_iff 2).mp hfL))
  have hJout : ¬J ≤ B := fun h => hout (map_le_iff_le_comap.mp h)
  refine ⟨J,hJN,hJ,hqJ,hfJ,hJout,?_⟩
  exact ChapterC.Section02Source.sylow_intersection_or_normalizes_in_of_characteristicTwo
    N (Mc.pCoreIn 2) B J hs.sqtk hs.radical_le hJN hs.radical
    hs.characteristic_control (radical_sylow_in_normalClosure s d) hJ hc

/-- Every quasisimple component of this second normalizer is fixed by the
same K_z, since its orbit has length one or two and K_z is generated by
order-five elements. -/
theorem closure_normalizes_component (J : Subgroup G)
    (hJN : J ≤ normalizer (d.K2 : Set G))
    (hJ : (J.subgroupOf (normalizer (d.K2 : Set G))).IsCComponent)
    (hq : IsQuasisimple (J ⧸ pCore 2 J)) :
    residualClosure H Mc ≤ normalizer (J : Set G) := by
  let N := normalizer (d.K2 : Set G)
  let L := J.subgroupOf N
  let e : L ≃* J := subgroupOfEquivOfLe hJN
  let : IsQuasisimple (L ⧸ pCore 2 L) := IsQuasisimple.of_mulEquiv
    (QuotientGroup.congr _ _ e (pCore_map_iso 2 e)).symm
  let q := QuotientGroup.mk' (pCore 2 N)
  have hLq : IsComponent (N ⧸ pCore 2 N) (L.map q) :=
    ⟨hJ.subnormal.map (QuotientGroup.mk'_surjective _),
      IsQuasisimple.of_mulEquiv (cComponentTwoCoreQuotientEquiv hJ)⟩
  have hs := (source_secondNormalizer_setup s.ambient T s.empty s.maximal s.unique
    s.many s.module_card s.action s.abelian H s.outside a H1 H2 s.critical d).2.2
  have hrank : ∀ p, p.Prime → Odd p → primeRank p (N ⧸ pCore 2 N) ≤ 2 := by
    intro p hp ho
    let : Fact p.Prime := ⟨hp⟩
    exact (primeRank_quotient_le_of_isTwoGroup p ho _ pCore_isPGroup).trans
      (hs.sqtk.stronglyQuasithin p hp ho)
  let : Group.IsNilpotent (pCore 2 N) := pCore_isPGroup.isNilpotent
  have horbit := cComponent_normal_or_index_two_of_quotient hJ (pCore 2 N)
    (hLq.normal_or_index_two_of_odd_rank_le_two hrank)
  have hgen (K : Subgroup G) (hK : K ≤ residualClosure H Mc)
      (hk : closure {x : G | x ∈ K ∧ orderOf x = 5} = K) :
      K ≤ normalizer (J : Set G) := by
    rw [←hk]
    apply (closure_le _).mpr
    rintro k ⟨hk,ho⟩
    let kN : N := ⟨k,closure_le_secondNormalizer s d (hK hk)⟩
    have hn : kN ∈ normalizer (L : Set N) := by
      rcases horbit with hn | hi
      · let := hn
        rw [normalizer_eq_top]
        exact mem_top _
      · let B := normalizer (L : Set N)
        have hm := B.pow_mem (B.sq_mem_of_index_two hi kN) 3
        rw [←pow_mul] at hm
        have hp : kN ^ 5 = 1 := Subtype.ext (ho ▸ pow_orderOf_eq_one k)
        have he : kN ^ (2*3) = kN := by
          change kN ^ (5+1) = kN
          rw [pow_succ,hp,one_mul]
        rwa [he] at hm
    rw [←subgroupOf_normalizer_eq hJN] at hn
    exact hn
  rw [←d.join_eq]
  exact sup_le (hgen d.K1 (d.join_eq ▸ le_sup_left) d.first_generated)
    (hgen d.K2 (d.join_eq ▸ le_sup_right) d.second_generated)

/-- Extract the original ambient component with normalization and the
literal C.2.4 alternative, for the subsequent commutator, rank and model
comparisons. -/
theorem exists_normalized_component :
    ∃ J : Subgroup G, J ≤ normalizer (d.K2 : Set G) ∧
      (J.subgroupOf (normalizer (d.K2 : Set G))).IsCComponent ∧
      IsQuasisimple (J ⧸ pCore 2 J) ∧ generalizedFitting J = pCore 2 J ∧
      ¬J ≤ Mc ⊓ normalizer (d.K2 : Set G) ∧
      residualClosure H Mc ≤ normalizer (J : Set G) ∧
      (Chapter1.IsSylowIn 2 (Mc.pCoreIn 2 ⊓ J) J ∨
        Mc.pCoreIn 2 ≤ normalizer (J : Set G)) := by
  obtain ⟨J,hJN,hJ,hq,hf,hout,ha⟩ := exists_component s d
  exact ⟨J,hJN,hJ,hq,hf,hout,closure_normalizes_component s d J hJN hJ hq,ha⟩
end CFSG.Quasithin.Chapter14.Section06.OddNormalizer.Quintic.ComponentExtraction
