module
public import CFSG.Quasithin.Chapter14.Section06.SourceSuitableChoice.OddNormalizer.Quintic.ComponentExtraction
public import Theory.GroupTheory.PResidual.CommutatorImage
public import Theory.GroupTheory.PResidual.NormalizerImage
public import Theory.GroupTheory.PResidual.FiniteLocalPair
public import Theory.GroupTheory.Commutator.CentralizingComplement
/-!
# Commutator generation of the escaping component

The component extracted in the actual second normalizer cannot centralize
K_z modulo the two-core: normalizer lifting would put it in M_c. Its
quasisimple image is consequently generated by commutators with K_z.
The second factor is normal in its normalizer, so it centralizes the
component image; two-perfectness then gives J = [J,K_1].

All quotient maps are those of N_G(K_2), and normality of the component
is not assumed. This proves the commutator portion of the extraction on
Aschbacher--Smith, 14.6.15, printed pp.1034--1035. The geometry premise is
still to be constructed by the source-theorem assembly.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter14.Section06.OddNormalizer.Quintic.ComponentExtraction
open SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
open Chapter15.Section03.AbelianAmalgam Chapter15.Section03.AbelianAmalgam.GenerationOne
open ComponentExclusion Chapter1.RadicalExclusions
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
private theorem twoPerfect_of_five_generated (K : Subgroup G)
    (hK : closure {x : G | x ∈ K ∧ orderOf x = 5} = K) : IsPPerfect 2 K := by
  have hle : K ≤ (pResidual 2 K).map K.subtype := by
    apply hK.ge.trans
    apply (closure_le _).mpr
    rintro x ⟨hx,ho⟩
    refine ⟨⟨x,hx⟩,mem_pResidual_of_orderOf_coprime ?_,rfl⟩
    rw [←Subgroup.orderOf_coe,ho]
    decide
  apply (pResidual_eq_top_iff 2 K).mp
  apply map_injective K.subtype_injective
  rw [←MonoidHom.range_eq_map,range_subtype]
  exact le_antisymm (map_subtype_le _) hle

private theorem twoPerfect_of_perfect (K : Subgroup G) [Group.IsPerfect K] :
    IsPPerfect 2 K := by
  intro A hA hp
  let := hA
  let : Group.IsNilpotent (K ⧸ A) := hp.isNilpotent
  apply top_unique
  rw [←solvableResidual_eq_top (G := K)]
  exact solvableResidual_le_of_solvable_quotient A

variable {T : Sylow 2 G} {M Mc H H0 H1 H2 : Subgroup G}
    [IsElementaryAbelian 2 (conjugateSpanBy (localModule T M) H)]
    {a : LocalQuotientAction H (conjugateSpanBy (localModule T M) H) (centralInvolutions T)}
    (s : Context T M Mc H H0 H1 H2 a)
local instance : IsElementaryAbelian 2
    (ChapterF.Section09.Setup.UH
      ⟨T,sourceResidual M Mc,localModule T M,localModule T M,centralInvolutions T,H⟩) :=
  inferInstanceAs (IsElementaryAbelian 2 (conjugateSpanBy (localModule T M) H))
variable (d : NormalizerGeometry (T : Subgroup G) Mc H H1 H2
      (conjugateSpanBy (localModule T M) Mc) (centralInvolutions T)
      (firstSupport a H1) (firstSupport a H2) s.critical.endpoint.representative)

include s d in
/-- The actual closure is two-perfect because both factors are generated
by elements of order five. -/
theorem closure_twoPerfect : IsPPerfect 2 (residualClosure H Mc) := by
  rw [←d.join_eq]
  exact isPPerfect_sup d.K1 d.K2 (twoPerfect_of_five_generated d.K1 d.first_generated)
    (twoPerfect_of_five_generated d.K2 d.second_generated)

/-- The second normalizer's two-core lies in the original maximal subgroup. -/
theorem secondNormalizer_core_le_partner :
    (normalizer (d.K2 : Set G)).pCoreIn 2 ≤ Mc := by
  let N := normalizer (d.K2 : Set G)
  have hs := (source_secondNormalizer_setup s.ambient T s.empty s.maximal s.unique
    s.many s.module_card s.action s.abelian H s.outside a H1 H2 s.critical d).2.2
  have hc : pCore 2 N ≤ (Mc.pCoreIn 2).subgroupOf N :=
    pCore_le_of_pCore_normalizer_le _ hs.radical.isPGroup hs.radical.2.le
  exact (map_le_iff_le_comap.mpr hc).trans (pCoreIn_le 2 Mc)

variable (J : Subgroup G) (hJN : J ≤ normalizer (d.K2 : Set G))
    (hJ : (J.subgroupOf (normalizer (d.K2 : Set G))).IsCComponent)
    (hq : IsQuasisimple (J ⧸ pCore 2 J))
    (hout : ¬J ≤ Mc ⊓ normalizer (d.K2 : Set G))

include hJN hJ hq hout in
/-- Escape from the intersection forces commutator generation by K_z. -/
theorem component_generated_by_closure : J = ⁅J,residualClosure H Mc⁆ := by
  let N := normalizer (d.K2 : Set G)
  let L := J.subgroupOf N
  let A := (residualClosure H Mc).subgroupOf N
  let e : L ≃* J := subgroupOfEquivOfLe hJN
  let : IsQuasisimple (L ⧸ pCore 2 L) := IsQuasisimple.of_mulEquiv
    (QuotientGroup.congr _ _ e (pCore_map_iso 2 e)).symm
  let q := QuotientGroup.mk' (pCore 2 N)
  have hqker : IsPGroup 2 q.ker := by rw [QuotientGroup.ker_mk']; exact pCore_isPGroup
  have hLq : IsComponent (N ⧸ pCore 2 N) (L.map q) :=
    ⟨hJ.subnormal.map (QuotientGroup.mk'_surjective _),
      IsQuasisimple.of_mulEquiv (cComponentTwoCoreQuotientEquiv hJ)⟩
  have hAN : residualClosure H Mc ≤ N := closure_le_secondNormalizer s d
  have hAL : A ≤ normalizer (L : Set N) := by
    rw [←subgroupOf_normalizer_eq hJN]
    exact comap_mono (closure_normalizes_component s d J hJN hJ hq)
  have hAp : IsPPerfect 2 A := (closure_twoPerfect s d).of_surjective
    (subgroupOfEquivOfLe hAN).symm.toMonoidHom (subgroupOfEquivOfLe hAN).symm.surjective
  have hkernel : q.ker ≤ normalizer (A : Set N) := by
    rw [QuotientGroup.ker_mk',←subgroupOf_normalizer_eq hAN]
    intro x hx
    rw [d.closure_normalizer]
    exact secondNormalizer_core_le_partner s d (mem_map_of_mem N.subtype hx)
  have hnot : ⁅L.map q,A.map q⁆ ≠ ⊥ := by
    intro hz
    have hnorm : L ≤ normalizer (A : Set N) := by
      rw [←comap_normalizer_map_of_pPerfect q A hAp hqker hkernel]
      exact map_le_iff_le_comap.mp
        ((commutator_eq_bot_iff_le_centralizer.mp hz).trans
          (Subgroup.centralizer_le_normalizer _))
    apply hout
    intro x hx
    have hn := hnorm (show (⟨x,hJN hx⟩ : N) ∈ L from hx)
    rw [←subgroupOf_normalizer_eq hAN] at hn
    exact ⟨d.closure_normalizer ▸ hn,hJN hx⟩
  rcases hLq.commutator_dichotomy (A.map q) with hz | he
  · exact (hnot hz).elim
  have him : L.map q = ⁅L.map q,A.map q⁆ := by
    rw [he]
    apply le_antisymm (le_iSup_conjugates _ _)
    apply iSup_le
    intro x
    exact (mem_normalizer_iff_map_conj_eq.mp
      (((map_mono hAL).trans (L.le_normalizer_map q)) x.property)).le
  let := hJ.perfect
  have hL : L = ⁅L,A⁆ := eq_commutator_of_isPPerfect_of_map_eq L A
    (twoPerfect_of_perfect L) hAL q hqker him
  have hm := congrArg (map N.subtype) hL
  rwa [map_commutator,map_subgroupOf_eq_of_le hJN,map_subgroupOf_eq_of_le hAN] at hm

include hJN hJ hq hout in
/-- The normal second factor centralizes the component modulo its two-core. -/
theorem component_second_commutator : ⁅J,d.K2⁆ ≤ J.pCoreIn 2 := by
  let N := normalizer (d.K2 : Set G)
  let L := J.subgroupOf N
  let B := d.K2.subgroupOf N
  let : B.Normal := inferInstance
  let e : L ≃* J := subgroupOfEquivOfLe hJN
  let : IsQuasisimple (L ⧸ pCore 2 L) := IsQuasisimple.of_mulEquiv
    (QuotientGroup.congr _ _ e (pCore_map_iso 2 e)).symm
  let q := QuotientGroup.mk' (pCore 2 N)
  let : (B.map q).Normal := Normal.map inferInstance q (QuotientGroup.mk'_surjective _)
  have hLq : IsComponent (N ⧸ pCore 2 N) (L.map q) :=
    ⟨hJ.subnormal.map (QuotientGroup.mk'_surjective _),
      IsQuasisimple.of_mulEquiv (cComponentTwoCoreQuotientEquiv hJ)⟩
  have hc : ⁅L.map q,B.map q⁆ = ⊥ := by
    rcases hLq.normal_dichotomy (B.map q) with hl | hc
    · have hl' : L ≤ B ⊔ pCore 2 N := by
        have hh := map_le_iff_le_comap.mp hl
        simpa only [comap_map_eq,q,QuotientGroup.ker_mk'] using hh
      have hm := map_mono (f := N.subtype) hl'
      rw [Subgroup.map_sup,map_subgroupOf_eq_of_le hJN,
        map_subgroupOf_eq_of_le d.K2.le_normalizer] at hm
      exact (hout (le_inf (hm.trans (sup_le d.second_le
        (secondNormalizer_core_le_partner s d))) hJN)).elim
    · exact hc
  have hcore : ⁅L,B⁆ ≤ pCore 2 N := by
    rw [←map_commutator,Subgroup.map_eq_bot_iff,QuotientGroup.ker_mk'] at hc
    exact hc
  have hBL : B ≤ normalizer (L : Set N) := by
    rw [←subgroupOf_normalizer_eq hJN]
    exact comap_mono ((d.join_eq ▸ le_sup_right).trans
      (closure_normalizes_component s d J hJN hJ hq))
  have hlocal : ⁅L,B⁆ ≤ L.pCoreIn 2 := by
    intro c hc
    refine ⟨⟨c,le_normalizer_iff_commutator_le_left.mp hBL hc⟩,?_,rfl⟩
    rw [pCore_subnormal_eq_comap 2 hJ.subnormal]
    exact hcore hc
  have hm := map_mono (f := N.subtype) hlocal
  rwa [map_commutator,map_pCoreIn_of_injective 2 L N.subtype N.subtype_injective,
    map_subgroupOf_eq_of_le hJN,map_subgroupOf_eq_of_le d.K2.le_normalizer] at hm

include hJN hJ hq hout in
/-- The first factor generates the escaping component by commutators. -/
theorem component_generated_by_first : J = ⁅J,d.K1⁆ := by
  let N := normalizer (d.K2 : Set G)
  let L := J.subgroupOf N
  let A := (residualClosure H Mc).subgroupOf N
  let A1 := d.K1.subgroupOf N
  let A2 := d.K2.subgroupOf N
  have hAN : residualClosure H Mc ≤ N := closure_le_secondNormalizer s d
  have hA1N : d.K1 ≤ N := (d.join_eq ▸ le_sup_left).trans hAN
  have hA2N : d.K2 ≤ N := d.K2.le_normalizer
  have hAL : A ≤ normalizer (L : Set N) := by
    rw [←subgroupOf_normalizer_eq hJN]
    exact comap_mono (closure_normalizes_component s d J hJN hJ hq)
  have hA1L : A1 ≤ normalizer (L : Set N) :=
    (comap_mono (d.join_eq ▸ le_sup_left)).trans hAL
  let q := QuotientGroup.mk' (pCore 2 N)
  have hqker : IsPGroup 2 q.ker := by rw [QuotientGroup.ker_mk']; exact pCore_isPGroup
  have hcore : ⁅L,A2⁆ ≤ pCore 2 N := by
    have hh := component_second_commutator s d J hJN hJ hq hout
    have hm : ⁅L,A2⁆.map N.subtype ≤ J.pCoreIn 2 := by
      rwa [map_commutator,map_subgroupOf_eq_of_le hJN,map_subgroupOf_eq_of_le hA2N]
    have hJcore : J.pCoreIn 2 = (L.pCoreIn 2).map N.subtype := by
      rw [map_pCoreIn_of_injective 2 L N.subtype N.subtype_injective,
        map_subgroupOf_eq_of_le hJN]
    rw [hJcore,map_le_map_iff_of_injective N.subtype_injective] at hm
    apply hm.trans
    rw [pCoreIn,pCore_subnormal_eq_comap 2 hJ.subnormal]
    exact Subgroup.map_comap_le _ _
  have hcentral : A2.map q ≤ centralizer (L.map q : Set (N ⧸ pCore 2 N)) := by
    apply le_centralizer_iff.mp
    apply commutator_eq_bot_iff_le_centralizer.mp
    rw [←map_commutator,Subgroup.map_eq_bot_iff,QuotientGroup.ker_mk']
    exact hcore
  have hgen : A2.map q ⊔ A1.map q = A.map q := by
    rw [←Subgroup.map_sup]
    apply congrArg (map q)
    dsimp only [A,A1,A2]
    rw [←subgroupOf_sup hA2N hA1N,sup_comm,d.join_eq]
  have hcomm : ⁅L.map q,A1.map q⁆ = ⁅L.map q,A.map q⁆ :=
    commutator_eq_of_centralizing_sup hgen hcentral
      ((map_mono hA1L).trans (L.le_normalizer_map q))
  have hLA : L = ⁅L,A⁆ := by
    apply map_injective N.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le hJN,map_subgroupOf_eq_of_le hAN]
    exact component_generated_by_closure s d J hJN hJ hq hout
  have him : L.map q = ⁅L.map q,A1.map q⁆ := by
    rw [hcomm,←map_commutator,←hLA]
  let := hJ.perfect
  have he := eq_commutator_of_isPPerfect_of_map_eq L A1
    (twoPerfect_of_perfect L) hA1L q hqker him
  have hm := congrArg (map N.subtype) he
  rwa [map_commutator,map_subgroupOf_eq_of_le hJN,map_subgroupOf_eq_of_le hA1N] at hm
/-- Extract the same ambient component together with all the commutator
identities needed before the quintic-rank and model comparisons. -/
theorem exists_component_with_commutators :
    ∃ J : Subgroup G, J ≤ normalizer (d.K2 : Set G) ∧
      (J.subgroupOf (normalizer (d.K2 : Set G))).IsCComponent ∧
      IsQuasisimple (J ⧸ pCore 2 J) ∧ generalizedFitting J = pCore 2 J ∧
      ¬J ≤ Mc ⊓ normalizer (d.K2 : Set G) ∧
      residualClosure H Mc ≤ normalizer (J : Set G) ∧
      J = ⁅J, residualClosure H Mc⁆ ∧ J = ⁅J, d.K1⁆ ∧ ⁅J, d.K2⁆ ≤ J.pCoreIn 2 ∧
      (Chapter1.IsSylowIn 2 (Mc.pCoreIn 2 ⊓ J) J ∨
        Mc.pCoreIn 2 ≤ normalizer (J : Set G)) := by
  obtain ⟨J, hJN, hJ, hq, hf, hout, hn, ha⟩ := exists_normalized_component s d
  exact ⟨J, hJN, hJ, hq, hf, hout, hn,
    component_generated_by_closure s d J hJN hJ hq hout,
    component_generated_by_first s d J hJN hJ hq hout,
    component_second_commutator s d J hJN hJ hq hout, ha⟩
end CFSG.Quasithin.Chapter14.Section06.OddNormalizer.Quintic.ComponentExtraction
