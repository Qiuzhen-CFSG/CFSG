module
public import CFSG.Quasithin.Chapter14.Section06.SourceSuitableChoice.OddNormalizer.Quintic.ModuleGeometry.ResidualControl
public import CFSG.Quasithin.Chapter14.Section06.SourceSuitableChoice.OddNormalizer.Closure.Primitive
public import Theory.GroupTheory.PResidual.QuinticPairControl
/-!
# The ordinary point-centralizer closure in the residual branch

When K_z = O²(H), its two residual factors are subnormal in M_c. Their
actual core quotients have order five, while the primitive residual has
five-rank two. The strongly quasithin bound and the index-two stabilizer
therefore put every quintic element of M_c in O²(H). Since the residual
factors are generated by these elements and M_c = C_G(Z), this proves
θ(C_G(Z)) = K_z using the ordinary ambient centralizer.

The geometry and component consumers now retain just one control in this
branch: the index in M_c of the normalizer of the second residual. That
index, the exchanged PSL₂(16) branch and the terminal model comparisons
remain obligations of qt-e-14615-quintic-exclusion. The earlier 14.6.12--14
inputs retain final discharge with qt-e-suitable-odd-normalizer.
No disputed component residual-centralizer identity is used.

Source: Aschbacher--Smith 14.6.15, printed pp.1034--1035.
-/
public section
open Subgroup Theory.GroupTheory Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter14.Section06.OddNormalizer.Quintic.ModuleGeometry


open Chapter15.Section03.AbelianAmalgam Chapter15.Section03.AbelianAmalgam.GenerationOne
open SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
open ComponentExclusion ComponentExclusion.ContainedComparison
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {M Mc H H0 H1 H2 : Subgroup G}
    [IsElementaryAbelian 2 (conjugateSpanBy (localModule T M) H)]
    {a : LocalQuotientAction H (conjugateSpanBy (localModule T M) H) (centralInvolutions T)}
    (s : Context T M Mc H H0 H1 H2 a)

include s in
private theorem residual_partner_le : H ≤ Mc := by
  have he := (Section02.source_lemma_14_2_3 s.ambient T s.empty s.maximal s.unique
    s.many s.module_card s.action H s.outside.1 s.outside.2).1
  exact (show Mc ∈ maximalTwoLocalOvergroups H from he ▸ Set.mem_singleton Mc).2

include s in
private theorem first_residual_normalizer
    (hi : (Mc ⊓ normalizer (residual H2 : Set G)).relIndex Mc = 2) :
    Mc ⊓ normalizer (residual H2 : Set G) ≤ normalizer (residual H1 : Set G) := by
  have hTMc : (T : Subgroup G) ≤ Mc := by
    rw [partner_eq_centralizer s]
    exact le_centralizer_iff.mp (centralInvolutions_le_centralizer_sylow T)
  obtain ⟨t,ht,_,he⟩ := residual_factors_exchanged a s.factors
  have hi' : (normalizer (residual H2 : Set G)).relIndex Mc = 2 := by
    simpa only [inf_relIndex_left] using hi
  have h := index_two_stabilizer_normalizes_conjugate (residual H2) Mc hi' (hTMc ht)
  have he' : (residual H2).map (MulAut.conj t).toMonoidHom = residual H1 := by
    rw [←he,map_map]
    have hf : (MulAut.conj t).toMonoidHom.comp (MulAut.conj t⁻¹).toMonoidHom =
        MonoidHom.id G := by
      ext x
      simp only [MonoidHom.comp_apply,MulEquiv.toMonoidHom_eq_coe,MonoidHom.coe_coe,
        MulAut.conj_apply,inv_inv,MonoidHom.id_apply]
      group
    rw [hf,map_id]
  rwa [he'] at h

include s in
/-- All quintic elements of the literal partner lie in its residual closure. -/
theorem source_residual_quintic_elements
    (hc : residualClosure H Mc = residual H)
    (hi : (Mc ⊓ normalizer (residual H2 : Set G)).relIndex Mc = 2)
    {x : G} (hx : x ∈ Mc) (ho : orderOf x = 5) : x ∈ residual H := by
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  let A := (residual H1).subgroupOf Mc
  let B := (residual H2).subgroupOf Mc
  have hHM := residual_partner_le s
  have h1 : residual H1 ≤ Mc := (residual_le H1).trans
    ((s.factors.first_le.trans s.factors.zero_le).trans hHM)
  have h2 : residual H2 ≤ Mc := (residual_le H2).trans
    ((s.factors.second_le.trans s.factors.zero_le).trans hHM)
  have hKM : residual H ≤ Mc := (residual_le H).trans hHM
  have hj : A ⊔ B = (residual H).subgroupOf Mc := by
    rw [←residual_factors_join a s.factors,subgroupOf_sup h1 h2]
  have hKH0 : residual H ≤ H0 := by
    rw [←residual_factors_join a s.factors]
    exact sup_le ((residual_le H1).trans s.factors.first_le)
      ((residual_le H2).trans s.factors.second_le)
  have hsub (C : Subgroup G) (hCK : C ≤ residual H)
      (hn : H0 ≤ normalizer (C : Set G)) : (C.subgroupOf Mc).IsSubnormal := by
    have hKN : Mc ≤ normalizer (residual H : Set G) := by
      rw [←hc]
      exact le_normalizer_conjugateSpanBy _ _
    let : ((residual H).subgroupOf Mc).Normal := normal_subgroupOf_of_le_normalizer hKN
    have hn' : ((residual H).subgroupOf Mc) ≤ normalizer (C.subgroupOf Mc : Set Mc) :=
      (comap_mono (hKH0.trans hn)).trans (le_normalizer_comap Mc.subtype)
    exact IsSubnormal.step _ _ (subgroupOf_mono Mc hCK)
      (inferInstance : ((residual H).subgroupOf Mc).Normal).isSubnormal
      (normal_subgroupOf_of_le_normalizer hn')
  have hA : A.IsSubnormal := hsub _ ((residual_factors_join a s.factors) ▸ le_sup_left)
    (s.factors.normalizes_first.trans
      (normalizer_le_normalizer_characteristic_image H1 (pResidual 2 H1)))
  have hB : B.IsSubnormal := hsub _ ((residual_factors_join a s.factors) ▸ le_sup_right)
    (s.factors.normalizes_second.trans
      (normalizer_le_normalizer_characteristic_image H2 (pResidual 2 H2)))
  let eA := subgroupOfEquivOfLe h1
  let eB := subgroupOfEquivOfLe h2
  let eK := subgroupOfEquivOfLe hKM
  have hcA : Nat.card (A ⧸ pCore 2 A) = 5 :=
    (Nat.card_congr (QuotientGroup.congr _ _ eA (pCore_map_iso 2 eA)).toEquiv).trans
      (residual_factors_core_card a s.factors).1
  have hcB : Nat.card (B ⧸ pCore 2 B) = 5 :=
    (Nat.card_congr (QuotientGroup.congr _ _ eB (pCore_map_iso 2 eB)).toEquiv).trans
      (residual_factors_core_card a s.factors).2
  have hnA : normalizer (B : Set Mc) ≤ normalizer (A : Set Mc) := by
    rw [←subgroupOf_normalizer_eq h1,←subgroupOf_normalizer_eq h2]
    intro y hy
    exact first_residual_normalizer s hi ⟨y.property,hy⟩
  have hiB : (normalizer (B : Set Mc)).index = 2 := by
    rw [←subgroupOf_normalizer_eq h2]
    change (normalizer (residual H2 : Set G)).relIndex Mc = 2
    simpa only [inf_relIndex_left] using hi
  have hmax : IsMaximalTwoLocal Mc :=
    (show Mc ∈ maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) from
      s.unique ▸ Set.mem_singleton Mc).1
  have hr : primeRank 5 Mc ≤ 2 :=
    (s.ambient.twoLocal_sqtk hmax.1).stronglyQuasithin 5 (by decide) (by decide)
  let := s.primitive.elementary
  obtain ⟨e,_⟩ := residual_quotient_equiv (by decide : Odd 5) H
    (IsElementaryAbelian.isPGroup 5 (pResidual 2 (H ⧸ pCore 2 H)))
  let : IsElementaryAbelian 5 (Chapter1.XiQuotient (residual H)) :=
    IsElementaryAbelian.of_surjective e.symm.toMonoidHom e.symm.surjective
  let : IsElementaryAbelian 5 (⊤ : Subgroup (Chapter1.XiQuotient (residual H))) :=
    IsElementaryAbelian.of_injective (⊤ : Subgroup (Chapter1.XiQuotient (residual H))).subtype
      (⊤ : Subgroup (Chapter1.XiQuotient (residual H))).subtype_injective
  have hrQ : 2 ≤ primeRank 5 (Chapter1.XiQuotient (residual H)) := by
    apply IsElementaryAbelian.primeRank_ge_of_card (⊤ : Subgroup (Chapter1.XiQuotient (residual H)))
    rw [Nat.card_congr Subgroup.topEquiv.toEquiv,Nat.card_congr e.toEquiv,s.factors.residual_card]
  have hrK : primeRank 5 (A ⊔ B : Subgroup Mc) = 2 := by
    rw [hj,primeRank_congr 5 eK]
    exact le_antisymm ((primeRank_mono 5 hKM).trans hr)
      (hrQ.trans (primeRank_quotient_le_of_isTwoGroup 5 (by decide) _ pCore_isPGroup))
  have hpA : IsPPerfect 2 A := (isPPerfect_embedded_pResidual 2 H1).of_surjective
    eA.symm.toMonoidHom eA.symm.surjective
  have hpB : IsPPerfect 2 B := (isPPerfect_embedded_pResidual 2 H2).of_surjective
    eB.symm.toMonoidHom eB.symm.surjective
  have hpK : IsPPerfect 2 (A ⊔ B : Subgroup Mc) := by
    rw [hj]
    exact (isPPerfect_embedded_pResidual 2 H).of_surjective
      eK.symm.toMonoidHom eK.symm.surjective
  have hm := mem_sup_of_order_five_of_index_two_normalizer A B hA hB hcA hcB hiB hnA hr hrK hpA hpB hpK
    (x := ⟨x,hx⟩) (by rwa [←Subgroup.orderOf_coe])
  have hm' : (⟨x,hx⟩ : Mc) ∈ (residual H).subgroupOf Mc := hj ▸ hm
  exact hm'

include s in
/-- The first point-centralizer closure is derived from the genuine index-two geometry. -/
theorem source_residual_point_closure
    (hc : residualClosure H Mc = residual H)
    (hi : (Mc ⊓ normalizer (residual H2 : Set G)).relIndex Mc = 2) :
    closure {x : G | x ∈ centralizer (centralInvolutions T : Set G) ∧ orderOf x = 5} =
      residualClosure H Mc := by
  rw [hc]
  apply le_antisymm
  · apply (closure_le _).mpr
    intro x hx
    exact source_residual_quintic_elements s hc hi ((partner_eq_centralizer s).ge hx.1) hx.2
  · rw [←residual_factors_join a s.factors]
    have hfactor (C : Subgroup G) (hC : C ≤ Mc)
        (hgen : closure {x : G | x ∈ C ∧ orderOf x = 5} = C) :
        C ≤ closure {x : G | x ∈ centralizer (centralInvolutions T : Set G) ∧ orderOf x = 5} := by
      rw [←hgen]
      apply Subgroup.closure_mono
      intro x hx
      exact ⟨(partner_eq_centralizer s).le (hC hx.1),hx.2⟩
    exact sup_le (hfactor _ ((residual_le H1).trans
      ((s.factors.first_le.trans s.factors.zero_le).trans (residual_partner_le s)))
        (residual_factors_generated a s.factors).1)
      (hfactor _ ((residual_le H2).trans
        ((s.factors.second_le.trans s.factors.zero_le).trans (residual_partner_le s)))
          (residual_factors_generated a s.factors).2)


local instance : IsElementaryAbelian 2
    (ChapterF.Section09.Setup.UH
      ⟨T,sourceResidual M Mc,localModule T M,localModule T M,centralInvolutions T,H⟩) :=
  inferInstanceAs (IsElementaryAbelian 2 (conjugateSpanBy (localModule T M) H))

variable (hclosure : residualClosure H Mc = residual H)
    (hindex : (Mc ⊓ normalizer (residual H2 : Set G)).relIndex Mc = 2)

/-- All residual-branch geometry except the partner intersection index is now
proved from the original source inputs. The quintic-exclusion owner retains
the index and the final p=3 assembly. -/
noncomputable def indexedResidualNormalizerGeometry :
    NormalizerGeometry (T : Subgroup G) Mc H H1 H2
      (conjugateSpanBy (localModule T M) Mc) (centralInvolutions T)
      (firstSupport a H1) (firstSupport a H2) s.critical.endpoint.representative :=
  controlledResidualNormalizerGeometry s hclosure
    (source_residual_point_closure s hclosure hindex) hindex

/-- The constructed geometry retains the same original residuals. -/
theorem indexedResidualNormalizerGeometry_factors :
    let d := indexedResidualNormalizerGeometry s hclosure hindex
    d.K1 = residual H1 ∧ d.K2 = residual H2 :=
  controlledResidualNormalizerGeometry_factors s hclosure
    (source_residual_point_closure s hclosure hindex) hindex

include s hclosure hindex in
/-- The actual C.2.3 consumer uses the proved point-centralizer closure. -/
theorem indexed_residual_secondNormalizer_setup :
    s.critical.endpoint.representative ∈ normalizer (residual H2 : Set G) ∧
      ¬normalizer (residual H2 : Set G) ≤ Mc ∧
      Chapter1.RadicalExclusions.PushingUpSetup KnownSimple.IsKnownSimple
        (normalizer (residual H2 : Set G)) (Mc.pCoreIn 2)
          (Mc ⊓ normalizer (residual H2 : Set G)) ∧
      ((T : Subgroup G) ⊓ normalizer (residual H2 : Set G)).relIndex T = 2 :=
  controlled_residual_secondNormalizer_setup s hclosure
    (source_residual_point_closure s hclosure hindex) hindex

include s hclosure hindex in
/-- Extract the genuine component and exclude its normalized natural row
with only the remaining intersection index explicit. Its source construction
and final exclusion belong to qt-e-14615-quintic-exclusion. -/
theorem indexed_residual_component_comparison :
    Nonempty (SourceEscapingComponent Mc (residualClosure H Mc)
      (residual H1) (residual H2) (Mc.pCoreIn 2)) ∧
    ∀ j : SourceEscapingComponent Mc (residualClosure H Mc)
      (residual H1) (residual H2) (Mc.pCoreIn 2),
      Mc.pCoreIn 2 ≤ normalizer (j.J : Set G) →
        ¬Nonempty (NaturalStarRow j.J (Mc.pCoreIn 2)) :=
  controlled_residual_component_comparison s hclosure
    (source_residual_point_closure s hclosure hindex) hindex

end CFSG.Quasithin.Chapter14.Section06.OddNormalizer.Quintic.ModuleGeometry
