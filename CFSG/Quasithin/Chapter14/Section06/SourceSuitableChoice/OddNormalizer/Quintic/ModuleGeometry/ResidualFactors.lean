/-!
# The literal residual factors in the quintic branch

Starting with the original exchanged dihedral pair in H/O₂(H), restrict its
quotient map to each factor and transport the two-residual through its actual
two-group kernel. This gives the cyclic-five core quotients and prime-order
generators. Relative normality and the original index two identify their join
with O²(H). The marked exchange element still exchanges the residuals, while
the disjoint quotient supports and two-layer centralization give ordinary
centralization of the opposite residual.

These results retain the same H₁, H₂, action and conjugator. The source consumer
ResidualSource derives their module and point hypotheses from the full prefix
and connects them to NormalizerGeometry and the second-normalizer argument.
No normalizer in Mc or prime-order centralizer equality is assumed here.

Source: Aschbacher--Smith 14.6.12 and 14.6.15, printed pp.1031 and 1034.
-/

public section
open Subgroup Theory.GroupTheory Representation.BinaryOffender
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter14.Section06.OddNormalizer.Quintic.ModuleGeometry
open Chapter15.Section03.AbelianAmalgam Chapter15.Section03.AbelianAmalgam.GenerationOne
variable {G : Type*} [Group G] [Finite G]
variable {H U Z T H0 H1 H2 : Subgroup G} [IsElementaryAbelian 2 U]
    (a : LocalQuotientAction H U Z) (d : ExchangedFactorSetup a T 5 H0 H1 H2)

private theorem residual_core_card {B : Subgroup G} (hB : B ≤ H)
    (hm : Nonempty (actorImage H B ≃* DihedralGroup 5)) :
    Nat.card (residual B ⧸ pCore 2 (residual B)) = 5 := by
  let q := QuotientGroup.mk' (pCore 2 H)
  let f : B →* actorImage H B := (q.subgroupMap (B.subgroupOf H)).comp
    (subgroupOfEquivOfLe hB).symm.toMonoidHom
  have hf : Function.Surjective f := (q.subgroupMap_surjective _).comp
    (subgroupOfEquivOfLe hB).symm.surjective
  have hk : f.ker ≤ (H.pCoreIn 2).subgroupOf B := by
    intro x hx
    have hzero : q ⟨x,hB x.property⟩ = 1 := congrArg Subtype.val hx
    exact mem_map_of_mem H.subtype ((QuotientGroup.eq_one_iff _).mp hzero)
  have hfk : IsPGroup 2 f.ker :=
    ((isPGroup_pCoreIn 2 H).comap_subtype).to_le hk
  have hc : Nat.card (actorImage H B) = 2*5 := by
    rw [Nat.card_congr hm.some.toEquiv,DihedralGroup.nat_card]
  have hr := card_twoResidual_coreQuotient_of_two_kernel (by decide : Odd 5) f hf hfk hc
  let e : pResidual 2 B ≃* residual B :=
    (pResidual 2 B).equivMapOfInjective B.subtype B.subtype_injective
  have hke : IsPGroup 2 e.toMonoidHom.ker := by
    rw [(MonoidHom.ker_eq_bot_iff e.toMonoidHom).mpr e.injective]
    exact IsPGroup.of_card (n := 0) (by simp)
  rwa [Nat.card_congr (e.toMonoidHom.pCoreQuotientEquiv e.surjective hke).toEquiv] at hr

include d in
/-- The two literal factor residuals have intrinsic two-core quotients of order five. -/
theorem residual_factors_core_card :
    Nat.card (residual H1 ⧸ pCore 2 (residual H1)) = 5 ∧
    Nat.card (residual H2 ⧸ pCore 2 (residual H2)) = 5 :=
  ⟨residual_core_card (d.first_le.trans d.zero_le) d.first_model,
    residual_core_card (d.second_le.trans d.zero_le) d.second_model⟩

include d in
/-- Identify the actual residual core quotients with the cyclic group of order five. -/
theorem residual_factors_models :
    Nonempty ((residual H1 ⧸ pCore 2 (residual H1)) ≃* Multiplicative (ZMod 5)) ∧
    Nonempty ((residual H2 ⧸ pCore 2 (residual H2)) ≃* Multiplicative (ZMod 5)) := by
  obtain ⟨h1,h2⟩ := residual_factors_core_card a d
  exact ⟨⟨mulEquivOfPrimeCardEq h1 (by simp)⟩,⟨mulEquivOfPrimeCardEq h2 (by simp)⟩⟩

private theorem five_generated {B : Subgroup G}
    (hB : Nat.card (residual B ⧸ pCore 2 (residual B)) = 5) :
    closure {x : G | x ∈ residual B ∧ orderOf x = 5} = residual B := by
  let R := residual B
  have h := closure_prime_order_eq_top_of_isPPerfect
    (isPPerfect_embedded_pResidual 2 B) (by decide : Nat.Coprime 2 5) hB
  apply le_antisymm ((closure_le _).mpr (fun _ hx => hx.1))
  intro x hx
  have hle : closure {y : R | orderOf y = 5} ≤
      (closure {y : G | y ∈ R ∧ orderOf y = 5}).comap R.subtype := by
    apply (closure_le _).mpr
    intro y hy
    exact subset_closure ⟨y.property,(Subgroup.orderOf_coe y).trans hy⟩
  exact hle (h.ge (mem_top (⟨x,hx⟩ : R)))

include d in
/-- Each factor residual is generated by its ambient elements of order five. -/
theorem residual_factors_generated :
    closure {x : G | x ∈ residual H1 ∧ orderOf x = 5} = residual H1 ∧
    closure {x : G | x ∈ residual H2 ∧ orderOf x = 5} = residual H2 :=
  ⟨five_generated (residual_factors_core_card a d).1,
    five_generated (residual_factors_core_card a d).2⟩

include d in
/-- The index-two hypothesis identifies the residual join with O²(H). -/
theorem residual_factors_join : residual H1 ⊔ residual H2 = residual H := by
  have hn1 : H1 ⊔ H2 ≤ normalizer (H1 : Set G) := d.join_eq.symm ▸ d.normalizes_first
  have hn2 : H1 ⊔ H2 ≤ normalizer (H2 : Set G) := d.join_eq.symm ▸ d.normalizes_second
  let : (H1.subgroupOf (H1 ⊔ H2)).Normal := normal_subgroupOf_of_le_normalizer hn1
  let : (H2.subgroupOf (H1 ⊔ H2)).Normal := normal_subgroupOf_of_le_normalizer hn2
  change (pResidual 2 H1).map H1.subtype ⊔ (pResidual 2 H2).map H2.subtype = _
  rw [embedded_pResidual_sup_of_relative_normal,d.join_eq]
  exact embedded_twoResidual_eq_of_relIndex_two d.zero_le d.index

include d in
/-- Coprime two-layer centralization removes the central-line error on both supports. -/
theorem residual_factors_centralize_opposite (hHZ : H ≤ centralizer (Z : Set G)) :
    firstSupport a H1 ≤ centralizer (residual H2 : Set G) ∧
    firstSupport a H2 ≤ centralizer (residual H1 : Set G) := by
  have h21 := OddCriticalPair.second_factor_fixes_first_support a T 5 H0 H1 H2 d
  have h12 : ⁅firstSupport a H2,H1⁆ ≤ Z := by
    let W1 := subspaceCommutator a.representation ⊤ (actorImage H H1)
    let W2 := subspaceCommutator a.representation ⊤ (actorImage H H2)
    have hn : actorImage H H1 ≤ subspaceStabilizer a.representation W2 := by
      apply subspaceCommutator_invariant_normalizer a.representation
        (le_subspaceStabilizer _ ⊤ (by intros; trivial))
      exact actorImage_normalizes H2 H1 (d.second_le.trans d.zero_le)
        (d.first_le.trans d.normalizes_second)
    have hf : W2 ≤ fixedSpace a.representation (actorImage H H1) := by
      intro v hv b
      apply sub_eq_zero.mp
      apply Submodule.disjoint_def.mp d.disjoint.symm _
      · exact W2.sub_mem ((hn b.property v).mpr hv) hv
      · exact Submodule.subset_span ⟨b,b.property,v,Submodule.mem_top,rfl⟩
    rw [commutator_comm,commutator_le]
    intro b hb u hu
    have huU := supportPreimage_le a W2 hu
    let bH : H := ⟨b,d.zero_le (d.first_le hb)⟩
    have hh := hf ((mem_supportPreimage a W2 ⟨u,huU⟩).mp hu)
      ⟨QuotientGroup.mk' (pCore 2 H) bH,mem_map_of_mem _ hb⟩
    change a.representation (QuotientGroup.mk' (pCore 2 H) bH)
      (Additive.ofMul (QuotientGroup.mk' (Z.subgroupOf U) ⟨u,huU⟩)) = _ at hh
    rw [a.conjugation] at hh
    have hc := QuotientGroup.eq_iff_div_mem.mp (congrArg Additive.toMul hh)
    change b*u*b⁻¹/u ∈ Z at hc
    simpa only [div_eq_mul_inv,commutatorElement_def] using hc
  have hpZ : IsPGroup 2 Z := (IsElementaryAbelian.isPGroup 2 U).to_le a.kernel_le
  constructor
  · exact le_centralizer_iff.mp (residual_centralizes_of_two_layer H2 _ Z hpZ
      ((d.second_le.trans d.zero_le).trans hHZ) (by rwa [commutator_comm]))
  · exact le_centralizer_iff.mp (residual_centralizes_of_two_layer H1 _ Z hpZ
      ((d.first_le.trans d.zero_le).trans hHZ) (by rwa [commutator_comm]))

include d in
/-- The disjoint actor images distinguish the two residual factors upstairs. -/
theorem residual_factors_ne : residual H1 ≠ residual H2 := by
  intro he
  have hc := (residual_factors_core_card a d).1
  have hd : 5 ∣ Nat.card (residual H1) := hc ▸ card_quotient_dvd_card (pCore 2 (residual H1))
  obtain ⟨x,hx⟩ := exists_prime_orderOf_dvd_card' (G := residual H1) 5 hd
  have hx1 : (x : G) ∈ H1 := residual_le H1 x.property
  have hx2 : (x : G) ∈ H2 := residual_le H2 (he ▸ x.property)
  let xH : H := ⟨x,d.zero_le (d.first_le hx1)⟩
  have hzero : QuotientGroup.mk' (pCore 2 H) xH = 1 :=
    Subgroup.disjoint_def.mp d.actors_disjoint (mem_map_of_mem _ hx1) (mem_map_of_mem _ hx2)
  have hcore : (x : G) ∈ H.pCoreIn 2 :=
    mem_map_of_mem H.subtype ((QuotientGroup.eq_one_iff xH).mp hzero)
  let xQ : H.pCoreIn 2 := ⟨x,hcore⟩
  have ho : orderOf xQ = 5 := (Subgroup.orderOf_coe xQ).symm.trans
    ((Subgroup.orderOf_coe x).trans hx)
  have hcop := (isPGroup_pCoreIn 2 H).orderOf_coprime (by decide : Nat.Coprime 2 5) xQ
  rw [ho] at hcop
  norm_num at hcop

include d in
/-- The original exchange element also exchanges the distinct residual factors. -/
theorem residual_factors_exchanged :
    ∃ x ∈ T, x ∉ normalizer (residual H1 : Set G) ∧
      (residual H1).map (MulAut.conj x⁻¹).toMonoidHom = residual H2 := by
  obtain ⟨x,hx,_,hex⟩ := d.exchanged
  have he : (residual H1).map (MulAut.conj x⁻¹).toMonoidHom = residual H2 := by
    unfold GenerationOne.residual
    rw [map_embedded_pResidual,hex]
  refine ⟨x,hx,?_,he⟩
  intro hn
  have hh : (residual H1).map (MulAut.conj x⁻¹).toMonoidHom = residual H1 :=
    mem_normalizer_iff_map_conj_eq.mp (inv_mem hn)
  exact residual_factors_ne a d (hh.symm.trans he)

include d in
/-- The first residual factor has the source normalizer indices inside T and H. -/
theorem residual_factors_normalizer_index (hTH : T ≤ H) :
    (T ⊓ normalizer (residual H1 : Set G)).relIndex T = 2 ∧
    (H ⊓ normalizer (residual H1 : Set G)).relIndex H = 2 := by
  obtain ⟨x,hx,hnot,_⟩ := residual_factors_exchanged a d
  have hn : H0 ≤ normalizer (residual H1 : Set G) :=
    d.normalizes_first.trans (normalizer_le_normalizer_characteristic_image H1 (pResidual 2 H1))
  exact ⟨normalizer_relIndex_eq_two_of_index_two_overgroup T H H0 _ hTH d.index hn ⟨x,hx,hnot⟩,
    normalizer_relIndex_eq_two_of_index_two_overgroup H H H0 _ le_rfl d.index hn
      ⟨x,hTH hx,hnot⟩⟩

include d in
/-- The actual second residual factor has normalizer of index two in T. -/
theorem residual_second_normalizer_index (hTH : T ≤ H) :
    (T ⊓ normalizer (residual H2 : Set G)).relIndex T = 2 := by
  obtain ⟨x,hx,_,he⟩ := residual_factors_exchanged a d
  have hnot : x ∉ normalizer (residual H2 : Set G) := by
    intro hn
    have he2 : (residual H2).map (MulAut.conj x⁻¹).toMonoidHom = residual H2 :=
      mem_normalizer_iff_map_conj_eq.mp (inv_mem hn)
    exact residual_factors_ne a d
      (map_injective (MulAut.conj x⁻¹).injective (he.trans he2.symm))
  have hn : H0 ≤ normalizer (residual H2 : Set G) :=
    d.normalizes_second.trans
      (normalizer_le_normalizer_characteristic_image H2 (pResidual 2 H2))
  exact normalizer_relIndex_eq_two_of_index_two_overgroup T H H0 _ hTH d.index hn ⟨x,hx,hnot⟩

include a in
omit [Finite G] in
private theorem commutator_le_residual_core {B : Subgroup G} (hB : B ≤ H)
    (hUB : U ≤ B) : ⁅U,residual B⁆ ≤ (residual B).pCoreIn 2 := by
  have hUN : U ≤ normalizer (residual B : Set G) :=
    hUB.trans (B.le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image B (pResidual 2 B)))
  have hRN : residual B ≤ normalizer (U : Set G) := (residual_le B).trans (hB.trans a.normalizes)
  have hm : U ⊓ residual B ≤ (residual B).pCoreIn 2 :=
    le_pCoreIn_of_normalizes ((IsElementaryAbelian.isPGroup 2 U).to_le inf_le_left)
      inf_le_right ((le_inf hRN (residual B).le_normalizer).trans inf_normalizer_le_normalizer_inf)
  exact (le_inf (le_normalizer_iff_commutator_le_left.mp hRN)
    (le_normalizer_iff_commutator_le_right.mp hUN)).trans hm

include d in
omit [Finite G] in
/-- Both source commutators place the original point in the intrinsic factor cores. -/
theorem residual_factors_point_core (hUQ : U ≤ H.pCoreIn 2) :
    Z ≤ (residual H1).pCoreIn 2 ∧ Z ≤ (residual H2).pCoreIn 2 :=
  ⟨d.point_first.trans (commutator_le_residual_core a (d.first_le.trans d.zero_le)
      (hUQ.trans d.core_le_first)),
    d.point_second.trans (commutator_le_residual_core a (d.second_le.trans d.zero_le)
      (hUQ.trans d.core_le_second))⟩

end CFSG.Quasithin.Chapter14.Section06.OddNormalizer.Quintic.ModuleGeometry
