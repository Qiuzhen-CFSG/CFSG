module
public import CFSG.Quasithin.Chapter14.Section06.SourceSuitableChoice.OddNormalizer.Quintic.ModuleGeometry.ResidualSource
public import Theory.GroupTheory.CComponent.NormalPair
public import Theory.SpecificGroups.PSL2.SixteenWreathComponents
public import Theory.GroupTheory.PResidual.SimplePrimeOrderGeneration
public import Theory.GroupTheory.IndexTwoIntersection
public import Theory.GroupTheory.PResidual.NormalizerImage

/-!
# The exchanged PSL₂(16) factors in original14.6.15

The fourth14.6.14 alternative gives an actual normal product of exchanged
C-components in Mc and an isomorphism Mc/O₂(Mc) ≃ Aut(PSL₂(16)) wr C₂.
The wreath-component calculation identifies both intrinsic core quotients
with PSL₂(16). The factors are generated by their elements of order five.
Their normalizers have index two in Mc, and the second normalizer has the
original two-core and the required Sylow index.

Every quintic element of Mc maps into the component pair. Two-perfectness
lifts membership through the normalizing two-core, giving θ(C_G(Z)) = K_z.
Separately Z lies in O₂(K_z), so maximal two-locality gives N_G(K_z) = Mc
in both closure branches.

`exists_source_exchanged_factor_data` constructs all these conclusions from
the original Context in the nonresidual branch. ExchangedSource applies
this data to the literal second-normalizer and component consumers. The
source module marking, opposite-support centralization and conjugated
centralizer identity, as well as the residual-branch index and terminal
comparisons, remain with qt-e-14615-quintic-exclusion. The earlier14.6.12--14
inputs retain final discharge with qt-e-suitable-odd-normalizer.
No disputed ordinary-centralizer residual identity is used.

Source: Aschbacher--Smith14.6.14(4) and14.6.15, printed pp.1033--1035.
-/

public section
open Subgroup Theory.GroupTheory Representation.BinaryOffender
open scoped IsMulCommutative Pointwise
namespace CFSG.Quasithin.Chapter14.Section06.OddNormalizer.Quintic.ModuleGeometry
open Chapter15.Section03.AbelianAmalgam Chapter15.Section03.AbelianAmalgam.GenerationOne
open SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
open ComponentExclusion
variable {G : Type*} [Group G] [Finite G]

/-- Proved group-theoretic geometry of the actual exchanged pair. Its
construction below uses the original fourth closure alternative. The source
module marking and the conjugated centralizer identity are separate. -/
structure ExchangedFactorData (T Mc H Z : Subgroup G) where
  K1 : Subgroup G
  K2 : Subgroup G
  first_le : K1 ≤ Mc
  second_le : K2 ≤ Mc
  first_component : (K1.subgroupOf Mc).IsCComponent
  second_component : (K2.subgroupOf Mc).IsCComponent
  join_eq : K1 ⊔ K2 = residualClosure H Mc
  first_model : Nonempty ((K1 ⧸ pCore 2 K1) ≃* Theory.PSL2.SixteenWreathComponents.L)
  second_model : Nonempty ((K2 ⧸ pCore 2 K2) ≃* Theory.PSL2.SixteenWreathComponents.L)
  first_generated : closure {x : G | x ∈ K1 ∧ orderOf x = 5} = K1
  second_generated : closure {x : G | x ∈ K2 ∧ orderOf x = 5} = K2
  exchanged : ∃ t ∈ T, t ∉ normalizer (K1 : Set G) ∧
    K1.map (MulAut.conj t⁻¹).toMonoidHom = K2
  first_index : (Mc ⊓ normalizer (K1 : Set G)).relIndex Mc = 2
  second_index : (Mc ⊓ normalizer (K2 : Set G)).relIndex Mc = 2
  sylow_index : (T ⊓ normalizer (K2 : Set G)).relIndex T = 2
  intersection_core : (Mc ⊓ normalizer (K2 : Set G)).pCoreIn 2 = Mc.pCoreIn 2
  point_closure : closure {x : G | x ∈ centralizer (Z : Set G) ∧ orderOf x = 5} =
    residualClosure H Mc
  closure_normalizer : normalizer (residualClosure H Mc : Set G) = Mc

variable {T : Sylow 2 G} {M Mc H H0 H1 H2 : Subgroup G}
    [IsElementaryAbelian 2 (conjugateSpanBy (localModule T M) H)]
    {a : LocalQuotientAction H (conjugateSpanBy (localModule T M) H) (centralInvolutions T)}
    (s : Context T M Mc H H0 H1 H2 a)

include s in
/-- The central point lies in the closure two-core, so maximality identifies its normalizer. -/
theorem source_closure_normalizer : normalizer (residualClosure H Mc : Set G) = Mc := by
  let K := residualClosure H Mc
  have hZ : centralInvolutions T ≤ K :=
    ((source_residual_factor_point_core s).2.trans (pCoreIn_le 2 _)).trans
      (((residual_factors_join a s.factors) ▸ le_sup_right).trans (le_conjugateSpanBy _ _))
  have hKM : K ≤ Mc := by
    apply conjugateSpanBy_le
    · have hHM : H ≤ Mc := by
        have he := (Section02.source_lemma_14_2_3 s.ambient T s.empty s.maximal s.unique
          s.many s.module_card s.action H s.outside.1 s.outside.2).1
        exact (show Mc ∈ maximalTwoLocalOvergroups H from he ▸ Set.mem_singleton Mc).2
      exact (residual_le H).trans hHM
    · exact Mc.le_normalizer
  have hZN : K ≤ normalizer (centralInvolutions T : Set G) :=
    (hKM.trans_eq (partner_eq_centralizer s)).trans (Subgroup.centralizer_le_normalizer _)
  have hZQ : centralInvolutions T ≤ K.pCoreIn 2 :=
    le_pCoreIn_of_normalizes ((IsElementaryAbelian.isPGroup 2
      (conjugateSpanBy (localModule T M) H)).to_le a.kernel_le) hZ hZN
  have hne : K.pCoreIn 2 ≠ ⊥ := by
    intro hb
    have hz := bot_unique (hb ▸ hZQ)
    have hc := plane_centralInvolutions_card T M s.maximal.1.2 s.module_card s.action
    have hc0 : Nat.card (centralInvolutions T) = 1 := (eq_bot_iff_card _).mp hz
    omega
  have hMN : Mc ≤ normalizer (K : Set G) := le_normalizer_conjugateSpanBy _ _
  have hNQ : normalizer (K : Set G) ≤ normalizer (K.pCoreIn 2 : Set G) :=
    normalizer_le_normalizer_characteristic_image K (pCore 2 K)
  have hmax : IsMaximalTwoLocal Mc :=
    (show Mc ∈ maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) from
      s.unique ▸ Set.mem_singleton Mc).1
  exact le_antisymm (hNQ.trans (hmax.2 ⟨_,hne,isPGroup_pCoreIn 2 K,rfl⟩
    (hMN.trans hNQ))) hMN

/-- Identify the intrinsic core quotient through the original ambient quotient map. -/
theorem exchanged_factor_core_model {K : Subgroup G} (hK : K ≤ Mc)
    (hc : (K.subgroupOf Mc).IsCComponent)
    (e : (Mc ⧸ pCore 2 Mc) ≃* Theory.PSL2.SixteenWreathComponents.W) :
    Nonempty ((K ⧸ pCore 2 K) ≃* Theory.PSL2.SixteenWreathComponents.L) := by
  obtain ⟨f⟩ := Theory.PSL2.SixteenWreathComponents.coreQuotient_component_equiv e hc
  let b := subgroupOfEquivOfLe hK
  exact ⟨(QuotientGroup.congr _ _ b (pCore_map_iso 2 b)).symm.trans f⟩

/-- Each original component is generated by its ambient elements of exact order five. -/
theorem exchanged_factor_five_generated {K : Subgroup G} (hK : K ≤ Mc)
    (hc : (K.subgroupOf Mc).IsCComponent)
    (e : (Mc ⧸ pCore 2 Mc) ≃* Theory.PSL2.SixteenWreathComponents.W) :
    closure {x : G | x ∈ K ∧ orderOf x = 5} = K := by
  obtain ⟨f⟩ := exchanged_factor_core_model hK hc e
  let := Theory.PSL2.SixteenWreathComponents.simple
  let : IsSimpleGroup (K ⧸ pCore 2 K) := f.isSimpleGroup
  let := hc.perfect
  let : Group.IsPerfect K := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe hK).toMonoidHom) (subgroupOfEquivOfLe hK).surjective
  have hp : IsPPerfect 2 K := by
    intro N hN hQ
    let := hN
    let : Group.IsNilpotent (K ⧸ N) := hQ.isNilpotent
    exact top_le_iff.mp (le_of_isPerfect_of_solvable_quotient ⊤ N)
  have hd : 5 ∣ Nat.card (K ⧸ pCore 2 K) := by
    rw [Nat.card_congr f.toEquiv]
    exact Theory.PSL2.SixteenWreathComponents.five_dvd_card
  have ht := closure_prime_order_eq_top_of_simple_quotient (pCore 2 K)
    pCore_isPGroup hp (by decide : Nat.Coprime 2 5) hd
  apply le_antisymm ((closure_le _).mpr (fun _ hx => hx.1))
  intro x hx
  have hl : closure {y : K | orderOf y = 5} ≤
      (closure {y : G | y ∈ K ∧ orderOf y = 5}).comap K.subtype := by
    apply (closure_le _).mpr
    intro y hy
    exact subset_closure ⟨y.property,(Subgroup.orderOf_coe y).trans hy⟩
  exact hl (ht.ge (mem_top (⟨x,hx⟩ : K)))

include s in
/-- The original exchanged pair has component normalizers of index two inside Mc. -/
theorem source_exchanged_factor_indices {K1 : Subgroup G} (h1 : K1 ≤ Mc)
    (hc : (K1.subgroupOf Mc).IsCComponent) {t : G} (ht : t ∈ T)
    (hnt : t ∉ normalizer (K1 : Set G))
    (hprod : (residualClosure H Mc : Set G) =
      (K1 : Set G) * (K1.map (MulAut.conj t⁻¹).toMonoidHom : Set G)) :
    let K2 := K1.map (MulAut.conj t⁻¹).toMonoidHom
    K2 ≤ Mc ∧ (K2.subgroupOf Mc).IsCComponent ∧
      K1 ⊔ K2 = residualClosure H Mc ∧
      (Mc ⊓ normalizer (K1 : Set G)).relIndex Mc = 2 ∧
      (Mc ⊓ normalizer (K2 : Set G)).relIndex Mc = 2 := by
  let K2 := K1.map (MulAut.conj t⁻¹).toMonoidHom
  have hTM : (T : Subgroup G) ≤ Mc := by
    rw [partner_eq_centralizer s]
    exact le_centralizer_iff.mp (centralInvolutions_le_centralizer_sylow T)
  let r : Mc := ⟨t⁻¹,hTM (inv_mem ht)⟩
  have h2 : K2 ≤ Mc := conj_smul_le_of_le h1 r
  have he : (K1.subgroupOf Mc).conjBy r = K2.subgroupOf Mc :=
    conj_smul_subgroupOf h1 r
  have hc2 : (K2.subgroupOf Mc).IsCComponent :=
    he ▸ hc.map_equiv (MulAut.conj r)
  have hj : K1 ⊔ K2 = residualClosure H Mc := by
    rw [sup_eq_closure_mul,←hprod,closure_eq]
  have hn : ((K1.subgroupOf Mc) ⊔ (K1.subgroupOf Mc).conjBy r).Normal := by
    rw [he,←subgroupOf_sup h1 h2,hj]
    exact normal_subgroupOf_of_le_normalizer (le_normalizer_conjugateSpanBy _ _)
  let := hn
  have hne : K1.subgroupOf Mc ≠ (K1.subgroupOf Mc).conjBy r := by
    intro hh
    have hm := mem_normalizer_iff_map_conj_eq.mpr hh.symm
    rw [←subgroupOf_normalizer_eq h1] at hm
    have hmi : t⁻¹ ∈ normalizer (K1 : Set G) := hm
    have hmt := (normalizer (K1 : Set G)).inv_mem hmi
    exact hnt (by simpa only [inv_inv] using hmt)
  have hi1 := hc.normalizer_index_two_of_normal_pair r hne
  have hi2 : (normalizer (K2.subgroupOf Mc : Set Mc)).index = 2 := by
    rw [←he]
    change (normalizer ((K1.subgroupOf Mc).map (MulAut.conj r).toMonoidHom : Set Mc)).index = 2
    rw [←map_equiv_normalizer_eq (K1.subgroupOf Mc) (MulAut.conj r),
      index_map_of_bijective (MulAut.conj r).bijective]
    exact hi1
  have hi (K : Subgroup G) (hK : K ≤ Mc)
      (h : (normalizer (K.subgroupOf Mc : Set Mc)).index = 2) :
      (Mc ⊓ normalizer (K : Set G)).relIndex Mc = 2 := by
    rw [inf_relIndex_left]
    change ((normalizer (K : Set G)).subgroupOf Mc).index = 2
    rwa [subgroupOf_normalizer_eq hK]
  exact ⟨h2,hc2,hj,hi K1 h1 hi1,hi K2 h2 hi2⟩

/-- Transport the core of the relative component normalizer back into the ambient group. -/
theorem component_normalizer_intersection_core {K : Subgroup G} (hK : K ≤ Mc)
    (hc : (K.subgroupOf Mc).IsCComponent)
    (hi : (Mc ⊓ normalizer (K : Set G)).relIndex Mc = 2) :
    (Mc ⊓ normalizer (K : Set G)).pCoreIn 2 = Mc.pCoreIn 2 := by
  have hi' : (normalizer (K.subgroupOf Mc : Set Mc)).index = 2 := by
    rw [inf_relIndex_left] at hi
    change ((normalizer (K : Set G)).subgroupOf Mc).index = 2 at hi
    rwa [subgroupOf_normalizer_eq hK] at hi
  let : (normalizer (K.subgroupOf Mc : Set Mc)).Normal := normal_of_index_eq_two hi'
  have hh := congrArg (map Mc.subtype) (hc.normalizer_pCoreIn 2)
  rw [map_pCoreIn_of_injective 2 _ Mc.subtype Mc.subtype_injective,
    ←subgroupOf_normalizer_eq hK,subgroupOf_map_subtype] at hh
  change (Mc ⊓ normalizer (K : Set G)).pCoreIn 2 = (pCore 2 Mc).map Mc.subtype
  simpa only [inf_comm] using hh

/-- Every quintic element of Mc lies in the actual two-component product. -/
theorem exchanged_pair_quintic_elements {K1 K2 : Subgroup G}
    (h1 : K1 ≤ Mc) (h2 : K2 ≤ Mc)
    (hc1 : (K1.subgroupOf Mc).IsCComponent) (hc2 : (K2.subgroupOf Mc).IsCComponent)
    (hne : K1 ≠ K2)
    (e : (Mc ⧸ pCore 2 Mc) ≃* Theory.PSL2.SixteenWreathComponents.W)
    {x : G} (hx : x ∈ Mc) (ho : orderOf x = 5) : x ∈ K1 ⊔ K2 := by
  let A := K1.subgroupOf Mc
  let B := K2.subgroupOf Mc
  let q := QuotientGroup.mk' (pCore 2 Mc)
  let f := e.toMonoidHom.comp q
  let : Group.IsNilpotent (pCore 2 Mc) := pCore_isPGroup.isNilpotent
  have hA : (A.map f).IsCComponent := by
    rw [show A.map f = (A.map q).map e.toMonoidHom from (map_map _ _ _).symm]
    exact (hc1.map_quotient (pCore 2 Mc)).map_equiv e
  have hB : (B.map f).IsCComponent := by
    rw [show B.map f = (B.map q).map e.toMonoidHom from (map_map _ _ _).symm]
    exact (hc2.map_quotient (pCore 2 Mc)).map_equiv e
  have hn : A.map f ≠ B.map f := by
    intro he
    change A.map (e.toMonoidHom.comp q) = B.map (e.toMonoidHom.comp q) at he
    rw [←map_map,←map_map] at he
    have hab := hc1.eq_of_map_quotient_eq hc2 (pCore 2 Mc) (map_injective e.injective he)
    exact hne (by simpa only [map_subgroupOf_eq_of_le h1,map_subgroupOf_eq_of_le h2]
      using congrArg (map Mc.subtype) hab)
  have him : f ⟨x,hx⟩ ∈ (A ⊔ B : Subgroup Mc).map f := by
    rw [Subgroup.map_sup]
    apply Theory.PSL2.SixteenWreathComponents.quintic_mem_component_pair hA hB hn
    rw [←map_pow]
    have he : (⟨x,hx⟩ : Mc) ^ 5 = 1 := Subtype.ext (ho ▸ pow_orderOf_eq_one x)
    rw [he,map_one]
  have hk : f.ker = pCore 2 Mc := by
    rw [MonoidHom.ker_comp_of_injective q e.toMonoidHom e.injective,QuotientGroup.ker_mk']
  have hkn : f.ker ≤ normalizer ((A ⊔ B : Subgroup Mc) : Set Mc) := by
    rw [hk]
    exact (le_inf (hc1.pCore_le_normalizer 2) (hc2.pCore_le_normalizer 2)).trans
      (normalizer_inf_normalizer_le_normalizer_sup _ _)
  have hp : Group.IsPerfect (A ⊔ B : Subgroup Mc) := by
    rw [isPerfect_iff]
    apply le_antisymm (A ⊔ B).commutator_le_self
    apply sup_le
    · exact (isPerfect_iff.mp hc1.perfect).ge.trans
        (commutator_mono le_sup_left le_sup_left)
    · exact (isPerfect_iff.mp hc2.perfect).ge.trans
        (commutator_mono le_sup_right le_sup_right)
  let := hp
  have hpp : IsPPerfect 2 (A ⊔ B : Subgroup Mc) := by
    intro N hN hQ
    let := hN
    let : Group.IsNilpotent ((A ⊔ B : Subgroup Mc) ⧸ N) := hQ.isNilpotent
    exact top_le_iff.mp (le_of_isPerfect_of_solvable_quotient ⊤ N)
  have hxp : (⟨x,hx⟩ : Mc) ∈ (A ⊔ B) ⊔ f.ker := by
    have hh : (⟨x,hx⟩ : Mc) ∈ (((A ⊔ B : Subgroup Mc).map f).comap f) := him
    rwa [comap_map_eq] at hh
  have hxAB : (⟨x,hx⟩ : Mc) ∈ A ⊔ B := by
    rw [←embedded_pResidual_sup_kernel f (A ⊔ B) hpp
      (by rw [hk]; exact pCore_isPGroup) hkn]
    refine ⟨⟨⟨x,hx⟩,hxp⟩,mem_pResidual_of_orderOf_coprime ?_,rfl⟩
    rw [←Subgroup.orderOf_coe,←Subgroup.orderOf_coe,ho]
    decide
  rw [←subgroupOf_sup h1 h2] at hxAB
  exact hxAB

include s in
/-- The source point-centralizer closure is the actual exchanged component product. -/
theorem source_exchanged_point_closure {K1 K2 : Subgroup G}
    (h1 : K1 ≤ Mc) (h2 : K2 ≤ Mc)
    (hc1 : (K1.subgroupOf Mc).IsCComponent) (hc2 : (K2.subgroupOf Mc).IsCComponent)
    (hne : K1 ≠ K2) (hj : K1 ⊔ K2 = residualClosure H Mc)
    (e : (Mc ⧸ pCore 2 Mc) ≃* Theory.PSL2.SixteenWreathComponents.W) :
    closure {x : G | x ∈ centralizer (centralInvolutions T : Set G) ∧ orderOf x = 5} =
      residualClosure H Mc := by
  apply le_antisymm
  · apply (closure_le _).mpr
    intro x hx
    rw [←hj]
    exact exchanged_pair_quintic_elements h1 h2 hc1 hc2 hne e
      ((partner_eq_centralizer s).ge hx.1) hx.2
  · rw [←hj]
    have hfactor (K : Subgroup G) (hK : K ≤ Mc) (hc : (K.subgroupOf Mc).IsCComponent) :
        K ≤ closure {x : G | x ∈ centralizer (centralInvolutions T : Set G) ∧ orderOf x = 5} := by
      rw [←exchanged_factor_five_generated hK hc e]
      apply Subgroup.closure_mono
      intro x hx
      exact ⟨(partner_eq_centralizer s).le (hK hx.1),hx.2⟩
    exact sup_le (hfactor K1 h1 hc1) (hfactor K2 h2 hc2)

include s in
/-- Construct the exchanged group geometry from the original fourth closure alternative. -/
theorem exists_source_exchanged_factor_data (hstrict : residualClosure H Mc ≠ residual H) :
    Nonempty (ExchangedFactorData (T : Subgroup G) Mc H (centralInvolutions T)) := by
  have hcase : ExchangedComponentClosure (T : Subgroup G) Mc (residualClosure H Mc) ∧
      Nonempty ((Mc ⧸ pCore 2 Mc) ≃* Theory.PSL2.SixteenWreathComponents.W) := by
    rcases s.alternatives with hh | hh | hh | hh
    · exact (hstrict hh.1).elim
    · norm_num at hh
    · norm_num at hh
    · exact hh.2
  obtain ⟨K1,h1,hc1,t,ht,hnt,hprod⟩ := hcase.1
  obtain ⟨e⟩ := hcase.2
  let K2 := K1.map (MulAut.conj t⁻¹).toMonoidHom
  obtain ⟨h2,hc2,hj,hi1,hi2⟩ := source_exchanged_factor_indices s h1 hc1 ht hnt hprod
  have hne : K1 ≠ K2 := by
    intro he
    have hm : t⁻¹ ∈ normalizer (K1 : Set G) := mem_normalizer_iff_map_conj_eq.mpr he.symm
    exact hnt (inv_mem_iff.mp hm)
  have hnt2 : t ∉ normalizer (K2 : Set G) := by
    intro hn
    have he2 : K2.map (MulAut.conj t⁻¹).toMonoidHom = K2 :=
      mem_normalizer_iff_map_conj_eq.mp (inv_mem hn)
    exact hne (map_injective (MulAut.conj t⁻¹).injective he2.symm)
  have hTM : (T : Subgroup G) ≤ Mc := by
    rw [partner_eq_centralizer s]
    exact le_centralizer_iff.mp (centralInvolutions_le_centralizer_sylow T)
  exact ⟨{
    K1 := K1
    K2 := K2
    first_le := h1
    second_le := h2
    first_component := hc1
    second_component := hc2
    join_eq := hj
    first_model := exchanged_factor_core_model h1 hc1 e
    second_model := exchanged_factor_core_model h2 hc2 e
    first_generated := exchanged_factor_five_generated h1 hc1 e
    second_generated := exchanged_factor_five_generated h2 hc2 e
    exchanged := ⟨t,ht,hnt,rfl⟩
    first_index := hi1
    second_index := hi2
    sylow_index := normalizer_relIndex_eq_two_of_index_two_overgroup (T : Subgroup G)
      Mc (Mc ⊓ normalizer (K2 : Set G)) K2 hTM hi2 inf_le_right ⟨t,ht,hnt2⟩
    intersection_core := component_normalizer_intersection_core h2 hc2 hi2
    point_closure := source_exchanged_point_closure s h1 h2 hc1 hc2 hne hj e
    closure_normalizer := source_closure_normalizer s }⟩

end CFSG.Quasithin.Chapter14.Section06.OddNormalizer.Quintic.ModuleGeometry
