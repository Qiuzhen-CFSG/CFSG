/-!
# The exceptional rows of the terminal component sieve

Original 14.6.18 places the invariant cubic lifts in M. For A₇ those
lifts generate the whole quotient. For M₂₂ their join contains a perfect
subgroup of three-rank two. In either case the original centralizer rank
bound for perfect subgroups in M gives a contradiction. Relative normality
is derived from the component's three-rank and the rank bound inside H;
it is not an additional source hypothesis.

These are the A₇ and M₂₂ exclusions in Aschbacher--Smith 14.6.20,
printed p.1037. The only retained earlier-source premise is 14.6.18,
owned by qt-e-14625-source. The remaining Lie-type and diagram analysis
belongs to qt-e-suitable-component-supports.
-/

public section
open Subgroup Theory.GroupTheory Stellmacher
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter14.Section06.ComponentSupports.Classification.Sieve
open SourcePreliminaries Chapter15.Section03 ChapterA.Section05To06
open Sporadic.Mathieu
variable {G : Type*} [Group G] [Finite G]

private theorem source_le_of_invariant_cubic_generation
    (T : Sylow 2 G) (M : Subgroup G) (hTM : (T : Subgroup G) ≤ M)
    (hsolv : ∀ J ∈ Chapter1.HOver G (T : Set G), Group.IsSolvable J → J ≤ M)
    (H : Subgroup G) (hH : H ∈ Chapter1.HOver G (T : Set G))
    (K : Subgroup G) (hKH : K ≤ H)
    (hn : (T : Subgroup G) ≤ normalizer (K : Set G))
    {B : Type*} [Group B] [Finite B] (eK : (K ⧸ pCore 2 K) ≃* B)
    (hgen : ∀ (P : Sylow 2 B) (N : Subgroup B), (P : Subgroup B) ≤ N →
      (∀ J : Subgroup B, (P : Subgroup B) ≤ J → (P : Subgroup B).relIndex J = 3 →
        (∀ b : MulAut B, (P : Subgroup B).map b.toMonoidHom = P →
          J.map b.toMonoidHom = J) → J ≤ N) → N = ⊤) : K ≤ M := by
  obtain ⟨P,hP⟩ := NormalSylowQuotientAction.intersection_sylow T K hn
  let q := eK.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 K))
  have hq : Function.Surjective q := eK.surjective.comp (QuotientGroup.mk'_surjective _)
  let N := M.subgroupOf K
  have hPN : (P : Subgroup K) ≤ N := by
    rw [hP]
    exact fun _ hx => hTM hx
  have hker : q.ker = pCore 2 K := by
    rw [MonoidHom.ker_comp_of_injective _ _ eK.injective,QuotientGroup.ker_mk']
  have hkerN : q.ker ≤ N :=
    (hker ▸ pCore_isPGroup.le_sylow_of_normal P).trans hPN
  have hm : N.map q = ⊤ := hgen (P.mapSurjective hq) (N.map q) (map_mono hPN)
    (fun J _ hi hinv =>
      source_invariant_cubic_le_image T M hsolv H hH K hKH hn eK P hP J hi hinv)
  have hN : N = ⊤ := by
    have hh := congrArg (Subgroup.comap q) hm
    rwa [comap_map_eq,sup_eq_left.mpr hkerN,comap_top] at hh
  intro k hk
  exact show (⟨k,hk⟩ : K) ∈ N from hN ▸ mem_top _

/-- The actual A₇ quotient is generated by invariant solvable lifts, so the
normalized original subgroup lies in M under 14.6.18. -/
theorem source_normalized_a7_le
    (T : Sylow 2 G) (M : Subgroup G) (hTM : (T : Subgroup G) ≤ M)
    (hsolv : ∀ J ∈ Chapter1.HOver G (T : Set G), Group.IsSolvable J → J ≤ M)
    (H : Subgroup G) (hH : H ∈ Chapter1.HOver G (T : Set G))
    (K : Subgroup G) (hKH : K ≤ H)
    (hn : (T : Subgroup G) ≤ normalizer (K : Set G))
    (eK : (K ⧸ pCore 2 K) ≃* alternatingGroup (Fin 7)) : K ≤ M :=
  source_le_of_invariant_cubic_generation T M hTM hsolv H hH K hKH hn eK
    AlternatingSeven.InvariantCubicGeneration.sylow_invariant_cubic_generation

variable (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hunique : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hab : IsMulCommutative (conjugateSpanBy (localModule T M) Mc))
    (hsolv : ∀ J ∈ Chapter1.HOver G (T : Set G), Group.IsSolvable J → J ≤ M)

include hG hempty hM hunique hmany hcard e hab hsolv in
/-- The source component quotient is centerless as well as simple: it is a
nontrivial quotient of a perfect group. -/
theorem source_component_quotient_center_eq_bot
    (H : Subgroup G) (hH : H ∈ Chapter1.HOutside G (T : Set G) (M : Set G))
    (K : Subgroup G) (hKH : K ≤ H) (hK : (K.subgroupOf H).IsCComponent) :
    center (K ⧸ pCore 2 K) = ⊥ := by
  let : Group.IsPerfect (K.subgroupOf H) := hK.perfect
  let : Group.IsPerfect K := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe hKH).toMonoidHom) (subgroupOfEquivOfLe hKH).surjective
  let : IsSimpleGroup (K ⧸ pCore 2 K) :=
    source_component_quotient_simple hG T hempty hM hunique hmany hcard e hab hsolv H hH K hKH hK
  rcases (inferInstance : (center (K ⧸ pCore 2 K)).Normal).eq_bot_or_eq_top with hc | hc
  · exact hc
  · exact (Group.IsPerfect.not_isMulCommutative _ (center_eq_top_iff.mp hc)).elim

include hG hempty hM hunique hmany hcard e hab hsolv in
/-- A source component whose simple two-core quotient has three-rank two is
normal in its actual H. Thus exceptional rows need no extra normality premise. -/
theorem source_component_normal_of_quotient_threeRank
    (H : Subgroup G) (hH : H ∈ Chapter1.HOutside G (T : Set G) (M : Set G))
    (K : Subgroup G) (hKH : K ≤ H) (hK : (K.subgroupOf H).IsCComponent)
    (hr : 2 ≤ primeRank 3 (K ⧸ pCore 2 K)) : H ≤ normalizer (K : Set G) := by
  let a := subgroupOfEquivOfLe hKH
  let aq := QuotientGroup.congr (pCore 2 (K.subgroupOf H)) (pCore 2 K) a (pCore_map_iso 2 a)
  let : Group.IsPerfect (K.subgroupOf H) := hK.perfect
  let : IsSimpleGroup (K ⧸ pCore 2 K) :=
    source_component_quotient_simple hG T hempty hM hunique hmany hcard e hab hsolv H hH K hKH hK
  let : IsSimpleGroup ((K.subgroupOf H) ⧸ pCore 2 (K.subgroupOf H)) := aq.isSimpleGroup
  have hz : center ((K.subgroupOf H) ⧸ pCore 2 (K.subgroupOf H)) = ⊥ := by
    rcases (inferInstance : (center ((K.subgroupOf H) ⧸ pCore 2 (K.subgroupOf H))).Normal).eq_bot_or_eq_top with hc | hc
    · exact hc
    · exact (Group.IsPerfect.not_isMulCommutative _ (center_eq_top_iff.mp hc)).elim
  let : IsQuasisimple ((K.subgroupOf H) ⧸ pCore 2 (K.subgroupOf H)) :=
    ⟨((QuotientGroup.quotientMulEquivOfEq hz).trans QuotientGroup.quotientBot).isSimpleGroup⟩
  have hr' : 2 ≤ primeRank 3 ((K.subgroupOf H) ⧸ pCore 2 (K.subgroupOf H)) := by
    rwa [primeRank_congr 3 aq]
  have hrH : primeRank 3 H ≤ 2 :=
    (Chapter3.sqtk_of_mem_H hG hH.1.1).stronglyQuasithin 3 Nat.prime_three (by decide)
  exact (normal_subgroupOf_iff_le_normalizer hKH).mp
    (hK.normal_of_centerless_core_threeRank hz hr' hrH)

include hG hempty hM hunique hmany hcard e hsolv in
/-- The invariant cubic pair of M₂₂ forces a perfect rank-two subgroup into
the image of M, contradicting the original centralizer rank bound. -/
theorem source_normalized_m22_false
    (H : Subgroup G) (hH : H ∈ Chapter1.HOver G (T : Set G))
    (K : Subgroup G) (hKH : K ≤ H)
    (hn : (T : Subgroup G) ≤ normalizer (K : Set G))
    (eK : (K ⧸ pCore 2 K) ≃* M22) : False := by
  obtain ⟨P,hP⟩ := NormalSylowQuotientAction.intersection_sylow T K hn
  let q := eK.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 K))
  have hq : Function.Surjective q := eK.surjective.comp (QuotientGroup.mk'_surjective _)
  have hker : q.ker = pCore 2 K := by
    rw [MonoidHom.ker_comp_of_injective _ _ eK.injective,QuotientGroup.ker_mk']
  let Pq := P.mapSurjective hq
  obtain ⟨D,hD,hperf,hr⟩ := CubicHexadCover.invariant_cubic_rank
    (MonoidHom.id M22) Function.surjective_id (by simp) (by simp)
    (fun a => ⟨a,fun _ => rfl⟩) Pq ((M.subgroupOf K).map q) (by
      intro J _ hi hinv
      exact source_invariant_cubic_le_image T M hsolv H hH K hKH hn eK P hP J hi hinv)
  let := hperf
  have hb := Section03.EmptyFamilySieve.source_perfect_image_threeRank_le_one
    hG T hempty hM hunique hmany hcard e K q (hker.symm ▸ pCore_isPGroup) D hD
  omega

include hG hempty hM hunique hmany hcard e hab hsolv in
/-- The A₇ row is impossible for every original relative C-component.
Both its relative normality and its placement in M are proved here. -/
theorem source_component_a7_false
    (H : Subgroup G) (hH : H ∈ Chapter1.HOutside G (T : Set G) (M : Set G))
    (K : Subgroup G) (hKH : K ≤ H) (hK : (K.subgroupOf H).IsCComponent)
    (eK : (K ⧸ pCore 2 K) ≃* alternatingGroup (Fin 7)) : False := by
  have hr : 2 ≤ primeRank 3 (K ⧸ pCore 2 K) := by
    rw [primeRank_congr 3 eK]
    exact alternatingGroup.TwoThreeCycles.two_le_primeRank (by decide)
  have hn := source_component_normal_of_quotient_threeRank
    hG T hempty hM hunique hmany hcard e hab hsolv H hH K hKH hK hr
  have hKM := source_normalized_a7_le T M hM.1.2 hsolv H hH.1 K hKH (hH.1.2.trans hn) eK
  let : Group.IsPerfect (K.subgroupOf H) := hK.perfect
  let : Group.IsPerfect K := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe hKH).toMonoidHom) (subgroupOfEquivOfLe hKH).surjective
  have hb := Section03.EmptyFamilySieve.source_perfect_threeRank_le_one
    hG T hempty hM hunique hmany hcard e K hKM
  have hq := primeRank_quotient_le_of_isTwoGroup 3 (by decide) (pCore 2 K) pCore_isPGroup
  omega

include hG hempty hM hunique hmany hcard e hab hsolv in
/-- The M₂₂ row is impossible for every original relative C-component.
The native invariant hexad pair also supplies the rank needed for normality. -/
theorem source_component_m22_false
    (H : Subgroup G) (hH : H ∈ Chapter1.HOutside G (T : Set G) (M : Set G))
    (K : Subgroup G) (hKH : K ≤ H) (hK : (K.subgroupOf H).IsCComponent)
    (eK : (K ⧸ pCore 2 K) ≃* M22) : False := by
  let P : Sylow 2 M22 := Classical.choice inferInstance
  obtain ⟨D,_,_,hr⟩ := CubicHexadCover.invariant_cubic_rank
    (MonoidHom.id M22) Function.surjective_id (by simp) (by simp)
    (fun a => ⟨a,fun _ => rfl⟩) P ⊤ (fun _ _ _ _ => le_top)
  have hrK : 2 ≤ primeRank 3 (K ⧸ pCore 2 K) := by
    rw [primeRank_congr 3 eK]
    exact hr.trans (primeRank_subgroup_le 3 D)
  have hn := source_component_normal_of_quotient_threeRank
    hG T hempty hM hunique hmany hcard e hab hsolv H hH K hKH hK hrK
  exact source_normalized_m22_false hG T hempty hM hunique hmany hcard e hsolv
    H hH.1 K hKH (hH.1.2.trans hn) eK
end CFSG.Quasithin.Chapter14.Section06.ComponentSupports.Classification.Sieve
