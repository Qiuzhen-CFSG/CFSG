variable {G : Type*} [Group G] [Finite G]
/-- The actual full orbit span, with its inherited action. -/
@[expose] noncomputable def seedOrbit {D E : Type*} [Group D] [AddCommGroup E] [Module (ZMod 2) E]
    (ρ : Representation (ZMod 2) D E) (I : Submodule (ZMod 2) E) : Subrepresentation ρ where
  toSubmodule := orbitSpan ρ ⊤ I
  apply_mem_toSubmodule g := fun v hv => (orbitSpan_invariant ρ ⊤ I (mem_top g) v).2 hv

variable (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hempty : MainForward.faithfulLocalComponents T = ∅)
    {M Mc : Subgroup G} (hM : IsOrderingMaximal T M)
    (hunique : maximalTwoLocalOvergroups (centralizer (centralInvolutions T : Set G)) = {Mc})
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hcard : Nat.card (localModule T M) = 4)
    (e : (M ⧸ (centralizer (localModule T M : Set G)).subgroupOf M) ≃* Equiv.Perm (Fin 3))
    (hab : IsMulCommutative (conjugateSpanBy (localModule T M) Mc))
    (hsolv : ∀ J ∈ Chapter1.HOver G (T : Set G), Group.IsSolvable J → J ≤ M)
include hG hempty hM hunique hmany hcard e hab hsolv

/-- When the source component orbit and T generate H, that orbit is exactly O²(H). -/
theorem source_component_orbit_eq_residual
    (H : Subgroup G) (hH : H ∈ Chapter1.HOutside G (T : Set G) (M : Set G))
    (K : Subgroup G) (hKH : K ≤ H) (hK : (K.subgroupOf H).IsCComponent)
    (hgen : conjugateSpanBy K (T : Subgroup G) ⊔ (T : Subgroup G) = H) :
    residual H = conjugateSpanBy K (T : Subgroup G) := by
  let X := conjugateSpanBy K (T : Subgroup G)
  have hXH : X ≤ H := conjugateSpanBy_le hKH (hH.1.2.trans H.le_normalizer)
  let : Group.IsPerfect (K.subgroupOf H) := hK.perfect
  let : Group.IsPerfect K := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe hKH).toMonoidHom) (subgroupOfEquivOfLe hKH).surjective
  let : Group.IsPerfect X := conjugateSpanBy_isPerfect K (T : Subgroup G)
  let : Group.IsPerfect (X.subgroupOf H) := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe hXH).symm.toMonoidHom) (subgroupOfEquivOfLe hXH).symm.surjective
  let : (X.subgroupOf H).Normal := (normal_subgroupOf_iff_le_normalizer hXH).mpr
    (source_component_orbit_normal hG T hempty hM hunique hmany hcard e hab hsolv H hH K hKH hK)
  have hp : IsPPerfect 2 (X.subgroupOf H) := by
    intro N hN hq
    let : N.Normal := hN
    by_contra hne
    let : Nontrivial ((X.subgroupOf H) ⧸ N) := QuotientGroup.nontrivial_iff.mpr hne
    let : Group.IsNilpotent ((X.subgroupOf H) ⧸ N) := hq.isNilpotent
    exact Group.IsPerfect.not_isSolvable ((X.subgroupOf H) ⧸ N) inferInstance
  have hr : pResidual 2 H = X.subgroupOf H :=
    pResidual_eq_of_isPPerfect_sup (X.subgroupOf H) ((T : Subgroup G).subgroupOf H)
      hp T.isPGroup'.comap_subtype (by
        rw [←subgroupOf_sup hXH hH.1.2]
        change (X ⊔ (T : Subgroup G)).subgroupOf H = ⊤
        rw [hgen,subgroupOf_self])
  exact (congrArg (Subgroup.map H.subtype) hr).trans (map_subgroupOf_eq_of_le hXH)

/-- The original actor, homogeneous seed and D.3 module input satisfy F.9.18(1–3)
on every actual intermediate span. The generation hypothesis is explicit here. -/
theorem source_component_span_inputs
    (H : Subgroup G) (hH : H ∈ Chapter1.HOutside G (T : Set G) (M : Set G))
    (K : Subgroup G) (hKH : K ≤ H) (hK : (K.subgroupOf H).IsCComponent)
    (hgen : conjugateSpanBy K (T : Subgroup G) ⊔ (T : Subgroup G) = H) :
    ∃ hU : IsElementaryAbelian 2 (conjugateSpanBy (localModule T M) H),
      let _ := hU
      ∃ (a : LocalQuotientAction H (conjugateSpanBy (localModule T M) H) (centralInvolutions T))
        (B : Subgroup H) (I : Submodule (ZMod 2) (Additive
          ((conjugateSpanBy (localModule T M) H) ⧸
            (centralInvolutions T).subgroupOf (conjugateSpanBy (localModule T M) H)))),
        B ≤ (((sourceResidual M Mc ⊔ (T : Subgroup G)) ⊓ H).pCoreIn 2).subgroupOf H ∧
        IsIrrPlusWith a.representation
          (componentOrbit (actorImage H K) (quotientSylow H T hH.1.2))
          (quotientSylow H T hH.1.2) I ∧
        ChapterD.Section03.InternalModuleHypotheses KnownSimple.IsKnownSimple a.representation
          (quotientSylow H T hH.1.2)
          (componentOrbit (actorImage H K) (quotientSylow H T hH.1.2)) I ∧
        QuadraticMember a.representation (B.map (QuotientGroup.mk' (pCore 2 H))) ∧
        B.map (QuotientGroup.mk' (pCore 2 H)) ⊓
          centralizer (actorImage H (conjugateSpanBy K (T : Subgroup G)) : Set (H ⧸ pCore 2 H)) = ⊥ ∧
        ∀ X : Subgroup (H ⧸ pCore 2 H), actorImage H K ≤ X → actorImage H T ≤ X →
          SpanActorResult a.representation (B.map (QuotientGroup.mk' (pCore 2 H))) X I := by
  obtain ⟨hU,a,B,hB,hAE,hAQ,hbound,_,hfaith⟩ :=
    source_rankTwo_bounded_placed_action hG T hempty hM hunique hmany hcard e hab H hH
  let := hU
  obtain ⟨I,hI⟩ := source_exists_homogeneous_seed
    hG T hempty hM hunique hmany hcard e hab hsolv H hH K hKH hK a
  rw [source_component_orbit_eq_residual
    hG T hempty hM hunique hmany hcard e hab hsolv H hH K hKH hK hgen] at hfaith
  refine ⟨hU,a,B,I,hB,hI,
    source_internal_module hG T hempty hM hunique hmany hcard e hab hsolv H hH K hKH hK a hI,
    ⟨hAE,hAQ,hbound⟩,hfaith,?_⟩
  have horbit : conjugateSpanBy (actorImage H K) (actorImage H T) =
      actorImage H (conjugateSpanBy K (T : Subgroup G)) := by
    have hh := quotient_componentOrbit H K T hKH hH.1.2
    rw [componentOrbit,←conjugateSpanBy_eq_iSup_conj] at hh
    exact hh
  have hi : IsIrrPlus a.representation (conjugateSpanBy (actorImage H K) (actorImage H T)) I := by
    have hh := hI.isIrrPlus
    rw [componentOrbit,←conjugateSpanBy_eq_iSup_conj] at hh
    exact hh
  rw [←horbit] at hfaith
  intro X hKX hTX
  exact spanActorResult a.representation (actorImage H K) (actorImage H T)
    (B.map (QuotientGroup.mk' (pCore 2 H))) X
    (source_quotient_component hG T hempty hM hunique hmany hcard e hab hsolv H hH K hKH hK)
    hKX hTX ((source_internal_actor_le_sylow T hH.1.2 B hB).trans hTX)
    hAE hAQ hbound hfaith I hi

/-- The chosen seed's Sylow span is its full span in the generated reduction. -/
theorem source_seed_sylow_orbit_eq_full
    (H : Subgroup G) (hH : H ∈ Chapter1.HOutside G (T : Set G) (M : Set G))
    (K : Subgroup G) (hKH : K ≤ H) (hK : (K.subgroupOf H).IsCComponent)
    (hgen : conjugateSpanBy K (T : Subgroup G) ⊔ (T : Subgroup G) = H)
    [IsElementaryAbelian 2 (conjugateSpanBy (localModule T M) H)]
    (a : LocalQuotientAction H (conjugateSpanBy (localModule T M) H) (centralInvolutions T))
    {I : Submodule (ZMod 2) (Additive ((conjugateSpanBy (localModule T M) H) ⧸
      (centralInvolutions T).subgroupOf (conjugateSpanBy (localModule T M) H)))}
    (hI : IsIrrPlusWith a.representation
      (componentOrbit (actorImage H K) (quotientSylow H T hH.1.2))
      (quotientSylow H T hH.1.2) I) :
    orbitSpan a.representation (actorImage H T) I = orbitSpan a.representation ⊤ I := by
  have hgenq : componentOrbit (actorImage H K) (quotientSylow H T hH.1.2) ⊔
      actorImage H T = ⊤ := by
    rw [quotient_componentOrbit H K T hKH hH.1.2,
      ← source_component_orbit_eq_residual
        hG T hempty hM hunique hmany hcard e hab hsolv H hH K hKH hK hgen]
    exact RepresentationReduction.actorImage_residual_sup_sylow T hH.1.2
  have hs : (⊤ : Subgroup (H ⧸ pCore 2 H)) ≤ subspaceStabilizer a.representation
      (orbitSpan a.representation (actorImage H T) I) := by
    rw [←hgenq]
    exact sup_le (orbitSpan_component_invariant a.representation hI.normalizes hI.isIrrPlus)
      (orbitSpan_invariant a.representation (actorImage H T) I)
  apply le_antisymm
  · exact orbitSpan_le a.representation (le_orbitSpan a.representation ⊤ I)
      (le_top.trans (orbitSpan_invariant a.representation ⊤ I))
  · exact orbitSpan_le a.representation (le_orbitSpan a.representation (actorImage H T) I) hs

/-- The source orbit exhausts the moved space unless one of the precise
F.9.18(6) FF alternatives occurs. No exhaustion premise is imposed. -/
theorem source_seed_orbit_exhaustion_or_ff
    (H : Subgroup G) (hH : H ∈ Chapter1.HOutside G (T : Set G) (M : Set G))
    (K : Subgroup G) (hKH : K ≤ H) (hK : (K.subgroupOf H).IsCComponent)
    (hgen : conjugateSpanBy K (T : Subgroup G) ⊔ (T : Subgroup G) = H)
    [IsElementaryAbelian 2 (conjugateSpanBy (localModule T M) H)]
    (a : LocalQuotientAction H (conjugateSpanBy (localModule T M) H) (centralInvolutions T))
    (B : Subgroup H)
    (hB : B ≤ (((sourceResidual M Mc ⊔ (T : Subgroup G)) ⊓ H).pCoreIn 2).subgroupOf H)
    (hA : QuadraticMember a.representation (B.map (QuotientGroup.mk' (pCore 2 H))))
    {I : Submodule (ZMod 2) (Additive ((conjugateSpanBy (localModule T M) H) ⧸
      (centralInvolutions T).subgroupOf (conjugateSpanBy (localModule T M) H)))}
    (hI : IsIrrPlusWith a.representation
      (componentOrbit (actorImage H K) (quotientSylow H T hH.1.2))
      (quotientSylow H T hH.1.2) I) :
    orbitSpan a.representation ⊤ I = subspaceCommutator a.representation ⊤
      (actorImage H (conjugateSpanBy K (T : Subgroup G))) ∨
    (IsFFModule (imageRepresentation (seedOrbit a.representation I).toRepresentation) ∧
      IsFFModule (imageRepresentation (seedOrbit a.representation I).quotientRepresentation)) ∨
      IsStrongFFModule (imageRepresentation (seedOrbit a.representation I).toRepresentation) ∨
        IsStrongFFModule (imageRepresentation (seedOrbit a.representation I).quotientRepresentation) := by
  have hr := source_component_orbit_eq_residual
    hG T hempty hM hunique hmany hcard e hab hsolv H hH K hKH hK hgen
  have ho := quotient_componentOrbit H K T hKH hH.1.2
  have hn := source_quotient_componentOrbit_normal
    hG T hempty hM hunique hmany hcard e hab hsolv H hH K hKH hK
  let _ := hn
  have hc : subspaceCommutator a.representation (orbitSpan a.representation ⊤ I)
      (componentOrbit (actorImage H K) (quotientSylow H T hH.1.2)) =
      orbitSpan a.representation ⊤ I :=
    orbitSpan_full_commutator a.representation (by rw [normalizer_eq_top]) hI.isIrrPlus
  have hratio : actionRatio a.representation (B.map (QuotientGroup.mk' (pCore 2 H))) ≤ 2 := by
    rw [actionRatio,ENNReal.div_le_iff
      (by exact_mod_cast (ne_of_gt hA.1.rank_pos)) (by simp)]
    exact_mod_cast hA.2.2
  have hgenq : conjugateSpanBy (actorImage H K) (actorImage H T) = actorImage H (residual H) := by
    rw [hr]
    rw [componentOrbit,←conjugateSpanBy_eq_iSup_conj] at ho
    exact ho
  have hcomm : subspaceCommutator a.representation (seedOrbit a.representation I).toSubmodule
      (actorImage H (residual H)) = (seedOrbit a.representation I).toSubmodule := by
    rw [hr,←ho]
    exact hc
  have hall := source_section_alternatives a (seedOrbit a.representation I) K T hH.1.2 B hB
    (source_quotient_component hG T hempty hM hunique hmany hcard e hab hsolv H hH K hKH hK)
    hgenq ⟨hA.1,hA.2.1,hratio⟩
    (orbitSpan_ne_bot a.representation hI.isIrrPlus) hcomm
  rw [hr] at hall
  exact hall

/-- The generation premise is discharged on J=⟨K^T⟩T for every component
of the original terminal Mc; this constructs all intermediate-span actors. -/
theorem terminal_reduced_component_span_inputs
    (K : Subgroup G) (hKM : K ≤ Mc) (hK : (K.subgroupOf Mc).IsCComponent) :
    let J := conjugateSpanBy K (T : Subgroup G) ⊔ (T : Subgroup G)
    ∃ hJ : J ∈ Chapter1.HOutside G (T : Set G) (M : Set G),
    ∃ hU : IsElementaryAbelian 2 (conjugateSpanBy (localModule T M) J),
      let _ := hU
      ∃ (a : LocalQuotientAction J (conjugateSpanBy (localModule T M) J) (centralInvolutions T))
        (B : Subgroup J) (I : Submodule (ZMod 2) (Additive
          ((conjugateSpanBy (localModule T M) J) ⧸
            (centralInvolutions T).subgroupOf (conjugateSpanBy (localModule T M) J)))),
        B ≤ (((sourceResidual M Mc ⊔ (T : Subgroup G)) ⊓ J).pCoreIn 2).subgroupOf J ∧
        IsIrrPlusWith a.representation
          (componentOrbit (actorImage J K) (quotientSylow J T hJ.1.2))
          (quotientSylow J T hJ.1.2) I ∧
        ChapterD.Section03.InternalModuleHypotheses KnownSimple.IsKnownSimple a.representation
          (quotientSylow J T hJ.1.2)
          (componentOrbit (actorImage J K) (quotientSylow J T hJ.1.2)) I ∧
        QuadraticMember a.representation (B.map (QuotientGroup.mk' (pCore 2 J))) ∧
        B.map (QuotientGroup.mk' (pCore 2 J)) ⊓
          centralizer (actorImage J (conjugateSpanBy K (T : Subgroup G)) : Set (J ⧸ pCore 2 J)) = ⊥ ∧
        ∀ X : Subgroup (J ⧸ pCore 2 J), actorImage J K ≤ X → actorImage J T ≤ X →
          SpanActorResult a.representation (B.map (QuotientGroup.mk' (pCore 2 J))) X I := by
  let J := conjugateSpanBy K (T : Subgroup G) ⊔ (T : Subgroup G)
  have hout := terminal_outside hG T hempty hM hunique hmany hcard e
  have hJ := source_component_orbit_outside
    hG T hempty hM hunique hmany hcard e hab hsolv Mc hout K hKM hK
  have hJMc : J ≤ Mc := sup_le
    (conjugateSpanBy_le hKM (hout.1.2.trans Mc.le_normalizer)) hout.1.2
  have hKJ : K ≤ J := (le_conjugateSpanBy K _).trans le_sup_left
  exact ⟨hJ,source_component_span_inputs hG T hempty hM hunique hmany hcard e hab hsolv
    J hJ K hKJ (hK.subgroupOf_of_le hKJ hJMc) rfl⟩

