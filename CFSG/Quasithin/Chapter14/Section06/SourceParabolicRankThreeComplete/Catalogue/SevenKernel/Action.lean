module
public import CFSG.Quasithin.ChapterC.Section02.SourceExtraction.C27.StarModels
public import CFSG.Quasithin.Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.OriginalAssembly.AlternatingModels.Actor

/-!
# Full A₇ action data on the literal C.2.7 star quotient

The marked star component is the whole generalized Fitting subgroup, and
its trivial center makes it self-centralizing. The existing full B.5.1
classifier consequently applies to the original actor and module, without
assuming the actor is generated by offenders. Its two rows are the full
natural S₇ six-space and the exceptional A₇ four-space. The central kernel
of K/O₂(K) is not discarded in this step.

Source: Aschbacher--Smith C.2.7, displayed (!), p.146, and B.5.1, pp.99--103.
-/

public section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter14.Section06.ParabolicCatalogue.SevenKernel
open Chapter1.RadicalExclusions.ModelReduction FullSieve FullSieve.SourceInterface
open ChapterC.C27Source
open Chapter13.Section06.CentralizerReduction.ComponentElimination.SourceSmallModels.OriginalAssembly
variable {G : Type*} [Group G] [Finite G] {H K R M : Subgroup G}

/-- The full original star action has the two genuine seven-letter module rows. -/
theorem actionData (h : Input KnownSimple.IsKnownSimple H R M K)
    (e : starImage K R K ≃* alternatingGroup (Fin 7)) :
    Nonempty (AlternatingModels.ActionData (starRepresentation K R) (starImage K R K)) := by
  let : (K.subgroupOf (K ⊔ R)).Normal :=
    normal_subgroupOf_of_le_normalizer (sup_le K.le_normalizer h.normalizes)
  let : (starImage K R K).Normal :=
    Normal.map inferInstance _ (QuotientGroup.mk'_surjective _)
  obtain ⟨hf,hq⟩ := star_fitting_quasisimple (source_join_input h)
  let : IsQuasisimple (starImage K R K) := hq
  let := alternatingGroup.isSimpleGroup (by simp : 5 ≤ Nat.card (Fin 7))
  let : IsSimpleGroup (starImage K R K) := e.isSimpleGroup
  have hc : centralizer (starImage K R K : Set (StarQuotient K R)) = ⊥ := by
    apply le_bot_iff.mp
    intro x hx
    have hxK : x ∈ starImage K R K := by
      rw [← hf]
      exact centralizer_generalizedFitting_le _ (hf.symm ▸ hx)
    have hz : (⟨x,hxK⟩ : starImage K R K) ∈ center (starImage K R K) := by
      rw [mem_center_iff]
      intro y
      exact Subtype.ext (mem_centralizer_iff.mp hx y y.property)
    have he : e ⟨x,hxK⟩ ∈ center (alternatingGroup (Fin 7)) :=
      (centerCongr e ⟨⟨x,hxK⟩,hz⟩).property
    rw [alternatingGroup.center_eq_bot (by simp),mem_bot] at he
    exact mem_bot.mpr (congrArg Subtype.val (e.injective (he.trans (map_one e).symm)))
  have hsqK : IsSQTK KnownSimple.IsKnownSimple K :=
    (IsSQTK.equiv (subgroupOfEquivOfLe h.component.1)).mp
      (h.setup.sqtk.subgroup (K.subgroupOf H))
  have hsq : IsSQTK KnownSimple.IsKnownSimple (starImage K R K) :=
    ChapterB.SourceInduction.HighThreeRank.CoverCentralizer.SourceConstruction.quasisimple_section_sqtk
      (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple) hsqK
      (ChapterA.Section02.IsSectionOf.of_surjective (toStarImage K R)
        (toStarImage_surjective K R))
  exact AlternatingModels.nonempty_actionData (starRepresentation K R) (starImage K R K)
    e hc hsq (starRepresentation_injective K R)
    (star_offender_fitting (source_join_input h)).1

end CFSG.Quasithin.Chapter14.Section06.ParabolicCatalogue.SevenKernel
