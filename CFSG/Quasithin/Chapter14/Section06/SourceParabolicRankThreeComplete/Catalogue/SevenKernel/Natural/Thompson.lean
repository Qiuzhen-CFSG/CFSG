module
public import CFSG.Quasithin.Chapter14.Section06.SourceParabolicRankThreeComplete.Catalogue.SevenKernel.Natural.Inputs
public import Mathlib.GroupTheory.Perm.ClosureSwap

/-!
# The relative natural Thompson image on seven letters

Local maximum-elementary images are best offenders. The odd-degree
classification makes each image generated by transpositions. Their common
two-group lies in one Sylow marking, where every transposition belongs to
the standard three-pair group. Its generated subgroup consequently has
singleton or pair orbits and contains the independent swaps of those orbits.
The pair-orbit normal form gives one, two or three pairs, with the exact
conjugation orientation needed by `Natural.selection_of_coordinates`.

The proof applies to the original relative two-subgroup; it does not require
that subgroup to be Sylow. Source: Aschbacher--Smith B.2.7, B.3.2(4) and
C.1.24(a), printed pp.76,84,131.
-/

public section
open Subgroup Equiv Representation Representation.BinaryOffender Stellmacher
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter14.Section06.ParabolicCatalogue.SevenKernel.Natural
open ChapterB.Offenders BinaryPermutation
open Theory.SpecificGroups.SymmetricSeven.ThreePairsCubic
open Representation.AlternatingSevenConjugatePair.ElementaryGeometry
open ChapterC.RankOne.Alternating.SevenSource

private theorem swap_conj (g : Sym) {s : Sym} (hs : s.IsSwap) :
    ((MulAut.conj g) s).IsSwap := by
  obtain ⟨a,b,hab,rfl⟩ := hs
  refine ⟨g a,g b,g.injective.ne hab,?_⟩
  exact Equiv.symm_trans_swap_trans a b g

private theorem pair_orbit_bound (A : Subgroup Sym) (hA : A ≤ D 7) (x : Fin 7) :
    Nat.card (MulAction.orbit A x) ≤ 2 := by
  have hsub : MulAction.orbit A x ⊆ {x, (swap01 * swap23 * swap45) x} := by
    rintro y ⟨a,rfl⟩
    obtain ⟨v,hv⟩ := (natural_D_eq_pairElementary ▸ hA a.property)
    change a.val x = x ∨ a.val x = (swap01 * swap23 * swap45) x
    rw [←hv]
    exact (by decide +kernel : ∀ (v : Triple) (x : Fin 7),
      firstWord v x = x ∨ firstWord v x = (swap01 * swap23 * swap45) x) v x
  rw [Nat.card_coe_set_eq]
  exact (Set.ncard_mono hsub).trans (by simpa using Set.ncard_insert_le x ({(swap01 * swap23 * swap45) x} : Set (Fin 7)))

private theorem caseA_of_generated_swaps (A : Subgroup Sym) (hp : IsPGroup 2 A)
    (hne : A ≠ ⊥) (S : Set Sym) (hs : ∀ s ∈ S, s.IsSwap)
    (hgen : closure S = A) : CaseAFamily 7 A := by
  obtain ⟨P,hAP⟩ := hp.exists_le_sylow
  obtain ⟨Q,hDQ,_⟩ := Odd.exists_sylow_containing_D (Or.inr rfl : 7 = 5 ∨ 7 = 7)
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq Sym P Q
  let f := (MulAut.conj g).toMonoidHom
  let S' := f '' S
  let C := closure S'
  have hPQ : (P : Subgroup Sym).map f = Q :=
    congrArg (fun U : Sylow 2 Sym => (U : Subgroup Sym)) hg
  have hC : C = A.map f := by rw [←hgen, MonoidHom.map_closure]
  have hCQ : C ≤ Q := by rw [hC, ←hPQ]; exact map_mono hAP
  have hs' : ∀ s ∈ S', s.IsSwap := by
    rintro _ ⟨s,hsS,rfl⟩
    exact swap_conj g (hs s hsS)
  have hCD : C ≤ D 7 := by
    apply (closure_le _).mpr
    intro s hsS
    exact Odd.isSwap_mem_D_of_isPGroup (Or.inr rfl) Q.isPGroup' hDQ
      (hs' s hsS) (hCQ (subset_closure hsS))
  have hCne : C ≠ ⊥ := by
    rw [hC]
    exact fun h => hne ((map_eq_bot_iff_of_injective A (MulAut.conj g).injective).mp h)
  have hcase : CaseAFamily 7 C := by
    apply Odd.caseAFamily_of_pair_orbits (Or.inr rfl) C hCne (pair_orbit_bound C hCD)
    intro x y hy
    exact (_root_.swap_mem_closure_isSwap hs').mpr (MulAction.mem_orbit_symm.mpr hy)
  obtain ⟨k,hk1,hk3,b,hb⟩ := hcase
  refine ⟨k,hk1,hk3,g⁻¹*b,?_⟩
  have hc : C.map (MulAut.conj g⁻¹).toMonoidHom = A := by
    rw [hC]
    exact A.conjBy_inv g
  rw [←hc,hb]
  exact (disjointTranspositions 7 k).conjBy_conjBy b g⁻¹

private theorem caseA_generated_swaps (A : Subgroup Sym) (hA : CaseAFamily 7 A) :
    A ≤ closure {s : Sym | s ∈ A ∧ s.IsSwap} := by
  obtain ⟨k,_,_,g,rfl⟩ := hA
  apply map_le_iff_le_comap.mpr
  apply (closure_le _).mpr
  rintro s ⟨i,hi,rfl⟩
  apply Subgroup.subset_closure
  refine ⟨mem_map_of_mem _ (pairSwap_mem i hi), swap_conj g ?_⟩
  refine ⟨⟨2*i.val,by omega⟩,⟨2*i.val+1,by omega⟩,?_,rfl⟩
  intro h
  have hh : 2 * i.val = 2 * i.val + 1 := congrArg Fin.val h
  omega

/-- The actual relative Thompson image is conjugate to one, two or three pair swaps. -/
theorem relative_thompson : RelativeThompsonInput := by
  intro J _ _ V R _ _ hp hVR q hq hk hc hJ
  let ρ := NormalElementaryQuotient.representation V q hq hk
  let σ := naturalRepresentation (Fin 7)
  let A := (elementaryAbelianMaxJ R).map q
  let S := {s : Sym | s ∈ A ∧ s.IsSwap}
  have hbest (E : Subgroup Sym) (hE : E ∈ ChapterB.maxOffenderImages R V q) :
      IsBestOffender σ E := by
    have hb := (ChapterB.lemma_B_2_7_local V q hq hk R hVR hJ).2 E hE
    have ht := hb.map_of_fixedCodim ρ σ (MonoidHom.id Sym) Function.injective_id
      (by intro B; simpa using hc B)
    simpa only [Subgroup.map_id] using ht
  have hgen : closure S = A := by
    apply le_antisymm
    · exact (closure_le _).mpr (fun _ h => h.1)
    · change (elementaryAbelianMaxJ R).map q ≤ closure S
      rw [ChapterB.maxOffenderImages_generated R V q]
      apply iSup_le
      intro E
      apply iSup_le
      rintro ⟨hE,_⟩
      have hcase := (Odd.isBestOffender_natural_iff_caseAFamily (Or.inr rfl) E).mp (hbest E hE)
      have hEA : E ≤ A := by
        obtain ⟨B,hB,rfl,_⟩ := hE
        exact map_mono (le_sSup hB)
      exact (caseA_generated_swaps E hcase).trans (closure_mono (fun s hs => ⟨hEA hs.1,hs.2⟩))
  have hne : A ≠ ⊥ := fun h => hJ ((Subgroup.map_eq_bot_iff _).mp h)
  have hpA : IsPGroup 2 A :=
    (hp.to_le (show elementaryAbelianMaxJ R ≤ R from sSup_le (fun _ h => h.1))).map q
  obtain ⟨k,hk1,hk3,a,ha⟩ :=
    caseA_of_generated_swaps A hpA hne S (fun _ h => h.2) hgen
  exact ⟨a,k,hk1,hk3,ha⟩

end CFSG.Quasithin.Chapter14.Section06.ParabolicCatalogue.SevenKernel.Natural
