module
public import CFSG.Quasithin.ChapterC.Section01.BlockTypes.G2
public import Theory.GroupTheory.ConjugateSpanOrder

/-!
# Local hypotheses for the G₂ second-parabolic calculation

These are the group-theoretic inputs to the flag calculation, separated
from the original Chapter 14 construction. The plane lies in the whole
intrinsic U-layer, is Sylow-invariant and generated by a component subgroup.
The second actor normalizes the component, fixes a point on the plane and
moves the plane. Neither a geometric marking nor a span bound is included.

Source: Aschbacher--Smith, original 14.6.10(5), printed p.1029.
-/

@[expose] public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter14.Section06.G2SecondParabolic
variable {G : Type*} [Group G]

/-- The actual local input for the doubly singular plane calculation. -/
structure FlagData (K V Z J : Subgroup G) : Prop where
  block : ChapterC.IsG2TwoBlock K
  plane_le : V ≤ (ChapterC.blockU K).map K.subtype
  point_le : Z ≤ V
  plane_card : Nat.card V = 4
  point_card : Nat.card Z = 2
  sylow : ∃ S : Sylow 2 K,
    (S : Subgroup K).map K.subtype ≤ normalizer (V : Set G) ∧
    (S : Subgroup K).map K.subtype ≤ normalizer (Z : Set G)
  seed : ∃ A : Subgroup G, A ≤ K ∧ ⁅V,A⁆ = V
  normalizes : J ≤ normalizer (K : Set G)
  fixes : J ≤ centralizer (Z : Set G)
  moves : ¬ J ≤ normalizer (V : Set G)

end CFSG.Quasithin.Chapter14.Section06.G2SecondParabolic
