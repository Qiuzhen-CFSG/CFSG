module
public import CFSG.Quasithin.Chapter14.Section06.SourceParabolicRankThreeComplete.Binary.ModuleEnvelope
public import Theory.GroupTheory.Commutator.NormalizedPerfectSmallIndex

/-!
# The single-natural plane span in original 14.6.10(5)

The component span is generated by commutators because the first residual
moves its seed. A natural module gives an order-eight upper bound. If the
span had only four elements, the perfect component would centralize it by
the small-section action theorem, contradicting that movement.

This proves the single-natural row of the source application. The doubled
natural row still needs its Sylow-plane argument; Binary.Source excludes
the central-extension row using the source Sylow omega-center.
Source: Aschbacher--Smith original14.6.10(5), printed p.1029.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter14.Section06.Binary
open Chapter1.RadicalExclusions.ModelReduction FullSieve.SourceInterface
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
theorem PlaneConfiguration.span_moved {C V : Subgroup G} (h : PlaneConfiguration C V) :
    ⁅conjugateSpanBy V C,C⁆ = conjugateSpanBy V C := by
  obtain ⟨A,hAC,_,_,hm⟩ := h.moved
  exact (conjugateSpanBy_eq_commutator_of_seed V C C A le_rfl C.le_normalizer hAC hm.symm).symm

/-- The single-natural envelope already forces the component span to have order eight. -/
theorem PlaneConfiguration.span_card_of_natural {C V E : Subgroup G}
    (h : PlaneConfiguration C V) (hUE : conjugateSpanBy V C ≤ E)
    (e : (C ⧸ pCore 2 C) ≃* Matrix.SpecialLinearGroup (Fin 3) (ZMod 2))
    (hm : HasSectionModel C E ⊥ (linearThreeActor e)
      (Representation.specialLinearNatural (k := ZMod 2) 3)) :
    Nat.card (conjugateSpanBy V C) = 8 := by
  let U := conjugateSpanBy V C
  let := h.perfect
  have hE : Nat.card E = 8 := by
    obtain ⟨_,_,_,hn,f,_⟩ := hm
    let g := ((QuotientGroup.quotientMulEquivOfEq
      (bot_subgroupOf (G := G) E)).trans QuotientGroup.quotientBot).symm.trans f
    rw [Nat.card_congr g.toEquiv]
    change Nat.card (Fin 3 → ZMod 2) = 8
    simp
  have hd : Nat.card U ∣ 8 := hE ▸ card_dvd_of_le hUE
  have hlo : 4 ≤ Nat.card U := h.card ▸ card_le_of_le (le_conjugateSpanBy V C)
  have hhi : Nat.card U ≤ 8 := Nat.le_of_dvd (by decide) hd
  have hne : Nat.card U ≠ 4 := by
    intro hc
    have hz : ⁅U,C⁆ ≤ ⊥ := commutator_le_of_perfect_normalized_small_index C U ⊥
      (le_normalizer_conjugateSpanBy V C) (by rw [normalizer_eq_top]; exact le_top) (by simpa using hc.le)
    rw [h.span_moved] at hz
    have hv : V = ⊥ := bot_unique ((le_conjugateSpanBy V C).trans hz)
    have hh := h.card
    rw [hv,card_bot] at hh
    omega
  interval_cases hc : Nat.card U <;> norm_num at *

end CFSG.Quasithin.Chapter14.Section06.Binary
