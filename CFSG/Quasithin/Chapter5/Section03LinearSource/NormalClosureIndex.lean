module
public import CFSG.Quasithin.Chapter5.Section03LinearSource.NormalClosure
public import Mathlib.GroupTheory.Schreier

/-!
# The normal-closure orbit lower bound

An order-two subgroup normalized by T is generated by one element whose
conjugacy orbit has at most [G:T] members. Thus its normal closure needs
at most [G:T] generators. For a Sylow-normal four-group containing a
central involution, the characteristic-two normal-closure theorem gives
an elementary image modulo that involution. If the original closure has
order 32, this image has order 16, so [G:T] is at least four.

The prepared source consumer takes G to be the literal involution
centralizer; the index is not the index of that centralizer in the
original simple group. Source: Aschbacher--Smith §5.3.7, printed p.661
(`refs/quasithin.pdf`).
-/

public noncomputable section
open Subgroup
namespace CFSG.Quasithin.Chapter5.Section03LinearSource
variable {G : Type*} [Group G] [Finite G]

private theorem rank_normalClosure_two_le_index (T Z : Subgroup G)
    (hZ : Nat.card Z = 2) (hn : T ≤ normalizer (Z : Set G)) :
    Group.rank (normalClosure (Z : Set G)) ≤ T.index := by
  let : IsCyclic Z := isCyclic_of_prime_card hZ
  obtain ⟨x,hx⟩ := Z.isCyclic_iff_exists_zpowers_eq_top.mp inferInstance
  have hcl : normalClosure (Z : Set G) = closure (MulAction.orbit (ConjAct G) x) := by
    rw [←hx,zpowers_eq_closure,normalClosure_closure_eq_normalClosure]
    unfold normalClosure
    congr 1
    ext a
    simp only [Group.mem_conjugatesOfSet_iff,Set.mem_singleton_iff,exists_eq_left,
      ConjAct.mem_orbit_conjAct]
    exact isConj_comm
  have horbit : Nat.card (MulAction.orbit (ConjAct G) x) = (centralizer ({x} : Set G)).index := by
    rw [Nat.card_coe_set_eq,←MulAction.index_stabilizer]
    rw [centralizer_eq_comap_stabilizer]
    exact ((MulAction.stabilizer (ConjAct G) x).index_comap_of_surjective
      (f := ConjAct.toConjAct.toMonoidHom) ConjAct.toConjAct.surjective).symm
  have hT : T ≤ centralizer ({x} : Set G) :=
    (hn.trans (normalizer_le_centralizer_of_card_two Z hZ)).trans
      (centralizer_le (by intro a ha;rw [Set.mem_singleton_iff] at ha;rw [ha];exact hx ▸ mem_zpowers x))
  calc
    Group.rank (normalClosure (Z : Set G)) =
        Group.rank (closure (MulAction.orbit (ConjAct G) x)) := Subgroup.rank_congr hcl
    _ ≤ Nat.card (MulAction.orbit (ConjAct G) x) := rank_closure_finite_le_nat_card _
    _ = (centralizer ({x} : Set G)).index := horbit
    _ ≤ T.index := index_antitone hT

/-- The elementary image of a four-group normal closure of order 32 requires
at least four Sylow cosets, measured in the actual ambient centralizer. -/
theorem four_normalClosure_index_lower (T : Sylow 2 G) (Z C : Subgroup G) [C.Normal]
    [IsElementaryAbelian 2 Z]
    (hchar : centralizer (pCore 2 G : Set G) ≤ pCore 2 G)
    (hn : (T : Subgroup G) ≤ normalizer (Z : Set G))
    (hZ : Nat.card Z = 4) (hC : Nat.card C = 2)
    (hCZ : C ≤ Z) (hc : C ≤ center G)
    (hW : Nat.card (normalClosure (Z : Set G)) = 32) :
    4 ≤ (T : Subgroup G).index := by
  let q := QuotientGroup.mk' C
  have hq := QuotientGroup.mk'_surjective C
  have hCT : C ≤ (T : Subgroup G) :=
    (IsPGroup.of_card (p := 2) (n := 1) (by simpa using hC)).le_sylow_of_normal T
  have hZbar : Nat.card (Z.map q) = 2 := by
    have hh := (C.subgroupOf Z).card_mul_index
    rw [Nat.card_congr (subgroupOfEquivOfLe hCZ).toEquiv,hC,hZ] at hh
    change 2 * C.relIndex Z = 4 at hh
    have hi : C.relIndex Z = Nat.card (Z.map q) := by
      simpa only [q,QuotientGroup.ker_mk'] using (relIndex_ker Z q)
    omega
  let W := normalClosure (Z : Set G)
  have hCW : C ≤ W := hCZ.trans le_normalClosure
  have hWbar : Nat.card (W.map q) = 16 := by
    have hh := (C.subgroupOf W).card_mul_index
    rw [Nat.card_congr (subgroupOfEquivOfLe hCW).toEquiv,hC,hW] at hh
    change 2 * C.relIndex W = 32 at hh
    have hi : C.relIndex W = Nat.card (W.map q) := by
      simpa only [q,QuotientGroup.ker_mk'] using (relIndex_ker W q)
    omega
  have hmap : W.map q = normalClosure (Z.map q : Set (G ⧸ C)) := map_normalClosure _ q hq
  let := (four_normalClosure T Z C hchar hn hZ hC hCZ hc).2
  have hpow : ∀ a : W.map q, a^2=1 := fun a => Subtype.ext
    (elemPow_eq_one_of_isElementaryAbelian (p := 2) a.val a.property)
  let : CommGroup (W.map q) := IsMulCommutative.instCommGroup
  have hcard := Nat.le_of_dvd (by positivity : 0 < 2^Group.rank (W.map q))
    (card_dvd_exponent_pow_rank' (W.map q) hpow)
  rw [hWbar] at hcard
  have hr : 4 ≤ Group.rank (W.map q) := by
    by_contra hh
    have hlt : Group.rank (W.map q) ≤ 3 := by omega
    have hle := Nat.pow_le_pow_right (by decide : 0<2) hlt
    norm_num at hle
    omega
  have hrank := rank_normalClosure_two_le_index ((T : Subgroup G).map q) (Z.map q)
    hZbar ((map_mono hn).trans (Z.le_normalizer_map q))
  rw [←hmap,(T : Subgroup G).index_map_eq hq (by simpa only [q,QuotientGroup.ker_mk'] using hCT)] at hrank
  exact hr.trans hrank
end CFSG.Quasithin.Chapter5.Section03LinearSource
