module
public import CFSG.Quasithin.Chapter5.Section03UnitaryNativeLift.Pure
public import CFSG.Quasithin.ChapterF.Section04.SourceCompletion.UnitaryNonbinary.FiveOrder
public import CFSG.Quasithin.ChapterF.Section04.SourceCompletion.UnitaryNonbinary.FourApartment
public import CFSG.Quasithin.ChapterF.Section04.SourceCompletion.UnitaryNonbinary.FiveApartment

/-!
# Native unitary comparisons, generation, and the fourth-power relation

The pure-inner comparison preserves the actual middle of each unitary row.
For PSU₅(4), the accepted completion order theorem, applied inside the
subgroup generated by the pure endpoints, proves native generation without
assuming it. In both rows apartment closure now puts the fourth rotation
power in the native middle, whose centralizer calculation makes it trivial.

Sources: Aschbacher–Smith F.4.3, F.4.13, F.4.16–17 and F.4.24,
printed pp.274,280,282–283,287. The four-dimensional parameter includes
q = 4; the five-dimensional row retains its projective scalar kernel.
-/

@[expose] public noncomputable section
namespace CFSG.Quasithin.Chapter5.UnitaryNativeLift
open Subgroup Theory.GroupTheory
open ChapterF.SourceCompletion.UnitaryNonbinary

namespace Four
open ChapterF.GreenBook.LieModels.UnitaryFour
variable (m : ℕ) (hm : 1 ≤ m)

abbrev extension : FourExtension m hm := pure (pointParabolic m hm) (planeParabolic m hm)

/-- Conjugation on all three native groups, using the whole mapped Borel. -/
def comparison : RankTwoAmalgam.Iso (amalgam m hm) (extension m hm).amalgam :=
  Pure.comparison _ _ (four_conj_injective m hm) (overlap m hm)
    (Subgroup.map_mono inf_le_left) (Subgroup.map_mono inf_le_right) (exact_overlap m hm)

@[simp] theorem comparison_left_val (x : pointParabolic m hm) :
    ((comparison m hm).left x).val = MulAut.conj x.val := rfl

@[simp] theorem comparison_middle_val (x : overlap m hm) :
    ((comparison m hm).middle x).val = MulAut.conj x.val := rfl

@[simp] theorem comparison_right_val (x : planeParabolic m hm) :
    ((comparison m hm).right x).val = MulAut.conj x.val := rfl

/-- The fourth power is trivial for a small pure-inner completion. -/
theorem fourth_eq_one (hmgt : 1 < m) {M : Type*} [Group M] [Finite M]
    (c : RankTwoAmalgam.FaithfulCompletion (extension m hm).amalgam (G := M))
    (ho : c.left.range ⊓ c.right.range = c.middle.range)
    (hcard : Nat.card M ≤ Nat.card (extension m hm).carrier) :
    FourWeyl.rotation m hm (extension m hm) c ^ 4 = 1 := by
  apply (FourWeyl.power_eq_one_iff_nativeOverlap m hm (extension m hm) c 4).mpr
  rw [Pure.innerMiddle_range _ _ (four_conj_injective m hm)]
  exact FourWeyl.fourth_mem_middle m hm hmgt (extension m hm) c ho hcard

end Four

namespace Five
variable (U : ChapterF.GreenBook.UnitaryFive.Model 4)

abbrev extension : FiveExtension U := pure U.leftParabolic U.rightParabolic

/-- All three maps descend from conjugation in the projective group. -/
def comparison : RankTwoAmalgam.Iso U.amalgam (extension U).amalgam :=
  Pure.comparison _ _ (five_conj_injective U) U.overlap inf_le_left inf_le_right rfl

@[simp] theorem comparison_left_val (x : U.leftParabolic) :
    ((comparison U).left x).val = MulAut.conj x.val := rfl

@[simp] theorem comparison_middle_val (x : U.overlap) :
    ((comparison U).middle x).val = MulAut.conj x.val := rfl

@[simp] theorem comparison_right_val (x : U.rightParabolic) :
    ((comparison U).right x).val = MulAut.conj x.val := rfl

/-- Native generation follows from the order theorem in the actual generated
subgroup of the pure carrier. No recognition or native-generation premise
enters that order theorem. -/
theorem parabolics_generate : U.leftParabolic ⊔ U.rightParabolic = ⊤ := by
  let E := extension U
  have hle : E.left ⊔ E.right ≤ E.carrier := sup_le E.left_le E.right_le
  have hc := five_completion_card_eq U E (Generated.completion E.left E.right)
    (Generated.whole_overlap E.left E.right) (Nat.card_le_card_of_injective (Subgroup.inclusion hle) (Subgroup.inclusion_injective hle))
  exact (Pure.endpoints_generate_iff _ _ (five_conj_injective U)).mp
    (Subgroup.eq_of_le_of_card_ge hle hc.ge)

/-- A trace-one parameter exists in the actual field of order sixteen. -/
theorem exists_trace_parameter : ∃ t : U.F, t + U.form.conj t = 1 :=
  Theory.SpecificGroups.UnitaryFive.RadicalCentralizers.exists_trace_one
    U.form U.conjugation U.card

/-- The native centralizer kills the fourth power, with the SU₅ kernel retained. -/
theorem fourth_eq_one (t : U.F) (ht : t + U.form.conj t = 1)
    {M : Type*} [Group M] [Finite M]
    (c : RankTwoAmalgam.FaithfulCompletion (extension U).amalgam (G := M))
    (ho : c.left.range ⊓ c.right.range = c.middle.range)
    (hcard : Nat.card M ≤ Nat.card (extension U).carrier) :
    FiveWeyl.rotation U t ht (extension U) c ^ 4 = 1 := by
  apply (FiveWeyl.power_eq_one_iff_nativeOverlap U t ht (extension U) c 4).mpr
  rw [Pure.innerMiddle_range _ _ (five_conj_injective U)]
  exact FiveWeyl.fourth_mem_middle U t ht (extension U) c ho hcard

end Five
end CFSG.Quasithin.Chapter5.UnitaryNativeLift
