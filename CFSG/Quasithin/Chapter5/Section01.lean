module

public import Theory.GroupTheory.CentralizerConjugateGeneration

/-!
# Preliminary analysis of the L₂(2ⁿ) case

This module currently supplies the conjugacy step in the final paragraph
of the proof of Aschbacher–Smith, Theorem 5.1.14 (combined 1 March 2004
manuscript, printed p. 646). The subgroup `L₂` normalizes `V₂` and is
transitive on its nonidentity elements. Lemma 5.1.23 establishes that the
subgroup generated by the `C_G(Z₁)`-conjugates of `V₂` is abelian. Since
`Z₁` has order two, its centralizer is the centralizer of its generator.
The theorem below then makes `V₂` commute with each conjugate containing
that generator, as required by F.8.1(a).

The normalizer transporter is proved in the imported general group theory
module. The abelian-generation premise remains explicit here: this lemma
is one step of the proof, not a statement of Theorem 5.1.14.
-/

namespace CFSG.Quasithin.Chapter5

open Subgroup

/-- The conjugacy step following 5.1.23, with the actual transitive subgroup
and the abelian-generation conclusion of 5.1.23 supplied explicitly. -/
public theorem conjugates_commute_of_abelian_centralizer_generation
    {G : Type*} [Group G] (L V : Subgroup G) {z : G}
    (hzV : z ∈ V) (hz : z ≠ 1)
    (hLV : L ≤ normalizer (V : Set G))
    (htrans : ∀ x ∈ V, x ≠ 1 → ∃ l ∈ L, (MulAut.conj l) z = x)
    [IsMulCommutative (centralizerConjugateClosure V z)]
    {g : G} (hg : z ∈ V.map (MulAut.conj g).toMonoidHom) :
    ⁅V, V.map (MulAut.conj g).toMonoidHom⁆ = ⊥ := by
  have hnormalizer : ∀ x ∈ V, x ≠ 1 → ∃ l ∈ normalizer (V : Set G),
      (MulAut.conj l) z = x := by
    intro x hx hx1
    obtain ⟨l, hl, heq⟩ := htrans x hx hx1
    exact ⟨l, hLV hl, heq⟩
  have hcomm := commutator_eq_bot_of_abelian_centralizerConjugateClosure V hz
    hnormalizer (g := 1) (by exact ⟨z, hzV, by simp⟩) hg
  have heq : V.map (MulAut.conj (1 : G)).toMonoidHom = V := by
    ext x
    simp [Subgroup.mem_map]
  rwa [heq] at hcomm

end CFSG.Quasithin.Chapter5
