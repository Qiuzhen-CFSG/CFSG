module

public import Theory.SpecificGroups.PSL3Four.SylowModel
public import Theory.ElementaryAbelian.AbelianNormalClosure

/-!
# The abelian normal-closure branch of §5.3.7

In UT₃(F₄), squaring detects the product of the two off-diagonal coordinates.
An elementary subgroup therefore lies in the union of the two root planes;
closure under multiplication forces it into one plane. A subgroup containing
Z and centralizing it lies in S, by the computed centralizer of Z.

The source's abelian normal closure is elementary because it is generated by
conjugates of Z. This generation input is essential: an elementary quotient
by the central involution alone does not imply that an abelian subgroup is
elementary. We keep the input as a set of involutory generators, so it also
applies when the conjugating group is larger than the Sylow group.

Source: Aschbacher--Smith, *The Classification of Quasithin Groups*, §5.3.7,
printed p.660 (PDF p.677).
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter5.Section03ExceptionalSylowModel

open Matrix.PSL3Four Matrix.PSL3Four.SylowModel

theorem abelian_le_S (W : Subgroup T) [IsMulCommutative W] (hZ : Z ≤ W) : W ≤ S := by
  rw [← centralizer_Z]
  intro a ha b hb
  exact congrArg Subtype.val ((IsMulCommutative.is_comm (M := W)).comm
    ⟨b, hZ hb⟩ ⟨a, ha⟩)

theorem elementary_le_plane (W : Subgroup T) [IsElementaryAbelian 2 W]
    (hS : W ≤ S) : W ≤ V₁ ∨ W ≤ V₂ := by
  have hsquare (a : T) (ha : a ∈ W) : a.left.x * a.left.y = 0 := by
    have h := congrArg (fun b : T => b.left.c)
      (elemPow_eq_one_of_isElementaryAbelian (p := 2) a ha)
    rw [pow_two] at h
    change a.left.c + (action a.right a.left).c +
      a.left.x * (action a.right a.left).y = 0 at h
    simpa only [(mem_S a).mp (hS ha), map_one, MulAut.one_apply,
      CharTwo.add_self_eq_zero, zero_add] using h
  by_cases h₁ : ∀ a ∈ W, a.left.y = 0
  · exact Or.inl (fun a ha => (mem_V₁ a).mpr ⟨(mem_S a).mp (hS ha), h₁ a ha⟩)
  · push Not at h₁
    obtain ⟨a, ha, hay⟩ := h₁
    have hax : a.left.x = 0 := (mul_eq_zero.mp (hsquare a ha)).resolve_right hay
    apply Or.inr
    intro b hb
    apply (mem_V₂ b).mpr
    refine ⟨(mem_S b).mp (hS hb), ?_⟩
    by_contra hbx
    have hby : b.left.y = 0 := (mul_eq_zero.mp (hsquare b hb)).resolve_left hbx
    have hab := hsquare (a * b) (W.mul_mem ha hb)
    have hbad : b.left.x * a.left.y = 0 := by
      simpa only [SemidirectProduct.mul_left, (mem_S a).mp (hS ha), map_one,
        MulAut.one_apply, mul_x, mul_y, hax, hby, zero_add, add_zero] using hab
    exact (mul_ne_zero hbx hay) hbad

/-- The source generation condition supplies the missing exponent-two input
in the abelian branch. Normality and the elementary quotient are not needed
for this branch after the generators are known. -/
theorem abelian_involution_generated_le_plane (s : Set T)
    [IsMulCommutative (Subgroup.closure s)]
    (hs : ∀ a ∈ s, a ^ 2 = 1) (hZ : Z ≤ Subgroup.closure s) :
    Subgroup.closure s ≤ V₁ ∨ Subgroup.closure s ≤ V₂ := by
  let := IsElementaryAbelian.closure_of_isMulCommutative s hs
  exact elementary_le_plane _ (abelian_le_S _ hZ)

end CFSG.Quasithin.Chapter5.Section03ExceptionalSylowModel
