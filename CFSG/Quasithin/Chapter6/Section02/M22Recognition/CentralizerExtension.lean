module

public import CFSG.Quasithin.Chapter6.Section02.M22Recognition.CentralizerExtension.CoreData
public import CFSG.Quasithin.Chapter6.Section02.M22Recognition.CentralizerExtension.InvariantEight.Geometry
public import CFSG.Quasithin.Chapter6.Section02.M22Recognition.CentralizerExtension.NaturalInvolution
public import Theory.GroupTheory.ElementaryEightFixedPointOrder24
public import Theory.GroupTheory.NormalizingInvolutionCard
public import Theory.ElementaryAbelian.Join

/-!
# The elementary centralizer extension

The intended application is the `|C_R(K)| = 2` branch of Aschbacher–Smith,
Proposition 6.2.13, printed pp.686–688 (PDF pp.703–705). For the alternative
recognition theorem in Huppert–Blackburn III, XII.1.18(b), printed p.314
(PDF p.322), one needs an actual normal elementary sixteen in `H = C_G(z)`
with quotient `S₄`.

Here the intermediate subgroup is an `H`-normal elementary eight `A` in the
extraspecial core. Its centralizer `F = C_H(A)` is normal. If it has order
sixteen and contains an involution outside `A`, then it is elementary: it is
generated by `A` and that commuting involution. The faithful quotient action
on `A` has order twenty-four and fixes the central involution, so the existing
point-stabilizer theorem identifies it with the actual symmetric group.

`source_centralizer_extension` assembles those geometric arguments for the
literal source subgroup `A = ⟨Z_S^H⟩`. It derives its elementarity, order and
location in `T ∩ L`, computes its centralizer order, and obtains the outside
involution from the marked conjugate `A^d`. It therefore constructs the
specific normal elementary sixteen `C_H(A)` and its actual `S₄` quotient.

The hypotheses are earlier local data from pp.687–688. In particular, the
preceding G.6.4(2) argument supplies `NaturalFourOrbit`, and both quotient
identifications concern the actual embedded subgroups. The producer of
these earlier facts is `qt-6-02-m22-branch`, which retains their derivation
from Hypothesis 6.1.1 and the final Proposition 6.2.13. No normality of `V`
in `H`, splitting, or global recognition is used here.
-/

namespace CFSG.Quasithin.Chapter6.M22Recognition.CentralizerExtension

open Subgroup

variable {H : Type*} [Group H]

private def action (A : Subgroup H) [A.Normal] : H →* MulAut A :=
  A.normalizerMonoidHom.comp {
    toFun := fun h => ⟨h, A.normalizer_eq_top ▸ mem_top h⟩
    map_one' := rfl
    map_mul' := fun _ _ => rfl }

private theorem action_ker (A : Subgroup H) [A.Normal] :
    (action A).ker = centralizer (A : Set H) := by
  ext h
  change (⟨h, _⟩ : normalizer (A : Set H)) ∈ A.normalizerMonoidHom.ker ↔ _
  rw [normalizerMonoidHom_ker]
  rfl

variable [Finite H]

/-- The quotient is obtained from the actual conjugation action on the
normal elementary eight, with its marked central point. -/
public theorem centralizer_quotient_symmetric_four
    (A : Subgroup H) [A.Normal] [IsElementaryAbelian 2 A]
    (hH : Nat.card H = 384) (hA : Nat.card A = 8)
    (hF : Nat.card (centralizer (A : Set H)) = 16)
    (z : A) (hz : z ≠ 1) (hzc : (z : H) ∈ center H) :
    Nonempty ((H ⧸ centralizer (A : Set H)) ≃* Equiv.Perm (Fin 4)) := by
  let f := action A
  have hker : f.ker = centralizer (A : Set H) := action_ker A
  have hr : Nat.card f.range = 24 := by
    have hc := f.ker.card_mul_index
    rw [index_ker, hker, hF, hH] at hc
    omega
  have hfix : ∀ a : f.range, (a : MulAut A) z = z := by
    rintro ⟨a, h, rfl⟩
    apply Subtype.ext
    change h * (z : H) * h⁻¹ = z
    rw [mem_center_iff.mp hzc, mul_inv_cancel_right]
  obtain ⟨e⟩ := elementaryEight_fixed_point_order24_equiv_S4 hA z hz f.range hr hfix
  exact ⟨(QuotientGroup.quotientMulEquivOfEq hker.symm).trans
    ((QuotientGroup.quotientKerEquivRange f).trans e)⟩

/-- A single involution outside the elementary eight generates the whole
centralizer with it; this proves exponent two rather than inferring it from
the centralizer order. -/
public theorem elementary_centralizer_of_outside_involution
    (A : Subgroup H) [IsElementaryAbelian 2 A] (hA : Nat.card A = 8)
    (hF : Nat.card (centralizer (A : Set H)) = 16)
    (t : H) (ht : t ∈ centralizer (A : Set H)) (hta : t ∉ A) (ht2 : t ^ 2 = 1) :
    IsElementaryAbelian 2 (centralizer (A : Set H)) := by
  let : IsElementaryAbelian 2 (zpowers t) := IsElementaryAbelian.zpowers_of_pow_eq_one ht2
  have hcomm : zpowers t ≤ centralizer (A : Set H) := zpowers_le.mpr ht
  let : IsElementaryAbelian 2 (A ⊔ zpowers t : Subgroup H) :=
    IsElementaryAbelian.sup_of_le_centralizer hcomm
  have heq : A ⊔ zpowers t = centralizer (A : Set H) := by
    apply eq_of_le_of_card_ge (sup_le (le_centralizer A) hcomm)
    rw [card_sup_zpowers_of_normalizing_involution A t ht2 hta
      (centralizer_le_normalizer _ ht), hA, hF]
  rw [← heq]
  infer_instance

/-- Construct the actual normal subgroup and quotient once the two local
geometric prerequisites have been supplied. This is not yet the source
branch theorem: the invariant eight and outside involution are explicit. -/
public theorem extension_of_normal_eight_and_outside_involution
    (A : Subgroup H) [A.Normal] [IsElementaryAbelian 2 A]
    (hH : Nat.card H = 384) (hA : Nat.card A = 8)
    (hF : Nat.card (centralizer (A : Set H)) = 16)
    (z : A) (hz : z ≠ 1) (hzc : (z : H) ∈ center H)
    (t : H) (ht : t ∈ centralizer (A : Set H)) (hta : t ∉ A) (ht2 : t ^ 2 = 1) :
    ∃ F : Subgroup H, ∃ hN : F.Normal,
      IsElementaryAbelian 2 F ∧ Nat.card F = 16 ∧
        letI := hN
        Nonempty ((H ⧸ F) ≃* Equiv.Perm (Fin 4)) := by
  refine ⟨centralizer (A : Set H), inferInstance,
    elementary_centralizer_of_outside_involution A hA hF t ht hta ht2, hF, ?_⟩
  exact centralizer_quotient_symmetric_four A hH hA hF z hz hzc

/-- A second commuting elementary subgroup supplies the required outside
involution. In the proposed source application this is the conjugate `U^d`;
its containment in the centralizer must still be proved from the local action. -/
public theorem extension_of_commuting_elementary_subgroups
    (A : Subgroup H) [A.Normal] [IsElementaryAbelian 2 A]
    (hH : Nat.card H = 384) (hA : Nat.card A = 8)
    (hF : Nat.card (centralizer (A : Set H)) = 16)
    (z : A) (hz : z ≠ 1) (hzc : (z : H) ∈ center H)
    (B : Subgroup H) [IsElementaryAbelian 2 B]
    (hcomm : B ≤ centralizer (A : Set H)) (hne : ¬ B ≤ A) :
    ∃ F : Subgroup H, ∃ hN : F.Normal,
      IsElementaryAbelian 2 F ∧ Nat.card F = 16 ∧
        letI := hN
        Nonempty ((H ⧸ F) ≃* Equiv.Perm (Fin 4)) := by
  obtain ⟨t, htB, htA⟩ := SetLike.not_le_iff_exists.mp hne
  exact extension_of_normal_eight_and_outside_involution A hH hA hF z hz hzc
    t (hcomm htB) htA (elemPow_eq_one_of_isElementaryAbelian t htB)

variable {G : Type*} [Group G] [Finite G]

/-- Construct `F = C_H(⟨Z_S^H⟩)` from the earlier source local data, including
the natural binary quotient action obtained on p.687. Here `S` is the actual
`Z_S = C_V(T ∩ L)`, and `V` is the natural layer after the source replacement.
The branch intersection and the marked conjugate are equalities in `G`.

The elementary eight, its centralizer order and the outside involution are
all proved in the assembly. The `M/V` quotient and the natural `L/O₂(L)`
action use the same ambient `L` and `V`; neither extension is assumed split.
The source-theorem owner must supply these earlier inputs before applying
this local implication in Proposition 6.2.13. -/
public theorem source_centralizer_extension
    (H M L V : Subgroup G) (z : G) (hH : H = centralizer ({z} : Set G))
    (T : Sylow 2 G) (hTM : (T : Subgroup G) ≤ M) (hLM : L ≤ M)
    (hTH : (T : Subgroup G) ≤ H)
    (hblock : CFSG.Quasithin.ChapterC.IsBlock (L.subgroupOf M))
    (hV : V = L.pCoreIn 2) (hnat : Source.IsNaturalModule L V 2)
    [(V.subgroupOf M).Normal]
    (hq : CompatibleSymmetricFiveQuotient (V.subgroupOf M) (L.subgroupOf M))
    (P S : Subgroup H) [P.Normal] (h : CoreData P) (ha : NaturalFourOrbit P S)
    [IsElementaryAbelian 2 S] (hS : Nat.card S = 4)
    (hZS : coreCenter P ≤ S) (hSP : S ≤ P)
    (hPT : P.map H.subtype ≤ (T : Subgroup G))
    (hSdef : S.map H.subtype = V ⊓ centralizer ((T : Subgroup G) ⊓ L : Set G))
    (hbranch : (sourceEight S).map H.subtype ⊓ V = S.map H.subtype)
    (d : G) (hdL : d ∈ L)
    (hdT : d ∈ normalizer ((T : Subgroup G) ⊓ L : Set G))
    (hd : orderOf d = 3)
    (hPP : P.map H.subtype ⊓
      (P.map H.subtype).map (MulAut.conj d⁻¹).toMonoidHom = S.map H.subtype) :
    (centralizer (sourceEight S : Set H)).Normal ∧
      IsElementaryAbelian 2 (centralizer (sourceEight S : Set H)) ∧
      Nat.card (centralizer (sourceEight S : Set H)) = 16 ∧
      Nonempty ((H ⧸ centralizer (sourceEight S : Set H)) ≃* Equiv.Perm (Fin 4)) := by
  subst H
  let H := centralizer ({z} : Set G)
  let A := sourceEight S
  let U := A.map H.subtype
  have hVL : V ≤ L := by
    rw [hV]
    exact map_subtype_le _
  have hVM : V ≤ M := hVL.trans hLM
  have hTmap : ((T.subtype hTM : Sylow 2 M) : Subgroup M).map M.subtype = T := by
    rw [Sylow.coe_subtype, map_subgroupOf_eq_of_le hTM]
  have hUloc := sourceEight_le_sylow_inf_layer H M P S h ha hS hZS hSP
    (T.subtype hTM) (V.subgroupOf M) (L.subgroupOf M) hq
    (hTmap.symm ▸ hTH) (hTmap.symm ▸ hPT)
    (by rwa [map_subgroupOf_eq_of_le hVM])
  have hUTL : U ≤ (T : Subgroup G) ⊓ L := by
    simpa only [map_inf _ _ M.subtype M.subtype_injective, hTmap,
      map_subgroupOf_eq_of_le hLM] using hUloc
  let : IsElementaryAbelian 2 A := sourceEight_elementary h ha hS
  let : IsElementaryAbelian 2 U := IsElementaryAbelian.map H.subtype
  have hA : Nat.card A = 8 := sourceEight_card h ha hZS
  have hU : Nat.card U = 8 := (card_map_of_injective H.subtype_injective).trans hA
  have hC : Nat.card (centralizer (A : Set H)) = 16 :=
    sourceEight_centralizer_card h ha hS hZS hSP
  have hUP : U ≤ P.map H.subtype := map_mono (sourceEight_le_core P S hSP)
  have hUV : U ⊓ V = V ⊓ centralizer ((T : Subgroup G) ⊓ L : Set G) :=
    hbranch.trans hSdef
  have hZ : Nat.card (V ⊓ centralizer ((T : Subgroup G) ⊓ L : Set G) : Subgroup G) = 4 := by
    rw [← hSdef, card_map_of_injective H.subtype_injective, hS]
  obtain ⟨t, ht, htA, ht2⟩ := NaturalInvolution.exists_outside_involution
    T L M V U (P.map H.subtype) z d hTM hLM hblock hV hnat hTH hU hUTL hUV hZ
    hUP hdL hdT hd (hPP.trans hSdef)
  have hUA : U.subgroupOf H = A :=
    comap_map_eq_self_of_injective H.subtype_injective A
  change t ∈ centralizer (U.subgroupOf H : Set H) at ht
  change t ∉ U.subgroupOf H at htA
  rw [hUA] at ht htA
  have hc := coreCenter_card h
  have : Nontrivial (coreCenter P) := Finite.one_lt_card_iff_nontrivial.mp (by omega)
  obtain ⟨w, hw⟩ := exists_ne (1 : coreCenter P)
  let wA : A := ⟨w, sourceEight_contains S (hZS w.property)⟩
  have hwA : wA ≠ 1 := by
    intro he
    apply hw
    apply Subtype.ext
    exact congrArg (fun a : A => (a : H)) he
  exact ⟨inferInstance,
    elementary_centralizer_of_outside_involution A hA hC t ht htA ht2, hC,
    centralizer_quotient_symmetric_four A h.card hA hC wA hwA (h.center_le w.property)⟩

end CFSG.Quasithin.Chapter6.M22Recognition.CentralizerExtension
