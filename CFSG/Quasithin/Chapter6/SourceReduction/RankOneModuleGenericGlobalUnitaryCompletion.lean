module
public import CFSG.Quasithin.ChapterF.Section04.SourceCompletion.UnitaryNonbinary
public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleGenericGlobalUnitaryFactors
public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleGenericGlobalNormalizer

/-!
# The original normalizer pair as a unitary extension completion

A compatible realization of the full original normalizers gives a faithful
completion in their actual join, with the whole intersection and the ambient
order bound retained. Neither generation of G nor recognition is assumed.
The prepared four-dimensional comparison, ordinary or degree two and in
either orientation, supplies m > 1 and n = 2m by the existing nonsolvability
argument. The five-dimensional extension is over the fixed model PSU₅(4).

These are the literal inputs for the remaining small-completion recognition.
They do not yet prove a GlobalExit. Source: Aschbacher–Smith 5.2.6–7,
5.3.1–4 and F.4.24, printed pp.650–651, 658–659 and287.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter6.Source.RankOneGeneric.Global
namespace UnitaryCompletion
open ChapterF.SourceCompletion.UnitaryNonbinary
open ChapterF.GreenBook.LieModels.UnitaryFour
variable {G : Type*} [Group G]

/-- The actual subgroup generated by the original full normalizers. -/
abbrev NormalizerJoin (L K : Subgroup G) : Subgroup G :=
  normalizer (L : Set G) ⊔ normalizer (K : Set G)

/-- Both inclusion maps of `normalizerAmalgam`, with its whole intersection. -/
abbrev normalizerDiagram (L K : Subgroup G) :=
  RankTwoAmalgam.ofSubgroups (normalizerAmalgam L K).M₁
    (normalizerAmalgam L K).M₁₂ (normalizerAmalgam L K).M₂
    (normalizerAmalgam L K).middle_left (normalizerAmalgam L K).middle_right

/-- Parent-produced DGS data must identify the entire marked diagram. -/
def Compatible {B : Type*} [Group B] {P₀ P₁ : Subgroup B}
    (L K : Subgroup G) (E : SourceExtension P₀ P₁) : Prop :=
  Nonempty (RankTwoAmalgam.Iso (normalizerDiagram L K) E.amalgam) ∨
    Nonempty (RankTwoAmalgam.Iso (normalizerDiagram L K) E.amalgam.reverse)

/-- The original comparison allows both native and degree-two outer endpoints. -/
def FourLocalComparison (L R S : Subgroup G) (m : ℕ) (hm : 1 ≤ m) : Prop :=
  (Nonempty (RankTwoAmalgam.Iso (sourceParabolicAmalgam ![L,R] S) (amalgam m hm)) ∨
    Nonempty (RankTwoAmalgam.Iso (sourceParabolicAmalgam ![L,R] S) (amalgam m hm).reverse)) ∨
  (Nonempty (RankTwoAmalgam.Iso (sourceParabolicAmalgam ![L,R] S) (Extension.amalgam m hm)) ∨
    Nonempty (RankTwoAmalgam.Iso (sourceParabolicAmalgam ![L,R] S) (Extension.amalgam m hm).reverse))

variable [Finite G]

/-- No ambient generation premise is needed to construct the source completion. -/
theorem exists_normalizer_completion
    {B : Type*} [Group B] {P₀ P₁ : Subgroup B}
    (L K : Subgroup G) (E : SourceExtension P₀ P₁)
    (he : Compatible L K E) (horder : Nat.card G ≤ Nat.card E.carrier) :
    ∃ c : RankTwoAmalgam.FaithfulCompletion E.amalgam (G := NormalizerJoin L K),
      c.left.range ⊓ c.right.range = c.middle.range ∧
      Nat.card (NormalizerJoin L K) ≤ Nat.card E.carrier := by
  obtain ⟨c,hc⟩ := Generated.exists_completion (normalizer (L : Set G))
    (normalizer (K : Set G)) he
  exact ⟨c,hc,(Nat.card_le_card_of_injective
    (NormalizerJoin L K).subtype (NormalizerJoin L K).subtype_injective).trans horder⟩

/-- Once F.4.24 gives equality for the generated completion, the original
ambient order bound forces the two full normalizers to generate G. -/
theorem normalizerJoin_eq_top_of_card
    {B : Type*} [Group B] {P₀ P₁ : Subgroup B}
    (L K : Subgroup G) (E : SourceExtension P₀ P₁)
    (horder : Nat.card G ≤ Nat.card E.carrier)
    (heq : Nat.card (NormalizerJoin L K) = Nat.card E.carrier) :
    NormalizerJoin L K = ⊤ := by
  apply eq_top_of_card_eq
  apply Nat.le_antisymm
  · exact Nat.card_le_card_of_injective (NormalizerJoin L K).subtype
      (NormalizerJoin L K).subtype_injective
  · exact heq.symm ▸ horder

/-- The fixed-parameter five-dimensional source row retains the actual
projective group and both compatible endpoint maps. -/
theorem five_normalizer_completion
    (L H : Subgroup G) (U : ChapterF.GreenBook.UnitaryFive.Model 4)
    (E : FiveExtension U) (he : Compatible L (residual H) E)
    (horder : Nat.card G ≤ Nat.card E.carrier) :
    ∃ c : RankTwoAmalgam.FaithfulCompletion E.amalgam
        (G := NormalizerJoin L (residual H)),
      c.left.range ⊓ c.right.range = c.middle.range ∧
      Nat.card (NormalizerJoin L (residual H)) ≤ Nat.card E.carrier :=
  exists_normalizer_completion L (residual H) E he horder

end UnitaryCompletion

open ChapterF.SourceCompletion.UnitaryNonbinary UnitaryCompletion
open ChapterF.GreenBook.LieModels.UnitaryFour

/-- The original prepared comparison supplies the strict unitary exponent;
the DGS realization then supplies the full-normalizer completion. -/
theorem Preparation.unitary_completion_input
    {G : Type*} [Group G] [Finite G]
    {T : Sylow 2 G} {L W H A C : Subgroup G} {n : ℕ}
    (d : Preparation T L H A C (residual H))
    (h : Input KnownSimple.IsKnownSimple T L W n)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hp : Group.IsPerfect (residual H))
    (m : ℕ) (hm : 1 ≤ m)
    (hc : FourLocalComparison L (residual H) (sourceS L H) m hm)
    (E : FourExtension m hm) (he : Compatible L (residual H) E)
    (horder : Nat.card G ≤ Nat.card E.carrier) :
    1 < m ∧ n = 2*m ∧
      ∃ c : RankTwoAmalgam.FaithfulCompletion E.amalgam
          (G := NormalizerJoin L (residual H)),
        c.left.range ⊓ c.right.range = c.middle.range ∧
        Nat.card (NormalizerJoin L (residual H)) ≤ Nat.card E.carrier ∧
        ∀ i : Bool, Nat.card (NormalizerJoin L (residual H) ⧸ c.cosetFamily i) ≤
          Nat.card (ProjectiveGroup m hm ⧸ SourceExtension.nativeFamily
            (P₀ := pointParabolic m hm) (P₁ := planeParabolic m hm) i) := by
  have hb : 1 < m ∧ n = 2*m := by
    rcases hc with hc | hc
    · have hs := d.unitary_local_structure h hH.1.1.2 hp m hm hc
      exact ⟨hs.1,hs.2.1⟩
    · have hs := d.unitaryExtension_local_structure h hH.1.1.2 hp m hm hc
      exact ⟨hs.1,hs.2.1⟩
  obtain ⟨c,hc,hcard⟩ := exists_normalizer_completion L (residual H) E he horder
  let : Finite (ProjectiveGroup m hm) := Finite.of_surjective (projection m hm)
    (Theory.SpecificGroups.ClassicalUnitary.UnitaryFourFlag.project_surjective _ _)
  exact ⟨hb.1,hb.2,c,hc,hcard,fun i => E.completion_card_coset_le_native
    (four_conj_injective m hm) (parabolics_generate m hm) c hcard i⟩

end CFSG.Quasithin.Chapter6.Source.RankOneGeneric.Global
