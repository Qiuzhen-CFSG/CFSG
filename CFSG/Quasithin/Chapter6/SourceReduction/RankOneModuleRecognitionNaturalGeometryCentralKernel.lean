private theorem symmetric_section
    {A : Type u} {B : Type*} [Group A] [Finite A] [Group B]
    (f : A →* B) (hf : Function.Surjective f) (hc : f.ker ≤ center A)
    (ho : Odd (Nat.card f.ker)) {m : ℕ} (e : B ≃* Equiv.Perm (Fin m))
    (hsplit : SymmetricOddCentralSplitting.{u} m) :
    ∃ D : Subgroup A, D.Characteristic ∧ ∃ eD : D ≃* B, ∀ x, eD x = f x := by
  let q := e.toMonoidHom.comp f
  have hq : Function.Surjective q := e.surjective.comp hf
  have hk : q.ker = f.ker := by ext x; simp [q,MonoidHom.mem_ker]
  obtain ⟨D,hD⟩ := hsplit A q hq (hk ▸ hc) (hk ▸ ho)
  have hchar : D.Characteristic := characteristic_complement_of_twoGenerated_quotient
    q hq (hk ▸ hc) (hk ▸ ho) (twoGenerated_perm m) D hD
  have hdis : Disjoint f.ker D := hk ▸ hD.disjoint
  have hgen : f.ker ⊔ D = ⊤ := hk ▸ hD.sup_eq_top
  have hi : Function.Injective (f.domRestrict D) := by
    apply (MonoidHom.ker_eq_bot_iff _).mp
    apply bot_unique
    intro x hx
    exact Subtype.ext (hdis.le_bot ⟨hx,x.property⟩)
  have hs : Function.Surjective (f.domRestrict D) := by
    intro b
    obtain ⟨a,rfl⟩ := hf b
    obtain ⟨k,hk,d,hd,he⟩ := mem_sup_of_normal_left.mp (hgen.symm ▸ mem_top a)
    refine ⟨⟨d,hd⟩,?_⟩
    rw [←he,map_mul,show f k = 1 from hk,one_mul]
    rfl
  exact ⟨D,hchar,MulEquiv.ofBijective (f.domRestrict D) ⟨hi,hs⟩,fun _ => rfl⟩

private theorem binary_three_section
    {A B : Type*} [Group A] [Finite A] [Group B]
    (f : A →* B) (hf : Function.Surjective f) (hc : f.ker ≤ center A)
    (hcore : pCore 2 A = ⊥) (e : B ≃* Matrix.PSL3Two.SL) :
    ∃ D : Subgroup A, D.Characteristic ∧ ∃ eD : D ≃* B, ∀ x, eD x = f x := by
  let q := e.toMonoidHom.comp f
  have hq : Function.Surjective q := e.surjective.comp hf
  have hk : q.ker = f.ker := by ext x; simp [q,MonoidHom.mem_ker]
  let : Group.IsPerfect Matrix.PSL3Two.SL := Atlas.sl_perfect 3 (by decide)
  let D := commutator A
  let : Group.IsPerfect D :=
    PerfectCentralCovering.commutator_isPerfect_of_surjective_of_ker_le_center q hq (hk ▸ hc)
  have hmap : D.map q = ⊤ := by
    rw [map_commutator_eq,MonoidHom.range_eq_top.mpr hq]
    exact Group.IsPerfect.commutator_eq_top
  let g := q.domRestrict D
  have hg : Function.Surjective g := by
    intro b
    obtain ⟨a,ha,he⟩ := hmap.symm ▸ mem_top b
    exact ⟨⟨a,ha⟩,he⟩
  let c : PerfectCentralCovering.Cover D Matrix.PSL3Two.SL := {
    toMonoidHom := g
    surjective := hg
    isPerfect := inferInstance
    ker_le_center := by
      intro x hx
      exact mem_center_iff.mpr fun y => Subtype.ext
        ((mem_center_iff (G := A)).mp ((hk ▸ hc) hx) (y : A)) }
  have hd : pCore 2 D = ⊥ := by
    rw [pCore_subnormal_eq_comap 2 (inferInstance : D.Normal).isSubnormal,hcore]
    exact (MonoidHom.ker_eq_bot_iff D.subtype).mpr D.subtype_injective
  let eD := (Matrix.PSL3Two.centralCoverEquiv c hd).trans e.symm
  refine ⟨D,inferInstance,eD,?_⟩
  intro x
  change e.symm (Matrix.PSL3Two.centralCoverEquiv c hd x) = f x
  rw [Matrix.PSL3Two.centralCoverEquiv_apply]
  exact e.symm_apply_apply (f x)

private theorem small_section
    {A B V : Type*} [Group A] [Finite A] [Group B] [AddCommGroup V]
    [Module (ZMod 2) V] {ρ : Representation (ZMod 2) B V}
    {K : Subgroup B} {U : Submodule (ZMod 2) V}
    (hm : SmallFactorModel ρ K U)
    (f : A →* K) (hf : Function.Surjective f) (hc : f.ker ≤ center A)
    (hcore : pCore 2 A = ⊥) :
    ∃ D : Subgroup A, D.Characteristic ∧ ∃ eD : D ≃* K, ∀ x, eD x = f x := by
  have ho : Odd (Nat.card f.ker) := Nat.not_even_iff_odd.mp (by
    rw [even_iff_two_dvd]
    exact PerfectCentralCovering.not_dvd_card_central_of_pCore_eq_bot hcore f.ker hc)
  rcases hm with ⟨e,_,_⟩ | ⟨e,_,_⟩ | ⟨e,_,_⟩
  · exact symmetric_section f hf hc ho
      (e.trans ((BinaryLinear.OuterCyclic.slEquivLinear 2).symm.trans
        (Classical.choice SLTwoPermThree.sl2Two_equiv_perm_three)))
      symmetricOddCentralSplitting_three
  · exact binary_three_section f hf hc hcore
      (e.trans (BinaryLinear.OuterCyclic.slEquivLinear 3).symm)
  · exact symmetric_section f hf hc ho e symmetricOddCentralSplitting_five


private theorem factor_section
    {A B V : Type*} [Group A] [Finite A] [Group B] [AddCommGroup V]
    [Module (ZMod 2) V] {ρ : Representation (ZMod 2) B V}
    {K : Subgroup B} [K.Normal] {U : Submodule (ZMod 2) V}
    (hm : SmallFactorModel ρ K U)
    (f : A →* B) (hf : Function.Surjective f) (hc : f.ker ≤ center A)
    (hcore : pCore 2 A = ⊥) :
    ∃ s : K →* A, s.range.Normal ∧ ∀ x, f (s x) = (x : B) := by
  let H := K.comap f
  let q := f.subgroupComap K
  have hq : Function.Surjective q := f.subgroupComap_surjective_of_surjective K hf
  have hqc : q.ker ≤ center H := by
    intro x hx
    have hk : (x : A) ∈ f.ker := congrArg Subtype.val (MonoidHom.mem_ker.mp hx)
    exact mem_center_iff.mpr fun y => Subtype.ext (mem_center_iff.mp (hc hk) y)
  have hH : pCore 2 H = ⊥ := by
    rw [pCore_subnormal_eq_comap 2 (inferInstance : H.Normal).isSubnormal,hcore]
    exact (MonoidHom.ker_eq_bot_iff H.subtype).mpr H.subtype_injective
  obtain ⟨D,hD,eD,heD⟩ := small_section hm q hq hqc hH
  let := hD
  let s := H.subtype.comp (D.subtype.comp eD.symm.toMonoidHom)
  have hr : s.range = D.map H.subtype := by
    rw [MonoidHom.range_comp,MonoidHom.range_comp,
      MonoidHom.range_eq_top.mpr eD.symm.surjective,←MonoidHom.range_eq_map,range_subtype]
  refine ⟨s,hr.symm ▸ (inferInstance : (D.map H.subtype).Normal),?_⟩
  intro x
  have hh := (heD (eD.symm x)).symm.trans (eD.apply_symm_apply x)
  exact congrArg Subtype.val hh

private theorem injective_of_sections
    {A : Type*} {B V : Type v} [Group A] [Finite A] [Group B] [AddCommGroup V]
    [Module (ZMod 2) V] {ρ : Representation (ZMod 2) B V}
    (d : TransvectionProductModel ρ)
    (f : A →* B) (hc : f.ker ≤ center A) (ho : Odd (Nat.card f.ker))
    (hgen : closure {a : A | a ^ 2 = 1} = ⊤)
    (hs : ∀ (K : Subgroup B), K ∈ d.factors → ∃ s : K →* A,
      s.range.Normal ∧ ∀ x : K, f (s x) = (x : B)) : Function.Injective f := by
  classical
  let ι := {K // K ∈ d.factors}
  choose s hn he using fun K : ι => hs K.val K.property
  have hi (K : ι) : Function.Injective ((f.comp (s K))) := by
    intro x y hxy
    apply Subtype.ext
    simpa only [MonoidHom.comp_apply,he] using hxy
  have hc' : Pairwise fun K H : ι => ∀ x y, Commute (s K x) (s H y) := by
    intro K H hne x y
    apply commutatorElement_eq_one_iff_mul_comm.mp
    let := hn K
    have hm : ⁅s K x,s H y⁆ ∈ (s K).range :=
      commutator_le_left (s K).range ⊤ (commutator_mem_commutator ⟨x,rfl⟩ (mem_top _))
    obtain ⟨z,hz⟩ := hm
    have hh : f (s K z) = 1 := by
      rw [hz,map_commutatorElement,he,he]
      exact (d.commute hne x y x.property y.property).commutator_eq
    have hz1 : z = 1 := hi K (hh.trans (map_one (f.comp (s K))).symm)
    rw [←hz,hz1,map_one]
  let t := MonoidHom.noncommPiCoprod s hc'
  have ht : f.comp t = d.productEquiv.toMonoidHom := by
    apply MonoidHom.pi_ext
    intro K x
    change f (t (Pi.mulSingle K x)) = d.productEquiv (Pi.mulSingle K x)
    rw [MonoidHom.noncommPiCoprod_mulSingle,he]
    exact (d.productEquiv_single K x).symm
  let r := t.comp d.productEquiv.symm.toMonoidHom
  have hr (b : B) : f (r b) = b := by
    change (f.comp t) (d.productEquiv.symm b) = b
    rw [ht]
    exact d.productEquiv.apply_symm_apply b
  have hdis : Disjoint f.ker r.range := by
    apply disjoint_iff_inf_le.mpr
    rintro _ ⟨hx,b,rfl⟩
    have hb : b = 1 := (hr b).symm.trans hx
    simp only [hb,map_one,mem_bot]
  have hsup : f.ker ⊔ r.range = ⊤ := by
    apply top_unique
    intro a _
    have hk : a * (r (f a))⁻¹ ∈ f.ker := by
      rw [MonoidHom.mem_ker,map_mul,map_inv,hr,mul_inv_cancel]
    have hh := (f.ker ⊔ r.range).mul_mem (mem_sup_left hk) (mem_sup_right ⟨f a,rfl⟩)
    simpa using hh
  have hnormal : r.range.Normal := normalizer_eq_top_iff.mp (top_unique (by
    rw [←hsup]
    exact sup_le (hc.trans (center_le_normalizer _)) r.range.le_normalizer))
  let := hnormal
  have hcomp : f.ker.IsComplement' r.range :=
    isComplement'_of_disjoint_and_mul_eq_univ hdis (by rw [←normal_mul,hsup,coe_top])
  have hodd : Odd (Nat.card (A ⧸ r.range)) := by
    rw [Nat.card_congr hcomp.QuotientMulEquiv.toEquiv]
    exact ho
  have htop : r.range = ⊤ := by
    apply top_unique
    rw [←hgen]
    apply (closure_le _).mpr
    intro a ha
    apply (QuotientGroup.eq_one_iff a).mp
    apply hodd.coprime_two_right.pow_left_bijective.injective
    change (QuotientGroup.mk' r.range a)^2=1^2
    rw [←map_pow,ha,map_one,one_pow]
  apply (MonoidHom.ker_eq_bot_iff f).mp
  apply bot_unique
  intro a ha
  exact hdis.le_bot ⟨ha,htop.symm ▸ mem_top a⟩

