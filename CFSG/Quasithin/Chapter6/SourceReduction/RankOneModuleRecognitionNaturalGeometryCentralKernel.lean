/-- In an involution-generated central cover of the full small transvection
product, trivial two-core removes the entire kernel of the original map. -/
theorem SmallTransvectionProductModel.central_cover_injective
    {A : Type*} {B V : Type v} [Group A] [Finite A] [Group B] [AddCommGroup V]
    [Module (ZMod 2) V] {ρ : Representation (ZMod 2) B V}
    (d : SmallTransvectionProductModel ρ)
    (f : A →* B) (hf : Function.Surjective f) (hc : f.ker ≤ center A)
    (hcore : pCore 2 A = ⊥)
    (hgen : closure {a : A | a ^ 2 = 1} = ⊤) : Function.Injective f := by
  have ho : Odd (Nat.card f.ker) := Nat.not_even_iff_odd.mp (by
    rw [even_iff_two_dvd]
    exact PerfectCentralCovering.not_dvd_card_central_of_pCore_eq_bot hcore f.ker hc)
  apply NaturalKernel.injective_of_sections d.toTransvectionProductModel f hc ho hgen
  intro K hK
  obtain ⟨U,hm⟩ := d.small K hK
  have hn : K.Normal := by
    obtain ⟨t,_,rfl,_⟩ := d.marked K hK
    infer_instance
  let := hn
  exact NaturalKernel.factor_section hm f hf hc hcore


/-- The whole product lifts through the original covering map. Each coordinate
is exactly the full preimage of its marked factor, so this identifies the
literal factors of the cover as well as its abstract isomorphism type. -/
theorem SmallTransvectionProductModel.central_cover_product
    {A : Type*} {B V : Type v} [Group A] [Finite A] [Group B] [AddCommGroup V]
    [Module (ZMod 2) V] {ρ : Representation (ZMod 2) B V}
    (d : SmallTransvectionProductModel ρ)
    (f : A →* B) (hf : Function.Surjective f) (hc : f.ker ≤ center A)
    (hcore : pCore 2 A = ⊥)
    (hgen : closure {a : A | a ^ 2 = 1} = ⊤) :
    ∃ e : (∀ K : {K // K ∈ d.factors}, K.val) ≃* A,
      (∀ x, f (e x) = d.productEquiv x) ∧
      (∀ K : {K // K ∈ d.factors}, ∀ a : A,
        a ∈ K.val.comap f ↔ ∃ x : K.val,
          e (Function.update 1 K x) = a) := by
  classical
  have hi := d.central_cover_injective f hf hc hcore hgen
  let q := MulEquiv.ofBijective f ⟨hi,hf⟩
  let e := d.productEquiv.trans q.symm
  have he (x) : f (e x) = d.productEquiv x := q.apply_symm_apply _
  refine ⟨e,he,?_⟩
  intro K a
  constructor
  · intro ha
    refine ⟨⟨f a,ha⟩,hi ?_⟩
    rw [he,d.productEquiv_single]
  · rintro ⟨x,rfl⟩
    change f (e (Function.update 1 K x)) ∈ K.val
    rw [he,d.productEquiv_single]
    exact x.property

