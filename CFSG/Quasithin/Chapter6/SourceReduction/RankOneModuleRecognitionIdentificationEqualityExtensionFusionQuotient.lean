module
public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleRecognitionIdentificationEqualityExtensionTransferGeometry

/-!
# The symmetric-five quotient used for equality fusion

Let P be the canonical extraspecial core and J = LP. The already marked
map M → S₅ sends J onto S₅, since its image contains A₅ and an outer actor.
The source orders |L|=960, |P|=32 and |L∩P|=16 give |J|=1920.
Its kernel therefore has order16 and equals the natural layer V.
This retains the original map, without choosing a split model for J.

The involution-fusion consumer uses this kernel to lift conjugacy from S₅
through V. Source: Aschbacher–Smith, proof of 6.2.13, printed p.688.
-/

open Subgroup Theory.GroupTheory
public noncomputable section
namespace CFSG.Quasithin.Chapter6.Source.RankOneRecognition
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L M R : Subgroup G} {n : ℕ} {z : G}

omit [Finite G] in
private theorem map_card_formula {J : Type*} [Group J] [Finite J]
    (B : Subgroup G) (f : G →* J) :
    Nat.card B = Nat.card (B ⊓ f.ker : Subgroup G) * Nat.card (B.map f) := by
  let g := f.comp B.subtype
  have hk : Nat.card g.ker = Nat.card (B ⊓ f.ker : Subgroup G) := by
    change Nat.card (f.ker.subgroupOf B) = _
    rw [← inf_subgroupOf_right f.ker B,
      Nat.card_congr (subgroupOfEquivOfLe (show f.ker ⊓ B ≤ B from inf_le_right)).toEquiv,
      inf_comm]
  have hc := g.ker.card_mul_index
  rw [index_ker,MonoidHom.range_comp,range_subtype,hk] at hc
  exact hc.symm

private theorem symmetric_five_generated (B : Subgroup (Equiv.Perm (Fin 5)))
    (hA : alternatingGroup (Fin 5) ≤ B) (hout : ¬ B ≤ alternatingGroup (Fin 5)) : B = ⊤ := by
  have h60 : Nat.card (alternatingGroup (Fin 5)) = 60 := by
    rw [nat_card_alternatingGroup,Nat.card_fin]; norm_num
  have h120 : Nat.card (Equiv.Perm (Fin 5)) = 120 := by
    rw [Nat.card_eq_fintype_card,Fintype.card_perm,Fintype.card_fin]; norm_num
  have hlo : 60 ≤ Nat.card B := h60 ▸ card_le_of_le hA
  have hne : Nat.card B ≠ 60 := by
    intro he
    exact hout ((eq_of_le_of_card_ge hA (by omega)).symm.le)
  have hd : Nat.card B ∣ 120 := h120 ▸ B.card_subgroup_dvd_card
  have hh : ∀ b : ℕ, b < 121 → 60 < b → b ∣ 120 → b = 120 := by decide +kernel
  exact eq_top_of_card_eq B ((hh _ (by have := Nat.le_of_dvd (by decide : 0 < (120 : ℕ)) hd; omega) (by omega) hd).trans h120.symm)

/-- The subgroup generated by L and the canonical core has kernel exactly V
under the same marked symmetric-five map. -/
theorem LocalAnalysis.equality_fusion_quotient
    (A : LocalAnalysis (T : Subgroup G) L M R z)
    (h611 : Hypothesis611 KnownSimple.IsKnownSimple T L M R n)
    (hnatural : Conclusion6127 (T : Subgroup G) L M R n)
    (hz : z ∈ ZS (T : Subgroup G) L R) (horder : orderOf z = 2)
    (hTH : (T : Subgroup G) ≤ centralizer ({z} : Set G))
    (hbranch : sourceClosure (T : Subgroup G) L R z ⊓ layer L R = ZS (T : Subgroup G) L R)
    (f : M →* Equiv.Perm (Fin 5))
    (hker : f.ker = ((L ⊔ (T : Subgroup G)).pCoreIn 2).subgroupOf M)
    (hL : (L.subgroupOf M).map f = alternatingGroup (Fin 5)) :
    let J := L ⊔ (equalityCore L R z).map (centralizer ({z} : Set G)).subtype
    (J.subgroupOf M).map f = ⊤ ∧
      J ⊓ (L ⊔ (T : Subgroup G)).pCoreIn 2 = layer L R := by
  let H := centralizer ({z} : Set G)
  let P := (equalityCore L R z).map H.subtype
  let Q := (L ⊔ (T : Subgroup G)).pCoreIn 2
  let V := layer L R
  let J := L ⊔ P
  have hPT : P ≤ (T : Subgroup G) := equalityCore_le_sylow hTH
  have hPM : P ≤ M := hPT.trans h611.sylow_le
  have hQM : Q ≤ M := (pCoreIn_le 2 _).trans (sup_le h611.L_le h611.sylow_le)
  have hJM : J ≤ M := sup_le h611.L_le hPM
  have hVM : V ≤ M := h611.layer_le_L.trans h611.L_le
  have hVQ : V ≤ Q := h611.layer_le_V.trans (reduced_le_core h611.V_mem)
  have hLQ : L ⊓ Q = V := by
    rw [show V = L.pCoreIn 2 from A.equality_layer_eq_core h611 hnatural hz horder hTH hbranch]
    apply le_antisymm ?_ (le_inf (pCoreIn_le 2 L) (by
      rw [← A.equality_layer_eq_core h611 hnatural hz horder hTH hbranch]; exact hVQ))
    apply le_pCoreIn_of_normalizes
      ((isPGroup_pCoreIn 2 (L ⊔ (T : Subgroup G))).to_le inf_le_right) inf_le_left
    have hLN : L ≤ normalizer (Q : Set G) :=
      (show L ≤ L ⊔ (T : Subgroup G) from le_sup_left).trans
        ((L ⊔ (T : Subgroup G)).le_normalizer.trans
          (normalizer_le_normalizer_characteristic_image _ (pCore 2 _)))
    intro l hl
    rw [mem_normalizer_iff_map_conj_eq,map_inf _ _ _ (MulAut.conj l).injective,
      mem_normalizer_iff_map_conj_eq.mp (L.le_normalizer hl),
      mem_normalizer_iff_map_conj_eq.mp (hLN hl)]
  have hmap : (J.subgroupOf M).map f = ⊤ := by
    apply symmetric_five_generated
    · rw [←hL]
      exact map_mono (subgroupOf_mono M le_sup_left)
    · intro hh
      have hP : (P.subgroupOf M).map f ≤ (L.subgroupOf M).map f := by
        rw [hL]
        exact (map_mono (subgroupOf_mono M (show P ≤ J from le_sup_right))).trans hh
      have hc := (map_le_iff_le_comap).mp hP
      rw [comap_map_eq,hker] at hc
      have hm := map_mono (f := M.subtype) hc
      rw [Subgroup.map_sup,map_subgroupOf_eq_of_le hPM,
        map_subgroupOf_eq_of_le h611.L_le,map_subgroupOf_eq_of_le hQM] at hm
      exact A.equality_core_not_le_local_core_join h611 hnatural hz horder hTH hbranch hm
  have hL60 : Nat.card ((L.subgroupOf M).map f) = 60 := by
    rw [hL,nat_card_alternatingGroup,Nat.card_fin]; norm_num
  have hL960 : Nat.card L = 960 := by
    have hh := map_card_formula (L.subgroupOf M) f
    rw [hker,show L.subgroupOf M ⊓ Q.subgroupOf M = (L ⊓ Q).subgroupOf M from rfl,hLQ,
      Nat.card_congr (subgroupOfEquivOfLe h611.L_le).toEquiv,
      Nat.card_congr (subgroupOfEquivOfLe hVM).toEquiv,hL60,
      show Nat.card V = 16 from hnatural.2.1.card] at hh
    exact hh
  have hP32 : Nat.card P = 32 := by
    rw [card_map_of_injective H.subtype_injective]
    exact (A.equality_action_pair_data h611 hnatural hz horder hTH hbranch).plusType.some.card
  have hLP16 : Nat.card (L ⊓ P : Subgroup G) = 16 := by
    rw [inf_comm]
    exact (A.equality_transfer_subgroup_orders h611 hnatural hz horder hTH hbranch).2.1
  have hJ1920 : Nat.card J = 1920 := by
    have hc := card_mul_eq_card_inf_mul_card_sup_of_normalizes L P
      (hPT.trans h611.sylow_normalizes_L)
    rw [hL960,hP32,hLP16] at hc
    change 960 * 32 = 16 * Nat.card J at hc
    omega
  have hJQ16 : Nat.card (J ⊓ Q : Subgroup G) = 16 := by
    have hh := map_card_formula (J.subgroupOf M) f
    rw [hker,show J.subgroupOf M ⊓ Q.subgroupOf M = (J ⊓ Q).subgroupOf M from rfl,
      Nat.card_congr (subgroupOfEquivOfLe hJM).toEquiv,
      Nat.card_congr (subgroupOfEquivOfLe (show J ⊓ Q ≤ M from inf_le_left.trans hJM)).toEquiv,
      hmap,card_top,show Nat.card (Equiv.Perm (Fin 5)) = 120 from by
        rw [Nat.card_eq_fintype_card,Fintype.card_perm,Fintype.card_fin]; norm_num,hJ1920] at hh
    omega
  exact ⟨hmap,(eq_of_le_of_card_ge (le_inf (h611.layer_le_L.trans le_sup_left) hVQ)
    (by rw [hJQ16,hnatural.2.1.card]; decide)).symm⟩
end CFSG.Quasithin.Chapter6.Source.RankOneRecognition
