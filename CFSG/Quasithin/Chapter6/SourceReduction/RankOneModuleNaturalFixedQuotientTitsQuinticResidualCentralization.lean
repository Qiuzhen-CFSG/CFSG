module

public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleNaturalFixedQuotientTitsQuinticCentralization
public import Theory.GroupTheory.PResidual.QuinticModuleCentralization

/-!
# The original Tits row: the whole residual centralizes the original module

The actual order-five supplement centralizes the full Hermitian module modulo
`O₂(KT)`.  Passing through the literal join generated by that supplement and
the original Sylow gives the same conclusion for the complete two-perfect
quintic residual, without replacing its kernel by a quotient kernel.
-/

set_option backward.isDefEq.respectTransparency false
public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher Representation
attribute [local instance] Representation.SL2.BinarySmall.spaceBinaryModule
namespace CFSG.Quasithin.Chapter6.Source.RankOneRecognition
open RankOneGeneric
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L M V M₁ K : Subgroup G} {n : ℕ}

/-- The original two-perfect quintic residual centralizes the full reduced
Hermitian module modulo the whole two-core of the original `KT` join. -/
theorem original_hermitian_tits_quintic_residual_centralizes_mod_core
    (h : Hypothesis611 KnownSimple.IsKnownSimple T L M V n)
    (hout : Chapter3.HasMaximalOutside T M)
    (hm : IsConjugationModel L (reducedSubgroup (L ⊔ (T : Subgroup G)))
      (Representation.SL2.BinarySmall.hermitian 2))
    (hM₁ : IsMaximalTwoLocal M₁) (hCM₁ : omegaCentralizer T ≤ M₁)
    (hK : K ∈ Chapter1.cComponentsIn M₁) (hnot : ¬ K ≤ M)
    (hqK : IsQuasisimple (K ⧸ pCore 2 K))
    (e : coreCentralQuotient K ≃* Tits.ParrottGroup) :
    ⁅quinticResidual T L, reducedSubgroup (L ⊔ (T : Subgroup G))⁆ ≤
      (K ⊔ (T : Subgroup G)).pCoreIn 2 := by
  let X := quinticResidual T L
  let B := reducedSubgroup (L ⊔ (T : Subgroup G))
  let J := K ⊔ (T : Subgroup G)
  let H := X ⊔ (T : Subgroup G)
  let R := J.pCoreIn 2
  obtain ⟨D,hD,hDB,hDX,hXD,hjoin,hcentral⟩ := original_hermitian_quintic_torus h hout hm
  have hXK : X ≤ K := original_hermitian_quintic_le_tits_component
    h hout hm hM₁ hCM₁ hK hnot hqK e
  have hXT : X ≤ L := (map_subtype_le _).trans inf_le_left
  have hXH : X ≤ H := le_sup_left
  have hTH : (T : Subgroup G) ≤ H := le_sup_right
  have hXJ : X ≤ J := hXK.trans le_sup_left
  have hHJ : H ≤ J := sup_le hXJ le_sup_right
  have hBT : B ≤ (T : Subgroup G) :=
    (h.reduced_enlargement.rankOneInput hout).reduced_le_sylow
  have hBH : B ≤ H := hBT.trans hTH
  have hRJ : R ≤ (T : Subgroup G) := by
    have hh := pCoreIn_le_sylow J (T.subtype le_sup_right)
    change R ≤ ((T : Subgroup G).subgroupOf J).map J.subtype at hh
    rw [map_subgroupOf_eq_of_le le_sup_right] at hh
    exact hh
  have hRH : R ≤ H := hRJ.trans hTH
  have hHBnorm : H ≤ normalizer (R : Set G) := by
    exact hHJ.trans (J.le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image J (pCore 2 J)))
  let BH := B.subgroupOf H
  let NH := R.subgroupOf H
  let XH := X.subgroupOf H
  let TH := (T : Subgroup G).subgroupOf H
  let DH := D.subgroupOf H
  let : BH.Normal := by
    let := (h.reduced_enlargement.rankOneInput hout).reduced_internal.normal
    have hLT : H ≤ L ⊔ (T : Subgroup G) :=
      sup_le (hXT.trans le_sup_left) le_sup_right
    have hBLT : B ≤ L ⊔ (T : Subgroup G) := hBT.trans le_sup_right
    have hBnorm : (L ⊔ (T : Subgroup G)) ≤ normalizer (B : Set G) := by
      exact (normal_subgroupOf_iff_le_normalizer hBLT).mp
        (show (B.subgroupOf (L ⊔ (T : Subgroup G))).Normal from inferInstance)
    exact normal_subgroupOf_of_le_normalizer (hLT.trans hBnorm)
  let : NH.Normal := normal_subgroupOf_of_le_normalizer hHBnorm
  have hD5 : Nat.card D = 5 := hD
  have hDH : D ≤ H := hDX.trans hXH
  have hgen : DH ⊔ TH = ⊤ := by
    change D.subgroupOf H ⊔ (T : Subgroup G).subgroupOf H = ⊤
    rw [←subgroupOf_sup hDH hTH, hjoin.symm, subgroupOf_self]
  have hXp : IsPPerfect 2 XH :=
    (quinticResidual_twoPerfect T L).of_surjective
      (subgroupOfEquivOfLe hXH).symm.toMonoidHom
      (subgroupOfEquivOfLe hXH).symm.surjective
  have hTp : IsPGroup 2 TH := T.isPGroup'.comap_subtype
  have hDBH : ⁅DH,BH⁆ ≤ NH := by
    apply (Subgroup.map_le_map_iff_of_injective H.subtype_injective).mp
    rw [map_commutator, map_subgroupOf_eq_of_le hDH,
      map_subgroupOf_eq_of_le hBH, map_subgroupOf_eq_of_le hRH]
    exact original_hermitian_tits_quintic_torus_centralizes_mod_core
      h hout hm hM₁ hCM₁ hK hnot hqK e hD hDB hDX
  have hfull := Theory.GroupTheory.pPerfect_commutator_le_of_supplement_centralizes
    XH BH DH TH NH hXp hTp hgen hDBH
  have hmfull := map_mono (f := H.subtype) hfull
  rw [map_commutator, map_subgroupOf_eq_of_le hXH,
    map_subgroupOf_eq_of_le hBH, map_subgroupOf_eq_of_le hRH] at hmfull
  exact hmfull

end CFSG.Quasithin.Chapter6.Source.RankOneRecognition
