module
public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleGenericGlobalTrialitySmallCompletion
public import CFSG.Quasithin.ChapterF.Section04.SourceCompletion.TrialityNonbinary.FixedApartment

/-!
# Native order in the original triality normalizer completion

The actual full-normalizer diagram and full extension order bound produce
a normal subgroup generated by both marked native parabolics. The native
six-path count gives its exact triality order and diameter six, including
q=4. The source reversal and m=n>1 conclusions are retained. The marked sixth-power defect lies in its native Borel. Identification
of this subgroup and the final GlobalExit still require marked recognition.

Source: Aschbacher--Smith 5.3.1--4, F.4.24, pp.658--659,287--288.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter6.Source.RankOneGeneric.Global
open ChapterF.GreenBook.LieModels
open ChapterF.SourceCompletion.TrialityNonbinary ChapterF.SourceCompletion
open Subgroup.CosetGeometry.RankTwo
variable {G : Type*} [Group G] [Finite G]

/-- The literal native join in the source completion has exactly the native
order, without assuming a native group isomorphism or a Weyl relation. -/
theorem Preparation.triality_full_normalizers_native_apartment
    {T : Sylow 2 G} {L W H A B : Subgroup G} {n : ℕ}
    (d : Preparation T L H A B (residual H))
    (h : Input KnownSimple.IsKnownSimple T L W n)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hp : Group.IsPerfect (residual H)) (m : ℕ) (hm : 0 < m)
    (he : Nonempty (RankTwoAmalgam.Iso
        (sourceParabolicAmalgam ![L,residual H] (sourceS L H)) (Triality.amalgam (_root_.Triality.Standard.binaryParameters m hm))) ∨
      Nonempty (RankTwoAmalgam.Iso
        (sourceParabolicAmalgam ![L,residual H] (sourceS L H)) (Triality.amalgam (_root_.Triality.Standard.binaryParameters m hm)).reverse))
    (E : SourceExtension m hm)
    (hext : Nonempty (RankTwoAmalgam.Iso
        (UnitaryNonbinary.Generated.amalgam (normalizer (L : Set G)) (normalizer (residual H : Set G))) E.amalgam) ∨
      Nonempty (RankTwoAmalgam.Iso
        (UnitaryNonbinary.Generated.amalgam (normalizer (L : Set G)) (normalizer (residual H : Set G))) E.amalgam.reverse))
    (horder : Nat.card G ≤ Nat.card E.carrier) :
    m = n ∧ 1 < m ∧
      normalizer (L : Set G) ⊔ normalizer (residual H : Set G) = ⊤ ∧
      Nat.card G = Nat.card E.carrier ∧
      ∃ c : Completion E (normalizer (L : Set G) ⊔ normalizer (residual H : Set G) : Subgroup G),
        c.left.range ⊓ c.right.range = c.middle.range ∧
        (nativeCore E c).Normal ∧
        Nat.card (nativeCore E c) = Nat.card (_root_.Triality.Standard.BinaryCarrier m hm) ∧
        (nativeCompletion E c).left.range ⊓ (nativeCompletion E c).right.range =
          (nativeCompletion E c).middle.range ∧
        (∀ v w, (graph (nativeCompletion E c).cosetFamily).dist v w ≤ 6) ∧
        ∃ b : _root_.Triality.Standard.Parabolics.borel (_root_.Triality.Standard.binaryParameters m hm),
          c.left (E.nativeLeft ⟨b.val,_root_.Triality.Standard.Parabolics.borel_le_parabolic _ .arms b.property⟩) =
            (c.left (E.nativeLeft (reflection m hm .arms)) *
              c.right (E.nativeRight (reflection m hm .central)))^6 := by
  obtain ⟨hmn,hm2,hgen,hcard,c,hc,_⟩ :=
    d.triality_full_normalizers_small_completion h hH hp m hm he E hext horder
  have hx : Nat.card (normalizer (L : Set G) ⊔ normalizer (residual H : Set G) : Subgroup G) ≤
      Nat.card G := Nat.card_le_card_of_injective _ Subtype.val_injective
  exact ⟨hmn,hm2,hgen,hcard,c,hc,nativeCore_normal E c,
    nativeCore_order_eq E c hm2 hc (hx.trans horder),nativeCompletion_overlap E c hc,
    nativeCore_diameter_le E c hm2 hc (hx.trans horder),
    marked_six_mem_native_borel E c hm2 hc (hx.trans horder)⟩

end CFSG.Quasithin.Chapter6.Source.RankOneGeneric.Global
