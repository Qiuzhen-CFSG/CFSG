module
public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleGenericGlobalSylow
public import Theory.GroupTheory.PResidual.FiniteLocalPair
public import Theory.GroupTheory.PStar.Basic

/-!
# The literal unitary reduction before 5.2.7

Let R₀ = T ∩ L be the common reduced Sylow of the prepared pair. Replacing
S = O₂(N_G(L) ∩ H) by R₀ preserves both local Borels. The resulting
parabolics are exactly O² of the original parabolics: each is generated by
a perfect local factor and its opposite odd Cartan, and is normal with a
two-group quotient. The residual here is O², not the two-core O₂.

In the degree-two unitary model, the ordinary parabolic is precisely the
kernel of outer parity, and equals O² of the extended parabolic. Restricting
the original compatible maps therefore identifies the literal reduced source
amalgam with the ordinary unitary amalgam. Both orientations, both endpoint
indices and the whole overlap are retained; no ambient completion is asserted.
The Chapter12 extension applies the construction to the actual whole-residual
pair. Exhaustive F.1.12 comparison and the subsequent 5.2.8/5.3 recognition
remain independent obligations.

Source: Aschbacher–Smith 5.2.6–7, printed pp.650–651, especially the unitary
replacement immediately before 5.2.7 (`refs/quasithin.pdf`). The argument
avoids the incorrect extended-overlap core identity recorded in
`UnitaryFourExtension.lean`.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter6.Source.RankOneGeneric.Global
variable {G : Type*} [Group G] [Finite G]

@[expose] def reducedParabolic (F : Fin 2 → Subgroup G) (S : Subgroup G) (i : Fin 2) :=
  F i ⊔ ChapterF.Source.borel (F (ChapterF.Source.other i)) S

omit [Finite G] in
private theorem reducedParabolic_le (F : Fin 2 → Subgroup G) (S : Subgroup G) (i : Fin 2) :
    reducedParabolic F S i ≤ ChapterF.Source.parabolic F S i :=
  sup_le (le_sup_left.trans le_sup_left) le_sup_right

omit [Finite G] in
private theorem reducedParabolic_sup (F : Fin 2 → Subgroup G) (S : Subgroup G) (i : Fin 2) :
    reducedParabolic F S i ⊔ S = ChapterF.Source.parabolic F S i := by
  exact sup_right_comm _ _ _

omit [Finite G] in
private theorem reducedParabolic_normalizes {F : Fin 2 → Subgroup G} {S : Subgroup G}
    (h : ChapterF.Source.HypothesisF11 F S) (i : Fin 2) :
    ChapterF.Source.parabolic F S i ≤ normalizer (reducedParabolic F S i : Set G) := by
  rw [← reducedParabolic_sup]
  refine sup_le (reducedParabolic F S i).le_normalizer ?_
  exact (le_inf (h.S_normalizes i) (h.S_normalizes_borel (ChapterF.Source.other i))).trans
    (normalizer_inf_normalizer_le_normalizer_sup _ _)

private theorem perfect_twoPerfect {X : Type*} [Group X] [Finite X]
    [Group.IsPerfect X] : IsPPerfect 2 X := by
  intro N hN hq
  let : N.Normal := hN
  by_contra hne
  let : Nontrivial (X ⧸ N) := QuotientGroup.nontrivial_iff.mpr hne
  let : Group.IsPerfect (X ⧸ N) := Group.IsPerfect.ofSurjective (QuotientGroup.mk'_surjective N)
  let : Group.IsNilpotent (X ⧸ N) := hq.isNilpotent
  exact Group.IsPerfect.not_isSolvable (X ⧸ N) inferInstance

private theorem odd_twoPerfect (C : Subgroup G) (ho : Odd (Nat.card C)) : IsPPerfect 2 C :=
  (pResidual_eq_top_iff 2 C).mp (isPStar_of_coprime_card ho.coprime_two_left).1

/-- Removing the original S from both parabolics gives their actual two-residuals. -/
theorem Preparation.reducedParabolic_eq_twoResidual
    {κ : GroupClass} {T : Sylow 2 G} {L W H A B R : Subgroup G} {n : ℕ}
    (d : Preparation T L H A B R) (h : Input κ T L W n)
    (hTH : (T : Subgroup G) ≤ H) (hp : Group.IsPerfect R)
    (hs : sourceS L H ⊓ L = sourceS L H ⊓ R) (i : Fin 2) :
    (pResidual 2 (ChapterF.Source.parabolic ![L,R] (sourceS L H) i)).map
      (ChapterF.Source.parabolic ![L,R] (sourceS L H) i).subtype =
        reducedParabolic ![L,R] (sourceS L H) i := by
  have hoddA : Odd (Nat.card A) := by
    rw [← Nat.card_congr (subgroupOfEquivOfLe d.cartans.left_le).toEquiv]
    exact OddHall.odd_hall_odd d.cartans.left_hall
  have hoddB : Odd (Nat.card B) := by
    rw [← Nat.card_congr (subgroupOfEquivOfLe d.cartans.right_le).toEquiv]
    exact OddHall.odd_hall_odd d.cartans.right_hall
  have hpD : IsPPerfect 2 (reducedParabolic ![L,R] (sourceS L H) i) := by
    fin_cases i
    · change IsPPerfect 2 (L ⊔ ChapterF.Source.borel R (sourceS L H) : Subgroup G)
      rw [d.right_borel,← hs,← sup_assoc,
        sup_of_le_left (show sourceS L H ⊓ L ≤ L from inf_le_right)]
      let := Chapter1.mem_L_isPerfect h.local_mem.1.1
      exact isPPerfect_sup _ _ perfect_twoPerfect
        (odd_twoPerfect _ (hoddB.of_dvd_nat (card_dvd_of_le inf_le_left)))
    · change IsPPerfect 2 (R ⊔ ChapterF.Source.borel L (sourceS L H) : Subgroup G)
      rw [d.left_borel_product h.sylow_normalizes,hs,← sup_assoc,
        sup_of_le_left (show sourceS L H ⊓ R ≤ R from inf_le_right)]
      let := hp
      exact isPPerfect_sup _ _ perfect_twoPerfect (odd_twoPerfect _ hoddA)
  let P := ChapterF.Source.parabolic ![L,R] (sourceS L H) i
  let D := reducedParabolic ![L,R] (sourceS L H) i
  have hDP : D ≤ P := reducedParabolic_le _ _ _
  have hSP : sourceS L H ≤ P := le_sup_right.trans le_sup_left
  let : (D.subgroupOf P).Normal := normal_subgroupOf_of_le_normalizer
    (reducedParabolic_normalizes (d.hypothesisF11 h hTH) i)
  have hd := hpD.of_surjective (subgroupOfEquivOfLe hDP).symm.toMonoidHom
    (subgroupOfEquivOfLe hDP).symm.surjective
  have hh : pResidual 2 P = D.subgroupOf P :=
    pResidual_eq_of_isPPerfect_sup _ ((sourceS L H).subgroupOf P) hd
      ((pCore_isPGroup.map _ : IsPGroup 2 (sourceS L H)).comap_subtype) (by
        rw [← subgroupOf_sup hDP hSP,reducedParabolic_sup,subgroupOf_self])
  rw [hh,map_subgroupOf_eq_of_le hDP]

/-- The literal reduced Sylow gives the same Borels and the reduced parabolics. -/
theorem Preparation.reduced_source_parabolics
    {κ : GroupClass} {T : Sylow 2 G} {L W H A B R : Subgroup G} {n : ℕ}
    (d : Preparation T L H A B R) (h : Input κ T L W n)
    (hTH : (T : Subgroup G) ≤ H) (hp : Group.IsPerfect R)
    (hc : ConcreteAmalgamComparison (sourceParabolicAmalgam ![L,R] (sourceS L H))) :
    ∀ i : Fin 2, ChapterF.Source.parabolic ![L,R] ((T : Subgroup G) ⊓ L) i =
      (pResidual 2 (ChapterF.Source.parabolic ![L,R] (sourceS L H) i)).map
        (ChapterF.Source.parabolic ![L,R] (sourceS L H) i).subtype := by
  have he := d.common_sylow_of_comparison h hTH hp hc
  have hS := sourceS_le_sylow h.sylow_normalizes hTH
  have hsi : ∀ i : Fin 2, sourceS L H ⊓ ![L,R] i = (T : Subgroup G) ⊓ L := by
    intro i
    fin_cases i
    · exact d.left_intersection
    · apply le_antisymm
      · exact (inf_le_inf_right _ hS).trans_eq he.symm
      · exact le_inf (d.left_intersection.symm ▸ inf_le_left) (he ▸ inf_le_right)
  have hri : ∀ i : Fin 2, (T : Subgroup G) ⊓ L ≤ ![L,R] i := by
    intro i
    rw [← hsi i]
    exact inf_le_right
  intro i
  rw [d.reducedParabolic_eq_twoResidual h hTH hp ((hsi 0).trans (hsi 1).symm) i]
  change ![L,R] i ⊔ ((T : Subgroup G) ⊓ L) ⊔
    ChapterF.Source.borel (![L,R] (ChapterF.Source.other i)) ((T : Subgroup G) ⊓ L) = _
  rw [sup_eq_left.mpr (hri i)]
  unfold reducedParabolic ChapterF.Source.borel
  rw [inf_eq_left.mpr (hri _),hsi]


namespace UnitaryReduction
open ChapterF.GreenBook.LieModels.UnitaryFour
open Theory.SpecificGroups.ClassicalUnitary

private instance unitaryProjectiveFinite (m : ℕ) (hm : 1 ≤ m) :
    Finite (ProjectiveGroup m hm) :=
  Finite.of_equiv (MatrixGroup m hm) (Extension.projectEquiv m hm).toEquiv

private instance unitaryExtensionFinite (m : ℕ) (hm : 1 ≤ m) :
    Finite (Extension.ProjectiveExtension m hm) :=
  Finite.of_injective (fun x : Extension.ProjectiveExtension m hm => (x.left,x.right))
    (fun _ _ h => SemidirectProduct.ext (congrArg Prod.fst h) (congrArg Prod.snd h))

private abbrev ordinary (m : ℕ) (hm : 1 ≤ m) (j : Bool) :=
  if j then pointParabolic m hm else planeParabolic m hm
private abbrev extended (m : ℕ) (hm : 1 ≤ m) (j : Bool) :=
  if j then Extension.point m hm else Extension.plane m hm

private theorem twoResidual_eq_top_of_perfect_sylow
    {X : Type*} [Group X] [Finite X] (P K : Subgroup X) [Group.IsPerfect K]
    (hKP : K ≤ P)
    (hU : ∀ U : Subgroup P, IsPGroup 2 U → U.map P.subtype ≤ K) :
    pResidual 2 P = ⊤ := by
  let U : Sylow 2 P := Classical.choice inferInstance
  have hp : IsPPerfect 2 (K.subgroupOf P) := perfect_twoPerfect.of_surjective
    (subgroupOfEquivOfLe hKP).symm.toMonoidHom (subgroupOfEquivOfLe hKP).symm.surjective
  have hu : (U : Subgroup P) ≤ pResidual 2 P :=
    ((map_le_iff_le_comap).mp (hU U U.isPGroup')).trans (le_pResidual_of_isPPerfect _ hp)
  simpa only [sup_of_le_left hu] using pResidual_sup_sylow_eq_top U

private theorem ordinary_twoResidual (m : ℕ) (hm : 1 < m) (j : Bool) :
    pResidual 2 (ordinary m hm.le j) = ⊤ := by
  cases j
  · let := L2_isPerfect m hm.le
    exact twoResidual_eq_top_of_perfect_sylow _ (L2 m hm.le) (L2_le_planeParabolic m hm.le)
      (fun U hU => two_subgroup_le_L2 m hm.le _ (hU.map _) (map_subtype_le _))
  · let := PointLocal.projectiveLocal_isPerfect m hm.le hm
    exact twoResidual_eq_top_of_perfect_sylow _ (PointLocal.ProjectiveLocal m hm.le)
      (by rw [← PointLocal.pointParabolic_solvableResidual m hm.le hm]; exact map_subtype_le _)
      (fun U hU => PointLocal.twoSubgroup_le_projectiveLocal m hm.le _ (hU.map _) (map_subtype_le _))

private def embedding (m : ℕ) (hm : 1 ≤ m) (j : Bool) :
    ordinary m hm j →* extended m hm j where
  toFun x := ⟨SemidirectProduct.inl x.val, by
    cases j
    · exact (Extension.mem_plane m hm _).mpr x.property
    · exact (Extension.mem_point m hm _).mpr x.property⟩
  map_one' := Subtype.ext (map_one _)
  map_mul' x y := Subtype.ext (map_mul _ x.val y.val)

private theorem embedding_injective (m : ℕ) (hm : 1 ≤ m) (j : Bool) :
    Function.Injective (embedding m hm j) := by
  intro x y he
  exact Subtype.ext (congrArg (fun z => z.val.left) he)

private def parity (m : ℕ) (hm : 1 ≤ m) (j : Bool) :
    extended m hm j →* UnitaryFourOuter.C2 :=
  SemidirectProduct.rightHom.comp (extended m hm j).subtype

private theorem embedding_range (m : ℕ) (hm : 1 ≤ m) (j : Bool) :
    (embedding m hm j).range = (parity m hm j).ker := by
  ext x
  constructor
  · rintro ⟨y,rfl⟩
    rfl
  · intro hx
    refine ⟨⟨x.val.left,?_⟩,?_⟩
    · cases j
      · exact (Extension.mem_plane m hm _).mp x.property
      · exact (Extension.mem_point m hm _).mp x.property
    · exact Subtype.ext (SemidirectProduct.ext rfl hx.symm)

/-- The ordinary unitary endpoint is the two-residual of the extended endpoint. -/
private theorem extended_twoResidual (m : ℕ) (hm : 1 < m) (j : Bool) :
    pResidual 2 (extended m hm.le j) = (parity m hm.le j).ker := by
  apply le_antisymm
  · apply pResidual_le_ker_of_isPGroup 2 (parity m hm.le j)
    exact IsPGroup.of_card (n := 1) (by simp [UnitaryFourOuter.C2])
  · rw [← embedding_range]
    have he := map_pResidual_le 2 (embedding m hm.le j)
    rwa [ordinary_twoResidual m hm j,← MonoidHom.range_eq_map] at he

end UnitaryReduction

namespace UnitaryReduction
open ChapterF.GreenBook.LieModels.UnitaryFour
open Theory.SpecificGroups.ClassicalUnitary

private def overlapEmbedding (m : ℕ) (hm : 1 ≤ m) :
    overlap m hm →* Extension.overlap m hm where
  toFun x := ⟨SemidirectProduct.inl x.val, by
    rw [← Extension.exact_overlap]
    have hx : x.val ∈ pointParabolic m hm ⊓ planeParabolic m hm :=
      (exact_overlap m hm).symm ▸ x.property
    exact ⟨(Extension.mem_point m hm _).mpr hx.1,(Extension.mem_plane m hm _).mpr hx.2⟩⟩
  map_one' := Subtype.ext (map_one _)
  map_mul' x y := Subtype.ext (map_mul _ x.val y.val)

private theorem overlapEmbedding_injective (m : ℕ) (hm : 1 ≤ m) :
    Function.Injective (overlapEmbedding m hm) := by
  intro x y he
  exact Subtype.ext (congrArg (fun z => z.val.left) he)

private theorem overlapEmbedding_mem_range (m : ℕ) (hm : 1 ≤ m)
    (x : Extension.overlap m hm) :
    x ∈ (overlapEmbedding m hm).range ↔ x.val.right = 1 := by
  constructor
  · rintro ⟨y,rfl⟩
    rfl
  · intro hx
    have hmem : x.val ∈ Extension.point m hm ⊓ Extension.plane m hm :=
      (Extension.exact_overlap m hm).symm ▸ x.property
    refine ⟨⟨x.val.left,?_⟩,Subtype.ext (SemidirectProduct.ext rfl hx.symm)⟩
    rw [← exact_overlap]
    exact ⟨(Extension.mem_point m hm _).mp hmem.1,(Extension.mem_plane m hm _).mp hmem.2⟩

omit [Finite G] in
private theorem restrict_range {X Y : Type*} [Group X] [Group Y]
    {P D : Subgroup G} (e : P ≃* X) (j : Y →* X)
    (hh : ∀ x : P, x.val ∈ D ↔ e x ∈ j.range) :
    (D.subgroupOf P).map e.toMonoidHom = j.range := by
  ext y
  obtain ⟨x,rfl⟩ := e.surjective y
  exact (mem_map_iff_mem (f := e.toMonoidHom) (K := D.subgroupOf P)
    (x := x) e.injective).trans (hh x)

private def restrictEquiv {X Y : Type*} [Group X] [Group Y]
    {P D : Subgroup G} (hDP : D ≤ P) (e : P ≃* X) (j : Y →* X)
    (hj : Function.Injective j) (hh : ∀ x : P, x.val ∈ D ↔ e x ∈ j.range) : D ≃* Y :=
  (subgroupOfEquivOfLe hDP).symm.trans
    ((e.subgroupMap (D.subgroupOf P)).trans
      ((MulEquiv.subgroupCongr (restrict_range e j hh)).trans (MonoidHom.ofInjective hj).symm))

omit [Finite G] in
private theorem restrictEquiv_apply {X Y : Type*} [Group X] [Group Y]
    {P D : Subgroup G} (hDP : D ≤ P) (e : P ≃* X) (j : Y →* X)
    (hj : Function.Injective j) (hh : ∀ x : P, x.val ∈ D ↔ e x ∈ j.range) (x : D) :
    j (restrictEquiv hDP e j hj hh x) = e ⟨x,hDP x.property⟩ := by
  exact congrArg Subtype.val ((MonoidHom.ofInjective hj).apply_symm_apply _)

omit [Finite G] in
private theorem source_residual_iff_parity (m : ℕ) (hm : 1 < m) (j : Bool)
    (P : Subgroup G) (e : P ≃* extended m hm.le j) (x : P) :
    x.val ∈ (pResidual 2 P).map P.subtype ↔ (e x).val.right = 1 := by
  have hx := mem_map_iff_mem (f := P.subtype) (K := pResidual 2 P)
    (x := x) P.subtype_injective
  have hh := mem_map_iff_mem (f := e.toMonoidHom) (K := pResidual 2 P) (x := x) e.injective
  rw [map_pResidual 2 e,extended_twoResidual m hm j] at hh
  exact hx.trans hh.symm

omit [Finite G] in
/-- Restricting both parabolic two-residuals and their whole intersection
recovers the ordinary unitary amalgam, with both commuting squares. -/
private theorem restrict_extension_iso
    (m : ℕ) (hm : 1 < m) (P₀ P₁ : Subgroup G)
    (e : RankTwoAmalgam.Iso
      (RankTwoAmalgam.ofSubgroups P₀ (P₀ ⊓ P₁) P₁ inf_le_left inf_le_right)
      (Extension.amalgam m hm.le)) :
    Nonempty (RankTwoAmalgam.Iso
      (RankTwoAmalgam.ofSubgroups
        ((pResidual 2 P₀).map P₀.subtype)
        ((pResidual 2 P₀).map P₀.subtype ⊓ (pResidual 2 P₁).map P₁.subtype)
        ((pResidual 2 P₁).map P₁.subtype) inf_le_left inf_le_right)
      (amalgam m hm.le)) := by
  let D₀ := (pResidual 2 P₀).map P₀.subtype
  let D₁ := (pResidual 2 P₁).map P₁.subtype
  have hl : ∀ x : P₀, x.val ∈ D₀ ↔ e.left x ∈ (embedding m hm.le true).range := by
    intro x
    rw [embedding_range]
    exact source_residual_iff_parity m hm true P₀ e.left x
  have hr : ∀ x : P₁, x.val ∈ D₁ ↔ e.right x ∈ (embedding m hm.le false).range := by
    intro x
    rw [embedding_range]
    exact source_residual_iff_parity m hm false P₁ e.right x
  have hmid : ∀ x : (P₀ ⊓ P₁ : Subgroup G),
      x.val ∈ D₀ ⊓ D₁ ↔ e.middle x ∈ (overlapEmbedding m hm.le).range := by
    intro x
    rw [mem_inf,source_residual_iff_parity m hm true P₀ e.left ⟨x, x.property.1⟩,
      source_residual_iff_parity m hm false P₁ e.right ⟨x,x.property.2⟩,
      overlapEmbedding_mem_range]
    have h₀ := congrArg (fun z : Extension.point m hm.le => z.val.right) (e.left_commutes x)
    have h₁ := congrArg (fun z : Extension.plane m hm.le => z.val.right) (e.right_commutes x)
    change (e.left ⟨x,x.property.1⟩).val.right = (e.middle x).val.right at h₀
    change (e.right ⟨x,x.property.2⟩).val.right = (e.middle x).val.right at h₁
    rw [h₀,h₁,and_self]
  have hD : D₀ ⊓ D₁ ≤ P₀ ⊓ P₁ := inf_le_inf (map_subtype_le _) (map_subtype_le _)
  let l := restrictEquiv (map_subtype_le _) e.left (embedding m hm.le true)
    (embedding_injective m hm.le true) hl
  let r := restrictEquiv (map_subtype_le _) e.right (embedding m hm.le false)
    (embedding_injective m hm.le false) hr
  let b := restrictEquiv hD e.middle (overlapEmbedding m hm.le)
    (overlapEmbedding_injective m hm.le) hmid
  refine ⟨{
    left := l
    right := r
    middle := b
    left_commutes := ?_
    right_commutes := ?_ }⟩
  · intro x
    apply embedding_injective m hm.le true
    change embedding m hm.le true (l ⟨x,x.property.1⟩) =
      embedding m hm.le true ((amalgam m hm.le).left (b x))
    rw [restrictEquiv_apply]
    have hb := restrictEquiv_apply hD e.middle (overlapEmbedding m hm.le)
      (overlapEmbedding_injective m hm.le) hmid x
    have hc := e.left_commutes ⟨x,hD x.property⟩
    apply Subtype.ext
    exact (congrArg Subtype.val hc).trans (congrArg (fun z => z.val) hb).symm
  · intro x
    apply embedding_injective m hm.le false
    change embedding m hm.le false (r ⟨x,x.property.2⟩) =
      embedding m hm.le false ((amalgam m hm.le).right (b x))
    rw [restrictEquiv_apply]
    have hb := restrictEquiv_apply hD e.middle (overlapEmbedding m hm.le)
      (overlapEmbedding_injective m hm.le) hmid x
    have hc := e.right_commutes ⟨x,hD x.property⟩
    apply Subtype.ext
    exact (congrArg Subtype.val hc).trans (congrArg (fun z => z.val) hb).symm

end UnitaryReduction

namespace UnitaryReduction
open ChapterF.GreenBook.LieModels.UnitaryFour
open Theory.SpecificGroups.ClassicalUnitary

private theorem parity_surjective (m : ℕ) (hm : 1 ≤ m) (j : Bool) :
    Function.Surjective (parity m hm j) := by
  intro c
  refine ⟨⟨SemidirectProduct.inr c,?_⟩,rfl⟩
  cases j
  · exact (Extension.mem_plane m hm _).mpr (planeParabolic m hm).one_mem
  · exact (Extension.mem_point m hm _).mpr (pointParabolic m hm).one_mem

/-- Each ordinary endpoint has index exactly two in the extension. -/
private theorem extended_twoResidual_index (m : ℕ) (hm : 1 < m) (j : Bool) :
    (pResidual 2 (extended m hm.le j)).index = 2 := by
  rw [extended_twoResidual m hm j,index_ker,
    MonoidHom.range_eq_top.mpr (parity_surjective m hm.le j),card_top]
  simp [UnitaryFourOuter.C2]

end UnitaryReduction

/-- The literal reduced source endpoints have index two, in both orientations. -/
theorem Preparation.unitaryExtension_reduced_index
    {κ : GroupClass} {T : Sylow 2 G} {L W H A B R : Subgroup G} {n : ℕ}
    (d : Preparation T L H A B R) (h : Input κ T L W n)
    (hTH : (T : Subgroup G) ≤ H) (hp : Group.IsPerfect R)
    (m : ℕ) (hm : 1 < m)
    (he : Nonempty (RankTwoAmalgam.Iso (sourceParabolicAmalgam ![L,R] (sourceS L H))
        (ChapterF.GreenBook.LieModels.UnitaryFour.Extension.amalgam m hm.le)) ∨
      Nonempty (RankTwoAmalgam.Iso (sourceParabolicAmalgam ![L,R] (sourceS L H))
        (ChapterF.GreenBook.LieModels.UnitaryFour.Extension.amalgam m hm.le).reverse)) :
    ∀ i : Fin 2, (ChapterF.Source.parabolic ![L,R] ((T : Subgroup G) ⊓ L) i).relIndex
      (ChapterF.Source.parabolic ![L,R] (sourceS L H) i) = 2 := by
  intro i
  rw [d.reduced_source_parabolics h hTH hp (.unitaryExtension m hm.le he) i]
  change (((pResidual 2 (ChapterF.Source.parabolic ![L,R] (sourceS L H) i)).map
    (ChapterF.Source.parabolic ![L,R] (sourceS L H) i).subtype).comap
    (ChapterF.Source.parabolic ![L,R] (sourceS L H) i).subtype).index = 2
  rw [comap_map_eq_self_of_injective (ChapterF.Source.parabolic ![L,R] (sourceS L H) i).subtype_injective]
  have transfer (j : Bool)
      (e : ChapterF.Source.parabolic ![L,R] (sourceS L H) i ≃*
        UnitaryReduction.extended m hm.le j) :
      (pResidual 2 (ChapterF.Source.parabolic ![L,R] (sourceS L H) i)).index = 2 := by
    exact ((pResidual 2 _).index_map_equiv e).symm.trans
      ((congrArg Subgroup.index (map_pResidual 2 e)).trans
        (UnitaryReduction.extended_twoResidual_index m hm j))
  rcases he with he | he <;> obtain ⟨e⟩ := he <;> fin_cases i
  · exact transfer true e.left
  · exact transfer false e.right
  · exact transfer false e.left
  · exact transfer true e.right

namespace UnitaryReduction
open ChapterF.GreenBook.LieModels.UnitaryFour

private def swapSubgroupIso (P Q : Subgroup G) :
    RankTwoAmalgam.Iso
      (RankTwoAmalgam.ofSubgroups P (P ⊓ Q) Q inf_le_left inf_le_right).reverse
      (RankTwoAmalgam.ofSubgroups Q (Q ⊓ P) P inf_le_left inf_le_right) where
  left := MulEquiv.refl _
  right := MulEquiv.refl _
  middle := MulEquiv.subgroupCongr (inf_comm P Q)
  left_commutes _ := rfl
  right_commutes _ := rfl

omit [Finite G] in
/-- The same reduction with the endpoints interchanged retains the overlap map. -/
private theorem restrict_extension_iso_reverse
    (m : ℕ) (hm : 1 < m) (P₀ P₁ : Subgroup G)
    (e : RankTwoAmalgam.Iso
      (RankTwoAmalgam.ofSubgroups P₀ (P₀ ⊓ P₁) P₁ inf_le_left inf_le_right)
      (Extension.amalgam m hm.le).reverse) :
    Nonempty (RankTwoAmalgam.Iso
      (RankTwoAmalgam.ofSubgroups
        ((pResidual 2 P₀).map P₀.subtype)
        ((pResidual 2 P₀).map P₀.subtype ⊓ (pResidual 2 P₁).map P₁.subtype)
        ((pResidual 2 P₁).map P₁.subtype) inf_le_left inf_le_right)
      (amalgam m hm.le).reverse) := by
  obtain ⟨f⟩ := restrict_extension_iso m hm P₁ P₀
    ((swapSubgroupIso P₀ P₁).symm.trans e.reverse)
  exact ⟨((swapSubgroupIso _ _).trans f).reverse⟩

end UnitaryReduction

private def subgroupPairIsoOfEq {P₀ P₁ D₀ D₁ : Subgroup G} (h₀ : P₀ = D₀) (h₁ : P₁ = D₁) :
    RankTwoAmalgam.Iso
      (RankTwoAmalgam.ofSubgroups P₀ (P₀ ⊓ P₁) P₁ inf_le_left inf_le_right)
      (RankTwoAmalgam.ofSubgroups D₀ (D₀ ⊓ D₁) D₁ inf_le_left inf_le_right) := by
  subst D₀
  subst D₁
  exact RankTwoAmalgam.Iso.refl _

/-- The literal source reduction in the degree-two unitary row. Replacing S
by T ∩ L gives the ordinary unitary amalgam in the same orientation, retaining
both original inclusion maps on the full reduced overlap. -/
theorem Preparation.unitaryExtension_reduced_amalgam
    {κ : GroupClass} {T : Sylow 2 G} {L W H A B R : Subgroup G} {n : ℕ}
    (d : Preparation T L H A B R) (h : Input κ T L W n)
    (hTH : (T : Subgroup G) ≤ H) (hp : Group.IsPerfect R)
    (m : ℕ) (hm : 1 < m)
    (he : Nonempty (RankTwoAmalgam.Iso (sourceParabolicAmalgam ![L,R] (sourceS L H))
        (ChapterF.GreenBook.LieModels.UnitaryFour.Extension.amalgam m hm.le)) ∨
      Nonempty (RankTwoAmalgam.Iso (sourceParabolicAmalgam ![L,R] (sourceS L H))
        (ChapterF.GreenBook.LieModels.UnitaryFour.Extension.amalgam m hm.le).reverse)) :
    Nonempty (RankTwoAmalgam.Iso (sourceParabolicAmalgam ![L,R] ((T : Subgroup G) ⊓ L))
        (ChapterF.GreenBook.LieModels.UnitaryFour.amalgam m hm.le)) ∨
      Nonempty (RankTwoAmalgam.Iso (sourceParabolicAmalgam ![L,R] ((T : Subgroup G) ⊓ L))
        (ChapterF.GreenBook.LieModels.UnitaryFour.amalgam m hm.le).reverse) := by
  have hr := d.reduced_source_parabolics h hTH hp (.unitaryExtension m hm.le he)
  let c := subgroupPairIsoOfEq (hr 0) (hr 1)
  rcases he with he | he <;> obtain ⟨e⟩ := he
  · obtain ⟨f⟩ := UnitaryReduction.restrict_extension_iso m hm _ _ e
    exact Or.inl ⟨c.trans f⟩
  · obtain ⟨f⟩ := UnitaryReduction.restrict_extension_iso_reverse m hm _ _ e
    exact Or.inr ⟨c.trans f⟩

end CFSG.Quasithin.Chapter6.Source.RankOneGeneric.Global

