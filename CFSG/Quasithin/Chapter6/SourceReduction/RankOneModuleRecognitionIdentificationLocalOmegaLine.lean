/-!
# The central omega line and the symmetric-five local quotient

The original omega-centralizer escape excludes Ω₁(Z(T)) = Z_S. Since the
central omega subgroup contains a central involution and lies in the plane
Z_S of order four, it is exactly the subgroup generated by that involution.
If T lay in L O₂(LT), the plane would centralize T, contradicting this line.
The normal A₅ image of L in LT/O₂(LT) therefore has an outer actor. Its
centralizer is trivial, so Aut(A₅) identifies the literal quotient with S₅
and marks the image of L under the same quotient map.

Only the earlier omega-centralizer escape remains explicit in the Chapter 12
application. Source 6.1.5 is owned by qt-d-1222-rankone-recognition-natural;
its use and the final local-analysis assembly remain with
qt-d-1222-recognition-local-analysis. No LocalAnalysis witness or later
recognition theorem is used in these proofs.

Source: Aschbacher--Smith, 6.2.2, printed p.680.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped Pointwise
namespace CFSG.Quasithin.Chapter6.Source.RankOneRecognition
variable {G : Type*} [Group G] [Finite G]
  {κ : GroupClass} {T : Sylow 2 G} {L M R : Subgroup G} {n : ℕ}

/-- Source 6.2.2(2), using the original omega-centralizer escape. -/
theorem local_centralOmega_eq_zpowers_of_escape
    (h : Hypothesis611 κ T L M R n)
    (hnatural : Conclusion6127 (T : Subgroup G) L M R n)
    (hZR : centralOmega (T : Subgroup G) ≤ R)
    (hescape : ¬ centralizer (centralOmega (T : Subgroup G) : Set G) ≤ M)
    {z : G} (hz : z ∈ ZS (T : Subgroup G) L R) (ho : orderOf z = 2)
    (hT : (T : Subgroup G) ≤ centralizer ({z} : Set G)) :
    centralOmega (T : Subgroup G) = zpowers z := by
  have hZ := local_centralOmega_le_ZS_of_le_reduced h hnatural hZR
  have hne : centralOmega (T : Subgroup G) ≠ ZS (T : Subgroup G) L R := by
    intro he
    exact hescape (he.symm ▸ hnatural.2.2.2.1)
  have hzZ : z ∈ centralOmega (T : Subgroup G) := by
    apply (omegaOneAmbient_le_iff _ _).mp le_rfl z
    · refine ⟨h.ZS_le_T hz, ?_⟩
      intro t ht
      exact mem_centralizer_singleton_iff.mp (hT ht)
    · rw [← ho]
      exact pow_orderOf_eq_one z
  have hlow : 2 ≤ Nat.card (centralOmega (T : Subgroup G)) := by
    have hc := card_le_of_le (zpowers_le.mpr hzZ)
    rwa [Nat.card_zpowers, ho] at hc
  have hS := (h.natural_ZS_geometry hnatural).2.1
  have hdvd : Nat.card (centralOmega (T : Subgroup G)) ∣ 2 ^ 2 := by
    simpa only [hS, Nat.reducePow] using card_dvd_of_le hZ
  obtain ⟨k, hk, he⟩ := (Nat.dvd_prime_pow Nat.prime_two).mp hdvd
  have hcard : Nat.card (centralOmega (T : Subgroup G)) = 2 := by
    have hnot : Nat.card (centralOmega (T : Subgroup G)) ≠ 4 := by
      intro hc
      exact hne (eq_of_le_of_card_ge hZ (by omega))
    interval_cases k <;> norm_num only [Nat.reducePow] at he <;> omega
  exact (eq_of_le_of_card_ge (zpowers_le.mpr hzZ) (by rw [Nat.card_zpowers, ho, hcard])).symm
/-- The cyclic central omega line forces a genuine outer Sylow actor. -/
theorem local_sylow_not_le_core_join_of_omega_line
    (h611 : Hypothesis611 KnownSimple.IsKnownSimple T L M R n)
    (hnatural : Conclusion6127 (T : Subgroup G) L M R n)
    {z : G} (horder : orderOf z = 2)
    (hline : centralOmega (T : Subgroup G) = zpowers z) :
    ¬ (T : Subgroup G) ≤ L ⊔ (L ⊔ (T : Subgroup G)).pCoreIn 2 := by
  intro hT
  let Q := (L ⊔ (T : Subgroup G)).pCoreIn 2
  have hQT : Q ≤ (T : Subgroup G) := by
    change (L ⊔ (T : Subgroup G)).pCoreIn 2 ≤ (T : Subgroup G)
    rw [← sylow_layer_centralizer_eq_core h611 (hnatural.1.symm ▸ hnatural.2.1)]
    exact inf_le_left
  have hLQ : L ≤ normalizer (Q : Set G) :=
    (show L ≤ L ⊔ (T : Subgroup G) from le_sup_left).trans
      ((L ⊔ (T : Subgroup G)).le_normalizer.trans
        (normalizer_le_normalizer_characteristic_image _ (pCore 2 _)))
  have hZC : ZS (T : Subgroup G) L R ≤ centralizer (T : Set G) := by
    intro v hv t ht
    have hprod : t ∈ (L : Set G) * (Q : Set G) := by
      rw [← coe_mul_of_left_le_normalizer_right L Q hLQ]
      exact hT ht
    obtain ⟨l, hl, q, hq, rfl⟩ := hprod
    have hlT : l ∈ (T : Subgroup G) := by
      have hh := (T : Subgroup G).mul_mem ht ((T : Subgroup G).inv_mem (hQT hq))
      simpa only [mul_inv_cancel_right] using hh
    have hlv : l * v = v * l := hv.2 l ⟨hlT, hl⟩
    have hqv : q * v = v * q := (local_core_centralizes_layer h611 hq v hv.1).symm
    calc
      (l * q) * v = l * (q * v) := mul_assoc _ _ _
      _ = l * (v * q) := congrArg (l * ·) hqv
      _ = (l * v) * q := (mul_assoc _ _ _).symm
      _ = (v * l) * q := congrArg (· * q) hlv
      _ = v * (l * q) := mul_assoc _ _ _
  have hZ : ZS (T : Subgroup G) L R ≤ centralOmega (T : Subgroup G) := by
    let := h611.ZS_elementary
    intro v hv
    exact (omegaOneAmbient_le_iff _ _).mp le_rfl v
      ⟨h611.ZS_le_T hv, hZC hv⟩ (elemPow_eq_one_of_isElementaryAbelian v hv)
  have hc := card_le_of_le hZ
  rw [(h611.natural_ZS_geometry hnatural).2.1, hline, Nat.card_zpowers, horder] at hc
  omega

/-- The original LT quotient is symmetric five, with the same map marking L. -/
theorem local_marked_symmetricFive_of_omega_line
    (h611 : Hypothesis611 KnownSimple.IsKnownSimple T L M R n)
    (hnatural : Conclusion6127 (T : Subgroup G) L M R n)
    {z : G} (horder : orderOf z = 2)
    (hline : centralOmega (T : Subgroup G) = zpowers z) :
    let H := L ⊔ (T : Subgroup G)
    ∃ e : (H ⧸ pCore 2 H) ≃* Equiv.Perm (Fin 5),
      (L.subgroupOf H).map (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 H))) =
        alternatingGroup (Fin 5) := by
  let H := L ⊔ (T : Subgroup G)
  have hLH : L ≤ H := le_sup_left
  have hTH : (T : Subgroup G) ≤ H := le_sup_right
  let π := QuotientGroup.mk' (pCore 2 H)
  let B := L.subgroupOf H
  let K := B.map π
  let S := ((T : Subgroup G).subgroupOf H).map π
  let : B.Normal := (normal_subgroupOf_iff_le_normalizer hLH).mpr
    (sup_le L.le_normalizer h611.sylow_normalizes_L)
  let : K.Normal := Normal.map inferInstance π (QuotientGroup.mk'_surjective _)
  have hB : B.IsCComponent := by
    change (L.subgroupOf H).IsCComponent
    exact h611.local_mem.1.prop.1
  obtain ⟨e₀⟩ := h611.quotient_a5_of_n_eq_two hnatural.1
  let c := subgroupOfEquivOfLe hLH
  let eK : K ≃* alternatingGroup (Fin 5) :=
    (cComponentTwoCoreQuotientEquiv hB).symm.trans
      ((QuotientGroup.congr _ _ c (pCore_map_iso 2 c)).trans e₀)
  have hgen : K ⊔ S = ⊤ := by
    rw [← Subgroup.map_sup, ← subgroupOf_sup hLH hTH, subgroupOf_self,
      map_top_of_surjective π (QuotientGroup.mk'_surjective _)]
  have hS : IsPGroup 2 S := T.isPGroup'.comap_subtype.map π
  have hquot : IsPGroup 2 ((H ⧸ pCore 2 H) ⧸ K) :=
    isPGroup_quotient_of_sup_eq_top K S hS hgen
  let : IsSimpleGroup (alternatingGroup (Fin 5)) := alternatingGroup.isSimpleGroup (by simp)
  let : IsSimpleGroup K := eK.isSimpleGroup
  have hnoncomm : ¬ IsMulCommutative K := by
    intro hc
    have ha : IsMulCommutative (alternatingGroup (Fin 5)) :=
      isMulCommutative_iff.mpr (fun a b => eK.symm.injective (by
        simpa only [map_mul] using (isMulCommutative_iff.mp hc) (eK.symm a) (eK.symm b)))
    have hh := alternatingGroup.isMulCommutative_iff_card_le_three.mp ha
    norm_num at hh
  have hC : centralizer (K : Set (H ⧸ pCore 2 H)) = ⊥ :=
    centralizer_eq_bot_of_simple_two_quotient K hnoncomm hquot (pCore_quotient_pCore_eq_bot 2)
  have hKtop : K ≠ ⊤ := by
    intro ht
    have hm := congrArg (fun D : Subgroup (H ⧸ pCore 2 H) => (D.comap π).map H.subtype) ht
    change ((B.map π).comap π).map H.subtype =
      ((⊤ : Subgroup (H ⧸ pCore 2 H)).comap π).map H.subtype at hm
    rw [comap_map_eq, QuotientGroup.ker_mk', Subgroup.map_sup,
      map_subgroupOf_eq_of_le hLH, comap_top,
      ← MonoidHom.range_eq_map, range_subtype] at hm
    change L ⊔ H.pCoreIn 2 = H at hm
    exact local_sylow_not_le_core_join_of_omega_line h611 hnatural horder hline
      (hTH.trans_eq hm.symm)
  obtain ⟨t, ht⟩ := SetLike.exists_not_mem_of_ne_top K hKtop
  have hout : (MulAut.conjNormal t : MulAut K) ∉ MulAut.innerSubgroup K := by
    rintro ⟨k, hk⟩
    have hk' : (MulAut.conjNormal (k : H ⧸ pCore 2 H) : MulAut K) =
        MulAut.conjNormal t := by
      rw [MulAut.conjNormal_val]
      exact hk
    have ha : (MulAut.conjNormal ((k : H ⧸ pCore 2 H)⁻¹ * t) : MulAut K) = 1 := by
      rw [map_mul, map_inv, hk', inv_mul_cancel]
    have hc : (k : H ⧸ pCore 2 H)⁻¹ * t ∈ centralizer (K : Set (H ⧸ pCore 2 H)) := by
      rw [← MulAut.conjNormal_ker_eq_centralizer]
      exact ha
    have he : (k : H ⧸ pCore 2 H) = t := by
      rw [hC, mem_bot] at hc
      exact inv_mul_eq_one.mp hc
    exact ht (he ▸ k.property)
  obtain ⟨e, he⟩ := Theory.SpecificGroups.Alternating.FiveExtensionAction.exists_equiv K eK hC t hout
  refine ⟨e, ?_⟩
  rw [← map_map]
  change K.map e.toMonoidHom = alternatingGroup (Fin 5)
  ext a
  constructor
  · rintro ⟨k, hk, rfl⟩
    change e k ∈ alternatingGroup (Fin 5)
    rw [he ⟨k, hk⟩]
    exact (eK ⟨k, hk⟩).property
  · intro ha
    obtain ⟨k, hk⟩ := eK.surjective ⟨a, ha⟩
    exact ⟨k, k.property, (he k).trans (congrArg Subtype.val hk)⟩

end CFSG.Quasithin.Chapter6.Source.RankOneRecognition
