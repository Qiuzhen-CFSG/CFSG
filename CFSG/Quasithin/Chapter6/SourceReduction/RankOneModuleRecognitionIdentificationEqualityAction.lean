module
public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleRecognitionIdentificationEqualityPreparation
public import Theory.ElementaryAbelian.NormalClosureQuotient
public import Theory.GroupAction.SubgroupQuotientFullAction
public import Theory.Representation.ElementaryAbelianAction

/-!
# The faithful quotient action in the equality branch of 6.2.13

Inside the actual involution centralizer H, let S be Z_S and let U be its
normal closure. The central subgroup generated by z defines the literal
quotient U/⟨z⟩. Earlier local analysis makes this quotient abelian; its
conjugate generators have exponent two, so it is a binary vector space.
The elementwise kernel criterion identifies the kernel of conjugation with
O₂(H), giving a faithful representation of the actual quotient H/O₂(H).

The image of S is a line and its conjugate orbit generates the vector space.
The final source adapter supplies elementary abelianness from Hypothesis611;
no classification or extraspecial-core conclusion is assumed here.

Source: Aschbacher–Smith, Proposition 6.2.13, printed pp.686–687
(PDF pp.703–704), using the earlier local analysis in 6.2.1–12.
-/

@[expose] public section
open Subgroup Theory.GroupTheory
open scoped commutatorElement IsMulCommutative
namespace CFSG.Quasithin.Chapter6.Source.RankOneRecognition
open M22Recognition.CentralizerExtension
variable {G : Type*} [Group G]

/-- The source four-plane, inside the involution centralizer. -/
abbrev equalityPlane (T L R : Subgroup G) (z : G) : Subgroup (centralizer ({z} : Set G)) :=
  (ZS T L R).subgroupOf (centralizer ({z} : Set G))

/-- The literal H-normal closure of the source plane. -/
abbrev equalityClosure (T L R : Subgroup G) (z : G) : Subgroup (centralizer ({z} : Set G)) :=
  sourceEight (equalityPlane T L R z)

/-- The central cyclic subgroup, restricted to H rather than declared normal in G. -/
abbrev equalityLine (z : G) : Subgroup (centralizer ({z} : Set G)) :=
  (zpowers z).subgroupOf (centralizer ({z} : Set G))

theorem equalityLine_le_center (z : G) :
    equalityLine z ≤ center (centralizer ({z} : Set G)) := by
  intro x hx
  apply mem_center_iff.mpr
  intro h
  apply Subtype.ext
  have hc : zpowers z ≤ centralizer ({(h : G)} : Set G) :=
    zpowers_le.mpr (mem_centralizer_singleton_iff.mpr
      (mem_centralizer_singleton_iff.mp h.property).symm)
  exact (mem_centralizer_singleton_iff.mp (hc hx)).symm

instance equalityLine_normal (z : G) : (equalityLine z).Normal where
  conj_mem x hx h := by
    have hc := mem_center_iff.mp (equalityLine_le_center z hx) h
    simpa only [hc, mul_inv_cancel_right] using hx

/-- The actual vector quotient U/(U ∩ ⟨z⟩); the source puts ⟨z⟩ in S ≤ U. -/
abbrev EqualityVectorQuotient (T L R : Subgroup G) (z : G) :=
  equalityClosure T L R z ⧸ (equalityLine z).subgroupOf (equalityClosure T L R z)

/-- The actual actor quotient H/O₂(H). -/
abbrev EqualityActor (z : G) :=
  centralizer ({z} : Set G) ⧸ pCore 2 (centralizer ({z} : Set G))

/-- Conjugation on the literal quotient, with its formula proved below. -/
noncomputable def equalityQuotientAction (T L R : Subgroup G) (z : G) :
    centralizer ({z} : Set G) →* MulAut (EqualityVectorQuotient T L R z) :=
  (Classical.choose (exists_quotient_conjugation_action
    ⊤ (equalityClosure T L R z) (equalityLine z)
    (by rw [normalizer_eq_top])
    (by rw [normalizer_eq_top]) inferInstance)).comp
      (Subgroup.topEquiv.symm.toMonoidHom)

theorem equalityQuotientAction_mk (T L R : Subgroup G) (z : G)
    (h : centralizer ({z} : Set G)) (u : equalityClosure T L R z) :
    equalityQuotientAction T L R z h (QuotientGroup.mk' _ u) =
      QuotientGroup.mk' _ ⟨h * u * h⁻¹,
        (inferInstance : (equalityClosure T L R z).Normal).conj_mem u u.property h⟩ := by
  exact Classical.choose_spec (exists_quotient_conjugation_action
    ⊤ (equalityClosure T L R z) (equalityLine z)
    (by rw [normalizer_eq_top])
    (by rw [normalizer_eq_top]) inferInstance) ⟨h, mem_top h⟩ u

variable {T L M R : Subgroup G} {z : G}

theorem LocalAnalysis.equalityQuotientAction_ker (A : LocalAnalysis T L M R z) :
    (equalityQuotientAction T L R z).ker = pCore 2 (centralizer ({z} : Set G)) := by
  ext h
  have hcore : h ∈ pCore 2 (centralizer ({z} : Set G)) ↔
      (h : G) ∈ (centralizer ({z} : Set G)).pCoreIn 2 := by
    simp only [pCoreIn, mem_map]
    constructor
    · exact fun hh => ⟨h, hh, rfl⟩
    · rintro ⟨x, hx, he⟩
      exact (Subtype.ext he : x = h) ▸ hx
  rw [hcore, ← A.action_kernel h h.property]
  change equalityQuotientAction T L R z h = 1 ↔ _
  constructor
  · intro hh x hx
    obtain ⟨u, hu, rfl⟩ := hx
    have he := congrArg (fun f : MulAut (EqualityVectorQuotient T L R z) =>
      f (QuotientGroup.mk' _ ⟨u, hu⟩)) hh
    rw [equalityQuotientAction_mk] at he
    have hc := QuotientGroup.eq_iff_div_mem.mp he
    change (h : G) * (u : G) * (h : G)⁻¹ / (u : G) ∈ zpowers z at hc
    simpa only [div_eq_mul_inv, commutatorElement_def, Subgroup.subtype_apply] using hc
  · intro hh
    apply MulEquiv.ext
    intro w
    obtain ⟨u, rfl⟩ := QuotientGroup.mk'_surjective _ w
    rw [equalityQuotientAction_mk]
    apply QuotientGroup.eq_iff_div_mem.mpr
    change (h : G) * u.val.val * (h : G)⁻¹ / u.val.val ∈ zpowers z
    simpa only [div_eq_mul_inv, commutatorElement_def] using
      hh u.val.val ⟨u.val, u.property, rfl⟩


theorem LocalAnalysis.equalityVectorQuotient_commutative
    (A : LocalAnalysis T L M R z) :
    IsMulCommutative (EqualityVectorQuotient T L R z) := by
  apply Normal.quotient_commutative_iff_commutator_le.mpr
  apply Subgroup.commutator_le.mpr
  intro u _ v _
  change ⁅u.val.val, v.val.val⁆ ∈ zpowers z
  exact A.closure_core_commutator (commutator_mem_commutator
    (show u.val.val ∈ sourceClosure T L R z from ⟨u.val, u.property, rfl⟩)
    (A.closure_le_core ⟨v.val, v.property, rfl⟩))

theorem LocalAnalysis.equalityVectorQuotient_elementary
    (A : LocalAnalysis T L M R z)
    (hZS : IsElementaryAbelian 2 (ZS T L R))
    (hZSH : ZS T L R ≤ centralizer ({z} : Set G)) :
    IsElementaryAbelian 2 (EqualityVectorQuotient T L R z) := by
  let := hZS
  have hS : IsElementaryAbelian 2 (equalityPlane T L R z) :=
    IsElementaryAbelian.subgroupOf (p := 2) hZSH
  have hN : ((equalityLine z).subgroupOf (equalityClosure T L R z)).Normal := inferInstance
  exact @normalClosure_quotient_elementary (centralizer ({z} : Set G)) _ 2
    (equalityPlane T L R z) hS
    ((equalityLine z).subgroupOf (equalityClosure T L R z)) hN
    A.equalityVectorQuotient_commutative

noncomputable def equalityActorEquivRange (A : LocalAnalysis T L M R z) :
    EqualityActor z ≃* (equalityQuotientAction T L R z).range :=
  (QuotientGroup.quotientMulEquivOfEq A.equalityQuotientAction_ker.symm).trans
    (QuotientGroup.quotientKerEquivRange (equalityQuotientAction T L R z))

section Representation
variable [IsElementaryAbelian 2 (EqualityVectorQuotient T L R z)]

/-- The faithful linear representation induced by the exact kernel computation. -/
noncomputable def equalityRepresentation (A : LocalAnalysis T L M R z) :
    Representation (ZMod 2) (EqualityActor z) (Additive (EqualityVectorQuotient T L R z)) where
  toFun a := (equalityActorEquivRange A a).val.toMonoidHom.toAdditive.toZModLinearMap 2
  map_one' := by
    ext v
    change Additive.ofMul ((equalityActorEquivRange A 1).val v.toMul) = v
    rw [map_one]
    rfl
  map_mul' a b := by
    ext v
    change Additive.ofMul ((equalityActorEquivRange A (a * b)).val v.toMul) = _
    rw [map_mul]
    rfl

theorem equalityRepresentation_mk (A : LocalAnalysis T L M R z)
    (h : centralizer ({z} : Set G)) (v : Additive (EqualityVectorQuotient T L R z)) :
    equalityRepresentation A (QuotientGroup.mk' _ h) v =
      Additive.ofMul (equalityQuotientAction T L R z h v.toMul) := rfl

theorem equalityRepresentation_injective (A : LocalAnalysis T L M R z) :
    Function.Injective (equalityRepresentation A) := by
  intro a b hab
  apply (equalityActorEquivRange A).injective
  apply Subtype.ext
  apply MulEquiv.ext
  intro v
  exact Additive.ofMul.injective
    (congrArg (fun f : Module.End (ZMod 2) (Additive (EqualityVectorQuotient T L R z)) =>
      f (Additive.ofMul v)) hab)

end Representation


/-- The image of an ambient subgroup in the actual actor quotient. -/
def equalityActorImage (z : G) (B : Subgroup G) : Subgroup (EqualityActor z) :=
  (B.subgroupOf (centralizer ({z} : Set G))).map (QuotientGroup.mk' _)

/-- The image of the four-plane in the actual vector quotient. -/
def equalityDistinguishedLine (T L R : Subgroup G) (z : G) :
    Subgroup (EqualityVectorQuotient T L R z) :=
  ((equalityPlane T L R z).subgroupOf (equalityClosure T L R z)).map
    (QuotientGroup.mk' _)

theorem equalityDistinguishedLine_generates (T L R : Subgroup G) (z : G) :
    closure {w : EqualityVectorQuotient T L R z | ∃ h : centralizer ({z} : Set G),
      ∃ s ∈ equalityDistinguishedLine T L R z, equalityQuotientAction T L R z h s = w} = ⊤ := by
  let U := equalityClosure T L R z
  let q := QuotientGroup.mk' ((equalityLine z).subgroupOf U)
  let C := closure {w : EqualityVectorQuotient T L R z | ∃ h : centralizer ({z} : Set G),
    ∃ s ∈ equalityDistinguishedLine T L R z, equalityQuotientAction T L R z h s = w}
  let D := (C.comap q).map U.subtype
  have hUD : U ≤ D := by
    apply (closure_le _).mpr
    intro x hx
    obtain ⟨s, hs, hconj⟩ := Group.mem_conjugatesOfSet_iff.mp hx
    obtain ⟨h, rfl⟩ := isConj_iff.mp hconj
    let sU : U := ⟨s, sourceEight_contains _ hs⟩
    let u : U := ⟨h * s * h⁻¹, (inferInstance : U.Normal).conj_mem s sU.property h⟩
    refine mem_map.mpr ⟨u, ?_, rfl⟩
    apply Subgroup.subset_closure
    exact ⟨h, q sU, mem_map.mpr ⟨sU, hs, rfl⟩, equalityQuotientAction_mk T L R z h sU⟩
  apply top_unique
  intro w _
  obtain ⟨u, rfl⟩ := QuotientGroup.mk'_surjective _ w
  obtain ⟨u', hu', he⟩ := hUD u.property
  exact (Subtype.ext he : u' = u) ▸ hu'

theorem equalityDistinguishedLine_card
    (hZSH : ZS T L R ≤ centralizer ({z} : Set G))
    (hz : z ∈ ZS T L R) (horder : orderOf z = 2)
    (hcard : Nat.card (ZS T L R) = 4) :
    Nat.card (equalityDistinguishedLine T L R z) = 2 := by
  let U := equalityClosure T L R z
  let S := equalityPlane T L R z
  let N := (equalityLine z).subgroupOf U
  let B := S.subgroupOf U
  have hZS : equalityLine z ≤ S := fun _ hx => (zpowers_le.mpr hz) hx
  have hSU : S ≤ U := sourceEight_contains S
  have hNB : N ≤ B := fun _ hx => hZS hx
  have hcB : Nat.card B = 4 := by
    rw [Nat.card_congr (subgroupOfEquivOfLe hSU).toEquiv]
    exact (Nat.card_congr (subgroupOfEquivOfLe hZSH).toEquiv).trans hcard
  have hcN : Nat.card (N.subgroupOf B) = 2 := by
    rw [Nat.card_congr (subgroupOfEquivOfLe hNB).toEquiv,
      Nat.card_congr (subgroupOfEquivOfLe (hZS.trans hSU)).toEquiv,
      Nat.card_congr (subgroupOfEquivOfLe ((zpowers_le.mpr hz).trans hZSH)).toEquiv]
    exact (Nat.card_zpowers z).trans horder
  have hi : N.relIndex B = Nat.card (equalityDistinguishedLine T L R z) := by
    simpa only [QuotientGroup.ker_mk', equalityDistinguishedLine, B, N, U, S] using
      (Subgroup.relIndex_ker (K := B) (QuotientGroup.mk' N))
  have hc := (N.subgroupOf B).card_mul_index
  change Nat.card (N.subgroupOf B) * N.relIndex B = Nat.card B at hc
  rw [hcN, hi, hcB] at hc
  omega

section SourceAction
variable [Finite G]
variable {κ : GroupClass} {TS : Sylow 2 G} {n : ℕ}

theorem LocalAnalysis.sourceEqualityVectorQuotient_elementary
    (A : LocalAnalysis (TS : Subgroup G) L M R z)
    (h611 : Hypothesis611 κ TS L M R n)
    (hz : z ∈ ZS (TS : Subgroup G) L R) :
    IsElementaryAbelian 2 (EqualityVectorQuotient (TS : Subgroup G) L R z) :=
  A.equalityVectorQuotient_elementary h611.ZS_elementary
    (inf_le_left.trans (layer_le_involution_centralizer h611 hz))

/-- An actual faithful binary action, with no recognition premise. -/
noncomputable def sourceEqualityRepresentation
    (A : LocalAnalysis (TS : Subgroup G) L M R z)
    (h611 : Hypothesis611 κ TS L M R n)
    (hz : z ∈ ZS (TS : Subgroup G) L R) :
    letI := A.sourceEqualityVectorQuotient_elementary h611 hz
    Representation (ZMod 2) (EqualityActor z)
      (Additive (EqualityVectorQuotient (TS : Subgroup G) L R z)) := by
  letI := A.sourceEqualityVectorQuotient_elementary h611 hz
  exact equalityRepresentation A

theorem sourceEqualityRepresentation_faithful
    (A : LocalAnalysis (TS : Subgroup G) L M R z)
    (h611 : Hypothesis611 κ TS L M R n)
    (hz : z ∈ ZS (TS : Subgroup G) L R) :
    Function.Injective (sourceEqualityRepresentation A h611 hz) := by
  let := A.sourceEqualityVectorQuotient_elementary h611 hz
  exact equalityRepresentation_injective A

end SourceAction

end CFSG.Quasithin.Chapter6.Source.RankOneRecognition
