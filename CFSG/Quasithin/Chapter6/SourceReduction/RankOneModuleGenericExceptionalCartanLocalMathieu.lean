private theorem odd_normalizes_mathieu_section
    (C R J E B : Subgroup G) [C.Normal] [Group.IsSolvable J]
    (eC : C ≃* Sporadic.Mathieu.M22) (hRC : R ≤ C)
    (S : Sylow 2 G) (hSJ : (S : Subgroup G) ≤ J) (hEJ : E ≤ J)
    (hBE : B ≤ E) (hBR : B ≤ R) (hB : Nat.card B = 3)
    (hodd : Odd (Nat.card E)) : E ≤ normalizer (R : Set G) := by
  let f : G →* MulAut C := MulAut.conjNormal
  let i : C →* MulAut C := MulAut.conj
  have hz : center C = ⊥ := by
    apply bot_unique
    intro z hz
    have hh : eC z ∈ center Sporadic.Mathieu.M22 :=
      (centerCongr eC ⟨z,hz⟩).property
    rw [Sporadic.Mathieu.m22_center_eq_bot,mem_bot] at hh
    exact eC.injective (hh.trans eC.map_one.symm)
  have hi : Function.Injective i := conj_injective_of_center_eq_bot hz
  have hfi (x : C) : f x = i x := by ext y; rfl
  have houter : IsPGroup 2 (MulAut.Outer C) := by
    apply IsPGroup.of_card_dvd_pow (n := 1)
    rw [pow_one,Nat.card_congr (MulAut.outerCongr eC).toEquiv]
    exact Sporadic.Mathieu.M22TripleCover.ScalarAutomorphisms.m22_outer_card_dvd_two
  have hEin : E.map f ≤ i.range := by
    let q := QuotientGroup.mk' (MulAut.innerSubgroup C)
    have hod : Odd (Nat.card ((E.map f).map q)) :=
      hodd.of_dvd_nat ((card_map_dvd _ q).trans (card_map_dvd _ f))
    obtain ⟨k,hk⟩ := (houter.to_subgroup ((E.map f).map q)).exists_card_eq
    have hk0 : k = 0 := by
      by_contra hk0
      exact hod.not_two_dvd_nat (by rw [hk]; exact dvd_pow_self 2 hk0)
    have hb : (E.map f).map q = ⊥ := card_eq_one.mp (by rw [hk,hk0,pow_zero])
    simpa only [q,QuotientGroup.ker_mk'] using (Subgroup.map_eq_bot_iff _).mp hb
  let M := (J.map f).comap i
  let N := (E.map f).comap i
  have hNmap : N.map i = E.map f := map_comap_eq_self hEin
  have hNc : Nat.card N = Nat.card (E.map f) := by
    rw [←hNmap,card_map_of_injective hi]
  have hNM : N ≤ M := comap_mono (map_mono hEJ)
  let : Group.IsSolvable (J.map f) := Group.isSolvable_of_surjective (f.subgroupMap_surjective _)
  let : Group.IsSolvable M := Group.isSolvable_of_isSolvable_injective
    (f := i.subgroupComap (J.map f)) (fun x y he => Subtype.ext (hi (congrArg Subtype.val he)))
  obtain ⟨P,hP⟩ := S.exists_subgroupOf_eq_of_normal C
  have hPM : (P : Subgroup C) ≤ M := by
    intro x hx
    change i x ∈ J.map f
    rw [←hfi]
    have hx' : x ∈ (S : Subgroup G).subgroupOf C := hP ▸ hx
    exact mem_map_of_mem f (hSJ hx')
  have hfB : Function.Injective (f.comp B.subtype) := by
    intro x y hh
    have he (b : B) : f (b : G) = i (inclusion (hBR.trans hRC) b) :=
      hfi (inclusion (hBR.trans hRC) b)
    change f (x : G) = f (y : G) at hh
    rw [he x,he y] at hh
    exact inclusion_injective (hBR.trans hRC) (hi hh)
  have hBc : Nat.card (B.map f) = 3 := by
    rw [←range_subtype B,←MonoidHom.range_comp]
    exact (Nat.card_congr (MonoidHom.ofInjective hfB).toEquiv).symm.trans hB
  have h3M : 3 ∣ Nat.card M := by
    have hd := card_dvd_of_le (map_mono (f := f) hBE)
    rw [hBc,←hNc] at hd
    exact hd.trans (card_dvd_of_le hNM)
  have hMc : Nat.card M = 384 := by
    let Mm := M.map eC.toMonoidHom
    have hn : (Mm.subgroupOf Mm).Normal := by rw [subgroupOf_self]; infer_instance
    let : Group.IsSolvable Mm := Group.isSolvable_of_surjective (eC.toMonoidHom.subgroupMap_surjective M)
    have hh := Sporadic.Mathieu.M22SolvableSylow.card_eq_384_of_solvable_normal_three
      Mm Mm le_rfl hn inferInstance (by rwa [card_map_of_injective eC.injective])
      ⟨P.mapSurjective (f := eC.toMonoidHom) eC.surjective,map_mono hPM⟩
    rwa [card_map_of_injective eC.injective] at hh
  have hsmall : Nat.card (E.map f) ≤ 3 := by
    have hoN : Odd (Nat.card N) := by rw [hNc]; exact hodd.of_dvd_nat (card_map_dvd _ f)
    have hd : Nat.card N ∣ 3 * 128 := by simpa only [hMc] using card_dvd_of_le hNM
    have hc : Nat.Coprime (Nat.card N) 128 := hoN.coprime_two_right.pow_right 7
    rw [←hNc]
    exact Nat.le_of_dvd (by decide) (hc.dvd_of_dvd_mul_right hd)
  have he : B.map f = E.map f := eq_of_le_of_card_ge (map_mono hBE) (by rw [hBc]; exact hsmall)
  intro x hx
  obtain ⟨b,hb,hbx⟩ := mem_map.mp (he.symm ▸ mem_map_of_mem f hx)
  have hker : x * b⁻¹ ∈ f.ker := by
    change f (x * b⁻¹) = 1
    rw [map_mul,map_inv,hbx,mul_inv_cancel]
  have hc : x * b⁻¹ ∈ centralizer (C : Set G) := by
    rw [←MulAut.conjNormal_ker_eq_centralizer]
    exact hker
  have hn := (centralizer_le hRC).trans (centralizer_le_normalizer (R : Set G)) hc
  simpa only [inv_mul_cancel_right] using
    (normalizer (R : Set G)).mul_mem hn (R.le_normalizer (hBR hb))

/-- The original residual has literal PSL₂(4) quotient in either Mathieu
row, retaining its possible two-core throughout the quotient restriction. -/
theorem residual_section_of_mathieu_twentyTwo_twentyThree
    {T : Sylow 2 G} {L W H A Y : Subgroup G} {n : ℕ}
    (h : Input KnownSimple.IsKnownSimple T L W n)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hgen : 1 < ChapterE.generationParameter H)
    (hY : Y ∈ Chapter1.HOver G (H : Set G))
    (hescape : ¬ A ⊓ Y ≤ normalizer (residual H : Set G))
    (hR : residual H ∈ Chapter1.L G (T : Subgroup G))
    (C : Subgroup Y) (hC : C.IsCComponent)
    (hRC : residual H ≤ C.map Y.subtype)
    (hm : Nonempty ((C ⧸ pCore 2 C) ≃* Sporadic.Mathieu.M22) ∨
      Nonempty ((C ⧸ pCore 2 C) ≃* Sporadic.Mathieu.M23)) :
    ClassicalGroup.IsPSL ((pResidual 2 H) ⧸ pCore 2 (pResidual 2 H)) 2 4 := by
  have hR' : (pResidual 2 H).IsCComponent := by
    have hh := hR.1
    rw [residual_sup_sylow T H hH.1.1.2] at hh
    simpa only [residual,subgroupOf,comap_map_eq_self_of_injective H.subtype_injective] using hh
  have hRY : residual H ≤ Y := (map_subtype_le _).trans hY.2
  have hTY := hH.1.1.2.trans hY.2
  let q := QuotientGroup.mk' (pCore 2 Y)
  let S := T.subtype hTY
  let P := S.mapSurjective (QuotientGroup.mk'_surjective (pCore 2 Y))
  let Rbar := ((residual H).subgroupOf Y).map q
  let Cbar := C.map q
  have hl : (residual H).subgroupOf Y ∈ Chapter1.L Y (S : Subgroup Y) :=
    (Chapter1.mem_LIn_iff_subgroupOf hTY hRY).mp ⟨hRY,hR⟩
  have hlq : Rbar ∈ ChapterA.Section03.localCComponents P :=
    Chapter1.Section02.mem_L_map_twoCore_mem_localCComponents hl
  have hRC' : (residual H).subgroupOf Y ≤ C := by
    have hh := comap_mono (f := Y.subtype) hRC
    simpa only [subgroupOf,comap_map_eq_self_of_injective Y.subtype_injective] using hh
  have hle : Rbar ≤ Cbar := map_mono hRC'
  let : Group.IsNilpotent (pCore 2 Y) := pCore_isNilpotent
  obtain ⟨Q,hQ,hU⟩ := ChapterA.Section03.SourceEmbeddings.exists_local_sylow_restriction
    P hlq hle (hC.map_quotient (pCore 2 Y)).subnormal
  let U := Rbar.subgroupOf Cbar
  have hn : (P : Subgroup (Y ⧸ pCore 2 Y)) ≤ normalizer (Rbar : Set _) := by
    apply (map_mono (f := q) ?_).trans (le_normalizer_map q)
    rw [←subgroupOf_normalizer_eq hRY]
    exact comap_mono (hH.1.1.2.trans (le_normalizer_residual H))
  have hnU : (Q : Subgroup Cbar) ≤ normalizer (U : Set Cbar) := by
    rw [hQ,←subgroupOf_normalizer_eq hle]
    exact comap_mono hn
  let r := q.subgroupMap ((residual H).subgroupOf Y)
  have hr : IsPGroup 2 r.ker := by
    rw [ker_subgroupMap,QuotientGroup.ker_mk']
    exact pCore_isPGroup.comap_subtype
  let e₀ := (pResidual 2 H).equivMapOfInjective H.subtype H.subtype_injective
  let e₁ := e₀.trans (subgroupOfEquivOfLe hRY).symm
  let e₂ := r.pCoreQuotientEquiv (q.subgroupMap_surjective _) hr
  let e₃ := (subgroupOfEquivOfLe hle).symm
  let eR : ((pResidual 2 H) ⧸ pCore 2 (pResidual 2 H)) ≃* (U ⧸ pCore 2 U) :=
    (QuotientGroup.congr _ _ e₁ (pCore_map_iso 2 e₁)).trans
      (e₂.trans (QuotientGroup.congr _ _ e₃ (pCore_map_iso 2 e₃)))
  let eC : Cbar ≃* (C ⧸ pCore 2 C) := (cComponentTwoCoreQuotientEquiv hC).symm
  have hd : Nat.card ((pResidual 2 H) ⧸ pCore 2 (pResidual 2 H)) ∣ 10200960 := by
    rw [Nat.card_congr eR.toEquiv]
    have hh := (card_quotient_dvd_card (pCore 2 U)).trans U.card_subgroup_dvd_card
    rw [Nat.card_congr eC.toEquiv] at hh
    rcases hm with he | he
    · rw [Nat.card_congr he.some.toEquiv,Sporadic.Mathieu.m22_order] at hh
      exact hh.trans (by decide)
    · rwa [Nat.card_congr he.some.toEquiv,Sporadic.Mathieu.m23_order] at hh
  have hmodel : ChapterF.Source.IsRankOneModel
      ((pResidual 2 H) ⧸ pCore 2 (pResidual 2 H)) := by
    rcases Global.right_source_cases h.qtke h.sylow_normalizes hH hgen with hs | hs
    · obtain ⟨K,f,hK,hqs,_,_,hc | hc⟩ := hs
      · have hKR : K = pResidual 2 H := by
          apply hK.eq_of_le hR'
          let := hK.perfect
          apply le_sInf
          rintro N ⟨hn,hN⟩
          let := hn
          let : Group.IsNilpotent (H ⧸ N) := hN.isNilpotent
          exact (le_solvableResidual_of_isPerfect K).trans (solvableResidual_le_of_solvable_quotient N)
        subst K
        obtain ⟨t,_,hne,_⟩ := hc.1.exchanged_product
        exact (hne (mem_normalizer_iff_map_conj_eq.mp
          (show t⁻¹ ∈ normalizer (pResidual 2 H : Set H) by
            rw [normalizer_eq_top]; exact mem_top _)).symm).elim
      · have he : K = pResidual 2 H :=
          BenderHall.SingleClauses.component_eq_residual (S := T.subtype hH.1.1.2) hc.1 hK
        subst K
        have hO : pCore 2 H ≤ sourceKernel ((normalizer (L : Set G)).subgroupOf H) := by
          apply normal_le_normalCore.mpr
          exact (pCore_isPGroup.le_sylow_of_normal (T.subtype hH.1.1.2)).trans
            (comap_mono h.sylow_normalizes)
        exact Prime.single_bender_component_quotient hK hqs hO hc.1 hc.2
    · obtain ⟨K,f,hK,hqs,_,hf,hc,hm⟩ := hs
      have hmodels := Prime.diagram_source_residual_quotient h.sylow_normalizes hH.1.1.2 hK hqs hc hf hm
      have hf2 := Prime.diagram_finite_order hf (by simp [Prime.finiteOrders]) hd hmodels
      subst f
      rcases hmodels with hlin | hsl | hsp
      · exact (not_linear_four_residual_of_escape h.qtke h.sylow_normalizes hH hY hescape hlin).elim
      · obtain ⟨F,_,_,hF,⟨a⟩⟩ := hsl
        rw [Nat.card_congr a.toEquiv,
          Matrix.PSL3.LinearThree.DefiningSylow.card_specialLinear,hF] at hd
        norm_num at hd
      · obtain ⟨F,_,_,hF,⟨a⟩⟩ := hsp
        let : Fintype F := Fintype.ofFinite F
        let : CharP F 2 := charP_of_card_eq_prime_pow (p := 2) (f := 2)
          (by simpa only [Nat.card_eq_fintype_card] using hF)
        let b := a.trans Theory.SpecificGroups.SymplecticFour.EvenProjective.equiv.symm
        rw [Nat.card_congr b.toEquiv,Theory.SpecificGroups.SymplecticFour.card_sp,hF] at hd
        norm_num at hd
  exact (ChapterF.Source.MathieuLocal.rankOne_quotient_four Q U hU hnU
    (hmodel.of_equiv eR.symm)
    (hm.imp (fun he => he.map (fun e => eC.trans e))
      (fun he => Or.inl (he.map (fun e => eC.trans e))))).of_mulEquiv eR

/-- In these two normal containing rows, the same seed equals the whole
residual, its literal quotient is PSL₂(4), and the original right Hall is cubic. -/
theorem normal_mathieu_twentyTwo_twentyThree_residual_and_hall
    {T : Sylow 2 G} {L W H A B K Y : Subgroup G} {n : ℕ}
    (h : Input KnownSimple.IsKnownSimple T L W n)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hgen : 1 < ChapterE.generationParameter H) (c : CartanPair T L H A B)
    (hK : K ∈ Chapter1.L G (T : Subgroup G))
    (hKT : K ⊔ (T : Subgroup G) = H)
    (horbit : componentOrbit K (T : Subgroup G) = residual H)
    (hY : Y ∈ Chapter1.HOver G (H : Set G))
    (hescape : ¬ A ⊓ Y ≤ normalizer (residual H : Set G))
    (C : Subgroup Y) (hC : C.IsCComponent) [C.Normal]
    (hKC : K ≤ C.map Y.subtype)
    (hm : Nonempty ((C ⧸ pCore 2 C) ≃* Sporadic.Mathieu.M22) ∨
      Nonempty ((C ⧸ pCore 2 C) ≃* Sporadic.Mathieu.M23)) :
    K = residual H ∧
      ClassicalGroup.IsPSL ((pResidual 2 H) ⧸ pCore 2 (pResidual 2 H)) 2 4 ∧
      Nat.card B = 3 := by
  have hKR : K = residual H := by
    apply seed_eq_residual_of_normal_twentyFive_free_container h.qtke hK hKT horbit
      hY hescape C hKC
    rcases hm with he | he
    · rw [Nat.card_congr he.some.toEquiv,Sporadic.Mathieu.m22_order]; norm_num
    · rw [Nat.card_congr he.some.toEquiv,Sporadic.Mathieu.m23_order]; norm_num
  have hfour := residual_section_of_mathieu_twentyTwo_twentyThree h hH hgen hY hescape
    (hKR ▸ hK) C hC (hKR ▸ hKC) hm
  have hA5 : Nonempty ((residual H ⧸ pCore 2 (residual H)) ≃* alternatingGroup (Fin 5)) := by
    let a := (pResidual 2 H).equivMapOfInjective H.subtype H.subtype_injective
    let eq := QuotientGroup.congr _ _ a (pCore_map_iso 2 a)
    obtain ⟨F,_,_,hF,⟨b⟩⟩ := hfour
    exact ⟨eq.symm.trans (b.trans
      (Matrix.ProjectiveSpecialLinearGroup.equiv_alternatingGroup_of_card_four hF).some)⟩
  exact ⟨hKR,hfour,right_hall_card_three_of_residual_A5 h hH hgen c hA5⟩


/-- The entire original Cartan intersection cannot escape in an M₂₂
container. Its right cubic is derived from the original source hypotheses. -/
theorem not_mathieu_twentyTwo_container
    {T : Sylow 2 G} {L W H A B K Y : Subgroup G} {n : ℕ}
    (h : Input KnownSimple.IsKnownSimple T L W n)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hgen : 1 < ChapterE.generationParameter H) (c : CartanPair T L H A B)
    (hK : K ∈ Chapter1.L G (T : Subgroup G))
    (hKT : K ⊔ (T : Subgroup G) = H)
    (horbit : componentOrbit K (T : Subgroup G) = residual H)
    (hY : Y ∈ Chapter1.HOver G (H : Set G))
    (hescape : ¬ A ⊓ Y ≤ normalizer (residual H : Set G))
    (C : Subgroup Y) (hC : C.IsCComponent) [C.Normal]
    (hKC : K ≤ C.map Y.subtype) :
    ¬ Nonempty ((C ⧸ pCore 2 C) ≃* Sporadic.Mathieu.M22) := by
  intro he
  let e := he.some
  obtain ⟨hKR,_,hBc⟩ := normal_mathieu_twentyTwo_twentyThree_residual_and_hall
    h hH hgen c hK hKT horbit hY hescape C hC hKC (.inl he)
  have hRC : residual H ≤ C.map Y.subtype := hKR ▸ hKC
  have hRY : residual H ≤ Y := (map_subtype_le _).trans hY.2
  have hTY := hH.1.1.2.trans hY.2
  have hBY := (c.right_le.trans inf_le_right).trans hY.2
  let q := QuotientGroup.mk' (pCore 2 Y)
  let S := T.subtype hTY
  let P := S.mapSurjective (QuotientGroup.mk'_surjective (pCore 2 Y))
  let Rbar := ((residual H).subgroupOf Y).map q
  let Cbar := C.map q
  let Abar := (A.subgroupOf Y).map q
  let Bbar := (B.subgroupOf Y).map q
  have hRC' : (residual H).subgroupOf Y ≤ C := by
    have hh := comap_mono (f := Y.subtype) hRC
    simpa only [subgroupOf,comap_map_eq_self_of_injective Y.subtype_injective] using hh
  have hle : Rbar ≤ Cbar := map_mono hRC'
  have hBbar : Nat.card Bbar = 3 := by
    have hd : Nat.card Bbar ∣ 3 := by
      have hd := card_map_dvd (B.subgroupOf Y) q
      rwa [Nat.card_congr (subgroupOfEquivOfLe hBY).toEquiv,hBc] at hd
    rcases (Nat.dvd_prime Nat.prime_three).mp hd with hb | hb
    · have hz : Bbar = ⊥ := eq_bot_of_card_eq _ hb
      have hle : B.subgroupOf Y ≤ pCore 2 Y := by
        simpa only [q,QuotientGroup.ker_mk'] using (Subgroup.map_eq_bot_iff _).mp hz
      obtain ⟨k,hk⟩ := (pCore_isPGroup.to_le hle).exists_card_eq
      rw [Nat.card_congr (subgroupOfEquivOfLe hBY).toEquiv,hBc] at hk
      have hh : 3 ∣ 2 := Nat.prime_three.dvd_of_dvd_pow (by rw [←hk])
      norm_num at hh
    · exact hb
  have hBA : Bbar ≤ normalizer (Abar : Set (Y ⧸ pCore 2 Y)) := by
    apply (map_mono (f := q) ?_).trans (le_normalizer_map q)
    intro b hb
    apply mem_normalizer_iff.mpr
    intro a
    exact mem_normalizer_iff.mp (c.right_normalizes_left hb) (a : G)
  have hoddA : Odd (Nat.card Abar) := by
    have hoA : Odd (Nat.card A) := by
      rw [←Nat.card_congr (subgroupOfEquivOfLe c.left_le).toEquiv]
      exact OddHall.odd_hall_odd c.left_hall
    have hoAY : Odd (Nat.card (A.subgroupOf Y)) := by
      rw [←inf_subgroupOf_right A Y,Nat.card_congr
        (subgroupOfEquivOfLe (show A ⊓ Y ≤ Y from inf_le_right)).toEquiv]
      exact hoA.of_dvd_nat (card_dvd_of_le (show A ⊓ Y ≤ A from inf_le_left))
    exact hoAY.of_dvd_nat (card_map_dvd _ q)
  let E := Abar ⊔ Bbar
  have hoddE : Odd (Nat.card E) := by
    have hh := hoddA.mul (show Odd (Nat.card Bbar) by rw [hBbar]; decide)
    rw [card_mul_eq_card_inf_mul_card_sup_of_normalizes Abar Bbar hBA] at hh
    exact hh.of_dvd_nat (dvd_mul_left _ _)
  have hLH : ¬ L ≤ H := by
    intro hh
    exact hescape (inf_le_left.trans ((c.left_le.trans (inf_le_left.trans hh)).trans
      (le_normalizer_residual H)))
  have prep := cartanPreparation_of_not_le h hH hgen hLH
  let M := normalizer (L : Set G) ⊓ H
  let V := localBorel T L ⊔ M
  let : Group.IsSolvable (localBorel T L) := prep.borel_solvable
  let : Group.IsSolvable M := prep.intersection_solvable
  let : Group.IsSolvable V := Group.isSolvable_sup_of_normalizes _ _ prep.intersection_normalizes
  let JY := (A.subgroupOf Y ⊔ (T : Subgroup G).subgroupOf Y) ⊔ B.subgroupOf Y
  have hJV : JY.map Y.subtype ≤ V := by
    rw [Subgroup.map_sup,Subgroup.map_sup,subgroupOf_map_subtype,map_subgroupOf_eq_of_le hTY,
      map_subgroupOf_eq_of_le hBY]
    exact sup_le (sup_le ((inf_le_left.trans c.left_le).trans le_sup_left)
      ((le_inf h.sylow_normalizes hH.1.1.2).trans le_sup_right))
      (c.right_le.trans le_sup_right)
  let : Group.IsSolvable JY := Group.isSolvable_of_isSolvable_injective
    (f := (inclusion hJV).comp
      (JY.equivMapOfInjective Y.subtype Y.subtype_injective).toMonoidHom)
    ((inclusion_injective hJV).comp (JY.equivMapOfInjective Y.subtype Y.subtype_injective).injective)
  let J := JY.map q
  let : Group.IsSolvable J := Group.isSolvable_of_surjective (q.subgroupMap_surjective JY)
  let : Cbar.Normal := Subgroup.Normal.map inferInstance q (QuotientGroup.mk'_surjective _)
  have hnorm := odd_normalizes_mathieu_section Cbar Rbar J E Bbar
    ((cComponentTwoCoreQuotientEquiv hC).symm.trans e) hle P
    (map_mono (show (T : Subgroup G).subgroupOf Y ≤ JY from le_sup_right.trans le_sup_left))
    (sup_le (map_mono (le_sup_left.trans le_sup_left)) (map_mono le_sup_right))
    le_sup_right (map_mono (comap_mono (Global.right_cartan_le_residual c))) hBbar hoddE
  exact hescape ((residual_escape_twoCore_iff h.qtke h.sylow_normalizes hH hgen hY.2).mp
    (le_sup_left.trans hnorm))

end CFSG.Quasithin.Chapter6.Source.RankOneGeneric.LocalSieve

namespace CFSG.Quasithin.Chapter6.Source.RankOneGeneric
open Chapter1.Section02.LocalModels
variable {G : Type*} [Group G] [Finite G]

/-- On the same original component, M₂₂ is excluded and the M₂₃ row has
its literal residual quotient PSL₂(4) and its original right Hall of order
three. All earlier exclusions and the full binary-triality endpoint persist. -/
theorem localCartan_escape_seed_mathieu_reduction
    {T : Sylow 2 G} {L W H A B Y : Subgroup G} {n : ℕ}
    (h : Input KnownSimple.IsKnownSimple T L W n)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hgen : 1 < ChapterE.generationParameter H) (c : CartanPair T L H A B)
    (hY : Y ∈ Chapter1.HOver G (H : Set G))
    (hescape : ¬ A ⊓ Y ≤ normalizer (residual H : Set G)) :
    ∃ K : Subgroup G, K ≤ H ∧ (K.subgroupOf H).IsCComponent ∧
      IsQuasisimple (K ⧸ pCore 2 K) ∧ K ⊔ (T : Subgroup G) = H ∧
      K ∈ Chapter1.L G (T : Subgroup G) ∧
      componentOrbit K (T : Subgroup G) = residual H ∧
      ∃ C : Subgroup Y, C.IsCComponent ∧ K ≤ C.map Y.subtype ∧
        residual H < componentOrbit (C.map Y.subtype) (T : Subgroup G) ∧
        ((componentOrbit (C.map Y.subtype) (T : Subgroup G)).subgroupOf Y).Normal ∧
        (K.subgroupOf Y).map (QuotientGroup.mk' (pCore 2 Y)) <
          C.map (QuotientGroup.mk' (pCore 2 Y)) ∧
        ¬ SolvableSylowOvergroups (C ⧸ pCore 2 C) ∧
        (∀ m : ℕ, 0 < m → ¬ (ClassicalGroup.IsPSL (C ⧸ pCore 2 C) 3 (2 ^ m) ∨
          IsSL (C ⧸ pCore 2 C) 3 (2 ^ m) ∨ IsSU (C ⧸ pCore 2 C) 3 (2 ^ m))) ∧
        (RankTwoTheoremC (C ⧸ pCore 2 C) →
          K = residual H ∧ C.Normal ∧
          Triality.Standard.IsTrialityGroupAt 2 (C ⧸ pCore 2 C) ∧
          ClassicalGroup.IsPSL ((pResidual 2 H) ⧸ pCore 2 (pResidual 2 H)) 2 8 ∧
          n = 2 ∧ Nat.card A = 3 ∧ A ≤ C.map Y.subtype ∧
          localBorel T L ≤ omegaCentralizer T ∧
          IsOneOrTwoA5Modules L (layer L W) ∧ Nat.card B = 7 ∧
          B ≤ centralizer
            (conjugateSpanBy (Stellmacher.omegaOneCenterAmbient (T : Subgroup G)) L : Set G)) ∧
        (∀ p : ℕ, p.Prime → Odd p →
          ¬ ClassicalGroup.IsPSL (C ⧸ pCore 2 C) 2 p) ∧
        ¬ ClassicalGroup.IsPSL (C ⧸ pCore 2 C) 2 25 ∧
        C.Normal ∧
        ¬ Nonempty ((C ⧸ pCore 2 C) ≃* Janko1.Model) ∧
        (∀ p : ℕ, p.Prime → Odd p →
          ¬ (ClassicalGroup.IsPSL (C ⧸ pCore 2 C) 3 p ∨
            ClassicalGroup.IsPSU (C ⧸ pCore 2 C) 3 p ∨
            IsSL (C ⧸ pCore 2 C) 3 p ∨ IsSU (C ⧸ pCore 2 C) 3 p)) ∧
        ¬ Nonempty ((C ⧸ pCore 2 C) ≃* Janko4.Model) ∧
        ¬ Nonempty ((C ⧸ pCore 2 C) ≃* Sporadic.Mathieu.M22) ∧
        (Nonempty ((C ⧸ pCore 2 C) ≃* Sporadic.Mathieu.M23) →
          K = residual H ∧
          ClassicalGroup.IsPSL ((pResidual 2 H) ⧸ pCore 2 (pResidual 2 H)) 2 4 ∧
          Nat.card B = 3) := by
  obtain ⟨K,hKH,hK,hqs,hKT,hKL,hR,C,hC,hKC,hlt,hn,hqlt,hsol,hternary,hrank,hprime,h25,hCn,hJ,hOdd,hJ4⟩ :=
    localCartan_escape_seed_binary_endpoint_reduction h hH hgen c hY hescape
  let : C.Normal := hCn
  exact ⟨K,hKH,hK,hqs,hKT,hKL,hR,C,hC,hKC,hlt,hn,hqlt,hsol,hternary,hrank,hprime,h25,hCn,hJ,hOdd,hJ4,
    LocalSieve.not_mathieu_twentyTwo_container h hH hgen c hKL hKT hR hY hescape C hC hKC,
    fun hm => LocalSieve.normal_mathieu_twentyTwo_twentyThree_residual_and_hall
      h hH hgen c hKL hKT hR hY hescape C hC hKC (.inr hm)⟩

end CFSG.Quasithin.Chapter6.Source.RankOneGeneric
