module
public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleRecognitionNaturalGeometryG2
public import Theory.AtlasPort.LinearGroups.SL2Order
public import Theory.GroupTheory.PCoreProduct
public import Theory.GroupTheory.NormalizedSupCard

/-!
# Parameters and indices forced by an actual escaping natural section

An abelian U lies in O₂(LT), so the same holds for the group generated by
U and its prescribed L-conjugate. Its quotient by its two-core is trivial,
contradicting a natural section with actor SL₂(4). Thus the section supplies
nonabelianness. The G.2 quotient marking then compares SL₂(2ⁿ) with this
same actor; their orders force n = 2.

The exact product R = WWˡ and intersection E = W ∩ Wˡ give
|R:E| = |W:E|², where W = C_U(V_L). Consequently the natural section of
order sixteen gives |W:E| = 4. A moving conjugate is obtained from
nonabelianness, and these deductions supply all fields of the existing
escape geometry without separate parameter, pair or index assumptions.

The actual field-four section and the initial natural action are explicit
inputs here. Their source proofs, the marked PSL₂ prime component, and
unconditional 6.1.27 remain with qt-d-1222-rankone-recognition-natural.
Source: Aschbacher–Smith, 6.1.20–21, 6.1.25(1,3) and 6.1.26,
printed pp.675–679, using G.2.3, pp.333–334.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped Pointwise
namespace CFSG.Quasithin.Chapter6.Source.RankOneRecognition
open ChapterG.Section02.RankOneHigherFields
variable {G : Type*} [Group G] [Finite G]

private theorem normalized_pair_index_square (A B E R : Subgroup G)
    (hN : B ≤ normalizer (A : Set G)) (hcard : Nat.card B = Nat.card A)
    (hE : E = A ⊓ B) (hR : R = A ⊔ B) :
    (E.relIndex A) ^ 2 = E.relIndex R := by
  have hc := card_mul_eq_card_inf_mul_card_sup_of_normalizes A B hN
  rw [← hE, ← hR, hcard] at hc
  have ha := relIndex_mul_relIndex (⊥ : Subgroup G) E A bot_le (hE ▸ inf_le_left)
  have hr := relIndex_mul_relIndex (⊥ : Subgroup G) E R bot_le
    ((hE ▸ inf_le_left : E ≤ A).trans (hR ▸ le_sup_left))
  simp only [relIndex_bot_left] at ha hr
  apply Nat.eq_of_mul_eq_mul_left (show 0 < Nat.card E * Nat.card E from Nat.mul_pos Nat.card_pos Nat.card_pos)
  calc
    (Nat.card E * Nat.card E) * E.relIndex A ^ 2 =
        (Nat.card E * E.relIndex A) * (Nat.card E * E.relIndex A) := by ring
    _ = Nat.card E * (Nat.card E * E.relIndex R) := by rw [ha, hr]; exact hc
    _ = (Nat.card E * Nat.card E) * E.relIndex R := by ring

variable {κ : GroupClass} {T : Sylow 2 G} {L M V : Subgroup G} {n : ℕ}

/-- The actual SL₂(4) actor excludes an abelian U; no moving pair is assumed. -/
theorem natural_escape_nonabelian_of_section
    (h : Hypothesis611 κ T L M V n)
    (hnatural : IsNaturalModule L (layer L V) n)
    {l : G} (hl : l ∈ L)
    (hsection : Escape.IsNaturalSectionFour (Escape.L1 (T : Subgroup G) L V l)
      (Escape.R (T : Subgroup G) L V l) (Escape.E (T : Subgroup G) L V l)) :
    ¬ Escape.U (T : Subgroup G) L V ≤ centralizer (Escape.U (T : Subgroup G) L V : Set G) := by
  intro hab
  let U := Escape.U (T : Subgroup G) L V
  let LT := L ⊔ (T : Subgroup G)
  let Q := LT.pCoreIn 2
  let J := Escape.L1 (T : Subgroup G) L V l
  have hUQ : U ≤ Q := by
    change U ≤ (L ⊔ (T : Subgroup G)).pCoreIn 2
    rw [← local_layer_centralizer_eq_core h hnatural]
    exact le_inf ((natural_escape_U_le_sylow h hnatural).trans le_sup_right)
      (hab.trans (centralizer_le (Escape.layer_le_U _ _ _)))
  have hQn : LT ≤ normalizer (Q : Set G) :=
    LT.le_normalizer.trans (normalizer_le_normalizer_characteristic_image LT (pCore 2 LT))
  have hQl : Q.map (MulAut.conj l⁻¹).toMonoidHom = Q :=
    mem_normalizer_iff_map_conj_eq.mp (hQn (mem_sup_left (L.inv_mem hl)))
  have hJQ : J ≤ Q := sup_le hUQ ((map_mono hUQ).trans_eq hQl)
  have hp : IsPGroup 2 J := (pCore_isPGroup.map LT.subtype).to_le hJQ
  have hR : Escape.R (T : Subgroup G) L V l = J := pCoreIn_eq_self_of_isPGroup 2 J hp
  obtain ⟨F, _, _, _, hF, ⟨m⟩⟩ := hsection
  let := m.R_normal
  have hc := Nat.card_congr m.actor.toEquiv
  change ((Escape.R (T : Subgroup G) L V l).subgroupOf J).index =
    Nat.card (Matrix.SpecialLinearGroup (Fin 2) F) at hc
  rw [hR,subgroupOf_self,index_top,Atlas.card_sl_two,hF] at hc
  norm_num at hc

/-- Compare the two models of the same generated quotient to recover n = 2. -/
theorem natural_escape_parameter_of_section
    (h : Hypothesis611 κ T L M V n)
    (hnatural : IsNaturalModule L (layer L V) n)
    (hE : ChapterE.Section06.HypothesisE61 κ T M (layer L V))
    (hNS : normalizer (((T : Subgroup G) ⊓
      centralizer (ZS (T : Subgroup G) L V : Set G) : Subgroup G) : Set G) ≤ M)
    {l : G} (hl : l ∈ L) (hlout : l ∉ Escape.H (T : Subgroup G) L V)
    (hsection : Escape.IsNaturalSectionFour (Escape.L1 (T : Subgroup G) L V l)
      (Escape.R (T : Subgroup G) L V l) (Escape.E (T : Subgroup G) L V l)) : n = 2 := by
  let D := naturalEscapeSetup (T : Subgroup G) L V
  let J := Escape.L1 (T : Subgroup G) L V l
  obtain ⟨F, _, _, ⟨d⟩⟩ := natural_escape_G2_marking h hnatural hE hNS
    (natural_escape_nonabelian_of_section h hnatural hl hsection) hl hlout
  obtain ⟨hU,hI,hR,hE'⟩ := natural_escape_G2_constructions h hE hNS l
  have hut : D.U ≤ D.T := by rw [hU]; exact natural_escape_U_le_sylow h hnatural
  have hf := (natural_escape_G2_hypothesis h hnatural).frattini_U_le_point
  have he := Nat.card_congr (d.generatedCoreQuotientEquiv hut hf).toEquiv
  change Nat.card (D.I l ⧸ pCore 2 (D.I l)) = Nat.card (Matrix.SpecialLinearGroup (Fin 2) F) at he
  rw [hI] at he
  obtain ⟨k, _, _, _, hk, ⟨m⟩⟩ := hsection
  let := m.R_normal
  have hkernel : (Escape.R (T : Subgroup G) L V l).subgroupOf J = pCore 2 J :=
    (pCore 2 J).comap_map_eq_self_of_injective J.subtype_injective
  have ha : Nat.card (J ⧸ pCore 2 J) = 60 := by
    calc
      Nat.card (J ⧸ pCore 2 J) = Nat.card (J ⧸ (Escape.R (T : Subgroup G) L V l).subgroupOf J) :=
        Nat.card_congr (QuotientGroup.quotientMulEquivOfEq hkernel.symm).toEquiv
      _ = Nat.card (Matrix.SpecialLinearGroup (Fin 2) k) := Nat.card_congr m.actor.toEquiv
      _ = 60 := by rw [Atlas.card_sl_two,hk]; norm_num
  have hc : 2 ^ n * ((2 ^ n) ^ 2 - 1) = 60 := by
    rw [← d.field_card, ← Atlas.card_sl_two, ← he]
    exact ha
  have hlow : 4 ≤ 2 ^ n := by
    change 2 ^ 2 ≤ 2 ^ n
    exact Nat.pow_le_pow_right (by decide : 0 < 2) h.n_gt_one
  have hupp : 2 ^ n ≤ 4 := by
    by_contra! hh
    have hm : 5 * 24 ≤ 2 ^ n * ((2 ^ n) ^ 2 - 1) :=
      Nat.mul_le_mul (by omega) (by
        have hs : 5 ^ 2 ≤ (2 ^ n) ^ 2 := Nat.pow_le_pow_left (by omega) 2
        omega)
    omega
  apply Nat.pow_right_injective (by decide : 2 ≤ 2)
  change 2 ^ n = 4
  omega


/-- The literal conjugate product and intersection determine the square of the marked index. -/
theorem natural_escape_core_index_square
    (h : Hypothesis611 κ T L M V n)
    (hnatural : IsNaturalModule L (layer L V) n)
    (hE : ChapterE.Section06.HypothesisE61 κ T M (layer L V))
    (hNS : normalizer (((T : Subgroup G) ⊓
      centralizer (ZS (T : Subgroup G) L V : Set G) : Subgroup G) : Set G) ≤ M)
    (hnon : ¬ Escape.U (T : Subgroup G) L V ≤
      centralizer (Escape.U (T : Subgroup G) L V : Set G))
    {l : G} (hl : l ∈ L) (hlout : l ∉ Escape.H (T : Subgroup G) L V) :
    ((Escape.E (T : Subgroup G) L V l).relIndex
      (Escape.U (T : Subgroup G) L V ⊓ centralizer (layer L V : Set G))) ^ 2 =
      (Escape.E (T : Subgroup G) L V l).relIndex (Escape.R (T : Subgroup G) L V l) := by
  let D := naturalEscapeSetup (T : Subgroup G) L V
  obtain ⟨F, _, _, ⟨d⟩⟩ := natural_escape_G2_marking h hnatural hE hNS hnon hl hlout
  obtain ⟨hU,hI,hR,hE'⟩ := natural_escape_G2_constructions h hE hNS l
  have hut : D.U ≤ D.T := by rw [hU]; exact natural_escape_U_le_sylow h hnatural
  have hf := (natural_escape_G2_hypothesis h hnatural).frattini_U_le_point
  have hstar := d.star_I_eq_star_L hut hf
  have hW : D.W l = Escape.U (T : Subgroup G) L V ⊓ centralizer (layer L V : Set G) := by
    change D.U ⊓ D.S l = _
    rw [d.S_eq_star_kernel hut hf, ← inf_assoc,
      inf_eq_left.mpr (show D.U ≤ D.I l from le_sup_left)]
    change D.U ⊓ (L ⊔ (T : Subgroup G)).pCoreIn 2 = _
    rw [← local_layer_centralizer_eq_core h hnatural, ← inf_assoc,
      inf_eq_left.mpr (show D.U ≤ L ⊔ (T : Subgroup G) from hut.trans le_sup_right), hU]
  have hprod := d.S_eq_WProduct_of_source hut hf
  have hS : ChapterG.Section02.Setup.conjugate (D.W l) l ≤ D.S l := by
    rw [hprod]
    exact le_sup_right
  have he := normalized_pair_index_square (D.W l)
    (ChapterG.Section02.Setup.conjugate (D.W l) l) (D.S₂ l) (D.S l)
    (hS.trans (d.S_normalizes_W_of_star hut hstar.ge))
    (card_map_of_injective (MulAut.conj l⁻¹).injective)
    (D.binary_marked_intersection l (d.g_mem_I hut hf) (d.intersection hut hf).2.1)
    hprod
  rwa [hE',hR,hW] at he

/-- The genuine natural section has order sixteen, forcing the marked index to be four. -/
theorem natural_escape_section_index
    (h : Hypothesis611 κ T L M V n)
    (hnatural : IsNaturalModule L (layer L V) n)
    (hE : ChapterE.Section06.HypothesisE61 κ T M (layer L V))
    (hNS : normalizer (((T : Subgroup G) ⊓
      centralizer (ZS (T : Subgroup G) L V : Set G) : Subgroup G) : Set G) ≤ M)
    {l : G} (hl : l ∈ L) (hlout : l ∉ Escape.H (T : Subgroup G) L V)
    (hsection : Escape.IsNaturalSectionFour (Escape.L1 (T : Subgroup G) L V l)
      (Escape.R (T : Subgroup G) L V l) (Escape.E (T : Subgroup G) L V l)) :
    (Escape.E (T : Subgroup G) L V l).relIndex
      (Escape.U (T : Subgroup G) L V ⊓ centralizer (layer L V : Set G)) = 4 := by
  have hnon := natural_escape_nonabelian_of_section h hnatural hl hsection
  have hsquare := natural_escape_core_index_square h hnatural hE hNS hnon hl hlout
  obtain ⟨F, _, _, _, hF, ⟨m⟩⟩ := hsection
  let := m.E_normal
  have hcard : (Escape.E (T : Subgroup G) L V l).relIndex
      (Escape.R (T : Subgroup G) L V l) = 16 := by
    change Nat.card ((Escape.R (T : Subgroup G) L V l) ⧸
      (Escape.E (T : Subgroup G) L V l).subgroupOf (Escape.R (T : Subgroup G) L V l)) = 16
    rw [Nat.card_congr m.vectors.toEquiv]
    change Nat.card (Fin 2 → F) = 16
    rw [Nat.card_fun, Nat.card_fin, hF]
    norm_num
  rw [hcard] at hsquare
  nlinarith

/-- Recover the parameter and complete escape geometry from the actual natural section. The moving pair and index are constructed. -/
theorem natural_escape_geometry_of_natural_section
    (h : Hypothesis611 κ T L M V n)
    (hnatural : IsNaturalModule L (layer L V) n)
    (hE : ChapterE.Section06.HypothesisE61 κ T M (layer L V))
    (hs : letI := h.layer_elementary; ChapterE.globalS (layer L V) = n)
    (hNS : normalizer (((T : Subgroup G) ⊓
      centralizer (ZS (T : Subgroup G) L V : Set G) : Subgroup G) : Set G) ≤ M)
    {l : G} (hl : l ∈ L) (hlout : l ∉ Escape.H (T : Subgroup G) L V)
    (hsection : Escape.IsNaturalSectionFour (Escape.L1 (T : Subgroup G) L V l)
      (Escape.R (T : Subgroup G) L V l) (Escape.E (T : Subgroup G) L V l)) :
    n = 2 ∧ Nonempty (NaturalEscape.Geometry (T : Subgroup G) L V) := by
  have hn := natural_escape_parameter_of_section h hnatural hE hNS hl hlout hsection
  subst n
  refine ⟨rfl, ?_⟩
  have hnon := natural_escape_nonabelian_of_section h hnatural hl hsection
  obtain ⟨g,hg,hmove⟩ := natural_escape_exists_pair hnon
  exact natural_escape_geometry_of_section h hnatural hE hs hNS
    ((Escape.I (T : Subgroup G) L V).inv_mem hg) hl hlout
    (by simpa only [inv_inv] using hmove) hsection
    (natural_escape_section_index h hnatural hE hNS hl hlout hsection)

end CFSG.Quasithin.Chapter6.Source.RankOneRecognition
