module

public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleNaturalFixedQuotientDoubled
public import Theory.GroupTheory.ConjugateSpanNormalizer
public import Theory.GroupTheory.Commutator.NormalizedIndexTwo
public import Theory.GroupTheory.PResidual.SubnormalCoreAction

/-!
# One invariant natural constituent forces large weak-closure rank

A hyperplane of a module generated by its L-commutators generates the whole
module under L: otherwise its orbit span has index two and L acts trivially
on that quotient. The natural constituent has global rank greater than one,
so the hyperplane centralizer lies in its normalizer, hence in M. It then
normalizes L and the hyperplane's orbit span, namely the original module.

Thus one Sylow-invariant natural constituent suffices for the rank bound;
no complementary summand or whole-module decomposition is assumed.
Source: the hyperplane contradiction in Aschbacher–Smith 6.1.4, pp.664–665.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter6.Source.RankOneRecognition
variable {G : Type*} [Group G] [Finite G]

private theorem hyperplane_generates_moved
    {L V U : Subgroup G} (hn : L ≤ normalizer (V : Set G))
    (hmoved : ⁅V,L⁆ = V) (hUV : U ≤ V) (hindex : U.relIndex V = 2) :
    conjugateSpanBy U L = V := by
  let P := conjugateSpanBy U L
  have hPV : P ≤ V := conjugateSpanBy_le hUV hn
  have hUP : U ≤ P := le_conjugateSpanBy _ _
  have hi : P.relIndex V ≤ 2 :=
    (relIndex_le_of_le_left hUP index_ne_zero_of_finite).trans_eq hindex
  have hpos : P.relIndex V ≠ 0 := index_ne_zero_of_finite
  rcases (show P.relIndex V = 1 ∨ P.relIndex V = 2 by omega) with he | he
  · exact le_antisymm hPV (relIndex_eq_one.mp he)
  · have hm := commutator_le_of_normalized_index_two V P L hPV he hn
      (le_normalizer_conjugateSpanBy _ _)
    exact le_antisymm hPV (hmoved ▸ hm)

/-- A single Sylow-invariant natural sublayer forces global rank greater
than one on the entire original moved layer. -/
theorem original_natural_seed_one_lt_globalR
    {T : Sylow 2 G} {L M V B : Subgroup G} {n : ℕ}
    (h : Hypothesis611 KnownSimple.IsKnownSimple T L M V n)
    (hB : B ≤ layer L V) (hnatural : IsNaturalModule L B n)
    (hTB : (T : Subgroup G) ≤ normalizer (B : Set G)) :
    1 < ChapterE.globalR (layer L V) := by
  let := h.layer_elementary
  let : IsElementaryAbelian 2 B := IsElementaryAbelian.of_le hB
  have hML : M ≤ normalizer (L : Set G) :=
    (normal_subgroupOf_iff_le_normalizer h.L_le).mp h.L_normal
  have hE := natural_sublayer_hypothesisE61 h hB hnatural hTB
  have hrB := natural_one_lt_globalR h.n_gt_one hnatural
    (hE.normalizer_le.trans hML) h.L_le hE
  apply lt_of_le_of_ne (ChapterE.one_le_globalR (layer L V))
  intro he
  obtain ⟨U,hUV,hescape,hcor⟩ := ChapterE.Section06.globalR_attained
    (by rw [←he]; exact ENat.one_ne_top)
  have hU : ChapterE.subgroupCorank (layer L V) U = 1 := by
    exact_mod_cast hcor.trans he.symm
  have hindex : U.relIndex (layer L V) = 2 := by
    rw [Subgroup.relIndex_eq_two_pow_quotient_finrank,
      ←ChapterE.subgroupCorank_eq_quotient_finrank,hU]
    rfl
  have hcorB : ChapterE.subgroupCorank B (U ⊓ B) ≤ 1 := by
    unfold ChapterE.subgroupCorank
    rw [inf_relIndex_right]
    exact (Nat.log_mono_right
      (relIndex_le_of_le_right hB index_ne_zero_of_finite)).trans_eq hU
  have hCB : centralizer (U : Set G) ≤ normalizer (B : Set G) :=
    (centralizer_le inf_le_left).trans
      (ChapterE.centralizer_le_normalizer_of_corank_lt_globalR inf_le_right
        (lt_of_le_of_lt (by exact_mod_cast hcorB) hrB))
  have hCL : centralizer (U : Set G) ≤ normalizer (L : Set G) :=
    hCB.trans (hE.normalizer_le.trans hML)
  have hLlayer : L ≤ normalizer (layer L V : Set G) :=
    normalizer_commutator_ge_right V L
  have hmoved : ⁅layer L V,L⁆ = layer L V := by
    let := h.V_mem.2.1
    exact commutator_isPPerfect_idempotent L V
      h.local_mem.2.2.1
      (IsElementaryAbelian.isPGroup 2 V)
      (le_sup_left.trans (reduced_normalizes h.V_mem))
  apply hescape
  rw [←hyperplane_generates_moved hLlayer hmoved hUV hindex]
  exact normalizes_conjugateSpanBy U L (centralizer (U : Set G))
    (Subgroup.centralizer_le_normalizer _) hCL

end CFSG.Quasithin.Chapter6.Source.RankOneRecognition
