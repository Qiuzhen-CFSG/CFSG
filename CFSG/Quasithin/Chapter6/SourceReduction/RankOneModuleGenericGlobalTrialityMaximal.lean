module
public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleGenericGlobalBlockMaximal

/-!
# Right maximality in the triality row of 5.2.8

Let K = O²(H). The actual triality comparison puts the original S in K,
so O₂(H) = O₂(K). If K ≤ J ∈ L(G,T), subnormality of J in JT and the
full ambient Sylow give O₂(J) ≤ O₂(K). Characteristic two in J prevents
K from centralizing O₂(J). A proper such core would therefore give two
noncentral chief layers in O₂(K), since this core is generated by its
commutators with K. The checked triality arms bound excludes two layers.

Thus every local overcomponent has exactly the original special core.
The binary embedding theorem then forces the right quotient exponent
to be two for a proper overcomponent. Its actual exponent is 3n, so K is
maximal. Both compatible orientations are handled: the arms-left one is
excluded by the original faithful left action. The final normalizer
application discharges maximality, the common Sylow and both enlarged
cores, with S = O₂(N_G(L) ∩ H) and the whole overlap unchanged.

This completes the triality row of 5.2.8. The other nonblock maximality
rows, exhaustive F.1.12 comparison, original uniqueness and ambient
completion recognition remain obligations. No ambient model isomorphism
is inferred from the local comparison.
Source: Aschbacher–Smith 5.2.8, printed pp.652–653; A.3.12–14, pp.47–50;
and F.1.12(I)(4), pp.262–264 (`refs/quasithin.pdf`).
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter6.Source.RankOneGeneric.Global
variable {G : Type*} [Group G] [Finite G]

private theorem single_layer_residual_overcomponent_core
    {T : Sylow 2 G} {H J : Subgroup G}
    (hE : IsEvenCharacteristicAt T) (hTH : (T : Subgroup G) ≤ H)
    (hcore : H.pCoreIn 2 = (residual H).pCoreIn 2)
    (hp : Group.IsPerfect (residual H)) (hne : residual H ≠ ⊥)
    (hmove : ⁅pCore 2 (residual H), (⊤ : Subgroup (residual H))⁆ = pCore 2 (residual H))
    (hlayer : ∀ N : Subgroup (residual H), ¬ NoncentralCoreLayer N)
    (hJ : J ∈ Chapter1.L G (T : Subgroup G)) (hKJ : residual H ≤ J) :
    J.pCoreIn 2 = (residual H).pCoreIn 2 := by
  have hHJ : H ≤ J ⊔ (T : Subgroup G) := by
    rw [← residual_sup_sylow T H hTH]
    exact sup_le_sup hKJ le_rfl
  have hle : J.pCoreIn 2 ≤ (residual H).pCoreIn 2 :=
    (pCoreAmbient_mono_of_isSubnormalIn J (J ⊔ (T : Subgroup G)) 2
      le_sup_left hJ.1.subnormal).trans
        ((Chapter3.twoCore_le_of_sylow_le T hTH hHJ).trans_eq hcore)
  have hRK : J.pCoreIn 2 ≤ residual H := hle.trans (map_subtype_le _)
  let N := (J.pCoreIn 2).subgroupOf (residual H)
  have hn : N.Normal := normal_subgroupOf_of_le_normalizer
    (hKJ.trans (J.le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image J (pCore 2 J))))
  have hN : N ≤ pCore 2 (residual H) := by
    intro x hx
    have hh := hle hx
    exact (mem_map_iff_mem (residual H).subtype_injective).mp hh
  have hnot : ¬ N ≤ center (residual H) := by
    intro hc
    have hchar := Chapter1.mem_He_iff.mpr
      (Chapter1.Section02.Adequate.mem_L_hasCharacteristicTwo T hE hJ)
    have hKR : residual H ≤ J.pCoreIn 2 := by
      intro k hk
      apply hchar
      refine ⟨hKJ hk,mem_centralizer_iff.mpr ?_⟩
      intro r hr
      exact congrArg Subtype.val
        (mem_center_iff.mp (hc (show (⟨r,hRK hr⟩ : residual H) ∈ N from hr)) ⟨k,hk⟩).symm
    let := hp
    let : Nontrivial (residual H) := (nontrivial_iff_ne_bot _).mpr hne
    exact Group.IsPerfect.not_isNilpotent (residual H)
      ((isPGroup_pCoreIn 2 J).to_le hKR).isNilpotent
  have he : N = pCore 2 (residual H) := by
    apply le_antisymm hN
    by_contra hh
    exact hlayer N ⟨hn,hN,hnot,by rwa [hmove]⟩
  apply le_antisymm hle
  rintro _ ⟨x,hx,rfl⟩
  exact (show x ∈ N from he.symm ▸ hx)

open _root_.Triality.Standard _root_.Triality.Standard.Parabolics in
private theorem triality_core_generated
    {X : Type*} [Group X] [Finite X]
    (m : ℕ) (hm : 1 < m)
    (a : X ≃* localFactor (binaryParameters m (by omega)) .arms) :
    ⁅pCore 2 X, (⊤ : Subgroup X)⁆ = pCore 2 X := by
  let P := binaryParameters m (by omega)
  have hh : ⁅pCore 2 (localFactor P .arms), (⊤ : Subgroup (localFactor P .arms))⁆ =
      pCore 2 (localFactor P .arms) := by
    apply map_injective (localFactor P .arms).subtype_injective
    rw [localFactor_core_commutator_map P rfl
      (Nat.pow_lt_pow_right (by decide : 1 < (2 : ℕ)) hm),localFactor_twoCore_map P rfl]
  apply map_injective (f := a.toMonoidHom) a.injective
  rw [map_commutator,pCore_map_iso,map_top_of_surjective a.toMonoidHom a.surjective]
  exact hh

/-- The actual triality arms factor has the same two-core as every local
overcomponent. No abelianness of this special core is assumed. -/
theorem Preparation.triality_overcomponent_core
    {T : Sylow 2 G} {L W H A B J : Subgroup G} {n : ℕ}
    (d : Preparation T L H A B (residual H))
    (h : Input KnownSimple.IsKnownSimple T L W n)
    (hTH : (T : Subgroup G) ≤ H) (hp : Group.IsPerfect (residual H))
    (m : ℕ) (hm : 0 < m)
    (he : Nonempty (RankTwoAmalgam.Iso
        (sourceParabolicAmalgam ![L,residual H] (sourceS L H))
        (ChapterF.GreenBook.LieModels.Triality.amalgam (_root_.Triality.Standard.binaryParameters m hm))) ∨
      Nonempty (RankTwoAmalgam.Iso
        (sourceParabolicAmalgam ![L,residual H] (sourceS L H))
        (ChapterF.GreenBook.LieModels.Triality.amalgam (_root_.Triality.Standard.binaryParameters m hm)).reverse))
    (hJ : J ∈ Chapter1.L G (T : Subgroup G)) (hKJ : residual H ≤ J) :
    J.pCoreIn 2 = (residual H).pCoreIn 2 := by
  have hS := d.triality_sourceS_le_factors h hTH hp m hm he 1
  have hcore := residual_core_eq_of_sourceS_le h.sylow_normalizes hTH hS
  rcases he with he | he
  · exact (d.not_triality_arms_left_amalgam h hTH hp _ rfl he).elim
  · obtain ⟨e⟩ := he
    have hm' := d.triality_parameter_gt_one h hp m hm e
    obtain ⟨_,⟨a⟩⟩ := d.triality_factor_equivs h hTH hp m hm e
    let := hp
    apply single_layer_residual_overcomponent_core (h.qtke.evenCharacteristic T) hTH hcore hp
      (fun hh => d.right_outside (hh ▸ bot_le)) (triality_core_generated m hm' a) ?_ hJ hKJ
    intro N hN
    exact TrialityComparison.arms_no_two_layers hN m hm a

/-- Every triality comparison has maximal right residual: its binary quotient
exponent is 3n, which cannot be the exceptional exponent two. -/
theorem Preparation.triality_right_maximal
    {T : Sylow 2 G} {L W H A B : Subgroup G} {n : ℕ}
    (d : Preparation T L H A B (residual H))
    (h : Input KnownSimple.IsKnownSimple T L W n)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hp : Group.IsPerfect (residual H)) (m : ℕ) (hm : 0 < m)
    (he : Nonempty (RankTwoAmalgam.Iso
        (sourceParabolicAmalgam ![L,residual H] (sourceS L H))
        (ChapterF.GreenBook.LieModels.Triality.amalgam (_root_.Triality.Standard.binaryParameters m hm))) ∨
      Nonempty (RankTwoAmalgam.Iso
        (sourceParabolicAmalgam ![L,residual H] (sourceS L H))
        (ChapterF.GreenBook.LieModels.Triality.amalgam (_root_.Triality.Standard.binaryParameters m hm)).reverse)) :
    residual H ∈ Chapter1.LStar G (T : Subgroup G) := by
  have hTH := hH.1.1.2
  have hcore (J : Subgroup G) (hJ : J ∈ Chapter1.L G (T : Subgroup G))
      (hKJ : residual H ≤ J) := d.triality_overcomponent_core h hTH hp m hm he hJ hKJ
  rcases he with he | he
  · exact (d.not_triality_arms_left_amalgam h hTH hp _ rfl he).elim
  · obtain ⟨e⟩ := he
    have hbinary := (d.triality_local_structure h hTH hp m hm e).2.2.2.2.1
    have hn := h.exponent
    exact residual_binary_maximal_of_overcomponent_core h.qtke hH.1.1 hp
      (by omega : 1 < 3*n) (by omega) hbinary hcore

/-- The triality normalizer pair satisfies the local hypotheses for 5.3,
with maximality, the common Sylow and both enlarged cores discharged. -/
theorem Preparation.triality_normalizer_local_conditions
    {T : Sylow 2 G} {L W H A B : Subgroup G} {n : ℕ}
    (d : Preparation T L H A B (residual H))
    (h : Input KnownSimple.IsKnownSimple T L W n)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hp : Group.IsPerfect (residual H)) (m : ℕ) (hm : 0 < m)
    (he : Nonempty (RankTwoAmalgam.Iso
        (sourceParabolicAmalgam ![L,residual H] (sourceS L H))
        (ChapterF.GreenBook.LieModels.Triality.amalgam (_root_.Triality.Standard.binaryParameters m hm))) ∨
      Nonempty (RankTwoAmalgam.Iso
        (sourceParabolicAmalgam ![L,residual H] (sourceS L H))
        (ChapterF.GreenBook.LieModels.Triality.amalgam (_root_.Triality.Standard.binaryParameters m hm)).reverse)) :
    Chapter5.Section03GreenExtension.SourceLocalConditions
      (normalizerAmalgam L (residual H)) L (residual H) ((T : Subgroup G) ⊓ L) := by
  have hc : ConcreteAmalgamComparison
      (sourceParabolicAmalgam ![L,residual H] (sourceS L H)) := .triality m hm he
  exact d.normalizer_local_conditions h hH (d.triality_right_maximal h hH hp m hm he) rfl
    (d.common_sylow_of_comparison h hH.1.1.2 hp hc)
    (d.parabolic_sylow_core_eq_of_comparison h hH.1.1.2 hp hc)

end CFSG.Quasithin.Chapter6.Source.RankOneGeneric.Global
