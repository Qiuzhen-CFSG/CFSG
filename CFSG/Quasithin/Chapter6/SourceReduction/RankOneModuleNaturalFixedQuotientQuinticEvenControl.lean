module

public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleNaturalFixedQuotientQuinticCentralCarrier
public import CFSG.Quasithin.Chapter1.Section03.Embeddings.InvariantLarge.A315Source.EvenSource
public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleGenericGlobalLocalCartan
public import Theory.GroupTheory.TwoPerfectSylowAction

/-!
# Literal Sylow control for the nonbinary even component rows

Solvable Sylow control on (K/O₂(K))/Z lifts first through its central kernel,
then through the actual two-core. The original solvable group generated by
X and T∩N_G(K) contains T∩K and normalizes K, so it normalizes T∩K.
The five nonbinary rank-two models supply this control from their root
geometry. Their actual field-two endpoints, including Tits, remain explicit.
The conclusion concerns the original component intersection; normalization
of the entire component orbit is a separate group-theoretic step.

Source: Aschbacher--Smith A.3.15(5)--(7), pp.50--51, and 6.1.4, p.665.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher
open scoped MatrixGroups
namespace CFSG.Quasithin.Chapter6.Source.RankOneRecognition
open RankOneGeneric
open Chapter1.Section02.LocalModels
open Chapter1.XiEmbedding.InvariantLarge
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L M V M₁ K : Subgroup G} {n : ℕ}
attribute [local instance] Representation.SL2.BinarySmall.spaceBinaryModule

/-- Both literal quotient maps preserve solvable Sylow control upwards. -/
theorem component_sylow_control_of_core_central_control
    (K : Subgroup G) (hc : SolvableSylowControl 2 (coreCentralQuotient K)) :
    SolvableSylowControl 2 K := by
  have hq : SolvableSylowControl 2 (K ⧸ pCore 2 K) :=
    SolvableSylowControl.of_surjective_central_kernel
      (QuotientGroup.mk' (center (K ⧸ pCore 2 K))) (QuotientGroup.mk'_surjective _)
      (by rw [QuotientGroup.ker_mk']) hc
  exact SolvableSylowControl.of_surjective_pKernel
    (QuotientGroup.mk' (pCore 2 K)) (QuotientGroup.mk'_surjective _)
    (by rw [QuotientGroup.ker_mk']; exact pCore_isPGroup) hq

/-- Actual model geometry gives control or retains one of the five literal
field-two exceptions. In particular, no Tits normalization is inferred. -/
theorem rankTwo_sylow_control_or_small
    {C : Type*} [Group C] [Finite C] (hm : RankTwoTheoremC C) :
    SolvableSylowControl 2 C ∨ A315Source.SmallRankTwoModel C := by
  cases hm with
  | linear d hd hm =>
    by_cases he : d=1
    · exact Or.inr (Or.inl (by simpa only [he,pow_one] using hm))
    · obtain ⟨F,_,_,hF,⟨e⟩⟩ := hm
      exact Or.inl (SolvableSylowControl.of_equiv e (A315Source.linear_control hF (by omega)))
  | symplectic d hd hm =>
    obtain ⟨F,_,_,hF,⟨e⟩⟩ := hm
    let : CharP F 2 := Theory.SpecificGroups.SymplecticFour.EvenProjective.charTwo_of_card hF
    exact Or.inl (SolvableSylowControl.of_equiv
      (e.trans Theory.SpecificGroups.SymplecticFour.EvenProjective.equiv.symm)
      (A315Source.symplectic_control hF (by omega)))
  | g2 d hd hm =>
    obtain ⟨F,_,_,hF,⟨e⟩⟩ := hm
    let : CharP F 2 := Theory.SpecificGroups.SymplecticFour.EvenProjective.charTwo_of_card hF
    have hlarge : 2 < Nat.card F := by
      rw [hF]
      exact (show 2^1 < 2^d from Nat.pow_lt_pow_right (by decide) (by omega))
    exact Or.inl (SolvableSylowControl.of_equiv e (A315Source.g2_control hlarge))
  | triality d hd hm =>
    by_cases he : d=1
    · exact Or.inr (Or.inr (Or.inl (by simpa only [he,pow_one] using hm)))
    · obtain ⟨P,hq,⟨e⟩⟩ := hm
      have hp := P.eq_binaryParameters_of_q_eq d (by omega) hq
      have hp2 : P.prime = 2 := congrArg Triality.Standard.Parameters.prime hp
      have hlarge : 2 < P.q := by
        rw [hq]
        exact (show 2^1 < 2^d from Nat.pow_lt_pow_right (by decide) (by omega))
      exact Or.inl (SolvableSylowControl.of_equiv e (A315Source.triality_control P hp2 hlarge))
  | ree m hm he =>
    obtain ⟨d,⟨e⟩⟩ := he
    exact Or.inl (SolvableSylowControl.of_equiv (e.trans d.modelEquiv)
      (A315Source.ree_control m hm))
  | symplectic_derived he => exact Or.inr (Or.inr (Or.inr (Or.inl he)))
  | g2_derived he => exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inl he))))
  | tits he => exact Or.inr (Or.inr (Or.inr (Or.inr (Or.inr he))))

/-- A proved intrinsic control statement gives normalization of the original
component Sylow by the literal quintic residual. -/
theorem original_hermitian_quintic_normalizes_component_sylow_of_control
    (h : Hypothesis611 KnownSimple.IsKnownSimple T L M V n)
    (hout : Chapter3.HasMaximalOutside T M)
    (hm : IsConjugationModel L (reducedSubgroup (L ⊔ (T : Subgroup G)))
      (Representation.SL2.BinarySmall.hermitian 2))
    (hM₁ : IsMaximalTwoLocal M₁) (hCM₁ : omegaCentralizer T ≤ M₁)
    (hK : K ∈ Chapter1.cComponentsIn M₁)
    (hc : SolvableSylowControl 2 (coreCentralQuotient K)) :
    quinticResidual T L ≤ normalizer (((T : Subgroup G) ⊓ K) : Set G) := by
  let X := quinticResidual T L
  let T₀ := (T : Subgroup G) ⊓ normalizer (K : Set G)
  let A := X ⊔ T₀
  have hi := h.rankOneInput hout
  let : Group.IsSolvable (localBorel T L) :=
    localBorel_isSolvable hi.exponent hi.linear hi.sylow_normalizes
  have hXB : X ≤ localBorel T L := map_subtype_le _
  let : Group.IsSolvable X := Group.isSolvable_of_isSolvable_injective (inclusion_injective hXB)
  let : Group.IsNilpotent T₀ := (T.isPGroup'.to_le (show T₀ ≤ (T : Subgroup G) from inf_le_left)).isNilpotent
  let : Group.IsSolvable A := Group.isSolvable_sup_of_normalizes X T₀
    (inf_le_left.trans (sylow_normalizes_quinticResidual hi.sylow_normalizes))
  have hTM₁ : (T : Subgroup G) ≤ M₁ := sylow_le_omegaCentralizer.trans hCM₁
  have hT : Chapter1.IsSylowIn 2 (T : Subgroup G) M₁ :=
    ⟨T.subtype hTM₁,map_subgroupOf_eq_of_le hTM₁⟩
  obtain ⟨U,hU⟩ := Chapter1.Section02.IndexTwo.isSylowIn_inf_of_subnormal hT hK.1 hK.2.subnormal
  have hAN : A ≤ normalizer (K : Set G) :=
    sup_le (original_hermitian_quintic_normalizes_component h hout hm hM₁ hCM₁ hK) inf_le_right
  have hUA : (U : Subgroup K).map K.subtype ≤ A := by
    rw [hU]
    exact (le_inf inf_le_left (inf_le_right.trans K.le_normalizer)).trans le_sup_right
  have hn := (component_sylow_control_of_core_central_control K hc).normalizes_sylow K A U hAN hUA
  rw [hU] at hn
  exact le_sup_left.trans hn

/-- The actual rank-two component row normalizes T∩K unless its literal
simple carrier is one of the explicitly retained field-two endpoints. -/
theorem original_hermitian_quintic_component_sylow_or_small_rankTwo
    (h : Hypothesis611 KnownSimple.IsKnownSimple T L M V n)
    (hout : Chapter3.HasMaximalOutside T M)
    (hm : IsConjugationModel L (reducedSubgroup (L ⊔ (T : Subgroup G)))
      (Representation.SL2.BinarySmall.hermitian 2))
    (hM₁ : IsMaximalTwoLocal M₁) (hCM₁ : omegaCentralizer T ≤ M₁)
    (hK : K ∈ Chapter1.cComponentsIn M₁)
    (hc : RankTwoTheoremC (coreCentralQuotient K)) :
    quinticResidual T L ≤ normalizer (((T : Subgroup G) ⊓ K) : Set G) ∨
      A315Source.SmallRankTwoModel (coreCentralQuotient K) := by
  exact (rankTwo_sylow_control_or_small hc).imp_left fun hcontrol =>
    original_hermitian_quintic_normalizes_component_sylow_of_control
      h hout hm hM₁ hCM₁ hK hcontrol

end CFSG.Quasithin.Chapter6.Source.RankOneRecognition
