/-!
# The canonical residual of the original single escape factor

The single factor X in the central-line normalizer quotient has no cubic
in its relative centralizer. Otherwise the original outside cubic fixes
nontrivial three-elements in both commuting factors, giving three-rank at
least three. The actual S₃, L₃(2), and S₅ models are centerless, have
2-group outer automorphisms, and satisfy O²(X) = O^{3′}(X). The outer action
and centralizer bound therefore make X have index prime to three in the
centralizer image and identify its embedded residual with O^{3′} of that
image.

The original quotient has 2-group kernel. Two-perfectness of O^{3′}(I)
lifts the image equality to O²(P) = O^{3′}(I), retaining the original
inclusions and the same W/Z_S action witness. Characteristicity then proves
that all of N_G(Z_S), and hence T, normalizes this original residual.
No normalization of P itself is inferred from residual normalization.

Source: Aschbacher–Smith, 6.1.19, printed p.675, the canonical-residual
step immediately before the invariant parabolic. The parabolic and amalgam
contradiction, initial 6.1.4–5, omega escape, and the remaining geometry
still belong to qt-d-1222-rankone-recognition-natural, which retains final
assembly of unconditional 6.1.27.
-/

public noncomputable section
set_option backward.isDefEq.respectTransparency false
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative Classical
namespace CFSG.Quasithin.Chapter6.Source.RankOneRecognition.NaturalCanonicalResidual
variable {A : Type*} [Group A] [Finite A]

omit [Finite A] in
private theorem center_transport {B : Type*} [Group B] (e : A ≃* B)
    (hz : center B = ⊥) : center A = ⊥ := by
  apply eq_bot_iff.mpr
  intro z hzA
  have hh : e z ∈ center B := (centerCongr e ⟨z,hzA⟩).property
  rw [hz] at hh
  exact e.map_eq_one_iff.mp hh

private theorem outer_two_of_inner {B : Type*} [Group B]
    (h : Function.Surjective (MulAut.conj : B →* MulAut B)) :
    IsPGroup 2 (MulAut.Outer B) := by
  have ht : MulAut.innerSubgroup B = ⊤ := MonoidHom.range_eq_top.mpr h
  intro x
  refine ⟨0, ?_⟩
  obtain ⟨a,rfl⟩ := QuotientGroup.mk'_surjective (MulAut.innerSubgroup B) x
  change QuotientGroup.mk a = 1
  exact (QuotientGroup.eq_one_iff a).mpr (ht ▸ mem_top a)

omit [Finite A] in
private theorem quotient_two_transport {B : Type*} [Group B] (e : A ≃* B)
    (h : ∀ (N : Subgroup B) [N.Normal], N ≠ ⊥ → IsPGroup 2 (B ⧸ N))
    (N : Subgroup A) [N.Normal] (hn : N ≠ ⊥) : IsPGroup 2 (A ⧸ N) := by
  let D := N.map e.toMonoidHom
  let : D.Normal := Normal.map inferInstance _ e.surjective
  have hd : D ≠ ⊥ := fun hd => hn ((N.map_eq_bot_iff_of_injective e.injective).mp hd)
  exact (h D hd).of_equiv (QuotientGroup.congr N D e rfl).symm

private theorem residual_eq_of_normal_quotients
    (hdiv : 3 ∣ Nat.card A)
    (h : ∀ (N : Subgroup A) [N.Normal], N ≠ ⊥ → IsPGroup 2 (A ⧸ N)) :
    pResidual 2 A = primeToResidual 3 A := by
  apply le_antisymm _ primeToResidual_three_le_twoResidual
  have hn : primeToResidual 3 A ≠ ⊥ := by
    intro he
    have hc := primeToResidual_index_coprime (G:=A) 3
    rw [he,index_bot] at hc
    exact Nat.prime_three.coprime_iff_not_dvd.mp hc hdiv
  exact sInf_le ⟨inferInstance,h _ hn⟩

/-- The three actual factor groups are centerless with two-group outer group,
and their two-residual is generated by their three-elements. -/
theorem model_facts
    (hm : Nonempty (A ≃* Equiv.Perm (Fin 3)) ∨
      Nonempty (A ≃* BinaryLinear.OuterCyclic.LinearGroup 3) ∨
      Nonempty (A ≃* Equiv.Perm (Fin 5))) :
    3 ∣ Nat.card A ∧ center A = ⊥ ∧ IsPGroup 2 (MulAut.Outer A) ∧
      pResidual 2 A = primeToResidual 3 A := by
  rcases hm with hm | hm | hm
  · obtain ⟨e⟩ := hm
    have hd : 3 ∣ Nat.card A := by
      rw [Nat.card_congr e.toEquiv,Nat.card_eq_fintype_card,Fintype.card_perm]
      decide
    have hz : center (Equiv.Perm (Fin 3)) = ⊥ := by
      apply (eq_bot_iff_forall _).mpr
      exact by decide
    have ho := outer_two_of_inner (B:=Equiv.Perm (Fin 3)) (by
      intro a
      obtain ⟨g,hg⟩ := NormalSymmetricThreePairRank.symmetricThree_aut_inner a
      exact ⟨g,hg.symm⟩)
    exact ⟨hd,center_transport e hz,ho.of_equiv (MulAut.outerCongr e).symm,
      residual_eq_of_normal_quotients hd (quotient_two_transport e symmetric_three_normal_quotient_two)⟩
  · obtain ⟨e⟩ := hm
    let eSL := e.trans (BinaryLinear.OuterCyclic.slEquivLinear 3).symm
    let ePSL := e.trans (BinaryLinear.OuterCyclic.projectiveEquivLinear (by decide : 0 < 3)).symm
    let : IsSimpleGroup (Matrix.ProjectiveSpecialLinearGroup (Fin 3) (ZMod 2)) :=
      Atlas.psl_simple_high_rank 3 (by decide)
    let : IsSimpleGroup A := ePSL.isSimpleGroup
    have hd : 3 ∣ Nat.card A := by
      rw [Nat.card_congr eSL.toEquiv,Matrix.PSL3Two.card_SL]
      decide
    exact ⟨hd,center_transport eSL Matrix.PSL3Two.center_eq_bot,
      Matrix.PSL3Two.Automorphisms.outer_sl_isTwoGroup.of_equiv (MulAut.outerCongr eSL).symm,
      residual_eq_of_normal_quotients hd simple_normal_quotient_two⟩
  · obtain ⟨e⟩ := hm
    have hd : 3 ∣ Nat.card A := by
      rw [Nat.card_congr e.toEquiv,Nat.card_eq_fintype_card,Fintype.card_perm]
      decide
    have hz : center (Equiv.Perm (Fin 5)) = ⊥ := by
      apply bot_unique
      exact (center_le_centralizer (alternatingGroup (Fin 5))).trans
        (GroupTheory.AutAlternating.centralizer_alternatingGroup_eq_bot 5 (by decide)).le
    exact ⟨hd,center_transport e hz,
      (outer_two_of_inner (Equiv.Perm.conj_surjective_of_degree (by decide : 5 ≤ 5) (by decide))).of_equiv
        (MulAut.outerCongr e).symm,
      residual_eq_of_normal_quotients hd
        (quotient_two_transport e (symmetric_normal_quotient_two (by decide : 5 ≤ 5)))⟩

private theorem centralizer_index_coprime (X : Subgroup A) [X.Normal]
    (ho : IsPGroup 2 (MulAut.Outer X))
    (hc : ¬ 3 ∣ Nat.card (centralizer (X : Set A))) : Nat.Coprime 3 X.index := by
  let f : A →* MulAut.Outer X :=
    (QuotientGroup.mk' (MulAut.innerSubgroup X)).comp MulAut.conjNormal
  have hk : f.ker = X ⊔ centralizer (X : Set A) := by
    rw [show f = (QuotientGroup.mk' (MulAut.innerSubgroup X)).comp
      (MulAut.conjNormal : A →* MulAut X) from rfl,
      ← MonoidHom.comap_ker,QuotientGroup.ker_mk',MulAut.conjNormal_comap_innerSubgroup]
  have hi : Nat.Coprime 3 (X ⊔ centralizer (X : Set A)).index := by
    rw [←hk,index_ker]
    obtain ⟨n,hn⟩ := (ho.to_subgroup f.range).exists_card_eq
    rw [hn]
    exact (by decide : Nat.Coprime 3 2).pow_right n
  rw [←relIndex_mul_index (show X ≤ X ⊔ centralizer (X : Set A) from le_sup_left)]
  apply Nat.Coprime.mul_right _ hi
  rw [relIndex_sup_left]
  exact (Nat.prime_three.coprime_iff_not_dvd.mpr hc).coprime_dvd_right (relIndex_dvd_card _ _)

private theorem two_factors_impossible (I K H : Subgroup A)
    (hKI : K ≤ I) (hHI : H ≤ I) (hd : Disjoint K H)
    (hcomm : K ≤ centralizer (H : Set A))
    (hK : 3 ∣ Nat.card K) (hH : 3 ∣ Nat.card H)
    (c : A) (hc : orderOf c = 3) (hout : c ∉ I)
    (hcK : c ∈ normalizer (K : Set A)) (hcH : c ∈ normalizer (H : Set A))
    (hr : primeRank 3 A ≤ 2) : False := by
  let C := zpowers c
  let X := K ⊓ centralizer (C : Set A)
  let Y := H ⊓ centralizer (C : Set A)
  have hp : IsPGroup 3 C := IsPGroup.of_card (n := 1) (by
    simpa only [C,Nat.card_zpowers,pow_one] using hc)
  have hfixed (J : Subgroup A) (hJ : 3 ∣ Nat.card J)
      (hn : c ∈ normalizer (J : Set A)) : 1 ≤ primeRank 3 (J ⊓ centralizer (C : Set A) : Subgroup A) := by
    have hm := card_modEq_card_inf_centralizer C J hp (zpowers_le.mpr hn)
    have hh := Nat.modEq_zero_iff_dvd.mp (hm.symm.trans hJ.modEq_zero_nat)
    exact Nat.one_le_iff_ne_zero.mpr (fun hz => PrimeRank.eq_zero_iff_not_dvd_card.mp hz hh)
  have hX : 1 ≤ primeRank 3 X := hfixed K hK hcK
  have hY : 1 ≤ primeRank 3 Y := hfixed H hH hcH
  have hC : 1 ≤ primeRank 3 C := Nat.one_le_iff_ne_zero.mpr (fun hz =>
    PrimeRank.eq_zero_iff_not_dvd_card.mp hz (by rw [Nat.card_zpowers,hc]))
  have hXY : Disjoint X Y := hd.mono inf_le_left inf_le_left
  have hXYc : X ≤ centralizer (Y : Set A) :=
    inf_le_left.trans (hcomm.trans (centralizer_le inf_le_left))
  have hXYI : X ⊔ Y ≤ I := sup_le (inf_le_left.trans hKI) (inf_le_left.trans hHI)
  have hdis : Disjoint (X ⊔ Y) C :=
    (I.disjoint_zpowers_of_prime_order_not_mem c hc hout).mono_left hXYI
  have hcen : X ⊔ Y ≤ centralizer (C : Set A) := sup_le inf_le_right inf_le_right
  have hu := (primeRank_subgroup_le 3 ((X ⊔ Y) ⊔ C : Subgroup A)).trans hr
  rw [primeRank_sup_eq_add_of_disjoint_commuting _ _ hdis hcen,
    primeRank_sup_eq_add_of_disjoint_commuting _ _ hXY hXYc] at hu
  omega

/-- The original outside cubic rules out a cubic in the relative centralizer
of the single centerless factor. -/
private theorem centralizer_three_free (I X : Subgroup A) [I.Normal]
    (hXI : X ≤ I) (hX : 3 ∣ Nat.card X) (hz : center X = ⊥)
    (c : A) (hc : orderOf c = 3) (hout : c ∉ I)
    (hn : c ∈ normalizer (X : Set A)) (hr : primeRank 3 A ≤ 2) :
    ¬ 3 ∣ Nat.card (I ⊓ centralizer (X : Set A) : Subgroup A) := by
  intro hdiv
  have hd : Disjoint X (I ⊓ centralizer (X : Set A)) := by
    apply disjoint_def.mpr
    intro x hx hc
    have hh : (⟨x,hx⟩ : X) ∈ center X := mem_center_iff.mpr fun y =>
      Subtype.ext (hc.2 y y.property)
    exact congrArg Subtype.val (hz.le hh)
  have hnC : c ∈ normalizer ((I ⊓ centralizer (X : Set A) : Subgroup A) : Set A) :=
    inf_normalizer_le_normalizer_inf ⟨by rw [normalizer_eq_top]; trivial,
      normalizer_le_normalizer_centralizer X hn⟩
  exact two_factors_impossible I X (I ⊓ centralizer (X : Set A)) hXI inf_le_left
    hd (le_centralizer_iff.mpr inf_le_right) hX hdiv c hc hout hn hnC hr

/-- A normal single factor has the full prime-to-three residual of the
centralizer image. Both sides use their original ambient embeddings. -/
private theorem canonical_residual (I X : Subgroup A) [I.Normal]
    (hXI : X ≤ I) (hXn : (X.subgroupOf I).Normal)
    (hm : Nonempty (X ≃* Equiv.Perm (Fin 3)) ∨
      Nonempty (X ≃* BinaryLinear.OuterCyclic.LinearGroup 3) ∨
      Nonempty (X ≃* Equiv.Perm (Fin 5)))
    (c : A) (hc : orderOf c = 3) (hout : c ∉ I)
    (hn : c ∈ normalizer (X : Set A)) (hr : primeRank 3 A ≤ 2) :
    (pResidual 2 X).map X.subtype = (primeToResidual 3 I).map I.subtype := by
  obtain ⟨hdiv,hz,ho,hres⟩ := model_facts hm
  have hfree := centralizer_three_free I X hXI hdiv hz c hc hout hn hr
  let D := X.subgroupOf I
  let := hXn
  have hCD : ¬ 3 ∣ Nat.card (centralizer (D : Set I)) := by
    let f : centralizer (D : Set I) →* (I ⊓ centralizer (X : Set A) : Subgroup A) := {
      toFun := fun y => ⟨y.val,y.val.property,fun x hx =>
        congrArg (fun a : I => (a : A)) (y.property ⟨x,hXI hx⟩ hx)⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl }
    have hf : Function.Injective f := by
      intro x y he
      have hh := congrArg (fun z : (I ⊓ centralizer (X : Set A) : Subgroup A) => (z : A)) he
      change (x.val : A) = (y.val : A) at hh
      exact Subtype.ext (Subtype.ext hh)
    exact fun hd => hfree (hd.trans (card_dvd_of_injective f hf))
  have hoD := ho.of_equiv (MulAut.outerCongr (subgroupOfEquivOfLe hXI)).symm
  have hle : primeToResidual 3 I ≤ D := primeToResidual_le D (centralizer_index_coprime D hoD hCD)
  have hh := congrArg (map I.subtype) (embedded_primeToResidual_eq_of_normal 3 D hle)
  rw [map_embedded_primeToResidual_of_hom,map_subgroupOf_eq_of_le hXI] at hh
  rwa [hres]

/-- Equality of the original residual images lifts through a two-group kernel. -/
private theorem original_canonical_residual {B : Type*} [Group B]
    (P : Subgroup A) [P.Normal] (f : A →* B) (hk : IsPGroup 2 f.ker)
    (hP : pResidual 2 P = primeToResidual 3 P)
    (he : ((pResidual 2 P).map P.subtype).map f = (primeToResidual 3 A).map f) :
    (pResidual 2 P).map P.subtype = primeToResidual 3 A := by
  let D := (pResidual 2 P).map P.subtype
  let : D.Normal := by
    apply normalizer_eq_top_iff.mp
    apply top_unique
    rw [← P.normalizer_eq_top]
    exact normalizer_le_normalizer_characteristic_image P (pResidual 2 P)
  apply le_antisymm
  · rw [hP]
    exact map_primeToResidual_le_of_hom 3 P.subtype
  · exact isPPerfect_le_of_map_le_of_kernel_normalizes f (primeToResidual 3 A) D
      (isPPerfect_primeToResidual 3 2 (by decide)) hk le_normalizer_of_normal he.symm.le

/-- The original covering map identifies O²(P) with O^{3′}(I), retaining
its kernel and both inclusions into the central-line normalizer. -/
theorem canonical_residual_of_cover (P I N : Subgroup A)
    (hPI : P ≤ I) (hPN : P ≤ N) (hIN : I ≤ N)
    (hIP : I ≤ normalizer (P : Set A))
    (hI : (I.subgroupOf N).Normal)
    (j : (P ⧸ pCore 2 P) →* (N ⧸ pCore 2 N))
    (hj : Function.Injective j)
    (hje : ∀ p, j (QuotientGroup.mk' (pCore 2 P) p) =
      QuotientGroup.mk' (pCore 2 N) (inclusion hPN p))
    (hm : Nonempty ((P ⧸ pCore 2 P) ≃* Equiv.Perm (Fin 3)) ∨
      Nonempty ((P ⧸ pCore 2 P) ≃* BinaryLinear.OuterCyclic.LinearGroup 3) ∨
      Nonempty ((P ⧸ pCore 2 P) ≃* Equiv.Perm (Fin 5)))
    (c : N ⧸ pCore 2 N) (hc : orderOf c = 3)
    (hout : c ∉ (I.subgroupOf N).map (QuotientGroup.mk' (pCore 2 N)))
    (hn : c ∈ normalizer (j.range : Set (N ⧸ pCore 2 N)))
    (hr : primeRank 3 (N ⧸ pCore 2 N) ≤ 2) :
    (pResidual 2 P).map P.subtype = (primeToResidual 3 I).map I.subtype := by
  let q := QuotientGroup.mk' (pCore 2 N)
  let f := q.comp (inclusion hIN)
  let Q := (I.subgroupOf N).map q
  let X := j.range
  let D := P.subgroupOf I
  let := hI
  let : Q.Normal := Normal.map inferInstance q (QuotientGroup.mk'_surjective _)
  let : D.Normal := normal_subgroupOf_of_le_normalizer hIP
  have hX : (P.subgroupOf N).map q = X := by
    apply le_antisymm
    · rintro _ ⟨p,hp,rfl⟩
      exact ⟨QuotientGroup.mk' (pCore 2 P) ⟨p,hp⟩,hje _⟩
    · rintro _ ⟨x,rfl⟩
      obtain ⟨p,rfl⟩ := QuotientGroup.mk'_surjective (pCore 2 P) x
      rw [hje]
      exact mem_map_of_mem q p.property
  have hXI : X ≤ Q := by
    rw [←hX]
    exact map_mono (fun x hx => hPI hx)
  have hQX : Q ≤ normalizer (X : Set (N ⧸ pCore 2 N)) := by
    have hIP' : I.subgroupOf N ≤ normalizer (P.subgroupOf N : Set N) := by
      rw [←subgroupOf_normalizer_eq hPN]
      exact fun x hx => hIP hx
    rw [←hX]
    exact (map_mono hIP').trans ((P.subgroupOf N).le_normalizer_map q)
  have hmodels : Nonempty (X ≃* Equiv.Perm (Fin 3)) ∨
      Nonempty (X ≃* BinaryLinear.OuterCyclic.LinearGroup 3) ∨
      Nonempty (X ≃* Equiv.Perm (Fin 5)) := by
    let eX := (MonoidHom.ofInjective hj).symm
    rcases hm with hh | hh | hh
    · obtain ⟨e⟩ := hh
      exact Or.inl ⟨eX.trans e⟩
    · obtain ⟨e⟩ := hh
      exact Or.inr (Or.inl ⟨eX.trans e⟩)
    · obtain ⟨e⟩ := hh
      exact Or.inr (Or.inr ⟨eX.trans e⟩)
  have hcanonical := canonical_residual Q X hXI
    (normal_subgroupOf_of_le_normalizer hQX) hmodels c hc hout hn hr
  have hDmap : D.map f = X := by
    rw [←hX]
    ext x
    constructor
    · rintro ⟨p,hp,rfl⟩
      exact ⟨inclusion hIN p,hp,rfl⟩
    · rintro ⟨p,hp,rfl⟩
      exact ⟨⟨p,hPI hp⟩,hp,rfl⟩
  have hQrange : f.range = Q := by
    ext x
    constructor
    · rintro ⟨i,rfl⟩
      exact ⟨inclusion hIN i,i.property,rfl⟩
    · rintro ⟨i,hi,rfl⟩
      exact ⟨⟨i,hi⟩,rfl⟩
  have hresmap : (primeToResidual 3 I).map f = (primeToResidual 3 Q).map Q.subtype := by
    have hh := map_embedded_primeToResidual_of_hom 3 (⊤ : Subgroup I) f
    have ht : (primeToResidual 3 (⊤ : Subgroup I)).map (⊤ : Subgroup I).subtype =
        primeToResidual 3 I :=
      map_primeToResidual_of_surjective 3 (topEquiv (G:=I)).toMonoidHom (topEquiv (G:=I)).surjective
    rw [ht,←MonoidHom.range_eq_map,hQrange] at hh
    exact hh
  have hP : pResidual 2 P = primeToResidual 3 P :=
    twoResidual_eq_primeToResidual_three_of_two_kernel (QuotientGroup.mk' (pCore 2 P))
      (QuotientGroup.mk'_surjective _) (by rw [QuotientGroup.ker_mk']; exact pCore_isPGroup)
      (model_facts hm).2.2.2
  have hD : pResidual 2 D = primeToResidual 3 D := by
    let e := subgroupOfEquivOfLe hPI
    apply map_injective (f:=e.toMonoidHom) e.injective
    rw [map_pResidual_of_surjective 2 e.toMonoidHom e.surjective,
      map_primeToResidual_of_surjective 3 e.toMonoidHom e.surjective,hP]
  have hk : IsPGroup 2 f.ker := by
    have hle : f.ker ≤ (pCore 2 N).comap (inclusion hIN) := by
      intro x hx
      change q (inclusion hIN x) = 1 at hx
      exact (QuotientGroup.eq_one_iff (inclusion hIN x)).mp hx
    exact ((pCore_isPGroup (p:=2) (G:=N)).comap_of_injective (inclusion hIN)
      (inclusion_injective hIN)).to_le hle
  have he : ((pResidual 2 D).map D.subtype).map f = (primeToResidual 3 I).map f := by
    rw [map_embedded_pResidual,hDmap,hresmap]
    exact hcanonical
  have hh := congrArg (map I.subtype) (original_canonical_residual D f hk hD he)
  rw [map_embedded_pResidual,map_subgroupOf_eq_of_le hPI] at hh
  exact hh

end CFSG.Quasithin.Chapter6.Source.RankOneRecognition.NaturalCanonicalResidual

namespace CFSG.Quasithin.Chapter6.Source.RankOneRecognition
open CFSG.Quasithin.ChapterG.Section06 CFSG.Quasithin.ChapterE
universe v
variable {G : Type v} [Group G] [Finite G]
  {T : Sylow 2 G} {L M R : Subgroup G} {n : ℕ}
namespace NaturalEscapeGraph.OddConfiguration
variable (d : NaturalEscapeGraph.OddConfiguration T L M R)
include d

/-- The original marked action identifies O²(P) with O^{3′}(I), so the
whole central-line normalizer preserves the residual of the same P. -/
theorem exists_ambient_canonical_residual
    (h : Hypothesis611 KnownSimple.IsKnownSimple T L M R n)
    (hnat : IsNaturalModule L (layer L R) n)
    (hE : ChapterE.Section06.HypothesisE61 KnownSimple.IsKnownSimple T M (layer L R))
    (hs : letI := h.layer_elementary; globalS (layer L R) = n)
    (hNS : Subgroup.normalizer (((T : Subgroup G) ⊓
      centralizer (ZS (T : Subgroup G) L R : Set G) : Subgroup G) : Set G) ≤ M)
    (hab : Escape.U (T : Subgroup G) L R ≤
      centralizer (Escape.U (T : Subgroup G) L R : Set G)) :
    n = 2 ∧ ∃ z a : G,
      z ∈ ZS (T : Subgroup G) L R ∧ orderOf z = 2 ∧
      let I := Escape.I (T : Subgroup G) L R
      let N := Escape.H (T : Subgroup G) L R
      let Z := ZS (T : Subgroup G) L R
      let W := Escape.U (T : Subgroup G) L R ⊓
        conjugateSpanBy Z (centralizer ({z} : Set G))
      let E := (layer L R).map (MulAut.conj a).toMonoidHom
      let P := conjugateSpanBy E I
      E ≤ I ∧ Z ≤ W ∧
      ∃ (hPI : P ≤ I) (hPN : P ≤ N) (hIN : I ≤ N)
        (hIW : I ≤ Subgroup.normalizer (W : Set G))
        (hZ : (Z.subgroupOf W).Normal),
      let := hZ
      ∃ σ : I →* MulAut (W ⧸ Z.subgroupOf W),
        (∀ i : I, ∀ w : W,
          σ i (QuotientGroup.mk' (Z.subgroupOf W) w) =
            QuotientGroup.mk' (Z.subgroupOf W)
              ⟨(i : G) * (w : G) * (i : G)⁻¹,
                (mem_normalizer_iff.mp (hIW i.property) w).mp w.property⟩) ∧
      ∃ hX : IsElementaryAbelian 2 (W ⧸ Z.subgroupOf W),
        let := hX
        IsElementaryAbelian 2 ((E.subgroupOf I).map σ) ∧
        1 < Nat.card ((E.subgroupOf I).map σ) ∧
        Nat.card ((E.subgroupOf I).map σ) ≤ 4 ∧
        let g := σ.comp (inclusion hPI)
        ∃ (φ : (P ⧸ pCore 2 P) →* g.range)
          (j : (P ⧸ pCore 2 P) →* (N ⧸ pCore 2 N)),
          Function.Bijective φ ∧ φ.ker ≤ center (P ⧸ pCore 2 P) ∧
          Function.Injective j ∧ j.range.IsSubnormal ∧
          (∀ p, φ (QuotientGroup.mk' (pCore 2 P) p) = g.rangeRestrict p) ∧
          (∀ p, j (QuotientGroup.mk' (pCore 2 P) p) =
            QuotientGroup.mk' (pCore 2 N) (inclusion hPN p)) ∧
          pCore 2 g.range = ⊥ ∧ g.ker = pCore 2 P ∧
          closure {x : P ⧸ pCore 2 P | x ^ 2 = 1} = ⊤ ∧
          let θ := Representation.ofElementaryAbelianAction
            (A := g.range) (G := W ⧸ Z.subgroupOf W) (p := 2)
          ∃ product : SmallTransvectionProductModel θ,
            product.factors = {⊤} ∧
            (∃ U : Submodule (ZMod 2) (Additive (W ⧸ Z.subgroupOf W)),
              SmallFactorModel θ ⊤ U) ∧
            (Nonempty ((P ⧸ pCore 2 P) ≃* Equiv.Perm (Fin 3)) ∨
              Nonempty ((P ⧸ pCore 2 P) ≃* BinaryLinear.OuterCyclic.LinearGroup 3) ∨
              Nonempty ((P ⧸ pCore 2 P) ≃* Equiv.Perm (Fin 5))) ∧
            ((pResidual 2 P).map P.subtype = (primeToResidual 3 I).map I.subtype) ∧
            (N ≤ Subgroup.normalizer ((pResidual 2 P).map P.subtype : Set G)) ∧
            (∀ c : N, c^3=1 → (c : G) ∈ Subgroup.normalizer
              ((pResidual 2 P).map P.subtype : Set G)) ∧
            (∀ K ∈ product.factors,
              (((K.comap φ).comap (QuotientGroup.mk' (pCore 2 P))).map P.subtype) = P) ∧
            (∀ K ∈ product.factors, FactorResidualLift φ j
              ((I.subgroupOf N).map (QuotientGroup.mk' (pCore 2 N))) K ∧
              ∀ c : N ⧸ pCore 2 N, c^3=1 →
                c ∈ Subgroup.normalizer ((((pResidual 2 (K.comap φ)).map
                  (K.comap φ).subtype).map j) : Set (N ⧸ pCore 2 N))) ∧
            (∀ K ∈ product.factors,
              ((pResidual 2 I).map (inclusion hIN)).map (QuotientGroup.mk' (pCore 2 N)) ≤
                Subgroup.normalizer ((K.comap φ).map j : Set (N ⧸ pCore 2 N)) ∧
              (pResidual 2 I).map I.subtype ≤ Subgroup.normalizer
                ((((K.comap φ).comap (QuotientGroup.mk' (pCore 2 P))).map P.subtype) : Set G)) ∧
            (∀ K ∈ product.factors, ∀ c : N ⧸ pCore 2 N, c^3=1 →
              c ∈ Subgroup.normalizer ((K.comap φ).map j : Set (N ⧸ pCore 2 N))) ∧
            (∀ c : N ⧸ pCore 2 N, c^3=1 →
              c ∈ Subgroup.normalizer (j.range : Set (N ⧸ pCore 2 N))) ∧
            (∀ K ∈ product.factors, ∀ c : N, c^3=1 →
              c ∈ Subgroup.normalizer (((K.comap φ).map j).comap
                (QuotientGroup.mk' (pCore 2 N)) : Set N)) ∧
            ∃ e : (∀ K : {K // K ∈ product.factors}, K.val) ≃* (P ⧸ pCore 2 P),
              (∀ x, φ (e x) = product.productEquiv x) ∧
              (∀ K : {K // K ∈ product.factors}, ∀ a : P ⧸ pCore 2 P,
                a ∈ K.val.comap φ ↔ ∃ x : K.val,
                  e (Function.update 1 K x) = a) := by
  obtain ⟨hn,z,a,hz,ho,hEI,hZW,hPI,hPN,hIN,hIW,hZ,σ,hσ,hX,hEA,hpos,hupper,
      φ,j,hφ,hφc,hj,hjn,hφe,hje,hred,hk,hgen,product,hsingle,hsmall,hmodels,
      horiginal,hfactor,hres,hact,hfull,hrange,hlift,e,he,hcoords⟩ :=
    d.exists_ambient_single_factor h hnat hE hs hNS hab
  let I := Escape.I (T : Subgroup G) L R
  let N := Escape.H (T : Subgroup G) L R
  let E := (layer L R).map (MulAut.conj a).toMonoidHom
  let P := conjugateSpanBy E I
  obtain ⟨_,hr,c,_,_,_,hc,hout⟩ :=
    natural_four_ambient_quotient_cubic (hn ▸ h) (hn ▸ hnat)
  have hI : (I.subgroupOf N).Normal :=
    normal_subgroupOf_centralizer_normalizer (ZS (T : Subgroup G) L R : Set G)
  have hcanonical := NaturalCanonicalResidual.canonical_residual_of_cover P I N hPI hPN hIN
    (le_normalizer_conjugateSpanBy E I) hI j hj hje hmodels
    (QuotientGroup.mk' (pCore 2 N) c) hc hout
    (hrange _ (hc ▸ pow_orderOf_eq_one _)) hr
  have hnormal : N ≤ Subgroup.normalizer ((pResidual 2 P).map P.subtype : Set G) := by
    rw [hcanonical]
    exact (normalizer_le_normalizer_centralizer (ZS (T : Subgroup G) L R)).trans
      (normalizer_le_normalizer_characteristic_image I (primeToResidual 3 I))
  exact ⟨hn,z,a,hz,ho,hEI,hZW,hPI,hPN,hIN,hIW,hZ,σ,hσ,hX,hEA,hpos,hupper,
    φ,j,hφ,hφc,hj,hjn,hφe,hje,hred,hk,hgen,product,hsingle,hsmall,hmodels,
    hcanonical,hnormal,horiginal,hfactor,hres,hact,hfull,hrange,hlift,e,he,hcoords⟩

