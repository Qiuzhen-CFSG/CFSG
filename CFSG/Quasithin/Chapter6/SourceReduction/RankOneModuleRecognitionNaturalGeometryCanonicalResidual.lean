module
public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleRecognitionNaturalGeometrySingleFactor
public import Theory.GroupTheory.NormalSymmetricThreePairRank.Inner
public import Theory.SpecificGroups.Symmetric.InnerAutomorphisms
