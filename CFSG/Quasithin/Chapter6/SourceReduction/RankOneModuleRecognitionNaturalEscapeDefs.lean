module

public import CFSG.Quasithin.Chapter6.Section01.SourceCentralLine
public import CFSG.Quasithin.Chapter6.Section01.EscapeSize
public import Theory.GroupAction.SubgroupQuotientFullAction
public import Theory.GroupTheory.Commutator.ConjugateGeneration

/-!
# Literal quotient and geometric inputs for the escaping Chapter 6 branch

The conjugate-generated group U is normalized by I = C_G(Z_S). Its action
on U/Z_S is constructed from conjugation, with the original quotient map.
The component model below concerns an actual image in this action, rather
than an unrelated group bearing a PSL₂ label.
The commutator bound makes the quotient abelian; its involutory generators
then prove elementary abelianness without a separate source premise.

`Geometry` records precisely the earlier identities consumed by the proved
6.1.26 size argument. It is an explicit input to a conditional contradiction,
not an assertion that these identities follow from Hypothesis 6.1.1.
The source producers of 6.1.17--25 must construct it in the escaping branch.

Source: Aschbacher--Smith, 6.1.17--27, printed pp.672--679.
-/

@[expose] public noncomputable section
open Subgroup
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter6.Source.RankOneRecognition.NaturalEscape
variable {G : Type*} [Group G] (T L V : Subgroup G)

theorem I_normalizes_U :
    Escape.I T L V ≤ normalizer (Escape.U T L V : Set G) :=
  le_normalizer_iSup_conjugates (layer L V) (Escape.I T L V)

variable [hN : ((ZS T L V).subgroupOf (Escape.U T L V)).Normal]

/-- The original central quotient, retaining relative normality inside U. -/
abbrev Quotient := Escape.U T L V ⧸ (ZS T L V).subgroupOf (Escape.U T L V)

/-- The literal action of I on U/Z_S. -/
def action : Escape.I T L V →* MulAut (Quotient T L V) :=
  (exists_quotient_conjugation_action (Escape.I T L V) (Escape.U T L V)
    (ZS T L V) (I_normalizes_U T L V) (centralizer_le_normalizer _) hN).choose

/-- Conjugation on representatives specifies the quotient action completely. -/
theorem action_mk (i : Escape.I T L V) (u : Escape.U T L V) :
    action T L V i (QuotientGroup.mk' ((ZS T L V).subgroupOf (Escape.U T L V)) u) =
      QuotientGroup.mk' ((ZS T L V).subgroupOf (Escape.U T L V))
        ⟨(i : G) * (u : G) * (i : G)⁻¹,
          (mem_normalizer_iff.mp (I_normalizes_U T L V i.property) u).mp u.property⟩ :=
  (exists_quotient_conjugation_action (Escape.I T L V) (Escape.U T L V)
    (ZS T L V) (I_normalizes_U T L V) (centralizer_le_normalizer _) hN).choose_spec i u

/-- Once the commutators lie in Z_S, the quotient is elementary: it is
abelian and generated by images of conjugates of the elementary layer. -/
theorem quotient_elementary_of_commutator
    (hV : IsElementaryAbelian 2 (layer L V))
    (hcomm : ⁅Escape.U T L V, Escape.U T L V⁆ ≤ ZS T L V) :
    IsElementaryAbelian 2 (Quotient T L V) := by
  let := hV
  let U := Escape.U T L V
  let q := QuotientGroup.mk' ((ZS T L V).subgroupOf U)
  have hQ : IsMulCommutative (Quotient T L V) :=
    Normal.quotient_commutative_iff_commutator_le.mpr (by
      change ⁅(⊤ : Subgroup U), ⊤⁆ ≤ (ZS T L V).subgroupOf U
      apply commutator_le.mpr
      intro x _ y _
      exact hcomm (commutator_mem_commutator x.property y.property))
  let := hQ
  let K : Subgroup U := ((powMonoidHom 2).comp q).ker
  have hUK : U ≤ K.map U.subtype := by
    apply iSup_le
    intro i x hx
    obtain ⟨v, hv, rfl⟩ := mem_map.mp hx
    have hxU : (MulAut.conj (i : G)) v ∈ U :=
      (le_iSup (fun j : Escape.I T L V =>
        (layer L V).map (MulAut.conj (j : G)).toMonoidHom) i)
        (mem_map_of_mem (MulAut.conj (i : G)).toMonoidHom hv)
    refine ⟨⟨_, hxU⟩, ?_, rfl⟩
    change q ⟨_, hxU⟩ ^ 2 = 1
    rw [← map_pow]
    have hvpow := elemPow_eq_one_of_isElementaryAbelian (p := 2) v hv
    have hxpow : (⟨(MulAut.conj (i : G)) v, hxU⟩ : U) ^ 2 = 1 := by
      apply Subtype.ext
      change ((MulAut.conj (i : G)) v) ^ 2 = 1
      rw [← map_pow, hvpow, map_one]
    rw [hxpow, map_one]
  refine { toIsMulCommutative := hQ
           exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr ?_ }
  intro w
  obtain ⟨u, rfl⟩ := QuotientGroup.mk'_surjective ((ZS T L V).subgroupOf U) w
  obtain ⟨v, hv, he⟩ := hUK u.property
  have hve : v = u := Subtype.ext he
  exact hve ▸ hv

/-- The portion of 6.1.25(2) needed for the terminal contradiction. The
model is the image of a subgroup of I in its actual action on U/Z_S. -/
def PrimeComponent : Prop :=
  ∃ (p : ℕ), p.Prime ∧ 11 ≤ p ∧ (p % 8 = 3 ∨ p % 8 = 5) ∧
    ∃ K : Subgroup (Escape.I T L V),
      ClassicalGroup.IsPSL (K.map (action T L V)) 2 p

omit hN in
/-- Earlier geometric identities from 6.1.20--21 and the natural section
from 6.1.25(3), in the exact conventions of `EscapeSize`. None is a
conclusion of this definition. -/
structure Geometry where
  g : G
  l : G
  g_mem : g ∈ Escape.I T L V
  l_mem : l ∈ L
  l_out : l ∉ Escape.H T L V
  generated : Escape.L1 T L V l = L ⊔ Escape.U T L V
  intersection_commutes : Escape.E T L V l ≤ centralizer (Escape.E T L V l : Set G)
  U_le_T : Escape.U T L V ≤ T
  core : Escape.R T L V l =
    (Escape.U T L V ⊓ centralizer (layer L V : Set G)) ⊔
      ((Escape.U T L V).map (MulAut.conj l⁻¹).toMonoidHom ⊓
        centralizer (layer L V : Set G))
  product : Escape.U T L V =
    (layer L V ⊔ (layer L V).map (MulAut.conj g⁻¹).toMonoidHom) ⊔
      (Escape.U T L V ⊓ centralizer
        ((layer L V ⊔ (layer L V).map (MulAut.conj g⁻¹).toMonoidHom : Subgroup G) : Set G))
  central : ⁅Escape.L1 T L V l, Escape.E T L V l⁆ ≤ layer L V
  line_card : Nat.card (ZS T L V) = 4
  conjugate_index :
    (centralizer ((layer L V).map (MulAut.conj g⁻¹).toMonoidHom : Set G)).relIndex
      (Escape.U T L V) = 4
  fixed_right : ZS T L V ⊓ centralizer
    ((layer L V).map (MulAut.conj (g * l)⁻¹).toMonoidHom : Set G) = ⊥
  fixed_left : (ZS T L V).map (MulAut.conj l⁻¹).toMonoidHom ⊓ centralizer
    ((layer L V).map (MulAut.conj g⁻¹).toMonoidHom : Set G) = ⊥
  natural_section : Escape.IsNaturalSectionFour
    (Escape.L1 T L V l) (Escape.R T L V l) (Escape.E T L V l)
  centralizer_index : (Escape.E T L V l).relIndex
    (Escape.U T L V ⊓ centralizer (layer L V : Set G)) = 4
  U_index : (Escape.U T L V ⊓ centralizer (layer L V : Set G)).relIndex
    (Escape.U T L V) = 4
  commutator : ⁅Escape.U T L V, Escape.U T L V⁆ ≤ ZS T L V

end CFSG.Quasithin.Chapter6.Source.RankOneRecognition.NaturalEscape
