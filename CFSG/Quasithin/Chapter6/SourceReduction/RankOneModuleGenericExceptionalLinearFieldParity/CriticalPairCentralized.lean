module
public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleGenericExceptionalLinearFieldParity.Estimates
public import CFSG.Quasithin.Chapter6.Section01.EscapeSize.Natural
public import CFSG.Quasithin.ChapterI.Section06To08.TIConjugateSpan
public import Theory.Representation.BinaryConjugationSection.DisplacementBound
public import Theory.Representation.BinaryOffender.CommutatorRank

/-!
# The centralized critical-pair branch of the parity argument

The natural module is generated by its point conjugates. The elementary
TI-pair theorem then extends fixation of one nonidentity point to fixation
of its whole point subgroup. If Uγ = Dγ, a moved point meets DH trivially;
the opposite quotient rank bounds its order by sixteen. Criticality supplies
an actor outside the endpoint two-core, and inverse conjugation transports it
to the original H₁-action on U/Z₁ with displacement at most four.

Thus displacement at least nine excludes the centralized branch. The same
rank bound also shows that DH cannot centralize Uγ in the remaining branch,
and selects an actual moved conjugate of V with all the source kernel and
normalizer containments. No reversal of the path is needed for this step.

These results retain the explicit Seed and LargeDisplacement inputs. The odd
setup, the displacement lower bound, and the final proper-centralizer bound
remain with the parity assembly owner, qt-d-1222-linear-field-parity.
Source: Aschbacher–Smith, 5.1.17, printed pp.641–642 (refs/quasithin.pdf).
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped commutatorElement IsMulCommutative
namespace CFSG.Quasithin.Chapter6.Source.RankOneGeneric.LinearParity
variable {G : Type*} [Group G] [Finite G]

private theorem ti_conjugate_centralizes_of_point
    (Z : Subgroup G) [IsElementaryAbelian 2 Z]
    (hTI : ChapterI.Section06To08.IsTISubgroup Z)
    (a b x : G) (hx : x ∈ Z.map (MulAut.conj a).toMonoidHom) (hx1 : x ≠ 1)
    (hc : x ∈ centralizer (Z.map (MulAut.conj b).toMonoidHom : Set G)) :
    Z.map (MulAut.conj a).toMonoidHom ≤
      centralizer (Z.map (MulAut.conj b).toMonoidHom : Set G) := by
  let : IsElementaryAbelian 2 (Z.map (MulAut.conj b).toMonoidHom) :=
    IsElementaryAbelian.map _
  have he : (Z.map (MulAut.conj b).toMonoidHom).map
      (MulAut.conj (a*b⁻¹)).toMonoidHom = Z.map (MulAut.conj a).toMonoidHom := by
    change (Z.conjBy b).conjBy (a*b⁻¹) = Z.conjBy a
    rw [← conjBy_mul]
    simp only [inv_mul_cancel_right]
  have hh := (hTI.map_equiv (MulAut.conj b)).conjugate_le_centralizer_of_point
    (a*b⁻¹) x (he.symm ▸ hx) hx1 hc
  rwa [he] at hh

variable {T : Sylow 2 G} {L H A : Subgroup G} {n : ℕ}

/-- The recorded intersection alternative is the genuine global TI property. -/
theorem Seed.point_isTI (s : Seed T L H A n) :
    ChapterI.Section06To08.IsTISubgroup (setup T L s.V H A).V₁ := by
  intro g hg
  rcases s.point_TI g with he | he
  · intro x hx
    exact mem_bot.mp (he ▸ (show x ∈ (setup T L s.V H A).V₁ ⊓
      ((setup T L s.V H A).V₁.map (MulAut.conj g).toMonoidHom) from hx))
  · exact (hg (mem_normalizer_iff_map_conj_eq.mpr he)).elim

/-- Natural irreducibility identifies the actual module with its point span. -/
theorem Seed.point_span (s : Seed T L H A n) :
    conjugateSpanBy (setup T L s.V H A).V₁ L = s.V := by
  have hle : conjugateSpanBy (setup T L s.V H A).V₁ L ≤ s.V :=
    conjugateSpanBy_le s.f8.point_le (le_sup_left.trans s.f8.LT_normalizes_V)
  rcases s.natural.invariant_subgroup _ hle (le_normalizer_conjugateSpanBy _ _) with he | he
  · exact (s.f8.point_ne_bot (eq_bot_iff.mpr ((le_conjugateSpanBy _ _).trans he.le))).elim
  · exact he

/-- A fixed nonidentity element of a point conjugate makes the whole point
centralize the endpoint module, using its actual point generators. -/
theorem Seed.endpoint_centralizes_point_of_fixed_element
    (s : Seed T L H A n) (C : s.f8.CriticalPath)
    (a x : G) (hx : x ∈ (setup T L s.V H A).V₁.map (MulAut.conj a).toMonoidHom)
    (hx1 : x ≠ 1) (hc : x ∈ centralizer (C.Ug : Set G)) :
    (setup T L s.V H A).V₁.map (MulAut.conj a).toMonoidHom ≤
      centralizer (C.Ug : Set G) := by
  let E := setup T L s.V H A
  let : IsElementaryAbelian 2 E.V := s.f8.elementary
  let : IsElementaryAbelian 2 E.V₁ := IsElementaryAbelian.of_injective
    (inclusion s.f8.point_le) (inclusion_injective _)
  have hspan : C.Ug = ⨆ (b : E.H) (l : L),
      E.V₁.map (MulAut.conj ((C.g : G) * b * l)).toMonoidHom := by
    change (conjugateSpanBy s.V E.H).map _ = _
    conv_lhs => arg 2; arg 1; rw [← s.point_span]
    rw [conjugateSpanBy_eq_iSup_conj, Subgroup.map_iSup]
    congr 1
    funext b
    rw [conjugateSpanBy_eq_iSup_conj, Subgroup.map_iSup, Subgroup.map_iSup]
    congr 1
    funext l
    change ((E.V₁.conjBy l).conjBy b).conjBy C.g = _
    rw [← conjBy_mul, ← conjBy_mul]
    rfl
  apply le_centralizer_iff.mpr
  rw [hspan]
  refine iSup_le fun b => iSup_le fun l => le_centralizer_iff.mp ?_
  apply ti_conjugate_centralizes_of_point E.V₁ s.point_isTI a _ x hx hx1
  apply centralizer_le (show E.V₁.map (MulAut.conj ((C.g : G) * b * l)).toMonoidHom ≤ C.Ug from ?_) hc
  rw [hspan]
  exact le_iSup_of_le b (le_iSup_of_le l le_rfl)

/-- In the centralized branch a moved point embeds in the opposite quotient,
so its field exponent is at most the quotient two-rank bound. -/
theorem Seed.centralized_exponent_le_four
    (s : Seed T L H A n) (C : s.f8.CriticalPath) (he : C.Dg = C.Ug) : n ≤ 4 := by
  let E := setup T L s.V H A
  have hm : ∃ l : L, ¬ E.V₁.map (MulAut.conj (l : G)).toMonoidHom ≤
      centralizer (C.Ug : Set G) := by
    by_contra! hh
    have hc : E.V ≤ centralizer (C.Ug : Set G) := by
      calc
        E.V = conjugateSpanBy E.V₁ L := s.point_span.symm
        _ ≤ _ := by rw [conjugateSpanBy_eq_iSup_conj]; exact iSup_le hh
    exact C.commutator_not_le_A₁
      ((commutator_eq_bot_iff_le_centralizer.mpr (le_centralizer_iff.mp hc)).le.trans bot_le)
  obtain ⟨l, hl⟩ := hm
  let W := E.V₁.map (MulAut.conj (l : G)).toMonoidHom
  have hWU : W ≤ E.U := by
    have hv := mem_normalizer_iff_map_conj_eq.mp
      (s.f8.LT_normalizes_V (show (l : G) ∈ E.LT from mem_sup_left l.property))
    exact ((map_mono s.f8.point_le).trans hv.le).trans (le_conjugateSpanBy _ _)
  have hc : C.DH ≤ centralizer (C.Ug : Set G) := by
    rw [← he]
    exact commutator_eq_bot_iff_le_centralizer.mp C.centralizers_commute
  have hd : W ⊓ C.DH = ⊥ := by
    apply eq_bot_iff.mpr
    intro x hx
    apply mem_bot.mpr
    by_contra hx1
    exact hl (s.endpoint_centralizes_point_of_fixed_element C l x hx.1 hx1 (hc hx.2))
  have hi := (relIndex_le_of_le_right (H := C.DH) hWU
    (show C.DH.relIndex E.U ≠ 0 from index_ne_zero_of_finite)).trans
    (s.critical_indices_le_sixteen C).2
  rw [← inf_relIndex_right, inf_comm, hd, relIndex_bot_left,
    card_map_of_injective (MulAut.conj (l : G)).injective, s.point_card] at hi
  exact (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp (show 2^n ≤ 2^4 from hi)

open Representation.BinaryOffender in
/-- A commutator bound controls displacement on the original quotient action;
the controlling subgroup need not lie in U or be normal in G. -/
theorem displacement_le_of_commutator_card
    {E : ChapterF.Section08.Setup G} (h : E.Hypothesis)
    (B W : Subgroup G) (hBH : B ≤ E.H) (hc : ⁅B,E.U⁆ ≤ W)
    (m : ℕ) (hW : Nat.card W ≤ 2^m) (y : G) (hy : y ∈ B) :
    displacement E y ≤ m := by
  let := point_normal_in_span h
  let := ChapterF.Section08.Setup.lemma_F_8_5_two h
  obtain ⟨ρ,d,hρ,_⟩ := exists_faithful_action h
  let yH : E.H := ⟨y,hBH hy⟩
  have hz : (zpowers y).subgroupOf E.H = zpowers yH := by
    apply (map_injective E.H.subtype_injective)
    rw [map_subgroupOf_eq_of_le (zpowers_le.mpr (hBH hy)), MonoidHom.map_zpowers]
    rfl
  rw [displacement_eq_fixedCodim h ρ d y (hBH hy), hz, MonoidHom.map_zpowers,
    fixedCodim_zpowers_eq_displacement_rank]
  simpa only [MonoidHom.comp_apply, Module.End.one_eq_id] using
    d.displacement_rank_le_of_commutator_bound B W ⊥ bot_le hc m
      (by simpa only [relIndex_bot_left] using hW) yH hy

/-- The centralized branch produces a mover on the original U/Z₁. The actor
is transported from the endpoint; only its square is required in the two-core. -/
theorem Seed.smallMover_of_centralized
    (s : Seed T L H A n) (C : s.f8.CriticalPath) (he : C.Dg = C.Ug) :
    SmallMover (setup T L s.V H A) := by
  let E := setup T L s.V H A
  let e : G ≃* G := MulAut.conj (C.g : G)
  have hnot : ¬ E.V ≤ (C.vertexGroup C.endpoint).pCoreIn 2 := by
    intro hc
    exact C.commutator_not_le_A₁ ((le_endpoint_core_iff C E.V C.V_le_endpointGroup).mp hc)
  obtain ⟨y, hy, hyQ⟩ := SetLike.not_le_iff_exists.mp hnot
  have hVH : E.V.map e.symm.toMonoidHom ≤ E.H := by
    have hh := map_mono (f := e.symm.toMonoidHom) C.V_le_endpointGroup
    rw [C.endpointGroup_eq] at hh
    simpa [e, map_map] using hh
  have hyH : e.symm y ∈ E.H := hVH (mem_map_of_mem _ hy)
  have hyQ' : e.symm y ∉ E.QH := by
    intro hy'
    apply hyQ
    rw [C.endpointGroup_eq, AmalgamLocalCores.pCoreIn_map_of_injective 2 _ e.injective]
    exact ⟨e.symm y, hy', e.apply_symm_apply y⟩
  let : IsElementaryAbelian 2 E.V := s.f8.elementary
  have hy2 : (e.symm y)^2 ∈ E.QH := by
    rw [← map_pow, elemPow_eq_one_of_isElementaryAbelian y hy, map_one]
    exact E.QH.one_mem
  have hc0 : ⁅E.V,C.Ug⁆ ≤ E.V₁ := by
    have hc := C.centralizer_commutators.2
    rw [he] at hc
    exact (commutator_mono (le_conjugateSpanBy _ _) le_rfl).trans hc
  have hc := map_mono (f := e.symm.toMonoidHom) hc0
  rw [map_commutator] at hc
  have hu : C.Ug.map e.symm.toMonoidHom = E.U := by
    simp [ChapterF.Section08.Setup.Hypothesis.CriticalPath.Ug, e, map_map, E]
  rw [hu] at hc
  have hcard : Nat.card (E.V₁.map e.symm.toMonoidHom) ≤ 2^4 := by
    rw [card_map_of_injective e.symm.injective]
    exact s.point_card.le.trans (Nat.pow_le_pow_right (by decide) (s.centralized_exponent_le_four C he))
  have hsmall := displacement_le_of_commutator_card s.f8 _ _ hVH hc 4 hcard
    (e.symm y) (mem_map_of_mem _ hy)
  exact ⟨e.symm y, hyH, hy2, hyQ', hsmall.trans (by decide)⟩

/-- The displacement lower bound excludes Uγ = Dγ, the first terminal case. -/
theorem Seed.critical_centralizer_ne_span
    (s : Seed T L H A n) (C : s.f8.CriticalPath)
    (hlarge : LargeDisplacement (setup T L s.V H A)) : C.Dg ≠ C.Ug := by
  intro he
  obtain ⟨y,hy,hy2,hyQ,hsmall⟩ := s.smallMover_of_centralized C he
  have hbig := hlarge y hy hy2 hyQ
  omega

/-- The opposite kernel cannot centralize the endpoint span: its index at
most sixteen would bound a nontrivial quotient involution’s displacement by four. -/
theorem Seed.critical_kernels_do_not_centralize
    (s : Seed T L H A n) (C : s.f8.CriticalPath)
    (hlarge : LargeDisplacement (setup T L s.V H A)) : ⁅C.DH,C.Ug⁆ ≠ ⊥ := by
  let E := setup T L s.V H A
  intro hc
  have hnot : ¬ C.Ug ≤ E.QH := by
    intro hle
    apply s.critical_centralizer_ne_span C hlarge
    rw [Dg_eq_core_intersection C, inf_eq_right.mpr hle]
  obtain ⟨y,hy,hyQ⟩ := SetLike.not_le_iff_exists.mp hnot
  let := ChapterF.Section08.Setup.lemma_F_8_5_two s.f8
  let : IsElementaryAbelian 2 C.Ug := IsElementaryAbelian.map _
  have hy2 : y^2 ∈ E.QH := by
    rw [elemPow_eq_one_of_isElementaryAbelian y hy]
    exact E.QH.one_mem
  have hfix : C.DH ≤ commutatorPreimage E.U (zpowers y) E.V₁ :=
    le_commutatorPreimage (commutatorPreimage_le _ _ _)
      ((commutator_mono le_rfl (zpowers_le.mpr hy)).trans (hc.le.trans bot_le))
  have hi := (relIndex_le_of_le_left hfix
    (show C.DH.relIndex E.U ≠ 0 from index_ne_zero_of_finite)).trans
    (s.critical_indices_le_sixteen C).2
  have hsmall : displacement E y ≤ 4 := by
    have hh := Nat.log_mono_right (b := 2) hi
    exact hh.trans (by decide)
  have hbig : 9 ≤ displacement E y := hlarge y (C.Ug_le_H hy) hy2 hyQ
  omega

/-- Select an endpoint conjugate of the natural module moved by DH, retaining
its point, its normalizer and its intersection with the original two-core. -/
theorem Seed.exists_moved_endpoint_module
    (s : Seed T L H A n) (C : s.f8.CriticalPath)
    (hlarge : LargeDisplacement (setup T L s.V H A)) :
    ∃ b : (setup T L s.V H A).H,
      let W := s.V.map (MulAut.conj ((C.g : G) * b)).toMonoidHom
      W ≤ C.Ug ∧ C.A₁ ≤ W ∧ ⁅C.DH,W⁆ ≠ ⊥ ∧
        C.DH ≤ normalizer (W : Set G) ∧ W ⊓ (setup T L s.V H A).QH ≤
          centralizer (C.DH : Set G) := by
  let E := setup T L s.V H A
  have hspan : C.Ug = ⨆ b : E.H, E.V.map
      (MulAut.conj ((C.g : G)*b)).toMonoidHom := by
    change (conjugateSpanBy E.V E.H).map _ = _
    rw [conjugateSpanBy_eq_iSup_conj, Subgroup.map_iSup]
    congr 1
    funext b
    change (E.V.conjBy b).conjBy C.g = _
    rw [← conjBy_mul]
    rfl
  have hm : ∃ b : E.H, ⁅C.DH,E.V.map
      (MulAut.conj ((C.g : G)*b)).toMonoidHom⁆ ≠ ⊥ := by
    by_contra! hh
    apply s.critical_kernels_do_not_centralize C hlarge
    apply commutator_eq_bot_iff_le_centralizer.mpr
    apply le_centralizer_iff.mpr
    rw [hspan]
    exact iSup_le fun b => le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp (hh b))
  obtain ⟨b,hb⟩ := hm
  let W := E.V.map (MulAut.conj ((C.g : G)*b)).toMonoidHom
  have hWU : W ≤ C.Ug := by rw [hspan]; exact le_iSup_of_le b le_rfl
  have hAW : C.A₁ ≤ W := by
    have hpoint := mem_normalizer_iff_map_conj_eq.mp (s.f8.H_le b.property)
    change E.V₁.conjBy C.g ≤ E.V.conjBy ((C.g : G)*b)
    rw [conjBy_mul]
    change _ ≤ (E.V.map (MulAut.conj (b : G)).toMonoidHom).map _
    have hp : E.V₁ ≤ E.V.map (MulAut.conj (b : G)).toMonoidHom :=
      hpoint.symm.le.trans (map_mono s.f8.point_le)
    exact map_mono hp
  refine ⟨b,hWU,hAW,hb,?_,kernel_intersection_centralizes C W hWU⟩
  apply le_normalizer_iff_commutator_le_left.mpr
  exact ((commutator_mono hWU le_rfl).trans C.centralizer_commutators.1).trans hAW

end CFSG.Quasithin.Chapter6.Source.RankOneGeneric.LinearParity
