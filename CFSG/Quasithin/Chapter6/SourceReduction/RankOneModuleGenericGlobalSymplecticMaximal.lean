private def cubicMovingSpace {X V : Type*} [Group X] [AddCommGroup V]
    [Module (ZMod 2) V] (ρ : Representation (ZMod 2) X V)
    (z : X) (hz : z ∈ center X) : Subrepresentation ρ where
  toSubmodule := (ρ z * ρ z + ρ z + 1).ker
  apply_mem_toSubmodule g := by
    intro v hv
    have he (w : V) : ρ z (ρ g w) = ρ g (ρ z w) := by
      change (ρ z * ρ g) w = (ρ g * ρ z) w
      rw [← map_mul, ← map_mul, (mem_center_iff.mp hz g).symm]
    change ρ z (ρ z (ρ g v)) + ρ z (ρ g v) + ρ g v = 0
    rw [he,he,←map_add,←map_add]
    rw [show ρ z (ρ z v) + ρ z v + v = 0 from hv,map_zero]

private theorem cover_no_small_action {X V : Type*} [Group X] [Finite X]
    [IsQuasisimple X] [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V]
    (e : (X ⧸ center X) ≃* alternatingGroup (Fin 7)) (hc : Nat.card (center X) = 3)
    (ρ : Representation (ZMod 2) X V) (hρ : Function.Injective ρ)
    (hd : Module.finrank (ZMod 2) V ≤ 8) : False := by
  obtain ⟨z,hz⟩ := exists_prime_orderOf_dvd_card' (G := center X) 3 (by rw [hc])
  have hz1 : (z : X) ≠ 1 := by
    intro he
    have he' : z = 1 := Subtype.ext he
    simp [he'] at hz
  have hz3 : (z : X)^3 = 1 := by
    have hh := pow_orderOf_eq_one z
    rw [hz] at hh
    exact congrArg Subtype.val hh
  have hcube (v : V) : ρ z (ρ z (ρ z v)) = v := by
    change (ρ z * (ρ z * ρ z)) v = v
    rw [←map_mul,←map_mul,show (z : X) * ((z : X) * (z : X)) = (z : X)^3 by simp [pow_succ,mul_assoc],hz3,map_one]
    rfl
  have hex : ∃ v, ρ z v ≠ v := by
    by_contra! hh
    exact hz1 (hρ (show ρ z = ρ 1 by rw [map_one]; exact LinearMap.ext hh))
  obtain ⟨v,hv⟩ := hex
  have hne : cubicMovingSpace ρ z z.property ≠ ⊥ := by
    intro hb
    have hm : ρ z v - v ∈ cubicMovingSpace ρ z z.property := by
      change ρ z (ρ z (ρ z v - v)) + ρ z (ρ z v - v) + (ρ z v - v) = 0
      simp only [map_sub,hcube]
      abel
    rw [hb] at hm
    exact hv (sub_eq_zero.mp hm)
  obtain ⟨W,hWa,hWle⟩ := (eq_bot_or_exists_atom_le (cubicMovingSpace ρ z z.property)).resolve_left hne
  let : W.toRepresentation.IsIrreducible := (Subrepresentation.irreducible_iff_isAtom W).mpr hWa
  have hzk : (z : X) ∉ W.toRepresentation.ker := by
    intro hk
    let : Nontrivial W.toSubmodule := Subrepresentation.irreducible_module_nontrivial W.toRepresentation
    obtain ⟨w,hw⟩ := exists_ne (0 : W.toSubmodule)
    have he : ρ z w.val = w.val := congrArg (fun f : Module.End (ZMod 2) W.toSubmodule => (f w).val) hk
    have hh := hWle w.property
    change ρ z (ρ z w.val) + ρ z w.val + w.val = 0 at hh
    rw [he,he] at hh
    have htwo : w.val + w.val = 0 := by
      have ht : (2 : ZMod 2) • w.val = 0 := by rw [show (2 : ZMod 2) = 0 from by decide,zero_smul]
      simpa only [two_smul] using ht
    rw [htwo,zero_add] at hh
    exact hw (Subtype.ext hh)
  have hf : Function.Injective W.toRepresentation := by
    apply W.toRepresentation.ker_eq_bot_iff.mp
    rcases IsQuasisimple.normal_le_center_or_eq_top W.toRepresentation.ker with hle | ht
    · have hdiv := card_dvd_of_injective (inclusion hle) (inclusion_injective hle)
      rw [hc] at hdiv
      rcases (Nat.dvd_prime Nat.prime_three).mp hdiv with h1 | h3
      · exact card_eq_one.mp h1
      · have he : W.toRepresentation.ker = center X := eq_of_le_of_card_ge hle (by rw [hc,h3])
        exact (hzk (by rw [he]; exact z.property)).elim
    · exact (hzk (ht ▸ mem_top _)).elim
  exact ChapterG.Section07.AlternatingSevenCover.no_small_faithful_binary_representation
    e hc W.toRepresentation hf ((Submodule.finrank_le W.toSubmodule).trans hd)

variable {G : Type*} [Group G] [Finite G]

private def coreEquivOfAmbientEq {K J : Subgroup G}
    (hc : J.pCoreIn 2 = K.pCoreIn 2) : pCore 2 J ≃* pCore 2 K :=
  ((pCore 2 J).equivMapOfInjective J.subtype J.subtype_injective).trans
    ((MulEquiv.subgroupCongr hc).trans
      ((pCore 2 K).equivMapOfInjective K.subtype K.subtype_injective).symm)

open Theory.SpecificGroups.SymplecticFour in
private theorem symplectic_core_structure
    (F : Type) [Field F] [Finite F] [CharP F 2]
    {m : ℕ} (hm : 1 < m) (hF : Nat.card F = 2^m) (j : Bool) :
    let K := (if j then pointLocal (F := F) else planeLocal : Subgroup (Sp F))
    IsElementaryAbelian 2 (pCore 2 K) ∧ Nat.card (pCore 2 K) = Nat.card F ^ 3 := by
  cases j
  · change IsElementaryAbelian 2 (pCore 2 (planeLocal (F := F))) ∧
      Nat.card (pCore 2 (planeLocal (F := F))) = Nat.card F ^ 3
    rw [planeLocal_core_eq hF hm]
    exact ⟨inferInstance,EvenTwoRank.card_plane_radical⟩
  · change IsElementaryAbelian 2 (pCore 2 (pointLocal (F := F))) ∧
      Nat.card (pCore 2 (pointLocal (F := F))) = Nat.card F ^ 3
    rw [pointLocal_core_eq hF hm]
    refine ⟨inferInstance,?_⟩
    let a : pointRadical (F := F) ≃ F × F × F := {
      toFun q := (q.val.val.val (.inl 1) (.inr 0), q.val.val.val (.inr 1) (.inr 0),
        q.val.val.val (.inl 0) (.inr 0))
      invFun x := ⟨pointRadicalElement x.1 x.2.1 x.2.2,pointRadicalElement_mem _ _ _⟩
      left_inv q := Subtype.ext (pointRadical_eq_element q.val q.property).symm
      right_inv _ := rfl }
    rw [Nat.card_congr a,Nat.card_prod,Nat.card_prod]
    ring

private theorem core_action {X : Type*} [Group X]
    (h : HasCharacteristicTwo X) [IsMulCommutative (pCore 2 X)] :
    ∃ f : (X ⧸ pCore 2 X) →* MulAut (pCore 2 X), Function.Injective f ∧
      ∀ (g : X) (x : pCore 2 X),
        (f (QuotientGroup.mk' (pCore 2 X) g) x : X) = g * (x : X) * g⁻¹ := by
  have hc : pCore 2 X ≤ centralizer (pCore 2 X : Set X) := by
    intro x hx
    exact mem_centralizer_iff.mpr (fun y hy => setLike_mul_comm hy hx)
  let f := MulAut.quotientConjNormal (pCore 2 X) (pCore 2 X) hc
  refine ⟨f,?_,fun _ _ => rfl⟩
  apply (QuotientGroup.injective_lift_iff _ _ _).mpr
  rw [MulAut.conjNormal_ker_eq_centralizer]
  exact le_antisymm hc h

/-- Every symplectic-row overcomponent acts faithfully on its elementary core
of order 2^(3n), through literal conjugation on quotient representatives. -/
theorem Preparation.symplectic_overcomponent_action
    {T : Sylow 2 G} {L W H A B J : Subgroup G} {n : ℕ}
    (d : Preparation T L H A B (residual H))
    (h : Input KnownSimple.IsKnownSimple T L W n)
    (hTH : (T : Subgroup G) ≤ H) (hp : Group.IsPerfect (residual H))
    (F : Type) [Field F] [Finite F] [CharP F 2]
    {m : ℕ} (hm : 0 < m) (hF : Nat.card F = 2^m)
    (he : Nonempty (RankTwoAmalgam.Iso
      (sourceParabolicAmalgam ![L,residual H] (sourceS L H))
      (ChapterF.GreenBook.LieModels.SymplecticFour.amalgam F)) ∨
      Nonempty (RankTwoAmalgam.Iso
      (sourceParabolicAmalgam ![L,residual H] (sourceS L H))
      (ChapterF.GreenBook.LieModels.SymplecticFour.amalgam F).reverse))
    (hJ : J ∈ Chapter1.L G (T : Subgroup G)) (hKJ : residual H ≤ J) :
    IsElementaryAbelian 2 (pCore 2 J) ∧ Nat.card (pCore 2 J) = 2^(3*n) ∧
    ∃ f : (J ⧸ pCore 2 J) →* MulAut (pCore 2 J), Function.Injective f ∧
      ∀ (g : J) (x : pCore 2 J),
        (f (QuotientGroup.mk' (pCore 2 J) g) x : J) = g * (x : J) * g⁻¹ := by
  have hc := (d.symplectic_overcomponent_core h hTH hp F hm hF he hJ hKJ).1
  have hmn := (d.symplectic_amalgam_blocks h hTH hp F hm hF he).1
  have hs : IsElementaryAbelian 2 (pCore 2 J) ∧ Nat.card (pCore 2 J) = 2^(3*n) := by
    have hh (j : Bool)
        (a : residual H ≃* (if j then Theory.SpecificGroups.SymplecticFour.pointLocal (F := F)
          else Theory.SpecificGroups.SymplecticFour.planeLocal : Subgroup _))
        (hm' : 1 < m) :
        IsElementaryAbelian 2 (pCore 2 J) ∧ Nat.card (pCore 2 J) = 2^(3*n) := by
      let b := (coreEquivOfAmbientEq hc).trans
        ((a.subgroupMap _).trans (MulEquiv.subgroupCongr (pCore_map_iso 2 a)))
      obtain ⟨ha,hcard⟩ := symplectic_core_structure F hm' hF j
      let := ha
      refine ⟨IsElementaryAbelian.of_injective b.toMonoidHom b.injective,?_⟩
      rw [Nat.card_congr b.toEquiv,hcard,hF,hmn,←pow_mul,Nat.mul_comm]
    rcases he with he | he <;> obtain ⟨e⟩ := he
    · obtain ⟨hm',⟨a⟩,_⟩ := BlockComparison.symplectic_parabolic_factor d h hTH hp F hm hF 1 false e.right
      exact hh false a hm'
    · obtain ⟨hm',⟨a⟩,_⟩ := BlockComparison.symplectic_parabolic_factor d h hTH hp F hm hF 1 true e.right
      exact hh true a hm'
  let := hs.1
  exact ⟨hs.1,hs.2,core_action (Chapter1.Section02.Adequate.mem_L_hasCharacteristicTwo T
    (h.qtke.evenCharacteristic T) hJ)⟩

private theorem shortlist_six
    {X E : Type*} [Group X] [Finite X] [Group E] [Finite E]
    [IsElementaryAbelian 2 E] (hc : Nat.card E = 2^6)
    (hm : ChapterA.Section03.SourceEmbeddings.AlternatingFive.Shortlist X)
    (f : X →* MulAut E) (hf : Function.Injective f) :
    Nonempty (X ≃* alternatingGroup (Fin 7)) := by
  have hd : Nat.card X ∣ 20158709760 := by
    have hh := card_dvd_of_injective f hf
    rw [SmallNonabelianTwoGroup.card_mulAut_elementary_two_pow E 6 hc] at hh
    norm_num [Fin.prod_univ_succ] at hh ⊢
    exact hh
  rcases hm with hm | hm | hm | hm | ⟨p,hp,hm⟩
  · exact hm
  · obtain ⟨hq,⟨ez⟩,⟨eq⟩⟩ := hm
    let := hq
    let a := IsElementaryAbelian.mulAutLinearEquivOfCard E hc
    let ρ := (Representation.generalLinearNatural (F := ZMod 2) 6).comp (a.toMonoidHom.comp f)
    have hi : Function.Injective ρ :=
      (Representation.generalLinearNatural_injective 6).comp (a.injective.comp hf)
    exact (cover_no_small_action eq (by rw [Nat.card_congr ez.toEquiv]; exact Nat.card_zmod 3)
      ρ hi (by simp)).elim
  · obtain ⟨e⟩ := hm
    rw [Nat.card_congr e.toEquiv,Janko1.card_model] at hd
    norm_num at hd
  · obtain ⟨F,_,_,hF,⟨e⟩⟩ := hm
    have he := Matrix.ProjectiveSpecialLinearGroup.psl2_card_twice (F := F) (hF ▸ (by decide : Odd 25))
    rw [hF,←Nat.card_congr e.toEquiv] at he
    have hcard : Nat.card X = 7800 := by omega
    rw [hcard] at hd
    norm_num at hd
  · obtain ⟨F,_,_,hF,⟨e⟩⟩ := hm
    have he := Matrix.ProjectiveSpecialLinearGroup.psl2_card_twice (F := F) (hF ▸ hp.2.1)
    rw [hF,←Nat.card_congr e.toEquiv] at he
    have hd' : p ∣ 40317419520 := by
      have hh := Nat.mul_dvd_mul_left 2 hd
      rw [Nat.mul_comm 2 (Nat.card X),he] at hh
      exact (dvd_mul_right p (p^2-1)).trans hh
    have hps : p = 2 ∨ p = 3 ∨ p = 5 ∨ p = 7 ∨ p = 31 := by
      have hh : p ∣ 2^16 * 3^4 * 5 * 7^2 * 31 := hd'
      rcases hp.1.dvd_mul.mp hh with hh | hh
      · rcases hp.1.dvd_mul.mp hh with hh | hh
        · rcases hp.1.dvd_mul.mp hh with hh | hh
          · rcases hp.1.dvd_mul.mp hh with hh | hh
            · exact .inl ((Nat.prime_dvd_prime_iff_eq hp.1 Nat.prime_two).mp (hp.1.dvd_of_dvd_pow hh))
            · exact .inr (.inl ((Nat.prime_dvd_prime_iff_eq hp.1 Nat.prime_three).mp (hp.1.dvd_of_dvd_pow hh)))
          · exact .inr (.inr (.inl ((Nat.prime_dvd_prime_iff_eq hp.1 (by decide)).mp hh)))
        · exact .inr (.inr (.inr (.inl ((Nat.prime_dvd_prime_iff_eq hp.1 (by decide)).mp (hp.1.dvd_of_dvd_pow hh)))))
      · exact .inr (.inr (.inr (.inr ((Nat.prime_dvd_prime_iff_eq hp.1 (by decide)).mp hh))))
    rcases hps with rfl | rfl | rfl | rfl | rfl <;>
      norm_num [Chapter1.Section02.A312ExceptionalPrime] at hp

/-- The symplectic row leaves only the genuine A₇ quotient if the original
right residual has a proper local overcomponent; in particular n = 2. -/
theorem Preparation.symplectic_overcomponent_alternating_seven
    {T : Sylow 2 G} {L W H A B J : Subgroup G} {n : ℕ}
    (d : Preparation T L H A B (residual H))
    (h : Input KnownSimple.IsKnownSimple T L W n)
    (hTH : (T : Subgroup G) ≤ H) (hp : Group.IsPerfect (residual H))
    (F : Type) [Field F] [Finite F] [CharP F 2]
    {m : ℕ} (hm : 0 < m) (hF : Nat.card F = 2^m)
    (he : Nonempty (RankTwoAmalgam.Iso
      (sourceParabolicAmalgam ![L,residual H] (sourceS L H))
      (ChapterF.GreenBook.LieModels.SymplecticFour.amalgam F)) ∨
      Nonempty (RankTwoAmalgam.Iso
      (sourceParabolicAmalgam ![L,residual H] (sourceS L H))
      (ChapterF.GreenBook.LieModels.SymplecticFour.amalgam F).reverse))
    (hJ : J ∈ Chapter1.L G (T : Subgroup G)) (hKJ : residual H < J) :
    n = 2 ∧ Nonempty ((J ⧸ pCore 2 J) ≃* alternatingGroup (Fin 7)) := by
  obtain ⟨hn,hl⟩ := d.block_overcomponent_parameter h hTH hp F hm hF (.inr he) hJ hKJ
  subst n
  obtain ⟨ha,hcard,f,hf,_⟩ := d.symplectic_overcomponent_action h hTH hp F hm hF he hJ hKJ.le
  let := ha
  exact ⟨rfl,shortlist_six hcard hl f hf⟩

open ChapterC in
private theorem common_core_short
    {K J : Type*} [Group K] [Finite K] [Group J] [Finite J]
    (hK : IsShort K) (hJp : Group.IsPerfect J) (hJc : HasCharacteristicTwo J)
    (f : K →* J) (hf : Function.Injective f)
    (hc : (pCore 2 K).map f = pCore 2 J) (hUK : blockU K = pCore 2 K)
    (hq : IsSimpleGroup (J ⧸ pCore 2 J)) :
    IsShort J ∧ blockU J = pCore 2 J := by
  let := hJp
  let := hq
  have hpre : (pCore 2 J).comap f = pCore 2 K := by
    rw [←hc,comap_map_eq,(MonoidHom.ker_eq_bot_iff f).mpr hf,sup_bot_eq]
  have hUJ : blockU J = pCore 2 J := by
    apply le_antisymm blockU_le_core
    rw [←hc,←hUK]
    change (⁅pCore 2 K,⊤⁆ : Subgroup K).map f ≤ ⁅pCore 2 J,⊤⁆
    rw [map_commutator,hc]
    exact commutator_mono le_rfl le_top
  have hE : IsElementaryAbelian 2 (pCore 2 J) := by
    let : IsElementaryAbelian 2 (pCore 2 K) := hUK ▸ hK.elementary
    rw [←hc]
    exact IsElementaryAbelian.map f
  let := hE
  have hnot : ¬ f.range ≤ pCore 2 J := by
    intro hh
    have ht : pCore 2 K = ⊤ := by
      rw [←hpre]
      exact top_unique (by intro x _; exact hh ⟨x,rfl⟩)
    have hb : blockU K = ⊥ := by
      let : IsElementaryAbelian 2 (pCore 2 K) := hUK ▸ hK.elementary
      apply commutator_top_right_eq_bot_iff_le_center.mpr
      intro x hx
      apply mem_center_iff.mpr
      intro y
      exact setLike_mul_comm (show y ∈ pCore 2 K from ht ▸ mem_top y) hx
    exact hK.core_ne_bot (hUK.symm.trans hb)
  have hcentral (N : Subgroup J) [N.Normal] (hN : N ≤ pCore 2 J)
      (hKN : N.comap f ≤ center K) : N ≤ center J := by
    let a : J →* MulAut N := MulAut.conjNormal
    have hQa : pCore 2 J ≤ a.ker := by
      rw [MulAut.conjNormal_ker_eq_centralizer]
      intro q hq
      exact mem_centralizer_iff.mpr (fun x hx => setLike_mul_comm (hN hx) hq)
    have hKa : f.range ≤ a.ker := by
      rw [MulAut.conjNormal_ker_eq_centralizer]
      rintro _ ⟨k,rfl⟩
      apply mem_centralizer_iff.mpr
      intro x hx
      have hxmap : x ∈ (pCore 2 K).map f := by rw [hc]; exact hN hx
      obtain ⟨y,hy,rfl⟩ := hxmap
      simpa only [map_mul] using (congrArg f (mem_center_iff.mp (hKN (show y ∈ N.comap f from hx)) k)).symm
    let q := QuotientGroup.mk' (pCore 2 J)
    have ha : a.ker = ⊤ := by
      rcases (inferInstance : (a.ker.map q).Normal).eq_bot_or_eq_top with hz | ht
      · have hh : a.ker ≤ pCore 2 J := by
          have hh : a.ker ≤ q.ker := (Subgroup.map_eq_bot_iff a.ker).mp hz
          simpa only [q,QuotientGroup.ker_mk'] using hh
        exact (hnot (hKa.trans hh)).elim
      · have hh := congrArg (comap q) ht
        simpa only [comap_map_eq,q,QuotientGroup.ker_mk',sup_eq_left.mpr hQa,comap_top] using hh
    intro x hx
    apply mem_center_iff.mpr
    intro j
    have hj : j ∈ a.ker := ha ▸ mem_top j
    have he := congrArg (fun b : MulAut N => (b ⟨x,hx⟩ : J)) hj
    change j * x * j⁻¹ = x at he
    exact mul_inv_eq_iff_eq_mul.mp he
  have hd (N : Subgroup J) [N.Normal] (hle : N ≤ pCore 2 J) :
      N ≤ center J ∨ N = pCore 2 J := by
    let M := N.comap f
    have hM : M ≤ pCore 2 K := hpre ▸ comap_mono hle
    have hz : pCore 2 K ⊓ center K ≤ M ⊔ (pCore 2 K ⊓ center K) := le_sup_right
    have hu := hK.irreducible.2 (M ⊔ (pCore 2 K ⊓ center K)) inferInstance
      (by simpa only [hUK] using hz) (by rw [hUK]; exact sup_le hM inf_le_left)
    rw [hUK] at hu
    rcases hu with hz | ht
    · exact .inl (hcentral N hle (le_sup_left.trans (hz.le.trans inf_le_right)))
    · right
      have hQM : pCore 2 K ≤ M := by
        calc
          pCore 2 K = ⁅pCore 2 K,⊤⁆ := hUK.symm
          _ = ⁅M ⊔ (pCore 2 K ⊓ center K),⊤⁆ := by rw [ht]
          _ ≤ M := by
            apply commutator_sup_le_of_relative_normal ⊤ M (pCore 2 K ⊓ center K) ⊤ M
              (by rw [normalizer_eq_top]) le_top le_top (commutator_le_left _ _) ?_
            exact (commutator_mono inf_le_right le_rfl).trans (by simp)
      apply le_antisymm hle
      rw [←hc]
      exact (map_mono hQM).trans (map_comap_le _ _)
  have hQne : pCore 2 J ≠ ⊥ := by
    rw [←hc]
    exact fun hh => hK.core_ne_bot ((map_eq_bot_iff_of_injective _ hf).mp hh)
  have hQnoncentral : ¬ pCore 2 J ≤ center J := by
    intro hz
    have hh : blockU J = ⊥ := commutator_top_right_eq_bot_iff_le_center.mpr hz
    exact hQne (hUJ.symm.trans hh)
  have hirr : BlockModuleIrreducible J := by
    constructor
    · rw [hUJ]
      exact lt_of_le_of_ne inf_le_left (fun he => hQnoncentral (he ▸ inf_le_right))
    · intro N hn hlow hhigh
      rw [hUJ] at hlow hhigh ⊢
      let := hn
      rcases hd N hhigh with hz | ht
      · exact .inl (le_antisymm (le_inf hhigh hz) hlow)
      · exact .inr ht
  have htwo : IsPPerfect 2 J := by
    intro D hD hqD
    let : D.Normal := hD
    by_contra hne
    let : Nontrivial (J ⧸ D) := QuotientGroup.nontrivial_iff.mpr hne
    let : Group.IsPerfect (J ⧸ D) := Group.IsPerfect.ofSurjective (QuotientGroup.mk'_surjective D)
    let : Group.IsNilpotent (J ⧸ D) := hqD.isNilpotent
    exact Group.IsPerfect.not_isSolvable (J ⧸ D) inferInstance
  have hquasi : IsQuasisimple (J ⧸ pCore 2 J) := by
    have hz : center (J ⧸ pCore 2 J) = ⊥ :=
      (inferInstance : (center (J ⧸ pCore 2 J)).Normal).eq_bot_or_eq_top.resolve_right
        (fun ht => Group.IsPerfect.not_isMulCommutative _ (center_eq_top_iff.mp ht))
    exact ⟨((QuotientGroup.quotientMulEquivOfEq hz).trans QuotientGroup.quotientBot).isSimpleGroup⟩
  refine ⟨⟨inferInstance,htwo,generalizedFitting_eq_pCore_of_selfCentralizing 2 hJc,
    hUJ ▸ hE,?_,.inl hquasi,hirr⟩,hUJ⟩
  rw [hUJ]
  intro x hx
  exact mem_centralizer_iff.mpr (fun y hy => setLike_mul_comm hy hx)

open ChapterC ChapterC.ExceptionalRestrictions Representation in
private theorem short_six_alternating
    {J : Type*} [Group J] [Finite J]
    (h : IsShort J) (e : (J ⧸ pCore 2 J) ≃* alternatingGroup (Fin 7))
    (hc : Nat.card (blockU J) = 2^6) : IsAlternatingBlock J 7 := by
  let := h.elementary
  let := h.module_elementary
  let := h.module_nontrivial
  let ρ := moduleRepresentation h
  have hn : ρ ≠ 1 := by
    intro he
    have he' : moduleRepresentation h = 1 := he
    have hk : Coinvariants.ker (uRepresentation h) ≤ (moduleProjection (L := J)).ker := by
      apply Submodule.span_le.mpr
      rintro _ ⟨⟨g,v⟩,rfl⟩
      change moduleProjection (uRepresentation h g v - v) = 0
      rw [map_sub,moduleProjection_equivariant,he']
      exact sub_self _
    rw [uRepresentation_moved h] at hk
    obtain ⟨w,hw⟩ := exists_ne (0 : Additive (BlockModule J))
    obtain ⟨v,rfl⟩ := moduleProjection_surjective w
    exact hw (hk Submodule.mem_top)
  let : IsSimpleGroup (alternatingGroup (Fin 7)) := alternatingGroup.isSimpleGroup (by simp)
  let : IsSimpleGroup (J ⧸ pCore 2 J) := e.isSimpleGroup
  have hf : Function.Injective ρ := by
    rcases ρ.normal_ker.eq_bot_or_eq_top with hz | ht
    · exact ρ.ker_eq_bot_iff.mp hz
    · exact (hn (MonoidHom.ker_eq_top_iff.mp ht)).elim
  let τ := ρ.comp e.symm.toMonoidHom
  have hi : IsIrreducible τ := (irreducible_comp_surjective_iff e.symm.toMonoidHom
    e.symm.surjective ρ).mpr (moduleRepresentation_irreducible h)
  have hd : Module.finrank (ZMod 2) (Additive (BlockModule J)) ≤ 6 := by
    have hh := Nat.card_le_card_of_surjective (QuotientGroup.mk' (blockFixed J))
      (QuotientGroup.mk'_surjective (blockFixed J))
    rw [hc] at hh
    have hcard : Nat.card (BlockModule J) = 2 ^ Module.finrank (ZMod 2) (Additive (BlockModule J)) := by
      exact (Module.natCard_eq_pow_finrank (K := ZMod 2) (V := Additive (BlockModule J))).trans
        (by rw [Nat.card_zmod])
    rw [hcard] at hh
    exact (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp hh
  rcases ChapterK.Alternating.sevenSmallDegreeSpectrum τ (hf.comp e.symm.injective) hi
      (by omega) with hd4 | hd6 | hd14
  · have hex : IsExceptionalA7Block J := ⟨h,⟨e⟩,by
      have hh := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := Additive (BlockModule J))
      rw [Nat.card_zmod,hd4] at hh
      exact (Nat.card_congr (Additive.toMul : Additive (BlockModule J) ≃ BlockModule J)).symm.trans hh⟩
    have hh := hex.u_card
    rw [hc] at hh
    norm_num at hh
  · exact short_a7_block_of_six h e hd6
  · omega

private theorem symplectic_factor_core_generated
    {T : Sylow 2 G} {L W H A B : Subgroup G} {n : ℕ}
    (d : Preparation T L H A B (residual H))
    (h : Input KnownSimple.IsKnownSimple T L W n)
    (hTH : (T : Subgroup G) ≤ H) (hp : Group.IsPerfect (residual H))
    (F : Type) [Field F] [Finite F] [CharP F 2]
    {m : ℕ} (hm : 0 < m) (hF : Nat.card F = 2^m)
    (he : Nonempty (RankTwoAmalgam.Iso
      (sourceParabolicAmalgam ![L,residual H] (sourceS L H))
      (ChapterF.GreenBook.LieModels.SymplecticFour.amalgam F)) ∨
      Nonempty (RankTwoAmalgam.Iso
      (sourceParabolicAmalgam ![L,residual H] (sourceS L H))
      (ChapterF.GreenBook.LieModels.SymplecticFour.amalgam F).reverse)) :
    ChapterC.blockU (residual H) = pCore 2 (residual H) := by
  open Theory.SpecificGroups.SymplecticFour in
  have hg (j : Bool) (hm' : 1 < m)
      (a : residual H ≃* (if j then pointLocal (F := F) else planeLocal : Subgroup (Sp F))) :
      ChapterC.blockU (residual H) = pCore 2 (residual H) := by
    apply map_injective (f := a.toMonoidHom) a.injective
    rw [ChapterC.blockU,map_commutator,pCore_map_iso 2 a,
      map_top_of_surjective a.toMonoidHom a.surjective]
    cases j
    · change ⁅pCore 2 (planeLocal (F := F)),⊤⁆ = pCore 2 (planeLocal (F := F))
      rw [planeLocal_core_commutator hF hm',planeLocal_core_eq hF hm']
    · change ⁅pCore 2 (pointLocal (F := F)),⊤⁆ = pCore 2 (pointLocal (F := F))
      rw [pointLocal_core_commutator hF hm',pointLocal_core_eq hF hm']
  rcases he with he | he <;> obtain ⟨e⟩ := he
  · obtain ⟨hm',⟨a⟩,_⟩ := BlockComparison.symplectic_parabolic_factor d h hTH hp F hm hF 1 false e.right
    exact hg false hm' a
  · obtain ⟨hm',⟨a⟩,_⟩ := BlockComparison.symplectic_parabolic_factor d h hTH hp F hm hF 1 true e.right
    exact hg true hm' a

/-- The Sp₄ row has no proper local overcomponent, including the field-four
case. The ordinary A₇ module is incompatible with the original natural
L₂(4) block, while the exceptional A₇ module is too small for the core. -/
theorem Preparation.symplectic_overcomponent_eq
    {T : Sylow 2 G} {L W H A B J : Subgroup G} {n : ℕ}
    (d : Preparation T L H A B (residual H))
    (h : Input KnownSimple.IsKnownSimple T L W n)
    (hTH : (T : Subgroup G) ≤ H) (hp : Group.IsPerfect (residual H))
    (F : Type) [Field F] [Finite F] [CharP F 2]
    {m : ℕ} (hm : 0 < m) (hF : Nat.card F = 2^m)
    (he : Nonempty (RankTwoAmalgam.Iso
      (sourceParabolicAmalgam ![L,residual H] (sourceS L H))
      (ChapterF.GreenBook.LieModels.SymplecticFour.amalgam F)) ∨
      Nonempty (RankTwoAmalgam.Iso
      (sourceParabolicAmalgam ![L,residual H] (sourceS L H))
      (ChapterF.GreenBook.LieModels.SymplecticFour.amalgam F).reverse))
    (hJ : J ∈ Chapter1.L G (T : Subgroup G)) (hKJ : residual H ≤ J) : J = residual H := by
  by_contra hne
  obtain ⟨hn,⟨eJ⟩⟩ := d.symplectic_overcomponent_alternating_seven h hTH hp F hm hF he hJ
    (lt_of_le_of_ne hKJ (Ne.symm hne))
  subst n
  have hK := (d.symplectic_amalgam_blocks h hTH hp F hm hF he).2.2
  have hUK := symplectic_factor_core_generated d h hTH hp F hm hF he
  have hcore := (d.symplectic_overcomponent_core h hTH hp F hm hF he hJ hKJ).1
  let f := inclusion hKJ
  have hc : (pCore 2 (residual H)).map f = pCore 2 J := by
    apply map_injective J.subtype_injective
    rw [map_map]
    exact hcore.symm
  let : IsSimpleGroup (alternatingGroup (Fin 7)) := alternatingGroup.isSimpleGroup (by simp)
  obtain ⟨hshort,hUJ⟩ := common_core_short hK.2.1 (Chapter1.mem_L_isPerfect hJ)
    (Chapter1.Section02.Adequate.mem_L_hasCharacteristicTwo T (h.qtke.evenCharacteristic T) hJ)
    f (inclusion_injective hKJ) hc hUK eJ.isSimpleGroup
  have hcard := (d.symplectic_overcomponent_action h hTH hp F hm hF he hJ hKJ).2.1
  have hblock := short_six_alternating hshort eJ (by rw [hUJ]; exact hcard)
  have hk : ((QuotientGroup.mk' (pCore 2 J)).comp f).ker = pCore 2 (residual H) := by
    rw [←MonoidHom.comap_ker,QuotientGroup.ker_mk',←hc,comap_map_eq,
      (MonoidHom.ker_eq_bot_iff f).mpr (inclusion_injective hKJ),sup_bot_eq]
  let X := J ⊔ (T : Subgroup G)
  let JX := J.subgroupOf X
  let a : JX ≃* J := subgroupOfEquivOfLe le_sup_left
  let TX := T.subtype (show (T : Subgroup G) ≤ X from le_sup_right)
  obtain ⟨P,hP⟩ := TX.exists_subgroupOf_eq_of_subnormal JX hJ.1.subnormal
  let S := P.mapSurjective (f := a.toMonoidHom) a.surjective
  have hSJ : (S : Subgroup J) ≤ (T : Subgroup G).subgroupOf J := by
    change (P : Subgroup JX).map a.toMonoidHom ≤ _
    rw [hP]
    rintro y ⟨x,hx,rfl⟩
    exact hx
  have hSK : (S : Subgroup J) ≤ normalizer (f.range : Set J) := by
    rw [inclusion_range,← subgroupOf_normalizer_eq hKJ]
    exact hSJ.trans (comap_mono (hTH.trans (le_normalizer_residual H)))
  exact ChapterC.Section05.NormalizerControl.Matching.no_natural_two_in_alternating_seven
    hK hblock f (inclusion_injective hKJ) (by rw [hUK,hUJ,hc]) hk S hSK

/-- The right residual is maximal in every symplectic row. -/
theorem Preparation.symplectic_right_maximal
    {T : Sylow 2 G} {L W H A B : Subgroup G} {n : ℕ}
    (d : Preparation T L H A B (residual H))
    (h : Input KnownSimple.IsKnownSimple T L W n)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hp : Group.IsPerfect (residual H))
    (F : Type) [Field F] [Finite F] [CharP F 2]
    {m : ℕ} (hm : 0 < m) (hF : Nat.card F = 2^m)
    (he : Nonempty (RankTwoAmalgam.Iso
      (sourceParabolicAmalgam ![L,residual H] (sourceS L H))
      (ChapterF.GreenBook.LieModels.SymplecticFour.amalgam F)) ∨
      Nonempty (RankTwoAmalgam.Iso
      (sourceParabolicAmalgam ![L,residual H] (sourceS L H))
      (ChapterF.GreenBook.LieModels.SymplecticFour.amalgam F).reverse)) :
    residual H ∈ Chapter1.LStar G (T : Subgroup G) := by
  have hTH : (T : Subgroup G) ≤ H := hH.1.1.2
  have hRH : residual H ≤ H := map_subtype_le _
  have hb := (d.symplectic_amalgam_blocks h hTH hp F hm hF he).2.2
  obtain ⟨_,_,_,_,_,_,hbinary,_⟩ := hb
  let := hp
  let : IsSimpleGroup (residual H ⧸ pCore 2 (residual H)) :=
    ChapterC.Section05.NormalizerControl.EmbeddingSelection.binary_simple h.exponent hbinary
  have hz : center (residual H ⧸ pCore 2 (residual H)) = ⊥ :=
    (inferInstance : (center (residual H ⧸ pCore 2 (residual H))).Normal).eq_bot_or_eq_top.resolve_right
      (fun ht => Group.IsPerfect.not_isMulCommutative _ (center_eq_top_iff.mp ht))
  let : IsQuasisimple (residual H ⧸ pCore 2 (residual H)) :=
    ⟨((QuotientGroup.quotientMulEquivOfEq hz).trans QuotientGroup.quotientBot).isSimpleGroup⟩
  let e := (subgroupOfEquivOfLe hRH).symm
  let q := QuotientGroup.congr _ _ e (pCore_map_iso 2 e)
  let : IsQuasisimple (((residual H).subgroupOf H) ⧸ pCore 2 ((residual H).subgroupOf H)) :=
    IsQuasisimple.of_mulEquiv q
  have hn : ((residual H).subgroupOf H).Normal :=
    normal_subgroupOf_of_le_normalizer (le_normalizer_residual H)
  have hc := isCComponent_of_isPPerfect_of_quasisimple_core_quotient hn.isSubnormal
    ((isPPerfect_embedded_pResidual 2 H).of_surjective e.toMonoidHom e.surjective)
  have hmem : residual H ∈ Chapter1.L G (T : Subgroup G) := by
    change ((residual H).subgroupOf (residual H ⊔ (T : Subgroup G))).IsCComponent ∧ _
    rw [residual_sup_sylow T H hTH]
    refine ⟨hc,⟨T.subtype hTH,?_⟩,hH.1.1.1⟩
    simp only [Sylow.coe_subtype,map_subgroupOf_eq_of_le hTH]
  exact ⟨hmem,fun _ hJ hKJ => d.symplectic_overcomponent_eq h hTH hp F hm hF he hJ hKJ⟩

/-- The symplectic normalizer application now discharges right maximality at
all original exponents, as well as the common Sylow and both enlarged cores. -/
theorem Preparation.symplectic_normalizer_local_conditions
    {T : Sylow 2 G} {L W H A B : Subgroup G} {n : ℕ}
    (d : Preparation T L H A B (residual H))
    (h : Input KnownSimple.IsKnownSimple T L W n)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hp : Group.IsPerfect (residual H))
    (F : Type) [Field F] [Finite F] [CharP F 2]
    {m : ℕ} (hm : 0 < m) (hF : Nat.card F = 2^m)
    (he : Nonempty (RankTwoAmalgam.Iso
      (sourceParabolicAmalgam ![L,residual H] (sourceS L H))
      (ChapterF.GreenBook.LieModels.SymplecticFour.amalgam F)) ∨
      Nonempty (RankTwoAmalgam.Iso
      (sourceParabolicAmalgam ![L,residual H] (sourceS L H))
      (ChapterF.GreenBook.LieModels.SymplecticFour.amalgam F).reverse)) :
    Chapter5.Section03GreenExtension.SourceLocalConditions
      (normalizerAmalgam L (residual H)) L (residual H) ((T : Subgroup G) ⊓ L) := by
  have hmax := d.symplectic_right_maximal h hH hp F hm hF he
  have hc : ConcreteAmalgamComparison
      (sourceParabolicAmalgam ![L,residual H] (sourceS L H)) := .symplectic F m hm hF he
  exact d.normalizer_local_conditions h hH hmax rfl
    (d.common_sylow_of_comparison h hH.1.1.2 hp hc)
    (d.parabolic_sylow_core_eq_of_comparison h hH.1.1.2 hp hc)

