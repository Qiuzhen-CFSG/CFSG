module
public import CFSG.Quasithin.Chapter6.SourceReduction.LocalCentralization.FourThompson
public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleGenericExceptionalCartanLocalSix

/-!
# The original four-space Thompson comparison

The four-dimensional A₇ action identifies the original Thompson and
Baumann images as the same four-group. Its Thompson-fixed subgroup is a
plane of order four. The original KT is generated by its Thompson
normalizer and omega-centralizer; normalizers are lifted through O₂(KT).

The completed FF reduction and the six-space exclusion apply this to the
original source inputs whenever the escaping cubic centralizes omega.
The cubic comparison, block exclusions, degree restriction and final
Cartan escape remain with this local classification owner.

Source: Aschbacher–Smith 5.1.13, printed pp.637–638.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher
namespace CFSG.Quasithin.Chapter6.Source.RankOneGeneric
variable {G : Type*} [Group G] [Finite G]

/-- The genuine FF reduction supplies the right four-space Thompson control
on the original centralizing-cubic branch of the source proof. -/
theorem localCartan_noncentral_four_thompson_of_cubic_centralizes
    {T : Sylow 2 G} {L W H A B Y X D : Subgroup G} {n : ℕ}
    (h : Input KnownSimple.IsKnownSimple T L W n)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hgen : 1 < ChapterE.generationParameter H) (c : CartanPair T L H A B)
    (hY : Y ∈ Chapter1.HOver G (H : Set G))
    (d : LocalCartanWitness T H A Y X D) (hXC : ¬ X ≤ omegaCentralizer T)
    (hd : D ≤ omegaCentralizer T) :
    ∃ K : Subgroup G, LocalA7Configuration T L H X K ∧
      Nat.card (localOmegaModule T K) = 16 ∧
      Nat.card (localOmegaModule T K ⊓
        centralizer (elementaryAbelianMaxJ (T : Subgroup G) : Set G) : Subgroup G) = 4 ∧
      (((K ⊔ (T : Subgroup G)) ⊓ normalizer (elementaryAbelianMaxJ (T : Subgroup G) : Set G)) ⊔
        ((K ⊔ (T : Subgroup G)) ⊓ omegaCentralizer T) = K ⊔ (T : Subgroup G)) ∧
      (let M := K ⊔ (T : Subgroup G)
       let J := (elementaryAbelianMaxJ (T : Subgroup G)).subgroupOf M
       let B₀ := (ChapterB.baumann (T : Subgroup G)).subgroupOf M
       ∃ q : M →* alternatingGroup (Fin 7), Function.Surjective q ∧
         q.ker = pCore 2 M ∧ J.map q = B₀.map q ∧ IsElementaryAbelian 2 (J.map q) ∧
         Nat.card (J.map q) = 4 ∧
         normalizer (J : Set M) = (normalizer (J.map q : Set (alternatingGroup (Fin 7)))).comap q) := by
  obtain ⟨K,a⟩ := localCartan_ffReduction T L W n h H hH hgen A B c Y hY X D d hXC
  have hc := (a.four_of_cubic_centralizes h hH hgen d hd).1
  exact ⟨K,a,hc,a.four_thompson_fixed_card h hc,a.four_thompson_normalizer_generation h hc,
    a.four_original_thompson_quotient h hc⟩
end CFSG.Quasithin.Chapter6.Source.RankOneGeneric
