module

public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleNaturalFixedQuotientFourOffenderInner
public import CFSG.Quasithin.ChapterK.Section01To04.RankOne.Orthogonal.AmbientActors.GlobalActors
public import CFSG.Quasithin.ChapterK.Section01To04.RankOne.Orthogonal.InnerActors.Transport

/-!
# The complete numerical near-offender reduction for a marked orthogonal source

The genuine Chapter K source hypotheses and the same marked Hermitian module
reduce every elementary near-offender to half-degree two. Inner actors are
excluded by H.1.1(3); the actual outer calculation gives rank one or three,
with fixed codimension two or four respectively. The rank-three alternative
is retained: the full outer root group has rank s+1 and codimension 2s.

This supplies the numerical n=4 reduction used in 6.1.4 without asserting
the overly strong cyclic-only conclusion printed in H.1.1(2). Constructing
the marked source from original Hypothesis611 remains a separate task.
Source: Aschbacher–Smith, printed pp.378,454,664–665.
-/

public noncomputable section

open Subgroup Representation Representation.BinaryOffender
namespace CFSG.Quasithin.Chapter6.Source.FourOffender
open ChapterK.RankOne
open Representation.OrthogonalFourMinus.FiniteModel

variable {G V : Type*} [Group G] [Finite G]
  [AddCommGroup V] [Module (ZMod 2) V]
  {s : ℕ} [NeZero s] {ρ : Representation (ZMod 2) G V} {L : Subgroup G}
local instance markedFixedAlgebra : Algebra (ZMod 2) (fixedField s) := ZMod.algebra _ 2
local instance markedBinaryModule : Module (ZMod 2) (Space s) :=
  Module.compHom (Space s) (algebraMap (ZMod 2) (fixedField s))

/-- The arbitrary marked-source near-offender is outer and lies in exactly
the two numerical cases at half-degree two. -/
theorem marked_near_offender_cases
    (h : SourceHypotheses ρ L) (M : OrthogonalModel s ρ L) (hs : 1 < s)
    (A : Subgroup G) (hA : IsElementaryTwo A)
    (hnear : fixedCodim ρ A ≤ rank A + 1) :
    s = 2 ∧ ¬ A ≤ L ∧ IsQuadratic ρ A ∧
      ((rank A = 1 ∧ fixedCodim ρ A = 2) ∨
        (rank A = 3 ∧ fixedCodim ρ A = 4)) := by
  let : L.Normal := h.layer_normal
  have hout : ¬ A ≤ L := by
    intro hi
    have hb := inner_rank_add_degree_le_fixedCodim s (M.innerActor A)
      (M.innerActor_elementary A hi hA)
    have he := M.modelImage_innerActor A hi
    have hr : rank (M.innerActor A) = rank A := by
      rw [← M.modelImage_rank, he]
    have hc : fixedCodim (SL2.BinarySmall.hermitian s) (M.innerActor A) =
        fixedCodim ρ A := by
      rw [← M.modelImage_fixedCodim, he]
    rw [hr, hc] at hb
    omega
  let : IsElementaryAbelian 2 A := hA.2
  have heven : Even L.index := by
    by_contra hn
    have ho : Odd L.index := Nat.not_even_iff_odd.mp hn
    exact hout (OrthogonalModel.elementary_le_layer_of_odd_index ho A)
  obtain ⟨t, ht2, htL, ht⟩ := M.exists_outer_involution h heven
  obtain ⟨hq, hr, hsmall, hlarge⟩ := M.outer_elementary_calculation h ht2 htL ht A hA hout
  by_cases ha : rank A = 1
  · have hc := (hsmall ha).2.1
    have hs2 : s = 2 := by omega
    exact ⟨hs2, hout, hq, Or.inl ⟨ha, hc.trans hs2⟩⟩
  · have hp := hA.rank_pos
    have hc := (hlarge (by omega)).2.1
    have hs2 : s = 2 := by omega
    have ha3 : rank A = 3 := by omega
    exact ⟨hs2, hout, hq, Or.inr ⟨ha3, by omega⟩⟩

/-- The near-offender contains an actual outer involution conjugate inside
the marked layer to its canonical orthogonal transvection. -/
theorem marked_near_offender_contains_transvection
    (h : SourceHypotheses ρ L) (M : OrthogonalModel s ρ L) (hs : 1 < s)
    (A : Subgroup G) (hA : IsElementaryTwo A)
    (hnear : fixedCodim ρ A ≤ rank A + 1) :
    s = 2 ∧ ∃ a ∈ A, a ^ 2 = 1 ∧ a ∉ L ∧
      ∃ t : G, t ^ 2 = 1 ∧ t ∉ L ∧ ∃ c : L,
        (c : G) * t * (c : G)⁻¹ = a ∧
        ∀ v : V, M.coordinates (ρ t v) =
          LinearEquiv.transvection
            (Representation.OrthogonalFourMinus.RankOne.traceFunctional_movedVector s)
            (M.coordinates v) := by
  obtain ⟨hs2, hout, _⟩ := marked_near_offender_cases h M hs A hA hnear
  let : L.Normal := h.layer_normal
  let : IsElementaryAbelian 2 A := hA.2
  have heven : Even L.index := by
    by_contra hn
    have ho : Odd L.index := Nat.not_even_iff_odd.mp hn
    exact hout (OrthogonalModel.elementary_le_layer_of_odd_index ho A)
  obtain ⟨t, ht2, htL, ht⟩ := M.exists_outer_involution h heven
  obtain ⟨a, ha, haL⟩ := Set.not_subset.mp hout
  have ha2 : a ^ 2 = 1 := elemPow_eq_one_of_isElementaryAbelian a ha
  obtain ⟨c, hc⟩ := M.outer_involution_conjugate h ha2 haL ht
  exact ⟨hs2, a, ha, ha2, haL, t, ht2, htL, c, hc,
    M.coordinates_pure_involution_transvection ht2 ht⟩

/-- Every near-offender is generated by its actual layer conjugates of a
single canonical orthogonal transvection, including the rank-three case. -/
theorem marked_near_offender_generated_by_transvections
    (h : SourceHypotheses ρ L) (M : OrthogonalModel s ρ L) (hs : 1 < s)
    (A : Subgroup G) (hA : IsElementaryTwo A)
    (hnear : fixedCodim ρ A ≤ rank A + 1) :
    s = 2 ∧ ∃ t : G, t ^ 2 = 1 ∧ t ∉ L ∧
      (∀ v : V, M.coordinates (ρ t v) =
        LinearEquiv.transvection
          (Representation.OrthogonalFourMinus.RankOne.traceFunctional_movedVector s)
          (M.coordinates v)) ∧
      A = closure {a : G | a ∈ A ∧ ∃ c : L, (c : G) * t * (c : G)⁻¹ = a} := by
  obtain ⟨hs2, hout, _⟩ := marked_near_offender_cases h M hs A hA hnear
  let : L.Normal := h.layer_normal
  let : IsElementaryAbelian 2 A := hA.2
  have heven : Even L.index := by
    by_contra hn
    exact hout (OrthogonalModel.elementary_le_layer_of_odd_index
      (Nat.not_even_iff_odd.mp hn) A)
  obtain ⟨t, ht2, htL, ht⟩ := M.exists_outer_involution h heven
  refine ⟨hs2, t, ht2, htL, M.coordinates_pure_involution_transvection ht2 ht, ?_⟩
  let C := closure {a : G | a ∈ A ∧ ∃ c : L, (c : G) * t * (c : G)⁻¹ = a}
  have hgen (a : G) (ha : a ∈ A) (haL : a ∉ L) : a ∈ C := by
    have ha2 : a ^ 2 = 1 := elemPow_eq_one_of_isElementaryAbelian a ha
    obtain ⟨c, hc⟩ := M.outer_involution_conjugate h ha2 haL ht
    exact subset_closure ⟨ha, c, hc⟩
  apply le_antisymm
  · obtain ⟨x, hx, hxL⟩ := Set.not_subset.mp hout
    intro a ha
    by_cases haL : a ∈ L
    · have hxaL : x * a ∉ L := by
        intro hxa
        apply hxL
        change x ∈ L
        simpa only [mul_inv_cancel_right] using L.mul_mem hxa (L.inv_mem haL)
      have hxa := C.mul_mem (C.inv_mem (hgen x hx hxL))
        (hgen (x * a) (A.mul_mem hx ha) hxaL)
      simpa only [inv_mul_cancel_left] using hxa
    · exact hgen a ha haL
  · exact (Subgroup.closure_le _).mpr (fun a ha => ha.1)

/-- In an even extension at half-degree two, the actual outer root group
is a rank-three near-offender. Thus the rank-three alternative is necessary. -/
theorem marked_rank_three_near_offender
    (h : SourceHypotheses ρ L) (M : OrthogonalModel 2 ρ L) (heven : Even L.index) :
    ∃ A : Subgroup G, IsElementaryTwo A ∧ rank A = 3 ∧
      fixedCodim ρ A = 4 ∧ fixedCodim ρ A ≤ rank A + 1 := by
  let : L.Normal := h.layer_normal
  obtain ⟨t, ht2, htL, ht⟩ := M.exists_outer_involution h heven
  have hr := M.outerActor_rank ht2 htL ht
  have hc := M.outerActor_fixedCodim ht2 htL ht
    (M.coordinates_pure_involution ht2 ht)
  refine ⟨M.outerActor t, M.outerActor_elementary ht2 htL ht, ?_, ?_, ?_⟩
  · exact hr
  · exact hc
  · omega

end CFSG.Quasithin.Chapter6.Source.FourOffender
