module
public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleRecognitionIdentificationLocalPairQuotient
public import Theory.LinearAlgebra.QuadraticForm.BinaryFourPlus.SingularPairCubicFixed
public import Theory.GroupTheory.QuaternionSquareFixedFreeGeneration
public import Theory.GroupTheory.QuaternionCentralProductResidualRecognition.Residual

/-!
# Residual saturation and the source non-two-pair conclusion

The product of the two singular involution images acts without fixed vectors
on the actual quaternion square quotient. The generated group has order 192,
so the sixty-fourth power of a lift gives a cubic element with the same action.
This element lies in O²(J). Its displacements generate the quaternion core
modulo its Frattini subgroup, hence the core lies in O²(J).

The final theorem assembles exactly the four assertions used by
LocalAnalysis.non_two_pair: actual quaternion factors in O₂(J), the literal
S₃ quotient, residual containment and the center/intersection identity. All
conjugations and subgroup embeddings retain the original layers.

Source: Aschbacher--Smith, 6.2.6(2), printed p.682.
-/

public section
open Subgroup Theory.GroupTheory
open scoped commutatorElement
namespace CFSG.Quasithin.Chapter6.Source.RankOneRecognition
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
private theorem image_two_generator {F : Type*} [Group F]
    (f : G →* F) (B : Subgroup G) (hB : Nat.card (B.map f)=2) :
    ∃ x∈B, f x≠1 ∧ B.map f=zpowers (f x) := by
  obtain ⟨b,hb1,hall⟩ := (Nat.card_eq_two_iff' (1 : B.map f)).mp hB
  obtain ⟨x,hx,he⟩ := b.property
  refine ⟨x,hx,fun hh=>hb1 (Subtype.ext (he.symm.trans hh)),?_⟩
  apply le_antisymm
  · intro y hy
    by_cases hy1:y=1
    · exact hy1 ▸ (zpowers (f x)).one_mem
    · have hh : y=(b:F) := congrArg Subtype.val (hall ⟨y,hy⟩ (fun hh=>hy1 (congrArg Subtype.val hh)))
      rw [hh,←he]
      exact mem_zpowers (f x)
  · exact zpowers_le.mpr (mem_map_of_mem f hx)

variable {T : Sylow 2 G} {L M R : Subgroup G} {n : ℕ}

/-- The literal pair two-core is generated by displacements of a cubic in O²(J). -/
theorem local_non_two_pair_core_le_residual
    (h : Hypothesis611 KnownSimple.IsKnownSimple T L M R n)
    (hnatural : Conclusion6127 (T : Subgroup G) L M R n)
    (hE : ChapterE.Section06.HypothesisE61 KnownSimple.IsKnownSimple T M (layer L R))
    (g : G)
    (hleft : (layer L R ⊓ normalizer
      ((layer L R).map (MulAut.conj g).toMonoidHom : Set G)).relIndex (layer L R) = 2)
    (hright : ((layer L R).map (MulAut.conj g).toMonoidHom ⊓
      normalizer (layer L R : Set G)).relIndex
        ((layer L R).map (MulAut.conj g).toMonoidHom) = 2)
    (hnon : ¬ IsPGroup 2 (layer L R ⊔
      (layer L R).map (MulAut.conj g).toMonoidHom : Subgroup G)) :
    let J := layer L R ⊔ (layer L R).map (MulAut.conj g).toMonoidHom
    pCore 2 J ≤ pResidual 2 J := by
  let B := layer L R
  let A := B.map (MulAut.conj g).toMonoidHom
  let J := B ⊔ A
  let Q := localPairCore B A
  have hBJ : B≤J := le_sup_left
  have hAJ : A≤J := le_sup_right
  have hQJ : Q≤J := sup_le (inf_le_left.trans hBJ) (inf_le_left.trans hAJ)
  obtain ⟨hn,d,hK,hB,hA,hsing,_,_⟩ :=
    local_non_two_pair_outer_action h hnatural hE g hleft hright hnon
  obtain ⟨hQeq,⟨eqt⟩⟩ := local_non_two_pair_twoCore_quotient h hnatural hE g hleft hright hnon
  have hcore : Q.subgroupOf J=pCore 2 J := by
    apply map_injective J.subtype_injective
    rw [map_subgroupOf_eq_of_le hQJ]
    exact hQeq
  have hcorecard : Nat.card (pCore 2 J)=32 := by
    rw [←hcore,Nat.card_congr (subgroupOfEquivOfLe hQJ).toEquiv]
    exact d.card
  have hqcard : Nat.card (J ⧸ pCore 2 J)=6 := by
    rw [Nat.card_congr eqt.toEquiv]
    norm_num [Nat.card_eq_fintype_card,Fintype.card_perm]
  have hJcard : Nat.card J=192 := by
    have hh := (pCore 2 J).card_mul_index
    rw [hcorecard,index_eq_card,hqcard] at hh
    exact hh.symm
  let f := seedOrthogonalAction J Q hn d
  obtain ⟨hn',d',hK',⟨e'⟩⟩ := local_non_two_pair_outer_symmetricThree h hnatural hE g hleft hright hnon
  let f' := seedOrthogonalAction J Q hn' d'
  have heK : f.ker=f'.ker := map_injective J.subtype_injective (hK.trans hK'.symm)
  let e : f.range ≃* Equiv.Perm (Fin 3) :=
    (QuotientGroup.quotientKerEquivRange f).symm.trans
      ((QuotientGroup.quotientMulEquivOfEq heK).trans
        ((QuotientGroup.quotientKerEquivRange f').trans e'))
  have hnot : ¬IsPGroup 2 f.range := by
    intro hp
    have hc : Nat.card f.range=6 := by
      rw [Nat.card_congr e.toEquiv]
      norm_num [Nat.card_eq_fintype_card,Fintype.card_perm]
    obtain ⟨m,hm⟩ := hp.exists_card_eq
    have hh : Nat.Coprime (Nat.card f.range) 3 := by
      rw [hm]
      exact (by decide : Nat.Coprime 2 3).pow_left m
    rw [hc] at hh
    norm_num at hh
  obtain ⟨x,hx,hx1,hBx⟩ := image_two_generator f (B.subgroupOf J) hB
  obtain ⟨y,hy,hy1,hAy⟩ := image_two_generator f (A.subgroupOf J) hA
  have hr : f.range=zpowers (f x)⊔zpowers (f y) := by
    rw [←hBx,←hAy,←Subgroup.map_sup,←subgroupOf_sup hBJ hAJ,subgroupOf_self,←MonoidHom.range_eq_map]
  obtain ⟨hxy,hfree⟩ := BinaryFourPlus.singular_pair_cubic_fixed_free (f x) (f y)
    (hsing x (Or.inl hx)).1 (hsing y (Or.inr hy)).1
    (hsing x (Or.inl hx)).2 (hsing y (Or.inr hy)).2 (hr ▸ hnot)
  let r := x*y
  let c := r^64
  have hfr3 : (f r)^3=1 := by
    change (f (x*y))^3=1
    rw [map_mul]
    simpa only [hxy] using pow_orderOf_eq_one (f x*f y)
  have hfc : f c=f r := by
    change f (r^64)=f r
    rw [map_pow,pow_eq_pow_mod 64 hfr3]
    norm_num
  have hc3 : c^3=1 := by
    change (r^64)^3=1
    rw [←pow_mul]
    change r^192=1
    rw [←hJcard]
    exact pow_card_eq_one'
  have hc1 : c≠1 := by
    intro he
    have hh : f x*f y=1 := by
      rw [←map_mul,←hfc,he,map_one]
    rw [hh,orderOf_one] at hxy
    contradiction
  have hcres : c∈pResidual 2 J := mem_pResidual_of_orderOf_coprime (by
    rw [orderOf_eq_prime hc3 hc1]
    decide)
  let i : Q→*J := inclusion hQJ
  let K : Subgroup Q := (pResidual 2 J).comap i
  have htop : K=⊤ := by
    refine d.eq_top_of_square_fixed_free (seedConjugation J Q hn c) ?_ K ?_
    · change ∀v,(BinaryFourPlus.wreathToIsometry (f c)).val v=v → v=0
      rw [hfc]
      simpa only [r,map_mul] using hfree
    · intro q
      change i (seedConjugation J Q hn c q*q⁻¹)∈pResidual 2 J
      have he : i (seedConjugation J Q hn c q*q⁻¹)=⁅c,i q⁆ := by
        apply Subtype.ext
        rfl
      rw [he]
      exact (commutator_le_left (pResidual 2 J) (⊤ : Subgroup J))
        (commutator_mem_commutator hcres (mem_top _))
  change pCore 2 J ≤ pResidual 2 J
  rw [←hcore]
  intro q hq
  exact (show (⟨q.val,hq⟩:Q)∈K from htop ▸ mem_top _)


omit [Finite G] in
private theorem quaternionData_transport {H : Type*} [Group H]
    (d : QuaternionCentralProductData G) (e : G ≃* H) :
    Nonempty (QuaternionCentralProductData H) := by
  refine ⟨{
    left := d.left.map e.toMonoidHom
    right := d.right.map e.toMonoidHom
    left_model := ⟨(d.left.equivMapOfInjective e.toMonoidHom e.injective).symm.trans d.left_model.some⟩
    right_model := ⟨(d.right.equivMapOfInjective e.toMonoidHom e.injective).symm.trans d.right_model.some⟩
    intersection_card := ?_
    commute := ?_
    span := ?_ }⟩
  · rw [← map_inf _ _ e.toMonoidHom e.injective,card_map_of_injective e.injective]
    exact d.intersection_card
  · rintro _ ⟨b,hb,rfl⟩ _ ⟨c,hc,rfl⟩
    exact (e.map_mul b c).symm.trans ((congrArg e (d.commute b hb c hc)).trans (e.map_mul c b))
  · rw [← Subgroup.map_sup,d.span,map_top_of_surjective e.toMonoidHom e.surjective]

/-- The four conclusions of source 6.2.6(2) used by `LocalAnalysis.non_two_pair`. -/
theorem local_non_two_pair
    (h : Hypothesis611 KnownSimple.IsKnownSimple T L M R n)
    (hnatural : Conclusion6127 (T : Subgroup G) L M R n)
    (hE : ChapterE.Section06.HypothesisE61 KnownSimple.IsKnownSimple T M (layer L R))
    (g : G)
    (hleft : (layer L R ⊓ normalizer
      ((layer L R).map (MulAut.conj g).toMonoidHom : Set G)).relIndex (layer L R) = 2)
    (hright : ((layer L R).map (MulAut.conj g).toMonoidHom ⊓
      normalizer (layer L R : Set G)).relIndex
        ((layer L R).map (MulAut.conj g).toMonoidHom) = 2)
    (hnon : ¬ IsPGroup 2 (layer L R ⊔
      (layer L R).map (MulAut.conj g).toMonoidHom : Subgroup G)) :
    let J := layer L R ⊔ (layer L R).map (MulAut.conj g).toMonoidHom
    Nonempty (QuaternionCentralProductData (pCore 2 J)) ∧
      Nonempty ((J ⧸ pCore 2 J) ≃* Equiv.Perm (Fin 3)) ∧
      pCore 2 J ≤ pResidual 2 J ∧
      layer L R ⊓ (layer L R).map (MulAut.conj g).toMonoidHom =
        ((center (pCore 2 J)).map (pCore 2 J).subtype).map J.subtype := by
  let B := layer L R
  let A := B.map (MulAut.conj g).toMonoidHom
  let J := B ⊔ A
  let Q := localPairCore B A
  have hQJ : Q≤J := sup_le (inf_le_left.trans le_sup_left) (inf_le_left.trans le_sup_right)
  obtain ⟨_,_,_,_,hZ,⟨d⟩⟩ := local_non_two_pair_quaternion_core h hnatural hE g hleft hright hnon
  obtain ⟨hQeq,hquot⟩ := local_non_two_pair_twoCore_quotient h hnatural hE g hleft hright hnon
  have hcore : Q.subgroupOf J=pCore 2 J := by
    apply map_injective J.subtype_injective
    rw [map_subgroupOf_eq_of_le hQJ]
    exact hQeq
  let ecore : pCore 2 J ≃* Q :=
    (MulEquiv.subgroupCongr hcore.symm).trans (subgroupOfEquivOfLe hQJ)
  refine ⟨quaternionData_transport d ecore.symm,hquot,
    local_non_two_pair_core_le_residual h hnatural hE g hleft hright hnon,?_⟩
  have hZeq : (center (pCore 2 J)).map ecore.toMonoidHom=center Q := by
    apply le_antisymm
    · rintro _ ⟨x,hx,rfl⟩
      apply mem_center_iff.mpr
      intro y
      obtain ⟨z,rfl⟩ := ecore.surjective y
      change ecore z * ecore x = ecore x * ecore z
      rw [← map_mul,← map_mul,mem_center_iff.mp hx z]
    · intro q hq
      refine ⟨ecore.symm q,?_,ecore.apply_symm_apply q⟩
      apply mem_center_iff.mpr
      intro y
      apply ecore.injective
      rw [map_mul,map_mul,ecore.apply_symm_apply,mem_center_iff.mp hq (ecore y)]
  have hecomp : Q.subtype.comp ecore.toMonoidHom=J.subtype.comp (pCore 2 J).subtype := by
    ext x
    rfl
  have hh := congrArg (Subgroup.map Q.subtype) hZeq
  rw [map_map,hecomp,←map_map] at hh
  exact hZ.symm.trans hh.symm

end CFSG.Quasithin.Chapter6.Source.RankOneRecognition
