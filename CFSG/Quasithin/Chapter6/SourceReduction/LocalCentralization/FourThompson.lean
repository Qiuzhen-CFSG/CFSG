module
public import CFSG.Quasithin.Chapter6.SourceReduction.LocalCentralization.FourGeometry
public import CFSG.Quasithin.ChapterC.Section01.RankOne.Alternating.SevenSource.ExceptionalNormalizer

/-!
# The right Thompson action on the original Cartan four-space

The actual reduced action has kernel O₂(KT) and quotient A₇. Thompson
movement selects its unique best offender; both J(T) and Baum(T) have
that same elementary image of order four, with a fixed plane of order
four in U. The image normalizer lifts exactly through the original kernel.

The supplied omega-span splitting identifies the pointwise fixer of the
Sylow-fixed line with the original omega-centralizer inside KT. Thus KT
is generated by its intersections with that centralizer and N_G(J(T)).
All subgroups, maps and normality conditions retain their original ambient
or relative meanings; no block or cubic-normalization conclusion is assumed.

Source: Aschbacher–Smith 5.1.13, printed pp.637–638, using B.4.2(7).
-/

public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter6.Source.RankOneGeneric
variable {G : Type*} [Group G] [Finite G]
namespace LocalA7Configuration
variable {T : Sylow 2 G} {L W H X K : Subgroup G} {n : ℕ}

/-- The original four-space action, with both literal kernel identifications. -/
theorem four_action (a : LocalA7Configuration T L H X K)
    (h : Input KnownSimple.IsKnownSimple T L W n)
    (hc : Nat.card (localOmegaModule T K) = 16) :
    let M := K ⊔ (T : Subgroup G)
    let U := (localOmegaModule T K).subgroupOf M
    ∃ q : M →* alternatingGroup (Fin 7), Function.Surjective q ∧
      q.ker = centralizer (U : Set M) ∧ q.ker = pCore 2 M := by
  let M := K ⊔ (T : Subgroup G)
  let B := K.subgroupOf M
  let U := (localOmegaModule T K).subgroupOf M
  have hr : IsPReduced 2 U := LocalOmega.reduced_internal a.reduced
  let := hr.normal
  let := hr.elementary
  let : B.Normal := normal_subgroupOf_of_le_normalizer (sup_le K.le_normalizer a.sylow_normalizes)
  let e := QuotientGroup.congr (pCore 2 B) (pCore 2 K)
    (subgroupOfEquivOfLe (show K ≤ M from le_sup_left))
    (pCore_map_iso 2 (subgroupOfEquivOfLe (show K ≤ M from le_sup_left)))
  let := LocalOmega.quotient_quasisimple a.maximal.1 (Or.inl a.quotient)
  let : IsQuasisimple (B ⧸ pCore 2 B) := IsQuasisimple.of_mulEquiv e.symm
  have hz : center (B ⧸ pCore 2 B) = ⊥ := by
    apply bot_unique
    intro b hb
    have hh : e b ∈ center (K ⧸ pCore 2 K) := MulEquivClass.apply_mem_center e hb
    rw [LocalOmega.quotient_center a.maximal.1 (Or.inl a.quotient)] at hh
    exact e.injective (by simpa only [mem_bot,map_one] using hh)
  have hcard : Nat.card U = 16 :=
    (Nat.card_congr (subgroupOfEquivOfLe a.reduced.1).toEquiv).trans hc
  have hmove : ⁅U,B⁆ ≠ ⊥ := by
    have he : ⁅U,B⁆ = U := by
      apply map_injective M.subtype_injective
      rw [map_commutator,map_subgroupOf_eq_of_le a.reduced.1,
        map_subgroupOf_eq_of_le (show K ≤ M from le_sup_left),
        LocalOmega.full_movement (h.qtke.evenCharacteristic T) a.maximal.1 a.sylow_normalizes]
    intro hb
    rw [he] at hb
    rw [hb,card_bot] at hcard
    omega
  have hquot : IsPGroup 2 (M ⧸ B) := by
    apply isPGroup_quotient_of_sup_eq_top B ((T : Subgroup G).subgroupOf M)
      T.isPGroup'.comap_subtype
    rw [←subgroupOf_sup (show K ≤ M from le_sup_left) (show (T : Subgroup G) ≤ M from le_sup_right)]
    exact subgroupOf_self M
  let q₀ := QuotientGroup.mk' (centralizer (U : Set M))
  have ht := four_reduced_alternatingSeven_image_top U B hr hz hmove hcard (e.trans a.quotient.some)
  let f : (M ⧸ centralizer (U : Set M)) ≃* alternatingGroup (Fin 7) :=
    ((MulEquiv.subgroupCongr ht).trans Subgroup.topEquiv).symm.trans
      ((reducedQuasisimpleImageEquiv U B hr hz hmove).symm.trans (e.trans a.quotient.some))
  let q := f.toMonoidHom.comp q₀
  have hk : q.ker = centralizer (U : Set M) :=
    (MonoidHom.ker_comp_of_injective q₀ f.toMonoidHom f.injective).trans
      (QuotientGroup.ker_mk' _)
  exact ⟨q,f.surjective.comp (QuotientGroup.mk'_surjective _),hk,
    hk.trans (reduced_quasisimple_centralizer_eq_pCore U B hr hz hmove hquot)⟩

omit [Finite G] in
/-- The right Thompson subgroup moves the actual omega-module. -/
theorem right_thompson_moves (a : LocalA7Configuration T L H X K) :
    ¬ elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (localOmegaModule T K : Set G) := by
  intro hj
  have hn : K ≤ normalizer (centralizer (localOmegaModule T K : Set G) : Set G) :=
    (le_sup_left.trans (reduced_normalizes a.reduced)).trans
      (normalizer_le_normalizer_centralizer _)
  have hKC : K ≤ centralizer (localOmegaModule T K : Set G) := by
    calc K = ⁅K,elementaryAbelianMaxJ (T : Subgroup G)⁆ := a.actor_thompson.symm
         _ ≤ centralizer (localOmegaModule T K : Set G) :=
           (commutator_mono le_rfl hj).trans (le_normalizer_iff_commutator_le_right.mp hn)
  have hU : localOmegaModule T K = ⊥ := le_bot_iff.mp (by
    rw [←a.fixed_eq_bot]
    exact le_inf le_rfl (le_centralizer_iff.mp hKC))
  have hh := a.card
  rw [hU,card_bot] at hh
  norm_num at hh

/-- The unique offender identifies both original images and the fixed plane. -/
theorem four_thompson_images (a : LocalA7Configuration T L H X K)
    (h : Input KnownSimple.IsKnownSimple T L W n)
    (hc : Nat.card (localOmegaModule T K) = 16) :
    let M := K ⊔ (T : Subgroup G)
    let U := (localOmegaModule T K).subgroupOf M
    let P := (T : Subgroup G).subgroupOf M
    let J := elementaryAbelianMaxJ P
    ∃ q : M →* alternatingGroup (Fin 7), Function.Surjective q ∧
      q.ker = centralizer (U : Set M) ∧ q.ker = pCore 2 M ∧
      J.map q = (ChapterB.baumann P).map q ∧ IsElementaryAbelian 2 (J.map q) ∧
      Nat.card (J.map q) = 4 ∧
      Nat.card (U ⊓ centralizer (J : Set M) : Subgroup M) = 4 := by
  let M := K ⊔ (T : Subgroup G)
  let U := (localOmegaModule T K).subgroupOf M
  let P := T.subtype (show (T : Subgroup G) ≤ M from le_sup_right)
  have hr : IsPReduced 2 U := LocalOmega.reduced_internal a.reduced
  let := hr.normal
  let := hr.elementary
  obtain ⟨q,hq,hk,hcore⟩ := a.four_action h hc
  have hUT : U ≤ P :=
    (show U ≤ pCore 2 M from le_sSup ⟨inferInstance,IsElementaryAbelian.isPGroup 2 U⟩).trans
      (pCore_isPGroup.le_sylow_of_normal P)
  have hPmap : (P : Subgroup M).map M.subtype = (T : Subgroup G) :=
    map_subgroupOf_eq_of_le le_sup_right
  have hjmap : (elementaryAbelianMaxJ (P : Subgroup M)).map M.subtype =
      elementaryAbelianMaxJ (T : Subgroup G) := by
    rw [←elementaryAbelianMaxJ_map_injective M.subtype M.subtype_injective,hPmap]
  have hj : ¬ elementaryAbelianMaxJ (P : Subgroup M) ≤ q.ker := by
    rw [hk]
    intro hj
    apply a.right_thompson_moves
    rw [←hjmap]
    rintro _ ⟨x,hx,rfl⟩ u hu
    exact congrArg M.subtype (hj hx ⟨u,a.reduced.1 hu⟩ hu)
  have hd : Module.finrank (ZMod 2) (Additive U) = 4 := by
    apply Nat.pow_right_injective (by decide : 2 ≤ 2)
    have hh := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := Additive U)
    change Nat.card U = Nat.card (ZMod 2)^Module.finrank (ZMod 2) (Additive U) at hh
    rw [Nat.card_congr (subgroupOfEquivOfLe a.reduced.1).toEquiv,hc,Nat.card_zmod] at hh
    exact hh.symm
  obtain ⟨E,hEP,hE,hJ,hB⟩ :=
    ChapterC.RankOne.Alternating.SevenSource.exceptional_thompson_baumann_images U q hq hk hd P hUT hj
  let ρ := NormalElementaryQuotient.representation U q hq hk
  have hdim := Representation.BinaryAlternatingSevenControl.best_dimensions ρ
    (NormalElementaryQuotient.representation_injective U q hq hk) hd hE
  refine ⟨q,hq,hk,hcore,hJ.trans hB.symm,hJ.symm ▸ hE.1.2,hJ.symm ▸ hdim.2.1,?_⟩
  have hf := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := fixedSpace ρ E)
  rw [hdim.2.2,Nat.card_zmod] at hf
  have he := Nat.card_congr (NormalElementaryQuotient.fixedSpaceEquiv U q hq hk
    (elementaryAbelianMaxJ (P : Subgroup M)))
  rw [hJ] at he
  exact he.symm.trans hf
end LocalA7Configuration
end CFSG.Quasithin.Chapter6.Source.RankOneGeneric


namespace CFSG.Quasithin.Chapter6.Source.RankOneGeneric
open Subgroup Theory.GroupTheory Stellmacher Representation Representation.BinaryOffender
open scoped Pointwise
variable {G : Type*} [Group G] [Finite G]
namespace LocalA7Configuration
variable {T : Sylow 2 G} {L W H X K : Subgroup G} {n : ℕ}

omit [Finite G] in
private theorem fixed_centralizer_le_omega (a : LocalA7Configuration T L H X K) :
    let M := K ⊔ (T : Subgroup G)
    let U := (localOmegaModule T K).subgroupOf M
    let P := (T : Subgroup G).subgroupOf M
    (centralizer (U ⊓ centralizer (P : Set M) : Set M)).map M.subtype ≤ omegaCentralizer T := by
  dsimp only
  let M := K ⊔ (T : Subgroup G)
  let Z := omegaOneCenterAmbient (T : Subgroup G)
  let F := Z ⊓ centralizer (K : Set G)
  have hZT : Z ≤ (T : Subgroup G) := fun z hz => (mem_omegaOneCenterAmbient_iff _ _).mp hz |>.1
  have hFU : F ≤ normalizer (localOmegaModule T K : Set G) :=
    inf_le_left.trans (hZT.trans (le_sup_right.trans (reduced_normalizes a.reduced)))
  have hMF : M ≤ centralizer (F : Set G) := sup_le
    (le_centralizer_iff.mp (show F ≤ centralizer (K : Set G) from inf_le_right))
    (sylow_le_omegaCentralizer.trans (centralizer_le inf_le_left))
  rintro _ ⟨g,hg,rfl⟩ z hz
  have hprod : z ∈ (F : Set G) * (localOmegaModule T K : Set G) := by
    rw [←coe_mul_of_left_le_normalizer_right F _ hFU,sup_comm,←a.span_eq]
    exact le_conjugateSpanBy Z K hz
  obtain ⟨f,hf,u,hu,he⟩ := hprod
  have huZ : u ∈ Z := by
    have hh := Z.mul_mem (Z.inv_mem hf.1) hz
    rw [←he,inv_mul_cancel_left] at hh
    exact hh
  have hgu : u * g.val = g.val * u := by
    have hh := hg (⟨u,a.reduced.1 hu⟩ : M) ⟨hu,?_⟩
    · exact congrArg M.subtype hh
    · intro t ht
      apply Subtype.ext
      exact ((mem_omegaOneCenterAmbient_iff _ _).mp huZ).2.2 t ht
  have hgf := hMF g.property f hf
  change z * g.val = g.val * z
  rw [←he]
  change (f*u)*g.val = g.val*(f*u)
  rw [mul_assoc,hgu,←mul_assoc,hgf,mul_assoc]

/-- The actual KT is generated by the original Thompson normalizer and
its omega-centralizer, in the four-dimensional alternative. -/
theorem four_thompson_normalizer_generation (a : LocalA7Configuration T L H X K)
    (h : Input KnownSimple.IsKnownSimple T L W n)
    (hc : Nat.card (localOmegaModule T K) = 16) :
    ((K ⊔ (T : Subgroup G)) ⊓ normalizer (elementaryAbelianMaxJ (T : Subgroup G) : Set G)) ⊔
      ((K ⊔ (T : Subgroup G)) ⊓ omegaCentralizer T) = K ⊔ (T : Subgroup G) := by
  let M := K ⊔ (T : Subgroup G)
  let U := (localOmegaModule T K).subgroupOf M
  let P := T.subtype (show (T : Subgroup G) ≤ M from le_sup_right)
  have hr : IsPReduced 2 U := LocalOmega.reduced_internal a.reduced
  let := hr.normal
  let := hr.elementary
  obtain ⟨q,hq,hk,hcore⟩ := a.four_action h hc
  have hUT : U ≤ P :=
    (show U ≤ pCore 2 M from le_sSup ⟨inferInstance,IsElementaryAbelian.isPGroup 2 U⟩).trans
      (pCore_isPGroup.le_sylow_of_normal P)
  have hPmap : (P : Subgroup M).map M.subtype = (T : Subgroup G) :=
    map_subgroupOf_eq_of_le le_sup_right
  have hjmap : (elementaryAbelianMaxJ (P : Subgroup M)).map M.subtype =
      elementaryAbelianMaxJ (T : Subgroup G) := by
    rw [←elementaryAbelianMaxJ_map_injective M.subtype M.subtype_injective,hPmap]
  have hj : ¬ elementaryAbelianMaxJ (P : Subgroup M) ≤ q.ker := by
    rw [hk]
    intro hj
    apply a.right_thompson_moves
    rw [←hjmap]
    rintro _ ⟨x,hx,rfl⟩ u hu
    exact congrArg M.subtype (hj hx ⟨u,a.reduced.1 hu⟩ hu)
  have hd : Module.finrank (ZMod 2) (Additive U) = 4 := by
    apply Nat.pow_right_injective (by decide : 2 ≤ 2)
    have hh := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := Additive U)
    change Nat.card U = Nat.card (ZMod 2)^Module.finrank (ZMod 2) (Additive U) at hh
    rw [Nat.card_congr (subgroupOfEquivOfLe a.reduced.1).toEquiv,hc,Nat.card_zmod] at hh
    exact hh.symm
  have hgen := ChapterC.RankOne.Alternating.SevenSource.exceptional_thompson_normalizer_generation
    U q hq hk hd P hUT (hcore.symm ▸ pCore_isPGroup.le_sylow_of_normal P) hj
  have hh := congrArg (Subgroup.map M.subtype) hgen
  rw [Subgroup.map_sup,←MonoidHom.range_eq_map,range_subtype] at hh
  apply le_antisymm (sup_le inf_le_left inf_le_left)
  apply hh.ge.trans
  apply sup_le
  · apply le_trans _ le_sup_left
    refine le_inf (map_subtype_le _) ?_
    have hn := (elementaryAbelianMaxJ (P : Subgroup M)).le_normalizer_map M.subtype
    rwa [hjmap] at hn
  · exact (le_inf (map_subtype_le _) a.fixed_centralizer_le_omega).trans le_sup_right
end LocalA7Configuration
end CFSG.Quasithin.Chapter6.Source.RankOneGeneric


namespace CFSG.Quasithin.Chapter6.Source.RankOneGeneric
open Subgroup Theory.GroupTheory Stellmacher
variable {G : Type*} [Group G] [Finite G]
namespace LocalA7Configuration
variable {T : Sylow 2 G} {L W H X K : Subgroup G} {n : ℕ}

/-- The fixed plane belongs to the original U and original J(T). -/
theorem four_thompson_fixed_card (a : LocalA7Configuration T L H X K)
    (h : Input KnownSimple.IsKnownSimple T L W n)
    (hc : Nat.card (localOmegaModule T K) = 16) :
    Nat.card (localOmegaModule T K ⊓
      centralizer (elementaryAbelianMaxJ (T : Subgroup G) : Set G) : Subgroup G) = 4 := by
  let M := K ⊔ (T : Subgroup G)
  let U := (localOmegaModule T K).subgroupOf M
  let P := (T : Subgroup G).subgroupOf M
  let J := elementaryAbelianMaxJ P
  obtain ⟨q,hq,hk,hcore,hJB,hJe,hJcard,hfixed⟩ := a.four_thompson_images h hc
  have hjmap : J.map M.subtype = elementaryAbelianMaxJ (T : Subgroup G) := by
    rw [show J = elementaryAbelianMaxJ P from rfl,
      ←elementaryAbelianMaxJ_map_injective M.subtype M.subtype_injective,
      map_subgroupOf_eq_of_le (show (T : Subgroup G) ≤ M from le_sup_right)]
  have he : (U ⊓ centralizer (J : Set M)).map M.subtype =
      localOmegaModule T K ⊓ centralizer (elementaryAbelianMaxJ (T : Subgroup G) : Set G) := by
    ext u
    constructor
    · rintro ⟨u,hu,rfl⟩
      refine ⟨hu.1,?_⟩
      rw [←hjmap]
      rintro _ ⟨j,hj,rfl⟩
      exact congrArg M.subtype (hu.2 j hj)
    · intro hu
      refine ⟨⟨u,a.reduced.1 hu.1⟩,⟨hu.1,?_⟩,rfl⟩
      intro j hj
      apply Subtype.ext
      exact hu.2 j.val (hjmap ▸ mem_map_of_mem M.subtype hj)
  rw [←he,card_map_of_injective M.subtype_injective]
  exact hfixed
end LocalA7Configuration
end CFSG.Quasithin.Chapter6.Source.RankOneGeneric


namespace CFSG.Quasithin.Chapter6.Source.RankOneGeneric
open Subgroup Theory.GroupTheory Stellmacher
variable {G : Type*} [Group G] [Finite G]
namespace LocalA7Configuration
variable {T : Sylow 2 G} {L W H X K : Subgroup G} {n : ℕ}

/-- The literal original Thompson and Baumann images are the same four-group;
their Thompson normalizer is recovered exactly through the two-core. -/
theorem four_original_thompson_quotient (a : LocalA7Configuration T L H X K)
    (h : Input KnownSimple.IsKnownSimple T L W n)
    (hc : Nat.card (localOmegaModule T K) = 16) :
    let M := K ⊔ (T : Subgroup G)
    let J := (elementaryAbelianMaxJ (T : Subgroup G)).subgroupOf M
    let B := (ChapterB.baumann (T : Subgroup G)).subgroupOf M
    ∃ q : M →* alternatingGroup (Fin 7), Function.Surjective q ∧
      q.ker = pCore 2 M ∧ J.map q = B.map q ∧ IsElementaryAbelian 2 (J.map q) ∧
      Nat.card (J.map q) = 4 ∧
      normalizer (J : Set M) = (normalizer (J.map q : Set (alternatingGroup (Fin 7)))).comap q := by
  let M := K ⊔ (T : Subgroup G)
  let P := (T : Subgroup G).subgroupOf M
  have hPM : P.map M.subtype = (T : Subgroup G) := map_subgroupOf_eq_of_le le_sup_right
  have hJM : elementaryAbelianMaxJ (T : Subgroup G) ≤ M :=
    (sSup_le fun _ hE => hE.1).trans le_sup_right
  have hBM : ChapterB.baumann (T : Subgroup G) ≤ M := inf_le_left.trans le_sup_right
  have hJ : elementaryAbelianMaxJ P = (elementaryAbelianMaxJ (T : Subgroup G)).subgroupOf M := by
    apply map_injective M.subtype_injective
    rw [←elementaryAbelianMaxJ_map_injective M.subtype M.subtype_injective,hPM,
      map_subgroupOf_eq_of_le hJM]
  have hB : ChapterB.baumann P = (ChapterB.baumann (T : Subgroup G)).subgroupOf M := by
    apply map_injective M.subtype_injective
    rw [map_subgroupOf_eq_of_le hBM]
    change (P ⊓ centralizer (omegaOneCenterAmbient (elementaryAbelianMaxJ P) : Set M)).map M.subtype = _
    rw [baumann_map_injective M.subtype M.subtype_injective,hPM]
    rfl
  obtain ⟨q,hq,hk,hcore,hJB,hJe,hcard,_⟩ := a.four_thompson_images h hc
  change (elementaryAbelianMaxJ P).map q = (ChapterB.baumann P).map q at hJB
  change IsElementaryAbelian 2 ((elementaryAbelianMaxJ P).map q) at hJe
  change Nat.card ((elementaryAbelianMaxJ P).map q) = 4 at hcard
  refine ⟨q,hq,hcore,?_,?_,?_,?_⟩
  · simpa only [hJ,hB] using hJB
  · exact (congrArg (fun E : Subgroup M => IsElementaryAbelian 2 (E.map q)) hJ).mp hJe
  · simpa only [hJ] using hcard
  · have hker : q.ker ≤ P := hcore.symm ▸
      pCore_isPGroup.le_sylow_of_normal (T.subtype (show (T : Subgroup G) ≤ M from le_sup_right))
    simpa only [hJ] using normalizer_maxJ_eq_comap_of_ker_le P q hker
end LocalA7Configuration
end CFSG.Quasithin.Chapter6.Source.RankOneGeneric
