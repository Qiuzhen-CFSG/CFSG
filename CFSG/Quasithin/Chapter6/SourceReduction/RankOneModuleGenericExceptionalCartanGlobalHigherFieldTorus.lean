module
public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleGenericExceptionalCartanLocalHermitian
public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleGenericExceptionalCartanGlobalSmallGenerationAssembly

/-!
# The actual Hermitian torus factors in the higher-field Cartan branch

The literal quotient L/O₂(L) acts on the original Hermitian module. Its
Sylow-fixed line is multiplied by the quadratic norm, so every Borel root
annihilated by 2ˢ+1 centralizes the original Sylow omega-center when that
center lies in the module. No cubic fixer or parity of s is assumed.

The original Hall Cartan is cyclic of order 2²ˢ−1. Its two power kernels
have coprime orders 2ˢ+1 and 2ˢ−1 and generate it. At original degree eight,
H's centralization of omega puts the order-seventeen factor in a join with
nonzero two-core; the other factor is generated by actual subgroups of
orders three and five. This supplies the small-generation conclusion in
this Hermitian branch without any residual-field divisibility premise.

Selection of these coordinates and omega-centralization from the source,
and the general higher-degree bound, remain separate obligations.
Source: Aschbacher--Smith 5.1.6(4) and 5.2.2, printed pp.632--633,647
(`refs/quasithin.pdf`).
-/

public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher
open scoped MatrixGroups
namespace CFSG.Quasithin.Chapter6.Source.RankOneGeneric
open Representation.OrthogonalFourMinus
variable {G : Type*} [Group G] [Finite G]
local instance (s : ℕ) : Algebra (ZMod 2) (FiniteModel.fixedField s) := ZMod.algebra _ 2
local instance (s : ℕ) [NeZero s] : Module (ZMod 2) (FiniteModel.Space s) :=
  Module.compHom (FiniteModel.Space s) (algebraMap (ZMod 2) (FiniteModel.fixedField s))

/-- Norm-one roots of the original Borel fix the whole original omega-center. -/
theorem hermitian_minus_roots_centralize_omega
    {T : Sylow 2 G} {L U : Subgroup G} (s : ℕ) [NeZero s]
    (hTL : (T : Subgroup G) ≤ normalizer (L : Set G))
    (hm : IsConjugationModel L U (Representation.SL2.BinarySmall.hermitian s))
    (hZU : omegaOneCenterAmbient (T : Subgroup G) ≤ U) :
    ∀ x ∈ localBorel T L, x^(2^s+1)=1 → x ∈ omegaCentralizer T := by
  obtain ⟨e,f,hf⟩ := hm
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))
  have hq : Function.Surjective q := e.surjective.comp (QuotientGroup.mk'_surjective _)
  obtain ⟨P,hP⟩ := NormalSylowQuotientAction.intersection_sylow T L hTL
  let S := P.mapSurjective hq
  have hfixed (l : L) (u : U) :
      Representation.SL2.BinarySmall.hermitian s (q l) (f u).toAdd = (f u).toAdd ↔
        (l : G)*(u : G)*(l : G)⁻¹ = (u : G) := by
    constructor
    · intro he
      have hh := hf l u
      change (f.symm (Multiplicative.ofAdd
        (Representation.SL2.BinarySmall.hermitian s (q l) (f u).toAdd)) : G) = _ at hh
      rw [he] at hh
      change (f.symm (f u) : G) = _ at hh
      rw [f.symm_apply_apply] at hh
      exact hh.symm
    · intro he
      apply Multiplicative.ofAdd.injective
      apply f.symm.injective
      apply U.subtype_injective
      change (f.symm (Multiplicative.ofAdd
        (Representation.SL2.BinarySmall.hermitian s (q l) (f u).toAdd)) : G) = (f.symm (f u) : G)
      rw [f.symm_apply_apply]
      exact (hf l u).trans he
  have hnorm (l : L) (hl : (l : G) ∈ localBorel T L) :
      q l ∈ normalizer (S : Set SL(2,FiniteModel.Field s)) := by
    have hN : l ∈ normalizer (P : Set L) := by
      have hh : (l : G) ∈ (normalizer ((T : Subgroup G).subgroupOf L : Set L)).map L.subtype := by
        rwa [←localBorel_eq_map]
      have hh' := (mem_map_iff_mem L.subtype_injective).mp hh
      change l ∈ normalizer ((P : Subgroup L) : Set L)
      rw [hP]
      exact hh'
    exact (Subgroup.le_normalizer_map (H := (P : Subgroup L)) q) (mem_map_of_mem q hN)
  have hSylow (u : U) (hu : (u : G) ∈ omegaOneCenterAmbient (T : Subgroup G)) :
      (f u).toAdd ∈ Representation.BinaryOffender.fixedSpace
        (Representation.SL2.BinarySmall.hermitian s) S := by
    intro g
    obtain ⟨l,hl,he⟩ := g.property
    change Representation.SL2.BinarySmall.hermitian s g.val (f u).toAdd = _
    rw [←he]
    apply (hfixed l u).mpr
    have hlT : (l : G) ∈ (T : Subgroup G) := by
      change l ∈ (P : Subgroup L) at hl
      rwa [hP] at hl
    have hc := ((mem_omegaOneCenterAmbient_iff _ _).mp hu).2.2 l hlT
    rw [hc,mul_inv_cancel_right]
  intro x hx hp z hz
  let xL : L := ⟨x,hx.1⟩
  let zU : U := ⟨z,hZU hz⟩
  have hpL : xL^(2^s+1)=1 := Subtype.ext hp
  have hfix := SylowTorus.minus_root_fixes s S (q xL) (hnorm xL hx)
    (by rw [←map_pow,hpL,map_one]) (f zU).toAdd (hSylow zU hz)
  have he := (hfixed xL zU).mp hfix
  exact (mul_inv_eq_iff_eq_mul.mp he).symm

private theorem cyclic_split (A : Subgroup G) [IsCyclic A]
    (a b : ℕ) (hcard : Nat.card A = a*b) (hcop : a.Coprime b) :
    ∃ D E : Subgroup G, D ⊔ E = A ∧ Nat.card D = a ∧ Nat.card E = b := by
  let : CommGroup A := IsCyclic.commGroup
  let X : Subgroup A := (powMonoidHom a).ker
  let Y : Subgroup A := (powMonoidHom b).ker
  let D := X.map A.subtype
  let E := Y.map A.subtype
  have hD : Nat.card D = a := by
    rw [card_map_of_injective A.subtype_injective]
    change Nat.card (powMonoidHom a : A →* A).ker = a
    rw [IsCyclic.card_powMonoidHom_ker,hcard,Nat.gcd_eq_right (dvd_mul_right a b)]
  have hE : Nat.card E = b := by
    rw [card_map_of_injective A.subtype_injective]
    change Nat.card (powMonoidHom b : A →* A).ker = b
    rw [IsCyclic.card_powMonoidHom_ker,hcard,Nat.gcd_eq_right (dvd_mul_left b a)]
  refine ⟨D,E,eq_of_le_of_card_ge (sup_le (map_subtype_le _) (map_subtype_le _)) ?_,hD,hE⟩
  rw [hcard]
  apply Nat.le_of_dvd Nat.card_pos
  exact hcop.mul_dvd_of_dvd_of_dvd
    (hD ▸ card_dvd_of_le (show D ≤ D ⊔ E from le_sup_left))
    (hE ▸ card_dvd_of_le (show E ≤ D ⊔ E from le_sup_right))

/-- The original Hall Cartan splits into its two actual Hermitian torus factors. -/
theorem CartanPair.hermitian_torus_factors
    {T : Sylow 2 G} {L W H A B U : Subgroup G} {n : ℕ}
    (h : Input KnownSimple.IsKnownSimple T L W n)
    (c : CartanPair T L H A B) (s : ℕ) [NeZero s]
    (hm : IsConjugationModel L U (Representation.SL2.BinarySmall.hermitian s))
    (hZU : omegaOneCenterAmbient (T : Subgroup G) ≤ U) :
    n = 2*s ∧ ∃ Dminus Dplus : Subgroup G,
      Dminus ⊔ Dplus = A ∧ Nat.card Dminus = 2^s+1 ∧
        Nat.card Dplus = 2^s-1 ∧ Dminus ≤ omegaCentralizer T := by
  have hn := h.exponent_of_hermitian_model s hm
  obtain ⟨F,_,_,_,hF,⟨e⟩⟩ := c.left_equiv_units h.linear h.sylow_normalizes
  let : IsCyclic A := isCyclic_of_injective e.toMonoidHom e.injective
  have hc : Nat.card A = (2^s+1)*(2^s-1) := by
    rw [c.left_card h.linear h.sylow_normalizes,hn,pow_mul']
    have hp : 0 < (2:ℕ)^s := pow_pos (by decide) _
    have he : 2^s - 1 + 1 = 2^s := Nat.sub_add_cancel hp
    have he2 := Nat.sub_add_cancel (show 1 ≤ ((2 : ℕ)^s)^2 from pow_pos hp 2)
    nlinarith
  have hcop : (2^s+1).Coprime (2^s-1) := by
    have hp : 0 < (2:ℕ)^s := pow_pos (by decide) _
    have he : 2^s+1 = (2^s-1)+2 := by omega
    rw [he,Nat.coprime_self_add_left]
    apply Nat.prime_two.coprime_iff_not_dvd.mpr
    have hv := (even_two : Even (2 : ℕ)).pow_of_ne_zero (NeZero.ne s)
    have hmod := Nat.even_iff.mp hv
    intro hd
    have := Nat.mod_eq_zero_of_dvd hd
    omega
  obtain ⟨Dm,Dp,hs,hmcard,hpcard⟩ := cyclic_split A (2^s+1) (2^s-1) hc hcop
  refine ⟨hn,Dm,Dp,hs,hmcard,hpcard,?_⟩
  intro x hx
  apply hermitian_minus_roots_centralize_omega s h.sylow_normalizes hm hZU x
    (c.left_le (hs ▸ (mem_sup_left hx)))
  have hh := congrArg Subtype.val (pow_card_eq_one' (x := (⟨x,hx⟩ : Dm)))
  simpa only [hmcard,Subgroup.coe_pow,Subgroup.coe_one] using hh

/-- In degree eight, the actual Hermitian omega-span makes the order-seventeen
factor centralize omega. The other factor has order fifteen and is generated
by its actual cubic and quintic subgroups. No residual-degree divisibility
or field-reduction conclusion is assumed. -/
theorem Input.cartanSmallGeneration_of_hermitian_degree_eight
    {T : Sylow 2 G} {L W H A B : Subgroup G}
    (h : Input KnownSimple.IsKnownSimple T L W 8)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (c : CartanPair T L H A B) (hHC : H ≤ omegaCentralizer T)
    (s : ℕ) [NeZero s]
    (hm : IsConjugationModel L
      (conjugateSpanBy (omegaOneCenterAmbient (T : Subgroup G)) L)
      (Representation.SL2.BinarySmall.hermitian s)) :
    CartanSmallGeneration A H 8 := by
  obtain ⟨hn,Dm,Dp,hs,hmc,hpc,hfix⟩ := c.hermitian_torus_factors h s hm
    (le_conjugateSpanBy _ _)
  have hs4 : s = 4 := by omega
  have h15 : Nat.card Dp = 15 := by simpa [hs4] using hpc
  have hDpA : Dp ≤ A := hs ▸ le_sup_right
  obtain ⟨F,_,_,_,_,⟨e⟩⟩ := c.left_equiv_units h.linear h.sylow_normalizes
  let : IsCyclic A := isCyclic_of_injective e.toMonoidHom e.injective
  let : IsCyclic Dp := isCyclic_of_injective (inclusion hDpA)
    (inclusion_injective hDpA)
  obtain ⟨D3,D5,h35,h3,h5⟩ := cyclic_split Dp 3 5 h15 (by decide)
  have hcore := core_ne_bot_of_omega_centralizes hH.1.1.2 hH.1.1.1
    (sup_le hfix hHC)
  exact ⟨Or.inr (Or.inr rfl),Dm,D3,D5,
    by rw [sup_assoc,h35,hs],hcore,Or.inr h3,Or.inr h5⟩

end CFSG.Quasithin.Chapter6.Source.RankOneGeneric
