module

public import CFSG.Quasithin.Chapter6.SourceReduction.LocalSieve.Components
public import Theory.GroupTheory.PerfectNormalizerCoreQuotient

/-!
# Residual escape in the actual local two-core quotient

The E.2.2 seed is perfect, so its full Sylow orbit, the original O²(H),
is perfect as well. Since Y contains the original full Sylow, O₂(Y)
lies in H and normalizes this residual. Perfect normalizer lifting then
identifies the inverse image of its quotient normalizer with its actual
relative normalizer in Y. Thus the escaping Cartan still escapes modulo
O₂(Y), even when the residual is generated by two exchanged components.

Source: Aschbacher--Smith, the quotient-action reduction in 5.1.13,
printed p.636. The containing-model exclusions remain separate.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter6.Source.RankOneGeneric.LocalSieve
variable {G : Type*} [Group G] [Finite G]

/-- The E.2.2 seed makes the entire original two-residual perfect, including the paired case. -/
theorem residual_perfect {T : Sylow 2 G} {M H : Subgroup G}
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hTM : (T : Subgroup G) ≤ M)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) M)
    (hgen : 1 < ChapterE.generationParameter H) : Group.IsPerfect (residual H) := by
  obtain ⟨K,hKH,hK,_,_,_,ho⟩ := exists_seed hG hTM hH hgen
  let := hK.perfect
  let : Group.IsPerfect K := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe hKH).toMonoidHom) (subgroupOfEquivOfLe hKH).surjective
  rw [← ho]
  exact isPerfect_iSup_conjugates K (T : Subgroup G)

/-- No new residual normalizers appear on passing to the actual local two-core quotient. -/
theorem residual_twoCore_normalizer {T : Sylow 2 G} {M H Y : Subgroup G}
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hTM : (T : Subgroup G) ≤ M)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) M)
    (hgen : 1 < ChapterE.generationParameter H)
    (hHY : H ≤ Y) :
    (normalizer (((residual H).subgroupOf Y).map (QuotientGroup.mk' (pCore 2 Y)) :
      Set (Y ⧸ pCore 2 Y))).comap (QuotientGroup.mk' (pCore 2 Y)) =
        (normalizer (residual H : Set G)).subgroupOf Y := by
  have hRY : residual H ≤ Y := (map_subtype_le _).trans hHY
  let := residual_perfect hG hTM hH hgen
  let : Group.IsPerfect ((residual H).subgroupOf Y) := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe hRY).symm.toMonoidHom)
    (subgroupOfEquivOfLe hRY).symm.surjective
  have hQ : pCore 2 Y ≤ normalizer ((residual H).subgroupOf Y : Set Y) := by
    rw [←subgroupOf_normalizer_eq hRY]
    exact (pCore_isPGroup.le_sylow_of_normal (T.subtype (hH.1.1.2.trans hHY))).trans
      (comap_mono (hH.1.1.2.trans (le_normalizer_residual H)))
  rw [normalizer_perfect_image_comap _ _ pCore_isPGroup hQ,
    ← subgroupOf_normalizer_eq hRY]

/-- Cartan escape is equivalent to escape of the literal image modulo O₂(Y). -/
theorem residual_escape_twoCore_iff {T : Sylow 2 G} {M H A Y : Subgroup G}
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hTM : (T : Subgroup G) ≤ M)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) M)
    (hgen : 1 < ChapterE.generationParameter H) (hHY : H ≤ Y) :
    (A.subgroupOf Y).map (QuotientGroup.mk' (pCore 2 Y)) ≤
      normalizer (((residual H).subgroupOf Y).map (QuotientGroup.mk' (pCore 2 Y)) :
        Set (Y ⧸ pCore 2 Y)) ↔ A ⊓ Y ≤ normalizer (residual H : Set G) := by
  rw [map_le_iff_le_comap, residual_twoCore_normalizer hG hTM hH hgen hHY]
  constructor
  · intro hn x hx
    exact hn (show (⟨x,hx.2⟩ : Y) ∈ A.subgroupOf Y from hx.1)
  · intro hn x hx
    exact hn ⟨hx,x.property⟩

end CFSG.Quasithin.Chapter6.Source.RankOneGeneric.LocalSieve
