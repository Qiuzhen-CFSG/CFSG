/-!
# Actual direct factors from the reduced transvection models

In the paired G.6.4 model, the two moved spaces are disjoint and each has
dimension at least two. An operator interchanging them therefore has
displacement rank at least two. Consequently a group generated by rank-one
operators has the one-factor G.6.4 conclusion.

Apply this to the image on a marked transvection's displacement orbit.
Restriction already embeds its normal closure and has exactly that closure's
centralizer as kernel. The one-factor conclusion makes the closure surject
onto the entire restricted image. It follows that the original group is the
direct product of this actual normal closure and its actual centralizer.
The classified action is transported back through the literal restriction;
multiplication gives the product equivalence with both inclusions retained.

On W/Z_S, the conjugates of the moving actor generate the reduced image by
rank-one operators. Thus the preceding results apply to each marked actor,
without any claim of core vanishing on W/<z>. The remaining component sieve,
amalgam contradiction, initial 6.1.4–5 and unconditional 6.1.27 remain with
qt-d-1222-rankone-recognition-natural.

Source: Aschbacher–Smith, 6.1.19, pp.674–675, and G.6.4, pp.345–346.
-/

public noncomputable section
set_option backward.isDefEq.respectTransparency false
open Subgroup Theory.GroupTheory Representation.BinaryOffender
namespace CFSG.Quasithin.Chapter6.Source.RankOneRecognition
open ChapterG.Section06
universe u
variable {G V : Type u} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  {ρ : Representation (ZMod 2) G V}

private theorem binary_fixed_zero {n : ℕ} (hn : 2 ≤ n) (v : Fin n → ZMod 2)
    (hv : ∀ g : (Fin n → ZMod 2) ≃ₗ[ZMod 2] (Fin n → ZMod 2), g v = v) : v = 0 := by
  ext i
  obtain ⟨j,hji⟩ : ∃ j : Fin n, j ≠ i := by
    let : Nontrivial (Fin n) := Fin.nontrivial_iff_two_le.mpr hn
    exact exists_ne i
  let f : Module.Dual (ZMod 2) (Fin n → ZMod 2) := LinearMap.proj i
  let w : Fin n → ZMod 2 := Pi.single j 1
  have hfw : f w = 0 := by simp [f,w,hji.symm]
  have he := congrFun (hv (LinearEquiv.transvection hfw)) j
  simpa [LinearEquiv.transvection.apply, LinearMap.transvection.apply, f, w] using he

private theorem five_fixed_zero (v : BinaryPermutation.natural (Fin 5))
    (hv : ∀ g, BinaryPermutation.naturalRepresentation (Fin 5) g v = v) : v = 0 := by
  let e := BinaryPermutation.coreEquivNatural (Fin 5) (by decide)
  have hfix (g : Equiv.Perm (Fin 5)) :
      BinaryPermutation.coreRepresentation (Fin 5) g (e.symm v) = e.symm v := by
    apply e.injective
    rw [BinaryPermutation.coreEquivNatural_equivariant, e.apply_symm_apply, hv]
  have hh := BinaryPermutation.FiveCentralExtension.core_sum (e.symm v)
  rw [Finset.sum_congr rfl (fun g _ => hfix g),Finset.sum_const,
    BinaryPermutation.FiveCentralExtension.cubes_card] at hh
  have hz : 20 • e.symm v = 0 := by
    rw [←Nat.cast_smul_eq_nsmul (R := ZMod 2)]
    change (20 : ZMod 2) • e.symm v = 0
    rw [show (20 : ZMod 2) = 0 from rfl,zero_smul]
  exact e.symm.injective (hh.symm.trans hz |>.trans e.symm.map_zero.symm)

private theorem small_factor_fixed_zero {K : Subgroup G} {W : Submodule (ZMod 2) V}
    (hm : SmallFactorModel ρ K W) (v : W) (hv : ∀ k : K, ρ k v = v) : v = 0 := by
  have transport {B F : Type} [Group B] [AddCommGroup F] [Module (ZMod 2) F]
      (τ : Representation (ZMod 2) B F) (hmodel : HasModelOn ρ K W τ)
      (hfixed : ∀ w, (∀ b, τ b w = w) → w = 0) : v = 0 := by
    obtain ⟨e,E,hs,he⟩ := hmodel
    apply E.injective
    rw [E.map_zero]
    apply hfixed
    intro b
    obtain ⟨k,rfl⟩ := e.surjective b
    rw [←he]
    exact congrArg E (Subtype.ext (hv k))
  rcases hm with hm | hm | hm
  · exact transport (binaryLinearAction 2) hm (binary_fixed_zero (by decide : 2 ≤ 2))
  · exact transport (binaryLinearAction 3) hm (binary_fixed_zero (by decide : 2 ≤ 3))
  · exact transport (BinaryPermutation.naturalRepresentation (Fin 5)) hm five_fixed_zero

private theorem small_factor_dimension {K : Subgroup G} {W : Submodule (ZMod 2) V}
    (hm : SmallFactorModel ρ K W) : 2 ≤ Module.finrank (ZMod 2) W := by
  rcases hm with ⟨_,E,_⟩ | ⟨_,E,_⟩ | ⟨_,E,_⟩
  · rw [E.finrank_eq,Module.finrank_fin_fun]
  · rw [E.finrank_eq,Module.finrank_fin_fun]; decide
  · rw [E.finrank_eq,BinaryPermutation.finrank_natural_odd (Fin 5) (by decide)]; decide

private theorem pair_spaces_disjoint {a : G} (d : TwoFactorModules ρ a) :
    Disjoint (subspaceCommutator ρ ⊤ d.first) (subspaceCommutator ρ ⊤ d.second) := by
  apply disjoint_iff.mpr
  apply bot_unique
  rintro v ⟨h₁,h₂⟩
  have hz := small_factor_fixed_zero d.first_model ⟨v,h₁⟩ (fun k => by
    apply sub_eq_zero.mp
    apply d.cross_first.le
    exact Submodule.subset_span ⟨k,k.property,v,h₂,rfl⟩)
  exact congrArg Subtype.val hz

private theorem rank_one_mem_closure [FiniteDimensional (ZMod 2) V]
    {a : G} (d : TwoFactorModules ρ a) (hf : Function.Injective ρ) (g : G)
    (hr : Module.finrank (ZMod 2) (LinearMap.range (ρ g-LinearMap.id)) ≤ 1) :
    g ∈ normalClosure ({a} : Set G) := by
  rcases d.permutation g with ⟨h₁,h₂⟩ | ⟨h₁,h₂⟩
  · exact TwoFactorReconstruction.mem_closure_of_preserves_factors d hf g h₁ h₂
  · have hd := LinearEquiv.finrank_le_displacement_of_disjoint_image
      (LinearEquiv.ofBijective (ρ g) (ρ.apply_bijective g))
      (subspaceCommutator ρ ⊤ d.first) (subspaceCommutator ρ ⊤ d.second)
      (pair_spaces_disjoint d) (fun v hv => by
        have hm := moved_map_conjugate ρ d.first g
        rw [h₁] at hm
        exact hm ▸ (show ρ g v ∈ (subspaceCommutator ρ ⊤ d.first).map (ρ g) from ⟨v,hv,rfl⟩))
    have hl := small_factor_dimension d.first_model
    change Module.finrank (ZMod 2) (subspaceCommutator ρ ⊤ d.first) ≤
      Module.finrank (ZMod 2) (LinearMap.range (ρ g-LinearMap.id)) at hd
    exact (by decide : ¬ 2 ≤ 1) ((hl.trans hd).trans hr) |>.elim

/-- Rank-one generators cannot interchange the two nontrivial moved factors. -/
theorem one_factor_of_rank_one_generated [FiniteDimensional (ZMod 2) V]
    (hf : Function.Injective ρ)
    (hgen : closure {g : G | Module.finrank (ZMod 2) (LinearMap.range (ρ g-LinearMap.id)) ≤ 1} = ⊤)
    {a : G} (hc : Conclusion ρ a) : OneFactor ρ a := by
  rcases (show OneFactor ρ a ∨ Nonempty (TwoFactors ρ a) from hc.1) with hone | hd
  · exact hone
  · obtain ⟨d⟩ := hd
    have hclosure : normalClosure ({a} : Set G) = ⊤ := by
      apply top_unique
      rw [←hgen]
      exact (closure_le _).mpr (fun g hg => rank_one_mem_closure d.toTwoFactorModules hf g hg)
    obtain ⟨t,_,_,_,ht⟩ := d.extension
    have hn : normalClosure ({a} : Set G) ≤ normalizer (d.first : Set G) := by
      rw [←d.join_eq]
      exact sup_le le_normalizer ((le_centralizer_iff.mp
        (commutator_eq_bot_iff_le_centralizer.mp d.commute)).trans (Subgroup.centralizer_le_normalizer _))
    have htfirst := mem_normalizer_iff_map_conj_eq.mp (hn (hclosure.symm ▸ mem_top t))
    have he : d.first = d.second := htfirst.symm.trans ht
    have hz : d.second = ⊥ := by simpa only [he,inf_idem] using d.disjoint
    exact (d.second_nontrivial hz).elim

/-- A classified transvection closure and its literal centralizer complement.
The action model is on the original displacement orbit, with the original actors. -/
structure TransvectionFactorModel (ρ : Representation (ZMod 2) G V) (t : G)
    extends TransvectionOrbitModel ρ t where
  join_eq : normalClosure ({t} : Set G) ⊔
    centralizer (normalClosure ({t} : Set G) : Set G) = ⊤
  disjoint : Disjoint (normalClosure ({t} : Set G))
    (centralizer (normalClosure ({t} : Set G) : Set G))
  model : FactorModel ρ (normalClosure ({t} : Set G)) space.toSubmodule


/-- Multiplication identifies the actual normal closure and its centralizer
with the original group; both factors retain their literal inclusions. -/
@[expose] def TransvectionFactorModel.productEquiv {t : G}
    (d : TransvectionFactorModel ρ t) :
    normalClosure ({t} : Set G) × centralizer (normalClosure ({t} : Set G) : Set G) ≃* G := by
  let K := normalClosure ({t} : Set G)
  let C := centralizer (K : Set G)
  have hc : ∀ (k : K) (c : C), Commute (k : G) (c : G) := fun k c =>
    mem_centralizer_iff.mp c.property k k.property
  let f := K.subtype.noncommCoprod C.subtype hc
  have hf : Function.Injective f := by
    apply (MonoidHom.noncommCoprod_injective _ _ _).mpr
    simpa only [range_subtype] using
      And.intro K.subtype_injective (And.intro C.subtype_injective d.disjoint)
  have hs : Function.Surjective f := MonoidHom.range_eq_top.mp
    ((MonoidHom.noncommCoprod_range K.subtype C.subtype hc).trans (by
      simpa only [range_subtype] using d.join_eq))
  exact MulEquiv.ofBijective f ⟨hf,hs⟩

theorem TransvectionFactorModel.productEquiv_apply {t : G}
    (d : TransvectionFactorModel ρ t) (k : normalClosure ({t} : Set G))
    (c : centralizer (normalClosure ({t} : Set G) : Set G)) :
    d.productEquiv (k,c) = (k : G) * c := rfl

variable [FiniteDimensional (ZMod 2) V]

/-- The classified orbit image lifts to an actual direct factor of the
original group, with the original action on its displacement orbit. -/
theorem TransvectionOrbitModel.factor_of_rank_one_generated {t : G}
    (d : TransvectionOrbitModel ρ t)
    (hgen : closure {g : G | Module.finrank (ZMod 2) (LinearMap.range (ρ g-LinearMap.id)) ≤ 1} = ⊤) :
    Nonempty (TransvectionFactorModel ρ t) := by
  let S := d.space
  let f := S.toRepresentation.asGroupHom
  let B := f.range
  let q := f.rangeRestrict
  let τ : Representation (ZMod 2) B S.toSubmodule := (Units.coeHom _).comp B.subtype
  let K := normalClosure ({t} : Set G)
  let C := centralizer (K : Set G)
  have hq : Function.Surjective q := f.rangeRestrict_surjective
  have hτ : Function.Injective τ := fun x y he => Subtype.ext (Units.ext he)
  have hrange (g : G) :
      Module.finrank (ZMod 2) (LinearMap.range (τ (q g)-LinearMap.id)) ≤
      Module.finrank (ZMod 2) (LinearMap.range (ρ g-LinearMap.id)) := by
    have hh := fixedCodim_subrepresentation_le ρ S (zpowers g)
    simp only [fixedCodim_zpowers_eq_displacement_rank] at hh
    have he : τ (q g) = S.toRepresentation g := rfl
    rw [he]
    exact hh
  have hBgen : closure {b : B | Module.finrank (ZMod 2)
      (LinearMap.range (τ b-LinearMap.id)) ≤ 1} = ⊤ := by
    let H := closure {b : B | Module.finrank (ZMod 2) (LinearMap.range (τ b-LinearMap.id)) ≤ 1}
    have hg : (⊤ : Subgroup G) ≤ H.comap q := by
      rw [←hgen]
      exact (closure_le _).mpr (fun g hg => subset_closure ((hrange g).trans hg))
    apply top_unique
    intro b _
    obtain ⟨g,rfl⟩ := hq b
    exact hg (mem_top g)
  have hone := one_factor_of_rank_one_generated hτ hBgen d.classification
  have hmodel : FactorModel τ ⊤ ⊤ := hone.2.2 ▸ hone.2.1
  have hmap : K.map q = ⊤ := by
    rw [show K.map q = normalClosure ({q t} : Set B) from by
      simpa only [Set.image_singleton] using map_normalClosure ({t} : Set G) q hq]
    exact hone.1
  have hjoin : K ⊔ C = ⊤ := by
    apply top_unique
    intro g _
    obtain ⟨k,hk,he⟩ := mem_map.mp (hmap.symm ▸ mem_top (q g))
    have hc : k⁻¹*g ∈ C := by
      change k⁻¹*g ∈ centralizer (normalClosure ({t} : Set G) : Set G)
      rw [←d.kernel_eq]
      change f (k⁻¹*g) = 1
      have hfg : f k = f g := congrArg Subtype.val he
      rw [map_mul,map_inv,hfg,inv_mul_cancel]
    have hm := (K ⊔ C).mul_mem (mem_sup_left hk) (mem_sup_right hc)
    simpa only [mul_inv_cancel_left] using hm
  have hdis : Disjoint K C := by
    apply disjoint_def.mpr
    intro k hk hc
    have hf : f k = 1 := by
      change k ∈ f.ker
      rw [d.kernel_eq]
      exact hc
    have he : (⟨k,hk⟩ : K) = 1 := d.closure_injective (by
      apply Subtype.ext
      change f k = f 1
      simpa only [map_one] using hf)
    exact congrArg Subtype.val he
  have hqi : Function.Injective (q.subgroupMap K) := by
    intro x y he
    apply d.closure_injective
    apply Subtype.ext
    exact congrArg (fun b : K.map q => ((b : B) : (Module.End (ZMod 2) S.toSubmodule)ˣ)) he
  let e : K ≃* B :=
    (MulEquiv.ofBijective (q.subgroupMap K) ⟨hqi,q.subgroupMap_surjective K⟩).trans
      ((MulEquiv.subgroupCongr hmap).trans (Subgroup.topEquiv))
  have he (k : K) : e k = q k := rfl
  have transport {H F : Type} [Group H] [AddCommGroup F] [Module (ZMod 2) F]
      (ψ : Representation (ZMod 2) H F) (hm : HasModelOn τ ⊤ ⊤ ψ) :
      HasModelOn ρ K S.toSubmodule ψ := by
    obtain ⟨eH,eF,hs,hψ⟩ := hm
    let ek : K ≃* (⊤ : Subgroup B) := e.trans Subgroup.topEquiv.symm
    let ev : S.toSubmodule ≃ₗ[ZMod 2] (⊤ : Submodule (ZMod 2) S.toSubmodule) :=
      Submodule.topEquiv.symm
    refine ⟨ek.trans eH,ev.trans eF,fun k w => S.apply_mem_toSubmodule k w.property,?_⟩
    intro k w
    exact hψ (ek k) (ev w)
  refine ⟨{ toTransvectionOrbitModel := d, join_eq := hjoin, disjoint := hdis, model := ?_ }⟩
  rcases hmodel with ⟨n,hlo,hhi,hm⟩ | ⟨n,hlo,hhi,hm⟩ | ⟨n,hn,hm⟩
  · exact Or.inl ⟨n,hlo,hhi,transport _ hm⟩
  · exact Or.inr (Or.inl ⟨n,hlo,hhi,transport _ hm⟩)
  · exact Or.inr (Or.inr ⟨n,hn,transport _ hm⟩)

/-- Conjugates of a rank-one actor generate the literal action closure by
rank-at-most-one operators, including when conjugation comes from a larger group. -/
theorem conjugate_span_rank_one_generated
    (ρ : Representation (ZMod 2) G V) (A B : Subgroup G)
    (hr : ∀ t : conjugateSpanBy A B, (t : G) ∈ A →
      Module.finrank (ZMod 2) (LinearMap.range
        ((ρ.comp (conjugateSpanBy A B).subtype) t-LinearMap.id)) ≤ 1) :
    closure {t : conjugateSpanBy A B | Module.finrank (ZMod 2) (LinearMap.range
      ((ρ.comp (conjugateSpanBy A B).subtype) t-LinearMap.id)) ≤ 1} = ⊤ := by
  let J := conjugateSpanBy A B
  let σ := ρ.comp J.subtype
  let O := closure {t : J | Module.finrank (ZMod 2) (LinearMap.range (σ t-LinearMap.id)) ≤ 1}
  have hJO : J ≤ O.map J.subtype := by
    change conjugateSpanBy A B ≤ _
    rw [conjugateSpanBy_eq_iSup_conj]
    apply iSup_le
    intro b
    rintro x ⟨a,ha,rfl⟩
    have ham : a ∈ J := le_conjugateSpanBy A B ha
    have hm : MulAut.conj (b : G) a ∈ J := by
      exact subset_closure ⟨b,b.property,a,ha,rfl⟩
    refine mem_map.mpr ⟨⟨_,hm⟩,subset_closure ?_,rfl⟩
    have hh := fixedCodim_zpowers_conj ρ a b
    simp only [fixedCodim_zpowers_eq_displacement_rank] at hh
    change Module.finrank (ZMod 2) (LinearMap.range
      (ρ (MulAut.conj (b : G) a)-LinearMap.id)) ≤ 1
    exact hh.le.trans (hr ⟨a,ham⟩ ha)
  apply top_unique
  intro j _
  obtain ⟨k,hk,he⟩ := hJO j.property
  exact (show k=j from Subtype.ext he) ▸ hk

open scoped IsMulCommutative
open CFSG.Quasithin.ChapterE
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L M R : Subgroup G} {n : ℕ}
namespace NaturalEscapeGraph.OddConfiguration
variable (d : NaturalEscapeGraph.OddConfiguration T L M R)

/-- Each nonidentity moving actor generates a classified direct factor
of the actual reduced image on W/Z_S. Its complementary factor is its exact
centralizer. The source naturalness and subsequent component/amalgam analysis
remain with the owner of unconditional 6.1.27. -/
theorem exists_reduced_transvection_factors
    (h : Hypothesis611 KnownSimple.IsKnownSimple T L M R n)
    (hnat : IsNaturalModule L (layer L R) n)
    (hE : ChapterE.Section06.HypothesisE61 KnownSimple.IsKnownSimple T M (layer L R))
    (hs : letI := h.layer_elementary; globalS (layer L R) = n)
    (hNS : Subgroup.normalizer (((T : Subgroup G) ⊓
      centralizer (ZS (T : Subgroup G) L R : Set G) : Subgroup G) : Set G) ≤ M)
    (hab : Escape.U (T : Subgroup G) L R ≤
      centralizer (Escape.U (T : Subgroup G) L R : Set G)) :
    n = 2 ∧ ∃ z a : G,
      z ∈ ZS (T : Subgroup G) L R ∧ orderOf z = 2 ∧
      let I := Escape.I (T : Subgroup G) L R
      let Z := ZS (T : Subgroup G) L R
      let W := Escape.U (T : Subgroup G) L R ⊓
        conjugateSpanBy Z (centralizer ({z} : Set G))
      let E := (layer L R).map (MulAut.conj a).toMonoidHom
      let Z' := Z.map (MulAut.conj d.representative).toMonoidHom
      let P := conjugateSpanBy E I
      E ≤ I ∧ Z ≤ W ∧ Z' ≤ W ∧ E ⊓ W = Z' ∧
      ∃ (hIW : I ≤ Subgroup.normalizer (W : Set G))
        (hN : (Z.subgroupOf W).Normal),
      letI := hN
      ∃ σ : I →* MulAut (W ⧸ Z.subgroupOf W),
        (∀ i : I, ∀ w : W,
          σ i (QuotientGroup.mk' (Z.subgroupOf W) w) =
            QuotientGroup.mk' (Z.subgroupOf W)
              ⟨(i : G) * (w : G) * (i : G)⁻¹,
                (mem_normalizer_iff.mp (hIW i.property) w).mp w.property⟩) ∧
      ∃ hX : IsElementaryAbelian 2 (W ⧸ Z.subgroupOf W),
        letI := hX
        let A := (E.subgroupOf I).map σ
        let J := (P.subgroupOf I).map σ
        let θ : Representation (ZMod 2) J (Additive (W ⧸ Z.subgroupOf W)) :=
          Representation.ofElementaryAbelianAction
          (A := J) (G := W ⧸ Z.subgroupOf W) (p := 2)
        IsElementaryAbelian 2 A ∧ 1 < Nat.card A ∧ Nat.card A ≤ 4 ∧
        commutatorAction A (W ⧸ Z.subgroupOf W) =
          (Z'.subgroupOf W).map (QuotientGroup.mk' (Z.subgroupOf W)) ∧
        Nat.card ((Z'.subgroupOf W).map (QuotientGroup.mk' (Z.subgroupOf W))) = 2 ∧
        commutatorAction₂ A (W ⧸ Z.subgroupOf W) = ⊥ ∧
        σ.ker = (commutatorPreimage I W Z).subgroupOf I ∧
        J = conjugateSpanBy A σ.range ∧ pCore 2 J = ⊥ ∧
        ChapterB.SourceInduction.FFHypothesis KnownSimple.IsKnownSimple θ ∧
        ChapterB.SourceInduction.NontrivialAdequateAlternative θ ∧
        ∀ t : J, (t : MulAut (W ⧸ Z.subgroupOf W)) ∈ A → t ≠ 1 →
          Module.finrank (ZMod 2) (LinearMap.range
            (θ t - LinearMap.id (R := ZMod 2) (M := Additive (W ⧸ Z.subgroupOf W)))) = 1 ∧
            Nonempty (TransvectionFactorModel θ t) := by
  obtain ⟨hn,z,a,hz,ho,hEI,hZW,hZ'W,hEW,hIW,hN,σ,hσ,hX,hA,hpos,hsize,
      hdisp,hcard,hquad,hker,hspan,hcore,hff,hclass,hrank⟩ :=
    d.exists_reduced_transvection_models h hnat hE hs hNS hab
  let I := Escape.I (T : Subgroup G) L R
  let Z := ZS (T : Subgroup G) L R
  let W := Escape.U (T : Subgroup G) L R ⊓
    conjugateSpanBy Z (centralizer ({z} : Set G))
  let E := (layer L R).map (MulAut.conj a).toMonoidHom
  let P := conjugateSpanBy E I
  let := hN
  let := hX
  let X := W ⧸ Z.subgroupOf W
  let A := (E.subgroupOf I).map σ
  let J := (P.subgroupOf I).map σ
  let θ := Representation.ofElementaryAbelianAction (A := J) (G := X) (p := 2)
  let ρ := Representation.ofElementaryAbelianAction (A := MulAut X) (G := X) (p := 2)
  have hgen : closure {t : J | Module.finrank (ZMod 2)
      (LinearMap.range (θ t-LinearMap.id)) ≤ 1} = ⊤ := by
    have hr : ∀ t : J, (t : MulAut X) ∈ A →
        Module.finrank (ZMod 2) (LinearMap.range ((ρ.comp J.subtype) t-LinearMap.id)) ≤ 1 := by
      intro t ht
      by_cases he : t=1
      · subst t
        have hz : LinearMap.range ((ρ.comp J.subtype) 1-LinearMap.id) = ⊥ := by
          rw [map_one]
          exact (sub_self (LinearMap.id : Additive X →ₗ[ZMod 2] Additive X)) ▸
            LinearMap.range_zero
        let : Subsingleton (LinearMap.range ((ρ.comp J.subtype) 1-LinearMap.id)) :=
          hz ▸ inferInstance
        rw [Module.finrank_zero_of_subsingleton]
        exact Nat.zero_le 1
      · exact (hrank t ht he).1.le
    change closure {t : J | Module.finrank (ZMod 2)
      (LinearMap.range ((ρ.comp J.subtype) t-LinearMap.id)) ≤ 1} = ⊤
    change J = conjugateSpanBy A σ.range at hspan
    rw [hspan] at hr ⊢
    exact conjugate_span_rank_one_generated ρ A σ.range hr
  refine ⟨hn,z,a,hz,ho,hEI,hZW,hZ'W,hEW,hIW,hN,σ,hσ,hX,hA,hpos,hsize,
    hdisp,hcard,hquad,hker,hspan,hcore,hff,hclass,?_⟩
  intro t ht ht1
  obtain ⟨hr,⟨m⟩⟩ := hrank t ht ht1
  exact ⟨hr,m.factor_of_rank_one_generated hgen⟩

end NaturalEscapeGraph.OddConfiguration

