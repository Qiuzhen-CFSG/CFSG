module
public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleGenericGlobalOriginalExtension.UnitaryFourSplitPair
public import Theory.SpecificGroups.ClassicalUnitary.UnitaryFourConverse.PointParabolic
import all CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleGenericGlobalOriginalExtension.UnitaryFourFactors
import all CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleGenericGlobalOriginalExtension.UnitaryFourSplitPair

/-!
# Detecting the original U₄ graph action on the whole native carrier

An automorphism fixing the plane residual fixes the entire point radical.
That radical recovers the full point parabolic as its normalizer, so the
point residual is preserved. The faithful core action of the original
perfect selected R forces pointwise fixation of this residual. Both native
residuals generate: the original reduced endpoints are generated by their
own residual and the opposite Borel, and their images are the full native
parabolics. Thus the ambient automorphism is the identity.

Apply this rigidity to the corrected original graph lift using coordinates
restricted from the SAME left marking. Its action is the prescribed graph
automorphism on the whole native U₄, not just on L or its quotient. Relative
Sylow conjugacy then supplies an involution in the literal source S, retaining
the exact native conjugator from LS. The existing split construction supplies
both full endpoint and full-overlap inclusion squares for this same actor.

The conjugator need not preserve the opposite endpoint. Identifying both
endpoint images with the fixed catalogue graph extension remains necessary.
DGS exhaustion, prepared U₅, uniqueness and unconditional GlobalExit remain
with the original assembly. Arbitrary selected perfect R, both input
orientations, q=4, and the full odd overlap are retained. No equality S=T or
R=O²(H), and no full-overlap two-core identity, is used.

Source: Aschbacher--Smith F.1.12, pp.263--264, and 5.2.6--7, pp.650--651
(`refs/quasithin.pdf`). The internal imports reuse the original residual
coordinates and conjugation transport without changing their public APIs.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open CFSG.Quasithin.ChapterF.GreenBook.LieModels.UnitaryFour
open Theory.SpecificGroups.ClassicalUnitary
namespace CFSG.Quasithin.Chapter6.Source.RankOneGeneric.Global.OriginalUnitaryFour

private theorem point_core_image (m : ℕ) (hm : 1 ≤ m) :
    (PointLocal.ProjectiveLocal m hm).pCoreIn 2 =
      (UnitaryFourConverse.PointParabolic.ambientRadical (MatrixField m) (fieldConj m)
        (fieldConj_involutive m hm)).map (Extension.projectEquiv m hm).toMonoidHom := by
  unfold pCoreIn
  rw [PointLocal.projectiveLocal_twoCore]
  change ((PointLocal.Radical m hm).map (PointLocal.localEquiv m hm).toMonoidHom).map _ =
    ((PointLocal.Radical m hm).map (PointLocal.MatrixLocal m hm).subtype).map _
  rw [map_map,map_map]
  rfl

/-- The point radical recovers the entire native point parabolic. -/
theorem point_core_normalizer (m : ℕ) (hm : 1 ≤ m) :
    normalizer ((PointLocal.ProjectiveLocal m hm).pCoreIn 2 : Set (ProjectiveGroup m hm)) =
      pointParabolic m hm := by
  rw [point_core_image]
  have he := map_equiv_normalizer_eq
    (UnitaryFourConverse.PointParabolic.ambientRadical (MatrixField m) (fieldConj m)
      (fieldConj_involutive m hm)) (Extension.projectEquiv m hm)
  rw [UnitaryFourConverse.PointParabolic.normalizer_ambientRadical] at he
  exact he.symm

/-- The whole point radical belongs to the native plane residual. -/
theorem point_core_le_plane (m : ℕ) (hm : 1 ≤ m) :
    (PointLocal.ProjectiveLocal m hm).pCoreIn 2 ≤ L2 m hm := by
  have hU := upperProjective_le_pointLocal m hm
  have hc := pCoreIn_le_sylow (PointLocal.ProjectiveLocal m hm)
    ((projectiveSylow m hm).subtype hU)
  have hc' : (PointLocal.ProjectiveLocal m hm).pCoreIn 2 ≤ upperProjective m hm := by
    intro x hx
    obtain ⟨y,hy,he⟩ := hc hx
    exact he ▸ hy
  exact hc'.trans (two_subgroup_le_L2 m hm _ (projectiveSylow m hm).isPGroup'
    (projectiveSylow_le_parabolics m hm).2)

end CFSG.Quasithin.Chapter6.Source.RankOneGeneric.Global.OriginalUnitaryFour

namespace CFSG.Quasithin.Chapter6.Source.RankOneGeneric.Global.Preparation
variable {G : Type*} [Group G] [Finite G]
  {κ : GroupClass} {T : Sylow 2 G} {L W H A B R : Subgroup G} {n : ℕ}
  (d : Preparation T L H A B R) (h : Input κ T L W n)
  (hTH : (T : Subgroup G) ≤ H) (hp : Group.IsPerfect R)
  (m : ℕ) (hm : 1 ≤ m)
  (mark : OriginalUnitaryFour.Marking m hm false L R (sourceS L H))

include d h hTH hp mark in
/-- The two marked native residuals generate the whole carrier. -/
theorem original_unitaryFour_native_residuals_generate :
    L2 m hm ⊔ PointLocal.ProjectiveLocal m hm = ⊤ := by
  let X := ProjectiveGroup m hm
  let K := L2 m hm ⊔ PointLocal.ProjectiveLocal m hm
  let C := K.map (MulAut.conj : X →* MulAut X)
  let P₀ := ChapterF.Source.parabolic ![L,R] (sourceS L H) 0
  let P₁ := ChapterF.Source.parabolic ![L,R] (sourceS L H) 1
  have hL₀ : L ≤ P₀ := le_sup_left.trans le_sup_left
  have hR₁ : R ≤ P₁ := le_sup_left.trans le_sup_left
  have hmgt := d.original_unitaryFour_nonbinary h hTH hp m hm false mark
  have hL : ∀ x : P₀, x.val ∈ L → mark.left x ∈ C := by
    intro x hx
    have hh := mark.left_residual ▸ mem_map_of_mem mark.left
      ((d.original_local_eq_residual h hTH hp 0).le hx)
    change mark.left x ∈ ((solvableResidual (planeParabolic m hm)).map (planeParabolic m hm).subtype).map MulAut.conj at hh
    rw [OriginalUnitaryFour.plane_parabolic_residual m hm] at hh
    exact (map_mono (show L2 m hm ≤ K from le_sup_left)) hh
  have hR : ∀ x : P₁, x.val ∈ R → mark.right x ∈ C := by
    intro x hx
    have hh := mark.right_residual ▸ mem_map_of_mem mark.right
      ((d.original_local_eq_residual h hTH hp 1).le hx)
    change mark.right x ∈ ((solvableResidual (pointParabolic m hm)).map (pointParabolic m hm).subtype).map MulAut.conj at hh
    rw [PointLocal.pointParabolic_solvableResidual m hm hmgt] at hh
    exact (map_mono (show PointLocal.ProjectiveLocal m hm ≤ K from le_sup_right)) hh
  have hD₀ : reducedParabolic ![L,R] (sourceS L H) 0 ≤ (C.comap mark.left).map P₀.subtype := by
    apply sup_le
    · intro x hx
      exact ⟨⟨x,hL₀ hx⟩,hL _ hx,rfl⟩
    · intro x hx
      have h₀ : x ∈ P₀ := (show ChapterF.Source.borel R (sourceS L H) ≤ P₀ from le_sup_right) hx
      have h₁ := hR₁ hx.1
      refine ⟨⟨x,h₀⟩,?_,rfl⟩
      change mark.left ⟨x,h₀⟩ ∈ C
      have he := mark.agrees ⟨x,h₀,h₁⟩
      change mark.left ⟨x,h₀⟩=mark.right ⟨x,h₁⟩ at he
      rw [he]
      exact hR _ hx.1
  have hD₁ : reducedParabolic ![L,R] (sourceS L H) 1 ≤ (C.comap mark.right).map P₁.subtype := by
    apply sup_le
    · intro x hx
      exact ⟨⟨x,hR₁ hx⟩,hR _ hx,rfl⟩
    · intro x hx
      have h₀ := hL₀ hx.1
      have h₁ : x ∈ P₁ := (show ChapterF.Source.borel L (sourceS L H) ≤ P₁ from le_sup_right) hx
      refine ⟨⟨x,h₁⟩,?_,rfl⟩
      change mark.right ⟨x,h₁⟩ ∈ C
      have he := mark.agrees ⟨x,h₀,h₁⟩
      change mark.left ⟨x,h₀⟩=mark.right ⟨x,h₁⟩ at he
      rw [←he]
      exact hL _ hx.1
  have heq (i : Fin 2) :
      ChapterF.Source.parabolic ![L,R] ((T : Subgroup G) ⊓ L) i =
        reducedParabolic ![L,R] (sourceS L H) i := by
    rw [d.original_unitaryFour_reduced_parabolics h hTH hp m hm false mark i,
      d.reducedParabolic_eq_twoResidual h hTH hp
        (d.original_unitaryFour_intersections h hTH hp m hm false mark) i]
  have hb₀ : planeParabolic m hm ≤ K := by
    intro x hx
    have hx' : MulAut.conj x ∈
        (mark.left.comp (inclusion (d.originalUnitaryFour_reduced_le h hTH hp m hm false mark 0))).range :=
      (d.original_unitaryFour_reduced_images h hTH hp m hm false mark).1.symm ▸ mem_map_of_mem _ hx
    obtain ⟨y,hy⟩ := hx'
    have hyD := hD₀ ((heq 0).le y.property)
    have hh : mark.left (inclusion (d.originalUnitaryFour_reduced_le h hTH hp m hm false mark 0) y) ∈ C := by
      change inclusion (d.originalUnitaryFour_reduced_le h hTH hp m hm false mark 0) y ∈ C.comap mark.left
      exact (mem_map_iff_mem P₀.subtype_injective).mp hyD
    rw [show mark.left (inclusion (d.originalUnitaryFour_reduced_le h hTH hp m hm false mark 0) y) = MulAut.conj x from hy] at hh
    exact (mem_map_iff_mem (ChapterF.SourceCompletion.UnitaryNonbinary.four_conj_injective m hm)).mp hh
  have hb₁ : pointParabolic m hm ≤ K := by
    intro x hx
    have hx' : MulAut.conj x ∈
        (mark.right.comp (inclusion (d.originalUnitaryFour_reduced_le h hTH hp m hm false mark 1))).range :=
      (d.original_unitaryFour_reduced_images h hTH hp m hm false mark).2.symm ▸ mem_map_of_mem _ hx
    obtain ⟨y,hy⟩ := hx'
    have hyD := hD₁ ((heq 1).le y.property)
    have hh : mark.right (inclusion (d.originalUnitaryFour_reduced_le h hTH hp m hm false mark 1) y) ∈ C := by
      change inclusion (d.originalUnitaryFour_reduced_le h hTH hp m hm false mark 1) y ∈ C.comap mark.right
      exact (mem_map_iff_mem P₁.subtype_injective).mp hyD
    rw [show mark.right (inclusion (d.originalUnitaryFour_reduced_le h hTH hp m hm false mark 1) y) = MulAut.conj x from hy] at hh
    exact (mem_map_iff_mem (ChapterF.SourceCompletion.UnitaryNonbinary.four_conj_injective m hm)).mp hh
  exact top_le_iff.mp ((parabolics_generate m hm).symm.le.trans (sup_le hb₁ hb₀))
end CFSG.Quasithin.Chapter6.Source.RankOneGeneric.Global.Preparation

namespace CFSG.Quasithin.Chapter6.Source.RankOneGeneric.Global.Preparation
variable {G : Type*} [Group G] [Finite G]
  {κ : GroupClass} {T : Sylow 2 G} {L W H A B R : Subgroup G} {n : ℕ}
  (d : Preparation T L H A B R) (h : Input κ T L W n)
  (hTH : (T : Subgroup G) ≤ H) (hp : Group.IsPerfect R)
  (m : ℕ) (hm : 1 ≤ m)
  (mark : OriginalUnitaryFour.Marking m hm false L R (sourceS L H))
include d h hTH hp mark

/-- The plane residual detects native ambient automorphisms in the actual
original marking, without an assumption on the other endpoint action. -/
theorem original_unitaryFour_native_aut_eq_one
    (α : MulAut (ProjectiveGroup m hm))
    (hfix : ∀ x : L2 m hm, α x.val=x.val) : α=1 := by
  let K := PointLocal.ProjectiveLocal m hm
  let Q := K.pCoreIn 2
  have hq (x : ProjectiveGroup m hm) (hx : x ∈ Q) : α x=x :=
    hfix ⟨x,OriginalUnitaryFour.point_core_le_plane m hm hx⟩
  have hQ : Q.map α.toMonoidHom=Q := by
    ext x
    constructor
    · rintro ⟨y,hy,rfl⟩
      exact (hq y hy).symm ▸ hy
    · intro hx
      exact ⟨x,hx,hq x hx⟩
  have hP : (pointParabolic m hm).map α.toMonoidHom=pointParabolic m hm := by
    rw [←OriginalUnitaryFour.point_core_normalizer m hm, map_equiv_normalizer_eq,hQ]
  have hmgt := d.original_unitaryFour_nonbinary h hTH hp m hm false mark
  have hK : K.map α.toMonoidHom=K := by
    have he := map_solvableResidual_comap α.toMonoidHom α.surjective (pointParabolic m hm)
    have hc : (pointParabolic m hm).comap α.toMonoidHom=pointParabolic m hm := by
      conv_lhs => rw [←hP]
      exact comap_map_eq_self_of_injective α.injective _
    rw [hc,PointLocal.pointParabolic_solvableResidual m hm hmgt] at he
    exact he
  let b : R ≃* K := (d.originalUnitaryFourRightEquiv h hTH hp m hm false mark).trans
    (MulEquiv.subgroupCongr (PointLocal.pointParabolic_solvableResidual m hm hmgt))
  let β : MulAut K := (α.subgroupMap K).trans (MulEquiv.subgroupCongr hK)
  let γ := MulAut.congr b.symm β
  have hγ : γ=1 := d.original_unitaryFour_right_core_action_faithful h hTH hp m hm false mark (by
    rw [map_one]
    apply MulEquiv.ext
    intro x
    apply Subtype.ext
    apply b.injective
    change b (b.symm (β (b x.val)))=b x.val
    rw [b.apply_symm_apply]
    apply Subtype.ext
    change α (b x.val).val=(b x.val).val
    apply hq
    change K.subtype (b x.val) ∈ (pCore 2 K).map K.subtype
    apply mem_map_of_mem K.subtype
    rw [←pCore_map_iso 2 b]
    exact mem_map_of_mem b.toMonoidHom x.property)
  have hβ : β=1 := (MulAut.congr b.symm).injective (hγ.trans (map_one _).symm)
  let C := α.toMonoidHom.eqLocus (MonoidHom.id _)
  have hle : L2 m hm ⊔ K ≤ C := by
    apply sup_le
    · intro x hx
      exact hfix ⟨x,hx⟩
    · intro x hx
      exact congrArg Subtype.val (DFunLike.congr_fun hβ ⟨x,hx⟩)
  rw [d.original_unitaryFour_native_residuals_generate h hTH hp m hm mark] at hle
  apply MulEquiv.ext
  intro x
  exact hle (mem_top x)
end CFSG.Quasithin.Chapter6.Source.RankOneGeneric.Global.Preparation

namespace CFSG.Quasithin.Chapter6.Source.RankOneGeneric.Global.Preparation
variable {G : Type*} [Group G] [Finite G]
  {κ : GroupClass} {T : Sylow 2 G} {L W H A B R : Subgroup G} {n : ℕ}
  (d : Preparation T L H A B R) (h : Input κ T L W n)
  (hTH : (T : Subgroup G) ≤ H) (hp : Group.IsPerfect R)
  (m : ℕ) (hm : 1 ≤ m)
  (mark : OriginalUnitaryFour.Marking m hm false L R (sourceS L H))

/-- Plane coordinates restricted from the given original left marking. -/
def originalUnitaryFourPlaneEquiv : L ≃* L2 m hm :=
  (d.originalUnitaryFourLeftEquiv h hTH hp m hm false mark).trans
    (MulEquiv.subgroupCongr (OriginalUnitaryFour.plane_parabolic_residual m hm))

theorem originalUnitaryFourPlaneEquiv_apply (x : L) :
    MulAut.conj (d.originalUnitaryFourPlaneEquiv h hTH hp m hm mark x).val =
      mark.left (inclusion (show L ≤ ChapterF.Source.parabolic ![L,R] (sourceS L H) 0 from
        le_sup_left.trans le_sup_left) x) := by
  exact d.originalEndpointResidualEquiv_apply h hTH hp 0 mark.left mark.left_injective
    (MulAut.conj.comp (OriginalUnitaryFour.endpoint m hm false).subtype)
    ((ChapterF.SourceCompletion.UnitaryNonbinary.four_conj_injective m hm).comp
      (OriginalUnitaryFour.endpoint m hm false).subtype_injective)
    (by simpa only [map_map] using mark.left_residual) x

include d h hTH hp mark in
/-- Equality on the marked plane residual implies equality on the entire
native carrier. No prescribed action on the opposite endpoint is assumed. -/
theorem original_unitaryFour_native_aut_ext
    (α β : MulAut (ProjectiveGroup m hm))
    (he : ∀ x : L2 m hm, α x.val=β x.val) : α=β := by
  have hh := d.original_unitaryFour_native_aut_eq_one h hTH hp m hm mark (β⁻¹*α) (by
    intro x
    change β.symm (α x.val)=x.val
    rw [he,β.symm_apply_apply])
  exact (inv_mul_eq_one.mp hh).symm

include d h hTH hp mark in
/-- The corrected original lift realizes the prescribed graph involution
on the whole native group, with the same original endpoint embedding. -/
theorem original_unitaryFour_ambient_graph_generator
    (hi : ((T : Subgroup G) ⊓ L).relIndex (sourceS L H)=2) :
    ∃ t : (L ⊔ sourceS L H : Subgroup G), t.val ∉ L ∧ orderOf t.val=2 ∧
      mark.left (inclusion le_sup_left t)=Extension.projectiveAut m hm := by
  let a := d.originalUnitaryFourPlaneEquiv h hTH hp m hm mark
  obtain ⟨t,hout,ht,hact⟩ := d.original_unitaryFour_residual_graph_generator h hTH hp m hm false mark a hi
  refine ⟨t,hout,ht,?_⟩
  apply d.original_unitaryFour_native_aut_ext h hTH hp m hm mark
  intro x
  have hn : L ⊔ sourceS L H ≤ normalizer (L : Set G) := sup_le L.le_normalizer
    ((sourceS_le_sylow h.sylow_normalizes hTH).trans h.sylow_normalizes)
  have he := marked_conjugation L (ChapterF.Source.parabolic ![L,R] (sourceS L H) 0)
    (le_sup_left.trans le_sup_left) (L2 m hm) a mark.left
    (ChapterF.SourceCompletion.UnitaryNonbinary.four_conj_injective m hm)
    (d.originalUnitaryFourPlaneEquiv_apply h hTH hp m hm mark)
    (inclusion le_sup_left t) (hn t.property) (a.symm x)
  rw [a.apply_symm_apply] at he
  have hh := congrArg Subtype.val (DFunLike.congr_fun hact x)
  exact he.symm.trans (hh.trans (Extension.L2Aut_val m hm x))
end CFSG.Quasithin.Chapter6.Source.RankOneGeneric.Global.Preparation

namespace CFSG.Quasithin.Chapter6.Source.RankOneGeneric.Global.Preparation
variable {G : Type*} [Group G] [Finite G]
  {κ : GroupClass} {T : Sylow 2 G} {L W H A B R : Subgroup G} {n : ℕ}
  (d : Preparation T L H A B R) (h : Input κ T L W n)
  (hTH : (T : Subgroup G) ≤ H) (hp : Group.IsPerfect R)
  (m : ℕ) (hm : 1 ≤ m) (point : Bool)
  (mark : OriginalUnitaryFour.Marking m hm point L R (sourceS L H))
include d h hTH hp mark

/-- The actual source S contains an involution whose action on the WHOLE
native carrier is the specified graph automorphism conjugated by the image
of an element of the original LS. All three native endpoint actions use it. -/
theorem original_unitaryFour_source_ambient_graph
    (hi : ((T : Subgroup G) ⊓ L).relIndex (sourceS L H)=2) :
    ∃ t : sourceS L H, t.val ∉ L ∧ orderOf t.val=2 ∧
      ∃ c : (L ⊔ sourceS L H : Subgroup G),
        mark.sylowHom t = mark.left (inclusion le_sup_left c) * Extension.projectiveAut m hm *
          (mark.left (inclusion le_sup_left c))⁻¹ := by
  have ho := d.original_unitaryFour_orientation h hTH hp m hm point mark
  subst point
  let J := L ⊔ sourceS L H
  let f := mark.left.comp (inclusion (show J ≤ ChapterF.Source.parabolic ![L,R] (sourceS L H) 0 from le_sup_left))
  obtain ⟨t,hout,ht,ha⟩ := d.original_unitaryFour_ambient_graph_generator h hTH hp m hm mark hi
  have htJ : orderOf t=2 := (Subgroup.orderOf_coe t).symm.trans ht
  have hcyc : IsPGroup 2 (zpowers t) := IsPGroup.iff_card.mpr
    ⟨1,by rw [Nat.card_zpowers,htJ,pow_one]⟩
  have hs : Chapter1.IsSylowIn 2 (sourceS L H)
      (ChapterF.Source.parabolic ![L,R] (sourceS L H) 0) :=
    (d.hypothesisF11 h hTH).sylow_parabolic 0
  obtain ⟨P,hP⟩ := hs.restrict (show sourceS L H ≤ J from le_sup_right)
    (show J ≤ ChapterF.Source.parabolic ![L,R] (sourceS L H) 0 from le_sup_left)
  obtain ⟨Q,hQ⟩ := hcyc.exists_le_sylow
  obtain ⟨c,hc⟩ := MulAction.exists_smul_eq J Q P
  have hcP : c*t*c⁻¹ ∈ (P : Subgroup J) := by
    rw [←hc]
    exact ⟨t,hQ (mem_zpowers t),rfl⟩
  have hcS : (c : G)*t.val*(c : G)⁻¹ ∈ sourceS L H :=
    hP.le (mem_map_of_mem J.subtype hcP)
  let s : sourceS L H := ⟨(c : G)*t.val*(c : G)⁻¹,hcS⟩
  refine ⟨s,?_,?_,c,?_⟩
  · intro hL
    have hn : J ≤ normalizer (L : Set G) := sup_le L.le_normalizer
      ((sourceS_le_sylow h.sylow_normalizes hTH).trans h.sylow_normalizes)
    exact hout ((mem_normalizer_iff.mp (hn c.property) t.val).mpr hL)
  · exact (orderOf_injective (MulAut.conj c.val).toMonoidHom (MulAut.conj c.val).injective t.val).trans ht
  · rw [mark.sylowHom_left]
    change f (c*t*c⁻¹)=f c * Extension.projectiveAut m hm * (f c)⁻¹
    rw [map_mul,map_mul,map_inv,show f t=Extension.projectiveAut m hm from ha]

/-- The same actual S involution gives both full split inclusion squares
and the now identified ambient conjugate graph action. -/
theorem original_unitaryFour_ambient_graph_split_pair
    (hi : ((T : Subgroup G) ⊓ L).relIndex (sourceS L H)=2) :
    ∃ (t : sourceS L H) (hout : t.val ∉ L) (ht : orderOf t.val=2),
      Nonempty (RankTwoAmalgam.Iso (sourceParabolicAmalgam ![L,R] (sourceS L H))
        (RankTwoAmalgam.semidirect
          (d.originalUnitaryFourNativePairAction h hTH hp m hm point mark hi t hout ht))) ∧
      ∃ c : (L ⊔ sourceS L H : Subgroup G),
        mark.sylowHom t = mark.left (inclusion le_sup_left c) * Extension.projectiveAut m hm *
          (mark.left (inclusion le_sup_left c))⁻¹ := by
  obtain ⟨t,hout,ht,c,hc⟩ := d.original_unitaryFour_source_ambient_graph h hTH hp m hm point mark hi
  exact ⟨t,hout,ht,⟨d.originalUnitaryFourNativeSplitComparison h hTH hp m hm point mark hi t hout ht⟩,c,hc⟩
end CFSG.Quasithin.Chapter6.Source.RankOneGeneric.Global.Preparation
