module
public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleGenericGlobalOriginalExtension.Marked
public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleGenericGlobalUnitaryReduction

/-!
# Restricting original extension markings to the two-residual endpoints

Each reduced endpoint is generated by its selected perfect factor and the
opposite local Borel. Full-overlap agreement puts both generators in the inner
carrier. When a native endpoint has no nontrivial two-group quotient, its
embedded copy lies in the original endpoint's two-residual. The reverse
containment follows from the inner-image calculation and the base marking.

Restricting the two original maps to these subgroups preserves their entire
intersection: surjectivity onto that intersection uses the original whole-
overlap equation, not merely agreement on a chosen Sylow. This yields all
three isomorphisms and both inclusion squares. The U₄ application in
`UnitaryFourReduced` supplies the native two-residual hypotheses.

Source: Aschbacher--Smith F.1.12, p.264, and the two-residual replacement
before 5.2.7, pp.650--651 (`refs/quasithin.pdf`).
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter6.Source.RankOneGeneric.Global
namespace OriginalExtension
variable {P X : Type*} [Group P] [Group X]
private theorem native_le_twoResidual_image (f : P →* MulAut X)
    (hf : Function.Injective f) (Q : Subgroup X)
    (hQ : Q.map MulAut.conj ≤ f.range) (hp : pResidual 2 Q = ⊤) :
    Q.map MulAut.conj ≤ (pResidual 2 P).map f := by
  let a := MonoidHom.ofInjective hf
  let j₀ : Q →* f.range := (MulAut.conj.comp Q.subtype).codRestrict f.range
    (fun x => hQ (mem_map_of_mem _ x.property))
  let j : Q →* P := a.symm.toMonoidHom.comp j₀
  have hj (x : Q) : f (j x) = MulAut.conj x.val :=
    congrArg Subtype.val (a.apply_symm_apply (j₀ x))
  have hr : j.range ≤ pResidual 2 P := by
    rw [MonoidHom.range_eq_map,←hp]
    exact map_pResidual_le 2 j
  rintro _ ⟨x,hx,rfl⟩
  exact ⟨j ⟨x,hx⟩,hr ⟨⟨x,hx⟩,rfl⟩,hj ⟨x,hx⟩⟩
end OriginalExtension

namespace Preparation
variable {G X : Type*} [Group G] [Finite G] [Group X]
  {κ : GroupClass} {T : Sylow 2 G} {L W H A B R : Subgroup G} {n : ℕ}
  (d : Preparation T L H A B R) (h : Input κ T L W n)
  (hTH : (T : Subgroup G) ≤ H) (hp : Group.IsPerfect R)
  {K₀ K₁ Q₀ Q₁ : Subgroup X}
  (e : OriginalExtension.Marking L R (sourceS L H) K₀ K₁ Q₀ Q₁)
include d h hTH hp e

private theorem original_reduced_endpoints_inner :
    ((reducedParabolic ![L,R] (sourceS L H) 0).subgroupOf
      (ChapterF.Source.parabolic ![L,R] (sourceS L H) 0)).map e.left ≤ MulAut.innerSubgroup X ∧
    ((reducedParabolic ![L,R] (sourceS L H) 1).subgroupOf
      (ChapterF.Source.parabolic ![L,R] (sourceS L H) 1)).map e.right ≤ MulAut.innerSubgroup X := by
  let P₀ := ChapterF.Source.parabolic ![L,R] (sourceS L H) 0
  let P₁ := ChapterF.Source.parabolic ![L,R] (sourceS L H) 1
  let I := MulAut.innerSubgroup X
  have hL₀ : L ≤ P₀ := le_sup_left.trans le_sup_left
  have hR₁ : R ≤ P₁ := le_sup_left.trans le_sup_left
  have hL : ∀ x : P₀, x.val ∈ L → e.left x ∈ I := by
    intro x hx
    exact map_le_range _ _ (e.left_residual ▸ mem_map_of_mem e.left
      ((d.original_local_eq_residual h hTH hp 0).le hx))
  have hR : ∀ x : P₁, x.val ∈ R → e.right x ∈ I := by
    intro x hx
    exact map_le_range _ _ (e.right_residual ▸ mem_map_of_mem e.right
      ((d.original_local_eq_residual h hTH hp 1).le hx))
  have hD₀ : reducedParabolic ![L,R] (sourceS L H) 0 ≤ (I.comap e.left).map P₀.subtype := by
    apply sup_le
    · intro x hx
      exact ⟨⟨x,hL₀ hx⟩,hL _ hx,rfl⟩
    · intro x hx
      have h₀ : x ∈ P₀ := (show ChapterF.Source.borel R (sourceS L H) ≤ P₀ from le_sup_right) hx
      have h₁ := hR₁ hx.1
      refine ⟨⟨x,h₀⟩,?_,rfl⟩
      change e.left ⟨x,h₀⟩ ∈ I
      have he := e.agrees ⟨x,h₀,h₁⟩
      change e.left ⟨x,h₀⟩ = e.right ⟨x,h₁⟩ at he
      rw [he]
      exact hR _ hx.1
  have hD₁ : reducedParabolic ![L,R] (sourceS L H) 1 ≤ (I.comap e.right).map P₁.subtype := by
    apply sup_le
    · intro x hx
      exact ⟨⟨x,hR₁ hx⟩,hR _ hx,rfl⟩
    · intro x hx
      have h₀ := hL₀ hx.1
      have h₁ : x ∈ P₁ := (show ChapterF.Source.borel L (sourceS L H) ≤ P₁ from le_sup_right) hx
      refine ⟨⟨x,h₁⟩,?_,rfl⟩
      change e.right ⟨x,h₁⟩ ∈ I
      have he := e.agrees ⟨x,h₀,h₁⟩
      change e.left ⟨x,h₀⟩ = e.right ⟨x,h₁⟩ at he
      rw [←he]
      exact hL _ hx.1
  constructor
  · rintro _ ⟨x,hx,rfl⟩
    exact (mem_map_iff_mem P₀.subtype_injective).mp (hD₀ hx)
  · rintro _ ⟨x,hx,rfl⟩
    exact (mem_map_iff_mem P₁.subtype_injective).mp (hD₁ hx)

/-- If the native endpoints have no two-quotient, they are exactly the
images of the original two-residuals. The original outer parts are retained. -/
theorem original_twoResidual_images
    (hs : sourceS L H ⊓ L = sourceS L H ⊓ R)
    (hQ₀ : pResidual 2 Q₀ = ⊤) (hQ₁ : pResidual 2 Q₁ = ⊤) :
    (pResidual 2 (ChapterF.Source.parabolic ![L,R] (sourceS L H) 0)).map e.left = Q₀.map MulAut.conj ∧
    (pResidual 2 (ChapterF.Source.parabolic ![L,R] (sourceS L H) 1)).map e.right = Q₁.map MulAut.conj := by
  have hres (i : Fin 2) : pResidual 2 (ChapterF.Source.parabolic ![L,R] (sourceS L H) i) =
      (reducedParabolic ![L,R] (sourceS L H) i).subgroupOf
        (ChapterF.Source.parabolic ![L,R] (sourceS L H) i) := by
    rw [←d.reducedParabolic_eq_twoResidual h hTH hp hs i]
    exact (comap_map_eq_self_of_injective
      (ChapterF.Source.parabolic ![L,R] (sourceS L H) i).subtype_injective _).symm
  have hi := d.original_reduced_endpoints_inner h hTH hp e
  constructor
  · apply le_antisymm
    · rw [←e.left_base]
      exact le_inf (map_le_range _ _) (by rw [hres]; exact hi.1)
    · exact OriginalExtension.native_le_twoResidual_image e.left e.left_injective Q₀
        (e.left_base.symm.le.trans inf_le_left) hQ₀
  · apply le_antisymm
    · rw [←e.right_base]
      exact le_inf (map_le_range _ _) (by rw [hres]; exact hi.2)
    · exact OriginalExtension.native_le_twoResidual_image e.right e.right_injective Q₁
        (e.right_base.symm.le.trans inf_le_left) hQ₁
end Preparation

namespace OriginalExtension
variable {G X : Type*} [Group G] [Group X] {L R S : Subgroup G}
  {K₀ K₁ Q₀ Q₁ : Subgroup X}
  (e : Marking L R S K₀ K₁ Q₀ Q₁)
  (hi : Function.Injective (MulAut.conj : X →* MulAut X))
  (D₀ D₁ : Subgroup G)
  (h₀ : D₀ ≤ ChapterF.Source.parabolic ![L,R] S 0)
  (h₁ : D₁ ≤ ChapterF.Source.parabolic ![L,R] S 1)
  (he₀ : (e.left.comp (inclusion h₀)).range = Q₀.map MulAut.conj)
  (he₁ : (e.right.comp (inclusion h₁)).range = Q₁.map MulAut.conj)

private def nativeEndpoint {P : Type*} [Group P]
    (f : P →* MulAut X) (hf : Function.Injective f)
    (Q : Subgroup X) (he : f.range = Q.map MulAut.conj) : P ≃* Q :=
  (MonoidHom.ofInjective hf).trans ((MulEquiv.subgroupCongr he).trans
    (Q.equivMapOfInjective MulAut.conj hi).symm)

private theorem nativeEndpoint_apply {P : Type*} [Group P]
    (f : P →* MulAut X) (hf : Function.Injective f)
    (Q : Subgroup X) (he : f.range = Q.map MulAut.conj) (x : P) :
    MulAut.conj (nativeEndpoint hi f hf Q he x).val = f x :=
  congrArg Subtype.val ((Q.equivMapOfInjective MulAut.conj hi).apply_symm_apply _)

include e hi h₁ he₀ he₁ in
private theorem restricted_middle_range :
    (e.left.comp ((inclusion h₀).comp
      (inclusion (inf_le_left : D₀ ⊓ D₁ ≤ D₀)))).range = (Q₀ ⊓ Q₁).map MulAut.conj := by
  rw [map_inf _ _ _ hi,←he₀,←he₁]
  apply le_antisymm
  · rintro _ ⟨x,rfl⟩
    refine ⟨⟨⟨x.val,x.property.1⟩,rfl⟩,⟨⟨x.val,x.property.2⟩,?_⟩⟩
    exact (e.agrees ⟨x.val,h₀ x.property.1,h₁ x.property.2⟩).symm
  · rintro a ⟨⟨x,hx⟩,⟨y,hy⟩⟩
    have ha : a ∈ e.left.range ⊓ e.right.range :=
      ⟨⟨inclusion h₀ x,hx⟩,⟨inclusion h₁ y,hy⟩⟩
    rw [←e.whole_overlap] at ha
    obtain ⟨z,hz⟩ := ha
    have hzx : z.val = x.val := congrArg Subtype.val (e.left_injective (hz.trans hx.symm))
    have hzy : z.val = y.val := congrArg Subtype.val
      (e.right_injective ((e.agrees z).symm.trans (hz.trans hy.symm)))
    exact ⟨⟨z.val,hzx ▸ x.property,hzy ▸ y.property⟩,hz⟩

/-- Restrict the original endpoint markings to two specified subgroups.
The original full-overlap equation supplies the entire restricted middle. -/
def Marking.restrictTo : RankTwoAmalgam.Iso
    (RankTwoAmalgam.ofSubgroups D₀ (D₀ ⊓ D₁) D₁ inf_le_left inf_le_right)
    (RankTwoAmalgam.ofSubgroups Q₀ (Q₀ ⊓ Q₁) Q₁ inf_le_left inf_le_right) := by
  let f₀ := e.left.comp (inclusion h₀)
  let f₁ := e.right.comp (inclusion h₁)
  let fm := f₀.comp (inclusion (inf_le_left : D₀ ⊓ D₁ ≤ D₀))
  have hf₀ : Function.Injective f₀ := e.left_injective.comp (inclusion_injective _)
  have hf₁ : Function.Injective f₁ := e.right_injective.comp (inclusion_injective _)
  have hfm : Function.Injective fm := hf₀.comp (inclusion_injective _)
  have hem : fm.range = (Q₀ ⊓ Q₁).map MulAut.conj :=
    restricted_middle_range e hi D₀ D₁ h₀ h₁ he₀ he₁
  refine { left := nativeEndpoint hi f₀ hf₀ Q₀ he₀
           middle := nativeEndpoint hi fm hfm _ hem
           right := nativeEndpoint hi f₁ hf₁ Q₁ he₁
           left_commutes := ?_
           right_commutes := ?_ }
  · intro x
    apply Subtype.ext
    apply hi
    exact (nativeEndpoint_apply hi f₀ hf₀ _ he₀ _).trans
      (nativeEndpoint_apply hi fm hfm _ hem x).symm
  · intro x
    apply Subtype.ext
    apply hi
    exact (nativeEndpoint_apply hi f₁ hf₁ _ he₁ _).trans
      ((e.agrees ⟨x.val,h₀ x.property.1,h₁ x.property.2⟩).symm.trans
        (nativeEndpoint_apply hi fm hfm _ hem x).symm)

theorem Marking.restrictTo_left_apply (x : D₀) :
    MulAut.conj ((e.restrictTo hi D₀ D₁ h₀ h₁ he₀ he₁).left x).val =
      e.left (inclusion h₀ x) :=
  nativeEndpoint_apply hi _ _ _ _ x

theorem Marking.restrictTo_right_apply (x : D₁) :
    MulAut.conj ((e.restrictTo hi D₀ D₁ h₀ h₁ he₀ he₁).right x).val =
      e.right (inclusion h₁ x) :=
  nativeEndpoint_apply hi _ _ _ _ x

theorem Marking.restrictTo_middle_apply (x : (D₀ ⊓ D₁ : Subgroup G)) :
    MulAut.conj ((e.restrictTo hi D₀ D₁ h₀ h₁ he₀ he₁).middle x).val =
      e.left ⟨x.val,h₀ x.property.1⟩ :=
  nativeEndpoint_apply hi _ _ _ _ x
end OriginalExtension

end CFSG.Quasithin.Chapter6.Source.RankOneGeneric.Global
