variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L B : Subgroup G}
/-- The S3 marking proves solvability of the actual right parabolic,
as required before the source F.1.12 recognition step. -/
theorem natural_cubic_amalgam_right_solvable
    (hF : ChapterF.Source.HypothesisF11 ![L,B] (T : Subgroup G))
    (e : (B ⧸ pCore 2 B) ≃* Equiv.Perm (Fin 3)) :
    Group.IsSolvable (ChapterF.Source.parabolic ![L,B] (T : Subgroup G) 1) := by
  let := SymmetricThreeTwoCore.solvable e
  let := hF.commonBorel_solvable
  rw [ChapterF.Source.parabolic_eq_sup_commonBorel]
  exact Group.isSolvable_sup_of_normalizes B _ (hF.commonBorel_normalizes_local 1)
end CFSG.Quasithin.Chapter6.Source.RankOneRecognition

namespace CFSG.Quasithin.Chapter6.Source.RankOneRecognition
variable {G : Type*} [Group G]
/-- A genuine F.1.1 pair and its faithful local triple inside the original
invariant cover. Recognition of this mixed pair is a further theorem. -/
@[expose] def NaturalEscapingAmalgamData (T : Sylow 2 G) (L R P N M : Subgroup G) : Prop :=
  ∃ B : Subgroup G, B ≤ P ⊔ N.pCoreIn 2 ∧
    B ≤ Escape.I (T : Subgroup G) L R ∧ (¬ B ≤ M) ∧
    Nonempty ((B ⧸ pCore 2 B) ≃* Equiv.Perm (Fin 3)) ∧
    ChapterF.Source.HypothesisF11 ![L,B] (T : Subgroup G) ∧
    Group.IsSolvable (ChapterF.Source.parabolic ![L,B] (T : Subgroup G) 1) ∧
    ChapterF.Source.LocallyRankOneTriple
      (fun i => (ChapterF.Source.parabolic ![L,B] (T : Subgroup G) i).subgroupOf
        (ChapterF.Source.generated ![L,B] (T : Subgroup G)))
      ((ChapterF.Source.commonBorel ![L,B] (T : Subgroup G)).subgroupOf
        (ChapterF.Source.generated ![L,B] (T : Subgroup G)))

variable [Finite G] {T : Sylow 2 G} {L M R : Subgroup G}
/-- The S3 and L3(2) rows supply the actual source amalgam on the same
cover. Only the S5 row remains as an alternative at this stage. -/
private theorem natural_invariant_cover_amalgam_or_five
    {X : Type*} [Group X]
    (h : Hypothesis611 KnownSimple.IsKnownSimple T L M R 2)
    (hnat : IsNaturalModule L (layer L R) 2)
    (P : Subgroup G) (σ : Escape.I (T : Subgroup G) L R →* MulAut X)
    (hPI : P ≤ Escape.I (T : Subgroup G) L R)
    (hmodels : Nonempty ((P ⧸ pCore 2 P) ≃* Equiv.Perm (Fin 3)) ∨
      Nonempty ((P ⧸ pCore 2 P) ≃* BinaryLinear.OuterCyclic.LinearGroup 3) ∨
      Nonempty ((P ⧸ pCore 2 P) ≃* Equiv.Perm (Fin 5)))
    (hcover : NaturalInvariantCoverData T P (Escape.I (T : Subgroup G) L R)
      (Escape.H (T : Subgroup G) L R) σ hPI)
    (hescape : NaturalEscapingCoverData T P (Escape.H (T : Subgroup G) L R) M)
    (hthree : NaturalThreeInvariantParabolicData T L R P (Escape.H (T : Subgroup G) L R) M) :
    Nonempty ((P ⧸ pCore 2 P) ≃* Equiv.Perm (Fin 5)) ∨
      NaturalEscapingAmalgamData T L R P (Escape.H (T : Subgroup G) L R) M := by
  obtain ⟨hKI,hNK,hTK,hcore,⟨eK⟩,_⟩ := hcover
  rcases hmodels with he3 | h3 | h5
  · obtain ⟨e3⟩ := he3
    obtain ⟨c,hcL,hcTL,hcN,hc3,_⟩ := natural_four_exists_cubic h hnat
    let e := eK.trans e3
    have hF := natural_cubic_parabolic_hypothesisF11 h hnat _ hKI hescape.2.1 hTK e
      hcL hcTL hc3 (hNK hcN)
    exact Or.inr ⟨_,le_rfl,hKI,hescape.2.1,⟨e⟩,hF,natural_cubic_amalgam_right_solvable hF e,hF.generatedLocallyRankOneTriple⟩
  · obtain ⟨B,C,dp,hBM,hTB,_,_,_,_,c,hcL,hcTL,hcN,hc3,hcf,hcB,_⟩ := hthree h3
    have hBI := dp.left_lt.le.trans hKI
    have hF := natural_cubic_parabolic_hypothesisF11 h hnat B hBI hBM hTB
      dp.left_quotient.some hcL hcTL hc3 hcB
    exact Or.inr ⟨B,dp.left_lt.le,hBI,hBM,dp.left_quotient,hF,natural_cubic_amalgam_right_solvable hF dp.left_quotient.some,hF.generatedLocallyRankOneTriple⟩
  · exact Or.inl h5
end CFSG.Quasithin.Chapter6.Source.RankOneRecognition



namespace CFSG.Quasithin.Chapter6.Source.RankOneRecognition
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L M R B : Subgroup G}
/-- The source theta has precisely the original groups LT, DT and BDT,
where D is generated by the supplied cubic. In particular the middle
group is the whole overlap, not just the Sylow subgroup. -/
theorem natural_cubic_amalgam_overlap
    (h : Hypothesis611 KnownSimple.IsKnownSimple T L M R 2)
    (hnat : IsNaturalModule L (layer L R) 2)
    (hF : ChapterF.Source.HypothesisF11 ![L,B] (T : Subgroup G))
    (e : (B ⧸ pCore 2 B) ≃* Equiv.Perm (Fin 3))
    {c : G} (hcL : c ∈ L)
    (hcN : c ∈ normalizer (((T : Subgroup G) ⊓ L : Subgroup G) : Set G))
    (hc3 : orderOf c = 3) :
    ChapterF.Source.commonBorel ![L,B] (T : Subgroup G) =
      zpowers c ⊔ (T : Subgroup G) ∧
    ChapterF.Source.parabolic ![L,B] (T : Subgroup G) 1 =
      B ⊔ (zpowers c ⊔ (T : Subgroup G)) ∧
    (L ⊔ (T : Subgroup G)) ⊓ (B ⊔ (zpowers c ⊔ (T : Subgroup G))) =
      zpowers c ⊔ (T : Subgroup G) := by
  obtain ⟨hp,hm,hi⟩ := natural_cubic_amalgam_products hF e
  have hb := four_borel_generated h hnat hcL hcN hc3
  have hmid : ChapterF.Source.borel L (T : Subgroup G) ⊔ (T : Subgroup G) =
      zpowers c ⊔ (T : Subgroup G) := by
    rw [hb]
    exact le_antisymm
      (sup_le (sup_le (inf_le_left.trans le_sup_right) le_sup_left) le_sup_right)
      (sup_le (le_sup_right.trans le_sup_left) le_sup_right)
  have hright : ChapterF.Source.parabolic ![L,B] (T : Subgroup G) 1 =
      B ⊔ (zpowers c ⊔ (T : Subgroup G)) := by
    change B ⊔ (T : Subgroup G) ⊔ ChapterF.Source.borel L (T : Subgroup G) = _
    rw [sup_assoc,sup_comm (T : Subgroup G),hmid]
  refine ⟨hm.trans hmid,hright,?_⟩
  rw [←hright,←hp,ChapterF.Source.lemma_F_1_3_6 hF,hm,hmid]
end CFSG.Quasithin.Chapter6.Source.RankOneRecognition

namespace CFSG.Quasithin.Chapter6.Source.RankOneRecognition
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L M R : Subgroup G}

/-- If the canonical S5 parabolic is contained in M, its original Sylow
extension is an H-star member. The source numerical assumption therefore
applies to this extension itself. -/
theorem natural_five_contained_overgroup
    (h : Hypothesis611 KnownSimple.IsKnownSimple T L M R 2)
    (K B : Subgroup G) (hKN : K ≤ Escape.H (T : Subgroup G) L R)
    (hTK : (T : Subgroup G) ≤ normalizer (K : Set G))
    (hKM : ¬ K ≤ M) (hBK : B < K) (hBM : B ≤ M)
    (hmax : ∀ C : Subgroup G, (T : Subgroup G) ⊓ K ≤ C → C < K → C ≤ B) :
    B = M ⊓ K ∧ (K ⊔ (T : Subgroup G)) ∈ Chapter3.HStar (T : Subgroup G) M ∧
      ChapterE.generationParameter (K ⊔ (T : Subgroup G) : Subgroup G) = 1 := by
  have hMK : M ⊓ K < K := lt_of_le_of_ne inf_le_right (fun he =>
    hKM (he.symm.le.trans inf_le_left))
  have hBeq : B = M ⊓ K := le_antisymm (le_inf hBM hBK.le)
    (hmax _ (inf_le_inf_right _ h.sylow_le) hMK)
  have hN : Escape.H (T : Subgroup G) L R ∈ Chapter1.HOver G (T : Set G) :=
    ⟨Chapter1.mem_H_of_isTwoLocal ⟨ZS (T : Subgroup G) L R,h.ZS_ne_bot,
      T.isPGroup'.to_le h.ZS_le_T,rfl⟩,h.sylow_normalizes_ZS⟩
  have hstar : (K ⊔ (T : Subgroup G)) ∈ Chapter3.HStar (T : Subgroup G) M := by
    refine ⟨⟨Chapter3.mem_HOver_of_sylow_interval T le_sup_right
      (sup_le hKN h.sylow_normalizes_ZS) hN,fun hh => hKM (le_sup_left.trans hh)⟩,?_⟩
    intro X hX hXH
    by_cases hKX : K ≤ X
    · exact sup_le hKX hX.1.2
    · apply False.elim
      apply hX.2
      have hXK : X ⊓ K < K := lt_of_le_of_ne inf_le_right
        (fun he => hKX (he.symm.le.trans inf_le_left))
      have hle : X ⊓ K ≤ B := hmax _ (inf_le_inf_right _ hX.1.2) hXK
      intro x hx
      have hp : x ∈ (K : Set G) * ((T : Subgroup G) : Set G) := by
        rw [←coe_mul_of_right_le_normalizer_left _ _ hTK]
        exact hXH hx
      obtain ⟨k,hk,t,ht,rfl⟩ := hp
      have hkX : k ∈ X := (X.mul_mem_cancel_right (hX.1.2 ht)).mp hx
      exact M.mul_mem (hBM (hle ⟨hkX,hk⟩)) (h.sylow_le ht)
  exact ⟨hBeq,hstar,h.generation_one _ hstar⟩

/-- The remaining S5 obstruction is located on the original cover and
H-star extension. Its generation parameter is genuinely one there. -/
@[expose] def NaturalFiveContainedParabolicData (T : Sylow 2 G) (P N M : Subgroup G) : Prop :=
  Nonempty ((P ⧸ pCore 2 P) ≃* Equiv.Perm (Fin 5)) ∧
    let K := P ⊔ N.pCoreIn 2
    ∃ B : Subgroup G, B < K ∧ B = M ⊓ K ∧
      (T : Subgroup G) ⊓ K ≤ B ∧
      Nonempty ((B ⧸ pCore 2 B) ≃* Equiv.Perm (Fin 3)) ∧
      (T : Subgroup G).relIndex (B ⊔ (T : Subgroup G)) = 3 ∧
      (K ⊔ (T : Subgroup G)) ∈ Chapter3.HStar (T : Subgroup G) M ∧
      ChapterE.generationParameter (K ⊔ (T : Subgroup G) : Subgroup G) = 1

/-- All three factor rows are reduced to a genuine escaping source amalgam
or the literal contained S5 obstruction. No numerical conclusion is drawn
from a quotient isomorphism alone. -/
theorem natural_invariant_cover_amalgam_or_contained_five
    {X : Type*} [Group X]
    (h : Hypothesis611 KnownSimple.IsKnownSimple T L M R 2)
    (hnat : IsNaturalModule L (layer L R) 2)
    (P : Subgroup G) (σ : Escape.I (T : Subgroup G) L R →* MulAut X)
    (hPI : P ≤ Escape.I (T : Subgroup G) L R)
    (hmodels : Nonempty ((P ⧸ pCore 2 P) ≃* Equiv.Perm (Fin 3)) ∨
      Nonempty ((P ⧸ pCore 2 P) ≃* BinaryLinear.OuterCyclic.LinearGroup 3) ∨
      Nonempty ((P ⧸ pCore 2 P) ≃* Equiv.Perm (Fin 5)))
    (hcover : NaturalInvariantCoverData T P (Escape.I (T : Subgroup G) L R)
      (Escape.H (T : Subgroup G) L R) σ hPI)
    (hescape : NaturalEscapingCoverData T P (Escape.H (T : Subgroup G) L R) M)
    (hthree : NaturalThreeInvariantParabolicData T L R P (Escape.H (T : Subgroup G) L R) M)
    (hfive : NaturalFiveCubicParabolicData T L R P (Escape.H (T : Subgroup G) L R)) :
    NaturalEscapingAmalgamData T L R P (Escape.H (T : Subgroup G) L R) M ∨
      NaturalFiveContainedParabolicData T P (Escape.H (T : Subgroup G) L R) M := by
  rcases natural_invariant_cover_amalgam_or_five h hnat P σ hPI hmodels hcover hescape hthree with h5 | ham
  · obtain ⟨B,hBK,hSB,_,hTB,⟨c,hcL,hcTL,hcN,hc3,hcf,hcB⟩,eB,hmax,eBT,hi⟩ := hfive h5
    obtain ⟨hKI,hNK,hTK,_⟩ := hcover
    by_cases hBM : B ≤ M
    · obtain ⟨he,hstar,hgen⟩ := natural_five_contained_overgroup h _ B
        (hKI.trans (Subgroup.centralizer_le_normalizer _)) hTK hescape.2.1 hBK hBM hmax
      exact Or.inr ⟨h5,B,hBK,he,hSB,eB,hi,hstar,hgen⟩
    · have hBI := hBK.le.trans hKI
      have hF := natural_cubic_parabolic_hypothesisF11 h hnat B hBI hBM
        (le_sup_left.trans hTB) eB.some hcL hcTL hc3 hcB
      exact Or.inl ⟨B,hBK.le,hBI,hBM,eB,hF,natural_cubic_amalgam_right_solvable hF eB.some,hF.generatedLocallyRankOneTriple⟩
  · exact Or.inl ham
end CFSG.Quasithin.Chapter6.Source.RankOneRecognition

namespace CFSG.Quasithin.Chapter6.Source.RankOneRecognition.NaturalEscapeGraph.OddConfiguration
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L M R : Subgroup G} {n : ℕ}
variable (d : NaturalEscapeGraph.OddConfiguration T L M R)
include d
/-- On the same original W/Z_S witness, either an escaping subgroup
in the invariant cover supplies the genuine F.1.1 pair and faithful local
triple, or the canonical S5 parabolic is contained in M and its actual
Sylow extension is an H-star member of generation parameter one. -/
theorem exists_ambient_amalgam_or_contained_five
    (h : Hypothesis611 KnownSimple.IsKnownSimple T L M R n)
    (hnat : IsNaturalModule L (layer L R) n)
    (hE : ChapterE.Section06.HypothesisE61 KnownSimple.IsKnownSimple T M (layer L R))
    (hs : letI := h.layer_elementary; ChapterE.globalS (layer L R) = n)
    (hNS : Subgroup.normalizer (((T : Subgroup G) ⊓
      centralizer (ZS (T : Subgroup G) L R : Set G) : Subgroup G) : Set G) ≤ M)
    (hab : Escape.U (T : Subgroup G) L R ≤
      centralizer (Escape.U (T : Subgroup G) L R : Set G)) :
    n = 2 ∧ ∃ z a : G,
      z ∈ ZS (T : Subgroup G) L R ∧ orderOf z = 2 ∧
      let I := Escape.I (T : Subgroup G) L R
      let N := Escape.H (T : Subgroup G) L R
      let Z := ZS (T : Subgroup G) L R
      let W := Escape.U (T : Subgroup G) L R ⊓
        conjugateSpanBy Z (centralizer ({z} : Set G))
      let E := (layer L R).map (MulAut.conj a).toMonoidHom
      let P := conjugateSpanBy E I
      E ≤ I ∧ Z ≤ W ∧
      ∃ (hPI : P ≤ I) (hPN : P ≤ N) (_hIN : I ≤ N)
        (hIW : I ≤ Subgroup.normalizer (W : Set G))
        (hZ : (Z.subgroupOf W).Normal),
      let := hZ
      ∃ σ : I →* MulAut (W ⧸ Z.subgroupOf W),
        (∀ i : I, ∀ w : W,
          σ i (QuotientGroup.mk' (Z.subgroupOf W) w) =
            QuotientGroup.mk' (Z.subgroupOf W)
              ⟨(i : G) * (w : G) * (i : G)⁻¹,
                (mem_normalizer_iff.mp (hIW i.property) w).mp w.property⟩) ∧
      ∃ hX : IsElementaryAbelian 2 (W ⧸ Z.subgroupOf W),
        let := hX
        IsElementaryAbelian 2 ((E.subgroupOf I).map σ) ∧
        1 < Nat.card ((E.subgroupOf I).map σ) ∧
        Nat.card ((E.subgroupOf I).map σ) ≤ 4 ∧
        let g := σ.comp (inclusion hPI)
        ∃ (φ : (P ⧸ pCore 2 P) →* g.range)
          (j : (P ⧸ pCore 2 P) →* (N ⧸ pCore 2 N)),
          Function.Bijective φ ∧ φ.ker ≤ center (P ⧸ pCore 2 P) ∧
          Function.Injective j ∧ j.range.IsSubnormal ∧
          (∀ p, φ (QuotientGroup.mk' (pCore 2 P) p) = g.rangeRestrict p) ∧
          (∀ p, j (QuotientGroup.mk' (pCore 2 P) p) =
            QuotientGroup.mk' (pCore 2 N) (inclusion hPN p)) ∧
          pCore 2 g.range = ⊥ ∧ g.ker = pCore 2 P ∧
            (Nonempty ((P ⧸ pCore 2 P) ≃* Equiv.Perm (Fin 3)) ∨
              Nonempty ((P ⧸ pCore 2 P) ≃* BinaryLinear.OuterCyclic.LinearGroup 3) ∨
              Nonempty ((P ⧸ pCore 2 P) ≃* Equiv.Perm (Fin 5))) ∧
            ((pResidual 2 P).map P.subtype = (primeToResidual 3 I).map I.subtype) ∧
            (N ≤ Subgroup.normalizer ((pResidual 2 P).map P.subtype : Set G)) ∧
            NaturalInvariantCoverData T P I N σ hPI ∧
            NaturalEscapingCoverData T P N M ∧
            NaturalFiveCubicParabolicData T L R P N ∧
            NaturalThreeInvariantParabolicData T L R P N M ∧
            (NaturalEscapingAmalgamData T L R P N M ∨
              NaturalFiveContainedParabolicData T P N M) := by
  obtain ⟨hn,z,a,hz,ho,hEI,hZW,hPI,hPN,hIN,hIW,hZ,σ,hσ,hX,hEA,hpos,hupper,
      φ,j,hφ,hφc,hj,hjn,hφe,hje,hred,hk,hmodels,hcanonical,hnormal,hcover,hescape,hfive,hthree⟩ :=
    d.exists_ambient_three_invariant_parabolic h hnat hE hs hNS hab
  let := hZ
  let := hX
  exact ⟨hn,z,a,hz,ho,hEI,hZW,hPI,hPN,hIN,hIW,hZ,σ,hσ,hX,hEA,hpos,hupper,
    φ,j,hφ,hφc,hj,hjn,hφe,hje,hred,hk,hmodels,hcanonical,hnormal,hcover,hescape,hfive,hthree,
    natural_invariant_cover_amalgam_or_contained_five (hn ▸ h) (hn ▸ hnat) _ σ hPI
      hmodels hcover hescape hthree hfive⟩
end CFSG.Quasithin.Chapter6.Source.RankOneRecognition.NaturalEscapeGraph.OddConfiguration
