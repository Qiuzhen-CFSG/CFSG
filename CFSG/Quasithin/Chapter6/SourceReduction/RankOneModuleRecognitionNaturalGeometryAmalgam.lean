public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleRecognitionNaturalGeometryThreeAction
public import CFSG.Quasithin.ChapterF.Section01.SourceFaithfulTriple
public import Theory.SpecificGroups.BinaryLinear.SmallParabolicLevi.Models
/-!
# The original escaping factors and their source amalgam

An escaping subgroup B in the original invariant cover has S3 two-core
quotient and is normalized by T and the original cubic in L. The cubic
together with T intersect L generates the full left Borel. The right
Borel is T intersect B, proving both cross-normalization clauses of
F.1.1. Uniqueness of the maximal two-local overgroup of LT kills the
generated two-core; both actual parabolics have characteristic two.
The S3 quotient also proves that the right parabolic is solvable.

The literal parabolics have whole overlap D T, where D is generated by
the original cubic. The genuine F.1.1 theory supplies their faithful
locally rank-one triple inside the generated group. This construction
applies to the saved S3 and L3(2) rows on the same W/Z_S witness.

For S5, either its canonical parabolic escapes and the same construction
applies, or B = M intersect K and K T is an actual H-star member with
generation parameter one. No lower bound for that parameter is inferred
from the S5 quotient alone. Excluding this contained case and proving the
mixed-amalgam recognition contradiction remain with
qt-d-1222-rankone-recognition-natural, together with initial 6.1.4–5,
omega escape and the remaining geometry through unconditional 6.1.27.

Source: Aschbacher–Smith 6.1.19, printed p.675, and F.1.1–9,
printed pp.259–262 (`refs/quasithin.pdf`).
-/

public noncomputable section
set_option backward.isDefEq.respectTransparency false
open Subgroup Theory.GroupTheory
open scoped MatrixGroups Pointwise
namespace CFSG.Quasithin.Chapter6.Source.RankOneRecognition
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L M R : Subgroup G}

private theorem four_borel_generated
    (h : Hypothesis611 KnownSimple.IsKnownSimple T L M R 2)
    (hnat : IsNaturalModule L (layer L R) 2)
    {c : G} (hcL : c ∈ L)
    (hcN : c ∈ normalizer (((T : Subgroup G) ⊓ L : Subgroup G) : Set G))
    (hc3 : orderOf c = 3) :
    ChapterF.Source.borel L (T : Subgroup G) = ((T : Subgroup G) ⊓ L) ⊔ zpowers c := by
  obtain ⟨F,_,_,_,hF,e,f,hf⟩ := hnat
  obtain ⟨P,hP⟩ := NormalSylowQuotientAction.intersection_sylow T L h.sylow_normalizes_L
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))
  have hq : Function.Surjective q := e.surjective.comp (QuotientGroup.mk'_surjective _)
  let Q := P.mapSurjective hq
  have hQ : Nat.card Q = 4 := by
    rw [Q.card_eq_multiplicity,GorensteinWalter.sl2_card_formula,hF]
    decide +kernel
  have hN : Nat.card (normalizer (Q : Set SL(2,F))) = 12 := by
    simpa [hF] using Matrix.SpecialLinearGroup.card_sylow_normalizer_even Q
  have hiQ : (Q : Subgroup SL(2,F)).relIndex (normalizer (Q : Set SL(2,F))) = 3 := by
    have hh := relIndex_mul_relIndex (⊥ : Subgroup SL(2,F)) (Q : Subgroup SL(2,F))
      (normalizer (Q : Set SL(2,F))) bot_le (Q : Subgroup SL(2,F)).le_normalizer
    rw [relIndex_bot_left,relIndex_bot_left,hQ,hN] at hh
    omega
  have hk : q.ker ≤ (P : Subgroup L) := by
    rw [MonoidHom.ker_comp_of_injective _ _ e.injective,QuotientGroup.ker_mk']
    exact pCore_isPGroup.le_sylow_of_normal P
  have hi : (P : Subgroup L).relIndex (normalizer ((P : Subgroup L) : Set L)) = 3 := by
    have hh := relIndex_map_map q (P : Subgroup L) (normalizer ((P : Subgroup L) : Set L))
    rw [sup_eq_left.mpr hk,sup_eq_left.mpr (hk.trans (P : Subgroup L).le_normalizer),
      show (normalizer ((P : Subgroup L) : Set L)).map q =
        normalizer (Q : Set SL(2,F)) from P.normalizer_map_surjective q hq] at hh
    exact hh.symm.trans hiQ
  let c' : L := ⟨c,hcL⟩
  have hc' : c' ∈ normalizer ((P : Subgroup L) : Set L) := by
    rw [hP]
    apply mem_normalizer_iff.mpr
    intro x
    change ((x : G) ∈ (T : Subgroup G)) ↔ c * (x : G) * c⁻¹ ∈ (T : Subgroup G)
    have hh := mem_normalizer_iff.mp hcN (x : G)
    exact ⟨fun hx => ((hh.mp ⟨hx,x.property⟩).1),
      fun hx => (hh.mpr ⟨hx,L.mul_mem (L.mul_mem hcL x.property) (L.inv_mem hcL)⟩).1⟩
  let J : Subgroup L := (P : Subgroup L) ⊔ zpowers c'
  have hJN : J ≤ normalizer ((P : Subgroup L) : Set L) :=
    sup_le (P : Subgroup L).le_normalizer (zpowers_le.mpr hc')
  have hcnot : c' ∉ P := by
    intro hcP
    obtain ⟨k,hk⟩ := P.isPGroup'.exists_orderOf_dvd_pow ⟨c',hcP⟩
    change orderOf (⟨c',hcP⟩ : (P : Subgroup L)) ∣ 2 ^ k at hk
    have hh : 3 ∣ 2 ^ k := by
      simpa only [Subgroup.orderOf_mk, c', hc3] using hk
    exact (by decide : ¬ 3 ∣ 2) (Nat.prime_three.dvd_of_dvd_pow hh)
  have hd : (P : Subgroup L).relIndex J ∣ 3 :=
    hi ▸ dvd_of_mul_right_eq _ (relIndex_mul_relIndex (P : Subgroup L) J _ le_sup_left hJN)
  have hiJ : (P : Subgroup L).relIndex J = 3 :=
    ((Nat.dvd_prime Nat.prime_three).mp hd).resolve_left (fun h1 =>
      hcnot (relIndex_eq_one.mp h1 (mem_sup_right (mem_zpowers c'))))
  have hNJ : normalizer ((P : Subgroup L) : Set L) ≤ J := by
    have hh := relIndex_mul_relIndex (P : Subgroup L) J (normalizer ((P : Subgroup L) : Set L))
      le_sup_left hJN
    rw [hi,hiJ] at hh
    exact relIndex_eq_one.mp (by omega)
  have hmap : (normalizer ((P : Subgroup L) : Set L)).map L.subtype = ChapterF.Source.borel L (T : Subgroup G) := by
    rw [hP]
    have he : normalizer ((T : Subgroup G).subgroupOf L : Set L) =
        (normalizer (((T : Subgroup G) ⊓ L : Subgroup G) : Set G)).subgroupOf L := by
      rw [subgroupOf_normalizer_eq inf_le_right]
      congr 1
      ext x
      simp
    rw [he,subgroupOf_map_subtype,inf_comm]
    rfl
  rw [←hmap,←le_antisymm hJN hNJ,Subgroup.map_sup,hP,subgroupOf_map_subtype,MonoidHom.map_zpowers]
  rfl

private theorem three_borel_eq
    (B : Subgroup G) (hTB : (T : Subgroup G) ≤ normalizer (B : Set G))
    (e : (B ⧸ pCore 2 B) ≃* Equiv.Perm (Fin 3)) :
    ChapterF.Source.borel B (T : Subgroup G) = (T : Subgroup G) ⊓ B := by
  obtain ⟨P,hP⟩ := NormalSylowQuotientAction.intersection_sylow T B hTB
  have he := SymmetricThreeTwoCore.sylow_self_normalizing e P
  have he' : normalizer ((P : Subgroup B) : Set B) =
      (normalizer (((T : Subgroup G) ⊓ B : Subgroup G) : Set G)).subgroupOf B := by
    rw [hP,subgroupOf_normalizer_eq inf_le_right]
    congr 1
    ext x
    simp
  change normalizer ((P : Subgroup B) : Set B) = (P : Subgroup B) at he
  have hh := congrArg (map B.subtype) he
  rw [he',hP,subgroupOf_map_subtype,subgroupOf_map_subtype] at hh
  exact (inf_comm _ _).trans hh

omit [Finite G] in
private theorem three_rank_one (B : Subgroup G)
    (e : (B ⧸ pCore 2 B) ≃* Equiv.Perm (Fin 3)) :
    ChapterF.Source.IsRankOneModel (B ⧸ pCore 2 B) := by
  let f : SL(2,ZMod 2) ≃* Equiv.Perm (Fin 3) :=
    (BinaryLinear.OuterCyclic.slEquivLinear 2).trans
      BinaryLinear.SmallParabolicLevi.linearTwoEquivSymmetricThree
  exact .linear 1 (by decide) ⟨ZMod 2,inferInstance,inferInstance,by simp,
    ⟨(e.trans f.symm).trans Atlas.RankOneFieldAutomorphisms.slEquivPSL⟩⟩
end CFSG.Quasithin.Chapter6.Source.RankOneRecognition

namespace CFSG.Quasithin.Chapter6.Source.RankOneRecognition
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L M R : Subgroup G}

private theorem natural_unique_overgroup
    (h : Hypothesis611 KnownSimple.IsKnownSimple T L M R 2) :
    ∀ N : Subgroup G, IsMaximalTwoLocal N → L ⊔ (T : Subgroup G) ≤ N → N = M := by
  have hstar : L ∈ Chapter1.LStar G (T : Subgroup G) := by
    refine ⟨h.local_mem.1.prop, ?_⟩
    intro J hJ hLJ
    exact le_antisymm (h.local_mem.1.2 hJ hLJ) hLJ
  have hu := Chapter1.Section02.nonsolvable_uniqueness_knownSimple h.simpleQTKE T hstar
  have horbit : componentOrbit L (T : Subgroup G) = L :=
    le_antisymm (iSup_conjugates_le_of_le_normalizer L T L le_rfl h.sylow_normalizes_L)
      (le_componentOrbit L T)
  intro N hN hLN
  have h1 := hu.normalizer_unique N hN
  have h2 := hu.normalizer_unique M h.maximal
  rw [horbit] at h1 h2
  exact (h1 hLN).trans (h2 (sup_le h.L_le h.sylow_le)).symm

/-- An original escaping S3 parabolic, invariant under T and the original
cubic, satisfies all six source F.1.1 clauses together with L. -/
theorem natural_cubic_parabolic_hypothesisF11
    (h : Hypothesis611 KnownSimple.IsKnownSimple T L M R 2)
    (hnat : IsNaturalModule L (layer L R) 2)
    (B : Subgroup G) (hBI : B ≤ Escape.I (T : Subgroup G) L R)
    (hBM : ¬ B ≤ M) (hTB : (T : Subgroup G) ≤ normalizer (B : Set G))
    (e : (B ⧸ pCore 2 B) ≃* Equiv.Perm (Fin 3))
    {c : G} (hcL : c ∈ L)
    (hcN : c ∈ normalizer (((T : Subgroup G) ⊓ L : Subgroup G) : Set G))
    (hc3 : orderOf c = 3) (hcB : c ∈ normalizer (B : Set G)) :
    ChapterF.Source.HypothesisF11 ![L,B] (T : Subgroup G) := by
  have hleft : ChapterF.Source.borel L (T : Subgroup G) ≤ normalizer (B : Set G) := by
    rw [four_borel_generated h hnat hcL hcN hc3]
    exact sup_le (inf_le_left.trans hTB) (zpowers_le.mpr hcB)
  have hright := three_borel_eq B hTB e
  have hline : ChapterF.Source.borel L (T : Subgroup G) ≤ Escape.H (T : Subgroup G) L R := by
    intro x hx
    exact inf_normalizer_le_normalizer_inf
      ⟨normalizer_commutator_ge_right R L hx.1,
        normalizer_le_normalizer_centralizer _ hx.2⟩
  have hpzero : ChapterF.Source.parabolic ![L,B] (T : Subgroup G) 0 = L ⊔ (T : Subgroup G) := by
    change L ⊔ (T : Subgroup G) ⊔ ChapterF.Source.borel B (T : Subgroup G) = _
    rw [hright,sup_eq_left.mpr (inf_le_left.trans le_sup_right)]
  have hN : Escape.H (T : Subgroup G) L R ∈ Chapter1.HOver G (T : Set G) :=
    ⟨Chapter1.mem_H_of_isTwoLocal ⟨ZS (T : Subgroup G) L R,h.ZS_ne_bot,
      T.isPGroup'.to_le h.ZS_le_T,rfl⟩,h.sylow_normalizes_ZS⟩
  have hone : ChapterF.Source.parabolic ![L,B] (T : Subgroup G) 1 ∈
      Chapter1.HOver G (T : Set G) := by
    apply Chapter3.mem_HOver_of_sylow_interval T (le_sup_right.trans le_sup_left) _ hN
    exact sup_le (sup_le (hBI.trans (Subgroup.centralizer_le_normalizer _))
      h.sylow_normalizes_ZS) hline
  refine ⟨inferInstance,T.isPGroup',?_,?_,?_,?_,?_,?_⟩
  · intro i
    fin_cases i
    · exact h.sylow_normalizes_L
    · exact hTB
  · intro i
    fin_cases i
    · change ∃ P : Sylow 2 L, (P : Subgroup L).map L.subtype = (T : Subgroup G) ⊓ L
      obtain ⟨P,hP⟩ := NormalSylowQuotientAction.intersection_sylow T L h.sylow_normalizes_L
      exact ⟨P,by rw [hP,subgroupOf_map_subtype]⟩
    · change ∃ P : Sylow 2 B, (P : Subgroup B).map B.subtype = (T : Subgroup G) ⊓ B
      obtain ⟨P,hP⟩ := NormalSylowQuotientAction.intersection_sylow T B hTB
      exact ⟨P,by rw [hP,subgroupOf_map_subtype]⟩
  · intro i
    fin_cases i
    · exact .linear 2 (by decide) h.quotient_model
    · exact three_rank_one B e
  · intro i
    fin_cases i
    · change ChapterF.Source.borel B (T : Subgroup G) ≤ normalizer (L : Set G)
      rw [hright]
      exact inf_le_left.trans h.sylow_normalizes_L
    · exact hleft
  · have he : ChapterF.Source.generated ![L,B] (T : Subgroup G) =
        (L ⊔ (T : Subgroup G)) ⊔ B := by
      change L ⊔ B ⊔ (T : Subgroup G) = _
      ac_rfl
    rw [he]
    exact twoCore_sup_eq_bot_of_unique_maximalTwoLocal_overgroup _ B M
      (natural_unique_overgroup h) hBM
  · intro i
    apply generalizedFitting_eq_pCore_of_selfCentralizing 2
    apply Chapter1.mem_He_iff.mp
    apply Chapter1.lemma_1_1_4_6 T (h.simpleQTKE.evenCharacteristic T)
    fin_cases i
    · change ChapterF.Source.parabolic ![L,B] (T : Subgroup G) 0 ∈ _
      rw [hpzero]
      exact ⟨h.local_mem.1.prop.2.2,fun _ ht => mem_sup_right ht⟩
    · exact hone

/-- The whole overlap and both parabolics are the literal source products;
the overlap retains the odd cubic in the left Borel. -/
theorem natural_cubic_amalgam_products
    {B : Subgroup G} (h : ChapterF.Source.HypothesisF11 ![L,B] (T : Subgroup G))
    (e : (B ⧸ pCore 2 B) ≃* Equiv.Perm (Fin 3)) :
    ChapterF.Source.parabolic ![L,B] (T : Subgroup G) 0 = L ⊔ (T : Subgroup G) ∧
    ChapterF.Source.commonBorel ![L,B] (T : Subgroup G) =
      ChapterF.Source.borel L (T : Subgroup G) ⊔ (T : Subgroup G) ∧
    (L ⊔ (T : Subgroup G)) ⊓
      (B ⊔ (T : Subgroup G) ⊔ ChapterF.Source.borel L (T : Subgroup G)) =
      ChapterF.Source.borel L (T : Subgroup G) ⊔ (T : Subgroup G) := by
  have he := three_borel_eq B (h.S_normalizes 1) e
  have hp : ChapterF.Source.parabolic ![L,B] (T : Subgroup G) 0 = L ⊔ (T : Subgroup G) := by
    change L ⊔ (T : Subgroup G) ⊔ ChapterF.Source.borel B (T : Subgroup G) = _
    rw [he,sup_eq_left.mpr (inf_le_left.trans le_sup_right)]
  have hb : ChapterF.Source.commonBorel ![L,B] (T : Subgroup G) =
      ChapterF.Source.borel L (T : Subgroup G) ⊔ (T : Subgroup G) := by
    change ChapterF.Source.borel L (T : Subgroup G) ⊔ ChapterF.Source.borel B (T : Subgroup G) ⊔ _ = _
    rw [he,sup_assoc,show (T : Subgroup G) ⊓ B ⊔ (T : Subgroup G) = (T : Subgroup G) from sup_eq_right.mpr inf_le_left]
  refine ⟨hp,hb,?_⟩
  have hh := ChapterF.Source.lemma_F_1_3_6 h
  rw [hp,hb] at hh
  exact hh

end CFSG.Quasithin.Chapter6.Source.RankOneRecognition

