module

public import CFSG.Quasithin.Chapter11.Section01To02.SourceDefs
public import Theory.GroupTheory.CComponent.UniqueNoncentral

/-!
# Elementary steps towards the Chapter 11 normalizer arguments

Relative normality supplies normalizer inclusions. The weak-closure subgroup
is generated by the actual conjugates lying in T. The final step combines the
non-normalization conclusion of 11.2.4(2) with the critical pair supplied by
F.7.11(2): a commutator contained in both groups forces mutual normalization.

The last theorem is only this assembly implication. Establishing its inputs
from the Chapter 11 setup, and thus proving 11.2.5, remains necessary.
Source: Aschbacher–Smith, combined manuscript, §§11.1–11.2, pp.760–770.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter11.Source
open Subgroup
variable {G : Type*} [Group G]

/-- Relative component normality gives exactly an H-normalizer inclusion. -/
theorem NormalComponentIn.le_normalizer {H K : Subgroup G}
    (h : NormalComponentIn H K) : H ≤ NG K :=
  (normal_subgroupOf_iff_le_normalizer h.1.1).mp h.2

/-- Every conjugate used in the span is contained in it. -/
theorem conjugate_le_span {H V : Subgroup G} {g : G} (hg : g ∈ H) :
    V.map (MulAut.conj g).toMonoidHom ≤ conjugateSpan H V :=
  le_iSup (fun h : H => V.map (MulAut.conj (h : G)).toMonoidHom) ⟨g, hg⟩

/-- The original subgroup occurs as the conjugate by the identity. -/
theorem le_conjugateSpan (H V : Subgroup G) : V ≤ conjugateSpan H V := by
  intro x hx
  apply conjugate_le_span (V := V) H.one_mem
  exact ⟨x, hx, by simp⟩

/-- A noncommuting conjugate within the indexing subgroup makes the span nonabelian. -/
theorem not_isMulCommutative_span_of_conjugate {H V : Subgroup G} {g : G}
    (hg : g ∈ H) (hne : ⁅V, V.map (MulAut.conj g).toMonoidHom⁆ ≠ ⊥) :
    ¬ IsMulCommutative (conjugateSpan H V) := by
  intro habelian
  apply hne
  apply le_bot_iff.mp
  exact (commutator_mono (le_conjugateSpan H V) (conjugate_le_span hg)).trans
    (le_of_eq (commutator_self_eq_bot_iff.mpr habelian))

/-- W₀(T,V) is a subgroup of T by its definition, without any recognition input. -/
theorem weakClosureZero_le (T V : Subgroup G) : weakClosureZero T V ≤ T := by
  apply sSup_le
  rintro A ⟨g, rfl, h⟩
  exact h

/-- Every conjugate of V contained in T contributes to W₀(T,V). -/
theorem conjugate_le_weakClosureZero {T V : Subgroup G} {g : G}
    (hg : V.map (MulAut.conj g).toMonoidHom ≤ T) :
    V.map (MulAut.conj g).toMonoidHom ≤ weakClosureZero T V :=
  le_sSup ⟨g, rfl, hg⟩

/-- A critical pair with commutator in its intersection mutually normalizes. -/
theorem mutual_normalization_of_commutator_le_inf {A B : Subgroup G}
    (h : ⁅A, B⁆ ≤ A ⊓ B) : A ≤ NG B ∧ B ≤ NG A := by
  exact ⟨le_normalizer_iff_commutator_le_right.mpr (h.trans inf_le_right),
    le_normalizer_iff_commutator_le_left.mpr (h.trans inf_le_left)⟩

/-- The last inference in 11.2.5, with the still-needed outputs of 11.2.4(2)
and F.7.11(2) explicit. This is not the source theorem from its original setup. -/
theorem nonabelian_span_of_critical_pair {T V V₁ : Subgroup G}
    (hrestriction : IsMulCommutative (conjugateSpan (NG V₁) V) →
      ∀ g : G, V.map (MulAut.conj g).toMonoidHom ≤ T →
        ⁅V, V.map (MulAut.conj g).toMonoidHom⁆ ≠ ⊥ →
          ¬ V ≤ NG (V.map (MulAut.conj g).toMonoidHom))
    (hpair : ∃ g : G, V.map (MulAut.conj g).toMonoidHom ≤ T ∧
      ⁅V, V.map (MulAut.conj g).toMonoidHom⁆ ≠ ⊥ ∧
      ⁅V, V.map (MulAut.conj g).toMonoidHom⁆ ≤ V ⊓ V.map (MulAut.conj g).toMonoidHom) :
    ¬ IsMulCommutative (conjugateSpan (NG V₁) V) := by
  intro habelian
  obtain ⟨g, hg, hne, hcomm⟩ := hpair
  exact hrestriction habelian g hg hne
    (mutual_normalization_of_commutator_le_inf hcomm).1

end CFSG.Quasithin.Chapter11.Source
