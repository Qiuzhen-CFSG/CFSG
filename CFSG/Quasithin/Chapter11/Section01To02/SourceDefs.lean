module

public import CFSG.Quasithin.Chapter11.Defs
public import Theory.GroupTheory.CComponent.Basic
public import CFSG.Quasithin.ChapterC.Section01.BlockTypes.Basic
public import Theory.GroupTheory.PGroup.OmegaAmbient
public import Theory.GroupTheory.PCoreLocalSetup

/-!
# Group-dependent definitions for §§11.1–11.2

These definitions specify actual subgroups, quotient isomorphisms and module
blocks. They are not hypotheses asserting that the source conclusions hold.
`ClassicalComponentCase` and `ClassicalRefinementCase` are explicitly partial
lists: the exceptional Lie groups, sporadic groups, covering groups and
extension cases still belong to the A.3.12–14 recognition interface. The source's
notation `SL₂(5)/P₀` describes an extension, not division by a subgroup of SL₂(5).

`NormalizerControl`, `RadicalNormalizerAlternative`, `UniqueNoncentralComponent`
and `WeakClosureObstruction` specify the corresponding outputs. No theorem in
this module claims to establish them from the Chapter 11 setup.

Source: Aschbacher–Smith, combined manuscript, 1 March 2004,
§§11.1–11.2, printed pp.760–770, particularly 11.1.1–5 and 11.2.5.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter11.Source

open Subgroup

variable {G : Type*} [Group G]

/-- A C-component of `H`, represented in the common ambient group. -/
def ComponentIn (H K : Subgroup G) : Prop :=
  K ≤ H ∧ (K.subgroupOf H).IsCComponent

/-- The relative normality required by 11.1.1, not normality in `G`. -/
def NormalComponentIn (H K : Subgroup G) : Prop :=
  ComponentIn H K ∧ (K.subgroupOf H).Normal

/-- The predicate singled out in 11.1.3: components which do NOT centralize V. -/
def NoncentralComponent (H V K : Subgroup G) : Prop :=
  ComponentIn H K ∧ ¬ K ≤ centralizer (V : Set G)

/-- The exact uniqueness output of 11.1.3 when `H = NG V₂` and `L = L₂`. -/
def UniqueNoncentralComponent (H V L : Subgroup G) : Prop :=
  NoncentralComponent H V L ∧
    ∀ K, NoncentralComponent H V K → K = L

/-- The full special-linear matrix group, retaining its center. -/
def IsSL (A : Type*) [Group A] (d q : ℕ) : Prop :=
  ∃ (F : Type) (_ : Field F) (_ : Finite F), Nat.card F = q ∧
    Nonempty (A ≃* Matrix.SpecialLinearGroup (Fin d) F)

/-- The full symplectic matrix group of dimension `2r`. -/
def IsSp (A : Type*) [Group A] (r q : ℕ) : Prop :=
  ∃ (F : Type) (_ : Field F) (_ : Finite F), Nat.card F = q ∧
    Nonempty (A ≃* Matrix.symplecticGroup (Fin r) F)

/-- Both congruences in 11.1.1(3), with primality. -/
def ExceptionalPrime (p : ℕ) : Prop :=
  p.Prime ∧ (p % 5 = 1 ∨ p % 5 = 4) ∧ (p % 8 = 3 ∨ p % 8 = 5)

/-- An already concrete SUBLIST of 11.1.1, not its exhaustive classification.
Every branch relates the actual groups; the equality branch requires equality.
The remaining cases must be supplied by the recognition owner. -/
inductive ClassicalComponentCase (Li K : Subgroup G) (n : ℕ) : Prop where
  | equal (h : Li = K)
  | sl3 (h : IsSL (K ⧸ pCore 2 K) 3 (2 ^ n))
  | psl3 (h : ClassicalGroup.IsPSL (K ⧸ pCore 2 K) 3 (2 ^ n))
  | sp4 (h : IsSp (K ⧸ pCore 2 K) 2 (2 ^ n))
  | psl2Prime (hn : n = 2) (p : ℕ) (hp : ExceptionalPrime p)
      (h : ClassicalGroup.IsPSL (K ⧸ pCore 2 K) 2 p)
  | psl2TwentyFive (hn : n = 2)
      (h : ClassicalGroup.IsPSL (K ⧸ pCore 2 K) 2 25)

/-- `K/O_{2,2'}(K)` as an iterated quotient, first by O₂ then by O₂'. -/
abbrev TwoOddQuotient (K : Subgroup G) :=
  (K ⧸ pCore 2 K) ⧸ pPrimeCore 2 (K ⧸ pCore 2 K)

/-- The equality and cases (1–2) of 11.1.2. The PGL₃(4) triangle is not
included in this partial predicate. In particular this must not be used to
assert that case (3) has been eliminated. -/
inductive ClassicalRefinementCase (L Li K : Subgroup G) (i n : ℕ) : Prop where
  | equal (h : Li = K)
  | sl2Prime (hi : i = 1) (hn : n = 2) (p : ℕ)
      (hp : p = 5 ∨ (p.Prime ∧ 11 ≤ p))
      (h : IsSL (TwoOddQuotient K) 2 p)
  | psl2Prime (hi : i = 1) (hn : n = 2) (p : ℕ) (hp : p.Prime) (hlarge : 11 ≤ p)
      (h : ClassicalGroup.IsPSL (K ⧸ pCore 2 K) 2 p)
      (hL : ¬ IsSL (L ⧸ pCore 2 L) 3 4)

/-- Pointwise trivial action on `U/W`, with preservation of both subgroups.
The section hypotheses `W ≤ U` and normality are supplied by the caller. -/
def CentralizesSection (g : G) (U W : Subgroup G) : Prop :=
  g ∈ NG U ∧ g ∈ NG W ∧ ∀ x ∈ U, g * x * g⁻¹ * x⁻¹ ∈ W

/-- Both containments in 11.1.4. -/
def NormalizerControl (V₃ V₁ L₁ M : Subgroup G) : Prop :=
  (∀ g, CentralizesSection g V₃ V₁ → g ∈ M) ∧ NG V₃ ⊓ NG L₁ ≤ M

/-- The subgroup generated by the H-conjugates of V in the common ambient G.
For `H = M` this is the source's `V_M`; for `H = NG V₁` it is the closure
whose abelianness is investigated in §11.2. -/
def conjugateSpan (H V : Subgroup G) : Subgroup G :=
  ⨆ h : H, V.map (MulAut.conj (h : G)).toMonoidHom

/-- The exact dichotomy in 11.1.5, including the actual block and omega-center
conditions and `V_M = ⟨V^M⟩`. -/
def RadicalNormalizerAlternative (T V V₁ R₁ M L : Subgroup G) (n : ℕ) : Prop :=
  NG R₁ ≤ M ∨
    (V = conjugateSpan M V ∧
      (ChapterC.IsSL3EvenBlock L n ∨ ChapterC.IsSp4FourBlock L) ∧
      T ⊓ centralizer (L : Set G) = ⊥ ∧
      V₁ = omegaOneAmbient ((Subgroup.center R₁).map R₁.subtype))

/-- The zero-th weak closure subgroup: generated by the G-conjugates of V
contained in T. This has no assumed normalizer bound. -/
def weakClosureZero (T V : Subgroup G) : Subgroup G :=
  sSup {A | ∃ g : G, A = V.map (MulAut.conj g).toMonoidHom ∧ A ≤ T}

/-- The terminal conclusion 11.2.5 (printed p.770). Its proof must discharge
the hypotheses of 11.2.4 and F.7.11 from the chapter setup. -/
def WeakClosureObstruction (T V V₁ H : Subgroup G) : Prop :=
  ¬ weakClosureZero T V ≤ H.pCoreIn 2 ∨
    ¬ IsMulCommutative (conjugateSpan (NG V₁) V)

end CFSG.Quasithin.Chapter11.Source
