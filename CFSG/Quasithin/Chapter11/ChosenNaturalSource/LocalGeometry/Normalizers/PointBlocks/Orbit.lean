module
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.Normalizers.RadicalAssembly
public import CFSG.Quasithin.ChapterC.Section01.RankOne.ChiProduct.ModuleLift

/-!
# The chosen seed of an actual short block

The chosen module is noncentral and generated by its L-commutators. Thus it
lies in U(L)=[O₂(L),L]. The short-group normal-layer dichotomy identifies it
with all of U(L), including any central fixed part. Since U(L) is
characteristic in L, its normalizer orbit is itself. In particular either
actual block alternative in 11.1.5 supplies V=V_M without an additional
homogeneity or central-splitting hypothesis.

This proves the final sentence of the first paragraph of 11.1.5 once block
recognition is available; it does not assert the MS classification.
Source: Aschbacher--Smith, combined manuscript, printed p.765, using C.1.7--8.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory
open CFSG.Quasithin.Chapter12.Section02
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.Normalizers.PointBlocks
variable {G : Type*} [Group G] {T : Sylow 2 G} {L V : Subgroup G}

/-- The literal chosen seed is the entire characteristic commutator layer. -/
theorem seed_eq_blockU (D : ChosenModule T L V) (h : ChapterC.IsShort L) :
    V = (ChapterC.blockU L).map L.subtype := by
  have hVU : V ≤ (ChapterC.blockU L).map L.subtype := by
    rw [ChapterC.blockU, map_commutator, ← MonoidHom.range_eq_map, range_subtype]
    exact D.eq_commutator.le.trans (commutator_mono D.le_componentCore le_rfl)
  let N := V.subgroupOf L
  let : N.Normal := normal_subgroupOf_of_le_normalizer D.normalizes
  have hNU : N ≤ ChapterC.blockU L := by
    intro v hv
    obtain ⟨u, hu, he⟩ := hVU hv
    exact (Subtype.ext he : u = v) ▸ hu
  rcases ChapterC.RankOne.ChiProduct.short_normal_layer_dichotomy h N hNU with hc | he
  · have hVC : V ≤ centralizer (L : Set G) := by
      intro v hv l hl
      exact congrArg Subtype.val
        (mem_center_iff.mp (hc (show (⟨v, D.le_component hv⟩ : L) ∈ N from hv)) ⟨l, hl⟩)
    exact (D.ne_bot (D.eq_commutator.trans
      (commutator_eq_bot_iff_le_centralizer.mpr hVC))).elim
  · have hm := congrArg (map L.subtype) he
    simpa only [N, map_subgroupOf_eq_of_le D.le_component] using hm

/-- Actual shortness makes the original seed invariant under N_G(L). -/
theorem seed_eq_conjugateSpan_of_short (D : ChosenModule T L V)
    (h : ChapterC.IsShort L) : V = Source.conjugateSpan (normalizer (L : Set G)) V := by
  have hn : normalizer (L : Set G) ≤ normalizer (V : Set G) := by
    rw [seed_eq_blockU D h]
    exact normalizer_le_normalizer_characteristic_image L (ChapterC.blockU L)
  exact (le_antisymm
    (iSup_conjugates_le_of_le_normalizer V _ V le_rfl hn)
    (le_componentOrbit V _)).symm

/-- Either genuine block model supplies the exact span clause in 11.1.5. -/
theorem point_blocks_with_span (D : ChosenModule T L V) {n : ℕ}
    (hb : ChapterC.IsSL3EvenBlock L n ∨ ChapterC.IsSp4FourBlock L) :
    V = Source.conjugateSpan (normalizer (L : Set G)) V ∧
      (ChapterC.IsSL3EvenBlock L n ∨ ChapterC.IsSp4FourBlock L) := by
  refine ⟨seed_eq_conjugateSpan_of_short D ?_, hb⟩
  exact hb.elim (fun h => h.2.1) (fun h => h.1)
end CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.Normalizers.PointBlocks
