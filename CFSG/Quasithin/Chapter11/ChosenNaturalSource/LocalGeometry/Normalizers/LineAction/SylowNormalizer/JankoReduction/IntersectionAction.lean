module
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.Normalizers.LineAction.SylowNormalizer.JankoReduction.Recognized
public import Theory.GroupTheory.PCoreQuotientJoinAction
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.Normalizers.LineAction.SylowNormalizer.JankoReduction.LargeSporadic

/-!
# The original odd supplement in the recognized J₁ branch

When every automorphism of K/O₂(K) is inner, conjugation from KT maps onto
its full automorphism group. Surjective Sylow-normalizer transport therefore
lifts the action of each element of the original odd complement A through
N_{KT}(T). Relative normality of K and coprimeness show that this normalizer
lies in T(K intersect A). The original T fixes the flag residual Y, and the
proved quotient-action comparison reflects its stabilizer. Consequently
A = (K intersect A) N_A(Y), and K intersect A must move Y.

The certified J₁ outer theorem discharges the innerness premise. The source
application keeps the complete A.3.6 alternatives and common data on the
same moved component. Recognition of its J₁ quotient, escape from N_G(L),
and the terminal geometry remain with qt-d-1222-natural-line-action.

Source: Aschbacher--Smith, 3.3.12(3b) and (*), printed p.589, and their
application in 3.3.15--16, printed pp.590--591.
-/

@[expose] public noncomputable section
open Subgroup
open scoped Pointwise
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.Normalizers.SylowNormalizer
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    {D : Chapter12.Section02.ChosenModule T L V} {S : D.NonbinaryNaturalInput}
    {c : Coordinates D S.field} {f : InvariantFlag c} {A : OddSupplement T}

omit [Finite G] in
private theorem odd_mem_normal_sylow_join {K : Subgroup G}
    (hn : (T : Subgroup G) ≤ normalizer (K : Set G)) {a : G}
    (ha : a ∈ A.subgroup) (hj : a ∈ K ⊔ (T : Subgroup G)) : a ∈ K := by
  let J := K ⊔ (T : Subgroup G)
  let N := K.subgroupOf J
  let : N.Normal := (normal_subgroupOf_iff_le_normalizer (show K ≤ J from le_sup_left)).mpr
    (sup_le K.le_normalizer hn)
  let q := QuotientGroup.mk' N
  have hgen : N ⊔ (T : Subgroup G).subgroupOf J = ⊤ := by
    rw [← subgroupOf_sup (show K ≤ J from le_sup_left) (show (T : Subgroup G) ≤ J from le_sup_right)]
    exact subgroupOf_self _
  have hp : IsPGroup 2 (J ⧸ N) := isPGroup_quotient_of_sup_eq_top N _
    T.isPGroup'.comap_subtype hgen
  have he : q ⟨a,hj⟩ = 1 := (hp.powEquiv (Nat.coprime_two_left.mpr A.odd)).injective (by
    simp only [IsPGroup.powEquiv_apply,one_pow,←map_pow]
    have hpow : (⟨a,hj⟩ : J) ^ Nat.card A.subgroup = 1 :=
      Subtype.ext (congrArg (fun x : A.subgroup => (x : G)) (show (⟨a,ha⟩ : A.subgroup) ^ Nat.card A.subgroup = 1 from pow_card_eq_one'))
    rw [hpow,map_one])
  have hh : (⟨a,hj⟩ : J) ∈ N := (QuotientGroup.eq_one_iff _).mp he
  exact hh

omit [Finite G] in
/-- Inside KT, the Sylow normalizer is generated by T and the original
intersection K ∩ A. This uses relative normality and the odd complement. -/
private theorem normalizer_intersection_le_join {K : Subgroup G}
    (hn : (T : Subgroup G) ≤ normalizer (K : Set G)) :
    (K ⊔ (T : Subgroup G)) ⊓ normalizer (T : Set G) ≤
      (T : Subgroup G) ⊔ (K ⊓ A.subgroup) := by
  rintro x ⟨hxJ,hxN⟩
  have hx : x ∈ (T : Subgroup G) ⊔ A.subgroup := A.generate.symm ▸ hxN
  rw [← SetLike.mem_coe, coe_mul_of_right_le_normalizer_left _ _ A.normalizes] at hx
  obtain ⟨t,ht,a,ha,rfl⟩ := hx
  have haJ : a ∈ K ⊔ (T : Subgroup G) := by
    have hh := (K ⊔ (T : Subgroup G)).mul_mem
      (mem_sup_right ((T : Subgroup G).inv_mem ht)) hxJ
    simpa only [inv_mul_cancel_left] using hh
  exact ((T : Subgroup G) ⊔ (K ⊓ A.subgroup)).mul_mem (mem_sup_left ht)
    (mem_sup_right ⟨odd_mem_normal_sylow_join hn ha haJ,ha⟩)

namespace MovedComponent
variable (E : MovedComponent S f A)

private theorem quotient_action_internal (k : E.component) :
    coreQuotientAction E.component ⟨k,E.component.le_normalizer k.property⟩ =
      MulAut.conj (QuotientGroup.mk' (pCore 2 E.component) k) := by
  ext x
  obtain ⟨x,rfl⟩ := QuotientGroup.mk'_surjective (pCore 2 E.component) x
  rw [coreQuotientAction,MonoidHom.comp_apply,quotientAut_apply_mk]
  change QuotientGroup.mk' (pCore 2 E.component) (k * x * k⁻¹) = _
  rw [map_mul,map_mul,map_inv,MulAut.conj_apply]

/-- Lift the original odd action through the Sylow normalizer in KT. -/
private theorem exists_same_action_in_intersection
    (hinner : Function.Surjective (MulAut.conj : (E.component ⧸ pCore 2 E.component) →*
      MulAut (E.component ⧸ pCore 2 E.component))) (a : A.subgroup) :
    ∃ (t : T) (k : ↥(E.component ⊓ A.subgroup)),
      E.oddAction a =
        coreQuotientAction E.component
          ⟨t,E.local_normalizes (mem_sup_left (mem_sup_right t.property))⟩ *
        E.oddAction ⟨k,k.property.2⟩ := by
  have hTK : (T : Subgroup G) ≤ normalizer (E.component : Set G) :=
    le_sup_right.trans le_sup_left |>.trans E.local_normalizes
  let J := E.component ⊔ (T : Subgroup G)
  have hJN : J ≤ normalizer (E.component : Set G) := sup_le E.component.le_normalizer hTK
  let b := (coreQuotientAction E.component).comp (inclusion hJN)
  have hb : Function.Surjective b := by
    intro a
    obtain ⟨x,hx⟩ := hinner a
    obtain ⟨k,hk⟩ := QuotientGroup.mk'_surjective (pCore 2 E.component) x
    refine ⟨⟨k,mem_sup_left k.property⟩,?_⟩
    change coreQuotientAction E.component ⟨k,hJN (mem_sup_left k.property)⟩ = a
    rw [E.quotient_action_internal,hk,hx]
  let P : Sylow 2 J := T.subtype le_sup_right
  let U := P.mapSurjective hb
  let aK : normalizer (E.component : Set G) :=
    ⟨a,E.local_normalizes (mem_sup_right a.property)⟩
  let aQ := coreQuotientAction E.component aK
  have hAU : aQ ∈ normalizer (U : Set (MulAut (E.component ⧸ pCore 2 E.component))) := by
    apply mem_normalizer_fintype
    intro z hz
    obtain ⟨t,ht,rfl⟩ := hz
    have htT : (t : G) ∈ (T : Subgroup G) := ht
    have hat : (a : G) * (t : G) * (a : G)⁻¹ ∈ (T : Subgroup G) := (A.normalizes a.property t).mp htT
    refine ⟨⟨(a : G) * (t : G) * (a : G)⁻¹,mem_sup_right hat⟩,hat,?_⟩
    change coreQuotientAction E.component _ =
      coreQuotientAction E.component aK * coreQuotientAction E.component (inclusion hJN t) *
        (coreQuotientAction E.component aK)⁻¹
    rw [←map_inv,←map_mul,←map_mul]
    rfl
  change aQ ∈ normalizer ((P : Subgroup J).map b : Set _) at hAU
  rw [← P.normalizer_map_surjective b hb] at hAU
  obtain ⟨j,hj,hja⟩ := hAU
  have hjN : (j : G) ∈ normalizer (T : Set G) := by
    change j ∈ normalizer ((T : Subgroup G).subgroupOf J : Set J) at hj
    rw [← subgroupOf_normalizer_eq (show (T : Subgroup G) ≤ J from le_sup_right)] at hj
    exact hj
  have hjgen := normalizer_intersection_le_join (A := A) hTK ⟨j.property,hjN⟩
  rw [← SetLike.mem_coe,coe_mul_of_right_le_normalizer_left _ _
    (inf_le_right.trans A.normalizes)] at hjgen
  obtain ⟨t,ht,k,hk,he⟩ := hjgen
  refine ⟨⟨t,ht⟩,⟨k,hk⟩,?_⟩
  have hjprod : j = (⟨t,mem_sup_right ht⟩ : J) * ⟨k,mem_sup_left hk.1⟩ :=
    Subtype.ext he.symm
  rw [hjprod,map_mul] at hja
  exact hja.symm

/-- The literal supplement decomposes over its component intersection and
its residual stabilizer when the component quotient has no outer automorphisms. -/
theorem supplement_decomposition_of_all_inner
    (hinner : Function.Surjective (MulAut.conj : (E.component ⧸ pCore 2 E.component) →*
      MulAut (E.component ⧸ pCore 2 E.component))) :
    A.subgroup = (E.component ⊓ A.subgroup) ⊔
      (A.subgroup ⊓ normalizer (f.Li E.index : Set G)) := by
  apply le_antisymm _ (sup_le inf_le_right inf_le_left)
  intro a ha
  obtain ⟨t,k,he⟩ := E.exists_same_action_in_intersection hinner ⟨a,ha⟩
  have hgA : a * (k : G)⁻¹ ∈ A.subgroup := A.subgroup.mul_mem ha
    (A.subgroup.inv_mem k.property.2)
  let gK : normalizer (E.component : Set G) :=
    ⟨a * (k : G)⁻¹,E.local_normalizes (mem_sup_right hgA)⟩
  let tK : normalizer (E.component : Set G) :=
    ⟨t,E.local_normalizes (mem_sup_left (mem_sup_right t.property))⟩
  have hact : coreQuotientAction E.component gK = coreQuotientAction E.component tK := by
    change E.oddAction (⟨a,ha⟩ * (⟨k,k.property.2⟩ : A.subgroup)⁻¹) = _
    rw [map_mul,map_inv,he,mul_inv_cancel_right]
  have hgY : a * (k : G)⁻¹ ∈ normalizer (f.Li E.index : Set G) := by
    apply (E.residualImage_fixed_iff gK).mp
    rw [hact]
    exact (E.residualImage_fixed_iff tK).mpr (f.sylow_normalizes_Li E.index t.property)
  have hh := ((E.component ⊓ A.subgroup) ⊔
      (A.subgroup ⊓ normalizer (f.Li E.index : Set G))).mul_mem
    (mem_sup_right ⟨hgA,hgY⟩) (mem_sup_left k.property)
  simpa only [mul_assoc,inv_mul_cancel,mul_one] using hh

/-- The literal set product in source 3.3.12(3b), retaining the original
component, complement and residual normalizer. -/
theorem supplement_product_of_all_inner
    (hinner : Function.Surjective (MulAut.conj : (E.component ⧸ pCore 2 E.component) →*
      MulAut (E.component ⧸ pCore 2 E.component))) :
    (A.subgroup : Set G) = (↑(E.component ⊓ A.subgroup) : Set G) *
      (↑(A.subgroup ⊓ normalizer (f.Li E.index : Set G)) : Set G) := by
  calc
    (A.subgroup : Set G) =
        (↑((E.component ⊓ A.subgroup) ⊔
          (A.subgroup ⊓ normalizer (f.Li E.index : Set G))) : Set G) :=
      congrArg (fun H : Subgroup G => (H : Set G)) (E.supplement_decomposition_of_all_inner hinner)
    _ = _ := coe_mul_of_right_le_normalizer_left _ _ ?_
  exact (le_inf (inf_le_left.trans (le_sup_right.trans E.local_normalizes))
    (inf_le_left.trans A.subgroup.le_normalizer)).trans inf_normalizer_le_normalizer_inf

/-- The original component intersection must move the same flag residual. -/
theorem intersection_moves_of_all_inner
    (hinner : Function.Surjective (MulAut.conj : (E.component ⧸ pCore 2 E.component) →*
      MulAut (E.component ⧸ pCore 2 E.component))) :
    ¬ E.component ⊓ A.subgroup ≤ normalizer (f.Li E.index : Set G) := by
  intro hh
  apply E.moves
  rw [E.supplement_decomposition_of_all_inner hinner]
  exact sup_le hh inf_le_right

private theorem janko_all_inner
    (e : E.component ⧸ pCore 2 E.component ≃* Janko1.Model) :
    Function.Surjective (MulAut.conj : (E.component ⧸ pCore 2 E.component) →*
      MulAut (E.component ⧸ pCore 2 E.component)) := by
  intro a
  obtain ⟨g,hg⟩ := Janko1.OuterCertificate.aut_inner (MulAut.congr e a)
  refine ⟨e.symm g,?_⟩
  ext x
  apply e.injective
  have hx := DFunLike.congr_fun hg (e x)
  simpa only [MulAut.conj_apply,MulAut.congr_apply,MulEquiv.trans_apply,e.symm_apply_apply,
    e.apply_symm_apply,map_mul,map_inv] using hx

/-- The actual J₁ marking gives the source supplement product. -/
theorem janko_supplement_product
    (e : E.component ⧸ pCore 2 E.component ≃* Janko1.Model) :
    (A.subgroup : Set G) = (↑(E.component ⊓ A.subgroup) : Set G) *
      (↑(A.subgroup ⊓ normalizer (f.Li E.index : Set G)) : Set G) :=
  E.supplement_product_of_all_inner (E.janko_all_inner e)

/-- The certified trivial outer group of J₁ gives actual intersection movement. -/
theorem janko_intersection_moves
    (e : E.component ⧸ pCore 2 E.component ≃* Janko1.Model) :
    ¬ E.component ⊓ A.subgroup ≤ normalizer (f.Li E.index : Set G) :=
  E.intersection_moves_of_all_inner (E.janko_all_inner e)

end MovedComponent
/-- Apply the exact supplement product and intersection movement to the
component produced by the original escape, without discarding other source rows. -/
theorem exists_moved_component_with_janko_intersection
    (f : InvariantFlag c) (A : OddSupplement T)
    (hescape : ¬ normalizer (T : Set G) ≤ normalizer (L : Set G)) :
    ∃ E : MovedComponent S f A,
      SourceCasesAfterLargeSporadic (E.component ⧸ pCore 2 E.component) ∧
      Chapter1.Section02.A36Common (⊤ : Subgroup (E.component ⧸ pCore 2 E.component)) ∧
      (Nonempty (E.component ⧸ pCore 2 E.component ≃* Janko1.Model) →
        S.field.degree = 2 ∧
        (A.subgroup : Set G) = (↑(E.component ⊓ A.subgroup) : Set G) *
          (↑(A.subgroup ⊓ normalizer (f.Li E.index : Set G)) : Set G) ∧
        ¬ E.component ⊓ A.subgroup ≤ normalizer (f.Li E.index : Set G)) := by
  obtain ⟨E,hcases,hcommon⟩ := exists_moved_component_after_large_sporadic f A hescape
  refine ⟨E,hcases,hcommon,?_⟩
  rintro ⟨e⟩
  exact ⟨degree_eq_two_of_janko_containing E.index E.contains.le e,
    E.janko_supplement_product e,E.janko_intersection_moves e⟩

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.Normalizers.SylowNormalizer
