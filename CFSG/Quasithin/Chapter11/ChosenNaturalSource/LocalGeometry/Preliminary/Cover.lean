module

public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry
public import Theory.Representation.FirstCohomologyDuality.Indecomposable

/-!
# The marked central cover of the original chosen module

The chosen Irr⁺ module is generated by commutators and its two-core acts
trivially. Reindex its action along the full supplied natural marking.
The literal projection through C_V(L) is then a central cover. Its kernel
is identified with the ambient relative centralizer, without a splitting
assumption or a field structure on that kernel. Thus the universal-cover
bound applies directly to the source rank m(C_V(L)).

Source: Aschbacher--Smith, 11.0.3(3), printed p.760, and I.1.5--6,
printed p.408. The model cohomology calculations are separate inputs here.
-/

@[expose] public noncomputable section
open scoped IsMulCommutative
open Subgroup Theory.GroupTheory Representation Representation.OneCohomology
open CFSG.Quasithin.Chapter12.Section02
open CFSG.Quasithin.ChapterB.QuasisimpleSource
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.Preliminary
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    (D : ChosenModule T L V)

/-- The literal fixed subspace inside the original chosen space. -/
abbrev centralSpace : Submodule (ZMod 2) D.space :=
  (Representation.BinaryOffender.fixedSpace (reducedRepresentation (L ⊔ (T : Subgroup G)))
    (L.subgroupOf (L ⊔ (T : Subgroup G)))).comap D.space.subtype

omit [Finite G] in
/-- Fixed vectors in chosen coordinates are precisely C_V(L). -/
theorem mem_centralSpace_iff (v : D.space) :
    v ∈ centralSpace D ↔ (D.spaceEquiv (Multiplicative.ofAdd v) : G) ∈
      centralizer (L : Set G) := by
  rw [← quotient_eq_one_iff D (D.spaceEquiv (Multiplicative.ofAdd v))]
  change v ∈ centralSpace D ↔ Submodule.Quotient.mk
    (D.spaceEquiv.symm (D.spaceEquiv (Multiplicative.ofAdd v))).toAdd =
      (0 : D.chosenCentralQuotient)
  rw [D.spaceEquiv.symm_apply_apply]
  exact (Submodule.Quotient.mk_eq_zero (centralSpace D)).symm

/-- This equivalence keeps the actual ambient inclusion of the central kernel. -/
def centralSpaceEquiv : centralSpace D ≃ (V ⊓ centralizer (L : Set G) : Subgroup G) where
  toFun v := ⟨D.spaceEquiv (Multiplicative.ofAdd v.val),
    (D.spaceEquiv (Multiplicative.ofAdd v.val)).property,
    (mem_centralSpace_iff D v.val).mp v.property⟩
  invFun v := ⟨(D.spaceEquiv.symm ⟨v, v.property.1⟩).toAdd,
    (mem_centralSpace_iff D _).mpr (by simpa using v.property.2)⟩
  left_inv v := by
    apply Subtype.ext
    exact congrArg Multiplicative.toAdd
      (D.spaceEquiv.symm_apply_apply (Multiplicative.ofAdd v.val))
  right_inv v := by
    apply Subtype.ext
    exact congrArg (fun w : V => (w : G))
      (D.spaceEquiv.apply_symm_apply ⟨v, v.property.1⟩)

variable {A W : Type*} [Group A] [AddCommGroup W] [Module (ZMod 2) W]
    {ρ : Representation (ZMod 2) A W}
    (m : ActionEquiv D.centralQuotientAction ρ)

/-- The entire chosen module, reindexed by the same full quotient marking. -/
def markedAction : Representation (ZMod 2) A D.space :=
  (QuotientGroup.lift (pCore 2 L) D.chosenAction D.chosenAction_core).comp
    m.groupEquiv.symm.toMonoidHom

theorem markedAction_mk (l : L) (v : D.space) :
    markedAction D m (m.groupEquiv (QuotientGroup.mk' (pCore 2 L) l)) v =
      D.chosenAction l v := by
  change (QuotientGroup.lift (pCore 2 L) D.chosenAction D.chosenAction_core)
    (m.groupEquiv.symm (m.groupEquiv (QuotientGroup.mk' (pCore 2 L) l))) v = _
  rw [m.groupEquiv.symm_apply_apply]
  rfl

/-- The marking is applied after the original fixed-space quotient projection. -/
def markedProjection : (markedAction D m).IntertwiningMap ρ where
  toLinearMap := m.linearEquiv.toLinearMap.comp (centralSpace D).mkQ
  isIntertwining' a := by
    apply LinearMap.ext
    intro v
    obtain ⟨l, rfl⟩ := (m.groupEquiv.surjective.comp
      (QuotientGroup.mk'_surjective (pCore 2 L))) a
    change m.linearEquiv (Submodule.Quotient.mk
      (markedAction D m (m.groupEquiv (QuotientGroup.mk' (pCore 2 L) l)) v)) =
      ρ (m.groupEquiv (QuotientGroup.mk' (pCore 2 L) l))
        (m.linearEquiv (Submodule.Quotient.mk v))
    rw [markedAction_mk]
    exact m.intertwines (QuotientGroup.mk' (pCore 2 L) l) (Submodule.Quotient.mk v)

/-- No central summand is introduced: the original Irr⁺ module is a cover. -/
theorem markedProjection_isCover : IsCover (markedProjection D m) := by
  have hs : Function.Surjective (fun l : L =>
      m.groupEquiv (QuotientGroup.mk' (pCore 2 L) l)) :=
    m.groupEquiv.surjective.comp (QuotientGroup.mk'_surjective _)
  refine ⟨m.linearEquiv.surjective.comp (Submodule.mkQ_surjective _), ?_, ?_⟩
  · intro v hv a
    obtain ⟨l, rfl⟩ := hs a
    rw [markedAction_mk]
    have hq : (centralSpace D).mkQ v = 0 :=
      m.linearEquiv.injective (hv.trans (map_zero m.linearEquiv).symm)
    have hz : v ∈ centralSpace D := (Submodule.Quotient.mk_eq_zero _).mp hq
    exact Subtype.ext (hz ((subgroupOfEquivOfLe
      (show L ≤ L ⊔ (T : Subgroup G) from le_sup_left)).symm l))
  · have hle : D.space ≤ (Coinvariants.ker (markedAction D m)).map D.space.subtype := by
      apply D.irrPlus.isIrrPlus.choose_spec.1.ge.trans
      apply Submodule.span_le.mpr
      rintro _ ⟨l, hl, v, hv, rfl⟩
      let l' : L := ⟨l.val, hl⟩
      let v' : D.space := ⟨v, hv⟩
      refine ⟨markedAction D m (m.groupEquiv (QuotientGroup.mk' (pCore 2 L) l')) v' - v',
        Coinvariants.sub_mem_ker _ _, ?_⟩
      rw [markedAction_mk]
      rfl
    apply top_unique
    intro v _
    obtain ⟨w, hw, he⟩ := hle v.property
    exact (Subtype.ext he : w = v) ▸ hw

/-- The linear kernel is exactly the original fixed space. -/
theorem markedProjection_ker : (markedProjection D m).toLinearMap.ker = centralSpace D := by
  ext v
  change m.linearEquiv ((centralSpace D).mkQ v) = 0 ↔ v ∈ centralSpace D
  rw [m.linearEquiv.map_eq_zero_iff]
  exact Submodule.Quotient.mk_eq_zero _

/-- The group-theoretic rank in 11.0.3 is the dimension of this same kernel. -/
theorem centralizer_rank_eq_kernel_finrank :
    Representation.BinaryOffender.rank (V ⊓ centralizer (L : Set G)) =
      Module.finrank (ZMod 2) (markedProjection D m).toLinearMap.ker := by
  rw [markedProjection_ker]
  unfold Representation.BinaryOffender.rank
  rw [← Nat.card_congr (centralSpaceEquiv D),
    Module.natCard_eq_pow_finrank (K := ZMod 2), Nat.card_zmod,
    Nat.log_pow (by decide : 1 < 2)]

include D m in
/-- Actual chosen-module application of the universal central-cover bound.
Its only numerical premise is the model's dual cohomology dimension. -/
theorem centralizer_rank_le_of_dual_cohomology [Finite A] [FiniteDimensional (ZMod 2) W]
    {n : ℕ} (hn : Module.finrank (ZMod 2) (H1 ρ.dual) ≤ n) :
    Representation.BinaryOffender.rank (V ⊓ centralizer (L : Set G)) ≤ n := by
  rw [centralizer_rank_eq_kernel_finrank D m]
  exact (finrank_ker_le_H1_of_cover (markedProjection D m)
    (markedProjection_isCover D m)).trans hn

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.Preliminary
