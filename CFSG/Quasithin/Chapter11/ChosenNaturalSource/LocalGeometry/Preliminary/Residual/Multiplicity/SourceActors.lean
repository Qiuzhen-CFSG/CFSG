variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    (D : ChosenModule T L V) (S : D.NonbinaryNaturalInput)

/-- The qrc bound on the literal faithful full-orbit action. -/
theorem fullAction_cubicRatio_le_two :
    letI := fullModule_elementary D S
    cubicRatio (imageRepresentation (fullModuleConjugation D S)) ≤ 2 := by
  let := fullModule_elementary D S
  let M := normalizer (L : Set G)
  let U := componentOrbit V M
  let hn := le_normalizer_componentOrbit V M
  let ρ := fullModuleConjugation D S
  let σ := ChapterD.UniqueFactor.imageRepresentation M U hn
  let f : ChapterD.internalActionImage M U hn →* actionImage ρ :=
    σ.asGroupHom.codRestrict _ (by
      rintro ⟨a,g,rfl⟩
      exact ⟨g,rfl⟩)
  have hf : Function.Injective f := by
    intro x y he
    apply ChapterD.UniqueFactor.imageRepresentation_injective M U hn
    exact congrArg (fun a => imageRepresentation ρ a) he
  exact cubicRatio_le_nat_of_equivariant σ (imageRepresentation ρ) f hf
    (LinearEquiv.refl (ZMod 2) (Additive U)) (fun _ _ => rfl) 2
    (D.normalizerOrbit_cubicBound_of_many S.source S.many)

/-- The full orbit has an actual inclusion-minimal minimum-ratio cubic actor. -/
theorem fullAction_exists_starred_actor :
    letI := fullModule_elementary D S
    (ChapterD.QhatStar (imageRepresentation (fullModuleConjugation D S))).Nonempty := by
  let := fullModule_elementary D S
  exact (ChapterD.QhatStar_nonempty_iff _).mpr (fullAction_cubicRatio_le_two D S)

/-- The marked component image is an ordinary component of the faithful action image. -/
theorem sl3_fullAction_component_isComponent
    (m : ActionEquiv D.centralQuotientAction (linearNatural S.field 3)) :
    letI := fullModule_elementary D S
    IsComponent (actionImage (fullModuleConjugation D S))
      ((L.subgroupOf (normalizer (L : Set G))).map
        (actionHom (fullModuleConjugation D S))) := by
  let := fullModule_elementary D S
  let M := normalizer (L : Set G)
  let K := L.subgroupOf M
  let f := actionHom (fullModuleConjugation D S)
  let : K.Normal := normal_subgroupOf_of_le_normalizer le_rfl
  let : (K.map f).Normal := Normal.map inferInstance f
    (fullModuleConjugation D S).asGroupHom.rangeRestrict_surjective
  obtain ⟨e,_⟩ := sl3_fullAction_component_marking D S m
  let := S.source.quasisimple
  let := IsQuasisimple.of_mulEquiv (m.groupEquiv.trans e.symm)
  exact ⟨IsSubnormal.step _ ⊤ le_top IsSubnormal.top inferInstance, inferInstance⟩

/-- Every nonzero invariant subspace contains at least one natural dimension. -/
theorem fullModule_sl3_invariant_finrank
    (m : ActionEquiv D.centralQuotientAction (linearNatural S.field 3)) :
    letI := fullModule_elementary D S
    ∀ W : Submodule (ZMod 2) (Additive (componentOrbit V (normalizer (L : Set G)))),
      W ≠ ⊥ →
      (∀ (l : L) w, w ∈ W → fullModuleConjugation D S (inclusion L.le_normalizer l) w ∈ W) →
      3 * S.field.degree ≤ Module.finrank (ZMod 2) W := by
  let := fullModule_elementary D S
  intro W hW hstable
  obtain ⟨s,_,e,he⟩ := fullModule_sl3_natural_copies D S m
  let ρ := (fullModuleConjugation D S).comp (inclusion L.le_normalizer)
  let P : Subrepresentation ρ := {
    toSubmodule := W
    apply_mem_toSubmodule := fun l => hstable l }
  let q := m.groupEquiv.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))
  have hq : Function.Surjective q := m.groupEquiv.surjective.comp (QuotientGroup.mk'_surjective _)
  let σ := (linearNatural S.field 3).comp q
  let : IsIrreducible σ := (irreducible_comp_surjective_iff q hq _).mpr
    (ExtensionConsequences.linearNatural_irreducible S.field (by decide))
  obtain ⟨w,hw,hw0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hW
  obtain ⟨i,hi⟩ : ∃ i, e w i ≠ 0 := by
    by_contra h
    apply hw0
    apply e.injective
    rw [map_zero]
    funext i
    exact not_ne_iff.mp (not_exists.mp h i)
  let p : P.toRepresentation.IntertwiningMap σ := {
    toLinearMap := (LinearMap.proj i).comp (e.toLinearMap.comp W.subtype)
    isIntertwining' := fun l => LinearMap.ext (fun v => congrFun (he l v) i) }
  have hp : p ≠ 0 := fun hz => hi (DFunLike.congr_fun hz ⟨w,hw⟩)
  have hd := LinearMap.finrank_le_finrank_of_surjective
    (IsIrreducible.surjective_or_eq_zero p |>.resolve_right hp)
  have hF : Module.finrank (ZMod 2) S.field.Carrier = S.field.degree := by
    have hc := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := S.field.Carrier)
    rw [Nat.card_zmod,S.field.card_eq] at hc
    exact (Nat.pow_right_injective (by decide : 1 < 2) hc).symm
  simpa only [Module.finrank_pi_fintype,Finset.sum_const,Finset.card_univ,
    Fintype.card_fin,smul_eq_mul,hF] using hd

/-- A nontrivial subgroup commuting with the component moves more than four binary dimensions. -/
theorem sl3_fullAction_moved_finrank_gt_four
    (m : ActionEquiv D.centralQuotientAction (linearNatural S.field 3)) :
    letI := fullModule_elementary D S
    let ρ := fullModuleConjugation D S
    let K := (L.subgroupOf (normalizer (L : Set G))).map (actionHom ρ)
    ∀ X : Subgroup (actionImage ρ), X ≠ ⊥ → X ≤ centralizer (K : Set (actionImage ρ)) →
      4 < Module.finrank (ZMod 2) (subspaceCommutator (imageRepresentation ρ) ⊤ X) := by
  let := fullModule_elementary D S
  let ρ := fullModuleConjugation D S
  let τ := imageRepresentation ρ
  let K := (L.subgroupOf (normalizer (L : Set G))).map (actionHom ρ)
  dsimp only
  intro X hX hc
  let W := subspaceCommutator τ ⊤ X
  have hW : W ≠ ⊥ := by
    intro hz
    have hfix := (subspaceCommutator_eq_bot_iff τ ⊤ X).mp hz
    apply hX
    apply bot_unique
    intro x hx
    apply (imageRepresentation_injective ρ)
    apply LinearMap.ext
    intro v
    exact hfix Submodule.mem_top ⟨x,hx⟩
  have hs : K ≤ subspaceStabilizer τ W :=
    subspaceCommutator_invariant_normalizer τ
      (le_subspaceStabilizer τ ⊤ (by simp))
      ((le_centralizer_iff.mp hc).trans (Subgroup.centralizer_le_normalizer _))
  have hd := fullModule_sl3_invariant_finrank D S m W hW (by
    intro l w hw
    exact (hs (mem_map_of_mem (actionHom ρ) (show inclusion L.le_normalizer l ∈
      L.subgroupOf (normalizer (L : Set G)) from l.property)) w).2 hw)
  have hn := S.nonbinary
  change 4 < Module.finrank (ZMod 2) W
  omega

/-- Every prime core of the faithful image centralizes its original component. -/
theorem sl3_fullAction_primeCore_centralizes_component
    (m : ActionEquiv D.centralQuotientAction (linearNatural S.field 3))
    (p : ℕ) [Fact p.Prime] :
    letI := fullModule_elementary D S
    let ρ := fullModuleConjugation D S
    let K := (L.subgroupOf (normalizer (L : Set G))).map (actionHom ρ)
    pCore p (actionImage ρ) ≤ centralizer (K : Set (actionImage ρ)) := by
  let := fullModule_elementary D S
  let ρ := fullModuleConjugation D S
  let K := (L.subgroupOf (normalizer (L : Set G))).map (actionHom ρ)
  have hK := sl3_fullAction_component_isComponent D S m
  rcases hK.normal_dichotomy (pCore p (actionImage ρ)) with hi | hc
  · let := hK.2
    let : Group.IsNilpotent (pCore p (actionImage ρ)) := pCore_isPGroup.isNilpotent
    let : Group.IsSolvable K := Group.isSolvable_of_isSolvable_injective
      (inclusion_injective hi)
    let : IsSimpleGroup (K ⧸ center K) := IsQuasisimple.simple
    let : Nontrivial K := (QuotientGroup.mk'_surjective (center K)).nontrivial
    exact (Group.IsPerfect.not_isSolvable K inferInstance).elim
  · exact le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hc)

/-- D.2.13 on the actual starred actor excludes movement of every odd core except three. -/
theorem sl3_fullAction_starred_centralizes_oddCore
    (m : ActionEquiv D.centralQuotientAction (linearNatural S.field 3))
    (p : ℕ) [Fact p.Prime] (hp : Odd p) (hp3 : p ≠ 3) :
    letI := fullModule_elementary D S
    let ρ := fullModuleConjugation D S
    ∀ A : Subgroup (actionImage ρ), A ∈ ChapterD.QhatStar (imageRepresentation ρ) →
      ⁅pCore p (actionImage ρ), A⁆ = ⊥ := by
  let := fullModule_elementary D S
  let ρ := fullModuleConjugation D S
  dsimp only
  intro A hA
  by_contra hn
  obtain ⟨hc,hfive⟩ := ChapterD.source_lemma_D_2_13_one_two
    (imageRepresentation ρ) (imageRepresentation_injective ρ) hA hp hn
  have hp5 : p = 5 := hc.resolve_left hp3
  have hd := (hfive hp5).2.2.2.2
  have hbig := sl3_fullAction_moved_finrank_gt_four D S m
    ⁅pCore p (actionImage ρ), A⁆ hn
    ((commutator_le_left _ _).trans (sl3_fullAction_primeCore_centralizes_component D S m p))
  exact (Nat.ne_of_gt hbig) hd

/-- The component centralizer has trivial two-group action on the whole three-core. -/
theorem sl3_fullAction_twoGroup_centralizes_threeCore
    (m : ActionEquiv D.centralQuotientAction (linearNatural S.field 3))
    (heven : Even S.field.degree) :
    letI := fullModule_elementary D S
    let ρ := fullModuleConjugation D S
    let K := (L.subgroupOf (normalizer (L : Set G))).map (actionHom ρ)
    ∀ B : Subgroup (actionImage ρ), IsPGroup 2 B →
      B ≤ centralizer (K : Set (actionImage ρ)) →
      B ≤ centralizer (pCore 3 (actionImage ρ) : Set (actionImage ρ)) := by
  let := fullModule_elementary D S
  let ρ := fullModuleConjugation D S
  let H := actionImage ρ
  let K := (L.subgroupOf (normalizer (L : Set G))).map (actionHom ρ)
  let Q := pCore 3 H
  dsimp only
  intro B hB hBK
  obtain ⟨hK,hr⟩ := sl3_fullAction_rank_pair D S m heven
  have hQK : Q ≤ centralizer (K : Set H) :=
    sl3_fullAction_primeCore_centralizes_component D S m 3
  have hQrank : primeRank 3 Q ≤ 1 :=
    CubicCentralizer.centralizing_rank_le_one K Q hK hr
      (sl3_fullAction_component_center_card D S m) hQK
  let : IsCyclic Q := (pCore_isPGroup (p := 3) (G := H)).isCyclic_of_odd_of_elementary_card_le
    (by decide) (fun E hE => by
      let := hE
      exact IsElementaryAbelian.card_le_prime_of_primeRank_le_one hQrank E)
  let a : B →* MulAut Q := (MulAut.conjNormal : H →* MulAut Q).comp B.subtype
  have hcop : Nat.Coprime (Nat.card B) (Nat.card Q) := by
    obtain ⟨i,hi⟩ := hB.exists_card_eq
    obtain ⟨j,hj⟩ := (pCore_isPGroup (p := 3) (G := H)).exists_card_eq
    rw [hi,hj]
    exact ((by decide : Nat.Coprime 2 3).pow_left i).pow_right j
  have hact : ∀ b : B, a b = 1 :=
    OmegaAction.fixes_of_fixes_omega_one pCore_isPGroup a hcop (by
      intro b x hx
      have hx3 : x ^ 3 = 1 := by
        rw [OmegaAction.omega_eq_pow_ker] at hx
        simpa only [pow_one,MonoidHom.mem_ker,powMonoidHom_apply] using hx
      have hxK : (x : H) ∈ K := CubicCentralizer.cubic_mem_of_centralizes K hK hr
        (congrArg Subtype.val hx3) (hQK x.property)
      apply Subtype.ext
      change (b : H) * (x : H) * (b : H)⁻¹ = x
      rw [← hBK b.property x hxK,mul_inv_cancel_right])
  intro b hb x hx
  have he := congrArg (fun f : MulAut Q => (f ⟨x,hx⟩ : H)) (hact ⟨b,hb⟩)
  change b * x * b⁻¹ = x at he
  exact (mul_inv_eq_iff_eq_mul.mp he).symm

/-- Reducedness of V_M gives trivial two-core in its literal faithful action image. -/
theorem fullAction_twoCore_eq_bot :
    letI := fullModule_elementary D S
    pCore 2 (actionImage (fullModuleConjugation D S)) = ⊥ := by
  let := fullModule_elementary D S
  let M := normalizer (L : Set G)
  let U := componentOrbit V M
  let hn := le_normalizer_componentOrbit V M
  let ρ := fullModuleConjugation D S
  let σ := ChapterD.UniqueFactor.imageRepresentation M U hn
  let f : ChapterD.internalActionImage M U hn →* actionImage ρ :=
    σ.asGroupHom.codRestrict _ (by
      rintro ⟨a,g,rfl⟩
      exact ⟨g,rfl⟩)
  have hf : Function.Injective f := by
    intro x y he
    apply ChapterD.UniqueFactor.imageRepresentation_injective M U hn
    exact congrArg (fun a => imageRepresentation ρ a) he
  have hs : Function.Surjective f := by
    intro x
    obtain ⟨g,rfl⟩ := ρ.asGroupHom.rangeRestrict_surjective x
    exact ⟨⟨_,g,rfl⟩,rfl⟩
  let e := MulEquiv.ofBijective f ⟨hf,hs⟩
  have hUM : U ≤ M := iSup_conjugates_le_of_le_normalizer V M M
    (D.le_sylow.trans D.sylow_normalizes_component) M.le_normalizer
  have hcore := Chapter3.Section02.internalActionImage_core_of_reduced M U hUM hn
    (fullModule_reduced D S)
  rw [← pCore_map_iso 2 e,hcore,Subgroup.map_bot]

/-- The actual kernel of a starred actor on the component centralizes Fitting. -/
theorem sl3_fullAction_starred_kernel_centralizes_fitting
    (m : ActionEquiv D.centralQuotientAction (linearNatural S.field 3))
    (heven : Even S.field.degree) :
    letI := fullModule_elementary D S
    let ρ := fullModuleConjugation D S
    let K := (L.subgroupOf (normalizer (L : Set G))).map (actionHom ρ)
    ∀ A : Subgroup (actionImage ρ), A ∈ ChapterD.QhatStar (imageRepresentation ρ) →
      A ⊓ centralizer (K : Set (actionImage ρ)) ≤
        centralizer (fittingSubgroup (actionImage ρ) : Set (actionImage ρ)) := by
  let := fullModule_elementary D S
  let ρ := fullModuleConjugation D S
  let H := actionImage ρ
  let K := (L.subgroupOf (normalizer (L : Set G))).map (actionHom ρ)
  dsimp only
  intro A hA
  let B := A ⊓ centralizer (K : Set H)
  let : IsElementaryAbelian 2 A := hA.1.2.1.2
  have hB : IsPGroup 2 B := (IsElementaryAbelian.isPGroup 2 A).of_injective
    (inclusion (show B ≤ A from inf_le_left)) (inclusion_injective _)
  apply le_centralizer_iff.mpr
  rw [fitting_eq_sup_pCore]
  apply iSup_le
  intro p
  let : Fact p.1.1.Prime := ⟨Nat.prime_of_mem_primeFactors p.1.2⟩
  by_cases hp2 : p.1.1 = 2
  · rw [hp2,fullAction_twoCore_eq_bot D S]
    exact bot_le
  by_cases hp3 : p.1.1 = 3
  · rw [hp3]
    exact le_centralizer_iff.mp
      (sl3_fullAction_twoGroup_centralizes_threeCore D S m heven B hB inf_le_right)
  · exact (commutator_eq_bot_iff_le_centralizer.mp
      (sl3_fullAction_starred_centralizes_oddCore D S m p.1.1
        ((Fact.out : p.1.1.Prime).odd_of_ne_two hp2) hp3 A hA)).trans
          (centralizer_le (show B ≤ A from inf_le_left))

/-- A nonfaithful starred actor produces a moved three-free component and its exact A-orbit. -/
theorem sl3_fullAction_starred_nonfaithful_component
    (m : ActionEquiv D.centralQuotientAction (linearNatural S.field 3))
    (heven : Even S.field.degree) :
    letI := fullModule_elementary D S
    let ρ := fullModuleConjugation D S
    let K := (L.subgroupOf (normalizer (L : Set G))).map (actionHom ρ)
    ∀ A : Subgroup (actionImage ρ), A ∈ ChapterD.QhatStar (imageRepresentation ρ) →
      A ⊓ centralizer (K : Set (actionImage ρ)) ≠ ⊥ →
      ∃ J : Subgroup (actionImage ρ), IsComponent (actionImage ρ) J ∧
        ⁅J,A ⊓ centralizer (K : Set (actionImage ρ))⁆ ≠ ⊥ ∧
        componentOrbit J A ≤ centralizer (K : Set (actionImage ρ)) ∧
        ⁅componentOrbit J A,A ⊓ centralizer (K : Set (actionImage ρ))⁆ = componentOrbit J A ∧
        Nat.Coprime 3 (Nat.card J) := by
  let := fullModule_elementary D S
  let ρ := fullModuleConjugation D S
  let H := actionImage ρ
  let K := (L.subgroupOf (normalizer (L : Set G))).map (actionHom ρ)
  dsimp only
  intro A hA hne
  let B := A ⊓ centralizer (K : Set H)
  let : IsElementaryAbelian 2 A := hA.1.2.1.2
  have hB : IsPGroup 2 B := (IsElementaryAbelian.isPGroup 2 A).of_injective
    (inclusion (show B ≤ A from inf_le_left)) (inclusion_injective _)
  obtain ⟨J,hJ,hm⟩ := exists_component_moved_of_centralizes_fitting 2 B hB hne
    (fullAction_twoCore_eq_bot D S)
    (sl3_fullAction_starred_kernel_centralizes_fitting D S m heven A hA)
  have hJK : J ≠ K := by
    intro he
    subst J
    exact hm (commutator_eq_bot_iff_le_centralizer.mpr
      (le_centralizer_iff.mp (show B ≤ centralizer (K : Set H) from inf_le_right)))
  have hc : J ≤ centralizer (K : Set H) := commutator_eq_bot_iff_le_centralizer.mp
    (hJ.commutator_eq_bot_of_ne (sl3_fullAction_component_isComponent D S m) hJK)
  let : (L.subgroupOf (normalizer (L : Set G))).Normal := normal_subgroupOf_of_le_normalizer le_rfl
  let : K.Normal := Normal.map inferInstance (actionHom ρ) ρ.asGroupHom.rangeRestrict_surjective
  have ho : componentOrbit J A ≤ centralizer (K : Set H) :=
    iSup_conjugates_le_of_le_normalizer J A _ hc (by
      have hn : normalizer (centralizer (K : Set H) : Set H) = ⊤ := normalizer_eq_top _
      exact le_top.trans_eq hn.symm)
  have hAB : A ≤ normalizer (B : Set H) :=
    (le_inf A.le_normalizer (le_normalizer_of_normal)).trans inf_normalizer_le_normalizer_inf
  have hAX : A ≤ normalizer (componentOrbit J A : Set H) := le_normalizer_componentOrbit J A
  have hmove : ⁅componentOrbit J A,B⁆ = componentOrbit J A := by
    apply le_antisymm (le_normalizer_iff_commutator_le_left.mp
      ((show B ≤ A from inf_le_left).trans hAX))
    apply iSup_conjugates_le_of_le_normalizer J A
    · have hJB : J ≤ ⁅J,B⁆ := (le_componentOrbit J B).trans_eq
        ((hJ.commutator_dichotomy B).resolve_left hm).symm
      exact hJB.trans (commutator_mono (le_componentOrbit J A) le_rfl)
    · intro a ha
      rw [mem_normalizer_iff_map_conj_eq,map_commutator,
        mem_normalizer_iff_map_conj_eq.mp (hAX ha),
        mem_normalizer_iff_map_conj_eq.mp (hAB ha)]
  let := hJ.2
  exact ⟨J,hJ,hm,ho,hmove,sl3_fullAction_perfect_centralizer_coprime D S m heven J hc⟩

/-- Unconditional actor selection and kernel alternatives on the original chosen-natural input. -/
theorem sl3_fullAction_exists_starred_actor_cases
    (m : ActionEquiv D.centralQuotientAction (linearNatural S.field 3))
    (heven : Even S.field.degree) :
    letI := fullModule_elementary D S
    let ρ := fullModuleConjugation D S
    let K := (L.subgroupOf (normalizer (L : Set G))).map (actionHom ρ)
    ∃ A : Subgroup (actionImage ρ), A ∈ ChapterD.QhatStar (imageRepresentation ρ) ∧
      (A ⊓ centralizer (K : Set (actionImage ρ)) = ⊥ ∨
        ∃ J : Subgroup (actionImage ρ), IsComponent (actionImage ρ) J ∧
          ⁅J,A ⊓ centralizer (K : Set (actionImage ρ))⁆ ≠ ⊥ ∧
          componentOrbit J A ≤ centralizer (K : Set (actionImage ρ)) ∧
          ⁅componentOrbit J A,A ⊓ centralizer (K : Set (actionImage ρ))⁆ = componentOrbit J A ∧
          Nat.Coprime 3 (Nat.card J)) := by
  let := fullModule_elementary D S
  obtain ⟨A,hA⟩ := fullAction_exists_starred_actor D S
  refine ⟨A,hA,?_⟩
  by_cases he : A ⊓ centralizer (((L.subgroupOf (normalizer (L : Set G))).map
      (actionHom (fullModuleConjugation D S))) :
        Set (actionImage (fullModuleConjugation D S))) = ⊥
  · exact Or.inl he
  · exact Or.inr (sl3_fullAction_starred_nonfaithful_component D S m heven A hA he)

