module
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.FlagCartan.G2.ResidualIncidence.Marked

/-!
# Generation by the literal G₂ flag residuals

The two marked model residuals generate G₂. Their lifts generate L modulo
O₂(L). The original T normalizes both lifts, and O₂(L) lies in T∩L, so their
join is normal in L with a two-group quotient. Source perfectness of L makes
that quotient trivial. Thus model-image generation is lifted to the actual
ambient group, including its entire two-core.

Source: Aschbacher--Smith, opening §11.1, printed pp.760--761.
-/

set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
open Subgroup Representation
open CFSG.Quasithin.Chapter12.Section02
open CFSG.Quasithin.ChapterB.QuasisimpleSource

namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.G2.ResidualIncidence
private theorem embeddedResidual_map {A : Type*} [Group A] [Finite A]
    (e : A ≃* A) (H : Subgroup A) :
    (solvableResidual (H.map e.toMonoidHom)).map (H.map e.toMonoidHom).subtype =
      ((solvableResidual H).map H.subtype).map e.toMonoidHom := by
  have hc : (H.map e.toMonoidHom).comap e.toMonoidHom = H := by
    rw [comap_map_eq, e.toMonoidHom.ker_eq_bot e.injective, sup_bot_eq]
  have h := map_solvableResidual_comap e.toMonoidHom e.surjective (H.map e.toMonoidHom)
  rw [hc] at h
  exact h.symm

variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    {D : ChosenModule T L V} (S : D.NonbinaryNaturalInput)
    (m : ActionEquiv D.centralQuotientAction
      (restrictScalars (k := ZMod 2) (g2Natural S.field.Carrier)))

/-- The two marked residual images generate the full nonbinary octonion group. -/
theorem modelResiduals_sup_eq_top :
    (solvableResidual ((coordinates S m).modelStabilizer ((flag S m).space 0))).map
      ((coordinates S m).modelStabilizer ((flag S m).space 0)).subtype ⊔
    (solvableResidual ((coordinates S m).modelStabilizer ((flag S m).space 1))).map
      ((coordinates S m).modelStabilizer ((flag S m).space 1)).subtype = ⊤ := by
  have h0 : (coordinates S m).modelStabilizer ((flag S m).space 0) =
      (standardParabolic S.field.Carrier 0).map
        (MulAut.conj (alignment S m).val).toMonoidHom := modelStabilizer_flag S m 0
  have h1 : (coordinates S m).modelStabilizer ((flag S m).space 1) =
      (standardParabolic S.field.Carrier 1).map
        (MulAut.conj (alignment S m).val).toMonoidHom := modelStabilizer_flag S m 1
  rw [h0, h1,
    embeddedResidual_map, embeddedResidual_map, ← Subgroup.map_sup]
  change ((solvableResidual (standardParabolic S.field.Carrier 0)).map
      (standardParabolic S.field.Carrier 0).subtype ⊔
    (solvableResidual (standardParabolic S.field.Carrier 1)).map
      (standardParabolic S.field.Carrier 1).subtype).map
        (MulAut.conj (alignment S m).val).toMonoidHom = (⊤ : Subgroup (Atlas.G2.Model S.field.Carrier))
  rw [standard_residual _ (field_card_gt_two S), standard_residual _ (field_card_gt_two S)]
  change (Atlas.G2.LieParabolicSetup.local₂ ⊔ Atlas.G2.LieParabolicSetup.local₁).map _ = ⊤
  rw [sup_comm, Atlas.G2.HigherFieldResiduals.locals_generate]
  exact map_top_of_surjective _ (MulAut.conj (alignment S m).val).surjective

/-- The literal residual image under the original quotient map. -/
theorem localResidual_image (U : Submodule S.field.Carrier (coordinates S m).Space) :
    ((localResidual L ((coordinates S m).preimage U)).subgroupOf L).map
      (coordinates S m).quotientMap =
    (solvableResidual ((coordinates S m).modelStabilizer U)).map
      ((coordinates S m).modelStabilizer U).subtype := by
  let c := coordinates S m
  ext x
  constructor
  · rintro ⟨l, hl, rfl⟩
    let r : localResidual L (c.preimage U) := ⟨l, hl⟩
    exact ⟨(c.residualProjection U r).val, (c.residualProjection U r).property,
      c.residualProjection_coe U r⟩
  · rintro ⟨y, hy, rfl⟩
    obtain ⟨r, hr⟩ := c.residualProjection_surjective U ⟨y, hy⟩
    refine ⟨⟨r, (localResidual_le _ r.property).1⟩, r.property, ?_⟩
    rw [← c.residualProjection_coe, hr]
    rfl

/-- The original component is generated by the literal L1 and L2. -/
theorem flag_Li_sup  :
    (flag S m).Li 0 ⊔ (flag S m).Li 1 = L := by
  let f := flag S m
  let c := coordinates S m
  let K := f.Li 0 ⊔ f.Li 1
  have hKL : K ≤ L := sup_le ((localResidual_le _).trans inf_le_left)
    ((localResidual_le _).trans inf_le_left)
  let R := K.subgroupOf L
  have hi : R.map c.quotientMap = ⊤ := by
    rw [show R = (f.Li 0).subgroupOf L ⊔ (f.Li 1).subgroupOf L from
      subgroupOf_sup ((localResidual_le _).trans inf_le_left)
        ((localResidual_le _).trans inf_le_left)]
    rw [Subgroup.map_sup]
    change ((localResidual L (c.preimage ((f.space 0)))).subgroupOf L).map c.quotientMap ⊔
      ((localResidual L (c.preimage ((f.space 1)))).subgroupOf L).map c.quotientMap = ⊤
    rw [localResidual_image S m, localResidual_image S m]
    exact modelResiduals_sup_eq_top S m
  have hk : c.quotientMap.ker = pCore 2 L := by
    ext l
    change c.groupEquiv (QuotientGroup.mk' (pCore 2 L) l) = 1 ↔ l ∈ pCore 2 L
    rw [map_eq_one_iff _ c.groupEquiv.injective]
    exact QuotientGroup.eq_one_iff l
  have hs : R ⊔ pCore 2 L = ⊤ := by
    rw [← hk, ← comap_map_eq, hi, comap_top]
  obtain ⟨P, hP⟩ := NormalSylowQuotientAction.intersection_sylow T L
    D.sylow_normalizes_component
  have hcoreT : pCore 2 L ≤ (T : Subgroup G).subgroupOf L :=
    hP ▸ pCore_isPGroup.le_sylow_of_normal P
  have hTK : (T : Subgroup G) ≤ normalizer (K : Set G) :=
    (le_inf (f.sylow_normalizes_Li 0) (f.sylow_normalizes_Li 1)).trans
      (normalizer_inf_normalizer_le_normalizer_sup _ _)
  have hnR : pCore 2 L ≤ normalizer (R : Set L) := by
    rw [← subgroupOf_normalizer_eq hKL]
    exact hcoreT.trans (comap_mono hTK)
  let : R.Normal := normalizer_eq_top_iff.mp
    (top_unique (hs ▸ sup_le R.le_normalizer hnR))
  let : Group.IsNilpotent (L ⧸ R) :=
    (isPGroup_quotient_of_sup_eq_top R (pCore 2 L) pCore_isPGroup hs).isNilpotent
  let : Group.IsPerfect L := Chapter1.mem_L_isPerfect S.source.maximal_faithful.1.1
  have hR : R = ⊤ := top_unique (by
    simpa only [solvableResidual_eq_top] using solvableResidual_le_of_solvable_quotient R)
  have hm := congrArg (Subgroup.map L.subtype) hR
  simpa only [R, map_subgroupOf_eq_of_le hKL, ← MonoidHom.range_eq_map, range_subtype]
    using hm

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.G2.ResidualIncidence
