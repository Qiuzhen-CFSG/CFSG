module

public import Theory.Representation.G2OrthogonalCover.ParabolicFixed
public import Theory.Representation.BinaryOffender.IrreducibleSection

/-!
# The central-cover issue in the plane assertion of 11.1.3

In the actual seven-dimensional orthogonal G₂ cover, the inverse image of
the natural plane is the singular plane plus the scalar radical. The plane
parabolic preserves both summands. Consequently its residual cannot generate
the entire preimage by commutators. This is an obstruction to inferring the
Irr⁺ assertion of 11.1.3 from natural central-quotient data alone, not a
counterexample to the full Chapter 11 ambient hypotheses.

Source: Aschbacher--Smith I.2.3(1)(c), printed p.413, and 11.1.3, p.765.
The coordinates and the local₁ convention are the existing attributed ATLAS
port: local₁ is the plane residual, whereas the source calls it L₂.
-/

@[expose] public noncomputable section
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.G2.PlaneCover
open Atlas.SplitOctonion Atlas.G2 Atlas.G2.Natural Atlas.G2.Natural.OrthogonalCover
open Atlas.G2.Explicit Atlas.G2.LieParabolicSetup
open Representation Representation.BinaryOffender Subgroup
variable (F : Type*) [Field F] [CharP F 2] [Algebra (ZMod 2) F]

/-- The whole inverse image, retaining the nonzero central scalar line. -/
def planePreimage : Submodule (ZMod 2) (TraceZero F) :=
  ((naturalPlane F).comap (mk F)).restrictScalars (ZMod 2)

private theorem singular_plane_invariant (g : Model F) (hg : g ∈ local₁)
    (x : TraceZero F) (hx : x ∈ singularPlane F) :
    traceZeroAction F g x ∈ singularPlane F := by
  have hS : local₁ (F := F) ≤ subspaceStabilizer (ParabolicFixed.fullBinaryAction F)
      ((singularPlane F).restrictScalars (ZMod 2)) := by
    apply sup_le
    · apply le_subspaceStabilizer
      intro g hg x hx
      rw [unipotent_eq_range] at hg
      obtain ⟨t,rfl⟩ := hg
      obtain ⟨v,rfl⟩ := hx
      exact ⟨_,(SylowFlag.unipotent_plane F t v).symm⟩
    · apply (closure_le _).mpr
      rintro g (rfl : g = weylS)
      have hs (x : TraceZero F) (hx : x ∈ singularPlane F) :
          traceZeroAction F weylS x ∈ singularPlane F := by
        obtain ⟨v,rfl⟩ := hx
        refine ⟨![v 1,v 0],?_⟩
        apply Subtype.ext
        ext i
        fin_cases i <;>
          simp [traceZeroAction_val,planeLift,weylS,weylSEquiv,weylSLinear,weylSApply,
            CharTwo.neg_eq]
      intro x
      constructor
      · intro hx
        have hh := hs _ hx
        change traceZeroAction F weylS (traceZeroAction F weylS x) ∈ singularPlane F at hh
        change x ∈ singularPlane F
        have hw : (weylS : Model F) * weylS = 1 := by
          simpa [pow_two] using (weylS_sq (K := F))
        rw [← Module.End.mul_apply, ← map_mul, hw, map_one] at hh
        exact hh
      · exact hs x
  exact ((hS hg) x).mpr hx

/-- Every residual displacement is in the complementary singular plane. -/
theorem commutator_le_singularPlane :
    subspaceCommutator (ParabolicFixed.fullBinaryAction F) (planePreimage F) local₁ ≤
      (singularPlane F).restrictScalars (ZMod 2) := by
  apply Submodule.span_le.mpr
  rintro _ ⟨g,hg,w,hw,rfl⟩
  change w ∈ (naturalPlane F).comap (mk F) at hw
  rw [naturalPlane_preimage] at hw
  obtain ⟨c,hc,z,hz,rfl⟩ := Submodule.mem_sup.mp hw
  have hzfix : traceZeroAction F g z = z := by
    obtain ⟨a,rfl⟩ := Submodule.mem_span_singleton.mp hz
    rw [map_smul,traceZeroAction_identity]
  change traceZeroAction F g (c+z) - (c+z) ∈ singularPlane F
  rw [map_add,hzfix,add_sub_add_right_eq_sub]
  exact (singularPlane F).sub_mem (singular_plane_invariant F g hg c hc) hc

/-- The retained scalar vector belongs to the literal plane preimage. -/
theorem identity_mem_planePreimage : identity F ∈ planePreimage F := by
  change identity F ∈ (naturalPlane F).comap (mk F)
  rw [naturalPlane_preimage]
  exact (le_sup_right : scalarLine F ≤ singularPlane F ⊔ scalarLine F)
    (Submodule.mem_span_singleton_self _)

/-- The nonzero scalar radical cannot be generated by these commutators. -/
theorem identity_not_mem_commutator :
    identity F ∉ subspaceCommutator (ParabolicFixed.fullBinaryAction F)
      (planePreimage F) local₁ := by
  intro h
  have hz : identity F = 0 := Submodule.disjoint_def.mp (singularPlane_disjoint_scalar F)
    _ (commutator_le_singularPlane F h) (Submodule.mem_span_singleton_self _)
  exact unit_ne_zero (congrArg Subtype.val hz)

/-- Full commutator generation fails in this genuine central natural cover. -/
theorem commutator_ne_planePreimage :
    subspaceCommutator (ParabolicFixed.fullBinaryAction F) (planePreimage F) local₁ ≠
      planePreimage F := by
  intro h
  exact identity_not_mem_commutator F (h.symm ▸ identity_mem_planePreimage F)

/-- Thus the whole preimage is not Irr⁺; a source application needs an additional
ambient argument or a different local-module route. -/
theorem not_isIrrPlus_planePreimage :
    ¬ IsIrrPlus (ParabolicFixed.fullBinaryAction F) local₁ (planePreimage F) := by
  rintro ⟨_,h,_⟩
  exact commutator_ne_planePreimage F h

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.G2.PlaneCover
