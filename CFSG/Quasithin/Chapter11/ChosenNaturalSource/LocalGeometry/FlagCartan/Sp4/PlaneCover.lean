module
public import Theory.Representation.SymplecticFourOrthogonalCover.SylowFlag.Geometry
public import Theory.Representation.BinaryOffender.IrreducibleSection

/-!
# The plane preimage in the nonsplit orthogonal cover

The inverse image of the standard natural plane contains the central radical.
Every element of the plane parabolic has zero quadratic correction on this
plane. Its commutators therefore have zero central coordinate, so the whole
preimage is not generated by its commutators and cannot satisfy IsIrrPlus.

This is an obstruction to deriving the proposed local IrrPlus input from a
natural central cover alone. It does not refute the full ambient statement
11.1.3. That source application must supply further ambient information or
use a different uniqueness argument; it cannot silently discard the radical.

Source comparison: Aschbacher--Smith, A.1.40, I.2.3(1), opening section 11.1
and 11.1.3, printed pp.31, 413, 760--761, 765.
-/

@[expose] public noncomputable section
open Subgroup Representation Representation.BinaryOffender
open Theory.SpecificGroups.SymplecticFour
open Representation.OneCohomology.SymplecticFour
open Representation.SymplecticFourOrthogonalCover
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.Sp4.PlaneCover
variable {K : Type*} [Field K] [Finite K] [CharP K 2] [Algebra (ZMod 2) K]

def preimagePlane : Submodule (ZMod 2) (Space (K := K)) :=
  ((plane K).comap (LinearMap.fst K (Natural (K := K)) K)).restrictScalars (ZMod 2)

theorem displacement_snd_zero (g : Sp K) (hg : g ∈ planeParabolic)
    (x : Space (K := K)) (hx : x ∈ preimagePlane) :
    (fullAction g x - x).2 = 0 := by
  have hv : x.1 ∈ plane K := hx
  have hgv : g • x.1 ∈ plane K := (mem_stabilizer_iff (plane K) g).mp hg x.1 hv
  have hq (v : Natural (K := K)) (hv : v ∈ plane K) : rowQuadratic v = 0 := by
    simp [rowQuadratic, hv 0, hv 1]
  have he := correction_square g x.1
  rw [← Theory.SpecificGroups.SymplecticFour.smul_eq_mulVec, hq _ hv, hq _ hgv,
    zero_add] at he
  have hc : correction g x.1 = 0 :=
    (pow_eq_zero_iff (by decide : (2 : ℕ) ≠ 0)).mp he.symm
  change x.2 + correction g x.1 - x.2 = 0
  simp only [hc, add_zero, sub_self]

theorem preimagePlane_not_fully_moved (B : Subgroup (Sp K)) (hB : B ≤ planeParabolic) :
    subspaceCommutator (restrictScalars (k := ZMod 2) fullAction) preimagePlane B ≠
      preimagePlane := by
  have hle : subspaceCommutator (restrictScalars (k := ZMod 2) fullAction) preimagePlane B ≤
      (LinearMap.snd (ZMod 2) (Natural (K := K)) K).ker := by
    apply Submodule.span_le.mpr
    rintro _ ⟨g,hg,x,hx,rfl⟩
    exact displacement_snd_zero g (hB hg) x hx
  intro he
  have hz : ((0 : Natural (K := K)), (1 : K)) ∈ preimagePlane := (plane K).zero_mem
  have hz0 : (1 : K) = 0 := hle (he.symm ▸ hz)
  exact one_ne_zero hz0

theorem preimagePlane_not_irrPlus (B : Subgroup (Sp K)) (hB : B ≤ planeParabolic) :
    ¬ IsIrrPlus (restrictScalars (k := ZMod 2) fullAction) B preimagePlane := by
  rintro ⟨_,hm,_⟩
  exact preimagePlane_not_fully_moved B hB hm

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.Sp4.PlaneCover
