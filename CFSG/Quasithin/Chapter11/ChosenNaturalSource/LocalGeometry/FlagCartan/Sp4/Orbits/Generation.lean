module
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.FlagCartan.Sp4.Orbits.Incidence
public import Theory.SpecificGroups.SymplecticFour.SimpleQuotients
public import Theory.SpecificGroups.SymplecticFour.EvenProjective
public import Theory.SpecificGroups.SymplecticFour.RootSubgroup

/-!
# Generation by the residuals of the original symplectic plane orbit

The point residual permutes the plane orbit, hence normalizes the subgroup
K generated by its attached residuals. The plane residual belongs to K.
Since these two locals generate L, K is normal in L. Its image in the
simple nonbinary symplectic group contains a nonidentity root element,
so it is the whole group. The quotient L/K is then a two-group and
perfectness of L makes it trivial.

The final theorem applies this generation identity to the original plane
permutation consumer. Only the preceding source component uniqueness
input remains explicit; its producer is qt-d-1222-natural-relative-components.

Source: Aschbacher--Smith, opening §11.1 and 11.1.3--4, pp.760--761,765.
-/

set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
open Subgroup Representation
open CFSG.Quasithin.Chapter12.Section02
open CFSG.Quasithin.ChapterB.QuasisimpleSource
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.Sp4.Orbits
open Theory.SpecificGroups.SymplecticFour
open Representation.OneCohomology.SymplecticFour

private theorem embeddedResidual_conjugate {G : Type*} [Group G] [Finite G]
    (e : G ≃* G) (H : Subgroup G) :
    ((solvableResidual H).map H.subtype).map e.toMonoidHom =
      (solvableResidual (H.map e.toMonoidHom)).map (H.map e.toMonoidHom).subtype := by
  have he := congrArg (map (H.map e.toMonoidHom).subtype)
    (map_solvableResidual_eq (e.subgroupMap H).toMonoidHom (e.subgroupMap H).surjective)
  rw [map_map] at he ⊢
  exact he

private theorem localResidual_conjugate {G : Type*} [Group G] [Finite G]
    (e : G ≃* G) (L U : Subgroup G) :
    (localResidual L U).map e.toMonoidHom =
      localResidual (L.map e.toMonoidHom) (U.map e.toMonoidHom) := by
  unfold localResidual
  rw [embeddedResidual_conjugate, map_inf _ _ _ e.injective, map_equiv_normalizer_eq]

private theorem orbit_conjugate {G : Type*} [Group G] (V₂ A : Subgroup G)
    (a : A) {U : Subgroup G} (hU : U ∈ Normalizers.planeOrbit V₂ A) :
    U.map (MulAut.conj (a : G)).toMonoidHom ∈ Normalizers.planeOrbit V₂ A := by
  obtain ⟨b,rfl⟩ := hU
  refine ⟨a*b, ?_⟩
  rw [map_map]
  congr 1
  ext x
  change (a : G) * ((b : G) * x * (b : G)⁻¹) * (a : G)⁻¹ =
    ((a : G)*(b : G)) * x * ((a : G)*(b : G))⁻¹
  group

private theorem orbitResiduals_normalized {G : Type*} [Group G] [Finite G]
    (L V₂ A : Subgroup G) (hAL : A ≤ L) :
    A ≤ normalizer (((⨆ U : Normalizers.planeOrbit V₂ A, localResidual L U.val) : Subgroup G) : Set G) := by
  intro a ha
  apply mem_normalizer_iff_map_conj_eq.mpr
  apply eq_of_le_of_card_ge
  · rw [Subgroup.map_iSup]
    apply iSup_le
    intro U
    change (localResidual L U.val).map (MulAut.conj a).toMonoidHom ≤ _
    have hn : L.map (MulAut.conj a).toMonoidHom = L :=
      mem_normalizer_iff_map_conj_eq.mp (L.le_normalizer (hAL ha))
    rw [localResidual_conjugate, hn]
    exact le_iSup_of_le ⟨_, orbit_conjugate V₂ A ⟨a,ha⟩ U.property⟩ le_rfl
  · exact (card_map_of_injective (MulAut.conj a).injective).ge

variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    {D : ChosenModule T L V} (S : D.NonbinaryNaturalInput)
    (m : ActionEquiv D.centralQuotientAction
      (restrictScalars (k := ZMod 2) (symplecticNatural (k := S.field.Carrier) 2)))

/-- The residuals attached to the actual plane orbit generate the entire L. -/
theorem planeOrbit_residuals_generate :
    L = ⨆ U : planeOrbit S m, localResidual L U.val := by
  let f := flag m S
  let K := ⨆ U : planeOrbit S m, localResidual L U.val
  have hKL : K ≤ L := iSup_le fun U => (localResidual_le _).trans inf_le_left
  have hbase : f.Vi 1 ∈ planeOrbit S m := by
    refine ⟨1, ?_⟩
    ext x
    simp [f]
  have hB : f.Li 1 ≤ K := le_iSup_of_le ⟨_,hbase⟩ le_rfl
  have hAK : f.Li 0 ≤ normalizer (K : Set G) :=
    orbitResiduals_normalized L (f.Vi 1) (f.Li 0) ((localResidual_le _).trans inf_le_left)
  have hLK : L ≤ normalizer (K : Set G) := by
    rw [← flag_Li_sup m S S.nonbinary]
    exact sup_le hAK (hB.trans K.le_normalizer)
  let R := K.subgroupOf L
  let : R.Normal := normal_subgroupOf_of_le_normalizer hLK
  let q : L →* Sp S.field.Carrier := (Coordinates.sp4 m).quotientMap
  have hq : Function.Surjective q := (Coordinates.sp4 m).quotientMap_surjective
  let : (R.map q).Normal := (inferInstance : R.Normal).map q hq
  have hcard : 3 < Nat.card S.field.Carrier := by
    rw [S.field.card_eq]
    exact lt_of_lt_of_le (by decide : 3 < 2 ^ 2)
      (Nat.pow_le_pow_right (by decide) S.nonbinary)
  let := SimpleQuotients.isSimpleGroup hcard
  let : IsSimpleGroup (Sp S.field.Carrier) := EvenProjective.equiv.isSimpleGroup
  have hi : R.map q = ⊤ := by
    rcases (inferInstance : (R.map q).Normal).eq_bot_or_eq_top with hb | ht
    · have hy : rootElement 0 (1 : S.field.Carrier) ∈ planeLocal :=
        (positive_root_mem_unipotent 0 1 (by simp)).2
      obtain ⟨r,hr⟩ := PlaneAction.localProjection_surjective S m 1 ⟨_,hy⟩
      have hqr : q ⟨r.val,(localResidual_le _ r.property).1⟩ = 1 := by
        apply mem_bot.mp
        rw [← hb]
        exact mem_map_of_mem q (hB r.property)
      have hc := PlaneAction.localProjection_coe S m 1 r
      rw [hr] at hc
      change rootElement 0 (1 : S.field.Carrier) =
        (alignment m)⁻¹ * q ⟨r.val,(localResidual_le _ r.property).1⟩ * (alignment m) at hc
      rw [hqr, mul_one, inv_mul_cancel] at hc
      exact (one_ne_zero (RootSubgroup.element_injective 0
        (hc.trans (RootSubgroup.element_zero 0).symm))).elim
    · exact ht
  have hk : q.ker = pCore 2 L := by
    ext l
    change (Coordinates.sp4 m).groupEquiv (QuotientGroup.mk' (pCore 2 L) l) = 1 ↔ _
    rw [map_eq_one_iff _ (Coordinates.sp4 m).groupEquiv.injective]
    exact QuotientGroup.eq_one_iff l
  have hs : R ⊔ pCore 2 L = ⊤ := by
    rw [← hk, ← comap_map_eq, hi, comap_top]
  let : Group.IsNilpotent (L ⧸ R) :=
    (isPGroup_quotient_of_sup_eq_top R (pCore 2 L) pCore_isPGroup hs).isNilpotent
  let : Group.IsPerfect L := Chapter1.mem_L_isPerfect S.source.maximal_faithful.1.1
  have hR : R = ⊤ := top_unique (by
    simpa only [solvableResidual_eq_top] using solvableResidual_le_of_solvable_quotient R)
  have hm := congrArg (Subgroup.map L.subtype) hR
  simpa only [R, map_subgroupOf_eq_of_le hKL, ← MonoidHom.range_eq_map, range_subtype]
    using hm.symm

/-- Literal application to the plane-permutation consumer. Component uniqueness
is the independent source 11.1.3 input and remains explicit. -/
theorem normalizes_of_plane_permutation
    (hunique : Source.UniqueNoncentralComponent
      (normalizer ((flag m S).Vi 1 : Set G)) ((flag m S).Vi 1) ((flag m S).Li 1))
    {g : G} (hg : ∀ U ∈ planeOrbit S m, U.map (MulAut.conj g).toMonoidHom ∈ planeOrbit S m) :
    g ∈ normalizer (L : Set G) :=
  Normalizers.normalizes_of_plane_permutation
    (Normalizers.orbit_unique ((localResidual_le _).trans inf_le_left) hunique)
    (planeOrbit_residuals_generate S m) hg

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.Sp4.Orbits
