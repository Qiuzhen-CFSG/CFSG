module
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.FlagCartan.Sp4.RadicalAction.Image
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.WeakClosure.Nonnormalization.RootParabolic.Cover

/-!
# The complete original Sp₄ radical commutator

The orthogonal-cover root theorem puts the entire original central kernel
in [V,R₂]: the published alignment carries every root actor into the actual
radical image, and the full-action equation turns its coinvariants into
original group commutators. A symmetric shear then realizes every vector
of the quotient plane as a displacement. Combining the two calculations
gives [V,R₂]=V₂ on the whole nonsplit cover.

The preceding image module supplies C_V(R₂)=V₂, C_T(V₂)=R₂ and the actual
subgroup application for A≤R₂ used in 11.2.4. No central complement or
extra radical-action assumption is used.

Source: Aschbacher--Smith, I.2.3(1b), printed p.413, and 11.2.4,
printed pp.769--770.
-/

@[expose] public noncomputable section
set_option backward.isDefEq.respectTransparency false
open Subgroup Representation Matrix
open scoped MatrixGroups IsMulCommutative commutatorElement
open Theory.SpecificGroups.SymplecticFour
open SymplecticConjugatePair.Ambient SymplecticConjugatePair.Ambient.Normalizer
open SymplecticNaturalNormalizer
open CFSG.Quasithin.Chapter12.Section02
open CFSG.Quasithin.ChapterB.QuasisimpleSource
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.Sp4.RadicalAction
open PlaneAction
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    {D : ChosenModule T L V} (S : D.NonbinaryNaturalInput)
    (m : ActionEquiv D.centralQuotientAction
      (restrictScalars (k := ZMod 2) (symplecticNatural (k := S.field.Carrier) 2)))

open WeakClosure.Nonnormalization.RootParabolic
open Representation.OneCohomology
open Representation.OneCohomology.SymplecticFour
namespace Cover
open SymplecticFourOrthogonalCover

private def rootAlignment : SymplecticFourOrthogonalCover.L (K := S.field.Carrier) :=
  ⟨alignment m, by rw [LargeField.commutator_eq_top (field_card_gt_two S)]; trivial⟩

private theorem root_image_mem (q : SymplecticFourOrthogonalCover.L (K := S.field.Carrier))
    (hq : q ∈ Roots.conjugateGroup (rootAlignment S m)) :
    q.val ∈ (radicalMap S m).range := by
  obtain ⟨r,hr,rfl⟩ := hq
  obtain ⟨t,rfl⟩ := (Roots.mem_group (field_card_gt_two S) r).mp hr
  rw [radicalMap_range]
  apply mem_map_of_mem
  apply Model.mem_planeRadical_of_fixes
  intro v hv
  change (rootElement 0 t).val *ᵥ v = v
  rw [Roots.natural_root]
  have hv0 : v (.inr 0) = 0 := hv 0
  rw [hv0,mul_zero,zero_smul,add_zero]

/-- The nonsplit central kernel is generated by actual radical displacements. -/
theorem central_le_commutator :
    V ⊓ centralizer (L : Set G) ≤ ⁅V,(flag m S).Ri 1⁆ := by
  let C : Submodule (ZMod 2) D.space := AddSubgroup.toZModSubmodule 2
    (AddSubgroup.toSubgroup.symm ((⁅(flag m S).Ri 1,V⁆).comap
      (V.subtype.comp D.spaceEquiv.toMonoidHom)))
  have hC : Coinvariants.ker ((sp4CoverAction D S m).comp
      (Roots.conjugateGroup (rootAlignment S m)).subtype) ≤ C := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨q,x⟩,rfl⟩
    obtain ⟨r,hr⟩ := root_image_mem S m q.val q.property
    change (D.spaceEquiv (Multiplicative.ofAdd
      (sp4CoverAction D S m q.val x-x)) : G) ∈ ⁅(flag m S).Ri 1,V⁆
    rw [ofAdd_sub,div_eq_mul_inv,map_mul,map_inv]
    have he := congrArg Subtype.val (radicalMap_fullAction S m r x)
    rw [hr] at he
    change (D.spaceEquiv (Multiplicative.ofAdd (sp4CoverAction D S m q.val x)) : G) =
      r.val * (D.spaceEquiv (Multiplicative.ofAdd x) : G) * r.val⁻¹ at he
    simp only [Subgroup.coe_mul,Subgroup.coe_inv]
    rw [he]
    exact commutator_mem_commutator r.property (D.spaceEquiv (Multiplicative.ofAdd x)).property
  have hg := (Roots.cover_conjugate_root_geometry (field_card_gt_two S)
    (rootAlignment S m) (sp4CoverProjection D S m)
    (sp4CoverProjection_isCover D S m)).2.1
  rw [←hg] at hC
  intro v hv
  let v' : V := ⟨v,hv.1⟩
  let w : D.space := (D.spaceEquiv.symm v').toAdd
  have hw : w ∈ ((Roots.conjugateLine (rootAlignment S m)).restrictScalars
      (ZMod 2)).comap (sp4CoverProjection D S m).toLinearMap := by
    have hv0 : (v' : G) ∈ (Coordinates.sp4 m).preimage ⊥ := by
      rw [Coordinates.preimage_bot]; exact hv
    have hzero := ((Coordinates.sp4 m).mem_preimage ⊥ v').mp hv0
    change sp4CoverProjection D S m w ∈ Roots.conjugateLine (rootAlignment S m)
    exact (show sp4CoverProjection D S m w = 0 from hzero) ▸
      (Roots.conjugateLine (rootAlignment S m)).zero_mem
  have hc := hC hw
  change (D.spaceEquiv (D.spaceEquiv.symm v') : G) ∈ ⁅(flag m S).Ri 1,V⁆ at hc
  rw [D.spaceEquiv.apply_symm_apply,commutator_comm] at hc
  exact hc

end Cover

namespace Model
variable {F : Type*} [Field F]

private theorem plane_displacement (u : Vector F) (hu : u ∈ plane F) :
    ∃ q : Sp F, q ∈ Plane.radical.map planeLocal.subtype ∧
      ∃ x : Vector F, q • x-x=u := by
  let B : Plane.symmetricMatrices F := ⟨1,Matrix.isSymm_one⟩
  let x : Vector F := Sum.elim (fun _ => 0) (fun i => u (.inl i))
  refine ⟨Plane.shearSp B,⟨Plane.shear B,Plane.quotientMap_shear B,rfl⟩,x,?_⟩
  rw [Theory.SpecificGroups.SymplecticFour.smul_eq_mulVec]
  have hu' (i : Fin 2) : u (.inr i) = 0 := hu i
  ext i
  rcases i with i | i
  · fin_cases i <;> simp [Plane.shearSp,B,x,Matrix.mulVec,dotProduct,Fintype.sum_sum_type,Matrix.fromBlocks]
  · fin_cases i <;> simp [Plane.shearSp,B,x,Matrix.mulVec,dotProduct,Fintype.sum_sum_type,Matrix.fromBlocks,hu']


end Model
/-- The literal original radical displacement, written as a vector of V. -/
def vectorCommutator (r : (flag m S).Ri 1) (v : V) : V :=
  V.normalizerMonoidHom (inclusion (ambientJoin_normalizes_seed S)
    (radicalInclusion S m r)) v * v⁻¹

theorem vectorCommutator_coe (r : (flag m S).Ri 1) (v : V) :
    (vectorCommutator S m r v : G) = ⁅(r : G),(v : G)⁆ := rfl

theorem vectorCommutator_projection (r : (flag m S).Ri 1) (v : V) :
    ((Coordinates.sp4 m).projection (vectorCommutator S m r v)).toAdd =
      radicalMap S m r • (show Vector S.field.Carrier from ((Coordinates.sp4 m).projection v).toAdd) -
        (show Vector S.field.Carrier from ((Coordinates.sp4 m).projection v).toAdd) := by
  rw [vectorCommutator,map_mul,map_inv]
  simp only [toAdd_mul,toAdd_inv,←sub_eq_add_neg]
  rw [radicalMap_apply]
  exact congrArg (fun x : Vector S.field.Carrier =>
    x - (show Vector S.field.Carrier from ((Coordinates.sp4 m).projection v).toAdd))
    ((Coordinates.sp4 m).conjugationAction_projection _ _ _ v).symm

/-- The whole original plane, including its nonsplit central kernel,
is the commutator with the original local radical. -/
theorem commutator_eq_plane : ⁅V,(flag m S).Ri 1⁆ = (flag m S).Vi 1 := by
  apply le_antisymm (commutator_le_plane S m)
  intro w hw
  let w' : V := ⟨w,D.centralQuotientPreimage_le _ hw⟩
  let u : Vector S.field.Carrier := ((Coordinates.sp4 m).projection w').toAdd
  have hu : (alignment m)⁻¹ • u ∈ plane S.field.Carrier := by
    have h := ((Coordinates.sp4 m).mem_preimage _ w').mp hw
    exact (ModelFlag.mem_movedStage _ _ _).mp h
  obtain ⟨q,hq,x,hx⟩ := Model.plane_displacement _ hu
  rw [←alignedRadicalMap_range S m] at hq
  obtain ⟨r,hr⟩ := hq
  obtain ⟨v,hv⟩ := (Coordinates.sp4 m).projection_surjective
    (Multiplicative.ofAdd ((alignment m) • x))
  have hd : ((Coordinates.sp4 m).projection (vectorCommutator S m r v)).toAdd = u := by
    rw [vectorCommutator_projection,hv]
    change (alignment m * alignedRadicalMap S m r * (alignment m)⁻¹) •
      ((alignment m) • x) - (alignment m) • x = u
    rw [hr,mul_smul,mul_smul,inv_smul_smul]
    change toLinear (alignment m) (q • x) - toLinear (alignment m) x = u
    rw [←map_sub,hx]
    exact smul_inv_smul (alignment m) u
  have hk : (w' * (vectorCommutator S m r v)⁻¹ : V) ∈
      (Coordinates.sp4 m).projection.ker := by
    change (Coordinates.sp4 m).projection (w' * (vectorCommutator S m r v)⁻¹) = 1
    rw [map_mul,map_inv]
    exact mul_inv_eq_one.mpr (Multiplicative.toAdd.injective hd.symm)
  have hk' : ((w' * (vectorCommutator S m r v)⁻¹ : V) : G) ∈
      V ⊓ centralizer (L : Set G) := by
    refine ⟨(w' * (vectorCommutator S m r v)⁻¹).property,?_⟩
    exact ((Coordinates.sp4 m).projection_eq_one_iff _).mp hk
  have hc : (vectorCommutator S m r v : G) ∈ ⁅V,(flag m S).Ri 1⁆ := by
    rw [vectorCommutator_coe,commutator_comm V]
    exact commutator_mem_commutator r.property v.property
  have he := (⁅V,(flag m S).Ri 1⁆).mul_mem (Cover.central_le_commutator S m hk') hc
  simpa only [Subgroup.coe_mul,Subgroup.coe_inv,inv_mul_cancel_right] using he

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.Sp4.RadicalAction
