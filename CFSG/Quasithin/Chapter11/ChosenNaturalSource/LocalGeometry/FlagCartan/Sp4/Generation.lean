module
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.FlagCartan.Sp4.Residuals

/-!
# Generation by the two literal marked symplectic residuals

The model parabolic residuals generate Sp4. Their original lifts generate L
modulo O2(L); the core normalizes both lifts because it lies in T intersect L.
Their join is therefore normal with a two-group quotient. Source perfectness
of L makes this quotient trivial.

Source: Aschbacher--Smith, opening section 11.1, pp.760--761.
-/

@[expose] public noncomputable section
set_option backward.isDefEq.respectTransparency false
open Subgroup Representation
open Theory.SpecificGroups.SymplecticFour
open CFSG.Quasithin.Chapter12.Section02
open CFSG.Quasithin.ChapterB.QuasisimpleSource
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.Sp4

private theorem embeddedResidual_map {A : Type*} [Group A] [Finite A]
    (e : A ≃* A) (H : Subgroup A) :
    (solvableResidual (H.map e.toMonoidHom)).map (H.map e.toMonoidHom).subtype =
      ((solvableResidual H).map H.subtype).map e.toMonoidHom := by
  have hc : (H.map e.toMonoidHom).comap e.toMonoidHom = H := by
    rw [comap_map_eq, e.toMonoidHom.ker_eq_bot e.injective, sup_bot_eq]
  have h := map_solvableResidual_comap e.toMonoidHom e.surjective (H.map e.toMonoidHom)
  rw [hc] at h
  exact h.symm

variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    {D : ChosenModule T L V} {F : BinaryField}
    (m : ActionEquiv D.centralQuotientAction
      (restrictScalars (k := ZMod 2) (symplecticNatural (k := F.Carrier) 2)))

/-- The two model residuals generate the actual marked symplectic group. -/
theorem modelResiduals_sup_eq_top (hn : 1 < F.degree) :
    (solvableResidual ((Coordinates.sp4 m).modelStabilizer (space m 1))).map
      ((Coordinates.sp4 m).modelStabilizer (space m 1)).subtype ⊔
    (solvableResidual ((Coordinates.sp4 m).modelStabilizer (space m 2))).map
      ((Coordinates.sp4 m).modelStabilizer (space m 2)).subtype = ⊤ := by
  have h0 : (Coordinates.sp4 m).modelStabilizer (space m 1) =
      (pointParabolic (F := F.Carrier)).map (MulAut.conj (alignment m)).toMonoidHom :=
    modelStabilizer_space m 0
  have h1 : (Coordinates.sp4 m).modelStabilizer (space m 2) =
      (planeParabolic (F := F.Carrier)).map (MulAut.conj (alignment m)).toMonoidHom :=
    modelStabilizer_space m 1
  rw [h0, h1,
    embeddedResidual_map, embeddedResidual_map, ← Subgroup.map_sup]
  change ((solvableResidual (pointParabolic (F := F.Carrier))).map pointParabolic.subtype ⊔
    (solvableResidual (planeParabolic (F := F.Carrier))).map planeParabolic.subtype).map _ = ⊤
  rw [parabolicResiduals_sup_eq_top F.card_eq hn]
  exact map_top_of_surjective _ (MulAut.conj (alignment m)).surjective

/-- The literal residual image under the original quotient map. -/
theorem localResidual_image (U : Submodule F.Carrier (Coordinates.sp4 m).Space) :
    ((localResidual L ((Coordinates.sp4 m).preimage U)).subgroupOf L).map
      (Coordinates.sp4 m).quotientMap =
    (solvableResidual ((Coordinates.sp4 m).modelStabilizer U)).map
      ((Coordinates.sp4 m).modelStabilizer U).subtype := by
  let c := Coordinates.sp4 m
  ext x
  constructor
  · rintro ⟨l, hl, rfl⟩
    let r : localResidual L (c.preimage U) := ⟨l, hl⟩
    exact ⟨(c.residualProjection U r).val, (c.residualProjection U r).property,
      c.residualProjection_coe U r⟩
  · rintro ⟨y, hy, rfl⟩
    obtain ⟨r, hr⟩ := c.residualProjection_surjective U ⟨y, hy⟩
    refine ⟨⟨r, (localResidual_le _ r.property).1⟩, r.property, ?_⟩
    rw [← c.residualProjection_coe, hr]
    rfl

/-- The original component is generated by the literal L1 and L2. -/
theorem flag_Li_sup (S : D.NonbinaryNaturalInput) (hn : 1 < F.degree) :
    (flag m S).Li 0 ⊔ (flag m S).Li 1 = L := by
  let f := flag m S
  let c := Coordinates.sp4 m
  let K := f.Li 0 ⊔ f.Li 1
  have hKL : K ≤ L := sup_le ((localResidual_le _).trans inf_le_left)
    ((localResidual_le _).trans inf_le_left)
  let R := K.subgroupOf L
  have hi : R.map c.quotientMap = ⊤ := by
    rw [show R = (f.Li 0).subgroupOf L ⊔ (f.Li 1).subgroupOf L from
      subgroupOf_sup ((localResidual_le _).trans inf_le_left)
        ((localResidual_le _).trans inf_le_left)]
    rw [Subgroup.map_sup]
    change ((localResidual L (c.preimage (space m 1))).subgroupOf L).map c.quotientMap ⊔
      ((localResidual L (c.preimage (space m 2))).subgroupOf L).map c.quotientMap = ⊤
    rw [localResidual_image, localResidual_image]
    exact modelResiduals_sup_eq_top m hn
  have hk : c.quotientMap.ker = pCore 2 L := by
    ext l
    change c.groupEquiv (QuotientGroup.mk' (pCore 2 L) l) = 1 ↔ l ∈ pCore 2 L
    rw [map_eq_one_iff _ c.groupEquiv.injective]
    exact QuotientGroup.eq_one_iff l
  have hs : R ⊔ pCore 2 L = ⊤ := by
    rw [← hk, ← comap_map_eq, hi, comap_top]
  obtain ⟨P, hP⟩ := NormalSylowQuotientAction.intersection_sylow T L
    D.sylow_normalizes_component
  have hcoreT : pCore 2 L ≤ (T : Subgroup G).subgroupOf L :=
    hP ▸ pCore_isPGroup.le_sylow_of_normal P
  have hTK : (T : Subgroup G) ≤ normalizer (K : Set G) :=
    (le_inf (f.sylow_normalizes_Li 0) (f.sylow_normalizes_Li 1)).trans
      (normalizer_inf_normalizer_le_normalizer_sup _ _)
  have hnR : pCore 2 L ≤ normalizer (R : Set L) := by
    rw [← subgroupOf_normalizer_eq hKL]
    exact hcoreT.trans (comap_mono hTK)
  let : R.Normal := normalizer_eq_top_iff.mp
    (top_unique (hs ▸ sup_le R.le_normalizer hnR))
  let : Group.IsNilpotent (L ⧸ R) :=
    (isPGroup_quotient_of_sup_eq_top R (pCore 2 L) pCore_isPGroup hs).isNilpotent
  let : Group.IsPerfect L := Chapter1.mem_L_isPerfect S.source.maximal_faithful.1.1
  have hR : R = ⊤ := top_unique (by
    simpa only [solvableResidual_eq_top] using solvableResidual_le_of_solvable_quotient R)
  have hm := congrArg (Subgroup.map L.subtype) hR
  simpa only [R, map_subgroupOf_eq_of_le hKL, ← MonoidHom.range_eq_map, range_subtype]
    using hm

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.Sp4
