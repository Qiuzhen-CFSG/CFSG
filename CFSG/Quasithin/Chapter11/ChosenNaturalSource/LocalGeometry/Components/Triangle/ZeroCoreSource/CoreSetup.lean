module
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.FlagCartan.CartanGeometry.Torus
public import Theory.GroupTheory.PCoreImage

/-!
# The original triangle overlap and its two-core

Keep the original Cartan X and put S₀ = O₂(XT). The normalizer
N = N_L(T ∩ L) is T-invariant, and its two-core complements X. Since
O₂(N) lies in S₀, the actual overlap S₀X equals S₀N and is T-invariant.
Consequently T normalizes the group H generated by K₀S₀X and L₂S₀X.
Its embedded two-core lies in T and is normalized by both original locals.

This supplies the nonzero-core branch and the precise zero-core reduction.
It does not supply the marked chief-section contradiction needed to exclude
that remaining branch.

Source: Aschbacher--Smith, combined manuscript, 1 March 2004,
11.1.2, printed p.762, the paragraph beginning “Set S := O₂(XT)”.
-/

open Subgroup Theory.GroupTheory
open CFSG.Quasithin.Chapter12.Section02
open CFSG.Quasithin.ChapterB.QuasisimpleSource
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.Components.Triangle.ZeroCoreSource
@[expose] public noncomputable section
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    {D : ChosenModule T L V} {F : BinaryField}

/-- The source subgroup S₀ = O₂(XT), embedded in the original ambient group. -/
def commonTwo (T : Sylow 2 G) (X : Subgroup G) : Subgroup G :=
  (X ⊔ (T : Subgroup G)).pCoreIn 2

/-- The literal source overlap S₀X. -/
def overlap (T : Sylow 2 G) (X : Subgroup G) : Subgroup G := commonTwo T X ⊔ X

/-- The two source endpoints K₀S₀X and L₂S₀X. -/
def endpoint (T : Sylow 2 G) (X B : Subgroup G) : Subgroup G := B ⊔ overlap T X

/-- The literal source group H generated by those endpoints. -/
def completion (T : Sylow 2 G) (X K₀ L₂ : Subgroup G) : Subgroup G :=
  endpoint T X K₀ ⊔ endpoint T X L₂

omit [Finite G] in
theorem commonTwo_le_sylow (X : Subgroup G) : commonTwo T X ≤ T := by
  simpa only [commonTwo, Sylow.coe_subtype, map_subgroupOf_eq_of_le le_sup_right] using
    pCoreIn_le_sylow (X ⊔ (T : Subgroup G)) (T.subtype le_sup_right)

omit [Finite G] in
theorem sylow_normalizes_commonTwo (X : Subgroup G) :
    (T : Subgroup G) ≤ normalizer (commonTwo T X : Set G) :=
  (le_sup_right : (T : Subgroup G) ≤ X ⊔ (T : Subgroup G)).trans
    ((X ⊔ (T : Subgroup G)).le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image _ (pCore 2 _)))

omit [Finite G] in
theorem sylow_normalizes_cartanNormalizer (D : ChosenModule T L V) :
    (T : Subgroup G) ≤ normalizer (cartanNormalizer T L : Set G) := by
  rw [cartanNormalizer_eq_intersection_normalizer]
  exact (le_inf D.sylow_normalizes_component
    (((le_inf (T : Subgroup G).le_normalizer D.sylow_normalizes_component).trans
      inf_normalizer_le_normalizer_inf).trans (normalizer _).le_normalizer)).trans
    inf_normalizer_le_normalizer_inf

/-- The normalizer's odd Hall complement is the actual Cartan X. -/
theorem cartanNormalizer_eq_core_sup (c : Coordinates D F)
    {X : Subgroup G} (hX : IsCartan T L X) :
    cartanNormalizer T L = (cartanNormalizer T L).pCoreIn 2 ⊔ X := by
  let N := cartanNormalizer T L
  let P : Sylow 2 N :=
    pCore_isPGroup.toSylow c.cartanNormalizer_core_odd_index.not_two_dvd_nat
  have hc : (pCore 2 N).IsComplement' (X.subgroupOf N) :=
    OddHall.sylow_complement_of_hall P hX.2
  have hh := congrArg (map N.subtype) hc.sup_eq_top
  rw [Subgroup.map_sup, map_subgroupOf_eq_of_le hX.1,
    ← MonoidHom.range_eq_map, range_subtype] at hh
  exact hh.symm

/-- The smaller normalizer core lies in the original O₂(XT). -/
theorem cartanNormalizer_core_le_commonTwo (c : Coordinates D F)
    {X : Subgroup G} (hX : IsCartan T L X) :
    (cartanNormalizer T L).pCoreIn 2 ≤ commonTwo T X := by
  let N := cartanNormalizer T L
  have hTN := sylow_normalizes_cartanNormalizer D
  obtain ⟨P,hP⟩ := NormalSylowQuotientAction.intersection_sylow T N hTN
  have hcoreT : N.pCoreIn 2 ≤ (T : Subgroup G) := by
    have hh := pCoreIn_le_sylow N P
    rw [hP, subgroupOf_map_subtype] at hh
    exact hh.trans inf_le_left
  have hNX : N ≤ X ⊔ (T : Subgroup G) := by
    dsimp only [N]
    rw [cartanNormalizer_eq_core_sup c hX]
    exact sup_le (hcoreT.trans le_sup_right) le_sup_left
  exact pCoreIn_mono_of_normalizes hNX
    (sup_le (hX.1.trans N.le_normalizer) hTN)

/-- The original inner Sylow is already contained in S₀. -/
theorem innerSylow_le_commonTwo (c : Coordinates D F)
    {X : Subgroup G} (hX : IsCartan T L X) :
    (T : Subgroup G) ⊓ L ≤ commonTwo T X := by
  apply le_trans ?_ (cartanNormalizer_core_le_commonTwo c hX)
  apply le_pCoreIn_of_normalizes (T.isPGroup'.to_le inf_le_left)
  · rw [cartanNormalizer_eq_intersection_normalizer]
    exact le_inf inf_le_right ((T : Subgroup G) ⊓ L).le_normalizer
  · exact cartanNormalizer_normalizes_intersection

/-- Replacing X by its full source normalizer makes T-invariance transparent. -/
theorem overlap_eq_commonTwo_sup_cartanNormalizer (c : Coordinates D F)
    {X : Subgroup G} (hX : IsCartan T L X) :
    overlap T X = commonTwo T X ⊔ cartanNormalizer T L := by
  apply le_antisymm (sup_le_sup_left hX.1 _)
  refine sup_le le_sup_left ?_
  rw [cartanNormalizer_eq_core_sup c hX]
  exact sup_le ((cartanNormalizer_core_le_commonTwo c hX).trans le_sup_left) le_sup_right

/-- The original source overlap, and hence H, is T-invariant. -/
theorem sylow_normalizes_overlap (c : Coordinates D F)
    {X : Subgroup G} (hX : IsCartan T L X) :
    (T : Subgroup G) ≤ normalizer (overlap T X : Set G) := by
  rw [overlap_eq_commonTwo_sup_cartanNormalizer c hX]
  exact (le_inf (sylow_normalizes_commonTwo X) (sylow_normalizes_cartanNormalizer D)).trans
    (normalizer_inf_normalizer_le_normalizer_sup _ _)

theorem sylow_normalizes_completion (c : Coordinates D F)
    {X K₀ L₂ : Subgroup G} (hX : IsCartan T L X)
    (hK : (T : Subgroup G) ≤ normalizer (K₀ : Set G))
    (hL : (T : Subgroup G) ≤ normalizer (L₂ : Set G)) :
    (T : Subgroup G) ≤ normalizer (completion T X K₀ L₂ : Set G) := by
  have hB := sylow_normalizes_overlap c hX
  exact (le_inf
    ((le_inf hK hB).trans (normalizer_inf_normalizer_le_normalizer_sup _ _))
    ((le_inf hL hB).trans (normalizer_inf_normalizer_le_normalizer_sup _ _))).trans
    (normalizer_inf_normalizer_le_normalizer_sup _ _)

/-- A nonzero intrinsic core gives the actual common normal subgroup in T;
no quotient image or semidirect complement is substituted for Q. -/
theorem common_normal_of_completion_core_ne_bot (c : Coordinates D F)
    {X K₀ L₂ : Subgroup G} (hX : IsCartan T L X)
    (hK : (T : Subgroup G) ≤ normalizer (K₀ : Set G))
    (hL : (T : Subgroup G) ≤ normalizer (L₂ : Set G))
    (hn : pCore 2 (completion T X K₀ L₂) ≠ ⊥) :
    ∃ Q : Subgroup G, Q ≠ ⊥ ∧ Q ≤ (T : Subgroup G) ∧
      (T : Subgroup G) ≤ normalizer (Q : Set G) ∧
      K₀ ≤ normalizer (Q : Set G) ∧ L₂ ≤ normalizer (Q : Set G) := by
  let H := completion T X K₀ L₂
  have hTH : (T : Subgroup G) ≤ normalizer (H : Set G) :=
    sylow_normalizes_completion c hX hK hL
  have hHQ : H ≤ normalizer (H.pCoreIn 2 : Set G) :=
    H.le_normalizer.trans (normalizer_le_normalizer_characteristic_image H (pCore 2 H))
  refine ⟨H.pCoreIn 2, ?_, ?_, hTH.trans
    (normalizer_le_normalizer_characteristic_image H (pCore 2 H)),
    (le_sup_left.trans le_sup_left).trans hHQ,
    (le_sup_left.trans le_sup_right).trans hHQ⟩
  · exact fun he => hn ((map_eq_bot_iff_of_injective _ H.subtype_injective).mp he)
  · obtain ⟨P,hP⟩ := NormalSylowQuotientAction.intersection_sylow T H hTH
    have hh := pCoreIn_le_sylow H P
    rw [hP,subgroupOf_map_subtype] at hh
    exact hh.trans inf_le_left

/-- Absence of the source common normal subgroup forces the full original
completion to have trivial intrinsic two-core. -/
theorem completion_core_eq_bot_of_no_common_normal (c : Coordinates D F)
    {X K₀ L₂ : Subgroup G} (hX : IsCartan T L X)
    (hK : (T : Subgroup G) ≤ normalizer (K₀ : Set G))
    (hL : (T : Subgroup G) ≤ normalizer (L₂ : Set G))
    (hn : ¬ ∃ Q : Subgroup G, Q ≠ ⊥ ∧ Q ≤ (T : Subgroup G) ∧
      (T : Subgroup G) ≤ normalizer (Q : Set G) ∧
      K₀ ≤ normalizer (Q : Set G) ∧ L₂ ≤ normalizer (Q : Set G)) :
    pCore 2 (completion T X K₀ L₂) = ⊥ := by
  by_contra hcore
  exact hn (common_normal_of_completion_core_ne_bot c hX hK hL hcore)

end
end CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.Components.Triangle.ZeroCoreSource
