/-!
# The M₂₂ comparison for the original pair of local sections

A single Sylow conjugation carries both normalized local A₅ sections into
the native compatible Sylow. The intrinsic elementary two-core catalogue
excludes the hexad kernel; the quintet kernel then determines the same
perfect order-960 subgroup for both sections. They therefore cannot generate
M₂₂. Solvable quotient transport excludes its central triple cover as well,
retaining the original two-core projection and both local subgroups.

ThirdVertexQuasisimpleSp4 applies this to the literal I = ⟨K₀,L₂⟩. That
consumer retains common-normal existence and all original flag data; final
source assembly remains with qt-d-1222-natural-relative-components.
Source: Aschbacher--Smith, A.3.14(6) and 11.1.2, printed pp.49,762--764.
The imported native quintet calculations retain their ATLAS provenance.
-/

open Subgroup Theory.GroupTheory Sporadic.Mathieu MathieuCode
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.Components.Triangle
open ChapterA.Section03 ChapterA.Section03.SourceEmbeddings
open FiveLocalFF.SolvableQuotients
public noncomputable section

private theorem aligned_m22_five_eq (B : Subgroup M22)
    (hB : B ∈ localCComponents M22ChapterH.CompatibleSylow.inner)
    (hn : M22ChapterH.CompatibleSylow.inner.toSubgroup ≤ normalizer (B : Set M22))
    (eB : (B ⧸ pCore 2 B) ≃* alternatingGroup (Fin 5)) :
    B.map MathieuCode.m22ToPairStabilizer =
      M22ChapterH.Quintet.naturalActor.map M22Quintet.Q.subtype := by
  let := local_perfect hB
  obtain ⟨hel,hcard⟩ := M22LocalA5Shape.core_shape_of_normalized
    M22ChapterH.CompatibleSylow.inner B hn eB
  let := hel
  have hc : Nat.card (B.pCoreIn 2) = 16 := by
    rw [pCoreIn,card_map_of_injective B.subtype_injective,hcard]
  have he : B.pCoreIn 2 = MathieuCode.m22InnerQuintetKernel MathieuCode.m22SourceSextet :=
    (M22LocalA5Placement.marked_core_cases B hB.subnormal
      (IsElementaryAbelian.map B.subtype) hc).resolve_left
      (M22LocalA5Placement.core_ne_hexad_kernel B hB.subnormal eB)
  apply M22LocalA5Placement.quintet_core_placement B he
  rw [←(pCore 2 B).card_mul_index,hcard]
  change 16 * Nat.card (B ⧸ pCore 2 B) = 960
  rw [Nat.card_congr eB.toEquiv,nat_card_alternatingGroup]
  norm_num [Nat.factorial]

/-- The two original normalized local sections coincide at a full Sylow of M₂₂. -/
theorem m22_local_five_eq (S : Sylow 2 M22) (B C : Subgroup M22)
    (hB : B ∈ localCComponents S) (hC : C ∈ localCComponents S)
    (hnB : (S : Subgroup M22) ≤ normalizer (B : Set M22))
    (hnC : (S : Subgroup M22) ≤ normalizer (C : Set M22))
    (eB : (B ⧸ pCore 2 B) ≃* alternatingGroup (Fin 5))
    (eC : (C ⧸ pCore 2 C) ≃* alternatingGroup (Fin 5)) : B = C := by
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq M22 S M22ChapterH.CompatibleSylow.inner
  let a := MulAut.conj g
  let f := a.toMonoidHom
  have hs : (S : Subgroup M22).map f = M22ChapterH.CompatibleSylow.inner.toSubgroup :=
    congrArg Sylow.toSubgroup hg
  let : Group.IsSolvable f.ker := by
    rw [(MonoidHom.ker_eq_bot_iff f).mpr a.injective]
    infer_instance
  have step (D : Subgroup M22) (hD : D ∈ localCComponents S)
      (hnD : (S : Subgroup M22) ≤ normalizer (D : Set M22))
      (eD : (D ⧸ pCore 2 D) ≃* alternatingGroup (Fin 5)) :
      (D.map f).map MathieuCode.m22ToPairStabilizer =
        M22ChapterH.Quintet.naturalActor.map M22Quintet.Q.subtype := by
    have hl := Chapter1.Section02.localCComponents_map_of_solvable_ker hD f
    have hn := (map_mono (f := f) hnD).trans (le_normalizer_map f)
    change D.map f ∈ localCComponents ((S : Subgroup M22).map f) at hl
    rw [hs] at hl hn
    exact aligned_m22_five_eq _ hl hn (section_map f D hD eD).some
  apply map_injective (f := f) a.injective
  apply map_injective (f := MathieuCode.m22ToPairStabilizer)
    (fun _ _ h => MathieuCode.m22Embedding_injective (congrArg Subtype.val h))
  exact (step B hB hnB eB).trans (step C hC hnC eC).symm

private theorem five_equiv {A : Type*} [Group A]
    (hm : ClassicalGroup.IsPSL A 2 4) : Nonempty (A ≃* alternatingGroup (Fin 5)) := by
  obtain ⟨F,_,_,hF,⟨e⟩⟩ := hm
  exact (Matrix.ProjectiveSpecialLinearGroup.equiv_alternatingGroup_of_card_four hF).map
    (fun a => e.trans a)

/-- A group generated by the two original normalized local A₅ sections
has no solvable quotient isomorphic to M₂₂. -/
theorem no_m22_solvable_quotient_of_local_five_pair
    {A : Type*} [Group A] [Finite A] (S : Sylow 2 A) (B C : Subgroup A)
    (hB : B ∈ localCComponents S) (hC : C ∈ localCComponents S)
    (hnB : (S : Subgroup A) ≤ normalizer (B : Set A))
    (hnC : (S : Subgroup A) ≤ normalizer (C : Set A))
    (hgen : B ⊔ C = ⊤)
    (hmB : ClassicalGroup.IsPSL (B ⧸ pCore 2 B) 2 4)
    (hmC : ClassicalGroup.IsPSL (C ⧸ pCore 2 C) 2 4)
    (f : A →* M22) (hf : Function.Surjective f)
    [Group.IsSolvable f.ker] : False := by
  obtain ⟨eB⟩ := section_map f B hB (five_equiv hmB).some
  obtain ⟨eC⟩ := section_map f C hC (five_equiv hmC).some
  have he := m22_local_five_eq (S.mapSurjective hf) (B.map f) (C.map f)
    (Chapter1.Section02.localCComponents_map_of_solvable_ker hB f)
    (Chapter1.Section02.localCComponents_map_of_solvable_ker hC f)
    ((map_mono hnB).trans (le_normalizer_map f))
    ((map_mono hnC).trans (le_normalizer_map f)) eB eC
  have ht : B.map f = ⊤ := by
    have h := congrArg (Subgroup.map f) hgen
    simpa only [Subgroup.map_sup,←he,sup_idem,map_top_of_surjective f hf] using h
  have hc := (M22LocalA5Shape.core_shape_of_normalized (S.mapSurjective hf)
    (B.map f) ((map_mono hnB).trans (le_normalizer_map f)) eB).2
  have hq : Nat.card ((B.map f) ⧸ pCore 2 (B.map f)) = 60 := by
    rw [Nat.card_congr eB.toEquiv,nat_card_alternatingGroup]
    norm_num [Nat.factorial]
  have hh := (pCore 2 (B.map f)).card_mul_index
  change Nat.card (pCore 2 (B.map f)) * Nat.card ((B.map f) ⧸ pCore 2 (B.map f)) =
    Nat.card (B.map f) at hh
  rw [hc,hq,ht,card_top,m22_order] at hh
  norm_num at hh

/-- The original join excludes M₂₂ and its genuine central cover. Both
normal two-core and central quotient maps retain the local section. -/
theorem local_join_not_m22
    {G : Type*} [Group G] [Finite G] (T : Sylow 2 G) {B C I : Subgroup G}
    (hB : B ∈ localCComponents T) (hC : C ∈ localCComponents T)
    (hI : I ∈ localCComponents T) (hBI : B ≤ I) (hCI : C ≤ I)
    (hnB : (T : Subgroup G) ≤ normalizer (B : Set G))
    (hnC : (T : Subgroup G) ≤ normalizer (C : Set G))
    (hgen : B ⊔ C = I)
    (hmB : ClassicalGroup.IsPSL (B ⧸ pCore 2 B) 2 4)
    (hmC : ClassicalGroup.IsPSL (C ⧸ pCore 2 C) 2 4) :
    ¬ (Nonempty ((I ⧸ pCore 2 I) ≃* M22) ∨
      Chapter1.Section02.LocalModels.IsM22Cover (I ⧸ pCore 2 I)) := by
  obtain ⟨S,hS,hBS⟩ := BinaryIntrinsic.local_in_local_overgroup T hB hI hBI
  have hCS : C.subgroupOf I ∈ localCComponents S := hS.symm ▸ local_restrict hC hCI
  let q := QuotientGroup.mk' (pCore 2 I)
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective _
  let : Group.IsNilpotent q.ker := by rw [QuotientGroup.ker_mk']; exact pCore_isNilpotent
  let : Group.IsSolvable q.ker := inferInstance
  have hgen' : B.subgroupOf I ⊔ C.subgroupOf I = ⊤ := by
    rw [←subgroupOf_sup hBI hCI,hgen,subgroupOf_self]
  let b := subgroupOfEquivOfLe hBI
  let c := subgroupOfEquivOfLe hCI
  let bq := QuotientGroup.congr _ _ b (pCore_map_iso 2 b)
  let cq := QuotientGroup.congr _ _ c (pCore_map_iso 2 c)
  have step (k : (I ⧸ pCore 2 I) →* M22)
      (hk : Function.Surjective k) (hks : Group.IsSolvable k.ker) : False := by
    let := hks
    let : Group.IsSolvable (k.comp q).ker := by
      rw [← MonoidHom.comap_ker]
      exact isSolvable_comap_of_solvable_ker q k.ker
    exact no_m22_solvable_quotient_of_local_five_pair S (B.subgroupOf I) (C.subgroupOf I)
      hBS hCS (by
        rw [hS,←subgroupOf_normalizer_eq hBI]
        exact comap_mono hnB) (by
        rw [hS,←subgroupOf_normalizer_eq hCI]
        exact comap_mono hnC) hgen' (hmB.of_mulEquiv bq) (hmC.of_mulEquiv cq) (k.comp q) (hk.comp hq)
  intro hm
  rcases hm with he | he
  · obtain ⟨e⟩ := he
    apply step e.toMonoidHom e.surjective
    rw [e.toMonoidHom.ker_eq_bot_iff.mpr e.injective]
    infer_instance
  · obtain ⟨_,_,⟨e⟩⟩ := he
    let k := e.toMonoidHom.comp (QuotientGroup.mk' (center (I ⧸ pCore 2 I)))
    apply step k (e.surjective.comp (QuotientGroup.mk'_surjective _))
    change Group.IsSolvable (e.toMonoidHom.comp (QuotientGroup.mk' _)).ker
    rw [MonoidHom.ker_comp_of_injective _ e.toMonoidHom e.injective,QuotientGroup.ker_mk']
    exact Group.isSolvable_of_comm fun a b => IsMulCommutative.is_comm.comm a b


end
