private theorem prime_generation {A : Type*} [Group A] [Finite A] [Group.IsPerfect A]
    [IsQuasisimple (A ⧸ pCore 2 A)] {p : ℕ} [Fact p.Prime]
    (hd : p ∣ (center (A ⧸ pCore 2 A)).index) : primeToResidual p A = ⊤ := by
  let N := primeToResidual p A
  let q := QuotientGroup.mk' (pCore 2 A)
  let : (N.map q).Normal := (inferInstance : N.Normal).map q (QuotientGroup.mk'_surjective _)
  rcases IsQuasisimple.normal_le_center_or_eq_top (N.map q) with hc | ht
  · have hle : N ≤ (center (A ⧸ pCore 2 A)).comap q := map_le_iff_le_comap.mp hc
    have hcop := (primeToResidual_index_coprime (G := A) p).coprime_dvd_right
      (index_dvd_of_le hle)
    rw [index_comap_of_surjective _ (QuotientGroup.mk'_surjective _)] at hcop
    exact ((Fact.out : p.Prime).coprime_iff_not_dvd.mp hcop hd).elim
  · have hs : N ⊔ pCore 2 A = ⊤ := by
      have he := congrArg (comap q) ht
      simpa only [comap_map_eq,q,QuotientGroup.ker_mk',comap_top] using he
    let : Group.IsNilpotent (A ⧸ N) :=
      (isPGroup_quotient_of_sup_eq_top N (pCore 2 A) pCore_isPGroup hs).isNilpotent
    exact top_unique (by simpa only [solvableResidual_eq_top] using
      solvableResidual_le_of_solvable_quotient N)

private theorem small_action_trivial {A W : Type*} [Group A] [Finite A]
    [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]
    (ρ : Representation (ZMod 2) A W) (hgen : primeToResidual 11 A = ⊤)
    (hd : Module.finrank (ZMod 2) W < 10) (a : A) : ρ a = 1 := by
  let R := ρ.asGroupHom.range
  let : Finite R := Finite.of_surjective _ ρ.asGroupHom.rangeRestrict_surjective
  let σ : Representation (ZMod 2) R W :=
    { toFun r := r.val.val
      map_one' := rfl
      map_mul' _ _ := rfl }
  have hf : Function.Injective σ := Units.val_injective.comp Subtype.val_injective
  have hc : Nat.Coprime 11 (Nat.card R) := by
    apply (show Nat.Prime 11 by decide).coprime_iff_not_dvd.mpr
    intro hh
    have hb := BinaryPrimeDegree.orderOf_le_finrank σ hf (by decide : Nat.Prime 11) (by decide) hh
    rw [BinaryPrimeDegree.orderOf_two_mod_eleven] at hb
    omega
  have hk := primeToResidual_le_ker ρ.asGroupHom.rangeRestrict hc
  rw [hgen] at hk
  have he := hk (show a ∈ (⊤ : Subgroup A) from trivial)
  exact congrArg (fun x : R => x.val.val) he

variable {G : Type*} [Group G] [Finite G]
    {T : Sylow 2 G} {L V : Subgroup G} (D : ChosenModule T L V)
    (S : D.NonbinaryNaturalInput) {c : Coordinates D S.field} (f : InvariantFlag c)

private theorem second_dimension
    (p : Additive (f.Vi 1) →ₗ[ZMod 2] (Fin 2 → S.field.Carrier))
    (hp : Function.Surjective p)
    (hk : ∀ v, p v = 0 ↔ (v.toMul : G) ∈ centralizer (L : Set G)) :
    Module.finrank (ZMod 2) (Additive (f.Vi 1)) ≤ 3 * S.field.degree := by
  have hF : Module.finrank (ZMod 2) S.field.Carrier = S.field.degree := by
    have hc := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := S.field.Carrier)
    rw [Nat.card_zmod,S.field.card_eq] at hc
    exact (Nat.pow_right_injective (by decide : 1 < 2) hc).symm
  have hd := LinearMap.finrank_range_add_finrank_ker p
  rw [LinearMap.range_eq_top.mpr hp,finrank_top,
    Module.finrank_pi_fintype,Finset.sum_const,Finset.card_univ,Fintype.card_fin,
    smul_eq_mul,hF,second_cover_kernel_finrank S f p hk] at hd
  have hb := flag_centralizer_rank_le S
  omega

private theorem transported_sporadic_data {A B : Type*} [Group A] [Finite A]
    [Group B] [Finite B] (e : A ≃* B) (hz : center B = ⊥)
    (hr : 2 ≤ primeRank 3 B) (hd : 11 ∣ Nat.card B) :
    center A = ⊥ ∧ 2 ≤ primeRank 3 A ∧ 11 ∣ Nat.card A := by
  refine ⟨?_,?_,?_⟩
  · apply _root_.eq_bot_iff.mpr
    intro a ha
    exact e.map_eq_one_iff.mp (hz.le ((centerCongr e) ⟨a,ha⟩).property)
  · rwa [primeRank_congr 3 e]
  · rwa [Nat.card_congr e.toEquiv]

private theorem small_sporadic_data {A : Type*} [Group A] [Finite A]
    (h : SmallSporadicCarrier A) : IsM22Cover A ∨
      (center A = ⊥ ∧ 2 ≤ primeRank 3 A ∧ 11 ∣ Nat.card A) := by
  rcases h with h | h | h | h
  · right
    exact transported_sporadic_data h.some Sporadic.Mathieu.m22_center_eq_bot
      Sporadic.Mathieu.m22_primeRank_three.ge (by rw [Sporadic.Mathieu.m22_order]; decide)
  · exact .inl h
  · right
    have hr : 2 ≤ primeRank 3 Sporadic.Mathieu.M23 :=
      Sporadic.Mathieu.m22_primeRank_three.ge.trans
        ((primeRank_equiv 3 Sporadic.Mathieu.m23EquivM22PointStabilizer).le.trans
          (primeRank_subgroup_le 3 _))
    exact transported_sporadic_data h.some Sporadic.Mathieu.M23Geometry.m23_center_eq_bot hr
      (by rw [Sporadic.Mathieu.m23_order]; decide)
  · right
    exact transported_sporadic_data h.some Sporadic.LeechRelated.HS.BlockNormalizer.center_carrier_eq_bot
      Sporadic.LeechRelated.HS.ThreeRank.two_le_primeRank
      (by rw [Sporadic.LeechRelated.HS.NormalizerIndex.card_carrier]; decide)

private theorem small_sporadic_structure {G : Type*} [Group G] [Finite G]
    {κ : GroupClass} {H K : Subgroup G} (hH : IsSQTK κ H)
    (hK : Source.ComponentIn H K) (hm : SmallSporadicCarrier (K ⧸ pCore 2 K)) :
    IsQuasisimple (K ⧸ pCore 2 K) ∧ 11 ∣ (center (K ⧸ pCore 2 K)).index := by
  rcases small_sporadic_data hm with hc | ⟨hz,hr,hd⟩
  · obtain ⟨hq,_,⟨e⟩⟩ := hc
    refine ⟨hq,?_⟩
    rw [index_eq_card,Nat.card_congr e.toEquiv,Sporadic.Mathieu.m22_order]
    decide
  · let B := K.subgroupOf H
    let e : (B ⧸ pCore 2 B) ≃* (K ⧸ pCore 2 K) :=
      QuotientGroup.congr _ _ (subgroupOfEquivOfLe hK.1) (pCore_map_iso 2 _)
    have hrB : 2 ≤ primeRank 3 B := by
      rw [← primeRank_quotient_eq_of_isTwoGroup 3 (by decide) (pCore 2 B) pCore_isPGroup,
        primeRank_congr 3 e]
      exact hr
    let := ChapterA.Section03.cComponent_twoCore_quasisimple_of_three_rank hH hK.2 hrB
    refine ⟨IsQuasisimple.of_mulEquiv e,?_⟩
    simpa [hz] using hd

/-- The source's full central cover has binary dimension at most three times
the original field degree; its fixed summand is included. -/
theorem second_cover_finrank_le
    (p : Additive (f.Vi 1) →ₗ[ZMod 2] (Fin 2 → S.field.Carrier))
    (hp : Function.Surjective p)
    (hk : ∀ v, p v = 0 ↔ (v.toMul : G) ∈ centralizer (L : Set G)) :
    Module.finrank (ZMod 2) (Additive (f.Vi 1)) ≤ 3 * S.field.degree :=
  second_dimension D S f p hp hk

/-- All four carriers, including 3.M₂₂, are impossible at the second flag
normalizer. The rank-one model forces field four; the full six-dimensional
central cover cannot support their nontrivial perfect action. -/
theorem second_not_small_sporadic
    (hm : ClassicalGroup.IsPSL (f.Li 1 ⧸ pCore 2 (f.Li 1)) 2 (2 ^ S.field.degree))
    {K : Subgroup G} (hK : Source.ComponentIn (normalizer (f.Vi 1 : Set G)) K)
    (hLK : f.Li 1 ≤ K)
    (π : f.Li 1 →* SL(2,S.field.Carrier)) (hπ : Function.Surjective π)
    (p : Additive (f.Vi 1) →ₗ[ZMod 2] (Fin 2 → S.field.Carrier))
    (hp : Function.Surjective p)
    (hact : ∀ a : f.Li 1, ∀ v,
      p (flagAction f 1 ⟨a,(localResidual_le _ a.property).2⟩ v) =
        specialLinearNatural 2 (π a) (p v))
    (hk : ∀ v, p v = 0 ↔ (v.toMul : G) ∈ centralizer (L : Set G)) :
    ¬ SmallSporadicCarrier (K ⧸ pCore 2 K) := by
  intro hmodel
  let : Fact (Nat.Prime 11) := ⟨by decide⟩
  let : Group.IsPerfect (f.Li 1) := localResidual_perfect _
  have hn := small_sporadic_parameters hLK S.nonbinary hm hmodel
  obtain ⟨hq,hd⟩ := small_sporadic_structure
    (S.source.simpleQTKE.twoLocal_sqtk (f.normalizer_twoLocal 1)) hK hmodel
  let := hq
  let : Group.IsPerfect (K.subgroupOf (normalizer (f.Vi 1 : Set G))) := hK.2.perfect
  let : Group.IsPerfect K := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe hK.1).toMonoidHom) (subgroupOfEquivOfLe hK.1).surjective
  have hgen := prime_generation hd
  have hdim : Module.finrank (ZMod 2) (Additive (f.Vi 1)) < 10 := by
    have hb := second_cover_finrank_le D S f p hp hk
    rw [hn] at hb
    omega
  let ρ := (flagAction f 1).comp (inclusion hK.1)
  obtain ⟨g,hg⟩ := Matrix.SL2.exists_mulVec_eq S.field.Carrier
    (![1,0]) (![0,1]) (by simp) (by simp)
  obtain ⟨a,rfl⟩ := hπ g
  obtain ⟨v,hv⟩ := hp (![1,0])
  have he : flagAction f 1 ⟨a,(localResidual_le _ a.property).2⟩ v = v :=
    LinearMap.congr_fun (small_action_trivial ρ hgen hdim ⟨a,hLK a.property⟩) v
  have ha := hact a v
  rw [he,hv] at ha
  have hg' : specialLinearNatural 2 (π a) (![1,0]) = (![0,1]) := hg
  rw [hg'] at ha
  have hz := congrFun ha 0
  simp at hz

/-- The second-index refinement consumer retains the literal natural maps
and has no exhaustive embedding-list or field-four premise. -/
theorem second_refinement_of_small_sporadic
    (hm : ClassicalGroup.IsPSL (f.Li 1 ⧸ pCore 2 (f.Li 1)) 2 (2 ^ S.field.degree))
    {K X : Subgroup G} (hK : Source.ComponentIn (normalizer (f.Vi 1 : Set G)) K)
    (hLK : f.Li 1 ≤ K)
    (π : f.Li 1 →* SL(2,S.field.Carrier)) (hπ : Function.Surjective π)
    (p : Additive (f.Vi 1) →ₗ[ZMod 2] (Fin 2 → S.field.Carrier))
    (hp : Function.Surjective p)
    (hact : ∀ a : f.Li 1, ∀ v,
      p (flagAction f 1 ⟨a,(localResidual_le _ a.property).2⟩ v) =
        specialLinearNatural 2 (π a) (p v))
    (hk : ∀ v, p v = 0 ↔ (v.toMul : G) ∈ centralizer (L : Set G))
    (hmodel : SmallSporadicCarrier (K ⧸ pCore 2 K)) :
    RefinementAlternative T L (f.Li 0) (f.Li 1) K X 1 S.field.degree :=
  (second_not_small_sporadic D S f hm hK hLK π hπ p hp hact hk hmodel).elim

