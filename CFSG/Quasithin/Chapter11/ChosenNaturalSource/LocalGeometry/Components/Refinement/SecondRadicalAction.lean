private theorem cyclic_normal_central {A : Type*} [Group A] [Group.IsPerfect A]
    (N : Subgroup A) [N.Normal] [IsCyclic N] : N ≤ center A := by
  let e := IsCyclic.mulAutMulEquiv N
  let : CommGroup (MulAut N) := e.toMonoidHom.commGroupOfInjective e.injective
  let a : A →* MulAut N := MulAut.conjNormal
  intro x hx
  rw [mem_center_iff]
  intro g
  have ha : a g = 1 := Abelianization.commutator_subset_ker a Group.IsPerfect.mem_commutator
  have hh := congrArg (fun t : MulAut N => (t ⟨x,hx⟩ : A)) ha
  exact mul_inv_eq_iff_eq_mul.mp hh

private theorem seven_aut_not_five {N : Type*} [Group N] [Finite N]
    (hN : IsPGroup 7 N) (hd : Nat.card N ∣ 20158709760) :
    ¬ 5 ∣ Nat.card (MulAut N) := by
  let : Fact (Nat.Prime 7) := ⟨by decide⟩
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  obtain ⟨n, hn⟩ := hN.exists_card_eq
  have hnle : n ≤ 2 := by
    by_contra! hh
    have hbad : 343 ∣ 20158709760 := (pow_dvd_pow 7 hh).trans (hn ▸ hd)
    norm_num at hbad
  intro hfive
  obtain ⟨a, ha⟩ := exists_prime_orderOf_dvd_card' 5 hfive
  let P := zpowers a
  have hP : Nat.card P = 5 := by rw [Nat.card_zpowers, ha]
  have hp : IsPGroup 5 P := IsPGroup.of_card (n := 1) (by simpa using hP)
  let F := FixedPoints.subgroup P N
  have hmod := hp.card_modEq_card_fixedPoints N
  change Nat.card N % 5 = Nat.card F % 5 at hmod
  have hFdiv : Nat.card F ∣ 7 ^ n := hn ▸ F.card_subgroup_dvd_card
  obtain ⟨k, hk, hcard⟩ := (Nat.dvd_prime_pow (by decide : Nat.Prime 7)).mp hFdiv
  have heq : Nat.card F = Nat.card N := by
    rw [hn, hcard] at hmod ⊢
    interval_cases n <;> interval_cases k <;> norm_num at *
  have htop := F.eq_top_of_card_eq heq
  have haone : a = 1 := by
    ext x
    exact (show x ∈ F from htop ▸ mem_top x) ⟨a, mem_zpowers a⟩
  rw [haone, orderOf_one] at ha
  norm_num at ha

private theorem normal_prime_central
    {A : Type*} [Group A] [Finite A] [Group.IsPerfect A]
    (hcard : Nat.card A ∣ 20158709760) (hgen : primeToResidual 5 A = ⊤)
    {p : ℕ} (hp : p.Prime) (hp3 : 3 < p)
    (N : Subgroup A) [N.Normal] (hN : IsPGroup p N) : N ≤ center A := by
  let : Fact p.Prime := ⟨hp⟩
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  have hd := N.card_subgroup_dvd_card.trans hcard
  by_cases hbot : N = ⊥
  · exact hbot ▸ bot_le
  have hpd : p ∣ 20158709760 :=
    (hN.card_eq_or_dvd.resolve_left (fun h => hbot (card_eq_one.mp h))).trans hd
  have hcases : p = 5 ∨ p = 7 ∨ p = 31 := by
    have hf : (20158709760 : ℕ) = 2^15 * 3^4 * 5 * 7^2 * 31 := by decide
    rw [hf] at hpd
    rcases hp.dvd_mul.mp hpd with h | h
    · rcases hp.dvd_mul.mp h with h | h
      · rcases hp.dvd_mul.mp h with h | h
        · rcases hp.dvd_mul.mp h with h | h
          · have := (Nat.prime_dvd_prime_iff_eq hp Nat.prime_two).mp (hp.dvd_of_dvd_pow h)
            omega
          · have := (Nat.prime_dvd_prime_iff_eq hp Nat.prime_three).mp (hp.dvd_of_dvd_pow h)
            omega
        · exact .inl ((Nat.prime_dvd_prime_iff_eq hp (by decide)).mp h)
      · exact .inr (.inl ((Nat.prime_dvd_prime_iff_eq hp (by decide)).mp (hp.dvd_of_dvd_pow h)))
    · exact .inr (.inr ((Nat.prime_dvd_prime_iff_eq hp (by decide)).mp h))
  by_cases hseven : p = 7
  · subst p
    let a : A →* MulAut N := MulAut.conjNormal
    have hk := primeToResidual_le_ker a
      ((by decide : Nat.Prime 5).coprime_iff_not_dvd.mpr (seven_aut_not_five hN hd))
    rw [hgen] at hk
    intro x hx
    rw [mem_center_iff]
    intro g
    have hh := congrArg (fun t : MulAut N => (t ⟨x,hx⟩ : A)) (hk (mem_top g))
    exact mul_inv_eq_iff_eq_mul.mp hh
  · have hsq : ¬ p^2 ∣ 20158709760 := by
      rcases hcases with rfl | rfl | rfl <;> norm_num at *
    obtain ⟨n,hn⟩ := hN.exists_card_eq
    have hnle : n ≤ 1 := by
      by_contra! hh
      exact hsq ((pow_dvd_pow p hh).trans (hn ▸ hd))
    have hc : Nat.card N = p := by
      interval_cases n
      · exact (hbot (card_eq_one.mp hn)).elim
      · simpa using hn
    let : IsCyclic N := isCyclic_of_prime_card hc
    exact cyclic_normal_central N

/-- A perfect solvable extension of SL₂(5) is generated by its five-elements. -/
theorem five_generated {A : Type*} [Group A] [Finite A] [Group.IsPerfect A]
    (hm : LocalModels.HasExtension A (fun N _ => Group.IsSolvable N)
      (fun Q _ => Source.IsSL Q 2 5)) : primeToResidual 5 A = ⊤ := by
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  obtain ⟨N,hN,hs,F,_,_,hF,⟨e⟩⟩ := hm
  let := hN
  let := hs
  let : Fintype F := Fintype.ofFinite F
  let : CharP F 5 := charP_of_card_eq_prime_pow (f := 1)
    (by simpa only [Nat.card_eq_fintype_card,pow_one] using hF)
  let q := QuotientGroup.mk' N
  have hquot : primeToResidual 5 (A ⧸ N) = ⊤ := by
    apply top_unique
    intro a _
    simpa only [MulEquiv.coe_toMonoidHom,MulEquiv.symm_apply_apply] using
      Matrix.SL2.map_mem_primeToResidual 5 e.symm.toMonoidHom (e a)
  let : Group.IsPerfect (⊤ : Subgroup A) := Group.IsPerfect.ofSurjective
    (f := (topEquiv : (⊤ : Subgroup A) ≃* A).symm.toMonoidHom) topEquiv.symm.surjective
  let : Group.IsSolvable q.ker := by rw [QuotientGroup.ker_mk']; infer_instance
  apply top_unique
  apply le_of_map_le_of_perfect_solvable_kernel q ⊤ (primeToResidual 5 A) le_top
    le_normalizer_of_normal
  rw [map_primeToResidual_of_surjective 5 q (QuotientGroup.mk'_surjective N), hquot]
  exact le_top

/-- The odd radical commutator has trivial image in every group whose order
 divides GL(6,2), including actions with a nontrivial two-core. -/
theorem small_image_trivial
    {A B : Type*} [Group A] [Finite A] [Group.IsPerfect A] [Group B] [Finite B]
    (hgen : primeToResidual 5 A = ⊤)
    (a : A →* B) (ha : Function.Surjective a) (hcard : Nat.card B ∣ 20158709760)
    {p : ℕ} (hp : p.Prime) (hp3 : 3 < p)
    (X : Subgroup A) [X.Normal] (hX : IsPPerfect 2 X)
    (hq : IsPGroup p (X.map (QuotientGroup.mk' (pCore 2 A))))
    (hc : ⁅X,⊤⁆ = X) : X.map a = ⊥ := by
  let : Fact p.Prime := ⟨hp⟩
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  let q := QuotientGroup.mk' (pCore 2 B)
  let b := q.comp a
  have hb : Function.Surjective b := (QuotientGroup.mk'_surjective _).comp ha
  let : Group.IsPerfect (B ⧸ pCore 2 B) := Group.IsPerfect.ofSurjective (f := b) hb
  have hcore : (pCore 2 A).map a ≤ pCore 2 B := by
    let : ((pCore 2 A).map a).Normal := (inferInstance : (pCore 2 A).Normal).map a ha
    exact le_sSup ⟨inferInstance,pCore_isPGroup.map a⟩
  let aq := QuotientGroup.map (pCore 2 A) (pCore 2 B) a (map_le_iff_le_comap.mp hcore)
  have hXP : IsPGroup p (X.map b) := by
    have he : (X.map (QuotientGroup.mk' (pCore 2 A))).map aq = X.map b := by
      rw [map_map]
      rfl
    exact he ▸ hq.map aq
  let : (X.map b).Normal := (inferInstance : X.Normal).map b hb
  have hg : primeToResidual 5 (B ⧸ pCore 2 B) = ⊤ := by
    rw [←map_primeToResidual_of_surjective 5 b hb,hgen,map_top_of_surjective b hb]
  have hz := normal_prime_central ((card_quotient_dvd_card _).trans hcard) hg hp hp3
    (X.map b) hXP
  have hxzero : X.map b = ⊥ := by
    calc
      X.map b = ⁅X.map b, ⊤⁆ := by rw [←map_top_of_surjective b hb,←map_commutator,hc]
      _ = ⊥ := commutator_eq_bot_iff_le_centralizer.mpr
        (hz.trans (center_le_centralizer _))
  have hle : X.map a ≤ pCore 2 B := by
    have hm : (X.map a).map q = ⊥ := by rwa [map_map]
    simpa only [q,QuotientGroup.ker_mk'] using (Subgroup.map_eq_bot_iff _).mp hm
  have htwo : IsPGroup 2 (X.map a) := pCore_isPGroup.to_le hle
  have hf := hX.of_surjective (a.subgroupMap X) (a.subgroupMap_surjective X)
  have he := hf.hom_eq_one_of_isPGroup htwo (MonoidHom.id (X.map a))
  apply _root_.eq_bot_iff.mpr
  intro x hx
  exact congrArg Subtype.val (DFunLike.congr_fun he ⟨x,hx⟩)


/-- The five-generation result lifts through the literal two-core. -/
theorem five_generated_of_nilpotent_extension
    {A : Type*} [Group A] [Finite A] [Group.IsPerfect A]
    (hm : LocalModels.HasExtension (A ⧸ pCore 2 A)
      (fun N _ => Group.IsNilpotent N ∧ Odd (Nat.card N))
      (fun Q _ => Source.IsSL Q 2 5)) : primeToResidual 5 A = ⊤ := by
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  have hq : primeToResidual 5 (A ⧸ pCore 2 A) = ⊤ := by
    obtain ⟨N,hN,⟨hNil,_⟩,hmod⟩ := hm
    let := hN
    let := hNil
    exact five_generated ⟨N,hN,inferInstance,hmod⟩
  let q := QuotientGroup.mk' (pCore 2 A)
  let : Group.IsPerfect (⊤ : Subgroup A) := Group.IsPerfect.ofSurjective
    (f := (topEquiv : (⊤ : Subgroup A) ≃* A).symm.toMonoidHom) topEquiv.symm.surjective
  let : Group.IsSolvable q.ker := by
    rw [QuotientGroup.ker_mk']
    let := pCore_isNilpotent (p := 2) (G := A)
    infer_instance
  apply top_unique
  apply le_of_map_le_of_perfect_solvable_kernel q ⊤ (primeToResidual 5 A) le_top
    le_normalizer_of_normal
  rw [map_primeToResidual_of_surjective 5 q (QuotientGroup.mk'_surjective _), hq]
  exact le_top

/-- The action consequence keeps the entire small binary space, without
irreducibility or faithfulness assumptions. -/
theorem small_representation_trivial
    {A W : Type*} [Group A] [Finite A] [Group.IsPerfect A]
    [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]
    (hgen : primeToResidual 5 A = ⊤)
    (ρ : Representation (ZMod 2) A W) (hd : Module.finrank (ZMod 2) W ≤ 6)
    {p : ℕ} (hp : p.Prime) (hp3 : 3 < p)
    (X : Subgroup A) [X.Normal] (hX : IsPPerfect 2 X)
    (hq : IsPGroup p (X.map (QuotientGroup.mk' (pCore 2 A))))
    (hc : ⁅X,⊤⁆ = X) : ∀ x ∈ X, ρ x = 1 := by
  let R := ρ.asGroupHom.range
  let : Finite R := Finite.of_surjective _ ρ.asGroupHom.rangeRestrict_surjective
  let σ : Representation (ZMod 2) R W :=
    { toFun r := r.val.val
      map_one' := rfl
      map_mul' _ _ := rfl }
  have hf : Function.Injective σ := Units.val_injective.comp Subtype.val_injective
  have hGL : Nat.card (GL (Fin (Module.finrank (ZMod 2) W)) (ZMod 2)) ∣
      20158709760 := by
    let d := Module.finrank (ZMod 2) W
    change Nat.card (GL (Fin d) (ZMod 2)) ∣ _
    change d ≤ 6 at hd
    interval_cases d <;> rw [Matrix.card_GL_field] <;> norm_num [Fin.prod_univ_succ]
  have he := small_image_trivial hgen ρ.asGroupHom.rangeRestrict
    ρ.asGroupHom.rangeRestrict_surjective
    ((Representation.card_dvd_card_GL_of_injective σ hf).trans hGL) hp hp3 X hX hq hc
  intro x hx
  have hh : ρ.asGroupHom.rangeRestrict x = 1 :=
    mem_bot.mp (he ▸ mem_map_of_mem _ hx)
  exact congrArg (fun r : R => r.val.val) hh

/-- Every canonical radical factor of the remaining nilpotent SL₂(5)
component fixes any binary space of dimension at most six. All A.3.6
and radical commutator inputs are discharged from the original local family. -/
theorem xiP_small_action
    {G W : Type*} [Group G] [Finite G]
    [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]
    (hG : IsSimpleQTKE CFSG.KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    {K : Subgroup G} (hK : K ∈ Chapter1.L G T)
    (hTK : (T : Subgroup G) ≤ normalizer (K : Set G))
    (hn : ¬ IsQuasisimple (XiQuotient K))
    (hm : LocalModels.HasExtension (K ⧸ pCore 2 K)
      (fun N _ => Group.IsNilpotent N ∧ Odd (Nat.card N))
      (fun Q _ => Source.IsSL Q 2 5))
    (ρ : Representation (ZMod 2) K W) (hdim : Module.finrank (ZMod 2) W ≤ 6)
    {p : ℕ} [Fact p.Prime] (ho : Odd p)
    (hd : p ∣ Nat.card (fittingSubgroup (XiQuotient K))) :
    ∀ x : K, (x : G) ∈ XiP p K → ρ x = 1 := by
  let : Group.IsPerfect K := mem_L_isPerfect hK
  let hA := fun (Y : Type _) [Group Y] [Finite Y] =>
    ChapterA.Section02.theoremA_knownSimple (G := Y)
  let hC := fun (Y : Type _) [Group Y] [Finite Y] =>
    ChapterA.Section02.theoremC_knownSimple (G := Y)
  let hA36 := ChapterA.SQTKStructure.a36Input_of_theoremsAC hA hC
  have hQ := uniqueness_local_quotient_sqtk hG hK.2.2
  obtain ⟨hp3,_⟩ := XiP_oddQuotient_of_A36 hA36 hK hQ hn ho hd
  have hc := RadicalActions.XiP_commutator_eq_of_nonsolvable_subgroup_of_A36
    hA36 hK hQ hn hTK hTK le_rfl (mem_L_not_isSolvable hK) ho hd
  let X := xiPIn p K
  have hgen : ⁅X,⊤⁆ = X := by
    apply map_injective K.subtype_injective
    rw [map_commutator, ←MonoidHom.range_eq_map, range_subtype]
    exact hc
  let e : X ≃* XiP p K := X.equivMapOfInjective K.subtype K.subtype_injective
  have hpX : IsPPerfect 2 X := (XiP_isPPerfect p K).of_surjective
    e.symm.toMonoidHom e.symm.surjective
  have hq : IsPGroup p (X.map (QuotientGroup.mk' (pCore 2 K))) := by
    rw [show X = xiPIn p K from rfl, xiPIn_map_quotient ho K]
    exact (pCore_isPGroup.to_subgroup (omega (pCore p (XiQuotient K)) (p := p) 1)).map _
  intro x hx
  apply small_representation_trivial (five_generated_of_nilpotent_extension hm)
    ρ hdim (Fact.out : p.Prime) hp3 X hpX hq hgen x
  have hx' : x ∈ (XiP p K).subgroupOf K := hx
  rwa [XiP_subgroupOf] at hx'


/-- An odd-kernel SL₂(5) extension with trivial two-core cannot be
quasisimple: its central scalar involution would lift to the odd center. -/
theorem not_quasisimple_of_nilpotent_extension
    {A : Type*} [Group A] [Finite A] (hcore : pCore 2 A = ⊥)
    (hm : LocalModels.HasExtension A
      (fun N _ => Group.IsNilpotent N ∧ Odd (Nat.card N))
      (fun Q _ => Source.IsSL Q 2 5)) : ¬ IsQuasisimple A := by
  intro hquasi
  let := hquasi
  obtain ⟨N,hN,⟨hNil,_⟩,F,_,_,hF,⟨e⟩⟩ := hm
  let := hN
  let := hNil
  let π := e.toMonoidHom.comp (QuotientGroup.mk' N)
  have hπ : Function.Surjective π := e.surjective.comp (QuotientGroup.mk'_surjective N)
  let : Group.IsSolvable π.ker := by
    rw [MonoidHom.ker_comp_of_injective _ _ e.injective,QuotientGroup.ker_mk']
    infer_instance
  let R := (center SL(2,F)).comap π
  let : Group.IsSolvable R := isSolvable_comap_of_solvable_ker π _
  have hR : R ≤ center A := (le_solvableRadical R inferInstance inferInstance).trans
    IsQuasisimple.solvableRadical_le_center
  have hfit : center A ≤ fittingSubgroup A := le_sSup ⟨inferInstance,inferInstance⟩
  have hodd : Odd (Nat.card R) := Nat.coprime_two_left.mp
    ((pPrimeCore_coprime_card (p := 2) (G := A)).of_dvd_right
      (card_dvd_of_le (hR.trans (hfit.trans (fitting_le_pPrimeCore_of_pCore_eq_bot 2 hcore)))))
  have him : R.map π = center SL(2,F) := map_comap_eq_self_of_surjective hπ _
  have hoim : Odd (Nat.card (center SL(2,F))) := by
    rw [←him]
    exact hodd.of_dvd_nat (card_dvd_of_surjective (π.subgroupMap R) (π.subgroupMap_surjective R))
  have hmone : (-1 : SL(2,F)) ∈ center SL(2,F) := by
    rw [mem_center_iff]
    intro g
    simp
  have hd := orderOf_dvd_natCard (center SL(2,F)) hmone
  rw [Matrix.SpecialLinearGroup.orderOf_neg_one_eq_two
    (Field.two_ne_zero_of_odd_card F (hF.symm ▸ (by decide : Odd 5)))] at hd
  exact hoim.not_two_dvd_nat hd

/-- Nonquasisimplicity in a two-core-free component supplies a genuine
odd Fitting prime, with no nontrivial-radical premise. -/
theorem exists_odd_fitting_prime
    {A : Type*} [Group A] [Finite A]
    (hA : (⊤ : Subgroup A).IsCComponent) (hcore : pCore 2 A = ⊥)
    (hn : ¬ IsQuasisimple A) :
    ∃ p : ℕ, p.Prime ∧ Odd p ∧ p ∣ Nat.card (fittingSubgroup A) := by
  have hne : Nat.card (fittingSubgroup A) ≠ 1 := by
    intro hc
    have hfit : fittingSubgroup A = ⊥ := card_eq_one.mp hc
    have hq := hA.isQuasisimple_of_fitting_centralizes
      (hfit ▸ (bot_le : (⊥ : Subgroup A) ≤ centralizer (⊤ : Set A)))
    let := hq
    exact hn (IsQuasisimple.of_mulEquiv topEquiv)
  obtain ⟨p,hp,hd⟩ := Nat.exists_prime_and_dvd hne
  have ho : Odd (Nat.card (fittingSubgroup A)) := Nat.coprime_two_left.mp
    ((pPrimeCore_coprime_card (p := 2) (G := A)).of_dvd_right
      (card_dvd_of_le (fitting_le_pPrimeCore_of_pCore_eq_bot 2 hcore)))
  exact ⟨p,hp,ho.of_dvd_nat hd,hd⟩

