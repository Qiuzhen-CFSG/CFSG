private theorem prime_generation {A : Type*} [Group A] [Finite A] [Group.IsPerfect A]
    [IsQuasisimple (A ⧸ pCore 2 A)] {p : ℕ} [Fact p.Prime]
    (hd : p ∣ (center (A ⧸ pCore 2 A)).index) : primeToResidual p A = ⊤ := by
  let N := primeToResidual p A
  let q := QuotientGroup.mk' (pCore 2 A)
  let : (N.map q).Normal := (inferInstance : N.Normal).map q (QuotientGroup.mk'_surjective _)
  rcases IsQuasisimple.normal_le_center_or_eq_top (N.map q) with hc | ht
  · have hle : N ≤ (center (A ⧸ pCore 2 A)).comap q := map_le_iff_le_comap.mp hc
    have hcop := (primeToResidual_index_coprime (G := A) p).coprime_dvd_right
      (index_dvd_of_le hle)
    rw [index_comap_of_surjective _ (QuotientGroup.mk'_surjective _)] at hcop
    exact ((Fact.out : p.Prime).coprime_iff_not_dvd.mp hcop hd).elim
  · have hs : N ⊔ pCore 2 A = ⊤ := by
      have he := congrArg (comap q) ht
      simpa only [comap_map_eq,q,QuotientGroup.ker_mk',comap_top] using he
    let : Group.IsNilpotent (A ⧸ N) :=
      (isPGroup_quotient_of_sup_eq_top N (pCore 2 A) pCore_isPGroup hs).isNilpotent
    exact top_unique (by simpa only [solvableResidual_eq_top] using
      solvableResidual_le_of_solvable_quotient N)

private theorem small_action_trivial {A W : Type*} [Group A] [Finite A]
    [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]
    (ρ : Representation (ZMod 2) A W) {r : ℕ} [Fact r.Prime] (hr : r ≠ 2)
    (hgen : primeToResidual r A = ⊤)
    (hd : Module.finrank (ZMod 2) W < orderOf (2 : ZMod r)) (a : A) : ρ a = 1 := by
  let R := ρ.asGroupHom.range
  let : Finite R := Finite.of_surjective _ ρ.asGroupHom.rangeRestrict_surjective
  let σ : Representation (ZMod 2) R W :=
    { toFun r := r.val.val
      map_one' := rfl
      map_mul' _ _ := rfl }
  have hf : Function.Injective σ := Units.val_injective.comp Subtype.val_injective
  have hc : Nat.Coprime r (Nat.card R) := by
    apply (Fact.out : r.Prime).coprime_iff_not_dvd.mpr
    intro hh
    have hb := BinaryPrimeDegree.orderOf_le_finrank σ hf (Fact.out : r.Prime) hr hh
    omega
  have hk := primeToResidual_le_ker ρ.asGroupHom.rangeRestrict hc
  rw [hgen] at hk
  have he := hk (show a ∈ (⊤ : Subgroup A) from trivial)
  exact congrArg (fun x : R => x.val.val) he

private theorem binary_section_card_dvd {G : Type*} [Group G] [Finite G]
    {B K : Subgroup G} (hBK : B ≤ K) {n : ℕ}
    (hm : ClassicalGroup.IsPSL (B ⧸ pCore 2 B) 2 (2^n)) :
    2^n * ((2^n)^2-1) ∣ Nat.card (K ⧸ pCore 2 K) := by
  let q := QuotientGroup.mk' (pCore 2 K)
  let C := B.subgroupOf K
  have hk : IsPGroup 2 (q.subgroupMap C).ker := by
    rw [ker_subgroupMap,QuotientGroup.ker_mk']
    exact pCore_isPGroup.comap_subtype
  let e := subgroupOfEquivOfLe hBK
  let eq := QuotientGroup.congr _ _ e (pCore_map_iso 2 e)
  let a := (q.subgroupMap C).quotientPCoreEquivOfSurjective (q.subgroupMap_surjective C) hk
  have hm' := hm.of_mulEquiv (a.symm.trans eq)
  rw [← binary_card hm']
  exact (card_quotient_dvd_card _).trans (C.map q).card_subgroup_dvd_card

private theorem jankoFour_degree_bound {n : ℕ} (hn : 1 < n)
    (hd : 2^n * ((2^n)^2-1) ∣ 86775571046077562880) : n ≤ 5 := by
  have hp : 2^n ∣ 86775571046077562880 := (dvd_mul_right _ _).trans hd
  have hb : n < 22 := by
    by_contra! h
    have hbig := (show 2^22 ∣ 2^n from pow_dvd_pow 2 h).trans hp
    norm_num at hbig
  interval_cases n <;> norm_num at hn ⊢ <;> norm_num at hd

private theorem rudvalis_degree_bound {n : ℕ} (hn : 1 < n)
    (hd : 2^n * ((2^n)^2-1) ∣ 145926144000) : n ≤ 6 := by
  have hp : 2^n ∣ 145926144000 := (dvd_mul_right _ _).trans hd
  have hb : n < 15 := by
    by_contra! h
    have hbig := (show 2^15 ∣ 2^n from pow_dvd_pow 2 h).trans hp
    norm_num at hbig
  interval_cases n <;> norm_num at hn ⊢ <;> norm_num at hd

private theorem order_two_mod_thirtySeven : orderOf (2 : ZMod 37) = 36 := by
  apply (orderOf_eq_iff (by decide : 0 < 36)).mpr
  constructor
  · decide
  · intro m hm hpos
    interval_cases m <;> norm_num at * <;> decide

private theorem order_two_mod_twentyNine : orderOf (2 : ZMod 29) = 28 := by
  apply (orderOf_eq_iff (by decide : 0 < 28)).mpr
  constructor
  · decide
  · intro m hm hpos
    interval_cases m <;> norm_num at * <;> decide

private theorem order_two_mod_nineteen : orderOf (2 : ZMod 19) = 18 := by
  apply (orderOf_eq_iff (by decide : 0 < 18)).mpr
  constructor
  · decide
  · intro m hm hpos
    interval_cases m <;> norm_num at * <;> decide

variable {G : Type*} [Group G] [Finite G]
    {T : Sylow 2 G} {L V : Subgroup G} (D : ChosenModule T L V)
    (S : D.NonbinaryNaturalInput) {c : Coordinates D S.field} (f : InvariantFlag c)

private theorem prime_data {K : Subgroup G} (hLK : f.Li 1 ≤ K)
    (hm : ClassicalGroup.IsPSL (f.Li 1 ⧸ pCore 2 (f.Li 1)) 2 (2^S.field.degree))
    (hmodel : Nonempty ((K ⧸ pCore 2 K) ≃* Janko4.Model) ∨
      Nonempty ((K ⧸ pCore 2 K) ≃* Rudvalis.Model)) :
    center (K ⧸ pCore 2 K) = ⊥ ∧ 2 ≤ primeRank 3 (K ⧸ pCore 2 K) ∧
      ∃ r : ℕ, r.Prime ∧ r ≠ 2 ∧ r ∣ Nat.card (K ⧸ pCore 2 K) ∧
        3 * S.field.degree < orderOf (2 : ZMod r) := by
  have hd := binary_section_card_dvd hLK hm
  rcases hmodel with h | h <;> obtain ⟨e⟩ := h
  · have hc := (Nat.card_congr e.toEquiv).trans Janko4.Cardinality.model_card
    rw [hc] at hd
    have hb := jankoFour_degree_bound S.nonbinary hd
    refine ⟨?_,?_,37,by decide,by decide,?_,?_⟩
    · apply _root_.eq_bot_iff.mpr
      intro a ha
      exact e.map_eq_one_iff.mp (Janko4.model_center_eq_bot.le ((centerCongr e) ⟨a,ha⟩).property)
    · rw [primeRank_congr 3 e]
      exact ChapterA.Section03.OddPrime.SourceModels.FourSporadic.j4_three_rank_ge_two
    · rw [hc]; decide
    · rw [order_two_mod_thirtySeven]; omega
  · have hc := (Nat.card_congr e.toEquiv).trans Rudvalis.model_card
    rw [hc] at hd
    have hb := rudvalis_degree_bound S.nonbinary hd
    refine ⟨?_,?_,29,by decide,by decide,?_,?_⟩
    · apply _root_.eq_bot_iff.mpr
      intro a ha
      exact e.map_eq_one_iff.mp (Rudvalis.LowCentralizers.model_center_eq_bot.le
        ((centerCongr e) ⟨a,ha⟩).property)
    · rw [primeRank_congr 3 e]
      exact Rudvalis.three_rank_ge_two
    · rw [hc]; decide
    · rw [order_two_mod_twentyNine]; omega

/-- Neither of the two large sporadic carriers can act as the containing
component on the original natural plane, including its fixed summand. -/
theorem second_not_large_sporadic
    (hm : ClassicalGroup.IsPSL (f.Li 1 ⧸ pCore 2 (f.Li 1)) 2 (2 ^ S.field.degree))
    {K : Subgroup G} (hK : Source.ComponentIn (normalizer (f.Vi 1 : Set G)) K)
    (hLK : f.Li 1 ≤ K)
    (π : f.Li 1 →* SL(2,S.field.Carrier)) (hπ : Function.Surjective π)
    (p : Additive (f.Vi 1) →ₗ[ZMod 2] (Fin 2 → S.field.Carrier))
    (hp : Function.Surjective p)
    (hact : ∀ a : f.Li 1, ∀ v,
      p (flagAction f 1 ⟨a,(localResidual_le _ a.property).2⟩ v) =
        specialLinearNatural 2 (π a) (p v))
    (hk : ∀ v, p v = 0 ↔ (v.toMul : G) ∈ centralizer (L : Set G)) :
    ¬ (Nonempty ((K ⧸ pCore 2 K) ≃* Janko4.Model) ∨
      Nonempty ((K ⧸ pCore 2 K) ≃* Rudvalis.Model)) := by
  intro hmodel
  obtain ⟨hz,hr,r,hrp,hr2,hd,hbound⟩ := prime_data D S f hLK hm hmodel
  let : Fact r.Prime := ⟨hrp⟩
  let B := K.subgroupOf (normalizer (f.Vi 1 : Set G))
  let e : (B ⧸ pCore 2 B) ≃* (K ⧸ pCore 2 K) :=
    QuotientGroup.congr _ _ (subgroupOfEquivOfLe hK.1) (pCore_map_iso 2 _)
  have hrB : 2 ≤ primeRank 3 B := by
    rw [← primeRank_quotient_eq_of_isTwoGroup 3 (by decide) (pCore 2 B) pCore_isPGroup,
      primeRank_congr 3 e]
    exact hr
  let := ChapterA.Section03.cComponent_twoCore_quasisimple_of_three_rank
    (S.source.simpleQTKE.twoLocal_sqtk (f.normalizer_twoLocal 1)) hK.2 hrB
  let : IsQuasisimple (K ⧸ pCore 2 K) := IsQuasisimple.of_mulEquiv e
  let : Group.IsPerfect B := hK.2.perfect
  let : Group.IsPerfect K := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe hK.1).toMonoidHom) (subgroupOfEquivOfLe hK.1).surjective
  have hgen := prime_generation (A := K) (p := r) (by simpa [hz] using hd)
  have hdim := (second_cover_finrank_le D S f p hp hk).trans_lt hbound
  let ρ := (flagAction f 1).comp (inclusion hK.1)
  obtain ⟨g,hg⟩ := Matrix.SL2.exists_mulVec_eq S.field.Carrier
    (![1,0]) (![0,1]) (by simp) (by simp)
  obtain ⟨a,rfl⟩ := hπ g
  obtain ⟨v,hv⟩ := hp (![1,0])
  have he : flagAction f 1 ⟨a,(localResidual_le _ a.property).2⟩ v = v :=
    LinearMap.congr_fun (small_action_trivial ρ hr2 hgen hdim ⟨a,hLK a.property⟩) v
  have ha := hact a v
  rw [he,hv] at ha
  have hg' : specialLinearNatural 2 (π a) (![1,0]) = (![0,1]) := hg
  rw [hg'] at ha
  have hz := congrFun ha 0
  simp at hz

/-- The second-index source refinement in both large sporadic rows, with no
field-matching or exhaustive embedding-list premise. -/
theorem second_refinement_of_large_sporadic
    (hm : ClassicalGroup.IsPSL (f.Li 1 ⧸ pCore 2 (f.Li 1)) 2 (2 ^ S.field.degree))
    {K X : Subgroup G} (hK : Source.ComponentIn (normalizer (f.Vi 1 : Set G)) K)
    (hLK : f.Li 1 ≤ K)
    (π : f.Li 1 →* SL(2,S.field.Carrier)) (hπ : Function.Surjective π)
    (p : Additive (f.Vi 1) →ₗ[ZMod 2] (Fin 2 → S.field.Carrier))
    (hp : Function.Surjective p)
    (hact : ∀ a : f.Li 1, ∀ v,
      p (flagAction f 1 ⟨a,(localResidual_le _ a.property).2⟩ v) =
        specialLinearNatural 2 (π a) (p v))
    (hk : ∀ v, p v = 0 ↔ (v.toMul : G) ∈ centralizer (L : Set G))
    (hmodel : Nonempty ((K ⧸ pCore 2 K) ≃* Janko4.Model) ∨
      Nonempty ((K ⧸ pCore 2 K) ≃* Rudvalis.Model)) :
    RefinementAlternative T L (f.Li 0) (f.Li 1) K X 1 S.field.degree :=
  (second_not_large_sporadic D S f hm hK hLK π hπ p hp hact hk hmodel).elim

/-- The same prime-degree argument excludes J₁ on the full original plane.
The existing actual smaller-section comparison supplies field four. -/
theorem second_not_jankoOne
    (hm : ClassicalGroup.IsPSL (f.Li 1 ⧸ pCore 2 (f.Li 1)) 2 (2 ^ S.field.degree))
    {K : Subgroup G} (hK : Source.ComponentIn (normalizer (f.Vi 1 : Set G)) K)
    (hLK : f.Li 1 ≤ K)
    (π : f.Li 1 →* SL(2,S.field.Carrier)) (hπ : Function.Surjective π)
    (p : Additive (f.Vi 1) →ₗ[ZMod 2] (Fin 2 → S.field.Carrier))
    (hp : Function.Surjective p)
    (hact : ∀ a : f.Li 1, ∀ v,
      p (flagAction f 1 ⟨a,(localResidual_le _ a.property).2⟩ v) =
        specialLinearNatural 2 (π a) (p v))
    (hk : ∀ v, p v = 0 ↔ (v.toMul : G) ∈ centralizer (L : Set G)) :
    ¬ Nonempty ((K ⧸ pCore 2 K) ≃* Janko1.Model) := by
  intro hmodel
  let : Fact (Nat.Prime 19) := ⟨by decide⟩
  let : Group.IsPerfect (f.Li 1) := localResidual_perfect _
  have hn := Embedding.small_finite_parameters hLK S.nonbinary hm
    (show Embedding.SmallFiniteCarrier (K ⧸ pCore 2 K) from .inr (.inr hmodel))
  let B := K.subgroupOf (normalizer (f.Vi 1 : Set G))
  let : Group.IsPerfect B := hK.2.perfect
  let : Group.IsPerfect K := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe hK.1).toMonoidHom) (subgroupOfEquivOfLe hK.1).surjective
  let : IsSimpleGroup (K ⧸ pCore 2 K) := hmodel.some.isSimpleGroup
  have hz : center (K ⧸ pCore 2 K) = ⊥ := by
    rcases (inferInstance : (center (K ⧸ pCore 2 K)).Normal).eq_bot_or_eq_top with hz | hz
    · exact hz
    · exact (Group.IsPerfect.not_isMulCommutative (K ⧸ pCore 2 K)
        (center_eq_top_iff.mp hz)).elim
  let : IsQuasisimple (K ⧸ pCore 2 K) :=
    { toIsPerfect := inferInstance
      simple := ((QuotientGroup.quotientMulEquivOfEq hz).trans
        QuotientGroup.quotientBot).isSimpleGroup }
  have hd : 19 ∣ (center (K ⧸ pCore 2 K)).index := by
    rw [hz,index_bot,Nat.card_congr hmodel.some.toEquiv,Janko1.card_model]
    decide
  have hgen := prime_generation hd
  have hdim : Module.finrank (ZMod 2) (Additive (f.Vi 1)) < orderOf (2 : ZMod 19) := by
    have hb := second_cover_finrank_le D S f p hp hk
    rw [hn] at hb
    rw [order_two_mod_nineteen]
    omega
  let ρ := (flagAction f 1).comp (inclusion hK.1)
  obtain ⟨g,hg⟩ := Matrix.SL2.exists_mulVec_eq S.field.Carrier
    (![1,0]) (![0,1]) (by simp) (by simp)
  obtain ⟨a,rfl⟩ := hπ g
  obtain ⟨v,hv⟩ := hp (![1,0])
  have he : flagAction f 1 ⟨a,(localResidual_le _ a.property).2⟩ v = v :=
    LinearMap.congr_fun (small_action_trivial ρ (by decide : 19 ≠ 2) hgen hdim
      ⟨a,hLK a.property⟩) v
  have ha := hact a v
  rw [he,hv] at ha
  have hg' : specialLinearNatural 2 (π a) (![1,0]) = (![0,1]) := hg
  rw [hg'] at ha
  have hz := congrFun ha 0
  simp at hz

/-- The second-normalizer source refinement in the J₁ carrier row. -/
theorem second_refinement_of_jankoOne
    (hm : ClassicalGroup.IsPSL (f.Li 1 ⧸ pCore 2 (f.Li 1)) 2 (2 ^ S.field.degree))
    {K X : Subgroup G} (hK : Source.ComponentIn (normalizer (f.Vi 1 : Set G)) K)
    (hLK : f.Li 1 ≤ K)
    (π : f.Li 1 →* SL(2,S.field.Carrier)) (hπ : Function.Surjective π)
    (p : Additive (f.Vi 1) →ₗ[ZMod 2] (Fin 2 → S.field.Carrier))
    (hp : Function.Surjective p)
    (hact : ∀ a : f.Li 1, ∀ v,
      p (flagAction f 1 ⟨a,(localResidual_le _ a.property).2⟩ v) =
        specialLinearNatural 2 (π a) (p v))
    (hk : ∀ v, p v = 0 ↔ (v.toMul : G) ∈ centralizer (L : Set G))
    (hmodel : Nonempty ((K ⧸ pCore 2 K) ≃* Janko1.Model)) :
    RefinementAlternative T L (f.Li 0) (f.Li 1) K X 1 S.field.degree :=
  (second_not_jankoOne D S f hm hK hLK π hπ p hp hact hk hmodel).elim

