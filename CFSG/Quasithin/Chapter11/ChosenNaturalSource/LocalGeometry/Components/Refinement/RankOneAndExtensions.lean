private theorem small_GL_card_dvd {d : ℕ} (hd : d ≤ 6) :
    Nat.card (GL (Fin d) (ZMod 2)) ∣ 2^15 * 3^4 * 5 * 7^2 * 31 := by
  interval_cases d <;> rw [Matrix.card_GL_field] <;> norm_num [Fin.prod_univ_succ]

private theorem exceptionalPrime_not_small_GL {r d : ℕ}
    (hr : Source.ExceptionalPrime r) (hd : d ≤ 6) :
    ¬ r ∣ Nat.card (GL (Fin d) (ZMod 2)) := by
  intro hh
  have hh := hh.trans (small_GL_card_dvd hd)
  have he : r = 2 ∨ r = 3 ∨ r = 5 ∨ r = 7 ∨ r = 31 := by
    simp only [hr.1.dvd_mul] at hh
    rcases hh with (((h | h) | h) | h) | h
    · exact .inl ((Nat.dvd_prime Nat.prime_two).mp (hr.1.dvd_of_dvd_pow h) |>.resolve_left hr.1.ne_one)
    · exact .inr (.inl ((Nat.dvd_prime Nat.prime_three).mp (hr.1.dvd_of_dvd_pow h) |>.resolve_left hr.1.ne_one))
    · exact .inr (.inr (.inl ((Nat.dvd_prime Nat.prime_five).mp h |>.resolve_left hr.1.ne_one)))
    · exact .inr (.inr (.inr (.inl ((Nat.dvd_prime (by decide : Nat.Prime 7)).mp (hr.1.dvd_of_dvd_pow h) |>.resolve_left hr.1.ne_one))))
    · exact .inr (.inr (.inr (.inr ((Nat.dvd_prime (by decide : Nat.Prime 31)).mp h |>.resolve_left hr.1.ne_one))))
  rcases he with rfl | rfl | rfl | rfl | rfl <;> norm_num [Source.ExceptionalPrime] at hr

private theorem thirteen_not_small_GL {d : ℕ} (hd : d ≤ 6) :
    ¬ 13 ∣ Nat.card (GL (Fin d) (ZMod 2)) := by
  intro h
  have h := h.trans (small_GL_card_dvd hd)
  norm_num at h

private theorem simple_quotient_small_action {A W : Type*} [Group A] [Finite A]
    [Group.IsPerfect A] [IsSimpleGroup (A ⧸ pCore 2 A)]
    [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]
    {r : ℕ} (hr : r ∣ Nat.card (A ⧸ pCore 2 A))
    (ρ : Representation (ZMod 2) A W)
    (hbad : ¬ r ∣ Nat.card (GL (Fin (Module.finrank (ZMod 2) W)) (ZMod 2)))
    (a : A) : ρ a = 1 := by
  let φ := ρ.asGroupHom
  let N := φ.ker
  let q := QuotientGroup.mk' (pCore 2 A)
  let : (N.map q).Normal := (inferInstance : N.Normal).map q (QuotientGroup.mk'_surjective _)
  have hfull : N.map q = ⊤ := by
    rcases (inferInstance : (N.map q).Normal).eq_bot_or_eq_top with h | h
    · have hN : N ≤ pCore 2 A := by
        simpa only [q,MonoidHom.comap_bot,QuotientGroup.ker_mk'] using
          map_le_iff_le_comap.mp h.le
      have hdiv : r ∣ Nat.card φ.range := by
        have hi := hr.trans (index_dvd_of_le hN)
        simpa only [N,index_ker] using hi
      let R := φ.range
      let : Finite R := Finite.of_surjective _ φ.rangeRestrict_surjective
      let σ : Representation (ZMod 2) R W :=
        { toFun r := r.val.val
          map_one' := rfl
          map_mul' _ _ := rfl }
      have hf : Function.Injective σ := Units.val_injective.comp Subtype.val_injective
      exact (hbad (hdiv.trans (Representation.card_dvd_card_GL_of_injective σ hf))).elim
    · exact h
  have hs : N ⊔ pCore 2 A = ⊤ := by
    have he := congrArg (comap q) hfull
    simpa only [comap_map_eq,q,QuotientGroup.ker_mk',comap_top] using he
  let : Group.IsNilpotent (A ⧸ N) :=
    (isPGroup_quotient_of_sup_eq_top N (pCore 2 A) pCore_isPGroup hs).isNilpotent
  have hN : N = ⊤ := top_unique (by simpa only [solvableResidual_eq_top] using
    solvableResidual_le_of_solvable_quotient N)
  have ha : a ∈ N := hN ▸ mem_top a
  exact congrArg Units.val ha

private theorem primeLinear_data {A : Type*} [Group A] [Finite A] {r : ℕ}
    (hr : Source.ExceptionalPrime r) (ho : Odd r)
    (hm : ClassicalGroup.IsPSL A 2 r) : IsSimpleGroup A ∧ r ∣ Nat.card A := by
  obtain ⟨F,_,_,hF,⟨e⟩⟩ := hm
  have hlarge : 4 ≤ r := by
    by_contra! h
    interval_cases r <;> norm_num [Source.ExceptionalPrime] at hr
  let : IsSimpleGroup PSL(2,F) := Matrix.ProjectiveSpecialLinearGroup.rank_two_simple (hF ▸ hlarge)
  refine ⟨e.isSimpleGroup,?_⟩
  rw [Nat.card_congr e.toEquiv]
  have hc := Matrix.ProjectiveSpecialLinearGroup.psl2_card_twice (F := F) (hF.symm ▸ ho)
  rw [hF] at hc
  have hd : r ∣ Nat.card PSL(2,F) * 2 := hc.symm ▸ dvd_mul_right r (r^2-1)
  have hr2 : r ≠ 2 := by omega
  exact (hr.1.dvd_mul.mp hd).resolve_right (fun h => hr2
    (((Nat.dvd_prime Nat.prime_two).mp h).resolve_left hr.1.ne_one))

private theorem twentyFive_data {A : Type*} [Group A] [Finite A]
    (hm : ClassicalGroup.IsPSL A 2 25) : IsSimpleGroup A ∧ 13 ∣ Nat.card A := by
  obtain ⟨F,_,_,hF,⟨e⟩⟩ := hm
  let : IsSimpleGroup PSL(2,F) := Matrix.ProjectiveSpecialLinearGroup.rank_two_simple (by omega)
  refine ⟨e.isSimpleGroup,?_⟩
  rw [Nat.card_congr e.toEquiv,Theory.PSL2.TwentyFive.card hF]
  decide


private theorem elementary_extension_generated {A : Type*} [Group A] [Finite A]
    {r : ℕ} (hr : r.Prime)
    (hm : Chapter1.Section02.LocalModels.HasExtension A
      (Chapter1.Section02.LocalModels.ElementaryModel r 2) (fun Q _ => Source.IsSL Q 2 r)) :
    primeToResidual r A = ⊤ := by
  let : Fact r.Prime := ⟨hr⟩
  obtain ⟨N,hN,⟨eN⟩,F,_,_,hF,⟨e⟩⟩ := hm
  let := hN
  let : Fintype F := Fintype.ofFinite F
  let : CharP F r := charP_of_card_eq_prime_pow (f := 1)
    (by simpa only [Nat.card_eq_fintype_card,pow_one] using hF)
  have hcard : Nat.card N = r ^ 2 := by
    rw [Nat.card_congr eN.toEquiv]
    change Nat.card (Fin 2 → ZMod r) = r ^ 2
    rw [Nat.card_fun]
    simp only [Nat.card_fin,Nat.card_zmod]
  have hNR : N ≤ primeToResidual r A := le_primeToResidual_of_isPGroup
    (IsPGroup.of_card hcard)
  let q := QuotientGroup.mk' N
  have hquot : primeToResidual r (A ⧸ N) = ⊤ := by
    apply top_unique
    intro a _
    simpa only [MulEquiv.coe_toMonoidHom,MulEquiv.symm_apply_apply] using
      Matrix.SL2.map_mem_primeToResidual r e.symm.toMonoidHom (e a)
  have he := congrArg (comap q) (map_primeToResidual_of_surjective r q
    (QuotientGroup.mk'_surjective N))
  rw [hquot,comap_top,comap_map_eq,QuotientGroup.ker_mk',sup_eq_left.mpr hNR] at he
  exact he

private theorem generated_above_twoCore {A : Type*} [Group A] [Finite A]
    [Group.IsPerfect A] {r : ℕ} [Fact r.Prime]
    (hgen : primeToResidual r (A ⧸ pCore 2 A) = ⊤) : primeToResidual r A = ⊤ := by
  let N := primeToResidual r A
  let q := QuotientGroup.mk' (pCore 2 A)
  have he := congrArg (comap q) (map_primeToResidual_of_surjective r q
    (QuotientGroup.mk'_surjective _))
  have hs : N ⊔ pCore 2 A = ⊤ := by
    simpa only [hgen,comap_map_eq,q,QuotientGroup.ker_mk',comap_top] using he
  let : Group.IsNilpotent (A ⧸ N) :=
    (isPGroup_quotient_of_sup_eq_top N (pCore 2 A) pCore_isPGroup hs).isNilpotent
  exact top_unique (by simpa only [solvableResidual_eq_top] using
    solvableResidual_le_of_solvable_quotient N)

private theorem generated_small_action {A W : Type*} [Group A] [Finite A]
    [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]
    {r : ℕ} (hr : r.Prime) (hgen : primeToResidual r A = ⊤)
    (ρ : Representation (ZMod 2) A W)
    (hbad : ¬ r ∣ Nat.card (GL (Fin (Module.finrank (ZMod 2) W)) (ZMod 2)))
    (a : A) : ρ a = 1 := by
  let R := ρ.asGroupHom.range
  let : Finite R := Finite.of_surjective _ ρ.asGroupHom.rangeRestrict_surjective
  let σ : Representation (ZMod 2) R W :=
    { toFun r := r.val.val
      map_one' := rfl
      map_mul' _ _ := rfl }
  have hf : Function.Injective σ := Units.val_injective.comp Subtype.val_injective
  have hc : Nat.Coprime r (Nat.card R) := hr.coprime_iff_not_dvd.mpr
    (fun hh => hbad (hh.trans (Representation.card_dvd_card_GL_of_injective σ hf)))
  have hk := primeToResidual_le_ker ρ.asGroupHom.rangeRestrict hc
  rw [hgen] at hk
  have he := hk (show a ∈ (⊤ : Subgroup A) from trivial)
  exact congrArg (fun x : R => x.val.val) he

variable {G : Type*} [Group G] [Finite G]
    {T : Sylow 2 G} {L V : Subgroup G} (D : ChosenModule T L V)
    (S : D.NonbinaryNaturalInput) {c : Coordinates D S.field} (f : InvariantFlag c)

private theorem second_not_simple_small_prime
    {K : Subgroup G} (hK : Source.ComponentIn (normalizer (f.Vi 1 : Set G)) K)
    (hLK : f.Li 1 ≤ K) [IsSimpleGroup (K ⧸ pCore 2 K)]
    {r : ℕ} (hr : r ∣ Nat.card (K ⧸ pCore 2 K))
    (hbad : ∀ d ≤ 6, ¬ r ∣ Nat.card (GL (Fin d) (ZMod 2)))
    (hn : S.field.degree = 2)
    (π : f.Li 1 →* SL(2,S.field.Carrier)) (hπ : Function.Surjective π)
    (p : Additive (f.Vi 1) →ₗ[ZMod 2] (Fin 2 → S.field.Carrier))
    (hp : Function.Surjective p)
    (hact : ∀ a : f.Li 1, ∀ v,
      p (flagAction f 1 ⟨a,(localResidual_le _ a.property).2⟩ v) =
        specialLinearNatural 2 (π a) (p v))
    (hk : ∀ v, p v = 0 ↔ (v.toMul : G) ∈ centralizer (L : Set G)) : False := by
  let : Group.IsPerfect (K.subgroupOf (normalizer (f.Vi 1 : Set G))) := hK.2.perfect
  let : Group.IsPerfect K := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe hK.1).toMonoidHom) (subgroupOfEquivOfLe hK.1).surjective
  have hdim : Module.finrank (ZMod 2) (Additive (f.Vi 1)) ≤ 6 := by
    simpa only [hn] using second_cover_finrank_le D S f p hp hk
  let ρ := (flagAction f 1).comp (inclusion hK.1)
  obtain ⟨g,hg⟩ := Matrix.SL2.exists_mulVec_eq S.field.Carrier
    (![1,0]) (![0,1]) (by simp) (by simp)
  obtain ⟨a,rfl⟩ := hπ g
  obtain ⟨v,hv⟩ := hp (![1,0])
  have he : flagAction f 1 ⟨a,(localResidual_le _ a.property).2⟩ v = v :=
    LinearMap.congr_fun (simple_quotient_small_action hr ρ (hbad _ hdim) ⟨a,hLK a.property⟩) v
  have ha := hact a v
  rw [he,hv] at ha
  have hg' : specialLinearNatural 2 (π a) (![1,0]) = (![0,1]) := hg
  rw [hg'] at ha
  have hz := congrFun ha 0
  simp at hz

/-- A proper odd prime-field rank-one carrier cannot extend the actual
natural action of L₂ to the full original plane. -/
theorem second_not_primeLinear_of_proper
    (hm : ClassicalGroup.IsPSL (f.Li 1 ⧸ pCore 2 (f.Li 1)) 2 (2 ^ S.field.degree))
    {K : Subgroup G} (hK : Source.ComponentIn (normalizer (f.Vi 1 : Set G)) K)
    (hLK : f.Li 1 < K) {r : ℕ} (hr : r.Prime) (ho : Odd r)
    (π : f.Li 1 →* SL(2,S.field.Carrier)) (hπ : Function.Surjective π)
    (p : Additive (f.Vi 1) →ₗ[ZMod 2] (Fin 2 → S.field.Carrier))
    (hp : Function.Surjective p)
    (hact : ∀ a : f.Li 1, ∀ v,
      p (flagAction f 1 ⟨a,(localResidual_le _ a.property).2⟩ v) =
        specialLinearNatural 2 (π a) (p v))
    (hk : ∀ v, p v = 0 ↔ (v.toMul : G) ∈ centralizer (L : Set G)) :
    ¬ ClassicalGroup.IsPSL (K ⧸ pCore 2 K) 2 r := by
  intro hmodel
  obtain ⟨hn,hr'⟩ := (Embedding.flag_odd_rank_one_parameters D S f 1 hm hK hLK hr ho).1 hmodel
  obtain ⟨hs,hd⟩ := primeLinear_data hr' ho hmodel
  let := hs
  exact second_not_simple_small_prime D S f hK hLK.le hd
    (fun _ hd => exceptionalPrime_not_small_GL hr' hd) hn π hπ p hp hact hk

/-- A proper quadratic odd rank-one carrier forces PSL₂(25), whose
thirteen-elements cannot act nontrivially on the full six-dimensional plane. -/
theorem second_not_quadratic_rank_one_of_proper
    (hm : ClassicalGroup.IsPSL (f.Li 1 ⧸ pCore 2 (f.Li 1)) 2 (2 ^ S.field.degree))
    {K : Subgroup G} (hK : Source.ComponentIn (normalizer (f.Vi 1 : Set G)) K)
    (hLK : f.Li 1 < K) {r : ℕ} (hr : r.Prime) (ho : Odd r)
    (π : f.Li 1 →* SL(2,S.field.Carrier)) (hπ : Function.Surjective π)
    (p : Additive (f.Vi 1) →ₗ[ZMod 2] (Fin 2 → S.field.Carrier))
    (hp : Function.Surjective p)
    (hact : ∀ a : f.Li 1, ∀ v,
      p (flagAction f 1 ⟨a,(localResidual_le _ a.property).2⟩ v) =
        specialLinearNatural 2 (π a) (p v))
    (hk : ∀ v, p v = 0 ↔ (v.toMul : G) ∈ centralizer (L : Set G)) :
    ¬ ClassicalGroup.IsPSL (K ⧸ pCore 2 K) 2 (r^2) := by
  intro hmodel
  obtain ⟨hn,hr5⟩ := (Embedding.flag_odd_rank_one_parameters D S f 1 hm hK hLK hr ho).2 hmodel
  have h25 : ClassicalGroup.IsPSL (K ⧸ pCore 2 K) 2 25 := by simpa [hr5] using hmodel
  obtain ⟨hs,hd⟩ := twentyFive_data h25
  let := hs
  exact second_not_simple_small_prime D S f hK hLK.le hd
    (fun _ hd => thirteen_not_small_GL hd) hn π hπ p hp hact hk

/-- The entire rank-one carrier family gives equality at the second flag
normalizer, with the binary field and odd prime restrictions derived. -/
theorem second_refinement_of_rank_one
    (hm : ClassicalGroup.IsPSL (f.Li 1 ⧸ pCore 2 (f.Li 1)) 2 (2 ^ S.field.degree))
    {K X : Subgroup G} (hK : Source.ComponentIn (normalizer (f.Vi 1 : Set G)) K)
    (hLK : f.Li 1 ≤ K)
    (π : f.Li 1 →* SL(2,S.field.Carrier)) (hπ : Function.Surjective π)
    (p : Additive (f.Vi 1) →ₗ[ZMod 2] (Fin 2 → S.field.Carrier))
    (hp : Function.Surjective p)
    (hact : ∀ a : f.Li 1, ∀ v,
      p (flagAction f 1 ⟨a,(localResidual_le _ a.property).2⟩ v) =
        specialLinearNatural 2 (π a) (p v))
    (hk : ∀ v, p v = 0 ↔ (v.toMul : G) ∈ centralizer (L : Set G))
    (hmodel : (∃ m, 1 < m ∧ ClassicalGroup.IsPSL (K ⧸ pCore 2 K) 2 (2 ^ m)) ∨
      ∃ r, r.Prime ∧ Odd r ∧ (ClassicalGroup.IsPSL (K ⧸ pCore 2 K) 2 r ∨
        ClassicalGroup.IsPSL (K ⧸ pCore 2 K) 2 (r ^ 2))) :
    RefinementAlternative T L (f.Li 0) (f.Li 1) K X 1 S.field.degree := by
  by_cases he : f.Li 1 = K
  · exact .equal (by simpa using he)
  rcases hmodel with ⟨m,hm',hmodel⟩ | ⟨r,hr,ho,hmodel⟩
  · exact .equal (by simpa using Embedding.flag_eq_of_binary_rank_one D S f 1 hm hK hLK hm' hmodel)
  have hlt := lt_of_le_of_ne hLK he
  rcases hmodel with hmodel | hmodel
  · exact (second_not_primeLinear_of_proper D S f hm hK hlt hr ho π hπ p hp hact hk hmodel).elim
  · exact (second_not_quadratic_rank_one_of_proper D S f hm hK hlt hr ho π hπ p hp hact hk hmodel).elim

/-- Field-four uniqueness for rank-one carriers uses the actual central-kernel
argument on full V₂, after discharging second-component equality. -/
theorem uniqueNoncentral_second_fieldFour_of_rank_one
    (hm : ClassicalGroup.IsPSL (f.Li 1 ⧸ pCore 2 (f.Li 1)) 2 (2 ^ S.field.degree))
    (hfour : S.field.degree = 2)
    {K : Subgroup G} (hK : Source.ComponentIn (normalizer (f.Vi 1 : Set G)) K)
    (hLK : f.Li 1 ≤ K)
    (π : f.Li 1 →* SL(2,S.field.Carrier)) (hπ : Function.Surjective π)
    (p : Additive (f.Vi 1) →ₗ[ZMod 2] (Fin 2 → S.field.Carrier))
    (hp : Function.Surjective p)
    (hact : ∀ a : f.Li 1, ∀ v,
      p (flagAction f 1 ⟨a,(localResidual_le _ a.property).2⟩ v) =
        specialLinearNatural 2 (π a) (p v))
    (hk : ∀ v, p v = 0 ↔ (v.toMul : G) ∈ centralizer (L : Set G))
    (hcore : (f.Li 1).pCoreIn 2 ≤ centralizer (f.Vi 1 : Set G))
    (hmodel : (∃ m, 1 < m ∧ ClassicalGroup.IsPSL (K ⧸ pCore 2 K) 2 (2 ^ m)) ∨
      ∃ r, r.Prime ∧ Odd r ∧ (ClassicalGroup.IsPSL (K ⧸ pCore 2 K) 2 r ∨
        ClassicalGroup.IsPSL (K ⧸ pCore 2 K) 2 (r ^ 2))) :
    Source.UniqueNoncentralComponent (normalizer (f.Vi 1 : Set G)) (f.Vi 1) (f.Li 1) := by
  have he := (second_refinement_of_rank_one D S f hm (X := ⊥) hK hLK π hπ p hp hact hk hmodel).second_eq
  apply uniqueNoncentral_second_fieldFour_of_natural_cover S f hfour _ π hπ p hp hact hk hcore
  rw [he]
  exact hK

/-- The elementary odd-kernel source row is excluded on full V₂ by
prime-element generation in its actual, possibly nonsplit extension. -/
theorem second_not_elementary_extension
    (hm : ClassicalGroup.IsPSL (f.Li 1 ⧸ pCore 2 (f.Li 1)) 2 (2 ^ S.field.degree))
    {K : Subgroup G} (hK : Source.ComponentIn (normalizer (f.Vi 1 : Set G)) K)
    (hLK : f.Li 1 ≤ K) {r : ℕ} (hr : Source.ExceptionalPrime r)
    (π : f.Li 1 →* SL(2,S.field.Carrier)) (hπ : Function.Surjective π)
    (p : Additive (f.Vi 1) →ₗ[ZMod 2] (Fin 2 → S.field.Carrier))
    (hp : Function.Surjective p)
    (hact : ∀ a : f.Li 1, ∀ v,
      p (flagAction f 1 ⟨a,(localResidual_le _ a.property).2⟩ v) =
        specialLinearNatural 2 (π a) (p v))
    (hk : ∀ v, p v = 0 ↔ (v.toMul : G) ∈ centralizer (L : Set G)) :
    ¬ Chapter1.Section02.LocalModels.HasExtension (K ⧸ pCore 2 K)
      (Chapter1.Section02.LocalModels.ElementaryModel r 2) (fun Q _ => Source.IsSL Q 2 r) := by
  intro hmodel
  let : Group.IsPerfect (f.Li 1) := localResidual_perfect _
  have hfour := Embedding.odd_extension_parameters hLK S.nonbinary hm (.inr ⟨r,hr,hmodel⟩)
  let : Fact r.Prime := ⟨hr.1⟩
  let : Group.IsPerfect (K.subgroupOf (normalizer (f.Vi 1 : Set G))) := hK.2.perfect
  let : Group.IsPerfect K := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe hK.1).toMonoidHom) (subgroupOfEquivOfLe hK.1).surjective
  have hgen := generated_above_twoCore (elementary_extension_generated hr.1 hmodel)
  have hdim : Module.finrank (ZMod 2) (Additive (f.Vi 1)) ≤ 6 := by
    simpa only [hfour] using second_cover_finrank_le D S f p hp hk
  let ρ := (flagAction f 1).comp (inclusion hK.1)
  obtain ⟨g,hg⟩ := Matrix.SL2.exists_mulVec_eq S.field.Carrier
    (![1,0]) (![0,1]) (by simp) (by simp)
  obtain ⟨a,rfl⟩ := hπ g
  obtain ⟨v,hv⟩ := hp (![1,0])
  have he : flagAction f 1 ⟨a,(localResidual_le _ a.property).2⟩ v = v :=
    LinearMap.congr_fun (generated_small_action hr.1 hgen ρ
      (exceptionalPrime_not_small_GL hr hdim) ⟨a,hLK a.property⟩) v
  have ha := hact a v
  rw [he,hv] at ha
  have hg' : specialLinearNatural 2 (π a) (![1,0]) = (![0,1]) := hg
  rw [hg'] at ha
  have hz := congrFun ha 0
  simp at hz

/-- The source elementary-extension refinement at the second index. -/
theorem second_refinement_of_elementary_extension
    (hm : ClassicalGroup.IsPSL (f.Li 1 ⧸ pCore 2 (f.Li 1)) 2 (2 ^ S.field.degree))
    {K X : Subgroup G} (hK : Source.ComponentIn (normalizer (f.Vi 1 : Set G)) K)
    (hLK : f.Li 1 ≤ K) {r : ℕ} (hr : Source.ExceptionalPrime r)
    (π : f.Li 1 →* SL(2,S.field.Carrier)) (hπ : Function.Surjective π)
    (p : Additive (f.Vi 1) →ₗ[ZMod 2] (Fin 2 → S.field.Carrier))
    (hp : Function.Surjective p)
    (hact : ∀ a : f.Li 1, ∀ v,
      p (flagAction f 1 ⟨a,(localResidual_le _ a.property).2⟩ v) =
        specialLinearNatural 2 (π a) (p v))
    (hk : ∀ v, p v = 0 ↔ (v.toMul : G) ∈ centralizer (L : Set G))
    (hmodel : Chapter1.Section02.LocalModels.HasExtension (K ⧸ pCore 2 K)
      (Chapter1.Section02.LocalModels.ElementaryModel r 2) (fun Q _ => Source.IsSL Q 2 r)) :
    RefinementAlternative T L (f.Li 0) (f.Li 1) K X 1 S.field.degree :=
  (second_not_elementary_extension D S f hm hK hLK hr π hπ p hp hact hk hmodel).elim

/-- Both odd-extension rows give the first refinement with field four
proved from the original smaller section, retaining the exact two-odd quotient. -/
theorem first_refinement_of_odd_extension_carrier
    (hm : ClassicalGroup.IsPSL (f.Li 0 ⧸ pCore 2 (f.Li 0)) 2 (2 ^ S.field.degree))
    {K X : Subgroup G} (_hK : Source.ComponentIn (normalizer (f.Vi 0 : Set G)) K)
    (hLK : f.Li 0 ≤ K) (hmodel : Embedding.OddExtensionCarrier (K ⧸ pCore 2 K)) :
    RefinementAlternative T L (f.Li 0) (f.Li 1) K X 0 S.field.degree := by
  let : Group.IsPerfect (f.Li 0) := localResidual_perfect _
  exact first_refinement_of_odd_extension_rows S f K X
    (Embedding.odd_extension_parameters hLK S.nonbinary hm hmodel) hmodel

/-- At arbitrary field degree, rank-one carriers discharge the component
premise in full-plane uniqueness via the preceding radical action. -/
theorem uniqueNoncentral_second_of_rank_one
    (hm : ClassicalGroup.IsPSL (f.Li 1 ⧸ pCore 2 (f.Li 1)) 2 (2 ^ S.field.degree))
    {K : Subgroup G} (hK : Source.ComponentIn (normalizer (f.Vi 1 : Set G)) K)
    (hLK : f.Li 1 ≤ K)
    (hR : f.Ri 1 ≤ centralizer (f.Vi 1 : Set G))
    (π : f.Li 1 →* SL(2,S.field.Carrier)) (hπ : Function.Surjective π)
    (p : Additive (f.Vi 1) →ₗ[ZMod 2] (Fin 2 → S.field.Carrier))
    (hp : Function.Surjective p)
    (hact : ∀ a : f.Li 1, ∀ v,
      p (flagAction f 1 ⟨a,(localResidual_le _ a.property).2⟩ v) =
        specialLinearNatural 2 (π a) (p v))
    (hk : ∀ v, p v = 0 ↔ (v.toMul : G) ∈ centralizer (L : Set G))
    (hmodel : (∃ m, 1 < m ∧ ClassicalGroup.IsPSL (K ⧸ pCore 2 K) 2 (2 ^ m)) ∨
      ∃ r, r.Prime ∧ Odd r ∧ (ClassicalGroup.IsPSL (K ⧸ pCore 2 K) 2 r ∨
        ClassicalGroup.IsPSL (K ⧸ pCore 2 K) 2 (r ^ 2))) :
    Source.UniqueNoncentralComponent (normalizer (f.Vi 1 : Set G)) (f.Vi 1) (f.Li 1) := by
  have he := (second_refinement_of_rank_one D S f hm (X := ⊥) hK hLK π hπ p hp hact hk hmodel).second_eq
  apply uniqueNoncentral_second_of_radical_and_natural_action S f _ hm hR π hπ p hp hact
  rw [he]
  exact hK

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry.Components
