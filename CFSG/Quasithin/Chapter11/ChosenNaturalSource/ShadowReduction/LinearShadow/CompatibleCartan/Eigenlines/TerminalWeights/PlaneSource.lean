module
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.LinearShadow.CompatibleCartan.Eigenlines.TerminalWeights.GeneratorSource
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.LinearShadow.CompatibleCartan.Eigenlines.TerminalWeights.Source
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.LinearShadow.CompatibleCartan.Eigenlines.TerminalWeights.CommonPlane
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.LinearShadow.CompatibleCartan.Eigenlines.TerminalWeights.Spectrum
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.LinearShadow.CompatibleCartan.Eigenlines.TerminalWeights.OrbitSpan
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.LinearShadow.CompatibleCartan.Eigenlines.TerminalWeights.TransportSpectrum
/-!
# The source Cartan generator and its two actual eigenspaces

The source Cartan and ordered quotient marking construct a generator of the
literal X intersect K and a primitive split coefficient. The natural common
plane is scalar by the SL2 commutant calculation. The actual invariant
complement W2 selects the other coefficient. Determinant one identifies the
two weights as inverses in the exact restriction field. The resulting full
eigenspaces are V2 and the subgroup generated by the L2-conjugates of W2.

The original D, S, SL3 coordinates, flag, cores, odd degree and Cartan are
retained. Preceding common-core geometry and the separate action markings are
the authorized inputs of qt-d-1222-shadow-common-core and
qt-d-1222-shadow-cartan-marked-sections. No generator, torus-image, scalar-plane
or terminal-weight hypothesis is supplied by the caller.

Source: Aschbacher--Smith, Proposition 11.3.2, final paragraph, printed p.775.
-/

open Subgroup Representation
open scoped IsMulCommutative
@[expose] public noncomputable section
set_option backward.isDefEq.respectTransparency false
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.CompatibleCartan.TerminalWeights
open CFSG.Quasithin.Chapter12.Section02 LocalGeometry
open CFSG.Quasithin.ChapterB.QuasisimpleSource
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    (D : ChosenModule T L V) (S : D.NonbinaryNaturalInput)
    (m : ActionEquiv D.centralQuotientAction (linearNatural S.field 3))
    (f : InvariantFlag (.sl3 m)) {P I K X : Subgroup G}
    [IsMulCommutative P] [IsMulCommutative V]
    (hfixed : V ⊓ centralizer (L : Set G) = ⊥)
    (E : BinaryField) (o : CommonCore.OrthogonalMarking (f.Li 1 ⊔ I) P K (f.Li 1) E)
    (hcard : Nat.card E.Carrier = Nat.card S.field.Carrier)
    (hP : P = (f.Li 1).pCoreIn 2) (hcore : L.pCoreIn 2 = V)
    (hPV : P ⊓ V = f.Vi 1) (hVI : V ≤ I)
    (hX : IsCartan T L X) (hXY : X ≤ f.Li 1 ⊔ I)
    (hodd : Odd S.field.degree)
    (hPK : P = K.pCoreIn 2) (hPT : P ≤ T)
    (hTY : (T : Subgroup G) ≤ f.Li 1 ⊔ I) (hTL : (T : Subgroup G) ≤ L)

include hX hodd hPK hPT hTY hTL in
/-- Construct the primitive complementary scalar planes for the actual
Cartan generator. The common plane is literally V₂, and the supplied W₂
is the invariant field line complementary to the actual radical hyperplane. -/
theorem source_plane_spectrum :
    let := originalModule D (.sl3 m) hfixed
    let s := orderedSection o
    let := s.moduleStructure
    let d := MarkedSections.extractedPlaneActions D S m f P I hfixed E s hP hcore hPV hVI
    let := d.compatibleModule hcard
    let σ := d.restrictionDatum.compatibleRepresentation hcard s.action
    let U := SeparatePlaneActions.fixedPlane (V := V) σ
    ∀ W₂ : Submodule S.field.Carrier (Additive P),
      Module.finrank S.field.Carrier W₂ = 1 →
      Disjoint (P ⊓ f.Ri 0) (ambientSubgroup W₂) →
      X ≤ normalizer (ambientSubgroup W₂ : Set G) →
      ∃ y : (X ⊓ K : Subgroup G), ∃ lam : S.field.Carrier,
      ∃ Q : Submodule S.field.Carrier (Additive P),
        (∀ z : (X ⊓ K : Subgroup G), ∃ n : ℤ, y ^ n = z) ∧
        lam ≠ 0 ∧ orderOf lam = 2 ^ S.field.degree - 1 ∧
        IsCompl U Q ∧ W₂ ≤ Q ∧ Module.finrank S.field.Carrier Q = 2 ∧
        (∀ p ∈ U, σ ⟨y,hXY y.property.1⟩ p = lam⁻¹ • p) ∧
        (∀ p ∈ Q, σ ⟨y,hXY y.property.1⟩ p = lam • p) ∧
        LinearMap.ker (σ ⟨y,hXY y.property.1⟩ - lam⁻¹ • LinearMap.id) = U ∧
        LinearMap.ker (σ ⟨y,hXY y.property.1⟩ - lam • LinearMap.id) = Q ∧
        orbitSpace (σ.comp (inclusion o.second_le)) W₂ = Q ∧
        ambientSubgroup U = f.Vi 1 ∧
        ambientSubgroup Q = ⨆ a : f.Li 1,
          (ambientSubgroup W₂).map (MulAut.conj (a : G)).toMonoidHom := by
  let := originalModule D (.sl3 m) hfixed
  let s := orderedSection o
  let := s.moduleStructure
  let d := MarkedSections.extractedPlaneActions D S m f P I hfixed E s hP hcore hPV hVI
  let := d.compatibleModule hcard
  let σ := d.restrictionDatum.compatibleRepresentation hcard s.action
  let U := SeparatePlaneActions.fixedPlane (V := V) σ
  dsimp only
  intro W₂ hd₂ hdis hn₂
  obtain ⟨y,hygen,hy₂,b,a,ha,hao,hdiag⟩ := source_split_generator D S m f E
    o.toProductQuotientMarking hcard hPK hPT hTY hTL hX hXY
  let yp : (f.Li 1 ⊔ I : Subgroup G) := ⟨y,hXY y.property.1⟩
  obtain ⟨e,he⟩ := compatible_split_coordinates s d.restrictionDatum hcard yp hy₂ b a hdiag
  let φ := d.restrictionDatum.fieldEquiv hcard
  have ha' : φ a ≠ 0 := (map_ne_zero φ).mpr ha
  have hao' : orderOf (φ a) = 2 ^ S.field.degree - 1 :=
    (compatible_orderOf d.restrictionDatum hcard a).trans hao
  have hab : φ a ≠ (φ a)⁻¹ := by
    intro hab
    have hs : (φ a)^2 = 1 := by
      rw [sq]
      calc φ a * φ a = (φ a)⁻¹ * φ a := congrArg (fun z => z * φ a) hab
           _ = 1 := inv_mul_cancel₀ ha'
    have ha1 : φ a = 1 := CharTwo.sq_injective (hs.trans (one_pow 2).symm)
    have hq : 8 ≤ 2 ^ S.field.degree := by
      change (2 : ℕ)^3 ≤ 2^S.field.degree
      apply Nat.pow_le_pow_right (by decide : 1 ≤ 2)
      obtain ⟨k,hk⟩ := hodd
      have := S.nonbinary
      omega
    rw [ha1,orderOf_one] at hao'
    omega
  have hσ (z : (f.Li 1 ⊔ I : Subgroup G)) (p : Additive P) :
      ((σ z p).toMul : G) = MulAut.conj (z : G) (p.toMul : G) := s.action_conj z p
  obtain ⟨hU,_,hdU,_⟩ := MarkedSections.common_plane_sections D S m f P I σ hσ
    hP hcore hPV hVI (s.finrank_of_same_field S.field hcard)
  have hdUW : Disjoint U W₂ := by
    apply Submodule.disjoint_def.mpr
    intro p hp hw
    apply Additive.toMul.injective
    apply Subtype.ext
    have hpV : (p.toMul : G) ∈ f.Vi 1 := hU ▸ (mem_ambientSubgroup U p.toMul).mpr hp
    have hpR : (p.toMul : G) ∈ f.Ri 0 :=
      f.seed_le_Ri S 0 (D.centralQuotientPreimage_le _ hpV)
    exact Subgroup.disjoint_def.mp hdis ⟨p.toMul.property,hpR⟩
      ((mem_ambientSubgroup W₂ p.toMul).mpr hw)
  obtain ⟨c,hc⟩ := source_common_plane_scalar D S m f hfixed E o hcard
    hP hcore hPV hVI hX hXY y
  have hi₂ : ∀ w ∈ W₂, σ yp w ∈ W₂ :=
    MarkedSections.invariant_of_normalizes W₂ (σ.comp (inclusion hXY))
      (fun x p => hσ (inclusion hXY x) p) hn₂ ⟨y,y.property.1⟩
  obtain ⟨Q,lam,hcompl,hW₂,hdQ,hcases,hQ⟩ := complementary_spectrum e (σ yp)
    (φ a) (φ a)⁻¹ he (by simp) hab U W₂ hdU hd₂ hdUW c hc hi₂
  have hlam : lam ≠ 0 := by
    rcases hcases with ⟨_,rfl⟩ | ⟨_,rfl⟩
    · exact inv_ne_zero ha'
    · exact ha'
  have hlamo : orderOf lam = 2 ^ S.field.degree - 1 := by
    rcases hcases with ⟨_,rfl⟩ | ⟨_,rfl⟩
    · calc
        orderOf (φ a)⁻¹ = orderOf ((Units.mk0 (φ a) ha')⁻¹) := by
          simpa only [Units.val_inv_eq_inv_val,Units.val_mk0] using
            (orderOf_units (y := (Units.mk0 (φ a) ha')⁻¹))
        _ = orderOf (Units.mk0 (φ a) ha') := orderOf_inv _
        _ = orderOf (φ a) := orderOf_units.symm
        _ = 2 ^ S.field.degree - 1 := hao'
    · exact hao'
  have hdet : LinearMap.det (σ yp) = 1 := by
    change LinearMap.det (d.restrictionDatum.compatibleEnd hcard (s.action yp)) = 1
    rw [compatible_det,orthogonal_det,map_one]
  have hclam : c = lam⁻¹ := inverse_plane_weight (σ yp) U Q hcompl hdU hdQ hdet c lam hc hQ
  have hdistinct : lam⁻¹ ≠ lam := by
    rcases hcases with ⟨_,hb⟩ | ⟨_,ha⟩
    · rw [hb,inv_inv]
      exact hab
    · rw [ha]
      exact hab.symm
  have hWne : W₂ ≠ ⊥ := by
    intro hh
    rw [hh,finrank_bot] at hd₂
    omega
  have hspan : orbitSpace (σ.comp (inclusion o.second_le)) W₂ = Q :=
    second_orbit_eq_plane o d.restrictionDatum hcard yp y.property.2 U Q W₂ lam⁻¹ lam
      hcompl hdQ hdistinct hWne hW₂ (hclam ▸ hc) hQ
  refine ⟨y,lam,Q,hygen,hlam,hlamo,hcompl,hW₂,hdQ,hclam ▸ hc,hQ,
    scalar_plane_kernel (σ yp) Q U lam lam⁻¹ hcompl.symm hdistinct.symm hQ (hclam ▸ hc),
    scalar_plane_kernel (σ yp) U Q lam⁻¹ lam hcompl hdistinct (hclam ▸ hc) hQ,
    hspan,hU,?_⟩
  rw [←hspan]
  exact ambient_orbitSpace (σ.comp (inclusion o.second_le))
    (fun a p => hσ (inclusion o.second_le a) p) W₂
end CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.CompatibleCartan.TerminalWeights
