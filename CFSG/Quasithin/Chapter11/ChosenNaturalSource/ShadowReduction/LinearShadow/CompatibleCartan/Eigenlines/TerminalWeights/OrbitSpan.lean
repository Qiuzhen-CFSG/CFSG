module
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.LinearShadow.CompatibleCartan.Eigenlines.TerminalWeights.CommonPlane
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.LinearShadow.CompatibleCartan.Eigenlines.TerminalWeights.TransportSpectrum
public import Theory.SpecificGroups.SL2.Affine.Action
public import Mathlib.LinearAlgebra.Projection
/-!
# The literal second-factor span and full eigenspaces

Every nonzero matrix row generates the natural row module under the second
SL2 factor. Thus any nonzero field subspace generates at least a plane. Action
commutation places the conjugates of W2 inside its scalar plane; dimension
two then identifies their span with the whole plane. The ambient-span theorem
identifies this field span with the subgroup generated by the actual conjugates.
Complementary distinct scalar spaces are also identified with the full kernels
of the scalar differences, rather than just subspaces of the eigenspaces.

Source: Aschbacher--Smith, Proposition 11.3.2, final paragraph, printed p.775.
-/

open Subgroup Representation Matrix
open ClassicalOrthogonal.FourPlusMatrix
open scoped IsMulCommutative MatrixGroups
@[expose] public noncomputable section
set_option backward.isDefEq.respectTransparency false
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.CompatibleCartan.TerminalWeights

/-- The field span of the actual conjugates of W by the specified actor. -/
def orbitSpace {F A M : Type*} [Field F] [Group A] [AddCommGroup M] [Module F M]
    (ρ : Representation F A M) (W : Submodule F M) : Submodule F M :=
  ⨆ a : A, W.map (ρ a)

private theorem mem_orbitSpace {F A M : Type*} [Field F] [Group A]
    [AddCommGroup M] [Module F M] (ρ : Representation F A M) (W : Submodule F M)
    (a : A) (w : M) (hw : w ∈ W) : ρ a w ∈ orbitSpace ρ W :=
  (le_iSup (fun a : A => W.map (ρ a)) a) ⟨w,hw,rfl⟩

/-- The field orbit span is exactly the subgroup generated by the actual
ambient conjugates. Scalar closure is inherited from W, not added to G. -/
theorem ambient_orbitSpace {G F : Type*} [Group G] [Field F]
    {P A : Subgroup G} [IsMulCommutative P] [Module F (Additive P)]
    (ρ : Representation F A (Additive P))
    (hρ : ∀ (a : A) (p : Additive P),
      ((ρ a p).toMul : G) = MulAut.conj (a : G) (p.toMul : G))
    (W : Submodule F (Additive P)) :
    ambientSubgroup (orbitSpace ρ W) =
      ⨆ a : A, (ambientSubgroup W).map (MulAut.conj (a : G)).toMonoidHom := by
  let H : Subgroup G := ⨆ a : A, (ambientSubgroup W).map (MulAut.conj (a : G)).toMonoidHom
  apply le_antisymm
  · rintro g ⟨p,hp,rfl⟩
    change (p : G) ∈ H
    refine Submodule.iSup_induction (motive := fun v : Additive P => (v.toMul : G) ∈ H) _ hp ?_ ?_ ?_
    · intro a v hv
      obtain ⟨w,hw,rfl⟩ := hv
      rw [hρ]
      exact (le_iSup (fun a : A => (ambientSubgroup W).map
        (MulAut.conj (a : G)).toMonoidHom) a)
        ⟨w.toMul,(mem_ambientSubgroup W w.toMul).mpr hw,rfl⟩
    · exact H.one_mem
    · intro u v hu hv
      exact H.mul_mem hu hv
  · apply iSup_le
    intro a g hg
    obtain ⟨w,hw,rfl⟩ := hg
    obtain ⟨p,hp,rfl⟩ := hw
    have he := hρ a (Additive.ofMul p)
    change ((ρ a (Additive.ofMul p)).toMul : G) = (MulAut.conj (a : G)) (p : G) at he
    change (MulAut.conj (a : G)) (p : G) ∈ ambientSubgroup (orbitSpace ρ W)
    rw [←he]
    exact (mem_ambientSubgroup (orbitSpace ρ W) _).mpr
      (mem_orbitSpace ρ W a (Additive.ofMul p) hp)

/-- Complementary distinct scalar spaces are the full eigenspaces of the
operator, expressed as the literal kernels of its scalar differences. -/
theorem scalar_plane_kernel {F M : Type*} [Field F] [AddCommGroup M] [Module F M]
    (t : Module.End F M) (U Q : Submodule F M) (a b : F)
    (hcompl : IsCompl U Q) (hab : a ≠ b)
    (hU : ∀ u ∈ U, t u = a • u) (hQ : ∀ q ∈ Q, t q = b • q) :
    LinearMap.ker (t - b • LinearMap.id) = Q := by
  apply le_antisymm
  · intro p hp
    have he : t p = b • p := sub_eq_zero.mp hp
    obtain ⟨u,q,huq,_⟩ := Submodule.existsUnique_add_of_isCompl hcompl p
    have hh : a • (u : M) = b • (u : M) := by
      rw [←huq,map_add,hU u u.property,hQ q q.property,smul_add] at he
      exact add_right_cancel he
    have hu : (u : M) = 0 := by
      by_contra hu
      exact hab (smul_left_injective F hu hh)
    rw [←huq,hu,zero_add]
    exact q.property
  · intro q hq
    change t q - b • q = 0
    rw [hQ q hq,sub_self]

open CFSG.Quasithin.ChapterB.QuasisimpleSource
variable {G F : Type*} [Group G] [Finite G] [Field F] [Finite F]
    {E : BinaryField} {Y P K A : Subgroup G} [IsMulCommutative P]
    (o : CommonCore.OrthogonalMarking Y P K A E)
    (N : let := (orderedSection o).moduleStructure;
      NaturalPlane (E := E.Carrier) (F := F) (A := Additive P))
    (hc : Nat.card E.Carrier = Nat.card F)

/-- Any nonzero subspace generates at least a plane under the literal second
factor. A nonzero matrix row maps onto the full natural row module. -/
theorem second_orbit_finrank :
    let s := orderedSection o
    let := s.moduleStructure
    let := N.compatibleModule hc
    let σ := N.compatibleRepresentation hc s.action
    ∀ W : Submodule F (Additive P), W ≠ ⊥ →
      2 ≤ Module.finrank F (orbitSpace (σ.comp (inclusion o.second_le)) W) := by
  let s := orderedSection o
  let := s.moduleStructure
  let e₀ := s.coordinates.linearEquiv E.Carrier
  let := N.compatibleModule hc
  let σ := N.compatibleRepresentation hc s.action
  let ec := compatibleCoordinates N hc e₀
  let φ := N.fieldEquiv hc
  dsimp only
  intro W hW
  let H := orbitSpace (σ.comp (inclusion o.second_le)) W
  obtain ⟨p,hp,hp0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot hW
  have hpcoord : e₀ p ≠ 0 := by
    intro hh
    exact hp0 (e₀.injective (hh.trans e₀.map_zero.symm))
  obtain ⟨i,hi⟩ : ∃ i : Fin 2, (e₀ p) i ≠ 0 := by
    by_contra! hh
    apply hpcoord
    ext i j
    exact congrFun (hh i) j
  let row : H →ₗ[F] (Fin 2 → F) :=
    ((LinearMap.proj i).comp ec.toLinearMap).comp H.subtype
  have hrow : Function.Surjective row := by
    intro v
    by_cases hv : v = 0
    · exact ⟨0,by simp [hv]⟩
    let v₀ : Fin 2 → E.Carrier := fun j => φ.symm (v j)
    have hv₀ : v₀ ≠ 0 := by
      intro hh
      apply hv
      ext j
      have h := congrArg φ (congrFun hh j)
      simpa [v₀] using h
    obtain ⟨g,hg⟩ := Matrix.SL2.exists_mulVec_eq E.Carrier (e₀ p i) v₀ hi hv₀
    have hm : (1,g.transpose⁻¹) ∈ (A.subgroupOf Y).map o.projection := by
      rw [o.second_factor]
      rfl
    obtain ⟨z,hz,hzg⟩ := hm
    let aa : A := ⟨z,hz⟩
    let yy := inclusion o.second_le aa
    have hy : o.projection yy = (1,g.transpose⁻¹) := hzg
    have he (u : Additive P) : e₀ (s.action yy u) =
        representation (o.projection yy) (e₀ u) := e₀.apply_symm_apply _
    refine ⟨⟨σ yy p,mem_orbitSpace (σ.comp (inclusion o.second_le)) W aa p hp⟩,?_⟩
    ext j
    change φ (e₀ (s.action yy p) i j) = v j
    rw [he,representation_apply,hy]
    simp only [inv_inv,Matrix.SpecialLinearGroup.coe_one,one_mul,
      Matrix.SpecialLinearGroup.coe_transpose]
    have hh : (e₀ p * g.val.transpose) i j = v₀ j := by
      simpa [Matrix.mul_apply,Matrix.mulVec,dotProduct,mul_comm] using congrFun hg j
    rw [hh]
    exact φ.apply_symm_apply _
  have hh := LinearMap.finrank_le_finrank_of_surjective hrow
  simpa using hh

/-- Commutation and the scalar-plane decomposition identify the span of W₂
with the other eigenspace, rather than merely a chosen complement. -/
theorem second_orbit_eq_plane (y : Y) (hy : (y : G) ∈ K) :
    let s := orderedSection o
    let := s.moduleStructure
    let := N.compatibleModule hc
    let σ := N.compatibleRepresentation hc s.action
    ∀ (U Q W : Submodule F (Additive P)) (a b : F),
      IsCompl U Q → Module.finrank F Q = 2 → a ≠ b → W ≠ ⊥ → W ≤ Q →
      (∀ u ∈ U, σ y u = a • u) → (∀ q ∈ Q, σ y q = b • q) →
      orbitSpace (σ.comp (inclusion o.second_le)) W = Q := by
  let s := orderedSection o
  let := s.moduleStructure
  let := N.compatibleModule hc
  let σ := N.compatibleRepresentation hc s.action
  dsimp only
  intro U Q W a b hcompl hdQ hab hW hWQ hU hQ
  have eig_le (p : Additive P) (hp : σ y p = b • p) : p ∈ Q := by
    obtain ⟨u,q,huq,_⟩ := Submodule.existsUnique_add_of_isCompl hcompl p
    have hh : a • (u : Additive P) = b • (u : Additive P) := by
      have hh := hp
      rw [←huq,map_add,hU u u.property,hQ q q.property,smul_add] at hh
      exact add_right_cancel hh
    have hu : (u : Additive P) = 0 := by
      by_contra hu
      exact hab (smul_left_injective F hu hh)
    rw [←huq,hu,zero_add]
    exact q.property
  have hle : orbitSpace (σ.comp (inclusion o.second_le)) W ≤ Q := by
    apply iSup_le
    intro z p hp
    obtain ⟨w,hw,rfl⟩ := hp
    apply eig_le
    change σ y (σ (inclusion o.second_le z) w) = b • σ (inclusion o.second_le z) w
    have hh : σ y (σ (inclusion o.second_le z) w) =
        σ (inclusion o.second_le z) (σ y w) := ordered_first_commutes o y hy z w
    rw [hh,hQ w (hWQ hw),map_smul]
  apply Submodule.eq_of_le_of_finrank_le hle
  rw [hdQ]
  exact second_orbit_finrank o N hc W hW
end CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.CompatibleCartan.TerminalWeights
