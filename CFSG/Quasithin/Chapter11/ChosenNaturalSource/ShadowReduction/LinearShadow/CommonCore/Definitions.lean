module

public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.LinearShadow.Reductions

/-!
# Literal subgroups in the common-core construction

These are the subgroups used in 11.3.7 and the following argument. In particular
the outside component is the two-residual, not the two-core. The subgroup of
the odd Hall group is O³(D) Ω₁(O₃(D)), with omega taken at three.

The pair construction uses conjugation x ↦ h*x*h⁻¹. The source uses the inverse
conjugating element; replacing h by its inverse preserves membership in H−M.
The join defining P is identified with the setwise product in `Conjugates`.
These definitions assert no component recognition or action compatibility.

Source: Aschbacher--Smith, combined manuscript, 1 March 2004,
11.3.7 and its following paragraphs, printed pp.773--774.
-/

@[expose] public noncomputable section
open Subgroup
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.CommonCore
variable {G : Type*} [Group G]

/-- The source Z = Ω₁Z(T), embedded in the original ambient group. -/
def omegaCenter (T : Sylow 2 G) : Subgroup G :=
  omegaOneAmbient ((center (T : Subgroup G)).map (T : Subgroup G).subtype)

/-- The source V_H = ⟨Z^H⟩. -/
def omegaClosure (T : Sylow 2 G) (H : Subgroup G) : Subgroup G :=
  Source.conjugateSpan H (omegaCenter T)

/-- K = O²(H), with the original embedding in G. -/
def outsideResidual (H : Subgroup G) : Subgroup G :=
  (pResidual 2 H).map H.subtype

/-- The subgroup D₀ of the source odd Hall group D; this uses O³, not O₃. -/
def oddCartanPart (A : Subgroup G) : Subgroup G :=
  ((pResidual 3 A) ⊔ (omega₁ (pCore 3 A) (p := 3)).map (pCore 3 A).subtype).map A.subtype

/-- The source I generated by the original V and the specified conjugate. -/
def pairGroup (V : Subgroup G) (h : G) : Subgroup G :=
  V ⊔ V.map (MulAut.conj h).toMonoidHom

/-- The source B = V ∩ O₂(H). -/
def axis (V H : Subgroup G) : Subgroup G := V ⊓ H.pCoreIn 2

/-- P = ⟨B,B^h⟩; its product and core properties must be proved. -/
def pairCore (V H : Subgroup G) (h : G) : Subgroup G :=
  axis V H ⊔ (axis V H).map (MulAut.conj h).toMonoidHom

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.CommonCore
