module
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.LinearShadow.CommonCore.Identification.Block.Placement
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.LinearShadow.CommonCore.Identification.Block.Cover
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.LinearShadow.CommonCore.Identification.Block.Radical
public import Theory.GroupTheory.NormalSylowQuotientAction

/-!
# The literal Sylow-invariant complement inside L/V

The image of P is identified with the actual quotient PV/V on every
representative. Its faithful action makes it disjoint from the covering
kernel, and equality with the R₂ action gives generation of (R₂∩L)/V.
It is elementary of order q². The complete original T action preserves
it, and the image of T∩L is an actual Sylow of L/V normalizing it.
No assertion that q differs from four is used.

Source: Aschbacher--Smith, refs/quasithin.pdf, printed p.774,
first three paragraphs. The exceptional model calculation uses I.2.2(3b).
-/

set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
open Subgroup Theory.GroupTheory Representation Matrix
open scoped IsMulCommutative commutatorElement MatrixGroups
open CFSG.Quasithin.ChapterB.QuasisimpleSource
open CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.CommonCore.OriginalBlock
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V H : Subgroup G} {h : G}
variable (D : Chapter12.Section02.ChosenModule T L V) (S : D.NonbinaryNaturalInput)
    (a : ActionEquiv D.centralQuotientAction (linearNatural S.field 3))
    {U₁ : Submodule (ZMod 2) D.chosenCentralQuotient}

/-- The literal image PV/V inside L/V, expressed using P to retain its marking. -/
def pairImage (H : Subgroup G) (h : G) : Subgroup (SeedQuotient D) :=
  ((pairCore V H h).subgroupOf L).map (seedProjection D)

/-- The plane radical in the same original quotient L/V. -/
def planeRadicalImage : Subgroup (SeedQuotient D) :=
  (((SL3.flag D S a).Ri 1).subgroupOf L).map (seedProjection D)

include D S a in
theorem component_core_le_plane_radical : L.pCoreIn 2 ≤ (SL3.flag D S a).Ri 1 := by
  rw [←SL3.RadicalAction.sylow_centralizer_plane D S a]
  have hcore : L.pCoreIn 2 ≤ (L ⊔ (T : Subgroup G)).pCoreIn 2 :=
    pCoreIn_mono_of_normalizes le_sup_left
      (sup_le L.le_normalizer D.sylow_normalizes_component)
  have hT : (L ⊔ (T : Subgroup G)).pCoreIn 2 ≤ (T : Subgroup G) := by
    simpa only [Sylow.coe_subtype,map_subgroupOf_eq_of_le le_sup_right] using
      pCoreIn_le_sylow (L ⊔ (T : Subgroup G)) (T.subtype le_sup_right)
  exact le_inf (hcore.trans hT) ((hcore.trans D.core_centralizes).trans
    (centralizer_le (D.centralQuotientPreimage_le _)))

include D S a in
theorem pairImage_disjoint_kernel
    (s : Hypothesis1131At D S U₁ H) (hh : h ∈ H)
    (hf : omegaClosure T H ⊓ centralizer (outsideResidual H : Set G) = ⊥)
    (hk : outsideResidual H ≤ pairGroup V h) :
    Disjoint (seedQuotientModel D S a).ker (pairImage D H h) := by
  let : (V.subgroupOf L).Normal := normal_subgroupOf_of_le_normalizer D.normalizes
  apply Subgroup.disjoint_def.mpr
  rintro x hx ⟨p,hp,rfl⟩
  have hpC : p ∈ (centralizer (V : Set G)).subgroupOf L := by
    rw [seed_centralizer D S a]
    apply (QuotientGroup.eq_one_iff p).mp
    apply a.groupEquiv.injective
    exact hx.trans a.groupEquiv.map_one.symm
  have hpV : (p : G) ∈ V := ((pairCore_fixed_eq_axis s hf hh hk).le ⟨hp,hpC⟩).1
  exact (QuotientGroup.eq_one_iff p).mpr hpV

include D S a in
/-- The original radical is generated by the literal pair and the covering kernel. -/
theorem planeRadicalImage_eq
    (s : Hypothesis1131At D S U₁ H) (hh : h ∈ H)
    (hf : omegaClosure T H ⊓ centralizer (outsideResidual H : Set G) = ⊥)
    (hk : outsideResidual H ≤ pairGroup V h)
    (c : PairNaturalMarking V H h S.field) (hm : c.multiplicity = 2)
    (hB : axis V H = (SL3.flag D S a).Vi 1)
    (hPL : pairCore V H h ≤ L) :
    planeRadicalImage D S a = (seedQuotientModel D S a).ker ⊔ pairImage D H h := by
  have hz := pair_intersection_eq_bot s hf hk
  have hPR := pairCore_le_plane_radical a (SL3.flag D S a) s hh hz hB
  have hact := pairCore_action_eq_radical a (SL3.flag D S a) s hh hf hk c hm hB
  apply le_antisymm
  · rintro _ ⟨r,hr,rfl⟩
    obtain ⟨p,hp⟩ := hact.ge (show
      V.normalizerMonoidHom (inclusion
        ((localRadical_le_sylow (L := L) ((SL3.flag D S a).Vi 1)).trans S.sylow_normalizes)
        ⟨r,hr⟩) ∈ _ from ⟨⟨r,hr⟩,rfl⟩)
    let pL : L := inclusion hPL p
    have he : seedQuotientModel D S a (seedProjection D (pL⁻¹ * r)) = 1 := by
      have hfix : pL⁻¹ * r ∈ (centralizer (V : Set G)).subgroupOf L := by
        intro v hv
        have he := congrArg (fun u : MulAut V => (u ⟨v,hv⟩ : G)) hp
        change (p : G) * v * (p : G)⁻¹ = (r : G) * v * (r : G)⁻¹ at he
        have hc : ((pL⁻¹ * r : L) : G) * v * ((pL⁻¹ * r : L) : G)⁻¹ = v := by
          change (p : G)⁻¹ * (r : G) * v * ((p : G)⁻¹ * (r : G))⁻¹ = v
          calc
            _ = (p : G)⁻¹ * ((r : G) * v * (r : G)⁻¹) * (p : G) := by group
            _ = _ := by rw [←he]; group
        exact (mul_inv_eq_iff_eq_mul.mp hc).symm
      rw [seed_centralizer D S a] at hfix
      change a.groupEquiv (QuotientGroup.mk' (pCore 2 L) (pL⁻¹ * r)) = 1
      exact (congrArg a.groupEquiv
        ((QuotientGroup.eq_one_iff (N := pCore 2 L) (pL⁻¹ * r)).mpr hfix)).trans a.groupEquiv.map_one
    have hpim : seedProjection D pL ∈ pairImage D H h := mem_map_of_mem _ p.property
    have hkim : seedProjection D (pL⁻¹ * r) ∈ (seedQuotientModel D S a).ker := he
    have hmem := ((seedQuotientModel D S a).ker ⊔ pairImage D H h).mul_mem
      (mem_sup_right hpim) (mem_sup_left hkim)
    simpa only [←map_mul,mul_inv_cancel_left] using hmem
  · apply sup_le
    · rw [seedQuotientModel_ker]
      apply map_mono
      intro l hl
      exact component_core_le_plane_radical D S a (mem_map_of_mem _ hl)
    · exact map_mono (comap_mono hPR)

/-- The literal quotient map from PV into L/V. -/
def pairJoinProjection (hPL : pairCore V H h ≤ L) :
    (pairCore V H h ⊔ V : Subgroup G) →* SeedQuotient D :=
  (seedProjection D).comp (inclusion (sup_le hPL D.le_component))

omit [Finite G] in
include D in
theorem pairJoinProjection_ker (hPL : pairCore V H h ≤ L) :
    (pairJoinProjection D hPL).ker = V.subgroupOf (pairCore V H h ⊔ V) := by
  let : (V.subgroupOf L).Normal := normal_subgroupOf_of_le_normalizer D.normalizes
  ext x
  exact QuotientGroup.eq_one_iff (inclusion (sup_le hPL D.le_component) x)

omit [Finite G] in
include D in
theorem pairJoinProjection_range (hPL : pairCore V H h ≤ L) :
    (pairJoinProjection D hPL).range = pairImage D H h := by
  let : (V.subgroupOf L).Normal := normal_subgroupOf_of_le_normalizer D.normalizes
  rw [pairJoinProjection,MonoidHom.range_comp,inclusion_range,
    subgroupOf_sup hPL D.le_component,Subgroup.map_sup]
  change pairImage D H h ⊔ (V.subgroupOf L).map (seedProjection D) = _
  have hz : (V.subgroupOf L).map (seedProjection D) = ⊥ := by
    rw [Subgroup.map_eq_bot_iff]
    exact (QuotientGroup.ker_mk' (V.subgroupOf L)).ge
  rw [hz,sup_bot_eq]

include D in
/-- An isomorphism from the actual PV/V, with its value on each original representative. -/
theorem pairImage_quotient_equiv
    (s : Hypothesis1131At D S U₁ H) (hh : h ∈ H)
    (hPL : pairCore V H h ≤ L) :
    let := normal_subgroupOf_sup_of_le_normalizer
      ((pairCore_le_core (V := V) hh).trans (core_normalizes_seed s))
    ∃ e : ((pairCore V H h ⊔ V : Subgroup G) ⧸
        V.subgroupOf (pairCore V H h ⊔ V)) ≃* pairImage D H h,
      ∀ x, (e (QuotientGroup.mk' _ x)).val =
        seedProjection D (inclusion (sup_le hPL D.le_component) x) := by
  let := normal_subgroupOf_sup_of_le_normalizer
    ((pairCore_le_core (V := V) hh).trans (core_normalizes_seed s))
  let e := ((QuotientGroup.quotientMulEquivOfEq (pairJoinProjection_ker D hPL).symm).trans
    (QuotientGroup.quotientKerEquivRange (pairJoinProjection D hPL))).trans
      (MulEquiv.subgroupCongr (pairJoinProjection_range D hPL))
  exact ⟨e,fun _ => rfl⟩

include D S in
theorem pairImage_elementary_card
    (s : Hypothesis1131At D S U₁ H) (hh : h ∈ H)
    (hf : omegaClosure T H ⊓ centralizer (outsideResidual H : Set G) = ⊥)
    (hk : outsideResidual H ≤ pairGroup V h)
    (c : PairNaturalMarking V H h S.field) (hm : c.multiplicity = 2)
    (hPL : pairCore V H h ≤ L) :
    IsElementaryAbelian 2 (pairImage D H h) ∧
      Nat.card (pairImage D H h) = (2 ^ S.field.degree) ^ 2 := by
  let := normal_subgroupOf_sup_of_le_normalizer
    ((pairCore_le_core (V := V) hh).trans (core_normalizes_seed s))
  obtain ⟨he,hcard⟩ := pairCore_seed_quotient s hh hf hk c hm
  let := he
  obtain ⟨e,_⟩ := pairImage_quotient_equiv D S s hh hPL
  exact ⟨IsElementaryAbelian.of_surjective e.toMonoidHom e.surjective,
    (Nat.card_congr e.toEquiv).symm.trans hcard⟩

omit [Finite G] in
include D in
theorem pairImage_normalized
    (hT : (T : Subgroup G) ≤ normalizer (pairCore V H h : Set G)) :
    ((T : Subgroup G).subgroupOf L).map (seedProjection D) ≤
      normalizer (pairImage D H h : Set (SeedQuotient D)) := by
  have hn : (T : Subgroup G).subgroupOf L ≤
      normalizer ((pairCore V H h).subgroupOf L : Set L) := by
    apply le_normalizer_iff.mpr
    intro t ht p hp
    exact le_normalizer_iff.mp hT (t : G) ht (p : G) hp
  exact (map_mono hn).trans (((pairCore V H h).subgroupOf L).le_normalizer_map _)


/-- Conjugation by the original T descends to the original L/V. -/
def seedSylowConjugation (t : T) : SeedQuotient D →* SeedQuotient D :=
  let : (V.subgroupOf L).Normal := normal_subgroupOf_of_le_normalizer D.normalizes
  QuotientGroup.map (V.subgroupOf L) (V.subgroupOf L)
    (L.normalizerMonoidHom ⟨t,D.sylow_normalizes_component t.property⟩).toMonoidHom (by
      intro v hv
      exact (mem_normalizer_iff.mp (S.sylow_normalizes t.property) (v : G)).mp hv)

theorem seedSylowConjugation_mk (t : T) (l : L) :
    seedSylowConjugation D S t (seedProjection D l) =
      seedProjection D (L.normalizerMonoidHom
        ⟨t,D.sylow_normalizes_component t.property⟩ l) := rfl

include D S in
/-- Invariance under the complete original Sylow action, including its outer part. -/
theorem pairImage_sylow_invariant
    (hT : (T : Subgroup G) ≤ normalizer (pairCore V H h : Set G)) (t : T) :
    (pairImage D H h).map (seedSylowConjugation D S t) = pairImage D H h := by
  apply le_antisymm
  · rintro _ ⟨_,⟨p,hp,rfl⟩,rfl⟩
    rw [seedSylowConjugation_mk]
    apply mem_map_of_mem
    exact (mem_normalizer_iff.mp (hT t.property) (p : G)).mp hp
  · rintro _ ⟨p,hp,rfl⟩
    let r := L.normalizerMonoidHom
      ⟨(t⁻¹ : T),D.sylow_normalizes_component (t⁻¹ : T).property⟩ p
    have hr : (r : G) ∈ pairCore V H h :=
      (mem_normalizer_iff.mp (hT (t⁻¹ : T).property) (p : G)).mp hp
    refine ⟨seedProjection D r,mem_map_of_mem _ hr,?_⟩
    rw [seedSylowConjugation_mk]
    congr 1
    apply Subtype.ext
    change (t : G) * ((t : G)⁻¹ * (p : G) * ((t : G)⁻¹)⁻¹) * (t : G)⁻¹ = p
    group

include D in
/-- The complement is normalized by an actual Sylow of L/V, obtained from T∩L. -/
theorem pairImage_sylow_normalizer
    (hT : (T : Subgroup G) ≤ normalizer (pairCore V H h : Set G)) :
    ∃ R : Sylow 2 (SeedQuotient D),
      (R : Subgroup (SeedQuotient D)) =
        ((T : Subgroup G).subgroupOf L).map (seedProjection D) ∧
      (R : Subgroup (SeedQuotient D)) ≤ normalizer (pairImage D H h : Set _) := by
  let : (V.subgroupOf L).Normal := normal_subgroupOf_of_le_normalizer D.normalizes
  obtain ⟨Q,hQ⟩ := NormalSylowQuotientAction.intersection_sylow T L D.sylow_normalizes_component
  let R := Q.mapSurjective (f := seedProjection D) (QuotientGroup.mk'_surjective _)
  have he : (R : Subgroup (SeedQuotient D)) =
      ((T : Subgroup G).subgroupOf L).map (seedProjection D) := by
    change (Q : Subgroup L).map (seedProjection D) = _
    rw [hQ]
  exact ⟨R,he,he.le.trans (pairImage_normalized D hT)⟩



end CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.CommonCore.OriginalBlock
