module
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.LinearShadow.CommonCore.Action.Transvection.MarkedLine.Coordinates
public import Theory.GroupTheory.ConjugateSpanNormalizer

/-!
# The natural submodule generated by a fixed field line

A field line in the upper fixed space of a sum of natural SL₂ modules
has a natural two-dimensional orbit span. Choose a nonzero line vector;
its coordinates give an injective map from the natural two-space into the
original ambient group. A lower transvection and the original line generate
its image. This identifies the literal conjugate span, its fixed subgroup,
and the full residual action, retaining the original conjugation maps.

The actual Hall calculation supplies the field line in `Block.NaturalSubmodule`,
which applies this theorem to the original V₁ and constructs V_K. No
compatibility with the field structure of the original V is assumed.
Source: Aschbacher--Smith, refs/quasithin.pdf, printed p.774, second paragraph.
-/

set_option backward.isDefEq.respectTransparency false
public noncomputable section
open Subgroup Matrix
open scoped MatrixGroups Pointwise
open CFSG.Quasithin.ChapterB.QuasisimpleSource
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.CommonCore
variable {G : Type*} [Group G] {T : Sylow 2 G} {H A : Subgroup G} {F : BinaryField}
namespace NaturalSylowCoordinates
variable {m : ℕ} (n : NaturalSylowCoordinates T H A F m)

theorem natural_span_of_line
    (π : outsideResidual H →* SL(2,F.Carrier)) (hπ : Function.Surjective π)
    (he : ∀ (k : outsideResidual H) (v : omegaClosure T H) (i : Fin m),
      (n.coordinates (residualAction T H k v)).toAdd i =
        (π k).val *ᵥ (n.coordinates v).toAdd i)
    (E : Submodule F.Carrier (Fin m → Fin 2 → F.Carrier))
    (hE : Module.finrank F.Carrier E = 1) (hfix : E ≤ n.fixedSpace) :
    let W := conjugateSpanBy (n.liftSpace E) (outsideResidual H)
    W ≤ omegaClosure T H ∧ W ⊓ centralizer (A : Set G) = n.liftSpace E ∧
    ∃ e : W ≃* Multiplicative (Fin 2 → F.Carrier),
      ∀ (k : outsideResidual H) (w : W),
        (e (W.normalizerMonoidHom
          (inclusion (le_normalizer_conjugateSpanBy _ _) k) w)).toAdd =
        (π k).val *ᵥ (e w).toAdd := by
  classical
  obtain ⟨u,hu,hu0⟩ := Submodule.exists_mem_ne_zero_of_ne_bot
    (show E ≠ ⊥ by intro hz; rw [hz,finrank_bot] at hE; omega)
  have hu1 : ∀ i, u i 1 = 0 := hfix hu
  obtain ⟨i,hi⟩ : ∃ i, u i 0 ≠ 0 := by
    by_contra! hz
    apply hu0
    ext i j
    fin_cases j
    · exact hz i
    · exact hu1 i
  let J : (Fin 2 → F.Carrier) →ₗ[F.Carrier] (Fin m → Fin 2 → F.Carrier) :=
    { toFun v i j := u i 0 * v j
      map_add' v w := by ext i j; exact mul_add _ _ _
      map_smul' a v := by ext i j; simp [mul_left_comm] }
  have hJi : Function.Injective J := by
    intro v w hvw
    ext j
    exact mul_left_cancel₀ hi (congrFun (congrFun hvw i) j)
  let φ : Multiplicative (Fin 2 → F.Carrier) →* G :=
    (omegaClosure T H).subtype.comp
      (n.coordinates.symm.toMonoidHom.comp J.toAddMonoidHom.toMultiplicative)
  have hφi : Function.Injective φ :=
    (omegaClosure T H).subtype_injective.comp (n.coordinates.symm.injective.comp hJi)
  have hcoords (v : Multiplicative (Fin 2 → F.Carrier)) :
      (n.coordinates ⟨φ v, (show φ v ∈ omegaClosure T H from
        (n.coordinates.symm (Multiplicative.ofAdd (J v.toAdd))).property)⟩).toAdd =
      J v.toAdd := n.coordinates.apply_symm_apply _
  have hupper (a : F.Carrier) : φ (Multiplicative.ofAdd ![a,0]) ∈ n.liftSpace E := by
    apply (n.mem_liftSpace E _).mpr
    change (n.coordinates (n.coordinates.symm (Multiplicative.ofAdd (J ![a,0])))).toAdd ∈ E
    rw [n.coordinates.apply_symm_apply]
    change J ![a,0] ∈ E
    have hJ : J ![a,0] = a • u := by
      ext i j
      fin_cases j <;> simp [J,hu1,mul_comm]
    rw [hJ]
    exact E.smul_mem a hu
  have hUrange : n.liftSpace E ≤ φ.range := by
    intro x hx
    let v : omegaClosure T H := ⟨x,n.liftSpace_le E hx⟩
    have hv := (n.mem_liftSpace E v).mp hx
    obtain ⟨a,ha⟩ := exists_smul_eq_of_finrank_eq_one hE
      (show (⟨u,hu⟩ : E) ≠ 0 from fun h => hu0 (congrArg Subtype.val h))
      ⟨(n.coordinates v).toAdd,hv⟩
    have ha' : a • u = (n.coordinates v).toAdd := congrArg Subtype.val ha
    refine ⟨Multiplicative.ofAdd ![a,0],?_⟩
    have hh : n.coordinates.symm (Multiplicative.ofAdd (J ![a,0])) = v := by
      apply n.coordinates.injective
      apply Multiplicative.toAdd.injective
      rw [n.coordinates.apply_symm_apply]
      rw [←ha']
      ext i j
      fin_cases j <;> simp [J,hu1,mul_comm]
    exact congrArg Subtype.val hh
  have hconj (k : outsideResidual H) (v : Multiplicative (Fin 2 → F.Carrier)) :
      (k : G) * φ v * (k : G)⁻¹ =
        φ (Multiplicative.ofAdd ((π k).val *ᵥ v.toAdd)) := by
    let w := n.coordinates.symm (Multiplicative.ofAdd (J v.toAdd))
    have hh : residualAction T H k w =
        n.coordinates.symm (Multiplicative.ofAdd (J ((π k).val *ᵥ v.toAdd))) := by
      apply n.coordinates.injective
      apply Multiplicative.toAdd.injective
      rw [n.coordinates.apply_symm_apply]
      ext i j
      rw [show (n.coordinates (residualAction T H k w)).toAdd i =
        (π k).val *ᵥ (n.coordinates w).toAdd i from he k w i]
      simp only [w,MulEquiv.apply_symm_apply]
      fin_cases j <;> simp [J,mulVec,dotProduct,Fin.sum_univ_two,mul_add,mul_left_comm]
    exact congrArg Subtype.val hh
  let W := conjugateSpanBy (n.liftSpace E) (outsideResidual H)
  have hnorm : outsideResidual H ≤ normalizer (φ.range : Set G) := by
    apply le_normalizer_iff.mpr
    rintro k hk x ⟨v,rfl⟩
    rw [hconj ⟨k,hk⟩ v]
    exact ⟨_,rfl⟩
  have hWrange : W ≤ φ.range := conjugateSpanBy_le hUrange hnorm
  have hrangeW : φ.range ≤ W := by
    rintro x ⟨v,rfl⟩
    obtain ⟨k,hk⟩ := hπ (SpecialLinearGroup.transvection
      (show (1 : Fin 2) ≠ 0 by decide) 1)
    have h0 := le_conjugateSpanBy (n.liftSpace E) (outsideResidual H)
      (hupper (v.toAdd 0))
    have h1 := le_conjugateSpanBy (n.liftSpace E) (outsideResidual H)
      (hupper (v.toAdd 1))
    have hc := (le_normalizer_conjugateSpanBy (n.liftSpace E) (outsideResidual H)
      k.property _).mp h1
    rw [hconj k,hk] at hc
    have heq : φ v = φ (Multiplicative.ofAdd ![v.toAdd 0,0]) *
        (φ (Multiplicative.ofAdd
          ((SpecialLinearGroup.transvection (show (1 : Fin 2) ≠ 0 by decide) (1 : F.Carrier)).val
            *ᵥ ![v.toAdd 1,0])) * (φ (Multiplicative.ofAdd ![v.toAdd 1,0]))⁻¹) := by
      rw [←map_inv,←map_mul,←map_mul]
      congr 1
      apply Multiplicative.toAdd.injective
      ext j
      fin_cases j <;> simp [SpecialLinearGroup.transvection_coe,
        Matrix.add_mulVec, Matrix.single_mulVec_eq, vecHead, vecTail]
    rw [heq]
    exact W.mul_mem h0 (W.mul_mem hc (W.inv_mem h1))
  have hrange : φ.range = W := le_antisymm hrangeW hWrange
  have hW : W ≤ omegaClosure T H := conjugateSpanBy_le (n.liftSpace_le E)
    ((outsideResidual_le H).trans (omegaClosure_normalized T H))
  have hfixed : W ⊓ centralizer (A : Set G) = n.liftSpace E := by
    apply le_antisymm
    · rintro x ⟨hx,hc⟩
      obtain ⟨v,rfl⟩ := hWrange hx
      have hz := (n.mem_fixed_iff ⟨φ v,hW hx⟩).mp hc i
      rw [hcoords] at hz
      have hv : v.toAdd 1 = 0 := (mul_eq_zero.mp hz).resolve_left hi
      have heq : v = Multiplicative.ofAdd ![v.toAdd 0,0] := by
        apply Multiplicative.toAdd.injective
        ext j
        fin_cases j
        · rfl
        · exact hv
      rw [heq]
      exact hupper _
    · refine le_inf (le_conjugateSpanBy _ _) ?_
      intro x hx
      exact (n.mem_fixed_iff ⟨x,n.liftSpace_le E hx⟩).mpr
        (hfix ((n.mem_liftSpace E _).mp hx))
  let e : W ≃* Multiplicative (Fin 2 → F.Carrier) :=
    ((MonoidHom.ofInjective hφi).trans (MulEquiv.subgroupCongr hrange)).symm
  refine ⟨hW,hfixed,e,?_⟩
  intro k w
  apply Multiplicative.ofAdd.injective
  change e _ = Multiplicative.ofAdd _
  apply e.symm.injective
  rw [e.symm_apply_apply]
  have heval (v : Multiplicative (Fin 2 → F.Carrier)) : (e.symm v : G) = φ v := rfl
  apply Subtype.ext
  rw [heval]
  have hw : (w : G) = φ (e w) := (congrArg Subtype.val (e.symm_apply_apply w)).symm
  change (k : G) * (w : G) * (k : G)⁻¹ = _
  rw [hw,hconj]

end NaturalSylowCoordinates
end CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.CommonCore
