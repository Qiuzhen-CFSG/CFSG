module
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.LinearShadow.CommonCore.Definitions
public import Theory.GroupTheory.AbelianGeneratorCore
public import Theory.GroupTheory.DisjointCommutingProduct
public import Theory.ElementaryAbelian.Join

/-!
# The actual conjugate pair and its normal two-subgroup

For the original chosen module and the selected outside H of Hypothesis 11.3.1,
choose h in H−N_G(L). The literal O₂(H) normalizes both V and V^h, because it
lies in the prescribed Sylow subgroup and is H-invariant. Intersecting with
the two generators gives P = BB^h normal in I = ⟨V,V^h⟩, with P ∩ V = B.

The commutator of B and B^h lies in V ∩ V^h. Consequently vanishing of the
latter intersection gives an elementary abelian internal direct product, with
the actual multiplication isomorphism and |P| = |B|². The vanishing premise
remains explicit: it belongs to the later application of 11.3.7 and E.2.10.
These results do not identify P with O₂(I), O₂(K), or O₂(L₂), and do not
assert a natural-module marking, the SL₃ block, or the q=4 exclusion.

`source_pair_geometry` applies all the unconditional reductions to the original
D, S and H, preserving relative normality. No counterexample, flag or field
hypothesis is needed for this elementary part, so it applies to the unchanged
flag and Cartan of the source setup.

Source: Aschbacher--Smith, combined manuscript, 1 March 2004,
paragraphs following 11.3.7, printed p.774; E.2.9(1), E.2.10(1--2).
-/

@[expose] public noncomputable section

open Subgroup Theory.GroupTheory
open scoped Pointwise IsMulCommutative
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.CommonCore
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    (D : Chapter12.Section02.ChosenModule T L V) (S : D.NonbinaryNaturalInput)
    {U₁ : Submodule (ZMod 2) D.chosenCentralQuotient} {H : Subgroup G}

variable {D S}

/-- The selected H in Hypothesis 11.3.1 contains an element outside M. -/
theorem exists_outside (s : Hypothesis1131At D S U₁ H) :
    ∃ h : G, h ∈ H ∧ h ∉ normalizer (L : Set G) := by
  classical
  by_contra hn
  apply s.outside.1.2
  intro h hh
  by_contra hm
  exact hn ⟨h, hh, hm⟩

/-- Both generators of the actual pair lie in H. -/
theorem pairGroup_le (s : Hypothesis1131At D S U₁ H) {h : G} (hh : h ∈ H) :
    pairGroup V h ≤ H := by
  have hVH : V ≤ H := D.le_sylow.trans s.outside.1.1.2
  apply sup_le hVH
  rintro x ⟨v, hv, rfl⟩
  exact H.mul_mem (H.mul_mem hh (hVH hv)) (H.inv_mem hh)

omit [Finite G] in
private theorem local_normalizes_core : H ≤ normalizer (H.pCoreIn 2 : Set G) :=
  H.le_normalizer.trans (normalizer_le_normalizer_characteristic_image H (pCore 2 H))

/-- The prescribed Sylow subgroup places O₂(H) in the seed normalizer. -/
theorem core_normalizes_seed (s : Hypothesis1131At D S U₁ H) :
    H.pCoreIn 2 ≤ normalizer (V : Set G) := by
  have hTH : (T : Subgroup G) ≤ H := s.outside.1.1.2
  have hc : H.pCoreIn 2 ≤ (T : Subgroup G) := by
    have hcore := pCoreIn_le_sylow H (T.subtype hTH)
    change H.pCoreIn 2 ≤ ((T : Subgroup G).subgroupOf H).map H.subtype at hcore
    rwa [map_subgroupOf_eq_of_le hTH] at hcore
  exact hc.trans S.sylow_normalizes

/-- H-invariance of its two-core gives normalization of the other generator. -/
theorem core_normalizes_conjugate (s : Hypothesis1131At D S U₁ H)
    {h : G} (hh : h ∈ H) :
    H.pCoreIn 2 ≤ normalizer (V.map (MulAut.conj h).toMonoidHom : Set G) := by
  have he : (H.pCoreIn 2).map (MulAut.conj h).toMonoidHom = H.pCoreIn 2 :=
    mem_normalizer_iff_map_conj_eq.mp (local_normalizes_core hh)
  rw [← map_equiv_normalizer_eq V (MulAut.conj h)]
  simpa only [he] using map_mono (f := (MulAut.conj h).toMonoidHom)
    (core_normalizes_seed s)

/-- The literal normalization step used from E.2.9(1). -/
theorem core_normalizes_pairGroup (s : Hypothesis1131At D S U₁ H)
    {h : G} (hh : h ∈ H) :
    H.pCoreIn 2 ≤ normalizer (pairGroup V h : Set G) :=
  (le_inf (core_normalizes_seed s) (core_normalizes_conjugate s hh)).trans
    (normalizer_inf_normalizer_le_normalizer_sup _ _)

omit [Finite G] in
/-- Conjugation retains the same ambient O₂(H), not the core of another group. -/
theorem conjugate_axis_eq {h : G} (hh : h ∈ H) :
    (axis V H).map (MulAut.conj h).toMonoidHom =
      V.map (MulAut.conj h).toMonoidHom ⊓ H.pCoreIn 2 := by
  have he : (H.pCoreIn 2).map (MulAut.conj h).toMonoidHom = H.pCoreIn 2 :=
    mem_normalizer_iff_map_conj_eq.mp (local_normalizes_core hh)
  rw [axis, map_inf _ _ _ (MulAut.conj h).injective, he]

omit [Finite G] in
/-- Both axis factors lie in O₂(H). -/
theorem pairCore_le_core {h : G} (hh : h ∈ H) : pairCore V H h ≤ H.pCoreIn 2 := by
  rw [pairCore, conjugate_axis_eq hh]
  exact sup_le inf_le_right inf_le_right

omit [Finite G] in
/-- The axis product lies in the group generated by V and V^h. -/
theorem pairCore_le_pairGroup (h : G) : pairCore V H h ≤ pairGroup V h :=
  sup_le_sup inf_le_left (map_mono inf_le_left)

omit [Finite G] in
/-- The exact intersection P ∩ V = B, before identifying B with V₂. -/
theorem pairCore_inf_seed {h : G} (hh : h ∈ H) :
    pairCore V H h ⊓ V = axis V H := by
  exact le_antisymm (le_inf inf_le_right (inf_le_left.trans (pairCore_le_core hh)))
    (le_inf le_sup_left inf_le_left)

/-- Commutators with the two generators give relative normality. -/
theorem pairGroup_normalizes_pairCore (s : Hypothesis1131At D S U₁ H)
    {h : G} (hh : h ∈ H) :
    pairGroup V h ≤ normalizer (pairCore V H h : Set G) := by
  have hc := pairCore_le_core (V := V) hh
  have hI := pairGroup_le s hh
  have hn := hI.trans (local_normalizes_core (H := H))
  have hv : ⁅pairCore V H h, V⁆ ≤ axis V H :=
    le_inf (le_normalizer_iff_commutator_le_right.mp
      (hc.trans (core_normalizes_seed s)))
      ((commutator_mono hc le_rfl).trans
        (le_normalizer_iff_commutator_le_left.mp (le_sup_left.trans hn)))
  have hw : ⁅pairCore V H h, V.map (MulAut.conj h).toMonoidHom⁆ ≤
      (axis V H).map (MulAut.conj h).toMonoidHom := by
    rw [conjugate_axis_eq hh]
    exact le_inf (le_normalizer_iff_commutator_le_right.mp
      (hc.trans (core_normalizes_conjugate s hh)))
      ((commutator_mono hc le_rfl).trans
        (le_normalizer_iff_commutator_le_left.mp (le_sup_right.trans hn)))
  exact sup_le (le_normalizer_iff_commutator_le_left.mpr (hv.trans le_sup_left))
    (le_normalizer_iff_commutator_le_left.mpr (hw.trans le_sup_right))

/-- The constructed P is a normal two-subgroup of the literal I. -/
theorem pairCore_le_pairGroup_core (s : Hypothesis1131At D S U₁ H)
    {h : G} (hh : h ∈ H) : pairCore V H h ≤ (pairGroup V h).pCoreIn 2 :=
  le_pCoreIn_of_normalizes ((isPGroup_pCoreIn 2 H).to_le (pairCore_le_core hh))
    (pairCore_le_pairGroup h) (pairGroup_normalizes_pairCore s hh)

/-- The join defining P is exactly the ordered setwise product BB^h. -/
theorem pairCore_product (s : Hypothesis1131At D S U₁ H)
    {h : G} (hh : h ∈ H) :
    (pairCore V H h : Set G) =
      (axis V H : Set G) * ((axis V H).map (MulAut.conj h).toMonoidHom : Set G) := by
  apply coe_mul_of_right_le_normalizer_left
  have hBh : (axis V H).map (MulAut.conj h).toMonoidHom ≤ H :=
    (map_mono (show axis V H ≤ V from inf_le_left)).trans
      ((show V.map (MulAut.conj h).toMonoidHom ≤ pairGroup V h from le_sup_right).trans
        (pairGroup_le s hh))
  exact (le_inf
    ((conjugate_axis_eq (V := V) hh).le.trans inf_le_right |>.trans (core_normalizes_seed s))
    (hBh.trans local_normalizes_core)).trans
    inf_normalizer_le_normalizer_inf

/-- The two axis factors commute modulo the intersection of the original generators. -/
theorem pairCore_commutator_le_intersection (s : Hypothesis1131At D S U₁ H)
    {h : G} (hh : h ∈ H) :
    ⁅axis V H, (axis V H).map (MulAut.conj h).toMonoidHom⁆ ≤
      V ⊓ V.map (MulAut.conj h).toMonoidHom := by
  apply le_inf
  · rw [commutator_comm]
    exact (commutator_mono le_rfl inf_le_left).trans
      (le_normalizer_iff_commutator_le_right.mp
        (((conjugate_axis_eq hh).le.trans inf_le_right).trans (core_normalizes_seed s)))
  · exact (commutator_mono le_rfl (map_mono inf_le_left)).trans
      (le_normalizer_iff_commutator_le_right.mp
        ((show axis V H ≤ H.pCoreIn 2 from inf_le_right).trans
          (core_normalizes_conjugate s hh)))

/-- When the generators are disjoint, multiplication gives the internal direct product. -/
theorem pairCore_direct_product (s : Hypothesis1131At D S U₁ H)
    {h : G} (hh : h ∈ H) (hz : V ⊓ V.map (MulAut.conj h).toMonoidHom = ⊥) :
    ∃ e : axis V H × (axis V H).map (MulAut.conj h).toMonoidHom ≃* pairCore V H h,
      ∀ b c, (e (b, c) : G) = (b : G) * (c : G) := by
  apply exists_mulEquiv_prod_sup_of_disjoint_of_commuting
  · apply disjoint_iff.mpr
    exact bot_unique ((inf_le_inf inf_le_left (map_mono inf_le_left)).trans hz.le)
  · exact commutator_eq_bot_iff_le_centralizer.mp
      (bot_unique ((pairCore_commutator_le_intersection s hh).trans hz.le))

/-- The resulting direct product is elementary abelian at two. -/
theorem pairCore_elementary (s : Hypothesis1131At D S U₁ H)
    {h : G} (hh : h ∈ H) (hz : V ⊓ V.map (MulAut.conj h).toMonoidHom = ⊥) :
    IsElementaryAbelian 2 (pairCore V H h) := by
  let := D.elementary
  let : IsElementaryAbelian 2 (axis V H) :=
    IsElementaryAbelian.of_le (show axis V H ≤ V from inf_le_left)
  let := IsElementaryAbelian.map (p := 2) (A := axis V H) (MulAut.conj h).toMonoidHom
  apply IsElementaryAbelian.sup_of_le_centralizer
  apply commutator_eq_bot_iff_le_centralizer.mp
  rw [commutator_comm]
  exact bot_unique ((pairCore_commutator_le_intersection s hh).trans hz.le)

/-- Conjugacy of the two direct factors squares the axis cardinality. -/
theorem pairCore_card (s : Hypothesis1131At D S U₁ H)
    {h : G} (hh : h ∈ H) (hz : V ⊓ V.map (MulAut.conj h).toMonoidHom = ⊥) :
    Nat.card (pairCore V H h) = Nat.card (axis V H) ^ 2 := by
  obtain ⟨e, _⟩ := pairCore_direct_product s hh hz
  have hc : Nat.card ((axis V H).map (MulAut.conj h).toMonoidHom) = Nat.card (axis V H) :=
    (Nat.card_congr ((MulAut.conj h).subgroupMap (axis V H)).toEquiv).symm
  rw [← Nat.card_congr e.toEquiv, Nat.card_prod, hc, pow_two]

/-- Normality is inside I, with both subgroups still embedded in G. -/
theorem pairCore_normal (s : Hypothesis1131At D S U₁ H)
    {h : G} (hh : h ∈ H) :
    ((pairCore V H h).subgroupOf (pairGroup V h)).Normal :=
  (normal_subgroupOf_iff_le_normalizer (pairCore_le_pairGroup h)).mpr
    (pairGroup_normalizes_pairCore s hh)

/-- The original chosen-source application of the elementary pair construction. -/
theorem source_pair_geometry (s : Hypothesis1131At D S U₁ H) :
    ∃ h : G, h ∈ H ∧ h ∉ normalizer (L : Set G) ∧
      pairGroup V h ≤ H ∧
      H.pCoreIn 2 ≤ normalizer (pairGroup V h : Set G) ∧
      ((pairCore V H h).subgroupOf (pairGroup V h)).Normal ∧
      pairCore V H h ≤ (pairGroup V h).pCoreIn 2 ∧
      pairCore V H h ⊓ V = axis V H ∧
      (pairCore V H h : Set G) =
        (axis V H : Set G) * ((axis V H).map (MulAut.conj h).toMonoidHom : Set G) := by
  obtain ⟨h, hh, hm⟩ := exists_outside s
  exact ⟨h, hh, hm, pairGroup_le s hh, core_normalizes_pairGroup s hh,
    pairCore_normal s hh, pairCore_le_pairGroup_core s hh, pairCore_inf_seed hh,
    pairCore_product s hh⟩

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.CommonCore
