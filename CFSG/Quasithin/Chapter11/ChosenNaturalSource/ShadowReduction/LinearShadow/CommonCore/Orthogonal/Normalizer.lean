module

public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.LinearShadow.CommonCore.Conjugates
public import Theory.GroupTheory.PResidual.PrimeToMonotone
public import Theory.GroupTheory.PResidual.PrimeToSubnormal

/-!
# The literal normalizer and odd-index residual reduction

Set G_P = N_G(P) and Y = ⟨L₂,I⟩ with the original conjugate pair I.
The two-core equality makes Y and T subgroups of G_P. The pair generators
lie in O^{2′}(G_P), and so does L₂ when it is generated by its two-elements.
Relative normality and containment of T then identify Y with this residual.
The component recognition must supply those remaining premises.

Source: Aschbacher--Smith, combined manuscript, 1 March 2004,
printed p.774. O^{2′}(G_P) is distinct from K = O²(H).
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory
open CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.CommonCore
variable {G : Type*} [Group G]

def coreNormalizer (V H : Subgroup G) (h : G) : Subgroup G :=
  normalizer (pairCore V H h : Set G)

def orthogonalJoin (L₂ V : Subgroup G) (h : G) : Subgroup G :=
  L₂ ⊔ pairGroup V h

variable [Finite G] {T : Sylow 2 G} {L V H : Subgroup G}
    {D : Chapter12.Section02.ChosenModule T L V} {S : D.NonbinaryNaturalInput}
    {U₁ : Submodule (ZMod 2) D.chosenCentralQuotient}

theorem orthogonalJoin_le_coreNormalizer (s : Hypothesis1131At D S U₁ H)
    {h : G} (hh : h ∈ H) (L₂ : Subgroup G)
    (hcore : L₂.pCoreIn 2 = pairCore V H h) :
    orthogonalJoin L₂ V h ≤ coreNormalizer V H h := by
  apply sup_le _ (pairGroup_normalizes_pairCore s hh)
  change L₂ ≤ normalizer (pairCore V H h : Set G)
  rw [← hcore]
  exact L₂.le_normalizer.trans (normalizer_le_normalizer_characteristic_image L₂ (pCore 2 L₂))

omit [Finite G] in
theorem pairCore_le_orthogonalJoin (L₂ : Subgroup G) (h : G) :
    pairCore V H h ≤ orthogonalJoin L₂ V h :=
  (pairCore_le_pairGroup h).trans le_sup_right

theorem pairCore_normal_in_orthogonalJoin (s : Hypothesis1131At D S U₁ H)
    {h : G} (hh : h ∈ H) (L₂ : Subgroup G)
    (hcore : L₂.pCoreIn 2 = pairCore V H h) :
    ((pairCore V H h).subgroupOf (orthogonalJoin L₂ V h)).Normal :=
  (normal_subgroupOf_iff_le_normalizer (pairCore_le_orthogonalJoin L₂ h)).mpr
    (orthogonalJoin_le_coreNormalizer s hh L₂ hcore)

theorem sylow_le_coreNormalizer {c : Coordinates D S.field} (f : InvariantFlag c)
    {h : G} (hcore : (f.Li 1).pCoreIn 2 = pairCore V H h) :
    (T : Subgroup G) ≤ coreNormalizer V H h := by
  rw [coreNormalizer, ← hcore]
  exact (f.sylow_normalizes_Li 1).trans
    (normalizer_le_normalizer_characteristic_image _ (pCore 2 _))

theorem coreNormalizer_twoLocal {c : Coordinates D S.field} (f : InvariantFlag c)
    {h : G} (hh : h ∈ H) (hB : axis V H = f.Vi 1) :
    IsTwoLocal (coreNormalizer V H h) := by
  refine ⟨pairCore V H h, ?_, (isPGroup_pCoreIn 2 H).to_le (pairCore_le_core hh), rfl⟩
  intro hp
  apply f.V_ne_bot 1
  rw [← hB]
  exact bot_unique ((show axis V H ≤ pairCore V H h from le_sup_left).trans hp.le)

theorem coreNormalizer_mem_He {c : Coordinates D S.field} (f : InvariantFlag c)
    {h : G} (hh : h ∈ H) (hB : axis V H = f.Vi 1)
    (hcore : (f.Li 1).pCoreIn 2 = pairCore V H h) :
    coreNormalizer V H h ∈ Chapter1.He G :=
  Chapter1.twoLocal_mem_He_of_sylow_le T (S.source.simpleQTKE.evenCharacteristic T)
    (coreNormalizer_twoLocal f hh hB) (sylow_le_coreNormalizer f hcore)

omit [Finite G] in
/-- A two-subgroup lies in the literal embedded odd-index residual. -/
private theorem twoGroup_le_oddResidual (J Q : Subgroup G) (hQJ : Q ≤ J)
    (hQ : IsPGroup 2 Q) : Q ≤ (primeToResidual 2 J).map J.subtype := by
  intro q hq
  obtain ⟨n,hn⟩ := hQ ⟨q,hq⟩
  refine ⟨⟨q,hQJ hq⟩, mem_primeToResidual_of_pow (n := n) ?_, rfl⟩
  apply Subtype.ext
  exact congrArg (fun x : Q => (x : G)) hn

/-- The literal pair and a rank-one residual generate only the odd-index residual. -/
theorem orthogonalJoin_le_oddResidual (s : Hypothesis1131At D S U₁ H)
    {h : G} (hh : h ∈ H) (L₂ : Subgroup G)
    (hcore : L₂.pCoreIn 2 = pairCore V H h)
    (hres : primeToResidual 2 L₂ = ⊤) :
    orthogonalJoin L₂ V h ≤
      (primeToResidual 2 (coreNormalizer V H h)).map (coreNormalizer V H h).subtype := by
  have hY := orthogonalJoin_le_coreNormalizer s hh L₂ hcore
  have hL₂ : L₂ ≤ coreNormalizer V H h := le_sup_left.trans hY
  apply sup_le
  · intro l hl
    let f := inclusion hL₂
    have hf := map_primeToResidual_le_of_hom 2 f
    have hm : f ⟨l,hl⟩ ∈ (primeToResidual 2 L₂).map f :=
      mem_map_of_mem f (hres.symm ▸ (show (⟨l,hl⟩ : L₂) ∈ ⊤ from trivial))
    exact ⟨f ⟨l,hl⟩, hf hm, rfl⟩
  · apply sup_le
    · exact twoGroup_le_oddResidual _ V (le_sup_left.trans (le_sup_right.trans hY))
        (@IsElementaryAbelian.isPGroup 2 V _ D.elementary)
    · exact twoGroup_le_oddResidual _ _ (le_sup_right.trans (le_sup_right.trans hY))
        ((@IsElementaryAbelian.isPGroup 2 V _ D.elementary).map _)

/-- Normality and containment of the original Sylow finish the residual step.
The source component calculation must establish both premises. -/
theorem orthogonalJoin_eq_oddResidual (s : Hypothesis1131At D S U₁ H)
    {h : G} (hh : h ∈ H) (L₂ : Subgroup G)
    (hcore : L₂.pCoreIn 2 = pairCore V H h)
    (hres : primeToResidual 2 L₂ = ⊤)
    (hn : ((orthogonalJoin L₂ V h).subgroupOf (coreNormalizer V H h)).Normal)
    (hT : (T : Subgroup G) ≤ orthogonalJoin L₂ V h) :
    orthogonalJoin L₂ V h =
      (primeToResidual 2 (coreNormalizer V H h)).map (coreNormalizer V H h).subtype := by
  have hY := orthogonalJoin_le_coreNormalizer s hh L₂ hcore
  let := hn
  apply le_antisymm (orthogonalJoin_le_oddResidual s hh L₂ hcore hres)
  let t : Sylow 2 (coreNormalizer V H h) := T.subtype (hT.trans hY)
  have ht : (t : Subgroup (coreNormalizer V H h)) ≤
      (orthogonalJoin L₂ V h).subgroupOf (coreNormalizer V H h) := by
    intro x hx
    exact hT hx
  have hc : Nat.Coprime 2
      ((orthogonalJoin L₂ V h).subgroupOf (coreNormalizer V H h)).index :=
    (Nat.prime_two.coprime_iff_not_dvd.mpr t.not_dvd_index).coprime_dvd_right
      (index_dvd_of_le ht)
  have he := map_mono (f := (coreNormalizer V H h).subtype) (primeToResidual_le _ hc)
  rwa [map_subgroupOf_eq_of_le hY] at he

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.CommonCore
