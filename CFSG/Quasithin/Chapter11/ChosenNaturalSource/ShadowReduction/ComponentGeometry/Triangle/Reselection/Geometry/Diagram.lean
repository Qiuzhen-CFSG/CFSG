module
public import Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms.ExtensionCores
public import Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms.MarkedParabolicPair

/-!
# Diagram control from the common plane residual

The normalizer of the plane residual is the plane parabolic. Therefore an
extension generated by the symplectic component and a subgroup normalizing
that residual preserves the parabolic diagram. This removes any separate
automorphism hypothesis from the radical calculation in 11.4.1(2).

Source: Aschbacher--Smith, 11.1.2(3), p.764, and 11.4.1(2), p.776.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open Theory.SpecificGroups.SymplecticFour
open Theory.SpecificGroups.SymplecticFour.DiagramAutomorphisms
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Triangle.Reselection
variable {H F : Type*} [Group H] [Field F] [Finite F] [CharP F 2]

/-- A normalizer of the marked plane residual supplies diagram preservation. -/
theorem extension_preservesDiagram_of_plane_normalizer
    {n : ℕ} (hF : Nat.card F = 2 ^ n) (hn : 1 < n)
    (N : Subgroup H) [N.Normal] (e : Sp F ≃* N) (P : Subgroup H)
    (hgen : N ⊔ P = ⊤)
    (hnorm : P ≤ normalizer (planeLocal.map (N.subtype.comp e.toMonoidHom) : Set H)) :
    ∀ g : H, PreservesDiagram (extensionAction N e g) := by
  have hq : 2 < Nat.card F := by
    rw [hF]
    exact (show 2 ^ 1 < 2 ^ n from Nat.pow_lt_pow_right (by decide) hn)
  let Q := (parabolicClassAction hq).ker.comap (extensionAction N e)
  have hN : N ≤ Q := by
    intro g hg
    apply (mem_parabolicClassAction_ker_iff hq _).mpr
    obtain ⟨x, hx⟩ := e.surjective ⟨g, hg⟩
    have he : extensionAction N e g = MulAut.conj x := by
      apply MulEquiv.ext
      intro y
      apply e.injective
      apply Subtype.ext
      rw [extensionAction_apply]
      have hx' : (e x).val = g := congrArg Subtype.val hx
      simp only [MulAut.conj_apply, map_mul, map_inv, Subgroup.coe_mul,
        Subgroup.coe_inv, hx']
    rw [he]
    exact inner_preservesDiagram x
  have hP : P ≤ Q := by
    intro g hg
    let a := extensionAction N e g
    let j := N.subtype.comp e.toMonoidHom
    have he : j.comp a.toMonoidHom = (MulAut.conj g).toMonoidHom.comp j := by
      ext x
      exact extensionAction_apply N e g x
    have hfix : planeLocal.map a.toMonoidHom = planeLocal := by
      apply map_injective (f := j) (N.subtype_injective.comp e.injective)
      rw [map_map, he, ← map_map]
      exact mem_normalizer_iff_map_conj_eq.mp (hnorm hg)
    apply (mem_parabolicClassAction_ker_iff hq _).mpr
    apply preservesDiagram_of_one_parabolic_class hq a
    right
    refine ⟨1, ?_⟩
    have h1 : (MulAut.conj (1 : Sp F)).toMonoidHom = MonoidHom.id _ := by
      ext x : 1
      simp
    rw [h1, map_id, ← planeLocal_normalizer hF hn, map_equiv_normalizer_eq, hfix]
  have ht : Q = ⊤ := top_unique (hgen ▸ sup_le hN hP)
  intro g
  apply (mem_parabolicClassAction_ker_iff hq _).mp
  exact show g ∈ Q from ht ▸ mem_top g

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Triangle.Reselection
