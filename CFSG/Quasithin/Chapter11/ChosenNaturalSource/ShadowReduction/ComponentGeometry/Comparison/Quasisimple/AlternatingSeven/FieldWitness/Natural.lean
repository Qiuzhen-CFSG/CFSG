module
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple.AlternatingSeven.FieldWitness.Rows
public import CFSG.Quasithin.ChapterB.Section05.Quasisimple.SourceImplication.MovedRestriction

/-!
# Coordinates on the original A7 moved six-space

The split moved quotient has zero central kernel. Its natural coordinates
therefore give a linear equivalence on the literal moved space of the
original omega-core action. The actor is the actual subgroup generated by
best offenders; the group equivalence marks the original component as A7.
Every intertwining equation is transported through the original inclusions.

Source: Aschbacher--Smith, 11.4.2, printed p.777; B.4.2(5), B.5.1.
-/

set_option backward.isDefEq.respectTransparency false
public noncomputable section
open scoped IsMulCommutative
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open CFSG.Quasithin.ChapterB.QuasisimpleSource
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple.AlternatingSeven.FieldWitness
section Linear
variable {Q W : Type*} [Group Q] [AddCommGroup W] [Module (ZMod 2) W]
    {ρ : Representation (ZMod 2) Q W} {K J : Subgroup Q}

private theorem central_eq_bot (s : MovedSection ρ K)
    (hc : IsCompl s.space.toSubmodule (fixedSpace ρ K)) : s.central.toSubmodule = ⊥ := by
  rw [s.central_eq]
  apply bot_unique
  intro v hv
  apply Subtype.ext
  exact (disjoint_iff.mp hc.disjoint).le ⟨v.property, fun g => congrArg Subtype.val (hv g)⟩

private def splitEquiv (s : MovedSection ρ K)
    (hc : IsCompl s.space.toSubmodule (fixedSpace ρ K)) :
    ActionEquiv s.action s.space.toRepresentation where
  groupEquiv := MulEquiv.refl Q
  linearEquiv := s.central.toSubmodule.quotEquivOfEqBot (central_eq_bot s hc)
  intertwines g v := by
    induction v using Submodule.Quotient.induction_on with | _ v => rfl

private def wholeAction {Q' W' : Type*} [Group Q'] [AddCommGroup W'] [Module (ZMod 2) W']
    {σ : Representation (ZMod 2) Q' W'} (hJ : J = ⊤)
    (e : ActionEquiv (ρ.comp J.subtype) σ) : ActionEquiv ρ σ := by
  subst J
  exact ⟨Subgroup.topEquiv.symm.trans e.groupEquiv,e.linearEquiv,
    fun g v => e.intertwines ⟨g,mem_top g⟩ v⟩

private theorem wholeAction_apply {Q' W' : Type*} [Group Q'] [AddCommGroup W'] [Module (ZMod 2) W']
    {σ : Representation (ZMod 2) Q' W'} (hJ : J = ⊤)
    (e : ActionEquiv (ρ.comp J.subtype) σ) (g : J) :
    (wholeAction hJ e).groupEquiv (g : Q) = e.groupEquiv g := by
  subst J
  rfl

/-- The quotient coordinates give coordinates on the literal moved space
after the central kernel has been proved zero. The original component is
marked through the actual subgroup inclusions. -/
def naturalMovedEquiv (hKJ : K ≤ J)
    (s : MovedSection (ρ.comp J.subtype) (K.subgroupOf J)) (t : MovedSection ρ K)
    (hc : IsCompl s.space.toSubmodule (fixedSpace (ρ.comp J.subtype) (K.subgroupOf J)))
    (hj : offenderSubgroup s.action = ⊤)
    (e : MarkedActionEquiv s.action (offenderSubgroup s.action) (K.subgroupOf J)
      (BinaryPermutation.naturalRepresentation (Fin 7)) (alternatingGroup (Fin 7))) :
    MarkedActionEquiv t.space.toRepresentation J K
      (BinaryPermutation.naturalRepresentation (Fin 7)) (alternatingGroup (Fin 7)) := by
  have heq : t.space.toSubmodule = s.space.toSubmodule := by
    rw [t.space_eq,s.space_eq,moved_comp_map,map_subgroupOf_eq_of_le hKJ]
  let i := LinearEquiv.ofEq _ _ heq
  let q := splitEquiv s hc
  let f := wholeAction hj e.action
  let l := (i.trans q.linearEquiv.symm).trans f.linearEquiv
  refine ⟨⟨f.groupEquiv,l,?_⟩,hKJ,(subgroupOfEquivOfLe hKJ).symm.trans e.subgroupEquiv,?_⟩
  · intro g v
    have hi : i (t.space.toRepresentation (g : Q) v) = s.space.toRepresentation g (i v) := by
      apply Subtype.ext
      rfl
    have hq : q.linearEquiv.symm (s.space.toRepresentation g (i v)) =
        (MovedSection.action (ρ.comp J.subtype) s) g (q.linearEquiv.symm (i v)) := by
      apply q.linearEquiv.injective
      simpa only [q.linearEquiv.apply_symm_apply, show q.groupEquiv g = g from rfl] using
        (q.intertwines g (q.linearEquiv.symm (i v))).symm
    change f.linearEquiv (q.linearEquiv.symm (i (t.space.toRepresentation (g : Q) v))) = _
    rw [hi,hq,f.intertwines]
    rfl
  · intro k
    exact (wholeAction_apply hj e.action
      ⟨(subgroupOfEquivOfLe hKJ).symm k,e.contained ((subgroupOfEquivOfLe hKJ).symm k).property⟩).trans
      (e.compatible ((subgroupOfEquivOfLe hKJ).symm k))
end Linear
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    {D : Chapter12.Section02.ChosenModule T L V} (E : Closure.Geometry D)

/-- The original moved space has dimension six and the actual marked
symmetric action. Its central quotient is removed using the proved splitting. -/
theorem natural_moved
    (h : EarlierGeometry E) (hf : V ⊓ centralizer (L : Set G) = ⊥)
    (hne : E.Kz ≠ E.K) (hstar : E.Kz ∈ Chapter1.LStar G (T : Subgroup G))
    [IsQuasisimple (E.Kz ⧸ pCore 2 E.Kz)]
    (hcent : E.V₁ ≤ centralizer (E.R₁ : Set G))
    (hmodel : AlternatingSevenModel E) (hff : IsFFModule (action E))
    (e : (E.L₁ ⧸ pCore 2 E.L₁) ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 2) E.input.field.Carrier) :
    ∃ t : MovedSection (action E) (componentImage E),
      IsIrrPlus (action E) (componentImage E) t.space.toSubmodule ∧
      IsCompl t.space.toSubmodule (fixedSpace (action E) (componentImage E)) ∧
      Nonempty (MarkedActionEquiv t.space.toRepresentation (offenderGroup E) (componentImage E)
        (BinaryPermutation.naturalRepresentation (Fin 7)) (alternatingGroup (Fin 7))) ∧
      Module.finrank (ZMod 2) (moved (action E) (componentImage E)) = 6 := by
  obtain ⟨hKJ,s,hi,hc,⟨a⟩,hq⟩ := exists_six_section E h hf hne hstar hcent hmodel hff e
  let := componentImage_normal E h
  let t := MovedSection.ofNormal (action E) (componentImage E)
  have hj : offenderSubgroup s.action = ⊤ :=
    ExtensionConsequences.DualExtensions.section_generated s hq
      (offenderSubgroup_restrict_eq_top (action E))
  let b := naturalMovedEquiv hKJ s t hc hj a
  have hspace : s.space.toSubmodule = t.space.toSubmodule := by
    rw [s.space_eq,t.space_eq,moved_comp_map,map_subgroupOf_eq_of_le hKJ]
  have hi' := (IsIrrPlus.subgroupOf_iff (action E) (componentImage E) (offenderGroup E)
    hKJ s.space.toSubmodule).mp hi
  rw [hspace] at hi'
  have hc' : IsCompl t.space.toSubmodule (fixedSpace (action E) (componentImage E)) := by
    rw [hspace, fixedSpace_offender_subgroup E _ hKJ] at hc
    exact hc
  have hd := b.action.linearEquiv.finrank_eq
  rw [BinaryPermutation.finrank_natural_odd (Fin 7) (by decide),Fintype.card_fin] at hd
  rw [t.space_eq] at hd
  exact ⟨t,hi',hc',⟨b⟩,hd⟩

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple.AlternatingSeven.FieldWitness
