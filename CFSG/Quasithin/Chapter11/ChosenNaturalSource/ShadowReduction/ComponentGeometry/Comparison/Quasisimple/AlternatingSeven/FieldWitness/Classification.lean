module
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple.AlternatingSeven.SeedQuotient
public import CFSG.Quasithin.ChapterB.Section05.Quasisimple.SourceCompletion.FFQuasisimple
public import Theory.GroupTheory.PrimeRankCubeFree

/-!
# B.5.1 on the original A7 offender subgroup

The actual centralizer quotient has a normal A7 component and two-group
quotient. The point two-local supplies the complete known-simple hypothesis;
the A7 order bounds its odd-prime ranks. Applying the proved B.5.1 theorem
then constructs all six source clauses on the literal offender subgroup.
The chosen-flag application obtains its FF witness from 11.4.2's reduction.

Source: Aschbacher--Smith, 11.4.2, printed p.777, and B.5.1.
-/

set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple.AlternatingSeven.FieldWitness
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    {D : Chapter12.Section02.ChosenModule T L V} (E : Closure.Geometry D)

/-- The subgroup generated by best offenders on the original action. -/
abbrev offenderGroup := offenderSubgroup (action E)
/-- Restriction of the original action to its offender subgroup. -/
abbrev offenderAction := (action E).comp (offenderGroup E).subtype
/-- The original component, restricted to the offender subgroup. -/
abbrev offenderComponent := (componentImage E).subgroupOf (offenderGroup E)
/-- The marked seed, restricted to the offender subgroup. -/
abbrev offenderSeed := (seedImage E).subgroupOf (offenderGroup E)

private theorem stronglyQuasithin_of_card (Q : Type*) [Group Q] [Finite Q]
    (hc : Nat.card Q = 2520) : IsStronglyQuasithin Q := by
  intro p hp ho
  let : Fact p.Prime := ⟨hp⟩
  apply primeRank_le_two_of_cube_not_dvd
  rw [hc]
  intro hd
  have hb := Nat.le_of_dvd (by decide : 0 < 2520) hd
  have hlt : p < 14 := by nlinarith [sq_nonneg (p : ℤ)]
  have hp2 := hp.two_le
  interval_cases p <;> norm_num at *

/-- Both SQTK clauses hold for the actual A7 image. -/
theorem componentImage_sqtk (h : EarlierGeometry E) (hmodel : AlternatingSevenModel E) :
    IsSQTK KnownSimple.IsKnownSimple (componentImage E) := by
  obtain ⟨e⟩ := hmodel.2
  have hc : Nat.card (componentImage E) = 2520 := by
    rw [componentImage, Nat.card_congr e.toEquiv, nat_card_alternatingGroup]
    norm_num [Nat.factorial]
  have hsq := E.input.source.simpleQTKE.twoLocal_sqtk
    (point_twoLocal E h.point_mem h.point_fixed h.point_ne_one)
  have hle : localGroup E ≤ Gz E := sup_le h.point_component.1 h.sylow_le_pointCentralizer
  have hk : IsKGroup KnownSimple.IsKnownSimple (localGroup E) :=
    hsq.isKGroup.of_injective (inclusion hle) (inclusion_injective hle)
  exact ⟨stronglyQuasithin_of_card _ hc,
    (hk.subgroup (component E)).of_surjective ((projection E).subgroupMap (component E))
      ((projection E).subgroupMap_surjective _)⟩

/-- Normality is relative to the original centralizer quotient. -/
theorem componentImage_normal (h : EarlierGeometry E) : (componentImage E).Normal := by
  let := component_normal E h
  exact Normal.map inferInstance (projection E) (QuotientGroup.mk'_surjective _)

/-- The original Sylow image generates the quotient above the component. -/
theorem quotient_componentImage_isTwoGroup (h : EarlierGeometry E) :
    let := componentImage_normal E h
    IsPGroup 2 (ActionQuotient E ⧸ componentImage E) := by
  let := componentImage_normal E h
  apply isPGroup_quotient_of_sup_eq_top (componentImage E)
    ((sylow E : Subgroup (localGroup E)).map (projection E)) ((sylow E).isPGroup'.map _)
  change (component E).map (projection E) ⊔ _ = _
  rw [←Subgroup.map_sup, component_sup_sylow,
    map_top_of_surjective (projection E) (QuotientGroup.mk'_surjective _)]

/-- Construct all six B.5.1 clauses on the literal offender restriction. -/
theorem source_classification
    (h : EarlierGeometry E) (hf : V ⊓ centralizer (L : Set G) = ⊥)
    (hne : E.Kz ≠ E.K) (hstar : E.Kz ∈ Chapter1.LStar G (T : Subgroup G))
    [IsQuasisimple (E.Kz ⧸ pCore 2 E.Kz)]
    (hcent : E.V₁ ≤ centralizer (E.R₁ : Set G))
    (hmodel : AlternatingSevenModel E) (hff : IsFFModule (action E)) :
    componentImage E ≤ offenderGroup E ∧
    Nonempty (ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
      (offenderAction E) (offenderComponent E)) := by
  let := componentImage_normal E h
  let : IsQuasisimple (componentImage E) := (action_structure E h hf hne hstar hcent).2.2
  exact ChapterB.QuasisimpleSource.SourceCompletion.ff_quasisimple_source_conclusion
    (action E) (componentImage E) (quotient_componentImage_isTwoGroup E h)
    (module_reduced E h hf hne hstar hcent).quotient_pCore_eq_bot
    (componentImage_sqtk E h hmodel) (action_faithful E) hff

/-- The chosen-flag consumer supplies the actual FF witness internally. -/
theorem ofFlag_source_classification
    (S : D.NonbinaryNaturalInput)
    {c : LocalGeometry.Coordinates D S.field} (f : LocalGeometry.InvariantFlag c)
    (X : Subgroup G) (z : G) (H : Subgroup G)
    (h : EarlierGeometry (ofFlag S f X z H))
    (hne : (ofFlag S f X z H).Kz ≠ (ofFlag S f X z H).K)
    (hstar : (ofFlag S f X z H).Kz ∈ Chapter1.LStar G (T : Subgroup G))
    [IsQuasisimple ((ofFlag S f X z H).Kz ⧸ pCore 2 (ofFlag S f X z H).Kz)]
    (hlinear : Source.IsSL (L ⧸ pCore 2 L) 3 (2 ^ S.field.degree) →
      V ⊓ centralizer (L : Set G) = ⊥)
    (h1132 : ∀ J, Hypothesis1131At D S (c.binarySubspace (f.space 0)) J →
      Proposition1132At D S (c.binarySubspace (f.space 0)) J)
    (hcent : (ofFlag S f X z H).V₁ ≤ centralizer ((ofFlag S f X z H).R₁ : Set G))
    (hline : (ofFlag S f X z H).V₁ = ⁅zpowers z, X⁆)
    (hXR : X ≤ normalizer ((ofFlag S f X z H).R₁ : Set G))
    (hmodel : AlternatingSevenModel (ofFlag S f X z H)) :
    let E := ofFlag S f X z H
    componentImage E ≤ offenderGroup E ∧
    Nonempty (ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
      (offenderAction E) (offenderComponent E)) := by
  obtain ⟨_,_,_,_,_,hff,_⟩ := ofFlag_ff_reduction S f X z H h hne hstar
    hlinear h1132 hcent hline hXR
  exact source_classification _ h (fixed_and_transitive D S _ hlinear h1132).1
    hne hstar hcent hmodel hff

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple.AlternatingSeven.FieldWitness
