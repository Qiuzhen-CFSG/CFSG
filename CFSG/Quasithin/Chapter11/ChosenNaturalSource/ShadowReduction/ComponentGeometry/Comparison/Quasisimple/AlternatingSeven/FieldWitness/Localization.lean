module
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple.AlternatingSeven.FieldWitness.Permutation
public import Stellmacher.ElementaryAbelianMaxSylowImages
public import CFSG.Quasithin.ChapterB.Section02.Thompson.Embedding
/-!
# Lifting a prescribed transposition to a maximum elementary subgroup

Equal two-ranks promote the original radical's maximum elementary family
to the Sylow family. A nontrivial Thompson image generated by a transposition
therefore comes from a maximum elementary subgroup. Conjugate its image to
the prescribed transposition, then conjugate by the quotient kernel to put
the subgroup back in the original Sylow without changing its image.

Source: Aschbacher--Smith, 11.4.2, printed p.777.
-/

set_option backward.isDefEq.respectTransparency false
public noncomputable section
open Subgroup Stellmacher Equiv Equiv.Perm
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple.AlternatingSeven.FieldWitness

section Localization
variable {H : Type*} [Group H] [Finite H]

/-- Equality of two-ranks promotes each maximum elementary subgroup. -/
theorem maxFamily_of_equal_rank (R P A : Subgroup H) (hRP : R ≤ P)
    (hr : ChapterB.twoRank R = ChapterB.twoRank P)
    (hA : A ∈ elementaryAbelianMaxSubgroups R) :
    A ∈ elementaryAbelianMaxSubgroups P := by
  rw [←ChapterB.thompsonFamily_zero] at hA ⊢
  refine ⟨hA.1.trans hRP,hA.2.1,Nat.zero_le _,?_⟩
  simpa only [←hr] using hA.2.2.2

/-- Conjugating a moving maximum elementary subgroup and then conjugating
by the quotient kernel puts its prescribed transposition image in the
original Sylow subgroup, without changing that image. -/
theorem exists_maxFamily_lift_swap
    (P : Sylow 2 H) (R : Subgroup H) (hRP : R ≤ P)
    (hr : ChapterB.twoRank R = ChapterB.twoRank (P : Subgroup H))
    (q : H →* Perm (Fin 7)) (hq : Function.Surjective q)
    (s : Perm (Fin 7)) (hs : s.IsSwap)
    (hJ : (elementaryAbelianMaxJ R).map q = zpowers s)
    (x : Perm (Fin 7)) (hx : x.IsSwap) (hxP : x ∈ (P : Subgroup H).map q) :
    ∃ A ∈ elementaryAbelianMaxSubgroups (P : Subgroup H),
      ∃ a ∈ A, q a = x := by
  have hex : ∃ A ∈ elementaryAbelianMaxSubgroups R, A.map q ≠ ⊥ := by
    by_contra! hall
    have hle : elementaryAbelianMaxJ R ≤ q.ker :=
      sSup_le fun A hA => (Subgroup.map_eq_bot_iff A).mp (hall A hA)
    have hz := (Subgroup.map_eq_bot_iff _).mpr hle
    rw [hJ] at hz
    have he : s = 1 := by simpa only [hz,mem_bot] using mem_zpowers s
    have ho := hs.orderOf
    rw [he,orderOf_one] at ho
    contradiction
  obtain ⟨A,hA,hAn⟩ := hex
  have hAqle : A.map q ≤ zpowers s := hJ ▸ map_mono (le_sSup hA)
  have hAq : A.map q = zpowers s := by
    have hd : Nat.card (A.map q) ∣ 2 := by
      simpa only [Nat.card_zpowers,hs.orderOf] using card_dvd_of_le hAqle
    have hc : Nat.card (A.map q) = 2 := ((Nat.dvd_prime Nat.prime_two).mp hd).resolve_left
      (fun hh => hAn (Subgroup.card_eq_one.mp hh))
    apply eq_of_le_of_card_ge hAqle
    rw [hc,Nat.card_zpowers,hs.orderOf]
  have hAP := maxFamily_of_equal_rank R P A hRP hr hA
  have hAg := (maxFamily_sylow_iff P A).mp hAP |>.2
  have hconj : IsConj s x := isConj_of_cycleType_eq
    ((isSwap_iff_cycleType.mp hs).trans (isSwap_iff_cycleType.mp hx).symm)
  obtain ⟨g,hg⟩ := isConj_iff.mp hconj
  obtain ⟨u,rfl⟩ := hq g
  let C := A.map (MulAut.conj u).toMonoidHom
  have hC : C ∈ elementaryAbelianMaxSubgroups (⊤ : Subgroup H) := by
    have hh := (maxFamily_map_injective_iff (MulAut.conj u).toMonoidHom
      (MulAut.conj u).injective ⊤ A).mpr hAg
    rw [map_top_of_surjective (MulAut.conj u).toMonoidHom (MulAut.conj u).surjective] at hh
    exact hh
  have hCq : C.map q = zpowers x := by
    have hm : C.map q = (A.map q).map (MulAut.conj (q u)).toMonoidHom := by
      rw [map_map,map_map]
      congr 1
      apply MonoidHom.ext
      intro a
      change q (u * a * u⁻¹) = q u * q a * (q u)⁻¹
      simp only [map_mul,map_inv]
    rw [hm,hAq,MonoidHom.map_zpowers]
    exact congrArg zpowers hg
  obtain ⟨B,hB,hBq⟩ := exists_maxFamily_sylow_same_image P q C hC
    (hCq ▸ zpowers_le.mpr hxP)
  have hxB : x ∈ B.map q := by
    rw [hBq,hCq]
    exact mem_zpowers x
  obtain ⟨a,ha,hqa⟩ := hxB
  exact ⟨B,hB,a,ha,hqa⟩
end Localization
end CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple.AlternatingSeven.FieldWitness
