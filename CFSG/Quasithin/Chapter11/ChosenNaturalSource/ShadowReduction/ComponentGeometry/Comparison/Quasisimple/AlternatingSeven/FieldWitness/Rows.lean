module
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple.AlternatingSeven.FieldWitness.Classification
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple.AlternatingSeven.FieldWitness.Orders

/-!
# The natural six-space row in the A7 branch of 11.4.2

The genuine B.5.1 classification is applied to the subgroup generated by
best offenders. Actor orders exclude its other families. The marked
L1-fixed moving vector excludes the A7 four-space, leaving the symmetric
natural seven-point representation and its ratio-one conclusion. The
fixed spaces here are transported along the literal subgroup inclusions.

Source: Aschbacher--Smith, 11.4.2, printed p.777; B.4.2 and B.5.1.
-/

set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
open scoped IsMulCommutative
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open CFSG.Quasithin.ChapterB.QuasisimpleSource
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple.AlternatingSeven.FieldWitness
section Linear
variable {Q W : Type*} [Group Q] [Finite Q] [AddCommGroup W] [Module (ZMod 2) W]
    [FiniteDimensional (ZMod 2) W] {ρ : Representation (ZMod 2) Q W} {K B : Subgroup Q}

private def binarySymplecticDerivedEquiv :
    commutator (Matrix.symplecticGroup (Fin 2) (ZMod 2)) ≃* alternatingGroup (Fin 6) := by
  let e := Theory.SpecificGroups.SymplecticFour.Binary.symmetricSixEquiv.symm
  refine (e.subgroupMap _).trans (MulEquiv.subgroupCongr ?_)
  rw [map_commutator_eq, MonoidHom.range_eq_top.mpr e.surjective]
  exact alternatingGroup.commutator_perm_eq (by norm_num)

private theorem eq_card_of_equiv {A C : Type*} [Group A] [Group C]
    (h : Nat.card A = 2520) (e : A ≃* C) : Nat.card C = 2520 :=
  (Nat.card_congr e.toEquiv).symm.trans h

private theorem not_binary_linear {A : Type*} [Group A] (hA : Nat.card A = 2520)
    {n : ℕ} (hn : n = 4 ∨ n = 5)
    (e : A ≃* Matrix.SpecialLinearGroup (Fin n) (ZMod 2)) : False := by
  rcases hn with rfl | rfl
  · exact Orders.not_sl_four (eq_card_of_equiv hA e)
  · exact Orders.not_sl_five (eq_card_of_equiv hA e)

omit [Finite Q] [FiniteDimensional (ZMod 2) W] in
private theorem irreducible_rows {I : Subgroup Q} (hK : Nat.card K = 2520)
    (h : ChapterB.SourceInduction.ProjectiveLine.IrreducibleActionCase ρ K I) :
    (∃ e : MarkedActionEquiv ρ I K (BinaryPermutation.naturalRepresentation (Fin 7))
      (alternatingGroup (Fin 7)),
      (∀ A, IsBestOffender ρ A → ChapterB.Offenders.CaseAFamily 7
        ((A.subgroupOf I).map e.action.groupEquiv.toMonoidHom)) ∧ quadraticRatio ρ = 1) ∨
    (I = K ∧ K = ⊤ ∧ ∃ e : K ≃* alternatingGroup (Fin 7),
      Module.finrank (ZMod 2) W = 4 ∧
      (∀ A, IsBestOffender ρ A → ∃ g : alternatingGroup (Fin 7),
        ((A.subgroupOf K).map ((alternatingGroup (Fin 7)).subtype.comp e.toMonoidHom)) =
          (Subgroup.closure {ChapterB.Offenders.kleinFirst 7 (by decide),
            ChapterB.Offenders.kleinSecond 7 (by decide)}).map
              (MulAut.conj (g : Equiv.Perm (Fin 7))).toMonoidHom) ∧ quadraticRatio ρ = 1) := by
  cases h with
  | linearTwo F _ e _ _ => exact (Orders.not_sl_two F (eq_card_of_equiv hK e.groupEquiv)).elim
  | linearThree F _ e _ => exact (Orders.not_sl_three F (eq_card_of_equiv hK e.groupEquiv)).elim
  | symplectic F _ _ e _ => exact (Orders.not_sp_four F (eq_card_of_equiv hK e.groupEquiv)).elim
  | symplecticTwo e _ =>
    have hc := eq_card_of_equiv hK (e.subgroupEquiv.trans binarySymplecticDerivedEquiv)
    rw [nat_card_alternatingGroup] at hc
    norm_num [Nat.factorial] at hc
  | g2 F _ _ e _ _ => exact (Orders.not_g2 F (eq_card_of_equiv hK e.groupEquiv)).elim
  | g2Two e _ _ => exact (Orders.not_g2_derived (eq_card_of_equiv hK e.subgroupEquiv)).elim
  | symmetric n hn e ho hq =>
    rcases hn with rfl | rfl
    · have hc := eq_card_of_equiv hK e.subgroupEquiv
      rw [nat_card_alternatingGroup] at hc
      norm_num [Nat.factorial] at hc
    · exact Or.inl ⟨e,ho,hq⟩
  | alternatingSix _ e _ _ =>
    have hc := eq_card_of_equiv hK e.groupEquiv
    rw [nat_card_alternatingGroup] at hc
    norm_num [Nat.factorial] at hc
  | alternatingSeven hg ht e hd ho hq => exact Or.inr ⟨hg,ht,e,hd,ho,hq⟩
  | tripleSix _ a _ =>
    have hc := Subgroup.card_eq_card_quotient_mul_card_subgroup (center K)
    rw [hK, Nat.card_congr a.quotientEquiv.toEquiv,
      Nat.card_congr a.centerEquiv.toEquiv, nat_card_alternatingGroup] at hc
    norm_num [Nat.factorial, Nat.card_congr Multiplicative.toAdd] at hc
  | binaryLinear n hn _ e _ => exact (not_binary_linear hK hn e.groupEquiv).elim
  | orthogonalSix _ _ e _ _ =>
    have hc := eq_card_of_equiv hK e.groupEquiv
    rw [nat_card_alternatingGroup] at hc
    norm_num [Nat.factorial] at hc
  | symmetricEight _ e _ =>
    have hc := eq_card_of_equiv hK e.subgroupEquiv
    rw [nat_card_alternatingGroup] at hc
    norm_num [Nat.factorial] at hc
  | exteriorFive _ _ e _ _ _ => exact (Orders.not_sl_five (eq_card_of_equiv hK e)).elim

/-- The genuine B.5.1 alternatives and a moving fixed seed construct the
natural six-space section and its marked symmetric action. -/
theorem six_section_of_source (mark : K ≃* alternatingGroup (Fin 7))
    (hBK : B ≤ K) (hfive : 5 ∣ Nat.card B)
    (hv : ∃ v, v ∈ fixedSpace ρ B ∧ v ∉ fixedSpace ρ K)
    (c : ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion ρ K) :
    IsIrrPlus ρ K c.sectionData.space.toSubmodule ∧
    IsCompl c.sectionData.space.toSubmodule (fixedSpace ρ K) ∧
    Nonempty (MarkedActionEquiv c.sectionData.action (offenderSubgroup c.sectionData.action) K
      (BinaryPermutation.naturalRepresentation (Fin 7)) (alternatingGroup (Fin 7))) ∧
    quadraticRatio c.sectionData.action = 1 := by
  have hK : Nat.card K = 2520 := (Nat.card_congr mark.toEquiv).trans Orders.alternating_card
  cases c.clause_one with
  | doubleThree F _ e _ _ => exact (Orders.not_sl_three F (eq_card_of_equiv hK e.groupEquiv)).elim
  | naturalDual n hn _ e => exact (not_binary_linear hK hn e.some.groupEquiv).elim
  | repeatedNatural n r hn _ _ _ e => exact (not_binary_linear hK hn e.some.groupEquiv).elim
  | irreducible hi hf hirr hs he =>
    rcases irreducible_rows hK hs with ⟨e,ho,hq⟩ | ⟨hg,ht,e,hd,ho,hq⟩
    · exact ⟨hi, ExtensionConsequences.symmetricOdd_isCompl c.sectionData hi (Or.inr rfl) e,
        ⟨e⟩,hq⟩
    · have hlegacy : IrreducibleActionCase c.sectionData.action K
          (offenderSubgroup c.sectionData.action) := .alternatingSeven hg ht e hd ho hq
      have hir : ExtensionConsequences.IrreducibleAlternative K c.sectionData :=
        ⟨hi,hf,hirr,hlegacy,he⟩
      exact (no_four_section_of_fixed_seed ρ K B hBK hfive mark c.sectionData hir hv hd).elim
/-- A ratio-one moved quotient excludes strong offenders on the original module. -/
theorem ratio_ge_one_of_section (s : MovedSection ρ K)
    (hq : quadraticRatio s.action = 1) : 1 ≤ quadraticRatio ρ := by
  apply le_of_not_gt
  intro hlt
  obtain ⟨A,hA⟩ := (isStrongFFModule_iff_quadraticRatio_lt_one ρ).mpr hlt
  have hu := fixedCodim_subrepresentation_le ρ s.space A
  have hc := fixedCodim_quotient_add_subrepresentation_le s.space.toRepresentation s.central A
  have hs : IsStrongFFModule s.action := ⟨A,hA.1,by
    change fixedCodim s.action A + _ ≤ _ at hc
    have := hA.2
    omega⟩
  have := (isStrongFFModule_iff_quadraticRatio_lt_one s.action).mp hs
  rw [hq] at this
  exact lt_irrefl _ this
end Linear

variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    {D : Chapter12.Section02.ChosenModule T L V} (E : Closure.Geometry D)

/-- Restriction preserves the fixed spaces of both marked source subgroups. -/
theorem fixedSpace_offender_subgroup (A : Subgroup (ActionQuotient E))
    (hA : A ≤ offenderGroup E) :
    fixedSpace (offenderAction E) (A.subgroupOf (offenderGroup E)) = fixedSpace (action E) A := by
  rw [offenderAction, fixedSpace_comp_map, map_subgroupOf_eq_of_le hA]

/-- The six-space is constructed on the actual offender restriction, with
no recognition, dimension, splitting or ratio premise. -/
theorem exists_six_section
    (h : EarlierGeometry E) (hf : V ⊓ centralizer (L : Set G) = ⊥)
    (hne : E.Kz ≠ E.K) (hstar : E.Kz ∈ Chapter1.LStar G (T : Subgroup G))
    [IsQuasisimple (E.Kz ⧸ pCore 2 E.Kz)]
    (hcent : E.V₁ ≤ centralizer (E.R₁ : Set G))
    (hmodel : AlternatingSevenModel E) (hff : IsFFModule (action E))
    (e : (E.L₁ ⧸ pCore 2 E.L₁) ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 2) E.input.field.Carrier) :
    componentImage E ≤ offenderGroup E ∧
    ∃ s : MovedSection (offenderAction E) (offenderComponent E),
      IsIrrPlus (offenderAction E) (offenderComponent E) s.space.toSubmodule ∧
      IsCompl s.space.toSubmodule (fixedSpace (offenderAction E) (offenderComponent E)) ∧
      Nonempty (MarkedActionEquiv s.action (offenderSubgroup s.action) (offenderComponent E)
        (BinaryPermutation.naturalRepresentation (Fin 7)) (alternatingGroup (Fin 7))) ∧
      quadraticRatio s.action = 1 := by
  obtain ⟨hKJ,⟨c⟩⟩ := source_classification E h hf hne hstar hcent hmodel hff
  have hBJ := (seedImage_le_componentImage E).trans hKJ
  let mark := (subgroupOfEquivOfLe hKJ).trans hmodel.2.some
  have hfive : 5 ∣ Nat.card (offenderSeed E) := by
    rw [Nat.card_congr (subgroupOfEquivOfLe hBJ).toEquiv]
    exact five_dvd_seedImage E hstar hmodel e
  have hv : ∃ v, v ∈ fixedSpace (offenderAction E) (offenderSeed E) ∧
      v ∉ fixedSpace (offenderAction E) (offenderComponent E) := by
    simpa only [offenderSeed,offenderComponent,fixedSpace_offender_subgroup E _ hBJ,
      fixedSpace_offender_subgroup E _ hKJ] using
      exists_fixed_not_component_fixed E h hf hne hstar hcent
  exact ⟨hKJ,c.sectionData,six_section_of_source mark
    (subgroupOf_mono _ (seedImage_le_componentImage E)) hfive hv c⟩

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple.AlternatingSeven.FieldWitness
