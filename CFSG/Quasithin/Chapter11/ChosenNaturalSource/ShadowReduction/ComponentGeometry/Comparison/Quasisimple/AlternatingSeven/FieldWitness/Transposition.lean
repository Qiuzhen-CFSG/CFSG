public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple.AlternatingSeven.FieldWitness.Natural
public import Theory.SpecificGroups.SymmetricSeven.EightNormalizers
public import Theory.GroupTheory.SmallNonabelianTwoGroupAutomorphismOrderCoarse

/-!
# The Thompson image is a transposition in the marked A7 action

A nontrivial two-subgroup of S7 whose normalizer has a five-divisor is
generated by one transposition. A non-elementary two-subgroup has a unique
nontrivial square, forcing its normalizer into a centralizer of order 48.
For an elementary subgroup, its automorphism group has no five-divisor;
a centralizing element of order five then bounds its order by two.

The original L1 normalizes R1 and hence J(R1), while five divides the
marked seed image. Transport through the actual natural coordinates applies
this calculation to J(R1)* in the original centralizer quotient.
The sixteen-word square calculation is adapted from
Theory/SpecificGroups/SymmetricSeven/EightNormalizers.

Source: Aschbacher--Smith, 11.4.2, printed p.777.
-/

public noncomputable section
open Subgroup Equiv Theory.GroupTheory Representation Representation.BinaryOffender Stellmacher
open CFSG.Quasithin.ChapterB.QuasisimpleSource
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple.AlternatingSeven.FieldWitness
open Representation.AlternatingSevenConjugatePair.ElementaryGeometry

private theorem five_centralizer_card (b : S7) (hb : orderOf b = 5) :
    Nat.card (centralizer ({b} : Set S7)) = 10 := by
  have hc : b.IsCycle := Perm.isCycle_of_prime_order (hb ▸ (by decide : Nat.Prime 5)) (by
    have hs := b.support.card_le_univ
    rw [hb]
    simp only [Fintype.card_fin] at hs
    omega)
  rw [Perm.nat_card_centralizer,hc.cycleType,hc.orderOf.symm,hb]
  norm_num [Nat.factorial]

private theorem elementary_five_normalizer (A : Subgroup S7)
    (hA : IsElementaryAbelian 2 A) (hne : A ≠ ⊥)
    (hfive : 5 ∣ Nat.card (normalizer (A : Set S7))) :
    ∃ t : S7, t.IsSwap ∧ A = zpowers t := by
  let := hA
  let : Fact (Nat.Prime 5) := ⟨by decide⟩
  obtain ⟨n,hn⟩ := (IsElementaryAbelian.isPGroup 2 A).exists_card_eq
  have hn3 : n ≤ 3 := by
    have hh := elementary_card_le hA
    rw [hn] at hh
    exact (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp hh
  have hAut : ¬ 5 ∣ Nat.card (MulAut A) := by
    rw [SmallNonabelianTwoGroup.card_mulAut_elementary_two_pow A n hn]
    interval_cases n <;> norm_num [Fin.prod_univ_succ]
  let f := A.normalizerMonoidHom
  have hker : 5 ∣ Nat.card f.ker := by
    have hprod := f.ker.card_mul_index
    rw [index_ker] at hprod
    rw [←hprod] at hfive
    exact (Nat.Prime.dvd_mul (by decide : Nat.Prime 5)).mp hfive |>.resolve_right
      (fun hh => hAut (hh.trans f.range.card_subgroup_dvd_card))
  have hC : 5 ∣ Nat.card (centralizer (A : Set S7)) := by
    change 5 ∣ Nat.card A.normalizerMonoidHom.ker at hker
    simpa only [normalizerMonoidHom_ker,
      Nat.card_congr (subgroupOfEquivOfLe (centralizer_le_normalizer (A : Set S7))).toEquiv] using hker
  obtain ⟨b,hb⟩ := exists_prime_orderOf_dvd_card' (G := centralizer (A : Set S7)) 5 hC
  have hb' : orderOf (b : S7) = 5 := (Subgroup.orderOf_coe b).trans hb
  have hAC : A ≤ centralizer ({(b : S7)} : Set S7) := by
    intro a ha
    exact mem_centralizer_singleton_iff.mpr (mem_centralizer_iff.mp b.property a ha)
  have hd : Nat.card A ∣ 10 := by
    rw [←five_centralizer_card b hb']
    exact card_dvd_of_le hAC
  have hcard : Nat.card A = 2 := by
    have h1 : Nat.card A ≠ 1 := fun hh => hne (Subgroup.card_eq_one.mp hh)
    rw [hn] at hd h1 ⊢
    interval_cases n <;> norm_num at *
  let : IsCyclic A := isCyclic_of_prime_card hcard
  obtain ⟨t,ht⟩ := isCyclic_iff_exists_orderOf_eq_natCard.mp (inferInstance : IsCyclic A)
  have ht' : orderOf (t : S7) = 2 := (Subgroup.orderOf_coe t).trans (ht.trans hcard)
  have hAt : A = zpowers (t : S7) := by
    symm
    apply eq_of_le_of_card_ge (zpowers_le.mpr t.property)
    rw [Nat.card_zpowers,ht',hcard]
  have hc : 5 ∣ Nat.card (centralizer ({(t : S7)} : Set S7)) := by
    apply hC.trans
    apply card_dvd_of_le
    intro x hx
    exact mem_centralizer_singleton_iff.mpr ((mem_centralizer_iff.mp hx t t.property).symm)
  have ht2 : (t : S7) ^ 2 = 1 := by simpa only [ht'] using pow_orderOf_eq_one (t : S7)
  have htype := Perm.cycleType_of_pow_prime_eq_one ht2
  have hs := (t : S7).sum_cycleType
  have hsbound := (t : S7).support.card_le_univ
  have hp : 0 < (t : S7).cycleType.card := by
    apply Nat.pos_of_ne_zero
    intro hz
    have hzero := Perm.cycleType_eq_zero.mp (Multiset.card_eq_zero.mp hz)
    rw [hzero,orderOf_one] at ht'
    contradiction
  rw [htype,Multiset.sum_replicate] at hs
  have hle : (t : S7).cycleType.card ≤ 3 := by
    simp only [Fintype.card_fin,nsmul_eq_mul,Nat.cast_id] at hs hsbound
    omega
  have hone : (t : S7).cycleType.card = 1 := by
    rw [Perm.nat_card_centralizer,htype] at hc
    interval_cases (t : S7).cycleType.card <;> norm_num [Nat.factorial] at *
  exact ⟨t,Perm.isSwap_iff_cycleType.mpr (by simpa only [hone,Multiset.replicate_one] using htype),hAt⟩

private theorem noninvolution_not_five (A : Subgroup S7) (hA : IsPGroup 2 A)
    (hx : ∃ x ∈ A, x ^ 2 ≠ 1) : ¬ 5 ∣ Nat.card (normalizer (A : Set S7)) := by
  obtain ⟨P,hAP⟩ := hA.exists_le_sylow
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq S7 P standardSylow
  have hP : (P : Subgroup S7).map (MulAut.conj g).toMonoidHom = sylowTwo :=
    congrArg Sylow.toSubgroup hg
  let B := A.map (MulAut.conj g).toMonoidHom
  have hB : B ≤ sylowTwo := hP ▸ map_mono hAP
  have hsquare (v : Quadruple) (hv : word v ^ 2 ≠ 1) :
      word v ^ 2 = swap01 * swap23 :=
    (by decide +kernel : ∀ v : Quadruple,
      word v ^ 2 ≠ 1 → word v ^ 2 = swap01 * swap23) v hv
  obtain ⟨x,hxA,hx2⟩ := hx
  let y := (MulAut.conj g) x
  have hyB : y ∈ B := mem_map_of_mem _ hxA
  have hy2 : y ^ 2 ≠ 1 := by
    intro he
    apply hx2
    apply (MulAut.conj g).injective
    simpa only [map_pow,map_one] using he
  obtain ⟨v,hv⟩ := hB hyB
  have hy : y ^ 2 = swap01 * swap23 := by
    rw [←hv]
    exact hsquare v (hv ▸ hy2)
  have hn : normalizer (B : Set S7) ≤ centralizer ({swap01 * swap23} : Set S7) := by
    intro b hb
    have hby := (mem_normalizer_iff.mp hb y).mp hyB
    obtain ⟨w,hw⟩ := hB hby
    have hne : (b * y * b⁻¹) ^ 2 ≠ 1 := by
      intro he
      apply hy2
      apply (MulAut.conj b).injective
      simpa only [map_pow,map_one,MulAut.conj_apply] using he
    have he : (b * y * b⁻¹) ^ 2 = swap01 * swap23 := by
      rw [←hw]
      exact hsquare w (hw ▸ hne)
    apply mem_centralizer_singleton_iff.mpr
    apply mul_inv_eq_iff_eq_mul.mp
    calc
      b * (swap01 * swap23) * b⁻¹ = b * y ^ 2 * b⁻¹ := by rw [hy]
      _ = (b * y * b⁻¹) ^ 2 := by simp only [pow_two]; group
      _ = swap01 * swap23 := he
  have hcard : Nat.card (normalizer (A : Set S7)) = Nat.card (normalizer (B : Set S7)) := by
    rw [←card_map_of_injective (f := (MulAut.conj g).toMonoidHom) (MulAut.conj g).injective (K := normalizer (A : Set S7)),
      map_equiv_normalizer_eq]
  intro hd
  rw [hcard] at hd
  have hh := hd.trans (card_dvd_of_le hn)
  rw [Perm.nat_card_centralizer,show (swap01 * swap23).cycleType = {2,2} by decide +kernel] at hh
  norm_num [Nat.factorial] at hh

/-- A nontrivial two-subgroup of S7 whose normalizer has a five-divisor
is the subgroup generated by a single transposition. -/
theorem two_subgroup_of_five_normalizer (A : Subgroup S7) (hA : IsPGroup 2 A)
    (hne : A ≠ ⊥) (hfive : 5 ∣ Nat.card (normalizer (A : Set S7))) :
    ∃ t : S7, t.IsSwap ∧ A = zpowers t := by
  have hs : ∀ x ∈ A, x ^ 2 = 1 := by
    intro x hx
    by_contra h
    exact noninvolution_not_five A hA ⟨x,hx,h⟩ hfive
  have hi (x : A) : x⁻¹ = x := by
    apply inv_eq_of_mul_eq_one_left
    apply Subtype.ext
    simpa only [pow_two,Subgroup.coe_mul,Subgroup.coe_one] using hs x x.property
  have he : IsElementaryAbelian 2 A := {
    toIsMulCommutative := ⟨⟨fun x y => by
      calc x*y = (x*y)⁻¹ := (hi _).symm
           _ = y⁻¹*x⁻¹ := mul_inv_rev _ _
           _ = y*x := by rw [hi,hi]⟩⟩
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr
      (fun x => Subtype.ext (hs x x.property)) }
  exact elementary_five_normalizer A he hne hfive

section Original
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    {D : Chapter12.Section02.ChosenModule T L V} (E : Closure.Geometry D)

/-- The literal Thompson image in the original centralizer quotient. -/
@[expose] def thompsonImage : Subgroup (ActionQuotient E) :=
  (elementaryAbelianMaxJ (radical E)).map (projection E)

/-- The entire Thompson image belongs to the actual offender subgroup. -/
theorem thompsonImage_le_offenders : thompsonImage E ≤ offenderGroup E := by
  rw [thompsonImage,map_le_iff_le_comap]
  apply sSup_le
  intro A hA
  apply map_le_iff_le_comap.mp
  by_cases hn : A.map (projection E) = ⊥
  · rw [hn]; exact bot_le
  · exact (NormalElementaryQuotient.maxElementary_isBestOffender (moduleSubgroup E)
      (projection E) (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _)
      (radical E) A (module_le_radical E) hA hn).le_offenderSubgroup (action E)

/-- The seed normalizes the Thompson image through the original radical. -/
theorem seedImage_normalizes_thompsonImage :
    seedImage E ≤ normalizer (thompsonImage E : Set (ActionQuotient E)) := by
  have hn : E.L₁ ≤ normalizer (E.R₁ : Set G) :=
    (le_sup_left.trans (E.L₁ ⊔ (T : Subgroup G)).le_normalizer).trans
      (normalizer_le_normalizer_characteristic_image _ (pCore 2 _))
  have hn' : E.L₁.subgroupOf (localGroup E) ≤ normalizer (radical E : Set (localGroup E)) := by
    apply le_normalizer_iff.mpr
    intro l hl r hr
    exact le_normalizer_iff.mp hn l hl r hr
  exact (map_mono (f := projection E)
    (hn'.trans (normalizer_le_normalizer_elementaryAbelianMaxJ _))).trans (le_normalizer_map _)

/-- The same marked natural coordinates identify J(R1)* with a transposition.
No transposition or elementary-image hypothesis is supplied. -/
theorem transposition_image
    (h : EarlierGeometry E) (hf : V ⊓ centralizer (L : Set G) = ⊥)
    (hne : E.Kz ≠ E.K) (hstar : E.Kz ∈ Chapter1.LStar G (T : Subgroup G))
    [IsQuasisimple (E.Kz ⧸ pCore 2 E.Kz)]
    (hcent : E.V₁ ≤ centralizer (E.R₁ : Set G))
    (hline : E.V₁ = ⁅zpowers E.z, E.X⁆) (hXR : E.X ≤ normalizer (E.R₁ : Set G))
    (hmodel : AlternatingSevenModel E)
    (e : (E.L₁ ⧸ pCore 2 E.L₁) ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 2) E.input.field.Carrier)
    (t : MovedSection (action E) (componentImage E))
    (a : MarkedActionEquiv t.space.toRepresentation (offenderGroup E) (componentImage E)
      (BinaryPermutation.naturalRepresentation (Fin 7)) (alternatingGroup (Fin 7))) :
    ∃ s : Equiv.Perm (Fin 7), s.IsSwap ∧
      ((thompsonImage E).subgroupOf (offenderGroup E)).map a.action.groupEquiv.toMonoidHom = zpowers s := by
  let P := thompsonImage E
  let J := offenderGroup E
  let B := seedImage E
  have hPJ : P ≤ J := thompsonImage_le_offenders E
  have hBJ : B ≤ J := (seedImage_le_componentImage E).trans a.contained
  let P' := (P.subgroupOf J).map a.action.groupEquiv.toMonoidHom
  let B' := (B.subgroupOf J).map a.action.groupEquiv.toMonoidHom
  have hp : IsPGroup 2 P := ((sylow E).isPGroup'.to_le
    ((show elementaryAbelianMaxJ (radical E) ≤ radical E from sSup_le fun _ hA => hA.1).trans
      (show radical E ≤ (sylow E : Subgroup (localGroup E)) from
        fun _ hx => radical_le_sylow E hx))).map (projection E)
  have hp' : IsPGroup 2 P' := (hp.of_equiv (subgroupOfEquivOfLe hPJ).symm).map _
  have hnonzero : P' ≠ ⊥ := by
    intro hz
    have hz' := (map_eq_bot_iff_of_injective _ a.action.groupEquiv.injective).mp hz
    have hzP : P = ⊥ := by
      rw [←map_subgroupOf_eq_of_le hPJ,hz',Subgroup.map_bot]
    exact thompson_movement E h hf hne hstar hcent hline hXR
      ((Subgroup.map_eq_bot_iff _).mp hzP)
  have hnorm : B' ≤ normalizer (P' : Set (Equiv.Perm (Fin 7))) := by
    have hh : B.subgroupOf J ≤ normalizer (P.subgroupOf J : Set J) := by
      apply le_normalizer_iff.mpr
      intro b hb p hp
      exact le_normalizer_iff.mp (seedImage_normalizes_thompsonImage E) b hb p hp
    exact (map_mono (f := a.action.groupEquiv.toMonoidHom) hh).trans (le_normalizer_map _)
  have hfive : 5 ∣ Nat.card B' := by
    rw [card_map_of_injective a.action.groupEquiv.injective,
      Nat.card_congr (subgroupOfEquivOfLe hBJ).toEquiv]
    exact five_dvd_seedImage E hstar hmodel e
  exact two_subgroup_of_five_normalizer P' hp' hnonzero (hfive.trans (card_dvd_of_le hnorm))
end Original

