module
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple
public import CFSG.Quasithin.ChapterB.Section05.Quasisimple.SourceCompletion.FFQuasisimple
public import Theory.GroupTheory.GeneralizedFitting.TwoCoreImageComparison

/-!
# Full B.5.1 on the original point-component action

The original Kz/O2(Kz) maps onto the component image in KzT/C(VK).
The map preserves central quotients, with a representative formula; only
an independently centerless quotient is identified with the whole image.
Theorem A supplies strong quasithinness of this actual semisimple section.
The complete B.5.1 theorem then applies to the original offender subgroup,
retaining every moved-section and extension clause and all covering centers.

This is the classification input to the remaining 11.4.2 sieve. The earlier
geometry and maximality retain their existing source owners, with final
assembly in qt-d-1222-shadow-component-comparison and its parent
qt-d-1222-shadow-components. No final model shortlist is assumed here.
Source: Aschbacher--Smith 11.4.2, printed p.777, using B.4.2 and B.5.1.
-/

set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple.Classification
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    {D : Chapter12.Section02.ChosenModule T L V} (E : Closure.Geometry D)

/-- The literal point-component image in KzT/C(VK). -/
abbrev componentImage := (component E).map (projection E)
/-- The subgroup generated by best offenders of the original VK action. -/
abbrev offenderGroup := offenderSubgroup (action E)
/-- The original conjugation action restricted to its best-offender subgroup. -/
abbrev offenderAction := (action E).comp (offenderGroup E).subtype
/-- The literal component restricted to that same offender subgroup. -/
abbrev offenderComponent := (componentImage E).subgroupOf (offenderGroup E)

/-- The original Kz inclusion followed by the literal action projection. -/
def componentProjection : E.Kz →* componentImage E :=
  ((projection E).subgroupMap (component E)).comp
    (subgroupOfEquivOfLe (show E.Kz ≤ localGroup E from le_sup_left)).symm.toMonoidHom

/-- The component projection has exactly the specified image. -/
theorem componentProjection_surjective : Function.Surjective (componentProjection E) :=
  ((projection E).subgroupMap_surjective _).comp (subgroupOfEquivOfLe _).symm.surjective

/-- Normality places O2(Kz) in O2(KzT), which centralizes its omega-center. -/
theorem componentProjection_kills_core (h : EarlierGeometry E) :
    pCore 2 E.Kz ≤ (componentProjection E).ker := by
  let := component_normal E h
  let e := (subgroupOfEquivOfLe (show E.Kz ≤ localGroup E from le_sup_left)).symm
  have hpc : (pCore 2 (component E)).map (component E).subtype ≤
      pCore 2 (localGroup E) := le_sSup ⟨inferInstance,pCore_isPGroup.map _⟩
  intro k hk
  have hx : e k ∈ pCore 2 (component E) := by
    have hm := mem_map_of_mem e.toMonoidHom hk
    rwa [pCore_map_iso] at hm
  apply Subtype.ext
  apply (QuotientGroup.eq_one_iff _).mpr
  intro w hw
  exact ((mem_omegaOneCenterAmbient_iff _ _).mp hw).2.2 _
    (hpc (mem_map_of_mem _ hx)) |>.symm

/-- The induced projection from the original two-core quotient. -/
def componentQuotientProjection (h : EarlierGeometry E) :
    (E.Kz ⧸ pCore 2 E.Kz) →* componentImage E :=
  QuotientGroup.lift _ (componentProjection E) (componentProjection_kills_core E h)

/-- Passing through the two-core quotient preserves surjectivity. -/
theorem componentQuotientProjection_surjective (h : EarlierGeometry E) :
    Function.Surjective (componentQuotientProjection E h) :=
  QuotientGroup.lift_surjective_of_surjective _ _ (componentProjection_surjective E) _

@[simp] theorem componentQuotientProjection_mk (h : EarlierGeometry E) (k : E.Kz) :
    componentQuotientProjection E h (QuotientGroup.mk' (pCore 2 E.Kz) k) =
      componentProjection E k := rfl

/-- A nontrivial quasisimple image preserves the central quotient; an odd
covering kernel is retained until an independent centerlessness proof is available. -/
def componentCentralQuotientEquiv (h : EarlierGeometry E)
    [IsQuasisimple (E.Kz ⧸ pCore 2 E.Kz)] [Nontrivial (componentImage E)] :
    ((E.Kz ⧸ pCore 2 E.Kz) ⧸ center (E.Kz ⧸ pCore 2 E.Kz)) ≃*
      (componentImage E ⧸ center (componentImage E)) :=
  IsQuasisimple.centralQuotientEquiv (componentQuotientProjection E h)
    (componentQuotientProjection_surjective E h)

@[simp] theorem componentCentralQuotientEquiv_mk (h : EarlierGeometry E)
    [IsQuasisimple (E.Kz ⧸ pCore 2 E.Kz)] [Nontrivial (componentImage E)] (k : E.Kz) :
    componentCentralQuotientEquiv E h
      (QuotientGroup.mk' (center (E.Kz ⧸ pCore 2 E.Kz))
        (QuotientGroup.mk' (pCore 2 E.Kz) k)) =
      QuotientGroup.mk' (center (componentImage E)) (componentProjection E k) := rfl

/-- Normality is in the actual centralizer quotient, not the ambient group. -/
theorem componentImage_normal (h : EarlierGeometry E) : (componentImage E).Normal := by
  let := component_normal E h
  exact Normal.map inferInstance (projection E) (QuotientGroup.mk'_surjective _)

/-- The original Sylow image supplements the actual component. -/
theorem quotient_componentImage_isTwoGroup (h : EarlierGeometry E) :
    let := componentImage_normal E h
    IsPGroup 2 (ActionQuotient E ⧸ componentImage E) := by
  let := componentImage_normal E h
  apply isPGroup_quotient_of_sup_eq_top (componentImage E)
    ((sylow E : Subgroup (localGroup E)).map (projection E)) ((sylow E).isPGroup'.map _)
  change (component E).map (projection E) ⊔ _ = _
  rw [← Subgroup.map_sup, component_sup_sylow,
    map_top_of_surjective (projection E) (QuotientGroup.mk'_surjective _)]

/-- Theorem A transfers strong quasithinness to this semisimple section
of the original point centralizer. The full known-simple hypothesis is inherited. -/
theorem componentImage_sqtk (h : EarlierGeometry E)
    [IsQuasisimple (componentImage E)] :
    IsSQTK KnownSimple.IsKnownSimple (componentImage E) := by
  have hz := E.input.source.simpleQTKE.twoLocal_sqtk
    (point_twoLocal E h.point_mem h.point_fixed h.point_ne_one)
  have hle : localGroup E ≤ Gz E := sup_le h.point_component.1 h.sylow_le_pointCentralizer
  have hlocal : IsSQTK KnownSimple.IsKnownSimple (localGroup E) :=
    (IsSQTK.equiv (subgroupOfEquivOfLe hle)).mp
      (hz.subgroup ((localGroup E).subgroupOf (Gz E)))
  have hsem : ChapterA.Section02.IsSemisimple (componentImage E) := by
    apply top_unique
    exact le_sSup (show IsComponent (componentImage E) ⊤ from
      ⟨Subgroup.IsSubnormal.top,IsQuasisimple.of_mulEquiv topEquiv.symm⟩)
  let q := (projection E).subgroupMap (component E)
  have hsection := ChapterA.Section02.IsSectionOf.of_surjective q
    ((projection E).subgroupMap_surjective (component E))
  have hc := hlocal.subgroup (component E)
  exact ⟨(ChapterA.Section02.theoremA_knownSimple (G := component E)).stronglyQuasithin_section
    hc.stronglyQuasithin hc.isKGroup hsection hsem,
    hc.isKGroup.of_surjective q ((projection E).subgroupMap_surjective _)⟩

/-- All six B.5.1 clauses on the actual offender restriction, without
assuming any model, irreducibility, splitting, or source classifier. -/
theorem source_classification
    (h : EarlierGeometry E) (hf : V ⊓ centralizer (L : Set G) = ⊥)
    (hne : E.Kz ≠ E.K) (hstar : E.Kz ∈ Chapter1.LStar G (T : Subgroup G))
    [IsQuasisimple (E.Kz ⧸ pCore 2 E.Kz)]
    (hcent : E.V₁ ≤ centralizer (E.R₁ : Set G)) (hff : IsFFModule (action E)) :
    componentImage E ≤ offenderGroup E ∧
    Nonempty (ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
      (offenderAction E) (offenderComponent E)) := by
  let := componentImage_normal E h
  let : IsQuasisimple (componentImage E) := (action_structure E h hf hne hstar hcent).2.2
  exact ChapterB.QuasisimpleSource.SourceCompletion.ff_quasisimple_source_conclusion
    (action E) (componentImage E) (quotient_componentImage_isTwoGroup E h)
    (module_reduced E h hf hne hstar hcent).quotient_pCore_eq_bot
    (componentImage_sqtk E h) (action_faithful E) hff


/-- A centerless original quotient is detected by the literal action. -/
def componentQuotientImageEquiv (h : EarlierGeometry E)
    [IsQuasisimple (E.Kz ⧸ pCore 2 E.Kz)] [Nontrivial (componentImage E)]
    (hz : center (E.Kz ⧸ pCore 2 E.Kz) = ⊥) :
    (E.Kz ⧸ pCore 2 E.Kz) ≃* componentImage E := by
  let q := componentQuotientProjection E h
  have hk : q.ker ≤ center (E.Kz ⧸ pCore 2 E.Kz) := by
    rw [← IsQuasisimple.comap_center_of_surjective q (componentQuotientProjection_surjective E h)]
    intro x hx
    change q x ∈ center (componentImage E)
    rw [show q x = 1 from hx]
    exact one_mem _
  exact MulEquiv.ofBijective q
    ⟨(MonoidHom.ker_eq_bot_iff q).mp (bot_unique (hk.trans hz.le)),
      componentQuotientProjection_surjective E h⟩

@[simp] theorem componentQuotientImageEquiv_mk (h : EarlierGeometry E)
    [IsQuasisimple (E.Kz ⧸ pCore 2 E.Kz)] [Nontrivial (componentImage E)]
    (hz : center (E.Kz ⧸ pCore 2 E.Kz) = ⊥) (k : E.Kz) :
    componentQuotientImageEquiv E h hz (QuotientGroup.mk' (pCore 2 E.Kz) k) =
      componentProjection E k := rfl


end CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple.Classification
