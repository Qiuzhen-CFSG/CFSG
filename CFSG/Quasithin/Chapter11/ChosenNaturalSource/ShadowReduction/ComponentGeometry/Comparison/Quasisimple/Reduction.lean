module
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.CartanEndpoints
public import CFSG.Quasithin.ChapterB.QuasisimpleThompsonAction
public import CFSG.Quasithin.ChapterB.Section02.OffenderFactorization.ResidualStructure
public import Theory.GroupTheory.ReducedNormal.ComponentSeed
public import CFSG.Quasithin.Chapter1.Section02.Uniqueness.SourceKnownSimple
public import Theory.GroupTheory.TwoLocalCharacteristicControl

/-!
# The omega-core module and Thompson reduction of 11.4.2

All subgroups live on the literal KzT carrier or are mapped back to G by its
subtype. Characteristic two places V1 in the omega-center of O2(KzT).
Strict comparison forces nontrivial component action, so the quasisimple
normal-kernel theorem proves reducedness. The internal-module theorem then
identifies the Sylow centralizer with the two-core and the component image
with the generalized Fitting subgroup of the actual action quotient.

Thompson heredity and the proved known-simple 1.2.7 uniqueness theorem close
the J(R1) <= O2(KzT) branch. In the remaining branch, B.2.10 supplies a
faithful FF action and a stable relative offender family. Component dichotomy
proves the full commutator identity; its image is also the generalized
Fitting image of the group generated by those offenders.

The only geometric inputs beyond EarlierGeometry are the earlier line
centralization, line-commutator identity and Cartan normalization of R1.
Maximality belongs to the separate overcomponent branch. No terminal model
exclusion is assumed or proved in this module.
Source: Aschbacher--Smith, combined manuscript, 1 March 2004,
11.4.2, printed pp.776--777, with B.2.10 and 1.2.7(3).
-/

set_option backward.isDefEq.respectTransparency false
@[expose] public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    {D : Chapter12.Section02.ChosenModule T L V} (E : Closure.Geometry D)

/-- The actual product KzT, represented by its subgroup join. -/
def localGroup : Subgroup G := E.Kz ⊔ (T : Subgroup G)
/-- The ambient image of the two-core of KzT. -/
def core : Subgroup G := (localGroup E).pCoreIn 2
/-- The intrinsic omega-center of the two-core of KzT. -/
def moduleSubgroup : Subgroup (localGroup E) := omegaOneCenterAmbient (pCore 2 (localGroup E))
/-- The source VK in the original ambient group. -/
def VK : Subgroup G := (moduleSubgroup E).map (localGroup E).subtype
/-- The original point component restricted to KzT. -/
def component : Subgroup (localGroup E) := E.Kz.subgroupOf (localGroup E)
/-- The original R1 restricted to KzT. -/
def radical : Subgroup (localGroup E) := E.R₁.subgroupOf (localGroup E)
/-- The original Sylow subgroup restricted to KzT. -/
def sylow : Sylow 2 (localGroup E) := T.subtype le_sup_right

/-- The ambient module is exactly the source omega-center. -/
theorem VK_eq_omegaCenter : VK E = omegaOneCenterAmbient (core E) :=
  (omegaOneCenterAmbient_map_injective (localGroup E).subtype
    (localGroup E).subtype_injective _).symm

instance module_normal : (moduleSubgroup E).Normal := by
  let Q := pCore 2 (localGroup E)
  let ZQ : Subgroup Q := center Q
  let W : Subgroup ZQ := omega₁ (G := ZQ) (p := 2)
  let U : Subgroup Q := W.map ZQ.subtype
  let _ : ZQ.Characteristic := centerCharacteristic
  let _ : W.Characteristic := omega₁_characteristic ZQ
  let _ : U.Characteristic := characteristic_of_characteristic_of_characteristic
  exact ConjAct.normal_of_characteristic_of_normal

instance module_elementary : IsElementaryAbelian 2 (moduleSubgroup E) :=
  omegaOneCenterAmbient_elementaryAbelian _

/-- The normal two-core lies in the original Sylow subgroup. -/
theorem core_le_sylow : core E ≤ (T : Subgroup G) := by
  change (localGroup E).pCoreIn 2 ≤ (T : Subgroup G)
  simpa only [sylow, Sylow.coe_subtype, map_subgroupOf_eq_of_le
    (show (T : Subgroup G) ≤ localGroup E from le_sup_right)] using
    pCoreIn_le_sylow (localGroup E) (sylow E)

/-- The original point radical lies in the original Sylow subgroup. -/
theorem radical_le_sylow : E.R₁ ≤ (T : Subgroup G) := by
  change (E.L₁ ⊔ (T : Subgroup G)).pCoreIn 2 ≤ (T : Subgroup G)
  simpa only [Sylow.coe_subtype, map_subgroupOf_eq_of_le
    (show (T : Subgroup G) ≤ E.L₁ ⊔ (T : Subgroup G) from le_sup_right)] using
    pCoreIn_le_sylow (E.L₁ ⊔ (T : Subgroup G)) (T.subtype le_sup_right)

/-- Restriction of two-cores gives the A.1.6 containment used on p.776. -/
theorem core_le_radical : core E ≤ E.R₁ :=
  pCoreIn_le_pCoreIn_of_sylow T le_sup_right
    (sup_le_sup_right (le_conjugateSpanBy _ _) _)

/-- Normality is relative to KzT, inherited from the point centralizer. -/
theorem component_normal (h : EarlierGeometry E) : (component E).Normal := by
  apply normal_subgroupOf_of_le_normalizer
  exact (sup_le h.point_component.1 h.sylow_le_pointCentralizer).trans
    (le_normalizer_conjugateSpanBy _ _)

/-- The intrinsic component and Sylow subgroup generate their literal carrier. -/
theorem component_sup_sylow : component E ⊔ (sylow E : Subgroup (localGroup E)) = ⊤ := by
  apply (map_injective (localGroup E).subtype_injective)
  simp only [Subgroup.map_sup, component, sylow, Sylow.coe_subtype,
    map_subgroupOf_eq_of_le (show E.Kz ≤ localGroup E from le_sup_left),
    map_subgroupOf_eq_of_le (show (T : Subgroup G) ≤ localGroup E from le_sup_right),
    ← MonoidHom.range_eq_map, range_subtype]
  rfl

/-- Restricting the carrier preserves the actual two-core quotient. -/
theorem component_quasisimple
    [IsQuasisimple (E.Kz ⧸ pCore 2 E.Kz)] :
    IsQuasisimple (component E ⧸ pCore 2 (component E)) := by
  let e := subgroupOfEquivOfLe (show E.Kz ≤ localGroup E from le_sup_left)
  exact IsQuasisimple.of_mulEquiv
    (QuotientGroup.congr _ _ e (pCore_map_iso 2 e)).symm

/-- The genuine L-star membership gives characteristic two in KzT. -/
theorem local_characteristic (hstar : E.Kz ∈ Chapter1.LStar G (T : Subgroup G)) :
    centralizer (pCore 2 (localGroup E) : Set (localGroup E)) ≤ pCore 2 (localGroup E) :=
  Chapter1.mem_He_iff.mp (Chapter1.lemma_1_1_4_6 T
    (E.input.source.simpleQTKE.evenCharacteristic T) ⟨hstar.1.2.2, fun _ hx => (show (T : Subgroup G) ≤ localGroup E from le_sup_right) hx⟩)

/-- Centralization of R1 and characteristic two put the entire line in VK. -/
theorem line_le_module (hstar : E.Kz ∈ Chapter1.LStar G (T : Subgroup G))
    (hcent : E.V₁ ≤ centralizer (E.R₁ : Set G)) : E.V₁ ≤ VK E := by
  let := D.elementary
  intro v hv
  have hvH : v ∈ localGroup E := (show (T : Subgroup G) ≤ localGroup E from le_sup_right) (D.le_sylow (E.V₁_le hv))
  have hvC : (⟨v,hvH⟩ : localGroup E) ∈
      centralizer (pCore 2 (localGroup E) : Set (localGroup E)) := by
    intro q hq
    exact Subtype.ext (hcent hv q (core_le_radical E (mem_map_of_mem _ hq)))
  have hvQ := local_characteristic E hstar hvC
  refine ⟨⟨v,hvH⟩, (mem_omegaOneCenterAmbient_iff _ _).mpr ⟨hvQ, ?_, ?_⟩, rfl⟩
  · exact Subtype.ext (elemPow_eq_one_of_isElementaryAbelian v (E.V₁_le hv))
  · intro q hq
    exact hvC q hq

/-- The fixed point needed in the A7 argument is chosen in V1: it is fixed
by L1 but moved by Kz. It is not the original point z, which Kz centralizes. -/
theorem exists_seed_fixed_moving_vector (h : EarlierGeometry E)
    (hf : V ⊓ centralizer (L : Set G) = ⊥) (hne : E.Kz ≠ E.K)
    (hstar : E.Kz ∈ Chapter1.LStar G (T : Subgroup G))
    (hcent : E.V₁ ≤ centralizer (E.R₁ : Set G)) :
    ∃ v ∈ E.V₁, v ∈ VK E ∧ v ∈ centralizer (E.L₁ : Set G) ∧
      v ∉ centralizer (E.Kz : Set G) := by
  have hn : ¬ E.V₁ ≤ centralizer (E.Kz : Set G) := fun hc =>
    hne ((h.eq_iff_point_centralizes_line hf).mpr (le_centralizer_iff.mp hc))
  obtain ⟨v,hv,hvK⟩ := SetLike.not_le_iff_exists.mp hn
  exact ⟨v,hv,line_le_module E hstar hcent hv,
    (le_centralizer_iff.mp h.seed_centralizes) hv,hvK⟩

/-- A strict component comparison forces the intrinsic component to move VK. -/
theorem module_moved (h : EarlierGeometry E)
    (hf : V ⊓ centralizer (L : Set G) = ⊥) (hne : E.Kz ≠ E.K)
    (hstar : E.Kz ∈ Chapter1.LStar G (T : Subgroup G))
    (hcent : E.V₁ ≤ centralizer (E.R₁ : Set G)) :
    ⁅moduleSubgroup E, component E⁆ ≠ ⊥ := by
  intro hz
  apply hne
  apply (h.eq_iff_point_centralizes_line hf).mpr
  have hc := le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hz)
  intro k hk v hv
  obtain ⟨w,hw,rfl⟩ := line_le_module E hstar hcent hv
  exact congrArg (localGroup E).subtype
    (hc (show (⟨k,(show E.Kz ≤ localGroup E from le_sup_left) hk⟩ : localGroup E) ∈ component E from hk) w hw)

/-- Quasisimple normal-kernel structure proves reducedness of the actual module. -/
theorem module_reduced (h : EarlierGeometry E)
    (hf : V ⊓ centralizer (L : Set G) = ⊥) (hne : E.Kz ≠ E.K)
    (hstar : E.Kz ∈ Chapter1.LStar G (T : Subgroup G))
    [IsQuasisimple (E.Kz ⧸ pCore 2 E.Kz)]
    (hcent : E.V₁ ≤ centralizer (E.R₁ : Set G)) : IsPReduced 2 (moduleSubgroup E) := by
  let := component_normal E h
  let := component_quasisimple E
  refine ⟨inferInstance, inferInstance, ?_⟩
  apply (QuasisimpleKernel.normal_kernel_structure (component E)
    (sylow E : Subgroup (localGroup E)) (centralizer (moduleSubgroup E : Set (localGroup E)))
    hstar.1.1 (sylow E).isPGroup' (component_sup_sylow E) ?_ ?_).2
  · intro q hq w hw
    exact ((mem_omegaOneCenterAmbient_iff _ _).mp hw).2.2 q hq |>.symm
  · intro hc
    exact module_moved E h hf hne hstar hcent
      (commutator_eq_bot_iff_le_centralizer.mpr (le_centralizer_iff.mp hc))

/-- The literal quotient KzT / C_KzT(VK). -/
abbrev ActionQuotient := ChapterB.InternalThompsonAction.ActionQuotient (moduleSubgroup E)
/-- The literal centralizer quotient map. -/
def projection : localGroup E →* ActionQuotient E := ChapterB.InternalThompsonAction.actionMk _
/-- The faithful binary conjugation representation on the intrinsic VK. -/
def action := ChapterB.InternalThompsonAction.action (moduleSubgroup E)

/-- Relative normality identifies the join with the setwise product. -/
theorem component_product (h : EarlierGeometry E) :
    ∀ g : localGroup E, ∃ k ∈ component E, ∃ t ∈ (sylow E : Subgroup (localGroup E)), k*t=g := by
  let := component_normal E h
  intro g
  exact mem_sup_of_normal_left.mp ((component_sup_sylow E).symm ▸ mem_top g)

/-- The source component image is quasisimple and equals F* of the actual quotient. -/
theorem action_structure (h : EarlierGeometry E)
    (hf : V ⊓ centralizer (L : Set G) = ⊥) (hne : E.Kz ≠ E.K)
    (hstar : E.Kz ∈ Chapter1.LStar G (T : Subgroup G))
    [IsQuasisimple (E.Kz ⧸ pCore 2 E.Kz)]
    (hcent : E.V₁ ≤ centralizer (E.R₁ : Set G)) :
    pCore 2 (localGroup E) = (sylow E : Subgroup (localGroup E)) ⊓
      centralizer (moduleSubgroup E : Set (localGroup E)) ∧
    (component E).map (projection E) = generalizedFitting (ActionQuotient E) ∧
    IsQuasisimple ((component E).map (projection E)) := by
  obtain ⟨hP,hF,hq⟩ := internalModule_quasisimple_structure
    (moduleSubgroup E) (projection E) (QuotientGroup.mk'_surjective _)
    (QuotientGroup.ker_mk' _)
    (module_reduced E h hf hne hstar hcent).quotient_pCore_eq_bot
    (sylow E) (component E) hstar.1.1 (component_quasisimple E)
    (module_moved E h hf hne hstar hcent) (component_product E h)
  exact ⟨(normalSylow_structure_of_coreFree_image (projection E)
    (QuotientGroup.mk'_surjective _) (module_reduced E h hf hne hstar hcent).quotient_pCore_eq_bot
    _ (QuotientGroup.ker_mk' _) (sylow E) hP).1, hF, hq⟩


/-- The ambient source identity O2(KzT) = C_T(VK). -/
theorem core_eq_sylow_centralizer (h : EarlierGeometry E)
    (hf : V ⊓ centralizer (L : Set G) = ⊥) (hne : E.Kz ≠ E.K)
    (hstar : E.Kz ∈ Chapter1.LStar G (T : Subgroup G))
    [IsQuasisimple (E.Kz ⧸ pCore 2 E.Kz)]
    (hcent : E.V₁ ≤ centralizer (E.R₁ : Set G)) :
    core E = (T : Subgroup G) ⊓ centralizer (VK E : Set G) := by
  have he := (action_structure E h hf hne hstar hcent).1
  apply le_antisymm
  · rintro _ ⟨x,hx,rfl⟩
    have hx' := he.le hx
    refine ⟨hx'.1, ?_⟩
    rintro _ ⟨w,hw,rfl⟩
    exact congrArg (localGroup E).subtype (hx'.2 w hw)
  · intro x hx
    refine ⟨⟨x,(show (T : Subgroup G) ≤ localGroup E from le_sup_right) hx.1⟩,
      he.ge ⟨hx.1, ?_⟩, rfl⟩
    intro w hw
    exact Subtype.ext (hx.2 w (mem_map_of_mem _ hw))

/-- Thompson heredity gives the equality in the centralizing branch. -/
theorem thompson_eq_of_le_core
    (hJ : elementaryAbelianMaxJ E.R₁ ≤ core E) :
    elementaryAbelianMaxJ E.R₁ = elementaryAbelianMaxJ (core E) :=
  (elementaryAbelianMaxJ_eq_of_intermediate_finite _ _ hJ (core_le_radical E)).symm

/-- Known-simple maximal-local uniqueness gives the full normalizer control. -/
theorem thompson_normalizer_le (h : EarlierGeometry E)
    (hstar : E.Kz ∈ Chapter1.LStar G (T : Subgroup G))
    (hJ : elementaryAbelianMaxJ E.R₁ ≤ core E) :
    normalizer (elementaryAbelianMaxJ E.R₁ : Set G) ≤ normalizer (E.Kz : Set G) := by
  have hRne : E.R₁ ≠ ⊥ := fun he => hstar.1.2.2
    (bot_unique (he ▸ core_le_radical E))
  have hJne := elementaryAbelianMaxJ_ne_bot_of_finite_pGroup E.R₁
    (isPGroup_pCoreIn _ _) hRne
  have hJT : IsPGroup 2 (elementaryAbelianMaxJ E.R₁) :=
    (isPGroup_pCoreIn 2 (E.L₁ ⊔ (T : Subgroup G))).to_le
      (sSup_le fun _ hA => hA.1)
  have hlocal : IsTwoLocal (normalizer (elementaryAbelianMaxJ E.R₁ : Set G)) :=
    ⟨_, hJne, hJT, rfl⟩
  obtain ⟨N,hJN,hN⟩ := Finite.exists_le_maximal hlocal
  have hHN : localGroup E ≤ normalizer (elementaryAbelianMaxJ E.R₁ : Set G) := by
    rw [thompson_eq_of_le_core E hJ]
    exact ((localGroup E).le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image _ (pCore 2 _))).trans
        (normalizer_le_normalizer_elementaryAbelianMaxJ _)
  have hTK : (T : Subgroup G) ≤ normalizer (E.Kz : Set G) :=
    h.sylow_le_pointCentralizer.trans (le_normalizer_conjugateSpanBy _ _)
  have ho : componentOrbit E.Kz (T : Subgroup G) = E.Kz :=
    le_antisymm (iSup_conjugates_le_of_le_normalizer _ _ _ le_rfl hTK)
      (le_componentOrbit _ _)
  have he := (Chapter1.Section02.nonsolvable_uniqueness_knownSimple
    E.input.source.simpleQTKE T hstar).normalizer_unique N hN (hHN.trans hJN)
  rw [ho] at he
  exact he ▸ hJN

/-- The Thompson-normalizer branch closes by the shared Cartan endpoint. -/
theorem eq_of_thompson_le_core (h : EarlierGeometry E)
    (hf : V ⊓ centralizer (L : Set G) = ⊥)
    (hstar : E.Kz ∈ Chapter1.LStar G (T : Subgroup G))
    (hline : E.V₁ = ⁅zpowers E.z, E.X⁆)
    (hXR : E.X ≤ normalizer (E.R₁ : Set G))
    (hJ : elementaryAbelianMaxJ E.R₁ ≤ core E) : E.Kz = E.K :=
  eq_of_cartan_normalizes_point_component h hf hline
    ((hXR.trans (normalizer_le_normalizer_elementaryAbelianMaxJ _)).trans
      (thompson_normalizer_le E h hstar hJ))

/-- A strict comparison must lie in the moving Thompson branch. -/
theorem thompson_not_le_core (h : EarlierGeometry E)
    (hf : V ⊓ centralizer (L : Set G) = ⊥) (hne : E.Kz ≠ E.K)
    (hstar : E.Kz ∈ Chapter1.LStar G (T : Subgroup G))
    (hline : E.V₁ = ⁅zpowers E.z, E.X⁆)
    (hXR : E.X ≤ normalizer (E.R₁ : Set G)) :
    ¬ elementaryAbelianMaxJ E.R₁ ≤ core E :=
  fun hJ => hne (eq_of_thompson_le_core E h hf hstar hline hXR hJ)

/-- The core-to-radical containment on the literal KzT carrier. -/
theorem intrinsic_core_le_radical : pCore 2 (localGroup E) ≤ radical E := by
  intro x hx
  exact core_le_radical E (mem_map_of_mem _ hx)

/-- VK lies in the same intrinsic R1 used by the relative offender family. -/
theorem module_le_radical : moduleSubgroup E ≤ radical E :=
  (show moduleSubgroup E ≤ pCore 2 (localGroup E) from map_subtype_le _).trans
    (intrinsic_core_le_radical E)

/-- The original J(R1) has nontrivial image through the actual quotient map. -/
theorem thompson_movement (h : EarlierGeometry E)
    (hf : V ⊓ centralizer (L : Set G) = ⊥) (hne : E.Kz ≠ E.K)
    (hstar : E.Kz ∈ Chapter1.LStar G (T : Subgroup G))
    [IsQuasisimple (E.Kz ⧸ pCore 2 E.Kz)]
    (hcent : E.V₁ ≤ centralizer (E.R₁ : Set G))
    (hline : E.V₁ = ⁅zpowers E.z, E.X⁆)
    (hXR : E.X ≤ normalizer (E.R₁ : Set G)) :
    ¬ elementaryAbelianMaxJ (radical E) ≤ (projection E).ker := by
  intro hJ
  apply thompson_not_le_core E h hf hne hstar hline hXR
  have hmap : (elementaryAbelianMaxJ (radical E)).map (localGroup E).subtype =
      elementaryAbelianMaxJ E.R₁ := by
    rw [← elementaryAbelianMaxJ_map_injective (localGroup E).subtype
      (localGroup E).subtype_injective, radical,
      map_subgroupOf_eq_of_le ((radical_le_sylow E).trans
        (show (T : Subgroup G) ≤ localGroup E from le_sup_right))]
  rw [← hmap, core_eq_sylow_centralizer E h hf hne hstar hcent]
  rintro _ ⟨x,hx,rfl⟩
  refine ⟨radical_le_sylow E ((show elementaryAbelianMaxJ (radical E) ≤ radical E from
    sSup_le fun _ hA => hA.1) hx), ?_⟩
  have hc : x ∈ centralizer (moduleSubgroup E : Set (localGroup E)) := by
    simpa only [projection, ChapterB.InternalThompsonAction.actionMk, QuotientGroup.ker_mk']
      using hJ hx
  rintro _ ⟨w,hw,rfl⟩
  exact congrArg (localGroup E).subtype (hc w hw)

open Representation Representation.BinaryOffender

/-- B.2.10 on the literal quotient, including stability and offender generation. -/
theorem ff_action (h : EarlierGeometry E)
    (hf : V ⊓ centralizer (L : Set G) = ⊥) (hne : E.Kz ≠ E.K)
    (hstar : E.Kz ∈ Chapter1.LStar G (T : Subgroup G))
    [IsQuasisimple (E.Kz ⧸ pCore 2 E.Kz)]
    (hcent : E.V₁ ≤ centralizer (E.R₁ : Set G))
    (hline : E.V₁ = ⁅zpowers E.z, E.X⁆)
    (hXR : E.X ≤ normalizer (E.R₁ : Set G)) :
    IsFFModule (action E) ∧
    IsStable (action E) (ChapterB.relativeMaxOffenderImages (radical E)
      (moduleSubgroup E) (projection E)) ∧
    generatedBy (ChapterB.relativeMaxOffenderImages (radical E) (moduleSubgroup E)
      (projection E)) ⊤ ≤ offenderSubgroup (action E) :=
  ChapterB.lemma_B_2_10_relative (moduleSubgroup E) (radical E) (module_le_radical E)
    (projection E) (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _)
    (thompson_movement E h hf hne hstar hcent hline hXR)

/-- The relative offender-generated group has exactly the original component as F* image. -/
theorem relative_offender_fitting (h : EarlierGeometry E)
    (hf : V ⊓ centralizer (L : Set G) = ⊥) (hne : E.Kz ≠ E.K)
    (hstar : E.Kz ∈ Chapter1.LStar G (T : Subgroup G))
    [IsQuasisimple (E.Kz ⧸ pCore 2 E.Kz)]
    (hcent : E.V₁ ≤ centralizer (E.R₁ : Set G))
    (hline : E.V₁ = ⁅zpowers E.z, E.X⁆)
    (hXR : E.X ≤ normalizer (E.R₁ : Set G)) :
    let N := generatedBy (ChapterB.relativeMaxOffenderImages (radical E)
      (moduleSubgroup E) (projection E)) ⊤
    (generalizedFitting N).map N.subtype = (component E).map (projection E) :=
  ChapterB.relativeMaxOffenderImages_fitting_eq (moduleSubgroup E) (radical E)
    (component E) (projection E) (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _)
    (module_reduced E h hf hne hstar hcent).quotient_pCore_eq_bot (sylow E)
    (intrinsic_core_le_radical E) (.inl ⟨hstar.1.1, component_quasisimple E⟩)
    (module_moved E h hf hne hstar hcent) (component_product E h)
    (thompson_movement E h hf hne hstar hcent hline hXR)



/-- The quotient representation has trivial kernel by its centralizer construction. -/
theorem action_faithful : Function.Injective (action E) :=
  NormalElementaryQuotient.representation_injective _ _ _ _

/-- The original Sylow subgroup normalizes the original point radical. -/
theorem sylow_normalizes_radical :
    (sylow E : Subgroup (localGroup E)) ≤ normalizer (radical E : Set (localGroup E)) := by
  have hn : (T : Subgroup G) ≤ normalizer (E.R₁ : Set G) :=
    (le_sup_right.trans (E.L₁ ⊔ (T : Subgroup G)).le_normalizer).trans
      (normalizer_le_normalizer_characteristic_image _ (pCore 2 _))
  apply le_normalizer_iff.mpr
  intro t ht r hr
  exact le_normalizer_iff.mp hn t ht r hr

/-- The actual component is generated by commutators with the image of J(R1). -/
theorem component_commutator_thompson (h : EarlierGeometry E)
    (hf : V ⊓ centralizer (L : Set G) = ⊥) (hne : E.Kz ≠ E.K)
    (hstar : E.Kz ∈ Chapter1.LStar G (T : Subgroup G))
    [IsQuasisimple (E.Kz ⧸ pCore 2 E.Kz)]
    (hcent : E.V₁ ≤ centralizer (E.R₁ : Set G))
    (hline : E.V₁ = ⁅zpowers E.z, E.X⁆)
    (hXR : E.X ≤ normalizer (E.R₁ : Set G)) :
    ⁅(component E).map (projection E),
      (elementaryAbelianMaxJ (radical E)).map (projection E)⁆ =
      (component E).map (projection E) := by
  let q := projection E
  let B := (component E).map q
  let J := elementaryAbelianMaxJ (radical E)
  let A := J.map q
  have hq : Function.Surjective q := QuotientGroup.mk'_surjective _
  let := component_normal E h
  let : B.Normal := (inferInstance : (component E).Normal).map q hq
  let : IsQuasisimple B := (action_structure E h hf hne hstar hcent).2.2
  have hgen : B ⊔ (sylow E : Subgroup (localGroup E)).map q = ⊤ := by
    rw [← Subgroup.map_sup, component_sup_sylow, map_top_of_surjective q hq]
  have hnonzero : ⁅B,A⁆ ≠ ⊥ := by
    intro hz
    have hBC : B ≤ centralizer (A : Set (ActionQuotient E)) :=
      commutator_eq_bot_iff_le_centralizer.mp hz
    have hPJ : (sylow E : Subgroup (localGroup E)) ≤ normalizer (J : Set (localGroup E)) :=
      (sylow_normalizes_radical E).trans (normalizer_le_normalizer_elementaryAbelianMaxJ _)
    have hPA := (map_mono (f := q) hPJ).trans (le_normalizer_map q)
    let : A.Normal := normalizer_eq_top_iff.mp (top_unique (by
      rw [← hgen]
      exact sup_le (hBC.trans (Subgroup.centralizer_le_normalizer _)) hPA))
    have hp : IsPGroup 2 A := ((sylow E).isPGroup'.to_le
      ((show J ≤ radical E from sSup_le fun _ hA => hA.1).trans
        (show radical E ≤ (sylow E : Subgroup (localGroup E)) from
          fun _ hx => radical_le_sylow E hx))).map q
    have hbot : A = ⊥ := bot_unique ((show A ≤ pCore 2 (ActionQuotient E) from
      le_sSup ⟨inferInstance,hp⟩).trans
        (module_reduced E h hf hne hstar hcent).quotient_pCore_eq_bot.le)
    exact thompson_movement E h hf hne hstar hcent hline hXR
      ((Subgroup.map_eq_bot_iff _).mp hbot)
  have hB : IsComponent (ActionQuotient E) B :=
    ⟨(inferInstance : B.Normal).isSubnormal, inferInstance⟩
  rcases hB.commutator_dichotomy A with hb | he
  · exact (hnonzero hb).elim
  · exact le_antisymm (commutator_le_left B A)
      ((le_iSup_conjugates B A).trans he.symm.le)

/-- The quasisimple component lies in the actual full offender-generated subgroup. -/
theorem component_le_offenders (h : EarlierGeometry E)
    (hf : V ⊓ centralizer (L : Set G) = ⊥) (hne : E.Kz ≠ E.K)
    (hstar : E.Kz ∈ Chapter1.LStar G (T : Subgroup G))
    [IsQuasisimple (E.Kz ⧸ pCore 2 E.Kz)]
    (hcent : E.V₁ ≤ centralizer (E.R₁ : Set G))
    (hline : E.V₁ = ⁅zpowers E.z, E.X⁆)
    (hXR : E.X ≤ normalizer (E.R₁ : Set G)) :
    (component E).map (projection E) ≤ offenderSubgroup (action E) := by
  rw [← relative_offender_fitting E h hf hne hstar hcent hline hXR]
  exact (map_subtype_le _).trans (ff_action E h hf hne hstar hcent hline hXR).2.2


end CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple
