module
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple.Reduction
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison

/-!
# The actual chosen-flag Thompson and FF reduction in 11.4.2

For the original flag and point, the Thompson-normalizer branch gives Kz=K.
In a strict comparison the original omega-core module instead has faithful
FF action on its literal centralizer quotient. The quasisimple actor is its
generalized Fitting subgroup and is generated by its commutators with the
image of J(R1); it is also the generalized Fitting image of the group generated
by the relative offender family. Fixed-space vanishing is discharged by 11.4.1.

The remaining model sieve, Hall argument and alternating-seven contradiction
are not asserted here. The line, Cartan and relative-component hypotheses
are earlier §§11.0--11.2 geometry, and maximality is the separate
proper-overcomponent branch. Source: Aschbacher--Smith, 11.4.2, printed p.777.
-/

set_option backward.isDefEq.respectTransparency false
public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    {D : Chapter12.Section02.ChosenModule T L V}

/-- On the original field flag, the Thompson branch closes the component comparison. -/
theorem ofFlag_eq_of_thompson_le_core
    (S : D.NonbinaryNaturalInput)
    {c : LocalGeometry.Coordinates D S.field} (f : LocalGeometry.InvariantFlag c)
    (X : Subgroup G) (z : G) (H : Subgroup G)
    (h : EarlierGeometry (ofFlag S f X z H))
    (hstar : (ofFlag S f X z H).Kz ∈ Chapter1.LStar G (T : Subgroup G))
    (hlinear : Source.IsSL (L ⧸ pCore 2 L) 3 (2 ^ S.field.degree) →
      V ⊓ centralizer (L : Set G) = ⊥)
    (h1132 : ∀ J, Hypothesis1131At D S (c.binarySubspace (f.space 0)) J →
      Proposition1132At D S (c.binarySubspace (f.space 0)) J)
    (hline : (ofFlag S f X z H).V₁ = ⁅zpowers z, X⁆)
    (hXR : X ≤ normalizer ((ofFlag S f X z H).R₁ : Set G))
    (hJ : elementaryAbelianMaxJ (ofFlag S f X z H).R₁ ≤ core (ofFlag S f X z H)) :
    (ofFlag S f X z H).Kz = (ofFlag S f X z H).K :=
  eq_of_thompson_le_core _ h (fixed_and_transitive D S _ hlinear h1132).1
    hstar hline hXR hJ

/-- The actual original-flag FF action, retaining the component and offender images.
No module, action kernel, Thompson movement or FF witness is supplied by the caller. -/
theorem ofFlag_ff_reduction
    (S : D.NonbinaryNaturalInput)
    {c : LocalGeometry.Coordinates D S.field} (f : LocalGeometry.InvariantFlag c)
    (X : Subgroup G) (z : G) (H : Subgroup G)
    (h : EarlierGeometry (ofFlag S f X z H))
    (hne : (ofFlag S f X z H).Kz ≠ (ofFlag S f X z H).K)
    (hstar : (ofFlag S f X z H).Kz ∈ Chapter1.LStar G (T : Subgroup G))
    [IsQuasisimple ((ofFlag S f X z H).Kz ⧸ pCore 2 (ofFlag S f X z H).Kz)]
    (hlinear : Source.IsSL (L ⧸ pCore 2 L) 3 (2 ^ S.field.degree) →
      V ⊓ centralizer (L : Set G) = ⊥)
    (h1132 : ∀ J, Hypothesis1131At D S (c.binarySubspace (f.space 0)) J →
      Proposition1132At D S (c.binarySubspace (f.space 0)) J)
    (hcent : (ofFlag S f X z H).V₁ ≤ centralizer ((ofFlag S f X z H).R₁ : Set G))
    (hline : (ofFlag S f X z H).V₁ = ⁅zpowers z, X⁆)
    (hXR : X ≤ normalizer ((ofFlag S f X z H).R₁ : Set G)) :
    let E := ofFlag S f X z H
    let Kstar := (component E).map (projection E)
    let N := generatedBy (ChapterB.relativeMaxOffenderImages (radical E)
      (moduleSubgroup E) (projection E)) ⊤
    E.V₁ ≤ VK E ∧
    (∃ v ∈ E.V₁, v ∈ VK E ∧ v ∈ centralizer (E.L₁ : Set G) ∧
      v ∉ centralizer (E.Kz : Set G)) ∧
    IsPReduced 2 (moduleSubgroup E) ∧
    core E = (T : Subgroup G) ⊓ centralizer (VK E : Set G) ∧
    Function.Injective (action E) ∧ IsFFModule (action E) ∧
    IsQuasisimple Kstar ∧ Kstar = generalizedFitting (ActionQuotient E) ∧
    ⁅Kstar, (elementaryAbelianMaxJ (radical E)).map (projection E)⁆ = Kstar ∧
    (generalizedFitting N).map N.subtype = Kstar ∧
    Kstar ≤ offenderSubgroup (action E) := by
  have hf := (fixed_and_transitive D S _ hlinear h1132).1
  exact ⟨line_le_module _ hstar hcent,
    exists_seed_fixed_moving_vector _ h hf hne hstar hcent,
    module_reduced _ h hf hne hstar hcent,
    core_eq_sylow_centralizer _ h hf hne hstar hcent, action_faithful _,
    (ff_action _ h hf hne hstar hcent hline hXR).1,
    (action_structure _ h hf hne hstar hcent).2.2,
    (action_structure _ h hf hne hstar hcent).2.1,
    component_commutator_thompson _ h hf hne hstar hcent hline hXR,
    relative_offender_fitting _ h hf hne hstar hcent hline hXR,
    component_le_offenders _ h hf hne hstar hcent hline hXR⟩

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.ShadowReduction.ComponentGeometry.Comparison.Quasisimple
