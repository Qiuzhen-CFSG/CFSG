module

public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.Closure.Geometry
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.LocalGeometry

/-!
# The original symplectic flag in the closure argument

The marking identifies the actual chosen quotient action with the natural
rank-two symplectic action. Its invariant field flag is transported through
that same marking; the three equations identify it with Closure.Geometry.
No closure, radical-action or block conclusion is part of these data.

We also name the source's case-dependent W, the opposite-root join I, and
the subgroup Q generated by its two core intersections. Here Geometry.W
always denotes W_H, whereas auxiliaryW denotes the source's temporary W.
Source: Aschbacher--Smith 11.5.7, printed pp.782--784.
-/

@[expose] public noncomputable section
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.Closure.Symplectic
open Subgroup Representation LocalGeometry
open CFSG.Quasithin.ChapterB.QuasisimpleSource
open CFSG.Quasithin.Chapter12.Section02
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    {D : ChosenModule T L V} (E : Geometry D)

/-- Explicit preceding marking and flag hypotheses, on the original quotient. -/
structure MarkedFlag where
  action : ActionEquiv D.centralQuotientAction
    (restrictScalars (k := ZMod 2) (symplecticNatural (k := E.input.field.Carrier) 2))
  flag : InvariantFlag (Coordinates.sp4 action)
  point_eq : E.point = (Coordinates.sp4 action).binarySubspace (flag.space 0)
  plane_eq : E.plane = (Coordinates.sp4 action).binarySubspace (flag.space 1)
  threeSpace_eq : E.threeSpace = (Coordinates.sp4 action).binarySubspace (flag.space 2)

namespace MarkedFlag
variable {E} (m : MarkedFlag E)
include m

theorem point_preimage : E.V₁ = m.flag.Vi 0 := by
  change D.centralQuotientPreimage E.point = _
  rw [m.point_eq]
  rfl

theorem plane_preimage : E.V₂ = m.flag.Vi 1 := by
  change D.centralQuotientPreimage E.plane = _
  rw [m.plane_eq]
  rfl

theorem threeSpace_preimage : E.V₃ = m.flag.Vi 2 := by
  change D.centralQuotientPreimage E.threeSpace = _
  rw [m.threeSpace_eq]
  rfl

theorem point_nontrivial : E.V₁ ≠ ⊥ := by
  rw [m.point_preimage]
  exact m.flag.V_ne_bot 0

theorem point_lt_threeSpace : E.V₁ < E.V₃ := by
  rw [m.point_preimage, m.threeSpace_preimage]
  refine lt_of_le_of_ne (m.flag.Vi_mono (by decide : (0 : Fin 3) ≤ 2)) ?_
  intro h
  have hs := (Coordinates.sp4 m.action).preimage_injective h
  have hd := m.flag.dimension 0
  rw [hs, m.flag.dimension 2] at hd
  norm_num at hd

theorem sylow_le_point_normalizer : (T : Subgroup G) ≤ E.G₁ := by
  change (T : Subgroup G) ≤ normalizer (E.V₁ : Set G)
  rw [m.point_preimage]
  exact m.flag.invariant 0

end MarkedFlag

/-- The original action image, realizing the source bar notation on N_G(V).
Using it as the image of all of A requires the explicit inclusion A≤N_G(V). -/
def actionImage (A : Subgroup G) : Subgroup (MulAut V) :=
  (A.subgroupOf (normalizer (V : Set G))).map V.normalizerMonoidHom

/-- W_H is Geometry.W; this is the temporary W used on printed p.783. -/
def auxiliaryW : Subgroup G := by
  classical
  exact if ⁅V, E.U⁆ = ⊥ then E.W else E.U

/-- The join with an opposite conjugate, with the repository's conjugation convention. -/
def oppositeJoin (W : Subgroup G) (y : G) : Subgroup G :=
  W ⊔ W.map (MulAut.conj y).toMonoidHom

/-- The literal two core intersections generating Q. -/
def corePair (W : Subgroup G) (y : G) : Subgroup G :=
  (W ⊓ (oppositeJoin W y).pCoreIn 2) ⊔
    (W.map (MulAut.conj y).toMonoidHom ⊓ (oppositeJoin W y).pCoreIn 2)

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.Closure.Symplectic
