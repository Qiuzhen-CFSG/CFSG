module

public import Theory.SpecificGroups.SymplecticFour.OppositeLongRootPair
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.Closure.Symplectic.OppositeCore.Geometry

/-!
# Three opposite pairs in the original marked action

The concrete first-plane SL₂ and its three point-local conjugate pairs are
transported by the same symplectic marking. Representatives in the original
L₁ then generate L modulo the actual two-core of LT. This discharges both
the rank-one-image and three-generation premises of opposite-core transfer.

The Cartan-compatible opposite choice and the independent containment of Q
remain explicit inputs, to be discharged in the opposite-core assembly.
Source: Aschbacher--Smith, 11.5.7, printed p.783.
-/

@[expose] public noncomputable section
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.Closure.Symplectic.OppositeGeometry
open Subgroup Theory.SpecificGroups.SymplecticFour
open CFSG.Quasithin.Chapter12.Section02
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    {D : ChosenModule T L V} (E : Geometry D)

/-- The literal pair image has its matrix SL₂ identification, without a
separate abstract rank-one recognition hypothesis. -/
def markedPairImageEquiv (m : MarkedFlag E) {y : G}
    (g : Sp E.input.field.Carrier)
    (hpair : actionImage (V := V) (oppositeJoin (auxiliaryW E) y) =
      ((OppositeLongRootPair.pair).map (MulAut.conj g).toMonoidHom).map
        (FullAction.modelHom m)) :
    actionImage (V := V) (oppositeJoin (auxiliaryW E) y) ≃*
      Matrix.SpecialLinearGroup (Fin 2) E.input.field.Carrier :=
  (pairImageEquiv E m _ hpair).trans
    (((OppositeLongRootPair.pair).equivMapOfInjective
      (MulAut.conj g).toMonoidHom (MulAut.conj g).injective).symm.trans
        OppositeLongRootPair.equiv)

/-- The source action image is generated by its first root and any
nonidentity element of the actual opposite root image. -/
theorem marked_pair_root_generation (m : MarkedFlag E) {y : G}
    (g : Sp E.input.field.Carrier)
    (hpair : actionImage (V := V) (oppositeJoin (auxiliaryW E) y) =
      ((OppositeLongRootPair.pair).map (MulAut.conj g).toMonoidHom).map
        (FullAction.modelHom m))
    {w : MulAut V}
    (hw : w ∈ ((RootSubgroup.group 1).map (MulAut.conj g).toMonoidHom).map
      (FullAction.modelHom m)) (hne : w ≠ 1) :
    actionImage (V := V) (oppositeJoin (auxiliaryW E) y) =
      ((RootSubgroup.group 0).map (MulAut.conj g).toMonoidHom).map
        (FullAction.modelHom m) ⊔ zpowers w := by
  obtain ⟨u, hu, rfl⟩ := hw
  obtain ⟨z, hz, rfl⟩ := hu
  have hz1 : z ≠ 1 := by
    intro hz1
    apply hne
    simp [hz1]
  rw [hpair, OppositeLongRootPair.pair_eq_sup_zpowers hz hz1,
    Subgroup.map_sup, Subgroup.map_sup, MonoidHom.map_zpowers, MonoidHom.map_zpowers]

/-- The literal opposite core lies in O₂(LT) by the concrete SL₂ image. -/
theorem marked_pair_core_le_large_core (m : MarkedFlag E)
    (hW : E.W ≤ E.G₁.pCoreIn 2) {y : G} (hy : y ∈ L)
    (g : Sp E.input.field.Carrier)
    (hpair : actionImage (V := V) (oppositeJoin (auxiliaryW E) y) =
      ((OppositeLongRootPair.pair).map (MulAut.conj g).toMonoidHom).map
        (FullAction.modelHom m)) :
    (oppositeJoin (auxiliaryW E) y).pCoreIn 2 ≤
      (L ⊔ (T : Subgroup G)).pCoreIn 2 :=
  opposite_core_le_large_core E m hW hy (markedPairImageEquiv E m g hpair)

/-- The model's three pairs yield actual L₁ conjugators and the precise
source generation inclusion modulo O₂(LT). -/
theorem three_conjugates_of_marked_pair (m : MarkedFlag E)
    (hW : E.W ≤ E.G₁.pCoreIn 2) {y : G} (hy : y ∈ L)
    (g : Sp E.input.field.Carrier)
    (hlocal : PointModel.image m E.L₁ = pointLocal.map (MulAut.conj g).toMonoidHom)
    (hpair : actionImage (V := V) (oppositeJoin (auxiliaryW E) y) =
      ((OppositeLongRootPair.pair).map (MulAut.conj g).toMonoidHom).map
        (FullAction.modelHom m)) :
    ∃ l : Fin 3 → G, (∀ i, l i ∈ E.L₁) ∧
      L ≤ (⨆ i, (oppositeJoin (auxiliaryW E) y).map (MulAut.conj (l i)).toMonoidHom) ⊔
        (L ⊔ (T : Subgroup G)).pCoreIn 2 := by
  have hF : 2 < Nat.card E.input.field.Carrier := by
    rw [E.input.field.card_eq]
    exact lt_of_lt_of_le (by decide : 2 < 2 ^ 2)
      (Nat.pow_le_pow_right (by decide) E.input.nonbinary)
  obtain ⟨k, hk, hgen⟩ := OppositeLongRootPair.exists_three_conjugated_pairs hF g
  exact three_model_pairs_lift E m hW hy _ hpair k (fun i => hlocal ▸ hk i) hgen

/-- Actual application to core transfer: no three-generation or abstract
SL₂-isomorphism callback remains. Selection and the quotient bound remain
with this task's final opposite-core assembly. -/
theorem core_le_point_core_of_marked_pair (m : MarkedFlag E)
    (hW : E.W ≤ E.G₁.pCoreIn 2) {y : G} (hy : y ∈ L)
    (g : Sp E.input.field.Carrier)
    (hlocal : PointModel.image m E.L₁ = pointLocal.map (MulAut.conj g).toMonoidHom)
    (hpair : actionImage (V := V) (oppositeJoin (auxiliaryW E) y) =
      ((OppositeLongRootPair.pair).map (MulAut.conj g).toMonoidHom).map
        (FullAction.modelHom m))
    (hQ : corePair (auxiliaryW E) y ≤ E.G₁.pCoreIn 2) :
    L.pCoreIn 2 ≤ E.G₁.pCoreIn 2 := by
  obtain ⟨l, hl, hgen⟩ := three_conjugates_of_marked_pair E m hW hy g hlocal hpair
  exact core_le_point_core_of_three_opposites E m hy hW
    (marked_pair_core_le_large_core E m hW hy g hpair)
    hQ l hl hgen

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.Closure.Symplectic.OppositeGeometry
