module

public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.Closure.Symplectic.Setup
public import Theory.SpecificGroups.SymplecticFour.CentralCovers.Even
public import Theory.GroupTheory.PerfectCentralCoverTrivialTransport
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.Closure.Symplectic.Core

/-!
# The genuine symplectic multiplier step in 11.5.7

Quotient the original perfect L by [O₂(L),L]. The remaining map to the
original L/O₂(L) is a perfect central cover. The specified natural-action
marking identifies its base with Sp₄(q), whose actual universal kernel is
trivial, including q=4. Injectivity gives O₂(L)=[O₂(L),L].

Applied to the existing short-block argument, this also identifies O₂(L)
with the chosen V without the incorrect printed H¹ vanishing assertion.
The opposite-pair placement in O₂(G₁) is a separate obligation.
Source: Aschbacher--Smith, 11.5.7, printed p.783, and I.1.3.
-/

public noncomputable section

open Subgroup PerfectCentralCovering
open scoped commutatorElement

private theorem normal_eq_commutator_of_model
    {A B : Type*} [Group A] [Group B] [Group.IsPerfect A]
    (N : Subgroup A) [N.Normal] (e : A ⧸ N ≃* B)
    (hk : (universalProjection B).ker = ⊥) : N = ⁅N, ⊤⁆ := by
  let C : Subgroup A := ⁅N, ⊤⁆
  have hCN : C ≤ N := commutator_le_left _ _
  let π : A ⧸ C →* A ⧸ N := QuotientGroup.lift C (QuotientGroup.mk' N)
    (by simpa only [QuotientGroup.ker_mk'] using hCN)
  have hπ : Function.Surjective π := QuotientGroup.lift_surjective_of_surjective
    C _ (QuotientGroup.mk'_surjective N) _
  have hcentral : π.ker ≤ center (A ⧸ C) := by
    intro x hx
    obtain ⟨a, rfl⟩ := QuotientGroup.mk'_surjective C x
    have ha : a ∈ N := (QuotientGroup.eq_one_iff a).mp hx
    apply mem_center_iff.mpr
    intro b
    obtain ⟨b, rfl⟩ := QuotientGroup.mk'_surjective C b
    apply (commutatorElement_eq_one_iff_mul_comm.mp ?_).symm
    rw [← map_commutatorElement]
    exact (QuotientGroup.eq_one_iff _).mpr
      (commutator_mem_commutator ha (mem_top b))
  let f : Cover (A ⧸ C) (A ⧸ N) :=
    { toMonoidHom := π
      surjective := hπ
      isPerfect := inferInstance
      ker_le_center := hcentral }
  have hinj := f.injective_of_model_kernel e hk
  apply le_antisymm ?_ hCN
  intro a ha
  apply (QuotientGroup.eq_one_iff a).mp
  apply hinj
  exact (QuotientGroup.eq_one_iff a).mpr ha

namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.Closure.Symplectic
open CFSG.Quasithin.Chapter12.Section02
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    {D : ChosenModule T L V} (E : Geometry D)

/-- The original core is generated by its L-commutators, also at q=4. -/
theorem core_eq_commutator (m : MarkedFlag E) :
    L.pCoreIn 2 = ⁅L.pCoreIn 2, L⁆ := by
  let : Group.IsPerfect L := Chapter1.mem_L_isPerfect E.input.source.maximal_faithful.1.1
  have h := normal_eq_commutator_of_model (pCore 2 L) m.action.groupEquiv
    (Theory.SpecificGroups.SymplecticFour.CentralCovers.Even.universalProjection_ker_eq_bot_of_card_pow
      E.input.field.card_eq E.input.nonbinary)
  have he := congrArg (Subgroup.map L.subtype) h
  simpa only [map_commutator, ← MonoidHom.range_eq_map, range_subtype, pCoreIn] using he

/-- The actual chosen-module consumer: the separate characteristic-block
branch need only supply its Sp₄(4)-block, without a core-commutator premise. -/
theorem core_eq_chosen_of_marked_sp4_block (m : MarkedFlag E)
    (hb : CFSG.Quasithin.ChapterC.IsSp4FourBlock L) : L.pCoreIn 2 = V :=
  core_eq_chosen_of_sp4_block D hb (core_eq_commutator E m)

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.Closure.Symplectic
