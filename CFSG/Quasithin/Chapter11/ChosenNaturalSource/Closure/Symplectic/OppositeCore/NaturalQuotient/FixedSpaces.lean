module

public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.Closure.Symplectic.OppositeCore.NaturalQuotient.FixedSpaces.Action
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.Closure.Symplectic.OppositeCore.NaturalQuotient.FixedSpaces.Conjugator
public import Theory.Representation.SL2SylowFixedRecognition.Complementary.Roots
/-!
# Complementary root fixed spaces on the literal opposite-core quotient

Conjugation on Q/((W∩Wʸ)V) gives a binary representation of the original I.
Its two factors are exactly the fixed spaces of W and Wʸ. An actual
I-conjugator exchanges these factors, so their complementarity also proves
vanishing of the global fixed space and generation by conjugates of the
first root fixed space. The final theorem applies this construction to the
Cartan-compatible choice, retaining X₁≤I and the three L₁-conjugators.

Descent of this representation through the marked SL₂ image, individual
root-element uniformity, natural coordinates, and the Cartan conjugacy
needed for core transfer remain with the opposite-core assembly.
Source: Aschbacher--Smith, 11.5.7, printed p.783.
-/

open Subgroup Theory.SpecificGroups.SymplecticFour Representation.BinaryOffender
open scoped IsMulCommutative
set_option backward.isDefEq.respectTransparency false
public noncomputable section
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.Closure.Symplectic.NaturalQuotient
open CFSG.Quasithin.Chapter12.Section02
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    {D : ChosenModule T L V} (E : Geometry D)

/-- The representation of the original I on the literal Q/N has complementary
root fixed spaces, no global fixed vectors, and is generated by conjugates
of its first root fixed space. -/
theorem exists_binary_action_with_complementary_root_fixed_spaces
    (m : MarkedFlag E) (hW : E.W ≤ E.G₁.pCoreIn 2)
    (hPhi : (frattini (auxiliaryW E)).map (auxiliaryW E).subtype ≤ E.V₁)
    (g : Sp E.input.field.Carrier)
    (hpoint : m.flag.space 0 = LocalGeometry.Sp4.ModelFlag.movedStage g 1)
    (y : L) (hy : PointModel.quotientMap m y = g * TwoConjugate.opposition * g⁻¹)
    (hi : actionImage (V := V) (oppositeJoin (auxiliaryW E) (y:G)) =
      (OppositeLongRootPair.pair.map (MulAut.conj g).toMonoidHom).map (FullAction.modelHom m))
    (hsplit : V = E.V₃ ⊔ E.V₁.map (MulAut.conj (y:G)).toMonoidHom)
    (hcore : (oppositeJoin (auxiliaryW E) (y:G)).pCoreIn 2 ≤ (L ⊔ (T:Subgroup G)).pCoreIn 2) :
    let I := oppositeJoin (auxiliaryW E) (y:G)
    let Q := corePair (auxiliaryW E) (y:G)
    let N := pairDenominator E (y:G)
    let _ := denominator_normal_in_corePair E m y.property hW hPhi
    let _ := quotient_elementary E m y.property hW hPhi hcore
    ∃ ρ : I →* MulAut (Q ⧸ N.subgroupOf Q),
      (∀ i : I, ∀ q : Q, ∀ hq : (i:G)*(q:G)*(i:G)⁻¹ ∈ Q,
        ρ i (QuotientGroup.mk' (N.subgroupOf Q) q) =
          QuotientGroup.mk' (N.subgroupOf Q) ⟨(i:G)*(q:G)*(i:G)⁻¹,hq⟩) ∧
      let σ := Representation.elementaryRepresentation (p := 2) ρ
      IsCompl (fixedSpace σ ((auxiliaryW E).subgroupOf I))
        (fixedSpace σ (((auxiliaryW E).map (MulAut.conj (y:G)).toMonoidHom).subgroupOf I)) ∧
      fixedSpace σ ⊤ = ⊥ ∧
      (⨆ j : I, (fixedSpace σ ((auxiliaryW E).subgroupOf I)).map (σ j)) = ⊤ := by
  dsimp only
  let _ := denominator_normal_in_corePair E m y.property hW hPhi
  let _ := quotient_elementary E m y.property hW hPhi hcore
  obtain ⟨ρ,hρ⟩ := exists_induced_action E m y.property hW hPhi hcore
  obtain ⟨j,hj,hjW⟩ := exists_inner_opposite_conjugator E m hW g hpoint y hy hi
  let W := auxiliaryW E
  let Z := W.map (MulAut.conj (y:G)).toMonoidHom
  let I := oppositeJoin W (y:G)
  let Q := corePair W (y:G)
  let N := pairDenominator E (y:G)
  let π := QuotientGroup.mk' (N.subgroupOf Q)
  let A := (((W ⊔ V) ⊓ Q).subgroupOf Q).map π
  let B := (((Z ⊔ V) ⊓ Q).subgroupOf Q).map π
  let σ := Representation.elementaryRepresentation (p := 2) ρ
  let φ : Subgroup (Q ⧸ N.subgroupOf Q) ≃o Submodule (ZMod 2) (Additive (Q ⧸ N.subgroupOf Q)) :=
    Subgroup.toAddSubgroup.trans (AddSubgroup.toZModSubmodule (n := 2))
  have hf := quotient_fixed_factors_of_inner_conjugator E m y.property hW hPhi hsplit hcore
    ⟨j,hj⟩ hjW ρ hρ
  have hA : fixedSpace σ (W.subgroupOf I) = φ A := by
    ext v
    constructor
    · intro hv
      apply (hf.2.1 v.toMul).mp
      intro u hu
      exact congrArg Additive.toMul (hv ⟨u,hu⟩)
    · intro hv u
      exact congrArg Additive.ofMul ((hf.2.1 v.toMul).mpr hv u u.property)
  have hB : fixedSpace σ (Z.subgroupOf I) = φ B := by
    ext v
    constructor
    · intro hv
      apply (hf.2.2 v.toMul).mp
      intro u hu
      exact congrArg Additive.toMul (hv ⟨u,hu⟩)
    · intro hv u
      exact congrArg Additive.ofMul ((hf.2.2 v.toMul).mpr hv u u.property)
  have hab : IsCompl (fixedSpace σ (W.subgroupOf I)) (fixedSpace σ (Z.subgroupOf I)) := by
    rw [hA,hB]
    exact φ.isCompl_iff.mp (quotient_factors_complementary E m y.property hW hPhi hsplit)
  refine ⟨ρ,hρ,hab,?_,?_⟩
  · apply bot_unique
    intro v hv
    change v = 0
    exact congrArg Additive.ofMul (hf.1 v.toMul (fun u => congrArg Additive.toMul (hv ⟨u,mem_top u⟩)))
  · have hconj : (W.subgroupOf I).map (MulAut.conj (⟨j,hj⟩ : I)).toMonoidHom = Z.subgroupOf I := by
      apply map_injective I.subtype_injective
      rw [map_map]
      have he : I.subtype.comp (MulAut.conj (⟨j,hj⟩ : I)).toMonoidHom =
          (MulAut.conj j).toMonoidHom.comp I.subtype := rfl
      rw [he,← map_map,map_subgroupOf_eq_of_le (show W ≤ I from le_sup_left),
        map_subgroupOf_eq_of_le (show Z ≤ I from le_sup_right)]
      exact hjW
    apply top_unique
    rw [← hab.sup_eq_top]
    apply sup_le (le_iSup_maps σ _)
    rw [← hconj,Representation.SL2SylowFixedRecognition.fixedSpace_conjugate]
    exact le_iSup (fun u : I => (fixedSpace σ (W.subgroupOf I)).map (σ u)) ⟨j,hj⟩

/-- Apply the fixed-space construction to the Cartan-compatible choice itself.
All quotient and fixed-space conclusions use this same selected y; the three
original L₁-conjugators are retained for the final core transfer. -/
theorem exists_cartan_opposite_binary_fixed_spaces
    (m : MarkedFlag E) (hX : LocalGeometry.IsCartan T L E.X)
    (hW : E.W ≤ E.G₁.pCoreIn 2)
    (hroot : actionImage (V := V) (auxiliaryW E) =
      (center (actionImage (V := V) E.L₁)).map (actionImage (V := V) E.L₁).subtype)
    (hPhi : (frattini (auxiliaryW E)).map (auxiliaryW E).subtype ≤ E.V₁) :
    ∃ (g : Sp E.input.field.Carrier) (y : L)
      (hcore : (oppositeJoin (auxiliaryW E) (y:G)).pCoreIn 2 ≤ (L ⊔ (T:Subgroup G)).pCoreIn 2),
      (∀ k : Fin 3, m.flag.space k = LocalGeometry.Sp4.ModelFlag.movedStage g k.succ) ∧
      PointModel.quotientMap m y = g * TwoConjugate.opposition * g⁻¹ ∧
      actionImage (V := V) (oppositeJoin (auxiliaryW E) (y:G)) =
        (OppositeLongRootPair.pair.map (MulAut.conj g).toMonoidHom).map (FullAction.modelHom m) ∧
      cartanKernel E ≤ oppositeJoin (auxiliaryW E) (y:G) ∧
      E.X ≤ normalizer (E.V₁.map (MulAut.conj (y:G)).toMonoidHom : Set G) ∧
      V = E.V₃ ⊔ E.V₁.map (MulAut.conj (y:G)).toMonoidHom ∧
      (∃ l : Fin 3 → G, (∀ k, l k ∈ E.L₁) ∧
        L ≤ (⨆ k, (oppositeJoin (auxiliaryW E) (y:G)).map
          (MulAut.conj (l k)).toMonoidHom) ⊔ (L ⊔ (T:Subgroup G)).pCoreIn 2) ∧
      let I := oppositeJoin (auxiliaryW E) (y:G)
      let Q := corePair (auxiliaryW E) (y:G)
      let N := pairDenominator E (y:G)
      let _ := denominator_normal_in_corePair E m y.property hW hPhi
      let _ := quotient_elementary E m y.property hW hPhi hcore
      ∃ ρ : I →* MulAut (Q ⧸ N.subgroupOf Q),
        (∀ i : I, ∀ q : Q, ∀ hq : (i:G)*(q:G)*(i:G)⁻¹ ∈ Q,
          ρ i (QuotientGroup.mk' (N.subgroupOf Q) q) =
            QuotientGroup.mk' (N.subgroupOf Q) ⟨(i:G)*(q:G)*(i:G)⁻¹,hq⟩) ∧
        let σ := Representation.elementaryRepresentation (p := 2) ρ
        IsCompl (fixedSpace σ ((auxiliaryW E).subgroupOf I))
          (fixedSpace σ (((auxiliaryW E).map (MulAut.conj (y:G)).toMonoidHom).subgroupOf I)) ∧
        fixedSpace σ ⊤ = ⊥ ∧
        (⨆ j : I, (fixedSpace σ ((auxiliaryW E).subgroupOf I)).map (σ j)) = ⊤ := by
  obtain ⟨g,y,hflag,_hlocal,hy,hi,hXI,hXp,_hXQ,_hs,hjoin,_hmeet,hcore,_hN,hgen⟩ :=
    OppositeGeometry.exists_cartan_opposite_with_kernel E m hX hW hroot hPhi
  exact ⟨g,y,hcore,hflag,hy,hi,hXI,hXp,hjoin.symm,hgen,
    exists_binary_action_with_complementary_root_fixed_spaces E m hW hPhi g (hflag 0)
      y hy hi hjoin.symm hcore⟩

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.Closure.Symplectic.NaturalQuotient
