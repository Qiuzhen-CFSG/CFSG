module

public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.Closure.Symplectic.Setup
public import Theory.GroupTheory.Commutator.RelativeGeneration
public import Theory.GroupTheory.AbelianConjugateSpan
public import Theory.GroupTheory.ConjugateSpanCentralizer
public import Theory.Frattini.PGroup

/-!
# Core transfer and the opposite-pair construction

The initial core transfer uses the actual normal subgroup KY of G₁ and
its supplement M₁. A two-subgroup fixed modulo O₂(KY) lies in O₂(G₁)
when its supplement normalizes it. This is the group-theoretic step after
11.5.6(4--5); the Cartan commutator bound remains explicit.

For I generated by W and Wʸ, if O₂(I) normalizes both generators, their
intersections with O₂(I) generate a relatively normal subgroup Q containing
[O₂(I),I]. We retain precisely these intersections and quotient conventions.
The elementary nature of an abelian U also records the corrected Frattini
bound in the W=U branch: Φ(U)=1, not the printed Φ(U)=V₁.
Source: Aschbacher--Smith 11.5.7, printed pp.782--783.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped commutatorElement IsMulCommutative

private theorem normalizes_join {G : Type*} [Group G] (A B C : Subgroup G)
    (hAC : A ≤ normalizer (C : Set G)) (hAB : ⁅A,B⁆ ≤ C) :
    A ≤ normalizer ((B ⊔ C : Subgroup G) : Set G) := by
  apply le_normalizer_iff.mpr
  intro a ha x hx
  have h : B ⊔ C ≤ (B ⊔ C).comap (MulAut.conj a).toMonoidHom := by
    apply sup_le
    · intro b hb
      have hh := (B ⊔ C).mul_mem
        (mem_sup_right (hAB (commutator_mem_commutator ha hb))) (mem_sup_left hb)
      change a * b * a⁻¹ ∈ B ⊔ C
      simpa only [commutatorElement_def, mul_assoc, inv_mul_cancel, mul_one] using hh
    · intro c hc
      exact mem_sup_right (le_normalizer_iff.mp hAC a ha c hc)
  exact h hx

private theorem pair_normal {G : Type*} [Group G] (W Z R : Subgroup G)
    (hR : W ⊔ Z ≤ normalizer (R : Set G))
    (hW : R ≤ normalizer (W : Set G)) (hZ : R ≤ normalizer (Z : Set G)) :
    W ⊔ Z ≤ normalizer (((W ⊓ R) ⊔ (Z ⊓ R) : Subgroup G) : Set G) ∧
      ⁅R, W ⊔ Z⁆ ≤ (W ⊓ R) ⊔ (Z ⊓ R) := by
  have hwR : W ≤ normalizer (R : Set G) := le_sup_left.trans hR
  have hzR : Z ≤ normalizer (R : Set G) := le_sup_right.trans hR
  have hw : ⁅W,R⁆ ≤ W ⊓ R := le_inf
    (le_normalizer_iff_commutator_le_left.mp hW)
    (le_normalizer_iff_commutator_le_right.mp hwR)
  have hz : ⁅Z,R⁆ ≤ Z ⊓ R := le_inf
    (le_normalizer_iff_commutator_le_left.mp hZ)
    (le_normalizer_iff_commutator_le_right.mp hzR)
  have hn : W ⊔ Z ≤ normalizer (((W ⊓ R) ⊔ (Z ⊓ R) : Subgroup G) : Set G) := by
    apply sup_le
    · rw [sup_comm (W ⊓ R)]
      apply normalizes_join W (Z ⊓ R) (W ⊓ R)
      · exact (le_inf W.le_normalizer hwR).trans inf_normalizer_le_normalizer_inf
      · exact (commutator_mono le_rfl inf_le_right).trans hw
    · apply normalizes_join Z (W ⊓ R) (Z ⊓ R)
      · exact (le_inf Z.le_normalizer hzR).trans inf_normalizer_le_normalizer_inf
      · exact (commutator_mono le_rfl inf_le_right).trans hz
  refine ⟨hn, ?_⟩
  rw [commutator_comm]
  exact commutator_sup_le_of_relative_normal (W ⊔ Z) W Z R _ hn
    le_sup_left le_sup_right (hw.trans le_sup_left) (hz.trans le_sup_right)

private theorem core_transport {G : Type*} [Group G]
    (P N H M : Subgroup G) (hp : IsPGroup 2 P)
    (hPH : P ≤ H) (hNH : N ≤ H) (hMH : M ≤ H)
    (hHN : H ≤ normalizer (N : Set G)) (hMP : M ≤ normalizer (P : Set G))
    (hgen : H ≤ N ⊔ M) (hc : ⁅P,N⁆ ≤ N.pCoreIn 2) :
    P ≤ H.pCoreIn 2 := by
  let C := N.pCoreIn 2
  have hHC : H ≤ normalizer (C : Set G) :=
    hHN.trans (normalizer_le_normalizer_characteristic_image N (pCore 2 N))
  have hNC : N ≤ normalizer (C : Set G) := hNH.trans hHC
  have hNQ : N ≤ normalizer ((P ⊔ C : Subgroup G) : Set G) :=
    normalizes_join N P C hNC (by rw [commutator_comm]; exact hc)
  have hMQ : M ≤ normalizer ((P ⊔ C : Subgroup G) : Set G) :=
    (le_inf hMP (hMH.trans hHC)).trans (normalizer_inf_normalizer_le_normalizer_sup P C)
  have hQp : IsPGroup 2 (P ⊔ C : Subgroup G) := by
    rw [sup_comm]
    exact (isPGroup_pCoreIn 2 N).to_sup_of_normal_left' hp (hPH.trans hHC)
  exact le_sup_left.trans (le_pCoreIn_of_normalizes hQp
    (sup_le hPH ((pCoreIn_le 2 N).trans hNH)) (hgen.trans (sup_le hNQ hMQ)))

namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.Closure.Symplectic
open CFSG.Quasithin.Chapter12.Section02
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    {D : ChosenModule T L V} (E : Geometry D)

/-- The actual KY is normalized by G₁, without ambient normality of K or Y. -/
theorem normalizes_KY : E.G₁ ≤ normalizer ((E.K ⊔ E.Y : Subgroup G) : Set G) := by
  have hY : E.G₁ ≤ normalizer (E.Y : Set G) :=
    (le_inf (normalizer_le_normalizer_centralizer E.V₁)
      (E.G₁_normalizes_K.trans
        (normalizer_normalizes_coreQuotientCentralizer E.K))).trans
      inf_normalizer_le_normalizer_inf
  exact (le_inf E.G₁_normalizes_K hY).trans
    (normalizer_inf_normalizer_le_normalizer_sup E.K E.Y)

/-- The TI conclusion of 11.0.3(3--4) makes the actual M₁ normalize V,
because both conjugates contain the original nontrivial point preimage. -/
theorem M₁_normalizes_seed_of_TI (m : MarkedFlag E)
    (hti : ∀ g ∈ E.M,
      V ⊓ V.map (MulAut.conj g).toMonoidHom = ⊥ ∨
        V.map (MulAut.conj g).toMonoidHom = V) :
    E.M₁ ≤ normalizer (V : Set G) := by
  intro g hg
  rcases hti g hg.1 with hz | he
  · have hpoint : E.V₁ ≤ V.map (MulAut.conj g).toMonoidHom := by
      rw [← mem_normalizer_iff_map_conj_eq.mp hg.2]
      exact map_mono E.V₁_le
    have hb := le_inf E.V₁_le hpoint
    rw [hz] at hb
    exact (m.point_nontrivial (bot_unique hb)).elim
  · exact mem_normalizer_iff_map_conj_eq.mpr he

/-- Apply the initial core transfer to V and then all its G₁-conjugates.
The commutator premise is the actual conclusion required from 11.5.6(4--5). -/
theorem seed_and_closure_le_core_of_cartan
    (hT : (T : Subgroup G) ≤ E.G₁)
    (hM : E.M₁ ≤ normalizer (V : Set G))
    (hgen : E.G₁ ≤ (E.K ⊔ E.Y) ⊔ E.M₁)
    (hc : ⁅V, E.K ⊔ E.Y⁆ ≤ (E.K ⊔ E.Y).pCoreIn 2) :
    V ≤ E.G₁.pCoreIn 2 ∧ E.W ≤ E.G₁.pCoreIn 2 := by
  have hv := core_transport V (E.K ⊔ E.Y) E.G₁ E.M₁
    (@IsElementaryAbelian.isPGroup 2 _ _ D.elementary)
    (D.le_sylow.trans hT) (sup_le E.K_le_G₁ E.Y_le_G₁) inf_le_right
    (normalizes_KY E) hM hgen hc
  exact ⟨hv, conjugateSpanBy_le hv
    (E.G₁.le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image E.G₁ (pCore 2 E.G₁)))⟩

/-- The marked source application supplies T≤G₁ and the TI normalization.
Only the preceding supplement and Cartan commutator conclusions remain. -/
theorem marked_seed_and_closure_le_core (m : MarkedFlag E)
    (hti : ∀ g ∈ E.M,
      V ⊓ V.map (MulAut.conj g).toMonoidHom = ⊥ ∨
        V.map (MulAut.conj g).toMonoidHom = V)
    (hgen : E.G₁ ≤ (E.K ⊔ E.Y) ⊔ E.M₁)
    (hc : ⁅V, E.K ⊔ E.Y⁆ ≤ (E.K ⊔ E.Y).pCoreIn 2) :
    V ≤ E.G₁.pCoreIn 2 ∧ E.W ≤ E.G₁.pCoreIn 2 :=
  seed_and_closure_le_core_of_cartan E m.sylow_le_point_normalizer
    (M₁_normalizes_seed_of_TI E m hti) hgen hc

omit E [Finite G] in
/-- The literal Q lies in O₂(I), is normal in I, and contains [O₂(I),I]. -/
theorem corePair_properties (W : Subgroup G) (y : G)
    (hW : (oppositeJoin W y).pCoreIn 2 ≤ normalizer (W : Set G))
    (hy : (oppositeJoin W y).pCoreIn 2 ≤
      normalizer (W.map (MulAut.conj y).toMonoidHom : Set G)) :
    corePair W y ≤ (oppositeJoin W y).pCoreIn 2 ∧
      ((corePair W y).subgroupOf (oppositeJoin W y)).Normal ∧
      ⁅(oppositeJoin W y).pCoreIn 2, oppositeJoin W y⁆ ≤ corePair W y := by
  have hc : corePair W y ≤ (oppositeJoin W y).pCoreIn 2 := sup_le inf_le_right inf_le_right
  have h := pair_normal W (W.map (MulAut.conj y).toMonoidHom)
    ((oppositeJoin W y).pCoreIn 2)
    ((oppositeJoin W y).le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image _ (pCore 2 (oppositeJoin W y)))) hW hy
  exact ⟨hc, (normal_subgroupOf_iff_le_normalizer
    (hc.trans (pCoreIn_le 2 _))).mpr h.1, h.2⟩

/-- An abelian U has exponent two, since its original generators do. -/
theorem U_elementary (hu : IsMulCommutative E.U) : IsElementaryAbelian 2 E.U := by
  let : IsMulCommutative (conjugateSpanBy E.V₃ E.G₁) := hu
  let : IsElementaryAbelian 2 E.V₃ := D.centralQuotientPreimage_elementary E.threeSpace
  exact conjugateSpanBy_elementary_of_commutative E.V₃ E.G₁

/-- The correct Frattini conclusion for the source branch W=U. -/
theorem U_frattini_eq_bot (hu : IsMulCommutative E.U) :
    (frattini E.U).map E.U.subtype = ⊥ := by
  let := U_elementary E hu
  let : Fact (IsPGroup 2 E.U) := ⟨IsElementaryAbelian.isPGroup 2 E.U⟩
  rw [frattini_eq_bot_of_isElementaryAbelian (p := 2), Subgroup.map_bot]

/-- Relative normality propagates [V,U]=1 to the original full closure. -/
theorem U_centralizes_W (hc : ⁅V, E.U⁆ = ⊥) :
    E.U ≤ centralizer (E.W : Set G) := by
  apply le_centralizer_conjugateSpanBy_of_normalizes E.U V E.G₁
    (le_normalizer_conjugateSpanBy E.V₃ E.G₁)
  exact le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hc)

/-- The final abelianness step once the centralizing branch splits W as UV. -/
theorem W_abelian_of_commuting_split (hu : IsMulCommutative E.U)
    (hc : ⁅V, E.U⁆ = ⊥) (hs : E.W = E.U ⊔ V) : IsMulCommutative E.W := by
  let := hu
  let := D.elementary
  rw [hs]
  apply le_centralizer_iff_isMulCommutative.mp
  apply sup_le
  · exact le_centralizer_iff.mpr (sup_le E.U.le_centralizer
      (commutator_eq_bot_iff_le_centralizer.mp hc))
  · exact le_centralizer_iff.mpr (sup_le
      (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hc)) V.le_centralizer)

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.Closure.Symplectic
