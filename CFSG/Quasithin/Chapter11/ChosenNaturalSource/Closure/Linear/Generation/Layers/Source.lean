module

public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.Closure.Linear.Generation.Layers.Cartan
public import CFSG.Quasithin.Chapter11.ChosenNaturalSource.Closure.Linear.Generation.Layers.Fixed

/-!
# The three original SL₃ layer-generation identities

G.2.5 supplies actual natural and contragredient models for the original
quotients. The solvable residual moves the upper layer and, together with
the opposite pair, the lower layer. The actual odd Cartan fixes zero on both.
Lifting these calculations proves all three generation identities in 11.5.7
and applies them to the original core-containment and collapse consumer.

Only the preceding Chapter 11 core/Cartan conclusions remain in the collapse
application. Its final owner `qt-d-1222-sl3-three-conjugates` supplies the frame
and discharges those earlier conclusions. No recognition, model, fixed-space,
or generation premise remains here.

Source: Aschbacher–Smith, combined manuscript, 1 March 2004, 11.5.7,
printed pp.781–782, using G.2.5, printed pp.335–336.
-/

@[expose] public noncomputable section
namespace CFSG.Quasithin.Chapter11.ChosenNaturalSource.Closure.Linear
open Subgroup Representation
open CFSG.Quasithin.Chapter12.Section02
open ChapterG.Section02.LinearThree
open scoped IsMulCommutative

variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  {D : ChosenModule T L V} (E : Geometry D) {x y : G}
  (d : Hypothesis (setup E) E.input.field.Carrier E.input.field.degree x y)
  (hUT : E.W ≤ (T : Subgroup G))
  (hf : (frattini E.W).map E.W.subtype ≤ E.V₁)

include d hUT hf

/-- The original solvable residual and opposite pair generate the whole core. -/
theorem threeCore_eq_of_source_layers :
    threeCore E x y = ⁅threeCore E x y, E.L₁⁆ ⊔ oppositePair E x y := by
  let : ((thirdLayer E x y).subgroupOf (threeCore E x y)).Normal :=
    d.S₃_normal_in_S hUT hf
  let : ((triple E x y).subgroupOf (thirdLayer E x y)).Normal :=
    Recognition.Hypothesis.lower_normal d hUT hf (d.L_le_I hUT hf)
  let : IsElementaryAbelian 2 (threeCore E x y ⧸
      (thirdLayer E x y).subgroupOf (threeCore E x y)) :=
    d.upper_elementary_of_source hUT hf
  let : IsElementaryAbelian 2 (thirdLayer E x y ⧸
      (triple E x y).subgroupOf (thirdLayer E x y)) :=
    Recognition.Hypothesis.lower_elementary d hUT hf (d.L_le_I hUT hf)
  let a := sourceUpperActions E d hUT hf
  obtain ⟨r, s, ⟨upper⟩, ⟨lower⟩⟩ := sourceLayerModels E d hUT hf
  exact a.threeCore_eq_of_homogeneous_layers d hUT hf upper lower

/-- The actual Cartan displacements and the original U-intersection generate S. -/
theorem threeCore_le_of_source_layers (hX : LocalGeometry.IsCartan T L E.X) :
    threeCore E x y ≤ ⁅threeCore E x y, E.X⁆ ⊔ (threeCore E x y ⊓ E.W) := by
  let : ((thirdLayer E x y).subgroupOf (threeCore E x y)).Normal :=
    d.S₃_normal_in_S hUT hf
  let : ((triple E x y).subgroupOf (thirdLayer E x y)).Normal :=
    Recognition.Hypothesis.lower_normal d hUT hf (d.L_le_I hUT hf)
  let : IsElementaryAbelian 2 (threeCore E x y ⧸
      (thirdLayer E x y).subgroupOf (threeCore E x y)) :=
    d.upper_elementary_of_source hUT hf
  let : IsElementaryAbelian 2 (thirdLayer E x y ⧸
      (triple E x y).subgroupOf (thirdLayer E x y)) :=
    Recognition.Hypothesis.lower_elementary d hUT hf (d.L_le_I hUT hf)
  let a := sourceUpperActions E d hUT hf
  obtain ⟨r, s, ⟨upper⟩, ⟨lower⟩⟩ := sourceLayerModels E d hUT hf
  exact a.threeCore_le_of_fixed_calculations d hUT hf hX
    (a.upper_cartan_fixed_eq_zero d hUT hf upper hX)
    (a.lower_cartan_fixed_eq_zero d hUT hf lower hX)

/-- The opposite pair is generated by its Cartan displacements and S₂. -/
theorem oppositePair_le_of_source_layers (hX : LocalGeometry.IsCartan T L E.X)
    (hXG : E.X ≤ E.G₁) (hx : x ∈ normalizer (E.X : Set G))
    (hy : y ∈ normalizer (E.X : Set G)) :
    oppositePair E x y ≤ ⁅oppositePair E x y, E.X⁆ ⊔ triple E x y := by
  let : ((thirdLayer E x y).subgroupOf (threeCore E x y)).Normal :=
    d.S₃_normal_in_S hUT hf
  let : ((triple E x y).subgroupOf (thirdLayer E x y)).Normal :=
    Recognition.Hypothesis.lower_normal d hUT hf (d.L_le_I hUT hf)
  let : IsElementaryAbelian 2 (threeCore E x y ⧸
      (thirdLayer E x y).subgroupOf (threeCore E x y)) :=
    d.upper_elementary_of_source hUT hf
  let : IsElementaryAbelian 2 (thirdLayer E x y ⧸
      (triple E x y).subgroupOf (thirdLayer E x y)) :=
    Recognition.Hypothesis.lower_elementary d hUT hf (d.L_le_I hUT hf)
  let a := sourceUpperActions E d hUT hf
  obtain ⟨r, s, ⟨upper⟩, ⟨lower⟩⟩ := sourceLayerModels E d hUT hf
  exact a.oppositePair_le_of_fixed_calculation d hUT hf hX hXG hx hy
    (a.lower_cartan_fixed_eq_zero d hUT hf lower hX)

/-- All three literal identities used in the SL₃ branch of original 11.5.7. -/
theorem sourceLayerGeneration (hX : LocalGeometry.IsCartan T L E.X)
    (hXG : E.X ≤ E.G₁) (hx : x ∈ normalizer (E.X : Set G))
    (hy : y ∈ normalizer (E.X : Set G)) :
    (threeCore E x y = ⁅threeCore E x y, E.L₁⁆ ⊔ oppositePair E x y) ∧
    (threeCore E x y ≤ ⁅threeCore E x y, E.X⁆ ⊔ (threeCore E x y ⊓ E.W)) ∧
    oppositePair E x y ≤ ⁅oppositePair E x y, E.X⁆ ⊔ triple E x y :=
  ⟨threeCore_eq_of_source_layers E d hUT hf,
    threeCore_le_of_source_layers E d hUT hf hX,
    oppositePair_le_of_source_layers E d hUT hf hX hXG hx hy⟩

/-- The actual collapse application, retaining only preceding core/Cartan inputs. -/
theorem threeCore_collapse_of_source_layers
    (hTG : (T : Subgroup G) ≤ E.G₁) (hXG : E.X ≤ E.G₁)
    (hX : LocalGeometry.IsCartan T L E.X)
    (hx : x ∈ normalizer (E.X : Set G)) (hy : y ∈ normalizer (E.X : Set G))
    (hUQ : E.W ≤ E.G₁.pCoreIn 2)
    (hgen : E.G₁ ≤ (E.K ⊔ E.Y) ⊔ E.M₁)
    (hcartan : ∀ P : Subgroup G, P ≤ (T : Subgroup G) → P = ⁅P,E.X⁆ →
      (frattini P).map P.subtype ≤ E.G₁.pCoreIn 2 → ⁅P,E.Y⁆ ≤ E.Y.pCoreIn 2)
    (hcoreX : ⁅(L ⊔ (T : Subgroup G)).pCoreIn 2,E.X⁆ ≤
      (E.K ⊔ (T : Subgroup G)).pCoreIn 2)
    (hcentral : ⁅E.W,E.G₁.pCoreIn 2⁆ ≤ E.V₁) :
    threeCore E x y ≤ E.G₁.pCoreIn 2 ∧ threeCore E x y = triple E x y := by
  obtain ⟨hres, hmove, hpair⟩ := sourceLayerGeneration E d hUT hf hX hXG hx hy
  exact threeCore_collapse_of_generation E d hUT hf hTG hXG hX hx hy hUQ hgen
    hres hmove hpair hcartan hcoreX hcentral

end CFSG.Quasithin.Chapter11.ChosenNaturalSource.Closure.Linear
