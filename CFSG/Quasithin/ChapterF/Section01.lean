module

public import CFSG.Quasithin.ChapterF.Defs
public import CFSG.Quasithin.ChapterF.Section01.SourceBasic

/-!
# §F.1. Weak BN-pairs of rank 2

The declarations below are legacy conditional helpers, retained with their
original types. Despite their historical source-number names, they are not
proofs of F.1.3, F.1.9 or F.1.10: several merely project assumptions or rewrite
equalities. In particular `proposition_F_1_9` constructs the legacy triple
predicate, not the weak BN-pair of Definition F.1.7.

The `Source` namespace provides the corrected source interfaces. Its theorem
implementations use only the genuine conditions of Hypothesis F.1.1.
-/

namespace CFSG.Quasithin.ChapterF

open scoped Pointwise

universe u

variable {G : Type u} [Group G]

/-! ### Legacy helpers formerly labelled F.1.3 -/

/-- Legacy projection: the Borel attached to `Lᵢ` is its normalizer of the chosen Sylow part. -/
public theorem lemma_F_1_3_borel_normalizer
    {L₁ L₂ S : Subgroup G} (h : HypothesisF11 G L₁ L₂ S) (i : Fin 2) :
    (if i = 0 then h.local₁.borel else h.local₂.borel) =
      if i = 0 then L₁ ⊓ Subgroup.normalizer ((S ⊓ L₁ : Subgroup G) : Set G)
      else L₂ ⊓ Subgroup.normalizer ((S ⊓ L₂ : Subgroup G) : Set G) := by
  fin_cases i <;>
    simp [h.local₁.borel_eq_normalizer, h.local₂.borel_eq_normalizer,
      h.local₁.sylow_eq, h.local₂.sylow_eq]

/-- Legacy projection of unrestricted maximality. Taking M = L₁ forces
L₁ ≤ B₁, so this is not the proper-overgroup assertion of F.1.3(1). -/
public theorem lemma_F_1_3_unique_maximal₁
    {L₁ L₂ S : Subgroup G} (h : HypothesisF11 G L₁ L₂ S)
    {M : Subgroup G} (hM₁ : h.local₁.sylow ≤ M) (hM₂ : M ≤ L₁) :
    M ≤ h.local₁.borel := h.local₁.borel_unique_maximal M hM₁ hM₂

public theorem lemma_F_1_3_unique_maximal₂
    {L₁ L₂ S : Subgroup G} (h : HypothesisF11 G L₁ L₂ S)
    {M : Subgroup G} (hM₁ : h.local₂.sylow ≤ M) (hM₂ : M ≤ L₂) :
    M ≤ h.local₂.borel := h.local₂.borel_unique_maximal M hM₁ hM₂

/-- Legacy projection of assumed cross-normalization; not a proof of F.1.3(3). -/
public theorem lemma_F_1_3_cross_action
    {L₁ L₂ S : Subgroup G} (h : HypothesisF11 G L₁ L₂ S) :
    h.local₂.borel ≤ Subgroup.normalizer (h.local₁.borel : Set G) ∧
      h.local₁.borel ≤ Subgroup.normalizer (h.local₂.borel : Set G) :=
  ⟨h.borel₂_normalizes_borel₁, h.borel₁_normalizes_borel₂⟩

/-- Legacy projection of an arbitrary stored proposition; this does not assert
solvability of the actual common Borel. -/
public theorem lemma_F_1_3_borel_product_solvable
    {L₁ L₂ S : Subgroup G} (h : HypothesisF11 G L₁ L₂ S) :
    h.borel_product_solvable := h.borel_product_solvable_proof

/-- Legacy projection of the stored intersection equality. Its left factors
are not the source parabolics LᵢB. -/
public theorem lemma_F_1_3_intersection
    {L₁ L₂ S : Subgroup G} (h : HypothesisF11 G L₁ L₂ S) :
    Subgroup.closure ((L₁ : Set G) ∪ (h.local₁.borel : Set G)) ⊓
        Subgroup.closure ((L₂ : Set G) ∪ (h.local₂.borel : Set G)) =
      h.local₁.borel ⊔ h.local₂.borel ⊔ S := h.borel_intersection

/-! ### Legacy triple helpers -/

/-- Legacy constructor for the faithful generating triple. This is not
Proposition F.1.9, since it does not verify Green Book Hypothesis A. -/
public theorem proposition_F_1_9
    {P₁ B P₂ : Subgroup G}
    (hgen : Subgroup.closure ((P₁ : Set G) ∪ (P₂ : Set G)) = ⊤)
    (hint : P₁ ⊓ P₂ = B)
    (hfaithful : ∀ N : Subgroup G,
      (N.subgroupOf (P₁ ⊔ P₂)).Normal → N ≤ B → N = ⊥) :
    WeakBNPair G P₁ B P₂ :=
  ⟨hgen, hint, hfaithful⟩

/-- The ambient group generated by two parabolics is a completion of their
subgroup amalgam. -/
public theorem proposition_F_1_9_completion
    {P₁ B P₂ : Subgroup G}
    (a : RankTwoAmalgam G P₁ B P₂) :
    Subgroup.closure ((P₁ : Set G) ∪ (P₂ : Set G)) = ⊤ := a.generated

/-! ### Legacy equality helpers formerly labelled F.1.10 -/

/-- Legacy antisymmetry helper; no Sylow or core property is established. -/
public theorem lemma_F_1_10_twoCore_eq
    {C S : Subgroup G} (h₁ : S ≤ C) (h₂ : C ≤ S) :
    S = C := le_antisymm h₁ h₂

/-- Legacy equality substitution, not a proof of Green Book Hypothesis B. -/
public theorem lemma_F_1_10_hypothesisB
    {K B₁ B₂ S C : Subgroup G}
    (hB : K = B₁ ⊔ B₂ ⊔ S) (hS : S = C) :
    K = B₁ ⊔ B₂ ⊔ C := by simpa [hS] using hB

end CFSG.Quasithin.ChapterF
