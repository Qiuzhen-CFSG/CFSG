module

public import CFSG.Quasithin.ChapterF.Section05.ExceptionalLocal.Transport
public import CFSG.Quasithin.ChapterF.Section05.ExceptionalLocal.SourceCuts
public import CFSG.Quasithin.ChapterF.Section04.UnitaryTwo.PointCore
public import Theory.GroupTheory.PResidual.PrimeToCoreMap
public import Theory.GroupTheory.CharacteristicCentralizerFusion

/-!
# The original root and residual cores in the exceptional branch

The point two-core is self-centralizing and belongs to the prime-to-two
residual. Consequently the source root, central in that residual, belongs
to the center of the point two-core. This center has order two, so its
literal ambient image is generated by the source root. The given root
normalizer therefore identifies its full centralizer with the first endpoint.
The root is in the first endpoint centralizer's two-core as well.

The prime-to-two residual does not change the embedded two-core. In
particular the original Q₂ is elementary abelian of order sixteen; this
uses the actual binary plane parabolic and its Hermitian radical.

Source: Aschbacher--Smith F.4.31, F.4.34 and F.5.3, printed pp.291, 300.
-/

@[expose] public noncomputable section

namespace CFSG.Quasithin.ChapterF.Section05.ExceptionalLocal

open Subgroup Theory.GroupTheory
open GreenBook.LieModels.UnitaryFour
local notation "hn" => Nat.le_refl 1
local notation "P" => pointParabolic 1 hn

/-- The genuine residual-center marking implies the center-of-core marking;
no equality between the residual and the parabolic is assumed. -/
theorem sourceRoot_le_pointCoreCenter :
    Source.rootSubgroup ≤ UnitaryTwo.PointCore.rootSubgroup := by
  rintro _ ⟨z, hz, rfl⟩
  have hQ : pCore 2 P ≤ primeToResidual 2 P :=
    le_primeToResidual_of_isPGroup pCore_isPGroup
  have hc : z.val ∈ centralizer (pCore 2 P : Set P) := by
    intro q hq
    exact congrArg Subtype.val (mem_center_iff.mp hz ⟨q, hQ hq⟩)
  have hzQ := UnitaryTwo.PointCore.projective_point_core_selfCentralizing hc
  refine ⟨⟨z.val, hzQ⟩, ?_, rfl⟩
  exact mem_center_iff.mpr fun q => Subtype.ext (hc q q.property)

variable {G G0 : Type*} [Group G] [Group G0]
variable (c : RankTwoAmalgam.FaithfulCompletion (Extension.amalgam 1 hn) (G := G0))
  (i : G0 →* G)

/-- The original maps on the ordinary endpoints are injective. -/
theorem ordinaryMap_injective (hi : Function.Injective i) (b : Bool) :
    Function.Injective (ordinaryMap c i b) := by
  apply (endpointMap_injective c i hi b).comp
  cases b <;> intro x y hxy <;> apply Subtype.ext
  · exact congrArg SemidirectProduct.left (congrArg Subtype.val hxy)
  · exact congrArg SemidirectProduct.left (congrArg Subtype.val hxy)

/-- The source residual cores are exactly the embedded ordinary endpoint cores. -/
theorem Q_eq_map_pCore (b : Bool) :
    Q c i b = (pCore 2 (ordinaryEndpoint b)).map (ordinaryMap c i b) := by
  rw [Q, ← map_map, map_pCore_primeToResidual]

/-- The center-of-core root image retains its actual ordinary inclusion. -/
theorem pointRootImage_eq_map :
    Source.pointRootImage c i = UnitaryTwo.PointCore.rootSubgroup.map
      (ordinaryMap c i false) := by
  change Source.pointRootImage c i = UnitaryTwo.PointCore.rootSubgroup.map
    (((i.comp c.left).comp Source.pointInclusion))
  rw [UnitaryTwo.PointCore.rootSubgroup, map_map]
  rfl

theorem pointRootImage_card (hi : Function.Injective i) :
    Nat.card (Source.pointRootImage c i) = 2 := by
  rw [pointRootImage_eq_map]
  change Nat.card (UnitaryTwo.PointCore.rootSubgroup.map
    (((i.comp c.left).comp Source.pointInclusion))) = 2
  exact (card_map_of_injective (ordinaryMap_injective c i hi false)).trans
    UnitaryTwo.PointCore.rootSubgroup_card

theorem source_root_order (z : P) (h : Source.Hypotheses c i z) :
    orderOf (rootElement c i z) = 2 :=
  (orderOf_injective (ordinaryMap c i false)
    (ordinaryMap_injective c i h.embedding_injective false) z).trans h.root_order

theorem source_root_mem_pointRootImage (z : P) (h : Source.Hypotheses c i z) :
    rootElement c i z ∈ Source.pointRootImage c i := by
  rw [pointRootImage_eq_map]
  exact mem_map_of_mem _ (sourceRoot_le_pointCoreCenter h.root_mem)

/-- The order-two point-root image is generated by the original source element. -/
theorem pointRootImage_eq_zpowers (z : P) (h : Source.Hypotheses c i z) :
    Source.pointRootImage c i = zpowers (rootElement c i z) := by
  let : Finite (Source.pointRootImage c i) :=
    Nat.finite_of_card_ne_zero (by rw [pointRootImage_card c i h.embedding_injective]; decide)
  apply (eq_of_le_of_card_ge (zpowers_le.mpr (source_root_mem_pointRootImage c i z h)) ?_).symm
  rw [Nat.card_zpowers, source_root_order c i z h,
    pointRootImage_card c i h.embedding_injective]

variable [Finite G]

/-- F.4.34 for the actual exceptional input: the root centralizer is exactly M₁. -/
theorem source_root_centralizer (z : P) (h : Source.Hypotheses c i z) :
    centralizer ({rootElement c i z} : Set G) = M c i false := by
  have hnorm := h.point_normalizer
  rw [pointRootImage_eq_zpowers c i z h,
    normalizer_zpowers_eq_centralizer_of_order_two _ (source_root_order c i z h)] at hnorm
  exact hnorm

/-- The two original marked involutions commute. -/
theorem source_graph_commutes_root (z : P) (h : Source.Hypotheses c i z) :
    Commute (Source.graphElement c i) (rootElement c i z) := by
  apply mem_centralizer_singleton_iff.mp
  rw [source_root_centralizer c i z h]
  exact graph_mem_M c i false

/-- The source root is in the literal first E-core, as used by F.5.4(1). -/
theorem source_root_mem_A_point (z : P) (h : Source.Hypotheses c i z) :
    rootElement c i z ∈ A c i false := by
  have hzE : rootElement c i z ∈ E c i false :=
    ⟨⟨Source.pointInclusion z, rfl⟩,
      mem_centralizer_singleton_iff.mpr (source_graph_commutes_root c i z h).symm.eq⟩
  have hp : IsPGroup 2 (zpowers (rootElement c i z)) :=
    IsPGroup.of_card (n := 1) (by rw [Nat.card_zpowers, source_root_order c i z h]; rfl)
  have hnorm : E c i false ≤ normalizer (zpowers (rootElement c i z) : Set G) := by
    rw [normalizer_zpowers_eq_centralizer_of_order_two _ (source_root_order c i z h),
      source_root_centralizer c i z h]
    exact inf_le_left
  exact le_pCoreIn_of_normalizes hp (zpowers_le.mpr hzE) hnorm (mem_zpowers _)

omit [Finite G] in
/-- The source plane residual core has the exact order used in F.5.3(8). -/
theorem source_Q_plane_card (hi : Function.Injective i) : Nat.card (Q c i true) = 16 := by
  rw [Q_eq_map_pCore, card_map_of_injective (ordinaryMap_injective c i hi true)]
  change Nat.card (pCore 2 (planeParabolic 1 hn)) = 16
  rw [BinaryCompletion.plane_eq_local, L2TwoCore_card]
  norm_num

omit [Finite G] in
/-- The original Q₂ is elementary abelian; no orthogonal target equivalence
or additional source premise is needed. -/
theorem source_Q_plane_elementary :
    IsElementaryAbelian 2 (Q c i true) := by
  rw [Q_eq_map_pCore]
  let hp : IsElementaryAbelian 2 (pCore 2 (ordinaryEndpoint true)) := by
    change IsElementaryAbelian 2 (pCore 2 (planeParabolic 1 hn))
    rw [BinaryCompletion.plane_eq_local]
    infer_instance
  exact IsElementaryAbelian.map (ordinaryMap c i true)

end CFSG.Quasithin.ChapterF.Section05.ExceptionalLocal
