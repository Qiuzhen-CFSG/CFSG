module
public import CFSG.Quasithin.ChapterF.Section05.ExceptionalLocal.NormalizerElementary.Source
public import CFSG.Quasithin.ChapterF.Section05.ExceptionalLocal.NormalizerPlane
public import CFSG.Quasithin.ChapterF.Section05.ExceptionalLocal.GraphCentralizerSylow
public import Theory.GroupTheory.NormalizedSupCard

public import Theory.GroupTheory.NormalizerQuotientTransport

/-!
# Excluding the elementary sixteen-group pair in F.5.5

Two elementary sixteen-groups in a Sylow subgroup of the graph centralizer
cannot meet in order eight when nine divides both normalizer quotient orders.
Conjugate the Sylow subgroup into the original source Sylow. The source
four-subgroup list and the two S5 normalizer quotients leave only the two
mixed plane subgroups. Their intersection is generated by two commuting
involutions and has order at most four, contradicting the given order eight.

The final theorem uses the literal ambient subgroups and normalizer quotients.
Its pair hypotheses are supplied by the elementary residual-centralizer
branch; no additional source classification assumption is introduced.
Source: Aschbacher--Smith F.5.5, printed p.302.
-/

public noncomputable section

open Subgroup Theory.GroupTheory


namespace CFSG.Quasithin.ChapterF.Section05.ExceptionalLocal
open GreenBook.LieModels.UnitaryFour
local notation "hn" => Nat.le_refl 1
variable {G G0 : Type*} [Group G] [Group G0] [Finite G]
variable (c : RankTwoAmalgam.FaithfulCompletion (Extension.amalgam 1 hn) (G := G0))
  (i : G0 →* G) (z : pointParabolic 1 hn) (h : Source.Hypotheses c i z)
include h

private theorem source_root_short_join_card_le_four :
    Nat.card (zpowers (rootElement c i z) ⊔ zpowers (sourceMarkedShort c i) : Subgroup G) ≤ 4 := by
  have hf := source_fusionFacts c i z h
  have hnorm : zpowers (sourceMarkedShort c i) ≤
      normalizer (zpowers (rootElement c i z) : Set G) := by
    rw [normalizer_zpowers_eq_centralizer_of_order_two _ (source_root_order c i z h)]
    exact zpowers_le.mpr (mem_centralizer_singleton_iff.mpr hf.t_commutes_root.eq)
  have hc := card_mul_eq_card_inf_mul_card_sup_of_normalizes
    (zpowers (rootElement c i z)) (zpowers (sourceMarkedShort c i)) hnorm
  rw [Nat.card_zpowers,Nat.card_zpowers,source_root_order c i z h,hf.t_order] at hc
  have hp := Nat.card_pos (α := (zpowers (rootElement c i z) ⊓
    zpowers (sourceMarkedShort c i) : Subgroup G))
  nlinarith

/-- The source elementary family excludes the required pair inside its original Sylow. -/
theorem source_elementary_pair_exclusion_in_sylow (B0 B1 : Subgroup G)
    (hB0 : B0 ≤ Source.sylowImage c i) (hB1 : B1 ≤ Source.sylowImage c i)
    (he0 : IsElementaryAbelian 2 B0) (he1 : IsElementaryAbelian 2 B1)
    (hc0 : Nat.card B0 = 16) (hc1 : Nat.card B1 = 16)
    (hi : Nat.card (B0 ⊓ B1 : Subgroup G) = 8)
    (h90 : 9 ∣ Nat.card (normalizer (B0 : Set G) ⧸
      B0.subgroupOf (normalizer (B0 : Set G))))
    (h91 : 9 ∣ Nat.card (normalizer (B1 : Set G) ⧸
      B1.subgroupOf (normalizer (B1 : Set G)))) : False := by
  classical
  have hf := source_fusionFacts c i z h
  have hct : Nat.card (Tcentralizer c i (sourceMarkedShort c i)) = 64 := by
    obtain ⟨e⟩ := hf.t_centralizer_iso
    rw [Nat.card_congr e.toEquiv,Nat.card_prod,DihedralGroup.nat_card]
  obtain ⟨y,hy,hyt⟩ : ∃ y ∈ Source.sylowImage c i,
      y ∉ Tcentralizer c i (sourceMarkedShort c i) := by
    by_contra hnone
    push Not at hnone
    have he : Source.sylowImage c i = Tcentralizer c i (sourceMarkedShort c i) :=
      le_antisymm hnone inf_le_left
    have hh := hf.sylow_card
    rw [he,hct] at hh
    omega
  have classify (B : Subgroup G) (hBT : B ≤ Source.sylowImage c i)
      (he : IsElementaryAbelian 2 B) (hc : Nat.card B = 16)
      (h9 : 9 ∣ Nat.card (normalizer (B : Set G) ⧸
        B.subgroupOf (normalizer (B : Set G)))) :
      B = A c i true ∨ B = (A c i true).map (MulAut.conj y).toMonoidHom := by
    rcases (source_normalizer_elementary_list c i z h y hy hyt B).mp ⟨hBT,he,hc⟩
      with rfl | hb | hb | rfl
    · obtain ⟨e⟩ := source_normalizer_point_quotient c i z h
      change 9 ∣ Nat.card (normalizerQuotient c i false) at h9
      rw [Nat.card_congr e.toEquiv,Nat.card_perm,Nat.card_fin] at h9
      norm_num [Nat.factorial] at h9
    · exact Or.inl hb
    · exact Or.inr hb
    · obtain ⟨e⟩ := normalizer_Q_quotient c i z h
      change 9 ∣ Nat.card (planeCoreNormalizerQuotient c i) at h9
      rw [Nat.card_congr e.toEquiv,Nat.card_perm,Nat.card_fin] at h9
      norm_num [Nat.factorial] at h9
  have hne : B0 ≠ B1 := by
    intro heq
    rw [heq,inf_idem,hc1] at hi
    omega
  have hpair : B0 ⊓ B1 = A c i true ⊓
      (A c i true).map (MulAut.conj y).toMonoidHom := by
    rcases classify B0 hB0 he0 hc0 h90 with hb0 | hb0 <;>
      rcases classify B1 hB1 he1 hc1 h91 with hb1 | hb1
    · exact (hne (hb0.trans hb1.symm)).elim
    · rw [hb0,hb1]
    · rw [hb0,hb1,inf_comm]
    · exact (hne (hb0.trans hb1.symm)).elim
  rw [hpair,source_normalizer_plane_intersection c i z h y hy hyt] at hi
  have hh := source_root_short_join_card_le_four c i z h
  omega

/-- No such elementary pair exists in any Sylow subgroup of the graph centralizer. -/
theorem source_elementary_pair_exclusion (R : Sylow 2 (C c i)) (B0 B1 : Subgroup G)
    (hB0 : B0 ≤ Rimage c i R) (hB1 : B1 ≤ Rimage c i R)
    (he0 : IsElementaryAbelian 2 B0) (he1 : IsElementaryAbelian 2 B1)
    (hc0 : Nat.card B0 = 16) (hc1 : Nat.card B1 = 16)
    (hi : Nat.card (B0 ⊓ B1 : Subgroup G) = 8)
    (h90 : 9 ∣ Nat.card (normalizer (B0 : Set G) ⧸
      B0.subgroupOf (normalizer (B0 : Set G))))
    (h91 : 9 ∣ Nat.card (normalizer (B1 : Set G) ⧸
      B1.subgroupOf (normalizer (B1 : Set G)))) : False := by
  have hf := source_fusionFacts c i z h
  obtain ⟨g,_,hg⟩ := exists_graph_short_sylow_conjugator c i z
    (sourceMarkedShort c i) hf R
  let e := MulAut.conj g
  have hmap (B : Subgroup G) (hB : B ≤ Rimage c i R) :
      B.map e.toMonoidHom ≤ Source.sylowImage c i :=
    ((map_mono hB).trans_eq hg).trans inf_le_left
  let := he0
  let := he1
  apply source_elementary_pair_exclusion_in_sylow c i z h
    (B0.map e.toMonoidHom) (B1.map e.toMonoidHom) (hmap B0 hB0) (hmap B1 hB1)
    (IsElementaryAbelian.map _) (IsElementaryAbelian.map _)
  · rwa [card_map_of_injective e.injective]
  · rwa [card_map_of_injective e.injective]
  · rwa [←map_inf _ _ _ e.injective,card_map_of_injective e.injective]
  · rwa [normalizer_quotient_card_map_equiv e]
  · rwa [normalizer_quotient_card_map_equiv e]
end CFSG.Quasithin.ChapterF.Section05.ExceptionalLocal
