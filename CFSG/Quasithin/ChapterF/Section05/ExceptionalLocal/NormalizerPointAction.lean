module
public import CFSG.Quasithin.ChapterF.Section05.ExceptionalLocal.NormalizerCentralizer
public import Theory.GroupTheory.SpecificGroups.SymmetricFourCentralNormal
public import Theory.GroupTheory.SpecificGroups.KleinFourGenerators

/-!
# The faithful five-root action of the original point normalizer

The root and graph involutions generate the center of E₁≃E₄×S₄. The
subgroup generated by the five root-class elements contains this center
and is normal in E₁. The natural Klein-four normal-subgroup dichotomy in
S₄ forces that subgroup to be all of A₁.

The actual normalizer N_G(A₁) permutes this root-class intersection by
ambient conjugation. Generation identifies its kernel with C_G(A₁)=A₁,
so the literal quotient N_G(A₁)/A₁ embeds in S₅ and its order divides 120.
Transitivity and surjectivity onto S₅ remain the separate normalizer
assembly step; neither is assumed here.

Source: Aschbacher–Smith F.5.4(4), printed p.301. Inputs are the original
source hypotheses and the independently produced `FusionFacts` only.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterF.Section05.ExceptionalLocal
open GreenBook.LieModels.UnitaryFour
local notation "hn" => Nat.le_refl 1

variable {G G0 : Type*} [Group G] [Group G0] [Finite G]
variable (c : RankTwoAmalgam.FaithfulCompletion (Extension.amalgam 1 hn) (G := G0))
  (i : G0 →* G) (z : pointParabolic 1 hn) (t : G)
  (h : FusionFacts c i z t) (hs : Source.Hypotheses c i z)

/-- The five root-class elements in the original first elementary core. -/
def pointRootClass : Set G := {x | x ∈ A c i false ∧ IsConj (rootElement c i z) x}

include h hs in
/-- The five original root-class elements generate the whole first elementary core. -/
theorem pointRootClass_closure : closure (pointRootClass c i z) = A c i false := by
  classical
  let E₁ := E c i false
  let J := (A c i false).subgroupOf E₁
  let S : Set E₁ := {x | x.val ∈ A c i false ∧ IsConj (rootElement c i z) x.val}
  let N := closure S
  let : J.Normal := A_normal_in_E c i false
  let := h.A_elementary false
  let : IsElementaryAbelian 2 J := IsElementaryAbelian.subgroupOf (A_le_E c i false)
  have hNJ : N ≤ J := (closure_le _).mpr fun _ hx => hx.1
  let : N.Normal := by
    apply normalizer_eq_top_iff.mp
    apply top_unique
    apply le_normalizer_closure_iff.mpr
    intro g _ x hx
    apply Subgroup.subset_closure
    refine ⟨?_,hx.2.trans (isConj_iff.mpr ⟨g.val,rfl⟩)⟩
    exact (Normal.conj_mem (inferInstance : J.Normal) x hx.1 g)
  let f : E₁ := ⟨Source.graphElement c i,graph_mem_E c i false⟩
  let r : E₁ := ⟨rootElement c i z,A_le_E c i false (h.root_mem_A false)⟩
  have hfJ : f ∈ J := graph_mem_A c i z t h false
  have hrJ : r ∈ J := h.root_mem_A false
  have hfC : f ∈ center E₁ := by
    apply mem_center_iff.mpr
    intro a
    apply Subtype.ext
    exact (mem_centralizer_singleton_iff.mp a.property.2)
  have hrC : r ∈ center E₁ := by
    apply mem_center_iff.mpr
    intro a
    apply Subtype.ext
    apply mem_centralizer_singleton_iff.mp
    rw [h.root_centralizer]
    exact a.property.1
  have hrN : r ∈ N := Subgroup.subset_closure ⟨hrJ,IsConj.refl _⟩
  have hfrN : f*r ∈ N := Subgroup.subset_closure ⟨J.mul_mem hfJ hrJ,h.root_fuses_graph_root⟩
  have hfN : f ∈ N := by simpa using N.mul_mem hfrN (N.inv_mem hrN)
  have hfo : orderOf (f : G) = 2 := by
    obtain ⟨g,hg⟩ := isConj_iff.mp h.graph_fuses_t
    have he := orderOf_injective (MulAut.conj g).toMonoidHom (MulAut.conj g).injective
      (Source.graphElement c i)
    change orderOf (g * Source.graphElement c i * g⁻¹) = _ at he
    rw [hg,h.t_order] at he
    exact he.symm
  have hf1 : f ≠ 1 := by
    intro he
    have hh := congrArg (fun a : E₁ => orderOf a.val) he
    change orderOf (Source.graphElement c i) = orderOf (1 : G) at hh
    rw [hfo,orderOf_one] at hh
    omega
  have hr1 : r ≠ 1 := by
    intro he
    have hh := congrArg (fun a : E₁ => orderOf a.val) he
    change orderOf (rootElement c i z) = orderOf (1 : G) at hh
    rw [source_root_order c i z hs,orderOf_one] at hh
    omega
  have hfr : f ≠ r := by
    intro he
    have he' : Source.graphElement c i = rootElement c i z := congrArg Subtype.val he
    apply Source.graph_not_conjugate_root c i z hs
    change IsConj (Source.graphElement c i) (rootElement c i z)
    rw [←he']
  let K := closure ({f,r} : Set E₁)
  have hk : IsKleinFour K := isKleinFour_closure_pair f r
    (by simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) (A := J) f hfJ)
    (by simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) (A := J) r hrJ)
    hf1 hr1 hfr (mem_center_iff.mp hfC r).symm
  have hKC : K ≤ center E₁ := (closure_le _).mpr (by rintro _ (rfl|rfl) <;> assumption)
  have hKN : K ≤ N := (closure_le _).mpr (by rintro _ (rfl|rfl) <;> assumption)
  obtain ⟨e⟩ := h.E_iso false
  have hCcard : Nat.card (center E₁) = 4 :=
    (Nat.card_congr (centerCongr e).toEquiv).trans SymmetricFourCentralNormal.center_card
  have hCN : center E₁ ≤ N := by
    have he : K = center E₁ := eq_of_le_of_card_ge hKC (by rw [hCcard,hk.card_four])
    exact he ▸ hKN
  let j : classIntersection (rootElement c i z) (A c i false) → N := fun x =>
    ⟨⟨x.val.val,A_le_E c i false x.val.property⟩,Subgroup.subset_closure ⟨x.val.property,x.property⟩⟩
  have hj : Function.Injective j := by
    intro x y he
    apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun a : N => a.val.val) he
  have hNcard : 4 < Nat.card N := by
    have hh := Nat.card_le_card_of_injective j hj
    rw [h.root_class_A_point] at hh
    omega
  let Jm := J.map e.toMonoidHom
  let Nm := N.map e.toMonoidHom
  let : Jm.Normal := Normal.map inferInstance e.toMonoidHom e.surjective
  let : Nm.Normal := Normal.map inferInstance e.toMonoidHom e.surjective
  let : IsElementaryAbelian 2 Jm := IsElementaryAbelian.map _
  have hNmc : 4 < Nat.card Nm := by rwa [card_map_of_injective e.injective]
  have hZm : center SymmetricFourCentralNormal.Model ≤ Nm := by
    intro x hx
    refine ⟨e.symm x,hCN ?_,e.apply_symm_apply x⟩
    exact (centerCongr e.symm ⟨x,hx⟩).property
  have hEq := SymmetricFourCentralNormal.normal_eq_of_center_le Jm Nm (map_mono hNJ) hZm hNmc
  have hNJ' : N = J := map_injective e.injective hEq
  have hmap : S.image E₁.subtype = pointRootClass c i z := by
    ext x
    constructor
    · rintro ⟨a,ha,rfl⟩
      exact ha
    · intro hx
      exact ⟨⟨x,A_le_E c i false hx.1⟩,hx,rfl⟩
  rw [←hmap,←MonoidHom.map_closure]
  change N.map E₁.subtype = A c i false
  rw [hNJ',map_subgroupOf_eq_of_le (A_le_E c i false)]

/-- The literal conjugation action of N_G(A₁) on its root-class intersection. -/
def pointRootAction : normalizer (A c i false : Set G) →*
    Equiv.Perm (pointRootClass c i z) where
  toFun g := {
    toFun := fun x => ⟨g.val*x.val*g.val⁻¹,
      (mem_normalizer_iff.mp g.property x.val).mp x.property.1,
      x.property.2.trans (isConj_iff.mpr ⟨g.val,rfl⟩)⟩
    invFun := fun x => ⟨g.val⁻¹*x.val*g.val,
      (mem_normalizer_iff''.mp g.property x.val).mp x.property.1,
      x.property.2.trans (isConj_iff.mpr ⟨g.val⁻¹,by simp⟩)⟩
    left_inv := by intro x; apply Subtype.ext; change g.val⁻¹*(g.val*x.val*g.val⁻¹)*g.val=x.val; group
    right_inv := by intro x; apply Subtype.ext; change g.val*(g.val⁻¹*x.val*g.val)*g.val⁻¹=x.val; group }
  map_one' := by
    apply Equiv.ext
    intro x
    apply Subtype.ext
    change 1*x.val*1⁻¹=x.val
    simp
  map_mul' := by
    intro g k
    apply Equiv.ext
    intro x
    apply Subtype.ext
    change (g.val*k.val)*x.val*(g.val*k.val)⁻¹=g.val*(k.val*x.val*k.val⁻¹)*g.val⁻¹
    group

include h hs in
/-- Fixing the five roots is exactly centralizing A₁, whose full centralizer is A₁. -/
theorem pointRootAction_ker : (pointRootAction c i z).ker =
    (A c i false).subgroupOf (normalizer (A c i false : Set G)) := by
  ext g
  change pointRootAction c i z g=1 ↔ g.val ∈ A c i false
  constructor
  · intro hg
    have hc : g.val ∈ centralizer (pointRootClass c i z) := by
      intro x hx
      have he := congrArg (fun p : Equiv.Perm (pointRootClass c i z) => (p ⟨x,hx⟩).val) hg
      change g.val*x*g.val⁻¹=x at he
      exact (mul_inv_eq_iff_eq_mul.mp he).symm
    rw [←centralizer_closure,pointRootClass_closure c i z t h hs,
      A_self_centralizer c i z t h false] at hc
    exact hc
  · intro hg
    have hc : g.val ∈ centralizer (A c i false : Set G) := by
      rw [A_self_centralizer c i z t h false]
      exact hg
    apply Equiv.ext
    intro x
    apply Subtype.ext
    change g.val*x.val*g.val⁻¹=x.val
    rw [←mem_centralizer_iff.mp hc x.val x.property.1,mul_inv_cancel_right]

/-- The induced action of the literal quotient N_G(A₁)/A₁ on its five roots. -/
def pointNormalizerRootAction : normalizerQuotient c i false →*
    Equiv.Perm (pointRootClass c i z) :=
  QuotientGroup.lift _ (pointRootAction c i z)
    (pointRootAction_ker c i z t h hs).symm.le

/-- The quotient action uses the original ambient conjugation and quotient map. -/
theorem pointNormalizerRootAction_mk_apply
    (g : normalizer (A c i false : Set G)) (x : pointRootClass c i z) :
    (pointNormalizerRootAction c i z t h hs
      (QuotientGroup.mk' ((A c i false).subgroupOf (normalizer (A c i false : Set G))) g) x).val =
      g.val * x.val * g.val⁻¹ := rfl

/-- The actual quotient acts faithfully on the root-class intersection. -/
theorem pointNormalizerRootAction_injective :
    Function.Injective (pointNormalizerRootAction c i z t h hs) := by
  apply (QuotientGroup.injective_lift_iff _ _ _).mpr
  exact (pointRootAction_ker c i z t h hs).symm

omit [Finite G] in
include h in
/-- The literal root-class carrier has five elements. -/
theorem pointRootClass_card : Nat.card (pointRootClass c i z) = 5 := by
  let e : pointRootClass c i z ≃ classIntersection (rootElement c i z) (A c i false) := {
    toFun := fun x => ⟨⟨x.val,x.property.1⟩,x.property.2⟩
    invFun := fun x => ⟨x.val.val,x.val.property,x.property⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl }
  exact (Nat.card_congr e).trans h.root_class_A_point

include h hs in
/-- The point normalizer quotient embeds in S₅ via the faithful action on its five roots. -/
theorem exists_pointNormalizer_embedding :
    ∃ f : normalizerQuotient c i false →* Equiv.Perm (Fin 5), Function.Injective f := by
  let e : pointRootClass c i z ≃ Fin 5 :=
    (Finite.equivFin (pointRootClass c i z)).trans (finCongr (pointRootClass_card c i z t h))
  exact ⟨e.permCongrHom.toMonoidHom.comp (pointNormalizerRootAction c i z t h hs),
    e.permCongrHom.injective.comp (pointNormalizerRootAction_injective c i z t h hs)⟩

include h hs in
/-- The exact cardinal upper bound used before identifying the full S₅ image. -/
theorem pointNormalizer_card_dvd : Nat.card (normalizerQuotient c i false) ∣ 120 := by
  obtain ⟨f,hf⟩ := exists_pointNormalizer_embedding c i z t h hs
  have hh := Subgroup.card_subgroup_dvd_card f.range
  rw [←Nat.card_congr (MonoidHom.ofInjective hf).toEquiv] at hh
  simpa only [Nat.card_eq_fintype_card,Fintype.card_perm,Fintype.card_fin,Nat.factorial] using hh

end CFSG.Quasithin.ChapterF.Section05.ExceptionalLocal
