module
public import CFSG.Quasithin.ChapterF.Section05.ExceptionalLocal.FusionAmbient
public import CFSG.Quasithin.ChapterI.Section06To08.StrongEmbedding
public import BenderSuzuki.SE.StrongEmbeddingConjugacy

/-!
# Generation from the two controlled involution classes

Let K be generated by the embedded completion and the plane-core normalizer.
If the two representative centralizers lie in K and every involution in the
marked Sylow subgroup is K-conjugate to a representative, then K is the ambient
group. Otherwise I.8.1 makes K strongly embedded, forcing graph/root fusion,
contrary to the proved source nonfusion theorem.

This route to F.5.6 avoids an inductive recognition of K. The controlled fusion
and the F.5.5 graph-centralizer identity remain explicit earlier obligations;
ambient conjugacy alone would not justify the argument.

Source: Aschbacher--Smith F.5.5--6, printed p.302.
-/

public noncomputable section
namespace CFSG.Quasithin.ChapterF.Section05.ExceptionalLocal
open Subgroup Theory.GroupTheory
open GreenBook.LieModels.UnitaryFour
local notation "hn" => Nat.le_refl 1
variable {G G0 : Type*} [Group G] [Group G0] [Finite G]

omit [Finite G] in
private theorem centralizer_le_of_conjugate {K : Subgroup G} {a x k : G}
    (ha : centralizer ({a} : Set G) ≤ K) (hk : k ∈ K)
    (hx : k * a * k⁻¹ = x) : centralizer ({x} : Set G) ≤ K := by
  intro g hg
  have hc : k⁻¹ * g * k ∈ centralizer ({a} : Set G) := by
    apply mem_centralizer_singleton_iff.mpr
    have hh := congrArg (fun v : G => k⁻¹ * v * k)
      (mem_centralizer_singleton_iff.mp hg)
    simpa [← hx, mul_assoc] using hh
  have hh := K.mul_mem (K.mul_mem hk (ha hc)) (K.inv_mem hk)
  simpa [mul_assoc] using hh

variable (c : RankTwoAmalgam.FaithfulCompletion (Extension.amalgam 1 hn) (G := G0))
  (i : G0 →* G)

/-- Controlled conjugators and the graph-centralizer bound imply F.5.6. -/
theorem source_generation_of_controlled_fusion (z : pointParabolic 1 hn)
    (h : Source.Hypotheses c i z)
    (hfcentral : C c i ≤ i.range ⊔ H c i)
    (hlocal : ∀ x ∈ Source.sylowImage c i, orderOf x = 2 →
      ∃ k ∈ i.range ⊔ H c i,
        k * rootElement c i z * k⁻¹ = x ∨
        k * Source.graphElement c i * k⁻¹ = x) :
    i.range ⊔ H c i = ⊤ := by
  let K := i.range ⊔ H c i
  have hMK : M c i false ≤ K := (M_le_completion c i false).trans le_sup_left
  have hTK : Source.sylowImage c i ≤ K := (sylowImage_le_M c i false).trans hMK
  obtain ⟨S, hS⟩ := source_sylowImage_isSylow c i z h
  have hSK : (S : Subgroup G) ≤ K := hS ▸ hTK
  let T : Sylow 2 K := S.subtype hSK
  have hT : (T : Subgroup K).map K.subtype = Source.sylowImage c i := by
    rw [Sylow.coe_subtype, map_subgroupOf_eq_of_le hSK, hS]
  have hnorm : normalizer (Source.sylowImage c i : Set G) ≤ K := by
    have hnc := normalizer_le_normalizer_characteristic_image
      (Source.sylowImage c i) (center (Source.sylowImage c i))
    rw [source_sylowImage_center_eq_pointRoot c i z h, h.point_normalizer] at hnc
    exact hnc.trans hMK
  have hzK : rootElement c i z ∈ K := hTK (source_root_mem_sylowImage c i z h)
  have hzorder : orderOf (⟨rootElement c i z, hzK⟩ : K) = 2 := by
    rw [← Subgroup.orderOf_coe, source_root_order c i z h]
  have hEven : Even (Nat.card K) := even_iff_two_dvd.mpr
    (hzorder ▸ orderOf_dvd_natCard (⟨rootElement c i z, hzK⟩ : K))
  by_contra hproper
  have hstrong := ChapterI.Section06To08.stronglyEmbedded_of_sylow_normalizer_and_centralizers
    K T hproper hEven (by rwa [hT]) (by
      intro x hx hxinv
      rw [hT] at hx
      have hxorder : orderOf x = 2 := orderOf_eq_prime_iff.mpr ⟨hxinv.2, hxinv.1⟩
      obtain ⟨k, hk, hkx | hkx⟩ := hlocal x hx hxorder
      · exact centralizer_le_of_conjugate (h.root_centralizer.trans hMK) hk hkx
      · exact centralizer_le_of_conjugate hfcentral hk hkx)
  have hf2 := orderOf_eq_prime_iff.mp (source_graph_order c i h.embedding_injective)
  have hz2 := orderOf_eq_prime_iff.mp (source_root_order c i z h)
  obtain ⟨g, hg⟩ := hstrong.involutions_conjugate ⟨hf2.2, hf2.1⟩ ⟨hz2.2, hz2.1⟩
  apply Source.graph_not_conjugate_root c i z h
  apply isConj_iff.mpr
  exact ⟨g⁻¹, by simpa [BenderSuzuki.PFAppendixIII.rightConjugateElem, rootElement] using hg⟩


/-- The literal F.5.5 centralizer join supplies the centralizer bound in F.5.6.
The normalizer producer supplies `hRH`, and the fusion producer retains the
conjugators in the generated subgroup. -/
theorem source_generation_of_centralizer_join (z : pointParabolic 1 hn)
    (h : Source.Hypotheses c i z) (R : Sylow 2 (C c i))
    (hRH : Rimage c i R ≤ H c i)
    (hcentral : C c i = Rimage c i R ⊔ D c i)
    (hlocal : ∀ x ∈ Source.sylowImage c i, orderOf x = 2 →
      ∃ k ∈ i.range ⊔ H c i,
        k * rootElement c i z * k⁻¹ = x ∨
        k * Source.graphElement c i * k⁻¹ = x) :
    i.range ⊔ H c i = ⊤ := by
  apply source_generation_of_controlled_fusion c i z h ?_ hlocal
  rw [hcentral]
  exact sup_le (hRH.trans le_sup_right) ((D_le_completion c i).trans le_sup_left)

end CFSG.Quasithin.ChapterF.Section05.ExceptionalLocal
