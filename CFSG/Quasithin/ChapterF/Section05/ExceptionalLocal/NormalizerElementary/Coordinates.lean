module
public import Theory.Representation.BinaryAlternatingFiveExtension.SylowGraphCenter
public import Theory.SpecificGroups.SymmetricFourWreath.ElementaryGeometry.Intersections

/-!
# The marked mixed elementary subgroup in the binary affine Sylow

A nonzero cyclic displacement of the marked translation group identifies one
dihedral factor. The graph involution together with its fixed translations is
the mixed elementary subgroup of order sixteen. Its normalizer is precisely
the selected short-involution centralizer; conjugation outside that normalizer
switches the two mixed subgroups, whose intersection is generated by the short
involution and the whole Sylow center.

These calculations preserve the given translation group and graph involution.
They supply the literal A2 marking in F.5.4 and its intersection used in F.5.5.
Source: Aschbacher--Smith, printed pp.301--302.
-/

set_option backward.isDefEq.respectTransparency false
@[expose] public section
namespace CFSG.Quasithin.ChapterF.Section05.ExceptionalLocal.ElementaryCoordinates
open Subgroup
open BinaryPermutation.AlternatingFiveExtension
open SylowModel SylowCommutator
open scoped commutatorElement
private instance : Fintype V4 := inferInstance
private instance : DecidableEq V4 := inferInstance
private instance : Fintype PlaneWreath := Fintype.ofEquiv _ (RegularWreathProduct.equivProd PlaneGroup Bit).symm
private instance : DecidableEq PlaneWreath := (RegularWreathProduct.equivProd PlaneGroup Bit).injective.decidableEq
private instance : Fintype Actor := Fintype.ofEquiv _ (RegularWreathProduct.equivProd Bit Bit).symm
private instance : DecidableEq Actor := (RegularWreathProduct.equivProd Bit Bit).injective.decidableEq

def pairMap : (PlaneGroup × PlaneGroup) →* PlaneWreath where
  toFun x := ⟨fun i => if i = 1 then x.1 else x.2,1⟩
  map_one' := by
    apply RegularWreathProduct.ext
    · funext i
      simp
    · rfl
  map_mul' x y := by
    apply RegularWreathProduct.ext
    · funext i
      simp only [RegularWreathProduct.mul_left,Pi.mul_apply,inv_one,one_mul]
      split <;> rfl
    · rfl

theorem pairMap_injective : Function.Injective pairMap := by
  intro x y he
  apply Prod.ext
  · simpa [pairMap] using congrArg (fun a : PlaneWreath => a.left 1) he
  · simpa [pairMap, show (Multiplicative.ofAdd 1 : Bit) ≠ 1 by decide] using
      congrArg (fun a : PlaneWreath => a.left (.ofAdd 1)) he

/-- The other elementary four-group in E4:C2. -/
def reflectedPlane : Subgroup PlaneGroup where
  carrier := {x | x.left.1 = x.left.2}
  one_mem' := rfl
  mul_mem' := by decide +kernel
  inv_mem' := by decide +kernel

instance : DecidablePred (· ∈ reflectedPlane) := fun x => inferInstanceAs (Decidable (x.left.1=x.left.2))

def translationPlane : Subgroup PlaneGroup := (SemidirectProduct.inl : Plane →* PlaneGroup).range

instance : DecidablePred (· ∈ translationPlane) := fun x =>
  decidable_of_iff (x.right = 1) (by
    rw [translationPlane,SemidirectProduct.range_inl_eq_ker_rightHom]
    rfl)

def planeChoice (b : Bool) : Subgroup PlaneGroup := if b then reflectedPlane else translationPlane

instance (b : Bool) : DecidablePred (· ∈ planeChoice b) := by cases b <;> dsimp [planeChoice] <;> infer_instance

/-- Four coordinate products, keeping the original affine translations. -/
def rectangle (b c : Bool) : Subgroup PlaneWreath := ((planeChoice b).prod (planeChoice c)).map pairMap

theorem mem_rectangle (b c : Bool) (x : PlaneWreath) :
    x ∈ rectangle b c ↔ x.right=1 ∧ x.left 1∈planeChoice b ∧
      x.left (.ofAdd 1)∈planeChoice c := by
  constructor
  · rintro ⟨⟨a,d⟩,⟨ha,hd⟩,rfl⟩
    exact ⟨rfl,by simpa [pairMap] using ha,
      by simpa [pairMap,show (Multiplicative.ofAdd 1 : Bit)≠1 by decide] using hd⟩
  · rintro ⟨hx,ha,hd⟩
    refine ⟨(x.left 1,x.left (.ofAdd 1)),⟨ha,hd⟩,?_⟩
    apply RegularWreathProduct.ext
    · funext i
      have hi : i=1 ∨ i=Multiplicative.ofAdd 1 := by exact (by decide : ∀ i : Bit, i=1 ∨ i=Multiplicative.ofAdd 1) i
      rcases hi with rfl | rfl <;> simp [pairMap]
    · exact hx.symm

instance (b c : Bool) : DecidablePred (· ∈ rectangle b c) := fun x =>
  decidable_of_iff _ (mem_rectangle b c x).symm

def mixed (j : Bit) : Subgroup PlaneWreath := if j=1 then rectangle true false else rectangle false true
instance (j : Bit) : DecidablePred (· ∈ mixed j) := by dsimp [mixed]; split <;> infer_instance

theorem cyclic_displacement_actor : ∀ (a : Actor) (u : V4),
    (∃ v : V4, displacement a v ≠ 1) →
    (∀ v : V4, displacement a v = 1 ∨ displacement a v = u) →
    ∃ j : Bit, u=axis j ∧ a.right=1 ∧ a.left j=Multiplicative.ofAdd 1 ∧
      a.left (Multiplicative.ofAdd 1*j)=1 := by decide +kernel


theorem card_rectangle (b c : Bool) : Nat.card (rectangle b c) = 16 := by
  rw [rectangle,card_map_of_injective pairMap_injective,
    Nat.card_congr (prodEquiv _ _).toEquiv,Nat.card_prod]
  have h : ∀ b : Bool, Nat.card (planeChoice b) = 4 := by
    intro b
    rw [Nat.card_eq_fintype_card]
    cases b <;> decide +kernel
  rw [h,h]

theorem card_mixed (j : Bit) : Nat.card (mixed j) = 16 := by
  dsimp only [mixed]
  split <;> exact card_rectangle _ _

def baseCondition (x : PlaneWreath) : Prop := x.right=1 ∧ ∀ k, (x.left k).right=1
instance (x : PlaneWreath) : Decidable (baseCondition x) := inferInstanceAs
  (Decidable (x.right=1 ∧ ∀ k, (x.left k).right=1))

theorem mem_base_iff (x : PlaneWreath) : x ∈ baseMap.range ↔ baseCondition x := by
  constructor
  · rintro ⟨v,rfl⟩
    exact ⟨rfl,fun _ => rfl⟩
  · rintro ⟨hx,hl⟩
    refine ⟨fun k => (x.left k).left,?_⟩
    apply RegularWreathProduct.ext
    · funext k
      apply SemidirectProduct.ext
      · rfl
      · exact (hl k).symm
    · exact hx.symm

instance : DecidablePred (· ∈ baseMap.range) := fun x =>
  decidable_of_iff (baseCondition x) (mem_base_iff x).symm

/-- The literal element has the single-flip actor required by a displacement line. -/
def hasAxis (f : PlaneWreath) (j : Bit) : Prop :=
  f.right=1 ∧ (f.left j).right=Multiplicative.ofAdd 1 ∧
    (f.left (Multiplicative.ofAdd 1*j)).right=1
instance (f : PlaneWreath) (j : Bit) : Decidable (hasAxis f j) := inferInstanceAs
  (Decidable (f.right=1 ∧ (f.left j).right=Multiplicative.ofAdd 1 ∧
    (f.left (Multiplicative.ofAdd 1*j)).right=1))

private theorem core_members : ∀ (f : PlaneWreath) (j : Bit),
    f^2=1 → hasAxis f j → f ∈ mixed j ∧
      (∀ x : PlaneWreath, x ∈ baseMap.range → x*f=f*x → x∈mixed j) ∧
      (∀ x : PlaneWreath, x∈mixed j →
        (x∈baseMap.range ∧ x*f=f*x) ∨
        (x*f∈baseMap.range ∧ (x*f)*f=f*(x*f))) := by decide +kernel

theorem graph_core_eq_mixed (f : PlaneWreath) (j : Bit)
    (hf : f^2=1) (hj : hasAxis f j) :
    (baseMap.range ⊓ centralizer ({f} : Set PlaneWreath)) ⊔ zpowers f = mixed j := by
  have h := core_members f j hf hj
  apply le_antisymm
  · refine sup_le ?_ (zpowers_le.mpr h.1)
    intro x hx
    exact h.2.1 x hx.1 (mem_centralizer_singleton_iff.mp hx.2)
  · intro x hx
    rcases h.2.2 x hx with h | h
    · exact mem_sup_left ⟨h.1,mem_centralizer_singleton_iff.mpr h.2⟩
    · have hh := ((baseMap.range ⊓ centralizer ({f} : Set PlaneWreath)) ⊔ zpowers f).mul_mem
        (mem_sup_left ⟨h.1,mem_centralizer_singleton_iff.mpr h.2⟩)
        (mem_sup_right (inv_mem (mem_zpowers f)))
      simpa only [mul_inv_cancel_right] using hh


private theorem planeChoice_conj : ∀ (b : Bool) (g x : PlaneGroup),
    g*x*g⁻¹∈planeChoice b ↔ x∈planeChoice b := by decide +kernel

private theorem wreath_conj_right (y x : PlaneWreath) :
    (y*x*y⁻¹).right=x.right := by
  change y.right*x.right*y.right⁻¹=x.right
  simp

private theorem wreath_conj_left (y x : PlaneWreath) (hx : x.right=1) (k : Bit) :
    (y*x*y⁻¹).left k=y.left k*x.left (y.right⁻¹*k)*(y.left k)⁻¹ := by
  simp [RegularWreathProduct.mul_left,RegularWreathProduct.inv_left,hx]

private theorem bit_cases (a : Bit) : a=1 ∨ a=Multiplicative.ofAdd 1 := by
  exact (by decide : ∀ a : Bit, a=1 ∨ a=Multiplicative.ofAdd 1) a

private theorem rectangle_conj_mem (b c : Bool) (y x : PlaneWreath) :
    y*x*y⁻¹∈rectangle b c ↔ x∈(if y.right=1 then rectangle b c else rectangle c b) := by
  rw [mem_rectangle,wreath_conj_right]
  by_cases hx : x.right=1
  · simp only [hx,true_and,eq_self]
    rw [wreath_conj_left y x hx,wreath_conj_left y x hx,
      planeChoice_conj,planeChoice_conj]
    rcases bit_cases y.right with hy | hy
    · simp [hy,mem_rectangle,hx]
    · simp [hy,mem_rectangle,hx,show (Multiplicative.ofAdd 1 : Bit) ≠ 1 by decide,
        show (Multiplicative.ofAdd 1 : Bit)⁻¹ = Multiplicative.ofAdd 1 by decide,
        show (Multiplicative.ofAdd 1 : Bit)*Multiplicative.ofAdd 1=1 by decide,and_comm]
  · rcases bit_cases y.right with hy | hy <;> simp [hy,mem_rectangle,hx]

private theorem mixed_conjugate_test (j : Bit) (y x : PlaneWreath) :
    y*x*y⁻¹ ∈ mixed j ↔ x∈mixed (if y.right=1 then j else Multiplicative.ofAdd 1*j) := by
  rcases bit_cases j with rfl | rfl
  all_goals
    rcases bit_cases y.right with hy | hy
    all_goals
      simp only [mixed,ite_true,show (Multiplicative.ofAdd 1 : Bit) ≠ 1 by decide,ite_false]
      rw [rectangle_conj_mem]
      simp [hy,show (Multiplicative.ofAdd 1 : Bit)*Multiplicative.ofAdd 1=1 by decide]

theorem mixed_conjugate (j : Bit) (y : PlaneWreath) :
    (mixed j).map (MulAut.conj y).toMonoidHom =
      mixed (if y.right=1 then j else Multiplicative.ofAdd 1*j) := by
  ext x
  obtain ⟨a,rfl⟩ := (MulAut.conj y).surjective x
  change (MulAut.conj y).toMonoidHom a ∈ (mixed j).map (MulAut.conj y).toMonoidHom ↔ _
  rw [mem_map_iff_mem ((MulAut.conj y).injective)]
  change _ ↔ y*a*y⁻¹∈mixed _
  rw [mixed_conjugate_test]
  rcases bit_cases y.right with hy | hy
  · simp [hy]
  · simp [hy,←mul_assoc,show (Multiplicative.ofAdd 1 : Bit)*Multiplicative.ofAdd 1=1 by decide]

private theorem mixed_distinct (j : Bit) : mixed (Multiplicative.ofAdd 1*j) ≠ mixed j := by
  have hh : ∀ j : Bit, ∃ x : PlaneWreath, x∈mixed j ∧ x∉mixed (Multiplicative.ofAdd 1*j) := by
    decide +kernel
  obtain ⟨x,hx,hnot⟩ := hh j
  intro he
  exact hnot (he.symm ▸ hx)

theorem normalizer_mixed (j : Bit) :
    normalizer (mixed j : Set PlaneWreath) = centralizer ({baseMap (axis j)} : Set PlaneWreath) := by
  ext y
  rw [mem_centralizer_singleton_iff,centralizer_axis_test,
    mem_normalizer_iff_map_conj_eq]
  change (mixed j).map (MulAut.conj y).toMonoidHom = mixed j ↔ _
  rw [mixed_conjugate]
  by_cases hy : y.right=1
  · simp [hy]
  · simp [hy,mixed_distinct]

def centralFour : Subgroup PlaneWreath := baseMap.range ⊓ rectangle true true
instance : DecidablePred (· ∈ centralFour) := fun x =>
  inferInstanceAs (Decidable (x∈baseMap.range ∧ x∈rectangle true true))

private theorem mixed_inf_test : ∀ (j : Bit) (x : PlaneWreath),
    (x∈mixed j ∧ x∈mixed (Multiplicative.ofAdd 1*j)) ↔ x∈centralFour := by decide +kernel

theorem mixed_inf_opposite (j : Bit) :
    mixed j ⊓ mixed (Multiplicative.ofAdd 1*j) = centralFour := by
  ext x
  exact mixed_inf_test j x

private theorem centralFour_table : ∀ (j : Bit) (x : PlaneWreath),
    x∈centralFour ↔ x=1 ∨ x=baseMap (axis j) ∨
      x=baseMap (axis 1)*baseMap (axis (.ofAdd 1)) ∨
      x=(baseMap (axis 1)*baseMap (axis (.ofAdd 1)))*baseMap (axis j) := by decide +kernel

private theorem center_table : ∀ x : PlaneWreath,
    (∀ y, y*x=x*y) ↔ x=1 ∨ x=baseMap (axis 1)*baseMap (axis (.ofAdd 1)) := by decide +kernel

theorem centralFour_eq_center_sup_axis (j : Bit) :
    centralFour = center PlaneWreath ⊔ zpowers (baseMap (axis j)) := by
  have hz : baseMap (axis 1)*baseMap (axis (.ofAdd 1)) ∈ center PlaneWreath :=
    mem_center_iff.mpr ((center_table _).mpr (Or.inr rfl))
  apply le_antisymm
  · intro x hx
    rcases (centralFour_table j x).mp hx with rfl | rfl | rfl | rfl
    · exact one_mem _
    · exact mem_sup_right (mem_zpowers _)
    · exact mem_sup_left hz
    · exact mul_mem (mem_sup_left hz) (mem_sup_right (mem_zpowers _))
  · refine sup_le ?_ (zpowers_le.mpr ((centralFour_table j _).mpr (Or.inr (Or.inl rfl))))
    intro x hx
    rcases (center_table x).mp (mem_center_iff.mp hx) with rfl | rfl
    · exact one_mem _
    · exact (centralFour_table j _).mpr (Or.inr (Or.inr (Or.inl rfl)))


/-- Cyclic displacement marks the mixed elementary subgroup without selecting
an arbitrary group equivalence for the graph involution. -/
theorem graph_core_coordinates (f : PlaneWreath) (u : V4)
    (hf : f^2=1) (hu : orderOf (baseMap u)=2)
    (hc : ⁅baseMap.range,zpowers f⁆=zpowers (baseMap u)) :
    ∃ j : Bit, baseMap u=baseMap (axis j) ∧
      (baseMap.range ⊓ centralizer ({f} : Set PlaneWreath)) ⊔ zpowers f = mixed j := by
  obtain ⟨_,hm,hd⟩ := SylowGraphCenter.displacement_of_cyclic_base_commutator f u hu hc
  obtain ⟨j,huj,hj⟩ := cyclic_displacement_actor (actorProjection f) u hm hd
  exact ⟨j,congrArg baseMap huj,graph_core_eq_mixed f j hf hj⟩

end CFSG.Quasithin.ChapterF.Section05.ExceptionalLocal.ElementaryCoordinates
