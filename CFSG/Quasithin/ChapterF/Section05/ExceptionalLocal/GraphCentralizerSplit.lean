module
public import CFSG.Quasithin.ChapterF.Section05.ExceptionalLocal.GraphCentralizerAlternating
public import Theory.SpecificGroups.AlternatingSix.FourDihedralExtension
public import Theory.GroupTheory.PResidual.SylowSupplement
/-!
# The marked direct factors of the F.5.5 graph-centralizer quotient

The actual two-residual is A₆ and the actual quotient Sylow is E₄ × D₈.
The original root involution fixes the first endpoint A₄ and acts nontrivially.
These established source witnesses give C* = C₂ × S₆, with the S₆ factor
literally generated by O²(C*) and the original root image. The second
projection is the conjugation action, so both kernels retain their markings.

Source: Aschbacher–Smith F.5.5, printed p.302.
-/
public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterF.Section05.ExceptionalLocal
open GreenBook.LieModels.UnitaryFour
open AlternatingSix.ShadowLocal
open AlternatingSix.FourDihedralExtension
local notation "hn" => Nat.le_refl 1
variable {G G0 : Type*} [Group G] [Group G0] [Finite G]
variable (c : RankTwoAmalgam.FaithfulCompletion (Extension.amalgam 1 hn) (G := G0))
  (i : G0 →* G) (z : pointParabolic 1 hn) (h : Source.Hypotheses c i z)
include h

private theorem source_graph_quotient_action_data
    (R : Sylow 2 (C c i)) (hR : Tf c i≤R) :
    let W := pResidual 2 (graphCentralQuotient c i)
    let a := QuotientGroup.mk' (zpowers (graphInCentralizer c i))
      (sourceRootInGraphCentralizer c i z h)
    ∃ (e : W≃*A6) (S : Sylow 2 (graphCentralQuotient c i))
      (_eS : S≃*E4×DihedralGroup 4) (L : Subgroup A6)
      (_eL : L≃*alternatingGroup (Fin 4)),
      orderOf a=2 ∧ (∀ l∈L, conjugationAction W e a l=l) ∧
      conjugationAction W e a≠1 := by
  intro W a
  obtain ⟨e⟩ := source_graph_residual_alternating c i z h R hR
  let π := QuotientGroup.mk' (zpowers (graphInCentralizer c i))
  let S := R.mapSurjective (QuotientGroup.mk'_surjective (zpowers (graphInCentralizer c i)))
  obtain ⟨_,eS,_⟩ := source_graph_quotient_marked_model c i z h R hR
  let j : pResidual 2 (Dendpoint c i false) →* A6 :=
    e.toMonoidHom.comp (sourceEndpointResidualGraphMap c i false)
  have hj : Function.Injective j := e.injective.comp
    (sourceEndpointResidualGraphMap_injective c i z h false)
  let eL : j.range≃*alternatingGroup (Fin 4) :=
    (MonoidHom.ofInjective hj).symm.trans (sourceEndpointResidualEquiv c i z h false)
  have hβ : conjugationAction W e a=MulAut.congr e (sourceRootResidualAction c i z h) := rfl
  have hne : conjugationAction W e a≠1 := by
    rw [hβ]
    intro hh
    exact sourceRootResidualAction_ne_one c i z h ((MulAut.congr e).injective
      (hh.trans (MulAut.congr e).map_one.symm))
  have ha2 : a^2=1 := by
    change π (sourceRootInGraphCentralizer c i z h)^2=1
    rw [←map_pow]
    have hh : sourceRootInGraphCentralizer c i z h ^2=1 := by
      apply Subtype.ext
      exact source_root_order c i z h ▸ pow_orderOf_eq_one (rootElement c i z)
    rw [hh,map_one]
  have ha : orderOf a=2 := orderOf_eq_prime ha2 (by
    intro hh
    apply hne
    rw [hh,map_one])
  have hfix : ∀l∈j.range,conjugationAction W e a l=l := by
    rintro _ ⟨x,rfl⟩
    rw [hβ]
    change e (sourceRootResidualAction c i z h (e.symm
      (e (sourceEndpointResidualGraphMap c i false x))))=e (sourceEndpointResidualGraphMap c i false x)
    rw [e.symm_apply_apply,sourceRootResidualAction_fixes_point c i z h]
  exact ⟨e,S,eS,j.range,eL,ha,hfix,hne⟩

/-- The actual centralizer quotient and its original root-generated S₆ factor. -/
theorem source_graph_quotient_marked_product (R : Sylow 2 (C c i)) (hR : Tf c i≤R) :
    let W := pResidual 2 (graphCentralQuotient c i)
    let a := QuotientGroup.mk' (zpowers (graphInCentralizer c i))
      (sourceRootInGraphCentralizer c i z h)
    Nat.card (centralizer (W:Set (graphCentralQuotient c i)))=2 ∧
    ∃ (e : W≃*A6) (q : (W⊔zpowers a:Subgroup (graphCentralQuotient c i))≃*S6)
      (E : graphCentralQuotient c i≃*C2×S6),
      (∀ x:W, q ⟨x,mem_sup_left x.property⟩=(e x:S6)) ∧
      (∀ d:(W⊔zpowers a:Subgroup (graphCentralQuotient c i)), E d=(1,q d)) ∧
      (∀ x:graphCentralQuotient c i, permutationAction (E x).2=conjugationAction W e x) ∧
      (∀ x:graphCentralQuotient c i, (E x).1=1 ↔ x∈W⊔zpowers a) ∧
      (∀ x:graphCentralQuotient c i, (E x).2=1 ↔ x∈centralizer (W:Set _)) := by
  intro W a
  obtain ⟨e,S,eS,L,eL,ha,hfix,hne⟩ := source_graph_quotient_action_data c i z h R hR
  obtain ⟨hc,q,E,hq,hE,hact,hfirst,hsecond⟩ := exists_marked_product_of_fixed_four W e S eS
    (pResidual_sup_sylow_eq_top S) a ha L eL hfix hne
  exact ⟨hc,e,q,E,hq,hE,hact,hfirst,hsecond⟩

/-- Transposition coordinates for the original root, preserving its literal
residual-generated complement and both direct-factor kernels. -/
theorem source_graph_quotient_transposition_product (R : Sylow 2 (C c i)) (hR : Tf c i≤R) :
    let W := pResidual 2 (graphCentralQuotient c i)
    let a := QuotientGroup.mk' (zpowers (graphInCentralizer c i))
      (sourceRootInGraphCentralizer c i z h)
    Nat.card (centralizer (W:Set (graphCentralQuotient c i)))=2 ∧
    ∃ (e : W≃*A6) (q : (W⊔zpowers a:Subgroup (graphCentralQuotient c i))≃*S6)
      (E : graphCentralQuotient c i≃*C2×S6) (s : S6), s.IsSwap ∧ E a=(1,s) ∧
      (∀ x:W, q ⟨x,mem_sup_left x.property⟩=(e x:S6)) ∧
      (∀ d:(W⊔zpowers a:Subgroup (graphCentralQuotient c i)), E d=(1,q d)) ∧
      (∀ x:graphCentralQuotient c i, permutationAction (E x).2=conjugationAction W e x) ∧
      (∀ x:graphCentralQuotient c i, (E x).1=1 ↔ x∈W⊔zpowers a) ∧
      (∀ x:graphCentralQuotient c i, (E x).2=1 ↔ x∈centralizer (W:Set _)) := by
  intro W a
  obtain ⟨e,S,eS,L,eL,ha,hfix,hne⟩ := source_graph_quotient_action_data c i z h R hR
  exact exists_transposition_product_of_fixed_four W e S eS
    (pResidual_sup_sylow_eq_top S) a ha L eL hfix hne

end CFSG.Quasithin.ChapterF.Section05.ExceptionalLocal
