module

public import CFSG.Quasithin.ChapterF.Section06.Elementary.Rigidity.Local
public import CFSG.Quasithin.ChapterF.Section06.Elementary.Quotient
public import Mathlib.GroupTheory.IndexNormal

/-!
# A degree-six action in the exceptional Goldschmidt branch

Let G be generated by a genuine Goldschmidt triple with trivial two-core.
If the first local two-core Q centralizes the first local two-residual,
then Q has trivial normal core in the opposite vertex. Indeed that normal
core is normalized by the common Sylow subgroup and centralized by the
first residual; together they generate the first vertex. The common-normal
core theorem then makes it trivial.

Q has index six in the opposite vertex, whose faithful coset action makes
its order divide 6!=720. The common Sylow is a two-group, so its order
divides 16. The last theorem applies this to the original images in G/O₂(G),
retaining the literal quotient map and overlap. Local core--residual
centralization is supplied separately by the exceptional-vertex reduction;
no amalgam recognition or characteristic-two hypothesis on the opposite
vertex is used in this argument.

Source: Aschbacher--Smith, F.6.5 exceptional branch, printed pp.304--305.
This supplies the small-order input to recognition of the exceptional
amalgams and, through their parent, the order obstruction in 14.7.70.
-/

public section
open Subgroup
namespace CFSG.Quasithin.ChapterF
variable {G : Type*} [Group G] [Finite G] {G₁ G₂ : Subgroup G}

private theorem opposite_local_core_index_six (h : IsGoldschmidtTriple G₁ G₂) :
    (((pCore 2 G₁).map G₁.subtype).subgroupOf G₂).index = 6 := by
  let S := G₁ ⊓ G₂
  let Q₁ := (pCore 2 G₁).map G₁.subtype
  let Q₂ := (pCore 2 G₂).map G₂.subtype
  have hQ₂S : Q₂ ≤ S := by
    simpa only [inf_comm G₂ G₁] using h.symm.local_twoCore_le_intersection
  have hi₂ : Q₂.relIndex S = 2 := by
    simpa only [inf_comm G₂ G₁] using h.symm.left_core_index
  have hcoreIndex : (pCore 2 G₂).index = 6 := by
    change Nat.card (G₂ ⧸ pCore 2 G₂) = 6
    rw [Nat.card_congr h.quotient_right.some.toEquiv]
    simp [Nat.card_eq_fintype_card, Fintype.card_perm, Nat.factorial]
  have hiG₂ : Q₂.relIndex G₂ = 6 := by
    have hh := relIndex_map_map_of_injective (pCore 2 G₂) (⊤ : Subgroup G₂)
      G₂.subtype_injective
    rw [← MonoidHom.range_eq_map, range_subtype, relIndex_top_right] at hh
    exact hh.trans hcoreIndex
  have hiS : S.relIndex G₂ = 3 := by
    have hh := relIndex_mul_relIndex Q₂ S G₂ hQ₂S inf_le_right
    rw [hi₂, hiG₂] at hh
    omega
  have hh := relIndex_mul_relIndex Q₁ S G₂ h.local_twoCore_le_intersection inf_le_right
  rw [h.left_core_index, hiS] at hh
  exact hh.symm

/-- The first local core is core-free in the opposite vertex. -/
theorem IsGoldschmidtTriple.opposite_core_normalCore_eq_bot
    (h : IsGoldschmidtTriple G₁ G₂) (hcore : pCore 2 G = ⊥)
    (hcent : (pCore 2 G₁).map G₁.subtype ≤
      centralizer ((pResidual 2 G₁).map G₁.subtype : Set G)) :
    (((pCore 2 G₁).map G₁.subtype).subgroupOf G₂).normalCore = ⊥ := by
  let Q := (pCore 2 G₁).map G₁.subtype
  let P := Q.subgroupOf G₂
  let N := P.normalCore.map G₂.subtype
  have hNQ : N ≤ Q := by
    have hh := map_mono (f := G₂.subtype) P.normalCore_le
    rwa [map_subgroupOf_eq_of_le
      (h.local_twoCore_le_intersection.trans inf_le_right)] at hh
  have hNT : N ≤ G₁ ⊓ G₂ := hNQ.trans h.local_twoCore_le_intersection
  have hG₂N : G₂ ≤ normalizer (N : Set G) := by
    have hh := P.normalCore.le_normalizer_map G₂.subtype
    simpa only [normalizer_eq_top, ← MonoidHom.range_eq_map, range_subtype] using hh
  have hG₁N : G₁ ≤ normalizer (N : Set G) := by
    rw [← h.left_residual_sup_intersection]
    exact sup_le
      ((le_centralizer_iff.mp (hNQ.trans hcent)).trans (centralizer_le_normalizer _))
      (inf_le_right.trans hG₂N)
  have hNbot : N = ⊥ := h.common_normal_eq_bot hcore N hNT
    (normal_subgroupOf_of_le_normalizer hG₁N)
    (normal_subgroupOf_of_le_normalizer hG₂N)
  exact (map_eq_bot_iff_of_injective _ (f := G₂.subtype) G₂.subtype_injective).mp hNbot

/-- The opposite vertex has a faithful action on six cosets. -/
theorem IsGoldschmidtTriple.opposite_card_dvd_factorial_six
    (h : IsGoldschmidtTriple G₁ G₂) (hcore : pCore 2 G = ⊥)
    (hcent : (pCore 2 G₁).map G₁.subtype ≤
      centralizer ((pResidual 2 G₁).map G₁.subtype : Set G)) :
    Nat.card G₂ ∣ 720 := by
  let P := ((pCore 2 G₁).map G₁.subtype).subgroupOf G₂
  have hd : P.normalCore.index ∣ P.index.factorial := by
    rw [normalCore_eq_ker, index_ker, index_eq_card, ← Nat.card_perm]
    exact card_subgroup_dvd_card (MulAction.toPermHom G₂ (G₂ ⧸ P)).range
  rw [h.opposite_core_normalCore_eq_bot hcore hcent, index_bot,
    opposite_local_core_index_six h] at hd
  norm_num [Nat.factorial] at hd
  exact hd

/-- The common Sylow order divides the two-part of 6!. -/
theorem IsGoldschmidtTriple.intersection_card_dvd_sixteen_of_core_centralizes_residual
    (h : IsGoldschmidtTriple G₁ G₂) (hcore : pCore 2 G = ⊥)
    (hcent : (pCore 2 G₁).map G₁.subtype ≤
      centralizer ((pResidual 2 G₁).map G₁.subtype : Set G)) :
    Nat.card (G₁ ⊓ G₂ : Subgroup G) ∣ 16 := by
  let S := G₁ ⊓ G₂
  have hd : Nat.card S ∣ 720 :=
    (card_dvd_of_le (show S ≤ G₂ from inf_le_right)).trans
      (h.opposite_card_dvd_factorial_six hcore hcent)
  obtain ⟨T, hT⟩ := h.intersection_sylow
  have hS : IsPGroup 2 S := by
    change IsPGroup 2 (G₁ ⊓ G₂ : Subgroup G)
    rw [hT]
    exact T.isPGroup'
  obtain ⟨n, hn⟩ := hS.exists_card_eq
  have hc : Nat.Coprime (Nat.card S) 45 := by
    rw [hn]
    exact (by decide : Nat.Coprime 2 45).pow_left n
  apply hc.dvd_mul_right.mp
  norm_num
  exact hd

/-- The exceptional-branch common Sylow has order at most sixteen. -/
theorem IsGoldschmidtTriple.intersection_card_le_sixteen_of_core_centralizes_residual
    (h : IsGoldschmidtTriple G₁ G₂) (hcore : pCore 2 G = ⊥)
    (hcent : (pCore 2 G₁).map G₁.subtype ≤
      centralizer ((pResidual 2 G₁).map G₁.subtype : Set G)) :
    Nat.card (G₁ ⊓ G₂ : Subgroup G) ≤ 16 :=
  Nat.le_of_dvd (by decide) (h.intersection_card_dvd_sixteen_of_core_centralizes_residual hcore hcent)

/-- Apply the bound to the actual quotient images and the original overlap. -/
theorem IsGoldschmidtTriple.quotient_intersection_card_le_sixteen_of_core_centralizes_residual
    (h : IsGoldschmidtTriple G₁ G₂)
    (hcent :
      let q := QuotientGroup.mk' (pCore 2 G)
      let A := G₁.map q
      (pCore 2 A).map A.subtype ≤
        centralizer ((pResidual 2 A).map A.subtype : Set (G ⧸ pCore 2 G))) :
    Nat.card ((G₁ ⊓ G₂).map (QuotientGroup.mk' (pCore 2 G))) ≤ 16 := by
  rw [h.quotient_twoCore_intersection]
  exact h.quotient_twoCore.intersection_card_le_sixteen_of_core_centralizes_residual
    h.quotient_twoCore_eq_bot hcent

end CFSG.Quasithin.ChapterF
