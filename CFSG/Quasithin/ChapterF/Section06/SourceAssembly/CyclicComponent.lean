module

public import CFSG.Quasithin.ChapterF.Section06.Cyclic.SourceImplication
public import CFSG.Quasithin.ChapterF.Section06.Noncyclic.SourceImplication.ThreeResidual
public import Theory.GroupTheory.PResidual.CommutatorImage
public import Theory.GroupTheory.GeneralizedFitting.CentralizerViaCComponents
public import Theory.GroupTheory.CyclicNormalCentralizer
public import Theory.GroupTheory.Fitting.Core

/-!
# A genuine component in the cyclic-three-core branch

A local S₃ quotient has its two-residual generated by commutators. Lifting
through the two-core and joining both local residuals puts O²(G) in G′.
If F*(G)=O₃(G) were cyclic, self-centralization would put O²(G) inside this
cyclic three-group. Its two distinct cubic local residuals then coincide:
a cyclic group has at most three roots of x³=1. This contradicts the
Goldschmidt Sylow intersection and constructs a genuine component.

The quotient consumer derives O₃′(G)=1 from the original quotient map.
No component catalogue, normalizer classification or recognition premise
is needed in this first step of the cyclic branch.

Source: Aschbacher–Smith, combined manuscript (1 March 2004),
F.6.17, first paragraph, printed p.309 (PDF p.320).
-/

@[expose] public section
open Subgroup Theory.GroupTheory
open scoped commutatorElement
namespace CFSG.Quasithin.ChapterF.Cyclic
private theorem three_derived_commutator :
    commutator (Equiv.Perm (Fin 3)) =
      ⁅commutator (Equiv.Perm (Fin 3)), (⊤ : Subgroup (Equiv.Perm (Fin 3)))⁆ := by
  let a := Equiv.swap (0 : Fin 3) 1
  let b := Equiv.swap (1 : Fin 3) 2
  let r := ⁅a,b⁆
  have hr : r ∈ commutator (Equiv.Perm (Fin 3)) :=
    commutator_mem_commutator (mem_top a) (mem_top b)
  have hs : ⁅r,a⁆ = r⁻¹ := by decide +kernel
  have hmem : r ∈ ⁅commutator (Equiv.Perm (Fin 3)), (⊤ : Subgroup (Equiv.Perm (Fin 3)))⁆ := by
    have hi := commutator_mem_commutator hr (mem_top a)
    rw [hs] at hi
    simpa using inv_mem hi
  apply le_antisymm ?_ (commutator_le_left _ _)
  rw [commutator_def]
  apply commutator_le.mpr
  have hcases : ∀ x y : Equiv.Perm (Fin 3),
      ⁅x,y⁆ = 1 ∨ ⁅x,y⁆ = r ∨ ⁅x,y⁆ = r ^ 2 := by decide +kernel
  intro x _ y _
  rcases hcases x y with hh | hh | hh
  · rw [hh]; exact one_mem _
  · rw [hh]; exact hmem
  · rw [hh]; exact pow_mem hmem _

variable {G : Type*} [Group G] [Finite G]

/-- A group with S₃ quotient over O₂ has its two-residual inside its derived subgroup. -/
theorem residual_le_derived_of_symmetric_three
    (e : (G ⧸ pCore 2 G) ≃* Equiv.Perm (Fin 3)) :
    pResidual 2 G ≤ commutator G := by
  have hh : pResidual 2 G = ⁅pResidual 2 G, (⊤ : Subgroup G)⁆ := by
    apply pResidual_eq_commutator_of_quotient
    rw [map_pResidual_of_surjective 2 _ (QuotientGroup.mk'_surjective _),
      map_top_of_surjective _ (QuotientGroup.mk'_surjective _)]
    apply map_injective (f := e.toMonoidHom) e.injective
    rw [map_commutator, map_pResidual,
      map_top_of_surjective _ e.surjective, (residual_of_symmetricThree (MulEquiv.refl _)).1]
    exact three_derived_commutator
  rw [hh, commutator_def]
  exact commutator_mono le_top le_rfl

variable {G₁ G₂ : Subgroup G}
/-- Both original local residuals generate the ambient two-residual. -/
theorem triple_residual_le_derived (h : IsGoldschmidtTriple G₁ G₂) :
    pResidual 2 G ≤ commutator G := by
  rw [h.twoResidual_eq_sup]
  apply sup_le
  · obtain ⟨e⟩ := h.quotient_left
    exact (map_mono (f := G₁.subtype) (residual_le_derived_of_symmetric_three e)).trans
      (by rw [map_subtype_commutator, commutator_def]; exact commutator_mono le_top le_top)
  · obtain ⟨e⟩ := h.quotient_right
    exact (map_mono (f := G₂.subtype) (residual_le_derived_of_symmetric_three e)).trans
      (by rw [map_subtype_commutator, commutator_def]; exact commutator_mono le_top le_top)


/-- A Goldschmidt triple cannot have cyclic three-group two-residual. -/
theorem not_cyclic_three_residual (h : IsGoldschmidtTriple G₁ G₂)
    (hp : IsPGroup 3 (pResidual 2 G)) (hc : IsCyclic (pResidual 2 G)) : False := by
  let L := pResidual 2 G
  let A := ((pResidual 2 G₁).map G₁.subtype).subgroupOf L
  let B := ((pResidual 2 G₂).map G₂.subtype).subgroupOf L
  have hAL : (pResidual 2 G₁).map G₁.subtype ≤ L := map_pResidual_le 2 G₁.subtype
  have hBL : (pResidual 2 G₂).map G₂.subtype ≤ L := map_pResidual_le 2 G₂.subtype
  have hA : Nat.card A = 3 :=
    (Nat.card_congr (subgroupOfEquivOfLe hAL).toEquiv).trans
      (Noncyclic.local_residual_card_three h hp)
  have hB : Nat.card B = 3 :=
    (Nat.card_congr (subgroupOfEquivOfLe hBL).toEquiv).trans
      (Noncyclic.local_residual_card_three h.symm hp)
  let : IsCyclic L := hc
  let : CommGroup L := IsCyclic.commGroup
  let K := (powMonoidHom 3 : L →* L).ker
  have hAK : A ≤ K := by
    intro x hx
    change x ^ 3 = 1
    rw [← hA]
    exact congrArg Subtype.val (pow_card_eq_one' (x := (⟨x,hx⟩ : A)))
  have hBK : B ≤ K := by
    intro x hx
    change x ^ 3 = 1
    rw [← hB]
    exact congrArg Subtype.val (pow_card_eq_one' (x := (⟨x,hx⟩ : B)))
  have hK : Nat.card K ≤ 3 := by
    rw [IsCyclic.card_powMonoidHom_ker]
    exact Nat.gcd_le_right _ (by decide)
  have he : A = B := (eq_of_le_of_card_ge hAK (hA.symm ▸ hK)).trans
    (eq_of_le_of_card_ge hBK (hB.symm ▸ hK)).symm
  have he' := congrArg (fun S : Subgroup L => S.map L.subtype) he
  rw [map_subgroupOf_eq_of_le hAL, map_subgroupOf_eq_of_le hBL] at he'
  exact h.embedded_twoResidual_ne he'

/-- The cyclic three-core forces a genuine component, with no model recognition input. -/
theorem exists_component_of_cyclic_three_core (h : IsGoldschmidtTriple G₁ G₂)
    (hprime : pPrimeCore 3 G = ⊥) (hcyclic : IsCyclic (pCore 3 G)) :
    ∃ K : Subgroup G, IsComponent G K ∧ ¬ K ≤ pCore 3 G := by
  have hfit : fittingSubgroup G ≤ pCore 3 G := (Fitting_eq_pcore G 3 hprime).le
  apply exists_component_of_generalizedFitting_not_le_primeCore hfit
  intro hle
  have heq : generalizedFitting G = pCore 3 G := le_antisymm hle
    ((pCore_le_fitting G 3).trans (fitting_le_generalizedFitting G))
  let : IsCyclic (pCore 3 G) := hcyclic
  have hL : pResidual 2 G ≤ pCore 3 G := by
    have hh := (triple_residual_le_derived h).trans
      (commutator_le_centralizer_of_isCyclic_normal (pCore 3 G))
    have hcent := centralizer_generalizedFitting_le G
    rw [heq] at hcent
    exact hh.trans hcent
  exact not_cyclic_three_residual h (pCore_isPGroup.to_le hL) (isCyclic_of_le hL)

/-- The original prime-to-three quotient supplies the core hypothesis of the
component construction; the covering group's additional K/rank hypotheses
are not needed for this step. -/
theorem exists_component_of_cyclic_three_core_quotient
    {Ghat : Type*} [Group Ghat] [Finite Ghat]
    (e : G ≃* (Ghat ⧸ pPrimeCore 3 Ghat))
    (h : IsGoldschmidtTriple G₁ G₂) (hcyclic : IsCyclic (pCore 3 G)) :
    ∃ K : Subgroup G, IsComponent G K ∧ ¬ K ≤ pCore 3 G :=
  exists_component_of_cyclic_three_core h
    (Noncyclic.primeToThreeCore_eq_bot_of_quotient e) hcyclic

end CFSG.Quasithin.ChapterF.Cyclic
