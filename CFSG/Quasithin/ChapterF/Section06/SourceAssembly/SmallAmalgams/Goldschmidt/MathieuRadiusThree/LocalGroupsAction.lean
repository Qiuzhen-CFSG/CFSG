module

public import CFSG.Quasithin.ChapterF.Section06.SourceAssembly.SmallAmalgams.Goldschmidt.MathieuRadiusThree.Contracts
public import CFSG.Quasithin.ChapterF.Section06.SourceAssembly.SmallAmalgams.Goldschmidt.MathieuRadiusThree.LocalRelationsAction
public import Theory.SpecificGroups.SymmetricSix.Parabolics.TwoCores.Syntheme.EvenNormal

/-!
# The action generated by the radius-four source labels

The group generated by the radius-four labels is normal in its actual
vertex stabilizer. A label on the fourth sphere interchanges two branches,
so its normal image is the entire tetrahedral radius-two action. Therefore
this generated source group covers the vertex stabilizer modulo the literal
radius-two ball kernel.

This is the generation half of Goldschmidt (1980), (6.12.6), printed p.405.
The separate upper bound on the kernel is still needed for recognition.
-/

@[expose] public section
noncomputable section
namespace CFSG.Quasithin.ChapterF.SourceAssembly.Goldschmidt.MathieuRadiusThree
open Subgroup SimpleGraph Theory.GroupAction.CubicTree
open Subgroup.CosetGeometry
open Theory.SpecificGroups.SymmetricSix.SynthemeCalculation
variable {G : Type*} [Group G] {F : Bool → Subgroup G} {s : ℕ}

private theorem evenModel_transitive : ∀ x y : Fin 3 × ZMod 2,
    ∃ g : evenModel, coordinateHom g.val x = y := by
  decide +kernel

/-- Every actual radius-two action is already induced by a product of
radius-four labels. The representatives stay in the original stabilizer. -/
theorem LocalRelations.radiusFour_action_surjective
    {h : LargeTreeSource F s} {d : CanonicalLabelSetup F s}
    (r : LocalRelations h d) (hr : d.radius = 3)
    {a : RankTwo.Vertex F} (ha : a.type = d.side) (f : BranchFrame F a)
    (g : RankTwo.stabilizer F a) :
    ∃ k : RankTwo.stabilizer F a, k.val ∈ d.labelBall a 4 ∧
      f.blockAction h.action.toCubicTreeAction k =
        f.blockAction h.action.toCubicTreeAction g := by
  let H := RankTwo.stabilizer F a
  let K := (d.labelBall a 4).subgroupOf H
  let : K.Normal := d.labelBall_normal a 4 (by omega) (by have := h.five_le; omega)
  have heven := f.blockAction_even_of_labelBall_card_eight h d hr ha (r.labelBall_card a ha)
  let ψ : H →* evenModel := (f.blockAction h.action.toCubicTreeAction).codRestrict evenModel
    (fun x => heven ⟨x, rfl⟩)
  have hψ : Function.Surjective ψ := by
    rintro ⟨x, hx⟩
    rw [← f.blockAction_eq_evenModel_of_even h heven] at hx
    obtain ⟨g, hg⟩ := hx
    exact ⟨g, Subtype.ext hg⟩
  let N := K.map ψ
  let : N.Normal := Subgroup.Normal.map inferInstance ψ hψ
  obtain ⟨z, hz, hs, _⟩ := f.exists_label_even_swap h d hr ha
  have hN : N = ⊤ := evenModel_normal_eq_top_of_block_swap N
    (mem_map_of_mem ψ (show z ∈ K from hz)) hs
  have hg : ψ g ∈ N := hN ▸ mem_top _
  obtain ⟨k, hk, he⟩ := hg
  exact ⟨k, hk, congrArg Subtype.val he⟩

/-- The six source eight-groups lie in one conjugacy orbit under the
radius-four label group itself. -/
theorem LocalRelations.radiusFour_sphere_transitive
    {h : LargeTreeSource F s} {d : CanonicalLabelSetup F s}
    (r : LocalRelations h d) (hr : d.radius = 3)
    {a : RankTwo.Vertex F} (ha : a.type = d.side) (f : BranchFrame F a)
    (x y : Fin 3 × ZMod 2) :
    ∃ k : RankTwo.stabilizer F a, k.val ∈ d.labelBall a 4 ∧
      k.val • f.point x = f.point y := by
  obtain ⟨u, hu⟩ := evenModel_transitive x y
  have heven := f.blockAction_even_of_labelBall_card_eight h d hr ha (r.labelBall_card a ha)
  have hu' : u.val ∈ (f.blockAction h.action.toCubicTreeAction).range :=
    (f.blockAction_eq_evenModel_of_even h heven).symm ▸ u.property
  obtain ⟨g, hg⟩ := hu'
  obtain ⟨k, hk, hkg⟩ := r.radiusFour_action_surjective hr ha f g
  refine ⟨k, hk, ?_⟩
  rw [← f.sphereAction_eval h.action.toCubicTreeAction k,
    ← f.blockAction_coordinates, hkg, hg, hu]

/-- The generated radius-four group covers the original vertex stabilizer
modulo the actual ball kernel, rather than an abstract action kernel. -/
theorem LocalRelations.radiusFour_sup_radiusTwoKernel
    {h : LargeTreeSource F s} {d : CanonicalLabelSetup F s}
    (r : LocalRelations h d) (hr : d.radius = 3)
    (a : RankTwo.Vertex F) (ha : a.type = d.side) :
    d.labelBall a 4 ⊔ RankTwo.ballKernel F a 2 = RankTwo.stabilizer F a := by
  obtain ⟨f⟩ := h.action.toCubicTreeAction.exists_branchFrame a
  apply le_antisymm
  · exact sup_le (d.labelBall_le_stabilizer a 4 (by omega) (by have := h.five_le; omega))
      (RankTwo.ballKernel_le_stabilizer F a 2)
  · intro g hg
    obtain ⟨k, hk, he⟩ := r.radiusFour_action_surjective hr ha f ⟨g, hg⟩
    have hx : (⟨g, hg⟩ : RankTwo.stabilizer F a) * k⁻¹ ∈
        (f.blockAction h.action.toCubicTreeAction).ker := by
      change f.blockAction h.action.toCubicTreeAction (⟨g, hg⟩ * k⁻¹) = 1
      rw [map_mul, map_inv, he, mul_inv_cancel]
    rw [f.blockAction_ker h.action.toCubicTreeAction] at hx
    have hm : g * k.val⁻¹ ∈ RankTwo.ballKernel F a 2 := hx
    have hh := (d.labelBall a 4 ⊔ RankTwo.ballKernel F a 2).mul_mem
      (mem_sup_right hm) (mem_sup_left hk)
    simpa only [inv_mul_cancel_right] using hh

/-- The source generated group has at least the order of the M₁₂ endpoint:
its kernel contains the actual eight-group and its action has order 24. -/
theorem LocalRelations.radiusFour_card_ge
    {h : LargeTreeSource F s} {d : CanonicalLabelSetup F s}
    (r : LocalRelations h d) (hr : d.radius = 3)
    (a : RankTwo.Vertex F) (ha : a.type = d.side) :
    192 ≤ Nat.card (d.labelBall a 4) := by
  obtain ⟨f⟩ := h.action.toCubicTreeAction.exists_branchFrame a
  let K := d.labelBall a 4
  have hK : K ≤ RankTwo.stabilizer F a :=
    d.labelBall_le_stabilizer a 4 (by omega) (by have := h.five_le; omega)
  let : Finite (RankTwo.stabilizer F a) := h.action.finite_stabilizer a
  let : Finite K := Finite.of_injective (Subgroup.inclusion hK) (Subgroup.inclusion_injective hK)
  let φ := (f.blockAction h.action.toCubicTreeAction).comp (Subgroup.inclusion hK)
  have hrange : φ.range = (f.blockAction h.action.toCubicTreeAction).range := by
    apply le_antisymm
    · rintro _ ⟨k, rfl⟩
      exact ⟨Subgroup.inclusion hK k, rfl⟩
    · rintro _ ⟨g, rfl⟩
      obtain ⟨k, hk, he⟩ := r.radiusFour_action_surjective hr ha f g
      exact ⟨⟨k.val, hk⟩, he⟩
  have hrcard : Nat.card φ.range = 24 := by
    rw [hrange]
    obtain ⟨e⟩ := r.action_image a ha f
    rw [Nat.card_congr e.toEquiv, Nat.card_perm, Nat.card_fin]
    decide
  have hAK : d.labelBall a 2 ≤ K := by
    apply Subgroup.closure_mono
    rintro _ ⟨w, ⟨hw, hd⟩, rfl⟩
    exact ⟨w, ⟨hw, by omega⟩, rfl⟩
  let A := (d.labelBall a 2).subgroupOf K
  have hA : Nat.card A = 8 :=
    (Nat.card_congr (subgroupOfEquivOfLe hAK).toEquiv).trans (r.labelBall_card a ha)
  have haker : A ≤ φ.ker := by
    intro x hx
    have hh : Subgroup.inclusion hK x ∈
        (RankTwo.ballKernel F a 2).subgroupOf (RankTwo.stabilizer F a) :=
      d.labelBall_le_ballKernel h.action.toCubicTreeAction a 2 2
        (by omega) (by have := h.five_le; omega) hx
    rw [← f.blockAction_ker h.action.toCubicTreeAction] at hh
    exact hh
  have hker : 8 ≤ Nat.card φ.ker := by
    rw [← hA]
    exact Nat.card_le_card_of_injective (Subgroup.inclusion haker) (Subgroup.inclusion_injective haker)
  have hcard := φ.ker.card_mul_index
  rw [Subgroup.index_ker, hrcard] at hcard
  change 192 ≤ Nat.card K
  omega

end CFSG.Quasithin.ChapterF.SourceAssembly.Goldschmidt.MathieuRadiusThree
