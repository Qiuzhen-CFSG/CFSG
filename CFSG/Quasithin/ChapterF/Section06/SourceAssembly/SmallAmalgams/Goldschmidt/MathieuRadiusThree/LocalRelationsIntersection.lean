module

public import CFSG.Quasithin.ChapterF.Section06.SourceAssembly.SmallAmalgams.Goldschmidt.MathieuRadiusThree.LocalRelationsCommutator
public import CFSG.Quasithin.ChapterF.Section06.SourceAssembly.SmallAmalgams.Goldschmidt.MathieuRadiusThree.LocalRelationsLabels
public import Theory.GroupTheory.SpecificGroups.KleinFourGenerators
/-!
# The four-group intersection forced by an odd local action

Two nearby radius-two label groups have order at most sixteen and normalize
one another. If their commutator contains both center labels, the large-
intersection bound forces their entire intersection to be the four-group
generated by those labels. This is the actual intersection calculation in
Goldschmidt (1980), the paragraph preceding (6.12.3), printed p.404.
-/

@[expose] public section
noncomputable section
open Subgroup SimpleGraph Theory.GroupAction.CubicTree
open Subgroup.CosetGeometry
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.ChapterF.SourceAssembly.Goldschmidt
variable {G : Type*} [Group G] {F : Bool → Subgroup G} {s : ℕ}
/-- The two center labels exhaust both the intersection and the commutator. -/
theorem CanonicalLabelSetup.nearby_labelBall_intersection_eq_pair_of_labels_mem_commutator
    (d : CanonicalLabelSetup F s) (h : LargeTreeSource F s)
    (hr : d.radius = 3) {a b : RankTwo.Vertex F}
    (ha : a.type = d.side) (hb : b.type = d.side) (hne : a ≠ b)
    (hab : (RankTwo.graph F).dist a b ≤ 2)
    (hza : d.label a ∈ ⁅d.labelBall a 2, d.labelBall b 2⁆)
    (hzb : d.label b ∈ ⁅d.labelBall a 2, d.labelBall b 2⁆) :
    d.labelBall a 2 ⊓ d.labelBall b 2 = closure ({d.label a, d.label b} : Set G) ∧
      ⁅d.labelBall a 2, d.labelBall b 2⁆ = closure ({d.label a, d.label b} : Set G) := by
  let A := d.labelBall a 2
  let B := d.labelBall b 2
  let I := A ⊓ B
  let D := ⁅A,B⁆
  let W := closure ({d.label a, d.label b} : Set G)
  have hs : 4 ≤ s := by have := h.five_le; omega
  let : IsElementaryAbelian 2 A := (d.radiusTwo_card_le h.action.toCubicTreeAction (by omega) hs a ha).1
  let : Finite (RankTwo.stabilizer F a) := h.action.finite_stabilizer a
  let : Finite A := Finite.of_injective
    (Subgroup.inclusion (d.labelBall_le_stabilizer a 2 (by omega) (by omega)))
    (Subgroup.inclusion_injective _)
  let : Finite I := Finite.of_injective
    (Subgroup.inclusion (show I ≤ A from inf_le_left)) (Subgroup.inclusion_injective _)
  have hDI : D ≤ I := d.nearby_labelBall_commutator_le h.action.toCubicTreeAction hr hs hab
  let : Finite D := Finite.of_injective (Subgroup.inclusion hDI) (Subgroup.inclusion_injective _)
  have hcomm := d.labels_commute_of_dist_le ha hb (by omega) (by omega)
  let : IsKleinFour W := isKleinFour_closure_pair_of_orderOf _ _ (d.order_two a ha)
    (d.order_two b hb) (d.label_ne_of_short_dist h ha hb hne (by omega)) hcomm
  have hWcard : Nat.card W = 4 := IsKleinFour.card_four
  have hWD : W ≤ D := by
    apply (closure_le _).mpr
    intro x hx
    rcases Set.mem_insert_iff.mp hx with rfl | hx
    · exact hza
    · exact Set.mem_singleton_iff.mp hx ▸ hzb
  have hfour : 4 ≤ Nat.card D := by
    rw [← hWcard]
    exact Nat.card_le_card_of_injective (Subgroup.inclusion hWD) (Subgroup.inclusion_injective _)
  have hsmall : Nat.card I < 8 := by
    by_contra hn
    have hc := d.nearby_labelBall_commutator_card_le_two_of_eight_le_intersection
      h.action.toCubicTreeAction hr hs ha hb hab (show 8 ≤ Nat.card I by omega)
    change Nat.card D ≤ 2 at hc
    omega
  have hp : IsPGroup 2 I := (IsElementaryAbelian.isPGroup 2 A).of_injective
    (Subgroup.inclusion (show I ≤ A from inf_le_left)) (Subgroup.inclusion_injective _)
  obtain ⟨n,hn⟩ := hp.exists_card_eq
  have hnlt : n < 3 := by
    by_contra hh
    have hp := Nat.pow_le_pow_right (by decide : 0 < 2) (by omega : 3 ≤ n)
    rw [← hn] at hp
    omega
  have hIle : Nat.card I ≤ 4 := by
    rw [hn]
    interval_cases n <;> decide
  have hWI : W = I := eq_of_le_of_card_ge (hWD.trans hDI) (by omega)
  have hWD' : W = D := eq_of_le_of_card_ge hWD
    ((Nat.card_le_card_of_injective (Subgroup.inclusion hDI) (Subgroup.inclusion_injective _)).trans (by omega))
  exact ⟨hWI.symm, hWD'.symm⟩
end CFSG.Quasithin.ChapterF.SourceAssembly.Goldschmidt
