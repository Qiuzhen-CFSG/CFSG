module

public import CFSG.Quasithin.ChapterF.Section06.SourceAssembly.SmallAmalgams.Goldschmidt.MathieuRadiusThree.LocalRelationsOrder
public import CFSG.Quasithin.ChapterF.Section06.SourceAssembly.SmallAmalgams.Goldschmidt.CanonicalBranchAction

/-!
# The six source eight-groups generating the radius-four group

Every label within four steps of a labeled vertex belongs to one of the
radius-two groups centered at its six distance-two vertices. These six
groups are permuted by conjugation exactly as the six vertices are permuted
by the original stabilizer. Passing to the quotient by the central
radius-two group gives the six reflection groups in (6.12.6).

Source: Goldschmidt (1980), printed p.405.
-/

public section
namespace CFSG.Quasithin.ChapterF.SourceAssembly.Goldschmidt.MathieuRadiusThree
open Subgroup SimpleGraph Theory.GroupAction.CubicTree
open Subgroup.CosetGeometry
variable {G : Type*} [Group G] {F : Bool → Subgroup G} {s : ℕ}

/-- The radius-four source group is generated by its six nearby label groups. -/
theorem radiusFour_eq_iSup_radiusTwo (d : CanonicalLabelSetup F s)
    (h : CubicTreeAction F) {a : RankTwo.Vertex F} (ha : a.type = d.side)
    (f : BranchFrame F a) :
    d.labelBall a 4 = ⨆ x : Fin 3 × ZMod 2, d.labelBall (f.point x) 2 := by
  let J := ⨆ x : Fin 3 × ZMod 2, d.labelBall (f.point x) 2
  apply le_antisymm
  · apply (closure_le _).mpr
    rintro _ ⟨w, ⟨hw, hd⟩, rfl⟩
    have he := (RankTwo.even_dist_iff F h.generated a w).mpr (ha.trans hw.symm)
    have hcases : (RankTwo.graph F).dist a w = 0 ∨
        (RankTwo.graph F).dist a w = 2 ∨ (RankTwo.graph F).dist a w = 4 := by
      obtain ⟨k, hk⟩ := he
      omega
    rcases hcases with hzero | htwo | hfour
    · have hwa : w = a := (h.tree.connected.dist_eq_zero_iff.mp hzero).symm
      subst w
      apply (le_iSup (fun x : Fin 3 × ZMod 2 => d.labelBall (f.point x) 2) (0,0))
      exact d.label_mem_labelBall ha (by rw [dist_comm, f.point_dist h])
    · obtain ⟨x, hx⟩ := (f.sphereEquiv h).surjective ⟨w, htwo⟩
      have hx' : f.point x = w := congrArg Subtype.val hx
      apply (le_iSup (fun x : Fin 3 × ZMod 2 => d.labelBall (f.point x) 2) x)
      exact d.label_mem_labelBall hw (by rw [hx', dist_self]; omega)
    · obtain ⟨p, hp⟩ := h.tree.connected.exists_walk_length_eq_dist a w
      have hp4 : p.length = 4 := hp.trans hfour
      have hleft : (RankTwo.graph F).dist a (p.getVert 2) ≤ 2 := by
        have hh := dist_le (p.take 2)
        simpa only [Walk.take_length, hp4, show (2 : ℕ) ⊓ 4 = 2 from rfl] using hh
      have hright : (RankTwo.graph F).dist (p.getVert 2) w ≤ 2 := by
        have hh := dist_le (p.drop 2)
        simpa only [Walk.drop_length, hp4, Nat.reduceSub] using hh
      have hmid : (RankTwo.graph F).dist a (p.getVert 2) = 2 := by
        have hh := h.tree.connected.dist_triangle (u := a) (v := p.getVert 2) (w := w)
        rw [hfour] at hh
        omega
      obtain ⟨x, hx⟩ := (f.sphereEquiv h).surjective ⟨p.getVert 2, hmid⟩
      have hx' : f.point x = p.getVert 2 := congrArg Subtype.val hx
      apply (le_iSup (fun x : Fin 3 × ZMod 2 => d.labelBall (f.point x) 2) x)
      exact d.label_mem_labelBall hw (hx'.symm ▸ hright)
  · apply iSup_le
    intro x
    apply (closure_le _).mpr
    rintro _ ⟨w, ⟨hw, hd⟩, rfl⟩
    apply d.label_mem_labelBall hw
    have hh := h.tree.connected.dist_triangle (u := a) (v := f.point x) (w := w)
    rw [f.point_dist h] at hh
    omega

/-- Conjugation permutes the six generating eight-groups by the literal
radius-two vertex action. -/
theorem radiusTwo_point_map_conj (d : CanonicalLabelSetup F s)
    (h : CubicTreeAction F) {a : RankTwo.Vertex F} (f : BranchFrame F a)
    (g : RankTwo.stabilizer F a) (x : Fin 3 × ZMod 2) :
    (d.labelBall (f.point x) 2).map (MulAut.conj g.val).toMonoidHom =
      d.labelBall (f.point (f.sphereAction h g x)) 2 := by
  rw [d.labelBall_map_conj, f.sphereAction_eval]

end CFSG.Quasithin.ChapterF.SourceAssembly.Goldschmidt.MathieuRadiusThree
