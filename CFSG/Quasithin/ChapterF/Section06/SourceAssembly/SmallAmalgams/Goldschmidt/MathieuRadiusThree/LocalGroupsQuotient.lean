/-!
# Eight-group intersections and the radius-four quotient

For two labelled vertices at distance two, the corresponding radius-two
label groups are distinct elementary groups of order eight, while both
contain the Klein four generated by their center labels. The six-arc
commutator makes equality impossible. Consequently their intersection has
order four and each nearby group maps to order two in the literal quotient
of the radius-four label group by the radius-two group at its center. A transported
fourth-sphere label supplies a branch-swapping involution in each nearby
group.

Source: Goldschmidt, *Automorphisms of trivalent graphs* (1980),
(6.12.5)--(6.12.6), printed pp.404--405.
-/

@[expose] public section
noncomputable section
namespace CFSG.Quasithin.ChapterF.SourceAssembly.Goldschmidt.MathieuRadiusThree
open Subgroup SimpleGraph SimpleGraph.PathTransitivePolygon
open Theory.GroupAction.CubicTree Subgroup.CosetGeometry
open scoped commutatorElement IsMulCommutative
variable {G : Type*} [Group G] {F : Bool → Subgroup G} {s : ℕ}

private theorem exists_forward (h : CubicTreeAction F) (v a : RankTwo.Vertex F) :
    ∃ u, (RankTwo.graph F).Adj v u ∧ u ≠ a := by
  by_contra! hh
  have hi : Subsingleton ((RankTwo.graph F).neighborSet v) := ⟨fun x y =>
    Subtype.ext ((hh x x.property).trans (hh y y.property).symm)⟩
  have hc : Nat.card ((RankTwo.graph F).neighborSet v) ≤ 1 := by
    let f : (RankTwo.graph F).neighborSet v → Unit := fun _ => ()
    simpa using Nat.card_le_card_of_injective f (fun x y _ => Subsingleton.elim _ _)
  rw [h.card_neighbor v] at hc
  omega

theorem LocalRelations.radiusTwo_not_le_of_dist_two
    {h : LargeTreeSource F s} {d : CanonicalLabelSetup F s}
    (r : LocalRelations h d) (hr : d.radius = 3)
    {a b : RankTwo.Vertex F} (ha : a.type = d.side) (hb : b.type = d.side)
    (hab : (RankTwo.graph F).dist a b = 2) :
    ¬ d.labelBall b 2 ≤ d.labelBall a 2 := by
  let t := h.action.toCubicTreeAction
  obtain ⟨hne, m, ham, hmb⟩ := (DistanceTwoGeometry.dist_eq_two_iff t.tree).mp hab
  obtain ⟨a1, ha1, ha1m⟩ := exists_forward t a m
  obtain ⟨a2, ha2, ha2a⟩ := exists_forward t a1 a
  obtain ⟨b1, hb1, hb1m⟩ := exists_forward t b m
  obtain ⟨b2, hb2, hb2b⟩ := exists_forward t b1 b
  let p : BasedWalk (RankTwo.graph F) 6 a2 :=
    ⟨⟨a1, ha2.symm⟩, ⟨⟨a, ha1.symm⟩, ⟨⟨m, ham⟩,
      ⟨⟨b, hmb⟩, ⟨⟨b1, hb1⟩, ⟨⟨b2, hb2⟩, PUnit.unit⟩⟩⟩⟩⟩⟩
  have hp : p.Nonbacktracking :=
    ⟨ha2a.symm, ha1m.symm, hne.symm, hb1m, hb2b, trivial⟩
  have hpath : p.toWalk.IsPath := isPath_of_nonbacktracking_of_cycle_bound
    (N := 7) (fun _ _ hc => (t.tree.isAcyclic _ hc).elim) p hp (by decide)
  have hda : (RankTwo.graph F).dist a a2 = 2 :=
    (DistanceTwoGeometry.dist_eq_two_iff t.tree).mpr ⟨ha2a.symm, a1, ha1, ha2⟩
  have hdb : (RankTwo.graph F).dist b b2 = 2 :=
    (DistanceTwoGeometry.dist_eq_two_iff t.tree).mpr ⟨hb2b.symm, b1, hb1, hb2⟩
  have hat : a2.type = d.side :=
    ((RankTwo.even_dist_iff F t.generated _ _).mp (by rw [hda]; decide)).symm.trans ha
  have hbt : b2.type = d.side :=
    ((RankTwo.even_dist_iff F t.generated _ _).mp (by rw [hdb]; decide)).symm.trans hb
  have hcomm : ⁅d.label a2,d.label b2⁆ = d.label a * d.label b :=
    r.six_arc a2 b2 p.toWalk hat hpath rfl
  let : IsElementaryAbelian 2 (d.labelBall a 2) :=
    d.labelBall_elementary t a 2 (by omega) (by have := h.five_le; omega)
  intro hle
  have hx : d.label a2 ∈ d.labelBall a 2 := d.label_mem_labelBall hat hda.le
  have hy : d.label b2 ∈ d.labelBall a 2 := hle (d.label_mem_labelBall hbt hdb.le)
  have hc : Commute (d.label a2) (d.label b2) := congrArg Subtype.val
    (mul_comm (⟨d.label a2,hx⟩ : d.labelBall a 2) (⟨d.label b2,hy⟩ : d.labelBall a 2))
  have he : d.label a = d.label b := by
    have hh := hcomm.symm.trans hc.commutator_eq
    simpa only [d.label_inv hb] using mul_eq_one_iff_eq_inv.mp hh
  exact d.label_ne_of_short_dist h ha hb hne (by have := h.five_le; omega) he

theorem LocalRelations.radiusTwo_intersection_card
    {h : LargeTreeSource F s} {d : CanonicalLabelSetup F s}
    (r : LocalRelations h d) (hr : d.radius = 3)
    {a b : RankTwo.Vertex F} (ha : a.type = d.side) (hb : b.type = d.side)
    (hab : (RankTwo.graph F).dist a b = 2) :
    Nat.card (d.labelBall a 2 ⊓ d.labelBall b 2 : Subgroup G) = 4 := by
  let A := d.labelBall a 2
  let B := d.labelBall b 2
  let I := A ⊓ B
  have hA : Nat.card A = 8 := r.labelBall_card a ha
  have hB : Nat.card B = 8 := r.labelBall_card b hb
  let : Finite A := Nat.finite_of_card_ne_zero (by rw [hA]; decide)
  let : Finite B := Nat.finite_of_card_ne_zero (by rw [hB]; decide)
  let : Finite I := Finite.of_injective (Subgroup.inclusion (show I ≤ A from inf_le_left))
    (Subgroup.inclusion_injective _)
  let W := closure ({d.label a,d.label b} : Set G)
  have hne : a ≠ b := by intro he; simp [he] at hab
  let : IsKleinFour W := isKleinFour_closure_pair_of_orderOf _ _
    (d.order_two a ha) (d.order_two b hb)
    (d.label_ne_of_short_dist h ha hb hne (by have := h.five_le; omega))
    (d.labels_commute_of_dist_le ha hb (by omega) (by have := h.five_le; omega))
  have hW : Nat.card W = 4 := IsKleinFour.card_four
  have hWI : W ≤ I := by
    apply (closure_le _).mpr
    rintro w (rfl | rfl)
    · exact ⟨d.label_mem_labelBall ha (by simp),
        d.label_mem_labelBall ha (by rw [dist_comm, hab])⟩
    · exact ⟨d.label_mem_labelBall hb hab.le, d.label_mem_labelBall hb (by simp)⟩
  have hlo : 4 ≤ Nat.card I := by
    rw [← hW]
    exact Nat.card_le_card_of_injective (Subgroup.inclusion hWI) (Subgroup.inclusion_injective _)
  have hdiv : Nat.card I ∣ 8 := by
    rw [← hA]
    exact card_dvd_of_le (show I ≤ A from inf_le_left)
  have hlt : Nat.card I < 8 := by
    have hle : Nat.card I ≤ 8 := by
      rw [← hA]
      exact Nat.card_le_card_of_injective (Subgroup.inclusion (show I ≤ A from inf_le_left))
        (Subgroup.inclusion_injective _)
    apply lt_of_le_of_ne hle
    intro he
    have hIB : I = B := eq_of_le_of_card_ge inf_le_right (by rw [hB, he])
    have hBA : B ≤ A := hIB ▸ (show I ≤ A from inf_le_left)
    exact r.radiusTwo_not_le_of_dist_two hr ha hb hab hBA
  obtain ⟨k, hk⟩ := hdiv
  have hklo : 2 ≤ k := by
    by_contra hh
    interval_cases k <;> simp_all
  have hkhi : k ≤ 2 := by nlinarith
  have hk2 : k = 2 := by omega
  change Nat.card I = 4
  rw [hk2] at hk
  omega

/-- The nearby eight-group lies in the radius-four source group. -/
theorem radiusTwo_le_radiusFour (d : CanonicalLabelSetup F s)
    (h : CubicTreeAction F) {a b : RankTwo.Vertex F}
    (hab : (RankTwo.graph F).dist a b ≤ 2) :
    d.labelBall b 2 ≤ d.labelBall a 4 := by
  apply (closure_le _).mpr
  rintro w ⟨u, ⟨hu, hd⟩, rfl⟩
  apply d.label_mem_labelBall hu
  have hh := h.tree.connected.dist_triangle (u := a) (v := b) (w := u)
  omega

/-- The original radius-two group is normal in the radius-four group. -/
theorem radiusTwo_normal_in_radiusFour (d : CanonicalLabelSetup F s)
    (h : LargeTreeSource F s) (hr : d.radius = 3) (a : RankTwo.Vertex F) :
    ((d.labelBall a 2).subgroupOf (d.labelBall a 4)).Normal := by
  apply (normal_subgroupOf_iff_le_normalizer
    (radiusTwo_le_radiusFour d h.action.toCubicTreeAction (by simp))).mpr
  exact (d.labelBall_le_stabilizer a 4 (by omega) (by have := h.five_le; omega)).trans
    (d.labelBall_normalized a 2)

/-- The image of the nearby eight-group has exactly two elements in the
literal quotient by the central eight-group. -/
theorem LocalRelations.radiusTwo_quotient_card
    {h : LargeTreeSource F s} {d : CanonicalLabelSetup F s}
    (r : LocalRelations h d) (hr : d.radius = 3)
    {a b : RankTwo.Vertex F} (ha : a.type = d.side) (hb : b.type = d.side)
    (hab : (RankTwo.graph F).dist a b = 2) :
    letI := radiusTwo_normal_in_radiusFour d h hr a
    Nat.card (((d.labelBall b 2).subgroupOf (d.labelBall a 4)).map
      (QuotientGroup.mk' ((d.labelBall a 2).subgroupOf (d.labelBall a 4)))) = 2 := by
  let K := d.labelBall a 4
  let A := (d.labelBall a 2).subgroupOf K
  let B := (d.labelBall b 2).subgroupOf K
  let : A.Normal := radiusTwo_normal_in_radiusFour d h hr a
  let π := QuotientGroup.mk' A
  change Nat.card (B.map π) = 2
  have hBK : d.labelBall b 2 ≤ K := radiusTwo_le_radiusFour d h.action.toCubicTreeAction hab.le
  have hAK : d.labelBall a 2 ≤ K := radiusTwo_le_radiusFour d h.action.toCubicTreeAction (by simp)
  have hB : Nat.card B = 8 :=
    (Nat.card_congr (subgroupOfEquivOfLe hBK).toEquiv).trans (r.labelBall_card b hb)
  have hI : Nat.card (A.subgroupOf B) = 4 := by
    have he : A.subgroupOf B = (A ⊓ B).subgroupOf B := (inf_subgroupOf_right A B).symm
    rw [he, Nat.card_congr (subgroupOfEquivOfLe (show A ⊓ B ≤ B from inf_le_right)).toEquiv]
    change Nat.card ((d.labelBall a 2 ⊓ d.labelBall b 2 : Subgroup G).subgroupOf K) = 4
    rw [Nat.card_congr (subgroupOfEquivOfLe (inf_le_left.trans hAK)).toEquiv]
    exact r.radiusTwo_intersection_card hr ha hb hab
  have hh := (A.subgroupOf B).card_mul_index
  rw [hI, hB] at hh
  have hrel : A.relIndex B = Nat.card (B.map π) := by
    simpa only [π, QuotientGroup.ker_mk'] using (Subgroup.relIndex_ker B π)
  change 4 * A.relIndex B = 8 at hh
  rw [hrel] at hh
  omega

private theorem three_involution_isSwap (σ : Equiv.Perm (Fin 3))
    (hsq : σ ^ 2 = 1) (hne : σ ≠ 1) : σ.IsSwap := by
  revert σ
  simp only [Equiv.Perm.IsSwap]
  decide +kernel

/-- Each nearby eight-group contains a label interchanging two branches
at the original vertex. This marks its quotient involution by its actual action. -/
theorem BranchFrame.exists_nearby_label_swap {a b : RankTwo.Vertex F}
    (f : BranchFrame F a) (h : LargeTreeSource F s)
    (d : CanonicalLabelSetup F s) (hr : d.radius = 3)
    (ha : a.type = d.side) (hab : (RankTwo.graph F).dist a b = 2) :
    ∃ k : RankTwo.stabilizer F a,
      k.val ∈ d.labelBall b 2 ∧ k ^ 2 = 1 ∧ (f.branchAction k).IsSwap := by
  obtain ⟨g, hga, hgb⟩ := h.exists_track_pair d ha (by have := h.five_le; omega :
    (RankTwo.graph F).dist a b ≤ s)
  rw [hab] at hgb
  let c := d.track.vertex (d.center + 2*2)
  let z₀ := d.label c
  let z := (MulAut.conj g) z₀
  have hfixed (i : ℤ) (hi : d.center ≤ i ∧ i ≤ d.center + 8) :
      z • (g • d.track.vertex i) = g • d.track.vertex i := by
    have hh : z₀ • d.track.vertex i = d.track.vertex i :=
      (d.shifted_fixed_iff 2 i).mpr (by rw [hr]; omega)
    simpa only [z, MulAut.conj_apply, mul_smul, inv_smul_smul] using
      congrArg (g • ·) hh
  have hzmem : z ∈ RankTwo.stabilizer F a := by
    rw [show a = g • d.track.vertex d.center from hga.symm]
    exact hfixed d.center (by omega)
  let k : RankTwo.stabilizer F a := ⟨z, hzmem⟩
  have hk : k ^ 2 = 1 := by
    have hzsq : z₀ ^ 2 = 1 := by
      simpa only [z₀, d.order_two c (d.shifted_type 2)] using pow_orderOf_eq_one z₀
    apply Subtype.ext
    change ((MulAut.conj g) z₀)^2 = 1
    rw [← map_pow, hzsq, map_one]
  have hne : f.branchAction k ≠ 1 := by
    intro he
    have hadj : (RankTwo.graph F).Adj a (g • d.track.vertex (d.center-1)) := by
      rw [← hga]
      apply (translationGraphIso F g).toHom.map_adj
      convert (d.track.adjacent (d.center-1)).symm using 1; congr 1; omega
    obtain ⟨i, hi⟩ := f.e.surjective ⟨_, hadj⟩
    have hi' : (f.e i).val = g • d.track.vertex (d.center-1) := congrArg Subtype.val hi
    have hh := f.branchAction_eval k i
    rw [he] at hh
    simp only [Equiv.Perm.one_apply] at hh
    rw [hi'] at hh
    have hfix : z₀ • d.track.vertex (d.center-1) = d.track.vertex (d.center-1) := by
      apply (MulAction.toPerm g).injective
      change g • (z₀ • d.track.vertex (d.center-1)) = g • d.track.vertex (d.center-1)
      simpa only [k, z, MulAut.conj_apply, mul_smul, inv_smul_smul] using hh.symm
    have hf := (d.shifted_fixed_iff 2 (d.center-1)).mp hfix
    rw [hr] at hf
    omega
  refine ⟨k, ?_, hk, three_involution_isSwap _ ?_ hne⟩
  · change (MulAut.conj g) (d.label c) ∈ d.labelBall b 2
    rw [show (MulAut.conj g) (d.label c) = d.label (g • c) from
      (d.conjugate g c (d.shifted_type 2)).symm]
    apply d.label_mem_labelBall (w := g • c)
      (show (g • c).type = d.side from d.shifted_type 2)
    rw [← hgb, RankTwo.dist_smul]
    have hd := SimpleGraph.dist_le (d.track.arc (d.center+2) 2).toWalk
    simpa only [BasedWalk.length_toWalk, Track.arc_endpoint, c, Nat.cast_ofNat,
      show (2 : ℤ)*2 = 4 from rfl, show d.center+2+2=d.center+4 by omega] using hd
  · rw [← map_pow, hk, map_one]

end CFSG.Quasithin.ChapterF.SourceAssembly.Goldschmidt.MathieuRadiusThree
