module

public import CFSG.Quasithin.ChapterF.Section06.SourceAssembly.SmallAmalgams.Goldschmidt.MathieuRadiusThree.LocalRelationsTrack
public import CFSG.Quasithin.ChapterF.Section06.SourceAssembly.SmallAmalgams.Goldschmidt.MathieuRadiusThree.LocalRelationsIntersection

/-!
# The track commutator from the four-group intersection

When the local-action calculation puts both middle labels in the mutual
commutator of the radius-two label groups, their intersection calculation
identifies that commutator with the four-group generated by those labels.
The actual track commutator belongs to this group, and its three excluded
values leave precisely the product of the middle labels.

Source: Goldschmidt, *Automorphisms of trivalent graphs* (1980), the
intersection argument immediately before (6.12.3), printed p.404.
-/

@[expose] public section
open Subgroup SimpleGraph Theory.GroupAction.CubicTree
open Subgroup.CosetGeometry
open scoped commutatorElement
namespace CFSG.Quasithin.ChapterF.SourceAssembly.Goldschmidt
variable {G : Type*} [Group G] {F : Bool → Subgroup G} {s : ℕ}

/-- Once both middle labels belong to the actual commutator of the two
radius-two label groups, the track commutator is their product. -/
theorem CanonicalLabelSetup.radiusThree_track_commutator_of_labels_mem_commutator
    (d : CanonicalLabelSetup F s) (h : LargeTreeSource F s) (hr : d.radius = 3)
    (hza : d.label (d.track.vertex d.center) ∈
      ⁅d.labelBall (d.track.vertex d.center) 2,
        d.labelBall (d.track.vertex (d.center+2)) 2⁆)
    (hzb : d.label (d.track.vertex (d.center+2)) ∈
      ⁅d.labelBall (d.track.vertex d.center) 2,
        d.labelBall (d.track.vertex (d.center+2)) 2⁆) :
    ⁅d.label (d.track.vertex (d.center-2)),
      d.label (d.track.vertex (d.center+4))⁆ =
        d.label (d.track.vertex d.center) * d.label (d.track.vertex (d.center+2)) := by
  have ha := d.center_type
  have hb : (d.track.vertex (d.center+2)).type = d.side := by
    simpa only [mul_one] using d.shifted_type 1
  have hne : d.track.vertex d.center ≠ d.track.vertex (d.center+2) := by
    intro hh
    have he := d.track.injective hh
    omega
  have hab : (RankTwo.graph F).dist (d.track.vertex d.center)
      (d.track.vertex (d.center+2)) ≤ 2 := by
    have hh := h.action.tree.connected.dist_triangle
      (u := d.track.vertex d.center) (v := d.track.vertex (d.center+1))
      (w := d.track.vertex (d.center+2))
    have h01 := dist_eq_one_iff_adj.mpr (d.track.adjacent d.center)
    have h12 : (RankTwo.graph F).dist (d.track.vertex (d.center+1))
        (d.track.vertex (d.center+2)) = 1 := dist_eq_one_iff_adj.mpr (by
      simpa only [show d.center+1+1=d.center+2 by omega] using d.track.adjacent (d.center+1))
    omega
  have he := (d.nearby_labelBall_intersection_eq_pair_of_labels_mem_commutator
    h hr ha hb hne hab hza hzb).2
  have hu := (d.radiusThree_track_commutator_mem h hr).2.2
  rw [he] at hu
  have hcomm := d.labels_commute_of_dist_le ha hb (by omega) (by have := h.five_le; omega)
  have hh := (Subgroup.mem_closure_pair_iff _ _ (d.label_mul_self ha)
    (d.label_mul_self hb) hcomm _).mp hu
  obtain ⟨hne₁, hne₂, hne₃⟩ := d.radiusThree_track_commutator_ne h hr
  rcases hh with hh | hh | hh | hh
  · exact (hne₁ hh).elim
  · exact (hne₂ hh).elim
  · exact (hne₃ hh).elim
  · exact hh
end CFSG.Quasithin.ChapterF.SourceAssembly.Goldschmidt
