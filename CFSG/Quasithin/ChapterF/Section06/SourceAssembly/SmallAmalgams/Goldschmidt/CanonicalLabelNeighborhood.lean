module

public import CFSG.Quasithin.ChapterF.Section06.SourceAssembly.SmallAmalgams.Goldschmidt.CanonicalLabelSetup
public import Theory.ElementaryAbelian.AbelianNormalClosure
public import Theory.GroupAction.RankTwoCosetGeometry.Kernels
public import Theory.GroupAction.CubicTree.DistanceTwoGeometry
public import Mathlib.Data.Set.Card

/-!
# Canonical label groups in vertex balls

The actual groups generated by canonical labels in a ball are normalized
by the vertex stabilizer and lie in the indicated ball kernels. A branch
frame records the two forward neighbors in each of the three branches;
its radius-two covering property is used to bound the number of label
generators.

Source: Goldschmidt, *Automorphisms of trivalent graphs* (1980), (6.11)--(6.12),
printed pp.402--405; these are the groups ⟨z^[2](a)⟩ and ⟨z^[4](a)⟩.
-/

@[expose] public section
namespace CFSG.Quasithin.ChapterF.SourceAssembly.Goldschmidt
open Subgroup SimpleGraph Theory.GroupAction.CubicTree
open Subgroup.CosetGeometry
variable {G : Type*} [Group G] {F : Bool → Subgroup G} {s : ℕ}

namespace CanonicalLabelSetup

def labelBall (d : CanonicalLabelSetup F s) (v : RankTwo.Vertex F) (r : ℕ) : Subgroup G :=
  closure (d.label '' {w | w.type = d.side ∧ (RankTwo.graph F).dist v w ≤ r})

theorem label_mem_labelBall (d : CanonicalLabelSetup F s)
    {v w : RankTwo.Vertex F} {r : ℕ}
    (hw : w.type = d.side) (hd : (RankTwo.graph F).dist v w ≤ r) :
    d.label w ∈ d.labelBall v r :=
  subset_closure ⟨w, ⟨hw, hd⟩, rfl⟩

theorem labelBall_le_stabilizer (d : CanonicalLabelSetup F s)
    (v : RankTwo.Vertex F) (r : ℕ) (hr : r ≤ d.radius + 1) (hs : r ≤ s) :
    d.labelBall v r ≤ RankTwo.stabilizer F v := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨w, ⟨hw, hd⟩, rfl⟩
  apply d.fixes_ball w hw v
  · simpa only [SimpleGraph.dist_comm] using hd.trans hr
  · simpa only [SimpleGraph.dist_comm] using hd.trans hs

theorem labelBall_normalized (d : CanonicalLabelSetup F s)
    (v : RankTwo.Vertex F) (r : ℕ) :
    RankTwo.stabilizer F v ≤ normalizer (d.labelBall v r : Set G) := by
  apply le_normalizer_closure_iff.mpr
  intro g hg x hx
  obtain ⟨w, ⟨hw, hd⟩, rfl⟩ := hx
  rw [← d.conjugate g w hw]
  apply d.label_mem_labelBall
  · exact hw
  · have he := RankTwo.dist_smul F g v w
    rw [show g • v = v from hg] at he
    exact he ▸ hd

theorem labelBall_normal (d : CanonicalLabelSetup F s)
    (v : RankTwo.Vertex F) (r : ℕ) (hr : r ≤ d.radius + 1) (hs : r ≤ s) :
    ((d.labelBall v r).subgroupOf (RankTwo.stabilizer F v)).Normal :=
  (normal_subgroupOf_iff_le_normalizer (d.labelBall_le_stabilizer v r hr hs)).mpr
    (d.labelBall_normalized v r)

theorem labelBall_le_ballKernel (d : CanonicalLabelSetup F s) (h : CubicTreeAction F)
    (v : RankTwo.Vertex F) (r m : ℕ)
    (hr : r + m ≤ d.radius + 1) (hs : r + m ≤ s) :
    d.labelBall v r ≤ RankTwo.ballKernel F v m := by
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨w, ⟨hw, hd⟩, rfl⟩
  intro u hu
  have hdu := (RankTwo.mem_ball_iff F h.generated v u m).mp hu
  have hb : (RankTwo.graph F).dist w u ≤ r + m := by
    calc
      (RankTwo.graph F).dist w u ≤
          (RankTwo.graph F).dist w v + (RankTwo.graph F).dist v u :=
        h.tree.connected.dist_triangle
      _ ≤ r + m := add_le_add (by simpa only [SimpleGraph.dist_comm] using hd) hdu
  exact d.fixes_ball w hw u (hb.trans hr) (hb.trans hs)

/-- At odd radius at least three, each radius-two label group fixes the
radius-two ball and is normalized by the actual vertex stabilizer. -/
theorem radiusTwo_local (d : CanonicalLabelSetup F s) (h : CubicTreeAction F)
    (hr : 3 ≤ d.radius) (hs : 4 ≤ s) (v : RankTwo.Vertex F) :
    d.labelBall v 2 ≤ RankTwo.ballKernel F v 2 ∧
      RankTwo.stabilizer F v ≤ normalizer (d.labelBall v 2 : Set G) :=
  ⟨d.labelBall_le_ballKernel h v 2 2 (by omega) hs, d.labelBall_normalized v 2⟩

end CanonicalLabelSetup
end CFSG.Quasithin.ChapterF.SourceAssembly.Goldschmidt


@[expose] public section
noncomputable section
namespace CFSG.Quasithin.ChapterF.SourceAssembly.Goldschmidt
open Subgroup SimpleGraph Theory.GroupAction.CubicTree
open Subgroup.CosetGeometry
variable {G : Type*} [Group G] {F : Bool → Subgroup G}

/-- The three branches at a vertex, with both forward neighbors marked. -/
structure BranchFrame (F : Bool → Subgroup G) (a : RankTwo.Vertex F) where
  e : Fin 3 ≃ (RankTwo.graph F).neighborSet a
  c : Fin 3 → RankTwo.Vertex F
  d : Fin 3 → RankTwo.Vertex F
  c_adj : ∀ i, (RankTwo.graph F).Adj (e i).val (c i)
  d_adj : ∀ i, (RankTwo.graph F).Adj (e i).val (d i)
  c_ne_center : ∀ i, c i ≠ a
  d_ne_center : ∀ i, d i ≠ a
  c_ne_d : ∀ i, c i ≠ d i
  neighbor_cases : ∀ i v, (RankTwo.graph F).Adj (e i).val v →
    v = a ∨ v = c i ∨ v = d i

theorem CubicTreeAction.exists_branchFrame (h : CubicTreeAction F) (a : RankTwo.Vertex F) :
    Nonempty (BranchFrame F a) := by
  classical
  let : Finite ((RankTwo.graph F).neighborSet a) :=
    Nat.finite_of_card_ne_zero (by rw [h.card_neighbor a]; decide)
  let : Fintype ((RankTwo.graph F).neighborSet a) := Fintype.ofFinite _
  let e : Fin 3 ≃ (RankTwo.graph F).neighborSet a :=
    (Fintype.equivFinOfCardEq (by rw [← Nat.card_eq_fintype_card, h.card_neighbor a])).symm
  have hex (i : Fin 3) : ∃ c d : RankTwo.Vertex F, c ≠ d ∧
      (RankTwo.graph F).neighborSet (e i).val \ {a} = {c, d} := by
    apply Set.ncard_eq_two.mp
    have ha : a ∈ (RankTwo.graph F).neighborSet (e i).val :=
      (show (RankTwo.graph F).Adj a (e i).val from (e i).property).symm
    rw [Set.ncard_sdiff_singleton_of_mem ha]
    change Nat.card ((RankTwo.graph F).neighborSet (e i).val) - 1 = 2
    rw [h.card_neighbor]
  choose c d hcd he using hex
  have hc (i : Fin 3) : c i ∈ (RankTwo.graph F).neighborSet (e i).val \ {a} := by
    rw [he i]
    exact Set.mem_insert _ _
  have hd (i : Fin 3) : d i ∈ (RankTwo.graph F).neighborSet (e i).val \ {a} := by
    rw [he i]
    exact Set.mem_insert_of_mem _ (Set.mem_singleton _)
  refine ⟨⟨e, c, d, fun i => (hc i).1, fun i => (hd i).1,
    fun i => (hc i).2, fun i => (hd i).2, hcd, ?_⟩⟩
  intro i v hv
  by_cases hva : v = a
  · exact Or.inl hva
  · right
    have hm : v ∈ (RankTwo.graph F).neighborSet (e i).val \ {a} := ⟨hv, hva⟩
    rw [he i] at hm
    exact hm

namespace BranchFrame
variable {a : RankTwo.Vertex F} (f : BranchFrame F a)

theorem c_dist (h : CubicTreeAction F) (i : Fin 3) :
    (RankTwo.graph F).dist a (f.c i) = 2 :=
  (DistanceTwoGeometry.dist_eq_two_iff h.tree).mpr
    ⟨(f.c_ne_center i).symm, (f.e i).val, (f.e i).property, f.c_adj i⟩

theorem d_dist (h : CubicTreeAction F) (i : Fin 3) :
    (RankTwo.graph F).dist a (f.d i) = 2 :=
  (DistanceTwoGeometry.dist_eq_two_iff h.tree).mpr
    ⟨(f.d_ne_center i).symm, (f.e i).val, (f.e i).property, f.d_adj i⟩

theorem radiusTwo_cases (h : CubicTreeAction F) {w : RankTwo.Vertex F}
    (ht : w.type = a.type) (hd : (RankTwo.graph F).dist a w ≤ 2) :
    w = a ∨ ∃ i, w = f.c i ∨ w = f.d i := by
  have he := (RankTwo.even_dist_iff F h.generated a w).mpr ht.symm
  have hd' : (RankTwo.graph F).dist a w = 0 ∨ (RankTwo.graph F).dist a w = 2 := by
    obtain ⟨k, hk⟩ := he
    omega
  rcases hd' with hd' | hd'
  · left
    exact (h.tree.connected.dist_eq_zero_iff.mp hd').symm
  · right
    obtain ⟨_, b, hab, hbw⟩ := (DistanceTwoGeometry.dist_eq_two_iff h.tree).mp hd'
    obtain ⟨i, hi⟩ := f.e.surjective ⟨b, hab⟩
    have hi' : (f.e i).val = b := congrArg Subtype.val hi
    rcases f.neighbor_cases i w (hi'.symm ▸ hbw) with hw | hw
    · subst w
      simp at hd'
    · exact ⟨i, hw⟩

end BranchFrame
end CFSG.Quasithin.ChapterF.SourceAssembly.Goldschmidt
