module
public import CFSG.Quasithin.ChapterF.Section06.SourceAssembly.SmallAmalgams.Goldschmidt.G2RadiusTwoLocalAction

/-!
# Six actual generators of the radius-two second source group

Choose one forward label beyond each of the six distance-two vertices.
The opposite forward label differs by the neighboring label, and the two
chosen labels in each branch have that neighboring label as their
commutator. Consequently these six original involutions generate the
literal subgroup generated by all twelve distance-three labels.

Source: Goldschmidt (1980), (6.9), printed pp.400--401.
-/

public section
open Subgroup SimpleGraph SimpleGraph.PathTransitivePolygon
open scoped commutatorElement
namespace CFSG.Quasithin.ChapterF.SourceAssembly.Goldschmidt
open Subgroup.CosetGeometry
variable {G : Type*} [Group G] {F : Bool → Subgroup G} {s : ℕ}

namespace RadiusTwoSixLabels

private theorem exists_other_neighbor (h : CubicTreeAction F)
    (a b : RankTwo.Vertex F) : ∃ v, (RankTwo.graph F).Adj a v ∧ v ≠ b := by
  by_contra! hh
  have hi : Subsingleton ((RankTwo.graph F).neighborSet a) := ⟨fun x y =>
    Subtype.ext ((hh x x.property).trans (hh y y.property).symm)⟩
  have hc : Nat.card ((RankTwo.graph F).neighborSet a) ≤ 1 := by
    let f : (RankTwo.graph F).neighborSet a → Unit := fun _ => ()
    simpa using Nat.card_le_card_of_injective f (fun x y _ => Subsingleton.elim _ _)
  rw [h.card_neighbor a] at hc
  omega

structure Frame {β : RankTwo.Vertex F} (f : BranchFrame F β) where
  u : Fin 3 × ZMod 2 → RankTwo.Vertex F
  adj : ∀ x, (RankTwo.graph F).Adj (f.point x) (u x)
  ne : ∀ x, u x ≠ (f.e x.1).val

noncomputable def frame (h : CubicTreeAction F)
    {β : RankTwo.Vertex F} (f : BranchFrame F β) : Frame f where
  u x := (exists_other_neighbor h (f.point x) (f.e x.1).val).choose
  adj x := (exists_other_neighbor h (f.point x) (f.e x.1).val).choose_spec.1
  ne x := (exists_other_neighbor h (f.point x) (f.e x.1).val).choose_spec.2

namespace Frame
variable {β : RankTwo.Vertex F} {f : BranchFrame F β} (r : Frame f)

theorem dist_three (h : CubicTreeAction F) (x : Fin 3 × ZMod 2) :
    (RankTwo.graph F).dist β (r.u x) = 3 := by
  let p : BasedWalk (RankTwo.graph F) 3 β :=
    ⟨⟨(f.e x.1).val, (f.e x.1).property⟩,
      ⟨⟨f.point x, f.point_adj x⟩, ⟨⟨r.u x, r.adj x⟩, PUnit.unit⟩⟩⟩
  have hp : p.Nonbacktracking := ⟨f.point_ne_center x, r.ne x, trivial⟩
  exact geodesic_of_nonbacktracking_of_cycle_bound h.tree.connected
    (N := 6) (fun _ _ hc => (h.tree.isAcyclic _ hc).elim) p hp (by decide)

theorem dist_two (h : CubicTreeAction F) (x : Fin 3 × ZMod 2) :
    (RankTwo.graph F).dist (f.e x.1).val (r.u x) = 2 :=
  (Theory.GroupAction.CubicTree.DistanceTwoGeometry.dist_eq_two_iff h.tree).mpr
    ⟨(r.ne x).symm, f.point x, f.point_adj x, r.adj x⟩

theorem branch_type (c : CanonicalLabelSetup F s) (hβ : β.type ≠ c.side) (i : Fin 3) :
    (f.e i).val.type = c.side := by
  have hn := (f.e i).property.1
  cases ht : β.type <;> cases ht' : (f.e i).val.type <;> cases hc : c.side <;> simp_all

theorem vertex_type (c : CanonicalLabelSetup F s) (h : CubicTreeAction F)
    (hβ : β.type ≠ c.side) (x : Fin 3 × ZMod 2) : (r.u x).type = c.side :=
  ((RankTwo.even_dist_iff F h.generated (f.e x.1).val (r.u x)).mp
    (by rw [r.dist_two h x]; decide)).symm.trans (branch_type c hβ x.1)

theorem mem_second (c : CanonicalLabelSetup F s) (h : CubicTreeAction F)
    (hβ : β.type ≠ c.side) (x : Fin 3 × ZMod 2) :
    c.label (r.u x) ∈ c.radiusTwoSecondGroup β :=
  subset_closure ⟨r.u x, ⟨r.dist_three h x, r.vertex_type c h hβ x⟩, rfl⟩

/-- The two chosen labels in each forward branch have the branch label
as their exact common commutator. -/
theorem pair_commutator (c : CanonicalLabelSetup F s) (hr : c.radius = 2)
    (hs : 4 ≤ s) (h : CubicTreeAction F) (hβ : β.type ≠ c.side) (i : Fin 3) :
    ⁅c.label (r.u (i,0)), c.label (r.u (i,1))⁆ = c.label (f.e i).val := by
  have hpoints : f.point (i,0) ≠ f.point (i,1) :=
    fun he => (by decide : (0 : ZMod 2) ≠ 1) (congrArg Prod.snd (f.point_injective h he))
  let p : BasedWalk (RankTwo.graph F) 4 (r.u (i,1)) :=
    ⟨⟨f.point (i,1), (r.adj (i,1)).symm⟩,
      ⟨⟨(f.e i).val, (f.point_adj (i,1)).symm⟩,
        ⟨⟨f.point (i,0), f.point_adj (i,0)⟩, ⟨⟨r.u (i,0), r.adj (i,0)⟩, PUnit.unit⟩⟩⟩⟩
  have hp : p.Nonbacktracking := ⟨(r.ne (i,1)).symm, hpoints, r.ne (i,0), trivial⟩
  have hd : (RankTwo.graph F).dist (r.u (i,1)) (r.u (i,0)) = 4 :=
    geodesic_of_nonbacktracking_of_cycle_bound h.tree.connected
      (N := 8) (fun _ _ hc => (h.tree.isAcyclic _ hc).elim) p hp (by decide)
  have hvdist : (RankTwo.graph F).dist (r.u (i,1)) (f.point (i,0)) ≤ 3 := by
    have he := h.tree.connected.dist_triangle
      (u := r.u (i,1)) (v := (f.e i).val) (w := f.point (i,0))
    rw [SimpleGraph.dist_comm (u := r.u (i,1)) (v := (f.e i).val), r.dist_two h (i,1),
      dist_eq_one_iff_adj.mpr (f.point_adj (i,0))] at he
    exact he
  exact c.radiusTwo_commutator_of_local_arc hr hs
    (r.vertex_type c h hβ (i,0)) (branch_type c hβ i) (r.vertex_type c h hβ (i,1))
    (r.adj (i,0)) (f.point_adj (i,0)).symm (r.ne (i,0)) hvdist
    (by rw [SimpleGraph.dist_comm, r.dist_two h (i,1)]; decide) hd

/-- The alternative forward child differs by the branch label. -/
theorem forward_label_cases (c : CanonicalLabelSetup F s) (_h : CubicTreeAction F)
    (hβ : β.type ≠ c.side) (x : Fin 3 × ZMod 2) {w : RankTwo.Vertex F}
    (hw : (RankTwo.graph F).Adj (f.point x) w) (hne : w ≠ (f.e x.1).val) :
    c.label w = c.label (r.u x) ∨
      c.label w = (c.label (f.e x.1).val * c.label (r.u x))⁻¹ := by
  by_cases he : w = r.u x
  · exact Or.inl (congrArg c.label he)
  · have hp := c.neighbor_product (f.point x) (f.e x.1).val (r.u x) w
      (f.point_adj x).symm (r.adj x) hw (r.ne x).symm hne.symm (Ne.symm he)
      (branch_type c hβ x.1)
    exact Or.inr (by rw [mul_eq_one_iff_eq_inv.mp hp, inv_inv])

/-- Every vertex at distance three has one of the six marked distance-two
vertices as its predecessor. -/
theorem sphere_three_cases (h : CubicTreeAction F) {w : RankTwo.Vertex F}
    (hw : (RankTwo.graph F).dist β w = 3) :
    ∃ x : Fin 3 × ZMod 2, (RankTwo.graph F).Adj (f.point x) w ∧ w ≠ (f.e x.1).val := by
  obtain ⟨p, hp⟩ := h.tree.connected.exists_walk_length_eq_dist β w
  have hp3 : p.length = 3 := hp.trans hw
  let v := p.getVert 2
  have hvw : (RankTwo.graph F).Adj v w := by
    have he := p.adj_getVert_succ (by omega : 2 < p.length)
    simpa only [show 2 + 1 = p.length from hp3.symm, Walk.getVert_length] using he
  have hv2 : (RankTwo.graph F).dist β v = 2 := by
    have hle : (RankTwo.graph F).dist β v ≤ 2 := by
      simpa only [Walk.take_length, hp3, Nat.min_eq_left (by decide : 2 ≤ 3)] using dist_le (p.take 2)
    have he := h.tree.connected.dist_triangle (u := β) (v := v) (w := w)
    rw [hw, dist_eq_one_iff_adj.mpr hvw] at he
    omega
  obtain ⟨x, hx⟩ := (f.sphereEquiv h).surjective ⟨v, hv2⟩
  have hxv : f.point x = v := congrArg Subtype.val hx
  refine ⟨x, hxv.symm ▸ hvw, ?_⟩
  intro he
  rw [he, dist_eq_one_iff_adj.mpr (f.e x.1).property] at hw
  omega

/-- The literal distance-three subgroup is generated by these six source
involutions; all twelve distance-three labels are accounted for. -/
theorem six_generators (c : CanonicalLabelSetup F s) (hr : c.radius = 2)
    (hs : 4 ≤ s) (h : CubicTreeAction F) (hβ : β.type ≠ c.side) :
    c.radiusTwoSecondGroup β = closure (Set.range fun x => c.label (r.u x)) := by
  let H := closure (Set.range fun x => c.label (r.u x))
  have hmem (x) : c.label (r.u x) ∈ H := subset_closure ⟨x, rfl⟩
  have hzmem (i) : c.label (f.e i).val ∈ H := by
    rw [← r.pair_commutator c hr hs h hβ i]
    exact H.mul_mem (H.mul_mem (H.mul_mem (hmem (i,0)) (hmem (i,1)))
      (H.inv_mem (hmem (i,0)))) (H.inv_mem (hmem (i,1)))
  apply le_antisymm
  · apply (closure_le _).mpr
    rintro _ ⟨w, ⟨hw, _⟩, rfl⟩
    obtain ⟨x, hx, hn⟩ := sphere_three_cases (f := f) h hw
    rcases r.forward_label_cases c h hβ x hx hn with he | he
    · rw [he]; exact hmem x
    · rw [he]
      exact H.inv_mem (H.mul_mem (hzmem x.1) (hmem x))
  · apply (closure_le _).mpr
    rintro _ ⟨x, rfl⟩
    exact r.mem_second c h hβ x

end Frame
end RadiusTwoSixLabels
end CFSG.Quasithin.ChapterF.SourceAssembly.Goldschmidt
