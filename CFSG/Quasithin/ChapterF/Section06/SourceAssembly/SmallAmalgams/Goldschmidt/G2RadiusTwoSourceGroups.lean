module
public import CFSG.Quasithin.ChapterF.Section06.SourceAssembly.SmallAmalgams.Goldschmidt.G2RadiusTwoLabels
public import Theory.GroupTheory.ConjugateSpanOrder

/-!
# The actual local subgroups in the radius-two argument

The second subgroup is generated by the labels at distance three from
a vertex. The first is generated by the conjugates of its point
stabilizer inside the neighboring vertex stabilizer. Equivariance of
the canonical labels proves the literal containment and normalization
properties required for the local-generation step of Goldschmidt (6.9).
-/

public section
open Subgroup SimpleGraph
namespace CFSG.Quasithin.ChapterF.SourceAssembly.Goldschmidt
open Subgroup.CosetGeometry
variable {G : Type*} [Group G] {F : Bool → Subgroup G} {s : ℕ}

/-- The literal source subgroup generated by labels at distance `n`. The type
condition discards the unused values of the label function. -/
@[expose] def CanonicalLabelSetup.sphereLabelGroup (c : CanonicalLabelSetup F s)
    (v : RankTwo.Vertex F) (n : ℕ) : Subgroup G :=
  closure (c.label '' {w | (RankTwo.graph F).dist v w = n ∧ w.type = c.side})

theorem CanonicalLabelSetup.stabilizer_le_normalizer_sphereLabelGroup
    (c : CanonicalLabelSetup F s) (v : RankTwo.Vertex F) (n : ℕ) :
    RankTwo.stabilizer F v ≤ normalizer (c.sphereLabelGroup v n : Set G) := by
  apply le_normalizer_closure_iff.mpr
  rintro g hg _ ⟨w, hw, rfl⟩
  apply Subgroup.subset_closure
  refine ⟨g • w, ⟨?_, hw.2⟩, c.conjugate g w hw.2⟩
  have hd := RankTwo.dist_smul F g v w
  rw [show g • v = v from hg, hw.1] at hd
  exact hd

theorem CanonicalLabelSetup.sphereLabelGroup_le_stabilizer
    (c : CanonicalLabelSetup F s) (v : RankTwo.Vertex F) (n : ℕ)
    (hn : n ≤ c.radius + 1) (hns : n ≤ s) :
    c.sphereLabelGroup v n ≤ RankTwo.stabilizer F v := by
  apply (closure_le _).mpr
  rintro _ ⟨w, hw, rfl⟩
  exact c.fixes_ball w hw.2 v (by rwa [SimpleGraph.dist_comm, hw.1])
    (by rwa [SimpleGraph.dist_comm, hw.1])

/-- Goldschmidt's `⟨z^[3](β)⟩`, the order-96 subgroup to be recognized. -/
@[expose] def CanonicalLabelSetup.radiusTwoSecondGroup (c : CanonicalLabelSetup F s)
    (β : RankTwo.Vertex F) : Subgroup G := c.sphereLabelGroup β 3

/-- Goldschmidt's `Hα`, generated by the conjugate point stabilizers of
`⟨z^[3](β)⟩` inside the first vertex stabilizer. -/
@[expose] def CanonicalLabelSetup.radiusTwoFirstGroup (c : CanonicalLabelSetup F s)
    (α β : RankTwo.Vertex F) : Subgroup G :=
  conjugateSpanBy (c.radiusTwoSecondGroup β ⊓ RankTwo.stabilizer F α)
    (RankTwo.stabilizer F α)

theorem CanonicalLabelSetup.radiusTwo_second_le_stabilizer
    (c : CanonicalLabelSetup F s) (hr : c.radius = 2) (hs : 3 ≤ s)
    (β : RankTwo.Vertex F) :
    c.radiusTwoSecondGroup β ≤ RankTwo.stabilizer F β :=
  c.sphereLabelGroup_le_stabilizer β 3 (by omega) hs

theorem CanonicalLabelSetup.radiusTwo_first_le_stabilizer
    (c : CanonicalLabelSetup F s) (α β : RankTwo.Vertex F) :
    c.radiusTwoFirstGroup α β ≤ RankTwo.stabilizer F α :=
  conjugateSpanBy_le_self inf_le_right

theorem CanonicalLabelSetup.radiusTwo_stabilizer_normalizes_first
    (c : CanonicalLabelSetup F s) (α β : RankTwo.Vertex F) :
    RankTwo.stabilizer F α ≤ normalizer (c.radiusTwoFirstGroup α β : Set G) :=
  le_normalizer_conjugateSpanBy _ _

theorem CanonicalLabelSetup.radiusTwo_stabilizer_normalizes_second
    (c : CanonicalLabelSetup F s) (β : RankTwo.Vertex F) :
    RankTwo.stabilizer F β ≤ normalizer (c.radiusTwoSecondGroup β : Set G) :=
  c.stabilizer_le_normalizer_sphereLabelGroup β 3

theorem CanonicalLabelSetup.radiusTwo_second_inter_first_le_first
    (c : CanonicalLabelSetup F s) (α β : RankTwo.Vertex F) :
    c.radiusTwoSecondGroup β ⊓ RankTwo.stabilizer F α ≤ c.radiusTwoFirstGroup α β :=
  le_conjugateSpanBy _ _

end CFSG.Quasithin.ChapterF.SourceAssembly.Goldschmidt
