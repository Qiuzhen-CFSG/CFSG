module
public import CFSG.Quasithin.ChapterF.Section06.SourceAssembly.SmallAmalgams.Goldschmidt.G2RadiusTwoSourceGroups
public import Theory.GroupTheory.ThreeInvolutionCommonCommutator
public import Theory.GroupAction.CubicTree.DistanceTwoGeometry
public import Theory.Combinatorics.SimpleGraph.PathTransitivePolygon.ShortGirth

/-!
# The first order-sixteen core in the radius-two branch

Choose one label in each of the three forward branches around a labelled
vertex. All pairwise distances are four, so their commutators coincide
with the nonidentity central label. The dihedral doubling theorem gives
order sixteen. The three-label product at each intervening vertex proves
that these three generators generate the literal full distance-two label
subgroup, which is nonabelian.

Source: Goldschmidt (6.9), printed p.401.
-/

public section
open Subgroup SimpleGraph SimpleGraph.PathTransitivePolygon
open scoped commutatorElement
namespace CFSG.Quasithin.ChapterF.SourceAssembly.Goldschmidt
open Subgroup.CosetGeometry
variable {G : Type*} [Group G] {F : Bool → Subgroup G} {s : ℕ}

private theorem branch_distance_four (h : CubicTreeAction F)
    {a v w u t : RankTwo.Vertex F}
    (hav : (RankTwo.graph F).Adj a v) (haw : (RankTwo.graph F).Adj a w)
    (hvw : v ≠ w) (hvu : (RankTwo.graph F).Adj v u)
    (hwt : (RankTwo.graph F).Adj w t) (hua : u ≠ a) (hta : t ≠ a) :
    (RankTwo.graph F).dist u t = 4 := by
  let p : BasedWalk (RankTwo.graph F) 4 u :=
    ⟨⟨v, hvu.symm⟩, ⟨⟨a, hav.symm⟩, ⟨⟨w, haw⟩, ⟨⟨t, hwt⟩, PUnit.unit⟩⟩⟩⟩
  have hp : p.Nonbacktracking := ⟨hua.symm, hvw.symm, hta, trivial⟩
  exact geodesic_of_nonbacktracking_of_cycle_bound h.tree.connected
    (N := 8) (fun _ _ hc => (h.tree.isAcyclic _ hc).elim) p hp (by decide)

private theorem branch_distance_two (h : CubicTreeAction F)
    {a v u : RankTwo.Vertex F} (hav : (RankTwo.graph F).Adj a v)
    (hvu : (RankTwo.graph F).Adj v u) (hua : u ≠ a) :
    (RankTwo.graph F).dist a u = 2 :=
  Theory.GroupAction.CubicTree.DistanceTwoGeometry.dist_eq_two_iff h.tree |>.mpr
    ⟨hua.symm, v, hav, hvu⟩

private theorem branch_commutator (c : CanonicalLabelSetup F s)
    (hr : c.radius = 2) (hs : 4 ≤ s) (h : CubicTreeAction F)
    {a v w u t : RankTwo.Vertex F} (ha : a.type = c.side)
    (hav : (RankTwo.graph F).Adj a v) (haw : (RankTwo.graph F).Adj a w)
    (hvw : v ≠ w) (hvu : (RankTwo.graph F).Adj v u)
    (hwt : (RankTwo.graph F).Adj w t) (hua : u ≠ a) (hta : t ≠ a) :
    ⁅c.label u, c.label t⁆ = c.label a := by
  have hu2 := branch_distance_two h hav hvu hua
  have ht2 := branch_distance_two h haw hwt hta
  have hu : u.type = c.side := by
    exact ((RankTwo.even_dist_iff F h.generated a u).mp (by rw [hu2]; decide)).symm.trans ha
  have ht : t.type = c.side := by
    exact ((RankTwo.even_dist_iff F h.generated a t).mp (by rw [ht2]; decide)).symm.trans ha
  have htv : (RankTwo.graph F).dist t v ≤ 3 := by
    have hh := h.tree.connected.dist_triangle (u := t) (v := a) (w := v)
    rw [SimpleGraph.dist_comm (u := t) (v := a), ht2,
      dist_eq_one_iff_adj.mpr hav] at hh
    exact hh
  exact c.radiusTwo_commutator_of_local_arc hr hs hu ha ht hvu hav.symm hua
    htv (by rw [SimpleGraph.dist_comm, ht2]; decide)
    (branch_distance_four h haw hav hvw.symm hwt hvu hta hua)

private theorem exists_forward (h : CubicTreeAction F) (v a : RankTwo.Vertex F) :
    ∃ u, (RankTwo.graph F).Adj v u ∧ u ≠ a := by
  by_contra! hh
  have hi : Subsingleton ((RankTwo.graph F).neighborSet v) := ⟨fun x y =>
    Subtype.ext ((hh x x.property).trans (hh y y.property).symm)⟩
  have hc : Nat.card ((RankTwo.graph F).neighborSet v) ≤ 1 := by
    let f : (RankTwo.graph F).neighborSet v → Unit := fun _ => ()
    simpa using Nat.card_le_card_of_injective f (fun x y _ => Subsingleton.elim _ _)
  rw [h.card_neighbor v] at hc
  omega

/-- The subgroup generated by all labels at distance two from a labelled
vertex has order sixteen. Its generators are chosen from the three forward
branches, and their three pairwise commutators are the center label. -/
theorem CanonicalLabelSetup.radiusTwo_sphere_two_structure
    (c : CanonicalLabelSetup F s) (hr : c.radius = 2) (hs : 4 ≤ s)
    (h : CubicTreeAction F) (a : RankTwo.Vertex F) (ha : a.type = c.side) :
    Nat.card (c.sphereLabelGroup a 2) = 16 ∧
      ¬ IsMulCommutative (c.sphereLabelGroup a 2) := by
  have hcard : ((RankTwo.graph F).neighborSet a).ncard = 3 := by
    rw [← Nat.card_coe_set_eq]
    exact h.card_neighbor a
  obtain ⟨v₀, v₁, v₂, hv01, hv02, hv12, hneigh⟩ := Set.ncard_eq_three.mp hcard
  have hv₀ : (RankTwo.graph F).Adj a v₀ := by
    change v₀ ∈ (RankTwo.graph F).neighborSet a
    rw [hneigh]; simp
  have hv₁ : (RankTwo.graph F).Adj a v₁ := by
    change v₁ ∈ (RankTwo.graph F).neighborSet a
    rw [hneigh]; simp
  have hv₂ : (RankTwo.graph F).Adj a v₂ := by
    change v₂ ∈ (RankTwo.graph F).neighborSet a
    rw [hneigh]; simp
  obtain ⟨u₀, hu₀, hn₀⟩ := exists_forward h v₀ a
  obtain ⟨u₁, hu₁, hn₁⟩ := exists_forward h v₁ a
  obtain ⟨u₂, hu₂, hn₂⟩ := exists_forward h v₂ a
  have hd₀ := branch_distance_two h hv₀ hu₀ hn₀
  have hd₁ := branch_distance_two h hv₁ hu₁ hn₁
  have hd₂ := branch_distance_two h hv₂ hu₂ hn₂
  have ht₀ : u₀.type = c.side :=
    ((RankTwo.even_dist_iff F h.generated a u₀).mp (by rw [hd₀]; decide)).symm.trans ha
  have ht₁ : u₁.type = c.side :=
    ((RankTwo.even_dist_iff F h.generated a u₁).mp (by rw [hd₁]; decide)).symm.trans ha
  have ht₂ : u₂.type = c.side :=
    ((RankTwo.even_dist_iff F h.generated a u₂).mp (by rw [hd₂]; decide)).symm.trans ha
  have hcomm01 := branch_commutator c hr hs h ha hv₀ hv₁ hv01 hu₀ hu₁ hn₀ hn₁
  have hcomm02 := branch_commutator c hr hs h ha hv₀ hv₂ hv02 hu₀ hu₂ hn₀ hn₂
  have hcomm12 := branch_commutator c hr hs h ha hv₁ hv₂ hv12 hu₁ hu₂ hn₁ hn₂
  let H := closure ({c.label u₀, c.label u₁, c.label u₂} : Set G)
  have hu0H : c.label u₀ ∈ H := subset_closure (by simp)
  have hu1H : c.label u₁ ∈ H := subset_closure (by simp)
  have hu2H : c.label u₂ ∈ H := subset_closure (by simp)
  have haH : c.label a ∈ H := hcomm01 ▸
    H.mul_mem (H.mul_mem (H.mul_mem hu0H hu1H) (H.inv_mem hu0H)) (H.inv_mem hu1H)
  have he : c.sphereLabelGroup a 2 = H := by
    apply le_antisymm
    · apply (closure_le _).mpr
      rintro _ ⟨w, hw, rfl⟩
      obtain ⟨hne, v, hav, hvw⟩ :=
        (Theory.GroupAction.CubicTree.DistanceTwoGeometry.dist_eq_two_iff h.tree).mp hw.1
      have hv : v ∈ ({v₀,v₁,v₂} : Set _) := by rw [← hneigh]; exact hav
      have hbranch (u v : RankTwo.Vertex F)
          (hvu : (RankTwo.graph F).Adj v u) (hva : (RankTwo.graph F).Adj v a)
          (hvw : (RankTwo.graph F).Adj v w) (hna : u ≠ a)
          (huH : c.label u ∈ H) : c.label w ∈ H := by
        by_cases hwu : w = u
        · exact hwu ▸ huH
        have hp := c.neighbor_product v a u w hva hvu hvw hna.symm hne (Ne.symm hwu) ha
        have hprod := H.mul_mem haH huH
        rw [mul_eq_one_iff_eq_inv.mp hp] at hprod
        simpa only [inv_inv] using H.inv_mem hprod
      rcases hv with hv0 | hv1 | hv2
      · rw [hv0] at hvw
        exact hbranch u₀ v₀ hu₀ hv₀.symm hvw hn₀ hu0H
      · rw [hv1] at hvw
        exact hbranch u₁ v₁ hu₁ hv₁.symm hvw hn₁ hu1H
      · rw [Set.mem_singleton_iff.mp hv2] at hvw
        exact hbranch u₂ v₂ hu₂ hv₂.symm hvw hn₂ hu2H
    · apply (closure_le _).mpr
      intro x hx
      rcases hx with rfl | rfl | rfl
      · exact subset_closure ⟨u₀, ⟨hd₀,ht₀⟩, rfl⟩
      · exact subset_closure ⟨u₁, ⟨hd₁,ht₁⟩, rfl⟩
      · exact subset_closure ⟨u₂, ⟨hd₂,ht₂⟩, rfl⟩
  rw [he]
  refine ⟨?_, ?_⟩
  · exact ThreeInvolutionCommonCommutator.card_closure_eq_sixteen
      (c.label u₀) (c.label u₁) (c.label u₂) (c.label a)
      (by simpa only [pow_two] using c.label_mul_self ht₀)
      (by simpa only [pow_two] using c.label_mul_self ht₁)
      (by simpa only [pow_two] using c.label_mul_self ht₂)
      (c.order_two a ha) hcomm01 hcomm02 hcomm12
  · intro hcomm
    have hh := isMulCommutative_iff.mp hcomm
      (⟨c.label u₀, hu0H⟩ : H) (⟨c.label u₁, hu1H⟩ : H)
    have hc : Commute (c.label u₀) (c.label u₁) := congrArg Subtype.val hh
    have heq : c.label a = 1 := hcomm01.symm.trans
      (commutatorElement_eq_one_iff_commute.mpr hc)
    have ho := c.order_two a ha
    simp only [heq, orderOf_one] at ho
    omega

theorem CanonicalLabelSetup.radiusTwo_sphere_two_card
    (c : CanonicalLabelSetup F s) (hr : c.radius = 2) (hs : 4 ≤ s)
    (h : CubicTreeAction F) (a : RankTwo.Vertex F) (ha : a.type = c.side) :
    Nat.card (c.sphereLabelGroup a 2) = 16 :=
  (c.radiusTwo_sphere_two_structure hr hs h a ha).1

end CFSG.Quasithin.ChapterF.SourceAssembly.Goldschmidt
