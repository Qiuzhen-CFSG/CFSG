module

public import Theory.GroupTheory.GeneratingPairPCore
public import Mathlib.GroupTheory.Perm.Fin

/-!
# Goldschmidt triples and their common normal core

Definition F.6.1 requires a finite group generated by two subgroups, each
having symmetric quotient of degree three over its two-core, whose intersection
is a Sylow two-subgroup of the ambient group. Lemma F.6.3 identifies the largest
subgroup of the intersection normal in both generators with the ambient two-core.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
§F.6, printed pp. 304–305 (1 March 2004 manuscript).
-/

namespace CFSG.Quasithin.ChapterF

variable {G : Type*} [Group G]

/-- Definition F.6.1, retaining the actual symmetric-group quotient
isomorphisms and the ambient Sylow condition. -/
public structure IsGoldschmidtTriple [Finite G] (G₁ G₂ : Subgroup G) : Prop where
  generated : G₁ ⊔ G₂ = ⊤
  quotient_left : Nonempty ((G₁ ⧸ pCore 2 G₁) ≃* Equiv.Perm (Fin 3))
  quotient_right : Nonempty ((G₂ ⧸ pCore 2 G₂) ≃* Equiv.Perm (Fin 3))
  intersection_sylow : ∃ T : Sylow 2 G, G₁ ⊓ G₂ = (T : Subgroup G)

variable [Finite G]

/-- Interchanging the generators preserves a Goldschmidt triple. -/
public theorem IsGoldschmidtTriple.symm {G₁ G₂ : Subgroup G}
    (h : IsGoldschmidtTriple G₁ G₂) : IsGoldschmidtTriple G₂ G₁ := by
  obtain ⟨T, hT⟩ := h.intersection_sylow
  exact ⟨sup_comm G₂ G₁ ▸ h.generated, h.quotient_right, h.quotient_left,
    T, (inf_comm G₂ G₁).trans hT⟩

/-- Lemma F.6.3: `O₂(G)` is the largest subgroup of `T` normal in both
members of a Goldschmidt triple. -/
public theorem IsGoldschmidtTriple.twoCore_isGreatest {G₁ G₂ : Subgroup G}
    (h : IsGoldschmidtTriple G₁ G₂) :
    IsGreatest {N : Subgroup G | N ≤ G₁ ⊓ G₂ ∧
      (N.subgroupOf G₁).Normal ∧ (N.subgroupOf G₂).Normal} (pCore 2 G) := by
  obtain ⟨T, hT⟩ := h.intersection_sylow
  exact Subgroup.pCore_isGreatest_common_normal G₁ G₂ T h.generated hT

/-- In a Goldschmidt amalgam the common normal subgroup in Definition F.6.1
is trivial. This is the faithfulness consequence of F.6.3. -/
public theorem IsGoldschmidtTriple.common_normal_eq_bot {G₁ G₂ : Subgroup G}
    (h : IsGoldschmidtTriple G₁ G₂) (hcore : pCore 2 G = ⊥)
    (N : Subgroup G) (hN : N ≤ G₁ ⊓ G₂)
    (h₁ : (N.subgroupOf G₁).Normal) (h₂ : (N.subgroupOf G₂).Normal) :
    N = ⊥ := by
  apply le_bot_iff.mp
  rw [← hcore]
  exact h.twoCore_isGreatest.2 ⟨hN, h₁, h₂⟩

/-- The two-core of either generating subgroup lies in the common Sylow
subgroup. Here the local core is embedded into the ambient group. -/
public theorem IsGoldschmidtTriple.local_twoCore_le_intersection {G₁ G₂ : Subgroup G}
    (h : IsGoldschmidtTriple G₁ G₂) :
    (pCore 2 G₁).map G₁.subtype ≤ G₁ ⊓ G₂ := by
  obtain ⟨T, hT⟩ := h.intersection_sylow
  have hTG₁ : (T : Subgroup G) ≤ G₁ := hT.symm.le.trans inf_le_left
  rintro x ⟨y, hy, rfl⟩
  rw [hT]
  exact pCore_isPGroup.le_sylow_of_normal (T.subtype hTG₁) hy

/-- The core-containment assertion of Lemma F.6.8. Its hypotheses force
each `Gᵢ ∩ X` to be `T ∩ X`, which is then normal in both generators. -/
public theorem IsGoldschmidtTriple.normal_intersection_le_twoCore
    {G₁ G₂ : Subgroup G} (h : IsGoldschmidtTriple G₁ G₂)
    (X : Subgroup G) [X.Normal]
    (h₁ : G₁ ⊓ X ≤ (pCore 2 G₁).map G₁.subtype)
    (h₂ : G₂ ⊓ X ≤ (pCore 2 G₂).map G₂.subtype) :
    (G₁ ⊓ G₂) ⊓ X ≤ pCore 2 G := by
  have hleft : G₁ ⊓ X ≤ G₁ ⊓ G₂ := h₁.trans h.local_twoCore_le_intersection
  have hright : G₂ ⊓ X ≤ G₁ ⊓ G₂ :=
    h₂.trans (h.symm.local_twoCore_le_intersection.trans (inf_comm G₂ G₁).le)
  have hn (A : Subgroup G) (ha : A ⊓ X ≤ G₁ ⊓ G₂) :
      (((G₁ ⊓ G₂) ⊓ X).subgroupOf A).Normal := by
    have heq : ((G₁ ⊓ G₂) ⊓ X).subgroupOf A = X.subgroupOf A := by
      ext x
      change ((x : G) ∈ G₁ ⊓ G₂ ∧ (x : G) ∈ X) ↔ (x : G) ∈ X
      exact ⟨And.right, fun hx => ⟨ha ⟨x.property, hx⟩, hx⟩⟩
    rw [heq]
    infer_instance
  exact h.twoCore_isGreatest.2 ⟨inf_le_left, hn G₁ hleft, hn G₂ hright⟩

end CFSG.Quasithin.ChapterF
