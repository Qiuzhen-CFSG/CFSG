module
public import CFSG.Quasithin.ChapterF.Section04.SourceCompletion.GeneralReeExtension.NativeCore
public import CFSG.Quasithin.ChapterF.Section04.SourceCompletion.GeneralReeFour.Smallness
public import Theory.SpecificGroups.ReeF4.SourceCompletion.Automorphisms
public import Theory.Combinatorics.SimpleGraph.PathTransitivePolygon.EvenCensus

/-!
# Exact order of the normal native Ree completion

The published field-factor smallness theorem gives diameter eight in any
native-amalgam completion of order at most (2m+1)|ReeF4.Model m|. Short odd
paths then exhaust the Suzuki vertex type; their unequal branching factors
give the native index and hence the native group order. Applying this to
the normal subgroup generated by the native images retains the full
extension bound and proves its exact native order, for every m>0.

No identification of this normal subgroup as a native Ree group is asserted.
Source: Aschbacher–Smith F.4.13,17,24, printed pp.280,283,287–288.
-/

public noncomputable section
namespace CFSG.Quasithin.ChapterF.SourceCompletion.GeneralReeExtension
open Subgroup Theory.GroupTheory ReeF4.Parabolics
open Subgroup.CosetGeometry hiding Vertex base
open Subgroup.CosetGeometry.RankTwo
open SimpleGraph SimpleGraph.PathTransitivePolygon SimpleGraph.BasedWalk
variable {m : ℕ} {M : Type*} [Group M]

private theorem native_card_odd_paths (c : GeneralReeFour.Completion m M) (hm : 0 < m)
    (hc : c.left.range ⊓ c.right.range = c.middle.range) (k : Fin 4) :
    Nat.card {p : BasedWalk c.graph (2*k.val+1) (base c.cosetFamily false) //
      p.Nonbacktracking} = (2^(2*m+1)+1) * (2^(2*m+1))^(3*k.val) := by
  have hn := c.card_neighbors hm hc
  have (v : c.Vertex) : Finite (c.graph.neighborSet v) :=
    Nat.finite_of_card_ne_zero (by rw [hn]; cases v.type <;> simp)
  have hf : ∀ {v w : c.Vertex}, c.graph.Adj v w → w.type = !v.type := by
    intro v w h
    have hh := h.1
    cases hv : v.type <;> cases hw : w.type <;> simp_all
  rw [card_nonbacktracking_succ c.graph (fun v => v.type)
    (fun i => (if i then (2^(2*m+1))^2 else 2^(2*m+1))+1) hf hn]
  fin_cases k <;> simp [forwardCount] <;> ring

/-- Native completions with the field-factor bound have exactly the native order. -/
theorem native_order_eq_of_field_bound [Finite M]
    (c : GeneralReeFour.Completion m M) (hm : 0 < m)
    (hc : c.left.range ⊓ c.right.range = c.middle.range)
    (horder : Nat.card M ≤ (2*m+1)*Nat.card (ReeF4.Model m)) :
    Nat.card M = Nat.card (ReeF4.Model m) := by
  let : Finite c.Vertex := Finite.of_equiv _ (vertexEquivSum c.cosetFamily).symm
  have hg := c.octagon_metric_of_order_bound hm hc Nat.lt_two_pow_self horder
  let e : {v : c.Vertex // v.type ≠ false} ≃ M ⧸ c.cosetFamily true :=
    { toFun := fun v => (show v.val.type = true by
        cases h : v.val.type with
        | false => exact (v.property h).elim
        | true => rfl) ▸ v.val.coset
      invFun := fun q => ⟨⟨true,q⟩,Bool.noConfusion⟩
      left_inv := by
        rintro ⟨⟨i,q⟩,h⟩
        cases i with
        | false => exact (h rfl).elim
        | true => rfl
      right_inv := fun _ => rfl }
  have hi := card_opposite_of_even_polygon (by decide : 0 < 4) c.connected
    (fun v : c.Vertex => v.type) (fun h => h.1) hg.1 hg.2.1 (base c.cosetFamily false)
  change Nat.card {v : c.Vertex // v.type ≠ false} = _ at hi
  rw [Nat.card_congr e] at hi
  simp only [native_card_odd_paths c hm hc] at hi
  have hindex : (c.cosetFamily true).index = ReeF4.SmallCompletion.cosetCount m true := by
    rw [index_eq_card,hi]
    simp [Fin.sum_univ_succ,ReeF4.SmallCompletion.cosetCount]
    ring
  have hpar : Nat.card (c.cosetFamily true) = Nat.card (parabolic m .suzuki) := c.right_card
  calc
    Nat.card M = Nat.card (c.cosetFamily true) * (c.cosetFamily true).index :=
      (c.cosetFamily true).card_mul_index.symm
    _ = Nat.card (parabolic m .suzuki) * ReeF4.SmallCompletion.cosetCount m true := by rw [hpar,hindex]
    _ = Nat.card (ReeF4.Model m) := (ReeF4.SourceCompletion.order_factor_suzuki m hm).symm

variable (E : SourceExtension m) (c : Completion E M)

/-- The full extension bounds the normal native-amalgam completion by the field degree. -/
theorem nativeCore_field_bound [Finite M] (hm : 0 < m)
    (horder : Nat.card M ≤ Nat.card E.carrier) :
    Nat.card (nativeCore E c) ≤ (2*m+1)*Nat.card (ReeF4.Model m) :=
  (Nat.card_le_card_of_injective _ (nativeCore E c).subtype_injective).trans
    (horder.trans (ReeF4.SourceCompletion.card_extension_le hm E.carrier.subtype E.carrier.subtype_injective))

/-- The normal native-amalgam completion has exactly the native group order. -/
theorem nativeCore_order_eq [Finite M] (hm : 0 < m)
    (hc : c.left.range ⊓ c.right.range = c.middle.range)
    (horder : Nat.card M ≤ Nat.card E.carrier) :
    Nat.card (nativeCore E c) = Nat.card (ReeF4.Model m) :=
  native_order_eq_of_field_bound (nativeCompletion E c hm) hm
    (nativeCompletion_overlap E c hm hc) (nativeCore_field_bound E c hm horder)

end CFSG.Quasithin.ChapterF.SourceCompletion.GeneralReeExtension
