module
public import CFSG.Quasithin.ChapterF.Section04.SourceCompletion.GeneralReeExtension.Faithfulness
public import CFSG.Quasithin.ChapterF.Section04.SourceCompletion.GeneralReeFour

/-!
# The normal subgroup generated by the marked native Ree parabolics

Restrict both completion maps to the actual inner parabolic images. The full
extension overlap normalizes both images, and supplements their join. Hence
this join is normal in the completion. The restricted maps form a faithful
completion of the native linear/Borel/Suzuki amalgam; whole overlap passes to
it by injectivity of the original endpoint maps and native conjugation.

The subgroup constructed here is not yet identified with the native Ree group.
Source: Aschbacher–Smith F.4.3–6 and F.4.17, printed pp.274–277,283.
-/

@[expose] public noncomputable section
namespace CFSG.Quasithin.ChapterF.SourceCompletion.GeneralReeExtension
open Subgroup Theory.GroupTheory
open ReeF4.Parabolics
variable {m : ℕ} (E : SourceExtension m) {M : Type*} [Group M] (c : Completion E M)

/-- The literal inner embedding of the linear parabolic in the full endpoint. -/
def nativeLeftLocal : parabolic m .linear →* E.left :=
  (MulAut.conj.comp (parabolic m .linear).subtype).codRestrict E.left (fun x =>
    (E.left_inner.symm ▸ (show MulAut.conj x.val ∈ (parabolic m .linear).map MulAut.conj from
      ⟨x.val,x.property,rfl⟩)).1)

/-- The literal inner embedding of the Suzuki parabolic in the full endpoint. -/
def nativeRightLocal : parabolic m .suzuki →* E.right :=
  (MulAut.conj.comp (parabolic m .suzuki).subtype).codRestrict E.right (fun x =>
    (E.right_inner.symm ▸ (show MulAut.conj x.val ∈ (parabolic m .suzuki).map MulAut.conj from
      ⟨x.val,x.property,rfl⟩)).1)

/-- The marked linear parabolic map into the supplied completion. -/
def nativeLeft : parabolic m .linear →* M := c.left.comp (nativeLeftLocal E)

/-- The marked Suzuki parabolic map into the supplied completion. -/
def nativeRight : parabolic m .suzuki →* M := c.right.comp (nativeRightLocal E)

/-- The actual join of the two marked native images; no recognition is assumed. -/
def nativeCore : Subgroup M := (nativeLeft E c).range ⊔ (nativeRight E c).range

private theorem native_compatible :
    (nativeLeft E c).comp (inclusion (borel_le_parabolic m .linear)) =
      (nativeRight E c).comp (inclusion (borel_le_parabolic m .suzuki)) := by
  ext b
  exact DFunLike.congr_fun c.compatible
    ⟨MulAut.conj b.val, ((nativeLeftLocal E) ⟨b.val,borel_le_parabolic m .linear b.property⟩).property,
      ((nativeRightLocal E) ⟨b.val,borel_le_parabolic m .suzuki b.property⟩).property⟩

private theorem nativeLeftLocal_range :
    (nativeLeftLocal E).range = (MulAut.innerSubgroup (ReeF4.Model m)).comap E.left.subtype := by
  ext a
  constructor
  · rintro ⟨b,rfl⟩
    exact ⟨b.val,rfl⟩
  · intro ha
    have h : a.val ∈ (parabolic m .linear).map MulAut.conj := E.left_inner ▸ ⟨a.property,ha⟩
    obtain ⟨b,hb,he⟩ := h
    exact ⟨⟨b,hb⟩,Subtype.ext he⟩

private theorem nativeRightLocal_range :
    (nativeRightLocal E).range = (MulAut.innerSubgroup (ReeF4.Model m)).comap E.right.subtype := by
  ext a
  constructor
  · rintro ⟨b,rfl⟩
    exact ⟨b.val,rfl⟩
  · intro ha
    have h : a.val ∈ (parabolic m .suzuki).map MulAut.conj := E.right_inner ▸ ⟨a.property,ha⟩
    obtain ⟨b,hb,he⟩ := h
    exact ⟨⟨b,hb⟩,Subtype.ext he⟩

private theorem left_normalizes_nativeLeft :
    c.left.range ≤ normalizer ((nativeLeft E c).range : Set M) := by
  let K := (MulAut.innerSubgroup (ReeF4.Model m)).comap E.left.subtype
  have he : (nativeLeft E c).range = K.map c.left := by
    rw [nativeLeft,MonoidHom.range_comp,nativeLeftLocal_range]
  rw [he]
  have hh := K.le_normalizer_map c.left
  simpa only [normalizer_eq_top,←MonoidHom.range_eq_map] using hh

private theorem right_normalizes_nativeRight :
    c.right.range ≤ normalizer ((nativeRight E c).range : Set M) := by
  let K := (MulAut.innerSubgroup (ReeF4.Model m)).comap E.right.subtype
  have he : (nativeRight E c).range = K.map c.right := by
    rw [nativeRight,MonoidHom.range_comp,nativeRightLocal_range]
  rw [he]
  have hh := K.le_normalizer_map c.right
  simpa only [normalizer_eq_top,←MonoidHom.range_eq_map] using hh

/-- The entire extension overlap preserves the join of the native images. -/
theorem middle_normalizes_nativeCore :
    c.middle.range ≤ normalizer (nativeCore E c : Set M) :=
  (le_inf (c.middle_le_left.trans (left_normalizes_nativeLeft E c))
    (c.middle_le_right.trans (right_normalizes_nativeRight E c))).trans
      (normalizer_inf_normalizer_le_normalizer_sup _ _)

/-- The original overlap supplements the native-generated subgroup. -/
theorem nativeCore_sup_middle (hm : 0 < m) : nativeCore E c ⊔ c.middle.range = ⊤ := by
  apply top_unique
  rw [← c.generated]
  apply sup_le
  · rintro _ ⟨a,rfl⟩
    obtain ⟨b,hb,d,hd,he⟩ := E.left_factor (ReeF4.SmallCompletion.conj_injective m hm) a a.property
    have ha : a = (nativeLeftLocal E) ⟨b,hb⟩ * E.amalgam.left ⟨d,hd⟩ := Subtype.ext he
    rw [ha,map_mul]
    exact mul_mem_sup (show nativeLeft E c ⟨b,hb⟩ ∈ nativeCore E c from mem_sup_left ⟨_,rfl⟩)
      (show c.middle ⟨d,hd⟩ ∈ c.middle.range from ⟨_,rfl⟩)
  · rintro _ ⟨a,rfl⟩
    obtain ⟨b,hb,d,hd,he⟩ := E.right_factor (ReeF4.SmallCompletion.conj_injective m hm) a a.property
    have ha : a = (nativeRightLocal E) ⟨b,hb⟩ * E.amalgam.right ⟨d,hd⟩ := Subtype.ext he
    rw [ha,map_mul]
    apply mul_mem_sup (show nativeRight E c ⟨b,hb⟩ ∈ nativeCore E c from mem_sup_right ⟨_,rfl⟩)
    exact ⟨⟨d,hd⟩,DFunLike.congr_fun c.compatible _⟩

/-- The marked native images generate a normal subgroup of the full completion. -/
theorem nativeCore_normal (hm : 0 < m) : (nativeCore E c).Normal := by
  apply normalizer_eq_top_iff.mp
  apply top_unique
  rw [←nativeCore_sup_middle E c hm]
  exact sup_le (nativeCore E c).le_normalizer (middle_normalizes_nativeCore E c)

/-- Restrict the original marking to a faithful native-amalgam completion. -/
def nativeCompletion (hm : 0 < m) : GeneralReeFour.Completion m (nativeCore E c) where
  left := (nativeLeft E c).codRestrict (nativeCore E c) (fun x => mem_sup_left ⟨x,rfl⟩)
  right := (nativeRight E c).codRestrict (nativeCore E c) (fun x => mem_sup_right ⟨x,rfl⟩)
  compatible := by
    apply MonoidHom.ext
    intro b
    exact Subtype.ext (DFunLike.congr_fun (native_compatible E c) b)
  left_injective := by
    intro x y he
    apply Subtype.ext
    apply ReeF4.SmallCompletion.conj_injective m hm
    exact congrArg Subtype.val (c.left_injective (congrArg Subtype.val he))
  right_injective := by
    intro x y he
    apply Subtype.ext
    apply ReeF4.SmallCompletion.conj_injective m hm
    exact congrArg Subtype.val (c.right_injective (congrArg Subtype.val he))
  middle_injective := by
    intro x y he
    apply Subtype.ext
    apply ReeF4.SmallCompletion.conj_injective m hm
    exact congrArg Subtype.val (c.left_injective (congrArg Subtype.val he))
  generated := by
    apply map_injective (nativeCore E c).subtype_injective
    rw [Subgroup.map_sup,MonoidHom.map_range,MonoidHom.map_range,
      ←MonoidHom.range_eq_map,range_subtype]
    rfl

/-- Whole overlap restricts to precisely the original native Borel. -/
theorem nativeCompletion_overlap (hm : 0 < m)
    (hoverlap : c.left.range ⊓ c.right.range = c.middle.range) :
    (nativeCompletion E c hm).left.range ⊓ (nativeCompletion E c hm).right.range =
      (nativeCompletion E c hm).middle.range := by
  apply le_antisymm ?_ (le_inf (nativeCompletion E c hm).middle_le_left
    (nativeCompletion E c hm).middle_le_right)
  rintro x ⟨⟨a,ha⟩,⟨b,hb⟩⟩
  have he : c.left ((nativeLeftLocal E) a) = c.right ((nativeRightLocal E) b) :=
    congrArg Subtype.val (ha.trans hb.symm)
  have hin : c.left ((nativeLeftLocal E) a) ∈ c.left.range ⊓ c.right.range :=
    ⟨⟨_,rfl⟩,⟨_,he.symm⟩⟩
  obtain ⟨d,hd⟩ := hoverlap.le hin
  have hdl := c.left_injective hd
  have hdr := c.right_injective ((DFunLike.congr_fun c.compatible d).symm.trans (hd.trans he))
  have hab : a.val = b.val := ReeF4.SmallCompletion.conj_injective m hm
    ((congrArg Subtype.val hdl).symm.trans (congrArg Subtype.val hdr))
  have haB : a.val ∈ borel m := by
    rw [←GreenBook.LieModels.ReeFour.overlap m]
    exact ⟨hab ▸ b.property,a.property⟩
  exact ⟨⟨a.val,haB⟩,ha⟩

end CFSG.Quasithin.ChapterF.SourceCompletion.GeneralReeExtension
