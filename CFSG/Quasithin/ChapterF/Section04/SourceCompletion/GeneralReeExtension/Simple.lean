module
public import CFSG.Quasithin.ChapterF.Section04.SourceCompletion.GeneralReeExtension.NativeOrder
public import Theory.GroupTheory.Simple

/-!
# Simple ambient completions reduce to the native amalgam

The normal subgroup generated by the marked native images has exactly the
native Ree order, which is greater than one. Ambient simplicity therefore
makes this subgroup the whole completion. The original native endpoint maps
then give a faithful native-amalgam completion with whole overlap and native
order. No abstract group identification is claimed.

Source: the simple ambient application of Aschbacher–Smith F.4.17,24
and 5.3.4, printed pp.283,287–288,659.
-/

@[expose] public noncomputable section
namespace CFSG.Quasithin.ChapterF.SourceCompletion.GeneralReeExtension
open Subgroup Theory.GroupTheory ReeF4.Parabolics
variable {m : ℕ} (E : SourceExtension m) {M : Type*} [Group M] [Finite M] (c : Completion E M)

private theorem native_card_gt_one (hm : 0 < m) : 1 < Nat.card (ReeF4.Model m) := by
  rw [ReeF4.SourceCompletion.order_factor_suzuki m hm]
  have hp : 1 ≤ Nat.card (parabolic m .suzuki) := Nat.card_pos
  have hq : 1 ≤ 2^(2*m+1) := Nat.one_le_pow _ _ (by decide)
  have h3 : 1 ≤ (2^(2*m+1))^3+1 := by omega
  have h6 : 1 ≤ (2^(2*m+1))^6+1 := by omega
  have hn : 1 < (2^(2*m+1)+1) := by omega
  exact hn.trans_le ((Nat.le_mul_of_pos_right _ h3).trans
    ((Nat.le_mul_of_pos_right _ h6).trans (Nat.le_mul_of_pos_left _ hp)))

/-- Simplicity eliminates a proper normal native-amalgam completion. -/
theorem nativeCore_eq_top_of_simple [IsSimpleGroup M] (hm : 0 < m)
    (hc : c.left.range ⊓ c.right.range = c.middle.range)
    (horder : Nat.card M ≤ Nat.card E.carrier) : nativeCore E c = ⊤ := by
  apply (nativeCore_normal E c hm).eq_bot_or_eq_top.resolve_left
  intro he
  have hcard := nativeCore_order_eq E c hm hc horder
  rw [he,Subgroup.card_bot] at hcard
  exact (ne_of_gt (native_card_gt_one hm)) hcard.symm

/-- The original inner endpoint maps generate a simple full completion. -/
def nativeAmbientCompletion [IsSimpleGroup M] (hm : 0 < m)
    (hc : c.left.range ⊓ c.right.range = c.middle.range)
    (horder : Nat.card M ≤ Nat.card E.carrier) : GeneralReeFour.Completion m M where
  left := nativeLeft E c
  right := nativeRight E c
  compatible := by
    have hh := congrArg (fun f => (nativeCore E c).subtype.comp f)
      (nativeCompletion E c hm).compatible
    exact hh
  left_injective := fun _ _ h => (nativeCompletion E c hm).left_injective (Subtype.ext h)
  right_injective := fun _ _ h => (nativeCompletion E c hm).right_injective (Subtype.ext h)
  middle_injective := fun _ _ h => (nativeCompletion E c hm).middle_injective (Subtype.ext h)
  generated := nativeCore_eq_top_of_simple E c hm hc horder

/-- The native marking in the whole simple group retains its exact Borel overlap. -/
theorem nativeAmbientCompletion_overlap [IsSimpleGroup M] (hm : 0 < m)
    (hc : c.left.range ⊓ c.right.range = c.middle.range)
    (horder : Nat.card M ≤ Nat.card E.carrier) :
    (nativeAmbientCompletion E c hm hc horder).left.range ⊓
        (nativeAmbientCompletion E c hm hc horder).right.range =
      (nativeAmbientCompletion E c hm hc horder).middle.range := by
  have hh := congrArg (Subgroup.map (nativeCore E c).subtype)
    (nativeCompletion_overlap E c hm hc)
  rw [map_inf _ _ _ (nativeCore E c).subtype_injective,
    MonoidHom.map_range,MonoidHom.map_range,MonoidHom.map_range] at hh
  exact hh

/-- A simple full-extension completion has exactly the native Ree order. -/
theorem simple_completion_order_eq_native [IsSimpleGroup M] (hm : 0 < m)
    (hc : c.left.range ⊓ c.right.range = c.middle.range)
    (horder : Nat.card M ≤ Nat.card E.carrier) : Nat.card M = Nat.card (ReeF4.Model m) := by
  have hh := nativeCore_order_eq E c hm hc horder
  rw [nativeCore_eq_top_of_simple E c hm hc horder,Nat.card_congr Subgroup.topEquiv.toEquiv] at hh
  exact hh

end CFSG.Quasithin.ChapterF.SourceCompletion.GeneralReeExtension

