module
public import CFSG.Quasithin.ChapterF.Section04.SourceCompletion.TrialityNonbinary.NativeCore
public import Theory.GroupTheory.Amalgam.RankTwoCompletion.OverlapCover

/-!
# Native triality completion geometry

The common whole-overlap cover transfers the native seven-path action and
both unequal local degrees to every faithful native completion. Seven-path
transitivity and thickness force girth at least twelve, before imposing any
order bound. This applies in particular to the normal subgroup generated by
the native endpoints of a full extension completion.

Source: Aschbacher--Smith F.4.3--6, pp.274--277.
-/

public noncomputable section
namespace CFSG.Quasithin.ChapterF.SourceCompletion.TrialityNonbinary.NativeCompletion
open Subgroup Theory.GroupTheory
open Subgroup.CosetGeometry hiding Vertex base
open Subgroup.CosetGeometry.RankTwo
open SimpleGraph SimpleGraph.PathTransitivePolygon
open _root_.Triality.Standard _root_.Triality.Standard.Parabolics
variable {m : ℕ} {hm : 0 < m} {M : Type*} [Group M] (c : NativeCompletion m hm M)

theorem connected : (graph c.cosetFamily).Connected :=
  RankTwo.connected c.cosetFamily c.generated

theorem graphAction : GraphAction (graph c.cosetFamily) M where
  map_adj g := (translationGraphIso c.cosetFamily g).toHom.map_adj

/-- Native seven-path transitivity transfers through the whole-overlap covers. -/
theorem seven_transitive (hoverlap : c.left.range ⊓ c.right.range = c.middle.range) (v : Vertex c.cosetFamily) :
    RootPathTransitive (graph c.cosetFamily) M v 7 := by
  obtain ⟨g,hg⟩ := exists_smul_base c.cosetFamily v
  have hb := RankTwoAmalgam.Universal.rootPathTransitive_transfer_of_overlap
    (nativeAmalgam m hm) (nativeModel m hm) c (nativeModel_overlap m hm)
    hoverlap v.type 7 (by
      rw [nativeModel_family]
      exact SmallCompletion.seven_path_transitive m hm _)
  simpa only [hg] using RootPathTransitive.smul (graphAction c) hb g

/-- The two marked valences are q³+1 and q+1, including q=4. -/
theorem card_neighbors (hoverlap : c.left.range ⊓ c.right.range = c.middle.range) (v : Vertex c.cosetFamily) :
    Nat.card ((graph c.cosetFamily).neighborSet v) =
      SmallCompletion.degree m hm v.type := by
  obtain ⟨g,hg⟩ := exists_smul_base c.cosetFamily v
  let cc := RankTwoAmalgam.Universal.coverData_of_overlap (nativeAmalgam m hm) c hoverlap
  let cm := RankTwoAmalgam.Universal.coverData_of_overlap (nativeAmalgam m hm)
    (nativeModel m hm) (nativeModel_overlap m hm)
  let u := base (RankTwoAmalgam.Universal.cosetFamily (nativeAmalgam m hm)) v.type
  have hc := Nat.card_congr (Equiv.ofBijective (cc.hom.mapNeighborSet u) (cc.neighbor_bijective u))
  have hn := Nat.card_congr (Equiv.ofBijective (cm.hom.mapNeighborSet u) (cm.neighbor_bijective u))
  have hb := hc.symm.trans hn
  change Nat.card ((graph c.cosetFamily).neighborSet (cc.vertex u)) =
    Nat.card ((graph (nativeModel m hm).cosetFamily).neighborSet (cm.vertex u)) at hb
  dsimp only [u] at hb
  rw [cc.vertex_base, cm.vertex_base, nativeModel_family, SmallCompletion.base_neighbor_card] at hb
  have hh := Nat.card_congr
    ((translationGraphIso c.cosetFamily g).mapNeighborSet (base c.cosetFamily v.type))
  change Nat.card ((graph c.cosetFamily).neighborSet (base c.cosetFamily v.type)) =
    Nat.card ((graph c.cosetFamily).neighborSet (g • base c.cosetFamily v.type)) at hh
  rw [hg] at hh
  exact hh.symm.trans hb

theorem thick (hoverlap : c.left.range ⊓ c.right.range = c.middle.range)
    (v a b : Vertex c.cosetFamily) : ∃ z, (graph c.cosetFamily).Adj v z ∧ z ≠ a ∧ z ≠ b := by
  classical
  have hq : 1 < (binaryParameters m hm).q := by
    rw [binaryParameters_q]
    exact Nat.one_lt_pow (by omega) (by decide)
  have hcard : 2 < Nat.card ((graph c.cosetFamily).neighborSet v) := by
    rw [card_neighbors c hoverlap]
    cases v.type <;> simp only [SmallCompletion.degree, Bool.false_eq_true, ↓reduceIte] <;> nlinarith [Nat.le_self_pow (by decide : 3 ≠ 0) (binaryParameters m hm).q]
  let : Finite ((graph c.cosetFamily).neighborSet v) := Nat.finite_of_card_ne_zero (by omega)
  let := Fintype.ofFinite ((graph c.cosetFamily).neighborSet v)
  rw [Nat.card_eq_fintype_card] at hcard
  obtain ⟨x,y,z,hxy,hxz,hyz⟩ := Fintype.two_lt_card_iff.mp hcard
  by_contra hh
  push Not at hh
  have choices (w : (graph c.cosetFamily).neighborSet v) : w.val = a ∨ w.val = b := by
    by_cases ha : w.val = a
    · exact Or.inl ha
    · exact Or.inr (hh w.val w.property ha)
  have hxy' : x.val ≠ y.val := fun h => hxy (Subtype.ext h)
  have hxz' : x.val ≠ z.val := fun h => hxz (Subtype.ext h)
  have hyz' : y.val ≠ z.val := fun h => hyz (Subtype.ext h)
  rcases choices x with hx | hx <;> rcases choices y with hy | hy <;>
    rcases choices z with hz | hz
  · exact hxy' (hx.trans hy.symm)
  · exact hxy' (hx.trans hy.symm)
  · exact hxz' (hx.trans hz.symm)
  · exact hyz' (hy.trans hz.symm)
  · exact hyz' (hy.trans hz.symm)
  · exact hxz' (hx.trans hz.symm)
  · exact hxy' (hx.trans hy.symm)
  · exact hxy' (hx.trans hy.symm)

/-- Whole-overlap native completions have girth at least twelve. -/
theorem cycle_length_ge_twelve (hoverlap : c.left.range ⊓ c.right.range = c.middle.range)
    (v : Vertex c.cosetFamily) (p : (graph c.cosetFamily).Walk v v) (hp : p.IsCycle) :
    12 ≤ p.length :=
  cycle_bound_of_seven_transitive (graphAction c)
    (thick c hoverlap)
    (seven_transitive c hoverlap) (·.type) (fun h => h.1) v p hp


end CFSG.Quasithin.ChapterF.SourceCompletion.TrialityNonbinary.NativeCompletion
