module
public import CFSG.Quasithin.ChapterF.Section04.SourceCompletion.TrialityNonbinary.NativeGeometry
public import Theory.SpecificGroups.Triality.ParabolicOuterTwo.Extensions
public import Theory.Combinatorics.SimpleGraph.PathTransitivePolygon.HexagonRecognition
public import Theory.Combinatorics.SimpleGraph.PathTransitivePolygon.EvenCensus
public import Theory.Combinatorics.SimpleGraph.NonbacktrackingCount

/-!
# Exact native order inside a full triality extension completion

The cubic coefficient group bounds the full extension by 3m times the native
order. Six-paths from an arms vertex outnumber the available vertices of that
same type, including m=2. Girth twelve forces a twelve-cycle, and seven-path
transitivity then gives diameter six. The short odd path census gives exactly
the native order for the normal subgroup generated by the marked endpoints.
This does not yet identify that subgroup with the native triality group.

Source: Aschbacher--Smith F.4.6--8,13,17,24, pp.276--283,287--288.
-/

public noncomputable section
namespace CFSG.Quasithin.ChapterF.SourceCompletion.TrialityNonbinary
open Subgroup Theory.GroupTheory
open Subgroup.CosetGeometry hiding Vertex base
open Subgroup.CosetGeometry.RankTwo
open SimpleGraph SimpleGraph.PathTransitivePolygon SimpleGraph.BasedWalk
open _root_.Triality.Standard _root_.Triality.Standard.Parabolics
open _root_.Triality.Standard.SmallCompletion

/-- The actual automorphism group retains the complete cubic field degree. -/
theorem automorphism_card_le (m : ℕ) (hm : 0 < m) :
    Nat.card (MulAut (BinaryCarrier m hm)) ≤ (3*m)*Nat.card (BinaryCarrier m hm) := by
  have hi : Nat.card (MulAut.innerSubgroup (BinaryCarrier m hm)) ≤ Nat.card (BinaryCarrier m hm) :=
    Nat.card_le_card_of_surjective (MulAut.conj : BinaryCarrier m hm →* MulAut _).rangeRestrict
      (MulAut.conj : BinaryCarrier m hm →* MulAut _).rangeRestrict_surjective
  have ho : Nat.card (MulAut.Outer (BinaryCarrier m hm)) ≤ 3*m :=
    Nat.le_of_dvd (by omega) (ParabolicOuterTwo.outer_card_dvd m hm)
  calc
    Nat.card (MulAut (BinaryCarrier m hm)) =
      Nat.card (MulAut.innerSubgroup (BinaryCarrier m hm))*Nat.card (MulAut.Outer (BinaryCarrier m hm)) :=
        (MulAut.innerSubgroup (BinaryCarrier m hm)).card_mul_index.symm
    _ ≤ Nat.card (BinaryCarrier m hm)*(3*m) := Nat.mul_le_mul hi ho
    _ = _ := Nat.mul_comm _ _

/-- The full extension bound gives the field-factor bound for the literal native join. -/
theorem nativeCore_field_bound {m : ℕ} {hm : 0 < m} (E : SourceExtension m hm)
    {M : Type*} [Group M] [Finite M] (c : Completion E M)
    (horder : Nat.card M ≤ Nat.card E.carrier) :
    Nat.card (nativeCore E c) ≤ (3*m)*Nat.card (BinaryCarrier m hm) :=
  (Nat.card_le_card_of_injective _ (nativeCore E c).subtype_injective).trans
    (horder.trans ((Nat.card_le_card_of_injective E.carrier.subtype
      E.carrier.subtype_injective).trans (automorphism_card_le m hm)))

private theorem native_field_factor_gap (m : ℕ) (hm : 1 < m) :
    (3*m) * ((2^m+1) * ((2^m)^8+(2^m)^4+1)) < ((2^m)^3+1)*(2^m)^9 := by
  have hbound (k : ℕ) : 3*k ≤ 4^k := by
    induction k with
    | zero => norm_num
    | succ k ih =>
      have hp : 0 < 4^k := by positivity
      rw [pow_succ]
      omega
  let q := 2^m
  have hq : 4 ≤ q := pow_le_pow_right₀ (by decide : 1 ≤ 2) hm
  have hd : 3*m ≤ q^2 := by
    have hpow : q^2 = 4^m := by
      dsimp [q]
      rw [← pow_mul, Nat.mul_comm m 2, pow_mul]
      norm_num
    rw [hpow]
    exact hbound m
  have h1 : q+1 ≤ 2*q := by omega
  have h2 : q^8+q^4+1 ≤ 2*q^8 := by
    have h4 : 2 ≤ q^4 := (by decide : 2 ≤ 4).trans
      (hq.trans (Nat.le_self_pow (by decide : 4 ≠ 0) _))
    nlinarith [show (q^4)^2 = q^8 by ring]
  have hpos : 0 < q^9 := pow_pos (by omega) _
  calc
    _ ≤ q^2 * ((2*q)*(2*q^8)) := Nat.mul_le_mul hd (Nat.mul_le_mul h1 h2)
    _ = 4*q^11 := by ring
    _ ≤ q*q^11 := Nat.mul_le_mul_right _ hq
    _ = q^12 := by ring
    _ < q^12+q^9 := Nat.lt_add_of_pos_right hpos
    _ = _ := by ring

private def typedEquiv {G : Type*} [Group G] (P : Bool → Subgroup G) (i : Bool) :
    {v : Vertex P // v.type=i} ≃ (G ⧸ P i) where
  toFun v := v.property ▸ v.val.coset
  invFun a := ⟨⟨i,a⟩,rfl⟩
  left_inv := by rintro ⟨⟨j,a⟩,h⟩; dsimp at h; subst j; rfl
  right_inv := by intro a; rfl

private theorem six_endpoint_injective {V : Type*} {Γ : SimpleGraph V}
    (hg : ∀ v (p : Γ.Walk v v), p.IsCycle → 12 < p.length) (x : V) :
    Function.Injective (fun p : {p : BasedWalk Γ 6 x // p.Nonbacktracking} => p.val.endpoint) := by
  intro p q he
  have hp := isPath_of_nonbacktracking_of_cycle_bound hg p.val p.property (by decide : 6≤12)
  have hq := isPath_of_nonbacktracking_of_cycle_bound hg q.val q.property (by decide : 6≤12)
  have hw : p.val.toWalk = q.val.toWalk.copy rfl he.symm := by
    by_contra hne
    obtain ⟨v,_,_,c,hc,hlen⟩ := hp.exists_isCycle_length_le_add_of_ne
      ((Walk.isPath_copy _ rfl he.symm).mpr hq) hne
    have hh := hg v c hc
    simp only [Walk.length_copy,BasedWalk.length_toWalk] at hlen
    omega
  apply Subtype.ext
  apply BasedWalk.vertices_injective
  simpa only [Walk.support_copy,BasedWalk.support_toWalk] using congrArg Walk.support hw

namespace NativeCompletion
variable {m : ℕ} {hm : 0 < m} {M : Type*} [Group M] (c : NativeCompletion m hm M)
local notation "q" => Parameters.q (binaryParameters m hm)

/-- The three short odd path counts retain the native unequal branching factors. -/
theorem card_odd_paths (hoverlap : c.left.range ⊓ c.right.range = c.middle.range) (i : Bool) (k : Fin 3) :
    Nat.card {p : BasedWalk (graph c.cosetFamily) (2*k.val+1) (base c.cosetFamily i) //
      p.Nonbacktracking} = SmallCompletion.degree m hm i * q^(4*k.val) := by
  have hc := card_neighbors c hoverlap
  have (v : Vertex c.cosetFamily) : Finite ((graph c.cosetFamily).neighborSet v) :=
    Nat.finite_of_card_ne_zero (by rw [hc]; exact Nat.ne_of_gt (degree_pos m hm _))
  have hf : ∀ {v w : Vertex c.cosetFamily}, (graph c.cosetFamily).Adj v w → w.type = !v.type := by
    intro v w h
    exact Bool.eq_not_iff.mpr h.1.symm
  rw [card_nonbacktracking_succ (graph c.cosetFamily) (fun v => v.type) (SmallCompletion.degree m hm) hf hc]
  cases i <;> fin_cases k <;> simp [SmallCompletion.degree, forwardCount] <;> ring

/-- The literal six-path count from the arms vertex. -/
theorem card_six_paths
    (hoverlap : c.left.range ⊓ c.right.range = c.middle.range) :
    Nat.card {p : BasedWalk (graph c.cosetFamily) 6 (base c.cosetFamily false) //
      p.Nonbacktracking} = (q^3+1)*q^9 := by
  have hc := card_neighbors c hoverlap
  have (v : Vertex c.cosetFamily) : Finite ((graph c.cosetFamily).neighborSet v) :=
    Nat.finite_of_card_ne_zero (by rw [hc]; exact Nat.ne_of_gt (degree_pos m hm _))
  have hf : ∀ {v w : Vertex c.cosetFamily}, (graph c.cosetFamily).Adj v w → w.type = !v.type :=
    fun h => Bool.eq_not_iff.mpr h.1.symm
  rw [card_nonbacktracking_succ (graph c.cosetFamily) (fun v => v.type) (SmallCompletion.degree m hm) hf hc]
  simp [SmallCompletion.degree, forwardCount]
  ring

/-- The whole cubic field factor still forces a native twelve-cycle at q=4. -/
theorem twelve_cycle_of_field_bound [Finite M] (hm2 : 1 < m)
    (ho : c.left.range ⊓ c.right.range = c.middle.range)
    (horder : Nat.card M ≤ (3*m)*Nat.card (BinaryCarrier m hm)) :
    ∃ v, ∃ p : (graph c.cosetFamily).Walk v v, p.IsCycle ∧ p.length=12 := by
  classical
  by_contra hno
  have hg (v : Vertex c.cosetFamily) (p : (graph c.cosetFamily).Walk v v)
      (hp : p.IsCycle) : 12 < p.length := by
    have hle := c.cycle_length_ge_twelve ho v p hp
    have hne : p.length ≠ 12 := fun hh => hno ⟨v,p,hp,hh⟩
    omega
  let x := base c.cosetFamily false
  let f : {p : BasedWalk (graph c.cosetFamily) 6 x // p.Nonbacktracking} →
      {v : Vertex c.cosetFamily // v.type=false} := fun p =>
    ⟨p.val.endpoint, ((QuadrangleRecognition.even_length_iff
      (G := graph c.cosetFamily) (·.type) (fun h => h.1) p.val.toWalk).mp
        (by simp only [BasedWalk.length_toWalk]; decide)).symm⟩
  let : Finite {v : Vertex c.cosetFamily // v.type=false} := Finite.of_equiv
    (M ⧸ c.cosetFamily false) (typedEquiv c.cosetFamily false).symm
  have hi : Function.Injective f := fun p r h =>
    six_endpoint_injective hg x (congrArg Subtype.val h)
  have hcount := Nat.card_le_card_of_injective f hi
  rw [c.card_six_paths ho,Nat.card_congr (typedEquiv c.cosetFamily false)] at hcount
  have hpar : Nat.card (c.cosetFamily false) = Nat.card (family m hm false) := c.left_card
  have hn : Nat.card (BinaryCarrier m hm) =
      Nat.card (family m hm false)*cosetCount m hm false := by
    rw [←card_coset m hm false]
    exact (family m hm false).card_mul_index.symm
  have hidx : Nat.card (M ⧸ c.cosetFamily false) ≤ (3*m)*cosetCount m hm false := by
    apply Nat.le_of_mul_le_mul_left (c := Nat.card (family m hm false)) _ Nat.card_pos
    calc
      _ = Nat.card M := by rw [←hpar]; exact (c.cosetFamily false).card_mul_index
      _ ≤ (3*m)*Nat.card (BinaryCarrier m hm) := horder
      _ = _ := by rw [hn]; ring
  have hgap := native_field_factor_gap m hm2
  change (3*m)*((2^m+1)*((2^m)^8+(2^m)^4+1)) < _ at hgap
  have hq : q = 2^m := binaryParameters_q m hm
  simp only [cosetCount,SmallCompletion.degree,Bool.not_false,↓reduceIte,hq] at hidx
  rw [hq] at hcount
  exact (not_lt_of_ge (hcount.trans hidx)) hgap

/-- Seven-path transitivity propagates the forced native twelve-cycle. -/
theorem diameter_of_field_bound [Finite M] (hm2 : 1 < m)
    (ho : c.left.range ⊓ c.right.range = c.middle.range)
    (horder : Nat.card M ≤ (3*m)*Nat.card (BinaryCarrier m hm)) :
    ∀ v w, (graph c.cosetFamily).dist v w ≤ 6 := by
  have hex := c.twelve_cycle_of_field_bound hm2 ho horder
  apply HexagonRecognition.diameter_bound_of_seven_endpoint_bound c.connected
  intro v p hp
  exact HexagonRecognition.seven_endpoint_bound c.graphAction (c.seven_transitive ho)
    (·.type) (fun h => h.1) (fun h => (same_orbit_iff c.cosetFamily _ _).mpr h) hex p hp

/-- The field-factor upper bound already determines the exact native order. -/
theorem order_eq_of_field_bound [Finite M] (hm2 : 1 < m)
    (ho : c.left.range ⊓ c.right.range = c.middle.range)
    (horder : Nat.card M ≤ (3*m)*Nat.card (BinaryCarrier m hm)) :
    Nat.card M = Nat.card (BinaryCarrier m hm) := by
  let : Finite (Vertex c.cosetFamily) := Finite.of_equiv _ (vertexEquivSum c.cosetFamily).symm
  let e : {v : Vertex c.cosetFamily // v.type ≠ false} ≃ M ⧸ c.cosetFamily true :=
    { toFun := fun v => (show v.val.type = true by
        cases h : v.val.type with
        | false => exact (v.property h).elim
        | true => rfl) ▸ v.val.coset
      invFun := fun r => ⟨⟨true,r⟩,Bool.noConfusion⟩
      left_inv := by
        rintro ⟨⟨i,r⟩,h⟩
        cases i with
        | false => exact (h rfl).elim
        | true => rfl
      right_inv := fun _ => rfl }
  have hi := card_opposite_of_even_polygon (by decide : 0 < 3) c.connected
    (fun v : Vertex c.cosetFamily => v.type) (fun h => h.1)
    (c.cycle_length_ge_twelve ho) (c.diameter_of_field_bound hm2 ho horder)
    (base c.cosetFamily false)
  change Nat.card {v : Vertex c.cosetFamily // v.type ≠ false} = _ at hi
  rw [Nat.card_congr e] at hi
  simp only [c.card_odd_paths ho] at hi
  have hindex : (c.cosetFamily true).index = (family m hm true).index := by
    rw [(family m hm true).index_eq_card,card_coset m hm true]
    rw [(c.cosetFamily true).index_eq_card,hi]
    simp [Fin.sum_univ_succ,cosetCount,SmallCompletion.degree]
    ring
  have hpar : Nat.card (c.cosetFamily true) = Nat.card (family m hm true) := c.right_card
  calc
    Nat.card M = Nat.card (c.cosetFamily true) * (c.cosetFamily true).index :=
      (c.cosetFamily true).card_mul_index.symm
    _ = Nat.card (family m hm true) * (family m hm true).index := by rw [hpar,hindex]
    _ = Nat.card (BinaryCarrier m hm) := (family m hm true).card_mul_index
end NativeCompletion

variable {m : ℕ} {hm : 0 < m} (E : SourceExtension m hm)
variable {M : Type*} [Group M] [Finite M] (c : Completion E M)

/-- The literal normal native subgroup has exactly the native triality order. -/
theorem nativeCore_order_eq (hm2 : 1 < m)
    (ho : c.left.range ⊓ c.right.range = c.middle.range)
    (horder : Nat.card M ≤ Nat.card E.carrier) :
    Nat.card (nativeCore E c) = Nat.card (BinaryCarrier m hm) :=
  (nativeCompletion E c).order_eq_of_field_bound hm2
    (nativeCompletion_overlap E c ho) (nativeCore_field_bound E c horder)

/-- The native subgroup's own graph, with its native Borel, has diameter six. -/
theorem nativeCore_diameter_le (hm2 : 1 < m)
    (ho : c.left.range ⊓ c.right.range = c.middle.range)
    (horder : Nat.card M ≤ Nat.card E.carrier) :
    ∀ v w, (graph (nativeCompletion E c).cosetFamily).dist v w ≤ 6 :=
  (nativeCompletion E c).diameter_of_field_bound hm2
    (nativeCompletion_overlap E c ho) (nativeCore_field_bound E c horder)

end CFSG.Quasithin.ChapterF.SourceCompletion.TrialityNonbinary
