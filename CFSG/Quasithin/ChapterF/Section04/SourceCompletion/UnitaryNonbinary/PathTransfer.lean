module
public import CFSG.Quasithin.ChapterF.Section04.SourceCompletion.UnitaryNonbinary.Generated
public import CFSG.Quasithin.ChapterF.Section04.SourceCompletion.UnitaryNonbinary.Geometry
public import Theory.GroupAction.RankTwoCosetGeometry.EndpointRestriction

/-!
# Whole-overlap path transfer without a generation premise

Restrict the full extension action to the subgroup generated by its literal
endpoints. Root-fixing actors already lie there. The universal overlap cover
then transfers the native rooted action to any faithful completion with the
whole overlap, retaining even outer degree.

Source: Aschbacher–Smith F.4.3–6, `refs/quasithin.pdf`, pp.274–278.
-/

public noncomputable section

namespace CFSG.Quasithin.ChapterF.SourceCompletion.UnitaryNonbinary.SourceExtension
open Subgroup Theory.GroupTheory Subgroup.CosetGeometry.RankTwo
open SimpleGraph SimpleGraph.PathTransitivePolygon
variable {B : Type*} [Group B] {P₀ P₁ : Subgroup B}
variable (E : SourceExtension P₀ P₁)

theorem completion_rootPathTransitive_of_native_without_generation
    (hi : Function.Injective (MulAut.conj : B →* MulAut B))
    {M : Type*} [Group M]
    (c : RankTwoAmalgam.FaithfulCompletion E.amalgam (G := M))
    (hoverlap : c.left.range ⊓ c.right.range = c.middle.range)
    (i : Bool) (n : ℕ)
    (ht : RootPathTransitive (graph (nativeFamily (P₀ := P₀) (P₁ := P₁))) B
      (base (nativeFamily (P₀ := P₀) (P₁ := P₁)) i) n) :
    RootPathTransitive (graph c.cosetFamily) M (base c.cosetFamily i) n := by
  let d := Generated.completion E.left E.right
  apply RankTwoAmalgam.Universal.rootPathTransitive_transfer_of_overlap E.amalgam
    d c (Generated.whole_overlap E.left E.right) hoverlap i n
  let f : (E.left ⊔ E.right : Subgroup (MulAut B)) →* E.carrier :=
    inclusion (sup_le E.left_le E.right_le)
  have hp (j : Bool) : (E.family j).comap f = d.cosetFamily j := by
    cases j
    · change _ = d.left.range
      rw [show d.left.range = E.left.subgroupOf (E.left ⊔ E.right) from
        RankTwoAmalgam.FaithfulCompletion.ofGeneratedSubgroups_left_range _ _ _ _ _]
      rfl
    · change _ = d.right.range
      rw [show d.right.range = E.right.subgroupOf (E.left ⊔ E.right) from
        RankTwoAmalgam.FaithfulCompletion.ofGeneratedSubgroups_right_range _ _ _ _ _]
      rfl
  apply ExtensionGeometry.rootPathTransitive_of_range d.cosetFamily E.family f hp i n
  · intro a ha
    have hj : (a : MulAut B) ∈ E.left ⊔ E.right := by
      cases i
      · exact (show E.left ≤ E.left ⊔ E.right from le_sup_left) ha
      · exact (show E.right ≤ E.left ⊔ E.right from le_sup_right) ha
    exact ⟨⟨a,hj⟩,rfl⟩
  · exact E.rootPathTransitive_of_native hi i n ht
end CFSG.Quasithin.ChapterF.SourceCompletion.UnitaryNonbinary.SourceExtension
