module
public import CFSG.Quasithin.ChapterF.Section04.SourceCompletion.UnitaryNonbinary.FiveCensus
public import CFSG.Quasithin.ChapterF.Section04.SourceCompletion.UnitaryNonbinary.PathTransfer
public import Theory.SpecificGroups.ClassicalUnitary.SmallCompletion.FivePaths.Apartment
public import Theory.SpecificGroups.ClassicalUnitary.FiveFourParabolicCardinality

/-!
# Five-path transitivity for full PSU₅(4) extension completions

The native hyperbolic apartment has five-path fixer of order at most 225
in SU₅. Orbit–stabilizer and the actual 65/17 valencies give transitivity.
The scalar projective kernel of order five is retained. For transfer we
first use the literal subgroup generated by the full extension endpoints;
root stabilizers lie in that subgroup, so native generation is not an
additional assumption. The whole-overlap cover then transfers the action
to every marked faithful completion, including even outer degree.

Source: Aschbacher–Smith F.4.5–6, pp.275–278 of `refs/quasithin.pdf`.
-/

public noncomputable section
namespace CFSG.Quasithin.ChapterF.SourceCompletion.UnitaryNonbinary
open Subgroup Theory.GroupTheory
open Subgroup.CosetGeometry hiding Vertex base
open Subgroup.CosetGeometry.RankTwo SimpleGraph SimpleGraph.PathTransitivePolygon
open Theory.SpecificGroups.UnitaryFive
variable (U : GreenBook.UnitaryFive.Model 4)

private theorem matrix_preimage (i : Bool) :
    (SourceExtension.nativeFamily (P₀ := U.leftParabolic) (P₁ := U.rightParabolic) i).comap
      (project U.form) = fiveMatrixFamily U i := by
  cases i <;> exact Subgroup.comap_map_eq_self (ker_project_le_specialStabilizer U.form _)

private theorem matrix_representative (a : U.Carrier) :
    ∃ b : U.form.specialSubgroup, (project U.form b)⁻¹*a ∈ U.leftParabolic ⊓ U.rightParabolic := by
  obtain ⟨b,rfl⟩ := project_surjective U.form a
  exact ⟨b,by simp⟩

private def projectionIso := ExtensionGeometry.graphIso (fiveMatrixFamily U)
  (SourceExtension.nativeFamily (P₀ := U.leftParabolic) (P₁ := U.rightParabolic))
  (project U.form) (matrix_preimage U) (matrix_representative U)

private theorem matrix_card_neighbors (v : Vertex (fiveMatrixFamily U)) :
    Nat.card ((graph (fiveMatrixFamily U)).neighborSet v) = fiveDegree v.type :=
  (Nat.card_congr ((projectionIso U).mapNeighborSet v)).trans
    (five_native_card_neighbors U (projectionIso U v))

private theorem matrix_card_endpoint (i : Bool) :
    Nat.card (fiveMatrixFamily U i) = fiveDegree i * 1048576 * 225 := by
  cases i
  · change Nat.card (specialStabilizer U.form (line U.F)) = _
    rw [card_specialStabilizer U.form U.conjugation U.card]
    change 5 * Nat.card (lineParabolic U.form) = _
    rw [card_lineParabolic_four U.form U.card U.conjugation U.matrix]
    norm_num [fiveDegree]
  · change Nat.card (specialStabilizer U.form (plane U.F)) = _
    rw [card_specialStabilizer U.form U.conjugation U.card]
    change 5 * Nat.card (planeParabolic U.form) = _
    rw [card_planeParabolic_four U.form U.card U.conjugation U.matrix]
    norm_num [fiveDegree]

private theorem matrix_card_stabilizer (v : Vertex (fiveMatrixFamily U)) :
    Nat.card (MulAction.stabilizer U.form.specialSubgroup v) = fiveDegree v.type * 1048576 * 225 := by
  obtain ⟨g,hg⟩ := exists_smul_base (fiveMatrixFamily U) v
  rw [←hg,MulAction.stabilizer_smul_eq_stabilizer_map_conj,
    Subgroup.card_map_of_injective (MulAut.conj g).injective,CosetGeometry.stabilizer_base]
  exact matrix_card_endpoint U v.type

private theorem matrix_card_five_paths (v : Vertex (fiveMatrixFamily U)) :
    Nat.card {p : BasedWalk (graph (fiveMatrixFamily U)) 5 v // p.Nonbacktracking} =
      fiveDegree v.type * 1048576 := by
  have hc := matrix_card_neighbors U
  have (v : Vertex (fiveMatrixFamily U)) : Finite ((graph (fiveMatrixFamily U)).neighborSet v) :=
    Nat.finite_of_card_ne_zero (by rw [hc]; cases v.type <;> decide)
  have hf : ∀ {v w : Vertex (fiveMatrixFamily U)}, (graph (fiveMatrixFamily U)).Adj v w → w.type = !v.type := by
    intro v w h
    have hh := h.1
    cases hv : v.type <;> cases hw : w.type <;> simp_all
  have hh := BasedWalk.card_nonbacktracking_succ (graph (fiveMatrixFamily U))
    (fun v => v.type) fiveDegree hf hc 4 v
  change Nat.card {p : BasedWalk (graph (fiveMatrixFamily U)) (4+1) v // p.Nonbacktracking} = _
  rw [hh]
  cases v.type <;> norm_num [fiveDegree,BasedWalk.forwardCount]

private theorem matrix_transitive_of_fixer_bound {v : Vertex (fiveMatrixFamily U)}
    (p : BasedWalk (graph (fiveMatrixFamily U)) 5 v) (hp : p.Nonbacktracking)
    (hc : Nat.card (pathStabilizer (fiveMatrixFamily U) p) ≤ 225) :
    RootPathTransitive (graph (fiveMatrixFamily U)) U.form.specialSubgroup v 5 := by
  have : Finite {p : BasedWalk (graph (fiveMatrixFamily U)) 5 v // p.Nonbacktracking} :=
    Nat.finite_of_card_ne_zero (by rw [matrix_card_five_paths]; cases v.type <;> decide)
  apply rootPathTransitive_of_pathStabilizer_card_le (fiveMatrixFamily U) p hp (by decide : 0 < 225) hc
  rw [matrix_card_stabilizer,matrix_card_five_paths]

private theorem matrix_rootPathTransitive_five (i : Bool) :
    RootPathTransitive (graph (fiveMatrixFamily U)) U.form.specialSubgroup (base _ i) 5 := by
  obtain ⟨t,ht⟩ := RadicalCentralizers.exists_trace_one U.form U.conjugation U.card
  have hb : Nat.card (pathStabilizer (fiveMatrixFamily U)
      (SmallCompletion.FivePaths.fivePath U.form t ht U.matrix)) ≤ 225 := by
    have hh := SmallCompletion.FivePaths.fivePath_fixer_card U.form t ht U.matrix
    simpa [U.card] using hh
  cases i
  · simpa only [SmallCompletion.FivePaths.apartmentVertex,pow_zero,one_smul] using
      matrix_transitive_of_fixer_bound U _
        (SmallCompletion.FivePaths.fivePath_nonbacktracking U.form t ht U.matrix) hb
  · have hfix : Nat.card (pathStabilizer (fiveMatrixFamily U)
        (SmallCompletion.FivePaths.reverseFivePath U.form t ht U.matrix)) ≤ 225 := by
      rw [SmallCompletion.FivePaths.reverseFivePath_fixer]
      exact hb
    have hh := matrix_transitive_of_fixer_bound U _
      (SmallCompletion.FivePaths.reverseFivePath_nonbacktracking U.form t ht U.matrix) hfix
    have hact : GraphAction (graph (fiveMatrixFamily U)) U.form.specialSubgroup :=
      ⟨fun g _ _ h => (translationGraphIso _ g).toHom.map_adj h⟩
    have hg := RootPathTransitive.smul hact hh
      ((SmallCompletion.FivePaths.rotation U.form t ht U.matrix ^ 2)⁻¹)
    simpa only [SmallCompletion.FivePaths.apartmentVertex,inv_smul_smul] using hg

/-- Five-path transitivity in the actual projective Hermitian flag graph. -/
theorem five_native_rootPathTransitive_five (i : Bool) :
    RootPathTransitive (graph (SourceExtension.nativeFamily
      (P₀ := U.leftParabolic) (P₁ := U.rightParabolic))) U.Carrier (base _ i) 5 := by
  let e := projectionIso U
  have he : e (base (fiveMatrixFamily U) i) = base _ i :=
    ExtensionGeometry.vertex_base _ _ _ _ i
  rw [← he]
  exact RootPathTransitive.map_graphIso e (project U.form)
    (ExtensionGeometry.vertex_smul _ _ _ _) (matrix_rootPathTransitive_five U i)

end CFSG.Quasithin.ChapterF.SourceCompletion.UnitaryNonbinary
