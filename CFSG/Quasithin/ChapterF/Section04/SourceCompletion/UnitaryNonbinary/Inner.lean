module
public import CFSG.Quasithin.ChapterF.Section04.SourceCompletion.UnitaryNonbinary.Generated
public import Mathlib.Algebra.Group.Subgroup.Pointwise
public import Mathlib.GroupTheory.Subgroup.Simple

/-!
# The normal subamalgam generated by native unitary endpoints

Inside any faithful completion of a full source extension, the two native
endpoint images generate a normal subgroup. Their relative normality and
inner-times-overlap factorization prove this, without an assumption on the
outer degree. The same literal maps give a faithful completion of the native
projective amalgam inside that subgroup, with the whole overlap retained.
Its index divides the actual outer index of the original extension.

This constructs a normal subgroup and its marked local maps, not an
isomorphism from the native group: the global relations still need proof.
In particular the index divisibility is not an equality statement.
Source: the normal-inner-group step of Aschbacher–Smith F.4.3 and F.4.17,
printed pp.274,282–283, with the F.4.9 distinction between extensions retained.
-/

@[expose] public noncomputable section
namespace CFSG.Quasithin.ChapterF.SourceCompletion.UnitaryNonbinary.SourceExtension
open Subgroup Theory.GroupTheory
variable {B : Type*} [Group B] {P₀ P₁ : Subgroup B}
variable (E : SourceExtension P₀ P₁)

private theorem inner_normal : (inner B).Normal where
  conj_mem a ha g := by
    obtain ⟨b,rfl⟩ := ha
    refine ⟨g b, ?_⟩
    ext x
    simp [MulAut.conj_apply, map_mul]

def nativeLeft : P₀ →* E.left :=
  (MulAut.conj.comp P₀.subtype).codRestrict E.left (fun p =>
    (E.left_inner.symm ▸ (show MulAut.conj (p : B) ∈ P₀.map MulAut.conj from
      ⟨p,p.property,rfl⟩)).1)

def nativeRight : P₁ →* E.right :=
  (MulAut.conj.comp P₁.subtype).codRestrict E.right (fun p =>
    (E.right_inner.symm ▸ (show MulAut.conj (p : B) ∈ P₁.map MulAut.conj from
      ⟨p,p.property,rfl⟩)).1)

private theorem nativeLeft_range : E.nativeLeft.range = (inner B).subgroupOf E.left := by
  ext a
  constructor
  · rintro ⟨b,rfl⟩
    exact ⟨b,rfl⟩
  · intro ha
    have hm : a.val ∈ P₀.map MulAut.conj := E.left_inner ▸ ⟨a.property,ha⟩
    obtain ⟨b,hb,he⟩ := hm
    exact ⟨⟨b,hb⟩,Subtype.ext he⟩

private theorem nativeRight_range : E.nativeRight.range = (inner B).subgroupOf E.right := by
  ext a
  constructor
  · rintro ⟨b,rfl⟩
    exact ⟨b,rfl⟩
  · intro ha
    have hm : a.val ∈ P₁.map MulAut.conj := E.right_inner ▸ ⟨a.property,ha⟩
    obtain ⟨b,hb,he⟩ := hm
    exact ⟨⟨b,hb⟩,Subtype.ext he⟩

variable {M : Type*} [Group M]
variable (c : RankTwoAmalgam.FaithfulCompletion E.amalgam (G := M))

def innerLeft : P₀ →* M := c.left.comp E.nativeLeft
def innerRight : P₁ →* M := c.right.comp E.nativeRight

def innerGenerated : Subgroup M := (E.innerLeft c).range ⊔ (E.innerRight c).range

private theorem left_normalizes_innerLeft :
    c.left.range ≤ normalizer ((E.innerLeft c).range : Set M) := by
  let : (inner B).Normal := inner_normal
  have hn : E.nativeLeft.range.Normal := E.nativeLeft_range ▸ inferInstance
  have h := E.nativeLeft.range.le_normalizer_map c.left
  rw [@normalizer_eq_top _ _ _ hn, ← MonoidHom.range_eq_map, ← MonoidHom.range_comp] at h
  exact h

private theorem right_normalizes_innerRight :
    c.right.range ≤ normalizer ((E.innerRight c).range : Set M) := by
  let : (inner B).Normal := inner_normal
  have hn : E.nativeRight.range.Normal := E.nativeRight_range ▸ inferInstance
  have h := E.nativeRight.range.le_normalizer_map c.right
  rw [@normalizer_eq_top _ _ _ hn, ← MonoidHom.range_eq_map, ← MonoidHom.range_comp] at h
  exact h

private theorem middle_normalizes_innerGenerated :
    c.middle.range ≤ normalizer (E.innerGenerated c : Set M) :=
  (le_inf (c.middle_le_left.trans (E.left_normalizes_innerLeft c))
    (c.middle_le_right.trans (E.right_normalizes_innerRight c))).trans
      (normalizer_inf_normalizer_le_normalizer_sup _ _)

/-- The subgroup generated by the two native endpoint images is normal in
any faithful full-extension completion. This does not identify that subgroup. -/
theorem innerGenerated_normal
    (hi : Function.Injective (MulAut.conj : B →* MulAut B)) :
    (E.innerGenerated c).Normal := by
  apply normalizer_eq_top_iff.mp
  apply top_unique
  rw [← c.generated]
  apply sup_le
  · rintro _ ⟨a,rfl⟩
    obtain ⟨b,hb,d,hd,he⟩ := E.left_factor hi a a.property
    have ha : a = E.nativeLeft ⟨b,hb⟩ * E.amalgam.left ⟨d,hd⟩ := Subtype.ext he
    rw [ha,map_mul]
    exact (normalizer (E.innerGenerated c : Set M)).mul_mem
      (le_normalizer (show E.innerLeft c ⟨b,hb⟩ ∈ E.innerGenerated c from
        Subgroup.mem_sup_left ⟨⟨b,hb⟩,rfl⟩))
      (E.middle_normalizes_innerGenerated c ⟨⟨d,hd⟩,rfl⟩)
  · rintro _ ⟨a,rfl⟩
    obtain ⟨b,hb,d,hd,he⟩ := E.right_factor hi a a.property
    have ha : a = E.nativeRight ⟨b,hb⟩ * E.amalgam.right ⟨d,hd⟩ := Subtype.ext he
    rw [ha,map_mul]
    have he' := DFunLike.congr_fun c.compatible ⟨d,hd⟩
    change c.middle ⟨d,hd⟩ = c.right (E.amalgam.right ⟨d,hd⟩) at he'
    rw [← he']
    exact (normalizer (E.innerGenerated c : Set M)).mul_mem
      (le_normalizer (show E.innerRight c ⟨b,hb⟩ ∈ E.innerGenerated c from
        Subgroup.mem_sup_right ⟨⟨b,hb⟩,rfl⟩))
      (E.middle_normalizes_innerGenerated c ⟨⟨d,hd⟩,rfl⟩)

/-- The original whole overlap supplements the normal native-generated subgroup. -/
theorem innerGenerated_sup_middle
    (hi : Function.Injective (MulAut.conj : B →* MulAut B)) :
    E.innerGenerated c ⊔ c.middle.range = ⊤ := by
  apply top_unique
  rw [← c.generated]
  apply sup_le
  · rintro _ ⟨a,rfl⟩
    obtain ⟨b,hb,d,hd,he⟩ := E.left_factor hi a a.property
    have ha : a = E.nativeLeft ⟨b,hb⟩ * E.amalgam.left ⟨d,hd⟩ := Subtype.ext he
    rw [ha,map_mul]
    exact (E.innerGenerated c ⊔ c.middle.range).mul_mem
      (Subgroup.mem_sup_left (Subgroup.mem_sup_left ⟨⟨b,hb⟩,rfl⟩)) (Subgroup.mem_sup_right ⟨⟨d,hd⟩,rfl⟩)
  · rintro _ ⟨a,rfl⟩
    obtain ⟨b,hb,d,hd,he⟩ := E.right_factor hi a a.property
    have ha : a = E.nativeRight ⟨b,hb⟩ * E.amalgam.right ⟨d,hd⟩ := Subtype.ext he
    rw [ha,map_mul]
    have he' := DFunLike.congr_fun c.compatible ⟨d,hd⟩
    change c.middle ⟨d,hd⟩ = c.right (E.amalgam.right ⟨d,hd⟩) at he'
    rw [← he']
    exact (E.innerGenerated c ⊔ c.middle.range).mul_mem
      (Subgroup.mem_sup_left (Subgroup.mem_sup_right ⟨⟨b,hb⟩,rfl⟩)) (Subgroup.mem_sup_right ⟨⟨d,hd⟩,rfl⟩)


abbrev nativeAmalgam : RankTwoAmalgam P₀ (P₀ ⊓ P₁ : Subgroup B) P₁ :=
  .ofSubgroups P₀ (P₀ ⊓ P₁) P₁ inf_le_left inf_le_right

private theorem native_compatible :
    (E.innerLeft c).comp (nativeAmalgam (P₀ := P₀) (P₁ := P₁)).left =
      (E.innerRight c).comp (nativeAmalgam (P₀ := P₀) (P₁ := P₁)).right := by
  ext p
  let d : E.middle := ⟨MulAut.conj (p : B),
    (E.nativeLeft ⟨p,p.property.1⟩).property,
    (E.nativeRight ⟨p,p.property.2⟩).property⟩
  exact DFunLike.congr_fun c.compatible d

/-- The marked native parabolics complete faithfully in their generated
normal subgroup, without assuming that they complete to the native group. -/
def innerCompletion (hi : Function.Injective (MulAut.conj : B →* MulAut B)) :
    RankTwoAmalgam.FaithfulCompletion
      (nativeAmalgam (P₀ := P₀) (P₁ := P₁)) (G := E.innerGenerated c) where
  left := (E.innerLeft c).codRestrict _ (fun p => Subgroup.mem_sup_left ⟨p,rfl⟩)
  right := (E.innerRight c).codRestrict _ (fun p => Subgroup.mem_sup_right ⟨p,rfl⟩)
  compatible := by
    ext p
    exact DFunLike.congr_fun (E.native_compatible c) p
  left_injective := by
    intro p q h
    apply Subtype.ext
    apply hi
    exact congrArg Subtype.val (c.left_injective (congrArg Subtype.val h))
  right_injective := by
    intro p q h
    apply Subtype.ext
    apply hi
    exact congrArg Subtype.val (c.right_injective (congrArg Subtype.val h))
  middle_injective := by
    intro p q h
    apply Subtype.ext
    apply hi
    exact congrArg Subtype.val (c.left_injective (congrArg Subtype.val h))
  generated := by
    apply Subgroup.map_injective (E.innerGenerated c).subtype_injective
    rw [Subgroup.map_sup, MonoidHom.map_range, MonoidHom.map_range,
      ← MonoidHom.range_eq_map, range_subtype]
    rfl

/-- Whole overlap restricts to the native subamalgam; the order-five SU₅
kernel is never removed, since the base here is the projective group. -/
theorem innerCompletion_overlap
    (hi : Function.Injective (MulAut.conj : B →* MulAut B))
    (ho : c.left.range ⊓ c.right.range = c.middle.range) :
    (E.innerCompletion c hi).left.range ⊓ (E.innerCompletion c hi).right.range =
      (E.innerCompletion c hi).middle.range := by
  apply le_antisymm _ (le_inf (E.innerCompletion c hi).middle_le_left
    (E.innerCompletion c hi).middle_le_right)
  rintro x ⟨⟨p,hp⟩,⟨q,hq⟩⟩
  have hp' : E.innerLeft c p = x.val := congrArg Subtype.val hp
  have hq' : E.innerRight c q = x.val := congrArg Subtype.val hq
  have hx : x.val ∈ c.left.range ⊓ c.right.range :=
    ⟨⟨E.nativeLeft p,hp'⟩,⟨E.nativeRight q,hq'⟩⟩
  rw [ho] at hx
  obtain ⟨d,hd⟩ := hx
  have hpd : E.nativeLeft p = E.amalgam.left d :=
    c.left_injective (hp'.trans hd.symm)
  have hqd : E.nativeRight q = E.amalgam.right d := by
    apply c.right_injective
    exact hq'.trans (hd.symm.trans (DFunLike.congr_fun c.compatible d))
  have hpq : (p : B) = q := hi ((congrArg Subtype.val hpd).trans
    (congrArg Subtype.val hqd).symm)
  let z : (P₀ ⊓ P₁ : Subgroup B) := ⟨p,p.property,hpq ▸ q.property⟩
  refine ⟨z, ?_⟩
  exact hp


/-- The actual inner part of the full overlap, as a relative subgroup. -/
abbrev nativeOverlap : Subgroup E.middle := (inner B).subgroupOf E.middle

private theorem nativeOverlap_le_comap_innerGenerated
    (hi : Function.Injective (MulAut.conj : B →* MulAut B)) :
    E.nativeOverlap ≤ (E.innerGenerated c).comap c.middle := by
  intro d hd
  obtain ⟨b,hb⟩ := hd
  have hbl : b ∈ P₀ := (E.conj_mem_left_iff hi b).mp (hb.symm ▸ d.property.1)
  have he : E.nativeLeft ⟨b,hbl⟩ = E.amalgam.left d := Subtype.ext hb
  change c.left (E.amalgam.left d) ∈ E.innerGenerated c
  rw [← he]
  exact Subgroup.mem_sup_left ⟨⟨b,hbl⟩,rfl⟩

/-- The native-generated subgroup can absorb part of the outer overlap.
Its index therefore divides the original outer index; equality is not asserted. -/
theorem innerGenerated_index_dvd
    (hi : Function.Injective (MulAut.conj : B →* MulAut B)) :
    (E.innerGenerated c).index ∣ E.nativeOverlap.index := by
  let : (E.innerGenerated c).Normal := E.innerGenerated_normal c hi
  have he : (E.innerGenerated c).index =
      ((E.innerGenerated c).comap c.middle).index := by
    rw [index_comap, ← relIndex_sup_left,
      E.innerGenerated_sup_middle c hi, relIndex_top_right]
  rw [he]
  exact index_dvd_of_le (E.nativeOverlap_le_comap_innerGenerated c hi)

/-- In the original extension this index is precisely the full outer degree. -/
theorem nativeOverlap_index_eq :
    E.nativeOverlap.index = E.baseHom.range.index := by
  let j : E.middle →* E.carrier := inclusion (inf_le_left.trans E.left_le)
  have hr : E.baseHom.range = (inner B).subgroupOf E.carrier := by
    ext a
    constructor
    · rintro ⟨b,rfl⟩
      exact ⟨b,rfl⟩
    · rintro ⟨b,hb⟩
      exact ⟨b,Subtype.ext hb⟩
  let : (inner B).Normal := inner_normal
  have hn : E.baseHom.range.Normal := hr ▸ inferInstance
  let : E.baseHom.range.Normal := hn
  have hpre : E.baseHom.range.comap j = E.nativeOverlap := by
    rw [hr]
    rfl
  have hgen : E.baseHom.range ⊔ j.range = ⊤ := by
    apply top_unique
    intro a _
    obtain ⟨b,d,hd,he⟩ := E.factor a a.property
    have ha : a = E.baseHom b * j ⟨d,hd⟩ := Subtype.ext he
    rw [ha]
    exact (E.baseHom.range ⊔ j.range).mul_mem
      (Subgroup.mem_sup_left ⟨b,rfl⟩) (Subgroup.mem_sup_right ⟨⟨d,hd⟩,rfl⟩)
  rw [← hpre, index_comap, ← relIndex_sup_left, hgen, relIndex_top_right]

/-- The full extension order retains its actual outer degree, including
any even factor. -/
theorem carrier_card_eq_base_mul_outer
    (hi : Function.Injective (MulAut.conj : B →* MulAut B)) :
    Nat.card E.carrier = Nat.card B * E.nativeOverlap.index := by
  rw [E.nativeOverlap_index_eq, ← E.baseHom.range.card_mul_index,
    ← Nat.card_congr (MonoidHom.ofInjective (E.baseHom_injective hi)).toEquiv]


/-- A nontrivial native endpoint makes its normal generated subgroup nontrivial. -/
theorem innerGenerated_ne_bot [Nontrivial P₀]
    (hi : Function.Injective (MulAut.conj : B →* MulAut B)) :
    E.innerGenerated c ≠ ⊥ := by
  obtain ⟨p,hp⟩ := exists_ne (1 : P₀)
  intro hb
  have he : E.innerLeft c p = 1 := mem_bot.mp (hb ▸
    (show E.innerLeft c p ∈ E.innerGenerated c from Subgroup.mem_sup_left ⟨p,rfl⟩))
  apply hp
  apply Subtype.ext
  apply hi
  have he' : c.left (E.nativeLeft p) = c.left (E.nativeLeft 1) := by
    simpa only [innerLeft, MonoidHom.comp_apply, map_one] using he
  exact congrArg Subtype.val (c.left_injective he')

/-- Simplicity of the completion makes the native endpoint images generate
it, without identifying the completion with the native projective group. -/
theorem innerGenerated_eq_top_of_simple [IsSimpleGroup M] [Nontrivial P₀]
    (hi : Function.Injective (MulAut.conj : B →* MulAut B)) :
    E.innerGenerated c = ⊤ :=
  (E.innerGenerated_normal c hi).eq_bot_or_eq_top.resolve_left
    (E.innerGenerated_ne_bot c hi)


/-- When the normal native-generated subgroup is the whole completion,
the literal native endpoint maps themselves form an ambient completion. -/
def nativeCompletionOfTop
    (hi : Function.Injective (MulAut.conj : B →* MulAut B))
    (ht : E.innerGenerated c = ⊤) :
    RankTwoAmalgam.FaithfulCompletion
      (nativeAmalgam (P₀ := P₀) (P₁ := P₁)) (G := M) where
  left := E.innerLeft c
  right := E.innerRight c
  compatible := by exact E.native_compatible c
  left_injective := by
    intro p q he
    apply (E.innerCompletion c hi).left_injective
    exact Subtype.ext he
  right_injective := by
    intro p q he
    apply (E.innerCompletion c hi).right_injective
    exact Subtype.ext he
  middle_injective := by
    intro p q he
    apply (E.innerCompletion c hi).middle_injective
    exact Subtype.ext he
  generated := ht

theorem nativeCompletionOfTop_overlap
    (hi : Function.Injective (MulAut.conj : B →* MulAut B))
    (ht : E.innerGenerated c = ⊤)
    (ho : c.left.range ⊓ c.right.range = c.middle.range) :
    (E.nativeCompletionOfTop c hi ht).left.range ⊓
      (E.nativeCompletionOfTop c hi ht).right.range =
      (E.nativeCompletionOfTop c hi ht).middle.range := by
  have h := congrArg (fun K : Subgroup (E.innerGenerated c) =>
    K.map (E.innerGenerated c).subtype) (E.innerCompletion_overlap c hi ho)
  rw [Subgroup.map_inf _ _ _ (E.innerGenerated c).subtype_injective,
    MonoidHom.map_range, MonoidHom.map_range, MonoidHom.map_range] at h
  exact h

end CFSG.Quasithin.ChapterF.SourceCompletion.UnitaryNonbinary.SourceExtension
