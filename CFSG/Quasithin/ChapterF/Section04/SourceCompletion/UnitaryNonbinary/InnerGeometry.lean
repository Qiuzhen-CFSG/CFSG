module
public import CFSG.Quasithin.ChapterF.Section04.SourceCompletion.UnitaryNonbinary.Inner
public import CFSG.Quasithin.ChapterF.Section04.SourceCompletion.UnitaryNonbinary.FiveCensus
public import CFSG.Quasithin.ChapterF.Section04.SourceCompletion.UnitaryNonbinary.FourOrder

/-!
# Native-generated normal subgroups acting on the unitary completion geometry

The whole overlap supplements the normal subgroup generated by the native
endpoint images. Hence every full-extension coset flag has a simultaneous
representative in that normal subgroup. It is transitive on each vertex
type, including the unequal-valence PSU₅(4) graph. Both concrete branches
inherit faithful native subamalgam completions with their whole overlaps.
For U₄ the proved order equality makes the order of this normal subgroup
an integral multiple of the native projective order. Nothing here identifies
the subgroup or eliminates that possible extra factor.

Source: Aschbacher–Smith F.4.3–6,13,17, printed pp.274–280,282–283.
-/

@[expose] public noncomputable section
namespace CFSG.Quasithin.ChapterF.SourceCompletion.UnitaryNonbinary
open Subgroup Theory.GroupTheory
open Subgroup.CosetGeometry hiding Vertex base
open Subgroup.CosetGeometry.RankTwo

namespace SourceExtension
variable {B : Type*} [Group B] {P₀ P₁ : Subgroup B}
variable (E : SourceExtension P₀ P₁) {M : Type*} [Group M]
variable (c : RankTwoAmalgam.FaithfulCompletion E.amalgam (G := M))

/-- One native-generated representative works simultaneously for both
cosets of a flag, even for extensions of even outer degree. -/
theorem innerGenerated_flag_representative
    (hi : Function.Injective (MulAut.conj : B →* MulAut B)) (g : M) :
    ∃ a : E.innerGenerated c, ∀ i : Bool,
      (a.val : M ⧸ c.cosetFamily i) = g := by
  let : (E.innerGenerated c).Normal := E.innerGenerated_normal c hi
  obtain ⟨a,ha,d,hd,he⟩ := mem_sup_of_normal_left.mp
    (show g ∈ E.innerGenerated c ⊔ c.middle.range by
      rw [E.innerGenerated_sup_middle c hi]; trivial)
  refine ⟨⟨a,ha⟩, fun i => QuotientGroup.eq.mpr ?_⟩
  rw [← he,inv_mul_cancel_left]
  cases i
  · exact c.middle_le_left hd
  · exact c.middle_le_right hd

/-- The native-generated normal subgroup has the full two vertex orbits. -/
theorem innerGenerated_vertex_transitive
    (hi : Function.Injective (MulAut.conj : B →* MulAut B))
    (v : Vertex c.cosetFamily) :
    ∃ a : E.innerGenerated c, a.val • base c.cosetFamily v.type = v := by
  obtain ⟨g,hg⟩ := exists_smul_base c.cosetFamily v
  obtain ⟨a,ha⟩ := E.innerGenerated_flag_representative c hi g
  refine ⟨a, ?_⟩
  rw [← hg]
  change mkVertex c.cosetFamily v.type (a.val*1) = mkVertex c.cosetFamily v.type (g*1)
  simp only [mul_one]
  exact congrArg (Subgroup.CosetGeometry.Vertex.mk v.type) (ha v.type)

/-- The full endpoint stabilizers restricted to the native-generated group.
They are not identified with the smaller native endpoint images. -/
abbrev innerFamily (i : Bool) : Subgroup (E.innerGenerated c) :=
  (c.cosetFamily i).subgroupOf (E.innerGenerated c)

/-- Restricting the full graph to the normal native-generated group changes
neither vertices nor incidence, since its representative covers a whole flag. -/
def innerGenerated_graphIso
    (hi : Function.Injective (MulAut.conj : B →* MulAut B)) :
    graph (E.innerFamily c) ≃g graph c.cosetFamily :=
  ExtensionGeometry.graphIso (E.innerFamily c) c.cosetFamily
    (E.innerGenerated c).subtype (fun _ => rfl) (by
      intro g
      obtain ⟨a,ha⟩ := E.innerGenerated_flag_representative c hi g
      exact ⟨a,QuotientGroup.eq.mp (ha false),QuotientGroup.eq.mp (ha true)⟩)

/-- With equal full-extension orders, the possible growth of the native
subcompletion is measured exactly by a divisor of the original outer degree. -/
theorem innerGenerated_order_multiple [Finite B] [Finite M]
    (hi : Function.Injective (MulAut.conj : B →* MulAut B))
    (hc : Nat.card M = Nat.card E.carrier) :
    ∃ k : ℕ, 0 < k ∧ Nat.card (E.innerGenerated c) = Nat.card B * k ∧
      E.nativeOverlap.index = (E.innerGenerated c).index * k := by
  obtain ⟨k,hk⟩ := E.innerGenerated_index_dvd c hi
  have houter : 0 < E.nativeOverlap.index := Nat.card_pos
  have hkpos : 0 < k := by nlinarith
  have hh := (E.innerGenerated c).card_mul_index
  rw [hc,E.carrier_card_eq_base_mul_outer hi,hk] at hh
  have hiPos : 0 < (E.innerGenerated c).index := Nat.card_pos
  have he : Nat.card (E.innerGenerated c) = Nat.card B * k := by
    apply Nat.eq_of_mul_eq_mul_right hiPos
    calc
      Nat.card (E.innerGenerated c) * (E.innerGenerated c).index =
          Nat.card B * ((E.innerGenerated c).index * k) := hh
      _ = Nat.card B * k * (E.innerGenerated c).index := by ring
  exact ⟨k,hkpos,he,hk⟩
end SourceExtension

/-- U₄: a normal native subcompletion on the same full-extension vertex
orbits, with exact control of the possible extra order factor. -/
theorem four_completion_normal_native (m : ℕ) (hm : 1 ≤ m) (hmgt : 1 < m)
    (E : FourExtension m hm) {M : Type*} [Group M] [Finite M]
    (c : RankTwoAmalgam.FaithfulCompletion E.amalgam (G := M))
    (ho : c.left.range ⊓ c.right.range = c.middle.range)
    (hcard : Nat.card M ≤ Nat.card E.carrier) :
    (E.innerGenerated c).Normal ∧
      (E.innerCompletion c (four_conj_injective m hm)).left.range ⊓
        (E.innerCompletion c (four_conj_injective m hm)).right.range =
        (E.innerCompletion c (four_conj_injective m hm)).middle.range ∧
      (∀ v : Vertex c.cosetFamily, ∃ a : E.innerGenerated c,
        a.val • base c.cosetFamily v.type = v) ∧
      ∃ k : ℕ, 0 < k ∧ Nat.card (E.innerGenerated c) =
        Nat.card (GreenBook.LieModels.UnitaryFour.ProjectiveGroup m hm) * k ∧
        E.nativeOverlap.index = (E.innerGenerated c).index * k := by
  let : Finite (GreenBook.LieModels.UnitaryFour.ProjectiveGroup m hm) :=
    Finite.of_surjective (GreenBook.LieModels.UnitaryFour.projection m hm)
      (Theory.SpecificGroups.ClassicalUnitary.UnitaryFourFlag.project_surjective _ _)
  exact ⟨E.innerGenerated_normal c (four_conj_injective m hm),
    E.innerCompletion_overlap c (four_conj_injective m hm) ho,
    E.innerGenerated_vertex_transitive c (four_conj_injective m hm),
    E.innerGenerated_order_multiple c (four_conj_injective m hm)
      (four_completion_card_eq m hm hmgt E c ho hcard)⟩

/-- The restricted full stabilizers in the normal native-generated U₅
subgroup have the genuine unequal valencies 65 and 17. -/
theorem five_innerGenerated_card_neighbors (U : GreenBook.UnitaryFive.Model 4)
    (E : FiveExtension U) {M : Type*} [Group M]
    (c : RankTwoAmalgam.FaithfulCompletion E.amalgam (G := M))
    (ho : c.left.range ⊓ c.right.range = c.middle.range)
    (v : Vertex (E.innerFamily c)) :
    Nat.card ((graph (E.innerFamily c)).neighborSet v) = fiveDegree v.type := by
  let e := E.innerGenerated_graphIso c (five_conj_injective U)
  exact (Nat.card_congr (e.mapNeighborSet v)).trans
    (five_completion_card_neighbors U E c ho (e v))

/-- PSU₅(4): normality, the whole native overlap and both actual vertex
orbits, retaining the projective scalar quotient throughout. -/
theorem five_completion_normal_native (U : GreenBook.UnitaryFive.Model 4)
    (E : FiveExtension U) {M : Type*} [Group M]
    (c : RankTwoAmalgam.FaithfulCompletion E.amalgam (G := M))
    (ho : c.left.range ⊓ c.right.range = c.middle.range) :
    (E.innerGenerated c).Normal ∧
      (E.innerCompletion c (five_conj_injective U)).left.range ⊓
        (E.innerCompletion c (five_conj_injective U)).right.range =
        (E.innerCompletion c (five_conj_injective U)).middle.range ∧
      (∀ v : Vertex c.cosetFamily, ∃ a : E.innerGenerated c,
        a.val • base c.cosetFamily v.type = v) ∧
      (∀ v : Vertex (E.innerFamily c),
        Nat.card ((graph (E.innerFamily c)).neighborSet v) = fiveDegree v.type) ∧
      (E.innerGenerated c).index ∣ E.nativeOverlap.index :=
  ⟨E.innerGenerated_normal c (five_conj_injective U),
    E.innerCompletion_overlap c (five_conj_injective U) ho,
    E.innerGenerated_vertex_transitive c (five_conj_injective U),
    five_innerGenerated_card_neighbors U E c ho,
    E.innerGenerated_index_dvd c (five_conj_injective U)⟩

end CFSG.Quasithin.ChapterF.SourceCompletion.UnitaryNonbinary
