module
public import CFSG.Quasithin.ChapterF.Section04.SourceCompletion.LinearThreeEven.Recognition
public import CFSG.Quasithin.ClassicalModels

/-!
# Full linear-three recognition from the source apartment

The source cube lies in the whole middle, giving the triangle metric. The
literal point-action comparison recognizes a faithful extension of PSL₃.
Transporting the native inclusion identifies precisely the subgroup generated
by the native endpoints, proves its normality and trivial centralizer, and
retains both endpoint maps. Only then does ambient simplicity remove the
outer extension. All finite characteristic-two fields with exponent greater
than one are retained, including the full scalar kernel at even exponents.

Source: Aschbacher–Smith F.4.8–9 and F.4.49, printed pp.278–279,298–299.
The source owner supplies the endpoint involutions, whole-middle cube witness,
and the original ambient generation needed by the Chapter 6/12 application.
-/

@[expose] public noncomputable section
set_option backward.isDefEq.respectTransparency false
open Subgroup Theory.GroupTheory
open scoped MatrixGroups
open Matrix.PSL3 Matrix.PSL3.LinearThree Matrix.PSL3.SmallCompletion
namespace CFSG.Quasithin.ChapterF.SourceCompletion.LinearThreeEven.Completion
variable {F : Type*} [Field F] [Finite F] [CharP F 2]
variable {E : SourceExtension F} {G : Type*} [Group G] [Finite G]
variable (c : Completion E G)
variable (ho : c.left.range⊓c.right.range=c.middle.range) {n : ℕ} (hF : Nat.card F=2^n)
variable (hn : 1<n) (s t : G)
variable (hs : s∈c.left.range) (ht : t∈c.right.range)
variable (hsout : s∉c.middle.range) (htout : t∉c.middle.range)
variable (hs2 : s^2=1) (ht2 : t^2=1) (hcube : (s*t)^3∈c.middle.range)
include ho hF hn hs ht hsout htout hs2 ht2 hcube

/-- Recognition from the source quotient relation, with every full endpoint retained. -/
theorem extension_recognition : ∃ f : G ≃* E.carrier,
    (∀a : E.left,f (c.left a)=E.model.left a) ∧
    (∀a : E.right,f (c.right a)=E.model.right a) := by
  have hd := (c.smallness_of_cube_mem_middle ho hF s t hs ht hsout htout hs2 ht2 hcube).2.1
  have hq : 2 < Nat.card F := by
    rw [hF]
    exact Nat.pow_lt_pow_right (by decide : 1 < (2 : ℕ)) hn
  exact c.exists_extension_equiv ho hF hd hq

/-- The recognized action is faithful, contains every inner automorphism,
preserves both native types, and aligns the whole endpoint maps. -/
theorem faithful_extension_recognition : Nat.card G=Nat.card E.carrier ∧
    ∃ a : G →* MulAut PSL(3,F), Function.Injective a ∧
      UnitaryNonbinary.inner PSL(3,F) ≤ a.range ∧
      (∀g,UnitaryNonbinary.PreservesTypes (pointParabolic F) (lineParabolic F) (a g)) ∧
      (∀x : E.left,a (c.left x)=x.val) ∧ (∀y : E.right,a (c.right y)=y.val) := by
  obtain ⟨f,hl,hr⟩ := c.extension_recognition ho hF hn s t hs ht hsout htout hs2 ht2 hcube
  let a := E.carrier.subtype.comp f.toMonoidHom
  refine ⟨Nat.card_congr f.toEquiv,a,E.carrier.subtype_injective.comp f.injective,?_,?_,?_,?_⟩
  · intro x hx
    obtain ⟨g,hg⟩ := f.surjective ⟨x,E.contains_inner hx⟩
    exact ⟨g,congrArg Subtype.val hg⟩
  · intro g
    exact E.preserves_types (f g).val (f g).property
  · intro x
    exact congrArg Subtype.val (hl x)
  · intro y
    exact congrArg Subtype.val (hr y)

/-- The actual native subgroup is the subgroup generated by the prescribed
native endpoints. It is normal with trivial ambient centralizer. -/
theorem native_copy_recognition :
    ∃ b : PSL(3,F) →* G, Function.Injective b ∧
      b.range=E.innerGenerated c ∧ b.range.Normal ∧ centralizer (b.range : Set G)=⊥ ∧
      (∀x : pointParabolic F,b x.val=c.left (E.nativeLeft x)) ∧
      (∀y : lineParabolic F,b y.val=c.right (E.nativeRight y)) := by
  obtain ⟨f,hl,hr⟩ := c.extension_recognition ho hF hn s t hs ht hsout htout hs2 ht2 hcube
  let b := f.symm.toMonoidHom.comp E.baseHom
  have hb : Function.Injective b := f.symm.injective.comp (E.baseHom_injective (native_conj_injective F))
  have hbval (x : PSL(3,F)) : f (b x)=E.baseHom x := f.apply_symm_apply _
  have hbl (x : pointParabolic F) : b x.val=c.left (E.nativeLeft x) := by
    apply f.injective
    exact (hbval x.val).trans (hl (E.nativeLeft x)).symm
  have hbr (y : lineParabolic F) : b y.val=c.right (E.nativeRight y) := by
    apply f.injective
    exact (hbval y.val).trans (hr (E.nativeRight y)).symm
  have hcore : b.range=E.innerGenerated c := by
    have hl' : b.comp (pointParabolic F).subtype=E.innerLeft c := by ext x; exact hbl x
    have hr' : b.comp (lineParabolic F).subtype=E.innerRight c := by ext x; exact hbr x
    rw [MonoidHom.range_eq_map,←parabolics_sup_eq_top F,Subgroup.map_sup]
    change (pointParabolic F).map b ⊔ (lineParabolic F).map b=E.innerGenerated c
    have hmapL : (pointParabolic F).map b=(E.innerLeft c).range := by
      rw [←hl',MonoidHom.range_comp,range_subtype]
    have hmapR : (lineParabolic F).map b=(E.innerRight c).range := by
      rw [←hr',MonoidHom.range_comp,range_subtype]
    rw [hmapL,hmapR]
    rfl
  have hc (g : G) (x : PSL(3,F)) : b ((f g).val x)=g*b x*g⁻¹ := by
    apply f.injective
    rw [hbval,map_mul,map_mul,map_inv,hbval]
    apply Subtype.ext
    apply MulEquiv.ext
    intro y
    simp [UnitaryNonbinary.SourceExtension.baseHom]
  have hnormal : b.range.Normal := by
    refine ⟨?_⟩
    rintro _ ⟨x,rfl⟩ g
    exact ⟨(f g).val x,hc g x⟩
  have hcent : centralizer (b.range : Set G)=⊥ := by
    apply bot_unique
    intro g hg
    apply mem_bot.mpr
    apply f.injective
    rw [map_one]
    apply Subtype.ext
    apply MulEquiv.ext
    intro x
    change (f g).val x=x
    apply hb
    rw [hc,←hg (b x) ⟨x,rfl⟩,mul_inv_cancel_right]
  exact ⟨b,hb,hcore,hnormal,hcent,hbl,hbr⟩

/-- Ambient simplicity removes the outer extension only after the normal
native subgroup has been constructed and identified. -/
theorem simple_recognition [IsSimpleGroup G] : Nonempty (G ≃* PSL(3,F)) := by
  obtain ⟨b,hb,_,hN,_,_,_⟩ :=
    c.native_copy_recognition ho hF hn s t hs ht hsout htout hs2 ht2 hcube
  let _ : IsSimpleGroup PSL(3,F) := Atlas.psl_simple_high_rank 3 (by decide)
  have hne : b.range≠⊥ := by
    obtain ⟨x,hx⟩ := exists_ne (1 : PSL(3,F))
    intro hh
    have hh' : b x=1 := mem_bot.mp (hh ▸ (show b x∈b.range from ⟨x,rfl⟩))
    exact hx (hb (hh'.trans b.map_one.symm))
  have htop := hN.eq_bot_or_eq_top.resolve_left hne
  exact ⟨(MulEquiv.ofBijective b ⟨hb,MonoidHom.range_eq_top.mp htop⟩).symm⟩

end CFSG.Quasithin.ChapterF.SourceCompletion.LinearThreeEven.Completion
