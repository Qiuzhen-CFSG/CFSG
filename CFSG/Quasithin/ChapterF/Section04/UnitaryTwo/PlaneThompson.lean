/-!
# The elementary Thompson subgroup of the U4(2) plane local

The actual Hermitian radical is the unique maximum-order elementary subgroup
of every Sylow two-subgroup of the plane local. Its quotient action is the
four-dimensional Hermitian representation over F2, identified equivariantly
with the five-point A5 permutation section. B.3.2 makes each offender a group
generated by independent transpositions; such a group cannot lie in A5.
The maximum-elementary offender argument then forces every maximum elementary
subgroup into the radical, and cardinality gives equality.

The quotient map, two-core coordinates and conjugation action are all the
literal maps of the unitary flag model. No abstract replacement of the local
module is assumed.

Source: Aschbacher--Smith F.4.35, printed p.292 (the plain U4(2) case),
using B.3.2 and the model structure of F.1.12.
-/

@[expose] public section
noncomputable section
open Subgroup Representation.BinaryOffender BinaryPermutation
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterF.UnitaryTwo.PlaneThompson
open CFSG.Quasithin.ChapterB.Offenders

theorem natural_not_offender_of_even {A : Subgroup (Equiv.Perm (Fin 5))}
    (hA : A ≤ alternatingGroup (Fin 5)) :
    ¬ IsOffender (naturalRepresentation (Fin 5)) A := by
  intro hoff
  have he : fixedCodim (representation (Fin 5)) A = rank A := by
    apply le_antisymm
    · simpa only [fixedCodim_natural_eq_full_odd (Fin 5) (by decide)] using hoff.2
    · exact Odd.rank_le_fixedCodim_full_of_elementary (Or.inl rfl) A hoff.1
  obtain ⟨m, hm, _, g, hg⟩ :=
    Odd.caseAFamily_of_elementary_and_fixedCodim_full_eq_rank (Or.inl rfl) hoff.1 he
  have hs : pairSwap 5 0 ∈ disjointTranspositions 5 m := pairSwap_mem 0 (by change 0 < m; omega)
  have hsg : (MulAut.conj g) (pairSwap 5 0) ∈ A := hg ▸ mem_map_of_mem _ hs
  have hh := Equiv.Perm.mem_alternatingGroup.mp (hA hsg)
  have hsign : Equiv.Perm.sign ((MulAut.conj g) (pairSwap 5 0)) = -1 := by
    simp [MulAut.conj_apply, pairSwap]
  rw [hsign] at hh
  contradiction

open Representation.OrthogonalFourMinus.FiniteModel
open Representation.OrthogonalFourMinus.AlternatingFive
local instance : Algebra (ZMod 2) (fixedField 1) := ZMod.algebraOfModule 2 (fixedField 1)
local notation "ρ" => Representation.restrictScalars (k := ZMod 2) (action 1)

theorem hermitian_not_offender (A : Subgroup Group) : ¬ IsOffender ρ A := by
  intro hA
  let f : Group →* Equiv.Perm (Fin 5) :=
    (alternatingGroup (Fin 5)).subtype.comp groupEquiv.toMonoidHom
  have hf : Function.Injective f := Subtype.val_injective.comp groupEquiv.injective
  have he : ∀ g v, moduleEquiv (ρ g v) = naturalRepresentation (Fin 5) (f g) (moduleEquiv v) :=
    intertwines
  have hm := hA.map_equivariant ρ (naturalRepresentation (Fin 5)) f hf moduleEquiv he
  exact natural_not_offender_of_even (by
    rintro x ⟨g, _, rfl⟩
    exact (groupEquiv g).property) hm

section Generic
variable {H D : Type*} [Group H] [Group D] [Finite H] [Finite D]

private theorem unique_maximum_of_no_offenders
    (V : Subgroup H) [V.Normal] [IsElementaryAbelian 2 V]
    (q : H →* D) (hq : Function.Surjective q)
    (hker : q.ker = centralizer (V : Set H)) (hc : centralizer (V : Set H) ≤ V)
    (hno : ∀ A, ¬ IsOffender (Representation.NormalElementaryQuotient.representation V q hq hker) A)
    (T : Subgroup H) (hVT : V ≤ T) (A : Subgroup H)
    (hA : A ∈ Stellmacher.elementaryAbelianMaxSubgroups T) : A = V := by
  have hbot : A.map q = ⊥ := by
    by_contra hn
    exact hno _ ((CFSG.Quasithin.Chapter15.Section03.CharacteristicTwo.StarSelection.maxElementary_isBestOffender
      V q hq hker T A hVT hA hn).isOffender _)
  have hAV : A ≤ V := ((Subgroup.map_eq_bot_iff A).mp hbot).trans (hker ▸ hc)
  exact Subgroup.eq_of_le_of_card_ge hAV (hA.2.2 V hVT inferInstance)
end Generic

open CFSG.Quasithin.ChapterF.GreenBook.LieModels.UnitaryFour
local notation "L" => L2 1 (Nat.le_refl 1)
local notation "Q" => pCore 2 L
local instance coreElementary : IsElementaryAbelian 2 Q :=
  L2TwoCore_elementaryAbelian 1 (Nat.le_refl 1)
local instance coreCommutative : IsMulCommutative Q :=
  IsElementaryAbelian.toIsMulCommutative (p := 2)
local instance coreCommGroup : CommGroup Q :=
  { (pCore 2 L).toGroup with mul_comm := mul_comm' }
local instance coreAddComm : AddCommGroup (Additive Q) :=
  @Additive.addCommGroup Q coreCommGroup

def planeQuotient : L →* Group :=
  (L2QuotientEquivSL2 1 (Nat.le_refl 1)).toMonoidHom.comp (QuotientGroup.mk' Q)

theorem planeQuotient_surjective : Function.Surjective planeQuotient :=
  (L2QuotientEquivSL2 1 (Nat.le_refl 1)).surjective.comp (QuotientGroup.mk'_surjective Q)

theorem planeQuotient_ker : planeQuotient.ker = Q := by
  rw [planeQuotient, MonoidHom.ker_comp_of_injective _ _
    (L2QuotientEquivSL2 1 (Nat.le_refl 1)).injective, QuotientGroup.ker_mk']

theorem planeCore_centralizer : centralizer (Q : Set L) = Q := by
  apply le_antisymm
  · intro g hg
    have he : MulAut.conjNormal g = (1 : MulAut Q) := by
      apply MulEquiv.ext
      intro u
      apply Subtype.ext
      change g * (u : L) * g⁻¹ = u
      rw [← hg u u.property, mul_inv_cancel_right]
    have hm : g ∈ (MulAut.conjNormal : L →* MulAut Q).ker := he
    rwa [L2TwoCore_conjugation_ker] at hm
  · exact (pCore 2 L).le_centralizer

theorem planeQuotient_ker_centralizer : planeQuotient.ker = centralizer (Q : Set L) :=
  planeQuotient_ker.trans planeCore_centralizer.symm

def planeCoordinates : Additive Q ≃ₗ[ZMod 2] Space 1 where
  toFun x := ((L2TwoCoreEquiv 1 (Nat.le_refl 1)).symm x.toMul).toAdd
  invFun x := Additive.ofMul (L2TwoCoreEquiv 1 (Nat.le_refl 1) (Multiplicative.ofAdd x))
  left_inv x := by change (L2TwoCoreEquiv 1 _) ((L2TwoCoreEquiv 1 _).symm x.toMul) = x.toMul; simp
  right_inv x := by change ((L2TwoCoreEquiv 1 _).symm ((L2TwoCoreEquiv 1 _) _)).toAdd = x; simp
  map_add' x y := by change ((L2TwoCoreEquiv 1 _).symm (x.toMul * y.toMul)).toAdd = _; rw [map_mul]; rfl
  map_smul' a x := by
    rcases (by decide : ∀ a : ZMod 2, a = 0 ∨ a = 1) a with rfl | rfl <;> simp

local notation "α" => Representation.NormalElementaryQuotient.representation Q planeQuotient
  planeQuotient_surjective planeQuotient_ker_centralizer

theorem planeCoordinates_equivariant (g : Group) (v : Additive Q) :
    planeCoordinates (α g v) = ρ g (planeCoordinates v) := by
  obtain ⟨g, rfl⟩ := planeQuotient_surjective g
  have he : (α (planeQuotient g) v).toMul = MulAut.conjNormal g v.toMul := by
    apply Subtype.ext
    exact Representation.NormalElementaryQuotient.representation_apply Q planeQuotient
      planeQuotient_surjective planeQuotient_ker_centralizer g v
  change ((L2TwoCoreEquiv 1 _).symm (α (planeQuotient g) v).toMul).toAdd = _
  rw [he, L2TwoCoreEquiv_symm_conj]
  rfl

theorem planeAction_not_offender (A : Subgroup Group) : ¬ IsOffender α A := by
  intro hA
  have hm := hA.map_equivariant α ρ (MonoidHom.id Group) Function.injective_id
    planeCoordinates planeCoordinates_equivariant
  exact hermitian_not_offender A (by simpa using hm)

theorem plane_unique_maximum (T : Sylow 2 L) (A : Subgroup L)
    (hA : A ∈ Stellmacher.elementaryAbelianMaxSubgroups (T : Subgroup L)) : A = Q := by
  exact unique_maximum_of_no_offenders Q planeQuotient planeQuotient_surjective
    planeQuotient_ker_centralizer planeCore_centralizer.le planeAction_not_offender
    T (pCore_isPGroup.le_sylow_of_normal T) A hA

/-- The entire elementary Thompson subgroup is the literal plane two-core. -/
theorem plane_thompson (T : Sylow 2 L) :
    Stellmacher.elementaryAbelianMaxJ (T : Subgroup L) = Q := by
  apply le_antisymm
  · exact sSup_le fun A hA => (plane_unique_maximum T A hA).le
  · obtain ⟨A,hA⟩ := Stellmacher.elementaryAbelianMaxSubgroups_nonempty (T : Subgroup L)
    rw [← plane_unique_maximum T A hA]
    exact le_sSup hA

end CFSG.Quasithin.ChapterF.UnitaryTwo.PlaneThompson
