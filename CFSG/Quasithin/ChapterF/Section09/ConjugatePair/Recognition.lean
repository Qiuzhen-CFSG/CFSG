module
public import CFSG.Quasithin.ChapterF.Section09.ConjugatePair.Generators
public import Theory.LinearAlgebra.QuadraticForm.BinaryFourPlus.SingularInvolutionPairs

/-!
# Original F.9.5(6.i): recognition of the starred pair

The actual pair seed is a quaternion central product. Its orthogonal action
has the original two-core kernel and is generated by the two original module
images, which are singular-displacement involutions. The binary plus-space
pair theorem therefore recognizes precisely the pair image in H/O₂(H) as S₃.
No recognition or replacement-action hypothesis is assumed.
Source: Aschbacher–Smith F.9.5(5),(6.i), printed p.319.
-/
public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterF.Section09.Setup.Hypothesis
variable {G : Type*} [Group G] [Finite G] {D : Setup G} (h : D.Hypothesis)
include h

/-- Original F.9.5(6.i), on the literal pair image and original quotient map. -/
theorem pair_star_symmetricThree
    (hi : D.Vplus.relIndex D.V = 2) (hcard : Nat.card D.V = 16)
    (hp : ∀ g ∈ D.H, D.V₁ < D.V ⊓ D.V.map (MulAut.conj g).toMonoidHom →
      IsPGroup 2 (D.V ⊔ D.V.map (MulAut.conj g).toMonoidHom : Subgroup G))
    (hc : ⁅D.V,D.H ⊓ centralizer (D.Vplus : Set G)⁆ ≤ D.V₁)
    (g : G) (hg : g ∈ D.H)
    (hn : ¬ IsPGroup 2 (((D.V ⊔ D.V.map (MulAut.conj g).toMonoidHom).subgroupOf D.H).map
      (QuotientGroup.mk' (pCore 2 D.H)))) :
    Nonempty ((((D.V ⊔ D.V.map (MulAut.conj g).toMonoidHom).subgroupOf D.H).map
      (QuotientGroup.mk' (pCore 2 D.H))) ≃* Equiv.Perm (Fin 3)) := by
  have hpair : ¬ IsPGroup 2 (D.V ⊔ D.V.map (MulAut.conj g).toMonoidHom : Subgroup G) := by
    intro hh
    exact hn (hh.comap_subtype.map _)
  obtain ⟨q⟩ := h.pair_seed_quaternion hi hcard hp hc g hg hpair
  obtain ⟨e⟩ := h.pair_orthogonal_range hi hcard hp hc g hg hpair q
  obtain ⟨a,b,ha,hb,hsa,hsb,he⟩ := h.pair_orthogonal_generators hi hcard hp hc g hg hpair q
  let f := e.trans (MulEquiv.subgroupCongr he)
  have hab : ¬ IsPGroup 2 (zpowers a ⊔ zpowers b : Subgroup BinaryFourPlus.Wreath) :=
    fun hh => hn (hh.of_equiv f.symm)
  obtain ⟨j⟩ := BinaryFourPlus.symmetricThree_of_singular_involutions a b ha hb hsa hsb hab
  exact ⟨f.trans j⟩

/-- The same source statement with the book's right-conjugation convention. -/
theorem pair_star_symmetricThree_right
    (hi : D.Vplus.relIndex D.V = 2) (hcard : Nat.card D.V = 16)
    (hp : ∀ g ∈ D.H, D.V₁ < D.V ⊓ ChapterG.Section02.Setup.conjugate D.V g →
      IsPGroup 2 (D.V ⊔ ChapterG.Section02.Setup.conjugate D.V g : Subgroup G))
    (hc : ⁅D.V,D.H ⊓ centralizer (D.Vplus : Set G)⁆ ≤ D.V₁)
    (g : G) (hg : g ∈ D.H)
    (hn : ¬ IsPGroup 2 (((D.V ⊔ ChapterG.Section02.Setup.conjugate D.V g).subgroupOf D.H).map
      (QuotientGroup.mk' (pCore 2 D.H)))) :
    Nonempty ((((D.V ⊔ ChapterG.Section02.Setup.conjugate D.V g).subgroupOf D.H).map
      (QuotientGroup.mk' (pCore 2 D.H))) ≃* Equiv.Perm (Fin 3)) :=
  h.pair_star_symmetricThree hi hcard (pair_condition_left hp) hc g⁻¹ (D.H.inv_mem hg) hn
end CFSG.Quasithin.ChapterF.Section09.Setup.Hypothesis
