module

public import CFSG.Quasithin.ChapterG.Section02.CentralClosure
public import Theory.GroupTheory.CentralizerModulo
public import Theory.GroupTheory.NormalCenterQuotient

/-!
# The original data of F.9.1

The two closures are kept distinct: U_H is generated by the H-conjugates
of V_+, whereas V_H is generated by those of V. The residual L₁ is O²(C_L(V₁)).
Reducedness of V means normal elementary abelianness and trivial two-core of
the actual centralizer quotient in LT. The kernel assumption (a) bounds only
the normal core of the seed centralizer; it does not assume F.9.2(3).

Irreducibility is the invariant-subgroup interval [V₁,V_+]. Condition (e)
retains all three antecedents. We use left conjugates in this universally
quantified condition, equivalently replacing the book's g by g⁻¹.

The G.2 specialization uses V_+, not V. Its normalizer quotient is the
source centralizer quotient because a subgroup of order two has equal
normalizer and centralizer, as proved below.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
Hypothesis F.9.1 and the first assertion of F.9.2, printed pp.317–318.
-/

@[expose] public section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.ChapterF.Section09
variable (G : Type*) [Group G]

structure Setup where
  T : Sylow 2 G
  L : Subgroup G
  V : Subgroup G
  Vplus : Subgroup G
  V₁ : Subgroup G
  H : Subgroup G

namespace Setup
variable {G} (D : Setup G)

def LT : Subgroup G := D.L ⊔ (D.T : Subgroup G)
def Gz : Subgroup G := centralizer (D.V₁ : Set G)
noncomputable def L₁ : Subgroup G :=
  (pResidual 2 (D.L ⊓ D.Gz : Subgroup G)).map (D.L ⊓ D.Gz).subtype

def QH : Subgroup G := D.H.pCoreIn 2
def UH : Subgroup G := conjugateSpanBy D.Vplus D.H
def VH : Subgroup G := conjugateSpanBy D.V D.H

def g2 : ChapterG.Section02.Setup G :=
  ⟨D.Vplus, D.V₁, D.L, D.T, D.H⟩

abbrev Tilde := D.g2.Tilde

def tilde (A : Subgroup G) : Subgroup D.Tilde := D.g2.tilde A

/-- All original F.9.1 hypotheses; the conclusions of F.9.2 are not fields. -/
structure Hypothesis [Finite G] : Prop where
  elementary : IsElementaryAbelian 2 D.V
  residual : pResidual 2 D.L = ⊤
  normalizes_L : (D.T : Subgroup G) ≤ normalizer (D.L : Set G)
  characteristic_L : generalizedFitting D.L = pCore 2 D.L
  V_le_LT : D.V ≤ D.LT
  reduced : IsPReduced 2 (D.V.subgroupOf D.LT)
  sylow_centralizer : (D.T : Subgroup G) ⊓ centralizer (D.V : Set G) = D.LT.pCoreIn 2
  point_card : Nat.card D.V₁ = 2
  normalizes_point : (D.T : Subgroup G) ≤ normalizer (D.V₁ : Set G)
  point_lt : D.V₁ < D.Vplus
  plus_le : D.Vplus ≤ D.V
  H_centralizes : D.H ≤ D.Gz
  local_le : D.L₁ ⊔ (D.T : Subgroup G) ≤ D.H
  characteristic_H : generalizedFitting D.H = pCore 2 D.H
  kernel_core :
    letI : (D.V₁.subgroupOf D.H).Normal :=
      normal_subgroupOf_of_le_normalizer
        (H_centralizes.trans (Subgroup.centralizer_le_normalizer (D.V₁ : Set G)))
    (centralizerModulo (⊤ : Subgroup D.H) (D.Vplus.subgroupOf D.H)
      (D.V₁.subgroupOf D.H)).normalCore ≤ pCore 2 D.H
  local_normalizes : D.L₁ ⊔ (D.T : Subgroup G) ≤ normalizer (D.Vplus : Set G)
  irreducible : ∀ W : Subgroup G, D.V₁ ≤ W → W ≤ D.Vplus →
    D.L₁ ⊔ (D.T : Subgroup G) ≤ normalizer (W : Set G) → W = D.V₁ ∨ W = D.Vplus
  normalizer_control : D.H ⊓ normalizer (D.Vplus : Set G) ≤
    D.H ⊓ normalizer (D.V : Set G)
  generated_core : pCore 2 (D.LT ⊔ D.H : Subgroup G) = ⊥
  commutator_lifting : ∀ g ∈ D.H,
    ⁅D.V, D.V.map (MulAut.conj g).toMonoidHom⁆ ≤ D.V ⊓ D.V.map (MulAut.conj g).toMonoidHom →
    ⁅D.Vplus, D.V.map (MulAut.conj g).toMonoidHom⁆ ≤ D.V₁ →
    ⁅D.Vplus.map (MulAut.conj g).toMonoidHom, D.V⁆ ≤ D.V₁ →
    ⁅D.Vplus, D.V.map (MulAut.conj g).toMonoidHom⁆ = ⊥ ∧
      ⁅D.Vplus.map (MulAut.conj g).toMonoidHom, D.V⁆ = ⊥

variable [Finite G] {D}
namespace Hypothesis
variable (h : D.Hypothesis)
include h

theorem T_le_H : (D.T : Subgroup G) ≤ D.H := le_sup_right.trans h.local_le

theorem V_le_T : D.V ≤ (D.T : Subgroup G) := by
  have hv : D.V ≤ D.LT.pCoreIn 2 := by
    simpa only [pCoreIn, map_subgroupOf_eq_of_le h.V_le_LT] using
      map_mono (f := D.LT.subtype) h.reduced.le_pCore
  have ht : (D.T : Subgroup G) ≤ D.LT := le_sup_right
  exact hv.trans ((pCoreIn_le_sylow D.LT (D.T.subtype ht)).trans_eq
    (map_subgroupOf_eq_of_le ht))

theorem V_le_H : D.V ≤ D.H := h.V_le_T.trans h.T_le_H

theorem plus_le_H : D.Vplus ≤ D.H := h.plus_le.trans h.V_le_H

theorem point_le_H : D.V₁ ≤ D.H := h.point_lt.le.trans h.plus_le_H

theorem normalizer_point_eq : normalizer (D.V₁ : Set G) = D.Gz := by
  apply le_antisymm _ (Subgroup.centralizer_le_normalizer _)
  have hc : Nat.card (D.V₁.subgroupOf (normalizer (D.V₁ : Set G))) = 2 :=
    (Nat.card_congr (subgroupOfEquivOfLe D.V₁.le_normalizer).toEquiv).trans h.point_card
  have hz := central_of_normal_card_two
    (D.V₁.subgroupOf (normalizer (D.V₁ : Set G))) hc
  intro x hx z hz'
  exact congrArg Subtype.val
    (mem_center_iff.mp (hz (show (⟨z, D.V₁.le_normalizer hz'⟩ : normalizer (D.V₁ : Set G)) ∈
      D.V₁.subgroupOf (normalizer (D.V₁ : Set G)) from hz')) ⟨x, hx⟩).symm

/-- The G.2 ambient point normalizer is exactly the source G_z. -/
theorem g2_G₁ : D.g2.G₁ = D.Gz := h.normalizer_point_eq

theorem g2_L₁ : D.g2.L₁ = D.L₁ := by
  unfold ChapterG.Section02.Setup.L₁ ChapterG.Section02.Setup.G₁ g2 L₁
  rw [h.normalizer_point_eq]

theorem T_normalizes_V : (D.T : Subgroup G) ≤ normalizer (D.V : Set G) :=
  le_sup_right.trans ((normal_subgroupOf_iff_le_normalizer h.V_le_LT).mp h.reduced.normal)

/-- The genuine G.2.1 specialization in the first sentence of F.9.2. -/
theorem g2_hypothesis : D.g2.Hypothesis := by
  let := h.elementary
  have hlocal : D.g2.L₁ ⊔ (D.T : Subgroup G) = D.L₁ ⊔ (D.T : Subgroup G) :=
    congrArg (fun A => A ⊔ (D.T : Subgroup G)) h.g2_L₁
  refine {
    elementary := IsElementaryAbelian.of_le h.plus_le
    point_ne_bot := ?_
    point_le := h.point_lt.le
    residual := h.residual
    V_le_T := h.plus_le.trans h.V_le_T
    T_normalizes_point := h.normalizes_point
    T_normalizes_V := le_sup_right.trans h.local_normalizes
    T_normalizes_L := h.normalizes_L
    sylow_LT := ⟨D.T.subtype le_sup_right, map_subgroupOf_eq_of_le le_sup_right⟩
    H_le := h.H_centralizes.trans (Subgroup.centralizer_le_normalizer _)
    local_le := hlocal ▸ h.local_le
    sylow_H := ⟨D.T.subtype h.T_le_H, map_subgroupOf_eq_of_le h.T_le_H⟩
    characteristic_two := h.characteristic_H
    local_normalizes_V := hlocal ▸ h.local_normalizes
    quotient_nonzero := ne_of_lt h.point_lt
    irreducible := ?_ }
  · intro hz
    change D.V₁ = ⊥ at hz
    have hc := h.point_card
    change Nat.card D.V₁ = 2 at hc
    rw [hz] at hc
    simp at hc
  · intro W hW hW' hn
    exact h.irreducible W hW hW' (hlocal ▸ hn)

theorem UH_le_H : D.UH ≤ D.H := h.g2_hypothesis.U_le_H

theorem UH_normal : (D.UH.subgroupOf D.H).Normal := h.g2_hypothesis.U_normal

theorem VH_le_H : D.VH ≤ D.H := conjugateSpanBy_le_self h.V_le_H

theorem VH_normal : (D.VH.subgroupOf D.H).Normal :=
  (normal_subgroupOf_iff_le_normalizer h.VH_le_H).mpr
    (le_normalizer_conjugateSpanBy D.V D.H)

theorem point_normal : (D.V₁.subgroupOf D.H).Normal :=
  normal_subgroupOf_of_le_normalizer
    (h.H_centralizes.trans (Subgroup.centralizer_le_normalizer (D.V₁ : Set G)))

/-- The intrinsic action kernel, mapped into the original ambient group. -/
def kernel (A : Subgroup G) : Subgroup G :=
  let := h.point_normal
  (centralizerModulo (⊤ : Subgroup D.H) (A.subgroupOf D.H)
    (D.V₁.subgroupOf D.H)).map D.H.subtype

/-- Membership uses the actual commutators in G, without choosing a model action. -/
theorem mem_kernel_iff {A : Subgroup G} (ha : A ≤ D.H) {x : G} :
    x ∈ h.kernel A ↔ x ∈ D.H ∧ ∀ a ∈ A, ⁅a, x⁆ ∈ D.V₁ := by
  let := h.point_normal
  constructor
  · rintro ⟨x, hx, rfl⟩
    obtain ⟨_, hc⟩ := mem_centralizerModulo_iff.mp hx
    exact ⟨x.property, fun a ha' => hc ⟨a, ha ha'⟩ ha'⟩
  · rintro ⟨hx, hc⟩
    exact ⟨⟨x, hx⟩, mem_centralizerModulo_iff.mpr
      ⟨mem_top _, fun a ha' => hc a ha'⟩, rfl⟩

end Hypothesis
end Setup
end CFSG.Quasithin.ChapterF.Section09
