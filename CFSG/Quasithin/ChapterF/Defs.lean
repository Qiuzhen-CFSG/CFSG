module

public import CFSG.Quasithin.ChapterF.Section01.SourceDefs
public import Mathlib.GroupTheory.Sylow
public import Theory.Quasithin
public import Theory.PPrimeCore

/-!
# Legacy local interfaces for Chapter F

These declarations are retained for compatibility only. They do not formalize
Hypothesis F.1.1 or Definition F.1.7. In particular `RankOneLocal` has an
unrestricted overgroup condition forcing its Borel to equal L; its arbitrary
model is not linked to the family tag. `HypothesisF11` assumes several desired
conclusions and carries an arbitrary solvability proposition. `WeakBNPair`
records only generation, intersection and faithfulness, omitting Hypothesis A.

Use the publicly imported `ChapterF.Source` namespace for the source-faithful
hypotheses. There is intentionally no bridge from these legacy assumptions to
the corrected source hypotheses or to the Green Book recognition theorem.
-/

namespace CFSG.Quasithin.ChapterF

open scoped Pointwise

universe u

variable {G : Type u} [Group G]

/-- The four rank-one quotient families occurring in Hypothesis F.1.1(c). -/
public inductive RankOneFamily
  | linear
  | suzuki
  | unitary
  | dihedral
  deriving DecidableEq, Repr

/-- Legacy rank-one datum, not a source rank-one local subgroup.

`model` is intentionally an arbitrary group: consumers can instantiate it by
`L₂(2^n)`, `Sz(2^n)`, `(S)U₃(2^n)`, or `D₁₀` when the corresponding concrete
model has been constructed. -/
public structure RankOneLocal (G : Type u) [Group G]
    (L S : Subgroup G) where
  family : RankOneFamily
  model : Type u
  modelGroup : Group model
  quotientIso : Nonempty
    (@MulEquiv (L ⧸ pCore 2 L) model
      (QuotientGroup.Quotient.group (pCore 2 L)).toMul modelGroup.toMul)
  /-- The Borel/normalizer facts used in Lemma F.1.3. -/
  sylow : Subgroup G
  sylow_eq : sylow = S ⊓ L
  sylow_le : sylow ≤ L
  sylow_isP : IsPGroup 2 sylow
  borel : Subgroup G
  borel_eq_normalizer : borel = L ⊓ Subgroup.normalizer (sylow : Set G)
  borel_unique_maximal : ∀ M : Subgroup G,
    sylow ≤ M → M ≤ L → M ≤ borel
  borel_two_core : IsPGroup 2 (pCore 2 borel)
  borel_solvable : Prop

/-- Legacy conditional data, not Hypothesis F.1.1.

The quotient models are arbitrary; Borel facts and incidence conclusions are
stored assumptions. Kept only to preserve existing conditional APIs. -/
public structure HypothesisF11 (G : Type u) [Group G]
    (L₁ L₂ S : Subgroup G) where
  finite_S : Finite S
  S_isP : IsPGroup 2 S
  S_normalizes₁ : S ≤ Subgroup.normalizer (L₁ : Set G)
  S_normalizes₂ : S ≤ Subgroup.normalizer (L₂ : Set G)
  local₁ : RankOneLocal G L₁ S
  local₂ : RankOneLocal G L₂ S
  cross₁ : L₂ ⊓ Subgroup.normalizer ((S ⊓ L₂ : Subgroup G) : Set G) ≤
    Subgroup.normalizer (L₁ : Set G)
  cross₂ : L₁ ⊓ Subgroup.normalizer ((S ⊓ L₁ : Subgroup G) : Set G) ≤
    Subgroup.normalizer (L₂ : Set G)
  borel₂_normalizes_borel₁ : local₂.borel ≤
    Subgroup.normalizer (local₁.borel : Set G)
  borel₁_normalizes_borel₂ : local₁.borel ≤
    Subgroup.normalizer (local₂.borel : Set G)
  borel_product_solvable : Prop
  borel_product_solvable_proof : borel_product_solvable
  borel_intersection :
    Subgroup.closure ((L₁ : Set G) ∪ (local₁.borel : Set G)) ⊓
      Subgroup.closure ((L₂ : Set G) ∪ (local₂.borel : Set G)) =
      local₁.borel ⊔ local₂.borel ⊔ S
  twoCore_free : pCore 2 (Subgroup.closure ((L₁ : Set G) ∪ (L₂ : Set G) ∪ (S : Set G))) = ⊥

/-- The subgroup generated by the two local factors and `S`. -/
public def HypothesisF11.G₀ {L₁ L₂ S : Subgroup G}
    (_h : HypothesisF11 G L₁ L₂ S) : Subgroup G :=
  Subgroup.closure ((L₁ : Set G) ∪ (L₂ : Set G) ∪ (S : Set G))

/-- The two Borel subgroups attached to a rank-one local datum. -/
public def HypothesisF11.B₁ {L₁ L₂ S : Subgroup G}
    (h : HypothesisF11 G L₁ L₂ S) : Subgroup G := h.local₁.borel
public def HypothesisF11.B₂ {L₁ L₂ S : Subgroup G}
    (h : HypothesisF11 G L₁ L₂ S) : Subgroup G := h.local₂.borel

/-- The common Sylow-2 part of the two local factors. -/
public def HypothesisF11.S₁ {L₁ L₂ S : Subgroup G}
    (_h : HypothesisF11 G L₁ L₂ S) : Subgroup G := S ⊓ L₁
public def HypothesisF11.S₂ {L₁ L₂ S : Subgroup G}
    (_h : HypothesisF11 G L₁ L₂ S) : Subgroup G := S ⊓ L₂

/-- Legacy faithful generating triple; this omits Green Book Hypothesis A. -/
public structure WeakBNPair (G : Type u) [Group G]
    (P₁ B P₂ : Subgroup G) : Prop where
  generate : Subgroup.closure ((P₁ : Set G) ∪ (P₂ : Set G)) = ⊤
  intersection : P₁ ⊓ P₂ = B
  faithful : ∀ N : Subgroup G, (N.subgroupOf (P₁ ⊔ P₂)).Normal → N ≤ B → N = ⊥

/-- A subgroup amalgam of rank two. -/
public structure RankTwoAmalgam (G : Type u) [Group G]
    (P₁ B P₂ : Subgroup G) where
  intersection : P₁ ⊓ P₂ = B
  generated : Subgroup.closure ((P₁ : Set G) ∪ (P₂ : Set G)) = ⊤

/-- The ambient group is a completion of its subgroup amalgam. -/
public theorem RankTwoAmalgam.isCompletion
    {P₁ B P₂ : Subgroup G} (a : RankTwoAmalgam G P₁ B P₂) :
    Subgroup.closure ((P₁ : Set G) ∪ (P₂ : Set G)) = ⊤ := a.generated

end CFSG.Quasithin.ChapterF
