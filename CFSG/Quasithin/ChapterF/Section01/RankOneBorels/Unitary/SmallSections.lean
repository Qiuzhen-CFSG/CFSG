/-!
# Degree-one unitary section kernels and quadratic bounds

A nontrivial module generated by Sylow-fixed vectors has kernel in that
Sylow normalizer. For PSU₃(2), the self-normalizing Sylow and trivial
2-core make the action faithful. For SU₃(2), the projective image of the
kernel is a normal 2-subgroup, so the action kernel is scalar. It is either
trivial or the full cubic kernel. Descent in the latter case preserves
the actor and its fixed-space index, proving the same quadratic square bound.

These are the model calculations used in DGS 6.4--6.5 by
LocalStructure.SmallUnitaryObstruction. They retain the actual group marks
and do not assume faithful action on the full special-unitary carrier.
The kernel argument also occurs in DGS85/CommutingTrivial/SmallUnitaryConstituents;
this lower extension makes it available to the Chapter 6 source construction.
Source: DGS, Groups and Graphs (1985), corrected 5.12, pp.113--115,
and 6.4, pp.120--121.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender
open Representation.RankOne.QuadraticRecognition BenderSuzuki.MatrixGroups
namespace CFSG.Quasithin.ChapterF.Source.Unitary

private theorem generated_kernel_le_normalizer
    {D W : Type*} [Group D] [AddCommGroup W] [Module (ZMod 2) W]
    (σ : Representation (ZMod 2) D W) (T : Sylow 2 D) (hf : RankOneSylowFacts T)
    (hg : GeneratedByFixedSpace σ T) (hnt : σ ≠ 1) :
    σ.ker ≤ normalizer (T : Set D) := by
  apply le_sup_left.trans (hf.unique_maximal _ le_sup_right (lt_top_iff_ne_top.mpr ?_))
  intro hsup
  have hR : fixedSpace σ σ.ker = ⊤ := by
    apply top_unique
    intro w _ a
    change σ a w = w
    rw [show σ a = 1 from a.property]
    rfl
  have hfix : fixedSpace σ ⊤ = fixedSpace σ T := by
    have he := σ.invariants_comp_sup σ.ker (T : Subgroup D)
    change fixedSpace σ (σ.ker ⊔ (T : Subgroup D)) =
      fixedSpace σ σ.ker ⊓ fixedSpace σ T at he
    rwa [hsup,hR,top_inf_eq] at he
  have hspan : (⨆ g : D, (fixedSpace σ T).map (σ g)) ≤ fixedSpace σ ⊤ := by
    apply iSup_le
    rintro g _ ⟨v,hv,rfl⟩
    have hv' : v ∈ fixedSpace σ ⊤ := hfix.symm ▸ hv
    rw [show σ g v = v from hv' ⟨g,mem_top _⟩]
    exact hv'
  have htop : fixedSpace σ ⊤ = ⊤ := top_unique (hg ▸ hspan)
  apply hnt
  apply MonoidHom.ext
  intro g
  apply LinearMap.ext
  intro w
  exact (show w ∈ fixedSpace σ ⊤ from htop.symm ▸ Submodule.mem_top) ⟨g,mem_top _⟩

/-- A nontrivial Sylow-fixed-generated action of PSU₃(2) is faithful. -/
theorem small_projective_constituent_faithful
    {F W : Type*} [Field F] [Finite F] (J : HermitianForm 3 F)
    (hc : Nat.card F = 2^2) (hconj : ∀ x, J.conj x = x^2)
    (hcore : pCore 2 (ProjectiveSpecialUnitaryMatrixGroup J) = ⊥)
    [AddCommGroup W] [Module (ZMod 2) W]
    (σ : Representation (ZMod 2) (ProjectiveSpecialUnitaryMatrixGroup J) W)
    (T : Sylow 2 (ProjectiveSpecialUnitaryMatrixGroup J))
    (hg : GeneratedByFixedSpace σ T) (hnt : σ ≠ 1) : Function.Injective σ := by
  have hk := generated_kernel_le_normalizer σ T
    (rankOneSylowFacts_psu3 J 1 (by decide) (by simpa using hc) (by simpa using hconj) T)
    hg hnt
  rw [HermitianForm.FixedFieldTwoNormalizer.sylow_normalizer_eq J hc hconj] at hk
  have hp : IsPGroup 2 σ.ker := T.isPGroup'.to_le hk
  have hkcore : σ.ker ≤ pCore 2 (ProjectiveSpecialUnitaryMatrixGroup J) :=
    le_sSup ⟨inferInstance,hp⟩
  exact σ.ker_eq_bot_iff.mp (bot_unique (hkcore.trans hcore.le))

/-- A nontrivial Sylow-fixed-generated action of SU₃(2) has only a scalar kernel. -/
theorem small_special_constituent_kernel
    {F W : Type*} [Field F] [Finite F] (J : HermitianForm 3 F)
    (hc : Nat.card F = 2^2) (hconj : ∀ x, J.conj x = x^2)
    (hcore : pCore 2 J.specialSubgroup = ⊥)
    [AddCommGroup W] [Module (ZMod 2) W]
    (σ : Representation (ZMod 2) J.specialSubgroup W) (T : Sylow 2 J.specialSubgroup)
    (hg : GeneratedByFixedSpace σ T) (hnt : σ ≠ 1)
    : σ.ker ≤ J.specialToProjective.ker := by
  let π := J.specialToProjective
  let : Finite (ProjectiveSpecialUnitaryMatrixGroup J) :=
    Finite.of_surjective _ J.specialToProjective_surjective
  let S := T.mapSurjective J.specialToProjective_surjective
  have hf := rankOneSylowFacts_su3 J 1 (by decide)
    (by simpa using hc) (by simpa using hconj) T
  have hk := generated_kernel_le_normalizer σ T hf hg hnt
  have hm : σ.ker.map π ≤ (S : Subgroup _) := by
    have hh := map_mono (f := π) hk
    rw [T.normalizer_map_surjective π J.specialToProjective_surjective] at hh
    exact hh.trans_eq (HermitianForm.FixedFieldTwoNormalizer.sylow_normalizer_eq J hc hconj S)
  have hp := S.isPGroup'.to_le hm
  let : (σ.ker.map π).Normal := Normal.map inferInstance π J.specialToProjective_surjective
  have hkp : σ.ker.map π ≤ pCore 2 (ProjectiveSpecialUnitaryMatrixGroup J) :=
    le_sSup ⟨inferInstance,hp⟩
  have hpc : pCore 2 (ProjectiveSpecialUnitaryMatrixGroup J) = ⊥ := by
    rw [←π.map_pCore_of_central_kernel J.specialToProjective_surjective
      J.specialToProjective_ker_le_center,hcore,Subgroup.map_bot]
  have hscalar : σ.ker ≤ π.ker := by
    intro g hg
    exact mem_bot.mp (hpc.le (hkp (mem_map_of_mem π hg)))
  exact hscalar

/-- The possible cubic scalar kernel preserves the SU₃(2) quadratic square bound. -/
theorem small_special_constituent_square_bound
    {F W : Type*} [Field F] [Finite F] (J : HermitianForm 3 F)
    (hc : Nat.card F = 2^2) (hconj : ∀ x, J.conj x = x^2)
    [AddCommGroup W] [Module (ZMod 2) W] [Finite W]
    (hcore : pCore 2 J.specialSubgroup = ⊥)
    (σ : Representation (ZMod 2) J.specialSubgroup W) (T : Sylow 2 J.specialSubgroup)
    (A : Subgroup J.specialSubgroup) (hAT : A ≤ T)
    (hg : GeneratedByFixedSpace σ T) (hnt : σ ≠ 1) (hq : IsQuadratic σ A) :
    Nat.card A ^ 2 ≤ Nat.card (W ⧸ fixedSpace σ A) := by
  by_cases hk0 : σ.ker = ⊥
  · exact su3_two_quadratic_square_bound J hc hconj σ (σ.ker_eq_bot_iff.mp hk0) A hq
  let π := J.specialToProjective
  have hk := small_special_constituent_kernel J hc hconj hcore σ T hg hnt
  have hd : Disjoint σ.ker (T : Subgroup J.specialSubgroup) := by
    apply Disjoint.mono_left hk
    apply disjoint_of_coprime_natCard
    obtain ⟨k,hkT⟩ := IsPGroup.iff_card.mp T.isPGroup'
    rw [hkT]
    exact J.odd_card_specialToProjective_ker.coprime_two_right.pow_right k
  have hkc : Nat.card σ.ker = 3 := by
    have hv := (card_dvd_of_le hk).trans J.card_specialToProjective_ker_dvd_three
    exact ((Nat.dvd_prime Nat.prime_three).mp hv).resolve_left (fun he => hk0 (card_eq_one.mp he))
  have heq : σ.ker = π.ker := eq_of_le_of_card_ge hk (by
    rw [hkc]
    exact Nat.le_of_dvd (by decide) J.card_specialToProjective_ker_dvd_three)
  let eπ := QuotientGroup.quotientKerEquivOfSurjective π J.specialToProjective_surjective
  let ρ : Representation (ZMod 2) (ProjectiveSpecialUnitaryMatrixGroup J) W :=
    (QuotientGroup.lift π.ker σ heq.ge).comp eπ.symm.toMonoidHom
  have hρ (g : J.specialSubgroup) : ρ (π g) = σ g := by
    have he : eπ.symm (π g) = QuotientGroup.mk' π.ker g :=
      eπ.symm_apply_eq.mpr rfl
    change QuotientGroup.lift π.ker σ heq.ge (eπ.symm (π g)) = σ g
    rw [he]
    rfl
  have hf : Function.Injective ρ := by
    apply ρ.ker_eq_bot_iff.mp
    apply bot_unique
    intro g hg
    obtain ⟨x,rfl⟩ := J.specialToProjective_surjective g
    change ρ (π x) = 1 at hg
    exact heq.le (by rwa [hρ] at hg)
  have hqρ : IsQuadratic ρ (A.map π) := by
    rintro _ ⟨a,ha,rfl⟩ _ ⟨b,hb,rfl⟩ w
    simpa only [hρ] using hq a ha b hb w
  have hinj : Function.Injective (π.subgroupMap A) := by
    apply (π.subgroupMap A).ker_eq_bot_iff.mp
    apply bot_unique
    intro a ha
    have hpa : π a = 1 := congrArg Subtype.val ha
    exact Subtype.ext (mem_bot.mp (hd.le_bot ⟨heq.ge hpa,hAT a.property⟩))
  have hcard : Nat.card (A.map π) = Nat.card A :=
    (Nat.card_congr (Equiv.ofBijective _ ⟨hinj,π.subgroupMap_surjective A⟩)).symm
  have hfixed : fixedSpace ρ (A.map π) = fixedSpace σ A := by
    rw [←fixedSpace_comp_map]
    have he : ρ.comp π = σ := MonoidHom.ext hρ
    rw [he]
  have hb := psu3_two_quadratic_square_bound J hc hconj ρ hf (A.map π) hqρ
  rwa [hcard,hfixed] at hb

variable {D W : Type*} [Group D] [Finite D]
  [AddCommGroup W] [Module (ZMod 2) W] [Finite W]

omit [Finite D] [Finite W] in
private theorem fixed_transport {E : Type*} [Group E]
    (σ : Representation (ZMod 2) D W) (e : D ≃* E) (A : Subgroup D) :
    fixedSpace (σ.comp e.symm.toMonoidHom) (A.map e.toMonoidHom) = fixedSpace σ A := by
  rw [fixedSpace_comp_map,Subgroup.map_map]
  have he : e.symm.toMonoidHom.comp e.toMonoidHom = MonoidHom.id D := by ext x; simp
  rw [he,Subgroup.map_id]

/-- Both marked degree-one unitary quotients satisfy the square bound without a faithful-action premise. -/
theorem small_unitary_generated_square_bound
    (hm : ClassicalGroup.IsPSU D 3 2 ∨ IsSU D 3 2) (hc : pCore 2 D = ⊥)
    (σ : Representation (ZMod 2) D W) (hnt : σ ≠ 1)
    (hg : ∀ T : Sylow 2 D, GeneratedByFixedSpace σ T)
    (A : Subgroup D) (hp : IsPGroup 2 A) (hq : IsQuadratic σ A) :
    Nat.card A ^ 2 ≤ Nat.card (W ⧸ fixedSpace σ A) := by
  obtain ⟨T,hAT⟩ := hp.exists_le_sylow
  have transport {E : Type} [Group E] (e : D ≃* E) :
      GeneratedByFixedSpace (σ.comp e.symm.toMonoidHom)
        ((T.mapSurjective (f := e.toMonoidHom) e.surjective) : Subgroup E) ∧
      (σ.comp e.symm.toMonoidHom) ≠ 1 ∧
      IsQuadratic (σ.comp e.symm.toMonoidHom) (A.map e.toMonoidHom) ∧
      pCore 2 E = ⊥ := by
    refine ⟨?_,?_,?_,?_⟩
    · exact generatedByFixedSpace_of_equivariant_surjection σ (σ.comp e.symm.toMonoidHom)
        e.toMonoidHom LinearMap.id Function.surjective_id (by intro x w; simp) T (hg T)
    · intro he
      apply hnt
      apply MonoidHom.ext
      intro x
      have hh := congrArg (fun τ : Representation (ZMod 2) E W => τ (e x)) he
      simpa using hh
    · rintro a ⟨x,hx,rfl⟩ b ⟨y,hy,rfl⟩ w
      simpa only [MonoidHom.comp_apply,MulEquiv.coe_toMonoidHom,e.symm_apply_apply] using hq x hx y hy w
    · rw [←pCore_map_iso 2 e,hc,Subgroup.map_bot]
  rcases hm with hm | hm
  · obtain ⟨F,hF,hfin,J,hcard,hconj,⟨e⟩⟩ := hm
    let := hF
    let := hfin
    obtain ⟨hgen,hne,hquad,hcore⟩ := transport e
    have hf := small_projective_constituent_faithful J hcard hconj hcore
      (σ.comp e.symm.toMonoidHom) (T.mapSurjective (f := e.toMonoidHom) e.surjective) hgen hne
    have hh := psu3_two_quadratic_square_bound J hcard hconj (σ.comp e.symm.toMonoidHom)
      hf (A.map e.toMonoidHom) hquad
    simpa only [fixed_transport,card_map_of_injective (f := e.toMonoidHom) e.injective] using hh
  · obtain ⟨F,hF,hfin,J,hcard,hconj,⟨e⟩⟩ := hm
    let := hF
    let := hfin
    obtain ⟨hgen,hne,hquad,hcore⟩ := transport e
    have hh := small_special_constituent_square_bound J hcard hconj hcore
      (σ.comp e.symm.toMonoidHom) (T.mapSurjective (f := e.toMonoidHom) e.surjective)
      (A.map e.toMonoidHom) (map_mono hAT) hgen hne hquad
    simpa only [fixed_transport,card_map_of_injective (f := e.toMonoidHom) e.injective] using hh
end CFSG.Quasithin.ChapterF.Source.Unitary
