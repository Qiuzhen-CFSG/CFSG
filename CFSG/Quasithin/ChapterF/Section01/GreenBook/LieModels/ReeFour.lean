module

public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.LocalIdentification
public import Theory.SpecificGroups.ReeF4.ParabolicAmalgam.OuterLocal
public import Theory.GroupTheory.Amalgam.RankTwo

/-!
# The concrete Ree-four case of F.1.12

For every q = 2^(2*m+1), the two marked root parabolics in the genuine
exceptional fixed-point carrier meet in the independently defined root Borel
and generate the carrier. The fixed positive subgroup is the chosen Sylow
two-subgroup. Both local factors, defined separately as embedded O^{2′} of
the parabolics, contain it. Their joins with the Borel give the parabolics,
with a compatible isomorphism of the two inclusion amalgams.

The intrinsic local quotients are the actual Sz(q) and PSL₂(q), and their
O₂ orders are q^10 and q^11. For m ≥ 1 both factors equal their solvable
residuals. Two-power automorphisms of the carrier are inner. At m = 0 the
carrier is the full ²F₄(2): its Suzuki quotient is Sz(2), and the proved
comparison with Aut(Tits) supplies the absence of further outer automorphisms.

The proofs assemble the root geometry, exact projection kernels, fixed root
coordinate counts and automorphism calculations. No construction, simplicity,
projection or generation hypothesis remains. This is the concrete model case;
recognition of an arbitrary source amalgam and extension elimination remain
with the parent F.1.12 theorem.

Source: Aschbacher–Smith F.1.4–5, F.1.11–12(I)(5) and (II),
printed pp.260,262–264, `refs/quasithin.pdf`.
-/

@[expose] public section
noncomputable section

namespace CFSG.Quasithin.ChapterF.GreenBook.LieModels.ReeFour

open Theory.GroupTheory
open ReeF4 ReeF4.Parabolics

private theorem subgroupAmalgam_compatibility {G : Type*} [Group G]
    (A B C : Subgroup G) (hA : B ≤ A) (hC : B ≤ C) (b : B) :
    ((RankTwoAmalgam.ofSubgroups A B C hA hC).left b : G) =
      ((RankTwoAmalgam.ofSubgroups A B C hA hC).right b : G) := rfl

/-- The root Borel maps into both marked parabolics in the actual Ree carrier. -/
def amalgam (m : ℕ) : RankTwoAmalgam (parabolic m .suzuki) (borel m)
    (parabolic m .linear) :=
  RankTwoAmalgam.ofSubgroups _ _ _
    (borel_le_parabolic m .suzuki) (borel_le_parabolic m .linear)

theorem left_injective (m : ℕ) : Function.Injective (amalgam m).left :=
  RankTwoAmalgam.ofSubgroups_left_injective _ _ _ _ _

theorem right_injective (m : ℕ) : Function.Injective (amalgam m).right :=
  RankTwoAmalgam.ofSubgroups_right_injective _ _ _ _ _

/-- The two inclusions have the same value in the actual ambient group. -/
theorem ambient_compatibility (m : ℕ) (b : borel m) :
    ((amalgam m).left b : Model m) = ((amalgam m).right b : Model m) :=
  subgroupAmalgam_compatibility (parabolic m .suzuki) (borel m) (parabolic m .linear)
    (borel_le_parabolic m .suzuki) (borel_le_parabolic m .linear) b

/-- An exact split intersection calculation descends to the fixed group.
This retained conditional interface is discharged by `overlap` below. -/
theorem overlap_of_split_intersection (m : ℕ)
    (h : splitParabolic m .suzuki ⊓ splitParabolic m .linear = splitBorel m) :
    parabolic m .suzuki ⊓ parabolic m .linear = borel m := by
  change (splitParabolic m .suzuki).comap (toSplitGroup m) ⊓
    (splitParabolic m .linear).comap (toSplitGroup m) = _
  rw [← Subgroup.comap_inf, h]
  rfl


open Subgroup ReeF4.LargeLocalSeeds BenderSuzuki.MatrixGroups

/-- The root Borel is the whole intersection of the two marked parabolics. -/
theorem overlap (m : ℕ) :
    parabolic m .suzuki ⊓ parabolic m .linear = borel m :=
  parabolic_inf_eq_borel m

/-- The source factors generate the actual fixed group for every field parameter. -/
theorem localFactors_generate (m : ℕ) :
    localFactor m .suzuki ⊔ localFactor m .linear = ⊤ := by
  rw [← seed_eq_localFactor, ← seed_eq_localFactor]
  exact OuterLocal.LargeAutomorphisms.seed_sup_eq_top m

/-- The full Ree group is generated by its two marked parabolics. -/
theorem parabolics_generate (m : ℕ) :
    parabolic m .suzuki ⊔ parabolic m .linear = ⊤ := by
  apply top_unique
  rw [← localFactors_generate m]
  exact sup_le_sup (localFactor_le_parabolic m .suzuki) (localFactor_le_parabolic m .linear)

/-- The positive subgroup has odd index, without a simplicity assumption. -/
theorem unipotent_index_odd (m : ℕ) : Odd (unipotent m).index :=
  OuterLocal.LargeAutomorphisms.unipotent_index_odd_of_standard (canonicalLocalBlockInput m)
    (FixedBruhat.standardUnipotent_index_odd (canonicalLocalBlockInput m))

/-- The source Sylow subgroup is exactly the fixed positive root subgroup. -/
def sylow (m : ℕ) : Sylow 2 (Model m) := sylowOfOddIndex m (unipotent_index_odd m)

@[simp] theorem sylow_coe (m : ℕ) : (sylow m : Subgroup (Model m)) = unipotent m := rfl

theorem sylow_le_localFactor (m : ℕ) (s : Side) :
    (sylow m : Subgroup (Model m)) ≤ localFactor m s := unipotent_le_localFactor m s

theorem sylow_normalizer (m : ℕ) :
    normalizer (sylow m : Set (Model m)) = borel m := unipotent_normalizer_eq_borel m

theorem sylow_card (m : ℕ) : Nat.card (sylow m) = (2 ^ (2 * m + 1)) ^ 12 :=
  card_unipotent m

/-- The literal source inclusion amalgam (L₁B,B,L₂B). -/
def sourceAmalgam (m : ℕ) :
    RankTwoAmalgam (localFactor m .suzuki ⊔ borel m : Subgroup (Model m)) (borel m)
      (localFactor m .linear ⊔ borel m : Subgroup (Model m)) :=
  RankTwoAmalgam.ofSubgroups _ _ _ le_sup_right le_sup_right

/-- Equality with the root parabolics gives both commuting squares, using
one unchanged element of the whole overlap on each side. -/
def sourceAmalgamIso (m : ℕ) : RankTwoAmalgam.Iso (sourceAmalgam m) (amalgam m) where
  left := MulEquiv.subgroupCongr (parabolic_eq_localFactor_sup_borel m .suzuki).symm
  middle := MulEquiv.refl _
  right := MulEquiv.subgroupCongr (parabolic_eq_localFactor_sup_borel m .linear).symm
  left_commutes _ := Subtype.ext rfl
  right_commutes _ := Subtype.ext rfl

/-- Adjoining the chosen Sylow subgroup does not enlarge either source factor. -/
theorem localFactor_sup_sylow (m : ℕ) (s : Side) :
    localFactor m s ⊔ (sylow m : Subgroup (Model m)) = localFactor m s :=
  sup_eq_left.mpr (sylow_le_localFactor m s)

/-- The p.264 core equality, compared inside the same ambient carrier. -/
theorem localFactor_sup_sylow_core (m : ℕ) (s : Side) :
    (pCore 2 (localFactor m s ⊔ (sylow m : Subgroup (Model m)) : Subgroup (Model m))).map
        (localFactor m s ⊔ (sylow m : Subgroup (Model m))).subtype =
      (pCore 2 (localFactor m s)).map (localFactor m s).subtype := by
  rw [localFactor_sup_sylow]

/-- The complete local quotient and core-order clauses of F.1.12(I)(5),
for the actual O^{2′} factors of the concrete Ree parabolics. -/
theorem source_local_structure (m : ℕ) :
    Nonempty ((localFactor m .suzuki ⧸ pCore 2 (localFactor m .suzuki)) ≃*
      SuzukiMatrixGroup m) ∧
    Nat.card (pCore 2 (localFactor m .suzuki)) = (2 ^ (2 * m + 1)) ^ 10 ∧
    Nonempty ((localFactor m .linear ⧸ pCore 2 (localFactor m .linear)) ≃*
      Matrix.ProjectiveSpecialLinearGroup (Fin 2) (CoefficientField m)) ∧
    Nat.card (pCore 2 (localFactor m .linear)) = (2 ^ (2 * m + 1)) ^ 11 :=
  ⟨⟨suzukiLocalQuotientEquiv m⟩, card_local_pCore_suzuki m,
    ⟨linearLocalQuotientEquiv m⟩, card_local_pCore_linear m⟩

/-- The large-field alternative F.1.12(II)(i), with the actual solvable
residual and the same marked Sylow subgroup in both factors. -/
theorem source_large_residuals {m : ℕ} (hm : 1 ≤ m) (s : Side) :
    (solvableResidual (localFactor m s)).map (localFactor m s).subtype = localFactor m s ∧
      (sylow m : Subgroup (Model m)) ≤ localFactor m s :=
  ⟨OuterLocal.localFactor_solvableResidual_eq_self hm s, sylow_le_localFactor m s⟩

/-- The binary parameter is precisely the exceptional Ree alternative of
F.1.12(II)(ii); all other parameters satisfy (II)(i). -/
theorem source_residual_alternatives (m : ℕ) :
    (∀ s : Side,
      (solvableResidual (localFactor m s)).map (localFactor m s).subtype = localFactor m s ∧
        (sylow m : Subgroup (Model m)) ≤ localFactor m s) ∨ m = 0 := by
  by_cases hm : m = 0
  · exact Or.inr hm
  · exact Or.inl (source_large_residuals (by omega))

/-- The automorphism input for the parent's two-group extension elimination. -/
theorem twoPower_automorphism_inner (m : ℕ) (α : MulAut (Model m)) (n : ℕ)
    (hα : α ^ (2 ^ n) = 1) : ∃ g : Model m, MulAut.conj g = α :=
  OuterLocal.inner_of_twoPower m α n hα

/-- At q = 2 the full fixed group is the actual automorphism group of the
Tits derived group, via the proved derived action and group comparison. -/
theorem binary_titsAut_comparison : Nonempty (Model 0 ≃* MulAut Tits.ParrottGroup) := by
  obtain ⟨e⟩ := ReeF4.DerivedTits.nonempty_derived_equiv
  exact ⟨OuterLocal.binaryTitsAutEquiv e (OuterLocal.binaryDerivedAction_bijective e)⟩

/-- There are no further outer automorphisms of the full binary Ree group. -/
theorem binary_automorphism_inner (α : MulAut (Model 0)) :
    ∃ g : Model 0, MulAut.conj g = α := OuterLocal.binary_inner α

/-- At the binary endpoint the independently defined overlap is the chosen
Sylow subgroup in the full Ree carrier. -/
theorem binary_overlap : borel 0 = (sylow 0 : Subgroup (Model 0)) := borel_zero

/-- The binary source factors are the whole binary parabolics. -/
theorem binary_localFactor (s : Side) : localFactor 0 s = parabolic 0 s :=
  (seed_eq_localFactor 0 s).symm.trans (parabolic_zero s).symm

/-- A single witness assembles the marked geometry, compatible amalgam maps,
source local factors, quotient isomorphisms and core orders for case (5). -/
theorem concrete_case_five (m : ℕ) :
    ∃ S : Sylow 2 (Model m),
      (S : Subgroup (Model m)) = unipotent m ∧
      normalizer (S : Set (Model m)) = borel m ∧
      parabolic m .suzuki ⊓ parabolic m .linear = borel m ∧
      parabolic m .suzuki ⊔ parabolic m .linear = ⊤ ∧
      Nonempty (RankTwoAmalgam.Iso (sourceAmalgam m) (amalgam m)) ∧
      (∀ s : Side, (S : Subgroup (Model m)) ≤ localFactor m s) ∧
      Nonempty ((localFactor m .suzuki ⧸ pCore 2 (localFactor m .suzuki)) ≃*
        SuzukiMatrixGroup m) ∧
      Nat.card (pCore 2 (localFactor m .suzuki)) = (2 ^ (2 * m + 1)) ^ 10 ∧
      Nonempty ((localFactor m .linear ⧸ pCore 2 (localFactor m .linear)) ≃*
        Matrix.ProjectiveSpecialLinearGroup (Fin 2) (CoefficientField m)) ∧
      Nat.card (pCore 2 (localFactor m .linear)) = (2 ^ (2 * m + 1)) ^ 11 :=
  ⟨sylow m, sylow_coe m, sylow_normalizer m, overlap m, parabolics_generate m,
    ⟨sourceAmalgamIso m⟩, sylow_le_localFactor m, source_local_structure m⟩

end CFSG.Quasithin.ChapterF.GreenBook.LieModels.ReeFour
