module

public import CFSG.Quasithin.ChapterF.Section01.GreenBook.UnitaryFive.LocalStructure.LineCore
public import CFSG.Quasithin.ChapterF.Section01.GreenBook.UnitaryFive.LocalStructure.PlaneCore
public import Theory.SpecificGroups.ClassicalUnitary.FiveParabolicRadical.Flag.Basic
public import Theory.GroupTheory.CoprimeIndexMarking
public import Theory.AtlasPort.LinearGroups.SL2Order

/-!
# A common matrix Sylow subgroup and its parabolic markings

The plane radical and upper-unitriangular SL₂ Levi generate a concrete
subgroup of the full flag overlap. The plane residual projection identifies
it with the pullback of the upper SL₂ Sylow, proving its order is 2²⁰. The
already proved indices give overlap index 45 and Sylow markings in both
parabolics. Relative normality and residual index three put this common
Sylow inside both residuals. All markings commute with the original amalgam
inclusions, and coprime indices prove that each residual and the full overlap
generate its parabolic.

The intrinsic local Sylow normalizers and the embedded center of the common
Sylow are named here for the remaining Borel and centralization calculations.
This module does not yet assert normality in the overlap, identify those
normalizers with intersections, or assert their generation of the overlap.

Source: Aschbacher--Smith, *The Classification of Quasithin Groups*,
F.1.3, F.1.11--12(7), printed pp.260 and 262--264.
-/

@[expose] public section

namespace CFSG.Quasithin.ChapterF.GreenBook.UnitaryFive.Model
open Matrix Theory.SpecificGroups.UnitaryFive
variable (M : Model 4)

/-- The left residual embedded by the parabolic subtype map. -/
def leftLocalImage : Subgroup M.Carrier := M.leftLocal.map M.leftParabolic.subtype

/-- The right residual embedded by the parabolic subtype map. -/
def rightLocalImage : Subgroup M.Carrier := M.rightLocal.map M.rightParabolic.subtype

/-- The concrete plane radical joined with its upper-unitriangular SL₂ Levi. -/
noncomputable def flagRight : Subgroup M.rightParabolic :=
  Flag.unipotent M.form M.rightLeviTrace M.rightLeviTrace_spec M.matrix

/-- The same matrix subgroup in the common projective carrier. -/
noncomputable def flagTwoSubgroup : Subgroup M.Carrier := M.flagRight.map M.rightParabolic.subtype

/-- The concrete unipotents preserve both members of the marked flag. -/
theorem flagRight_le_overlap : M.flagRight ≤ M.overlap.subgroupOf M.rightParabolic := by
  intro g hg
  exact ⟨Flag.unipotent_le_lineParabolic M.form M.rightLeviTrace
    M.rightLeviTrace_spec M.matrix hg, g.property⟩

/-- The common two-subgroup lies in the full overlap. -/
theorem flagTwoSubgroup_le_overlap : M.flagTwoSubgroup ≤ M.overlap := by
  rintro _ ⟨g, hg, rfl⟩
  exact M.flagRight_le_overlap hg

/-- The concrete matrix subgroup is a two-group. -/
theorem flagRight_isPGroup : IsPGroup 2 M.flagRight :=
  Flag.unipotent_isPGroup M.form M.rightLeviTrace M.rightLeviTrace_spec M.matrix

/-- Its image in the projective carrier is a two-group. -/
theorem flagTwoSubgroup_isPGroup : IsPGroup 2 M.flagTwoSubgroup :=
  M.flagRight_isPGroup.map M.rightParabolic.subtype

/-- Pull back the upper-unitriangular Sylow through the actual residual Levi map. -/
noncomputable def rightLocalSylow : Sylow 2 M.rightLocal :=
  (SpecialLinearGroup.upperUnipotentSylow M.F 2).comapOfKerIsPGroup
    M.rightLocalProjection (by rw [M.rightLocalProjection_ker]; exact pCore_isPGroup)
    (by rw [MonoidHom.range_eq_top.mpr M.rightLocalProjection_surjective]; exact le_top)

/-- The pullback is exactly the subgroup generated by the concrete matrix factors. -/
theorem rightLocalSylow_map :
    (M.rightLocalSylow : Subgroup M.rightLocal).map M.rightLocal.subtype = M.flagRight := by
  apply le_antisymm
  · rintro _ ⟨g, hg, rfl⟩
    obtain ⟨p, rfl⟩ := M.rightLocalEquiv.surjective g
    change M.rightLocalProjection (M.rightLocalEquiv p) ∈
      SpecialLinearGroup.upperUnipotent M.F at hg
    rw [M.rightLocalProjection_equiv] at hg
    change (M.rightLocalEquiv p).val ∈ M.flagRight
    rw [M.rightLocalEquiv_val]
    exact M.flagRight.mul_mem
      (Subgroup.mem_sup_left (show PlaneCore.Parameters.toParabolic M.matrix p.left ∈
        M.rightUnipotent from ⟨p.left, rfl⟩))
      (Subgroup.mem_sup_right ⟨p.right, hg, rfl⟩)
  · change M.rightUnipotent ⊔
      (SpecialLinearGroup.upperUnipotent M.F).map M.rightSLLevi ≤ _
    apply sup_le
    · rw [← M.rightLocal_pCore_map]
      apply Subgroup.map_mono
      intro g hg
      change M.rightLocalProjection g ∈ SpecialLinearGroup.upperUnipotent M.F
      rw [← M.rightLocalProjection_ker] at hg
      rw [MonoidHom.mem_ker.mp hg]
      exact Subgroup.one_mem _
    · rintro _ ⟨A, hA, rfl⟩
      refine ⟨M.rightLocalEquiv ⟨1, A⟩, ?_, ?_⟩
      · change M.rightLocalProjection (M.rightLocalEquiv ⟨1, A⟩) ∈
          SpecialLinearGroup.upperUnipotent M.F
        rwa [M.rightLocalProjection_equiv]
      · change (M.rightLocalEquiv ⟨1, A⟩).val = _
        simp only [M.rightLocalEquiv_val, map_one, one_mul]

/-- The upper SL₂ subgroup has index 255; pulling back preserves this index. -/
theorem rightLocalSylow_index : (M.rightLocalSylow : Subgroup M.rightLocal).index = 255 := by
  change ((SpecialLinearGroup.upperUnipotent M.F).comap M.rightLocalProjection).index = _
  rw [Subgroup.index_comap_of_surjective _ M.rightLocalProjection_surjective]
  have h := (SpecialLinearGroup.upperUnipotent M.F).card_mul_index
  rw [SpecialLinearGroup.card_upperUnipotent, Atlas.card_sl_two, M.local_field_card] at h
  omega

/-- The residual order follows from its canonical core and actual SL₂ quotient. -/
theorem rightLocal_card : Nat.card M.rightLocal = 2 ^ 20 * 255 := by
  have h := M.rightLocalProjection.ker.card_mul_index
  rw [Subgroup.index_ker, M.rightLocalProjection_ker, M.rightLocal_pCore_card,
    MonoidHom.range_eq_top.mpr M.rightLocalProjection_surjective,
    Nat.card_congr Subgroup.topEquiv.toEquiv, Atlas.card_sl_two, M.local_field_card] at h
  norm_num only [Nat.reducePow, Nat.reduceMul, Nat.reduceSub] at h ⊢
  exact h.symm

/-- The full plane parabolic has three times the residual order. -/
theorem rightParabolic_card : Nat.card M.rightParabolic = 2 ^ 20 * 765 := by
  have h := M.rightLocal.card_mul_index
  rw [M.rightLocal_card, M.rightLocal_index] at h
  norm_num only [Nat.reducePow, Nat.reduceMul, Nat.reduceSub] at h ⊢
  exact h.symm

/-- The pullback Sylow has order 2²⁰. -/
theorem rightLocalSylow_card : Nat.card M.rightLocalSylow = 2 ^ 20 := by
  have h := (M.rightLocalSylow : Subgroup M.rightLocal).card_mul_index
  rw [M.rightLocalSylow_index, M.rightLocal_card] at h
  omega

/-- The concrete matrix subgroup has the expected Sylow order. -/
theorem flagRight_card : Nat.card M.flagRight = 2 ^ 20 := by
  rw [← M.rightLocalSylow_map,
    Nat.card_congr (Subgroup.equivMapOfInjective _ _ Subtype.val_injective).toEquiv.symm]
  exact M.rightLocalSylow_card

/-- The common-carrier subgroup has order 2²⁰. -/
theorem flagTwoSubgroup_card : Nat.card M.flagTwoSubgroup = 2 ^ 20 := by
  rw [flagTwoSubgroup,
    Nat.card_congr (Subgroup.equivMapOfInjective _ _ Subtype.val_injective).toEquiv.symm]
  exact M.flagRight_card

/-- The Sylow index in the full plane parabolic is 765. -/
theorem flagRight_index : M.flagRight.index = 765 := by
  have h := M.flagRight.card_mul_index
  rw [M.flagRight_card, M.rightParabolic_card] at h
  omega

/-- Flag index seventeen gives the full overlap order 2²⁰ · 45. -/
theorem overlap_card : Nat.card M.overlap = 2 ^ 20 * 45 := by
  have h := (M.overlap.subgroupOf M.rightParabolic).card_mul_index
  rw [M.overlap_rightParabolic_index, M.rightParabolic_card,
    Nat.card_congr (Subgroup.subgroupOfEquivOfLe (show M.overlap ≤ M.rightParabolic
      from inf_le_right)).toEquiv] at h
  omega

/-- The full overlap has 45 cosets of its constructed two-subgroup. -/
theorem flagTwoSubgroup_relIndex_overlap : M.flagTwoSubgroup.relIndex M.overlap = 45 := by
  have h := (M.flagTwoSubgroup.subgroupOf M.overlap).card_mul_index
  rw [Nat.card_congr (Subgroup.subgroupOfEquivOfLe M.flagTwoSubgroup_le_overlap).toEquiv,
    M.flagTwoSubgroup_card, M.overlap_card] at h
  change _ * M.flagTwoSubgroup.relIndex M.overlap = _ at h
  omega

/-- The residual Sylow remains Sylow through its index-three inclusion. -/
noncomputable def rightParabolicSylow : Sylow 2 M.rightParabolic :=
  M.rightLocalSylow.mapSubtypeOfIndexPrimeTo (by rw [M.rightLocal_index]; decide)

/-- The constructed subgroup is Sylow in the overlap. -/
noncomputable def overlapSylow : Sylow 2 M.overlap :=
  M.flagTwoSubgroup_isPGroup.comap_subtype.toSylow
    (by change ¬ 2 ∣ M.flagTwoSubgroup.relIndex M.overlap
        rw [M.flagTwoSubgroup_relIndex_overlap]; decide)

/-- The overlap subtype map retains exactly the common-carrier subgroup. -/
theorem overlapSylow_map : (M.overlapSylow : Subgroup M.overlap).map M.overlap.subtype =
    M.flagTwoSubgroup := Subgroup.map_subgroupOf_eq_of_le M.flagTwoSubgroup_le_overlap

/-- The common Sylow lies in the embedded right residual. -/
theorem flagTwoSubgroup_le_rightLocalImage : M.flagTwoSubgroup ≤ M.rightLocalImage := by
  rw [flagTwoSubgroup, ← M.rightLocalSylow_map, rightLocalImage]
  apply Subgroup.map_mono
  simpa only [Subgroup.range_subtype] using
    (Subgroup.map_le_range M.rightLocal.subtype (M.rightLocalSylow : Subgroup M.rightLocal))

/-- Index three and relative normality place the left marking inside the residual. -/
theorem flagLeft_le_leftLocal :
    M.flagTwoSubgroup.subgroupOf M.leftParabolic ≤ M.leftLocal :=
  IsPGroup.le_normal_of_index_primeTo M.leftLocal _
    M.flagTwoSubgroup_isPGroup.comap_subtype
    (by rw [M.leftLocal_index_eq_three]; decide)

/-- The common Sylow lies in the embedded left residual. -/
theorem flagTwoSubgroup_le_leftLocalImage : M.flagTwoSubgroup ≤ M.leftLocalImage := by
  intro g hg
  exact ⟨⟨g, (M.flagTwoSubgroup_le_overlap hg).1⟩,
    M.flagLeft_le_leftLocal hg, rfl⟩

/-- The indices 45 and 65 give the Sylow index 2925 in the line parabolic. -/
theorem flagTwoSubgroup_relIndex_left :
    M.flagTwoSubgroup.relIndex M.leftParabolic = 2925 := by
  have h := Subgroup.relIndex_mul_relIndex M.flagTwoSubgroup M.overlap M.leftParabolic
    M.flagTwoSubgroup_le_overlap inf_le_left
  rw [M.flagTwoSubgroup_relIndex_overlap,
    show M.overlap.relIndex M.leftParabolic = 65 from M.overlap_index_eq_sixtyFive] at h
  exact h.symm

/-- The same flag subgroup is Sylow in the line parabolic. -/
noncomputable def leftParabolicSylow : Sylow 2 M.leftParabolic :=
  M.flagTwoSubgroup_isPGroup.comap_subtype.toSylow
    (by change ¬ 2 ∣ M.flagTwoSubgroup.relIndex M.leftParabolic
        rw [M.flagTwoSubgroup_relIndex_left]; decide)

/-- Restrict the common Sylow to the left residual that contains it. -/
noncomputable def leftLocalSylow : Sylow 2 M.leftLocal :=
  M.leftParabolicSylow.subtype M.flagLeft_le_leftLocal

/-- The line-parabolic marking is the literal common-carrier subgroup. -/
theorem leftParabolicSylow_map :
    (M.leftParabolicSylow : Subgroup M.leftParabolic).map M.leftParabolic.subtype =
      M.flagTwoSubgroup :=
  Subgroup.map_subgroupOf_eq_of_le (M.flagTwoSubgroup_le_overlap.trans inf_le_left)

/-- The plane-parabolic marking is the literal common-carrier subgroup. -/
theorem rightParabolicSylow_map :
    (M.rightParabolicSylow : Subgroup M.rightParabolic).map M.rightParabolic.subtype =
      M.flagTwoSubgroup := by
  change ((M.rightLocalSylow : Subgroup M.rightLocal).map M.rightLocal.subtype).map
    M.rightParabolic.subtype = M.flagTwoSubgroup
  rw [M.rightLocalSylow_map]
  rfl

/-- The left residual and parabolic markings agree through their subtype map. -/
theorem leftLocalSylow_map :
    (M.leftLocalSylow : Subgroup M.leftLocal).map M.leftLocal.subtype =
      (M.leftParabolicSylow : Subgroup M.leftParabolic) :=
  Subgroup.map_subgroupOf_eq_of_le M.flagLeft_le_leftLocal

/-- The left residual marking agrees in the common carrier. -/
theorem leftLocalSylow_carrier_map :
    (M.leftLocalSylow : Subgroup M.leftLocal).map
      (M.leftParabolic.subtype.comp M.leftLocal.subtype) = M.flagTwoSubgroup := by
  rw [← Subgroup.map_map, M.leftLocalSylow_map, M.leftParabolicSylow_map]

/-- The right residual marking agrees in the common carrier. -/
theorem rightLocalSylow_carrier_map :
    (M.rightLocalSylow : Subgroup M.rightLocal).map
      (M.rightParabolic.subtype.comp M.rightLocal.subtype) = M.flagTwoSubgroup := by
  rw [← Subgroup.map_map, M.rightLocalSylow_map]
  rfl

/-- The original amalgam left map preserves the common Sylow marking. -/
theorem amalgam_left_sylow_marking :
    (M.overlapSylow : Subgroup M.overlap).map M.amalgam.left =
      (M.leftParabolicSylow : Subgroup M.leftParabolic) := by
  apply Subgroup.map_injective (f := M.leftParabolic.subtype) Subtype.val_injective
  rw [Subgroup.map_map, M.leftParabolicSylow_map]
  exact M.overlapSylow_map

/-- The original amalgam right map preserves the common Sylow marking. -/
theorem amalgam_right_sylow_marking :
    (M.overlapSylow : Subgroup M.overlap).map M.amalgam.right =
      (M.rightParabolicSylow : Subgroup M.rightParabolic) := by
  apply Subgroup.map_injective (f := M.rightParabolic.subtype) Subtype.val_injective
  rw [Subgroup.map_map, M.rightParabolicSylow_map]
  exact M.overlapSylow_map

/-- Coprime indices three and 65 give generation inside the line parabolic. -/
theorem leftLocal_sup_overlap :
    M.leftLocal ⊔ M.overlap.subgroupOf M.leftParabolic = ⊤ :=
  Subgroup.sup_eq_top_of_coprime_index _ _
    (by rw [M.leftLocal_index_eq_three, M.overlap_index_eq_sixtyFive]; decide)

/-- Coprime indices three and seventeen give generation inside the plane parabolic. -/
theorem rightLocal_sup_overlap :
    M.rightLocal ⊔ M.overlap.subgroupOf M.rightParabolic = ⊤ :=
  Subgroup.sup_eq_top_of_coprime_index _ _
    (by rw [M.rightLocal_index, M.overlap_rightParabolic_index]; decide)

/-- The source parabolic P₁ is generated by its embedded residual and B. -/
theorem leftLocalImage_sup_overlap : M.leftLocalImage ⊔ M.overlap = M.leftParabolic := by
  have h := congrArg (Subgroup.map M.leftParabolic.subtype) M.leftLocal_sup_overlap
  rw [Subgroup.map_sup, ← MonoidHom.range_eq_map, Subgroup.range_subtype,
    Subgroup.map_subgroupOf_eq_of_le (show M.overlap ≤ M.leftParabolic from inf_le_left)] at h
  exact h

/-- The source parabolic P₂ is generated by its embedded residual and B. -/
theorem rightLocalImage_sup_overlap : M.rightLocalImage ⊔ M.overlap = M.rightParabolic := by
  have h := congrArg (Subgroup.map M.rightParabolic.subtype) M.rightLocal_sup_overlap
  rw [Subgroup.map_sup, ← MonoidHom.range_eq_map, Subgroup.range_subtype,
    Subgroup.map_subgroupOf_eq_of_le (show M.overlap ≤ M.rightParabolic from inf_le_right)] at h
  exact h

/-- Intrinsic Sylow normalizer in the left residual. -/
noncomputable def leftSylowNormalizer : Subgroup M.leftLocal :=
  Subgroup.normalizer (M.leftLocalSylow : Set M.leftLocal)

/-- Intrinsic Sylow normalizer in the right residual. -/
noncomputable def rightSylowNormalizer : Subgroup M.rightLocal :=
  Subgroup.normalizer (M.rightLocalSylow : Set M.rightLocal)

/-- The source B₁ in the common projective carrier. -/
noncomputable def leftSylowNormalizerImage : Subgroup M.Carrier :=
  M.leftSylowNormalizer.map (M.leftParabolic.subtype.comp M.leftLocal.subtype)

/-- The source B₂ in the common projective carrier. -/
noncomputable def rightSylowNormalizerImage : Subgroup M.Carrier :=
  M.rightSylowNormalizer.map (M.rightParabolic.subtype.comp M.rightLocal.subtype)

/-- The actual center of the common Sylow subgroup, embedded in the carrier. -/
noncomputable def flagCenter : Subgroup M.Carrier :=
  (Subgroup.center M.flagTwoSubgroup).map M.flagTwoSubgroup.subtype

/-- The common Sylow lies in the source B₁. -/
theorem flagTwoSubgroup_le_leftSylowNormalizerImage :
    M.flagTwoSubgroup ≤ M.leftSylowNormalizerImage := by
  rw [← M.leftLocalSylow_carrier_map]
  exact Subgroup.map_mono (Subgroup.le_normalizer)

/-- The common Sylow lies in the source B₂. -/
theorem flagTwoSubgroup_le_rightSylowNormalizerImage :
    M.flagTwoSubgroup ≤ M.rightSylowNormalizerImage := by
  rw [← M.rightLocalSylow_carrier_map]
  exact Subgroup.map_mono (Subgroup.le_normalizer)

/-- The full flag overlap is strictly larger than its Sylow two-subgroup. -/
theorem flagTwoSubgroup_ne_overlap : M.flagTwoSubgroup ≠ M.overlap := by
  intro h
  have hc := M.flagTwoSubgroup_card
  rw [h, M.overlap_card] at hc
  norm_num at hc

/-- The left residual image is normal relative to its parabolic. -/
theorem leftLocalImage_normal_in_parabolic :
    (M.leftLocalImage.subgroupOf M.leftParabolic).Normal := by
  change ((M.leftLocal.map M.leftParabolic.subtype).comap M.leftParabolic.subtype).Normal
  rw [Subgroup.comap_map_eq_self_of_injective Subtype.val_injective]
  infer_instance

/-- The right residual image is normal relative to its parabolic. -/
theorem rightLocalImage_normal_in_parabolic :
    (M.rightLocalImage.subgroupOf M.rightParabolic).Normal := by
  change ((M.rightLocal.map M.rightParabolic.subtype).comap M.rightParabolic.subtype).Normal
  rw [Subgroup.comap_map_eq_self_of_injective Subtype.val_injective]
  infer_instance

end CFSG.Quasithin.ChapterF.GreenBook.UnitaryFive.Model
