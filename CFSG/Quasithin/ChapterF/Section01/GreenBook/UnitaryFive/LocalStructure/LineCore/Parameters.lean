module

public import CFSG.Quasithin.ChapterF.Section01.GreenBook.UnitaryFive.LocalStructure.Setup
public import CFSG.Quasithin.ChapterF.Section01.RankOneBorels.Unitary.FieldParameters
public import Theory.SpecificGroups.ClassicalUnitary.FiveParabolicRadical.LineCore.Coordinates

/-!
# Parameters for the line-parabolic calculation at unitary parameter four

The identity-form SU₃ group acts on the isotropic line generated by `(1,1,0)`.
We retain its actual stabilizer for the overlap calculation. The fixed field
has four elements, and a trace-one scalar exists. These facts specialize the
unitary radical coordinate group to a special two-group of order `4^7`, with
center of order four.

These are assertions about the explicitly constructed coordinate group.
An isomorphism with the canonical core of the line residual still needs the
full parabolic and Levi calculation; none is assumed here.

Source: Aschbacher--Smith, *The Classification of Quasithin Groups*,
F.1.11--12(7), printed pp.262--264.
-/

@[expose] public section

namespace CFSG.Quasithin.ChapterF.GreenBook.UnitaryFive.Model
open Theory.SpecificGroups.UnitaryFive.LineCore
open BenderSuzuki.MatrixGroups Matrix
open scoped Pointwise
variable (M : Model 4)

instance localUnitaryGroup_finite : Finite M.LocalUnitaryGroup := by
  let : Finite (GL (Fin 3) M.F) := Finite.of_injective Units.val Units.val_injective
  infer_instance

/-- The isotropic line in the middle three-space induced by the original flag plane. -/
def localUnitaryLine : Submodule M.F (Fin 3 → M.F) where
  carrier := {v | v 1 = v 0 ∧ v 2 = 0}
  zero_mem' := by simp
  add_mem' := by rintro x y ⟨h1,h2⟩ ⟨k1,k2⟩; simp_all
  smul_mem' := by rintro c x ⟨h1,h2⟩; simp_all

/-- The natural matrix action of the actual SU₃ Levi group. -/
def localUnitaryAction : M.LocalUnitaryGroup →*
    ((Fin 3 → M.F) ≃ₗ[M.F] (Fin 3 → M.F)) :=
  ((LinearMap.GeneralLinearGroup.generalLinearEquiv M.F (Fin 3 → M.F)).toMonoidHom.comp
    Matrix.GeneralLinearGroup.toLin.toMonoidHom).comp M.localUnitaryForm.specialSubgroup.subtype

/-- The exact SU₃ stabilizer of the isotropic line induced by the flag. -/
def localUnitaryLineStabilizer : Subgroup M.LocalUnitaryGroup :=
  (MulAction.stabilizer ((Fin 3 → M.F) ≃ₗ[M.F] (Fin 3 → M.F)) M.localUnitaryLine).comap
    M.localUnitaryAction

theorem mem_localUnitaryLineStabilizer_iff (A : M.LocalUnitaryGroup) :
    A ∈ M.localUnitaryLineStabilizer ↔
      ∀ v, (A.val : Matrix (Fin 3) (Fin 3) M.F) *ᵥ v ∈ M.localUnitaryLine ↔
        v ∈ M.localUnitaryLine := by
  change M.localUnitaryAction A ∈ MulAction.stabilizer _ M.localUnitaryLine ↔ _
  rw [Submodule.stabilizer_coe, MulAction.mem_stabilizer_set]
  rfl

/-- The coordinate group proposed for the full line radical. -/
abbrev LineRadicalCoordinates := Coord M.form

theorem line_fixedField_card : Nat.card {z : M.F // M.form.conj z = z} = 4 := by
  exact Source.Unitary.fixed_card M.localUnitaryForm 2 (by decide) M.card M.conjugation

theorem exists_lineTraceOne : ∃ c : M.F, c + M.form.conj c = 1 := by
  apply exists_trace_one
  by_contra! h
  have hc := Nat.card_congr (Equiv.ofBijective
    (fun x : {z : M.F // M.form.conj z = z} => x.val)
    ⟨Subtype.val_injective, fun x => ⟨⟨x, h x⟩, rfl⟩⟩)
  rw [M.line_fixedField_card, M.local_field_card] at hc
  norm_num at hc

theorem lineRadicalCoordinates_isPGroup : IsPGroup 2 M.LineRadicalCoordinates :=
  Coord.isPGroup

theorem card_lineRadicalCoordinates : Nat.card M.LineRadicalCoordinates = 4 ^ 7 := by
  obtain ⟨c, hc⟩ := M.exists_lineTraceOne
  rw [Coord.card c hc, M.local_field_card, M.line_fixedField_card]
  norm_num

theorem card_center_lineRadicalCoordinates :
    Nat.card (Subgroup.center M.LineRadicalCoordinates) = 4 := by
  obtain ⟨c, hc⟩ := M.exists_lineTraceOne
  rw [Coord.card_center c hc, M.line_fixedField_card]

theorem commutator_lineRadicalCoordinates :
    commutator M.LineRadicalCoordinates = Subgroup.center M.LineRadicalCoordinates := by
  obtain ⟨c, hc⟩ := M.exists_lineTraceOne
  exact Coord.commutator_eq_center c hc

theorem frattini_lineRadicalCoordinates :
    frattini M.LineRadicalCoordinates = Subgroup.center M.LineRadicalCoordinates := by
  obtain ⟨c, hc⟩ := M.exists_lineTraceOne
  exact Coord.frattini_eq_center c hc

end CFSG.Quasithin.ChapterF.GreenBook.UnitaryFive.Model
