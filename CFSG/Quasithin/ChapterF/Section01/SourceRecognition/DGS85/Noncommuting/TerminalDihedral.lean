module
public import Theory.Representation.RankOne.QuadraticRecognition.SourceTheorem
public import Theory.Representation.BinaryQuinticDisplacement
public import Theory.GroupTheory.PResidual.SylowSupplement
public import Theory.GroupTheory.PResidual.Quotient
public import Theory.GroupTheory.SylowNormalRestriction
public import Mathlib.GroupTheory.SpecificGroups.Dihedral

/-!
# Excluding the terminal dihedral quotient

A binary module generated by its Sylow fixed space detects the two-residual
whenever that Sylow acts faithfully. For D₁₀ this forces the full action
kernel to be trivial: the only possible nontrivial odd kernel has order five
and contains the two-residual.

A nontrivial Sylow subgroup has order two. Its reflection has a quintic
commutator, so it moves at least two binary dimensions. The fixed-space
index is therefore greater than the actor order. This excludes the D₁₀
row in the terminal Chapter 7 argument without adding it to the corrected
Chapter 5 catalogue or assuming residual fixed-space vanishing.
Source: DGS, *Groups and Graphs* (1985), the final comparison in (7.5), p.131.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender
open Representation.RankOne.QuadraticRecognition
namespace CFSG.Quasithin.ChapterF.Source.DGS85.Noncommuting
variable {D W : Type*} [Group D] [Finite D]
  [AddCommGroup W] [Module (ZMod 2) W] [Finite W]

omit [Finite W] in
private theorem residual_detected (σ : Representation (ZMod 2) D W)
    (T : Sylow 2 D) (hg : GeneratedByFixedSpace σ T)
    (hd : Disjoint σ.ker (T : Subgroup D)) (hne : (T : Subgroup D) ≠ ⊥) :
    ¬ pResidual 2 D ≤ σ.ker := by
  intro hk
  have hR : fixedSpace σ (pResidual 2 D) = ⊤ := by
    apply top_unique
    intro w _ a
    change σ a w = w
    rw [show σ a = 1 from hk a.property]
    rfl
  have hfix : fixedSpace σ ⊤ = fixedSpace σ T := by
    have he := σ.invariants_comp_sup (pResidual 2 D) (T : Subgroup D)
    change fixedSpace σ (pResidual 2 D ⊔ (T : Subgroup D)) =
      fixedSpace σ (pResidual 2 D) ⊓ fixedSpace σ T at he
    rwa [pResidual_sup_sylow_eq_top T,hR,top_inf_eq] at he
  have hspan : (⨆ g : D, (fixedSpace σ T).map (σ g)) ≤ fixedSpace σ ⊤ := by
    apply iSup_le
    rintro g _ ⟨v,hv,rfl⟩
    have hv' : v ∈ fixedSpace σ ⊤ := hfix.symm ▸ hv
    rw [show σ g v = v from hv' ⟨g,mem_top _⟩]
    exact hv'
  have htop : fixedSpace σ ⊤ = ⊤ := top_unique (hg ▸ hspan)
  apply hne
  apply bot_unique
  intro t ht
  have htk : t ∈ σ.ker := by
    apply LinearMap.ext
    intro w
    exact (show w ∈ fixedSpace σ ⊤ from htop.symm ▸ Submodule.mem_top) ⟨t,mem_top _⟩
  exact hd.le_bot ⟨htk,ht⟩

omit [Finite W] in
private theorem dihedral_faithful (e : D ≃* DihedralGroup 5)
    (σ : Representation (ZMod 2) D W) (T : Sylow 2 D)
    (hg : GeneratedByFixedSpace σ T) (hd : Disjoint σ.ker (T : Subgroup D))
    (hne : (T : Subgroup D) ≠ ⊥) : Function.Injective σ := by
  have hc : Nat.card D = 10 := by rw [Nat.card_congr e.toEquiv,DihedralGroup.nat_card]
  obtain ⟨R,hR⟩ := T.exists_sylow_map_eq_inf_of_normal σ.ker
  have hRbot : (R : Subgroup σ.ker) = ⊥ := by
    apply map_injective σ.ker.subtype_injective
    simpa only [Subgroup.map_bot,hd.symm.eq_bot] using hR
  have ho : Nat.Coprime 2 (Nat.card σ.ker) := by
    apply Nat.prime_two.coprime_iff_not_dvd.mpr
    intro he
    exact R.ne_bot_of_dvd_card he hRbot
  have hfive : Nat.card σ.ker ∣ 5 :=
    ho.symm.dvd_of_dvd_mul_left (by simpa only [hc] using σ.ker.card_subgroup_dvd_card)
  rcases (Nat.dvd_prime (by decide : Nat.Prime 5)).mp hfive with h1 | h5
  · exact σ.ker_eq_bot_iff.mp (card_eq_one.mp h1)
  · have hi : σ.ker.index = 2 := by
      have hh := σ.ker.card_mul_index
      rw [hc,h5] at hh
      omega
    have hp : IsPGroup 2 (D ⧸ σ.ker) := IsPGroup.of_card_dvd_pow
      (n := 1) (by rw [←σ.ker.index_eq_card,hi]; decide)
    exact (residual_detected σ T hg hd hne
      ((pResidual_le_iff_isPGroup_quotient 2 σ.ker).mpr hp)).elim

/-- The terminal fixed-space index bound is incompatible with the actual D₁₀ model. -/
theorem dihedral_fixed_generated_index_obstruction (e : D ≃* DihedralGroup 5)
    (σ : Representation (ZMod 2) D W) (T : Sylow 2 D) (A : Subgroup D)
    (hAT : A ≤ T) (hA : 1 < Nat.card A)
    (hg : GeneratedByFixedSpace σ T) (hd : Disjoint σ.ker (T : Subgroup D))
    (hb : Nat.card (W ⧸ fixedSpace σ A) ≤ Nat.card A) : False := by
  have hc : Nat.card D = 10 := by rw [Nat.card_congr e.toEquiv,DihedralGroup.nat_card]
  have hTcard : Nat.card T = 2 := by
    rw [T.card_eq_multiplicity,hc]
    rw [show 10 = 2 * 5 from rfl, Nat.factorization_mul (by decide) (by decide),
      Nat.prime_two.factorization, Nat.prime_five.factorization]
    norm_num
  have hAcard : Nat.card A = 2 := by
    have hle : Nat.card A ≤ 2 := (card_le_of_le hAT).trans_eq hTcard
    omega
  have hTne : (T : Subgroup D) ≠ ⊥ := by
    intro ht
    have hh : A = ⊥ := bot_unique (hAT.trans ht.le)
    simp only [hh,Subgroup.card_bot,Nat.lt_irrefl] at hA
  have hf := dihedral_faithful e σ T hg hd hTne
  have hAne : A ≠ ⊥ := by
    intro hh
    simp only [hh,Subgroup.card_bot,Nat.lt_irrefl] at hA
  obtain ⟨⟨t,ht⟩,ht1'⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hAne
  have ht1 : t ≠ 1 := fun he => ht1' (Subtype.ext he)
  have ht2 : t^2 = 1 := by
    have hh := pow_card_eq_one' (x := (⟨t,ht⟩ : A))
    rw [hAcard] at hh
    exact congrArg Subtype.val hh
  have het1 : e t ≠ 1 := by intro hh; exact ht1 (e.injective (hh.trans e.map_one.symm))
  have het2 : (e t)^2 = 1 := by rw [←map_pow,ht2,map_one]
  have hcomm : orderOf (t * e.symm (.r 1) * t⁻¹ * (e.symm (.r 1))⁻¹) = 5 := by
    rw [←e.orderOf_eq]
    simp only [map_mul,map_inv,e.apply_symm_apply]
    generalize e t = z at het1 het2 ⊢
    cases z with
    | r i =>
      have hi : i = 0 := by
        rw [DihedralGroup.r_pow, ← DihedralGroup.r_zero, DihedralGroup.r.injEq] at het2
        let : Fact (Nat.Prime 5) := ⟨by decide⟩
        exact (mul_eq_zero.mp het2).resolve_right (by decide)
      exact (het1 (hi ▸ DihedralGroup.r_zero)).elim
    | sr i =>
      simp only [DihedralGroup.sr_mul_r, DihedralGroup.inv_sr,
        DihedralGroup.inv_r, DihedralGroup.sr_mul_sr, DihedralGroup.r_mul_r]
      rw [show i - (i + 1) + -1 = (-2 : ZMod 5) by ring]
      rw [show (-2 : ZMod 5) = 3 from by decide]
      rw [DihedralGroup.orderOf_r]
      decide
  have hl := two_le_displacement_of_commutator_order_five σ hf t (e.symm (.r 1)) hcomm
  have hb' : 2 ^ fixedCodim σ A ≤ 2 := by
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod,hAcard] at hb
    exact hb
  have hdim : fixedCodim σ A ≤ 1 := by
    by_contra! hn
    have hn' : 2 ≤ fixedCodim σ A := by omega
    have hlarge : 4 ≤ 2 ^ fixedCodim σ A :=
      Nat.pow_le_pow_right (n := 2) (by decide) hn'
    omega
  have hfix : fixedSpace σ A ≤ fixedSpace σ (zpowers t) := by
    intro w hw a
    exact hw ⟨a,(zpowers_le.mpr ht) a.property⟩
  have hdimfix := Submodule.finrank_mono hfix
  have hdA := fixedCodim_add_finrank σ A
  have hdt := fixedCodim_add_finrank σ (zpowers t)
  have hu : fixedCodim σ (zpowers t) ≤ fixedCodim σ A := by omega
  rw [fixedCodim_zpowers_eq_displacement_rank] at hu
  omega

end CFSG.Quasithin.ChapterF.Source.DGS85.Noncommuting

