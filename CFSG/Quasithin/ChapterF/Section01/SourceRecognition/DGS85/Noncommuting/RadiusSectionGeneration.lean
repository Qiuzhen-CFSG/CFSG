module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.Noncommuting.CenterCommutators
public import Theory.Representation.BinaryConjugationSection.SylowGeneration
public import Theory.Representation.RankOne.QuadraticRecognition.Generation

/-!
# Corrected fixed-space generation for the epsilon-two radius section

The radius-one span at beta is generated by the L_beta conjugates of Z_alpha.
The center vertex is included because the epsilon-two seed lies in Z_alpha.
The natural edge commutator [Z_alpha,S]=Z_beta shows that the same seed is
S-fixed modulo Z_beta. Hence every literal quotient action on V_beta/Z_beta
is generated by the conjugates of its actual Sylow fixed space.

This proves the generation premise of corrected (5.12) for the distinct
radius section used at the end of (7.5), not merely for Z_alpha's natural
section. The actual reduced F1.11 application retains the map L_beta/Q_beta,
the original section kernel and the edge-Sylow image. Faithfulness, residual
fixed-space vanishing and the final index comparison remain separate duties.

Source: DGS, *Groups and Graphs* (1985), (7.5), pp.130--131, with the
published fixed-generation correction to (5.12).
-/

public noncomputable section
open Subgroup Representation Representation.BinaryConjugationSection Representation.BinaryOffender
open Representation.RankOne.QuadraticRecognition
open Subgroup.CosetGeometry.RankTwo
namespace CFSG.Quasithin.ChapterF.Source.DGS85.Noncommuting
universe u
variable {G : Type u} [Group G]

/-- The actual radius-one span is generated by the adjacent center under the
local actor; the center vertex is absorbed by the exact epsilon-two seed. -/
theorem graph_radius_one_eq_center_span
    {P : Fin 2 → Subgroup G} {B : Subgroup G} (h : LocallyRankOneTriple P B)
    {v u : Vertex (family P)} (he : (graph (family P)).Adj v u)
    (c : LocalRankOneData (stabilizer (family P) u)
      (stabilizer (family P) u ⊓ stabilizer (family P) v))
    (hZZ : Z (family P) u ≤ Z (family P) v) :
    conjugateSpanBy (Z (family P) v) c.Pstar = V (family P) u 1 := by
  let := finite_endpoints h
  have hZV : Z (family P) v ≤ V (family P) u 1 :=
    le_iSup_of_le v (le_iSup_of_le ((mem_ball_one _ _ _).mpr (Or.inl he.symm)) le_rfl)
  apply le_antisymm (conjugateSpanBy_le hZV
    (c.Pstar_le.trans (graph_stabilizer_normalizes_V h u 1)))
  apply iSup_le
  intro x
  apply iSup_le
  intro hx
  rcases (mem_ball_one (family P) u x).mp hx with hx | rfl
  · obtain ⟨g,hg,hgx⟩ := locally_transitive (family P) he.symm hx
    obtain ⟨l,hl,t,ht,hgt⟩ := local_star_factor c g hg
    have htx : t • v = v := ht.2
    have hlx : l • v = x := by simpa only [hgt,mul_smul,htx] using hgx
    rw [←hlx,Z_translate]
    rintro _ ⟨z,hz,rfl⟩
    exact subset_closure ⟨l,hl,z,hz,rfl⟩
  · exact hZZ.trans (le_conjugateSpanBy _ _)

/-- A fixed seed generating a literal conjugation section proves the corrected
5.12 generation premise for that same section and actor map. -/
theorem section_generated_by_fixed_seed
    {D W : Type*} [Group D] [AddCommGroup W] [Module (ZMod 2) W]
    (L V Z A S : Subgroup G) (σ : Representation (ZMod 2) D W) (π : L →* D)
    (d : BinaryConjugationSection L V Z (σ.comp π))
    (hgen : conjugateSpanBy A L = V) (hcomm : ⁅S,A⁆ ≤ Z) :
    GeneratedByFixedSpace σ ((S.subgroupOf L).map π) := by
  let C := fixedConjugateSpan σ ((S.subgroupOf L).map π)
  let C' : Subrepresentation (σ.comp π) :=
    ⟨C.toSubmodule,fun g _ hv => C.apply_mem_toSubmodule (π g) hv⟩
  have hseed : d.imageSpace A ≤ C'.toSubmodule := by
    intro w hw
    apply fixedSpace_le_fixedConjugateSpan
    intro a
    obtain ⟨s,hs,he⟩ := a.property
    change σ (a : D) w = w
    rw [←he]
    exact d.fixed_on_imageSpace_of_commutator_le S A hcomm s hs w hw
  exact d.generated_image_le A hgen.symm C' hseed

/-- Fixed-space generation on V_beta/Z_beta, the different section used at
the end of (7.5). The fixed seed is Z_alpha modulo Z_beta. -/
theorem graph_epsilonTwo_radius_section_generated
    {P : Fin 2 → Subgroup G} {B : Subgroup G} (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    {v u : Vertex (family P)} (he : (graph (family P)).Adj v u)
    (c₀ : LocalRankOneData (stabilizer (family P) v)
      (stabilizer (family P) v ⊓ stabilizer (family P) u))
    (c₁ : LocalRankOneData (stabilizer (family P) u)
      (stabilizer (family P) u ⊓ stabilizer (family P) v))
    (ho₀ : ¬ 2 ∣ c₀.Pstar.relIndex (stabilizer (family P) v))
    (ho₁ : ¬ 2 ∣ c₁.Pstar.relIndex (stabilizer (family P) u))
    (hdich : Stellmacher.IsSylowSubgroupIn (Q (family P) u)
      (c₁.Pstar ⊓ centralizer (Z (family P) u : Set G)) ∨
      Z (family P) u = Stellmacher.omegaOneCenterAmbient c₁.Pstar)
    (hepsilon : Z (family P) u = Stellmacher.omegaOneCenterAmbient
      ((stabilizer (family P) v ⊓ stabilizer (family P) u).pCoreIn 2))
    (hnat : HasNaturalCenter c₀.Pstar (Z (family P) v) (Q (family P) v))
    [((Q (family P) u).subgroupOf c₁.Pstar).Normal]
    {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]
    (σ : Representation (ZMod 2) (c₁.Pstar ⧸ (Q (family P) u).subgroupOf c₁.Pstar) W)
    (d : BinaryConjugationSection c₁.Pstar (V (family P) u 1) (Z (family P) u)
      (σ.comp (QuotientGroup.mk' ((Q (family P) u).subgroupOf c₁.Pstar)))) :
    GeneratedByFixedSpace σ
      ((((stabilizer (family P) v ⊓ stabilizer (family P) u).pCoreIn 2).subgroupOf c₁.Pstar).map
        (QuotientGroup.mk' ((Q (family P) u).subgroupOf c₁.Pstar))) := by
  have hcenter := graph_epsilonTwo_center_trivial_of_localData h hB he c₀ c₁ ho₀ ho₁ hdich hepsilon
  have hcomm := graph_natural_edge_commutator h hB he c₀ ho₀ hcenter hnat
    ((stabilizer (family P) v ⊓ stabilizer (family P) u).pCoreIn 2) le_rfl
    (local_edgeCore_not_le_vertexCore c₀ ho₀ (source_edge_core_sylow h hB he))
  have hZZ : Z (family P) u ≤ Z (family P) v :=
    hepsilon.le.trans (graph_edgeSeed_le_Z h hB he c₀ ho₀)
  apply section_generated_by_fixed_seed c₁.Pstar (V (family P) u 1) (Z (family P) u)
    (Z (family P) v) _ σ _ d (graph_radius_one_eq_center_span h he c₁ hZZ)
  rw [commutator_comm,hcomm,←hepsilon]

namespace Reduction
open DGS85.Reduction
variable {L₀ : Fin 2 → Subgroup G} {S₀ : Subgroup G}
local notation "F" => reducedFamily L₀ S₀

/-- The corrected generation premise for the literal reduced-source radius section. -/
theorem reduced_epsilonTwo_radius_section_generated
    (h : HypothesisF11 L₀ S₀)
    {v u : Vertex F} (he : (graph F).Adj v u)
    (c₀ : LocalRankOneData (stabilizer F v)
      (stabilizer F v ⊓ stabilizer F u))
    (c₁ : LocalRankOneData (stabilizer F u)
      (stabilizer F u ⊓ stabilizer F v))
    (ho₀ : ¬ 2 ∣ c₀.Pstar.relIndex (stabilizer F v))
    (ho₁ : ¬ 2 ∣ c₁.Pstar.relIndex (stabilizer F u))
    (hdich : Stellmacher.IsSylowSubgroupIn (Q F u)
      (c₁.Pstar ⊓ centralizer (Z F u : Set (G₀ L₀ S₀))) ∨
      Z F u = Stellmacher.omegaOneCenterAmbient c₁.Pstar)
    (hepsilon : Z F u = Stellmacher.omegaOneCenterAmbient
      ((stabilizer F v ⊓ stabilizer F u).pCoreIn 2))
    (hnat : HasNaturalCenter c₀.Pstar (Z F v) (Q F v))
    [((Q F u).subgroupOf c₁.Pstar).Normal]
    {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]
    (σ : Representation (ZMod 2) (c₁.Pstar ⧸ (Q F u).subgroupOf c₁.Pstar) W)
    (d : BinaryConjugationSection c₁.Pstar (V F u 1) (Z F u)
      (σ.comp (QuotientGroup.mk' ((Q F u).subgroupOf c₁.Pstar)))) :
    GeneratedByFixedSpace σ
      ((((stabilizer F v ⊓ stabilizer F u).pCoreIn 2).subgroupOf c₁.Pstar).map
        (QuotientGroup.mk' ((Q F u).subgroupOf c₁.Pstar))) := by
  let : ((Q (family (fun i => (P₀ L₀ S₀ i).subgroupOf (G₀ L₀ S₀))) u).subgroupOf c₁.Pstar).Normal :=
    inferInstanceAs (((Q F u).subgroupOf c₁.Pstar).Normal)
  exact graph_epsilonTwo_radius_section_generated (reduced_triple h) (reduced_borel_core_sylow h)
    he c₀ c₁ ho₀ ho₁ hdich hepsilon hnat σ d

end Reduction

end CFSG.Quasithin.ChapterF.Source.DGS85.Noncommuting
