public import Theory.GroupTheory.SpecificGroups.QuaternionCyclicCentralSign
/-!
# The strict binary residual action and beta-core center

The actual radius group V_beta is Q₈ ◦ C₄. A noncentral involution's
centralizer in this group is generated by that involution and its cyclic
center. Thus a residual element centralizing this cyclic center also
centralizes the adjacent-core intersection: it already centralizes the
alpha center and D_alpha. The established faithful commutator pairing
forces that element to be trivial.

Since Q_beta = V_beta R_alpha, the action kernel on Z(V_beta) is exactly
V_beta. Every nonidentity residual element therefore acts by inversion,
and C_Qbeta(V_beta) = Z(V_beta). In the strict binary case this forces
Z(Q_beta) = Z_beta; the existing Frattini and order formulas then make
Q_beta extraspecial of order 32, with central quotient of order 16.

Both exports construct their inputs from original F1.11 and the literal
strict condition D_alpha ≠ Z_alpha. The first retains one original
opposite-center lift, the residual, and all original subgroup inclusions.
These are the central-product and centralizer steps of the binary
separation argument; the terminal intersection in (10.8) is not yet proved.

Source: Delgado--Goldschmidt--Stellmacher, Groups and Graphs (1985),
(10.7)--(10.8), printed pp.158--162, and (10.10), printed p.164.
The existing QuaternionCyclic model supplies the multiplication law;
its small involution-centralizer calculations below are kernel checked.
-/

public noncomputable section
open Subgroup
open scoped Pointwise commutatorElement MatrixGroups IsMulCommutative
namespace CFSG.Quasithin.ChapterF.Source.DGS85.NoncommutingProfile

private theorem model_involution_centralizer (a x : QuaternionCyclic.Model)
    (ha : a^2=1) (haZ : a ∉ center QuaternionCyclic.Model) (hx : Commute x a) :
    ∃ z ∈ center QuaternionCyclic.Model, x=z ∨ x=a*z := by
  have hh : ∀ a x : QuaternionCyclic.Model, a^2=1 →
      (∃ y, y*a≠a*y) → x*a=a*x →
      ∃ z : QuaternionCyclic.Model, (∀ y, y*z=z*y) ∧ (x=z ∨ x=a*z) := by
    decide +kernel
  have hn : ∃ y, y*a≠a*y := by
    by_contra! hn
    exact haZ (mem_center_iff.mpr hn)
  obtain ⟨z,hz,hx⟩ := hh a x ha hn hx.eq
  exact ⟨z,mem_center_iff.mpr hz,hx⟩

private theorem quaternion_elementary_centralizer
    {G : Type*} [Group G] (V A : Subgroup G)
    (e : V ≃* QuaternionCyclic.Model) (hAV : A ≤ V)
    (hA2 : ∀ a ∈ A, a^2=1) (hne : ¬ A ≤ centerIn V) :
    V ⊓ centralizer (A : Set G) ≤ A ⊔ centerIn V := by
  obtain ⟨a,ha,haZ⟩ := SetLike.not_le_iff_exists.mp hne
  let aV : V := ⟨a,hAV ha⟩
  have haZ' : e aV ∉ center QuaternionCyclic.Model := by
    intro hh
    apply haZ
    refine ⟨hAV ha,?_⟩
    intro v hv
    have he : (⟨v,hv⟩:V)*aV=aV*⟨v,hv⟩ := by
      apply e.injective
      simpa only [map_mul] using mem_center_iff.mp hh (e ⟨v,hv⟩)
    exact congrArg Subtype.val he
  have ha2 : (e aV)^2=1 := by
    rw [←map_pow,←map_one e]
    exact congrArg e (Subtype.ext (hA2 a ha))
  intro x hx
  let xV : V := ⟨x,hx.1⟩
  have hxa : Commute (e xV) (e aV) := by
    apply Commute.map
    exact (show Commute aV xV from Subtype.ext (hx.2 a ha)).symm
  obtain ⟨z,hz,hxz⟩ := model_involution_centralizer (e aV) (e xV) ha2 haZ' hxa
  have hz' : (e.symm z : G) ∈ centerIn V := by
    refine ⟨(e.symm z).property,?_⟩
    intro v hv
    have hh : (⟨v,hv⟩:V)*e.symm z=e.symm z*⟨v,hv⟩ := by
      apply e.injective
      simpa only [map_mul,e.apply_symm_apply] using mem_center_iff.mp hz (e ⟨v,hv⟩)
    exact congrArg Subtype.val hh
  rcases hxz with hxz | hxz
  · have hh : x=(e.symm z:G) := congrArg Subtype.val (e.injective (hxz.trans (e.apply_symm_apply z).symm))
    exact hh ▸ mem_sup_right hz'
  · have hh : x=a*(e.symm z:G) := by
      have he : xV=aV*e.symm z := by
        apply e.injective
        simpa only [map_mul,e.apply_symm_apply] using hxz
      exact congrArg Subtype.val he
    exact hh ▸ (A⊔centerIn V).mul_mem (mem_sup_left ha) (mem_sup_right hz')

private theorem residual_center_action_faithful
    {G : Type*} [Group G] (Q V A D R I : Subgroup G)
    (e : V ≃* QuaternionCyclic.Model) (hAV : A ≤ V) (hAD : A ≤ D)
    (hA2 : ∀ a ∈ A, a^2=1) (hne : ¬ A ≤ centerIn V)
    (hI : I=(V⊓Q)⊔D) (hQA : Q ≤ centralizer (A : Set G))
    (hRD : R ≤ centralizer (D : Set G))
    (hfaith : R ⊓ centralizer (I : Set G)=⊥) :
    R ⊓ centralizer (centerIn V : Set G)=⊥ := by
  apply bot_unique
  intro r hr
  rw [←hfaith]
  refine ⟨hr.1,?_⟩
  have hRC : A⊔centerIn V ≤ centralizer ({r}:Set G) := by
    apply sup_le
    · intro a ha
      exact mem_centralizer_singleton_iff.mpr (hRD hr.1 a (hAD ha))
    · intro z hz
      exact mem_centralizer_singleton_iff.mpr (hr.2 z hz)
  have hVC : V⊓Q ≤ centralizer ({r}:Set G) :=
    (inf_le_inf_left _ hQA).trans
      ((quaternion_elementary_centralizer V A e hAV hA2 hne).trans hRC)
  have hDC : D ≤ centralizer ({r}:Set G) := by
    intro d hd
    exact mem_centralizer_singleton_iff.mpr (hRD hr.1 d hd)
  intro i hi
  exact mem_centralizer_singleton_iff.mp ((hI ▸ sup_le hVC hDC) hi)

private theorem center_action_kernel
    {G : Type*} [Group G] (Q V R : Subgroup G)
    (hgen : Q=V⊔R) (hn : R≤normalizer (V:Set G))
    (hf : R⊓centralizer (centerIn V:Set G)=⊥) :
    Q⊓centralizer (centerIn V:Set G)=V ∧ Q⊓centralizer (V:Set G)=centerIn V := by
  have hk : Q⊓centralizer (centerIn V:Set G)=V := by
    apply le_antisymm
    · intro x hx
      have hp : x∈(R:Set G)*(V:Set G) := by
        rw [←coe_mul_of_left_le_normalizer_right R V hn,←sup_comm,←hgen]
        exact hx.1
      obtain ⟨r,hr,v,hv,rfl⟩ := hp
      have hrc : r∈centralizer (centerIn V:Set G) := by
        intro z hz
        have hvz : Commute v z := hz.2 v hv
        have hxz : Commute (r*v) z := (hx.2 z hz).symm
        simpa only [mul_inv_cancel_right] using (hxz.mul_left hvz.inv_left).eq.symm
      have hr1 : r=1 := mem_bot.mp (hf ▸ (show r∈R⊓centralizer (centerIn V:Set G) from ⟨hr,hrc⟩))
      change r*v∈V
      rw [hr1,one_mul]
      exact hv
    · intro v hv
      refine ⟨hgen ▸ mem_sup_left hv,?_⟩
      intro z hz
      exact (hz.2 v hv).symm
  refine ⟨hk,le_antisymm ?_ ?_⟩
  · intro x hx
    refine ⟨hk ▸ ⟨hx.1,?_⟩,hx.2⟩
    intro z hz
    exact hx.2 z hz.1
  · intro x hx
    exact ⟨hgen ▸ mem_sup_left hx.1,hx.2⟩

private theorem quaternion_center_powers (x : QuaternionCyclic.Model)
    (hx : x∈center QuaternionCyclic.Model) :
    ∃ n : Fin 4, x=QuaternionCyclic.r^n.val := by
  have hh : ∀ x : QuaternionCyclic.Model, (∀ y,y*x=x*y) →
      ∃ n : Fin 4, x=QuaternionCyclic.r^n.val := by decide +kernel
  exact hh x (mem_center_iff.mp hx)

private theorem faithful_residual_inverts_center
    {G : Type*} [Group G] (V R : Subgroup G) (e : V≃*QuaternionCyclic.Model)
    (hn : R≤normalizer (V:Set G)) (hf : R⊓centralizer (centerIn V:Set G)=⊥) :
    ∀ r∈R, r≠1 → ∀ z∈centerIn V, r*z*r⁻¹=z⁻¹ := by
  intro r hr hr1
  let a : MulAut V := V.normalizerMonoidHom ⟨r,hn hr⟩
  let b : MulAut QuaternionCyclic.Model := e.symm.trans (a.trans e)
  have hcenter (z : G) (hz : z∈centerIn V) : e ⟨z,hz.1⟩∈center QuaternionCyclic.Model := by
    apply mem_center_iff.mpr
    intro y
    obtain ⟨v,rfl⟩ := e.surjective y
    have hh : v*(⟨z,hz.1⟩:V)=⟨z,hz.1⟩*v := Subtype.ext (hz.2 v v.property)
    simpa only [map_mul] using congrArg e hh
  have hb : b QuaternionCyclic.r=QuaternionCyclic.r⁻¹ := by
    rcases QuaternionCyclic.aut_r_eq_or_inv b with hh|hh
    · exfalso
      apply hr1
      apply mem_bot.mp
      rw [←hf]
      refine ⟨hr,?_⟩
      intro z hz
      obtain ⟨n,hn⟩ := quaternion_center_powers _ (hcenter z hz)
      have he : b (e ⟨z,hz.1⟩)=e ⟨z,hz.1⟩ := by rw [hn,map_pow,hh]
      have he' : a ⟨z,hz.1⟩=⟨z,hz.1⟩ := e.injective (by
        simpa only [b,MulEquiv.trans_apply,e.symm_apply_apply] using he)
      have he'' : r*z*r⁻¹=z := congrArg Subtype.val he'
      have hh := congrArg (fun x:G => x*r) he''
      simpa only [mul_assoc,inv_mul_cancel,mul_one] using hh.symm
    · exact hh
  intro z hz
  obtain ⟨n,hnz⟩ := quaternion_center_powers _ (hcenter z hz)
  have he : b (e ⟨z,hz.1⟩)=(e ⟨z,hz.1⟩)⁻¹ := by
    rw [hnz,map_pow,hb,inv_pow]
  have he' : a ⟨z,hz.1⟩=(⟨z,hz.1⟩:V)⁻¹ := e.injective (by
    simpa only [b,MulEquiv.trans_apply,e.symm_apply_apply,map_inv] using he)
  exact congrArg Subtype.val he'

private theorem center_eq_of_binary_inversion
    {G : Type*} [Group G] (Q V R Z : Subgroup G) (e : V≃*QuaternionCyclic.Model)
    (hVQ : V≤Q) (hRQ : R≤Q) (hRne : R≠⊥)
    (hZ : Z≤centerIn Q) (hZcard : Nat.card Z=2)
    (hcent : Q⊓centralizer (V:Set G)=centerIn V)
    (hinv : ∀ r∈R,r≠1 → ∀ z∈centerIn V,r*z*r⁻¹=z⁻¹) :
    centerIn Q=Z := by
  obtain ⟨r,hr,hr1⟩ := R.bot_or_exists_ne_one.resolve_left hRne
  have hZne : Z≠⊥ := by intro hh; rw [hh,card_bot] at hZcard; contradiction
  obtain ⟨z,hz,hz1⟩ := Z.bot_or_exists_ne_one.resolve_left hZne
  have hQV : centerIn Q≤centerIn V := by
    intro x hx
    exact hcent ▸ ⟨hx.1,fun v hv => hx.2 v (hVQ hv)⟩
  have hzV := hQV (hZ hz)
  have central (x : G) (hx : x∈centerIn V) : e ⟨x,hx.1⟩∈center QuaternionCyclic.Model := by
    apply mem_center_iff.mpr
    intro y
    obtain ⟨v,rfl⟩ := e.surjective y
    have he : v*(⟨x,hx.1⟩:V)=⟨x,hx.1⟩*v := Subtype.ext (hx.2 v v.property)
    simpa only [map_mul] using congrArg e he
  have hz2 : z^2=1 := by
    have hh := pow_card_eq_one' (x:=(⟨z,hz⟩:Z))
    rw [hZcard] at hh
    exact congrArg Subtype.val hh
  have hez2 : (e ⟨z,hzV.1⟩)^2=1 := by
    rw [←map_pow,←map_one e]
    exact congrArg e (Subtype.ext hz2)
  have hez1 : e ⟨z,hzV.1⟩≠1 := by
    intro hh
    apply hz1
    exact congrArg Subtype.val (e.injective (hh.trans (map_one e).symm))
  have model : ∀ x z : QuaternionCyclic.Model,
      (∀ y,y*x=x*y) → x^2=1 → (∀ y,y*z=z*y) → z^2=1 → z≠1 → x=1 ∨ x=z := by
    decide +kernel
  apply le_antisymm ?_ hZ
  intro x hx
  have hxV := hQV hx
  have hxx : x=x⁻¹ := by
    have hh := hinv r hr hr1 x hxV
    rw [hx.2 r (hRQ hr),mul_inv_cancel_right] at hh
    exact hh
  have hx2 : x^2=1 := by
    calc
      x^2=x*x := pow_two x
      _=x*x⁻¹ := congrArg (x*·) hxx
      _=1 := mul_inv_cancel x
  have hex2 : (e ⟨x,hxV.1⟩)^2=1 := by
    rw [←map_pow,←map_one e]
    exact congrArg e (Subtype.ext hx2)
  rcases model (e ⟨x,hxV.1⟩) (e ⟨z,hzV.1⟩)
      (mem_center_iff.mp (central x hxV)) hex2
      (mem_center_iff.mp (central z hzV)) hez2 hez1 with hh|hh
  · have hx1 : x=1 := congrArg Subtype.val (e.injective (hh.trans (map_one e).symm))
    exact hx1 ▸ one_mem Z
  · have hxz : x=z := congrArg Subtype.val (e.injective hh)
    exact hxz ▸ hz

open Subgroup.CosetGeometry.RankTwo Theory.GroupTheory.AmalgamGraph Noncommuting
namespace Reduction
open DGS85.Reduction
universe u
variable {G : Type u} [Group G] {L : Fin 2 → Subgroup G} {S : Subgroup G}
variable {K : Type*} [Field K] [Finite K] [CharP K 2]
local notation "F" => reducedFamily L S
local notation "α" => base F false
local notation "β" => base F true
local notation "ι" => Subgroup.subtype (G₀ L S)

/-- The strict binary residual acts faithfully by inversion on the cyclic
center of the actual radius group. Its kernel on the whole beta core is
exactly that radius group, whose full core-centralizer is its own center. -/
theorem original_bTwo_binary_residual_center_action
    (h : HypothesisF11 L S) {u t : Vertex F}
    (hc : IsCriticalPair F α u) (hne : ⁅Z F α,Z F u⁆≠⊥)
    (hb : b F=2) (hβu : (graph F).Adj β u)
    (ht : (graph F).Adj α t) (htne : t≠β)
    (e : (L 1 ⧸ pCore 2 (L 1))≃*PSL(2,K)) (hK : Nat.card K=2)
    (hD : (parabolic L S 1).pCoreIn 2⊓(Q F t).map ι≠(Z F α).map ι) :
    ∃ g∈graphLocalGroup F α, g • β=t ∧
      let Q₁ := (parabolic L S 1).pCoreIn 2
      let V₁ := (V F β 1).map ι
      let D₀ := Q₁⊓(Q F t).map ι
      let W₀ := (Z F u).map ι⊔(Z F (g • u)).map ι
      let R₀ := D₀⊓centralizer (W₀:Set G)
      Nat.card R₀=2 ∧ Nonempty (V₁≃*QuaternionCyclic.Model) ∧
      R₀⊓centralizer (centerIn V₁:Set G)=⊥ ∧
      Q₁⊓centralizer (centerIn V₁:Set G)=V₁ ∧
      Q₁⊓centralizer (V₁:Set G)=centerIn V₁ ∧
      ∀ r∈R₀, r≠1 → ∀ z∈centerIn V₁, r*z*r⁻¹=z⁻¹ := by
  obtain ⟨k,f,fin,ch,alg,c,hactor,hkmin,n,hn,hm,hpow,g,hg,
    hgen,hfour,hwhole,hRne,hDel,hRel,hdec,hdis,hprod,hZ,hDcard,hQcard,hnP,hnB⟩ :=
    original_bTwo_strict_residual h hc hne hb hβu ht htne hD
  change BTwoCenterActionData F α β u k (Fin 2 → k) at c
  change c.actor=graphLocalGroup F α at hactor
  have halg : alg=ZMod.algebra k 2 := Subsingleton.elim _ _
  subst alg
  let : Algebra (ZMod 2) k := ZMod.algebra k 2
  let H := reduced_triple h
  let Q₀ := (parabolic L S 0).pCoreIn 2
  let Q₁ := (parabolic L S 1).pCoreIn 2
  let V₁ := (V F β 1).map ι
  let D₀ := Q₁⊓(Q F t).map ι
  let A := (Z F α).map ι
  let I := Q₀⊓Q₁
  let W₀ := (Z F u).map ι⊔(Z F ((g:G₀ L S) • u)).map ι
  let R := D₀⊓centralizer (W₀:Set G)
  let eβ := (reduced_graphLinearQuotient h true e).trans
    (MulEquiv.ofBijective (BenderSuzuki.Converse.pi K)
      ⟨BenderSuzuki.Converse.pi_injective,BenderSuzuki.Converse.pi_surjective⟩).symm
  have hfaith := Assembly.BTwoSource.original_bTwo_residual_endpoint_centralizer
    h hc hne hb hβu ht htne c hactor eβ g hg hgen hDel
  change R⊓centralizer (I:Set G)=⊥ at hfaith
  have hRle : Nat.card R≤2 := original_bTwo_binary_residual_card_le_two
    h hc hne hb hβu ht htne c hactor e hK g hg hgen hDel
  let := h.finite_parabolic 1
  let : Finite Q₁ := Finite.of_injective (inclusion (pCoreIn_le 2 _)) (inclusion_injective _)
  let : Finite R := Finite.of_injective
    (inclusion (show R≤Q₁ from inf_le_left.trans inf_le_left)) (inclusion_injective _)
  have hRcard : Nat.card R=2 := by
    have hh := R.one_lt_card_iff_ne_bot.mpr hRne
    omega
  obtain ⟨hVc,⟨eV⟩,hquat,hVQ,hQprod,hΦ,hder⟩ :=
    original_bTwo_binary_radius_quaternion h hc hne hb hβu ht htne e hK
  change V₁≃*QuaternionCyclic.Model at eV
  have hQam : (Q F α).map ι=Q₀ := reduced_base_Q_map h false
  have hQbm : (Q F β).map ι=Q₁ := reduced_base_Q_map h true
  have hDm : (D F β t).map ι=D₀ := by
    change (Q F β⊓Q F t).map ι=_
    rw [map_inf _ _ _ (G₀ L S).subtype_injective,hQbm]
  have hI : I=(V₁⊓Q₀)⊔D₀ := by
    have hh := congrArg (map ι)
      (c.seed_adjacent_intersection H (reduced_kernel_sylow h) hb ht htne)
    change (Q F α⊓Q F β).map ι=((V F β 1⊓Q F α)⊔D F β t).map ι at hh
    rw [map_inf _ _ _ (G₀ L S).subtype_injective,Subgroup.map_sup,
      map_inf _ _ _ (G₀ L S).subtype_injective,hQam,hQbm,hDm] at hh
    exact hh
  have hAV : A≤V₁ := map_mono (le_iSup_of_le α
    (le_iSup_of_le ((mem_ball_one F β α).mpr (Or.inl c.middle.symm)) le_rfl))
  have huV : Z F u≤V F β 1 := le_iSup_of_le u
    (le_iSup_of_le ((mem_ball_one F β u).mpr (Or.inl hβu)) le_rfl)
  have hAn : ¬A≤centerIn V₁ := by
    intro hh
    apply hne
    apply (map_injective (G₀ L S).subtype_injective)
    rw [Subgroup.map_bot,map_commutator]
    apply commutator_eq_bot_iff_le_centralizer.mpr
    intro a ha u hu
    exact (hh ha).2 u ((map_mono (f:=ι) huV) hu)
  have hQA : Q₀≤centralizer (A:Set G) := by
    have hh := (map_mono (f:=ι) (graph_Q_centralizes_Z H α)).trans
      (map_centralizer_le_centralizer_image _ _)
    change (Q F α).map ι≤centralizer (A:Set G) at hh
    rwa [hQam] at hh
  change D₀=A⊔R at hdec
  have hAD : A≤D₀ := hdec ▸ le_sup_left
  let := hDel
  have hA2 : ∀ a∈A,a^2=1 := fun a ha => elemPow_eq_one_of_isElementaryAbelian a (hAD ha)
  have hRD : R≤centralizer (D₀:Set G) := inf_le_left.trans (le_centralizer D₀)
  have hfaithZ : R⊓centralizer (centerIn V₁:Set G)=⊥ :=
    residual_center_action_faithful Q₀ V₁ A D₀ R I eV hAV hAD hA2 hAn hI hQA hRD hfaith
  have hQgen : Q₁=V₁⊔R := by
    change Q₁=V₁⊔D₀ at hQprod
    rw [hQprod,hdec,←sup_assoc,sup_eq_left.mpr hAV]
  have hnV : Q₁≤normalizer (V₁:Set G) := by
    intro q hq
    have hqm : q∈(Q F β).map ι := hQbm.symm ▸ hq
    obtain ⟨a,ha,rfl⟩ := hqm
    have hn := graph_stabilizer_normalizes_V H β 1 (Q_le_stabilizer F β ha)
    apply mem_normalizer_iff_map_conj_eq.mpr
    have he : (V F β 1).map (MulAut.conj a).toMonoidHom=V F β 1 :=
      mem_normalizer_iff_map_conj_eq.mp hn
    change (V₁.map (MulAut.conj (ι a)).toMonoidHom)=V₁
    rw [show V₁=(V F β 1).map ι from rfl,map_map]
    have hh : (MulAut.conj (ι a)).toMonoidHom.comp ι= (ι).comp (MulAut.conj a).toMonoidHom := by
      ext x
      change (ι a)*(ι x)*(ι a)⁻¹=ι (a*x*a⁻¹)
      simp only [map_mul,map_inv]
    rw [hh,←map_map,he]
  have hRn : R≤normalizer (V₁:Set G) := (inf_le_left.trans inf_le_left).trans hnV
  obtain ⟨hker,hcent⟩ := center_action_kernel Q₁ V₁ R hQgen hRn hfaithZ
  exact ⟨g,hactor ▸ g.property,hg,hRcard,⟨eV⟩,hfaithZ,hker,hcent,
    faithful_residual_inverts_center V₁ R eV hRn hfaithZ⟩

/-- The original strict binary beta core is extraspecial of order thirty-two.
Its literal center, Frattini subgroup and derived subgroup all equal Z_beta;
the central quotient has order sixteen. -/
theorem original_bTwo_binary_strict_beta_core
    (h : HypothesisF11 L S) {u t : Vertex F}
    (hc : IsCriticalPair F α u) (hne : ⁅Z F α,Z F u⁆≠⊥)
    (hb : b F=2) (hβu : (graph F).Adj β u)
    (ht : (graph F).Adj α t) (htne : t≠β)
    (e : (L 1 ⧸ pCore 2 (L 1))≃*PSL(2,K)) (hK : Nat.card K=2)
    (hD : (parabolic L S 1).pCoreIn 2⊓(Q F t).map ι≠(Z F α).map ι) :
    let Q₁ := (parabolic L S 1).pCoreIn 2
    let Z₁ := (Z F β).map ι
    Nat.card Q₁=32 ∧ centerIn Q₁=Z₁ ∧
      (frattini Q₁).map Q₁.subtype=Z₁ ∧ ⁅Q₁,Q₁⁆=Z₁ ∧
      IsExtraspecial 2 Q₁ ∧ Nat.card (Q₁ ⧸ center Q₁)=16 := by
  obtain ⟨g,hg,hgt,hRcard,⟨eV⟩,hfaith,hker,hcent,hinv⟩ :=
    original_bTwo_binary_residual_center_action h hc hne hb hβu ht htne e hK hD
  let Q₁ := (parabolic L S 1).pCoreIn 2
  let Z₁ := (Z F β).map ι
  let V₁ := (V F β 1).map ι
  let R := (Q₁⊓(Q F t).map ι)⊓centralizer
    (((Z F u).map ι⊔(Z F (g • u)).map ι : Subgroup G):Set G)
  obtain ⟨g',hg',hgt',hfour,hwhole,hRc,hDel,hdec,hdis,hprod,hZa,hZb,hDc,hQa,hQb,
    hB,hBc,hPhi,hder⟩ := original_bTwo_binary_strict_orders h hc hne hb hβu ht htne e hK hD
  have hVQ : V₁≤Q₁ := by
    have hh := map_mono (f:=ι) (graph_V_le_Q_of_short (reduced_triple h)
      (reduced_kernel_sylow h) β (i:=1) (by change 1<b F; rw [hb]; decide))
    change V₁≤(Q F β).map ι at hh
    rwa [reduced_base_Q_map h true] at hh
  have hZQ : Z₁≤centerIn Q₁ := by
    have hh := source_Z_Q_U (reduced_triple h) β
    have hcQ := graph_Q_centralizes_Z (reduced_triple h) β
    have hZle : Z F β≤Q F β := fun z hz =>
      ((mem_omegaCenterIn_iff _ _).mp (hh.1 hz)).1
    have hZmap : Z₁≤Q₁ := by
      have hm := map_mono (f:=ι) hZle
      rwa [reduced_base_Q_map h true] at hm
    refine le_inf hZmap ?_
    intro z hz q hq
    obtain ⟨a,ha,rfl⟩ := hz
    have hqm : q∈(Q F β).map ι := (reduced_base_Q_map h true).symm ▸ hq
    obtain ⟨b,hb,rfl⟩ := hqm
    exact (congrArg ι (hcQ hb a ha)).symm
  have hRne : R≠⊥ := by
    intro hh
    change Nat.card R=2 at hRcard
    rw [hh,card_bot] at hRcard
    contradiction
  have hcenter : centerIn Q₁=Z₁ := center_eq_of_binary_inversion Q₁ V₁ R Z₁ eV
    hVQ (inf_le_left.trans inf_le_left) hRne hZQ hZb hcent hinv
  let := h.finite_parabolic 1
  let : Finite Q₁ := Finite.of_injective (inclusion (pCoreIn_le 2 _)) (inclusion_injective _)
  have hcenterCard : Nat.card (center Q₁)=2 := by
    rw [←card_map_of_injective (f:=Q₁.subtype) Q₁.subtype_injective,
      ←centerIn_eq_map_center,hcenter]
    exact hZb
  have hPhiCenter : frattini Q₁=center Q₁ := by
    apply map_injective Q₁.subtype_injective
    rw [←centerIn_eq_map_center,hcenter]
    exact hPhi
  let : Fact (IsPGroup 2 Q₁) := ⟨isPGroup_pCoreIn 2 _⟩
  have hEl : IsElementaryAbelian 2 (Q₁ ⧸ center Q₁) := by
    let : IsElementaryAbelian 2 (Q₁ ⧸ frattini Q₁) := isElementaryAbelian_quotient_frattini
    exact IsElementaryAbelian.of_surjective
      (QuotientGroup.quotientMulEquivOfEq hPhiCenter).toMonoidHom
      (QuotientGroup.quotientMulEquivOfEq hPhiCenter).surjective
  have hquot : Nat.card (Q₁ ⧸ center Q₁)=16 := by
    have hh := card_eq_card_quotient_mul_card_subgroup (center Q₁)
    rw [hQb,hcenterCard] at hh
    omega
  have hnon : Nontrivial (Q₁ ⧸ center Q₁) := QuotientGroup.nontrivial_iff.mpr (by
    intro hh
    have hc' : Nat.card (center Q₁)=Nat.card Q₁ := hh ▸ Nat.card_congr Subgroup.topEquiv.toEquiv
    rw [hcenterCard,hQb] at hc'
    contradiction)
  exact ⟨hQb,hcenter,hPhi,hder,⟨hcenterCard,hEl,hnon⟩,hquot⟩

end Reduction
