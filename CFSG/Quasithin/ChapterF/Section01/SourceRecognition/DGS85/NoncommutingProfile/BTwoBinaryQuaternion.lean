/-!
# The binary radius group and its quaternion commutator

In the cubic beta neighborhood the three neighboring centers are elementary
four-groups with a common central involution. Local transitivity supplies a
three-cycle, so noncommutation of the critical centers forces noncommutation
of every pair. Their generators therefore satisfy the three-involution
presentation of Q₈ ◦ C₄. Comparing two finite realizations through the
subgroup generated by paired generators gives an actual model equivalence.

The model's quaternion factor is characteristic and has index two, so it
contains the commutator with the beta local actor. Transitivity on the
neighboring centers generates the whole radius group from one center and
that commutator. The common involution lies in both, and the product-order
formula forces the commutator to be the entire quaternion factor.

Source: Delgado--Goldschmidt--Stellmacher, Groups and Graphs (1985),
(10.8), pp.161--162, and the binary case of (10.10)(d), p.164.
BTwoBinaryQuaternionSource constructs the inputs from original F1.11 and
transports the result through the literal reduced-completion inclusion.
-/

public noncomputable section
open Subgroup
open scoped Pointwise commutatorElement MatrixGroups IsMulCommutative
namespace CFSG.Quasithin.ChapterF.Source.DGS85.NoncommutingProfile
open Subgroup.CosetGeometry.RankTwo Theory.GroupTheory.AmalgamGraph Noncommuting

private theorem transitive_three_cycle {H X : Type*} [Group H] [Finite X]
    (f : H →* Equiv.Perm X) (hX : Nat.card X = 3)
    (ht : ∀ x y : X, ∃ g : H, f g x = y) :
    ∃ g : H, (f g)^3 = 1 ∧ ∀ x, f g x ≠ x := by
  classical
  let : Fintype X := Fintype.ofFinite X
  let e : X ≃ Fin 3 := Fintype.equivFinOfCardEq (by simpa using hX)
  let p := e.permCongrHom.toMonoidHom.comp f
  obtain ⟨a,ha⟩ := ht (e.symm 0) (e.symm 1)
  obtain ⟨b,hb⟩ := ht (e.symm 0) (e.symm 2)
  have ha' : p a 0 = 1 := by simpa [p,Equiv.permCongr] using congrArg e ha
  have hb' : p b 0 = 2 := by simpa [p,Equiv.permCongr] using congrArg e hb
  have small : ∀ a b : Equiv.Perm (Fin 3), a 0=1 → b 0=2 →
      ((a^3=1 ∧ ∀ i,a i≠i) ∨ (b^3=1 ∧ ∀ i,b i≠i) ∨
        ((a*b)^3=1 ∧ ∀ i,(a*b) i≠i)) := by decide +kernel
  have ⟨g,hg,hfree⟩ : ∃ g : H, (p g)^3=1 ∧ ∀ i,p g i≠i := by
    rcases small (p a) (p b) ha' hb' with ha | hb | hab
    · exact ⟨a,ha⟩
    · exact ⟨b,hb⟩
    · exact ⟨a*b,by simpa only [map_mul] using hab⟩
  refine ⟨g,?_,?_⟩
  · apply e.permCongr.injective
    change e.permCongrHom ((f g)^3)=e.permCongrHom 1
    rw [map_pow,map_one]
    exact hg
  · intro x hx
    apply hfree (e x)
    change e (f g (e.symm (e x)))=e x
    rw [e.symm_apply_apply,hx]

private theorem three_cycle_orbit {X : Type*} [Finite X] (hX : Nat.card X = 3)
    (p : Equiv.Perm X) (hp : p^3=1) (hf : ∀ x,p x≠x) (x : X) :
    (∀ y, y=x ∨ y=p x ∨ y=p (p x)) ∧ p (p (p x))=x ∧ p (p x)≠x := by
  classical
  have hp3 : p (p (p x))=x := by
    simpa only [pow_succ,pow_zero,one_mul,Equiv.Perm.mul_apply,Equiv.Perm.one_apply] using
      congrArg (fun e : Equiv.Perm X => e x) hp
  have h2 : p (p x)≠x := by
    intro hh
    exact hf x ((congrArg p hh).symm.trans hp3)
  have h21 : p (p x)≠p x := hf (p x)
  let : Fintype X := Fintype.ofFinite X
  have hall : ({x,p x,p (p x)} : Finset X)=Finset.univ := by
    apply Finset.eq_univ_of_card
    rw [←Nat.card_eq_fintype_card,hX]
    simp [Ne.symm (hf x),Ne.symm h2,Ne.symm h21]
  refine ⟨?_,hp3,h2⟩
  intro y
  have hh : y∈({x,p x,p (p x)} : Finset X) := hall ▸ Finset.mem_univ y
  simpa only [Finset.mem_insert,Finset.mem_singleton] using hh



private theorem four_generated {G : Type*} [Group G] (A C : Subgroup G)
    [Finite A] [Finite C] (hA : Nat.card A=4) (hC : Nat.card C=2)
    (hCA : C≤A) (x z : G) (hx : x∈A) (hxC : x∉C)
    (hz : z∈C) (hz1 : z≠1) : A=closure ({x,z}:Set G) := by
  have hz2 : z^2=1 := by
    have hh := pow_card_eq_one' (x := (⟨z,hz⟩:C))
    rw [hC] at hh
    exact congrArg Subtype.val hh
  have hzC : zpowers z=C := eq_of_le_of_card_ge (zpowers_le.mpr hz) (by
    rw [Nat.card_zpowers,orderOf_eq_prime hz2 hz1,hC])
  have hi : C.relIndex A=2 := by
    have hh := (C.subgroupOf A).index_mul_card
    rw [Nat.card_congr (subgroupOfEquivOfLe hCA).toEquiv,hC,hA] at hh
    change C.relIndex A*2=4 at hh
    omega
  have hg := sup_zpowers_eq_of_relIndex_prime hCA Nat.prime_two hi hx hxC
  rw [←hg,←hzC,zpowers_eq_closure,zpowers_eq_closure,←Subgroup.closure_union]
  congr 1
  ext y
  simp only [Set.mem_union,Set.mem_singleton_iff,Set.mem_insert_iff]
  tauto

private theorem pair_commutator_nontrivial {G : Type*} [Group G]
    (A B : Subgroup G) (x y z : G)
    (hA : A=closure ({x,z}:Set G)) (hB : B=closure ({y,z}:Set G))
    (hxz : Commute x z) (hyz : Commute y z) (hne : ⁅A,B⁆≠⊥) : ⁅x,y⁆≠1 := by
  intro hh
  apply hne
  apply commutator_eq_bot_iff_le_centralizer.mpr
  rw [hA,hB,centralizer_closure]
  apply (closure_le _).mpr
  rintro a (rfl|rfl) b (rfl|rfl)
  · exact (commutatorElement_eq_one_iff_commute.mp hh).symm.eq
  · exact hxz.symm.eq
  · exact hyz.eq
  · rfl

private theorem two_unique {G : Type*} [Group G] (C : Subgroup G)
    (hC : Nat.card C=2) {x y : G} (hx : x∈C) (hy : y∈C)
    (hx1 : x≠1) (hy1 : y≠1) : x=y := by
  obtain ⟨z,hz,hall⟩ := (Nat.card_eq_two_iff' (1:C)).mp hC
  have hxz : (⟨x,hx⟩:C)=z := (hall ⟨x,hx⟩) (fun hh => hx1 (congrArg Subtype.val hh))
  have hyz : (⟨y,hy⟩:C)=z := (hall ⟨y,hy⟩) (fun hh => hy1 (congrArg Subtype.val hh))
  exact congrArg Subtype.val (hxz.trans hyz.symm)



variable {G : Type*} [Group G] {P : Fin 2 → Subgroup G} {B : Subgroup G}
local notation "F" => family P

private theorem radius_three_relations
    (h : LocallyRankOneTriple P B)
    (hS : ∀ x, Stellmacher.IsSylowSubgroupIn (Q F x) (U F x))
    (hb : b F=2) {v m w : Vertex F}
    (hm : (graph F).Adj v m) (hw : (graph F).Adj m w)
    (hv4 : Nat.card (Z F v)=4) (hm2 : Nat.card (Z F m)=2)
    (hcm : ∀ y, (graph F).Adj m y → Z F m≤Z F y)
    (hcomm : ⁅V F m 1,Q F m⁆≤Z F m)
    (hne : ⁅Z F v,Z F w⁆≠⊥)
    (hval : Nat.card ((graph F).neighborSet m)=3) :
    ∃ x y z c : G, ThreeInvolution.Relations x y z c ∧
      V F m 1=closure ({x,y,z}:Set G) := by
  classical
  let := finite_endpoints h
  let X := (graph F).neighborSet m
  let : Finite X := finite_neighbors F m
  obtain ⟨g,hg3,hfree⟩ := transitive_three_cycle (localAction F m) hval (by
    intro x y
    obtain ⟨a,ha,he⟩ := locally_transitive F x.property y.property
    exact ⟨⟨a,ha⟩,Subtype.ext he⟩)
  let p := localAction F m g
  let v0 : X := ⟨v,hm.symm⟩
  let v1 := p v0
  let v2 := p v1
  obtain ⟨hall,hcycle,h20⟩ := three_cycle_orbit hval p hg3 hfree v0
  have hcy : (g:G) • (v2:Vertex F)=v := congrArg Subtype.val hcycle
  let A0 := Z F v
  let A1 := Z F (v1:Vertex F)
  let A2 := Z F (v2:Vertex F)
  let C := Z F m
  let τ := (MulAut.conj (g:G)).toMonoidHom
  have h01 : A0.map τ=A1 := (Z_translate F (g:G) v).symm
  have h12 : A1.map τ=A2 := (Z_translate F (g:G) (v1:Vertex F)).symm
  have h20' : A2.map τ=A0 := by rw [←Z_translate,hcy]
  have h0V : A0≤V F m 1 := le_iSup_of_le v
    (le_iSup_of_le ((mem_ball_one F m v).mpr (Or.inl hm.symm)) le_rfl)
  have h1V : A1≤V F m 1 := le_iSup_of_le (v1:Vertex F)
    (le_iSup_of_le ((mem_ball_one F m _).mpr (Or.inl v1.property)) le_rfl)
  have h2V : A2≤V F m 1 := le_iSup_of_le (v2:Vertex F)
    (le_iSup_of_le ((mem_ball_one F m _).mpr (Or.inl v2.property)) le_rfl)
  have hVQ : V F m 1≤Q F m := graph_V_le_Q_of_short h hS m (by rw [hb]; decide)
  have hC0 : C≤A0 := hcm v hm.symm
  have hC1 : C≤A1 := hcm _ v1.property
  have hC2 : C≤A2 := hcm _ v2.property
  have hVeq : V F m 1=(A0⊔A1)⊔A2 := by
    apply le_antisymm ?_ (sup_le (sup_le h0V h1V) h2V)
    apply iSup_le
    intro a
    apply iSup_le
    intro ha
    rcases (mem_ball_one F m a).mp ha with ha | rfl
    · rcases hall ⟨a,ha⟩ with hh | hh | hh
      · have he : a=(v0:Vertex F) := congrArg Subtype.val hh
        rw [he]
        exact le_sup_left.trans le_sup_left
      · have he : a=(v1:Vertex F) := congrArg Subtype.val hh
        rw [he]
        exact le_sup_right.trans le_sup_left
      · have he : a=(v2:Vertex F) := congrArg Subtype.val hh
        rw [he]
        exact le_sup_right
    · exact hC0.trans (le_sup_left.trans le_sup_left)
  have hn0 : ⁅A0,A1⁆≠⊥ := by
    intro h01bot
    have h12bot : ⁅A1,A2⁆=⊥ := by
      rw [←h01,←h12,←map_commutator,h01bot,Subgroup.map_bot]
    have h20bot : ⁅A2,A0⁆=⊥ := by
      rw [←h12,←h20',←map_commutator,h12bot,Subgroup.map_bot]
    apply hne
    rcases hall ⟨w,hw⟩ with he | he | he
    · have he' : w=v := congrArg Subtype.val he
      rw [he']
      let := graph_Z_elementary h v
      exact commutator_eq_bot_iff_le_centralizer.mpr (le_centralizer _)
    · have he' : w=(v1:Vertex F) := congrArg Subtype.val he
      simpa only [he'] using h01bot
    · have he' : w=(v2:Vertex F) := congrArg Subtype.val he
      simpa only [he',commutator_comm] using h20bot
  have hn1 : ⁅A1,A2⁆≠⊥ := by
    rw [←h01,←h12,←map_commutator]
    exact fun hh => hn0 ((map_eq_bot_iff_of_injective _ (MulAut.conj (g:G)).injective).mp hh)
  have hn2 : ⁅A0,A2⁆≠⊥ := by
    rw [commutator_comm,←h12,←h20',←map_commutator]
    exact fun hh => hn1 ((map_eq_bot_iff_of_injective _ (MulAut.conj (g:G)).injective).mp hh)
  let : Finite A0 := Finite.of_injective (inclusion (Z_le_stabilizer F v)) (inclusion_injective _)
  let : Finite A1 := Finite.of_injective (inclusion (Z_le_stabilizer F (v1:Vertex F))) (inclusion_injective _)
  let : Finite A2 := Finite.of_injective (inclusion (Z_le_stabilizer F (v2:Vertex F))) (inclusion_injective _)
  let : Finite C := Finite.of_injective (inclusion (Z_le_stabilizer F m)) (inclusion_injective _)
  have hA1 : Nat.card A1=4 := by rw [←h01,card_map_of_injective (MulAut.conj (g:G)).injective]; exact hv4
  have hA2 : Nat.card A2=4 := by rw [←h12,card_map_of_injective (MulAut.conj (g:G)).injective,hA1]
  have hnot (A : Subgroup G) [Finite A] (hA : Nat.card A=4) : ¬A≤C := by
    intro hh
    have hc := card_le_of_le hh
    rw [hA,hm2] at hc
    omega
  obtain ⟨x,hx,hxC⟩ := SetLike.not_le_iff_exists.mp (hnot A0 hv4)
  obtain ⟨y,hy,hyC⟩ := SetLike.not_le_iff_exists.mp (hnot A1 hA1)
  obtain ⟨z,hz,hzC⟩ := SetLike.not_le_iff_exists.mp (hnot A2 hA2)
  have hCne : C≠⊥ := by
    intro hh
    change Nat.card C=2 at hm2
    rw [hh,card_bot] at hm2
    contradiction
  obtain ⟨c,hc,hc1⟩ := C.bot_or_exists_ne_one.resolve_left hCne
  have hg0 := four_generated A0 C hv4 hm2 hC0 x c hx hxC hc hc1
  have hg1 := four_generated A1 C hA1 hm2 hC1 y c hy hyC hc hc1
  have hg2 := four_generated A2 C hA2 hm2 hC2 z c hz hzC hc hc1
  let := graph_Z_elementary h v
  let := graph_Z_elementary h (v1:Vertex F)
  let := graph_Z_elementary h (v2:Vertex F)
  let := graph_Z_elementary h m
  have hcx : Commute c x := by exact (le_centralizer A0 (hC0 hc) x hx).symm
  have hcy : Commute c y := by exact (le_centralizer A1 (hC1 hc) y hy).symm
  have hcz : Commute c z := by exact (le_centralizer A2 (hC2 hc) z hz).symm
  have hsqx : x^2=1 := elemPow_eq_one_of_isElementaryAbelian x hx
  have hsqy : y^2=1 := elemPow_eq_one_of_isElementaryAbelian y hy
  have hsqz : z^2=1 := elemPow_eq_one_of_isElementaryAbelian z hz
  have hxy : ⁅x,y⁆=c := two_unique C hm2
    (hcomm (commutator_mem_commutator (h0V hx) (hVQ (h1V hy)))) hc
    (pair_commutator_nontrivial A0 A1 x y c hg0 hg1 hcx.symm hcy.symm hn0) hc1
  have hyz : ⁅y,z⁆=c := two_unique C hm2
    (hcomm (commutator_mem_commutator (h1V hy) (hVQ (h2V hz)))) hc
    (pair_commutator_nontrivial A1 A2 y z c hg1 hg2 hcy.symm hcz.symm hn1) hc1
  have hxz : ⁅x,z⁆=c := two_unique C hm2
    (hcomm (commutator_mem_commutator (h0V hx) (hVQ (h2V hz)))) hc
    (pair_commutator_nontrivial A0 A2 x z c hg0 hg2 hcx.symm hcz.symm hn2) hc1
  have pair_square (a b : G) (ha : a^2=1) (hb : b^2=1) (he : ⁅a,b⁆=c) : (a*b)^2=c := by
    have hai : a⁻¹=a := inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using ha)
    have hbi : b⁻¹=b := inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using hb)
    simpa only [commutatorElement_def,hai,hbi,pow_two,mul_assoc] using he
  refine ⟨x,y,z,c,⟨hsqx,hsqy,hsqz,elemPow_eq_one_of_isElementaryAbelian c hc,
    hc1,hcx,hcy,hcz,pair_square x y hsqx hsqy hxy,
    pair_square y z hsqy hsqz hyz,pair_square x z hsqx hsqz hxz⟩,?_⟩
  apply le_antisymm
  · rw [hVeq,hg0,hg1,hg2]
    have hx' : x∈closure ({x,y,z}:Set G) := subset_closure (by simp)
    have hy' : y∈closure ({x,y,z}:Set G) := subset_closure (by simp)
    have hz' : z∈closure ({x,y,z}:Set G) := subset_closure (by simp)
    have hc' : c∈closure ({x,y,z}:Set G) := by
      rw [←pair_square x y hsqx hsqy hxy]
      exact pow_mem (mul_mem hx' hy') _
    apply sup_le (sup_le ?_ ?_) ?_ <;> apply (closure_le _).mpr
    · rintro a (rfl|rfl) <;> assumption
    · rintro a (rfl|rfl) <;> assumption
    · rintro a (rfl|rfl) <;> assumption
  · apply (closure_le _).mpr
    rintro a (rfl|rfl|rfl)
    · exact h0V hx
    · exact h1V hy
    · exact h2V hz


private def mx : QuaternionCyclic.Model := ⟨QuaternionGroup.a 1,true⟩
private def my : QuaternionCyclic.Model := ⟨QuaternionGroup.xa 0,true⟩
private def mz : QuaternionCyclic.Model := ⟨QuaternionGroup.xa 1,true⟩
private def mc : QuaternionCyclic.Model := QuaternionCyclic.quaternionEmbedding QuaternionCyclic.z
private theorem model_relations : ThreeInvolution.Relations mx my mz mc := by
  constructor
  all_goals first | decide +kernel | (change _ * _ = _ * _; decide +kernel)

private theorem relations_prod {H K : Type*} [Group H] [Group K]
    {x y z c : H} {x' y' z' c' : K}
    (r : ThreeInvolution.Relations x y z c) (s : ThreeInvolution.Relations x' y' z' c') :
    ThreeInvolution.Relations (x,x') (y,y') (z,z') (c,c') where
  first_square := Prod.ext r.first_square s.first_square
  second_square := Prod.ext r.second_square s.second_square
  third_square := Prod.ext r.third_square s.third_square
  central_square := Prod.ext r.central_square s.central_square
  central_ne_one := fun hh => r.central_ne_one (congrArg Prod.fst hh)
  central_first := Prod.ext r.central_first.eq s.central_first.eq
  central_second := Prod.ext r.central_second.eq s.central_second.eq
  central_third := Prod.ext r.central_third.eq s.central_third.eq
  first_second_square := Prod.ext r.first_second_square s.first_second_square
  second_third_square := Prod.ext r.second_third_square s.second_third_square
  first_third_square := Prod.ext r.first_third_square s.first_third_square

private theorem model_of_relations {H : Type*} [Group H] [Finite H]
    (x y z c : H) (r : ThreeInvolution.Relations x y z c)
    (hgen : closure ({x,y,z}:Set H)=⊤) : Nonempty (H≃*QuaternionCyclic.Model) := by
  have hH : Nat.card H=16 := by simpa only [hgen,card_top] using r.generated_card
  have hmodel : closure ({mx,my,mz}:Set QuaternionCyclic.Model)=⊤ :=
    eq_of_le_of_card_ge le_top (by rw [card_top,QuaternionCyclic.card_model,model_relations.generated_card])
  let D := closure ({(x,mx),(y,my),(z,mz)}:Set (H×QuaternionCyclic.Model))
  have hD : Nat.card D=16 := (relations_prod r model_relations).generated_card
  let f : D→*H := (MonoidHom.fst H QuaternionCyclic.Model).comp D.subtype
  let g : D→*QuaternionCyclic.Model := (MonoidHom.snd H QuaternionCyclic.Model).comp D.subtype
  have hf : Function.Surjective f := by
    apply MonoidHom.range_eq_top.mp
    rw [MonoidHom.range_comp,range_subtype]
    rw [show D=closure ({(x,mx),(y,my),(z,mz)}:Set (H×QuaternionCyclic.Model)) from rfl,
      MonoidHom.map_closure,Set.image_insert_eq,Set.image_insert_eq,Set.image_singleton]
    exact hgen
  have hg : Function.Surjective g := by
    apply MonoidHom.range_eq_top.mp
    rw [MonoidHom.range_comp,range_subtype]
    rw [show D=closure ({(x,mx),(y,my),(z,mz)}:Set (H×QuaternionCyclic.Model)) from rfl,
      MonoidHom.map_closure,Set.image_insert_eq,Set.image_insert_eq,Set.image_singleton]
    exact hmodel
  let ef := MulEquiv.ofBijective f (hf.bijective_of_nat_card_le (by rw [hD,hH]))
  let eg := MulEquiv.ofBijective g (hg.bijective_of_nat_card_le (by rw [hD,QuaternionCyclic.card_model]))
  exact ⟨ef.symm.trans eg⟩

private theorem subgroup_model_of_relations {H : Type*} [Group H]
    (A : Subgroup H) [Finite A] (x y z c : H) (r : ThreeInvolution.Relations x y z c)
    (hgen : A=closure ({x,y,z}:Set H)) :
    Nat.card A=16 ∧ Nonempty (A≃*QuaternionCyclic.Model) := by
  have hx : x∈A := hgen ▸ subset_closure (by simp)
  have hy : y∈A := hgen ▸ subset_closure (by simp)
  have hz : z∈A := hgen ▸ subset_closure (by simp)
  have hc : c∈A := by rw [←r.first_second_square]; exact A.pow_mem (A.mul_mem hx hy) 2
  let x' : A := ⟨x,hx⟩
  let y' : A := ⟨y,hy⟩
  let z' : A := ⟨z,hz⟩
  let c' : A := ⟨c,hc⟩
  have r' : ThreeInvolution.Relations x' y' z' c' := {
    first_square := Subtype.ext r.first_square
    second_square := Subtype.ext r.second_square
    third_square := Subtype.ext r.third_square
    central_square := Subtype.ext r.central_square
    central_ne_one := fun hh => r.central_ne_one (congrArg Subtype.val hh)
    central_first := Subtype.ext r.central_first.eq
    central_second := Subtype.ext r.central_second.eq
    central_third := Subtype.ext r.central_third.eq
    first_second_square := Subtype.ext r.first_second_square
    second_third_square := Subtype.ext r.second_third_square
    first_third_square := Subtype.ext r.first_third_square }
  have hgen' : closure ({x',y',z'}:Set A)=⊤ := by
    apply map_injective A.subtype_injective
    rw [MonoidHom.map_closure,Set.image_insert_eq,Set.image_insert_eq,Set.image_singleton,
      ←MonoidHom.range_eq_map,range_subtype]
    exact hgen.symm
  exact ⟨by simpa only [hgen',card_top] using r'.generated_card,
    model_of_relations x' y' z' c' r' hgen'⟩

private theorem quaternion_commutator_of_generation {H : Type*} [Group H]
    (A L Z C : Subgroup H) [Finite A]
    (e : A≃*QuaternionCyclic.Model) (hn : L≤normalizer (A:Set H))
    (hZ : Z≤A) (hZ4 : Nat.card Z=4) (hC2 : Nat.card C=2)
    (hC : C≤Z⊓⁅A,L⁆) (hgen : A=Z⊔⁅A,L⁆) :
    Nonempty ((⁅A,L⁆ : Subgroup H) ≃* QuaternionGroup 2) := by
  let T := QuaternionCyclic.quaternionEmbedding.range.map e.symm.toMonoidHom
  have hT : T.Characteristic := by
    apply characteristic_iff_le_comap.mpr
    intro a x hx
    obtain ⟨y,hy,rfl⟩ := hx
    refine ⟨(MulAut.congr e a) y,
      characteristic_iff_le_comap.mp inferInstance (MulAut.congr e a) hy,?_⟩
    exact e.symm.apply_symm_apply (a (e.symm y))
  let N := T.map A.subtype
  have hNA : N≤A := map_subtype_le _
  let : Finite N := Finite.of_injective (inclusion hNA) (inclusion_injective _)
  let eT : QuaternionGroup 2≃*T :=
    (MonoidHom.ofInjective QuaternionCyclic.quaternionEmbedding_injective).trans
      (QuaternionCyclic.quaternionEmbedding.range.equivMapOfInjective e.symm.toMonoidHom e.symm.injective)
  let eN : N≃*QuaternionGroup 2 :=
    (T.equivMapOfInjective A.subtype A.subtype_injective).symm.trans eT.symm
  have hN8 : Nat.card N=8 := by
    rw [Nat.card_congr eN.toEquiv,Nat.card_eq_fintype_card,QuaternionGroup.card]
  have hA16 : Nat.card A=16 := (Nat.card_congr e.toEquiv).trans QuaternionCyclic.card_model
  have hi : N.relIndex A=2 := by
    have hh := (N.subgroupOf A).index_mul_card
    rw [Nat.card_congr (subgroupOfEquivOfLe hNA).toEquiv,hN8,hA16] at hh
    change N.relIndex A*8=16 at hh
    omega
  have hMN : ⁅A,L⁆≤N := commutator_le_of_normalized_index_two A N L hNA hi hn
    (hn.trans (normalizer_le_normalizer_characteristic_image A T))
  let : Finite Z := Finite.of_injective (inclusion hZ) (inclusion_injective _)
  let : Finite (⁅A,L⁆ : Subgroup H) := Finite.of_injective (inclusion (hMN.trans hNA)) (inclusion_injective _)
  let : Finite (Z⊓⁅A,L⁆ : Subgroup H) := Finite.of_injective
    (inclusion (show Z⊓⁅A,L⁆≤Z from inf_le_left)) (inclusion_injective _)
  have hbound := card_le_of_le hC
  have hMA : ⁅A,L⁆≤A := hMN.trans hNA
  let : ((⁅A,L⁆).subgroupOf A).Normal :=
    (normal_subgroupOf_iff_le_normalizer hMA).mpr (normalizer_commutator_ge_left A L)
  have hprod := card_mul_eq_card_inf_mul_card_sup_of_normalizes
    ((⁅A,L⁆).subgroupOf A) (Z.subgroupOf A)
    (show Z.subgroupOf A≤normalizer (((⁅A,L⁆).subgroupOf A):Set A) from by
      rw [normalizer_eq_top]; exact le_top)
  change Nat.card ((⁅A,L⁆).subgroupOf A)*Nat.card (Z.subgroupOf A)=
    Nat.card ((⁅A,L⁆⊓Z).subgroupOf A)*Nat.card ((⁅A,L⁆).subgroupOf A⊔Z.subgroupOf A : Subgroup A) at hprod
  rw [←subgroupOf_sup hMA hZ,
    Nat.card_congr (subgroupOfEquivOfLe hMA).toEquiv,
    Nat.card_congr (subgroupOfEquivOfLe hZ).toEquiv,
    Nat.card_congr (subgroupOfEquivOfLe (show ⁅A,L⁆⊓Z≤A from inf_le_right.trans hZ)).toEquiv,
    Nat.card_congr (subgroupOfEquivOfLe (sup_le hMA hZ)).toEquiv,
    hZ4,inf_comm,sup_comm,←hgen,hA16] at hprod
  rw [hC2] at hbound
  have hEq : ⁅A,L⁆=N := eq_of_le_of_card_ge hMN (by rw [hN8]; nlinarith)
  exact ⟨(MulEquiv.subgroupCongr hEq).trans eN⟩



variable {k W : Type*} [Field k] [Finite k] [CharP k 2]
  [AddCommGroup W] [Module (ZMod 2) W]
local instance binaryRadiusAlgebra : Algebra (ZMod 2) k := ZMod.algebra k 2

/-- In the binary beta row, the actual radius-one group is Q₈ ◦ C₄,
and its commutator with the actual beta local actor is Q₈. -/
theorem BTwoCenterActionData.binary_radius_structure
    (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B)=pCore 2 B)
    (hSyl : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype≤B)
    (hb : b F=2) {v m w : Vertex F}
    (c : BTwoCenterActionData F v m w k W)
    (hactor : c.actor=graphLocalGroup F v)
    (hcentral : Z F m≤centerIn (graphLocalGroup F m))
    (E : W≃ₗ[ZMod 2](Fin 2→k)) (hk : Nat.card k=2)
    (hcomm : ⁅V F m 1,Q F m⁆=Z F m)
    (hne : ⁅Z F v,Z F w⁆≠⊥)
    (hval : Nat.card ((graph F).neighborSet m)=3) :
    Nat.card (V F m 1)=16 ∧ Nonempty (V F m 1≃*QuaternionCyclic.Model) ∧
      Nonempty ((⁅V F m 1,graphLocalGroup F m⁆ : Subgroup G)≃*QuaternionGroup 2) := by
  let := finite_endpoints h
  have hS := source_kernel_sylow h hB hSyl
  have hω := c.omega_eq_bot_of_central_neighbor h hB hSyl hactor hcentral
  have hv4 : Nat.card (Z F v)=4 := by simpa [hk] using c.central_center_card E hω
  have hm2 : Nat.card (Z F m)=2 :=
    (c.central_middle_center_card h hB hSyl hb hactor hcentral E).trans hk
  have hcm (a : Vertex F) (ha : (graph F).Adj m a) : Z F m≤Z F a :=
    center_le_of_central_neighbor h hB hSyl ha.symm hcentral
  obtain ⟨x,y,z,a,r,hr⟩ := radius_three_relations h hS hb c.middle c.terminal
    hv4 hm2 hcm hcomm.le hne hval
  have hVQ : V F m 1≤Q F m := graph_V_le_Q_of_short h hS m (by rw [hb]; decide)
  let : Finite (V F m 1) := Finite.of_injective
    (inclusion (hVQ.trans (Q_le_stabilizer F m))) (inclusion_injective _)
  obtain ⟨hcard,⟨e⟩⟩ := subgroup_model_of_relations (V F m 1) x y z a r hr
  have hn : graphLocalGroup F m≤normalizer (V F m 1 : Set G) :=
    (sylowGenerated_le _).trans (graph_stabilizer_normalizes_V h m 1)
  have hQL : Q F m≤graphLocalGroup F m := by
    let T := Classical.choice (inferInstance : Nonempty (Sylow 2 (stabilizer F m)))
    exact (pCoreIn_le_sylow _ T).trans (sylow_le_sylowGenerated _ T)
  have hZV : Z F v≤V F m 1 := le_iSup_of_le v
    (le_iSup_of_le ((mem_ball_one F m v).mpr (Or.inl c.middle.symm)) le_rfl)
  let M := ⁅V F m 1,graphLocalGroup F m⁆
  have hMV : M≤V F m 1 := le_normalizer_iff_commutator_le_left.mp hn
  have hCM : Z F m≤M := hcomm ▸ commutator_mono le_rfl hQL
  have hgen : V F m 1=Z F v⊔M := by
    apply le_antisymm ?_ (sup_le hZV hMV)
    apply iSup_le
    intro b
    apply iSup_le
    intro hb'
    rcases (mem_ball_one F m b).mp hb' with hb' | rfl
    · obtain ⟨g,hg,hgb⟩ := graphLocalGroup_transitive h hB hSyl m ⟨v,c.middle.symm⟩ ⟨b,hb'⟩
      change g • v=b at hgb
      rw [←hgb,Z_translate]
      rintro q ⟨u,hu,rfl⟩
      have hgu : ⁅g,u⁆∈M := by
        rw [show M=⁅graphLocalGroup F m,V F m 1⁆ from commutator_comm _ _]
        exact commutator_mem_commutator hg (hZV hu)
      have hh := (Z F v⊔M).mul_mem (mem_sup_right hgu) (mem_sup_left hu)
      change g*u*g⁻¹∈Z F v⊔M
      simpa only [commutatorElement_def,mul_assoc,inv_mul_cancel,mul_one] using hh
    · exact (hcm v c.middle.symm).trans le_sup_left
  exact ⟨hcard,⟨e⟩,quaternion_commutator_of_generation (V F m 1)
    (graphLocalGroup F m) (Z F v) (Z F m) e hn hZV hv4 hm2
    (le_inf (hcm v c.middle.symm) hCM) hgen⟩

