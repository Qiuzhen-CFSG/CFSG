module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.NoncommutingProfile.BTwoSeedIntersections
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.NoncommutingProfile.BTwoSeedFieldSource

/-!
# Adjacent-core seed calculations on the original endpoints

The seed-intersection theorem applies to the actual reduced F1.11 graph.
Mapping through the reduced-completion inclusion identifies its neighboring
cores with the original full endpoint cores. This gives the literal
adjacent-core product identity and identifies the seed image with the join
of the two original core intersections.

The previously proved p.159 field bound and square-order formula now use
that same adjacent-core index. No seed-saturation or numerical index
hypothesis is added. The field in the earlier center action is q_alpha;
the source's equality |Q_alpha/D_alpha| = q_beta^2 still requires saturation
and identification of the beta field. In particular, no equality of the
two field orders is inferred here.

Source: DGS, *Groups and Graphs* (1985), (10.7), printed pp.158--159,
and the reduction and original endpoint markings on pp.95--96.
-/

@[expose] public noncomputable section
open Subgroup
open scoped Pointwise commutatorElement
namespace CFSG.Quasithin.ChapterF.Source.DGS85.NoncommutingProfile.Reduction
open Subgroup.CosetGeometry.RankTwo Theory.GroupTheory.AmalgamGraph Noncommuting DGS85.Reduction
variable {G : Type*} [Group G] {L : Fin 2 → Subgroup G} {S : Subgroup G}
variable {k W : Type*} [Field k] [Finite k] [CharP k 2]
  [AddCommGroup W] [Module (ZMod 2) W]
local notation "F₀" => reducedFamily L S
local notation "α" => base F₀ false
local notation "β" => base F₀ true

/-- The source product identity for the original two endpoint cores. -/
theorem original_bTwo_adjacent_core_seed_intersection
    (h : HypothesisF11 L S) (hb : b F₀ = 2) {u t : Vertex F₀}
    (c : BTwoCenterActionData F₀ α β u k W)
    (ht : (graph F₀).Adj α t) (hne : t ≠ β) :
    (parabolic L S 0).pCoreIn 2 ⊓ (parabolic L S 1).pCoreIn 2 =
      ((V F₀ β 1).map (G₀ L S).subtype ⊓ (parabolic L S 0).pCoreIn 2) ⊔
        ((parabolic L S 1).pCoreIn 2 ⊓ (Q F₀ t).map (G₀ L S).subtype) := by
  have hh := c.seed_adjacent_intersection (reduced_triple h) (reduced_kernel_sylow h)
    hb ht hne
  have hm := congrArg (map (G₀ L S).subtype) hh
  change ((Q F₀ α ⊓ Q F₀ β).map (G₀ L S).subtype) =
    (((V F₀ β 1 ⊓ Q F₀ α) ⊔ (Q F₀ β ⊓ Q F₀ t)).map (G₀ L S).subtype) at hm
  simpa only [Subgroup.map_sup,map_inf _ _ _ (G₀ L S).subtype_injective,
    reduced_base_Q_map h false,reduced_base_Q_map h true, Bool.false_eq_true, ↓reduceIte] using hm

/-- The seed image is generated by the literal two adjacent-core intersections. -/
theorem original_bTwo_seed_eq_core_intersections
    (h : HypothesisF11 L S) (hb : b F₀ = 2) {u t : Vertex F₀}
    (c : BTwoCenterActionData F₀ α β u k W)
    (ht : (graph F₀).Adj α t) (hne : t ≠ β) :
    (centralSeed F₀ α β t).map (G₀ L S).subtype =
      ((parabolic L S 0).pCoreIn 2 ⊓ (parabolic L S 1).pCoreIn 2) ⊔
        ((parabolic L S 0).pCoreIn 2 ⊓ (Q F₀ t).map (G₀ L S).subtype) := by
  have hh := c.seed_eq_core_intersections (reduced_triple h) (reduced_kernel_sylow h)
    hb ht hne
  have hm := congrArg (map (G₀ L S).subtype) hh
  change (centralSeed F₀ α β t).map (G₀ L S).subtype =
    (((Q F₀ α ⊓ Q F₀ β) ⊔ (Q F₀ α ⊓ Q F₀ t)).map (G₀ L S).subtype) at hm
  simpa only [Subgroup.map_sup,map_inf _ _ _ (G₀ L S).subtype_injective,
    reduced_base_Q_map h false,reduced_base_Q_map h true, Bool.false_eq_true, ↓reduceIte] using hm

private theorem original_adjacent_index
    (h : HypothesisF11 L S) (t : Vertex F₀) :
    ((parabolic L S 1).pCoreIn 2 ⊓ (Q F₀ t).map (G₀ L S).subtype).relIndex
      ((parabolic L S 0).pCoreIn 2 ⊓ (parabolic L S 1).pCoreIn 2) =
        (D F₀ β t).relIndex (Q F₀ α ⊓ Q F₀ β) := by
  have he := relIndex_map_map_of_injective (f := (G₀ L S).subtype)
    (D F₀ β t) (Q F₀ α ⊓ Q F₀ β) (G₀ L S).subtype_injective
  change ((Q F₀ β ⊓ Q F₀ t).map (G₀ L S).subtype).relIndex
    ((Q F₀ α ⊓ Q F₀ β).map (G₀ L S).subtype) = _ at he
  simpa only [map_inf _ _ _ (G₀ L S).subtype_injective,
    reduced_base_Q_map h false,reduced_base_Q_map h true, Bool.false_eq_true, ↓reduceIte] using he

/-- The alpha field bounds the original adjacent-core index over D. -/
theorem original_bTwo_adjacent_core_field_bound
    (h : HypothesisF11 L S) (hb : b F₀ = 2) {u t : Vertex F₀}
    (c : BTwoCenterActionData F₀ α β u k W)
    (hactor : c.actor = graphLocalGroup F₀ α)
    (hcentral : Z F₀ β ≤ centerIn (graphLocalGroup F₀ β))
    (ht : (graph F₀).Adj α t) (hne : t ≠ β)
    (hcomm : ⁅V F₀ β 1,Q F₀ β⁆ ≤ Z F₀ β)
    (hnot : ¬ stabilizer F₀ α ≤ normalizer
      ((Q F₀ β ⊓ Q F₀ α : Subgroup (G₀ L S)) : Set (G₀ L S))) :
    Nat.card k ≤
      ((parabolic L S 1).pCoreIn 2 ⊓ (Q F₀ t).map (G₀ L S).subtype).relIndex
        ((parabolic L S 0).pCoreIn 2 ⊓ (parabolic L S 1).pCoreIn 2) := by
  have hi := c.seed_factor_index_eq (reduced_triple h) (reduced_kernel_sylow h) hb ht hne
  change (D F₀ β t).relIndex (Q F₀ α ⊓ Q F₀ β) =
    (D F₀ β t).relIndex (V F₀ β 1 ⊓ Q F₀ α) at hi
  rw [original_adjacent_index h t,hi]
  exact c.central_seed_field_bound (reduced_triple h) (reduced_borel_core_sylow h)
    (reduced_vertex_sylow h) hb hactor hcentral ht hne hcomm hnot

/-- The actual seed quotient has the square of the original adjacent-core index. -/
theorem original_bTwo_seed_card_adjacent_index_square
    (h : HypothesisF11 L S) (hb : b F₀ = 2) {u t : Vertex F₀}
    (c : BTwoCenterActionData F₀ α β u k W)
    (hactor : c.actor = graphLocalGroup F₀ α)
    (hcentral : Z F₀ β ≤ centerIn (graphLocalGroup F₀ β))
    (ht : (graph F₀).Adj α t) (hne : t ≠ β)
    (hcomm : ⁅V F₀ β 1,Q F₀ β⁆ ≤ Z F₀ β) :
    ∃ hN : ((D F₀ β t).subgroupOf (centralSeed F₀ α β t)).Normal,
      letI := hN
      Nat.card (centralSeed F₀ α β t ⧸ (D F₀ β t).subgroupOf (centralSeed F₀ α β t)) =
        (((parabolic L S 1).pCoreIn 2 ⊓ (Q F₀ t).map (G₀ L S).subtype).relIndex
          ((parabolic L S 0).pCoreIn 2 ⊓ (parabolic L S 1).pCoreIn 2)) ^ 2 := by
  obtain ⟨hN,hcard⟩ := c.central_seed_card_square (reduced_triple h)
    (reduced_borel_core_sylow h) (reduced_vertex_sylow h) hb hactor hcentral ht hne hcomm
  refine ⟨hN,?_⟩
  have hi := c.seed_factor_index_eq (reduced_triple h) (reduced_kernel_sylow h) hb ht hne
  change (D F₀ β t).relIndex (Q F₀ α ⊓ Q F₀ β) =
    (D F₀ β t).relIndex (V F₀ β 1 ⊓ Q F₀ α) at hi
  rw [original_adjacent_index h t,hi]
  exact hcard

end CFSG.Quasithin.ChapterF.Source.DGS85.NoncommutingProfile.Reduction
