/-- The actual p.165 minimal normal interval in the full original beta stabilizer,
with the proper-quotient and small-section estimates constructed internally.
The terminal equal-field case remains open; the following theorem supplies
the sharp section orders and excludes unequal fields. -/
theorem original_bTwo_10_10_minimal_section_bounds
    (h : HypothesisF11 L S) {u t : Vertex F₀}
    (hc : IsCriticalPair F₀ α u) (hne : ⁅Z F₀ α,Z F₀ u⁆≠⊥)
    (hb : b F₀=2) (hβu : (graph F₀).Adj β u)
    (ht : (graph F₀).Adj α t) (htne : t≠β)
    (K : Bool → Type*) [∀ i, Field (K i)] [∀ i, Finite (K i)] [∀ i, CharP (K i) 2]
    (e : ∀ i, (family L i⧸pCore 2 (family L i))≃*PSL(2,K i))
    (hK : 2<Nat.card (K true))
    (hD : (parabolic L S 1).pCoreIn 2⊓(Q F₀ t).map (G₀ L S).subtype≠(Z F₀ α).map (G₀ L S).subtype) :
    let Q₁ := (parabolic L S 1).pCoreIn 2
    let Z₁ := (Z F₀ β).map (G₀ L S).subtype
    parabolic L S 1 ≤ normalizer (Z₁ : Set G) ∧
      ∃ N : Subgroup G, Z₁ < N ∧ N ≤ Q₁ ∧
        parabolic L S 1 ≤ normalizer (N : Set G) ∧
        (∀ M : Subgroup G, Z₁ ≤ M → M ≤ N →
          parabolic L S 1 ≤ normalizer (M : Set G) → M=Z₁ ∨ M=N) ∧
        (N=Q₁ ∨ (Nat.card (K true)^2 ≤ N.relIndex Q₁ ∧
          Z₁.relIndex N ≤ Nat.card (K false)^2 ∧
          (Z₁.relIndex N < Nat.card (K true)^2 →
            N ≤ centerIn (enlargedEndpoint L S 1)))) := by
  classical
  let Q₁ := (parabolic L S 1).pCoreIn 2
  let Z₁ := (Z F₀ β).map (G₀ L S).subtype
  let := h.finite_parabolic 1
  let : Finite Q₁ := Finite.of_injective (inclusion (pCoreIn_le 2 _)) (inclusion_injective _)
  have hZQ : Z₁ < Q₁ :=
    (original_bTwo_strict_beta_total_section h hc hne hb hβu ht htne K e hD).1
  have hPQ : parabolic L S 1 ≤ normalizer (Q₁ : Set G) :=
    (parabolic L S 1).le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image _ (pCore 2 _))
  have hder : ⁅Q₁,Q₁⁆=Z₁ :=
    (original_bTwo_strict_core_orders h hc hne hb hβu ht htne K e hD).2.2.2.2.2.2.2.2.2.2.2
  have hPZ : parabolic L S 1 ≤ normalizer (Z₁ : Set G) := by
    intro a ha
    rw [mem_normalizer_iff_map_conj_eq,←hder,map_commutator,
      mem_normalizer_iff_map_conj_eq.mp (hPQ ha)]
  let Good : Subgroup G → Prop := fun M => Z₁ < M ∧ M ≤ Q₁ ∧
    parabolic L S 1 ≤ normalizer (M : Set G)
  have hex : ∃ n : ℕ, ∃ M : Subgroup G, Good M ∧ Nat.card M=n :=
    ⟨Nat.card Q₁,Q₁,⟨hZQ,le_rfl,hPQ⟩,rfl⟩
  obtain ⟨N,hN,hcard⟩ := Nat.find_spec hex
  let : Finite N := Finite.of_injective (inclusion hN.2.1) (inclusion_injective _)
  have hmin : ∀ M : Subgroup G, Z₁ ≤ M → M ≤ N →
      parabolic L S 1 ≤ normalizer (M : Set G) → M=Z₁ ∨ M=N := by
    intro M hZM hMN hPM
    by_cases he : M=Z₁
    · exact Or.inl he
    right
    apply eq_of_le_of_card_ge hMN
    exact hcard.trans_le (Nat.find_min' hex
      ⟨M,⟨lt_of_le_of_ne hZM (Ne.symm he),hMN.trans hN.2.1,hPM⟩,rfl⟩)
  refine ⟨hPZ,N,hN.1,hN.2.1,hN.2.2,hmin,?_⟩
  by_cases he : N=Q₁
  · exact Or.inl he
  right
  have hNQ : N < Q₁ := lt_of_le_of_ne hN.2.1 he
  refine ⟨?_,?_,?_⟩
  · simpa only [relIndex,index_eq_card] using
      original_bTwo_nonbinary_beta_proper_quotient_bound h hc hne hb hβu ht htne K e hK hD N hNQ hN.2.2
  · simpa only [relIndex,index_eq_card] using
      original_bTwo_nonbinary_beta_section_upper h hc hne hb hβu ht htne K e hK hD N hNQ hN.1.le hN.2.2
  · intro hsmall
    apply original_bTwo_nonbinary_beta_small_section_central h hc hne hb hβu ht htne K e hK hD
      N hNQ.le hN.1.le hN.2.2
    simpa only [relIndex,index_eq_card] using hsmall


