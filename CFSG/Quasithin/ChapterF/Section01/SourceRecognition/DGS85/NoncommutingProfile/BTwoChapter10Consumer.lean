open Theory.GroupTheory.WeakBNPair.RegularTree in
/-- All four clauses of DGS (10.10) for the original strict branch. The
binary quaternion exception and the full beta quotient action are explicit. -/
theorem original_bTwo_10_10_complete_profile
    (h : HypothesisF11 L S) {u t : Vertex F₀}
    (hc : IsCriticalPair F₀ α u) (hne : ⁅Z F₀ α,Z F₀ u⁆≠⊥)
    (hb : b F₀=2) (hβu : (graph F₀).Adj β u)
    (ht : (graph F₀).Adj α t) (htne : t≠β)
    (K : Bool → Type*) [∀ i, Field (K i)] [∀ i, Finite (K i)] [∀ i, CharP (K i) 2]
    (e : ∀ i, (family L i⧸pCore 2 (family L i))≃*PSL(2,K i))
    (hD : (parabolic L S 1).pCoreIn 2⊓(Q F₀ t).map ι≠(Z F₀ α).map ι) :
    HasSourcePathParameters (P:=fun i => (P₀ L S i).subgroupOf (G₀ L S)) 6 7 ∧
      Nat.card ((parabolic L S 1).pCoreIn 2⊓(Q F₀ t).map ι : Subgroup G)=
        Nat.card (K false)^2*Nat.card (K true) ∧
      Nat.card ((commonBorel L S).pCoreIn 2)=Nat.card (K false)^3*Nat.card (K true)^3 ∧
      (∀ {a z : Vertex F₀} (p : (graph F₀).Walk a z), IsSourcePath p → 7≤p.length →
        Odd (Nat.card (pathFixer (X:=G₀ L S) p))) ∧
      (frattini Qβ).map (Qβ).subtype=Zβ ∧
      ((∃ hN : ((Zβ).subgroupOf Qβ).Normal, letI := hN
          ∃ hel : IsElementaryAbelian 2 (Qβ⧸(Zβ).subgroupOf Qβ), letI := hel
            ∃ ρ : Representation (ZMod 2) (Pβ⧸pCore 2 Pβ) (Additive (Qβ⧸(Zβ).subgroupOf Qβ)),
              ∃ d : Representation.BinaryConjugationSection Pβ Qβ Zβ
                  (ρ.comp (QuotientGroup.mk' (pCore 2 Pβ))),
                (∀ q : Qβ, (d.coordinates q).toAdd =
                  Additive.ofMul (QuotientGroup.mk' ((Zβ).subgroupOf Qβ) q)) ∧
                ρ.IsIrreducible ∧
                Nat.card (Qβ⧸(Zβ).subgroupOf Qβ)=Nat.card (K false)^2*Nat.card (K true)^2) ∨
        (Nat.card (K false)=2 ∧ Nat.card (K true)=2 ∧
          Nonempty ((⁅(V F₀ β 1).map ι,enlargedEndpoint L S 1⁆:Subgroup G)≃*QuaternionGroup 2))) := by
  obtain ⟨hpaths,hodd⟩ := original_bTwo_strict_source_path_parameters h hc hne hb hβu ht htne K e hD
  obtain ⟨_,_,_,hZ₀,_,hDc,_,_,_,hSc,hPhi,_⟩ :=
    original_bTwo_strict_core_orders h hc hne hb hβu ht htne K e hD
  refine ⟨hpaths,hDc,hSc,hodd,hPhi,?_⟩
  by_cases hqb : Nat.card (K true)=2
  · right
    obtain ⟨k,f,fin,ch,alg,c,hactor,_,_,_,hZ,_,_,_,_,_,_,_,hfield,_⟩ :=
      original_bTwo_intrinsic_core_orders h hc hne hb hβu ht htne (e true)
    have hp : Nat.card k^2=Nat.card (K false)^2 := hZ.symm.trans hZ₀
    have hk : Nat.card k=Nat.card (K false) := by nlinarith only [hp]
    rw [hk,hqb] at hfield
    have hqa : Nat.card (K false)=2 := by
      have hmin : 1<Nat.card (K false) := Finite.one_lt_card
      omega
    obtain ⟨_,_,hq,_⟩ := original_bTwo_binary_radius_quaternion h hc hne hb hβu ht htne (e true) hqb
    exact ⟨hqa,hqb,hq⟩
  · left
    have hq : 2<Nat.card (K true) := by
      have hmin : 1<Nat.card (K true) := Finite.one_lt_card
      omega
    exact original_bTwo_nonbinary_beta_irreducible h hc hne hb hβu ht htne K e hq hD

