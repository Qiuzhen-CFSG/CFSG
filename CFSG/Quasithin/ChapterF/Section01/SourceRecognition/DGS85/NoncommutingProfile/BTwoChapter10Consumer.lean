/-- The strict mixed S3/A5 branch gives the actual order-64 irreducible
binary section under the full original beta quotient, with its original
coordinates. This is the mixed-size consumer of (10.10)(d). -/
theorem original_bTwo_10_10_mixed_beta_irreducible
    (h : HypothesisF11 L S) {u t : Vertex F₀}
    (hc : IsCriticalPair F₀ α u) (hne : ⁅Z F₀ α,Z F₀ u⁆≠⊥)
    (hb : b F₀=2) (hβu : (graph F₀).Adj β u)
    (ht : (graph F₀).Adj α t) (htne : t≠β)
    (K : Bool → Type*) [∀ i, Field (K i)] [∀ i, Finite (K i)] [∀ i, CharP (K i) 2]
    (e : ∀ i, (family L i⧸pCore 2 (family L i))≃*PSL(2,K i))
    (hqa : Nat.card (K false)=2) (hqb : Nat.card (K true)=4)
    (hD : (parabolic L S 1).pCoreIn 2⊓(Q F₀ t).map (G₀ L S).subtype≠(Z F₀ α).map (G₀ L S).subtype)
    :
    ∃ hN : ((Zβ).subgroupOf Qβ).Normal, letI := hN
      ∃ hel : IsElementaryAbelian 2 (Qβ⧸(Zβ).subgroupOf Qβ), letI := hel
        ∃ ρ : Representation (ZMod 2) (Pβ⧸pCore 2 Pβ) (Additive (Qβ⧸(Zβ).subgroupOf Qβ)),
          ∃ d : Representation.BinaryConjugationSection Pβ Qβ Zβ
              (ρ.comp (QuotientGroup.mk' (pCore 2 Pβ))),
            (∀ q : Qβ, (d.coordinates q).toAdd =
              Additive.ofMul (QuotientGroup.mk' ((Zβ).subgroupOf Qβ) q)) ∧
            ρ.IsIrreducible ∧
            Nat.card (Qβ⧸(Zβ).subgroupOf Qβ)=64 := by
  obtain ⟨hN,hel,ρ,d,hd,hirr,hcard⟩ := original_bTwo_unequal_beta_irreducible
    h hc hne hb hβu ht htne K e (by omega) hD (by omega)
  let _ := hN
  let _ := hel
  refine ⟨hN,hel,ρ,d,hd,hirr,?_⟩
  simp only [hqa,hqb,Nat.reducePow,Nat.reduceMul] at hcard
  exact hcard

