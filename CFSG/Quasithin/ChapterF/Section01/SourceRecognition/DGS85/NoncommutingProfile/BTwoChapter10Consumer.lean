/-- Apply the equal-field intersection argument to the actual selected minimal
section. The original beta stabilizer, both core maps and minimality remain
literal; only the final abelian-subgroup/kernel contradiction is outstanding. -/
theorem original_bTwo_10_10_minimal_section_intersections
    (h : HypothesisF11 L S) {u t : Vertex F₀}
    (hc : IsCriticalPair F₀ α u) (hne : ⁅Z F₀ α,Z F₀ u⁆≠⊥)
    (hb : b F₀=2) (hβu : (graph F₀).Adj β u)
    (ht : (graph F₀).Adj α t) (htne : t≠β)
    (K : Bool → Type*) [∀ i, Field (K i)] [∀ i, Finite (K i)] [∀ i, CharP (K i) 2]
    (e : ∀ i, (family L i⧸pCore 2 (family L i))≃*PSL(2,K i))
    (hK : 2<Nat.card (K true))
    (hD : (parabolic L S 1).pCoreIn 2⊓(Q F₀ t).map (G₀ L S).subtype≠(Z F₀ α).map (G₀ L S).subtype) :
    let Q₀ := (parabolic L S 0).pCoreIn 2
    let Q₁ := (parabolic L S 1).pCoreIn 2
    let D₀ := Q₁⊓(Q F₀ t).map (G₀ L S).subtype
    let Z₀ := (Z F₀ α).map (G₀ L S).subtype
    let Z₁ := (Z F₀ β).map (G₀ L S).subtype
    ∃ N : Subgroup G, Z₁<N ∧ N≤Q₁ ∧
      parabolic L S 1≤normalizer (N:Set G) ∧
      (∀ M : Subgroup G, Z₁≤M → M≤N →
        parabolic L S 1≤normalizer (M:Set G) → M=Z₁ ∨ M=N) ∧
      (N=Q₁ ∨ (Nat.card (K false)=Nat.card (K true) ∧
        Z₁.relIndex N=Nat.card (K true)^2 ∧ N.relIndex Q₁=Nat.card (K true)^2 ∧
        N⊓Z₀=Z₁ ∧ N⊓D₀=Z₁ ∧
        Nat.card (N⊓Q₀ : Subgroup G)=Nat.card (K true)^2 ∧ ¬N≤Q₀)) := by
  obtain ⟨_,N,hZN,hNQ,hPN,hmin,hcase⟩ :=
    original_bTwo_10_10_sharp_minimal_section h hc hne hb hβu ht htne K e hK hD
  refine ⟨N,hZN,hNQ,hPN,hmin,?_⟩
  by_cases he : N=(parabolic L S 1).pCoreIn 2
  · exact Or.inl he
  obtain ⟨hfields,horder,hindex⟩ := hcase.resolve_left he
  obtain ⟨_,hNZ,hND,hI,hescape⟩ :=
    original_bTwo_nonbinary_beta_proper_core_intersection h hc hne hb hβu ht htne K e hK hD N
      (lt_of_le_of_ne hNQ he) hZN hPN
  exact Or.inr ⟨hfields,horder,hindex,hNZ,hND,hI,hescape⟩

open scoped MatrixGroups IsMulCommutative in
/-- The actual minimal section either fills the beta core or supplies the
abelian subgroup of order q_beta^4 used by the p.165 second-kernel argument.
All factors and the opposite conjugator retain their original markings. -/
theorem original_bTwo_10_10_minimal_abelian_supplement
    (h : HypothesisF11 L S) {u t : Vertex F₀}
    (hc : IsCriticalPair F₀ α u) (hne : ⁅Z F₀ α,Z F₀ u⁆≠⊥)
    (hb : b F₀=2) (hβu : (graph F₀).Adj β u)
    (ht : (graph F₀).Adj α t) (htne : t≠β)
    (K : Bool → Type*) [∀ i, Field (K i)] [∀ i, Finite (K i)] [∀ i, CharP (K i) 2]
    (e : ∀ i, (family L i⧸pCore 2 (family L i))≃*PSL(2,K i))
    (hK : 2<Nat.card (K true))
    (hD : (parabolic L S 1).pCoreIn 2⊓(Q F₀ t).map (G₀ L S).subtype≠(Z F₀ α).map (G₀ L S).subtype) :
    let Q₀ := (parabolic L S 0).pCoreIn 2
    let Q₁ := (parabolic L S 1).pCoreIn 2
    let D₀ := Q₁⊓(Q F₀ t).map (G₀ L S).subtype
    let Z₀ := (Z F₀ α).map (G₀ L S).subtype
    let Z₁ := (Z F₀ β).map (G₀ L S).subtype
    ∃ N : Subgroup G, Z₁<N ∧ N≤Q₁ ∧
      parabolic L S 1≤normalizer (N:Set G) ∧
      (∀ M : Subgroup G, Z₁≤M → M≤N →
        parabolic L S 1≤normalizer (M:Set G) → M=Z₁ ∨ M=N) ∧
      (N=Q₁ ∨ ∃ g : G₀ L S, g∈graphLocalGroup F₀ α ∧ g • β=t ∧
        let N' := N.map (MulAut.conj (g:G)).toMonoidHom
        let A := N⊓Q₀
        let A' := N'⊓Q₀
        let W := A⊔A'
        Disjoint N N' ∧ A≤centralizer (A':Set G) ∧ IsMulCommutative W ∧
          Nat.card W=Nat.card (K true)^4 ∧ W⊓D₀=Z₀ ∧ W⊔D₀=Q₀ ∧
          enlargedEndpoint L S 0≤normalizer (W:Set G)) := by
  obtain ⟨N,hZN,hNQ,hPN,hmin,_⟩ :=
    original_bTwo_10_10_minimal_section_intersections h hc hne hb hβu ht htne K e hK hD
  refine ⟨N,hZN,hNQ,hPN,hmin,?_⟩
  by_cases he : N=(parabolic L S 1).pCoreIn 2
  · exact Or.inl he
  exact Or.inr (original_bTwo_proper_section_abelian_supplement h hc hne hb hβu ht htne
    K e hK hD N (lt_of_le_of_ne hNQ he) hZN hPN)

