/-- The p.165 minimal interval with both sharp indices. Any proper choice
forces equal fields; the small central-section alternative is discharged. -/
theorem original_bTwo_10_10_sharp_minimal_section
    (h : HypothesisF11 L S) {u t : Vertex F₀}
    (hc : IsCriticalPair F₀ α u) (hne : ⁅Z F₀ α,Z F₀ u⁆≠⊥)
    (hb : b F₀=2) (hβu : (graph F₀).Adj β u)
    (ht : (graph F₀).Adj α t) (htne : t≠β)
    (K : Bool → Type*) [∀ i, Field (K i)] [∀ i, Finite (K i)] [∀ i, CharP (K i) 2]
    (e : ∀ i, (family L i⧸pCore 2 (family L i))≃*PSL(2,K i))
    (hK : 2<Nat.card (K true))
    (hD : (parabolic L S 1).pCoreIn 2⊓(Q F₀ t).map (G₀ L S).subtype≠(Z F₀ α).map (G₀ L S).subtype) :
    let Q₁ := (parabolic L S 1).pCoreIn 2
    let Z₁ := (Z F₀ β).map (G₀ L S).subtype
    parabolic L S 1 ≤ normalizer (Z₁ : Set G) ∧
      ∃ N : Subgroup G, Z₁ < N ∧ N ≤ Q₁ ∧
        parabolic L S 1 ≤ normalizer (N : Set G) ∧
        (∀ M : Subgroup G, Z₁ ≤ M → M ≤ N →
          parabolic L S 1 ≤ normalizer (M : Set G) → M=Z₁ ∨ M=N) ∧
        (N=Q₁ ∨ (Nat.card (K false)=Nat.card (K true) ∧
          Z₁.relIndex N=Nat.card (K true)^2 ∧
          N.relIndex Q₁=Nat.card (K true)^2)) := by
  obtain ⟨hPZ,N,hZN,hNQ,hPN,hmin,_⟩ :=
    original_bTwo_10_10_minimal_section_bounds h hc hne hb hβu ht htne K e hK hD
  refine ⟨hPZ,N,hZN,hNQ,hPN,hmin,?_⟩
  by_cases he : N=(parabolic L S 1).pCoreIn 2
  · exact Or.inl he
  right
  have hh := original_bTwo_nonbinary_beta_proper_section_sharp h hc hne hb hβu ht htne
    K e hK hD N (lt_of_le_of_ne hNQ he) hZN hPN
  exact ⟨hh.1,hh.2.1,hh.2.2⟩



