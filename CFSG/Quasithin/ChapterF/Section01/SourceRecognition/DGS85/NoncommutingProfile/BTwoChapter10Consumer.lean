/-- The first p.165 chief-section construction, retaining the literal beta
stabilizer quotient and its conjugation action. -/
theorem original_bTwo_10_10_minimal_normal_section
    (h : HypothesisF11 L S)
    (hZQ : Z F₀ β < Q F₀ β) :
    ∃ N : Subgroup (stabilizer F₀ β),
      ∃ _hZN : (Z F₀ β).subgroupOf (stabilizer F₀ β) < N,
      ∃ _hNQ : N ≤ (Q F₀ β).subgroupOf (stabilizer F₀ β),
      ∃ hAN : (⊤ : Subgroup (stabilizer F₀ β)) ≤
        normalizer (N : Set (stabilizer F₀ β)),
      ∃ hNnormal : (((Z F₀ β).subgroupOf (stabilizer F₀ β)).subgroupOf N).Normal,
        let _ := hNnormal
        ∃ f : (⊤ : Subgroup (stabilizer F₀ β)) →*
            MulAut (N ⧸ ((Z F₀ β).subgroupOf (stabilizer F₀ β)).subgroupOf N),
          (∀ a : (⊤ : Subgroup (stabilizer F₀ β)), ∀ n : N,
            f a (QuotientGroup.mk'
              (((Z F₀ β).subgroupOf (stabilizer F₀ β)).subgroupOf N) n) =
              QuotientGroup.mk'
                (((Z F₀ β).subgroupOf (stabilizer F₀ β)).subgroupOf N)
                ⟨(a : stabilizer F₀ β) * (n : stabilizer F₀ β) *
                    (a : stabilizer F₀ β)⁻¹,
                  (mem_normalizer_iff.mp (hAN a.property) n).mp n.property⟩) ∧
          ∀ K : Subgroup
              (N ⧸ ((Z F₀ β).subgroupOf (stabilizer F₀ β)).subgroupOf N),
            (∀ a n, n ∈ K → f a n ∈ K) → K = ⊥ ∨ K = ⊤ := by
  exact original_bTwo_minimal_normal_beta_section h hZQ

/- The literal p.165 quotient factorization for the selected chief section.
   The quotient is formed inside the actual beta core, while the normality
   instances are induced from the full finite beta stabilizer. -/
theorem original_bTwo_10_10_section_card_factorization
    (h : HypothesisF11 L S)
    (hZQ : Z F₀ β < Q F₀ β) :
    ∃ N : Subgroup (stabilizer F₀ β),
      ∃ _hZN : (Z F₀ β).subgroupOf (stabilizer F₀ β) < N,
      ∃ _hNQ : N ≤ (Q F₀ β).subgroupOf (stabilizer F₀ β),
      Nat.card ((Q F₀ β).subgroupOf (stabilizer F₀ β) ⧸
          ((Z F₀ β).subgroupOf (stabilizer F₀ β)).subgroupOf
            ((Q F₀ β).subgroupOf (stabilizer F₀ β))) =
        Nat.card ((Q F₀ β).subgroupOf (stabilizer F₀ β) ⧸
            N.subgroupOf ((Q F₀ β).subgroupOf (stabilizer F₀ β))) *
          Nat.card ((N.subgroupOf ((Q F₀ β).subgroupOf (stabilizer F₀ β))) ⧸
            (((Z F₀ β).subgroupOf (stabilizer F₀ β)).subgroupOf
              ((Q F₀ β).subgroupOf (stabilizer F₀ β))).subgroupOf
                (N.subgroupOf ((Q F₀ β).subgroupOf (stabilizer F₀ β)))) := by
  let H := reduced_triple h
  let _ : ∀ i, Finite (F₀ i) := finite_endpoints H
  let : Finite (stabilizer F₀ β) := (graph_locally_finite H β).1
  let Q₀ : Subgroup (stabilizer F₀ β) :=
    (Q F₀ β).subgroupOf (stabilizer F₀ β)
  let Z₀ : Subgroup (stabilizer F₀ β) :=
    (Z F₀ β).subgroupOf (stabilizer F₀ β)
  obtain ⟨N, hZN, hNQ, hAN, hNnormal, _⟩ :=
    original_bTwo_minimal_normal_beta_section h hZQ
  have hQtop : Q₀ ≤ (⊤ : Subgroup (stabilizer F₀ β)) := le_top
  have hQnormal : Q₀.Normal := by
    apply normal_subgroupOf_iff_le_normalizer (Q_le_stabilizer F₀ β) |>.mpr
    exact CommutingNontrivial.stabilizer_normalizes_Q F₀ β
  let _ : Q₀.Normal := hQnormal
  have hZnormal : Z₀.Normal := by
    apply normal_subgroupOf_iff_le_normalizer (Z_le_stabilizer F₀ β) |>.mpr
    exact (normal_subgroupOf_iff_le_normalizer (Z_le_stabilizer F₀ β)).mp
      (Z_normal _ β)
  let _ : Z₀.Normal := hZnormal
  have hNtop : normalizer (N : Set (stabilizer F₀ β)) = ⊤ :=
    top_unique hAN
  have hNnormal' : N.Normal := normalizer_eq_top_iff.mp hNtop
  let _ : N.Normal := hNnormal'
  have hzq : Z F₀ β ≤ Q F₀ β :=
    (source_Z_Q_U H β).1.trans (map_subtype_le _)
  have hZQ' : Z₀ ≤ Q₀ := by
    exact subgroupOf_mono (stabilizer F₀ β) hzq
  have hNQ' : N ≤ Q₀ := hNQ
  have hZN' : Z₀ ≤ N := hZN.le
  have hZNQ : Z₀.subgroupOf Q₀ ≤ N.subgroupOf Q₀ :=
    subgroupOf_mono Q₀ hZN'
  let hZQnormal : (Z₀.subgroupOf Q₀).Normal :=
    (normal_subgroupOf_iff_le_normalizer hZQ').mpr le_normalizer_of_normal
  let hNQnormal : (N.subgroupOf Q₀).Normal :=
    (normal_subgroupOf_iff_le_normalizer hNQ').mpr le_normalizer_of_normal
  refine ⟨N, hZN, hNQ, ?_⟩
  exact quotient_card_factorization_of_le
    (Z₀.subgroupOf Q₀) (N.subgroupOf Q₀) hZNQ

