module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.NoncommutingProfile.BTwoCentralSource
public import Theory.GroupTheory.CommutatorPreimageFrattini

/-!
# The elementary seed section in central 10.7

Inside Q_alpha form the literal subgroup generated by V_beta intersect
Q_alpha, V_(alpha-1) intersect Q_alpha, and D_alpha. The earlier 7.4
commutator bounds put squares of the first two factors in their neighboring
centers. Relative core normality puts their mutual commutator in D_alpha.
The normal denominator then contains the whole seed's Frattini subgroup.

This proves the elementary-module starting point of 10.7. It does not
identify this seed with Q_alpha: the subsequent nontrivial-action,
representation and coprime-action arguments are still required.
Source: DGS, *Groups and Graphs* (1985), proof of 10.7, pp.158--159.
-/

@[expose] public noncomputable section
open Subgroup
open scoped Pointwise commutatorElement
namespace CFSG.Quasithin.ChapterF.Source.DGS85.NoncommutingProfile
open Subgroup.CosetGeometry.RankTwo Theory.GroupTheory.AmalgamGraph Noncommuting
variable {G : Type*} [Group G]

private theorem squares_mem_of_generators (J D : Subgroup G) (X : Set G)
    (hgen : J = closure X) (hsq : ∀ x ∈ X, x ^ 2 ∈ D)
    (hc : ⁅J,J⁆ ≤ D) : ∀ x ∈ J, x ^ 2 ∈ D := by
  intro x hx
  rw [hgen] at hx
  induction hx using Subgroup.closure_induction with
  | mem x hx => exact hsq x hx
  | one => simp
  | inv x _ ih => simpa only [inv_pow] using D.inv_mem ih
  | mul x y hx hy ihx ihy =>
    have hid : (x*y)^2 = x^2*⁅x⁻¹,y⁆*y^2 := by
      simp [commutatorElement_def,pow_two,mul_assoc]
    rw [hid]
    exact D.mul_mem (D.mul_mem ihx (hc (commutator_mem_commutator
      (J.inv_mem (hgen ▸ hx)) (hgen ▸ hy)))) ihy

variable {P : Fin 2 → Subgroup G} {B : Subgroup G}

/-- The earlier radius-one commutator bound also controls all its squares,
since the literal radius-one span is generated by elementary centers. -/
theorem bTwo_radius_one_squares (h : LocallyRankOneTriple P B)
    (hS : ∀ x, Stellmacher.IsSylowSubgroupIn (Q (family P) x) (U (family P) x))
    (hb : b (family P) = 2) (m : Vertex (family P))
    (hc : ⁅V (family P) m 1,Q (family P) m⁆ ≤ Z (family P) m) :
    ∀ x ∈ V (family P) m 1, x ^ 2 ∈ Z (family P) m := by
  have hV := graph_V_le_Q_of_short h hS m (i := 1) (by rw [hb]; decide)
  let X : Set G := ⋃ i : ball (family P) m 1, (Z (family P) i.val : Set G)
  have hgen : V (family P) m 1 = closure X := by
    calc
      _ = ⨆ i : ball (family P) m 1, Z (family P) i.val := by simp only [V,iSup_subtype]
      _ = closure X := iSup_eq_closure _
  apply squares_mem_of_generators _ _ X hgen _ ((commutator_mono le_rfl hV).trans hc)
  intro x hx
  obtain ⟨i,hi⟩ := Set.mem_iUnion.mp hx
  let := graph_Z_elementary h i.val
  rw [elemPow_eq_one_of_isElementaryAbelian x hi]
  exact one_mem _

/-- The literal V in the proof of 10.7 before proving V=Q_alpha. -/
def centralSeed (F : Bool → Subgroup G) (v m t : Vertex F) : Subgroup G :=
  ((V F m 1 ⊓ Q F v) ⊔ (V F t 1 ⊓ Q F v)) ⊔ D F m t

/-- Relative normalization and the earlier 7.4 bounds put Phi(V) in the
literal D. The seed itself is not assumed to be the whole core. -/
theorem bTwo_central_seed_frattini (h : LocallyRankOneTriple P B)
    (hS : ∀ x, Stellmacher.IsSylowSubgroupIn (Q (family P) x) (U (family P) x))
    (hb : b (family P) = 2) {v m t : Vertex (family P)}
    (hm : (graph (family P)).Adj v m) (ht : (graph (family P)).Adj v t)
    (hDQ : D (family P) m t ≤ Q (family P) v)
    (hn : Q (family P) v ≤ normalizer (D (family P) m t : Set G))
    (hZm : Z (family P) m ≤ D (family P) m t)
    (hZt : Z (family P) t ≤ D (family P) m t)
    (hcm : ⁅V (family P) m 1,Q (family P) m⁆ ≤ Z (family P) m)
    (hct : ⁅V (family P) t 1,Q (family P) t⁆ ≤ Z (family P) t) :
    (frattini (centralSeed (family P) v m t)).map (centralSeed (family P) v m t).subtype ≤
      D (family P) m t := by
  let := finite_endpoints h
  let F := family P
  let A := V F m 1 ⊓ Q F v
  let C := V F t 1 ⊓ Q F v
  let D₀ := D F m t
  let J := centralSeed F v m t
  have hV (x : Vertex F) : V F x 1 ≤ Q F x :=
    graph_V_le_Q_of_short h hS x (by rw [hb]; decide)
  have hJQ : J ≤ Q F v := sup_le (sup_le inf_le_right inf_le_right) hDQ
  have hAJ : A ≤ J := le_sup_left.trans le_sup_left
  have hCJ : C ≤ J := le_sup_right.trans le_sup_left
  have hnorm (x : Vertex F) : stabilizer F x ≤ normalizer (Q F x : Set G) :=
    (stabilizer F x).le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image _ (pCore 2 _))
  have hQm : Q F v ≤ stabilizer F m :=
    (source_Z_Q_U h v).2.trans ((ballKernel_one_le_edge F hm).trans inf_le_right)
  have hQt : Q F v ≤ stabilizer F t :=
    (source_Z_Q_U h v).2.trans ((ballKernel_one_le_edge F ht).trans inf_le_right)
  have hAA : ⁅A,A⁆ ≤ D₀ :=
    ((commutator_mono inf_le_left (inf_le_left.trans (hV m))).trans hcm).trans hZm
  have hCC : ⁅C,C⁆ ≤ D₀ :=
    ((commutator_mono inf_le_left (inf_le_left.trans (hV t))).trans hct).trans hZt
  have hAC : ⁅A,C⁆ ≤ D₀ := le_inf
    ((commutator_mono (inf_le_left.trans (hV m)) le_rfl).trans
      (le_normalizer_iff_commutator_le_left.mp (inf_le_right.trans (hQm.trans (hnorm m)))))
    ((commutator_mono le_rfl (inf_le_left.trans (hV t))).trans
      (le_normalizer_iff_commutator_le_right.mp (inf_le_right.trans (hQt.trans (hnorm t)))))
  have hUD (U : Subgroup G) (hU : U ≤ J) : ⁅U,D₀⁆ ≤ D₀ :=
    le_normalizer_iff_commutator_le_right.mp (hU.trans (hJQ.trans hn))
  have expand (U : Subgroup G) (ha : ⁅A,U⁆ ≤ D₀) (hc : ⁅C,U⁆ ≤ D₀)
      (hd : ⁅D₀,U⁆ ≤ D₀) : ⁅J,U⁆ ≤ D₀ :=
    commutator_sup_le_of_relative_normal (Q F v) (A ⊔ C) D₀ U D₀ hn
      (sup_le inf_le_right inf_le_right) hDQ
      (commutator_sup_le_of_relative_normal (Q F v) A C U D₀ hn
        inf_le_right inf_le_right ha hc) hd
  have hJA := expand A hAA (by rwa [commutator_comm])
    (by rw [commutator_comm]; exact hUD A hAJ)
  have hJC := expand C hAC hCC (by rw [commutator_comm]; exact hUD C hCJ)
  have hJJ : ⁅J,J⁆ ≤ D₀ := expand J
    (by rw [commutator_comm]; exact hJA) (by rw [commutator_comm]; exact hJC)
    (by rw [commutator_comm]; exact hUD J le_rfl)
  let X : Set G := ((A : Set G) ∪ (C : Set G)) ∪ (D₀ : Set G)
  have hgen : J = closure X := by
    rw [show closure X = (A ⊔ C) ⊔ D₀ from by
      simp only [X,Subgroup.closure_union,Subgroup.closure_eq]]
    rfl
  have hsq : ∀ x ∈ J, x ^ 2 ∈ D₀ := squares_mem_of_generators J D₀ X hgen (by
    intro x hx
    rcases hx with (hx | hx) | hx
    · exact hZm (bTwo_radius_one_squares h hS hb m hcm x hx.1)
    · exact hZt (bTwo_radius_one_squares h hS hb t hct x hx.1)
    · exact D₀.pow_mem hx 2) hJJ
  let : Finite J := Finite.of_injective
    (inclusion (hJQ.trans (Q_le_stabilizer F v))) (inclusion_injective _)
  have hp : IsPGroup 2 J := (isPGroup_pCoreIn 2 (stabilizer F v)).to_le hJQ
  change (frattini J).map J.subtype ≤ D₀
  rw [map_le_iff_le_comap,hp.frattini_eq_closure_squares]
  apply (closure_le _).mpr
  rintro x ⟨a,rfl⟩
  exact hsq a a.property

variable {k W : Type*} [Field k] [Finite k] [CharP k 2]
  [AddCommGroup W] [Module (ZMod 2) W]

/-- The earlier natural action, the central neighbor, and the actual 7.4
commutator bound construct the elementary seed quotient of 10.7. All D,
normality, opposite-neighbor and square-control premises are discharged. -/
theorem BTwoCenterActionData.central_seed_elementary (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hSyl : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    (hb : b (family P) = 2) {v m w t : Vertex (family P)}
    (c : BTwoCenterActionData (family P) v m w k W)
    (hactor : c.actor = graphLocalGroup (family P) v)
    (hcentral : Z (family P) m ≤ centerIn (graphLocalGroup (family P) m))
    (ht : (graph (family P)).Adj v t) (hne : t ≠ m)
    (hcm : ⁅V (family P) m 1,Q (family P) m⁆ ≤ Z (family P) m) :
    ∃ hN : ((D (family P) m t).subgroupOf (centralSeed (family P) v m t)).Normal,
      letI := hN
      IsElementaryAbelian 2 (centralSeed (family P) v m t ⧸
        (D (family P) m t).subgroupOf (centralSeed (family P) v m t)) := by
  let := finite_endpoints h
  let F := family P
  have hS := source_kernel_sylow h hB hSyl
  have hω := c.omega_eq_bot_of_central_neighbor h hB hSyl hactor hcentral
  obtain ⟨g,hg,hDQ,hn,_,hspan,_,_⟩ := c.central_D_structure h hS hb hω ht hne
  have hZD : Z F v ≤ D F m t := hspan ▸ le_sup_left
  have hZm := center_le_of_central_neighbor h hB hSyl c.middle hcentral
  have hgv : (g : G) • v = v := c.actor_le g.property
  have hZt : Z F t ≤ Z F v := by
    have hh := map_mono (f := (MulAut.conj (g : G)).toMonoidHom) hZm
    rwa [←Z_translate,←Z_translate,hg,hgv] at hh
  have hct : ⁅V F t 1,Q F t⁆ ≤ Z F t := by
    have hh := map_mono (f := (MulAut.conj (g : G)).toMonoidHom) hcm
    rwa [map_commutator,←V_translate,←Q_translate,←Z_translate,hg] at hh
  have hnQ := c.core_le.trans hn
  have hphi := bTwo_central_seed_frattini h hS hb c.middle ht hDQ hnQ
    (hZm.trans hZD) (hZt.trans hZD) hcm hct
  let J := centralSeed F v m t
  have hJQ : J ≤ Q F v := sup_le (sup_le inf_le_right inf_le_right) hDQ
  have hN : ((D F m t).subgroupOf J).Normal :=
    (normal_subgroupOf_iff_le_normalizer (show D F m t ≤ J from le_sup_right)).mpr
      (hJQ.trans hnQ)
  refine ⟨hN,?_⟩
  let := hN
  let : Finite J := Finite.of_injective
    (inclusion (hJQ.trans (Q_le_stabilizer F v))) (inclusion_injective _)
  have hp : IsPGroup 2 J := (isPGroup_pCoreIn 2 (stabilizer F v)).to_le hJQ
  exact elementary_quotient_of_frattini_le hp ((D F m t).subgroupOf J)
    (map_le_iff_le_comap.mp hphi)

namespace Reduction
open DGS85.Reduction
variable {L : Fin 2 → Subgroup G} {S : Subgroup G}
local notation "F" => reducedFamily L S
local notation "α" => base F false
local notation "β" => base F true
variable {k₁ W₁ : Type*} [Field k₁] [Finite k₁] [CharP k₁ 2]
  [AddCommGroup W₁] [Module (ZMod 2) W₁]
local instance {K : Type*} [Field K] [CharP K 2] : Algebra (ZMod 2) K := ZMod.algebra K 2

/-- The original marked source supplies the elementary 10.7 seed quotient.
Centrality is proved by 10.6; the one remaining radius-one commutator premise
is exactly the earlier 7.4(d) conclusion, with its original Q and Z. -/
theorem original_bTwo_seed_elementary_of_center_family
    (h : HypothesisF11 L S) (hb : b F = 2) {u t : Vertex F}
    (c : BTwoCenterActionData F α β u k W)
    (hactor : c.actor = graphLocalGroup F α)
    (E : W ≃ₗ[ZMod 2] (Fin 2 → k)) (E₁ : W₁ ≃ₗ[ZMod 2] (Fin 2 → k₁))
    (hc : IsCriticalPair F α u) (hne : ⁅Z F α,Z F u⁆ ≠ ⊥)
    (hnot : ∀ y, (graph F).Adj y α →
      ¬ stabilizer F α ≤ normalizer ((Q F y ⊓ Q F α : Subgroup (G₀ L S)) : Set (G₀ L S)))
    (hcenters : ∀ y, (graph F).Adj y α → IsCriticalPair F β y →
      ⁅Z F β,Z F y⁆ ≠ ⊥ → Nonempty (BTwoCenterActionData F β α y k₁ W₁))
    (ht : (graph F).Adj α t) (htne : t ≠ β)
    (hcomm : ⁅V F β 1,Q F β⁆ ≤ Z F β) :
    ∃ hN : ((D F β t).subgroupOf (centralSeed F α β t)).Normal,
      letI := hN
      IsElementaryAbelian 2 (centralSeed F α β t ⧸ (D F β t).subgroupOf (centralSeed F α β t)) := by
  have hcentral := original_bTwo_center_central_of_center_family h hb c E E₁ hc hne hnot hcenters
  exact c.central_seed_elementary (reduced_triple h) (reduced_borel_core_sylow h)
    (reduced_vertex_sylow h) hb hactor hcentral ht htne hcomm

end Reduction
end CFSG.Quasithin.ChapterF.Source.DGS85.NoncommutingProfile
