module
public import Theory.GroupTheory.WeakBNPair.RegularTree.ApartmentPaths
public import Theory.GroupTheory.Amalgam.RankTwoCompletion.Tree
public import Theory.GroupAction.RankTwoCosetGeometry.Valence

/-!
# The marked apartment quotient of the universal amalgam

Use the actual universal completion and its proved coset tree. The relation is
literally generated by length-`2n` apartment paths, where `n = s - 1`, and the
normal subgroup is the kernel of the induced action on its classes. Finite
original endpoint groups, apartment valence two and coverage of the `s`-paths
prove finiteness of this quotient, without assuming the completion finite.

Separation below `2n` and faithfulness of the original tree action make the
quotient injective on both endpoints. Separation also proves the exact overlap
equation, a conclusion not implied by those two injectivity assertions alone.
The constructed completion and amalgam isomorphism use the same quotient map
on the original left, right and whole middle groups, with both squares proved.

This is a conditional part of the geometric construction, not (14.19) or
Theorem D: Chapter 14 must still produce the chosen apartment and prove its
uniqueness and exchange, (3.6) must supply short-distance separation, and (3.7)
must construct the marked BN-pair and its standard-parabolic equations.

Source: Delgado--Goldschmidt--Stellmacher, *Groups and Graphs* (1985),
Part II, (3.5)--(3.7), printed pp.75--80; Chapter 14, printed pp.208--224.
The preceding local profiles and the reduced-to-original transport remain with
their source assembly owners. The supplied amalgam's maps are retained exactly.
-/

@[expose] public section
namespace CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.ApartmentExchange
open Theory.GroupTheory
open Theory.GroupTheory.WeakBNPair.RegularTree
open Subgroup.CosetGeometry.RankTwo
open RankTwoAmalgam
universe u
variable {L B R : Type u} [Group L] [Group B] [Group R]
variable (α : RankTwoAmalgam L B R)

abbrev SourceVertex := Vertex (Universal.cosetFamily α)
abbrev sourceGraph := graph (Universal.cosetFamily α)

theorem source_action (g : α.Universal) {a b : SourceVertex α}
    (h : (sourceGraph α).Adj a b) : (sourceGraph α).Adj (g • a) (g • b) :=
  (Subgroup.CosetGeometry.translationGraphIso (Universal.cosetFamily α) g).toHom.map_adj h

variable (T : Set (SourceVertex α)) (n : ℕ)

abbrev sourceRelation := apartmentSetoid (X := α.Universal) (sourceGraph α) T n

/-- The actual kernel of the action on the apartment equivalence classes. -/
def kernel : Subgroup α.Universal :=
  quotientKernel (sourceRelation α T n) (apartmentSetoid_invariant (source_action α))

instance kernel_normal : (kernel α T n).Normal :=
  inferInstanceAs (quotientKernel (sourceRelation α T n)
    (apartmentSetoid_invariant (source_action α))).Normal

/-- The group quotient is of the potentially infinite universal completion. -/
abbrev QuotientGroup := α.Universal ⧸ kernel α T n

def quotientMap : α.Universal →* QuotientGroup α T n :=
  _root_.QuotientGroup.mk' (kernel α T n)

def leftMap : L →* QuotientGroup α T n := (quotientMap α T n).comp (Universal.left α)
def rightMap : R →* QuotientGroup α T n := (quotientMap α T n).comp (Universal.right α)
def middleMap : B →* QuotientGroup α T n := (leftMap α T n).comp α.left

theorem quotient_compatible : middleMap α T n = (rightMap α T n).comp α.right := by
  change (quotientMap α T n).comp ((Universal.left α).comp α.left) =
    (quotientMap α T n).comp ((Universal.right α).comp α.right)
  rw [Universal.compatible]

/-- The two marked endpoint images generate the quotient. -/
theorem quotient_generated : (leftMap α T n).range ⊔ (rightMap α T n).range = ⊤ := by
  change ((quotientMap α T n).comp (Universal.left α)).range ⊔
    ((quotientMap α T n).comp (Universal.right α)).range = ⊤
  rw [MonoidHom.range_comp, MonoidHom.range_comp, ← Subgroup.map_sup, Universal.generated]
  exact Subgroup.map_top_of_surjective _ (_root_.QuotientGroup.mk'_surjective _)

private theorem source_faithful
    (hcore : ((Universal.left α).range ⊓ (Universal.right α).range).normalCore = ⊥) :
    FaithfulSMul α.Universal (SourceVertex α) := by
  apply Subgroup.CosetGeometry.faithful_of_core_free
  simpa only [iInf_bool_eq, Universal.cosetFamily, Bool.false_eq_true,
    Bool.cond_false, Bool.cond_true, inf_comm] using hcore

/-- Finiteness of the original endpoints gives finite valences in their actual
universal tree. No finiteness of the universal completion is required. -/
theorem source_finite_valence [Finite L] [Finite R] (v : SourceVertex α) :
    ((sourceGraph α).neighborSet v).Finite := by
  have hf (i : Bool) : Finite (Universal.cosetFamily α i) := by
    cases i
    · exact Finite.of_surjective (Universal.left α).rangeRestrict
        (Universal.left α).rangeRestrict_surjective
    · exact Finite.of_surjective (Universal.right α).rangeRestrict
        (Universal.right α).rangeRestrict_surjective
  obtain ⟨g, hv⟩ := Subgroup.CosetGeometry.exists_smul_base (Universal.cosetFamily α) v
  have : Finite ((sourceGraph α).neighborSet (base (Universal.cosetFamily α) v.type)) := by
    have := hf v.type
    exact Finite.of_equiv _ (neighborEquivQuotient (Universal.cosetFamily α) v.type).symm
  have : Finite ((sourceGraph α).neighborSet
      (g • base (Universal.cosetFamily α) v.type)) :=
    Finite.of_equiv _ ((Subgroup.CosetGeometry.translationGraphIso
      (Universal.cosetFamily α) g).mapNeighborSet (base (Universal.cosetFamily α) v.type))
  rw [hv] at this
  exact Set.toFinite _

variable (hL : Function.Injective α.left) (hR : Function.Injective α.right)
include hL hR

/-- The source apartment extension constructs a finite quotient of the actual
universal amalgam. Separation is not needed just for finiteness. -/
theorem quotient_finite [Finite L] [Finite R]
    (hext : ApartmentExtension (X := α.Universal) (sourceGraph α) T n) :
    Finite (QuotientGroup α T n) := by
  have : Finite (Quotient (sourceRelation α T n)) :=
    finite_apartment_classes (Universal.cosetGraph_isTree α hL hR).connected
      (source_finite_valence α) hext (base (Universal.cosetFamily α) false)
  exact finite_quotient (apartmentSetoid_invariant (source_action α))

/-- Literal (3.5)--(3.6) application on the universal tree: valence two
inside the chosen apartment and coverage of the `s`-paths already force the
constructed group quotient to be finite. -/
theorem quotient_finite_of_cover [Finite L] [Finite R]
    (hdeg : TwoNeighborsIn (sourceGraph α) T) (hn : 0 < n)
    (hcover : ApartmentsCover (X := α.Universal) (sourceGraph α) T (n + 1)) :
    Finite (QuotientGroup α T n) :=
  quotient_finite α T n hL hR
    (apartmentExtension_of_cover (Universal.cosetGraph_isTree α hL hR).isAcyclic
      (source_action α) hdeg hn hcover)

variable
    (hsep : Separated (sourceRelation α T n) (sourceGraph α) (2 * n))
    (hn : 1 < n)
include hsep hn

/-- Both endpoint kernels are trivial, with the same quotient map. -/
theorem kernel_inf_endpoint
    (hcore : ((Universal.left α).range ⊓ (Universal.right α).range).normalCore = ⊥)
    (i : Bool) : kernel α T n ⊓ Universal.cosetFamily α i = ⊥ := by
  have := source_faithful α hcore
  simpa only [kernel, quotientMap, sourceRelation, base,
    Subgroup.CosetGeometry.stabilizer_base] using
    quotientKernel_inf_stabilizer (apartmentSetoid_invariant (source_action α))
      (Universal.cosetGraph_isTree α hL hR).connected (source_action α) hsep
      (by omega : 2 < 2 * n) (base (Universal.cosetFamily α) i)

/-- Separation also retains the whole Borel, not just injectivity on endpoints. -/
theorem quotient_overlap : (leftMap α T n).range ⊓ (rightMap α T n).range =
    (middleMap α T n).range := by
  have hm := map_stabilizer_inf (apartmentSetoid_invariant (source_action α))
    (Universal.cosetGraph_isTree α hL hR).connected (source_action α) hsep
    (by omega : 2 < 2 * n)
    (show (sourceGraph α).Adj (base (Universal.cosetFamily α) false)
      (base (Universal.cosetFamily α) true) from
      ⟨Bool.false_ne_true, Subgroup.CosetGeometry.incident_base _ _ _⟩)
  simp only [Subgroup.CosetGeometry.stabilizer_base] at hm
  change ((Universal.left α).range ⊓ (Universal.right α).range).map
    (quotientMap α T n) = (Universal.left α).range.map (quotientMap α T n) ⊓
      (Universal.right α).range.map (quotientMap α T n) at hm
  change ((quotientMap α T n).comp (Universal.left α)).range ⊓
      ((quotientMap α T n).comp (Universal.right α)).range = _
  rw [MonoidHom.range_comp, MonoidHom.range_comp, ← hm, Universal.overlap_eq α hL hR]
  exact (MonoidHom.range_comp (quotientMap α T n) ((Universal.left α).comp α.left)).symm

private theorem endpoint_quotient_injective
    (hcore : ((Universal.left α).range ⊓ (Universal.right α).range).normalCore = ⊥)
    (i : Bool) : Function.Injective (fun x : Universal.cosetFamily α i =>
      quotientMap α T n x) := by
  intro x y he
  apply Subtype.ext
  have hD : (x : α.Universal)⁻¹ * y ∈ kernel α T n :=
    _root_.QuotientGroup.eq.mp he
  have hP : (x : α.Universal)⁻¹ * y ∈ Universal.cosetFamily α i :=
    (Universal.cosetFamily α i).mul_mem
      ((Universal.cosetFamily α i).inv_mem x.property) y.property
  have hbot : (x : α.Universal)⁻¹ * y ∈ kernel α T n ⊓ Universal.cosetFamily α i :=
    ⟨hD, hP⟩
  rw [kernel_inf_endpoint α T n hL hR hsep hn hcore i] at hbot
  exact inv_mul_eq_one.mp hbot

variable
    (hcore : ((Universal.left α).range ⊓ (Universal.right α).range).normalCore = ⊥)
include hcore

theorem leftMap_injective : Function.Injective (leftMap α T n) := by
  intro x y he
  have h := endpoint_quotient_injective α T n hL hR hsep hn hcore false
    (a₁ := ⟨Universal.left α x, ⟨x, rfl⟩⟩) (a₂ := ⟨Universal.left α y, ⟨y, rfl⟩⟩) he
  exact Monoid.PushoutI.of_injective (Universal.structureMap_injective α hL hR) false
    (congrArg Subtype.val h)

theorem rightMap_injective : Function.Injective (rightMap α T n) := by
  intro x y he
  have h := endpoint_quotient_injective α T n hL hR hsep hn hcore true
    (a₁ := ⟨Universal.right α x, ⟨x, rfl⟩⟩) (a₂ := ⟨Universal.right α y, ⟨y, rfl⟩⟩) he
  exact Monoid.PushoutI.of_injective (Universal.structureMap_injective α hL hR) true
    (congrArg Subtype.val h)

/-- A genuine faithful completion of the original marked amalgam in the
constructed quotient, ready for subsequent BN-pair recognition. -/
def quotientCompletion : FaithfulCompletion α (G := QuotientGroup α T n) where
  left := leftMap α T n
  right := rightMap α T n
  compatible := quotient_compatible α T n
  left_injective := leftMap_injective α T n hL hR hsep hn hcore
  right_injective := rightMap_injective α T n hL hR hsep hn hcore
  middle_injective := (leftMap_injective α T n hL hR hsep hn hcore).comp hL
  generated := quotient_generated α T n

/-- Literal marked output: both original endpoint maps and the entire original
middle group are restricted from the very same quotient homomorphism. -/
noncomputable def markedIso :
    RankTwoAmalgam.Iso α
      (RankTwoAmalgam.ofSubgroups (leftMap α T n).range
        ((leftMap α T n).range ⊓ (rightMap α T n).range) (rightMap α T n).range
        inf_le_left inf_le_right) where
  left := MonoidHom.ofInjective (leftMap_injective α T n hL hR hsep hn hcore)
  right := MonoidHom.ofInjective (rightMap_injective α T n hL hR hsep hn hcore)
  middle := (MonoidHom.ofInjective (f := middleMap α T n)
    ((leftMap_injective α T n hL hR hsep hn hcore).comp hL)).trans
      (MulEquiv.subgroupCongr (quotient_overlap α T n hL hR hsep hn).symm)
  left_commutes b := by apply Subtype.ext; rfl
  right_commutes b := by
    apply Subtype.ext
    exact (DFunLike.congr_fun (quotient_compatible α T n) b).symm

/-- The left square uses the literal original endpoint map followed by `q`. -/
@[simp] theorem markedIso_left_apply (x : L) :
    ((markedIso α T n hL hR hsep hn hcore).left x : QuotientGroup α T n) =
      quotientMap α T n (Universal.left α x) := rfl

/-- The right square uses that same `q`, with the original orientation. -/
@[simp] theorem markedIso_right_apply (x : R) :
    ((markedIso α T n hL hR hsep hn hcore).right x : QuotientGroup α T n) =
      quotientMap α T n (Universal.right α x) := rfl

/-- The full original middle map survives, including its common image in
both endpoint subgroups. -/
@[simp] theorem markedIso_middle_apply (b : B) :
    ((markedIso α T n hL hR hsep hn hcore).middle b : QuotientGroup α T n) =
      quotientMap α T n (Universal.left α (α.left b)) := rfl

end CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.ApartmentExchange
