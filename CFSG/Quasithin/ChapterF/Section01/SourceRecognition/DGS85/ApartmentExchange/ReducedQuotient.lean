module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.ApartmentExchange.ReducedCartan
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.ApartmentExchange.PeriodicQuotient

/-!
# The finite split quotient of the actual reduced source pair

Starting from F.1.11, use the actual reduced overlap and its compatible
Cartan. Define N to be generated by that Cartan and the two chosen reflections.
The source Cartan construction discharges the Hall, abelian, normal two-group,
factorization and faithfulness premises. The periodic apartment construction
then gives the finite quotient, its two marked standard parabolics and full
Borel, the marked amalgam isomorphism, and splitness with saturation.

The remaining premises are the same-Cartan reflection/root choices, odd
s-path stabilizers, rooted s-path transitivity, chosen-apartment exchange and
quotient root signs. These are genuine Chapter 14 obligations, not a model
recognition assumption. In particular this conditional source application does
not prove (14.19), choose its exceptional exit, or prove Theorem D.

Source: DGS, *Groups and Graphs* (1985), Part II, (3.6)--(3.7), pp.77--80,
(14.1)--(14.2), pp.210--211, and Theorem D, p.224.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory RankTwoAmalgam
open Theory.GroupTheory.WeakBNPair.RegularTree Subgroup.CosetGeometry
open CFSG.Quasithin.ChapterF.Source
open CFSG.Quasithin.ChapterF.Source.SuzukiContainment
open CFSG.Quasithin.ChapterF.Source.DGS85.OriginalExtension
namespace CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.ApartmentExchange
namespace ReducedCartan
variable {G : Type*} [Group G] {L : Fin 2 → Subgroup G} {S : Subgroup G}
variable (h : HypothesisF11 L S) (c : CompatibleCartans L (reducedSylow L S))
variable (roots : Bool → LocalRootAction (X := (reducedAmalgam L S).Universal)
  (sourceGraph (reducedAmalgam L S)))

/-- The source N is generated by the actual Cartan and the chosen two reflections. -/
def apartmentGroup : Subgroup (reducedAmalgam L S).Universal :=
  Subgroup.closure ((cartan c : Set (reducedAmalgam L S).Universal) ∪
    Set.range fun i => (roots i).reflection)

/-- The chosen Cartan is contained in this same apartment group. -/
theorem cartan_le_apartmentGroup : cartan c ≤ apartmentGroup c roots := by
  intro x hx
  exact Subgroup.subset_closure (Or.inl hx)

/-- Both original reflection lifts lie in the constructed apartment group. -/
theorem reflection_mem_apartmentGroup (i : Bool) :
    (roots i).reflection ∈ apartmentGroup c roots :=
  Subgroup.subset_closure (Or.inr ⟨i, rfl⟩)

variable (hnormalizes : ∀ i, (roots i).reflection ∈
  Subgroup.normalizer (cartan c : Set (reducedAmalgam L S).Universal))

include hnormalizes in
/-- Normalization by both reflections makes the whole apartment group normalize K. -/
theorem apartmentGroup_normalizes : apartmentGroup c roots ≤
    Subgroup.normalizer (cartan c : Set (reducedAmalgam L S).Universal) := by
  apply (Subgroup.closure_le _).mpr
  rintro x (hx | ⟨i, rfl⟩)
  · exact (cartan c).le_normalizer hx
  · exact hnormalizes i

variable (ha : ∀ i, (roots i).a = base (Universal.cosetFamily (reducedAmalgam L S)) i)
variable (hb : ∀ i, (roots i).b = base (Universal.cosetFamily (reducedAmalgam L S)) (!i))
variable (hinv : ∀ i, (roots i).reflection * (roots i).reflection = 1)
variable (n : ℕ) (hn : 1 < n)
variable (hodd : ∀ {a b} (p : (sourceGraph (reducedAmalgam L S)).Walk a b),
  p.IsPath → p.length = n+1 →
    Odd (Nat.card (pathFixer (X := (reducedAmalgam L S).Universal) p)))
variable (htrans : BasedPathTransitive (X := (reducedAmalgam L S).Universal)
  (sourceGraph (reducedAmalgam L S)) (n+1))
variable (hexchange : ChosenApartmentExchange (X := (reducedAmalgam L S).Universal)
  (sourceGraph (reducedAmalgam L S))
    (cartanApartment (reducedAmalgam L S) (apartmentGroup c roots)) n)
variable (hsign : ∀ i x, x ∈ apartmentGroup c roots →
  (∀ r ∈ (roots i).root, quotientMap (reducedAmalgam L S)
    (cartanApartment (reducedAmalgam L S) (apartmentGroup c roots)) n (x⁻¹*r*x) ∈
    (originalMiddle (reducedAmalgam L S)).map (quotientMap (reducedAmalgam L S)
      (cartanApartment (reducedAmalgam L S) (apartmentGroup c roots)) n)) ∨
  (∀ r ∈ (roots i).root, quotientMap (reducedAmalgam L S)
    (cartanApartment (reducedAmalgam L S) (apartmentGroup c roots)) n
    (((roots i).reflection*x)⁻¹*r*((roots i).reflection*x)) ∈
      (originalMiddle (reducedAmalgam L S)).map (quotientMap (reducedAmalgam L S)
        (cartanApartment (reducedAmalgam L S) (apartmentGroup c roots)) n)))

/-- The finite quotient retains exactly two marked simple reflections, both original parabolic images and the whole original Borel. -/
abbrev finiteQuotient :=
  letI := (reduced_hypothesis h).finite_parabolic 0
  letI := (reduced_hypothesis h).finite_parabolic 1
  periodicFiniteQuotient (reducedAmalgam L S) roots ha hb
    (inclusion_injective (commonBorel_le_parabolic 0))
    (inclusion_injective (commonBorel_le_parabolic 1))
    (apartmentGroup c roots) (cartan c) (reflection_mem_apartmentGroup c roots)
    (cartan_le c) (apartmentGroup_normalizes c roots hnormalizes) le_rfl hinv n
    (cartan_le_apartmentGroup c roots) hn (cartan_hall c) hodd htrans hexchange
    (original_core_eq_bot h) hsign

/-- Both original reduced endpoint maps and the whole middle map commute with the geometric marking. -/
abbrev finiteMarkedIso :=
  letI := (reduced_hypothesis h).finite_parabolic 0
  letI := (reduced_hypothesis h).finite_parabolic 1
  periodicFiniteMarkedIso (reducedAmalgam L S) roots ha hb
    (inclusion_injective (commonBorel_le_parabolic 0))
    (inclusion_injective (commonBorel_le_parabolic 1))
    (apartmentGroup c roots) (cartan c) (reflection_mem_apartmentGroup c roots)
    (cartan_le c) (apartmentGroup_normalizes c roots hnormalizes) le_rfl hinv n
    (cartan_le_apartmentGroup c roots) hn (cartan_hall c) hodd htrans hexchange
    (original_core_eq_bot h) hsign

/-- The actual quotient is split and saturated: all original split-factorization premises are discharged from F.1.11. -/
def finiteSplitData : Theory.AlgebraicGroup.TitsSystem.SourceBinary.SplitData
    (finiteQuotient h c roots hnormalizes ha hb hinv n hn hodd htrans hexchange hsign).tits := by
  letI := (reduced_hypothesis h).finite_parabolic 0
  letI := (reduced_hypothesis h).finite_parabolic 1
  exact periodicFiniteSplitData (reducedAmalgam L S) roots ha hb
    (inclusion_injective (commonBorel_le_parabolic 0))
    (inclusion_injective (commonBorel_le_parabolic 1))
    (apartmentGroup c roots) (cartan c) (reflection_mem_apartmentGroup c roots)
    (cartan_le c) (apartmentGroup_normalizes c roots hnormalizes) le_rfl hinv n
    (cartan_le_apartmentGroup c roots) hn (cartan_hall c) hodd htrans hexchange
    (original_core_eq_bot h) hsign (twoGroup L S) (twoGroup_normalized h)
    (twoGroup_isTwo h) (cartan_abelian h c) (factorization c)

end ReducedCartan
end CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.ApartmentExchange
