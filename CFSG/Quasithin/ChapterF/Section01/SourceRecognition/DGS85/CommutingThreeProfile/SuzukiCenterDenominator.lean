module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingThreeProfile.SuzukiFaithfulCenterLayer
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.LocalStructure.SmallSuzukiEnlargement

/-!
# The geometric center is the fixed subgroup of the Suzuki star

Chapter 6 identifies the starred endpoint with the subgroup generated by
all Sylow two-subgroups of the full vertex stabilizer. A fixed vector in
the elementary span lies in the vertex core, hence in every vertex Sylow.
It centralizes each such Sylow and has square one, so belongs to its
omega-center and therefore to the geometric center Z. The converse uses
the earlier neighboring-center inclusion and common Sylow.

This proves C_V(star) = Z with the actual subgroup embeddings, for every
Suzuki parameter including Sz(2). In the binary case it does not identify
the larger fixed subgroup of the smaller source actor tilde L; that
separate argument in (12.6) is still required for the binary upper bound.
SuzukiCenterLayer applies the equality to the proved nonbinary fixed
quotient and its original conjugation action.

Source: Delgado--Goldschmidt--Stellmacher, Groups and Graphs (1985),
(6.1), (12.1)(e), (12.6), printed pp.118--119,178,183.
-/

@[expose] public noncomputable section
open Subgroup
open scoped MatrixGroups IsMulCommutative
namespace CFSG.Quasithin.ChapterF.Source.DGS85.CommutingThreeProfile.ReducedLayer
open Subgroup.CosetGeometry.RankTwo Reduction Theory.GroupTheory.AmalgamGraph
open BenderSuzuki.MatrixGroups
variable {G : Type*} [Group G] {L : Fin 2 → Subgroup G} {S : Subgroup G}

/-- The equality is inside the reduced completion, retaining the original star. -/
theorem source_suzuki_graphLocalGroup_eq_star (h : HypothesisF11 L S) (i : Bool) {m : ℕ}
    (e : (L (if i then 1 else 0) ⧸ pCore 2 (L (if i then 1 else 0))) ≃*
      SuzukiMatrixGroup m) :
    graphLocalGroup (reducedFamily L S) (base (reducedFamily L S) i) = star L S i := by
  apply map_injective (G₀ L S).subtype_injective
  rw [reduced_graphLocalGroup_image h]
  change family (enlargedEndpoint L S) i =
    ((starredParabolic L S (if i then 1 else 0)).subgroupOf (G₀ L S)).map (G₀ L S).subtype
  rw [map_subgroupOf_eq_of_le (star_le_completion _)]
  cases i
  · exact reduced_enlargedEndpoint_eq_starred_of_suzuki_all h 0 m e
  · exact reduced_enlargedEndpoint_eq_starred_of_suzuki_all h 1 m e

/-- The full Suzuki star fixes exactly the geometric center in V, also for Sz(2). -/
theorem source_suzuki_fixed_center_eq (h : HypothesisF11 L S) (i : Bool)
    (hb : 2 < b (reducedFamily L S)) {m : ℕ}
    (e : (L (if i then 1 else 0) ⧸ pCore 2 (L (if i then 1 else 0))) ≃*
      SuzukiMatrixGroup m)
    (T : Sylow 2 (star L S i))
    (hT : (T : Subgroup (star L S i)).map (star L S i).subtype =
      Q (reducedFamily L S) (base (reducedFamily L S) (!i)) ⊔
        Q (reducedFamily L S) (base (reducedFamily L S) i))
    (hzy : Z (reducedFamily L S) (base (reducedFamily L S) i) ≤
      Z (reducedFamily L S) (base (reducedFamily L S) (!i))) :
    let F := reducedFamily L S
    V F (base F i) 1 ⊓ centralizer (star L S i : Set (G₀ L S)) = Z F (base F i) := by
  let F := reducedFamily L S
  let v := base F i
  let P := stabilizer F v
  let : ∀ j, Finite (F j) := finite_endpoints (reduced_triple h)
  have hZ := fun w => (source_Z_Q_U (reduced_triple h) w).1
  let := V_elementary F (reduced_triple h).generate hZ (reduced_kernel_sylow h) hb v
  have hVQ := V_le_Q F (reduced_triple h).generate hZ (reduced_kernel_sylow h) hb v
  apply le_antisymm
  · intro z hz
    let R : Sylow 2 P := Classical.arbitrary _
    have hRstar : (R : Subgroup P).map P.subtype ≤ star L S i := by
      rw [←source_suzuki_graphLocalGroup_eq_star h i e]
      exact sylow_le_sylowGenerated P R
    have hpow : z ^ 2 = 1 := by
      exact congrArg Subtype.val (Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
        (IsElementaryAbelian.exponent_dvd_p 2 (V F v 1)) ⟨z,hz.1⟩)
    have ho : z ∈ omegaCenterIn ((R : Subgroup P).map P.subtype) :=
      (mem_omegaCenterIn_iff _ _).mpr
        ⟨pCoreIn_le_sylow P R (hVQ hz.1), centralizer_le hRstar hz.2, hpow⟩
    exact (le_iSup (fun R : Sylow 2 P =>
      omegaCenterIn ((R : Subgroup P).map P.subtype)) R) ho
  · exact le_inf (Z_le_V F v 1)
      (source_center_centralizes_star_of_neighbor_inclusion h i hzy T hT)

end CFSG.Quasithin.ChapterF.Source.DGS85.CommutingThreeProfile.ReducedLayer
