/-!
# The full Suzuki derived core

For the Suzuki vertex y adjacent to the linear vertex m, let K = G_y^(2)
and Y = V_y. The centralizer calculation puts Phi(K) inside G_m^(2).
The Suzuki residual fixes Phi(K), and irreducibility of Y/Z_y makes its
intersection with Y lie in Z_y. The two disjoint center lines at m then
force Phi(K) to centralize the other neighboring span V_x. Natural-center
detection puts it in G_x^(2). The actual common Sylow acts transitively
on the remaining neighbors of m, so Phi(K) fixes every radius-two ball
around a neighbor. Thus Phi(K) lies in G_m^(3), already identified with
V_x intersect V_y, and consequently lies in Z_y.

This removes the remaining derived-kernel term from the proved Suzuki-star
supplement: [Q_y,Q_y] = V_y. The supplement is generated by conjugates of
the elementary span W, so its squares also lie in V_y; together with the
Frattini bound on K this proves Phi(Q_y) = V_y. The derived identity is
transported by the original completion inclusion.

The original quotient markings, common Sylows, natural center and earlier
reciprocal commutator inputs remain explicit. This does not discharge
Suzuki selection, the binary alternatives, or the later irreducibility
of C_(Q_m)(G_m^(3))/W.

Source: Delgado--Goldschmidt--Stellmacher, Groups and Graphs (1985),
proof of (12.9), printed p.188, identity (3).
-/

public noncomputable section
open Subgroup
open scoped IsMulCommutative MatrixGroups commutatorElement
open BenderSuzuki.MatrixGroups
namespace CFSG.Quasithin.ChapterF.Source.DGS85.CommutingThreeProfile.ReducedLayer
open Subgroup.CosetGeometry.RankTwo Reduction CommutingNontrivial
variable {G : Type*} [Group G] {L : Fin 2 → Subgroup G} {S : Subgroup G}
/-- The actual neighboring second kernel has Frattini subgroup in the
linear third kernel and in the original geometric center Z_y. -/
theorem source_suzuki_neighbor_kernel_frattini
    {k : Type*} [Field k] [Finite k] [CharP k 2]
    (h : HypothesisF11 L S) (i : Bool) (hb3 : b (reducedFamily L S) = 3)
    {a x σ : Vertex (reducedFamily L S)}
    (hxadj : (graph (reducedFamily L S)).Adj (base (reducedFamily L S) i) x)
    (hne : x ≠ base (reducedFamily L S) (!i))
    (T R : Sylow 2 (star L S i))
    (hT : (T : Subgroup (star L S i)).map (star L S i).subtype =
      Q (reducedFamily L S) (base (reducedFamily L S) (!i)) ⊔
        Q (reducedFamily L S) (base (reducedFamily L S) i))
    (hR : (R : Subgroup (star L S i)).map (star L S i).subtype =
      Q (reducedFamily L S) x ⊔ Q (reducedFamily L S) (base (reducedFamily L S) i))
    (e : (L (if i then 1 else 0) ⧸ pCore 2 (L (if i then 1 else 0))) ≃*
      Matrix.SpecialLinearGroup (Fin 2) k)
    (hz : center (star L S i) = ⊥)
    (hcard : Nat.card (Z (reducedFamily L S) (base (reducedFamily L S) i)) = Nat.card k ^ 2)
    (hcardy : Nat.card (Z (reducedFamily L S) (base (reducedFamily L S) (!i))) = Nat.card k)
    (hzx : Z (reducedFamily L S) x ≤ Z (reducedFamily L S) (base (reducedFamily L S) i))
    (hzy : Z (reducedFamily L S) (base (reducedFamily L S) (!i)) ≤
      Z (reducedFamily L S) (base (reducedFamily L S) i))
    (hcommx : ⁅V (reducedFamily L S) x 1, Q (reducedFamily L S) x⁆ ≤ Z (reducedFamily L S) x)
    (hcommy : ⁅V (reducedFamily L S) (base (reducedFamily L S) (!i)) 1,
      Q (reducedFamily L S) (base (reducedFamily L S) (!i))⁆ =
        Z (reducedFamily L S) (base (reducedFamily L S) (!i)))
    (hcross : ⁅V (reducedFamily L S) (base (reducedFamily L S) (!i)) 1 ⊓ Q (reducedFamily L S) σ,
      V (reducedFamily L S) σ 1 ⊓ Q (reducedFamily L S) (base (reducedFamily L S) (!i))⁆ = ⊥)
    (hsmall : (Q (reducedFamily L S) σ).relIndex
      (V (reducedFamily L S) (base (reducedFamily L S) (!i)) 1) ≤ Nat.card k)
    (hactor : (Q (reducedFamily L S) (base (reducedFamily L S) i)).relIndex
      (V (reducedFamily L S) σ 1 ⊓ Q (reducedFamily L S) (base (reducedFamily L S) (!i))) = Nat.card k)
    {n : ℕ} (hn : 0 < n)
    (eSuz : (L (if !i then 1 else 0) ⧸ pCore 2 (L (if !i then 1 else 0))) ≃* SuzukiMatrixGroup n)
    (hfield : Nat.card k = 2 ^ (2 * n + 1))
    (Ry : Sylow 2 (star L S (!i)))
    (hRy : (Ry : Subgroup (star L S (!i))).map (star L S (!i)).subtype =
      Q (reducedFamily L S) (base (reducedFamily L S) i) ⊔
        Q (reducedFamily L S) (base (reducedFamily L S) (!i)))
    (hc : IsCriticalPair (reducedFamily L S) a (base (reducedFamily L S) (!i)))
    (hxa : (graph (reducedFamily L S)).Adj x a)
    (hmin : ∀ N : Subgroup (star L S i), N.Normal →
      N ≤ (Z (reducedFamily L S) (base (reducedFamily L S) i)).subgroupOf (star L S i) →
      N = ⊥ ∨ N = (Z (reducedFamily L S) (base (reducedFamily L S) i)).subgroupOf (star L S i))
    (hnat : Noncommuting.HasNaturalCenter (star L S i)
      (Z (reducedFamily L S) (base (reducedFamily L S) i))
      (Q (reducedFamily L S) (base (reducedFamily L S) i)))
    (hbranch : ⁅V (reducedFamily L S) x 1 ⊓ Q (reducedFamily L S) (base (reducedFamily L S) (!i)),
      V (reducedFamily L S) (base (reducedFamily L S) (!i)) 1⁆ ≠ ⊥) :
    let F := reducedFamily L S
    let m := base F i
    let y := base F (!i)
    let K := ballKernel F y 2
    (frattini K).map K.subtype ≤ ballKernel F m 3 ∧
      (frattini K).map K.subtype ≤ Z F y := by
  let F := reducedFamily L S
  let m := base F i
  let y := base F (!i)
  let A := star L S (!i)
  let K := ballKernel F y 2
  let Y := V F y 1
  let H := ballKernel F m 3
  let N := ballKernel F m 2
  let C := Q F m ⊓ centralizer (H : Set (G₀ L S))
  let E := (frattini K).map K.subtype
  let D := (pResidual 2 A).map A.subtype
  let Zy := Z F y
  let Zm := Z F m
  let : ∀ j, Finite (F j) := finite_endpoints (reduced_triple h)
  let : Finite A := Finite.of_injective (inclusion (star_le_stabilizer (!i)))
    (inclusion_injective _)
  let : Finite K := Finite.of_injective (inclusion (ballKernel_le_stabilizer F y 2))
    (inclusion_injective _)
  let : Finite C := Finite.of_injective
    (inclusion (show C ≤ stabilizer F m from inf_le_left.trans (Q_le_stabilizer F m)))
    (inclusion_injective _)
  have hb : 2 < b F := by change 2 < b (reducedFamily L S); omega
  have hadj : (graph F).Adj m y :=
    ⟨by change i ≠ !i; cases i <;> decide, Subgroup.CosetGeometry.incident_base F i (!i)⟩
  have hZ := fun v => (source_Z_Q_U (reduced_triple h) v).1
  have hq4 : 4 ≤ Nat.card k := by
    rw [hfield]
    exact Nat.pow_le_pow_right (by decide : 1 ≤ (2 : ℕ)) (by omega : 2 ≤ 2*n+1)
  have hKQ : K ≤ Q F y := source_suzuki_second_kernel_le_core h (!i) eSuz
    (by cases i <;> exact e) hq4 y
  have hpK : IsPGroup 2 K := (isPGroup_pCoreIn 2 _).to_le hKQ
  have hpC : IsPGroup 2 C := (isPGroup_pCoreIn 2 _).to_le (show C ≤ Q F m from inf_le_left)
  let : Fact (IsPGroup 2 K) := ⟨hpK⟩
  let : Fact (IsPGroup 2 C) := ⟨hpC⟩
  have hKQm : K ≤ Q F m := CommutingTrivial.two_subgroup_le_Q F m
    (reduced_kernel_sylow h m) hpK (ballKernel_succ_le F hadj.symm 1)
  have hQyB : Q F y ≤ star L S i := (le_sup_left.trans hT.ge).trans (map_subtype_le _)
  have hQxB : Q F x ≤ star L S i := (le_sup_left.trans hR.ge).trans (map_subtype_le _)
  have hQmA : Q F m ≤ A := (le_sup_left.trans hRy.ge).trans (map_subtype_le _)
  have hKY : K ≤ centralizer (Y : Set (G₀ L S)) :=
    (source_suzuki_second_kernel_centralizer h (!i) eSuz
      (by cases i <;> exact e) hq4 (by cases i <;> exact hQyB)
      (by cases i <;> exact hnat)).ge.trans inf_le_right
  have hfull := (source_suzuki_full_linear_third_kernel h i hb3 hxadj hne T R hT hR e hz
    hcard hcardy hzx hzy hcommx hcommy hcross hsmall hactor hn eSuz hfield Ry hRy hc hxa hmin hnat hbranch).1
  have hHY : H ≤ Y := hfull.le.trans inf_le_right
  have hKC : K ≤ C := le_inf hKQm (hKY.trans (centralizer_le hHY))
  have hphi := (source_suzuki_centralizer_second_kernel h i hb3 hxadj hne T R hT hR e hz
    hcard hcardy hzx hzy hcommx hcommy hcross hsmall hactor hn eSuz hfield Ry hRy hc hxa hmin hnat hbranch).2.2.1
  have hEN : E ≤ N := by
    have hh := map_mono (f := C.subtype) (frattini_map_le_of_isPGroup (p := 2) (inclusion hKC))
    simp only [map_map,subtype_comp_inclusion] at hh
    exact hh.trans hphi
  have hEK : E ≤ K := map_subtype_le _
  have hnormE : stabilizer F y ≤ normalizer (E : Set (G₀ L S)) :=
    (stabilizer_le_normalizer_ballKernel F y 2).trans
      (normalizer_le_normalizer_characteristic_image K (frattini K))
  have hfix : E ≤ centralizer (D : Set (G₀ L S)) :=
    (source_suzuki_neighbor_kernel_residual_action h i hb3 hxadj hne T R hT hR e hz
      hcard hcardy hzx hzy hcommx hcommy hcross hsmall hactor hn eSuz hfield Ry hRy hc hxa hmin hnat hbranch).choose_spec.choose_spec.2.2.1
  let : IsElementaryAbelian 2 Y := V_elementary F (reduced_triple h).generate hZ
    (reduced_kernel_sylow h) hb y
  let : Finite Y := Finite.of_injective (inclusion
    ((V_le_Q F (reduced_triple h).generate hZ (reduced_kernel_sylow h) hb y).trans
      (Q_le_stabilizer F y))) (inclusion_injective _)
  let : (Zy.subgroupOf Y).Normal := normal_of_isMulCommutative _
  have hZY : Zy ≤ Y := Z_le_V F y 1
  have hZA : Zy ≤ centralizer (A : Set (G₀ L S)) :=
    source_center_centralizes_star_of_neighbor_inclusion h (!i)
      (by cases i <;> exact hzy) Ry (by cases i <;> exact hRy)
  have hAY : A ≤ normalizer (Y : Set (G₀ L S)) :=
    (star_le_stabilizer (!i)).trans (stabilizer_normalizes_V F y 1)
  let B := Y ⊓ centralizer (D : Set (G₀ L S))
  have hAB : A ≤ normalizer (B : Set (G₀ L S)) :=
    (le_inf hAY ((A.le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image A (pResidual 2 A))).trans
        (normalizer_le_normalizer_centralizer D))).trans inf_normalizer_le_normalizer_inf
  have hZB : Zy ≤ B := le_inf hZY (hZA.trans (centralizer_le (map_subtype_le _)))
  have hB : B ≤ Zy := by
    obtain ⟨_,hYcard,_,ρ,_,hirr,_,hρ⟩ := source_suzuki_center_layer_of_intersection h i hb hxadj hne T R hT hR e hz
      hcard hcardy hzx hzy hcommx hcommy hcross hsmall hactor hn eSuz hfield Ry hRy hc hxa hmin hnat
    let := hirr
    rcases inf_or_sup_of_irreducible_quotient Y Zy B hZY inf_le_left
      (fun u => (originalActor (L := L) (S := S) (!i) u : G₀ L S))
      (QuotientGroup.mk' (pCore 2 (L (if !i then 1 else 0))))
      (QuotientGroup.mk'_surjective _)
      (fun u => hAY (originalActor (L := L) (S := S) (!i) u).property)
      (fun u => hAB (originalActor (L := L) (S := S) (!i) u).property) ρ hρ with hh | hh
    · exact hh
    · have hBY : B = Y := by simpa only [sup_eq_left.mpr hZB] using hh
      have hYfix : Y ≤ centralizer (D : Set (G₀ L S)) := hBY.ge.trans inf_le_right
      have hmove := (source_suzuki_product_and_intersection_commutator h i hb hxadj hne T R hT hR e hz
        hcard hcardy hzx hzy hcommx hcommy hcross hsmall hactor hn eSuz hfield Ry hRy hc hxa hmin).2.2.2.1
      have hYD : ⁅Y,D⁆ = Y := elementary_commutator_pResidual_eq_self A Y
        ((V_le_Q F (reduced_triple h).generate hZ (reduced_kernel_sylow h) hb y).trans (by
          rw [←star_core h (!i)]; exact pCoreIn_le 2 _)) hAY hmove.symm
      have hYbot : Y = ⊥ := hYD.symm.trans (commutator_eq_bot_iff_le_centralizer.mpr hYfix)
      have hcard1 : Nat.card Y = 1 := by rw [hYbot]; exact Subgroup.card_bot
      have hlarge : 1 < (2^(2*n+1))^5 := Nat.one_lt_pow (by decide)
        (Nat.one_lt_pow (by omega) (by decide))
      exact (hlarge.ne' (hYcard.symm.trans hcard1)).elim
  have hEY : E ⊓ Y ≤ Zy := (le_inf inf_le_right (inf_le_left.trans hfix)).trans hB
  have hdisj : Z F x ⊓ Zy = ⊥ := by
    apply bot_unique
    intro z hz'
    have hzQ : z ∈ Q F m := ((hZ m).trans (map_subtype_le _)) (hzy hz'.2)
    have hzA : z ∈ star L S i := ((le_sup_right.trans hT.ge).trans (map_subtype_le _)) hzQ
    have hzC : z ∈ centralizer (star L S i : Set (G₀ L S)) := by
      have hh : star L S i ≤ centralizer ({z} : Set (G₀ L S)) := by
        rw [star_three_core_generation h i hxadj hne T R hT hR]
        exact sup_le (sup_le
          (fun t ht => mem_centralizer_singleton_iff.mpr ((Z_centralizes_Q F y (hZ y) hz'.2) t ht))
          (fun t ht => mem_centralizer_singleton_iff.mpr ((Z_centralizes_Q F x (hZ x) hz'.1) t ht)))
          (fun t ht => mem_centralizer_singleton_iff.mpr ((Z_centralizes_Q F m (hZ m) (hzy hz'.2)) t ht))
      exact fun t ht => mem_centralizer_singleton_iff.mp (hh ht)
    have hh : (⟨z,hzA⟩ : star L S i) ∈ center (star L S i) :=
      mem_center_iff.mpr (fun a => Subtype.ext (hzC a a.property))
    have hh' : (⟨z,hzA⟩ : star L S i) = 1 := mem_bot.mp (hz ▸ hh)
    exact mem_bot.mpr (congrArg (fun u : star L S i => (u : G₀ L S)) hh')
  have hEQx : E ≤ Q F x := CommutingTrivial.two_subgroup_le_Q F x
    (reduced_kernel_sylow h x) (hpK.to_le hEK) (hEN.trans (ballKernel_succ_le F hxadj 1))
  have hXm : V F x 1 ≤ Q F m := V_le_neighbor_Q F (reduced_triple h).generate hZ
    (reduced_kernel_sylow h) hb hxadj.symm
  have ht := source_suzuki_third_kernel_layer h i hb hxadj hne T R hT hR e hz
    hcard hcardy hzx hzy hcommx hcommy hcross hsmall hactor hn eSuz hfield Ry hRy hc hxa hmin hnat
  have hZxY : Z F x ≤ Y := hzx.trans (ht.2.2.2.2.2.2.1.trans inf_le_right)
  have hEX : ⁅E,V F x 1⁆ = ⊥ := by
    have hZx : ⁅E,V F x 1⁆ ≤ Z F x := by
      rw [commutator_comm]
      exact (commutator_mono le_rfl hEQx).trans hcommx
    have hE : ⁅E,V F x 1⁆ ≤ E := le_normalizer_iff_commutator_le_left.mp
      ((hXm.trans hQmA).trans ((star_le_stabilizer (!i)).trans hnormE))
    exact bot_unique ((le_inf hZx ((le_inf hE (hZx.trans hZxY)).trans hEY)).trans hdisj.le)
  have hEKx : E ≤ ballKernel F x 2 :=
    (le_inf hEQx (commutator_eq_bot_iff_le_centralizer.mp hEX)).trans
      ((source_neighbor_core_span_centralizer h i hxadj.symm hQxB hnat).le.trans inf_le_right)
  have hEkernels (z : Vertex F) (hz : (graph F).Adj m z) : E ≤ ballKernel F z 2 := by
    by_cases hzy' : z = y
    · simpa only [hzy'] using hEK
    obtain ⟨g,hg,hgx⟩ := linear_common_sylow_transitive h i e T hT hxadj hz hne hzy'
    have hgy : g ∈ stabilizer F y := (sup_le (Q_le_stabilizer F y)
      (hQmA.trans (star_le_stabilizer (!i)))) hg
    have hh := map_mono (f := (MulAut.conj g).toMonoidHom) hEKx
    have hEg : E.map (MulAut.conj g).toMonoidHom = E :=
      mem_normalizer_iff_map_conj_eq.mp (hnormE hgy)
    rwa [hEg,←ballKernel_translate F,hgx] at hh
  have hEH : E ≤ H := by
    intro g hg z hz'
    have hdist : (graph F).edist m z ≠ ⊤ := ne_top_of_le_ne_top
      (by simp : ((3 : ℕ) : ℕ∞) ≠ ⊤) hz'
    obtain ⟨p,hp⟩ := SimpleGraph.exists_walk_of_edist_ne_top hdist
    have hlen : p.length ≤ 3 := ENat.natCast_le_natCast.mp (hp ▸ hz')
    cases p with
    | nil => exact ballKernel_le_stabilizer F m 2 (hEN hg)
    | @cons _ u _ hu p =>
      exact hEkernels u hu hg z (p.edist_le.trans
        (ENat.natCast_le_natCast.mpr (by have hh : p.length + 1 ≤ 3 := hlen; omega)))
  exact ⟨hEH,(le_inf le_rfl (hEH.trans hHY)).trans hEY⟩

/-- The actual Suzuki core has both derived and Frattini subgroup V_y,
with the original completion inclusion on the derived identity. -/
theorem source_suzuki_core_derived_eq_span
    {k : Type*} [Field k] [Finite k] [CharP k 2]
    (h : HypothesisF11 L S) (i : Bool) (hb3 : b (reducedFamily L S) = 3)
    {a x σ : Vertex (reducedFamily L S)}
    (hxadj : (graph (reducedFamily L S)).Adj (base (reducedFamily L S) i) x)
    (hne : x ≠ base (reducedFamily L S) (!i))
    (T R : Sylow 2 (star L S i))
    (hT : (T : Subgroup (star L S i)).map (star L S i).subtype =
      Q (reducedFamily L S) (base (reducedFamily L S) (!i)) ⊔
        Q (reducedFamily L S) (base (reducedFamily L S) i))
    (hR : (R : Subgroup (star L S i)).map (star L S i).subtype =
      Q (reducedFamily L S) x ⊔ Q (reducedFamily L S) (base (reducedFamily L S) i))
    (e : (L (if i then 1 else 0) ⧸ pCore 2 (L (if i then 1 else 0))) ≃*
      Matrix.SpecialLinearGroup (Fin 2) k)
    (hz : center (star L S i) = ⊥)
    (hcard : Nat.card (Z (reducedFamily L S) (base (reducedFamily L S) i)) = Nat.card k ^ 2)
    (hcardy : Nat.card (Z (reducedFamily L S) (base (reducedFamily L S) (!i))) = Nat.card k)
    (hzx : Z (reducedFamily L S) x ≤ Z (reducedFamily L S) (base (reducedFamily L S) i))
    (hzy : Z (reducedFamily L S) (base (reducedFamily L S) (!i)) ≤
      Z (reducedFamily L S) (base (reducedFamily L S) i))
    (hcommx : ⁅V (reducedFamily L S) x 1, Q (reducedFamily L S) x⁆ ≤ Z (reducedFamily L S) x)
    (hcommy : ⁅V (reducedFamily L S) (base (reducedFamily L S) (!i)) 1,
      Q (reducedFamily L S) (base (reducedFamily L S) (!i))⁆ =
        Z (reducedFamily L S) (base (reducedFamily L S) (!i)))
    (hcross : ⁅V (reducedFamily L S) (base (reducedFamily L S) (!i)) 1 ⊓ Q (reducedFamily L S) σ,
      V (reducedFamily L S) σ 1 ⊓ Q (reducedFamily L S) (base (reducedFamily L S) (!i))⁆ = ⊥)
    (hsmall : (Q (reducedFamily L S) σ).relIndex
      (V (reducedFamily L S) (base (reducedFamily L S) (!i)) 1) ≤ Nat.card k)
    (hactor : (Q (reducedFamily L S) (base (reducedFamily L S) i)).relIndex
      (V (reducedFamily L S) σ 1 ⊓ Q (reducedFamily L S) (base (reducedFamily L S) (!i))) = Nat.card k)
    {n : ℕ} (hn : 0 < n)
    (eSuz : (L (if !i then 1 else 0) ⧸ pCore 2 (L (if !i then 1 else 0))) ≃* SuzukiMatrixGroup n)
    (hfield : Nat.card k = 2 ^ (2 * n + 1))
    (Ry : Sylow 2 (star L S (!i)))
    (hRy : (Ry : Subgroup (star L S (!i))).map (star L S (!i)).subtype =
      Q (reducedFamily L S) (base (reducedFamily L S) i) ⊔
        Q (reducedFamily L S) (base (reducedFamily L S) (!i)))
    (hc : IsCriticalPair (reducedFamily L S) a (base (reducedFamily L S) (!i)))
    (hxa : (graph (reducedFamily L S)).Adj x a)
    (hmin : ∀ N : Subgroup (star L S i), N.Normal →
      N ≤ (Z (reducedFamily L S) (base (reducedFamily L S) i)).subgroupOf (star L S i) →
      N = ⊥ ∨ N = (Z (reducedFamily L S) (base (reducedFamily L S) i)).subgroupOf (star L S i))
    (hnat : Noncommuting.HasNaturalCenter (star L S i)
      (Z (reducedFamily L S) (base (reducedFamily L S) i))
      (Q (reducedFamily L S) (base (reducedFamily L S) i)))
    (hbranch : ⁅V (reducedFamily L S) x 1 ⊓ Q (reducedFamily L S) (base (reducedFamily L S) (!i)),
      V (reducedFamily L S) (base (reducedFamily L S) (!i)) 1⁆ ≠ ⊥)
    (hnear : ⁅V (reducedFamily L S) (base (reducedFamily L S) (!i)) 1 ⊓ Q (reducedFamily L S) x,
      V (reducedFamily L S) x 1 ⊓ Q (reducedFamily L S) (base (reducedFamily L S) (!i))⁆ = ⊥) :
    let F := reducedFamily L S
    let y := base F (!i)
    let Qy := Q F y
    let Y := V F y 1
    ⁅Qy,Qy⁆ = Y ∧ (frattini Qy).map Qy.subtype = Y ∧
    ⁅Qy.map (G₀ L S).subtype,Qy.map (G₀ L S).subtype⁆ = Y.map (G₀ L S).subtype := by
  let F := reducedFamily L S
  let m := base F i
  let y := base F (!i)
  let Qy := Q F y
  let Y := V F y 1
  let K := ballKernel F y 2
  let W := conjugateSpanBy (Y ⊓ Q F x) (stabilizer F m)
  let J := conjugateSpanBy W (star L S (!i))
  let : ∀ j, Finite (F j) := finite_endpoints (reduced_triple h)
  let : Finite Qy := Finite.of_injective (inclusion (Q_le_stabilizer F y)) (inclusion_injective _)
  have hpQ : IsPGroup 2 Qy := isPGroup_pCoreIn 2 _
  let : Fact (IsPGroup 2 Qy) := ⟨hpQ⟩
  have hb : 2 < b F := by change 2 < b (reducedFamily L S); omega
  have hq4 : 4 ≤ Nat.card k := by
    rw [hfield]
    exact Nat.pow_le_pow_right (by decide : 1 ≤ (2 : ℕ)) (by omega : 2 ≤ 2*n+1)
  have hKQ : K ≤ Qy := source_suzuki_second_kernel_le_core h (!i) eSuz
