module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingThreeProfile.GraphLayers

/-!
# The middle intersection in the commuting distance-three configuration

For x--m--y, put H = V_x intersect V_y. Actual common Sylows and the
centrality of Z_x and Z_y on Q_m place both centers in Z_m. The Chapter 8
commutator bounds then make Q_x and Q_y normalize H. The middle core
normalizes both spans because it fixes x and y. Thus H is normal in the
local group generated by these three cores, as in DGS85 (12.3)(b).

If that local group is transitive on the neighbors of m, its conjugates
of the radius-two ball at x cover the radius-three ball at m. Consequently
H is elementary abelian and H <= G_m^(3) and H <= Q_m. This is the forward
geometric containment used in (12.9)(c3); equality and the order q^3 are
not asserted. No tree assumption or identification Q = G^(1) is used.

Source: Delgado--Goldschmidt--Stellmacher, *Groups and Graphs* (1985),
Part II, (12.3), printed pp.179--180, and the intersection on p.188.
Common Sylows come from Chapter 6 and (12.1)(c); the three-core generation
identity on p.180 remains explicit and must still be assembled;
center centrality and the commutator bounds come from (8.1)(a), (8.7).
The final source application retains these earlier inputs explicitly.
-/

@[expose] public noncomputable section
open Subgroup
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterF.Source.DGS85.CommutingThreeProfile
open Subgroup.CosetGeometry.RankTwo
open Theory.GroupTheory.AmalgamGraph
variable {G : Type*} [Group G] (F : Bool → Subgroup G)

/-- Each generator of the neighboring center span is at distance at most two. -/
theorem V_le_neighbor_Q
    (hgen : F false ⊔ F true = ⊤)
    (hZ : ∀ v, Z F v ≤ omegaCenterIn (Q F v))
    (hSyl : ∀ v, ∃ T : Sylow 2 (U F v),
      (T : Subgroup (U F v)).map (U F v).subtype = Q F v)
    (hb : 2 < b F) {v w : Vertex F} (hadj : (graph F).Adj v w) :
    V F v 1 ≤ Q F w := by
  apply iSup_le
  intro z
  apply iSup_le
  intro hz
  apply Z_le_Q_of_dist_lt_b F hZ hSyl
  have hz' := (mem_ball_iff F hgen v z 1).mp hz
  have hw : (graph F).dist v w = 1 := SimpleGraph.dist_eq_one_iff_adj.mpr hadj
  have ht := (connected F hgen).dist_triangle (u := z) (v := v) (w := w)
  rw [SimpleGraph.dist_comm (u := z) (v := v), hw] at ht
  omega

/-- A genuine common Sylow embeds the central seed into the adjacent Sylow-center span. -/
theorem center_le_adjacent_center
    (hZ : ∀ v, Z F v ≤ omegaCenterIn (Q F v))
    {v w : Vertex F}
    (T : Sylow 2 (stabilizer F w))
    (hT : (T : Subgroup (stabilizer F w)).map (stabilizer F w).subtype =
      Q F v ⊔ Q F w)
    (hcentral : Z F v ≤ centralizer (Q F w : Set G)) : Z F v ≤ Z F w := by
  have hz : Z F v ≤ omegaCenterIn (Q F v ⊔ Q F w) := by
    intro z hz
    obtain ⟨hzQ, _, hz2⟩ := (mem_omegaCenterIn_iff _ _).mp (hZ v hz)
    apply (mem_omegaCenterIn_iff _ _).mpr
    refine ⟨(show Q F v ≤ Q F v ⊔ Q F w from le_sup_left) hzQ, ?_, hz2⟩
    have hcv : Z F v ≤ centralizer (Q F v : Set G) :=
      fun a ha => ((mem_omegaCenterIn_iff _ _).mp (hZ v ha)).2.1
    exact (le_centralizer_iff.mpr (sup_le
      (le_centralizer_iff.mp hcv) (le_centralizer_iff.mp hcentral))) hz
  rw [← hT] at hz
  exact hz.trans (le_iSup (fun R : Sylow 2 (stabilizer F w) =>
    omegaCenterIn ((R : Subgroup (stabilizer F w)).map (stabilizer F w).subtype)) T)

/-- The three literal cores normalize the intersection, without ambient normality. -/
theorem intersection_normalized
    [∀ i, Finite (F i)]
    (hQ : ∀ v, Q F v ≤ U F v)
    {x y m : Vertex F} (hxm : (graph F).Adj x m) (hym : (graph F).Adj y m)
    (hx : ⁅V F x 1, Q F x⁆ ≤ Z F x) (hy : ⁅V F y 1, Q F y⁆ ≤ Z F y)
    (hzx : Z F x ≤ Z F m) (hzy : Z F y ≤ Z F m) :
    (Q F x ⊔ Q F y) ⊔ Q F m ≤ normalizer ((V F x 1 ⊓ V F y 1 : Subgroup G) : Set G) := by
  have hmx : Z F m ≤ V F x 1 :=
    le_iSup_of_le m (le_iSup_of_le ((mem_ball_one F x m).mpr (Or.inl hxm)) le_rfl)
  have hmy : Z F m ≤ V F y 1 :=
    le_iSup_of_le m (le_iSup_of_le ((mem_ball_one F y m).mpr (Or.inl hym)) le_rfl)
  apply sup_le (sup_le ?_ ?_) ?_
  · apply le_normalizer_iff_commutator_le_left.mpr
    exact ((commutator_mono inf_le_left le_rfl).trans hx).trans
      (hzx.trans (le_inf hmx hmy))
  · apply le_normalizer_iff_commutator_le_left.mpr
    exact ((commutator_mono inf_le_right le_rfl).trans hy).trans
      (hzy.trans (le_inf hmx hmy))
  · apply (le_inf ?_ ?_).trans inf_normalizer_le_normalizer_inf
    · exact ((hQ m).trans ((ballKernel_one_le_edge F hxm.symm).trans inf_le_right)).trans
        (stabilizer_normalizes_V F x 1)
    · exact ((hQ m).trans ((ballKernel_one_le_edge F hym.symm).trans inf_le_right)).trans
        (stabilizer_normalizes_V F y 1)

private theorem normal_subgroup_le_next_ball
    (hgen : F false ⊔ F true = ⊤)
    {v w : Vertex F}
    (A N : Subgroup G) (hN : N ≤ stabilizer F v)
    (hn : A ≤ normalizer (N : Set G))
    (htrans : ∀ z : Vertex F, (graph F).Adj v z → ∃ g ∈ A, g • w = z)
    (n : ℕ) (hball : N ≤ ballKernel F w n) : N ≤ ballKernel F v (n + 1) := by
  intro a ha z hz
  by_cases hvz : z = v
  · subst z
    exact hN ha
  obtain ⟨u, hu, hd⟩ := exists_predecessor F hgen z v hvz
  have hzu : z ∈ ball F u n := by
    have hz' := (mem_ball_iff F hgen v z (n + 1)).mp hz
    apply (mem_ball_iff F hgen u z n).mpr
    rw [SimpleGraph.dist_comm (u := z) (v := u),
      SimpleGraph.dist_comm (u := z) (v := v)] at hd
    omega
  obtain ⟨g, hg, hgw⟩ := htrans u hu
  have hNg : N.map (MulAut.conj g).toMonoidHom = N :=
    mem_normalizer_iff_map_conj_eq.mp (hn hg)
  have hNu := map_mono (f := (MulAut.conj g).toMonoidHom) hball
  rw [hNg, ← ballKernel_translate F, hgw] at hNu
  exact hNu ha z hzu

/-- DGS 12.3(b) and the forward radius-three containment for the actual intersection. -/
theorem intersection_third_kernel
    [∀ i, Finite (F i)]
    (hgen : F false ⊔ F true = ⊤)
    (hZ : ∀ v, Z F v ≤ omegaCenterIn (Q F v))
    (hSyl : ∀ v, ∃ T : Sylow 2 (U F v),
      (T : Subgroup (U F v)).map (U F v).subtype = Q F v)
    (hQ : ∀ v, Q F v ≤ U F v) (hb : b F = 3)
    {x y m : Vertex F} (hxm : (graph F).Adj x m) (hym : (graph F).Adj y m)
    (Tx Ty : Sylow 2 (stabilizer F m))
    (hTx : (Tx : Subgroup (stabilizer F m)).map (stabilizer F m).subtype = Q F x ⊔ Q F m)
    (hTy : (Ty : Subgroup (stabilizer F m)).map (stabilizer F m).subtype = Q F y ⊔ Q F m)
    (hcx : Z F x ≤ centralizer (Q F m : Set G))
    (hcy : Z F y ≤ centralizer (Q F m : Set G))
    (hx : ⁅V F x 1, Q F x⁆ ≤ Z F x) (hy : ⁅V F y 1, Q F y⁆ ≤ Z F y)
    (A : Subgroup G) (hA : A = (Q F x ⊔ Q F y) ⊔ Q F m)
    (htrans : ∀ z : Vertex F, (graph F).Adj m z → ∃ g ∈ A, g • x = z) :
    ((V F x 1 ⊓ V F y 1).subgroupOf A).Normal ∧
      V F x 1 ⊓ V F y 1 ≤ Q F m ∧
      V F x 1 ⊓ V F y 1 ≤ ballKernel F m 3 ∧
      IsElementaryAbelian 2 (V F x 1 ⊓ V F y 1 : Subgroup G) := by
  have hcore := (inf_le_left : V F x 1 ⊓ V F y 1 ≤ V F x 1).trans
    (V_le_neighbor_Q F hgen hZ hSyl (by omega) hxm)
  have hn : A ≤ normalizer ((V F x 1 ⊓ V F y 1 : Subgroup G) : Set G) := by
    rw [hA]
    exact intersection_normalized F hQ hxm hym hx hy
      (center_le_adjacent_center F hZ Tx hTx hcx)
      (center_le_adjacent_center F hZ Ty hTy hcy)
  have hleA : V F x 1 ⊓ V F y 1 ≤ A := hcore.trans (hA ▸ le_sup_right)
  have hb3 := normal_subgroup_le_next_ball F hgen A (V F x 1 ⊓ V F y 1)
    (hcore.trans (Q_le_stabilizer F m)) hn htrans 2
    (inf_le_left.trans (V_le_ballKernel F hgen x (by omega)))
  let := V_elementary F hgen hZ hSyl (by omega) x
  exact ⟨(normal_subgroupOf_iff_le_normalizer hleA).mpr hn, hcore, hb3,
    IsElementaryAbelian.of_le (show V F x 1 ⊓ V F y 1 ≤ V F x 1 from inf_le_left)⟩

end CFSG.Quasithin.ChapterF.Source.DGS85.CommutingThreeProfile
