module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.Assembly.BTwoStrictMarkedQuotient
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.Assembly.BTwoStrictTreeReflections

/-!
# The strict quotient with source-constructed reflections

The original strict distance-two hypotheses construct compatible Cartans and
both universal reflections at that same Cartan. Choose these once and use their
literal six-path roots throughout the finite quotient, marking, split data and
rotation calculation. Neither a Cartan nor reflection data is an extra input.

The two remaining geometric contracts are exchange on this chosen apartment
and the root-sign alternative for the image of the whole original Borel.
They are kept separate for their source producers. In particular the latter
does not replace the Borel by its two-core or by a model positive subgroup.

Source: DGS, *Groups and Graphs* (1985), (10.10), p.164; (14.1)--(14.2),
pp.210--211; (3.6)--(3.7), pp.77--80; Aschbacher--Smith F.1.3(5).
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory RankTwoAmalgam
open Theory.GroupTheory.AmalgamGraph Subgroup.CosetGeometry.RankTwo
open Theory.GroupTheory.WeakBNPair.RegularTree
open CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.ApartmentExchange
open ReducedCartan Theory.AlgebraicGroup.TitsSystem.SourceBinary
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.RootCoordinates

namespace CFSG.Quasithin.ChapterF.Source.DGS85.Assembly.BTwoSource
open Reduction NoncommutingProfile OriginalExtension SuzukiContainment
variable {G : Type*} [Group G] {L : Fin 2 → Subgroup G} {S : Subgroup G}

/-- The two universal reflections at one prescribed compatible Cartan. -/
structure StrictTreeReflectionData (c : CompatibleCartans L (reducedSylow L S)) where
  t : Bool → (reducedAmalgam L S).Universal
  fixes : ∀ i, t i • base (Universal.cosetFamily (reducedAmalgam L S)) i =
    base (Universal.cosetFamily (reducedAmalgam L S)) i
  moves : ∀ i, t i • base (Universal.cosetFamily (reducedAmalgam L S)) (!i) ≠
    base (Universal.cosetFamily (reducedAmalgam L S)) (!i)
  square : ∀ i, t i * t i = 1
  normalizes : ∀ i, t i ∈ normalizer (cartan c : Set (reducedAmalgam L S).Universal)

-- Keep every dependency explicit in section-variable types.
variable (h : HypothesisF11 L S) {u : Vertex (reducedFamily L S)}
  (hc : IsCriticalPair (reducedFamily L S) (base (reducedFamily L S) false) u)
  (hne : ⁅Z (reducedFamily L S) (base (reducedFamily L S) false),
    Z (reducedFamily L S) u⁆ ≠ ⊥)
  (hb : b (reducedFamily L S) = 2)
  (hβu : (graph (reducedFamily L S)).Adj (base (reducedFamily L S) true) u)
  (hns : ¬ Group.IsSolvable (parabolic L S 0))
  {n : ℕ} (hlinear : ClassicalGroup.IsPSL (L 0 ⧸ pCore 2 (L 0)) 2 (2^n))

/-- Choose both reflections from the checked source theorem at the Cartan
already constructed from the original F.1.1 hypotheses. -/
def strictSourceReflections : StrictTreeReflectionData (chosenCartans h) := by
  let e := original_bTwo_strict_tree_reflections h hc hne hb hβu hns hlinear
    (chosenCartans h)
  exact ⟨e.choose, e.choose_spec.1, e.choose_spec.2.1,
    e.choose_spec.2.2.1, e.choose_spec.2.2.2⟩

/-- The same chosen six-edge path, named before forming its radical. -/
def strictSourcePath (i : Bool) :=
  let d := strictSourceReflections h hc hne hb hβu hns hlinear
  reflectionPath (chosenCartans h) d.t d.fixes d.moves d.normalizes 6 (by decide) i

/-- The subgroup generated by the full Cartan and both chosen reflections. -/
def strictSourceReflectionGroup : Subgroup (reducedAmalgam L S).Universal :=
  reflectionGroup (chosenCartans h)
    (strictSourceReflections h hc hne hb hβu hns hlinear).t

/-- The literal chosen apartment used by exchange and quotient root signs. -/
def strictSourceApartment : Set (SourceVertex (reducedAmalgam L S)) :=
  cartanApartment (reducedAmalgam L S)
    (strictSourceReflectionGroup h hc hne hb hβu hns hlinear)

/-- The period-twelve relation on that same source apartment. -/
def strictSourceRelation : Setoid (SourceVertex (reducedAmalgam L S)) :=
  sourceRelation (reducedAmalgam L S)
    (strictSourceApartment h hc hne hb hβu hns hlinear) 6

/-- The global class-action quotient map, prior to either geometric premise. -/
def strictSourceQuotientMap :=
  quotientMap (reducedAmalgam L S)
    (strictSourceApartment h hc hne hb hβu hns hlinear) 6

/-- The actual six-path radicals for the source-selected reflections. -/
def strictSourceRoots : Bool → LocalRootAction (X := (reducedAmalgam L S).Universal)
    (sourceGraph (reducedAmalgam L S)) :=
  let d := strictSourceReflections h hc hne hb hβu hns hlinear
  strictPathRoots h hc hne hb hβu hns hlinear (chosenCartans h)
    d.t d.fixes d.moves d.square d.normalizes

/-- The named root is the actual two-core of its named six-path fixer. -/
theorem strictSourceRoots_root (i : Bool) :
    (strictSourceRoots h hc hne hb hβu hns hlinear i).root =
      pathRoot (X := (reducedAmalgam L S).Universal)
        (strictSourcePath h hc hne hb hβu hns hlinear i).walk := rfl

/-- Exchange on the apartment of the same source-selected reflections. -/
def StrictSourceExchange : Prop :=
  ChosenApartmentExchange (X := (reducedAmalgam L S).Universal)
    (sourceGraph (reducedAmalgam L S))
    (strictSourceApartment h hc hne hb hβu hns hlinear) 6

/-- The required signs use the literal quotient image of the whole original
Borel and the actual six-path roots, with the original left-action convention. -/
def StrictSourceRootSigns : Prop :=
  let d := strictSourceReflections h hc hne hb hβu hns hlinear
  let N := strictSourceReflectionGroup h hc hne hb hβu hns hlinear
  let q := strictSourceQuotientMap h hc hne hb hβu hns hlinear
  ∀ (i : Bool) (x : (reducedAmalgam L S).Universal), x ∈ N →
    (∀ r ∈ (strictSourceRoots h hc hne hb hβu hns hlinear i).root,
      q (x⁻¹*r*x) ∈ (originalMiddle (reducedAmalgam L S)).map q) ∨
    (∀ r ∈ (strictSourceRoots h hc hne hb hβu hns hlinear i).root,
      q ((d.t i*x)⁻¹*r*(d.t i*x)) ∈ (originalMiddle (reducedAmalgam L S)).map q)

variable (hexchange : StrictSourceExchange h hc hne hb hβu hns hlinear)
  (hsign : StrictSourceRootSigns h hc hne hb hβu hns hlinear)

/-- The source constructs the finite quotient; only exchange and root signs
remain as geometric inputs. -/
def strictSourceFiniteQuotient : MarkedQuotient (recognitionEndpoints (reducedAmalgam L S)) :=
  let d := strictSourceReflections h hc hne hb hβu hns hlinear
  strictFiniteQuotient h hc hne hb hβu hns hlinear (chosenCartans h)
    d.t d.fixes d.moves d.square d.normalizes hexchange hsign

/-- Both endpoint inclusion squares and the full reduced Borel are retained
by the quotient built from the source-selected reflections. -/
def strictSourceFiniteMarkedIso : Iso (reducedAmalgam L S)
    (strictSourceFiniteQuotient h hc hne hb hβu hns hlinear hexchange hsign).standardAmalgam :=
  let d := strictSourceReflections h hc hne hb hβu hns hlinear
  strictFiniteMarkedIso h hc hne hb hβu hns hlinear (chosenCartans h)
    d.t d.fixes d.moves d.square d.normalizes hexchange hsign

/-- Split data on that same source-selected finite marked quotient. -/
def strictSourceFiniteSplitData : SplitData
    (strictSourceFiniteQuotient h hc hne hb hβu hns hlinear hexchange hsign).tits :=
  let d := strictSourceReflections h hc hne hb hβu hns hlinear
  strictFiniteSplitData h hc hne hb hβu hns hlinear (chosenCartans h)
    d.t d.fixes d.moves d.square d.normalizes hexchange hsign

/-- The exact Weyl rotation order remains six after source reflection selection. -/
theorem strictSourceFiniteQuotient_rotation :
    rotationOrder (strictSourceFiniteQuotient h hc hne hb hβu hns hlinear hexchange hsign) = 6 :=
  let d := strictSourceReflections h hc hne hb hβu hns hlinear
  strictFiniteQuotient_rotation h hc hne hb hβu hns hlinear (chosenCartans h)
    d.t d.fixes d.moves d.square d.normalizes hexchange hsign

end CFSG.Quasithin.ChapterF.Source.DGS85.Assembly.BTwoSource
