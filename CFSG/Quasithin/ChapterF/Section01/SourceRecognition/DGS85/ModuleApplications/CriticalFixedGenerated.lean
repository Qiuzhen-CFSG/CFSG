module

public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.ModuleApplications.CriticalActorBounds
public import Theory.Representation.RankOne.QuadraticRecognition.UnitaryBlockReduction

/-!
# The fixed-generated local block on the DGS critical quotient

This adapter keeps the original module `Z`, the quotient by `C_Z(L)`, and the
original map `L → L/O₂(L)`.  Given a literal embedded binary SL₂ block in the
model group, the reusable local reduction bounds the central quotient of the
subrepresentation generated by the block actor's fixed space.  The actor and
the element are retained through the model homomorphism, so the result can be
fed directly to the unitary torus branch of DGS85 (5.10)(b).

The final SU₃ and PSU₃ applications start with the image of the original
subgroup B. They descend quadraticity from Z, construct the exact block
preimage and prove the required local fixed-space generation. The normalized
central-root placement remains explicit; the graph owners supply this
placement from (5.9)(b) and their choice of Hermitian coordinates. The torus
argument completing (5.10)(b) remains with the quadratic-module owner.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender
open Representation.RankOne.QuadraticRecognition
open scoped MatrixGroups IsMulCommutative
namespace CFSG.Quasithin.DGS85.ModuleApplications

universe u v w
variable {L : Type u} [Group L]

/-- The local fixed-generated reduction on the literal quotient
`Z / (Z ∩ Z(L))`, with the original `L/O₂(L)` action marking retained. -/
public theorem critical_sl2_fixedGenerated_degree_le
    {F : Type v} [Field F] [Finite F] [CharP F 2]
    {D : Type w} [Group D]
    {n : ℕ} (hn : 0 < n) (hF : Nat.card F = 2 ^ n)
    (Z : Subgroup L) [IsElementaryAbelian 2 Z]
    (e : (L ⧸ pCore 2 L) ≃* D)
    (ρ : Representation (ZMod 2) D (Additive Z))
    (hact : ∀ (l : L) (v : Additive Z),
      ((ρ (e (QuotientGroup.mk' (pCore 2 L) l)) v).toMul : L) =
        l * (v.toMul : L) * l⁻¹)
    {j : SL(2, F) →* D} (S : Sylow 2 SL(2, F))
    (A : Subgroup SL(2, F)) (hAS : A ≤ S) (hAc : 4 ≤ Nat.card A)
    (hq : IsQuadratic ((globalFixedQuotient ρ).comp j) A)
    (t : SL(2, F)) (htA : t ∈ A) (ht1 : t ≠ 1)
    [Finite L] :
    centralPart Z = fixedSpace ρ ⊤ ∧
      let σ := globalFixedQuotient ρ
      let W := fixedGeneratedSubrepresentation (σ.comp j) A
      Module.finrank (ZMod 2)
          (W.toSubmodule ⧸ fixedSpace W.toRepresentation ⊤) ≤
        2 * fixedCodim σ ((zpowers t).map j) := by
  let σ := globalFixedQuotient ρ
  let W := fixedGeneratedSubrepresentation (σ.comp j) A
  have hdeg := sl2_fixedGenerated_central_degree_le (σ.comp j) hn hF S A hAS hAc hq
    t htA ht1
  have hcodim : fixedCodim (σ.comp j) (zpowers t) =
      fixedCodim σ ((zpowers t).map j) := by
    unfold fixedCodim
    rw [fixedSpace_comp_map, MonoidHom.map_zpowers]
  rw [hcodim] at hdeg
  exact ⟨centralPart_eq_fixedSpace_model Z e ρ hact,
    by simpa only [σ, W] using hdeg⟩

open BenderSuzuki.MatrixGroups
open BenderSuzuki.MatrixGroups.HermitianForm.BorelTorus.EvenCenterAction
open Representation.SU3.CubicDegree.InnerActors.ThreeRoots

/-- The same reduction with the literal fixed-field SL₂ block in SU₃.  The
fixed field and its binary degree are obtained from the original Hermitian
involution, while the quotient and the `L/O₂(L)` action remain unchanged. -/
public theorem critical_su3_block_fixedGenerated_degree_le
    {F : Type v} [Field F] [Finite F] [CharP F 2]
    (J : HermitianForm 3 F)
    (hJ : J.form = !![0, 0, 1; 0, 1, 0; 1, 0, 0])
    {n : ℕ} (hn : 0 < n)
    (hcard : Nat.card F = (2 ^ n) ^ 2)
    (hconj : ∀ x, J.conj x = x ^ (2 ^ n))
    (Z : Subgroup L) [IsElementaryAbelian 2 Z]
    (e : (L ⧸ pCore 2 L) ≃* J.specialSubgroup)
    (ρ : Representation (ZMod 2) J.specialSubgroup (Additive Z))
    (hact : ∀ (l : L) (v : Additive Z),
      ((ρ (e (QuotientGroup.mk' (pCore 2 L) l)) v).toMul : L) =
        l * (v.toMul : L) * l⁻¹)
    (S : Sylow 2 (SL(2, fixedField J)))
    (A : Subgroup (SL(2, fixedField J))) (hAS : A ≤ S)
    (hAc : 4 ≤ Nat.card A)
    (hq : IsQuadratic ((globalFixedQuotient ρ).comp (block J hJ)) A)
    (t : SL(2, fixedField J)) (htA : t ∈ A) (ht1 : t ≠ 1)
    [Finite L] :
    centralPart Z = fixedSpace ρ ⊤ ∧
      let σ := globalFixedQuotient ρ
      let W := fixedGeneratedSubrepresentation (σ.comp (block J hJ)) A
      Module.finrank (ZMod 2)
          (W.toSubmodule ⧸ fixedSpace W.toRepresentation ⊤) ≤
        2 * fixedCodim σ ((zpowers t).map (block J hJ)) := by
  have hf : Nat.card (fixedField J) = 2 ^ n := by
    simpa [fixedField] using
      (FiniteField.card_fixed_of_quadratic_frobenius J.conj 2 n (by omega)
        hcard hconj)
  have h := critical_sl2_fixedGenerated_degree_le (L := L)
    (F := fixedField J) (D := J.specialSubgroup) hn hf Z e ρ hact S A hAS hAc hq
    t htA ht1
  exact h

section OriginalActors
variable {F : Type*} [Finite L] [Field F] [Finite F] [CharP F 2]

/-- The original special-unitary actor on Z/(Z∩Z(L)) supplies its own
block preimage and local generation. This is the local step for the
individual-element bound used in DGS Chapter 8. -/
theorem critical_su3_root_fixedGenerated_reduction
    (J : HermitianForm 3 F) (hJ : J.form=!![0,0,1;0,1,0;1,0,0])
    {n : ℕ} (hn : 0<n) (hcard : Nat.card F=(2^n)^2)
    (hconj : ∀ x, J.conj x=x^(2^n))
    (Z : Subgroup L) [IsElementaryAbelian 2 Z]
    (e : (L ⧸ pCore 2 L) ≃* J.specialSubgroup)
    (ρ : Representation (ZMod 2) J.specialSubgroup (Additive Z))
    (hact : ∀ (l : L) (v : Additive Z),
      ((ρ (e (QuotientGroup.mk' (pCore 2 L) l)) v).toMul : L)=l*(v.toMul:L)*l⁻¹)
    (B : Subgroup L) (t : L) (ht : t∈B)
    (ht1 : e (QuotientGroup.mk' (pCore 2 L) t) ≠ 1)
    (hB : B.map (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))) ≤ central J hJ)
    (hBc : 4≤Nat.card (B.map (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L)))))
    (hquad : IsQuadratic ρ (B.map (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))))) :
    centralPart Z=fixedSpace ρ ⊤ ∧
      let σ := globalFixedQuotient ρ
      let A := B.map (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L)))
      let t' := e (QuotientGroup.mk' (pCore 2 L) t)
      let W := fixedGeneratedSubrepresentation (σ.comp (block J hJ)) (A.comap (block J hJ))
      GeneratedByFixedSpace W.toRepresentation (A.comap (block J hJ)) ∧
      W.toSubmodule ⊓ fixedSpace σ (zpowers t')=fixedSpace σ A ∧
      Module.finrank (ZMod 2) (W.toSubmodule ⧸ fixedSpace W.toRepresentation ⊤) ≤
        2*fixedCodim σ (zpowers t') := by
  let A := B.map (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L)))
  have hq : IsQuadratic (globalFixedQuotient ρ) A :=
    quadratic_of_equivariant_surjection ρ (globalFixedQuotient ρ)
      (fixedSpace ρ ⊤).mkQ (fixedSpace ρ ⊤).mkQ_surjective
      (fun g v => (globalFixedQuotient_mk ρ g v).symm) A hquad
  exact ⟨centralPart_eq_fixedSpace_model Z e ρ hact,
    fixedGenerated_generated _ _,
    su3_root_fixedGenerated_reduction J hJ hn hcard hconj (globalFixedQuotient ρ)
      A hB hBc hq _ (mem_map_of_mem _ ht) ht1⟩

/-- The corresponding projective application uses the canonical scalar
quotient of the same fixed-field block. Both the original B image and the
original element image are retained. -/
theorem critical_psu3_root_fixedGenerated_reduction
    (J : HermitianForm 3 F) (hJ : J.form=!![0,0,1;0,1,0;1,0,0])
    {n : ℕ} (hn : 0<n) (hcard : Nat.card F=(2^n)^2)
    (hconj : ∀ x, J.conj x=x^(2^n))
    (Z : Subgroup L) [IsElementaryAbelian 2 Z]
    (e : (L ⧸ pCore 2 L) ≃* ProjectiveSpecialUnitaryMatrixGroup J)
    (ρ : Representation (ZMod 2) (ProjectiveSpecialUnitaryMatrixGroup J) (Additive Z))
    (hact : ∀ (l : L) (v : Additive Z),
      ((ρ (e (QuotientGroup.mk' (pCore 2 L) l)) v).toMul : L)=l*(v.toMul:L)*l⁻¹)
    (B : Subgroup L) (t : L) (ht : t∈B)
    (ht1 : e (QuotientGroup.mk' (pCore 2 L) t) ≠ 1)
    (hB : B.map (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))) ≤ centralImage J hJ)
    (hBc : 4≤Nat.card (B.map (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L)))))
    (hquad : IsQuadratic ρ (B.map (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))))) :
    centralPart Z=fixedSpace ρ ⊤ ∧
      let σ := globalFixedQuotient ρ
      let A := B.map (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L)))
      let t' := e (QuotientGroup.mk' (pCore 2 L) t)
      let j := J.specialToProjective.comp (block J hJ)
      let W := fixedGeneratedSubrepresentation (σ.comp j) (A.comap j)
      GeneratedByFixedSpace W.toRepresentation (A.comap j) ∧
      W.toSubmodule ⊓ fixedSpace σ (zpowers t')=fixedSpace σ A ∧
      Module.finrank (ZMod 2) (W.toSubmodule ⧸ fixedSpace W.toRepresentation ⊤) ≤
        2*fixedCodim σ (zpowers t') := by
  let A := B.map (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L)))
  have hq : IsQuadratic (globalFixedQuotient ρ) A :=
    quadratic_of_equivariant_surjection ρ (globalFixedQuotient ρ)
      (fixedSpace ρ ⊤).mkQ (fixedSpace ρ ⊤).mkQ_surjective
      (fun g v => (globalFixedQuotient_mk ρ g v).symm) A hquad
  exact ⟨centralPart_eq_fixedSpace_model Z e ρ hact,
    fixedGenerated_generated _ _,
    psu3_root_fixedGenerated_reduction J hJ hn hcard hconj (globalFixedQuotient ρ)
      A hB hBc hq _ (mem_map_of_mem _ ht) ht1⟩
end OriginalActors

end CFSG.Quasithin.DGS85.ModuleApplications
