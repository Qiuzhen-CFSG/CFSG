module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.ModuleApplications.CriticalFixedGenerated
public import Theory.Representation.RankOne.QuadraticRecognition.UnitaryLargeActors

/-!
# The large-actor obstruction on the original DGS critical quotient

The original elementary abelian group Z and its central denominator are
retained, as is the image of B through L → L/O₂(L) and the unitary model map.
Quadraticity descends from Z to Z/(Z∩Z(L)). Restricting to the actual fixed-field
SL₂ block then constructs the local module generated by the actor fixed space.
For a large actor the degree of its literal central quotient is divisible by
2n. At q=8 this rules out dimension eight without an irreducibility premise.

This is the final exceptional-dimension obstruction in DGS85 (5.10)(b),
printed pp.111–112, applied to the quotient used in Chapter 8. The graph
owners retain construction of Z, the original quotient marking and the
normalized central-root placement. The preceding unitary torus reduction
remains with the quadratic-module owner; this adapter alone is not (5.10)(b).
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender
open Representation.RankOne.QuadraticRecognition
open BenderSuzuki.MatrixGroups
open BenderSuzuki.MatrixGroups.HermitianForm.BorelTorus.EvenCenterAction
open Representation.SU3.CubicDegree.InnerActors.ThreeRoots
open scoped MatrixGroups IsMulCommutative
namespace CFSG.Quasithin.DGS85.ModuleApplications
variable {L F : Type*} [Group L] [Finite L] [Field F] [Finite F] [CharP F 2]

/-- The large-actor divisibility retains the original B image, central quotient and fixed-field block. -/
theorem critical_su3_large_root_central_degree_dvd
    (J : HermitianForm 3 F) (hJ : J.form = !![0,0,1;0,1,0;1,0,0])
    {n : ℕ} (hn : 2 ≤ n) (hcard : Nat.card F = (2^n)^2)
    (hconj : ∀ x, J.conj x = x^(2^n))
    (Z : Subgroup L) [IsElementaryAbelian 2 Z]
    (e : (L ⧸ pCore 2 L) ≃* J.specialSubgroup)
    (ρ : Representation (ZMod 2) J.specialSubgroup (Additive Z))
    (hact : ∀ (l : L) (v : Additive Z),
      ((ρ (e (QuotientGroup.mk' (pCore 2 L) l)) v).toMul : L) =
        l * (v.toMul : L) * l⁻¹)
    (B : Subgroup L)
    (hB : B.map (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))) ≤ central J hJ)
    (hBc : 4 ≤ Nat.card (B.map (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L)))))
    (hquad : IsQuadratic ρ (B.map (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L)))))
    (hlarge : 2^n < Nat.card
      (B.map (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))))^2)
    : centralPart Z = fixedSpace ρ ⊤ ∧
      let σ := globalFixedQuotient ρ
      let A := B.map (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L)))
      let j := block J hJ
      let W := fixedGeneratedSubrepresentation (σ.comp j) (A.comap j)
      GeneratedByFixedSpace W.toRepresentation (A.comap j) ∧
        2*n ∣ Module.finrank (ZMod 2) (W.toSubmodule ⧸ fixedSpace W.toRepresentation ⊤) := by
  let : Finite (Additive Z ⧸ (globalFixedSubrepresentation ρ).toSubmodule) :=
    Finite.of_surjective _ (globalFixedSubrepresentation ρ).toSubmodule.mkQ_surjective
  let A := B.map (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L)))
  have hq : IsQuadratic (globalFixedQuotient ρ) A :=
    quadratic_of_equivariant_surjection ρ (globalFixedQuotient ρ)
      (fixedSpace ρ ⊤).mkQ (fixedSpace ρ ⊤).mkQ_surjective
      (fun g v => (globalFixedQuotient_mk ρ g v).symm) A hquad
  exact ⟨centralPart_eq_fixedSpace_model Z e ρ hact,
    fixedGenerated_generated _ _,
    su3_large_root_central_degree_dvd J hJ hn hcard hconj
      (globalFixedQuotient ρ) A hB hBc hq hlarge⟩

/-- The q=8 exceptional local dimension is impossible on the original critical quotient. -/
theorem critical_su3_eight_root_central_degree_ne_eight
    (J : HermitianForm 3 F) (hJ : J.form = !![0,0,1;0,1,0;1,0,0])
    (hcard : Nat.card F = 64) (hconj : ∀ x, J.conj x = x^8)
    (Z : Subgroup L) [IsElementaryAbelian 2 Z]
    (e : (L ⧸ pCore 2 L) ≃* J.specialSubgroup)
    (ρ : Representation (ZMod 2) J.specialSubgroup (Additive Z))
    (hact : ∀ (l : L) (v : Additive Z),
      ((ρ (e (QuotientGroup.mk' (pCore 2 L) l)) v).toMul : L) =
        l * (v.toMul : L) * l⁻¹)
    (B : Subgroup L)
    (hB : B.map (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))) ≤ central J hJ)
    (hBc : 4 ≤ Nat.card (B.map (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L)))))
    (hquad : IsQuadratic ρ (B.map (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L)))))
    : centralPart Z = fixedSpace ρ ⊤ ∧
      let σ := globalFixedQuotient ρ
      let A := B.map (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L)))
      let j := block J hJ
      let W := fixedGeneratedSubrepresentation (σ.comp j) (A.comap j)
      GeneratedByFixedSpace W.toRepresentation (A.comap j) ∧
        Module.finrank (ZMod 2) (W.toSubmodule ⧸ fixedSpace W.toRepresentation ⊤) ≠ 8 := by
  let : Finite (Additive Z ⧸ (globalFixedSubrepresentation ρ).toSubmodule) :=
    Finite.of_surjective _ (globalFixedSubrepresentation ρ).toSubmodule.mkQ_surjective
  let A := B.map (e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L)))
  have hq : IsQuadratic (globalFixedQuotient ρ) A :=
    quadratic_of_equivariant_surjection ρ (globalFixedQuotient ρ)
      (fixedSpace ρ ⊤).mkQ (fixedSpace ρ ⊤).mkQ_surjective
      (fun g v => (globalFixedQuotient_mk ρ g v).symm) A hquad
  exact ⟨centralPart_eq_fixedSpace_model Z e ρ hact,
    fixedGenerated_generated _ _,
    su3_eight_root_central_degree_ne_eight J hJ hcard hconj
      (globalFixedQuotient ρ) A hB hBc hq⟩

