module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingOneProfile.SeedSquareApplication
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingNontrivial.RankOneSquare
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.Noncommuting.EndpointModelBounds

/-!
# Excluding an elementary critical-center pair without selecting alpha

If the opposite seed has at least the critical-center index and the pair
were abelian, its action on the full alpha center would be quadratic with
fixed-space index at most its order. The actual quotient action is faithful
on Sylow two-subgroups and is generated by their fixed vectors. The proved
rank-one sharp-index theorem therefore selects alpha as linear. The existing
linear nonquadratic-action theorem gives a contradiction.

This discharges the elementary alternative in the nonbinary unitary
seed-square calculation, retaining both SU3 and PSU3 markings. No linear
alpha formula or core-product conclusion is assumed.
Source: DGS85, Groups and Graphs (1985), (11.3)(e,g), pp.169--170,
using corrected (5.12).
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender Representation.BinaryConjugationSection
open Representation.RankOne.QuadraticRecognition
open scoped MatrixGroups IsMulCommutative
namespace CFSG.Quasithin.ChapterF.Source.DGS85.CommutingOneProfile
open Subgroup.CosetGeometry.RankTwo CommutingNontrivial Theory.GroupTheory.AmalgamGraph
variable {G : Type*} [Group G] {P : Fin 2 → Subgroup G} {B : Subgroup G}

private theorem generated_transport {D W : Type*} [Group D] [Finite D]
    [AddCommGroup W] [Module (ZMod 2) W]
    (ρ : Representation (ZMod 2) D W) (S T : Sylow 2 D)
    (hg : GeneratedByFixedSpace ρ S) : GeneratedByFixedSpace ρ T := by
  obtain ⟨g,rfl⟩ := MulAction.exists_smul_eq D S T
  exact generatedByFixedSpace_of_equivariant_surjection ρ ρ
    (MulAut.conj g).toMonoidHom (ρ g)
    (fun v => ⟨ρ g⁻¹ v,ρ.self_inv_apply g v⟩)
    (by intro a v; simp only [MulEquiv.toMonoidHom_eq_coe,MonoidHom.coe_coe,
      MulAut.conj_apply,map_mul,Module.End.mul_apply,ρ.inv_self_apply]) S hg

/-- Source (11.3)(e) from the actual seed-index comparison, for every
alpha and beta catalogue row. -/
theorem source_pair_nonabelian_of_seed_index_le
    (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    {a b c : Vertex (family P)} (hc : IsCriticalPair (family P) a b)
    (hb : DGS85.b (family P) = 1) (hcomm : ⁅Z (family P) a,Z (family P) b⁆ = ⊥)
    (hbc : (graph (family P)).Adj b c) (hac : a ≠ c)
    (Ma : IsRankOneModel (d.localGroup a ⧸ pCore 2 (d.localGroup a)))
    (Mb : IsRankOneModel (d.localGroup b ⧸ pCore 2 (d.localGroup b)))
    (hidx : (Q (family P) b).relIndex (Z (family P) a) ≤
      (Q (family P) a).relIndex (Z (family P) c ⊓ Q (family P) b)) :
    let V := pairSpan (Z (family P) a) (Z (family P) c) (Q (family P) b)
    ⁅V,V⁆ ≠ ⊥ := by
  let := finite_endpoints h
  let := source_center_elementary h a
  let := source_center_elementary h c
  let L := d.localGroup a
  let Z₀ := Z (family P) a
  let C := Z (family P) c ⊓ Q (family P) b
  let E := Z₀ ⊓ Q (family P) b
  let V := pairSpan Z₀ (Z (family P) c) (Q (family P) b)
  let : IsElementaryAbelian 2 C := IsElementaryAbelian.of_le inf_le_left
  let : Finite L := Finite.of_injective (inclusion (d.local_le a)) (inclusion_injective _)
  let : Finite (L ⧸ pCore 2 L) := Finite.of_surjective _ (QuotientGroup.mk'_surjective _)
  have hab := source_critical_one_adjacent hc hb
  have hCL : C ≤ L := pGroup_le_localGroup (family P) d a C
    (IsElementaryAbelian.isPGroup 2 C) (inf_le_right.trans ((source_Z_Q_U h b).2.trans
      ((ballKernel_one_le_edge _ hab.symm).trans inf_le_right)))
  have hZL : Z₀ ≤ L := pGroup_le_localGroup (family P) d a Z₀
    (IsElementaryAbelian.isPGroup 2 Z₀) (Z_le_stabilizer _ a)
  let : Finite Z₀ := Finite.of_injective (inclusion hZL) (inclusion_injective _)
  let : Finite C := Finite.of_injective (inclusion hCL) (inclusion_injective _)
  have hz := local_center_eq_bot_of_neighbor_central h d hab
    (critical_end_center_of_commuting (family P) h.generate
      (fun v => (source_Z_Q_U h v).1) (fun v => (source_Z_Q_U h v).2)
      hc hcomm (d.localGroup b) (d.sylow_or_center b))
  let q := QuotientGroup.mk' (pCore 2 L)
  let A := (C.subgroupOf L).map q
  let : IsElementaryAbelian 2 (C.subgroupOf L) := IsElementaryAbelian.subgroupOf hCL
  let : IsElementaryAbelian 2 A := IsElementaryAbelian.map q
  obtain ⟨ρ,hact⟩ := source_exists_center_quotient_action h d a (MulEquiv.refl _)
  obtain ⟨S₀,_,hg,_⟩ := source_center_module_prepared_of_center_eq_bot h d a hz
    default (MulEquiv.refl _) ρ hact
  obtain ⟨S,hAS⟩ := (IsElementaryAbelian.isPGroup 2 A).exists_le_sylow
  have hfaith := source_center_quotient_sylow_faithful h d a hz (MulEquiv.refl _) ρ hact S
  have hdis : Disjoint ρ.ker (S : Subgroup (L ⧸ pCore 2 L)) := by
    apply disjoint_iff.mpr
    apply bot_unique
    intro x hx
    exact congrArg Subtype.val (hfaith (a₁ := ⟨x,hx.2⟩) (a₂ := 1)
      (hx.1.trans (map_one ρ).symm))
  have hcard : Nat.card A = (Q (family P) a).relIndex C :=
    actor_image_card_eq_relIndex L (Q (family P) a) C q
      (local_quotient_kernel (family P) d a (MulEquiv.refl _)) hCL
  have hesc : ¬ C ≤ Q (family P) a := source_seed_not_le_opposite_core h hbc.symm hab.symm
    (by intro hp; apply source_rankOne_centers_not_isPGroup h hB d hc hb hbc hac Mb;
        rw [sup_comm]; exact hp)
  have hA : 1 < Nat.card A := by
    rw [hcard]
    have hnz := ((Q (family P) a).subgroupOf C).index_ne_zero_of_finite
    have hne : (Q (family P) a).relIndex C ≠ 1 := fun hh => hesc (relIndex_eq_one.mp hh)
    change (Q (family P) a).relIndex C ≠ 0 at hnz
    omega
  change ⁅V,V⁆ ≠ ⊥
  intro habV
  have hEC : E ≤ centralizer (C : Set G) :=
    le_sup_left.trans ((commutator_eq_bot_iff_le_centralizer.mp habV).trans
      (centralizer_le (show C ≤ V from le_sup_right)))
  have hquad : ⁅⁅Z₀,C⁆,C⁆ = ⊥ := by
    have hdisp : ⁅Z₀,C⁆ ≤ E := by
      apply le_inf
      · exact le_normalizer_iff_commutator_le_left.mp
          (inf_le_right.trans (source_adjacent_core_normalizes_center h hab))
      · exact (commutator_mono le_rfl inf_le_right).trans
          (le_normalizer_iff_commutator_le_right.mp
            (((((source_Z_Q_U h a).1.trans (map_subtype_le _)).trans
              (source_Z_Q_U h a).2).trans
              ((ballKernel_one_le_edge _ hab).trans inf_le_right)).trans
              (stabilizer_normalizes_Q _ b)))
    exact commutator_eq_bot_iff_le_centralizer.mpr (hdisp.trans hEC)
  let δ := centerSection L Z₀ hZL ((d.local_le a).trans (stabilizer_normalizes_Z _ a)) q ρ hact
  have hquadratic : IsQuadratic ρ A := by
    apply isQuadratic_of_triple_commutator_le L Z₀ ⊥ C ρ q δ
    simpa only [commutator_comm] using hquad.le
  have hbound : Nat.card (Additive Z₀ ⧸ fixedSpace ρ A) ≤ Nat.card A := by
    rw [center_action_fixed_index L Z₀ C hZL δ.normalized hCL q ρ hact,hcard]
    calc
      (centralizer (C : Set G)).relIndex Z₀ ≤ E.relIndex Z₀ :=
        relIndex_le_of_le_left hEC (by exact index_ne_zero_of_finite)
      _ = (Q (family P) b).relIndex Z₀ := inf_relIndex_left _ _
      _ ≤ (Q (family P) a).relIndex C := hidx
  obtain ⟨n,hn,mark⟩ := Noncommuting.rankOne_linear_of_sylow_faithful_sharp_index
    Ma ρ S A hAS hA hquadratic (generated_transport ρ S₀ S hg) hdis hbound
  obtain ⟨k,_,_,hk,⟨ea⟩⟩ := mark
  let : Fintype k := Fintype.ofFinite k
  let : CharP k 2 := charP_of_card_eq_prime_pow
    (by simpa only [Nat.card_eq_fintype_card] using hk)
  let ep : SL(2,k) ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 2) k :=
    MulEquiv.ofBijective (BenderSuzuki.Converse.pi k)
      ⟨BenderSuzuki.Converse.pi_injective,BenderSuzuki.Converse.pi_surjective⟩
  exact source_linear_rankOne_pair_nonabelian h hB d hc hb hcomm hbc hac Ma Mb
    (ea.trans ep.symm) habV


/-- Source (11.3)(g) for either nonbinary unitary beta carrier, with the
elementary-pair alternative discharged and alpha unselected. -/
theorem source_unitary_seed_square
    (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    {a b c : Vertex (family P)} (hc : IsCriticalPair (family P) a b)
    (hb : DGS85.b (family P) = 1) (hcomm : ⁅Z (family P) a,Z (family P) b⁆ = ⊥) (hbc : (graph (family P)).Adj b c) (hac : a ≠ c)
    (Ma : IsRankOneModel (d.localGroup a ⧸ pCore 2 (d.localGroup a)))
    {n : ℕ} (hn : 2 ≤ n)
    (hi : ClassicalGroup.IsPSU (d.localGroup b ⧸ pCore 2 (d.localGroup b)) 3 (2^n) ∨
      IsSU (d.localGroup b ⧸ pCore 2 (d.localGroup b)) 3 (2^n)) :
    ((Q (family P) b).relIndex (Z (family P) a))^2 ≤
        (Q (family P) a).relIndex (Z (family P) c ⊓ Q (family P) b) := by
  have Mb : IsRankOneModel (d.localGroup b ⧸ pCore 2 (d.localGroup b)) :=
    hi.elim (.projective_unitary n (by omega)) (.special_unitary n (by omega))
  rcases source_unitary_seed_square_or_elementary h hB d hc hb hbc hac Ma hn hi with
    hbound | ⟨he,helem⟩
  · exact hbound
  · let := helem
    exact False.elim (source_pair_nonabelian_of_seed_index_le h hB d hc hb hcomm hbc hac Ma Mb he.ge
      (commutator_eq_bot_iff_le_centralizer.mpr (le_centralizer_iff_isMulCommutative.mpr
        (inferInstance : IsMulCommutative (pairSpan (Z (family P) a) (Z (family P) c) (Q (family P) b))))))

end CFSG.Quasithin.ChapterF.Source.DGS85.CommutingOneProfile
