module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingOneProfile.NonlinearCoreGeneration
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingOneProfile.CenterIdentities

/-!
# The neighboring center intersections for all rank-one beta rows

Every two-subgroup of a local group fixes a neighbor, by conjugating it
into an edge Sylow. An escaping elementary center has a unique fixed
neighbor. Sylow conjugacy inside the group generated by two neighboring
centers therefore supplies an element moving one marked neighbor to the
other. This suffices to identify the two mixed core-center intersections;
transitivity on the entire beta star is unnecessary.

With a linear alpha marking, the proved opposite-seed supplement makes the
center intersection central in the edge Sylow. The commuting critical
hypothesis supplies the reverse containment, identifying all four relevant
intersections with Z_beta. Consequently the pair span has central derived
and Frattini layer contained in Z_beta. Nontriviality of this layer, its
order and the full profiles remain source obligations.

The lower centers, full kernels and quotient markings retain their original
meanings. Source: Delgado--Goldschmidt--Stellmacher, Groups and Graphs
(1985), (11.3)(a,e) and (11.6), printed pp.168--174.
-/

public noncomputable section
open Subgroup
open scoped Pointwise MatrixGroups
namespace CFSG.Quasithin.ChapterF.Source.DGS85.CommutingOneProfile
open Subgroup.CosetGeometry.RankTwo CommutingNontrivial Theory.GroupTheory.AmalgamGraph
variable {G : Type*} [Group G] {P : Fin 2 → Subgroup G} {B : Subgroup G}

private theorem pGroup_fixes_neighbor (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    {a b : Vertex (family P)} (hab : (graph (family P)).Adj a b)
    (A : Subgroup G) (hp : IsPGroup 2 A) (hAb : A ≤ stabilizer (family P) b) :
    ∃ w, (graph (family P)).Adj b w ∧ A ≤ stabilizer (family P) w := by
  let := finite_endpoints h
  let L := d.localGroup b
  let : Finite L := Finite.of_injective (inclusion (d.local_le b)) (inclusion_injective _)
  have hAL : A ≤ L := pGroup_le_localGroup (family P) d b A hp hAb
  obtain ⟨R,hR⟩ := hp.comap_subtype (K := L) |>.exists_le_sylow
  obtain ⟨T,hT⟩ := source_edge_core_local_sylow h hB d hab.symm
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq L T R
  have hfix : (R : Subgroup L).map L.subtype ≤ stabilizer (family P) ((g : G) • a) := by
    rw [←hg]
    change ((T : Subgroup L).map (MulAut.conj g).toMonoidHom).map L.subtype ≤ _
    rw [map_map]
    have he : L.subtype.comp (MulAut.conj g).toMonoidHom =
        (MulAut.conj (g : G)).toMonoidHom.comp L.subtype := by ext x; rfl
    rw [he,←map_map,hT,stabilizer_translate]
    exact map_mono ((pCoreIn_le 2 _).trans inf_le_right)
  refine ⟨(g : G) • a,?_,?_⟩
  · have hh := (Subgroup.CosetGeometry.translationGraphIso (family P) (g : G)).map_adj_iff.mpr hab.symm
    change (graph (family P)).Adj ((g : G) • b) ((g : G) • a) at hh
    rwa [show (g : G) • b = b from d.local_le b g.property] at hh
  · intro x hx
    exact hfix (mem_map_of_mem L.subtype (hR (show (⟨x,hAL hx⟩ : L) ∈ A.subgroupOf L from hx)))

/-- Two escaping centers put their two marked neighbors in the same orbit
 under their own generated group. This does not assert transitivity on the star. -/
theorem source_rankOne_center_pair_moves (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    {a b c : Vertex (family P)} (hc : IsCriticalPair (family P) a b)
    (hb : DGS85.b (family P) = 1) (hbc : (graph (family P)).Adj b c)
    (Mb : IsRankOneModel (d.localGroup b ⧸ pCore 2 (d.localGroup b))) :
    ∃ g ∈ Z (family P) a ⊔ Z (family P) c, g • a = c := by
  let := finite_endpoints h
  let := source_center_elementary h a
  let := source_center_elementary h c
  have hab := source_critical_one_adjacent hc hb
  have hZa : Z (family P) a ≤ stabilizer (family P) b :=
    (((source_Z_Q_U h a).1.trans (map_subtype_le _)).trans (source_Z_Q_U h a).2).trans
      ((ballKernel_one_le_edge _ hab).trans inf_le_right)
  have hZc : Z (family P) c ≤ stabilizer (family P) b :=
    (((source_Z_Q_U h c).1.trans (map_subtype_le _)).trans (source_Z_Q_U h c).2).trans
      ((ballKernel_one_le_edge _ hbc.symm).trans inf_le_right)
  let W := Z (family P) a ⊔ Z (family P) c
  have hWb : W ≤ stabilizer (family P) b := sup_le hZa hZc
  let : Finite W := Finite.of_injective (inclusion hWb) (inclusion_injective _)
  obtain ⟨R,hR⟩ := (IsElementaryAbelian.isPGroup 2 (Z (family P) a)).comap_subtype (K := W) |>.exists_le_sylow
  obtain ⟨T,hT⟩ := (IsElementaryAbelian.isPGroup 2 (Z (family P) c)).comap_subtype (K := W) |>.exists_le_sylow
  have hAR : Z (family P) a ≤ (R : Subgroup W).map W.subtype := by
    intro x hx
    exact mem_map_of_mem W.subtype (hR (show (⟨x,mem_sup_left hx⟩ : W) ∈
      (Z (family P) a).subgroupOf W from hx))
  have hCT : Z (family P) c ≤ (T : Subgroup W).map W.subtype := by
    intro x hx
    exact mem_map_of_mem W.subtype (hT (show (⟨x,mem_sup_right hx⟩ : W) ∈
      (Z (family P) c).subgroupOf W from hx))
  have hea : ¬ Z (family P) a ≤ Q (family P) b :=
    fun he => hc.2 (he.trans (source_Z_Q_U h b).2)
  have hec : ¬ Z (family P) c ≤ Q (family P) b := by
    obtain ⟨g,_,hz,hq,_⟩ := source_neighbor_conjugate h hab hbc
    intro he
    apply hea
    apply (map_le_map_iff_of_injective (f := (MulAut.conj g).toMonoidHom)
      (MulAut.conj g).injective).mp
    rwa [hz,hq]
  have hRa : (R : Subgroup W).map W.subtype ≤ stabilizer (family P) a := by
    obtain ⟨w,hw,hRw⟩ := pGroup_fixes_neighbor h hB d hab _ (R.isPGroup'.map W.subtype)
      ((map_subtype_le _).trans hWb)
    have he := source_elementary_escape_unique_neighbor h hB d hab.symm hw Mb
      (Z (family P) a) hZa (Z_le_stabilizer _ a) (hAR.trans hRw) hea
    exact he ▸ hRw
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq W R T
  have hTga : (T : Subgroup W).map W.subtype ≤ stabilizer (family P) ((g : G) • a) := by
    rw [←hg]
    change ((R : Subgroup W).map (MulAut.conj g).toMonoidHom).map W.subtype ≤ _
    rw [map_map]
    have he : W.subtype.comp (MulAut.conj g).toMonoidHom =
        (MulAut.conj (g : G)).toMonoidHom.comp W.subtype := by ext x; rfl
    rw [he,←map_map,stabilizer_translate]
    exact map_mono hRa
  have hbga : (graph (family P)).Adj b ((g : G) • a) := by
    have hh := (Subgroup.CosetGeometry.translationGraphIso (family P) (g : G)).map_adj_iff.mpr hab.symm
    change (graph (family P)).Adj ((g : G) • b) ((g : G) • a) at hh
    rwa [show (g : G) • b = b from hWb g.property] at hh
  exact ⟨g,g.property,source_elementary_escape_unique_neighbor h hB d hbc hbga Mb
    (Z (family P) c) hZc (Z_le_stabilizer _ c) (hCT.trans hTga) hec⟩

/-- The mixed core-center intersection identities of (11.3)(a), for all
 beta rank-one rows and without any cubic-degree hypothesis. -/
theorem source_rankOne_mixed_center_intersections (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    {a b c : Vertex (family P)} (hc : IsCriticalPair (family P) a b)
    (hb : DGS85.b (family P) = 1) (hbc : (graph (family P)).Adj b c)
    (Mb : IsRankOneModel (d.localGroup b ⧸ pCore 2 (d.localGroup b))) :
    Z (family P) a ⊓ Q (family P) c = Z (family P) a ⊓ Z (family P) c ∧
      Q (family P) a ⊓ Z (family P) c = Z (family P) a ⊓ Z (family P) c := by
  let := finite_endpoints h
  have hZa := (source_Z_Q_U h a).1.trans (map_subtype_le _)
  have hZc := (source_Z_Q_U h c).1.trans (map_subtype_le _)
  obtain ⟨g,hg,hga⟩ := source_rankOne_center_pair_moves h hB d hc hb hbc Mb
  have hcentral : Z (family P) a ⊔ Z (family P) c ≤
      centralizer (Z (family P) a ⊓ Q (family P) c : Set G) := by
    apply sup_le
    · exact (le_centralizer_iff.mp (source_core_centralizes_center h a)).trans
        (centralizer_le (inf_le_left.trans hZa))
    · exact (le_centralizer_iff.mp (source_core_centralizes_center h c)).trans (centralizer_le inf_le_right)
  have hcentral' : Z (family P) a ⊔ Z (family P) c ≤
      centralizer (Q (family P) a ⊓ Z (family P) c : Set G) := by
    apply sup_le
    · exact (le_centralizer_iff.mp (source_core_centralizes_center h a)).trans (centralizer_le inf_le_left)
    · exact (le_centralizer_iff.mp (source_core_centralizes_center h c)).trans
        (centralizer_le (inf_le_right.trans hZc))
  constructor
  · apply le_antisymm ?_ (inf_le_inf_left _ hZc)
    intro x hx
    refine ⟨hx.1,?_⟩
    have hm := mem_map_of_mem (MulAut.conj g).toMonoidHom hx.1
    rw [←Z_translate,hga] at hm
    have hh := mem_centralizer_iff.mp (hcentral hg) x hx
    change g*x*g⁻¹ ∈ Z (family P) c at hm
    change x ∈ Z (family P) c
    simpa only [←hh,mul_inv_cancel_right] using hm
  · apply le_antisymm ?_ (inf_le_inf_right _ hZa)
    intro x hx
    refine ⟨?_,hx.2⟩
    have hm := mem_map_of_mem (MulAut.conj g⁻¹).toMonoidHom hx.2
    rw [←Z_translate,←hga,inv_smul_smul] at hm
    have hh := mem_centralizer_iff.mp (hcentral' (inv_mem hg)) x hx
    change g⁻¹*x*(g⁻¹)⁻¹ ∈ Z (family P) a at hm
    change x ∈ Z (family P) a
    simpa only [←hh,mul_inv_cancel_right] using hm

variable {k : Type*} [Field k] [Finite k] [CharP k 2]

/-- All mixed intersections equal the actual beta center, with a linear
 alpha marking and every beta row retained. -/
theorem source_linear_rankOne_center_intersections (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    {a b c : Vertex (family P)} (hc : IsCriticalPair (family P) a b)
    (hb : DGS85.b (family P) = 1) (hcomm : ⁅Z (family P) a,Z (family P) b⁆ = ⊥)
    (hbc : (graph (family P)).Adj b c) (hac : a ≠ c)
    (Ma : IsRankOneModel (d.localGroup a ⧸ pCore 2 (d.localGroup a)))
    (Mb : IsRankOneModel (d.localGroup b ⧸ pCore 2 (d.localGroup b)))
    (ea : (d.localGroup a ⧸ pCore 2 (d.localGroup a)) ≃* SL(2,k)) :
    Z (family P) a ⊓ Q (family P) c = Z (family P) b ∧
      Q (family P) a ⊓ Z (family P) c = Z (family P) b ∧
      Z (family P) a ⊓ Z (family P) c = Z (family P) b ∧
      (Z (family P) a ⊓ Q (family P) b) ⊓ (Z (family P) c ⊓ Q (family P) b) =
        Z (family P) b := by
  let := finite_endpoints h
  let := source_center_elementary h a
  let A := Z (family P) a ⊓ Z (family P) c
  let : IsElementaryAbelian 2 A := IsElementaryAbelian.of_le inf_le_left
  have hab := source_critical_one_adjacent hc hb
  obtain ⟨hp,hcore⟩ := source_linear_rankOne_core_identities h hB d hc hb hbc hac Ma Mb ea
  have hsupp : (stabilizer (family P) a ⊓ stabilizer (family P) b).pCoreIn 2 =
      (Z (family P) c ⊓ Q (family P) b) ⊔ Q (family P) a := by
    rw [sup_comm]
    exact alpha_supplement_of_pair_generation _ _ _ _ _ hp hcore
      ((source_Z_Q_U h a).1.trans (map_subtype_le _))
  have hAedge : A ≤ (stabilizer (family P) a ⊓ stabilizer (family P) b).pCoreIn 2 := by
    rw [hsupp]
    exact inf_le_left.trans (((source_Z_Q_U h a).1.trans (map_subtype_le _)).trans le_sup_right)
  have hcentral : A ≤ centralizer
      ((stabilizer (family P) a ⊓ stabilizer (family P) b).pCoreIn 2 : Set G) := by
    rw [hsupp]
    apply le_centralizer_iff.mpr
    apply sup_le
    · exact inf_le_left.trans ((le_centralizer_iff.mp (source_core_centralizes_center h c)).trans
        (centralizer_le (inf_le_right.trans ((source_Z_Q_U h c).1.trans (map_subtype_le _)))))
    · exact (source_core_centralizes_center h a).trans (centralizer_le inf_le_left)
  have hZb := critical_end_center_of_commuting (family P) h.generate
    (fun v => (source_Z_Q_U h v).1) (fun v => (source_Z_Q_U h v).2) hc hcomm
    (d.localGroup b) (d.sylow_or_center b)
  have he : A = Z (family P) b := by
    apply le_antisymm
    · obtain ⟨T,T',hTT⟩ := d.common_sylow b a hab.symm
      have hTE := sylow_image_eq_edge_core (stabilizer (family P) b)
        (stabilizer (family P) b ⊓ stabilizer (family P) a) inf_le_left
        (source_edge_core_sylow h hB hab.symm) T
        (le_inf (map_subtype_le _) (hTT ▸ map_subtype_le _))
      rw [inf_comm] at hTE
      have ho : A ≤ omegaCenterIn ((T : Subgroup (stabilizer (family P) b)).map
          (stabilizer (family P) b).subtype) := by
        rw [hTE]
        intro x hx
        exact (mem_omegaCenterIn_iff _ _).mpr
          ⟨hAedge hx,hcentral hx,elemPow_eq_one_of_isElementaryAbelian x hx⟩
      exact ho.trans (le_iSup (fun R : Sylow 2 (stabilizer (family P) b) =>
        omegaCenterIn ((R : Subgroup (stabilizer (family P) b)).map
          (stabilizer (family P) b).subtype)) T)
    · rw [hZb]
      exact le_inf (local_omega_le_neighbor_Z h d hab.symm) (local_omega_le_neighbor_Z h d hbc)
  have hm := source_rankOne_mixed_center_intersections h hB d hc hb hbc Mb
  refine ⟨hm.1.trans he,hm.2.trans he,he,?_⟩
  apply le_antisymm
  · exact (le_inf (inf_le_left.trans inf_le_left) (inf_le_right.trans inf_le_left)).trans he.le
  · have hQb : Z (family P) b ≤ Q (family P) b := (source_Z_Q_U h b).1.trans (map_subtype_le _)
    exact le_inf (le_inf (he.ge.trans inf_le_left) hQb) (le_inf (he.ge.trans inf_le_right) hQb)

/-- The actual pair span has central derived and Frattini layer lying in
 Z_beta, for all beta rows of a linearly marked alpha branch. -/
theorem source_linear_rankOne_pair_layers (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    {a b c : Vertex (family P)} (hc : IsCriticalPair (family P) a b)
    (hb : DGS85.b (family P) = 1) (hcomm : ⁅Z (family P) a,Z (family P) b⁆ = ⊥)
    (hbc : (graph (family P)).Adj b c) (hac : a ≠ c)
    (Ma : IsRankOneModel (d.localGroup a ⧸ pCore 2 (d.localGroup a)))
    (Mb : IsRankOneModel (d.localGroup b ⧸ pCore 2 (d.localGroup b)))
    (ea : (d.localGroup a ⧸ pCore 2 (d.localGroup a)) ≃* SL(2,k)) :
    let V := pairSpan (Z (family P) a) (Z (family P) c) (Q (family P) b)
    (frattini V).map V.subtype = ⁅V,V⁆ ∧ ⁅V,V⁆ ≤ Z (family P) b ∧ ⁅⁅V,V⁆,V⁆ = ⊥ := by
  have he := (source_linear_rankOne_center_intersections h hB d hc hb hcomm hbc hac Ma Mb ea).2.2.1
  have hs := source_pairSpan_commutator_frattini h (source_critical_one_adjacent hc hb) hbc
  exact ⟨hs.2.1,hs.2.2.1.trans he.le,hs.2.2.2⟩

end CFSG.Quasithin.ChapterF.Source.DGS85.CommutingOneProfile
