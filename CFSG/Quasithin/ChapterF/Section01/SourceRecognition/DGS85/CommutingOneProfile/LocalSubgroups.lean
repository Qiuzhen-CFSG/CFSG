module

public import Theory.GroupTheory.ConjugateSpanOrder
public import Theory.GroupTheory.PCoreLocalSetup

/-!
# The Chapter 11 local spans

The subgroup Vβ in Chapter 11 is the Gβ-conjugate span of Zα ∩ O₂(Gβ).
It is contained in the actual two-core and normal in Gβ. In particular it
differs from the unrestricted span used in Chapter 8 when Zα escapes O₂(Gβ).
The two-seed subgroup V used in (11.3) is kept separate from Vβ.

Source: Delgado--Goldschmidt--Stellmacher, *Groups and Graphs* (1985),
Chapter 11, printed pp.167--168. These definitions use ambient subgroups;
neither ambient finiteness nor a tree is required.
-/

@[expose] public section

open Subgroup

namespace CFSG.Quasithin.ChapterF.Source.DGS85.CommutingOneProfile

variable {G : Type*} [Group G]

/-- Chapter 11's Vβ, with the intersection taken before conjugate generation. -/
def betaSpan (Gβ Zα : Subgroup G) : Subgroup G :=
  conjugateSpanBy (Zα ⊓ Gβ.pCoreIn 2) Gβ

/-- The subgroup generated by the two opposite seeds in (11.3).
When the source proves that the seeds normalize each other, this is their
printed subgroup product. It is not the definition of Vβ. -/
def pairSpan (Zα Zα₂ Qβ : Subgroup G) : Subgroup G :=
  (Zα ⊓ Qβ) ⊔ (Zα₂ ⊓ Qβ)

theorem seed_le_betaSpan (Gβ Zα : Subgroup G) :
    Zα ⊓ Gβ.pCoreIn 2 ≤ betaSpan Gβ Zα :=
  le_conjugateSpanBy _ _

theorem betaSpan_le_core (Gβ Zα : Subgroup G) :
    betaSpan Gβ Zα ≤ Gβ.pCoreIn 2 := by
  apply conjugateSpanBy_le inf_le_right
  simpa only [pCoreIn, normalizer_eq_top, ← MonoidHom.range_eq_map, range_subtype]
    using (pCore 2 Gβ).le_normalizer_map Gβ.subtype

theorem betaSpan_isPGroup (Gβ Zα : Subgroup G) :
    IsPGroup 2 (betaSpan Gβ Zα) :=
  (isPGroup_pCoreIn 2 Gβ).to_le (betaSpan_le_core Gβ Zα)

/-- Normality is asserted inside the vertex stabilizer, not in the ambient group. -/
theorem betaSpan_normal_in_vertex (Gβ Zα : Subgroup G) :
    ((betaSpan Gβ Zα).subgroupOf Gβ).Normal :=
  (normal_subgroupOf_iff_le_normalizer
    ((betaSpan_le_core Gβ Zα).trans (pCoreIn_le 2 Gβ))).mpr
      (le_normalizer_conjugateSpanBy _ _)

/-- Under the Chapter 11 escape condition, the Chapter 8 span is different. -/
theorem betaSpan_ne_unrestricted (Gβ Zα : Subgroup G)
    (hescape : ¬ Zα ≤ Gβ.pCoreIn 2) :
    betaSpan Gβ Zα ≠ conjugateSpanBy Zα Gβ := by
  intro heq
  exact hescape ((le_conjugateSpanBy Zα Gβ).trans
    (heq ▸ betaSpan_le_core Gβ Zα))

theorem pairSpan_le_core (Zα Zα₂ Qβ : Subgroup G) :
    pairSpan Zα Zα₂ Qβ ≤ Qβ :=
  sup_le inf_le_right inf_le_right

/-- A full-size two-seed subgroup is the actual core. -/
theorem pairSpan_eq_core_of_card (Zα Zα₂ Qβ : Subgroup G) [Finite Qβ]
    (hcard : Nat.card (pairSpan Zα Zα₂ Qβ) = Nat.card Qβ) :
    pairSpan Zα Zα₂ Qβ = Qβ :=
  eq_of_le_of_card_ge (pairSpan_le_core Zα Zα₂ Qβ) hcard.ge

end CFSG.Quasithin.ChapterF.Source.DGS85.CommutingOneProfile
