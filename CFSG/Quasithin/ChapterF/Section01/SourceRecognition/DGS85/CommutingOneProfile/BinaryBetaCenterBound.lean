variable {G : Type*} [Group G] {P : Fin 2 → Subgroup G} {B : Subgroup G}
private theorem center_fixed_edge (h : LocallyRankOneTriple P B)
    (hB : ∃ R : Sylow 2 B, (R : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    {a b : Vertex (family P)} (hc : IsCriticalPair (family P) a b)
    (hb : DGS85.b (family P) = 1) (hcomm : ⁅Z (family P) a,Z (family P) b⁆ = ⊥) :
    Z (family P) a ⊓ centralizer ((stabilizer (family P) a ⊓ stabilizer (family P) b).pCoreIn 2 : Set G) =
      Z (family P) b := by
  let := finite_endpoints h
  let := source_center_elementary h a
  have hab := source_critical_one_adjacent hc hb
  let E := stabilizer (family P) a ⊓ stabilizer (family P) b
  let : Finite E := Finite.of_injective (inclusion (show E ≤ stabilizer (family P) a from inf_le_left)) (inclusion_injective _)
  obtain ⟨T,hT⟩ := source_edge_vertex_sylow h hS hab.symm
  have he := sylow_image_eq_edge_core (stabilizer (family P) b)
    (stabilizer (family P) b ⊓ stabilizer (family P) a) inf_le_left
    (source_edge_core_sylow h hB hab.symm) T hT
  rw [inf_comm] at he
  have hZaE : Z (family P) a ≤ E.pCoreIn 2 :=
    pGroup_le_core_of_core_sylow E _
      (((source_Z_Q_U h a).1.trans (map_subtype_le _)).trans
        ((source_Z_Q_U h a).2.trans (ballKernel_one_le_edge _ hab)))
      (IsElementaryAbelian.isPGroup 2 _) (source_edge_core_sylow h hB hab)
  apply le_antisymm
  · intro x hx
    have hm : x ∈ omegaCenterIn ((T : Subgroup (stabilizer (family P) b)).map
        (stabilizer (family P) b).subtype) := by
      rw [he]
      exact (mem_omegaCenterIn_iff _ _).mpr
        ⟨hZaE hx.1,hx.2,elemPow_eq_one_of_isElementaryAbelian x hx.1⟩
    exact (le_iSup (fun R : Sylow 2 (stabilizer (family P) b) => omegaCenterIn
      ((R : Subgroup (stabilizer (family P) b)).map (stabilizer (family P) b).subtype)) T) hm
  · apply le_inf (source_commuting_one_center_le_neighbor h hB hS hc hb hcomm hab.symm)
    have hz := (source_commuting_one_center_identities h hB hS hc hb hcomm).1
    intro x hx
    rw [hz] at hx
    have hh := ((mem_omegaCenterIn_iff _ _).mp hx).2.1
    exact centralizer_le (he ▸ sylow_le_sylowGenerated (stabilizer (family P) b) T) hh


open Representation Representation.BinaryOffender

private theorem exists_center_action (h : LocallyRankOneTriple P B)
    (a : Vertex (family P)) {D : Type*} [Group D]
    (e : (stabilizer (family P) a ⧸ pCore 2 (stabilizer (family P) a)) ≃* D) :
    letI := source_center_elementary h a
    ∃ ρ : Representation (ZMod 2) D (Additive (Z (family P) a)),
      ∀ (l : stabilizer (family P) a) (z : Additive (Z (family P) a)),
        ((ρ (e (QuotientGroup.mk' (pCore 2 (stabilizer (family P) a)) l)) z).toMul : G) =
          (l : G) * z.toMul * (l : G)⁻¹ := by
  let := finite_endpoints h
  let := source_center_elementary h a
  let H := stabilizer (family P) a
  let V := Z (family P) a
  have hn : H ≤ normalizer (V : Set G) :=
    (normal_subgroupOf_iff_le_normalizer (Z_le_stabilizer _ a)).mp (Z_normal _ a)
  let α := V.normalizerMonoidHom.comp (inclusion hn)
  have hker : pCore 2 H ≤ α.ker := by
    intro l hl
    apply MulEquiv.ext
    intro z
    apply Subtype.ext
    have hh := (source_core_centralizes_center h a) (mem_map_of_mem H.subtype hl)
    change (l : G) * (z : G) * (l : G)⁻¹ = z
    have he := hh z z.property
    change (z : G) * (l : G) = (l : G) * (z : G) at he
    rw [←he,mul_inv_cancel_right]
  let β := QuotientGroup.lift (pCore 2 H) α hker
  let γ := β.comp e.symm.toMonoidHom
  let : MulDistribMulAction D V := MulDistribMulAction.compHom _ γ
  refine ⟨Representation.ofElementaryAbelianAction,?_⟩
  intro l z
  change ((β (e.symm (e (QuotientGroup.mk' (pCore 2 H) l)))) z.toMul : G) = _
  rw [e.symm_apply_apply]
  rfl

private theorem fixedSpace_eq_ambient (V H A : Subgroup G)
    [IsElementaryAbelian 2 V] {D : Type*} [Group D]
    (q : H →* D) (ρ : Representation (ZMod 2) D (Additive V))
    (hact : ∀ (l : H) (z : Additive V), ((ρ (q l) z).toMul : G) =
      (l : G) * z.toMul * (l : G)⁻¹) (T : Subgroup H)
    (he : V ⊓ centralizer (T.map H.subtype : Set G) = A) :
    fixedSpace ρ (T.map q) = AddSubgroup.toZModSubmodule 2 (A.subgroupOf V).toAddSubgroup := by
  ext z
  change (∀ t : T.map q, ρ t.val z = z) ↔ (z.toMul : G) ∈ A
  rw [←he]
  constructor
  · intro hz
    refine ⟨z.toMul.property,?_⟩
    rintro x ⟨t,ht,rfl⟩
    have hh := congrArg (fun w : Additive V => (w.toMul : G))
      (hz ⟨q t,mem_map_of_mem q ht⟩)
    change ((ρ (q t) z).toMul : G) = z.toMul at hh
    rw [hact] at hh
    exact mul_inv_eq_iff_eq_mul.mp hh
  · rintro ⟨_,hz⟩ ⟨_,t,ht,rfl⟩
    apply Additive.toMul.injective
    apply Subtype.ext
    change ((ρ (q t) z).toMul : G) = z.toMul
    rw [hact,hz (t : G) (mem_map_of_mem H.subtype ht),mul_inv_cancel_right]


private theorem binary_rankOne {H : Type*} [Group H] (e : H ≃* SL(2,ZMod 2)) :
    IsRankOneModel H := by
  let f : SL(2,ZMod 2) ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 2) (ZMod 2) :=
    MulEquiv.ofBijective (BenderSuzuki.Converse.pi (ZMod 2))
      ⟨BenderSuzuki.Converse.pi_injective,BenderSuzuki.Converse.pi_surjective⟩
  exact .linear 1 (by decide) ⟨ZMod 2,inferInstance,inferInstance,by simp,⟨e.trans f⟩⟩

variable {k : Type*} [Field k] [Finite k] [CharP k 2]

private theorem complementary_card_ne_four_square
    {V : Type*} [AddCommGroup V] [Module (ZMod 2) V] [Finite V]
    (ρ : Representation (ZMod 2) SL(2,k) V)
    (T R : Sylow 2 SL(2,k)) (hc : IsCompl (fixedSpace ρ T) (fixedSpace ρ R))
    (n : ℕ) (hn : 1 < n) (hk : Nat.card k = 2^n) :
    Nat.card V ≠ 4 * Nat.card k ^ 2 := by
  obtain ⟨m,E,_⟩ := Representation.SL2SylowFixedRecognition.natural_of_complementary_sylow_fixed
    ρ T R hc n hn hk
  intro hcard
  have hh := Nat.card_congr E.toEquiv
  rw [hcard,Nat.card_fun,Nat.card_fun,Nat.card_fin,Nat.card_fin,hk] at hh
  have he : 2^(2 + n*2) = 2^(n*(2*m)) := by
    simpa only [pow_add,pow_mul,show 2^2 = 4 by decide] using hh
  have he' := Nat.pow_right_injective (by decide : 1 < 2) he
  have hm : 2 ≤ m := by
    by_contra hm
    have hh' : n*(2*m) ≤ n*2 := Nat.mul_le_mul_left n (by omega)
    omega
  have hh' : n*4 ≤ n*(2*m) := Nat.mul_le_mul_left n (by omega)
  nlinarith

/-- The source count and the literal conjugation action exclude the maximal
center for every alpha field of exponent greater than one. -/
private theorem source_linear_center_card_le_field_of_ratio (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    (d : EarlierLocalTheorems (family P))
    {a b c : Vertex (family P)} (hc : IsCriticalPair (family P) a b)
    (hb : DGS85.b (family P) = 1) (hcomm : ⁅Z (family P) a,Z (family P) b⁆ = ⊥)
    (hbc : (graph (family P)).Adj b c) (hac : a ≠ c)
    (Ma : IsRankOneModel (d.localGroup a ⧸ pCore 2 (d.localGroup a)))
    (ea : (d.localGroup a ⧸ pCore 2 (d.localGroup a)) ≃* SL(2,k))
    (ef : (stabilizer (family P) a ⧸ pCore 2 (stabilizer (family P) a)) ≃* SL(2,k))
    (Mb : IsRankOneModel (d.localGroup b ⧸ pCore 2 (d.localGroup b)))
    (hratio : Nat.card (Z (family P) a) = 2 * Nat.card k * Nat.card (Z (family P) b))
    (n : ℕ) (hn : 0 < n) (hk : Nat.card k = 2^n)
    (g : G) (hga : g ∈ stabilizer (family P) a) (hgb : g • b ≠ b) :
    Nat.card (Z (family P) b) ≤ Nat.card k := by
  let := finite_endpoints h
  let := source_center_elementary h a
  let := source_center_elementary h b
  let H := stabilizer (family P) a
  let V := Z (family P) a
  let A := Z (family P) b
  let C := Z (family P) (g • b)
  let : Finite V := Finite.of_injective
    (inclusion (Z_le_stabilizer _ a)) (inclusion_injective _)
  let : Finite A := Finite.of_injective
    (inclusion (Z_le_stabilizer _ b)) (inclusion_injective _)
  have hab := source_critical_one_adjacent hc hb
  have hAV : A ≤ V := source_commuting_one_center_le_neighbor h hB hS hc hb hcomm hab.symm
  have hCV : C ≤ V := by
    have hh := map_mono (f := (MulAut.conj g).toMonoidHom) hAV
    rwa [←Z_translate,←Z_translate,show g • a = a from hga] at hh
  have hnorm : C ≤ normalizer (A : Set G) :=
    (hCV.trans ((le_centralizer_iff_isMulCommutative.mpr
      (inferInstance : IsMulCommutative V)).trans (centralizer_le hAV))).trans
        (Subgroup.centralizer_le_normalizer _)
  have hdis : Disjoint A C := source_linear_rankOne_beta_centers_disjoint
    h hB d hc hb hcomm hbc hac Ma Mb ea g hga hgb
  have hCcard : Nat.card C = Nat.card A := by
    dsimp [C,A]
    rw [Z_translate,card_map_of_injective (MulAut.conj g).injective]
  have hprod := card_sup_eq_mul_of_normalizes_of_disjoint A C hnorm hdis
  rw [hCcard] at hprod
  have hVcard : Nat.card V = 2 * Nat.card k * Nat.card A :=
    hratio
  have hupper := Nat.card_le_card_of_injective (inclusion (sup_le hAV hCV))
    (inclusion_injective _)
  rw [hprod,hVcard] at hupper
  have hpos : 0 < Nat.card A := Nat.card_pos
  have hle : Nat.card A ≤ 2 * Nat.card k := by nlinarith
  have hne : Nat.card A ≠ 2 * Nat.card k := by
    intro heq
    have hspan : A ⊔ C = V := eq_of_le_of_card_ge (sup_le hAV hCV) (by
      rw [hprod,hVcard,heq])
    let q := ef.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 H))
    have hq : Function.Surjective q := ef.surjective.comp (QuotientGroup.mk'_surjective _)
    obtain ⟨ρ,hact⟩ := exists_center_action h a ef
    have hab' : (graph (family P)).Adj a (g • b) := by
      have hh := (Subgroup.CosetGeometry.translationGraphIso (family P) g).map_adj_iff.mpr hab
      change (graph (family P)).Adj (g • a) (g • b) at hh
      rwa [show g • a = a from hga] at hh
    have hc' : IsCriticalPair (family P) a (g • b) := by
      simpa only [show g • a = a from hga] using criticalPair_translate (family P) hc g
    have hcomm' : ⁅Z (family P) a,Z (family P) (g • b)⁆ = ⊥ := by
      have hh := commuting_centers_translate (family P) a b g
      simpa only [show g • a = a from hga,hcomm,Subgroup.map_bot] using hh
    obtain ⟨T,hT⟩ := source_edge_vertex_sylow h hS hab
    obtain ⟨R,hR⟩ := source_edge_vertex_sylow h hS hab'
    have hTeq := sylow_image_eq_edge_core H _ inf_le_left
      (source_edge_core_sylow h hB hab) T hT
    have hReq := sylow_image_eq_edge_core H _ inf_le_left
      (source_edge_core_sylow h hB hab') R hR
    have hfT := fixedSpace_eq_ambient V H A q ρ hact T
      (hTeq ▸ center_fixed_edge h hB hS hc hb hcomm)
    have hfR := fixedSpace_eq_ambient V H C q ρ hact R
      (hReq ▸ center_fixed_edge h hB hS hc' hb hcomm')
    have hcompl : IsCompl (A.subgroupOf V) (C.subgroupOf V) := by
      constructor
      · apply disjoint_iff.mpr
        apply bot_unique
        intro x hx
        apply mem_bot.mpr
        apply Subtype.ext
        exact mem_bot.mp (hdis.le_bot ⟨hx.1,hx.2⟩)
      · apply codisjoint_iff.mpr
        rw [←subgroupOf_sup hAV hCV,hspan,subgroupOf_self]
    let φ : Subgroup V ≃o Submodule (ZMod 2) (Additive V) :=
      Subgroup.toAddSubgroup.trans (AddSubgroup.toZModSubmodule 2)
    have hfixed : IsCompl (fixedSpace ρ (T.mapSurjective hq)) (fixedSpace ρ (R.mapSurjective hq)) := by
      change IsCompl (fixedSpace ρ ((T : Subgroup H).map q)) (fixedSpace ρ ((R : Subgroup H).map q))
      rw [hfT,hfR]
      exact φ.isCompl_iff.mp hcompl
    have hn' : 1 < n := by
      have hnot := source_alpha_linear_field_card_ne_two h hB d hc hb hcomm hbc hac
        Mb ea
      have hn1 : n ≠ 1 := by intro he; simp only [he,pow_one] at hk; exact hnot hk
      omega
    apply complementary_card_ne_four_square ρ (T.mapSurjective hq) (R.mapSurjective hq) hfixed n hn' hk
    change Nat.card V = _
    rw [hVcard,heq]
    ring
  obtain ⟨m,hm⟩ := (IsElementaryAbelian.isPGroup 2 A).exists_card_eq
  have hmle : m ≤ n := by
    have hh : 2^m < 2^(n+1) := by rw [pow_succ,←hk,←hm]; omega
    exact Nat.le_of_lt_succ ((Nat.pow_lt_pow_iff_right (by decide : 1 < 2)).mp hh)
  rw [hm,hk]
  exact Nat.pow_le_pow_right (by decide) hmle


/-- The binary-beta center is no larger than the arbitrary alpha field. -/
theorem source_linear_binary_center_card_le_field (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    (d : EarlierLocalTheorems (family P))
    {a b c : Vertex (family P)} (hc : IsCriticalPair (family P) a b)
    (hb : DGS85.b (family P) = 1) (hcomm : ⁅Z (family P) a,Z (family P) b⁆ = ⊥)
    (hbc : (graph (family P)).Adj b c) (hac : a ≠ c)
    (Ma : IsRankOneModel (d.localGroup a ⧸ pCore 2 (d.localGroup a)))
    (ea : (d.localGroup a ⧸ pCore 2 (d.localGroup a)) ≃* SL(2,k))
    (ef : (stabilizer (family P) a ⧸ pCore 2 (stabilizer (family P) a)) ≃* SL(2,k))
    (eb : (d.localGroup b ⧸ pCore 2 (d.localGroup b)) ≃* SL(2,ZMod 2))
    (n : ℕ) (hn : 0 < n) (hk : Nat.card k = 2^n)
    (g : G) (hga : g ∈ stabilizer (family P) a) (hgb : g • b ≠ b) :
    Nat.card (Z (family P) b) ≤ Nat.card k := by
  exact source_linear_center_card_le_field_of_ratio h hB hS d hc hb hcomm hbc hac
    Ma ea ef (binary_rankOne eb)
    (source_linear_binary_center_card_ratio h hB d hc hb hcomm hbc hac Ma ea eb).2
    n hn hk g hga hgb

/-- At an escaping turn, the actual remaining central layer has order at
most half the alpha field. All maps are the original graph quotient maps. -/
theorem source_linear_binary_escape_layer_bound (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    (d : EarlierLocalTheorems (family P))
    {a b c : Vertex (family P)} (hc : IsCriticalPair (family P) a b)
    (hb : DGS85.b (family P) = 1) (hcomm : ⁅Z (family P) a,Z (family P) b⁆ = ⊥)
    (hbc : (graph (family P)).Adj b c) (hac : a ≠ c)
    (Ma : IsRankOneModel (d.localGroup a ⧸ pCore 2 (d.localGroup a)))
    (ea : (d.localGroup a ⧸ pCore 2 (d.localGroup a)) ≃* SL(2,k))
    (ef : (stabilizer (family P) a ⧸ pCore 2 (stabilizer (family P) a)) ≃* SL(2,k))
    (eb : (d.localGroup b ⧸ pCore 2 (d.localGroup b)) ≃* SL(2,ZMod 2))
    (n : ℕ) (hn : 0 < n) (hk : Nat.card k = 2^n)
    (t : G) (hta : t ∈ stabilizer (family P) a) (htb : t • b ≠ b)
    (hesc : ¬ Z (family P) b ≤ Q (family P) (t • b)) :
    2 * Nat.card (Z (family P) b ⊓ Q (family P) (t • b) : Subgroup G) ≤ Nat.card k := by
  let := finite_endpoints h
  let := source_center_elementary h b
  have hab := source_critical_one_adjacent hc hb
  have hab' : (graph (family P)).Adj a (t • b) := by
    have hh := (Subgroup.CosetGeometry.translationGraphIso (family P) t).map_adj_iff.mpr hab
    change (graph (family P)).Adj (t • a) (t • b) at hh
    rwa [show t • a = a from hta] at hh
  let eL := (MulEquiv.subgroupCongr (d.conjugate t b)).trans
    ((d.localGroup b).equivMapOfInjective (MulAut.conj t).toMonoidHom
      (MulAut.conj t).injective).symm
  let eb' := (QuotientGroup.congr _ _ eL (pCore_map_iso 2 eL)).trans eb
  have hZa : Z (family P) b ≤ Z (family P) a :=
    source_commuting_one_center_le_neighbor h hB hS hc hb hcomm hab.symm
  have hi := source_binary_two_subgroup_index h d (t • b) eb' (Z (family P) b)
    (IsElementaryAbelian.isPGroup 2 _) (hZa.trans
      (((source_Z_Q_U h a).1.trans (map_subtype_le _)).trans
        ((source_Z_Q_U h a).2.trans ((ballKernel_one_le_edge _ hab').trans inf_le_right)))) hesc
  have he := relIndex_mul_relIndex (⊥ : Subgroup G)
    (Z (family P) b ⊓ Q (family P) (t • b)) (Z (family P) b) bot_le inf_le_left
  rw [relIndex_bot_left,relIndex_bot_left,inf_relIndex_left,hi] at he
  rw [mul_comm,he]
  exact source_linear_binary_center_card_le_field h hB hS d hc hb hcomm hbc hac
    Ma ea ef eb n hn hk t hta htb

/-- The actual source module and count determine both its field parameter
and its Sylow-fixed order. -/
private theorem source_linear_parameter_two_of_center_ratio (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    (d : EarlierLocalTheorems (family P))
    {a b c : Vertex (family P)} (hc : IsCriticalPair (family P) a b)
    (hb : DGS85.b (family P) = 1) (hcomm : ⁅Z (family P) a,Z (family P) b⁆ = ⊥)
    (hbc : (graph (family P)).Adj b c) (hac : a ≠ c)
    (Ma : IsRankOneModel (d.localGroup a ⧸ pCore 2 (d.localGroup a)))
    (ea : (d.localGroup a ⧸ pCore 2 (d.localGroup a)) ≃* SL(2,k))
    (ef : (stabilizer (family P) a ⧸ pCore 2 (stabilizer (family P) a)) ≃* SL(2,k))
    (Mb : IsRankOneModel (d.localGroup b ⧸ pCore 2 (d.localGroup b)))
    (hratio : Nat.card (Z (family P) a) = 2 * Nat.card k * Nat.card (Z (family P) b))
    (n : ℕ) (hn : 0 < n) (hk : Nat.card k = 2^n)
    (g : G) (hga : g ∈ stabilizer (family P) a) (hgb : g • b ≠ b) :
    n = 2 ∧ Nat.card (Z (family P) b) = 2 := by
  let := finite_endpoints h
  let := source_center_elementary h a
  let H := stabilizer (family P) a
  let V := Z (family P) a
  let A := Z (family P) b
  let C := Z (family P) (g • b)
  let : Finite V := Finite.of_injective
    (inclusion (Z_le_stabilizer _ a)) (inclusion_injective _)
  have hab := source_critical_one_adjacent hc hb
  have hVne : V ≠ ⊥ := by
    intro he
    apply hc.2
    change V ≤ U (family P) b
    rw [he]
    exact bot_le
  let : Nontrivial V := (Subgroup.nontrivial_iff_ne_bot V).mpr hVne
  let q := ef.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 H))
  have hq : Function.Surjective q := ef.surjective.comp (QuotientGroup.mk'_surjective _)
  obtain ⟨ρ,hact⟩ := exists_center_action h a ef
  have hab' : (graph (family P)).Adj a (g • b) := by
    have hh := (Subgroup.CosetGeometry.translationGraphIso (family P) g).map_adj_iff.mpr hab
    change (graph (family P)).Adj (g • a) (g • b) at hh
    rwa [show g • a = a from hga] at hh
  have hc' : IsCriticalPair (family P) a (g • b) := by
    simpa only [show g • a = a from hga] using criticalPair_translate (family P) hc g
  have hcomm' : ⁅Z (family P) a,Z (family P) (g • b)⁆ = ⊥ := by
    have hh := commuting_centers_translate (family P) a b g
    simpa only [show g • a = a from hga,hcomm,Subgroup.map_bot] using hh
  obtain ⟨T,hT⟩ := source_edge_vertex_sylow h hS hab
  obtain ⟨R,hR⟩ := source_edge_vertex_sylow h hS hab'
  have hTeq := sylow_image_eq_edge_core H _ inf_le_left
    (source_edge_core_sylow h hB hab) T hT
  have hReq := sylow_image_eq_edge_core H _ inf_le_left
    (source_edge_core_sylow h hB hab') R hR
  have hfT := fixedSpace_eq_ambient V H A q ρ hact T
    (hTeq ▸ center_fixed_edge h hB hS hc hb hcomm)
  have hfR := fixedSpace_eq_ambient V H C q ρ hact R
    (hReq ▸ center_fixed_edge h hB hS hc' hb hcomm')
  have hAV : A ≤ V := source_commuting_one_center_le_neighbor h hB hS hc hb hcomm hab.symm
  have hdis : Disjoint A C := source_linear_rankOne_beta_centers_disjoint
    h hB d hc hb hcomm hbc hac Ma Mb ea g hga hgb
  have hfix : ρ.invariants = ⊥ := by
    apply bot_unique
    intro v hv
    have hTv : v ∈ fixedSpace ρ ((T : Subgroup H).map q) := fun u => hv u.val
    have hRv : v ∈ fixedSpace ρ ((R : Subgroup H).map q) := fun u => hv u.val
    rw [hfT] at hTv
    rw [hfR] at hRv
    change (v.toMul : G) ∈ A at hTv
    change (v.toMul : G) ∈ C at hRv
    change v = 0
    apply Additive.toMul.injective
    apply Subtype.ext
    exact mem_bot.mp (hdis.le_bot ⟨hTv,hRv⟩)
  have hgen := source_center_representation_generated h a T q ρ hact
  have hfixedcard : Nat.card (fixedSpace ρ (T.mapSurjective hq)) = Nat.card A := by
    change Nat.card (fixedSpace ρ ((T : Subgroup H).map q)) = _
    rw [hfT]
    change Nat.card (A.subgroupOf V) = Nat.card A
    exact Nat.card_congr (subgroupOfEquivOfLe hAV).toEquiv
  have hcount : Nat.card (Additive V) =
      2 * Nat.card k * Nat.card (fixedSpace ρ (T.mapSurjective hq)) := by
    rw [hfixedcard]
    exact hratio
  have hbound : Nat.card (fixedSpace ρ (T.mapSurjective hq)) ≤ Nat.card k := by
    rw [hfixedcard]
    exact source_linear_center_card_le_field_of_ratio h hB hS d hc hb hcomm hbc hac
      Ma ea ef Mb hratio n hn hk g hga hgb
  have hn' : 1 < n := by
    have hnot := source_alpha_linear_field_card_ne_two h hB d hc hb hcomm hbc hac
      Mb ea
    have hn1 : n ≠ 1 := by intro he; simp only [he,pow_one] at hk; exact hnot hk
    omega
  have hp := Representation.SL2.parameter_two_of_fixed_generated_order
    ρ (T.mapSurjective hq) hgen hfix hn' hk hcount hbound
  exact ⟨hp.1,hfixedcard ▸ hp.2⟩

/-- The arbitrary linear-alpha/binary-beta source branch has q_alpha=4
and beta center of order two. The field relation is proved, not assumed. -/
theorem source_linear_binary_parameter_two (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    (d : EarlierLocalTheorems (family P))
    {a b c : Vertex (family P)} (hc : IsCriticalPair (family P) a b)
    (hb : DGS85.b (family P) = 1) (hcomm : ⁅Z (family P) a,Z (family P) b⁆ = ⊥)
    (hbc : (graph (family P)).Adj b c) (hac : a ≠ c)
    (Ma : IsRankOneModel (d.localGroup a ⧸ pCore 2 (d.localGroup a)))
    (ea : (d.localGroup a ⧸ pCore 2 (d.localGroup a)) ≃* SL(2,k))
    (ef : (stabilizer (family P) a ⧸ pCore 2 (stabilizer (family P) a)) ≃* SL(2,k))
    (eb : (d.localGroup b ⧸ pCore 2 (d.localGroup b)) ≃* SL(2,ZMod 2))
    (n : ℕ) (hn : 0 < n) (hk : Nat.card k = 2^n)
    (g : G) (hga : g ∈ stabilizer (family P) a) (hgb : g • b ≠ b) :
    n = 2 ∧ Nat.card (Z (family P) b) = 2 := by
  exact source_linear_parameter_two_of_center_ratio h hB hS d hc hb hcomm hbc hac
    Ma ea ef (binary_rankOne eb)
    (source_linear_binary_center_card_ratio h hB d hc hb hcomm hbc hac Ma ea eb).2
    n hn hk g hga hgb

/-- The dihedral-beta candidate has the same forced alpha field and center
order; its separate actual extraspecial obstruction can therefore be applied. -/
theorem source_linear_dihedral_parameter_two (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    (d : EarlierLocalTheorems (family P))
    {a b c : Vertex (family P)} (hc : IsCriticalPair (family P) a b)
    (hb : DGS85.b (family P) = 1) (hcomm : ⁅Z (family P) a,Z (family P) b⁆ = ⊥)
    (hbc : (graph (family P)).Adj b c) (hac : a ≠ c)
    (Ma : IsRankOneModel (d.localGroup a ⧸ pCore 2 (d.localGroup a)))
    (ea : (d.localGroup a ⧸ pCore 2 (d.localGroup a)) ≃* SL(2,k))
    (ef : (stabilizer (family P) a ⧸ pCore 2 (stabilizer (family P) a)) ≃* SL(2,k))
    (eb : (d.localGroup b ⧸ pCore 2 (d.localGroup b)) ≃* DihedralGroup 5)
    (n : ℕ) (hn : 0 < n) (hk : Nat.card k = 2^n)
    (g : G) (hga : g ∈ stabilizer (family P) a) (hgb : g • b ≠ b) :
    n = 2 ∧ Nat.card (Z (family P) b) = 2 := by
  exact source_linear_parameter_two_of_center_ratio h hB hS d hc hb hcomm hbc hac
    Ma ea ef (.dihedral ⟨eb⟩)
    (source_linear_dihedral_center_card_ratio h hB d hc hb hcomm hbc hac Ma ea eb).2
    n hn hk g hga hgb

