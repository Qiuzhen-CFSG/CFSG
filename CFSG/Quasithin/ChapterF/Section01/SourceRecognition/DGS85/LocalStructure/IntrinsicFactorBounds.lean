public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.LocalStructure.EnlargedQuadraticBounds
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.LocalStructure.IntrinsicProjectiveReciprocity
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingNontrivial.FactorModule
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingNontrivial.KernelControl
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingTrivial.ReorientedConfiguration

/-!
# Intrinsic ending factors and the small-projective reciprocal branch

The actual residual constituent of V_alpha' is nonzero and generated by
its Sylow fixed spaces. The original starred overgroup theorem now gives
faithful Sylow action without recognizing the enlarged quotient. Applying
the full enlarged-quotient estimate proves the ending-factor inequality
of DGS 8.2 for every original rank-one row, including order 144. Equality
forces an actual linear ending quotient, with its original core unchanged.

For an original PSU₃(2) starting vertex, reverse containment makes
Z_alpha intersect Q_alpha' centralize V_alpha' by the previously proved
strict displacement argument. Kernel control identifies the exact
centralizer in Z_alpha with that intersection. The new ending-factor
bound is then incompatible with the strict square displacement on
Z_alpha. Thus this source branch has reciprocal escape and an actual
reverse critical pair without an enlarged-model premise on either orbit.

All actions, centers, cores and indices use the same reduced completion
and full-Borel inclusion. No finite completion or tree is assumed.
Unrestricted 6.1 enlargement and the other source branches remain separate.
Source: DGS, *Groups and Graphs* (1985), 8.2, printed pp.134--135;
6.0--6.2, pp.118--119, and the fixed-generation correction to 5.12.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender
open Representation.RankOne.QuadraticRecognition Representation.NormalElementaryQuotient
open Theory.GroupTheory.AmalgamGraph Subgroup.CosetGeometry.RankTwo
namespace CFSG.Quasithin.ChapterF.Source.DGS85.Reduction
open CommutingNontrivial CommutingTrivial
variable {G : Type*} [Group G] {L : Fin 2 → Subgroup G} {S : Subgroup G}
local notation "F" => family (fun i => Subgroup.subgroupOf (P₀ L S i) (G₀ L S))

/-- The ending-factor estimate is unconditional on the full original
catalogue. Equality forces the actual ending actor quotient to be linear. -/
theorem reduced_intrinsic_ending_factor_bound (h : HypothesisF11 L S)
    {a beta a' : Vertex F} (hc : IsCriticalPair F a a')
    (hab : (graph F).Adj a beta) (hd : (graph F).dist beta a' + 1 = b F)
    (hb : 1 < b F) (hcomm : ⁅Z F a,Z F a'⁆ = ⊥) :
    (Q F a').relIndex (Z F a) ≤ (centralizer (Z F a : Set (G₀ L S))).relIndex (V F a' 1) ∧
      ((centralizer (Z F a : Set (G₀ L S))).relIndex (V F a' 1) ≤ (Q F a').relIndex (Z F a) →
        ∃ n, 0 < n ∧ ClassicalGroup.IsPSL (graphLocalGroup F a' ⧸ pCore 2 (graphLocalGroup F a')) 2 (2^n)) := by
  let ht := reduced_triple h
  let M := graphLocalGroup F a'
  let D := M ⧸ pCore 2 M
  let A := (V F a' 1).subgroupOf M
  let q := (MulEquiv.refl D).toMonoidHom.comp (QuotientGroup.mk' (pCore 2 M))
  let Aq := ((Z F a).subgroupOf M).map q
  let : ∀ i, Finite (F i) := finite_endpoints ht
  let : Finite M := Finite.of_injective (inclusion (sylowGenerated_le _)) (inclusion_injective _)
  let := neighborhoodIn_normal F a' M (sylowGenerated_le _)
  obtain ⟨hb2,⟨d⟩⟩ := reduced_critical_ending_constituent h hc hab hd hb hcomm (MulEquiv.refl D)
  let := neighborhoodIn_elementary F ht.generate (fun v => (source_Z_Q_U ht v).1)
    (reduced_kernel_sylow h) a' hb2 M
  let : Finite d.space.toSubmodule := d.finiteSpace
  let : d.action.IsIrreducible := d.irreducible
  let : Nontrivial d.space.toSubmodule := Subrepresentation.irreducible_module_nontrivial d.action
  have hnt : d.action ≠ 1 := by
    intro he
    obtain ⟨w,hw⟩ := exists_ne (0 : d.space.toSubmodule)
    apply hw
    apply d.residualFixed.le
    intro g
    change d.action g w = w
    rw [he]
    rfl
  let : IsElementaryAbelian 2 Aq := d.elementary
  obtain ⟨T,hT⟩ := d.elementary.isPGroup.exists_le_sylow
  have hf := graph_intrinsic_fixed_generated_sylow_faithful ht
    (reduced_borel_core_sylow h) (reduced_vertex_sylow h) a' d.action d.generated hnt T
  have hA : 1 < Nat.card Aq := by
    apply Aq.one_lt_card_iff_ne_bot.mpr
    intro he
    have hi := d.actorCard
    change Nat.card Aq = (Q F a').relIndex (Z F a) at hi
    rw [he,card_bot] at hi
    exact hc.2 ((relIndex_eq_one.mp hi.symm).trans (source_Z_Q_U ht a').2)
  obtain ⟨hlo,hsharp⟩ := reduced_graph_quadratic_bounds h a' d.action T Aq hT hA
    d.quadratic d.generated hf
  have hcard : Nat.card Aq = (Q F a').relIndex (Z F a) := d.actorCard
  exact ⟨hcard.symm.trans_le (hlo.trans d.fixedIndex),
    fun hi => hsharp ((d.fixedIndex.trans hi).trans_eq hcard.symm)⟩

/-- The original small-projective starting orbit has reciprocal escape,
including strict enlargement, without a model premise on either orbit. -/
theorem reduced_small_projective_reciprocal_escape (h : HypothesisF11 L S)
    {a beta a' : Vertex F} (hc : IsCriticalPair F a a')
    (hab : (graph F).Adj a beta) (hd : (graph F).dist beta a' + 1 = b F)
    (hb : 1 < b F) (hcomm : ⁅Z F a,Z F a'⁆ = ⊥)
    (hm : ClassicalGroup.IsPSU (family L a.type ⧸ pCore 2 (family L a.type)) 3 2) :
    ¬ V F a' 1 ≤ Q F beta := by
  intro hreverse
  let ht := reduced_triple h
  let : ∀ i, Finite (F i) := finite_endpoints ht
  let d := reducedFullEarlierLocalTheorems h
  let := CommutingOneProfile.source_center_elementary ht a
  let A := V F a' 1
  have hb3 := (source_critical_geometry ht d hc hab hd hb hcomm).2.1
  let : IsElementaryAbelian 2 A := CommutingThreeProfile.V_elementary F ht.generate
    (fun v => (source_Z_Q_U ht v).1) d.kernel_sylow (by omega) a'
  have hAP : A ≤ stabilizer F a := hreverse.trans ((source_Z_Q_U ht beta).2.trans
    ((ballKernel_one_le_edge F hab.symm).trans inf_le_right))
  have hAL : A ≤ graphLocalGroup F a := pGroup_le_localGroup F d a A
    (IsElementaryAbelian.isPGroup 2 A) hAP
  let : Finite A := Finite.of_injective (inclusion hAP) (inclusion_injective _)
  let : Finite (Z F a) := Finite.of_injective (inclusion (Z_le_stabilizer F a)) (inclusion_injective _)
  have hcen : Z F a ⊓ centralizer (A : Set (G₀ L S)) = Z F a ⊓ Q F a' := by
    obtain ⟨_,_,_,_,w,hw,_⟩ := source_critical_geometry ht d hc hab hd hb hcomm
    have hZP : Z F a ≤ stabilizer F a' := Z_le_stabilizer_of_dist_le_b F ht.generate a a' hc.1.le
    have hp : IsPGroup 2 (Z F a ⊓ centralizer (A : Set (G₀ L S)) : Subgroup (G₀ L S)) :=
      (IsElementaryAbelian.isPGroup 2 (Z F a)).to_le inf_le_left
    have hU : Z F a ⊓ centralizer (A : Set (G₀ L S)) ≤ U F a' :=
      (inf_le_inf_right _ hZP).trans (source_span_centralizer_le_kernel ht hw)
    exact le_antisymm (le_inf inf_le_left (pSubgroup_le_Q_of_le_U F a' _ hp hU (d.kernel_sylow a')))
      (le_inf inf_le_left (commutator_eq_bot_iff_le_centralizer.mp
        (reduced_reverse_small_projective_intersection_centralizes h hc hab hd hb hcomm hreverse hm)))
  have hi : (centralizer (A : Set (G₀ L S))).relIndex (Z F a) = (Q F a').relIndex (Z F a) := by
    rw [←inf_relIndex_left (Z F a) (centralizer (A : Set (G₀ L S))),hcen,inf_relIndex_left]
  have hmove : ⁅A,Z F a⁆ ≠ ⊥ := by
    intro he
    have hh : Z F a ≤ centralizer (A : Set (G₀ L S)) :=
      le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp he)
    have heq : Z F a ⊓ Q F a' = Z F a := hcen.symm.trans (inf_eq_left.mpr hh)
    exact hc.2 ((inf_eq_left.mp heq).trans (source_Z_Q_U ht a').2)
  have hquad : ⁅A,⁅A,Z F a⁆⁆ = ⊥ := by
    rw [commutator_comm A (Z F a),commutator_comm A]
    exact bot_unique ((commutator_mono (commutator_mono (Z_neighbor_le_V F hab.symm) le_rfl) le_rfl).trans
      (source_critical_geometry ht d hc hab hd hb hcomm).2.2.2.1.2.le)
  obtain ⟨hpos,hlo⟩ := reduced_small_projective_center_index h a hm A hAL hmove hquad
  have hfactor := (reduced_intrinsic_ending_factor_bound h hc hab hd hb hcomm).1
  have hupper : (centralizer (Z F a : Set (G₀ L S))).relIndex A ≤ (Q F a).relIndex A :=
    relIndex_le_of_le_left (Noncommuting.graph_Q_centralizes_Z ht a)
      (((Q F a).subgroupOf A).index_ne_zero_of_finite)
  rw [hi] at hlo
  have hle := hfactor.trans hupper
  nlinarith

/-- This source branch supplies the actual reverse critical pair and its
commuting centers, with the same full Borel and reduced completion. -/
theorem reduced_small_projective_reciprocal_configuration (h : HypothesisF11 L S)
    {a beta a' : Vertex F} (hc : IsCriticalPair F a a')
    (hab : (graph F).Adj a beta) (hd : (graph F).dist beta a' + 1 = b F)
    (hb : 1 < b F) (hcomm : ⁅Z F a,Z F a'⁆ = ⊥)
    (hm : ClassicalGroup.IsPSU (family L a.type ⧸ pCore 2 (family L a.type)) 3 2) :
    ∃ z : Vertex F, (graph F).Adj z a' ∧ IsCriticalPair F z beta ∧
      (graph F).dist a' beta + 1 = b F ∧ ⁅Z F z,Z F beta⁆ = ⊥ ∧ ¬ Z F z ≤ Q F beta := by
  have he := reduced_small_projective_reciprocal_escape h hc hab hd hb hcomm hm
  obtain ⟨z,hz,hcz,hzQ⟩ := reduced_reverse_criticalPair h (reduced_kernel_sylow h) hd he
  refine ⟨z,hz.symm,hcz,?_,?_,hzQ⟩
  · rwa [SimpleGraph.dist_comm]
  · exact reverse_critical_centers_commute (reduced_triple h) hcz
      (reduced_commuting_critical_geometry h hc hab hd hb hcomm).2.2.1

end CFSG.Quasithin.ChapterF.Source.DGS85.Reduction
