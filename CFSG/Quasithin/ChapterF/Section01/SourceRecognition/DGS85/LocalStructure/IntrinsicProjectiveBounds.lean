module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.LocalStructure.SmallProjectiveUnitarySections
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.LocalStructure.IntrinsicCriticalAction
public import Theory.Representation.BinaryOffender.CubicRatio.Equivariant
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.LocalStructure.DihedralApplication

/-!
# Small projective displacement on every original vertex orbit

The actual enlarged quotient at an arbitrary vertex is identified with
its original endpoint quotient by conjugation and the reduced inclusion.
For an original PSU₃(2) marking this gives two-rank at most two, including
the possible strict enlargement of order 144. Every nontrivial action
generated by its Sylow fixed spaces retains the cubic ratio greater than
two. Hence each nonzero quadratic elementary actor moves more than the
square of its order on the same vectors.

`IntrinsicProjectiveReciprocity` applies these bounds to the actual center
and core indices in the reverse-containment branch of DGS 8.2. No enlarged
rank-one marking or exclusion of order 144 is assumed here.
Source: DGS, *Groups and Graphs* (1985), 6.1, pp.118--119, and 8.2,
pp.134--135; the fixed-space generation correction to 5.12 is retained.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender
open Representation.RankOne.QuadraticRecognition Theory.GroupTheory.AmalgamGraph
open Subgroup.CosetGeometry.RankTwo
namespace CFSG.Quasithin.ChapterF.Source.DGS85.Reduction
variable {G : Type*} [Group G] {L : Fin 2 → Subgroup G} {S : Subgroup G}
local notation "F" => family (fun i => Subgroup.subgroupOf (P₀ L S i) (G₀ L S))

private def vertexEnlargementQuotient (h : HypothesisF11 L S) (v : Vertex F) :
    (graphLocalGroup F v ⧸ pCore 2 (graphLocalGroup F v)) ≃*
      (family (enlargedEndpoint L S) v.type ⧸ pCore 2 (family (enlargedEndpoint L S) v.type)) := by
  let g := Classical.choose (Subgroup.CosetGeometry.exists_smul_base F v)
  have hg := Classical.choose_spec (Subgroup.CosetGeometry.exists_smul_base F v)
  let M := graphLocalGroup F (base F v.type)
  have heq : M.map (MulAut.conj g).toMonoidHom = graphLocalGroup F v :=
    (graphLocalGroup_conjugate (reduced_triple h) g (base F v.type)).symm.trans
      (congrArg (graphLocalGroup F) hg)
  let a : M ≃* graphLocalGroup F v :=
    (M.equivMapOfInjective (MulAut.conj g).toMonoidHom (MulAut.conj g).injective).trans
      (MulEquiv.subgroupCongr heq)
  exact (QuotientGroup.congr _ _ a (pCore_map_iso 2 a)).symm.trans
    (reduced_graphEnlargementQuotient h v.type)

/-- The literal actor quotient has two-rank at most two on the original small-projective orbit. -/
theorem reduced_small_projective_twoRank (h : HypothesisF11 L S) (v : Vertex F)
    (hm : ClassicalGroup.IsPSU (family L v.type ⧸ pCore 2 (family L v.type)) 3 2) :
    primeRank 2 (graphLocalGroup F v ⧸ pCore 2 (graphLocalGroup F v)) ≤ 2 := by
  let : ∀ j, Finite (F j) := finite_endpoints (reduced_triple h)
  let : Finite (graphLocalGroup F v) := Finite.of_injective
    (inclusion (sylowGenerated_le _)) (inclusion_injective _)
  let : Finite (family (enlargedEndpoint L S) v.type ⧸ pCore 2 (family (enlargedEndpoint L S) v.type)) :=
    Finite.of_equiv _ (vertexEnlargementQuotient h v).toEquiv
  rw [Theory.GroupTheory.primeRank_equiv 2 (vertexEnlargementQuotient h v)]
  have hb (j : Bool) (hj : ClassicalGroup.IsPSU (family L j ⧸ pCore 2 (family L j)) 3 2) :
      primeRank 2 (family (enlargedEndpoint L S) j ⧸ pCore 2 (family (enlargedEndpoint L S) j)) ≤ 2 := by
    cases j
    · exact original_small_projective_enlargement_twoRank h 0 hj
    · exact original_small_projective_enlargement_twoRank h 1 hj
  exact hb v.type hm

private theorem marked_small_projective_cubic_bound (h : HypothesisF11 L S) (i : Fin 2)
    (hm : ClassicalGroup.IsPSU (L i ⧸ pCore 2 (L i)) 3 2)
    {D W : Type*} [Group D] [Finite D] [AddCommGroup W] [Module (ZMod 2) W] [Finite W]
    (e : D ≃* (enlargedEndpoint L S i ⧸ pCore 2 (enlargedEndpoint L S i)))
    (σ : Representation (ZMod 2) D W)
    (hg : ∀ T : Sylow 2 D, GeneratedByFixedSpace σ T) (hnt : σ ≠ 1) :
    2 < cubicRatio σ := by
  let := h.finite_parabolic i
  let : Finite (enlargedEndpoint L S i) := Finite.of_injective
    (inclusion (show enlargedEndpoint L S i ≤ parabolic L S i from
      sup_le (starredParabolic_le i) ((pCoreIn_le 2 _).trans (commonBorel_le_parabolic i))))
    (inclusion_injective _)
  let : FiniteDimensional (ZMod 2) W := Module.Finite.of_finite
  let ρ := σ.comp e.symm.toMonoidHom
  have hg' : ∀ T : Sylow 2 (enlargedEndpoint L S i ⧸ pCore 2 (enlargedEndpoint L S i)),
      GeneratedByFixedSpace ρ T := by
    intro T
    obtain ⟨R,rfl⟩ := Sylow.mapSurjective_surjective (f := e.toMonoidHom) e.surjective 2 T
    exact generatedByFixedSpace_of_equivariant_surjection σ ρ e.toMonoidHom
      LinearMap.id Function.surjective_id (by intro g w; simp [ρ]) R (hg R)
  have hnt' : ρ ≠ 1 := by
    intro he
    apply hnt
    ext g w
    have hh := DFunLike.congr_fun (DFunLike.congr_fun he (e g)) w
    simpa [ρ] using hh
  have hf := original_small_projective_enlargement_faithful h i hm ρ hg' hnt'
  have hc := original_small_projective_enlargement_cubic_bound h i hm ρ hf
  by_contra! hh
  exact not_le_of_gt hc (cubicRatio_le_nat_of_equivariant σ ρ e.toMonoidHom e.injective
    (LinearEquiv.refl _ _) (by intro g w; simp [ρ]) 2 hh)

/-- The cubic bound survives both original inclusion and vertex conjugation. -/
theorem reduced_small_projective_cubic_bound (h : HypothesisF11 L S) (v : Vertex F)
    (hm : ClassicalGroup.IsPSU (family L v.type ⧸ pCore 2 (family L v.type)) 3 2)
    {W : Type*} [AddCommGroup W] [Module (ZMod 2) W] [Finite W]
    (σ : Representation (ZMod 2) (graphLocalGroup F v ⧸ pCore 2 (graphLocalGroup F v)) W)
    (hg : ∀ T : Sylow 2 (graphLocalGroup F v ⧸ pCore 2 (graphLocalGroup F v)),
      GeneratedByFixedSpace σ T) (hnt : σ ≠ 1) : 2 < cubicRatio σ := by
  let : ∀ j, Finite (F j) := finite_endpoints (reduced_triple h)
  let : Finite (graphLocalGroup F v) := Finite.of_injective
    (inclusion (sylowGenerated_le _)) (inclusion_injective _)
  have hb (j : Bool) (hj : ClassicalGroup.IsPSU (family L j ⧸ pCore 2 (family L j)) 3 2)
      (e : (graphLocalGroup F v ⧸ pCore 2 (graphLocalGroup F v)) ≃*
        (family (enlargedEndpoint L S) j ⧸ pCore 2 (family (enlargedEndpoint L S) j))) :
      2 < cubicRatio σ := by
    cases j
    · exact marked_small_projective_cubic_bound h 0 hj e σ hg hnt
    · exact marked_small_projective_cubic_bound h 1 hj e σ hg hnt
  exact hb v.type hm (vertexEnlargementQuotient h v)

/-- Every nonzero elementary quadratic actor has fixed index strictly above its squared order. -/
theorem reduced_small_projective_quadratic_index (h : HypothesisF11 L S) (v : Vertex F)
    (hm : ClassicalGroup.IsPSU (family L v.type ⧸ pCore 2 (family L v.type)) 3 2)
    {W : Type*} [AddCommGroup W] [Module (ZMod 2) W] [Finite W]
    (σ : Representation (ZMod 2) (graphLocalGroup F v ⧸ pCore 2 (graphLocalGroup F v)) W)
    (hg : ∀ T : Sylow 2 (graphLocalGroup F v ⧸ pCore 2 (graphLocalGroup F v)),
      GeneratedByFixedSpace σ T) (hnt : σ ≠ 1)
    (A : Subgroup (graphLocalGroup F v ⧸ pCore 2 (graphLocalGroup F v)))
    [IsElementaryAbelian 2 A] (hne : A ≠ ⊥) (hq : IsQuadratic σ A) :
    Nat.card A ^ 2 < Nat.card (W ⧸ fixedSpace σ A) := by
  let : ∀ j, Finite (F j) := finite_endpoints (reduced_triple h)
  let : Finite (graphLocalGroup F v) := Finite.of_injective
    (inclusion (sylowGenerated_le _)) (inclusion_injective _)
  let : FiniteDimensional (ZMod 2) W := Module.Finite.of_finite
  have hA : IsElementaryTwo A := ⟨hne,inferInstance⟩
  have hc := reduced_small_projective_cubic_bound h v hm σ hg hnt
  by_contra! hbad
  have hdim : fixedCodim σ A ≤ 2 * rank A := by
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2), Nat.card_zmod,
      hA.card_eq_two_pow_rank,←pow_mul] at hbad
    have hh := (Nat.pow_le_pow_iff_right (by decide : 1 < (2:ℕ))).mp hbad
    simpa only [fixedCodim, Nat.mul_comm] using hh
  exact not_le_of_gt hc ((cubicRatio_le_nat_iff σ 2).mpr
    ⟨A,hA,isCubic_of_isQuadratic hq,hdim⟩)

end CFSG.Quasithin.ChapterF.Source.DGS85.Reduction
