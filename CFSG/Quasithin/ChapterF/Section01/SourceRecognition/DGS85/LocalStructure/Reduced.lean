module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.LocalStructure.SourceTriple
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.SuzukiContainment.ReducedPair

/-!
# The full-Borel DGS reduction of the genuine F1.11 pair

Define B0 = (B intersect P0star)(B intersect P1star)O2(B),
Pi0 = Pistar B0 and G0 = <P00,P10>. The existing source reduction
identifies these with the F1.11 pair formed using O2(B). We prove the
normalizing conditions and literal set products, relative normality in
the original Borel/endpoints/completion, unchanged embedded cores, and
commuting inclusion maps. The original S is not identified with O2(B).

The generated reduced triple therefore gives a faithful connected graph,
finite stabilizers and neighbor sets, the actual reduced edge stabilizer,
and an attained positive two-orbit critical distance. No Chapter 6
obstruction or classification result is assumed or claimed here.

Source: Delgado--Goldschmidt--Stellmacher, *Groups and Graphs* (1985),
Part II, reduction and Hypotheses B/B', pp.95--96. The reused reduction
is in `SuzukiContainment.ReducedPair`, but its statement has the full
F1.11 scope and all five original rank-one quotient alternatives.
-/

@[expose] public noncomputable section
open Subgroup
open scoped Pointwise
namespace CFSG.Quasithin.ChapterF.Source.DGS85
open Subgroup.CosetGeometry.RankTwo
namespace Reduction
variable {G : Type*} [Group G] {L : Fin 2 → Subgroup G} {S : Subgroup G}

/-- The full p95 reduced Borel, retaining both starred intersections. -/
def B₀ (L : Fin 2 → Subgroup G) (S : Subgroup G) : Subgroup G :=
  (commonBorel L S ⊓ starredParabolic L S 0) ⊔
  (commonBorel L S ⊓ starredParabolic L S 1) ⊔ (commonBorel L S).pCoreIn 2
/-- The actual reduced endpoints inside the original completion. -/
def P₀ (L : Fin 2 → Subgroup G) (S : Subgroup G) (i : Fin 2) : Subgroup G :=
  starredParabolic L S i ⊔ B₀ L S
/-- The subgroup generated by both reduced endpoints. -/
def G₀ (L : Fin 2 → Subgroup G) (S : Subgroup G) : Subgroup G := P₀ L S 0 ⊔ P₀ L S 1

theorem B₀_eq_source (h : HypothesisF11 L S) :
    B₀ L S = commonBorel L (SuzukiContainment.reducedSylow L S) := by
  symm
  simpa only [B₀, inf_comm, SuzukiContainment.reducedSylow, twoCore, pCoreIn] using SuzukiContainment.reduced_borel_product h

theorem P₀_eq_source (h : HypothesisF11 L S) (i : Fin 2) :
    P₀ L S i = parabolic L (SuzukiContainment.reducedSylow L S) i := by
  rw [P₀, B₀_eq_source h, ← SuzukiContainment.reduced_starredParabolic h i]
  exact (SuzukiContainment.reduced_hypothesis h).starredParabolic_supplement i

theorem G₀_eq_source (h : HypothesisF11 L S) :
    G₀ L S = generated L (SuzukiContainment.reducedSylow L S) := by
  rw [G₀, P₀_eq_source h 0, P₀_eq_source h 1, parabolics_generate]

theorem B₀_le (h : HypothesisF11 L S) : B₀ L S ≤ commonBorel L S := by
  rw [B₀_eq_source h]
  exact SuzukiContainment.reduced_commonBorel_le h

theorem P₀_le (h : HypothesisF11 L S) (i : Fin 2) : P₀ L S i ≤ parabolic L S i := by
  rw [P₀_eq_source h i]
  exact SuzukiContainment.reduced_parabolic_le h i

theorem G₀_le (h : HypothesisF11 L S) : G₀ L S ≤ generated L S := by
  rw [G₀_eq_source h]
  exact SuzukiContainment.reduced_generated_le h

private theorem borel_normalizes_star (h : HypothesisF11 L S) (i : Fin 2) :
    commonBorel L S ≤ normalizer (starredParabolic L S i : Set G) :=
  (commonBorel_le_parabolic (L := L) (S := S) i).trans
    ((normal_subgroupOf_iff_le_normalizer (starredParabolic_le (L := L) (S := S) i)).mp (h.starredParabolic_normal i))

private theorem borel_normalizes_star_inter (h : HypothesisF11 L S) (i : Fin 2) :
    commonBorel L S ≤ normalizer (commonBorel L S ⊓ starredParabolic L S i : Set G) :=
  (le_inf (commonBorel L S).le_normalizer (borel_normalizes_star h i)).trans
    inf_normalizer_le_normalizer_inf

private theorem borel_normalizes_core : commonBorel L S ≤
    normalizer ((commonBorel L S).pCoreIn 2 : Set G) :=
  (commonBorel L S).le_normalizer.trans
    (normalizer_le_normalizer_characteristic_image _ (pCore 2 (commonBorel L S)))

/-- The product defining B₀ is a product of subgroups normal in the full Borel. -/
theorem borel_normalizes_B₀ (h : HypothesisF11 L S) :
    commonBorel L S ≤ normalizer (B₀ L S : Set G) := by
  intro g hg
  unfold B₀
  apply normalizer_inf_normalizer_le_normalizer_sup
    ((commonBorel L S ⊓ starredParabolic L S 0) ⊔
      (commonBorel L S ⊓ starredParabolic L S 1)) ((commonBorel L S).pCoreIn 2)
  refine ⟨?_, borel_normalizes_core (L := L) (S := S) hg⟩
  exact normalizer_inf_normalizer_le_normalizer_sup
    (commonBorel L S ⊓ starredParabolic L S 0)
    (commonBorel L S ⊓ starredParabolic L S 1)
    ⟨borel_normalizes_star_inter h 0 hg, borel_normalizes_star_inter h 1 hg⟩

/-- Literal set multiplication in the source p95 formula. -/
theorem B₀_set_product (h : HypothesisF11 L S) :
    (B₀ L S : Set G) = (↑(commonBorel L S ⊓ starredParabolic L S 0) : Set G) *
      (↑(commonBorel L S ⊓ starredParabolic L S 1) : Set G) *
      (↑((commonBorel L S).pCoreIn 2) : Set G) := by
  rw [B₀, coe_mul_of_left_le_normalizer_right _ _
    ((sup_le inf_le_left inf_le_left).trans (borel_normalizes_core (L := L) (S := S))),
    coe_mul_of_left_le_normalizer_right _ _
      (inf_le_left.trans (borel_normalizes_star_inter h 1))]

/-- The endpoint is the indicated product, not just an uninterpreted join. -/
theorem P₀_set_product (h : HypothesisF11 L S) (i : Fin 2) :
    (P₀ L S i : Set G) = (starredParabolic L S i : Set G) * (B₀ L S : Set G) :=
  coe_mul_of_right_le_normalizer_left _ _ ((B₀_le h).trans (borel_normalizes_star h i))

theorem B₀_normal (h : HypothesisF11 L S) :
    ((B₀ L S).subgroupOf (commonBorel L S)).Normal :=
  (normal_subgroupOf_iff_le_normalizer (B₀_le h)).mpr (borel_normalizes_B₀ h)

/-- Relative normality in each original full endpoint. -/
theorem P₀_normal (h : HypothesisF11 L S) (i : Fin 2) :
    ((P₀ L S i).subgroupOf (parabolic L S i)).Normal := by
  apply (normal_subgroupOf_iff_le_normalizer (P₀_le h i)).mpr
  rw [← h.starredParabolic_supplement i]
  apply sup_le
  · exact le_sup_left.trans (P₀ L S i).le_normalizer
  · exact (le_inf (borel_normalizes_star h i) (borel_normalizes_B₀ h)).trans
      (normalizer_inf_normalizer_le_normalizer_sup _ _)

/-- The reduced completion is normal in the original generated completion. -/
theorem G₀_normal (h : HypothesisF11 L S) :
    ((G₀ L S).subgroupOf (generated L S)).Normal := by
  rw [G₀_eq_source h]
  exact SuzukiContainment.reduced_generated_normal h

/-- The reduced Borel core is the original Borel core; the original S need not equal it. -/
theorem B₀_core (h : HypothesisF11 L S) : (B₀ L S).pCoreIn 2 = (commonBorel L S).pCoreIn 2 := by
  rw [B₀_eq_source h]
  exact SuzukiContainment.reduced_borel_core h

/-- Each starred intersection with the full Borel survives unchanged. -/
theorem B₀_inf_star (h : HypothesisF11 L S) (i : Fin 2) :
    B₀ L S ⊓ starredParabolic L S i = commonBorel L S ⊓ starredParabolic L S i := by
  apply le_antisymm (inf_le_inf_right _ (B₀_le h))
  apply le_inf _ inf_le_right
  fin_cases i
  · exact le_sup_left.trans le_sup_left
  · exact le_sup_right.trans le_sup_left

/-- Hypothesis B's additional condition, with literal subgroup products. -/
theorem hypothesisB_product (h : HypothesisF11 L S) :
    (B₀ L S : Set G) = (↑(B₀ L S ⊓ starredParabolic L S 0) : Set G) *
      (↑(B₀ L S ⊓ starredParabolic L S 1) : Set G) * (↑((B₀ L S).pCoreIn 2) : Set G) := by
  rw [B₀_inf_star h 0, B₀_inf_star h 1, B₀_core h]
  exact B₀_set_product h

/-- The reduced-to-original Borel map is the literal inclusion. -/
def borelInclusion (h : HypothesisF11 L S) : B₀ L S →* commonBorel L S := inclusion (B₀_le h)
/-- The reduced-to-original endpoint maps are literal inclusions. -/
def endpointInclusion (h : HypothesisF11 L S) (i : Fin 2) : P₀ L S i →* parabolic L S i :=
  inclusion (P₀_le h i)
/-- The generated-group map retains the original completion. -/
def completionInclusion (h : HypothesisF11 L S) : G₀ L S →* generated L S := inclusion (G₀_le h)

/-- The original starred endpoint embeds literally into its reduced endpoint. -/
def starInclusion (i : Fin 2) : starredParabolic L S i →* P₀ L S i := inclusion le_sup_left

/-- Both paths from the reduced Borel give the same original group element. -/
theorem borel_square (h : HypothesisF11 L S) (i : Fin 2) (x : B₀ L S) :
    ((endpointInclusion h i) ⟨x, (show B₀ L S ≤ P₀ L S i from le_sup_right) x.property⟩ : G) =
      ((borelInclusion h) x : G) := rfl

/-- Both paths from a starred factor give the same original group element. -/
theorem star_square (h : HypothesisF11 L S) (i : Fin 2) (x : starredParabolic L S i) :
    ((endpointInclusion h i) (starInclusion (L := L) (S := S) i x) : G) = (x : G) := rfl

/-- The endpoint reduction preserves its intrinsic core with the original embedding. -/
theorem P₀_core (h : HypothesisF11 L S) (i : Fin 2) :
    (P₀ L S i).pCoreIn 2 = (parabolic L S i).pCoreIn 2 := by
  rw [P₀_eq_source h i]
  exact SuzukiContainment.reduced_parabolic_core h i

/-- The actual reduced pair, with all F1.11 premises discharged by the prior reduction. -/
theorem reduced_triple (h : HypothesisF11 L S) :
    LocallyRankOneTriple (fun i => (P₀ L S i).subgroupOf (G₀ L S))
      ((B₀ L S).subgroupOf (G₀ L S)) := by
  rw [G₀_eq_source h]
  simpa only [P₀_eq_source h, B₀_eq_source h] using
    (SuzukiContainment.reduced_hypothesis h).generatedLocallyRankOneTriple

/-- Shared graph family for the reduced genuine F1.11 triple. -/
def reducedFamily (L : Fin 2 → Subgroup G) (S : Subgroup G) : Bool → Subgroup (G₀ L S) :=
  family (fun i => (P₀ L S i).subgroupOf (G₀ L S))

/-- The genuine reduced graph has a critical pair without any additional escape premise. -/
theorem reduced_criticalPair (h : HypothesisF11 L S) :
    ∃ v w : Vertex (reducedFamily L S), IsCriticalPair (reducedFamily L S) v w :=
  source_exists_criticalPair (reduced_triple h)

/-- The reduced graph retains the whole reduced Borel as its actual edge
stabilizer and uses the same source Q, U, Z, V and two-sided b. -/
theorem reduced_graph_setup (h : HypothesisF11 L S) :
    (graph (reducedFamily L S)).Connected ∧
    FaithfulSMul (G₀ L S) (Vertex (reducedFamily L S)) ∧
    (∀ v : Vertex (reducedFamily L S),
      Finite (stabilizer (reducedFamily L S) v) ∧
      Finite ((graph (reducedFamily L S)).neighborSet v)) ∧
    MulAction.stabilizer (G₀ L S)
      ({base (reducedFamily L S) false, base (reducedFamily L S) true} :
        Set (Vertex (reducedFamily L S))) = (B₀ L S).subgroupOf (G₀ L S) ∧
    0 < b (reducedFamily L S) := by
  have ht := reduced_triple h
  exact ⟨connected_graph ht, faithful_graph ht, graph_locally_finite ht,
    full_borel_edge_stabilizer ht, source_b_positive ht⟩

/-- Actual reduced-triple application of the critical-center intersection
bound, with both centers and the literal action retained. -/
theorem reduced_critical_centers (h : HypothesisF11 L S) :
    ∃ v w : Vertex (reducedFamily L S), IsCriticalPair (reducedFamily L S) v w ∧
      Z (reducedFamily L S) w ≤ stabilizer (reducedFamily L S) v ∧
      ⁅Z (reducedFamily L S) v, Z (reducedFamily L S) w⁆ ≤
        Z (reducedFamily L S) v ⊓ Z (reducedFamily L S) w :=
  source_critical_centers (reduced_triple h)

end Reduction
end CFSG.Quasithin.ChapterF.Source.DGS85
