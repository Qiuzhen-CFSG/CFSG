module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.LocalStructure.IntrinsicProjectiveBounds
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.LocalStructure.FullGraphObstruction
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.LocalStructure.EnlargementCatalogue
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.LocalStructure.SmallSpecialUnitaryEnlargement
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingNontrivial.ReciprocalSmallUnitary

/-!
# The original small-projective branch of the reciprocal calculation

Conjugation on the actual center is generated by its Sylow fixed spaces.
A moving elementary quadratic subgroup therefore has centralizer index
strictly greater than the square of its index against the actual core,
even if the original PSU₃(2) endpoint enlarges to a quotient of order 144.

In the contrary reverse-containment branch of DGS 8.2, put
A = Z_alpha intersect Q_alpha'. Each neighboring center lies in the
starting local actor, whose quotient has two-rank at most two. Its index
against Q_alpha is thus at most four. Since Q_alpha centralizes A,
this bounds the same displacement index by four. The strict square bound
contradicts every moving neighbor, and A centralizes the full V_alpha'.
The center-vertex summand is included separately.

The final consumer starts from original F.1.1 and nonzero intersection
commutator under that reverse containment. It excludes the original small
projective row and constructs actual enlarged rank-one models at every
vertex in the starting orbit. It asserts no marking for the other orbit.
The literal core maps, full Borel, original completion inclusion and
possibly infinite completion are preserved by the reused source setup.

This removes the order-144 possibility in this precise source subcase;
the unrestricted 6.1 enlargement and final source assembly remain open.
Source: DGS, *Groups and Graphs* (1985), 8.1--8.2, pp.132--135,
with corrected fixed-space generation in 5.12 and the reduction pp.95--96.
-/

public noncomputable section
open scoped IsMulCommutative
open Subgroup Representation Representation.BinaryOffender Representation.BinaryConjugationSection
open Representation.RankOne.QuadraticRecognition Theory.GroupTheory.AmalgamGraph
open Subgroup.CosetGeometry.RankTwo
namespace CFSG.Quasithin.ChapterF.Source.DGS85.Reduction
open CommutingNontrivial
variable {G : Type*} [Group G] {L : Fin 2 → Subgroup G} {S : Subgroup G}
local notation "F" => family (fun i => Subgroup.subgroupOf (P₀ L S i) (G₀ L S))

/-- A moving elementary actor on the literal source center has strict squared displacement. -/
theorem reduced_small_projective_center_index (h : HypothesisF11 L S) (v : Vertex F)
    (hm : ClassicalGroup.IsPSU (family L v.type ⧸ pCore 2 (family L v.type)) 3 2)
    (A : Subgroup (G₀ L S)) [IsElementaryAbelian 2 A]
    (hAL : A ≤ graphLocalGroup F v) (hmove : ⁅A,Z F v⁆ ≠ ⊥)
    (hq : ⁅A,⁅A,Z F v⁆⁆ = ⊥) :
    1 < (Q F v).relIndex A ∧
      (Q F v).relIndex A ^ 2 < (centralizer (A : Set (G₀ L S))).relIndex (Z F v) := by
  let ht := reduced_triple h
  let : ∀ j, Finite (F j) := finite_endpoints ht
  let := CommutingOneProfile.source_center_elementary ht v
  let M := graphLocalGroup F v
  let π := QuotientGroup.mk' (pCore 2 M)
  let : Finite M := Finite.of_injective (inclusion (sylowGenerated_le _)) (inclusion_injective _)
  let : Finite (Z F v) := Finite.of_injective (inclusion (Z_le_stabilizer F v)) (inclusion_injective _)
  let d := reducedFullEarlierLocalTheorems h
  obtain ⟨ρ,hact⟩ := source_exists_center_quotient_action ht d v (MulEquiv.refl _)
  change Representation (ZMod 2) (M ⧸ pCore 2 M) (Additive (Z F v)) at ρ
  have hZL : Z F v ≤ M := by
    rw [graph_intrinsic_center_span ht v]
    exact sylowCenterSpan_le _
  have hnZ : M ≤ normalizer (Z F v : Set (G₀ L S)) :=
    (sylowGenerated_le _).trans (stabilizer_normalizes_Z F v)
  let s := centerSection M (Z F v) hZL hnZ π ρ hact
  have hgen : ∀ T : Sylow 2 (M ⧸ pCore 2 M), GeneratedByFixedSpace ρ T := by
    intro T
    obtain ⟨R,rfl⟩ := Sylow.mapSurjective_surjective (f := π) (QuotientGroup.mk'_surjective _) 2 T
    exact sylow_span_fixedSpace_generated M _ _ ρ π s R (graph_intrinsic_center_span ht v)
  have hnt : ρ ≠ 1 := by
    intro he
    apply hmove
    apply commutator_eq_bot_iff_le_centralizer.mpr
    intro x hx z hz
    have hh := hact (⟨x,hAL hx⟩ : M) (Additive.ofMul (⟨z,hz⟩ : Z F v))
    rw [he] at hh
    change z = x*z*x⁻¹ at hh
    exact (mul_inv_eq_iff_eq_mul.mp hh.symm).symm
  let E := (A.subgroupOf M).map π
  let : IsElementaryAbelian 2 (A.subgroupOf M) := IsElementaryAbelian.subgroupOf hAL
  let : IsElementaryAbelian 2 E := IsElementaryAbelian.map π
  have hE : E ≠ ⊥ := by
    intro he
    have hk := (Subgroup.map_eq_bot_iff _).mp he
    rw [QuotientGroup.ker_mk',←graph_intrinsic_core ht v] at hk
    apply hmove
    apply commutator_eq_bot_iff_le_centralizer.mpr
    exact (show A ≤ Q F v from fun a ha => hk (show
      (⟨a,hAL ha⟩ : M) ∈ A.subgroupOf M from ha)).trans (Noncommuting.graph_Q_centralizes_Z ht v)
  have hEq : IsQuadratic ρ E :=
    BinaryConjugationSection.isQuadratic_of_triple_commutator_le M (Z F v) ⊥ A ρ π s hq.le
  have hcard : Nat.card E = (Q F v).relIndex A :=
    actor_image_card_eq_relIndex M (Q F v) A π
      (by rw [QuotientGroup.ker_mk',graph_intrinsic_core ht v]) hAL
  have hi := center_action_fixed_index M (Z F v) A hZL hnZ hAL π ρ hact
  have hbound := reduced_small_projective_quadratic_index h v hm ρ hgen hnt E hE hEq
  rw [hcard,hi] at hbound
  refine ⟨?_,hbound⟩
  rw [←hcard]
  exact E.one_lt_card_iff_ne_bot.mpr hE

/-- The original PSU₃(2) row, including its possible strict enlargement, has no moving intersection under reverse containment. -/
theorem reduced_reverse_small_projective_intersection_centralizes (h : HypothesisF11 L S)
    {a beta a' : Vertex F} (hc : IsCriticalPair F a a')
    (hab : (graph F).Adj a beta) (hd : (graph F).dist beta a' + 1 = b F)
    (hb : 1 < b F) (hcomm : ⁅Z F a,Z F a'⁆ = ⊥)
    (hreverse : V F a' 1 ≤ Q F beta)
    (hm : ClassicalGroup.IsPSU (family L a.type ⧸ pCore 2 (family L a.type)) 3 2) :
    ⁅Z F a ⊓ Q F a',V F a' 1⁆ = ⊥ := by
  let ht := reduced_triple h
  let : ∀ j, Finite (F j) := finite_endpoints ht
  let d := reducedFullEarlierLocalTheorems h
  let A := Z F a ⊓ Q F a'
  let := CommutingOneProfile.source_center_elementary ht a
  let : IsElementaryAbelian 2 A := IsElementaryAbelian.of_le inf_le_left
  apply commutator_eq_bot_iff_le_centralizer.mpr
  apply le_centralizer_iff.mpr
  rw [V_one_eq_sup_neighbors]
  apply sup_le
  · exact (Z_centralizes_Q F a' (source_Z_Q_U ht a').1).trans (centralizer_le inf_le_right)
  · apply iSup_le
    intro w
    apply le_centralizer_iff.mp
    apply commutator_eq_bot_iff_le_centralizer.mp
    by_contra hmove
    have hAV : A ≤ V F beta 1 ⊓ Q F a' :=
      inf_le_inf (Z_neighbor_le_V F hab.symm) le_rfl
    have hmoving : ⁅V F beta 1 ⊓ Q F a',Z F w.val⁆ ≠ ⊥ := by
      intro he
      exact hmove (bot_unique ((commutator_mono hAV le_rfl).trans he.le))
    have hactor := source_moving_actor ht d hc hab hd hb hcomm w hmoving
    have hsame : a.type = w.val.type := by
      have hodd := (source_critical_geometry ht d hc hab hd hb hcomm).1
      have hne : a.type ≠ a'.type := by
        intro he
        have hev := (even_dist_iff F ht.generate a a').mpr he
        rw [hc.1] at hev
        exact (Nat.not_even_iff_odd.mpr hodd) hev
      have hn := w.property.1
      cases ha : a.type <;> cases hw : w.val.type <;> cases ha' : a'.type <;> simp_all
    have hmw : ClassicalGroup.IsPSU (family L w.val.type ⧸ pCore 2 (family L w.val.type)) 3 2 :=
      hsame ▸ hm
    have hquad : ⁅A,⁅A,Z F w.val⁆⁆ = ⊥ :=
      bot_unique ((commutator_mono hAV (commutator_mono hAV le_rfl)).trans hactor.2.2.1.le)
    obtain ⟨hpos,hlo⟩ := reduced_small_projective_center_index h w.val hmw A
      (hAV.trans hactor.2.1) hmove hquad
    have hq : Z F w.val ≤ Q F beta := (Z_neighbor_le_V F w.property).trans hreverse
    have hZP : Z F w.val ≤ stabilizer F a := hq.trans
      ((source_Z_Q_U ht beta).2.trans ((ballKernel_one_le_edge F hab.symm).trans inf_le_right))
    have hZL : Z F w.val ≤ graphLocalGroup F a := pGroup_le_localGroup F d a _
      ((isPGroup_pCoreIn 2 (stabilizer F w.val)).to_le ((source_Z_Q_U ht w.val).1.trans (map_subtype_le _))) hZP
    let M := graphLocalGroup F a
    let π := QuotientGroup.mk' (pCore 2 M)
    let := CommutingOneProfile.source_center_elementary ht w.val
    let : Finite M := Finite.of_injective (inclusion (sylowGenerated_le _)) (inclusion_injective _)
    let : Finite (Z F w.val) := Finite.of_injective (inclusion (Z_le_stabilizer F w.val)) (inclusion_injective _)
    let : IsElementaryAbelian 2 ((Z F w.val).subgroupOf M) := IsElementaryAbelian.subgroupOf hZL
    let E := ((Z F w.val).subgroupOf M).map π
    let : IsElementaryAbelian 2 E := IsElementaryAbelian.map π
    have hi : Nat.card E = (Q F a).relIndex (Z F w.val) :=
      actor_image_card_eq_relIndex M (Q F a) (Z F w.val) π
        (by rw [QuotientGroup.ker_mk',graph_intrinsic_core ht a]) hZL
    have hupper : (Q F a).relIndex (Z F w.val) ≤ 4 := by
      rw [←hi]
      have hr : primeRank 2 (M ⧸ pCore 2 M) ≤ 2 := reduced_small_projective_twoRank h a hm
      exact (primeRank_le_iff_elementary_card_le (M ⧸ pCore 2 M)).mp hr E inferInstance
    have hcen : Q F a ≤ centralizer (A : Set (G₀ L S)) :=
      (Noncommuting.graph_Q_centralizes_Z ht a).trans (centralizer_le inf_le_left)
    have hnz : (Q F a).relIndex (Z F w.val) ≠ 0 :=
      ((Q F a).subgroupOf (Z F w.val)).index_ne_zero_of_finite
    have hu : (centralizer (A : Set (G₀ L S))).relIndex (Z F w.val) ≤ 4 :=
      (relIndex_le_of_le_left hcen hnz).trans hupper
    nlinarith

/-- The actual 8.2 moving-intersection subcase supplies enlarged models throughout the starting orbit. -/
theorem reduced_reverse_moving_intersection_actor_model (h : HypothesisF11 L S)
    {a beta a' : Vertex F} (hc : IsCriticalPair F a a')
    (hab : (graph F).Adj a beta) (hd : (graph F).dist beta a' + 1 = b F)
    (hb : 1 < b F) (hcomm : ⁅Z F a,Z F a'⁆ = ⊥)
    (hreverse : V F a' 1 ≤ Q F beta)
    (hmove : ⁅Z F a ⊓ Q F a',V F a' 1⁆ ≠ ⊥)
    (x : Vertex F) (hx : a.type = x.type) :
    IsRankOneModel (graphLocalGroup F x ⧸ pCore 2 (graphLocalGroup F x)) := by
  have hnot : ¬ ClassicalGroup.IsPSU (family L x.type ⧸ pCore 2 (family L x.type)) 3 2 := by
    intro hm
    apply hmove
    exact reduced_reverse_small_projective_intersection_centralizes h hc hab hd hb hcomm hreverse
      (by rwa [←hx] at hm)
  have baseModel (j : Bool)
      (hn : ¬ ClassicalGroup.IsPSU (family L j ⧸ pCore 2 (family L j)) 3 2) :
      IsRankOneModel (family (enlargedEndpoint L S) j ⧸ pCore 2 (family (enlargedEndpoint L S) j)) := by
    have step (i : Fin 2) (hi : ¬ ClassicalGroup.IsPSU (L i ⧸ pCore 2 (L i)) 3 2) :
        IsRankOneModel (enlargedEndpoint L S i ⧸ pCore 2 (enlargedEndpoint L S i)) := by
      rcases reduced_enlargement_rankOne_or_small_unitary h i with hm | hp | hs
      · exact hm
      · exact (hi hp).elim
      · exact .special_unitary 1 (by decide)
          (by simpa using original_small_special_enlarged_marking h i hs)
    cases j
    · exact step 0 hn
    · exact step 1 hn
  have hm := (baseModel x.type hnot).of_equiv (reduced_graphEnlargementQuotient h x.type)
  obtain ⟨g,hg⟩ := Subgroup.CosetGeometry.exists_smul_base F x
  let M := graphLocalGroup F (base F x.type)
  have heq : M.map (MulAut.conj g).toMonoidHom = graphLocalGroup F x :=
    (graphLocalGroup_conjugate (reduced_triple h) g (base F x.type)).symm.trans
      (congrArg (graphLocalGroup F) hg)
  let e : M ≃* graphLocalGroup F x :=
    (M.equivMapOfInjective (MulAut.conj g).toMonoidHom (MulAut.conj g).injective).trans
      (MulEquiv.subgroupCongr heq)
  exact hm.of_equiv (QuotientGroup.congr _ _ e (pCore_map_iso 2 e)).symm

end CFSG.Quasithin.ChapterF.Source.DGS85.Reduction
