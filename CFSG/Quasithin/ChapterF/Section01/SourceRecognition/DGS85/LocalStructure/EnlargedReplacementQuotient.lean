module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.LocalStructure.EnlargedReplacementSection
public import Theory.Representation.Quotient
public import Theory.Representation.BinaryOffender.EquivariantOffender

/-!
# Descent of the enlarged replacement section to its actual core quotient

The full enlarged endpoint acts on the constructed simple section. Its
2-core acts trivially, so the action descends through any specified
surjection with precisely that kernel, on the same vectors and with the
same conjugation coordinates. The descended module is irreducible,
residual-fixed-free, and generated by every actual Sylow fixed space.
The escaping Thompson actor has the exact original core index and the
sharp replacement bound.

No perfectness, simplicity or faithfulness on the core quotient is assumed.
SmallUnitaryObstruction applies the degree-one unitary section bounds to
this construction. The original enlarged quotient marking remains a
separate 6.1 duty.
Source: DGS, Groups and Graphs (1985), 6.4--6.5, pp.120--122, using
corrected 5.12, pp.113--115.
-/

public noncomputable section
open Subgroup Theory.GroupTheory.AmalgamGraph Representation
open Representation.BinaryOffender Representation.BinaryConjugationSection
open Representation.RankOne.QuadraticRecognition
namespace CFSG.Quasithin.ChapterF.Source.DGS85
universe u v
variable {G : Type u} {D : Type v} [Group G] [Group D]
  {P : Fin 2 → Subgroup G} {B : Subgroup G}

/-- Descent through the actual enlarged core quotient retains the section, actor, and original index. -/
theorem source_enlarged_quotient_replacement_section (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (i : Fin 2) (d : LocalRankOneData (P (other i)) B)
    (hn : P (other i) ≤ normalizer (↑((P i).pCoreIn 2 ⊓ (P (other i)).pCoreIn 2) : Set G))
    (q : localEnlargement d →* D) (hq : Function.Surjective q)
    (hk : q.ker = pCore 2 (localEnlargement d)) :
    let X := conjugateSpanBy ((P i).pCoreIn 2) (P (other i))
    let V := conjugateSpanBy (sylowCenterSpan (P i)) X
    let M := localEnlargement d
    ∃ (W : Type u) (_ : AddCommGroup W) (_ : Module (ZMod 2) W) (_ : Finite W)
      (σ : Representation (ZMod 2) D W), IsIrreducible σ ∧
      fixedSpace σ (pResidual 2 D) = ⊥ ∧
      (∀ T : Sylow 2 D, GeneratedByFixedSpace σ T) ∧
      ∃ U C : Subgroup G, U ≤ V ∧ Nonempty (BinaryConjugationSection M U C (σ.comp q)) ∧
      ∃ A : Subgroup G, A ∈ thompsonAbelianSubgroups ((P i).pCoreIn 2) ∧
        ¬ A ≤ (P (other i)).pCoreIn 2 ∧ A ≤ M ∧
        IsPGroup 2 ((A.subgroupOf M).map q) ∧
        IsQuadratic σ ((A.subgroupOf M).map q) ∧
        Nat.card ((A.subgroupOf M).map q) = ((P (other i)).pCoreIn 2).relIndex A ∧
        1 < Nat.card ((A.subgroupOf M).map q) ∧
        Nat.card (W ⧸ fixedSpace σ ((A.subgroupOf M).map q)) ≤
          Nat.card ((A.subgroupOf M).map q) := by
  let M := localEnlargement d
  let := d.finite_P
  let : Finite M := Finite.of_injective (inclusion (localEnlargement_le d)) (inclusion_injective _)
  let : Finite D := Finite.of_surjective q hq
  obtain ⟨U,C,hUV,W,hW,hWM,hWf,ρ,⟨s⟩,hi,_,hcore,_,_,hres,_,A,hA,hout,hquad,hbound⟩ :=
    source_enlarged_replacement_simple_section h hB i d hn
  let := hW
  let := hWM
  let := hWf
  let : IsIrreducible ρ := hi
  let e := QuotientGroup.quotientKerEquivOfSurjective q hq
  let σ : Representation (ZMod 2) D W :=
    (QuotientGroup.lift q.ker ρ (hk ▸ hcore)).comp e.symm.toMonoidHom
  have hσq (x : M) : σ (q x) = ρ x := by
    change QuotientGroup.lift q.ker ρ (hk ▸ hcore) (e.symm (q x)) = _
    rw [show e.symm (q x) = QuotientGroup.mk' q.ker x from e.symm_apply_eq.mpr rfl]
    rfl
  have hcomp : σ.comp q = ρ := MonoidHom.ext hσq
  have hσi : IsIrreducible σ := (irreducible_comp_surjective_iff q hq σ).mp (hcomp.symm ▸ hi)
  let := hσi
  let : FiniteDimensional (ZMod 2) W := Module.Finite.of_finite
  have hσres : fixedSpace σ (pResidual 2 D) = ⊥ := by
    rw [←map_pResidual_of_surjective 2 q hq,←fixedSpace_comp_map,hcomp]
    exact (fixedSpace_actionSubgroup ρ _).symm.trans
      ((congrArg (fixedSpace (imageRepresentation ρ))
        (map_pResidual_of_surjective 2 (actionHom ρ) ρ.asGroupHom.rangeRestrict_surjective)).trans hres)
  have hAM : A ≤ M := hA.1.trans ((le_conjugateSpanBy _ _).trans
    (core_closure_le_localEnlargement h hB i d))
  have hqk : q.ker = ((P (other i)).pCoreIn 2).subgroupOf M := by
    rw [hk,←localEnlargement_core d]
    exact (comap_map_eq_self_of_injective M.subtype_injective _).symm
  have hc : Nat.card ((A.subgroupOf M).map q) = ((P (other i)).pCoreIn 2).relIndex A :=
    actor_image_card_eq_relIndex M _ A q hqk hAM
  have hfix : fixedSpace σ ((A.subgroupOf M).map q) =
      fixedSpace (imageRepresentation ρ) ((A.subgroupOf M).map (actionHom ρ)) := by
    rw [←fixedSpace_comp_map,hcomp]
    exact (fixedSpace_actionSubgroup ρ _).symm
  refine ⟨W,hW,hWM,hWf,σ,hσi,hσres,fun T => irreducible_generated_by_sylow_fixed σ T,
    U,C,hUV,⟨hcomp.symm ▸ s⟩,A,hA,hout,hAM,
    ((isPGroup_pCoreIn 2 _).to_le hA.1).comap_subtype.map q,?_,hc,?_,?_⟩
  · rintro a ⟨x,hx,rfl⟩ b ⟨y,hy,rfl⟩ w
    simpa only [hσq,imageRepresentation_actionHom] using
      hquad (actionHom ρ x) (mem_map_of_mem _ hx) (actionHom ρ y) (mem_map_of_mem _ hy) w
  · rw [hc]
    let : Finite A := Finite.of_injective (inclusion hAM) (inclusion_injective _)
    have hp : 0 < ((P (other i)).pCoreIn 2).relIndex A := Nat.pos_of_ne_zero index_ne_zero_of_finite
    have hn1 : ((P (other i)).pCoreIn 2).relIndex A ≠ 1 := fun he => hout (relIndex_eq_one.mp he)
    omega
  · rw [hfix,hc]
    exact hbound
end CFSG.Quasithin.ChapterF.Source.DGS85
