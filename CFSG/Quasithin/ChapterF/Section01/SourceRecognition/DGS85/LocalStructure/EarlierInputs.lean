module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.LocalStructure.SylowGeneration
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.LocalStructure.Centers
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingNontrivial.SourceApplication

/-!
# Constructed earlier local inputs on the genuine source graph

At every vertex let L be the subgroup generated by all Sylow two-subgroups
of its finite stabilizer. This intrinsic definition is equivariant and, at
the marked endpoints, is exactly G* O₂(B). It is not two-closed and hence
is transitive on the actual neighbors. Common edge Sylows and the exact
6.2(c,d) conclusions give every field of the Chapter 8 earlier-local record
except the remaining 6.5 adjacent-core obstruction.

The enlarged and full stabilizers give the same adjacent-core closure.
Sylow membership in this closure would make the intersection of the two
cores normal, so the record uses only the original 6.5(a) obstruction.
The original center is generated by its actual Sylow-fixed subgroup under
this L, with no representation or fixed-generation assumption.

The actual reduced F1.11 application of the opening Chapter 8 critical
geometry needs no 6.5 premise: the proved center dichotomy, common Sylow and
kernel-Sylow conclusions give odd b, b ≥ 3, the beta-center identity, mutual
quadratic actions and the preceding-core escape. This does not prove b = 3
or the remaining Chapter 8 classification, which retain their own owner.

Source: DGS, *Groups and Graphs* (1985), 6.0--6.2 and the preliminary step
of 6.5, pp.118--121; opening 8.1, pp.132--133. The final source assembly
still owes the 6.5 obstruction, the model conclusions and the later branches.
-/

@[expose] public noncomputable section
open Subgroup
namespace CFSG.Quasithin.ChapterF.Source.DGS85
open Subgroup.CosetGeometry.RankTwo Theory.GroupTheory.AmalgamGraph
variable {G : Type*} [Group G] {P : Fin 2 → Subgroup G} {B : Subgroup G}

/-- The actual local group, defined intrinsically at every vertex. -/
def graphLocalGroup (F : Bool → Subgroup G) (v : Vertex F) : Subgroup G :=
  sylowGenerated (stabilizer F v)

/-- Conjugation preserves the actual local group and its original inclusion. -/
theorem graphLocalGroup_conjugate (h : LocallyRankOneTriple P B) (g : G)
    (v : Vertex (family P)) :
    graphLocalGroup (family P) (g • v) =
      (graphLocalGroup (family P) v).map (MulAut.conj g).toMonoidHom := by
  let := finite_endpoints h
  change sylowGenerated (stabilizer (family P) (g • v)) = _
  rw [stabilizer_translate]
  exact sylowGenerated_map (MulAut.conj g) _

theorem graphLocalGroup_base_eq
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    (i : Bool) (d : LocalRankOneData (family P i) B) :
    graphLocalGroup (family P) (base (family P) i) = localEnlargement d := by
  change sylowGenerated (MulAction.stabilizer G (Subgroup.CosetGeometry.base (family P) i)) = _
  rw [Subgroup.CosetGeometry.stabilizer_base]
  apply (localEnlargement_eq_sylowGenerated d hB _).symm
  cases i
  · exact hS 0
  · exact hS 1

/-- The source local actor is not two-closed at every actual vertex. -/
theorem graphLocalGroup_not_closed (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    (v : Vertex (family P)) :
    ¬ ∃ T : Sylow 2 (graphLocalGroup (family P) v),
      (T : Subgroup (graphLocalGroup (family P) v)) = pCore 2 (graphLocalGroup (family P) v) := by
  let := finite_endpoints h
  obtain ⟨g, hg⟩ := Subgroup.CosetGeometry.exists_smul_base (family P) v
  have hd : Nonempty (LocalRankOneData (family P v.type) B) := by
    cases ht : v.type
    · exact h.local_data 0
    · exact h.local_data 1
  let d := Classical.choice hd
  have hbase := graphLocalGroup_base_eq hB hS v.type d
  have hm : graphLocalGroup (family P) v = (localEnlargement d).map (MulAut.conj g).toMonoidHom := by
    calc
      _ = graphLocalGroup (family P) (g • base (family P) v.type) := congrArg _ hg.symm
      _ = _ := by rw [graphLocalGroup_conjugate h, hbase]
  rw [hm]
  let := d.finite_P
  let : Finite (localEnlargement d) := Finite.of_injective
    (inclusion (localEnlargement_le d)) (inclusion_injective _)
  let e := (localEnlargement d).equivMapOfInjective (MulAut.conj g).toMonoidHom
    (MulAut.conj g).injective
  let : Finite ((localEnlargement d).map (MulAut.conj g).toMonoidHom) :=
    Finite.of_equiv (localEnlargement d) e.toEquiv
  intro hc
  exact localEnlargement_not_closed d hB (core_sylow_equiv
    ((localEnlargement d).equivMapOfInjective (MulAut.conj g).toMonoidHom
      (MulAut.conj g).injective).symm hc)

/-- Both incident stabilizers share the exact embedded Sylow subgroup. -/
theorem source_common_edge_sylow (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    {v w : Vertex (family P)} (hvw : (graph (family P)).Adj v w) :
    ∃ (T : Sylow 2 (stabilizer (family P) v)) (R : Sylow 2 (stabilizer (family P) w)),
      (T : Subgroup (stabilizer (family P) v)).map (stabilizer (family P) v).subtype =
        (R : Subgroup (stabilizer (family P) w)).map (stabilizer (family P) w).subtype := by
  let := finite_endpoints h
  let E := stabilizer (family P) v ⊓ stabilizer (family P) w
  obtain ⟨T, hT⟩ := source_edge_vertex_sylow h hS hvw
  obtain ⟨R, hR⟩ := source_edge_vertex_sylow h hS hvw.symm
  have he := sylow_image_eq_edge_core (stabilizer (family P) v) E inf_le_left
    (source_edge_core_sylow h hB hvw) T hT
  have he' := sylow_image_eq_edge_core (stabilizer (family P) w) E inf_le_right
    (source_edge_core_sylow h hB hvw) R (by simpa only [E, inf_comm] using hR)
  exact ⟨T, R, he.trans he'.symm⟩

/-- The constructed local actor is transitive on the original neighbors. -/
theorem graphLocalGroup_transitive (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    (v : Vertex (family P)) (x y : (graph (family P)).neighborSet v) :
    ∃ g ∈ graphLocalGroup (family P) v, g • x.val = y.val := by
  let := finite_endpoints h
  exact source_nonclosed_normal_transitive h hB x.property _ (sylowGenerated_le _)
    (sylowGenerated_normalized _) (graphLocalGroup_not_closed h hB hS v) y.val y.property

/-- The local actor supplements the full edge stabilizer. -/
theorem graphLocalGroup_sup_edge (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    {v w : Vertex (family P)} (hvw : (graph (family P)).Adj v w) :
    graphLocalGroup (family P) v ⊔ (stabilizer (family P) v ⊓ stabilizer (family P) w) =
      stabilizer (family P) v := by
  let := finite_endpoints h
  rcases source_edge_maximal h hvw _ le_sup_right
    (sup_le (sylowGenerated_le _) inf_le_left) with he | he
  · let E := stabilizer (family P) v ⊓ stabilizer (family P) w
    let : Finite E := Finite.of_injective (inclusion (show E ≤ stabilizer (family P) v from inf_le_left))
      (inclusion_injective _)
    exact (graphLocalGroup_not_closed h hB hS v
      (core_sylow_of_le E _ (le_sup_left.trans he.le) (source_edge_core_sylow h hB hvw))).elim
  · exact he

/-- Both local actors give the same literal adjacent-core normal closure. -/
theorem graph_core_closure_local_eq_full (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    {v w : Vertex (family P)} (hvw : (graph (family P)).Adj v w) :
    conjugateSpanBy (Q (family P) w) (graphLocalGroup (family P) v) =
      conjugateSpanBy (Q (family P) w) (stabilizer (family P) v) := by
  let := finite_endpoints h
  have hnQ : stabilizer (family P) w ≤ normalizer (Q (family P) w : Set G) :=
    (stabilizer (family P) w).le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image _ (pCore 2 (stabilizer (family P) w)))
  have he := conjugateSpanBy_sup_of_normalizes_seed (Q (family P) w)
    (graphLocalGroup (family P) v) (stabilizer (family P) v ⊓ stabilizer (family P) w)
    (inf_le_right.trans hnQ) (inf_le_left.trans (sylowGenerated_normalized _))
  rw [graphLocalGroup_sup_edge h hB hS hvw] at he
  exact he.symm

/-- The initial implication of 6.5 holds at every actual edge. -/
theorem graph_core_inter_normal_of_sylow (h : LocallyRankOneTriple P B)
    {v w : Vertex (family P)} (hvw : (graph (family P)).Adj v w)
    (hs : ∃ T : Sylow 2 (conjugateSpanBy (Q (family P) w) (stabilizer (family P) v)),
      (T : Subgroup (conjugateSpanBy (Q (family P) w) (stabilizer (family P) v))).map
        (conjugateSpanBy (Q (family P) w) (stabilizer (family P) v)).subtype = Q (family P) w) :
    stabilizer (family P) v ≤ normalizer ((Q (family P) w ⊓ Q (family P) v : Subgroup G) : Set G) := by
  have hQP : Q (family P) w ≤ stabilizer (family P) v :=
    (source_Z_Q_U h w).2.trans ((ballKernel_one_le_edge (family P) hvw.symm).trans inf_le_right)
  let X := conjugateSpanBy (Q (family P) w) (stabilizer (family P) v)
  have hXP : X ≤ stabilizer (family P) v := conjugateSpanBy_le_self hQP
  have hnX := le_normalizer_conjugateSpanBy (Q (family P) w) (stabilizer (family P) v)
  obtain ⟨T, hT⟩ := hs
  have hc : Q (family P) w ⊓ Q (family P) v = X.pCoreIn 2 := by
    apply le_antisymm
    · exact (inf_le_inf_right _ (le_conjugateSpanBy _ _)).trans (inf_pCoreIn_le_of_le 2 hXP)
    · exact le_inf ((pCoreIn_le_sylow X T).trans_eq hT) (pCoreIn_mono_of_normalizes hXP hnX)
  rw [hc]
  exact hnX.trans (normalizer_le_normalizer_characteristic_image X (pCore 2 X))

/-- The exact 6.2(c) alternatives at every actual vertex, using its intrinsic L. -/
theorem graphLocalGroup_sylow_or_center (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    (v : Vertex (family P)) :
    (∃ T : Sylow 2 (stabilizer (family P) v ⊓ centralizer (Z (family P) v : Set G) : Subgroup G),
      (T : Subgroup (stabilizer (family P) v ⊓ centralizer (Z (family P) v : Set G) : Subgroup G)).map
        (stabilizer (family P) v ⊓ centralizer (Z (family P) v : Set G)).subtype = Q (family P) v) ∨
      Z (family P) v = omegaCenterIn (graphLocalGroup (family P) v) := by
  let := finite_endpoints h
  obtain ⟨g, hg⟩ := Subgroup.CosetGeometry.exists_smul_base (family P) v
  have hadj : (graph (family P)).Adj v (g • base (family P) (!v.type)) := by
    rw [← hg]
    exact (Subgroup.CosetGeometry.translationGraphIso (family P) g).map_adj_iff.mpr
      ⟨by change v.type ≠ !v.type; cases v.type <;> decide,
        Subgroup.CosetGeometry.incident_base _ _ _⟩
  rcases source_centralizer_sylow_or_Z_eq h hB hS hadj with hs | he
  · exact Or.inl hs
  · obtain ⟨T⟩ := Sylow.nonempty (p := 2) (G := stabilizer (family P) v)
    exact Or.inr (sylowCenterSpan_eq_generated_omega_of_seed _
      (source_vertex_core_selfCentralizing h v) T (he T))


/-- Construct the earlier-local record; only the precise 6.5 obstruction remains explicit. -/
def sourceEarlierLocalTheorems (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    (hob : ∀ v w : Vertex (family P), (graph (family P)).Adj v w →
      ¬ stabilizer (family P) v ≤ normalizer ((Q (family P) w ⊓ Q (family P) v : Subgroup G) : Set G)) :
    CommutingNontrivial.EarlierLocalTheorems (family P) where
  localGroup := graphLocalGroup (family P)
  local_le v := sylowGenerated_le _
  conjugate := graphLocalGroup_conjugate h
  sylow_le v T := sylow_le_sylowGenerated _ T
  common_sylow _ _ hvw := source_common_edge_sylow h hB hS hvw
  kernel_sylow := source_kernel_sylow h hB hS
  sylow_or_center := graphLocalGroup_sylow_or_center h hB hS
  transitive := graphLocalGroup_transitive h hB hS
  core_span_obstruction v w hvw := by
    rw [graph_core_closure_local_eq_full h hB hS hvw]
    exact fun hs => hob v w hvw (graph_core_inter_normal_of_sylow h hvw hs)

/-- Fixed-subgroup generation for the canonical local actor at every vertex. -/
theorem graph_center_fixed_generation (h : LocallyRankOneTriple P B)
    (v : Vertex (family P)) (T : Sylow 2 (stabilizer (family P) v)) :
    conjugateSpanBy (Z (family P) v ⊓ centralizer
      (((T : Subgroup (stabilizer (family P) v)).map (stabilizer (family P) v).subtype :
        Subgroup G) : Set G)) (graphLocalGroup (family P) v) = Z (family P) v := by
  let := finite_endpoints h
  exact sylowCenterSpan_generated_by_sylow_fixed _ _ (sylowGenerated_le _)
    (sylow_le_sylowGenerated _) T

namespace Reduction
variable {L : Fin 2 → Subgroup G} {S : Subgroup G}

/-- All fields of the Chapter 8 earlier-local interface are constructed on the
actual reduced graph, except for the still-open 6.5 obstruction. -/
def reducedEarlierLocalTheorems (h : HypothesisF11 L S)
    (hob : ∀ v w : Vertex (reducedFamily L S), (graph (reducedFamily L S)).Adj v w →
      ¬ stabilizer (reducedFamily L S) v ≤ normalizer
        ((Q (reducedFamily L S) w ⊓ Q (reducedFamily L S) v : Subgroup (G₀ L S)) : Set (G₀ L S))) :
    CommutingNontrivial.EarlierLocalTheorems (reducedFamily L S) :=
  sourceEarlierLocalTheorems (reduced_triple h) (reduced_borel_core_sylow h) (reduced_vertex_sylow h) hob

/-- The opening Chapter 8 critical geometry follows directly from the
constructed local groups, centers and kernels; it needs no 6.5 premise.
This does not assert the later Chapter 8 distance-three conclusion. -/
theorem reduced_commuting_critical_geometry (h : HypothesisF11 L S)
    {a beta a' : Vertex (reducedFamily L S)} (hc : IsCriticalPair (reducedFamily L S) a a')
    (hab : (graph (reducedFamily L S)).Adj a beta)
    (hd : (graph (reducedFamily L S)).dist beta a' + 1 = b (reducedFamily L S))
    (hb : 1 < b (reducedFamily L S))
    (hcomm : ⁅Z (reducedFamily L S) a, Z (reducedFamily L S) a'⁆ = ⊥) :
    Odd (b (reducedFamily L S)) ∧ 3 ≤ b (reducedFamily L S) ∧
      Z (reducedFamily L S) beta = omegaCenterIn (graphLocalGroup (reducedFamily L S) beta) ∧
      (⁅⁅V (reducedFamily L S) beta 1, V (reducedFamily L S) a' 1⁆,
          V (reducedFamily L S) beta 1⁆ = ⊥ ∧
        ⁅⁅V (reducedFamily L S) beta 1, V (reducedFamily L S) a' 1⁆,
          V (reducedFamily L S) a' 1⁆ = ⊥) ∧
      ∃ prev : Vertex (reducedFamily L S), (graph (reducedFamily L S)).Adj a' prev ∧
        (graph (reducedFamily L S)).dist beta prev + 1 =
          (graph (reducedFamily L S)).dist beta a' ∧
        V (reducedFamily L S) beta 1 ≤ Q (reducedFamily L S) prev ∧
          ¬ Q (reducedFamily L S) prev ≤ Q (reducedFamily L S) a' :=
by
  let ht := reduced_triple h
  let hB := reduced_borel_core_sylow h
  let hS := reduced_vertex_sylow h
  let : ∀ i, Finite (reducedFamily L S i) := finite_endpoints ht
  have hZ := fun v => (source_Z_Q_U ht v).1
  have hQU := fun v => (source_Z_Q_U ht v).2
  have hkernel := source_kernel_sylow ht hB hS
  obtain ⟨_, hodd, hb3, hcenter⟩ := CommutingNontrivial.commuting_critical_parity
    (reducedFamily L S) ht.generate hZ hQU (graphLocalGroup (reducedFamily L S))
    (graphLocalGroup_conjugate ht) (fun _ => sylow_le_sylowGenerated _)
    hc hab hd hb hcomm (source_common_edge_sylow ht hB hS hab)
    (graphLocalGroup_sylow_or_center ht hB hS a')
  exact ⟨hodd, hb3, hcenter,
    CommutingNontrivial.radius_one_mutual_quadratic (reducedFamily L S) ht.generate hZ hkernel
      beta a' hd.le hb3,
    CommutingNontrivial.exists_previous_core_escape (reducedFamily L S) ht.generate hZ hQU hkernel
      hc hab hd hb⟩

/-- The corrected 5.12 group-level fixed-generation premise is unconditional
on the reduced F1.11 graph, including its actual local actor and Sylow. -/
theorem reduced_graph_center_fixed_generation (h : HypothesisF11 L S)
    (v : Vertex (reducedFamily L S)) (T : Sylow 2 (stabilizer (reducedFamily L S) v)) :
    conjugateSpanBy (Z (reducedFamily L S) v ⊓ centralizer
      (((T : Subgroup (stabilizer (reducedFamily L S) v)).map
        (stabilizer (reducedFamily L S) v).subtype : Subgroup (G₀ L S)) : Set (G₀ L S)))
          (graphLocalGroup (reducedFamily L S) v) = Z (reducedFamily L S) v :=
  graph_center_fixed_generation (reduced_triple h) v T
end Reduction
end CFSG.Quasithin.ChapterF.Source.DGS85
