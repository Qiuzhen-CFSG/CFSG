public import Theory.Representation.RankOne.QuadraticRecognition.Generation

/-!
# Sylow faithfulness from the original starred overgroup theorem

A nontrivial representation generated by its Sylow fixed spaces cannot
have its kernel supplement a Sylow. Pull the kernel back to the actual
local enlargement. The original starred overgroup theorem puts this
preimage in the full Borel, so it has a normal Sylow two-subgroup.
Normality in the enlargement then puts that Sylow in the actual two-core.
Consequently every Sylow of the quotient acts faithfully.

Conjugation transports the result to each intrinsic graph actor without
recognizing the enlarged quotient. `IntrinsicFactorBounds` applies it to
the actual ending constituent in DGS 8.2, including the possible quotient
of order 144. Only vertex stabilizers are required to be finite.
Source: DGS, *Groups and Graphs* (1985), 5.1 and 6.0--6.2,
pp.104--105,118--119; the corrected fixed-generation premise of 5.12.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Theory.GroupTheory.AmalgamGraph
open Representation Representation.BinaryOffender Representation.RankOne.QuadraticRecognition
namespace CFSG.Quasithin.ChapterF.Source.DGS85
variable {G : Type*} [Group G] {P B : Subgroup G}

private theorem trivial_of_kernel_sup_fixed (D W : Type*) [Group D]
    [AddCommGroup W] [Module (ZMod 2) W]
    (σ : Representation (ZMod 2) D W) (T : Subgroup D)
    (hg : GeneratedByFixedSpace σ T) (hsup : σ.ker ⊔ T = ⊤) : σ = 1 := by
  have hR : fixedSpace σ σ.ker = ⊤ := by
    apply top_unique
    intro w _ a
    change σ a w = w
    rw [show σ a = 1 from a.property]
    rfl
  have hfix : fixedSpace σ ⊤ = fixedSpace σ T := by
    have he := σ.invariants_comp_sup σ.ker T
    change fixedSpace σ (σ.ker ⊔ T) = fixedSpace σ σ.ker ⊓ fixedSpace σ T at he
    rwa [hsup,hR,top_inf_eq] at he
  have hspan : (⨆ g : D, (fixedSpace σ T).map (σ g)) ≤ fixedSpace σ ⊤ := by
    apply iSup_le
    rintro g _ ⟨v,hv,rfl⟩
    have hv' : v ∈ fixedSpace σ ⊤ := hfix.symm ▸ hv
    rw [show σ g v = v from hv' ⟨g,mem_top _⟩]
    exact hv'
  have htop : fixedSpace σ ⊤ = ⊤ := top_unique (hg ▸ hspan)
  apply MonoidHom.ext
  intro g
  apply LinearMap.ext
  intro w
  exact (show w ∈ fixedSpace σ ⊤ from htop.symm ▸ Submodule.mem_top) ⟨g,mem_top _⟩

/-- The original starred data imply Sylow faithfulness for every nontrivial
fixed-generated representation of the actual enlarged core quotient. -/
theorem localEnlargement_fixed_generated_sylow_faithful
    (d : LocalRankOneData P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∃ T : Sylow 2 P, (T : Subgroup P).map P.subtype ≤ B)
    {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]
    (σ : Representation (ZMod 2) (localEnlargement d ⧸ pCore 2 (localEnlargement d)) W)
    (hg : ∀ T : Sylow 2 (localEnlargement d ⧸ pCore 2 (localEnlargement d)),
      GeneratedByFixedSpace σ T) (hnt : σ ≠ 1) (T₀ : Sylow 2 (localEnlargement d ⧸ pCore 2 (localEnlargement d))) :
    Disjoint σ.ker (T₀ : Subgroup _) := by
  let M := localEnlargement d
  let R := B.pCoreIn 2
  let D := M ⧸ pCore 2 M
  let q := QuotientGroup.mk' (pCore 2 M)
  let := d.finite_P
  let : Finite M := Finite.of_injective (inclusion (localEnlargement_le d)) (inclusion_injective _)
  let : Finite B := Finite.of_injective (inclusion (le_sup_right.trans d.supplement.le)) (inclusion_injective _)
  have hRM : R ≤ M := le_sup_right
  have hRB : R ≤ B := pCoreIn_le 2 B
  have hRP : R ≤ P := hRM.trans (localEnlargement_le d)
  obtain ⟨T,hT⟩ := hS
  have hTR : (T : Subgroup P).map P.subtype = R :=
    sylow_image_eq_edge_core P B (le_sup_right.trans d.supplement.le) hB T hT
  let TM := T.subtype (show (T : Subgroup P) ≤ M.subgroupOf P from fun t ht =>
    hRM (hTR ▸ mem_map_of_mem P.subtype ht))
  let f : M.subgroupOf P ≃* M := subgroupOfEquivOfLe (localEnlargement_le d)
  let U := TM.mapSurjective (f := f.toMonoidHom) f.surjective
  have hUR : (U : Subgroup M) = R.subgroupOf M := by
    ext m
    constructor
    · rintro ⟨x,hx,rfl⟩
      exact hTR ▸ mem_map_of_mem P.subtype hx
    · intro hm
      obtain ⟨t,ht,he⟩ := hTR.symm ▸ hm
      exact ⟨⟨t,by
        change (t : G) ∈ M
        change (t : G) = (m : G) at he
        rw [he]
        exact m.property⟩,ht,Subtype.ext he⟩
  let V := quotientSylow U
  have hV : (V : Subgroup D) = (R.subgroupOf M).map q := by
    change (U : Subgroup M).map q = _
    rw [hUR]
  let K := σ.ker.comap q
  let H := K.map M.subtype
  have hHM : H ≤ M := map_subtype_le _
  have htop : H ⊔ R ≠ M := by
    intro he
    have hh := congrArg (fun N : Subgroup G => N.subgroupOf M) he
    rw [subgroupOf_sup hHM hRM,subgroupOf_self] at hh
    change (K.map M.subtype).comap M.subtype ⊔ R.subgroupOf M = ⊤ at hh
    rw [comap_map_eq_self_of_injective M.subtype_injective] at hh
    have hh' := congrArg (Subgroup.map q) hh
    rw [Subgroup.map_sup,map_comap_eq_self_of_surjective (QuotientGroup.mk'_surjective _),
      ←MonoidHom.range_eq_map,MonoidHom.range_eq_top.mpr (QuotientGroup.mk'_surjective _)] at hh'
    exact hnt (trivial_of_kernel_sup_fixed D W σ V (hg V) (by rwa [hV]))
  have hTB : (d.sylow : Subgroup d.Pstar).map d.Pstar.subtype ≤ R :=
    pGroup_le_core_of_core_sylow B _ (source_star_sylow_le_borel d) (d.sylow.isPGroup'.map _) hB
  have hHB : H ≤ B := by
    rcases source_overgroup_star_or_borel d (H ⊔ R)
      ((sup_le hHM hRM).trans (localEnlargement_le d)) (hTB.trans le_sup_right) with hs | hb
    · exact (htop (le_antisymm (sup_le hHM hRM) (sup_le hs le_sup_right))).elim
    · exact le_sup_left.trans hb
  let : Finite H := Finite.of_injective (inclusion hHM) (inclusion_injective _)
  have hH := core_sylow_of_le B H hHB hB
  have hHK : H.subgroupOf M = K :=
    comap_map_eq_self_of_injective M.subtype_injective _
  have hnH : M ≤ normalizer (H : Set G) :=
    (normal_subgroupOf_iff_le_normalizer hHM).mp (by rw [hHK]; infer_instance)
  have hcore : H.pCoreIn 2 ≤ M.pCoreIn 2 := pCoreIn_mono_of_normalizes hHM hnH
  obtain ⟨T₁,hT₁⟩ := Sylow.mapSurjective_surjective (f := q)
    (QuotientGroup.mk'_surjective _) 2 T₀
  apply disjoint_iff.mpr
  apply bot_unique
  intro x hx
  have hxT : x ∈ (T₁ : Subgroup M).map q := by
    change x ∈ (T₁.mapSurjective (f := q) (QuotientGroup.mk'_surjective _) : Subgroup D)
    rw [hT₁]
    exact hx.2
  obtain ⟨t,ht,rfl⟩ := hxT
  let C := K ⊓ (T₁ : Subgroup M)
  have hCH : C.map M.subtype ≤ H := map_mono inf_le_left
  have hCQ : C.map M.subtype ≤ M.pCoreIn 2 :=
    (pGroup_le_core_of_core_sylow H _ hCH
      ((T₁.isPGroup'.to_le inf_le_right).map _) hH).trans hcore
  have htQ := hCQ (mem_map_of_mem M.subtype (show t ∈ C from ⟨hx.1,ht⟩))
  have htcore : t ∈ pCore 2 M := by
    obtain ⟨y,hy,he⟩ := htQ
    exact (Subtype.ext he : y = t) ▸ hy
  exact mem_bot.mpr ((QuotientGroup.eq_one_iff t).mpr htcore)


private theorem sylow_faithful_of_equiv
    {D E W : Type*} [Group D] [Group E] [Finite D] [Finite E]
    [AddCommGroup W] [Module (ZMod 2) W]
    (e : D ≃* E) (σ : Representation (ZMod 2) D W)
    (hg : ∀ T : Sylow 2 D, GeneratedByFixedSpace σ T) (hnt : σ ≠ 1)
    (he : ∀ (ρ : Representation (ZMod 2) E W),
      (∀ T : Sylow 2 E, GeneratedByFixedSpace ρ T) → ρ ≠ 1 →
      ∀ T : Sylow 2 E, Disjoint ρ.ker (T : Subgroup E))
    (T : Sylow 2 D) : Disjoint σ.ker (T : Subgroup D) := by
  let ρ := σ.comp e.symm.toMonoidHom
  have hg' : ∀ R : Sylow 2 E, GeneratedByFixedSpace ρ R := by
    intro R
    obtain ⟨U,rfl⟩ := Sylow.mapSurjective_surjective (f := e.toMonoidHom) e.surjective 2 R
    exact generatedByFixedSpace_of_equivariant_surjection σ ρ e.toMonoidHom
      LinearMap.id Function.surjective_id (by intro g v; simp [ρ]) U (hg U)
  have hnt' : ρ ≠ 1 := by
    intro hh
    apply hnt
    ext g v
    have ht := DFunLike.congr_fun (DFunLike.congr_fun hh (e g)) v
    simpa [ρ] using ht
  have hd := he ρ hg' hnt' (T.mapSurjective (f := e.toMonoidHom) e.surjective)
  apply disjoint_iff.mpr
  apply bot_unique
  intro x hx
  have hm : e x ∈ ρ.ker ⊓
      (T.mapSurjective (f := e.toMonoidHom) e.surjective : Subgroup E) := by
    refine ⟨?_,mem_map_of_mem _ hx.2⟩
    change ρ (e x) = 1
    simpa [ρ] using hx.1
  exact mem_bot.mpr (e.injective ((mem_bot.mp (hd.le_bot hm)).trans (map_one e).symm))

open Subgroup.CosetGeometry.RankTwo

/-- Every nontrivial action generated by Sylow fixed spaces is faithful on
Sylows of the intrinsic actor quotient, with no enlarged quotient marking. -/
theorem graph_intrinsic_fixed_generated_sylow_faithful
    {P : Fin 2 → Subgroup G} {B : Subgroup G} (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    (v : Vertex (family P))
    {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]
    (σ : Representation (ZMod 2)
      (graphLocalGroup (family P) v ⧸ pCore 2 (graphLocalGroup (family P) v)) W)
    (hg : ∀ T : Sylow 2 (graphLocalGroup (family P) v ⧸ pCore 2 (graphLocalGroup (family P) v)),
      GeneratedByFixedSpace σ T) (hnt : σ ≠ 1)
    (T : Sylow 2 (graphLocalGroup (family P) v ⧸ pCore 2 (graphLocalGroup (family P) v))) :
    Disjoint σ.ker (T : Subgroup _) := by
  let := finite_endpoints h
  obtain ⟨g,hg₀⟩ := Subgroup.CosetGeometry.exists_smul_base (family P) v
  have hd : Nonempty (LocalRankOneData (family P v.type) B) := by
    cases hv : v.type
    · exact h.local_data 0
    · exact h.local_data 1
  let d := Classical.choice hd
  have hs : ∃ R : Sylow 2 (family P v.type),
      (R : Subgroup (family P v.type)).map (family P v.type).subtype ≤ B := by
    cases hv : v.type
    · exact hS 0
    · exact hS 1
  have hbase := graphLocalGroup_base_eq hB hS v.type d
  have hm : graphLocalGroup (family P) v =
      (localEnlargement d).map (MulAut.conj g).toMonoidHom := by
    calc
      _ = graphLocalGroup (family P) (g • base (family P) v.type) := congrArg _ hg₀.symm
      _ = _ := by rw [graphLocalGroup_conjugate h,hbase]
  let M := graphLocalGroup (family P) v
  let : Finite M := Finite.of_injective (inclusion (sylowGenerated_le _)) (inclusion_injective _)
  let : Finite (localEnlargement d) := Finite.of_injective
    (inclusion (localEnlargement_le d)) (inclusion_injective _)
  let e : M ≃* localEnlargement d := (MulEquiv.subgroupCongr hm).trans
    ((localEnlargement d).equivMapOfInjective
      (MulAut.conj g).toMonoidHom (MulAut.conj g).injective).symm
  exact sylow_faithful_of_equiv (QuotientGroup.congr _ _ e (pCore_map_iso 2 e)) σ hg hnt
    (fun ρ hgen hne R => localEnlargement_fixed_generated_sylow_faithful d hB hs ρ hgen hne R) T

end CFSG.Quasithin.ChapterF.Source.DGS85
