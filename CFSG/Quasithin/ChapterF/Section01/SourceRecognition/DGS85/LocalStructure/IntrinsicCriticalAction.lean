module
public import Theory.GroupTheory.SylowLocalCore
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.LocalStructure.EarlierInputs
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.Noncommuting.EndpointSections
public import Theory.GroupTheory.AmalgamGraph.LinearPathKernel

/-!
# The full critical-center action of the intrinsic actor

The subgroup generated by the vertex Sylows has the same Sylow-center span
and the same embedded two-core as the vertex stabilizer. Conjugation
therefore gives the literal full-center action through the intrinsic
actor's two-core quotient. Every quotient Sylow satisfies fixed-space
generation. The critical centralizer intersection detects its whole
Sylow kernel, without a model hypothesis on the enlarged actor.

`CriticalActorSelection` uses these full-center actions for reciprocal
index counting. The later natural-section consumer retains its original
central denominator; it is not replaced by the full center here.
Source: DGS, *Groups and Graphs* (1985), 3.8, 6.0--6.2 and the opening of
7.1, pp.82--83,118--119,126--127; corrected fixed generation in 5.12.
-/

public noncomputable section
open scoped IsMulCommutative
open Subgroup Representation Representation.BinaryConjugationSection
open Representation.BinaryOffender Representation.RankOne.QuadraticRecognition
open Theory.GroupTheory.AmalgamGraph Subgroup.CosetGeometry.RankTwo
namespace CFSG.Quasithin.ChapterF.Source.DGS85
variable {G : Type*} [Group G] {P : Fin 2 → Subgroup G} {B : Subgroup G}

/-- The intrinsic Sylow-generated actor has the same center span as its vertex. -/
theorem graph_intrinsic_center_span (h : LocallyRankOneTriple P B) (v : Vertex (family P)) :
    Z (family P) v = sylowCenterSpan (graphLocalGroup (family P) v) := by
  let := finite_endpoints h
  let M := graphLocalGroup (family P) v
  let : Finite M := Finite.of_injective (inclusion (sylowGenerated_le _)) (inclusion_injective _)
  obtain ⟨T⟩ := Sylow.nonempty (p := 2) (G := stabilizer (family P) v)
  obtain ⟨R,hR⟩ := T.exists_map_subtype_eq_of_le (sylowGenerated_le _)
    (sylow_le_sylowGenerated _ T)
  change sylowCenterSpan (stabilizer (family P) v) = _
  rw [sylowCenterSpan_eq_conjugateSpan _ M (sylowGenerated_le _)
    (sylow_le_sylowGenerated _) T,←hR]
  exact (sylowCenterSpan_eq_conjugateSpan M M le_rfl (fun _ => map_subtype_le _) R).symm

/-- The actual core restriction agrees with the intrinsic actor core. -/
theorem graph_intrinsic_core (h : LocallyRankOneTriple P B) (v : Vertex (family P)) :
    (Q (family P) v).subgroupOf (graphLocalGroup (family P) v) =
      pCore 2 (graphLocalGroup (family P) v) := by
  let := finite_endpoints h
  rw [show Q (family P) v = (graphLocalGroup (family P) v).pCoreIn 2 from
    (sylowGenerated_core _).symm]
  exact comap_map_eq_self_of_injective (graphLocalGroup (family P) v).subtype_injective _

/-- The full critical-center action and its fixed generation and faithful Sylow
images require no enlarged quotient catalogue. -/
theorem graph_intrinsic_critical_action
    (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    {v w : Vertex (family P)} (hc : IsCriticalPair (family P) v w) :
    let M := graphLocalGroup (family P) v
    let D := M ⧸ pCore 2 M
    letI := Noncommuting.graph_Z_elementary h v
    ∃ (σ : Representation (ZMod 2) D (Additive (Z (family P) v)))
      (s : BinaryConjugationSection M (Z (family P) v) ⊥
        (σ.comp (QuotientGroup.mk' (pCore 2 M)))),
      (∀ z : Z (family P) v, (s.coordinates z).toAdd = Additive.ofMul z) ∧
      (∀ R : Sylow 2 D, GeneratedByFixedSpace σ R) ∧
      ∀ R : Sylow 2 D, Disjoint σ.ker (R : Subgroup D) := by
  let := finite_endpoints h
  let := Noncommuting.graph_Z_elementary h v
  let M := graphLocalGroup (family P) v
  let D := M ⧸ pCore 2 M
  let π := QuotientGroup.mk' (pCore 2 M)
  let : Finite M := Finite.of_injective (inclusion (sylowGenerated_le _)) (inclusion_injective _)
  have hZL : Z (family P) v ≤ M := by
    rw [graph_intrinsic_center_span h v]
    exact sylowCenterSpan_le _
  have hnZ : M ≤ normalizer (Z (family P) v : Set G) :=
    (sylowGenerated_le _).trans
      ((normal_subgroupOf_iff_le_normalizer (Z_le_stabilizer _ _)).mp (Z_normal _ _))
  have hcore := graph_intrinsic_core h v
  obtain ⟨σ,s,hcoord⟩ := exists_of_central_kernel M _ hZL hnZ π
    (QuotientGroup.mk'_surjective _) (by
      intro a ha
      have haQ : (a : G) ∈ Q (family P) v := by
        change a ∈ (Q (family P) v).subgroupOf M
        rw [hcore]
        exact (QuotientGroup.eq_one_iff a).mp ha
      exact Noncommuting.graph_Q_centralizes_Z h v haQ)
  refine ⟨σ,s,hcoord,?_,?_⟩
  · intro R
    obtain ⟨T,rfl⟩ := Sylow.mapSurjective_surjective
      (f := π) (QuotientGroup.mk'_surjective _) 2 R
    exact sylow_span_fixedSpace_generated M _ _ σ π s T (graph_intrinsic_center_span h v)
  · intro R
    obtain ⟨T,rfl⟩ := Sylow.mapSurjective_surjective
      (f := π) (QuotientGroup.mk'_surjective _) 2 R
    let A := (T : Subgroup M).map M.subtype
    have hi := source_critical_inf_centralizer h hB hS hc A (T.isPGroup'.map _)
      ((map_subtype_le _).trans (sylowGenerated_le _))
    apply disjoint_iff.mpr
    apply bot_unique
    rintro _ ⟨hk,t,ht,rfl⟩
    apply (QuotientGroup.eq_one_iff t).mpr
    rw [←hcore]
    have hct : (t : G) ∈ centralizer (Z (family P) v : Set G) := by
      intro z hz
      have hh := (s.action_mem_ker_iff t).mp hk z hz
      exact (commutatorElement_eq_one_iff_mul_comm.mp (mem_bot.mp hh)).symm
    exact (hi.le ⟨mem_map_of_mem M.subtype ht,hct⟩).2

end CFSG.Quasithin.ChapterF.Source.DGS85
