module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.LocalStructure.CoreClosure
public import Theory.GroupTheory.ConjugateSpanSupplement

/-!
# The neighboring center in the adjacent-core closure

Under the contrary relative normality of DGS 6.4, X = <Q_delta^{G_lambda}>
supplements the full Borel. That Borel normalizes its own Sylow omega-center,
so Z_lambda is generated by this same seed under X alone. The seed lies in
Omega_1 Z(Q_delta) and centralizes Q_delta. Thus Z_lambda lies in Baumann's
literal center closure and is generated under X by its Q_delta-fixed subgroup.
Once 6.4 identifies Q_delta as Sylow in X, this is exactly the group form of
the corrected fixed-space-generation hypothesis for the neighboring center.
The proof does not assume that Sylow assertion or a selected linear model.

Source: DGS, Groups and Graphs (1985), definitions p.81 and 6.4--6.5,
pp.120--122; Stroth's fixed-space-generation correction to 5.12.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterF.Source.DGS85
open Theory.GroupTheory.AmalgamGraph
variable {G : Type*} [Group G] {P : Fin 2 → Subgroup G} {B : Subgroup G}

/-- The full neighboring center is the actual Borel omega-center span under X. -/
theorem source_neighbor_center_eq_seed_span (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    (i : Fin 2)
    (hn : P (other i) ≤ normalizer (↑((P i).pCoreIn 2 ⊓ (P (other i)).pCoreIn 2) : Set G)) :
    sylowCenterSpan (P (other i)) = conjugateSpanBy (omegaCenterIn (B.pCoreIn 2))
      (conjugateSpanBy ((P i).pCoreIn 2) (P (other i))) := by
  let := (Classical.choice (h.local_data (other i))).finite_P
  obtain ⟨T,hT⟩ := hS (other i)
  rw [sylowCenterSpan_eq_conjugateSpan (P (other i)) (P (other i)) le_rfl
    (fun _ => map_subtype_le _) T,
    sylow_image_eq_edge_core _ B
      (le_sup_right.trans (Classical.choice (h.local_data (other i))).supplement.le) hB T hT]
  conv_lhs => rw [←core_closure_sup_borel_of_inter_normal h hB i hn]
  apply conjugateSpanBy_sup_of_normalizes_seed
  · exact (B.le_normalizer.trans (normalizer_le_normalizer_characteristic_image B (pCore 2 B))).trans
      (normalizer_le_normalizer_omegaCenterIn _)
  · exact (le_sup_right.trans (Classical.choice (h.local_data (other i))).supplement.le).trans
      (le_normalizer_conjugateSpanBy _ _)

/-- The neighboring center lies in the literal module used by Baumann in 6.5. -/
theorem source_neighbor_center_le_baumann (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    (i : Fin 2)
    (hn : P (other i) ≤ normalizer (↑((P i).pCoreIn 2 ⊓ (P (other i)).pCoreIn 2) : Set G)) :
    sylowCenterSpan (P (other i)) ≤ conjugateSpanBy (omegaCenterIn ((P i).pCoreIn 2))
      (conjugateSpanBy ((P i).pCoreIn 2) (P (other i))) := by
  let := (Classical.choice (h.local_data i)).finite_P
  obtain ⟨R,hR⟩ := hS i
  rw [source_neighbor_center_eq_seed_span h hB hS i hn]
  apply conjugateSpanBy_mono _ le_rfl
  rw [←sylow_image_eq_edge_core (P i) B
    (le_sup_right.trans (Classical.choice (h.local_data i)).supplement.le) hB R hR]
  exact (le_iSup (fun R : Sylow 2 (P i) =>
    omegaCenterIn ((R : Subgroup (P i)).map (P i).subtype)) R).trans
    (sylowCenterSpan_le_coreOmega _ (source_core_selfCentralizing (Classical.choice (h.local_data i))))

/-- Fixed-subgroup generation on this very center, without deleting central summands. -/
theorem source_neighbor_center_generated_by_core_fixed (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    (i : Fin 2)
    (hn : P (other i) ≤ normalizer (↑((P i).pCoreIn 2 ⊓ (P (other i)).pCoreIn 2) : Set G)) :
    conjugateSpanBy (sylowCenterSpan (P (other i)) ⊓ centralizer ((P i).pCoreIn 2 : Set G))
      (conjugateSpanBy ((P i).pCoreIn 2) (P (other i))) = sylowCenterSpan (P (other i)) := by
  let := (Classical.choice (h.local_data (other i))).finite_P
  have hBP : B ≤ P (other i) := le_sup_right.trans (Classical.choice (h.local_data (other i))).supplement.le
  let : Finite B := Finite.of_injective (inclusion hBP) (inclusion_injective _)
  have hAS : (P i).pCoreIn 2 ≤ B.pCoreIn 2 := pGroup_le_core_of_core_sylow B _
    (source_core_le_borel (Classical.choice (h.local_data i))) (isPGroup_pCoreIn 2 _) hB
  have hXP : conjugateSpanBy ((P i).pCoreIn 2) (P (other i)) ≤ P (other i) :=
    conjugateSpanBy_le_self ((source_core_le_borel (Classical.choice (h.local_data i))).trans hBP)
  apply le_antisymm
  · exact conjugateSpanBy_le inf_le_left (hXP.trans
      ((normal_subgroupOf_iff_le_normalizer (sylowCenterSpan_le _)).mp (sylowCenterSpan_normal _)))
  · conv_lhs => rw [source_neighbor_center_eq_seed_span h hB hS i hn]
    apply conjugateSpanBy_mono _ le_rfl
    refine le_inf ?_ ?_
    · rw [source_neighbor_center_eq_seed_span h hB hS i hn]
      exact le_conjugateSpanBy _ _
    · exact fun z hz => centralizer_le hAS ((mem_omegaCenterIn_iff _ _).mp hz).2.1

namespace Reduction
variable {L : Fin 2 → Subgroup G} {S : Subgroup G}

/-- The actual reduced F1.11 center has both containment and fixed generation
inside its marked adjacent-core closure. No model choice is an input. -/
theorem reduced_neighbor_center_generation (h : HypothesisF11 L S) (i : Fin 2)
    (hn : localEnlargement (Classical.choice ((reduced_triple h).local_data (other i))) ≤
      normalizer (↑(((P₀ L S i).subgroupOf (G₀ L S)).pCoreIn 2 ⊓
        ((P₀ L S (other i)).subgroupOf (G₀ L S)).pCoreIn 2) : Set (G₀ L S))) :
    let A := ((P₀ L S i).subgroupOf (G₀ L S)).pCoreIn 2
    let Z := sylowCenterSpan ((P₀ L S (other i)).subgroupOf (G₀ L S))
    let X := conjugateSpanBy A ((P₀ L S (other i)).subgroupOf (G₀ L S))
    Z ≤ conjugateSpanBy (omegaCenterIn A) X ∧
      conjugateSpanBy (Z ⊓ centralizer (A : Set (G₀ L S))) X = Z := by
  have hn' := (inter_core_local_normal_iff (reduced_triple h) i _).mp hn
  exact ⟨source_neighbor_center_le_baumann (reduced_triple h) (reduced_borel_core_sylow h)
    (reduced_vertex_sylow h) i hn', source_neighbor_center_generated_by_core_fixed
    (reduced_triple h) (reduced_borel_core_sylow h) (reduced_vertex_sylow h) i hn'⟩
end Reduction
end CFSG.Quasithin.ChapterF.Source.DGS85
