module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.LocalStructure.ClosureCenterGeneration
public import Theory.GroupTheory.SylowNormalRestriction
public import Theory.Representation.BinaryConjugationSection.SylowGeneration
public import Theory.Representation.BinaryConjugationSection.ConjugateSpan
public import Theory.Representation.RankOne.QuadraticRecognition.Generation

/-!
# Sylow fixed generation in the adjacent-core closure

Let X = <Q_delta^{G_lambda}>. Its normality in the finite endpoint lets
us intersect the original full-Borel Sylow with X. This gives an actual
Sylow of X without assuming that Q_delta is Sylow. Under the contrary
relative normality of 6.4, the Borel omega-center generates Z_lambda under
X, and is fixed by this Sylow intersection. Every literal equivariant
section of Z_lambda therefore satisfies the corrected fixed-generation
premise of 5.12, retaining its original denominator and actor map.

Source: DGS, Groups and Graphs (1985), 6.4, pp.120--121; the Sylow-center
definition, p.81; Stroth's fixed-generation correction to 5.12. This does
not construct the replacement offender or identify the closure quotient.
-/

public noncomputable section
open Subgroup Theory.GroupTheory.AmalgamGraph
open Representation Representation.BinaryConjugationSection Representation.BinaryOffender
open Representation.RankOne.QuadraticRecognition
namespace CFSG.Quasithin.ChapterF.Source.DGS85
variable {G : Type*} [Group G] {P : Fin 2 → Subgroup G} {B : Subgroup G}

/-- The closure Sylow is the intersection with the original full Borel core. -/
theorem source_closure_sylow_intersection (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    (i : Fin 2) :
    let X := conjugateSpanBy ((P i).pCoreIn 2) (P (other i))
    ∃ T : Sylow 2 X, (T : Subgroup X).map X.subtype = B.pCoreIn 2 ⊓ X := by
  let R := P (other i)
  let := (Classical.choice (h.local_data (other i))).finite_P
  let X := conjugateSpanBy ((P i).pCoreIn 2) R
  have hBP : B ≤ R := le_sup_right.trans (Classical.choice (h.local_data (other i))).supplement.le
  have hXP : X ≤ R := conjugateSpanBy_le_self
    ((source_core_le_borel (Classical.choice (h.local_data i))).trans hBP)
  let Y := X.subgroupOf R
  let : Y.Normal := (normal_subgroupOf_iff_le_normalizer hXP).mpr
    (le_normalizer_conjugateSpanBy _ _)
  obtain ⟨S,hS⟩ := hS (other i)
  obtain ⟨T,hT⟩ := S.exists_sylow_map_eq_inf_of_normal Y
  let e : Y ≃* X := subgroupOfEquivOfLe hXP
  refine ⟨T.mapSurjective (f := e.toMonoidHom) e.surjective, ?_⟩
  change ((T : Subgroup Y).map e.toMonoidHom).map X.subtype = _
  rw [map_map]
  have he : X.subtype.comp e.toMonoidHom = R.subtype.comp Y.subtype := rfl
  rw [he, ←map_map,hT,map_inf _ _ _ R.subtype_injective,
    map_subgroupOf_eq_of_le hXP,sylow_image_eq_edge_core R B hBP hB S hS]

/-- Every literal section is generated by the fixed space of the actual closure Sylow. -/
theorem source_closure_section_generated
    {D W : Type*} [Group D] [AddCommGroup W] [Module (ZMod 2) W]
    (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    (i : Fin 2)
    (hn : P (other i) ≤ normalizer (↑((P i).pCoreIn 2 ⊓ (P (other i)).pCoreIn 2) : Set G))
    (C : Subgroup G)
    (σ : Representation (ZMod 2) D W)
    (π : conjugateSpanBy ((P i).pCoreIn 2) (P (other i)) →* D)
    (d : BinaryConjugationSection (conjugateSpanBy ((P i).pCoreIn 2) (P (other i)))
      (sylowCenterSpan (P (other i))) C (σ.comp π))
    (T : Sylow 2 (conjugateSpanBy ((P i).pCoreIn 2) (P (other i))))
    (hT : (T : Subgroup (conjugateSpanBy ((P i).pCoreIn 2) (P (other i)))).map
      (conjugateSpanBy ((P i).pCoreIn 2) (P (other i))).subtype ≤ B.pCoreIn 2) :
    GeneratedByFixedSpace σ ((T : Subgroup _).map π) := by
  let X := conjugateSpanBy ((P i).pCoreIn 2) (P (other i))
  let Z := sylowCenterSpan (P (other i))
  let A := (T : Subgroup X).map π
  let U := fixedConjugateSpan σ A
  let U' : Subrepresentation (σ.comp π) :=
    ⟨U.toSubmodule, fun a _ hv => U.apply_mem_toSubmodule (π a) hv⟩
  apply d.generated_image_le (omegaCenterIn (B.pCoreIn 2))
    (source_neighbor_center_eq_seed_span h hB hS i hn) U'
  intro w hw
  obtain ⟨z,hz,rfl⟩ := (d.mem_imageSpace_iff _ w).mp hw
  apply fixedSpace_le_fixedConjugateSpan σ A
  intro a
  obtain ⟨t,ht,he⟩ := a.property
  change σ a.val (d.coordinates z).toAdd = _
  rw [←he]
  have hc := ((mem_omegaCenterIn_iff _ _).mp hz).2.1
    (t : G) (hT (mem_map_of_mem X.subtype ht))
  have hf : (⟨(t : G)*z*(t : G)⁻¹,
      (mem_normalizer_iff.mp (d.normalized t.property) z).mp z.property⟩ : Z) = z := by
    apply Subtype.ext
    change (t : G)*(z : G)*(t : G)⁻¹ = z
    rw [hc,mul_inv_cancel_right]
  have hd := d.equivariant t z
  rw [hf] at hd
  exact hd.symm

end CFSG.Quasithin.ChapterF.Source.DGS85
