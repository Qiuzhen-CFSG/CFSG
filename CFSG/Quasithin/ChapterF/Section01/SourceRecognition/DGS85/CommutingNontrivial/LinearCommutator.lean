module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingNontrivial.ReciprocalLinear

/-!
# The linear quotient-omega commutator in DGS 8.3

For a quadratic binary SL₂ Sylow action generated by its fixed space and
with zero global fixed space, complementary conjugate Sylow fixed spaces
have equal dimension. Uniformity of nonidentity Sylow fixed spaces then
makes every nonidentity displacement image equal to the Sylow fixed space.
Consequently the displacement of any nonzero actor already contains every
Sylow displacement.

Apply this to the actual moving center Z_lambda. The subgroup
V_beta intersect Q_alpha' has nonzero quotient image and its commutator
with Z_lambda lies in H. Original 8.1(h) makes the full edge Sylow quadratic
in the linear row, so its entire commutator with Z_lambda lies in H. The
literal quotient omega-center preimage lies in that same full edge Sylow,
giving the exact original 8.3 inclusion. The reduced F1.11 application
retains its chosen moving neighbor and original quotient Sylow placement.

Source: DGS, *Groups and Graphs* (1985), (8.3), pp.135--137, using (8.1)(h)
and (5.8). No natural-module, reverse-containment or field-size hypothesis
is added. This settles the linear row, including SL₂(2); the remaining
8.3 rows and the full Chapter 8 theorem remain with this owner.
-/

@[expose] public noncomputable section
open Subgroup Representation Representation.BinaryOffender
open Representation.RankOne.QuadraticRecognition
open scoped MatrixGroups IsMulCommutative commutatorElement
namespace CFSG.Quasithin.ChapterF.Source.DGS85.CommutingNontrivial
open Subgroup.CosetGeometry.RankTwo Theory.GroupTheory.AmalgamGraph
universe u
variable {G : Type u} [Group G]

private theorem linear_displacement_fixed {K W : Type*} [Field K] [Finite K] [CharP K 2]
    [AddCommGroup W] [Module (ZMod 2) W] [Finite W]
    (ρ : Representation (ZMod 2) SL(2,K) W) (S : Sylow 2 SL(2,K))
    (hq : IsQuadratic ρ S) (hg : GeneratedByFixedSpace ρ S) (hf : fixedSpace ρ ⊤ = ⊥)
    (t : SL(2,K)) (ht : t ∈ S) (ht1 : t ≠ 1) :
    LinearMap.range (ρ t - 1) = fixedSpace ρ S := by
  obtain ⟨g,hgS⟩ := SetLike.exists_not_mem_of_ne_top (normalizer (S : Set SL(2,K)))
    (Matrix.SpecialLinearGroup.sylow_normalizer_ne_top S)
  have hST : S ≠ g • S := fun he => hgS (Sylow.smul_eq_iff_mem_normalizer.mp he.symm)
  have hc := sl2_sylow_fixed_isCompl ρ S (g • S) hST hq hg hf
  have hu := (SL2SylowFixedRecognition.fixedSpaceHypotheses_of_isCompl ρ S (g • S) hc).uniform
  have hk : (ρ t - 1).ker = fixedSpace ρ S := by
    rw [←hu t ht ht1]
    ext v
    rw [mem_fixedSpace_zpowers_iff]
    exact sub_eq_zero
  have hr : LinearMap.range (ρ t - 1) ≤ fixedSpace ρ S := by
    rintro v ⟨w,rfl⟩ s
    exact hq s s.property t ht w
  apply Submodule.eq_of_le_of_finrank_eq hr
  have hdim := (fixedSpace ρ S).finrank_sup_add_finrank_inf_eq (fixedSpace ρ (g • S : Sylow 2 SL(2,K)))
  rw [hc.sup_eq_top,hc.inf_eq_bot,finrank_top,finrank_bot,add_zero] at hdim
  have he := (fixedSpaceConjEquiv ρ S g).finrank_eq
  change Module.finrank (ZMod 2) (fixedSpace ρ S) =
    Module.finrank (ZMod 2) (fixedSpace ρ (g • S : Sylow 2 SL(2,K))) at he
  have hn := LinearMap.finrank_range_add_finrank_ker (ρ t - 1)
  rw [hk] at hn
  omega

private theorem linear_center_commutator_control {K : Type*} [Field K] [Finite K] [CharP K 2]
    (L Z A E H : Subgroup G) [IsElementaryAbelian 2 Z] [Finite Z]
    (hZL : Z ≤ L) (hnZ : L ≤ normalizer (Z : Set G)) (hEL : E ≤ L)
    (q : L →* SL(2,K)) (ρ : Representation (ZMod 2) SL(2,K) (Additive Z))
    (hact : ∀ (l : L) (z : Additive Z),
      ((ρ (q l) z).toMul : G) = (l : G) * z.toMul * (l : G)⁻¹)
    (S : Sylow 2 SL(2,K)) (hAS : (A.subgroupOf L).map q ≤ S)
    (hES : (E.subgroupOf L).map q ≤ S) (hne : (A.subgroupOf L).map q ≠ ⊥)
    (hq : IsQuadratic ρ S) (hg : GeneratedByFixedSpace ρ S) (hf : fixedSpace ρ ⊤ = ⊥)
    (hH : ⁅A,Z⁆ ≤ H) : ⁅E,Z⁆ ≤ H := by
  let δ := centerSection L Z hZL hnZ q ρ hact
  obtain ⟨t,ht,ht1⟩ := ((A.subgroupOf L).map q).bot_or_exists_ne_one.resolve_left hne
  have htS := hAS ht
  obtain ⟨a,ha,rfl⟩ := ht
  have hr := linear_displacement_fixed ρ S hq hg hf (q a) htS ht1
  have himg : fixedSpace ρ S ≤ δ.imageSpace H := by
    rw [←hr]
    exact δ.displacement_range_le_imageSpace_of_commutator_le A H hH a ha
  apply commutator_le.mpr
  intro e he z hz
  let l : L := ⟨e,hEL he⟩
  let v : Additive Z := Additive.ofMul ⟨z,hz⟩
  have hlS : q l ∈ S := hES (mem_map_of_mem q he)
  have hmem : ρ (q l) v - v ∈ δ.imageSpace H := by
    apply himg
    intro s
    exact hq s s.property (q l) hlS v
  obtain ⟨y,hy,hye⟩ := (δ.mem_imageSpace_iff H _).mp hmem
  have hval := congrArg (fun w : Additive Z => (w.toMul : G)) hye
  simp only [δ,centerSection,toMul_sub,div_eq_mul_inv] at hval
  change (y : G) = ((ρ (q l) v).toMul : G) * z⁻¹ at hval
  rw [hact] at hval
  change (y : G) = ⁅e,z⁆ at hval
  exact hval ▸ hy

private theorem local_sylow_image (P₀ L S₀ : Subgroup G) (hLP : L ≤ P₀)
    (T : Sylow 2 P₀) (hTS : (T : Subgroup P₀).map P₀.subtype = S₀)
    (hTL : (T : Subgroup P₀).map P₀.subtype ≤ L)
    {D : Type*} [Group D] (q : L →* D) :
    ((T : Subgroup P₀).subgroupOf (L.subgroupOf P₀)).map
      (q.comp (subgroupOfEquivOfLe hLP).toMonoidHom) = (S₀.subgroupOf L).map q := by
  rw [←map_map]
  congr 1
  ext l
  constructor
  · rintro ⟨x,hx,rfl⟩
    exact hTS ▸ mem_map_of_mem P₀.subtype hx
  · intro hl
    obtain ⟨x,hx,he⟩ := hTS.symm ▸ hl
    exact ⟨⟨x,hTL (mem_map_of_mem P₀.subtype hx)⟩,hx,Subtype.ext he⟩

variable {P : Fin 2 → Subgroup G} {B : Subgroup G}

/-- The linear case of DGS 8.3: the whole edge Sylow has commutator in H.
This needs no reverse containment or natural-module hypothesis. -/
theorem source_moving_linear_full_sylow_commutator_le (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    {a beta a' : Vertex (family P)} (hc : IsCriticalPair (family P) a a')
    (hab : (graph (family P)).Adj a beta)
    (hd : (graph (family P)).dist beta a' + 1 = b (family P))
    (hb : 1 < b (family P)) (hcomm : ⁅Z (family P) a,Z (family P) a'⁆ = ⊥)
    (models : ∀ v : Vertex (family P), IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    (w : (graph (family P)).neighborSet a')
    (hm : ⁅V (family P) beta 1 ⊓ Q (family P) a',Z (family P) w.val⁆ ≠ ⊥)
    {K : Type u} [Field K] [Finite K] [CharP K 2]
    (e : (d.localGroup w.val ⧸ pCore 2 (d.localGroup w.val)) ≃* SL(2,K)) :
    ⁅Z (family P) w.val,(stabilizer (family P) w.val ⊓ stabilizer (family P) a').pCoreIn 2⁆ ≤
      ⁅V (family P) beta 1 ⊓ Q (family P) a',V (family P) a' 1⁆ := by
  let := finite_endpoints h
  let := CommutingOneProfile.source_center_elementary h w.val
  let F := family P
  let L := d.localGroup w.val
  let Z₀ := Z F w.val
  let E := (stabilizer F w.val ⊓ stabilizer F a').pCoreIn 2
  let A := V F beta 1 ⊓ Q F a'
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))
  let : Finite L := Finite.of_injective (inclusion (d.local_le w.val)) (inclusion_injective _)
  let : Finite Z₀ := Finite.of_injective (inclusion (Z_le_stabilizer F w.val)) (inclusion_injective _)
  obtain ⟨hz,hAL,_,hAQ,T,R,hTR,_⟩ := source_moving_actor h d hc hab hd hb hcomm w hm
  have hTE : (T : Subgroup (stabilizer F w.val)).map (stabilizer F w.val).subtype = E :=
    sylow_image_eq_edge_core _ _ inf_le_left
      (source_edge_core_sylow h hB w.property.symm) T
      (le_inf (map_subtype_le _) (hTR ▸ map_subtype_le _))
  have hEL : E ≤ L := by rw [←hTE]; exact d.sylow_le w.val T
  obtain ⟨ρ,hact⟩ := source_exists_center_quotient_action h d w.val e
  obtain ⟨S,hS,hgen,hres⟩ := source_center_module_prepared_of_center_eq_bot h d w.val hz T e ρ hact
  have hSE : (E.subgroupOf L).map q = (S : Subgroup SL(2,K)) := by
    rw [hS]
    exact (local_sylow_image _ L E (d.local_le w.val) T hTE (d.sylow_le w.val T) q).symm
  have hZL : Z₀ ≤ L := pGroup_le_localGroup F d w.val _
    (IsElementaryAbelian.isPGroup 2 _) (Z_le_stabilizer F w.val)
  let δ := centerSection L Z₀ hZL ((d.local_le w.val).trans (stabilizer_normalizes_Z F w.val)) q ρ hact
  have hquad : IsQuadratic ρ S := by
    rw [←hSE]
    apply BinaryConjugationSection.isQuadratic_of_triple_commutator_le L Z₀ ⊥ E ρ q δ
    have he := source_moving_linear_full_sylow_quadratic h hB d hc hab hd hb hcomm models w hm e
    rw [commutator_comm E,commutator_comm E]
    exact he.le
  have hAE : A ≤ E := inf_le_right.trans (by
    simpa only [E,F,inf_comm] using Noncommuting.graph_Q_le_edgeCore h w.property)
  have hAS : (A.subgroupOf L).map q ≤ S := hSE ▸ map_mono (subgroupOf_mono L hAE)
  have hne : (A.subgroupOf L).map q ≠ ⊥ := by
    intro he
    have hk := (Subgroup.map_eq_bot_iff _).mp he
    rw [local_quotient_kernel F d w.val e] at hk
    exact hAQ (fun a ha => hk (show (⟨a,hAL ha⟩ : L) ∈ A.subgroupOf L from ha))
  rw [commutator_comm]
  exact linear_center_commutator_control L Z₀ A E _ hZL δ.normalized hEL q ρ hact S hAS hSE.le
    hne hquad hgen (bot_unique ((fixedSpace_antitone ρ le_top).trans hres.le))
    (commutator_mono le_rfl (Z_neighbor_le_V F w.property))

/-- The exact quotient-omega-center action of 8.3 in the linear row,
with the chosen original Sylow and full-edge placement retained. -/
theorem source_moving_linear_quotient_omega_commutator_le (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    {a beta a' : Vertex (family P)} (hc : IsCriticalPair (family P) a a')
    (hab : (graph (family P)).Adj a beta)
    (hd : (graph (family P)).dist beta a' + 1 = b (family P))
    (hb : 1 < b (family P)) (hcomm : ⁅Z (family P) a,Z (family P) a'⁆ = ⊥)
    (models : ∀ v : Vertex (family P), IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    (w : (graph (family P)).neighborSet a')
    (hm : ⁅V (family P) beta 1 ⊓ Q (family P) a',Z (family P) w.val⁆ ≠ ⊥)
    {K : Type u} [Field K] [Finite K] [CharP K 2]
    (e : (d.localGroup w.val ⧸ pCore 2 (d.localGroup w.val)) ≃* SL(2,K))
    (R : Sylow 2 (d.localGroup w.val))
    (hR : (R : Subgroup (d.localGroup w.val)).map (d.localGroup w.val).subtype =
      (stabilizer (family P) w.val ⊓ stabilizer (family P) a').pCoreIn 2) :
    ⁅quotientSylowOmegaPreimage (d.localGroup w.val) R,Z (family P) w.val⁆ ≤
      ⁅V (family P) beta 1 ⊓ Q (family P) a',V (family P) a' 1⁆ := by
  have hle : quotientSylowOmegaPreimage (d.localGroup w.val) R ≤
      (stabilizer (family P) w.val ⊓ stabilizer (family P) a').pCoreIn 2 := by
    rw [←hR]
    unfold quotientSylowOmegaPreimage
    apply map_mono
    apply (comap_mono (map_subtype_le _)).trans
    apply le_of_eq
    apply comap_map_eq_self
    rw [QuotientGroup.ker_mk']
    exact pCore_isPGroup.le_sylow_of_normal R
  have hr := source_moving_linear_full_sylow_commutator_le h hB d hc hab hd hb hcomm models w hm e
  rw [commutator_comm] at hr
  exact (commutator_mono hle le_rfl).trans hr

/-- Literal reduced-F1.11 application of the linear 8.3 conclusion.
The original moving vertex is chosen from the nonzero Chapter 8 H. -/
theorem reduced_moving_linear_quotient_omega_commutator_le
    {J : Fin 2 → Subgroup G} {S : Subgroup G} (h : HypothesisF11 J S)
    (hob : ∀ v w : Vertex (Reduction.reducedFamily J S),
      (graph (Reduction.reducedFamily J S)).Adj v w →
      ¬ stabilizer (Reduction.reducedFamily J S) v ≤ normalizer
        ((Q (Reduction.reducedFamily J S) w ⊓ Q (Reduction.reducedFamily J S) v :
          Subgroup (Reduction.G₀ J S)) : Set (Reduction.G₀ J S)))
    (models : ∀ v : Vertex (Reduction.reducedFamily J S),
      IsRankOneModel (graphLocalGroup (Reduction.reducedFamily J S) v ⧸
        pCore 2 (graphLocalGroup (Reduction.reducedFamily J S) v)))
    {a beta a' : Vertex (Reduction.reducedFamily J S)}
    (hc : IsCriticalPair (Reduction.reducedFamily J S) a a')
    (hab : (graph (Reduction.reducedFamily J S)).Adj a beta)
    (hd : (graph (Reduction.reducedFamily J S)).dist beta a' + 1 = b (Reduction.reducedFamily J S))
    (hb : 1 < b (Reduction.reducedFamily J S))
    (hcomm : ⁅Z (Reduction.reducedFamily J S) a,Z (Reduction.reducedFamily J S) a'⁆ = ⊥)
    (hne : ⁅V (Reduction.reducedFamily J S) beta 1 ⊓ Q (Reduction.reducedFamily J S) a',
      V (Reduction.reducedFamily J S) a' 1⁆ ≠ ⊥)
    {K : Type u} [Field K] [Finite K] [CharP K 2] :
    let F := Reduction.reducedFamily J S
    ∃ w : (graph F).neighborSet a',
      ⁅V F beta 1 ⊓ Q F a',Z F w.val⁆ ≠ ⊥ ∧
      ∀ _e : (graphLocalGroup F w.val ⧸ pCore 2 (graphLocalGroup F w.val)) ≃* SL(2,K),
        ∀ R : Sylow 2 (graphLocalGroup F w.val),
          (R : Subgroup (graphLocalGroup F w.val)).map (graphLocalGroup F w.val).subtype =
            (stabilizer F w.val ⊓ stabilizer F a').pCoreIn 2 →
          ⁅quotientSylowOmegaPreimage (graphLocalGroup F w.val) R,Z F w.val⁆ ≤
            ⁅V F beta 1 ⊓ Q F a',V F a' 1⁆ := by
  dsimp only
  let h' := Reduction.reduced_triple h
  let d := Reduction.reducedEarlierLocalTheorems h hob
  obtain ⟨w,hm,_⟩ := exists_moving_neighbor (Reduction.reducedFamily J S)
    (fun v => (source_Z_Q_U h' v).1) beta a' hne
  exact ⟨w,hm,fun e R hR => source_moving_linear_quotient_omega_commutator_le h'
    (Reduction.reduced_borel_core_sylow h) d hc hab hd hb hcomm models w hm e R hR⟩

