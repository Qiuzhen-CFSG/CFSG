/-!
# The residual quotient and its linear recognition in DGS85 (8.3)

The normal subgroup generated by the local two-residual and the moving core
has an intrinsic core quotient embedded in the original local core quotient.
The embedding contains the original residual, and is an isomorphism when that
quotient is perfect. Local transitivity puts the entire opposite neighborhood
in this subgroup.

For a large-field linear ending quotient, transport the already constructed
residual section through this same isomorphism. Corrected (5.12), including
Sylow-fixed generation, then gives the actor bound and natural coordinates
under the strict square inequality. The natural alternative is not excluded
here. All reduced-source applications retain the original quotient maps.

Source: Delgado--Goldschmidt--Stellmacher, *Groups and Graphs* (1985),
proof of (8.3), pp. 135--136; corrected fixed-space hypothesis in (5.12).
-/

@[expose] public noncomputable section
open Subgroup Representation Representation.BinaryOffender
open Representation.RankOne.QuadraticRecognition
open scoped MatrixGroups
namespace CFSG.Quasithin.ChapterF.Source.DGS85.CommutingNontrivial
universe u
variable {G : Type u} [Group G]
local instance {K : Type*} [Field K] [CharP K 2] : Algebra (ZMod 2) K := ZMod.algebra K 2

private theorem normal_local_core_kernel (L D : Subgroup G) (hDL : D ≤ L)
    (hn : L ≤ normalizer (D : Set G)) :
    ((QuotientGroup.mk' (pCore 2 L)).comp (inclusion hDL)).ker = pCore 2 D := by
  let X := D.subgroupOf L
  let : X.Normal := (normal_subgroupOf_iff_le_normalizer hDL).mpr hn
  let e : X ≃* D := subgroupOfEquivOfLe hDL
  let f := (QuotientGroup.mk' (pCore 2 L)).comp (inclusion hDL)
  have he : f.comp e.toMonoidHom = (QuotientGroup.mk' (pCore 2 L)).comp X.subtype := rfl
  have hk : f.ker.comap e.toMonoidHom = pCore 2 X := by
    rw [MonoidHom.comap_ker,he,ker_coreQuotient_restrict]
  have hh := congrArg (map e.toMonoidHom) hk
  rw [map_comap_eq_self_of_surjective e.surjective,pCore_map_iso] at hh
  exact hh

private theorem residual_quotient_embedding (L D : Subgroup G) [Finite L] (hDL : D ≤ L)
    (hn : L ≤ normalizer (D : Set G))
    (hED : (pResidual 2 L).map L.subtype ≤ D) :
    ∃ i : (D ⧸ pCore 2 D) →* (L ⧸ pCore 2 L),
      Function.Injective i ∧
      (∀ g : D, i (QuotientGroup.mk' (pCore 2 D) g) =
        QuotientGroup.mk' (pCore 2 L) (inclusion hDL g)) ∧
      pResidual 2 (L ⧸ pCore 2 L) ≤ i.range := by
  let q := QuotientGroup.mk' (pCore 2 L)
  let f := q.comp (inclusion hDL)
  have hk : f.ker = pCore 2 D := normal_local_core_kernel L D hDL hn
  let i := QuotientGroup.lift (pCore 2 D) f hk.ge
  refine ⟨i,(QuotientGroup.injective_lift_iff _ _ _).mpr hk.symm,fun _ => rfl,?_⟩
  rw [←map_pResidual_of_surjective 2 q (QuotientGroup.mk'_surjective _)]
  rintro _ ⟨r,hr,rfl⟩
  let rD : D := ⟨(r : G),hED (mem_map_of_mem L.subtype hr)⟩
  exact ⟨QuotientGroup.mk' (pCore 2 D) rD,rfl⟩

open Subgroup.CosetGeometry.RankTwo Theory.GroupTheory.AmalgamGraph
variable {P : Fin 2 → Subgroup G} {B : Subgroup G}

/-- The core quotient of the residual join embeds in the original local
core quotient by the literal inclusion. Its image contains the original
two-residual; the intrinsic two-core is exactly the restricted local core. -/
theorem source_residual_join_quotient_embedding (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    {v w : Vertex (family P)} (hvw : (graph (family P)).Adj v w)
    (R : Sylow 2 (d.localGroup w))
    (hR : (R : Subgroup (d.localGroup w)).map (d.localGroup w).subtype =
      (stabilizer (family P) w ⊓ stabilizer (family P) v).pCoreIn 2) :
    let L := d.localGroup v
    let E := (pResidual 2 L).map L.subtype
    let D := E ⊔ Q (family P) w
    ∃ (hDL : D ≤ L) (i : (D ⧸ pCore 2 D) →* (L ⧸ pCore 2 L)),
      Function.Injective i ∧
      (∀ g : D, i (QuotientGroup.mk' (pCore 2 D) g) =
        QuotientGroup.mk' (pCore 2 L) (inclusion hDL g)) ∧
      pResidual 2 (L ⧸ pCore 2 L) ≤ i.range := by
  let := finite_endpoints h
  let : Finite (d.localGroup v) :=
    Finite.of_injective (inclusion (d.local_le v)) (inclusion_injective _)
  obtain ⟨hDL,hn,_,_⟩ := source_residual_join_sylow h hB d hvw R hR
  obtain ⟨i,hi,he,hr⟩ := residual_quotient_embedding _ _ hDL hn le_sup_left
  exact ⟨hDL,i,hi,he,hr⟩

/-- The entire opposite neighborhood lies in the residual join. The
preceding core contains it, and local transitivity conjugates that core
from the moving core inside the normal residual join. -/
theorem source_critical_actor_le_residual_join (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    {a beta a' : Vertex (family P)} (hc : IsCriticalPair (family P) a a')
    (hab : (graph (family P)).Adj a beta)
    (hd : (graph (family P)).dist beta a' + 1 = b (family P))
    (hb : 1 < b (family P)) (hcomm : ⁅Z (family P) a,Z (family P) a'⁆ = ⊥)
    (w : (graph (family P)).neighborSet a')
    (R : Sylow 2 (d.localGroup w.val))
    (hR : (R : Subgroup (d.localGroup w.val)).map (d.localGroup w.val).subtype =
      (stabilizer (family P) w.val ⊓ stabilizer (family P) a').pCoreIn 2) :
    V (family P) beta 1 ≤
      (pResidual 2 (d.localGroup a')).map (d.localGroup a').subtype ⊔ Q (family P) w.val := by
  let F := family P
  let D := (pResidual 2 (d.localGroup a')).map (d.localGroup a').subtype ⊔ Q F w.val
  obtain ⟨_,hnD,_,_⟩ := source_residual_join_sylow h hB d w.property R hR
  obtain ⟨_,_,_,_,prev,hprev,_,hV,_⟩ := source_critical_geometry h d hc hab hd hb hcomm
  obtain ⟨g,hg,hgp⟩ := d.transitive a' w ⟨prev,hprev⟩
  change g • w.val = prev at hgp
  apply hV.trans
  rw [←hgp,Q_translate]
  rintro _ ⟨x,hx,rfl⟩
  exact (mem_normalizer_iff.mp (hnD hg) x).mp ((show Q F w.val ≤ D from le_sup_right) hx)

/-- For a perfect original local quotient, this same embedding is an
isomorphism. It preserves the original quotient map on each representative. -/
theorem source_residual_join_perfect_quotient (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    {v w : Vertex (family P)} (hvw : (graph (family P)).Adj v w)
    (R : Sylow 2 (d.localGroup w))
    (hR : (R : Subgroup (d.localGroup w)).map (d.localGroup w).subtype =
      (stabilizer (family P) w ⊓ stabilizer (family P) v).pCoreIn 2)
    [Group.IsPerfect (d.localGroup v ⧸ pCore 2 (d.localGroup v))] :
    let L := d.localGroup v
    let E := (pResidual 2 L).map L.subtype
    let D := E ⊔ Q (family P) w
    ∃ (hDL : D ≤ L) (e : (D ⧸ pCore 2 D) ≃* (L ⧸ pCore 2 L)),
      ∀ g : D, e (QuotientGroup.mk' (pCore 2 D) g) =
        QuotientGroup.mk' (pCore 2 L) (inclusion hDL g) := by
  let := finite_endpoints h
  let L := d.localGroup v
  let : Finite L := Finite.of_injective (inclusion (d.local_le v)) (inclusion_injective _)
  obtain ⟨hDL,i,hi,he,hr⟩ := source_residual_join_quotient_embedding h hB d hvw R hR
  have hs : Function.Surjective i := by
    apply MonoidHom.range_eq_top.mp
    apply top_unique
    rwa [pResidual_eq_top_of_isPerfect] at hr
  exact ⟨hDL,MulEquiv.ofBijective i ⟨hi,hs⟩,he⟩

/-- The source linear alternative of field order at least four identifies
the residual-join quotient with the same matrix group, by its original map. -/
theorem source_residual_join_linear_quotient (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    {v w : Vertex (family P)} (hvw : (graph (family P)).Adj v w)
    (R : Sylow 2 (d.localGroup w))
    (hR : (R : Subgroup (d.localGroup w)).map (d.localGroup w).subtype =
      (stabilizer (family P) w ⊓ stabilizer (family P) v).pCoreIn 2)
    {K : Type*} [Field K] [Finite K] [CharP K 2] (hK : 4 ≤ Nat.card K)
    (e : (d.localGroup v ⧸ pCore 2 (d.localGroup v)) ≃* SL(2,K)) :
    let L := d.localGroup v
    let E := (pResidual 2 L).map L.subtype
    let D := E ⊔ Q (family P) w
    ∃ (hDL : D ≤ L) (eD : (D ⧸ pCore 2 D) ≃* SL(2,K)),
      ∀ g : D, eD (QuotientGroup.mk' (pCore 2 D) g) =
        e (QuotientGroup.mk' (pCore 2 L) (inclusion hDL g)) := by
  let : Group.IsPerfect SL(2,K) := SL2SylowFixedRecognition.perfect hK
  let : Group.IsPerfect (d.localGroup v ⧸ pCore 2 (d.localGroup v)) :=
    Group.IsPerfect.ofSurjective (f := e.symm.toMonoidHom) e.symm.surjective
  obtain ⟨hDL,e',he⟩ := source_residual_join_perfect_quotient h hB d hvw R hR
  exact ⟨hDL,e'.trans e,fun g => congrArg e (he g)⟩

open Representation.NormalElementaryQuotient CommutingTrivial
variable {J : Fin 2 → Subgroup G} {S₀ : Subgroup G}
/-- The actual reduced residual action and its quotient inclusion are
constructed together, retaining the full edge and original core quotient. -/
theorem reduced_counterexample_residual_embedded
    (h : HypothesisF11 J S₀)
    (hob : ∀ v w : Vertex (Reduction.reducedFamily J S₀),
      (graph (Reduction.reducedFamily J S₀)).Adj v w →
      ¬ stabilizer (Reduction.reducedFamily J S₀) v ≤ normalizer
        ((Q (Reduction.reducedFamily J S₀) w ⊓ Q (Reduction.reducedFamily J S₀) v :
          Subgroup (Reduction.G₀ J S₀)) : Set (Reduction.G₀ J S₀)))
    (models : ∀ v : Vertex (Reduction.reducedFamily J S₀),
      IsRankOneModel (graphLocalGroup (Reduction.reducedFamily J S₀) v ⧸
        pCore 2 (graphLocalGroup (Reduction.reducedFamily J S₀) v)))
    {a beta a' : Vertex (Reduction.reducedFamily J S₀)}
    (hc : IsCriticalPair (Reduction.reducedFamily J S₀) a a')
    (hab : (graph (Reduction.reducedFamily J S₀)).Adj a beta)
    (hd : (graph (Reduction.reducedFamily J S₀)).dist beta a' + 1 = b (Reduction.reducedFamily J S₀))
    (hb : 1 < b (Reduction.reducedFamily J S₀))
    (hcomm : ⁅Z (Reduction.reducedFamily J S₀) a,Z (Reduction.reducedFamily J S₀) a'⁆ = ⊥)
    (w : (graph (Reduction.reducedFamily J S₀)).neighborSet a')
    (hm : ⁅V (Reduction.reducedFamily J S₀) beta 1 ⊓ Q (Reduction.reducedFamily J S₀) a',
      Z (Reduction.reducedFamily J S₀) w.val⁆ ≠ ⊥)
    (R : Sylow 2 (graphLocalGroup (Reduction.reducedFamily J S₀) w.val))
    (hR : (R : Subgroup (graphLocalGroup (Reduction.reducedFamily J S₀) w.val)).map
      (graphLocalGroup (Reduction.reducedFamily J S₀) w.val).subtype =
        (stabilizer (Reduction.reducedFamily J S₀) w.val ⊓ stabilizer (Reduction.reducedFamily J S₀) a').pCoreIn 2)
    (hbad : ¬ ⁅quotientSylowOmegaPreimage (graphLocalGroup (Reduction.reducedFamily J S₀) w.val) R,
      Z (Reduction.reducedFamily J S₀) w.val⁆ ≤
        ⁅V (Reduction.reducedFamily J S₀) beta 1 ⊓ Q (Reduction.reducedFamily J S₀) a',
          V (Reduction.reducedFamily J S₀) a' 1⁆) :
    let F := Reduction.reducedFamily J S₀
    let L := graphLocalGroup F a'
    let U := (V F a' 1).subgroupOf L
    let E := (pResidual 2 L).map L.subtype
    let D := E ⊔ Q F w.val
    letI : ∀ i, Finite (F i) := finite_endpoints (Reduction.reduced_triple h)
    letI := neighborhoodIn_normal F a' L (sylowGenerated_le _)
    ∃ hb2 : 2 < b F,
      letI := neighborhoodIn_elementary F (Reduction.reduced_triple h).generate
        (fun v => (source_Z_Q_U (Reduction.reduced_triple h) v).1)
        (Reduction.reduced_kernel_sylow h) a' hb2 L
      Nontrivial (FixedQuotient U (pResidual 2 L)) ∧
      ∃ (hDL : D ≤ L)
        (i : (D ⧸ pCore 2 D) →* (L ⧸ pCore 2 L))
        (σ : Representation (ZMod 2) (D ⧸ pCore 2 D) (FixedQuotient U (pResidual 2 L)))
        (S : Sylow 2 D),
        Function.Injective i ∧
        (∀ g : D, i (QuotientGroup.mk' (pCore 2 D) g) =
          QuotientGroup.mk' (pCore 2 L) (inclusion hDL g)) ∧
        pResidual 2 (L ⧸ pCore 2 L) ≤ i.range ∧
        (∀ g : D, σ (QuotientGroup.mk' (pCore 2 D) g) =
          fixedQuotientAction U (pResidual 2 L) (inclusion hDL g)) ∧
        (S : Subgroup D).map D.subtype = quotientSylowOmegaPreimage (graphLocalGroup F w.val) R ∧
        GeneratedByFixedSpace σ ((S : Subgroup D).map (QuotientGroup.mk' (pCore 2 D))) ∧
        fixedSpace σ (pResidual 2 (D ⧸ pCore 2 D)) = ⊥ ∧
        Nonempty (BinaryConjugationSection D (V F a' 1)
          (V F a' 1 ⊓ centralizer (E : Set (Reduction.G₀ J S₀)))
          (σ.comp (QuotientGroup.mk' (pCore 2 D)))) := by
  obtain ⟨hb2,hn,hDL,σ,S,hσ,hS,hgen,hres,cD⟩ :=
    reduced_counterexample_residual_prepared h hob models hc hab hd hb hcomm w hm R hR hbad
  obtain ⟨hDL',i,hi,he,hr⟩ := source_residual_join_quotient_embedding (Reduction.reduced_triple h)
    (Reduction.reduced_borel_core_sylow h) (Reduction.reducedEarlierLocalTheorems h hob)
    w.property R hR
  exact ⟨hb2,hn,hDL,i,σ,S,hi,he,hr,hσ,hS,hgen,hres,cD⟩

/-- On the source large-field linear alternative, the constructed action
on the whole residual section is faithful and generated by Sylow fixed
vectors. The isomorphism and action agree with the original local quotient
on every element of the residual join; naturality is not assumed. -/
theorem reduced_counterexample_linear_residual_prepared
    (h : HypothesisF11 J S₀)
    (hob : ∀ v w : Vertex (Reduction.reducedFamily J S₀),
      (graph (Reduction.reducedFamily J S₀)).Adj v w →
      ¬ stabilizer (Reduction.reducedFamily J S₀) v ≤ normalizer
        ((Q (Reduction.reducedFamily J S₀) w ⊓ Q (Reduction.reducedFamily J S₀) v :
          Subgroup (Reduction.G₀ J S₀)) : Set (Reduction.G₀ J S₀)))
    (models : ∀ v : Vertex (Reduction.reducedFamily J S₀),
      IsRankOneModel (graphLocalGroup (Reduction.reducedFamily J S₀) v ⧸
        pCore 2 (graphLocalGroup (Reduction.reducedFamily J S₀) v)))
    {a beta a' : Vertex (Reduction.reducedFamily J S₀)}
    (hc : IsCriticalPair (Reduction.reducedFamily J S₀) a a')
    (hab : (graph (Reduction.reducedFamily J S₀)).Adj a beta)
    (hd : (graph (Reduction.reducedFamily J S₀)).dist beta a' + 1 = b (Reduction.reducedFamily J S₀))
    (hb : 1 < b (Reduction.reducedFamily J S₀))
    (hcomm : ⁅Z (Reduction.reducedFamily J S₀) a,Z (Reduction.reducedFamily J S₀) a'⁆ = ⊥)
    (w : (graph (Reduction.reducedFamily J S₀)).neighborSet a')
    (hm : ⁅V (Reduction.reducedFamily J S₀) beta 1 ⊓ Q (Reduction.reducedFamily J S₀) a',
      Z (Reduction.reducedFamily J S₀) w.val⁆ ≠ ⊥)
    (R : Sylow 2 (graphLocalGroup (Reduction.reducedFamily J S₀) w.val))
    (hR : (R : Subgroup (graphLocalGroup (Reduction.reducedFamily J S₀) w.val)).map
      (graphLocalGroup (Reduction.reducedFamily J S₀) w.val).subtype =
        (stabilizer (Reduction.reducedFamily J S₀) w.val ⊓ stabilizer (Reduction.reducedFamily J S₀) a').pCoreIn 2)
    (hbad : ¬ ⁅quotientSylowOmegaPreimage (graphLocalGroup (Reduction.reducedFamily J S₀) w.val) R,
      Z (Reduction.reducedFamily J S₀) w.val⁆ ≤
        ⁅V (Reduction.reducedFamily J S₀) beta 1 ⊓ Q (Reduction.reducedFamily J S₀) a',
          V (Reduction.reducedFamily J S₀) a' 1⁆)
    {K : Type*} [Field K] [Finite K] [CharP K 2]
    {n : ℕ} (hn : 2 ≤ n) (hK : Nat.card K = 2^n)
    (e : (graphLocalGroup (Reduction.reducedFamily J S₀) a' ⧸
      pCore 2 (graphLocalGroup (Reduction.reducedFamily J S₀) a')) ≃* SL(2,K)) :
    let F := Reduction.reducedFamily J S₀
    let L := graphLocalGroup F a'
    let U := (V F a' 1).subgroupOf L
    let E := (pResidual 2 L).map L.subtype
    let D := E ⊔ Q F w.val
    letI : ∀ i, Finite (F i) := finite_endpoints (Reduction.reduced_triple h)
    letI := neighborhoodIn_normal F a' L (sylowGenerated_le _)
    ∃ hb2 : 2 < b F,
      letI := neighborhoodIn_elementary F (Reduction.reduced_triple h).generate
        (fun v => (source_Z_Q_U (Reduction.reduced_triple h) v).1)
        (Reduction.reduced_kernel_sylow h) a' hb2 L
      Nontrivial (FixedQuotient U (pResidual 2 L)) ∧
      ∃ (hDL : D ≤ L) (eD : (D ⧸ pCore 2 D) ≃* SL(2,K))
        (σ : Representation (ZMod 2) SL(2,K) (FixedQuotient U (pResidual 2 L)))
        (S : Sylow 2 D) (T : Sylow 2 SL(2,K)),
        (∀ g : D, eD (QuotientGroup.mk' (pCore 2 D) g) =
          e (QuotientGroup.mk' (pCore 2 L) (inclusion hDL g))) ∧
        (∀ g : D, σ (eD (QuotientGroup.mk' (pCore 2 D) g)) =
          fixedQuotientAction U (pResidual 2 L) (inclusion hDL g)) ∧
        (S : Subgroup D).map D.subtype = quotientSylowOmegaPreimage (graphLocalGroup F w.val) R ∧
        (S : Subgroup D).map (eD.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 D))) = T ∧
        GeneratedByFixedSpace σ T ∧ fixedSpace σ (pResidual 2 SL(2,K)) = ⊥ ∧
        Function.Injective σ ∧
        Nonempty (BinaryConjugationSection D (V F a' 1)
          (V F a' 1 ⊓ centralizer (E : Set (Reduction.G₀ J S₀)))
          (σ.comp (eD.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 D))))) := by
  let ht := Reduction.reduced_triple h
  let F := Reduction.reducedFamily J S₀
  let L := graphLocalGroup F a'
  let U := (V F a' 1).subgroupOf L
  let E := (pResidual 2 L).map L.subtype
  let D := E ⊔ Q F w.val
  let d := Reduction.reducedEarlierLocalTheorems h hob
  let : ∀ i, Finite (F i) := finite_endpoints ht
  let : U.Normal := neighborhoodIn_normal F a' L (sylowGenerated_le _)
  obtain ⟨hb2,hnz,hDL,σ,S,hσ,hS,hgen,hres,⟨cD⟩⟩ :=
    reduced_counterexample_residual_prepared h hob models hc hab hd hb hcomm w hm R hR hbad
  refine ⟨hb2,hnz,?_⟩
  let : IsElementaryAbelian 2 U := neighborhoodIn_elementary F ht.generate
    (fun v => (source_Z_Q_U ht v).1) (Reduction.reduced_kernel_sylow h) a' hb2 L
  let : Nontrivial (FixedQuotient U (pResidual 2 L)) := hnz
  let : Finite L := Finite.of_injective (inclusion (sylowGenerated_le _)) (inclusion_injective _)
  let : Finite D := Finite.of_injective (inclusion hDL) (inclusion_injective _)
  have hK4 : 4 ≤ Nat.card K := by
    rw [hK]
    exact Nat.pow_le_pow_right (by decide : 1 ≤ (2 : ℕ)) hn
  obtain ⟨_,eD,heD⟩ := source_residual_join_linear_quotient ht
    (Reduction.reduced_borel_core_sylow h) d w.property R hR hK4 e
  change (D ⧸ pCore 2 D) ≃* SL(2,K) at eD
  change ∀ g : D, eD (QuotientGroup.mk' (pCore 2 D) g) =
    e (QuotientGroup.mk' (pCore 2 L) (inclusion hDL g)) at heD
  let τ : Representation (ZMod 2) SL(2,K) (FixedQuotient U (pResidual 2 L)) :=
    σ.comp eD.symm.toMonoidHom
  let S' := S.mapSurjective (f := QuotientGroup.mk' (pCore 2 D)) (QuotientGroup.mk'_surjective _)
  let T := S'.mapSurjective (f := eD.toMonoidHom) eD.surjective
  have hact (g : D) : τ (eD (QuotientGroup.mk' (pCore 2 D) g)) =
      fixedQuotientAction U (pResidual 2 L) (inclusion hDL g) := by
    change σ (eD.symm (eD (QuotientGroup.mk' (pCore 2 D) g))) = _
    rw [eD.symm_apply_apply]
    exact hσ g
  have hT : (S : Subgroup D).map (eD.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 D))) = T := by
    change _ = ((S : Subgroup D).map (QuotientGroup.mk' (pCore 2 D))).map eD.toMonoidHom
    rw [map_map]
  have hg : GeneratedByFixedSpace τ T :=
    generatedByFixedSpace_of_equivariant_surjection σ τ eD.toMonoidHom LinearMap.id
      Function.surjective_id (by intro g z; simp [τ]) S' hgen
  have hr : fixedSpace τ (pResidual 2 SL(2,K)) = ⊥ := by
    change fixedSpace (σ.comp eD.symm.toMonoidHom) _ = _
    rw [fixedSpace_comp_map,map_pResidual]
    exact hres
  have hf := linear_quotient_action_faithful (by omega : 0 < n) hK eD τ hr
  have hcomp : τ.comp (eD.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 D))) =
      σ.comp (QuotientGroup.mk' (pCore 2 D)) := by
    ext g z
    change σ (eD.symm (eD (QuotientGroup.mk' (pCore 2 D) g))) z = _
    rw [eD.symm_apply_apply]
    rfl
  exact ⟨hDL,eD,τ,S,T,heD,hact,hS,hT,hg,hr,hf,⟨hcomp.symm ▸ cD⟩⟩

/-- Corrected 5.12 for the whole original opposite-span actor in the
large-field linear ending case of 8.3. Its order is the literal a₁, and a
strict square comparison yields natural coordinates on the unchanged full
residual quotient. Excluding this natural alternative remains a later step. -/
theorem reduced_counterexample_linear_residual_recognition
    (h : HypothesisF11 J S₀)
    (hob : ∀ v w : Vertex (Reduction.reducedFamily J S₀),
      (graph (Reduction.reducedFamily J S₀)).Adj v w →
      ¬ stabilizer (Reduction.reducedFamily J S₀) v ≤ normalizer
        ((Q (Reduction.reducedFamily J S₀) w ⊓ Q (Reduction.reducedFamily J S₀) v :
