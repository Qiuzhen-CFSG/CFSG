private theorem prepared_sylow_image (P₀ L S₀ : Subgroup G) (hLP : L ≤ P₀)
    (T : Sylow 2 P₀) (hTS : (T : Subgroup P₀).map P₀.subtype = S₀)
    (hTL : (T : Subgroup P₀).map P₀.subtype ≤ L)
    {D : Type*} [Group D] (q : L →* D) :
    ((T : Subgroup P₀).subgroupOf (L.subgroupOf P₀)).map
      (q.comp (subgroupOfEquivOfLe hLP).toMonoidHom) = (S₀.subgroupOf L).map q := by
  rw [←map_map]
  congr 1
  ext l
  constructor
  · rintro ⟨x,hx,rfl⟩
    exact hTS ▸ mem_map_of_mem P₀.subtype hx
  · intro hl
    obtain ⟨x,hx,he⟩ := hTS.symm ▸ hl
    refine ⟨⟨x,hTL (mem_map_of_mem P₀.subtype hx)⟩,hx,?_⟩
    exact Subtype.ext he

/-- All nonzero subgroups of a quadratic Sylow have the same fixed space
on a module generated by its Sylow fixed space with zero global fixed space. -/
private theorem linear_uniform_fixed {K W : Type*} [Field K] [Finite K] [CharP K 2]
    [AddCommGroup W] [Module (ZMod 2) W]
    (ρ : Representation (ZMod 2) SL(2,K) W) (S : Sylow 2 SL(2,K))
    (hq : IsQuadratic ρ S) (hgen : GeneratedByFixedSpace ρ S)
    (hfix : fixedSpace ρ ⊤ = ⊥) (A : Subgroup SL(2,K)) (hAS : A ≤ S) (hne : A ≠ ⊥) :
    fixedSpace ρ A = fixedSpace ρ S := by
  obtain ⟨g,hg⟩ := SetLike.exists_not_mem_of_ne_top (normalizer (S : Set SL(2,K)))
    (Matrix.SpecialLinearGroup.sylow_normalizer_ne_top S)
  have hST : S ≠ g • S := fun h => hg (Sylow.smul_eq_iff_mem_normalizer.mp h.symm)
  have hcompl := sl2_sylow_fixed_isCompl ρ S (g • S) hST hq hgen hfix
  have hu := (SL2SylowFixedRecognition.fixedSpaceHypotheses_of_isCompl ρ S (g • S) hcompl).uniform
  obtain ⟨a,ha,ha1⟩ := A.bot_or_exists_ne_one.resolve_left hne
  exact le_antisymm ((fixedSpace_antitone ρ (zpowers_le.mpr ha)).trans
    (hu a (hAS ha) ha1).le) (fixedSpace_antitone ρ hAS)

/-- Quadratic recognition gives the source square bound for every escaping
actor in the full edge Sylow when the moving linear center is not natural. -/
theorem source_moving_linear_nonnatural_field_square_bound (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    {a beta a' : Vertex (family P)} (hc : IsCriticalPair (family P) a a')
    (hab : (graph (family P)).Adj a beta)
    (hd : (graph (family P)).dist beta a' + 1 = b (family P))
    (hb : 1 < b (family P)) (hcomm : ⁅Z (family P) a, Z (family P) a'⁆ = ⊥)
    (models : ∀ v : Vertex (family P), IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    (w : (graph (family P)).neighborSet a')
    (hm : ⁅V (family P) beta 1 ⊓ Q (family P) a', Z (family P) w.val⁆ ≠ ⊥)
    {K : Type u} [Field K] [Finite K] [CharP K 2]
    {n : ℕ} (hn : 0 < n) (hK : Nat.card K = 2^n)
    (e : (d.localGroup w.val ⧸ pCore 2 (d.localGroup w.val)) ≃* SL(2,K))
    (hnonnatural : ¬ Noncommuting.HasNaturalCenter (d.localGroup w.val)
      (Z (family P) w.val) (Q (family P) w.val))
    (A : Subgroup G)
    (hAE : A ≤ (stabilizer (family P) w.val ⊓ stabilizer (family P) a').pCoreIn 2)
    (hAQ : ¬ A ≤ Q (family P) w.val) :
    Nat.card K ^ 2 ≤ (centralizer (A : Set G)).relIndex (Z (family P) w.val) := by
  let := finite_endpoints h
  let := CommutingOneProfile.source_center_elementary h w.val
  let := source_center_nontrivial h w.val
  let F := family P
  let L := d.localGroup w.val
  let Z₀ := Z F w.val
  let E := (stabilizer F w.val ⊓ stabilizer F a').pCoreIn 2
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))
  let : Finite L := Finite.of_injective (inclusion (d.local_le w.val)) (inclusion_injective _)
  let : Finite Z₀ := Finite.of_injective (inclusion (Z_le_stabilizer F w.val)) (inclusion_injective _)
  obtain ⟨hz,_,_,_,T,R,hTR,_⟩ := source_moving_actor h d hc hab hd hb hcomm w hm
  have hTE : (T : Subgroup (stabilizer F w.val)).map (stabilizer F w.val).subtype = E :=
    sylow_image_eq_edge_core _ _ inf_le_left
      (source_edge_core_sylow h hB (show (graph F).Adj a' w.val from w.property).symm) T
      (le_inf (map_subtype_le _) (hTR ▸ map_subtype_le _))
  have hEL : E ≤ L := by rw [←hTE]; exact d.sylow_le w.val T
  have hAL : A ≤ L := hAE.trans hEL
  obtain ⟨ρ,hact⟩ := source_exists_center_quotient_action h d w.val e
  obtain ⟨S,hS,hgen,hres⟩ := source_center_module_prepared_of_center_eq_bot h d w.val hz T e ρ hact
  have hSE : (E.subgroupOf L).map q = (S : Subgroup SL(2,K)) := by
    rw [hS]
    exact (prepared_sylow_image _ L E (d.local_le w.val) T hTE (d.sylow_le w.val T) q).symm
  have hZL : Z₀ ≤ L := pGroup_le_localGroup F d w.val _
    (IsElementaryAbelian.isPGroup 2 _) (Z_le_stabilizer F w.val)
  let δ := centerSection L Z₀ hZL ((d.local_le w.val).trans (stabilizer_normalizes_Z F w.val)) q ρ hact
  have hquad : IsQuadratic ρ S := by
    rw [←hSE]
    apply BinaryConjugationSection.isQuadratic_of_triple_commutator_le L Z₀ ⊥ E ρ q δ
    have he := source_moving_linear_full_sylow_quadratic h hB d hc hab hd hb hcomm models w hm e
    rw [commutator_comm E,commutator_comm E]
    exact he.le
  have hf := linear_quotient_action_faithful hn hK e ρ hres
  have hfix : fixedSpace ρ ⊤ = ⊥ := bot_unique ((fixedSpace_antitone ρ le_top).trans hres.le)
  have hbound : Nat.card (S : Subgroup SL(2,K)) ^ 2 ≤ Nat.card (Additive Z₀ ⧸ fixedSpace ρ S) := by
    by_contra! hs
    have hnat := (binary_rank_one_bound_and_recognition (.sl2 K n hn hK (MulEquiv.refl _))
      ρ hf S S le_rfl hquad hgen hres).2 hs
    have hmark := source_natural_center_of_recognition h d w.val hz e ρ S hact hnat
    exact hnonnatural hmark
  have hAS : (A.subgroupOf L).map q ≤ S := hSE ▸ map_mono (subgroupOf_mono L hAE)
  have hne : (A.subgroupOf L).map q ≠ ⊥ := by
    intro he
    have hk := (Subgroup.map_eq_bot_iff _).mp he
    rw [local_quotient_kernel F d w.val e] at hk
    exact hAQ (fun a ha => hk (show (⟨a,hAL ha⟩ : L) ∈ A.subgroupOf L from ha))
  have hfixed := linear_uniform_fixed ρ S hquad hgen hfix _ hAS hne
  have hi := center_action_fixed_index L Z₀ A hZL δ.normalized hAL q ρ hact
  rw [hfixed] at hi
  rw [←hi]
  have hcS : Nat.card (S : Subgroup SL(2,K)) = Nat.card K :=
    Nat.card_congr (Matrix.SpecialLinearGroup.sylowEquivAdditive K 2 S).symm.toEquiv
  rwa [hcS] at hbound


private theorem small_terminal_two_rank {D : Type*} [Group D] [Finite D]
    (hsmall : ClassicalGroup.IsPSL D 2 2 ∨ Nonempty (D ≃* DihedralGroup 5) ∨ Nonempty (D ≃* SuzukiMatrixGroup 0) ∨
      ClassicalGroup.IsPSU D 3 2 ∨ IsSU D 3 2) : primeRank 2 D ≤ 1 := by
  rcases hsmall with hlin | hsmall
  · obtain ⟨K,_,_,hK,⟨eK⟩⟩ := hlin
    let := Fintype.ofFinite K
    let : CharP K 2 := charP_of_card_eq_prime_pow (p := 2) (f := 1)
      (by simpa only [pow_one,Nat.card_eq_fintype_card] using hK)
    let e : D ≃* SL(2,K) := eK.trans (MulEquiv.ofBijective (BenderSuzuki.Converse.pi K)
      ⟨BenderSuzuki.Converse.pi_injective,BenderSuzuki.Converse.pi_surjective⟩).symm
    rw [primeRank_congr 2 e]
    let S : Sylow 2 SL(2,K) := default
    have hc : Nat.card S = 2 := by
      rw [←Nat.card_congr (Matrix.SpecialLinearGroup.sylowEquivAdditive K 2 S).toEquiv]
      exact hK
    exact S.primeRank_le_one_of_isCyclic (isCyclic_of_prime_card hc)
  ·
    rcases hsmall with hlin | hsuz | hpsu | hsu
    · obtain ⟨e⟩ := hlin
      rw [primeRank_congr 2 e]
      let S : Sylow 2 (DihedralGroup 5) := Sylow.ofCard
        (zpowers (DihedralGroup.sr 0 : DihedralGroup 5)) (by
          rw [Nat.card_zpowers,DihedralGroup.orderOf_sr,DihedralGroup.nat_card]
          rw [Nat.factorization_mul (by decide) (by decide),
            Nat.prime_two.factorization,Nat.prime_five.factorization]
          norm_num)
      exact S.primeRank_le_one_of_isCyclic
        (inferInstanceAs (IsCyclic (zpowers (DihedralGroup.sr 0 : DihedralGroup 5))))
    · obtain ⟨e⟩ := hsuz
      rw [primeRank_congr 2 e]
      let R := zpowers suzukiZeroRootGenerator
      have hc : Nat.card R = 2^2 := by
        rw [Nat.card_zpowers,suzukiZeroRootGenerator_order]
        rfl
      have hp : IsPGroup 2 R := IsPGroup.of_card hc
      have hi : ¬ 2 ∣ R.index := by
        have he := R.card_mul_index
        rw [show Nat.card R = 4 from hc,suzukiZero_card] at he
        have hx : R.index = 5 := by omega
        simp only [hx]
        decide
      apply (hp.toSylow hi).primeRank_le_one_of_isCyclic
      change IsCyclic R
      infer_instance
    · obtain ⟨K,_,_,J,hK,hconj,⟨e⟩⟩ := hpsu
      let : Finite (ProjectiveSpecialUnitaryMatrixGroup J) :=
        Finite.of_surjective J.specialToProjective J.specialToProjective_surjective
      rw [primeRank_congr 2 e]
      exact (HermitianForm.EvenTwoRank.two_rank J (n := 1) (by decide) hK hconj).le
    · obtain ⟨K,_,_,J,hK,hconj,⟨e⟩⟩ := hsu
      let : Finite (ProjectiveSpecialUnitaryMatrixGroup J) :=
        Finite.of_surjective J.specialToProjective J.specialToProjective_surjective
      rw [primeRank_congr 2 e,primeRank_eq_of_surjective_of_coprime 2 J.specialToProjective
        J.specialToProjective_surjective J.odd_card_specialToProjective_ker.coprime_two_left]
      exact (HermitianForm.EvenTwoRank.two_rank J (n := 1) (by decide) hK hconj).le


private theorem omega_card_le_rank {D : Type*} [Group D] [Finite D]
    (T : Sylow 2 D) {n : ℕ} (hr : primeRank 2 D ≤ n) :
    Nat.card (omegaCenterIn (T : Subgroup D)) ≤ 2^n :=
  (primeRank_le_iff_elementary_card_le D).mp hr _ inferInstance

/-- The first lower bound of 8.6: unless the original moving center is
natural, its displacement by V_beta ∩ Q_alpha' has index at least q_lambda².
All source models and their small parameters are included. -/
theorem source_moving_omega_square_or_natural
    (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    (models : ∀ v : Vertex (family P), IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    {a beta a' : Vertex (family P)} (hc : IsCriticalPair (family P) a a')
    (hab : (graph (family P)).Adj a beta)
    (hd : (graph (family P)).dist beta a' + 1 = b (family P))
    (hb : 1 < b (family P)) (hcomm : ⁅Z (family P) a,Z (family P) a'⁆ = ⊥)
    (w : (graph (family P)).neighborSet a')
    (hm : ⁅V (family P) beta 1 ⊓ Q (family P) a',Z (family P) w.val⁆ ≠ ⊥)
    (R : Sylow 2 (d.localGroup w.val)) :
    Noncommuting.HasNaturalCenter (d.localGroup w.val) (Z (family P) w.val) (Q (family P) w.val) ∨
      Nat.card (omegaCenterIn ((R : Subgroup (d.localGroup w.val)).map
        (QuotientGroup.mk' (pCore 2 (d.localGroup w.val))))) ^ 2 ≤
      (centralizer ((V (family P) beta 1 ⊓ Q (family P) a' : Subgroup G) : Set G)).relIndex
        (Z (family P) w.val) := by
  classical
  by_cases hnat : Noncommuting.HasNaturalCenter (d.localGroup w.val) (Z (family P) w.val) (Q (family P) w.val)
  · exact Or.inl hnat
  right
  let := finite_endpoints h
  let F := family P
  let L := d.localGroup w.val
  let D := L ⧸ pCore 2 L
  let : Finite L := Finite.of_injective (inclusion (d.local_le w.val)) (inclusion_injective _)
  let A := V F beta 1 ⊓ Q F a'
  let T := R.mapSurjective (QuotientGroup.mk'_surjective (pCore 2 L))
  have hb3 : 3 ≤ b F := (source_critical_geometry h d hc hab hd hb hcomm).2.1
  let : IsElementaryAbelian 2 (V F beta 1) := CommutingTrivial.V_elementary F h.generate
    (fun v => (source_Z_Q_U h v).1) d.kernel_sylow beta (by omega)
  let : IsElementaryAbelian 2 A := IsElementaryAbelian.of_le inf_le_left
  have hAL : A ≤ L := (source_moving_actor h d hc hab hd hb hcomm w hm).2.1
  have hAQ : ¬ A ≤ Q F w.val := (source_moving_actor h d hc hab hd hb hcomm w hm).2.2.2.1
  have hAE : A ≤ (stabilizer F w.val ⊓ stabilizer F a').pCoreIn 2 :=
    inf_le_right.trans (by simpa only [inf_comm] using Noncommuting.graph_Q_le_edgeCore h w.property)
  change Nat.card (omegaCenterIn (T : Subgroup D)) ^ 2 ≤ _
  cases models w.val with
  | linear n hn hi =>
    obtain ⟨K₀,_,_,hK₀,⟨eK⟩⟩ := hi
    let := Fintype.ofFinite K₀
    let : CharP K₀ 2 := charP_of_card_eq_prime_pow
      (by simpa only [Nat.card_eq_fintype_card] using hK₀)
    let K := ULift.{u} K₀
    let ek : K₀ ≃+* K := ULift.ringEquiv.symm
    have hK : Nat.card K = 2^n := (Nat.card_congr ek.toEquiv).symm.trans hK₀
    let e₀ : D ≃* SL(2,K₀) := eK.trans (MulEquiv.ofBijective (BenderSuzuki.Converse.pi K₀)
      ⟨BenderSuzuki.Converse.pi_injective,BenderSuzuki.Converse.pi_surjective⟩).symm
    let e : D ≃* SL(2,K) := e₀.trans (Atlas.fieldEquivSL 2 ek)
    let S := T.mapSurjective (f := e.toMonoidHom) e.surjective
    have hO : Nat.card (omegaCenterIn (T : Subgroup D)) ≤ Nat.card K := by
      calc
        _ ≤ Nat.card T := card_le_of_le (map_subtype_le _)
        _ = Nat.card S := Nat.card_congr
          ((T : Subgroup D).equivMapOfInjective e.toMonoidHom e.injective).toEquiv
        _ = Nat.card K := Nat.card_congr (Matrix.SpecialLinearGroup.sylowEquivAdditive K 2 S).symm.toEquiv
    exact (Nat.pow_le_pow_left hO 2).trans
      (source_moving_linear_nonnatural_field_square_bound h hB d hc hab hd hb hcomm models
        w hm hn hK e hnat A hAE hAQ)
  | suzuki m hi =>
    let e : D ≃* SuzukiMatrixGroup m := hi.some
    have hr : primeRank 2 D ≤ 2*m+1 := by
      by_cases hm0 : m = 0
      · subst m
        exact small_terminal_two_rank (Or.inr (Or.inr (Or.inl ⟨e⟩)))
      · rw [primeRank_congr 2 e,suzuki_two_rank m (by omega)]
    exact (Nat.pow_le_pow_left (omega_card_le_rank T hr) 2).trans
      (source_moving_suzuki_field_square_bound h d hc hab hd hb hcomm w hm m e A hAL hAQ)
  | dihedral hi =>
    have hO := omega_card_le_rank T (small_terminal_two_rank (Or.inr (Or.inl hi)))
    norm_num only [pow_one] at hO
    exact (Nat.pow_le_pow_left hO 2).trans
      (source_moving_dihedral_field_square_bound h d hc hab hd hb hcomm w hm hi.some A hAL hAQ)
  | projective_unitary n hn hi =>
    obtain ⟨K,_,_,H,hK,hconj,⟨e⟩⟩ := hi
    let : Finite (ProjectiveSpecialUnitaryMatrixGroup H) :=
      Finite.of_surjective H.specialToProjective H.specialToProjective_surjective
    have hr : primeRank 2 D ≤ n := by
      rw [primeRank_congr 2 e]
      exact (HermitianForm.EvenTwoRank.two_rank H hn hK hconj).le
    have hO := omega_card_le_rank T hr
    by_cases hn2 : 2 ≤ n
    · exact (Nat.pow_le_pow_left hO 2).trans
        (source_moving_projective_unitary_involution_field_square_bound h hB d hc hab hd hb hcomm
          models w hm H hn2 hK hconj e A hAE hAQ)
    · have hn1 : n = 1 := by omega
      subst n
      norm_num only [pow_one] at hO
      apply (Nat.pow_le_pow_left hO 2).trans
      apply source_moving_rank_one_square_bound h d hc hab hd hb hcomm w hm e
        (HermitianForm.EvenTwoRank.two_rank H (by decide) hK hconj).le ?_ A hAL hAQ
      intro S
      have hh := HermitianForm.BinarySylowOrder.cube_le_sylow_card H (by decide) hK hconj S
      norm_num at hh
      omega
  | special_unitary n hn hi =>
    obtain ⟨K,_,_,H,hK,hconj,⟨e⟩⟩ := hi
    let : Finite (ProjectiveSpecialUnitaryMatrixGroup H) :=
      Finite.of_surjective H.specialToProjective H.specialToProjective_surjective
    have hrH : primeRank 2 H.specialSubgroup ≤ n := by
      rw [primeRank_eq_of_surjective_of_coprime 2 H.specialToProjective
        H.specialToProjective_surjective H.odd_card_specialToProjective_ker.coprime_two_left]
      exact (HermitianForm.EvenTwoRank.two_rank H hn hK hconj).le
    have hr : primeRank 2 D ≤ n := by rwa [primeRank_congr 2 e]
    have hO := omega_card_le_rank T hr
    by_cases hn2 : 2 ≤ n
    · exact (Nat.pow_le_pow_left hO 2).trans
        (source_moving_special_unitary_involution_field_square_bound h hB d hc hab hd hb hcomm
          models w hm H hn2 hK hconj e A hAE hAQ)
    · have hn1 : n = 1 := by omega
      subst n
      norm_num only [pow_one] at hO
      apply (Nat.pow_le_pow_left hO 2).trans
      apply source_moving_rank_one_square_bound h d hc hab hd hb hcomm w hm e hrH ?_ A hAL hAQ
      intro S
      let T := S.mapSurjective (f := H.specialToProjective) H.specialToProjective_surjective
      have hh := HermitianForm.BinarySylowOrder.cube_le_sylow_card H (by decide) hK hconj T
      have hle : Nat.card T ≤ Nat.card S := Nat.card_le_card_of_surjective
        (fun s : S => (⟨H.specialToProjective s,mem_map_of_mem _ s.property⟩ : T)) (by
          rintro ⟨_,s,hs,rfl⟩
          exact ⟨⟨s,hs⟩,rfl⟩)
      norm_num at hh
      omega


/-- The literal commuting-intersection hypothesis in 8.6(c) bounds each
moving-center displacement by the opposite core index. -/
theorem source_commuting_intersection_fixed_index_le
    (h : LocallyRankOneTriple P B)
    {beta a' : Vertex (family P)} (hb : 1 < b (family P))
    (w : (graph (family P)).neighborSet a')
    (hcomm : ⁅V (family P) beta 1 ⊓ Q (family P) a',
      V (family P) a' 1 ⊓ Q (family P) beta⁆ = ⊥) :
    (centralizer ((V (family P) beta 1 ⊓ Q (family P) a' : Subgroup G) : Set G)).relIndex
      (Z (family P) w.val) ≤ (Q (family P) beta).relIndex (V (family P) a' 1) := by
  let := finite_endpoints h
  let F := family P
  let A := V F beta 1 ⊓ Q F a'
  let : Finite (Z F w.val) := Finite.of_injective (inclusion (Z_le_stabilizer F w.val))
    (inclusion_injective _)
  have hVP : V F a' 1 ≤ stabilizer F a' := V_le_stabilizer_of_dist_add_le_b F h.generate
    a' a' 1 (by simpa only [SimpleGraph.dist_self,zero_add] using hb.le)
  let : Finite (V F a' 1) := Finite.of_injective (inclusion hVP) (inclusion_injective _)
  have hcen : Z F w.val ⊓ Q F beta ≤ centralizer (A : Set G) := by
    apply le_centralizer_iff.mp
    apply commutator_eq_bot_iff_le_centralizer.mp
    exact bot_unique ((commutator_mono le_rfl
      (inf_le_inf (Z_neighbor_le_V F w.property) le_rfl)).trans hcomm.le)
  have hi := relIndex_le_of_le_left hcen
    ((Z F w.val ⊓ Q F beta).subgroupOf (Z F w.val)).index_ne_zero_of_finite
  rw [inf_relIndex_left] at hi
  exact hi.trans (relIndex_le_of_le_right (Z_neighbor_le_V F w.property)
    ((Q F beta).subgroupOf (V F a' 1)).index_ne_zero_of_finite)

private theorem elementary_card_le_omega {D : Type*} [Group D] [Finite D]
    (M : IsRankOneModel D) (A : Subgroup D) [IsElementaryAbelian 2 A]
    (T : Sylow 2 D) : Nat.card A ≤ Nat.card (omegaCenterIn (T : Subgroup D)) := by
  obtain ⟨S,hAS⟩ := (IsElementaryAbelian.isPGroup 2 A).exists_le_sylow
  have hA := source_rank_one_elementary_le_sylow_omega M S A hAS
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq D S T
  have hmap : (omegaCenterIn (S : Subgroup D)).map (MulAut.conj g).toMonoidHom =
      omegaCenterIn (T : Subgroup D) := by
    rw [NilesRankOneKernel.omegaCenterIn_map_injective _ (MulAut.conj g).injective]
    exact congrArg (fun R : Subgroup D => omegaCenterIn R) (congrArg Sylow.toSubgroup hg)
  have hcard : Nat.card (omegaCenterIn (S : Subgroup D)) =
      Nat.card (omegaCenterIn (T : Subgroup D)) := by
    rw [←hmap]
    exact (card_map_of_injective (K := omegaCenterIn (S : Subgroup D))
      (f := (MulAut.conj g).toMonoidHom) (MulAut.conj g).injective).symm
  exact (card_le_of_le hA).trans_eq hcard

/-- Every elementary source actor has core index at most the original
local quotient Sylow omega-center order. -/
theorem source_elementary_core_index_le_omega
    (h : LocallyRankOneTriple P B) (d : EarlierLocalTheorems (family P))
    (v : Vertex (family P)) (M : IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    (A : Subgroup G) [IsElementaryAbelian 2 A] (hAL : A ≤ d.localGroup v)
    (T : Sylow 2 (d.localGroup v)) :
    (Q (family P) v).relIndex A ≤ Nat.card (omegaCenterIn
      ((T : Subgroup (d.localGroup v)).map (QuotientGroup.mk' (pCore 2 (d.localGroup v))))) := by
  let := finite_endpoints h
  let L := d.localGroup v
  let : Finite L := Finite.of_injective (inclusion (d.local_le v)) (inclusion_injective _)
  let q := QuotientGroup.mk' (pCore 2 L)
  let : IsElementaryAbelian 2 (A.subgroupOf L) := IsElementaryAbelian.subgroupOf hAL
  let : IsElementaryAbelian 2 ((A.subgroupOf L).map q) := IsElementaryAbelian.map q
  have hi := BinaryConjugationSection.actor_image_card_eq_relIndex L (Q (family P) v)
    A q (local_quotient_kernel (family P) d v (MulEquiv.refl _)) hAL
  exact hi ▸ elementary_card_le_omega M ((A.subgroupOf L).map q)
    (T.mapSurjective (QuotientGroup.mk'_surjective _))

/-- The first full q_lambda² ≤ q_beta estimate of 8.6 when naturality
fails, directly from (c). Both q's are the original quotient omega orders. -/
theorem source_commuting_intersection_natural_or_square
    (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    (models : ∀ v : Vertex (family P), IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    {a beta a' : Vertex (family P)} (hc : IsCriticalPair (family P) a a')
    (hab : (graph (family P)).Adj a beta)
    (hd : (graph (family P)).dist beta a' + 1 = b (family P))
    (hb : 1 < b (family P)) (hcomm : ⁅Z (family P) a,Z (family P) a'⁆ = ⊥)
    (w : (graph (family P)).neighborSet a')
    (hm : ⁅V (family P) beta 1 ⊓ Q (family P) a',Z (family P) w.val⁆ ≠ ⊥)
    (R : Sylow 2 (d.localGroup w.val)) (T : Sylow 2 (d.localGroup beta))
    (hinter : ⁅V (family P) beta 1 ⊓ Q (family P) a',
      V (family P) a' 1 ⊓ Q (family P) beta⁆ = ⊥) :
    Noncommuting.HasNaturalCenter (d.localGroup w.val) (Z (family P) w.val) (Q (family P) w.val) ∨
      Nat.card (omegaCenterIn ((R : Subgroup (d.localGroup w.val)).map
        (QuotientGroup.mk' (pCore 2 (d.localGroup w.val))))) ^ 2 ≤
      Nat.card (omegaCenterIn ((T : Subgroup (d.localGroup beta)).map
        (QuotientGroup.mk' (pCore 2 (d.localGroup beta))))) := by
  rcases source_moving_omega_square_or_natural h hB d models hc hab hd hb hcomm w hm R with hn | hs
  · exact Or.inl hn
  right
  let := finite_endpoints h
  let F := family P
  have hb3 : 3 ≤ b F := (source_critical_geometry h d hc hab hd hb hcomm).2.1
  let : IsElementaryAbelian 2 (V F a' 1) := CommutingTrivial.V_elementary F h.generate
    (fun v => (source_Z_Q_U h v).1) d.kernel_sylow a' (by omega)
  have hAL : V F a' 1 ≤ d.localGroup beta := pGroup_le_localGroup F d beta _
    (IsElementaryAbelian.isPGroup 2 _) (V_le_stabilizer_of_dist_add_le_b F h.generate a' beta 1
      (by rw [SimpleGraph.dist_comm]; exact hd.le))
  exact hs.trans ((source_commuting_intersection_fixed_index_le h hb w hinter).trans
    (source_elementary_core_index_le_omega h d beta (models beta) (V F a' 1) hAL T))


/-- The actual reduced-source (a)--(c) consumer of 8.6 gives the first
field-square comparison, or natural moving coordinates and H = Z_alpha'.
The opposite comparison and the unconditional central-containment proof
remain separate source obligations. -/
theorem reduced_central_commutator_natural_or_square
    {J : Fin 2 → Subgroup G} {S₀ : Subgroup G} (h : HypothesisF11 J S₀)
    (hob : ∀ v w : Vertex (Reduction.reducedFamily J S₀),
      (graph (Reduction.reducedFamily J S₀)).Adj v w →
      ¬ stabilizer (Reduction.reducedFamily J S₀) v ≤ normalizer
        ((Q (Reduction.reducedFamily J S₀) w ⊓ Q (Reduction.reducedFamily J S₀) v :
          Subgroup (Reduction.G₀ J S₀)) : Set (Reduction.G₀ J S₀)))
    (models : ∀ v : Vertex (Reduction.reducedFamily J S₀),
      IsRankOneModel (graphLocalGroup (Reduction.reducedFamily J S₀) v ⧸
        pCore 2 (graphLocalGroup (Reduction.reducedFamily J S₀) v)))
    {a beta a' : Vertex (Reduction.reducedFamily J S₀)}
    (hc : IsCriticalPair (Reduction.reducedFamily J S₀) a a')
    (hab : (graph (Reduction.reducedFamily J S₀)).Adj a beta)
    (hd : (graph (Reduction.reducedFamily J S₀)).dist beta a' + 1 = b (Reduction.reducedFamily J S₀))
    (hb : b (Reduction.reducedFamily J S₀) = 3)
    (hcomm : ⁅Z (Reduction.reducedFamily J S₀) a,Z (Reduction.reducedFamily J S₀) a'⁆ = ⊥)
    (hH : ⁅V (Reduction.reducedFamily J S₀) beta 1 ⊓ Q (Reduction.reducedFamily J S₀) a',
      V (Reduction.reducedFamily J S₀) a' 1⁆ ≤ Z (Reduction.reducedFamily J S₀) a') :
    let F := Reduction.reducedFamily J S₀
    let H := ⁅V F beta 1 ⊓ Q F a',V F a' 1⁆
    H ≠ ⊥ → ∃ (w : (graph F).neighborSet a')
      (R : Sylow 2 (graphLocalGroup F w.val)) (T : Sylow 2 (graphLocalGroup F beta)),
      ⁅V F beta 1 ⊓ Q F a',Z F w.val⁆ ≠ ⊥ ∧
      (R : Subgroup (graphLocalGroup F w.val)).map (graphLocalGroup F w.val).subtype =
        (stabilizer F w.val ⊓ stabilizer F a').pCoreIn 2 ∧
      (T : Subgroup (graphLocalGroup F beta)).map (graphLocalGroup F beta).subtype =
        (stabilizer F beta ⊓ stabilizer F a).pCoreIn 2 ∧
      ((Noncommuting.HasNaturalCenter (graphLocalGroup F w.val) (Z F w.val) (Q F w.val) ∧
          H = Z F a') ∨
        Nat.card (omegaCenterIn ((R : Subgroup (graphLocalGroup F w.val)).map
          (QuotientGroup.mk' (pCore 2 (graphLocalGroup F w.val))))) ^ 2 ≤
        Nat.card (omegaCenterIn ((T : Subgroup (graphLocalGroup F beta)).map
          (QuotientGroup.mk' (pCore 2 (graphLocalGroup F beta)))))) := by
  dsimp only
  intro hne
  let ht := Reduction.reduced_triple h
  let F := Reduction.reducedFamily J S₀
  let d := Reduction.reducedEarlierLocalTheorems h hob
  let : ∀ i, Finite (F i) := finite_endpoints ht
  have hb1 : 1 < b F := by change b F = 3 at hb; omega
  have hinter := reduced_distance_three_central_intersection_commutes h hob models hc hab hd hb hcomm hH
  obtain ⟨w,hm,_⟩ := exists_moving_neighbor F (fun v => (source_Z_Q_U ht v).1) beta a' hne
  obtain ⟨R,hR⟩ := source_edge_core_local_sylow ht (Reduction.reduced_borel_core_sylow h)
    d w.property.symm
  obtain ⟨T,hT⟩ := source_edge_core_local_sylow ht (Reduction.reduced_borel_core_sylow h)
    d hab.symm
  refine ⟨w,R,T,hm,hR,hT,?_⟩
  rcases source_commuting_intersection_natural_or_square ht (Reduction.reduced_borel_core_sylow h)
    d models hc hab hd hb1 hcomm w hm R T hinter with hn | hs
  · left
    refine ⟨hn,?_⟩
    have hca := critical_end_center_of_commuting F ht.generate
      (fun v => (source_Z_Q_U ht v).1) (fun v => (source_Z_Q_U ht v).2)
      hc hcomm (d.localGroup a') (d.sylow_or_center a')
    rw [commutator_comm]
    exact source_natural_span_commutator ht (Reduction.reduced_borel_core_sylow h) d
      w.property.symm rfl hca hn _ inf_le_right (by rwa [commutator_comm])
  · exact Or.inr hs


/-- For a terminal quotient of two-rank one, 8.6(c) already forces
actual natural moving-center coordinates and H = Z_alpha'. -/
theorem source_rank_one_terminal_commuting_intersection_natural
    (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    (models : ∀ v : Vertex (family P), IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    {a beta a' : Vertex (family P)} (hc : IsCriticalPair (family P) a a')
    (hab : (graph (family P)).Adj a beta)
    (hd : (graph (family P)).dist beta a' + 1 = b (family P))
    (hb : 1 < b (family P)) (hcomm : ⁅Z (family P) a,Z (family P) a'⁆ = ⊥)
    (w : (graph (family P)).neighborSet a')
    (hm : ⁅V (family P) beta 1 ⊓ Q (family P) a',Z (family P) w.val⁆ ≠ ⊥)
    (hinter : ⁅V (family P) beta 1 ⊓ Q (family P) a',
      V (family P) a' 1 ⊓ Q (family P) beta⁆ = ⊥)
    (hr : primeRank 2 (d.localGroup a' ⧸ pCore 2 (d.localGroup a')) ≤ 1) :
    Noncommuting.HasNaturalCenter (d.localGroup w.val) (Z (family P) w.val) (Q (family P) w.val) ∧
      ⁅V (family P) beta 1 ⊓ Q (family P) a',V (family P) a' 1⁆ = Z (family P) a' := by
  let := finite_endpoints h
  let F := family P
  let L := d.localGroup w.val
  let A := V F beta 1 ⊓ Q F a'
  let : Finite L := Finite.of_injective (inclusion (d.local_le w.val)) (inclusion_injective _)
  have hb3 : 3 ≤ b F := (source_critical_geometry h d hc hab hd hb hcomm).2.1
  let : IsElementaryAbelian 2 (V F beta 1) := CommutingTrivial.V_elementary F h.generate
    (fun v => (source_Z_Q_U h v).1) d.kernel_sylow beta (by omega)
  let : IsElementaryAbelian 2 A := IsElementaryAbelian.of_le inf_le_left
  have hAL : A ≤ L := (source_moving_actor h d hc hab hd hb hcomm w hm).2.1
  let : Finite A := Finite.of_injective (inclusion hAL) (inclusion_injective _)
  have hAQ : ¬ A ≤ Q F w.val := (source_moving_actor h d hc hab hd hb hcomm w hm).2.2.2.1
  let R : Sylow 2 L := default
  have hnat : Noncommuting.HasNaturalCenter L (Z F w.val) (Q F w.val) := by
    rcases source_moving_omega_square_or_natural h hB d models hc hab hd hb hcomm w hm R with hn | hs
    · exact hn
    have hupper := (source_commuting_intersection_fixed_index_le h hb w hinter).trans
      (source_ending_rank_actor_bounds h d hc hab hd hb hcomm 1 hr).2
    norm_num only [pow_one] at hupper
    have hsmall := hs.trans hupper
    have hO := source_elementary_core_index_le_omega h d w.val (models w.val) A hAL R
    have hpos : 0 < (Q F w.val).relIndex A :=
      Nat.pos_of_ne_zero ((Q F w.val).subgroupOf A).index_ne_zero_of_finite
    have hni : (Q F w.val).relIndex A ≠ 1 := fun he => hAQ (relIndex_eq_one.mp he)
    have htwo : 2 ≤ (Q F w.val).relIndex A := by omega
    nlinarith
  refine ⟨hnat,?_⟩
  have hca := critical_end_center_of_commuting F h.generate (fun v => (source_Z_Q_U h v).1)
    (fun v => (source_Z_Q_U h v).2) hc hcomm (d.localGroup a') (d.sylow_or_center a')
  rw [commutator_comm]
  apply source_natural_span_commutator h hB d w.property.symm rfl hca hnat _ inf_le_right
  intro hz
  exact hm (bot_unique ((commutator_mono le_rfl (Z_neighbor_le_V F w.property)).trans
    (by rwa [commutator_comm] at hz : ⁅A,V F a' 1⁆ = ⊥).le))

/-- Actual binary-terminal application of 8.6(a)--(c): the source distance
is three and the central containment becomes equality, with natural coordinates
at the original moving neighbor. Every small terminal model is included. -/
theorem reduced_small_terminal_central_commutator_natural
    {J : Fin 2 → Subgroup G} {S₀ : Subgroup G} (h : HypothesisF11 J S₀)
    (hob : ∀ v w : Vertex (Reduction.reducedFamily J S₀),
      (graph (Reduction.reducedFamily J S₀)).Adj v w →
      ¬ stabilizer (Reduction.reducedFamily J S₀) v ≤ normalizer
        ((Q (Reduction.reducedFamily J S₀) w ⊓ Q (Reduction.reducedFamily J S₀) v :
          Subgroup (Reduction.G₀ J S₀)) : Set (Reduction.G₀ J S₀)))
    (models : ∀ v : Vertex (Reduction.reducedFamily J S₀),
      IsRankOneModel (graphLocalGroup (Reduction.reducedFamily J S₀) v ⧸
        pCore 2 (graphLocalGroup (Reduction.reducedFamily J S₀) v)))
    {a beta a' : Vertex (Reduction.reducedFamily J S₀)}
    (hc : IsCriticalPair (Reduction.reducedFamily J S₀) a a')
    (hab : (graph (Reduction.reducedFamily J S₀)).Adj a beta)
    (hd : (graph (Reduction.reducedFamily J S₀)).dist beta a' + 1 = b (Reduction.reducedFamily J S₀))
    (hb : 1 < b (Reduction.reducedFamily J S₀))
    (hcomm : ⁅Z (Reduction.reducedFamily J S₀) a,Z (Reduction.reducedFamily J S₀) a'⁆ = ⊥)
    (hne : ⁅V (Reduction.reducedFamily J S₀) beta 1 ⊓ Q (Reduction.reducedFamily J S₀) a',
      V (Reduction.reducedFamily J S₀) a' 1⁆ ≠ ⊥)
    (hsmall :
      let D := graphLocalGroup (Reduction.reducedFamily J S₀) a' ⧸
        pCore 2 (graphLocalGroup (Reduction.reducedFamily J S₀) a')
      ClassicalGroup.IsPSL D 2 2 ∨ Nonempty (D ≃* DihedralGroup 5) ∨
      Nonempty (D ≃* SuzukiMatrixGroup 0) ∨ ClassicalGroup.IsPSU D 3 2 ∨ IsSU D 3 2)
    (hH : ⁅V (Reduction.reducedFamily J S₀) beta 1 ⊓ Q (Reduction.reducedFamily J S₀) a',
      V (Reduction.reducedFamily J S₀) a' 1⁆ ≤ Z (Reduction.reducedFamily J S₀) a') :
    let F := Reduction.reducedFamily J S₀
    b F = 3 ∧ ⁅V F beta 1 ⊓ Q F a',V F a' 1⁆ = Z F a' ∧
      ∃ (w : (graph F).neighborSet a') (R : Sylow 2 (graphLocalGroup F w.val)),
        ⁅V F beta 1 ⊓ Q F a',Z F w.val⁆ ≠ ⊥ ∧
        (R : Subgroup (graphLocalGroup F w.val)).map (graphLocalGroup F w.val).subtype =
          (stabilizer F w.val ⊓ stabilizer F a').pCoreIn 2 ∧
        Noncommuting.HasNaturalCenter (graphLocalGroup F w.val) (Z F w.val) (Q F w.val) := by
  let ht := Reduction.reduced_triple h
  let F := Reduction.reducedFamily J S₀
  let d := Reduction.reducedEarlierLocalTheorems h hob
  let : ∀ i, Finite (F i) := finite_endpoints ht
  let : Finite (graphLocalGroup F a') :=
    Finite.of_injective (inclusion (sylowGenerated_le _)) (inclusion_injective _)
  have hb3 := reduced_small_terminal_distance_three h hob models hc hab hd hb hcomm hne hsmall
  have hinter := reduced_distance_three_central_intersection_commutes h hob models hc hab hd hb3 hcomm hH
  obtain ⟨w,hm,_⟩ := exists_moving_neighbor F (fun v => (source_Z_Q_U ht v).1) beta a' hne
  obtain ⟨R,hR⟩ := source_edge_core_local_sylow ht (Reduction.reduced_borel_core_sylow h) d w.property.symm
  have hr := small_terminal_two_rank hsmall
  obtain ⟨hn,he⟩ := source_rank_one_terminal_commuting_intersection_natural ht
    (Reduction.reduced_borel_core_sylow h) d models hc hab hd hb hcomm w hm hinter hr
  exact ⟨hb3,he,w,R,hm,hR,hn⟩

