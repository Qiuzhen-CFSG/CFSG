module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingNontrivial.FullCoreDistance
public import Theory.SpecificGroups.SU3.SylowOmegaIndex
public import Theory.SpecificGroups.Suzuki.SylowOmegaIndex
public import Theory.SpecificGroups.SL2.SylowInvariantSubgroup

/-!
# Comparing an edge core product in the two local quotients

The index of the adjacent-core product in the edge two-core is unchanged
when computed in either endpoint's literal quotient by its two-core.
At a small unitary endpoint the genuine 6.5 obstruction makes the opposite
core image nonzero, so its index is at most four. Linear endpoints force
the full product; proper products at larger unitary and Suzuki endpoints
have the lower bounds supplied by their Sylow omega-centers.

These comparisons feed the original distance-three theorem in
`CommutingNontrivial.DistanceThree`, together with the already established
small-terminal exclusion. They do not assert that arbitrary intersections
are generated by involutions.

Source: DGS, *Groups and Graphs* (1985), 6.5 and 8.4, pp.121--122,137--138.
-/

@[expose] public noncomputable section
open Subgroup BenderSuzuki.MatrixGroups
open scoped MatrixGroups
namespace CFSG.Quasithin.ChapterF.Source.DGS85.CommutingNontrivial
open Subgroup.CosetGeometry.RankTwo Theory.GroupTheory.AmalgamGraph
variable {G : Type*} [Group G] {P : Fin 2 → Subgroup G} {B : Subgroup G}

private theorem edge_image_invariant
    (h : LocallyRankOneTriple P B) (d : EarlierLocalTheorems (family P))
    {v w : Vertex (family P)} (hvw : (graph (family P)).Adj v w)
    (M : IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    (R : Sylow 2 (d.localGroup v))
    (hR : (R : Subgroup (d.localGroup v)).map (d.localGroup v).subtype =
      (stabilizer (family P) v ⊓ stabilizer (family P) w).pCoreIn 2) :
    let L := d.localGroup v
    let q := QuotientGroup.mk' (pCore 2 L)
    let S := (R : Subgroup L).map q
    let A := ((Q (family P) w).subgroupOf L).map q
    A ≤ S ∧ normalizer (S : Set (L ⧸ pCore 2 L)) ≤ normalizer (A : Set (L ⧸ pCore 2 L)) := by
  let := finite_endpoints h
  let F := family P
  let L := d.localGroup v
  let : Finite L := Finite.of_injective (inclusion (d.local_le v)) (inclusion_injective _)
  let q := QuotientGroup.mk' (pCore 2 L)
  let A := (Q F w).subgroupOf L
  have hQR : Q F w ≤ (R : Subgroup L).map L.subtype := by
    rw [hR]
    simpa only [inf_comm] using Noncommuting.graph_Q_le_edgeCore h hvw.symm
  have hAR : A ≤ R := by
    intro x hx
    obtain ⟨y,hy,he⟩ := hQR hx
    exact (Subtype.ext he : y=x) ▸ hy
  refine ⟨map_mono hAR,?_⟩
  have hNA : normalizer (R : Set L) ≤ normalizer (A : Set L) := by
    apply le_normalizer_iff.mpr
    intro g hg x hx
    have hgw : (g : G) ∈ stabilizer F w := by
      have hg' : g ∈ (stabilizer F w).subgroupOf L :=
        (source_edge_local_normalizer h d hvw M R hR).2.symm ▸ hg
      exact hg'
    exact le_normalizer_iff.mp (stabilizer_normalizes_Q F w) g hgw x hx
  change normalizer ((R : Subgroup L).map q : Set (L ⧸ pCore 2 L)) ≤ _
  rw [←R.normalizer_map_surjective q (QuotientGroup.mk'_surjective _)]
  exact (map_mono hNA).trans (A.le_normalizer_map q)

/-- The core-product index computed in either literal local quotient. -/
theorem source_edge_core_product_index
    (h : LocallyRankOneTriple P B) (d : EarlierLocalTheorems (family P))
    {v w : Vertex (family P)} (hvw : (graph (family P)).Adj v w)
    (R : Sylow 2 (d.localGroup v))
    (hR : (R : Subgroup (d.localGroup v)).map (d.localGroup v).subtype =
      (stabilizer (family P) v ⊓ stabilizer (family P) w).pCoreIn 2) :
    (Q (family P) v ⊔ Q (family P) w).relIndex
      ((stabilizer (family P) v ⊓ stabilizer (family P) w).pCoreIn 2) =
      (((Q (family P) w).subgroupOf (d.localGroup v)).map
        (QuotientGroup.mk' (pCore 2 (d.localGroup v)))).relIndex
      ((R : Subgroup (d.localGroup v)).map (QuotientGroup.mk' (pCore 2 (d.localGroup v)))) := by
  let L := d.localGroup v
  have hQL : Q (family P) w ≤ L :=
    (show Q (family P) w ≤ (stabilizer (family P) v ⊓ stabilizer (family P) w).pCoreIn 2 from
      by simpa only [inf_comm] using Noncommuting.graph_Q_le_edgeCore h hvw.symm).trans
      (hR ▸ map_subtype_le _)
  rw [relIndex_map_map,QuotientGroup.ker_mk',
    sup_eq_left.mpr (pCore_isPGroup.le_sylow_of_normal R)]
  rw [←relIndex_map_map_of_injective _ _ L.subtype_injective,
    Subgroup.map_sup,map_subgroupOf_eq_of_le hQL]
  have hcore : (pCore 2 L).map L.subtype = Q (family P) v := localGroup_core_eq (family P) d v
  rw [hcore,hR,sup_comm]

private theorem edge_image_ne_bot
    (h : LocallyRankOneTriple P B) (d : EarlierLocalTheorems (family P))
    {v w : Vertex (family P)} (hvw : (graph (family P)).Adj v w)
    (R : Sylow 2 (d.localGroup v))
    (hR : (R : Subgroup (d.localGroup v)).map (d.localGroup v).subtype =
      (stabilizer (family P) v ⊓ stabilizer (family P) w).pCoreIn 2)
    (hob : ¬ stabilizer (family P) w ≤ normalizer
      ((Q (family P) v ⊓ Q (family P) w : Subgroup G) : Set G)) :
    ((Q (family P) w).subgroupOf (d.localGroup v)).map
      (QuotientGroup.mk' (pCore 2 (d.localGroup v))) ≠ ⊥ := by
  intro hz
  have hk := (Subgroup.map_eq_bot_iff _).mp hz
  rw [QuotientGroup.ker_mk'] at hk
  have hQL : Q (family P) w ≤ d.localGroup v :=
    (show Q (family P) w ≤ (stabilizer (family P) v ⊓ stabilizer (family P) w).pCoreIn 2 from
      by simpa only [inf_comm] using Noncommuting.graph_Q_le_edgeCore h hvw.symm).trans
      (hR ▸ map_subtype_le _)
  have hle : Q (family P) w ≤ Q (family P) v := by
    rw [←localGroup_core_eq (family P) d v]
    intro x hx
    exact ⟨⟨x,hQL hx⟩,hk hx,rfl⟩
  apply hob
  rw [inf_eq_right.mpr hle]
  exact stabilizer_normalizes_Q (family P) w

private theorem omega_index_transport {D E : Type*} [Group D] [Group E] [Finite D]
    (e : D ≃* E) (S : Sylow 2 D) :
    let T := S.mapSurjective (f := e.toMonoidHom) e.surjective
    Nat.card (omegaCenterIn (T : Subgroup E)) = Nat.card (omegaCenterIn (S : Subgroup D)) ∧
      (omegaCenterIn (T : Subgroup E)).relIndex T = (omegaCenterIn (S : Subgroup D)).relIndex S := by
  dsimp only
  change Nat.card (omegaCenterIn ((S : Subgroup D).map e.toMonoidHom)) = _ ∧
    (omegaCenterIn ((S : Subgroup D).map e.toMonoidHom)).relIndex
      ((S : Subgroup D).map e.toMonoidHom) = _
  rw [←NilesRankOneKernel.omegaCenterIn_map_injective e.toMonoidHom e.injective,
    card_map_of_injective e.injective,relIndex_map_map_of_injective _ _ e.injective]
  exact ⟨rfl,rfl⟩

private theorem small_unitary_sylow_card {D : Type*} [Group D] [Finite D]
    (hu : ClassicalGroup.IsPSU D 3 2 ∨ IsSU D 3 2) (S : Sylow 2 D) : Nat.card S = 8 := by
  have hcalc (hc : Nat.card (omegaCenterIn (S : Subgroup D)) = 2)
      (hi : (omegaCenterIn (S : Subgroup D)).relIndex S = 4) : Nat.card S = 8 := by
    have hh := ((omegaCenterIn (S : Subgroup D)).subgroupOf S).card_mul_index
    rw [Nat.card_congr (subgroupOfEquivOfLe (map_subtype_le _)).toEquiv] at hh
    change Nat.card (omegaCenterIn (S : Subgroup D)) *
      (omegaCenterIn (S : Subgroup D)).relIndex S = Nat.card S at hh
    rw [hc,hi] at hh
    exact hh.symm
  rcases hu with hu | hu
  · obtain ⟨K,_,_,H,hK,hconj,⟨e⟩⟩ := hu
    obtain ⟨hc,hi⟩ := omega_index_transport e S
    obtain ⟨hc',hi'⟩ := HermitianForm.SylowOmegaIndex.projective H (n := 1) (by decide)
      (by simpa using hK) (by simpa using hconj) (S.mapSurjective (f := e.toMonoidHom) e.surjective)
    apply hcalc
    · simpa using hc.symm.trans hc'
    · simpa using hi.symm.trans hi'
  · obtain ⟨K,_,_,H,hK,hconj,⟨e⟩⟩ := hu
    obtain ⟨hc,hi⟩ := omega_index_transport e S
    obtain ⟨hc',hi'⟩ := HermitianForm.SylowOmegaIndex.special H (n := 1) (by decide)
      (by simpa using hK) (by simpa using hconj) (S.mapSurjective (f := e.toMonoidHom) e.surjective)
    apply hcalc
    · simpa using hc.symm.trans hc'
    · simpa using hi.symm.trans hi'

/-- A nonzero neighboring-core image in a small unitary Sylow gives index at most four. -/
theorem source_small_unitary_core_product_index_le_four
    (h : LocallyRankOneTriple P B) (d : EarlierLocalTheorems (family P))
    {v w : Vertex (family P)} (hvw : (graph (family P)).Adj v w)
    (M : IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    (R : Sylow 2 (d.localGroup v))
    (hR : (R : Subgroup (d.localGroup v)).map (d.localGroup v).subtype =
      (stabilizer (family P) v ⊓ stabilizer (family P) w).pCoreIn 2)
    (hob : ¬ stabilizer (family P) w ≤ normalizer
      ((Q (family P) v ⊓ Q (family P) w : Subgroup G) : Set G))
    (hu : ClassicalGroup.IsPSU (d.localGroup v ⧸ pCore 2 (d.localGroup v)) 3 2 ∨
      IsSU (d.localGroup v ⧸ pCore 2 (d.localGroup v)) 3 2) :
    (Q (family P) v ⊔ Q (family P) w).relIndex
      ((stabilizer (family P) v ⊓ stabilizer (family P) w).pCoreIn 2) ≤ 4 := by
  let := finite_endpoints h
  let L := d.localGroup v
  let : Finite L := Finite.of_injective (inclusion (d.local_le v)) (inclusion_injective _)
  let q := QuotientGroup.mk' (pCore 2 L)
  let S := R.mapSurjective (QuotientGroup.mk'_surjective (pCore 2 L))
  let A := ((Q (family P) w).subgroupOf L).map q
  have hAS : A ≤ S := (edge_image_invariant h d hvw M R hR).1
  have hne : A ≠ ⊥ := edge_image_ne_bot h d hvw R hR hob
  have hc := A.one_lt_card_iff_ne_bot.mpr hne
  have hSc := small_unitary_sylow_card hu S
  have hm := (A.subgroupOf S).card_mul_index
  rw [Nat.card_congr (subgroupOfEquivOfLe hAS).toEquiv] at hm
  change Nat.card A * A.relIndex S = Nat.card S at hm
  rw [source_edge_core_product_index h d hvw R hR]
  change A.relIndex S ≤ 4
  nlinarith

/-- Omega placement of the neighboring core bounds the same edge index below. -/
theorem source_core_product_index_ge_omega
    (h : LocallyRankOneTriple P B) (d : EarlierLocalTheorems (family P))
    {v w : Vertex (family P)} (hvw : (graph (family P)).Adj v w)
    (R : Sylow 2 (d.localGroup v))
    (hR : (R : Subgroup (d.localGroup v)).map (d.localGroup v).subtype =
      (stabilizer (family P) v ⊓ stabilizer (family P) w).pCoreIn 2)
    (ho : Q (family P) w ≤ quotientSylowOmegaPreimage (d.localGroup v) R) :
    (omegaCenterIn ((R : Subgroup (d.localGroup v)).map
      (QuotientGroup.mk' (pCore 2 (d.localGroup v))))).relIndex
      ((R : Subgroup (d.localGroup v)).map (QuotientGroup.mk' (pCore 2 (d.localGroup v)))) ≤
    (Q (family P) v ⊔ Q (family P) w).relIndex
      ((stabilizer (family P) v ⊓ stabilizer (family P) w).pCoreIn 2) := by
  let := finite_endpoints h
  let L := d.localGroup v
  let : Finite L := Finite.of_injective (inclusion (d.local_le v)) (inclusion_injective _)
  rw [source_edge_core_product_index h d hvw R hR]
  apply relIndex_le_of_le_left ?_ index_ne_zero_of_finite
  rintro _ ⟨x,hx,rfl⟩
  obtain ⟨y,hy,he⟩ := ho hx
  exact (Subtype.ext he : y = x) ▸ hy

/-- A linear endpoint and the genuine core obstruction force the full edge core product. -/
theorem source_linear_edge_core_product
    (h : LocallyRankOneTriple P B) (d : EarlierLocalTheorems (family P))
    {v w : Vertex (family P)} (hvw : (graph (family P)).Adj v w)
    (M : IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    (R : Sylow 2 (d.localGroup v))
    (hR : (R : Subgroup (d.localGroup v)).map (d.localGroup v).subtype =
      (stabilizer (family P) v ⊓ stabilizer (family P) w).pCoreIn 2)
    (hob : ¬ stabilizer (family P) w ≤ normalizer
      ((Q (family P) v ⊓ Q (family P) w : Subgroup G) : Set G))
    {n : ℕ} (_hn : 0 < n)
    (hi : ClassicalGroup.IsPSL (d.localGroup v ⧸ pCore 2 (d.localGroup v)) 2 (2^n)) :
    Q (family P) v ⊔ Q (family P) w =
      (stabilizer (family P) v ⊓ stabilizer (family P) w).pCoreIn 2 := by
  let := finite_endpoints h
  let L := d.localGroup v
  let : Finite L := Finite.of_injective (inclusion (d.local_le v)) (inclusion_injective _)
  obtain ⟨K,_,_,hK,⟨eK⟩⟩ := hi
  let := Fintype.ofFinite K
  let : CharP K 2 := charP_of_card_eq_prime_pow (by simpa only [Nat.card_eq_fintype_card] using hK)
  let e : (L ⧸ pCore 2 L) ≃* SL(2,K) := eK.trans (MulEquiv.ofBijective
    (BenderSuzuki.Converse.pi K) ⟨BenderSuzuki.Converse.pi_injective,BenderSuzuki.Converse.pi_surjective⟩).symm
  let q := QuotientGroup.mk' (pCore 2 L)
  let S := R.mapSurjective (QuotientGroup.mk'_surjective (pCore 2 L))
  let A := ((Q (family P) w).subgroupOf L).map q
  obtain ⟨hAS,hNA⟩ := edge_image_invariant h d hvw M R hR
  have hne : A ≠ ⊥ := edge_image_ne_bot h d hvw R hR hob
  have he : A.map e.toMonoidHom = (S : Subgroup (L ⧸ pCore 2 L)).map e.toMonoidHom := by
    apply Matrix.SpecialLinearGroup.sylow_eq_of_normalized
      (S.mapSurjective (f := e.toMonoidHom) e.surjective) _ (map_mono hAS)
      (fun hz => hne ((map_eq_bot_iff_of_injective _ e.injective).mp hz))
    have hh := map_mono (f := e.toMonoidHom) hNA
    rwa [map_equiv_normalizer_eq,map_equiv_normalizer_eq] at hh
  have hidx : (Q (family P) v ⊔ Q (family P) w).relIndex
      ((stabilizer (family P) v ⊓ stabilizer (family P) w).pCoreIn 2) = 1 := by
    rw [source_edge_core_product_index h d hvw R hR]
    change A.relIndex S = 1
    rw [(Subgroup.map_injective e.injective) he,relIndex_self]
  apply le_antisymm ?_ (relIndex_eq_one.mp hidx)
  exact sup_le (Noncommuting.graph_Q_le_edgeCore h hvw)
    (by simpa only [inf_comm] using Noncommuting.graph_Q_le_edgeCore h hvw.symm)

/-- The original unitary omega index gives the lower bound q² for a proper product. -/
theorem source_large_unitary_core_product_index_lower
    (h : LocallyRankOneTriple P B) (d : EarlierLocalTheorems (family P))
    {v w : Vertex (family P)} (hvw : (graph (family P)).Adj v w)
    (M : IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    (R : Sylow 2 (d.localGroup v))
    (hR : (R : Subgroup (d.localGroup v)).map (d.localGroup v).subtype =
      (stabilizer (family P) v ⊓ stabilizer (family P) w).pCoreIn 2)
    {n : ℕ} (hn : 2 ≤ n)
    (hu : ClassicalGroup.IsPSU (d.localGroup v ⧸ pCore 2 (d.localGroup v)) 3 (2^n) ∨
      IsSU (d.localGroup v ⧸ pCore 2 (d.localGroup v)) 3 (2^n))
    (hp : ¬ (stabilizer (family P) v ⊓ stabilizer (family P) w).pCoreIn 2 ≤
      Q (family P) v ⊔ Q (family P) w) :
    (2^n)^2 ≤ (Q (family P) v ⊔ Q (family P) w).relIndex
      ((stabilizer (family P) v ⊓ stabilizer (family P) w).pCoreIn 2) := by
  let := finite_endpoints h
  let L := d.localGroup v
  let : Finite L := Finite.of_injective (inclusion (d.local_le v)) (inclusion_injective _)
  let S := R.mapSurjective (QuotientGroup.mk'_surjective (pCore 2 L))
  have hlo := source_core_product_index_ge_omega h d hvw R hR
    (source_unitary_neighbor_core_le_omega h d hvw M R hR hn hu hp)
  have hi : (omegaCenterIn (S : Subgroup (L ⧸ pCore 2 L))).relIndex S = (2^n)^2 := by
    rcases hu with hu | hu
    · obtain ⟨K,_,_,H,hK,hconj,⟨e⟩⟩ := hu
      exact (omega_index_transport e S).2.symm.trans
        (HermitianForm.SylowOmegaIndex.projective H (by omega) hK hconj
          (S.mapSurjective (f := e.toMonoidHom) e.surjective)).2
    · obtain ⟨K,_,_,H,hK,hconj,⟨e⟩⟩ := hu
      exact (omega_index_transport e S).2.symm.trans
        (HermitianForm.SylowOmegaIndex.special H (by omega) hK hconj
          (S.mapSurjective (f := e.toMonoidHom) e.surjective)).2
  exact hi ▸ hlo

/-- The Suzuki omega index gives the lower bound q for the same proper product. -/
theorem source_suzuki_core_product_index_lower
    (h : LocallyRankOneTriple P B) (d : EarlierLocalTheorems (family P))
    {v w : Vertex (family P)} (hvw : (graph (family P)).Adj v w)
    (M : IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    (R : Sylow 2 (d.localGroup v))
    (hR : (R : Subgroup (d.localGroup v)).map (d.localGroup v).subtype =
      (stabilizer (family P) v ⊓ stabilizer (family P) w).pCoreIn 2)
    (m : ℕ) (e : (d.localGroup v ⧸ pCore 2 (d.localGroup v)) ≃* SuzukiMatrixGroup m)
    (hp : ¬ (stabilizer (family P) v ⊓ stabilizer (family P) w).pCoreIn 2 ≤
      Q (family P) v ⊔ Q (family P) w) :
    2^(2*m+1) ≤ (Q (family P) v ⊔ Q (family P) w).relIndex
      ((stabilizer (family P) v ⊓ stabilizer (family P) w).pCoreIn 2) := by
  let := finite_endpoints h
  let L := d.localGroup v
  let : Finite L := Finite.of_injective (inclusion (d.local_le v)) (inclusion_injective _)
  let S := R.mapSurjective (QuotientGroup.mk'_surjective (pCore 2 L))
  have hlo := source_core_product_index_ge_omega h d hvw R hR
    (source_suzuki_neighbor_core_le_omega h d hvw M R hR m e hp)
  have hi := (omega_index_transport e S).2.symm.trans
    (suzukiSylow_omegaCenter_card_index m (S.mapSurjective (f := e.toMonoidHom) e.surjective)).2
  exact hi ▸ hlo

end CFSG.Quasithin.ChapterF.Source.DGS85.CommutingNontrivial
