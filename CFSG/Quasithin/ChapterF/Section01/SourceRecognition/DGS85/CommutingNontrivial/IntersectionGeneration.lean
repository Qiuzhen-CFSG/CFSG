module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingNontrivial.RadiusThreeFullSpan
public import Theory.GroupTheory.InvolutionGeneratedCentralSupplement

/-!
# Genuine intersection generation for a rank-one terminal Sylow

The strict residual index is below two when the terminal quotient has
2-rank at most one. Hence W = (W ∩ Q_alpha') V_beta, with V_beta central
and elementary. Involution generation then descends to the actual
intersection. This closes its marked omega placement even at b = 5 and
for nonlinear moving quotients.

Conjugation transports the intersection's proved generation, so the one
marked 8.3 bound controls the full neighboring span. The construction uses
the original edge Sylows, quotient maps and relative normality; it never
assumes that arbitrary intersections inherit involution generation.

Source: DGS, *Groups and Graphs* (1985), 8.4(3) and its final paragraph,
p.138. `RankOneTerminalDistance` supplies the reduced graph consumer and
excludes distance five for the actual field-two terminal models.
-/

@[expose] public noncomputable section
open Subgroup
namespace CFSG.Quasithin.ChapterF.Source.DGS85.CommutingNontrivial
open Subgroup.CosetGeometry.RankTwo Theory.GroupTheory.AmalgamGraph
variable {G : Type*} [Group G] {P : Fin 2 → Subgroup G} {B : Subgroup G}

/-- Each center seed is elementary, so its whole radius span is generated
by involutions. This asserts generation, not exponent two for the span. -/
theorem source_span_involution_generated (h : LocallyRankOneTriple P B)
    (beta : Vertex (family P)) (r : ℕ) :
    involutionGenerated (V (family P) beta r) = V (family P) beta r := by
  apply le_antisymm (involutionGenerated_le _)
  apply iSup_le
  intro v
  apply iSup_le
  intro hv x hx
  let := CommutingOneProfile.source_center_elementary h v
  apply Subgroup.subset_closure
  refine ⟨?_,elemPow_eq_one_of_isElementaryAbelian (p := 2) x hx⟩
  exact (show Z (family P) v ≤ V (family P) beta r from
    le_iSup_of_le v (le_iSup_of_le hv le_rfl)) hx

/-- Involution generation suffices for placement in the marked quotient
omega-center; the original subgroup need not be elementary. -/
theorem source_involution_generated_le_quotient_omega
    (h : LocallyRankOneTriple P B)
    (d : EarlierLocalTheorems (family P)) (v : Vertex (family P))
    (M : IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    (R : Sylow 2 (d.localGroup v)) (A : Subgroup G)
    (hgen : involutionGenerated A = A)
    (hA : A ≤ (R : Subgroup (d.localGroup v)).map (d.localGroup v).subtype) :
    A ≤ quotientSylowOmegaPreimage (d.localGroup v) R := by
  let := finite_endpoints h
  let L := d.localGroup v
  let : Finite L := Finite.of_injective (inclusion (d.local_le v)) (inclusion_injective _)
  let q := QuotientGroup.mk' (pCore 2 L)
  let S := R.mapSurjective (QuotientGroup.mk'_surjective (pCore 2 L))
  rw [← hgen]
  apply (involutionGenerated_le_iff _ _).mpr
  intro x hx hx2
  obtain ⟨y,hy,he⟩ := hA hx
  change (y : G) = x at he
  have hqS : q y ∈ (S : Subgroup (L ⧸ pCore 2 L)) := mem_map_of_mem q hy
  have hy2 : y ^ 2 = 1 := Subtype.ext (by
    change (y : G) ^ 2 = 1
    rwa [he])
  have hq2 : (q y) ^ 2 = 1 := by rw [←map_pow,hy2,map_one]
  have hcent := source_rank_one_sylow_square_central M S ⟨q y,hqS⟩ (Subtype.ext hq2)
  refine ⟨y,?_,he⟩
  apply (mem_omegaCenterIn_iff _ _).mpr
  refine ⟨hqS,?_,hq2⟩
  intro z hz
  exact congrArg Subtype.val (mem_center_iff.mp hcent ⟨z,hz⟩)

/-- In a terminal quotient of two-rank one, the strict index bound forces
W = (W ∩ Q_alpha') V_beta. The supplement is central and elementary, so the
literal intersection is generated by involutions, including at b = 5. -/
theorem source_radius_three_intersection_generated_of_rank_one
    (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    (hob : ∀ v w : Vertex (family P), (graph (family P)).Adj v w →
      ¬ stabilizer (family P) v ≤ normalizer
        ((Q (family P) w ⊓ Q (family P) v : Subgroup G) : Set G))
    (models : ∀ v : Vertex (family P),
      IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    {a beta a' : Vertex (family P)} (hc : IsCriticalPair (family P) a a')
    (hab : (graph (family P)).Adj a beta)
    (hd : (graph (family P)).dist beta a' + 1 = b (family P))
    (hb : 3 < b (family P)) (hcomm : ⁅Z (family P) a, Z (family P) a'⁆ = ⊥)
    (hne : ⁅V (family P) beta 1 ⊓ Q (family P) a', V (family P) a' 1⁆ ≠ ⊥)
    (hr : primeRank 2 (d.localGroup a' ⧸ pCore 2 (d.localGroup a')) ≤ 1) :
    let F := family P
    ((V F beta 3 ⊓ Q F a') ⊔ V F beta 1 = V F beta 3) ∧
    involutionGenerated (V F beta 3 ⊓ Q F a') = V F beta 3 ⊓ Q F a' := by
  let := finite_endpoints h
  let F := family P
  let W := V F beta 3
  let E := V F beta 1
  let I := W ⊓ Q F a'
  let D := I ⊔ E
  let L := d.localGroup a'
  let : Finite L := Finite.of_injective (inclusion (d.local_le a')) (inclusion_injective _)
  obtain ⟨prev,R,_,_,_,_,hWO,_,_,hindex⟩ :=
    source_radius_three_section_index h hB d hob models hc hab hd hb hcomm hne
  change Sylow 2 L at R
  have hWL : W ≤ L := hWO.trans (map_subtype_le _)
  let : Finite W := Finite.of_injective (inclusion hWL) (inclusion_injective _)
  have hO := (primeRank_le_iff_elementary_card_le (L ⧸ pCore 2 L)).mp hr
    (omegaCenterIn ((R : Subgroup L).map (QuotientGroup.mk' (pCore 2 L)))) inferInstance
  norm_num only [pow_one] at hO
  have hlt : D.relIndex W < 2 := hindex.trans_le hO
  have hpos : 0 < D.relIndex W := Nat.pos_of_ne_zero (Subgroup.index_ne_zero_of_finite (H := D.subgroupOf W))
  have hjoin : I ⊔ E = W := le_antisymm
    (sup_le inf_le_left (V_mono F beta (by decide)))
    (Subgroup.relIndex_eq_one.mp (by omega : D.relIndex W = 1))
  have hb5 : 5 ≤ b F := (source_radius_three_opening h d hc hab hd hb hcomm).1
  let : IsElementaryAbelian 2 E := CommutingTrivial.V_elementary F h.generate
    (fun v => (source_Z_Q_U h v).1) d.kernel_sylow beta (by omega)
  have hcent : E ≤ centralizer (I : Set G) :=
    (radius_spans_centralize F h.generate (fun v => (source_Z_Q_U h v).1)
      d.kernel_sylow beta 1 3 (by omega)).trans (centralizer_le inf_le_left)
  exact ⟨hjoin,involutionGenerated_eq_of_central_elementary_supplement W I E
    (source_span_involution_generated h beta 3) hjoin hcent⟩

/-- The second placement of 8.4(3) at every literal incident edge Sylow,
for a terminal quotient of two-rank one and every starting model. -/
theorem source_radius_three_rank_one_intersection_omega
    (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    (hob : ∀ v w : Vertex (family P), (graph (family P)).Adj v w →
      ¬ stabilizer (family P) v ≤ normalizer
        ((Q (family P) w ⊓ Q (family P) v : Subgroup G) : Set G))
    (models : ∀ v : Vertex (family P),
      IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    {a beta a' : Vertex (family P)} (hc : IsCriticalPair (family P) a a')
    (hab : (graph (family P)).Adj a beta)
    (hd : (graph (family P)).dist beta a' + 1 = b (family P))
    (hb : 3 < b (family P)) (hcomm : ⁅Z (family P) a, Z (family P) a'⁆ = ⊥)
    (hne : ⁅V (family P) beta 1 ⊓ Q (family P) a', V (family P) a' 1⁆ ≠ ⊥)
    (hr : primeRank 2 (d.localGroup a' ⧸ pCore 2 (d.localGroup a')) ≤ 1)
    (w : (graph (family P)).neighborSet a') (R : Sylow 2 (d.localGroup w.val))
    (hR : (R : Subgroup (d.localGroup w.val)).map (d.localGroup w.val).subtype =
      (stabilizer (family P) w.val ⊓ stabilizer (family P) a').pCoreIn 2) :
    V (family P) beta 3 ⊓ Q (family P) a' ≤
      quotientSylowOmegaPreimage (d.localGroup w.val) R := by
  exact source_involution_generated_le_quotient_omega h d w.val (models w.val) R _
    (source_radius_three_intersection_generated_of_rank_one h hB d hob models
      hc hab hd hb hcomm hne hr).2
    (source_radius_three_intersection_le_edge_sylow h d w R hR)

/-- Transport one marked omega bound to every neighboring center and then
to their actual radius-one span. Normality is relative to the terminal actor. -/
theorem source_radius_three_full_span_bound_of_involution_generated
    (h : LocallyRankOneTriple P B)
    (d : EarlierLocalTheorems (family P))
    {beta a' : Vertex (family P)} (hb : 1 < b (family P))
    (w : (graph (family P)).neighborSet a')
    (M : IsRankOneModel (d.localGroup w.val ⧸ pCore 2 (d.localGroup w.val)))
    (R : Sylow 2 (d.localGroup w.val))
    (hR : (R : Subgroup (d.localGroup w.val)).map (d.localGroup w.val).subtype =
      (stabilizer (family P) w.val ⊓ stabilizer (family P) a').pCoreIn 2)
    (hgen : involutionGenerated (V (family P) beta 3 ⊓ Q (family P) a') =
      V (family P) beta 3 ⊓ Q (family P) a')
    (H : Subgroup G) (hn : d.localGroup a' ≤ normalizer (H : Set G))
    (hbound : ⁅quotientSylowOmegaPreimage (d.localGroup w.val) R,Z (family P) w.val⁆ ≤ H) :
    ⁅V (family P) beta 3 ⊓ Q (family P) a',V (family P) a' 1⁆ ≤ H := by
  let := finite_endpoints h
  let F := family P
  let I := V F beta 3 ⊓ Q F a'
  have hVL : V F a' 1 ≤ d.localGroup a' :=
    (V_le_Q_of_dist_add_lt_b F h.generate (fun v => (source_Z_Q_U h v).1)
      a' a' 1 (by simpa using hb) (d.kernel_sylow a')).trans ((pCoreIn_le_sylow (stabilizer F a') default).trans (d.sylow_le a' default))
  have hall (v : (graph F).neighborSet a') : ⁅I,Z F v.val⁆ ≤ H := by
    obtain ⟨g,hg,hgv⟩ := d.transitive a' w v
    have hgen' : involutionGenerated (I.map (MulAut.conj g⁻¹).toMonoidHom) =
        I.map (MulAut.conj g⁻¹).toMonoidHom := by
      rw [←map_involutionGenerated_of_injective I _ (MulAut.conj g⁻¹).injective,hgen]
    have hga : g⁻¹ • a' = a' := (stabilizer F a').inv_mem (d.local_le a' hg)
    have hIq : I.map (MulAut.conj g⁻¹).toMonoidHom ≤ Q F a' := by
      have hh := map_mono (f := (MulAut.conj g⁻¹).toMonoidHom)
        (show I ≤ Q F a' from inf_le_right)
      rwa [←Q_translate,hga] at hh
    have hi : I.map (MulAut.conj g⁻¹).toMonoidHom ≤
        quotientSylowOmegaPreimage (d.localGroup w.val) R := by
      apply source_involution_generated_le_quotient_omega h d w.val M R _ hgen'
      rw [hR]
      exact hIq.trans (by simpa only [inf_comm] using Noncommuting.graph_Q_le_edgeCore h w.property)
    have hc := map_mono (f := (MulAut.conj g).toMonoidHom)
      ((commutator_mono hi le_rfl).trans hbound)
    have hmap : (I.map (MulAut.conj g⁻¹).toMonoidHom).map
        (MulAut.conj g).toMonoidHom = I := by
      rw [map_map]
      convert map_id I using 1
      ext x
      simp [mul_assoc]
    have hH : H.map (MulAut.conj g).toMonoidHom = H :=
      mem_normalizer_iff_map_conj_eq.mp (hn hg)
    rwa [map_commutator,hmap,←Z_translate,hgv,hH] at hc
  have hZ : ⁅Z F a',I⁆ ≤ H := by
    rw [commutator_eq_bot_iff_le_centralizer.mpr
      ((Z_centralizes_Q F a' (source_Z_Q_U h a').1).trans (centralizer_le inf_le_right))]
    exact bot_le
  rw [V_one_eq_sup_neighbors,commutator_comm]
  apply commutator_sup_le_of_relative_normal (d.localGroup a') _ _ I H hn
    ((Z_le_V F a' 1).trans hVL) (iSup_le fun v => (Z_neighbor_le_V F v.property).trans hVL) hZ
  exact commutator_iSup_le_of_relative_normal (d.localGroup a') I H _ hn
    (fun v => (Z_neighbor_le_V F v.property).trans hVL)
    (fun v => by rw [commutator_comm]; exact hall v)

end CFSG.Quasithin.ChapterF.Source.DGS85.CommutingNontrivial
