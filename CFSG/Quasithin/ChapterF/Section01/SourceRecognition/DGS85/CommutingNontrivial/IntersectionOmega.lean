module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingNontrivial.RadiusThreeOmega
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingTrivial.Neighborhood
public import Theory.SpecificGroups.SL2.TwoSubgroupExponent

/-!
# Quotient omega placement for the radius-three intersection

The radius-three span is generated by elementary center subgroups, but an
intersection of an involution-generated group with a core is not automatically
involution-generated. Once the intersection squares lie in the original
moving core, its image in the literal edge Sylow lies in the marked
quotient omega-center. The large-distance and linear/dihedral branches
below discharge this condition. The moving-neighbor application keeps the
graph edge Sylow and quotient map
explicit; no arbitrary transitive action or involution-generated intersection
is used.

Source: DGS, *Groups and Graphs* (1985), 8.4(3), printed p.138.
-/

@[expose] public noncomputable section
open Subgroup BenderSuzuki.MatrixGroups
open scoped MatrixGroups
namespace CFSG.Quasithin.ChapterF.Source.DGS85.CommutingNontrivial
open Subgroup.CosetGeometry.RankTwo Theory.GroupTheory.AmalgamGraph
variable {G : Type*} [Group G]
variable {P : Fin 2 → Subgroup G} {B : Subgroup G}

/-- An elementary subgroup inside a marked local Sylow maps into the full
quotient omega-center.  The subgroup may be an intersection; its elementary
hypothesis is therefore explicit rather than inferred from generation. -/
theorem source_elementary_le_quotient_omega
    (h : LocallyRankOneTriple P B)
    (d : EarlierLocalTheorems (family P)) (v : Vertex (family P))
    (M : IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    (R : Sylow 2 (d.localGroup v)) (A : Subgroup G)
    [IsElementaryAbelian 2 A]
    (hA : A ≤ (R : Subgroup (d.localGroup v)).map (d.localGroup v).subtype) :
    A ≤ quotientSylowOmegaPreimage (d.localGroup v) R := by
  let := finite_endpoints h
  let L := d.localGroup v
  let : Finite L := Finite.of_injective (inclusion (d.local_le v)) (inclusion_injective _)
  let q := QuotientGroup.mk' (pCore 2 L)
  have hAL : A ≤ L := hA.trans (map_subtype_le _)
  let : IsElementaryAbelian 2 (A.subgroupOf L) := IsElementaryAbelian.subgroupOf hAL
  let : IsElementaryAbelian 2 ((A.subgroupOf L).map q) := IsElementaryAbelian.map q
  have hAS : A.subgroupOf L ≤ (R : Subgroup L) := by
    intro x hx
    obtain ⟨y,hy,he⟩ := hA hx
    exact (Subtype.ext he : y = x) ▸ hy
  have hqA : (A.subgroupOf L).map q ≤
      omegaCenterIn ((R : Subgroup L).map q) :=
    source_rank_one_elementary_le_sylow_omega
      (M := M) (R.mapSurjective (QuotientGroup.mk'_surjective (pCore 2 L)))
      ((A.subgroupOf L).map q) (map_mono hAS)
  intro x hx
  exact ⟨⟨x,hAL hx⟩,hqA (mem_map_of_mem q hx),rfl⟩

/-- The moving-neighbor form of the second 8.4(3) placement.  The source
square/exponent argument is represented by the explicit elementary instance on
`W ∩ Q a'`; edge containment is likewise the literal edge-Sylow premise. -/
theorem source_moving_intersection_le_quotient_omega
    (h : LocallyRankOneTriple P B)
    (d : EarlierLocalTheorems (family P))
    {beta a' : Vertex (family P)}
    (w : (graph (family P)).neighborSet a')
    (M : IsRankOneModel (d.localGroup w.val ⧸ pCore 2 (d.localGroup w.val)))
    (R : Sylow 2 (d.localGroup w.val))
    (A : Subgroup G)
    (hAeq : A = V (family P) beta 3 ⊓ Q (family P) a')
    (hA : A ≤
      (R : Subgroup (d.localGroup w.val)).map (d.localGroup w.val).subtype)
    [IsElementaryAbelian 2 A] :
    V (family P) beta 3 ⊓ Q (family P) a' ≤
      quotientSylowOmegaPreimage (d.localGroup w.val) R := by
  rw [← hAeq]
  exact source_elementary_le_quotient_omega h d w.val M R A hA

/-- Reduced F1.11 consumer of the stronger elementary-intersection variant,
retaining the literal moving edge, local model and quotient map. The
elementary instance is an explicit extra hypothesis; the weaker square
condition and its proved source branches are supplied below. -/
theorem reduced_moving_intersection_le_quotient_omega
    {J : Fin 2 → Subgroup G} {S₀ : Subgroup G} (h : HypothesisF11 J S₀)
    (hob : ∀ v w : Vertex (Reduction.reducedFamily J S₀),
      (graph (Reduction.reducedFamily J S₀)).Adj v w →
      ¬ stabilizer (Reduction.reducedFamily J S₀) v ≤ normalizer
        ((Q (Reduction.reducedFamily J S₀) w ⊓ Q (Reduction.reducedFamily J S₀) v :
          Subgroup (Reduction.G₀ J S₀)) : Set (Reduction.G₀ J S₀)))
    {beta a' : Vertex (Reduction.reducedFamily J S₀)}
    (w : (graph (Reduction.reducedFamily J S₀)).neighborSet a')
    (M : IsRankOneModel
      (graphLocalGroup (Reduction.reducedFamily J S₀) w.val ⧸
        pCore 2 (graphLocalGroup (Reduction.reducedFamily J S₀) w.val)))
    (R : Sylow 2 (graphLocalGroup (Reduction.reducedFamily J S₀) w.val))
    (A : Subgroup (Reduction.G₀ J S₀))
    (hAeq : A = V (Reduction.reducedFamily J S₀) beta 3 ⊓
      Q (Reduction.reducedFamily J S₀) a')
    (hA : A ≤
      (R : Subgroup (graphLocalGroup (Reduction.reducedFamily J S₀) w.val)).map
        (graphLocalGroup (Reduction.reducedFamily J S₀) w.val).subtype)
    [IsElementaryAbelian 2 A] :
    V (Reduction.reducedFamily J S₀) beta 3 ⊓ Q (Reduction.reducedFamily J S₀) a' ≤
      quotientSylowOmegaPreimage (graphLocalGroup (Reduction.reducedFamily J S₀) w.val) R := by
  exact source_moving_intersection_le_quotient_omega
    (Reduction.reduced_triple h)
    (Reduction.reducedEarlierLocalTheorems h hob)
    w M R A hAeq hA

/- The endpoint core is contained in every incident edge core.  This is the
literal edge-Sylow bridge needed for the radius-three intersection: it does
not identify the intersection with the smaller radius-one actor. -/
theorem source_radius_three_intersection_le_edge_sylow
    (h : LocallyRankOneTriple P B)
    (d : EarlierLocalTheorems (family P))
    {beta a' : Vertex (family P)} (w : (graph (family P)).neighborSet a')
    (R : Sylow 2 (d.localGroup w.val))
    (hR : (R : Subgroup (d.localGroup w.val)).map (d.localGroup w.val).subtype =
      (stabilizer (family P) w.val ⊓ stabilizer (family P) a').pCoreIn 2) :
    V (family P) beta 3 ⊓ Q (family P) a' ≤
      (R : Subgroup (d.localGroup w.val)).map (d.localGroup w.val).subtype := by
  intro x hx
  have hQ : Q (family P) a' ≤
      (R : Subgroup (d.localGroup w.val)).map (d.localGroup w.val).subtype := by
    rw [hR]
    simpa only [inf_comm] using Noncommuting.graph_Q_le_edgeCore h w.property
  exact hQ hx.2

/- For b at least seven the radius-three span itself is elementary.  The
intersection inherits this property. At b=5, the separate quotient-square
argument is required; generation by involutions alone does not suffice. -/
theorem source_radius_three_intersection_elementary_of_large
    (h : LocallyRankOneTriple P B)
    (d : EarlierLocalTheorems (family P))
    {beta : Vertex (family P)}
    (hb : 6 < b (family P))
    (a' : Vertex (family P)) :
    IsElementaryAbelian 2 ((V (family P) beta 3 ⊓ Q (family P) a') : Subgroup G) := by
  let := finite_endpoints h
  let hZ : ∀ v : Vertex (family P), Z (family P) v ≤
      omegaCenterIn (Q (family P) v) := fun v => (source_Z_Q_U h v).1
  let hS : ∀ v : Vertex (family P), ∃ T : Sylow 2 (U (family P) v),
      (T : Subgroup (U (family P) v)).map (U (family P) v).subtype = Q (family P) v :=
    d.kernel_sylow
  let : IsElementaryAbelian 2 (V (family P) beta 3) :=
    CFSG.Quasithin.ChapterF.Source.DGS85.CommutingTrivial.V_elementary
      (family P) h.generate hZ hS beta (by omega)
  exact IsElementaryAbelian.of_le inf_le_left

theorem reduced_radius_three_intersection_le_edge_sylow
    {J : Fin 2 → Subgroup G} {S₀ : Subgroup G} (h : HypothesisF11 J S₀)
    (hob : ∀ v w : Vertex (Reduction.reducedFamily J S₀),
      (graph (Reduction.reducedFamily J S₀)).Adj v w →
      ¬ stabilizer (Reduction.reducedFamily J S₀) v ≤ normalizer
        ((Q (Reduction.reducedFamily J S₀) w ⊓
          Q (Reduction.reducedFamily J S₀) v : Subgroup (Reduction.G₀ J S₀)) :
          Set (Reduction.G₀ J S₀)))
    {beta a' : Vertex (Reduction.reducedFamily J S₀)}
    (w : (graph (Reduction.reducedFamily J S₀)).neighborSet a')
    (R : Sylow 2 (graphLocalGroup (Reduction.reducedFamily J S₀) w.val))
    (hR : (R : Subgroup (graphLocalGroup (Reduction.reducedFamily J S₀) w.val)).map
      (graphLocalGroup (Reduction.reducedFamily J S₀) w.val).subtype =
      (stabilizer (Reduction.reducedFamily J S₀) w.val ⊓
        stabilizer (Reduction.reducedFamily J S₀) a').pCoreIn 2) :
    V (Reduction.reducedFamily J S₀) beta 3 ⊓
        Q (Reduction.reducedFamily J S₀) a' ≤
      (R : Subgroup (graphLocalGroup (Reduction.reducedFamily J S₀) w.val)).map
        (graphLocalGroup (Reduction.reducedFamily J S₀) w.val).subtype := by
  exact source_radius_three_intersection_le_edge_sylow
    (Reduction.reduced_triple h)
    (Reduction.reducedEarlierLocalTheorems h hob) w R hR

/-- A subgroup in the literal edge Sylow lies over its omega-center as soon
as its squares lie in the original vertex core. The subgroup itself need
not have exponent two. -/
theorem source_square_mod_core_le_quotient_omega
    (h : LocallyRankOneTriple P B)
    (d : EarlierLocalTheorems (family P)) (v : Vertex (family P))
    (M : IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    (R : Sylow 2 (d.localGroup v)) (A : Subgroup G)
    (hA : A ≤ (R : Subgroup (d.localGroup v)).map (d.localGroup v).subtype)
    (hsq : ∀ x ∈ A, x ^ 2 ∈ Q (family P) v) :
    A ≤ quotientSylowOmegaPreimage (d.localGroup v) R := by
  let := finite_endpoints h
  let L := d.localGroup v
  let : Finite L := Finite.of_injective (inclusion (d.local_le v)) (inclusion_injective _)
  let q := QuotientGroup.mk' (pCore 2 L)
  let S := R.mapSurjective (QuotientGroup.mk'_surjective (pCore 2 L))
  intro x hx
  obtain ⟨y, hy, he⟩ := hA hx
  have hqS : q y ∈ (S : Subgroup (L ⧸ pCore 2 L)) := mem_map_of_mem q hy
  have hycore : y ^ 2 ∈ pCore 2 L := by
    have hxcore := hsq x hx
    rw [←localGroup_core_eq (family P) d v] at hxcore
    obtain ⟨z,hz,hze⟩ := hxcore
    exact (Subtype.ext (hze.trans (congrArg (fun t : G => t ^ 2) he.symm)) : z = y ^ 2) ▸ hz
  have hq2 : (q y) ^ 2 = 1 := by
    rw [←map_pow]
    exact (QuotientGroup.eq_one_iff _).mpr hycore
  have hcent := source_rank_one_sylow_square_central M S ⟨q y,hqS⟩ (Subtype.ext hq2)
  refine ⟨y,?_,he⟩
  apply (mem_omegaCenterIn_iff _ _).mpr
  refine ⟨hqS,?_,hq2⟩
  intro z hz
  exact congrArg Subtype.val (mem_center_iff.mp hcent ⟨z,hz⟩)

private theorem linear_sylow_square {D : Type*} [Group D] [Finite D]
    {n : ℕ} (_hn : 0 < n) (hi : ClassicalGroup.IsPSL D 2 (2 ^ n))
    (S : Sylow 2 D) (x : S) : x ^ 2 = 1 := by
  obtain ⟨K,_,_,hK,⟨eK⟩⟩ := hi
  let := Fintype.ofFinite K
  let : CharP K 2 := charP_of_card_eq_prime_pow
    (by simpa only [Nat.card_eq_fintype_card] using hK)
  let e : D ≃* SL(2,K) := eK.trans (MulEquiv.ofBijective (BenderSuzuki.Converse.pi K)
    ⟨BenderSuzuki.Converse.pi_injective,BenderSuzuki.Converse.pi_surjective⟩).symm
  let T : Sylow 2 SL(2,K) := S.mapSurjective (f := e.toMonoidHom) e.surjective
  let f : S ≃* T := (S : Subgroup D).equivMapOfInjective e.toMonoidHom e.injective
  apply f.injective
  simpa only [map_pow,map_one] using
    Matrix.SpecialLinearGroup.twoSubgroup_pow_two (T : Subgroup SL(2,K)) T.isPGroup' (f x)

private theorem small_shape_square {D : Type*} [Group D] [Finite D]
    (hshape : (∃ n : ℕ, 0 < n ∧ ClassicalGroup.IsPSL D 2 (2 ^ n)) ∨
      Nonempty (D ≃* DihedralGroup 5))
    (S : Sylow 2 D) (x : S) : x ^ 2 = 1 := by
  rcases hshape with hlin | hdih
  · obtain ⟨n,hn,hi⟩ := hlin
    exact linear_sylow_square hn hi S x
  · obtain ⟨e⟩ := hdih
    have hc : Nat.card S = 2 := by
      rw [S.card_eq_multiplicity,Nat.card_congr e.toEquiv,DihedralGroup.nat_card]
      rw [Nat.factorization_mul (by decide) (by decide),
        Nat.prime_two.factorization,Nat.prime_five.factorization]
      norm_num
    exact (congrArg (fun m : ℕ => x ^ m) hc).symm.trans (pow_card_eq_one' (x := x))

/-- The second placement of 8.4(3) for b >= 7 and for linear or dihedral
moving quotients. In the latter cases only the quotient has exponent two;
no exponent claim about the original intersection is used. -/
theorem source_radius_three_intersection_omega_of_large_or_elementary_model
    (h : LocallyRankOneTriple P B)
    (d : EarlierLocalTheorems (family P))
    {beta a' : Vertex (family P)} (w : (graph (family P)).neighborSet a')
    (M : IsRankOneModel (d.localGroup w.val ⧸ pCore 2 (d.localGroup w.val)))
    (R : Sylow 2 (d.localGroup w.val))
    (hR : (R : Subgroup (d.localGroup w.val)).map (d.localGroup w.val).subtype =
      (stabilizer (family P) w.val ⊓ stabilizer (family P) a').pCoreIn 2)
    (hcase : 6 < b (family P) ∨
      (∃ n : ℕ, 0 < n ∧ ClassicalGroup.IsPSL
        (d.localGroup w.val ⧸ pCore 2 (d.localGroup w.val)) 2 (2 ^ n)) ∨
      Nonempty ((d.localGroup w.val ⧸ pCore 2 (d.localGroup w.val)) ≃* DihedralGroup 5)) :
    V (family P) beta 3 ⊓ Q (family P) a' ≤
      quotientSylowOmegaPreimage (d.localGroup w.val) R := by
  have hA := source_radius_three_intersection_le_edge_sylow h d (beta := beta) w R hR
  rcases hcase with hb | hshape
  · let := source_radius_three_intersection_elementary_of_large h d (beta := beta) hb a'
    exact source_elementary_le_quotient_omega h d w.val M R _ hA
  · let := finite_endpoints h
    let L := d.localGroup w.val
    let : Finite L := Finite.of_injective (inclusion (d.local_le w.val)) (inclusion_injective _)
    let q := QuotientGroup.mk' (pCore 2 L)
    let S := R.mapSurjective (QuotientGroup.mk'_surjective (pCore 2 L))
    apply source_square_mod_core_le_quotient_omega h d w.val M R _ hA
    intro x hx
    obtain ⟨y,hy,he⟩ := hA hx
    have hqS : q y ∈ (S : Subgroup (L ⧸ pCore 2 L)) := mem_map_of_mem q hy
    have hsq := congrArg Subtype.val (small_shape_square hshape S ⟨q y,hqS⟩)
    change (q y) ^ 2 = 1 at hsq
    have hycore : y ^ 2 ∈ pCore 2 L := by
      apply (QuotientGroup.eq_one_iff _).mp
      change q (y ^ 2) = 1
      rwa [map_pow]
    rw [←localGroup_core_eq (family P) d w.val]
    exact ⟨y ^ 2,hycore,congrArg (fun t : G => t ^ 2) he⟩


end CFSG.Quasithin.ChapterF.Source.DGS85.CommutingNontrivial
