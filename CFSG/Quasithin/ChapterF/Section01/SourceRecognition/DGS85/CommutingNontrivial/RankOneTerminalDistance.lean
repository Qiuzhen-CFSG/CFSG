module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingNontrivial.IntersectionGeneration
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingNontrivial.RadiusThreeDistance
public import Theory.GroupAction.ConjugationSectionIndex

/-!
# Distance three for every small terminal model

The strict index below the terminal Sylow omega-center is below two for
a quotient of 2-rank one. The central-supplement argument therefore makes
the radius-three intersection generated by involutions. Its image lies
in the moving quotient omega-center for every starting model, including
Suzuki and unitary quotients at b = 5.

Source 8.3 now controls the full neighboring span. The resulting fixed
index upper bound contradicts the literal residual section's lower bound
two. The reduced F1.11 application constructs the moving neighbor and full
edge Sylow and discharges the rank bound for PSL₂(2), D₁₀, Sz(2), PSU₃(2)
and SU₃(2), preserving both original orientations and quotient maps.

Source: DGS, *Groups and Graphs* (1985), 8.4(3) and its final paragraph,
p.138. Larger terminal fields at b = 5 and the 8.5--8.7 identifications
remain separate obligations of the same source theorem family.
-/

@[expose] public noncomputable section
open Subgroup BenderSuzuki.MatrixGroups
open scoped MatrixGroups
namespace CFSG.Quasithin.ChapterF.Source.DGS85.CommutingNontrivial
open Subgroup.CosetGeometry.RankTwo Theory.GroupTheory.AmalgamGraph
variable {G : Type*} [Group G] {J : Fin 2 → Subgroup G} {S₀ : Subgroup G}

/-- The rank-one terminal intersection theorem supplies the full 8.4
commutator bound in the original reduced graph, with no restriction on the
moving local quotient. The original configuration supplies 8.3 and normality. -/
theorem reduced_radius_three_rank_one_full_span_bound
    (h : HypothesisF11 J S₀)
    (hob : ∀ v w : Vertex (Reduction.reducedFamily J S₀),
      (graph (Reduction.reducedFamily J S₀)).Adj v w →
      ¬ stabilizer (Reduction.reducedFamily J S₀) v ≤ normalizer
        ((Q (Reduction.reducedFamily J S₀) w ⊓ Q (Reduction.reducedFamily J S₀) v :
          Subgroup (Reduction.G₀ J S₀)) : Set (Reduction.G₀ J S₀)))
    (models : ∀ v : Vertex (Reduction.reducedFamily J S₀),
      IsRankOneModel (graphLocalGroup (Reduction.reducedFamily J S₀) v ⧸
        pCore 2 (graphLocalGroup (Reduction.reducedFamily J S₀) v)))
    {a beta a' : Vertex (Reduction.reducedFamily J S₀)}
    (hc : IsCriticalPair (Reduction.reducedFamily J S₀) a a')
    (hab : (graph (Reduction.reducedFamily J S₀)).Adj a beta)
    (hd : (graph (Reduction.reducedFamily J S₀)).dist beta a' + 1 = b (Reduction.reducedFamily J S₀))
    (hb : 3 < b (Reduction.reducedFamily J S₀))
    (hcomm : ⁅Z (Reduction.reducedFamily J S₀) a,Z (Reduction.reducedFamily J S₀) a'⁆ = ⊥)
    (w : (graph (Reduction.reducedFamily J S₀)).neighborSet a')
    (hm : ⁅V (Reduction.reducedFamily J S₀) beta 1 ⊓ Q (Reduction.reducedFamily J S₀) a',
      Z (Reduction.reducedFamily J S₀) w.val⁆ ≠ ⊥)
    (R : Sylow 2 (graphLocalGroup (Reduction.reducedFamily J S₀) w.val))
    (hR : (R : Subgroup (graphLocalGroup (Reduction.reducedFamily J S₀) w.val)).map
      (graphLocalGroup (Reduction.reducedFamily J S₀) w.val).subtype =
      (stabilizer (Reduction.reducedFamily J S₀) w.val ⊓
        stabilizer (Reduction.reducedFamily J S₀) a').pCoreIn 2)
    (hr : primeRank 2 (graphLocalGroup (Reduction.reducedFamily J S₀) a' ⧸
      pCore 2 (graphLocalGroup (Reduction.reducedFamily J S₀) a')) ≤ 1) :
    let F := Reduction.reducedFamily J S₀
    ⁅V F beta 3 ⊓ Q F a',V F a' 1⁆ ≤ ⁅V F beta 1 ⊓ Q F a',V F a' 1⁆ := by
  let ht := Reduction.reduced_triple h
  let F := Reduction.reducedFamily J S₀
  let d := Reduction.reducedEarlierLocalTheorems h hob
  let H := ⁅V F beta 1 ⊓ Q F a',V F a' 1⁆
  let := finite_endpoints ht
  have hb1 : 1 < b F := by change 3 < b F at hb; omega
  obtain ⟨hn,hHZ,_⟩ := source_critical_commutator_structure ht
    (Reduction.reduced_borel_core_sylow h) d hc hab hd hb1 hcomm models
  have hZL : Z F w.val ≤ d.localGroup a' :=
    ((Z_neighbor_le_V F w.property).trans
      (V_le_Q_of_dist_add_lt_b F ht.generate (fun v => (source_Z_Q_U ht v).1)
        a' a' 1 (by simpa using hb1) (d.kernel_sylow a'))).trans
      ((pCoreIn_le_sylow (stabilizer F a') default).trans (d.sylow_le a' default))
  have hn' : d.localGroup a' ≤ normalizer (H : Set (Reduction.G₀ J S₀)) :=
    (normal_subgroupOf_iff_le_normalizer ((hHZ w).trans hZL)).mp hn
  have hne : H ≠ ⊥ := by
    intro hz
    exact hm (bot_unique ((commutator_mono le_rfl (Z_neighbor_le_V F w.property)).trans hz.le))
  have hgen := (source_radius_three_intersection_generated_of_rank_one ht
    (Reduction.reduced_borel_core_sylow h) d hob models hc hab hd hb hcomm hne hr).2
  exact source_radius_three_full_span_bound_of_involution_generated ht d hb1 w
    (models w.val) R hR hgen H hn'
    (reduced_moving_omega_commutator h hob models hc hab hd hb1 hcomm w hm R hR)

/-- The original residual denominator has index at least two after the
rank-one terminal intersection placement has been discharged. -/
private theorem rank_one_denominator_lower
    (h : HypothesisF11 J S₀)
    (hob : ∀ v w : Vertex (Reduction.reducedFamily J S₀),
      (graph (Reduction.reducedFamily J S₀)).Adj v w →
      ¬ stabilizer (Reduction.reducedFamily J S₀) v ≤ normalizer
        ((Q (Reduction.reducedFamily J S₀) w ⊓ Q (Reduction.reducedFamily J S₀) v :
          Subgroup (Reduction.G₀ J S₀)) : Set (Reduction.G₀ J S₀)))
    (models : ∀ v : Vertex (Reduction.reducedFamily J S₀),
      IsRankOneModel (graphLocalGroup (Reduction.reducedFamily J S₀) v ⧸
        pCore 2 (graphLocalGroup (Reduction.reducedFamily J S₀) v)))
    {a beta a' : Vertex (Reduction.reducedFamily J S₀)}
    (hc : IsCriticalPair (Reduction.reducedFamily J S₀) a a')
    (hab : (graph (Reduction.reducedFamily J S₀)).Adj a beta)
    (hd : (graph (Reduction.reducedFamily J S₀)).dist beta a' + 1 = b (Reduction.reducedFamily J S₀))
    (hb : 3 < b (Reduction.reducedFamily J S₀))
    (hcomm : ⁅Z (Reduction.reducedFamily J S₀) a,Z (Reduction.reducedFamily J S₀) a'⁆ = ⊥)
    (w : (graph (Reduction.reducedFamily J S₀)).neighborSet a')
    (hm : ⁅V (Reduction.reducedFamily J S₀) beta 1 ⊓ Q (Reduction.reducedFamily J S₀) a',
      Z (Reduction.reducedFamily J S₀) w.val⁆ ≠ ⊥)
    (R : Sylow 2 (graphLocalGroup (Reduction.reducedFamily J S₀) w.val))
    (hR : (R : Subgroup (graphLocalGroup (Reduction.reducedFamily J S₀) w.val)).map
      (graphLocalGroup (Reduction.reducedFamily J S₀) w.val).subtype =
      (stabilizer (Reduction.reducedFamily J S₀) w.val ⊓
        stabilizer (Reduction.reducedFamily J S₀) a').pCoreIn 2)
    (hr : primeRank 2 (graphLocalGroup (Reduction.reducedFamily J S₀) a' ⧸
      pCore 2 (graphLocalGroup (Reduction.reducedFamily J S₀) a')) ≤ 1) :
    let F := Reduction.reducedFamily J S₀
    let W := V F beta 3
    let D := (W ⊓ Q F a') ⊔ V F beta 1
    2 ≤ D.relIndex W := by
  let ht := Reduction.reduced_triple h
  let F := Reduction.reducedFamily J S₀
  let d := Reduction.reducedEarlierLocalTheorems h hob
  let W := V F beta 3
  let V₀ := V F beta 1
  let I := W ⊓ Q F a'
  let D := I ⊔ V₀
  let A := V F a' 1
  let L := graphLocalGroup F beta
  let : ∀ i, Finite (F i) := finite_endpoints ht
  change 3 < b F at hb
  have hWP : W ≤ stabilizer F beta := V_le_stabilizer_of_dist_add_le_b F ht.generate
    beta beta 3 (by simpa using hb.le)
  let : Finite W := Finite.of_injective (inclusion hWP) (inclusion_injective _)
  have hVW : V₀ ≤ W := V_mono F beta (by decide)
  have hnV : W ≤ normalizer (V₀ : Set (Reduction.G₀ J S₀)) :=
    hWP.trans (stabilizer_normalizes_V F beta 1)
  have hnA : A ≤ normalizer (V₀ : Set (Reduction.G₀ J S₀)) :=
    (radius_one_mutual_normalization F ht.generate beta a' hd.le).2
  have hH : ⁅V₀ ⊓ Q F a',A⁆ ≤ V₀ :=
    (commutator_mono inf_le_left le_rfl).trans
      (le_normalizer_iff_commutator_le_left.mp hnA)
  have hI : ⁅I,A⁆ ≤ V₀ :=
    (reduced_radius_three_rank_one_full_span_bound h hob models hc hab hd hb hcomm w hm R hR hr).trans hH
  have hD : ⁅A,D⁆ ≤ V₀ := by
    rw [commutator_comm]
    exact commutator_sup_le_of_relative_normal W I V₀ A V₀ hnV inf_le_left hVW hI
      (le_normalizer_iff_commutator_le_left.mp hnA)
  have hne : ⁅V₀ ⊓ Q F a',A⁆ ≠ ⊥ := by
    intro hz
    exact hm (bot_unique ((commutator_mono le_rfl (Z_neighbor_le_V F w.property)).trans hz.le))
  obtain ⟨hnW,hN,α,hα,_,_,hi2,_⟩ := reduced_radius_three_residual_section.{_,0}
    h hob models hc hab hd hb hcomm hne
  let _ := hN
  have hi := quotient_conjugation_fixedIndex_le L W V₀ D A hnW α hα le_sup_right hD
  exact hi2.trans hi


/-- A terminal quotient of two-rank one gives b = 3 for every starting
model, including the previously unproved nonlinear b = 5 cases. -/
theorem reduced_rank_one_terminal_distance_three
    (h : HypothesisF11 J S₀)
    (hob : ∀ v w : Vertex (Reduction.reducedFamily J S₀),
      (graph (Reduction.reducedFamily J S₀)).Adj v w →
      ¬ stabilizer (Reduction.reducedFamily J S₀) v ≤ normalizer
        ((Q (Reduction.reducedFamily J S₀) w ⊓ Q (Reduction.reducedFamily J S₀) v :
          Subgroup (Reduction.G₀ J S₀)) : Set (Reduction.G₀ J S₀)))
    (models : ∀ v : Vertex (Reduction.reducedFamily J S₀),
      IsRankOneModel (graphLocalGroup (Reduction.reducedFamily J S₀) v ⧸
        pCore 2 (graphLocalGroup (Reduction.reducedFamily J S₀) v)))
    {a beta a' : Vertex (Reduction.reducedFamily J S₀)}
    (hc : IsCriticalPair (Reduction.reducedFamily J S₀) a a')
    (hab : (graph (Reduction.reducedFamily J S₀)).Adj a beta)
    (hd : (graph (Reduction.reducedFamily J S₀)).dist beta a' + 1 = b (Reduction.reducedFamily J S₀))
    (hb : 1 < b (Reduction.reducedFamily J S₀))
    (hcomm : ⁅Z (Reduction.reducedFamily J S₀) a,Z (Reduction.reducedFamily J S₀) a'⁆ = ⊥)
    (hne : ⁅V (Reduction.reducedFamily J S₀) beta 1 ⊓ Q (Reduction.reducedFamily J S₀) a',
      V (Reduction.reducedFamily J S₀) a' 1⁆ ≠ ⊥)
    (hr : primeRank 2 (graphLocalGroup (Reduction.reducedFamily J S₀) a' ⧸
      pCore 2 (graphLocalGroup (Reduction.reducedFamily J S₀) a')) ≤ 1) :
    b (Reduction.reducedFamily J S₀) = 3 := by
  let ht := Reduction.reduced_triple h
  let F := Reduction.reducedFamily J S₀
  let d := Reduction.reducedEarlierLocalTheorems h hob
  let : ∀ i, Finite (F i) := finite_endpoints ht
  let : Finite (d.localGroup a') :=
    Finite.of_injective (inclusion (d.local_le a')) (inclusion_injective _)
  have hb3 := (source_critical_geometry ht d hc hab hd hb hcomm).2.1
  change 3 ≤ b F at hb3
  by_contra he
  have hb' : 3 < b F := by change b F ≠ 3 at he; omega
  obtain ⟨w,hm,_⟩ := exists_moving_neighbor F (fun v => (source_Z_Q_U ht v).1) beta a' hne
  obtain ⟨R,hR⟩ := source_edge_core_local_sylow ht (Reduction.reduced_borel_core_sylow h)
    d w.property.symm
  have hl := rank_one_denominator_lower h hob models hc hab hd hb' hcomm w hm R hR hr
  obtain ⟨prev,T,_,_,_,_,_,_,_,hu⟩ := reduced_radius_three_section_index h hob models
    hc hab hd hb' hcomm hne
  let L := d.localGroup a'
  change Sylow 2 L at T
  change primeRank 2 (L ⧸ pCore 2 L) ≤ 1 at hr
  have hO := (primeRank_le_iff_elementary_card_le (L ⧸ pCore 2 L)).mp hr
    (omegaCenterIn ((T : Subgroup L).map (QuotientGroup.mk' (pCore 2 L)))) inferInstance
  norm_num only [pow_one] at hO
  exact (not_lt_of_ge hl) (hu.trans_le hO)

private theorem small_terminal_two_rank {D : Type*} [Group D] [Finite D]
    (hsmall : ClassicalGroup.IsPSL D 2 2 ∨ Nonempty (D ≃* DihedralGroup 5) ∨ Nonempty (D ≃* SuzukiMatrixGroup 0) ∨
      ClassicalGroup.IsPSU D 3 2 ∨ IsSU D 3 2) : primeRank 2 D ≤ 1 := by
  rcases hsmall with hlin | hsmall
  · obtain ⟨K,_,_,hK,⟨eK⟩⟩ := hlin
    let := Fintype.ofFinite K
    let : CharP K 2 := charP_of_card_eq_prime_pow (p := 2) (f := 1)
      (by simpa only [pow_one,Nat.card_eq_fintype_card] using hK)
    let e : D ≃* SL(2,K) := eK.trans (MulEquiv.ofBijective (BenderSuzuki.Converse.pi K)
      ⟨BenderSuzuki.Converse.pi_injective,BenderSuzuki.Converse.pi_surjective⟩).symm
    rw [primeRank_congr 2 e]
    let S : Sylow 2 SL(2,K) := default
    have hc : Nat.card S = 2 := by
      rw [←Nat.card_congr (Matrix.SpecialLinearGroup.sylowEquivAdditive K 2 S).toEquiv]
      exact hK
    exact S.primeRank_le_one_of_isCyclic (isCyclic_of_prime_card hc)
  ·
    rcases hsmall with hlin | hsuz | hpsu | hsu
    · obtain ⟨e⟩ := hlin
      rw [primeRank_congr 2 e]
      let S : Sylow 2 (DihedralGroup 5) := Sylow.ofCard
        (zpowers (DihedralGroup.sr 0 : DihedralGroup 5)) (by
          rw [Nat.card_zpowers,DihedralGroup.orderOf_sr,DihedralGroup.nat_card]
          rw [Nat.factorization_mul (by decide) (by decide),
            Nat.prime_two.factorization,Nat.prime_five.factorization]
          norm_num)
      exact S.primeRank_le_one_of_isCyclic
        (inferInstanceAs (IsCyclic (zpowers (DihedralGroup.sr 0 : DihedralGroup 5))))
    · obtain ⟨e⟩ := hsuz
      rw [primeRank_congr 2 e]
      let R := zpowers suzukiZeroRootGenerator
      have hc : Nat.card R = 2^2 := by
        rw [Nat.card_zpowers,suzukiZeroRootGenerator_order]
        rfl
      have hp : IsPGroup 2 R := IsPGroup.of_card hc
      have hi : ¬ 2 ∣ R.index := by
        have he := R.card_mul_index
        rw [show Nat.card R = 4 from hc,suzukiZero_card] at he
        have hx : R.index = 5 := by omega
        simp only [hx]
        decide
      apply (hp.toSylow hi).primeRank_le_one_of_isCyclic
      change IsCyclic R
      infer_instance
    · obtain ⟨K,_,_,J,hK,hconj,⟨e⟩⟩ := hpsu
      let : Finite (ProjectiveSpecialUnitaryMatrixGroup J) :=
        Finite.of_surjective J.specialToProjective J.specialToProjective_surjective
      rw [primeRank_congr 2 e]
      exact (HermitianForm.EvenTwoRank.two_rank J (n := 1) (by decide) hK hconj).le
    · obtain ⟨K,_,_,J,hK,hconj,⟨e⟩⟩ := hsu
      let : Finite (ProjectiveSpecialUnitaryMatrixGroup J) :=
        Finite.of_surjective J.specialToProjective J.specialToProjective_surjective
      rw [primeRank_congr 2 e,primeRank_eq_of_surjective_of_coprime 2 J.specialToProjective
        J.specialToProjective_surjective J.odd_card_specialToProjective_ker.coprime_two_left]
      exact (HermitianForm.EvenTwoRank.two_rank J (n := 1) (by decide) hK hconj).le

/-- The actual binary linear, dihedral, small Suzuki and both binary
unitary terminal markings give b = 3 for every starting quotient. No
intersection, moving-neighbor, Sylow or numerical callback remains. -/
theorem reduced_small_terminal_distance_three
    (h : HypothesisF11 J S₀)
    (hob : ∀ v w : Vertex (Reduction.reducedFamily J S₀),
      (graph (Reduction.reducedFamily J S₀)).Adj v w →
      ¬ stabilizer (Reduction.reducedFamily J S₀) v ≤ normalizer
        ((Q (Reduction.reducedFamily J S₀) w ⊓ Q (Reduction.reducedFamily J S₀) v :
          Subgroup (Reduction.G₀ J S₀)) : Set (Reduction.G₀ J S₀)))
    (models : ∀ v : Vertex (Reduction.reducedFamily J S₀),
      IsRankOneModel (graphLocalGroup (Reduction.reducedFamily J S₀) v ⧸
        pCore 2 (graphLocalGroup (Reduction.reducedFamily J S₀) v)))
    {a beta a' : Vertex (Reduction.reducedFamily J S₀)}
    (hc : IsCriticalPair (Reduction.reducedFamily J S₀) a a')
    (hab : (graph (Reduction.reducedFamily J S₀)).Adj a beta)
    (hd : (graph (Reduction.reducedFamily J S₀)).dist beta a' + 1 = b (Reduction.reducedFamily J S₀))
    (hb : 1 < b (Reduction.reducedFamily J S₀))
    (hcomm : ⁅Z (Reduction.reducedFamily J S₀) a,Z (Reduction.reducedFamily J S₀) a'⁆ = ⊥)
    (hne : ⁅V (Reduction.reducedFamily J S₀) beta 1 ⊓ Q (Reduction.reducedFamily J S₀) a',
      V (Reduction.reducedFamily J S₀) a' 1⁆ ≠ ⊥)
    (hsmall :
      let D := graphLocalGroup (Reduction.reducedFamily J S₀) a' ⧸
        pCore 2 (graphLocalGroup (Reduction.reducedFamily J S₀) a')
      ClassicalGroup.IsPSL D 2 2 ∨ Nonempty (D ≃* DihedralGroup 5) ∨
      Nonempty (D ≃* SuzukiMatrixGroup 0) ∨ ClassicalGroup.IsPSU D 3 2 ∨ IsSU D 3 2) :
    b (Reduction.reducedFamily J S₀) = 3 := by
  let ht := Reduction.reduced_triple h
  let F := Reduction.reducedFamily J S₀
  let d := Reduction.reducedEarlierLocalTheorems h hob
  let : ∀ i, Finite (F i) := finite_endpoints ht
  let : Finite (d.localGroup a') :=
    Finite.of_injective (inclusion (d.local_le a')) (inclusion_injective _)
  apply reduced_rank_one_terminal_distance_three h hob models hc hab hd hb hcomm hne
  change primeRank 2 (d.localGroup a' ⧸ pCore 2 (d.localGroup a')) ≤ 1
  exact small_terminal_two_rank hsmall

end CFSG.Quasithin.ChapterF.Source.DGS85.CommutingNontrivial
