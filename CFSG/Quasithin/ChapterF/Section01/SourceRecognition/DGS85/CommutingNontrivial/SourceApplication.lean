module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingNontrivial.Parity
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingNontrivial.Normality
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.LocalStructure.Reduced
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingNontrivial.Transport
public import Theory.GroupTheory.SylowCenterFixedSpan

/-!
# The Chapter 8 neighborhood argument on the actual source graph

The common source triple discharges the characteristic-two center and local
kernel placements. Explicit earlier local theorems give the Sylow-or-center
alternative, local transitivity, and the 6.5 obstruction. The critical-pair
argument proves oddness, the lower bound three, mutual quadratic action and
the preceding-core escape. Local generation and displacement give relative
normality of H and the centralizer Sylow obstruction at a moving neighbor.

The original Sylow-center span is also generated by its actual Sylow-fixed
subgroup. Reduced F1.11 applications use the published reduced triple and
retain all original Borel, endpoint and completion inclusions.

Source: DGS, *Groups and Graphs* (1985), 8.0--8.1, pp.132--133.
This is a partial Chapter 8 result. The earlier inputs have their original
producers; the 5.1/5.9 generation and displacement calculation in `hlocal`
remains with this owner, as do 8.2--8.7 and their marked module applications.
-/

@[expose] public noncomputable section
open Subgroup
namespace CFSG.Quasithin.ChapterF.Source.DGS85.CommutingNontrivial
open Subgroup.CosetGeometry.RankTwo
variable {G : Type*} [Group G] (F : Bool → Subgroup G)

/-- Explicit earlier-source inputs from 6.1, 6.2 and 6.5 for an equivariant
family of local groups L. This is not an encoding of Hypothesis B′ and does
not supply Chapter 8 conclusions. The setup owner constructs these inputs;
the original source assembly must discharge them. -/
structure EarlierLocalTheorems where
  localGroup : Vertex F → Subgroup G
  local_le : ∀ v, localGroup v ≤ stabilizer F v
  conjugate : ∀ g v, localGroup (g • v) = (localGroup v).map (MulAut.conj g).toMonoidHom
  sylow_le : ∀ v (T : Sylow 2 (stabilizer F v)),
    (T : Subgroup (stabilizer F v)).map (stabilizer F v).subtype ≤ localGroup v
  common_sylow : ∀ v w, (graph F).Adj v w →
    ∃ (T : Sylow 2 (stabilizer F v)) (T' : Sylow 2 (stabilizer F w)),
      (T : Subgroup (stabilizer F v)).map (stabilizer F v).subtype =
        (T' : Subgroup (stabilizer F w)).map (stabilizer F w).subtype
  kernel_sylow : ∀ v, ∃ T : Sylow 2 (U F v),
    (T : Subgroup (U F v)).map (U F v).subtype = Q F v
  sylow_or_center : ∀ v,
    (∃ T : Sylow 2 ↥(stabilizer F v ⊓ centralizer (Z F v : Set G) : Subgroup G),
      (T : Subgroup ↥(stabilizer F v ⊓ centralizer (Z F v : Set G) : Subgroup G)).map
        (stabilizer F v ⊓ centralizer (Z F v : Set G)).subtype = Q F v) ∨
      Z F v = omegaCenterIn (localGroup v)
  transitive : ∀ v (x y : (graph F).neighborSet v),
    ∃ g ∈ localGroup v, g • x.val = y.val
  core_span_obstruction : ∀ v w, (graph F).Adj v w →
    ¬ ∃ T : Sylow 2 (conjugateSpanBy (Q F w) (localGroup v)),
      (T : Subgroup (conjugateSpanBy (Q F w) (localGroup v))).map
        (conjugateSpanBy (Q F w) (localGroup v)).subtype = Q F w

/-- The same original Z is generated by its actual Sylow-fixed subgroup.
This removes the group-level generation premise needed before applying the
corrected 5.12 to a representation of this source module. -/
theorem source_center_fixed_generation
    {P : Fin 2 → Subgroup G} {B : Subgroup G} (h : LocallyRankOneTriple P B)
    (d : EarlierLocalTheorems (family P)) (v : Vertex (family P))
    (T : Sylow 2 (stabilizer (family P) v)) :
    conjugateSpanBy (Z (family P) v ⊓
      centralizer (((T : Subgroup (stabilizer (family P) v)).map
        (stabilizer (family P) v).subtype : Subgroup G) : Set G)) (d.localGroup v) =
          Z (family P) v := by
  let := finite_endpoints h
  exact Theory.GroupTheory.AmalgamGraph.sylowCenterSpan_generated_by_sylow_fixed
    (stabilizer (family P) v) (d.localGroup v) (d.local_le v) (d.sylow_le v) T

/-- Fixed-subgroup generation on the original reduced F1.11 graph, using
its literal stabilizer Sylow and the unchanged source center span. -/
theorem reduced_center_fixed_generation
    {J : Fin 2 → Subgroup G} {S : Subgroup G} (h : HypothesisF11 J S)
    (d : EarlierLocalTheorems (Reduction.reducedFamily J S))
    (v : Vertex (Reduction.reducedFamily J S))
    (T : Sylow 2 (stabilizer (Reduction.reducedFamily J S) v)) :
    conjugateSpanBy (Z (Reduction.reducedFamily J S) v ⊓
      centralizer (((T : Subgroup (stabilizer (Reduction.reducedFamily J S) v)).map
        (stabilizer (Reduction.reducedFamily J S) v).subtype : Subgroup (Reduction.G₀ J S)) :
          Set (Reduction.G₀ J S))) (d.localGroup v) = Z (Reduction.reducedFamily J S) v :=
  source_center_fixed_generation (Reduction.reduced_triple h) d v T

/-- The common source triple supplies the geometric conclusions of 8.1(a,d,e)
from the literal earlier local theorems, without a separate generation premise. -/
theorem source_critical_geometry
    {P : Fin 2 → Subgroup G} {B : Subgroup G} (h : LocallyRankOneTriple P B)
    (d : EarlierLocalTheorems (family P))
    {a beta a' : Vertex (family P)} (hc : IsCriticalPair (family P) a a')
    (hab : (graph (family P)).Adj a beta)
    (hd : (graph (family P)).dist beta a' + 1 = b (family P))
    (hb : 1 < b (family P)) (hcomm : ⁅Z (family P) a, Z (family P) a'⁆ = ⊥) :
    Odd (b (family P)) ∧ 3 ≤ b (family P) ∧
      Z (family P) beta = omegaCenterIn (d.localGroup beta) ∧
      (⁅⁅V (family P) beta 1, V (family P) a' 1⁆, V (family P) beta 1⁆ = ⊥ ∧
        ⁅⁅V (family P) beta 1, V (family P) a' 1⁆, V (family P) a' 1⁆ = ⊥) ∧
      ∃ prev : Vertex (family P), (graph (family P)).Adj a' prev ∧
        (graph (family P)).dist beta prev + 1 = (graph (family P)).dist beta a' ∧
        V (family P) beta 1 ≤ Q (family P) prev ∧ ¬ Q (family P) prev ≤ Q (family P) a' := by
  let := finite_endpoints h
  have hZ := fun v => (source_Z_Q_U h v).1
  have hQU := fun v => (source_Z_Q_U h v).2
  obtain ⟨_, hodd, hb3, hcenter⟩ := commuting_critical_parity (family P) h.generate hZ hQU
    d.localGroup d.conjugate d.sylow_le hc hab hd hb hcomm
    (d.common_sylow a beta hab) (d.sylow_or_center a')
  exact ⟨hodd, hb3, hcenter,
    radius_one_mutual_quadratic (family P) h.generate hZ d.kernel_sylow beta a' hd.le hb3,
    exists_previous_core_escape (family P) h.generate hZ hQU d.kernel_sylow hc hab hd hb⟩

/-- Literal F1.11 reduced-graph application. The full reduced Borel and the
reduced-to-original maps remain exactly those in `LocalStructure.Reduced`.
Only the independently owned earlier local theorems remain inputs. -/
theorem reduced_critical_geometry
    {J : Fin 2 → Subgroup G} {S : Subgroup G} (h : HypothesisF11 J S)
    (d : EarlierLocalTheorems (Reduction.reducedFamily J S))
    {a beta a' : Vertex (Reduction.reducedFamily J S)}
    (hc : IsCriticalPair (Reduction.reducedFamily J S) a a')
    (hab : (graph (Reduction.reducedFamily J S)).Adj a beta)
    (hd : (graph (Reduction.reducedFamily J S)).dist beta a' + 1 = b (Reduction.reducedFamily J S))
    (hb : 1 < b (Reduction.reducedFamily J S))
    (hcomm : ⁅Z (Reduction.reducedFamily J S) a, Z (Reduction.reducedFamily J S) a'⁆ = ⊥) :
    Odd (b (Reduction.reducedFamily J S)) ∧ 3 ≤ b (Reduction.reducedFamily J S) ∧
      Z (Reduction.reducedFamily J S) beta = omegaCenterIn (d.localGroup beta) ∧
      (⁅⁅V (Reduction.reducedFamily J S) beta 1, V (Reduction.reducedFamily J S) a' 1⁆,
          V (Reduction.reducedFamily J S) beta 1⁆ = ⊥ ∧
        ⁅⁅V (Reduction.reducedFamily J S) beta 1, V (Reduction.reducedFamily J S) a' 1⁆,
          V (Reduction.reducedFamily J S) a' 1⁆ = ⊥) ∧
      ∃ prev : Vertex (Reduction.reducedFamily J S), (graph (Reduction.reducedFamily J S)).Adj a' prev ∧
        (graph (Reduction.reducedFamily J S)).dist beta prev + 1 =
          (graph (Reduction.reducedFamily J S)).dist beta a' ∧
        V (Reduction.reducedFamily J S) beta 1 ≤ Q (Reduction.reducedFamily J S) prev ∧
          ¬ Q (Reduction.reducedFamily J S) prev ≤ Q (Reduction.reducedFamily J S) a' :=
  source_critical_geometry (Reduction.reduced_triple h) d hc hab hd hb hcomm

/-- Actual common-source application of 8.0 and the normality/core obstruction
part of 8.1. The only Chapter 8 premise still explicit is the local generation
and displacement calculation, to be established here from 5.1 and 5.9.
The critical pair is arbitrary, so the result also applies after reorientation. -/
theorem source_critical_neighborhood
    {P : Fin 2 → Subgroup G} {B : Subgroup G} (h : LocallyRankOneTriple P B)
    (d : EarlierLocalTheorems (family P))
    {a beta a' : Vertex (family P)} (hc : IsCriticalPair (family P) a a')
    (hab : (graph (family P)).Adj a beta)
    (hd : (graph (family P)).dist beta a' + 1 = b (family P))
    (hb : 1 < b (family P)) (hcomm : ⁅Z (family P) a, Z (family P) a'⁆ = ⊥)
    (hne : ⁅V (family P) beta 1 ⊓ Q (family P) a', V (family P) a' 1⁆ ≠ ⊥)
    (hlocal : ∀ w : (graph (family P)).neighborSet a',
      ⁅V (family P) beta 1 ⊓ Q (family P) a', Z (family P) w.val⁆ ≠ ⊥ →
      ∃ T : Sylow 2 ↥(stabilizer (family P) a' ⊓ stabilizer (family P) w.val : Subgroup G),
        V (family P) beta 1 ⊔
          (T : Subgroup ↥(stabilizer (family P) a' ⊓ stabilizer (family P) w.val : Subgroup G)).map
            (stabilizer (family P) a' ⊓ stabilizer (family P) w.val).subtype = d.localGroup a' ∧
        ⁅(T : Subgroup ↥(stabilizer (family P) a' ⊓ stabilizer (family P) w.val : Subgroup G)).map
          (stabilizer (family P) a' ⊓ stabilizer (family P) w.val).subtype,
          V (family P) beta 1 ⊓ Q (family P) a'⁆ ≤ Q (family P) w.val) :
    a.type ≠ a'.type ∧ Odd (b (family P)) ∧ 3 ≤ b (family P) ∧
      Z (family P) beta = omegaCenterIn (d.localGroup beta) ∧
      (⁅⁅V (family P) beta 1, V (family P) a' 1⁆, V (family P) beta 1⁆ = ⊥ ∧
        ⁅⁅V (family P) beta 1, V (family P) a' 1⁆, V (family P) a' 1⁆ = ⊥) ∧
      ((⁅V (family P) beta 1 ⊓ Q (family P) a', V (family P) a' 1⁆).subgroupOf
        (d.localGroup a')).Normal ∧
      ∃ w : (graph (family P)).neighborSet a',
        ⁅V (family P) beta 1 ⊓ Q (family P) a', Z (family P) w.val⁆ ≠ ⊥ ∧
        ¬ V (family P) beta 1 ⊓ Q (family P) a' ≤ Q (family P) w.val ∧
        ⁅V (family P) beta 1 ⊓ Q (family P) a', V (family P) a' 1⁆ ≤ Z (family P) w.val ∧
        ¬ ∃ T : Sylow 2 ↥(d.localGroup a' ⊓ centralizer
          ((⁅V (family P) beta 1 ⊓ Q (family P) a', V (family P) a' 1⁆ : Subgroup G) : Set G) : Subgroup G),
          (T : Subgroup ↥(d.localGroup a' ⊓ centralizer
            ((⁅V (family P) beta 1 ⊓ Q (family P) a', V (family P) a' 1⁆ : Subgroup G) : Set G) : Subgroup G)).map
            (d.localGroup a' ⊓ centralizer
              ((⁅V (family P) beta 1 ⊓ Q (family P) a', V (family P) a' 1⁆ : Subgroup G) : Set G)).subtype =
                Q (family P) w.val := by
  let := finite_endpoints h
  have hZ := fun v => (source_Z_Q_U h v).1
  have hQU := fun v => (source_Z_Q_U h v).2
  obtain ⟨htype, hodd, hb3, hcenter⟩ := commuting_critical_parity (family P) h.generate hZ hQU
    d.localGroup d.conjugate d.sylow_le hc hab hd hb hcomm
    (d.common_sylow a beta hab) (d.sylow_or_center a')
  have hQL : Q (family P) a' ≤ d.localGroup a' :=
    (pCoreIn_le_sylow (stabilizer (family P) a') default).trans (d.sylow_le a' default)
  obtain ⟨hn, hbound, _, hobs⟩ := radius_one_commutator_normality (family P)
    h.generate hZ hQU d.kernel_sylow beta a' hd.le hb3 (d.localGroup a') hQL
    (d.transitive a') hlocal
  obtain ⟨w, hw, he⟩ := exists_moving_neighbor (family P) hZ beta a' hne
  obtain ⟨T, hT, _⟩ := hlocal w hw
  have hQw : Q (family P) w.val ≤ d.localGroup a' := by
    apply le_trans _ (le_sup_right.trans hT.le)
    apply (le_pCoreIn_of_normalizes (isPGroup_pCoreIn 2 (stabilizer (family P) w.val))
      (le_inf ((hQU w.val).trans
          ((ballKernel_one_le_edge (family P) w.property.symm).trans inf_le_right))
        (Q_le_stabilizer (family P) w.val))
      (inf_le_right.trans (stabilizer_normalizes_Q (family P) w.val))).trans
        (pCoreIn_le_sylow _ T)
  exact ⟨htype, hodd, hb3, hcenter,
    radius_one_mutual_quadratic (family P) h.generate hZ d.kernel_sylow beta a' hd.le hb3,
    hn, w, hw, he, hbound w, hobs w hQw (d.core_span_obstruction a' w.val w.property)⟩

end CFSG.Quasithin.ChapterF.Source.DGS85.CommutingNontrivial
