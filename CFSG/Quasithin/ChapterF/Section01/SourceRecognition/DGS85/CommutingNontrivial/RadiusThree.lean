module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingNontrivial.LocalGeneration

/-!
# Radius-three core control in the nontrivial commuting branch

A short center span is a two-subgroup and centralizes a span whenever the
sum of their radii is below the critical distance. For b > 3 this places
W = V_beta^(3) in the local group two steps before the critical endpoint,
inside the core three steps before it, and in the centralizer of H.

A nonzero subgroup normal at one endpoint has its normalizer on the other
side trapped in the edge: otherwise the two actual local transitivity
witnesses contradict faithfulness. Distinct Sylows of the original rank-one
quotient intersect trivially, so every two-subgroup fixing two neighbors
lies in the vertex core. These facts give W intersect L_(alpha'-1) <= Q_(alpha'-1).
Sylow conjugacy inside the literal group generated by W and Q_(alpha'-1)
then transports its core intersection along the chosen geodesic.

Source: DGS, *Groups and Graphs* (1985), 3.2(c), 5.1(c,d), and the opening
of 8.4(1), printed pp.72,104--105,137. `RadiusThreeApplication` supplies the
original 6.5 obstruction and the reduced F1.11 consumer. The full containment
W <= Q_(alpha'-1) and the distance-three conclusion remain separate steps.
-/

@[expose] public noncomputable section
open Subgroup
namespace CFSG.Quasithin.ChapterF.Source.DGS85.CommutingNontrivial
open Subgroup.CosetGeometry.RankTwo Theory.GroupTheory.AmalgamGraph

/-- Distinct Sylows of a core-free binary source model have trivial intersection. -/
theorem source_rank_one_sylow_inf_eq_bot
    {D : Type*} [Group D] [Finite D] (M : IsRankOneModel D)
    (hcore : pCore 2 D = ⊥) (S T : Sylow 2 D) (hne : S ≠ T) :
    (S : Subgroup D) ⊓ T = ⊥ := by
  by_contra hn
  let A : Subgroup D := (S : Subgroup D) ⊓ T
  let : Nontrivial A := (Subgroup.nontrivial_iff_ne_bot A).mpr hn
  have hp : IsPGroup 2 A := S.isPGroup'.to_le inf_le_left
  obtain ⟨n, hn, hcard⟩ := hp.nontrivial_iff_card.mp inferInstance
  obtain ⟨x, hx⟩ := exists_prime_orderOf_dvd_card' (G := A) 2
    (hcard ▸ dvd_pow_self 2 (by omega))
  apply hne
  apply source_rank_one_sylow_eq_of_common_involution M hcore S T x x.property.1 x.property.2
  · intro he
    have hx1 : x = 1 := Subtype.ext he
    rw [hx1, orderOf_one] at hx
    omega
  · exact congrArg Subtype.val (hx ▸ pow_orderOf_eq_one x)

/-- Equality of quotient Sylows lifts through the original two-core. -/
private theorem local_sylow_map_injective {L : Type*} [Group L] [Finite L]
    (S T : Sylow 2 L)
    (he : S.mapSurjective (QuotientGroup.mk'_surjective (pCore 2 L)) =
      T.mapSurjective (QuotientGroup.mk'_surjective (pCore 2 L))) : S = T := by
  apply Sylow.ext
  have hh := congrArg (fun R : Sylow 2 (L ⧸ pCore 2 L) =>
    (R : Subgroup _).comap (QuotientGroup.mk' (pCore 2 L))) he
  change ((S : Subgroup L).map (QuotientGroup.mk' (pCore 2 L))).comap _ =
    ((T : Subgroup L).map (QuotientGroup.mk' (pCore 2 L))).comap _ at hh
  simpa only [comap_map_eq, QuotientGroup.ker_mk',
    sup_eq_left.mpr (pCore_isPGroup.le_sylow_of_normal S),
    sup_eq_left.mpr (pCore_isPGroup.le_sylow_of_normal T)] using hh

/-- The intersection of distinct local Sylows is precisely the original core. -/
theorem local_sylow_inf_eq_core {L : Type*} [Group L] [Finite L]
    (M : IsRankOneModel (L ⧸ pCore 2 L)) (S T : Sylow 2 L) (hne : S ≠ T) :
    (S : Subgroup L) ⊓ T = pCore 2 L := by
  apply le_antisymm
  · let q := QuotientGroup.mk' (pCore 2 L)
    have he := source_rank_one_sylow_inf_eq_bot M (pCore_quotient_pCore_eq_bot 2)
      (S.mapSurjective (QuotientGroup.mk'_surjective _))
      (T.mapSurjective (QuotientGroup.mk'_surjective _))
      (fun he => hne (local_sylow_map_injective S T he))
    intro x hx
    apply (QuotientGroup.eq_one_iff x).mp
    apply mem_bot.mp
    rw [← he]
    exact ⟨mem_map_of_mem q hx.1, mem_map_of_mem q hx.2⟩
  · exact le_inf (pCore_isPGroup.le_sylow_of_normal S)
      (pCore_isPGroup.le_sylow_of_normal T)

variable {G : Type*} [Group G] {P : Fin 2 → Subgroup G} {B : Subgroup G}

/-- A two-subgroup fixing two distinct neighbors lies in Q, even when it is
not elementary. The two full edge Sylows and their quotient maps are literal. -/
theorem source_two_neighbor_pGroup_le_core (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    {v w z : Vertex (family P)} (hvw : (graph (family P)).Adj v w)
    (hvz : (graph (family P)).Adj v z) (hwz : w ≠ z)
    (M : IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    (A : Subgroup G) (hp : IsPGroup 2 A)
    (hv : A ≤ stabilizer (family P) v) (hw : A ≤ stabilizer (family P) w)
    (hz : A ≤ stabilizer (family P) z) : A ≤ Q (family P) v := by
  let := finite_endpoints h
  let F := family P
  let L := d.localGroup v
  let : Finite L := Finite.of_injective (inclusion (d.local_le v)) (inclusion_injective _)
  let : Finite ↥(stabilizer F v ⊓ stabilizer F w : Subgroup G) :=
    Finite.of_injective (inclusion (show stabilizer F v ⊓ stabilizer F w ≤
      stabilizer F v from inf_le_left)) (inclusion_injective _)
  let : Finite ↥(stabilizer F v ⊓ stabilizer F z : Subgroup G) :=
    Finite.of_injective (inclusion (show stabilizer F v ⊓ stabilizer F z ≤
      stabilizer F v from inf_le_left)) (inclusion_injective _)
  obtain ⟨S, hS⟩ := source_edge_core_local_sylow h hB d hvw
  obtain ⟨T, hT⟩ := source_edge_core_local_sylow h hB d hvz
  have hAS : A ≤ (S : Subgroup L).map L.subtype := by
    rw [hS]
    exact pGroup_le_core_of_core_sylow _ A (le_inf hv hw) hp
      (source_edge_core_sylow h hB hvw)
  have hAT : A ≤ (T : Subgroup L).map L.subtype := by
    rw [hT]
    exact pGroup_le_core_of_core_sylow _ A (le_inf hv hz) hp
      (source_edge_core_sylow h hB hvz)
  have hne : S ≠ T := by
    intro he
    apply hwz
    exact source_edge_sylow_unique_neighbor h d hvz hvw M T hT (by
      rw [← he, hS]
      exact (pCoreIn_le 2 _).trans inf_le_right)
  intro x hx
  obtain ⟨s, hs, rfl⟩ := hAS hx
  obtain ⟨t, ht, he⟩ := hAT hx
  have hst : t = s := Subtype.ext he
  have hc : s ∈ pCore 2 L := (local_sylow_inf_eq_core M S T hne) ▸ ⟨hs, hst ▸ ht⟩
  rw [← localGroup_core_eq F d v]
  exact mem_map_of_mem L.subtype hc

/-- Short spans about one vertex centralize each other within the sum of their radii. -/
theorem radius_spans_centralize (F : Bool → Subgroup G)
    (hgen : F false ⊔ F true = ⊤)
    (hZ : ∀ v, Z F v ≤ omegaCenterIn (Q F v))
    (hSyl : ∀ w, ∃ T : Sylow 2 (U F w),
      (T : Subgroup (U F w)).map (U F w).subtype = Q F w)
    (v : Vertex F) (m n : ℕ) (hmn : m + n < b F) :
    V F v m ≤ centralizer (V F v n : Set G) := by
  apply iSup_le
  intro x
  apply iSup_le
  intro hx
  have hdx := (mem_ball_iff F hgen v x m).mp hx
  have hnQ : V F v n ≤ Q F x :=
    V_le_Q_of_dist_add_lt_b F hgen hZ v x n (by omega) (hSyl x)
  exact (Z_centralizes_Q F x (hZ x)).trans (centralizer_le hnQ)

/-- A nonzero subgroup normal in one local actor can only be normalized by
the marked edge on the other side. Both local transitivity witnesses enter
the faithful-graph contradiction. -/
theorem source_local_normalizer_le_edge (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    {v w : Vertex (family P)} (hvw : (graph (family P)).Adj v w)
    (M : IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    (H : Subgroup G) (hH : H ≤ stabilizer (family P) v ⊓ stabilizer (family P) w)
    (hne : H ≠ ⊥) (hn : d.localGroup w ≤ normalizer (H : Set G)) :
    d.localGroup v ⊓ normalizer (H : Set G) ≤ stabilizer (family P) w := by
  let := finite_endpoints h
  let F := family P
  let L := d.localGroup v
  let N := L ⊓ normalizer (H : Set G)
  let : Finite L := Finite.of_injective (inclusion (d.local_le v)) (inclusion_injective _)
  obtain ⟨R, hR⟩ := source_edge_core_local_sylow h hB d hvw
  obtain ⟨T, hT⟩ := source_edge_core_local_sylow h hB d hvw.symm
  have hRw : (R : Subgroup L).map L.subtype ≤ d.localGroup w := by
    rw [hR, inf_comm, ← hT]
    exact map_subtype_le _
  have hRN : (R : Subgroup L).map L.subtype ≤ N :=
    le_inf (map_subtype_le _) (hRw.trans hn)
  rcases relative_rankOne_overgroup L N (inf_le_left.trans L.le_normalizer) R
    (fun A hRA hA => (rankOneSylowFacts_of_quotient R
      (M.rankOneSylowFacts _)).unique_maximal A hRA (lt_top_iff_ne_top.mpr hA))
    hRN with hLN | hN
  · have hnorm : L ≤ normalizer (H : Set G) := hLN.trans inf_le_right
    apply False.elim
    apply hne
    apply source_normalized_edge_eq_bot h hvw H hH
    · intro z hz
      obtain ⟨g, hg, hgz⟩ := d.transitive v ⟨w, hvw⟩ ⟨z, hz⟩
      exact ⟨g, hnorm hg, hgz⟩
    · intro z hz
      obtain ⟨g, hg, hgz⟩ := d.transitive w ⟨v, hvw.symm⟩ ⟨z, hz⟩
      exact ⟨g, hn hg, hgz⟩
  · exact ((le_inf (inf_le_left.trans (d.local_le v)) hN).trans_eq
      (source_edge_local_normalizer h d hvw M R hR).1).trans inf_le_right

/-- A two-subgroup sharing an escaping subgroup with the neighboring core
lies in that neighbor's full stabilizer. No exponent assumption is needed. -/
theorem source_pGroup_le_edge_of_core_escape (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    {v w : Vertex (family P)} (hvw : (graph (family P)).Adj v w)
    (M : IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    (A U₀ : Subgroup G) (hp : IsPGroup 2 A) (hAL : A ≤ d.localGroup v)
    (hUA : U₀ ≤ A) (hUQ : U₀ ≤ Q (family P) w) (he : ¬ U₀ ≤ Q (family P) v) :
    A ≤ stabilizer (family P) w := by
  let := finite_endpoints h
  let F := family P
  let L := d.localGroup v
  let : Finite L := Finite.of_injective (inclusion (d.local_le v)) (inclusion_injective _)
  obtain ⟨R, hR⟩ := source_edge_core_local_sylow h hB d hvw
  obtain ⟨T, hT⟩ := (hp.comap_subtype (K := L)).exists_le_sylow
  have hAT : A ≤ (T : Subgroup L).map L.subtype := fun x hx =>
    ⟨⟨x, hAL hx⟩, hT hx, rfl⟩
  have hUR : U₀ ≤ (R : Subgroup L).map L.subtype := by
    rw [hR]
    exact hUQ.trans (by simpa only [inf_comm] using Noncommuting.graph_Q_le_edgeCore h hvw.symm)
  have hRT : R = T := by
    by_contra hne
    apply he
    intro x hx
    obtain ⟨r, hr, rfl⟩ := hUR hx
    obtain ⟨t, ht, het⟩ := hAT (hUA hx)
    have htr : t = r := Subtype.ext het
    have hc : r ∈ pCore 2 L := (local_sylow_inf_eq_core M R T hne) ▸ ⟨hr, htr ▸ ht⟩
    rw [← localGroup_core_eq F d v]
    exact mem_map_of_mem L.subtype hc
  rw [← hRT, hR] at hAT
  exact hAT.trans ((pCoreIn_le 2 _).trans inf_le_right)

/-- On a two-edge path, a group normalizing the endpoint's nonzero normal
subgroup has the middle vertex core as a Sylow, provided that core escapes
the other vertex core. This is the literal Sylow step in 8.4(1). -/
theorem source_core_sylow_of_normalizing_subgroup (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    {v w z : Vertex (family P)} (hvw : (graph (family P)).Adj v w)
    (hwz : (graph (family P)).Adj w z) (hvz : v ≠ z)
    (Mv : IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    (Mw : IsRankOneModel (d.localGroup w ⧸ pCore 2 (d.localGroup w)))
    (X H : Subgroup G) (hXL : X ≤ d.localGroup v) (hQX : Q (family P) w ≤ X)
    (he : ¬ Q (family P) w ≤ Q (family P) v)
    (hH : H ≤ stabilizer (family P) w ⊓ stabilizer (family P) z)
    (hne : H ≠ ⊥) (hn : d.localGroup z ≤ normalizer (H : Set G))
    (hXH : X ≤ normalizer (H : Set G)) :
    ∃ S : Sylow 2 X, (S : Subgroup X).map X.subtype = Q (family P) w := by
  let := finite_endpoints h
  let F := family P
  obtain ⟨S, hS⟩ := ((isPGroup_pCoreIn 2 (stabilizer F w)).comap_subtype (K := X)).exists_le_sylow
  let A := (S : Subgroup X).map X.subtype
  have hQA : Q F w ≤ A := fun x hx => ⟨⟨x, hQX hx⟩, hS hx, rfl⟩
  have hAX : A ≤ X := map_subtype_le _
  have hp : IsPGroup 2 A := S.isPGroup'.map _
  have hAw := source_pGroup_le_edge_of_core_escape h hB d hvw Mv A (Q F w)
    hp (hAX.trans hXL) hQA le_rfl he
  have hALw := pGroup_le_localGroup F d w A hp hAw
  have hAz : A ≤ stabilizer F z :=
    (le_inf hALw (hAX.trans hXH)).trans
      (source_local_normalizer_le_edge h hB d hwz Mw H hH hne hn)
  exact ⟨S, le_antisymm
    (source_two_neighbor_pGroup_le_core h hB d hvw.symm hwz hvz Mw A hp hAw
      (hAX.trans (hXL.trans (d.local_le v))) hAz) hQA⟩

/-- Sylow conjugacy inside the actual subgroup transports its marked core
to a second neighbor detected by an escaping two-subgroup. Consequently the
original core intersection lies in that second neighbor's core. -/
theorem source_core_intersection_le_third_core (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    {v w z : Vertex (family P)} (hvw : (graph (family P)).Adj v w)
    (hvz : (graph (family P)).Adj v z)
    (M : IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    (X A : Subgroup G) (hXL : X ≤ d.localGroup v)
    (S : Sylow 2 X) (hS : (S : Subgroup X).map X.subtype = Q (family P) w)
    (hp : IsPGroup 2 A) (hAX : A ≤ X) (hAQ : A ≤ Q (family P) z)
    (he : ¬ A ≤ Q (family P) v) :
    Q (family P) w ⊓ Q (family P) v ≤ Q (family P) z := by
  let := finite_endpoints h
  let F := family P
  let : Finite X := Finite.of_injective (inclusion (hXL.trans (d.local_le v))) (inclusion_injective _)
  obtain ⟨T, hT⟩ := (hp.comap_subtype (K := X)).exists_le_sylow
  let D := (T : Subgroup X).map X.subtype
  have hAD : A ≤ D := fun x hx => ⟨⟨x, hAX hx⟩, hT hx, rfl⟩
  have hDL : D ≤ d.localGroup v := (map_subtype_le _).trans hXL
  have hDz := source_pGroup_le_edge_of_core_escape h hB d hvz M D A
    (T.isPGroup'.map _) hDL hAD hAQ he
  obtain ⟨g, hg⟩ := MulAction.exists_smul_eq X S T
  have hD : D = Q F ((g : G) • w) := by
    change (T : Subgroup X).map X.subtype = _
    rw [← hg]
    change ((S : Subgroup X).map (MulAut.conj g).toMonoidHom).map X.subtype = _
    rw [map_map]
    have heq : X.subtype.comp (MulAut.conj g).toMonoidHom =
        (MulAut.conj (g : G)).toMonoidHom.comp X.subtype := by ext x; rfl
    rw [heq, ← map_map, hS, ← Q_translate]
  have hvgw : (graph F).Adj v ((g : G) • w) := by
    have hh := (Subgroup.CosetGeometry.translationGraphIso F (g : G)).map_adj_iff.mpr hvw
    change (graph F).Adj ((g : G) • v) ((g : G) • w) at hh
    rwa [show (g : G) • v = v from d.local_le v (hXL g.property)] at hh
  have hgw : (g : G) • w = z := by
    by_contra hne
    apply he
    exact hAD.trans (source_two_neighbor_pGroup_le_core h hB d hvgw hvz hne M
      D (T.isPGroup'.map _) (hDL.trans (d.local_le v))
      (hD.le.trans (Q_le_stabilizer F _)) hDz)
  rw [hgw] at hD
  have hQX : Q F w ≤ X := hS ▸ map_subtype_le _
  have hcore : Q F w ⊓ Q F v ≤ X.pCoreIn 2 := by
    rw [← localGroup_core_eq F d v]
    exact (inf_le_inf_right _ hQX).trans (inf_pCoreIn_le_of_le 2 hXL)
  exact hcore.trans ((pCoreIn_le_sylow X T).trans_eq hD)

/-- The opening geometry of 8.4, including an actual three-step geodesic tail.
No assertion that the entire radius-three span is elementary is used. -/
theorem source_radius_three_opening (h : LocallyRankOneTriple P B)
    (d : EarlierLocalTheorems (family P))
    {a beta a' : Vertex (family P)} (hc : IsCriticalPair (family P) a a')
    (hab : (graph (family P)).Adj a beta)
    (hd : (graph (family P)).dist beta a' + 1 = b (family P))
    (hb : 3 < b (family P)) (hcomm : ⁅Z (family P) a, Z (family P) a'⁆ = ⊥) :
    let F := family P
    let W := V F beta 3
    let H := ⁅V F beta 1 ⊓ Q F a', V F a' 1⁆
    5 ≤ b F ∧ W ≤ Q F beta ∧ IsPGroup 2 W ∧ W ≤ centralizer (H : Set G) ∧
      ∃ x₁ x₂ x₃ : Vertex F,
        (graph F).Adj a' x₁ ∧ (graph F).Adj x₁ x₂ ∧ (graph F).Adj x₂ x₃ ∧
        (graph F).dist beta x₁ + 1 = (graph F).dist beta a' ∧
        (graph F).dist beta x₂ + 1 = (graph F).dist beta x₁ ∧
        (graph F).dist beta x₃ + 1 = (graph F).dist beta x₂ ∧
        W ≤ d.localGroup x₂ ∧ W ≤ Q F x₃ := by
  dsimp only
  let := finite_endpoints h
  change 3 < b (family P) at hb
  change (graph (family P)).dist beta a' + 1 = b (family P) at hd
  have hZ := fun v => (source_Z_Q_U h v).1
  obtain ⟨hodd, _, _⟩ := source_critical_geometry h d hc hab hd (by omega) hcomm
  have hb5 : 5 ≤ b (family P) := by
    obtain ⟨k, hk⟩ := hodd
    change b (family P) = 2 * k + 1 at hk
    omega
  have hWQ : V (family P) beta 3 ≤ Q (family P) beta :=
    V_le_Q_of_dist_add_lt_b (family P) h.generate hZ beta beta 3
      (by simpa only [SimpleGraph.dist_self, zero_add] using hb) (d.kernel_sylow beta)
  have hp := (isPGroup_pCoreIn 2 (stabilizer (family P) beta)).to_le hWQ
  have hHV : ⁅V (family P) beta 1 ⊓ Q (family P) a', V (family P) a' 1⁆ ≤ V (family P) beta 1 := by
    apply (commutator_mono inf_le_left le_rfl).trans
    apply le_normalizer_iff_commutator_le_left.mp
    exact (radius_one_mutual_normalization (family P) h.generate beta a' hd.le).2
  have hWH : V (family P) beta 3 ≤ centralizer ((⁅V (family P) beta 1 ⊓ Q (family P) a', V (family P) a' 1⁆ : Subgroup G) : Set G) :=
    (radius_spans_centralize (family P) h.generate hZ d.kernel_sylow beta 3 1 (by omega)).trans
      (centralizer_le hHV)
  have hne : beta ≠ a' := by
    intro he
    rw [he, SimpleGraph.dist_self] at hd
    omega
  obtain ⟨x₁, hx₁, hd₁⟩ := exists_predecessor (family P) h.generate beta a' hne
  have hne₁ : beta ≠ x₁ := by
    intro he
    have heq : (graph (family P)).dist beta x₁ = 0 := by rw [he, SimpleGraph.dist_self]
    omega
  obtain ⟨x₂, hx₂, hd₂⟩ := exists_predecessor (family P) h.generate beta x₁ hne₁
  have hne₂ : beta ≠ x₂ := by
    intro he
    have heq : (graph (family P)).dist beta x₂ = 0 := by rw [he, SimpleGraph.dist_self]
    omega
  obtain ⟨x₃, hx₃, hd₃⟩ := exists_predecessor (family P) h.generate beta x₂ hne₂
  exact ⟨hb5, hWQ, hp, hWH, x₁, x₂, x₃, hx₁, hx₂, hx₃, hd₁, hd₂, hd₃,
    pGroup_le_localGroup (family P) d x₂ _ hp
      (V_le_stabilizer_of_dist_add_le_b (family P) h.generate beta x₂ 3 (by omega)),
    V_le_Q_of_dist_add_lt_b (family P) h.generate hZ beta x₃ 3 (by omega) (d.kernel_sylow x₃)⟩

/-- The first core containment in 8.4(1), at the actual chosen geodesic tail.
The remaining case must have W escaping the core two steps before the end. -/
theorem source_radius_three_path_control (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (d : EarlierLocalTheorems (family P))
    (models : ∀ v : Vertex (family P), IsRankOneModel (d.localGroup v ⧸ pCore 2 (d.localGroup v)))
    {a beta a' : Vertex (family P)} (hc : IsCriticalPair (family P) a a')
    (hab : (graph (family P)).Adj a beta)
    (hd : (graph (family P)).dist beta a' + 1 = b (family P))
    (hb : 3 < b (family P)) (hcomm : ⁅Z (family P) a, Z (family P) a'⁆ = ⊥)
    (hne : ⁅V (family P) beta 1 ⊓ Q (family P) a', V (family P) a' 1⁆ ≠ ⊥) :
    let F := family P
    let W := V F beta 3
    let H := ⁅V F beta 1 ⊓ Q F a', V F a' 1⁆
    5 ≤ b F ∧ W ≤ Q F beta ∧ IsPGroup 2 W ∧ W ≤ centralizer (H : Set G) ∧
      ∃ x₁ x₂ x₃ : Vertex F,
        (graph F).Adj a' x₁ ∧ (graph F).Adj x₁ x₂ ∧ (graph F).Adj x₂ x₃ ∧
        (graph F).dist beta x₁ + 1 = (graph F).dist beta a' ∧
        (graph F).dist beta x₂ + 1 = (graph F).dist beta x₁ ∧
        (graph F).dist beta x₃ + 1 = (graph F).dist beta x₂ ∧
        W ≤ d.localGroup x₂ ∧ W ≤ Q F x₃ ∧
        W ⊓ d.localGroup x₁ ≤ Q F x₁ ∧
        (W ≤ Q F x₂ → W ≤ Q F x₁) := by
  dsimp only
  let := finite_endpoints h
  let W := V (family P) beta 3
  let H := ⁅V (family P) beta 1 ⊓ Q (family P) a', V (family P) a' 1⁆
  obtain ⟨hb5, hWQ, hp, hWH, x₁, x₂, x₃, h₁, h₂, h₃, hd₁, hd₂, hd₃, hWL, hWQ₃⟩ :=
    source_radius_three_opening h d hc hab hd hb hcomm
  obtain ⟨hn, hHZ, _⟩ := source_critical_commutator_structure h hB d hc hab hd (by omega) hcomm models
  have hHV : H ≤ V (family P) a' 1 := le_normalizer_iff_commutator_le_right.mp
    ((inf_le_right.trans (Q_le_stabilizer (family P) a')).trans (stabilizer_normalizes_V (family P) a' 1))
  have hHQ : H ≤ Q (family P) a' := hHV.trans
    (V_le_Q_of_dist_add_lt_b (family P) h.generate (fun v => (source_Z_Q_U h v).1)
      a' a' 1 (by simp only [SimpleGraph.dist_self, zero_add]; omega)
      (d.kernel_sylow a'))
  have hHL : H ≤ d.localGroup a' := hHQ.trans
    (pGroup_le_localGroup (family P) d a' _ (isPGroup_pCoreIn 2 _) (Q_le_stabilizer (family P) a'))
  have hnorm := (normal_subgroupOf_iff_le_normalizer hHL).mp hn
  have htrap := source_local_normalizer_le_edge h hB d h₁.symm (models x₁) H
    (le_inf ((hHZ ⟨x₁,h₁⟩).trans (Z_le_stabilizer (family P) x₁)) (hHQ.trans (Q_le_stabilizer (family P) a')))
    hne hnorm
  have hWA : W ⊓ d.localGroup x₁ ≤ stabilizer (family P) a' :=
    (le_inf inf_le_right (inf_le_left.trans (hWH.trans (Subgroup.centralizer_le_normalizer _)))).trans htrap
  have hxne : a' ≠ x₂ := by
    intro he
    rw [← he] at hd₂
    omega
  have hinter : W ⊓ d.localGroup x₁ ≤ Q (family P) x₁ :=
    source_two_neighbor_pGroup_le_core h hB d h₁.symm h₂ hxne (models x₁)
      _ (hp.to_le inf_le_left) (inf_le_right.trans (d.local_le x₁)) hWA
      (inf_le_left.trans (hWL.trans (d.local_le x₂)))
  refine ⟨hb5, hWQ, hp, hWH, x₁, x₂, x₃, h₁, h₂, h₃, hd₁, hd₂, hd₃,
    hWL, hWQ₃, hinter, ?_⟩
  intro hWQ₂
  have hQ₂P₁ : Q (family P) x₂ ≤ stabilizer (family P) x₁ :=
    (source_Z_Q_U h x₂).2.trans ((ballKernel_one_le_edge (family P) h₂.symm).trans inf_le_right)
  exact (le_inf le_rfl (hWQ₂.trans
    (pGroup_le_localGroup (family P) d x₁ _ (isPGroup_pCoreIn 2 _) hQ₂P₁))).trans hinter

