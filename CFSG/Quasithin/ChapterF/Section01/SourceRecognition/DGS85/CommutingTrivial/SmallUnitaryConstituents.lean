module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingTrivial.ConstituentBounds
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.Noncommuting.TerminalSmallExclusion
public import Theory.GroupTheory.GeneralizedFitting.CentralCoverLift

/-!
# Small unitary bounds on the actual residual constituent

A nontrivial representation generated by Sylow-fixed vectors has kernel in
that Sylow's normalizer. For PSU₃(2) the normalizer is a two-group, so the
trivial two-core of the actual local quotient forces faithfulness. For
SU₃(2), projection through the central scalar kernel gives a normal two-group
in PSU₃(2); it is trivial by transport of the two-core through the central
extension. Thus the original action has only an odd scalar kernel.

The existing small-unitary quadratic bounds then apply to the constructed
constituent of the literal V_beta/C_V_beta(O²(L_beta)). Its actor and fixed
index remain the original core and centralizer indices. No whole-section
descent, linear quotient marking or extra Sylow-faithfulness hypothesis is
assumed. ReciprocalLinearSelection uses these bounds to eliminate the last
two nonlinear rows in the reciprocal branch. The generated-module bound
also handles the full catalogue, retaining scalar kernels and selecting an
actual linear marking whenever the fixed index is below the actor square;
MixedInitialRecognition applies it to the two literal mixed modules.

Source: DGS, *Groups and Graphs* (1985), (9.3), printed p.142, using the
corrected fixed-space generation in (5.12), pp.113--115.
-/

@[expose] public noncomputable section
open Subgroup Representation Representation.BinaryOffender
open Representation.RankOne.QuadraticRecognition BenderSuzuki.MatrixGroups
namespace CFSG.Quasithin.ChapterF.Source.DGS85.CommutingTrivial

private theorem generated_kernel_le_normalizer
    {D W : Type*} [Group D] [AddCommGroup W] [Module (ZMod 2) W]
    (σ : Representation (ZMod 2) D W) (T : Sylow 2 D) (hf : RankOneSylowFacts T)
    (hg : GeneratedByFixedSpace σ T) (hnt : σ ≠ 1) :
    σ.ker ≤ normalizer (T : Set D) := by
  apply le_sup_left.trans (hf.unique_maximal _ le_sup_right (lt_top_iff_ne_top.mpr ?_))
  intro hsup
  have hR : fixedSpace σ σ.ker = ⊤ := by
    apply top_unique
    intro w _ a
    change σ a w = w
    rw [show σ a = 1 from a.property]
    rfl
  have hfix : fixedSpace σ ⊤ = fixedSpace σ T := by
    have he := σ.invariants_comp_sup σ.ker (T : Subgroup D)
    change fixedSpace σ (σ.ker ⊔ (T : Subgroup D)) =
      fixedSpace σ σ.ker ⊓ fixedSpace σ T at he
    rwa [hsup,hR,top_inf_eq] at he
  have hspan : (⨆ g : D, (fixedSpace σ T).map (σ g)) ≤ fixedSpace σ ⊤ := by
    apply iSup_le
    rintro g _ ⟨v,hv,rfl⟩
    have hv' : v ∈ fixedSpace σ ⊤ := hfix.symm ▸ hv
    rw [show σ g v = v from hv' ⟨g,mem_top _⟩]
    exact hv'
  have htop : fixedSpace σ ⊤ = ⊤ := top_unique (hg ▸ hspan)
  apply hnt
  apply MonoidHom.ext
  intro g
  apply LinearMap.ext
  intro w
  exact (show w ∈ fixedSpace σ ⊤ from htop.symm ▸ Submodule.mem_top) ⟨g,mem_top _⟩

private theorem small_projective_constituent_faithful
    {F W : Type*} [Field F] [Finite F] (J : HermitianForm 3 F)
    (hc : Nat.card F = 2^2) (hconj : ∀ x, J.conj x = x^2)
    (hcore : pCore 2 (ProjectiveSpecialUnitaryMatrixGroup J) = ⊥)
    [AddCommGroup W] [Module (ZMod 2) W]
    (σ : Representation (ZMod 2) (ProjectiveSpecialUnitaryMatrixGroup J) W)
    (T : Sylow 2 (ProjectiveSpecialUnitaryMatrixGroup J))
    (hg : GeneratedByFixedSpace σ T) (hnt : σ ≠ 1) : Function.Injective σ := by
  have hk := generated_kernel_le_normalizer σ T
    (rankOneSylowFacts_psu3 J 1 (by decide) (by simpa using hc) (by simpa using hconj) T)
    hg hnt
  rw [Noncommuting.psu_two_self_normalizing J hc hconj] at hk
  have hp : IsPGroup 2 σ.ker := T.isPGroup'.to_le hk
  have hkcore : σ.ker ≤ pCore 2 (ProjectiveSpecialUnitaryMatrixGroup J) :=
    le_sSup ⟨inferInstance,hp⟩
  exact σ.ker_eq_bot_iff.mp (bot_unique (hkcore.trans hcore.le))

private theorem small_special_constituent_square_bound
    {F W : Type*} [Field F] [Finite F] (J : HermitianForm 3 F)
    (hc : Nat.card F = 2^2) (hconj : ∀ x, J.conj x = x^2)
    (hcore : pCore 2 J.specialSubgroup = ⊥)
    [AddCommGroup W] [Module (ZMod 2) W] [Finite W]
    (σ : Representation (ZMod 2) J.specialSubgroup W) (T : Sylow 2 J.specialSubgroup)
    (hg : GeneratedByFixedSpace σ T) (hnt : σ ≠ 1)
    (A : Subgroup J.specialSubgroup) (hAT : A ≤ T) (hq : IsQuadratic σ A) :
    Nat.card A ^ 2 ≤ Nat.card (W ⧸ fixedSpace σ A) := by
  let π := J.specialToProjective
  let : Finite (ProjectiveSpecialUnitaryMatrixGroup J) :=
    Finite.of_surjective _ J.specialToProjective_surjective
  let S := T.mapSurjective J.specialToProjective_surjective
  have hf := rankOneSylowFacts_su3 J 1 (by decide)
    (by simpa using hc) (by simpa using hconj) T
  have hk := generated_kernel_le_normalizer σ T hf hg hnt
  have hm : σ.ker.map π ≤ (S : Subgroup _) := by
    have hh := map_mono (f := π) hk
    rw [T.normalizer_map_surjective π J.specialToProjective_surjective] at hh
    exact hh.trans_eq (Noncommuting.psu_two_self_normalizing J hc hconj S)
  have hp := S.isPGroup'.to_le hm
  let : (σ.ker.map π).Normal := Normal.map inferInstance π J.specialToProjective_surjective
  have hkp : σ.ker.map π ≤ pCore 2 (ProjectiveSpecialUnitaryMatrixGroup J) :=
    le_sSup ⟨inferInstance,hp⟩
  have hpc : pCore 2 (ProjectiveSpecialUnitaryMatrixGroup J) = ⊥ := by
    rw [←π.map_pCore_of_central_kernel J.specialToProjective_surjective
      J.specialToProjective_ker_le_center,hcore,Subgroup.map_bot]
  have hscalar : σ.ker ≤ π.ker := by
    intro g hg
    exact mem_bot.mp (hpc.le (hkp (mem_map_of_mem π hg)))
  have hdis : Disjoint σ.ker (T : Subgroup J.specialSubgroup) := by
    have hd : Disjoint (T : Subgroup J.specialSubgroup) π.ker := by
      apply disjoint_of_coprime_natCard
      obtain ⟨k,hkT⟩ := IsPGroup.iff_card.mp T.isPGroup'
      rw [hkT]
      exact J.odd_card_specialToProjective_ker.coprime_two_left.pow_left k
    exact hd.symm.mono_left hscalar
  have hne : (T : Subgroup J.specialSubgroup) ≠ ⊥ := by
    intro he
    have hp := hf.proper
    change normalizer ((T : Subgroup J.specialSubgroup) : Set J.specialSubgroup) < ⊤ at hp
    rw [he, Subgroup.normalizer_eq_top] at hp
    exact lt_irrefl _ hp
  exact Noncommuting.su_two_fixed_generated_square_bound J hc hconj σ T A hAT hg hdis hne hq

private theorem model_fixed_transport
    {D E W : Type*} [Group D] [Group E] [AddCommGroup W] [Module (ZMod 2) W]
    (ρ : Representation (ZMod 2) D W) (e : D ≃* E) (A : Subgroup D) :
    fixedSpace (ρ.comp e.symm.toMonoidHom) (A.map e.toMonoidHom) = fixedSpace ρ A := by
  rw [fixedSpace_comp_map,Subgroup.map_map]
  have he : e.symm.toMonoidHom.comp e.toMonoidHom = MonoidHom.id D := by ext a; simp
  rw [he,Subgroup.map_id]

private theorem model_residual_transport
    {D E W : Type*} [Group D] [Finite D] [Group E] [AddCommGroup W] [Module (ZMod 2) W]
    (ρ : Representation (ZMod 2) D W) (e : D ≃* E)
    (hr : fixedSpace ρ (pResidual 2 D) = ⊥) :
    fixedSpace (ρ.comp e.symm.toMonoidHom) (pResidual 2 E) = ⊥ := by
  let : Finite E := Finite.of_equiv D e.toEquiv
  rw [fixedSpace_comp_map,map_pResidual_of_surjective 2 _ e.symm.surjective,hr]

private theorem model_quadratic_transport
    {D E W : Type*} [Group D] [Group E] [AddCommGroup W] [Module (ZMod 2) W]
    (ρ : Representation (ZMod 2) D W) (e : D ≃* E) (A : Subgroup D)
    (hq : IsQuadratic ρ A) : IsQuadratic (ρ.comp e.symm.toMonoidHom) (A.map e.toMonoidHom) := by
  rintro a ⟨b,hb,rfl⟩ c ⟨d,hd,rfl⟩ v
  simpa only [MonoidHom.comp_apply,MulEquiv.coe_toMonoidHom,e.symm_apply_apply] using hq b hb d hd v

private theorem model_generation_transport
    {D E W : Type*} [Group D] [Finite D] [Group E] [AddCommGroup W] [Module (ZMod 2) W]
    (ρ : Representation (ZMod 2) D W) (e : D ≃* E) (S : Sylow 2 D)
    (hg : GeneratedByFixedSpace ρ S) :
    GeneratedByFixedSpace (ρ.comp e.symm.toMonoidHom)
      (S.mapSurjective (f := e.toMonoidHom) e.surjective) := by
  exact generatedByFixedSpace_of_equivariant_surjection ρ (ρ.comp e.symm.toMonoidHom)
    e.toMonoidHom LinearMap.id Function.surjective_id (by intro g v; simp) S hg

private theorem nontrivial_action_of_no_fixed
    {D W : Type*} [Group D] [AddCommGroup W] [Module (ZMod 2) W] [Nontrivial W]
    (ρ : Representation (ZMod 2) D W) (hx : fixedSpace ρ ⊤ = ⊥) : ρ ≠ 1 := by
  intro heq
  obtain ⟨w,hw⟩ := exists_ne (0 : W)
  apply hw
  apply hx.le
  intro g
  change ρ g w = w
  rw [heq]
  rfl

private theorem special_generated_square_bound
    {F W : Type*} [Field F] [Finite F] (J : HermitianForm 3 F)
    {n : ℕ} (hn : 0 < n) (hc : Nat.card F = (2^n)^2) (hconj : ∀ x, J.conj x = x^(2^n))
    (hcore : pCore 2 J.specialSubgroup = ⊥)
    [AddCommGroup W] [Module (ZMod 2) W] [Finite W] [Nontrivial W]
    (σ : Representation (ZMod 2) J.specialSubgroup W) (T : Sylow 2 J.specialSubgroup)
    (hg : GeneratedByFixedSpace σ T) (hx : fixedSpace σ ⊤ = ⊥)
    (A : Subgroup J.specialSubgroup) [IsElementaryAbelian 2 A]
    (hAT : A ≤ T) (hq : IsQuadratic σ A) :
    Nat.card A ^ 2 ≤ Nat.card (W ⧸ fixedSpace σ A) := by
  have hnt := nontrivial_action_of_no_fixed σ hx
  by_cases hn1 : n = 1
  · subst n
    exact small_special_constituent_square_bound J (by simpa using hc)
      (by simpa using hconj) hcore σ T hg hnt A hAT hq
  · exact su3_elementary_square_bound J (by omega) hc hconj σ
      (by by_contra! hh; exact hnt (MonoidHom.ext hh)) hx A

private theorem projective_generated_square_bound
    {F W : Type*} [Field F] [Finite F] (J : HermitianForm 3 F)
    {n : ℕ} (hn : 0 < n) (hc : Nat.card F = (2^n)^2) (hconj : ∀ x, J.conj x = x^(2^n))
    (hcore : pCore 2 (ProjectiveSpecialUnitaryMatrixGroup J) = ⊥)
    [AddCommGroup W] [Module (ZMod 2) W] [Finite W] [Nontrivial W]
    (σ : Representation (ZMod 2) (ProjectiveSpecialUnitaryMatrixGroup J) W)
    (T : Sylow 2 (ProjectiveSpecialUnitaryMatrixGroup J))
    (hg : GeneratedByFixedSpace σ T) (hx : fixedSpace σ ⊤ = ⊥)
    (A : Subgroup (ProjectiveSpecialUnitaryMatrixGroup J)) [IsElementaryAbelian 2 A]
    (hq : IsQuadratic σ A) :
    Nat.card A ^ 2 ≤ Nat.card (W ⧸ fixedSpace σ A) := by
  have hnt := nontrivial_action_of_no_fixed σ hx
  by_cases hn1 : n = 1
  · subst n
    have hf := small_projective_constituent_faithful J (by simpa using hc)
      (by simpa using hconj) hcore σ T hg hnt
    exact psu3_two_quadratic_square_bound J (by simpa using hc) (by simpa using hconj) σ hf A hq
  · exact psu3_elementary_square_bound J (by omega) hc hconj σ
      (by by_contra! hh; exact hnt (MonoidHom.ext hh)) hx A

open scoped MatrixGroups
universe u

/-- A nonzero module over an actual core-free rank-one quotient satisfies
its actor bound even when a unitary scalar kernel is present. Strictness
against the square selects an actual linear marking from the full catalogue.
Generation and residual vanishing are on the same specified representation. -/
theorem generated_rank_one_bound_and_selection
    {H D : Type u} [Group H] [Finite H] [Group D] [Finite D]
    {W : Type*} [AddCommGroup W] [Module (ZMod 2) W] [Finite W] [Nontrivial W]
    (e₀ : (H ⧸ pCore 2 H) ≃* D) (M : BinaryRankOneModel D)
    (ρ : Representation (ZMod 2) D W) (S : Sylow 2 D)
    (A : Subgroup D) [IsElementaryAbelian 2 A] (hAS : A ≤ S)
    (hq : IsQuadratic ρ A) (hg : GeneratedByFixedSpace ρ S)
    (hr : fixedSpace ρ (pResidual 2 D) = ⊥) :
    Nat.card A ≤ Nat.card (W ⧸ fixedSpace ρ A) ∧
      (Nat.card (W ⧸ fixedSpace ρ A) < Nat.card A ^ 2 →
        ∃ (F : Type u) (_ : Field F) (_ : Finite F) (_ : CharP F 2) (n : ℕ),
          0 < n ∧ Nat.card F = 2^n ∧ Nonempty (D ≃* SL(2,F))) := by
  cases M with
  | sl2 F n hn hF e =>
    let σ := ρ.comp e.symm.toMonoidHom
    have hrσ := model_residual_transport ρ e hr
    have hf := CommutingNontrivial.linear_quotient_action_faithful hn hF (e₀.trans e) σ hrσ
    have hl := sl2_actor_bound σ hf (S.mapSurjective e.surjective)
      (A.map e.toMonoidHom) (map_mono hAS) hF
    rw [model_fixed_transport,card_map_of_injective e.injective] at hl
    exact ⟨hl,fun _ => ⟨F,inferInstance,inferInstance,inferInstance,n,hn,hF,⟨e⟩⟩⟩
  | suzuki m e =>
    let σ := ρ.comp e.symm.toMonoidHom
    have hrσ := model_residual_transport ρ e hr
    have hf := CommutingNontrivial.suzuki_quotient_action_faithful m (e₀.trans e) σ hrσ
    have hl := suzuki_all_square_bound m σ hf (S.mapSurjective e.surjective)
      (A.map e.toMonoidHom) (map_mono hAS) (model_quadratic_transport ρ e A hq)
    rw [model_fixed_transport,card_map_of_injective e.injective] at hl
    exact ⟨(Nat.le_self_pow (by decide) _).trans hl,fun hs => (Nat.not_lt_of_ge hl hs).elim⟩
  | su3 F J n hn hF hconj e =>
    let σ := ρ.comp e.symm.toMonoidHom
    have hrσ := model_residual_transport ρ e hr
    have hx : fixedSpace σ ⊤ = ⊥ := bot_unique ((fixedSpace_antitone σ le_top).trans hrσ.le)
    have hnt := nontrivial_action_of_no_fixed σ hx
    let : IsElementaryAbelian 2 (A.map e.toMonoidHom) := IsElementaryAbelian.map _
    have hcore : pCore 2 J.specialSubgroup = ⊥ := by
      rw [←pCore_map_iso 2 (e₀.trans e),pCore_quotient_pCore_eq_bot,Subgroup.map_bot]
    have hl := special_generated_square_bound J hn hF hconj hcore σ (S.mapSurjective e.surjective)
      (model_generation_transport ρ e S hg) hx (A.map e.toMonoidHom)
      (map_mono hAS) (model_quadratic_transport ρ e A hq)
    rw [model_fixed_transport,card_map_of_injective e.injective] at hl
    exact ⟨(Nat.le_self_pow (by decide) _).trans hl,fun hs => (Nat.not_lt_of_ge hl hs).elim⟩
  | psu3 F J n hn hF hconj e =>
    let σ := ρ.comp e.symm.toMonoidHom
    have hrσ := model_residual_transport ρ e hr
    have hx : fixedSpace σ ⊤ = ⊥ := bot_unique ((fixedSpace_antitone σ le_top).trans hrσ.le)
    have hnt := nontrivial_action_of_no_fixed σ hx
    let : IsElementaryAbelian 2 (A.map e.toMonoidHom) := IsElementaryAbelian.map _
    have hcore : pCore 2 (ProjectiveSpecialUnitaryMatrixGroup J) = ⊥ := by
      rw [←pCore_map_iso 2 (e₀.trans e),pCore_quotient_pCore_eq_bot,Subgroup.map_bot]
    have hl := projective_generated_square_bound J hn hF hconj hcore σ (S.mapSurjective e.surjective)
      (model_generation_transport ρ e S hg) hx (A.map e.toMonoidHom)
      (model_quadratic_transport ρ e A hq)
    rw [model_fixed_transport,card_map_of_injective e.injective] at hl
    exact ⟨(Nat.le_self_pow (by decide) _).trans hl,fun hs => (Nat.not_lt_of_ge hl hs).elim⟩


open Subgroup.CosetGeometry.RankTwo Theory.GroupTheory.AmalgamGraph
variable {G : Type u} [Group G] {L : Fin 2 → Subgroup G} {S₀ : Subgroup G}

/-- The small special-unitary model imposes the square bound on the original
indices, with its possible scalar action kernel retained. -/
theorem reduced_critical_small_special_unitary_constituent_bound (h : HypothesisF11 L S₀)
    {a beta a' : Vertex (Reduction.reducedFamily L S₀)}
    (hc : IsCriticalPair (Reduction.reducedFamily L S₀) a a')
    (hab : (graph (Reduction.reducedFamily L S₀)).Adj a beta)
    (hd : (graph (Reduction.reducedFamily L S₀)).dist beta a' + 1 = b (Reduction.reducedFamily L S₀))
    (hb : 1 < b (Reduction.reducedFamily L S₀))
    (hcomm : ⁅Z (Reduction.reducedFamily L S₀) a, Z (Reduction.reducedFamily L S₀) a'⁆ = ⊥)
    {F : Type*} [Field F] [Finite F] (J : HermitianForm 3 F)
    (hF : Nat.card F = 2^2)
    (hconj : ∀ x, J.conj x = x^2)
    (e : (graphLocalGroup (Reduction.reducedFamily L S₀) beta ⧸
      pCore 2 (graphLocalGroup (Reduction.reducedFamily L S₀) beta)) ≃* J.specialSubgroup) :
    let Γ := Reduction.reducedFamily L S₀
    ((Q Γ beta).relIndex (V Γ a' 1)) ^ 2 ≤
      (centralizer (V Γ a' 1 : Set (Reduction.G₀ L S₀))).relIndex (V Γ beta 1) := by
  let ht := Reduction.reduced_triple h
  let Γ := Reduction.reducedFamily L S₀
  let H := graphLocalGroup Γ beta
  let A := (V Γ beta 1).subgroupOf H
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 H))
  let Aq := ((V Γ a' 1).subgroupOf H).map q
  let : ∀ i, Finite (Γ i) := finite_endpoints ht
  let := neighborhoodIn_normal Γ beta H (sylowGenerated_le _)
  obtain ⟨hb2,⟨d⟩⟩ := reduced_critical_residual_constituent h hc hab hd hb hcomm e
  let := neighborhoodIn_elementary Γ ht.generate (fun v => (source_Z_Q_U ht v).1)
    (Reduction.reduced_kernel_sylow h) beta hb2 H
  let : Finite H := Finite.of_injective (inclusion (sylowGenerated_le _)) (inclusion_injective _)
  let : Finite d.space.toSubmodule := d.finiteSpace
  let : d.action.IsIrreducible := d.irreducible
  let : Nontrivial d.space.toSubmodule := Subrepresentation.irreducible_module_nontrivial d.action
  have hx : fixedSpace d.action ⊤ = ⊥ :=
    bot_unique ((fixedSpace_antitone d.action le_top).trans d.residualFixed.le)
  have hnt : d.action ≠ 1 := by
    intro heq
    obtain ⟨w,hw⟩ := exists_ne (0 : d.space.toSubmodule)
    apply hw
    apply hx.le
    intro g
    change d.action g w = w
    rw [heq]
    rfl
  obtain ⟨T,hT⟩ := d.elementary.isPGroup.exists_le_sylow
  have hcore : pCore 2 J.specialSubgroup = ⊥ := by
    rw [←pCore_map_iso 2 e,Subgroup.pCore_quotient_pCore_eq_bot,Subgroup.map_bot]
  have hlo := small_special_constituent_square_bound J hF hconj hcore d.action T
    (d.generated T) hnt Aq hT d.quadratic
  rw [d.actorCard] at hlo
  exact hlo.trans d.fixedIndex

/-- The small projective-unitary model imposes the same square bound on the
original indices; constituent faithfulness is derived from the local quotient. -/
theorem reduced_critical_small_projective_unitary_constituent_bound (h : HypothesisF11 L S₀)
    {a beta a' : Vertex (Reduction.reducedFamily L S₀)}
    (hc : IsCriticalPair (Reduction.reducedFamily L S₀) a a')
    (hab : (graph (Reduction.reducedFamily L S₀)).Adj a beta)
    (hd : (graph (Reduction.reducedFamily L S₀)).dist beta a' + 1 = b (Reduction.reducedFamily L S₀))
    (hb : 1 < b (Reduction.reducedFamily L S₀))
    (hcomm : ⁅Z (Reduction.reducedFamily L S₀) a, Z (Reduction.reducedFamily L S₀) a'⁆ = ⊥)
    {F : Type*} [Field F] [Finite F] (J : HermitianForm 3 F)
    (hF : Nat.card F = 2^2)
    (hconj : ∀ x, J.conj x = x^2)
    (e : (graphLocalGroup (Reduction.reducedFamily L S₀) beta ⧸
      pCore 2 (graphLocalGroup (Reduction.reducedFamily L S₀) beta)) ≃* ProjectiveSpecialUnitaryMatrixGroup J) :
    let Γ := Reduction.reducedFamily L S₀
    ((Q Γ beta).relIndex (V Γ a' 1)) ^ 2 ≤
      (centralizer (V Γ a' 1 : Set (Reduction.G₀ L S₀))).relIndex (V Γ beta 1) := by
  let ht := Reduction.reduced_triple h
  let Γ := Reduction.reducedFamily L S₀
  let H := graphLocalGroup Γ beta
  let A := (V Γ beta 1).subgroupOf H
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 H))
  let Aq := ((V Γ a' 1).subgroupOf H).map q
  let : ∀ i, Finite (Γ i) := finite_endpoints ht
  let := neighborhoodIn_normal Γ beta H (sylowGenerated_le _)
  let : Finite (ProjectiveSpecialUnitaryMatrixGroup J) :=
    Finite.of_surjective J.specialToProjective J.specialToProjective_surjective
  obtain ⟨hb2,⟨d⟩⟩ := reduced_critical_residual_constituent h hc hab hd hb hcomm e
  let := neighborhoodIn_elementary Γ ht.generate (fun v => (source_Z_Q_U ht v).1)
    (Reduction.reduced_kernel_sylow h) beta hb2 H
  let : Finite H := Finite.of_injective (inclusion (sylowGenerated_le _)) (inclusion_injective _)
  let : Finite d.space.toSubmodule := d.finiteSpace
  let : d.action.IsIrreducible := d.irreducible
  let : Nontrivial d.space.toSubmodule := Subrepresentation.irreducible_module_nontrivial d.action
  have hx : fixedSpace d.action ⊤ = ⊥ :=
    bot_unique ((fixedSpace_antitone d.action le_top).trans d.residualFixed.le)
  have hnt : d.action ≠ 1 := by
    intro heq
    obtain ⟨w,hw⟩ := exists_ne (0 : d.space.toSubmodule)
    apply hw
    apply hx.le
    intro g
    change d.action g w = w
    rw [heq]
    rfl
  obtain ⟨T,hT⟩ := d.elementary.isPGroup.exists_le_sylow
  have hcore : pCore 2 (ProjectiveSpecialUnitaryMatrixGroup J) = ⊥ := by
    rw [←pCore_map_iso 2 e,Subgroup.pCore_quotient_pCore_eq_bot,Subgroup.map_bot]
  have hf := small_projective_constituent_faithful J hF hconj hcore d.action T
    (d.generated T) hnt
  have hlo := psu3_two_quadratic_square_bound J hF hconj d.action hf Aq d.quadratic
  rw [d.actorCard] at hlo
  exact hlo.trans d.fixedIndex


