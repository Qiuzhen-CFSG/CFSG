module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.LocalStructure.Graph
public import Theory.GroupTheory.ConjugateSpanSupplement

/-!
# Fixed-space generation for the actual Sylow-center span

Sylow conjugacy expresses the literal Z as the span of one Sylow
omega-center. Frattini's argument restricts the conjugating group to any
normal local subgroup containing that Sylow. The omega-center is fixed
by the Sylow, which proves generation by the fixed space. Mapping the
entire identity proves the corresponding statement for an actual image,
with the module, actor, and Sylow transported by the same homomorphism.

This supplies the generation argument for the Z section in the corrected
DGS 5.12 applications. It does not identify the different neighboring
section V / C_V(O^2(L)) or prove its fixed-space-generation condition.

Source: Delgado--Goldschmidt--Stellmacher, *Groups and Graphs* (1985),
Part II, notation p.81 and 9.4, printed pp.142--143; the published Stroth
review adds V = <C_V(S)^G> to 5.12.
-/

@[expose] public noncomputable section
open Subgroup
open scoped Pointwise
namespace CFSG.Quasithin.ChapterF.Source.DGS85.CommutingTrivial
open Subgroup.CosetGeometry.RankTwo
open Theory.GroupTheory.AmalgamGraph
variable {G : Type*} [Group G]

private theorem sylow_span_eq_seed_span (P : Subgroup G) [Finite P] (T : Sylow 2 P) :
    sylowCenterSpan P =
      conjugateSpanBy (omegaCenterIn ((T : Subgroup P).map P.subtype)) P := by
  apply le_antisymm
  · apply iSup_le
    intro R
    obtain ⟨g, hg⟩ := MulAction.exists_smul_eq P T R
    have he : (R : Subgroup P) = (T : Subgroup P).map (MulAut.conj g).toMonoidHom := by
      rw [← hg, Sylow.smul_def, Sylow.pointwise_smul_def, Subgroup.pointwise_smul_def]
      rfl
    have hm : (R : Subgroup P).map P.subtype =
        ((T : Subgroup P).map P.subtype).map (MulAut.conj (g : G)).toMonoidHom := by
      rw [he, map_map, map_map]
      rfl
    rw [hm, ← NilesRankOneKernel.omegaCenterIn_map_injective _ (MulAut.conj (g : G)).injective]
    rintro x ⟨z, hz, rfl⟩
    exact subset_closure ⟨g, g.property, z, hz, rfl⟩
  · apply conjugateSpanBy_le (le_iSup _ T)
    exact (normal_subgroupOf_iff_le_normalizer (sylowCenterSpan_le P)).mp
      (sylowCenterSpan_normal P)

private theorem intrinsic_span_eq_seed_span (P : Subgroup G) [Finite P] (T : Sylow 2 P) :
    (sylowCenterSpan P).subgroupOf P =
      conjugateSpanBy (omegaCenterIn (T : Subgroup P)) ⊤ := by
  apply map_injective P.subtype_injective
  rw [map_subgroupOf_eq_of_le (sylowCenterSpan_le P), map_conjugateSpanBy,
    NilesRankOneKernel.omegaCenterIn_map_injective _ P.subtype_injective,
    ← MonoidHom.range_eq_map, range_subtype]
  exact sylow_span_eq_seed_span P T

private theorem omega_seed_span_normal [Finite G] (T : Sylow 2 G)
    (H : Subgroup G) [H.Normal] (hTH : (T : Subgroup G) ≤ H) :
    conjugateSpanBy (omegaCenterIn (T : Subgroup G)) ⊤ =
      conjugateSpanBy (omegaCenterIn (T : Subgroup G)) H := by
  rw [← T.normalizer_sup_eq_top' hTH, sup_comm]
  apply conjugateSpanBy_sup_of_normalizes_seed
  · exact normalizer_le_normalizer_omegaCenterIn (T : Subgroup G)
  · exact le_normalizer_of_normal

/-- The original center span is generated by the fixed points of a literal
Sylow, under any normal local subgroup containing that Sylow. -/
theorem Z_fixedSpace_generation (F : Bool → Subgroup G) [∀ i, Finite (F i)]
    (v : Vertex F) (T : Sylow 2 (stabilizer F v))
    (H : Subgroup (stabilizer F v)) [H.Normal] (hTH : (T : Subgroup (stabilizer F v)) ≤ H) :
    (Z F v).subgroupOf (stabilizer F v) =
      conjugateSpanBy ((Z F v).subgroupOf (stabilizer F v) ⊓
        centralizer (T : Set (stabilizer F v))) H := by
  let W := (Z F v).subgroupOf (stabilizer F v)
  let E := omegaCenterIn (T : Subgroup (stabilizer F v))
  have hspan : W = conjugateSpanBy E H := by
    have he := intrinsic_span_eq_seed_span (stabilizer F v) T
    change W = conjugateSpanBy E ⊤ at he
    exact he.trans (omega_seed_span_normal T H hTH)
  have hEW : E ≤ W := hspan ▸ le_conjugateSpanBy E H
  have hEC : E ≤ centralizer (T : Set (stabilizer F v)) :=
    fun x hx => ((mem_omegaCenterIn_iff _ _).mp hx).2.1
  change W = conjugateSpanBy (W ⊓ centralizer (T : Set _)) H
  apply le_antisymm
  · conv_lhs => rw [hspan]
    exact conjugateSpanBy_mono (le_inf hEW hEC) le_rfl
  · let : W.Normal := Z_normal F v
    exact conjugateSpanBy_le inf_le_left le_normalizer_of_normal

/-- Fixed-space generation survives the same literal quotient map; the
Sylow image and the acting subgroup are both mapped by that map. -/
theorem Z_image_fixedSpace_generation {D : Type*} [Group D]
    (F : Bool → Subgroup G) [∀ i, Finite (F i)]
    (v : Vertex F) (T : Sylow 2 (stabilizer F v))
    (H : Subgroup (stabilizer F v)) [H.Normal] (hTH : (T : Subgroup (stabilizer F v)) ≤ H)
    (f : stabilizer F v →* D) :
    ((Z F v).subgroupOf (stabilizer F v)).map f =
      conjugateSpanBy (((Z F v).subgroupOf (stabilizer F v)).map f ⊓
        centralizer ((T : Subgroup (stabilizer F v)).map f : Set D)) (H.map f) := by
  let W := (Z F v).subgroupOf (stabilizer F v)
  have he := congrArg (map f) (Z_fixedSpace_generation F v T H hTH)
  rw [map_conjugateSpanBy] at he
  have hle : (W ⊓ centralizer (T : Set (stabilizer F v))).map f ≤
      W.map f ⊓ centralizer ((T : Subgroup (stabilizer F v)).map f : Set D) :=
    le_inf (map_mono inf_le_left)
      ((map_mono inf_le_right).trans (map_centralizer_le_centralizer_image _ _))
  change W.map f = conjugateSpanBy (W.map f ⊓ centralizer
    ((T : Subgroup (stabilizer F v)).map f : Set D)) (H.map f)
  apply le_antisymm
  · exact he.le.trans (conjugateSpanBy_mono hle le_rfl)
  · let : W.Normal := Z_normal F v
    apply conjugateSpanBy_le inf_le_left
    exact (map_mono (show H ≤ normalizer (W : Set _) from le_normalizer_of_normal)).trans
      (le_normalizer_map _)

end CFSG.Quasithin.ChapterF.Source.DGS85.CommutingTrivial
