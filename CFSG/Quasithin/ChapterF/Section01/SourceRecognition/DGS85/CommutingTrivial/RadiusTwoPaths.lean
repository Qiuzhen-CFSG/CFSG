module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingTrivial.PathReciprocal
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingTrivial.NeighborSylow
public import Theory.SpecificGroups.SL2.SylowKernelCardinality

/-!
# The path and quotient calculations for the radius-two escape

For a short first nonregular path, source 9.5 traps a two-actor fixing a
path with an opposite-type endpoint in the full terminal kernel. Applied
twice, this puts W in the last predecessor core and makes W intersect
Q_alpha-prime centralize the entire terminal neighboring span.

The exact field index saturates the image of V_beta in any containing
two-actor. The same index gives uniqueness of a fixed neighbor under the
actual SL2 local quotient. For a long first nonregular path, transitivity
moves the original critical center into the radius-two ball.

These statements retain the full local kernel U separately from Q, and
use nonbacktracking paths without assuming the graph is a tree.
Source: DGS, Groups and Graphs (1985), 9.5--9.7, printed pp.143--145.
-/

@[expose] public noncomputable section
open Subgroup
open Subgroup.CosetGeometry.RankTwo Theory.GroupTheory.AmalgamGraph
open SimpleGraph SimpleGraph.BasedWalk SimpleGraph.PathTransitivePolygon
open Theory.GroupAction.CubicTree
open scoped MatrixGroups
namespace CFSG.Quasithin.ChapterF.Source.DGS85.CommutingTrivial
variable {G : Type*} [Group G] {P : Fin 2 → Subgroup G} {B : Subgroup G}

/-- A two-subgroup fixing a positive-length path lies in its two-core. -/
theorem path_two_subgroup_le_core
    (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    {n : ℕ} {v : Vertex (family P)} (p : BasedWalk (graph (family P)) (n+1) v)
    (A : Subgroup G) (hA : IsPGroup 2 A) (hAp : A ≤ pathStabilizer (family P) p) :
    A ≤ (pathStabilizer (family P) p).pCoreIn 2 := by
  let := finite_endpoints h
  let E := stabilizer (family P) p.endpoint ⊓ stabilizer (family P) p.penultimate
  have hem : p.endpoint ∈ p.vertices := by
    simpa only [BasedWalk.support_toWalk] using p.toWalk.end_mem_support
  have hpm : p.penultimate ∈ p.vertices := by
    have hh := (p.take n (Nat.le_succ n)).toWalk.end_mem_support
    rw [BasedWalk.support_toWalk,BasedWalk.endpoint_take_penultimate,BasedWalk.vertices_take] at hh
    exact List.mem_of_mem_take hh
  have hDE : pathStabilizer (family P) p ≤ E :=
    pathStabilizer_le_edge (family P) p hem hpm
  let : Finite E := Finite.of_injective
    (inclusion (show E ≤ stabilizer (family P) p.endpoint from inf_le_left)) (inclusion_injective _)
  let : Finite (pathStabilizer (family P) p) := Finite.of_injective (inclusion hDE) (inclusion_injective _)
  exact pGroup_le_core_of_core_sylow (pathStabilizer (family P) p) A hAp hA
    (core_sylow_of_le E _ hDE (source_edge_core_sylow h hB p.adj_penultimate_endpoint.symm))

/-- The 9.5 orbit implication traps every two-subgroup fixing a sufficiently
long path whose endpoint is in the opposite orbit. -/
theorem path_two_subgroup_le_kernel_of_type
    (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    {a' : Vertex (family P)} {s : ℕ}
    (horbit : ∀ n, s ≤ n → ∀ v (p : BasedWalk (graph (family P)) n v),
      p.Nonbacktracking → ¬ (pathStabilizer (family P) p).pCoreIn 2 ≤ U (family P) p.endpoint →
      ∃ g : G, g • p.endpoint = a')
    {n : ℕ} {v : Vertex (family P)} (p : BasedWalk (graph (family P)) (n+1) v)
    (hp : p.Nonbacktracking) (hsn : s ≤ n+1) (ht : p.endpoint.type ≠ a'.type)
    (A : Subgroup G) (hA : IsPGroup 2 A) (hAp : A ≤ pathStabilizer (family P) p) :
    A ≤ U (family P) p.endpoint := by
  have hcore := path_two_subgroup_le_core h hB p A hA hAp
  by_contra he
  obtain ⟨g,hg⟩ := horbit _ hsn _ p hp (fun hh => he (hcore.trans hh))
  exact ht ((same_orbit_iff (family P) p.endpoint a').mp ⟨g,hg⟩)

/-- A two-subgroup containing a subgroup with full defining-characteristic
index is generated by that subgroup and its intersection with the kernel. -/
private theorem linear_pgroup_saturation
    {H F : Type*} [Group H] [Finite H] [Field F] [Finite F] [CharP F 2]
    (q : H →* SL(2,F)) (A W : Subgroup H) (hAW : A ≤ W)
    (hW : IsPGroup 2 W) (hi : q.ker.relIndex A = Nat.card F) :
    W = A ⊔ (W ⊓ q.ker) := by
  obtain ⟨T,hT⟩ := (hW.map q).exists_le_sylow
  have hAT : A.map q ≤ T := (map_mono hAW).trans hT
  have hc : Nat.card (A.map q) = Nat.card T := by
    rw [←relIndex_ker,hi]
    exact Nat.card_congr (Matrix.SpecialLinearGroup.sylowEquivAdditive F 2 T).toEquiv
  have he : A.map q = T := eq_of_le_of_card_ge hAT hc.ge
  have hm : W.map q = A.map q := le_antisymm (he ▸ hT) (map_mono hAW)
  apply le_antisymm ?_ (sup_le hAW inf_le_left)
  intro w hw
  obtain ⟨a,ha,hea⟩ := hm ▸ mem_map_of_mem q hw
  have hk : a⁻¹*w ∈ W ⊓ q.ker := ⟨W.mul_mem (W.inv_mem (hAW ha)) hw,by
    change q (a⁻¹*w) = 1
    rw [q.map_mul,q.map_inv,hea,inv_mul_cancel]⟩
  simpa only [mul_inv_cancel_left] using
    (A ⊔ (W ⊓ q.ker)).mul_mem ((show A ≤ A ⊔ (W ⊓ q.ker) from le_sup_left) ha)
      ((show W ⊓ q.ker ≤ A ⊔ (W ⊓ q.ker) from le_sup_right) hk)


/-- The short-first-path part of 9.7. A trapped radius-two span fixes the
whole last-neighbor ball, and its intersection with the terminal core
centralizes the entire terminal neighboring span. -/
theorem radius_two_trapped_path_centralizes
    (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    {a a' v : Vertex (family P)}
    (hc : IsCriticalPair (family P) a a')
    {n s : ℕ} (hb : b (family P) = n+3) (hs : s < b (family P))
    (horbit : ∀ k, s ≤ k → ∀ x (q : BasedWalk (graph (family P)) k x),
      q.Nonbacktracking → ¬ (pathStabilizer (family P) q).pCoreIn 2 ≤ U (family P) q.endpoint →
      ∃ g : G, g • q.endpoint = a')
    (p : BasedWalk (graph (family P)) (n+1) a)
    (hv : (graph (family P)).Adj p.endpoint v) (hv' : (graph (family P)).Adj v a')
    (htrap : V (family P) a 2 ≤ Q (family P) p.endpoint) :
    V (family P) a 2 ≤ Q (family P) v ∧
      ⁅V (family P) a 2 ⊓ Q (family P) a',V (family P) a' 1⁆ = ⊥ := by
  let Γ := family P
  let := finite_endpoints h
  let W := V Γ a 2
  let C := W ⊓ Q Γ a'
  have hZ := fun z => (source_Z_Q_U h z).1
  have hSyl := source_kernel_sylow h hB hS
  have hpW : IsPGroup 2 W := (isPGroup_pCoreIn 2 (stabilizer Γ a)).to_le
    (V_le_Q Γ h.generate hZ hSyl a (r := 2) (by change 2 < b (family P); omega))
  let q := p.snoc hv
  let r := q.snoc (show (graph Γ).Adj q.endpoint a' from by rw [endpoint_snoc]; exact hv')
  have hqend : q.endpoint = v := endpoint_snoc _ _
  have hrend : r.endpoint = a' := endpoint_snoc _ _
  have hr : r.Nonbacktracking := nonbacktracking_of_geodesic r (by
    rw [hrend,hc.1,hb])
  have hq : q.Nonbacktracking := (nonbacktracking_snoc_iff q _).mp hr |>.1
  have hWp : W ≤ pathStabilizer Γ p := V_le_pathStabilizer h p (by omega)
  have hWv : W ≤ stabilizer Γ v := htrap.trans ((source_Z_Q_U h p.endpoint).2.trans
    ((ballKernel_one_le_edge Γ hv).trans inf_le_right))
  have hWq : W ≤ pathStabilizer Γ q := by
    intro g hg z hz
    rw [BasedWalk.vertices_snoc,List.mem_append,List.mem_singleton] at hz
    rcases hz with hz | rfl
    · exact hWp hg z hz
    · exact hWv hg
  have hWU : W ≤ U Γ v := by
    have hh := path_two_subgroup_le_kernel_of_type h hB horbit q hq (by omega)
      (by rw [hqend]; exact hv'.1) W hpW hWq
    rwa [hqend] at hh
  have hWQ : W ≤ Q Γ v := two_subgroup_le_Q Γ v (hSyl v) hpW hWU
  refine ⟨hWQ,commutator_eq_bot_iff_le_centralizer.mpr ?_⟩
  apply le_centralizer_iff.mp
  apply iSup_le
  intro z
  apply iSup_le
  intro hz
  rcases (mem_ball_one Γ a' z).mp hz with hz | rfl
  · have hCQ : C ≤ Q Γ z := by
      by_cases he : z = v
      · exact he ▸ inf_le_left.trans hWQ
      have hadj : (graph Γ).Adj r.endpoint z := hrend.symm ▸ hz
      let t := r.snoc hadj
      have ht : t.Nonbacktracking := (nonbacktracking_snoc_iff r hadj).mpr ⟨hr,by
        simpa only [r,penultimate_snoc,hqend] using he⟩
      have hCt : C ≤ pathStabilizer Γ t := by
        intro g hg y hy
        rw [BasedWalk.vertices_snoc,List.mem_append,List.mem_singleton] at hy
        rcases hy with hy | rfl
        · rw [BasedWalk.vertices_snoc,List.mem_append,List.mem_singleton] at hy
          rcases hy with hy | rfl
          · exact hWq hg.1 y hy
          · exact (ballKernel_one_le_edge Γ hv').trans inf_le_right (hWU hg.1)
        · exact (ballKernel_one_le_edge Γ hz).trans inf_le_right ((source_Z_Q_U h a').2 hg.2)
      have hCU : C ≤ U Γ z := by
        have hh := path_two_subgroup_le_kernel_of_type h hB horbit t ht (by omega)
          (by rw [endpoint_snoc]; exact hz.1.symm) C (hpW.to_le inf_le_left) hCt
        simpa only [t,endpoint_snoc] using hh
      exact two_subgroup_le_Q Γ z (hSyl z) (hpW.to_le inf_le_left) hCU
    exact (CommutingNontrivial.Z_centralizes_Q Γ z (hZ z)).trans (centralizer_le hCQ)
  · exact (CommutingNontrivial.Z_centralizes_Q Γ a' (hZ a')).trans (centralizer_le inf_le_right)

/-- Ambient version of saturation for the literal local two-core quotient. -/
theorem linear_local_pgroup_saturation
    (h : LocallyRankOneTriple P B) (v : Vertex (family P))
    {F : Type*} [Field F] [Finite F] [CharP F 2]
    (e : (graphLocalGroup (family P) v ⧸ pCore 2 (graphLocalGroup (family P) v)) ≃* SL(2,F))
    (A W : Subgroup G) (hAW : A ≤ W) (hWH : W ≤ graphLocalGroup (family P) v)
    (hW : IsPGroup 2 W) (hi : (Q (family P) v).relIndex A = Nat.card F) :
    W = A ⊔ (W ⊓ Q (family P) v) := by
  let := finite_endpoints h
  let H := graphLocalGroup (family P) v
  let : Finite H := Finite.of_injective (inclusion (sylowGenerated_le _)) (inclusion_injective _)
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 H))
  have hk : q.ker = pCore 2 H := by
    rw [MonoidHom.ker_comp_of_injective _ _ e.injective,QuotientGroup.ker_mk']
  have hkmap : q.ker.map H.subtype = Q (family P) v := hk ▸ graphLocalGroup_core h v
  have hi' : q.ker.relIndex (A.subgroupOf H) = Nat.card F := by
    rw [←relIndex_map_map_of_injective _ _ H.subtype_injective,hkmap,
      map_subgroupOf_eq_of_le (hAW.trans hWH),hi]
  have hh := congrArg (Subgroup.map H.subtype)
    (linear_pgroup_saturation q (A.subgroupOf H) (W.subgroupOf H)
      (comap_mono hAW) hW.comap_subtype hi')
  rwa [map_subgroupOf_eq_of_le hWH,Subgroup.map_sup,
    map_subgroupOf_eq_of_le (hAW.trans hWH),
    Subgroup.map_inf _ _ _ H.subtype_injective,map_subgroupOf_eq_of_le hWH,hkmap] at hh


/-- A two-actor with the full field index fixes exactly one neighbor.
This is the literal local-action form of uniqueness for an SL2 Sylow. -/
theorem linear_local_full_index_unique_neighbor
    (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    {v x y : Vertex (family P)}
    (hx : (graph (family P)).Adj v x) (hy : (graph (family P)).Adj v y)
    {F : Type*} [Field F] [Finite F] [CharP F 2]
    (e : (graphLocalGroup (family P) v ⧸ pCore 2 (graphLocalGroup (family P) v)) ≃* SL(2,F))
    (A : Subgroup G) (hAH : A ≤ graphLocalGroup (family P) v) (hpA : IsPGroup 2 A)
    (hi : (Q (family P) v).relIndex A = Nat.card F)
    (hAx : A ≤ stabilizer (family P) x) (hAy : A ≤ stabilizer (family P) y) : y = x := by
  let := finite_endpoints h
  let Γ := family P
  let H := graphLocalGroup Γ v
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 H))
  have hk : q.ker = pCore 2 H := by
    rw [MonoidHom.ker_comp_of_injective _ _ e.injective,QuotientGroup.ker_mk']
  have hkmap : q.ker.map H.subtype = Q Γ v := hk ▸ graphLocalGroup_core h v
  let I := (A.subgroupOf H).map q
  have hpI : IsPGroup 2 I := hpA.comap_subtype.map q
  have hcI : Nat.card I = Nat.card F := by
    rw [←relIndex_ker,←relIndex_map_map_of_injective _ _ H.subtype_injective,
      hkmap,map_subgroupOf_eq_of_le hAH,hi]
  obtain ⟨T,hT⟩ := local_quotient_neighbor_stabilizer h hB hS hx e
  change ∀ l : H, q l ∈ normalizer (T : Set SL(2,F)) ↔ (l : G) • x = x at hT
  have hIN : I ≤ normalizer (T : Set SL(2,F)) := by
    rintro _ ⟨a,ha,rfl⟩
    exact (hT a).mpr (hAx ha)
  have hIT : I ≤ T := by
    have hh := hpI.inf_normalizer_sylow T
    rw [inf_eq_left.mpr hIN] at hh
    exact hh.le.trans inf_le_right
  have he : I = T := eq_of_le_of_card_ge hIT (by
    rw [hcI]
    exact (Nat.card_congr (Matrix.SpecialLinearGroup.sylowEquivAdditive F 2 T).toEquiv).ge)
  obtain ⟨g,hg,hgy⟩ := graphLocalGroup_transitive h hB hS v ⟨x,hx⟩ ⟨y,hy⟩
  change g • x = y at hgy
  let k : H := ⟨g,hg⟩
  let R := T.mapSurjective (f := (MulAut.conj (q k⁻¹)).toMonoidHom) (MulAut.conj (q k⁻¹)).surjective
  have hRN : (R : Subgroup SL(2,F)) ≤ normalizer (T : Set SL(2,F)) := by
    rintro _ ⟨t,ht,rfl⟩
    obtain ⟨a,ha,heq⟩ := he.symm ▸ ht
    have hfix : ((k⁻¹*a*k : H) : G) • x = x := by
      change (g⁻¹*(a : G)*g) • x = x
      have hay : (a : G) • y = y := hAy ha
      rw [mul_smul,mul_smul,hgy,hay,←hgy,inv_smul_smul]
    have hh := (hT (k⁻¹*a*k)).mpr hfix
    simpa only [q.map_mul,q.map_inv,heq,MulAut.conj_apply,MonoidHom.coe_comp,
      MulEquiv.coe_toMonoidHom,inv_inv] using hh
  have hRT : R = T := by
    have hh := R.isPGroup'.inf_normalizer_sylow T
    rw [inf_eq_left.mpr hRN] at hh
    exact Sylow.ext (R.is_maximal' T.isPGroup' (hh.le.trans inf_le_right)).symm
  have hkn : q k⁻¹ ∈ normalizer (T : Set SL(2,F)) :=
    mem_normalizer_iff_map_conj_eq.mpr (congrArg (fun R : Sylow 2 SL(2,F) => (R : Subgroup SL(2,F))) hRT)
  have hkfix : (k⁻¹ : H) • x = x := (hT k⁻¹).mp hkn
  change g⁻¹ • x = x at hkfix
  have hgfix : g • x = x := by
    have hh := congrArg (g • ·) hkfix
    simpa only [inv_smul_smul,smul_inv_smul] using hh.symm
  exact hgy.symm.trans hgfix


/-- If paths through the critical length are transitive, a two-edge extension
moves the original critical center into the radius-two ball. -/
theorem radius_two_escape_of_long_path
    (h : LocallyRankOneTriple P B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    {a a' v : Vertex (family P)} (hc : IsCriticalPair (family P) a a')
    {n s : ℕ} (hb : b (family P) = n+3) (hs : b (family P) ≤ s)
    (hshort : ∀ k < s, ∀ x (q : BasedWalk (graph (family P)) k x),
      q.Nonbacktracking → Regular (A := G) q)
    (p : BasedWalk (graph (family P)) (n+1) a)
    (hv : (graph (family P)).Adj p.endpoint v) (hv' : (graph (family P)).Adj v a') :
    ¬ V (family P) a 2 ≤ Q (family P) p.endpoint := by
  let Γ := family P
  let := finite_endpoints h
  have hdeg : HasTwoNeighbors (graph Γ) := by
    intro x y
    have hc := card_neighbors_of_indices Γ
      (fun i => ((Γ (!i)).subgroupOf (Γ i)).index) (fun _ => rfl) x
    have hcard : 1 < Nat.card ((graph Γ).neighborSet x) := by
      rw [hc]
      exact lt_of_lt_of_le (by decide) (source_valence_ge_three h hS x.type)
    let : Nontrivial ((graph Γ).neighborSet x) := by
      by_contra hnt
      let : Subsingleton ((graph Γ).neighborSet x) := not_nontrivial_iff_subsingleton.mp hnt
      let : Nonempty ((graph Γ).neighborSet x) := (Nat.card_pos_iff.mp (by omega : 0 < Nat.card ((graph Γ).neighborSet x))).1
      have hh := Nat.card_unique (α := (graph Γ).neighborSet x)
      omega
    obtain ⟨z,t,hzt⟩ := exists_pair_ne ((graph Γ).neighborSet x)
    by_cases he : z.val = y
    · exact ⟨t,t.property,fun ht => hzt (Subtype.ext (he.trans ht.symm))⟩
    · exact ⟨z,z.property,he⟩
  let q := p.snoc hv
  let r := q.snoc (show (graph Γ).Adj q.endpoint a' from by rw [endpoint_snoc]; exact hv')
  have hrend : r.endpoint = a' := endpoint_snoc _ _
  have hr : r.Nonbacktracking := nonbacktracking_of_geodesic r (by rw [hrend,hc.1,hb])
  have hp : p.Nonbacktracking := (nonbacktracking_snoc_iff p hv).mp
    ((nonbacktracking_snoc_iff q _).mp hr).1 |>.1
  obtain ⟨y,hy,hpy⟩ := exists_nonbacktracking_snoc hdeg (reverse p) (nonbacktracking_reverse p hp)
  obtain ⟨z,hz,ht⟩ := exists_nonbacktracking_snoc hdeg ((reverse p).snoc hy) hpy
  let t := ((reverse p).snoc hy).snoc hz
  have hact : GraphAction (graph Γ) G :=
    ⟨fun g _ _ he => (Subgroup.CosetGeometry.translationGraphIso Γ g).toHom.map_adj he⟩
  have horb : ∃ g : G, g • r.endpoint = p.endpoint := by
    apply (same_orbit_iff Γ _ _).mpr
    rw [hrend]
    have hi := hv.1
    have hj := hv'.1
    cases ha : a'.type <;> cases hvv : v.type <;> cases hw : p.endpoint.type <;> simp_all
  obtain ⟨g,hg⟩ := arcTransitive_of_short_rightRegular hact s
    (fun k x q hk hq => (hshort k hk x q hq).2) (by omega)
    (reverse r) t (nonbacktracking_reverse r hr) ht horb
  have hga : g • a = z := by
    simpa only [endpoint_reverse,t,endpoint_snoc] using
      endpoint_smul_of_vertices hact g (reverse r) t hg
  have hgw : g • a' = p.endpoint := by
    have hh := congrArg List.head? hg
    simpa only [List.head?_map,BasedWalk.head_vertices,Option.map_some,hrend,Option.some.injEq] using hh
  have hdist : (graph Γ).dist a z ≤ 2 := by
    have hy' : (graph Γ).Adj a y := by simpa only [endpoint_reverse] using hy
    have hz' : (graph Γ).Adj y z := by simpa only [endpoint_snoc] using hz
    have hh := (connected Γ h.generate).dist_triangle (u := a) (v := y) (w := z)
    rw [SimpleGraph.dist_eq_one_iff_adj.mpr hy',SimpleGraph.dist_eq_one_iff_adj.mpr hz'] at hh
    exact hh
  have hZW : Z Γ z ≤ V Γ a 2 := le_iSup_of_le z (le_iSup_of_le
    ((mem_ball_iff Γ h.generate a z 2).mpr hdist) le_rfl)
  intro htrap
  apply hc.2
  apply (map_le_map_iff_of_injective (f := (MulAut.conj g).toMonoidHom) (MulAut.conj g).injective).mp
  rw [←Z_translate,←U_translate,hga,hgw]
  exact hZW.trans (htrap.trans (source_Z_Q_U h p.endpoint).2)


end CFSG.Quasithin.ChapterF.Source.DGS85.CommutingTrivial
