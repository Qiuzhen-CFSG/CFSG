module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingTrivial.NeighborGeneration
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingTrivial.ResidualSource
public import Theory.Representation.RankOne.QuadraticRecognition.FixedGeneratedReduction

/-!
# Generation of the literal residual section by neighboring-core fixed vectors

The image of the adjacent Z generates V/C_V(O²(L)). That same Z centralizes
its own vertex core, so its image lies in the fixed space of the neighboring
core, with the actual inclusion in L proved using a common edge Sylow.
The reduced critical application combines this with the constructed section,
its nonzero vectors, residual fixed-space vanishing and quadratic actor.

This is an actor-fixed generation statement. Corrected 5.12 needs the fixed
space of a Sylow of the faithful quotient; identifying that Sylow image is
handled for a supplied linear quotient in `NeighborSylow`. No equality of
the neighboring core with a Sylow in the original local group is assumed.

Source: DGS, *Groups and Graphs* (1985), 9.1(b) and 9.3, pp.141--142,
and the published fixed-space-generation correction to 5.12.
-/

@[expose] public noncomputable section
open Subgroup Representation Representation.BinaryOffender
open Representation.RankOne.QuadraticRecognition
open Representation.NormalElementaryQuotient
namespace CFSG.Quasithin.ChapterF.Source.DGS85.CommutingTrivial
open Subgroup.CosetGeometry.RankTwo Theory.GroupTheory.AmalgamGraph
variable {G : Type*} [Group G] {P : Fin 2 → Subgroup G} {B : Subgroup G}

/-- A common edge Sylow places the entire neighboring core in the local actor. -/
theorem neighbor_core_le_localGroup (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    {v w : Vertex (family P)} (hvw : (graph (family P)).Adj v w) :
    Q (family P) w ≤ graphLocalGroup (family P) v := by
  let := finite_endpoints h
  obtain ⟨T, R, he⟩ := source_common_edge_sylow h hB hS hvw.symm
  exact (pCoreIn_le_sylow _ T).trans (he.le.trans (sylow_le_sylowGenerated _ R))

/-- The same residual-section vectors are generated by translates of the
neighboring core fixed space. -/
theorem residual_section_core_fixed_generation (h : LocallyRankOneTriple P B)
    (hB : ∃ T : Sylow 2 B, (T : Subgroup B) = pCore 2 B)
    (hS : ∀ i, ∃ T : Sylow 2 (P i), (T : Subgroup (P i)).map (P i).subtype ≤ B)
    {v w : Vertex (family P)} (hvw : (graph (family P)).Adj v w)
    (hz : Z (family P) v = omegaCenterIn (graphLocalGroup (family P) v))
    {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]
    (ρ : Representation (ZMod 2) (graphLocalGroup (family P) v) W)
    (c : BinaryConjugationSection (graphLocalGroup (family P) v) (V (family P) v 1)
      (V (family P) v 1 ⊓ centralizer ((pResidual 2 (graphLocalGroup (family P) v)).map
        (graphLocalGroup (family P) v).subtype : Set G)) ρ) :
    GeneratedByFixedSpace ρ ((Q (family P) w).subgroupOf (graphLocalGroup (family P) v)) := by
  let A := (Q (family P) w).subgroupOf (graphLocalGroup (family P) v)
  have he : fixedGeneratedSubrepresentation ρ A = ⊤ := by
    apply residual_section_neighbor_generation h hB hS hvw hz ρ c
    intro z hz'
    apply fixedSpace_le_fixedGenerated ρ A
    intro a
    change ρ a.val (c.coordinates z).toAdd = (c.coordinates z).toAdd
    rw [← c.equivariant]
    apply congrArg (fun x => (c.coordinates x).toAdd)
    apply Subtype.ext
    have hc := (CommutingNontrivial.Z_centralizes_Q (family P) w (source_Z_Q_U h w).1) hz'
    change ((a.val : G) * (z : G)) * (a.val : G)⁻¹ = z
    have hca := hc (a.val : G) a.property
    have hh : (z : G) * (a.val : G) = (a.val : G) * (z : G) := by
      simpa only [Subgroup.coe_subtype] using hca.symm
    rw [← hh, mul_assoc, mul_inv_cancel, mul_one]
  exact congrArg Subrepresentation.toSubmodule he

variable {L : Fin 2 → Subgroup G} {S : Subgroup G}

/-- On the actual reduced critical configuration, the original neighboring
core fixes a generating set of the literal residual section. -/
theorem reduced_critical_residual_actor_generated (h : HypothesisF11 L S)
    {a beta a' : Vertex (Reduction.reducedFamily L S)}
    (hc : IsCriticalPair (Reduction.reducedFamily L S) a a')
    (hab : (graph (Reduction.reducedFamily L S)).Adj a beta)
    (hd : (graph (Reduction.reducedFamily L S)).dist beta a' + 1 = b (Reduction.reducedFamily L S))
    (hb : 1 < b (Reduction.reducedFamily L S))
    (hcomm : ⁅Z (Reduction.reducedFamily L S) a, Z (Reduction.reducedFamily L S) a'⁆ = ⊥) :
    let F := Reduction.reducedFamily L S
    let H := graphLocalGroup F beta
    let A := (V F beta 1).subgroupOf H
    letI : ∀ i, Finite (F i) := finite_endpoints (Reduction.reduced_triple h)
    letI := neighborhoodIn_normal F beta H (sylowGenerated_le _)
    ∃ hb2 : 2 < b F,
      letI := neighborhoodIn_elementary F (Reduction.reduced_triple h).generate
        (fun v => (source_Z_Q_U (Reduction.reduced_triple h) v).1)
        (Reduction.reduced_kernel_sylow h) beta hb2 H
      Nontrivial (FixedQuotient A (pResidual 2 H)) ∧
      Nonempty (BinaryConjugationSection H (V F beta 1)
        (V F beta 1 ⊓ centralizer ((pResidual 2 H).map H.subtype : Set (Reduction.G₀ L S)))
        (fixedQuotientAction A (pResidual 2 H))) ∧
      fixedSpace (fixedQuotientAction A (pResidual 2 H)) (pResidual 2 H) = ⊥ ∧
      V F a' 1 ≤ H ∧
      IsQuadratic (fixedQuotientAction A (pResidual 2 H)) ((V F a' 1).subgroupOf H) ∧
      Q F a ≤ H ∧
      GeneratedByFixedSpace (fixedQuotientAction A (pResidual 2 H)) ((Q F a).subgroupOf H) := by
  let ht := Reduction.reduced_triple h
  let F := Reduction.reducedFamily L S
  let H := graphLocalGroup F beta
  let A := (V F beta 1).subgroupOf H
  let : ∀ i, Finite (F i) := finite_endpoints ht
  let := neighborhoodIn_normal F beta H (sylowGenerated_le _)
  obtain ⟨hb2, hn, hsection, hf, hV, hquad⟩ :=
    reduced_critical_residual_section h hc hab hd hb hcomm
  refine ⟨hb2, hn, hsection, hf, hV, hquad,
    neighbor_core_le_localGroup ht (Reduction.reduced_borel_core_sylow h)
      (Reduction.reduced_vertex_sylow h) hab.symm, ?_⟩
  exact residual_section_core_fixed_generation ht (Reduction.reduced_borel_core_sylow h)
    (Reduction.reduced_vertex_sylow h) hab.symm
    (Reduction.reduced_commuting_critical_geometry h hc hab hd hb hcomm).2.2.1
    _ (Classical.choice hsection)
end CFSG.Quasithin.ChapterF.Source.DGS85.CommutingTrivial
