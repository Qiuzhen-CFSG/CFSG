module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.CommutingTrivial.CartanFixedDecomposition
public import Theory.ThreeSubgroups
public import Theory.GroupTheory.Commutator.RelativeGeneration

/-!
# The Cartan-fixed commutator in DGS 9.10(5)

The middle core is the product of its intersection `N` and its Cartan
commutator. Since `N` centralizes the fixed subgroup, Hall--Witt confines
`[Q_beta,Q]` to `Z_(alpha+2)`. The commutator with the whole normal core
intersection is normal in the local actor. A conjugate of the natural
center cuts its support down to the central line `Z_beta`.

The final theorem records the next Hall--Witt step using the literal
actor generated by the two outer neighborhood modules. It displays the
remaining generation premise needed to turn commutator centralization
into centrality in the whole local group.
Source: DGS, *Groups and Graphs* (1985), 9.10(5), printed p.149.
-/

@[expose] public section
open Subgroup
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterF.Source.DGS85.CommutingTrivial
variable {G : Type*} [Group G]

/-- The first Hall--Witt step in (5), using the actual core decomposition
rather than assuming equality with its iterated Cartan commutator. -/
theorem cartan_fixed_commutator_le_neighbor_center
    (B N Q V T X : Subgroup G)
    (hB : B = N ⊔ ⁅B,T⁆) (hNQ : ⁅N,Q⁆ = ⊥)
    (hQT : ⁅Q,T⁆ = ⊥) (hBQ : ⁅B,Q⁆ ≤ V) (hVT : ⁅V,T⁆ ≤ X)
    (hBX : B ≤ normalizer (X : Set G))
    (hTX : T ≤ normalizer (X : Set G))
    (hQX : Q ≤ normalizer (X : Set G)) : ⁅B,Q⁆ ≤ X := by
  have hrot : ⁅⁅T,B⁆,Q⁆ ≤ X :=
    commutator_commutator_le_of_rotate_of_le_normalizer hTX hBX hQX
      ((commutator_mono hBQ le_rfl).trans hVT)
      (by rw [hQT,commutator_bot_left]; exact bot_le)
  conv_lhs => rw [hB]
  exact commutator_sup_le_of_relative_normal B N ⁅B,T⁆ Q X hBX
    (le_sup_left.trans hB.ge) (le_sup_right.trans hB.ge) (hNQ.le.trans bot_le)
    (by simpa only [commutator_comm T B] using hrot)

/-- Normality of the whole core-intersection commutator cuts the preceding
neighbor-center bound down to the central line. -/
theorem cartan_fixed_commutator_le_central_line
    (B N Q V T X Z M : Subgroup G) [IsMulCommutative Q]
    (hN : N = Q ⊔ V) (hQV : ⁅Q,V⁆ = ⊥)
    (hB : B = N ⊔ ⁅B,T⁆) (hQT : ⁅Q,T⁆ = ⊥)
    (hBQ : ⁅B,Q⁆ ≤ V) (hVT : ⁅V,T⁆ ≤ X) (hBV : ⁅B,V⁆ ≤ Z) (hZX : Z ≤ X)
    (hBX : B ≤ normalizer (X : Set G))
    (hTX : T ≤ normalizer (X : Set G))
    (hQX : Q ≤ normalizer (X : Set G))
    (hMB : M ≤ normalizer (B : Set G)) (hMN : M ≤ normalizer (N : Set G))
    (g : G) (hg : g ∈ M)
    (hcut : X.map (MulAut.conj g).toMonoidHom ⊓ X ≤ Z) : ⁅B,Q⁆ ≤ Z := by
  have hNQ : ⁅N,Q⁆ = ⊥ := by
    apply commutator_eq_bot_iff_le_centralizer.mpr
    rw [hN]
    exact sup_le (le_centralizer Q)
      (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hQV))
  have hcomm := cartan_fixed_commutator_le_neighbor_center B N Q V T X
    hB hNQ hQT hBQ hVT hBX hTX hQX
  have hBNX : ⁅B,N⁆ ≤ X := by
    rw [commutator_comm,hN]
    exact commutator_sup_le_of_relative_normal B Q V B X hBX
      ((hN ▸ le_sup_left).trans (hB ▸ le_sup_left))
      ((hN ▸ le_sup_right).trans (hB ▸ le_sup_left))
      ((commutator_comm Q B).trans_le hcomm)
      ((commutator_comm V B).trans_le (hBV.trans hZX))
  have hconj : (⁅B,N⁆).map (MulAut.conj g).toMonoidHom = ⁅B,N⁆ := by
    have heB : B.map (MulAut.conj g).toMonoidHom = B :=
      mem_normalizer_iff_map_conj_eq.mp (hMB hg)
    have heN : N.map (MulAut.conj g).toMonoidHom = N :=
      mem_normalizer_iff_map_conj_eq.mp (hMN hg)
    rw [map_commutator,heB,heN]
  have hother : ⁅B,N⁆ ≤ X.map (MulAut.conj g).toMonoidHom := by
    simpa only [hconj] using map_mono (f := (MulAut.conj g).toMonoidHom) hBNX
  exact (commutator_mono le_rfl (hN ▸ le_sup_left)).trans ((le_inf hother hBNX).trans hcut)

/-- The second Hall--Witt step in (5): the outer-module actor centralizes
both the fixed subgroup and its core commutator, so its commutator with
the core also centralizes the fixed subgroup. -/
theorem cartan_fixed_centralizes_core_actor_commutator
    (B Q W Z : Subgroup G)
    (hBQ : ⁅B,Q⁆ ≤ Z) (hQW : ⁅Q,W⁆ = ⊥) (hZW : ⁅Z,W⁆ = ⊥) :
    ⁅Q,⁅B,W⁆⁆ = ⊥ := by
  rw [commutator_comm]
  apply commutator_commutator_eq_bot_of_rotate
  · rw [commutator_comm W Q,hQW,commutator_bot_left]
  · apply bot_unique
    exact (commutator_mono ((commutator_comm Q B).trans_le hBQ) le_rfl).trans hZW.le

/-- Naturality of the core quotient supplies `B = N[B,W]`. Together with
the second Hall--Witt step, this makes the common fixed subgroup central
in the full local actor `L = BW`. -/
theorem cartan_fixed_centralizes_local_actor
    (B N Q W Z L : Subgroup G)
    (hB : B = N ⊔ ⁅B,W⁆) (hL : L = B ⊔ W)
    (hQN : ⁅Q,N⁆ = ⊥) (hQW : ⁅Q,W⁆ = ⊥)
    (hBQ : ⁅B,Q⁆ ≤ Z) (hZW : ⁅Z,W⁆ = ⊥) : ⁅Q,L⁆ = ⊥ := by
  have hQBW := cartan_fixed_centralizes_core_actor_commutator B Q W Z hBQ hQW hZW
  have hBQzero : B ≤ centralizer (Q : Set G) := by
    rw [hB]
    exact sup_le (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hQN))
      (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hQBW))
  apply commutator_eq_bot_iff_le_centralizer.mpr
  apply le_centralizer_iff.mpr
  rw [hL]
  exact sup_le hBQzero (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hQW))

end CFSG.Quasithin.ChapterF.Source.DGS85.CommutingTrivial
