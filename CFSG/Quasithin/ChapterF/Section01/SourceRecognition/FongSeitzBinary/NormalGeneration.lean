module
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.NormalGeneration
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.FongSeitzBinary.QuotientReduction

/-!
# Normal generation in the original marked source quotient

The original carrier is generated by L₀,L₁,S. If the two factors are
perfect and S is a two-group, their images in the same marked finite
quotient lie in the normal closure of its specified unipotent subgroup.
Mapping the literal generation equality through that quotient map proves
that this normal closure is the whole quotient, as is O^{2′} of it.
Finiteness is required of the quotient, not of the original completion.
The actual F.1.1 Sylow subgroup S maps to the specified U: transport
S through the marked Borel isomorphism and use normality and the odd
index of U in that Borel. No conjugation changes the original S marking.

This discharges the unipotent-normal-generation step for the selected
perfect-factor consumer of DGS Theorem D, printed p.224. The faithful
quotient, splitness and marking hypotheses retain the earlier apartment
and quotient producer qt-dgs85-apartment-exchange. The irreducibility,
full minimal-configuration reduction and seven regular Lie rows remain
unproved here; all source-theorem premise discharge stays with the
original assembly owners.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open Theory.AlgebraicGroup.TitsSystem.SourceBinary
namespace CFSG.Quasithin.ChapterF.Source.FongSeitzBinary
variable {G : Type*} [Group G] {L : Fin 2 → Subgroup G} {S : Subgroup G}

/-- The original Sylow subgroup of the whole source Borel maps to the
specified U, using the same quotient map as both endpoint markings. -/
theorem quotient_sourceS_image_eq_unipotent (h : HypothesisF11 L S)
    (Q : SourceQuotient L S) (split : SplitData Q.tits) :
    (S.subgroupOf (generated L S)).map Q.q = split.U := by
  let C := commonBorel L S
  have hCY : C ≤ generated L S :=
    (commonBorel_le_parabolic 0).trans (parabolic_le_generated 0)
  let e : C ≃* Q.tits.B :=
    (MulEquiv.subgroupCongr (lemma_F_1_3_6 h).symm).trans (originalMarkedIso Q).middle
  have he : Q.tits.B.subtype.comp e.toMonoidHom = Q.q.comp (inclusion hCY) := by
    ext x
    exact originalMarkedIso_middle_apply Q _
  let := h.finite_commonBorel
  obtain ⟨P, hP⟩ := h.sylow_commonBorel
  have hP0 : (P : Subgroup C).map (inclusion hCY) = S.subgroupOf (generated L S) := by
    apply map_injective (generated L S).subtype_injective
    rw [map_subgroupOf_eq_of_le (show S ≤ generated L S from le_sup_right), map_map]
    exact hP
  let Pbar : Sylow 2 Q.tits.B := P.mapSurjective (f := e.toMonoidHom) e.surjective
  have hPbar : (Pbar : Subgroup Q.tits.B).map Q.tits.B.subtype =
      (S.subgroupOf (generated L S)).map Q.q := by
    change ((P : Subgroup C).map e.toMonoidHom).map Q.tits.B.subtype = _
    rw [map_map, he, ← map_map, hP0]
  let U := split.U.subgroupOf Q.tits.B
  let : U.Normal := normal_subgroupOf_of_le_normalizer split.normalizes
  have hU : IsPGroup 2 U := split.isTwo.comap_subtype
  have hUP : U ≤ Pbar := hU.le_sylow_of_normal Pbar
  have hPU : (Pbar : Subgroup Q.tits.B) = U :=
    (hU.toSylow split.borel_index_not_two).is_maximal' Pbar.isPGroup' hUP
  rw [← hPbar, hPU, map_subgroupOf_eq_of_le split.U_le]

/-- Perfect original factors and the original two-subgroup force normal
generation of the finite quotient by its actual unipotent subgroup. -/
theorem quotient_unipotentClosure_eq_top (hS : IsPGroup 2 S)
    (hp : ∀ i, Group.IsPerfect (L i)) (d : SourceQuotient L S)
    (split : SplitData d.tits) : split.unipotentClosure = ⊤ := by
  let A (i : Fin 2) := ((L i).subgroupOf (generated L S)).map d.q
  let P := (S.subgroupOf (generated L S)).map d.q
  apply split.unipotentClosure_eq_top_of_generation A P
  · intro i
    let := hp i
    let e := subgroupOfEquivOfLe (local_le_generated (L := L) (S := S) i)
    let : Group.IsPerfect ((L i).subgroupOf (generated L S)) :=
      Group.IsPerfect.ofSurjective (f := e.symm.toMonoidHom) e.symm.surjective
    exact Group.IsPerfect.map d.q
  · exact hS.comap_subtype.map d.q
  · change ((L 0).subgroupOf (generated L S)).map d.q ⊔
      ((L 1).subgroupOf (generated L S)).map d.q ⊔
      (S.subgroupOf (generated L S)).map d.q = ⊤
    rw [← Subgroup.map_sup, ← Subgroup.map_sup,
      ← subgroupOf_sup (local_le_generated 0) (local_le_generated 1),
      ← subgroupOf_sup (sup_le (local_le_generated 0) (local_le_generated 1))
        (show S ≤ generated L S from le_sup_right)]
    change ((generated L S).subgroupOf (generated L S)).map d.q = ⊤
    rw [subgroupOf_self, ← MonoidHom.range_eq_map]
    exact MonoidHom.range_eq_top_of_surjective _ (QuotientGroup.mk'_surjective _)

/-- The same quotient is its prime-to-two residual O^{2′}, with no
finiteness assumption on the original completion. -/
theorem quotient_primeToResidual_eq_top (hS : IsPGroup 2 S)
    (hp : ∀ i, Group.IsPerfect (L i)) (d : SourceQuotient L S)
    (split : SplitData d.tits) : primeToResidual 2 ((generated L S) ⧸ d.D) = ⊤ := by
  rw [← split.unipotentClosure_eq_primeToResidual]
  exact quotient_unipotentClosure_eq_top hS hp d split

end CFSG.Quasithin.ChapterF.Source.FongSeitzBinary
