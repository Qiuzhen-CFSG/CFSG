module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.FongSeitzBinary.PerfectQuotient
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.RootGeneration

/-!
# Generation and simplicity of the whole perfect-source quotient

The ordered positive-root theorem removes the last root-generation premise
from the whole-quotient reduction. Both original perfect factors contain
their actual simple roots. Their two-residual is normal, hence contains U;
the original factor generation gives Y = O²(Y). The previously established
simple socle is therefore the entire same finite marked quotient.

The subgroup generated by Weyl-conjugate roots is also the whole quotient.
This discharges global generation for any compatible family of source root
parameters covering those actual subgroups. It does not construct the
fields, mixed commutator relations, permissible Weyl orders or seven Lie
comparisons. Both-perfectness and the independently supplied split quotient
remain explicit; no nonperfect branch is claimed.

Source: DGS, Groups and Graphs, Part II, pp.80–81 and Theorem D, p.224;
Carter 2.5.10–2.5.17 for the ordered-root input.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open Theory.AlgebraicGroup.TitsSystem.SourceBinary
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.RootCoordinates
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.RootGeneration
namespace CFSG.Quasithin.ChapterF.Source.FongSeitzBinary.MarkedLocal
variable {G X : Type*} [Group G] [Group X]
  {L : Fin 2 → Subgroup G} {S : Subgroup G} {P : Fin 2 → Subgroup X}
  (Q : MarkedQuotient P)
  (e : RankTwoAmalgam.Iso
    (RankTwoAmalgam.ofSubgroups (parabolic L S 0)
      (parabolic L S 0 ⊓ parabolic L S 1) (parabolic L S 1) inf_le_left inf_le_right)
    Q.standardAmalgam)
  (h : HypothesisF11 L S) (hp : ∀ i, Group.IsPerfect (L i))
  (split : SplitData Q.tits)

include e h hp split in
/-- Ordered roots and the original Cartan argument contain the whole U in O²(Y). -/
theorem unipotent_le_twoResidual : split.U ≤ pResidual 2 (X ⧸ Q.D) :=
  unipotent_le_normal_of_simpleRoots_le Q split _ (simpleRoot_le_twoResidual Q e h hp split)

include e h hp split in
/-- The actual finite quotient is its own two-residual, with no generation premise. -/
theorem twoResidual_eq_top : pResidual 2 (X ⧸ Q.D) = ⊤ := by
  have hgen := factors_generate Q e h
  rw [sylow_range Q e h split, ← (perfect_residual Q e h hp split).1] at hgen
  exact top_unique (hgen ▸ sup_le le_rfl (unipotent_le_twoResidual Q e h hp split))

include e h hp split in
/-- Perfectness is now proved for the entire marked quotient. -/
theorem quotient_isPerfect : Group.IsPerfect (X ⧸ Q.D) := by
  let := (perfect_residual Q e h hp split).2
  let f := (MulEquiv.subgroupCongr (twoResidual_eq_top Q e h hp split)).trans
    Subgroup.topEquiv
  exact Group.IsPerfect.ofSurjective (f := f.toMonoidHom) f.surjective

include e h hp split in
/-- The whole finite marked quotient, not only its residual, is simple. -/
theorem quotient_isSimple : IsSimpleGroup (X ⧸ Q.D) := by
  let := twoResidual_isSimple Q e h hp split
  let f := (MulEquiv.subgroupCongr (twoResidual_eq_top Q e h hp split)).trans
    Subgroup.topEquiv
  exact f.symm.isSimpleGroup

include e h hp split in
/-- Actual Weyl-conjugate root subgroups generate the entire original marking. -/
theorem weylRootSpan_eq_top : weylRootSpan Q split = ⊤ := by
  rw [weylRootSpan_eq_unipotentClosure, unipotentClosure_eq_top Q e h hp split]

include e h hp split in
/-- Literal root parameters generate as soon as their ranges cover the actual Weyl roots. -/
theorem root_parameters_generate {ι A : Type*} (x : ι → A → X ⧸ Q.D)
    (hcover : ∀ (i : Fin 2) (w : Weyl Q),
      ∃ j, (rightConjugate (simpleRoot Q split i) (representative w : X ⧸ Q.D) : Set (X ⧸ Q.D)) ⊆
        Set.range (x j)) :
    closure {g | ∃ j a, g = x j a} = ⊤ := by
  apply top_unique
  rw [← weylRootSpan_eq_top Q e h hp split, weylRootSpan_eq_iSup_weyl]
  apply iSup_le
  intro i
  apply iSup_le
  intro n g hg
  obtain ⟨j,hj⟩ := hcover i n
  obtain ⟨a,ha⟩ := hj hg
  exact subset_closure ⟨j,a,ha.symm⟩

end CFSG.Quasithin.ChapterF.Source.FongSeitzBinary.MarkedLocal

namespace CFSG.Quasithin.ChapterF.Source.FongSeitzBinary
variable {G : Type*} [Group G] {L : Fin 2 → Subgroup G} {S : Subgroup G}

/-- The original source quotient is perfect with its literal q and both endpoints retained. -/
theorem quotient_isPerfect (h : HypothesisF11 L S) (hp : ∀ i, Group.IsPerfect (L i))
    (Q : SourceQuotient L S) (split : SplitData Q.tits) :
    Group.IsPerfect ((generated L S) ⧸ Q.D) :=
  MarkedLocal.quotient_isPerfect Q (originalMarkedIso Q) h hp split

/-- The original source quotient is simple; ordered-root generation is discharged. -/
theorem quotient_isSimple (h : HypothesisF11 L S) (hp : ∀ i, Group.IsPerfect (L i))
    (Q : SourceQuotient L S) (split : SplitData Q.tits) :
    IsSimpleGroup ((generated L S) ⧸ Q.D) :=
  MarkedLocal.quotient_isSimple Q (originalMarkedIso Q) h hp split

end CFSG.Quasithin.ChapterF.Source.FongSeitzBinary
