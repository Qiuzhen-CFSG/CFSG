module
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.C2Presentation.Weyl
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.FongSeitzBinary.SymplecticFourPresentation.GeometricApplication

/-!
# Weyl and Cartan maps on the geometric C₂ quotient

The original marked result has a same-quotient geometric counterpart. The
proved formulas retain the quotient map out of the universal completion,
place the full coroot torus inside the actual Borel, and preserve the split
simple-root orientation. No descent to the group generated by the original
endpoints is asserted. Source: DGS Theorem D, pp.224–226.
-/

public noncomputable section
namespace CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.ApartmentExchange
open Theory.GroupTheory Theory.GroupTheory.WeakBNPair.RegularTree
open Theory.AlgebraicGroup.TitsSystem.SourceBinary
open Theory.SpecificGroups.SymplecticFour.RootPresentation
open Subgroup.CosetGeometry RankTwoAmalgam
universe u
variable {L B R : Type u} [Group L] [Group B] [Group R]
variable (α : RankTwoAmalgam L B R) (T : Set (SourceVertex α)) (n : ℕ)
variable (hL : Function.Injective α.left) (hR : Function.Injective α.right)
variable (hbase : ∀ i, base (Universal.cosetFamily α) i ∈ T)
variable (hdeg : TwoNeighborsIn (sourceGraph α) T)
variable (htrans : BasedPathTransitive (X := α.Universal) (sourceGraph α) (n+1))
variable (hline : NoBranchingIn (sourceGraph α) T)
variable (hunique : ApartmentsUnique (X := α.Universal) (sourceGraph α) T (n+1))
variable (hexchange : ChosenApartmentExchange (X := α.Universal) (sourceGraph α) T n)
variable (hn : 1 < n)
variable (hcore : ((Universal.left α).range ⊓ (Universal.right α).range).normalCore = ⊥)
variable (d : RootQuotientData (quotientMap α T n))
variable (hB : d.B = originalMiddle α)
variable (hP : ∀ i, d.endpoint i = Universal.cosetFamily α i)
variable (hBN : d.B.map (quotientMap α T n) ⊓ d.N.map (quotientMap α T n) =
  (d.B ⊓ d.N).map (quotientMap α T n))

local notation "Q" => recognitionQuotient α T n hL hR hbase hdeg htrans hline hunique
  hexchange hn hcore d hB hP hBN

variable {F : Type*} [Field F]

variable [Finite F] [CharP F 2]

/-- All negative-simple-root parameters have the original geometric orientation. -/
theorem geometric_c2_negative_simple_roots [Finite L] [Finite R]
    (split : SplitData (Q).tits) (roots : C2Presentation.RootData (F := F) Q split) (t : F) :
    roots.x 3 (.ofAdd t) ∈ (Q).tits.standardParabolic {(Q).simple 0} ∧
      roots.x 7 (.ofAdd t) ∈ (Q).tits.standardParabolic {(Q).simple 1} :=
  ⟨roots.negative_long_all t, roots.negative_short_all t⟩

/-- The two-dimensional coroot map lands in the literal full geometric Borel. -/
theorem geometric_c2_torus_borel [Finite L] [Finite R]
    (split : SplitData (Q).tits) (roots : C2Presentation.RootData (F := F) Q split)
    (p : Fˣ × Fˣ) : roots.torusPairHom p ∈ (Q).tits.B := roots.torusPairHom_mem_borel p

/-- Weyl conjugation on the SAME quotient of the universal completion. -/
theorem geometric_c2_weyl_action [Finite L] [Finite R]
    (split : SplitData (Q).tits) (roots : C2Presentation.RootData (F := F) Q split)
    (i : Fin 2) (t : Fˣ) (r : Fin 8) (u : F) :
    roots.weylWord i t * roots.x r (.ofAdd u) * (roots.weylWord i t)⁻¹ =
      roots.x (simpleReflection i r) (.ofAdd ((simpleFactor i t r : F)*u)) :=
  roots.weylWord_conj i t r u

end CFSG.Quasithin.ChapterF.Section01.SourceRecognition.DGS85.ApartmentExchange
