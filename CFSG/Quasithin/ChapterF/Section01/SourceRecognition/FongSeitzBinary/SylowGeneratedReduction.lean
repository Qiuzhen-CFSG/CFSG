module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.FongSeitzBinary.MarkedLocal
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.CharacteristicTwoReduction
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.RootGeneration

/-!
# The source reduction with nonperfect local factors retained

Every original F.1.1 factor is normally generated by its local Sylow:
otherwise the unique proper Sylow overgroup and Frattini's argument
contradict the proper Sylow normalizer. Mapping those Sylows into the
same U proves Y = U^Y without either local perfectness premise. This
identifies Fong–Seitz's G₀ with the entire given quotient, including the
small nonperfect branches, and makes its actual Weyl roots generate Y.

The characteristic-two reduction gives a perfect nonabelian minimal
normal subgroup O²(Y). If just one original factor is perfect, its full
Sylow normalization collapses the simple power to one factor. Neither
the whole quotient nor both original factors are declared perfect here.

Source: Fong–Seitz I, Theorem A and (1A), pp.1–3; the local hypotheses
are Aschbacher–Smith F.1.1–3, pp.259–260. The original/geometric marking
retains both inclusion squares and the full Borel throughout. The earlier
marked split quotient is still supplied by the apartment/exchange owner;
permissible Weyl orders, field compatibility and the seven Lie comparisons
remain source obligations of the recognition assembly.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open Theory.AlgebraicGroup.TitsSystem.SourceBinary
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.RootCoordinates
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.RootGeneration
namespace CFSG.Quasithin.ChapterF.Source.FongSeitzBinary.MarkedLocal
variable {G X : Type*} [Group G] [Group X]
  {L : Fin 2 → Subgroup G} {S : Subgroup G} {P : Fin 2 → Subgroup X}
  (Q : MarkedQuotient P)
  (e : RankTwoAmalgam.Iso
    (RankTwoAmalgam.ofSubgroups (parabolic L S 0)
      (parabolic L S 0 ⊓ parabolic L S 1) (parabolic L S 1) inf_le_left inf_le_right)
    Q.standardAmalgam)

include e in
/-- The original rank-one Sylows normally generate every local factor. -/
theorem unipotentClosure_eq_top_of_source (h : HypothesisF11 L S) (split : SplitData Q.tits) :
    split.unipotentClosure = ⊤ := by
  have hA (i : Fin 2) : (factorMap Q e i).range ≤ split.unipotentClosure := by
    let := h.finite_local i
    obtain ⟨T, hT⟩ := h.sylow i
    have hf := rankOneSylowFacts_of_rankOneQuotient (h.quotient i) T
    have hgen := local_normalClosure_eq_top T hf.proper hf.unique_maximal
    have hTle : (T : Subgroup (L i)) ≤
        split.unipotentClosure.comap (factorMap Q e i) := by
      intro t ht
      apply le_normalClosure
      rw [← sylow_range Q e h split]
      have hs : (t : G) ∈ S := (hT.le (mem_map_of_mem (L i).subtype ht)).1
      exact ⟨⟨t, hs⟩, (endpoint_sylow Q e h i ⟨t,hs⟩).symm⟩
    have htop : (⊤ : Subgroup (L i)) ≤
        split.unipotentClosure.comap (factorMap Q e i) := by
      rw [← hgen]
      exact normalClosure_le_normal hTle
    rintro _ ⟨a, rfl⟩
    exact htop (mem_top a)
  apply top_unique
  rw [← factors_generate Q e h, sylow_range Q e h split]
  exact sup_le (sup_le (hA 0) (hA 1)) le_normalClosure
include e

/-- The actual Weyl roots generate even if neither original local factor is perfect. -/
theorem weylRootSpan_eq_top_of_source (h : HypothesisF11 L S) (split : SplitData Q.tits) :
    weylRootSpan Q split = ⊤ := by
  rw [weylRootSpan_eq_unipotentClosure, unipotentClosure_eq_top_of_source Q e h split]

/-- Compatible parameters covering the canonical Weyl roots generate the whole quotient. -/
theorem root_parameters_generate_of_source (h : HypothesisF11 L S) (split : SplitData Q.tits)
    {ι A : Type*} (x : ι → A → X ⧸ Q.D)
    (hcover : ∀ (i : Fin 2) (w : Weyl Q),
      ∃ j, (rightConjugate (simpleRoot Q split i) (representative w : X ⧸ Q.D) :
        Set (X ⧸ Q.D)) ⊆ Set.range (x j)) :
    closure {g | ∃ j a, g = x j a} = ⊤ := by
  apply top_unique
  rw [← weylRootSpan_eq_top_of_source Q e h split, weylRootSpan_eq_iSup_weyl]
  apply iSup_le
  intro i
  apply iSup_le
  intro n g hg
  obtain ⟨j,hj⟩ := hcover i n
  obtain ⟨a,ha⟩ := hj hg
  exact subset_closure ⟨j,a,ha.symm⟩

/-- The two-residual is perfect without a perfect-local-factor premise. -/
theorem twoResidual_isPerfect_of_source (h : HypothesisF11 L S) (split : SplitData Q.tits) :
    Group.IsPerfect (pResidual 2 (X ⧸ Q.D)) :=
  Q.twoResidual_isPerfect split (parabolic_core_selfCentralizing Q e h)
    (unipotentClosure_eq_top_of_source Q e h split)

/-- The same source quotient's two-residual is its solvable residual. -/
theorem twoResidual_eq_solvableResidual_of_source
    (h : HypothesisF11 L S) (split : SplitData Q.tits) :
    pResidual 2 (X ⧸ Q.D) = solvableResidual (X ⧸ Q.D) :=
  Q.twoResidual_eq_solvableResidual split (parabolic_core_selfCentralizing Q e h)
    (unipotentClosure_eq_top_of_source Q e h split)

/-- The full Borel's Fitting subgroup is the specified U, with its inclusion retained. -/
theorem borel_fitting_eq_unipotent_of_source
    (h : HypothesisF11 L S) (split : SplitData Q.tits) :
    fittingSubgroup Q.tits.B = split.U.subgroupOf Q.tits.B :=
  Q.borel_fitting_eq_unipotent split (parabolic_core_selfCentralizing Q e h)

/-- The finite source reduction retains the full quotient and its perfect minimal normal subgroup. -/
theorem minimal_normal_reduction (h : HypothesisF11 L S) (split : SplitData Q.tits) :
    let R := pResidual 2 (X ⧸ Q.D)
    R ≠ ⊥ ∧ Group.IsPerfect R ∧
      (∀ V : Subgroup (X ⧸ Q.D), V.Normal → V ≠ ⊥ → R ≤ V) ∧
      centralizer (R : Set (X ⧸ Q.D)) = ⊥ ∧ IsPGroup 2 ((X ⧸ Q.D) ⧸ R) ∧
      R ⊔ (sylowMap Q e h).range = ⊤ := by
  have hc := parabolic_core_selfCentralizing Q e h
  have hgen := unipotentClosure_eq_top_of_source Q e h split
  have hp := twoResidual_isPerfect_of_source Q e h split
  refine ⟨Q.twoResidual_ne_bot split, hp, ?_,
    Q.twoResidual_centralizer_eq_bot split hc hgen hp, isPGroup_quotient_pResidual 2, ?_⟩
  · intro V hV hn
    let := hV
    exact Q.twoResidual_le_normal split hc hgen V hn
  · rw [sylow_range Q e h split]
    exact Q.normal_subgroup_sup_unipotent split hc hgen _ (Q.twoResidual_ne_bot split)

/-- One perfect original factor suffices for simplicity of the same two-residual. -/
theorem twoResidual_isSimple_of_perfect_factor (h : HypothesisF11 L S) (split : SplitData Q.tits)
    (i : Fin 2) (hp : Group.IsPerfect (L i)) :
    IsSimpleGroup (pResidual 2 (X ⧸ Q.D)) := by
  let := h.finite_local i
  let := hp
  let : Nontrivial (L i) := (L i).nontrivial_iff_ne_bot.mpr
    (ne_bot_of_gt (h.rankOneBorelFacts i).proper)
  let f := factorMap Q e i
  have hf : Function.Injective f :=
    (Q.tits.standardParabolic {Q.simple i}).subtype_injective.comp
      ((endpoint Q e i).injective.comp (inclusion_injective _))
  have hfK : f.range ≤ pResidual 2 (X ⧸ Q.D) := by
    let : Group.IsPerfect f.range := Group.IsPerfect.ofSurjective f.rangeRestrict_surjective
    let : Group.IsNilpotent ((X ⧸ Q.D) ⧸ pResidual 2 (X ⧸ Q.D)) :=
      (isPGroup_quotient_pResidual 2).isNilpotent
    exact le_of_isPerfect_of_solvable_quotient _ _
  obtain ⟨T, hT⟩ := h.sylow i
  have hTU : (T : Subgroup (L i)).map f ≤ split.U := by
    rw [← sylow_range Q e h split]
    rintro _ ⟨t, ht, rfl⟩
    have hs : (t : G) ∈ S := (hT.le (mem_map_of_mem (L i).subtype ht)).1
    exact ⟨⟨t, hs⟩, (endpoint_sylow Q e h i ⟨t,hs⟩).symm⟩
  have facts := rankOneSylowFacts_of_rankOneQuotient (h.quotient i) T
  have hgen := unipotentClosure_eq_top_of_source Q e h split
  have hc := parabolic_core_selfCentralizing Q e h
  exact Q.twoResidual_isSimple_of_local_factor split hc hgen
    (Q.twoResidual_isPerfect split hc hgen) f hf hfK (unipotent_normalizes Q e h split i)
    T hTU facts.proper facts.unique_maximal facts.solvable
end CFSG.Quasithin.ChapterF.Source.FongSeitzBinary.MarkedLocal

namespace CFSG.Quasithin.ChapterF.Source.FongSeitzBinary
variable {G : Type*} [Group G] {L : Fin 2 → Subgroup G} {S : Subgroup G}

/-- Fong–Seitz's normal closure G₀ is the whole literal source quotient. -/
theorem quotient_unipotentClosure_eq_top_of_source (h : HypothesisF11 L S)
    (Q : SourceQuotient L S) (split : SplitData Q.tits) : split.unipotentClosure = ⊤ :=
  MarkedLocal.unipotentClosure_eq_top_of_source Q (originalMarkedIso Q) h split

/-- Nonperfect endpoints still give a perfect residual in the original finite quotient. -/
theorem quotient_twoResidual_isPerfect (h : HypothesisF11 L S)
    (Q : SourceQuotient L S) (split : SplitData Q.tits) :
    Group.IsPerfect (pResidual 2 ((generated L S) ⧸ Q.D)) :=
  MarkedLocal.twoResidual_isPerfect_of_source Q (originalMarkedIso Q) h split

/-- Simplicity of the original residual uses only one perfect original factor. -/
theorem quotient_twoResidual_isSimple_of_perfect_factor (h : HypothesisF11 L S)
    (Q : SourceQuotient L S) (split : SplitData Q.tits)
    (i : Fin 2) (hp : Group.IsPerfect (L i)) :
    IsSimpleGroup (pResidual 2 ((generated L S) ⧸ Q.D)) :=
  MarkedLocal.twoResidual_isSimple_of_perfect_factor Q (originalMarkedIso Q) h split i hp

end CFSG.Quasithin.ChapterF.Source.FongSeitzBinary
