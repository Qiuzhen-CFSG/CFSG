module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.FongSeitzBinary.LocalFactorEmbedding
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.FongSeitzBinary.SylowGeneratedReduction
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.LocalClosureNormal

/-!
# Original factor quotients as regular local covers, without perfectness

Every original F.1.1 factor is normally generated by its local Sylow.
Normality of C = ⟨U,Uˢ⟩ therefore puts the entire factor inside C.
The literal factor map followed by C → C/(U intersect K) has kernel
exactly O₂(L). If (2B) holds and the canonical root has the order of the
original quotient Sylow, those Sylow images have equal order. They give
U inside L(U intersect K), hence C = L(U intersect K). The resulting
quotient map is an isomorphism, including nonperfect factors and scalars.

The smaller canonical root group is already isomorphic to C/(U intersect K).
Transport constructs its comparison with L/O₂(L), without claiming that
it lies in the original L. If the original quotient is centerless, the
central panel kernel vanishes and the same local permutation image is
identified. The original whole-cover map is checked on both factor and
root representatives. SuzukiAllLocalIdentification discharges the two
premises at every Suzuki parameter; other row selection remains separate.

Source: Fong--Seitz I (5B)--(5C), pp.25--26; AS F.1.1--3, pp.259--260.
The finite marked quotient and full-Borel endpoint squares remain the
unchanged genuine apartment/quotient input.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open Theory.AlgebraicGroup.TitsSystem.SourceBinary
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.RootCoordinates
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.HexagonStructure
namespace CFSG.Quasithin.ChapterF.Source.FongSeitzBinary.MarkedLocal
variable {G X : Type*} [Group G] [Group X]
  {L : Fin 2 → Subgroup G} {S : Subgroup G} {P : Fin 2 → Subgroup X}
  (Q : MarkedQuotient P)
  (e : RankTwoAmalgam.Iso
    (RankTwoAmalgam.ofSubgroups (parabolic L S 0)
      (parabolic L S 0 ⊓ parabolic L S 1) (parabolic L S 1) inf_le_left inf_le_right)
    Q.standardAmalgam)
  (h : HypothesisF11 L S) (split : SplitData Q.tits) (i : Fin 2)

include h in
/-- Every original factor lies in the whole-root closure, including nonperfect factors. -/
theorem factor_le_localClosure : (factorMap Q e i).range ≤ localClosure Q split i := by
  let := h.finite_local i
  obtain ⟨T,hT⟩ := h.sylow i
  let C := (localClosure Q split i).comap (factorMap Q e i)
  have hfactor : (factorMap Q e i).range ≤ Q.tits.standardParabolic {Q.simple i} := by
    rintro _ ⟨a,rfl⟩
    exact (factorInEndpoint Q e i a).property
  let : C.Normal := by
    constructor
    intro x hx g
    change factorMap Q e i (g*x*g⁻¹) ∈ localClosure Q split i
    rw [map_mul,map_mul,map_inv]
    exact (mem_normalizer_iff.mp
      (LocalCover.closure_parabolic_normalizes Q split i (hfactor ⟨g,rfl⟩)) _).mp hx
  have ht : (T : Subgroup (L i)) ≤ C := by
    intro t ht
    apply (show split.U ≤ localClosure Q split i from le_sup_left)
    change t ∈ split.U.comap (factorMap Q e i)
    rw [factor_unipotent_comap Q e h split i, ← hT]
    exact mem_map_of_mem (L i).subtype ht
  have hf := rankOneSylowFacts_of_rankOneQuotient (h.quotient i) T
  have htop : (⊤ : Subgroup (L i)) ≤ C := by
    rw [← local_normalClosure_eq_top T hf.proper hf.unique_maximal]
    exact normalClosure_le_normal ht
  rintro _ ⟨a,rfl⟩
  exact htop (mem_top a)

/-- The original factor embedding, with codomain restricted to the whole-root closure. -/
def factorIntoClosure : L i →* localClosure Q split i :=
  (factorMap Q e i).codRestrict _ (fun a => factor_le_localClosure Q e h split i ⟨a,rfl⟩)

/-- Restricting the codomain preserves the literal original factor map. -/
@[simp] theorem factorIntoClosure_coe (a : L i) :
    (factorIntoClosure Q e h split i a : X ⧸ Q.D) = factorMap Q e i a := by rfl

/-- The original factor followed by the literal local-cover quotient. -/
def factorCoverMap : L i →* LocalCover.CoverGroup Q split i :=
  (QuotientGroup.mk' (LocalCover.radicalInClosure Q split i)).comp
    (factorIntoClosure Q e h split i)

/-- Its kernel is exactly the original factor two-core. -/
theorem factorCoverMap_ker : (factorCoverMap Q e h split i).ker = pCore 2 (L i) := by
  have hk : (factorCoverMap Q e h split i).ker =
      (LocalCover.radical Q split i).comap (factorMap Q e i) := by
    ext a
    exact QuotientGroup.eq_one_iff _
  apply le_antisymm
  · apply le_sSup
    refine ⟨inferInstance, ?_⟩
    rw [hk]
    exact (split.isTwo.to_le (show LocalCover.radical Q split i ≤ split.U from inf_le_left)).comap_of_injective
      (factorMap Q e i) (factorMap_injective Q e i)
  · rw [hk]
    apply map_le_iff_le_comap.mp
    exact le_inf (two_subgroup_le_unipotent split _ (pCore_isPGroup.map _)
      (factorCore_le_borel Q e h i)) (factorCore_le_localKernel Q e h i)

/-- The induced embedding of the original factor two-core quotient. -/
def factorQuotientCoverMap : ((L i) ⧸ pCore 2 (L i)) →* LocalCover.CoverGroup Q split i :=
  QuotientGroup.lift _ (factorCoverMap Q e h split i) (factorCoverMap_ker Q e h split i).ge

@[simp] theorem factorQuotientCoverMap_mk (a : L i) :
    factorQuotientCoverMap Q e h split i (QuotientGroup.mk' (pCore 2 (L i)) a) =
      QuotientGroup.mk' (LocalCover.radicalInClosure Q split i) (factorIntoClosure Q e h split i a) := by rfl

/-- No extra kernel is introduced by passing to the whole-root cover. -/
theorem factorQuotientCoverMap_injective : Function.Injective (factorQuotientCoverMap Q e h split i) := by
  apply (MonoidHom.ker_eq_bot_iff _).mp
  rw [factorQuotientCoverMap, QuotientGroup.ker_lift, factorCoverMap_ker,
    QuotientGroup.map_mk'_self]

variable [Finite (L i)]
  (T : Sylow 2 (L i)) (hT : (T : Subgroup (L i)).map (L i).subtype = S ⊓ L i)
  (hV : simpleRemainder Q split i ≤ localKernel Q i)
  (hc : Nat.card (simpleRoot Q split i) = Nat.card (quotientSylow T))

include h hT hV hc in
/-- The original factor and the panel two-kernel generate the entire local closure. -/
theorem factor_sup_radical :
    (factorMap Q e i).range ⊔ LocalCover.radical Q split i = localClosure Q split i := by
  let C := localClosure Q split i
  let R := LocalCover.radical Q split i
  let q := QuotientGroup.mk' (LocalCover.radicalInClosure Q split i)
  let F := factorCoverMap Q e h split i
  let U := split.U.subgroupOf C
  have hTU : (T : Subgroup (L i)).map F ≤ U.map q := by
    rintro _ ⟨t,ht,rfl⟩
    refine ⟨factorIntoClosure Q e h split i t, ?_, rfl⟩
    change factorMap Q e i t ∈ split.U
    change t ∈ split.U.comap (factorMap Q e i)
    rw [factor_unipotent_comap Q e h split i, ← hT]
    exact mem_map_of_mem (L i).subtype ht
  have hTc : Nat.card ((T : Subgroup (L i)).map F) = Nat.card (quotientSylow T) := by
    rw [← relIndex_ker, factorCoverMap_ker]
    change (pCore 2 (L i)).relIndex T = Nat.card ((T : Subgroup (L i)).map (QuotientGroup.mk' (pCore 2 (L i))))
    rw [← relIndex_ker, QuotientGroup.ker_mk']
  have hUc : Nat.card (U.map q) = Nat.card (simpleRoot Q split i) := by
    rw [← relIndex_ker, QuotientGroup.ker_mk']
    change (R.subgroupOf C).relIndex (split.U.subgroupOf C) = _
    rw [relIndex_subgroupOf (show split.U ≤ C from le_sup_left)]
    change (split.U ⊓ localKernel Q i).relIndex split.U = _
    rw [← remainder_eq_unipotent_inf_kernel Q split i hV]
    exact simpleRemainder_index Q split i
  have heq : (T : Subgroup (L i)).map F = U.map q :=
    eq_of_le_of_card_ge hTU (by rw [hTc,hUc,hc])
  have hU : split.U ≤ (factorMap Q e i).range ⊔ R := by
    intro u hu
    have hm : q ⟨u,mem_sup_left hu⟩ ∈ U.map q := ⟨⟨u,mem_sup_left hu⟩,hu,rfl⟩
    rw [← heq] at hm
    obtain ⟨t,ht,he⟩ := hm
    have hr' : (factorIntoClosure Q e h split i t)⁻¹ * (⟨u,mem_sup_left hu⟩ : C) ∈
        LocalCover.radicalInClosure Q split i := QuotientGroup.eq.mp he
    have hr : (factorMap Q e i t)⁻¹*u ∈ R := hr'
    simpa only [mul_inv_cancel_left] using
      ((factorMap Q e i).range ⊔ R).mul_mem
        (mem_sup_left (show factorMap Q e i t ∈ (factorMap Q e i).range from ⟨t,rfl⟩))
        (mem_sup_right hr)
  have hnorm : Q.tits.standardParabolic {Q.simple i} ≤
      normalizer (((factorMap Q e i).range ⊔ R : Subgroup (X ⧸ Q.D)) : Set (X ⧸ Q.D)) :=
    (le_inf (factor_parabolic_normalizes Q e h i)
      (LocalCover.radical_parabolic_normalizes Q split i)).trans
      (normalizer_inf_normalizer_le_normalizer_sup _ _)
  apply le_antisymm (sup_le (factor_le_localClosure Q e h split i) (inf_le_left.trans le_sup_left))
  apply sup_le hU
  let n := representative (Q.simple i)
  have hn : (n : X ⧸ Q.D) ∈ Q.tits.standardParabolic {Q.simple i} :=
    Q.tits.bruhatCell_subset_standardParabolic_of_mem (Set.mem_singleton _)
      (Q.tits.representative_mem_bruhatCell _ n (representative_spec _))
  have hh := comap_mono (f := (MulAut.conj (n : X ⧸ Q.D)).toMonoidHom) hU
  change unipotentConjugate split (Q.simple i) ≤ rightConjugate _ _ at hh
  rwa [rightConjugate_eq_self _ (hnorm hn)] at hh

include hT hV hc in
/-- Equality of the original quotient Sylow and root orders makes the map onto. -/
theorem factorCoverMap_surjective : Function.Surjective (factorCoverMap Q e h split i) := by
  intro z
  induction z using QuotientGroup.induction_on with
  | H z =>
    have hz : (z : X ⧸ Q.D) ∈ (factorMap Q e i).range ⊔ LocalCover.radical Q split i :=
      (factor_sup_radical Q e h split i T hT hV hc).symm ▸ z.property
    rw [← SetLike.mem_coe, coe_mul_of_left_le_normalizer_right _ _
      (by
        rintro _ ⟨a,rfl⟩
        exact LocalCover.radical_parabolic_normalizes Q split i
          (factorInEndpoint Q e i a).property)] at hz
    obtain ⟨a,⟨t,rfl⟩,r,hr,he⟩ := hz
    refine ⟨t,QuotientGroup.eq.mpr ?_⟩
    change (factorMap Q e i t)⁻¹ * (z : X ⧸ Q.D) ∈ LocalCover.radical Q split i
    rw [← he, inv_mul_cancel_left]
    exact hr

/-- The actual original quotient is the whole-root cover; no perfectness is needed. -/
def factorQuotientCoverEquiv : ((L i) ⧸ pCore 2 (L i)) ≃* LocalCover.CoverGroup Q split i :=
  MulEquiv.ofBijective (factorQuotientCoverMap Q e h split i)
    ⟨factorQuotientCoverMap_injective Q e h split i, by
      intro z
      obtain ⟨a,ha⟩ := factorCoverMap_surjective Q e h split i T hT hV hc z
      exact ⟨QuotientGroup.mk' (pCore 2 (L i)) a,ha⟩⟩

@[simp] theorem factorQuotientCoverEquiv_mk (a : L i) :
    factorQuotientCoverEquiv Q e h split i T hT hV hc (QuotientGroup.mk' (pCore 2 (L i)) a) =
      QuotientGroup.mk' (LocalCover.radicalInClosure Q split i) (factorIntoClosure Q e h split i a) := by rfl

/-- The canonical root group is the SAME original quotient through the whole cover. -/
def regularFactorRootEquiv : rankOne Q split i ≃* ((L i) ⧸ pCore 2 (L i)) :=
  (RootLocalCover.coverEquiv Q split i hV).trans
    (factorQuotientCoverEquiv Q e h split i T hT hV hc).symm

theorem regularFactorRootEquiv_cover (r : rankOne Q split i) :
    factorQuotientCoverEquiv Q e h split i T hT hV hc
      (regularFactorRootEquiv Q e h split i T hT hV hc r) =
      QuotientGroup.mk' (LocalCover.radicalInClosure Q split i)
        (inclusion (rankOne_le_localClosure Q split i) r) := by
  change factorQuotientCoverEquiv Q e h split i T hT hV hc
    ((factorQuotientCoverEquiv Q e h split i T hT hV hc).symm
      (RootLocalCover.coverEquiv Q split i hV r)) = _
  rw [MulEquiv.apply_symm_apply,RootLocalCover.coverEquiv_apply]

/-- Pull the canonical-root comparison back through the original endpoint marking. -/
def regularOriginalFactorRootEquiv : originalRankOne Q e split i ≃* ((L i) ⧸ pCore 2 (L i)) :=
  (originalRankOneEquiv Q e split i).trans
    (regularFactorRootEquiv Q e h split i T hT hV hc)

/-- The original-root comparison uses the same marked endpoint representative. -/
@[simp] theorem regularOriginalFactorRootEquiv_apply (r : originalRankOne Q e split i) :
    regularOriginalFactorRootEquiv Q e h split i T hT hV hc r =
      regularFactorRootEquiv Q e h split i T hT hV hc (originalRankOneEquiv Q e split i r) := by rfl

/-- The whole cover on the original endpoint, with its scalar kernel retained. -/
def regularOriginalFactorCoverEquiv :
    let := originalRadicalInClosure_normal Q e h split i
    (originalLocalClosure Q e split i ⧸ originalRadicalInClosure Q e split i) ≃*
      ((L i) ⧸ pCore 2 (L i)) := by
  let := originalRadicalInClosure_normal Q e h split i
  exact (originalCoverEquiv Q e h split i).trans
    (factorQuotientCoverEquiv Q e h split i T hT hV hc).symm

/-- The literal inclusion of the original factor into the pulled-back closure. -/
def originalFactorIntoClosure : L i →* originalLocalClosure Q e split i where
  toFun a := ⟨⟨a,(show L i ≤ parabolic L S i from le_sup_left.trans le_sup_left) a.property⟩,
    factor_le_localClosure Q e h split i ⟨a,rfl⟩⟩
  map_one' := rfl
  map_mul' _ _ := rfl

omit [Finite (L i)] in
@[simp] theorem originalFactorIntoClosure_coe (a : L i) :
    ((originalFactorIntoClosure Q e h split i a : parabolic L S i) : G) = a := by rfl

@[simp] theorem regularOriginalFactorCoverEquiv_mk_factor (a : L i) :
    let := originalRadicalInClosure_normal Q e h split i
    regularOriginalFactorCoverEquiv Q e h split i T hT hV hc
      (QuotientGroup.mk' (originalRadicalInClosure Q e split i)
        (originalFactorIntoClosure Q e h split i a)) = QuotientGroup.mk' (pCore 2 (L i)) a := by
  let := originalRadicalInClosure_normal Q e h split i
  apply (factorQuotientCoverEquiv Q e h split i T hT hV hc).injective
  change factorQuotientCoverEquiv Q e h split i T hT hV hc
    ((factorQuotientCoverEquiv Q e h split i T hT hV hc).symm
      (originalCoverEquiv Q e h split i (QuotientGroup.mk' _ _))) = _
  rw [MulEquiv.apply_symm_apply,originalCoverEquiv_mk,factorQuotientCoverEquiv_mk]
  apply congrArg (QuotientGroup.mk' (LocalCover.radicalInClosure Q split i))
  apply Subtype.ext
  rw [originalLocalClosureEquiv_apply]
  rfl

@[simp] theorem regularOriginalFactorCoverEquiv_mk_root (r : originalRankOne Q e split i) :
    let := originalRadicalInClosure_normal Q e h split i
    regularOriginalFactorCoverEquiv Q e h split i T hT hV hc
      (QuotientGroup.mk' (originalRadicalInClosure Q e split i)
        (inclusion (originalRankOne_le_localClosure Q e split i) r)) =
      regularOriginalFactorRootEquiv Q e h split i T hT hV hc r := by
  let := originalRadicalInClosure_normal Q e h split i
  change (factorQuotientCoverEquiv Q e h split i T hT hV hc).symm
    (originalCoverEquiv Q e h split i (QuotientGroup.mk' _ _)) =
      (factorQuotientCoverEquiv Q e h split i T hT hV hc).symm
        (RootLocalCover.coverEquiv Q split i hV (originalRankOneEquiv Q e split i r))
  rw [originalCoverEquiv_mk,RootLocalCover.coverEquiv_apply]
  apply congrArg
  apply congrArg (QuotientGroup.mk' (LocalCover.radicalInClosure Q split i))
  apply Subtype.ext
  simp only [originalLocalClosureEquiv_apply, Subgroup.coe_inclusion, originalRankOneEquiv_apply]

variable (hz : center ((L i) ⧸ pCore 2 (L i)) = ⊥)

include e h hT hV hc hz in
/-- A centerless original quotient kills the central local-cover action kernel. -/
theorem regular_factor_projection_injective : Function.Injective (LocalCover.projection Q split i) := by
  apply (MonoidHom.ker_eq_bot_iff _).mp
  apply eq_bot_iff.mpr
  intro x hx
  let a := (factorQuotientCoverEquiv Q e h split i T hT hV hc).symm
  have hm := MulEquivClass.apply_mem_center a (LocalCover.projection_ker_central Q split i hx)
  change a x ∈ center ((L i) ⧸ pCore 2 (L i)) at hm
  rw [hz,mem_bot] at hm
  exact a.injective (hm.trans a.map_one.symm)

/-- The faithful local permutation image is the same centerless original quotient. -/
def regularFactorLocalEquiv : localGroup Q split i ≃* ((L i) ⧸ pCore 2 (L i)) :=
  (MulEquiv.ofBijective (LocalCover.projection Q split i)
    ⟨regular_factor_projection_injective Q e h split i T hT hV hc hz,
      LocalCover.projection_surjective Q split i⟩).symm.trans
    (factorQuotientCoverEquiv Q e h split i T hT hV hc).symm

@[simp] theorem regularFactorLocalEquiv_projection (x : LocalCover.CoverGroup Q split i) :
    regularFactorLocalEquiv Q e h split i T hT hV hc hz (LocalCover.projection Q split i x) =
      (factorQuotientCoverEquiv Q e h split i T hT hV hc).symm x := by
  let a := MulEquiv.ofBijective (LocalCover.projection Q split i)
    ⟨regular_factor_projection_injective Q e h split i T hT hV hc hz,
      LocalCover.projection_surjective Q split i⟩
  change (factorQuotientCoverEquiv Q e h split i T hT hV hc).symm (a.symm (a x)) = _
  rw [MulEquiv.symm_apply_apply]

theorem regularFactorRootEquiv_projection (r : rankOne Q split i) :
    regularFactorRootEquiv Q e h split i T hT hV hc r =
      regularFactorLocalEquiv Q e h split i T hT hV hc hz
        (RootLocalCover.projection Q split i r) := by
  have he : RootLocalCover.projection Q split i r =
      LocalCover.projection Q split i (RootLocalCover.coverEquiv Q split i hV r) := by
    apply Subtype.ext
    rw [RootLocalCover.projection_apply,RootLocalCover.coverEquiv_apply,LocalCover.projection_mk]
  rw [he,regularFactorLocalEquiv_projection]
  rfl

theorem regularOriginalFactorRootEquiv_projection (r : originalRankOne Q e split i) :
    regularOriginalFactorRootEquiv Q e h split i T hT hV hc r =
      regularFactorLocalEquiv Q e h split i T hT hV hc hz
        (originalRootProjection Q e split i r) := by
  have he : originalRootProjection Q e split i r =
      RootLocalCover.projection Q split i (originalRankOneEquiv Q e split i r) := by
    apply Subtype.ext
    rw [originalRootProjection_apply,RootLocalCover.projection_apply]
  rw [he,← regularFactorRootEquiv_projection Q e h split i T hT hV hc hz]
  rfl

include h hT hV hc hz in
/-- The original root subgroup has trivial full panel kernel in the centerless case. -/
theorem regular_original_root_kernel_eq_bot :
    (originalPanelKernel (L := L) (S := S) i).subgroupOf (originalRankOne Q e split i) = ⊥ := by
  rw [← originalRootProjection_ker Q e h split i]
  apply (MonoidHom.ker_eq_bot_iff _).mpr
  intro r s hrs
  apply (regularOriginalFactorRootEquiv Q e h split i T hT hV hc).injective
  rw [regularOriginalFactorRootEquiv_projection Q e h split i T hT hV hc hz,
    regularOriginalFactorRootEquiv_projection Q e h split i T hT hV hc hz,hrs]

end CFSG.Quasithin.ChapterF.Source.FongSeitzBinary.MarkedLocal
