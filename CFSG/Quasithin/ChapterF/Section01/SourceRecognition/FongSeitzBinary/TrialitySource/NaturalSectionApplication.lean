module
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.TrialitySource.NaturalSection
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.FongSeitzBinary.TrialitySource.ScalarAlignment

/-!
# Constructing the triality source's two-axis section action

The literal 6E(b) derived-subgroup clause puts the short radical's derived
subgroup in the three-middle-root denominator. NaturalSection therefore
constructs the long radical's quotient and the whole long rank-one action.
The same short pinning identifies its two outside roots with additive F.
This gives actual coordinates F × F, with the selected long Weyl element
swapping the axes. No representation equivalence or section is supplied as
an extra premise.

The source panel kernel detects the first coordinate and proves that the
upper root acts trivially on it. Structural commutation fixes the second
axis. Consequently the upper root acts by an additive shear; the rank-one
braid forces the parameter-one shear to be the identity. Inclusion into the
same U modulo the same denominator is injective and gives the literal right
commutator used by ScalarAlignment. At q=2 every fixed-field scalar satisfies
b²=b, so this entire leading coefficient is ordinary multiplication by b.
This uses no F8 enumeration and does not revisit norm normalization.

The final consumer constructs relative normality and the faithful section
coordinate before applying the existing whole-pinning scalar alignment.
For general q, identifying the additive shear with scalar multiplication
still requires the source Cartan/scalar comparison. The unnormalized tensor
matrices, their lifts to U, EarlierModuleEquations and mixed torus equations
are still source obligations. In particular this module does not identify
an arbitrary additive action with the eight-dimensional twisted tensor.

Source: Fong--Seitz I (6E)(b), II (9.22)--(9.29), printed pp.217--219.
The cubic/short endpoint is source 2; the fixed/long endpoint is source 1.
The denominator is the subgroup generated by E, D, F in the original quotient.
Right commutators are x⁻¹y⁻¹xy, and all quotient maps are the canonical maps.
Both orientations and every positive binary exponent, including q=4, remain
in the general construction. The original/geometric positive-image consumers
remain exported through ScalarAlignment, with their remaining source premises.
-/

@[expose] public noncomputable section
open Subgroup Theory.PSL2.SemilinearCoverage
open scoped IsMulCommutative
open Theory.AlgebraicGroup.TitsSystem.SourceBinary
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.RootCoordinates
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.HexagonStructure
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.TrialitySource
open Triality.Standard Triality.Standard.RootPresentationRecognition
namespace CFSG.Quasithin.ChapterF.Source.FongSeitzBinary.TrialitySource.NaturalSectionApplication
variable {X F : Type*} [Group X] [Field F] [CharP F 2]
  {P : Fin 2 → Subgroup X} (Q : MarkedQuotient P) (split : SplitData Q.tits)
  {σ : F ≃+* F} (p : RankOnePair σ (X ⧸ Q.D)) (w : WeylPlacement Q p)
  (hs : (p.shortOrbit 0).range = simpleRoot Q split (w.indices 0))
  (hl : (p.longOrbit 0).range = simpleRoot Q split (w.indices 1))
  (hm : rotationOrder Q = 6)
  (hKs : simpleRemainder Q split (w.indices 0) ≤ localKernel Q (w.indices 0))
  (hKl : simpleRemainder Q split (w.indices 1) ≤ localKernel Q (w.indices 1))
  (row : StructuralRow Q split (w.indices 0) (w.indices 1))
local notation "i" => w.indices 0
local notation "j" => w.indices 1
local notation "hij" => w.indices.injective.ne (by decide : (0 : Fin 2) ≠ 1)
local notation "K" => ScalarMarking.SourceFixed (σ := σ)

include hs in
private theorem simple_abelian : ⁅simpleRoot Q split i,simpleRoot Q split i⁆ = ⊥ := by
  rw [← hs]
  apply commutator_eq_bot_iff_le_centralizer.mpr
  rintro x ⟨a,rfl⟩
  apply mem_centralizer_iff.mpr
  rintro y ⟨b,rfl⟩
  exact ((Commute.all b a).map (p.shortOrbit 0)).eq

include row in
private theorem derived_le_middle :
    ⁅simpleRemainder Q split i,simpleRemainder Q split i⁆ ≤ middleRoots Q split i j := by
  rw [row.radical_derived]
  exact le_sup_right

/-- The natural module's actual source section V_j/(E D F). -/
def sourceSection : RootSection Q split j :=
  NaturalSection.sourceSection Q split hm i j hij hKs hKl
    (by exact simple_abelian Q split p w hs) (by exact derived_le_middle Q split p w row)

local notation "d" => sourceSection Q split p w hs hm hKs hKl row

instance section_commutative : IsMulCommutative (d).Carrier := by
  exact NaturalSection.commutative Q split hm i j hij hKs hKl
    (simple_abelian Q split p w hs) (derived_le_middle Q split p w row)

private theorem base_injective (hf : Function.Injective p.shortMap) :
    Function.Injective (p.shortOrbit 0) := by
  intro a b he
  apply Multiplicative.toAdd.injective
  exact uni_injective (hf he)

/-- The given whole short pinning supplies coordinates on the first axis. -/
def firstField (hf : Function.Injective p.shortMap) : Multiplicative F ≃* simpleRoot Q split i :=
  MulEquiv.ofBijective ((p.shortOrbit 0).codRestrict _ (fun a => hs ▸ ⟨a,rfl⟩))
    (by exact ⟨fun a b he => base_injective Q p hf (congrArg Subtype.val he), by
      rintro ⟨x,hx⟩
      obtain ⟨a,ha⟩ := hs.symm ▸ hx
      exact ⟨a,Subtype.ext ha⟩⟩)

/-- The same pinning and the actual long Weyl element supply the second axis. -/
def secondField (hf : Function.Injective p.shortMap) :
    Multiplicative F ≃* rootAt Q split i (Q.simple j) :=
  MulEquiv.ofBijective ((p.shortOrbit 1).codRestrict _
    (fun a => RootGeometry.short_one_rootAt Q split p w hs ▸ ⟨a,rfl⟩))
    (by exact ⟨fun a b he => base_injective Q p hf (p.dihedral.B.injective (congrArg Subtype.val he)), by
      rintro ⟨x,hx⟩
      obtain ⟨a,ha⟩ := (RootGeometry.short_one_rootAt Q split p w hs).symm ▸ hx
      exact ⟨a,Subtype.ext ha⟩⟩)

/-- Actual additive coordinates F × F on the natural section, using the same
source short-root labels on both axes. No module equivalence is assumed. -/
def fieldCoordinates (hf : Function.Injective p.shortMap) :
    Multiplicative F × Multiplicative F ≃* (d).Carrier :=
  ((firstField Q split p w hs hf).prodCongr (secondField Q split p w hs hf)).trans
    (NaturalSection.coordinateEquiv Q split hm i j hij hKs hKl
      (by exact simple_abelian Q split p w hs) (by exact derived_le_middle Q split p w row))

/-- The long actor, in the actual canonical rank-one subgroup. -/
def longActor : SL2 K →* rankOne Q split j :=
  p.longMap.codRestrict _ (fun g => RootGeometry.longMap_range Q split p w hl ▸ ⟨g,rfl⟩)

/-- Conjugation by the same whole long pinning on the actual natural section. -/
def action (hf : Function.Injective p.shortMap) :
    SL2 K →* MulAut (Multiplicative F × Multiplicative F) :=
  (MulAut.congr (fieldCoordinates Q split p w hs hm hKs hKl row hf).symm).toMonoidHom.comp
    ((d).action.comp (longActor Q split p w hl))

local notation "c" => fieldCoordinates Q split p w hs hm hKs hKl row

/-- The coordinate action is literal conjugation on the original quotient section. -/
theorem action_intertwines (hf : Function.Injective p.shortMap) (g : SL2 K)
    (z : Multiplicative F × Multiplicative F) :
    c hf (action Q split p w hs hl hm hKs hKl row hf g z) =
      (d).action (longActor Q split p w hl g) (c hf z) :=
  (c hf).apply_symm_apply _

private def firstLift (a : Multiplicative F) : (d).numerator :=
  ⟨p.shortOrbit 0 a, simpleRoot_le_other_remainder Q split hm i j hij (hs ▸ ⟨a,rfl⟩)⟩
private def secondLift (a : Multiplicative F) : (d).numerator :=
  ⟨p.shortOrbit 1 a, (exchanged_roots_le_remainder Q split hm i j hij).1
    (RootGeometry.short_one_rootAt Q split p w hs ▸ ⟨a,rfl⟩)⟩

private theorem coordinates_apply (hf : Function.Injective p.shortMap)
    (a b : Multiplicative F) :
    c hf (a,b) = (QuotientGroup.mk' (d).denominator)
        (firstLift Q split p w hs hm hKs hKl row a) *
      (QuotientGroup.mk' (d).denominator) (secondLift Q split p w hs hm hKs hKl row b) := rfl

/-- The selected long Weyl element exchanges the two axes with their entire labels. -/
theorem action_weyl (hf : Function.Injective p.shortMap) (a b : Multiplicative F) :
    action Q split p w hs hl hm hKs hKl row hf (weyl K) (a,b) = (b,a) := by
  apply (c hf).injective
  rw [action_intertwines,coordinates_apply,coordinates_apply,map_mul]
  have ha : (d).action (longActor Q split p w hl (weyl K))
      ((QuotientGroup.mk' (d).denominator) (firstLift Q split p w hs hm hKs hKl row a)) =
      (QuotientGroup.mk' (d).denominator) (secondLift Q split p w hs hm hKs hKl row a) := rfl
  have hb : (d).action (longActor Q split p w hl (weyl K))
      ((QuotientGroup.mk' (d).denominator) (secondLift Q split p w hs hm hKs hKl row b)) =
      (QuotientGroup.mk' (d).denominator) (firstLift Q split p w hs hm hKs hKl row b) := by
    apply congrArg (QuotientGroup.mk' (d).denominator)
    apply Subtype.ext
    exact p.dihedral.B_B (p.shortOrbit 0 b)
  rw [ha,hb]
  exact mul_comm _ _

/-- The long upper root fixes the second axis, by the structural 6E(b) commutations. -/
theorem action_uni_second (hf : Function.Injective p.shortMap) (b : K)
    (a : Multiplicative F) :
    action Q split p w hs hl hm hKs hKl row hf (uni b) (1,a) = (1,a) := by
  apply (c hf).injective
  rw [action_intertwines,coordinates_apply]
  have hzero : firstLift Q split p w hs hm hKs hKl row 1 = 1 := Subtype.ext (map_one _)
  simp only [hzero,map_one,one_mul]
  apply congrArg (QuotientGroup.mk' (d).denominator)
  apply Subtype.ext
  exact ((StructuralApplication.positiveCommutations Q split p w hs hl hm row).long0_short1 b a.toAdd).mul_inv_cancel

private theorem radical_le_panel : (d).numerator ≤ Q.tits.standardParabolic {Q.simple i} :=
  inf_le_left.trans (split.U_le.trans (Q.tits.B_le_standardParabolic _))

private def panelProjection : (d).Carrier →* Equiv.Perm (Panel Q i) :=
  QuotientGroup.lift (d).denominator
    (panelAction Q i (d).numerator (radical_le_panel Q split p w hs hm hKs hKl row)) (by
      rw [panelAction_ker]
      intro x hx
      exact hKs (middleRoots_le_other_remainder Q split hm i j hij hx))

private theorem second_in_kernel (b : Multiplicative F) :
    (secondLift Q split p w hs hm hKs hKl row b : X ⧸ Q.D) ∈ localKernel Q i := by
  apply hKs
  apply middleRoots_le_remainder Q split hm j i (hij).symm
  apply (show rootAt Q split i (Q.simple j) ≤ middleRoots Q split j i from
    le_sup_left.trans le_sup_left)
  exact RootGeometry.short_one_rootAt Q split p w hs ▸ ⟨b,rfl⟩

private theorem projection_coordinates (hf : Function.Injective p.shortMap)
    (a b : Multiplicative F) :
    panelProjection Q split p w hs hm hKs hKl row (c hf (a,b)) =
      panelAction Q i (simpleRoot Q split i)
        ((simpleRoot_le Q split i).trans (split.U_le.trans (Q.tits.B_le_standardParabolic _)))
        (firstField Q split p w hs hf a) := by
  rw [coordinates_apply,map_mul]
  have hb : panelAction Q i (d).numerator
      (radical_le_panel Q split p w hs hm hKs hKl row)
      (secondLift Q split p w hs hm hKs hKl row b) = 1 := by
    apply MonoidHom.mem_ker.mp
    rw [panelAction_ker]
    exact second_in_kernel Q split p w hs hm hKs hKl row b
  change panelAction Q i (d).numerator _ (firstLift Q split p w hs hm hKs hKl row a) *
    panelAction Q i (d).numerator _ (secondLift Q split p w hs hm hKs hKl row b) = _
  rw [hb,mul_one]
  rfl

private theorem projection_uni (b : K) (z : (d).Carrier) :
    panelProjection Q split p w hs hm hKs hKl row
      ((d).action (longActor Q split p w hl (uni b)) z) =
      panelProjection Q split p w hs hm hKs hKl row z := by
  induction z using QuotientGroup.induction_on with
  | H x =>
    have hbV : p.l 0 b ∈ simpleRemainder Q split i :=
      simpleRoot_le_other_remainder Q split hm j i (hij).symm (hl ▸ ⟨.ofAdd b,rfl⟩)
    let bP : Q.tits.standardParabolic {Q.simple i} :=
      ⟨p.l 0 b, Q.tits.B_le_standardParabolic _ (split.U_le hbV.1)⟩
    let xP : Q.tits.standardParabolic {Q.simple i} :=
      ⟨x, radical_le_panel Q split p w hs hm hKs hKl row x.property⟩
    have hb1 : endpointAction Q i bP = 1 := by
      have hk : bP ∈ (panelAction Q i (Q.tits.standardParabolic {Q.simple i}) le_rfl).ker := by
        rw [panelAction_ker]
        exact hKs hbV
      exact MonoidHom.mem_ker.mp hk
    change endpointAction Q i (bP*xP*bP⁻¹) = endpointAction Q i xP
    rw [map_mul,map_mul,map_inv,hb1,one_mul,inv_one,mul_one]

/-- The upper root action induces the identity on the first coordinate. This
comes from the actual panel kernel, not an assumed natural-module formula. -/
theorem action_uni_first (hf : Function.Injective p.shortMap) (b : K)
    (a c₀ : Multiplicative F) :
    (action Q split p w hs hl hm hKs hKl row hf (uni b) (a,c₀)).1 = a := by
  apply (firstField Q split p w hs hf).injective
  apply simpleRoot_panelAction_injective Q split i
  rw [← projection_coordinates Q split p w hs hm hKs hKl row hf _
    (action Q split p w hs hl hm hKs hKl row hf (uni b) (a,c₀)).2]
  change panelProjection Q split p w hs hm hKs hKl row
    (c hf (action Q split p w hs hl hm hKs hKl row hf (uni b) (a,c₀))) = _
  rw [action_intertwines,projection_uni,projection_coordinates]

/-- The actual upper root acts by an additive shear on the two source axes. -/
def shear (hf : Function.Injective p.shortMap) (b : K) : F →+ F where
  toFun a := (action Q split p w hs hl hm hKs hKl row hf (uni b) (.ofAdd a,1)).2.toAdd
  map_zero' := by
    change (action Q split p w hs hl hm hKs hKl row hf (uni b) 1).2.toAdd = 0
    rw [map_one]
    rfl
  map_add' a c₀ := by
    have hh := map_mul (action Q split p w hs hl hm hKs hKl row hf (uni b))
      (.ofAdd a,1) (.ofAdd c₀,1)
    simpa only [Prod.mk_mul_mk,mul_one,Prod.snd_mul,toAdd_mul,ofAdd_add] using
      congrArg (fun z : Multiplicative F × Multiplicative F => z.2.toAdd) hh

/-- Both entries of the source upper-root action, with its still unaligned
additive coefficient kept explicit. -/
theorem action_uni (hf : Function.Injective p.shortMap) (b : K) (a c₀ : F) :
    action Q split p w hs hl hm hKs hKl row hf (uni b) (.ofAdd a,.ofAdd c₀) =
      (.ofAdd a,.ofAdd (shear Q split p w hs hl hm hKs hKl row hf b a + c₀)) := by
  apply Prod.ext
  · exact action_uni_first Q split p w hs hl hm hKs hKl row hf b _ _
  · have hh := map_mul (action Q split p w hs hl hm hKs hKl row hf (uni b))
      (.ofAdd a,1) (1,.ofAdd c₀)
    rw [action_uni_second] at hh
    change _ = (action Q split p w hs hl hm hKs hKl row hf (uni b) (.ofAdd a,1)).2 * .ofAdd c₀
    simpa only [Prod.mk_mul_mk,mul_one,one_mul,Prod.snd_mul] using congrArg Prod.snd hh

/-- The rank-one braid forces the parameter-one shear to be the identity,
including over the binary fixed field. -/
theorem shear_one (hf : Function.Injective p.shortMap) (a : F) :
    shear Q split p w hs hl hm hKs hKl row hf 1 a = a := by
  have hbraid : uni (1 : K)*weyl K*uni 1 = weyl K*uni 1*weyl K := by
    ext k l
    fin_cases k <;> fin_cases l <;>
      simp [Matrix.mul_apply,Fin.sum_univ_two,CharTwo.add_self_eq_zero]
  have hh := congrArg
    (fun g : SL2 K => action Q split p w hs hl hm hKs hKl row hf g (.ofAdd a,.ofAdd 0)) hbraid
  simp only [map_mul, MulAut.mul_apply, action_uni, action_weyl] at hh
  have he := congrArg (fun z : Multiplicative F × Multiplicative F => z.1.toAdd) hh
  simpa only [map_zero,add_zero,zero_add,toAdd_ofAdd] using he

/-- The zero upper-root parameter has zero shear. -/
theorem shear_zero (hf : Function.Injective p.shortMap) (a : F) :
    shear Q split p w hs hl hm hKs hKl row hf 0 a = 0 := by
  have hu : uni (0 : K) = 1 := by ext k l; fin_cases k <;> fin_cases l <;> simp
  change (action Q split p w hs hl hm hKs hKl row hf (uni 0) (.ofAdd a,1)).2.toAdd = 0
  rw [hu,map_one]
  rfl

include hs hm hKs row in
/-- The source middle denominator is normal in U, not in the ambient quotient. -/
theorem positive_normal : ((middleRoots Q split i j).subgroupOf split.U).Normal :=
  normal_subgroupOf_of_le_normalizer
    (NaturalSection.unipotent_normalizes Q split hm i j hij hKs
      (by exact simple_abelian Q split p w hs) (by exact derived_le_middle Q split p w row))

variable [hN : ((middleRoots Q split (w.indices 0) (w.indices 1)).subgroupOf split.U).Normal]

local notation "M" => Subgroup.subgroupOf (middleRoots Q split (w.indices 0) (w.indices 1)) split.U
local notation "A₀" => ScalarAlignment.sectionA Q split p w hs M
local notation "B₀" => ScalarAlignment.sectionB Q split p w hl M
local notation "C₀" => ScalarAlignment.sectionC Q split p w hs hl hm M

include hs hl hm hKs hKl row in
/-- The exact C-root used by ScalarAlignment is faithful in the canonical section. -/
theorem sectionC_injective (hf : Function.Injective p.shortMap) :
    Function.Injective (ScalarAlignment.sectionC Q split p w hs hl hm
      ((middleRoots Q split i j).subgroupOf split.U)) := by
  have hc : (ScalarAlignment.sectionC Q split p w hs hl hm
      ((middleRoots Q split i j).subgroupOf split.U)) =
    (NaturalSection.intoPositive Q split hm i j hij hKs hKl
      (by exact simple_abelian Q split p w hs) (by exact derived_le_middle Q split p w row)).comp
    ((NaturalSection.second Q split hm i j hij hKs hKl
      (by exact simple_abelian Q split p w hs) (by exact derived_le_middle Q split p w row)).comp
      (secondField Q split p w hs hf).toMonoidHom) := by
    apply MonoidHom.ext
    intro a
    rfl
  rw [hc]
  exact (NaturalSection.intoPositive_injective Q split hm i j hij hKs hKl
    (by exact simple_abelian Q split p w hs) (by exact derived_le_middle Q split p w row)).comp
    ((NaturalSection.second_injective Q split hm i j hij hKs hKl
      (by exact simple_abelian Q split p w hs) (by exact derived_le_middle Q split p w row)).comp
        (secondField Q split p w hs hf).injective)

private theorem positive_coordinates (hf : Function.Injective p.shortMap) (a b : F) :
    NaturalSection.intoPositive Q split hm i j hij hKs hKl
      (simple_abelian Q split p w hs) (derived_le_middle Q split p w row)
      (c hf (.ofAdd a,.ofAdd b)) = A₀ (.ofAdd a) * C₀ (.ofAdd b) := rfl

private theorem positive_action_first (hf : Function.Injective p.shortMap) (a : F) (b : K) :
    NaturalSection.intoPositive Q split hm i j hij hKs hKl
      (simple_abelian Q split p w hs) (derived_le_middle Q split p w row)
      ((d).action (longActor Q split p w hl (uni b)) (c hf (.ofAdd a,.ofAdd 0))) =
      B₀ (.ofAdd b) * A₀ (.ofAdd a) * (B₀ (.ofAdd b))⁻¹ := by
  rw [coordinates_apply]
  have hzero : secondLift Q split p w hs hm hKs hKl row (.ofAdd 0) = 1 := Subtype.ext (map_one _)
  simp only [hzero,map_one,mul_one]
  rfl

/-- The actual natural action gives the leading commutator in the very U/M
used by scalar comparison; its additive coefficient is constructed, not supplied. -/
theorem section_commutator (hf : Function.Injective p.shortMap) (a : F) (b : K) :
    rightCommutator (A₀ (.ofAdd a)) (B₀ (.ofAdd b)) =
      C₀ (.ofAdd (shear Q split p w hs hl hm hKs hKl row hf b a)) := by
  have h := congrArg (NaturalSection.intoPositive Q split hm i j hij hKs hKl
    (simple_abelian Q split p w hs) (derived_le_middle Q split p w row))
    (action_intertwines Q split p w hs hl hm hKs hKl row hf (uni b) (.ofAdd a,.ofAdd 0))
  rw [action_uni,add_zero,positive_coordinates,positive_action_first] at h
  have ha : (A₀ (.ofAdd a))⁻¹ = A₀ (.ofAdd a) := by
    rw [← map_inv, ← ofAdd_neg, CharTwo.neg_eq]
  have hb : (B₀ (.ofAdd b))⁻¹ = B₀ (.ofAdd b) := by
    rw [← map_inv, ← ofAdd_neg, CharTwo.neg_eq]
  have haa : A₀ (.ofAdd a) * A₀ (.ofAdd a) = 1 := by
    rw [← map_mul, ← ofAdd_add, CharTwo.add_self_eq_zero]
    exact map_one _
  calc
    _ = A₀ (.ofAdd a) * (B₀ (.ofAdd b) * A₀ (.ofAdd a) * (B₀ (.ofAdd b))⁻¹) := by
      simp only [rightCommutator,ha,hb,mul_assoc]
    _ = A₀ (.ofAdd a) * (A₀ (.ofAdd a) *
        C₀ (.ofAdd (shear Q split p w hs hl hm hKs hKl row hf b a))) := by rw [← h]
    _ = _ := by rw [← mul_assoc,haa,one_mul]

include hKs hKl row in
/-- The leading mixed source coefficient at long parameter one is fixed
by the actual rank-one action, before the tensor comparison. -/
theorem section_commutator_one (hf : Function.Injective p.shortMap) (a : F) :
    rightCommutator (A₀ (.ofAdd a)) (B₀ (.ofAdd 1)) = C₀ (.ofAdd a) := by
  rw [section_commutator Q split p w hs hl hm hKs hKl row hf,shear_one]

variable [Finite F] {n : ℕ} {hn : 0 < n} (e : ScalarMarking (binaryParameters n hn) σ)

omit hN in
include e in
/-- At q=2 the constructed source action is already scalar multiplication;
no cubic-field enumeration or representation premise is needed. -/
theorem shear_binary (hn₁ : n = 1) (hf : Function.Injective p.shortMap) (a : F) (b : K) :
    shear Q split p w hs hl hm hKs hKl row hf b a = a*b.val := by
  let := Fintype.ofFinite K
  have hc : Fintype.card K = 2 := by
    rw [← Nat.card_eq_fintype_card,scalarMarking_sourceFixed_card e,hn₁]
    rfl
  have hb : b = 0 ∨ b = 1 := eq_zero_or_one_of_sq_eq_self (by
    simpa only [hc] using FiniteField.pow_card b)
  rcases hb with rfl | rfl
  · rw [shear_zero]
    simp
  · rw [shear_one]
    simp

include e hKs hKl row in
/-- The exact binary leading commutator on the original U/M. The tensor-stage
lift of this relation to U remains a separate obligation. -/
theorem section_commutator_binary (hn₁ : n = 1) (hf : Function.Injective p.shortMap)
    (a : F) (b : K) :
    rightCommutator (A₀ (.ofAdd a)) (B₀ (.ofAdd b)) = C₀ (.ofAdd (a*b.val)) := by
  rw [section_commutator Q split p w hs hl hm hKs hKl row hf,
    shear_binary Q split p w hs hl hm hKs hKl row e hn₁ hf]

omit hN in
include e hs hl hm hKs hKl row in
/-- Apply scalar comparison to the constructed source section. Its denominator
and faithful C-coordinate are now supplied by the literal root geometry.
The natural scalar-linearity and unnormalized tensor matrices remain premises. -/
theorem normalize_source_section (hf : Function.Injective p.shortMap) :
    let : (M).Normal := positive_normal Q split p w hs hm hKs row
    ∀ (r : SL2 K →* SL2 F)
    (_hU : ∀ b, ∃ c₀ : F, r (uni b) = uni c₀) (_hW : r (weyl K) = weyl F)
    (_hcoeff : ∀ (a : F) (b : K),
      shear Q split p w hs hl hm hKs hKl row hf b a = a * (r (uni b)).val 0 1)
    (τ₁ τ₂ ρ : K ≃+* K) (θ x y : F)
    (_htensor : ∀ a₀ a₁ a₂ b : K,
      rightCommutator (B₀ (.ofAdd b)) (A₀ (.ofAdd (a₀.val+a₁.val*θ+a₂.val*θ^2))) =
        C₀ (.ofAdd (x*(τ₂ (τ₁.symm b)).val *
          ((τ₂ (ρ a₀)).val+(τ₂ (ρ a₁)).val*y+(τ₂ (ρ a₂)).val*y^2)))),
    x = 1 ∧ y = θ ∧ ρ.trans τ₂ = RingEquiv.refl K ∧
      r.comp (Theory.PSL2.sl2FieldAut (τ₁.symm.trans τ₂).symm).toMonoidHom =
        Matrix.SpecialLinearGroup.map (ScalarMarking.SourceFixed (σ := σ)).subtype ∧
      ∀ (a : F) (b : K),
        rightCommutator
          (ScalarAlignment.sectionB Q split (p.relabelLong (τ₁.symm.trans τ₂).symm)
            (w.relabelLong Q p (τ₁.symm.trans τ₂).symm)
            ((p.relabelLong_long_range (τ₁.symm.trans τ₂).symm 0).trans hl) M (.ofAdd b))
          (A₀ (.ofAdd a)) = C₀ (.ofAdd (a*b.val)) := by
  let : (M).Normal := positive_normal Q split p w hs hm hKs row
  dsimp only
  intro r hU hW hcoeff τ₁ τ₂ ρ θ x y htensor
  exact ScalarAlignment.normalize_lower_section Q split p w hs hl hm M e r hU hW
    (sectionC_injective Q split p w hs hl hm hKs hKl row hf)
    (fun a b => (section_commutator Q split p w hs hl hm hKs hKl row hf a b).trans
      (congrArg (fun z => C₀ (.ofAdd z)) (hcoeff a b))) τ₁ τ₂ ρ θ x y htensor

