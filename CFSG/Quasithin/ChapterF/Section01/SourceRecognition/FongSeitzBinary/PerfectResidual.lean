module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.FongSeitzBinary.NormalGeneration
public import Theory.GroupTheory.SolvableResidual.TwoSupplement

/-!
# The perfect residual generated by the original source factors

In the literal generated carrier, restrict L₀,L₁,S and map them through the
same quotient q used by both marked parabolics. The image of S normalizes
each perfect factor image. Their join is therefore normal in the whole
quotient, is perfect, and has a two-group supplement. It is exactly O² of
the quotient. Neither finiteness of the original completion nor global
injectivity of q is needed.

This discharges the perfectness premise of the minimal-normal reduction
for the actual selected-perfect-factor consumer. Both perfectness premises
come from that consumer; the general F.1.1 hypotheses alone do not assert
them. Source: the normalized factors in Aschbacher–Smith F.1.1(a), p.259,
and the reduction needed for DGS Theorem D, pp.80–81 and224. The genuine
marked quotient still comes from qt-dgs85-apartment-exchange, and the full
Fong–Seitz recognition remains unproved.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open Theory.AlgebraicGroup.TitsSystem.SourceBinary
namespace CFSG.Quasithin.ChapterF.Source.FongSeitzBinary
variable {G : Type*} [Group G] {L : Fin 2 → Subgroup G} {S : Subgroup G}

/-- The two-residual is the join of the two literal factor images and is perfect. -/
theorem quotient_perfect_residual (h : HypothesisF11 L S)
    (hp : ∀ i, Group.IsPerfect (L i)) (Q : SourceQuotient L S) :
    pResidual 2 ((generated L S) ⧸ Q.D) =
      ((L 0).subgroupOf (generated L S)).map Q.q ⊔
        ((L 1).subgroupOf (generated L S)).map Q.q ∧
    Group.IsPerfect (pResidual 2 ((generated L S) ⧸ Q.D)) := by
  let Y := generated L S
  let A (i : Fin 2) := ((L i).subgroupOf Y).map Q.q
  let T := (S.subgroupOf Y).map Q.q
  have hA (i : Fin 2) : Group.IsPerfect (A i) := by
    let := hp i
    let e := subgroupOfEquivOfLe (local_le_generated (L := L) (S := S) i)
    let : Group.IsPerfect ((L i).subgroupOf Y) :=
      Group.IsPerfect.ofSurjective (f := e.symm.toMonoidHom) e.symm.surjective
    exact Group.IsPerfect.map Q.q
  have hT : IsPGroup 2 T := h.S_isP.comap_subtype.map Q.q
  have hn (i : Fin 2) : T ≤ normalizer (A i : Set (Y ⧸ Q.D)) := by
    have hn0 : S.subgroupOf Y ≤ normalizer ((L i).subgroupOf Y : Set Y) :=
      (comap_mono (h.S_normalizes i)).trans ((L i).le_normalizer_comap Y.subtype)
    exact (map_mono hn0).trans (((L i).subgroupOf Y).le_normalizer_map Q.q)
  have hgen : (A 0 ⊔ A 1) ⊔ T = ⊤ := by
    change ((L 0).subgroupOf Y).map Q.q ⊔ ((L 1).subgroupOf Y).map Q.q ⊔
      (S.subgroupOf Y).map Q.q = ⊤
    rw [← Subgroup.map_sup, ← Subgroup.map_sup,
      ← subgroupOf_sup (local_le_generated 0) (local_le_generated 1),
      ← subgroupOf_sup (sup_le (local_le_generated 0) (local_le_generated 1))
        (show S ≤ generated L S from le_sup_right)]
    change (Y.subgroupOf Y).map Q.q = ⊤
    rw [subgroupOf_self, ← MonoidHom.range_eq_map]
    exact MonoidHom.range_eq_top_of_surjective _ (QuotientGroup.mk'_surjective _)
  let K := A 0 ⊔ A 1
  have hK : Group.IsPerfect K := by
    rw [isPerfect_iff]
    apply le_antisymm K.commutator_le_self
    apply sup_le
    · let := hA 0
      exact (A 0).commutator_eq_self.symm.le.trans
        (commutator_mono le_sup_left le_sup_left)
    · let := hA 1
      exact (A 1).commutator_eq_self.symm.le.trans
        (commutator_mono le_sup_right le_sup_right)
  let := hK
  let : K.Normal := normalizer_eq_top_iff.mp (top_unique (hgen ▸
    sup_le K.le_normalizer ((le_inf (hn 0) (hn 1)).trans
      (normalizer_inf_normalizer_le_normalizer_sup _ _))))
  have hr := (residuals_of_perfect_normal_sup_twoGroup K T hT hgen).1
  exact ⟨hr, hr.symm ▸ hK⟩

end CFSG.Quasithin.ChapterF.Source.FongSeitzBinary
