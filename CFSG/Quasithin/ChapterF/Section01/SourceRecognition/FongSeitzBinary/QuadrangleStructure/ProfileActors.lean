module
public import Theory.AlgebraicGroup.BNPair.Recognition.SourceBinary.QuadrangleStructure.ProfileActors
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.FongSeitzBinary.QuadrangleStructure.MarkedCores
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.FongSeitzBinary.LocalCover

/-!
# Original binary linear actors and their full root groups

The actual split amalgam marking identifies the original S with the
full Borel two-core. Thus S together with an original local factor is
normal in the original parabolic. An original normal actor containing S,
with an actual SL2 quotient whose kernel is the parabolic two-core, is
its prime-to-two residual. The lower root-cover theorem now constructs
an isomorphism of the FULL R_i with SL2, and hence of its faithful panel
image with PSL2. Every root-actor element retains an original actor lift
and the exact original quotient value.

Neither endpoint nor the full overlap is changed. The independent
marked carrier may be a geometric completion; no ambient descent or
perfectness assumption is made. This includes fields of orders two and
four. Original Chapter 10/11 actor quotient maps and the section 2/5
reflection and kernel-containment facts remain earlier-source inputs.
EqualLinearActors discharges the actor inputs from BOneActionData.

Source: DGS (10.5), (11.7)--(11.8), pp.156--157,174--176;
Fong--Seitz I (5C), (6A), pp.26,37--38.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped MatrixGroups
open Theory.AlgebraicGroup.TitsSystem.SourceBinary
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.RootCoordinates
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.HexagonStructure
namespace CFSG.Quasithin.ChapterF.Source.FongSeitzBinary.QuadrangleStructure
variable {G X : Type*} [Group G] [Group X]
  {L : Fin 2 → Subgroup G} {S : Subgroup G} {P : Fin 2 → Subgroup X}
  (Q : MarkedQuotient P)
  (e : RankTwoAmalgam.Iso
    (RankTwoAmalgam.ofSubgroups (parabolic L S 0)
      (parabolic L S 0 ⊓ parabolic L S 1) (parabolic L S 1) inf_le_left inf_le_right)
    Q.standardAmalgam)
  (h : HypothesisF11 L S) (split : SplitData Q.tits)
include Q e h split

/-- A genuine split marking forces the original common Sylow to be the full Borel core. -/
theorem marked_original_borel_core : (commonBorel L S).pCoreIn 2 = S := by
  let b : commonBorel L S ≃* Q.tits.B :=
    (MulEquiv.subgroupCongr (lemma_F_1_3_6 h).symm).trans e.middle
  have he : pCore 2 (commonBorel L S) = S.subgroupOf (commonBorel L S) := by
    apply map_injective (f := b.toMonoidHom) b.injective
    apply map_injective Q.tits.B.subtype_injective
    rw [pCore_map_iso,split.borel_twoCore,map_subgroupOf_eq_of_le split.U_le]
    rw [←MarkedLocal.sylow_range Q e h split]
    rw [MarkedLocal.sylowMap,MonoidHom.range_comp,inclusion_range,map_map]
    rfl
  rw [pCoreIn,he,map_subgroupOf_eq_of_le (show S ≤ commonBorel L S from le_sup_right)]

/-- The same full Borel normalizes the original Sylow; this is proved from the marking. -/
theorem marked_original_borel_normalizes_sylow :
    commonBorel L S ≤ normalizer (S : Set G) := by
  nth_rw 2 [←marked_original_borel_core Q e h split]
  exact (commonBorel L S).le_normalizer.trans
    (normalizer_le_normalizer_characteristic_image _ (pCore 2 _))

/-- The original subgroup generated by S and the local factor is normal
in its full parabolic once the literal split marking is supplied. -/
theorem marked_sylow_factor_normal (i : Fin 2) :
    ((S ⊔ L i).subgroupOf (parabolic L S i)).Normal := by
  apply normal_subgroupOf_of_le_normalizer
  rw [parabolic_eq_sup_commonBorel]
  apply sup_le
  · exact (show L i ≤ S ⊔ L i from le_sup_right).trans (S ⊔ L i).le_normalizer
  · exact (le_inf (marked_original_borel_normalizes_sylow Q e h split)
      (h.commonBorel_normalizes_local i)).trans (normalizer_inf_normalizer_le_normalizer_sup _ _)

private def endpointResidualEquiv (i : Fin 2) :
    primeToResidual 2 (Q.tits.standardParabolic {Q.simple i}) ≃*
      primeToResidual 2 (parabolic L S i) :=
  ((MarkedLocal.endpoint Q e i).symm.subgroupMap _).trans
    (MulEquiv.subgroupCongr (map_primeToResidual (MarkedLocal.endpoint Q e i).symm))

omit h split in
private theorem endpointResidualEquiv_apply (i : Fin 2)
    (x : primeToResidual 2 (Q.tits.standardParabolic {Q.simple i})) :
    (endpointResidualEquiv Q e i x : parabolic L S i) =
      (MarkedLocal.endpoint Q e i).symm x := by rfl

/-- Transport the residual-core identification through the actual original endpoint. -/
def markedRankOneResidualCoreEquiv (i : Fin 2) (s : RootReflection Q split i)
    (hV : simpleRemainder Q split i ≤ localKernel Q i) :
    rankOne Q split i ≃* (primeToResidual 2 (parabolic L S i) ⧸
      pCore 2 (primeToResidual 2 (parabolic L S i))) :=
  (Theory.AlgebraicGroup.TitsSystem.SourceBinary.QuadrangleStructure.rankOneResidualCoreEquiv
    Q split i s hV).trans
    (LocalCoreTransport.quotientEquiv 2
      (endpointResidualEquiv Q e i))

/-- The SL2 model is a quotient of the actual original actor, not a label
attached to a root order. The conclusion retains that quotient on every root-actor element. -/
theorem marked_linear_rankOne
    {F : Type*} [Field F] [Finite F] [CharP F 2]
    (i : Fin 2) (s : RootReflection Q split i)
    (hV : simpleRemainder Q split i ≤ localKernel Q i)
    (A : Subgroup (parabolic L S i)) [A.Normal]
    (hSA : S.subgroupOf (parabolic L S i) ≤ A)
    (f : A →* SL(2,F)) (hf : Function.Surjective f)
    (hk : f.ker = (pCore 2 (parabolic L S i)).subgroupOf A) :
    ∃ μ : rankOne Q split i ≃* SL(2,F), ∀ r : rankOne Q split i,
      ∃ a : A, MarkedLocal.endpointMap Q e i a.val = r ∧ μ r = f a := by
  let := h.finite_parabolic i
  have hkt : IsPGroup 2 f.ker := hk.symm ▸ pCore_isPGroup.comap_subtype
  obtain ⟨T,hT⟩ := h.sylow_parabolic i
  have hTS : (T : Subgroup (parabolic L S i)) = S.subgroupOf (parabolic L S i) := by
    apply map_injective (parabolic L S i).subtype_injective
    rw [hT,map_subgroupOf_eq_of_le (show S ≤ parabolic L S i from le_sup_right.trans le_sup_left)]
  have hAR : A = primeToResidual 2 (parabolic L S i) :=
    Theory.AlgebraicGroup.TitsSystem.SourceBinary.QuadrangleStructure.linear_actor_eq_residual
      A T (hTS ▸ hSA) f hf hkt
  have hcore : pCore 2 A = f.ker := by
    have hc := f.comap_pCore_of_ker_isPGroup hf hkt
    rw [Atlas.RankOneFieldAutomorphisms.sl_twoCore_eq_bot, MonoidHom.comap_bot] at hc
    exact hc.symm
  let a : primeToResidual 2 (parabolic L S i) ≃* A := MulEquiv.subgroupCongr hAR.symm
  let b : A ⧸ pCore 2 A ≃* SL(2,F) :=
    (QuotientGroup.quotientMulEquivOfEq hcore).trans
      (QuotientGroup.quotientKerEquivOfSurjective f hf)
  let μ := (markedRankOneResidualCoreEquiv Q e split i s hV).trans
    ((LocalCoreTransport.quotientEquiv 2 a).trans b)
  refine ⟨μ,?_⟩
  intro r
  let c := Theory.AlgebraicGroup.TitsSystem.SourceBinary.QuadrangleStructure.localClosureResidualEquiv
    Q split i s (inclusion (rankOne_le_localClosure Q split i) r)
  let d := endpointResidualEquiv Q e i c
  refine ⟨a d,?_,?_⟩
  · change ((MarkedLocal.endpoint Q e i) (a d).val : X ⧸ Q.D) = r
    rw [show (a d).val = d.val from MulEquiv.subgroupCongr_apply _ _,
      endpointResidualEquiv_apply, MulEquiv.apply_symm_apply]
    exact Theory.AlgebraicGroup.TitsSystem.SourceBinary.QuadrangleStructure.localClosureResidualEquiv_apply
      Q split i s _
  · dsimp only [μ,markedRankOneResidualCoreEquiv,MulEquiv.trans_apply]
    rw [Theory.AlgebraicGroup.TitsSystem.SourceBinary.QuadrangleStructure.rankOneResidualCoreEquiv_apply]
    rfl

/-- The faithful local image has exactly the same marking after its central kernel vanishes. -/
theorem marked_linear_localGroup
    {F : Type*} [Field F] [Finite F] [CharP F 2]
    (i : Fin 2) (s : RootReflection Q split i)
    (hV : simpleRemainder Q split i ≤ localKernel Q i)
    (A : Subgroup (parabolic L S i)) [A.Normal]
    (hSA : S.subgroupOf (parabolic L S i) ≤ A)
    (f : A →* SL(2,F)) (hf : Function.Surjective f)
    (hk : f.ker = (pCore 2 (parabolic L S i)).subgroupOf A) :
    ∃ μ : rankOne Q split i ≃* SL(2,F), ∃ ν : localGroup Q split i ≃* PSL(2,F),
      (∀ r, ν (RootLocalCover.projection Q split i r) =
        Atlas.RankOneFieldAutomorphisms.slEquivPSL (μ r)) ∧
      ∀ r : rankOne Q split i, ∃ a : A,
        MarkedLocal.endpointMap Q e i a.val = r ∧ μ r = f a := by
  obtain ⟨μ,hμ⟩ := marked_linear_rankOne Q e h split i s hV A hSA f hf hk
  let ν := (Theory.AlgebraicGroup.TitsSystem.SourceBinary.QuadrangleStructure.localGroupEquivOfCenterless
    Q split i hV μ Atlas.RankOneFieldAutomorphisms.sl_center_eq_bot).trans
      Atlas.RankOneFieldAutomorphisms.slEquivPSL
  refine ⟨μ,ν,?_,hμ⟩
  intro r
  dsimp only [ν,MulEquiv.trans_apply]
  rw [Theory.AlgebraicGroup.TitsSystem.SourceBinary.QuadrangleStructure.localGroupEquivOfCenterless_projection]

omit Q e split in
/-- On the literal original SourceQuotient, the actor isomorphism retains Q.q
on every representative. Either oriented endpoint may be selected. -/
theorem original_linear_rankOne
    {F : Type*} [Field F] [Finite F] [CharP F 2]
    (Q₀ : SourceQuotient L S) (split₀ : SplitData Q₀.tits)
    (i : Fin 2) (s : RootReflection Q₀ split₀ i)
    (hV : simpleRemainder Q₀ split₀ i ≤ localKernel Q₀ i)
    (A : Subgroup (parabolic L S i)) [A.Normal]
    (hSA : S.subgroupOf (parabolic L S i) ≤ A)
    (f : A →* SL(2,F)) (hf : Function.Surjective f)
    (hk : f.ker = (pCore 2 (parabolic L S i)).subgroupOf A) :
    ∃ μ : rankOne Q₀ split₀ i ≃* SL(2,F), ∀ r : rankOne Q₀ split₀ i,
      ∃ a : A, Q₀.q ⟨a.val,parabolic_le_generated i a.val.property⟩ = r ∧ μ r = f a := by
  obtain ⟨μ,hμ⟩ := marked_linear_rankOne Q₀ (originalMarkedIso Q₀) h split₀ i s hV A hSA f hf hk
  refine ⟨μ,?_⟩
  intro r
  obtain ⟨a,ha,he⟩ := hμ r
  exact ⟨a,(original_endpointMap_apply Q₀ i a.val).symm.trans ha,he⟩

end CFSG.Quasithin.ChapterF.Source.FongSeitzBinary.QuadrangleStructure
