module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.FongSeitzBinary.NormalGeneration
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.FongSeitzBinary.GenericApplication

/-!
# Unipotent normal generation for the selected generic pair

Apply the normal-generation reduction to the literal pair ![L,R] and
S = O₂(N_G(L) ∩ H). Both perfectness hypotheses are already supplied by
the actual generic comparison consumer: L is perfect by local-family
membership and R is the selected perfect factor. The preparation gives
the genuine F.1.1 two-subgroup premise. Thus the same quotient used by
the marked local lift is generated by conjugates of its specified U,
and has no nontrivial quotient of odd order. The original S maps to that
very U, preserving the source Sylow marking without a conjugation choice.

The earlier marked quotient and split data remain explicit inputs from
qt-dgs85-apartment-exchange. No irreducibility, full minimal configuration
or exhaustive Lie comparison is inferred from normal generation alone.
These remain with this Fong–Seitz family; the generic-global and DGS
assembly owners retain all earlier premise discharge and other branches.

Source: DGS Theorem D, printed p.224 and its minimality caution on pp.80–81;
Aschbacher–Smith 5.2.6, pp.650–651, and the Chapter12 use on p.795.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open Theory.AlgebraicGroup.TitsSystem.SourceBinary
namespace CFSG.Quasithin.ChapterF.Source.FongSeitzBinary
open Chapter6.Source.RankOneGeneric
variable {G : Type*} [Group G] [Finite G]
  {κ : GroupClass} {T : Sylow 2 G} {L W H A B R : Subgroup G} {n : ℕ}

/-- The unipotent subgroup in the selected quotient is the image of the
original S = O₂(N_G(L) ∩ H), with the original quotient map retained. -/
theorem prepared_quotient_sourceS_image_eq_unipotent
    (d : Global.Preparation T L H A B R) (h : Input κ T L W n)
    (hTH : (T : Subgroup G) ≤ H)
    (Q : SourceQuotient ![L,R] (Global.sourceS L H)) (split : SplitData Q.tits) :
    ((Global.sourceS L H).subgroupOf (generated ![L,R] (Global.sourceS L H))).map Q.q =
      split.U :=
  quotient_sourceS_image_eq_unipotent (d.hypothesisF11 h hTH) Q split

/-- The actual selected pair in the generic Chapter12 comparison needs no
additional normal-generation premise. The perfectness of its left factor
is inherited from local-family membership; the right perfectness is exactly
the premise already present in the comparison consumer. -/
theorem prepared_quotient_normal_generation
    (d : Global.Preparation T L H A B R) (h : Input κ T L W n)
    (hTH : (T : Subgroup G) ≤ H) (hR : Group.IsPerfect R)
    (Q : SourceQuotient ![L,R] (Global.sourceS L H)) (split : SplitData Q.tits) :
    normalClosure (split.U : Set ((generated ![L,R] (Global.sourceS L H)) ⧸ Q.D)) = ⊤ ∧
      primeToResidual 2 ((generated ![L,R] (Global.sourceS L H)) ⧸ Q.D) = ⊤ := by
  have hp : ∀ i : Fin 2, Group.IsPerfect (![L,R] i) := by
    intro i
    fin_cases i
    · exact Chapter1.mem_L_isPerfect h.local_mem.1.1
    · exact hR
  have hS := (d.hypothesisF11 h hTH).S_isP
  constructor
  · rw [← split.unipotentClosure_eq_normalClosure]
    exact quotient_unipotentClosure_eq_top hS hp Q split
  · exact quotient_primeToResidual_eq_top hS hp Q split

end CFSG.Quasithin.ChapterF.Source.FongSeitzBinary
