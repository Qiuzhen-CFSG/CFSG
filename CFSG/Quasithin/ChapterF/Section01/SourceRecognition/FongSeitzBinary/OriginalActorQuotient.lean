module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.FongSeitzBinary.RegularFactorCover
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.FongSeitzBinary.QuadrangleStructure.ProfileActors
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.FongSeitzBinary.LinearLocal
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.FongSeitzBinary.LinearRootCoordinates
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.FongSeitzBinary.QuadrangleStructure.MarkedRadicals

/-!
# Original actors and their literal factor quotients

In the same marked split quotient, the original actor S L_i is precisely
its pulled-back full root closure. Both contain S and L_i; normality of
S L_i in the original parabolic puts the reflected S in that actor, while
normal generation by the local Sylow puts L_i in the root closure.

The regular whole-cover comparison therefore constructs a surjective map
from S L_i to L_i/O₂(L_i), with kernel exactly O₂(P_i) restricted to the
actor. On every original factor element it is the original quotient map.
The scalar center is retained, and neither perfectness nor a restriction
on the Weyl order is used in this construction.

For an actual binary PSL₂ factor, local regularity and the root/Sylow order
identity discharge both cover premises. Composing with PSL₂ ≃ SL₂ gives
the full actor marking, including the binary case. Its restriction to S
also proves that S/O₂(P_i) is elementary. FactorProfileRecognition uses
these maps to remove the extra actor, Sylow quotient and index premises
from the original quadratic U₄ consumer.

Source: Fong--Seitz I (5B)--(5C), pp.25--26; DGS (11.5)--(11.7),
pp.173--175; AS F.1.1--3. The original source profile and the marked split
quotient remain earlier inputs; this is not exhaustive row selection.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped MatrixGroups
open Theory.AlgebraicGroup.TitsSystem.SourceBinary
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.RootCoordinates
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.HexagonStructure
namespace CFSG.Quasithin.ChapterF.Source.FongSeitzBinary.MarkedLocal
variable {G X : Type*} [Group G] [Group X]
  {L : Fin 2 → Subgroup G} {S : Subgroup G} {P : Fin 2 → Subgroup X}
  (Q : MarkedQuotient P)
  (e : RankTwoAmalgam.Iso
    (RankTwoAmalgam.ofSubgroups (parabolic L S 0)
      (parabolic L S 0 ⊓ parabolic L S 1) (parabolic L S 1) inf_le_left inf_le_right)
    Q.standardAmalgam)
  (h : HypothesisF11 L S) (split : SplitData Q.tits) (i : Fin 2)

include h in
/-- The original full root closure is exactly the actor generated by S and Lᵢ. -/
theorem originalLocalClosure_eq_sylow_factor :
    originalLocalClosure Q e split i = (S ⊔ L i).subgroupOf (parabolic L S i) := by
  let A := (S ⊔ L i).subgroupOf (parabolic L S i)
  let : A.Normal := QuadrangleStructure.marked_sylow_factor_normal Q e h split i
  have hSA : S.subgroupOf (parabolic L S i) ≤ A := subgroupOf_mono _ le_sup_left
  apply le_antisymm
  · rw [originalLocalClosure_eq Q e h split i]
    refine sup_le hSA ?_
    intro x hx
    have hxA := hSA hx
    have hz := (inferInstance : A.Normal).conj_mem (originalSimpleLift Q e i * x * (originalSimpleLift Q e i)⁻¹)
      hxA (originalSimpleLift Q e i)⁻¹
    simpa only [mul_assoc, inv_inv, inv_mul_cancel, mul_one, inv_mul_cancel_left] using hz
  · rw [subgroupOf_sup (show S ≤ parabolic L S i from le_sup_right.trans le_sup_left)
      (show L i ≤ parabolic L S i from le_sup_left.trans le_sup_left)]
    apply sup_le
    · intro x hx
      change endpointMap Q e i x ∈ localClosure Q split i
      apply mem_sup_left
      change x ∈ split.U.comap (endpointMap Q e i)
      rwa [endpoint_unipotent_comap Q e h split i]
    · intro x hx
      exact factor_le_localClosure Q e h split i ⟨⟨x,hx⟩,rfl⟩

/-- Identify the actor with that closure without changing its endpoint inclusion. -/
def originalActorClosureEquiv :
    (S ⊔ L i).subgroupOf (parabolic L S i) ≃* originalLocalClosure Q e split i :=
  MulEquiv.subgroupCongr (originalLocalClosure_eq_sylow_factor Q e h split i).symm

/-- The equivalence preserves every original parabolic element. -/
theorem originalActorClosureEquiv_apply
    (a : (S ⊔ L i).subgroupOf (parabolic L S i)) :
    (originalActorClosureEquiv Q e h split i a : parabolic L S i) = a := by rfl

include h in
/-- Regularity identifies the original cover kernel with the full parabolic two-core. -/
theorem originalRadicalInClosure_eq_core
    (hV : simpleRemainder Q split i ≤ localKernel Q i) :
    originalRadicalInClosure Q e split i =
      (pCore 2 (parabolic L S i)).subgroupOf (originalLocalClosure Q e split i) := by
  unfold originalRadicalInClosure
  rw [← original_radical_comap Q e h split i]
  change ((split.U ⊓ localKernel Q i).comap (endpointMap Q e i)).subgroupOf _ = _
  rw [← remainder_eq_unipotent_inf_kernel Q split i hV,
    remainder_comap_of_containment Q e split i hV]

/-- The literal inclusion of the original factor into S Lᵢ. -/
def originalFactorIntoActor : L i →* (S ⊔ L i).subgroupOf (parabolic L S i) where
  toFun a := ⟨⟨a,(show L i ≤ parabolic L S i from le_sup_left.trans le_sup_left) a.property⟩,
    mem_sup_right a.property⟩
  map_one' := rfl
  map_mul' _ _ := rfl

variable [Finite (L i)]
  (T : Sylow 2 (L i)) (hT : (T : Subgroup (L i)).map (L i).subtype = S ⊓ L i)
  (hV : simpleRemainder Q split i ≤ localKernel Q i)
  (hc : Nat.card (simpleRoot Q split i) = Nat.card (quotientSylow T))

/-- The actual actor quotient, retaining the full original factor quotient. -/
def regularActorQuotient :
    (S ⊔ L i).subgroupOf (parabolic L S i) →* ((L i) ⧸ pCore 2 (L i)) := by
  let := originalRadicalInClosure_normal Q e h split i
  exact (regularOriginalFactorCoverEquiv Q e h split i T hT hV hc).toMonoidHom.comp
    ((QuotientGroup.mk' (originalRadicalInClosure Q e split i)).comp
      (originalActorClosureEquiv Q e h split i).toMonoidHom)

/-- The regular cover supplies every element of the original quotient. -/
theorem regularActorQuotient_surjective :
    Function.Surjective (regularActorQuotient Q e h split i T hT hV hc) := by
  let := originalRadicalInClosure_normal Q e h split i
  exact (regularOriginalFactorCoverEquiv Q e h split i T hT hV hc).surjective.comp
    ((QuotientGroup.mk'_surjective _).comp (originalActorClosureEquiv Q e h split i).surjective)

/-- The kernel is the literal restriction of O₂(Pᵢ), not the full panel kernel. -/
theorem regularActorQuotient_ker :
    (regularActorQuotient Q e h split i T hT hV hc).ker =
      (pCore 2 (parabolic L S i)).subgroupOf ((S ⊔ L i).subgroupOf (parabolic L S i)) := by
  let := originalRadicalInClosure_normal Q e h split i
  let a := regularOriginalFactorCoverEquiv Q e h split i T hT hV hc
  ext x
  change a (QuotientGroup.mk' _ (originalActorClosureEquiv Q e h split i x)) = 1 ↔ _
  rw [← a.map_one, a.injective.eq_iff]
  change originalActorClosureEquiv Q e h split i x ∈
    (QuotientGroup.mk' (originalRadicalInClosure Q e split i)).ker ↔ _
  rw [QuotientGroup.ker_mk', originalRadicalInClosure_eq_core Q e h split i hV]
  rfl

/-- On original factor representatives the map agrees with the original quotient. -/
theorem regularActorQuotient_factor (a : L i) :
    regularActorQuotient Q e h split i T hT hV hc (originalFactorIntoActor i a) =
      QuotientGroup.mk' (pCore 2 (L i)) a := by
  let := originalRadicalInClosure_normal Q e h split i
  change regularOriginalFactorCoverEquiv Q e h split i T hT hV hc
    (QuotientGroup.mk' _ (originalActorClosureEquiv Q e h split i (originalFactorIntoActor i a))) = _
  have he : originalActorClosureEquiv Q e h split i (originalFactorIntoActor i a) =
      originalFactorIntoClosure Q e h split i a := by
    apply Subtype.ext
    apply Subtype.ext
    exact (originalFactorIntoClosure_coe Q e h split i a).symm
  rw [he, regularOriginalFactorCoverEquiv_mk_factor]

end CFSG.Quasithin.ChapterF.Source.FongSeitzBinary.MarkedLocal

namespace CFSG.Quasithin.ChapterF.Source.FongSeitzBinary.MarkedLocal
variable {G X F : Type*} [Group G] [Group X] [Field F] [Finite F] [CharP F 2]
  {L : Fin 2 → Subgroup G} {S : Subgroup G} {P : Fin 2 → Subgroup X}
  (Q : MarkedQuotient P)
  (e : RankTwoAmalgam.Iso
    (RankTwoAmalgam.ofSubgroups (parabolic L S 0)
      (parabolic L S 0 ⊓ parabolic L S 1) (parabolic L S 1) inf_le_left inf_le_right)
    Q.standardAmalgam)
  (h : HypothesisF11 L S) (split : SplitData Q.tits) (i : Fin 2)

include h e split in
/-- A genuine PSL₂ factor constructs the full SL₂ actor map and its exact kernel. -/
theorem linear_actor_quotient_of_factor
    (μ : ((L i) ⧸ pCore 2 (L i)) ≃* PSL(2,F)) :
    ∃ f : (S ⊔ L i).subgroupOf (parabolic L S i) →* SL(2,F),
      Function.Surjective f ∧
      f.ker = (pCore 2 (parabolic L S i)).subgroupOf
        ((S ⊔ L i).subgroupOf (parabolic L S i)) ∧
      ∀ a : L i, f (originalFactorIntoActor i a) =
        Atlas.RankOneFieldAutomorphisms.slEquivPSL.symm (μ (QuotientGroup.mk' _ a)) := by
  let := h.finite_local i
  obtain ⟨T,hT⟩ := h.sylow i
  have hV := linear_remainder_le_kernel Q e h split i T hT μ
  have hs : Nat.card (quotientSylow T) = Nat.card F :=
    (Nat.card_congr (linearSylowEquiv i T μ).toEquiv).trans
      ((Nat.card_congr (BenderSuzuki.ZD.Linear.psl2SylowEquivAdditive
        (linearModelSylow i T μ)).symm.toEquiv).trans
          (Nat.card_congr Multiplicative.toAdd))
  have hc := (simpleRoot_card_linear Q e h split i T hT μ).trans hs.symm
  let a := μ.trans Atlas.RankOneFieldAutomorphisms.slEquivPSL.symm
  let f := a.toMonoidHom.comp (regularActorQuotient Q e h split i T hT hV hc)
  refine ⟨f,a.surjective.comp (regularActorQuotient_surjective Q e h split i T hT hV hc),?_,?_⟩
  · change (a.toMonoidHom.comp _).ker = _
    rw [MonoidHom.ker_comp_of_injective _ _ a.injective]
    exact regularActorQuotient_ker Q e h split i T hT hV hc
  · intro l
    change a (regularActorQuotient Q e h split i T hT hV hc _) = _
    rw [regularActorQuotient_factor]
    rfl

omit Q e split in
include h in
/-- The original Sylow quotient embeds in an elementary SL₂ Sylow subgroup. -/
theorem sylow_core_elementary_of_linear_actor
    (f : (S ⊔ L i).subgroupOf (parabolic L S i) →* SL(2,F))
    (hk : f.ker = (pCore 2 (parabolic L S i)).subgroupOf
      ((S ⊔ L i).subgroupOf (parabolic L S i))) :
    letI := QuadrangleStructure.original_core_normal_in_sylow (L := L) (S := S) i
    IsElementaryAbelian 2 (S ⧸ ((parabolic L S i).pCoreIn 2).subgroupOf S) := by
  let := QuadrangleStructure.original_core_normal_in_sylow (L := L) (S := S) i
  let j : S →* (S ⊔ L i).subgroupOf (parabolic L S i) :=
    { toFun := fun s => ⟨⟨s,(show S ≤ parabolic L S i from le_sup_right.trans le_sup_left) s.property⟩,mem_sup_left s.property⟩
      map_one' := rfl
      map_mul' _ _ := rfl }
  let g := f.comp j
  have hg : g.ker = ((parabolic L S i).pCoreIn 2).subgroupOf S := by
    ext s
    change j s ∈ f.ker ↔ _
    rw [hk]
    constructor
    · intro hs
      exact ⟨(j s).val,hs,rfl⟩
    · rintro ⟨a,ha,he⟩
      have he' : a = (j s).val := Subtype.ext he
      change (j s).val ∈ pCore 2 (parabolic L S i)
      rw [← he']
      exact ha
  have hp : IsPGroup 2 g.range :=
    h.S_isP.of_surjective g.rangeRestrict g.rangeRestrict_surjective
  obtain ⟨T,hT⟩ := hp.exists_le_sylow
  let a := Matrix.SpecialLinearGroup.sylowEquivAdditive F 2 T
  let : IsElementaryAbelian 2 (Multiplicative F) :=
    { toIsMulCommutative := inferInstance
      exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr (fun x => by
        apply Multiplicative.toAdd.injective
        change (x^2).toAdd = 0
        rw [pow_two]
        exact CharTwo.add_self_eq_zero x.toAdd) }
  let : IsElementaryAbelian 2 T := IsElementaryAbelian.of_injective a.symm.toMonoidHom a.symm.injective
  let : IsElementaryAbelian 2 g.range := IsElementaryAbelian.of_injective
    (inclusion hT) (inclusion_injective hT)
  let b := (QuotientGroup.quotientMulEquivOfEq hg.symm).trans
    (QuotientGroup.quotientKerEquivRange g)
  exact IsElementaryAbelian.of_injective b.toMonoidHom b.injective

end CFSG.Quasithin.ChapterF.Source.FongSeitzBinary.MarkedLocal
