module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.FongSeitzBinary.LocalCover
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.FongSeitzBinary.GenericSylowGeneratedReduction

/-!
# Local central odd covers for the selected Chapter12 pair

The exact F.1.1 pair ![L,R] supplied by the preparation has a local cover
at each marked endpoint. Its numerator is the subgroup generated by the
original S and the conjugate under the actual lifted simple reflection;
its denominator is the intersection with the full original panel kernel.
The resulting map to the same finite quotient's local permutation group
is surjective with central odd kernel contained in the derived subgroup.
Neither the selected R nor the resulting local group is assumed perfect.

This applies Fong--Seitz I (5B), printed p.25, to the literal generic
Chapter12 source. The apartment/exchange producer still supplies the
marked quotient, both endpoint squares and split datum. Identifying these
local permutation groups, obtaining the smaller root-generated covers,
and assembling the seven marked Lie comparisons remain recognition work;
this theorem does not discharge ConcreteAmalgamComparison by itself.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open Theory.AlgebraicGroup.TitsSystem.SourceBinary
open Theory.AlgebraicGroup.TitsSystem.SourceBinary.HexagonStructure
namespace CFSG.Quasithin.ChapterF.Source.FongSeitzBinary
open Chapter6.Source.RankOneGeneric
variable {G X : Type*} [Group G] [Finite G] [Group X]
  {κ : GroupClass} {T : Sylow 2 G} {L W H A B R : Subgroup G} {n : ℕ}
  {P : Fin 2 → Subgroup X}

/-- The full local-cover statement for either actual selected endpoint. -/
theorem prepared_original_local_cover
    (d : Global.Preparation T L H A B R) (h : Input κ T L W n)
    (hTH : (T : Subgroup G) ≤ H) (Q : MarkedQuotient P)
    (e : RankTwoAmalgam.Iso
      (Global.sourceParabolicAmalgam ![L,R] (Global.sourceS L H)) Q.standardAmalgam)
    (split : SplitData Q.tits) (i : Fin 2) :
    let hs := d.hypothesisF11 h hTH
    letI := MarkedLocal.originalRadicalInClosure_normal Q e hs split i
    let E := MarkedLocal.originalLocalClosure Q e split i ⧸ MarkedLocal.originalRadicalInClosure Q e split i
    Function.Surjective (MarkedLocal.originalProjection Q e hs split i) ∧
      (MarkedLocal.originalProjection Q e hs split i).ker ≤ center E ∧
      Nat.Coprime 2 (Nat.card (MarkedLocal.originalProjection Q e hs split i).ker) ∧
      (MarkedLocal.originalProjection Q e hs split i).ker ≤ _root_.commutator E :=
  MarkedLocal.original_central_odd_cover Q e (d.hypothesisF11 h hTH) split i

end CFSG.Quasithin.ChapterF.Source.FongSeitzBinary

namespace CFSG.Quasithin.Chapter12.Section02.ChosenModule
open Chapter6.Source.RankOneGeneric ChapterF.Source ChapterF.Source.FongSeitzBinary
variable {G X : Type*} [Group G] [Finite G] [Group X]
  {T : Sylow 2 G} {L V H A B R : Subgroup G} {P : Fin 2 → Subgroup X}
  (D : ChosenModule T L V)
include D

/-- The literal Chapter12 application supplies (5B) at both oriented endpoints,
without replacing a full small local group by its derived subgroup. -/
theorem rankOne_global_original_local_cover
    (h : Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    {n : ℕ} (hn : 1 < n)
    (hpsl : ClassicalGroup.IsPSL (L ⧸ pCore 2 L) 2 (2^n))
    (d : Global.Preparation T L H A B R) (hTH : (T : Subgroup G) ≤ H)
    (Q : MarkedQuotient P)
    (e : RankTwoAmalgam.Iso
      (Global.sourceParabolicAmalgam ![L,R] (Global.sourceS L H)) Q.standardAmalgam)
    (split : SplitData Q.tits) (i : Fin 2) :
    let hs := d.hypothesisF11 (D.rankOne_generic_input_of_many h hmany hn hpsl) hTH
    letI := MarkedLocal.originalRadicalInClosure_normal Q e hs split i
    let E := MarkedLocal.originalLocalClosure Q e split i ⧸ MarkedLocal.originalRadicalInClosure Q e split i
    Function.Surjective (MarkedLocal.originalProjection Q e hs split i) ∧
      (MarkedLocal.originalProjection Q e hs split i).ker ≤ center E ∧
      Nat.Coprime 2 (Nat.card (MarkedLocal.originalProjection Q e hs split i).ker) ∧
      (MarkedLocal.originalProjection Q e hs split i).ker ≤ _root_.commutator E :=
  prepared_original_local_cover d
    (D.rankOne_generic_input_of_many h hmany hn hpsl) hTH Q e split i

end CFSG.Quasithin.Chapter12.Section02.ChosenModule
