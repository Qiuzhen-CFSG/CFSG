module
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.FongSeitzBinary.A2Source.CompatibleRoots
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.FongSeitzBinary.A2Source.CoreSylow
public import CFSG.Quasithin.ChapterF.Section01.SourceRecognition.FongSeitzBinary.A2Source.NormalGeneration
public import Theory.Combinatorics.TranslationPlane.FullFlagElations

/-!
# Full generation by the six source roots

The faithful geometric action maps the six-root closure onto the native
SL₃ collineation image. Full geometric flag groups make that image normal.
The original axis core acts by native translations; normality and natural
conjugacy of the shared nontrivial intersection put the other core in the
same subgroup. Their product is the original U. Source normal generation
therefore gives the whole quotient, including the nonperfect q=2 case.
The proved presentation then constructs the actual unmarked PSL₃ equivalence.

Source: DGS, Groups and Graphs, 10.5 and Theorem D, printed pp.156,224;
Steinberg, Lectures on Chevalley Groups, Section 6.
-/

@[expose] public noncomputable section
open Subgroup Configuration
open scoped MatrixGroups
namespace CFSG.Quasithin.ChapterF.Source.FongSeitzBinary.A2Source
open DGS85 DGS85.NoncommutingProfile Subgroup.CosetGeometry.RankTwo
open Theory.AlgebraicGroup.TitsSystem.SourceBinary
namespace ProjectiveCoordinates
variable {G : Type*} [Group G] {L : Fin 2 → Subgroup G} {S : Subgroup G}
  (h : HypothesisF11 L S) (d : SourceQuotient L S)
variable {k₀ k₁ W₀ W₁ : Type*} [Field k₀] [Finite k₀] [CharP k₀ 2]
  [Field k₁] [Finite k₁] [CharP k₁ 2]
  [AddCommGroup W₀] [Module (ZMod 2) W₀] [AddCommGroup W₁] [Module (ZMod 2) W₁]
local instance rootGenerationFieldAlgebra {K : Type*} [Field K] [CharP K 2] : Algebra (ZMod 2) K := ZMod.algebra K 2
variable
  (c₀ : BOneActionData (fullFamily L S) (base (fullFamily L S) false)
    (base (fullFamily L S) true) k₀ W₀)
  (c₁ : BOneActionData (fullFamily L S) (base (fullFamily L S) true)
    (base (fullFamily L S) false) k₁ W₁)
  (hn₀ : (commonBorel L S).subgroupOf (generated L S) ≤ normalizer (c₀.actor : Set (generated L S)))
  (hn₁ : (commonBorel L S).subgroupOf (generated L S) ≤ normalizer (c₁.actor : Set (generated L S)))
  (E₀ : W₀ ≃ₗ[ZMod 2] (Fin 2 → k₀)) (E₁ : W₁ ≃ₗ[ZMod 2] (Fin 2 → k₁))
  (hm : RootCoordinates.rotationOrder d = 3) (hcenter : centerIn c₁.actor = ⊥)

variable (o : {p : Point (TriangleGeometry.family d) // p ∉ QuotientPlane.axis d})

open Theory.SpecificGroups.LinearHigher
open scoped commutatorElement

/-- The subgroup generated by all six simultaneously parametrized source roots. -/
def rootClosure : Subgroup ((generated L S) ⧸ d.D) :=
  closure {g | ∃ r a, g = compatibleRoot h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o r a}

/-- The root-generated subgroup has exactly the native matrix action image. -/
theorem rootClosure_map_action :
    (rootClosure h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o).map
      (action h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o) =
        (specialLinearCollineation (K := k₁)).range := by
  apply le_antisymm
  · apply map_le_iff_le_comap.mpr
    apply (closure_le _).mpr
    rintro _ ⟨r,a,rfl⟩
    exact ⟨matrixRoot r a, (action_compatibleRoot h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o r a).symm⟩
  · rintro _ ⟨A,rfl⟩
    apply Atlas.sl_elementary_induction
      (fun A : SL(3,k₁) => specialLinearCollineation A ∈
        (rootClosure h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o).map
          (action h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o)) _
      (fun A B hA hB => by rw [map_mul]; exact mul_mem hA hB) A
    intro i j hij a
    refine ⟨compatibleRoot h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o (root i j hij) a,
      subset_closure ⟨root i j hij,a,rfl⟩,?_⟩
    exact action_compatibleRoot h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o _ _

/-- Source membership is determined faithfully by the native matrix image. -/
theorem rootClosure_eq_comap : rootClosure h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o =
    (specialLinearCollineation (K := k₁)).range.comap
      (action h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o) := by
  rw [←rootClosure_map_action h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o]
  exact (comap_map_eq_self_of_injective
    (action_injective h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o) _).symm

/-- The constructed six-root subgroup is normal in the whole same source quotient. -/
theorem rootClosure_normal : (rootClosure h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o).Normal := by
  rw [rootClosure_eq_comap]
  let := TranslationPlane.FieldChart.specialLinear_range_normal (F := k₁)
  infer_instance

/-- The whole original axis core belongs to the six-root subgroup, including q=2. -/
theorem original_axisCore_le_rootClosure :
    (Q (fullFamily L S) (base (fullFamily L S) true)).map d.q ≤
      rootClosure h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o := by
  rintro _ ⟨a,ha,rfl⟩
  rw [rootClosure_eq_comap]
  change action h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o (d.q a) ∈ (specialLinearCollineation (K := k₁)).range
  rw [action_core h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o ⟨a,ha⟩]
  exact ⟨_,rfl⟩

include h c₁ E₀ E₁ hcenter in
/-- The other actor center is trivial by the actual paired natural-core orders. -/
theorem original_other_center_eq_bot : centerIn c₀.actor = ⊥ := by
  apply card_eq_one.mp
  have hh := paired_actor_center_orders_eq h.generatedLocallyRankOneTriple c₀ c₁ E₀ E₁
  rwa [hcenter,card_bot] at hh

/-- Normality and the shared core intersection place the whole point core in the same root subgroup. -/
theorem original_pointCore_le_rootClosure :
    (Q (fullFamily L S) (base (fullFamily L S) false)).map d.q ≤
      rootClosure h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o := by
  let R := rootClosure h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o
  let : R.Normal := rootClosure_normal h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o
  let I := Q (fullFamily L S) (base (fullFamily L S) true) ⊓
    Q (fullFamily L S) (base (fullFamily L S) false)
  have hI : I ≠ ⊥ := by
    intro he
    have hh := core_intersection_card c₁ h.generatedLocallyRankOneTriple
      (paired_cores_eq_centers_of_actions h.generatedLocallyRankOneTriple c₀ c₁).2 hcenter E₁
    change Nat.card I = Nat.card k₁ at hh
    rw [he,card_bot] at hh
    exact Finite.one_lt_card.ne hh
  obtain ⟨z,hz,hz1⟩ := SetLike.exists_of_lt (bot_lt_iff_ne_bot.mpr hI)
  change z ≠ 1 at hz1
  rintro _ ⟨a,ha,rfl⟩
  by_cases ha1 : a = 1
  · rw [ha1,map_one]; exact R.one_mem
  obtain ⟨b,hb⟩ := core_nonidentity_conjugate c₀ h.generatedLocallyRankOneTriple
    (paired_cores_eq_centers_of_actions h.generatedLocallyRankOneTriple c₀ c₁).1
    (original_other_center_eq_bot h c₀ c₁ E₀ E₁ hcenter) E₀
    ⟨z,hz.2⟩ ⟨a,ha⟩ (fun he => hz1 (congrArg Subtype.val he))
      (fun he => ha1 (congrArg Subtype.val he))
  have hzR : d.q z ∈ R := original_axisCore_le_rootClosure h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o
    (mem_map_of_mem _ hz.1)
  have hh := Subgroup.Normal.conj_mem (inferInstance : R.Normal) _ hzR (d.q b)
  rw [←map_inv,←map_mul,←map_mul,hb] at hh
  exact hh

/-- All six roots generate the same full quotient, with no perfect-factor premise. -/
theorem compatibleRoot_generate (split : SplitData d.tits) :
    closure {g | ∃ r a, g = compatibleRoot h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o r a} = ⊤ := by
  let R := rootClosure h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o
  let : R.Normal := rootClosure_normal h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o
  apply normal_eq_top_of_unipotent_le d (originalMarkedIso d) h split R
  rw [←original_core_sup_image h c₀ c₁ d split,Subgroup.map_sup]
  exact sup_le (original_pointCore_le_rootClosure h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o)
    (original_axisCore_le_rootClosure h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o)

/-- The six constructed source roots now give a whole PSL₃ equivalence.
This precedes, and does not assume, any marked model comparison. -/
def unmarkedEquiv (split : SplitData d.tits) : ((generated L S) ⧸ d.D) ≃* PSL(3,k₁) := by
  let := Matrix.PSL3.RootPresentationRecognition.quotient_nontrivial d
  exact Matrix.PSL3.RootPresentationRecognition.equiv
    (compatibleRoot_relations h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o)
    (compatibleRoot_generate h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o split)
    (LinearThreePresentation.center_eq_bot d (originalMarkedIso d) h split)

/-- Every parameter in the initial common projective frame is preserved. -/
theorem unmarkedEquiv_root (split : SplitData d.tits) (r : Root 3) (a : k₁) :
    unmarkedEquiv h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o split
      (compatibleRoot h d c₀ c₁ hn₀ hn₁ E₀ E₁ hm hcenter o r a) = projectiveRoot r a := by
  let := Matrix.PSL3.RootPresentationRecognition.quotient_nontrivial d
  exact Matrix.PSL3.RootPresentationRecognition.equiv_root _ _ _ r a

end ProjectiveCoordinates
end CFSG.Quasithin.ChapterF.Source.FongSeitzBinary.A2Source
