module

public import CFSG.Quasithin.ChapterF.Section01.SourceCartan.Hall

/-!
# Literal products and the quadratic action in F.1.3(5)

Source: Aschbacher–Smith, printed p.260, last paragraph of the proof.
The Hall complements constructed in `Hall` give Bᵢ = SᵢDᵢ and B = SD₁D₂
as set products, with trivial intersections, exact indices and coprime
orders. The normalizations are established before joins are read as products.
The individual abelian complements also make each conjugation displacement
of D₂ on D₁ fixed by its actor. Joint commutativity is not used here.
-/

public section
open Subgroup Subgroup.OddHall
open scoped Pointwise
namespace CFSG.Quasithin.ChapterF.Source
variable {G : Type*} [Group G] {L : Fin 2 → Subgroup G} {S : Subgroup G}

/-- Each local Borel is generated by its specified Sylow subgroup and complement. -/
theorem CompatibleCartans.local_sup (c : CompatibleCartans L S) (i : Fin 2) :
    (S ⊓ L i) ⊔ c.D i = borel (L i) S := by
  have he := congrArg (Subgroup.map (borel (L i) S).subtype) (c.complement i).sup_eq_top
  simpa only [Subgroup.map_sup, map_subgroupOf_eq_of_le (localSylow_le_borel _ _),
    map_subgroupOf_eq_of_le (c.le_borel i), ← MonoidHom.range_eq_map, range_subtype] using he

/-- The local complement has trivial intersection with the original local Sylow. -/
theorem CompatibleCartans.local_disjoint (c : CompatibleCartans L S) (i : Fin 2) :
    Disjoint (S ⊓ L i) (c.D i) := by
  have he := disjoint_map (borel (L i) S).subtype_injective (c.complement i).disjoint
  simpa only [map_subgroupOf_eq_of_le (localSylow_le_borel _ _),
    map_subgroupOf_eq_of_le (c.le_borel i)] using he

/-- The local Borel is the literal product SᵢDᵢ. -/
theorem CompatibleCartans.local_coe_eq_mul (c : CompatibleCartans L S) (i : Fin 2) :
    (borel (L i) S : Set G) = ((S ⊓ L i : Subgroup G) : Set G) * (c.D i : Set G) := by
  rw [← c.local_sup i, coe_mul_of_right_le_normalizer_left _ _ ((c.le_borel i).trans inf_le_right)]

/-- The joint complement lies in the common Borel. -/
theorem CompatibleCartans.joint_le (c : CompatibleCartans L S) :
    c.D 0 ⊔ c.D 1 ≤ commonBorel L S :=
  sup_le ((c.le_borel 0).trans (borel_le_commonBorel 0))
    ((c.le_borel 1).trans (borel_le_commonBorel 1))

/-- Mutual normalization identifies the join with the literal product D₁D₂. -/
theorem CompatibleCartans.joint_coe_eq_mul (c : CompatibleCartans L S) :
    ((c.D 0 ⊔ c.D 1 : Subgroup G) : Set G) = (c.D 0 : Set G) * (c.D 1 : Set G) :=
  coe_mul_of_right_le_normalizer_left _ _ (c.normalizes 1)

/-- The actual factorization B = SD₁D₂, before proving joint commutativity. -/
theorem CompatibleCartans.commonBorel_coe_eq_mul (c : CompatibleCartans L S) :
    (commonBorel L S : Set G) = (S : Set G) * (c.D 0 : Set G) * (c.D 1 : Set G) := by
  rw [mul_assoc, ← c.joint_coe_eq_mul]
  ext x
  constructor
  · intro hx
    obtain ⟨⟨a,b⟩, hab⟩ := c.joint_complement.2 ⟨x,hx⟩
    exact ⟨a.val.val, a.property, b.val.val, b.property, congrArg Subtype.val hab⟩
  · rintro ⟨a, ha, b, hb, rfl⟩
    exact (commonBorel L S).mul_mem ((show S ≤ commonBorel L S from le_sup_right) ha) (c.joint_le hb)

/-- The joint complement intersects the original S trivially. -/
theorem CompatibleCartans.joint_disjoint (c : CompatibleCartans L S) :
    Disjoint S (c.D 0 ⊔ c.D 1) := by
  have he := disjoint_map (commonBorel L S).subtype_injective c.joint_complement.disjoint
  simpa only [map_subgroupOf_eq_of_le (show S ≤ commonBorel L S from le_sup_right),
    map_subgroupOf_eq_of_le c.joint_le] using he

/-- The Hall complement has index exactly |S| in B. -/
theorem CompatibleCartans.joint_index (c : CompatibleCartans L S) :
    (c.D 0 ⊔ c.D 1).relIndex (commonBorel L S) = Nat.card S := by
  exact c.joint_complement.index_eq_card.trans
    (Nat.card_congr (subgroupOfEquivOfLe (show S ≤ commonBorel L S from le_sup_right)).toEquiv)

/-- The local complement has index exactly |Sᵢ| in Bᵢ. -/
theorem CompatibleCartans.local_index (c : CompatibleCartans L S) (i : Fin 2) :
    (c.D i).relIndex (borel (L i) S) = Nat.card (S ⊓ L i : Subgroup G) := by
  exact (c.complement i).index_eq_card.trans
    (Nat.card_congr (subgroupOfEquivOfLe (localSylow_le_borel _ _)).toEquiv)

/-- Because D₁ normalizes the abelian D₂, each element of D₂ fixes its
conjugation displacements on D₁. This is the actual input to the rank-one
field-automorphism step. -/
theorem CompatibleCartans.quadratic_conjugation (c : CompatibleCartans L S)
    {x y : G} (hx : x ∈ c.D 0) (hy : y ∈ c.D 1) :
    y * (y * x * y⁻¹ * x⁻¹) * y⁻¹ = y * x * y⁻¹ * x⁻¹ := by
  have hz : y * x * y⁻¹ * x⁻¹ ∈ c.D 1 := by
    have hi := (mem_normalizer_iff.mp (c.normalizes 0 hx) y⁻¹).mp ((c.D 1).inv_mem hy)
    simpa only [mul_assoc] using (c.D 1).mul_mem hy hi
  let := c.abelian 1
  have hc : y * (y * x * y⁻¹ * x⁻¹) = (y * x * y⁻¹ * x⁻¹) * y :=
    congrArg Subtype.val (mul_comm' (⟨y,hy⟩ : c.D 1) ⟨_,hz⟩)
  rw [hc, mul_inv_cancel_right]


/-- The order of the joint complement is coprime to two. -/
theorem CompatibleCartans.joint_odd (c : CompatibleCartans L S) :
    Nat.Coprime 2 (Nat.card (c.D 0 ⊔ c.D 1 : Subgroup G)) := by
  apply Nat.prime_two.coprime_iff_not_dvd.mpr
  intro hd
  apply c.joint_hall.p_in_pi_of_p_dvd_card ⟨2,Nat.prime_two⟩ _ rfl
  rwa [Nat.card_congr (subgroupOfEquivOfLe c.joint_le).toEquiv]

/-- The two factors of each local complement decomposition have coprime orders. -/
theorem CompatibleCartans.local_coprime (c : CompatibleCartans L S) (i : Fin 2) :
    Nat.Coprime (Nat.card (S ⊓ L i : Subgroup G)) (Nat.card (c.D i)) := by
  have hc := (c.hall i).card_coprime_index.symm
  rwa [Nat.card_congr (subgroupOfEquivOfLe (c.le_borel i)).toEquiv,
    show ((c.D i).subgroupOf (borel (L i) S)).index = _ from c.local_index i] at hc

/-- The factors S and D₁D₂ have coprime orders. -/
theorem CompatibleCartans.joint_coprime (c : CompatibleCartans L S) :
    Nat.Coprime (Nat.card S) (Nat.card (c.D 0 ⊔ c.D 1 : Subgroup G)) := by
  have hc := c.joint_hall.card_coprime_index.symm
  rwa [Nat.card_congr (subgroupOfEquivOfLe c.joint_le).toEquiv,
    show ((c.D 0 ⊔ c.D 1).subgroupOf (commonBorel L S)).index = _ from c.joint_index] at hc
end CFSG.Quasithin.ChapterF.Source
