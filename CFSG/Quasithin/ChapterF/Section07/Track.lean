module

public import CFSG.Quasithin.ChapterF.Section07.Geometry
public import CFSG.Quasithin.ChapterF.Section07.LocalCores

/-!
# The first-orbit track and critical distance

Source: Aschbacher--Smith, *The Classification of Quasithin Groups*, combined
manuscript (1 March 2004), F.7.5, F.7.8, F.7.9(1--3), F.7.11(1), printed
pp.312--313 (PDF pp.323--324).

Normality of ball kernels and the local-core chain propagate prime cores along
paths. The finite filtration theorem then constructs the last radius fixed by
V at the first base vertex only. A moved vertex at radius b+1 has a predecessor
at radius b, giving a critical vertex and the minimality of its distance.

`SourceSetup` contains precisely the F.7.1/F.7.6 inputs with the ambient group
already generated by its two vertex groups. It derives faithfulness using the
proved local-core theorem. Nontriviality of V remains explicit: the trivial
subgroup fixes every ball, so F.7.6 alone cannot define a greatest radius.
-/

@[expose] public section

open Subgroup
open Subgroup.CosetGeometry (stabilizer_base exists_smul_base incident_base)
open Subgroup.CosetGeometry.RankTwo
open Theory.GroupTheory Theory.GroupTheory.AmalgamLocalCores

namespace CFSG.Quasithin.ChapterF.Section07.Track
variable {G : Type*} [Group G] (F : Bool → Subgroup G)

theorem ballKernel_le_of_dist_add_le (hgen : F false ⊔ F true = ⊤)
    {a v : Vertex F} {n m : ℕ} (h : (graph F).dist a v + m ≤ n) :
    ballKernel F a n ≤ ballKernel F v m := by
  intro g hg w hw
  apply hg w
  rw [mem_ball_iff F hgen] at hw ⊢
  exact ((connected F hgen).dist_triangle (u := a) (v := v) (w := w)).trans
    ((Nat.add_le_add_left hw _).trans h)

theorem ballKernel_core_le_vertex_core (p : ℕ) (a : Vertex F) (n : ℕ) :
    (ballKernel F a n).pCoreIn p ≤ (stabilizer F a).pCoreIn p := by
  apply le_pCoreIn_of_normalizes (isPGroup_pCoreIn p _)
    ((pCoreIn_le p _).trans (ballKernel_le_stabilizer F a n))
  exact (stabilizer_le_normalizer_ballKernel F a n).trans
    (normalizer_le_normalizer_characteristic_image _ (pCore p (ballKernel F a n)))

theorem ballKernel_core_le_local_core (hgen : F false ⊔ F true = ⊤)
    (p : ℕ) (a v : Vertex F) {n : ℕ} (hd : (graph F).dist a v < n) :
    (ballKernel F a n).pCoreIn p ≤ (ballKernel F v 1).pCoreIn p := by
  generalize he : (graph F).dist a v = d at hd
  induction d using Nat.strong_induction_on generalizing v with
  | h d ih =>
    have hlocal : (ballKernel F a n).pCoreIn p ≤ ballKernel F v 1 :=
      (pCoreIn_le p _).trans (ballKernel_le_of_dist_add_le F hgen (by omega))
    by_cases hz : d = 0
    · have hav : a = v := ((connected F hgen).dist_eq_zero_iff).mp
        (he.trans hz)
      subst v
      exact (le_inf hlocal (ballKernel_core_le_vertex_core F p a n)).trans
        (inf_pCoreIn_le_of_le p (ballKernel_le_stabilizer F a 1))
    · have hav : a ≠ v := by intro hh; subst v; simp at he; omega
      obtain ⟨w, hvw, hw⟩ := exists_predecessor F hgen a v hav
      have hi := ih ((graph F).dist a w) (by omega) w rfl (by omega)
      have hc := core_containment_chain p (stabilizer F w) (stabilizer F v)
        (stabilizer F w ⊓ stabilizer F v) inf_le_left
      have hk : localKernel (stabilizer F v) (stabilizer F w ⊓ stabilizer F v) =
          ballKernel F v 1 := by
        rw [inf_comm]
        exact (ballKernel_one_eq_map_normalCore F hvw).symm
      rw [hk] at hc
      exact (le_inf (hi.trans (ballKernel_core_le_vertex_core F p w 1)) hlocal).trans
        (hc.1.trans hc.2)

theorem ballKernel_core_le_edge_core (hgen : F false ⊔ F true = ⊤)
    (p : ℕ) (a v w : Vertex F) {n : ℕ} (hd : (graph F).dist a v < n)
    (hvw : (graph F).Adj v w) :
    (ballKernel F a n).pCoreIn p ≤ (stabilizer F v ⊓ stabilizer F w).pCoreIn p := by
  have h := ballKernel_core_le_local_core F hgen p a v hd
  apply h.trans
  apply le_pCoreIn_of_normalizes (isPGroup_pCoreIn p _)
    ((pCoreIn_le p _).trans (ballKernel_one_le_edge F hvw))
  exact (inf_le_left.trans (stabilizer_le_normalizer_ballKernel F v 1)).trans
    (normalizer_le_normalizer_characteristic_image _ (pCore p (ballKernel F v 1)))

theorem exists_track (a : Vertex F) (V : Subgroup G) (hne : V ≠ ⊥)
    (hfirst : V ≤ ballKernel F a 1) (hvanish : ∃ n, ballKernel F a n = ⊥) :
    ∃ b : ℕ, 0 < b ∧ V ≤ ballKernel F a b ∧ ¬ V ≤ ballKernel F a (b + 1) ∧
      ∀ n, V ≤ ballKernel F a n ↔ n ≤ b :=
  exists_last_filtration_radius _ (ballKernel_antitone F a) V hne hfirst hvanish

noncomputable def radius (a : Vertex F) (V : Subgroup G) (hne : V ≠ ⊥)
    (hfirst : V ≤ ballKernel F a 1) (hvanish : ∃ n, ballKernel F a n = ⊥) : ℕ :=
  Classical.choose (exists_track F a V hne hfirst hvanish)

theorem radius_spec (a : Vertex F) (V : Subgroup G) (hne : V ≠ ⊥)
    (hfirst : V ≤ ballKernel F a 1) (hvanish : ∃ n, ballKernel F a n = ⊥) :
    let b := radius F a V hne hfirst hvanish
    0 < b ∧ V ≤ ballKernel F a b ∧ ¬ V ≤ ballKernel F a (b + 1) ∧
      ∀ n, V ≤ ballKernel F a n ↔ n ≤ b :=
  Classical.choose_spec (exists_track F a V hne hfirst hvanish)

theorem le_local_core_below_track (hgen : F false ⊔ F true = ⊤)
    {a v : Vertex F} {V : Subgroup G} {b : ℕ}
    (hcore : V ≤ (stabilizer F a).pCoreIn 2) (hfix : V ≤ ballKernel F a b)
    (hd : (graph F).dist a v < b) : V ≤ (ballKernel F v 1).pCoreIn 2 := by
  have h := (le_inf hfix hcore).trans
    (inf_pCoreIn_le_of_le 2 (ballKernel_le_stabilizer F a b))
  exact h.trans (ballKernel_core_le_local_core F hgen 2 a v hd)

theorem le_edge_core_below_track (hgen : F false ⊔ F true = ⊤)
    {a v w : Vertex F} {V : Subgroup G} {b : ℕ}
    (hcore : V ≤ (stabilizer F a).pCoreIn 2) (hfix : V ≤ ballKernel F a b)
    (hd : (graph F).dist a v < b) (hvw : (graph F).Adj v w) :
    V ≤ (stabilizer F v ⊓ stabilizer F w).pCoreIn 2 := by
  have h := (le_inf hfix hcore).trans
    (inf_pCoreIn_le_of_le 2 (ballKernel_le_stabilizer F a b))
  exact h.trans (ballKernel_core_le_edge_core F hgen 2 a v w hd hvw)

theorem exists_critical_vertex (hgen : F false ⊔ F true = ⊤)
    {a : Vertex F} {V : Subgroup G} {b : ℕ}
    (hfix : V ≤ ballKernel F a b) (hmax : ¬ V ≤ ballKernel F a (b + 1)) :
    ∃ v : Vertex F, (graph F).dist a v = b ∧ ¬ V ≤ ballKernel F v 1 := by
  classical
  have hw : ∃ g ∈ V, ∃ w ∈ ball F a (b + 1), g • w ≠ w := by
    simpa only [SetLike.le_def, mem_ballKernel, not_forall, Classical.not_imp, exists_prop] using hmax
  obtain ⟨g, hg, w, hw, hmove⟩ := hw
  have hdist : (graph F).dist a w = b + 1 := by
    have hle := (mem_ball_iff F hgen a w (b + 1)).mp hw
    have hn : ¬ (graph F).dist a w ≤ b := fun h =>
      hmove (hfix hg w ((mem_ball_iff F hgen a w b).mpr h))
    omega
  have hne : a ≠ w := by intro h; subst w; simp at hdist
  obtain ⟨v, hwv, hv⟩ := exists_predecessor F hgen a w hne
  refine ⟨v, by omega, fun h => ?_⟩
  exact hmove (h hg w ((mem_ball_one F v w).mpr (Or.inl hwv.symm)))

theorem critical_distance_minimal (hgen : F false ⊔ F true = ⊤)
    {a v : Vertex F} {V : Subgroup G} {b : ℕ}
    (hfix : V ≤ ballKernel F a b) (hcritical : ¬ V ≤ ballKernel F v 1) :
    b ≤ (graph F).dist a v := by
  by_contra h
  exact hcritical (hfix.trans (ballKernel_le_of_dist_add_le F hgen (by omega)))

theorem fixes_walk (a v : Vertex F) {V : Subgroup G} {b : ℕ}
    (hfix : V ≤ ballKernel F a b) (p : (graph F).Walk a v) (hp : p.length ≤ b)
    (g : G) (hg : g ∈ V) (i : ℕ) : g • p.getVert i = p.getVert i := by
  apply hfix hg
  change (graph F).edist a (p.getVert i) ≤ (b : ℕ∞)
  exact (p.take i).edist_le.trans (ENat.natCast_le_natCast.mpr (by
    rw [SimpleGraph.Walk.take_length]
    exact (min_le_right _ _).trans hp))

/-- The actual F.7.1/F.7.6 inputs, with G already the generated group.
The separate nontriviality premise on V is needed only for the track. -/
structure SourceSetup (F : Bool → Subgroup G) where
  finite : ∀ i, Finite (F i)
  generates : F false ⊔ F true = ⊤
  characteristicTwo : generalizedFitting (F false) = pCore 2 (F false)
  core_free : pCore 2 (F false ⊔ F true : Subgroup G) = ⊥
  sylow : ∀ i, Sylow 2 (F i)
  same_sylow : ((sylow false : Sylow 2 (F false)) : Subgroup (F false)).map
      (F false).subtype = ((sylow true : Sylow 2 (F true)) : Subgroup (F true)).map
        (F true).subtype
  V : Subgroup (F false)
  reduced : IsPReduced 2 V
  centralizer_eq : (sylow false : Subgroup (F false)) ⊓ centralizer (V : Set (F false)) =
    (centralizer (V : Set (F false))).pCoreIn 2

namespace SourceSetup
variable {F} (D : SourceSetup F)
include D

def seed : Subgroup G := D.V.map (F false).subtype

theorem seed_le_vertex_core : D.seed ≤ (stabilizer F (base F false)).pCoreIn 2 := by
  rw [show stabilizer F (base F false) = F false from stabilizer_base F false]
  exact map_mono D.reduced.le_pCore

theorem seed_normalized : F false ≤ normalizer (D.seed : Set G) := by
  let := D.reduced.normal
  have h := D.V.le_normalizer_map (F false).subtype
  rwa [normalizer_eq_top_iff.mpr D.reduced.normal, ← MonoidHom.range_eq_map,
    range_subtype] at h

theorem seed_le_first_kernel : D.seed ≤ ballKernel F (base F false) 1 := by
  have hT : (D.sylow false : Subgroup (F false)).map (F false).subtype ≤ F true := by
    rw [D.same_sylow]
    exact map_subtype_le _
  have hk := CFSG.Quasithin.ChapterF.LocalCores.kernel_core_eq_vertex_core
    (F false) (F true) (D.sylow false) hT
  have hedge : (graph F).Adj (base F false) (base F true) :=
    ⟨Bool.false_ne_true, incident_base F false true⟩
  have hball := ballKernel_one_eq_map_normalCore F hedge
  rw [show stabilizer F (base F false) = F false from stabilizer_base F false,
    show stabilizer F (base F true) = F true from stabilizer_base F true] at hball
  have hcore : D.seed ≤ (F false).pCoreIn 2 := map_mono D.reduced.le_pCore
  rw [← hk] at hcore
  exact hcore.trans ((pCoreIn_le 2 _).trans hball.ge)

theorem common_core_eq_bot : (F false ⊓ F true).normalCore = ⊥ := by
  let : Finite (F false) := D.finite false
  apply CFSG.Quasithin.ChapterF.LocalCores.lemma_F_7_3_eight_algebra
    (F false) (F true) (F false ⊓ F true).normalCore
    ((F false ⊓ F true).normalCore_le.trans inf_le_left)
    ((F false ⊓ F true).normalCore_le.trans inf_le_right)
    (by infer_instance) (by infer_instance) D.characteristicTwo D.core_free

theorem uniform_vanishing :
    ∃ n : ℕ, 0 < n ∧ ∀ v : Vertex F, ∀ m, n ≤ m → ballKernel F v m = ⊥ := by
  let : ∀ i, Finite (F i) := D.finite
  exact uniform_trivial_ballKernel_of_common_core F D.generates D.common_core_eq_bot

theorem seed_ne_bot (hne : D.V ≠ ⊥) : D.seed ≠ ⊥ := by
  exact fun h => hne ((D.V.map_eq_bot_iff_of_injective (F false).subtype_injective).mp h)

theorem exists_source_track (hne : D.V ≠ ⊥) :
    ∃ b : ℕ, 0 < b ∧ D.seed ≤ ballKernel F (base F false) b ∧
      ¬ D.seed ≤ ballKernel F (base F false) (b + 1) ∧
      ∀ n, D.seed ≤ ballKernel F (base F false) n ↔ n ≤ b := by
  obtain ⟨n, _, hn⟩ := D.uniform_vanishing
  exact exists_track F _ _ (D.seed_ne_bot hne) D.seed_le_first_kernel
    ⟨n, hn _ n le_rfl⟩

/-- The track measured at the first base vertex only. -/
noncomputable def track (hne : D.V ≠ ⊥) : ℕ :=
  Classical.choose (D.exists_source_track hne)

theorem track_spec (hne : D.V ≠ ⊥) :
    0 < D.track hne ∧ D.seed ≤ ballKernel F (base F false) (D.track hne) ∧
      ¬ D.seed ≤ ballKernel F (base F false) (D.track hne + 1) ∧
      ∀ n, D.seed ≤ ballKernel F (base F false) n ↔ n ≤ D.track hne :=
  Classical.choose_spec (D.exists_source_track hne)

/-- F.7.9(1), with the source hypotheses discharging the core-containment input. -/
theorem below_track (hne : D.V ≠ ⊥) {v w : Vertex F}
    (hv : (graph F).dist (base F false) v < D.track hne)
    (hvw : (graph F).Adj v w) :
    D.seed ≤ (ballKernel F v 1).pCoreIn 2 ∧
      D.seed ≤ (stabilizer F v ⊓ stabilizer F w).pCoreIn 2 :=
  ⟨le_local_core_below_track F D.generates D.seed_le_vertex_core (D.track_spec hne).2.1 hv,
    le_edge_core_below_track F D.generates D.seed_le_vertex_core
      (D.track_spec hne).2.1 hv hvw⟩

/-- F.7.9(2--3): a critical vertex exists at exactly the least possible distance. -/
theorem critical_witness (hne : D.V ≠ ⊥) :
    (∃ v : Vertex F, (graph F).dist (base F false) v = D.track hne ∧
      ¬ D.seed ≤ ballKernel F v 1) ∧
    (∀ v : Vertex F, ¬ D.seed ≤ ballKernel F v 1 →
      D.track hne ≤ (graph F).dist (base F false) v) :=
  ⟨exists_critical_vertex F D.generates (D.track_spec hne).2.1 (D.track_spec hne).2.2.1,
    fun _ h => critical_distance_minimal F D.generates (D.track_spec hne).2.1 h⟩

/-- F.7.11(1) for the actual source track; walks need not be geodesic. -/
theorem track_fixes_walk (hne : D.V ≠ ⊥) {v : Vertex F}
    (p : (graph F).Walk (base F false) v) (hp : p.length ≤ D.track hne)
    (g : G) (hg : g ∈ D.seed) (i : ℕ) : g • p.getVert i = p.getVert i :=
  fixes_walk F _ _ (D.track_spec hne).2.1 p hp g hg i

end SourceSetup

end CFSG.Quasithin.ChapterF.Section07.Track
