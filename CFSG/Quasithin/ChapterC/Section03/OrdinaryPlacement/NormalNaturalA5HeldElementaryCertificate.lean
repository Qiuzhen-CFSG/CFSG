theorem certificate_checked : check certificate (List.finRange 192) = true := by
  decide +kernel

theorem clique_coverage (s : Finset (Fin 192)) (hcard : 16 ≤ s.card)
    (hc : ∀ v ∈ s, ∀ w ∈ s, compatible v w = true) :
    ∃ k : Fin 34, ∀ v ∈ s, (candidateMask k).testBit v.val = true :=
  check_sound certificate (List.finRange 192) certificate_checked s
    (fun v _ => List.mem_finRange v) hcard hc

end Held.OrdinaryElementary.NativeCoverage
