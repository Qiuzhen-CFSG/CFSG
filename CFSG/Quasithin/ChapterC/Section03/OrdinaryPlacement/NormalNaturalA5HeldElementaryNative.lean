private theorem graph_checked (v w : Fin 192) :
    compatible v w = true ∨
      normalPerm (vertexIndex v) (normalPerm (vertexIndex w)
        ⟨(noncommuteWitness v w).val,by omega⟩) ≠
      normalPerm (vertexIndex w) (normalPerm (vertexIndex v)
        ⟨(noncommuteWitness v w).val,by omega⟩) := by
  have blocks : ∀ j : Fin 24, ∀ r : Fin 8, GraphRow ⟨8*j.val+r.val,by omega⟩ := by
    intro j
    fin_cases j
    · exact graph_row_0
    · exact graph_row_1
    · exact graph_row_2
    · exact graph_row_3
    · exact graph_row_4
    · exact graph_row_5
    · exact graph_row_6
    · exact graph_row_7
    · exact graph_row_8
    · exact graph_row_9
    · exact graph_row_10
    · exact graph_row_11
    · exact graph_row_12
    · exact graph_row_13
    · exact graph_row_14
    · exact graph_row_15
    · exact graph_row_16
    · exact graph_row_17
    · exact graph_row_18
    · exact graph_row_19
    · exact graph_row_20
    · exact graph_row_21
    · exact graph_row_22
    · exact graph_row_23
  have h := blocks ⟨v.val/8,by omega⟩ ⟨v.val%8,by omega⟩ w
  have he : (⟨8*(v.val/8)+v.val%8,by omega⟩ : Fin 192) = v := by
    apply Fin.ext
    change 8*(v.val/8)+v.val%8=v.val
    omega
  simpa only [he] using h

theorem native_compatible (v w : Fin 192) (h : native v * native w = native w * native v) :
    compatible v w = true := by
  rcases graph_checked v w with hc | hc
  · exact hc
  · exfalso
    apply hc
    have hh := congrArg (fun x : representative => representation x.val
      ⟨(noncommuteWitness v w).val,by omega⟩) h
    simpa only [native,Subgroup.coe_mul,map_mul,Equiv.Perm.mul_apply,
      normalForm_representation] using hh

