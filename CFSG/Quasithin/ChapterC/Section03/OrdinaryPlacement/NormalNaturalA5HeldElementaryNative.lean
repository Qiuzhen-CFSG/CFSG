open Held.LocalPairs.SylowGeometry.Calculations
open Held.TwoLocalCandidates.MaximalNormalizerCatalogue.IntrinsicEnumeration

def productVertex (v w : Fin 192) : Fin 192 :=
  ⟨(( >>> (8*(192*v.val+w.val))) % 256) % 192,Nat.mod_lt _ (by decide)⟩

def native (v : Fin 192) : representative := normalForm (vertexIndex v)

private theorem index_injective : Function.Injective vertexIndex := by
  have h : ∀ v w : Fin 192, vertexIndex v = vertexIndex w → v = w := by decide +kernel
  exact h

theorem native_injective : Function.Injective native := by
  have hinj : Function.Injective normalForm := by
    apply (normalForm_surjective.bijective_of_nat_card_le ?_).1
    simpa only [Nat.card_fin] using
      InnerNormalizer.representative_card_ge_of_orbit_labels
        InnerNormalizer.orbitSizeLabel_eq_card_orbit
  exact hinj.comp index_injective

theorem vertex_of_square (x : representative) (hx : x^2=1) : ∃v,native v=x := by
  obtain ⟨n,rfl⟩ := normalForm_surjective x
  by_cases h : (normalForm n).val = 1
  · refine ⟨0,?_⟩
    apply Subtype.ext
    exact (normalForm_zero).trans h.symm
  · have ho : orderOf (normalForm n).val = 2 := by
      apply (Nat.dvd_prime Nat.prime_two).mp (orderOf_dvd_of_pow_eq_one
        (congrArg Subtype.val hx)) |>.resolve_left
      simpa only [orderOf_eq_one_iff] using h
    obtain ⟨i,hi⟩ := normalForm_involution_index n ho
    refine ⟨⟨i.val+1,by omega⟩,?_⟩
    have hv : vertexIndex ⟨i.val+1,by omega⟩ = forestIndex i := by
      simp only [vertexIndex,Nat.add_eq_zero_iff,one_ne_zero,and_false,↓reduceDIte,
        Nat.add_sub_cancel]
    rw [native,hv,hi]

private def GraphRow (v : Fin 192) : Prop := ∀w:Fin 192,
  compatible v w = true ∨
    normalPerm (vertexIndex v) (normalPerm (vertexIndex w) (⟨(noncommuteWitness v w).val,by omega⟩ : Fin 2058)) ≠
      normalPerm (vertexIndex w) (normalPerm (vertexIndex v) (⟨(noncommuteWitness v w).val,by omega⟩ : Fin 2058))

