module
public import Theory.SpecificGroups.Held.Automorphisms.InvolutionFixedData.Inner.Coverage.FiniteData

/-!
# Proposed finite data for native Held elementary subgroup coverage

The vertices are the identity and the 191 already certified fusion-forest
words. A commutation graph and 34 terminal masks propose the maximal
commuting families. The checks and sound branching proof are separate.
The six last masks have orders32,32,32,32,64,64; the others have order16.
Source: the original ATLAS Held carrier and Aschbacher--Smith 12.7.5, p.840.
-/

@[expose] public section
namespace Held.OrdinaryElementary.NativeCoverage
open Held.InvolutionFixedData.Coverage

def vertexIndex (v : Fin 192) : Fin 1024 :=
  if h : v.val = 0 then 0 else forestIndex ⟨v.val-1,by omega⟩

def compatible (v w : Fin 192) : Bool :=
  ( : ℕ).testBit (192*v.val+w.val)

def noncommuteWitness (v w : Fin 192) : Fin 4 :=
  ⟨( >>> (2*(192*v.val+w.val))) % 4,Nat.mod_lt _ (by decide)⟩

def candidateMask (k : Fin 34) : ℕ :=
  ( >>> (192*k.val)) % (2^192)

def basisVertex (k : Fin 34) (i : Fin 6) : Fin 192 :=
  ⟨(( >>> (8*(6*k.val+i.val))) % 256) % 192,Nat.mod_lt _ (by decide)⟩

end Held.OrdinaryElementary.NativeCoverage
