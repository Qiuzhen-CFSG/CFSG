/-- Byte lookup in one1536-bit row, with the original finite output type. -/
def fastProductVertex (v w : Fin 192) : Fin 192 :=
  ⟨(((fastProductRow v) >>> (8*w.val)) % 256) % 192,Nat.mod_lt _ (by decide)⟩

set_option maxRecDepth 10000 in
private theorem fastProductRow_eq : ∀v:Fin 192,
    fastProductRow v = (packedProduct >>> (1536*v.val)) % 2^1536 := by
  decide +kernel

private theorem byte_row (n r c : ℕ) (hc : c < 192) :
    (((n >>> (1536*r)) % 2^1536) >>> (8*c)) % 256 =
      (n >>> (8*(192*r+c))) % 256 := by
  apply Nat.eq_of_testBit_eq
  intro i
  change Nat.testBit ((((n >>> (1536*r)) % 2^1536) >>> (8*c)) % 2^8) i =
    Nat.testBit ((n >>> (8*(192*r+c))) % 2^8) i
  simp only [Nat.testBit_mod_two_pow,Nat.testBit_shiftRight]
  by_cases hi : i < 8
  · have hci : 8*c+i < 1536 := by omega
    have he : 1536*r+(8*c+i)=8*(192*r+c)+i := by omega
    simp only [hi,hci,decide_true,Bool.true_and,he]
  · simp only [hi,decide_false,Bool.false_and]

/-- Exact equality with every original native product entry. -/
theorem fastProductVertex_eq (v w : Fin 192) :
    fastProductVertex v w = productVertex v w := by
  apply Fin.ext
  change ((((fastProductRow v) >>> (8*w.val)) % 256) % 192) =
    (((packedProduct >>> (8*(192*v.val+w.val))) % 256) % 192)
  rw [fastProductRow_eq,byte_row packedProduct v.val w.val w.isLt]

