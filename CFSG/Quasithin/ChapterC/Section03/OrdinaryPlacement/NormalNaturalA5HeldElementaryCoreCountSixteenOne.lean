private theorem core_checked : fastCountCheck 16 coreTree {0}
    (Finset.univ.filter (fun v : Fin 192=>(candidateMask 33).testBit v.val=true))=true := by
  decide +kernel

/-- The exact 2A count for a closed elementary vertex set in native core 1. -/
theorem core_count16_1 (s : Finset (Fin 192))
    (hs : s.card=16) (h0 : 0∈s)
    (hsub : s⊆Finset.univ.filter (fun v : Fin 192=>(candidateMask 33).testBit v.val=true))
    (hcomm : ∀v∈s,∀w∈s,compatible v w=true)
    (hcoset : ∀v w,w∈s → compatible v w=true → (productVertex v w∈s ↔ v∈s)) :
    allowedCount 16 (markedCount s) := by
  exact fastCountCheck_sound 16 coreTree {0} _ s core_checked
    (Finset.singleton_subset_iff.mpr h0) hsub hs hcomm hcoset

end Held.OrdinaryElementary.NativeCoverage
