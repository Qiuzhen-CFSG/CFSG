module

public import Theory.GroupTheory.PRadical
public import Theory.GroupTheory.CharacteristicNormalizerClosure

/-!
# Pushing-up hypotheses

This module records the nontrivial 2-subgroups S₂(G), radical subgroups B₂(G),
and the hypotheses (PU) and (CPU) of Aschbacher–Smith C.1.1–C.1.6
(combined manuscript, 1 March 2004, pp. 121–122).

Characteristic subgroups of R are represented intrinsically as subgroups of R
and mapped to G when taking normalizers or asserting normality. The Sylow
condition in (CPU) is taken in the normal closure of R inside the proper
overgroup M, not in M itself.
-/

@[expose] public section

namespace CFSG.Quasithin.ChapterC

variable {G : Type*} [Group G]

/-- Membership in the source's S₂(G). -/
def IsNontrivialTwoSubgroup (R : Subgroup G) : Prop := R ≠ ⊥ ∧ IsPGroup 2 R

/-- Membership in the source's B₂(G). -/
abbrev IsTwoRadical (R : Subgroup G) : Prop := Subgroup.IsPRadical 2 R

/-- The source's C(G,R), generated by characteristic-subgroup normalizers. -/
abbrev characteristicNormalizer (R : Subgroup G) : Subgroup G :=
  R.characteristicNormalizerClosure

/-- The hypothesis (PU), C.1.3. -/
def PushingUp (R : Subgroup G) : Prop :=
  IsTwoRadical R ∧ ∀ C : Subgroup R, C.Characteristic → C ≠ ⊥ →
    ¬ (C.map R.subtype).Normal

/-- R is Sylow in its normal closure inside M. The equality of ambient images
also asserts R ≤ M. -/
def IsSylowInNormalClosure (R M : Subgroup G) : Prop :=
  let N := Subgroup.normalClosure (R.subgroupOf M : Set M)
  ∃ S : Sylow 2 N, ((S : Subgroup N).map N.subtype).map M.subtype = R

/-- The hypothesis (CPU), C.1.6. -/
def CharacteristicPushingUp (R : Subgroup G) : Prop :=
  IsTwoRadical R ∧ ∃ M : Subgroup G,
    characteristicNormalizer R ≤ M ∧ M < ⊤ ∧ IsSylowInNormalClosure R M

end CFSG.Quasithin.ChapterC
