module
public import CFSG.Quasithin.ChapterC.Section05.NormalizerControl.SourceTransvection
public import CFSG.Quasithin.ChapterC.Section05.CounterexampleCharacteristic.ReducedSource

/-!
# The literal omega-center span in the A₃ case of C.5.13

The two-core P₁ of K₁T₁ contains Ω₁Z(T₁), because K₁T₁ has
characteristic two. Its normalizer therefore preserves an elementary
span inside Ω₁Z(P₁). A central fixed point and the true irreducibility
of the A₃ module put U₁ in that span. Its Sylow centralizer is exactly
P₁. The action on the original four-group has image of order two,
and the original moving conjugate induces transvections on this
constructed span through the literal centralizer quotient.

Source: Aschbacher–Smith, C.5.13, printed p.162; the elementary
omega-center step is B.2.14 and the generating step uses C.5.3.
-/

public section
open Subgroup Stellmacher
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterC.Section05.NormalizerControl
variable {G : Type*} [Group G]
private theorem omega_normalizer (Q : Subgroup G) :
    normalizer (Q : Set G) ≤ normalizer (omegaOneCenterAmbient Q : Set G) := by
  intro g hg
  rw [mem_normalizer_iff_map_conj_eq] at hg ⊢
  rw [← omegaOneCenterAmbient_map_injective _ (MulAut.conj g).injective,hg]

/-- The normalizer of a normal core preserves the elementary omega-center span. -/
private theorem omega_span_le_core_omega (T P X : Subgroup G)
    (hPT : P ≤ T) (hTC : T ⊓ centralizer (P : Set G) ≤ P)
    (hXP : X ≤ normalizer (P : Set G)) :
    conjugateSpanBy (omegaOneCenterAmbient T) X ≤ omegaOneCenterAmbient P := by
  apply conjugateSpanBy_le _ (hXP.trans (omega_normalizer P))
  intro z hz
  obtain ⟨hzT,hz2,hzc⟩ := (mem_omegaOneCenterAmbient_iff T z).mp hz
  exact (mem_omegaOneCenterAmbient_iff P z).mpr
    ⟨hTC ⟨hzT,fun p hp => hzc p (hPT hp)⟩,hz2,fun p hp => hzc p (hPT hp)⟩

theorem normalizer_core_omega_span (A X T : Subgroup G) (P : Sylow 2 A)
    (hP : (P : Subgroup A).map A.subtype = T)
    (hA : A ∈ Chapter1.He G) (hAX : A ≤ X) :
    let X₁ := X ⊓ normalizer (A.pCoreIn 2 : Set G)
    let V₁ := conjugateSpanBy (omegaOneCenterAmbient T) X₁
    IsElementaryAbelian 2 V₁ ∧ V₁ ≤ A.pCoreIn 2 ∧
      A.pCoreIn 2 ≤ centralizer (V₁ : Set G) ∧ V₁ ≤ X₁ ∧
      X₁ ≤ normalizer (V₁ : Set G) := by
  dsimp only
  let C := A.pCoreIn 2
  let X₁ := X ⊓ normalizer (C : Set G)
  let V := conjugateSpanBy (omegaOneCenterAmbient T) X₁
  have hCT : C ≤ T := hP ▸ pCoreIn_le_sylow A P
  have hTA : T ≤ A := hP ▸ map_subtype_le _
  have hTCC : T ⊓ centralizer (C : Set G) ≤ C :=
    (inf_le_inf_right _ hTA).trans hA
  have hv := omega_span_le_core_omega T C X₁ hCT hTCC inf_le_right
  let : IsElementaryAbelian 2 (omegaOneCenterAmbient C) := omegaOneCenterAmbient_elementaryAbelian C
  have hVC : V ≤ C := hv.trans (fun z hz => ((mem_omegaOneCenterAmbient_iff C z).mp hz).1)
  have hCV : C ≤ centralizer (V : Set G) := by
    intro c hc v hv'
    exact ((mem_omegaOneCenterAmbient_iff C v).mp (hv hv')).2.2 c hc |>.symm
  have hCX₁ : C ≤ X₁ := le_inf ((pCoreIn_le 2 A).trans hAX) C.le_normalizer
  exact ⟨IsElementaryAbelian.of_le hv,hVC,hCV,hVC.trans hCX₁,le_normalizer_conjugateSpanBy _ _⟩
open ConjugateSource.RankOne
variable [Finite G]
/-- The actual A₃ module is generated by its central Sylow involutions. -/
theorem alternating_three_omega_seed_generates
    {T K : Subgroup G} {F : Type*} [Field F]
    (h : Setup T K F) (ha : ChapterC.IsAlternatingBlock K 3)
    (hT : IsPGroup 2 T) (hTK : T ≤ normalizer (K : Set G)) :
    conjugateSpanBy (U K ⊓ omegaOneCenterAmbient T) K = U K := by
  let W := conjugateSpanBy (U K ⊓ omegaOneCenterAmbient T) K
  have hTU : T ≤ normalizer (U K : Set G) :=
    hTK.trans (normalizer_le_normalizer_characteristic_image K (blockU K))
  have hUK : U K ≤ K := map_subtype_le _
  have hKU : K ≤ normalizer (U K : Set G) := K.le_normalizer.trans
    (normalizer_le_normalizer_characteristic_image K (blockU K))
  have hWU : W ≤ U K := conjugateSpanBy_le inf_le_left hKU
  have hWK : W ≤ K := hWU.trans hUK
  have hUneq : U K ≠ ⊥ := by
    intro he
    have hh := h.cubic_module_card ha
    rw [he,card_bot] at hh
    omega
  have hfix := CounterexampleCharacteristic.central_witness T (U K) (U K) hT
    (h.module_le.trans inf_le_left) hTU hUneq h.elementary le_rfl
  have hWneq : W ≠ ⊥ := fun he => hfix (bot_unique (he ▸ le_conjugateSpanBy _ _))
  have hWn : (W.subgroupOf K).Normal :=
    (normal_subgroupOf_iff_le_normalizer hWK).mpr (le_normalizer_conjugateSpanBy _ _)
  have hl : blockU K ⊓ center K = ⊥ := by
    apply bot_unique
    intro k hk
    have hh : (⟨k,hk.1⟩ : blockU K) ∈ blockFixed K := hk.2
    rw [alternatingThreeCoverInput K ha] at hh
    exact congrArg Subtype.val hh
  have hu : W.subgroupOf K ≤ blockU K := by
    intro k hk
    obtain ⟨u,hu,he⟩ := hWU hk
    have he' : u = k := Subtype.ext he
    exact he' ▸ hu
  obtain hw | hw := h.short.irreducible.2 (W.subgroupOf K) hWn (hl ▸ bot_le) hu
  · have hh : W = ⊥ := by
      rw [← map_subgroupOf_eq_of_le hWK,hw,hl,Subgroup.map_bot]
    exact (hWneq hh).elim
  · have hh : W = U K := by
      rw [← map_subgroupOf_eq_of_le hWK,hw]
      rfl
    exact hh
/-- The actual A₃ module lies in the K-span of the Sylow omega-center. -/
theorem alternating_three_omega_span
    {T K : Subgroup G} {F : Type*} [Field F]
    (h : Setup T K F) (ha : ChapterC.IsAlternatingBlock K 3)
    (hT : IsPGroup 2 T) (hTK : T ≤ normalizer (K : Set G)) :
    U K ≤ conjugateSpanBy (omegaOneCenterAmbient T) K := by
  rw [← alternating_three_omega_seed_generates h ha hT hTK]
  exact conjugateSpanBy_mono inf_le_right le_rfl

theorem alternating_three_sylow_action_index
    {T K : Subgroup G} {F : Type*} [Field F]
    (h : Setup T K F) (ha : ChapterC.IsAlternatingBlock K 3)
    (hT : IsPGroup 2 T) (hTK : T ≤ normalizer (K : Set G))
    {x : G} (hx : x ∈ normalizer (T : Set G))
    (hnc : ¬ (U K).map (MulAut.conj x⁻¹).toMonoidHom ≤ centralizer (U K : Set G)) :
    (T ⊓ centralizer (U K : Set G)).relIndex T = 2 := by
  let N := normalizer (U K : Set G)
  let a := (U K).normalizerMonoidHom
  have hTN : T ≤ N := hTK.trans (normalizer_le_normalizer_characteristic_image K (blockU K))
  let J := (T.subgroupOf N).map a
  have hUneq : U K ≠ ⊥ := by
    intro he
    have hh := h.cubic_module_card ha
    rw [he,card_bot] at hh
    omega
  have hfix := CounterexampleCharacteristic.central_witness T (U K) (U K) hT
    (h.module_le.trans inf_le_left) hTN hUneq h.elementary le_rfl
  obtain ⟨⟨z,hz⟩,hzne⟩ := ne_bot_iff_exists_ne_one.mp hfix
  let z₀ : U K := ⟨z,hz.1⟩
  have hz₀ : z₀ ≠ 1 := fun he => hzne (Subtype.ext (show z = 1 from congrArg (fun u : U K => (u : G)) he))
  have hcard : Nat.card J ≤ 2 := card_mulAut_subgroup_le_two_of_fixed_point
    (h.cubic_module_card ha) z₀ hz₀ J (by
      rintro f ⟨n,hn,rfl⟩
      apply Subtype.ext
      change (n : G) * z * (n : G)⁻¹ = z
      rw [((mem_omegaOneCenterAmbient_iff T z).mp hz.2).2.2 n hn,mul_inv_cancel_right])
  have hJne : J ≠ ⊥ := by
    intro he
    apply hnc
    intro b hb
    have hbT : b ∈ T := (h.conjugate_le hx).trans inf_le_left hb
    have hh : a (⟨b,hTN hbT⟩ : N) = 1 := by
      have hm : a (⟨b,hTN hbT⟩ : N) ∈ J := mem_map_of_mem a hbT
      simpa only [he,mem_bot] using hm
    have hk : (⟨b,hTN hbT⟩ : N) ∈ a.ker := hh
    rw [normalizerMonoidHom_ker] at hk
    exact hk
  have hJeq : Nat.card J = 2 := by
    have hp : 0 < Nat.card J := Nat.card_pos
    have hn : Nat.card J ≠ 1 := fun he => hJne (card_eq_one.mp he)
    omega
  have hi := relIndex_map_map_of_injective a.ker (T.subgroupOf N) N.subtype_injective
  rw [relIndex_ker] at hi
  rw [normalizerMonoidHom_ker,map_subgroupOf_eq_of_le (Subgroup.centralizer_le_normalizer _),
    map_subgroupOf_eq_of_le hTN] at hi
  rw [inf_relIndex_left]
  exact hi.trans hJeq

/-- The source normalizer and its literal omega-center span contain U₁ and
have exactly the original core as their Sylow centralizer. -/
theorem alternating_three_source_span
    {T K : Subgroup G} {F : Type*} [Field F]
    (h : Setup T K F) (ha : ChapterC.IsAlternatingBlock K 3)
    (hT : IsPGroup 2 T) (hTK : T ≤ normalizer (K : Set G))
    (P : Sylow 2 (K ⊔ T : Subgroup G))
    (hP : (P : Subgroup (K ⊔ T : Subgroup G)).map (K ⊔ T).subtype = T)
    (hA : K ⊔ T ∈ Chapter1.He G) (X : Subgroup G) (hAX : K ⊔ T ≤ X)
    (hcore : T ⊓ centralizer (U K : Set G) = (K ⊔ T).pCoreIn 2) :
    let X₁ := X ⊓ normalizer ((K ⊔ T).pCoreIn 2 : Set G)
    let V₁ := conjugateSpanBy (omegaOneCenterAmbient T) X₁
    IsElementaryAbelian 2 V₁ ∧ V₁ ≤ X₁ ∧ X₁ ≤ normalizer (V₁ : Set G) ∧
      U K ≤ V₁ ∧ V₁ ≤ T ∧
      T ⊓ centralizer (V₁ : Set G) = (K ⊔ T).pCoreIn 2 := by
  dsimp only
  let A := K ⊔ T
  let C := A.pCoreIn 2
  let X₁ := X ⊓ normalizer (C : Set G)
  let V := conjugateSpanBy (omegaOneCenterAmbient T) X₁
  obtain ⟨he,hVC,hCV,hVX,hXV⟩ := normalizer_core_omega_span A X T P hP hA hAX
  have hAX₁ : A ≤ X₁ := le_inf hAX (A.le_normalizer.trans
    (normalizer_le_normalizer_characteristic_image A (pCore 2 A)))
  have hUV : U K ≤ V := (alternating_three_omega_span h ha hT hTK).trans
    (conjugateSpanBy_mono le_rfl (le_sup_left.trans hAX₁))
  have hCT : C ≤ T := hP ▸ pCoreIn_le_sylow A P
  refine ⟨he,hVX,hXV,hUV,hVC.trans hCT,?_⟩
  exact le_antisymm ((inf_le_inf_left _ (centralizer_le hUV)).trans_eq hcore)
    (le_inf hCT hCV)
/-- The A₃ transvection acts on the literal source omega-center span, with
its elementary structure and containment derived from the reduced core. -/
theorem alternating_three_omega_span_transvections
    {T K : Subgroup G} {F : Type*} [Field F]
    (h : Setup T K F) (ha : ChapterC.IsAlternatingBlock K 3)
    (hT : IsPGroup 2 T) (hTK : T ≤ normalizer (K : Set G))
    (P : Sylow 2 (K ⊔ T : Subgroup G))
    (hP : (P : Subgroup (K ⊔ T : Subgroup G)).map (K ⊔ T).subtype = T)
    (hA : K ⊔ T ∈ Chapter1.He G) (X : Subgroup G) (hAX : K ⊔ T ≤ X)
    (hcore : T ⊓ centralizer (U K : Set G) = (K ⊔ T).pCoreIn 2)
    {x : G} (hx : x ∈ normalizer (T : Set G))
    (hnc : ¬ (U K).map (MulAut.conj x⁻¹).toMonoidHom ≤ centralizer (U K : Set G)) :
    let X₁ := X ⊓ normalizer ((K ⊔ T).pCoreIn 2 : Set G)
    let V₁ := conjugateSpanBy (omegaOneCenterAmbient T) X₁
    let hp := alternating_three_source_span h ha hT hTK P hP hA X hAX hcore
    let : IsElementaryAbelian 2 V₁ := hp.1
    let : (V₁.subgroupOf X₁).Normal :=
      (normal_subgroupOf_iff_le_normalizer hp.2.1).mpr hp.2.2.1
    let : IsElementaryAbelian 2 (V₁.subgroupOf X₁) := IsElementaryAbelian.subgroupOf hp.2.1
    ∀ b (_hb : b ∈ (U K).map (MulAut.conj x⁻¹).toMonoidHom)
      (hbX : b ∈ X₁),
      LinearMap.GeneralLinearGroup.toLinearEquiv
        ((Representation.centralizerQuotient (V₁.subgroupOf X₁)).asGroupHom
          (QuotientGroup.mk' (centralizer (V₁.subgroupOf X₁ : Set X₁)) ⟨b,hbX⟩)) ∈
            LinearEquiv.transvections (ZMod 2) (Additive (V₁.subgroupOf X₁)) := by
  let A := K ⊔ T
  let X₁ := X ⊓ normalizer (A.pCoreIn 2 : Set G)
  let V₁ := conjugateSpanBy (omegaOneCenterAmbient T) X₁
  obtain ⟨he,hVX,hXV,hUV,hVT,hCV⟩ := alternating_three_source_span h ha hT hTK P hP hA X hAX hcore
  let : IsElementaryAbelian 2 V₁ := he
  have hTU : T ≤ normalizer (U K : Set G) := hTK.trans
    (normalizer_le_normalizer_characteristic_image K (blockU K))
  have hTB : T ≤ normalizer ((U K).map (MulAut.conj x⁻¹).toMonoidHom : Set G) := by
    have hs := mem_normalizer_iff_map_conj_eq.mp ((normalizer (T : Set G)).inv_mem hx)
    rw [← map_equiv_normalizer_eq,← hs]
    exact map_mono hTU
  have hAX₁ : A ≤ X₁ := le_inf hAX (A.le_normalizer.trans
    (normalizer_le_normalizer_characteristic_image A (pCore 2 A)))
  have hBX : (U K).map (MulAut.conj x⁻¹).toMonoidHom ≤ X₁ :=
    (h.conjugate_le hx).trans (inf_le_left.trans (le_sup_right.trans hAX₁))
  have ht := alternating_three_relative_transvections h ha hx hnc X₁ V₁ hVX hXV hUV
    (hVT.trans hTB) hBX
  dsimp only
  intro b hb hbX
  exact ht b hb
end CFSG.Quasithin.ChapterC.Section05.NormalizerControl
