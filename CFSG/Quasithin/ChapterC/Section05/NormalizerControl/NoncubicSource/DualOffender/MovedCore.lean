module
public import CFSG.Quasithin.ChapterC.Section05.NormalizerControl.NoncubicSource.Source
public import CFSG.Quasithin.ChapterC.Section05.NormalizerControl.NoncubicSource.DualOffender.Moved
public import Theory.GroupTheory.Commutator.NormalClosure
public import Theory.GroupTheory.PCoreRestriction
/-!
# The moved module is the original two-core commutator layer

The block fixer bound gives [P₁,K]=U=[V₁,K]. Normal-closure transfer
therefore identifies [P₁,L] with I=[V₁,L]. Two-reducedness controls the
ambient two-core, and the same transfer using [U,K]=U gives [I,L]=I.
Consequently I=[O₂(L),L]=U(L), with all source inclusions retained.
Recognizing L as a block still belongs to the later classification step.
Source: Aschbacher–Smith C.5.13, printed p.163.
-/
public section
open Subgroup Stellmacher
namespace CFSG.Quasithin.ChapterC.Section05.NormalizerControl.DualOffender
open ConjugateSource.RankOne
variable {G : Type*} [Group G] [Finite G]
/-- The C.5.13 moved module is generated by the full auxiliary core, and
by the core of its actual conjugate span, with all ambient maps retained. -/
theorem noncubic_source_moved_core (K T X : Subgroup G)
    (hK : IsChiZeroBlock K) (h3 : ¬ IsAlternatingBlock K 3)
    (hT : IsPGroup 2 T) (hUT : U K ≤ T) (hTK : T ≤ normalizer (K : Set G))
    (P : Sylow 2 (K ⊔ T : Subgroup G))
    (hP : (P : Subgroup (K ⊔ T : Subgroup G)).map (K ⊔ T).subtype = T)
    (hA : K ⊔ T ∈ Chapter1.He G) (hAX : K ⊔ T ≤ X)
    (S : Sylow 2 X) (hS : (S : Subgroup X).map X.subtype = T) :
    let N := X ⊓ normalizer ((K ⊔ T).pCoreIn 2 : Set G)
    let V := conjugateSpanBy (omegaOneCenterAmbient T) N
    let L := conjugateSpanBy K N
    U K ≤ ⁅V,L⁆ ∧ ⁅V,L⁆ ≤ L.pCoreIn 2 ∧
      ⁅V,L⁆ = ⁅(K ⊔ T).pCoreIn 2,L⁆ ∧ ⁅V,L⁆ = ⁅L.pCoreIn 2,L⁆ ∧ ⁅V,L⁆ = U L := by
  let A := K ⊔ T
  let N := X ⊓ normalizer (A.pCoreIn 2 : Set G)
  let V := conjugateSpanBy (omegaOneCenterAmbient T) N
  let L := conjugateSpanBy K N
  have hs := noncubic_source_span K T X hK h3 hT hUT hTK P hP hA hAX S hS
  have hAN : A ≤ N := le_inf hAX (A.le_normalizer.trans
    (normalizer_le_normalizer_characteristic_image A (pCore 2 A)))
  have hKN : K ≤ N := le_sup_left.trans hAN
  have hLN : L ≤ N := conjugateSpanBy_le_self hKN
  let : (V.subgroupOf N).Normal := (normal_subgroupOf_iff_le_normalizer hs.2.1).mpr hs.2.2.1
  let : (L.subgroupOf N).Normal := source_span_normal K N hKN
  let I := ⁅V.subgroupOf N,L.subgroupOf N⁆
  have hImap : I.map N.subtype = ⁅V,L⁆ := by
    rw [map_commutator,map_subgroupOf_eq_of_le hs.2.1,map_subgroupOf_eq_of_le hLN]
  have hPN : A.pCoreIn 2 ≤ N := (pCoreIn_le 2 A).trans hAN
  let : ((A.pCoreIn 2).subgroupOf N).Normal :=
    (normal_subgroupOf_iff_le_normalizer hPN).mpr inf_le_right
  have hPC : A.pCoreIn 2 ≤ centralizer (U K : Set G) :=
    (CounterexampleCharacteristic.ReducedMarking.normal_short_extension_centralizer K T hK.chi.short hT hTK).ge.trans inf_le_right
  have hPK : ⁅A.pCoreIn 2,K⁆ ≤ U K := by
    rw [commutator_comm]
    exact block_fixer_displacement hK.chi.short
      ((pCoreIn_le 2 A).trans (sup_le K.le_normalizer hTK)) hPC
  have hUI : U K ≤ ⁅V,L⁆ := hs.2.2.2.2.2.2.2.symm.le.trans
    (commutator_mono le_rfl (le_conjugateSpanBy K N))
  have hPi : ⁅(A.pCoreIn 2).subgroupOf N,K.subgroupOf N⁆ ≤ I := by
    apply map_le_map_iff_of_injective N.subtype_injective |>.mp
    rw [map_commutator,map_subgroupOf_eq_of_le hPN,map_subgroupOf_eq_of_le hKN,hImap]
    exact hPK.trans hUI
  have hPLi := commutator_normalClosure_le_of_normal
    ((A.pCoreIn 2).subgroupOf N) (K.subgroupOf N) I hPi
  rw [normalClosure_subgroupOf_eq_conjugateSpanBy K N hKN] at hPLi
  have hPL : ⁅A.pCoreIn 2,L⁆ ≤ ⁅V,L⁆ := by
    have hh := map_mono (f := N.subtype) hPLi
    rwa [map_commutator,map_subgroupOf_eq_of_le hPN,map_subgroupOf_eq_of_le hLN,hImap] at hh
  have hVP := (normalizer_core_omega_span A X T P hP hA hAX).2.1
  have hIeq : ⁅V,L⁆ = ⁅A.pCoreIn 2,L⁆ := le_antisymm (commutator_mono hVP le_rfl) hPL
  have hVI : V.subgroupOf N ≤ pCore 2 N := hs.2.2.2.2.2.2.1.le_pCore
  have hPNcore : (pCore 2 N).map N.subtype ≤ T := by
    obtain ⟨Q,hQ⟩ := Chapter1.IsSylowIn.restrict (show Chapter1.IsSylowIn 2 T X from ⟨S,hS⟩)
      (le_sup_right.trans hAN) inf_le_left
    exact hQ ▸ pCoreIn_le_sylow N Q
  have hcoreC : (pCore 2 N).map N.subtype ≤ centralizer (V : Set G) := by
    have hh := le_centralizer_iff.mp hs.2.2.2.2.2.2.1.le_centralizer_pCore
    intro a ha v hv
    obtain ⟨b,hb,rfl⟩ := ha
    exact congrArg N.subtype (hh hb ⟨v,hs.2.1 hv⟩ hv)
  have hcoreP : N.pCoreIn 2 ≤ A.pCoreIn 2 :=
    (le_inf hPNcore hcoreC).trans hs.2.2.2.2.2.1.le
  have hLC : L.pCoreIn 2 ≤ N.pCoreIn 2 :=
    pCoreIn_mono_of_normalizes hLN (le_normalizer_conjugateSpanBy K N)
  have hIl : ⁅V,L⁆ ≤ L.pCoreIn 2 := by
    apply le_pCoreIn_of_normalizes
    · exact ((hs.1.isPGroup).to_le (le_normalizer_iff_commutator_le_left.mp
        (hLN.trans hs.2.2.1)))
    · exact le_normalizer_iff_commutator_le_right.mp
        (hs.2.1.trans (le_normalizer_conjugateSpanBy K N))
    · exact normalizer_commutator_ge_right V L
  have hUK : ⁅U K,K⁆ = U K := by
    have hi := commutator_isPPerfect_idempotent K (pCoreIn 2 K)
      hK.chi.short.twoPerfect (isPGroup_pCoreIn 2 K)
      (K.le_normalizer.trans (normalizer_le_normalizer_characteristic_image K (pCore 2 K)))
    simpa only [U,pCoreIn,blockU,map_commutator,← MonoidHom.range_eq_map,range_subtype] using hi
  have hUJ : U K ≤ ⁅⁅V,L⁆,L⁆ := hUK.symm.le.trans
    (commutator_mono hUI (le_conjugateSpanBy K N))
  have hPj : ⁅(A.pCoreIn 2).subgroupOf N,K.subgroupOf N⁆ ≤ ⁅I,L.subgroupOf N⁆ := by
    apply map_le_map_iff_of_injective N.subtype_injective |>.mp
    rw [map_commutator,map_commutator,map_subgroupOf_eq_of_le hPN,
      map_subgroupOf_eq_of_le hKN,map_subgroupOf_eq_of_le hLN,hImap]
    exact hPK.trans hUJ
  have hgen := commutator_normalClosure_le_of_normal
    ((A.pCoreIn 2).subgroupOf N) (K.subgroupOf N) ⁅I,L.subgroupOf N⁆ hPj
  rw [normalClosure_subgroupOf_eq_conjugateSpanBy K N hKN] at hgen
  have hgenerated : ⁅V,L⁆ ≤ ⁅⁅V,L⁆,L⁆ := by
    have hh := map_mono (f := N.subtype) hgen
    rw [map_commutator,map_commutator,map_subgroupOf_eq_of_le hPN,
      map_subgroupOf_eq_of_le hLN,hImap] at hh
    exact hIeq.le.trans hh
  have hcoreeq : ⁅V,L⁆ = ⁅L.pCoreIn 2,L⁆ := le_antisymm
    (hgenerated.trans (commutator_mono hIl le_rfl))
    ((commutator_mono (hLC.trans hcoreP) le_rfl).trans hPL)
  refine ⟨hUI,hIl,hIeq,hcoreeq,?_⟩
  rw [hcoreeq]
  change ⁅(pCore 2 L).map L.subtype,L⁆ = (⁅pCore 2 L,(⊤ : Subgroup L)⁆).map L.subtype
  rw [map_commutator,← MonoidHom.range_eq_map,range_subtype]
end CFSG.Quasithin.ChapterC.Section05.NormalizerControl.DualOffender
