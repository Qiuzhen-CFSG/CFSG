module
public import CFSG.Quasithin.ChapterC.Section05.NormalizerControl.NoncubicSource.LocalFamily
public import CFSG.Quasithin.Chapter1.Section02.LocalComponents.Classification.Embeddings
public import Theory.GroupTheory.ConjugateSpanSylow
/-!
# The genuine A.3.12 application to the noncubic auxiliary group

The normalized source block lies in the actual local family. The universal
earlier A.3.12 and A.3.8 assertions give a unique containing normal
C-component. Its normal subgroup generated by the nonsolvable block cannot
be proper, so that component is exactly the original conjugate span L.
The model-valued embedding is retained on the literal two-core quotient.
Source: Aschbacher–Smith C.5.13, printed p.162, applying 1.2.4/A.3.12.
-/
public section
open Subgroup
namespace CFSG.Quasithin.ChapterC.Section05.NormalizerControl
open Chapter1.Section02
universe u
variable {G : Type u} [Group G] [Finite G]
/-- A nonsolvable subgroup normally generates a containing normal C-component. -/
theorem normal_span_eq_component (B D : Subgroup G) (hD : D.IsCComponent)
    [D.Normal] (hBD : B ≤ D) (hB : ¬ Group.IsSolvable B) :
    conjugateSpanBy B ⊤ = D := by
  let L := conjugateSpanBy B ⊤
  have hLD : L ≤ D := conjugateSpanBy_le hBD le_normalizer_of_normal
  let : L.Normal := normalizer_eq_top_iff.mp
    (top_le_iff.mp (le_normalizer_conjugateSpanBy B ⊤))
  have he : L.subgroupOf D = ⊤ := by
    by_contra hne
    let : Group.IsSolvable (L.subgroupOf D) :=
      hD.isSolvable_of_subnormal_lt_top (inferInstance : (L.subgroupOf D).Normal).isSubnormal hne
    let : Group.IsSolvable L := Group.isSolvable_of_isSolvable_injective
      (f := (subgroupOfEquivOfLe hLD).symm.toMonoidHom) (subgroupOfEquivOfLe hLD).symm.injective
    exact hB (Group.isSolvable_of_isSolvable_injective
      (f := inclusion (show B ≤ L from le_conjugateSpanBy _ _)) (inclusion_injective _))
  exact le_antisymm hLD (subgroupOf_eq_top.mp he)
/-- Actual local-family membership supplies the complete earlier embedding
interface for L=⟨K^{X₁}⟩. The two universal A.3 inputs remain explicit. -/
theorem noncubic_auxiliary_embedding {𝒦 : GroupClass.{u}}
    (hA312 : ∀ (H : Type u) [Group H] [Finite H],
      IsSQTK 𝒦 H → pCore 2 H = ⊥ → ∀ (S : Sylow 2 H) (B : Subgroup H),
      B ∈ ChapterA.Section03.localCComponents S → A312Conclusion B)
    (hA38 : ∀ (H : Type u) [Group H] [Finite H],
      IsSQTK 𝒦 H → pCore 2 H = ⊥ → ∀ B : Subgroup H, B.IsCComponent →
      B.Normal ∨ (normalizer (B : Set H)).index = 2 ∧ NonnormalCComponentModel B)
    (K T X : Subgroup G) (hK : IsChiZeroBlock K) (h3 : ¬ IsAlternatingBlock K 3)
    (hTK : T ≤ normalizer (K : Set G)) (hAX : K ⊔ T ≤ X) (hX : X ∈ Chapter1.He G)
    (P : Sylow 2 X) (hP : (P : Subgroup X).map X.subtype = T)
    (hQ : let N := X ⊓ normalizer ((K ⊔ T).pCoreIn 2 : Set G)
      IsSQTK 𝒦 (N ⧸ pCore 2 N)) :
    let N := X ⊓ normalizer ((K ⊔ T).pCoreIn 2 : Set G)
    let L := conjugateSpanBy K N
    (L.subgroupOf N).IsCComponent ∧
      A312Embedding ((K.subgroupOf N).map (QuotientGroup.mk' (pCore 2 N)))
        ((L.subgroupOf N).map (QuotientGroup.mk' (pCore 2 N))) := by
  let N := X ⊓ normalizer ((K ⊔ T).pCoreIn 2 : Set G)
  obtain ⟨hlocal,_hN,⟨S,hS⟩⟩ := noncubic_auxiliary_local_family K T X hK h3 hTK hAX hX P hP
  have hKN : K ≤ N := hlocal.1
  have hTN : T ≤ N := hS ▸ map_subtype_le _
  have hTs : T.subgroupOf N = (S : Subgroup N) := by
    apply map_injective N.subtype_injective
    rw [map_subgroupOf_eq_of_le hTN,hS]
  have hb : K.subgroupOf N ∈ Chapter1.L N (S : Subgroup N) := by
    rw [← hTs]
    exact (Chapter1.mem_LIn_iff_subgroupOf hTN hKN).mp hlocal
  obtain ⟨D,hD,hKD,_hu,hemb,hn⟩ := lemma_1_2_4_of_A_3_12_A_3_8 hA312 hA38 hQ S hb
  let : D.Normal := hn (by
    rw [← subgroupOf_normalizer_eq hKN]
    intro s hs
    exact hTK (hS ▸ mem_map_of_mem N.subtype hs))
  have hspan := normal_span_eq_component (K.subgroupOf N) D hD hKD (Chapter1.mem_L_not_isSolvable hb)
  have hm : (conjugateSpanBy (K.subgroupOf N) ⊤).map N.subtype = conjugateSpanBy K N := by
    rw [map_conjugateSpanBy,map_subgroupOf_eq_of_le hKN,← MonoidHom.range_eq_map,range_subtype]
  have he : (conjugateSpanBy K N).subgroupOf N = D := by
    apply map_injective N.subtype_injective
    rw [map_subgroupOf_eq_of_le (conjugateSpanBy_le_self hKN),← hm,hspan]
  change ((conjugateSpanBy K N).subgroupOf N).IsCComponent ∧ _
  rw [he]
  exact ⟨hD,hemb⟩
end CFSG.Quasithin.ChapterC.Section05.NormalizerControl
