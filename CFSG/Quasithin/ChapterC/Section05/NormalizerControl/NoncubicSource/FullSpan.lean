module
public import CFSG.Quasithin.ChapterC.Section05.NormalizerControl.NoncubicSource.Source
public import CFSG.Quasithin.ChapterC.Section05.NormalizerControl.ReducedSpan
/-!
# Reducedness of the full noncubic source module

The genuine full-Sylow fixed seed generates U under K, including its
central layer. Hence the full X-span of U is generated by Sylow-fixed
vectors. The actual centralizer bound makes this span elementary, and
its faithful conjugation quotient has trivial two-core. The second
endpoint uses precisely the residual span of C.5.10–12.
Source: Aschbacher–Smith C.5.12, printed p.163, applying B.2.14.
-/
public section
open Subgroup Stellmacher
namespace CFSG.Quasithin.ChapterC.Section05.NormalizerControl
open ConjugateSource.RankOne
variable {G : Type*} [Group G] [Finite G]
/-- The noncubic full source span is two-reduced, with its fixed seed constructed. -/
theorem noncubic_full_span_reduced
    (K T : Subgroup G) (hK : IsChiZeroBlock K) (h3 : ¬ IsAlternatingBlock K 3)
    (hUT : U K ≤ T)
    (hT : IsPGroup 2 T) (hTK : T ≤ normalizer (K : Set G))
    (X : Subgroup G) (hKX : K ≤ X)
    (S : Sylow 2 X) (hS : (S : Subgroup X).map X.subtype = T)
    (hVC : conjugateSpanBy (U K) X ≤ centralizer (U K : Set G)) :
    Theory.GroupTheory.IsPReduced 2 ((conjugateSpanBy (U K) X).subgroupOf X) := by
  let V := conjugateSpanBy (U K) X
  let Z := U K ⊓ omegaOneCenterAmbient T
  have hUX : U K ≤ X := (map_subtype_le _).trans hKX
  have hVX : V ≤ X := conjugateSpanBy_le_self hUX
  have hXV : X ≤ normalizer (V : Set G) := le_normalizer_conjugateSpanBy _ _
  have hZV : Z ≤ V := inf_le_left.trans (le_conjugateSpanBy _ _)
  have hZT : Z ≤ centralizer (T : Set G) := by
    intro z hz t ht
    exact ((mem_omegaOneCenterAmbient_iff T z).mp hz.2).2.2 t ht
  have hspan : V ≤ conjugateSpanBy Z X := by
    apply conjugateSpanBy_le _ (le_normalizer_conjugateSpanBy _ _)
    rw [← block_span_of_noncentral_seed K Z hK.chi.short inf_le_left
      (noncubic_noncentral_fixed K T hK h3 hT hUT hTK)]
    exact conjugateSpanBy_mono le_rfl hKX
  let : IsElementaryAbelian 2 (U K) := hK.chi.short.elementary.map K.subtype
  let : IsMulCommutative V := (conjugateSpanBy_commutative_iff (U K) X).mpr
    (le_centralizer_iff.mp hVC)
  let : IsElementaryAbelian 2 V := conjugateSpanBy_elementary_of_commutative (U K) X
  exact ⟨(normal_subgroupOf_iff_le_normalizer hVX).mpr hXV,
    IsElementaryAbelian.subgroupOf hVX,relative_reduced_of_fixed_span X V Z T hVX hXV hZV hZT hspan S hS⟩
/-- The C.5.10 residual span equals the full X-span; its original
centralizer bound therefore proves reducedness without an extra R₂ premise. -/
theorem noncubic_residual_span_reduced
    (K T : Subgroup G) (hK : IsChiZeroBlock K) (h3 : ¬ IsAlternatingBlock K 3)
    (hUT : U K ≤ T)
    (hT : IsPGroup 2 T) (hTK : T ≤ normalizer (K : Set G))
    (N X : Subgroup G) (hKX : K ≤ X) (hNX : N ≤ X)
    (S : Sylow 2 X) (hS : (S : Subgroup X).map X.subtype = T)
    (hXV : X ≤ normalizer (conjugateSpanBy (U K) N : Set G))
    (hVC : conjugateSpanBy (U K) N ≤ centralizer (U K : Set G)) :
    Theory.GroupTheory.IsPReduced 2 ((conjugateSpanBy (U K) N).subgroupOf X) := by
  have he : conjugateSpanBy (U K) N = conjugateSpanBy (U K) X := by
    exact le_antisymm (conjugateSpanBy_mono le_rfl hNX)
      (conjugateSpanBy_le (le_conjugateSpanBy _ _) hXV)
  rw [he]
  exact noncubic_full_span_reduced K T hK h3 hUT hT hTK X hKX S hS (he ▸ hVC)
end CFSG.Quasithin.ChapterC.Section05.NormalizerControl
