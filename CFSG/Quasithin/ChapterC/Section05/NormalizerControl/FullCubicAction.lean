module
public import CFSG.Quasithin.ChapterC.Section05.NormalizerControl.G6Applicability
public import CFSG.Quasithin.ChapterC.Section01.BlockStructure.Commutation.CubicSetup

/-!
# The actual cubic and inverter in the full source action

The A₃ core is U(K), so it is killed by the action on the elementary
span V containing U(K). The image of K therefore has order three.
The full Sylow subgroup normalizes that image. A source element moving
U(K) cannot centralize the image, because U(K) is generated by its
Sylow-fixed seed; hence the element acts by inversion.

This applies to the full C.5.12 span even when O₂(KT) acts nontrivially.
Source: Aschbacher–Smith C.5.12–13, printed pp.162–163.
-/
public section
open Subgroup Stellmacher
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterC.Section05.NormalizerControl
open ConjugateSource.RankOne
variable {G : Type*} [Group G] [Finite G]
/-- The full source action kills the core of the A₃ block because it is U,
without assuming that the larger core of KT centralizes V. -/
theorem alternating_three_full_quotient_image_card
    (K X V : Subgroup G) [IsElementaryAbelian 2 V]
    (ha : ChapterC.IsAlternatingBlock K 3)
    (hKX : K ≤ X) (hVX : V ≤ X) (hXV : X ≤ normalizer (V : Set G))
    (hUV : U K ≤ V) :
    let : (V.subgroupOf X).Normal := (normal_subgroupOf_iff_le_normalizer hVX).mpr hXV
    Nat.card ((K.subgroupOf X).map
      (QuotientGroup.mk' (centralizer (V.subgroupOf X : Set X)))) = 3 := by
  have hc : Nat.card (K ⧸ pCore 2 K) = 3 := by
    obtain ⟨e⟩ := ha.2.2.quotient_iso
    rw [Nat.card_congr e.toEquiv,nat_card_alternatingGroup]
    norm_num
  have hKU : K.pCoreIn 2 = U K := congrArg (map K.subtype)
    (ha.2.1.core_eq_blockU_of_quotient_three hc)
  have hCV : (K ⊔ (⊥ : Subgroup G)).pCoreIn 2 ≤ centralizer (V : Set G) := by
    rw [sup_bot_eq,hKU]
    exact hUV.trans (le_centralizer_iff_isMulCommutative.mpr inferInstance)
  exact alternating_three_quotient_image_card K ⊥ X V ha bot_le (by simpa using hKX)
    hVX hXV hUV hCV

/-- In the full C.5.12 action, every moving source element gives an
inverted cubic normalized by the actual full Sylow image. -/
theorem alternating_three_full_inverter
    {T K : Subgroup G} {F : Type*} [Field F]
    (h : Setup T K F) (ha : ChapterC.IsAlternatingBlock K 3)
    (hT : IsPGroup 2 T) (hTK : T ≤ normalizer (K : Set G))
    (X V : Subgroup G) [IsElementaryAbelian 2 V]
    (hKX : K ≤ X) (hVX : V ≤ X) (hXV : X ≤ normalizer (V : Set G))
    (hUV : U K ≤ V) (S : Sylow 2 X) (hS : (S : Subgroup X).map X.subtype = T)
    (b : X) (hbT : (b : G) ∈ T) (hbC : (b : G) ∉ centralizer (U K : Set G)) :
    let : (V.subgroupOf X).Normal := (normal_subgroupOf_iff_le_normalizer hVX).mpr hXV
    let q := QuotientGroup.mk' (centralizer (V.subgroupOf X : Set X))
    ∃ c : X ⧸ centralizer (V.subgroupOf X : Set X), c^3=1 ∧ c≠1 ∧
      ((S.mapSurjective (f := q) (QuotientGroup.mk'_surjective _)) :
        Subgroup (X ⧸ centralizer (V.subgroupOf X : Set X))) ≤
        normalizer (zpowers c : Set (X ⧸ centralizer (V.subgroupOf X : Set X))) ∧ q b*c=c^2*q b := by
  let : (V.subgroupOf X).Normal := (normal_subgroupOf_iff_le_normalizer hVX).mpr hXV
  let q := QuotientGroup.mk' (centralizer (V.subgroupOf X : Set X))
  let Kstar := (K.subgroupOf X).map q
  have hcK : Nat.card Kstar = 3 := alternating_three_full_quotient_image_card K X V ha hKX hVX hXV hUV
  have hSN : (S : Subgroup X).map q ≤ normalizer (Kstar : Set _) := by
    rintro _ ⟨s,hs,rfl⟩
    apply (K.subgroupOf X).le_normalizer_map q
    apply mem_map_of_mem
    rw [← subgroupOf_normalizer_eq hKX]
    exact hTK (hS ▸ mem_map_of_mem X.subtype hs)
  have hbn : q b ∈ normalizer (Kstar : Set _) := by
    apply (K.subgroupOf X).le_normalizer_map q
    apply mem_map_of_mem
    rw [← subgroupOf_normalizer_eq hKX]
    exact hTK hbT
  have hbnc : q b ∉ centralizer (Kstar : Set _) := by
    intro hc
    have hh := relative_centralizes_span X V (U K ⊓ omegaOneCenterAmbient T) K hVX hXV
      (inf_le_left.trans hUV) hKX b (by
        intro z hz
        exact ((mem_omegaOneCenterAmbient_iff T z).mp hz.2).2.2 b hbT |>.symm) hc
    rw [alternating_three_omega_seed_generates h ha hT hTK] at hh
    exact hbC hh
  have hKne : Kstar ≠ ⊥ := by
    intro he
    norm_num only [he,card_bot] at hcK
  obtain ⟨c,hcne⟩ := (ne_bot_iff_exists_ne_one).mp hKne
  have hgen := zpowers_eq_top_of_prime_card hcK hcne
  have ho : orderOf c = 3 := (orderOf_eq_card_of_zpowers_eq_top hgen).trans hcK
  have hc3 : (c : X ⧸ centralizer (V.subgroupOf X : Set X)) ^ 3 = 1 := by
    have hh := congrArg Kstar.subtype (pow_orderOf_eq_one c)
    simp only [map_pow,map_one,ho] at hh
    convert! hh using 1
  have hgen' : zpowers (c : X ⧸ centralizer (V.subgroupOf X : Set X)) = Kstar := by
    have hh := congrArg (map Kstar.subtype) hgen
    simp only [MonoidHom.map_zpowers,← MonoidHom.range_eq_map,range_subtype] at hh
    convert! hh using 1
  have hci : (c : X ⧸ centralizer (V.subgroupOf X : Set X)) ^ 2 = c⁻¹ := by
    apply eq_inv_iff_mul_eq_one.mpr
    simpa only [← pow_succ] using hc3
  refine ⟨c,hc3,(fun he => hcne (Subtype.ext he)),?_,?_⟩
  · change (S : Subgroup X).map q ≤ _
    rwa [hgen']
  · rw [hci]
    exact mul_inv_eq_iff_eq_mul.mp (cubic_normalizer_inverts Kstar hcK (q b) hbn hbnc c c.property)
end CFSG.Quasithin.ChapterC.Section05.NormalizerControl
