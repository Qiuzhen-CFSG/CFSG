module
public import Theory.GroupTheory.SylowFixedSpanReduced
public import CFSG.Quasithin.ChapterC.Section05.NormalizerControl.CentralizingSource
public import Theory.GroupTheory.ConjugateSpanCentralizer
public import Theory.GroupTheory.ReducedNormal.Defs

/-!
# Reducedness of the actual A₃ source span

The A₃ module is generated by its Sylow-fixed elements. Its full
X-span is elementary by the C.5.10 centralizer bound, and the
p-core of its faithful action quotient fixes the generating seed.
Thus the literal centralizer quotient is two-reduced. The actual
residual span equals this full span because X normalizes it.

Source: Aschbacher–Smith C.5.12, printed p.163, applying B.2.14.
-/

public section
open Subgroup Stellmacher
namespace CFSG.Quasithin.ChapterC.Section05.NormalizerControl
variable {G : Type*} [Group G] [Finite G]
/-- A literal relative action on a full Sylow-fixed conjugate span is reduced. -/
theorem relative_reduced_of_fixed_span
    (X V Z T : Subgroup G) (hVX : V ≤ X) (hXV : X ≤ normalizer (V : Set G))
    (hZV : Z ≤ V) (hZT : Z ≤ centralizer (T : Set G))
    (hspan : V ≤ conjugateSpanBy Z X)
    (S : Sylow 2 X) (hS : (S : Subgroup X).map X.subtype = T) :
    let : (V.subgroupOf X).Normal := (normal_subgroupOf_iff_le_normalizer hVX).mpr hXV
    pCore 2 (X ⧸ centralizer (V.subgroupOf X : Set X)) = ⊥ := by
  let : (V.subgroupOf X).Normal := (normal_subgroupOf_iff_le_normalizer hVX).mpr hXV
  apply centralizer_quotient_pCore_eq_bot_of_sylow_fixed_span (V.subgroupOf X) (Z.subgroupOf X) S
  · exact subgroupOf_mono _ hZV
  · intro z hz s hs
    exact Subtype.ext (hZT hz s (hS ▸ mem_map_of_mem X.subtype hs))
  · have he : (conjugateSpanBy (Z.subgroupOf X) ⊤).map X.subtype = conjugateSpanBy Z X := by
      rw [map_conjugateSpanBy,map_subgroupOf_eq_of_le (hZV.trans hVX),← MonoidHom.range_eq_map,range_subtype]
    intro v hv
    have hh : (v : G) ∈ (conjugateSpanBy (Z.subgroupOf X) ⊤).map X.subtype := he.symm ▸ hspan hv
    obtain ⟨u,hu,heq⟩ := hh
    have heq' : u=v := Subtype.ext heq
    exact heq' ▸ hu

open ConjugateSource.RankOne
/-- The actual full X-span in the A₃ source configuration is 2-reduced.
The centralizer bound is the C.5.10 span bound. -/
theorem alternating_three_full_span_reduced
    {T K : Subgroup G} {F : Type*} [Field F]
    (h : Setup T K F) (ha : ChapterC.IsAlternatingBlock K 3)
    (hT : IsPGroup 2 T) (hTK : T ≤ normalizer (K : Set G))
    (X : Subgroup G) (hKX : K ≤ X)
    (S : Sylow 2 X) (hS : (S : Subgroup X).map X.subtype = T)
    (hVC : conjugateSpanBy (U K) X ≤ centralizer (U K : Set G)) :
    Theory.GroupTheory.IsPReduced 2 ((conjugateSpanBy (U K) X).subgroupOf X) := by
  let V := conjugateSpanBy (U K) X
  let Z := U K ⊓ omegaOneCenterAmbient T
  have hUX : U K ≤ X := (map_subtype_le _).trans hKX
  have hVX : V ≤ X := conjugateSpanBy_le_self hUX
  have hXV : X ≤ normalizer (V : Set G) := le_normalizer_conjugateSpanBy _ _
  have hZV : Z ≤ V := inf_le_left.trans (le_conjugateSpanBy _ _)
  have hZT : Z ≤ centralizer (T : Set G) := by
    intro z hz t ht
    exact ((mem_omegaOneCenterAmbient_iff T z).mp hz.2).2.2 t ht
  have hspan : V ≤ conjugateSpanBy Z X := by
    apply conjugateSpanBy_le _ (le_normalizer_conjugateSpanBy _ _)
    rw [← alternating_three_omega_seed_generates h ha hT hTK]
    exact conjugateSpanBy_mono le_rfl hKX
  let : IsElementaryAbelian 2 (U K) := h.elementary
  let : IsMulCommutative V := (conjugateSpanBy_commutative_iff (U K) X).mpr
    (le_centralizer_iff.mp hVC)
  let : IsElementaryAbelian 2 V := conjugateSpanBy_elementary_of_commutative (U K) X
  exact ⟨(normal_subgroupOf_iff_le_normalizer hVX).mpr hXV,
    IsElementaryAbelian.subgroupOf hVX,relative_reduced_of_fixed_span X V Z T hVX hXV hZV hZT hspan S hS⟩
/-- The C.5.10 residual span equals the full X-span; its original
centralizer bound therefore proves reducedness without an extra R₂ premise. -/
theorem alternating_three_residual_span_reduced
    {T K : Subgroup G} {F : Type*} [Field F]
    (h : Setup T K F) (ha : ChapterC.IsAlternatingBlock K 3)
    (hT : IsPGroup 2 T) (hTK : T ≤ normalizer (K : Set G))
    (N X : Subgroup G) (hKX : K ≤ X) (hNX : N ≤ X)
    (S : Sylow 2 X) (hS : (S : Subgroup X).map X.subtype = T)
    (hXV : X ≤ normalizer (conjugateSpanBy (U K) N : Set G))
    (hVC : conjugateSpanBy (U K) N ≤ centralizer (U K : Set G)) :
    Theory.GroupTheory.IsPReduced 2 ((conjugateSpanBy (U K) N).subgroupOf X) := by
  have he : conjugateSpanBy (U K) N = conjugateSpanBy (U K) X := by
    exact le_antisymm (conjugateSpanBy_mono le_rfl hNX)
      (conjugateSpanBy_le (le_conjugateSpanBy _ _) hXV)
  rw [he]
  exact alternating_three_full_span_reduced h ha hT hTK X hKX S hS (he ▸ hVC)
end CFSG.Quasithin.ChapterC.Section05.NormalizerControl
