module
public import CFSG.Quasithin.ChapterC.Section05.BlockAnalysis.SourceEscape
public import Theory.GroupTheory.PResidual.SubnormalCoreAction

/-!
# The original C.5 block orbit on its module layers

Distinct commuting short blocks have distinct U-layers, since each nonzero
layer is generated by its commutators with its own block. Thus the literal
module stabilizer in the original Sylow group fixes the corresponding block.
The transitive block orbit supplies both the single-block and paired-module
actions required in C.5.6(6), without an additional permutation assumption.

Source: Aschbacher–Smith C.5.3 and C.5.6(6), printed pp.155–158.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterC.Section05.BlockAnalysis
variable {G : Type*} [Group G] [Finite G]

private theorem module_commutator (L : Subgroup G) (hL : IsShort L) :
    ⁅moduleLayer L,L⁆ = moduleLayer L := by
  have he : ⁅blockU L,(⊤ : Subgroup L)⁆ = blockU L :=
    commutator_isPPerfect_idempotent ⊤ (pCore 2 L)
      (hL.twoPerfect.of_surjective (topEquiv (G := L)).symm.toMonoidHom
        (topEquiv (G := L)).symm.surjective) pCore_isPGroup le_normalizer_of_normal
  have hm := congrArg (Subgroup.map L.subtype) he
  simpa only [map_commutator,←MonoidHom.range_eq_map,range_subtype,moduleLayer] using hm

/-- Distinct commuting short blocks have distinct nonzero U-layers. -/
theorem OrbitDecomposition.modules_injective {S R K : Subgroup G}
    (b : OrbitDecomposition S R K) : Function.Injective (fun i => moduleLayer (b.block i)) := by
  intro i j he
  dsimp only at he
  by_contra hij
  have hc : moduleLayer (b.block i) ≤ centralizer (b.block i : Set G) := by
    rw [he]
    exact (moduleLayer_le _).trans (b.commute (Ne.symm hij))
  exact moduleLayer_ne_bot (b.type i).1.short
    ((module_commutator _ (b.type i).1.short).symm.trans
      (commutator_eq_bot_iff_le_centralizer.mpr hc))

variable {H M K R T : Subgroup G}
variable (d : OriginalHypotheses H M K R T)
variable (b : OrbitDecomposition (d.sylow : Subgroup H) (R.subgroupOf H) (pResidual 2 H))

omit [Finite G] in
/-- The original T permutes the literal ambient blocks. -/
theorem OriginalHypotheses.ambient_blocks_permuted (t : G) (ht : t ∈ T) (i : Fin b.size) :
    ∃ j, (b.block j).map H.subtype =
      ((b.block i).map H.subtype).map (MulAut.conj t).toMonoidHom := by
  rw [←d.sylow_image] at ht
  obtain ⟨a,ha,rfl⟩ := ht
  obtain ⟨j,hj⟩ := b.permutes a ha i
  refine ⟨j,?_⟩
  rw [hj,Subgroup.map_map,Subgroup.map_map]
  rfl

/-- The corresponding ambient modules retain their distinctness. -/
theorem OriginalHypotheses.ambient_modules_injective :
    Function.Injective (fun i => ambientModule (b.block i)) := by
  intro i j he
  exact b.modules_injective (map_injective H.subtype_injective he)

/-- In the original block family, fixing U_i already fixes K_i. -/
theorem OriginalHypotheses.module_stabilizer_le_block_normalizer (i : Fin b.size) :
    T ⊓ normalizer (ambientModule (b.block i) : Set G) ≤
      normalizer ((b.block i).map H.subtype : Set G) := by
  intro t ht
  obtain ⟨j,hj⟩ := d.ambient_blocks_permuted b t ht.1 i
  have he : ambientModule (b.block j) = ambientModule (b.block i) := by
    rw [ambientModule_eq_literal,hj,moduleLayer_map _ (MulAut.conj t).injective,
      ←ambientModule_eq_literal]
    exact mem_normalizer_iff_map_conj_eq.mp ht.2
  have hji := d.ambient_modules_injective b he
  exact mem_normalizer_iff_map_conj_eq.mpr (hji ▸ hj.symm)

omit [Finite G] in
/-- The one-block orbit is normalized by the whole original T. -/
theorem OriginalHypotheses.single_block_normalized (i : Fin b.size) (hs : b.size = 1) :
    T ≤ normalizer ((b.block i).map H.subtype : Set G) := by
  intro t ht
  obtain ⟨j,hj⟩ := d.ambient_blocks_permuted b t ht i
  have hji : j = i := Fin.ext (by have := j.isLt; have := i.isLt; omega)
  exact mem_normalizer_iff_map_conj_eq.mpr (hji ▸ hj.symm)

omit [Finite G] in
/-- In the two-block case the original action has exactly its two U-layers. -/
theorem OriginalHypotheses.module_pair (i j : Fin b.size) (hij : i ≠ j)
    (hs : b.size = 2) (t : G) (ht : t ∈ T) :
    (ambientModule (b.block i)).map (MulAut.conj t).toMonoidHom = ambientModule (b.block i) ∨
    (ambientModule (b.block i)).map (MulAut.conj t).toMonoidHom = ambientModule (b.block j) := by
  obtain ⟨k,hk⟩ := d.ambient_blocks_permuted b t ht i
  have hk' : ambientModule (b.block k) =
      (ambientModule (b.block i)).map (MulAut.conj t).toMonoidHom := by
    rw [ambientModule_eq_literal,hk,moduleLayer_map _ (MulAut.conj t).injective,
      ←ambientModule_eq_literal]
  have hi := i.isLt
  have hj := j.isLt
  have hh := k.isLt
  have hne : i.val ≠ j.val := fun he => hij (Fin.ext he)
  have hor : k = i ∨ k = j := by
    have hh' : k.val = i.val ∨ k.val = j.val := by omega
    exact hh'.imp Fin.ext Fin.ext
  rcases hor with rfl | rfl
  · exact Or.inl hk'.symm
  · exact Or.inr hk'.symm

/-- Transitivity of the original block action moves each module when s=2. -/
theorem OriginalHypotheses.exists_moving_module (i : Fin b.size) (hs : b.size = 2) :
    ∃ t ∈ T, (ambientModule (b.block i)).map (MulAut.conj t).toMonoidHom ≠
      ambientModule (b.block i) := by
  have hi := i.isLt
  let j : Fin b.size := ⟨1-i.val,by omega⟩
  have hji : j ≠ i := by
    intro he
    have hv := congrArg Fin.val he
    dsimp only [j] at hv
    omega
  obtain ⟨t,ht,he⟩ := d.module_orbit b i j
  refine ⟨t⁻¹,T.inv_mem ht,?_⟩
  rw [←he]
  exact fun hh => hji (d.ambient_modules_injective b hh)

end CFSG.Quasithin.ChapterC.Section05.BlockAnalysis
end
