module
public import Theory.GroupAction.TransvectionGenerated
public import Stellmacher.OmegaOneCenterMap
public import Stellmacher.BaumannNormalizer
public import CFSG.Quasithin.ChapterB.Section02.Thompson

/-!
# The source transvection subgroup on the Baumann omega-center

Put S = Baum(R) and E = Ω₁(Z(S)). The subgroup R⁺ is generated by the
actors in R with fixed index at most two on E. It contains S and is
preserved by every element normalizing R. For the two-block application,
a fixed plane of order four in U₁ ⊆ K₁ cannot be moved into K₂ when it
is disjoint from K₂. Hence R⁺ normalizes K₁, even when R interchanges
the two blocks. The module U₁, and every original right conjugate of U₁,
are then normalized by R⁺.

The fixed-plane order and its disjointness are the preceding marked A₅
module geometry; the theorem does not assume R-normality of either module.
Source: Aschbacher–Smith, C.5.6 proof, printed p.157.
-/

@[expose] public section
open Subgroup Stellmacher
namespace CFSG.Quasithin.ChapterC.Section05.ConjugateSource
variable {G : Type*} [Group G]

noncomputable def transvectionRadical (R : Subgroup G) : Subgroup G :=
  transvectionGenerated R (omegaOneCenterAmbient (ChapterB.baumann R))

private theorem normalizer_omegaCenter (S : Subgroup G) :
    normalizer (S : Set G) ≤ normalizer (omegaOneCenterAmbient S : Set G) := by
  intro x hx
  apply mem_normalizer_iff_map_conj_eq.mpr
  have he : S.map (MulAut.conj x).toMonoidHom = S := mem_normalizer_iff_map_conj_eq.mp hx
  change (omegaOneCenterAmbient S).map (MulAut.conj x).toMonoidHom = _
  rw [← omegaOneCenterAmbient_map_injective _ (MulAut.conj x).injective, he]

/-- The literal Baumann subgroup lies in the transvection radical. -/
theorem baumann_le_transvectionRadical (R : Subgroup G) :
    ChapterB.baumann R ≤ transvectionRadical R := by
  apply le_trans ?_ (centralizer_le_transvectionGenerated R _)
  refine le_inf inf_le_left ?_
  intro s hs e he
  exact ((mem_omegaOneCenterAmbient_iff _ _).mp he).2.2 s hs |>.symm

/-- Normalizing the original R preserves the source R⁺, including the
conjugator selected in C.5.5. -/
theorem normalizer_le_normalizer_transvectionRadical (R : Subgroup G) :
    normalizer (R : Set G) ≤ normalizer (transvectionRadical R : Set G) := by
  apply le_trans (le_inf le_rfl ?_) (normalizer_transvectionGenerated R _)
  exact (normalizer_le_normalizer_baumann R).trans (normalizer_omegaCenter _)

/-- A fixed subgroup inside an elementary subgroup of S lies in Ω₁(Z(S)). -/
theorem elementary_fixed_le_omegaCenter (S U : Subgroup G)
    (hUS : U ≤ S) (hU : IsElementaryAbelian 2 U) :
    U ⊓ centralizer (S : Set G) ≤ omegaOneCenterAmbient S := by
  let := hU
  intro u hu
  exact (mem_omegaOneCenterAmbient_iff _ _).mpr
    ⟨hUS hu.1, elemPow_eq_one_of_isElementaryAbelian u hu.1, hu.2⟩

/-- The source two-block transvection subgroup fixes the first block.
The whole R may permute the two blocks. -/
theorem transvectionRadical_normalizes_first_block [Finite G]
    (R K₁ K₂ U₁ : Subgroup G)
    (hUS : U₁ ≤ ChapterB.baumann R) (hUK : U₁ ≤ K₁)
    (hU : IsElementaryAbelian 2 U₁)
    (hfixed : Nat.card (U₁ ⊓ centralizer (ChapterB.baumann R : Set G) : Subgroup G) = 4)
    (hdisj : Disjoint U₁ K₂)
    (hperm : ∀ r ∈ R, K₁.map (MulAut.conj r).toMonoidHom = K₁ ∨
      K₁.map (MulAut.conj r).toMonoidHom = K₂) :
    transvectionRadical R ≤ normalizer (K₁ : Set G) := by
  apply transvectionGenerated_le_normalizer_of_disjoint_support
    R (omegaOneCenterAmbient (ChapterB.baumann R)) K₁ K₂
    (U₁ ⊓ centralizer (ChapterB.baumann R : Set G))
    (elementary_fixed_le_omegaCenter _ _ hUS hU) (inf_le_left.trans hUK)
  · rw [hfixed]
    decide
  · exact hdisj.mono_left inf_le_left
  · exact hperm

/-- Invariance of a module under R⁺ is transported through the original
source right conjugation, since its conjugator normalizes R. -/
theorem transvectionRadical_normalizes_right_conjugate
    (R U : Subgroup G) (x : G) (hx : x ∈ normalizer (R : Set G))
    (hU : transvectionRadical R ≤ normalizer (U : Set G)) :
    transvectionRadical R ≤ normalizer (U.map (MulAut.conj x⁻¹).toMonoidHom : Set G) := by
  have he : (transvectionRadical R).map (MulAut.conj x⁻¹).toMonoidHom = transvectionRadical R :=
    mem_normalizer_iff_map_conj_eq.mp
      (normalizer_le_normalizer_transvectionRadical R ((normalizer (R : Set G)).inv_mem hx))
  rw [← map_equiv_normalizer_eq, ← he]
  exact map_mono hU

end CFSG.Quasithin.ChapterC.Section05.ConjugateSource


namespace CFSG.Quasithin.ChapterC.Section05.ConjugateSource
variable {G : Type*} [Group G]

/-- The action of R on the Baumann omega-center has precisely S as its kernel. -/
public theorem baumann_eq_omegaCenter_centralizer (R : Subgroup G) :
    R ⊓ centralizer (omegaOneCenterAmbient (ChapterB.baumann R) : Set G) = ChapterB.baumann R := by
  have hJB : elementaryAbelianMaxJ R ≤ ChapterB.baumann R := by
    apply le_inf (sSup_le fun _ hB => hB.1)
    apply le_centralizer_iff.mpr
    intro x hx
    exact mem_centralizer_iff.mpr ((mem_omegaOneCenterAmbient_iff _ _).mp hx).2.2
  have hAB : ChapterB.thompsonAlpha R ≤ omegaOneCenterAmbient (ChapterB.baumann R) := by
    intro a ha
    obtain ⟨haJ, hap, _⟩ := (mem_omegaOneCenterAmbient_iff _ _).mp ha
    refine (mem_omegaOneCenterAmbient_iff _ _).mpr ⟨hJB haJ, hap, ?_⟩
    intro b hb
    exact (hb.2 a ha).symm
  apply le_antisymm
  · exact inf_le_inf_left R (centralizer_le hAB)
  · refine le_inf inf_le_left ?_
    intro b hb e he
    exact ((mem_omegaOneCenterAmbient_iff _ _).mp he).2.2 b hb |>.symm

/-- The radical is the book's R⁺: S together with the actual transvections on E. -/
public theorem transvectionRadical_eq_source [Finite G] (R : Subgroup G) :
    transvectionRadical R = ChapterB.baumann R ⊔
      closure {r | r ∈ R ∧
        (centralizer ({r} : Set G)).relIndex (omegaOneCenterAmbient (ChapterB.baumann R)) = 2} := by
  rw [transvectionRadical, transvectionGenerated_eq_kernel_sup,
    baumann_eq_omegaCenter_centralizer]

end CFSG.Quasithin.ChapterC.Section05.ConjugateSource
