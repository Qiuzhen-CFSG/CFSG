module
public import CFSG.Quasithin.ChapterC.Section05.ConjugateSource.TransvectionRadical
public import CFSG.Quasithin.ChapterB.Section03.Offenders.Odd
public import Theory.Representation.BinaryPermutationMulAction

/-!
# The two-dimensional fixed plane in the marked A₅ block module

The source C.5.4(3) action of S is the group generated by two disjoint
transpositions on the even-weight degree-five module. Its fixed subgroup has
order four. An equivariant marking of the actual U-module transports this
count to C_U(S); no normality under the larger R is assumed.

Source: Aschbacher–Smith, C.5.4(3) and the two-block part of C.5.6,
printed pp.155,157.
-/

public section
open Subgroup BinaryPermutation Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterC.Section05.ConjugateSource
variable {G : Type*} [Group G]

/-- The standard degree-five pair-swap actor fixes four core vectors. -/
theorem pair_actor_fixed_card :
    Nat.card (fixedSpace (coreRepresentation (Fin 5)) (ChapterB.Offenders.D 5)) = 4 := by
  have hc := ChapterB.Offenders.Odd.fixedCodim_core_disjointTranspositions
    (n := 5) (m := 2) (Or.inl rfl) (by decide)
  have hd := fixedCodim_add_finrank (coreRepresentation (Fin 5)) (ChapterB.Offenders.D 5)
  rw [hc, finrank_core] at hd
  have hdim : Module.finrank (ZMod 2)
      (fixedSpace (coreRepresentation (Fin 5)) (ChapterB.Offenders.D 5)) = 2 := by
    norm_num at hd ⊢
    omega
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2), hdim]
  norm_num

/-- Equivariant coordinates identify the literal subgroup centralizer with
the fixed vectors of the actual action image. -/
theorem marked_centralizer_card
    (S U : Subgroup G) (a : S →* Equiv.Perm (Fin 5))
    (e : U ≃* Multiplicative (core (Fin 5)))
    (he : ∀ (s : S) (u : U),
      (e.symm (Multiplicative.ofAdd (coreRepresentation (Fin 5) (a s) (e u).toAdd)) : G) =
        (s : G) * (u : G) * (s : G)⁻¹) :
    Nat.card (U ⊓ centralizer (S : Set G) : Subgroup G) =
      Nat.card (fixedSpace (coreRepresentation (Fin 5)) a.range) := by
  let F := fixedSpace (coreRepresentation (Fin 5)) a.range
  have fixed_iff (u : U) : (u : G) ∈ centralizer (S : Set G) ↔ (e u).toAdd ∈ F := by
    rw [mem_centralizer_iff, mem_fixedSpace_iff]
    constructor
    · intro hu p hp
      obtain ⟨s, rfl⟩ := hp
      apply Multiplicative.ofAdd.injective
      apply e.symm.injective
      apply Subtype.ext
      change (e.symm (Multiplicative.ofAdd (coreRepresentation (Fin 5) (a s) (e u).toAdd)) : G) = (e.symm (e u) : G)
      rw [he, e.symm_apply_apply, hu s s.property, mul_inv_cancel_right]
    · intro hu s hs
      let sS : S := ⟨s, hs⟩
      have hfix := hu (a sS) (show a sS ∈ a.range from ⟨sS, rfl⟩)
      have heq : Multiplicative.ofAdd (coreRepresentation (Fin 5) (a sS) (e u).toAdd) = e u :=
        Multiplicative.toAdd.injective hfix
      have hh := he sS u
      rw [heq, e.symm_apply_apply] at hh
      exact (mul_inv_eq_iff_eq_mul.mp hh.symm)
  let f : (U ⊓ centralizer (S : Set G) : Subgroup G) → F := fun u =>
    ⟨(e ⟨u, u.property.1⟩).toAdd, (fixed_iff ⟨u, u.property.1⟩).mp u.property.2⟩
  have hf : Function.Bijective f := by
    constructor
    · intro u v huv
      apply Subtype.ext
      exact congrArg (fun z : U => (z : G)) (e.injective
        (Multiplicative.toAdd.injective (congrArg Subtype.val huv)))
    · intro w
      let u := e.symm (Multiplicative.ofAdd w.val)
      have hu : (u : G) ∈ centralizer (S : Set G) := by
        apply (fixed_iff u).mpr
        change (e (e.symm (Multiplicative.ofAdd w.val))).toAdd ∈ F
        rw [e.apply_symm_apply]
        exact w.property
      refine ⟨⟨u, u.property, hu⟩, ?_⟩
      apply Subtype.ext
      exact congrArg Multiplicative.toAdd (e.apply_symm_apply (Multiplicative.ofAdd w.val))
  exact Nat.card_congr (Equiv.ofBijective f hf)


/-- The literal fixed subgroup in the marked C.5.4 degree-five action has
order four. -/
theorem marked_fixed_plane_card
    (S U : Subgroup G) (a : S →* Equiv.Perm (Fin 5))
    (e : U ≃* Multiplicative (core (Fin 5)))
    (himage : a.range = ChapterB.Offenders.D 5)
    (he : ∀ (s : S) (u : U),
      (e.symm (Multiplicative.ofAdd (coreRepresentation (Fin 5) (a s) (e u).toAdd)) : G) =
        (s : G) * (u : G) * (s : G)⁻¹) :
    Nat.card (U ⊓ centralizer (S : Set G) : Subgroup G) = 4 := by
  rw [marked_centralizer_card S U a e he, himage]
  exact pair_actor_fixed_card

end CFSG.Quasithin.ChapterC.Section05.ConjugateSource
