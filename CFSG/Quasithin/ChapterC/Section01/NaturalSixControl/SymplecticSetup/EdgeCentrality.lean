/-!
# Edge centrality from the actual symplectic residual dichotomy

At the base original-group vertex, each incident holomorph radius normally
generates the radius inside the vertex stabilizer. Pulling both radii back
through embedM makes this a literal normal-closure equality in M. The actual
source generation M=L R then gives the edge-plus-moving cover, while R
normalizes the edge radius. Critical distance greater than two makes that
edge radius abelian.

The residual dichotomy now yields centrality of [V_alpha,Q_alpha] in either
branch: the fixed branch uses normal generation, and the covering branch
uses nilpotent commutator saturation. Both branches use the original subgroup
maps. A direct endpoint accepts the preimage dichotomy in M with its actual
two-core and two-residual. The final consumer supplies all three radius
conclusions from the same source alternative. Direct index endpoints also
assemble the literal S₆ chief budget, leaving only the original marked actor
and index premises.

Source: Meierfrankenfeld--Stellmacher (1993), (5.2)(ii)--(iii), printed
pp.914--915. The chief-budget producer retains the marked actor and fixed
index premises. No SL3 LocalSource or elementary radius quotient is assumed.
-/

public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.BinaryMS.MS93
open CFSG.Quasithin.ChapterC.BinaryMS.MS93.NaturalStructure.Exclusion
open scoped commutatorElement
namespace CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup
variable {M : Type*} [Group M] {R : Subgroup M}

private theorem adjacent_seed_le_radius {a t : Vertex R} (hat : Adjacent R a t) :
    Z R a ≤ V R t := by
  apply le_iSup_of_le a
  exact le_iSup_of_le
    (show (cosetGraph R).dist a t ≤ 2 from
      (SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj R _ _).mpr hat)).le.trans (by decide)) le_rfl

/-- The radius at an original-group vertex is normally generated by each
incident edge radius, relative to the actual vertex stabilizer. -/
theorem radius_le_of_normalized_edge [Finite M] {a t : Vertex R} (ha : color R a = false)
    (hat : Adjacent R a t) (K : Subgroup (FreeAmalgam R))
    (hEK : V R t ≤ K) (hn : stabilizer R a ≤ normalizer (K : Set (FreeAmalgam R))) :
    V R a ≤ K := by
  apply radius_le_of_m_ball ha
  intro d hd hdist
  by_cases hda : d = a
  · subst d
    exact (adjacent_seed_le_radius hat).trans hEK
  have htwo : (cosetGraph R).dist a d = 2 := by
    have hne : (cosetGraph R).dist a d ≠ 0 := by
      intro hz
      exact hda ((cosetGraph_connected R).dist_eq_zero_iff.mp hz).symm
    have heven : Even ((cosetGraph R).dist a d) := by
      obtain ⟨w, hw⟩ := (cosetGraph_connected R).exists_walk_length_eq_dist a d
      rw [← hw, walk_even_iff_color_eq, ha, hd]
    rw [Nat.even_iff] at heven
    rw [SimpleGraph.dist_comm] at hdist
    omega
  obtain ⟨u, hau, hdu⟩ := exists_common_neighbor_of_dist_two R a d htwo
  obtain ⟨g, hg, hgu⟩ := stabilizer_transitive_neighbors R a hat hau
  have hVu : V R u ≤ K := by
    rw [← hgu, V_act]
    exact (map_mono hEK).trans
      (mem_normalizer_iff_map_conj_eq.mp (hn ((stabilizer R a).inv_mem hg))).le
  exact (adjacent_seed_le_radius hdu).trans hVu

private theorem comap_normal_of_base_normalized (N : Subgroup (FreeAmalgam R))
    (hN : stabilizer R (alpha R) ≤ normalizer (N : Set (FreeAmalgam R))) :
    (N.comap (embedM R)).Normal := by
  refine ⟨?_⟩
  intro x hx g
  change embedM R (g * x * g⁻¹) ∈ N
  rw [map_mul, map_mul, map_inv]
  have hg : embedM R g ∈ stabilizer R (alpha R) := by
    rw [show alpha R = mVertex R 1 from rfl, stabilizer_m_base]
    exact ⟨g, rfl⟩
  exact le_normalizer_iff.mp hN _ hg _ hx

private theorem map_comap_of_le_base (N : Subgroup (FreeAmalgam R))
    (hN : N ≤ stabilizer R (alpha R)) : (N.comap (embedM R)).map (embedM R) = N := by
  rw [map_comap_eq]
  apply inf_eq_right.mpr
  change N ≤ stabilizer R (mVertex R 1) at hN
  rwa [stabilizer_m_base] at hN

private theorem base_normalizes_image (N : Subgroup M) [N.Normal] :
    stabilizer R (alpha R) ≤ normalizer (N.map (embedM R) : Set (FreeAmalgam R)) := by
  rw [show alpha R = mVertex R 1 from rfl, stabilizer_m_base]
  change (embedM R).range ≤ _
  rw [MonoidHom.range_eq_map]
  simpa only [normalizer_eq_top] using N.le_normalizer_map (embedM R)

namespace Source
variable [Finite M] {L W : Subgroup M} [L.Normal] [W.Normal] (s : Source L R W)
include s

omit [Finite M] [L.Normal] [W.Normal] s in
/-- The original local group normalizes its radius preimage. -/
theorem radius_comap_normal : ((V R (alpha R)).comap (embedM R)).Normal :=
  comap_normal_of_base_normalized _ (V_normalized _)

theorem radius_comap_map (hb : 2 < s.geometry.b R) :
    ((V R (alpha R)).comap (embedM R)).map (embedM R) = V R (alpha R) :=
  map_comap_of_le_base _ (s.geometry.V_local _ rfl hb)

theorem edge_radius_comap_map (hb : 2 < s.geometry.b R) :
    ((V R (beta R)).comap (embedM R)).map (embedM R) = V R (beta R) :=
  map_comap_of_le_base _ ((edge_radius_le_radius rfl (base_adjacent R)).trans
    (s.geometry.V_local _ rfl hb))

/-- Normal generation in the literal original group M, through embedM. -/
theorem radius_comap_eq_normalClosure_edge (hb : 2 < s.geometry.b R) :
    (V R (alpha R)).comap (embedM R) =
      normalClosure ((V R (beta R)).comap (embedM R) : Set M) := by
  let V₀ := (V R (alpha R)).comap (embedM R)
  let E := (V R (beta R)).comap (embedM R)
  let := radius_comap_normal (R := R)
  apply le_antisymm
  · have hV : V R (alpha R) ≤ (normalClosure (E : Set M)).map (embedM R) := by
      apply radius_le_of_normalized_edge rfl (base_adjacent R)
      · change V R (beta R) ≤ _
        rw [←s.edge_radius_comap_map hb]
        exact map_mono le_normalClosure
      · exact base_normalizes_image _
    have h := comap_mono (f := embedM R) hV
    rwa [comap_map_eq_self_of_injective (embedM_injective R)] at h
  · apply normalClosure_le_normal
    exact comap_mono (f := embedM R) (edge_radius_le_radius rfl (base_adjacent R))

omit [L.Normal] [W.Normal] s in
/-- The original radical normalizes the edge radius in M. -/
theorem radical_normalizes_edge_radius_comap :
    R ≤ normalizer ((V R (beta R)).comap (embedM R) : Set M) := by
  apply le_normalizer_iff.mpr
  intro r hr x hx
  change embedM R (r*x*r⁻¹) ∈ V R (beta R)
  rw [map_mul,map_mul,map_inv]
  have hr' : embedM R r ∈ stabilizer R (beta R) := by
    have hq : embedM R r ∈ Q R (beta R) := by
      rw [Q_beta]
      exact mem_map_of_mem _ hr
    exact hq.1
  exact le_normalizer_iff.mp (V_normalized (beta R)) _ hr' _ hx

/-- The actual source generation M=L R supplies the edge-plus-moving cover. -/
theorem radius_comap_le_edge_sup_commutator (hb : 2 < s.geometry.b R) :
    (V R (alpha R)).comap (embedM R) ≤
      (V R (beta R)).comap (embedM R) ⊔ ⁅(V R (alpha R)).comap (embedM R), L⁆ := by
  let V₀ := (V R (alpha R)).comap (embedM R)
  let E := (V R (beta R)).comap (embedM R)
  let := radius_comap_normal (R := R)
  have hEV : E ≤ V₀ := comap_mono (f := embedM R)
    (edge_radius_le_radius rfl (base_adjacent R))
  let D := E ⊔ ⁅V₀,L⁆
  let : D.Normal := by
    apply normalizer_eq_top_iff.mp
    apply top_unique
    rw [←s.sup_eq_top]
    apply sup_le
    · exact le_normalizer_sup_of_commutator_le V₀ L E ⁅V₀,L⁆ hEV le_rfl
    · exact (le_inf (radical_normalizes_edge_radius_comap (R := R)) le_normalizer_of_normal).trans
        (normalizer_inf_normalizer_le_normalizer_sup E ⁅V₀,L⁆)
  calc
    V₀ = normalClosure (E : Set M) := s.radius_comap_eq_normalClosure_edge hb
    _ ≤ D := normalClosure_le_normal (show E ≤ D from le_sup_left)


/-- The source residual dichotomy forces centrality of the actual radius
commutator. All normality and edge-generation hypotheses are proved from s. -/
theorem radius_commutator_central_of_residual_dichotomy (hb : 2 < s.geometry.b R)
    (hd : ⁅⁅V R (alpha R), Q R (alpha R)⁆, Ltilde R (alpha R)⁆ ≤ Z R (alpha R) ∨
      ⁅V R (alpha R), Ltilde R (alpha R)⁆ ≤ ⁅V R (alpha R), Q R (alpha R)⁆ ⊔ Z R (alpha R)) :
    ⁅V R (alpha R), Q R (alpha R)⁆ ≤ centralizer (V R (alpha R) : Set (FreeAmalgam R)) := by
  let f := embedM R
  let V₀ := (V R (alpha R)).comap f
  let E := (V R (beta R)).comap f
  let Z₀ := (Z R (alpha R)).comap f
  let P := pCore 2 M
  let := radius_comap_normal (R := R)
  let := SymplecticSeed.Z_comap_normal R
  have hVm : V₀.map f = V R (alpha R) := s.radius_comap_map hb
  have hEm : E.map f = V R (beta R) := s.edge_radius_comap_map hb
  have hZm : Z₀.map f = Z R (alpha R) := map_comap_of_le_base _
    ((Z_le_VBall R (alpha R) 2).trans (s.geometry.V_local _ rfl hb))
  have hPm : P.map f = Q R (alpha R) := (Q_alpha R s.two_group s.core_le).symm
  have hLm : L.map f = Ltilde R (alpha R) := by rw [Ltilde_alpha,s.residual]
  have hVP : V₀ ≤ P := by
    have h := comap_mono (f := f) (s.geometry.V_le_Q hb (alpha R) rfl)
    rwa [Q_alpha_comap R s.two_group s.core_le] at h
  have hEV : E ≤ V₀ := comap_mono (f := f)
    (edge_radius_le_radius rfl (base_adjacent R))
  have hZE : Z₀ ≤ E := comap_mono (f := f) (adjacent_seed_le_radius (base_adjacent R))
  have hE : E ≤ centralizer (E : Set M) := by
    have hc := le_centralizer_iff_isMulCommutative.mpr
      (edge_radius_commutative s.geometry hb (alpha R) (beta R) rfl (base_adjacent R))
    intro x hx y hy
    apply embedM_injective R
    simpa only [map_mul] using hc hx (f y) hy
  have hcentral : ⁅V₀,P⁆ ≤ centralizer (V₀ : Set M) := by
    rcases hd with hd | hd
    · have hfixed : ⁅⁅V₀,P⁆,L⁆ ≤ Z₀ := by
        apply (map_le_map_iff_of_injective (embedM_injective R)).mp
        rwa [map_commutator,map_commutator,hVm,hPm,hLm,hZm]
      exact edge_commutator_central_of_residual_fixed V₀ P E Z₀ L R
        (s.radius_comap_eq_normalClosure_edge hb) hEV hZE
        (radical_normalizes_edge_radius_comap (R := R)) s.core_le s.sup_eq_top hE hfixed
    · have hcover : ⁅V₀,L⁆ ≤ E ⊔ ⁅V₀,P⁆ := by
        have hc : ⁅V₀,L⁆ ≤ ⁅V₀,P⁆ ⊔ Z₀ := by
          apply (map_le_map_iff_of_injective (embedM_injective R)).mp
          rwa [map_commutator,Subgroup.map_sup,map_commutator,hVm,hPm,hLm,hZm]
        exact hc.trans (sup_le le_sup_right (hZE.trans le_sup_left))
      exact edge_commutator_central_of_residual_cover V₀ P E L hVP (hEV.trans hVP)
        (pCore_isPGroup (p := 2) (G := M)).isNilpotent
        (s.core_le.trans (radical_normalizes_edge_radius_comap (R := R))) hE
        (s.radius_comap_le_edge_sup_commutator hb) hcover
  rw [←hVm,←hPm,←map_commutator]
  exact (map_mono hcentral).trans (map_centralizer_le_centralizer_image (V₀ : Set M) f)


/-- Direct input from the chief-budget theorem in M: the only preimages are
through the specified embedM, and both the residual and kernel are literal. -/
theorem radius_commutator_central_of_preimage_dichotomy (hb : 2 < s.geometry.b R)
    (hd : ⁅⁅(V R (alpha R)).comap (embedM R), pCore 2 M⁆, pResidual 2 M⁆ ≤
        (Z R (alpha R)).comap (embedM R) ∨
      ⁅(V R (alpha R)).comap (embedM R), pResidual 2 M⁆ ≤
        ⁅(V R (alpha R)).comap (embedM R), pCore 2 M⁆ ⊔
          (Z R (alpha R)).comap (embedM R)) :
    ⁅V R (alpha R), Q R (alpha R)⁆ ≤ centralizer (V R (alpha R) : Set (FreeAmalgam R)) := by
  apply s.radius_commutator_central_of_residual_dichotomy hb
  have hZ := map_comap_of_le_base (Z R (alpha R))
    ((Z_le_VBall R (alpha R) 2).trans (s.geometry.V_local _ rfl hb))
  rcases hd with hd | hd
  · left
    have hm := map_mono (f := embedM R) hd
    rwa [map_commutator,map_commutator,s.radius_comap_map hb,
      ←Q_alpha R s.two_group s.core_le,←Ltilde_alpha,hZ] at hm
  · right
    have hm := map_mono (f := embedM R) hd
    rwa [map_commutator,Subgroup.map_sup,map_commutator,s.radius_comap_map hb,
      ←Q_alpha R s.two_group s.core_le,←Ltilde_alpha,hZ] at hm

/-- The source residual alternative discharges the sole centrality premise
of the derived-radius and critical triple-commutator bounds. -/
theorem radius_bounds_of_residual_dichotomy (hb : 2 < s.geometry.b R)
    (hd : ⁅⁅V R (alpha R), Q R (alpha R)⁆, Ltilde R (alpha R)⁆ ≤ Z R (alpha R) ∨
      ⁅V R (alpha R), Ltilde R (alpha R)⁆ ≤ ⁅V R (alpha R), Q R (alpha R)⁆ ⊔ Z R (alpha R))
    (a' c : Vertex R) :
    ⁅V R (alpha R), Q R (alpha R)⁆ ≤ centralizer (V R (alpha R) : Set (FreeAmalgam R)) ∧
    ⁅V R (alpha R), V R (alpha R)⁆ ≤ X R (alpha R) ∧
    ⁅⁅X R a' ⊓ Q R (alpha R), V R (alpha R) ⊓ Q R c⁆,
      V R (alpha R) ⊓ Q R c⁆ = ⊥ := by
  have hc := s.radius_commutator_central_of_residual_dichotomy hb hd
  exact ⟨hc,SectionFive.radius_derived_le_X R s.geometry hb rfl hc,
    SectionFive.critical_radius_triple_commutator R hc⟩

end Source
end CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup

namespace CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup.Source
/-- Literal source consumer: quotient chief budget, original S6 projection,
original fixed index, and graph edge centrality assembled without transport inputs. -/
theorem radius_commutator_central_of_fixedIndex
    {M : Type*} [Group M] [Finite M]
    {L R W : Subgroup M} [L.Normal] [W.Normal] (s : Source L R W)
    (hb : 2 < s.geometry.b R)
    (hq : Function.Surjective s.projection)
    (A : Subgroup M) (a : Equiv.Perm (Fin 6))
    (ha : orderOf a = 2) (heven : a ∈ alternatingGroup (Fin 6))
    (haA : a ∈ A.map s.projection)
    (hi : letI := CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSeed.Z_comap_normal R
      (centralizerModulo ((V R (alpha R)).comap (embedM R)) A
      ((Z R (alpha R)).comap (embedM R))).relIndex
        ((V R (alpha R)).comap (embedM R)) ≤ 8) :
    ⁅V R (alpha R),Q R (alpha R)⁆ ≤ centralizer (V R (alpha R) : Set (FreeAmalgam R)) := by
  let V₀ := (V R (alpha R)).comap (embedM R)
  let Z₀ := (Z R (alpha R)).comap (embedM R)
  let := Source.radius_comap_normal (R := R)
  let := CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSeed.Z_comap_normal R
  have hV : V₀ ≤ s.projection.ker := by
    rw [s.projection_kernel]
    have h := comap_mono (f := embedM R) (s.geometry.V_le_Q hb (alpha R) rfl)
    rwa [Q_alpha_comap R s.two_group s.core_le] at h
  have hZV : Z₀ ≤ V₀ := comap_mono (f := embedM R) (Z_le_VBall R (alpha R) 2)
  have hp : IsPGroup 2 s.projection.ker := by rw [s.projection_kernel]; exact pCore_isPGroup
  have h := NoncentralChiefRefinement.SymmetricSixBudget.kernel_commutator_residual_dichotomy
    s.projection hq hp V₀ Z₀ hZV hV A a ha heven haA hi
  rw [s.projection_kernel] at h
  exact s.radius_commutator_central_of_preimage_dichotomy hb h


/-- The original index subgroup and its marked actor commutators suffice for
edge centrality; the fixed-index and quotient premises are derived internally. -/
theorem radius_commutator_central_of_index_subgroup
    {M : Type*} [Group M] [Finite M]
    {L R W : Subgroup M} [L.Normal] [W.Normal] (s : Source L R W)
    (hb : 2 < s.geometry.b R) (hq : Function.Surjective s.projection)
    (A : Subgroup M) (a : Equiv.Perm (Fin 6))
    (ha : orderOf a = 2) (heven : a ∈ alternatingGroup (Fin 6))
    (haA : a ∈ A.map s.projection) (K : Subgroup M)
    (hc : ⁅(V R (alpha R)).comap (embedM R) ⊓ K, A⁆ ≤
      (Z R (alpha R)).comap (embedM R))
    (hi : K.relIndex ((V R (alpha R)).comap (embedM R)) ≤ 8) :
    ⁅V R (alpha R),Q R (alpha R)⁆ ≤ centralizer (V R (alpha R) : Set (FreeAmalgam R)) := by
  apply s.radius_commutator_central_of_fixedIndex hb hq A a ha heven haA
  let := CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSeed.Z_comap_normal R
  exact (NoncentralChiefRefinement.SymmetricSixBudget.centralizerModulo_relIndex_le_of_commutator
    ((V R (alpha R)).comap (embedM R)) A ((Z R (alpha R)).comap (embedM R)) K hc).trans hi
end CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup.Source
