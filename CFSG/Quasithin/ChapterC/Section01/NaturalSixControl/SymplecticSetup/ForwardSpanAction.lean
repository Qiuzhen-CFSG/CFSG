module
public import CFSG.Quasithin.ChapterC.Section01.NaturalSixControl.SymplecticSetup.ForwardSpanDerived
public import Theory.GroupTheory.CentralCharacteristicAutomorphisms
public import Theory.SpecificGroups.SymmetricSix.BinaryFlags.PointCoreTranspositionFixed.SmallImage
/-!
# The literal symmetric-six action on the terminal central quotient

At critical distance four, the normal forward span P is a nonabelian group
of class two with elementary binary quotient P/Z(P). The entire local
two-core acts trivially on this quotient, so conjugation descends through
the source's actual symmetric-six projection. No splitting is chosen.

The same span has image of order at most two modulo the second vertex's
kernel. Its action on that vertex's natural module has moved space of size
at most two, and a natural hyperplane fixer is generated by one transposition.
This supplies the first index and action inputs in the last paragraph of
MS93 (5.12), printed p.927. Fixed-index control by the opposite critical seed
and representation recognition remain separate inputs to terminal assembly.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative commutatorElement
open CFSG.Quasithin.ChapterC.BinaryMS.MS93 Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality
namespace CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup
variable {M : Type*} [Group M] (R : Subgroup M)

/-- Conjugation by the original group on the literal normal forward span. -/
@[expose] noncomputable def forwardSpanAction (c : Vertex R) :
    M →* MulAut (localZSpan R c (alpha R)) :=
  (localZSpan R c (alpha R)).normalizerMonoidHom.comp
    ((embedM R).codRestrict _ (by
      intro m
      apply localZSpan_normalized R c (alpha R)
      change embedM R m ∈ stabilizer R (mVertex R 1)
      rw [stabilizer_m_base]
      exact ⟨m,rfl⟩))

@[expose] noncomputable def forwardSpanCentralAction (c : Vertex R) :
    M →* MulAut ((localZSpan R c (alpha R)) ⧸ center (localZSpan R c (alpha R))) :=
  (quotientAut (center (localZSpan R c (alpha R)))).comp (forwardSpanAction R c)

theorem forwardSpanCentralAction_apply (c : Vertex R) (m : M)
    (x : localZSpan R c (alpha R)) :
    forwardSpanCentralAction R c m (QuotientGroup.mk' (center (localZSpan R c (alpha R))) x) =
      QuotientGroup.mk' (center (localZSpan R c (alpha R))) (forwardSpanAction R c m x) := by
  exact quotientAut_apply_mk _ _ _

namespace Source
variable [Finite M] {L R W : Subgroup M} [L.Normal] [W.Normal] (s : Source L R W)

theorem forward_span_central_action_kills_core
    (h : NativeCentralLayer s) (u : Model.S)
    (hfull : R.map s.projection=Model.E.map (MulAut.conj u).toMonoidHom)
    (hb : s.geometry.b R=4) {e : Vertex R}
    (p : CriticalPath R s.geometry (alpha R) e) :
    pCore 2 M ≤ (forwardSpanCentralAction R (p.walk.getVert 2)).ker := by
  let P := localZSpan R (p.walk.getVert 2) (alpha R)
  have hh := (s.forward_span_central_quotient h u hfull hb p).2.2.2
  have hc : ⁅P,Q R (alpha R)⁆ ≤ centralizer (P:Set (FreeAmalgam R)) := by
    intro z hz
    obtain ⟨w,hw,hwe⟩ := hh hz
    rw [←hwe]
    intro y hy
    exact congrArg Subtype.val (mem_center_iff.mp hw ⟨y,hy⟩)
  intro m hm
  have hmQ : embedM R m ∈ Q R (alpha R) := by
    rw [Q_alpha R s.two_group s.core_le]
    exact mem_map_of_mem (embedM R) hm
  apply MonoidHom.mem_ker.mpr
  apply MulEquiv.ext
  intro v
  obtain ⟨x,rfl⟩ := QuotientGroup.mk'_surjective (center P) v
  rw [forwardSpanCentralAction_apply]
  apply QuotientGroup.eq_iff_div_mem.mpr
  apply mem_center_iff.mpr
  intro y
  apply Subtype.ext
  have hmem : ⁅embedM R m,(x:FreeAmalgam R)⁆ ∈ ⁅P,Q R (alpha R)⁆ := by
    rw [commutator_comm]
    exact commutator_mem_commutator hmQ x.property
  change (y:FreeAmalgam R) * (embedM R m*(x:FreeAmalgam R)*(embedM R m)⁻¹/(x:FreeAmalgam R)) =
    (embedM R m*(x:FreeAmalgam R)*(embedM R m)⁻¹/(x:FreeAmalgam R))*(y:FreeAmalgam R)
  simpa only [div_eq_mul_inv,commutatorElement_def] using hc hmem y y.property

theorem exists_forward_span_symmetric_central_action
    (h : NativeCentralLayer s) (u : Model.S)
    (hfull : R.map s.projection=Model.E.map (MulAut.conj u).toMonoidHom)
    (hb : s.geometry.b R=4) {e : Vertex R}
    (p : CriticalPath R s.geometry (alpha R) e) :
    ∃ ρ : Model.S →* MulAut ((localZSpan R (p.walk.getVert 2) (alpha R)) ⧸
        center (localZSpan R (p.walk.getVert 2) (alpha R))),
      ∀ m : M, ρ (s.projection m)=forwardSpanCentralAction R (p.walk.getVert 2) m := by
  have hk : s.projection.ker ≤ (forwardSpanCentralAction R (p.walk.getVert 2)).ker := by
    rw [s.projection_kernel]
    exact s.forward_span_central_action_kills_core h u hfull hb p
  let ρ := s.projection.liftOfSurjective
    (s.projection_surjective_of_radical_image_le_conjugate u hfull.le)
      ⟨forwardSpanCentralAction R (p.walk.getVert 2),hk⟩
  exact ⟨ρ,by intro m; simp [ρ,MonoidHom.liftOfSurjective]⟩
end Source
end CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup

namespace CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup.Source
variable {M : Type*} [Group M] [Finite M] {L R W : Subgroup M} [L.Normal] [W.Normal]
  (s : Source L R W)

theorem moving_small_fixed_index_implies_small_image
    (h : NativeCentralLayer s) {c : Vertex R} (hc : color R c=false)
    (A : Subgroup (FreeAmalgam R)) (hA : A≤stabilizer R c)
    (hindex : (centralizer (A:Set (FreeAmalgam R))).relIndex (U R c)≤2) :
    (Q R c).relIndex A≤2 := by
  obtain ⟨g,rfl⟩ := exists_mVertex_of_color R hc
  let i := (MulAut.conj g⁻¹).toMonoidHom.comp (embedM R)
  have hi : Function.Injective i := (MulAut.conj g⁻¹).injective.comp (embedM_injective R)
  have hact : act R g (alpha R)=mVertex R g := by simp only [alpha,act_mVertex,one_mul]
  have hQ : (pCore 2 M).map i=Q R (mVertex R g) := by
    rw [←hact,Q_act,Q_alpha R s.two_group s.core_le,map_map]
  have hU : W.map i=U R (mVertex R g) := by
    rw [←hact,U_act,h.U_eq_module,map_map]
  have hG : i.range=stabilizer R (mVertex R g) := by
    rw [MonoidHom.range_comp]
    change (Mbar R).map (MulAut.conj g⁻¹).toMonoidHom = _
    rw [←stabilizer_m_base]
    change (stabilizer R (alpha R)).map (MulAut.conj g⁻¹).toMonoidHom = _
    rw [←stabilizer_act,hact]
  have hAm : (A.comap i).map i=A := map_comap_eq_self (hA.trans_eq hG.symm)
  have hidx : (centralizer (A.comap i:Set M)).relIndex W≤2 := by
    have he : (centralizer (A:Set (FreeAmalgam R))).relIndex (U R (mVertex R g))=
        (centralizer (A.comap i:Set M)).relIndex W := by
      rw [←hU,←hAm,←inf_relIndex_right,inf_comm,
        map_inf_centralizer_of_injective i hi,relIndex_map_map_of_injective _ _ hi,
        inf_relIndex_left,comap_map_eq_self_of_injective hi]
    rwa [he] at hindex
  have hcodim : Representation.BinaryOffender.fixedCodim Model.rho
      ((A.comap i).map s.projection)≤1 := by
    rw [s.fixed_index] at hidx
    exact (Nat.pow_le_pow_iff_right (by decide : 1<2)).mp hidx
  have hcard : Nat.card ((A.comap i).map s.projection)≤2 := by
    by_cases hz : (A.comap i).map s.projection=⊥
    · rw [hz,card_bot]; decide
    · obtain ⟨t,_,ht,he⟩ :=
        Theory.SpecificGroups.SymmetricSix.BinaryFlags.PointCoreTranspositionFixed.small_image_eq_zpowers
          ((A.comap i).map s.projection) hz hcodim
      rw [he,Nat.card_zpowers,ht.orderOf]
  rw [←hAm,←hQ,relIndex_map_map_of_injective _ _ hi,←s.projection_kernel,relIndex_ker]
  exact hcard

theorem forward_span_second_vertex_index_le_two
    (h : NativeCentralLayer s) (u : Model.S)
    (hfull : R.map s.projection=Model.E.map (MulAut.conj u).toMonoidHom)
    (hb : s.geometry.b R=4) {e : Vertex R}
    (p : CriticalPath R s.geometry (alpha R) e) :
    (Q R (p.walk.getVert 2)).relIndex (localZSpan R (p.walk.getVert 2) (alpha R))≤2 := by
  let P := localZSpan R (p.walk.getVert 2) (alpha R)
  let T₀ := Q R (alpha R)⊓centralizer
    (U R (p.walk.getVert 2)⊓B R (alpha R) (s.geometry.Z_normal _):Set (FreeAmalgam R))
  have hl : p.walk.length=4 := p.length_eq_b.trans hb
  have hc : color R (p.walk.getVert 2)=false := (p.vertex_color (by omega)).mpr (by decide)
  have hat : Adjacent R (alpha R) (p.walk.getVert 1) := by
    apply (cosetGraph_adj R _ _).mp
    simpa only [SimpleGraph.Walk.getVert_zero] using p.walk.adj_getVert_succ (i:=0) (by omega)
  have hct : Adjacent R (p.walk.getVert 2) (p.walk.getVert 1) :=
    adjacent_symm R ((cosetGraph_adj R _ _).mp (p.walk.adj_getVert_succ (i:=1) (by omega)))
  have ht : color R (p.walk.getVert 1)=true := by
    have hn := adjacent_color_ne R hat
    change false≠color R (p.walk.getVert 1) at hn
    cases hh:color R (p.walk.getVert 1) <;> simp_all
  have hPT : P≤T₀ := s.forward_span_le_hyperplane_kernel (by omega) p
  have hPG : P≤stabilizer R (p.walk.getVert 2) :=
    (hPT.trans (inf_le_left.trans (Q_le_adjacent_h R ht hat))).trans
      (fun _ hx => hx.2 _ (adjacent_symm R hct))
  have hi := s.forward_moving_index_eq_two_of_distance_four h u hfull hb p
  have hcard := (s.moving_hyperplane_commutator_le_seed h u hfull rfl hc hat hct hi.le).1
  have hcomm : ⁅U R (p.walk.getVert 2),P⁆≤⁅U R (p.walk.getVert 2),T₀⁆ :=
    commutator_mono le_rfl hPT
  let := finite_stabilizer R (p.walk.getVert 2)
  let : Finite (U R (p.walk.getVert 2)) := Finite.of_injective
    (inclusion ((DistanceEight.U_le_Z R _).trans (Z_le_stabilizer R _))) (inclusion_injective _)
  have hUcomm : ⁅U R (p.walk.getVert 2),T₀⁆≤U R (p.walk.getVert 2) :=
    le_normalizer_iff_commutator_le_left.mp
      (((inf_le_left.trans (Q_le_adjacent_h R ht hat)).trans
        (fun _ hx => hx.2 _ (adjacent_symm R hct))).trans (U_normalized _))
  let : Finite (⁅U R (p.walk.getVert 2),T₀⁆:Subgroup (FreeAmalgam R)) :=
    Finite.of_injective (inclusion hUcomm) (inclusion_injective _)
  have hfixed : (centralizer (P:Set (FreeAmalgam R))).relIndex (U R (p.walk.getVert 2))≤2 := by
    rw [s.moving_fixedIndex_eq_commutator_card h
      (s.projection_surjective_of_radical_image_le_conjugate u hfull.le) _ hc P hPG]
    exact (card_le_of_le hcomm).trans hcard
  exact s.moving_small_fixed_index_implies_small_image h hc P hPG hfixed
end CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup.Source


namespace CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup.Source
variable {M : Type*} [Group M] [Finite M] {L R W : Subgroup M} [L.Normal] [W.Normal]
  (s : Source L R W)

/-- The literal terminal quotient and its first local index, with one fixed
conjugation action shared by the source and original replacement. -/
@[expose] def ForwardSpanActionData (c : Vertex R) : Prop :=
  let P := localZSpan R c (alpha R)
  IsElementaryAbelian 2 (P⧸center P) ∧
    (Q R c).relIndex P≤2 ∧
    ∃ ρ : Model.S →* MulAut (P⧸center P),
      ∀ m : M, ρ (s.projection m)=forwardSpanCentralAction R c m

theorem forward_span_action_data
    (h : NativeCentralLayer s) (u : Model.S)
    (hfull : R.map s.projection=Model.E.map (MulAut.conj u).toMonoidHom)
    (hb : s.geometry.b R=4) {e : Vertex R}
    (p : CriticalPath R s.geometry (alpha R) e) :
    s.ForwardSpanActionData (p.walk.getVert 2) :=
  ⟨(s.forward_span_central_quotient h u hfull hb p).1,
    s.forward_span_second_vertex_index_le_two h u hfull hb p,
    s.exists_forward_span_symmetric_central_action h u hfull hb p⟩
end CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup.Source

namespace CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup.SourceData
open Subgroup Theory.GroupTheory
open CFSG.Quasithin.ChapterC.BinaryMS.MS93 Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality
variable {K : Type*} [Group K] [Finite K] {L W : Subgroup K} [L.Normal] [W.Normal]
  {T : Sylow 2 K} (d : NaturalSixControl.SourceData L W T) (hm : IntrinsicMSPair d)
local notation "J" => (L⊔d.B:Subgroup K)

theorem reducedSource_block_or_forward_span_action
    (r : CharacteristicReduction (L.subgroupOf J) (d.B.subgroupOf J)) {e : Vertex r.radical}
    (p : CriticalPath r.radical ((originalSource d hm).reduce r).geometry (alpha r.radical) e)
    (hb : ((originalSource d hm).reduce r).geometry.b r.radical=4) :
    IsAlternatingBlock L 6 ∨
      ((originalSource d hm).reduce r).ForwardSpanActionData (p.walk.getVert 2) := by
  rcases reducedSource_block_or_full_point_image d hm r with hblock|hfull
  · exact Or.inl hblock
  · right
    let s := (originalSource d hm).reduce r
    have hf : r.radical.map s.projection=Model.E.map (MulAut.conj d.relabeler.val⁻¹).toMonoidHom := by
      simpa only [Model.pointCore_eq_exceptional] using hfull
    have h := reduced_nativeCentralLayer d hm r
    exact s.forward_span_action_data h _ hf hb p
end CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup.SourceData
