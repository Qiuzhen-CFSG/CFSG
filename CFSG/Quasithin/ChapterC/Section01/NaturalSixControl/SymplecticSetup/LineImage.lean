module
public import CFSG.Quasithin.ChapterC.Section01.NaturalSixControl.SymplecticSetup.Seed
public import CFSG.Quasithin.ChapterC.Section01.NaturalSixControl.EasyCases
public import CFSG.Quasithin.ChapterC.Section01.BlockTypes.Transport

/-!
# A transposition image gives an alternating block

For the original natural six-dimensional MS pair, or a characteristic
replacement inside its actual overgroup, a radical image generated by a
transposition forces the component to be an alternating block of degree six.
C.1.24(c) gives this block or a nontrivial characteristic subgroup of the
Baumann subgroup normal in the overgroup. Characteristic transitivity and MS3
exclude the latter alternative. Subgroup equivalences transport the component
and its intrinsic two-core quotient back to the original group.

This is the transposition-image branch of Meierfrankenfeld--Stellmacher
(1993), Section 5, printed pp. 912--914; the structural input is
Aschbacher--Smith C.1.24(c).
-/

@[expose] public section
open Subgroup Theory.GroupTheory
open CFSG.Quasithin.ChapterC.BinaryMS.MS93
namespace CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup
variable {M : Type*} [Group M] [Finite M]
  {L R W : Subgroup M} [L.Normal] [W.Normal]

private theorem characteristic_map_equiv {A B : Type*} [Group A] [Group B]
    (e : A ≃* B) (C : Subgroup A) [C.Characteristic] :
    (C.map e.toMonoidHom).Characteristic := by
  apply characteristic_iff_le_comap.mpr
  intro a x hx
  obtain ⟨y,hy,rfl⟩ := hx
  let b : MulAut A := e.trans (a.trans e.symm)
  refine ⟨b y,(characteristic_iff_le_comap.mp inferInstance b) hy,?_⟩
  exact e.apply_symm_apply _

namespace Source
variable (s : Source L R W)

/-- A transposition radical image forces the component of the actual MS pair
 to be an alternating block of degree six. -/
theorem alternatingBlock_of_radical_image_swap
    (hL : L.IsCComponent) [IsQuasisimple (L ⧸ pCore 2 L)]
    (r : Equiv.Perm (Fin 6)) (hr : r.IsSwap)
    (hR : R.map s.projection = zpowers r) : IsAlternatingBlock L 6 := by
  let : IsElementaryAbelian 2 W := s.module_elementary
  have hself : centralizer (pCore 2 M : Set M) ≤ pCore 2 M :=
    (centralizer_le s.module_le_core).trans_eq s.module_centralizer
  have hf : generalizedFitting M = pCore 2 M :=
    generalizedFitting_eq_pCore_of_selfCentralizing 2 hself
  have hfL : generalizedFitting L = pCore 2 L :=
    generalizedFitting_eq_pCore_of_selfCentralizing 2
      (subnormal_core_selfCentralizing hself L hL.subnormal)
  obtain ⟨T,hRT⟩ := s.two_group.exists_le_sylow
  have hprod : ∀ m : M, ∃ l ∈ L, ∃ t ∈ (T : Subgroup M), l*t=m := by
    intro m
    obtain ⟨l,hl,t,ht,he⟩ := s.product m
    exact ⟨l,hl,t,hRT ht,he⟩
  have hm : ⁅W,L⁆ ≠ ⊥ := by
    intro hz
    have hLK : L ≤ s.projection.ker := by
      rw [s.projection_kernel, ← s.module_centralizer]
      exact commutator_eq_bot_iff_le_centralizer.mp (commutator_comm W L ▸ hz)
    have hbot : alternatingGroup (Fin 6) = ⊥ :=
      s.component_image.symm.trans ((Subgroup.map_eq_bot_iff L).mpr hLK)
    have he : Equiv.swap (0 : Fin 6) 1 * Equiv.swap 2 3 ∈ alternatingGroup (Fin 6) := by decide
    rw [hbot] at he
    exact (by decide : Equiv.swap (0 : Fin 6) 1 * Equiv.swap 2 3 ≠ 1) he
  rcases RankOne.SymmetricSix.normal_characteristic_or_alternatingBlock_of_natural_six
      L W R hL hf hfL T s.core_le hRT hprod s.projection s.component_image
      s.coordinates s.action hm r hr hR with hC | hb
  · obtain ⟨C,hC,hne,hn⟩ := hC
    let := hC
    let B := ChapterB.baumann R
    have hBR : B ≤ R := inf_le_left
    have hB : B.subgroupOf R = ChapterB.baumann (⊤ : Subgroup R) := by
      apply map_injective R.subtype_injective
      rw [map_subgroupOf_eq_of_le hBR]
      change ChapterB.baumann R = (ChapterB.baumann (⊤ : Subgroup R)).map R.subtype
      rw [RankOne.SymmetricSix.baumann_map R R.subtype R.subtype_injective,
        ← MonoidHom.range_eq_map, range_subtype]
    let : (B.subgroupOf R).Characteristic := hB ▸ ChapterB.baumann_characteristic
    let e : B ≃* B.subgroupOf R := (subgroupOfEquivOfLe hBR).symm
    let C' := C.map e.toMonoidHom
    let : C'.Characteristic := characteristic_map_equiv e C
    let D := C'.map (B.subgroupOf R).subtype
    let : D.Characteristic := inferInstance
    have hmap : D.map R.subtype = C.map B.subtype := by
      rw [map_map, map_map]
      rfl
    have hDn : (D.map R.subtype).Normal := hmap.symm ▸ hn
    have hD0 := s.characteristic.eq_bot_of_normal D hDn
    have hC0 : C.map B.subtype = ⊥ := by rw [← hmap,hD0,Subgroup.map_bot]
    exact (hne ((C.map_eq_bot_iff_of_injective B.subtype_injective).mp hC0)).elim
  · exact hb

end Source

namespace SourceData
variable {K : Type*} [Group K] [Finite K]
  {L V : Subgroup K} [L.Normal] [V.Normal] {T : Sylow 2 K}
  (d : NaturalSixControl.SourceData L V T)

/-- Apply the transposition-image branch to the literal original overgroup,
 preserving the original component and its intrinsic quotient. -/
theorem originalSource_alternatingBlock_of_radical_image_swap
    (h : IntrinsicMSPair d)
    (r : Equiv.Perm (Fin 6)) (hr : r.IsSwap)
    (hR : (d.B.subgroupOf (L ⊔ d.B)).map (originalSource d h).projection = zpowers r) :
    IsAlternatingBlock L 6 := by
  have hLJ : L ≤ L ⊔ d.B := le_sup_left
  let e : L.subgroupOf (L ⊔ d.B) ≃* L := subgroupOfEquivOfLe hLJ
  let eQ : (L.subgroupOf (L ⊔ d.B) ⧸ pCore 2 (L.subgroupOf (L ⊔ d.B))) ≃*
      (L ⧸ pCore 2 L) := QuotientGroup.congr _ _ e (pCore_map_iso 2 e)
  let : IsQuasisimple (L ⧸ pCore 2 L) := d.component_quotient_quasisimple
  let : IsQuasisimple (L.subgroupOf (L ⊔ d.B) ⧸ pCore 2 (L.subgroupOf (L ⊔ d.B))) :=
    IsQuasisimple.of_mulEquiv eQ.symm
  exact ((originalSource d h).alternatingBlock_of_radical_image_swap
    (d.component.subgroupOf hLJ) r hr hR).of_mulEquiv e

/-- Apply the transposition-image branch after characteristic replacement,
 then transport the conclusion to the original component. -/
theorem reducedSource_alternatingBlock_of_radical_image_swap
    (h : IntrinsicMSPair d)
    (c : CharacteristicReduction (L.subgroupOf (L ⊔ d.B))
      (d.B.subgroupOf (L ⊔ d.B)))
    (r : Equiv.Perm (Fin 6)) (hr : r.IsSwap)
    (hR : c.radical.map ((originalSource d h).reduce c).projection = zpowers r) :
    IsAlternatingBlock L 6 := by
  let J := L ⊔ d.B
  let L₀ := L.subgroupOf J
  have hLJ : L ≤ J := le_sup_left
  have hLc : L₀ ≤ c.overgroup := le_sup_left
  let e : L₀.subgroupOf c.overgroup ≃* L :=
    (subgroupOfEquivOfLe hLc).trans (subgroupOfEquivOfLe hLJ)
  let eQ : (L₀.subgroupOf c.overgroup ⧸ pCore 2 (L₀.subgroupOf c.overgroup)) ≃*
      (L ⧸ pCore 2 L) := QuotientGroup.congr _ _ e (pCore_map_iso 2 e)
  let : IsQuasisimple (L ⧸ pCore 2 L) := d.component_quotient_quasisimple
  let : IsQuasisimple (L₀.subgroupOf c.overgroup ⧸ pCore 2 (L₀.subgroupOf c.overgroup)) :=
    IsQuasisimple.of_mulEquiv eQ.symm
  have hcomp : (L₀.subgroupOf c.overgroup).IsCComponent :=
    (d.component.subgroupOf hLJ).subgroupOf hLc
  exact (((originalSource d h).reduce c).alternatingBlock_of_radical_image_swap
    hcomp r hr hR).of_mulEquiv e

end SourceData
end CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup
