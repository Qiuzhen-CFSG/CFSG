module
public import CFSG.Quasithin.ChapterC.Section01.NaturalSixControl.SymplecticDistanceTwo.OrbitCommutator
public import Theory.ElementaryAbelian.NormalClosureQuotient
public import Theory.GroupAction.SubgroupQuotientFullAction
public import Theory.ElementaryAbelian.VectorSpace
public import Theory.Representation.BinaryConjugationSection.ActionKernel

/-!
# The native symplectic critical-orbit quotient

The orbit A is generated by conjugates of the elementary critical plane.
The source commutator calculation puts [A,A] inside Z-alpha, so its abelian
quotient has exponent two. Literal conjugation yields a binary representation
and factors through the prescribed permutation image because O2(M) acts
trivially. The coordinate map remains the actual subgroup quotient map.

Source: Meierfrankenfeld--Stellmacher (1993), (3.6), printed p.871.
-/

@[expose] public noncomputable section
open Subgroup Stellmacher.PushingUp.AmalgamGraph
open scoped IsMulCommutative commutatorElement
open CFSG.Quasithin.ChapterC.BinaryMS.MS93
namespace CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticDistanceTwo
variable {M : Type*} [Group M] (R : Subgroup M)

def orbitLayer : Subgroup M := (Z R (alpha R)).comap (embedM R)
instance orbitLayer_normal : (orbitLayer R).Normal := SymplecticSeed.Z_comap_normal R
instance criticalOrbitNative_normal (c b : Vertex R) : (criticalOrbitNative R c b).Normal :=
  normalClosure_normal

abbrev OrbitQuotient (c b : Vertex R) :=
  criticalOrbitNative R c b ⧸ (orbitLayer R).subgroupOf (criticalOrbitNative R c b)

def orbitConjugation (c b : Vertex R) : (⊤ : Subgroup M) →* MulAut (OrbitQuotient R c b) :=
  (exists_quotient_conjugation_action ⊤ (criticalOrbitNative R c b) (orbitLayer R)
    le_normalizer_of_normal le_normalizer_of_normal inferInstance).choose

theorem orbitConjugation_mk (c b : Vertex R) (m : (⊤ : Subgroup M))
    (a : criticalOrbitNative R c b) :
    orbitConjugation R c b m
      (QuotientGroup.mk' ((orbitLayer R).subgroupOf (criticalOrbitNative R c b)) a) =
    QuotientGroup.mk' ((orbitLayer R).subgroupOf (criticalOrbitNative R c b))
      (MulAut.conjNormal (m : M) a) :=
  (exists_quotient_conjugation_action ⊤ (criticalOrbitNative R c b) (orbitLayer R)
    le_normalizer_of_normal le_normalizer_of_normal inferInstance).choose_spec m a

end CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticDistanceTwo
namespace CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup.Source
open CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticDistanceTwo
variable {M : Type*} [Group M] [Finite M]
  {L R W : Subgroup M} [L.Normal] [W.Normal] (s : Source L R W)
include s

theorem orbitLayer_le_orbit (hb : s.geometry.b R = 2) {c b : Vertex R}
    (hc : CriticalPair R (alpha R) c (s.geometry.exists_critical (alpha R) rfl))
    (hab : Adjacent R (alpha R) b) (hcb : Adjacent R c b) :
    orbitLayer R ≤ criticalOrbitNative R c b := by
  have h := comap_mono (f := embedM R) (s.Z_le_criticalOrbit hb hc hab hcb)
  simpa only [orbitLayer,criticalOrbit,comap_map_eq_self_of_injective (embedM_injective R)] using h

theorem orbit_commutator_le_layer (hb : s.geometry.b R = 2) {c b : Vertex R}
    (hc : CriticalPair R (alpha R) c (s.geometry.exists_critical (alpha R) rfl))
    (hab : Adjacent R (alpha R) b) (hcb : Adjacent R c b) :
    ⁅pCore 2 M,criticalOrbitNative R c b⁆ ≤ orbitLayer R := by
  apply map_le_iff_le_comap.mp
  rw [map_commutator,←Q_alpha R s.two_group s.core_le]
  exact s.criticalOrbit_commutator_le hb hc hab hcb

theorem orbitQuotient_elementary (hb : s.geometry.b R = 2) {c b : Vertex R}
    (hc : CriticalPair R (alpha R) c (s.geometry.exists_critical (alpha R) rfl))
    (hab : Adjacent R (alpha R) b) (hcb : Adjacent R c b)
    (hne : core R (alpha R) ≠ U R (alpha R)) :
    IsElementaryAbelian 2 (OrbitQuotient R c b) := by
  let A := criticalOrbitNative R c b
  let Y := (criticalPlane R c b).comap (embedM R)
  let := s.criticalPlane_elementary hb hc b
  let := IsElementaryAbelian.comap_of_injective (p := 2) (embedM R) (embedM_injective R)
    (criticalPlane R c b)
  have habQ : IsMulCommutative (OrbitQuotient R c b) := by
    apply Normal.quotient_commutative_iff_commutator_le.mpr
    have hcomm : ⁅A,A⁆ ≤ orbitLayer R :=
      (commutator_mono (s.criticalOrbitNative_le_core_of_core_ne hb hc hab hcb hne) le_rfl).trans
        (s.orbit_commutator_le_layer hb hc hab hcb)
    intro a ha
    apply hcomm
    rw [←map_subtype_commutator]
    exact mem_map_of_mem A.subtype ha
  change IsElementaryAbelian 2 (normalClosure (Y : Set M) ⧸
    (orbitLayer R).subgroupOf (normalClosure (Y : Set M)))
  exact normalClosure_quotient_elementary 2 Y _ habQ

theorem orbitConjugation_core_kernel (hb : s.geometry.b R = 2) {c b : Vertex R}
    (hc : CriticalPair R (alpha R) c (s.geometry.exists_critical (alpha R) rfl))
    (hab : Adjacent R (alpha R) b) (hcb : Adjacent R c b) :
    (pCore 2 M).subgroupOf ⊤ ≤ (orbitConjugation R c b).ker := by
  apply quotient_conjugation_action_kills_commutator_layer ⊤
    (criticalOrbitNative R c b) (orbitLayer R) (pCore 2 M)
    inferInstance le_normalizer_of_normal
  · rw [commutator_comm]
    exact s.orbit_commutator_le_layer hb hc hab hcb
  · exact orbitConjugation_mk R c b

end CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup.Source

namespace CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticDistanceTwo
variable {M : Type*} [Group M] (R : Subgroup M) (c b : Vertex R)
  [IsElementaryAbelian 2 (OrbitQuotient R c b)]

/-- The binary representation induced by literal conjugation on A/Z-alpha. -/
def orbitRepresentation : Representation (ZMod 2) (⊤ : Subgroup M)
    (Additive (OrbitQuotient R c b)) where
  toFun m := { (orbitConjugation R c b m).toAdditive.toAddMonoidHom with
    map_smul' := ZMod.map_smul (orbitConjugation R c b m).toAdditive.toAddMonoidHom }
  map_one' := by
    ext x
    change orbitConjugation R c b 1 x.toMul = x.toMul
    rw [map_one]
    rfl
  map_mul' m n := by
    ext x
    change orbitConjugation R c b (m*n) x.toMul =
      orbitConjugation R c b m (orbitConjugation R c b n x.toMul)
    rw [map_mul]
    rfl

/-- The coordinate map is precisely the quotient map, with only additive tags. -/
def orbitCoordinates : criticalOrbitNative R c b →*
    Multiplicative (Additive (OrbitQuotient R c b)) :=
  (MulEquiv.toMultiplicative_toAdditive (G := OrbitQuotient R c b)).toMonoidHom.comp
    (QuotientGroup.mk' ((orbitLayer R).subgroupOf (criticalOrbitNative R c b)))

/-- The marked quotient section on the original finite carrier. -/
def orbitSection (hZA : orbitLayer R ≤ criticalOrbitNative R c b) :
    Representation.BinaryConjugationSection ⊤ (criticalOrbitNative R c b) (orbitLayer R)
      (orbitRepresentation R c b) where
  section_le := le_top
  kernel_le := hZA
  normalized := le_normalizer_of_normal
  coordinates := orbitCoordinates R c b
  onto := (MulEquiv.toMultiplicative_toAdditive (G := OrbitQuotient R c b)).surjective.comp
    (QuotientGroup.mk'_surjective _)
  kernel_eq := by
    ext a
    exact QuotientGroup.eq_one_iff a
  equivariant m a := orbitConjugation_mk R c b m a |>.symm

end CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticDistanceTwo

namespace CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup.Source
open CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticDistanceTwo
variable {M : Type*} [Group M] [Finite M]
  {L R W : Subgroup M} [L.Normal] [W.Normal] (s : Source L R W)
  {c b : Vertex R}
  (hb : s.geometry.b R = 2)
  (hc : CriticalPair R (alpha R) c (s.geometry.exists_critical (alpha R) rfl))
  (hab : Adjacent R (alpha R) b) (hcb : Adjacent R c b)
  [IsElementaryAbelian 2 (OrbitQuotient R c b)]

/-- The specified map from the original vertex actor to its permutation image. -/
def orbitProjection : (⊤ : Subgroup M) →* s.projection.range :=
  s.projection.rangeRestrict.comp (⊤ : Subgroup M).subtype

omit [Finite M] in
theorem orbitProjection_surjective : Function.Surjective s.orbitProjection := by
  intro g
  obtain ⟨m,hm⟩ := g.property
  exact ⟨⟨m,mem_top m⟩,Subtype.ext hm⟩

include hb hc hab hcb in
omit [IsElementaryAbelian 2 (OrbitQuotient R c b)] in
theorem orbitProjection_kernel_le : s.orbitProjection.ker ≤ (orbitConjugation R c b).ker := by
  intro m hm
  have hmQ : (m : M) ∈ pCore 2 M := by
    rw [←s.projection_kernel]
    exact congrArg Subtype.val hm
  exact s.orbitConjugation_core_kernel hb hc hab hcb hmQ

/-- Conjugation on the original quotient, descended to the marked image in S6. -/
def orbitImageConjugation : s.projection.range →* MulAut (OrbitQuotient R c b) :=
  s.orbitProjection.liftOfSurjective s.orbitProjection_surjective
    ⟨orbitConjugation R c b,s.orbitProjection_kernel_le hb hc hab hcb⟩

omit [IsElementaryAbelian 2 (OrbitQuotient R c b)] in
theorem orbitImageConjugation_projection (m : (⊤ : Subgroup M)) :
    s.orbitImageConjugation hb hc hab hcb (s.orbitProjection m) =
      orbitConjugation R c b m :=
  MonoidHom.liftOfRightInverse_comp_apply s.orbitProjection
    (Function.surjInv s.orbitProjection_surjective)
    (Function.rightInverse_surjInv s.orbitProjection_surjective)
    ⟨orbitConjugation R c b,s.orbitProjection_kernel_le hb hc hab hcb⟩ m

def orbitImageRepresentation : Representation (ZMod 2) s.projection.range
    (Additive (OrbitQuotient R c b)) where
  toFun g := { (s.orbitImageConjugation hb hc hab hcb g).toAdditive.toAddMonoidHom with
    map_smul' := ZMod.map_smul (s.orbitImageConjugation hb hc hab hcb g).toAdditive.toAddMonoidHom }
  map_one' := by
    ext x
    change s.orbitImageConjugation hb hc hab hcb 1 x.toMul = x.toMul
    rw [map_one]
    rfl
  map_mul' g h := by
    ext x
    change s.orbitImageConjugation hb hc hab hcb (g*h) x.toMul =
      s.orbitImageConjugation hb hc hab hcb g (s.orbitImageConjugation hb hc hab hcb h x.toMul)
    rw [map_mul]
    rfl

theorem orbitImageRepresentation_projection (m : (⊤ : Subgroup M)) :
    s.orbitImageRepresentation hb hc hab hcb (s.orbitProjection m) =
      orbitRepresentation R c b m := by
  ext x
  exact congrArg (fun f : MulAut (OrbitQuotient R c b) => f x.toMul)
    (s.orbitImageConjugation_projection hb hc hab hcb m)

/-- Actual application: the elementary orbit quotient carries its marked image
representation, and pulling back gives the original conjugation section. -/
def orbitImageSection :
    Representation.BinaryConjugationSection ⊤ (criticalOrbitNative R c b) (orbitLayer R)
      ((s.orbitImageRepresentation hb hc hab hcb).comp s.orbitProjection) := by
  have he : (s.orbitImageRepresentation hb hc hab hcb).comp s.orbitProjection =
      orbitRepresentation R c b := MonoidHom.ext (s.orbitImageRepresentation_projection hb hc hab hcb)
  rw [he]
  exact orbitSection R c b (s.orbitLayer_le_orbit hb hc hab hcb)

end CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup.Source

namespace CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup.Source
open CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticDistanceTwo
variable {M : Type*} [Group M] [Finite M]
  {L R W : Subgroup M} [L.Normal] [W.Normal] (s : Source L R W)
  {c b : Vertex R}
  (hb : s.geometry.b R = 2)
  (hc : CriticalPair R (alpha R) c (s.geometry.exists_critical (alpha R) rfl))
  (hab : Adjacent R (alpha R) b) (hcb : Adjacent R c b)
  (hne : core R (alpha R) ≠ U R (alpha R))

/-- The native source supplies elementary abelianness of the quotient; it is
not an additional representation-theoretic premise. -/
def nativeOrbitImageSection :
    letI := s.orbitQuotient_elementary hb hc hab hcb hne
    Representation.BinaryConjugationSection ⊤ (criticalOrbitNative R c b) (orbitLayer R)
      ((s.orbitImageRepresentation hb hc hab hcb).comp s.orbitProjection) := by
  letI := s.orbitQuotient_elementary hb hc hab hcb hne
  exact s.orbitImageSection hb hc hab hcb

end CFSG.Quasithin.ChapterC.NaturalSixControl.SymplecticSetup.Source
