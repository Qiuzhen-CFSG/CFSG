module
public import CFSG.Quasithin.ChapterC.Section01.BlockStructure.CoreGeneration
public import Theory.GroupTheory.PGroup.OmegaCenterDetection
public import Theory.GroupTheory.PGroup.OmegaCenterIn
public import Theory.GroupTheory.PResidual.SylowSupplement
public import CFSG.Quasithin.ChapterC.Section01.BlockStructure.Commutation.CubicSetup
/-!
# A single residual block and the entire ambient core

Residual-fixed core points are detected in the Sylow omega-center. If the
residual is one short block, core squares centralize it, so zero fixed points
make the core elementary. If that entire core is residual-generated, the
block core equals its intrinsic U-layer by subnormal core action. These are
the single-component counterparts of the commuting-pair core arguments.
Source: Aschbacher--Smith C.1.7--11 and 10.2.3(4), pp.123--124 and747.
-/
public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterC
variable {G : Type*} [Group G] [Finite G]

/-- The residual-fixed part of the core is detected on the Sylow omega-center. -/
theorem core_residual_fixed_eq_bot_of_omega_center
    (T : Sylow 2 G)
    (hz : omegaCenterIn (T : Subgroup G) ⊓ center G = ⊥) :
    pCore 2 G ⊓ centralizer (pResidual 2 G : Set G) = ⊥ := by
  let C := pCore 2 G ⊓ centralizer (pResidual 2 G : Set G)
  have hCT : C ≤ (T : Subgroup G) :=
    inf_le_left.trans (pCore_isPGroup.le_sylow_of_normal T)
  have hn : (T : Subgroup G) ≤ normalizer (C : Set G) := by
    have : C.Normal := inferInstance
    exact le_normalizer_of_normal
  apply eq_bot_of_normalized_of_omega_center_disjoint (T : Subgroup G) C
    T.isPGroup' hCT hn
  apply bot_unique
  intro x hx
  have hxZ : x ∈ omegaCenterIn (T : Subgroup G) := by
    rw [omegaCenterIn_eq_omegaOneAmbient]
    exact hx.1
  have hxT : x ∈ centralizer (T : Set G) :=
    fun t ht => ((mem_omegaCenterIn_iff _ _).mp hxZ).2.1 t ht
  have hxG : x ∈ center G := by
    have hc : centralizer (pResidual 2 G : Set G) ⊓ centralizer (T : Set G) ≤
        centralizer ((pResidual 2 G ⊔ (T : Subgroup G) : Subgroup G) : Set G) :=
      le_centralizer_iff.mpr (sup_le (le_centralizer_iff.mp inf_le_left)
        (le_centralizer_iff.mp inf_le_right))
    have hh := hc ⟨hx.2.2,hxT⟩
    simpa only [pResidual_sup_sylow_eq_top T,coe_top,centralizer_univ] using hh
  exact hz.le ⟨hxZ,hxG⟩

/-- A single residual block makes all ambient core squares central. -/
theorem IsBlock.ambient_core_elementary_of_residual
    {K : Subgroup G} (hb : IsBlock K) (hK : pResidual 2 G = K)
    (hz : pCore 2 G ⊓ centralizer (pResidual 2 G : Set G) = ⊥) :
    IsElementaryAbelian 2 (pCore 2 G) := by
  have hp (x : pCore 2 G) : x ^ 2 = 1 := by
    apply Subtype.ext
    apply mem_bot.mp
    rw [←hz,hK]
    exact ⟨(pCore 2 G).pow_mem x.property 2,hb.ambient_core_square_centralizes x x.property⟩
  exact {
    is_comm := ⟨fun a b => (Commute.of_orderOf_dvd_two
      (fun x => orderOf_dvd_of_pow_eq_one (hp x)) a b).eq⟩
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr hp }

/-- A residual block generated by the full core has no extra core layer. -/
theorem IsBlock.core_eq_blockU_of_residual_core_generated
    {K : Subgroup G} (hb : IsBlock K) (hK : pResidual 2 G = K)
    (hm : pCore 2 G = ⁅pCore 2 G,pResidual 2 G⁆) :
    pCore 2 K = blockU K := by
  apply (map_injective K.subtype_injective)
  apply le_antisymm ?_ (map_mono blockU_le_core)
  calc
    (pCore 2 K).map K.subtype ≤ pCore 2 G := pCoreIn_le_of_subnormal 2 hb.subnormal
    _ = ⁅pCore 2 G,K⁆ := hm.trans (congrArg (fun A => ⁅pCore 2 G,A⁆) hK)
    _ = (blockU K).map K.subtype := hb.ambient_core_commutator
end CFSG.Quasithin.ChapterC
