module

public import CFSG.Quasithin.ChapterC.Section01.BlockStructure.Defs
public import CFSG.Quasithin.ChapterC.Section01.BlockStructure.CoreAction
public import CFSG.Quasithin.ChapterC.Section01.BlockStructure.ProductCentralizer

/-!
# Valid structural consequences of an ordered product of blocks

The actual set-product equality implies generation by its block factors.
Their two-perfection therefore passes to the product. For each factor X,
subnormal core action puts [O₂(K),X] in the embedded U(X). Since O₂(G)
fixes every U(X), generation gives O₂(G) ≤ C_G(U(K)).

The Sylow-factorization application below retains subnormality and
F*(K)=O₂(K) as explicit inputs. The latter does not follow from the
published unguarded `IsProductOfBlocks`: `Products.Obstruction` constructs
A₄ × C₃ as an actual product of two normal short blocks and disproves
both that Fitting equality and the reverse centralizer containment.
No block-commutation theorem is used here.

Source: Aschbacher--Smith, combined manuscript of 1 March 2004,
C.1.11, printed p.124, and the subnormal core-action argument of A.4.2.
-/

public section

open Subgroup Theory.GroupTheory
open scoped Pointwise
namespace CFSG.Quasithin.ChapterC
variable {G : Type*} [Group G]

private theorem one_mem_block_product (bs : List (Subgroup G)) :
    (1 : G) ∈ (bs.map (fun (X : Subgroup G) => (X : Set G))).prod := by
  induction bs with
  | nil => simp
  | cons X bs ih =>
    simpa only [List.map_cons, List.prod_cons, mul_one] using
      Set.mul_mem_mul X.one_mem ih

private theorem factor_subset_block_product (bs : List (Subgroup G))
    (X : Subgroup G) (hX : X ∈ bs) :
    (X : Set G) ⊆ (bs.map (fun (X : Subgroup G) => (X : Set G))).prod := by
  induction bs with
  | nil => simp at hX
  | cons Y bs ih =>
    rw [List.map_cons, List.prod_cons]
    rcases List.mem_cons.mp hX with rfl | hX
    · intro x hx
      simpa using Set.mul_mem_mul hx (one_mem_block_product bs)
    · intro x hx
      simpa using Set.mul_mem_mul Y.one_mem (ih hX hx)

private theorem block_product_subset (bs : List (Subgroup G)) (H : Subgroup G)
    (hH : ∀ X ∈ bs, X ≤ H) :
    (bs.map (fun (X : Subgroup G) => (X : Set G))).prod ⊆ (H : Set G) := by
  induction bs with
  | nil => simp
  | cons X bs ih =>
    simp only [List.map_cons, List.prod_cons]
    rintro _ ⟨x, hx, y, hy, rfl⟩
    exact H.mul_mem (hH X (by simp) hx) (ih (fun Y hY => hH Y (by simp [hY])) hy)

/-- An ordered block product is generated by the blocks it contains. -/
theorem IsProductOfBlocks.le_iff {K : Subgroup G} (hK : IsProductOfBlocks K)
    (H : Subgroup G) : K ≤ H ↔ ∀ X : Subgroup G, IsBlock X → X ≤ K → X ≤ H := by
  constructor
  · exact fun h _ _ hX => hX.trans h
  · intro h
    obtain ⟨bs, hbs, he⟩ := hK
    change ((bs.flatMap (fun (X : Subgroup G) => [(X : Set G)])).map (fun X => X)).prod = (K : Set G) at he
    rw [List.map_id', ← List.map_eq_flatMap] at he
    have hXK (X : Subgroup G) (hX : X ∈ bs) : X ≤ K := by
      exact SetLike.coe_subset_coe.mp (he ▸ factor_subset_block_product bs X hX)
    change (K : Set G) ⊆ (H : Set G)
    rw [← he]
    exact block_product_subset bs H (fun X hX => h X (hbs X hX) (hXK X hX))

/-- Two-perfection passes to an actual product of blocks, including the empty product. -/
theorem IsProductOfBlocks.twoPerfect {K : Subgroup G} (hK : IsProductOfBlocks K) :
    IsPPerfect 2 K := by
  have hle : K ≤ (pResidual 2 K).map K.subtype := by
    apply hK.le_iff _ |>.mpr
    intro X hX hXK
    have hp : IsPPerfect 2 (X.subgroupOf K) :=
      hX.short.twoPerfect.of_surjective (subgroupOfEquivOfLe hXK).symm.toMonoidHom
        (subgroupOfEquivOfLe hXK).symm.surjective
    have hm := map_mono (f := K.subtype) (le_pResidual_of_isPPerfect (X.subgroupOf K) hp)
    simpa only [map_subgroupOf_eq_of_le hXK] using hm
  apply (pResidual_eq_top_iff 2 K).mp
  apply (map_injective K.subtype_injective)
  rw [← MonoidHom.range_eq_map, range_subtype]
  exact le_antisymm (map_subtype_le _) hle

variable [Finite G]

/-- The ambient two-core fixes the product layer without a commutation hypothesis. -/
theorem IsProductOfBlocks.core_centralizes_blockU {K : Subgroup G}
    (hK : IsProductOfBlocks K) :
    pCore 2 G ≤ centralizer ((blockU K).map K.subtype : Set G) := by
  let Q := (pCore 2 K).map K.subtype
  let C := centralizer (pCore 2 G : Set G)
  have hKQ : K ≤ normalizer (Q : Set G) :=
    K.le_normalizer.trans (normalizer_le_normalizer_characteristic_image K (pCore 2 K))
  have hgen : K ≤ commutatorPreimage ⊤ Q C := by
    apply hK.le_iff _ |>.mpr
    intro X hX hXK
    apply le_commutatorPreimage le_top
    rw [commutator_comm]
    exact (commutator_le_core_commutator_of_isSubnormal X Q hX.subnormal
      hX.short.twoPerfect (pCore_isPGroup.map K.subtype) (hXK.trans hKQ)).trans
        (le_centralizer_iff.mp hX.core_centralizes_blockU)
  apply le_centralizer_iff.mp
  change (⁅pCore 2 K, (⊤ : Subgroup K)⁆).map K.subtype ≤ C
  rw [map_commutator, ← MonoidHom.range_eq_map, range_subtype, commutator_comm]
  exact (le_commutatorPreimage_iff ⊤ Q C K le_normalizer_of_normal).mp hgen |>.2

/-- Conditional C.1.11 application to the literal Sylow factorization. The residual
identity proves normality and the two-group quotient. The Fitting premise is
essential and is not asserted to follow from `IsProductOfBlocks`. -/
theorem IsProductOfBlocks.centralizer_eq_core_of_subnormal_of_fitting
    {K : Subgroup G} (hK : IsProductOfBlocks K) (hsub : K.IsSubnormal)
    (hf : generalizedFitting K = pCore 2 K) (S : Sylow 2 G)
    (hprod : ∀ g : G, ∃ k ∈ K, ∃ s ∈ (S : Subgroup G), k * s = g) :
    centralizer ((blockU K).map K.subtype : Set G) = pCore 2 G := by
  have he := pResidual_eq_of_subnormal_product K (S : Subgroup G)
    hsub hK.twoPerfect S.isPGroup' hprod
  have hn : K.Normal := he ▸ inferInstance
  let := hn
  have hq : IsPGroup 2 (G ⧸ K) :=
    (isPGroup_quotient_pResidual (G := G) 2).of_equiv
      (QuotientGroup.quotientMulEquivOfEq he)
  exact le_antisymm (centralizer_blockU_le_core_of_normal K hf hq)
    hK.core_centralizes_blockU

end CFSG.Quasithin.ChapterC
