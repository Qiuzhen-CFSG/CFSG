module
public import Theory.GroupTheory.PGroup.NormalDirectPowerSection
public import Theory.GroupTheory.GeneralizedFitting.ComponentCalculus
public import Theory.GroupTheory.SylowKernelQuotient
public import Theory.GroupTheory.PerfectQuotientGeneration
public import Mathlib.GroupTheory.SpecificGroups.Alternating.Simple

/-!
# The exceptional A₇ quotient and generation through its center

The kernel Sylow is the original O₂(G). Since G is generated by the normal
component L and a two-group, the remaining odd kernel lies in LO₂(G).
The component has full A₇ image, so G=LO₂(G), and its actual two-core quotient
is quasisimple. Its surjection onto A₇ has exactly the center as kernel.
Perfectness then forces every subgroup containing O₂(G) and mapping onto A₇
to be all of G. The possible central cubic cover is retained.

Source: Aschbacher–Smith C.1.24(a), printed pp.130–131, the exceptional
four-dimensional A₇ branch and its selected five-point preimage.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterC.RankOne.SevenSource.Exceptional
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
/-- The given kernel Sylow places the original two-core inside the action kernel. -/
theorem core_le_kernel (q : G →* alternatingGroup (Fin 7))
    (P : Sylow 2 q.ker) (hP : (P : Subgroup q.ker).map q.ker.subtype=pCore 2 G) :
    pCore 2 G ≤ q.ker := hP ▸ map_subtype_le (P : Subgroup q.ker)

/-- Full component image and the odd kernel force G=LO₂(G). -/
theorem component_sup_core_eq_top (L T : Subgroup G) [L.Normal]
    (q : G →* alternatingGroup (Fin 7)) (hLq : L.map q=⊤)
    (hT : IsPGroup 2 T) (hgen : L ⊔ T=⊤)
    (P : Sylow 2 q.ker) (hP : (P : Subgroup q.ker).map q.ker.subtype=pCore 2 G) :
    L ⊔ pCore 2 G=⊤ := by
  have hker := kernel_le_normal_sup_of_kernel_sylow q (pCore 2 G) L T P hP hT hgen
  have hs : L ⊔ q.ker=⊤ := by
    have hh := congrArg (Subgroup.comap q) hLq
    simpa only [comap_map_eq,comap_top] using hh
  apply top_unique
  rw [←hs]
  exact sup_le le_sup_left hker

/-- The intrinsic component quotient is the full original two-core quotient. -/
theorem quotient_isQuasisimple (L T : Subgroup G) [L.Normal]
    [IsQuasisimple (L ⧸ pCore 2 L)]
    (q : G →* alternatingGroup (Fin 7)) (hLq : L.map q=⊤)
    (hT : IsPGroup 2 T) (hgen : L ⊔ T=⊤)
    (P : Sylow 2 q.ker) (hP : (P : Subgroup q.ker).map q.ker.subtype=pCore 2 G) :
    IsQuasisimple (G ⧸ pCore 2 G) := by
  let π := QuotientGroup.mk' (pCore 2 G)
  have hL : L.map π=⊤ := by
    have hh := congrArg (Subgroup.map π) (component_sup_core_eq_top L T q hLq hT hgen P hP)
    have hQπ : (pCore 2 G).map π=⊥ := (Subgroup.map_eq_bot_iff _).mpr
      (by rw [QuotientGroup.ker_mk'])
    simpa only [Subgroup.map_sup,hQπ,sup_bot_eq,map_top_of_surjective π (QuotientGroup.mk'_surjective _)] using hh
  let e : (L ⧸ pCore 2 L) ≃* (G ⧸ pCore 2 G) :=
    ((inferInstance : L.Normal).isSubnormal.quotientCoreImageEquiv 2).trans
      ((MulEquiv.subgroupCongr hL).trans topEquiv)
  exact IsQuasisimple.of_mulEquiv e

omit [Finite G] in
/-- The literal quotient lift remains surjective. -/
theorem quotient_lift_surjective (q : G →* alternatingGroup (Fin 7))
    (hq : Function.Surjective q) (hQ : pCore 2 G ≤ q.ker) :
    Function.Surjective (QuotientGroup.lift (pCore 2 G) q hQ) := by
  intro y
  obtain ⟨g,rfl⟩ := hq y
  exact ⟨QuotientGroup.mk' (pCore 2 G) g,rfl⟩

/-- The actual lifted action kernel is the whole center, including a cubic cover. -/
theorem quotient_lift_ker_eq_center (L T : Subgroup G) [L.Normal]
    [IsQuasisimple (L ⧸ pCore 2 L)]
    (q : G →* alternatingGroup (Fin 7)) (hq : Function.Surjective q) (hLq : L.map q=⊤)
    (hT : IsPGroup 2 T) (hgen : L ⊔ T=⊤)
    (P : Sylow 2 q.ker) (hP : (P : Subgroup q.ker).map q.ker.subtype=pCore 2 G)
    (hQ : pCore 2 G ≤ q.ker) :
    (QuotientGroup.lift (pCore 2 G) q hQ).ker=center (G ⧸ pCore 2 G) := by
  let : IsQuasisimple (G ⧸ pCore 2 G) := quotient_isQuasisimple L T q hLq hT hgen P hP
  let := alternatingGroup.isSimpleGroup (by simp : 5 ≤ Nat.card (Fin 7))
  let : IsQuasisimple (alternatingGroup (Fin 7)) := {
    toIsPerfect := ⟨commutator_alternatingGroup_eq_top (by simp)⟩
    simple := ((QuotientGroup.quotientMulEquivOfEq
      (alternatingGroup.center_eq_bot (by simp))).trans QuotientGroup.quotientBot).isSimpleGroup }
  let c : Covering (G ⧸ pCore 2 G) (alternatingGroup (Fin 7)) :=
    ⟨QuotientGroup.lift (pCore 2 G) q hQ,quotient_lift_surjective q hq hQ⟩
  exact c.ker_eq_center_of_isSimple

/-- Full alternating image generates the original group above its original two-core. -/
theorem eq_top_of_full_alternating_image (L T : Subgroup G) [L.Normal]
    [IsQuasisimple (L ⧸ pCore 2 L)]
    (q : G →* alternatingGroup (Fin 7)) (hq : Function.Surjective q) (hLq : L.map q=⊤)
    (hT : IsPGroup 2 T) (hgen : L ⊔ T=⊤)
    (P : Sylow 2 q.ker) (hP : (P : Subgroup q.ker).map q.ker.subtype=pCore 2 G)
    (H : Subgroup G) (hQH : pCore 2 G ≤ H) (hH : H.map q=⊤) : H=⊤ := by
  let : IsQuasisimple (G ⧸ pCore 2 G) := quotient_isQuasisimple L T q hLq hT hgen P hP
  let B := (⊤ : Subgroup (G ⧸ pCore 2 G))
  let : IsQuasisimple B := IsQuasisimple.of_mulEquiv
    (topEquiv : B ≃* (G ⧸ pCore 2 G)).symm
  have hQ := core_le_kernel q P hP
  have hc : q.ker.map (QuotientGroup.mk' (pCore 2 G)) ≤ (center B).map B.subtype := by
    rw [←QuotientGroup.ker_lift (pCore 2 G) q hQ,
      quotient_lift_ker_eq_center L T q hq hLq hT hgen P hP hQ]
    intro x hx
    refine ⟨⟨x,mem_top x⟩,?_,rfl⟩
    exact mem_center_iff.mpr (fun y => Subtype.ext (mem_center_iff.mp hx y))
  exact eq_top_of_perfect_quotient_image (pCore 2 G) q H hQH B hc hH
end CFSG.Quasithin.ChapterC.RankOne.SevenSource.Exceptional
