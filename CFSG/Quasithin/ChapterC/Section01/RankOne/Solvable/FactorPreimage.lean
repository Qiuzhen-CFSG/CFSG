module
public import CFSG.Quasithin.ChapterB.Section01.SolvableStructure.OffenderProducts.Internal
public import CFSG.Quasithin.ChapterC.Section01.RankOne.Solvable.MinimalParabolic.AlternatingThree
public import Theory.Representation.NormalElementaryQuotient.MovedCoordinates
public import Theory.Representation.BinaryOffender.Stability
public import Theory.GroupTheory.CComponent.QuotientLifting
public import Theory.ElementaryAbelian.Injective
public import Theory.GroupTheory.PResidual.NormalSylowCommutator
public import Theory.GroupTheory.PResidual.PCoreQuotient
public import Theory.GroupTheory.SelfCentralizingCoreInheritance
public import Theory.GroupTheory.SpecificGroups.SLTwoPermThree
public import Theory.SpecificGroups.SymmetricThree.CubicSelection

/-!
# Original natural-factor preimages with elementary two-core

Suppose the full two-core is the elementary module of a faithful solvable
FF quotient action. The preimage of each actual S₃ factor has an A₃-block
two-residual. Subnormality passes characteristic two to that residual.
Its normal Sylow two-subgroup is generated by commutators, so its embedded
core lies in the original natural four-space. Characteristic two rules out
core orders one and two, leaving the elementary four-core and cubic quotient.

The source application is 13.2.11(5): once the original outside core equals
its omega orbit, these are the same factor preimages used in its point
amalgam. No splitting or unmarked group identification is assumed.
Source: Aschbacher--Smith 13.2.8--11, printed pp.880--881.
-/

public section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterC.RankOne.Solvable

/-- The literal preimage of each natural S₃ factor has A₃-block two-residual
when the elementary action module is the full self-centralizing two-core. -/
theorem factor_preimage_residual_alternatingThree
    {X Q : Type*} [Group X] [Finite X] [Group Q] [Finite Q]
    (U : Subgroup X) [U.Normal] [IsElementaryAbelian 2 U]
    (q : X →* Q) (hq : Function.Surjective q)
    (hk : q.ker = centralizer (U : Set X)) (hcore : pCore 2 X = U)
    (hker : q.ker = U)
    (hself : centralizer (pCore 2 X : Set X) ≤ pCore 2 X)
    (c : ChapterB.SolvableFFFactors (NormalElementaryQuotient.representation U q hq hk))
    (i : Fin c.count) :
    ChapterC.IsAlternatingBlock (pResidual 2 ((c.factor i).comap q)) 3 := by
  let A := (c.factor i).comap q
  let R := pResidual 2 A
  let f := A.subtype.comp R.subtype
  have hf : Function.Injective f := A.subtype_injective.comp R.subtype_injective
  let g : A →* c.factor i := (q.comp A.subtype).codRestrict (c.factor i) (fun a => a.property)
  have hg : Function.Surjective g := by
    intro b
    obtain ⟨a,ha⟩ := hq b
    exact ⟨⟨a,by change q a ∈ c.factor i; rw [ha]; exact b.property⟩,Subtype.ext ha⟩
  have hgker : g.ker = U.subgroupOf A := by
    ext a
    change g a = 1 ↔ (a : X) ∈ U
    constructor
    · intro he
      exact hker ▸ (MonoidHom.mem_ker.mpr (congrArg Subtype.val he) : (a : X) ∈ q.ker)
    · intro ha
      have ha' : (a : X) ∈ q.ker := hker.symm ▸ ha
      exact Subtype.ext (MonoidHom.mem_ker.mp ha')
  have hg2 : IsPGroup 2 g.ker := by
    rw [hgker]
    exact (IsElementaryAbelian.isPGroup 2 U).comap_subtype
  obtain ⟨es⟩ := SLTwoPermThree.sl2Two_equiv_perm_three
  let e := (c.factorModel i).trans es
  let eR := ((pResidual 2 (c.factor i)).equivMapOfInjective e.toMonoidHom e.injective).trans
    (MulEquiv.subgroupCongr (map_pResidual_of_surjective 2 e.toMonoidHom e.surjective))
  have hthree : Nat.card (pResidual 2 (c.factor i)) = 3 :=
    (Nat.card_congr eR.toEquiv).trans
      Theory.SpecificGroups.SymmetricThree.CubicSelection.residual_card
  have hoddcore : pCore 2 (pResidual 2 (c.factor i)) = ⊥ := by
    apply card_eq_one.mp
    rcases (pCore_isPGroup (p := 2) (G := pResidual 2 (c.factor i))).card_eq_or_dvd with h|h
    · exact h
    · have hh := h.trans (pCore 2 (pResidual 2 (c.factor i))).card_subgroup_dvd_card
      rw [hthree] at hh
      norm_num at hh
  have hquot : Nat.card (R ⧸ pCore 2 R) = 3 := by
    rw [Nat.card_congr (g.pResidualCoreQuotientEquiv hg hg2).toEquiv,hoddcore]
    exact (Nat.card_congr (QuotientGroup.quotientBot).toEquiv).trans hthree
  have hsub : A.IsSubnormal := by
    let := offenderSubgroup_normal (NormalElementaryQuotient.representation U q hq hk)
    exact (IsSubnormal.step _ _ (c.factor_le_offenderSubgroup i)
      (inferInstance : (offenderSubgroup _).Normal).isSubnormal
      (c.factor_normal_in_offenderSubgroup i)).comap q
  have hchar := normal_core_selfCentralizing (subnormal_core_selfCentralizing hself A hsub) R
  let D := (pCore 2 R).map f
  have hDU : D ≤ U := by
    rw [←hcore]
    have hR : (pCore 2 R).map R.subtype ≤ pCore 2 A :=
      le_sSup ⟨inferInstance,pCore_isPGroup.map _⟩
    exact (map_map _ _ _).ge.trans ((map_mono hR).trans (pCoreIn_le_of_subnormal 2 hsub))
  let S : Sylow 2 R := (pCore_isPGroup (p := 2) (G := R)).toSylow (by
    change ¬2 ∣ Nat.card (R ⧸ pCore 2 R)
    rw [hquot]
    decide)
  let : (S : Subgroup R).Normal := inferInstanceAs (pCore 2 R).Normal
  have hcomm : pCore 2 R = ⁅pCore 2 R,⊤⁆ :=
    normalSylow_eq_commutator_of_isPPerfect (isPPerfect_pResidual 2) S
  have hD : D ≤ ⁅U,A⁆ := by
    have hm := congrArg (map f) hcomm
    rw [map_commutator] at hm
    exact hm.le.trans (commutator_mono hDU (by
      rw [←MonoidHom.range_eq_map,MonoidHom.range_comp,range_subtype]
      exact map_subtype_le _))
  have hfour : Nat.card (⁅U,A⁆ : Subgroup X) = 4 := by
    let : IsElementaryAbelian 2 (⁅U,A⁆ : Subgroup X) :=
      IsElementaryAbelian.of_injective (inclusion (commutator_le_left U A))
        (inclusion_injective _)
    have he := NormalElementaryQuotient.movedEquiv U q hq hk A
    have hh := Module.natCard_eq_pow_finrank (K := ZMod 2)
      (V := subspaceCommutator (NormalElementaryQuotient.representation U q hq hk) ⊤ (A.map q))
    rw [show A.map q = c.factor i from map_comap_eq_self_of_surjective hq _,
      c.support_finrank,Nat.card_zmod] at hh
    have hec := Nat.card_congr he.toEquiv
    rw [show A.map q = c.factor i from map_comap_eq_self_of_surjective hq _] at hec
    exact hec.trans hh
  have hbound : Nat.card (pCore 2 R) ≤ 4 := by
    have hh := card_le_of_le hD
    rw [card_map_of_injective hf,hfour] at hh
    exact hh
  have hsmall : Nat.card (pCore 2 R) = 1 ∨ Nat.card (pCore 2 R) = 2 ∨
      Nat.card (pCore 2 R) = 4 := by
    have hpos := Nat.card_pos (α := pCore 2 R)
    rcases (pCore_isPGroup (p := 2) (G := R)).card_eq_or_dvd with h|h
    · exact Or.inl h
    · omega
  have hfourcore : Nat.card (pCore 2 R) = 4 := by
    rcases hsmall with h|h|h
    · have he : pCore 2 R = ⊥ := card_eq_one.mp h
      have ht : pCore 2 R = ⊤ := top_unique (by
        intro x _
        apply hchar
        intro a ha
        have ha1 : a = 1 := he.le ha
        simp only [ha1,one_mul,mul_one])
      rw [ht] at hquot
      simp at hquot
    · have hc := central_of_normal_card_two (pCore 2 R) h
      have ht : pCore 2 R = ⊤ := top_unique (le_trans (le_centralizer_iff.mp
        (hc.trans (center_le_centralizer _))) hchar)
      rw [ht] at hquot
      simp at hquot
    · exact h
  let j : pCore 2 R →* U := (f.comp (pCore 2 R).subtype).codRestrict U
    (fun x => hDU (mem_map_of_mem f x.property))
  have hj : Function.Injective j := fun a b h => Subtype.ext
    (hf (congrArg (fun x : U => (x : X)) h))
  exact ChapterC.RankOne.Solvable.MinimalParabolic.alternatingThree_of_elementary_four_core
    (isPPerfect_pResidual 2) (IsElementaryAbelian.of_injective j hj) hfourcore hquot

end CFSG.Quasithin.ChapterC.RankOne.Solvable
