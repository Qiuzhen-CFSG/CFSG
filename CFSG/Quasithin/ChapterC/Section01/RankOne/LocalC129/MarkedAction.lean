module
public import CFSG.Quasithin.ChapterC.Section01.BlockTypes.InnerMarking
public import Theory.SpecificGroups.Alternating.SevenComponent.Extension
public import Theory.GroupTheory.SylowSubnormalIntersection
public import GorensteinWalter.A7SylowCentralizer

/-!
# A Sylow marking of the actual seven-letter block action

Conjugacy of Sylow two-groups in A₇ supplies a (4,2)-element in the given
Sylow image. An inner relabelling preserves the block module and makes
that element the standard marked permutation. The normal quotient action
then extends to the original group, with kernel exactly its two-core when
the group is generated by the normal block and the original Sylow subgroup.

Source: the representation on seven letters in C.1.29, printed p.134.
-/
public section
open Subgroup
namespace CFSG.Quasithin.ChapterC.LocalC129
variable {G V : Type*} [Group G] [Finite G] [Group V]

theorem exists_inner_marked_action (T : Sylow 2 G) (K : Subgroup G) [K.Normal]
    {rho : alternatingGroup (Fin 7) →* MulAut V}
    (model : BlockModuleModel K rho)
    (hgen : K ⊔ (T : Subgroup G) = ⊤) :
    ∃ (a : alternatingGroup (Fin 7)) (f : G →* Equiv.Perm (Fin 7)),
      (∀ k : K, f k = ((model.innerMarking a).quotientIso
        (QuotientGroup.mk' (pCore 2 K) k)).val) ∧
      f.ker = pCore 2 G ∧ GorensteinWalter.d8rho ∈ (T : Subgroup G).map f := by
  obtain ⟨S, hS⟩ := T.exists_subgroupOf_eq_of_subnormal K (inferInstance : K.Normal).isSubnormal
  let q : K →* alternatingGroup (Fin 7) :=
    model.quotientIso.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 K))
  have hq : Function.Surjective q := model.quotientIso.surjective.comp (QuotientGroup.mk'_surjective _)
  obtain ⟨b, hb, hbc⟩ := GorensteinWalter.exists_mem_sylow_isConj_a7rho (S.mapSurjective hq)
  obtain ⟨a, ha⟩ := isConj_iff.mp hbc
  obtain ⟨s, hs, hsb⟩ := hb
  have hsT : (s : G) ∈ (T : Subgroup G) := by
    rw [hS] at hs
    exact hs
  obtain ⟨f, hf⟩ := alternatingGroup.SevenComponent.exists_extension K (model.innerMarking a).quotientIso
  refine ⟨a, f, hf, ?_, ?_⟩
  · exact alternatingGroup.SevenComponent.extension_kernel_eq_twoCore K
      (model.innerMarking a).quotientIso
      (isPGroup_quotient_of_sup_eq_top K (T : Subgroup G) T.isPGroup' hgen) f hf
  · refine mem_map.mpr ⟨s, hsT, ?_⟩
    rw [hf]
    change (MulAut.conj a (q s)).val = GorensteinWalter.d8rho
    rw [hsb]
    exact congrArg Subtype.val ha
end CFSG.Quasithin.ChapterC.LocalC129
