module
public import CFSG.Quasithin.ChapterC.Section01.RankOne.LocalC129.CubicPreimage
public import CFSG.Quasithin.ChapterC.Section01.RankOne.LocalC129.MarkedAction
public import CFSG.Quasithin.ChapterC.Section01.RankOne.LocalC129.ThirdNontrivial

/-!
# The ordinary A₇ source geometry for C.1.29

For the original strongly quasithin group generated by an ordinary A₇
block and its Sylow two-subgroup, the block is normal. The prescribed
module and Sylow conjugacy construct a literal seven-letter action. Its
kernel is the original two-core, its image contains A₇, and the Sylow
subgroup fixes the last point. The actual A₄ residual of the complementary
cubic preimage is normalized by the Sylow subgroup and centralizes its
nontrivial characteristic third lower-central term. Thus C(G,T) moves
that fixed point. Every assertion is derived from the original block;
no orbit, residual, commutation, or fixed-layer certificate is assumed.

Source: the ordinary A₇ contradiction in C.1.29, printed p.134.
-/
public section
open Subgroup
open BinaryPermutation.SevenCubic
namespace CFSG.Quasithin.ChapterC.LocalC129
variable {G : Type*} [Group G] [Finite G]

/-- In the actual ordinary A₇ extension, the original control subgroup
moves the point fixed by the original Sylow group. -/
theorem alternating_seven_control_geometry
    (hs : IsStronglyQuasithin G) (T : Sylow 2 G)
    {K : Subgroup G} (hK : IsBlock K) (ha : IsAlternatingBlock K 7)
    (hgen : K ⊔ (T : Subgroup G) = ⊤) :
    ∃ f : G →* Equiv.Perm (Fin 7), f.ker = pCore 2 G ∧
      alternatingGroup (Fin 7) ≤ f.range ∧
      (T : Subgroup G) ≤ (MulAction.stabilizer (Equiv.Perm (Fin 7)) (6 : Fin 7)).comap f ∧
      ¬(T : Subgroup G).characteristicNormalizerClosure ≤
        (MulAction.stabilizer (Equiv.Perm (Fin 7)) (6 : Fin 7)).comap f := by
  let : K.Normal := alternating_seven_normal hs hK ha
  obtain ⟨rho, ⟨model⟩, hact⟩ := ha.2.2
  obtain ⟨a, f, hf, hk, hr⟩ := exists_inner_marked_action T K model hgen
  let m := model.innerMarking a
  obtain ⟨Y, _, ⟨eY⟩, hTY, hYm⟩ := cubic_preimage_four hK rho m hact
    f hf hk (T : Subgroup G) T.isPGroup' hr
  have hYC : Y ≤ (T : Subgroup G).characteristicNormalizerClosure :=
    normalized_four_le_control hs T hK ha Y _ hTY eY le_rfl
  refine ⟨f, hk, alternatingGroup.SevenComponent.alternating_le_range K m.quotientIso f hf, ?_, ?_⟩
  · intro t ht
    change f t 6 = 6
    exact alternatingGroup.SevenComponent.fixes_last_of_rho_mem _ (T.isPGroup'.map f) hr
      (f t) (mem_map.mpr ⟨t, ht, rfl⟩)
  · intro hle
    have hc : cycle ∈ Y.map f := hYm.symm ▸ mem_zpowers cycle
    obtain ⟨y, hy, hfy⟩ := hc
    have hfix := hle (hYC hy)
    change f y 6 = 6 at hfix
    rw [hfy] at hfix
    exact (by decide : cycle 6 ≠ 6) hfix
end CFSG.Quasithin.ChapterC.LocalC129
