module
public import CFSG.Quasithin.ChapterC.Section01.RankOne.ChiProduct.SelectedRankOne.ComponentSelection
public import CFSG.Quasithin.ChapterC.Section01.RankOne.ChiProduct.SelectedRankOne.Parabolic
public import Theory.GroupTheory.SelfCentralizingCorePGroupJoin
/-!
# Geometry of the genuine selected component

The actual component image gives movement; characteristic two passes
to the component and its normalizing Baumann join. Its intrinsic Frattini
kernel supplies minimal-parabolicity above the same Baumann Sylow group.

Source: Aschbacher–Smith C.1.26 and B.6.10, pp.132 and117.
-/
public section
open Subgroup Theory.GroupTheory Stellmacher
namespace CFSG.Quasithin.ChapterC.RankOne.ChiProduct.SelectedRankOne
open ChapterB
variable {G D : Type*} [Group G] [Finite G] [Group D] [Finite D]

omit [Finite D] in
/-- A normalized C-component is generated by the original actor as soon as
its actual image commutator is nonsolvable. -/
theorem component_moved_of_image
    (q : G →* D) (L J : Subgroup G) (hL : L.IsCComponent)
    (hJL : J ≤ normalizer (L : Set G))
    (hmove : ⁅L.map q,J.map q⁆ = L.map q)
    (hnsol : ¬ Group.IsSolvable (L.map q)) : L = ⁅L,J⁆ := by
  let K := ⁅L,J⁆
  have hKL : K ≤ L := le_normalizer_iff_commutator_le_left.mp hJL
  let N := K.subgroupOf L
  let : N.Normal := normal_subgroupOf_of_le_normalizer (normalizer_commutator_ge_left L J)
  by_contra hn
  have hproper : N ≠ ⊤ := by
    intro he
    exact hn (le_antisymm (subgroupOf_eq_top.mp he) hKL)
  let : Group.IsSolvable N := hL.isSolvable_of_subnormal_lt_top
    (inferInstance : N.Normal).isSubnormal hproper
  let : Group.IsSolvable K := Group.isSolvable_of_surjective
    (f := (subgroupOfEquivOfLe hKL).toMonoidHom) (subgroupOfEquivOfLe hKL).surjective
  have he : K.map q = L.map q := (map_commutator L J q).trans hmove
  have hs : Group.IsSolvable (K.map q) := Group.isSolvable_of_surjective
    (q.subgroupMap_surjective K)
  exact hnsol (he ▸ hs)

/-- The selected component with the original Baumann group is of
characteristic two; no action-kernel deletion is needed. -/
theorem component_baumann_fitting
    (T : Sylow 2 G) (L : Subgroup G) (hL : L.IsSubnormal)
    (hBL : baumann (T : Subgroup G) ≤ normalizer (L : Set G))
    (hfit : generalizedFitting G = pCore 2 G) :
    generalizedFitting (L ⊔ baumann (T : Subgroup G) : Subgroup G) =
      pCore 2 (L ⊔ baumann (T : Subgroup G) : Subgroup G) := by
  apply (ChapterA.generalizedFitting_eq_pCore_iff 2).mpr
  exact centralizer_pCore_sup_le 2 L (baumann (T : Subgroup G))
    (subnormal_core_selfCentralizing ((ChapterA.generalizedFitting_eq_pCore_iff 2).mp hfit) L hL)
    (T.isPGroup'.to_le inf_le_left) hBL

open scoped MatrixGroups
/-- The original Baumann Sylow subgroup in the selected component join is
minimal parabolic, using the component's own proved Frattini kernel. -/
theorem component_baumann_minimal
    (F : Type*) [Field F] [Finite F] [CharP F 2]
    (T : Sylow 2 G) (q : G →* D) (h2 : pCore 2 D = ⊥)
    (L : Subgroup G) [IsQuasisimple (L ⧸ pCore 2 L)]
    (hA : IsComponent D (L.map q)) (e : L.map q ≃* SL(2,F))
    (hBL : baumann (T : Subgroup G) ≤ normalizer (L : Set G))
    (hs : Chapter1.IsSylowIn 2 (baumann (T : Subgroup G))
      (L ⊔ baumann (T : Subgroup G))) :
    ∃ S : Sylow 2 (L ⊔ baumann (T : Subgroup G) : Subgroup G),
      (inclusion (show baumann (T : Subgroup G) ≤ L ⊔ baumann (T : Subgroup G)
        from le_sup_right)).range = S ∧ IsMinimalParabolicOver S ⊤ := by
  let B := baumann (T : Subgroup G)
  let N := L ⊔ B
  let A := L.subgroupOf N
  let : A.Normal := normal_subgroupOf_of_le_normalizer (sup_le L.le_normalizer hBL)
  let i : A ≃* L := subgroupOfEquivOfLe (show L ≤ N from le_sup_left)
  let f : A →* SL(2,F) := e.toMonoidHom.comp ((q.subgroupMap L).comp i.toMonoidHom)
  have hf : Function.Surjective f := e.surjective.comp
    ((q.subgroupMap_surjective L).comp i.surjective)
  have hfr := component_action_kernel q h2 L hA
  have hfker : f.ker ≤ (frattini (A ⧸ pCore 2 A)).comap (QuotientGroup.mk' (pCore 2 A)) := by
    have hik : IsPGroup 2 i.toMonoidHom.ker := by
      rw [(MonoidHom.ker_eq_bot_iff i.toMonoidHom).mpr i.injective]
      exact IsPGroup.of_subsingleton 2 _
    rw [← i.toMonoidHom.comap_frattini_pCore_of_pKernel i.surjective hik]
    intro a ha
    have hqa : q (i a : G) = 1 := by
      have hh : e ((q.subgroupMap L) (i a)) = e 1 := by
        change f a = 1 at ha
        exact ha.trans (map_one e.toMonoidHom).symm
      exact congrArg Subtype.val (e.injective hh)
    obtain ⟨x,hx,he⟩ := hfr ⟨(i a).property,hqa⟩
    have he' : x = i a := Subtype.ext he
    change i a ∈ (frattini (L ⧸ pCore 2 L)).comap (QuotientGroup.mk' (pCore 2 L))
    exact he' ▸ hx
  obtain ⟨S,hS⟩ := hs
  have hSN : (S : Subgroup N) = B.subgroupOf N := by
    apply map_injective N.subtype_injective
    rw [map_subgroupOf_eq_of_le (show B ≤ N from le_sup_right)]
    exact hS
  have hAS : A ⊔ (S : Subgroup N) = ⊤ := by
    apply map_injective N.subtype_injective
    rw [Subgroup.map_sup,hS,map_subgroupOf_eq_of_le (show L ≤ N from le_sup_left),
      ←MonoidHom.range_eq_map,range_subtype]
  refine ⟨S,?_,minimal_over_normal_rankOne_frattini F A S hAS f hf hfker⟩
  rw [hSN]
  ext x
  constructor
  · rintro ⟨b,rfl⟩
    exact b.property
  · intro hx
    exact ⟨⟨x,hx⟩,rfl⟩
end CFSG.Quasithin.ChapterC.RankOne.ChiProduct.SelectedRankOne
