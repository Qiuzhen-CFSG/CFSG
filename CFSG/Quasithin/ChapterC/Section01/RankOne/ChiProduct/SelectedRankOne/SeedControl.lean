module
public import CFSG.Quasithin.ChapterC.Section01.RankOne.ChiProduct.SelectedRankOne.BlockSelection
public import CFSG.Quasithin.ChapterC.Section01.RankOne.ChiProduct.SelectedRankOne.UniformPair
public import Theory.GroupTheory.ReducedNormal.SylowCenterClosure

/-!
# Rank-one pushing-up with the original central seed and Baumann control

A reduced module generated by a subgroup of the Sylow omega-center need
not be its full span. The natural-action alpha decomposition nevertheless
makes their residual commutators equal. Reducedness then identifies their
action centralizers. Thus the original quotient and natural coordinates
supply C.1.17 without replacing or strengthening the seed hypothesis.

Each escaping C.1.18 alternative normalizes a nontrivial characteristic
subgroup of the actual Baumann subgroup. Its characteristic-normalizer
control suffices to select the residual block; control of the full Sylow
characteristic-normalizer closure is not needed. This is the precise local
transfer used in the nonblock argument of 15.1.20(2).

Source: Aschbacher--Smith B.6.10, C.1.18, C.1.26 and 15.1.20(2),
printed pp.117,126,132,1094--1095.
-/

public section

open Subgroup Stellmacher Theory.GroupTheory
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.ChapterC.RankOne.ChiProduct.SelectedRankOne
open ChapterB GlaubermanNiles
universe u
variable {G : Type u} [Group G] [Finite G]

/-- Enlarging the original central seed preserves the moved subgroup and its action kernel. -/
theorem seed_omega_comparison (T : Sylow 2 G) (U : Subgroup G)
    [U.Normal] [IsElementaryAbelian 2 U] (hU : IsPReduced 2 U)
    (hfit : generalizedFitting G = pCore 2 G)
    (hseed : U ≤ normalClosure (omegaOneCenterAmbient (T : Subgroup G) : Set G))
    (ha : thompsonAlpha (T : Subgroup G) ≤ ⁅U,pResidual 2 G⁆ ⊔
      (thompsonAlpha (T : Subgroup G) ⊓ centralizer (pResidual 2 G : Set G))) :
    let V := normalClosure (omegaOneCenterAmbient (T : Subgroup G) : Set G)
    ⁅V,pResidual 2 G⁆ = ⁅U,pResidual 2 G⁆ ∧
      centralizer (V : Set G) = centralizer (U : Set G) := by
  let V := normalClosure (omegaOneCenterAmbient (T : Subgroup G) : Set G)
  let X := pResidual 2 G
  let W := ⁅U,X⁆
  let D := thompsonAlpha (T : Subgroup G) ⊓ centralizer (X : Set G)
  have hgen := pResidual_sup_sylow_eq_top T
  have hTD : (T : Subgroup G) ≤ normalizer (D : Set G) :=
    (le_inf (alpha_normalized (T : Subgroup G))
      (le_normalizer_of_normal : (T : Subgroup G) ≤ normalizer (centralizer (X : Set G) : Set G))).trans
        inf_normalizer_le_normalizer_inf
  have hXD : X ≤ normalizer (D : Set G) :=
    (le_centralizer_iff.mp (show D ≤ centralizer (X : Set G) from inf_le_right)).trans
      (Subgroup.centralizer_le_normalizer _)
  let : D.Normal := normalizer_eq_top_iff.mp (top_unique (hgen ▸ sup_le hXD hTD))
  have hVWD : V ≤ W ⊔ D := normalClosure_le_normal
    ((omegaCenter_le_omegaCenter_maxJ (T : Subgroup G)).trans ha)
  have hmove : ⁅V,X⁆ = W := by
    apply le_antisymm
    · apply (commutator_mono hVWD le_rfl).trans
      apply commutator_le.mpr
      intro v hv x hx
      obtain ⟨w,hw,d,hd,rfl⟩ := mem_sup_of_normal_left.mp hv
      have he : ⁅d,x⁆ = 1 := commutatorElement_eq_one_iff_mul_comm.mpr
        (hd.2 x hx).symm
      rw [commutatorElement_mul_left_eq_conj_mul,he]
      simpa only [mul_one,mul_inv_cancel,mul_one,one_mul] using
        (commutator_le_left W X (commutator_mem_commutator hw hx))
    · exact commutator_mono hseed le_rfl
  have hV := omegaCenter_normalClosure_reduced T
    ((ChapterA.generalizedFitting_eq_pCore_iff 2).mp hfit)
  let : IsElementaryAbelian 2 V := hV.elementary
  refine ⟨hmove,?_⟩
  rw [←hV.centralizer_moved_eq V,←hU.centralizer_moved_eq U,hmove]

/-- Eliminate both pair alternatives using only control of Baum(T). -/
theorem blockAlternative_of_baumann_control
    (T : Subgroup G) (N M : Subgroup G) (hBN : baumann T ≤ N)
    (hcpu : (baumann T).characteristicNormalizerClosure ≤ M) (hout : ¬ N ≤ M)
    (P : CharacteristicPair (baumann T)) (hP : P.Universal.{u,u})
    (hlocal : InLocalClass (inclusion hBN)) : BlockAlternative N := by
  have kill (D : Subgroup (baumann T)) [D.Characteristic] (hne : D ≠ ⊥)
      (hn : (D.map (inclusion hBN)).Normal) : False := by
    let : (D.map (inclusion hBN)).Normal := hn
    have hN : N ≤ normalizer (D.map (baumann T).subtype : Set G) := by
      have h := (D.map (inclusion hBN)).le_normalizer_map N.subtype
      rw [normalizer_eq_top,←MonoidHom.range_eq_map,range_subtype,map_map] at h
      exact h
    exact hout (hN.trans ((normalizer_le_characteristicNormalizerClosure
      (baumann T) D hne).trans hcpu))
  let := P.first_characteristic
  let := P.second_characteristic
  rcases hP N (inclusion hBN) hlocal with hc | hn | hb
  · exact (kill P.first P.first_ne_bot ((hlocal.first_normal_iff_central
      P.first P.first_le_omegaCenter).mpr hc)).elim
  · exact (kill P.second P.second_ne_bot hn).elim
  · exact hb

open Representation
open scoped MatrixGroups
variable {H : Type*} {F : Type} [Group H] [Finite H]
  [Field F] [Finite F] [CharP F 2] [Algebra (ZMod 2) F]
local notation "D" => Matrix.SpecialLinearGroup (Fin 2) F
local notation "N" => SL2NaturalOffenders.NoStrong.natural (F := F)
attribute [local instance] RankOneBaumann.semilinear_moved_elementary

/-- The original natural coordinates supply the literal Baumann local class. -/
theorem normal_layer_seed_localClass
    (T : Sylow 2 G) (hP : IsMinimalParabolicOver T ⊤)
    (U : Subgroup G) [U.Normal] [IsElementaryAbelian 2 U] (hU : IsPReduced 2 U)
    (hJ : ¬ elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (U : Set G))
    (q : G →* H) (hq : Function.Surjective q)
    (hker : q.ker = centralizer (U : Set G))
    (L : Subgroup H) [L.Normal] (e : L ≃* D) (hF : 2 < Nat.card F)
    (f : Additive (⁅U,pResidual 2 G⁆ : Subgroup G) →ₗ[ZMod 2] (Fin 2 → F))
    (hf : Function.Surjective f)
    (he : ∀ (g : G) (hg : q g ∈ L) (v : Additive (⁅U,pResidual 2 G⁆ : Subgroup G)),
      f (Additive.ofMul (MulAut.conjNormal g v.toMul)) = N (e ⟨q g,hg⟩) (f v))
    (hk : ∀ (v : Additive (⁅U,pResidual 2 G⁆ : Subgroup G)),
      f v = 0 ↔ (v.toMul : G) ∈ centralizer (pResidual 2 G : Set G))
    (hseed : U ≤ normalClosure (omegaOneCenterAmbient (T : Subgroup G) : Set G))
    (hfit : generalizedFitting G = pCore 2 G) :
    InLocalClass (inclusion (show baumann (T : Subgroup G) ≤
      pResidual 2 G ⊔ baumann (T : Subgroup G) from le_sup_right)) := by
  have ha := (RankOneBaumann.normal_layer_moved_baumann_sylow_and_alpha
    T hP U hU hJ q hq hker L e hF f hf he hk).2
  obtain ⟨hm,hc⟩ := seed_omega_comparison T U hU hfit hseed
    (ha.le.trans (sup_le_sup_right inf_le_left _))
  let V := normalClosure (omegaOneCenterAmbient (T : Subgroup G) : Set G)
  have hV : IsPReduced 2 V := omegaCenter_normalClosure_reduced T
    ((ChapterA.generalizedFitting_eq_pCore_iff 2).mp hfit)
  let := hV.elementary
  let a := (MulEquiv.subgroupCongr hm).toMonoidHom.toAdditive.toZModLinearMap 2
  let fV := f.comp a
  have hfV : Function.Surjective fV := hf.comp (MulEquiv.subgroupCongr hm).surjective
  have heV : ∀ (g : G) (hg : q g ∈ L) (v : Additive (⁅V,pResidual 2 G⁆ : Subgroup G)),
      fV (Additive.ofMul (MulAut.conjNormal g v.toMul)) = N (e ⟨q g,hg⟩) (fV v) := by
    intro g hg v
    exact he g hg (a v)
  have hkV : ∀ (v : Additive (⁅V,pResidual 2 G⁆ : Subgroup G)),
      fV v = 0 ↔ (v.toMul : G) ∈ centralizer (pResidual 2 G : Set G) := by
    intro v
    exact hk (a v)
  exact normal_layer_selected_localClass T hP V hV (fun hj => hJ (hc ▸ hj))
    q hq (hker.trans hc.symm) L e hF fV hfV heV hkV rfl hfit

/-- The original natural action produces a residual block under Baumann control. -/
theorem normal_layer_seed_block_of_baumann_control
    (T : Sylow 2 G) (hP : IsMinimalParabolicOver T ⊤)
    (U : Subgroup G) [U.Normal] [IsElementaryAbelian 2 U] (hU : IsPReduced 2 U)
    (hJ : ¬ elementaryAbelianMaxJ (T : Subgroup G) ≤ centralizer (U : Set G))
    (q : G →* H) (hq : Function.Surjective q)
    (hker : q.ker = centralizer (U : Set G))
    (L : Subgroup H) [L.Normal] (e : L ≃* D) (hF : 2 < Nat.card F)
    (f : Additive (⁅U,pResidual 2 G⁆ : Subgroup G) →ₗ[ZMod 2] (Fin 2 → F))
    (hf : Function.Surjective f)
    (he : ∀ (g : G) (hg : q g ∈ L) (v : Additive (⁅U,pResidual 2 G⁆ : Subgroup G)),
      f (Additive.ofMul (MulAut.conjNormal g v.toMul)) = N (e ⟨q g,hg⟩) (f v))
    (hk : ∀ (v : Additive (⁅U,pResidual 2 G⁆ : Subgroup G)),
      f v = 0 ↔ (v.toMul : G) ∈ centralizer (pResidual 2 G : Set G))
    (hseed : U ≤ normalClosure (omegaOneCenterAmbient (T : Subgroup G) : Set G))
    (hfit : generalizedFitting G = pCore 2 G)
    (M : Subgroup G) (hcpu : (baumann (T : Subgroup G)).characteristicNormalizerClosure ≤ M)
    (hout : ¬ pResidual 2 G ≤ M) : IsChiBlockIn (pResidual 2 G) := by
  have hTne : (T : Subgroup G) ≠ ⊥ := by
    intro hz
    apply hP.2
    rw [hz]
    exact le_normalizer_of_normal
  obtain ⟨P,hD⟩ := exists_baumann_universal_pair (T : Subgroup G) T.isPGroup' hTne
  have hlocal := normal_layer_seed_localClass T hP U hU hJ q hq hker L e hF
    f hf he hk hseed hfit
  exact chi_residual_of_selected_block T
    (blockAlternative_of_baumann_control (T : Subgroup G)
      (pResidual 2 G ⊔ baumann (T : Subgroup G)) M le_sup_right hcpu
      (fun hn => hout (le_sup_left.trans hn)) P hD hlocal)

end CFSG.Quasithin.ChapterC.RankOne.ChiProduct.SelectedRankOne
