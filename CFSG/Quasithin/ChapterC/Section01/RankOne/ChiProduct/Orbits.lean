module

public import CFSG.Quasithin.ChapterC.Section01.RankOne.ChiProduct.Rank
public import CFSG.Quasithin.ChapterC.Section01.RankOne.Solvable.Source.Transport
public import Theory.GroupTheory.ConjugateSpanSylow
public import Theory.GroupTheory.CComponent.QuotientLifting
public import Theory.GroupTheory.ElementaryThompsonRelative

/-!
# The normal layer generated by moved χ-blocks

The literal block module transports through a group equivalence, so the
complete χ-family is closed under conjugation. Its size bound gives each
block at most two conjugates. A Sylow two-subgroup therefore generates its
full normal conjugate span. Conjugation by that Sylow subgroup preserves
the identity L=[L,J(T)]. Consequently the join of all moved χ-blocks is
normal in the original group.

This supplies the normal-product step of C.1.28 using the source SQTK
three-rank bound, without a separate outer-automorphism calculation.
-/

public section
open Subgroup Theory.GroupTheory Stellmacher
namespace CFSG.Quasithin.ChapterC.RankOne.ChiProduct

private theorem linearModel_equiv {A B : Type*} [Group A] [Group B]
    [Finite A] [Finite B] (e : A ≃* B) (hA : IsShort A)
    {D V k : Type*} [Group D] [AddCommGroup V] [Semiring k] [Module k V]
    {ρ : Representation k D V} (h : IsLinearBlockModel A ρ) :
    IsLinearBlockModel B ρ := by
  obtain ⟨σ, ⟨m⟩, hm⟩ := h
  have hk : e.toMonoidHom.ker = ⊥ := (MonoidHom.ker_eq_bot_iff _).mpr e.injective
  have hp : IsPGroup 2 e.toMonoidHom.ker := by rw [hk]; exact IsPGroup.of_bot
  obtain ⟨m'⟩ := BlockModuleModel.exists_of_central_two_quotient
    e.toMonoidHom e.surjective hA.twoPerfect hp (hk ▸ bot_le) σ m
  exact ⟨σ, ⟨m'⟩, hm⟩

/-- Transport the complete χ-type, including the original conjugation module. -/
theorem chi_of_equiv {A B : Type*} [Group A] [Group B] [Finite A] [Finite B]
    (e : A ≃* B) (h : IsChiBlock A) : IsChiBlock B := by
  rcases h with ⟨n, hn, hs, F, hF, hf, hc, hq, hm⟩ | ⟨n, hn, ha⟩
  · refine Or.inl ⟨n, hn, Solvable.isShort_of_equiv e hs, F, hF, hf, hc, ?_,
      linearModel_equiv e hs hm⟩
    exact hq.of_mulEquiv
      (QuotientGroup.congr (pCore 2 A) (pCore 2 B) e (pCore_map_iso 2 e)).symm
  · exact Or.inr ⟨n, hn, Solvable.isAlternatingBlock_of_equiv e ha⟩

variable {G : Type*} [Group G] [Finite G]

/-- Conjugation preserves actual χ-blocks, not merely their abstract quotient. -/
theorem chi_map_equiv {H : Type*} [Group H] [Finite H]
    (e : G ≃* H) {L : Subgroup G} (hL : IsChiBlockIn L) :
    IsChiBlockIn (L.map e.toMonoidHom) :=
  ⟨hL.1.map_equiv e, chi_of_equiv (e.subgroupMap L) hL.2⟩

/-- The normalizer index of each actual χ-block is at most two. -/
theorem normal_or_index_two (hG : generalizedFitting G = pCore 2 G)
    (hr : primeRank 3 G ≤ 2) {L : Subgroup G} (hL : IsChiBlockIn L) :
    L.Normal ∨ (normalizer (L : Set G)).index = 2 := by
  by_cases hn : L.Normal
  · exact Or.inl hn
  have hsub : (Set.range fun g : G => L.map (MulAut.conj g).toMonoidHom) ⊆
      {K : Subgroup G | IsChiBlockIn K} := by
    rintro _ ⟨g, rfl⟩
    exact chi_map_equiv (MulAut.conj g) hL
  have hi : (normalizer (L : Set G)).index ≤ 2 := by
    rw [← ncard_conjugates_eq_index_normalizer]
    exact (Set.ncard_le_ncard hsub).trans (card_chiBlocks_le_two hG hr)
  have hnt : normalizer (L : Set G) ≠ ⊤ := fun h => hn (normalizer_eq_top_iff.mp h)
  have hlo := (normalizer (L : Set G)).one_lt_index_of_ne_top hnt
  exact Or.inr (by omega)

omit [Finite G] in
/-- The original Thompson movement identity is invariant under T-conjugation. -/
theorem moved_conjugate (T : Subgroup G) {L : Subgroup G}
    (hL : L = ⁅L, elementaryAbelianMaxJ T⁆) (t : T) :
    L.map (MulAut.conj (t : G)).toMonoidHom =
      ⁅L.map (MulAut.conj (t : G)).toMonoidHom, elementaryAbelianMaxJ T⁆ := by
  have hfix : (elementaryAbelianMaxJ T).map (MulAut.conj (t : G)).toMonoidHom =
      elementaryAbelianMaxJ T := mem_normalizer_iff_map_conj_eq.mp
        (normalizer_le_normalizer_elementaryAbelianMaxJ T (T.le_normalizer t.property))
  have he := congrArg (Subgroup.map (MulAut.conj (t : G)).toMonoidHom) hL
  rwa [map_commutator, hfix] at he

/-- The join is over the actual moved χ-blocks of G for the fixed original T. -/
@[expose] def movedLayer (T : Subgroup G) : Subgroup G :=
  ⨆ (L : Subgroup G) (_ : IsChiBlockIn L ∧ L = ⁅L, elementaryAbelianMaxJ T⁆), L

omit [Finite G] in
/-- Every moved χ-block lies in the literal moved layer. -/
theorem le_movedLayer (T : Subgroup G) {L : Subgroup G}
    (hL : IsChiBlockIn L) (hm : L = ⁅L, elementaryAbelianMaxJ T⁆) :
    L ≤ movedLayer T := le_iSup_of_le L (le_iSup_of_le ⟨hL, hm⟩ le_rfl)

/-- Strong quasithinness makes the moved χ-layer normal: each Sylow orbit
is already normal, and all its factors still satisfy the original movement. -/
theorem movedLayer_normal (hG : generalizedFitting G = pCore 2 G)
    (hr : primeRank 3 G ≤ 2) (T : Sylow 2 G) : (movedLayer (T : Subgroup G)).Normal := by
  let I := {L : Subgroup G // IsChiBlockIn L ∧
    L = ⁅L, elementaryAbelianMaxJ (T : Subgroup G)⁆}
  let X : I → Subgroup G := fun L => conjugateSpanBy L.val (T : Subgroup G)
  let (L : I) : (X L).Normal :=
    conjugateSpanBy_sylow_normal L.val T (normal_or_index_two hG hr L.property.1)
  have he : movedLayer (T : Subgroup G) = ⨆ L : I, X L := by
    apply le_antisymm
    · apply iSup_le
      intro L
      apply iSup_le
      intro hL
      exact (le_conjugateSpanBy L (T : Subgroup G)).trans
        (le_iSup X ⟨L, hL⟩)
    · apply iSup_le
      intro L
      change conjugateSpanBy L.val (T : Subgroup G) ≤ _
      rw [conjugateSpanBy_eq_iSup_conj]
      exact iSup_le fun t => le_movedLayer _
        (chi_map_equiv (MulAut.conj (t : G)) L.property.1)
        (moved_conjugate _ L.property.2 t)
  rw [he]
  infer_instance

end CFSG.Quasithin.ChapterC.RankOne.ChiProduct
