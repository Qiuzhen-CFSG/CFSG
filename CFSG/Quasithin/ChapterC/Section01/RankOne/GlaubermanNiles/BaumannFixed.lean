module

public import CFSG.Quasithin.ChapterC.Section01.RankOne.GlaubermanNiles.LocalClass
public import CFSG.Quasithin.ChapterB.Section02.Thompson
public import Theory.GroupTheory.MinimalParabolicCentral

/-!
# The Baumann-fixed characteristic-pair problem

This module fixes the quantifier order for the reduced C.1.18 problem: the
pair belongs to B and must work for every finite H and every marked embedding
in the class C.1.17. Baumann fixedness uses the elementary-ab-elian Thompson
subgroup from B.2.2, not the variant generated by maximal abelian subgroups.

The structural pair always exists for nontrivial B. This does not establish
the pushing-up theorem. The proved normal-to-central bridge permits a uniform
normal-pair theorem to supply exactly C.1.18's first alternative: the
centralizer of a normal subgroup is normal, and Frattini's argument shows
that the Sylow subgroup normally generates a minimal parabolic.

Sources: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
manuscript (1 March 2004), C.1.17–19, printed pp.126–127; Campbell, *Pushing
up in Finite Groups*, Caltech thesis (1979), Chapter II §8. Campbell's uniform
selection and its translation to this local class remain to be proved.
-/

@[expose] public section

universe u v

namespace CFSG.Quasithin.ChapterC.GlaubermanNiles

variable {B : Type u} [Group B]

/-- The reduced hypothesis Baum(B)=B, using the B.2.2 convention. -/
def IsBaumannFixed (B : Type u) [Group B] [Finite B] : Prop :=
  ChapterB.baumann (⊤ : Subgroup B) = ⊤

/-- Only the intrinsic structural clauses of a pair. The universal
pushing-up property is kept separate. -/
structure CharacteristicPair (B : Type u) [Group B] where
  first : Subgroup B
  second : Subgroup B
  first_characteristic : first.Characteristic
  second_characteristic : second.Characteristic
  first_ne_bot : first ≠ ⊥
  second_ne_bot : second ≠ ⊥
  first_le_omegaCenter : first ≤ omegaCenter B

/-- The universal property is imposed on one already chosen pair. -/
def CharacteristicPair.Universal (D : CharacteristicPair B) : Prop :=
  ∀ (H : Type v) [Group H] [Finite H] (e : B →* H),
    InLocalClass e → Alternatives D.first D.second e

/-- There is no nontriviality obstruction to the structural clauses when
B is nontrivial. No universal alternatives are asserted here. -/
theorem nonempty_characteristicPair [Finite B] [Nontrivial B] (hB : IsPGroup 2 B) :
    Nonempty (CharacteristicPair B) := by
  let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
  let : (omega₁ (Subgroup.center B) (p := 2)).Characteristic := omega₁_characteristic _
  have hchar : (omegaCenter B).Characteristic := inferInstanceAs
    ((omega₁ (Subgroup.center B) (p := 2)).map (Subgroup.center B).subtype).Characteristic
  have hne : omegaCenter B ≠ ⊥ := Subgroup.omega_center_ne_bot hB
  exact ⟨⟨omegaCenter B, omegaCenter B, hchar, hchar, hne, hne, le_rfl⟩⟩

variable {H : Type v} [Group H] {e : B →* H}

/-- The first subgroup is centralized by the marked Sylow subgroup. -/
theorem image_centralizes_of_le_omegaCenter (e : B →* H)
    (D : Subgroup B) (hD : D ≤ omegaCenter B) :
    e.range ≤ Subgroup.centralizer (D.map e : Set H) := by
  rintro _ ⟨b, rfl⟩ _ ⟨d, hd, rfl⟩
  obtain ⟨z, _, hz⟩ := hD hd
  have hdZ : d ∈ Subgroup.center B := hz ▸ z.property
  simpa only [map_mul] using congrArg e ((Subgroup.mem_center_iff.mp hdZ) b).symm

/-- For the first member of a characteristic pair, normality in a local
group is equivalent to the source's centrality alternative. -/
theorem InLocalClass.first_normal_iff_central [Finite H] (h : InLocalClass e)
    (D : Subgroup B) (hD : D ≤ omegaCenter B) :
    (D.map e).Normal ↔ D.map e ≤ Subgroup.center H := by
  constructor
  · intro hn
    let : (D.map e).Normal := hn
    let : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩
    obtain ⟨T, he, hT⟩ := h.sylow
    have hnT := (ChapterB.isMinimalParabolicOver_top_iff T).mp hT
    apply T.le_center_of_normal_of_uniqueMaximal hT.1 hnT.2
    rw [← he]
    exact image_centralizes_of_le_omegaCenter e D hD
  · intro hc
    constructor
    intro x hx g
    have heq : g * x * g⁻¹ = x := by
      rw [(Subgroup.mem_center_iff.mp (hc hx)) g]
      simp [mul_assoc]
    rwa [heq]

/-- The precise bridge from a uniform normal-pair result to C.1.18.
The universal normal-pair premise is an explicit remaining proof obligation. -/
theorem CharacteristicPair.universal_iff_normal_alternatives (D : CharacteristicPair B) :
    D.Universal.{u, v} ↔
      ∀ (H : Type v) [Group H] [Finite H] (e : B →* H), InLocalClass e →
        (D.first.map e).Normal ∨ (D.second.map e).Normal ∨ BlockAlternative H := by
  constructor
  · intro h H _ _ e he
    rcases h H e he with hcentral | hnormal | hblock
    · exact Or.inl ((he.first_normal_iff_central D.first D.first_le_omegaCenter).mpr hcentral)
    · exact Or.inr (Or.inl hnormal)
    · exact Or.inr (Or.inr hblock)
  · intro h H _ _ e he
    rcases h H e he with hnormal | hnormal | hblock
    · exact Or.inl ((he.first_normal_iff_central D.first D.first_le_omegaCenter).mp hnormal)
    · exact Or.inr (Or.inl hnormal)
    · exact Or.inr (Or.inr hblock)

end CFSG.Quasithin.ChapterC.GlaubermanNiles

end
