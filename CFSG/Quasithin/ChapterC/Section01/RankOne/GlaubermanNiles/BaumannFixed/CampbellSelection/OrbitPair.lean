module
public import CFSG.Quasithin.ChapterC.Section01.RankOne.GlaubermanNiles.BaumannFixed.CampbellSelection.CrossCore
public import Theory.GroupTheory.AutomorphismSpan
/-!
# The two actual automorphism spans in Campbell's uniform selection

The first span is generated by the natural commutator [B,V], so it is a
nontrivial characteristic subgroup of Ω₁(Z(B)). The second is the span of F.
A target with F in the selected orbit normalizes the second span by Theorem A.
Otherwise equal-order maximality excludes every containment of the selected F,
and the already proved original-markings Theorem B centralizes the first span.
All groups and images retain the original C.1.17 markings.

Source: Campbell II.8, printed p.38, specialized to the Baumann-fixed base.
-/
public section
open Subgroup Theory.GroupTheory Stellmacher
open scoped Pointwise IsMulCommutative commutatorElement
namespace CFSG.Quasithin.ChapterC.GlaubermanNiles
variable {B H : Type*} [Group B] [Finite B] [Group H] [Finite H] {e : B →* H}

omit [Finite B] [Finite H] in
theorem pull_precomp_inverse (e : B →* H) (a : MulAut B) (U : Subgroup H) :
    U.comap (e.comp a.symm.toMonoidHom) = (U.comap e).map a.toMonoidHom := by
  rw [←comap_comap,comap_equiv_eq_map_symm']
  rfl

theorem InLocalClass.campbellF_pull_ne_bot (h : InLocalClass e) (hB : IsBaumannFixed B) :
    (Campbell.F H).comap e ≠ ⊥ := by
  intro hz
  apply h.campbell_seed_ne_bot hB
  apply le_bot_iff.mp
  rw [←hz]
  exact (h.campbell_seed_le_omegaCenter hB).trans
    (map_le_iff_le_comap.mp h.omegaCenter_map_le_F)

@[expose] noncomputable def InLocalClass.selectionPair (h : InLocalClass e)
    (hB : IsBaumannFixed B) : CharacteristicPair B where
  first := automorphismSpan ⁅(⊤ : Subgroup B),(Campbell.V H).comap e⁆
  second := automorphismSpan ((Campbell.F H).comap e)
  first_characteristic := automorphismSpan_characteristic _
  second_characteristic := automorphismSpan_characteristic _
  first_ne_bot := automorphismSpan_ne_bot (h.campbell_seed_ne_bot hB)
  second_ne_bot := automorphismSpan_ne_bot (h.campbellF_pull_ne_bot hB)
  first_le_omegaCenter := by
    let : (omegaCenter B).Characteristic := characteristic_iff_map_eq.mpr omegaCenter_map_equiv
    exact (automorphismSpan_le_iff _ _).mpr (h.campbell_seed_le_omegaCenter hB)

theorem InLocalClass.normal_of_characteristic_and_global_thompson
    (h : InLocalClass e) (hB : IsBaumannFixed B) (D : Subgroup B) [D.Characteristic]
    (hJ : Campbell.J (⊤ : Subgroup H) ≤ normalizer (D.map e : Set H)) :
    (D.map e).Normal := by
  have hS : e.range ≤ normalizer (D.map e : Set H) := by
    simpa only [normalizer_eq_top,←MonoidHom.range_eq_map] using D.le_normalizer_map e
  obtain ⟨T,he,_⟩ := h.sylow
  have hQ : pCore 2 H ≤ e.range := he ▸ pCore_isPGroup.le_sylow_of_normal T
  apply normalizer_eq_top_iff.mp
  apply top_unique
  rw [←h.global_thompson_sup_core_eq_top hB]
  exact sup_le hJ (hQ.trans hS)

theorem InLocalClass.central_of_omegaCenter_and_global_thompson
    (h : InLocalClass e) (hB : IsBaumannFixed B) (D : Subgroup B)
    (hD : D ≤ omegaCenter B)
    (hJ : D.map e ≤ centralizer (Campbell.J (⊤ : Subgroup H) : Set H)) :
    D.map e ≤ center H := by
  have hS := image_centralizes_of_le_omegaCenter e D hD
  obtain ⟨T,he,_⟩ := h.sylow
  have hQ : pCore 2 H ≤ e.range := he ▸ pCore_isPGroup.le_sylow_of_normal T
  have hall : (⊤ : Subgroup H) ≤ centralizer (D.map e : Set H) := by
    rw [←h.global_thompson_sup_core_eq_top hB]
    exact sup_le (le_centralizer_iff.mp hJ) (hQ.trans hS)
  intro d hd
  apply mem_center_iff.mpr
  intro g
  exact (hall (mem_top g) d hd).symm

theorem InLocalClass.automorphismSpan_normal_of_commutators
    (h : InLocalClass e) (hB : IsBaumannFixed B)
    (hA : ∀ a : MulAut B,
      ⁅Campbell.J (⊤ : Subgroup H),((Campbell.F H).comap e |>.map a.toMonoidHom).map e⁆ ≤ Campbell.F H) :
    ((automorphismSpan ((Campbell.F H).comap e)).map e).Normal := by
  let D := automorphismSpan ((Campbell.F H).comap e)
  let : D.Characteristic := automorphismSpan_characteristic _
  apply h.normal_of_characteristic_and_global_thompson hB D
  apply le_normalizer_iff_commutator_le_right.mpr
  let : (Campbell.J (⊤ : Subgroup H)).Normal := by
    change (elementaryAbelianMaxJ (⊤ : Subgroup H)).Normal
    let : (elementaryAbelianMaxJ (⊤ : Subgroup H)).Characteristic := elementaryAbelianMaxJ_top_characteristic
    infer_instance
  change ⁅Campbell.J (⊤ : Subgroup H),(automorphismSpan ((Campbell.F H).comap e)).map e⁆ ≤ D.map e
  rw [automorphismSpan,Subgroup.map_iSup,commutator_iSup_of_normal_left]
  apply iSup_le
  intro a
  apply (hA a).trans
  have hF : ((Campbell.F H).comap e).map e = Campbell.F H := by
    rw [map_comap_eq,inf_eq_right.mpr h.campbellF_le_range]
  rw [←hF]
  exact map_mono (le_automorphismSpan _)

variable {H' : Type*} [Group H'] [Finite H'] {e' : B →* H'}

theorem InLocalClass.selectionPair_first_central (h : InLocalClass e)
    (h' : InLocalClass e') (hB : IsBaumannFixed B)
    (hn : ¬ ⁅pResidual 2 H,pCore 2 H⁆ ≤ Campbell.V H)
    (hF : ∀ a : MulAut B,
      ¬ ((Campbell.F H').comap e' |>.map a.toMonoidHom).map e ≤ Campbell.F H) :
    ((h'.selectionPair hB).first).map e ≤ center H := by
  apply h.central_of_omegaCenter_and_global_thompson hB _
    (h'.selectionPair hB).first_le_omegaCenter
  change (automorphismSpan ⁅(⊤ : Subgroup B),(Campbell.V H').comap e'⁆).map e ≤ _
  rw [automorphismSpan,Subgroup.map_iSup]
  apply iSup_le
  intro a
  have hmark := h'.precomp_equiv a.symm
  have hv := h.transferred_V_le_core_of_no_residual_bound hmark hB hn
  have hf : ¬ ((Campbell.F H').comap (e'.comp a.symm.toMonoidHom)).map e ≤ Campbell.F H := by
    rw [pull_precomp_inverse]
    exact hF a
  have hc := h.campbell_comparison_original_markings hmark hB hv hf
  have hrange : (e'.comp a.symm.toMonoidHom).range=e'.range := by
    rw [MonoidHom.range_comp,a.symm.toMonoidHom.range_eq_top_of_surjective a.symm.surjective,
      ←MonoidHom.range_eq_map]
  rw [hrange,pull_precomp_inverse] at hc
  have hseed : (⁅e'.range,Campbell.V H'⁆).comap e' =
      ⁅(⊤ : Subgroup B),(Campbell.V H').comap e'⁆ := by
    rw [←h'.campbell_seed_map,comap_map_eq,e'.ker_eq_bot h'.injective,sup_bot_eq]
  rw [hseed] at hc
  intro z hz
  obtain ⟨c,hc,rfl⟩ := hc hz
  intro g hg
  exact congrArg Subtype.val ((mem_center_iff.mp hc) (⟨g,hg⟩ : Campbell.J (⊤ : Subgroup H)))

theorem InLocalClass.selectionPair_second_normal_of_orbit (h : InLocalClass e)
    (h' : InLocalClass e') (hB : IsBaumannFixed B)
    (a : MulAut B) (heq : ((Campbell.F H').comap e').map a.toMonoidHom = (Campbell.F H).comap e)
    (hA : ∀ a : MulAut B,
      ⁅Campbell.J (⊤ : Subgroup H),((Campbell.F H).comap e |>.map a.toMonoidHom).map e⁆ ≤ Campbell.F H) :
    (((h'.selectionPair hB).second).map e).Normal := by
  change ((automorphismSpan ((Campbell.F H').comap e')).map e).Normal
  rw [←automorphismSpan_map_aut _ a,heq]
  exact h.automorphismSpan_normal_of_commutators hB hA

theorem InLocalClass.selectionPair_alternative_of_maximum (h : InLocalClass e)
    (h' : InLocalClass e') (hB : IsBaumannFixed B)
    (hn : ¬ ⁅pResidual 2 H,pCore 2 H⁆ ≤ Campbell.V H)
    (hmax : Nat.card ((Campbell.F H).comap e) ≤ Nat.card ((Campbell.F H').comap e'))
    (hA : ∀ a : MulAut B,
      ⁅Campbell.J (⊤ : Subgroup H),((Campbell.F H).comap e |>.map a.toMonoidHom).map e⁆ ≤ Campbell.F H) :
    ((h'.selectionPair hB).first).map e ≤ center H ∨
      (((h'.selectionPair hB).second).map e).Normal := by
  by_cases hall : ∀ a : MulAut B,
      ¬ ((Campbell.F H').comap e' |>.map a.toMonoidHom).map e ≤ Campbell.F H
  · exact Or.inl (h.selectionPair_first_central h' hB hn hall)
  · push Not at hall
    obtain ⟨a,ha⟩ := hall
    have hle : ((Campbell.F H').comap e').map a.toMonoidHom ≤ (Campbell.F H).comap e :=
      map_le_iff_le_comap.mp ha
    have heq : ((Campbell.F H').comap e').map a.toMonoidHom = (Campbell.F H).comap e :=
      eq_of_le_of_card_ge hle (by rwa [card_map_of_injective a.injective])
    exact Or.inr (h.selectionPair_second_normal_of_orbit h' hB a heq hA)

end CFSG.Quasithin.ChapterC.GlaubermanNiles
