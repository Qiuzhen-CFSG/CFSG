module

public import CFSG.Quasithin.ChapterB.Section02.Thompson
public import CFSG.Quasithin.ClassicalModels
public import Theory.GroupTheory.GeneralizedFitting.Defs

/-!
# Campbell's marked rank-one setup

This is the common input to the two independent mathematical parts of
Campbell's Chapter II argument. It records Hypothesis (E) from Chapter I §3,
printed p.9, and the T-embeddable quadruples of Chapter I §4, pp.13–14.

The no-partial-complement condition is imposed in G/O₂(G), as in (E).
The group T is identified with the elementary Thompson subgroup of the
specified Sylow subgroup. F and V are the actual omega-center and commutator
constructions; they are not arbitrary module witnesses. Transport between
two overgroups always passes through the marked common T.

Theorem B is stated on printed p.14 and proved in Chapter II §5, pp.27–29.
Theorem A is stated on pp.10–11 and proved in Chapter II §§6–7, pp.29–36.
These definitions assert none of their conclusions. In particular, F and V
lying in the marked T under failure of Thompson factorization is an upstream
lemma to prove, rather than a field of this setup.

Source: Neville Ray Campbell, *Pushing up in Finite Groups*, Caltech thesis
(1979), DOI 10.7907/grvb-z924, https://thesis.caltech.edu/17847/.
-/

@[expose] public section

universe u v w

namespace CFSG.Quasithin.ChapterC.GlaubermanNiles.Campbell

open Theory.GroupTheory Stellmacher
open scoped Pointwise

/-- A subgroup with no proper supplement. -/
def NoPartialComplement {G : Type*} [Group G] (N : Subgroup G) : Prop :=
  ∀ U : Subgroup G, N ⊔ U = ⊤ → U = ⊤

/-- Hypothesis (E), except for the separately marked Sylow subgroup.
No partial complement is tested after quotienting by O₂(G). -/
structure RankOneCover (G : Type v) [Group G] : Prop where
  fitting : generalizedFitting G = pCore 2 G
  cover : ∃ (K : Subgroup G) (hK : K.Normal), pCore 2 G ≤ K ∧
    NoPartialComplement (K.map (QuotientGroup.mk' (pCore 2 G))) ∧
    ∃ n : ℕ, 1 ≤ n ∧ @ClassicalGroup.IsPSL (G ⧸ K)
      (@QuotientGroup.Quotient.group G _ K hK) 2 (2 ^ n)

/-- J(X) is generated by elementary abelian two-subgroups of maximal order. -/
noncomputable def J {G : Type*} [Group G] (X : Subgroup G) : Subgroup G :=
  elementaryAbelianMaxJ X

/-- F = Ω₁(Z(J(O₂(G)))). -/
noncomputable def F (G : Type*) [Group G] : Subgroup G :=
  omegaOneCenterAmbient (J (pCore 2 G))

/-- V = [G,Ω₁(Z(O₂(G)))]. This differs from V in C.1.17. -/
noncomputable def V (G : Type*) [Group G] : Subgroup G :=
  ⁅(⊤ : Subgroup G), omegaOneCenterAmbient (pCore 2 G)⁆

/-- A T-embeddable quadruple, with F and V defined rather than supplied.
Two such quadruples may have different Sylow groups; only their marked
Thompson subgroup T is shared. -/
structure Embedding (T : Type u) [Group T] (G : Type v) [Group G] where
  sylow : Sylow 2 G
  marking : T →* G
  injective : Function.Injective marking
  range_eq : marking.range = J (sylow : Subgroup G)
  rankOne : RankOneCover G

variable {T : Type u} [Group T] {G : Type v} [Group G]

/-- Failure of the literal setwise Thompson factorization. -/
def Embedding.FactorizationFails (d : Embedding T G) : Prop :=
  (Subgroup.centralizer (omegaOneCenterAmbient (d.sylow : Subgroup G) : Set G) : Set G) *
    (Subgroup.normalizer (d.marking.range : Set G) : Set G) ≠ Set.univ

/-- Pull an ambient subgroup back to the fixed common Thompson group. -/
def Embedding.pull (d : Embedding T G) (A : Subgroup G) : Subgroup T :=
  A.comap d.marking

/-- Transfer a subgroup through the common Thompson group, retaining both
literal markings. The containment needed to recover the original subgroup
must be proved by the caller. -/
def Embedding.transfer {G' : Type w} [Group G']
    (d : Embedding T G) (d' : Embedding T G') (A : Subgroup G') : Subgroup G :=
  (d'.pull A).map d.marking

/-- The marked subgroup is recovered whenever it lies in the common T. -/
theorem Embedding.map_pull (d : Embedding T G) (A : Subgroup G)
    (hA : A ≤ d.marking.range) : (d.pull A).map d.marking = A := by
  rw [Embedding.pull, Subgroup.map_comap_eq, inf_eq_right.mpr hA]

/-- Source Theorem B compares V and F in the first group, and concludes
centrality of the second group's [S,V] inside the first group's J(G).
This predicate is a target for the comparison proof, not a hypothesis in
the definition of an embeddable quadruple. -/
def ComparisonConclusion {G' : Type w} [Group G']
    (d : Embedding T G) (d' : Embedding T G') : Prop :=
  d.transfer d' (V G') ≤ pCore 2 G →
    ¬ d.transfer d' (F G') ≤ F G →
    d.transfer d' ⁅(d'.sylow : Subgroup G'), V G'⁆ ≤
      (Subgroup.center (J (⊤ : Subgroup G))).map (J (⊤ : Subgroup G)).subtype

/-- The source comparison theorem, together with the preceding containment
lemmas that make its common-T transports faithful. An implementation of
Theorem A may take this as an explicit premise while Theorem B is proved
independently. The final assembly must discharge it. -/
def ComparisonInput (T : Type u) [Group T] : Prop :=
  ∀ (G G' : Type v) [Group G] [Finite G] [Group G'] [Finite G']
    (d : Embedding T G) (d' : Embedding T G'),
    d.FactorizationFails → d'.FactorizationFails →
    (F G ≤ d.marking.range ∧ V G ≤ d.marking.range ∧
      ⁅(d.sylow : Subgroup G), V G⁆ ≤ d.marking.range) ∧
    (F G' ≤ d'.marking.range ∧ V G' ≤ d'.marking.range ∧
      ⁅(d'.sylow : Subgroup G'), V G'⁆ ≤ d'.marking.range) ∧
    ComparisonConclusion d d'

end CFSG.Quasithin.ChapterC.GlaubermanNiles.Campbell

end
