module

public import CFSG.Quasithin.ChapterC.Section01.RankOne.GlaubermanNiles.BaumannFixed.CampbellAutomorphisms.TheoremA.Definitions

/-!
# The source actors for Campbell Theorem A

The natural fixed-point lifting theorem shows the Sylow fixed layer is
not central in J(H). Its normalizer therefore lies in the genuine unique
maximal overgroup M. Since J(H) is generated by elementary two-groups and
supplements O₂(H), it contains an involution outside M. A moving maximum
elementary subgroup of S supplies the other source actor.
Source: Campbell II.5.1 and II.7, printed pp.27 and33.
-/

public section
open Subgroup Theory.GroupTheory Stellmacher
open scoped Pointwise IsMulCommutative commutatorElement
namespace CFSG.Quasithin.ChapterC.GlaubermanNiles
variable {H : Type*} [Group H] [Finite H] (S : Subgroup H)

theorem InLocalClass.campbell_fixed_not_central (h : InLocalClass S.subtype) (hB : IsBaumannFixed S) :
    ¬CampbellTheoremA.fixed S ≤ centralizer (Campbell.J (⊤ : Subgroup H) : Set H) := by
  intro hn
  have hzC : CampbellTheoremA.fixed S ≤ center H :=
    (le_inf inf_le_left hn).trans (h.campbell_centralizer_global_thompson_le_center hB)
  obtain ⟨d,_,hS⟩ := h.exists_campbellEmbedding hB
  have hSd : (d.sylow : Subgroup H)=S := hS.trans (range_subtype S)
  have hSdSet : (d.sylow : Set H)=(S : Set H) := congrArg (fun X : Subgroup H => (X : Set H)) hSd
  obtain ⟨n,hn,k,_,_,_,hk,⟨m⟩⟩ := h.natural
  have he := h.sylow_fixed_eq_commutator hB m d hS
  rw [←h.campbellV_eq_moved hB m,hSd,hSdSet] at he
  have hc : S ≤ centralizer (Campbell.V H : Set H) := by
    intro s hs v hv
    have hmem : ⁅s,v⁆ ∈ CampbellTheoremA.fixed S := by
      change ⁅s,v⁆ ∈ Campbell.V H ⊓ centralizer (S : Set H)
      rw [he]
      exact commutator_mem_commutator hs hv
    exact (commutatorElement_eq_one_iff_mul_comm.mp
      (h.central_campbell_displacement_eq_one hB s v hv (hzC hmem))).symm
  obtain ⟨v,hv,hvn⟩ := h.exists_campbell_nonfixed_point hB
  exact hvn (by simpa only [range_subtype] using (le_centralizer_iff.mp hc) hv)

theorem InLocalClass.exists_theoremA_actors (h : InLocalClass S.subtype) (hB : IsBaumannFixed S) :
    ∃ (M A : Subgroup H) (g : H), S ≤ M ∧ M ⋖ ⊤ ∧
      normalizer (CampbellTheoremA.fixed S : Set H) ≤ M ∧
      A ∈ elementaryAbelianMaxSubgroups S ∧ ¬A ≤ pCore 2 H ∧
      g ∈ Campbell.J (⊤ : Subgroup H) ∧ g^2=1 ∧ g ∉ M := by
  obtain ⟨d,_,hS⟩ := h.exists_campbellEmbedding hB
  have hSd : (d.sylow : Subgroup H)=S := hS.trans (range_subtype S)
  obtain ⟨n,hn,k,_,_,_,hk,⟨m⟩⟩ := h.natural
  obtain ⟨M,hSM,hMt,hbound⟩ := h.exists_campbell_maximal_normalizer_bound hB m d hS
  have hZT : CampbellTheoremA.fixed S ≤ centralizer (Campbell.J (d.sylow : Subgroup H) : Set H) :=
    inf_le_right.trans (centralizer_le (show Campbell.J (d.sylow : Subgroup H) ≤ S from
      (show Campbell.J (d.sylow : Subgroup H) ≤ (d.sylow : Subgroup H) from sSup_le fun _ hA => hA.1).trans hSd.le))
  have hNZ := hbound _ hZT (h.campbell_fixed_not_central S hB)
  have hAQ : ∃ A ∈ elementaryAbelianMaxSubgroups (d.sylow : Subgroup H), ¬A ≤ pCore 2 H := by
    by_contra! hn
    have hjQ : Campbell.J (d.sylow : Subgroup H) ≤ pCore 2 H := sSup_le hn
    apply h.thompson_moves_moved hB d.sylow hS.symm
    exact hjQ.trans (le_centralizer_iff.mp (h.moved_le_coreOmegaCenter.trans
      (fun x hx => ((mem_omegaOneCenterAmbient_iff _ x).mp hx).2.2)))
  obtain ⟨A,hA,hAQ⟩ := hAQ
  have hg : ∃ g ∈ Campbell.J (⊤ : Subgroup H), g^2=1 ∧ g ∉ M := by
    by_contra! hn
    have hJM : Campbell.J (⊤ : Subgroup H) ≤ M := by
      apply sSup_le
      intro E hE e he
      let : IsElementaryAbelian 2 E := hE.2.1
      exact hn e (le_sSup hE he) (elemPow_eq_one_of_isElementaryAbelian e he)
    have hQM : pCore 2 H ≤ M := (pCore_isPGroup.le_sylow_of_normal d.sylow).trans hSM
    have htop : (⊤ : Subgroup H) ≤ M := (h.global_thompson_sup_core_eq_top hB).symm.le.trans (sup_le hJM hQM)
    exact hMt.ne (top_unique htop)
  obtain ⟨g,hg,hg2,hgM⟩ := hg
  exact ⟨M,A,g,hSd ▸ hSM,hMt,hNZ,hSd ▸ hA,hAQ,hg,hg2,hgM⟩
end CFSG.Quasithin.ChapterC.GlaubermanNiles
