module
public import CFSG.Quasithin.ChapterC.Section01.RankOne.GlaubermanNiles.BaumannFixed.BlockRecognition.Kernel
public import Theory.GroupTheory.Commutator.NormalSupplementPGroup
public import Theory.GroupTheory.PResidual.SylowSupplement
public import Theory.GroupTheory.GeneralizedFitting.InternalModuleResidual
/-!
# The original residual's commutator layer

A normal two-subgroup with full H-commutator is also generated by its
commutators with O²(H): the complementary Sylow action is nilpotent on the
remaining quotient. Applying this to Campbell's V identifies the actual
U(O²(H)) with V under the source commutator bound. Subnormal monotonicity
also passes characteristic two to O²(H).

Source: Campbell II.8, printed p.38; Aschbacher–Smith C.1.7 and C.1.18.
-/
public section
open Subgroup Theory.GroupTheory Stellmacher
namespace CFSG.Quasithin.ChapterC.GlaubermanNiles
variable {B H : Type*} [Group B] [Finite B] [Group H] [Finite H] {e : B →* H}

theorem campbellV_residual_commutator (h : InLocalClass e) (hB : IsBaumannFixed B) :
    ⁅Campbell.V H,pResidual 2 H⁆=Campbell.V H := by
  obtain ⟨n,hn,F,_,_,_,hF,⟨m⟩⟩ := h.natural
  have hfull : ⁅Campbell.V H,(⊤ : Subgroup H)⁆=Campbell.V H := by
    rw [h.campbellV_eq_moved hB m]
    exact h.moved_commutator_eq_self hB m
  obtain ⟨T,he,hT⟩ := h.sylow
  have hVQ : Campbell.V H≤pCore 2 H := (h.campbellV_eq_moved hB m).le.trans
    (h.moved_le_coreOmegaCenter.trans (fun x hx => ((mem_omegaOneCenterAmbient_iff _ x).mp hx).1))
  let : (Campbell.V H).Normal := by rw [h.campbellV_eq_moved hB m];infer_instance
  have hp : IsPGroup 2 (Campbell.V H) := pCore_isPGroup.to_le hVQ
  have hVT : Campbell.V H≤T := hVQ.trans (pCore_isPGroup.le_sylow_of_normal T)
  apply le_antisymm (commutator_le_left _ _) ?_
  apply le_normal_of_full_commutator_normal_supplement
    (Campbell.V H) (T : Subgroup H) (pResidual 2 H) ⁅Campbell.V H,pResidual 2 H⁆ hp T.isPGroup'
  · rw [sup_eq_right.mpr hVT]
    exact pResidual_sup_sylow_eq_top T
  · exact hfull.ge.trans le_sup_left
  · exact le_rfl

theorem residual_blockU_map_eq_campbellV
    (h : InLocalClass e) (hB : IsBaumannFixed B)
    (hcomm : ⁅pResidual 2 H,pCore 2 H⁆ ≤ Campbell.V H) :
    (blockU (pResidual 2 H)).map (pResidual 2 H).subtype=Campbell.V H := by
  obtain ⟨n,hn,F,_,_,_,hF,⟨m⟩⟩ := h.natural
  have hVQ : Campbell.V H≤pCore 2 H := (h.campbellV_eq_moved hB m).le.trans
    (h.moved_le_coreOmegaCenter.trans (fun x hx => ((mem_omegaOneCenterAmbient_iff _ x).mp hx).1))
  let : (Campbell.V H).Normal := by rw [h.campbellV_eq_moved hB m];infer_instance
  let L:=pResidual 2 H
  have hQ : (pCore 2 L).map L.subtype≤pCore 2 H :=
    le_sSup ⟨ConjAct.normal_of_characteristic_of_normal,pCore_isPGroup.map _⟩
  have hmap : (blockU L).map L.subtype=⁅(pCore 2 L).map L.subtype,L⁆ := by
    rw [blockU,map_commutator,←MonoidHom.range_eq_map,range_subtype]
  apply le_antisymm ?_ ?_
  · rw [hmap,commutator_comm]
    exact (commutator_mono le_rfl hQ).trans hcomm
  · have hVL:=campbellV_residual_commutator h hB
    have hle:=commutator_le_core_commutator_of_isSubnormal L (Campbell.V H)
      (inferInstance : L.Normal).isSubnormal (isPPerfect_pResidual 2)
      (pCore_isPGroup.to_le hVQ)
      (show L≤normalizer (Campbell.V H:Set H) by rw [normalizer_eq_top];exact le_top)
    exact hVL.ge.trans hle

omit [Finite B] in
theorem residual_generalizedFitting_eq_core (h : InLocalClass e) :
    generalizedFitting (pResidual 2 H)=pCore 2 (pResidual 2 H) := by
  let L:=pResidual 2 H
  have ht: (generalizedFitting L).map L.subtype≤pCore 2 H := by
    rw [←h.fitting]
    exact generalizedFitting_map_subtype_le_of_isSubnormal L (inferInstance : L.Normal).isSubnormal
  have hp:IsPGroup 2 (generalizedFitting L) := by
    have hm:=pCore_isPGroup.to_le ht
    exact hm.of_equiv ((generalizedFitting L).equivMapOfInjective L.subtype L.subtype_injective).symm
  exact le_antisymm (le_sSup ⟨inferInstance,hp⟩)
    ((pCore_le_fitting L 2).trans (fitting_le_generalizedFitting L))
end CFSG.Quasithin.ChapterC.GlaubermanNiles
