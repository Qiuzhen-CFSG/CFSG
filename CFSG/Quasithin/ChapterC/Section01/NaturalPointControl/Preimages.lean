module

public import CFSG.Quasithin.ChapterC.Section01.NaturalPointControl.Action
public import CFSG.Quasithin.ChapterB.Section02.Baumann.PreimageGenerators
public import Theory.GroupTheory.PCoreImage
public import Stellmacher.ElementaryAbelianMaxJMap
public import Stellmacher.ElementaryAbelianMaxGlobal

/-!
# Constructing the natural-point Baumann family

A nontrivial maximum elementary image contains a cyclic translation. Since
all point-radical subgroups have equal weight, B.2.8 replaces the maximum
subgroup by one whose image is exactly that translation. Conjugating it
constructs maximum elementary subgroups in each of the three root preimages.
Their Thompson images generate SL₃(2), and their three fixed codimensions
sum to the dimension of the natural module. This proves all B.2.18(a--d).

Every maximum image is generated by its cyclic equal-weight subgroups;
each is a component conjugate of the first root image. The full-preimage
B.2.19 theorem therefore supplies Thompson generation and all four Baumann
conclusions. If the Thompson image is trivial, J(Baum(R)) is instead a
nontrivial characteristic subgroup whose ambient image is normal in G.
No classification or Baumann-family conclusion is assumed.

Source: Aschbacher--Smith C.1.37, printed pp.141--143, and B.2.18--19,
printed pp.80--82. The later MS classification remains separate.
-/

@[expose] public section
open Subgroup Stellmacher
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterC.NaturalPointControl
open ChapterB ChapterB.BaumannArgument
open Matrix.PSL3Two Matrix.PSL3Two.MarkedAutomorphisms
variable {G : Type*} [Group G] {V : Subgroup G} [V.Normal] [IsElementaryAbelian 2 V]
namespace NaturalAction
variable (d : NaturalAction V) [Finite G]

omit [Finite G] in
private theorem map_conjugate {H : Type*} [Group H] (q : G →* H)
    (A : Subgroup G) (g : G) :
    (A.map (MulAut.conj g).toMonoidHom).map q =
      (A.map q).map (MulAut.conj (q g)).toMonoidHom := by
  rw [map_map, map_map]
  congr 1
  ext x
  simp

private theorem max_le_J_of_card (S A : Subgroup G) (hAS : A ≤ S)
    (he : IsElementaryAbelian 2 A) (hc : Nat.card A = elementaryAbelianMaxOrder S) :
    A ≤ elementaryAbelianMaxJ S := by
  apply le_sSup
  refine ⟨hAS,he,?_⟩
  intro E hES hE
  obtain ⟨B,hB⟩ := elementaryAbelianMaxSubgroups_nonempty S
  exact (hB.2.2 E hES hE).trans_eq
    ((card_eq_elementaryAbelianMaxOrder S B hB).trans hc.symm)

theorem exists_root_maximum
    (hne : (elementaryAbelianMaxJ d.R).map d.q ≠ ⊥) :
    ∃ C : Subgroup G, C ≤ d.D 0 ∧ IsElementaryAbelian 2 C ∧
      Nat.card C = elementaryAbelianMaxOrder d.R ∧
      C.map d.q = zpowers (PointOffenders.root 0) := by
  have hex : ∃ A ∈ elementaryAbelianMaxSubgroups d.R, A.map d.q ≠ ⊥ := by
    by_contra! hz
    apply hne
    apply (Subgroup.map_eq_bot_iff _).mpr
    apply sSup_le
    intro A hA
    exact (Subgroup.map_eq_bot_iff A).mp (hz A hA)
  obtain ⟨A,hA,hneA⟩ := hex
  have hpoint : A.map d.q ≤ pointV := map_le_iff_le_comap.mpr hA.1
  obtain ⟨g,hg,hg1⟩ : ∃ g ∈ A.map d.q, g ≠ 1 := by
    by_contra! hz
    exact hneA (eq_bot_iff.mpr hz)
  obtain ⟨a,rfl⟩ := show g ∈ PointOffenders.row.range from
    PointOffenders.row_range.symm ▸ hpoint hg
  have ha : a.toAdd ≠ 0 := by
    intro hz
    exact hg1 ((congrArg PointOffenders.row (show a = 1 from hz)).trans
      PointOffenders.row.map_one)
  let B := zpowers (PointOffenders.row a)
  have hBA : B ≤ A.map d.q := zpowers_le.mpr hg
  have hBe : Representation.BinaryOffender.IsElementaryTwo B := by
    let := hA.2.1
    let : IsElementaryAbelian 2 (A.map d.q) := IsElementaryAbelian.map d.q
    exact ⟨by
      intro hz
      have hm : PointOffenders.row a ∈ B := mem_zpowers _
      rw [hz] at hm
      exact hg1 hm,
      IsElementaryAbelian.of_le hBA⟩
  obtain ⟨hC,hCB⟩ := lemma_B_2_8_construct V d.q d.onto d.kernel_centralizer
    d.R d.module_le_R A hA B hBe (d.equalWeightLE hpoint hBA)
  let C := (A ⊓ B.comap d.q) ⊔ (V ⊓ centralizer (A ⊓ B.comap d.q : Set G))
  have hC' : C ∈ elementaryAbelianMaxSubgroups d.R := hC
  have hCB' : C.map d.q = B := hCB
  obtain ⟨l,hl⟩ := d.residual_surjective (PointOffenders.rowConjugator a.toAdd)⁻¹
  let C' := C.map (MulAut.conj (l:G)).toMonoidHom
  have hmap : C'.map d.q = zpowers (PointOffenders.root 0) := by
    rw [map_conjugate, hCB', show d.q l = (PointOffenders.rowConjugator a.toAdd)⁻¹ from hl]
    change (zpowers (PointOffenders.row a)).map _ = _
    rw [MonoidHom.map_zpowers]
    congr 1
    change MulAut.conj (PointOffenders.rowConjugator a.toAdd)⁻¹
      (PointOffenders.row (Multiplicative.ofAdd a.toAdd)) = _
    rw [← PointOffenders.row_conjugate a.toAdd ha]
    simp only [MulAut.conj_apply]
    group
  refine ⟨C', map_le_iff_le_comap.mp hmap.le, hC'.2.1.map _, ?_, hmap⟩
  exact (card_map_of_injective (MulAut.conj (l:G)).injective).trans
    (card_eq_elementaryAbelianMaxOrder d.R C hC')

theorem thompson_D_zero_image
    (hne : (elementaryAbelianMaxJ d.R).map d.q ≠ ⊥) :
    (elementaryAbelianMaxJ (d.D 0)).map d.q = zpowers (PointOffenders.root 0) := by
  obtain ⟨C,hC,he,hcard,hmap⟩ := d.exists_root_maximum hne
  have hc : Nat.card C = elementaryAbelianMaxOrder (d.D 0) := by
    rw [hcard, maxOrder_eq_two_pow_rank, maxOrder_eq_two_pow_rank, d.D_zero_rank]
  apply le_antisymm
  · exact (map_mono (sSup_le fun _ hA => hA.1)).trans_eq (d.D_image 0)
  · rw [← hmap]
    exact map_mono (max_le_J_of_card (d.D 0) C hC he hc)

theorem thompson_D_image
    (hne : (elementaryAbelianMaxJ d.R).map d.q ≠ ⊥) (i : Fin 3) :
    (elementaryAbelianMaxJ (d.D i)).map d.q = zpowers (PointOffenders.root i) := by
  obtain ⟨l,hl,hD⟩ := d.D_conjugate i
  rw [← hD, elementaryAbelianMaxJ_map_equiv, map_conjugate,
    d.thompson_D_zero_image hne]
  have hh := congrArg (fun S : Subgroup G => S.map d.q) hD
  rwa [map_conjugate, d.D_image, d.D_image] at hh


private theorem thompson_self (S : Subgroup G) :
    elementaryAbelianMaxJ (elementaryAbelianMaxJ S) = elementaryAbelianMaxJ S := by
  have hle : elementaryAbelianMaxJ S ≤ S := sSup_le fun _ hA => hA.1
  have h := elementaryAbelianMaxOrder_le_and_j_le_of_maxJ_le S
    (elementaryAbelianMaxJ S) le_rfl
  have he : elementaryAbelianMaxOrder S = elementaryAbelianMaxOrder (elementaryAbelianMaxJ S) :=
    le_antisymm h.1 (elementaryAbelianMaxOrder_le_and_j_le_of_eq _ _ hle).1
  exact le_antisymm (sSup_le fun _ hA => hA.1) (h.2 he)

omit [IsElementaryAbelian 2 V] in
private theorem structural :
    (pCore 2 (pResidual 2 G)).map (pResidual 2 G).subtype ≤
      d.R ⊓ centralizer (V : Set G) ∧
    pResidual 2 G ≤ normalizer (d.R ⊓ centralizer (V : Set G) : Set G) ∧
    pResidual 2 G ⊓ centralizer (V : Set G) ≤ coreFrattini (pResidual 2 G) := by
  have hcore : pCore 2 (pResidual 2 G) = (pCore 2 G).comap (pResidual 2 G).subtype :=
    pCore_subnormal_eq_comap 2 (inferInstance : (pResidual 2 G).Normal).isSubnormal
  have he : d.R ⊓ centralizer (V : Set G) = pCore 2 G := by
    rw [← d.kernel_centralizer, inf_eq_right.mpr d.kernel_le_R, d.kernel]
  refine ⟨?_, ?_, ?_⟩
  · rw [he,hcore,map_comap_eq,range_subtype]
    exact inf_le_right
  · change pResidual 2 G ≤ normalizer ((d.R ⊓ centralizer (V : Set G) : Subgroup G) : Set G)
    rw [he,normalizer_eq_top]
    exact le_top
  · rintro x ⟨hxL,hxC⟩
    refine ⟨⟨x,hxL⟩,?_,rfl⟩
    have hx : (⟨x,hxL⟩ : pResidual 2 G) ∈ pCore 2 (pResidual 2 G) := by
      rw [hcore, ← d.kernel]
      exact d.kernel_centralizer.symm ▸ hxC
    change QuotientGroup.mk' (pCore 2 (pResidual 2 G)) _ ∈ frattini _
    have hx1 : QuotientGroup.mk' (pCore 2 (pResidual 2 G)) (⟨x,hxL⟩ : pResidual 2 G) = 1 :=
      (QuotientGroup.eq_one_iff _).mpr hx
    rw [hx1]
    exact one_mem _

theorem family_AD (hne : (elementaryAbelianMaxJ d.R).map d.q ≠ ⊥) :
    HypothesesAD V d.R (fun i : Fin 3 => elementaryAbelianMaxJ (d.D i)) := by
  obtain ⟨hcore,hnorm,hfrat⟩ := d.structural
  refine ⟨d.R_two,d.module_le_R,hcore,hnorm,hfrat,d.noStrongOffenders,
    ?_,(fun i => thompson_self (d.D i)),?_,?_,?_⟩
  · intro i
    obtain ⟨l,hl,hD⟩ := d.D_conjugate i
    refine ⟨l⁻¹,inv_mem hl,?_⟩
    apply (map_mono (show elementaryAbelianMaxJ (d.D i) ≤ d.D i from
      sSup_le fun _ hA => hA.1)).trans
    rw [← hD]
    have hc : (MulAut.conj l⁻¹).toMonoidHom.comp (MulAut.conj l).toMonoidHom =
        MonoidHom.id G := by ext x; simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply, MonoidHom.id_apply]; group
    rw [map_map,hc,map_id]
    exact d.D_zero_le_R
  · intro i
    exact (twoRank_eq_of_intermediate (d.D i) _ le_rfl
      (sSup_le fun _ hA => hA.1)).trans (d.D_rank i)
  · apply (map_le_map_iff_of_injective (f := d.actionEquiv.toMonoidHom)
      d.actionEquiv.injective).mp
    rw [Subgroup.map_iSup]
    simp_rw [d.image_eq, d.thompson_D_image hne]
    rw [PointOffenders.root_generation]
    exact le_top
  · have hc (i : Fin 3) : fixedCodim V (elementaryAbelianMaxJ (d.D i)) = 1 := by
      rw [fixedCodim,d.module_card,d.fixed_card,d.thompson_D_image hne,
        PointOffenders.root_fixed_card]
      decide
    have hr : fixedCodim V (pResidual 2 G) = 3 := by
      rw [fixedCodim,d.module_card,d.fixed_card,d.residual_image,PointOffenders.top_fixed_card]
      decide
    simp_rw [hc]
    rw [hr]
    decide


omit [Finite G] in
theorem action_representation :
    Representation.NormalElementaryQuotient.representation V (actionMap V)
      (QuotientGroup.mk'_surjective _) (actionMap_ker V) =
      d.ρ.comp d.actionEquiv.toMonoidHom := by
  apply MonoidHom.ext
  intro h
  apply LinearMap.ext
  intro v
  obtain ⟨g,rfl⟩ := QuotientGroup.mk'_surjective (centralizer (V : Set G)) h
  apply Additive.toMul.injective
  apply Subtype.ext
  change ((Representation.NormalElementaryQuotient.representation V (actionMap V)
    (QuotientGroup.mk'_surjective _) (actionMap_ker V) (actionMap V g) v).toMul : G) =
    ((d.ρ (d.q g) v).toMul : G)
  exact (Representation.NormalElementaryQuotient.representation_apply V (actionMap V)
    (QuotientGroup.mk'_surjective _) (actionMap_ker V) g v).trans
    (Representation.NormalElementaryQuotient.representation_apply
      V d.q d.onto d.kernel_centralizer g v).symm

omit [Finite G] in
theorem action_weight (E : Subgroup (G ⧸ centralizer (V : Set G))) :
    Representation.BinaryOffender.weight
      (Representation.NormalElementaryQuotient.representation V (actionMap V)
        (QuotientGroup.mk'_surjective _) (actionMap_ker V)) E =
      Representation.BinaryOffender.weight d.ρ (E.map d.actionEquiv.toMonoidHom) := by
  rw [d.action_representation]
  exact Representation.BinaryOffender.weight_comp_map d.ρ d.actionEquiv.toMonoidHom
    d.actionEquiv.injective E

theorem equal_weight_cover (A : Subgroup G)
    (hA : A ∈ elementaryAbelianMaxSubgroups d.R) :
    ∃ E : Set (Subgroup (G ⧸ centralizer (V : Set G))),
      sSup E = A.map (actionMap V) ∧
      ∀ B ∈ E,
        Representation.BinaryOffender.IsElementaryTwo B ∧
        Representation.BinaryOffender.EqualWeightLE
          (Representation.NormalElementaryQuotient.representation V (actionMap V)
            (QuotientGroup.mk'_surjective _) (actionMap_ker V)) B (A.map (actionMap V)) ∧
        ∃ i : Fin 3, ∃ g ∈ pResidual 2 G,
          B ≤ ((d.D i).map (MulAut.conj g).toMonoidHom).map (actionMap V) := by
  let E : Set (Subgroup (G ⧸ centralizer (V : Set G))) :=
    {B | ∃ b ∈ A.map (actionMap V), b ≠ 1 ∧ B = zpowers b}
  refine ⟨E,?_,?_⟩
  · apply le_antisymm
    · apply sSup_le
      rintro B ⟨b,hb,_,rfl⟩
      exact zpowers_le.mpr hb
    · intro b hb
      by_cases h1 : b = 1
      · simpa only [h1] using (one_mem (sSup E))
      · exact (le_sSup (show zpowers b ∈ E from ⟨b,hb,h1,rfl⟩)) (mem_zpowers b)
  · rintro B ⟨b,hb,hb1,rfl⟩
    have hBA : zpowers b ≤ A.map (actionMap V) := zpowers_le.mpr hb
    have hE : Representation.BinaryOffender.IsElementaryTwo (zpowers b) := by
      let := hA.2.1
      let : IsElementaryAbelian 2 (A.map (actionMap V)) := IsElementaryAbelian.map _
      refine ⟨?_,IsElementaryAbelian.of_le hBA⟩
      intro hz
      have hm := mem_zpowers b
      rw [hz] at hm
      exact hb1 hm
    have hpoint : A.map d.q ≤ pointV := map_le_iff_le_comap.mpr hA.1
    refine ⟨hE,⟨hBA,?_⟩,?_⟩
    · rw [d.action_weight,d.action_weight,d.image_eq]
      exact (d.equalWeightLE hpoint ((map_mono (f := d.actionEquiv.toMonoidHom) hBA).trans_eq
        (d.image_eq A))).2
    · have hbp : d.actionEquiv b ∈ pointV := hpoint (d.image_eq A ▸
        mem_map_of_mem d.actionEquiv.toMonoidHom hb)
      obtain ⟨a,ha⟩ := show d.actionEquiv b ∈ PointOffenders.row.range from
        PointOffenders.row_range.symm ▸ hbp
      have ha0 : a.toAdd ≠ 0 := by
        intro hz
        apply hb1
        apply d.actionEquiv.injective
        rw [← ha,show a = 1 from hz,PointOffenders.row.map_one,d.actionEquiv.map_one]
      obtain ⟨l,hl⟩ := d.residual_surjective (PointOffenders.rowConjugator a.toAdd)
      refine ⟨0,l,l.property,?_⟩
      apply (map_le_map_iff_of_injective (f := d.actionEquiv.toMonoidHom)
        d.actionEquiv.injective).mp
      rw [d.image_eq,map_conjugate,d.D_image,
        show d.q l = PointOffenders.rowConjugator a.toAdd from hl,
        MonoidHom.map_zpowers,MonoidHom.map_zpowers]
      change zpowers (d.actionEquiv b) ≤
        zpowers (MulAut.conj (PointOffenders.rowConjugator a.toAdd) (PointOffenders.root 0))
      rw [PointOffenders.row_conjugate a.toAdd ha0]
      exact (congrArg zpowers ha).ge

theorem baumann_conclusions (hne : (elementaryAbelianMaxJ d.R).map d.q ≠ ⊥) :
    (pCore 2 (pResidual 2 G)).map (pResidual 2 G).subtype ≤ baumann d.R ∧
      thompsonAlpha d.R = (thompsonAlpha d.R ⊓ centralizer (pResidual 2 G : Set G)) ⊔
        (V ⊓ centralizer (elementaryAbelianMaxJ d.R : Set G)) ∧
      IsSylowSubgroupIn (baumann d.R ⊓ centralizer (V : Set G))
        ((pResidual 2 G ⊔ baumann d.R) ⊓ centralizer (V : Set G)) ∧
      (IsSylowSubgroupIn ((baumann d.R).map (actionMap V))
          ((pResidual 2 G).map (actionMap V) ⊔ (baumann d.R).map (actionMap V)) →
        IsSylowSubgroupIn (baumann d.R) (pResidual 2 G ⊔ baumann d.R)) := by
  apply baumann_of_preimage_cover V d.R d.D (d.family_AD hne) ?_ d.D_rank
    (fun A hA _ => d.equal_weight_cover A hA) ?_
  · intro i
    apply comap_map_eq_self
    rw [actionMap_ker,← d.kernel_centralizer]
    exact d.D_kernel i
  · have hR : d.R ⊓ centralizer (V : Set G) = d.q.ker := by
      rw [← d.kernel_centralizer,inf_eq_right.mpr d.kernel_le_R]
    have hL : (pResidual 2 G ⊔ d.R) ⊓ centralizer (V : Set G) = d.q.ker := by
      rw [← d.kernel_centralizer,inf_eq_right.mpr (d.kernel_le_R.trans le_sup_right)]
    rw [hR,hL]
    have hp : IsPGroup 2 d.q.ker := d.kernel.symm ▸ pCore_isPGroup
    let S : Sylow 2 d.q.ker := Sylow.nonempty.some
    have hS : (S : Subgroup d.q.ker) = ⊤ := (S.is_maximal' (hp.to_subgroup ⊤) le_top).symm
    refine ⟨S,?_⟩
    rw [hS,← MonoidHom.range_eq_map,range_subtype]


def P : Subgroup G := pointParabolicSL.comap d.q

omit [IsElementaryAbelian 2 V] in
theorem R_eq_parabolic_core : d.R = (d.P).pCoreIn 2 := by
  have hP : d.P.map d.q = pointParabolicSL := by
    rw [P,map_comap_eq,MonoidHom.range_eq_top.mpr d.onto,top_inf_eq]
  have hk : IsPGroup 2 d.q.ker := d.kernel.symm ▸ pCore_isPGroup
  have hm : ((d.P).pCoreIn 2).map d.q = pointV := by
    rw [map_pCoreIn_of_ker_isPGroup d.q hk,hP]
    exact Matrix.PSL3Two.MarkedProduct.pointParabolic_core
  have hker : d.q.ker ≤ (d.P).pCoreIn 2 := by
    apply le_pCoreIn_of_normalizes hk
    · intro g hg
      change d.q g ∈ pointParabolicSL
      rw [show d.q g = 1 from hg]
      exact one_mem _
    · rw [normalizer_eq_top]
      exact le_top
  rw [← comap_map_eq_self hker,hm]
  rfl

private theorem maxJ_intermediate (S E : Subgroup G)
    (hJ : elementaryAbelianMaxJ S ≤ E) (hE : E ≤ S) :
    elementaryAbelianMaxJ E = elementaryAbelianMaxJ S := by
  have hsmall := elementaryAbelianMaxOrder_le_and_j_le_of_eq E S hE
  have hlarge := elementaryAbelianMaxOrder_le_and_j_le_of_maxJ_le S E hJ
  have he := le_antisymm hsmall.1 hlarge.1
  exact le_antisymm (hsmall.2 he) (hlarge.2 he.symm)

omit [Finite G] in
private theorem maxJ_le_baumann (S : Subgroup G) : elementaryAbelianMaxJ S ≤ baumann S := by
  refine le_inf (sSup_le fun _ hA => hA.1) ?_
  intro j hj
  apply mem_centralizer_iff.mpr
  intro z hz
  obtain ⟨zJ,hzJ,rfl⟩ := hz
  obtain ⟨zC,_,rfl⟩ := hzJ
  exact congrArg Subtype.val ((mem_center_iff.mp zC.property) ⟨j,hj⟩).symm

theorem characteristic_of_thompson_image_bot
    (hz : (elementaryAbelianMaxJ d.R).map d.q = ⊥) :
    ∃ C : Subgroup (baumann d.R), C.Characteristic ∧ C ≠ ⊥ ∧
      (C.map (baumann d.R).subtype).Normal := by
  have hJ : elementaryAbelianMaxJ d.R ≤ d.q.ker := (Subgroup.map_eq_bot_iff _).mp hz
  have hJQ : elementaryAbelianMaxJ d.q.ker = elementaryAbelianMaxJ d.R :=
    maxJ_intermediate d.R d.q.ker hJ d.kernel_le_R
  have hJB : elementaryAbelianMaxJ (baumann d.R) = elementaryAbelianMaxJ d.R :=
    maxJ_intermediate d.R (baumann d.R) (maxJ_le_baumann d.R) inf_le_left
  let C := elementaryAbelianMaxJ (⊤ : Subgroup (baumann d.R))
  have hC : C.map (baumann d.R).subtype = elementaryAbelianMaxJ d.R := by
    rw [← elementaryAbelianMaxJ_map_injective _ (baumann d.R).subtype_injective,
      ← MonoidHom.range_eq_map,range_subtype,hJB]
  refine ⟨C,elementaryAbelianMaxJ_top_characteristic,?_,?_⟩
  · intro hbot
    have hJbot : elementaryAbelianMaxJ d.R = ⊥ := by rw [← hC,hbot,Subgroup.map_bot]
    obtain ⟨A,hA⟩ := elementaryAbelianMaxSubgroups_nonempty d.R
    have hAbot : A = ⊥ := le_bot_iff.mp (hJbot ▸ le_sSup hA)
    have hc := hA.2.2 V d.module_le_R inferInstance
    rw [d.module_card,hAbot,card_bot] at hc
    omega
  · rw [hC,← hJQ,normal_iff_map_conj_eq]
    intro g
    change (elementaryAbelianMaxJ d.q.ker).map (MulAut.conj g).toMonoidHom = _
    rw [← elementaryAbelianMaxJ_map_equiv]
    congr 1
    exact Normal.map_conj_eq d.q.ker g

theorem characteristic_or_family :
    (∃ C : Subgroup (baumann d.R), C.Characteristic ∧ C ≠ ⊥ ∧
      (C.map (baumann d.R).subtype).Normal) ∨
    (HypothesesAD V d.R (fun i : Fin 3 => elementaryAbelianMaxJ (d.D i)) ∧
      elementaryAbelianMaxJ d.R ≤ ⨆ i, elementaryAbelianMaxJ (d.D i)) := by
  by_cases hz : (elementaryAbelianMaxJ d.R).map d.q = ⊥
  · exact Or.inl (d.characteristic_of_thompson_image_bot hz)
  · refine Or.inr ⟨d.family_AD hz,?_⟩
    apply maxJ_le_generated_of_preimage_cover V d.R d.D (d.family_AD hz) ?_ d.D_rank
      (fun A hA _ => d.equal_weight_cover A hA)
    intro i
    apply comap_map_eq_self
    rw [actionMap_ker,← d.kernel_centralizer]
    exact d.D_kernel i

end NaturalAction
end CFSG.Quasithin.ChapterC.NaturalPointControl
