/-!
# Full linear normalizers of the binary universal-cover models

The commuting operators on U × V are generated by its covering shear; on
U × U they are generated by coordinate shear and exchange. An automorphism
of SL₃(2) preserving either model must be inner: an outer twist replaces each
natural quotient by its inequivalent dual, preventing a surjection onto a
natural module. Thus each full linear normalizer is exactly its displayed
actor group, including every summand-mixing centralizer.

This is an independent representation-theoretic argument for the binary
cover-rigidity route in Aschbacher–Smith, combined manuscript (1 March 2004),
C.1.34(2),(5), printed pp.136–137, using I.1.5–6, printed p.408.
-/

public section
namespace CFSG.Quasithin.ChapterC.BinaryMS.AbelianCore.DoubleCopy.CoverModels.ModelOffenders

/-- Every linear normalizer of the mixed cover belongs to its explicit actor group. -/
theorem mixed_normalizer_le_actors : normalizer mixed ≤ mixedActors := by
  apply normalizer_le_of_inner_stabilizers mixed
    (linearAction_injective_of_cover mixed mixedProjection mixedProjection_isCover)
    mixedActors
  · exact le_sup_left
  · exact mixed_centralizer_le_shear.trans le_sup_right
  · exact mixed_twist_inner

/-- Every linear normalizer of the doubled cover belongs to its explicit actor group. -/
theorem doubled_normalizer_le_actors : normalizer doubled ≤ doubledActors := by
  apply normalizer_le_of_inner_stabilizers doubled
    (linearAction_injective_of_cover doubled doubledProjection doubledProjection_isCover)
    doubledActors
  · exact le_sup_left
  · exact doubled_centralizer_le_mixing.trans le_sup_right
  · exact doubled_twist_inner

end CFSG.Quasithin.ChapterC.BinaryMS.AbelianCore.DoubleCopy.CoverModels.ModelOffenders
