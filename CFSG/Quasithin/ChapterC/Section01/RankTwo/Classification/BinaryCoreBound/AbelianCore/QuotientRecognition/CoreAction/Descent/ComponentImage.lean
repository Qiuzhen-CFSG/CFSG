module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.AbelianCore.QuotientRecognition.CoreAction.CentralizerQuotient
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.InnerQuotient


/-!
# The perfect central cover carried by the elementary MS core

Let D=[O₂(J),L]. The actual component action image K in Aut(D) admits a
surjection onto the specified SL₃(2), since C_L(D)≤O₂(L). Its exact kernel
is the image of O₂(L). When D is abelian, that kernel is Z(K); K is perfect,
and K/Z(K) is the actual specified matrix group. Consequently the required
intrinsic centrality is equivalent to Z(K)=1, not merely to the already
proved commutation of the ambient two-core image with K.

The embedding of K into the ambient conjugation image retains the literal
component action. Its faithful binary representation has [D,K]=D. Once
Z(K)=1, an offender for this representation transports to the canonical
`QuotientRecognition.linearAction`. The larger ambient action group is
generated by K and the commuting image of O₂(J), which may act nontrivially.

These are unconditional reductions under the stated abelian or elementary
core hypotheses, not a proof that K is centerless or that its representation
has an offender. Those two assertions still require the genuine MS conditions.
No natural quotient or whole-core classification is assumed.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), C.1.31–34,
printed pp.135–137; the whole-core action obligation in C.1.34.
-/

public section

open Subgroup
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterC.BinaryMS
universe u
variable {J : Type u} [Group J] [Finite J] {κ : GroupClass.{u}} {L R : Subgroup J}
variable (h : Input κ L R)

/-- Ambient and intrinsic component conjugation agree on every element of L. -/
theorem Input.coreAmbientConjugation_component (l : L) :
    h.coreAmbientConjugation l = h.coreConjugation l := by
  apply MulEquiv.ext
  intro d
  apply Subtype.ext
  rw [h.coreAmbientConjugation_apply, h.coreConjugation_apply, h.coreConjugate_val]

/-- The component conjugation kernel is its literal relative centralizer. -/
theorem Input.coreConjugation_kernel_eq :
    h.coreConjugation.ker = (centralizer (commutatorCore L : Set J)).subgroupOf L := by
  ext l
  constructor
  · intro hl d hd
    have he := congrArg (fun a : MulAut (commutatorCore L) => (a ⟨d, hd⟩ : J)) hl
    rw [h.coreConjugation_apply, h.coreConjugate_val] at he
    change (l : J) * d * (l : J)⁻¹ = d at he
    exact (mul_inv_eq_iff_eq_mul.mp he).symm
  · intro hl
    apply MulEquiv.ext
    intro d
    apply Subtype.ext
    rw [h.coreConjugation_apply, h.coreConjugate_val]
    change (l : J) * (d : J) * (l : J)⁻¹ = (d : J)
    exact mul_inv_eq_iff_eq_mul.mpr (hl d d.property).symm

/-- The component action kernel lies in the intrinsic two-core. -/
theorem Input.coreConjugation_kernel_le : h.coreConjugation.ker ≤ pCore 2 L := by
  rw [h.coreConjugation_kernel_eq]
  exact h.component_core_centralizer_le

/-- The specified SL₃(2) quotient factors through the actual component action image. -/
noncomputable def Input.coreComponentProjection :
    h.coreConjugation.range →* AbelianCore.QuotientRecognition.SL :=
  h.coreConjugation.rangeRestrict.liftOfSurjective
    h.coreConjugation.rangeRestrict_surjective
    ⟨h.quotientEquiv.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L)), by
      intro l hl
      have hl' : l ∈ h.coreConjugation.ker := by
        simpa only [MonoidHom.ker_rangeRestrict] using hl
      change h.quotientEquiv (QuotientGroup.mk' (pCore 2 L) l) = 1
      rw [h.quotientEquiv.map_eq_one_iff]
      exact (QuotientGroup.eq_one_iff l).mpr (h.coreConjugation_kernel_le hl')⟩

/-- The new projection uses the original specified quotient marking on L. -/
theorem Input.coreComponentProjection_apply (l : L) :
    h.coreComponentProjection (h.coreConjugation.rangeRestrict l) =
      h.quotientEquiv (QuotientGroup.mk' (pCore 2 L) l) := by
  simp only [Input.coreComponentProjection, MonoidHom.liftOfSurjective,
    MonoidHom.liftOfRightInverse_comp_apply, MonoidHom.comp_apply,
    MulEquiv.coe_toMonoidHom]

/-- Every element of the specified SL₃(2) occurs in the component action quotient. -/
theorem Input.coreComponentProjection_surjective :
    Function.Surjective h.coreComponentProjection := by
  intro g
  obtain ⟨l, hl⟩ := QuotientGroup.mk'_surjective (pCore 2 L) (h.quotientEquiv.symm g)
  refine ⟨h.coreConjugation.rangeRestrict l, ?_⟩
  rw [h.coreComponentProjection_apply, hl, MulEquiv.apply_symm_apply]

/-- The exact remaining kernel is the action image of the intrinsic O₂(L). -/
theorem Input.coreComponentProjection_kernel :
    h.coreComponentProjection.ker = (pCore 2 L).map h.coreConjugation.rangeRestrict := by
  ext a
  obtain ⟨l, rfl⟩ := h.coreConjugation.rangeRestrict_surjective a
  constructor
  · intro hl
    have hl' : l ∈ pCore 2 L := by
      change h.coreComponentProjection (h.coreConjugation.rangeRestrict l) = 1 at hl
      rw [h.coreComponentProjection_apply, h.quotientEquiv.map_eq_one_iff] at hl
      exact (QuotientGroup.eq_one_iff l).mp hl
    exact mem_map_of_mem _ hl'
  · rintro ⟨n, hn, he⟩
    change h.coreComponentProjection (h.coreConjugation.rangeRestrict l) = 1
    rw [← he, h.coreComponentProjection_apply, h.quotientEquiv.map_eq_one_iff]
    exact (QuotientGroup.eq_one_iff n).mpr hn

/-- The remaining central-cover kernel is a two-group. -/
theorem Input.coreComponentProjection_kernel_isPGroup :
    IsPGroup 2 h.coreComponentProjection.ker := by
  rw [h.coreComponentProjection_kernel]
  exact pCore_isPGroup.map _

/-- The actual component action image inherits perfectness from L. -/
theorem Input.coreComponentImage_perfect : Group.IsPerfect h.coreConjugation.range := by
  let := h.component.perfect
  exact Group.IsPerfect.range _

/-- Abelianity of D makes the intrinsic two-core image central in the component image. -/
theorem Input.abelianCore_componentProjection_kernel_central
    (hc : IsMulCommutative (commutatorCore L)) :
    h.coreComponentProjection.ker ≤ center h.coreConjugation.range := by
  rw [h.coreComponentProjection_kernel]
  rintro a ⟨n, hn, rfl⟩
  rw [mem_center_iff]
  intro b
  obtain ⟨l, rfl⟩ := h.coreConjugation.rangeRestrict_surjective b
  apply Subtype.ext
  have hcomm := commutator_eq_bot_iff_le_centralizer.mp
    (h.abelianCore_ambient_image_commutator hc)
  have hnJ : (n : J) ∈ pCore 2 J :=
    (h.componentCore_eq_inf.le (mem_map_of_mem L.subtype hn)).1
  change h.coreConjugation l * h.coreConjugation n =
    h.coreConjugation n * h.coreConjugation l
  rw [← h.coreAmbientConjugation_component l, ← h.coreAmbientConjugation_component n]
  exact hcomm (mem_map_of_mem h.coreAmbientConjugation hnJ)
    (h.coreAmbientConjugation l) (mem_map_of_mem h.coreAmbientConjugation l.property)

/-- Centerlessness of the specified quotient identifies the full center of the component image. -/
theorem Input.abelianCore_componentProjection_kernel_eq_center
    (hc : IsMulCommutative (commutatorCore L)) :
    h.coreComponentProjection.ker = center h.coreConjugation.range := by
  apply le_antisymm (h.abelianCore_componentProjection_kernel_central hc)
  intro a ha
  change h.coreComponentProjection a = 1
  apply Matrix.PSL3Two.center_eq_bot.le
  rw [mem_center_iff]
  intro g
  obtain ⟨b, rfl⟩ := h.coreComponentProjection_surjective g
  rw [← map_mul, ← map_mul, (mem_center_iff.mp ha) b]

/-- The intrinsic centrality obligation is exactly injectivity of the component-image projection. -/
theorem Input.componentCore_centralizes_iff_componentProjection_injective :
    commutatorCore L ≤ centralizer ((pCore 2 L).map L.subtype : Set J) ↔
      Function.Injective h.coreComponentProjection := by
  rw [← MonoidHom.ker_eq_bot_iff, h.coreComponentProjection_kernel,
    Subgroup.map_eq_bot_iff, MonoidHom.ker_rangeRestrict, h.coreConjugation_kernel_eq]
  constructor
  · intro hz n hn d hd
    exact (hz hd n (mem_map_of_mem L.subtype hn)).symm
  · intro hz d hd n hn
    obtain ⟨n, hn, rfl⟩ := hn
    exact (hz hn d hd).symm

/-- The central quotient of the perfect component image is the actual SL₃(2). -/
noncomputable def Input.abelianCore_componentCentralQuotientEquiv
    (hc : IsMulCommutative (commutatorCore L)) :
    (h.coreConjugation.range ⧸ center h.coreConjugation.range) ≃*
      AbelianCore.QuotientRecognition.SL :=
  (QuotientGroup.quotientMulEquivOfEq
    (h.abelianCore_componentProjection_kernel_eq_center hc).symm).trans
    (QuotientGroup.quotientKerEquivOfSurjective h.coreComponentProjection
      h.coreComponentProjection_surjective)

/-- Vanishing of the center of the component image is precisely the missing intrinsic centrality. -/
theorem Input.abelianCore_componentCore_centralizes_iff_center_eq_bot
    (hc : IsMulCommutative (commutatorCore L)) :
    commutatorCore L ≤ centralizer ((pCore 2 L).map L.subtype : Set J) ↔
      center h.coreConjugation.range = ⊥ := by
  rw [h.componentCore_centralizes_iff_componentProjection_injective,
    ← MonoidHom.ker_eq_bot_iff, h.abelianCore_componentProjection_kernel_eq_center hc]

/-- Include the actual component action image in the actual ambient action image. -/
def Input.coreComponentEmbedding :
    h.coreConjugation.range →* h.coreAmbientConjugation.range where
  toFun a := ⟨a.val, by
    obtain ⟨l, hl⟩ := a.property
    exact ⟨l, (h.coreAmbientConjugation_component l).trans hl⟩⟩
  map_one' := rfl
  map_mul' _ _ := rfl

/-- The inclusion of component actions is faithful. -/
theorem Input.coreComponentEmbedding_injective :
    Function.Injective h.coreComponentEmbedding := by
  intro a b hab
  apply Subtype.ext
  exact congrArg (fun x : h.coreAmbientConjugation.range => x.val) hab

/-- The inclusion retains the same literal conjugating representative. -/
theorem Input.coreComponentEmbedding_apply (l : L) :
    h.coreComponentEmbedding (h.coreConjugation.rangeRestrict l) =
      h.coreAmbientConjugation.rangeRestrict l := by
  apply Subtype.ext
  exact (h.coreAmbientConjugation_component l).symm

/-- The inclusion image is exactly the image of L under ambient conjugation. -/
theorem Input.coreComponentEmbedding_range :
    h.coreComponentEmbedding.range = L.map h.coreAmbientConjugation.rangeRestrict := by
  ext a
  constructor
  · rintro ⟨b, rfl⟩
    obtain ⟨l, rfl⟩ := h.coreConjugation.rangeRestrict_surjective b
    rw [h.coreComponentEmbedding_apply]
    exact mem_map_of_mem _ l.property
  · rintro ⟨l, hl, rfl⟩
    exact ⟨h.coreConjugation.rangeRestrict ⟨l, hl⟩, h.coreComponentEmbedding_apply ⟨l, hl⟩⟩

/-- The component action image is normal in the ambient action image. -/
theorem Input.coreComponentEmbedding_normal : h.coreComponentEmbedding.range.Normal := by
  rw [h.coreComponentEmbedding_range]
  exact h.component_normal.map _ h.coreAmbientConjugation.rangeRestrict_surjective

/-- The ambient two-core image commutes with the component image when D is abelian. -/
theorem Input.abelianCore_componentImage_commutes_twoCore
    (hc : IsMulCommutative (commutatorCore L)) :
    ⁅(pCore 2 J).map h.coreAmbientConjugation.rangeRestrict,
      h.coreComponentEmbedding.range⁆ = ⊥ := by
  rw [h.coreComponentEmbedding_range]
  apply commutator_eq_bot_iff_le_centralizer.mpr
  rintro a ⟨n, hn, rfl⟩ b ⟨l, hl, rfl⟩
  apply Subtype.ext
  exact (commutator_eq_bot_iff_le_centralizer.mp
    (h.abelianCore_ambient_image_commutator hc))
      (mem_map_of_mem h.coreAmbientConjugation hn) _
      (mem_map_of_mem h.coreAmbientConjugation hl)

/-- The ambient action image is generated by the component image and the two-core image. -/
theorem Input.coreComponentImage_sup_twoCore :
    (pCore 2 J).map h.coreAmbientConjugation.rangeRestrict ⊔
      h.coreComponentEmbedding.range = ⊤ := by
  rw [h.coreComponentEmbedding_range, ← Subgroup.map_sup, h.core_sup_component,
    ← MonoidHom.range_eq_map]
  exact h.coreAmbientConjugation.rangeRestrict.range_eq_top_of_surjective
    h.coreAmbientConjugation.rangeRestrict_surjective

variable [IsElementaryAbelian 2 (commutatorCore L)]

/-- The binary action of the actual component conjugation image on the whole core. -/
noncomputable def Input.coreComponentRepresentation :
    Representation (ZMod 2) h.coreConjugation.range (Additive (commutatorCore L)) :=
  h.coreAmbientRepresentation.comp h.coreComponentEmbedding

/-- The component image acts by the literal conjugation of L on D. -/
theorem Input.coreComponentRepresentation_apply (l : L) (d : commutatorCore L) :
    h.coreComponentRepresentation (h.coreConjugation.rangeRestrict l) (Additive.ofMul d) =
      Additive.ofMul (h.coreConjugate l d) := by
  apply Additive.toMul.injective
  apply Subtype.ext
  change ((h.coreAmbientRepresentation
    (h.coreComponentEmbedding (h.coreConjugation.rangeRestrict l))
    (Additive.ofMul d)).toMul : J) = (h.coreConjugate l d : J)
  rw [h.coreComponentEmbedding_apply, h.coreAmbientRepresentation_apply,
    h.coreConjugate_val]
  rfl

/-- The binary action of the component image is faithful. -/
theorem Input.coreComponentRepresentation_injective :
    Function.Injective h.coreComponentRepresentation :=
  h.coreAmbientRepresentation_injective.comp h.coreComponentEmbedding_injective

/-- The group identity [D,L]=D gives full generation under the component image. -/
theorem Input.coreComponentRepresentation_full_commutator :
    Representation.BinaryOffender.subspaceCommutator h.coreComponentRepresentation ⊤ ⊤ = ⊤ := by
  let := h.component_normal
  have hh := Representation.BinaryOffender.commutator_eq_top_of_conjugation
    h.coreComponentRepresentation (commutatorCore L) L
    (by rw [normalizer_eq_top]; exact le_top)
    h.coreConjugation.rangeRestrict (MonoidHom.id _) Function.surjective_id
    (fun l d => (h.coreComponentRepresentation_apply l d).trans
      (congrArg Additive.ofMul (Subtype.ext (h.coreConjugate_val l d))))
    (by rw [commutator_comm]; exact h.commutatorCore_idempotent)
  rwa [h.coreConjugation.rangeRestrict.range_eq_top_of_surjective
    h.coreConjugation.rangeRestrict_surjective] at hh

/-- After intrinsic centrality, the component image action is the canonical descended action. -/
theorem Input.coreComponentRepresentation_compatible
    (hz : commutatorCore L ≤ centralizer ((pCore 2 L).map L.subtype : Set J))
    (a : h.coreConjugation.range) (v : Additive (commutatorCore L)) :
    h.coreComponentRepresentation a v =
      AbelianCore.QuotientRecognition.linearAction h hz (h.coreComponentProjection a) v := by
  obtain ⟨l, rfl⟩ := h.coreConjugation.rangeRestrict_surjective a
  rw [h.coreComponentProjection_apply]
  exact (h.coreComponentRepresentation_apply l v.toMul).trans
    (AbelianCore.QuotientRecognition.linearAction_compatible h hz l v.toMul).symm

/-- A component-image offender descends once intrinsic centrality has been established. -/
theorem Input.descendedOffender_of_componentOffender
    (hz : commutatorCore L ≤ centralizer ((pCore 2 L).map L.subtype : Set J))
    (hFF : Representation.BinaryOffender.IsFFModule h.coreComponentRepresentation) :
    Representation.BinaryOffender.IsFFModule
      (AbelianCore.QuotientRecognition.linearAction h hz) := by
  apply hFF.map_equivariant h.coreComponentRepresentation
    (AbelianCore.QuotientRecognition.linearAction h hz)
    h.coreComponentProjection
    (h.componentCore_centralizes_iff_componentProjection_injective.mp hz)
    (LinearEquiv.refl (ZMod 2) _)
  exact h.coreComponentRepresentation_compatible hz

end CFSG.Quasithin.ChapterC.BinaryMS
