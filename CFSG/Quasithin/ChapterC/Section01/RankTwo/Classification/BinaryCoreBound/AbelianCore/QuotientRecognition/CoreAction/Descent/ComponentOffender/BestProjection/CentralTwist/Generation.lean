module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.AbelianCore.QuotientRecognition.ExtensionControl.Dimension

/-!
# Dimension bound from three central twists

The three elementary transvections in cyclic positions generate SL₃(2).
If all three are multiplied by a commuting involution, even words in the
twists recover the original component generators. Thus their displacement
images span any module generated by component commutators. Involution
conjugacy gives dimension at most three times the displacement of any
nontrivial component involution with this common central twist.

The matrix certificates adapt ExtensionControl.Dimension, with no FF-module
assumption. This is an algebraic reduction for the binary component transfer
motivated by Aschbacher–Smith C.1.31–34, printed pp.135–137, combined manuscript
of 1 March 2004; it is not an invocation of the MS classification.
-/

public section

open Representation Representation.BinaryOffender Matrix
namespace CFSG.Quasithin.ChapterC.BinaryMS.ComponentOffender.BestProjection.CentralTwist
local notation "SL" => Matrix.SpecialLinearGroup (Fin 3) (ZMod 2)
private def x : SL := ⟨!![1,1,0;0,1,0;0,0,1], by decide⟩
private def y : SL := ⟨!![1,0,0;0,1,1;0,0,1], by decide⟩
private def z : SL := ⟨!![1,0,0;0,1,0;1,0,1], by decide⟩

private theorem three_generate : Subgroup.closure ({x,y,z} : Set SL) = ⊤ := by
  apply top_unique
  intro g _
  let H := Subgroup.closure ({x,y,z} : Set SL)
  have hx : x ∈ H := Subgroup.subset_closure (by simp)
  have hy : y ∈ H := Subgroup.subset_closure (by simp)
  have hz : z ∈ H := Subgroup.subset_closure (by simp)
  apply Atlas.sl_elementary_induction (fun g => g ∈ H) ?_ (fun _ _ => H.mul_mem) g
  intro i j hij a
  have he : ∀ (i j : Fin 3) (hij : i ≠ j) (a : ZMod 2),
      SpecialLinearGroup.transvection hij a = 1 ∨
      SpecialLinearGroup.transvection hij a = x ∨
      SpecialLinearGroup.transvection hij a = y ∨
      SpecialLinearGroup.transvection hij a = z ∨
      SpecialLinearGroup.transvection hij a = x * y * x * y ∨
      SpecialLinearGroup.transvection hij a = y * z * y * z ∨
      SpecialLinearGroup.transvection hij a = z * x * z * x := by decide
  rcases he i j hij a with h | h | h | h | h | h | h <;> rw [h]
  · exact H.one_mem
  · exact hx
  · exact hy
  · exact hz
  · exact H.mul_mem (H.mul_mem (H.mul_mem hx hy) hx) hy
  · exact H.mul_mem (H.mul_mem (H.mul_mem hy hz) hy) hz
  · exact H.mul_mem (H.mul_mem (H.mul_mem hz hx) hz) hx

set_option maxRecDepth 10000 in
set_option maxHeartbeats 2000000 in
private theorem involution_conjugacy : ∀ a : SL, a ^ 2 = 1 → a ≠ 1 →
    ∃ c : SL, c * a = x * c := by decide +kernel

private def cycle : SL := ⟨!![0,0,1;1,0,0;0,1,0], by decide⟩
private theorem conjugate_y : cycle * x * cycle⁻¹ = y := by decide
private theorem conjugate_z : cycle * y * cycle⁻¹ = z := by decide


variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V) (i : SL →* G) (n : G)
  (hn : n ^ 2 = 1) (hc : ∀ k, Commute n (i k))

include hn hc in
private theorem pair_product (p q : SL) :
    (i p * n) * (i q * n) = i (p * q) := by
  calc
    (i p * n) * (i q * n) = i p * (n * i q) * n := by group
    _ = i p * (i q * n) * n := by rw [(hc q).eq]
    _ = i (p * q) := by rw [map_mul, mul_assoc, mul_assoc, ← pow_two, hn, mul_one]

include hn hc in
private theorem range_le_of_three_twists (H : Subgroup G)
    (hx : i x * n ∈ H) (hy : i y * n ∈ H) (hz : i z * n ∈ H) : i.range ≤ H := by
  have hp (p q : SL) (hp : i p * n ∈ H) (hq : i q * n ∈ H) :
      i (p * q * p * q) ∈ H := by
    have hh := H.mul_mem (H.mul_mem hp hq) (H.mul_mem hp hq)
    rw [pair_product i n hn hc, ← map_mul] at hh
    simpa only [mul_assoc] using hh
  have hu := hp x y hx hy
  have hv := hp y z hy hz
  have hw := hp z x hz hx
  have he : (x*y*x*y)*(z*x*z*x)*(x*y*x*y)*(z*x*z*x) = x ∧
      (y*z*y*z)*(x*y*x*y)*(y*z*y*z)*(x*y*x*y) = y ∧
      (z*x*z*x)*(y*z*y*z)*(z*x*z*x)*(y*z*y*z) = z := by decide
  have hx' : i x ∈ H := by
    rw [← he.1, map_mul, map_mul, map_mul]
    exact H.mul_mem (H.mul_mem (H.mul_mem hu hw) hu) hw
  have hy' : i y ∈ H := by
    rw [← he.2.1, map_mul, map_mul, map_mul]
    exact H.mul_mem (H.mul_mem (H.mul_mem hv hu) hv) hu
  have hz' : i z ∈ H := by
    rw [← he.2.2, map_mul, map_mul, map_mul]
    exact H.mul_mem (H.mul_mem (H.mul_mem hw hv) hw) hv
  have ht : H.comap i = ⊤ := by
    apply top_unique
    rw [← three_generate]
    apply (Subgroup.closure_le _).mpr
    intro g hg
    rcases hg with rfl | rfl | rfl
    · exact hx'
    · exact hy'
    · exact hz'
  rintro _ ⟨g, rfl⟩
  exact (show g ∈ H.comap i from ht ▸ Subgroup.mem_top g)

include hc in
private theorem twist_conj (k t : SL) :
    i k * (i t * n) * (i k)⁻¹ = i (k * t * k⁻¹) * n := by
  have h := (hc k).inv_right.eq
  simp only [map_mul, map_inv]
  calc
    i k * (i t * n) * (i k)⁻¹ = i k * i t * (n * (i k)⁻¹) := by group
    _ = i k * i t * ((i k)⁻¹ * n) := by rw [h]
    _ = i k * i t * (i k)⁻¹ * n := by group

variable [FiniteDimensional (ZMod 2) V]

include hn hc in
private theorem bound_by_twisted_x
    (hfull : subspaceCommutator (ρ.comp i) ⊤ ⊤ = ⊤) :
    Module.finrank (ZMod 2) V ≤ 3 * fixedCodim ρ (Subgroup.zpowers (i x * n)) := by
  let D (g : SL) := LinearMap.range (ρ (i g * n) - LinearMap.id)
  let U := (D x ⊔ D y) ⊔ D z
  let H : Subgroup G := {
    carrier := {g | ∀ v, ρ g v - v ∈ U}
    one_mem' := by intro v; simp
    mul_mem' := by
      intro g h hg hh v
      have hm := U.add_mem (hg (ρ h v)) (hh v)
      simpa only [map_mul, Module.End.mul_apply, sub_add_sub_cancel] using hm
    inv_mem' := by
      intro g hg v
      have hm := U.neg_mem (hg (ρ g⁻¹ v))
      simpa only [← Module.End.mul_apply, ← map_mul, mul_inv_cancel, map_one,
        Module.End.one_apply, neg_sub] using hm }
  have hd (g : SL) (hg : D g ≤ U) : i g * n ∈ H := by
    intro v
    exact hg ⟨v, rfl⟩
  have hi : i.range ≤ H := range_le_of_three_twists i n hn hc H
    (hd x (le_sup_of_le_left le_sup_left))
    (hd y (le_sup_of_le_left le_sup_right)) (hd z le_sup_right)
  have hU : U = ⊤ := by
    apply top_unique
    rw [← hfull]
    apply Submodule.span_le.mpr
    rintro _ ⟨g, _, v, _, rfl⟩
    exact hi ⟨g, rfl⟩ v
  have hy : fixedCodim ρ (Subgroup.zpowers (i y * n)) =
      fixedCodim ρ (Subgroup.zpowers (i x * n)) := by
    rw [← conjugate_y, ← twist_conj i n hc, fixedCodim_zpowers_conj]
  have hz : fixedCodim ρ (Subgroup.zpowers (i z * n)) =
      fixedCodim ρ (Subgroup.zpowers (i x * n)) := by
    rw [← conjugate_z, ← twist_conj i n hc, fixedCodim_zpowers_conj, hy]
  have h1 := Submodule.finrank_sup_add_finrank_inf_eq (D x) (D y)
  have h2 := Submodule.finrank_sup_add_finrank_inf_eq (D x ⊔ D y) (D z)
  have hu : Module.finrank (ZMod 2) U = Module.finrank (ZMod 2) V := by
    rw [hU, finrank_top]
  have hx' := fixedCodim_zpowers_eq_displacement_rank ρ (i x * n)
  have hy' := fixedCodim_zpowers_eq_displacement_rank ρ (i y * n)
  have hz' := fixedCodim_zpowers_eq_displacement_rank ρ (i z * n)
  change fixedCodim ρ (Subgroup.zpowers (i x * n)) = Module.finrank (ZMod 2) (D x) at hx'
  change fixedCodim ρ (Subgroup.zpowers (i y * n)) = Module.finrank (ZMod 2) (D y) at hy'
  change fixedCodim ρ (Subgroup.zpowers (i z * n)) = Module.finrank (ZMod 2) (D z) at hz'
  change Module.finrank (ZMod 2) (((D x ⊔ D y) ⊔ D z) : Submodule (ZMod 2) V) = _ at hu
  omega

include hn hc in
/-- Three conjugate central twists span every full component-commutator module.
This bound requires no offender hypothesis. -/
theorem finrank_le_three_mul_twist_codim
    (hfull : subspaceCommutator (ρ.comp i) ⊤ ⊤ = ⊤)
    (t : SL) (ht : t ^ 2 = 1) (htn : t ≠ 1) :
    Module.finrank (ZMod 2) V ≤ 3 * fixedCodim ρ (Subgroup.zpowers (i t * n)) := by
  obtain ⟨c, hc'⟩ := involution_conjugacy t ht htn
  have he : c * t * c⁻¹ = x := by rw [hc', mul_inv_cancel_right]
  have hx : fixedCodim ρ (Subgroup.zpowers (i x * n)) =
      fixedCodim ρ (Subgroup.zpowers (i t * n)) := by
    rw [← he, ← twist_conj i n hc, fixedCodim_zpowers_conj]
  exact hx ▸ bound_by_twisted_x ρ i n hn hc hfull

end CFSG.Quasithin.ChapterC.BinaryMS.ComponentOffender.BestProjection.CentralTwist
