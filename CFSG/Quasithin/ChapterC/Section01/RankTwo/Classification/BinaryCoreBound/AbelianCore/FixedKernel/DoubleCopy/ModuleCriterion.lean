module

public import Theory.Representation.FirstCohomologyDuality
public import Theory.Representation.SpecialLinearNatural
public import Theory.Representation.BinaryOffender.Defs

/-!
# The representation criterion for doubled natural covers

This module specifies the remaining pure representation calculation for the
binary MS two-copy branch. A faithful finite overgroup acts on a module W,
its normal SL₃(2) image has a commutator-generated cover W → V ⊕ V with
fixed kernel, and the overgroup has an elementary abelian FF-offender.
The required implication says that the cover kernel vanishes.

`CoverRigidity` is an explicit proof obligation, not a theorem or a source
hypothesis. `DoubleCopy.Reduction` constructs all its inputs from the genuine
MS conditions and a natural two-copy quotient of the abelian core.
In particular, the overgroup need not be just SL₃(2), and its two-core need
not act trivially on W.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), C.1.31(MS3)
and C.1.34(2),(5), printed pp.135–137; universal covers are in I.1.5–6,
printed p.408. This is a proposed independent route to the two-copy exclusion,
not a claim that the printed proof supplies this calculation.
-/

@[expose] public section
open Representation Representation.OneCohomology Subgroup

namespace CFSG.Quasithin.ChapterC.BinaryMS.AbelianCore.DoubleCopy

/-- The actual binary rank-two matrix group. -/
abbrev MatrixGroup := Matrix.SpecialLinearGroup (Fin 3) (ZMod 2)

/-- Two copies of the natural module, with the same matrix on each copy. -/
def natural : Representation (ZMod 2) MatrixGroup (Fin 2 → Fin 3 → ZMod 2) where
  toFun g := LinearMap.pi fun i => (specialLinearNatural 3 g).comp (LinearMap.proj i)
  map_one' := by
    apply LinearMap.ext
    intro v
    funext i
    exact LinearMap.congr_fun (specialLinearNatural 3).map_one (v i)
  map_mul' g t := by
    apply LinearMap.ext
    intro v
    funext i
    exact LinearMap.congr_fun ((specialLinearNatural 3).map_mul g t) (v i)

/-- The remaining independent representation-theoretic implication. This
proposition is not asserted here: the double-copy assembly must supply its proof.
The ambient action is faithful, the matrix-group image is normal, and the cover
has a fixed kernel and is generated by commutators. -/
def CoverRigidity.{u, v} : Prop :=
  ∀ {W : Type u} [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]
    {H : Type v} [Group H] [Finite H]
    (δ : Representation (ZMod 2) H W) (ι : MatrixGroup →* H),
    Function.Injective δ → ι.range.Normal →
    ∀ p : Representation.IntertwiningMap (δ.comp ι) natural,
      IsCover p → BinaryOffender.IsFFModule δ → p.toLinearMap.ker = ⊥

end CFSG.Quasithin.ChapterC.BinaryMS.AbelianCore.DoubleCopy
