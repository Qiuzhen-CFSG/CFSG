module
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.AbelianCore.FixedKernel.DoubleCopy.CoverRigidity.ModelOffenders.Normalizers.Intertwiners

/-!
# Full centralizers of the mixed and doubled universal-cover modules

The four blocks of a commuting operator are controlled by the Hom spaces
between U and V. On U × V this gives triangular scalar blocks and one
multiple of the covering projection; invertibility leaves identity or shear.
On U × U every block is a binary scalar. The six invertible coefficient
matrices are generated by coordinate addition and exchange. This last finite
calculation is performed on an abstract binary module before specialization
to the cocycle-dual carrier, avoiding unnecessary unfolding of that carrier.

These are the entire linear centralizers, including summand-mixing maps.
Source context: the independent C.1.34 cover-rigidity argument, using
Aschbacher–Smith I.1.5–6, combined manuscript (1 March 2004), printed p.408.
-/

@[expose] public section
open Representation
namespace CFSG.Quasithin.ChapterC.BinaryMS.AbelianCore.DoubleCopy.CoverModels.ModelOffenders
noncomputable section

private lemma binary_cases (a : ZMod 2) : a = 0 ∨ a = 1 := by
  have h : ∀ b : ZMod 2, b = 0 ∨ b = 1 := by decide
  exact h a

private def commutingIntertwiner {M : Type*} [AddCommGroup M] [Module (ZMod 2) M]
    (τ : Representation (ZMod 2) MatrixGroup M) (f : BinaryGL M)
    (hf : f ∈ Subgroup.centralizer ((linearAction τ).range : Set (BinaryGL M))) :
    τ.IntertwiningMap τ where
  toLinearMap := f.toLinearMap
  isIntertwining' g := by
    apply LinearMap.ext
    intro x
    exact (LinearEquiv.congr_fun
      (Subgroup.mem_centralizer_iff.mp hf (linearAction τ g) ⟨g, rfl⟩) x).symm

private lemma mixed_blocks (F : mixed.IntertwiningMap mixed) :
    ∃ a c d : ZMod 2, ∀ x : U × V,
      F x = (a • x.1, c • projection x.1 + d • x.2) := by
  let i := IntertwiningMap.inl (ZMod 2) cover base
  let j := IntertwiningMap.inr (ZMod 2) cover base
  let p := IntertwiningMap.fst (ZMod 2) cover base
  let q := IntertwiningMap.snd (ZMod 2) cover base
  obtain ⟨a, ha⟩ := cover_end_scalar (p.comp (F.comp i))
  have hb := base_to_cover_zero (p.comp (F.comp j))
  obtain ⟨c, hc⟩ := cover_to_base_scalar (q.comp (F.comp i))
  obtain ⟨d, hd⟩ := base_end_scalar (q.comp (F.comp j))
  refine ⟨a, c, d, fun x => ?_⟩
  have h₁ : (F (x.1, 0)).1 = a • x.1 := congrArg (fun t => t x.1) ha
  have h₂ : (F (0, x.2)).1 = 0 := congrArg (fun t => t x.2) hb
  have h₃ : (F (x.1, 0)).2 = c • projection x.1 := congrArg (fun t => t x.1) hc
  have h₄ : (F (0, x.2)).2 = d • x.2 := congrArg (fun t => t x.2) hd
  have hx : x = (x.1, 0) + (0, x.2) := by simp
  calc
    F x = F (x.1, 0) + F (0, x.2) := by rw [← map_add, ← hx]
    _ = _ := Prod.ext (by change _ + _ = _; rw [h₁, h₂, add_zero])
      (by change _ + _ = _; rw [h₃, h₄])

private lemma doubled_blocks (F : doubled.IntertwiningMap doubled) :
    ∃ a b c d : ZMod 2, ∀ x : U × U,
      F x = (a • x.1 + b • x.2, c • x.1 + d • x.2) := by
  let i := IntertwiningMap.inl (ZMod 2) cover cover
  let j := IntertwiningMap.inr (ZMod 2) cover cover
  let p := IntertwiningMap.fst (ZMod 2) cover cover
  let q := IntertwiningMap.snd (ZMod 2) cover cover
  obtain ⟨a, ha⟩ := cover_end_scalar (p.comp (F.comp i))
  obtain ⟨b, hb⟩ := cover_end_scalar (p.comp (F.comp j))
  obtain ⟨c, hc⟩ := cover_end_scalar (q.comp (F.comp i))
  obtain ⟨d, hd⟩ := cover_end_scalar (q.comp (F.comp j))
  refine ⟨a, b, c, d, fun x => ?_⟩
  have h₁ : (F (x.1, 0)).1 = a • x.1 := congrArg (fun t => t x.1) ha
  have h₂ : (F (0, x.2)).1 = b • x.2 := congrArg (fun t => t x.2) hb
  have h₃ : (F (x.1, 0)).2 = c • x.1 := congrArg (fun t => t x.1) hc
  have h₄ : (F (0, x.2)).2 = d • x.2 := congrArg (fun t => t x.2) hd
  have hx : x = (x.1, 0) + (0, x.2) := by simp
  calc
    F x = F (x.1, 0) + F (0, x.2) := by rw [← map_add, ← hx]
    _ = _ := Prod.ext (by change _ + _ = _; rw [h₁, h₂])
      (by change _ + _ = _; rw [h₃, h₄])

/-- The mixed centralizer is generated by the covering shear. -/
lemma mixed_centralizer_le_shear :
    Subgroup.centralizer ((linearAction mixed).range : Set (BinaryGL (U × V))) ≤
      Subgroup.zpowers mixedShear := by
  intro f hf
  obtain ⟨a, c, d, h⟩ := mixed_blocks (commutingIntertwiner mixed f hf)
  change ∀ x, f x = (a • x.1, c • projection x.1 + d • x.2) at h
  let : Nontrivial U := Module.nontrivial_of_finrank_pos
    (show 0 < Module.finrank (ZMod 2) U by rw [finrank_U]; decide)
  obtain ⟨u, hu⟩ := exists_ne (0 : U)
  have ha : a ≠ 0 := by
    intro hz
    obtain ⟨x, hx⟩ := f.surjective (u, 0)
    have hh := congrArg Prod.fst ((h x).symm.trans hx)
    rw [hz, zero_smul] at hh
    exact hu hh.symm
  have hd : d ≠ 0 := by
    intro hz
    let v : V := fun _ => 1
    have hh : f (0, v) = f 0 := by simp [h, hz]
    have hv := congrArg (fun x : U × V => x.2 0) (f.injective hh)
    exact one_ne_zero hv
  have ha1 : a = 1 := (binary_cases a).resolve_left ha
  have hd1 : d = 1 := (binary_cases d).resolve_left hd
  rw [ha1, hd1] at h
  rcases binary_cases c with rfl | rfl
  · have he : f = 1 := by
      apply LinearEquiv.ext
      intro x
      simpa using h x
    rw [he]
    exact Subgroup.one_mem _
  · have he : f = mixedShear := by
      apply LinearEquiv.ext
      intro x
      simpa [mixedShear, shear, add_comm] using h x
    rw [he]
    exact Subgroup.mem_zpowers _

private lemma binary_mixing_mem {X : Type*} [AddCommGroup X] [Module (ZMod 2) X]
    [Nontrivial X] (f : BinaryGL (X × X)) (a b c d : ZMod 2)
    (h : ∀ x, f x = (a • x.1 + b • x.2, c • x.1 + d • x.2)) :
    f ∈ Subgroup.zpowers (shear (LinearMap.id : X →ₗ[ZMod 2] X)) ⊔
      Subgroup.zpowers (LinearEquiv.prodComm (ZMod 2) X X) := by
  let S : BinaryGL (X × X) := shear LinearMap.id
  let T : BinaryGL (X × X) := LinearEquiv.prodComm (ZMod 2) X X
  let K := Subgroup.zpowers S ⊔ Subgroup.zpowers T
  have hS : S ∈ K :=
    (show Subgroup.zpowers S ≤ K from le_sup_left) (Subgroup.mem_zpowers _)
  have hT : T ∈ K :=
    (show Subgroup.zpowers T ≤ K from le_sup_right) (Subgroup.mem_zpowers _)
  obtain ⟨u, hu⟩ := exists_ne (0 : X)
  have h₁ : (a • u, c • u) ≠ (0, 0) := by
    intro hz
    have hh : f (u, 0) = f 0 := by simpa [h] using hz
    exact hu (congrArg Prod.fst (f.injective hh))
  have h₂ : (b • u, d • u) ≠ (0, 0) := by
    intro hz
    have hh : f (0, u) = f 0 := by simpa [h] using hz
    exact hu (congrArg Prod.snd (f.injective hh))
  have h₃ : (a • u + b • u, c • u + d • u) ≠ (0, 0) := by
    intro hz
    have hh : f (u, u) = f 0 := by simpa [h] using hz
    exact hu (congrArg Prod.fst (f.injective hh))
  have hm (e : BinaryGL (X × X)) (he : e ∈ K) (heq : ∀ x, f x = e x) : f ∈ K := by
    rw [LinearEquiv.ext heq]
    exact he
  rcases binary_cases a with rfl | rfl <;>
    rcases binary_cases b with rfl | rfl <;>
    rcases binary_cases c with rfl | rfl <;>
    rcases binary_cases d with rfl | rfl <;>
    simp only [zero_smul, one_smul, zero_add, add_zero, ZModModule.add_self] at h₁ h₂ h₃ h
  all_goals try exact (h₁ rfl).elim
  all_goals try exact (h₂ rfl).elim
  all_goals try exact (h₃ rfl).elim
  · exact hm T hT (fun x => by change f x = (x.2, x.1); exact h x)
  · exact hm (S * T) (K.mul_mem hS hT)
      (fun x => by simpa [S, T, shear, add_comm] using h x)
  · exact hm 1 K.one_mem (fun x => by simpa using h x)
  · exact hm S hS (fun x => by simpa [S, shear, add_comm] using h x)
  · exact hm (S * T * S) (K.mul_mem (K.mul_mem hS hT) hS)
      (fun x => by simpa [S, T, shear, add_left_comm, add_comm,
        ← add_assoc, ZModModule.add_self] using h x)
  · exact hm (T * S) (K.mul_mem hT hS)
      (fun x => by simpa [S, T, shear, add_comm] using h x)

/-- The doubled centralizer is the full binary two-by-two mixing group. -/
lemma doubled_centralizer_le_mixing :
    Subgroup.centralizer ((linearAction doubled).range : Set (BinaryGL (U × U))) ≤
      Subgroup.zpowers doubledShear ⊔ Subgroup.zpowers doubledSwap := by
  intro f hf
  obtain ⟨a, b, c, d, h⟩ := doubled_blocks (commutingIntertwiner doubled f hf)
  let : Nontrivial U := Module.nontrivial_of_finrank_pos
    (show 0 < Module.finrank (ZMod 2) U by rw [finrank_U]; decide)
  exact binary_mixing_mem f a b c d h

end
end CFSG.Quasithin.ChapterC.BinaryMS.AbelianCore.DoubleCopy.CoverModels.ModelOffenders
