module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.AbelianCore.QuotientRecognition.CoreAction.Descent.ComponentOffender.BestProjection.CentralTwist.Generation
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.AbelianCore.QuotientRecognition.CoreAction.Descent.ComponentOffender.BestProjection.CentralTwist.Nilpotent
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.AbelianCore.QuotientRecognition.CoreAction.Descent.ComponentOffender.BestProjection.CentralTwist.DoubledNatural

/-!
# Small involutions have no central twist

Let a component isomorphic to SL₃(2) split off from a commuting kernel, and let
the component generate a faithful binary module by commutators. An involution
with nontrivial component projection and displacement at most two belongs to
the component.

Write the involution as a component involution times a commuting involution n.
Three conjugate twists give dimension at most six. If n is nonidentity, its
displacement is a nonzero square-zero equivariant map; the checked irreducible
catalogue and unconditional homogeneous splitting identify the whole module
with two equally marked natural copies. On those copies the central twist
displaces exactly three dimensions, contradicting the assumed bound.

This is the local representation-theoretic input to the binary best-offender
transfer motivated by Aschbacher–Smith C.1.31–34, printed pp.135–137, combined
manuscript of 1 March 2004. No FF-module, offender, MS classification, or
whole-module catalogue is assumed. In fact the proof does not require the
commuting kernel to be a two-group, or the ambient groups to be finite.
-/

public section

open Representation Representation.BinaryOffender Subgroup
namespace CFSG.Quasithin.ChapterC.BinaryMS.ComponentOffender.BestProjection.CentralTwist
local notation "SL" => Matrix.SpecialLinearGroup (Fin 3) (ZMod 2)
local notation "W" => BinaryLinearThree.Vector
local notation "τ" => Representation.prod BinaryLinearThree.W BinaryLinearThree.W

private theorem finrank_range_conj
    {X Y : Type*} [AddCommGroup X] [Module (ZMod 2) X]
    [AddCommGroup Y] [Module (ZMod 2) Y]
    (E : X ≃ₗ[ZMod 2] Y) (T : Module.End (ZMod 2) X) :
    Module.finrank (ZMod 2) (LinearMap.range (E.conj T)) =
      Module.finrank (ZMod 2) (LinearMap.range T) := by
  rw [LinearEquiv.conj_apply, LinearMap.comp_assoc, LinearMap.range_comp,
    LinearMap.range_comp_of_range_eq_top _ E.symm.range]
  exact (Submodule.equivMapOfInjective E.toLinearMap E.injective (LinearMap.range T)).finrank_eq.symm

variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V]

/-- A nontrivial central involution cannot have a twist of displacement at most
two on a faithful module generated by the component commutators. -/
theorem central_involution_eq_one_of_small_twist
    (ρ : Representation (ZMod 2) G V) (i : SL →* G)
    (hfaith : Function.Injective ρ)
    (hfull : subspaceCommutator (ρ.comp i) ⊤ ⊤ = ⊤)
    (n : G) (hn : n ^ 2 = 1) (hc : ∀ g, Commute n (i g))
    (t : SL) (ht : t ^ 2 = 1) (htn : t ≠ 1)
    (hsmall : fixedCodim ρ (zpowers (i t * n)) ≤ 2) : n = 1 := by
  by_contra hnn
  have hdim : Module.finrank (ZMod 2) V ≤ 6 :=
    (finrank_le_three_mul_twist_codim ρ i n hn hc hfull t ht htn).trans
      (by omega)
  let T : Module.End (ZMod 2) V := ρ n - LinearMap.id
  have hT : T ≠ 0 := by
    intro he
    apply hnn
    apply hfaith
    rw [map_one]
    exact sub_eq_zero.mp he
  have hTT : T.comp T = 0 := by
    ext v
    have hn' : ρ n (ρ n v) = v := by
      rw [← Module.End.mul_apply, ← map_mul, ← pow_two, hn, map_one, Module.End.one_apply]
    change ρ n (ρ n v - v) - (ρ n v - v) = 0
    rw [map_sub, hn']
    simp only [ZModModule.sub_eq_add]
    calc
      v + ρ n v + (ρ n v + v) = (v + v) + (ρ n v + ρ n v) := by abel
      _ = 0 := by rw [ZModModule.add_self, ZModModule.add_self, add_zero]
  have hcomm (g : SL) (v : V) : T ((ρ.comp i) g v) = (ρ.comp i) g (T v) := by
    change ρ n (ρ (i g) v) - ρ (i g) v = ρ (i g) (ρ n v - v)
    rw [map_sub]
    congr 1
    simpa only [map_mul, Module.End.mul_apply] using congrArg (fun k => ρ k v) (hc g).eq
  obtain ⟨a,⟨E⟩⟩ := homogeneous_of_square_zero (ρ.comp i) hfull hdim T hT hTT hcomm
  let C := E.toLinearEquiv.conjAlgEquiv (ZMod 2)
  let f := C (ρ n)
  have hrep (g : SL) : C (ρ (i g)) = τ (a g) := E.conj_apply_self g
  have hfc (g : SL) (v : W × W) : f (τ g v) = τ g (f v) := by
    have hh := congrArg (fun k => C (ρ k)) (hc (a.symm g)).eq
    simp only [map_mul, hrep, a.apply_symm_apply] at hh
    exact LinearMap.congr_fun hh v
  have hff : f.comp f = LinearMap.id := by
    change f * f = 1
    dsimp only [f]
    rw [← map_mul, ← map_mul, ← pow_two, hn, map_one, map_one]
  have hfn : f ≠ LinearMap.id := by
    intro he
    apply hnn
    apply hfaith
    apply C.injective
    rw [map_one, map_one]
    exact he
  have hta : (a t) ^ 2 = 1 := by rw [← map_pow, ht, map_one]
  have htna : a t ≠ 1 := by
    intro he
    exact htn (a.injective (he.trans a.map_one.symm))
  have hr := doubled_natural_twist_rank f hfc hff hfn (a t) hta htna
  have he : C (ρ (i t * n) - LinearMap.id) = (τ (a t)).comp f - LinearMap.id := by
    change C (ρ (i t * n) - 1) = τ (a t) * f - 1
    rw [map_sub, map_one, map_mul, map_mul, hrep]
  rw [← he] at hr
  change Module.finrank (ZMod 2)
    (LinearMap.range (E.toLinearEquiv.conj (ρ (i t * n) - LinearMap.id))) = 3 at hr
  rw [finrank_range_conj, ← fixedCodim_zpowers_eq_displacement_rank] at hr
  omega

variable {K : Type*} [Group K]

/-- Every involution with nontrivial SL₃(2) projection and displacement at most
two lies in the component. The commuting-kernel hypothesis suffices: neither
finiteness of the groups nor the two-group condition on the kernel is needed. -/
theorem small_involution_mem_component
    (ρ : Representation (ZMod 2) G V) (e : K ≃* SL)
    (i : K →* G) (r : G →* K) (hri : ∀ k, r (i k) = k)
    (hcent : r.ker ≤ centralizer (i.range : Set G))
    (hfaith : Function.Injective ρ)
    (hfull : subspaceCommutator (ρ.comp i) ⊤ ⊤ = ⊤)
    (a : G) (ha : a ^ 2 = 1) (hra : r a ≠ 1)
    (hsmall : fixedCodim ρ (zpowers a) ≤ 2) : a ∈ i.range := by
  let n := (i (r a))⁻¹ * a
  have hnker : n ∈ r.ker := by
    change r ((i (r a))⁻¹ * a) = 1
    simp only [map_mul, map_inv, hri, inv_mul_cancel]
  have hncomm (k : K) : Commute n (i k) :=
    ((mem_centralizer_iff.mp (hcent hnker)) (i k) ⟨k,rfl⟩).symm
  have hat : i (r a) * n = a := by dsimp [n]; group
  have hrt : (r a) ^ 2 = 1 := by rw [← map_pow, ha, map_one]
  have hit : (i (r a)) ^ 2 = 1 := by rw [← map_pow, hrt, map_one]
  have hn : n ^ 2 = 1 := by
    have hh := (hncomm (r a)).symm.mul_pow 2
    rw [hat, ha, hit, one_mul] at hh
    exact hh.symm
  let j : SL →* G := i.comp e.symm.toMonoidHom
  have hjfull : subspaceCommutator (ρ.comp j) ⊤ ⊤ = ⊤ := by
    apply top_unique
    calc
      ⊤ = subspaceCommutator (ρ.comp i) ⊤ ⊤ := hfull.symm
      _ ≤ subspaceCommutator (ρ.comp j) ⊤ ⊤ := ?_
    apply Submodule.span_le.mpr
    rintro _ ⟨k, _, v, _, rfl⟩
    exact Submodule.subset_span ⟨e k, trivial, v, trivial, by simp [j]⟩
  have hne := central_involution_eq_one_of_small_twist ρ j hfaith hjfull n hn
    (fun g => hncomm (e.symm g)) (e (r a))
    (by rw [← map_pow, hrt, map_one])
    (fun h => hra (e.injective (h.trans e.map_one.symm)))
    (by simpa only [j, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
      e.symm_apply_apply, hat] using hsmall)
  rw [hne, mul_one] at hat
  exact ⟨r a,hat⟩

end CFSG.Quasithin.ChapterC.BinaryMS.ComponentOffender.BestProjection.CentralTwist
