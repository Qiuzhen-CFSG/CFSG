module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.AbelianCore.FixedKernel.DoubleCopy.CoverRigidity.Models
public import Mathlib.LinearAlgebra.GeneralLinearGroup.Basic

/-!
# Explicit mixing actors on the two universal-cover models

On U × V, the covering projection p gives the shear (u,v) ↦ (u,v+p(u)).
On U × U, coordinate addition and coordinate exchange commute with the
matrix-group action. We form the literal subgroups of linear automorphisms
generated by SL₃(2) and these operators. Their inclusion in the full linear
normalizers follows from equivariance, without classifying the centralizers.
The two shears have displacement ranks three and four, respectively.

The reverse normalizer inclusions and exclusion of offenders in the generated
groups are separate obligations. These definitions do not assert either one.
They support the independent cover-rigidity route for Aschbacher–Smith,
combined manuscript (1 March 2004), C.1.34(2),(5), printed pp.136–137,
using the universal covers of I.1.5–6, printed p.408.
-/

@[expose] public section

open Representation
namespace CFSG.Quasithin.ChapterC.BinaryMS.AbelianCore.DoubleCopy.CoverModels.ModelOffenders
noncomputable section
variable {M : Type*} [AddCommGroup M] [Module (ZMod 2) M]

/-- The actual binary linear automorphism group of a module. -/
abbrev BinaryGL (M : Type*) [AddCommGroup M] [Module (ZMod 2) M] := M ≃ₗ[ZMod 2] M

/-- A representation with the invertibility of its operators retained. -/
def linearAction {G : Type*} [Group G] (τ : Representation (ZMod 2) G M) : G →* BinaryGL M :=
  (LinearMap.GeneralLinearGroup.generalLinearEquiv (ZMod 2) M).toMonoidHom.comp τ.asGroupHom

/-- The tautological action of a subgroup of binary linear automorphisms. -/
def subgroupAction (K : Subgroup (BinaryGL M)) : Representation (ZMod 2) K M :=
  LinearEquiv.automorphismGroup.toLinearMapMonoidHom.comp K.subtype

/-- The full linear normalizer of the actual matrix-group image. -/
def normalizer (τ : Representation (ZMod 2) MatrixGroup M) : Subgroup (BinaryGL M) :=
  Subgroup.normalizer (linearAction τ).range

private lemma add_self_binary (x : M) : x + x = 0 := by
  exact ZModModule.add_self x

/-- The binary involution adding the image of the first coordinate to the second. -/
def shear {N : Type*} [AddCommGroup N] [Module (ZMod 2) N] (f : M →ₗ[ZMod 2] N) :
    BinaryGL (M × N) where
  toFun x := (x.1, x.2 + f x.1)
  invFun x := (x.1, x.2 + f x.1)
  left_inv x := by simp only [add_assoc x.2, add_self_binary, add_zero]
  right_inv x := by simp only [add_assoc x.2, add_self_binary, add_zero]
  map_add' x y := by ext <;> simp [map_add, add_add_add_comm]
  map_smul' a x := by ext <;> simp [smul_add]

/-- A shear has displacement rank equal to the rank of its off-diagonal map. -/
lemma shear_displacement_finrank {N : Type*} [AddCommGroup N] [Module (ZMod 2) N]
    (f : M →ₗ[ZMod 2] N) :
    Module.finrank (ZMod 2) (LinearMap.range ((shear f).toLinearMap - LinearMap.id)) =
      Module.finrank (ZMod 2) f.range := by
  have he : (shear f).toLinearMap - LinearMap.id =
      (LinearMap.inr (ZMod 2) M N).comp (f.comp (LinearMap.fst (ZMod 2) M N)) := by
    ext x <;> simp [shear]
  rw [he, LinearMap.range_comp,
    LinearMap.range_comp_of_range_eq_top _ Submodule.range_fst]
  exact (Submodule.equivMapOfInjective (LinearMap.inr (ZMod 2) M N)
    (fun a b h => congrArg Prod.snd h) f.range).finrank_eq.symm

/-- The mixing involution obtained from the actual universal covering projection. -/
def mixedShear : BinaryGL (U × V) := shear projection.toLinearMap

/-- Add the first covered coordinate to the second covered coordinate. -/
def doubledShear : BinaryGL (U × U) := shear LinearMap.id

/-- Exchange the two covered coordinates. -/
def doubledSwap : BinaryGL (U × U) := LinearEquiv.prodComm (ZMod 2) U U

/-- The subgroup generated by the mixed matrix action and its displayed shear. -/
def mixedActors : Subgroup (BinaryGL (U × V)) :=
  (linearAction mixed).range ⊔ Subgroup.zpowers mixedShear

/-- The subgroup generated by the doubled matrix action, coordinate addition and swap. -/
def doubledActors : Subgroup (BinaryGL (U × U)) :=
  (linearAction doubled).range ⊔ (Subgroup.zpowers doubledShear ⊔ Subgroup.zpowers doubledSwap)

/-- The mixed shear moves a three-dimensional quotient. -/
lemma mixedShear_displacement_finrank :
    Module.finrank (ZMod 2)
      (LinearMap.range (mixedShear.toLinearMap - LinearMap.id)) = 3 := by
  rw [mixedShear, shear_displacement_finrank,
    LinearMap.range_eq_top.mpr projection_isCover.1, finrank_top, finrank_V]

/-- Coordinate addition on the doubled cover moves a four-dimensional quotient. -/
lemma doubledShear_displacement_finrank :
    Module.finrank (ZMod 2)
      (LinearMap.range (doubledShear.toLinearMap - LinearMap.id)) = 4 := by
  rw [doubledShear, shear_displacement_finrank, LinearMap.range_id, finrank_top, finrank_U]

/-- Equivariance of the covering projection makes the mixed shear centralize SL₃(2). -/
lemma mixedShear_commutes (g : MatrixGroup) :
    mixedShear * linearAction mixed g = linearAction mixed g * mixedShear := by
  apply LinearEquiv.ext
  intro x
  change (cover g x.1, base g x.2 + projection (cover g x.1)) =
    (cover g x.1, base g (x.2 + projection x.1))
  rw [map_add, projection.isIntertwining]

/-- Coordinate addition centralizes the diagonal covered action. -/
lemma doubledShear_commutes (g : MatrixGroup) :
    doubledShear * linearAction doubled g = linearAction doubled g * doubledShear := by
  apply LinearEquiv.ext
  intro x
  change (cover g x.1, cover g x.2 + cover g x.1) =
    (cover g x.1, cover g (x.2 + x.1))
  rw [map_add]

/-- Coordinate exchange centralizes the diagonal covered action. -/
lemma doubledSwap_commutes (g : MatrixGroup) :
    doubledSwap * linearAction doubled g = linearAction doubled g * doubledSwap := by
  ext x <;> rfl

private lemma mem_normalizer_of_commutes (τ : Representation (ZMod 2) MatrixGroup M)
    (f : BinaryGL M) (hf : ∀ g, f * linearAction τ g = linearAction τ g * f) :
    f ∈ normalizer τ := by
  change f ∈ Subgroup.normalizer (linearAction τ).range
  have hc : f ∈ Subgroup.centralizer ((linearAction τ).range : Set (BinaryGL M)) := by
    rw [Subgroup.mem_centralizer_iff]
    rintro _ ⟨g, rfl⟩
    exact (hf g).symm
  exact Subgroup.centralizer_le_normalizer _ hc

/-- Every displayed mixed actor normalizes the actual matrix-group image. -/
lemma mixedActors_le_normalizer : mixedActors ≤ normalizer mixed := by
  apply sup_le Subgroup.le_normalizer
  exact Subgroup.zpowers_le.mpr (mem_normalizer_of_commutes mixed mixedShear mixedShear_commutes)

/-- Every displayed doubled actor normalizes the actual matrix-group image. -/
lemma doubledActors_le_normalizer : doubledActors ≤ normalizer doubled := by
  refine sup_le Subgroup.le_normalizer (sup_le ?_ ?_)
  · exact Subgroup.zpowers_le.mpr
      (mem_normalizer_of_commutes doubled doubledShear doubledShear_commutes)
  · exact Subgroup.zpowers_le.mpr
      (mem_normalizer_of_commutes doubled doubledSwap doubledSwap_commutes)

end
end CFSG.Quasithin.ChapterC.BinaryMS.AbelianCore.DoubleCopy.CoverModels.ModelOffenders
