module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.AbelianCore.FixedKernel.DoubleCopy.CoverRigidity.ModelOffenders.Actors

/-!
# Hom spaces for the actual binary universal cover

Elementary transvections make every endomorphism of the natural three-space
scalar. A map from a cover into a fixed-point-free module factors through the
covering projection. Conversely, a map from a commutator-generated module
into a cover is detected by that projection. These facts compute End(U),
Hom(U,V), and Hom(V,U); the last space vanishes because a section would force
the four-dimensional cover to be generated by a three-dimensional image.

The computations use the dual-cocycle cover itself, with no coordinate
replacement. They supply the block calculations for its product normalizers.
Source context: Aschbacher–Smith, combined manuscript (1 March 2004),
Remark I.1.5 and Lemma I.1.6(4), printed p.408. This is an independent linear
algebra argument for the C.1.34 cover-rigidity route.
-/

@[expose] public section
open Representation Representation.OneCohomology
namespace CFSG.Quasithin.ChapterC.BinaryMS.AbelianCore.DoubleCopy.CoverModels.ModelOffenders
noncomputable section

private lemma base_transvection {i j : Fin 3} (hij : i ≠ j) (a : ZMod 2) (v : V) :
    base (Matrix.SpecialLinearGroup.transvection hij a) v = v + Pi.single i (a * v j) := by
  change ((1 : Matrix (Fin 3) (Fin 3) (ZMod 2)) + Matrix.single i j a).mulVec v = _
  simp only [Matrix.add_mulVec, Matrix.one_mulVec, Matrix.single_mulVec_eq]
  congr 1
  funext k
  by_cases hk : k = i <;> simp [hk]

/-- The endomorphisms of the binary natural module are precisely the scalars. -/
lemma base_end_scalar (f : base.IntertwiningMap base) :
    ∃ a : ZMod 2, f = a • IntertwiningMap.id base := by
  have hs {i j : Fin 3} (hij : i ≠ j) (a : ZMod 2) :
      f (Pi.single i a) = Pi.single i (a * f (Pi.single j 1) j) := by
    have h := LinearMap.congr_fun (f.isIntertwining' (Matrix.SpecialLinearGroup.transvection hij a)) (Pi.single j 1)
    change f (base _ (Pi.single j 1)) = base _ (f (Pi.single j 1)) at h
    rw [base_transvection, base_transvection, map_add] at h
    simpa using add_left_cancel h
  have hd {i j : Fin 3} (hij : i ≠ j) : f (Pi.single i 1) i = f (Pi.single j 1) j := by
    simpa using congrFun (hs hij 1) i
  have hv (i : Fin 3) (a : ZMod 2) :
      f (Pi.single i a) = Pi.single i (a * f (Pi.single 0 1) 0) := by
    obtain ⟨j, hij⟩ : ∃ j : Fin 3, i ≠ j := by fin_cases i <;> decide
    rw [hs hij]
    by_cases hj : j = 0
    · rw [hj]
    · rw [hd hj]
  refine ⟨f (Pi.single 0 1) 0, ?_⟩
  apply IntertwiningMap.ext
  apply LinearMap.ext
  intro v
  have he : v = ∑ i : Fin 3, Pi.single i (v i) := by funext i; simp [Finset.sum_apply]
  change f v = f (Pi.single 0 1) 0 • v
  conv_lhs => rw [he, map_sum]
  rw [show (∑ i : Fin 3, f (Pi.single i (v i))) =
      ∑ i : Fin 3, Pi.single i (v i * f (Pi.single 0 1) 0) from
    Finset.sum_congr rfl (fun i _ => hv i (v i))]
  funext i
  simp [Finset.sum_apply, mul_comm]

variable {X Y Z : Type*} [AddCommGroup X] [Module (ZMod 2) X]
  [AddCommGroup Y] [Module (ZMod 2) Y] [AddCommGroup Z] [Module (ZMod 2) Z]
  {ρ : Representation (ZMod 2) MatrixGroup X}
  {σ : Representation (ZMod 2) MatrixGroup Y}
  {τ : Representation (ZMod 2) MatrixGroup Z}

/-- A map from a commutator-generated module to fixed vectors vanishes. -/
lemma intertwiner_eq_zero_of_fixed_range (f : ρ.IntertwiningMap σ)
    (hρ : Coinvariants.ker ρ = ⊤) (hf : ∀ x, f x ∈ fixed σ) : f = 0 := by
  have h : Coinvariants.ker ρ ≤ f.toLinearMap.ker := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨g, x⟩, rfl⟩
    change f (ρ g x - x) = 0
    rw [map_sub, f.isIntertwining, hf x g, sub_self]
  apply IntertwiningMap.ext
  apply LinearMap.ext
  intro x
  exact h (hρ ▸ Submodule.mem_top)

/-- An equivariant map into a fixed-point-free module descends through any cover. -/
lemma factor_through_cover (p : ρ.IntertwiningMap σ) (hp : IsCover p)
    (f : ρ.IntertwiningMap τ) (hτ : fixed τ = ⊥) :
    ∃ q : σ.IntertwiningMap τ, q.comp p = f := by
  have hk : p.toLinearMap.ker ≤ f.toLinearMap.ker := by
    intro x hx
    have hfx : f x ∈ fixed τ := by
      intro g
      rw [← f.isIntertwining, hp.2.1 hx g]
    rw [hτ] at hfx
    exact hfx
  let e := p.toLinearMap.quotKerEquivOfSurjective hp.1
  let q := (p.toLinearMap.ker.liftQ f.toLinearMap hk).comp e.symm.toLinearMap
  have hq (x : X) : q (p x) = f x := by
    change p.toLinearMap.ker.liftQ f.toLinearMap hk (e.symm (p.toLinearMap x)) = _
    rw [LinearMap.quotKerEquivOfSurjective_symm_apply]
    rfl
  refine ⟨⟨q, ?_⟩, ?_⟩
  · intro g
    apply LinearMap.ext
    intro y
    obtain ⟨x, rfl⟩ := hp.1 y
    change q (σ g (p x)) = τ g (q (p x))
    rw [← p.isIntertwining, hq, hq, f.isIntertwining]
  · apply IntertwiningMap.ext
    exact LinearMap.ext hq

/-- The maps from the universal cover to the natural module are multiples of its projection. -/
lemma cover_to_base_scalar (f : cover.IntertwiningMap base) :
    ∃ a : ZMod 2, f = a • projection := by
  obtain ⟨q, hq⟩ := factor_through_cover projection projection_isCover f base_fixed
  obtain ⟨a, rfl⟩ := base_end_scalar q
  refine ⟨a, ?_⟩
  rw [← hq]
  apply IntertwiningMap.ext
  rfl

/-- Projection detects maps into the cover from a commutator-generated source. -/
lemma projection_comp_injective (hρ : Coinvariants.ker ρ = ⊤) :
    Function.Injective (fun f : ρ.IntertwiningMap cover => projection.comp f) := by
  intro f g h
  apply sub_eq_zero.mp
  apply intertwiner_eq_zero_of_fixed_range (f - g) hρ
  intro x
  apply projection_isCover.2.1
  change projection (f x - g x) = 0
  rw [map_sub]
  exact sub_eq_zero.mpr (congrArg (fun t : ρ.IntertwiningMap base => t x) h)

/-- Every equivariant endomorphism of the actual four-dimensional cover is scalar. -/
lemma cover_end_scalar (f : cover.IntertwiningMap cover) :
    ∃ a : ZMod 2, f = a • IntertwiningMap.id cover := by
  obtain ⟨a, ha⟩ := cover_to_base_scalar (projection.comp f)
  refine ⟨a, projection_comp_injective projection_isCover.2.2 ?_⟩
  change projection.comp f = projection.comp (a • IntertwiningMap.id cover)
  rw [ha]
  apply IntertwiningMap.ext
  apply LinearMap.ext
  intro u
  exact (map_smul projection a u).symm

/-- The natural module has no nonzero equivariant map into its nonsplit cover. -/
lemma base_to_cover_zero (f : base.IntertwiningMap cover) : f = 0 := by
  obtain ⟨a, ha⟩ := base_end_scalar (projection.comp f)
  have hab : a = 0 ∨ a = 1 := by
    have h : ∀ b : ZMod 2, b = 0 ∨ b = 1 := by decide
    exact h a
  rcases hab with rfl | rfl
  · apply projection_comp_injective base_commutator
    apply IntertwiningMap.ext
    apply LinearMap.ext
    intro v
    have h := congrArg (fun t : base.IntertwiningMap base => t v) ha
    simpa using h
  · have hs (v : V) : projection (f v) = v := by
      have h := congrArg (fun t : base.IntertwiningMap base => t v) ha
      simpa using h
    have he : f.comp projection = IntertwiningMap.id cover := by
      apply projection_comp_injective projection_isCover.2.2
      apply IntertwiningMap.ext
      apply LinearMap.ext
      intro u
      exact hs (projection u)
    have hsur : Function.Surjective f := by
      intro u
      exact ⟨projection u, congrArg (fun t : cover.IntertwiningMap cover => t u) he⟩
    have hdim := LinearMap.finrank_le_finrank_of_surjective (f := f.toLinearMap) hsur
    rw [finrank_U, finrank_V] at hdim
    omega

end
end CFSG.Quasithin.ChapterC.BinaryMS.AbelianCore.DoubleCopy.CoverModels.ModelOffenders
