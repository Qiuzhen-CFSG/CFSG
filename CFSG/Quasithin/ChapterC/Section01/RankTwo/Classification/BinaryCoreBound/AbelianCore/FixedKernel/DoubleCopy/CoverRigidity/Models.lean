module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.AbelianCore.FixedKernel.DoubleCopy.ModuleCriterion
public import Theory.Representation.SLHigherNaturalFirstCohomology.SLThreeBinary
public import Theory.Representation.PSL3Two.AutomorphismAction.NaturalDual

/-!
# Universal covers of two binary natural modules

Write V for the natural module of the actual SL₃(2) matrix group and U for
its universal cover, constructed as the dual of the cocycles with values in
V*. Inverse transpose transports the checked natural H¹ calculation to V*,
so U has dimension four and its covering kernel has dimension one.

The product modules U × V and U × U give covers of V ⊕ V with kernel
dimensions one and two. Restriction to the two coordinate summands embeds
the cocycles with values in (V ⊕ V)* into two copies of the V* cocycle space.
The resulting dimension bound proves that U × U is a universal cover:
every cover in the task is its equivariant quotient. Consequently every
nonzero covering kernel has dimension one or two; in dimension two the
cover itself is equivalent to U × U.

These are representation-theoretic preparations for the binary MS branch.
They do not classify the one-dimensional-kernel quotients or exclude ambient
FF-offenders. Reference: Aschbacher–Smith, combined manuscript (1 March
2004), Remark I.1.5 and Lemma I.1.6(4), printed p.408 (PDF p.419).
-/

@[expose] public section

open Representation Representation.OneCohomology Module
namespace CFSG.Quasithin.ChapterC.BinaryMS.AbelianCore.DoubleCopy.CoverModels

/-- The binary natural three-space. -/
abbrev V := Fin 3 → ZMod 2
/-- The actual natural matrix action. -/
abbrev base : Representation (ZMod 2) MatrixGroup V := specialLinearNatural 3
/-- The carrier of the universal natural cover, using dual cocycles. -/
abbrev U := Module.Dual (ZMod 2) (cocycles base.dual)
/-- The contragredient universal action on the natural cover. -/
abbrev cover : Representation (ZMod 2) MatrixGroup U := (universalAction base.dual).dual
/-- The universal covering projection onto the natural module. -/
noncomputable abbrev projection : cover.IntertwiningMap base := universalCoverProjection base

instance instFiniteDimensionalU : FiniteDimensional (ZMod 2) U :=
  Subspace.instModuleDualFiniteDimensional

/-- The natural module has no nonzero fixed vector. -/
lemma base_fixed : fixed base = ⊥ := SLHigherNatural.fixed_eq_bot (by decide)

/-- Inverse transpose also makes the dual natural module fixed-point-free. -/
lemma base_dual_fixed : fixed base.dual = ⊥ := by
  let e := BinaryLinearThree.AutomorphismAction.graphNaturalDual
  let a := BinaryLinearThree.AutomorphismAction.graph
  apply bot_unique
  intro f hf
  have hz : e.symm f ∈ fixed base := by
    intro g
    have he := LinearMap.congr_fun (e.symm.isIntertwining' (a.symm g)) f
    change e.symm (base.dual (a.symm g) f) = base (a (a.symm g)) (e.symm f) at he
    rw [hf (a.symm g), a.apply_symm_apply] at he
    exact he.symm
  rw [base_fixed] at hz
  change f = 0
  exact e.symm.injective (hz.trans (map_zero e.symm).symm)

/-- The natural module is generated by its commutators. -/
lemma base_commutator : Coinvariants.ker base = ⊤ :=
  (fixed_dual_eq_bot_iff base).mp base_dual_fixed

/-- The dual natural first cohomology has dimension one. -/
lemma base_dual_h1 : finrank (ZMod 2) (H1 base.dual) = 1 := by
  let e := BinaryLinearThree.AutomorphismAction.graphNaturalDual
  let a := BinaryLinearThree.AutomorphismAction.graph
  have he : ∀ g v, e.symm (BinaryLinearThree.W.dual g v) =
      BinaryLinearThree.W (a g) (e.symm v) := by
    intro g v
    exact LinearMap.congr_fun (e.symm.isIntertwining' g) v
  exact (H1Congr _ _ a e.symm.toLinearEquiv he).finrank_eq.trans
    SLHigherNatural.finrank_H1_sl3_two

/-- The canonical four-dimensional projection satisfies the complete cover definition. -/
lemma projection_isCover : IsCover projection :=
  universalCoverProjection_isCover base base_commutator

/-- The universal natural covering kernel has dimension one. -/
lemma projection_kernel_finrank : finrank (ZMod 2) projection.toLinearMap.ker = 1 := by
  rw [finrank_ker_universalCoverProjection, base_dual_h1]

/-- The natural module has dimension three. -/
lemma finrank_V : finrank (ZMod 2) V = 3 := by simp [V]

/-- The universal natural cover has dimension four. -/
lemma finrank_U : finrank (ZMod 2) U = 4 := by
  have h := projection.toLinearMap.finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr projection_isCover.1, finrank_top,
    projection_kernel_finrank, finrank_V] at h
  exact h.symm

/-- The candidate with one covered and one natural summand. -/
noncomputable def mixed : Representation (ZMod 2) MatrixGroup (U × V) := cover.prod base
/-- The candidate with two covered summands. -/
noncomputable def doubled : Representation (ZMod 2) MatrixGroup (U × U) := cover.prod cover

/-- The mixed candidate has dimension seven. -/
lemma finrank_mixed : finrank (ZMod 2) (U × V) = 7 := by
  rw [Module.finrank_prod, finrank_U, finrank_V]
/-- The doubled candidate has dimension eight. -/
lemma finrank_doubled : finrank (ZMod 2) (U × U) = 8 := by
  rw [Module.finrank_prod, finrank_U]

/-- The literal function-space target is the product of two natural modules. -/
noncomputable def pairEquiv : natural.Equiv (base.prod base) where
  toLinearEquiv := LinearEquiv.piFinTwo (ZMod 2) (fun _ => V)
  isIntertwining' _ := rfl

private lemma commutator_map {X Y : Type*} [AddCommGroup X] [Module (ZMod 2) X]
    [AddCommGroup Y] [Module (ZMod 2) Y]
    {ρ : Representation (ZMod 2) MatrixGroup X}
    {σ : Representation (ZMod 2) MatrixGroup Y} (f : ρ.IntertwiningMap σ) :
    Coinvariants.ker ρ ≤ (Coinvariants.ker σ).comap f.toLinearMap := by
  apply Submodule.span_le.mpr
  rintro _ ⟨⟨g, x⟩, rfl⟩
  change f (ρ g x - x) ∈ Coinvariants.ker σ
  rw [map_sub, f.isIntertwining]
  exact Coinvariants.sub_mem_ker g (f x)

private lemma commutator_prod {X Y : Type*} [AddCommGroup X] [Module (ZMod 2) X]
    [AddCommGroup Y] [Module (ZMod 2) Y]
    {ρ : Representation (ZMod 2) MatrixGroup X}
    {σ : Representation (ZMod 2) MatrixGroup Y}
    (hρ : Coinvariants.ker ρ = ⊤) (hσ : Coinvariants.ker σ = ⊤) :
    Coinvariants.ker (ρ.prod σ) = ⊤ := by
  apply top_unique
  intro x _
  have h₁ := commutator_map (IntertwiningMap.inl (ZMod 2) ρ σ)
  have h₂ := commutator_map (IntertwiningMap.inr (ZMod 2) ρ σ)
  rw [hρ] at h₁
  rw [hσ] at h₂
  have hx : (x.1, 0) ∈ Coinvariants.ker (ρ.prod σ) := h₁ (Submodule.mem_top : x.1 ∈ ⊤)
  have hy : (0, x.2) ∈ Coinvariants.ker (ρ.prod σ) := h₂ (Submodule.mem_top : x.2 ∈ ⊤)
  simpa using (Coinvariants.ker (ρ.prod σ)).add_mem hx hy

/-- Project the covered summand and retain the natural summand. -/
noncomputable def mixedProjection : mixed.IntertwiningMap natural :=
  pairEquiv.symm.toIntertwiningMap.comp
    ((projection.comp (IntertwiningMap.fst (ZMod 2) cover base)).prod
      (IntertwiningMap.snd (ZMod 2) cover base))

/-- Project both covered summands. -/
noncomputable def doubledProjection : doubled.IntertwiningMap natural :=
  pairEquiv.symm.toIntertwiningMap.comp
    ((projection.comp (IntertwiningMap.fst (ZMod 2) cover cover)).prod
      (projection.comp (IntertwiningMap.snd (ZMod 2) cover cover)))

/-- The mixed model covers the task’s literal doubled natural representation. -/
lemma mixedProjection_isCover : IsCover mixedProjection := by
  refine ⟨?_, ?_, commutator_prod projection_isCover.2.2 base_commutator⟩
  · intro v
    obtain ⟨u, hu⟩ := projection_isCover.1 (v 0)
    refine ⟨(u, v 1), ?_⟩
    apply pairEquiv.injective
    change pairEquiv (pairEquiv.symm (projection u, v 1)) = pairEquiv v
    rw [pairEquiv.apply_symm_apply, hu]
    rfl
  · intro w hw g
    have hz := congrArg pairEquiv hw
    change pairEquiv (pairEquiv.symm (projection w.1, w.2)) = pairEquiv 0 at hz
    rw [pairEquiv.apply_symm_apply, map_zero] at hz
    have hu : w.1 ∈ projection.toLinearMap.ker := congrArg Prod.fst hz
    have hv : w.2 = 0 := congrArg Prod.snd hz
    apply Prod.ext
    · exact (projection_isCover.2.1 hu) g
    · change base g w.2 = w.2
      rw [hv, map_zero]

/-- The doubled model covers the task’s literal doubled natural representation. -/
lemma doubledProjection_isCover : IsCover doubledProjection := by
  refine ⟨?_, ?_, commutator_prod projection_isCover.2.2 projection_isCover.2.2⟩
  · intro v
    obtain ⟨u, hu⟩ := projection_isCover.1 (v 0)
    obtain ⟨w, hw⟩ := projection_isCover.1 (v 1)
    refine ⟨(u, w), ?_⟩
    apply pairEquiv.injective
    change pairEquiv (pairEquiv.symm (projection u, projection w)) = pairEquiv v
    rw [pairEquiv.apply_symm_apply, hu, hw]
    rfl
  · intro w hw g
    have hz := congrArg pairEquiv hw
    change pairEquiv (pairEquiv.symm (projection w.1, projection w.2)) = pairEquiv 0 at hz
    rw [pairEquiv.apply_symm_apply, map_zero] at hz
    exact Prod.ext ((projection_isCover.2.1 (congrArg Prod.fst hz)) g)
      ((projection_isCover.2.1 (congrArg Prod.snd hz)) g)

/-- The doubled natural target has dimension six. -/
lemma finrank_natural : finrank (ZMod 2) (Fin 2 → V) = 6 := by simp [Module.finrank_pi_fintype, V]

/-- The mixed cover has a one-dimensional kernel. -/
lemma mixedProjection_kernel_finrank : finrank (ZMod 2) mixedProjection.toLinearMap.ker = 1 := by
  have h := mixedProjection.toLinearMap.finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr mixedProjection_isCover.1, finrank_top,
    finrank_natural, finrank_mixed] at h
  omega

/-- The doubled cover has a two-dimensional kernel. -/
lemma doubledProjection_kernel_finrank : finrank (ZMod 2) doubledProjection.toLinearMap.ker = 2 := by
  have h := doubledProjection.toLinearMap.finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr doubledProjection_isCover.1, finrank_top,
    finrank_natural, finrank_doubled] at h
  omega

private def insert (i : Fin 2) : base.IntertwiningMap natural where
  toLinearMap := LinearMap.single (ZMod 2) (fun _ => V) i
  isIntertwining' g := by
    apply LinearMap.ext
    intro v
    funext j
    change (Pi.single i (base g v) : Fin 2 → V) j = base g ((Pi.single i v : Fin 2 → V) j)
    by_cases h : i = j
    · subst j; simp
    · simp [h]

private def cocycleMap {X Y : Type*} [AddCommGroup X] [Module (ZMod 2) X]
    [AddCommGroup Y] [Module (ZMod 2) Y]
    {ρ : Representation (ZMod 2) MatrixGroup X}
    {σ : Representation (ZMod 2) MatrixGroup Y} (f : ρ.IntertwiningMap σ) :
    cocycles ρ →ₗ[ZMod 2] cocycles σ where
  toFun c := ⟨fun g => f (c.val g), by
    intro g t
    change f (c.val (g * t)) = _
    rw [c.property, map_add, f.isIntertwining]⟩
  map_add' c d := by ext g; simp
  map_smul' a c := by ext g; simp

private def dualCocycleCoordinates : cocycles natural.dual →ₗ[ZMod 2]
    (cocycles base.dual × cocycles base.dual) :=
  (cocycleMap (dualIntertwining (insert 0))).prod
    (cocycleMap (dualIntertwining (insert 1)))

private lemma dualCocycleCoordinates_injective : Function.Injective dualCocycleCoordinates := by
  intro f c hf
  apply Subtype.ext
  funext g
  apply LinearMap.ext
  intro v
  have h₀ := congrArg (fun z : cocycles base.dual × cocycles base.dual => z.1.val g (v 0)) hf
  have h₁ := congrArg (fun z : cocycles base.dual × cocycles base.dual => z.2.val g (v 1)) hf
  change f.val g (Pi.single (0 : Fin 2) (v 0)) = c.val g (Pi.single (0 : Fin 2) (v 0)) at h₀
  change f.val g (Pi.single (1 : Fin 2) (v 1)) = c.val g (Pi.single (1 : Fin 2) (v 1)) at h₁
  have hv : Pi.single (0 : Fin 2) (v 0) + Pi.single (1 : Fin 2) (v 1) = v := by
    funext i
    fin_cases i <;> simp
  change f.val g v = c.val g v
  rw [← hv, map_add, map_add, h₀, h₁]

/-- Coordinate restriction bounds the dual doubled-natural cocycle space. -/
lemma dual_cocycles_finrank_le : finrank (ZMod 2) (cocycles natural.dual) ≤ 8 := by
  have hc : finrank (ZMod 2) (cocycles base.dual) = 4 := by
    rw [← Subspace.dual_finrank_eq]
    exact finrank_U
  have h := LinearMap.finrank_le_finrank_of_injective dualCocycleCoordinates_injective
  rw [Module.finrank_prod, hc] at h
  exact h

/-- The doubled model attains the cocycle dimension bound. -/
lemma dual_cocycles_finrank : finrank (ZMod 2) (cocycles natural.dual) = 8 := by
  let : FiniteDimensional (ZMod 2) (Module.Dual (ZMod 2) (cocycles natural.dual)) :=
    Subspace.instModuleDualFiniteDimensional
  obtain ⟨t, ht, _⟩ := exists_universalCover_quotient doubledProjection doubledProjection_isCover
  have h := LinearMap.finrank_le_finrank_of_surjective (f := t.toLinearMap) ht
  rw [Subspace.dual_finrank_eq (K := ZMod 2) (V := cocycles natural.dual), finrank_doubled] at h
  exact le_antisymm dual_cocycles_finrank_le h

/-- Every doubled-natural cover is an equivariant quotient of U × U,
compatibly with its original projection. -/
lemma exists_doubled_quotient {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]
    [FiniteDimensional (ZMod 2) W] {σ : Representation (ZMod 2) MatrixGroup W}
    (p : σ.IntertwiningMap natural) (hp : IsCover p) :
    ∃ q : doubled.IntertwiningMap σ, Function.Surjective q ∧
      ∀ w, p (q w) = doubledProjection w := by
  let : FiniteDimensional (ZMod 2) (Module.Dual (ZMod 2) (cocycles natural.dual)) :=
    Subspace.instModuleDualFiniteDimensional
  obtain ⟨a, ha, hap⟩ := exists_universalCover_quotient p hp
  obtain ⟨b, hb, hbp⟩ := exists_universalCover_quotient doubledProjection doubledProjection_isCover
  have hdim : finrank (ZMod 2) (Module.Dual (ZMod 2) (cocycles natural.dual)) =
      finrank (ZMod 2) (U × U) := by
    rw [Subspace.dual_finrank_eq, dual_cocycles_finrank, finrank_doubled]
  let B : (universalAction natural.dual).dual.Equiv doubled :=
    Representation.Equiv.mk (LinearEquiv.ofBijective b.toLinearMap
      ⟨(LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdim).mpr hb, hb⟩)
      b.isIntertwining'
  refine ⟨a.comp B.symm.toIntertwiningMap, ha.comp B.symm.surjective, ?_⟩
  intro w
  change p (a (B.symm w)) = doubledProjection w
  rw [hap, ← hbp]
  change doubledProjection (B (B.symm w)) = doubledProjection w
  rw [B.apply_symm_apply]

/-- Every doubled-natural cover has kernel dimension at most two. -/
lemma cover_kernel_finrank_le_two {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]
    [FiniteDimensional (ZMod 2) W] {σ : Representation (ZMod 2) MatrixGroup W}
    (p : σ.IntertwiningMap natural) (hp : IsCover p) :
    finrank (ZMod 2) p.toLinearMap.ker ≤ 2 := by
  let : FiniteDimensional (ZMod 2) (Module.Dual (ZMod 2) (cocycles natural.dual)) :=
    Subspace.instModuleDualFiniteDimensional
  obtain ⟨t, ht, _⟩ := exists_universalCover_quotient p hp
  have hW := LinearMap.finrank_le_finrank_of_surjective (f := t.toLinearMap) ht
  rw [Subspace.dual_finrank_eq (K := ZMod 2) (V := cocycles natural.dual)] at hW
  have hpdim := p.toLinearMap.finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr hp.1, finrank_top, finrank_natural] at hpdim
  have h := dual_cocycles_finrank_le
  omega

/-- A nonzero doubled-natural covering kernel has dimension one or two. -/
lemma cover_kernel_finrank_cases {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]
    [FiniteDimensional (ZMod 2) W] {σ : Representation (ZMod 2) MatrixGroup W}
    (p : σ.IntertwiningMap natural) (hp : IsCover p) (hk : p.toLinearMap.ker ≠ ⊥) :
    finrank (ZMod 2) p.toLinearMap.ker = 1 ∨ finrank (ZMod 2) p.toLinearMap.ker = 2 := by
  have hle := cover_kernel_finrank_le_two p hp
  have hne : finrank (ZMod 2) p.toLinearMap.ker ≠ 0 :=
    fun h => hk (Submodule.finrank_eq_zero.mp h)
  omega

/-- A cover with a two-dimensional kernel is equivalent to the doubled model. -/
lemma equiv_doubled_of_kernel_finrank_eq_two {W : Type*} [AddCommGroup W]
    [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]
    {σ : Representation (ZMod 2) MatrixGroup W}
    (p : σ.IntertwiningMap natural) (hp : IsCover p)
    (hk : finrank (ZMod 2) p.toLinearMap.ker = 2) : Nonempty (σ.Equiv doubled) := by
  obtain ⟨q, hq, _⟩ := exists_doubled_quotient p hp
  have hW := p.toLinearMap.finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr hp.1, finrank_top, finrank_natural, hk] at hW
  have hdim : finrank (ZMod 2) (U × U) = finrank (ZMod 2) W :=
    finrank_doubled.trans hW
  let e : doubled.Equiv σ := Representation.Equiv.mk
    (LinearEquiv.ofBijective q.toLinearMap
      ⟨(LinearMap.injective_iff_surjective_of_finrank_eq_finrank hdim).mpr hq, hq⟩)
    q.isIntertwining'
  exact ⟨e.symm⟩

/-- The doubled natural module has no nonzero fixed vector. -/
lemma natural_fixed : fixed natural = ⊥ := by
  apply bot_unique
  intro v hv
  change v = 0
  funext i
  have hi : v i ∈ fixed base := fun g => congrFun (hv g) i
  rw [base_fixed] at hi
  exact hi

/-- The covering kernel is exactly the source’s fixed space. -/
lemma cover_kernel_eq_fixed {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]
    {σ : Representation (ZMod 2) MatrixGroup W}
    (p : σ.IntertwiningMap natural) (hp : IsCover p) : p.toLinearMap.ker = fixed σ := by
  apply le_antisymm hp.2.1
  intro w hw
  have h : p w ∈ fixed natural := by
    intro g
    rw [← p.isIntertwining, hw g]
  rw [natural_fixed] at h
  exact h

/-- The literal doubled natural matrix action is faithful. -/
lemma natural_injective : Function.Injective natural := by
  intro g t h
  have he : base g = base t := by
    apply LinearMap.ext
    intro v
    exact congrArg (fun f : Module.End (ZMod 2) (Fin 2 → V) => f (fun _ => v) 0) h
  exact Matrix.SpecialLinearGroup.toLin'_injective
    (LinearEquiv.toLinearMap_injective he)

/-- Surjectivity onto the faithful doubled natural action forces the
matrix-group homomorphism to be injective, without ambient faithfulness. -/
lemma embedding_injective_of_cover {W H : Type*} [AddCommGroup W] [Module (ZMod 2) W]
    [Group H] (δ : Representation (ZMod 2) H W) (ι : MatrixGroup →* H)
    (p : Representation.IntertwiningMap (δ.comp ι) natural) (hp : IsCover p) : Function.Injective ι := by
  intro g t h
  apply natural_injective
  apply LinearMap.ext
  intro v
  obtain ⟨w, rfl⟩ := hp.1 v
  rw [← p.isIntertwining, ← p.isIntertwining]
  change p (δ (ι g) w) = p (δ (ι t) w)
  rw [h]

end CFSG.Quasithin.ChapterC.BinaryMS.AbelianCore.DoubleCopy.CoverModels
