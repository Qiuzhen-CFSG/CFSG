module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.AbelianCore.QuotientRecognition.ModuleData
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.AbelianCore.QuotientRecognition.ExtensionControl

/-!
# Homogeneous natural quotients of binary SL₃(2) FF-modules

A faithful finite-dimensional binary representation generated by its
commutators, and admitting an offender, has a homogeneous natural quotient
by its full fixed space. The quotient coordinates use one automorphism of
the actual matrix group on every summand, including the dual orientation.

`ExtensionControl` proves the six-dimensional bound, obtains a natural head
from the irreducible catalogue, and excludes opposite natural orientations
using the additive fixed-codimension inequality. Its explicit matrix-derivation
argument splits the remaining homogeneous self-extension. The resulting
coordinates have precisely the fixed space as kernel; no splitting of the
original representation over that kernel is assumed.

This is the binary SL₃ specialization of the homogeneous alternatives in
Aschbacher–Smith B.5.1(1)(i),(ii),(3), printed pp.99–103, with the extension
arguments of B.4.8–9, pp.91–95, combined manuscript of 1 March 2004. The
whole-core group-action construction and the C.1.34 assembly remain separate.
-/

public section
namespace CFSG.Quasithin.ChapterC.BinaryMS.AbelianCore.QuotientRecognition

open Representation Representation.BinaryOffender

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V]

/-- A faithful commutator-generated binary SL₃(2) FF-module has actual
homogeneous natural coordinates modulo its full fixed space, with one common
automorphism marking on all summands. Reducibility and nonsplit extensions
are allowed in the hypotheses. -/
theorem exists_moduleQuotient (ρ : Representation (ZMod 2) SL V)
    (hρ : Function.Injective ρ) (hfull : subspaceCommutator ρ ⊤ ⊤ = ⊤)
    (hFF : IsFFModule ρ) : ∃ m : ℕ, Nonempty (ModuleQuotient ρ m) := by
  obtain ⟨m, _, hm⟩ := ExtensionControl.exists_moduleQuotient ρ hρ hfull hFF
  exact ⟨m, hm⟩

end CFSG.Quasithin.ChapterC.BinaryMS.AbelianCore.QuotientRecognition
