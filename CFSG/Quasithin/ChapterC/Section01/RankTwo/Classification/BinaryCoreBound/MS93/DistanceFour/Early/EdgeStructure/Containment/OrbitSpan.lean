module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Early.EdgeStructure.Containment.Reduction

/-!
# The actual conjugate-generated groups in the edge-containment proof

The source group generated by the G_alpha-conjugates of Z_delta lies in
V_alpha when delta is at distance at most two. We retain the actual ambient
conjugation, the relative normality in G_alpha, and its exact commutator
formula. The initial radius bound places its derived subgroup in Z_alpha.
If the seed commutator is central in G_alpha, conjugate generation does not
increase it. Proving that centrality and proving the span abelian are separate
steps; neither is imposed by this definition.

Source: Meierfrankenfeld--Stellmacher (1993), (4.6.4), first paragraph,
printed p.902, the groups denoted V_1 and V_0.
-/

public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Early.Containment
variable {M : Type*} [Group M] {L R : Subgroup M}
  {source : LocalSource L R} {geometry : Geometry R}
  (common : CommonFacts R source geometry)

/-- All conjugates by the specified local stabilizer, in the original amalgam. -/
@[expose] noncomputable def neighborSpan (a d : Vertex R) : Subgroup (FreeAmalgam R) :=
  ⨆ g : stabilizer R a, (Z R d).map (MulAut.conj (g : FreeAmalgam R)).toMonoidHom

/-- The seed is retained in the actual generated subgroup. -/
theorem Z_le_neighborSpan (a d : Vertex R) : Z R d ≤ neighborSpan a d := by
  intro x hx
  apply le_iSup (fun g : stabilizer R a =>
    (Z R d).map (MulAut.conj (g : FreeAmalgam R)).toMonoidHom) 1
  exact ⟨x, hx, by simp⟩

/-- Conjugation by G_alpha preserves the radius and hence the local span. -/
theorem neighborSpan_le_radius (a d : Vertex R)
    (hd : (cosetGraph R).dist d a ≤ 2) : neighborSpan a d ≤ V R a :=
  iSup_conjugates_le_of_le_normalizer (Z R d) (stabilizer R a) (V R a)
    (le_iSup_of_le d (le_iSup_of_le hd le_rfl)) (V_normalized a)

/-- Normalization refers to the local stabilizer, not to the free amalgam. -/
theorem neighborSpan_normalized (a d : Vertex R) :
    stabilizer R a ≤ normalizer (neighborSpan a d : Set (FreeAmalgam R)) :=
  le_normalizer_iSup_conjugates (Z R d) (stabilizer R a)

include common in
/-- The exact commutator of the span is generated by conjugates of the
original commutator with Q_alpha. -/
theorem neighborSpan_commutator (a d : Vertex R) (ha : color R a = false)
    (hd : (cosetGraph R).dist d a ≤ 2) :
    ⁅neighborSpan a d, Q R a⁆ =
      ⨆ g : stabilizer R a, (⁅Z R d, Q R a⁆).map
        (MulAut.conj (g : FreeAmalgam R)).toMonoidHom := by
  have hZ : Z R d ≤ V R a := le_iSup_of_le d (le_iSup_of_le hd le_rfl)
  exact commutator_iSup_conjugates (Z R d) (stabilizer R a) (Q R a)
    (hZ.trans (radius_le_Q common a ha))
    (Q_normalized R a)

include common in
/-- The initial centrality input bounds the derived subgroup of every span. -/
theorem neighborSpan_derived_le_Z (initial : InitialFacts R geometry)
    (a d : Vertex R) (ha : color R a = false)
    (hd : (cosetGraph R).dist d a ≤ 2) :
    ⁅neighborSpan a d, neighborSpan a d⁆ ≤ Z R a :=
  (commutator_mono (neighborSpan_le_radius a d hd) (neighborSpan_le_radius a d hd)).trans
    (derived_le_Z_of_commutator_central common a ha (initial.commutator_central a ha))

include common in
/-- A central seed commutator is unchanged by conjugate generation. This is
the propagation step after the simultaneous-nonnormality argument on p.902. -/
theorem neighborSpan_commutator_eq_of_central (a d : Vertex R)
    (ha : color R a = false) (hd : (cosetGraph R).dist d a ≤ 2)
    (hc : ⁅Z R d, Q R a⁆ ≤ centralizer (stabilizer R a : Set (FreeAmalgam R))) :
    ⁅neighborSpan a d, Q R a⁆ = ⁅Z R d, Q R a⁆ := by
  rw [neighborSpan_commutator common a d ha hd]
  apply le_antisymm
  · apply iSup_le
    intro g
    rintro _ ⟨x, hx, rfl⟩
    have he : (g : FreeAmalgam R) * x * (g : FreeAmalgam R)⁻¹ = x := by
      rw [hc hx g g.property, mul_inv_cancel_right]
    change (g : FreeAmalgam R) * x * (g : FreeAmalgam R)⁻¹ ∈ ⁅Z R d, Q R a⁆
    rw [he]
    exact hx
  · intro x hx
    apply le_iSup (fun g : stabilizer R a =>
      (⁅Z R d, Q R a⁆).map (MulAut.conj (g : FreeAmalgam R)).toMonoidHom) 1
    exact ⟨x, hx, by simp⟩

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Early.Containment
