module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Flags.RankOne.Triple.Preparatory.Propagation.Span
public import Theory.GroupAction.SubgroupQuotientFullAction

/-!
# The actual midpoint quotient before the flag propagation case split

The early commutator bound suffices to make V_alpha/Z_alpha elementary
abelian: V_alpha is generated by involutions and its derived subgroup is
contained in Z_alpha. Consequently the same holds for V₀/Z_alpha. Its
conjugation action descends through the supplied marked SL₃(2) quotient.
The equation on representatives retains the original embedding of M.

Only EarlyFacts is used. In particular these constructions do not require
the later radius-derived equality or any RadiusFacts, and they make no
assertion that this quotient has a single natural section.

Source: Meierfrankenfeld--Stellmacher (1993), the V₀/Z_alpha case split in
(4.6.8), claim (2), printed p.906, using (4.6.1)--(4.6.7).
-/

public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Flags.RankOne.Propagation
variable {M : Type*} [Group M] {L R : Subgroup M}
  {source : LocalSource L R} {geometry : Geometry R} {i : Bool}

/-- The early bound and involution generation put every radius square in Z_alpha. -/
theorem radius_square_mem_Z (common : CommonFacts R source geometry)
    (early : EarlyFacts R geometry) (x : V R (alpha R)) :
    (x : FreeAmalgam R) ^ 2 ∈ Z R (alpha R) := by
  let P := V R (alpha R)
  let f : P →* Abelianization P := (powMonoidHom 2).comp Abelianization.of
  have hle : P ≤ f.ker.map P.subtype := by
    change VBall R (alpha R) 2 ≤ _
    conv_lhs => rw [← DistanceEight.VBall_omegaOne R (alpha R) 2]
    apply (omegaOneAmbient_le_iff _ _).mpr
    intro y hy hy2
    refine ⟨⟨y, hy⟩, ?_, rfl⟩
    change (Abelianization.of (⟨y, hy⟩ : P)) ^ 2 = 1
    rw [← map_pow, show (⟨y, hy⟩ : P) ^ 2 = 1 from Subtype.ext hy2, map_one]
  obtain ⟨y, hy, he⟩ := hle x.property
  change (y : FreeAmalgam R) = x at he
  have hpow : y ^ 2 ∈ commutator P := by
    rw [← Abelianization.ker_of P]
    change Abelianization.of (y ^ 2) = 1
    rw [map_pow]
    exact hy
  have hh := mem_map_of_mem P.subtype hpow
  rw [map_subtype_commutator] at hh
  have hderived : ⁅P, P⁆ ≤ Z R (alpha R) :=
    (commutator_mono le_rfl (V_le_Q geometry common.large_distance _ rfl)).trans
      (early.commutator_le_Z _ rfl)
  apply hderived
  simpa only [subtype_apply, coe_pow, he] using hh

/-- The denominator is normal inside V₀, without any ambient normality assumption. -/
theorem span_denominator_normal (common : CommonFacts R source geometry)
    (p : FlagCriticalData source geometry i) :
    ((Z R (alpha R)).subgroupOf (midpointSpan p)).Normal :=
  normal_subgroupOf_of_le_normalizer
    (((span_le_radius p).trans (geometry.V_local _ rfl common.large_distance)).trans
      (Z_normalized R _))

/-- V₀/Z_alpha is an elementary abelian group by the literal quotient construction. -/
theorem span_quotient_elementary (common : CommonFacts R source geometry)
    (early : EarlyFacts R geometry) (p : FlagCriticalData source geometry i) :
    letI := span_denominator_normal common p
    IsElementaryAbelian 2 (midpointSpan p ⧸ (Z R (alpha R)).subgroupOf (midpointSpan p)) := by
  let := span_denominator_normal common p
  let S := midpointSpan p
  let N := (Z R (alpha R)).subgroupOf S
  have hderived : _root_.commutator S ≤ N := by
    intro x hx
    have hh := mem_map_of_mem S.subtype hx
    rw [map_subtype_commutator] at hh
    exact ((commutator_mono (span_le_radius p)
      ((span_le_radius p).trans (V_le_Q geometry common.large_distance _ rfl))).trans
        (early.commutator_le_Z _ rfl)) hh
  let : IsMulCommutative (S ⧸ N) :=
    Normal.quotient_commutative_iff_commutator_le.mpr hderived
  refine { exponent_dvd_p := ?_ }
  rw [Monoid.exponent_dvd_iff_forall_pow_eq_one]
  intro x
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective N x
  rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
  exact radius_square_mem_Z common early ⟨y, span_le_radius p y.property⟩

/-- The action on the intrinsic quotient descends through the original source marking. -/
theorem exists_span_quotient_action [Finite M] (common : CommonFacts R source geometry)
    (early : EarlyFacts R geometry) (p : FlagCriticalData source geometry i) :
    letI := span_denominator_normal common p
    ∃ ρ : SL →* MulAut
        (midpointSpan p ⧸ (Z R (alpha R)).subgroupOf (midpointSpan p)),
      ∀ (m : M) (x y : midpointSpan p),
        (y : FreeAmalgam R) = embedM R m * (x : FreeAmalgam R) * (embedM R m)⁻¹ →
        ρ (source.projection m)
            (QuotientGroup.mk' ((Z R (alpha R)).subgroupOf (midpointSpan p)) x) =
          QuotientGroup.mk' ((Z R (alpha R)).subgroupOf (midpointSpan p)) y := by
  let := span_denominator_normal common p
  let S := midpointSpan p
  let N := (Z R (alpha R)).subgroupOf S
  let D := S ⧸ N
  let P := Mbar R
  have hPS : P ≤ normalizer S := by
    simpa only [alpha, stabilizer_m_base] using span_normalized p
  have hPZ : P ≤ normalizer (Z R (alpha R)) := by
    simpa only [alpha, stabilizer_m_base] using Z_normalized R (alpha R)
  obtain ⟨a, ha⟩ := exists_quotient_conjugation_action P S (Z R (alpha R)) hPS hPZ
    (span_denominator_normal common p)
  let j : M →* P := (embedM R).rangeRestrict
  let aM : M →* MulAut D := a.comp j
  have hkill : source.projection.ker ≤ aM.ker := by
    intro m hm
    have hmQ : embedM R m ∈ Q R (alpha R) := by
      rw [Q_alpha R source.two_group source.core_le]
      exact mem_map_of_mem _ (source.projection_kernel ▸ hm)
    exact quotient_conjugation_action_kills_commutator_layer P S (Z R (alpha R))
      (Q R (alpha R)) (span_denominator_normal common p) hPS
      (span_commutator_le_Z early p) a ha hmQ
  let aSL : SL →* MulAut D := source.projection.liftOfSurjective
    source.projection_surjective ⟨aM, hkill⟩
  have haSL (m : M) : aSL (source.projection m) = aM m :=
    MonoidHom.liftOfRightInverse_comp_apply _ _ _ _ _
  refine ⟨aSL, ?_⟩
  intro m x y hy
  rw [haSL, show aM m = a (j m) from rfl, ha]
  congr 1
  exact Subtype.ext hy.symm

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Flags.RankOne.Propagation
