module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.RankOnePairing.Incidence.FixedGeometry.ValueConstruction.ModelProof

/-!
# The concrete opposite-parabolic orbit requiring natural two-space coordinates

The span is the subgroup generated by the actual orbit of one vector under
the opposite marked parabolic. `PlaneCoordinates` asks for an isomorphism
of this literal subgroup with the binary two-space and a surjective SL2
actor map obeying its matrix action. It assumes neither a span dimension
nor a representation-family label. Its constructor remains a separate
matrix calculation for a nonzero vector fixed by the first parabolic.

Source: Meierfrankenfeld--Stellmacher (1993), (1.7), pp.847--848, as used
in the first quotient application on printed p.883.
-/

@[expose] public section

open Subgroup
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.Escape.PairingControl.FirstPairing.Orientation.QuotientApplication.NaturalGeneration
open RankOnePairing.Incidence.FixedGeometry.ValueConstruction

/-- The actual opposite-parabolic orbit span in the marked natural three-space. -/
def oppositeSpan (σ : MulAut SL) (flag : SL) (i : Bool) (v : VectorGroup) :
    Subgroup VectorGroup :=
  closure (Set.range fun g : modelParabolic flag (!i) => vectorAction (σ g) v)

/-- A coordinate isomorphism and a compatible surjective actor map.
Keeping the subgroup parameters abstract avoids expanding concrete matrix
inverse expressions while generating the structure's recursors. -/
structure NaturalPlane (σ : MulAut SL) (P : Subgroup SL) (T : Subgroup VectorGroup) where
  projection : P →* SL2
  surjective : Function.Surjective projection
  coordinates : T ≃* Multiplicative (Fin 2 → ZMod 2)
  action : ∀ (g : P) (x y : T),
    (y : VectorGroup) = vectorAction (σ (g : SL)) (x : VectorGroup) →
    Multiplicative.toAdd (coordinates y) =
      (projection g).val.mulVec (Multiplicative.toAdd (coordinates x))

/-- Specialization to exactly the opposite parabolic and its orbit span. -/
abbrev PlaneCoordinates (σ : MulAut SL) (flag : SL) (i : Bool) (v : VectorGroup) :=
  NaturalPlane σ (modelParabolic flag (!i)) (oppositeSpan σ flag i v)

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.Escape.PairingControl.FirstPairing.Orientation.QuotientApplication.NaturalGeneration
