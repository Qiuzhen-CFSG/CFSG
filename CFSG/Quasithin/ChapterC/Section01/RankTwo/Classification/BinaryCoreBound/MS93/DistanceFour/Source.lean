module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Core
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Linear

/-!
# Source interfaces for the distance-four local and module arguments

`EarlyFacts` and `RadiusFacts` collect the local conclusions needed from
MS93 (4.6.1)--(4.6.10). They have no constructors here. The center in `B_eq_center`
field is the center of the radius-two group, not the commutator core.
`DoubleDualQuotient` is a genuine quotient map of the core by U_alpha with
two contragredient factors, using exactly the marking of the given natural
U_alpha. Its action equation is ambient conjugation by the original embedM.
Constructing this map is the remaining module argument (4.6.11)--(4.6.12),
not a consequence asserted by this interface.

The definitions of nu, the edge star and its stabilizer span are literal:
nu(a) consists of distance-two vertices whose Z-layer is not contained in B_a.
Source: Meierfrankenfeld--Stellmacher (1993), notation on printed p.881,
(4.6.3)--(4.6.10) on pp.901--908, and (4.6.11)--(4.6.12) on pp.909--912.
The original paper prints two different assertions with label (4.6.6).

Publishing these records does not prove the recorded source conclusions.
The final center assembly must construct both witnesses from the common
source hypotheses and b = 4.
-/

@[expose] public section

namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour
open Subgroup Stellmacher.PushingUp.AmalgamGraph
variable {M : Type*} [Group M] (R : Subgroup M) (geometry : Geometry R)

def nu (a t : Vertex R) : Prop :=
  (cosetGraph R).dist t a = 2 ∧ ¬ Z R t ≤ B R a (geometry.Z_normal a)

noncomputable def edgeStar (a b : Vertex R) : Subgroup (FreeAmalgam R) :=
  ⨆ t, ⨆ (_ : nu R geometry a t ∧ Adjacent R b t), Z R t

noncomputable def VStar (a b : Vertex R) : Subgroup (FreeAmalgam R) :=
  ⨆ g : stabilizer R a,
    (edgeStar R geometry a b).map (MulAut.conj (g : FreeAmalgam R)).toMonoidHom

/-- The local output through (4.6.7), for the subsequent rank-one argument. -/
structure EarlyFacts : Prop where
  commutator_central : ∀ a, color R a = false →
    ⁅V R a, Q R a⁆ ≤ (center (V R a)).map (V R a).subtype
  commutator_le_Z : ∀ a, color R a = false → ⁅V R a, Q R a⁆ ≤ Z R a
  edge_commutator_card : ∀ a b, color R a = false → Adjacent R a b →
    Nat.card (⁅Z R a, Q R b⁆ : Subgroup (FreeAmalgam R)) = 4
  edge_Z_index : ∀ a b, color R a = false → Adjacent R a b →
    (Z R b).relIndex (Z R a) = 2
  edge_Q_index : ∀ a b, color R a = false → Adjacent R a b →
    (Q R a).relIndex (Q R b) = 4
  derived_noncentral : ∀ a, color R a = false →
    ¬ ⁅V R a, V R a⁆ ≤ (center (stabilizer R a)).map (stabilizer R a).subtype
  B_eq_center : ∀ a, color R a = false →
    B R a (geometry.Z_normal a) = (center (V R a)).map (V R a).subtype

/-- Conditional output through (4.6.10). No center of the core is a field.
The core/moving identity is used explicitly on printed p.909. -/
structure RadiusFacts : Prop extends EarlyFacts R geometry where
  radius_derived : ∀ a, color R a = false → ⁅V R a, V R a⁆ = U R a
  core_le_radius : ∀ a, color R a = false → core R a ≤ V R a
  star_commutator : ∀ a b, color R a = false → Adjacent R a b →
    ⁅VStar R geometry a b, Q R a⁆ = U R a
  star_intersection : ∀ a b, color R a = false → Adjacent R a b →
    VStar R geometry a b ⊓ B R a (geometry.Z_normal a) = Z R a
  core_eq_moving : ∀ a, color R a = false → core R a = Vcirc R a

/-- The source's noncentral radius-derived subgroup also rules out an abelian
core if the radius group is generated by that core and its own center.
The generation equality is an explicit extra premise, not a field claimed
as a literal conclusion of (4.6.9). -/
theorem RadiusFacts.core_not_commutative_of_radius_generation (facts : RadiusFacts R geometry)
    (a : Vertex R) (ha : color R a = false)
    (hgen : V R a = B R a (geometry.Z_normal a) ⊔ core R a) :
    ¬ IsMulCommutative (core R a) := by
  intro hc
  have hBV : B R a (geometry.Z_normal a) ≤ centralizer (V R a : Set (FreeAmalgam R)) := by
    rw [facts.B_eq_center a ha]
    rintro x ⟨z, hz, rfl⟩ y hy
    exact congrArg Subtype.val ((mem_center_iff.mp hz) ⟨y, hy⟩)
  have hCV : core R a ≤ centralizer (V R a : Set (FreeAmalgam R)) := by
    apply le_centralizer_iff.mpr
    rw [hgen]
    exact sup_le (hBV.trans (centralizer_le (facts.core_le_radius a ha)))
      (le_centralizer_iff_isMulCommutative.mpr hc)
  have hv : IsMulCommutative (V R a) :=
    le_centralizer_iff_isMulCommutative.mp (by
      conv_lhs => rw [hgen]
      exact sup_le hBV hCV)
  apply facts.derived_noncentral a ha
  rw [commutator_self_eq_bot_iff.mpr hv]
  exact bot_le

variable {R geometry} {L : Subgroup M} (source : LocalSource L R)
  (common : CommonFacts R source geometry)

/-- A quotient by the actual U_alpha, with the action on both factors dual to
the supplied marking on U_alpha. The noncommutativity clause ensures the
actual commutator pairing is nonzero; its proof is part of the source
construction. This specifies maps, not just dimensions. -/
structure DoubleDualQuotient where
  quotient : core R (alpha R) →* Multiplicative (Linear.W × Linear.W)
  onto : Function.Surjective quotient
  kernel : quotient.ker = (U R (alpha R)).subgroupOf (core R (alpha R))
  noncommutative : ¬ IsMulCommutative (core R (alpha R))
  action : ∀ (m : M) (x y : core R (alpha R)),
    (y : FreeAmalgam R) = embedM R m * (x : FreeAmalgam R) * (embedM R m)⁻¹ →
    (quotient y).toAdd =
      (Linear.dual (common.natural.marking (source.projection m)) (quotient x).toAdd.1,
       Linear.dual (common.natural.marking (source.projection m)) (quotient x).toAdd.2)

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour
