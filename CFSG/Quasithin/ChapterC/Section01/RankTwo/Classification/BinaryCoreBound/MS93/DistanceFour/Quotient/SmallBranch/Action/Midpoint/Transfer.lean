module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Quotient.SmallBranch.Action.Midpoint.Basic
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Early.EdgeStructure.Basic

/-!
# Transferring the midpoint fixed bound to the core quotient

Let t be the common neighbor of alpha and the critical midpoint. The actual
midpoint actor has order four, so the edge index gives Q_alpha Q_middle = Q_t.
Critical escape puts Z_middle in the starred span at alpha. Consequently
[Z_middle,Q_t] lies in U_alpha. The intersection Z_alpha intersect Z_middle
centralizes both kernels and hence Q_t, placing it in Z_t. The order-four edge
commutator is exactly U_middle intersect Z_t, and therefore
U_middle intersect Z_alpha is contained in U_alpha.

The midpoint radius group is generated by its center B_middle and its starred
span. The center centralizes Z_alpha and thus lies in Q_alpha. For the subgroup
core_alpha intersect Q_middle, the B-factor commutator lies in U_alpha by the
kernel-action bound. The starred-factor commutator lies in U_middle, and the
small-intersection hypothesis also puts it in Z_alpha. The preceding intersection
bound completes the transfer. The existing relative-index lemma then gives the
fixed-preimage index at most four on the actual core/U quotient.

The order-four premise is explicit for independent assembly with its producer.
All finiteness is inherited from vertex stabilizers, and normality remains local.
Source: Meierfrankenfeld--Stellmacher, Pushing up weak BN-pairs of rank two
(1993), (4.6.9)--(4.6.11), printed pp.908--909. This supplies the passage from
the printed V_alpha/Z_alpha fixed bound to the quotient used with (1.4), p.842.
-/

public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.SmallBranch
variable {M : Type*} [Group M] [Finite M] {L R : Subgroup M}
    (source : LocalSource L R) (geometry : Geometry R)
    (common : CommonFacts R source geometry) (radius : RadiusFacts R geometry)

omit [Finite M] in
private theorem midpoint_edge_color (t : Vertex R)
    (hat : Adjacent R (alpha R) t) : color R t = true := by
  have hn := adjacent_color_ne R hat
  have ha : color R (alpha R) = false := rfl
  cases h : color R t <;> simp_all

include common radius in
private theorem midpoint_kernel_sup (s : CriticalSegment geometry)
    (hcard : Nat.card (midpointActor (source := source) s) = 4)
    (t : Vertex R) (hat : Adjacent R (alpha R) t) (hmt : Adjacent R s.middle t) :
    Q R (alpha R) ⊔ Q R s.middle = Q R t := by
  have ht := midpoint_edge_color t hat
  have haQ : Q R (alpha R) ≤ Q R t := Q_le_adjacent_h R ht hat
  have hmQ : Q R s.middle ≤ Q R t := Q_le_adjacent_h R ht hmt
  let S := Q R (alpha R) ⊔ Q R s.middle
  have hS : S ≤ Q R t := sup_le haQ hmQ
  let : Finite (stabilizer R t) := finite_stabilizer R t
  let : Finite (Q R t) := Finite.of_injective (inclusion (show Q R t ≤ stabilizer R t from
    fun _ hx => hx.1)) (inclusion_injective _)
  let : Finite S := Finite.of_injective (inclusion hS) (inclusion_injective _)
  have hV : V R s.middle ≤ S :=
    (Flags.V_le_Q geometry common.large_distance s.middle s.middle_color).trans le_sup_right
  have hi : (Q R (alpha R)).relIndex (V R s.middle) = 4 := by
    rw [← midpointActor_card_eq_relIndex source geometry common s]
    exact hcard
  have hlo := relIndex_le_of_le_right hV
    (show (Q R (alpha R)).relIndex S ≠ 0 from Subgroup.index_ne_zero_of_finite)
  rw [hi] at hlo
  have hmul := relIndex_mul_relIndex (Q R (alpha R)) S (Q R t) le_sup_left hS
  rw [radius.edge_Q_index (alpha R) t rfl hat] at hmul
  have hpos : S.relIndex (Q R t) ≠ 0 := Subgroup.index_ne_zero_of_finite
  have hone : S.relIndex (Q R t) = 1 := by nlinarith
  exact le_antisymm hS (relIndex_eq_one.mp hone)

include common radius in
private theorem midpoint_Z_le_star (hb : geometry.b R = 4) (s : CriticalSegment geometry)
    (t : Vertex R) (hat : Adjacent R (alpha R) t) (hmt : Adjacent R s.middle t) :
    Z R s.middle ≤ VStar R geometry (alpha R) t := by
  have ht := midpoint_edge_color t hat
  apply Flags.nu_Z_le_star geometry radius.toEarlyFacts (alpha R) t s.middle rfl hat
  refine ⟨?_, ?_⟩
  · rw [SimpleGraph.dist_comm]
    exact s.first_distance
  · intro hB
    apply midpoint_radius_not_le source geometry common hb s
    rw [← common.centralizer s.middle t s.middle_color hmt]
    refine le_inf ((Flags.V_le_Q geometry common.large_distance (alpha R) rfl).trans
      (Q_le_adjacent_h R ht hat)) ?_
    apply le_centralizer_iff.mpr
    intro z hz v hv
    have hb := hB hz
    rw [radius.B_eq_center (alpha R) rfl] at hb
    obtain ⟨w, hw, he⟩ := hb
    change (w : FreeAmalgam R) = z at he
    have hc := congrArg Subtype.val ((mem_center_iff.mp hw) ⟨v, hv⟩)
    simpa only [coe_mul, he] using hc

include common radius in
private theorem midpoint_edge_commutator_le_U (hb : geometry.b R = 4)
    (s : CriticalSegment geometry)
    (hcard : Nat.card (midpointActor (source := source) s) = 4)
    (t : Vertex R) (hat : Adjacent R (alpha R) t) (hmt : Adjacent R s.middle t) :
    ⁅Z R s.middle, Q R t⁆ ≤ U R (alpha R) := by
  have hgen := midpoint_kernel_sup source geometry common radius s hcard t hat hmt
  have heq := commutator_eq_of_centralizing_sup
    ((sup_comm _ _).trans hgen)
    (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp
      (geometry.centralizes s.middle s.middle_color)))
    ((Q_le_stabilizer_of_dist_two R (alpha R) s.middle rfl s.first_distance).trans
      (Z_normalized R s.middle))
  rw [← heq, ← radius.star_commutator (alpha R) t rfl hat]
  exact commutator_mono
    (midpoint_Z_le_star source geometry common radius hb s t hat hmt) le_rfl

include common radius in
private theorem midpoint_Z_inter_le_edge (s : CriticalSegment geometry)
    (hcard : Nat.card (midpointActor (source := source) s) = 4)
    (t : Vertex R) (hat : Adjacent R (alpha R) t) (hmt : Adjacent R s.middle t) :
    Z R (alpha R) ⊓ Z R s.middle ≤ Z R t := by
  rw [Early.edge_Z_eq_fixed common (alpha R) t rfl hat]
  refine le_inf inf_le_left ?_
  apply le_centralizer_iff.mpr
  rw [← midpoint_kernel_sup source geometry common radius s hcard t hat hmt]
  apply sup_le
  · exact (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp
      (geometry.centralizes (alpha R) rfl))).trans (centralizer_le inf_le_left)
  · exact (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp
      (geometry.centralizes s.middle s.middle_color))).trans (centralizer_le inf_le_right)

include common radius in
private theorem midpoint_U_inter_Z_le_U (hb : geometry.b R = 4)
    (s : CriticalSegment geometry)
    (hcard : Nat.card (midpointActor (source := source) s) = 4)
    (t : Vertex R) (hat : Adjacent R (alpha R) t) (hmt : Adjacent R s.middle t) :
    U R s.middle ⊓ Z R (alpha R) ≤ U R (alpha R) := by
  have hD := midpoint_edge_commutator_le_U source geometry common radius hb s hcard t hat hmt
  have hZZ := midpoint_Z_inter_le_edge source geometry common radius s hcard t hat hmt
  have hDedge : ⁅Z R s.middle, Q R t⁆ ≤ Z R t :=
    (le_inf (hD.trans (DistanceEight.U_le_Z R (alpha R)))
      ((Early.edge_commutator_le_natural common s.middle t s.middle_color hmt).trans
        (DistanceEight.U_le_Z R s.middle))).trans hZZ
  have heq := Early.edge_fixed_natural_eq_commutator common s.middle t s.middle_color hmt
    hDedge (radius.edge_commutator_card s.middle t s.middle_color hmt)
  apply le_trans ?_ (heq.trans_le hD)
  exact le_inf inf_le_left
    ((le_inf inf_le_right (inf_le_left.trans (DistanceEight.U_le_Z R s.middle))).trans hZZ)

include common radius in
private theorem midpoint_B_le_Q (s : CriticalSegment geometry)
    (t : Vertex R) (hat : Adjacent R (alpha R) t) (hmt : Adjacent R s.middle t) :
    B R s.middle (geometry.Z_normal s.middle) ≤ Q R (alpha R) := by
  have ht := midpoint_edge_color t hat
  rw [← common.centralizer (alpha R) t rfl hat, radius.B_eq_center s.middle s.middle_color]
  refine le_inf ((map_subtype_le _).trans
    ((Flags.V_le_Q geometry common.large_distance s.middle s.middle_color).trans
      (Q_le_adjacent_h R ht hmt))) ?_
  rintro x ⟨z, hz, rfl⟩ y hy
  have hZaV : Z R (alpha R) ≤ V R s.middle :=
    le_iSup_of_le (alpha R) (le_iSup_of_le s.first_distance.le le_rfl)
  have hyV : y ∈ V R s.middle := hZaV hy
  exact congrArg Subtype.val ((mem_center_iff.mp hz) ⟨y, hyV⟩)

include common radius in
/-- The small-intersection commutator transfers from Z_alpha to U_alpha on the core. -/
theorem midpoint_commutator_le_U (hb : geometry.b R = 4)
    (s : CriticalSegment geometry) (hs : s.SmallIntersection)
    (hcard : Nat.card (midpointActor (source := source) s) = 4) :
    ⁅core R (alpha R) ⊓ Q R s.middle, V R s.middle⁆ ≤ U R (alpha R) := by
  obtain ⟨t, hat, hmt⟩ := exists_common_neighbor_of_dist_two R
    (alpha R) s.middle s.first_distance
  let H := core R (alpha R) ⊓ Q R s.middle
  have hstar : ⁅H, VStar R geometry s.middle t⁆ ≤ U R (alpha R) := by
    apply le_trans ?_ (midpoint_U_inter_Z_le_U source geometry common radius hb s hcard t hat hmt)
    apply le_inf
    · rw [commutator_comm, ← radius.star_commutator s.middle t s.middle_color hmt]
      exact commutator_mono le_rfl inf_le_right
    · exact (commutator_mono
        (inf_le_inf_right _ (radius.core_le_radius (alpha R) rfl))
        (Flags.star_le_radius geometry s.middle t)).trans hs
  have hB : ⁅H, B R s.middle (geometry.Z_normal s.middle)⁆ ≤ U R (alpha R) :=
    (commutator_mono inf_le_left
      (midpoint_B_le_Q source geometry common radius s t hat hmt)).trans
      (core_commutator_Q_le_U source geometry common radius (alpha R) t rfl hat)
  have hV : V R s.middle ≤ stabilizer R (alpha R) := by
    simpa only [alpha, stabilizer_m_base] using midpoint_locality source geometry common s
  have hpre : V R s.middle ≤
      commutatorPreimage (stabilizer R (alpha R)) H (U R (alpha R)) := by
    rw [Flags.radius_eq_B_sup_star geometry radius.toEarlyFacts common.large_distance
      s.middle t s.middle_color hmt]
    apply sup_le
    · apply le_commutatorPreimage _ (by rwa [commutator_comm])
      rw [radius.B_eq_center s.middle s.middle_color]
      exact (map_subtype_le _).trans hV
    · exact le_commutatorPreimage ((Flags.star_le_radius geometry s.middle t).trans hV)
        (by rwa [commutator_comm])
  rw [commutator_comm]
  exact (commutator_mono hpre le_rfl).trans
    (commutator_commutatorPreimage_le _ _ _ (Flags.U_normalized (alpha R)))

include common radius in
/-- The actual core/U fixed preimage has index at most four for the midpoint actor. -/
theorem midpoint_fixed_index (hb : geometry.b R = 4)
    (s : CriticalSegment geometry) (hs : s.SmallIntersection)
    (hcard : Nat.card (midpointActor (source := source) s) = 4) :
    (commutatorPreimage (core R (alpha R)) (V R s.middle) (U R (alpha R))).relIndex
      (core R (alpha R)) ≤ 4 := by
  exact midpoint_fixed_index_of_commutator source geometry common radius s
    (midpoint_commutator_le_U source geometry common radius hb s hs hcard)
end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.SmallBranch
