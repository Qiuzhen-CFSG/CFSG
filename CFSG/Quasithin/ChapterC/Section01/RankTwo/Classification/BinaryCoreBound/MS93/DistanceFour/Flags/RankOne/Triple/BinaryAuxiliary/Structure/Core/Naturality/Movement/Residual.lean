module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Flags.RankOne.Triple.BinaryAuxiliary.Structure.Core.Naturality.Quotient
public import Theory.SpecificGroups.PSL3Two.Parabolics.MarkedProduct
public import Theory.SpecificGroups.PSL3Two.Parabolics.MarkedAutomorphisms.TranslationCommutator
public import Theory.ThreeSubgroups

/-!
# Residual detection of the literal D/core displacement

The marked parabolic four-group is generated by its commutators with the
actual two-residual. Pulling this identity through the original quotient
puts the full local core in [core,residual] Q_alpha. The relative
three-subgroups lemma, [D,P] <= U and [U,core] <= Z_alpha then show that
residual fixation of X/Z_alpha forces [D,core] <= Z_alpha.

Thus residual movement is equivalent to nonzero D/core displacement.
This does not assert nonzero displacement; the incident-layer calculation
must still supply it. D retains the full untilded actor throughout.

Source: Meierfrankenfeld--Stellmacher (1993), (4.6.8), printed p.907.
-/

public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
open scoped commutatorElement
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Flags.RankOne.BinaryAuxiliary

private theorem model_core_eq_commutator_residual (g : SL) (i : Bool) :
    (modelParabolic g i).pCoreIn 2 =
      ⁅(modelParabolic g i).pCoreIn 2,
        (pResidual 2 (modelParabolic g i)).map (modelParabolic g i).subtype⁆ := by
  have hp : Matrix.PSL3Two.pointParabolicSL.pCoreIn 2 =
      ⁅Matrix.PSL3Two.pointParabolicSL.pCoreIn 2,
        (pResidual 2 Matrix.PSL3Two.pointParabolicSL).map
          Matrix.PSL3Two.pointParabolicSL.subtype⁆ := by
    rw [Matrix.PSL3Two.MarkedProduct.pointParabolic_core]
    exact Matrix.PSL3Two.MarkedAutomorphisms.pointV_eq_commutator_residual
  have hl : Matrix.PSL3Two.lineParabolicSL.pCoreIn 2 =
      ⁅Matrix.PSL3Two.lineParabolicSL.pCoreIn 2,
        (pResidual 2 Matrix.PSL3Two.lineParabolicSL).map
          Matrix.PSL3Two.lineParabolicSL.subtype⁆ := by
    have h := congrArg (fun H : Subgroup SL => H.map
      Matrix.PSL3Two.MarkedAutomorphisms.diagram.toMonoidHom) hp
    rw [map_commutator,
      map_pCoreIn_of_injective 2 _ _ Matrix.PSL3Two.MarkedAutomorphisms.diagram.injective,
      map_embedded_pResidual,
      Matrix.PSL3Two.MarkedAutomorphisms.pointParabolic_map_diagram] at h
    exact h
  cases i
  · have h := congrArg (fun H : Subgroup SL => H.map (MulAut.conj g).toMonoidHom) hp
    rw [map_commutator, map_pCoreIn_of_injective 2 _ _ (MulAut.conj g).injective,
      map_embedded_pResidual] at h
    exact h
  · have h := congrArg (fun H : Subgroup SL => H.map (MulAut.conj g).toMonoidHom) hl
    rw [map_commutator, map_pCoreIn_of_injective 2 _ _ (MulAut.conj g).injective,
      map_embedded_pResidual] at h
    exact h

variable {M : Type*} [Group M] [Finite M] {L R : Subgroup M}

/-- The original marked core is generated modulo Q_alpha by residual commutators. -/
theorem flagKernel_le_commutator_residual_sup_vertexKernel
    (source : LocalSource L R) (i : Bool) :
    flagKernel source i ≤ ⁅flagKernel source i, flagResidual source i⁆ ⊔ Q R (alpha R) := by
  let P := parabolic source.projection source.flag i
  have hP : P.map source.projection = modelParabolic source.flag i :=
    map_comap_eq_self_of_surjective source.projection_surjective _
  have hk : IsPGroup 2 source.projection.ker := by
    rw [source.projection_kernel]
    exact pCore_isPGroup
  have hm : (P.pCoreIn 2).map source.projection ≤
      (⁅P.pCoreIn 2, (pResidual 2 P).map P.subtype⁆).map source.projection := by
    rw [map_commutator, map_pCoreIn_of_ker_isPGroup source.projection hk P,
      map_embedded_pResidual, hP]
    exact (model_core_eq_commutator_residual source.flag i).le
  have hle : P.pCoreIn 2 ≤ ⁅P.pCoreIn 2, (pResidual 2 P).map P.subtype⁆ ⊔ pCore 2 M := by
    rw [← source.projection_kernel, ← comap_map_eq]
    exact map_le_iff_le_comap.mp hm
  have he := map_mono (f := embedM R) hle
  rw [Subgroup.map_sup, map_commutator, ← Q_alpha R source.two_group source.core_le] at he
  change flagKernel source i ≤ _ at he
  simpa only [flagResidual, flagKernel, pCoreIn,
    rankOne_parabolic_eq source.projection source.projection_surjective hk, P] using he

/-- The same generation holds in every conjugated parabolic, with the original Q_alpha. -/
theorem localFlagKernel_le_commutator_residual_sup_vertexKernel
    (source : LocalSource L R) (i : Bool) (d : M) :
    localFlagKernel source i d ≤
      ⁅localFlagKernel source i d, localFlagResidual source i d⁆ ⊔ Q R (alpha R) := by
  have h := map_mono (f := (MulAut.conj (embedM R d)).toMonoidHom)
    (flagKernel_le_commutator_residual_sup_vertexKernel source i)
  rw [Subgroup.map_sup, map_commutator] at h
  change localFlagKernel source i d ≤
    ⁅localFlagKernel source i d, localFlagResidual source i d⁆ ⊔
      localConjugate (Q R (alpha R)) d at h
  have hQ : localConjugate (Q R (alpha R)) d = Q R (alpha R) := by
    apply mem_normalizer_iff_map_conj_eq.mp
    apply Q_normalized R _
    rw [alpha, stabilizer_m_base]
    exact ⟨d, rfl⟩
  rwa [hQ] at h

/-- Residual fixation of X/Z_alpha forces vanishing of the literal D/core displacement. -/
theorem D_core_le_of_X_residual_le
    (source : LocalSource L R) (geometry : Geometry R)
    (common : CommonFacts R source geometry) (early : EarlyFacts R geometry)
    (i : Bool) (d : M)
    (hmove : ⁅X source i d, localFlagResidual source (!i) d⁆ ≤ Z R (alpha R)) :
    ⁅D source i d, localFlagKernel source (!i) d⁆ ≤ Z R (alpha R) := by
  let P := localFlagActor source (!i) d
  let K := localFlagKernel source (!i) d
  let T := localFlagResidual source (!i) d
  let N := Z R (alpha R)
  have hKP : K ≤ P := map_mono (flagKernel_le source (!i))
  have hTP : T ≤ P := map_mono (flagResidual_le source (!i))
  have hDP : D source i d ≤ P := (D_le_Y source i d).trans
    (Y_le_actor source geometry common.large_distance i d)
  have hPN : P ≤ normalizer N :=
    (localFlagActor_le_stabilizer source (!i) d).trans (Z_normalized R _)
  have hQD : ⁅Q R (alpha R), D source i d⁆ ≤ N := by
    rw [commutator_comm]
    exact (commutator_mono ((D_le_Y source i d).trans (Y_le_radius source i d))
      le_rfl).trans (early.commutator_le_Z _ rfl)
  have htriple : ⁅⁅K, T⁆, D source i d⁆ ≤ N := by
    apply commutator_commutator_le_of_rotate_of_le_normalizer
      (hKP.trans hPN) (hTP.trans hPN) (hDP.trans hPN)
    · rw [commutator_comm T]
      exact (commutator_mono ((commutator_mono le_rfl hTP).trans
        (D_commutator_actor source geometry common.large_distance i d)) le_rfl).trans
          (Incident.secondFlagLayer_commutator_le_Z source geometry common.large_distance i d)
    · exact (commutator_mono (show ⁅D source i d, K⁆ ≤ X source i d from le_sup_left)
        le_rfl).trans hmove
  have hKfix : K ≤ commutatorPreimage P (D source i d) N := by
    apply (localFlagKernel_le_commutator_residual_sup_vertexKernel source (!i) d).trans
    apply sup_le
    · exact le_commutatorPreimage ((Subgroup.commutator_le_sup K T).trans (sup_le hKP hTP)) htriple
    · exact le_commutatorPreimage
        ((Q_alpha_le_localFlagKernel source (!i) d).trans hKP) hQD
  rw [commutator_comm]
  exact (commutator_mono hKfix le_rfl).trans
    (commutator_commutatorPreimage_le P (D source i d) N hPN)

/-- Nonzero D/core displacement is moved by the actual cubic residual. -/
theorem X_residual_commutator_not_le_iff_D_core_commutator_not_le
    (source : LocalSource L R) (geometry : Geometry R)
    (common : CommonFacts R source geometry) (early : EarlyFacts R geometry)
    (i : Bool) (d : M) :
    (¬ ⁅X source i d, localFlagResidual source (!i) d⁆ ≤ Z R (alpha R)) ↔
      ¬ ⁅D source i d, localFlagKernel source (!i) d⁆ ≤ Z R (alpha R) := by
  constructor
  · intro h hn
    apply h
    exact (commutator_mono (sup_le hn le_rfl) le_rfl).trans
      (le_normalizer_iff_commutator_le_left.mp
        ((map_mono (flagResidual_le source (!i))).trans
          ((localFlagActor_le_stabilizer source (!i) d).trans (Z_normalized R _))))
  · intro h hn
    exact h (D_core_le_of_X_residual_le source geometry common early i d hn)

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Flags.RankOne.BinaryAuxiliary
