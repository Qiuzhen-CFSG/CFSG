module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceEight.CoreFactors.Higher.Quotients.SecondLayer.Recognition.Displacement.DeltaBounds
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceEight.PathCentrality.LocalCommutator.CriticalCase.Geometry
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.SectionThree.NaturalStructure.CriticalCriterion.Generation

/-!
# Transport of the actual delta actor

The turn at c identifies the first spans generated by Z_a and Z_d. Since
G_c normalizes this span, delta's specified transporter takes hat W_a to
hat W(delta,c,a), despite moving the final vertex d. Thus the original
commutator bound transports to the candidate actor without a new regular
path at delta. The literal earlier input is (4.5.3)(iii), printed p.897;
the hat-V bound is clause (ii).

The remaining edge product at a is a separate obligation. The last theorem
connects the transported commutator to the actual orbit-module consumer,
retaining that product explicitly. It does not claim the completed delta
case of (4.5.4)(iii).

Source: Meierfrankenfeld--Stellmacher (1993), pp.896--899.
-/

public section
open Subgroup Stellmacher.PushingUp.AmalgamGraph
open scoped commutatorElement Pointwise
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.CoreFactors.Higher.Quotients.SecondLayer.Recognition.Displacement
open NormalizerTransfer PathCentrality
variable {M : Type*} [Group M] {R L : Subgroup M}

/-- The actual turn at c identifies the backward and forward first spans. -/
theorem delta_middle_span (p : Higher.SourcePath (alpha R)) :
    hatV R (p.walk.getVert 6) (alpha R) =
      hatV R (p.walk.getVert 6) (p.walk.getVert 8) := by
  obtain ⟨g, hg, ht⟩ := p.turns 6 (by decide) (by decide) (by decide)
  have ht' : act R g (p.walk.getVert 8) = alpha R := by
    simpa only [p.center_eq] using ht
  change localZSpan R (alpha R) _ = localZSpan R (p.walk.getVert 8) _
  simpa only [ht'] using
    (LocalCommutator.CriticalCase.span_eq_of_local_conjugator
      (a := p.walk.getVert 8) hg)

/-- Transport the original actor using delta's given transporter. Normality
of the middle first span justifies replacing its transported final vertex. -/
theorem delta_actor_eq_conjugate {p : Higher.SourcePath (alpha R)} (δ : DeltaChoice p) :
    hatW R δ.vertex (p.walk.getVert 6) (alpha R) =
      rightConjugate (hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8))
        δ.transporter := by
  unfold hatW rightConjugate
  rw [CriticalCriterion.conjugatesIn_map, ← stabilizer_act, ← δ.vertex_eq]
  apply congrArg (fun H => conjugatesIn H (stabilizer R δ.vertex))
  exact (delta_middle_span p).trans
    (mem_normalizer_iff_map_conj_eq.mp
      (hatV_normalized R (p.walk.getVert 6) (p.walk.getVert 8)
        ((stabilizer R _).inv_mem δ.transporter.property))).symm

/-- The literal (4.5.3)(iii) at the original path supplies the commutator
at the actual delta actor. Its sole source guard is the supplied SourcePath;
no translated regular configuration is assumed. -/
theorem delta_actor_commutator {p : Higher.SourcePath (alpha R)} (δ : DeltaChoice p)
    (hcomm : ⁅hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8),
      Q R (alpha R)⁆ ≤ Z R (alpha R)) :
    ⁅hatW R δ.vertex (p.walk.getVert 6) (alpha R), Q R δ.vertex⁆ ≤ Z R δ.vertex := by
  have h := map_mono (f := (MulAut.conj (δ.transporter : FreeAmalgam R)⁻¹).toMonoidHom)
    hcomm
  rw [map_commutator, ← Q_act, ← Z_act, ← δ.vertex_eq] at h
  rw [delta_actor_eq_conjugate δ]
  exact h

/-- The given generation equation remains an equality of the actual middle
span with the three seeds; the backward seed is identified by the path turn. -/
theorem delta_backward_generation {p : Higher.SourcePath (alpha R)} (δ : DeltaChoice p) :
    hatV R (p.walk.getVert 6) (alpha R) =
      Z R (alpha R) ⊔ Z R δ.vertex ⊔ Z R (p.walk.getVert 8) :=
  (delta_middle_span p).trans δ.generation

/-- Apply the proved commutator transport to the precise existing consumer.
The edge product is still to be established, so this is a conditional helper,
not the completed source actor construction. The orbit containment is the
literal delta instance of (4.5.4)(ii). -/
theorem delta_small_and_separated_of_candidate_product [Finite M]
    (source : LocalSource L R) {geometry : Geometry R}
    (common : CommonFacts R source geometry) (earlier : Earlier R geometry)
    {p : Higher.SourcePath (alpha R)} (δ : DeltaChoice p)
    (s : OrbitModule source p δ.vertex)
    (hprod : (hatW R δ.vertex (p.walk.getVert 6) (alpha R) : Set (FreeAmalgam R)) *
      (Q R (alpha R) : Set (FreeAmalgam R)) =
        (Q R (p.walk.getVert 5) : Set (FreeAmalgam R)))
    (horbit : conjugatesIn (Z R δ.vertex) (stabilizer R (alpha R)) ≤ Q R δ.vertex)
    (hcomm : ⁅hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8),
      Q R (alpha R)⁆ ≤ Z R (alpha R)) : letI := s.normal
    Escape.Initial.Natural.Splitting.HasSmallInvolution s.action ∧
      DisplacementSeparation s.action common.natural.marking := by
  have ht : Adjacent R (alpha R) (p.walk.getVert 5) := by
    simpa only [p.center_eq] using (cosetGraph_adj R _ _).mp
      (SimpleGraph.dist_eq_one_iff_adj.mp
        (p.dist (i := 4) (j := 5) (by decide) (by decide)))
  exact delta_small_and_separated_of_actor source common earlier δ s ht hprod horbit
    (delta_actor_commutator δ hcomm)

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.CoreFactors.Higher.Quotients.SecondLayer.Recognition.Displacement
