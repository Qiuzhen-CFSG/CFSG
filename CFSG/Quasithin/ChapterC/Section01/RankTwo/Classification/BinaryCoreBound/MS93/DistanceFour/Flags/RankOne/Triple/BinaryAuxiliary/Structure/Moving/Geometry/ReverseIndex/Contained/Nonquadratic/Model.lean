module

public import Mathlib.GroupTheory.Perm.Fin
public import Mathlib.RepresentationTheory.Basic
public import Mathlib.Data.ZMod.Basic
public import Mathlib.Algebra.Group.Subgroup.Lattice

/-!
# The marked S4 calculation for the incident first core

The two distinguished subgroups are the nonnormal four-group generated
by (01) and (23), and the normal four-group of double transpositions.
The orbit span and quadratic-action predicates below specify the local
linear calculation needed for MS93 (4.6.8), pp.906--907. They do not assume
the calculation or identify these subgroups with the source cores.
-/

@[expose] public section
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Flags.RankOne.BinaryAuxiliary.Moving.Nonquadratic

namespace S4Model

abbrev Actor := Equiv.Perm (Fin 4)

/-- The nonnormal four-group fixing the unordered pair {0,1}. -/
def firstCore : Subgroup Actor := Subgroup.closure {Equiv.swap 0 1, Equiv.swap 2 3}

/-- The normal four-group generated by two double transpositions. -/
def oppositeCore : Subgroup Actor :=
  Subgroup.closure {Equiv.swap 0 1 * Equiv.swap 2 3, Equiv.swap 0 2 * Equiv.swap 1 3}

end S4Model

variable {G W : Type*} [Group G] [AddCommGroup W] [Module (ZMod 2) W]

/-- The linear span of translates under the stated actual representation. -/
noncomputable def orbitSpan (ρ : Representation (ZMod 2) G W)
    (D : Submodule (ZMod 2) W) : Submodule (ZMod 2) W := ⨆ g : G, D.map (ρ g)

/-- Every displacement by E is fixed by E. -/
def QuadraticOn (ρ : Representation (ZMod 2) G W) (E : Subgroup G) : Prop :=
  ∀ a ∈ E, ∀ b ∈ E, ∀ v, ρ a (ρ b v - v) = ρ b v - v

/-- The full actor fixes every displacement by E, or [W,E,G] = 0. -/
def DisplacementsFixed (ρ : Representation (ZMod 2) G W) (E : Subgroup G) : Prop :=
  ∀ g : G, ∀ k ∈ E, ∀ v, ρ g (ρ k v - v) = ρ k v - v

/-- An orbit span is invariant under its original action. -/
theorem orbitSpan_invariant (ρ : Representation (ZMod 2) G W)
    (D : Submodule (ZMod 2) W) (g : G) {v : W} (hv : v ∈ orbitSpan ρ D) :
    ρ g v ∈ orbitSpan ρ D := by
  refine Submodule.iSup_induction (fun a : G => D.map (ρ a))
    (motive := fun w => ρ g w ∈ orbitSpan ρ D) hv ?_ ?_ ?_
  · rintro a _ ⟨w, hw, rfl⟩
    exact le_iSup (fun a : G => D.map (ρ a)) (g * a)
      ⟨w, hw, by rw [map_mul, Module.End.mul_apply]⟩
  · simp
  · intro x y hx hy
    simpa only [map_add] using (orbitSpan ρ D).add_mem hx hy

/-- The seed itself is one of its translates. -/
theorem le_orbitSpan (ρ : Representation (ZMod 2) G W) (D : Submodule (ZMod 2) W) :
    D ≤ orbitSpan ρ D := by
  intro v hv
  exact le_iSup (fun a : G => D.map (ρ a)) 1 ⟨v, hv, by simp⟩

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Flags.RankOne.BinaryAuxiliary.Moving.Nonquadratic
