module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Early.Initial.Radius
public import Theory.GroupAction.SubgroupQuotientFullAction

/-!
# The actual elementary radius quotient

The binary derived bound makes V_alpha/Z_alpha abelian. Since the radius is
generated by involutions, this quotient is elementary abelian. Its action is
the conjugation action of the full vertex stabilizer, and its fixed-point
preimage is exactly `Early.radiusFixed`. In particular no action of Q_alpha
is discarded in preparing the factorization argument.

Source: Meierfrankenfeld--Stellmacher (1993), the barred radius notation and
the displacement obstruction in (4.6.2), printed pp.881 and 901--902.
-/

@[expose] public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
open scoped commutatorElement IsMulCommutative
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Early.Initial

variable {M : Type*} [Group M] {L R : Subgroup M}
  {source : LocalSource L R} {geometry : Geometry R}

/-- Normality is inside the radius group, not in the free amalgam. -/
theorem radiusZ_normal (common : CommonFacts R source geometry)
    (a : Vertex R) (ha : color R a = false) :
    ((Z R a).subgroupOf (V R a)).Normal :=
  normal_subgroupOf_of_le_normalizer
    (((radius_le_Q common a ha).trans (fun _ hx => hx.1)).trans (Z_normalized R a))

/-- The genuine quotient by Z is elementary abelian in the binary b=4 branch. -/
theorem radiusQuotient_elementary [Finite M] (common : CommonFacts R source geometry)
    (hb : geometry.b R = 4) (a : Vertex R) (ha : color R a = false) :
    letI := radiusZ_normal common a ha
    IsElementaryAbelian 2 ((V R a) ⧸ (Z R a).subgroupOf (V R a)) := by
  let := radiusZ_normal common a ha
  let N := (Z R a).subgroupOf (V R a)
  let q := QuotientGroup.mk' N
  have hD : _root_.commutator (V R a) ≤ N := by
    intro x hx
    apply radius_derived_le_Z common hb a ha
    rw [← map_subtype_commutator]
    exact mem_map_of_mem (V R a).subtype hx
  let : IsMulCommutative ((V R a) ⧸ N) :=
    Normal.quotient_commutative_iff_commutator_le.mpr hD
  let K := ((powMonoidHom 2).comp q).ker
  have hVK : V R a ≤ K.map (V R a).subtype := by
    have hΩ : omegaOneAmbient (V R a) = V R a := DistanceEight.VBall_omegaOne R a 2
    conv_lhs => rw [← hΩ]
    apply (omegaOneAmbient_le_iff _ _).mpr
    intro x hx hp
    refine ⟨⟨x, hx⟩, ?_, rfl⟩
    change q ⟨x, hx⟩ ^ 2 = 1
    have hp' : (⟨x, hx⟩ : V R a) ^ 2 = 1 := Subtype.ext hp
    rw [← map_pow, hp', map_one]
  have hp (w : (V R a) ⧸ N) : w ^ 2 = 1 := by
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective N w
    obtain ⟨y, hy, hyx⟩ := hVK x.property
    have heq : y = x := Subtype.ext hyx
    subst y
    exact hy
  exact ⟨Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr hp⟩

/-- Conjugation on the literal radius quotient by Z. -/
noncomputable def radiusQuotientAction (common : CommonFacts R source geometry)
    (a : Vertex R) (ha : color R a = false) :
    letI := radiusZ_normal common a ha
    stabilizer R a →* MulAut ((V R a) ⧸ (Z R a).subgroupOf (V R a)) :=
  Classical.choose (exists_quotient_conjugation_action
    (stabilizer R a) (V R a) (Z R a) (V_normalized a) (Z_normalized R a)
    (radiusZ_normal common a ha))

/-- The chosen action has the ambient conjugation formula on every quotient class. -/
theorem radiusQuotientAction_apply (common : CommonFacts R source geometry)
    (a : Vertex R) (ha : color R a = false) (g : stabilizer R a) (v : V R a) :
    letI := radiusZ_normal common a ha
    radiusQuotientAction common a ha g (QuotientGroup.mk' ((Z R a).subgroupOf (V R a)) v) =
      QuotientGroup.mk' ((Z R a).subgroupOf (V R a))
        ⟨(g : FreeAmalgam R) * (v : FreeAmalgam R) * (g : FreeAmalgam R)⁻¹,
          (mem_normalizer_iff.mp (V_normalized a g.property) v).mp v.property⟩ :=
  Classical.choose_spec (exists_quotient_conjugation_action
    (stabilizer R a) (V R a) (Z R a) (V_normalized a) (Z_normalized R a)
    (radiusZ_normal common a ha)) g v

/-- The fixed-point preimage agrees with the source quotient-centralizer,
with containment of the actor explicit so that subgroupOf cannot truncate it. -/
theorem radiusQuotientAction_fixed_iff (common : CommonFacts R source geometry)
    (a : Vertex R) (ha : color R a = false)
    (A : Subgroup (FreeAmalgam R)) (hA : A ≤ stabilizer R a) (v : V R a) :
    letI := radiusZ_normal common a ha
    (∀ g : A, radiusQuotientAction common a ha ⟨g, hA g.property⟩
      (QuotientGroup.mk' ((Z R a).subgroupOf (V R a)) v) =
        QuotientGroup.mk' ((Z R a).subgroupOf (V R a)) v) ↔
      (v : FreeAmalgam R) ∈ radiusFixed geometry a A := by
  let := radiusZ_normal common a ha
  rw [mem_radiusFixed_iff common a ha A hA]
  constructor
  · intro h
    refine ⟨v.property, fun g hg => ?_⟩
    have heq := h ⟨g, hg⟩
    rw [radiusQuotientAction_apply] at heq
    have hm := QuotientGroup.eq_iff_div_mem.mp heq
    change g * (v : FreeAmalgam R) * g⁻¹ / (v : FreeAmalgam R) ∈ Z R a at hm
    simpa only [commutatorElement_def, div_eq_mul_inv] using hm
  · intro h g
    rw [radiusQuotientAction_apply]
    apply QuotientGroup.eq_iff_div_mem.mpr
    change (g : FreeAmalgam R) * (v : FreeAmalgam R) * (g : FreeAmalgam R)⁻¹ /
      (v : FreeAmalgam R) ∈ Z R a
    simpa only [commutatorElement_def, div_eq_mul_inv] using h.2 g g.property

/-- The intrinsic fixed subgroup for the actual quotient action.
The comparison lemmas below explicitly require A to lie in the stabilizer. -/
noncomputable def radiusQuotientFixed (common : CommonFacts R source geometry)
    (a : Vertex R) (ha : color R a = false) (A : Subgroup (FreeAmalgam R)) :
    letI := radiusZ_normal common a ha
    Subgroup ((V R a) ⧸ (Z R a).subgroupOf (V R a)) := by
  letI := radiusZ_normal common a ha
  letI := MulDistribMulAction.compHom ((V R a) ⧸ (Z R a).subgroupOf (V R a))
    ((radiusQuotientAction common a ha).comp (A.subgroupOf (stabilizer R a)).subtype)
  exact FixedPoints.subgroup (A.subgroupOf (stabilizer R a))
    ((V R a) ⧸ (Z R a).subgroupOf (V R a))

/-- Membership in the quotient fixed subgroup is the native radiusFixed condition. -/
theorem radiusQuotientFixed_mk_iff (common : CommonFacts R source geometry)
    (a : Vertex R) (ha : color R a = false)
    (A : Subgroup (FreeAmalgam R)) (hA : A ≤ stabilizer R a) (v : V R a) :
    letI := radiusZ_normal common a ha
    QuotientGroup.mk' ((Z R a).subgroupOf (V R a)) v ∈
      radiusQuotientFixed common a ha A ↔
        (v : FreeAmalgam R) ∈ radiusFixed geometry a A := by
  let := radiusZ_normal common a ha
  change (∀ g : A.subgroupOf (stabilizer R a), radiusQuotientAction common a ha g.val
    (QuotientGroup.mk' ((Z R a).subgroupOf (V R a)) v) =
      QuotientGroup.mk' ((Z R a).subgroupOf (V R a)) v) ↔ _
  rw [← radiusQuotientAction_fixed_iff common a ha A hA v]
  constructor
  · intro h g
    exact h ⟨⟨g, hA g.property⟩, g.property⟩
  · intro h g
    exact h ⟨g.val, g.property⟩

/-- The ambient preimage and intrinsic quotient fixed subgroup have exactly
the same index. This is the displacement in the InitialFacts contract. -/
theorem radiusFixed_relIndex_eq (common : CommonFacts R source geometry)
    (a : Vertex R) (ha : color R a = false)
    (A : Subgroup (FreeAmalgam R)) (hA : A ≤ stabilizer R a) :
    letI := radiusZ_normal common a ha
    (radiusFixed geometry a A).relIndex (V R a) =
      (radiusQuotientFixed common a ha A).index := by
  let := radiusZ_normal common a ha
  have heq : (radiusFixed geometry a A).subgroupOf (V R a) =
      (radiusQuotientFixed common a ha A).comap
        (QuotientGroup.mk' ((Z R a).subgroupOf (V R a))) := by
    ext v
    exact (radiusQuotientFixed_mk_iff common a ha A hA v).symm
  change ((radiusFixed geometry a A).subgroupOf (V R a)).index = _
  rw [heq]
  exact (radiusQuotientFixed common a ha A).index_comap_of_surjective
    (QuotientGroup.mk'_surjective ((Z R a).subgroupOf (V R a)))

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Early.Initial
