module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.Escape.PairingControl.Geometry.Selection.Six.Complement.FixedPreimage
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.Escape.PairingControl.FirstPairing.Orientation.ImageCases.Representation

/-!
# Compatible opposite coordinates on the full radius quotient

The single natural section first gives V = Vcirc B, using the actual residual
and the fixed preimage B. The natural coordinates on V/B and the opposite
coordinates on Vcirc/U both have eight elements. Their relative indices give
Vcirc intersect B = U. Extending the latter coordinates across B preserves
the marked quotient and its inverse-transpose action relative to U.

This supplies the full-radius bridge for the fixed-image comparison in
Meierfrankenfeld--Stellmacher, *Pushing up weak BN-pairs of rank two* (1993),
(4.3.2)(5), printed p.884. The construction does not identify V/Z with V/B.
The moving-preimage calculation follows the earlier StepThree.Coordinates
argument, applied to an arbitrary supplied SingleNaturalSection.
-/

public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.Escape.PairingControl.Geometry.Selection.Six.Complement.FixedComparison
open RankOnePairing
open FirstPairing.Orientation.QuotientApplication.NaturalGeneration

private theorem movingPreimage_eq_of_generation {A : Type*} [Group A]
    {π : A →* SL} {Q L V Z : Subgroup A}
    (s : SingleNaturalSection π Q L V Z) (hgen : L ⊔ Q = ⊤) :
    movingPreimage Q V Z = radicalPreimage Q V Z ⊔ ⁅V, L⁆ := by
  let := s.normal_group
  let := s.radical_normal
  let D := radicalPreimage Q V Z
  let q := QuotientGroup.mk' D
  have hqtop : (⊤ : Subgroup A).map q = ⊤ := by
    rw [← MonoidHom.range_eq_map]
    exact MonoidHom.range_eq_top.mpr (QuotientGroup.mk'_surjective D)
  have hcomm : ⁅V.map q, Q.map q⁆ = ⊥ := by
    rw [← map_commutator, Subgroup.map_eq_bot_iff]
    rw [show q.ker = D from QuotientGroup.ker_mk' D]
    exact le_sup_right
  have hgenq : Q.map q ⊔ L.map q = ⊤ := by
    rw [← Subgroup.map_sup, sup_comm, hgen, hqtop]
  have he := commutator_eq_of_centralizing_sup hgenq
    (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hcomm))
    (show L.map q ≤ normalizer (V.map q : Set (A ⧸ D)) from le_normalizer_of_normal)
  have heq : ⁅V, L⁆.map q = ⁅V, (⊤ : Subgroup A)⁆.map q := by
    rw [map_commutator, map_commutator, hqtop]
    exact he
  have hh := congrArg (Subgroup.comap q) heq
  rw [comap_map_eq, comap_map_eq] at hh
  change D ⊔ ⁅V, (⊤ : Subgroup A)⁆ = D ⊔ ⁅V, L⁆
  simpa only [q, QuotientGroup.ker_mk', sup_comm] using hh.symm

/-- The whole section is generated by its residual commutator and its literal
fixed preimage. In particular the radical has not been identified with Z. -/
theorem section_sup_fixed {A : Type*} [Group A] [Finite A]
    {π : A →* SL} {Q L V Z : Subgroup A}
    (s : SingleNaturalSection π Q L V Z) (hL : IsPPerfect 2 L)
    (hV : IsPGroup 2 V) (hgen : L ⊔ Q = ⊤) :
    letI := s.normal_kernel
    V = ⁅V, L⁆ ⊔ centralizerModulo V L Z := by
  let := s.normal_kernel
  let := s.radical_normal
  let := s.normal_group
  rw [fixed_eq_radical_fixed s hL hV hgen]
  have hD : radicalPreimage Q V Z ≤ centralizerModulo V ⊤ (radicalPreimage Q V Z) :=
    s.intersection.symm.le.trans inf_le_right
  calc
    V = movingPreimage Q V Z ⊔ centralizerModulo V ⊤ (radicalPreimage Q V Z) :=
      s.decomposition
    _ = (radicalPreimage Q V Z ⊔ ⁅V, L⁆) ⊔
        centralizerModulo V ⊤ (radicalPreimage Q V Z) := by
      rw [movingPreimage_eq_of_generation s hgen]
    _ = ⁅V, L⁆ ⊔ centralizerModulo V ⊤ (radicalPreimage Q V Z) := by
      rw [sup_comm (radicalPreimage Q V Z), sup_assoc, sup_of_le_right hD]

/-- Opposite coordinates extend across the fixed preimage without changing
the natural marking or the inverse-transpose action. -/
noncomputable def extendDual {A : Type*} [Group A] {π : A →* SL}
    {C V U B : Subgroup A} [B.Normal]
    (n : NaturalFactor π ⊤ U ⊥) (d : DualFactor π ⊤ C U U n)
    (hcover : V = C ⊔ B) (hinter : C ⊓ B = U)
    (hnorm : (⊤ : Subgroup A) ≤ normalizer V) : DualFactor π ⊤ V B U n := by
  let dn : NaturalFactor π ⊤ C U := {
    marking := n.marking.trans BinaryLinearThree.AutomorphismAction.graph
    coordinates := d.coordinates
    surjective := d.surjective
    kernel := d.kernel
    normalized := d.normalized
    action := d.action }
  let e := extendNaturalAcrossFixed dn hcover hinter hnorm
  exact {
    coordinates := e.coordinates
    surjective := e.surjective
    kernel := e.kernel
    normalized := e.normalized
    action := e.action }

variable {M : Type*} [Group M] [Finite M] {L R : Subgroup M}
    {geometry : MS93.Geometry R}

private theorem local_generation (source : LocalSource L R)
    {a : Vertex R} (ha : color R a = false) :
    pResidual 2 (stabilizer R a) ⊔ (Q R a).subgroupOf (stabilizer R a) = ⊤ := by
  apply map_injective (stabilizer R a).subtype_injective
  rw [Subgroup.map_sup, map_subgroupOf_eq_of_le
    (show Q R a ≤ stabilizer R a from fun _ hx => hx.1),
    ← MonoidHom.range_eq_map, range_subtype]
  exact source.local_generation a ha

omit [Finite M] in
private theorem local_fixed (a : Vertex R) :
    letI := geometry.Z_normal a
    (B R a (geometry.Z_normal a)).subgroupOf (stabilizer R a) =
      centralizerModulo ((V R a).subgroupOf (stabilizer R a))
        (pResidual 2 (stabilizer R a)) ((Z R a).subgroupOf (stabilizer R a)) :=
  comap_map_eq_self_of_injective (stabilizer R a).subtype_injective _

theorem radius_sup_fixed (source : LocalSource L R) (hb : 2 < geometry.b R)
    {a : Vertex R} (ha : color R a = false)
    (s : NaturalSectionAt a (V R a) (Z R a)) :
    V R a = Vcirc R a ⊔ B R a (geometry.Z_normal a) := by
  let := finite_stabilizer R a
  let := geometry.Z_normal a
  have h := section_sup_fixed s.module_section (isPPerfect_pResidual 2)
    (source.V_isPGroup geometry hb a ha).comap_subtype (local_generation source ha)
  rw [← local_fixed (geometry := geometry)] at h
  have hh := congrArg (Subgroup.map (stabilizer R a).subtype) h
  have hV : V R a ≤ stabilizer R a :=
    (geometry.V_le_Q hb a ha).trans (fun _ hx => hx.1)
  rw [Subgroup.map_sup, map_commutator, map_subgroupOf_eq_of_le hV,
    map_subgroupOf_eq_of_le (show B R a (geometry.Z_normal a) ≤ stabilizer R a from
      map_subtype_le _)] at hh
  exact hh

/-- The fixed preimage meets Vcirc in exactly U, using the actual two
eight-element quotient isomorphisms and the proved full-radius cover. -/
theorem moving_inf_fixed (source : LocalSource L R) (hb : 2 < geometry.b R)
    {a : Vertex R} (ha : color R a = false)
    (s : NaturalSectionAt a (V R a) (Z R a)) (o : OppositeSectionAt a) :
    Vcirc R a ⊓ B R a (geometry.Z_normal a) = U R a := by
  let S := stabilizer R a
  let C := (Vcirc R a).subgroupOf S
  let B₀ := (B R a (geometry.Z_normal a)).subgroupOf S
  let U₀ := (U R a).subgroupOf S
  let V₀ := (V R a).subgroupOf S
  let := finite_stabilizer R a
  let : B₀.Normal := normal_subgroupOf_of_le_normalizer
    (fixedPreimage_normalized hb a ha)
  have hV : V R a ≤ S := (geometry.V_le_Q hb a ha).trans (fun _ hx => hx.1)
  have hC : Vcirc R a ≤ S := (Vcirc_le_V a).trans hV
  have hB : B R a (geometry.Z_normal a) ≤ S := map_subtype_le _
  have hU : U R a ≤ S := (U_le_Z a).trans (Z_le_stabilizer R a)
  have hcover : V₀ = C ⊔ B₀ := by
    apply map_injective S.subtype_injective
    rw [Subgroup.map_sup, map_subgroupOf_eq_of_le hV,
      map_subgroupOf_eq_of_le hC, map_subgroupOf_eq_of_le hB]
    exact radius_sup_fixed source hb ha s
  have hUI : U₀ ≤ C ⊓ B₀ := fun _ hx =>
    ⟨commutator_mono (Z_le_VBall R a 2) le_rfl hx,
      EdgeTransfer.Z_le_B hb a ha (U_le_Z a hx)⟩
  have hUC : U₀.relIndex C = 8 := by
    let := o.dual.kernel_normal
    rw [relIndex, index_eq_card, Nat.card_congr o.dual.quotientEquiv.toEquiv]
    change Nat.card (Fin 3 → ZMod 2) = 8
    simp only [Nat.card_fun, Nat.card_zmod, Nat.card_fin]
    norm_num
  have hBV : B₀.relIndex V₀ = 8 := by
    let n := FirstPairing.Orientation.ImageCases.natural_coordinates_at source hb ha s
    let := n.kernel_normal
    rw [relIndex, index_eq_card, Nat.card_congr n.quotientEquiv.toEquiv]
    change Nat.card (Fin 3 → ZMod 2) = 8
    simp only [Nat.card_fun, Nat.card_zmod, Nat.card_fin]
    norm_num
  have hIC : (C ⊓ B₀).relIndex C = 8 := by
    rw [inf_relIndex_left, ← relIndex_sup_right, ← hcover]
    exact hBV
  have hmul := relIndex_mul_relIndex U₀ (C ⊓ B₀) C hUI inf_le_left
  rw [hIC, hUC] at hmul
  have he : C ⊓ B₀ = U₀ := le_antisymm
    (relIndex_eq_one.mp (by omega)) hUI
  have hh := congrArg (Subgroup.map S.subtype) he
  rw [Subgroup.map_inf _ _ _ S.subtype_injective, map_subgroupOf_eq_of_le hC,
    map_subgroupOf_eq_of_le hB, map_subgroupOf_eq_of_le hU] at hh
  exact hh

/-- Compatible dual coordinates on V/B, with the same marked quotient and
natural U coordinates supplied by the opposite section. -/
noncomputable def fullRadiusDual (source : LocalSource L R) (hb : 2 < geometry.b R)
    {a : Vertex R} (ha : color R a = false)
    (s : NaturalSectionAt a (V R a) (Z R a)) (o : OppositeSectionAt a) :
    DualFactor o.projection ⊤ ((V R a).subgroupOf (stabilizer R a))
      ((B R a (geometry.Z_normal a)).subgroupOf (stabilizer R a))
      ((U R a).subgroupOf (stabilizer R a)) o.naturalU := by
  let S := stabilizer R a
  let : ((B R a (geometry.Z_normal a)).subgroupOf S).Normal :=
    normal_subgroupOf_of_le_normalizer (fixedPreimage_normalized hb a ha)
  have hV : V R a ≤ S := (geometry.V_le_Q hb a ha).trans (fun _ hx => hx.1)
  have hC : Vcirc R a ≤ S := (Vcirc_le_V a).trans hV
  have hB : B R a (geometry.Z_normal a) ≤ S := map_subtype_le _
  apply extendDual o.naturalU o.dual
  · apply map_injective S.subtype_injective
    rw [Subgroup.map_sup, map_subgroupOf_eq_of_le hV,
      map_subgroupOf_eq_of_le hC, map_subgroupOf_eq_of_le hB]
    exact radius_sup_fixed source hb ha s
  · change (Vcirc R a ⊓ B R a (geometry.Z_normal a)).subgroupOf S = _
    rw [moving_inf_fixed source hb ha s o]
  · let : ((V R a).subgroupOf S).Normal :=
      normal_subgroupOf_of_le_normalizer (V_normalized a)
    exact le_normalizer_of_normal

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.Escape.PairingControl.Geometry.Selection.Six.Complement.FixedComparison
