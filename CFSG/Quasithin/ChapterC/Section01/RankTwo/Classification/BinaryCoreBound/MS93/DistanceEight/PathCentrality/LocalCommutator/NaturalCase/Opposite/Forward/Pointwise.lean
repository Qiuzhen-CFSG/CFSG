module
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceEight.PathCentrality.LocalCommutator.NaturalCase.Opposite.Forward.Criticality
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceEight.PathCentrality.LocalCommutator.CriticalCase.Terminal.MarkedPairing.FixedLine

/-!
# The pointwise continued critical lines and endpoint plane

Criticality gives order two for each corrected commutator [Z_c,Z_d].
Locality and full edge displacement put it in E_d intersect Q_a. The
original critical line lies in U_b intersect Q_a, which is proper in U_b
and hence has order at most four. Avoidance separates the two lines, so
this kernel intersection has order four. Its intersection with E_d is
proper and contains [Z_c,Z_d], proving the exact pointwise equality.

This does not identify the span generated by all avoiding commutators:
one continued line together with the original line generates the plane,
but the original line must still be recovered from the avoiding orbit.

Source: Meierfrankenfeld--Stellmacher (1993), (4.4.1)(1), printed p.891.
-/

@[expose] public section
open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality.LocalCommutator.NaturalCase.Opposite.SelectedPath
variable {M : Type*} [Group M] [Finite M] {L R : Subgroup M}
variable {source : LocalSource L R} {geometry : Geometry R} {a c : Vertex R}
variable (s : SelectedPath R geometry a c)

/-- The endpoint natural group meets the starting kernel in at most a plane. -/
theorem endpoint_kernel_card_le_four (common : CommonFacts R source geometry) :
    Nat.card (U R s.endpoint ⊓ Q R s.start : Subgroup (FreeAmalgam R)) ≤ 4 := by
  have hU : Nat.card (U R s.endpoint) = 8 := common.natural.card_at _ s.path.end_color
  let : Finite (U R s.endpoint) := Nat.finite_of_card_ne_zero (by omega)
  have hnot : ¬ U R s.endpoint ≤ Q R s.start := by
    intro h
    have hi := (naturalStructure common).critical_Z_index_eq_U geometry s.endpoint
      s.path.end_color s.start (s.path.reverse common).critical
    rw [relIndex_eq_one.mpr h] at hi
    exact (s.path.reverse common).critical.2 (relIndex_eq_one.mp hi)
  have hlt : Nat.card (U R s.endpoint ⊓ Q R s.start : Subgroup (FreeAmalgam R)) < 8 := by
    by_contra! h
    have he : U R s.endpoint ⊓ Q R s.start = U R s.endpoint :=
      eq_of_le_of_card_ge inf_le_left (by omega)
    exact hnot (he ▸ inf_le_right)
  have hdiv := card_dvd_of_le (show U R s.endpoint ⊓ Q R s.start ≤ U R s.endpoint from inf_le_left)
  rw [hU] at hdiv
  have hh := Nat.mem_divisors.mpr ⟨hdiv, (by decide : 8 ≠ 0)⟩
  rw [show Nat.divisors 8 = ({1, 2, 4, 8} : Finset ℕ) by decide] at hh
  simp only [Finset.mem_insert, Finset.mem_singleton] at hh
  omega

/-- Placement of the original critical line in the literal endpoint kernel. -/
theorem criticalLine_le_endpoint_kernel (common : CommonFacts R source geometry) :
    s.criticalLine ≤ U R s.endpoint ⊓ Q R s.start := by
  rw [criticalLine, commutator_comm]
  exact CriticalCase.critical_commutator_le_natural_kernel common (s.path.reverse common)

namespace Continuation
variable {s} (w : s.Continuation)

/-- The new critical commutator has order two. -/
theorem commutator_card (common : CommonFacts R source geometry) (hb : 4 < geometry.b R) :
    Nat.card (s.endpointCommutator w) = 2 :=
  CriticalCase.critical_commutator_card common
    (CriticalPath.ofPair (s.center_color (by omega)) (w.critical common hb))

/-- Both actual containments giving the pointwise edge/kernel intersection. -/
theorem commutator_le_edge_kernel (hb : 4 < geometry.b R) :
    s.endpointCommutator w ≤ edgeCommutator R s.endpoint w.intermediate ⊓ Q R s.start := by
  have hcQ : Z R s.center ≤ Q R s.endpoint := by
    apply Z_le_Q_of_dist_lt R s.center (geometry.exists_critical s.center (s.center_color (by omega)))
    rw [geometry.distance_constant s.center (s.center_color (by omega)),
      s.path.dist_end, s.path.length_eq_b]
    change geometry.b R - 2 < geometry.b R
    omega
  apply le_inf
  · change ⁅Z R s.center, Z R w.vertex⁆ ≤ _
    rw [commutator_comm, ← w.displacement_eq_edge (by omega)]
    exact commutator_mono le_rfl hcQ
  · have hdG : Z R w.vertex ≤ stabilizer R s.center := by
      apply geometry.Z_le_stabilizer_of_dist_le_b w.vertex w.vertex_color
      rw [SimpleGraph.dist_comm]
      exact w.center_distance_le (by omega)
    apply (le_normalizer_iff_commutator_le_left.mp (hdG.trans (Z_normalized R s.center))).trans
    apply Z_le_Q_of_dist_lt R s.center (geometry.exists_critical s.center (s.center_color (by omega)))
    rw [geometry.distance_constant s.center (s.center_color (by omega)), SimpleGraph.dist_comm,
      s.center_distance (by omega)]
    change 2 < geometry.b R
    omega

/-- Each continued critical line is contained in the common endpoint plane. -/
theorem commutator_le_endpoint_kernel (common : CommonFacts R source geometry)
    (hb : 4 < geometry.b R) :
    s.endpointCommutator w ≤ U R s.endpoint ⊓ Q R s.start :=
  (w.commutator_le_edge_kernel hb).trans (inf_le_inf_right _
    (Escape.EdgeTransfer.edge_commutator_le_natural common.large_distance
      (moduleFacts common) s.endpoint w.intermediate s.path.end_color w.adjacent_endpoint))

/-- The original line together with any one avoiding critical line generates the endpoint kernel. -/
theorem criticalLine_sup_commutator (common : CommonFacts R source geometry)
    (hb : 4 < geometry.b R) :
    s.criticalLine ⊔ s.endpointCommutator w = U R s.endpoint ⊓ Q R s.start := by
  let K := U R s.endpoint ⊓ Q R s.start
  have hU := common.natural.card_at s.endpoint s.path.end_color
  let : Finite (U R s.endpoint) := Nat.finite_of_card_ne_zero (by omega)
  let : Finite K := Finite.of_injective (inclusion (show K ≤ U R s.endpoint from inf_le_left))
    (inclusion_injective _)
  have hJK : s.criticalLine ⊔ s.endpointCommutator w ≤ K :=
    sup_le (s.criticalLine_le_endpoint_kernel common) (w.commutator_le_endpoint_kernel common hb)
  let : Finite (s.criticalLine ⊔ s.endpointCommutator w : Subgroup (FreeAmalgam R)) :=
    Finite.of_injective (inclusion hJK) (inclusion_injective _)
  have hD := w.commutator_card common hb
  have hlt : 2 < Nat.card (s.criticalLine ⊔ s.endpointCommutator w : Subgroup (FreeAmalgam R)) := by
    by_contra! hh
    have he : s.endpointCommutator w = s.criticalLine ⊔ s.endpointCommutator w :=
      eq_of_le_of_card_ge le_sup_right (by omega)
    apply w.avoidance
    exact (he ▸ le_sup_left).trans ((w.commutator_le_edge_kernel hb).trans inf_le_left)
  have hdvd : 2 ∣ Nat.card (s.criticalLine ⊔ s.endpointCommutator w : Subgroup (FreeAmalgam R)) :=
    hD ▸ card_dvd_of_le le_sup_right
  have hk := s.endpoint_kernel_card_le_four common
  change Nat.card K ≤ 4 at hk
  apply eq_of_le_of_card_ge hJK
  omega

/-- Exact identification of each continued critical commutator. -/
theorem commutator_eq (common : CommonFacts R source geometry) (hb : 4 < geometry.b R) :
    s.endpointCommutator w = edgeCommutator R s.endpoint w.intermediate ⊓ Q R s.start := by
  let J := edgeCommutator R s.endpoint w.intermediate ⊓ Q R s.start
  let K := U R s.endpoint ⊓ Q R s.start
  have hU := common.natural.card_at s.endpoint s.path.end_color
  let : Finite (U R s.endpoint) := Nat.finite_of_card_ne_zero (by omega)
  let : Finite K := Finite.of_injective (inclusion (show K ≤ U R s.endpoint from inf_le_left))
    (inclusion_injective _)
  have hJK : J ≤ K := inf_le_inf_right _
    (Escape.EdgeTransfer.edge_commutator_le_natural common.large_distance
      (moduleFacts common) s.endpoint w.intermediate s.path.end_color w.adjacent_endpoint)
  let : Finite J := Finite.of_injective (inclusion hJK) (inclusion_injective _)
  have hlt : Nat.card J < Nat.card K := by
    by_contra! hh
    have he : J = K := eq_of_le_of_card_ge hJK hh
    apply w.avoidance
    exact (s.criticalLine_le_endpoint_kernel common).trans (he.symm.le.trans (show J ≤ edgeCommutator R s.endpoint w.intermediate from inf_le_left))
  have hDJ := w.commutator_le_edge_kernel hb
  have hD := w.commutator_card common hb
  have hdvd : 2 ∣ Nat.card J := hD ▸ card_dvd_of_le hDJ
  have hk := s.endpoint_kernel_card_le_four common
  change Nat.card K ≤ 4 at hk
  apply eq_of_le_of_card_ge hDJ
  change Nat.card J ≤ Nat.card (s.endpointCommutator w)
  omega

end Continuation

/-- Avoidance forces the common endpoint kernel to be a full plane. -/
theorem endpoint_kernel_card (common : CommonFacts R source geometry) (hb : 4 < geometry.b R) :
    Nat.card (U R s.endpoint ⊓ Q R s.start : Subgroup (FreeAmalgam R)) = 4 := by
  obtain ⟨w⟩ := s.continuation_exists common (by omega)
  let K := U R s.endpoint ⊓ Q R s.start
  have hU := common.natural.card_at s.endpoint s.path.end_color
  let : Finite (U R s.endpoint) := Nat.finite_of_card_ne_zero (by omega)
  let : Finite K := Finite.of_injective (inclusion (show K ≤ U R s.endpoint from inf_le_left))
    (inclusion_injective _)
  have hD := w.commutator_card common hb
  have hdvd : 2 ∣ Nat.card K := hD ▸ card_dvd_of_le (w.commutator_le_endpoint_kernel common hb)
  have hlt : 2 < Nat.card K := by
    by_contra! hh
    have he : s.endpointCommutator w = K := eq_of_le_of_card_ge
      (w.commutator_le_endpoint_kernel common hb) (by omega)
    apply w.avoidance
    exact (s.criticalLine_le_endpoint_kernel common).trans
      (he.symm.le.trans ((w.commutator_le_edge_kernel hb).trans inf_le_left))
  have hk := s.endpoint_kernel_card_le_four common
  change Nat.card K ≤ 4 at hk
  change Nat.card K = 4
  omega

/-- The avoiding commutators generate a subgroup of the actual endpoint plane.
The reverse inclusion needs the full avoiding orbit, not merely one continuation. -/
theorem endpointSpan_le_kernel (common : CommonFacts R source geometry) (hb : 4 < geometry.b R) :
    s.endpointSpan ≤ U R s.endpoint ⊓ Q R s.start :=
  iSup_le fun w => w.commutator_le_endpoint_kernel common hb

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality.LocalCommutator.NaturalCase.Opposite.SelectedPath
