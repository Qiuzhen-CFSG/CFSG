module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Source
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceEight.Elementary

/-!
# Radius groups in the early distance-four argument

The critical-distance bound puts the radius-two group V_alpha in Q_alpha.
If V_alpha were abelian, the edge centralizer identity would put it inside
every kernel at distance two, contradicting the common escape clause at the
midpoint of a critical path of length four.

We also prove the last implication in (4.6.3). Centrality of [V_alpha,Q_alpha]
implies that V_alpha' centralizes Q_alpha by the three-subgroups lemma.
The radius group is generated by involutions, so its central derived subgroup
has exponent two and lies in X_alpha = Z_alpha. The centrality premise itself
is not proved here. The fixed-subgroup definition uses the actual local
quotient and records the containment needed for its actor.

Source: Meierfrankenfeld--Stellmacher (1993), the radius notation on p.855,
(4.3) and (4.6.3), pp.883--889 and 901--902.
-/

@[expose] public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
open scoped commutatorElement
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Early
variable {M : Type*} [Group M] {L R : Subgroup M}
  {source : LocalSource L R} {geometry : Geometry R}
  (common : CommonFacts R source geometry)

include common

/-- For b > 2 every generator of the radius-two group lies in the local kernel. -/
theorem radius_le_Q (a : Vertex R) (ha : color R a = false) :
    V R a ≤ Q R a := by
  apply iSup_le
  intro t
  apply iSup_le
  intro ht
  by_cases hcol : color R t = false
  · apply Z_le_Q_of_dist_lt R t (geometry.exists_critical t hcol)
    rw [geometry.distance_constant t hcol]
    exact ht.trans_lt common.large_distance
  · have hc : color R t = true := by cases hh : color R t <;> simp_all
    obtain ⟨p, hp⟩ := (cosetGraph_connected R).exists_walk_length_eq_dist t a
    have hnEven : ¬ Even ((cosetGraph R).dist t a) := by
      rw [← hp, walk_even_iff_color_eq, hc, ha]
      decide
    rw [Nat.even_iff] at hnEven
    have hd : (cosetGraph R).dist t a = 1 := by omega
    have hadj : Adjacent R a t := adjacent_symm R
      ((cosetGraph_adj R _ _).mp (SimpleGraph.dist_eq_one_iff_adj.mp hd))
    have hta : Z R t ≤ Z R a := by
      rw [Z, if_neg hcol, Z, if_pos ha]
      exact le_iSup_of_le t (le_iSup_of_le hadj le_rfl)
    exact hta.trans (by rw [← common.X_eq_Z a ha]; exact omegaCenter_le _)

/-- The local Z-layer is central in the actual radius-two group. -/
theorem Z_le_radius_center (a : Vertex R) (ha : color R a = false) :
    Z R a ≤ (center (V R a)).map (V R a).subtype := by
  intro x hx
  refine ⟨⟨x, Z_le_VBall R a 2 hx⟩, ?_, rfl⟩
  apply mem_center_iff.mpr
  intro y
  apply Subtype.ext
  exact (commutator_eq_bot_iff_le_centralizer.mp (geometry.centralizes a ha))
    hx y (radius_le_Q common a ha y.property)

/-- The last step of (4.6.3): the three-subgroups lemma centralizes the derived
subgroup in Q, and involution generation puts it in the omega-center X = Z.
The preceding centrality assertion remains an explicit premise. -/
theorem derived_le_Z_of_commutator_central (a : Vertex R) (ha : color R a = false)
    (hc : ⁅V R a, Q R a⁆ ≤ (center (V R a)).map (V R a).subtype) :
    ⁅V R a, V R a⁆ ≤ Z R a := by
  have hVC : ⁅⁅V R a, Q R a⁆, V R a⁆ = ⊥ := by
    apply commutator_eq_bot_iff_le_centralizer.mpr
    rintro x hx y hy
    obtain ⟨z, hz, rfl⟩ := hc hx
    exact congrArg Subtype.val ((mem_center_iff.mp hz) ⟨y, hy⟩)
  have hDQ : ⁅⁅V R a, V R a⁆, Q R a⁆ = ⊥ :=
    commutator_commutator_eq_bot_of_rotate hVC (by rwa [commutator_comm (Q R a)])
  have hDC : ⁅V R a, V R a⁆ ≤ (center (V R a)).map (V R a).subtype :=
    (commutator_mono le_rfl (radius_le_Q common a ha)).trans hc
  let := DistanceEight.elementary_commutator_of_omegaOne_eq_self
    (V R a) (V R a) (V R a) le_rfl (DistanceEight.VBall_omegaOne R a 2) hDC
  rw [← common.X_eq_Z a ha]
  intro x hx
  apply mem_omegaCenter_iff.mpr
  exact ⟨radius_le_Q common a ha (commutator_le_self _ hx),
    elemPow_eq_one_of_isElementaryAbelian x hx,
    (commutator_eq_bot_iff_le_centralizer.mp hDQ) hx⟩

/-- An abelian radius group lies in every kernel at distance two. The
neighbor kernel and the source edge centralizer equality give the containment. -/
theorem radius_le_Q_of_commutative [Finite M] (a c : Vertex R)
    (ha : color R a = false) (hd : (cosetGraph R).dist a c = 2)
    (hc : IsMulCommutative (V R a)) : V R a ≤ Q R c := by
  obtain ⟨p, hp⟩ := (cosetGraph_connected R).exists_walk_length_eq_dist a c
  have hc_col : color R c = false := by
    have heven : Even p.length := by rw [hp, hd]; decide
    exact ((walk_even_iff_color_eq R p).mp heven).symm.trans ha
  cases p with
  | nil => simp_all
  | @cons a b c hab p =>
    cases p with
    | nil => simp_all
    | @cons b d c hbd p =>
      have hp0 : p.length = 0 := by simp only [SimpleGraph.Walk.length_cons, hd] at hp; omega
      have heq : d = c := (SimpleGraph.Walk.length_eq_zero_iff.mp hp0).eq
      subst d
      have hab' := (cosetGraph_adj R _ _).mp hab
      have hbc' := (cosetGraph_adj R _ _).mp hbd
      have hb : color R b = true := by
        have hh := adjacent_color_ne R hab'
        cases hcol : color R b <;> simp_all
      rw [← common.centralizer c b hc_col (adjacent_symm R hbc')]
      refine le_inf ((radius_le_Q common a ha).trans (Q_le_adjacent_h R hb hab')) ?_
      have hZc : Z R c ≤ V R a :=
        le_iSup_of_le c (le_iSup_of_le (by rw [SimpleGraph.dist_comm, hd]) le_rfl)
      exact (le_centralizer_iff_isMulCommutative.mpr hc).trans (centralizer_le hZc)

/-- At distance four, an abelian radius group contradicts the supplied
escape clause at the midpoint of a critical geodesic. -/
theorem radius_not_commutative [Finite M] (hb : geometry.b R = 4)
    (a : Vertex R) (ha : color R a = false) : ¬ IsMulCommutative (V R a) := by
  intro hc
  obtain ⟨a', hcrit⟩ := criticalPair_exists R a (geometry.exists_critical a ha)
  have hd : (cosetGraph R).dist a a' = 4 := by
    rw [hcrit.1, geometry.distance_constant a ha]
    exact hb
  obtain ⟨p, hp⟩ := (cosetGraph_connected R).exists_walk_length_eq_dist a a'
  have hleft := SimpleGraph.dist_le (p.take 2)
  have hright := SimpleGraph.dist_le (p.drop 2)
  have hsum := (cosetGraph_connected R).dist_triangle (u := a) (v := p.getVert 2) (w := a')
  have hlen : p.length = 4 := hp.trans hd
  simp only [SimpleGraph.Walk.take_length, SimpleGraph.Walk.drop_length, hlen] at hleft hright
  have hac : (cosetGraph R).dist a (p.getVert 2) = 2 := by omega
  have hca' : (cosetGraph R).dist (p.getVert 2) a' = 2 := by omega
  exact common.escape a ha a' hcrit (p.getVert 2) hca' (by omega)
    (radius_le_Q_of_commutative common a _ ha hac hc)

/-- The radius-derived subgroup is nontrivial in the distance-four branch. -/
theorem radius_derived_ne_bot [Finite M] (hb : geometry.b R = 4)
    (a : Vertex R) (ha : color R a = false) : ⁅V R a, V R a⁆ ≠ ⊥ := by
  intro h
  exact radius_not_commutative common hb a ha (commutator_self_eq_bot_iff.mp h)

/-- Finiteness comes from the local stabilizer, never from the free amalgam. -/
theorem finite_radius [Finite M] (a : Vertex R) (ha : color R a = false) :
    Finite (V R a) := by
  let := finite_stabilizer R a
  exact Finite.of_injective (inclusion ((radius_le_Q common a ha).trans
    (fun _ hx => hx.1))) (inclusion_injective _)

/-- The Z-containment in (4.6.5) also supplies the centrality field of EarlyFacts. -/
theorem commutator_central_of_le_Z (a : Vertex R) (ha : color R a = false)
    (hZ : ⁅V R a, Q R a⁆ ≤ Z R a) :
    ⁅V R a, Q R a⁆ ≤ (center (V R a)).map (V R a).subtype :=
  hZ.trans (Z_le_radius_center common a ha)

omit common in
/-- The preimage in V of the fixed subgroup in the actual local quotient by Z.
Use mem_radiusFixed_iff with A contained in the local stabilizer to avoid
truncating the acting subgroup through subgroupOf. -/
noncomputable def radiusFixed (geometry : Geometry R) (a : Vertex R)
    (A : Subgroup (FreeAmalgam R)) : Subgroup (FreeAmalgam R) :=
  letI := geometry.Z_normal a
  (centralizerModulo ((V R a).subgroupOf (stabilizer R a))
    (A.subgroupOf (stabilizer R a)) ((Z R a).subgroupOf (stabilizer R a))).map
      (stabilizer R a).subtype

/-- Membership in the quotient fixed subgroup is exactly the ambient
commutator condition, with no implicit change to the actor. -/
theorem mem_radiusFixed_iff (a : Vertex R) (ha : color R a = false)
    (A : Subgroup (FreeAmalgam R)) (hA : A ≤ stabilizer R a) (x : FreeAmalgam R) :
    x ∈ radiusFixed geometry a A ↔ x ∈ V R a ∧ ∀ g ∈ A, ⁅g, x⁆ ∈ Z R a := by
  let := geometry.Z_normal a
  constructor
  · rintro ⟨v, hv, rfl⟩
    obtain ⟨hv, hc⟩ := mem_centralizerModulo_iff.mp hv
    exact ⟨hv, fun g hg => hc ⟨g, hA hg⟩ hg⟩
  · rintro ⟨hx, hc⟩
    refine ⟨⟨x, (radius_le_Q common a ha hx).1⟩,
      mem_centralizerModulo_iff.mpr ⟨hx, ?_⟩, rfl⟩
    intro g hg
    exact hc g hg

omit common in
/-- For the actual local residual, the quotient fixed subgroup is source B. -/
theorem radiusFixed_component_eq_B (a : Vertex R) :
    radiusFixed geometry a (Ltilde R a) = B R a (geometry.Z_normal a) := by
  have hL : (Ltilde R a).subgroupOf (stabilizer R a) = pResidual 2 (stabilizer R a) := by
    exact comap_map_eq_self_of_injective (stabilizer R a).subtype_injective _
  unfold radiusFixed B
  rw [hL]

/-- The normal Z-layer is contained in the source fixed-subgroup preimage. -/
theorem Z_le_B (a : Vertex R) (ha : color R a = false) :
    Z R a ≤ B R a (geometry.Z_normal a) := by
  intro x hx
  apply (mem_B_iff R a (geometry.Z_normal a)
    ((radius_le_Q common a ha).trans (fun _ hv => hv.1)) x).mpr
  refine ⟨Z_le_VBall R a 2 hx, fun l hl => ?_⟩
  exact le_normalizer_iff_commutator_le_right.mp
    ((show Ltilde R a ≤ stabilizer R a from map_subtype_le _).trans (Z_normalized R a))
      (commutator_mem_commutator hl hx)

/-- The source fixed-subgroup preimage lies in the radius group. -/
theorem B_le_radius (a : Vertex R) (ha : color R a = false) :
    B R a (geometry.Z_normal a) ≤ V R a := by
  intro x hx
  exact ((mem_B_iff R a (geometry.Z_normal a)
    ((radius_le_Q common a ha).trans (fun _ hv => hv.1)) x).mp hx).1

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Early
