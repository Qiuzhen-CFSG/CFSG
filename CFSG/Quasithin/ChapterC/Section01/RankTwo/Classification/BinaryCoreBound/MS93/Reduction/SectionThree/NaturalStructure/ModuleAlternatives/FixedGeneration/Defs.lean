module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.SectionThree.NaturalStructure.ModuleAlternatives.CentralAttachments.Basic

/-!
# Fixed-generation input for the binary module alternatives

`TwoFixedGenerated` specifies generation by full fixed spaces of nontrivial
two-subgroups of the actual matrix actor. It imposes no splitting, moving-space
identity or module shape. The source Z satisfies this condition via its
adjacent omega-centers; proving the resulting central-sum identity remains
an algebraic step.
Source: Meierfrankenfeld–Stellmacher (1993), (2.1), (3.2), pp.855,863.
-/

@[expose] public section
open Subgroup Stellmacher.PushingUp.AmalgamGraph
open Representation Representation.BinaryOffender
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.ModuleAlternatives.FixedGeneration
variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]

/-- An invariant subspace generated by full fixed spaces of nontrivial two-subgroups
of the actual matrix actor. The ambient module need not be semisimple. -/
def TwoFixedGenerated (ρ : Representation (ZMod 2) SL V) (W : Subrepresentation ρ) : Prop :=
  ∃ S : Set (Subgroup SL),
    (∀ A ∈ S, IsPGroup 2 A ∧ A ≠ ⊥) ∧
    W.toSubmodule = ⨆ A ∈ S, fixedSpace ρ A
end CFSG.Quasithin.ChapterC.BinaryMS.MS93.ModuleAlternatives.FixedGeneration
