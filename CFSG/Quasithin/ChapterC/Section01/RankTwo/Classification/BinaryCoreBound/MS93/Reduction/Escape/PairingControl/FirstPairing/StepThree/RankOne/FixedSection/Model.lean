module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Setup.Source

/-!
# A line parabolic fixing the dual of a displacement plane

Covectors fixed by a matrix subgroup annihilate its natural displacements.
If the displacement has order four, two distinct nonzero fixed covectors
would embed it into a common annihilator of order two. Thus all fixed
covectors lie on one binary line. Explicit determinant-one flag matrices
conjugate its stabilizer to the standard line parabolic.

Only the eight binary vectors and their pairings are checked by reduction;
no matrix subgroups are enumerated. This is the compatible-coordinate step
in MS93 (4.3.2)(3), printed p.884.
-/

@[expose] public section

open Subgroup Matrix
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.Escape.PairingControl.FirstPairing.StepThree.RankOne.FixedSection

/-- The subgroup generated by all natural matrix displacements. -/
def matrixDisplacement (P : Subgroup SL) : Subgroup (Multiplicative (Fin 3 → ZMod 2)) :=
  closure {v | ∃ g ∈ P, ∃ x : Fin 3 → ZMod 2,
    v = Multiplicative.ofAdd (g.val.mulVec x - x)}

/-- Fixed covectors for the literal contragredient matrix action. -/
def dualFixed (P : Subgroup SL) (v : Fin 3 → ZMod 2) : Prop :=
  ∀ g ∈ P, (g⁻¹.val).transpose.mulVec v = v

private def pairingHom (f : Fin 3 → ZMod 2) :
    Multiplicative (Fin 3 → ZMod 2) →* Multiplicative (ZMod 2) where
  toFun v := Multiplicative.ofAdd (dotProduct f v.toAdd)
  map_one' := by simp
  map_mul' v w := by simp [dotProduct_add]

private theorem displacement_annihilated {P : Subgroup SL} {f : Fin 3 → ZMod 2}
    (hf : dualFixed P f) : matrixDisplacement P ≤ (pairingHom f).ker := by
  apply (Subgroup.closure_le _).mpr
  rintro v ⟨g, hg, x, rfl⟩
  have hh := hf g⁻¹ (P.inv_mem hg)
  simp only [inv_inv] at hh
  change Multiplicative.ofAdd (dotProduct f (g.val.mulVec x - x)) = 1
  have he : dotProduct f (g.val.mulVec x) = dotProduct f x := by
    rw [← dotProduct_transpose_mulVec, hh, dotProduct_comm]
  rw [dotProduct_sub, he, sub_self]
  rfl

private theorem common_annihilator_card : ∀ f v : Fin 3 → ZMod 2,
    f ≠ 0 → v ≠ 0 → v ≠ f →
    Fintype.card {x : Fin 3 → ZMod 2 // dotProduct f x = 0 ∧ dotProduct v x = 0} = 2 := by
  decide

private theorem dual_fixed_eq_zero_or {P : Subgroup SL}
    (hP : Nat.card (matrixDisplacement P) = 4) {f : Fin 3 → ZMod 2}
    (hf0 : f ≠ 0) (hf : dualFixed P f) {v : Fin 3 → ZMod 2}
    (hv : dualFixed P v) : v = 0 ∨ v = f := by
  by_contra hn
  push Not at hn
  let j : matrixDisplacement P →
      {x : Fin 3 → ZMod 2 // dotProduct f x = 0 ∧ dotProduct v x = 0} := fun w =>
    ⟨w.val.toAdd, by
      constructor
      · have hh := displacement_annihilated hf w.property
        exact Multiplicative.ofAdd.injective hh
      · have hh := displacement_annihilated hv w.property
        exact Multiplicative.ofAdd.injective hh⟩
  have hj : Function.Injective j := by
    intro x y he
    apply Subtype.ext
    apply Multiplicative.toAdd.injective
    exact congrArg (fun z => z.val) he
  have hc := Nat.card_le_card_of_injective j hj
  rw [hP, Nat.card_eq_fintype_card, common_annihilator_card f v hf0 hn.1 hn.2] at hc
  omega

private def flagMatrix (f : Fin 3 → ZMod 2) : Matrix (Fin 3) (Fin 3) (ZMod 2) :=
  if f 2 = 1 then !![1,0,0; 0,1,0; f 0,f 1,1]
  else if f 1 = 1 then !![1,0,0; f 0,0,1; 0,1,0]
  else !![0,0,1; 1,0,0; 0,1,0]

private theorem flagMatrix_det : ∀ f : Fin 3 → ZMod 2, (flagMatrix f).det = 1 := by
  decide

private def covectorFlag (f : Fin 3 → ZMod 2) : SL := ⟨flagMatrix f, flagMatrix_det f⟩

private theorem covectorFlag_coordinates : ∀ f : Fin 3 → ZMod 2, f ≠ 0 →
    (covectorFlag f).val.transpose.mulVec f = ![0,0,1] := by
  decide

private theorem standard_dual_fixed (g : SL) (hg : g ∈ Matrix.PSL3Two.lineParabolicSL) :
    (g⁻¹.val).transpose.mulVec ![0,0,1] = ![0,0,1] := by
  obtain ⟨h0, h1⟩ := (Matrix.PSL3Two.mem_lineParabolicSL_iff g⁻¹).mp
    (Matrix.PSL3Two.lineParabolicSL.inv_mem hg)
  have h2 : (g⁻¹.val) 2 2 = 1 := by
    have hb : ∀ z : ZMod 2, z = 0 ∨ z = 1 := by decide
    rcases hb ((g⁻¹.val) 2 2) with h | h
    · have hn := Matrix.SpecialLinearGroup.row_ne_zero g⁻¹ 2
      exfalso
      apply hn
      ext i
      fin_cases i <;> assumption
    · exact h
  have he (A : Matrix (Fin 3) (Fin 3) (ZMod 2)) :
      A.transpose.mulVec ![0,0,1] = fun i => A 2 i := by
    ext i
    simp [mulVec, dotProduct, Fin.sum_univ_three]
  rw [he]
  ext i
  fin_cases i <;> assumption

private theorem dual_action_mul (g h : SL) (v : Fin 3 → ZMod 2) :
    ((g * h)⁻¹.val).transpose.mulVec v =
      (g⁻¹.val).transpose.mulVec ((h⁻¹.val).transpose.mulVec v) := by
  rw [_root_.mul_inv_rev, Matrix.SpecialLinearGroup.coe_mul, transpose_mul, mulVec_mulVec]

private theorem covector_line_fixed {f : Fin 3 → ZMod 2} (hf : f ≠ 0) :
    ∃ flag : SL, dualFixed (modelParabolic flag true) f := by
  refine ⟨covectorFlag f, ?_⟩
  rintro g ⟨h, hh, rfl⟩
  change (((covectorFlag f * h) * (covectorFlag f)⁻¹)⁻¹.val).transpose.mulVec f = f
  rw [dual_action_mul, dual_action_mul, inv_inv, covectorFlag_coordinates f hf,
    standard_dual_fixed h hh, ← covectorFlag_coordinates f hf]
  rw [mulVec_mulVec, ← transpose_mul, ← Matrix.SpecialLinearGroup.coe_mul, mul_inv_cancel,
    Matrix.SpecialLinearGroup.coe_one, transpose_one, one_mulVec]

/-- A natural displacement plane has its entire dual fixed space fixed by
a compatible line parabolic. -/
theorem exists_line_fixed_of_displacement_card (P : Subgroup SL)
    (hP : Nat.card (matrixDisplacement P) = 4) :
    ∃ flag : SL, ∀ v : Fin 3 → ZMod 2,
      dualFixed P v → dualFixed (modelParabolic flag true) v := by
  classical
  by_cases hn : ∃ f : Fin 3 → ZMod 2, f ≠ 0 ∧ dualFixed P f
  · obtain ⟨f, hf0, hf⟩ := hn
    obtain ⟨flag, hflag⟩ := covector_line_fixed hf0
    refine ⟨flag, fun v hv => ?_⟩
    rcases dual_fixed_eq_zero_or hP hf0 hf hv with rfl | rfl
    · intro g _
      exact mulVec_zero _
    · exact hflag
  · refine ⟨1, fun v hv => ?_⟩
    have hv0 : v = 0 := by
      by_contra h
      exact hn ⟨v, h, hv⟩
    subst v
    intro g _
    exact mulVec_zero _

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.Escape.PairingControl.FirstPairing.StepThree.RankOne.FixedSection
