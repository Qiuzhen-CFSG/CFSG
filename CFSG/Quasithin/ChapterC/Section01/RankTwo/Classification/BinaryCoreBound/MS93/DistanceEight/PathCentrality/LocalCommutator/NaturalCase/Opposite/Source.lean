module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceEight.PathCentrality.LocalCommutator.NaturalCase.Opposite.Quotient

/-!
# Selected configurations for the zero-fixed-space argument on MS93 p.891

The selection may change the original pair by conjugation. `SelectedPath`
retains that conjugator, a genuine critical path, the actual natural frame at
its first two-step pair, the moving element, both edge identities, and the
chosen centralizer bound at its third vertex. No constructor is asserted here.

`Continuation` quantifies only over the source's ordered-pair orbit with the
critical-line avoidance condition. It does not assert that the continued pair
is critical. `endpointSpan` is generated by exactly these endpoint commutators;
the identification with U_(a′) ∩ Q_a and its order are separate proof obligations.
`BackwardClosing` retains a selected backward pair and its displacement identity.

The printed definition of R_(a′+2) omits `+2` from its second commutator index.
Here it means [Z_(a+2), Z_(a′+2)], the newly critical pair in the preceding
sentence. The literal [Z_(a+2), Z_(a′)] is trivial by critical minimality.
The geometry module proves this diagnostic. We retain the intended endpoint
commutator rather than assuming the impossible literal noncommutation.

These are intermediate outputs, not extra hypotheses of the requested
orientation theorem. Their producers and final discharge remain outstanding.
Source: Meierfrankenfeld--Stellmacher (1993), (4.4.1), claim (1), p.891.
-/

@[expose] public section
open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality.LocalCommutator.NaturalCase.Opposite
variable {M : Type*} [Group M] {R : Subgroup M} {geometry : Geometry R}

/-- The source selection, retaining the original ordered pair and all changes
of conjugate. Existence is a substantive, still outstanding deduction. -/
structure SelectedPath (R : Subgroup M) (geometry : Geometry R) (a c : Vertex R) where
  start : Vertex R
  endpoint : Vertex R
  path : CriticalPath R geometry start endpoint
  conjugator : FreeAmalgam R
  start_image : act R conjugator a = start
  center_image : act R conjugator c = path.walk.getVert 2
  frame : FrameAt start (path.walk.getVert 2)
  opposite : ¬ frame.SameOrientation
  element : FreeAmalgam R
  element_mem : element ∈ Z R start
  moving : ¬ ⁅zpowers element, Q R (path.walk.getVert 2)⁆ ≤
    fixedCore R (path.walk.getVert 2)
  displacement : ⁅zpowers element, Q R (path.walk.getVert 2)⁆ =
    edgeCommutator R start (path.walk.getVert 1)
  edge_eq : edgeCommutator R start (path.walk.getVert 1) =
    edgeCommutator R (path.walk.getVert 2) (path.walk.getVert 1)
  kernel_product : Q R start ⊔ Q R (path.walk.getVert 2) =
    Q R (path.walk.getVert 1) ⊓ centralizer
      (edgeCommutator R start (path.walk.getVert 1) : Set (FreeAmalgam R))
  centralizer_selection : Q R (path.walk.getVert 3) ⊓ centralizer
      (edgeCommutator R start (path.walk.getVert 1) : Set (FreeAmalgam R)) ≤
    Q R (path.walk.getVert 2)

namespace SelectedPath
variable {a c : Vertex R} (s : SelectedPath R geometry a c)

abbrev center : Vertex R := s.path.walk.getVert 2
abbrev first : Vertex R := s.path.walk.getVert 1
abbrev third : Vertex R := s.path.walk.getVert 3
abbrev predecessor : Vertex R := s.path.walk.getVert (s.path.walk.length - 2)
noncomputable abbrev edge : Subgroup (FreeAmalgam R) := edgeCommutator R s.start s.first
noncomputable abbrev criticalLine : Subgroup (FreeAmalgam R) := ⁅Z R s.start, Z R s.endpoint⁆

/-- An avoiding forward continuation, before proving it is critical. -/
structure Continuation where
  intermediate : Vertex R
  vertex : Vertex R
  adjacent_endpoint : Adjacent R s.endpoint intermediate
  adjacent_vertex : Adjacent R intermediate vertex
  conjugator : FreeAmalgam R
  start_image : act R conjugator s.start = vertex
  center_image : act R conjugator s.center = s.endpoint
  avoidance : ¬ s.criticalLine ≤ edgeCommutator R s.endpoint intermediate

/-- The commutator of the actual continued endpoints. -/
noncomputable def endpointCommutator (w : s.Continuation) : Subgroup (FreeAmalgam R) :=
  ⁅Z R s.center, Z R w.vertex⁆

/-- Source R₃, generated only by the avoiding ordered-pair continuations. -/
noncomputable def endpointSpan : Subgroup (FreeAmalgam R) :=
  ⨆ w : s.Continuation, s.endpointCommutator w

/-- The actual V₀ for a chosen continuation, with its own endpoint stabilizer. -/
noncomputable def continuationSpan (w : s.Continuation) : Subgroup (FreeAmalgam R) :=
  localZSpan R w.vertex s.endpoint

/-- The forward continuation calculation, including every source group used
to deduce the moving-layer containment. These fields still need a producer. -/
structure ForwardFacts : Prop where
  continuation_exists : Nonempty s.Continuation
  critical : ∀ w : s.Continuation,
    ∃ hc : color R s.center = false,
      CriticalPair R s.center w.vertex (geometry.exists_critical s.center hc)
  commutator_eq : ∀ w : s.Continuation,
    s.endpointCommutator w = edgeCommutator R s.endpoint w.intermediate ⊓ Q R s.start
  generated_eq : s.endpointSpan = U R s.endpoint ⊓ Q R s.start
  generated_card : Nat.card s.endpointSpan = 4
  span_index : ∀ w : s.Continuation, (Q R s.center).relIndex (s.continuationSpan w) = 4
  radius_commutator : ∀ w : s.Continuation,
    ⁅V R s.center ⊓ Q R s.endpoint, s.continuationSpan w⁆ ≤ s.endpointSpan
  moving_le_span : Vcirc R s.center ≤ localZSpan R s.start s.center

/-- The selected backward vertex and the final displacement identity.
Noncontainment, not an assumed critical-pair label, constructs the new path. -/
structure BackwardClosing where
  intermediate : Vertex R
  vertex : Vertex R
  adjacent_start : Adjacent R vertex intermediate
  adjacent_center : Adjacent R intermediate s.start
  conjugator : FreeAmalgam R
  start_image : act R conjugator s.start = vertex
  center_image : act R conjugator s.center = s.start
  noncontainment : ¬ Z R vertex ≤ Q R s.predecessor
  displacement : ⁅Z R s.start, V R s.predecessor⁆ ⊓ Z R s.predecessor = s.edge

end SelectedPath
end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality.LocalCommutator.NaturalCase.Opposite
