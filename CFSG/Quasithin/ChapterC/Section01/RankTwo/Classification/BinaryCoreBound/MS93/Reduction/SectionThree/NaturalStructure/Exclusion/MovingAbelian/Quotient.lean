module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.SectionThree.NaturalStructure.Exclusion.Radius
public import Theory.GroupTheory.CentralQuotientCommutatorForms

/-!
# The elementary central quotient of the moving radius

The radius is generated by elementary Z layers, so every square lies in its
derived subgroup. When that derived subgroup is fixed by the local residual,
the moving radius centralizes it. Its central quotient is therefore elementary
abelian. Conjugation gives an action of the actual vertex stabilizer on this
quotient, and residual commutator generation survives passage to the quotient.

No assertion that the two-core acts trivially is needed or made. Finiteness
comes from the local stabilizer; the free amalgam can remain infinite.
Source: Meierfrankenfeld--Stellmacher (1993), the constituent and commutator
pairing argument in (3.8), printed p.878.
-/

@[expose] public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
open Representation.BinaryOffender
open scoped commutatorElement IsMulCommutative
set_option backward.isDefEq.respectTransparency false
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.NaturalStructure.Exclusion
variable {M : Type*} [Group M] {L R : Subgroup M}

/-- Involution generation makes the abelianization of the actual radius elementary. -/
theorem radius_sq_mem_derived (geometry : Geometry R) (hb : 0 < geometry.b R)
    (a : Vertex R) (ha : color R a = false) (x : V R a) :
    (x : FreeAmalgam R) ^ 2 ∈ ⁅V R a, V R a⁆ := by
  let D := _root_.commutator (V R a)
  let q := QuotientGroup.mk' D
  let : IsMulCommutative ((V R a) ⧸ D) :=
    Normal.quotient_commutative_iff_commutator_le.mpr le_rfl
  let K := ((powMonoidHom 2).comp q).ker
  have hVK : V R a ≤ K.map (V R a).subtype := by
    apply radius_le_of_m_ball ha
    intro d hd hdist z hz
    have hzV : z ∈ V R a :=
      (show Z R d ≤ V R a from le_iSup_of_le d (le_iSup_of_le hdist le_rfl)) hz
    let zV : V R a := ⟨z, hzV⟩
    refine ⟨zV, ?_, rfl⟩
    change q zV ^ 2 = 1
    rw [← map_pow]
    have hp : zV ^ 2 = 1 := by
      apply Subtype.ext
      let := geometry.Z_elementary hb d hd
      exact elemPow_eq_one_of_isElementaryAbelian z hz
    rw [hp, map_one]
  obtain ⟨y, hy, hyx⟩ := hVK x.property
  have he : y = x := Subtype.ext hyx
  subst y
  have hx : q x ^ 2 = 1 := hy
  have hxD : x ^ 2 ∈ D := (QuotientGroup.eq_one_iff _).mp (by
    change q (x ^ 2) = 1
    rw [map_pow]
    exact hx)
  rw [← map_subtype_commutator]
  exact mem_map_of_mem (V R a).subtype hxD

/-- The moving radius has an elementary central quotient: its squares lie in
the full derived radius, which it centralizes. -/
theorem moving_central_quotient_elementary (geometry : Geometry R)
    (hb : 0 < geometry.b R) (a : Vertex R) (ha : color R a = false)
    (hfixed : ⁅V R a, V R a⁆ ≤ fixedCore R a) :
    IsElementaryAbelian 2 ((Vcirc R a) ⧸ center (Vcirc R a)) := by
  have hm : Vcirc R a ≤ V R a := le_normalizer_iff_commutator_le_left.mp
    ((Ltilde_le_stabilizer a).trans (V_normalized a))
  have hc := commutator_eq_bot_iff_le_centralizer.mp
    (moving_centralizes_derived a hfixed)
  have hs (x : Vcirc R a) : x ^ 2 ∈ center (Vcirc R a) := by
    apply mem_center_iff.mpr
    intro y
    apply Subtype.ext
    exact (hc y.property _ (radius_sq_mem_derived geometry hb a ha ⟨x, hm x.property⟩)).symm
  have hp (x : (Vcirc R a) ⧸ center (Vcirc R a)) : x ^ 2 = 1 := by
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (center (Vcirc R a)) x
    rw [← map_pow]
    exact (QuotientGroup.eq_one_iff _).mpr (hs x)
  have hcomm : IsMulCommutative ((Vcirc R a) ⧸ center (Vcirc R a)) := by
    exact ⟨⟨fun x y => by
      have hi (x : (Vcirc R a) ⧸ center (Vcirc R a)) : x⁻¹ = x :=
        inv_eq_of_mul_eq_one_right (by simpa only [pow_two] using hp x)
      have h := mul_inv_rev x y
      simpa only [hi] using h⟩⟩
  exact ⟨Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr hp⟩

/-- Literal conjugation by the whole vertex stabilizer on the moving radius. -/
noncomputable def movingAction (a : Vertex R) :
    stabilizer R a →* MulAut (Vcirc R a) :=
  (Vcirc R a).normalizerMonoidHom.comp (inclusion (Vcirc_normalized a))

theorem movingAction_apply (a : Vertex R) (g : stabilizer R a) (v : Vcirc R a) :
    (movingAction a g v : FreeAmalgam R) = g * (v : FreeAmalgam R) * (g : FreeAmalgam R)⁻¹ := rfl

/-- The actual action on the central quotient, before any two-core descent. -/
noncomputable def movingQuotientAction (a : Vertex R) :
    stabilizer R a →* MulAut ((Vcirc R a) ⧸ center (Vcirc R a)) :=
  (quotientAut (center (Vcirc R a))).comp (movingAction a)

theorem movingQuotientAction_apply (a : Vertex R) (g : stabilizer R a)
    (v : Vcirc R a) :
    movingQuotientAction a g (QuotientGroup.mk' (center (Vcirc R a)) v) =
      QuotientGroup.mk' (center (Vcirc R a)) (movingAction a g v) := by
  exact quotientAut_apply_mk _ _ _

/-- Residual commutator generation survives in the elementary central quotient. -/
theorem movingQuotientAction_full [Finite M] (source : LocalSource L R)
    (geometry : Geometry R) (hb : 2 < geometry.b R)
    (a : Vertex R) (ha : color R a = false)
    (hfixed : ⁅V R a, V R a⁆ ≤ fixedCore R a) :
    letI := moving_central_quotient_elementary geometry (by omega) a ha hfixed
    subspaceCommutator (Offenders.linearize (movingQuotientAction a))
      ⊤ (pResidual 2 (stabilizer R a)) = ⊤ := by
  let := moving_central_quotient_elementary geometry (by omega) a ha hfixed
  let P := Vcirc R a
  let q := QuotientGroup.mk' (center P)
  let ρ := Offenders.linearize (movingQuotientAction a)
  let W := subspaceCommutator ρ ⊤ (pResidual 2 (stabilizer R a))
  let J : Subgroup (P ⧸ center P) := Subgroup.toAddSubgroup.symm W.toAddSubgroup
  have hP : P ≤ (J.comap q).map P.subtype := by
    change Vcirc R a ≤ _
    conv_lhs => rw [← moving_full_commutation source geometry hb a ha, commutator_comm]
    apply commutator_le.mpr
    intro l hl v hv
    obtain ⟨g, hg, rfl⟩ := hl
    let vP : P := ⟨v, hv⟩
    refine ⟨movingAction a g vP * vP⁻¹, ?_, ?_⟩
    · change Additive.ofMul (q (movingAction a g vP * vP⁻¹)) ∈ W
      have hh : ρ g (Additive.ofMul (q vP)) - Additive.ofMul (q vP) ∈ W :=
        Submodule.subset_span ⟨g, hg, Additive.ofMul (q vP), Submodule.mem_top, rfl⟩
      simp only [ρ, Offenders.linearize, sub_eq_add_neg] at hh
      change Additive.ofMul (movingQuotientAction a g (q vP) * (q vP)⁻¹) ∈ W at hh
      rw [movingQuotientAction_apply] at hh
      simpa only [map_mul, map_inv] using hh
    · change (movingAction a g vP : FreeAmalgam R) * v⁻¹ = _
      rw [movingAction_apply]
      rfl
  apply top_unique
  intro v _
  obtain ⟨p, hp⟩ := QuotientGroup.mk'_surjective (center P) v.toMul
  obtain ⟨w, hw, he⟩ := hP p.property
  have he' : w = p := Subtype.ext he
  subst w
  change Additive.ofMul (q p) ∈ W at hw
  change q p = v.toMul at hp
  rw [hp] at hw
  exact hw

/-- Only the finite vertex stabilizer is used to prove finiteness of the moving radius. -/
theorem finite_moving [Finite M] (geometry : Geometry R) (hb : 2 < geometry.b R)
    (a : Vertex R) (ha : color R a = false) : Finite (Vcirc R a) := by
  let := finite_stabilizer R a
  have hm : Vcirc R a ≤ V R a := le_normalizer_iff_commutator_le_left.mp
    ((Ltilde_le_stabilizer a).trans (V_normalized a))
  have hS : Vcirc R a ≤ stabilizer R a :=
    hm.trans ((geometry.V_le_Q hb a ha).trans (fun _ hx => hx.1))
  exact Finite.of_injective (inclusion hS) (inclusion_injective hS)

/-- The intrinsic derived subgroup of the moving radius is elementary abelian. -/
theorem moving_derived_elementary (geometry : Geometry R) (hb : 0 < geometry.b R)
    (a : Vertex R) (ha : color R a = false)
    (hfixed : ⁅V R a, V R a⁆ ≤ fixedCore R a) :
    IsElementaryAbelian 2 (_root_.commutator (Vcirc R a)) :=
  (moving_central_quotient_elementary geometry hb a ha hfixed).derived_of_central_quotient

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.NaturalStructure.Exclusion
