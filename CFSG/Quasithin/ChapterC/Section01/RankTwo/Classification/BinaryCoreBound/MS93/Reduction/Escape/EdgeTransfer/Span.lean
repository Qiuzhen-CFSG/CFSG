module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.Escape.EdgeTransfer.Basic

/-!
# The characteristic edge span in MS93 (4.2)(i)

The source subgroup U_beta^* is generated by [Z_delta,Q_beta] over all
neighbors delta of beta. Covariance makes it invariant under the holomorph
vertex stabilizer; the literal automorphism embedding then makes its preimage
characteristic in R. Local finiteness is used only for the kernel containment.

The quotient-fixed preimage B_alpha retains its original definition. Its
containment hypothesis puts the span in B_alpha, but the further containment
in [Z_alpha,Q_beta] D_alpha is a separate source argument.

Source: Meierfrankenfeld--Stellmacher, Pushing up weak BN-pairs of rank two
(1993), (4.2)(i), printed p.882.
-/

@[expose] public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.Escape.EdgeTransfer
variable {M : Type*} [Group M] (R : Subgroup M)

/-- Source U_beta^*: the subgroup generated by the actual displacements at
every neighbor of beta. -/
noncomputable def edgeSpan (b : Vertex R) : Subgroup (FreeAmalgam R) :=
  ⨆ d, ⨆ (_ : Adjacent R d b), ⁅Z R d, Q R b⁆

/-- Every neighboring displacement is one of the defining generators. -/
theorem displacement_le_edgeSpan {a b : Vertex R} (hab : Adjacent R a b) :
    ⁅Z R a, Q R b⁆ ≤ edgeSpan R b :=
  le_iSup_of_le a (le_iSup_of_le hab le_rfl)

/-- The complete neighboring span respects the actual right-coset action. -/
theorem edgeSpan_act (g : FreeAmalgam R) (b : Vertex R) :
    edgeSpan R (act R g b) = (edgeSpan R b).map (MulAut.conj g⁻¹).toMonoidHom := by
  simp only [edgeSpan, Subgroup.map_iSup, map_commutator]
  apply le_antisymm
  · apply iSup_le
    intro d
    apply iSup_le
    intro hd
    have hd' : Adjacent R (act R g⁻¹ d) b := by
      have hh := (adjacent_act_iff R g⁻¹ d (act R g b)).mpr hd
      simpa only [← act_mul, mul_inv_cancel, act_one] using hh
    refine le_iSup_of_le (act R g⁻¹ d) (le_iSup_of_le hd' ?_)
    rw [← Z_act, ← Q_act]
    simp only [← act_mul, inv_mul_cancel, act_one, le_refl]
  · apply iSup_le
    intro d
    apply iSup_le
    intro hd
    refine le_iSup_of_le (act R g d)
      (le_iSup_of_le ((adjacent_act_iff R g d b).mpr hd) ?_)
    rw [Z_act, Q_act]

/-- The holomorph vertex stabilizer normalizes the complete neighboring span. -/
theorem edgeSpan_normalized (b : Vertex R) :
    stabilizer R b ≤ normalizer (edgeSpan R b : Set (FreeAmalgam R)) := by
  intro g hg
  rw [mem_normalizer_iff_map_conj_eq]
  change (edgeSpan R b).map (MulAut.conj g).toMonoidHom = edgeSpan R b
  have hgb : act R g⁻¹ b = b := (stabilizer R b).inv_mem hg
  simpa only [hgb, inv_inv] using (edgeSpan_act R g⁻¹ b).symm

private theorem embedS_aut_conj (f : MulAut R) (r : R) :
    embedS R (f r) = embedH R (SemidirectProduct.inr f) * embedS R r *
      (embedH R (SemidirectProduct.inr f))⁻¹ := by
  have h := congrArg (embedH R) (SemidirectProduct.inl_aut f r)
  have hcomp (s : R) : embedH R (SemidirectProduct.inl s) = embedS R s :=
    DFunLike.congr_fun (embedH_comp_inl R) s
  simpa only [MonoidHom.id_apply, map_mul, map_inv, hcomp] using h

/-- At the distinguished edge, holomorph invariance supplies intrinsic
characteristicity in the original edge group R. -/
theorem edgeSpan_characteristic :
    ((edgeSpan R (beta R)).comap (embedS R)).Characteristic := by
  apply characteristic_iff_le_comap.mpr
  intro f r hr
  change embedS R (f r) ∈ edgeSpan R (beta R)
  rw [embedS_aut_conj]
  apply le_normalizer_iff.mp (edgeSpan_normalized R (beta R)) _ ?_ _ hr
  change embedH R (SemidirectProduct.inr f) ∈ stabilizer R (hVertex R 1)
  rw [stabilizer_h_base]
  exact ⟨_, rfl⟩

variable [Finite M] {L : Subgroup M} {source : LocalSource L R}
  {geometry : Geometry R} (hlarge : 2 < geometry.b R) (modules : ModuleFacts source geometry)

include hlarge modules in
/-- The span is inside the genuine edge kernel. -/
theorem edgeSpan_le_kernel (b : Vertex R) (hb : color R b = true) :
    edgeSpan R b ≤ Q R b := by
  apply iSup_le
  intro d
  apply iSup_le
  intro hd
  have hdcol : color R d = false := by
    have hh := adjacent_color_ne R hd
    cases h : color R d <;> simp_all
  exact (edge_commutator_le_natural hlarge modules d b hdcol hd).trans
    ((U_le_Z d).trans (edge_Z_le_Q hlarge d b hdcol hd))

omit [Finite M] hlarge modules in
/-- The source hypothesis puts the whole span in the quotient-fixed preimage. -/
theorem edgeSpan_le_B {a b : Vertex R}
    (h : ∀ d, Adjacent R d b → ⁅Z R d, Q R b⁆ ≤ B R a (geometry.Z_normal a)) :
    edgeSpan R b ≤ B R a (geometry.Z_normal a) := by
  exact iSup_le fun d => iSup_le fun hd => h d hd

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.Escape.EdgeTransfer
