module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Quotient.LargeBranch.Second.FullSpans
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Quotient.LargeBranch.RankOne.Recognition.Source
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Quotient.LargeBranch.RankOne.Kernel.Fixed.Displacement.Transport
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Flags.RankOne.Consequences.Displacement
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Flags.RankOne.Consequences.EdgeComparison

/-!
# A geometric involution with no extra central displacement

The two recognized full spans give VStar = Z_alpha sup core_alpha before
any exact-U kernel calculation. Hence the radius is generated by its center
and its core, at every vertex. The opposite midpoint core therefore has a
nontrivial image in the actual parabolic four-group.

The edge-plane comparison identifies U_midpoint intersect Z_alpha inside
U_alpha. Since the first span lies in Q_midpoint, commutation with the
opposite core lands in U_midpoint. An involution in its image thus has
actual displacement intersecting Z_alpha only inside U_alpha. This is the
geometric input that excludes the nonsplit natural cover; no estimate on
the dimension of core/U_alpha is used.

Source: Meierfrankenfeld--Stellmacher (1993), (1.5)(i), p.843,
(4.6.9)--(4.6.10), p.908, and (4.6.12), pp.910--912.
-/

public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.LargeBranch.RankOne
namespace Kernel
variable {M : Type*} [Group M] [Finite M] {L R : Subgroup M}
  {source : LocalSource L R} {geometry : Geometry R}
  (common : CommonFacts R source geometry) (radius : RadiusFacts R geometry)
  (hb : geometry.b R = 4)

include common radius hb

theorem radius_eq_center_sup_core (a : Vertex R) (ha : color R a = false) :
    V R a = B R a (geometry.Z_normal a) ⊔ core R a := by
  have hbase : V R (alpha R) = B R (alpha R) (geometry.Z_normal (alpha R)) ⊔
      core R (alpha R) := by
    have hstar := (fullSpans source common radius hb
      (source_spanRecognition common radius hb)).2
    rw [Flags.radius_eq_B_sup_star geometry radius.toEarlyFacts common.large_distance
      (alpha R) (beta R) rfl (base_adjacent R), hstar, ← sup_assoc,
      sup_eq_left.mpr (Flags.Z_le_B geometry _
        (geometry.V_local _ rfl common.large_distance))]
  obtain ⟨g, rfl⟩ := exists_mVertex_of_color R ha
  have hga : act R g (alpha R) = mVertex R g := by simp [alpha]
  rw [← hga, V_act, Flags.RankOne.B_act geometry radius.toEarlyFacts g _ rfl,
    core_act, hbase, Subgroup.map_sup]

theorem edge_plane (a b : Vertex R) (ha : color R a = false) (hab : Adjacent R a b) :
    ⁅Z R a, Q R b⁆ = U R a ⊓ Z R b := by
  obtain ⟨i, hi, _⟩ := Flags.RankOne.flagControl source geometry common hb radius.toEarlyFacts
  have hbase := Flags.RankOne.edge_natural_fixed_plane source geometry common
    radius.toEarlyFacts i hi
  obtain ⟨g, ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩⟩ :=
    (adjacent_iff_exists_common R a b).mp hab
  · have hh := congrArg (Subgroup.map (MulAut.conj g⁻¹).toMonoidHom) hbase
    rw [map_commutator, map_inf _ _ _ (MulAut.conj g⁻¹).injective,
      ← Z_act, ← Q_act, ← U_act, ← Z_act] at hh
    simpa only [alpha, beta, act_mVertex, act_hVertex, one_mul] using hh
  · simp [color, hVertex] at ha

theorem midpoint_U_inter_Z_le (s : CriticalSegment geometry)
    (hs : ¬ s.SmallIntersection) (hbc : Adjacent R (beta R) s.middle) :
    U R s.middle ⊓ Z R (alpha R) ≤ U R (alpha R) := by
  have hnot := large_intersection_not_le_Z radius s hs
  have hbe := Flags.edge_Z_le s.middle (beta R) s.middle_color (adjacent_symm R hbc)
  have hba := Flags.edge_Z_le (alpha R) (beta R) rfl (base_adjacent R)
  have hinter : Z R s.middle ⊓ Z R (alpha R) = Z R (beta R) := by
    have hlow : Z R (beta R) ≤ Z R s.middle ⊓ Z R (alpha R) := le_inf hbe hba
    have hmul := relIndex_mul_relIndex (Z R (beta R))
      (Z R s.middle ⊓ Z R (alpha R)) (Z R s.middle) hlow inf_le_left
    rw [radius.edge_Z_index s.middle (beta R) s.middle_color (adjacent_symm R hbc)] at hmul
    have hd : (Z R (beta R)).relIndex (Z R s.middle ⊓ Z R (alpha R)) ∣ 2 :=
      ⟨_, hmul.symm⟩
    rcases (Nat.dvd_prime (by decide : Nat.Prime 2)).mp hd with hi | hi
    · exact le_antisymm (relIndex_eq_one.mp hi) hlow
    · rw [hi] at hmul
      have hh : (Z R s.middle ⊓ Z R (alpha R)).relIndex (Z R s.middle) = 1 := by omega
      exact (hnot ((relIndex_eq_one.mp hh).trans inf_le_right)).elim
  have hinterU : U R s.middle ⊓ Z R (alpha R) = U R s.middle ⊓ Z R (beta R) := by
    rw [← hinter, ← inf_assoc, inf_eq_left.mpr (DistanceEight.U_le_Z R _)]
  rw [hinterU, ← edge_plane common radius hb s.middle (beta R) s.middle_color
    (adjacent_symm R hbc)]
  let control := Flags.RankOne.flagControl source geometry common hb radius.toEarlyFacts
  have hzero := (Flags.RankOne.localDisplacement_and_Bzero source geometry common hb
    radius.toEarlyFacts control).2
  rw [Flags.RankOne.edgeGeneratorComparison source geometry common hb
    radius.toEarlyFacts control hzero s.middle (midpoint_nu common radius hb s) hbc,
    edge_plane common radius hb (alpha R) (beta R) rfl (base_adjacent R)]
  exact inf_le_left

theorem midpoint_core_not_le_kernel (s : CriticalSegment geometry)
    (hbc : Adjacent R (beta R) s.middle) :
    ¬ core R s.middle ≤ Q R (alpha R) := by
  intro hcore
  have hQb : Q R s.middle ≤ Q R (beta R) :=
    Q_le_adjacent_h R rfl (adjacent_symm R hbc)
  have hVQ := Flags.V_le_Q geometry common.large_distance s.middle s.middle_color
  have hB : B R s.middle (geometry.Z_normal s.middle) ≤ Q R (alpha R) := by
    rw [← common.centralizer (alpha R) (beta R) rfl (base_adjacent R)]
    intro x hx
    rw [radius.B_eq_center s.middle s.middle_color] at hx
    obtain ⟨z, hz, rfl⟩ := hx
    refine ⟨hQb (hVQ z.property), ?_⟩
    intro y hy
    have hZV : Z R (alpha R) ≤ V R s.middle := le_iSup_of_le (alpha R)
      (le_iSup_of_le s.first_distance.le le_rfl)
    have hyV := hZV hy
    exact congrArg Subtype.val ((mem_center_iff.mp hz) ⟨y, hyV⟩)
  have hV : V R s.middle ≤ Q R (alpha R) := by
    rw [radius_eq_center_sup_core common radius hb s.middle s.middle_color]
    exact sup_le hB hcore
  have hcrit := (common.critical_reverse (alpha R) rfl s.endpoint
    (critical_endpoint_color R (alpha R) rfl _ s.critical) s.critical).2
  apply hcrit
  apply le_trans ?_ hV
  exact le_iSup_of_le s.endpoint (le_iSup_of_le
    (by rw [SimpleGraph.dist_comm]; exact s.second_distance.le) le_rfl)

theorem midpoint_core_involution (s : CriticalSegment geometry)
    (hbc : Adjacent R (beta R) s.middle) :
    ∃ m : M, embedM R m ∈ core R s.middle ∧ orderOf (source.projection m) = 2 := by
  obtain ⟨x, hx, hxQ⟩ := SetLike.not_le_iff_exists.mp
    (midpoint_core_not_le_kernel common radius hb s hbc)
  have hQb : Q R s.middle ≤ Q R (beta R) :=
    Q_le_adjacent_h R rfl (adjacent_symm R hbc)
  have hxb := hQb ((radius.core_le_radius s.middle s.middle_color).trans
    (Flags.V_le_Q geometry common.large_distance s.middle s.middle_color) hx)
  have hxM : x ∈ Mbar R := by
    have h := hxb.2 (alpha R) (adjacent_symm R (base_adjacent R))
    simpa only [alpha, stabilizer_m_base] using h
  obtain ⟨m, rfl⟩ := hxM
  have hmne : source.projection m ≠ 1 := by
    intro hm
    apply hxQ
    rw [Q_alpha R source.two_group source.core_le]
    apply mem_map_of_mem
    rw [← source.projection_kernel]
    exact hm
  obtain ⟨i, hi, _⟩ := Flags.RankOne.flagControl source geometry common hb radius.toEarlyFacts
  rw [← hi] at hxb
  obtain ⟨n, hn, hnm⟩ := hxb
  have hnm' : n = m := embedM_injective R hnm
  subst n
  let A := ((parabolic source.projection source.flag i).pCoreIn 2).map source.projection
  let : IsElementaryAbelian 2 A := (Fixed.Displacement.flag_actor_data source i).1
  have hmA : source.projection m ∈ A := mem_map_of_mem source.projection hn
  exact ⟨m, hx, orderOf_eq_prime (elemPow_eq_one_of_isElementaryAbelian _ hmA) hmne⟩

theorem midpoint_displacement_separated (s : CriticalSegment geometry)
    (hs : ¬ s.SmallIntersection) (hbc : Adjacent R (beta R) s.middle)
    (hspan : orbitSpan s.middle ≤ Q R s.middle) :
    ∃ m : M, orderOf (source.projection m) = 2 ∧
      ⁅orbitSpan s.middle, zpowers (embedM R m)⁆ ⊓ Z R (alpha R) ≤ U R (alpha R) := by
  obtain ⟨m, hm, ho⟩ := midpoint_core_involution common radius hb s hbc
  refine ⟨m, ho, ?_⟩
  have hcomm : ⁅orbitSpan s.middle, zpowers (embedM R m)⁆ ≤ U R s.middle := by
    apply le_trans (commutator_mono hspan (zpowers_le.mpr hm))
    rw [commutator_comm]
    exact SmallBranch.core_commutator_Q_le_U source geometry common radius
      s.middle (beta R) s.middle_color (adjacent_symm R hbc)
  exact (inf_le_inf_right _ hcomm).trans (midpoint_U_inter_Z_le common radius hb s hs hbc)

theorem source_displacement_separated (s : CriticalSegment geometry)
    (hs : ¬ s.SmallIntersection) (hspan : orbitSpan s.middle ≤ Q R s.middle) :
    ∃ m : M, orderOf (source.projection m) = 2 ∧
      ⁅orbitSpan s.middle, zpowers (embedM R m)⁆ ⊓ Z R (alpha R) ≤ U R (alpha R) := by
  obtain ⟨g, hg, hgb⟩ := exists_segment_on_base_edge s
  let t := translateSegment s g hg
  have ht : ¬ t.SmallIntersection := fun h => hs ((translateSegment_small_iff s g hg).mp h)
  have hts : orbitSpan t.middle = orbitSpan s.middle := orbitSpan_act_eq _ g hg
  have htQ : orbitSpan t.middle ≤ Q R t.middle :=
    (orbitSpan_le_kernel_act_iff s.middle g hg).mpr hspan
  simpa only [hts] using midpoint_displacement_separated common radius hb t ht hgb htQ

end Kernel
end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.LargeBranch.RankOne
