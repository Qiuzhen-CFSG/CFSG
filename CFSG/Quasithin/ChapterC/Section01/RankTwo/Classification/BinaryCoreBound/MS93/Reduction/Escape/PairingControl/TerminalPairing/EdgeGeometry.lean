module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.Escape.PairingControl.TerminalPairing.Source
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.Escape.PairingControl.Geometry.Paths

/-!
# Lifting a terminal dual line through a native neighboring layer

The full preimage of a binary line is generated by its kernel and any lift
of the nonzero vector. In the MS93 vertex group the kernel is the literal
U_a. If such a lift lies in Z_a Z_d for a moving neighbor d at t, the entire
canonical seed lies in V_t. Since Z_a centralizes Q_a, its Q_a-commutator
is contained in [Z_d,Q_a], whose order is at most four by the earlier local
natural-module calculation. No identification of Q_t with a parabolic core
is used.

`NeighborLift` isolates a sufficient geometric input: an actual element of
Vcirc_a in the native neighboring span, with nonzero dual coordinate fixed
by the selected parabolic. `bounds_of_neighbor_lift` and
`edgeSeedAt_of_neighbor_lift` prove the deductions from this input, including
the finite-stabilizer cardinality transport. They do not construct that
input from ContraryLocalFacts or TerminalSeed, and do not assert completion
of the terminal source application.

The source's step-(4) centralizer condition is recorded separately by
CentralizerChoice. `terminal_centralizer_eq_of_choice` transports it to the
TerminalSeed predecessor using uniqueness on the actual tree geodesic.
TerminalSeed alone has no such field. This transport does not claim that
the centralizer condition alone constructs NeighborLift.

Source: Meierfrankenfeld--Stellmacher, *Pushing up weak BN-pairs of rank two*
(1993), (4.3.2)(3)--(4), printed p.884, and the final (1.7)(ii) application
on pp.885--886.
-/

@[expose] public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.Escape.PairingControl.TerminalPairing.EdgeGeometry
open RankOnePairing

private theorem preimage_line_eq {A B : Type*} [Group A] [Group B]
    (J N : Subgroup A) (f : J →* B) (K : Subgroup B)
    (hN : N ≤ J) (hk : f.ker = N.subgroupOf J)
    (hcard : Nat.card K = 2) (x : J) (hx : f x ∈ K) (hne : f x ≠ 1) :
    (K.comap f).map J.subtype = N ⊔ zpowers (x : A) := by
  have hgen : zpowers (⟨f x, hx⟩ : K) = ⊤ :=
    zpowers_eq_top_of_prime_card hcard (fun h => hne (congrArg Subtype.val h))
  have hK : K = zpowers (f x) := by
    have h := congrArg (Subgroup.map K.subtype) hgen
    simpa only [MonoidHom.map_zpowers, ← MonoidHom.range_eq_map, range_subtype,
      Subgroup.subtype_apply] using h.symm
  rw [hK, ← MonoidHom.map_zpowers f x, comap_map_eq, hk, Subgroup.map_sup,
    map_subgroupOf_eq_of_le hN, MonoidHom.map_zpowers, Subgroup.subtype_apply, sup_comm]

/-- A nonzero lift generates the full binary-line preimage together with
its actual kernel. -/
theorem canonicalSeed_eq_of_lift {A : Type*} [Group A]
    (e : Extension (M := A)) {J N : Subgroup A}
    {n : NaturalFactor e.projection ⊤ N ⊥}
    (o : DualFactor e.projection ⊤ J N N n) (i : Bool)
    (hN : N ≤ J)
    (hcard : Nat.card (Incidence.DualGeometry.seedLine n.marking e.flag i) = 2)
    (x : J) (hx : o.coordinates x ∈ Incidence.DualGeometry.seedLine n.marking e.flag i)
    (hne : o.coordinates x ≠ 1) :
    canonicalSeed e o i = N ⊔ zpowers (x : A) :=
  preimage_line_eq J N o.coordinates _ hN o.kernel hcard x hx hne

variable {M : Type*} [Group M] [Finite M] {L R : Subgroup M}
  {geometry : MS93.Geometry R}

/-- The zero fixed subgroup for the actual local residual forces the marked
natural parabolic to have zero fixed space. Only residual containment is used. -/
theorem model_fixed_eq_bot (source : LocalSource L R)
    (a : Vertex R) (ha : color R a = false) (o : OppositeSectionAt a)
    (flag : SL) (hflag : BinaryWeakBN flag) (i : Bool)
    (hfixed : (U R a).subgroupOf (stabilizer R a) ⊓
      centralizer (localResidual
        (localParabolic (vertexExtension source a ha o flag hflag) i) :
          Set (stabilizer R a)) = ⊥) :
    Incidence.FixedGeometry.ValueConstruction.fixedSpace
      (Incidence.FixedGeometry.ValueConstruction.markedParabolic
        o.naturalU.marking flag i) = ⊥ := by
  apply le_bot_iff.mp
  intro v hv
  obtain ⟨u, rfl⟩ := o.naturalU.surjective v
  have hc : (u : stabilizer R a) ∈ centralizer (localResidual
      (localParabolic (vertexExtension source a ha o flag hflag) i) :
        Set (stabilizer R a)) := by
    intro r hr
    have hpar : r ∈ localParabolic (vertexExtension source a ha o flag hflag) i :=
      (map_subtype_le _) hr
    rw [vertexExtension_parabolic] at hpar
    have hπ : o.projection r ∈ modelParabolic flag i := hpar
    have hf := hv _ (mem_map_of_mem o.naturalU.marking.toMonoidHom hπ)
    let u' := MulAut.conjNormal r u
    have he : o.naturalU.coordinates u' = o.naturalU.coordinates u := by
      apply Multiplicative.toAdd.injective
      exact (o.naturalU.action r (mem_top r) u u' rfl).trans
        (congrArg Multiplicative.toAdd hf)
    have he' := congrArg Subtype.val (o.naturalU.equivOfBot.injective he)
    exact mul_inv_eq_iff_eq_mul.mp he'
  have hu : (u : stabilizer R a) = 1 := mem_bot.mp (hfixed.le ⟨u.property, hc⟩)
  have hu' : u = 1 := Subtype.ext hu
  simpa only [hu', map_one] using (one_mem
    (⊥ : Subgroup (Multiplicative (Fin 3 → ZMod 2))))

/-- A sufficient native lift for the terminal construction. This is a remaining
geometric obligation, not a consequence of opposite coordinates alone. -/
structure NeighborLift (a t : Vertex R) (o : OppositeSectionAt a) (flag : SL) (i : Bool) where
  neighbor : Vertex R
  adjacent : Adjacent R neighbor t
  moving : neighbor ∈ movingNeighbors geometry a
  representative : (Vcirc R a).subgroupOf (stabilizer R a)
  in_span : (representative : stabilizer R a).val ∈ Z R a ⊔ Z R neighbor
  fixed : o.dual.coordinates representative ∈
    Incidence.DualGeometry.seedLine o.naturalU.marking flag i
  nonzero : o.dual.coordinates representative ≠ 1

/-- A lift in one moving neighboring span gives both the native edge
containment and the actual commutator bound. -/
theorem bounds_of_neighbor_lift (source : LocalSource L R)
    (hb : 2 < geometry.b R) (modules : ModuleFacts source geometry)
    {a t : Vertex R} (ha : color R a = false) (hat : Adjacent R a t)
    (o : OppositeSectionAt a) (flag : SL) (hflag : BinaryWeakBN flag) (i : Bool)
    (hfixed : (U R a).subgroupOf (stabilizer R a) ⊓
      centralizer (localResidual
        (localParabolic (vertexExtension source a ha o flag hflag) i) :
          Set (stabilizer R a)) = ⊥)
    (lift : NeighborLift (geometry := geometry) a t o flag i) :
    canonicalSeed (vertexExtension source a ha o flag hflag) o.dual i ≤
      (V R t).subgroupOf (stabilizer R a) ∧
    Nat.card (⁅canonicalSeed (vertexExtension source a ha o flag hflag) o.dual i,
      (Q R a).subgroupOf (stabilizer R a)⁆ : Subgroup (stabilizer R a)) ≤ 4 := by
  let S := stabilizer R a
  let X := canonicalSeed (vertexExtension source a ha o flag hflag) o.dual i
  let d := lift.neighbor
  have hcard := (Incidence.DualGeometry.matrixGeometry_of_no_fixed o.naturalU.marking
    flag i (model_fixed_eq_bot source a ha o flag hflag i hfixed)).seed_card
  have hU : (U R a).subgroupOf S ≤ (Vcirc R a).subgroupOf S :=
    fun _ hx => commutator_mono (Z_le_VBall R a 2) le_rfl hx
  have hX : X ≤ (Z R a ⊔ Z R d).subgroupOf S := by
    dsimp only [X]
    rw [canonicalSeed_eq_of_lift (vertexExtension source a ha o flag hflag)
      (J := (Vcirc R a).subgroupOf S) (N := (U R a).subgroupOf S)
      (n := o.naturalU) o.dual i hU hcard lift.representative
      lift.fixed lift.nonzero]
    exact sup_le (fun _ hx => mem_sup_left (U_le_Z a hx)) (zpowers_le.mpr lift.in_span)
  have hspan : Z R a ⊔ Z R d ≤ V R t := by
    apply sup_le
    · apply le_iSup_of_le a
      exact le_iSup_of_le (show (cosetGraph R).dist a t ≤ 2 by
        rw [SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj R _ _).mpr hat)]
        decide) le_rfl
    · apply le_iSup_of_le d
      exact le_iSup_of_le (show (cosetGraph R).dist d t ≤ 2 by
        rw [SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj R _ _).mpr lift.adjacent)]
        decide) le_rfl
  refine ⟨hX.trans (fun _ hx => hspan hx), ?_⟩
  have hdQ : Z R d ≤ Q R a := (moving_Z_le_V lift.moving).trans
    (geometry.V_le_Q hb a ha)
  have he : ⁅Z R a ⊔ Z R d, Q R a⁆ = ⁅Z R d, Q R a⁆ := by
    rw [commutator_comm (Z R a ⊔ Z R d), commutator_comm (Z R d)]
    exact (commutator_eq_of_centralizing_sup rfl
      (commutator_eq_bot_iff_le_centralizer.mp (geometry.centralizes a ha))
      (hdQ.trans (Q R a).le_normalizer)).symm
  have hm : (⁅X, (Q R a).subgroupOf S⁆).map S.subtype ≤ ⁅Z R d, Q R a⁆ := by
    rw [map_commutator, map_subgroupOf_eq_of_le
      (show Q R a ≤ S from fun _ hx => hx.1)]
    rw [← he]
    apply commutator_mono _ le_rfl
    rintro _ ⟨x, hx, rfl⟩
    exact hX hx
  have hdlocal : ⁅Z R d, Q R a⁆ ≤ stabilizer R d :=
    (le_normalizer_iff_commutator_le_left.mp
      ((Q_le_stabilizer_of_dist_two R a d ha lift.moving.1).trans (Z_normalized R d))).trans
        (Z_le_stabilizer R d)
  let := finite_stabilizer R d
  let : Finite (⁅Z R d, Q R a⁆ : Subgroup (FreeAmalgam R)) :=
    Finite.of_injective (inclusion hdlocal) (inclusion_injective _)
  have hc := (card_le_of_le hm).trans
    (moving_commutator_card_le_four source hb modules ha lift.moving)
  rwa [card_map_of_injective S.subtype_injective] at hc

/-- Assemble the published seed after the geometric lift and residual fixed
space have been constructed. Both geometric bounds follow from the lift. -/
noncomputable def edgeSeedAt_of_neighbor_lift (source : LocalSource L R)
    (hb : 2 < geometry.b R) (modules : ModuleFacts source geometry)
    {a t : Vertex R} (ha : color R a = false) (hat : Adjacent R a t)
    (o : OppositeSectionAt a) (flag : SL) (hflag : BinaryWeakBN flag) (i : Bool)
    (hfixed : (U R a).subgroupOf (stabilizer R a) ⊓
      centralizer (localResidual
        (localParabolic (vertexExtension source a ha o flag hflag) i) :
          Set (stabilizer R a)) = ⊥)
    (lift : NeighborLift (geometry := geometry) a t o flag i) : EdgeSeedAt source a t ha := by
  obtain ⟨hle, hsmall⟩ := bounds_of_neighbor_lift source hb modules ha hat o flag hflag i hfixed lift
  exact {
    opposite := o
    flag := flag
    weakBN := hflag
    side := i
    fixed_bot := hfixed
    seed_le_edge := hle
    small_commutator := hsmall }

omit [Finite M] in
/-- The two predecessors coincide on the same tree geodesic, so the source's
step-(4) centralizer condition survives passage to TerminalSeed. -/
theorem terminal_centralizer_eq_of_choice (p : Counterexample geometry)
    (seed : TerminalSeed p) (choice : Geometry.CentralizerChoice p) :
    Q R seed.t ⊓ centralizer (radiusCommutator p.a p.a' : Set (FreeAmalgam R)) = Q R p.c := by
  obtain ⟨w, hw⟩ := (cosetGraph_connected R).exists_walk_length_eq_dist p.a p.a'
  have ht : choice.t = seed.t :=
    (choice.before.getVert (geometry := geometry) w hw).symm.trans
      (seed.before.getVert (geometry := geometry) w hw)
  simpa only [ht] using choice.centralizer_eq

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.Escape.PairingControl.TerminalPairing.EdgeGeometry
