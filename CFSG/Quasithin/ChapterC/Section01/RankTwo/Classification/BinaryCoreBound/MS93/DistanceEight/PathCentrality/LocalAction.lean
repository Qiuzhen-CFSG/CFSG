module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceEight.PathCentrality.Paths
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceEight.Elementary
public import Mathlib.Algebra.Group.Subgroup.Pointwise

/-!
# The local orbit subgroups and remaining MS93 path contracts

The local Z-span is generated by the actual stabilizer orbit. Covariance
identifies it with the source's conjugate-generated subgroup. Its normality
is relative to that stabilizer, and its containment in the actual radius-two
subgroup and neighborhood kernel is proved from distance alone. Relative
normality of the fixed subgroup D_a also identifies the joins in the output
contract with the source's literal subgroup products. When b > 4, any two
radius-two generators have distance less than b and commute; involution
generation then proves that both the radius-two group and the local span are
elementary abelian.

`LocalCommutatorControl`, `HasTurnConjugators`, and `PrescribedReplacement`
spell out the outputs still to be proved in (4.4.1), (4.4.2), and (4.4.4).
They have no constructor from the source hypotheses here. The last contract
retains both the prescribed edge-commutator conjugation and the noncontainment,
with the same conjugator. The concluding adapter constructs its actual
critical replacement; it does not prove the contract itself.

Source: Meierfrankenfeld--Stellmacher, *Pushing up weak BN-pairs of rank two*
(1993), (4.4.1)--(4.4.4), printed pp.890--894. The source D_a is `fixedCore`,
and U_t^a is the edge commutator defined here, not the natural subgroup U_a.
-/

@[expose] public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
open scoped Pointwise
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality
variable {M : Type*} [Group M] (R : Subgroup M) {geometry : Geometry R}

/-- The source U_t^a = [Z_a,T_t], with the actual neighborhood kernel. -/
noncomputable def edgeCommutator (a t : Vertex R) : Subgroup (FreeAmalgam R) :=
  ⁅Z R a, Q R t⁆

/-- The subgroup generated by Z_a conjugated by every element of G_c. -/
noncomputable def localZSpan (a c : Vertex R) : Subgroup (FreeAmalgam R) :=
  ⨆ g : stabilizer R c, Z R (Stellmacher.PushingUp.AmalgamGraph.act R g a)

theorem localZSpan_eq_conjugates (a c : Vertex R) :
    localZSpan R a c = ⨆ g : stabilizer R c,
      (Z R a).map (MulAut.conj (g : FreeAmalgam R)⁻¹).toMonoidHom := by
  simp only [localZSpan, Z_act]

theorem Z_le_localZSpan (a c : Vertex R) : Z R a ≤ localZSpan R a c := by
  have h := le_iSup (fun g : stabilizer R c =>
    Z R (Stellmacher.PushingUp.AmalgamGraph.act R g a)) 1
  simpa only [localZSpan, Subgroup.coe_one, act_one] using h

theorem localZSpan_le_V {a c : Vertex R} (hd : (cosetGraph R).dist a c ≤ 2) :
    localZSpan R a c ≤ V R c := by
  apply iSup_le
  intro g
  have hgc : Stellmacher.PushingUp.AmalgamGraph.act R g c = c := g.property
  have hd' : (cosetGraph R).dist
      (Stellmacher.PushingUp.AmalgamGraph.act R g a) c ≤ 2 := by
    have hh := dist_act R (g : FreeAmalgam R) a c
    rw [hgc] at hh
    exact hh.le.trans hd
  exact le_iSup_of_le _ (le_iSup_of_le hd' le_rfl)

theorem localZSpan_normalized (a c : Vertex R) :
    stabilizer R c ≤ normalizer (localZSpan R a c : Set (FreeAmalgam R)) := by
  rw [le_normalizer_iff]
  intro h hh x hx
  have hmap : (localZSpan R a c).map (MulAut.conj h).toMonoidHom ≤ localZSpan R a c := by
    rw [localZSpan, Subgroup.map_iSup]
    apply iSup_le
    intro g
    have heq : (Z R (Stellmacher.PushingUp.AmalgamGraph.act R g a)).map
        (MulAut.conj h).toMonoidHom =
        Z R (Stellmacher.PushingUp.AmalgamGraph.act R ((g : FreeAmalgam R) * h⁻¹) a) := by
      rw [act_mul]
      simpa only [inv_inv] using
        (Z_act R h⁻¹ (Stellmacher.PushingUp.AmalgamGraph.act R g a)).symm
    rw [heq]
    exact le_iSup (fun k : stabilizer R c =>
      Z R (Stellmacher.PushingUp.AmalgamGraph.act R k a))
        ⟨g * h⁻¹, (stabilizer R c).mul_mem g.property ((stabilizer R c).inv_mem hh)⟩
  exact hmap (mem_map_of_mem (MulAut.conj h).toMonoidHom hx)

theorem localZSpan_normal (a c : Vertex R) :
    ((localZSpan R a c).subgroupOf (stabilizer R c)).Normal :=
  normal_subgroupOf_of_le_normalizer (localZSpan_normalized R a c)

theorem localZSpan_le_Q {a c : Vertex R} (hc : color R c = false)
    (hd : (cosetGraph R).dist a c ≤ 2) (hb : 2 < geometry.b R) :
    localZSpan R a c ≤ Q R c :=
  (localZSpan_le_V R hd).trans (V_le_Q R hc hb)

/-- Radius-two generators commute when all their mutual distances are below b. -/
theorem V_abelian_of_four_lt {a : Vertex R} (ha : color R a = false)
    (hb : 4 < geometry.b R) : IsMulCommutative (V R a) := by
  apply le_centralizer_iff_isMulCommutative.mp
  apply (V_le_iff R ha _).mpr
  intro d hd hda
  apply le_centralizer_iff.mpr
  apply (V_le_iff R ha _).mpr
  intro e he hea
  have hZ : Z R e ≤ Q R d := by
    apply Z_le_Q_of_dist_lt R e (geometry.exists_critical e he)
    rw [geometry.distance_constant e he]
    change (cosetGraph R).dist e d < geometry.b R
    have htri : (cosetGraph R).dist e d ≤
        (cosetGraph R).dist e a + (cosetGraph R).dist a d :=
      (cosetGraph_connected R).dist_triangle
    rw [SimpleGraph.dist_comm (u := a) (v := d)] at htri
    omega
  exact hZ.trans (le_centralizer_iff.mp
    (commutator_eq_bot_iff_le_centralizer.mp (geometry.centralizes d hd)))

/-- For b > 4 the actual radius-two subgroup is elementary abelian. -/
theorem V_elementary_of_four_lt {a : Vertex R} (ha : color R a = false)
    (hb : 4 < geometry.b R) : IsElementaryAbelian 2 (V R a) := by
  let := V_abelian_of_four_lt R ha hb
  let : IsElementaryAbelian 2 (omega₁ (V R a) (p := 2)) :=
    IsElementaryAbelian.omega₁_of_isMulCommutative (V R a)
  have hE : IsElementaryAbelian 2 (omegaOneAmbient (V R a)) :=
    IsElementaryAbelian.map (V R a).subtype
  have hV : omegaOneAmbient (V R a) = V R a := VBall_omegaOne R a 2
  rwa [hV] at hE

/-- The local span in (4.4.1) is elementary abelian, as a subgroup of V_c. -/
theorem localZSpan_elementary {a c : Vertex R} (hc : color R c = false)
    (hd : (cosetGraph R).dist a c ≤ 2) (hb : 4 < geometry.b R) :
    IsElementaryAbelian 2 (localZSpan R a c) := by
  let := V_elementary_of_four_lt R hc hb
  exact IsElementaryAbelian.of_le (localZSpan_le_V R hd)

/-- The source D_a is normalized by its local stabilizer. -/
theorem fixedCore_normalized (a : Vertex R) :
    stabilizer R a ≤ normalizer (fixedCore R a : Set (FreeAmalgam R)) := by
  rw [le_normalizer_iff]
  intro g hg x hx
  have hfix : Stellmacher.PushingUp.AmalgamGraph.act R g a = a := hg
  have hfixInv : Stellmacher.PushingUp.AmalgamGraph.act R g⁻¹ a = a :=
    (stabilizer R a).inv_mem hg
  have hQ : (Q R a).map (MulAut.conj g).toMonoidHom = Q R a := by
    simpa only [hfixInv, inv_inv] using (Q_act R g⁻¹ a).symm
  have hL : (Ltilde R a).map (MulAut.conj g⁻¹).toMonoidHom = Ltilde R a := by
    simpa only [hfix] using (Ltilde_act R g a).symm
  constructor
  · have hh := mem_map_of_mem (MulAut.conj g).toMonoidHom hx.1
    rw [hQ] at hh
    exact hh
  · intro y hy
    have hy' : g⁻¹ * y * g ∈ Ltilde R a := by
      have hh := mem_map_of_mem (MulAut.conj g⁻¹).toMonoidHom hy
      rw [hL] at hh
      simpa only [MulAut.conj_apply, inv_inv, MulEquiv.toMonoidHom_eq_coe,
        MonoidHom.coe_coe] using hh
    have hh := congrArg (fun z => g * z * g⁻¹) (hx.2 _ hy')
    simpa [mul_assoc] using hh

/-- Normality of D_a is relative to G_a, not to the free amalgam. -/
theorem fixedCore_normal (a : Vertex R) :
    ((fixedCore R a).subgroupOf (stabilizer R a)).Normal :=
  normal_subgroupOf_of_le_normalizer (fixedCore_normalized R a)

/-- The subgroup join with D_a is the literal product inside G_a. -/
theorem join_fixedCore_eq_mul {a : Vertex R} (A : Subgroup (FreeAmalgam R))
    (hA : A ≤ stabilizer R a) :
    (↑(A ⊔ fixedCore R a) : Set (FreeAmalgam R)) =
      (A : Set (FreeAmalgam R)) * (fixedCore R a : Set (FreeAmalgam R)) :=
  coe_mul_of_left_le_normalizer_right A (fixedCore R a)
    (hA.trans (fixedCore_normalized R a))

/-- The product used in (4.4.1)(ii), with both factors in the correct local group. -/
theorem localCommutator_join_eq_mul {a c : Vertex R} (hc : color R c = false)
    (hd : (cosetGraph R).dist a c ≤ 2) (hb : 2 < geometry.b R)
    {x : FreeAmalgam R} (hx : x ∈ Q R c) :
    (↑(⁅zpowers x, localZSpan R a c⁆ ⊔ fixedCore R c) : Set (FreeAmalgam R)) =
      (↑(⁅zpowers x, localZSpan R a c⁆ : Subgroup (FreeAmalgam R)) : Set (FreeAmalgam R)) *
        (fixedCore R c : Set (FreeAmalgam R)) := by
  apply join_fixedCore_eq_mul R
  have hcomm : ⁅zpowers x, localZSpan R a c⁆ ≤ Q R c :=
    (commutator_mono (zpowers_le.mpr hx) (localZSpan_le_Q R hc hd hb)).trans
      (Subgroup.commutator_le_self _)
  exact hcomm.trans (fun _ hy => hy.1)

/-- Exact two-step local commutator output of MS93 (4.4.1).
There is no constructor here; its proof is a separate source obligation. -/
def LocalCommutatorControl : Prop :=
  ∀ a c, color R a = false → color R c = false → (cosetGraph R).dist a c = 2 →
    ¬ ⁅Z R a, Q R c⁆ ≤ fixedCore R c →
      ⁅localZSpan R a c, Q R a ⊓ Q R c⁆ ≤ fixedCore R c ∧
      ∀ x ∈ Q R c, ¬ ⁅localZSpan R a c, zpowers x⁆ ≤ fixedCore R c →
        Z R c ≤ ⁅zpowers x, localZSpan R a c⁆ ⊔ fixedCore R c

/-- The local orbit condition on a critical path asserted in (4.4.2). -/
def HasTurnConjugators {a a' : Vertex R} (p : CriticalPath R geometry a a') : Prop :=
  ∀ i : ℕ, Even i → 2 ≤ i → i + 2 ≤ p.walk.length →
    ∃ g ∈ stabilizer R (p.walk.getVert i),
      Stellmacher.PushingUp.AmalgamGraph.act R g (p.walk.getVert (i + 2)) =
        p.walk.getVert (i - 2)

/-- The prescribed conjugator and noncontainment in (4.4.4). The hypothesis
uses the normalizer inside G_a; the two conclusions use the same ambient g.
`CriticalPath.conjugateShift` constructs the resulting replacement path. -/
def PrescribedReplacement {a a' : Vertex R} (p : CriticalPath R geometry a a') : Prop :=
  ∀ t, Adjacent R a t →
    ¬ Z R a' ≤ stabilizer R a ⊓ normalizer (edgeCommutator R a t : Set (FreeAmalgam R)) →
    ∃ g ∈ stabilizer R a,
      (edgeCommutator R a (p.walk.getVert 1)).map (MulAut.conj g⁻¹).toMonoidHom =
        edgeCommutator R a t ∧
      ¬ (Z R (p.walk.getVert 2)).map (MulAut.conj g⁻¹).toMonoidHom ≤
        Q R (p.walk.getVert (p.walk.length - 2))


/-- Reversing a path preserves the local orbit condition, by using inverse conjugators. -/
theorem HasTurnConjugators.reverse {L : Subgroup M} {source : LocalSource L R}
    (common : CommonFacts R source geometry) {a a' : Vertex R}
    {p : CriticalPath R geometry a a'} (hp : HasTurnConjugators R p) :
    HasTurnConjugators R (p.reverse common) := by
  intro i hi hi₂ hiend
  change i + 2 ≤ p.walk.reverse.length at hiend
  rw [SimpleGraph.Walk.length_reverse] at hiend
  have hlenEven : Even p.walk.length := by
    rw [p.shortest, p.critical.1]
    exact geometry.even a p.start_color
  have hparity : Even (p.walk.length - i) := by
    rw [Nat.even_iff] at hi hlenEven ⊢
    omega
  obtain ⟨g, hg, hturn⟩ := hp (p.walk.length - i) hparity (by omega) (by omega)
  refine ⟨g⁻¹, ?_, ?_⟩
  · change g⁻¹ ∈ stabilizer R (p.walk.reverse.getVert i)
    rw [SimpleGraph.Walk.getVert_reverse]
    exact (stabilizer R _).inv_mem hg
  · change Stellmacher.PushingUp.AmalgamGraph.act R g⁻¹
      (p.walk.reverse.getVert (i + 2)) = p.walk.reverse.getVert (i - 2)
    rw [SimpleGraph.Walk.getVert_reverse, SimpleGraph.Walk.getVert_reverse]
    have hh := congrArg (Stellmacher.PushingUp.AmalgamGraph.act R g⁻¹) hturn
    rw [← act_mul, mul_inv_cancel, act_one] at hh
    have h₁ : p.walk.length - (i + 2) = p.walk.length - i - 2 := by omega
    have h₂ : p.walk.length - (i - 2) = p.walk.length - i + 2 := by omega
    rw [h₁, h₂]
    exact hh.symm

/-- The witness in (4.4.4) yields a genuine critical replacement, with its prescribed
edge commutator, using the same conjugating element in both clauses. -/
theorem PrescribedReplacement.exists_critical_path {a a' : Vertex R}
    {p : CriticalPath R geometry a a'} (hp : PrescribedReplacement R p)
    (hb : 2 ≤ geometry.b R) {t : Vertex R} (ht : Adjacent R a t)
    (hn : ¬ Z R a' ≤ stabilizer R a ⊓
      normalizer (edgeCommutator R a t : Set (FreeAmalgam R))) :
    ∃ g ∈ stabilizer R a,
      (edgeCommutator R a (p.walk.getVert 1)).map (MulAut.conj g⁻¹).toMonoidHom =
        edgeCommutator R a t ∧
      Nonempty (CriticalPath R geometry
        (Stellmacher.PushingUp.AmalgamGraph.act R g (p.walk.getVert 2))
        (p.walk.getVert (p.walk.length - 2))) := by
  obtain ⟨g, hg, hc, hnc⟩ := hp t ht hn
  exact ⟨g, hg, hc, ⟨p.conjugateShift hb g hg hnc⟩⟩

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality
