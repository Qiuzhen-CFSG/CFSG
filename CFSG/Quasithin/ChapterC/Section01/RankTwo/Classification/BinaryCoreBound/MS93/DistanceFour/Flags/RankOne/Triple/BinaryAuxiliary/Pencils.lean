module
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Flags.RankOne.Triple.BinaryAuxiliary.Layers
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Flags.RankOne.Triple.Preparatory.Incident.FixedSpaces.Pencil
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Flags.RankOne.Triple.Natural.GeometryBound.Symmetry.Pencils.Transport

/-!
# Three-neighbor generation and the derived auxiliary layer

The three cosets in the marked binary parabolic lift through the original
projection and cover all incident first-color layers. Distinct first cores
generate the opposite full actor. Each first layer is abelian, and the
commutator of two distinct layers is fixed by both cores. This places the
derived subgroup of Y in the actual opposite fixed subgroup Z_delta.

Source: Meierfrankenfeld--Stellmacher (1993), (4.6.8), end of printed p.907.
-/

public section
open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Flags.RankOne.BinaryAuxiliary
variable {M : Type*} [Group M] [Finite M] {L R : Subgroup M}

private theorem first_eq_of_common_representative (source : LocalSource L R)
    (geometry : Geometry R) (hlarge : 2 < geometry.b R) (i : Bool)
    (hkernel : flagKernel source i = Q R (beta R)) (g h m : M)
    (hgm : g⁻¹ * m ∈ parabolic source.projection source.flag i)
    (hhm : h⁻¹ * m ∈ parabolic source.projection source.flag i) :
    firstFlagLayer (R := R) g = firstFlagLayer (R := R) h := by
  have hg := firstFlagLayer_right_mul_of_kernel source geometry hlarge i hkernel g (g⁻¹*m) hgm
  have hh := firstFlagLayer_right_mul_of_kernel source geometry hlarge i hkernel h (h⁻¹*m) hhm
  simp only [mul_inv_cancel_left] at hg hh
  exact hg.symm.trans hh

/-- Every auxiliary span is generated by its three actual incident layers.
Their pairwise core joins are the full opposite actor, with no new marking. -/
theorem exists_three_layers (source : LocalSource L R) (geometry : Geometry R)
    (hlarge : 2 < geometry.b R) (i : Bool)
    (hkernel : flagKernel source i = Q R (beta R)) (d : M) :
    ∃ g : Fin 3 → M,
      (∀ j, flagIncident source i (g j) d) ∧
      Y source i d = ⨆ j, firstFlagLayer (R := R) (g j) ∧
      (∀ j k, j ≠ k → localFlagKernel source i (g j) ⊔
        localFlagKernel source i (g k) = localFlagActor source (!i) d) := by
  classical
  obtain ⟨a, ha, hjoin, _, hcover⟩ := Incident.FixedSpaceModel.pencil source.flag (!i)
  simp only [Bool.not_not] at hjoin hcover
  choose e he using fun j => source.projection_surjective (a j)
  have hem (j : Fin 3) : e j ∈ parabolic source.projection source.flag (!i) := by
    change source.projection (e j) ∈ modelParabolic source.flag (!i)
    rw [he]
    exact ha j
  have hc (j : Fin 3) : localFlagKernel source i (e j) =
      ((Incident.FixedSpaceModel.core source.flag i (a j)).comap source.projection).map
        (embedM R) := by
    rw [Pencils.localFlagKernel_eq_matrix_preimage, he]
    rfl
  have hj (j k : Fin 3) (hjk : j ≠ k) :
      localFlagKernel source i (e j) ⊔ localFlagKernel source i (e k) =
        flagParabolic source (!i) := by
    rw [hc, hc, ← Subgroup.map_sup,
      comap_sup_eq source.projection _ _ source.projection_surjective, hjoin j k hjk]
    rfl
  have hi (j : Fin 3) : flagIncident source i (d * e j) d := by
    refine ⟨d * e j, ?_, ?_⟩
    · simp only [inv_mul_cancel]; exact one_mem _
    · simpa only [inv_mul_cancel_left] using hem j
  refine ⟨fun j => d * e j, hi, le_antisymm ?_ ?_, ?_⟩
  · apply iSup_le
    intro b
    apply iSup_le
    rintro ⟨m, hbm, hdm⟩
    obtain ⟨j, hjm⟩ := hcover (source.projection (d⁻¹ * m)) hdm
    have hjm' : (d * e j)⁻¹ * m ∈ parabolic source.projection source.flag i := by
      change source.projection ((d * e j)⁻¹ * m) ∈ modelParabolic source.flag i
      simpa only [map_mul, map_inv, he, mul_inv_rev, mul_assoc] using hjm
    exact (first_eq_of_common_representative source geometry hlarge i hkernel b
      (d * e j) m hbm hjm').le.trans (le_iSup (fun j => firstFlagLayer (R := R) (d * e j)) j)
  · exact iSup_le fun j => first_le_Y source i _ d (hi j)
  · intro j k hjk
    change localConjugate (flagKernel source i) (d * e j) ⊔
      localConjugate (flagKernel source i) (d * e k) = _
    rw [localConjugate_mul, localConjugate_mul]
    change (localFlagKernel source i (e j)).map _ ⊔
      (localFlagKernel source i (e k)).map _ = _
    rw [← Subgroup.map_sup, hj j k hjk]
    rfl

omit [Finite M] in
private theorem first_abelian (geometry : Geometry R) (hlarge : 2 < geometry.b R) (g : M) :
    ⁅firstFlagLayer (R := R) g, firstFlagLayer (R := R) g⁆ = ⊥ := by
  change ⁅(V R (beta R)).map _, (V R (beta R)).map _⁆ = _
  rw [← map_commutator, commutator_self_eq_bot_iff.mpr
    (edgeRadius_abelian geometry hlarge (alpha R) (beta R) rfl (base_adjacent R)), Subgroup.map_bot]

omit [Finite M] in
private theorem common_fixed_le (source : LocalSource L R) (i : Bool) (g h d : M)
    (hjoin : localFlagKernel source i g ⊔ localFlagKernel source i h =
      localFlagActor source (!i) d) :
    localFlagZ source i g ⊓ localFlagZ source i h ≤ localFlagZ source (!i) d := by
  rintro x ⟨hx, hy⟩
  refine ⟨hx.1, ?_⟩
  have hc (K : Subgroup (FreeAmalgam R)) (hh : x ∈ centralizer (K : Set (FreeAmalgam R))) :
      K ≤ centralizer ({x} : Set (FreeAmalgam R)) := by
    intro a ha z hz
    obtain rfl := Set.mem_singleton_iff.mp hz
    exact (hh a ha).symm
  have hall := sup_le (hc _ hx.2) (hc _ hy.2)
  rw [hjoin] at hall
  intro y hy
  exact (hall (map_mono (flagKernel_le source (!i)) hy) x (Set.mem_singleton x)).symm

private theorem pair_commutator_le (source : LocalSource L R) (geometry : Geometry R)
    (common : CommonFacts R source geometry) (early : EarlyFacts R geometry)
    (i : Bool) (hkernel : flagKernel source i = Q R (beta R)) (g h : M) :
    ⁅firstFlagLayer (R := R) g, firstFlagLayer (R := R) h⁆ ≤
      localFlagZ source i g ⊓ localFlagZ source i h := by
  have hk (a b : M) : firstFlagLayer (R := R) a ≤ localFlagKernel source i b :=
    (firstFlagLayer_le_radius a).trans ((V_le_Q geometry common.large_distance _ rfl).trans
      (Q_alpha_le_localFlagKernel source i b))
  apply le_inf
  · exact (commutator_mono le_rfl (hk h g)).trans
      (firstFlagLayer_commutator_le_localFlagZ source geometry common early i hkernel g)
  · rw [commutator_comm]
    exact (commutator_mono le_rfl (hk g h)).trans
      (firstFlagLayer_commutator_le_localFlagZ source geometry common early i hkernel h)

private theorem commutator_iSup_le_of_pairwise {G : Type*} [Group G] {ι : Type*}
    (H : ι → Subgroup G) (A N : Subgroup G) (hHA : ∀ j, H j ≤ A)
    (hAN : A ≤ normalizer N) (hp : ∀ j k, ⁅H j, H k⁆ ≤ N) :
    ⁅⨆ j, H j, ⨆ j, H j⁆ ≤ N := by
  have hfixed (j : ι) : (⨆ k, H k) ≤ commutatorPreimage A (H j) N := by
    exact iSup_le fun k => le_commutatorPreimage (hHA k) (hp k j)
  have hfirst : (⨆ j, H j) ≤ commutatorPreimage A (⨆ k, H k) N := by
    apply iSup_le
    intro j
    apply le_commutatorPreimage (hHA j)
    rw [commutator_comm]
    exact (commutator_mono (hfixed j) le_rfl).trans (commutator_commutatorPreimage_le _ _ _ hAN)
  exact (commutator_mono hfirst le_rfl).trans (commutator_commutatorPreimage_le _ _ _ hAN)

/-- The full binary auxiliary span has derived subgroup in the source Z_delta.
The three-layer generation and both cross-commutator bounds are proved. -/
theorem Y_commutator_le_localZ (source : LocalSource L R) (geometry : Geometry R)
    (common : CommonFacts R source geometry) (early : EarlyFacts R geometry)
    (i : Bool) (hkernel : flagKernel source i = Q R (beta R)) (d : M) :
    ⁅Y source i d, Y source i d⁆ ≤ localFlagZ source (!i) d := by
  obtain ⟨g, _, hy, hj⟩ := exists_three_layers source geometry common.large_distance i hkernel d
  have hnorm : Y source i d ≤ normalizer (localFlagZ source (!i) d) := by
    have hQ : Y source i d ≤ Q R (alpha R) :=
      (Y_le_radius source i d).trans (V_le_Q geometry common.large_distance _ rfl)
    have hcentral : ⁅Y source i d, Z R (alpha R)⁆ = ⊥ := by
      rw [commutator_comm]
      exact bot_unique ((commutator_mono le_rfl hQ).trans (geometry.centralizes _ rfl).le)
    exact ((commutator_eq_bot_iff_le_centralizer.mp hcentral).trans
      (centralizer_le (show (localFlagZ source (!i) d : Set (FreeAmalgam R)) ⊆
        (Z R (alpha R) : Set (FreeAmalgam R)) from fun _ hx => hx.1))).trans
      (Subgroup.centralizer_le_normalizer _)
  rw [hy]
  apply commutator_iSup_le_of_pairwise _ (Y source i d) _
    (fun j => hy.symm ▸ le_iSup (fun j => firstFlagLayer (R := R) (g j)) j) hnorm
  intro j k
  by_cases he : j = k
  · subst k
    rw [first_abelian geometry common.large_distance]
    exact bot_le
  · exact (pair_commutator_le source geometry common early i hkernel (g j) (g k)).trans
      (common_fixed_le source i _ _ d (hj j k he))

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Flags.RankOne.BinaryAuxiliary
