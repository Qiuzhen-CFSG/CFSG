module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Quotient.LargeBranch.RankOne.Recognition.Seed.Local.Basic

/-!
# A plane from a line of displacements

If a parabolic is generated by a subgroup acting trivially and two conjugate
transvections, its commutator space is contained in the sum of the first
transvection's displacement space and one translate. The proof uses a subgroup
of elements whose displacements lie in this sum; it does not enumerate the
module or assume complete reducibility.

A nonzero binary module generated by commutators cannot have dimension one.
Consequently a line bound for the opposite core forces a plane, fills the line,
and generates the plane by its parabolic translates. The matrix and intrinsic
core hypotheses of this conditional calculation are supplied by Linear.Group.

Source: Meierfrankenfeld--Stellmacher, *Pushing up weak BN-pairs of rank two*
(1993), first paragraph following (4.6.12)(3), printed p.910.
-/

public section

open Subgroup Representation Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.LargeBranch.RankOne.Seed
variable {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]
  (ρ : Representation (ZMod 2) SL W) (P : Subgroup SL) (A : Submodule (ZMod 2) W)

private def displacementSubgroup (B : Submodule (ZMod 2) W)
    (hA : ∀ g ∈ P, ∀ v ∈ A, ρ g v ∈ A) : Subgroup SL where
  carrier := {g | g ∈ P ∧ ∀ v ∈ A, ρ g v - v ∈ B}
  one_mem' := ⟨P.one_mem, by intro v _; simp⟩
  mul_mem' := by
    rintro g h ⟨hg, hgm⟩ ⟨hh, hhm⟩
    refine ⟨P.mul_mem hg hh, ?_⟩
    intro v hv
    have hm := B.add_mem (hgm (ρ h v) (hA h hh v hv)) (hhm v hv)
    simpa only [map_mul, Module.End.mul_apply, sub_add_sub_cancel] using hm
  inv_mem' := by
    rintro g ⟨hg, hgm⟩
    refine ⟨P.inv_mem hg, ?_⟩
    intro v hv
    have hm := B.neg_mem (hgm (ρ g⁻¹ v) (hA _ (P.inv_mem hg) v hv))
    simpa only [ρ.self_inv_apply, neg_sub] using hm

private theorem moved_le_two_translates (Q K : Subgroup SL) (hQP : Q ≤ P)
    (hKP : K ≤ P) (t s : SL) (ht : t ∈ Q) (hs : s ∈ P)
    (hgen : ∀ H : Subgroup SL, K ≤ H → t ∈ H → s * t * s⁻¹ ∈ H → P ≤ H)
    (hA : ∀ g ∈ P, ∀ v ∈ A, ρ g v ∈ A)
    (hfix : A ≤ fixedSpace ρ K) :
    movedSpace ρ P A ≤ movedSpace ρ Q A ⊔ (movedSpace ρ Q A).map (ρ s) := by
  let U := movedSpace ρ Q A
  let B := U ⊔ U.map (ρ s)
  let H := displacementSubgroup ρ P A B hA
  have hK : K ≤ H := by
    intro k hk
    refine ⟨hKP hk, ?_⟩
    intro v hv
    have he := hfix hv ⟨k, hk⟩
    change ρ k v = v at he
    rw [he, sub_self]
    exact B.zero_mem
  have htH : t ∈ H := by
    refine ⟨hQP ht, ?_⟩
    intro v hv
    exact (show U ≤ B from le_sup_left) (Submodule.subset_span ⟨t, ht, v, hv, rfl⟩)
  have huH : s * t * s⁻¹ ∈ H := by
    refine ⟨P.mul_mem (P.mul_mem hs (hQP ht)) (P.inv_mem hs), ?_⟩
    intro v hv
    have hm : ρ t (ρ s⁻¹ v) - ρ s⁻¹ v ∈ U :=
      Submodule.subset_span ⟨t, ht, ρ s⁻¹ v, hA _ (P.inv_mem hs) v hv, rfl⟩
    have he : ρ s (ρ t (ρ s⁻¹ v) - ρ s⁻¹ v) = ρ (s * t * s⁻¹) v - v := by
      simp only [map_sub, ρ.self_inv_apply, map_mul, Module.End.mul_apply]
    exact (show U.map (ρ s) ≤ B from le_sup_right) (Submodule.mem_map.mpr ⟨_, hm, he⟩)
  apply Submodule.span_le.mpr
  rintro _ ⟨g, hg, v, hv, rfl⟩
  exact (hgen H hK htH huH hg).2 v hv

private theorem binary_line_fixed (hA : Module.finrank (ZMod 2) A = 1)
    (g : SL) (hg : ∀ v ∈ A, ρ g v ∈ A) (v : W) (hv : v ∈ A) : ρ g v = v := by
  by_cases hv0 : v = 0
  · simp [hv0]
  have hspan := eq_span_singleton_of_mem_of_finrank_eq_one hA hv hv0
  obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (hspan ▸ hg v hv)
  have hc0 : c ≠ 0 := by
    intro hc0
    have hz : ρ g v = 0 := by simpa [hc0] using hc.symm
    have hh := congrArg (ρ g⁻¹) hz
    exact hv0 (by simpa only [ρ.inv_self_apply, map_zero] using hh)
  have hc1 : c = 1 := (by decide : ∀ c : ZMod 2, c ≠ 0 → c = 1) c hc0
  simpa only [hc1, one_smul] using hc.symm

/-- A line bound detects a plane when two conjugate transvections generate
modulo the subgroup fixing the module. All actor hypotheses remain explicit. -/
theorem plane_of_two_transvections [Finite W] (Q K : Subgroup SL)
    (hQP : Q ≤ P) (hKP : K ≤ P) (t s : SL) (ht : t ∈ Q) (hs : s ∈ P)
    (hgen : ∀ H : Subgroup SL, K ≤ H → t ∈ H → s * t * s⁻¹ ∈ H → P ≤ H)
    (T : Submodule (ZMod 2) W)
    (hA : ∀ g ∈ P, ∀ v ∈ A, ρ g v ∈ A)
    (hfix : A ≤ fixedSpace ρ K) (hA0 : A ≠ ⊥)
    (hmoved : movedSpace ρ P A = A) (hT : Module.finrank (ZMod 2) T = 1)
    (hbound : movedSpace ρ Q A ≤ T) :
    Module.finrank (ZMod 2) A = 2 ∧ movedSpace ρ Q A = T ∧ orbitSpace ρ P T = A := by
  let U := movedSpace ρ Q A
  have hspan : A ≤ U ⊔ U.map (ρ s) := by
    rw [← hmoved]
    exact moved_le_two_translates ρ P A Q K hQP hKP t s ht hs hgen hA hfix
  have hU0 : U ≠ ⊥ := by
    intro hz
    rw [hz, Submodule.map_bot, sup_bot_eq] at hspan
    exact hA0 (le_bot_iff.mp hspan)
  have hUT : U = T := by
    have hdim : Module.finrank (ZMod 2) U ≤ Module.finrank (ZMod 2) T :=
      Submodule.finrank_mono hbound
    have hn : Module.finrank (ZMod 2) U ≠ 0 := by
      exact fun h => hU0 (Submodule.finrank_eq_zero.mp h)
    apply Submodule.eq_of_le_of_finrank_eq hbound
    change Module.finrank (ZMod 2) U = _
    rw [hT] at *
    omega
  have hUA : U ≤ A := by
    apply Submodule.span_le.mpr
    rintro _ ⟨g, hg, v, hv, rfl⟩
    exact A.sub_mem (hA g (hQP hg) v hv) hv
  have hTA : T ≤ A := hUT ▸ hUA
  have hdim : Module.finrank (ZMod 2) A ≤ 2 := by
    have hm := Submodule.finrank_map_le (ρ s) U
    have hsum := Submodule.finrank_add_le_finrank_add_finrank U (U.map (ρ s))
    have ha := Submodule.finrank_mono hspan
    rw [hUT] at hm hsum ha
    rw [hT] at hm hsum
    omega
  have hdim0 : Module.finrank (ZMod 2) A ≠ 0 := by
    exact fun h => hA0 (Submodule.finrank_eq_zero.mp h)
  have hdim1 : Module.finrank (ZMod 2) A ≠ 1 := by
    intro hd
    apply hA0
    rw [← hmoved]
    apply le_bot_iff.mp
    apply Submodule.span_le.mpr
    rintro _ ⟨g, hg, v, hv, rfl⟩
    rw [binary_line_fixed ρ A hd g (hA g hg) v hv, sub_self]
    exact Submodule.zero_mem _
  refine ⟨by omega, hUT, le_antisymm ?_ ?_⟩
  · apply Submodule.span_le.mpr
    rintro _ ⟨g, hg, v, hv, rfl⟩
    exact hA g hg v (hTA hv)
  · apply hspan.trans
    apply sup_le
    · intro v hv
      apply Submodule.subset_span
      exact ⟨1, P.one_mem, v, hUT ▸ hv, by simp⟩
    · rintro _ ⟨v, hv, rfl⟩
      exact Submodule.subset_span ⟨s, hs, v, hUT ▸ hv, rfl⟩

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.LargeBranch.RankOne.Seed
