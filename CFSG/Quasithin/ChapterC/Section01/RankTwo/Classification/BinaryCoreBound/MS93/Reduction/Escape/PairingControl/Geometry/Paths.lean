module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.Escape.PairingControl.Geometry.Source

/-!
# Distance estimates for the geometric escape argument

Only the M-vertex generators are needed for V at an M-vertex. At an
H-vertex its V is generated by the Z-layers of its immediate M-neighbors.
Critical minimality therefore controls the full groups, including both colors
in the definition of V. Subwalks of one shortest walk give exact distances
between specified predecessors; no new critical path is silently identified.

Source: MS93 (1993), the geometry used in (4.3.2), pp.884--886.
-/

public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.Escape.PairingControl.Geometry
variable {M : Type*} [Group M] {R : Subgroup M} {geometry : MS93.Geometry R}

theorem adjacent_Z_le {a t : Vertex R} (ha : color R a = false)
    (hat : Adjacent R a t) : Z R t ≤ Z R a := by
  have ht : color R t ≠ false := fun ht => adjacent_color_ne R hat (ha.trans ht.symm)
  rw [Z, if_neg ht, Z, if_pos ha]
  exact le_iSup_of_le t (le_iSup_of_le hat le_rfl)

/-- Eliminate the redundant odd-color generators in the radius-two definition. -/
theorem V_le_of_m_ball {a : Vertex R} (ha : color R a = false)
    (K : Subgroup (FreeAmalgam R))
    (hK : ∀ d, color R d = false → (cosetGraph R).dist d a ≤ 2 → Z R d ≤ K) :
    V R a ≤ K := by
  apply iSup_le
  intro d
  apply iSup_le
  intro hd
  by_cases hc : color R d = false
  · exact hK d hc hd
  · obtain ⟨w, hw⟩ := (cosetGraph_connected R).exists_walk_length_eq_dist d a
    have hn : ¬ Even ((cosetGraph R).dist d a) := by
      rw [← hw, walk_even_iff_color_eq, ha]
      exact hc
    rw [Nat.even_iff] at hn
    have hd' : (cosetGraph R).dist d a = 1 := by omega
    have hadj : Adjacent R a d := adjacent_symm R
      ((cosetGraph_adj R _ _).mp (SimpleGraph.dist_eq_one_iff_adj.mp hd'))
    exact (adjacent_Z_le ha hadj).trans (hK a ha (by simp))

/-- At a holomorph vertex, the radius-two definition reduces to its neighbors. -/
theorem V_le_of_h_neighbors {a t : Vertex R} (ha : color R a = false)
    (hat : Adjacent R a t) (K : Subgroup (FreeAmalgam R))
    (hK : ∀ d, Adjacent R d t → Z R d ≤ K) : V R t ≤ K := by
  have ht : color R t = true := by
    have hn := adjacent_color_ne R hat
    cases h : color R t <;> simp_all
  apply iSup_le
  intro d
  apply iSup_le
  intro hd
  obtain ⟨w, hw⟩ := (cosetGraph_connected R).exists_walk_length_eq_dist d t
  have hlen : w.length ≤ 2 := hw.trans_le hd
  cases w with
  | nil => exact (adjacent_Z_le ha hat).trans (hK a hat)
  | @cons d e t hde w =>
    cases w with
    | nil => exact hK d ((cosetGraph_adj R _ _).mp hde)
    | @cons e f t hef w =>
      have hzero : w.length = 0 := by simp only [SimpleGraph.Walk.length_cons] at hlen; omega
      have hft := w.eq_of_length_eq_zero hzero
      subst f
      have het : Adjacent R e t := (cosetGraph_adj R _ _).mp hef
      have he : color R e = false := by
        have hn := adjacent_color_ne R het
        cases h : color R e <;> simp_all
      exact (adjacent_Z_le he (adjacent_symm R ((cosetGraph_adj R _ _).mp hde))).trans
        (hK e het)

theorem Vcirc_le_V (a : Vertex R) : Vcirc R a ≤ V R a :=
  le_normalizer_iff_commutator_le_left.mp
    ((Ltilde_le_stabilizer a).trans (V_normalized a))

theorem V_le_Q_of_distance {a d : Vertex R} (ha : color R a = false)
    (h : (cosetGraph R).dist a d + 2 < geometry.b R) : V R a ≤ Q R d := by
  apply V_le_of_m_ball ha
  intro e he hea
  apply Z_le_Q_of_dist_lt R e (geometry.exists_critical e he)
  rw [geometry.distance_constant e he]
  change (cosetGraph R).dist e d < geometry.b R
  have htri := (cosetGraph_connected R).dist_triangle (u := e) (v := a) (w := d)
  omega

theorem V_le_stabilizer_of_distance {a d : Vertex R} (ha : color R a = false)
    (h : (cosetGraph R).dist a d + 2 ≤ geometry.b R) : V R a ≤ stabilizer R d := by
  apply V_le_of_m_ball ha
  intro e he hea
  apply geometry.Z_le_stabilizer_of_dist_le_b e he d
  have htri := (cosetGraph_connected R).dist_triangle (u := e) (v := a) (w := d)
  omega

theorem V_centralizes_V_of_distance {a d : Vertex R}
    (ha : color R a = false) (hd : color R d = false)
    (h : (cosetGraph R).dist a d + 4 < geometry.b R) :
    V R a ≤ centralizer (V R d : Set (FreeAmalgam R)) := by
  apply le_centralizer_iff.mpr
  apply V_le_of_m_ball hd
  intro e he hed
  apply le_centralizer_iff.mpr
  have hae : (cosetGraph R).dist a e + 2 < geometry.b R := by
    have htri := (cosetGraph_connected R).dist_triangle (u := a) (v := d) (w := e)
    rw [SimpleGraph.dist_comm (u := d) (v := e)] at htri
    omega
  exact (V_le_Q_of_distance ha hae).trans (le_centralizer_iff.mp
    (commutator_eq_bot_iff_le_centralizer.mp (geometry.centralizes e he)))

include geometry in
/-- Distances between two predecessors are computed on the same geodesic. -/
theorem before_distance {a a' c d : Vertex R} {m n : ℕ}
    (hc : Before a a' c m) (hd : Before a a' d n) (hn : n ≤ m) :
    (cosetGraph R).dist c d = m - n := by
  obtain ⟨w, hw⟩ := (cosetGraph_connected R).exists_walk_length_eq_dist a a'
  have hm : m ≤ w.length := by have := hc.2; omega
  have hsub := SimpleGraph.length_eq_dist_of_subwalk hw
    (((w.drop (w.length - m)).isSubwalk_take (m - n)).trans
      (w.isSubwalk_drop (w.length - m)))
  have hsum : w.length - m + (m - n) = w.length - n := by omega
  have hdrop : w.length - (w.length - m) = m := by omega
  simp only [SimpleGraph.Walk.take_length, SimpleGraph.Walk.drop_length,
    hdrop, inf_eq_left.mpr (Nat.sub_le m n), SimpleGraph.Walk.drop_getVert, hsum,
    hc.getVert (geometry := geometry) w hw, hd.getVert (geometry := geometry) w hw] at hsub
  exact hsub.symm

theorem before_reverse {a a' c : Vertex R} {n : ℕ} (h : Before a a' c n) :
    Before a' a c ((cosetGraph R).dist a a' - n) := by
  constructor
  · rw [SimpleGraph.dist_comm]
    have := h.2
    omega
  · rw [SimpleGraph.dist_comm (u := a') (v := c), h.1,
      SimpleGraph.dist_comm (u := a') (v := a)]
    have := h.2
    omega

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.Escape.PairingControl.Geometry
