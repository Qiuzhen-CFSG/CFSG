module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.SectionThree.NaturalStructure.ModuleAlternatives.Reconstruction.Linear
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.SectionThree.NaturalStructure.ModuleAlternatives.BadEstimates.Basic
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.SectionThree.NaturalStructure.ModuleAlternatives.FixedGeneration.Defs

/-!
# The actual edge fixed spaces generating Z

An adjacent omega-center, restricted to X, is exactly the fixed space of
its actual marked edge image. Positive critical distance places the whole
omega-center in X. Thus Z is their join. Genuine edge offenders show each
image is nontrivial, and the local kernels make it a two-group. The inherited
faithful action on Z is checked independently of any module decomposition.
Source: Meierfrankenfeld–Stellmacher (1993), (2.1)–(2.2), (3.2), pp.855–857,863.
-/

@[expose] public section
open Subgroup Stellmacher.PushingUp.AmalgamGraph
open Representation Representation.BinaryOffender
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.ModuleAlternatives.Reconstruction
variable {M : Type*} [Group M] [Finite M] {L R : Subgroup M}
local instance : IsElementaryAbelian 2 (X R (alpha R)) := X_elementary R (alpha R)

/-- An adjacent omega-center is exactly the fixed subgroup of its marked edge image. -/
theorem edge_fixed (source : LocalSource L R) (t : Vertex R) (hat : Adjacent R (alpha R) t) :
    space (edgeOmega R t) = fixedSpace (Offenders.linearize (xAction source))
      (edgeActor source t) := by
  have ht : color R t = true := by
    cases hc : color R t
    · have hn := adjacent_color_ne R hat
      simp only [show color R (alpha R) = false from rfl, hc] at hn
      exact (hn rfl).elim
    · rfl
  ext v
  constructor
  · intro hv a
    obtain ⟨g, hg, he⟩ := a.property
    obtain ⟨m, rfl⟩ := (baseEquiv (R := R)).surjective g
    have hm : embedM R m ∈ Q R t := hg
    have ha : a.val = source.projection m := by
      simpa only [baseProjection_baseEquiv] using he.symm
    change Additive.ofMul (xAction source a.val v.toMul) = v
    apply congrArg Additive.ofMul
    apply Subtype.ext
    rw [ha, xAction, layerAction_apply]
    have hc := (mem_omegaCenter_iff.mp hv).2.2 (embedM R m) hm
    change embedM R m * (v.toMul : FreeAmalgam R) =
      (v.toMul : FreeAmalgam R) * embedM R m at hc
    exact mul_inv_eq_iff_eq_mul.mpr hc
  · intro hv
    apply mem_omegaCenter_iff.mpr
    refine ⟨Q_le_adjacent_h R ht hat (omegaCenter_le _ v.toMul.property),
      (mem_omegaCenter_iff.mp v.toMul.property).2.1, ?_⟩
    intro g hg
    have hgS : g ∈ stabilizer R (alpha R) := hg.2 _ (adjacent_symm R hat)
    obtain ⟨m, hm⟩ := (baseEquiv (R := R)).surjective ⟨g, hgS⟩
    have hm' : embedM R m = g := congrArg Subtype.val hm
    have ha : source.projection m ∈ edgeActor source t :=
      ⟨baseEquiv m, by change embedM R m ∈ Q R t; rwa [hm'],
        baseProjection_baseEquiv source m⟩
    have he := congrArg (fun w : Additive (X R (alpha R)) => (w.toMul : FreeAmalgam R))
      (hv ⟨source.projection m, ha⟩)
    change (xAction source (source.projection m) v.toMul : FreeAmalgam R) = _ at he
    rw [xAction, layerAction_apply, hm'] at he
    exact mul_inv_eq_iff_eq_mul.mp he

theorem edgeActor_two (source : LocalSource L R) (t : Vertex R) :
    IsPGroup 2 (edgeActor source t) :=
  ((kernel_isPGroup source t).comap_subtype).map (baseProjection source)

theorem edgeActor_ne_bot (source : LocalSource L R) (geometry : Geometry R)
    (hb : 0 < geometry.b R) (t : Vertex R) (hat : Adjacent R (alpha R) t) :
    edgeActor source t ≠ ⊥ := by
  obtain ⟨A, hA, hOff⟩ := edgeActor_has_offender source geometry hb t hat
  intro hz
  exact hOff.1.1 (le_bot_iff.mp (hz ▸ hA))

/-- Z is generated by the full fixed spaces of the actual nontrivial edge two-groups. -/
theorem space_Z (source : LocalSource L R) (geometry : Geometry R)
    (hb : 0 < geometry.b R) :
    space (Z R (alpha R)) = ⨆ t : {t : Vertex R // Adjacent R (alpha R) t},
      fixedSpace (Offenders.linearize (xAction source)) (edgeActor source t.val) := by
  let W := ⨆ t : {t : Vertex R // Adjacent R (alpha R) t},
      space (edgeOmega R t.val)
  have hle (t) (hat : Adjacent R (alpha R) t) : edgeOmega R t ≤ Z R (alpha R) :=
    le_iSup_of_le t (le_iSup_of_le hat le_rfl)
  have hz : space (Z R (alpha R)) = W := by
    apply le_antisymm
    · have hZ : Z R (alpha R) ≤ ambient W := by
        apply iSup_le
        intro t
        apply iSup_le
        intro hat
        have hs : edgeOmega R t ≤ X R (alpha R) :=
          (hle t hat).trans (geometry.omega_bound (alpha R) rfl hb)
        intro x hx
        refine ⟨⟨x, hs hx⟩, ?_, rfl⟩
        exact le_iSup (fun t : {t // Adjacent R (alpha R) t} =>
          space (edgeOmega R t.val)) ⟨t, hat⟩ hx
      intro v hv
      obtain ⟨w, hw, he⟩ := hZ hv
      have hh : w = v.toMul := Subtype.ext he
      subst w
      exact hw
    · apply iSup_le
      intro t v hv
      exact hle t.val t.property hv
  rw [hz]
  apply iSup_congr
  intro t
  exact edge_fixed source t.val t.property

noncomputable def zRepresentation (source : LocalSource L R) :
    Subrepresentation (Offenders.linearize (xAction source)) :=
  subrepresentation source (Z R (alpha R)) (Z_normalized R (alpha R))

/-- Faithfulness is checked on the source Z itself, before any decomposition. -/
theorem zRepresentation_injective (source : LocalSource L R) (geometry : Geometry R)
    (hb : 0 < geometry.b R) : Function.Injective (zRepresentation source).toRepresentation := by
  let := Q_normal R (alpha R)
  have hinj : Function.Injective (zAction source) :=
    (source.Z_quotientConjugation_injective geometry (alpha R) rfl).comp
      (quotientMarking source).symm.injective
  intro g h he
  apply hinj
  apply MulEquiv.ext
  intro v
  have hvX := geometry.omega_bound (alpha R) rfl hb v.property
  let w : (zRepresentation source).toSubmodule :=
    ⟨Additive.ofMul ⟨v.val, hvX⟩, v.property⟩
  have hval := congrArg (fun e => ((e w).val.toMul : FreeAmalgam R))
    (show (zRepresentation source).toRepresentation g =
      (zRepresentation source).toRepresentation h from he)
  apply Subtype.ext
  obtain ⟨m, rfl⟩ := source.projection_surjective g
  obtain ⟨n, rfl⟩ := source.projection_surjective h
  change (xAction source (source.projection m) ⟨v.val, hvX⟩ : FreeAmalgam R) =
    (xAction source (source.projection n) ⟨v.val, hvX⟩ : FreeAmalgam R) at hval
  simpa only [zAction, xAction, layerAction_apply] using hval

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.ModuleAlternatives.Reconstruction



namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.ModuleAlternatives.Reconstruction
variable {M : Type*} [Group M] [Finite M] {L R : Subgroup M}
local instance : IsElementaryAbelian 2 (X R (alpha R)) := X_elementary R (alpha R)

/-- Every premise of the fixed-generation input comes from the actual adjacent edges. -/
theorem zRepresentation_twoFixedGenerated (source : LocalSource L R) (geometry : Geometry R)
    (hb : 0 < geometry.b R) :
    FixedGeneration.TwoFixedGenerated (Offenders.linearize (xAction source))
      (zRepresentation source) := by
  let f := fun t : {t : Vertex R // Adjacent R (alpha R) t} => edgeActor source t.val
  refine ⟨Set.range f, ?_, ?_⟩
  · rintro A ⟨t, rfl⟩
    exact ⟨edgeActor_two source t.val, edgeActor_ne_bot source geometry hb t.val t.property⟩
  · change space (Z R (alpha R)) = _
    rw [space_Z source geometry hb]
    simp only [iSup_range, f]

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.ModuleAlternatives.Reconstruction
