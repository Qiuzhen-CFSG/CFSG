module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.SectionThree.NaturalStructure.ModuleAlternatives.FixedGeneration.Defs
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.SectionThree.NaturalStructure.ModuleAlternatives.FixedGeneration.Involutions
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.SectionThree.NaturalStructure.ModuleAlternatives.CentralAttachments
public import Theory.Representation.PSL3Two.IrreducibleCatalogue.OrbitQuotient
public import Theory.Representation.PSL3Two.IrreducibleCatalogue.Irreducibility

/-!
# Fixed-space generation of the binary central sum

Let D be the literal commutator subrepresentation of a faithful binary
SL₃(2) FF-module V, and C its full fixed space. A faithful invariant W
generated by full fixed spaces of nontrivial two-subgroups is exactly C + D.

Involution detection puts each generating fixed space in C + D. One such
space contains C and a nonzero fixed vector in each natural copy of D;
natural irreducibility then generates every copy. For the nonsplit lower
attachment, the image of W ∩ D in the natural quotient is nonzero by
faithfulness. Irreducibility makes that image surjective, and the exact
central kernel is already in W. The four central-attachment alternatives
therefore give the result, retaining both nonsplit four-dimensional cases.

This is the abstract fixed-generation step used to reconstruct source Z
in Meierfrankenfeld–Stellmacher (1993), (3.2), printed p.863, using (1.4),
(1.5), (1.8) and the section 2 definition of Z. The source application and
subgroup transports belong to `Reconstruction`.
-/

@[expose] public section
open Representation Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.ModuleAlternatives.FixedGeneration
open AbelianCore.QuotientRecognition CentralAttachments
variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
  {ρ : Representation (ZMod 2) SL V}

private theorem natural_submodule_eq_top
    (P : Submodule (ZMod 2) (Fin 3 → ZMod 2))
    (hP : ∀ g v, v ∈ P → specialLinearNatural 3 g v ∈ P)
    (hne : P ≠ ⊥) : P = ⊤ := by
  let U : Subrepresentation (specialLinearNatural (k := ZMod 2) 3) := ⟨P, hP⟩
  let : IsIrreducible (specialLinearNatural (k := ZMod 2) 3) :=
    BinaryLinearThree.IrreducibleCatalogue.natural_irreducible
  rcases eq_bot_or_eq_top U with hb | ht
  · exact False.elim (hne (congrArg Subrepresentation.toSubmodule hb))
  · exact congrArg Subrepresentation.toSubmodule ht

private theorem symm_single_equivariant {m : ℕ} (e : Copies ρ m)
    (g : SL) (i : Fin m) (v : Fin 3 → ZMod 2) :
    ρ g (e.equiv.symm (Pi.single i v)) =
      e.equiv.symm (Pi.single i (specialLinearNatural 3 (e.marking g) v)) := by
  apply e.equiv.injective
  ext j : 1
  rw [e.equivariant, e.equiv.apply_symm_apply, e.equiv.apply_symm_apply]
  by_cases h : j = i
  · subst j
    simp
  · simp [Pi.single_eq_of_ne h]

/-- A full two-group fixed space generates every natural copy separately. -/
private theorem moving_le_of_copies {m : ℕ} (e : Copies (moving ρ).toRepresentation m)
    (W : Subrepresentation ρ) (A : Subgroup SL) (hA : IsPGroup 2 A)
    (hfixed : fixedSpace ρ A ≤ W.toSubmodule) :
    (moving ρ).toSubmodule ≤ W.toSubmodule := by
  classical
  let f (i : Fin m) : (Fin 3 → ZMod 2) →ₗ[ZMod 2] V :=
    (moving ρ).toSubmodule.subtype.comp
      (e.equiv.symm.toLinearMap.comp (LinearMap.single (ZMod 2) (fun _ : Fin m => Fin 3 → ZMod 2) i))
  have hf (g : SL) (i : Fin m) (v : Fin 3 → ZMod 2) :
      ρ g (f i v) = f i (specialLinearNatural 3 (e.marking g) v) :=
    congrArg Subtype.val (symm_single_equivariant e g i v)
  have hsingle (i : Fin m) (v : Fin 3 → ZMod 2) : f i v ∈ W.toSubmodule := by
    let P := W.toSubmodule.comap (f i)
    have hstable : ∀ g v, v ∈ P → specialLinearNatural 3 g v ∈ P := by
      intro g v hv
      change f i (specialLinearNatural 3 g v) ∈ W.toSubmodule
      rw [← e.marking.apply_symm_apply g, ← hf]
      exact W.apply_mem_toSubmodule _ hv
    obtain ⟨u, hune, hu⟩ := BinaryLinearThree.IrreducibleCatalogue.binary_pGroup_fixed_vector
      ((specialLinearNatural (k := ZMod 2) 3).comp (e.marking.toMonoidHom.comp A.subtype)) hA
    have huP : u ∈ P := by
      apply hfixed
      intro a
      change ρ a.val (f i u) = f i u
      rw [hf]
      exact congrArg (f i) (hu a)
    have hP : P = ⊤ := natural_submodule_eq_top P hstable (by
      intro hb
      rw [hb] at huP
      exact hune huP)
    exact (show v ∈ P from hP ▸ Submodule.mem_top)
  intro v hv
  let d : (moving ρ).toSubmodule := ⟨v, hv⟩
  have he : v = ∑ i : Fin m, f i (e.equiv d i) := by
    change (d : V) = ∑ i : Fin m, (e.equiv.symm (Pi.single i (e.equiv d i)) : V)
    have hh := congrArg (fun x => (e.equiv.symm x : V))
      (Finset.univ_sum_single (e.equiv d))
    simpa only [map_sum, e.equiv.symm_apply_apply, Submodule.coe_sum] using hh.symm
  rw [he]
  exact W.toSubmodule.sum_mem fun i _ => hsingle i _

/-- Faithfulness forbids an invariant subspace consisting only of fixed vectors. -/
private theorem faithful_not_le_fixed (W : Subrepresentation ρ)
    (hW : Function.Injective W.toRepresentation) :
    ¬ W.toSubmodule ≤ fixedSpace ρ ⊤ := by
  intro hc
  let : IsSimpleGroup SL := Atlas.Comparisons.Exceptional.sl3Two_simple
  obtain ⟨g, hg⟩ := exists_ne (1 : SL)
  apply hg
  apply hW
  apply LinearMap.ext
  intro v
  apply Subtype.ext
  change ρ g (v : V) = ρ 1 (v : V)
  have hh := hc v.property ⟨g, Subgroup.mem_top g⟩
  change ρ g (v : V) = (v : V) at hh
  simpa only [map_one, Module.End.one_apply] using hh

/-- A faithful invariant subspace containing C and lying in C+D surjects
onto the single natural quotient of D, including a nonsplit central kernel. -/
private theorem moving_le_of_quotient (q : ModuleQuotient (moving ρ).toRepresentation 1)
    (W : Subrepresentation ρ) (hW : Function.Injective W.toRepresentation)
    (hC : fixedSpace ρ ⊤ ≤ W.toSubmodule) (hWC : W.toSubmodule ≤ centralSum ρ) :
    (moving ρ).toSubmodule ≤ W.toSubmodule := by
  let D := (moving ρ).toSubmodule
  let f : D →ₗ[ZMod 2] (Fin 3 → ZMod 2) :=
    (LinearMap.proj (0 : Fin 1)).comp q.projection
  let U := W.toSubmodule.comap D.subtype
  let P := U.map f
  have hf (g : SL) (v : D) :
      f ((moving ρ).toRepresentation g v) = specialLinearNatural 3 (q.marking g) (f v) :=
    q.equivariant g v 0
  have hker (v : D) (hv : f v = 0) : (v : V) ∈ fixedSpace ρ ⊤ := by
    have hz : q.projection v = 0 := by
      funext i
      have hi : i = 0 := Subsingleton.elim _ _
      subst i
      exact hv
    have hm : v ∈ fixedSpace (moving ρ).toRepresentation ⊤ := q.kernel ▸ hz
    exact fun g => congrArg Subtype.val (hm g)
  have hPstable : ∀ g v, v ∈ P → specialLinearNatural 3 g v ∈ P := by
    intro g v hv
    obtain ⟨d, hd, rfl⟩ := hv
    refine ⟨(moving ρ).toRepresentation (q.marking.symm g) d,
      W.apply_mem_toSubmodule _ hd, ?_⟩
    rw [hf, q.marking.apply_symm_apply]
  have hPne : P ≠ ⊥ := by
    intro hb
    apply faithful_not_le_fixed W hW
    intro w hw
    obtain ⟨c, hc, d, hd, hcd⟩ := Submodule.mem_sup.mp (hWC hw)
    have hdW : d ∈ W.toSubmodule := by
      have hh := W.toSubmodule.sub_mem hw (hC hc)
      rw [← hcd, add_sub_cancel_left] at hh
      exact hh
    have hdP : f ⟨d, hd⟩ ∈ P := ⟨⟨d, hd⟩, hdW, rfl⟩
    have hz : f ⟨d, hd⟩ = 0 := by
      rw [hb] at hdP
      exact hdP
    rw [← hcd]
    exact (fixedSpace ρ ⊤).add_mem hc (hker ⟨d, hd⟩ hz)
  have hPtop := natural_submodule_eq_top P hPstable hPne
  intro d hd
  have hmem : f ⟨d, hd⟩ ∈ P := hPtop ▸ Submodule.mem_top
  obtain ⟨u, hu, he⟩ := hmem
  have hdiff : (⟨d, hd⟩ : D) - u ∈ fixedSpace (moving ρ).toRepresentation ⊤ := by
    rw [← q.kernel]
    change q.projection ((⟨d, hd⟩ : D) - u) = 0
    funext i
    have hi : i = 0 := Subsingleton.elim _ _
    subst i
    change f ((⟨d, hd⟩ : D) - u) = 0
    rw [map_sub, he, sub_self]
  have hc : d - (u : V) ∈ fixedSpace ρ ⊤ := fun g => congrArg Subtype.val (hdiff g)
  have hh := W.toSubmodule.add_mem (hC hc) hu
  simpa only [Submodule.subtype_apply, sub_add_cancel] using hh

private theorem fixed_generator (W : Subrepresentation ρ)
    (hW : Function.Injective W.toRepresentation) (hgen : TwoFixedGenerated ρ W) :
    ∃ A : Subgroup SL, IsPGroup 2 A ∧ A ≠ ⊥ ∧ fixedSpace ρ A ≤ W.toSubmodule := by
  obtain ⟨S, hS, he⟩ := hgen
  have hnon : S.Nonempty := by
    by_contra hn
    have hb : W.toSubmodule = ⊥ := by simpa [Set.not_nonempty_iff_eq_empty.mp hn] using he
    exact faithful_not_le_fixed W hW (hb ▸ bot_le)
  obtain ⟨A, hA⟩ := hnon
  refine ⟨A, (hS A hA).1, (hS A hA).2, ?_⟩
  rw [he]
  exact le_iSup_of_le A (le_iSup_of_le hA le_rfl)

/-- Full fixed-space generation places W inside the central sum. -/
private theorem le_centralSum [FiniteDimensional (ZMod 2) V]
    (hρ : Function.Injective ρ) (hFF : IsFFModule ρ)
    (W : Subrepresentation ρ) (hgen : TwoFixedGenerated ρ W) :
    W.toSubmodule ≤ centralSum ρ := by
  obtain ⟨m, _, ⟨q⟩⟩ := moving_quotient ρ hρ hFF
  obtain ⟨S, hS, he⟩ := hgen
  rw [he]
  exact iSup₂_le fun A hA => two_fixed_le_centralSum q A (hS A hA).1 (hS A hA).2

/-- A faithful invariant subspace generated by full fixed spaces of nontrivial
two-subgroups is exactly C_V(SL₃(2)) + [V,SL₃(2)]. Both nonsplit natural
extensions and the doubled natural case are included. -/
theorem eq_centralSum [FiniteDimensional (ZMod 2) V]
    (ρ : Representation (ZMod 2) SL V)
    (hρ : Function.Injective ρ) (hFF : IsFFModule ρ)
    (W : Subrepresentation ρ) (hW : Function.Injective W.toRepresentation)
    (hgen : TwoFixedGenerated ρ W) : W.toSubmodule = centralSum ρ := by
  obtain ⟨A, hA, _, hfixed⟩ := fixed_generator W hW hgen
  have hC : fixedSpace ρ ⊤ ≤ W.toSubmodule :=
    (fixedSpace_antitone ρ (show A ≤ ⊤ from le_top)).trans hfixed
  have hWC := le_centralSum hρ hFF W hgen
  apply le_antisymm hWC
  apply sup_le hC
  rcases classification ρ hρ hFF with
    ⟨⟨e⟩, _⟩ | ⟨⟨e⟩, _⟩ | ⟨⟨q⟩, _, _⟩ | ⟨⟨e⟩, _, _⟩
  · exact moving_le_of_copies e W A hA hfixed
  · exact moving_le_of_copies e W A hA hfixed
  · exact moving_le_of_quotient q W hW hC hWC
  · exact moving_le_of_copies e W A hA hfixed

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.ModuleAlternatives.FixedGeneration
