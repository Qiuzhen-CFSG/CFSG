module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Quotient.LargeBranch.RankOne.Recognition.Seed
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Quotient.LargeBranch.RankOne.Recognition.Sections
public import Theory.Representation.BinaryOffender.CentralSectionAction
public import Theory.Representation.BinaryOffender.MovedSpaceTransport
public import Theory.GroupTheory.PResidual.SubnormalCoreAction

/-!
# The canonical moved seed under second-star containment

The second starred layer is invariant under its full parabolic. Its ordered
residual is a normal two-perfect subgroup, so commutator idempotence in the
finite group M makes the residual-moved subspace generated by the full actor.
The literal LayerModule maps transport this calculation to V_alpha/Z_alpha;
no finiteness assertion about the free amalgam is needed.

For nonvanishing, the first residual fixes the edge-star image. That image
is nonzero, and its second-core-fixed part is nonzero by two-group orbit
counting. If the second residual fixed the whole second starred layer, both
residuals would fix this part. They generate the actual component, contradicting
the starred intersection identity (4.6.10). The edge-star nontriviality argument
also occurs in SmallBranch.Purity.ParabolicGeometry.Star; we use only its
radius and starred-layer argument, independently of that branch's core/U route.

The exported theorem constructs all fields of Seed.Input for the literal
moved space, under precisely the contrary containment used by the escape
assembly. It supplies the moved-seed premise of
Escape.second_star_escape_of_moved_seed_and_radius_bound.

Source: Meierfrankenfeld--Stellmacher, Pushing up weak BN-pairs of rank two
(1993), the opening of (4.6.12)(4), printed p.911, with the notation on p.905
and the seed hypotheses of (4.6.12)(3), printed pp.910--911.
-/

public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
open Representation Representation.BinaryOffender
open scoped commutatorElement
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.LargeBranch.RankOne.Escape
variable {M : Type*} [Group M] [Finite M] {L R : Subgroup M}
  {source : LocalSource L R} {geometry : Geometry R}

private theorem moved_eq {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]
    (ρ : Representation (ZMod 2) SL W) (H : Subgroup SL) (A : Submodule (ZMod 2) W) :
    Seed.movedSpace ρ H A = subspaceCommutator ρ A H := by
  simp only [Seed.movedSpace, subspaceCommutator, eq_comm]

private theorem residual_eq (f : Seed.Frame source) (i : Bool) :
    f.residual i = (pResidual 2 (f.parabolic i)).map (f.parabolic i).subtype := by
  exact rankOne_parabolic_eq source.projection source.projection_surjective
    (by rw [source.projection_kernel]; exact pCore_isPGroup) _ _

private theorem residual_le (f : Seed.Frame source) (i : Bool) :
    f.residual i ≤ f.parabolic i := by
  rw [residual_eq]
  exact map_subtype_le _

private theorem residual_normalized (f : Seed.Frame source) (i : Bool) :
    f.parabolic i ≤ normalizer (f.residual i) := by
  rw [residual_eq]
  exact (f.parabolic i).le_normalizer.trans
    (normalizer_le_normalizer_characteristic_image _ _)

omit [Finite M] in
private theorem radius_normalized (m : M) :
    embedM R m ∈ normalizer (V R (alpha R)) := by
  apply DistanceEight.V_normalized R (alpha R)
  rw [alpha, stabilizer_m_base]
  exact ⟨m, rfl⟩

omit [Finite M] in
private theorem second_core_one (f : Seed.Frame source) : Seed.secondCore f 1 = f.core true := by
  have he : (MulAut.conj (1 : M)).toMonoidHom = MonoidHom.id M := by ext m; simp
  simp only [Seed.secondCore, he, map_id]

omit [Finite M] in
private theorem first_transport (d : LayerModule source (V R (alpha R)))
    (m n : M) {v : d.Space} (hv : v ∈ Seed.firstTildeStar (geometry := geometry) d n) :
    d.representation (source.projection m) v ∈ Seed.firstTildeStar (geometry := geometry) d (m * n) := by
  obtain ⟨t, ht, rfl⟩ := (d.mem_subspace_iff _ v).mp hv
  let y : V R (alpha R) := ⟨embedM R m * t * (embedM R m)⁻¹,
    (mem_normalizer_iff.mp (radius_normalized (R := R) m) t).mp t.property⟩
  apply (d.mem_subspace_iff _ _).mpr
  refine ⟨y, ?_, d.action m t y rfl⟩
  rw [Seed.firstStar_mul]
  exact mem_map_of_mem _ ht

omit [Finite M] in
private theorem second_invariant (d : LayerModule source (V R (alpha R))) (f : Seed.Frame source) :
    (f.parabolic true).map source.projection ≤
      subspaceStabilizer d.representation (Seed.secondTildeStar (geometry := geometry) d f 1) := by
  have hn : (f.parabolic true).map source.projection ≤
      normalizer ((f.core true).map source.projection) :=
    (map_mono (f.core_normalized true)).trans (le_normalizer_map _)
  apply le_subspaceStabilizer
  rintro _ ⟨m, hm, rfl⟩
  change Seed.secondTildeStar (geometry := geometry) d f 1 ≤
    (Seed.secondTildeStar (geometry := geometry) d f 1).comap (d.representation (source.projection m))
  apply iSup_le
  intro p v hv
  apply (le_iSup (fun p : f.parabolic true =>
    Seed.firstTildeStar (geometry := geometry) d (1 * p) ⊓
      fixedSpace d.representation ((Seed.secondCore f 1).map source.projection))
    (⟨m, hm⟩ * p))
  simp only [one_mul, Subgroup.coe_mul, Submodule.mem_inf, second_core_one] at hv ⊢
  constructor
  · exact first_transport (geometry := geometry) d m (p : M) hv.1
  · exact (fixedSpace_stable_of_normalizes d.representation hn
      (mem_map_of_mem _ hm) v).2 hv.2

private theorem moved_invariant (d : LayerModule source (V R (alpha R))) (f : Seed.Frame source) :
    (f.parabolic true).map source.projection ≤ subspaceStabilizer d.representation
      (Seed.movedSpace d.representation ((f.residual true).map source.projection)
        (Seed.secondTildeStar (geometry := geometry) d f 1)) := by
  rw [moved_eq]
  exact subspaceCommutator_invariant_normalizer d.representation (second_invariant d f)
    ((map_mono (residual_normalized f true)).trans (le_normalizer_map _))

private theorem moved_le (d : LayerModule source (V R (alpha R))) (f : Seed.Frame source) :
    Seed.movedSpace d.representation ((f.residual true).map source.projection)
      (Seed.secondTildeStar (geometry := geometry) d f 1) ≤
        Seed.secondTildeStar (geometry := geometry) d f 1 := by
  rw [moved_eq]
  exact subspaceCommutator_le_of_invariant d.representation
    ((map_mono (residual_le f true)).trans (second_invariant d f))

private theorem ambient_idempotence (common : CommonFacts R source geometry)
    (d : LayerModule source (V R (alpha R))) (f : Seed.Frame source)
    (A : Submodule (ZMod 2) d.Space)
    (hA : (f.parabolic true).map source.projection ≤ subspaceStabilizer d.representation A) :
    ⁅⁅d.preimage A, (f.residual true).map (embedM R)⁆, (f.residual true).map (embedM R)⁆ =
      ⁅d.preimage A, (f.residual true).map (embedM R)⁆ := by
  let T := (d.preimage A).comap (embedM R)
  have ht : T.map (embedM R) = d.preimage A := by
    rw [map_comap_eq]
    apply inf_eq_right.mpr
    exact (d.preimage_le A).trans (by
      have h := geometry.V_local (alpha R) rfl common.large_distance
      rwa [alpha, stabilizer_m_base] at h)
  have htwo : IsPGroup 2 T :=
    ((Q_isPGroup R source.two_group source.core_le (alpha R) rfl).to_le
      ((d.preimage_le A).trans (Flags.V_le_Q geometry common.large_distance _ rfl))).comap_of_injective
        (embedM R) (embedM_injective R)
  have hn : (f.parabolic true).map (embedM R) ≤ normalizer (d.preimage A) := by
    apply d.preimage_normalized
    · rintro _ ⟨m, _, rfl⟩; exact radius_normalized m
    · intro m hm v hv; exact (hA (mem_map_of_mem _ hm) v).2 hv
  have hnT : f.residual true ≤ normalizer T := by
    intro m hm
    apply le_normalizer_comap (embedM R)
    exact hn (mem_map_of_mem _ (residual_le f true hm))
  have hperfect : IsPPerfect 2 (f.residual true) := by
    rw [residual_eq]
    exact isPPerfect_embedded_pResidual 2 _
  have he := congrArg (map (embedM R))
    (commutator_isPPerfect_idempotent (f.residual true) T hperfect htwo hnT)
  simpa only [map_commutator, ht] using he

private theorem moved_full (common : CommonFacts R source geometry)
    (d : LayerModule source (V R (alpha R))) (f : Seed.Frame source) :
    let X := Seed.movedSpace d.representation ((f.residual true).map source.projection)
      (Seed.secondTildeStar (geometry := geometry) d f 1)
    Seed.movedSpace d.representation ((f.actor true).map source.projection) X = X := by
  dsimp only
  let A := Seed.secondTildeStar (geometry := geometry) d f 1
  let X := Seed.movedSpace d.representation ((f.residual true).map source.projection) A
  let H := (f.residual true).map (embedM R)
  have hnorm : H ≤ normalizer (V R (alpha R)) := by
    rintro _ ⟨m, _, rfl⟩; exact radius_normalized m
  have he : d.subspace ⁅d.preimage A, H⁆ = X := d.subspace_commutator_preimage A _ hnorm
  have hC : ⁅d.preimage A, H⁆ ≤ V R (alpha R) :=
    (commutator_mono (d.preimage_le A) le_rfl).trans
      (le_normalizer_iff_commutator_le_left.mp hnorm)
  have hCX : ⁅d.preimage A, H⁆ ≤ d.preimage X :=
    (d.subspace_le_iff_le_preimage _ hC X).mp he.le
  apply le_antisymm
  · rw [f.actor_eq, moved_eq]
    exact subspaceCommutator_le_of_invariant d.representation (moved_invariant d f)
  · change X ≤ _
    rw [← he, ← d.subspace_commutator_preimage X (f.actor true) (by
      rintro _ ⟨m, _, rfl⟩; exact radius_normalized m)]
    apply d.subspace_mono
    rw [← ambient_idempotence common d f A (second_invariant d f)]
    apply commutator_mono hCX
    rw [f.actor_eq]
    exact map_mono (residual_le f true)

omit [Finite M] in
private theorem second_core_le_first (f : Seed.Frame source) : f.core true ≤ f.parabolic false := by
  have hk : IsPGroup 2 source.projection.ker := by
    rw [source.projection_kernel]; exact pCore_isPGroup
  let B := liftedBorelSylow source.projection source.projection_surjective hk f.flag
  have hB (i : Bool) : (B : Subgroup M) ≤ f.parabolic i := by
    rw [coe_liftedBorelSylow]
    exact comap_mono (modelParabolic_borel_le _ _)
  have h := pCoreIn_le_sylow (f.parabolic true) (B.subtype (hB true))
  rw [Sylow.coe_subtype, map_subgroupOf_eq_of_le (hB true)] at h
  exact h.trans (hB false)

private theorem edgeStar_not_le_Z (common : CommonFacts R source geometry)
    (radius : RadiusFacts R geometry) :
    ¬ edgeStar R geometry (alpha R) (beta R) ≤ Z R (alpha R) := by
  intro he
  have hs : VStar R geometry (alpha R) (beta R) ≤ Z R (alpha R) :=
    iSup_conjugates_le_of_le_normalizer _ _ _ he (Z_normalized R (alpha R))
  have hV := geometry.V_local (alpha R) rfl common.large_distance
  have hb : V R (alpha R) = B R (alpha R) (geometry.Z_normal (alpha R)) := by
    rw [Flags.radius_eq_B_sup_star geometry radius.toEarlyFacts common.large_distance
      (alpha R) (beta R) rfl (base_adjacent R)]
    exact sup_eq_left.mpr (hs.trans (Flags.Z_le_B geometry (alpha R) hV))
  have hc : V R (alpha R) ≤ centralizer (V R (alpha R) : Set (FreeAmalgam R)) := by
    conv_lhs => rw [hb, radius.B_eq_center (alpha R) rfl]
    rintro x ⟨z, hz, rfl⟩ y hy
    exact congrArg Subtype.val ((mem_center_iff.mp hz) ⟨y, hy⟩)
  apply radius.derived_noncentral (alpha R) rfl
  rw [commutator_eq_bot_iff_le_centralizer.mpr hc]
  exact bot_le

omit [Finite M] in
private theorem firstStar_one : Seed.firstStar geometry (1 : M) =
    edgeStar R geometry (alpha R) (beta R) := by
  have he : (MulAut.conj (embedM R (1 : M))).toMonoidHom = MonoidHom.id (FreeAmalgam R) := by
    apply MonoidHom.ext
    intro x
    simp
  simp only [Seed.firstStar, he, map_id]

private theorem first_fixed (common : CommonFacts R source geometry)
    (radius : RadiusFacts R geometry) (hb : geometry.b R = 4)
    (s : CriticalSegment geometry) (d : LayerModule source (V R (alpha R)))
    (f : Seed.Frame source) (hf : Seed.Compatible f s) :
    Seed.firstTildeStar (geometry := geometry) d 1 ≤
      fixedSpace d.representation ((f.residual false).map source.projection) := by
  obtain ⟨k⟩ := Sections.exists_frame common radius hb
  have hedge : edgeStar R geometry (alpha R) (beta R) ≤ V R (beta R) := by
    rw [Flags.RankOne.V_eq_neighborSpan (alpha R) (beta R) rfl (base_adjacent R)]
    apply iSup_le
    intro t
    apply iSup_le
    intro ht
    exact le_iSup_of_le t (le_iSup_of_le ht.2 le_rfl)
  have hc := (commutator_mono hedge le_rfl).trans
    (Flags.RankOne.flag_commutator_le_Z_of_Bzero source geometry common.large_distance
      radius.toEarlyFacts k.orientation k.edge_kernel k.triple (Sections.Bzero_eq_B common radius))
  rw [← f.first_residual_eq_flag s hf k.orientation k.edge_kernel, commutator_comm] at hc
  intro v hv g
  obtain ⟨t, ht, rfl⟩ := (d.mem_subspace_iff _ v).mp hv
  rw [firstStar_one] at ht
  obtain ⟨m, hm, he⟩ := g.property
  change d.representation (g : SL) (d.projection t).toAdd = (d.projection t).toAdd
  rw [← he]
  exact (d.fixed_iff_commutator_mem m (radius_normalized m) t).mpr
    (hc (commutator_mem_commutator (mem_map_of_mem _ hm) ht))

private theorem star_inf_component_fixed (common : CommonFacts R source geometry)
    (radius : RadiusFacts R geometry) (d : LayerModule source (V R (alpha R))) :
    d.subspace (VStar R geometry (alpha R) (beta R)) ⊓
      fixedSpace d.representation (L.map source.projection) = ⊥ := by
  apply le_bot_iff.mp
  intro v hv
  obtain ⟨t, ht, he⟩ := (d.mem_subspace_iff _ v).mp hv.1
  have htB : (t : FreeAmalgam R) ∈ B R (alpha R) (geometry.Z_normal _) := by
    apply (mem_B_iff R (alpha R) (geometry.Z_normal _)
      (geometry.V_local (alpha R) rfl common.large_distance) t).mpr
    refine ⟨t.property, ?_⟩
    intro l hl
    rw [Ltilde_alpha, source.residual] at hl
    obtain ⟨m, hm, rfl⟩ := hl
    apply (d.fixed_iff_commutator_mem m (radius_normalized m) t).mp
    rw [he]
    exact hv.2 ⟨source.projection m, mem_map_of_mem _ hm⟩
  have htZ := (radius.star_intersection (alpha R) (beta R) rfl (base_adjacent R)).le ⟨ht, htB⟩
  have hzero : d.projection t = 1 := by
    change t ∈ d.projection.ker
    rw [d.kernel]
    exact htZ
  change v = 0
  rw [← he, hzero]
  rfl

private theorem fixed_part_nonzero {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]
    [Finite W] (ρ : Representation (ZMod 2) SL W) (H : Subgroup SL)
    (hH : IsPGroup 2 H) (A : Submodule (ZMod 2) W)
    (hA : H ≤ subspaceStabilizer ρ A) (hne : A ≠ ⊥) :
    A ⊓ fixedSpace ρ H ≠ ⊥ := by
  let : Nontrivial A := Submodule.nontrivial_iff_ne_bot.mpr hne
  let : MulAction H A :=
    { smul := fun h v => ⟨ρ h v, (hA h.property v).2 v.property⟩
      one_smul := fun v => Subtype.ext (by
        change ρ (1 : SL) (v : W) = v
        simp)
      mul_smul := fun a b v => Subtype.ext (by
        change ρ ((a : SL) * (b : SL)) (v : W) = ρ (a : SL) (ρ (b : SL) (v : W))
        simp only [map_mul, Module.End.mul_apply]) }
  have hcard : 2 ∣ Nat.card A := by
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2), Nat.card_zmod]
    exact dvd_pow_self 2 (Module.finrank_pos (R := ZMod 2) (M := A)).ne'
  obtain ⟨v, hv, hn⟩ := hH.exists_fixed_point_of_prime_dvd_card_of_fixed_point (α := A) hcard
    (show (0 : A) ∈ MulAction.fixedPoints H A by
      intro h; apply Subtype.ext; exact map_zero _)
  intro hz
  have hm : (v : W) ∈ A ⊓ fixedSpace ρ H := by
    refine ⟨v.property, ?_⟩
    intro h
    exact congrArg Subtype.val (hv h)
  rw [hz] at hm
  exact hn (Subtype.ext (show (v : W) = 0 from hm).symm)

private theorem moved_nonzero (common : CommonFacts R source geometry)
    (radius : RadiusFacts R geometry) (hb : geometry.b R = 4)
    (s : CriticalSegment geometry) (d : LayerModule source (V R (alpha R)))
    (f : Seed.Frame source) (hf : Seed.Compatible f s) :
    Seed.movedSpace d.representation ((f.residual true).map source.projection)
      (Seed.secondTildeStar (geometry := geometry) d f 1) ≠ ⊥ := by
  let E := Seed.firstTildeStar (geometry := geometry) d 1
  let F := E ⊓ fixedSpace d.representation ((f.core true).map source.projection)
  have hE : E ≠ ⊥ := by
    change d.subspace (Seed.firstStar geometry 1) ≠ ⊥
    rw [firstStar_one]
    exact fun he => edgeStar_not_le_Z common radius
      ((d.subspace_eq_bot_iff _ (by
        have h := Seed.firstStar_le_star (geometry := geometry) (1 : M)
        rw [firstStar_one] at h
        exact h.trans (Flags.star_le_radius geometry _ _))).mp he)
  have hEinv : (f.core true).map source.projection ≤ subspaceStabilizer d.representation E := by
    apply le_subspaceStabilizer
    rintro _ ⟨m, hm, rfl⟩ v hv
    have hn := hf.first_star_normalized (mem_map_of_mem _ (second_core_le_first f hm))
    change d.representation (source.projection m) v ∈ d.subspace (Seed.firstStar geometry 1)
    change v ∈ d.subspace (Seed.firstStar geometry 1) at hv
    rw [firstStar_one] at hv ⊢
    exact d.subspace_invariant_of_mem _ m (radius_normalized m) hn v hv
  have hF : F ≠ ⊥ := fixed_part_nonzero d.representation _
    ((pCore_isPGroup (p := 2) (G := f.parabolic true)).map (f.parabolic true).subtype |>.map source.projection)
    E hEinv hE
  have hFA : F ≤ Seed.secondTildeStar (geometry := geometry) d f 1 := by
    have h := le_iSup (fun p : f.parabolic true =>
      Seed.firstTildeStar (geometry := geometry) d (1 * p) ⊓
        fixedSpace d.representation ((Seed.secondCore f 1).map source.projection)) 1
    simpa only [F, E, Seed.secondTildeStar, Subgroup.coe_one, mul_one, second_core_one] using h
  intro hz
  have hfix2 := (subspaceCommutator_eq_bot_iff d.representation _ _).mp ((moved_eq _ _ _).symm.trans hz)
  have hfix1 := first_fixed common radius hb s d f hf
  have hLF : L.map source.projection ≤ subspaceKernel d.representation F ⊤ := by
    have he := congrArg (map source.projection) f.residual_sup
    rw [Subgroup.map_sup] at he
    rw [← he]
    apply sup_le
    · intro g hg
      exact ⟨mem_top _, fun v hv => hfix1 hv.1 ⟨g, hg⟩⟩
    · intro g hg
      exact ⟨mem_top _, fun v hv => hfix2 (hFA hv) ⟨g, hg⟩⟩
  apply hF
  apply le_bot_iff.mp
  rw [← star_inf_component_fixed common radius d]
  refine le_inf (inf_le_left.trans (Seed.firstTildeStar_le_star d 1)) ?_
  intro v hv g
  exact (hLF g.property).2 v hv

/-- The canonical moved seed at the opening of MS93 (4.6.12)(4), under
contrary containment of the second starred preimage. The moved space uses
the ordered residual, while the seed is generated by its full actor. -/
theorem exists_moved_seed_of_containment
    (common : CommonFacts R source geometry) (radius : RadiusFacts R geometry)
    (hb : geometry.b R = 4) (s : CriticalSegment geometry)
    (_hs : ¬ s.SmallIntersection) (_hbc : Adjacent R (beta R) s.middle)
    (d : LayerModule source (V R (alpha R))) (f : Seed.Frame source)
    (hf : Seed.Compatible f s)
    (hcontained : d.preimage (Seed.secondTildeStar (geometry := geometry) d f 1) ≤ Q R s.middle) :
    ∃ x : Seed.Input (geometry := geometry) d f s.middle,
      x.space = Seed.movedSpace d.representation ((f.residual true).map source.projection)
        (Seed.secondTildeStar (geometry := geometry) d f 1) := by
  refine ⟨{
    space := Seed.movedSpace d.representation ((f.residual true).map source.projection)
      (Seed.secondTildeStar (geometry := geometry) d f 1)
    le_star := moved_le d f
    normalized := ?_
    nonzero := moved_nonzero common radius hb s d f hf
    moved := moved_full common d f
    preimage_le := ?_ }, rfl⟩
  · intro m hm v hv
    exact (moved_invariant d f (mem_map_of_mem _ hm) v).2 hv
  · intro t ht
    obtain ⟨htV, htA⟩ := (d.mem_preimage_iff _ t).mp ht
    apply hcontained
    exact (d.mem_preimage_iff _ t).mpr ⟨htV, moved_le d f htA⟩

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.LargeBranch.RankOne.Escape
