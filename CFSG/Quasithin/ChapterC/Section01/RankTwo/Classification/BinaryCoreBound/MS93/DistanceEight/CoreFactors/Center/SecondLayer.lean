module
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceEight.CoreFactors.Higher.OrbitGeometry.Source
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceEight.CoreFactors.Higher.Quotients.PairMovement
public import Theory.ThreeSubgroups

/-!
# The second-layer part of the reverse core-center argument

The actual second hat is generated by the two selected abelian orbit
factors. Their marked dual quotients are irreducible, so a larger mutual
centralizer would make the second hat abelian. The original critical
window (0,8) excludes that possibility, identifying its center with the
first hat. Full movement places the second hat in core joined with Z;
therefore the core center centralizes it and meets it only inside Z.

Residual idempotence also identifies the moving-radius/core commutator
with the original H, and the completed (4.5.5) bounds the Q-displacement
of the core center by Z. These are statements on the actual original
subgroups. Containment of the whole core center in the second layer and
the final equality with U joined with H remain separate obligations.

Source: Meierfrankenfeld--Stellmacher (1993), (4.5), (4.5.4)(ii)--(iii)
and (4.5.5), printed pp.895,898--900.
-/

public section
open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.CoreFactors.Center
open NormalizerTransfer PathCentrality Higher
open scoped Pointwise
variable {M : Type*} [Group M] [Finite M] {L R : Subgroup M}
  {geometry : Geometry R} {source : LocalSource L R}

private theorem moving_idempotent (common : CommonFacts R source geometry)
    (earlier : Earlier R geometry) :
    ⁅Vcirc R (alpha R),Ltilde R (alpha R)⁆ = Vcirc R (alpha R) := by
  let P := stabilizer R (alpha R)
  let H₀ := (V R (alpha R)).subgroupOf P
  let := finite_stabilizer R (alpha R)
  let : H₀.Normal := normal_subgroupOf_of_le_normalizer (DistanceEight.V_normalized R (alpha R))
  let := V_elementary_of_four_lt R (a := alpha R) rfl (by rw [earlier.distance]; decide)
  let : IsElementaryAbelian 2 H₀ := IsElementaryAbelian.subgroupOf
    (geometry.V_local (alpha R) rfl common.large_distance)
  have h := commutator_isPPerfect_idempotent (pResidual 2 P) H₀
    (isPPerfect_pResidual 2) (IsElementaryAbelian.isPGroup 2 H₀) le_normalizer_of_normal
  have hm := congrArg (fun K : Subgroup P => K.map P.subtype) h
  have hH : H₀.map P.subtype = V R (alpha R) :=
    map_subgroupOf_eq_of_le (geometry.V_local (alpha R) rfl common.large_distance)
  rw [map_commutator,map_commutator,hH] at hm
  exact hm

/-- The original moving radius subgroup has the same commutator with the core as with Q. -/
theorem moving_core_commutator (common : CommonFacts R source geometry)
    (earlier : Earlier R geometry) :
    ⁅Vcirc R (alpha R),core R (alpha R)⁆ = H R (alpha R) := by
  let D := ⁅Vcirc R (alpha R),core R (alpha R)⁆
  have hnorm : stabilizer R (alpha R) ≤ normalizer D := by
    intro g hg
    rw [mem_normalizer_iff_map_conj_eq]
    change D.map (MulAut.conj g).toMonoidHom = D
    dsimp only [D]
    rw [map_commutator, MulEquiv.toMonoidHom_eq_coe, mem_normalizer_iff_map_conj_eq.mp (Vcirc_normalized (alpha R) hg),
      mem_normalizer_iff_map_conj_eq.mp (DistanceTwo.core_normalized (alpha R) hg)]
  have hcentral : ⁅H R (alpha R),Ltilde R (alpha R)⁆ = ⊥ :=
    commutator_eq_bot_iff_le_centralizer.mpr
      ((earlier.factor_inclusions common).1.trans inf_le_right)
  apply le_antisymm (commutator_mono le_rfl (DistanceTwo.core_le_Q _))
  change ⁅Vcirc R (alpha R),Q R (alpha R)⁆ ≤ D
  rw [← moving_idempotent common earlier]
  apply commutator_commutator_le_of_rotate_of_le_normalizer
    ((Vcirc_le_V R _).trans ((geometry.V_local _ rfl common.large_distance).trans hnorm))
    ((Ltilde_le_stabilizer _).trans hnorm)
    ((show Q R (alpha R) ≤ stabilizer R (alpha R) from fun _ hx => hx.1).trans hnorm)
  · rw [commutator_comm (Ltilde R (alpha R)), commutator_comm _ (Vcirc R (alpha R))]
    exact le_rfl
  · rw [commutator_comm (Q R (alpha R))]
    exact hcentral.le.trans bot_le

/-- The critical window (0,8) witnesses noncommutation inside the actual second hat. -/
theorem second_nonabelian (common : CommonFacts R source geometry)
    (earlier : Earlier R geometry) (p : Early.SourcePath R (alpha R)) :
    ⁅hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8),
      hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8)⁆ ≠ ⊥ := by
  let h := Early.Orbit.Source.HatIdentity.SmallSeed.identitiesOnPath common earlier p
  obtain ⟨g,hg,ht⟩ := p.turns 4 (by decide) (by decide) (by decide)
  have hg' : g ∈ stabilizer R (alpha R) := by simpa only [p.center_eq] using hg
  have ht' : act R g (p.walk.getVert 6) = p.walk.getVert 2 := ht
  have hback : hatV R (p.walk.getVert 2) (p.walk.getVert 4) ≤
      hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8) := by
    have hm := le_iSup (fun k : stabilizer R (alpha R) =>
      rightConjugate (hatV R (p.walk.getVert 6) (p.walk.getVert 8)) k) ⟨g,hg'⟩
    have he : rightConjugate (hatV R (p.walk.getVert 6) (p.walk.getVert 8)) g =
        hatV R (p.walk.getVert 2) (p.walk.getVert 4) := by
      rw [h.forward 6 (by decide) (by decide) (by decide)]
      change (Vcirc R (p.walk.getVert 6) ⊔ Z R (p.walk.getVert 6)).map
        (MulAut.conj g⁻¹).toMonoidHom = _
      rw [Subgroup.map_sup, ← Vcirc_act, ← Z_act, ht',
        h.forward 2 (by decide) (by decide) (by decide)]
    exact he ▸ hm
  have hzero : Z R (p.walk.getVert 0) ≤
      hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8) := by
    apply (Z_le_localZSpan R (p.walk.getVert 0) (p.walk.getVert 2)).trans
    change hatV R (p.walk.getVert 2) (p.walk.getVert 0) ≤ _
    rw [Early.Orbit.Source.backward_hatV_eq_forward p (i := 2)
      (by decide) (by decide) (by decide)]
    exact hback
  have height : Z R (p.walk.getVert 8) ≤
      hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8) := by
    intro x hx
    apply le_iSup (fun k : stabilizer R (alpha R) =>
      rightConjugate (hatV R (p.walk.getVert 6) (p.walk.getVert 8)) k) 1
    exact ⟨x,Z_le_localZSpan R _ _ hx,by simp⟩
  let v := Early.PathExtension.sourceWindow earlier.distance p 0 (by decide) (by decide)
  intro hz
  exact common.critical_noncommutation _ v.start_color _ v.critical
    (le_bot_iff.mp ((commutator_mono hzero height).trans hz.le))


/-- The marked second quotient has full movement, so the second hat lies in core joined with Z. -/
theorem second_le_core_sup_Z (common : CommonFacts R source geometry)
    (earlier : Earlier R geometry) (p : Early.SourcePath R (alpha R)) :
    hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8) ≤
      core R (alpha R) ⊔ Z R (alpha R) := by
  let A := hatV R (alpha R) (p.walk.getVert 6)
  let B := hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8)
  let D := core R (alpha R) ⊔ A
  let P := stabilizer R (alpha R)
  let q := Early.Orbit.SourceApplications.higherPath geometry p
  have hB : B ≤ Q R (alpha R) :=
    (hatW_le_radius R q.two_step_distances.1.le q.two_step_distances.2.1.le).trans
      (Escape.Propagation.RadiusFour.VBall_le_Q (alpha R) rfl 4
        (by rw [earlier.distance]; decide))
  have hND : P ≤ normalizer D :=
    (le_inf (DistanceTwo.core_normalized (alpha R)) (hatV_normalized R _ _)).trans
      (normalizer_inf_normalizer_le_normalizer_sup _ _)
  have hZA : Z R (alpha R) ≤ A :=
    Early.Z_le_hatV rfl (by simpa only [p.center_eq] using
      (p.distance (geometry := geometry) (i := 4) (j := 6) (by decide) (by decide)))
  have hBC : ⁅B,P⁆ ≤ D := by
    let C := commutatorPreimage P B D
    have hL : Ltilde R (alpha R) ≤ C := by
      apply le_commutatorPreimage (Ltilde_le_stabilizer _)
      rw [commutator_comm]
      exact (commutator_mono hB le_rfl).trans le_sup_left
    have hQ : Q R (alpha R) ≤ C := by
      apply le_commutatorPreimage (show Q R (alpha R) ≤ P from fun _ hx => hx.1)
      rw [commutator_comm]
      exact (Early.Orbit.Source.Complete.sourceOrbitFacts common earlier p).hatW_commutator.trans
        (hZA.trans le_sup_right)
    have hPC : P ≤ C := by
      change stabilizer R (alpha R) ≤ C
      rw [← source.local_generation (alpha R) rfl]
      exact sup_le hL hQ
    rw [commutator_comm]
    exact (commutator_mono hPC le_rfl).trans (commutator_commutatorPreimage_le P B D hND)
  obtain ⟨s⟩ := Quotients.SecondLayer.OrbitSource.marked_pair common earlier p
  have hBD : B ≤ D := s.le_of_commutator_le le_sup_right (by
    simpa only [B,P,alpha,stabilizer_m_base] using hBC)
  apply hBD.trans
  apply sup_le le_sup_left
  dsimp only [A]
  rw [(Early.Orbit.Source.Complete.sourceOrbitFacts common earlier p).hatV_eq]
  exact sup_le ((Vcirc_le_core (R := R) rfl common.large_distance).trans le_sup_left) le_sup_right

/-- The actual core center centralizes the whole second hat layer. -/
theorem core_center_centralizes_second (common : CommonFacts R source geometry)
    (earlier : Earlier R geometry) (p : Early.SourcePath R (alpha R)) :
    (center (core R (alpha R))).map (core R (alpha R)).subtype ≤
      centralizer (hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8) :
        Set (FreeAmalgam R)) := by
  apply le_centralizer_iff.mpr
  apply (second_le_core_sup_Z common earlier p).trans
  apply sup_le
  · intro x hx z hz
    obtain ⟨z,hz,rfl⟩ := hz
    exact congrArg Subtype.val ((mem_center_iff.mp hz) ⟨x,hx⟩) |>.symm
  · exact (Quotients.FirstDirect.Z_centralizes_core common earlier).trans
      (centralizer_le (map_subtype_le _))

/-- Every displacement of the core center by Q lies in the original Z-layer. -/
theorem core_center_Q_commutator_le_Z (common : CommonFacts R source geometry)
    (earlier : Earlier R geometry) (p : Early.SourcePath R (alpha R)) :
    ⁅(center (core R (alpha R))).map (core R (alpha R)).subtype,Q R (alpha R)⁆ ≤
      Z R (alpha R) := by
  let D := (center (core R (alpha R))).map (core R (alpha R)).subtype
  have hDnorm : stabilizer R (alpha R) ≤ normalizer D :=
    (DistanceTwo.core_normalized (alpha R)).trans
      (normalizer_le_normalizer_characteristic_image _ (center (core R (alpha R))))
  have hcommD : ⁅D,Q R (alpha R)⁆ ≤ D :=
    le_normalizer_iff_commutator_le_left.mp
      ((show Q R (alpha R) ≤ stabilizer R (alpha R) from fun _ hx => hx.1).trans hDnorm)
  have hDC : D ≤ centralizer (core R (alpha R) : Set (FreeAmalgam R)) := by
    rintro x ⟨x,hx,rfl⟩ y hy
    exact congrArg Subtype.val ((mem_center_iff.mp hx) ⟨y,hy⟩)
  rw [← Quotients.FirstDirect.first_hat_inf_core_centralizer common earlier p]
  exact le_inf
    ((commutator_mono ((map_subtype_le _).trans
      (Early.Orbit.Source.Complete.core_le_third_hat common earlier p)) le_rfl).trans
      (Higher.OrbitGeometry.Source.Q_commutator_le common earlier p))
    (hcommD.trans hDC)


omit [Finite M] in
private theorem factor_centralizer {common : CommonFacts R source geometry}
    {A B N : Subgroup (FreeAmalgam R)} (s : MarkedDualSection source common A N)
    (hnB : Mbar R ≤ normalizer B) (hNB : N ≤ centralizer (B : Set (FreeAmalgam R)))
    (hne : ⁅A,B⁆ ≠ ⊥) : A ⊓ centralizer (B : Set (FreeAmalgam R)) = N := by
  apply le_antisymm ?_ (le_inf s.lower_le hNB)
  by_contra hn
  have hnorm : Mbar R ≤ normalizer (A ⊓ centralizer (B : Set (FreeAmalgam R))) :=
    (le_inf s.normalized (hnB.trans (normalizer_le_normalizer_centralizer B))).trans
      inf_normalizer_le_normalizer_inf
  have he := s.sup_eq_of_not_le inf_le_left hnorm hn
  apply hne
  apply commutator_eq_bot_iff_le_centralizer.mpr
  rw [← he]
  exact sup_le inf_le_right hNB

omit [Finite M] in
private theorem center_of_abelian_marked_factors {common : CommonFacts R source geometry}
    {A B N T : Subgroup (FreeAmalgam R)} (s : MarkedDualSection source common A N)
    (t : MarkedDualSection source common B N)
    (hgen : A ⊔ B = T) (hAA : ⁅A,A⁆ = ⊥) (hBB : ⁅B,B⁆ = ⊥)
    (hne : ⁅T,T⁆ ≠ ⊥) : T ⊓ centralizer (T : Set (FreeAmalgam R)) = N := by
  have hA := commutator_eq_bot_iff_le_centralizer.mp hAA
  have hB := commutator_eq_bot_iff_le_centralizer.mp hBB
  have hAB : ⁅A,B⁆ ≠ ⊥ := by
    intro hz
    have hh := commutator_eq_bot_iff_le_centralizer.mp hz
    apply hne
    apply commutator_eq_bot_iff_le_centralizer.mpr
    rw [← hgen]
    apply sup_le
    · exact le_centralizer_iff.mpr (sup_le hA (le_centralizer_iff.mp hh))
    · exact le_centralizer_iff.mpr (sup_le hh hB)
  have hAc := factor_centralizer s t.normalized (t.lower_le.trans hB) hAB
  have hBc := factor_centralizer t s.normalized (s.lower_le.trans hA)
    (by rwa [commutator_comm])
  have hAM : A ≤ Mbar R := by simpa only [alpha,stabilizer_m_base] using s.local_group
  have hprod : (T : Set (FreeAmalgam R)) = (A : Set (FreeAmalgam R)) * (B : Set (FreeAmalgam R)) := by
    rw [← coe_mul_of_left_le_normalizer_right A B (hAM.trans t.normalized),hgen]
  apply le_antisymm
  · rintro x ⟨hx,hc⟩
    have hx' : x ∈ (T : Set (FreeAmalgam R)) := hx
    rw [hprod] at hx'
    obtain ⟨a,ha,b,hb,rfl⟩ := hx'
    have hxB : a*b ∈ centralizer (B : Set (FreeAmalgam R)) :=
      (centralizer_le (show B ≤ T from le_sup_right.trans hgen.le)) hc
    have hxA : a*b ∈ centralizer (A : Set (FreeAmalgam R)) :=
      (centralizer_le (show A ≤ T from le_sup_left.trans hgen.le)) hc
    have haB : a ∈ centralizer (B : Set (FreeAmalgam R)) := by
      have hh := (centralizer (B : Set (FreeAmalgam R))).mul_mem hxB
        ((centralizer (B : Set (FreeAmalgam R))).inv_mem (hB hb))
      simpa only [mul_inv_cancel_right] using hh
    have hbA : b ∈ centralizer (A : Set (FreeAmalgam R)) := by
      have hh := (centralizer (A : Set (FreeAmalgam R))).mul_mem
        ((centralizer (A : Set (FreeAmalgam R))).inv_mem (hA ha)) hxA
      simpa only [inv_mul_cancel_left] using hh
    exact N.mul_mem (hAc.le ⟨ha,haB⟩) (hBc.le ⟨hb,hbA⟩)
  · apply le_inf (s.lower_le.trans (le_sup_left.trans hgen.le))
    apply le_centralizer_iff.mpr
    rw [← hgen]
    exact sup_le (hA.trans (centralizer_le s.lower_le))
      (hB.trans (centralizer_le t.lower_le))

/-- The second hat has exactly the first hat as its center. -/
theorem second_center (common : CommonFacts R source geometry)
    (earlier : Earlier R geometry) (p : Early.SourcePath R (alpha R)) :
    hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8) ⊓
      centralizer (hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8) :
        Set (FreeAmalgam R)) = hatV R (alpha R) (p.walk.getVert 6) := by
  let q := Early.Orbit.SourceApplications.higherPath geometry p
  obtain ⟨δ⟩ := Quotients.SecondLayer.SourceRecognition.deltaChoice_nonempty common earlier p
  have hfirst := Higher.OrbitGeometry.Replacement.Source.source_orbit_le_Q common earlier p
  have hdelta := Quotients.SecondLayer.OrbitSource.delta_orbit_le_Q common earlier p δ
  have hab := Higher.OrbitGeometry.orbit_abelian_of_le_Q
    (p.even_color (i := 8) (by decide) (by decide)) hfirst
  have hdb := Higher.OrbitGeometry.orbit_abelian_of_le_Q
    (Quotients.SecondLayer.Recognition.delta_color δ) hdelta
  have hcomm := (Early.Orbit.Source.Complete.sourceOrbitFacts common earlier p).hatW_commutator
  obtain ⟨s⟩ := Quotients.SecondLayer.Recognition.orbitModule source earlier q
    (Quotients.SecondLayer.Recognition.first_seed_le q)
    (p.even_color (i := 8) (by decide) (by decide)) hab hcomm
  obtain ⟨t⟩ := Quotients.SecondLayer.Recognition.orbitModule source earlier q
    (Quotients.SecondLayer.Recognition.delta_seed_le δ)
    (Quotients.SecondLayer.Recognition.delta_color δ) hdb hcomm
  obtain ⟨hf,hs,hm,ho⟩ := Quotients.SecondLayer.SourceRecognition.first_dynamics common earlier p δ hfirst s
  obtain ⟨first⟩ := s.markedDualSection earlier
    (Quotients.SecondLayer.Recognition.first_seed_le q) hf hs hm ho
  obtain ⟨hf',hs',hm',ho'⟩ := Quotients.SecondLayer.SourceRecognition.delta_dynamics common earlier p δ hfirst hdelta t
  obtain ⟨second⟩ := t.markedDualSection earlier
    (Quotients.SecondLayer.Recognition.delta_seed_le δ) hf' hs' hm' ho'
  let := Quotients.SecondLayer.Recognition.orbitFactor_elementary earlier q
    (Quotients.SecondLayer.Recognition.first_seed_le q)
    (p.even_color (i := 8) (by decide) (by decide)) hab
  let := Quotients.SecondLayer.Recognition.orbitFactor_elementary earlier q
    (Quotients.SecondLayer.Recognition.delta_seed_le δ)
    (Quotients.SecondLayer.Recognition.delta_color δ) hdb
  exact center_of_abelian_marked_factors first second δ.factors_generate
    (commutator_self_eq_bot_iff.mpr inferInstance)
    (commutator_self_eq_bot_iff.mpr inferInstance) (second_nonabelian common earlier p)

/-- The core center meets the second layer inside the first hat. -/
theorem core_center_inf_second_le_first (common : CommonFacts R source geometry)
    (earlier : Earlier R geometry) (p : Early.SourcePath R (alpha R)) :
    (center (core R (alpha R))).map (core R (alpha R)).subtype ⊓
      hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8) ≤
        hatV R (alpha R) (p.walk.getVert 6) := by
  rw [← second_center common earlier p]
  exact le_inf inf_le_right (inf_le_left.trans (core_center_centralizes_second common earlier p))

/-- The entire part of the original core center lying in the second
layer already lies in Z, with no center-containment premise. -/
theorem core_center_inf_second_le_Z (common : CommonFacts R source geometry)
    (earlier : Earlier R geometry) (p : Early.SourcePath R (alpha R)) :
    (center (core R (alpha R))).map (core R (alpha R)).subtype ⊓
      hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8) ≤ Z R (alpha R) := by
  rw [← Quotients.FirstDirect.first_hat_inf_core_centralizer common earlier p]
  apply le_inf (core_center_inf_second_le_first common earlier p)
  rintro x ⟨⟨x,hx,rfl⟩,_⟩ y hy
  exact congrArg Subtype.val ((mem_center_iff.mp hx) ⟨y,hy⟩)

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.CoreFactors.Center
