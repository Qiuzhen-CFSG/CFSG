module

public import Stellmacher.PushingUp.AmalgamGraph.CharacteristicKernel
public import Theory.GroupTheory.PGroup.OmegaAmbient
public import Theory.GroupTheory.PResidual.Defs
public import Theory.GroupTheory.CentralizerModulo

/-!
# The actual MS93 amalgam layers

All groups below are subgroups of `M *_R Hol(R)`, with the original factor
embeddings and right-coset graph. No finiteness of this amalgam or of its
vertex set is imposed. At vertices of M-type, the local component is the
embedded two-residual of the stabilizer; identifying it with the transported
input component is a separate theorem.

The names distinguish the source's radius-two `V` from `core = [Q,Ltilde]`,
and its fixed subgroup `fixedCore` (source D_alpha) from the original core D.
`B` uses the actual quotient of the local stabilizer by Z. Its relative
normality is an explicit argument, not an ambient normality assertion.

Source: Meierfrankenfeld--Stellmacher, *Pushing up weak BN-pairs of rank two*
(1993), notation on printed pp.855, 859, 881. These are definitions, not
assertions that the source hypotheses or its classification hold.
-/

@[expose] public section

namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93

open Subgroup
open Stellmacher.PushingUp.AmalgamGraph

universe u
variable {M : Type u} [Group M] (R : Subgroup M)

/-- The distinguished M-vertex, using the existing right-coset carrier. -/
def alpha : Vertex R := mVertex R 1

/-- The distinguished holomorph vertex. -/
def beta : Vertex R := hVertex R 1

/-- The actual first-neighborhood kernel. At M-vertices this is Q_alpha;
at holomorph vertices it is T_beta. -/
abbrev Q (a : Vertex R) : Subgroup (FreeAmalgam R) := neighborhoodKernel R a

/-- Omega-one of the center, with both inclusions into the ambient group. -/
def omegaCenter {G : Type*} [Group G] (A : Subgroup G) : Subgroup G :=
  ((omega₁ (center A) (p := 2)).map (center A).subtype).map A.subtype

/-- Source Z_beta on a holomorph vertex, defined by the actual kernel. -/
def edgeOmega (a : Vertex R) : Subgroup (FreeAmalgam R) := omegaCenter (Q R a)

/-- Source Z_alpha on an M-vertex and Z_beta on a holomorph vertex. -/
noncomputable def Z (a : Vertex R) : Subgroup (FreeAmalgam R) :=
  if color R a = false then ⨆ b, ⨆ (_ : Adjacent R a b), edgeOmega R b
  else edgeOmega R a

/-- Source X_alpha. -/
def X (a : Vertex R) : Subgroup (FreeAmalgam R) := omegaCenter (Q R a)

/-- The subgroup generated by every Z-layer within radius i, on either color. -/
noncomputable def VBall (a : Vertex R) (i : ℕ) : Subgroup (FreeAmalgam R) :=
  ⨆ b, ⨆ (_ : (cosetGraph R).dist b a ≤ i), Z R b

/-- Source V_alpha, the radius-two group; it is not the commutator core. -/
noncomputable def V (a : Vertex R) : Subgroup (FreeAmalgam R) := VBall R a 2

/-- The actual local two-residual, to be identified with the component at
M-vertices by the source realization. -/
def Ltilde (a : Vertex R) : Subgroup (FreeAmalgam R) :=
  (pResidual 2 (stabilizer R a)).map (stabilizer R a).subtype

/-- The source's V = [Q_alpha,Ltilde_alpha]. -/
def core (a : Vertex R) : Subgroup (FreeAmalgam R) := ⁅Q R a, Ltilde R a⁆

/-- Source D_alpha, the fixed part of Q_alpha, not the original core D. -/
def fixedCore (a : Vertex R) : Subgroup (FreeAmalgam R) :=
  Q R a ⊓ centralizer (Ltilde R a : Set (FreeAmalgam R))

/-- Source U_alpha. -/
noncomputable def U (a : Vertex R) : Subgroup (FreeAmalgam R) := ⁅Z R a, Ltilde R a⁆

/-- Source V_alpha^circ. -/
noncomputable def Vcirc (a : Vertex R) : Subgroup (FreeAmalgam R) :=
  ⁅V R a, Ltilde R a⁆

/-- Source H_alpha. -/
noncomputable def H (a : Vertex R) : Subgroup (FreeAmalgam R) := ⁅Vcirc R a, Q R a⁆

/-- Source C_alpha = C_{G_alpha}(Z_alpha). -/
noncomputable def C (a : Vertex R) : Subgroup (FreeAmalgam R) :=
  stabilizer R a ⊓ centralizer (Z R a : Set (FreeAmalgam R))

/-- Full preimage of the fixed subgroup on V_alpha/Z_alpha, computed in the
actual local stabilizer quotient. To use the source interpretation, supply
Z_alpha ≤ V_alpha ≤ G_alpha and relative normality of Z_alpha. -/
noncomputable def B (a : Vertex R)
    (hn : ((Z R a).subgroupOf (stabilizer R a)).Normal) : Subgroup (FreeAmalgam R) :=
  letI := hn
  (centralizerModulo ((V R a).subgroupOf (stabilizer R a))
    (pResidual 2 (stabilizer R a)) ((Z R a).subgroupOf (stabilizer R a))).map
      (stabilizer R a).subtype

/-- The genuine critical-distance predicate. The end vertex has either color;
evenness must be proved, not imposed by restricting the minimization. -/
def CriticalRadius (a : Vertex R) (n : ℕ) : Prop :=
  ∃ a' : Vertex R, (cosetGraph R).dist a a' = n ∧ ¬ Z R a ≤ Q R a'

/-- Existence is an explicit argument until proved from the source hypotheses. -/
noncomputable def criticalDistance (a : Vertex R) (he : ∃ n, CriticalRadius R a n) : ℕ := by
  classical
  exact Nat.find he

/-- Both the least-distance clause and the noncontainment are retained. -/
def CriticalPair (a a' : Vertex R) (he : ∃ n, CriticalRadius R a n) : Prop :=
  (cosetGraph R).dist a a' = criticalDistance R a he ∧ ¬ Z R a ≤ Q R a'

end CFSG.Quasithin.ChapterC.BinaryMS.MS93
