module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Quotient.LargeBranch.RankOne.Requirements
public import Theory.GroupAction.SubgroupQuotientFullAction
public import Theory.Representation.ElementaryAbelianAction
public import Theory.Representation.BinaryOffender.Defs

/-!
# Actual binary quotients for the large-intersection recognition

An invariant subgroup S of V_alpha has an elementary quotient by its
relative Z_alpha subgroup: V_alpha is generated by involutions and its
derived subgroup is U_alpha ≤ Z_alpha. The radius commutator bound makes
Q_alpha act trivially on the quotient, so the actual conjugation action
descends through the supplied projection to SL3(2). Finiteness is inherited
from the vertex stabilizer, never from the free amalgam.

For S inside V_alpha-star, the identity V_alpha-star ∩ B_alpha = Z_alpha
excludes fixed vectors. Simplicity then makes the action faithful whenever
S is not contained in Z_alpha. Subgroup images retain their literal relative
indices as powers of two. A dual linear equivalence with the given NaturalU
marking yields the required SpanQuotient, including its kernel and ambient
action equation.

These constructions provide the actual modules used in MS93 (1993),
(4.6.12)(1)--(5), printed pp.910--912. They do not prove the rank-one
sections, construct the cyclic seed of (3), or determine the starred dimension.
No rank-one residual is replaced by the full SL2(2) actor.
-/

@[expose] public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.LargeBranch.RankOne
open Representation Representation.BinaryOffender
universe u
variable {M : Type u} [Group M] {L R : Subgroup M}

/-- A finite binary realization of S/(Z_alpha ∩ S), with the conjugation
 action descended through the specified projection. No module recognition is a field. -/
structure LayerModule (source : LocalSource L R) (S : Subgroup (FreeAmalgam R)) where
  Space : Type u
  [addCommGroup : AddCommGroup Space]
  [module : Module (ZMod 2) Space]
  [finite : Finite Space]
  representation : Representation (ZMod 2) SL Space
  projection : S →* Multiplicative Space
  onto : Function.Surjective projection
  kernel : projection.ker = (Z R (alpha R)).subgroupOf S
  action : ∀ (m : M) (x y : S),
    (y : FreeAmalgam R) = embedM R m * (x : FreeAmalgam R) * (embedM R m)⁻¹ →
    (projection y).toAdd = representation (source.projection m) (projection x).toAdd
attribute [instance] LayerModule.addCommGroup LayerModule.module LayerModule.finite

private theorem radius_square_mem_Z {geometry : Geometry R} (radius : RadiusFacts R geometry)
    (x : V R (alpha R)) : (x : FreeAmalgam R) ^ 2 ∈ Z R (alpha R) := by
  let P := V R (alpha R)
  let f : P →* Abelianization P := (powMonoidHom 2).comp Abelianization.of
  have hle : P ≤ f.ker.map P.subtype := by
    change VBall R (alpha R) 2 ≤ _
    conv_lhs => rw [← DistanceEight.VBall_omegaOne R (alpha R) 2]
    apply (omegaOneAmbient_le_iff _ _).mpr
    intro y hy hy2
    refine ⟨⟨y, hy⟩, ?_, rfl⟩
    change (Abelianization.of (⟨y, hy⟩ : P)) ^ 2 = 1
    rw [← map_pow, show (⟨y, hy⟩ : P) ^ 2 = 1 from Subtype.ext hy2, map_one]
  obtain ⟨y, hy, he⟩ := hle x.property
  change (y : FreeAmalgam R) = x at he
  have hpow : y ^ 2 ∈ commutator P := by
    rw [← Abelianization.ker_of P]
    change Abelianization.of (y ^ 2) = 1
    rw [map_pow]
    exact hy
  have hh := mem_map_of_mem P.subtype hpow
  rw [map_subtype_commutator, radius.radius_derived (alpha R) rfl] at hh
  apply DistanceEight.U_le_Z R (alpha R)
  simpa only [subtype_apply, coe_pow, he] using hh

variable (source : LocalSource L R) (geometry : Geometry R)
  (common : CommonFacts R source geometry) (radius : RadiusFacts R geometry)

include common radius in
/-- Construct the literal relative quotient and its actual SL3(2) action. -/
theorem exists_layerModule [Finite M] (S : Subgroup (FreeAmalgam R))
    (hS : S ≤ V R (alpha R))
    (hSn : stabilizer R (alpha R) ≤ normalizer S) : Nonempty (LayerModule source S) := by
  let N := (Z R (alpha R)).subgroupOf S
  have hSQ : S ≤ Q R (alpha R) := hS.trans (Flags.V_le_Q geometry common.large_distance _ rfl)
  have hSZ : S ≤ centralizer (Z R (alpha R) : Set (FreeAmalgam R)) :=
    hSQ.trans (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp
      (geometry.centralizes (alpha R) rfl)))
  have hNC : N ≤ center S := by
    intro x hx
    apply mem_center_iff.mpr
    intro y
    apply Subtype.ext
    exact (hSZ y.property x hx).symm
  let : N.Normal := ⟨by
    intro x hx g
    simpa only [(mem_center_iff.mp (hNC hx) g), mul_inv_cancel_right] using hx⟩
  let D := S ⧸ N
  let : Finite (stabilizer R (alpha R)) := finite_stabilizer R (alpha R)
  have hSl : S ≤ stabilizer R (alpha R) := hS.trans
    (geometry.V_local (alpha R) rfl common.large_distance)
  let : Finite S := Finite.of_injective (inclusion hSl) (inclusion_injective _)
  have hderived : _root_.commutator S ≤ N := by
    intro x hx
    have hh := mem_map_of_mem S.subtype hx
    rw [map_subtype_commutator] at hh
    exact ((commutator_mono hS hS).trans
      ((radius.radius_derived (alpha R) rfl).le.trans (DistanceEight.U_le_Z R _))) hh
  let : IsMulCommutative D := Normal.quotient_commutative_iff_commutator_le.mpr hderived
  let : IsElementaryAbelian 2 D := {
    exponent_dvd_p := by
      rw [Monoid.exponent_dvd_iff_forall_pow_eq_one]
      intro x
      obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective N x
      rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
      exact radius_square_mem_Z radius ⟨y, hS y.property⟩ }
  let P := Mbar R
  have hPS : P ≤ normalizer S := by simpa only [alpha, stabilizer_m_base] using hSn
  have hPZ : P ≤ normalizer (Z R (alpha R)) := by
    simpa only [alpha, stabilizer_m_base] using Z_normalized R (alpha R)
  obtain ⟨a, ha⟩ := exists_quotient_conjugation_action P S (Z R (alpha R)) hPS hPZ inferInstance
  let i : M →* P := (embedM R).rangeRestrict
  let aM : M →* MulAut D := a.comp i
  have hkill : source.projection.ker ≤ aM.ker := by
    intro m hm
    have hmQ : embedM R m ∈ Q R (alpha R) := by
      rw [Q_alpha R source.two_group source.core_le]
      exact mem_map_of_mem _ (source.projection_kernel ▸ hm)
    have hk := quotient_conjugation_action_kills_commutator_layer P S (Z R (alpha R))
      (Q R (alpha R)) inferInstance hPS
      ((commutator_mono hS le_rfl).trans (radius.commutator_le_Z (alpha R) rfl)) a ha
    exact hk hmQ
  let aSL : SL →* MulAut D := source.projection.liftOfSurjective
    source.projection_surjective ⟨aM, hkill⟩
  have haSL (m : M) : aSL (source.projection m) = aM m := by
    exact MonoidHom.liftOfRightInverse_comp_apply _ _ _ _ _
  let : MulDistribMulAction SL D := MulDistribMulAction.compHom D aSL
  let ρ : Representation (ZMod 2) SL (Additive D) := ofElementaryAbelianAction
  let q : S →* Multiplicative (Additive D) :=
    (MulEquiv.multiplicativeAdditive (H := D)).symm.toMonoidHom.comp (QuotientGroup.mk' N)
  refine ⟨{
    Space := Additive D
    representation := ρ
    projection := q
    onto := (MulEquiv.multiplicativeAdditive (H := D)).symm.surjective.comp (QuotientGroup.mk'_surjective N)
    kernel := ?_
    action := ?_ }⟩
  · exact (MonoidHom.ker_comp_of_injective (QuotientGroup.mk' N)
      (MulEquiv.multiplicativeAdditive (H := D)).symm.toMonoidHom
      (MulEquiv.multiplicativeAdditive (H := D)).symm.injective).trans
        (QuotientGroup.ker_mk' N)
  · intro m x y hy
    change QuotientGroup.mk' N y = aSL (source.projection m) (QuotientGroup.mk' N x)
    rw [haSL, show aM m = a (i m) from rfl, ha]
    congr 1
    exact Subtype.ext hy

variable {source geometry} {S : Subgroup (FreeAmalgam R)}

namespace LayerModule
variable (d : LayerModule source S)

/-- The exact kernel identifies the relative index with the binary dimension. -/
theorem relIndex_eq_pow_finrank :
    (Z R (alpha R)).relIndex S = 2 ^ Module.finrank (ZMod 2) d.Space := by
  change ((Z R (alpha R)).subgroupOf S).index = _
  rw [← d.kernel]
  change Nat.card (S ⧸ d.projection.ker) = _
  rw [Nat.card_congr (QuotientGroup.quotientKerEquivOfSurjective d.projection d.onto).toEquiv]
  change Nat.card d.Space = _
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2), Nat.card_zmod]

include common radius in
/-- The starred intersection identity removes all fixed vectors in every invariant sublayer. -/
theorem fixed_eq_bot_of_le_star
    (hS : S ≤ VStar R geometry (alpha R) (beta R))
    (hSn : stabilizer R (alpha R) ≤ normalizer S) :
    fixedSpace d.representation ⊤ = ⊥ := by
  apply le_bot_iff.mp
  intro v hv
  obtain ⟨x, hx⟩ := d.onto (Multiplicative.ofAdd v)
  have hV := geometry.V_local (alpha R) rfl common.large_distance
  have hxV := (hS.trans (Flags.star_le_radius geometry _ _)) x.property
  have hxB : (x : FreeAmalgam R) ∈ B R (alpha R) (geometry.Z_normal _) := by
    apply (mem_B_iff R (alpha R) (geometry.Z_normal _) hV x).mpr
    refine ⟨hxV, ?_⟩
    intro l hl
    have hlM : l ∈ Mbar R := by
      rw [← stabilizer_m_base R]
      exact map_subtype_le _ hl
    obtain ⟨m, rfl⟩ := hlM
    have hm : embedM R m ∈ stabilizer R (alpha R) := by
      rw [alpha, stabilizer_m_base]
      exact ⟨m, rfl⟩
    let y : S := ⟨embedM R m * x * (embedM R m)⁻¹,
      (mem_normalizer_iff.mp (hSn hm) x).mp x.property⟩
    have he : d.projection y = d.projection x := by
      apply Multiplicative.toAdd.injective
      rw [d.action m x y rfl, hx]
      exact hv ⟨source.projection m, mem_top _⟩
    have hz : y * x⁻¹ ∈ d.projection.ker := by
      change d.projection (y * x⁻¹) = 1
      rw [map_mul, map_inv, he, mul_inv_cancel]
    rw [d.kernel] at hz
    exact hz
  have hxZ : (x : FreeAmalgam R) ∈ Z R (alpha R) :=
    (radius.star_intersection (alpha R) (beta R) rfl (base_adjacent R)).le
      ⟨hS x.property, hxB⟩
  have hz : d.projection x = 1 := by
    change x ∈ d.projection.ker
    rw [d.kernel]
    exact hxZ
  change v = 0
  exact Multiplicative.toAdd.injective (hx.symm.trans hz)

include common radius in
/-- A nonzero starred sublayer has a faithful descended action, by simplicity of SL3(2). -/
theorem faithful_of_le_star
    (hS : S ≤ VStar R geometry (alpha R) (beta R))
    (hSn : stabilizer R (alpha R) ≤ normalizer S)
    (hne : ¬ S ≤ Z R (alpha R)) : Function.Injective d.representation := by
  let : IsSimpleGroup SL := Atlas.Comparisons.Exceptional.sl3Two_simple
  apply d.representation.ker_eq_bot_iff.mp
  rcases (inferInstance : d.representation.ker.Normal).eq_bot_or_eq_top with hk | hk
  · exact hk
  exfalso
  apply hne
  intro x hx
  have hf : (d.projection ⟨x, hx⟩).toAdd ∈ fixedSpace d.representation ⊤ := by
    intro g
    have hg : d.representation g.val = 1 := by
      change g.val ∈ d.representation.ker
      rw [hk]
      exact mem_top _
    change d.representation g.val _ = _
    rw [hg]
    rfl
  rw [d.fixed_eq_bot_of_le_star common radius hS hSn] at hf
  have hz : d.projection ⟨x, hx⟩ = 1 := hf
  change (⟨x, hx⟩ : S) ∈ (Z R (alpha R)).subgroupOf S
  rw [← d.kernel]
  exact hz

/-- The literal image of a subgroup under the quotient projection. -/
noncomputable def subspace (T : Subgroup (FreeAmalgam R)) : Submodule (ZMod 2) d.Space :=
  AddSubgroup.toZModSubmodule 2 ((T.subgroupOf S).map d.projection).toAddSubgroup

/-- Image membership retains both the ambient subgroup and the chosen quotient element. -/
theorem mem_subspace_iff (T : Subgroup (FreeAmalgam R)) (v : d.Space) :
    v ∈ d.subspace T ↔ ∃ x : S, (x : FreeAmalgam R) ∈ T ∧ (d.projection x).toAdd = v := by
  rfl

/-- The image dimension computes the original subgroup's relative Z_alpha index. -/
theorem subspace_relIndex (T : Subgroup (FreeAmalgam R)) (hT : T ≤ S) :
    (Z R (alpha R)).relIndex T = 2 ^ Module.finrank (ZMod 2) (d.subspace T) := by
  rw [← relIndex_subgroupOf hT, ← d.kernel, relIndex_ker]
  change Nat.card (d.subspace T) = _
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2), Nat.card_zmod]

/-- Normalization by one actual element gives invariance under its specified quotient image. -/
theorem subspace_invariant_of_mem (T : Subgroup (FreeAmalgam R)) (m : M)
    (hS : embedM R m ∈ normalizer S) (hT : embedM R m ∈ normalizer T)
    (v : d.Space) (hv : v ∈ d.subspace T) :
    d.representation (source.projection m) v ∈ d.subspace T := by
  obtain ⟨x, hx, rfl⟩ := (d.mem_subspace_iff T v).mp hv
  let y : S := ⟨embedM R m * x * (embedM R m)⁻¹,
    (mem_normalizer_iff.mp hS x).mp x.property⟩
  exact (d.mem_subspace_iff T _).mpr ⟨y,
    (mem_normalizer_iff.mp hT x).mp hx, d.action m x y rfl⟩

/-- Full local normalization makes the subgroup image an invariant subspace. -/
theorem subspace_invariant (T : Subgroup (FreeAmalgam R))
    (hSn : stabilizer R (alpha R) ≤ normalizer S)
    (hTn : stabilizer R (alpha R) ≤ normalizer T)
    (g : SL) (v : d.Space) (hv : v ∈ d.subspace T) :
    d.representation g v ∈ d.subspace T := by
  obtain ⟨m, rfl⟩ := source.projection_surjective g
  have hm : embedM R m ∈ stabilizer R (alpha R) := by
    rw [alpha, stabilizer_m_base]
    exact ⟨m, rfl⟩
  exact d.subspace_invariant_of_mem T m (hSn hm) (hTn hm) v hv



/-- Convert genuinely marked dual coordinates to the required ambient span quotient.
The dual equivalence is an explicit premise; this is not its source construction. -/
noncomputable def spanQuotient {c : Vertex R}
    (d : LayerModule source (orbitSpan c)) (e : d.Space ≃ₗ[ZMod 2] Linear.W)
    (he : ∀ g v, e (d.representation g v) = Linear.dual (common.natural.marking g) (e v)) :
    SpanQuotient source common c where
  quotient := e.toAddEquiv.toMultiplicative.toMonoidHom.comp d.projection
  onto := e.surjective.comp d.onto
  kernel := (MonoidHom.ker_comp_of_injective d.projection
    e.toAddEquiv.toMultiplicative.toMonoidHom e.injective).trans d.kernel
  action m x y hy := by
    change e (d.projection y).toAdd = _
    rw [d.action m x y hy]
    exact he _ _

end LayerModule

include common radius in
/-- The actual starred quotient by Z_alpha has a finite binary realization. -/
theorem exists_starModule [Finite M] :
    Nonempty (LayerModule source (VStar R geometry (alpha R) (beta R))) :=
  exists_layerModule source geometry common radius _ (Flags.star_le_radius geometry _ _)
    (Flags.star_normalized geometry _ _)

include common radius in
/-- The critical midpoint span has a finite binary quotient by the actual Z_alpha layer. -/
theorem exists_orbitModule [Finite M] (s : CriticalSegment geometry) :
    Nonempty (LayerModule source (orbitSpan s.middle)) :=
  exists_layerModule source geometry common radius _
    (orbitSpan_le_radius _ ((cosetGraph R).dist_comm.trans s.first_distance).le)
    (orbitSpan_normalized _)

include common radius in
/-- The printed tilde V_alpha is the actual quotient of the entire radius group by Z_alpha. -/
theorem exists_radiusModule [Finite M] : Nonempty (LayerModule source (V R (alpha R))) :=
  exists_layerModule source geometry common radius _ le_rfl (DistanceEight.V_normalized R _)

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.LargeBranch.RankOne
