module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Early.Initial.Radius
public import Theory.GroupTheory.Commutator.ConjugateGeneration


/-!
# The noncentral generator pair in MS93 (4.6.3)

The radius is generated by its M-colored layers. Its commutator with the
local kernel is central precisely when every pair of these generators has
trivial mixed triple commutator. A nontrivial triple forces the first layer
outside the opposite kernel: the middle kernel normalizes that opposite
kernel. Critical distance four and the triangle inequality then force both
radius distances to equal two and the endpoints to be a genuine critical
pair. No displacement bound or later centrality assertion is assumed.

Source: Meierfrankenfeld--Stellmacher (1993), beginning of (4.6.3), p.901.
-/

public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Early.Initial
variable {M : Type*} [Group M] {L R : Subgroup M}
  {source : LocalSource L R} {geometry : Geometry R}

/-- The two radius generators selected by failure of the first clause of (4.6.3). -/
structure NoncentralPair (R : Subgroup M) (a d e : Vertex R) : Prop where
  color_a : color R a = false
  color_d : color R d = false
  color_e : color R e = false
  dist_da : (cosetGraph R).dist d a = 2
  dist_ea : (cosetGraph R).dist e a = 2
  triple_ne_bot : ⁅⁅Z R d, Q R a⁆, Z R e⁆ ≠ ⊥

/-- Centrality reduces to the actual mixed triples of the radius generators. -/
theorem radius_commutator_central_iff_generator_triples
    (common : CommonFacts R source geometry) (a : Vertex R) (ha : color R a = false) :
    ⁅V R a, Q R a⁆ ≤ (center (V R a)).map (V R a).subtype ↔
    ∀ d e, color R d = false → color R e = false →
      (cosetGraph R).dist d a ≤ 2 → (cosetGraph R).dist e a ≤ 2 →
      ⁅⁅Z R d, Q R a⁆, Z R e⁆ = ⊥ := by
  have hHV : ⁅V R a, Q R a⁆ ≤ V R a :=
    le_normalizer_iff_commutator_le_left.mp
      ((show Q R a ≤ stabilizer R a from fun _ hx => hx.1).trans (V_normalized a))
  constructor
  · intro h d e _ _ hd he
    apply commutator_eq_bot_iff_le_centralizer.mpr
    intro x hx z hz
    have hZV : Z R d ≤ V R a := le_iSup_of_le d (le_iSup_of_le hd le_rfl)
    have heV : Z R e ≤ V R a := le_iSup_of_le e (le_iSup_of_le he le_rfl)
    obtain ⟨v,hv,rfl⟩ := h (commutator_mono hZV le_rfl hx)
    exact congrArg Subtype.val (mem_center_iff.mp hv ⟨z,heV hz⟩)
  · intro h
    let I := {d : Vertex R // color R d = false ∧ (cosetGraph R).dist d a ≤ 2}
    have hV : V R a = ⨆ d : I, Z R d.val := by
      apply le_antisymm
      · apply radius_le_of_generators a ha
        intro d hd hda
        exact le_iSup_of_le (⟨d,hd,hda⟩ : I) le_rfl
      · exact iSup_le fun d => le_iSup_of_le d.val (le_iSup_of_le d.property.2 le_rfl)
    have hHC : ⁅V R a,Q R a⁆ ≤ centralizer (V R a : Set (FreeAmalgam R)) := by
      conv_lhs => lhs; rw [hV]
      rw [commutator_iSup_of_le _ _ (fun d : I =>
        (le_iSup_of_le d.val (le_iSup_of_le d.property.2 le_rfl)).trans
          (radius_le_Q common a ha))]
      apply iSup_le
      intro d
      apply le_centralizer_iff.mp
      apply radius_le_of_generators a ha
      intro e he hea
      exact le_centralizer_iff.mpr (commutator_eq_bot_iff_le_centralizer.mp
        (h d.val e d.property.1 he d.property.2 hea))
    intro x hx
    refine ⟨⟨x,hHV hx⟩,mem_center_iff.mpr ?_,rfl⟩
    intro y
    exact Subtype.ext (hHC hx y y.property)

private theorem noncentral_generator_not_le [Finite M]
    (_common : CommonFacts R source geometry) (a d e : Vertex R)
    (ha : color R a = false) (he : color R e = false)
    (hea : (cosetGraph R).dist e a ≤ 2)
    (hne : ⁅⁅Z R d,Q R a⁆,Z R e⁆ ≠ ⊥) : ¬ Z R d ≤ Q R e := by
  intro hle
  have hQ : Q R a ≤ stabilizer R e :=
    Q_le_stabilizer_of_dist_le_two a e ha he (by rwa [SimpleGraph.dist_comm])
  have hcomm : ⁅Z R d,Q R a⁆ ≤ Q R e :=
    (commutator_mono hle le_rfl).trans
      (le_normalizer_iff_commutator_le_left.mp (hQ.trans (Q_normalized R e)))
  apply hne
  apply le_bot_iff.mp
  exact (commutator_mono hcomm le_rfl).trans (by
    rw [commutator_comm, geometry.centralizes e he])

/-- Failure of radius-kernel centrality supplies the exact distance-two pair. -/
theorem exists_noncentralPair [Finite M]
    (common : CommonFacts R source geometry) (hb : geometry.b R = 4)
    (a : Vertex R) (ha : color R a = false)
    (hnot : ¬ ⁅V R a,Q R a⁆ ≤ (center (V R a)).map (V R a).subtype) :
    ∃ d e, NoncentralPair R a d e := by
  have hn := mt (radius_commutator_central_iff_generator_triples common a ha).mpr hnot
  push Not at hn
  obtain ⟨d,e,hd,he,hda,hea,hne⟩ := hn
  have hout := noncentral_generator_not_le common a d e ha he hea hne
  have hlo := criticalDistance_le R d (geometry.exists_critical d hd) hout
  rw [geometry.distance_constant d hd] at hlo
  change geometry.b R ≤ (cosetGraph R).dist d e at hlo
  have htri := (cosetGraph_connected R).dist_triangle (u := d) (v := a) (w := e)
  rw [SimpleGraph.dist_comm (u := a) (v := e)] at htri
  exact ⟨d,e,ha,hd,he,by omega,by omega,hne⟩

namespace NoncentralPair
variable [Finite M] {a d e : Vertex R}

/-- Noncentrality of the triple forces a genuine critical pair of endpoints. -/
theorem critical_pair (h : NoncentralPair R a d e)
    (common : CommonFacts R source geometry) (hb : geometry.b R = 4) :
    CriticalPair R d e (geometry.exists_critical d h.color_d) := by
  have hout := noncentral_generator_not_le common a d e h.color_a h.color_e
    h.dist_ea.le h.triple_ne_bot
  refine ⟨?_,hout⟩
  apply le_antisymm _ (criticalDistance_le R d _ hout)
  rw [geometry.distance_constant d h.color_d]
  have htri := (cosetGraph_connected R).dist_triangle (u := d) (v := a) (w := e)
  rw [h.dist_da,SimpleGraph.dist_comm (u := a) (v := e),h.dist_ea] at htri
  exact htri.trans_eq hb.symm
end NoncentralPair
end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Early.Initial
