module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceEight.PathCentrality.LocalCommutator.Source
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.Escape.PairingControl.FirstPairing.Quotient
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.RankOnePairing.Assembly

/-!
# Lifting the local commutator pairing through the fixed core

A genuine application of (1.7)(i) propagates the centralizer of a seed to
its normal closure and gives the commutator value at every noncentral actor.
If the actual local span is generated by that seed modulo C(Q_c), these
conclusions control the whole span. The origin bound for the seed supplies
centralization by Q_a ∩ Q_c. All statements lift through G_c/D_c using the
literal quotient map, including the source product with D_c.

The pairing seed remains an explicit input. This module does not construct
it from the source hypotheses or assume a trapped radius.

Source: Meierfrankenfeld--Stellmacher, Pushing up weak BN-pairs of rank two
(1993), (1.7)(i), pp.847--848, and (4.4.1), pp.890--891.
-/

@[expose] public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality.LocalCommutator.NaturalCase
open RankOnePairing Escape.PairingControl.FirstPairing

private theorem pairing_controls {G : Type*} [Group G] [Finite G]
    {e : Extension (M := G)} {i : Bool} {Z W X H A K : Subgroup G}
    [Z.Normal] [W.Normal] [H.Normal]
    (d : SourceData e i Z W X)
    (hf : Z ⊓ centralizer (localResidual (localParabolic e i) : Set G) ≠ ⊥)
    (hXH : X ≤ H) (hXA : X ≤ A ⊔ centralizer (W : Set G))
    (hH : H ≤ generated X ⊔ centralizer (W : Set G))
    (hKW : K ≤ W) (hAK : A ≤ centralizer (K : Set G)) :
    ⁅H, K⁆ = ⊥ ∧ ∀ w ∈ W, ⁅H, zpowers w⁆ ≠ ⊥ → Z ≤ ⁅zpowers w, H⁆ := by
  obtain ⟨_, _, _, hcent, hvalue⟩ := theorem_1_7_i d hf
  have hKX : K ≤ centralizer (X : Set G) := le_centralizer_iff.mp
    (hXA.trans (sup_le hAK (centralizer_le hKW)))
  have hKG : K ≤ centralizer (generated X : Set G) := by
    intro k hk
    exact (hcent.le ⟨hKW hk, hKX hk⟩).2
  have hHK : H ≤ centralizer (K : Set G) :=
    hH.trans (sup_le (le_centralizer_iff.mp hKG) (centralizer_le hKW))
  refine ⟨commutator_eq_bot_iff_le_centralizer.mpr hHK, ?_⟩
  intro w hw hn
  have hnG : w ∉ centralizer (generated X : Set G) := by
    intro hwG
    have hcyc : zpowers w ≤ W := zpowers_le.mpr hw
    have hHG : H ≤ centralizer (zpowers w : Set G) := hH.trans
      (sup_le (le_centralizer_iff.mp (zpowers_le.mpr hwG))
        (centralizer_le hcyc))
    exact hn (commutator_eq_bot_iff_le_centralizer.mpr hHG)
  rw [commutator_comm]
  exact (hvalue ⟨w, hw⟩ hnG).ge.trans
    (commutator_mono (generated_le X H hXH) le_rfl)

variable {M : Type*} [Group M] {L R : Subgroup M}

/-- Inclusion in the actual quotient means inclusion modulo the fixed core. -/
theorem quotientImage_le_iff (c : Vertex R) (H K : Subgroup (FreeAmalgam R))
    (hH : H ≤ stabilizer R c) (hK : K ≤ stabilizer R c) :
    quotientImage c H ≤ quotientImage c K ↔ H ≤ K ⊔ fixedCore R c := by
  have hD : fixedCore R c ≤ stabilizer R c := fun _ hx => hx.1.1
  rw [quotientImage, quotientImage, map_le_iff_le_comap, comap_map_eq,
    quotientMap, QuotientGroup.ker_mk']
  change H.subgroupOf (stabilizer R c) ≤
    K.subgroupOf (stabilizer R c) ⊔ (fixedCore R c).subgroupOf (stabilizer R c) ↔ _
  rw [← subgroupOf_sup hK hD]
  constructor
  · intro h x hx
    exact h (show (⟨x, hH hx⟩ : stabilizer R c) ∈ H.subgroupOf (stabilizer R c) from hx)
  · intro h x hx
    exact h hx

/-- Cyclic subgroups are mapped using the same element of the stabilizer. -/
theorem quotientImage_zpowers (c : Vertex R) (x : stabilizer R c) :
    quotientImage c (zpowers (x : FreeAmalgam R)) = zpowers (quotientMap c x) := by
  have hz : (zpowers (x : FreeAmalgam R)).subgroupOf (stabilizer R c) = zpowers x := by
    apply map_injective (stabilizer R c).subtype_injective
    rw [map_subgroupOf_eq_of_le (zpowers_le.mpr x.property), MonoidHom.map_zpowers]
    rfl
  rw [quotientImage, hz, MonoidHom.map_zpowers]

variable [Finite M] {source : LocalSource L R} {geometry : Geometry R}

/-- A genuine (1.7)(i) application controls both commutator clauses after
lifting from G_c/D_c. The seed and its generation hypotheses remain explicit. -/
theorem localControl_of_pairing {a c : Vertex R} (ha : color R a = false) (hc : color R c = false)
    (hd : (cosetGraph R).dist a c = 2) (hb : 4 < geometry.b R)
    (e : Extension (M := LocalQuotient c)) (i : Bool)
    (seed : Subgroup (LocalQuotient c))
    (d : let := quotientImage_normal c (Z R c) (Z_normalized R c)
         let := quotientImage_normal c (Q R c) (Q_normalized R c)
         SourceData e i (quotientImage c (Z R c)) (quotientImage c (Q R c)) seed)
    (hf : quotientImage c (Z R c) ⊓ centralizer
      (localResidual (localParabolic e i) : Set (LocalQuotient c)) ≠ ⊥)
    (hseed : seed ≤ quotientImage c (localZSpan R a c))
    (hseed_origin : seed ≤ quotientImage c (Z R a) ⊔
      centralizer (quotientImage c (Q R c) : Set (LocalQuotient c)))
    (hspan : quotientImage c (localZSpan R a c) ≤ generated seed ⊔
      centralizer (quotientImage c (Q R c) : Set (LocalQuotient c))) :
    LocalControlAt R a c := by
  let := quotientImage_normal c (Z R c) (Z_normalized R c)
  let := quotientImage_normal c (Q R c) (Q_normalized R c)
  let := quotientImage_normal c (localZSpan R a c) (localZSpan_normalized R a c)
  have hQS : Q R c ≤ stabilizer R c := fun _ hx => hx.1
  have hWS : localZSpan R a c ≤ stabilizer R c :=
    (span_le_kernel_intersection hc hd hb).trans inf_le_right |>.trans hQS
  have hAS : Z R a ≤ stabilizer R c := (Z_le_localZSpan R a c).trans hWS
  have hKS : Q R a ⊓ Q R c ≤ stabilizer R c := inf_le_right.trans hQS
  have hKW : quotientImage c (Q R a ⊓ Q R c) ≤ quotientImage c (Q R c) :=
    map_mono (subgroupOf_mono _ inf_le_right)
  have hAK : quotientImage c (Z R a) ≤
      centralizer (quotientImage c (Q R a ⊓ Q R c) : Set (LocalQuotient c)) := by
    apply commutator_eq_bot_iff_le_centralizer.mp
    apply (quotient_commutator_eq_bot_iff c _ _ hAS hKS).mpr
    exact ((commutator_mono le_rfl inf_le_left).trans
      (geometry.centralizes a ha).le).trans bot_le
  obtain ⟨hfirst, hsecond⟩ := pairing_controls d hf hseed hseed_origin hspan hKW hAK
  refine ⟨(quotient_commutator_eq_bot_iff c _ _ hWS hKS).mp hfirst, ?_⟩
  intro x hx hn
  let xc : stabilizer R c := ⟨x, hQS hx⟩
  have hcyc : zpowers x ≤ stabilizer R c := zpowers_le.mpr xc.property
  have hn' : ⁅quotientImage c (localZSpan R a c), zpowers (quotientMap c xc)⁆ ≠ ⊥ := by
    rw [← quotientImage_zpowers c xc]
    exact fun h => hn ((quotient_commutator_eq_bot_iff c _ _ hWS hcyc).mp h)
  have hval := hsecond (quotientMap c xc) (mem_map_of_mem _ hx) hn'
  rw [← quotientImage_zpowers c xc, ← quotientImage_commutator c _ _ hcyc hWS] at hval
  exact (quotientImage_le_iff c _ _ (Z_le_stabilizer R c)
    ((Subgroup.commutator_le_sup _ _).trans (sup_le hcyc hWS))).mp hval
end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality.LocalCommutator.NaturalCase
