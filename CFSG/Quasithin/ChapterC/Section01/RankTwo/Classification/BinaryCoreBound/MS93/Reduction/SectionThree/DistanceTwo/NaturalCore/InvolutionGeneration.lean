module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.SectionThree.DistanceTwo.NaturalCore.LocalGeometry
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.CriticalPairs
public import Theory.GroupTheory.InvolutionGeneratedCommutator.Generation
public import Theory.GroupTheory.PResidual.SubnormalCoreAction
public import Theory.GroupTheory.PResidual.PerfectCover

/-!
# Involution generation of the distance-two core

Choose a critical endpoint alpha' and the common edge at distance two.
The local commutator [core,Z_alpha'] lies in the elementary abelian
endpoint layer. Critical-pair reversal says Z_alpha' is outside Q_alpha.
Its pullback to M therefore has nontrivial image in the actual simple
SL3(2) quotient. Its normal closure contains the two-residual of M.

The subgroup generated by the involutions of the core is M-normal.
The local commutator bound extends to that normal closure, and
[core,Ltilde] = core finishes the generation argument. All normal closures
in the proof are inside the finite group M; none is taken in the infinite
free amalgam. Only the resulting subgroup equality is transported there.

This proves the involution-generation clause needed by the natural
large-core branch, already from the distance-two source hypotheses.
Source: Meierfrankenfeld--Stellmacher, *Pushing up weak BN-pairs of rank two*
(1993), critical-pair reversal (2.2)(iii) and the commutator-generation
argument in (3.6), printed pp.856 and 870.
-/

public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph

namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceTwo.NaturalCore

variable {M : Type*} [Group M] [Finite M] {L R : Subgroup M}

/-- At distance two the actual commutator core is generated by its involutions. -/
theorem involution_generation (source : LocalSource L R)
    (geometry : Geometry R) (hb : geometry.b R = 2) :
    closure {x : core R (alpha R) | x ^ 2 = 1} = ⊤ := by
  obtain ⟨a', t, hc, hat, ha't⟩ := critical_edge_exists geometry hb
  have ha' := critical_endpoint_color R (alpha R) rfl _ hc
  have hreverse := source.critical_reverse geometry (alpha R) rfl a' ha' hc
  have hZ : Z R a' ≤ (embedM R).range := by
    change Z R a' ≤ Mbar R
    rw [← stabilizer_m_base]
    apply Z_le_stabilizer_of_dist_two R geometry a' ha'
    · rw [geometry.distance_constant a' ha']
      change 0 < geometry.b R
      omega
    · rw [SimpleGraph.dist_comm]
      exact hc.1.trans hb
  let A := (Z R a').comap (embedM R)
  have hAm : A.map (embedM R) = Z R a' :=
    (map_comap_eq _ _).trans (inf_eq_right.mpr hZ)
  let K := ⁅pCore 2 M, pResidual 2 M⁆
  have hKm : K.map (embedM R) = core R (alpha R) :=
    (core_alpha R source.two_group source.core_le rfl).symm
  have hA : ¬ A ≤ pCore 2 M := by
    intro h
    apply hreverse.2
    rw [← hAm, Q_alpha R source.two_group source.core_le]
    exact map_mono h
  let N := normalClosure (A : Set M)
  have hLN : pResidual 2 M ≤ N := by
    let : IsSimpleGroup SL := Atlas.Comparisons.Exceptional.sl3Two_simple
    have hn : (N.map source.projection).Normal :=
      (inferInstance : N.Normal).map _ source.projection_surjective
    have htop : N.map source.projection = ⊤ := by
      rcases hn.eq_bot_or_eq_top with h | h
      · apply False.elim
        apply hA
        have hNQ : N ≤ pCore 2 M := by
          simpa only [source.projection_kernel] using (Subgroup.map_eq_bot_iff _).mp h
        exact le_normalClosure.trans hNQ
      · exact h
    rw [source.residual]
    exact source.residual_le_of_image_top N htop
  have hfull : ⁅K, pResidual 2 M⁆ = K :=
    commutator_isPPerfect_idempotent (pResidual 2 M) (pCore 2 M)
      (isPPerfect_pResidual 2) pCore_isPGroup le_normalizer_of_normal
  have hpow (x : M) (hx : x ∈ ⁅K, A⁆) : x ^ 2 = 1 := by
    have hx' : embedM R x ∈ ⁅core R (alpha R), Z R a'⁆ := by
      rw [← hKm, ← hAm, ← map_commutator]
      exact mem_map_of_mem _ hx
    have hx'' := commutator_mono (core_le_Q (alpha R)) le_rfl hx'
    have hp := local_commutator_pow_two geometry hb hc hat ha't hx''
    apply embedM_injective R
    simpa only [map_pow, map_one] using hp
  have hgen := closure_involutions_eq_top_of_commutator_generation
    K A (pResidual 2 M) hLN hfull hpow
  let e : K ≃* core R (alpha R) :=
    (K.equivMapOfInjective (embedM R) (embedM_injective R)).trans
      (MulEquiv.subgroupCongr hKm)
  apply top_unique
  intro x hx
  clear hx
  obtain ⟨y, rfl⟩ := e.surjective x
  have hy : y ∈ closure {x : K | x ^ 2 = 1} := hgen.symm ▸ mem_top y
  induction hy using closure_induction with
  | mem z hz =>
    apply Subgroup.subset_closure
    change (e z) ^ 2 = 1
    rw [← map_pow, hz, map_one]
  | one =>
    simpa only [map_one] using (closure {x : core R (alpha R) | x ^ 2 = 1}).one_mem
  | mul y z _ _ hy hz => simpa only [map_mul] using Subgroup.mul_mem _ hy hz
  | inv y _ hy => simpa only [map_inv] using Subgroup.inv_mem _ hy

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceTwo.NaturalCore
