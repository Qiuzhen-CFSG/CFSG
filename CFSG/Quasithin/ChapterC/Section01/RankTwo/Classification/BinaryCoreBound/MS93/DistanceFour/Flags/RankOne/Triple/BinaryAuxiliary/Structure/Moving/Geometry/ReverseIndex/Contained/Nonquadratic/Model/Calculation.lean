module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Flags.RankOne.Triple.BinaryAuxiliary.Structure.Moving.Geometry.ReverseIndex.Contained.Nonquadratic.Model
import Mathlib.LinearAlgebra.Pi

/-!
# The binary S4 quadratic-action calculation

Let E = ⟨(01),(23)⟩ and K = ⟨(01)(23),(02)(13)⟩. If a binary S4-module
is generated by translates of an E-fixed subspace and E acts quadratically,
then S4 fixes all K-displacements.

For one E-fixed vector, its orbit is an image of the permutation module on
the six two-subsets of {0,1,2,3}. The mixed quadratic relation for (01),(23),
and its translate by (12), vanish in that image. A small kernel-checked
certificate expresses each triple displacement for an adjacent transposition
and a generator of K as a sum of these two relations. Generation of S4,
linearity over the orbit span, and generation of K finish the universal proof.
No finiteness or dimension assumption on the target module is needed.

This discharges the calculation premise of
`Y_first_core_not_quadratic_of_marking_and_calculation`; the actual source
quotient and compatible marking remain with that theorem's assembly owner.
Source: Meierfrankenfeld--Stellmacher, *Pushing up weak BN-pairs of rank two*
(1993), (4.6.8), printed pp.905--907, especially claim (3) on p.906.
-/

public section

namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Flags.RankOne.BinaryAuxiliary.Moving.Nonquadratic.S4Model

private abbrev firstSwap : Actor := Equiv.swap 0 1
private abbrev secondSwap : Actor := Equiv.swap 2 3
private abbrev crossSwap : Actor := Equiv.swap 1 2
private abbrev coreGenerator (b : Bool) : Actor :=
  if b then Equiv.swap 0 2 * Equiv.swap 1 3 else firstSwap * secondSwap

/-- Representatives for the pairs 01, 02, 03, 12, 13, 23, respectively. -/
private def cosetRepresentative : Fin 6 → Actor := ![1, crossSwap, Equiv.swap 1 3, Equiv.swap 0 2,
  Equiv.swap 0 3, Equiv.swap 0 2 * Equiv.swap 1 3]

private def cosetIndex (p : Actor) : Fin 6 :=
  if p 0 = 0 ∨ p 1 = 0 then
    if p 0 = 1 ∨ p 1 = 1 then 0 else if p 0 = 2 ∨ p 1 = 2 then 1 else 2
  else if p 0 = 1 ∨ p 1 = 1 then
    if p 0 = 2 ∨ p 1 = 2 then 3 else 4
  else 5

/-- Every permutation differs from its pair representative by an element of E. -/
private lemma coset_remainder : ∀ p : Actor,
    (cosetRepresentative (cosetIndex p))⁻¹ * p = 1 ∨
    (cosetRepresentative (cosetIndex p))⁻¹ * p = firstSwap ∨
    (cosetRepresentative (cosetIndex p))⁻¹ * p = secondSwap ∨
    (cosetRepresentative (cosetIndex p))⁻¹ * p = firstSwap * secondSwap := by
  decide +kernel

private abbrev CoordinateSpace := Fin 6 → ZMod 2

private def basisVector (p : Actor) : CoordinateSpace := Pi.single (cosetIndex p) 1

private def quadraticRelation (a : Actor) : CoordinateSpace :=
  basisVector (a * firstSwap * secondSwap * crossSwap) -
    basisVector (a * firstSwap * crossSwap) -
    (basisVector (a * secondSwap * crossSwap) - basisVector (a * crossSwap))

private def tripleRelation (g : Actor) (b : Bool) (i : Fin 6) : CoordinateSpace :=
  basisVector (g * coreGenerator b * cosetRepresentative i) -
    basisVector (g * cosetRepresentative i) -
    (basisVector (coreGenerator b * cosetRepresentative i) - basisVector (cosetRepresentative i))

private def adjacentSwap (j : Fin 3) : Actor := Equiv.swap j.castSucc j.succ

/-- Only 3 × 2 × 6 vector identities are checked. Each vector has six binary
coordinates; the two nonzero quadratic relations and their sum suffice. -/
private lemma triple_certificate : ∀ (j : Fin 3) (b : Bool) (i : Fin 6),
    tripleRelation (adjacentSwap j) b i = 0 ∨
    tripleRelation (adjacentSwap j) b i = quadraticRelation 1 ∨
    tripleRelation (adjacentSwap j) b i = quadraticRelation crossSwap ∨
    tripleRelation (adjacentSwap j) b i = quadraticRelation 1 + quadraticRelation crossSwap := by
  decide +kernel

variable {W : Type*} [AddCommGroup W] [Module (ZMod 2) W]

private noncomputable def evaluate (ρ : Representation (ZMod 2) Actor W) (d : W) :
    CoordinateSpace →ₗ[ZMod 2] W where
  toFun x := ∑ i, x i • ρ (cosetRepresentative i) d
  map_add' x y := by simp [add_smul, Finset.sum_add_distrib]
  map_smul' c x := by simp [Finset.smul_sum, smul_smul]

private lemma evaluate_single (ρ : Representation (ZMod 2) Actor W) (d : W) (i : Fin 6) :
    evaluate ρ d (Pi.single i 1) = ρ (cosetRepresentative i) d := by
  simp [evaluate, Pi.single_apply]

private lemma firstSwap_mem : firstSwap ∈ firstCore := Subgroup.subset_closure (by simp)
private lemma secondSwap_mem : secondSwap ∈ firstCore := Subgroup.subset_closure (by simp)

private lemma representative_value (ρ : Representation (ZMod 2) Actor W)
    (d : W) (hd : ∀ a ∈ firstCore, ρ a d = d) (p : Actor) :
    ρ (cosetRepresentative (cosetIndex p)) d = ρ p d := by
  have hm : (cosetRepresentative (cosetIndex p))⁻¹ * p ∈ firstCore := by
    rcases coset_remainder p with h | h | h | h
    · rw [h]; exact firstCore.one_mem
    · rw [h]; exact firstSwap_mem
    · rw [h]; exact secondSwap_mem
    · rw [h]; exact firstCore.mul_mem firstSwap_mem secondSwap_mem
  have hv := congrArg (ρ (cosetRepresentative (cosetIndex p))) (hd _ hm)
  rw [← Module.End.mul_apply, ← map_mul, mul_inv_cancel_left] at hv
  exact hv.symm

private lemma evaluate_basisVector (ρ : Representation (ZMod 2) Actor W)
    (d : W) (hd : ∀ a ∈ firstCore, ρ a d = d) (p : Actor) :
    evaluate ρ d (basisVector p) = ρ p d := by
  exact (evaluate_single ρ d (cosetIndex p)).trans (representative_value ρ d hd p)

private lemma evaluate_quadraticRelation (ρ : Representation (ZMod 2) Actor W)
    (d : W) (hd : ∀ a ∈ firstCore, ρ a d = d)
    (hq : QuadraticOn ρ firstCore) (a : Actor) :
    evaluate ρ d (quadraticRelation a) = 0 := by
  have hz := congrArg (ρ a)
    (sub_eq_zero.mpr (hq firstSwap firstSwap_mem secondSwap secondSwap_mem (ρ crossSwap d)))
  simpa only [quadraticRelation, map_sub, evaluate_basisVector ρ d hd, map_mul, Module.End.mul_apply,
    map_zero] using hz

private lemma fixed_of_adjacent (ρ : Representation (ZMod 2) Actor W) (x : W)
    (hx : ∀ j : Fin 3, ρ (adjacentSwap j) x = x) (g : Actor) : ρ g x = x := by
  have hg : g ∈ Submonoid.closure (Set.range adjacentSwap) := by
    change g ∈ Submonoid.closure (Set.range fun j : Fin 3 => Equiv.swap j.castSucc j.succ)
    rw [Equiv.Perm.mclosure_swap_castSucc_succ]
    trivial
  induction hg using Submonoid.closure_induction with
  | mem a ha => obtain ⟨j, rfl⟩ := ha; exact hx j
  | one => simp
  | mul a b ha hb hax hbx =>
    rw [map_mul, Module.End.mul_apply, hbx, hax]

private lemma fixed_on_representative (ρ : Representation (ZMod 2) Actor W)
    (d : W) (hd : ∀ a ∈ firstCore, ρ a d = d)
    (hq : QuadraticOn ρ firstCore) (b : Bool) (i : Fin 6) (g : Actor) :
    ρ g (ρ (coreGenerator b) (ρ (cosetRepresentative i) d) - ρ (cosetRepresentative i) d) =
      ρ (coreGenerator b) (ρ (cosetRepresentative i) d) - ρ (cosetRepresentative i) d := by
  apply fixed_of_adjacent
  intro j
  have hz : evaluate ρ d (tripleRelation (adjacentSwap j) b i) = 0 := by
    rcases triple_certificate j b i with h | h | h | h
    · rw [h, map_zero]
    · rw [h, evaluate_quadraticRelation ρ d hd hq]
    · rw [h, evaluate_quadraticRelation ρ d hd hq]
    · rw [h, map_add, evaluate_quadraticRelation ρ d hd hq,
        evaluate_quadraticRelation ρ d hd hq, add_zero]
  apply sub_eq_zero.mp
  simpa only [tripleRelation, map_sub, evaluate_basisVector ρ d hd, map_mul, Module.End.mul_apply] using hz

private lemma fixed_on_orbitSpan (ρ : Representation (ZMod 2) Actor W)
    (D : Submodule (ZMod 2) W)
    (hD : ∀ a ∈ firstCore, ∀ d ∈ D, ρ a d = d)
    (hq : QuadraticOn ρ firstCore) (b : Bool) (g : Actor)
    {v : W} (hv : v ∈ orbitSpan ρ D) :
    ρ g (ρ (coreGenerator b) v - v) = ρ (coreGenerator b) v - v := by
  refine Submodule.iSup_induction (fun a : Actor => D.map (ρ a))
    (motive := fun v => ρ g (ρ (coreGenerator b) v - v) = ρ (coreGenerator b) v - v) hv ?_ ?_ ?_
  · rintro a _ ⟨d, hd, rfl⟩
    rw [← representative_value ρ d (fun a ha => hD a ha d hd) a]
    exact fixed_on_representative ρ d (fun a ha => hD a ha d hd) hq b (cosetIndex a) g
  · simp
  · intro x y hx hy
    simp only [map_add, add_sub_add_comm, hx, hy]

/-- In a binary S4-module generated by an E-fixed subspace, quadratic action
of E forces every K-displacement to be fixed by all of S4. Here E is the
nonnormal four-group `firstCore` and K is the normal four-group `oppositeCore`.
This is the universal calculation required by the source nonquadraticity
assembly for MS93 (4.6.8). -/
theorem displacementsFixed_of_quadratic (ρ : Representation (ZMod 2) Actor W)
    (D : Submodule (ZMod 2) W)
    (hD : ∀ a ∈ firstCore, ∀ d ∈ D, ρ a d = d)
    (hspan : orbitSpan ρ D = ⊤) (hq : QuadraticOn ρ firstCore) :
    DisplacementsFixed ρ oppositeCore := by
  have hb (b : Bool) (g : Actor) (v : W) :
      ρ g (ρ (coreGenerator b) v - v) = ρ (coreGenerator b) v - v :=
    fixed_on_orbitSpan ρ D hD hq b g (by rw [hspan]; trivial)
  suffices ∀ k ∈ oppositeCore, ∀ g : Actor, ∀ v : W,
      ρ g (ρ k v - v) = ρ k v - v from fun g k hk v => this k hk g v
  intro x hx
  induction hx using Subgroup.closure_induction with
  | mem x hx =>
    rcases hx with h | h
    · subst x; exact hb false
    · rw [Set.mem_singleton_iff] at h
      subst x; exact hb true
  | one => intro g v; simp
  | mul x y hx hy ihx ihy =>
    intro g v
    calc
      ρ g (ρ (x * y) v - v) =
          ρ g ((ρ x (ρ y v) - ρ y v) + (ρ y v - v)) := by
        rw [sub_add_sub_cancel, map_mul, Module.End.mul_apply]
      _ = (ρ x (ρ y v) - ρ y v) + (ρ y v - v) := by
        rw [map_add, ihx, ihy]
      _ = ρ (x * y) v - v := by
        rw [sub_add_sub_cancel, map_mul, Module.End.mul_apply]
  | inv x hx ih =>
    intro g v
    have he : ρ x (ρ x⁻¹ v) = v := by
      rw [← Module.End.mul_apply, ← map_mul, mul_inv_cancel, map_one, Module.End.one_apply]
    have h := congrArg Neg.neg (ih g (ρ x⁻¹ v))
    rw [he] at h
    simpa only [← map_neg, neg_sub] using h

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Flags.RankOne.BinaryAuxiliary.Moving.Nonquadratic.S4Model
