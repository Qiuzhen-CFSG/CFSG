module
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Flags.RankOne.Triple.Preparatory.Propagation.Pairing.Module.Transport.Orientation
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.Escape.PairingControl.FirstPairing.Orientation.QuotientApplication.Verification.NaturalGeneration.Model.Construction
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.Escape.PairingControl.FirstPairing.Orientation.QuotientApplication.Verification.NaturalGeneration.Transport

/-!
# The literal natural two-space on a transported index-two seed

A seed of index two over N is generated by N and one element. If the opposite
parabolic fixes it modulo N, that parabolic normalizes the seed, and adjoining
N to its closure of the chosen element recovers exactly the original seed.
The existing natural-plane construction therefore applies to the actual local
closure. Its actor is the untilded residual: its projection onto the model
parabolic is proved using finite residual transport and the symmetric-four
model. The kernel stays the global fixed preimage, with no fixed summand lost.

Source: Meierfrankenfeld--Stellmacher (1993), (4.6.8)(2), printed p.906,
using the natural-plane construction of (1.7), pp.847--848.
-/

@[expose] public section
open Subgroup
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Flags.RankOne.Propagation.Pairing
open RankOnePairing RankOnePairing.Incidence
open RankOnePairing.Incidence.FixedGeometry.ValueConstruction
open RankOnePairing.Incidence.FixedGeometry.ValueConstruction.ModelProof
open Escape.PairingControl.FirstPairing.Orientation.QuotientApplication.NaturalGeneration

private theorem residual_map_surjective {A B : Type*} [Group A] [Finite A] [Group B]
    (f : A →* B) (hf : Function.Surjective f) :
    (primeToResidual 2 A).map f = primeToResidual 2 B := by
  apply le_antisymm (map_primeToResidual_le f hf)
  let : ((primeToResidual 2 A).map f).Normal := Normal.map inferInstance f hf
  exact primeToResidual_le _ ((primeToResidual_index_coprime (G := A) 2).coprime_dvd_right
    ((primeToResidual 2 A).index_map_dvd hf))

private theorem localResidual_map_hom {A B : Type*} [Group A] [Finite A] [Group B]
    (P : Subgroup A) (f : A →* B) :
    (localResidual P).map f = localResidual (P.map f) := by
  calc
    _ = ((primeToResidual 2 P).map (f.subgroupMap P)).map (P.map f).subtype := by
      rw [localResidual, map_map, map_map]
      rfl
    _ = _ := by
      rw [residual_map_surjective _ (f.subgroupMap_surjective P)]
      rfl

private theorem model_primeToResidual_top (flag : SL) (i : Bool) :
    primeToResidual 2 (modelParabolic flag i) = ⊤ := by
  have hs : primeToResidual 2 (Equiv.Perm (Fin 4)) = ⊤ := by
    apply top_unique
    intro x _
    refine Equiv.Perm.swap_induction_on x (primeToResidual 2 _).one_mem ?_
    intro y a b _ hy
    apply (primeToResidual 2 _).mul_mem _ hy
    apply mem_primeToResidual_of_pow (n := 1)
    simp [pow_two]
  let f := modelParabolicEquivSymmetric flag i
  apply Subgroup.map_injective (f := f.toMonoidHom) f.injective
  rw [map_primeToResidual, hs, map_top_of_surjective _ f.surjective]

namespace SplitLineData
variable {G : Type*} [Group G] [Finite G] {π : G →* SL} {flag : SL} {j : Bool}
  {H N X : Subgroup G} (d : SplitLineData π flag j H N X)
include d

/-- The untilded residual covers the full specified model parabolic. -/
theorem residual_image (i : Bool) :
    (localResidual (parabolic π flag i)).map π = modelParabolic flag i := by
  rw [localResidual_map_hom, d.parabolic_image, localResidual,
    model_primeToResidual_top, ← MonoidHom.range_eq_map, range_subtype]

omit [Finite G] in
/-- N belongs to the actual globally fixed preimage. -/
theorem denominator_le_fixed :
    letI := d.sectionData.normal_kernel
    N ≤ centralizerModulo H ⊤ N := by
  let := d.sectionData.normal_kernel
  intro x hx
  exact mem_centralizerModulo_iff.mpr ⟨d.sectionData.kernel_le hx, fun a ha =>
    commutator_le_right (⊤ : Subgroup G) N (commutator_mem_commutator ha hx)⟩

omit d [Finite G] in
private theorem kernel_le_parabolic (i : Bool) : π.ker ≤ parabolic π flag i := by
  intro a ha
  change π a ∈ modelParabolic flag i
  rw [MonoidHom.mem_ker.mp ha]
  exact one_mem _

/-- A nonzero index-two seed fixed by the opposite parabolic generates the
natural two-space, with the literal closure and global fixed denominator. -/
theorem rankOneFactor_of_fixed (Y : Subgroup G)
    (hNY : N ≤ Y) (hYH : Y ≤ H) (hYker : Y ≤ π.ker)
    (hindex : N.relIndex Y = 2) (hne : d.image Y ≠ ⊥)
    (hfix : ⁅Y, parabolic π flag (!j)⁆ ≤ N) :
    letI := d.sectionData.normal_kernel
    Nonempty (RankOneFactor (localResidual (parabolic π flag j))
      (localGenerated (parabolic π flag j) Y) (centralizerModulo H ⊤ N)) := by
  let := d.sectionData.normal_kernel
  let C := centralizerModulo H ⊤ N
  obtain ⟨x, hx, _, hcases⟩ := relIndex_eq_two_iff_exists_notMem_and.mp hindex
  have hgen : Y = N ⊔ zpowers x := by
    apply le_antisymm
    · intro y hy
      rcases hcases y hy with h | h
      · have hh := (N ⊔ zpowers x).mul_mem (mem_sup_left h)
          (mem_sup_right (inv_mem (mem_zpowers x)))
        simpa only [mul_inv_cancel_right] using hh
      · exact mem_sup_left h
    · exact sup_le hNY (zpowers_le.mpr hx)
  have hnonzero : d.coordinates.coordinates ⟨x, hYH hx⟩ ≠ 1 := by
    intro he
    have hxC : x ∈ C := by
      have hh : (⟨x, hYH hx⟩ : H) ∈ d.coordinates.coordinates.ker := he
      rw [d.coordinates.kernel] at hh
      exact hh
    have hYC : Y ≤ C := by
      rw [hgen]
      exact sup_le d.denominator_le_fixed (zpowers_le.mpr hxC)
    apply hne
    rw [image, Subgroup.map_eq_bot_iff]
    intro y hy
    rw [d.coordinates.kernel]
    exact hYC hy
  have hxfixed : ∀ a ∈ modelParabolic flag (!j),
      (d.coordinates.marking a).val.mulVec
        (d.coordinates.coordinates ⟨x, hYH hx⟩).toAdd =
        (d.coordinates.coordinates ⟨x, hYH hx⟩).toAdd := by
    intro a ha
    obtain ⟨p, hp, rfl⟩ := (show a ∈ (parabolic π flag (!j)).map π by
      rw [d.parabolic_image]; exact ha)
    exact (d.image_fixed_iff Y _ hYH).mpr hfix
      (mem_map_of_mem _ hx) _ (mem_map_of_mem _ (mem_map_of_mem _ hp))
  let s : NaturalSeedData π flag (!j) H C N x := {
    natural := d.coordinates
    projection_surjective := d.surjective
    residual_image := d.residual_image
    fixed_le_group := centralizerModulo_le _ _ _
    z_le_fixed := d.denominator_le_fixed
    z_le_kernel := d.denominator_le_seed.trans d.seed_le_kernel
    element_mem := hYH hx
    element_kernel := hYker hx
    nonzero := hnonzero
    fixed := hxfixed }
  have hseed : s.seed = Y := by
    apply le_antisymm
    · apply sup_le hNY
      exact localGenerated_le_of_normalizes _ _ Y
        (le_normalizer_iff_commutator_le_left.mpr (hfix.trans hNY)) (zpowers_le.mpr hx)
    · rw [hgen]
      apply sup_le le_sup_left
      exact (le_localGenerated _ _
        ((zpowers_le.mpr (hYker hx)).trans (kernel_le_parabolic (!j)))).trans le_sup_right
  obtain ⟨c⟩ := planeCoordinates_nonempty s.natural.marking flag (!j) s.vector
    s.nonzero s.fixed
  have result := s.rankOneFactor_nonempty c
  simpa only [Bool.not_not, hseed] using result

end SplitLineData
end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Flags.RankOne.Propagation.Pairing
