module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Flags.Basic

/-!
# The elementary layer at the holomorph end of an edge

The radius-two subgroup at a holomorph vertex is exactly the span of the
Z-layers at its neighbors: any remaining generator is contained in the
Z-layer of an intermediate M-vertex. This span lies in the radius subgroup
at every adjacent M-vertex. Its generators commute because their mutual
distances are at most two, below the critical distance. Involution generation
then proves that the edge layer is elementary abelian.

The actual holomorph conjugation realizes every automorphism of R. Hence
the pullback of V_beta to R is characteristic, and the image of N_M(R)
normalizes V_beta. This supplies the genuine local action for the source
U_delta1 = V_beta once its marked parabolic core is identified with R.

Source: MS93 (1993), notation on p.855 and the flag construction and
abelian edge layers in (4.6.8), printed pp.905--908.
-/

@[expose] public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Flags.RankOne
variable {M : Type*} [Group M] {R : Subgroup M}

/-- The subgroup generated by Z at every neighbor of b. -/
noncomputable def neighborSpan (b : Vertex R) : Subgroup (FreeAmalgam R) :=
  ⨆ t, ⨆ (_ : Adjacent R b t), Z R t

/-- The holomorph radius layer is exactly the span of neighboring M-vertex Z-layers. -/
theorem V_eq_neighborSpan (a b : Vertex R) (ha : color R a = false)
    (hab : Adjacent R a b) : V R b = neighborSpan b := by
  have hb : color R b = true := by
    have hh := adjacent_color_ne R hab
    cases hcol : color R b <;> simp_all
  have hZb : Z R b ≤ neighborSpan b :=
    (edge_Z_le a b ha hab).trans
      (le_iSup_of_le a (le_iSup_of_le (adjacent_symm R hab) le_rfl))
  apply le_antisymm
  · apply iSup_le
    intro t
    apply iSup_le
    intro ht
    by_cases h0 : (cosetGraph R).dist t b = 0
    · have he := (cosetGraph_connected R).dist_eq_zero_iff.mp h0
      simpa only [he] using hZb
    by_cases h1 : (cosetGraph R).dist t b = 1
    · exact le_iSup_of_le t (le_iSup_of_le
        (adjacent_symm R ((cosetGraph_adj R _ _).mp
          (SimpleGraph.dist_eq_one_iff_adj.mp h1))) le_rfl)
    have h2 : (cosetGraph R).dist t b = 2 := by omega
    have hed : (cosetGraph R).edist t b = 2 := by
      rw [← ((cosetGraph_connected R) t b).coe_dist_eq_edist, h2]
      rfl
    obtain ⟨c, htc, hbc⟩ := (SimpleGraph.edist_eq_two_iff.mp hed).2.2
    have hbc' := (cosetGraph_adj R _ _).mp hbc
    have hc : color R c = false := by
      have hh := adjacent_color_ne R hbc'
      cases hcol : color R c <;> simp_all
    exact (edge_Z_le c t hc (adjacent_symm R ((cosetGraph_adj R _ _).mp htc))).trans
      (le_iSup_of_le c (le_iSup_of_le hbc' le_rfl))
  · apply iSup_le
    intro t
    apply iSup_le
    intro ht
    apply le_iSup_of_le t
    apply le_iSup_of_le (show (cosetGraph R).dist t b ≤ 2 from ?_)
    · exact le_rfl
    · have h := SimpleGraph.dist_eq_one_iff_adj.mpr
        ((cosetGraph_adj R _ _).mpr (adjacent_symm R ht))
      omega

/-- The holomorph radius layer lies in the radius layer at every adjacent M-vertex. -/
theorem edgeRadius_le_radius (a b : Vertex R) (ha : color R a = false)
    (hab : Adjacent R a b) : V R b ≤ V R a := by
  rw [V_eq_neighborSpan a b ha hab]
  apply iSup_le
  intro t
  apply iSup_le
  intro ht
  apply le_iSup_of_le t
  apply le_iSup_of_le (show (cosetGraph R).dist t a ≤ 2 from ?_)
  · exact le_rfl
  · have htb := SimpleGraph.dist_eq_one_iff_adj.mpr
      ((cosetGraph_adj R _ _).mpr (adjacent_symm R ht))
    have hba := SimpleGraph.dist_eq_one_iff_adj.mpr
      ((cosetGraph_adj R _ _).mpr (adjacent_symm R hab))
    have htri := (cosetGraph_connected R).dist_triangle (u := t) (v := b) (w := a)
    omega

/-- Two generators at neighbors of a holomorph vertex have distance less than b. -/
theorem edgeRadius_abelian (geometry : Geometry R) (hlarge : 2 < geometry.b R)
    (a b : Vertex R) (ha : color R a = false) (hab : Adjacent R a b) :
    IsMulCommutative (V R b) := by
  have hb : color R b = true := by
    have hh := adjacent_color_ne R hab
    cases hcol : color R b <;> simp_all
  have htcol (t : Vertex R) (ht : Adjacent R b t) : color R t = false := by
    have hh := adjacent_color_ne R ht
    cases hcol : color R t <;> simp_all
  apply le_centralizer_iff_isMulCommutative.mp
  rw [V_eq_neighborSpan a b ha hab]
  apply iSup_le
  intro t
  apply iSup_le
  intro ht
  apply le_centralizer_iff.mpr
  apply iSup_le
  intro s
  apply iSup_le
  intro hs
  have hZ : Z R s ≤ Q R t := by
    apply Z_le_Q_of_dist_lt R s (geometry.exists_critical s (htcol s hs))
    rw [geometry.distance_constant s (htcol s hs)]
    apply lt_of_le_of_lt _ hlarge
    have hsb := SimpleGraph.dist_eq_one_iff_adj.mpr
      ((cosetGraph_adj R _ _).mpr (adjacent_symm R hs))
    have hbt := SimpleGraph.dist_eq_one_iff_adj.mpr
      ((cosetGraph_adj R _ _).mpr ht)
    have htri := (cosetGraph_connected R).dist_triangle (u := s) (v := b) (w := t)
    omega
  exact hZ.trans (le_centralizer_iff.mp
    (commutator_eq_bot_iff_le_centralizer.mp (geometry.centralizes t (htcol t ht))))

/-- The source U_delta1 = V_beta is elementary abelian. -/
theorem edgeRadius_elementary (geometry : Geometry R) (hlarge : 2 < geometry.b R)
    (a b : Vertex R) (ha : color R a = false) (hab : Adjacent R a b) :
    IsElementaryAbelian 2 (V R b) := by
  let := edgeRadius_abelian geometry hlarge a b ha hab
  let : IsElementaryAbelian 2 (omega₁ (V R b) (p := 2)) :=
    IsElementaryAbelian.omega₁_of_isMulCommutative (V R b)
  have hE : IsElementaryAbelian 2 (omegaOneAmbient (V R b)) :=
    IsElementaryAbelian.map (V R b).subtype
  have hV : omegaOneAmbient (V R b) = V R b := DistanceEight.VBall_omegaOne R b 2
  rwa [hV] at hE

private theorem embedS_aut_conj (a : MulAut R) (r : R) :
    embedS R (a r) = embedH R (SemidirectProduct.inr a) * embedS R r *
      (embedH R (SemidirectProduct.inr a))⁻¹ := by
  have h := congrArg (embedH R) (SemidirectProduct.inl_aut a r)
  have hcomp (t : R) : embedH R (SemidirectProduct.inl t) = embedS R t :=
    DFunLike.congr_fun (embedH_comp_inl R) t
  simpa only [MonoidHom.id_apply, map_mul, map_inv, hcomp] using h

/-- The holomorph realizes every automorphism of R, preserving the actual radius layer. -/
theorem edgeRadius_comap_characteristic :
    ((V R (beta R)).comap (embedS R)).Characteristic := by
  have hn : Hbar R ≤ normalizer (V R (beta R) : Set (FreeAmalgam R)) := by
    simpa only [beta, stabilizer_h_base] using DistanceEight.V_normalized R (beta R)
  rw [characteristic_iff_map_eq]
  intro a
  apply le_antisymm
  · rintro _ ⟨x, hx, rfl⟩
    change embedS R (a x) ∈ V R (beta R)
    rw [embedS_aut_conj]
    exact le_normalizer_iff.mp hn _ ⟨SemidirectProduct.inr a, rfl⟩ _ hx
  · intro x hx
    refine ⟨a⁻¹ x, ?_, by simp⟩
    change embedS R (a⁻¹ x) ∈ V R (beta R)
    rw [embedS_aut_conj]
    exact le_normalizer_iff.mp hn _ ⟨SemidirectProduct.inr a⁻¹, rfl⟩ _ hx

/-- The actual normalizer of R acts on its characteristic edge-radius subgroup. -/
theorem edgeRadius_normalized_by_edgeNormalizer [Finite M]
    (geometry : Geometry R) (hlarge : 2 < geometry.b R) :
    (normalizer (R : Set M)).map (embedM R) ≤
      normalizer (V R (beta R) : Set (FreeAmalgam R)) := by
  have hab : Adjacent R (alpha R) (beta R) :=
    (adjacent_iff_exists_common R _ _).mpr ⟨1, Or.inl ⟨rfl, rfl⟩⟩
  have hVS : V R (beta R) ≤ (embedS R).range := by
    have h := ((edgeRadius_le_radius (alpha R) (beta R) rfl hab).trans
      (V_le_Q geometry hlarge (alpha R) rfl)).trans (Q_le_adjacent_h R rfl hab)
    simpa only [beta, neighborhoodKernel_h_base_eq_Sbar, Sbar] using h
  let K := (V R (beta R)).comap (embedS R)
  let : K.Characteristic := edgeRadius_comap_characteristic
  have hmap : K.map (embedS R) = V R (beta R) := by
    dsimp only [K]
    rw [map_comap_eq]
    exact inf_eq_right.mpr hVS
  have h := (map_mono (f := embedM R)
    (normalizer_le_normalizer_characteristic_image R K)).trans
      (le_normalizer_map (embedM R))
  rwa [map_map, embedM_comp_subtype, hmap] at h

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Flags.RankOne
