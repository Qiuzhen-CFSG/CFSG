module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Setup.Covariance
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Setup.CommonFacts
public import Theory.ElementaryAbelian.AbelianNormalClosure

/-!
# The elementary fixed factor in the MS93 distance-eight branch

A subgroup generated by involutions has elementary abelian commutators whenever
those commutators are central in a local overgroup. For each fixed actor, the
commutator map is a homomorphism; its involution generators land in the
omega-center. The universal property of omega-one then handles every generator
of the commutator subgroup. No order calculation is used to infer exponent two.

The actual MS93 radius groups are generated by the elementary edge omega-centers.
Conjugation covariance normalizes the radius-two group, so its moving part lies
inside it and H_alpha lies in [V_alpha,Q_alpha]. Thus the centrality conclusion
of (4.4) implies elementary abelianness of H_alpha. The final comparisons use
embedM and its injectivity to pull this factor back to the original reduced M.

All centrality assumptions below are explicit. This file does not prove (4.4),
the order-four conclusion, or the core-center identification of (4.5).
Those source arguments must still be supplied before this branch is complete.

Source: Meierfrankenfeld--Stellmacher, Pushing up weak BN-pairs of rank two
(1993), (4.4)--(4.5), printed pp.890--900; the extra elementary-abelian deduction
is the central-commutator argument needed for the binary application.
-/

public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
open scoped commutatorElement
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight

private theorem center_image_commutes {G : Type*} [Group G] {P : Subgroup G}
    {x y : G} (hx : x ∈ (center P).map P.subtype) (hy : y ∈ P) : y * x = x * y := by
  obtain ⟨z, hz, rfl⟩ := hx
  exact congrArg Subtype.val ((mem_center_iff.mp hz) ⟨y, hy⟩)

/-- Central commutators of an involution-generated subgroup lie in the local omega-center. -/
theorem commutator_le_omegaCenter_of_omegaOne_eq_self
    {G : Type*} [Group G] (A B P : Subgroup G)
    (hAP : A ≤ P) (hA : omegaOneAmbient A = A)
    (hc : ⁅A, B⁆ ≤ (center P).map P.subtype) :
    ⁅A, B⁆ ≤ omegaCenter P := by
  apply commutator_le.mpr
  intro a ha b hb
  let f : A →* G := {
    toFun := fun x => ⁅(x : G), b⁆
    map_one' := by simp
    map_mul' := by
      intro x y
      change ⁅(x : G) * (y : G), b⁆ = ⁅(x : G), b⁆ * ⁅(y : G), b⁆
      rw [commutatorElement_mul_left_eq_conj_mul,
        center_image_commutes (hc (commutator_mem_commutator y.property hb)) (hAP x.property),
        mul_inv_cancel_right]
      exact (center_image_commutes (hc (commutator_mem_commutator y.property hb))
        (map_subtype_le _ (hc (commutator_mem_commutator x.property hb)))).symm }
  let K := ((omegaCenter P).comap f).map A.subtype
  have hAK : A ≤ K := by
    rw [← hA]
    apply (omegaOneAmbient_le_iff A K).mpr
    intro x hx hp
    refine ⟨⟨x, hx⟩, ?_, rfl⟩
    change f ⟨x, hx⟩ ∈ omegaCenter P
    apply mem_omegaCenter_iff.mpr
    have hfx : f ⟨x, hx⟩ ∈ (center P).map P.subtype :=
      hc (commutator_mem_commutator hx hb)
    refine ⟨map_subtype_le _ hfx, ?_, fun y hy => center_image_commutes hfx hy⟩
    have hp' : (⟨x, hx⟩ : A) ^ 2 = 1 := Subtype.ext hp
    rw [← map_pow, hp', map_one]
  obtain ⟨x, hx, hxa⟩ := hAK ha
  have hxeq : x = (⟨a, ha⟩ : A) := Subtype.ext hxa
  subst x
  exact hx

/-- The relative form: the commutator is elementary abelian in the original ambient group. -/
theorem elementary_commutator_of_omegaOne_eq_self
    {G : Type*} [Group G] (A B P : Subgroup G)
    (hAP : A ≤ P) (hA : omegaOneAmbient A = A)
    (hc : ⁅A, B⁆ ≤ (center P).map P.subtype) :
    IsElementaryAbelian 2 (⁅A, B⁆ : Subgroup G) := by
  let := omegaCenter_elementary P
  exact IsElementaryAbelian.of_le
    (commutator_le_omegaCenter_of_omegaOne_eq_self A B P hAP hA hc)

/-- An involution-generated subgroup has elementary abelian central commutators. -/
theorem elementary_central_commutator_of_omegaOne_eq_self
    {G : Type*} [Group G] (A B : Subgroup G)
    (hA : omegaOneAmbient A = A) (hc : ⁅A, B⁆ ≤ center G) :
    IsElementaryAbelian 2 (⁅A, B⁆ : Subgroup G) := by
  apply elementary_commutator_of_omegaOne_eq_self A B ⊤ le_top hA
  intro x hx
  refine ⟨⟨x, mem_top x⟩, ?_, rfl⟩
  apply mem_center_iff.mpr
  intro y
  exact Subtype.ext ((mem_center_iff.mp (hc hx)) y)

private theorem omegaOne_iSup {G : Type*} [Group G] {ι : Sort*} (A : ι → Subgroup G)
    (hA : ∀ i, omegaOneAmbient (A i) = A i) :
    omegaOneAmbient (⨆ i, A i) = ⨆ i, A i := by
  apply le_antisymm (omegaOneAmbient_le _)
  apply iSup_le
  intro i
  rw [← hA i]
  exact omegaOneAmbient_mono (le_iSup A i)

variable {M : Type*} [Group M] (R : Subgroup M)

/-- Every actual Z-layer is generated by involutions, directly from its edge omega-centers. -/
theorem Z_omegaOne (a : Vertex R) : omegaOneAmbient (Z R a) = Z R a := by
  classical
  have he (b : Vertex R) : omegaOneAmbient (edgeOmega R b) = edgeOmega R b := by
    change omegaOneAmbient (omegaCenter (Q R b)) = omegaCenter (Q R b)
    let := omegaCenter_elementary (Q R b)
    exact omegaOneAmbient_eq_self _
  rw [Z]
  split_ifs
  · exact omegaOne_iSup _ (fun b => omegaOne_iSup _ (fun _ => he b))
  · exact he a

/-- Every radius subgroup is generated by involutions; no commutativity of the radius group is assumed. -/
theorem VBall_omegaOne (a : Vertex R) (i : ℕ) :
    omegaOneAmbient (VBall R a i) = VBall R a i :=
  omegaOne_iSup _ (fun b => omegaOne_iSup _ (fun _ => Z_omegaOne R b))

/-- The actual local stabilizer normalizes its radius-two subgroup. -/
theorem V_normalized (a : Vertex R) :
    stabilizer R a ≤ normalizer (V R a : Set (FreeAmalgam R)) := by
  intro g hg
  rw [mem_normalizer_iff_map_conj_eq]
  change (V R a).map (MulAut.conj g).toMonoidHom = V R a
  have hh := V_act R g⁻¹ a
  have hga : act R g⁻¹ a = a := (stabilizer R a).inv_mem hg
  simpa only [hga, inv_inv] using hh.symm

/-- The moving part of the radius-two subgroup lies in that subgroup. -/
theorem Vcirc_le_V (a : Vertex R) : Vcirc R a ≤ V R a :=
  le_normalizer_iff_commutator_le_left.mp
    ((map_subtype_le _).trans (V_normalized R a))

/-- The fixed factor H is contained in the full radius-two commutator with Q. -/
theorem H_le_commutator (a : Vertex R) : H R a ≤ ⁅V R a, Q R a⁆ :=
  commutator_mono (Vcirc_le_V R a) le_rfl

/-- The centrality clause of (4.4) implies elementary abelianness of the actual H. -/
theorem H_elementary_of_central (a : Vertex R)
    (hV : V R a ≤ stabilizer R a)
    (hc : ⁅V R a, Q R a⁆ ≤ (center (stabilizer R a)).map (stabilizer R a).subtype) :
    IsElementaryAbelian 2 (H R a) := by
  let := elementary_commutator_of_omegaOne_eq_self (V R a) (Q R a) (stabilizer R a)
    hV (VBall_omegaOne R a 2) hc
  exact IsElementaryAbelian.of_le (H_le_commutator R a)

/-- The same centrality clause places H in the center of its vertex stabilizer. -/
theorem H_le_localCenter_of_central (a : Vertex R)
    (hc : ⁅V R a, Q R a⁆ ≤ (center (stabilizer R a)).map (stabilizer R a).subtype) :
    H R a ≤ (center (stabilizer R a)).map (stabilizer R a).subtype :=
  (H_le_commutator R a).trans hc

/-- Pulling H_alpha back along embedM puts it in the center of the reduced M. -/
theorem H_alpha_comap_le_center
    (hc : ⁅V R (alpha R), Q R (alpha R)⁆ ≤
      (center (stabilizer R (alpha R))).map (stabilizer R (alpha R)).subtype) :
    (H R (alpha R)).comap (embedM R) ≤ center M := by
  intro x hx
  rw [mem_center_iff]
  intro y
  apply embedM_injective R
  have hy : embedM R y ∈ stabilizer R (alpha R) := by
    rw [alpha, stabilizer_m_base]
    exact ⟨y, rfl⟩
  simpa only [map_mul] using
    center_image_commutes ((H_le_localCenter_of_central R (alpha R) hc) hx) hy

/-- The pullback of H_alpha maps back to exactly H_alpha, with the original embedding. -/
theorem H_alpha_comap_map
    (hc : ⁅V R (alpha R), Q R (alpha R)⁆ ≤
      (center (stabilizer R (alpha R))).map (stabilizer R (alpha R)).subtype) :
    ((H R (alpha R)).comap (embedM R)).map (embedM R) = H R (alpha R) := by
  rw [map_comap_eq]
  apply inf_eq_right.mpr
  have hh := (H_le_localCenter_of_central R (alpha R) hc).trans (map_subtype_le _)
  rw [alpha, stabilizer_m_base] at hh
  exact hh

/-- The local component normalizes Z, so its moving part U lies in Z. -/
theorem U_le_Z (a : Vertex R) : U R a ≤ Z R a :=
  le_normalizer_iff_commutator_le_left.mp
    ((map_subtype_le _).trans (Z_normalized R a))

/-- The common X = Z conclusion makes the moving natural layer elementary abelian. -/
theorem U_elementary {L : Subgroup M} {source : LocalSource L R}
    {geometry : Geometry R} (common : CommonFacts R source geometry) :
    IsElementaryAbelian 2 (U R (alpha R)) := by
  have hZ : Z R (alpha R) = omegaCenter (Q R (alpha R)) :=
    (common.X_eq_Z (alpha R) rfl).symm
  let := omegaCenter_elementary (Q R (alpha R))
  exact IsElementaryAbelian.of_le ((U_le_Z R (alpha R)).trans hZ.le)

/-- The actual natural-module isomorphism gives order eight for U_alpha. -/
theorem U_card {π : M →* SL} (natural : NaturalU R π) :
    Nat.card (U R (alpha R)) = 8 := by
  calc
    Nat.card (U R (alpha R)) = Nat.card (Multiplicative (Fin 3 → ZMod 2)) :=
      Nat.card_congr natural.equiv.toEquiv
    _ = 8 := by simp [Nat.card_eq_fintype_card]

/-- Specialize the elementary fixed-factor argument using the common local containment. -/
theorem H_alpha_elementary_of_central
    {L : Subgroup M} {source : LocalSource L R} {geometry : Geometry R}
    (common : CommonFacts R source geometry)
    (hc : ⁅V R (alpha R), Q R (alpha R)⁆ ≤
      (center (stabilizer R (alpha R))).map (stabilizer R (alpha R)).subtype) :
    IsElementaryAbelian 2 (H R (alpha R)) :=
  H_elementary_of_central R (alpha R)
    (geometry.V_local (alpha R) rfl common.large_distance) hc

/-- The fixed factor inside the reduced M is elementary abelian under the same explicit centrality input. -/
theorem H_alpha_comap_elementary_of_central
    {L : Subgroup M} {source : LocalSource L R} {geometry : Geometry R}
    (common : CommonFacts R source geometry)
    (hc : ⁅V R (alpha R), Q R (alpha R)⁆ ≤
      (center (stabilizer R (alpha R))).map (stabilizer R (alpha R)).subtype) :
    IsElementaryAbelian 2 ((H R (alpha R)).comap (embedM R)) := by
  let := H_alpha_elementary_of_central R common hc
  refine {
    toIsMulCommutative := IsMulCommutative.of_comm (fun x y => Subtype.ext
      ((mem_center_iff.mp (H_alpha_comap_le_center R hc y.property)) x))
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr ?_ }
  intro x
  apply Subtype.ext
  apply embedM_injective R
  simpa only [Subgroup.coe_pow, Subgroup.coe_one, map_pow, map_one] using
    elemPow_eq_one_of_isElementaryAbelian (p := 2) (A := H R (alpha R))
      (embedM R (x : M)) x.property

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight
