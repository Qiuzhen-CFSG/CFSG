module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Early.EdgeStructure.Containment.AbelianSpans.Offender.SpanAction.Basic


/-!
# Opposite-span offenders on the literal central quotients

Write W₁ = neighborSpan a d and W₀ = neighborSpan e r for the paired spans.
Both lie in the common edge kernel. Their images in the opposite local
quotients have orders n₀ = |W₀ : W₀ ∩ Qₐ| and n₁ = |W₁ : W₁ ∩ Qₑ|.
The derived-line containments kill the commutators of these images; since
the spans are generated by involutions, both images are elementary abelian.
The two escape assertions make them nontrivial.

The crossing commutators imply that the image of W₁ ∩ Qₑ in W₁/Z(W₁)
is fixed by W₀, and conversely. Thus the respective fixed indices are at
most n₁ and n₀. Choosing n₁ ≤ n₀ or n₀ ≤ n₁ gives an offender on one of
the two actual central quotients. The linearization step works directly
on this quotient carrier, preserving the displayed projection image.

The faithful central actions are explicit inputs supplied by
`pairedSpanCentralActions_nonempty`. Neither abelianness of the spans nor
self-duality, module classification, or FF exclusion enters this comparison.

Source: Meierfrankenfeld--Stellmacher, Pushing up weak BN-pairs of rank two
(1993), the opposite-span index comparison in (4.6.4), printed p.902.
-/

public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Early.Containment.SpanOffender
namespace FFBound

variable {G H Y : Type*} [Group G] [Group H] [Group Y]

private def fixed (f : H →* MulAut Y) (A : Subgroup H) : Subgroup Y :=
  letI := MulDistribMulAction.compHom Y (f.comp A.subtype)
  FixedPoints.subgroup A Y

private theorem linearize_isOffender [Finite Y] [IsElementaryAbelian 2 Y]
    (f : H →* MulAut Y) (A : Subgroup H) [Finite A] [IsElementaryAbelian 2 A]
    (hne : A ≠ ⊥) (hb : (fixed f A).index ≤ Nat.card A) :
    Representation.BinaryOffender.IsOffender (Offenders.linearize f) A := by
  let e : Representation.BinaryOffender.fixedSpace (Offenders.linearize f) A ≃ fixed f A := {
    toFun := fun v => ⟨v.val.toMul, fun a => congrArg Additive.toMul (v.property a)⟩
    invFun := fun y => ⟨Additive.ofMul y.val, fun a => congrArg Additive.ofMul (y.property a)⟩
    left_inv := fun _ => rfl
    right_inv := fun _ => rfl }
  have hcard : Nat.card Y ≤ Nat.card (fixed f A) * Nat.card A := by
    rw [← (fixed f A).card_mul_index]
    exact Nat.mul_le_mul_left _ hb
  rw [← Nat.card_congr e] at hcard
  have hVcard := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := Additive Y)
  have hFcard := Module.natCard_eq_pow_finrank (K := ZMod 2)
    (V := Representation.BinaryOffender.fixedSpace (Offenders.linearize f) A)
  rw [Nat.card_zmod] at hVcard hFcard
  have hAcard : Nat.card A = 2 ^ Representation.BinaryOffender.rank A := by
    obtain ⟨n, hn⟩ := (IsElementaryAbelian.isPGroup 2 A).exists_card_eq
    unfold Representation.BinaryOffender.rank
    rw [hn, Nat.log_pow (by decide : 1 < 2)]
  change Nat.card (Additive Y) ≤ _ at hcard
  rw [hVcard, hFcard, hAcard, ← pow_add] at hcard
  have hd := (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp hcard
  have hr := Representation.BinaryOffender.fixedCodim_add_finrank (Offenders.linearize f) A
  exact ⟨⟨hne, inferInstance⟩, by omega⟩

private theorem image_elementary (S N E : Subgroup G) (π : S →* H)
    (hker : π.ker = N.subgroupOf S) (hES : E ≤ S)
    (hder : ⁅E,E⁆ ≤ N) (hΩ : omegaOneAmbient E = E) :
    IsElementaryAbelian 2 ((E.subgroupOf S).map π) := by
  let A := (E.subgroupOf S).map π
  have hcomm : IsMulCommutative A := by
    apply commutator_self_eq_bot_iff.mp
    change ⁅(E.subgroupOf S).map π, (E.subgroupOf S).map π⁆ = ⊥
    rw [← map_commutator, Subgroup.map_eq_bot_iff, hker]
    intro x hx
    have hm := mem_map_of_mem S.subtype hx
    rw [map_commutator, map_subgroupOf_eq_of_le hES] at hm
    exact hder hm
  let := hcomm
  let f : E →* A := (π.comp (inclusion hES)).codRestrict A
    (fun x => ⟨inclusion hES x, x.property, rfl⟩)
  refine ⟨Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr ?_⟩
  intro y
  obtain ⟨x,hx,he⟩ := y.property
  have hfe : f ⟨x,hx⟩ = y := Subtype.ext he
  rw [← hfe]
  apply MonoidHom.square_eq_one_on_omega₁
  have hm : (x : G) ∈ omegaOneAmbient E := by rw [hΩ]; exact hx
  obtain ⟨z,hz,hez⟩ := hm
  have hez' : z = (⟨x,hx⟩ : E) := Subtype.ext hez
  rwa [← hez']

private theorem image_card (S N E : Subgroup G) (π : S →* H)
    (hker : π.ker = N.subgroupOf S) (hES : E ≤ S) :
    Nat.card ((E.subgroupOf S).map π) = N.relIndex E := by
  rw [← relIndex_ker, hker, relIndex_subgroupOf hES]

private theorem image_ne_bot (S N E : Subgroup G) (π : S →* H)
    (hker : π.ker = N.subgroupOf S) (hES : E ≤ S) (hne : ¬ E ≤ N) :
    (E.subgroupOf S).map π ≠ ⊥ := by
  intro he
  rw [Subgroup.map_eq_bot_iff, hker] at he
  exact hne (fun x hx => he (show (⟨x,hES hx⟩ : S) ∈ E.subgroupOf S from hx))

variable {M : Type*} [Group M] {R : Subgroup M}

private theorem fixed_index_le (a : Vertex R) (W E N : Subgroup (FreeAmalgam R))
    (c : SpanCentralAction a W)
    (hc : ⁅W ⊓ N,E⁆ ≤ centralizer (W : Set (FreeAmalgam R))) :
    (fixed c.action ((E.subgroupOf (stabilizer R a)).map c.projection)).index ≤
      N.relIndex W := by
  let := c.finite
  let q := QuotientGroup.mk' (center W)
  have hfix : (N.subgroupOf W).map q ≤
      fixed c.action ((E.subgroupOf (stabilizer R a)).map c.projection) := by
    rintro _ ⟨x,hx,rfl⟩ g
    obtain ⟨s,hs,he⟩ := g.property
    change c.action (g : SL) (q x) = q x
    rw [← he]
    let y := Offenders.conjugation (stabilizer R a) W c.normalized s x
    rw [c.conjugation s x y rfl]
    apply QuotientGroup.eq_iff_div_mem.mpr
    apply mem_center_iff.mpr
    intro z
    apply Subtype.ext
    have hd : ⁅(s : FreeAmalgam R),(x : FreeAmalgam R)⁆ ∈ ⁅W ⊓ N,E⁆ := by
      rw [commutator_comm]
      exact commutator_mem_commutator hs ⟨x.property,hx⟩
    have hh := hc hd z z.property
    change (z : FreeAmalgam R) * ((s : FreeAmalgam R) * (x : FreeAmalgam R) *
      (s : FreeAmalgam R)⁻¹ / (x : FreeAmalgam R)) =
      ((s : FreeAmalgam R) * (x : FreeAmalgam R) *
      (s : FreeAmalgam R)⁻¹ / (x : FreeAmalgam R)) * (z : FreeAmalgam R)
    simpa only [commutatorElement_def, div_eq_mul_inv] using hh
  refine (index_antitone hfix).trans ?_
  exact Nat.le_of_dvd (Nat.pos_of_ne_zero (N.subgroupOf W).index_ne_zero_of_finite)
    ((N.subgroupOf W).index_map_dvd (QuotientGroup.mk'_surjective (center W)))

end FFBound

variable {M : Type*} [Group M] [Finite M] {L R : Subgroup M}
  {source : LocalSource L R} {geometry : Geometry R}

omit [Finite M] in
private theorem neighbor_distance (a b d : Vertex R)
    (hab : Adjacent R a b) (hdb : Adjacent R d b) : (cosetGraph R).dist d a ≤ 2 := by
  have h₁ := SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj R _ _).mpr hdb)
  have h₂ := SimpleGraph.dist_eq_one_iff_adj.mpr
    ((cosetGraph_adj R _ _).mpr (adjacent_symm R hab))
  have ht := (cosetGraph_connected R).dist_triangle (u := d) (v := b) (w := a)
  omega

/-- Each span is in its own kernel, and both are in the common edge kernel. -/
theorem PairedSpans.span_kernel_containments (common : CommonFacts R source geometry)
    {a b d : Vertex R} {ha : color R a = false}
    (hab : Adjacent R a b) (hdb : Adjacent R d b)
    (p : PairedSpans geometry a b d ha) :
    neighborSpan a d ≤ Q R a ∧ neighborSpan p.e p.r ≤ Q R p.e ∧
      neighborSpan a d ≤ Q R b ∧ neighborSpan p.e p.r ≤ Q R b := by
  have h₁ : neighborSpan a d ≤ Q R a :=
    (neighborSpan_le_radius a d (neighbor_distance a b d hab hdb)).trans
      (radius_le_Q common a ha)
  have h₀ : neighborSpan p.e p.r ≤ Q R p.e :=
    (neighborSpan_le_radius p.e p.r (by rw [SimpleGraph.dist_comm]; exact p.far.le)).trans
      (radius_le_Q common p.e p.he)
  have hb : color R b = true := by
    have hh := adjacent_color_ne R hab
    cases hh' : color R b <;> simp_all
  exact ⟨h₁,h₀,h₁.trans (Q_le_adjacent_h R hb hab),
    h₀.trans (Q_le_adjacent_h R hb p.edge)⟩

/-- One of the two displayed opposite-span images is an offender for the
corresponding action on the literal span modulo its center. -/
theorem pairedSpanCentralActions_isOffender (common : CommonFacts R source geometry)
    (a b d : Vertex R) (ha : color R a = false)
    (hab : Adjacent R a b) (hdb : Adjacent R d b)
    (p : PairedSpans geometry a b d ha)
    (c1 : SpanCentralAction a (neighborSpan a d))
    (c0 : SpanCentralAction p.e (neighborSpan p.e p.r)) :
    letI := c1.elementary
    letI := c0.elementary
    Representation.BinaryOffender.IsOffender (Offenders.linearize c1.action)
        (((neighborSpan p.e p.r).subgroupOf (stabilizer R a)).map c1.projection) ∨
      Representation.BinaryOffender.IsOffender (Offenders.linearize c0.action)
        (((neighborSpan a d).subgroupOf (stabilizer R p.e)).map c0.projection) := by
  let := c1.elementary
  let := c0.elementary
  let := c1.finite
  let := c0.finite
  obtain ⟨h1,h0,h1b,h0b⟩ := p.span_kernel_containments common hab hdb
  have h1e : neighborSpan a d ≤ stabilizer R p.e :=
    h1b.trans (fun _ hx => hx.2 p.e (adjacent_symm R p.edge))
  have h0a : neighborSpan p.e p.r ≤ stabilizer R a :=
    h0b.trans (fun _ hx => hx.2 a (adjacent_symm R hab))
  have hZa : Z R a ≤ Q R a := by
    rw [← common.X_eq_Z a ha]
    exact omegaCenter_le _
  have hZe : Z R p.e ≤ Q R p.e := by
    rw [← common.X_eq_Z p.e p.he]
    exact omegaCenter_le _
  have hd1 : ⁅neighborSpan a d,neighborSpan a d⁆ ≤ Q R p.e :=
    (commutator_mono le_rfl h1).trans
      (p.displacement_left.le.trans (p.layer_left.trans (inf_le_right.trans hZe)))
  have hd0 : ⁅neighborSpan p.e p.r,neighborSpan p.e p.r⁆ ≤ Q R a :=
    (commutator_mono le_rfl h0).trans
      (p.displacement_right.le.trans (p.layer_right.trans (inf_le_left.trans hZa)))
  let A1 := ((neighborSpan p.e p.r).subgroupOf (stabilizer R a)).map c1.projection
  let A0 := ((neighborSpan a d).subgroupOf (stabilizer R p.e)).map c0.projection
  let : IsElementaryAbelian 2 A1 := FFBound.image_elementary _ _ _ c1.projection
    c1.projection_kernel h0a hd0 (neighborSpan_omegaOne p.e p.r)
  let : IsElementaryAbelian 2 A0 := FFBound.image_elementary _ _ _ c0.projection
    c0.projection_kernel h1e hd1 (neighborSpan_omegaOne a d)
  have hn1 : A1 ≠ ⊥ := FFBound.image_ne_bot _ _ _ c1.projection
    c1.projection_kernel h0a p.escape_right
  have hn0 : A0 ≠ ⊥ := FFBound.image_ne_bot _ _ _ c0.projection
    c0.projection_kernel h1e p.escape_left
  have hc1 : Z R a ≤ centralizer (neighborSpan a d : Set (FreeAmalgam R)) := by
    rw [← common.X_eq_Z a ha]
    exact le_centralizer_iff.mp (h1.trans (Q_le_centralizer_X R a))
  have hc0 : Z R p.e ≤ centralizer (neighborSpan p.e p.r : Set (FreeAmalgam R)) := by
    rw [← common.X_eq_Z p.e p.he]
    exact le_centralizer_iff.mp (h0.trans (Q_le_centralizer_X R p.e))
  rcases le_total ((Q R p.e).relIndex (neighborSpan a d))
    ((Q R a).relIndex (neighborSpan p.e p.r)) with hle | hle
  · left
    apply FFBound.linearize_isOffender c1.action A1 hn1
    change _ ≤ Nat.card (((neighborSpan p.e p.r).subgroupOf (stabilizer R a)).map c1.projection)
    rw [FFBound.image_card _ _ _ c1.projection c1.projection_kernel h0a]
    exact (FFBound.fixed_index_le a _ _ _ c1
      (p.cross_commutators.1.trans hc1)).trans hle
  · right
    apply FFBound.linearize_isOffender c0.action A0 hn0
    change _ ≤ Nat.card (((neighborSpan a d).subgroupOf (stabilizer R p.e)).map c0.projection)
    rw [FFBound.image_card _ _ _ c0.projection c0.projection_kernel h1e]
    exact (FFBound.fixed_index_le p.e _ _ _ c0
      (p.cross_commutators.2.trans hc0)).trans hle

/-- The favorable orientation gives an FF-module on that same central quotient. -/
theorem pairedSpanCentralActions_isFFModule (common : CommonFacts R source geometry)
    (a b d : Vertex R) (ha : color R a = false)
    (hab : Adjacent R a b) (hdb : Adjacent R d b)
    (p : PairedSpans geometry a b d ha)
    (c1 : SpanCentralAction a (neighborSpan a d))
    (c0 : SpanCentralAction p.e (neighborSpan p.e p.r)) :
    letI := c1.elementary
    letI := c0.elementary
    Representation.BinaryOffender.IsFFModule (Offenders.linearize c1.action) ∨
      Representation.BinaryOffender.IsFFModule (Offenders.linearize c0.action) := by
  let := c1.elementary
  let := c0.elementary
  rcases pairedSpanCentralActions_isOffender common a b d ha hab hdb p c1 c0 with h | h
  · exact Or.inl ⟨_,h⟩
  · exact Or.inr ⟨_,h⟩

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Early.Containment.SpanOffender
