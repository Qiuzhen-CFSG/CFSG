module
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceEight.CoreFactors.Higher.Quotients.MovingLayer.Displacement

/-!
# The original action on the complete third quotient

The full higher commutator bound kills the Q_alpha action on hatSix/hatW.
Conjugation therefore descends through the original LocalSource projection
to SL3(2). The quotient is elementary because hatSix is generated by twice
conjugated elementary first-hat groups and its commutators lie in hatW.
This construction uses the independent (4.5.5) source bound, with no moving
factor recognition or cardinality premise.

Source: Meierfrankenfeld--Stellmacher (1993), (4.5.4)(iv) and (4.5.5),
printed pp.899--900.
-/

public section
open Subgroup Stellmacher.PushingUp.AmalgamGraph
open scoped commutatorElement IsMulCommutative
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.CoreFactors.Higher.Quotients.MovingLayer
open NormalizerTransfer
variable {M : Type*} [Group M] {R L : Subgroup M}
  {geometry : Geometry R} {source : LocalSource L R}

@[expose] noncomputable def thirdGroup (p : Higher.SourcePath (alpha R)) : Subgroup (FreeAmalgam R) :=
  hatSix R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8) (p.walk.getVert 10)

theorem thirdGroup_normalized (p : Higher.SourcePath (alpha R)) :
    Mbar R ≤ normalizer (thirdGroup p) := by
  simpa only [thirdGroup,alpha,stabilizer_m_base] using
    hatSix_normalized R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8) (p.walk.getVert 10)

/-- The literal quotient of the complete third group, before choosing coordinates. -/
abbrev ThirdSpace (p : Higher.SourcePath (alpha R)) :=
  thirdGroup p ⧸
    (hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8)).subgroupOf (thirdGroup p)

/-- Constructed quotient-action data on hatSix/hatW, with the original projection. -/
structure ThirdModule (source : LocalSource L R) (p : Higher.SourcePath (alpha R)) where
  normal : ((hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8)).subgroupOf
    (thirdGroup p)).Normal
  finite : Finite (ThirdSpace p)
  action : let := normal; SL →* MulAut (ThirdSpace p)
  conjugation : let := normal
    ∀ (m : M) (x y : thirdGroup p),
      (y : FreeAmalgam R) = embedM R m * (x : FreeAmalgam R) * (embedM R m)⁻¹ →
      action (source.projection m) (QuotientGroup.mk x) = QuotientGroup.mk y

/-- Descent through the exact source projection; no action is an input. -/
theorem thirdModule [Finite M] (source : LocalSource L R)
    (earlier : Earlier R geometry) (p : Higher.SourcePath (alpha R))
    (hQ : ⁅hatSix R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8) (p.walk.getVert 10),
      Q R (alpha R)⁆ ≤ hatV R (alpha R) (p.walk.getVert 6)) :
    Nonempty (ThirdModule source p) := by
  let A := thirdGroup p
  let N := hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8)
  have hlocal : A ≤ Mbar R := (p.hatSix_le_Q earlier).trans (by
    simpa only [alpha,stabilizer_m_base] using
      (show Q R (alpha R) ≤ stabilizer R (alpha R) from fun _ hx => hx.1))
  have hA : Mbar R ≤ normalizer A := thirdGroup_normalized p
  have hN : Mbar R ≤ normalizer N := by
    dsimp only [N]
    simpa only [alpha,stabilizer_m_base] using
      hatW_normalized R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8)
  let hnormal : (N.subgroupOf A).Normal := normal_subgroupOf_of_le_normalizer (hlocal.trans hN)
  let : Finite (Mbar R) := Finite.of_surjective (embedM R).rangeRestrict
    (embedM R).rangeRestrict_surjective
  let : Finite A := Finite.of_injective (inclusion hlocal) (inclusion_injective _)
  obtain ⟨ρ,hρ⟩ := exists_quotient_conjugation_action (Mbar R) A N hA hN hnormal
  have hkill := quotient_conjugation_action_kills_commutator_layer (Mbar R) A N
    (Q R (alpha R)) hnormal hA (hQ.trans (SecondLayer.lower_le_second p)) ρ hρ
  let μ : M →* MulAut (ThirdSpace p) := ρ.comp (embedM R).rangeRestrict
  have hk : source.projection.ker ≤ μ.ker := by
    intro m hm
    rw [source.projection_kernel] at hm
    apply hkill
    change embedM R m ∈ Q R (alpha R)
    rw [Q_alpha R source.two_group source.core_le]
    exact mem_map_of_mem _ hm
  let σ : SL →* MulAut (ThirdSpace p) :=
    source.projection.liftOfSurjective source.projection_surjective ⟨μ,hk⟩
  refine ⟨⟨hnormal,inferInstance,σ,?_⟩⟩
  dsimp only
  intro m x y hy
  change σ (source.projection m) (QuotientGroup.mk' (N.subgroupOf A) x) = _
  dsimp only [σ]
  rw [MonoidHom.liftOfRightInverse_comp_apply]
  change ρ ((embedM R).rangeRestrict m) (QuotientGroup.mk' (N.subgroupOf A) x) = _
  exact (hρ ⟨embedM R m,⟨m,rfl⟩⟩ x).trans
    (congrArg (QuotientGroup.mk' (N.subgroupOf A)) (Subtype.ext hy.symm))


/-- The complete third quotient is elementary, because the third orbit
is generated by conjugates of the elementary first hat layer. -/
theorem ThirdModule.elementary [Finite M] (earlier : Earlier R geometry)
    (p : Higher.SourcePath (alpha R)) (s : ThirdModule source p)
    (hQ : ⁅thirdGroup p,Q R (alpha R)⁆ ≤ hatV R (alpha R) (p.walk.getVert 6)) :
    let := s.normal; IsElementaryAbelian 2 (ThirdSpace p) := by
  let := s.normal
  let A := thirdGroup p
  let N := hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8)
  let π := QuotientGroup.mk' (N.subgroupOf A)
  have hcomm : ⁅A,A⁆ ≤ N := (commutator_mono le_rfl (p.hatSix_le_Q earlier)).trans
    (hQ.trans (SecondLayer.lower_le_second p))
  let : IsMulCommutative (ThirdSpace p) := ⟨⟨by
    intro x y
    obtain ⟨x,rfl⟩ := QuotientGroup.mk'_surjective (N.subgroupOf A) x
    obtain ⟨y,rfl⟩ := QuotientGroup.mk'_surjective (N.subgroupOf A) y
    rw [← commutatorElement_eq_one_iff_mul_comm, ← map_commutatorElement,
      QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact hcomm (commutator_mem_commutator x.property y.property)⟩⟩
  let K := ((powMonoidHom 2 : ThirdSpace p →* ThirdSpace p).comp π).ker
  have hK : A ≤ K.map A.subtype := by
    apply iSup_le
    intro g
    apply map_le_iff_le_comap.mpr
    apply iSup_le
    intro k x hx
    obtain ⟨v,hv,rfl⟩ := hx
    let f := (MulAut.conj (g : FreeAmalgam R)⁻¹).toMonoidHom.comp
      (MulAut.conj (k : FreeAmalgam R)⁻¹).toMonoidHom
    have hxA : f v ∈ A := by
      apply (le_iSup (fun t : stabilizer R (alpha R) =>
        rightConjugate (hatW R (p.walk.getVert 6) (p.walk.getVert 8) (p.walk.getVert 10)) t) g)
      apply mem_map_of_mem
      apply (le_iSup (fun t : stabilizer R (p.walk.getVert 6) =>
        rightConjugate (hatV R (p.walk.getVert 8) (p.walk.getVert 10)) t) k)
      exact mem_map_of_mem _ hv
    refine ⟨⟨f v,hxA⟩,?_,rfl⟩
    change (π ⟨f v,hxA⟩)^2 = 1
    rw [← map_pow]
    have hd : color R (p.walk.getVert 8) = false :=
      (PathCentrality.RegularPaths.walk_vertex_color p.start_color p.walk
        (by rw [p.length_eq]; decide)).mpr (by decide)
    let : IsElementaryAbelian 2 (hatV R (p.walk.getVert 8) (p.walk.getVert 10)) :=
      PathCentrality.localZSpan_elementary R (a := p.walk.getVert 10)
      (c := p.walk.getVert 8) hd p.two_step_distances.2.2.le
      (by rw [earlier.distance]; decide)
    have he : (⟨f v,hxA⟩ : A)^2 = 1 := by
      apply Subtype.ext
      change (f v)^2 = 1
      rw [← map_pow,elemPow_eq_one_of_isElementaryAbelian v hv,map_one]
    rw [he,map_one]
  refine { exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr ?_ }
  intro z
  obtain ⟨x,rfl⟩ := QuotientGroup.mk'_surjective (N.subgroupOf A) z
  obtain ⟨y,hy,he⟩ := hK x.property
  have he' : y = x := Subtype.ext he
  subst y
  exact hy

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.CoreFactors.Higher.Quotients.MovingLayer
