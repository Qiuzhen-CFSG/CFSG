module
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.SectionThree.NaturalStructure.ModuleAlternatives.BadEstimates.Models.Rigidity
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.AbelianCore.QuotientRecognition.CoreAction.Descent.ComponentOffender.BestProjection.CentralTwist.Generation

/-!
# Involution displacement in the two large moving-layer cases

The literal U action is generated by commutators. Three conjugate
involutions generate the specified SL₃(2) quotient, so an involution of
displacement at most one would force |U| ≤ 8. The marked doubled-natural
isomorphism gives |U| = 64. The marked central-extension surjection and
its actual order-two kernel give |U| = 16. Restricting the literal X action
to U proves the required lower bound in both cases.

These arguments retain the source maps and kernel; they do not identify the
doubled natural module with the eight-dimensional doubled universal cover.
Source: Meierfrankenfeld–Stellmacher (1993), (3.2)(iii),(iv), pp.863,877.
-/

public section
open Subgroup Stellmacher.PushingUp.AmalgamGraph
open Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.ModuleAlternatives.Models
variable {M : Type*} [Group M] [Finite M] {L R : Subgroup M}

theorem uAction_fixedCodim_le_xAction (source : LocalSource L R) (geometry : Geometry R)
    (hb : 0 < geometry.b R) (A : Subgroup SL) :
    letI := geometry.U_elementary hb (alpha R) rfl
    letI := X_elementary R (alpha R)
    fixedCodim (Offenders.linearize (uAction source)) A ≤
      fixedCodim (Offenders.linearize (xAction source)) A := by
  let := geometry.U_elementary hb (alpha R) rfl
  let := X_elementary R (alpha R)
  let := finite_X R (alpha R)
  have hUX : U R (alpha R) ≤ X R (alpha R) :=
    (U_le_Z (alpha R)).trans (geometry.omega_bound (alpha R) rfl hb)
  let f := (inclusion hUX).toAdditive.toZModLinearMap 2
  apply fixedCodim_le_of_injective _ _ f (inclusion_injective hUX) ?_ A
  intro g v
  obtain ⟨m, rfl⟩ := source.projection_surjective g
  apply Additive.toMul.injective
  apply Subtype.ext
  change (uAction source (source.projection m) v.toMul : FreeAmalgam R) =
    (xAction source (source.projection m) (inclusion hUX v.toMul) : FreeAmalgam R)
  rw [uAction, xAction, layerAction_apply, layerAction_apply]
  rfl

theorem involutionBound_of_u_card (source : LocalSource L R) (geometry : Geometry R)
    (hb : 0 < geometry.b R) (hcard : 8 < Nat.card (U R (alpha R))) :
    InvolutionBound source := by
  let := geometry.U_elementary hb (alpha R) rfl
  let := X_elementary R (alpha R)
  let := finite_Z R (alpha R)
  let : Finite (U R (alpha R)) :=
    Finite.of_injective (inclusion (U_le_Z (R := R) (alpha R))) (inclusion_injective _)
  let ρ := Offenders.linearize (uAction source)
  intro a ha hne
  have hd : 3 < Module.finrank (ZMod 2) (Additive (U R (alpha R))) := by
    by_contra! hd
    have hc := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := Additive (U R (alpha R)))
    rw [Nat.card_zmod] at hc
    change Nat.card (U R (alpha R)) = _ at hc
    have hpow := Nat.pow_le_pow_right (by decide : 0 < 2) hd
    rw [← hc] at hpow
    omega
  have hgen := ComponentOffender.BestProjection.CentralTwist.finrank_le_three_mul_twist_codim
    ρ (MonoidHom.id SL) 1 (by simp) (fun _ => Commute.one_left _)
    (by simpa using uAction_full source geometry hb) a ha hne
  simp only [MonoidHom.id_apply, mul_one] at hgen
  have hle := uAction_fixedCodim_le_xAction source geometry hb (zpowers a)
  change fixedCodim ρ (zpowers a) ≤ _ at hle
  omega

theorem splitDouble_involutionBound (source : LocalSource L R) (geometry : Geometry R)
    (hb : 0 < geometry.b R) (h : SplitDouble source) : InvolutionBound source := by
  obtain ⟨⟨q⟩, _⟩ := h
  apply involutionBound_of_u_card source geometry hb
  rw [Nat.card_congr q.equiv.toEquiv]
  norm_num [Nat.card_eq_fintype_card]

theorem centralExtension_involutionBound (source : LocalSource L R) (geometry : Geometry R)
    (hb : 0 < geometry.b R) (h : CentralExtension source) : InvolutionBound source := by
  obtain ⟨⟨q⟩, _, hk⟩ := h
  apply involutionBound_of_u_card source geometry hb
  have hker : Nat.card q.projection.ker = 2 := by
    rw [q.kernel]
    let e : (fixedPart R).subgroupOf (U R (alpha R)) ≃*
        (fixedPart R ⊓ U R (alpha R) : Subgroup (FreeAmalgam R)) :=
      (MulEquiv.subgroupCongr (inf_subgroupOf_right _ _).symm).trans
        (subgroupOfEquivOfLe inf_le_right)
    exact (Nat.card_congr e.toEquiv).trans hk
  have hsize := q.projection.ker.card_mul_index
  rw [index_ker, MonoidHom.range_eq_top.mpr q.onto, Nat.card_congr (Subgroup.topEquiv).toEquiv,
    hker] at hsize
  norm_num [Nat.card_eq_fintype_card] at hsize
  omega

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.ModuleAlternatives.Models
