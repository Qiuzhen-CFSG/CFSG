module
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.SectionFive.RadiusCentrality
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.SectionThree.LocalGroups
public import Theory.GroupTheory.Commutator.ConjugateGeneration
public import Theory.GroupTheory.Commutator.NormalizedIndexTwo

/-!
# The critical pair selected by radius noncentrality

The radius is generated by its M-colored layers. If its kernel commutator
is not central, two such generators have nontrivial mixed triple commutator.
Minimal critical distance and the triangle inequality make them endpoints
of a genuine critical pair at distance four, both at distance two from the
original vertex. No linear-group structure is needed for this selection.

Source: Meierfrankenfeld--Stellmacher (1993), (5.2)(ii), printed p.914.
-/

@[expose] public section
open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.SectionFive
open DistanceEight.PathCentrality
variable {M : Type*} [Group M] (R : Subgroup M) (geometry : Geometry R)

theorem radius_commutator_central_iff_generator_triples
    (hb : 2 < geometry.b R) (a : Vertex R) (ha : color R a = false) :
    ⁅V R a,Q R a⁆ ≤ centralizer (V R a : Set (FreeAmalgam R)) ↔
    ∀ d e, color R d = false → color R e = false →
      (cosetGraph R).dist d a ≤ 2 → (cosetGraph R).dist e a ≤ 2 →
      ⁅⁅Z R d,Q R a⁆,Z R e⁆ = ⊥ := by
  constructor
  · intro h d e _ _ hd he
    have hdV : Z R d ≤ V R a := le_iSup_of_le d (le_iSup_of_le hd le_rfl)
    have heV : Z R e ≤ V R a := le_iSup_of_le e (le_iSup_of_le he le_rfl)
    exact commutator_eq_bot_iff_le_centralizer.mpr
      (((commutator_mono hdV le_rfl).trans h).trans
        (centralizer_le heV))
  · intro h
    let I := {d : Vertex R // color R d = false ∧ (cosetGraph R).dist d a ≤ 2}
    have hV : V R a = ⨆ d : I,Z R d.val := by
      apply le_antisymm
      · apply (V_le_iff R ha _).mpr
        intro d hd hda
        exact le_iSup_of_le (⟨d,hd,hda⟩ : I) le_rfl
      · exact iSup_le fun d => le_iSup_of_le d.val (le_iSup_of_le d.property.2 le_rfl)
    conv_lhs => lhs; rw [hV]
    rw [commutator_iSup_of_le _ _ (fun d : I =>
      (le_iSup_of_le d.val (le_iSup_of_le d.property.2 le_rfl)).trans
        (V_le_Q R ha hb))]
    apply iSup_le
    intro d
    apply le_centralizer_iff.mp
    apply (V_le_iff R ha _).mpr
    intro e he hea
    exact le_centralizer_iff.mpr (commutator_eq_bot_iff_le_centralizer.mp
      (h d.val e d.property.1 he d.property.2 hea))

include geometry in
theorem noncentral_generator_not_le [Finite M] (a d e : Vertex R)
    (ha : color R a = false) (he : color R e = false)
    (hea : (cosetGraph R).dist e a ≤ 2)
    (hne : ⁅⁅Z R d,Q R a⁆,Z R e⁆ ≠ ⊥) : ¬ Z R d ≤ Q R e := by
  intro hle
  have hQ : Q R a ≤ stabilizer R e :=
    Q_le_stabilizer_of_dist_le_two a e ha he (by rwa [SimpleGraph.dist_comm])
  have hcomm : ⁅Z R d,Q R a⁆ ≤ Q R e :=
    (commutator_mono hle le_rfl).trans
      (le_normalizer_iff_commutator_le_left.mp (hQ.trans (Q_normalized R e)))
  apply hne
  apply le_bot_iff.mp
  exact (commutator_mono hcomm le_rfl).trans (by
    rw [commutator_comm,geometry.centralizes e he])

theorem exists_noncentral_critical_pair [Finite M]
    (hb : geometry.b R = 4) (a : Vertex R) (ha : color R a = false)
    (hn : ¬ ⁅V R a,Q R a⁆ ≤ centralizer (V R a : Set (FreeAmalgam R))) :
    ∃ d e, color R d = false ∧ color R e = false ∧
      (cosetGraph R).dist d a = 2 ∧ (cosetGraph R).dist e a = 2 ∧
      ⁅⁅Z R d,Q R a⁆,Z R e⁆ ≠ ⊥ ∧
      ∃ hd : color R d = false,CriticalPair R d e (geometry.exists_critical d hd) := by
  have hnot := mt
    (radius_commutator_central_iff_generator_triples R geometry (by omega) a ha).mpr hn
  push Not at hnot
  obtain ⟨d,e,hd,he,hda,hea,hne⟩ := hnot
  have hout := noncentral_generator_not_le R geometry a d e ha he hea hne
  have hlo := criticalDistance_le R d (geometry.exists_critical d hd) hout
  rw [geometry.distance_constant d hd] at hlo
  change geometry.b R ≤ (cosetGraph R).dist d e at hlo
  have htri := (cosetGraph_connected R).dist_triangle (u:=d) (v:=a) (w:=e)
  rw [SimpleGraph.dist_comm (u:=a) (v:=e)] at htri
  refine ⟨d,e,hd,he,by omega,by omega,hne,hd,?_,hout⟩
  rw [geometry.distance_constant d hd]
  change (cosetGraph R).dist d e = geometry.b R
  omega

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.SectionFive

