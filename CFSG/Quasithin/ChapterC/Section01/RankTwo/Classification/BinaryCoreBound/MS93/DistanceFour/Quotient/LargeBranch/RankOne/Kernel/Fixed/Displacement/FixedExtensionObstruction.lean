module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Quotient.LargeBranch.RankOne.Kernel.Fixed.Reduction
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.AbelianCore.FixedKernel.DoubleCopy.CoverRigidity.Models

/-!
# Why a quotient by fixed vectors does not bound whole-core displacement

The concrete module `CoverModels.mixed` is the direct sum of the universal
four-dimensional natural cover and a natural three-space. Its fixed kernel
has dimension one and its quotient is two natural modules, of dimension six.
It is generated by commutators, yet has no elementary order-four actor with
fixed codimension at most two: such an actor would make it an FF-module,
contradicting the proved dimension-six bound for full binary SL3(2) FF-modules.
In particular both intrinsic cores of every marked matrix flag fail the bound.

This diagnoses the attempted passage from a bound on VStar/Z to one on core/U.
It is not a counterexample to the complete MS93 geometric hypotheses. A proof
from those hypotheses must control the fixed extension using the geometry;
the quotient dimension and full action alone do not supply that control.

Sources: the explicit covers in `AbelianCore.FixedKernel.DoubleCopy.CoverRigidity.Models`,
and MS93 (1993), (4.6.12), pp.910--912, for the quotient whose lift is at issue.
-/

public section

open Representation Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterC.BinaryMS
open AbelianCore.DoubleCopy.CoverModels
namespace RankOneDisplacementObstruction

/-- The actual seven-dimensional cover is generated by its action differences. -/
theorem mixed_full : subspaceCommutator mixed ⊤ ⊤ = ⊤ := by
  have he : Coinvariants.ker mixed = subspaceCommutator mixed ⊤ ⊤ := by
    apply congrArg (Submodule.span (ZMod 2))
    ext v
    constructor
    · rintro ⟨⟨g, w⟩, rfl⟩
      exact ⟨g, Subgroup.mem_top _, w, Submodule.mem_top, rfl⟩
    · rintro ⟨g, _, w, _, rfl⟩
      exact ⟨(g, w), rfl⟩
  exact he.symm.trans mixedProjection_isCover.2.2

/-- Full FF-modules have dimension at most six, excluding this concrete cover. -/
theorem mixed_not_ff : ¬ IsFFModule mixed := by
  intro hFF
  have hd := AbelianCore.QuotientRecognition.ExtensionControl.finrank_le_six mixed mixed_full hFF
  rw [finrank_mixed] at hd
  omega


/-- Every elementary actor of order four has displacement codimension greater than two. -/
theorem mixed_fixedCodim_gt_two (A : Subgroup AbelianCore.DoubleCopy.MatrixGroup)
    (hA : IsElementaryAbelian 2 A) (hcard : Nat.card A = 4) :
    2 < fixedCodim mixed A := by
  by_contra! h
  apply mixed_not_ff
  refine ⟨A, ⟨?_, hA⟩, ?_⟩
  · intro hbot
    rw [hbot, Subgroup.card_bot] at hcard
    omega
  · simpa only [rank, hcard, show Nat.log 2 4 = 2 from rfl] using h

/-- The example is a finite module over the binary field. -/
theorem mixed_finite : Finite (U × V) := Module.finite_of_finite (ZMod 2)

/-- The full fixed space is exactly the one-dimensional covering kernel. -/
theorem mixed_fixed_eq_kernel :
    fixedSpace mixed ⊤ = mixedProjection.toLinearMap.ker := by
  apply le_antisymm
  · intro w hw
    change mixedProjection w = 0
    funext j
    have hf : (mixedProjection w) j ∈ Representation.OneCohomology.fixed base := by
      intro g
      have he := LinearMap.congr_fun (mixedProjection.isIntertwining' g) w
      change mixedProjection (mixed g w) = AbelianCore.DoubleCopy.natural g (mixedProjection w) at he
      have hg : mixed g w = w := hw ⟨g, Subgroup.mem_top g⟩
      rw [hg] at he
      exact (congrFun he j).symm
    exact base_fixed.le hf
  · intro w hw g
    exact mixedProjection_isCover.2.1 hw g.val

/-- The quotient by all fixed vectors nevertheless has dimension exactly six. -/
theorem mixed_invariant_quotient_finrank :
    Module.finrank (ZMod 2) ((U × V) ⧸ fixedSpace mixed ⊤) = 6 := by
  have hd := (fixedSpace mixed ⊤).finrank_quotient_add_finrank
  have hk : Module.finrank (ZMod 2) (fixedSpace mixed ⊤) = 1 := by
    rw [mixed_fixed_eq_kernel, mixedProjection_kernel_finrank]
  rw [hk, finrank_mixed] at hd
  omega

/-- Both intrinsic two-cores of every actual matrix flag fail the desired bound. -/
theorem mixed_model_flag_codim_gt_two (g : MS93.SL) (i : Bool) :
    2 < fixedCodim mixed ((MS93.modelParabolic g i).pCoreIn 2) := by
  let P := MS93.modelParabolic g i
  let e := (pCore 2 P).equivMapOfInjective P.subtype P.subtype_injective
  have hd := Matrix.PSL3Two.ParabolicCoreModel.core_data
    (MS93.modelParabolicEquivSymmetric g i)
  let : IsElementaryAbelian 2 (pCore 2 P) := hd.1
  exact mixed_fixedCodim_gt_two _
    (IsElementaryAbelian.of_surjective e.toMonoidHom e.surjective)
    ((Nat.card_congr e.toEquiv.symm).trans hd.2)


end RankOneDisplacementObstruction
end CFSG.Quasithin.ChapterC.BinaryMS
