module

public import Theory.Representation.PSL3Two.ResidualFFForms
public import Theory.Representation.BinaryOffender.MovedSpaceTransport
public import Theory.Representation.BinaryOffender.IrreducibleMovedGeneration
public import Theory.GroupTheory.PResidual.PerfectCover
public import Theory.GroupTheory.PPerfectHom

/-!
# Residual-invariant forms on the binary commutator radical

Let `C = [V,O²(G)]` for a finite binary representation. The p-perfectness of
`O²(G)` makes the restricted action on `C` commutator-generated, even when the
original module is nonsplit. A `SimpleBudget` actor then kills the restriction
of every residual-invariant bilinear form to `C × C`; residual displacements in
`C` make each first-coordinate functional residual-invariant, so full
commutator generation kills it on all of `C`.

This is the conditional radical form argument used in Meierfrankenfeld--
Stellmacher (1993), (1.4), (3.8), and (4.6.2), printed pp.842, 878, 901.
-/

@[expose] public section

open Representation Representation.BinaryOffender Subgroup
open scoped IsMulCommutative

namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Early.Initial

universe u v

private lemma isPGroup_mult_zmod2 : IsPGroup 2 (Multiplicative (ZMod 2)) := by
  rw [isPGroup_iff_pow_pow_eq_one]
  intro x
  refine ⟨1, ?_⟩
  change x ^ 2 = 1
  rw [show x ^ 2 = x * x by rw [pow_two]]
  change Multiplicative.ofAdd (Multiplicative.toAdd x + Multiplicative.toAdd x) =
    Multiplicative.ofAdd 0
  congr 1
  rw [← two_smul (ZMod 2) (Multiplicative.toAdd x)]
  rw [show (2 : ZMod 2) = 0 by exact ZMod.natCast_self 2, zero_smul]

/-- The commutator radical of a p-perfect binary action is generated by its
full commutator action. The proof uses no splitting or semisimplicity. -/
private theorem residual_commutator_generated
    {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
    (ρ : Representation (ZMod 2) G V) (hG : IsPPerfect 2 G)
    (C : Submodule (ZMod 2) V)
    (hCgen : C = subspaceCommutator ρ ⊤ ⊤)
    (hCstab : (⊤ : Subgroup G) ≤ subspaceStabilizer ρ C) :
    let S : Subrepresentation ρ :=
      { toSubmodule := C
        apply_mem_toSubmodule := fun g v hv => (hCstab (Subgroup.mem_top g) v).2 hv }
    subspaceCommutator S.toRepresentation ⊤ ⊤ = ⊤ := by
  let S : Subrepresentation ρ :=
    { toSubmodule := C
      apply_mem_toSubmodule := fun g v hv => (hCstab (Subgroup.mem_top g) v).2 hv }
  let σ := S.toRepresentation
  apply Subspace.dualAnnihilator_inj.mp
  rw [Submodule.dualAnnihilator_top]
  apply le_bot_iff.mp
  intro f hf
  rw [Submodule.mem_dualAnnihilator] at hf
  let F := Subspace.dualLift C f
  have hinv (g : G) (w : V) (hw : w ∈ C) : F (ρ g w) = F w := by
    have h := hf _ (Submodule.subset_span ⟨g, Subgroup.mem_top _,
      ⟨w, hw⟩, Submodule.mem_top, rfl⟩)
    rw [map_sub] at h
    change f ⟨ρ g w, (hCstab (Subgroup.mem_top g) w).2 hw⟩ - f ⟨w, hw⟩ = 0 at h
    change F (ρ g w) = F w
    simpa only [F, Subspace.dualLift_of_mem hw,
      Subspace.dualLift_of_mem ((hCstab (Subgroup.mem_top g) w).2 hw)] using sub_eq_zero.mp h
  have hdiff (g : G) (v : V) : F (ρ g v - v) = 0 := by
    let d : G →* Multiplicative (ZMod 2) := {
      toFun a := Multiplicative.ofAdd (F (ρ a v - v))
      map_one' := by simp
      map_mul' a b := by
        change F (ρ (a * b) v - v) = F (ρ a v - v) + F (ρ b v - v)
        have h := hinv a (ρ b v - v)
          (hCgen ▸ Submodule.subset_span ⟨b, Subgroup.mem_top _, v, Submodule.mem_top, rfl⟩)
        simp only [map_sub] at h
        simp only [map_mul, Module.End.mul_apply, map_sub]
        linear_combination h
    }
    have hd := IsPPerfect.hom_eq_one_of_isPGroup hG isPGroup_mult_zmod2 d
    have h := congrArg (fun q => q g) hd
    change Multiplicative.ofAdd (F (ρ g v - v)) = Multiplicative.ofAdd 0 at h
    exact Multiplicative.ofAdd.injective h
  have hC : C ≤ F.ker := by
    rw [hCgen]
    apply Submodule.span_le.mpr
    rintro _ ⟨g, hg, v, hv, rfl⟩
    exact hdiff g v
  change f = 0
  ext w
  have h := hC (show (w : V) ∈ C from w.property)
  change F (w : V) = 0 at h
  change f w = 0
  simpa only [F, Subspace.dualLift_of_subtype] using h

/-- Residual-invariant bilinear forms vanish whenever their first argument lies
in the residual commutator radical, under the stated constituent budget. -/
theorem form_annihilates_residual_commutator
    {G : Type v} [Group G] [Finite G]
    {V : Type u} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V]
    (ρ : Representation (ZMod 2) G V)
    (A : Subgroup G) (d : ℕ)
    (hbudget : BinaryLinearThree.ResidualFFForms.SimpleBudget.{u} A d)
    (hcost : fixedCodim ρ A ≤ d)
    (B : LinearMap.BilinForm (ZMod 2) V)
    (hB : ∀ g ∈ pResidual 2 G, ∀ v w,
      B (ρ g v) (ρ g w) = B v w) :
    ∀ v ∈ subspaceCommutator ρ ⊤ (pResidual 2 G), ∀ w, B v w = 0 := by
  let X := pResidual 2 G
  let C := subspaceCommutator ρ ⊤ X
  have hXnorm : (⊤ : Subgroup G) ≤ Subgroup.normalizer (X : Set G) := by
    rw [Subgroup.normalizer_eq_top X]
  have hCstab : (⊤ : Subgroup G) ≤ subspaceStabilizer ρ C := by
    apply subspaceCommutator_invariant_normalizer ρ
    · intro g hg v
      simp
    · exact hXnorm
  have hXstab : (⊤ : Subgroup X) ≤
      subspaceStabilizer (ρ.comp X.subtype) C := by
    intro g hg v
    simpa only [MonoidHom.comp_apply] using hCstab (Subgroup.mem_top g) v
  have hgenX : subspaceCommutator (ρ.comp X.subtype) ⊤ ⊤ = C := by
    apply le_antisymm
    · apply Submodule.span_le.mpr
      rintro _ ⟨g, hg, v, hv, rfl⟩
      exact Submodule.subset_span ⟨g.1, g.property, v, Submodule.mem_top, rfl⟩
    · apply Submodule.span_le.mpr
      rintro _ ⟨g, hg, v, hv, rfl⟩
      exact Submodule.subset_span ⟨(⟨g, hg⟩ : X), Subgroup.mem_top _, v,
        Submodule.mem_top, rfl⟩
  have hpX : IsPPerfect 2 X := Subgroup.isPPerfect_pResidual (G := G) 2
  have hfullX := residual_commutator_generated (ρ.comp X.subtype) hpX C hgenX.symm hXstab
  let S : Subrepresentation (ρ.comp X.subtype) :=
    { toSubmodule := C
      apply_mem_toSubmodule := fun g v hv => (hXstab (Subgroup.mem_top g) v).2 hv }
  have hfullX' : subspaceCommutator S.toRepresentation ⊤ ⊤ = ⊤ := by
    simpa [S] using hfullX
  have hmap := subspaceCommutator_map_embedding (ρ.comp X.subtype) S.toRepresentation
    (MonoidHom.id X) C.subtype (by intro g w; rfl) (⊤ : Subgroup X) ⊤
  have hcommX : subspaceCommutator (ρ.comp X.subtype) C ⊤ = C := by
    rw [Submodule.map_top, Submodule.range_subtype] at hmap
    rw [Subgroup.map_id] at hmap
    rw [hfullX', Submodule.map_top, Submodule.range_subtype] at hmap
    exact hmap
  have htransport : subspaceCommutator (ρ.comp X.subtype) C ⊤ ≤
      subspaceCommutator ρ C X := by
    apply Submodule.span_le.mpr
    rintro _ ⟨g, hg, v, hv, rfl⟩
    exact Submodule.subset_span ⟨g.1, g.property, v, hv, rfl⟩
  have hCstabXambient : X ≤ subspaceStabilizer ρ C := by
    intro g hg
    exact hCstab (Subgroup.mem_top g)
  have hcomm : subspaceCommutator ρ C X = C := by
    apply le_antisymm (subspaceCommutator_le_of_invariant ρ hCstabXambient)
    calc
      C = subspaceCommutator (ρ.comp X.subtype) C ⊤ := hcommX.symm
      _ ≤ subspaceCommutator ρ C X := htransport
  have hcommG : subspaceCommutator ρ C ⊤ = C := by
    apply le_antisymm (subspaceCommutator_le_of_invariant ρ hCstab)
    calc
      C = subspaceCommutator ρ C X := hcomm.symm
      _ ≤ subspaceCommutator ρ C ⊤ := by
        apply Submodule.span_le.mpr
        rintro _ ⟨g, hg, v, hv, rfl⟩
        exact Submodule.subset_span ⟨g, Subgroup.mem_top _, v, hv, rfl⟩
  let SG : Subrepresentation ρ :=
    { toSubmodule := C
      apply_mem_toSubmodule := fun g v hv => (hCstab (Subgroup.mem_top g) v).2 hv }
  have hfullG : subspaceCommutator SG.toRepresentation ⊤ ⊤ = ⊤ := by
    have hmapG := subspaceCommutator_map_embedding ρ SG.toRepresentation
      (MonoidHom.id G) C.subtype (by intro g w; rfl) (⊤ : Subgroup G) ⊤
    rw [Submodule.map_top, Submodule.range_subtype] at hmapG
    rw [Subgroup.map_id] at hmapG
    have hm : (subspaceCommutator SG.toRepresentation ⊤ ⊤).map C.subtype =
        (⊤ : Submodule (ZMod 2) SG.toSubmodule).map C.subtype := by
      rw [Submodule.map_top, Submodule.range_subtype]
      exact hmapG.symm.trans hcommG
    exact Submodule.map_injective_of_injective C.subtype_injective hm
  have hcostC : fixedCodim SG.toRepresentation A ≤ d :=
    (fixedCodim_subrepresentation_le ρ SG A).trans hcost
  let BC : LinearMap.BilinForm (ZMod 2) SG.toSubmodule :=
    B.compl₁₂ C.subtype C.subtype
  have hBCinv : ∀ g ∈ X, ∀ v w,
      BC (SG.toRepresentation g v) (SG.toRepresentation g w) = BC v w := by
    intro g hg v w
    exact hB g hg v w
  have hBCzero : BC = 0 := by
    apply BinaryLinearThree.ResidualFFForms.form_zero_of_residual_invariance SG.toRepresentation
    · intro D hD
      exact BinaryLinearThree.ResidualFFForms.form_zero_of_simpleBudget
        SG.toRepresentation A d hbudget hcostC hfullG D hD
    · exact hBCinv
  have hCC (v : V) (hv : v ∈ C) (w : V) (hw : w ∈ C) : B v w = 0 := by
    have hz := LinearMap.congr_fun (LinearMap.congr_fun hBCzero ⟨v, hv⟩) ⟨w, hw⟩
    change B v w = 0 at hz
    exact hz
  intro v hv w
  let f : V →ₗ[ZMod 2] ZMod 2 := B.flip w
  have hfInv (g : G) (hg : g ∈ X) (c : V) (hc : c ∈ C) :
      f (ρ g c) = f c := by
    have h1 : B (ρ g c) w = B c (ρ g⁻¹ w) := by
      simpa only [f, ρ.self_inv_apply] using hB g hg c (ρ g⁻¹ w)
    have hwm : ρ g⁻¹ w - w ∈ C := by
      exact Submodule.subset_span ⟨g⁻¹, X.inv_mem hg, w, Submodule.mem_top, rfl⟩
    have h2 : B c (ρ g⁻¹ w) = B c w := by
      have hz := hCC c hc (ρ g⁻¹ w - w) hwm
      rw [map_sub] at hz
      exact sub_eq_zero.mp hz
    exact h1.trans h2
  have hfzero : C ≤ f.ker := by
    rw [← hcomm]
    apply Submodule.span_le.mpr
    rintro _ ⟨g, hg, c, hc, rfl⟩
    change B (ρ g c - c) w = 0
    rw [map_sub]
    exact sub_eq_zero.mpr (hfInv g hg c hc)
  exact hfzero hv

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Early.Initial
