module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceEight.PathCentrality.LocalCommutator.CriticalCase.Selection.Inside.Recognition.Head

/-!
# Escaping conjugates in an actual binary action

The point stabilizer and orbit spans use the natural three-space and right
conjugation. Displacement is generated by actual action differences. For the
local-span head it lies in the image of the corresponding ambient commutator,
so the supplied order-two bound transfers to the genuine quotient action.

The configuration records the input of binary MS93 (1.6), not its conclusion.
Its finite representation argument and its realization by the quotient point
remain separate obligations. Source: MS93 (1993), pp.845–847 and 891.
-/

@[expose] public section
open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality.LocalCommutator.CriticalCase.Inside.Recognition
open Escape.Initial.Natural.Splitting

variable {E : Type*} [Group E]

/-- The stabilizer of a specified vector in one marking of the actual natural action. -/
def markedPointStabilizer (marking : SL ≃* SL) (v : Fin 3 → ZMod 2) : Subgroup SL :=
  (MulAction.stabilizer SL v).comap marking.toMonoidHom

theorem mem_markedPointStabilizer (marking : SL ≃* SL) (v : Fin 3 → ZMod 2) (g : SL) :
    g ∈ markedPointStabilizer marking v ↔ (marking g).val.mulVec v = v := Iff.rfl

/-- Images are by g⁻¹, matching the source's right conjugates. -/
noncomputable def actionConjugate (ρ : SL →* MulAut E) (W : Subgroup E) (g : SL) :
    Subgroup E := W.map (ρ g⁻¹).toMonoidHom

noncomputable def actionOrbitSpan (ρ : SL →* MulAut E) (W : Subgroup E) : Subgroup E :=
  ⨆ g : SL, actionConjugate ρ W g

/-- The escape test is on the conjugate of K, exactly as in the amalgam construction. -/
noncomputable def actionEscapingSpan (ρ : SL →* MulAut E)
    (K : Subgroup SL) (t : SL) (W : Subgroup E) : Subgroup E :=
  ⨆ g : SL, ⨆ (_ : t ∉ NormalizerTransfer.rightConjugate K g), actionConjugate ρ W g

/-- Displacement of a specified subspace; invariance is not needed for this definition. -/
def actionDisplacement (ρ : SL →* MulAut E) (T : Subgroup SL) (W : Subgroup E) : Subgroup E :=
  closure {y | ∃ t ∈ T, ∃ w ∈ W, y = w⁻¹ * ρ t w}

/-- On the full carrier, these are the usual intrinsic action commutators. -/
theorem actionDisplacement_top (ρ : SL →* MulAut E) (T : Subgroup SL) :
    actionDisplacement ρ T ⊤ = commutatorAction (T.map ρ) E := by
  rw [actionDisplacement, commutatorAction_eq_closure]
  congr 1
  ext y
  constructor
  · rintro ⟨t, ht, w, _, rfl⟩
    exact ⟨⟨ρ t, mem_map_of_mem ρ ht⟩, w, rfl⟩
  · rintro ⟨t, w, rfl⟩
    obtain ⟨g, hg, he⟩ := t.property
    exact ⟨g, hg, w, mem_top w, by rw [he]; rfl⟩

/-- The finite representation input still to be supplied by the point construction.
No full displacement bound or natural splitting is included. -/
structure EscapingConfiguration (ρ : SL →* MulAut E) where
  marking : SL ≃* SL
  point : Fin 3 → ZMod 2
  point_ne_zero : point ≠ 0
  involution : SL
  involution_ne_one : involution ≠ 1
  involution_sq : involution ^ 2 = 1
  seed : Subgroup E
  invariant : ∀ g ∈ markedPointStabilizer marking point,
    seed.map (ρ g).toMonoidHom = seed
  generates : actionOrbitSpan ρ seed = ⊤
  small : Nat.card (actionDisplacement ρ (zpowers involution)
    (actionEscapingSpan ρ (markedPointStabilizer marking point) involution seed)) ≤ 2

variable {M : Type*} [Group M] [Finite M] {L R : Subgroup M}

/-- Literal action differences lift to the specified ambient commutator.
This applies to a partial span as well as the entire module. -/
theorem spanHead_actionDisplacement_le_image (source : LocalSource L R)
    (geometry : Geometry R) (a c : Vertex R) (hc : color R c = false)
    (W T : Subgroup (FreeAmalgam R)) :
    actionDisplacement (spanHeadAction source geometry a c hc)
      ((T.subgroupOf (stabilizer R c)).map (localProjection source c hc))
      (spanHeadImage geometry a c W) ≤ spanHeadImage geometry a c ⁅W, T⁆ := by
  rw [actionDisplacement, closure_le]
  rintro _ ⟨t, ht, w, hw, rfl⟩
  obtain ⟨g, hg, rfl⟩ := ht
  obtain ⟨u, hu, rfl⟩ := hw
  rw [spanHeadAction_apply]
  let u' : localSpan a c := ⟨g * (u : stabilizer R c) * g⁻¹,
    (inferInstance : (localSpan a c).Normal).conj_mem u u.property g⟩
  refine ⟨u⁻¹ * u', ?_, ?_⟩
  · change (u : FreeAmalgam R)⁻¹ *
      ((g : FreeAmalgam R) * (u : FreeAmalgam R) * (g : FreeAmalgam R)⁻¹) ∈ ⁅W,T⁆
    simpa only [commutatorElement_def, inv_inv, mul_assoc, coe_subtype] using
      commutator_mem_commutator (W.inv_mem hu) hg
  · rw [map_mul, map_inv]

/-- The escaping-span hypothesis gives a small displacement for the whole
projected endpoint subgroup acting on the projected escaping span. -/
theorem escaping_actionDisplacement_card_le_two (source : LocalSource L R)
    (geometry : Geometry R) (hb : 4 < geometry.b R) {a c e : Vertex R}
    (hc : color R c = false) (hd : (cosetGraph R).dist a c = 2)
    (p : CriticalPath R geometry c e) (x : stabilizer R c)
    (hsmall : (Z R c).relIndex ⁅escapingSpan a c e x, Z R e⁆ ≤ 2) :
    Nat.card (actionDisplacement (spanHeadAction source geometry a c hc)
      (((Z R e).subgroupOf (stabilizer R c)).map (localProjection source c hc))
      (spanHeadImage geometry a c (escapingSpan a c e x))) ≤ 2 := by
  exact (card_le_of_le (spanHead_actionDisplacement_le_image source geometry a c hc _ _)).trans
    (escaping_displacement_image_card_le_two geometry hb hc hd p x hsmall)

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality.LocalCommutator.CriticalCase.Inside.Recognition
