module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Flags.RankOne.Triple.BinaryAuxiliary.Layers
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Flags.RankOne.Triple.Preparatory.Propagation.Quotient
public import Theory.Representation.ElementaryAbelianAction

/-!
# The actual source module for first-core nonquadraticity

The auxiliary group Y is generated by the opposite actor's conjugates of
the incident first layer V_beta. This follows directly from common coset
representatives and invariance of V_beta under its first parabolic.
The early commutator and square bounds make the literal quotient Y/Z_alpha
elementary abelian. We construct its full-actor conjugation representation
with an onto coordinate map, its exact kernel, and the conjugation formula.

This prepares the source action for the finite parabolic calculation; it
does not assert that calculation or its marked S4 identification.
Source: Meierfrankenfeld--Stellmacher (1993), (4.6.8), pp.905--907.
The quotient construction follows the same elementary argument as
Core/Naturality/Movement/Source/Quotient, without importing that branch.
-/

@[expose] public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Flags.RankOne.BinaryAuxiliary.Moving.Nonquadratic

universe u
variable {M : Type u} [Group M] {L R : Subgroup M}

/-- The incidence span is generated by the opposite actor's orbit of the
original first layer, expressed by its subgroup universal property. -/
theorem Y_le_of_first_and_normalized [Finite M]
    (source : LocalSource L R) (geometry : Geometry R)
    (hlarge : 2 < geometry.b R) (i : Bool)
    (hkernel : flagKernel source i = Q R (beta R)) (d : M)
    (hd : flagIncident source i 1 d) (H : Subgroup (FreeAmalgam R))
    (hfirst : V R (beta R) ≤ H)
    (hnorm : localFlagActor source (!i) d ≤ normalizer H) : Y source i d ≤ H := by
  obtain ⟨m₀, hm₀, hdm₀⟩ := hd
  simp only [inv_one, one_mul] at hm₀
  apply iSup_le
  intro g
  apply iSup_le
  rintro ⟨m, hgm, hdm⟩
  let a := m * m₀⁻¹
  have ha : embedM R a ∈ localFlagActor source (!i) d := by
    have hp : d⁻¹ * a * d ∈ parabolic source.projection source.flag (!i) := by
      have hh := (parabolic source.projection source.flag (!i)).mul_mem hdm
        ((parabolic source.projection source.flag (!i)).inv_mem hdm₀)
      convert hh using 1
      dsimp [a]
      group
    refine ⟨embedM R (d⁻¹ * a * d), mem_map_of_mem (embedM R) hp, ?_⟩
    change embedM R d * embedM R (d⁻¹ * a * d) * (embedM R d)⁻¹ = embedM R a
    simp only [map_mul, map_inv]
    group
  have hgm' := firstFlagLayer_right_mul_of_kernel source geometry hlarge i hkernel
    g (g⁻¹ * m) hgm
  simp only [mul_inv_cancel_left] at hgm'
  have ham := firstFlagLayer_right_mul_of_kernel source geometry hlarge i hkernel a m₀ hm₀
  have ham' : a * m₀ = m := by dsimp [a]; group
  rw [ham'] at ham
  rw [← hgm', ham]
  exact (map_mono hfirst).trans_eq (mem_normalizer_iff_map_conj_eq.mp (hnorm ha))

/-- Normality holds in the actual numerator Y. -/
theorem denominator_normal (source : LocalSource L R) (geometry : Geometry R)
    (hlarge : 2 < geometry.b R) (i : Bool) (d : M) :
    ((Z R (alpha R)).subgroupOf (Y source i d)).Normal :=
  normal_subgroupOf_of_le_normalizer
    (((Y_le_radius source i d).trans (geometry.V_local _ rfl hlarge)).trans
      (Z_normalized R _))

/-- The source quotient Y/Z_alpha is elementary, using only the early bounds. -/
theorem quotient_elementary (source : LocalSource L R) (geometry : Geometry R)
    (common : CommonFacts R source geometry) (early : EarlyFacts R geometry)
    (i : Bool) (d : M) :
    letI := denominator_normal source geometry common.large_distance i d
    IsElementaryAbelian 2 (Y source i d ⧸ (Z R (alpha R)).subgroupOf (Y source i d)) := by
  let := denominator_normal source geometry common.large_distance i d
  let H := Y source i d
  let N := (Z R (alpha R)).subgroupOf H
  have hc : _root_.commutator H ≤ N := by
    intro x hx
    have hh := mem_map_of_mem H.subtype hx
    rw [map_subtype_commutator] at hh
    exact ((commutator_mono (Y_le_radius source i d)
      ((Y_le_radius source i d).trans (V_le_Q geometry common.large_distance _ rfl))).trans
        (early.commutator_le_Z _ rfl)) hh
  let : IsMulCommutative (H ⧸ N) := Normal.quotient_commutative_iff_commutator_le.mpr hc
  refine { exponent_dvd_p := ?_ }
  rw [Monoid.exponent_dvd_iff_forall_pow_eq_one]
  intro x
  obtain ⟨y, rfl⟩ := QuotientGroup.mk'_surjective N x
  rw [← map_pow, QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
  exact Propagation.radius_square_mem_Z common early ⟨y, Y_le_radius source i d y.property⟩

/-- An exact presentation of the constructed quotient, with its actual actor. -/
structure SourceModule (source : LocalSource L R) (i : Bool) (d : M) where
  Space : Type u
  [addCommGroup : AddCommGroup Space]
  [module : Module (ZMod 2) Space]
  [finite : Finite Space]
  representation : Representation (ZMod 2) (localFlagActor source (!i) d) Space
  projection : Y source i d →* Multiplicative Space
  onto : Function.Surjective projection
  kernel : projection.ker = (Z R (alpha R)).subgroupOf (Y source i d)
  action : ∀ (a : localFlagActor source (!i) d) (x y : Y source i d),
    (y : FreeAmalgam R) = (a : FreeAmalgam R) * (x : FreeAmalgam R) *
      (a : FreeAmalgam R)⁻¹ →
    (projection y).toAdd = representation a (projection x).toAdd

attribute [instance] SourceModule.addCommGroup SourceModule.module SourceModule.finite

/-- Construct the carrier and action from the literal quotient. -/
noncomputable def sourceModule [Finite M] (source : LocalSource L R) (geometry : Geometry R)
    (common : CommonFacts R source geometry) (early : EarlyFacts R geometry)
    (i : Bool) (d : M) : SourceModule source i d := by
  let H := Y source i d
  let N := (Z R (alpha R)).subgroupOf H
  let : N.Normal := denominator_normal source geometry common.large_distance i d
  let : IsElementaryAbelian 2 (H ⧸ N) := quotient_elementary source geometry common early i d
  let : Finite (stabilizer R (alpha R)) := finite_stabilizer R (alpha R)
  let : Finite H := Finite.of_injective
    (inclusion ((Y_le_radius source i d).trans (geometry.V_local _ rfl common.large_distance)))
    (inclusion_injective _)
  let B := H ⧸ N
  let h := exists_quotient_conjugation_action (localFlagActor source (!i) d) H
    (Z R (alpha R)) (Y_normalized source i d)
    ((localFlagActor_le_stabilizer source (!i) d).trans (Z_normalized R _)) inferInstance
  let a := Classical.choose h
  have ha := Classical.choose_spec h
  let : MulDistribMulAction (localFlagActor source (!i) d) B := MulDistribMulAction.compHom B a
  let ρ : Representation (ZMod 2) (localFlagActor source (!i) d) (Additive B) :=
    Representation.ofElementaryAbelianAction
  let p : H →* Multiplicative (Additive B) :=
    (MulEquiv.multiplicativeAdditive (H := B)).symm.toMonoidHom.comp (QuotientGroup.mk' N)
  exact {
    Space := Additive B
    representation := ρ
    projection := p
    onto := (MulEquiv.multiplicativeAdditive (H := B)).symm.surjective.comp
      (QuotientGroup.mk'_surjective N)
    kernel := (MonoidHom.ker_comp_of_injective (QuotientGroup.mk' N)
      (MulEquiv.multiplicativeAdditive (H := B)).symm.toMonoidHom
      (MulEquiv.multiplicativeAdditive (H := B)).symm.injective).trans (QuotientGroup.ker_mk' N)
    action := by
      intro g x y hy
      change QuotientGroup.mk' N y = a g (QuotientGroup.mk' N x)
      rw [ha]
      congr 1
      exact Subtype.ext hy }

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Flags.RankOne.BinaryAuxiliary.Moving.Nonquadratic
