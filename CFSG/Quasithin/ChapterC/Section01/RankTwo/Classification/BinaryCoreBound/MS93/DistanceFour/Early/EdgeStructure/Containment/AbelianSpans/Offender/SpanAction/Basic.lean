module
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Early.EdgeStructure.Containment.AbelianSpans.Offender.Representation
public import Theory.GroupTheory.CentralCharacteristicAutomorphisms
public import Theory.GroupTheory.PGroup.OmegaHomomorphism

/-!
# The faithful action on each literal span modulo its center

For a nonabelian conjugate-generated span W, the central displacement
[W,Q] makes the conjugation action on W/Z(W) factor through the actual
local quotient SL₃(2). Its projection is transported from the source
projection with its exact kernel Q. The central quotient is abelian and
is generated by involutions, hence is a binary vector space.

Simplicity of SL₃(2) proves faithfulness. If the action were trivial,
every conjugate of the abelian seed would lie in the seed times Z(W).
That product is abelian and contains W, a contradiction. This argument
requires no order bound on Z(W), and does not assume W is extraspecial.

Both paired spans have this action, and both derived subgroups are the
specified central lines of order two. These are the inputs to the
commutator-duality and opposite-span offender-index arguments; those
arguments and the final `SpanQuotientAction` assembly are separate.

Source: Meierfrankenfeld--Stellmacher, Pushing up weak BN-pairs of rank two
(1993), (4.6.4), printed p.902. The local quotient projection follows
`AbelianSpans.Centrality.local_projection` and
`Reduction.SectionThree.NormalizationTransfer`.
-/

public section
open Subgroup Stellmacher.PushingUp.AmalgamGraph
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Early.Containment.SpanOffender

/-- The genuine central quotient action, before duality and the FF bound. -/
structure SpanCentralAction {M : Type*} [Group M] {R : Subgroup M}
    (a : Vertex R) (W : Subgroup (FreeAmalgam R)) where
  finite : Finite W
  normalized : stabilizer R a ≤ normalizer (W : Set (FreeAmalgam R))
  elementary : IsElementaryAbelian 2 (W ⧸ center W)
  projection : stabilizer R a →* SL
  projection_surjective : Function.Surjective projection
  projection_kernel : projection.ker = (Q R a).subgroupOf (stabilizer R a)
  action : SL →* MulAut (W ⧸ center W)
  conjugation : ∀ (g : stabilizer R a) (x y : W),
    (y : FreeAmalgam R) = (g : FreeAmalgam R) * (x : FreeAmalgam R) * (g : FreeAmalgam R)⁻¹ →
    action (projection g) (QuotientGroup.mk' (center W) x) =
      QuotientGroup.mk' (center W) y
  faithful : Function.Injective action

variable {G : Type*} [Group G]

private theorem derived_le_center (W S : Subgroup G) (hWS : W ≤ S)
    (hc : ⁅W,W⁆ ≤ centralizer (S : Set G)) :
    _root_.commutator W ≤ center W := by
  intro x hx
  apply mem_center_iff.mpr
  intro y
  apply Subtype.ext
  exact hc (W.map_subtype_commutator ▸ mem_map_of_mem W.subtype hx) y (hWS y.property)

private theorem elementary_central_quotient (W : Subgroup G)
    (hc : _root_.commutator W ≤ center W) (hΩ : omegaOneAmbient W = W) :
    IsElementaryAbelian 2 (W ⧸ center W) := by
  let : IsMulCommutative (W ⧸ center W) :=
    Normal.quotient_commutative_iff_commutator_le.mpr hc
  refine ⟨Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr ?_⟩
  intro v
  obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (center W) v
  apply MonoidHom.square_eq_one_on_omega₁
  have hx : (x : G) ∈ omegaOneAmbient W := by rw [hΩ]; exact x.property
  obtain ⟨y,hy,he⟩ := hx
  have : y = x := Subtype.ext he
  rwa [← this]

private noncomputable def centralConjugation (S W : Subgroup G)
    (hn : S ≤ normalizer (W : Set G)) : S →* MulAut (W ⧸ center W) :=
  (Subgroup.quotientAut (center W)).comp (Offenders.conjugation S W hn)

private theorem centralConjugation_apply (S W : Subgroup G)
    (hn : S ≤ normalizer (W : Set G)) (g : S) (x : W) :
    centralConjugation S W hn g (QuotientGroup.mk' (center W) x) =
      QuotientGroup.mk' (center W) (Offenders.conjugation S W hn g x) := by
  exact Subgroup.quotientAut_apply_mk _ _ _

private theorem centralConjugation_kills (S N W : Subgroup G)
    (hW : W ≤ S) (hn : S ≤ normalizer (W : Set G))
    (hc : ⁅W,N⁆ ≤ centralizer (S : Set G)) :
    N.subgroupOf S ≤ (centralConjugation S W hn).ker := by
  intro g hg
  apply MulEquiv.ext
  intro v
  obtain ⟨x,rfl⟩ := QuotientGroup.mk'_surjective (center W) v
  rw [centralConjugation_apply]
  apply QuotientGroup.eq_iff_div_mem.mpr
  apply mem_center_iff.mpr
  intro y
  apply Subtype.ext
  have hd : ⁅(g : G), (x : G)⁆ ∈ ⁅W,N⁆ := by
    rw [commutator_comm]
    exact commutator_mem_commutator hg x.property
  have hh := hc hd y (hW y.property)
  change (y : G) * ((g : G) * (x : G) * (g : G)⁻¹ / (x : G)) =
    ((g : G) * (x : G) * (g : G)⁻¹ / (x : G)) * (y : G)
  simpa only [commutatorElement_def, div_eq_mul_inv] using hh

variable {M : Type*} [Group M] [Finite M] {L R : Subgroup M}
  {source : LocalSource L R} {geometry : Geometry R}

include source in
theorem span_local_projection (a : Vertex R) (ha : color R a = false) :
    ∃ π : stabilizer R a →* SL, Function.Surjective π ∧
      π.ker = (Q R a).subgroupOf (stabilizer R a) := by
  obtain ⟨g,rfl⟩ := exists_mVertex_of_color R ha
  let S := stabilizer R (mVertex R g)
  let f := (MulAut.conj g⁻¹).toMonoidHom.comp (embedM R)
  have hf : Function.Injective f := (MulAut.conj g⁻¹).injective.comp (embedM_injective R)
  have hrange : f.range = S := by
    rw [MonoidHom.range_comp]
    exact (stabilizer_mVertex R g).symm
  let e : M ≃* S := (MonoidHom.ofInjective hf).trans (MulEquiv.subgroupCongr hrange)
  have he : S.subtype.comp e.toMonoidHom = f := by ext x; rfl
  have hQ : (pCore 2 M).map e.toMonoidHom =
      (Q R (mVertex R g)).subgroupOf S := by
    apply map_injective S.subtype_injective
    rw [map_map, he, map_subgroupOf_eq_of_le (show Q R (mVertex R g) ≤ S from fun _ hx => hx.1)]
    rw [show f = (MulAut.conj g⁻¹).toMonoidHom.comp (embedM R) from rfl, ← map_map,
      ← Q_alpha R source.two_group source.core_le]
    have hh := Q_act R g (alpha R)
    simpa only [alpha, act_mVertex, one_mul] using hh.symm
  refine ⟨source.projection.comp e.symm.toMonoidHom,
    source.projection_surjective.comp e.symm.surjective, ?_⟩
  rw [← MonoidHom.comap_ker, source.projection_kernel, ← hQ]
  ext x
  constructor
  · intro hx
    exact ⟨e.symm x, hx, e.apply_symm_apply x⟩
  · rintro ⟨y,hy,rfl⟩
    change e.symm (e y) ∈ pCore 2 M
    rw [MulEquiv.symm_apply_apply]
    exact hy

private theorem commutative_sup_center {H : Type*} [Group H]
    (A : Subgroup H) [IsMulCommutative A] : IsMulCommutative (A ⊔ center H : Subgroup H) := by
  apply le_centralizer_iff_isMulCommutative.mp
  have hA : A ⊔ center H ≤ centralizer (A : Set H) :=
    sup_le A.le_centralizer (center_le_centralizer _)
  exact sup_le (le_centralizer_iff.mp hA) (center_le_centralizer _)

omit [Finite M] in
private theorem centralConjugation_nontrivial (a d : Vertex R)
    (hseed : IsMulCommutative (Z R d))
    (hnon : ¬ IsMulCommutative (neighborSpan a d)) :
    centralConjugation (stabilizer R a) (neighborSpan a d) (neighborSpan_normalized a d) ≠ 1 := by
  let W := neighborSpan a d
  let S := stabilizer R a
  let A := (Z R d).subgroupOf W
  let K := A ⊔ center W
  let q := QuotientGroup.mk' (center W)
  let := hseed
  let : IsMulCommutative A := subgroupOf_isMulCommutative W (Z R d)
  let : IsMulCommutative K := commutative_sup_center A
  intro he
  have hle : W ≤ K.map W.subtype := by
    apply iSup_le
    intro g
    rintro _ ⟨z,hz,rfl⟩
    let x : W := ⟨z,Z_le_neighborSpan a d hz⟩
    let y : W := Offenders.conjugation S W (neighborSpan_normalized a d) g x
    have hq : q y = q x := by
      have hh := DFunLike.congr_fun
        (DFunLike.congr_fun he g) (q x)
      rw [centralConjugation_apply] at hh
      exact hh
    have hd : y / x ∈ center W := QuotientGroup.eq_iff_div_mem.mp hq
    have hxK : x ∈ K := (show A ≤ K from le_sup_left) hz
    have hyK : y ∈ K := by
      have hh := K.mul_mem ((show center W ≤ K from le_sup_right) hd) hxK
      simpa only [div_mul_cancel] using hh
    exact ⟨y,hyK,rfl⟩
  have heq : K.map W.subtype = W := le_antisymm (map_subtype_le _) hle
  apply hnon
  change IsMulCommutative W
  rw [← heq]
  exact map_isMulCommutative K W.subtype

include source in
/-- A nonabelian span carries the actual faithful action of its local SL₃(2) quotient. -/
theorem spanCentralAction_nonempty (a d : Vertex R) (ha : color R a = false)
    (hWQ : neighborSpan a d ≤ Q R a)
    (hc : ⁅neighborSpan a d, Q R a⁆ ≤
      centralizer (stabilizer R a : Set (FreeAmalgam R)))
    (hseed : IsMulCommutative (Z R d))
    (hnon : ¬ IsMulCommutative (neighborSpan a d)) :
    Nonempty (SpanCentralAction a (neighborSpan a d)) := by
  let W := neighborSpan a d
  let S := stabilizer R a
  have hWS : W ≤ S := hWQ.trans (fun _ hx => hx.1)
  let : Finite S := finite_stabilizer R a
  have hfin : Finite W := Finite.of_injective (inclusion hWS) (inclusion_injective hWS)
  let F := centralConjugation S W (neighborSpan_normalized a d)
  obtain ⟨π,hπ,hker⟩ := span_local_projection (source := source) a ha
  have hkill : π.ker ≤ F.ker := by
    rw [hker]
    exact centralConjugation_kills S (Q R a) W hWS (neighborSpan_normalized a d) hc
  let ρ := π.liftOfSurjective hπ ⟨F,hkill⟩
  have hρ (g : S) : ρ (π g) = F g :=
    MonoidHom.liftOfRightInverse_comp_apply _ _ _ _ _
  have hfaith : Function.Injective ρ := by
    let : IsSimpleGroup SL := Atlas.Comparisons.Exceptional.sl3Two_simple
    rcases (inferInstance : ρ.ker.Normal).eq_bot_or_eq_top with ht | ht
    · exact ρ.ker_eq_bot_iff.mp ht
    · exfalso
      apply centralConjugation_nontrivial a d hseed hnon
      have htriv := MonoidHom.ker_eq_top_iff.mp ht
      apply MonoidHom.ext
      intro g
      rw [← hρ, htriv]
      rfl
  refine ⟨{
    finite := hfin
    normalized := neighborSpan_normalized a d
    elementary := elementary_central_quotient W
      (derived_le_center W S hWS ((commutator_mono le_rfl hWQ).trans hc))
      (neighborSpan_omegaOne a d)
    projection := π
    projection_surjective := hπ
    projection_kernel := hker
    action := ρ
    faithful := hfaith
    conjugation := ?_ }⟩
  intro g x y hy
  rw [hρ, centralConjugation_apply]
  congr 1
  exact Subtype.ext hy.symm

omit [Finite M] in
private theorem span_le_kernel (common : CommonFacts R source geometry)
    (a d : Vertex R) (ha : color R a = false)
    (hd : (cosetGraph R).dist d a ≤ 2) : neighborSpan a d ≤ Q R a :=
  (neighborSpan_le_radius a d hd).trans (radius_le_Q common a ha)

omit [Finite M] in
private theorem neighbor_distance (a b d : Vertex R)
    (hab : Adjacent R a b) (hdb : Adjacent R d b) : (cosetGraph R).dist d a ≤ 2 := by
  have h₁ := SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj R _ _).mpr hdb)
  have h₂ := SimpleGraph.dist_eq_one_iff_adj.mpr
    ((cosetGraph_adj R _ _).mpr (adjacent_symm R hab))
  have ht := (cosetGraph_connected R).dist_triangle (u := d) (v := b) (w := a)
  omega

/-- Both conjugate spans have faithful actions on their literal central quotients.
No module classification, abelianness theorem, or FF exclusion is used. -/
theorem pairedSpanCentralActions_nonempty (common : CommonFacts R source geometry)
    (a b d : Vertex R) (ha : color R a = false)
    (hab : Adjacent R a b) (hdb : Adjacent R d b)
    (p : PairedSpans geometry a b d ha)
    (hnon : ¬ IsMulCommutative (neighborSpan a d)) :
    Nonempty (SpanCentralAction a (neighborSpan a d) ×
      SpanCentralAction p.e (neighborSpan p.e p.r)) := by
  have hd : color R d = false := by
    have h₁ := adjacent_color_ne R hab
    have h₂ := adjacent_color_ne R hdb
    cases hb : color R b <;> cases hd : color R d <;> simp_all
  have hpos (v : Vertex R) (hv : color R v = false) :
      0 < criticalDistance R v (geometry.exists_critical v hv) := by
    rw [geometry.distance_constant v hv]
    exact lt_trans (by decide : 0 < 2) common.large_distance
  let := Z_elementary_of_positive R geometry d hd (hpos d hd)
  let := Z_elementary_of_positive R geometry p.r p.hr (hpos p.r p.hr)
  obtain ⟨c₁⟩ := spanCentralAction_nonempty (source := source) a d ha
    (span_le_kernel common a d ha (neighbor_distance a b d hab hdb))
    (by rw [p.displacement_left]; exact p.central_left) inferInstance hnon
  obtain ⟨c₀⟩ := spanCentralAction_nonempty (source := source) p.e p.r p.he
    (span_le_kernel common p.e p.r p.he (by rw [SimpleGraph.dist_comm]; exact p.far.le))
    (by rw [p.displacement_right]; exact p.central_right) inferInstance
    (p.noncommutative_right hnon)
  exact ⟨c₁,c₀⟩

private theorem derived_eq_of_card_two {F : Type*} [Group F]
    (W N D : Subgroup F) (hWN : W ≤ N) (hd : ⁅W,N⁆ = D)
    (hc : Nat.card D = 2) (hnon : ¬ IsMulCommutative W) : ⁅W,W⁆ = D := by
  have hle : ⁅W,W⁆ ≤ D := (commutator_mono le_rfl hWN).trans hd.le
  let : Finite D := Nat.finite_of_card_ne_zero (by omega)
  let : Finite (⁅W,W⁆ : Subgroup F) :=
    Finite.of_injective (inclusion hle) (inclusion_injective hle)
  apply eq_of_le_of_card_ge hle
  have hne : ⁅W,W⁆ ≠ ⊥ := fun h => hnon (commutator_self_eq_bot_iff.mp h)
  have hh := (one_lt_card_iff_ne_bot _).mpr hne
  omega

omit [Finite M] in
/-- The derived lines for both orientations, with their actual ambient embeddings.
Together with `card_left/right` and `central_left/right`, these supply the
order-two invariant target of the commutator pairing. -/
theorem PairedSpans.derived_eq_displacement (common : CommonFacts R source geometry)
    {a b d : Vertex R} {ha : color R a = false}
    (hab : Adjacent R a b) (hdb : Adjacent R d b)
    (p : PairedSpans geometry a b d ha)
    (hnon : ¬ IsMulCommutative (neighborSpan a d)) :
    ⁅neighborSpan a d, neighborSpan a d⁆ = ⁅Z R d, Q R a⁆ ∧
      ⁅neighborSpan p.e p.r, neighborSpan p.e p.r⁆ = ⁅Z R p.r, Q R p.e⁆ := by
  constructor
  · exact derived_eq_of_card_two _ _ _
      (span_le_kernel common a d ha (neighbor_distance a b d hab hdb))
      p.displacement_left p.card_left hnon
  · exact derived_eq_of_card_two _ _ _
      (span_le_kernel common p.e p.r p.he (by rw [SimpleGraph.dist_comm]; exact p.far.le))
      p.displacement_right p.card_right (p.noncommutative_right hnon)

