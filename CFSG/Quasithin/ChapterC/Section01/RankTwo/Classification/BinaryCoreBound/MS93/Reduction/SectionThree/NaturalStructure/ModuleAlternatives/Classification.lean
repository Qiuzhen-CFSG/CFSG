module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.SectionThree.NaturalStructure.ModuleAlternatives.Reconstruction
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.SectionThree.NaturalStructure.ModuleAlternatives.FixedGeneration
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.SectionThree.NaturalStructure.ModuleAlternatives.BadEstimates

/-!
# The binary specialization of MS93 (3.2)

The actual Z is faithful and generated by full fixed spaces of nontrivial
edge two-groups. Applying fixed-space generation to the faithful FF-action
on X identifies Z with C + [X,SL₃(2)]. The reconstruction lemmas then prove
[X,Ltilde] = U and transfer the exhaustive central-attachment classification
to the source subgroups. The natural coordinates use the specified quotient
and one common marking, including in the doubled case. The nonsplit central
extension retains its exact kernel of order two, and the outer extension
retains [X:Z] = 2.

The classification is for the actual matrix SL₃(2), so it directly exhausts
the possibilities for this quotient without introducing other family labels.
For b > 2, `alternatives_with_estimates` also supplies offender uniqueness
and the source (3.3), (2.3)(c,d) estimates in every bad branch. Excluding those
branches by (3.8) belongs to the subsequent natural-structure argument.

Source: Meierfrankenfeld–Stellmacher, *Pushing up weak BN-pairs of rank two*
(1993), (3.2)(i),(iii)–(v), printed p.863; (3.3), pp.866–868; and the
initial verification of (2.3)(c,d) in (3.8), pp.877–878.
-/

public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.ModuleAlternatives
variable {M : Type*} [Group M] [Finite M] {L R : Subgroup M}

local instance : IsElementaryAbelian 2 (X R (alpha R)) := X_elementary R (alpha R)

/-- The source Z is the central sum in the literal faithful action on X.
Every fixed-generation and faithfulness premise is supplied by the source edges. -/
theorem space_Z_eq_centralSum (source : LocalSource L R) (geometry : Geometry R)
    (hb : 0 < geometry.b R) :
    Reconstruction.space (Z R (alpha R)) =
      CentralAttachments.centralSum (Offenders.linearize (xAction source)) := by
  let := finite_X R (alpha R)
  exact FixedGeneration.eq_centralSum (Offenders.linearize (xAction source))
    (xAction_injective source geometry hb) (xAction_isFFModule source geometry hb)
    (Reconstruction.zRepresentation source)
    (Reconstruction.zRepresentation_injective source geometry hb)
    (Reconstruction.zRepresentation_twoFixedGenerated source geometry hb)

/-- The moving subgroup defined from Z is also the full commutator of X.
This identification follows from fixed-space generation, not from notation. -/
theorem X_commutator_eq_U (source : LocalSource L R) (geometry : Geometry R)
    (hb : 0 < geometry.b R) :
    ⁅X R (alpha R), Ltilde R (alpha R)⁆ = U R (alpha R) :=
  Reconstruction.X_commutator_eq_U_of_space_Z source geometry hb
    (space_Z_eq_centralSum source geometry hb)

/-- All four binary alternatives have Z = C U; directness is branch-dependent. -/
theorem Z_eq_fixed_sup_U (source : LocalSource L R) (geometry : Geometry R)
    (hb : 0 < geometry.b R) : Z R (alpha R) = fixedPart R ⊔ U R (alpha R) :=
  Reconstruction.Z_eq_fixed_sup_U_of_space_Z source geometry hb
    (space_Z_eq_centralSum source geometry hb)

/-- The four exhaustive source alternatives for the actual binary quotient,
with equivariant natural maps and both nonsplit possibilities retained. -/
theorem alternatives (source : LocalSource L R) (geometry : Geometry R)
    (hb : 0 < geometry.b R) : Alternatives source :=
  Reconstruction.alternatives_of_space_Z source geometry hb
    (space_Z_eq_centralSum source geometry hb)

/-- The binary alternatives together with all bad-case inputs used in the
initial source-(3.8) verification. The bad branch is retained for its later
exclusion; no action-control or module-classification premise is assumed. -/
theorem alternatives_with_estimates (source : LocalSource L R) (geometry : Geometry R)
    (hb : 2 < geometry.b R) :
    SplitNatural source ∨ (BadCase source ∧ EdgeOffenderUniqueness source ∧
      Source33Bound R geometry ∧ BadCaseEstimates R geometry) := by
  have hbpos : 0 < geometry.b R := by omega
  rcases alternatives source geometry hbpos with hnatural | hbad
  · exact Or.inl hnatural
  · exact Or.inr ⟨hbad, badCase_edgeOffenderUniqueness source geometry hbpos hbad,
      badCase_source33Bound source geometry hbpos hbad,
      badCaseEstimates_of_badCase source geometry hb hbad⟩

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.ModuleAlternatives
