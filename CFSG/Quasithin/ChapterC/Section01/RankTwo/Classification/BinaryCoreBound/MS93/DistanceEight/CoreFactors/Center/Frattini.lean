module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceEight.CoreFactors.Center.SecondDerived
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceEight.CoreFactors.Center.MovingFirst
public import Theory.Frattini.BinarySquares

/-!
# The Frattini layers in the distance-eight core

The third hat is generated by involutions and its commutators lie in the
first hat. Its squares therefore lie there as well. The binary Frattini
formula bounds the Frattini subgroup of the actual core by the first hat.
The whole fixed-factor equality identifies the intersection with the core
as Vcirc; the reverse inclusion follows from the proved derived-group bound.
Thus the literal Frattini centralizer is the second-hat intersection.

Only the exact whole fixed-factor equality remains explicit. Its producer is
qt-ms93-distance-eight-fixed-factor; qt-rank-two-ms93 owns its discharge and
the original C.1.34 assembly. FrattiniSections applies these identities to
the actual marked quotient actions.

Source: Meierfrankenfeld--Stellmacher (1993), (4.5)(v)--(vii) and (4.5.5),
printed pp.895,899--900; Aschbacher--Smith C.1.34(4), printed p.136.
-/

public section
open Subgroup Stellmacher.PushingUp.AmalgamGraph
open scoped commutatorElement IsMulCommutative Pointwise
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.CoreFactors.Center
open Higher NormalizerTransfer
open Higher.Quotients.MovingLayer
variable {M : Type*} [Group M] [Finite M] {L R : Subgroup M}
  {geometry : Geometry R} {source : LocalSource L R}

omit [Finite M] in
private theorem third_squares_le_first (earlier : Earlier R geometry)
    (p : Higher.SourcePath (alpha R))
    (hQ : ⁅thirdGroup p,Q R (alpha R)⁆ ≤ hatV R (alpha R) (p.walk.getVert 6)) :
    ∀ x ∈ thirdGroup p, x^2 ∈ hatV R (alpha R) (p.walk.getVert 6) := by
  let A := thirdGroup p
  let N := hatV R (alpha R) (p.walk.getVert 6)
  have hlocal : A ≤ stabilizer R (alpha R) := (p.hatSix_le_Q earlier).trans (fun _ hx => hx.1)
  let : (N.subgroupOf A).Normal := normal_subgroupOf_of_le_normalizer
    (hlocal.trans (hatV_normalized R _ _))
  let π := QuotientGroup.mk' (N.subgroupOf A)
  have hcomm : ⁅A,A⁆ ≤ N := (commutator_mono le_rfl (p.hatSix_le_Q earlier)).trans
    hQ
  let : IsMulCommutative ((A ⧸ N.subgroupOf A)) := ⟨⟨by
    intro x y
    obtain ⟨x,rfl⟩ := QuotientGroup.mk'_surjective (N.subgroupOf A) x
    obtain ⟨y,rfl⟩ := QuotientGroup.mk'_surjective (N.subgroupOf A) y
    rw [← commutatorElement_eq_one_iff_mul_comm, ← map_commutatorElement,
      QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact hcomm (commutator_mem_commutator x.property y.property)⟩⟩
  let K := ((powMonoidHom 2 : (A ⧸ N.subgroupOf A) →* (A ⧸ N.subgroupOf A)).comp π).ker
  have hK : A ≤ K.map A.subtype := by
    apply iSup_le
    intro g
    apply map_le_iff_le_comap.mpr
    apply iSup_le
    intro k x hx
    obtain ⟨v,hv,rfl⟩ := hx
    let f := (MulAut.conj (g : FreeAmalgam R)⁻¹).toMonoidHom.comp
      (MulAut.conj (k : FreeAmalgam R)⁻¹).toMonoidHom
    have hxA : f v ∈ A := by
      apply (le_iSup (fun t : stabilizer R (alpha R) =>
        rightConjugate (hatW R (p.walk.getVert 6) (p.walk.getVert 8) (p.walk.getVert 10)) t) g)
      apply mem_map_of_mem
      apply (le_iSup (fun t : stabilizer R (p.walk.getVert 6) =>
        rightConjugate (hatV R (p.walk.getVert 8) (p.walk.getVert 10)) t) k)
      exact mem_map_of_mem _ hv
    refine ⟨⟨f v,hxA⟩,?_,rfl⟩
    change (π ⟨f v,hxA⟩)^2 = 1
    rw [← map_pow]
    have hd : color R (p.walk.getVert 8) = false :=
      (PathCentrality.RegularPaths.walk_vertex_color p.start_color p.walk
        (by rw [p.length_eq]; decide)).mpr (by decide)
    let : IsElementaryAbelian 2 (hatV R (p.walk.getVert 8) (p.walk.getVert 10)) :=
      PathCentrality.localZSpan_elementary R (a := p.walk.getVert 10)
      (c := p.walk.getVert 8) hd p.two_step_distances.2.2.le
      (by rw [earlier.distance]; decide)
    have he : (⟨f v,hxA⟩ : A)^2 = 1 := by
      apply Subtype.ext
      change (f v)^2 = 1
      rw [← map_pow,elemPow_eq_one_of_isElementaryAbelian v hv,map_one]
    rw [he,map_one]
  intro x hx
  obtain ⟨y,hy,he⟩ := hK hx
  have he' : y = (⟨x,hx⟩ : A) := Subtype.ext he
  subst y
  change (π ⟨x,hx⟩)^2 = 1 at hy
  rw [← map_pow,QuotientGroup.mk'_apply,QuotientGroup.eq_one_iff] at hy
  exact hy


/-- The Frattini subgroup lies in the literal first hat. -/
theorem core_frattini_le_first (common : CommonFacts R source geometry)
    (earlier : Earlier R geometry) (p : Early.SourcePath R (alpha R)) :
    (frattini (core R (alpha R))).map (core R (alpha R)).subtype ≤
      hatV R (alpha R) (p.walk.getVert 6) := by
  let K := core R (alpha R)
  let : Finite K := DistanceTwo.finite_core (alpha R)
  have hp : IsPGroup 2 K := (Q_isPGroup R source.two_group source.core_le _ rfl).to_le
    (DistanceTwo.core_le_Q _)
  rw [map_le_iff_le_comap,hp.frattini_eq_closure_squares]
  apply (closure_le _).mpr
  rintro x ⟨y,rfl⟩
  exact third_squares_le_first earlier (Early.Orbit.SourceApplications.higherPath geometry p)
    (Higher.OrbitGeometry.Source.Q_commutator_le common earlier p) y
    (Early.Orbit.Source.Complete.core_le_third_hat common earlier p y.property)

/-- The exact whole fixed-factor premise identifies the first-hat intersection.
The graph Z is retained until after intersecting with the actual core. -/
theorem core_inf_first_eq_moving_of_fixedFactor
    (common : CommonFacts R source geometry) (earlier : Earlier R geometry)
    (hfixed : core R (alpha R) ⊓ centralizer
      (Ltilde R (alpha R) : Set (FreeAmalgam R)) = H R (alpha R))
    (p : Early.SourcePath R (alpha R)) :
    core R (alpha R) ⊓ hatV R (alpha R) (p.walk.getVert 6) = Vcirc R (alpha R) := by
  let K := core R (alpha R)
  let F := Vcirc R (alpha R)
  let Z₀ := Z R (alpha R)
  have hFK : F ≤ K := Vcirc_le_core rfl common.large_distance
  have hKZ : K ⊓ Z₀ ≤ F := by
    rw [← core_center_eq_inf_Z common earlier,
      core_center_eq_U_sup_fixedFactor common earlier,hfixed,
      ← moving_inf_Z_eq_U_sup_H common earlier p]
    exact inf_le_left
  rw [(Early.Orbit.Source.Complete.sourceOrbitFacts common earlier p).hatV_eq]
  apply le_antisymm ?_ (le_inf hFK le_sup_left)
  rintro x ⟨hx,hxFZ⟩
  have hn : F ≤ normalizer Z₀ := ((Vcirc_le_V R _).trans
    (geometry.V_local _ rfl common.large_distance)).trans (Z_normalized R _)
  have hxprod : x ∈ (F : Set (FreeAmalgam R)) * (Z₀ : Set (FreeAmalgam R)) := by
    rw [← coe_mul_of_left_le_normalizer_right _ _ hn]
    exact hxFZ
  obtain ⟨f,hf,z,hz,rfl⟩ := hxprod
  have hzK : z ∈ K := by
    have hh := K.mul_mem (K.inv_mem (hFK hf)) hx
    simpa only [inv_mul_cancel_left] using hh
  exact F.mul_mem hf (hKZ ⟨hzK,hz⟩)

/-- The source whole fixed-factor equality identifies the actual Frattini group,
not merely its product with the graph central layer. -/
theorem core_frattini_eq_moving_of_fixedFactor
    (common : CommonFacts R source geometry) (earlier : Earlier R geometry)
    (hfixed : core R (alpha R) ⊓ centralizer
      (Ltilde R (alpha R) : Set (FreeAmalgam R)) = H R (alpha R)) :
    (frattini (core R (alpha R))).map (core R (alpha R)).subtype = Vcirc R (alpha R) := by
  obtain ⟨p⟩ := Early.sourcePath_nonempty source common earlier (alpha R) rfl
  let K := core R (alpha R)
  let : Finite K := DistanceTwo.finite_core (alpha R)
  let : Fact (IsPGroup 2 K) := ⟨(Q_isPGroup R source.two_group source.core_le _ rfl).to_le
    (DistanceTwo.core_le_Q _)⟩
  apply le_antisymm
  · rw [← core_inf_first_eq_moving_of_fixedFactor common earlier hfixed p]
    exact le_inf (map_subtype_le _) (core_frattini_le_first common earlier p)
  · apply (moving_le_core_derived common earlier p).trans
    have hh := map_mono (f := K.subtype) (commutator_le_frattini_of_isPGroup (R := K) (p := 2))
    simpa only [commutator_def,map_commutator,← MonoidHom.range_eq_map,range_subtype] using hh

/-- In particular the original core center lies in its Frattini subgroup. -/
theorem core_center_le_frattini_of_fixedFactor
    (common : CommonFacts R source geometry) (earlier : Earlier R geometry)
    (hfixed : core R (alpha R) ⊓ centralizer
      (Ltilde R (alpha R) : Set (FreeAmalgam R)) = H R (alpha R)) :
    center (core R (alpha R)) ≤ frattini (core R (alpha R)) := by
  apply (map_le_map_iff_of_injective (core R (alpha R)).subtype_injective).mp
  rw [core_frattini_eq_moving_of_fixedFactor common earlier hfixed,
    core_center_eq_U_sup_fixedFactor common earlier,hfixed]
  obtain ⟨p⟩ := Early.sourcePath_nonempty source common earlier (alpha R) rfl
  rw [← moving_inf_Z_eq_U_sup_H common earlier p]
  exact inf_le_left

/-- The Frattini centralizer is the literal second-hat intersection. -/
theorem core_frattini_centralizer_of_fixedFactor
    (common : CommonFacts R source geometry) (earlier : Earlier R geometry)
    (hfixed : core R (alpha R) ⊓ centralizer
      (Ltilde R (alpha R) : Set (FreeAmalgam R)) = H R (alpha R))
    (p : Early.SourcePath R (alpha R)) :
    core R (alpha R) ⊓ centralizer
        ((frattini (core R (alpha R))).map (core R (alpha R)).subtype : Set (FreeAmalgam R)) =
      core R (alpha R) ⊓ hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8) := by
  rw [core_frattini_eq_moving_of_fixedFactor common earlier hfixed,
    ← first_centralizer_eq_second common earlier p,
    (Early.Orbit.Source.Complete.sourceOrbitFacts common earlier p).hatV_eq,
    sup_eq_closure,centralizer_closure]
  have hz := le_centralizer_iff.mp (Higher.Quotients.FirstDirect.Z_centralizes_core common earlier)
  apply le_antisymm
  · intro x hx
    exact ⟨hx.1,fun z hz' => hz'.elim (hx.2 z) (hz hx.1 z)⟩
  · intro x hx
    exact ⟨hx.1,fun z hz' => hx.2 z (Or.inl hz')⟩

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.CoreFactors.Center
