module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceEight.PathCentrality.LocalCommutator.CriticalCase.Selection.Inside.Recognition.Action

/-!
# Algebra for the binary escaping-seed argument

The intersection of all right translates is the common orbit core. Action
differences on an abelian carrier are homomorphisms, so their images commute
with arbitrary joins. In particular a small displacement bounds the relative
index between a seed and its image. This is the input to the geometry of
pairwise adjacent subspaces in the seven-point orbit.

If the point stabilizer fixes the seed pointwise, a nonescaping translate is
fixed by the involution. Generation then transfers displacement from the full
module to the escaping span. Setwise invariance alone is not used as pointwise
fixation here.

Source: Meierfrankenfeld--Stellmacher (1993), (1.6), pp.845--847.
-/

@[expose] public section
open Subgroup
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality.LocalCommutator.CriticalCase.Inside.Recognition
open Escape.Initial.Natural.Splitting
set_option backward.isDefEq.respectTransparency false

variable {E : Type*} [Group E]

/-- The actual common intersection, not a chosen fixed subspace. -/
noncomputable def actionOrbitCore (ρ : SL →* MulAut E) (W : Subgroup E) : Subgroup E :=
  ⨅ g : SL, actionConjugate ρ W g

theorem actionConjugate_one (ρ : SL →* MulAut E) (W : Subgroup E) :
    actionConjugate ρ W 1 = W := by
  change W.map (ρ 1⁻¹).toMonoidHom = W
  rw [inv_one, map_one]
  exact map_id W

theorem actionConjugate_mul (ρ : SL →* MulAut E) (W : Subgroup E) (g h : SL) :
    actionConjugate ρ (actionConjugate ρ W g) h = actionConjugate ρ W (g * h) := by
  simp only [actionConjugate, map_map]
  congr 1
  ext w
  simp

theorem actionOrbitCore_le (ρ : SL →* MulAut E) (W : Subgroup E) :
    actionOrbitCore ρ W ≤ W := by
  simpa only [actionOrbitCore, actionConjugate_one] using
    (iInf_le (fun g => actionConjugate ρ W g) 1)

/-- The common orbit core is invariant under the whole actor. -/
theorem actionOrbitCore_map (ρ : SL →* MulAut E) (W : Subgroup E) (h : SL) :
    (actionOrbitCore ρ W).map (ρ h).toMonoidHom = actionOrbitCore ρ W := by
  rw [actionOrbitCore, Subgroup.map_iInf _ (ρ h).injective]
  have he (g : SL) : (actionConjugate ρ W g).map (ρ h).toMonoidHom =
      actionConjugate ρ W (g * h⁻¹) := by
    simpa only [actionConjugate, inv_inv] using actionConjugate_mul ρ W g h⁻¹
  simp_rw [he]
  exact (Equiv.mulRight h⁻¹).iInf_comp

/-- Every seed has the same relative index over the common core. -/
theorem orbitCore_relIndex_conjugate (ρ : SL →* MulAut E) (W : Subgroup E) (g : SL) :
    (actionOrbitCore ρ W).relIndex (actionConjugate ρ W g) =
      (actionOrbitCore ρ W).relIndex W := by
  have hh := relIndex_map_map_of_injective (f := (ρ g⁻¹).toMonoidHom)
    (actionOrbitCore ρ W) W (ρ g⁻¹).injective
  simpa only [actionOrbitCore_map, actionConjugate] using hh

theorem actionDisplacement_mono (ρ : SL →* MulAut E) (T : Subgroup SL)
    {W U : Subgroup E} (h : W ≤ U) : actionDisplacement ρ T W ≤ actionDisplacement ρ T U := by
  apply Subgroup.closure_mono
  rintro y ⟨t, ht, w, hw, rfl⟩
  exact ⟨t, ht, w, h hw, rfl⟩

variable [IsMulCommutative E]

/-- The multiplicative form of the linear map `ρ(g) - 1`. -/
def actionDifference (ρ : SL →* MulAut E) (g : SL) : E →* E where
  toFun w := w⁻¹ * ρ g w
  map_one' := by simp
  map_mul' a b := by simp only [mul_inv_rev, map_mul]; ac_rfl

theorem actionDisplacement_eq_iSup (ρ : SL →* MulAut E) (T : Subgroup SL)
    (W : Subgroup E) :
    actionDisplacement ρ T W = ⨆ t : T, W.map (actionDifference ρ t) := by
  apply le_antisymm
  · rw [actionDisplacement, closure_le]
    rintro y ⟨t, ht, w, hw, rfl⟩
    exact le_iSup (fun t : T => W.map (actionDifference ρ t)) ⟨t, ht⟩
      (mem_map_of_mem _ hw)
  · apply iSup_le
    intro t
    rintro y ⟨w, hw, rfl⟩
    exact subset_closure ⟨t, t.property, w, hw, rfl⟩

theorem actionDisplacement_iSup (ρ : SL →* MulAut E) (T : Subgroup SL)
    {ι : Sort*} (W : ι → Subgroup E) :
    actionDisplacement ρ T (⨆ i, W i) = ⨆ i, actionDisplacement ρ T (W i) := by
  simp only [actionDisplacement_eq_iSup, Subgroup.map_iSup]
  exact iSup_comm

/-- The seed is generated by its image and the actual differences. -/
theorem le_image_sup_actionDisplacement (ρ : SL →* MulAut E) (g : SL)
    (W : Subgroup E) :
    W ≤ W.map (ρ g).toMonoidHom ⊔ actionDisplacement ρ (zpowers g) W := by
  intro w hw
  have h₁ : ρ g w ∈ W.map (ρ g).toMonoidHom ⊔
      actionDisplacement ρ (zpowers g) W :=
    (show W.map (ρ g).toMonoidHom ≤ _ from le_sup_left) (mem_map_of_mem _ hw)
  have h₂ : w⁻¹ * ρ g w ∈ W.map (ρ g).toMonoidHom ⊔
      actionDisplacement ρ (zpowers g) W :=
    (show actionDisplacement ρ (zpowers g) W ≤ _ from le_sup_right)
      (subset_closure ⟨g, mem_zpowers g, w, hw, rfl⟩)
  simpa using mul_mem h₁ (inv_mem h₂)

/-- A rank-one displacement makes a seed and its image adjacent subspaces. -/
theorem image_relIndex_le_displacement_card [Finite E] (ρ : SL →* MulAut E)
    (g : SL) (W : Subgroup E) :
    (W.map (ρ g).toMonoidHom).relIndex W ≤
      Nat.card (actionDisplacement ρ (zpowers g) W) := by
  let U := W.map (ρ g).toMonoidHom
  let D := actionDisplacement ρ (zpowers g) W
  let : U.IsFiniteRelIndex (U ⊔ D) := isFiniteRelIndex_of_finiteIndex
  calc
    U.relIndex W ≤ U.relIndex (U ⊔ D) :=
      relIndex_le_of_le_right (le_image_sup_actionDisplacement ρ g W) relIndex_ne_zero
    _ = U.relIndex D := relIndex_sup_left D U
    _ ≤ Nat.card D := Nat.le_of_dvd Nat.card_pos (relIndex_dvd_card U D)

/-- The local adjacency bound supplied directly by the configuration. -/
theorem escaping_image_relIndex_le_two [Finite E] (ρ : SL →* MulAut E)
    (d : EscapingConfiguration ρ) (g : SL)
    (hg : d.involution ∉ NormalizerTransfer.rightConjugate
      (markedPointStabilizer d.marking d.point) g) :
    ((actionConjugate ρ d.seed g).map (ρ d.involution).toMonoidHom).relIndex
      (actionConjugate ρ d.seed g) ≤ 2 := by
  apply (image_relIndex_le_displacement_card ρ d.involution _).trans
  apply (card_le_of_le (actionDisplacement_mono ρ (zpowers d.involution) ?_)).trans d.small
  exact le_iSup_of_le g (le_iSup_of_le hg le_rfl)

omit [IsMulCommutative E] in
private theorem fixed_on_map {A : Type*} [Group A]
    (ρ : A →* MulAut E) (K : Subgroup A)
    (W : Subgroup E) (hfixed : ∀ k ∈ K, ∀ w ∈ W, ρ k w = w)
    (g t : A) (ht : t ∈ NormalizerTransfer.rightConjugate K g) :
    ∀ w ∈ W.map (ρ g⁻¹).toMonoidHom, ρ t w = w := by
  obtain ⟨k, hk, rfl⟩ := ht
  rintro w ⟨u, hu, rfl⟩
  change ρ (g⁻¹ * k * (g⁻¹)⁻¹) (ρ g⁻¹ u) = ρ g⁻¹ u
  simp only [inv_inv, map_mul, MulAut.mul_apply]
  have hg : ρ g (ρ g⁻¹ u) = u := by
    rw [← MulAut.mul_apply, ← map_mul, mul_inv_cancel, map_one, MulAut.one_apply]
  rw [hg, hfixed k hk u hu]

omit [IsMulCommutative E] in
/-- A stabilizer fixing the seed fixes every corresponding right translate. -/
theorem fixed_on_actionConjugate (ρ : SL →* MulAut E) (K : Subgroup SL)
    (W : Subgroup E) (hfixed : ∀ k ∈ K, ∀ w ∈ W, ρ k w = w)
    (g t : SL) (ht : t ∈ NormalizerTransfer.rightConjugate K g) :
    ∀ w ∈ actionConjugate ρ W g, ρ t w = w :=
  fixed_on_map ρ K W hfixed g t ht

/-- Once pointwise fixation is proved, every displacement on a nonescaping
translate vanishes. This supplies the literal comparison used by recognition. -/
theorem displacement_transfer_of_seed_fixed (ρ : SL →* MulAut E)
    (d : EscapingConfiguration ρ)
    (hfixed : ∀ k ∈ markedPointStabilizer d.marking d.point,
      ∀ w ∈ d.seed, ρ k w = w) :
    actionDisplacement ρ (zpowers d.involution) ⊤ ≤
      actionDisplacement ρ (zpowers d.involution)
        (actionEscapingSpan ρ (markedPointStabilizer d.marking d.point)
          d.involution d.seed) := by
  conv_lhs => rw [← d.generates]
  rw [actionOrbitSpan, actionDisplacement_iSup]
  apply iSup_le
  intro g
  by_cases hg : d.involution ∈ NormalizerTransfer.rightConjugate
      (markedPointStabilizer d.marking d.point) g
  · rw [actionDisplacement, closure_le]
    rintro y ⟨t, ht, w, hw, rfl⟩
    rw [fixed_on_actionConjugate ρ _ d.seed hfixed g t (zpowers_le.mpr hg ht) w hw,
      inv_mul_cancel]
    exact one_mem _
  · exact actionDisplacement_mono ρ _ (le_iSup_of_le g (le_iSup_of_le hg le_rfl))

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality.LocalCommutator.CriticalCase.Inside.Recognition
