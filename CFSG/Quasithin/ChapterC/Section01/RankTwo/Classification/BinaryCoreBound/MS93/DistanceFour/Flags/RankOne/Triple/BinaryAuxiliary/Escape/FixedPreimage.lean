module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Flags.RankOne.Triple.BinaryAuxiliary.Targets
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Flags.RankOne.Triple.Preparatory.SourceData
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Flags.RankOne.Triple.BinaryAuxiliary.Escape.FixedPreimage.FirstIntersection

/-!
# The full-actor fixed preimage under the endpoint bound

The incident first layers are conjugate under the full opposite actor, so
Y is the product of V_beta and its moving subgroup. In a binary natural
plane, every vector fixed by a nonidentity matrix is a displacement of
that matrix. Applied to the actual moving factor ([Y,L_delta] U)/U, this
lifts the endpoint bound to D <= V_beta U. No coordinates on all of Y/U
are assumed.

The incident-core normal-generation calculation in `FirstIntersection`
gives D intersect V_beta <= U. Together with U <= D and the actual
normal-product decomposition, this proves D = U. The final theorem retains
the contrary product containment and endpoint commutator bound supplied by
the escape argument; the bound alone suffices for this fixed-preimage step.

Source: Meierfrankenfeld--Stellmacher, *Pushing up weak BN-pairs of rank two*
(1993), (4.6.8), final paragraph on printed p.908, with the local factors
and generation on p.907. All actors are untilded full parabolics; the
first natural section retains its original tilded-residual denominator.
-/

open Subgroup Stellmacher.PushingUp.AmalgamGraph
open scoped commutatorElement Pointwise
public section
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Flags.RankOne.BinaryAuxiliary
private theorem binary_fixed_is_displacement : ∀ (a : SL2) (v : Fin 2 → ZMod 2),
    a ≠ 1 → a.val.mulVec v = v → ∃ w : Fin 2 → ZMod 2, a.val.mulVec w - w = v := by decide

private theorem natural_fixed_lift {G : Type*} [Group G] {P S U : Subgroup G}
    (n : RankOnePairing.RankOneFactor P S U) (e : P) (he : n.projection e ≠ 1)
    (T : Subgroup G) (hUT : U ≤ T)
    (hcomm : ∀ x ∈ S, ⁅(e : G), x⁆ ∈ T)
    (v : S) (hv : ⁅(e : G), (v : G)⁆ ∈ U) : (v : G) ∈ T := by
  let c (x : S) : S := ⟨(e : G) * (x : G) * (e : G)⁻¹,
    (mem_normalizer_iff.mp (n.normalized e.property) _).mp x.property⟩
  have hc (x : S) : (n.coordinates (c x * x⁻¹)).toAdd =
      (n.projection e).val.mulVec (n.coordinates x).toAdd - (n.coordinates x).toAdd := by
    rw [map_mul, map_inv]
    simp only [toAdd_mul, toAdd_inv, ← sub_eq_add_neg]
    rw [n.action e x (c x) rfl]
  have hfix : (n.projection e).val.mulVec (n.coordinates v).toAdd =
      (n.coordinates v).toAdd := by
    have hk : c v * v⁻¹ ∈ n.coordinates.ker := by
      rw [n.kernel]
      exact hv
    have hh := congrArg Multiplicative.toAdd (MonoidHom.mem_ker.mp hk)
    rw [hc] at hh
    exact sub_eq_zero.mp hh
  obtain ⟨w, hw⟩ := binary_fixed_is_displacement (n.projection e) _ he hfix
  obtain ⟨x, hx⟩ := n.coordinates_surjective (Multiplicative.ofAdd w)
  have heq : n.coordinates (c x * x⁻¹) = n.coordinates v := by
    apply Multiplicative.toAdd.injective
    rw [hc, hx]
    exact hw
  have hk : v * (c x * x⁻¹)⁻¹ ∈ n.coordinates.ker := by
    rw [MonoidHom.mem_ker, map_mul, map_inv, heq, mul_inv_cancel]
  rw [n.kernel] at hk
  have hδ : ((c x * x⁻¹ : S) : G) ∈ T := hcomm x x.property
  have hh := T.mul_mem (hUT hk) hδ
  change (v : G) * ((c x * x⁻¹ : S) : G)⁻¹ * ((c x * x⁻¹ : S) : G) ∈ T at hh
  simpa only [inv_mul_cancel_right] using hh

variable {M : Type*} [Group M] [Finite M] {L R : Subgroup M}

omit [Finite M] in
/-- Every incident first layer is conjugate to V_beta under the full local actor.
Consequently Y is generated by V_beta and its full-actor commutators. -/
theorem Y_eq_first_sup_commutator (source : LocalSource L R) (i : Bool)
    (natural : FlagNaturalSection source i) (d : M) (hd : flagIncident source i 1 d) :
    Y source i d = V R (beta R) ⊔ ⁅Y source i d, localFlagActor source (!i) d⁆ := by
  have hWY : V R (beta R) ≤ Y source i d := by
    simpa only [firstFlagLayer, localConjugate_one] using first_le_Y source i 1 d hd
  apply le_antisymm ?_ (sup_le hWY
    (le_normalizer_iff_commutator_le_left.mp (Y_normalized source i d)))
  obtain ⟨m₀, hm₀, hdm₀⟩ := (flagIncident_one_iff source i d).mp hd
  apply iSup_le
  intro g
  apply iSup_le
  rintro ⟨m, hgm, hdm⟩
  let a := m * m₀⁻¹
  have ha : embedM R a ∈ localFlagActor source (!i) d := by
    let b := (d⁻¹ * m) * (d⁻¹ * m₀)⁻¹
    have hb : b ∈ parabolic source.projection source.flag (!i) :=
      (parabolic source.projection source.flag (!i)).mul_mem hdm
        ((parabolic source.projection source.flag (!i)).inv_mem hdm₀)
    have he : d * b * d⁻¹ = a := by dsimp [a, b]; group
    refine ⟨embedM R b, mem_map_of_mem _ hb, ?_⟩
    change embedM R d * embedM R b * (embedM R d)⁻¹ = embedM R a
    rw [← map_inv, ← map_mul, ← map_mul, he]
  have hg : firstFlagLayer (R := R) g = firstFlagLayer (R := R) a := by
    have h₁ := firstFlagLayer_right_mul source i natural g (g⁻¹ * m) hgm
    have h₂ := firstFlagLayer_right_mul source i natural a m₀ hm₀
    simp only [mul_inv_cancel_left, a, inv_mul_cancel_right] at h₁ h₂
    exact h₁.symm.trans h₂
  rw [hg]
  rintro x ⟨w, hw, rfl⟩
  have hh : ⁅embedM R a, w⁆ ∈ ⁅Y source i d, localFlagActor source (!i) d⁆ := by
    rw [commutator_comm]
    exact commutator_mem_commutator ha (hWY hw)
  have ht := (V R (beta R) ⊔ ⁅Y source i d, localFlagActor source (!i) d⁆).mul_mem
    (mem_sup_right hh) (mem_sup_left hw)
  change embedM R a * w * (embedM R a)⁻¹ ∈ _
  simpa only [commutatorElement_def, inv_mul_cancel_right] using ht

private theorem fixed_preimage_le_first_sup {G : Type*} [Group G]
    (P Y W U E : Subgroup G)
    (n : RankOnePairing.RankOneFactor P (⁅Y,P⁆ ⊔ U) U)
    (hYP : Y ≤ P) (hUY : U ≤ Y) (hPY : P ≤ normalizer Y)
    (hPU : P ≤ normalizer U) (hgen : Y = W ⊔ ⁅Y,P⁆)
    (hEP : E ≤ P) (hWE : ⁅W,E⁆ ≤ U) (hYE : ⁅Y,E⁆ ≤ W ⊔ U)
    (e : P) (heE : (e : G) ∈ E) (he : n.projection e ≠ 1) :
    commutatorPreimage Y P U ≤ W ⊔ U := by
  let S := ⁅Y,P⁆ ⊔ U
  have hWY : W ≤ Y := hgen ▸ le_sup_left
  have hSY : S ≤ Y := sup_le (le_normalizer_iff_commutator_le_left.mp hPY) hUY
  have hWS : W ≤ normalizer S :=
    (le_inf (hWY.trans (normalizer_commutator_ge_left Y P))
      ((hWY.trans hYP).trans hPU)).trans (normalizer_inf_normalizer_le_normalizer_sup _ _)
  have hgen' : Y = W ⊔ S := by
    dsimp [S]
    rw [← sup_assoc, ← hgen, sup_eq_left.mpr hUY]
  let F := commutatorPreimage Y E U
  have hDF : commutatorPreimage Y P U ≤ F :=
    le_commutatorPreimage (commutatorPreimage_le _ _ _)
      ((commutator_mono le_rfl hEP).trans
        (commutator_commutatorPreimage_le _ _ _ (hYP.trans hPU)))
  have hWF : W ≤ F := le_commutatorPreimage hWY hWE
  intro d hd
  have hdY := commutatorPreimage_le Y P U hd
  have hdprod : d ∈ (W : Set G) * (S : Set G) := by
    rw [← coe_mul_of_left_le_normalizer_right _ _ hWS, ← hgen']
    exact hdY
  obtain ⟨w, hw, s, hs, rfl⟩ := hdprod
  have hsF : s ∈ F := by
    simpa only [inv_mul_cancel_left] using F.mul_mem (F.inv_mem (hWF hw)) (hDF hd)
  have hsU : ⁅(e : G),s⁆ ∈ U := by
    have hh := commutator_commutatorPreimage_le Y E U (hYP.trans hPU)
    rw [commutator_comm] at hh
    exact hh (commutator_mem_commutator heE hsF)
  have hsT : s ∈ W ⊔ U := natural_fixed_lift n e he _ le_sup_right
    (fun x hx => by
      have hh : ⁅E,Y⁆ ≤ W ⊔ U := by rwa [commutator_comm]
      exact hh (commutator_mem_commutator heE (hSY hx))) ⟨s,hs⟩ hsU
  exact (W ⊔ U).mul_mem (mem_sup_left hw) hsT

private theorem eq_of_fixed_preimage_le_sup {G : Type*} [Group G]
    (D W U : Subgroup G) (hUD : U ≤ D) (hWU : W ≤ normalizer U)
    (hD : D ≤ W ⊔ U) (hinter : D ⊓ W ≤ U) : D = U := by
  apply le_antisymm ?_ hUD
  intro x hx
  have hp : x ∈ (W : Set G) * (U : Set G) := by
    rw [← coe_mul_of_left_le_normalizer_right _ _ hWU]
    exact hD hx
  obtain ⟨w, hw, u, hu, rfl⟩ := hp
  have hwD : w ∈ D := by
    simpa only [mul_inv_cancel_right] using D.mul_mem hx (D.inv_mem (hUD hu))
  exact U.mul_mem (hinter ⟨hwD,hw⟩) hu


/-- The endpoint bound puts every full-actor fixed element in V_beta U.
Only the moving subgroup is identified with the natural factor. -/
theorem D_le_first_sup_second_of_endpoint_bound
    (source : LocalSource L R) (geometry : Geometry R)
    (common : CommonFacts R source geometry) (hb : geometry.b R = 4)
    (early : EarlyFacts R geometry) (i : Bool)
    (hkernel : flagKernel source i = Q R (beta R))
    (natural : FlagNaturalSection source i)
    (p : SourceFlagPreparatoryData source geometry i)
    (d : M) (hd : flagIncident source i 1 d) (s : LocalStructure source i d)
    (hE : ¬ Z R p.endpoint ≤ localFlagKernel source (!i) d)
    (hcomm : ⁅Y source i d,Z R p.endpoint⁆ ≤ Z R p.middle ⊔ X source i d) :
    D source i d ≤ V R (beta R) ⊔ secondFlagLayer source i d := by
  let c : FlagCriticalData source geometry i := {
    middle := p.middle
    endpoint := p.endpoint
    critical := p.critical
    middle_neighbor := p.middle_neighbor
    first_distance := p.first_distance
    second_distance := p.second_distance
    middle_triple := p.middle_triple }
  have hEP := Incident.endpoint_le_incidentActor source geometry hb i hkernel c d hd
  have hEW : ⁅V R (beta R),Z R p.endpoint⁆ ≤ secondFlagLayer source i d :=
    ((commutator_mono le_rfl (c.endpoint_le_edgeKernel hb)).trans
      (edgeRadius_commutator_le_edgeZ geometry common.large_distance early)).trans
        ((edge_Z_le (alpha R) (beta R) rfl (base_adjacent R)).trans
          (Z_le_secondFlagLayer source i d))
  have hmiddle : Z R p.middle ≤ V R (beta R) := by
    rw [V_eq_neighborSpan (alpha R) (beta R) rfl (base_adjacent R)]
    exact le_iSup_of_le p.middle (le_iSup_of_le p.middle_neighbor le_rfl)
  have hYE : ⁅Y source i d,Z R p.endpoint⁆ ≤
      V R (beta R) ⊔ secondFlagLayer source i d :=
    hcomm.trans (sup_le_sup hmiddle (X_le_second source geometry common.large_distance i d))
  obtain ⟨e, he, heK⟩ := SetLike.not_le_iff_exists.mp hE
  let a : localFlagActor source (!i) d := ⟨e, hEP he⟩
  have ha : s.moving.projection a ≠ 1 := by
    intro h
    have hk : a ∈ s.moving.projection.ker := h
    rw [s.moving_actor_kernel] at hk
    exact heK hk
  exact fixed_preimage_le_first_sup _ _ _ _ _ s.moving
    (Y_le_actor source geometry common.large_distance i d) (second_le_Y source i d)
    (Y_normalized source i d) (Incident.secondFlagLayer_normalized source geometry common.large_distance i d)
    (Y_eq_first_sup_commutator source i natural d hd) hEP hEW hYE a he ha

/-- Reduction of the fixed-preimage equality to its first-layer intersection.
The final theorem below supplies that intersection from incident-core generation. -/
theorem D_eq_second_of_endpoint_bound_of_first_intersection
    (source : LocalSource L R) (geometry : Geometry R)
    (common : CommonFacts R source geometry) (hb : geometry.b R = 4)
    (early : EarlyFacts R geometry) (i : Bool)
    (hkernel : flagKernel source i = Q R (beta R))
    (natural : FlagNaturalSection source i)
    (p : SourceFlagPreparatoryData source geometry i)
    (d : M) (hd : flagIncident source i 1 d) (s : LocalStructure source i d)
    (hE : ¬ Z R p.endpoint ≤ localFlagKernel source (!i) d)
    (hcomm : ⁅Y source i d,Z R p.endpoint⁆ ≤ Z R p.middle ⊔ X source i d)
    (hinter : D source i d ⊓ V R (beta R) ≤ secondFlagLayer source i d) :
    D source i d = secondFlagLayer source i d := by
  have hWY : V R (beta R) ≤ Y source i d := by
    simpa only [firstFlagLayer, localConjugate_one] using first_le_Y source i 1 d hd
  exact eq_of_fixed_preimage_le_sup _ _ _ (second_le_D source geometry common.large_distance i d)
    (hWY.trans (Y_normalizes_second source geometry common.large_distance i d))
    (D_le_first_sup_second_of_endpoint_bound source geometry common hb early i hkernel natural p d hd s hE hcomm)
    hinter

/-- The source fixed-preimage equality under the contrary product containment
and its endpoint bound. The moving-factor reduction and incident-core generation
discharge every intermediate premise. The product containment is retained for
the escape consumer; its explicit commutator consequence suffices here. -/
theorem D_eq_second_of_endpoint_bound
    (source : LocalSource L R) (geometry : Geometry R)
    (common : CommonFacts R source geometry) (hb : geometry.b R = 4)
    (early : EarlyFacts R geometry) (i : Bool)
    (hkernel : flagKernel source i = Q R (beta R))
    (natural : FlagNaturalSection source i)
    (p : SourceFlagPreparatoryData source geometry i)
    (hlocal : ∀ d : M, flagIncident source i 1 d → Nonempty (LocalStructure source i d))
    (d : M) (hd : flagIncident source i 1 d)
    (hE : ¬ Z R p.endpoint ≤ localFlagKernel source (!i) d)
    (_hY : Y source i d ≤ X source i d ⊔ Q R p.middle)
    (hcomm : ⁅Y source i d, Z R p.endpoint⁆ ≤ Z R p.middle ⊔ X source i d) :
    D source i d = secondFlagLayer source i d := by
  obtain ⟨s⟩ := hlocal d hd
  exact D_eq_second_of_endpoint_bound_of_first_intersection
    source geometry common hb early i hkernel natural p d hd s hE hcomm
    (D_inf_first_le_second source geometry common early i hkernel d hd)

