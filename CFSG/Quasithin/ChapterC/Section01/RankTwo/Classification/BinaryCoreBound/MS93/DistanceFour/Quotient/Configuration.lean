module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Quotient.Factors

/-!
# The two geometric branches of MS93 (4.6.11)--(4.6.12)

A critical path of length four has a midpoint at distance two from each end.
`SmallIntersection` is the literal commutator containment distinguishing the
two printed branches. `orbitSpan` is the subgroup generated by the ambient
M-conjugates of the indicated Z-layer. `coreOrbit` takes its intersection
with the actual core by the subgroupOf convention.

`OrbitFactors` specifies two marked factors lying in these geometric spans.
It has no constructor here: the source argument must construct the factor
maps, prove their kernel and action equations, and establish generation and
intersection. The surrounding quotient assembly does not assume a center
equality or a module classification.

Source: original Meierfrankenfeld--Stellmacher (1993), pp.909--912.
-/

@[expose] public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour
variable {M : Type*} [Group M] {R : Subgroup M} (geometry : Geometry R)

structure CriticalSegment where
  endpoint : Vertex R
  middle : Vertex R
  critical : CriticalPair R (alpha R) endpoint (geometry.exists_critical (alpha R) rfl)
  first_distance : (cosetGraph R).dist (alpha R) middle = 2
  second_distance : (cosetGraph R).dist middle endpoint = 2

theorem exists_criticalSegment (hb : geometry.b R = 4) :
    Nonempty (CriticalSegment geometry) := by
  obtain ⟨e, he⟩ := criticalPair_exists R (alpha R) (geometry.exists_critical (alpha R) rfl)
  obtain ⟨p, hp⟩ := (cosetGraph_connected R).exists_walk_length_eq_dist (alpha R) e
  have hl : p.length = 4 := hp.trans (he.1.trans hb)
  refine ⟨⟨e, p.getVert 2, he, ?_, ?_⟩⟩
  · have h := SimpleGraph.length_eq_dist_of_subwalk hp (p.isSubwalk_take 2)
    simpa [SimpleGraph.Walk.take_length, hl] using h.symm
  · have h := SimpleGraph.length_eq_dist_of_subwalk hp (p.isSubwalk_drop 2)
    simpa [SimpleGraph.Walk.drop_length, hl] using h.symm

theorem CriticalSegment.middle_color (s : CriticalSegment geometry) :
    color R s.middle = false := by
  obtain ⟨p, hp⟩ := (cosetGraph_connected R).exists_walk_length_eq_dist (alpha R) s.middle
  have h : Even p.length := by rw [hp, s.first_distance]; decide
  exact ((walk_even_iff_color_eq R p).mp h).symm

def CriticalSegment.SmallIntersection (s : CriticalSegment geometry) : Prop :=
  ⁅V R (alpha R) ⊓ Q R s.middle, V R s.middle⁆ ≤ Z R (alpha R)

noncomputable def orbitSpan (c : Vertex R) : Subgroup (FreeAmalgam R) :=
  ⨆ m : M, (Z R c).map (MulAut.conj (embedM R m)).toMonoidHom

noncomputable def coreOrbit (c : Vertex R) : Subgroup (core R (alpha R)) :=
  (orbitSpan c).subgroupOf (core R (alpha R))

variable {L : Subgroup M} (source : LocalSource L R) {geometry}
  (common : CommonFacts R source geometry)

structure OrbitFactors (c : Vertex R) where
  second : Vertex R
  distance : (cosetGraph R).dist (alpha R) second = 2
  left : Subgroup (core R (alpha R))
  right : Subgroup (core R (alpha R))
  left_le : left ≤ coreOrbit c
  right_le : right ≤ coreOrbit second
  left_data : DualFactor source common left
  right_data : DualFactor source common right
  generate : left ⊔ right = ⊤
  intersect : left ⊓ right = (U R (alpha R)).subgroupOf (core R (alpha R))

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour
