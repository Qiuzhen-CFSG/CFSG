module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Quotient.LargeBranch.Algebra
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Quotient.LargeBranch.Spans

/-!
# First-span data and selection of a distinct second factor

`FirstFactor` records the geometric output still needed from the rank-one
argument (4.6.12)(1)--(5): a marked core factor, its noncentral distance-two
vertex, containment of the full conjugate span in that vertex kernel, and
reconstruction of the span from Z_alpha and the core factor.

The proved deductions select rho as on printed p.912. Kernel containment
makes the span abelian. Its intersection with the radius center cannot be
the whole span, by (4.6.10). Thus some Z_rho on the chosen edge does not
centralize it. If that second span has a `FirstFactor`, the factors are
distinct, and the order bound closes the `OrbitFactors` assembly.

This module does not construct `FirstFactor` from the original hypotheses.
In particular its explicit data are not a proof of the rank-one argument.
Source: original MS93 (1993), pp.910--912.
-/

@[expose] public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.LargeBranch
variable {M : Type*} [Group M] {L R : Subgroup M}
  (source : LocalSource L R) {geometry : Geometry R}
  (common : CommonFacts R source geometry)

/-- The first geometric factor to be constructed in (4.6.12)(1)--(5).
The factor is permitted to be a proper subgroup of `coreOrbit c`.
No constructor from the source hypotheses is asserted here. -/
structure FirstFactor (c : Vertex R) where
  factor : Subgroup (core R (alpha R))
  factor_le : factor ≤ coreOrbit c
  data : DualFactor source common factor
  vertex_nu : nu R geometry (alpha R) c
  span_le_kernel : orbitSpan c ≤ Q R c
  span_not_le_Z : ¬ orbitSpan c ≤ Z R (alpha R)
  span_decomposition : orbitSpan c = Z R (alpha R) ⊔ factor.map (core R (alpha R)).subtype

variable {source common}

include geometry in
/-- A distance-two M-orbit is generated by commuting conjugates if it lies
in the kernel at its original vertex. -/
theorem orbitSpan_commutative_of_le_kernel (c : Vertex R)
    (hc : color R c = false) (hq : orbitSpan c ≤ Q R c) :
    IsMulCommutative (orbitSpan c) := by
  apply le_centralizer_iff_isMulCommutative.mp
  have hz : ⁅Z R c, orbitSpan c⁆ = ⊥ := by
    apply le_bot_iff.mp
    rw [← geometry.centralizes c hc]
    exact commutator_mono le_rfl hq
  rw [orbitSpan_eq_stabilizer_span]
  apply iSup_conjugates_le_centralizer _ _ _
  · rw [← orbitSpan_eq_stabilizer_span]
    exact orbitSpan_normalized c
  · rwa [← orbitSpan_eq_stabilizer_span]

namespace FirstFactor
variable {c : Vertex R} (f : FirstFactor source common c)

include f

theorem vertex_color : color R c = false := by
  obtain ⟨p, hp⟩ := (cosetGraph_connected R).exists_walk_length_eq_dist c (alpha R)
  have h : Even p.length := by rw [hp, f.vertex_nu.1]; decide
  exact (walk_even_iff_color_eq R p).mp h

theorem span_commutative : IsMulCommutative (orbitSpan c) :=
  orbitSpan_commutative_of_le_kernel (geometry := geometry) c f.vertex_color f.span_le_kernel

theorem span_not_central [Finite M] (radius : RadiusFacts R geometry) :
    ⁅V R (alpha R), orbitSpan c⁆ ≠ ⊥ := by
  intro h
  have hV := orbitSpan_le_radius c f.vertex_nu.1.le
  have hB : orbitSpan c ≤ B R (alpha R) (geometry.Z_normal (alpha R)) := by
    rw [radius.B_eq_center (alpha R) rfl]
    intro x hx
    refine ⟨⟨x, hV hx⟩, ?_, rfl⟩
    apply mem_center_iff.mpr
    intro y
    apply Subtype.ext
    exact (commutator_eq_bot_iff_le_centralizer.mp h y.property x hx).symm
  apply f.span_not_le_Z
  rw [← radius.star_intersection (alpha R) (beta R) rfl (base_adjacent R)]
  exact le_inf (orbitSpan_le_star geometry radius.toEarlyFacts _ _ (base_adjacent R) f.vertex_nu) hB

theorem exists_second_seed [Finite M] (radius : RadiusFacts R geometry) :
    ∃ rho, nu R geometry (alpha R) rho ∧ Adjacent R (beta R) rho ∧
      ⁅Z R rho, orbitSpan c⁆ ≠ ⊥ :=
  exists_noncentral_neighbor source common radius (beta R) (base_adjacent R)
    (orbitSpan c) (orbitSpan_le_radius c f.vertex_nu.1.le) (orbitSpan_normalized c)
    (f.span_not_central radius)

/-- The second span selected by noncommutation cannot give the same core
factor. Equality of factors would make the two full spans equal and abelian. -/
theorem factor_ne_of_noncommuting {rho : Vertex R}
    (g : FirstFactor source common rho) (hne : ⁅Z R rho, orbitSpan c⁆ ≠ ⊥) :
    f.factor ≠ g.factor := by
  intro he
  have hspan : orbitSpan rho = orbitSpan c := by
    rw [g.span_decomposition, f.span_decomposition, he]
  apply hne
  apply commutator_eq_bot_iff_le_centralizer.mpr
  have hZ : Z R rho ≤ orbitSpan c := hspan ▸ Z_le_orbitSpan rho
  exact hZ.trans (le_centralizer_iff_isMulCommutative.mpr f.span_commutative)

/-- Once the selected second span has its factor, the source order bound
closes both intersection and generation without additional hypotheses. -/
theorem orbitFactors_of_second [Finite M] (radius : RadiusFacts R geometry)
    {rho : Vertex R} (g : FirstFactor source common rho)
    (hne : ⁅Z R rho, orbitSpan c⁆ ≠ ⊥)
    (hbound : Nat.card (core R (alpha R)) ≤ 512) :
    Nonempty (OrbitFactors source common c) := by
  apply orbitFactors_of_distinct radius c rho
    ((cosetGraph R).dist_comm.trans g.vertex_nu.1)
    f.factor g.factor f.factor_le g.factor_le f.data g.data
    (f.factor_ne_of_noncommuting g hne) hbound

end FirstFactor
end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.LargeBranch
