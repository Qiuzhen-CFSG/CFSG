module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.Escape.PairingControl.FirstPairing.Orientation.QuotientApplication.Natural

/-!
# The selected seed and the remaining first-pairing obligations

`SelectedSeed` retains a genuine element of a moving neighbor outside B,
one marked flag, and the shared fixed-space orientation. We keep the raw
parabolic closure separate and adjoin the Z-image to form the subgroup X
used in (1.7). This ensures Z ≤ X; the commutator with W is unchanged,
as proved below. No equality of the raw and enlarged seeds is asserted.
Normality is relative to the parabolic, and W is the image of Q_alpha.

`PairingPremises` lists the still unproved local assertions needed to apply
(1.7) to this seed, together with the moving-subgroup containment needed by
the transfer. It has no constructor from the source assumptions here.
Selection and verification can be proved independently: verification takes
the selected seed as an explicit input. The source-only application must
construct both; the conditional application below is not (4.3.2)(2).

Source: Meierfrankenfeld--Stellmacher (1993), printed p.883, first application
of (1.7)(i); the untilded local residuals are those of pp.832,847.
-/

@[expose] public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.Escape.PairingControl.FirstPairing.Orientation.QuotientApplication
open RankOnePairing
variable {M : Type*} [Group M] {L R : Subgroup M}

/-- The supplied frame's actual descended projection. -/
abbrev projection {a : Vertex R} (f : FrameAt a) : LocalQuotient a →* SL :=
  quotientProjection a f.projection f.natural_section.projection_kernel

/-- The source choice of x, with the marked conjugated flag. Neither
the final commutator bounds nor the pairing's hypotheses are built into it. -/
structure SelectedSeed (geometry : Geometry R) (a : Vertex R) (f : FrameAt a) where
  neighbor : Vertex R
  moving : neighbor ∈ movingNeighbors geometry a
  element : stabilizer R a
  element_mem : (element : FreeAmalgam R) ∈ Z R neighbor
  outside : (element : FreeAmalgam R) ∉ B R a (geometry.Z_normal a)
  flag : SL
  weakBN : BinaryWeakBN flag
  side : Bool
  fixed_Z : quotientImage a (Z R a) ⊓ centralizer
    (localResidual (parabolic (projection f) flag side) : Set (LocalQuotient a)) ≠ ⊥
  fixes_seed : ⁅zpowers (quotientMap a element),
    localResidual (parabolic (projection f) flag side)⁆ ≤
      quotientImage a (B R a (geometry.Z_normal a))

namespace SelectedSeed
variable {geometry : Geometry R} {a : Vertex R} {f : FrameAt a}
  (s : SelectedSeed geometry a f)

/-- Every selected model flag has an actual conjugator in the vertex group. -/
theorem exists_conjugator : ∃ g : stabilizer R a, f.projection g = s.flag :=
  f.natural_section.projection_surjective s.flag

/-- Exactly the subgroup generated by the parabolic conjugates of x. -/
noncomputable def raw : Subgroup (LocalQuotient a) :=
  localGenerated (parabolic (projection f) s.flag s.side) (zpowers (quotientMap a s.element))

/-- The admissible (1.7) seed, including its required natural subgroup. -/
noncomputable def X : Subgroup (LocalQuotient a) := quotientImage a (Z R a) ⊔ s.raw

theorem Z_le_X : quotientImage a (Z R a) ≤ s.X := le_sup_left

/-- The fixed preimage C inside the actual ambient normal closure of X. -/
noncomputable def C : Subgroup (LocalQuotient a) :=
  letI := quotientImage_normal a (Z R a) (Z_normalized R a)
  fixedPreimage (component (projection f) s.flag) s.X (quotientImage a (Z R a))

theorem X_normal :
    (s.X.subgroupOf (parabolic (projection f) s.flag s.side)).Normal :=
  normal_subgroupOf_of_le_normalizer (by
    let := quotientImage_normal a (Z R a) (Z_normalized R a)
    exact (le_inf le_normalizer_of_normal
      (Incidence.localGenerated_normalized _ _)).trans
        (normalizer_inf_normalizer_le_normalizer_sup _ _))

variable [Finite M]

/-- The genuine two-group-kernel extension attached to this flag. -/
noncomputable def extension (source : LocalSource L R) (ha : color R a = false) :
    Extension (M := LocalQuotient a) :=
  quotientExtension source a ha f.projection f.natural_section.projection_surjective
    f.natural_section.projection_kernel s.flag s.weakBN

@[simp] theorem extension_projection (source : LocalSource L R) (ha : color R a = false) :
    (s.extension source ha).projection = projection f := rfl

@[simp] theorem extension_flag (source : LocalSource L R) (ha : color R a = false) :
    (s.extension source ha).flag = s.flag := rfl

@[simp] theorem localParabolic_extension (source : LocalSource L R)
    (ha : color R a = false) (i : Bool) :
    localParabolic (s.extension source ha) i = parabolic (projection f) s.flag i :=
  quotientExtension_parabolic source a ha f.projection f.natural_section.projection_surjective
    f.natural_section.projection_kernel s.flag s.weakBN i

/-- The local closure stays inside the actual image of Q_alpha. -/
theorem X_le_Q (hb : 2 < geometry.b R) (ha : color R a = false) :
    s.X ≤ quotientImage a (Q R a) := by
  let := quotientImage_normal a (Q R a) (Q_normalized R a)
  apply sup_le
  · apply map_mono
    intro x hx
    apply geometry.V_le_Q hb a ha
    have hZV : Z R a ≤ V R a := le_iSup_of_le a
      (le_iSup_of_le (show (cosetGraph R).dist a a ≤ 2 by simp) le_rfl)
    exact hZV hx
  · apply Incidence.localGenerated_le_of_normalizes _ _ _ le_normalizer_of_normal
    apply zpowers_le.mpr
    apply mem_map_of_mem
    exact geometry.V_le_Q hb a ha (moving_Z_le_V s.moving s.element_mem)

omit [Finite M] in
/-- Adjoining Z makes the seed admissible without changing its pairing. -/
theorem X_commutator_Q (ha : color R a = false) :
    ⁅s.X, quotientImage a (Q R a)⁆ = ⁅s.raw, quotientImage a (Q R a)⁆ := by
  let := quotientImage_normal a (Q R a) (Q_normalized R a)
  have hZ : ⁅quotientImage a (Z R a), quotientImage a (Q R a)⁆ = ⊥ := by
    rw [← quotientImage_commutator a _ _ (Z_le_stabilizer R a)
      (show Q R a ≤ stabilizer R a from fun _ hx => hx.1), geometry.centralizes a ha]
    simp [quotientImage]
  rw [commutator_comm s.X, commutator_comm s.raw]
  exact (commutator_eq_of_centralizing_sup rfl
    (commutator_eq_bot_iff_le_centralizer.mp hZ) le_normalizer_of_normal).symm

end SelectedSeed

variable [Finite M] {source : LocalSource L R} {geometry : Geometry R}
  {a : Vertex R} {f : FrameAt a}

/-- Remaining local hypotheses, not conclusions of the source theorem.
The group W is always the image of Q_alpha, never the image of B_alpha. -/
structure PairingPremises (s : SelectedSeed geometry a f) where
  frattini_le : (frattini (generated s.X)).map (generated s.X).subtype ≤
    quotientImage a (Z R a)
  commutator_le : ⁅s.X, quotientImage a (Q R a)⁆ ≤ quotientImage a (Z R a)
  commutator_nontrivial : Nat.card (⁅s.X, quotientImage a (Q R a)⁆ : Subgroup (LocalQuotient a)) ≠ 1
  commutator_card_le : Nat.card (⁅s.X, quotientImage a (Q R a)⁆ : Subgroup (LocalQuotient a)) ≤ 4
  seed_fixed : ⁅s.X, localResidual (parabolic (projection f) s.flag s.side)⁆ ≤ s.C
  rank_one_natural : RankOneFactor
    (localResidual (parabolic (projection f) s.flag (!s.side)))
    (localGenerated (parabolic (projection f) s.flag (!s.side)) s.X) s.C
  moving_le : quotientImage a (Vcirc R a) ≤ generated s.X

/-- Assemble precisely the source inputs, supplying natural coordinates and
the relative normality and two-core containments proved in this development. -/
noncomputable def sourceData (hb : 2 < geometry.b R) (modules : ModuleFacts source geometry)
    (ha : color R a = false) (s : SelectedSeed geometry a f) (h : PairingPremises s) :
    letI := quotientImage_normal a (Z R a) (Z_normalized R a)
    letI := quotientImage_normal a (Q R a) (Q_normalized R a)
    SourceData (s.extension source ha) s.side
      (quotientImage a (Z R a)) (quotientImage a (Q R a)) s.X := by
  let := quotientImage_normal a (Z R a) (Z_normalized R a)
  let := quotientImage_normal a (Q R a) (Q_normalized R a)
  have he : extensionCore (s.extension source ha).projection = quotientImage a (Q R a) :=
    quotientExtension_core source a ha f.projection f.natural_section.projection_surjective
      f.natural_section.projection_kernel s.flag s.weakBN
  refine {
    z_le := s.Z_le_X
    x_le := he.symm ▸ s.X_le_Q hb ha
    w_le := he.ge
    x_normal := ?_
    natural := ?_
    frattini_le := h.frattini_le
    commutator_le := h.commutator_le
    commutator_nontrivial := h.commutator_nontrivial
    commutator_card_le := h.commutator_card_le
    seed_fixed := ?_
    rank_one_natural := ?_ }
  · rw [s.localParabolic_extension source ha]
    exact s.X_normal
  · let n := naturalZ modules a ha f
    exact { n with
      normalized := le_top.trans n.normalized
      action := fun l _ x y hy => n.action l (mem_top _) x y hy }
  · simpa only [s.localParabolic_extension source ha, s.extension_projection source ha,
      s.extension_flag source ha, SelectedSeed.C] using h.seed_fixed
  · simpa only [s.localParabolic_extension source ha, s.extension_projection source ha,
      s.extension_flag source ha, SelectedSeed.C] using h.rank_one_natural

/-- Conditional application with every remaining seed obligation visible.
The source-only theorem must still supply s and h. -/
theorem bounds_of_selectedSeed (hb : 2 < geometry.b R)
    (modules : ModuleFacts source geometry) (transfer : NormalizationTransfer R)
    (ha : color R a = false) (s : SelectedSeed geometry a f) (h : PairingPremises s) :
    BoundsAt geometry a := by
  apply bounds_of_pairing hb transfer a ha f s.flag s.weakBN s.side s.X
    (sourceData hb modules ha s h) _ h.moving_le
  change quotientImage a (Z R a) ⊓
    centralizer (localResidual (localParabolic (s.extension source ha) s.side) :
      Set (LocalQuotient a)) ≠ ⊥
  simpa only [s.localParabolic_extension source ha] using s.fixed_Z

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.Escape.PairingControl.FirstPairing.Orientation.QuotientApplication
