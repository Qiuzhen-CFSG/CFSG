module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.Escape.Propagation.RadiusFour.Stages
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.Escape.Propagation.Backward.Geometry

/-!
# Geodesics and local products in the forward radius-four argument

A normal local join of two radius groups can be conjugated toward an arbitrary
vertex before estimating its distance. Noncommutation with a radius-four ball
selects an actual critical pair and forces equality in both distance bounds.
A shortest walk then provides the midpoint for the reversed configuration.

Source: Meierfrankenfeld--Stellmacher (1993), (4.3.8), first three paragraphs
of printed p.889. These geometric lemmas do not assume a radius-four bound.
-/

public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.Escape.Propagation.RadiusFour.Forward
variable {M : Type*} [Group M] {R : Subgroup M} {geometry : Geometry R}

/-- An even radius ball is generated by its M-colored vertices. -/
theorem VBall_le_iff {a : Vertex R} (ha : color R a = false) {n : ℕ}
    (K : Subgroup (FreeAmalgam R)) :
    VBall R a n ≤ K ↔ ∀ d, color R d = false →
      (cosetGraph R).dist d a ≤ n → Z R d ≤ K := by
  constructor
  · intro h d _ hd
    have hz : Z R d ≤ VBall R a n := le_iSup_of_le d (le_iSup_of_le hd le_rfl)
    exact hz.trans h
  · intro h
    apply iSup_le
    intro d
    apply iSup_le
    intro hd
    by_cases hc : color R d = false
    · exact h d hc hd
    · have hne : d ≠ a := by intro e; exact hc (e ▸ ha)
      obtain ⟨s, hds, hsa⟩ := exists_adjacent_dist_sub_one R d a
        ((cosetGraph_connected R).pos_dist_of_ne hne)
      have hs : color R s = false := by
        have hh := adjacent_color_ne R hds
        cases hdc : color R d <;> cases hsc : color R s <;> simp_all
      exact (EdgeTransfer.edge_Z_le s d hs (adjacent_symm R hds)).trans
        (h s hs (by omega))

/-- Local normality permits moving the off-path radius group toward the
specified endpoint before estimating its distance. -/
theorem normal_product_le_Q [Finite M] {a d x : Vertex R} (ha : color R a = false)
    (hlarge : 4 < geometry.b R) (had : (cosetGraph R).dist a d = 2)
    (hlocal : V R d ⊔ V R a ≤ stabilizer R a)
    (hnormal : ((V R d ⊔ V R a).subgroupOf (stabilizer R a)).Normal)
    (hnear : (cosetGraph R).dist a x + 2 < geometry.b R) :
    V R d ⊔ V R a ≤ Q R x := by
  by_cases hax : a = x
  · subst x
    exact Backward.product_le_Q ha hlarge had
  obtain ⟨t, hat, hdt⟩ := exists_common_neighbor_of_dist_two R a d had
  obtain ⟨s, has, hsx⟩ := exists_adjacent_dist_sub_one R a x
    ((cosetGraph_connected R).pos_dist_of_ne hax)
  obtain ⟨g, hg, hgt⟩ := stabilizer_transitive_neighbors R a hat has
  have hn := (normal_subgroupOf_iff_le_normalizer hlocal).mp hnormal
  have heq : V R d ⊔ V R a = V R (act R g d) ⊔ V R a := by
    have hga : act R g a = a := hg
    have hh := mem_normalizer_iff_map_conj_eq.mp (hn ((stabilizer R a).inv_mem hg))
    change (V R d ⊔ V R a).map (MulAut.conj g⁻¹).toMonoidHom = V R d ⊔ V R a at hh
    rw [Subgroup.map_sup, ← V_act, ← V_act, hga] at hh
    exact hh.symm
  rw [heq]
  apply sup_le _ (Backward.V_le_Q_of_dist_add_two_lt ha hnear)
  have hgd : color R (act R g d) = false := by
    rw [action_preserves_color]
    exact (color_eq_of_dist_even R a d (had.symm ▸ (by decide : Even 2))).symm.trans ha
  have hgs : Adjacent R (act R g d) s := by
    rw [← hgt]
    exact (adjacent_act_iff R g d t).mpr hdt
  apply Backward.V_le_Q_of_dist_add_two_lt hgd
  have hdist := SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj R _ _).mpr hgs)
  have htri := (cosetGraph_connected R).dist_triangle (u := act R g d) (v := s) (w := x)
  omega

/-- Noncommutation selects a genuine critical pair, and saturates both
radius and endpoint distance bounds. -/
theorem exists_critical_of_not_commuting [Finite M] {a l : Vertex R}
    (ha : color R a = false) (hl : color R l = false)
    (hnear : (cosetGraph R).dist a l + 4 ≤ geometry.b R)
    (hne : ⁅VBall R a 4, Z R l⁆ ≠ ⊥) :
    ∃ x, ∃ hx : color R x = false,
      (cosetGraph R).dist x a = 4 ∧
      (cosetGraph R).dist a l + 4 = geometry.b R ∧
      CriticalPair R x l (geometry.exists_critical x hx) := by
  classical
  have hn : ¬ VBall R a 4 ≤ centralizer (Z R l : Set (FreeAmalgam R)) := by
    intro h
    exact hne (commutator_eq_bot_iff_le_centralizer.mpr h)
  obtain ⟨x, hx, hxa, hnot⟩ : ∃ x, color R x = false ∧
      (cosetGraph R).dist x a ≤ 4 ∧
      ¬ Z R x ≤ centralizer (Z R l : Set (FreeAmalgam R)) := by
    simpa only [VBall_le_iff ha, not_forall, exists_prop] using hn
  have hQ : ¬ Z R x ≤ Q R l := by
    intro h
    exact hnot (h.trans (le_centralizer_iff.mp
      (commutator_eq_bot_iff_le_centralizer.mp (geometry.centralizes l hl))))
  have hmin := criticalDistance_le R x (geometry.exists_critical x hx) hQ
  rw [geometry.distance_constant x hx] at hmin
  change geometry.b R ≤ (cosetGraph R).dist x l at hmin
  have htri := (cosetGraph_connected R).dist_triangle (u := x) (v := a) (w := l)
  refine ⟨x, hx, by omega, by omega, ?_, hQ⟩
  rw [geometry.distance_constant x hx]
  change (cosetGraph R).dist x l = geometry.b R
  omega

/-- The endpoint of the second local conjugation has the original M-color. -/
theorem lam_color [Finite M] (p : Counterexample geometry) {d t₃ t₅ : Vertex R}
    (w : CentralOrbitWitnesses p d t₃ t₅) : color R w.lam = false := by
  rw [← w.second_image, action_preserves_color, ← w.first_image,
    action_preserves_color, p.end_color]

/-- Its prescribed edge is enough for the radius-four upper distance bound;
the actual conjugators are retained by the witness. -/
theorem lam_distance_bound (p : Counterexample geometry) {d t₃ t₅ : Vertex R}
    (h₅ : Before p.a p.a' t₅ 5) (w : CentralOrbitWitnesses p d t₃ t₅) :
    (cosetGraph R).dist p.a w.lam + 4 ≤ geometry.b R := by
  have hpath := h₅.2
  rw [p.distance_eq_b] at hpath
  have hadj : (cosetGraph R).dist t₅ w.lam = 1 :=
    SimpleGraph.dist_eq_one_iff_adj.mpr
      ((cosetGraph_adj R _ _).mpr (adjacent_symm R w.second_adjacent))
  have htri := (cosetGraph_connected R).dist_triangle (u := p.a) (v := t₅) (w := w.lam)
  omega

/-- Selecting the midpoint of an actual length-four geodesic gives the
second predecessor needed by the reversed configuration. -/
theorem exists_midpoint {x a : Vertex R} (hxa : (cosetGraph R).dist x a = 4) :
    ∃ y, (cosetGraph R).dist x y = 2 ∧ (cosetGraph R).dist y a = 2 := by
  obtain ⟨w, hw⟩ := (cosetGraph_connected R).exists_walk_length_eq_dist x a
  have hlen : w.length = 4 := hw.trans hxa
  have ht := SimpleGraph.length_eq_dist_of_subwalk hw (w.isSubwalk_take 2)
  have hd := SimpleGraph.length_eq_dist_of_subwalk hw (w.isSubwalk_drop 2)
  refine ⟨w.getVert 2, ?_, ?_⟩
  · simpa only [SimpleGraph.Walk.take_length, hlen, Nat.min_eq_left (by decide : 2 ≤ 4)] using ht.symm
  · simpa only [SimpleGraph.Walk.drop_length, hlen] using hd.symm


end CFSG.Quasithin.ChapterC.BinaryMS.MS93.Escape.Propagation.RadiusFour.Forward
