/-- An edge radius is abelian for b > 2, before the module alternatives. -/
theorem edge_radius_commutative (geometry : Geometry R) (hb : 2 < geometry.b R)
    (a t : Vertex R) (ha : color R a = false) (hat : Adjacent R a t) :
    IsMulCommutative (V R t) := by
  apply le_centralizer_iff_isMulCommutative.mp
  apply radius_le_of_h_neighbors ha hat
  intro d hdt
  have ht : color R t = true := by
    have hn := adjacent_color_ne R hat
    cases h : color R t <;> simp_all
  have hd : color R d = false := by
    have hn := adjacent_color_ne R hdt
    cases h : color R d <;> simp_all
  apply le_centralizer_iff.mpr
  apply radius_le_of_h_neighbors ha hat
  intro e het
  have he : color R e = false := by
    have hn := adjacent_color_ne R het
    cases h : color R e <;> simp_all
  have hZe : Z R e ≤ Q R d := by
    apply Z_le_Q_of_dist_lt R e (geometry.exists_critical e he)
    rw [geometry.distance_constant e he]
    have h₁ := SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj R _ _).mpr het)
    have h₂ := SimpleGraph.dist_eq_one_iff_adj.mpr
      ((cosetGraph_adj R _ _).mpr (adjacent_symm R hdt))
    have htri := (cosetGraph_connected R).dist_triangle (u := e) (v := t) (w := d)
    exact lt_of_le_of_lt (by omega) hb
  exact hZe.trans (le_centralizer_iff.mp
    (commutator_eq_bot_iff_le_centralizer.mp (geometry.centralizes d hd)))

/-- Centrality of the moving radius would make the whole radius abelian. -/
theorem radius_commutative_of_moving_central (source : LocalSource L R)
    (geometry : Geometry R) (hb : 2 < geometry.b R) (a t : Vertex R)
    (ha : color R a = false) (hat : Adjacent R a t)
    (hc : Vcirc R a ≤ centralizer (V R a : Set (FreeAmalgam R))) :
    IsMulCommutative (V R a) := by
  have hVt := edge_radius_le_radius ha hat
  have ht := le_centralizer_iff_isMulCommutative.mpr (edge_radius_commutative geometry hb a t ha hat)
  apply le_centralizer_iff_isMulCommutative.mp
  rw [radius_eq_moving_sup_edge source ha hat]
  apply sup_le
  · rw [← radius_eq_moving_sup_edge source ha hat]
    exact hc
  · apply le_centralizer_iff.mpr
    apply sup_le (hc.trans (centralizer_le hVt)) ht

omit [Finite M] in
private theorem fixedCore_normalized (a : Vertex R) :
    stabilizer R a ≤ normalizer (fixedCore R a : Set (FreeAmalgam R)) := by
  have heq : (fixedCore R a).subgroupOf (stabilizer R a) =
      (Q R a).subgroupOf (stabilizer R a) ⊓
        centralizer (pResidual 2 (stabilizer R a) : Set (stabilizer R a)) := by
    ext x
    constructor
    · intro hx
      refine ⟨hx.1, ?_⟩
      intro l hl
      apply Subtype.ext
      exact hx.2 l (mem_map_of_mem (stabilizer R a).subtype hl)
    · rintro ⟨hx,hc⟩
      refine ⟨hx, ?_⟩
      rintro _ ⟨l,hl,rfl⟩
      exact congrArg Subtype.val (hc l hl)
  apply (normal_subgroupOf_iff_le_normalizer
    (show fixedCore R a ≤ stabilizer R a from inf_le_left.trans (fun _ hx => hx.1))).mp
  rw [heq]
  let := Q_normal R a
  infer_instance

private theorem commutator_iSup_le_of_normalizes {G : Type*} [Group G] {ι : Sort*}
    (A : ι → Subgroup G) (Y D : Subgroup G)
    (hn : (⨆ i, A i) ≤ normalizer D) (hc : ∀ i, ⁅A i,Y⁆ ≤ D) :
    ⁅⨆ i, A i,Y⁆ ≤ D := by
  apply commutator_le.mpr
  intro x hx y hy
  revert y
  induction hx using iSup_induction' with
  | hp i x hx =>
      intro y hy
      exact hc i (commutator_mem_commutator hx hy)
  | h1 =>
      intro y hy
      simpa only [commutatorElement_one_left] using D.one_mem
  | hmul x z hx _ ihx ihz =>
      intro y hy
      rw [commutatorElement_mul_left_eq_conj_mul]
      exact D.mul_mem ((mem_normalizer_iff.mp (hn hx) _).mp (ihz y hy)) (ihx y hy)

/-- In every bad binary branch, the derived radius group is fixed by its
local residual. Critical pairs give the only nontrivial generator commutators,
and their common midpoint supplies the fixed-core containment. -/
theorem radius_derived_le_fixed (source : LocalSource L R)
    (geometry : Geometry R) (hb : 2 < geometry.b R) (hbad : BadCase source)
    (a : Vertex R) (ha : color R a = false) : ⁅V R a, V R a⁆ ≤ fixedCore R a := by
  have hfour := distance_eq_four source geometry hb hbad
  let I := {d : Vertex R // color R d = false ∧ (cosetGraph R).dist d a ≤ 2}
  have heq : V R a = ⨆ d : I, Z R d.val := by
    apply le_antisymm
    · apply radius_le_of_m_ball ha
      intro d hd hdist
      exact le_iSup_of_le (⟨d, hd, hdist⟩ : I) le_rfl
    · apply iSup_le
      intro d
      exact le_iSup_of_le d.val (le_iSup_of_le d.property.2 le_rfl)
  have hn : V R a ≤ normalizer (fixedCore R a : Set (FreeAmalgam R)) :=
    ((geometry.V_le_Q hb a ha).trans (fun _ hx => hx.1)).trans (fixedCore_normalized a)
  rw [heq] at hn ⊢
  apply commutator_iSup_le_of_normalizes _ _ _ hn
  intro d
  rw [commutator_comm]
  apply commutator_iSup_le_of_normalizes _ _ _ hn
  intro e
  by_cases hZQ : Z R e.val ≤ Q R d.val
  · exact (commutator_eq_bot_iff_le_centralizer.mpr
      (hZQ.trans (le_centralizer_iff.mp
        (commutator_eq_bot_iff_le_centralizer.mp (geometry.centralizes d.val d.property.1))))).le.trans bot_le
  have hmin := criticalDistance_le R e.val (geometry.exists_critical e.val e.property.1) hZQ
  have hecrit : criticalDistance R e.val (geometry.exists_critical e.val e.property.1) = 4 :=
    (geometry.distance_constant e.val e.property.1).trans hfour
  have hdcrit : criticalDistance R d.val (geometry.exists_critical d.val d.property.1) = 4 :=
    (geometry.distance_constant d.val d.property.1).trans hfour
  rw [hecrit] at hmin
  have hda : (cosetGraph R).dist a d.val ≤ 2 := by
    simpa only [SimpleGraph.dist_comm] using d.property.2
  have htri := (cosetGraph_connected R).dist_triangle (u := e.val) (v := a) (w := d.val)
  have hd : (cosetGraph R).dist e.val d.val = 4 := by omega
  have hc : CriticalPair R e.val d.val (geometry.exists_critical e.val e.property.1) :=
    ⟨by rw [hecrit]; exact hd, hZQ⟩
  have hZXe := geometry.omega_bound e.val e.property.1 (by
    rw [hecrit]; decide)
  have hZXd := geometry.omega_bound d.val d.property.1 (by
    rw [hdcrit]; decide)
  exact (commutator_mono hZXe hZXd).trans
    (critical_commutator_le_fixed_midpoint source geometry hb hbad e.val e.property.1 d.val hc
      a ha (by omega) (by omega))

/-- Critical noncommutation excludes an abelian radius at its midpoint. -/
theorem critical_midpoint_radius_not_commutative (source : LocalSource L R)
    (geometry : Geometry R) (a : Vertex R) (ha : color R a = false) (a' : Vertex R)
    (hc : CriticalPair R a a' (geometry.exists_critical a ha)) (c : Vertex R)
    (hac : (cosetGraph R).dist a c = 2) (hca' : (cosetGraph R).dist c a' = 2) :
    ¬ IsMulCommutative (V R c) := by
  intro hcomm
  have hZa : Z R a ≤ V R c := le_iSup_of_le a (le_iSup_of_le hac.le le_rfl)
  have hZa' : Z R a' ≤ V R c := le_iSup_of_le a' (le_iSup_of_le
    (by rw [SimpleGraph.dist_comm, hca']) le_rfl)
  exact source.critical_noncommutation geometry a ha hc
    (commutator_eq_bot_iff_le_centralizer.mpr (hZa.trans
      ((le_centralizer_iff_isMulCommutative.mpr hcomm).trans (centralizer_le hZa'))))

/-- The radius moving group is fully generated by its residual commutators. -/
theorem moving_full_commutation (source : LocalSource L R) (geometry : Geometry R)
    (hb : 2 < geometry.b R) (a : Vertex R) (ha : color R a = false) :
    ⁅Vcirc R a, Ltilde R a⁆ = Vcirc R a := by
  let S := stabilizer R a
  let W := (V R a).subgroupOf S
  let := finite_stabilizer R a
  let : W.Normal := normal_subgroupOf_of_le_normalizer (V_normalized a)
  have hV : V R a ≤ S := (geometry.V_le_Q hb a ha).trans (fun _ hx => hx.1)
  have hid := commutator_isPPerfect_idempotent (pResidual 2 S) W
    (isPPerfect_pResidual 2) (source.V_isPGroup geometry hb a ha).comap_subtype
    le_normalizer_of_normal
  have hh := congrArg (Subgroup.map S.subtype) hid
  have hW : W.map S.subtype = V R a := map_subgroupOf_eq_of_le hV
  simpa only [map_commutator, hW, Ltilde, Vcirc] using hh

omit [Finite M] in
/-- A fixed derived radius makes the moving radius centralize that derived
subgroup, by the three-subgroups lemma. -/
theorem moving_centralizes_derived (a : Vertex R)
    (hfixed : ⁅V R a, V R a⁆ ≤ fixedCore R a) :
    ⁅Vcirc R a, ⁅V R a, V R a⁆⁆ = ⊥ := by
  let D := ⁅V R a, V R a⁆
  have hDL : ⁅D, Ltilde R a⁆ = ⊥ :=
    commutator_eq_bot_iff_le_centralizer.mpr (hfixed.trans inf_le_right)
  have hnorm : V R a ≤ normalizer (D : Set (FreeAmalgam R)) := by
    intro v hv
    rw [mem_normalizer_iff_map_conj_eq, map_commutator,
      mem_normalizer_iff_map_conj_eq.mp ((V R a).le_normalizer hv)]
  have hDV : ⁅D, V R a⁆ ≤ D := le_normalizer_iff_commutator_le_left.mp hnorm
  have hDVL : ⁅⁅D, V R a⁆, Ltilde R a⁆ = ⊥ :=
    le_bot_iff.mp ((commutator_mono hDV le_rfl).trans hDL.le)
  have hLDV : ⁅⁅Ltilde R a, D⁆, V R a⁆ = ⊥ := by
    rw [commutator_comm (Ltilde R a) D, hDL]
    simp
  exact commutator_commutator_eq_bot_of_rotate hLDV hDVL

/-- In the bad branches the moving radius already has nilpotency class at
most two; abelianness still requires the binary module argument. -/
theorem moving_class_two (source : LocalSource L R) (geometry : Geometry R)
    (hb : 2 < geometry.b R) (hbad : BadCase source)
    (a : Vertex R) (ha : color R a = false) :
    ⁅⁅Vcirc R a, Vcirc R a⁆, Vcirc R a⁆ = ⊥ := by
  have hm : Vcirc R a ≤ V R a := le_normalizer_iff_commutator_le_left.mp
    ((Ltilde_le_stabilizer a).trans (V_normalized a))
  have hzero := moving_centralizes_derived a (radius_derived_le_fixed source geometry hb hbad a ha)
  rw [commutator_comm] at hzero
  exact le_bot_iff.mp ((commutator_mono (commutator_mono hm hm) le_rfl).trans hzero.le)

/-- Once the moving radius is abelian, fixedness of the full derived radius
and residual commutator idempotence make it central in V. -/
theorem moving_central_of_commutative (source : LocalSource L R)
    (geometry : Geometry R) (hb : 2 < geometry.b R)
    (a : Vertex R) (ha : color R a = false)
    (hfixed : ⁅V R a, V R a⁆ ≤ fixedCore R a)
    (hcomm : IsMulCommutative (Vcirc R a)) :
    Vcirc R a ≤ centralizer (V R a : Set (FreeAmalgam R)) := by
  have hm : Vcirc R a ≤ V R a := le_normalizer_iff_commutator_le_left.mp
    ((Ltilde_le_stabilizer a).trans (V_normalized a))
  have hD : ⁅⁅V R a, V R a⁆, Ltilde R a⁆ = ⊥ :=
    commutator_eq_bot_iff_le_centralizer.mpr (hfixed.trans inf_le_right)
  have hone : ⁅⁅Ltilde R a, V R a⁆, Vcirc R a⁆ = ⊥ := by
    rw [commutator_comm (Ltilde R a) (V R a)]
    exact commutator_eq_bot_iff_le_centralizer.mpr
      (le_centralizer_iff_isMulCommutative.mpr hcomm)
  have htwo : ⁅⁅V R a, Vcirc R a⁆, Ltilde R a⁆ = ⊥ :=
    le_bot_iff.mp ((commutator_mono (commutator_mono le_rfl hm) le_rfl).trans hD.le)
  have hh := commutator_commutator_eq_bot_of_rotate hone htwo
  rw [moving_full_commutation source geometry hb a ha] at hh
  exact commutator_eq_bot_iff_le_centralizer.mp hh

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.NaturalStructure.Exclusion
