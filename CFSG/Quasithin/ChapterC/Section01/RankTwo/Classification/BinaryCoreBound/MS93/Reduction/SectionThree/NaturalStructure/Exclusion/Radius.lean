module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.SectionThree.NaturalStructure.Exclusion.Geometry

/-!
# The derived radius in the bad binary branches

Only pairs of radius-two generators at critical distance can fail to commute.
Their midpoint is the radius center, so the geometric auxiliary-subgroup
argument puts every such commutator in its fixed core. Thus V_a' is fixed by
Ltilde_a. The three-subgroups lemma makes V_a^circ centralize V_a'; in
particular V_a^circ has class at most two.

The source local generation also gives V_a = V_a^circ V_t for every incident
holomorph vertex t, and V_t is abelian. Residual commutator idempotence shows
that abelianness of V_a^circ would make it central in V_a, and hence make V_a
abelian. Critical noncommutation rules this out at a critical midpoint.
The remaining representation-theoretic abelianness assertion is not assumed
in the geometric deductions or asserted to be proved here.

The radius-generation proofs adapt the independent arguments already checked
in Escape/Initial/Consequences/Geometry and DistanceFour, under their earlier
hypotheses and narrow SectionThree imports. The normalized-join commutator
argument follows SectionThree/NormalizationTransfer.
Source: Meierfrankenfeld--Stellmacher (1993), the binary portion of (3.8),
pp.877--879, and the radius notation on p.855.
-/

public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
open scoped commutatorElement
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.NaturalStructure.Exclusion
open ModuleAlternatives NormalizerTransfer
variable {M : Type*} [Group M] {L R : Subgroup M}

private theorem adjacent_Z_le {a t : Vertex R} (ha : color R a = false)
    (hat : Adjacent R a t) : Z R t ≤ Z R a := by
  have ht : color R t ≠ false := fun ht => adjacent_color_ne R hat (ha.trans ht.symm)
  rw [Z, if_neg ht, Z, if_pos ha]
  exact le_iSup_of_le t (le_iSup_of_le hat le_rfl)

/-- The odd-color generators of the radius group are redundant. -/
theorem radius_le_of_m_ball {a : Vertex R} (ha : color R a = false)
    (K : Subgroup (FreeAmalgam R))
    (hK : ∀ d, color R d = false → (cosetGraph R).dist d a ≤ 2 → Z R d ≤ K) :
    V R a ≤ K := by
  apply iSup_le
  intro d
  apply iSup_le
  intro hd
  by_cases hc : color R d = false
  · exact hK d hc hd
  · obtain ⟨w, hw⟩ := (cosetGraph_connected R).exists_walk_length_eq_dist d a
    have hn : ¬ Even ((cosetGraph R).dist d a) := by
      rw [← hw, walk_even_iff_color_eq, ha]
      exact hc
    rw [Nat.even_iff] at hn
    have hd' : (cosetGraph R).dist d a = 1 := by omega
    have hadj : Adjacent R a d := adjacent_symm R
      ((cosetGraph_adj R _ _).mp (SimpleGraph.dist_eq_one_iff_adj.mp hd'))
    exact (adjacent_Z_le ha hadj).trans (hK a ha (by simp))

/-- At a holomorph vertex the radius group is generated by adjacent Z groups. -/
theorem radius_le_of_h_neighbors {a t : Vertex R} (ha : color R a = false)
    (hat : Adjacent R a t) (K : Subgroup (FreeAmalgam R))
    (hK : ∀ d, Adjacent R d t → Z R d ≤ K) : V R t ≤ K := by
  have ht : color R t = true := by
    have hn := adjacent_color_ne R hat
    cases h : color R t <;> simp_all
  apply iSup_le
  intro d
  apply iSup_le
  intro hd
  obtain ⟨w, hw⟩ := (cosetGraph_connected R).exists_walk_length_eq_dist d t
  have hlen : w.length ≤ 2 := hw.trans_le hd
  cases w with
  | nil => exact (adjacent_Z_le ha hat).trans (hK a hat)
  | @cons d e t hde w =>
    cases w with
    | nil => exact hK d ((cosetGraph_adj R _ _).mp hde)
    | @cons e f t hef w =>
      have hzero : w.length = 0 := by simp only [SimpleGraph.Walk.length_cons] at hlen; omega
      have hft := w.eq_of_length_eq_zero hzero
      subst f
      have het : Adjacent R e t := (cosetGraph_adj R _ _).mp hef
      have he : color R e = false := by
        have hn := adjacent_color_ne R het
        cases h : color R e <;> simp_all
      exact (adjacent_Z_le he (adjacent_symm R ((cosetGraph_adj R _ _).mp hde))).trans
        (hK e het)

theorem edge_radius_le_radius {a t : Vertex R} (ha : color R a = false)
    (hat : Adjacent R a t) : V R t ≤ V R a := by
  apply radius_le_of_h_neighbors ha hat
  intro d hdt
  apply le_iSup_of_le d
  apply le_iSup_of_le (show (cosetGraph R).dist d a ≤ 2 from ?_)
  · exact le_rfl
  · have h₁ := SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj R _ _).mpr hdt)
    have h₂ := SimpleGraph.dist_eq_one_iff_adj.mpr
      ((cosetGraph_adj R _ _).mpr (adjacent_symm R hat))
    have htri := (cosetGraph_connected R).dist_triangle (u := d) (v := t) (w := a)
    omega

private theorem normalizes_sup_of_commutator_le {G : Type*} [Group G]
    (A B K : Subgroup G) (hKA : K ≤ normalizer (A : Set G))
    (hc : ⁅B, K⁆ ≤ A) : K ≤ normalizer (A ⊔ B : Subgroup G) := by
  apply le_normalizer_iff.mpr
  intro k hk x hx
  have hm : (A ⊔ B).map (MulAut.conj k).toMonoidHom ≤ A ⊔ B := by
    rw [Subgroup.map_sup]
    apply sup_le
    · exact (mem_normalizer_iff_map_conj_eq.mp (hKA hk)).le.trans le_sup_left
    · rintro _ ⟨b, hb, rfl⟩
      have hcb : ⁅k, b⁆ ∈ A := by
        rw [commutator_comm] at hc
        exact hc (commutator_mem_commutator hk hb)
      have h := (A ⊔ B).mul_mem (mem_sup_left hcb) (mem_sup_right hb)
      simpa [commutatorElement_def, mul_assoc] using h
  exact hm (mem_map_of_mem (MulAut.conj k).toMonoidHom hx)

variable [Finite M]

/-- The moving radius group and any incident edge radius generate V_a.
This uses the source local generation, with no natural-module premise. -/
theorem radius_eq_moving_sup_edge (source : LocalSource L R)
    {a t : Vertex R} (ha : color R a = false) (hat : Adjacent R a t) :
    V R a = Vcirc R a ⊔ V R t := by
  have htV := edge_radius_le_radius ha hat
  have hn : stabilizer R a ≤ normalizer (Vcirc R a ⊔ V R t : Subgroup (FreeAmalgam R)) := by
    rw [← source.local_generation a ha]
    apply sup_le
    · exact normalizes_sup_of_commutator_le _ _ _
        ((Ltilde_le_stabilizer a).trans (Vcirc_normalized a))
        (commutator_mono htV le_rfl)
    · exact (le_inf
        ((show Q R a ≤ stabilizer R a from fun _ hx => hx.1).trans (Vcirc_normalized a))
        ((show Q R a ≤ stabilizer R t from fun _ hx => hx.2 t hat).trans (V_normalized t))).trans
        (normalizer_inf_normalizer_le_normalizer_sup _ _)
  have hmov : Vcirc R a ≤ V R a := le_normalizer_iff_commutator_le_left.mp
    ((Ltilde_le_stabilizer a).trans (V_normalized a))
  apply le_antisymm _ (sup_le hmov htV)
  apply radius_le_of_m_ball ha
  intro d hd hdist
  by_cases hda : d = a
  · subst d
    apply (show Z R a ≤ V R t from ?_).trans le_sup_right
    apply le_iSup_of_le a
    exact le_iSup_of_le
      (show (cosetGraph R).dist a t ≤ 2 from
        (SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj R _ _).mpr hat)).le.trans (by decide)) le_rfl
  have htwo : (cosetGraph R).dist a d = 2 := by
    have hne : (cosetGraph R).dist a d ≠ 0 := by
      intro hz
      exact hda ((cosetGraph_connected R).dist_eq_zero_iff.mp hz).symm
    have heven : Even ((cosetGraph R).dist a d) := by
      obtain ⟨w, hw⟩ := (cosetGraph_connected R).exists_walk_length_eq_dist a d
      rw [← hw, walk_even_iff_color_eq, ha, hd]
    rw [Nat.even_iff] at heven
    rw [SimpleGraph.dist_comm] at hdist
    omega
  obtain ⟨u, hau, hdu⟩ := exists_common_neighbor_of_dist_two R a d htwo
  obtain ⟨g, hg, hgu⟩ := stabilizer_transitive_neighbors R a hat hau
  have hVu : V R u ≤ Vcirc R a ⊔ V R t := by
    rw [← hgu, V_act]
    exact (map_mono (show V R t ≤ Vcirc R a ⊔ V R t from le_sup_right)).trans
      (mem_normalizer_iff_map_conj_eq.mp (hn ((stabilizer R a).inv_mem hg))).le
  apply (show Z R d ≤ V R u from ?_).trans hVu
  apply le_iSup_of_le d
  exact le_iSup_of_le
    (show (cosetGraph R).dist d u ≤ 2 from
      (SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj R _ _).mpr hdu)).le.trans (by decide)) le_rfl

