module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.Escape.PairingControl.Geometry.Selection.Six.EdgeSeed.Coordinates
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.Escape.PairingControl.Geometry.Selection.Centralizer.Generation.Native.Incidence

/-!
# From a native intersection to the marked geometric seed

Transitivity of the vertex stabilizer on its incident edges transports a
nonzero native intersection to any prescribed edge. Choose a nonzero dual
coordinate of that intersection and select its compatible line parabolic.
The entire preimage of the binary line is generated by U and this element,
so it lies in the native edge layer. The small commutator bound transports
through the injective inclusion of the finite vertex stabilizer.

The nonzero native intersection remains explicit here. No seed, neighbor
lift, parabolic-core identification or core-pairing construction is assumed.
Source: Meierfrankenfeld--Stellmacher (1993), (1.7)(ii), pp.847--848,
and (4.3.2)(3)--(5), pp.883--885.
-/

public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.Escape.PairingControl.Geometry.Selection.Six.EdgeSeed
open RankOnePairing TerminalPairing
open Centralizer.Generation
open RankOnePairing.Incidence.FixedGeometry.ValueConstruction

variable {M : Type*} [Group M] [Finite M] {R : Subgroup M}

theorem native_intersection_at_edge {a t : Vertex R}
    (hat : Adjacent R a t) (incidence : NativeIncidence a) :
    ¬ Vcirc R a ⊓ V R t ≤ U R a := by
  obtain ⟨s, has, hs⟩ := incidence
  obtain ⟨g, hg, hgs⟩ := stabilizer_transitive_neighbors R a has hat
  have hga : act R g a = a := hg
  intro h
  apply hs
  apply (map_le_map_iff_of_injective (f := (MulAut.conj g⁻¹).toMonoidHom)
    (MulAut.conj g⁻¹).injective).mp
  rw [Subgroup.map_inf _ _ _ (MulAut.conj g⁻¹).injective,
    ← Vcirc_act, ← V_act, ← U_act, hga, hgs]
  exact h

variable {L : Subgroup M} {geometry : MS93.Geometry R}

theorem nonempty_of_native_intersection (source : LocalSource L R)
    (hb : 2 < geometry.b R)
    {a t : Vertex R} (ha : color R a = false) (hat : Adjacent R a t)
    (opposite : OppositeSectionAt a)
    (hintersection : ¬ Vcirc R a ⊓ V R t ≤ U R a)
    (hsmall : Nat.card (⁅Vcirc R a ⊓ V R t, Q R a⁆ : Subgroup (FreeAmalgam R)) ≤ 4) :
    Nonempty (EdgeSeedAt source a t ha) := by
  let S := stabilizer R a
  let o := markedOpposite opposite
  obtain ⟨x, hx, hxu⟩ := SetLike.not_le_iff_exists.mp hintersection
  have hJG : Vcirc R a ≤ S := (Vcirc_le_V a).trans
    ((geometry.V_le_Q hb a ha).trans (fun _ hz => hz.1))
  let x₀ : (Vcirc R a).subgroupOf S := ⟨⟨x, hJG hx.1⟩, hx.1⟩
  have hne : o.dual.coordinates x₀ ≠ 1 := by
    intro hz
    have hk := MonoidHom.mem_ker.mpr hz
    rw [o.dual.kernel] at hk
    exact hxu hk
  obtain ⟨flag, hflag⟩ := exists_flag_of_nonzero (o.dual.coordinates x₀) hne
  have hfixed := fixed_bot_of_model source ha o flag true (line_fixed_bot flag)
  let e := vertexExtension source a ha o flag (binaryWeakBN flag)
  have hU : (U R a).subgroupOf S ≤ (Vcirc R a).subgroupOf S :=
    fun _ hu => commutator_mono (Z_le_VBall R a 2) le_rfl hu
  have hcard : Nat.card (RankOnePairing.Incidence.DualGeometry.seedLine
      o.naturalU.marking flag true) = 2 :=
    (RankOnePairing.Incidence.DualGeometry.matrixGeometry_of_no_fixed _ _ _
      (line_fixed_bot flag)).seed_card
  have hseed : canonicalSeed e o.dual true = (U R a).subgroupOf S ⊔ zpowers (x₀ : S) :=
    EdgeGeometry.canonicalSeed_eq_of_lift e o.dual true hU hcard x₀ hflag hne
  have hUt : U R a ≤ V R t := (U_le_Z a).trans (le_iSup_of_le a (le_iSup_of_le (by
    rw [SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj R _ _).mpr hat)]
    decide) le_rfl))
  have hedge : canonicalSeed e o.dual true ≤ (V R t).subgroupOf S := by
    rw [hseed]
    exact sup_le (fun _ hu => hUt hu) (zpowers_le.mpr hx.2)
  have hmap : (⁅canonicalSeed e o.dual true, (Q R a).subgroupOf S⁆).map S.subtype ≤
      ⁅Vcirc R a ⊓ V R t, Q R a⁆ := by
    rw [map_commutator, map_subgroupOf_eq_of_le (show Q R a ≤ S from fun _ hz => hz.1)]
    apply commutator_mono _ le_rfl
    rintro y ⟨z, hz, rfl⟩
    exact ⟨canonicalSeed_le e o.dual true hz, hedge hz⟩
  let := finite_stabilizer R a
  have hlocal : ⁅Vcirc R a ⊓ V R t, Q R a⁆ ≤ S :=
    (commutator_mono (inf_le_left.trans hJG)
      (show Q R a ≤ S from fun _ hz => hz.1)).trans (commutator_le_self S)
  let : Finite (⁅Vcirc R a ⊓ V R t, Q R a⁆ : Subgroup (FreeAmalgam R)) :=
    Finite.of_injective (inclusion hlocal) (inclusion_injective _)
  have hc := (card_le_of_le hmap).trans hsmall
  rw [card_map_of_injective S.subtype_injective] at hc
  exact ⟨{
    opposite := o
    flag := flag
    weakBN := binaryWeakBN flag
    side := true
    fixed_bot := hfixed
    seed_le_edge := hedge
    small_commutator := hc }⟩

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.Escape.PairingControl.Geometry.Selection.Six.EdgeSeed
