/-!
# Radius generation before the initial escape consequences

The radius group at an M-vertex is generated by its moving group and the
radius group of any incident H-vertex. Applied two steps before a critical
endpoint, this proves that the moving group escapes the starting kernel.
Only b > 2 is needed. All transports retain the entire contrary configuration.

The generation and distance proofs adapt the independently proved arguments
in Escape/PairingControl/Geometry/{Paths,LocalProducts/Endpoint}.lean at their
earlier source hypotheses, without using any pairing or escape conclusion.
Source: Meierfrankenfeld--Stellmacher (1993), (4.3.1)(v)--(vii), p.883.
-/

public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
open scoped commutatorElement
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.Escape.Initial.Consequences
variable {M : Type*} [Group M] {L R : Subgroup M} {geometry : Geometry R}

theorem adjacent_Z_le {a t : Vertex R} (ha : color R a = false)
    (hat : Adjacent R a t) : Z R t ≤ Z R a := by
  have ht : color R t ≠ false := fun ht => adjacent_color_ne R hat (ha.trans ht.symm)
  rw [Z, if_neg ht, Z, if_pos ha]
  exact le_iSup_of_le t (le_iSup_of_le hat le_rfl)

/-- Eliminate the redundant odd-color generators in the radius-two definition. -/
theorem V_le_of_m_ball {a : Vertex R} (ha : color R a = false)
    (K : Subgroup (FreeAmalgam R))
    (hK : ∀ d, color R d = false → (cosetGraph R).dist d a ≤ 2 → Z R d ≤ K) :
    V R a ≤ K := by
  apply iSup_le
  intro d
  apply iSup_le
  intro hd
  by_cases hc : color R d = false
  · exact hK d hc hd
  · obtain ⟨w, hw⟩ := (cosetGraph_connected R).exists_walk_length_eq_dist d a
    have hn : ¬ Even ((cosetGraph R).dist d a) := by
      rw [← hw, walk_even_iff_color_eq, ha]
      exact hc
    rw [Nat.even_iff] at hn
    have hd' : (cosetGraph R).dist d a = 1 := by omega
    have hadj : Adjacent R a d := adjacent_symm R
      ((cosetGraph_adj R _ _).mp (SimpleGraph.dist_eq_one_iff_adj.mp hd'))
    exact (adjacent_Z_le ha hadj).trans (hK a ha (by simp))

/-- At a holomorph vertex, the radius-two definition reduces to its neighbors. -/
theorem V_le_of_h_neighbors {a t : Vertex R} (ha : color R a = false)
    (hat : Adjacent R a t) (K : Subgroup (FreeAmalgam R))
    (hK : ∀ d, Adjacent R d t → Z R d ≤ K) : V R t ≤ K := by
  have ht : color R t = true := by
    have hn := adjacent_color_ne R hat
    cases h : color R t <;> simp_all
  apply iSup_le
  intro d
  apply iSup_le
  intro hd
  obtain ⟨w, hw⟩ := (cosetGraph_connected R).exists_walk_length_eq_dist d t
  have hlen : w.length ≤ 2 := hw.trans_le hd
  cases w with
  | nil => exact (adjacent_Z_le ha hat).trans (hK a hat)
  | @cons d e t hde w =>
    cases w with
    | nil => exact hK d ((cosetGraph_adj R _ _).mp hde)
    | @cons e f t hef w =>
      have hzero : w.length = 0 := by simp only [SimpleGraph.Walk.length_cons] at hlen; omega
      have hft := w.eq_of_length_eq_zero hzero
      subst f
      have het : Adjacent R e t := (cosetGraph_adj R _ _).mp hef
      have he : color R e = false := by
        have hn := adjacent_color_ne R het
        cases h : color R e <;> simp_all
      exact (adjacent_Z_le he (adjacent_symm R ((cosetGraph_adj R _ _).mp hde))).trans
        (hK e het)

theorem Vcirc_le_V (a : Vertex R) : Vcirc R a ≤ V R a :=
  le_normalizer_iff_commutator_le_left.mp
    ((Ltilde_le_stabilizer a).trans (V_normalized a))

theorem V_le_Q_of_distance {a d : Vertex R} (ha : color R a = false)
    (h : (cosetGraph R).dist a d + 2 < geometry.b R) : V R a ≤ Q R d := by
  apply V_le_of_m_ball ha
  intro e he hea
  apply Z_le_Q_of_dist_lt R e (geometry.exists_critical e he)
  rw [geometry.distance_constant e he]
  change (cosetGraph R).dist e d < geometry.b R
  have htri := (cosetGraph_connected R).dist_triangle (u := e) (v := a) (w := d)
  omega

theorem V_le_stabilizer_of_distance {a d : Vertex R} (ha : color R a = false)
    (h : (cosetGraph R).dist a d + 2 ≤ geometry.b R) : V R a ≤ stabilizer R d := by
  apply V_le_of_m_ball ha
  intro e he hea
  apply geometry.Z_le_stabilizer_of_dist_le_b e he d
  have htri := (cosetGraph_connected R).dist_triangle (u := e) (v := a) (w := d)
  omega

theorem normalizes_sup_of_commutator_le {G : Type*} [Group G]
    (A B K : Subgroup G) (hKA : K ≤ normalizer (A : Set G))
    (hc : ⁅B, K⁆ ≤ A) : K ≤ normalizer (A ⊔ B : Subgroup G) := by
  apply le_normalizer_iff.mpr
  intro k hk x hx
  have hm : (A ⊔ B).map (MulAut.conj k).toMonoidHom ≤ A ⊔ B := by
    rw [Subgroup.map_sup]
    apply sup_le
    · exact (mem_normalizer_iff_map_conj_eq.mp (hKA hk)).le.trans le_sup_left
    · rintro _ ⟨b, hb, rfl⟩
      have hcb : ⁅k, b⁆ ∈ A := by
        rw [commutator_comm] at hc
        exact hc (commutator_mem_commutator hk hb)
      have h := (A ⊔ B).mul_mem (mem_sup_left hcb) (mem_sup_right hb)
      simpa [commutatorElement_def, mul_assoc] using h
  exact hm (mem_map_of_mem (MulAut.conj k).toMonoidHom hx)

variable [Finite M]

omit [Finite M] in
theorem edge_radius_le_radius {a t : Vertex R} (ha : color R a = false)
    (hat : Adjacent R a t) : V R t ≤ V R a := by
  apply V_le_of_h_neighbors ha hat
  intro d hdt
  apply le_iSup_of_le d
  apply le_iSup_of_le (show (cosetGraph R).dist d a ≤ 2 from ?_)
  · exact le_rfl
  · have h₁ := SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj R _ _).mpr hdt)
    have h₂ := SimpleGraph.dist_eq_one_iff_adj.mpr
      ((cosetGraph_adj R _ _).mpr (adjacent_symm R hat))
    have htri := (cosetGraph_connected R).dist_triangle (u := d) (v := t) (w := a)
    omega

theorem radius_eq_moving_sup_edge (source : LocalSource L R)
    {a t : Vertex R} (ha : color R a = false) (hat : Adjacent R a t) :
    V R a = Vcirc R a ⊔ V R t := by
  have htV := edge_radius_le_radius ha hat
  have hn : stabilizer R a ≤ normalizer (Vcirc R a ⊔ V R t : Subgroup (FreeAmalgam R)) := by
    rw [← source.local_generation a ha]
    apply sup_le
    · exact normalizes_sup_of_commutator_le _ _ _
        ((Ltilde_le_stabilizer a).trans (Vcirc_normalized a))
        (commutator_mono htV le_rfl)
    · exact (le_inf
        ((show Q R a ≤ stabilizer R a from fun _ hx => hx.1).trans (Vcirc_normalized a))
        ((show Q R a ≤ stabilizer R t from fun _ hx => hx.2 t hat).trans (V_normalized t))).trans
        (normalizer_inf_normalizer_le_normalizer_sup _ _)
  apply le_antisymm _ (sup_le (Vcirc_le_V a) htV)
  apply V_le_of_m_ball ha
  intro d hd hdist
  by_cases hda : d = a
  · subst d
    apply (show Z R a ≤ V R t from ?_).trans le_sup_right
    apply le_iSup_of_le a
    exact le_iSup_of_le
      (show (cosetGraph R).dist a t ≤ 2 from
        (SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj R _ _).mpr hat)).le.trans (by decide)) le_rfl
  have htwo : (cosetGraph R).dist a d = 2 := by
    have hne : (cosetGraph R).dist a d ≠ 0 := by
      intro hz
      exact hda ((cosetGraph_connected R).dist_eq_zero_iff.mp hz).symm
    have heven : Even ((cosetGraph R).dist a d) := by
      obtain ⟨w, hw⟩ := (cosetGraph_connected R).exists_walk_length_eq_dist a d
      rw [← hw, walk_even_iff_color_eq, ha, hd]
    rw [Nat.even_iff] at heven
    rw [SimpleGraph.dist_comm] at hdist
    omega
  have hedist : (cosetGraph R).edist a d = 2 := by
    rw [← ((cosetGraph_connected R) a d).coe_dist_eq_edist, htwo]
    rfl
  obtain ⟨u, hau, hdu⟩ := (SimpleGraph.edist_eq_two_iff.mp hedist).2.2
  obtain ⟨g, hg, hgu⟩ := stabilizer_transitive_neighbors R a hat
    ((cosetGraph_adj R _ _).mp hau)
  have hVu : V R u ≤ Vcirc R a ⊔ V R t := by
    rw [← hgu, V_act]
    exact (map_mono (show V R t ≤ Vcirc R a ⊔ V R t from le_sup_right)).trans
      (mem_normalizer_iff_map_conj_eq.mp (hn ((stabilizer R a).inv_mem hg))).le
  apply (show Z R d ≤ V R u from ?_).trans hVu
  apply le_iSup_of_le d
  exact le_iSup_of_le
    (show (cosetGraph R).dist d u ≤ 2 from
      (SimpleGraph.dist_eq_one_iff_adj.mpr hdu).le.trans (by decide)) le_rfl

theorem endpoint_moving_not_le (source : LocalSource L R) (p : Counterexample geometry)
    (hb : 2 < geometry.b R) : ¬ Vcirc R p.c ≤ Q R p.a := by
  obtain ⟨t, ht⟩ := p.exists_before (show 3 ≤ geometry.b R by omega)
  have hct : Adjacent R p.c t := adjacent_symm R
    (ht.adjacent (geometry := geometry) p.before)
  have htQ : V R t ≤ Q R p.a := by
    apply V_le_of_h_neighbors p.before_color hct
    intro d hdt
    have hd : color R d = false := by
      have htc := adjacent_color_ne R hct
      have htd := adjacent_color_ne R hdt
      rw [p.before_color] at htc
      cases hc : color R t <;> cases he : color R d <;> simp_all
    apply Z_le_Q_of_dist_lt R d (geometry.exists_critical d hd)
    rw [geometry.distance_constant d hd]
    change (cosetGraph R).dist d p.a < geometry.b R
    have hdt' := SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj R _ _).mpr hdt)
    have htri := (cosetGraph_connected R).dist_triangle (u := d) (v := t) (w := p.a)
    have hpath := ht.2
    rw [p.distance_eq_b, SimpleGraph.dist_comm (u := p.a)] at hpath
    omega
  intro h
  have hVc : V R p.c ≤ Q R p.a := by
    rw [radius_eq_moving_sup_edge source p.before_color hct]
    exact sup_le h htQ
  have hZ : Z R p.a' ≤ V R p.c := by
    apply le_iSup_of_le p.a'
    exact le_iSup_of_le (show (cosetGraph R).dist p.a' p.c ≤ 2 by
      rw [SimpleGraph.dist_comm, p.before.1]) le_rfl
  exact (source.critical_reverse geometry p.a p.color_a p.a' p.end_color p.critical).2
    (hZ.trans hVc)

/-- The endpoint-side moving group acts in the starting stabilizer. -/
theorem endpoint_moving_local (p : Counterexample geometry) :
    Vcirc R p.c ≤ stabilizer R p.a := by
  apply (Vcirc_le_V p.c).trans
  apply V_le_stabilizer_of_distance p.before_color
  rw [SimpleGraph.dist_comm]
  have h := p.before.2
  rw [p.distance_eq_b] at h
  exact h.le

omit [Finite M] in
/-- The equations for the whole translated configuration, made explicit
here because the existing translate definition has an abstract module body. -/
theorem counterexample_transport (p : Counterexample geometry) (g : FreeAmalgam R) :
    ∃ q : Counterexample geometry,
      q.a = act R g p.a ∧ q.a' = act R g p.a' ∧ q.c = act R g p.c := by
  refine ⟨{
    a := act R g p.a
    a' := act R g p.a'
    c := act R g p.c
    color_a := by rw [action_preserves_color]; exact p.color_a
    critical := (criticalPair_act_iff R g p.a p.a' _ _).mpr p.critical
    before := by simpa only [Before, dist_act] using p.before
    trapped := by rw [V_act, Q_act]; exact map_mono p.trapped
  }, rfl, rfl, rfl⟩

omit [Finite M] in
/-- Translate the starting vertex together with the chosen endpoint and path. -/
theorem counterexample_at_start (p : Counterexample geometry)
    (a : Vertex R) (ha : color R a = false) :
    ∃ q : Counterexample geometry, q.a = a := by
  obtain ⟨g, hg⟩ := exists_mVertex_of_color R p.color_a
  obtain ⟨h, hh⟩ := exists_mVertex_of_color R ha
  obtain ⟨q, hq, _, _⟩ := counterexample_transport p (g⁻¹ * h)
  refine ⟨q, hq.trans ?_⟩
  rw [hg, act_mVertex, mul_inv_cancel_left, ← hh]

/-- The specified two-step predecessor can likewise be prescribed by transport. -/
theorem counterexample_at_predecessor (p : Counterexample geometry)
    (a : Vertex R) (ha : color R a = false) :
    ∃ q : Counterexample geometry, q.c = a := by
  obtain ⟨g, hg⟩ := exists_mVertex_of_color R p.before_color
  obtain ⟨h, hh⟩ := exists_mVertex_of_color R ha
  obtain ⟨q, _, _, hq⟩ := counterexample_transport p (g⁻¹ * h)
  refine ⟨q, hq.trans ?_⟩
  rw [hg, act_mVertex, mul_inv_cancel_left, ← hh]

omit [Finite M] in
/-- Uniform sections apply at every M-vertex through a genuine translated
counterexample, without identifying two unrelated critical pairs. -/
theorem natural_section_at (p : Counterexample geometry)
    (hsections : ∀ q : Counterexample geometry, Nonempty (SectionFacts q))
    (a : Vertex R) (ha : color R a = false) :
    Nonempty (NaturalSectionAt a (V R a) (Z R a)) := by
  obtain ⟨q, hqa⟩ := counterexample_at_start p a ha
  obtain ⟨s⟩ := hsections q
  simpa only [hqa] using Nonempty.intro s.natural_section

omit [Finite M] in
/-- Uniform moving generation also transports at the whole-configuration level. -/
theorem moving_generation_at (p : Counterexample geometry)
    (hsections : ∀ q : Counterexample geometry, Nonempty (SectionFacts q))
    (a : Vertex R) (ha : color R a = false)
    (d : Vertex R) (hd : d ∈ movingNeighbors geometry a) :
    Vcirc R a ≤ NormalizerTransfer.conjugatesIn (Z R d) (stabilizer R a) := by
  obtain ⟨q, hqa⟩ := counterexample_at_start p a ha
  obtain ⟨s⟩ := hsections q
  subst a
  exact s.moving_generation d hd

