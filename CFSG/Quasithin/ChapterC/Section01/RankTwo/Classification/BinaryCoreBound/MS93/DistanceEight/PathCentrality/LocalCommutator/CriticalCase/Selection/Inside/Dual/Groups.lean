module
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceEight.PathCentrality.LocalCommutator.CriticalCase.Selection.Inside.Conjugates
public import Theory.ElementaryAbelian.Join
public import Theory.ElementaryAbelian.Quotient

/-!
# The point extension in the inside-B branch

The small subgroup A = [Z_a,Q_c] is normalized by Q_c. Adjoining Z_c
makes it invariant under G_c. Its next kernel commutator has order at most
two and is therefore fixed by the local residual, so [A,Q_c] lies in D_c.
For each x in A we then construct the actual group <x>Z_cD_c. Its quotient
by D_c is elementary, is normalized by G_c, and is centralized by Q_c.
Here D_c is fixedCore, distinct from the given fixed preimage B_c.

The small-commutator proofs adapt Reduction/Escape/EdgeTransfer/Extension/Groups;
the actor here is Q_c itself, not the kernel of an adjacent holomorph vertex.
Source: Meierfrankenfeld--Stellmacher (1993), (4.4.1), claim (2), p.891,
and its application of (1.5)(i), pp.843--845.
-/

@[expose] public section
open Subgroup Stellmacher.PushingUp.AmalgamGraph
open scoped commutatorElement
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality.LocalCommutator.CriticalCase.Inside.Dual

private theorem normalizes_sup {G : Type*} [Group G] (S A C : Subgroup G)
    (hA : S ≤ normalizer A) (hC : S ≤ normalizer C) :
    S ≤ normalizer (A ⊔ C : Subgroup G) :=
  (le_inf hA hC).trans (normalizer_inf_normalizer_le_normalizer_sup A C)

private theorem normalizes_commutator {G : Type*} [Group G] (S A C : Subgroup G)
    (hA : S ≤ normalizer A) (hC : S ≤ normalizer C) :
    S ≤ normalizer (⁅A,C⁆ : Subgroup G) := by
  intro s hs
  rw [mem_normalizer_iff_map_conj_eq, map_commutator,
    mem_normalizer_iff_map_conj_eq.mp (hA hs),
    mem_normalizer_iff_map_conj_eq.mp (hC hs)]

private theorem small_commutator {G : Type*} [Group G]
    (P A : Subgroup G) [Finite P] (hP : IsPGroup 2 P)
    (hAP : A ≤ P) (hn : P ≤ normalizer A) (hA : Nat.card A ≤ 4) :
    Nat.card (⁅A,P⁆ : Subgroup G) ≤ 2 := by
  have hKA : ⁅A,P⁆ ≤ A := le_normalizer_iff_commutator_le_left.mp hn
  let : Finite A := Finite.of_injective (inclusion hAP) (inclusion_injective _)
  let : Finite (⁅A,P⁆ : Subgroup G) :=
    Finite.of_injective (inclusion hKA) (inclusion_injective _)
  by_cases hbot : A = ⊥
  · simp [hbot]
  have hne : ⁅A,P⁆ ≠ A := by
    intro heq
    let A₀ := A.subgroupOf P
    have hcomm : ⁅A₀, (⊤ : Subgroup P)⁆ = A₀ := by
      apply map_injective P.subtype_injective
      rw [map_commutator, map_subgroupOf_eq_of_le hAP, ← MonoidHom.range_eq_map,
        range_subtype, heq]
    have hz : A₀ ≤ ⊥ := le_normal_of_quotient_isPGroup_of_eq_commutator
      A₀ ⊤ ⊥ (hP.to_quotient ⊥) hcomm
    have hh := congrArg (Subgroup.map P.subtype) (le_bot_iff.mp hz)
    rw [map_subgroupOf_eq_of_le hAP, Subgroup.map_bot] at hh
    exact hbot hh
  have hlt : Nat.card (⁅A,P⁆ : Subgroup G) < Nat.card A := by
    by_contra! h
    exact hne (eq_of_le_of_card_ge hKA h)
  rcases (hP.to_le (hKA.trans hAP)).card_eq_or_dvd with h | h <;> omega

private theorem normalizer_centralizes_small {G : Type*} [Group G]
    (D : Subgroup G) [Finite D] (hD : Nat.card D ≤ 2) :
    normalizer (D : Set G) ≤ centralizer (D : Set G) := by
  by_cases hsmall : Nat.card D ≤ 1
  · rw [eq_bot_of_card_le D hsmall]
    intro g _ x hx
    have hxone : x = 1 := hx
    simp [hxone]
  · have htwo : Nat.card D = 2 := by omega
    obtain ⟨z, _, hzuniq⟩ := (Nat.card_eq_two_iff' (1 : D)).mp htwo
    intro g hg x hx
    by_cases hxone : x = 1
    · simp [hxone]
    let xD : D := ⟨x, hx⟩
    let yD : D := ⟨g * x * g⁻¹, (hg x).mp hx⟩
    have hyne : yD ≠ 1 := by
      intro hy
      apply hxone
      have hy' : g * x * g⁻¹ = 1 := congrArg Subtype.val hy
      have hh := congrArg (fun a : G => g⁻¹ * a * g) hy'
      simpa [mul_assoc] using hh
    have heq : yD = xD := (hzuniq yD hyne).trans (hzuniq xD (by
      intro hx'; exact hxone (congrArg Subtype.val hx'))).symm
    have heq' : g * x * g⁻¹ = x := congrArg Subtype.val heq
    have hh := congrArg (fun a : G => a * g) heq'
    simpa [mul_assoc] using hh.symm

variable {M : Type*} [Group M] {R : Subgroup M}

/-- The elementary layer generated by the point and the actual Z_c. -/
noncomputable def layer (c : Vertex R) (w : FreeAmalgam R) : Subgroup (FreeAmalgam R) :=
  zpowers w ⊔ Z R c

/-- The literal extension group <w>Z_cD_c from printed p.891. -/
noncomputable def carrier (c : Vertex R) (w : FreeAmalgam R) : Subgroup (FreeAmalgam R) :=
  layer c w ⊔ fixedCore R c

/-- Local properties used to construct the point extension. The theorem
`pointData` below proves all four properties for every source displacement. -/
structure PointData (c : Vertex R) (w : FreeAmalgam R) : Prop where
  mem_kernel : w ∈ Q R c
  elementary : IsElementaryAbelian 2 (zpowers w)
  residual_commutator : ⁅zpowers w,Ltilde R c⁆ ≤ Z R c
  kernel_commutator : ⁅zpowers w,Q R c⁆ ≤ fixedCore R c

variable [Finite M] {L : Subgroup M} {source : LocalSource L R}
  {geometry : Geometry R}

private theorem displacement_local (common : CommonFacts R source geometry)
    {a c : Vertex R} (hc : color R c = false)
    (hB : ⁅Z R a,Q R c⁆ ≤ B R c (geometry.Z_normal c)) :
    ⁅Z R a,Q R c⁆ ≤ Q R c ∧ ⁅⁅Z R a,Q R c⁆,Ltilde R c⁆ ≤ Z R c := by
  have hV := geometry.V_le_Q common.large_distance c hc
  refine ⟨hB.trans ((Escape.EdgeTransfer.B_le_radius common.large_distance c hc).trans hV), ?_⟩
  rw [commutator_comm]
  apply commutator_le.mpr
  intro l hl x hx
  exact ((mem_B_iff R c (geometry.Z_normal c)
    (hV.trans (fun _ hv => hv.1)) x).mp (hB hx)).2 l hl

private theorem displacementLayer_normalized (common : CommonFacts R source geometry)
    {a c : Vertex R} (hc : color R c = false)
    (hB : ⁅Z R a,Q R c⁆ ≤ B R c (geometry.Z_normal c)) :
    stabilizer R c ≤ normalizer (⁅Z R a,Q R c⁆ ⊔ Z R c : Subgroup (FreeAmalgam R)) := by
  have hL : Ltilde R c ≤ normalizer (⁅Z R a,Q R c⁆ ⊔ Z R c : Subgroup (FreeAmalgam R)) := by
    have hcomm := (displacement_local common hc hB).2
    rw [le_normalizer_iff]
    intro l hl x hx
    have hm : (⁅Z R a,Q R c⁆ ⊔ Z R c).map (MulAut.conj l).toMonoidHom ≤
        ⁅Z R a,Q R c⁆ ⊔ Z R c := by
      rw [Subgroup.map_sup]
      apply sup_le
      · rintro _ ⟨y,hy,rfl⟩
        change l * y * l⁻¹ ∈ ⁅Z R a,Q R c⁆ ⊔ Z R c
        have hh : ⁅l,y⁆ ∈ Z R c := hcomm (by
          rw [commutator_comm]; exact commutator_mem_commutator hl hy)
        rw [show l * y * l⁻¹ = ⁅l,y⁆ * y by simp [commutatorElement_def, mul_assoc]]
        exact (⁅Z R a,Q R c⁆ ⊔ Z R c).mul_mem ((show Z R c ≤ ⁅Z R a,Q R c⁆ ⊔ Z R c from le_sup_right) hh)
          ((show ⁅Z R a,Q R c⁆ ≤ ⁅Z R a,Q R c⁆ ⊔ Z R c from le_sup_left) hy)
      · rintro _ ⟨y,hy,rfl⟩
        exact (show Z R c ≤ ⁅Z R a,Q R c⁆ ⊔ Z R c from le_sup_right) (le_normalizer_iff.mp
          ((Ltilde_le_stabilizer c).trans (Z_normalized R c)) l hl y hy)
    exact hm (mem_map_of_mem (MulAut.conj l).toMonoidHom hx)
  rw [← source.local_generation c hc]
  exact sup_le hL (normalizes_sup _ _ _ (normalizer_commutator_ge_right _ _)
    ((show Q R c ≤ stabilizer R c from fun _ hx => hx.1).trans (Z_normalized R c)))

/-- The actual Q_c acts trivially on every displacement modulo D_c. -/
theorem displacement_kernel_commutator_le_fixedCore
    (common : CommonFacts R source geometry) {a c : Vertex R}
    (ha : color R a = false) (hc : color R c = false)
    (hd : (cosetGraph R).dist a c = 2)
    (hB : ⁅Z R a,Q R c⁆ ≤ B R c (geometry.Z_normal c)) :
    ⁅⁅Z R a,Q R c⁆,Q R c⁆ ≤ fixedCore R c := by
  let S := stabilizer R c
  let P := Q R c
  let A := ⁅Z R a,Q R c⁆
  let E := A ⊔ Z R c
  let K := ⁅E,P⁆
  have hP : P ≤ S := fun _ hx => hx.1
  let : Finite S := finite_stabilizer R c
  let : Finite P := Finite.of_injective (inclusion hP) (inclusion_injective _)
  have hAQ : A ≤ P := (displacement_local common hc hB).1
  have hZQ : Z R c ≤ P := by
    rw [← common.X_eq_Z c hc]; exact omegaCenter_le _
  have hK : K ≤ P := (commutator_mono (sup_le hAQ hZQ) le_rfl).trans (commutator_le_self P)
  let : Finite K := Finite.of_injective (inclusion hK) (inclusion_injective _)
  have heq : K = ⁅A,P⁆ := by
    have he := commutator_eq_of_centralizing_sup
      (show Z R c ⊔ A = E from sup_comm _ _)
      (commutator_eq_bot_iff_le_centralizer.mp (geometry.centralizes c hc))
      (hAQ.trans P.le_normalizer)
    change ⁅E,P⁆ = ⁅A,P⁆
    rw [commutator_comm E, ← he, commutator_comm]
  have hsmall : Nat.card K ≤ 2 := by
    rw [heq]
    exact small_commutator P A (Q_isPGroup R source.two_group source.core_le c hc)
      hAQ (normalizer_commutator_ge_right _ _) (displacement_card_le_four common ha hd)
  have hn : S ≤ normalizer K := normalizes_commutator S E P
    (displacementLayer_normalized common hc hB) (Q_normalized R c)
  rw [← heq]
  exact le_inf hK ((le_centralizer_iff.mp
    (hn.trans (normalizer_centralizes_small K hsmall))).trans
      (centralizer_le (Ltilde_le_stabilizer c)))

/-- Construct the point-extension inputs from the source displacement subgroup. -/
theorem pointData (common : CommonFacts R source geometry) {a c : Vertex R}
    (ha : color R a = false) (hc : color R c = false)
    (hd : (cosetGraph R).dist a c = 2)
    (hB : ⁅Z R a,Q R c⁆ ≤ B R c (geometry.Z_normal c))
    (w : FreeAmalgam R) (hw : w ∈ ⁅Z R a,Q R c⁆) : PointData c w := by
  let : IsElementaryAbelian 2 (Z R a) := by
    rw [← common.X_eq_Z a ha]; exact omegaCenter_elementary _
  have hp : zpowers w ≤ ⁅Z R a,Q R c⁆ := zpowers_le.mpr hw
  exact ⟨(displacement_local common hc hB).1 hw,
    IsElementaryAbelian.of_le (hp.trans ((displacement_le_U common ha hd).trans (U_le_Z R a))),
    (commutator_mono hp le_rfl).trans (displacement_local common hc hB).2,
    (commutator_mono hp le_rfl).trans
      (displacement_kernel_commutator_le_fixedCore common ha hc hd hB)⟩

variable (modules : ModuleFacts source geometry) {c : Vertex R} {w : FreeAmalgam R}

omit [Finite M] in
include modules in
theorem layer_le_Q (hc : color R c = false) (data : PointData c w) : layer c w ≤ Q R c :=
  sup_le (zpowers_le.mpr data.mem_kernel)
    (by rw [← modules.X_eq_Z c hc]; exact omegaCenter_le _)

omit [Finite M] in
include modules in
theorem carrier_le_Q (hc : color R c = false) (data : PointData c w) : carrier c w ≤ Q R c :=
  sup_le (layer_le_Q modules hc data) inf_le_left

omit [Finite M] in
include modules in
theorem layer_elementary (hc : color R c = false) (data : PointData c w) :
    IsElementaryAbelian 2 (layer c w) := by
  let : IsElementaryAbelian 2 (Z R c) := by
    rw [← modules.X_eq_Z c hc]; exact omegaCenter_elementary _
  let := data.elementary
  exact IsElementaryAbelian.sup_of_le_centralizer
    ((commutator_eq_bot_iff_le_centralizer.mp (geometry.centralizes c hc)).trans
      (centralizer_le (zpowers_le.mpr data.mem_kernel)))

omit [Finite M] in
private theorem carrier_commutator_le (T N : Subgroup (FreeAmalgam R))
    (hP : ⁅zpowers w,T⁆ ≤ N) (hZ : ⁅Z R c,T⁆ ≤ N)
    (hD : ⁅fixedCore R c,T⁆ ≤ N)
    (hn : carrier c w ≤ normalizer N) : ⁅carrier c w,T⁆ ≤ N := by
  have hp : carrier c w ≤ commutatorPreimage (carrier c w) T N :=
    sup_le (sup_le (le_commutatorPreimage (le_sup_left.trans le_sup_left) hP)
      (le_commutatorPreimage (le_sup_right.trans le_sup_left) hZ))
      (le_commutatorPreimage le_sup_right hD)
  exact (commutator_mono hp le_rfl).trans (commutator_commutatorPreimage_le _ _ _ hn)

omit [Finite M] in
include modules in
theorem carrier_kernel_commutator_le_fixedCore (hc : color R c = false) (data : PointData c w) :
    ⁅carrier c w,Q R c⁆ ≤ fixedCore R c := by
  apply carrier_commutator_le _ _ data.kernel_commutator
    ((geometry.centralizes c hc).le.trans bot_le)
  · exact le_normalizer_iff_commutator_le_left.mp
      ((show Q R c ≤ stabilizer R c from fun _ hx => hx.1).trans (PathCentrality.fixedCore_normalized R c))
  · exact ((carrier_le_Q modules hc data).trans (fun _ hx => hx.1)).trans
      (PathCentrality.fixedCore_normalized R c)

omit [Finite M] in
include modules in
theorem carrier_residual_commutator_le (hc : color R c = false) (data : PointData c w) :
    ⁅carrier c w,Ltilde R c⁆ ≤ Z R c := by
  apply carrier_commutator_le _ _ data.residual_commutator
    (le_normalizer_iff_commutator_le_left.mp
      ((Ltilde_le_stabilizer c).trans (Z_normalized R c)))
  · exact (commutator_eq_bot_iff_le_centralizer.mpr
      (show fixedCore R c ≤ centralizer (Ltilde R c : Set (FreeAmalgam R)) from inf_le_right)).le.trans bot_le
  · exact ((carrier_le_Q modules hc data).trans (fun _ hx => hx.1)).trans (Z_normalized R c)

include modules in
theorem carrier_normalized (hc : color R c = false) (data : PointData c w) :
    stabilizer R c ≤ normalizer (carrier c w : Set (FreeAmalgam R)) := by
  rw [← source.local_generation c hc]
  exact sup_le
    (le_normalizer_iff_commutator_le_left.mpr
      ((carrier_residual_commutator_le modules hc data).trans (le_sup_right.trans le_sup_left)))
    (le_normalizer_iff_commutator_le_left.mpr
      ((carrier_kernel_commutator_le_fixedCore modules hc data).trans le_sup_right))

omit [Finite M] in
include modules in
theorem denominator_normal (hc : color R c = false) (data : PointData c w) :
    ((fixedCore R c).subgroupOf (carrier c w)).Normal :=
  normal_subgroupOf_of_le_normalizer
    (((carrier_le_Q modules hc data).trans (fun _ hx => hx.1)).trans
      (PathCentrality.fixedCore_normalized R c))

omit [Finite M] in
include modules in
theorem quotient_elementary (hc : color R c = false) (data : PointData c w) :
    let := denominator_normal modules hc data
    IsElementaryAbelian 2 (carrier c w ⧸ (fixedCore R c).subgroupOf (carrier c w)) := by
  let := denominator_normal modules hc data
  let := layer_elementary modules hc data
  have hn : layer c w ≤ normalizer (fixedCore R c : Set (FreeAmalgam R)) :=
    ((layer_le_Q modules hc data).trans (fun _ hx => hx.1)).trans
      (PathCentrality.fixedCore_normalized R c)
  let := normal_subgroupOf_of_le_normalizer hn
  let := normal_subgroupOf_sup_of_le_normalizer hn
  exact IsElementaryAbelian.of_surjective
    (QuotientGroup.quotientInfEquivProdNormalizerQuotient (layer c w) (fixedCore R c) hn).toMonoidHom
    (QuotientGroup.quotientInfEquivProdNormalizerQuotient (layer c w) (fixedCore R c) hn).surjective

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality.LocalCommutator.CriticalCase.Inside.Dual
