module
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.SectionThree.NaturalStructure.ModuleAlternatives.Actions

/-!
# Local conventions and containments for source 2.3

The kernel at every vertex is a finite two-group. Before the critical
radius it contains X_a, so the printed Frattini hypothesis on <Y,X_a>
is equivalent to elementary abelianness on that literal join. At critical
distance each X lies in the opposite stabilizer, and their commutator lies
in both layers. Every subgroup of X_a is normal in Q_a; consequently the
nonnormality in 2.3(d) must be relative to G_a.

Source: Meierfrankenfeld–Stellmacher (1993), (2.2)--(2.3), printed pp.856–858.
-/

public section
open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.ModuleAlternatives
variable {M : Type*} [Group M] [Finite M] {L R : Subgroup M}

/-- Every local kernel is a two-group, including the holomorph vertices. -/
theorem kernel_isPGroup (source : LocalSource L R) (a : Vertex R) : IsPGroup 2 (Q R a) := by
  cases ha : color R a with
  | false => exact Q_isPGroup R source.two_group source.core_le a ha
  | true =>
    have he : ∃ g, a = hVertex R g := by
      cases a with
      | inl x => cases ha
      | inr x =>
        induction x using Quotient.inductionOn with
        | h g => exact ⟨g, rfl⟩
    obtain ⟨g, rfl⟩ := he
    have h := Q_act R g (beta R)
    simp only [beta, act_hVertex, one_mul] at h
    rw [h]
    change IsPGroup 2 ((Q R (beta R)).map _)
    rw [Q_beta]
    exact (source.two_group.map (embedM R)).map _

/-- The Frattini condition in source 2.3(c) is precisely elementary
abelianness on the actual finite subgroup generated by Y and X_a. -/
theorem frattini_join_iff (source : LocalSource L R) (geometry : Geometry R)
    (a : Vertex R) (ha : color R a = false) (t : Vertex R)
    (ht : (cosetGraph R).dist a t < criticalDistance R a (geometry.exists_critical a ha))
    (Y : Subgroup (FreeAmalgam R)) (hY : Y ≤ Q R t) :
    frattini (Y ⊔ X R a : Subgroup (FreeAmalgam R)) = ⊥ ↔
      IsElementaryAbelian 2 (Y ⊔ X R a : Subgroup (FreeAmalgam R)) := by
  have hX := MS93.X_le_Q_of_dist_lt R geometry (source.edgeCentralizerCondition geometry) a ha t ht
  have hJ : Y ⊔ X R a ≤ Q R t := sup_le hY hX
  let := finite_stabilizer R t
  let : Finite (Y ⊔ X R a : Subgroup (FreeAmalgam R)) :=
    Finite.of_injective (inclusion (hJ.trans (fun _ hx => hx.1))) (inclusion_injective _)
  let : Fact (IsPGroup 2 (Y ⊔ X R a : Subgroup (FreeAmalgam R))) :=
    ⟨(kernel_isPGroup source t).to_le hJ⟩
  exact frattini_eq_bot_iff_isElementaryAbelian (p := 2)

omit [Finite M] in
/-- Every subgroup of X_a is normal in Q_a. Thus source 2.3(d)'s
nonnormality condition belongs to G_a, never to Q_a. -/
theorem subgroup_X_normal_in_Q (a : Vertex R) (A : Subgroup (FreeAmalgam R))
    (hA : A ≤ X R a) : (A.subgroupOf (Q R a)).Normal :=
  normal_subgroupOf_of_le_normalizer
    (((Q_le_centralizer_X R a).trans (centralizer_le hA)).trans
      (Subgroup.centralizer_le_normalizer _))

/-- At critical distance X still belongs to the endpoint stabilizer. -/
theorem critical_X_le_stabilizer (source : LocalSource L R) (geometry : Geometry R)
    (hb : 0 < geometry.b R) (a : Vertex R) (ha : color R a = false)
    (a' : Vertex R) (hc : CriticalPair R a a' (geometry.exists_critical a ha)) :
    X R a ≤ stabilizer R a' := by
  have hd : 0 < (cosetGraph R).dist a' a := by
    rw [SimpleGraph.dist_comm, hc.1, geometry.distance_constant a ha]
    exact hb
  obtain ⟨t, hat, ht⟩ := exists_adjacent_dist_sub_one R a' a hd
  have hs : (cosetGraph R).dist a t < criticalDistance R a (geometry.exists_critical a ha) := by
    rw [SimpleGraph.dist_comm (u := a) (v := t)]
    rw [SimpleGraph.dist_comm (u := a') (v := a), hc.1] at ht
    omega
  have hX := MS93.X_le_Q_of_dist_lt R geometry (source.edgeCentralizerCondition geometry) a ha t hs
  exact hX.trans (fun _ hx => hx.2 a' (adjacent_symm R hat))

/-- The auxiliary subgroup in the bad alternatives lies in both actual X layers. -/
theorem critical_commutator_le_intersection (source : LocalSource L R) (geometry : Geometry R)
    (hb : 0 < geometry.b R) (a : Vertex R) (ha : color R a = false)
    (a' : Vertex R) (hc : CriticalPair R a a' (geometry.exists_critical a ha)) :
    ⁅X R a, X R a'⁆ ≤ X R a ⊓ X R a' := by
  have ha' := critical_endpoint_color R a ha _ hc
  have hrev := MS93.critical_reverse R geometry (source.edgeCentralizerCondition geometry)
    a ha (by rw [geometry.distance_constant a ha]; exact hb) a' ha' hc
  apply le_inf
  · exact le_normalizer_iff_commutator_le_left.mp
      ((critical_X_le_stabilizer source geometry hb a' ha' a hrev).trans (X_normalized R a))
  · rw [commutator_comm]
    exact le_normalizer_iff_commutator_le_left.mp
      ((critical_X_le_stabilizer source geometry hb a ha a' hc).trans (X_normalized R a'))

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.ModuleAlternatives
