module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceEight.PathCentrality.LocalAction
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Setup.NormalizerTransfer.Algebra

/-!
# The three orbit layers in MS93 (4.5)

The hats on printed p.896 denote nested conjugate spans, not full radius
balls. `hatV a c` is generated by Z_c under G_a; `hatW a c d` is generated
by hatV(c,d) under G_a; `hatSix a c d e` is generated by hatW(c,d,e) under
G_a. Along the source path, c,d,e have offsets two, four and six from a.

Covariance compares the first layer to the established local Z-span.
Conjugation takes place in the literal local stabilizer. The proved
normalizer and radius bounds keep these groups distinct from both the
full radius groups and `core = [Q,Ltilde]`. Their source identifications
and natural quotient models are further proof obligations.

Source: Meierfrankenfeld--Stellmacher (1993), (4.5.1)--(4.5.5), pp.896--899.
-/

@[expose] public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.CoreFactors
open NormalizerTransfer PathCentrality
variable {M : Type*} [Group M] (R : Subgroup M)

/-- Source hat V_a, with the next M-vertex supplied explicitly. -/
noncomputable def hatV (a c : Vertex R) : Subgroup (FreeAmalgam R) := localZSpan R c a
/-- Source hat W_a, the second nested orbit layer. -/
noncomputable def hatW (a c d : Vertex R) : Subgroup (FreeAmalgam R) :=
  conjugatesIn (hatV R c d) (stabilizer R a)
/-- Source hat V_a^(6), the third nested orbit layer. -/
noncomputable def hatSix (a c d e : Vertex R) : Subgroup (FreeAmalgam R) :=
  conjugatesIn (hatW R c d e) (stabilizer R a)

/-- The first hat layer uses the same right-conjugation convention as the later ones. -/
theorem hatV_eq_conjugatesIn (a c : Vertex R) :
    hatV R a c = conjugatesIn (Z R c) (stabilizer R a) := by
  simpa only [hatV, conjugatesIn, rightConjugate] using localZSpan_eq_conjugates R c a

/-- The first layer is normalized by its actual local stabilizer. -/
theorem hatV_normalized (a c : Vertex R) :
    stabilizer R a ≤ normalizer (hatV R a c) := localZSpan_normalized R c a

/-- The second layer is normalized by its actual local stabilizer. -/
theorem hatW_normalized (a c d : Vertex R) :
    stabilizer R a ≤ normalizer (hatW R a c d) := conjugatesIn_normalized _ _

/-- The third layer is normalized by its actual local stabilizer. -/
theorem hatSix_normalized (a c d e : Vertex R) :
    stabilizer R a ≤ normalizer (hatSix R a c d e) := conjugatesIn_normalized _ _

private theorem radius_normalized (a : Vertex R) (n : ℕ) :
    stabilizer R a ≤ normalizer (VBall R a n) := by
  intro g hg
  rw [mem_normalizer_iff_map_conj_eq]
  change (VBall R a n).map (MulAut.conj g).toMonoidHom = VBall R a n
  have hh := VBall_act R g⁻¹ a n
  have hga : act R g⁻¹ a = a := (stabilizer R a).inv_mem hg
  simpa only [hga, inv_inv] using hh.symm

private theorem radius_shift {a c : Vertex R} {i j : ℕ}
    (hd : (cosetGraph R).dist c a ≤ j) : VBall R c i ≤ VBall R a (i + j) := by
  apply iSup_le
  intro d
  apply iSup_le
  intro hdc
  have hda : (cosetGraph R).dist d a ≤ i + j :=
    (cosetGraph_connected R).dist_triangle.trans (Nat.add_le_add hdc hd)
  exact le_iSup_of_le d (le_iSup_of_le hda le_rfl)

private theorem conjugates_le_radius {A : Subgroup (FreeAmalgam R)}
    {a : Vertex R} {n : ℕ} (hA : A ≤ VBall R a n) :
    conjugatesIn A (stabilizer R a) ≤ VBall R a n := by
  apply iSup_le
  intro g
  rintro _ ⟨x, hx, rfl⟩
  exact le_normalizer_iff.mp (radius_normalized R a n) g⁻¹
    ((stabilizer R a).inv_mem g.property) x (hA hx)

/-- The first hat layer lies in the actual radius-two group. -/
theorem hatV_le_radius {a c : Vertex R} (hca : (cosetGraph R).dist c a ≤ 2) :
    hatV R a c ≤ V R a := localZSpan_le_V R hca

/-- Two successive source steps place the second hat layer in radius four. -/
theorem hatW_le_radius {a c d : Vertex R}
    (hca : (cosetGraph R).dist c a ≤ 2) (hdc : (cosetGraph R).dist d c ≤ 2) :
    hatW R a c d ≤ VBall R a 4 :=
  conjugates_le_radius R ((hatV_le_radius R hdc).trans (radius_shift R (i := 2) (j := 2) hca))

/-- Three successive source steps place the third hat layer in radius six. -/
theorem hatSix_le_radius {a c d e : Vertex R}
    (hca : (cosetGraph R).dist c a ≤ 2) (hdc : (cosetGraph R).dist d c ≤ 2)
    (hed : (cosetGraph R).dist e d ≤ 2) : hatSix R a c d e ≤ VBall R a 6 :=
  conjugates_le_radius R ((hatW_le_radius R hdc hed).trans (radius_shift R (i := 4) (j := 2) hca))

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.CoreFactors
