module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Setup.Parabolics.Lifting
public import Theory.GroupTheory.FiniteParabolicTransfer
public import Theory.GroupTheory.PResidual.PrimeToSubnormal
public import Theory.GroupTheory.PResidual.NormalizedGenerators
public import Theory.GroupTheory.PResidual.SylowSupplement
public import Theory.GroupTheory.PResidual.PerfectCover

/-!
# The binary source rank-one generators

The S₄ parabolics are generated by involutions, so O^{2′}(Pᵢ) = Pᵢ.
This remains true in any extension by a two-group: the kernel lies in the
prime-to-two residual, whose image has odd index and hence is the whole
quotient. Thus the source expression O²(O^{2′}(Pᵢ)) is precisely O²(Pᵢ).

The common lifted Sylow subgroup normalizes both embedded residuals and
supplements each one in its parabolic. Since the parabolics generate M,
their residuals together with that Sylow generate M. The normalized-generators
criterion now identifies their join with O²(M), including its intersection
with the two-group kernel.

Source: Meierfrankenfeld--Stellmacher (1993), the definition of L on printed
p.828 and the ordered residual notation on printed p.859.
-/

public section

open Subgroup
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93

private theorem symmetric_primeToResidual :
    primeToResidual 2 (Equiv.Perm (Fin 4)) = ⊤ := by
  apply top_unique
  intro x _
  refine Equiv.Perm.swap_induction_on x (primeToResidual 2 _).one_mem ?_
  intro y a b _ hy
  apply (primeToResidual 2 _).mul_mem _ hy
  apply mem_primeToResidual_of_pow (n := 1)
  simp [pow_two]

private theorem primeToResidual_top_of_equiv {G : Type*} [Group G]
    (e : G ≃* Equiv.Perm (Fin 4)) : primeToResidual 2 G = ⊤ := by
  apply Subgroup.map_injective (f := e.toMonoidHom) e.injective
  rw [map_primeToResidual e, symmetric_primeToResidual,
    map_top_of_surjective _ e.surjective]

private theorem primeToResidual_top_of_two_kernel {G H : Type*}
    [Group G] [Finite G] [Group H] (f : G →* H) (hf : Function.Surjective f)
    (hk : IsPGroup 2 f.ker) (hH : primeToResidual 2 H = ⊤) :
    primeToResidual 2 G = ⊤ := by
  let N := primeToResidual 2 G
  have hn : (N.map f).Normal := Normal.map inferInstance f hf
  let := hn
  have hm : N.map f = ⊤ := by
    apply top_unique
    rw [← hH]
    apply primeToResidual_le
    exact (primeToResidual_index_coprime (G := G) 2).coprime_dvd_right
      (N.index_map_dvd hf)
  have hker : f.ker ≤ N := le_primeToResidual_of_isPGroup hk
  have he := congrArg (fun K : Subgroup H => K.comap f) hm
  rwa [comap_map_eq_self hker, comap_top] at he

variable {M : Type*} [Group M] [Finite M]

/-- The prime-to-two residual is the whole lifted parabolic, including its kernel. -/
theorem primeToResidual_parabolic_eq_top (π : M →* SL) (hπ : Function.Surjective π)
    (hk : IsPGroup 2 π.ker) (g : SL) (i : Bool) :
    primeToResidual 2 (parabolic π g i) = ⊤ := by
  let f := π.subgroupComap (modelParabolic g i)
  have hker : f.ker = π.ker.comap (parabolic π g i).subtype := by
    ext x
    simp only [MonoidHom.mem_ker, Subtype.ext_iff]
    rfl
  apply primeToResidual_top_of_two_kernel f
    (π.subgroupComap_surjective_of_surjective _ hπ)
  · rw [hker]
    exact hk.comap_subtype
  · exact primeToResidual_top_of_equiv (modelParabolicEquivSymmetric g i)

/-- In this binary extension the source-ordered iterated residual is O²(P). -/
theorem rankOne_parabolic_eq (π : M →* SL) (hπ : Function.Surjective π)
    (hk : IsPGroup 2 π.ker) (g : SL) (i : Bool) :
    rankOne (parabolic π g i) =
      (pResidual 2 (parabolic π g i)).map (parabolic π g i).subtype := by
  rw [rankOne, primeToResidual_parabolic_eq_top π hπ hk g i]
  congr 1
  exact map_pResidual 2 (topEquiv : (⊤ : Subgroup (parabolic π g i)) ≃* _)

private theorem residual_sup_common_sylow (P : Subgroup M) (S : Sylow 2 M)
    (hSP : (S : Subgroup M) ≤ P) :
    (pResidual 2 P).map P.subtype ⊔ (S : Subgroup M) = P := by
  have h := congrArg (fun K : Subgroup P => K.map P.subtype)
    (pResidual_sup_sylow_eq_top (S.subtype hSP))
  rwa [Subgroup.map_sup, Sylow.coe_subtype, map_subgroupOf_eq_of_le hSP,
    ← MonoidHom.range_eq_map, P.range_subtype] at h

/-- The two source rank-one generators generate exactly O²(M). -/
theorem rankOne_parabolic_generation (π : M →* SL) (hπ : Function.Surjective π)
    (hk : IsPGroup 2 π.ker) (g : SL) :
    rankOne (parabolic π g false) ⊔ rankOne (parabolic π g true) = pResidual 2 M := by
  rw [rankOne_parabolic_eq π hπ hk, rankOne_parabolic_eq π hπ hk]
  let P := parabolic π g false
  let Q := parabolic π g true
  let S := liftedBorelSylow π hπ hk g
  have hs (i : Bool) : (S : Subgroup M) ≤ parabolic π g i := by
    rw [coe_liftedBorelSylow]
    exact comap_mono (modelParabolic_borel_le g i)
  have hn (i : Bool) : (S : Subgroup M) ≤
      normalizer ((pResidual 2 (parabolic π g i)).map (parabolic π g i).subtype : Set M) :=
    (hs i).trans ((parabolic π g i).le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image _ _))
  apply (pResidual_eq_sup_of_normalized_generators
    ((pResidual 2 P).map P.subtype) ((pResidual 2 Q).map Q.subtype) (S : Subgroup M)
    (isPPerfect_embedded_pResidual 2 P) (isPPerfect_embedded_pResidual 2 Q)
    S.isPGroup' (hn false) (hn true) ?_).symm
  calc
    _ = ((pResidual 2 P).map P.subtype ⊔ (S : Subgroup M)) ⊔
        ((pResidual 2 Q).map Q.subtype ⊔ (S : Subgroup M)) := by
      rw [sup_sup_sup_comm, sup_idem]
    _ = P ⊔ Q := by
      rw [residual_sup_common_sylow P S (hs false), residual_sup_common_sylow Q S (hs true)]
    _ = ⊤ := parabolic_generation π hπ g

end CFSG.Quasithin.ChapterC.BinaryMS.MS93
