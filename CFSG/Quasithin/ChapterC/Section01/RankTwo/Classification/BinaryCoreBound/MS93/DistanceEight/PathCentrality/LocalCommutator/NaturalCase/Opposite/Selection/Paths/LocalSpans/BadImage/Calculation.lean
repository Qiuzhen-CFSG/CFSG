module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceEight.PathCentrality.LocalCommutator.NaturalCase.Opposite.Selection.Paths.LocalSpans.BadImage.Pairing

/-!
# Bounding all bad original conjugates by one annihilator

The failure of the literal relative centralizer condition supplies a matrix
different from the identity which fixes the actual conjugate edge pointwise.
When that displacement has order four, its natural image is the entire fixed
plane of this matrix. Every vector fixed by Q_u lies in that plane. The
original seed's dual coordinates annihilate it, and this remains true after
taking the subgroup generated by all bad conjugates.

The displacement order and the incident-radius estimate remain explicit.
They are source obligations, not consequences of the bad-conjugate definition.
Source: Meierfrankenfeld--Stellmacher (1993), (4.4.1)(1), p.891.
-/

public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality.LocalCommutator.NaturalCase.Opposite.Selection.LocalSpans.BadImage
open Escape.Propagation.Backward.Products.Selection.Choices (Space modelAction planeFixer)
open Escape.PairingControl.Geometry.Selection.Centralizer.Generation.SourceDisplay
variable {M : Type*} [Group M] [Finite M] {L R : Subgroup M}
  {source : LocalSource L R} {geometry : Geometry R} {a c u : Vertex R}

/-- The supplied edge equality puts every transported displacement in U_c. -/
theorem conjugate_edge_le_U (common : CommonFacts R source geometry)
    (hc : color R c = false) (s : EdgeData a c) (g : stabilizer R c) :
    (edgeCommutator R a s.neighbor).map (MulAut.conj (g : FreeAmalgam R)⁻¹).toMonoidHom ≤ U R c := by
  rw [conjugate_edge_eq s g]
  have hg : act R (g : FreeAmalgam R) c = c := g.property
  have ht : Adjacent R c (act R g s.neighbor) := by
    simpa only [hg] using
      (adjacent_act_iff R (g : FreeAmalgam R) c s.neighbor).mpr s.adjacent_center
  exact Escape.EdgeTransfer.edge_commutator_le_natural common.large_distance
    (moduleFacts common) c _ hc ht

/-- A vector fixed by the incident actor lies in each bad natural edge plane.
The witness uses the original inverse-conjugated edge in GoodConjugate. -/
theorem fixed_point_mem_bad_edge (common : CommonFacts R source geometry)
    (hc : color R c = false) (f : FrameAt a c) (s : EdgeData a c)
    (hfour : Nat.card (edgeCommutator R a s.neighbor) = 4)
    (hcu : Adjacent R c u) (g : stabilizer R c)
    (hbad : ¬ GoodConjugate a c s.neighbor u g)
    (w : U R c) (hw : (w : FreeAmalgam R) ∈ centralizer (Q R u : Set (FreeAmalgam R))) :
    naturalCoordinates f w ∈ naturalImage f ((edgeCommutator R a s.neighbor).map
      (MulAut.conj (g : FreeAmalgam R)⁻¹).toMonoidHom) := by
  obtain ⟨q, hq, hqQ⟩ := SetLike.not_le_iff_exists.mp hbad
  let q₀ : stabilizer R c := ⟨q, hq.1.2 c (adjacent_symm R hcu)⟩
  let m := f.naturalU.marking (f.sectionData.projection q₀)
  have hm : m ≠ 1 := by
    intro he
    have hp : f.sectionData.projection q₀ = 1 := f.naturalU.marking.injective
      (he.trans (map_one _).symm)
    have hk : q₀ ∈ f.sectionData.projection.ker := hp
    rw [f.sectionData.module_section.projection_kernel] at hk
    exact hqQ hk
  refine fixed_mem_plane _ ?_ m hm (naturalImage_fixes f _ q₀ hq.2) _ ?_
  · rw [naturalImage_card f _ (conjugate_edge_le_U common hc s g),
      card_map_of_injective (MulAut.conj (g : FreeAmalgam R)⁻¹).injective, hfour]
  · exact (naturalCoordinates_conjugation f q₀ w w (by
      rw [hw q hq.1, mul_inv_cancel_right])).symm

/-- The complete bad-conjugate image annihilates every natural vector fixed
by the incident actor, once the actual displacement-plane order is known. -/
theorem bad_coordinate_image_le_annihilator (common : CommonFacts R source geometry)
    (hc : color R c = false) (hd : (cosetGraph R).dist a c = 2)
    (hb : 2 < geometry.b R) (f : FrameAt a c) (hop : ¬ f.SameOrientation)
    (s : EdgeData a c) (hfour : Nat.card (edgeCommutator R a s.neighbor) = 4)
    (hcu : Adjacent R c u) (w : U R c)
    (hw : (w : FreeAmalgam R) ∈ centralizer (Q R u : Set (FreeAmalgam R))) :
    coordinateImage source hc hd hb f hop (badConjugateSpan a c s.neighbor u) ≤
      Model.annihilator (naturalCoordinates f w) := by
  let W := localZSpan R a c
  let A := Model.annihilator (naturalCoordinates f w)
  let K := A.comap (coordinates source hc hd hb f hop)
  have hspan : badConjugateSpan a c s.neighbor u ≤ K.map W.subtype := by
    apply iSup_le
    intro g
    apply iSup_le
    intro hg x hx
    have hxW : x ∈ W := le_iSup (fun k : stabilizer R c => Z R (act R k a)) g hx
    refine ⟨⟨x, hxW⟩, ?_, rfl⟩
    change dotProduct (naturalCoordinates f w).toAdd
      (coordinates source hc hd hb f hop ⟨x, hxW⟩).toAdd = 0
    rw [dotProduct_comm]
    exact conjugate_seed_annihilates common hc hd hb f hop s g ⟨x, hxW⟩ hx
      (fixed_point_mem_bad_edge common hc f s hfour hcu g hg w hw)
  unfold coordinateImage
  apply map_le_iff_le_comap.mpr
  change (badConjugateSpan a c s.neighbor u).subgroupOf W ≤ K
  have hh := comap_mono (f := W.subtype) hspan
  rwa [comap_map_eq_self_of_injective W.subtype_injective] at hh

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality.LocalCommutator.NaturalCase.Opposite.Selection.LocalSpans.BadImage
