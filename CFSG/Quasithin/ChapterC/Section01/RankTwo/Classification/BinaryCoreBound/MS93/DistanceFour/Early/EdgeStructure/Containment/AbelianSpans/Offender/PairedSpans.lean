/-- The actual free-amalgam automorphism carries both the seed and its stabilizer span. -/
theorem neighborSpan_act (f : FreeAmalgam R) (a d : Vertex R) :
    neighborSpan (act R f a) (act R f d) =
      (neighborSpan a d).map (MulAut.conj f⁻¹).toMonoidHom := by
  rw [neighborSpan, neighborSpan, conjugate_span_map, Z_act, stabilizer_act]

omit [Finite M] in
/-- The span is generated by involutions, even before abelianness is known. -/
theorem neighborSpan_omegaOne (a d : Vertex R) :
    omegaOneAmbient (neighborSpan a d) = neighborSpan a d := by
  apply le_antisymm (omegaOneAmbient_le _)
  apply iSup_le
  intro g
  have heq : (Z R d).map (MulAut.conj (g : FreeAmalgam R)).toMonoidHom =
      Z R (act R (g : FreeAmalgam R)⁻¹ d) := by rw [Z_act, inv_inv]
  rw [heq, ← DistanceEight.Z_omegaOne R (act R (g : FreeAmalgam R)⁻¹ d)]
  apply omegaOneAmbient_mono
  rw [← heq]
  exact le_iSup_of_le g le_rfl

private theorem mapped_center_le_centralizer {G : Type*} [Group G] (H : Subgroup G) :
    (center H).map H.subtype ≤ centralizer (H : Set G) := by
  rintro x ⟨z,hz,rfl⟩ y hy
  exact congrArg Subtype.val ((mem_center_iff.mp hz) ⟨y,hy⟩)

include common in
/-- The central displacement of order two belongs to the local omega-center Z. -/
theorem displacement_le_Z (initial : InitialFacts R geometry)
    (hb : geometry.b R = 4) (a b d : Vertex R) (ha : color R a = false)
    (hab : Adjacent R a b) (hdb : Adjacent R d b)
    (hbad : ¬ ⁅Z R d, Q R b⁆ ≤ B R a (geometry.Z_normal a)) :
    ⁅Z R d, Q R a⁆ ≤ Z R a := by
  have hc := escaping_neighbor_commutator_le_local_center common initial hb a b d ha hab hdb hbad
  have hcard := escaping_neighbor_commutator_card common initial a b d ha hab hdb hbad
  have hD := (neighbor_commutator_le_center initial a b d ha hab hdb).trans
    ((map_subtype_le _).trans (radius_le_Q common a ha))
  rw [← common.X_eq_Z a ha]
  intro x hx
  apply mem_omegaCenter_iff.mpr
  refine ⟨hD hx, ?_, ?_⟩
  · have hh := congrArg Subtype.val
      (pow_card_eq_one' (x := (⟨x,hx⟩ : (⁅Z R d, Q R a⁆ : Subgroup (FreeAmalgam R)))))
    simpa only [hcard, coe_pow, coe_one] using hh
  · exact centralizer_le (show Q R a ≤ stabilizer R a from fun _ hx => hx.1)
      (mapped_center_le_centralizer _ (hc hx))

include common in
private theorem span_displacement (initial : InitialFacts R geometry)
    (hb : geometry.b R = 4) (a b d : Vertex R) (ha : color R a = false)
    (hab : Adjacent R a b) (hdb : Adjacent R d b)
    (hbad : ¬ ⁅Z R d, Q R b⁆ ≤ B R a (geometry.Z_normal a)) :
    ⁅neighborSpan a d, Q R a⁆ = ⁅Z R d, Q R a⁆ := by
  have hd := (escaping_neighbor_geometry common initial a b d ha hab hdb hbad).2.1
  exact neighborSpan_commutator_eq_of_central common a d ha hd.le
    ((escaping_neighbor_commutator_le_local_center common initial hb a b d ha hab hdb hbad).trans
      (mapped_center_le_centralizer _))

include common in
/-- In the nonabelian case the derived subgroup is the whole order-two displacement. -/
theorem noncommutative_derived_eq_displacement (initial : InitialFacts R geometry)
    (hb : geometry.b R = 4) (a b d : Vertex R) (ha : color R a = false)
    (hab : Adjacent R a b) (hdb : Adjacent R d b)
    (hbad : ¬ ⁅Z R d, Q R b⁆ ≤ B R a (geometry.Z_normal a))
    (hnon : ¬ IsMulCommutative (neighborSpan a d)) :
    ⁅neighborSpan a d, neighborSpan a d⁆ = ⁅Z R d, Q R a⁆ := by
  have hd := (escaping_neighbor_geometry common initial a b d ha hab hdb hbad).2.1
  have hWQ := (neighborSpan_le_radius a d hd.le).trans (radius_le_Q common a ha)
  have hle : ⁅neighborSpan a d, neighborSpan a d⁆ ≤ ⁅Z R d, Q R a⁆ := by
    rw [← span_displacement common initial hb a b d ha hab hdb hbad]
    exact commutator_mono le_rfl hWQ
  have hc := escaping_neighbor_commutator_card common initial a b d ha hab hdb hbad
  let : Finite (⁅Z R d, Q R a⁆ : Subgroup (FreeAmalgam R)) :=
    Nat.finite_of_card_ne_zero (by omega)
  let : Finite (⁅neighborSpan a d, neighborSpan a d⁆ : Subgroup (FreeAmalgam R)) :=
    Finite.of_injective (inclusion hle) (inclusion_injective hle)
  apply eq_of_le_of_card_ge hle
  have hne : ⁅neighborSpan a d, neighborSpan a d⁆ ≠ ⊥ := fun h =>
    hnon (commutator_self_eq_bot_iff.mp h)
  have hh := (one_lt_card_iff_ne_bot _).mpr hne
  omega

include common in
private theorem escaping_segment_at_edge (initial : InitialFacts R geometry)
    (hb : geometry.b R = 4) (a b d : Vertex R) (ha : color R a = false)
    (hab : Adjacent R a b) (hdb : Adjacent R d b)
    (hbad : ¬ ⁅Z R d, Q R b⁆ ≤ B R a (geometry.Z_normal a)) :
    ∃ (f : FreeAmalgam R) (r e : Vertex R) (_hr : color R r = false)
      (_he : color R e = false),
      act R f d = r ∧ act R f a = e ∧
      CriticalPair R a r (geometry.exists_critical a ha) ∧
      (cosetGraph R).dist a e = 2 ∧ (cosetGraph R).dist e r = 2 ∧
      Adjacent R e b ∧ Z R r ≤ Q R b ∧
      Nat.card (⁅Z R r, Q R e⁆ : Subgroup (FreeAmalgam R)) = 2 ∧
      ⁅Z R r, Q R e⁆ ≤ Z R a := by
  obtain ⟨f,r,e,hr,he,hfd,hfa,hcrit,hae,her,hcard,hD⟩ :=
    escaping_neighbor_segment common initial hb a b d ha hab hdb hbad
  obtain ⟨s,has,hes⟩ := exists_common_neighbor_of_dist_two R a e hae
  obtain ⟨g,hga,hgs⟩ := stabilizer_transitive_neighbors R a has hab
  have hfix : act R g a = a := hga
  have hr' : color R (act R g r) = false := by rwa [action_preserves_color]
  have he' : color R (act R g e) = false := by rwa [action_preserves_color]
  have hcrit' : CriticalPair R a (act R g r) (geometry.exists_critical a ha) := by
    have ht := (criticalPair_act_iff R g a r (geometry.exists_critical a ha)
      (geometry.exists_critical _ (by rwa [action_preserves_color]))).mpr hcrit
    simpa only [hfix] using ht
  have hae' : (cosetGraph R).dist a (act R g e) = 2 := by
    rw [← hfix, dist_act]
    exact hae
  have her' : (cosetGraph R).dist (act R g e) (act R g r) = 2 := by
    rwa [dist_act]
  have heb : Adjacent R (act R g e) b := by
    rw [← hgs]
    exact (adjacent_act_iff R g e s).mpr hes
  have hrb : Z R (act R g r) ≤ Q R b := by
    apply Z_le_Q_of_dist_lt R _ (geometry.exists_critical _ hr')
    rw [geometry.distance_constant _ hr']
    change (cosetGraph R).dist (act R g r) b < geometry.b R
    have htri := (cosetGraph_connected R).dist_triangle
      (u := act R g r) (v := act R g e) (w := b)
    have hbe := SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj R _ _).mpr heb)
    rw [SimpleGraph.dist_comm (u := act R g r) (v := act R g e), her'] at htri
    omega
  refine ⟨f * g, act R g r, act R g e, hr', he', ?_, ?_, hcrit', hae', her', heb, hrb, ?_, ?_⟩
  · rw [act_mul, hfd]
  · rw [act_mul, hfa]
  · rw [Z_act, Q_act, ← map_commutator, card_map_of_injective (MulAut.conj g⁻¹).injective]
    exact hcard
  · have hh := Subgroup.map_mono (f := (MulAut.conj g⁻¹).toMonoidHom) hD
    rwa [map_commutator, ← Z_act, ← Q_act, ← Z_act, hfix] at hh

include common in
private theorem span_not_le_opposite_kernel (initial : InitialFacts R geometry)
    (hb : geometry.b R = 4) (a b d : Vertex R) (ha : color R a = false)
    (hab : Adjacent R a b) (hdb : Adjacent R d b)
    (hbad : ¬ ⁅Z R d, Q R b⁆ ≤ B R a (geometry.Z_normal a))
    (r e : Vertex R) (hr : color R r = false)
    (hcrit : CriticalPair R a r (geometry.exists_critical a ha))
    (hrb : Z R r ≤ Q R b) (hR : ⁅Z R r, Q R e⁆ ≤ Z R a) :
    ¬ neighborSpan a d ≤ Q R e := by
  have hd := (escaping_neighbor_geometry common initial a b d ha hab hdb hbad).1
  have hda := (escaping_neighbor_geometry common initial a b d ha hab hdb hbad).2.1
  have hcolb : color R b = true := by
    have hh := adjacent_color_ne R hab
    cases hc : color R b <;> simp_all
  have hQaQb := Q_le_adjacent_h R hcolb hab
  have hZda := (neighborSpan_le_radius a d hda.le).trans (radius_le_Q common a ha)
  have hZaa : Z R a ≤ Q R a := by rw [← common.X_eq_Z a ha]; exact omegaCenter_le _
  have hQbGa : Q R b ≤ stabilizer R a := by rw [Q_h_eq_edge R hcolb hab]; exact inf_le_left
  have hQbGd : Q R b ≤ stabilizer R d := by rw [Q_h_eq_edge R hcolb hdb]; exact inf_le_left
  have hSN : Q R b ≤ normalizer (Z R d ⊔ Z R a : Subgroup (FreeAmalgam R)) :=
    (le_inf (hQbGd.trans (Z_normalized R d)) (hQbGa.trans (Z_normalized R a))).trans
      (normalizer_inf_normalizer_le_normalizer_sup _ _)
  have hSnonnormal : ¬ ((Z R d ⊔ Z R a).subgroupOf (stabilizer R a)).Normal := by
    obtain ⟨c,hc,hca,_,hdc,_,_⟩ :=
      escaping_neighbor_critical common initial hb a b d ha hd hab hdb hbad
    have hh := (critical_nonnormal_forward R geometry common.centralizer d hd
      (by rw [geometry.distance_constant d hd]; exact lt_trans (by decide) common.large_distance)
      c hdc a hda (by
        rw [SimpleGraph.dist_comm (u := a), hca, hdc.1, geometry.distance_constant d hd]
        exact hb.symm)).2
    simpa only [common.X_eq_Z a ha] using hh
  have hgen := OrderTwo.edge_conjugate_generation source a b ha hab (Z R r) hrb
    (common.critical_reverse a ha r hr hcrit).2
  have hSQb : Z R d ⊔ Z R a ≤ Q R b :=
    (sup_le ((Z_le_neighborSpan a d).trans hZda) hZaa).trans hQaQb
  obtain ⟨g,hga,hn,_⟩ := source_2_1_vii R a r b ha hab
    (Z R d ⊔ Z R a) (Z R d ⊔ Z R a) hSQb hSQb
    (normal_subgroupOf_of_le_normalizer hSN) (normal_subgroupOf_of_le_normalizer hSN)
    hSnonnormal hSnonnormal hgen
  intro hle
  have hfix : act R g a = a := hga
  have hseed : Z R (act R g d) ≤ neighborSpan a d := by
    rw [Z_act]
    exact le_iSup_of_le (⟨g⁻¹,(stabilizer R a).inv_mem hga⟩ : stabilizer R a) le_rfl
  have hdist : (cosetGraph R).dist a (act R g d) = 2 := by
    rw [← hfix, dist_act, SimpleGraph.dist_comm]
    exact hda
  have hcomm : ⁅Z R (act R g d), Z R r⁆ ≤ Z R a :=
    (commutator_mono (hseed.trans hle) le_rfl).trans (by rwa [commutator_comm])
  apply hn
  rw [Subgroup.map_sup, ← Z_act, ← Z_act, hfix]
  exact (source_2_1_vi R source geometry a ha
    (by rw [geometry.distance_constant a ha]; exact lt_trans (by decide) common.large_distance)
    hcrit (act R g d) hdist (hseed.trans hZda) (hcomm.trans le_sup_right)).1

include common in
private theorem displacement_le_opposite_Z (initial : InitialFacts R geometry)
    (hb : geometry.b R = 4) (a b d : Vertex R) (ha : color R a = false)
    (hab : Adjacent R a b) (hdb : Adjacent R d b)
    (hbad : ¬ ⁅Z R d, Q R b⁆ ≤ B R a (geometry.Z_normal a))
    (e : Vertex R) (he : color R e = false) (hae : (cosetGraph R).dist a e = 2)
    (hnot : ¬ neighborSpan a d ≤ Q R e) :
    ⁅Z R d, Q R a⁆ ≤ Z R e := by
  classical
  have hd := (escaping_neighbor_geometry common initial a b d ha hab hdb hbad).1
  have hda := (escaping_neighbor_geometry common initial a b d ha hab hdb hbad).2.1
  obtain ⟨g,hg⟩ : ∃ g : stabilizer R a,
      ¬ (Z R d).map (MulAut.conj (g : FreeAmalgam R)).toMonoidHom ≤ Q R e := by
    by_contra! h
    exact hnot (iSup_le h)
  let d' := act R (g : FreeAmalgam R)⁻¹ d
  have hd' : color R d' = false := by simpa only [d', action_preserves_color] using hd
  have hfix : act R (g : FreeAmalgam R)⁻¹ a = a := (stabilizer R a).inv_mem g.property
  have hd'a : (cosetGraph R).dist d' a = 2 := by
    have hh := dist_act R (g : FreeAmalgam R)⁻¹ d a
    simpa only [hfix, hda, d'] using hh
  have hseed : Z R d' ≤ neighborSpan a d := by
    rw [show Z R d' = (Z R d).map (MulAut.conj (g : FreeAmalgam R)).toMonoidHom by
      simp only [d', Z_act, inv_inv]]
    exact le_iSup_of_le g le_rfl
  have hesc : ¬ Z R d' ≤ Q R e := by simpa only [d', Z_act, inv_inv] using hg
  have hdist : (cosetGraph R).dist d' e = 4 := by
    have hlo := criticalDistance_le R d' (geometry.exists_critical d' hd') hesc
    rw [geometry.distance_constant d' hd'] at hlo
    change geometry.b R ≤ _ at hlo
    have hhi := (cosetGraph_connected R).dist_triangle (u := d') (v := a) (w := e)
    omega
  have hcrit : CriticalPair R d' e (geometry.exists_critical d' hd') :=
    ⟨by rw [geometry.distance_constant d' hd']; exact hdist.trans hb.symm, hesc⟩
  have heQ : Z R e ≤ Q R a := Z_le_Q_of_dist_lt R e (geometry.exists_critical e he) (by
    rw [SimpleGraph.dist_comm, hae, geometry.distance_constant e he]
    exact common.large_distance)
  have hle : ⁅Z R d', Z R e⁆ ≤ ⁅Z R d, Q R a⁆ := by
    rw [← span_displacement common initial hb a b d ha hab hdb hbad]
    exact commutator_mono hseed heQ
  have hc := escaping_neighbor_commutator_card common initial a b d ha hab hdb hbad
  let : Finite (⁅Z R d, Q R a⁆ : Subgroup (FreeAmalgam R)) :=
    Nat.finite_of_card_ne_zero (by omega)
  let : Finite (⁅Z R d', Z R e⁆ : Subgroup (FreeAmalgam R)) :=
    Finite.of_injective (inclusion hle) (inclusion_injective hle)
  have heq : ⁅Z R d', Z R e⁆ = ⁅Z R d, Q R a⁆ := by
    apply eq_of_le_of_card_ge hle
    have hh := (one_lt_card_iff_ne_bot _).mpr (common.critical_noncommutation d' hd' e hcrit)
    omega
  rw [← heq]
  apply le_normalizer_iff_commutator_le_right.mp
  exact (Z_le_stabilizer_of_dist_le d' (geometry.exists_critical d' hd') hcrit.1.le).trans
    (Z_normalized R e)

omit [Finite M] in
/-- The constructed pair, including both actual escape and crossing-layer bounds.
This record has no FF-module or radius-offender field. -/
structure PairedSpans (geometry : Geometry R) (a b d : Vertex R) (ha : color R a = false) where
  f : FreeAmalgam R
  r : Vertex R
  e : Vertex R
  hr : color R r = false
  he : color R e = false
  transport_seed : act R f d = r
  transport_vertex : act R f a = e
  critical : CriticalPair R a r (geometry.exists_critical a ha)
  near : (cosetGraph R).dist a e = 2
  far : (cosetGraph R).dist e r = 2
  edge : Adjacent R e b
  seed_edge : Z R r ≤ Q R b
  transport_span : (neighborSpan a d).map (MulAut.conj f⁻¹).toMonoidHom = neighborSpan e r
  escape_left : ¬ neighborSpan a d ≤ Q R e
  escape_right : ¬ neighborSpan e r ≤ Q R a
  displacement_left : ⁅neighborSpan a d, Q R a⁆ = ⁅Z R d, Q R a⁆
  displacement_right : ⁅neighborSpan e r, Q R e⁆ = ⁅Z R r, Q R e⁆
  card_left : Nat.card (⁅Z R d, Q R a⁆ : Subgroup (FreeAmalgam R)) = 2
  card_right : Nat.card (⁅Z R r, Q R e⁆ : Subgroup (FreeAmalgam R)) = 2
  central_left : ⁅Z R d, Q R a⁆ ≤ centralizer (stabilizer R a : Set (FreeAmalgam R))
  central_right : ⁅Z R r, Q R e⁆ ≤ centralizer (stabilizer R e : Set (FreeAmalgam R))
  layer_left : ⁅Z R d, Q R a⁆ ≤ Z R a ⊓ Z R e
  layer_right : ⁅Z R r, Q R e⁆ ≤ Z R a ⊓ Z R e

include common in
/-- Construct both spans and their bilateral geometry from the escaping neighbor. -/
theorem pairedSpans_nonempty (initial : InitialFacts R geometry)
    (hb : geometry.b R = 4) (a b d : Vertex R) (ha : color R a = false)
    (hab : Adjacent R a b) (hdb : Adjacent R d b)
    (hbad : ¬ ⁅Z R d, Q R b⁆ ≤ B R a (geometry.Z_normal a)) :
    Nonempty (PairedSpans geometry a b d ha) := by
  obtain ⟨f,r,e,hr,he,hfd,hfa,hcrit,hae,her,heb,hrb,hcard,hD⟩ :=
    escaping_segment_at_edge common initial hb a b d ha hab hdb hbad
  have hnon := span_not_le_opposite_kernel common initial hb a b d ha hab hdb hbad
    r e hr hcrit hrb hD
  have hcent : ⁅Z R d, Q R a⁆ ≤ centralizer (stabilizer R a : Set (FreeAmalgam R)) :=
    (escaping_neighbor_commutator_le_local_center common initial hb a b d ha hab hdb hbad).trans
      (mapped_center_le_centralizer _)
  have hcent' : ⁅Z R r, Q R e⁆ ≤ centralizer (stabilizer R e : Set (FreeAmalgam R)) := by
    rw [← hfd, ← hfa, Z_act, Q_act, ← map_commutator, stabilizer_act]
    rintro x ⟨x,hx,rfl⟩ y ⟨y,hy,rfl⟩
    change (MulAut.conj f⁻¹) y * (MulAut.conj f⁻¹) x =
      (MulAut.conj f⁻¹) x * (MulAut.conj f⁻¹) y
    rw [← map_mul, ← map_mul, hcent hx y hy]
  have hZ := displacement_le_Z common initial hb a b d ha hab hdb hbad
  have hZ' : ⁅Z R r, Q R e⁆ ≤ Z R e := by
    have hh := Subgroup.map_mono (f := (MulAut.conj f⁻¹).toMonoidHom) hZ
    rwa [map_commutator, ← Z_act, ← Q_act, ← Z_act, hfd, hfa] at hh
  refine ⟨{
    f := f, r := r, e := e, hr := hr, he := he
    transport_seed := hfd, transport_vertex := hfa, critical := hcrit
    near := hae, far := her, edge := heb, seed_edge := hrb
    transport_span := ?_
    escape_left := hnon
    escape_right := fun h => (common.critical_reverse a ha r hr hcrit).2
      ((Z_le_neighborSpan e r).trans h)
    displacement_left := span_displacement common initial hb a b d ha hab hdb hbad
    displacement_right := neighborSpan_commutator_eq_of_central common e r he
      (by rw [SimpleGraph.dist_comm]; exact her.le) hcent'
    card_left := escaping_neighbor_commutator_card common initial a b d ha hab hdb hbad
    card_right := hcard
    central_left := hcent, central_right := hcent'
    layer_left := le_inf hZ
      (displacement_le_opposite_Z common initial hb a b d ha hab hdb hbad e he hae hnon)
    layer_right := le_inf hD hZ' }⟩
  rw [← neighborSpan_act, hfd, hfa]

omit [Finite M] in
/-- The two literal commutator containments used in the source index comparison. -/
theorem PairedSpans.cross_commutators {a b d : Vertex R} {ha : color R a = false}
    (p : PairedSpans geometry a b d ha) :
    ⁅neighborSpan a d ⊓ Q R p.e, neighborSpan p.e p.r⁆ ≤ Z R a ∧
      ⁅neighborSpan p.e p.r ⊓ Q R a, neighborSpan a d⁆ ≤ Z R p.e := by
  constructor
  · apply (commutator_mono inf_le_right le_rfl).trans
    rw [commutator_comm, p.displacement_right]
    exact p.layer_right.trans inf_le_left
  · apply (commutator_mono inf_le_right le_rfl).trans
    rw [commutator_comm, p.displacement_left]
    exact p.layer_left.trans inf_le_right

omit [Finite M] in
/-- Nonabelianness transfers through the specified ambient conjugation. -/
theorem PairedSpans.noncommutative_right {a b d : Vertex R} {ha : color R a = false}
    (p : PairedSpans geometry a b d ha) (hnon : ¬ IsMulCommutative (neighborSpan a d)) :
    ¬ IsMulCommutative (neighborSpan p.e p.r) := by
  intro hc
  apply hnon
  apply commutator_self_eq_bot_iff.mp
  apply map_injective (f := (MulAut.conj p.f⁻¹).toMonoidHom) (MulAut.conj p.f⁻¹).injective
  rw [Subgroup.map_bot, map_commutator, p.transport_span]
  exact commutator_self_eq_bot_iff.mpr hc

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Early.Containment.SpanOffender
