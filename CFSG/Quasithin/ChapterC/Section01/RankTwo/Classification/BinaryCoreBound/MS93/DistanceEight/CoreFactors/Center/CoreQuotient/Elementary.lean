module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceEight.OriginalFixedFactorReduction
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceEight.CoreFactors.Center.SecondDerived

/-!
# Elementarity of the literal core quotient from the mixed commutator

Write K for the original core, D for Vcirc, B for the second hat and F
for the first hat. The independent geometry still has to prove [B,K] ≤ D.
This module proves the remaining implication on the actual subgroups.

Modulo D, the commutator pairing on K joined with B takes values in the
fixed elementary group F/D. The marked natural pair above B and the
reciprocal cubic relation of a Singer element force that pairing to vanish.
Thus [K,K] ≤ D. Conversely D ≤ [K,K] was proved in SecondDerived.

The full third hat is generated by conjugates of elementary first hats,
so its quotient by F has exponent two. Squares in K/D therefore lie in
the fixed subgroup F/D. Residual full movement of K forces those squares
to vanish. The resulting elementarity is supplied to the original
quotient-control consumer; its independent involution fixed-index premise
and the genuine Earlier geometry remain explicit.

This is a conditional reduction of MS93 (4.5)(v), not its completed source
proof. In particular, no fixed-factor equality is assumed, and F is never
substituted for D in the final quotient.

Source: Meierfrankenfeld--Stellmacher, Pushing up weak BN-pairs of rank two
(1993), (4.5)(v), (4.5.3)--(4.5.5), printed pp.895--900.
-/

public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
open scoped commutatorElement IsMulCommutative Pointwise
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.CoreFactors.Center.CoreQuotient
open Higher DistanceFour.Linear NormalizerTransfer
open Higher.Quotients.MovingLayer.Singer
section GroupPairing
variable {G E : Type*} [Group G] [CommGroup E] {A F Z : Subgroup G}
    (q : F →* E) (hq : q.ker = Z.subgroupOf F)

include hq in
private theorem section_eq (x y : F) (h : (x : G) * (y : G)⁻¹ ∈ Z) : q x = q y := by
  apply mul_inv_eq_one.mp
  rw [← map_inv,← map_mul]
  exact MonoidHom.mem_ker.mp (hq ▸ h)

include hq in
private theorem section_conj (hAF : A ≤ normalizer F)
    (hFA : ⁅F,A⁆ ≤ Z) (a : A) (d : F) :
    q ⟨(a : G) * (d : G) * (a : G)⁻¹,
      le_normalizer_iff.mp hAF _ a.property _ d.property⟩ = q d := by
  apply section_eq q hq
  change ⁅(a : G),(d : G)⁆ ∈ Z
  rw [commutator_comm] at hFA
  exact hFA (commutator_mem_commutator a.property d.property)

private noncomputable def layerPairing (hAF : A ≤ normalizer F)
    (hAA : ⁅A,A⁆ ≤ F) (hFA : ⁅F,A⁆ ≤ Z) :
    A →* (A →* E) where
  toFun a := {
    toFun b := q ⟨⁅(a : G),(b : G)⁆,hAA (commutator_mem_commutator a.property b.property)⟩
    map_one' := by
      change q ⟨⁅(a : G),1⁆,_⟩ = 1
      rw [show (⟨⁅(a : G),1⁆,_⟩ : F) = 1 from Subtype.ext (by simp),map_one]
    map_mul' b c := by
      have he : (⟨⁅(a : G),(b : G)*(c : G)⁆,
        hAA (commutator_mem_commutator a.property (A.mul_mem b.property c.property))⟩ : F) =
        ⟨⁅(a : G),(b : G)⁆,hAA (commutator_mem_commutator a.property b.property)⟩ *
        ⟨(b : G)*⁅(a : G),(c : G)⁆*(b : G)⁻¹,
          le_normalizer_iff.mp hAF _ b.property _
            (hAA (commutator_mem_commutator a.property c.property))⟩ := by
        apply Subtype.ext
        simpa only [coe_mul,mul_assoc] using
          commutatorElement_mul_right_eq_mul_conj (a : G) (b : G) (c : G)
      change q ⟨⁅(a : G),(b : G)*(c : G)⁆,_⟩ = q _ * q _
      rw [he,map_mul,section_conj q hq hAF hFA b
        ⟨⁅(a : G),(c : G)⁆,hAA (commutator_mem_commutator a.property c.property)⟩] }
  map_one' := by
    apply MonoidHom.ext
    intro b
    change q ⟨⁅(1 : G),(b : G)⁆,_⟩ = 1
    rw [show (⟨⁅(1 : G),(b : G)⁆,_⟩ : F) = 1 from Subtype.ext (by simp),map_one]
  map_mul' a b := by
    apply MonoidHom.ext
    intro c
    have he : (⟨⁅(a : G)*(b : G),(c : G)⁆,
      hAA (commutator_mem_commutator (A.mul_mem a.property b.property) c.property)⟩ : F) =
      ⟨(a : G)*⁅(b : G),(c : G)⁆*(a : G)⁻¹,
        le_normalizer_iff.mp hAF _ a.property _
          (hAA (commutator_mem_commutator b.property c.property))⟩ *
      ⟨⁅(a : G),(c : G)⁆,hAA (commutator_mem_commutator a.property c.property)⟩ := by
      apply Subtype.ext
      exact commutatorElement_mul_left_eq_conj_mul (a : G) (b : G) (c : G)
    change q ⟨⁅(a : G)*(b : G),(c : G)⁆,_⟩ = q _ * q _
    rw [he,map_mul,section_conj q hq hAF hFA a
      ⟨⁅(b : G),(c : G)⁆,hAA (commutator_mem_commutator b.property c.property)⟩,mul_comm]

end GroupPairing

private theorem binary_reciprocal_pairing_zero {D E : Type*} [Group D] [CommGroup E]
    (a : MulAut D) (β : D →* (D →* E))
    (hact : ∀ x y, β (a x) (a y) = β x y)
    (hleft : ∀ x, β (a (a (a x)) * a (a x) * x) = 1)
    (hright : ∀ x y, β x (a (a (a y)) * a (a y) * y) = 1)
    (hsquare : ∀ e : E, e * e = 1) : ∀ x y, β x y = 1 := by
  have hstep (x y : D) : β x (a y) = β x (a (a y)) := by
    have hl := congrArg (fun f : D →* E => f (a (a (a y)))) (hleft x)
    simp only [map_mul, MonoidHom.mul_apply, MonoidHom.one_apply] at hl
    rw [hact (a (a x)) (a (a y)),hact (a x) (a y),hact x y,
      hact (a x) (a (a y)),hact x (a y)] at hl
    have hr := hright x y
    simp only [map_mul] at hr
    apply mul_left_cancel (a := β x y * β x (a (a (a y))))
    calc
      _ = β x y * β x (a y) * β x (a (a (a y))) := by ac_rfl
      _ = 1 := hl
      _ = β x (a (a (a y))) * β x (a (a y)) * β x y := hr.symm
      _ = _ := by ac_rfl
  have hfixed (x y : D) : β x (a y) = β x y := by
    simpa only [a.apply_symm_apply] using (hstep x (a.symm y)).symm
  intro x y
  have h := hright x y
  simp only [map_mul,hfixed] at h
  rwa [hsquare,one_mul] at h

private theorem dual_singer_cubic (v : W) :
    dual singer (dual singer (dual singer v)) + dual singer (dual singer v) + v = 0 := by
  have hinv : singer⁻¹ = (⟨!![1,1,0; 0,0,1; 1,0,0], by decide⟩ : S) := by
    apply inv_eq_of_mul_eq_one_right
    decide +kernel
  have h : ∀ v : W,
      dual singer (dual singer (dual singer v)) + dual singer (dual singer v) + v = 0 := by
    simp only [dual,hinv]
    decide +kernel
  exact h v

variable {M : Type*} [Group M] [Finite M] {L R : Subgroup M}
  {geometry : Geometry R} {source : LocalSource L R}

omit [Finite M] in
private theorem marked_natural_pair_derived_le
    (common : CommonFacts R source geometry)
    {C B F D : Subgroup (FreeAmalgam R)}
    (s : MarkedPairSection source common C B false)
    (hCF : C ≤ normalizer F) (hCC : ⁅C,C⁆ ≤ F) (hFC : ⁅F,C⁆ ≤ D)
    (hBC : ⁅B,C⁆ ≤ D)
    {E : Type*} [CommGroup E] (q : F →* E)
    (hker : q.ker = D.subgroupOf F)
    (hfixed : ∀ (m : M) (x y : F),
      (y : FreeAmalgam R) = embedM R m * (x : FreeAmalgam R) * (embedM R m)⁻¹ → q y = q x)
    (hsquare : ∀ e : E, e * e = 1) : ⁅C,C⁆ ≤ D := by
  let β := layerPairing (A := C) q hker hCF hCC hFC
  let g : S := Matrix.SpecialLinearGroup.transpose singer⁻¹
  obtain ⟨m,hm⟩ := source.projection_surjective (common.natural.marking.symm g)
  have hmg : common.natural.marking (source.projection m) = g := by simp [hm]
  let a : MulAut C := C.normalizerMonoidHom ⟨embedM R m,s.normalized ⟨m,rfl⟩⟩
  have ha (x : C) : ((a x : C) : FreeAmalgam R) =
      embedM R m * (x : FreeAmalgam R) * (embedM R m)⁻¹ := rfl
  have hcoords (x : C) : (s.quotient (a x)).toAdd =
      (dual singer (s.quotient x).toAdd.1,dual singer (s.quotient x).toAdd.2) := by
    simpa only [hmg,Bool.false_eq_true,reduceIte,g,Matrix.SpecialLinearGroup.coe_transpose,dual]
      using s.action m x (a x) (ha x)
  have hnorm (x : C) : ((a (a (a x)) * a (a x) * x : C) : FreeAmalgam R) ∈ B := by
    have hk : a (a (a x)) * a (a x) * x ∈ s.quotient.ker := by
      rw [MonoidHom.mem_ker]
      apply Multiplicative.toAdd.injective
      change (s.quotient (a (a (a x)) * a (a x) * x)).toAdd = 0
      simp only [map_mul,toAdd_mul,hcoords]
      exact Prod.ext (dual_singer_cubic _) (dual_singer_cubic _)
    rwa [s.kernel] at hk
  have hact (x y : C) : β (a x) (a y) = β x y := by
    apply hfixed m
    change ⁅((a x : C) : FreeAmalgam R),((a y : C) : FreeAmalgam R)⁆ = _
    rw [ha,ha,← conjugate_commutatorElement]
  have hleft (x : C) : β (a (a (a x)) * a (a x) * x) = 1 := by
    apply MonoidHom.ext
    intro y
    change q _ = 1
    apply MonoidHom.mem_ker.mp
    rw [hker]
    exact hBC (commutator_mem_commutator (hnorm x) y.property)
  have hright (x y : C) : β x (a (a (a y)) * a (a y) * y) = 1 := by
    change q _ = 1
    apply MonoidHom.mem_ker.mp
    rw [hker]
    rw [commutator_comm] at hBC
    exact hBC (commutator_mem_commutator x.property (hnorm y))
  have hzero := binary_reciprocal_pairing_zero a β hact hleft hright hsquare
  apply commutator_le.mpr
  intro x hx y hy
  have h := hzero ⟨x,hx⟩ ⟨y,hy⟩
  change q ⟨⁅x,y⁆,_⟩ = 1 at h
  have hk := MonoidHom.mem_ker.mpr h
  rwa [hker] at hk

private theorem first_commutator_local_le_moving (common : CommonFacts R source geometry)
    (earlier : Earlier R geometry) (p : Early.SourcePath R (alpha R)) :
    ⁅hatV R (alpha R) (p.walk.getVert 6),stabilizer R (alpha R)⁆ ≤ Vcirc R (alpha R) := by
  let P := stabilizer R (alpha R)
  let D := Vcirc R (alpha R)
  have hDP : D ≤ P := (Vcirc_le_core rfl common.large_distance).trans
    ((DistanceTwo.core_le_Q _).trans (fun _ hx => hx.1))
  have hZ : ⁅Z R (alpha R),P⁆ ≤ D := by
    rw [Escape.Initial.Z_commutator_stabilizer source _ rfl]
    exact commutator_mono (Z_le_VBall R _ 2) le_rfl
  have hp : hatV R (alpha R) (p.walk.getVert 6) ≤ commutatorPreimage P P D := by
    rw [(Early.Orbit.Source.Complete.sourceOrbitFacts common earlier p).hatV_eq]
    exact sup_le (le_commutatorPreimage hDP
      (le_normalizer_iff_commutator_le_left.mp (Vcirc_normalized _)))
      (le_commutatorPreimage (Z_le_stabilizer R _) hZ)
  exact (commutator_mono hp le_rfl).trans
    (commutator_commutatorPreimage_le P P D (Vcirc_normalized _))

/-- Sharpening the second-hat/core commutator removes the fixed summand
from the core derived group by the reciprocal Singer relation. -/
theorem derived_le_of_second_commutator_le
    (common : CommonFacts R source geometry) (earlier : Earlier R geometry)
    (p : Early.SourcePath R (alpha R))
    (hmixed : ⁅hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8),
      core R (alpha R)⁆ ≤ Vcirc R (alpha R)) :
    ⁅core R (alpha R),core R (alpha R)⁆ ≤ Vcirc R (alpha R) := by
  let K := core R (alpha R)
  let B := hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8)
  let F := hatV R (alpha R) (p.walk.getVert 6)
  let D := Vcirc R (alpha R)
  let P := stabilizer R (alpha R)
  let C := K ⊔ B
  let T := hatSix R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8) (p.walk.getVert 10)
  let path := Early.Orbit.SourceApplications.higherPath geometry p
  have hBT : B ≤ T := OrbitGeometry.hatW_le_hatSix
    (p.even_color (i := 8) (by decide) (by decide))
    (by rw [SimpleGraph.dist_comm]; exact path.two_step_distances.2.2)
  have hCT : C ≤ T := sup_le (Early.Orbit.Source.Complete.core_le_third_hat common earlier p) hBT
  have hCP : C ≤ P := hCT.trans ((path.hatSix_le_Q earlier).trans (fun _ hx => hx.1))
  have hCC : ⁅C,C⁆ ≤ F := (commutator_mono hCT hCT).trans
    (le_sup_left.trans (OrbitGeometry.Source.commutator_layers common earlier p).2.le)
  have hFP : ⁅F,P⁆ ≤ D := first_commutator_local_le_moving common earlier p
  have hBC : ⁅B,C⁆ ≤ D := by
    let X := commutatorPreimage P B D
    have hCX : C ≤ X := sup_le
      (le_commutatorPreimage ((DistanceTwo.core_le_Q _).trans (fun _ hx => hx.1))
        (by rw [commutator_comm]; exact hmixed))
      (le_commutatorPreimage (le_sup_right.trans hCP)
        ((second_derived_le_U common earlier p).trans
          (commutator_mono (Z_le_VBall R _ 2) le_rfl)))
    rw [commutator_comm]
    exact (commutator_mono hCX le_rfl).trans
      (commutator_commutatorPreimage_le P B D (Vcirc_normalized _))
  let : IsElementaryAbelian 2 F := PathCentrality.localZSpan_elementary R
    (a := p.walk.getVert 6) (c := alpha R) rfl path.two_step_distances.1.le
    (by rw [earlier.distance]; decide)
  let N := D.subgroupOf F
  let : N.Normal := normal_of_isMulCommutative N
  let E := F ⧸ N
  let : IsElementaryAbelian 2 E := IsElementaryAbelian.quotient N
  let : CommGroup E := IsMulCommutative.instCommGroup
  let q : F →* E := QuotientGroup.mk' N
  obtain ⟨s⟩ := core_second_marked_natural_pair common earlier p
  have hderived : ⁅C,C⁆ ≤ D := marked_natural_pair_derived_le common s
    (hCP.trans (hatV_normalized R _ _)) hCC (commutator_mono le_rfl hCP |>.trans hFP)
    hBC q (QuotientGroup.ker_mk' N) (by
      intro m x y hy
      apply QuotientGroup.eq_iff_div_mem.mpr
      change (y : FreeAmalgam R) / (x : FreeAmalgam R) ∈ D
      rw [hy,div_eq_mul_inv]
      change ⁅embedM R m,(x : FreeAmalgam R)⁆ ∈ D
      rw [commutator_comm] at hFP
      exact hFP (commutator_mem_commutator (by
        simp only [P,alpha,stabilizer_m_base]; exact ⟨m,rfl⟩) x.property)) (by
      intro e
      exact (pow_two e).symm.trans
        (Monoid.exponent_dvd_iff_forall_pow_eq_one.mp (IsElementaryAbelian.exponent_dvd_p 2 E) e))
  exact (commutator_mono le_sup_left le_sup_left).trans hderived

private theorem third_square_mem_first (common : CommonFacts R source geometry)
    (earlier : Earlier R geometry) (p : Early.SourcePath R (alpha R))
    (x : FreeAmalgam R)
    (hx : x ∈ hatSix R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8) (p.walk.getVert 10)) :
    x ^ 2 ∈ hatV R (alpha R) (p.walk.getVert 6) := by
  let path := Early.Orbit.SourceApplications.higherPath geometry p
  let A := hatSix R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8) (p.walk.getVert 10)
  let F := hatV R (alpha R) (p.walk.getVert 6)
  let N := F.subgroupOf A
  let : N.Normal := normal_subgroupOf_of_le_normalizer
    (((path.hatSix_le_Q earlier).trans (fun _ hx => hx.1)).trans (hatV_normalized R _ _))
  let E := A ⧸ N
  let π : A →* E := QuotientGroup.mk' N
  have hcomm : ⁅A,A⁆ ≤ F := le_sup_left.trans
    (OrbitGeometry.Source.commutator_layers common earlier p).2.le
  let : IsMulCommutative E := ⟨⟨by
    intro x y
    obtain ⟨x,rfl⟩ := QuotientGroup.mk'_surjective N x
    obtain ⟨y,rfl⟩ := QuotientGroup.mk'_surjective N y
    rw [← commutatorElement_eq_one_iff_mul_comm, ← map_commutatorElement,
      QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact hcomm (commutator_mem_commutator x.property y.property)⟩⟩
  let K := ((powMonoidHom 2 : E →* E).comp π).ker
  have hK : A ≤ K.map A.subtype := by
    apply iSup_le
    intro g
    apply map_le_iff_le_comap.mpr
    apply iSup_le
    intro k x hx
    obtain ⟨v,hv,rfl⟩ := hx
    let f := (MulAut.conj (g : FreeAmalgam R)⁻¹).toMonoidHom.comp
      (MulAut.conj (k : FreeAmalgam R)⁻¹).toMonoidHom
    have hxA : f v ∈ A := by
      apply (le_iSup (fun t : stabilizer R (alpha R) =>
        rightConjugate (hatW R (p.walk.getVert 6) (p.walk.getVert 8) (p.walk.getVert 10)) t) g)
      apply mem_map_of_mem
      apply (le_iSup (fun t : stabilizer R (p.walk.getVert 6) =>
        rightConjugate (hatV R (p.walk.getVert 8) (p.walk.getVert 10)) t) k)
      exact mem_map_of_mem _ hv
    refine ⟨⟨f v,hxA⟩,?_,rfl⟩
    change (π ⟨f v,hxA⟩)^2 = 1
    rw [← map_pow]
    let : IsElementaryAbelian 2 (hatV R (p.walk.getVert 8) (p.walk.getVert 10)) :=
      PathCentrality.localZSpan_elementary R (a := p.walk.getVert 10)
      (c := p.walk.getVert 8) (p.even_color (by decide) (by decide))
      path.two_step_distances.2.2.le (by rw [earlier.distance]; decide)
    have he : (⟨f v,hxA⟩ : A)^2 = 1 := by
      apply Subtype.ext
      change (f v)^2 = 1
      rw [← map_pow,elemPow_eq_one_of_isElementaryAbelian v hv,map_one]
    rw [he,map_one]
  obtain ⟨y,hy,he⟩ := hK hx
  have hp : π (y ^ 2) = 1 := by rw [map_pow]; exact hy
  have hm := (QuotientGroup.eq_one_iff (N := N) _).mp hp
  change (y : FreeAmalgam R) ^ 2 ∈ F at hm
  change (y : FreeAmalgam R) = x at he
  rwa [he] at hm

/-- The actual source generation removes all squares once the derived
subgroup lies in the moving radius layer. No fixed-factor equality is used. -/
theorem elementary_of_derived_le (common : CommonFacts R source geometry)
    (earlier : Earlier R geometry)
    (hderived : ⁅core R (alpha R),core R (alpha R)⁆ ≤ Vcirc R (alpha R)) :
    IsElementaryAbelian 2 (Space R) := by
  obtain ⟨p⟩ := Early.sourcePath_nonempty source common earlier (alpha R) rfl
  let K := core R (alpha R)
  let D := Vcirc R (alpha R)
  let N := D.subgroupOf K
  let π : K →* Space R := QuotientGroup.mk' N
  let : IsMulCommutative (Space R) := ⟨⟨by
    intro x y
    obtain ⟨x,rfl⟩ := QuotientGroup.mk'_surjective N x
    obtain ⟨y,rfl⟩ := QuotientGroup.mk'_surjective N y
    rw [← commutatorElement_eq_one_iff_mul_comm, ← map_commutatorElement,
      QuotientGroup.mk'_apply, QuotientGroup.eq_one_iff]
    exact hderived (commutator_mem_commutator x.property y.property)⟩⟩
  let f : K →* Space R := (powMonoidHom 2).comp π
  have hgen : K ≤ f.ker.map K.subtype := by
    apply (show K ≤ ⁅K,Ltilde R (alpha R)⁆ from (source.core_full_commutation _ rfl).ge).trans
    apply commutator_le.mpr
    intro x hx l hl
    have hyK : l*x*l⁻¹ ∈ K := le_normalizer_iff.mp
      ((Ltilde_le_stabilizer _).trans (DistanceTwo.core_normalized _)) _ hl _ hx
    let u : K := ⟨x,hx⟩
    let v : K := ⟨l*x*l⁻¹,hyK⟩
    have hcK : ⁅x,l⁆ ∈ K := (source.core_full_commutation _ rfl).le
      (commutator_mem_commutator hx hl)
    refine ⟨⟨⁅x,l⁆,hcK⟩,?_,rfl⟩
    have hs : x ^ 2 ∈ hatV R (alpha R) (p.walk.getVert 6) :=
      third_square_mem_first common earlier p x
        (Early.Orbit.Source.Complete.core_le_third_hat common earlier p hx)
    have hsq : π (u ^ 2) = π (v ^ 2) := by
      apply QuotientGroup.eq_iff_div_mem.mpr
      change x ^ 2 / (l*x*l⁻¹)^2 ∈ D
      rw [conj_pow,div_eq_mul_inv]
      rw [show x ^ 2 * (l * x ^ 2 * l⁻¹)⁻¹ = ⁅x ^ 2,l⁆ from by
        simp only [commutatorElement_def]; group]
      exact first_commutator_local_le_moving common earlier p
        (commutator_mem_commutator hs (Ltilde_le_stabilizer _ hl))
    change (π ⟨⁅x,l⁆,hcK⟩)^2 = 1
    have he : (⟨⁅x,l⁆,hcK⟩ : K) = u*v⁻¹ := by
      apply Subtype.ext
      change ⁅x,l⁆ = x*(l*x*l⁻¹)⁻¹
      simp only [commutatorElement_def]
      group
    rw [he,map_mul,map_inv,mul_pow,inv_pow,← map_pow,← map_pow,hsq,mul_inv_cancel]
  refine { exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr ?_ }
  intro z
  obtain ⟨x,rfl⟩ := QuotientGroup.mk'_surjective N z
  obtain ⟨y,hy,he⟩ := hgen x.property
  have he' : y = x := Subtype.ext he
  subst y
  exact hy

/-- Elementarity of the literal core quotient reduces to the mixed
second-hat commutator bound on one genuine source path. -/
theorem elementary_of_second_commutator_le
    (common : CommonFacts R source geometry) (earlier : Earlier R geometry)
    (p : Early.SourcePath R (alpha R))
    (hmixed : ⁅hatW R (alpha R) (p.walk.getVert 6) (p.walk.getVert 8),
      core R (alpha R)⁆ ≤ Vcirc R (alpha R)) :
    IsElementaryAbelian 2 (Space R) :=
  elementary_of_derived_le common earlier
