module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Flags.RankOne.Triple.Preparatory.Incident.Locality
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.DistanceFour.Flags.RankOne.Triple.Natural.GeometryBound.Symmetry.Algebra

/-!
# The literal binary auxiliary layers in MS93 (4.6.8)

At a second-color vertex, Y is generated by the incident first-color layers,
D is the preimage of the fixed subgroup of the full actor on Y/U, and
X is [D,Q] Z_alpha. These are subgroups of the original amalgam, with the
original quotient marking. The full local actor normalizes all three.
The fixed subgroup description uses a quotient inside that finite actor;
no ambient normality is asserted. Nontriviality and the comparison with
the transported midpoint layers are subsequent mathematical obligations.

Source: Meierfrankenfeld--Stellmacher (1993), (4.6.8), printed pp.907--908.
-/

@[expose] public section
open Subgroup Stellmacher.PushingUp.AmalgamGraph
namespace CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Flags.RankOne.BinaryAuxiliary
variable {M : Type*} [Group M] {L R : Subgroup M}

/-- The source subgroup generated by all first-color neighbors of d. -/
noncomputable def Y (source : LocalSource L R) (i : Bool) (d : M) :
    Subgroup (FreeAmalgam R) :=
  ⨆ g : M, ⨆ (_ : flagIncident source i g d), firstFlagLayer (R := R) g

/-- The actual preimage of C_(Y/U)(L_d). -/
noncomputable def D (source : LocalSource L R) (i : Bool) (d : M) :
    Subgroup (FreeAmalgam R) :=
  commutatorPreimage (Y source i d) (localFlagActor source (!i) d)
    (secondFlagLayer source i d)

/-- The binary auxiliary layer X_d = [D_d,Q_d] Z_alpha. -/
noncomputable def X (source : LocalSource L R) (i : Bool) (d : M) :
    Subgroup (FreeAmalgam R) :=
  ⁅D source i d, localFlagKernel source (!i) d⁆ ⊔ Z R (alpha R)

theorem first_le_Y (source : LocalSource L R) (i : Bool) (g d : M)
    (h : flagIncident source i g d) : firstFlagLayer (R := R) g ≤ Y source i d :=
  le_iSup_of_le g (le_iSup_of_le h le_rfl)

theorem second_le_Y (source : LocalSource L R) (i : Bool) (d : M) :
    secondFlagLayer source i d ≤ Y source i d := by
  apply iSup_le
  intro g
  apply iSup_le
  intro h
  exact (commutatorPreimage_le _ _ _).trans (first_le_Y source i g d h)

theorem Y_le_radius (source : LocalSource L R) (i : Bool) (d : M) :
    Y source i d ≤ V R (alpha R) :=
  iSup_le fun g => iSup_le fun _ => firstFlagLayer_le_radius g

theorem Z_le_Y (source : LocalSource L R) (i : Bool) (d : M) :
    Z R (alpha R) ≤ Y source i d :=
  (Z_le_secondFlagLayer source i d).trans (second_le_Y source i d)

theorem Y_right_mul (source : LocalSource L R) (i : Bool) (d a : M)
    (ha : a ∈ parabolic source.projection source.flag (!i)) :
    Y source i (d * a) = Y source i d := by
  unfold Y
  simp only [flagIncident_right_second source i _ d a ha]

/-- The full-actor fixed preimage does not depend on a parabolic coset representative. -/
theorem D_right_mul (source : LocalSource L R) (i : Bool) (d a : M)
    (ha : a ∈ parabolic source.projection source.flag (!i)) :
    D source i (d * a) = D source i d := by
  rw [D, D, Y_right_mul source i d a ha,
    localFlagActor_right_mul source (!i) d a ha, secondFlagLayer_right_mul source i d a ha]

/-- The auxiliary displacement layer retains the same coset independence. -/
theorem X_right_mul (source : LocalSource L R) (i : Bool) (d a : M)
    (ha : a ∈ parabolic source.projection source.flag (!i)) :
    X source i (d * a) = X source i d := by
  rw [X, X, D_right_mul source i d a ha, localFlagKernel_right_mul source (!i) d a ha]

theorem Y_conjugate (source : LocalSource L R) (i : Bool) (a d : M) :
    localConjugate (Y source i d) a = Y source i (a * d) := by
  have hle (a d : M) : localConjugate (Y source i d) a ≤ Y source i (a * d) := by
    unfold localConjugate Y
    rw [Subgroup.map_iSup]
    apply iSup_le
    intro g
    rw [Subgroup.map_iSup]
    apply iSup_le
    intro h
    exact (localConjugate_mul (V R (beta R)) a g).symm.le.trans
      (first_le_Y source i (a * g) (a * d)
        ((Incident.flagIncident_left source i a g d).mpr h))
  apply le_antisymm (hle a d)
  have h := map_mono (f := (MulAut.conj (embedM R a)).toMonoidHom) (hle a⁻¹ (a * d))
  change localConjugate (localConjugate (Y source i (a * d)) a⁻¹) a ≤
    localConjugate (Y source i (a⁻¹ * (a * d))) a at h
  simpa only [← localConjugate_mul, mul_inv_cancel, localConjugate_one,
    inv_mul_cancel_left] using h

theorem Y_normalized (source : LocalSource L R) (i : Bool) (d : M) :
    localFlagActor source (!i) d ≤ normalizer (Y source i d) := by
  apply le_normalizer_iff.mpr
  rintro x ⟨y, ⟨a, ha, rfl⟩, rfl⟩ u hu
  have hc := Y_conjugate source i (d * a * d⁻¹) d
  have he : d * a * d⁻¹ * d = d * a := by group
  rw [he, Y_right_mul source i d a ha] at hc
  have hh := hc.le (mem_map_of_mem (MulAut.conj (embedM R (d * a * d⁻¹))).toMonoidHom hu)
  change embedM R (d * a * d⁻¹) * u * (embedM R (d * a * d⁻¹))⁻¹ ∈ Y source i d at hh
  change (embedM R d * embedM R a * (embedM R d)⁻¹) * u *
    (embedM R d * embedM R a * (embedM R d)⁻¹)⁻¹ ∈ Y source i d
  simpa only [map_mul, map_inv] using hh

variable [Finite M]

theorem Y_le_actor (source : LocalSource L R) (geometry : Geometry R)
    (hlarge : 2 < geometry.b R) (i : Bool) (d : M) :
    Y source i d ≤ localFlagActor source (!i) d :=
  (Y_le_radius source i d).trans ((V_le_Q geometry hlarge _ rfl).trans
    ((Q_alpha_le_localFlagKernel source (!i) d).trans (map_mono (flagKernel_le source (!i)))))

theorem Y_normalizes_second (source : LocalSource L R) (geometry : Geometry R)
    (hlarge : 2 < geometry.b R) (i : Bool) (d : M) :
    Y source i d ≤ normalizer (secondFlagLayer source i d) :=
  (Y_le_actor source geometry hlarge i d).trans
    (Incident.secondFlagLayer_normalized source geometry hlarge i d)

omit [Finite M] in
theorem second_le_D (source : LocalSource L R) (geometry : Geometry R)
    (hlarge : 2 < geometry.b R) (i : Bool) (d : M) :
    secondFlagLayer source i d ≤ D source i d :=
  le_commutatorPreimage (second_le_Y source i d)
    (le_normalizer_iff_commutator_le_left.mp
      (Incident.secondFlagLayer_normalized source geometry hlarge i d))

omit [Finite M] in
theorem D_le_Y (source : LocalSource L R) (i : Bool) (d : M) :
    D source i d ≤ Y source i d := commutatorPreimage_le _ _ _

theorem D_commutator_actor (source : LocalSource L R) (geometry : Geometry R)
    (hlarge : 2 < geometry.b R) (i : Bool) (d : M) :
    ⁅D source i d, localFlagActor source (!i) d⁆ ≤ secondFlagLayer source i d :=
  commutator_commutatorPreimage_le _ _ _ (Y_normalizes_second source geometry hlarge i d)

/-- Since D fixes the full actor modulo U, the source X lies in U. -/
theorem X_le_second (source : LocalSource L R) (geometry : Geometry R)
    (hlarge : 2 < geometry.b R) (i : Bool) (d : M) :
    X source i d ≤ secondFlagLayer source i d :=
  sup_le ((commutator_mono le_rfl (map_mono (flagKernel_le source (!i)))).trans
    (D_commutator_actor source geometry hlarge i d)) (Z_le_secondFlagLayer source i d)

private theorem mapped_normalized {G : Type*} [Group G] (A B : Subgroup G)
    (h : A ≤ normalizer B) (f : G →* G) : A.map f ≤ normalizer (B.map f) := by
  apply le_normalizer_iff_commutator_le_right.mpr
  rw [← map_commutator]
  exact map_mono (le_normalizer_iff_commutator_le_right.mp h)

theorem D_normalized (source : LocalSource L R) (geometry : Geometry R)
    (hlarge : 2 < geometry.b R) (i : Bool) (d : M) :
    localFlagActor source (!i) d ≤ normalizer (D source i d) :=
  commutatorPreimage_normalized _ _ _ _ (Y_normalizes_second source geometry hlarge i d)
    (Y_normalized source i d)
    (localFlagActor source (!i) d).le_normalizer
    (Incident.secondFlagLayer_normalized source geometry hlarge i d)

theorem X_le_D (source : LocalSource L R) (geometry : Geometry R)
    (hlarge : 2 < geometry.b R) (i : Bool) (d : M) :
    X source i d ≤ D source i d :=
  sup_le (le_normalizer_iff_commutator_le_left.mp
    ((map_mono (flagKernel_le source (!i))).trans (D_normalized source geometry hlarge i d)))
    ((Z_le_secondFlagLayer source i d).trans (second_le_D source geometry hlarge i d))

theorem X_normalized (source : LocalSource L R) (geometry : Geometry R)
    (hlarge : 2 < geometry.b R) (i : Bool) (d : M) :
    localFlagActor source (!i) d ≤ normalizer (X source i d) := by
  intro x hx
  apply mem_normalizer_iff_map_conj_eq.mpr
  change (⁅D source i d, localFlagKernel source (!i) d⁆ ⊔ Z R (alpha R)).map _ = _
  have hK : localFlagActor source (!i) d ≤ normalizer (localFlagKernel source (!i) d) :=
    mapped_normalized _ _ (flagKernel_normalized source (!i)) _
  rw [Subgroup.map_sup, map_commutator,
    mem_normalizer_iff_map_conj_eq.mp (D_normalized source geometry hlarge i d hx),
    mem_normalizer_iff_map_conj_eq.mp
      (hK hx),
    mem_normalizer_iff_map_conj_eq.mp
      (Z_normalized R _ (localFlagActor_le_stabilizer source (!i) d hx))]
  rfl

/-- Exact quotient meaning of D, with normality only in the actual local actor. -/
theorem D_quotient (source : LocalSource L R) (geometry : Geometry R)
    (hlarge : 2 < geometry.b R) (i : Bool) (d : M) :
    let P := localFlagActor source (!i) d
    let U := (secondFlagLayer source i d).subgroupOf P
    letI : U.Normal := normal_subgroupOf_of_le_normalizer
      (Incident.secondFlagLayer_normalized source geometry hlarge i d)
    (D source i d).subgroupOf P = (Y source i d).subgroupOf P ⊓
      (centralizer (((localFlagActor source (!i) d).subgroupOf P).map
        (QuotientGroup.mk' U) : Set (P ⧸ U))).comap (QuotientGroup.mk' U) := by
  dsimp only
  let := normal_subgroupOf_of_le_normalizer
    (Incident.secondFlagLayer_normalized source geometry hlarge i d)
  rw [D, commutatorPreimage_subgroupOf _ _ _ _ (Y_le_actor source geometry hlarge i d)
    le_rfl
    (Incident.secondFlagLayer_normalized source geometry hlarge i d)]
  exact commutatorPreimage_eq_inf_comap_centralizer _ _ _

end CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceFour.Flags.RankOne.BinaryAuxiliary
