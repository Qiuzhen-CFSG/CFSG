module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.AutomorphismNoFF.Reduction
public import Theory.Representation.InvertedOddSupportRank
public import Theory.GroupTheory.NormalizedSupCard

/-!
# Six-dimensional Singer displacement in faithful binary automorphism actions

Let R be generated by the specified order-seven inner automorphism of SL₃(2).
Coprime action splits a binary module into its R-fixed space and its support U.
Faithfulness makes U nontrivial, and its R-fixed subgroup is trivial. Orbit
counting gives |U| ≡ 1 mod 7. The graph involution inverts R, so the inverted
odd-support theorem makes |U| a square.

The fixed-space cardinality and the coprime direct product identify
|U| = 2 ^ fixedCodim. Below dimension six the congruence and nontriviality
leave only |U| = 8, which is not a square. This proves the displacement input
of the direct FF exclusion without any irreducibility or constituent hypothesis.

Source: Aschbacher–Smith, C.1.32 proof, printed pp.135–136, and the binary
SL₃ case of B.4.2/B.5.1, printed pp.86 and 99–103, combined manuscript of
1 March 2004. This module proves only the independent Singer bound; the
full automorphism FF exclusion is assembled by its separate owner.
-/

open Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterC.BinaryMS.AutomorphismNoFF

private theorem graph_involution : IsInvolution (BinaryLinear.OuterCyclic.graphSL 3) := by
  refine ⟨?_, BinaryLinear.OuterCyclic.graphSL_sq 3⟩
  intro he
  have hh := graph_inverts_singerActor
  rw [he, one_mul, inv_one, mul_one] at hh
  have hs : singerActor ^ 2 = 1 := by
    calc
      singerActor ^ 2 = singerActor * singerActor := pow_two _
      _ = singerActor⁻¹ * singerActor := congrArg (fun x => x * singerActor) hh
      _ = 1 := inv_mul_cancel _
  have hd := orderOf_dvd_of_pow_eq_one hs
  rw [singerActor_order] at hd
  norm_num at hd

private theorem graph_inverts_singer_powers :
    ∀ r ∈ Subgroup.zpowers singerActor,
      BinaryLinear.OuterCyclic.graphSL 3 * r *
        (BinaryLinear.OuterCyclic.graphSL 3)⁻¹ = r⁻¹ := by
  rintro r ⟨n, rfl⟩
  change MulAut.conj (BinaryLinear.OuterCyclic.graphSL 3) (singerActor ^ n) = _
  rw [map_zpow]
  change (BinaryLinear.OuterCyclic.graphSL 3 * singerActor *
    (BinaryLinear.OuterCyclic.graphSL 3)⁻¹) ^ n = _
  rw [graph_inverts_singerActor, inv_zpow]

private theorem six_le_of_support_card (d m : ℕ)
    (hne : 2 ^ d ≠ 1) (hmod : 2 ^ d % 7 = 1) (hsquare : 2 ^ d = m ^ 2) :
    6 ≤ d := by
  by_contra hlt
  have hd : d < 6 := by omega
  interval_cases d <;> norm_num at *
  rcases Nat.lt_or_ge m 3 with hm | hm <;> nlinarith

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V]

/-- The specified Singer actor displaces at least six dimensions on every
faithful finite-dimensional binary representation of the actual Aut(SL₃(2)). -/
public theorem six_le_singer_fixedCodim (ρ : Representation (ZMod 2) AutSL V)
    (hfaith : Function.Injective ρ) :
    6 ≤ fixedCodim ρ (Subgroup.zpowers singerActor) := by
  classical
  let : Fact (Nat.Prime 7) := ⟨by decide⟩
  let : Finite V := Module.finite_of_finite (ZMod 2)
  let W := Multiplicative V
  let : IsElementaryAbelian 2 W := {
    exponent_dvd_p := Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr (by
      intro x
      change (2 : ℕ) • x.toAdd = 0
      rw [← Nat.cast_smul_eq_nsmul (ZMod 2)]
      exact zero_smul (ZMod 2) x.toAdd) }
  let f : AutSL →* MulAut W := {
    toFun g := (LinearMap.GeneralLinearGroup.toLinearEquiv (ρ.asGroupHom g)).toAddEquiv.toMultiplicative
    map_one' := by ext v; exact congrArg Multiplicative.ofAdd (LinearMap.congr_fun ρ.map_one v.toAdd)
    map_mul' g h := by ext v; exact congrArg Multiplicative.ofAdd (LinearMap.congr_fun (ρ.map_mul g h) v.toAdd) }
  let : MulDistribMulAction AutSL W := MulDistribMulAction.compHom W f
  let R := Subgroup.zpowers singerActor
  let U := commutatorAction R W
  let C := FixedPoints.subgroup R W
  have hR : Nat.card R = 7 := by rw [Nat.card_zpowers, singerActor_order]
  have hodd : Odd (Nat.card R) := by rw [hR]; decide
  have hcop : Nat.Coprime (Nat.card R) (Nat.card W) := by
    obtain ⟨n, hn⟩ := (IsElementaryAbelian.isPGroup 2 W).exists_card_eq
    rw [hn]
    exact hodd.coprime_two_right.pow_right n
  have hcompl : IsCompl C U :=
    isCompl_fixedPointSubgroup_commutatorAction_of_solvable_coprime_of_isMulCommutative
      (G := W) (A := R) (Group.isSolvable_of_comm fun x y => mul_comm x y) hcop inferInstance
  have hUne : U ≠ ⊥ := by
    intro hbot
    have hfix := actsTrivially_of_commutatorAction_eq_bot hbot
    have he : singerActor = 1 := by
      apply hfaith
      rw [map_one]
      ext v
      exact congrArg Multiplicative.toAdd
        (hfix ⟨singerActor, Subgroup.mem_zpowers singerActor⟩ (Multiplicative.ofAdd v))
    have hh := singerActor_order
    simp [he] at hh
  let : IsInvariant R W U := commutatorAction_isInvariant
  have hfixed : FixedPoints.subgroup R U = ⊥ := by
    apply bot_unique
    intro u hu
    apply Subtype.ext
    exact hcompl.disjoint.le_bot ⟨fun r => congrArg Subtype.val (hu r), u.property⟩
  have hp : IsPGroup 7 R := IsPGroup.of_card (n := 1) (by simpa using hR)
  have hmod := hp.card_modEq_card_fixedPoints U
  change Nat.card U % 7 = Nat.card (FixedPoints.subgroup R U) % 7 at hmod
  rw [hfixed, Subgroup.card_bot] at hmod
  obtain ⟨hsquare, _, _⟩ := invertedOddSubgroup_support_card_data (W := W)
    R hodd (BinaryLinear.OuterCyclic.graphSL 3) graph_involution graph_inverts_singer_powers
  change Nat.card U = _ at hsquare
  have hCcard : Nat.card C = 2 ^ Module.finrank (ZMod 2) (fixedSpace ρ R) := by
    let e : C ≃ fixedSpace ρ R := {
      toFun x := ⟨x.val.toAdd, fun r => congrArg Multiplicative.toAdd (x.property r)⟩
      invFun x := ⟨Multiplicative.ofAdd x.val, fun r => congrArg Multiplicative.ofAdd (x.property r)⟩
      left_inv x := rfl
      right_inv x := rfl }
    rw [Nat.card_congr e]
    simpa only [Nat.card_zmod] using
      Module.natCard_eq_pow_finrank (K := ZMod 2) (V := fixedSpace ρ R)
  have hWcard : Nat.card W = 2 ^ Module.finrank (ZMod 2) V := by
    change Nat.card V = _
    simpa only [Nat.card_zmod] using
      Module.natCard_eq_pow_finrank (K := ZMod 2) (V := V)
  -- The coprime product, with its actual fixed-space factor, gives the exact
  -- support cardinality corresponding to fixed codimension.
  have hUcard : Nat.card U = 2 ^ fixedCodim ρ R := by
    let : C.Normal := Subgroup.normal_of_isMulCommutative C
    have hprod := Subgroup.card_sup_eq_mul_of_normalizes_of_disjoint C U
      (by rw [Subgroup.normalizer_eq_top]; exact le_top) hcompl.disjoint
    rw [hcompl.sup_eq_top, Subgroup.card_top, hWcard, hCcard] at hprod
    have hd := fixedCodim_add_finrank ρ R
    rw [← hd, pow_add] at hprod
    exact Nat.eq_of_mul_eq_mul_left (by positivity : 0 < 2 ^ Module.finrank (ZMod 2) (fixedSpace ρ R))
      (by simpa only [mul_comm] using hprod.symm)
  have hUone : Nat.card U ≠ 1 := fun h => hUne (Subgroup.card_eq_one.mp h)
  rw [hUcard] at hmod hsquare hUone
  exact six_le_of_support_card (fixedCodim ρ R) _ hUone hmod hsquare

end CFSG.Quasithin.ChapterC.BinaryMS.AutomorphismNoFF
