private theorem residual_eq_of_saturated_fixed_preimage
    {G T : Type*} [Group G] [Finite G] [Group T] [IsSimpleGroup T]
    (f : G →* T) (hf : Function.Surjective f) (hk : IsPGroup 2 f.ker)
    (Q P C A : Subgroup G) [Q.Normal] [P.Normal]
    (hPQ : P ≤ Q) (hCQ : C ≤ Q) (hi : C.relIndex Q ≤ C.relIndex P)
    (hCA : ⁅C,A⁆ ≤ P) (hA : ¬ A ≤ f.ker)
    (hm : ⁅Q,pResidual 2 G⁆=Q) : Q=P := by
  have hjoin : P ⊔ C ≤ Q := sup_le hPQ hCQ
  have hgen : P ⊔ C=Q := by
    have hmul := relIndex_mul_relIndex C (P ⊔ C) Q le_sup_right hjoin
    rw [relIndex_sup_of_normal_left] at hmul
    have hpos : 0 < C.relIndex P := Nat.pos_of_ne_zero index_ne_zero_of_finite
    have hle : (P ⊔ C).relIndex Q ≤ 1 := by
      apply Nat.le_of_mul_le_mul_left _ hpos
      simpa only [Nat.mul_one,hmul] using hi
    have hne : (P ⊔ C).relIndex Q ≠ 0 := index_ne_zero_of_finite
    exact le_antisymm hjoin (relIndex_eq_one.mp (by omega))
  have hQA : ⁅Q,A⁆ ≤ P := by
    rw [←hgen]
    exact commutator_sup_le_of_relative_normal ⊤ P C A P le_normalizer_of_normal
      le_top le_top (commutator_le_left P A) hCA
  have hres := commutator_pResidual_le_of_simple_kernel_escape 2 f hf hk Q P A hA hQA
  exact le_antisymm (hm ▸ hres) hPQ

variable {H F : Type*} [Group H] [Finite H] [Field F] [Finite F] [CharP F 2]
variable {K R : Subgroup H} {n : ℕ} (h : Input K R n F)
variable (d : CharacteristicReduction K R)
include h

omit [Finite F] [CharP F 2] in
private theorem original_span_fixed_preimage_lower
    {geometry : Geometry d.radical} {a z : Vertex d.radical}
    (path : CriticalPath d.radical geometry a z) (hb : geometry.b d.radical=4)
    (hnat : distanceFourRootSpanWhole geometry a (path.walk.getVert 2) z n) :
    let Q₀ := ⁅Q d.radical a,Ltilde d.radical a⁆
    let P := ⁅localZSpan d.radical (path.walk.getVert 2) a,Ltilde d.radical a⁆
    Nat.card F ≤ (commutatorPreimage Q₀ (Z d.radical z) (U d.radical a)).relIndex P := by
  obtain ⟨E,hE,f,hf,hfQ,hD,hdata⟩ := hnat
  let := hD
  obtain ⟨hEA,hdata⟩ := hdata
  let := hEA
  obtain ⟨σ,hfaith,c,hcoord,hactor,hzero,hIrr,hwhole,Eₙ,hEₙ,eₙ,eW,heW⟩ := hdata
  let S := stabilizer d.radical a
  let W := localZSpan d.radical (path.walk.getVert 2) a
  let P := ⁅W,Ltilde d.radical a⁆
  let Q₀ := ⁅Q d.radical a,Ltilde d.radical a⁆
  let A := Z d.radical z
  let C := commutatorPreimage Q₀ A (U d.radical a)
  have hPW : P ≤ W := le_normalizer_iff_commutator_le_left.mp
    ((Ltilde_le_stabilizer a).trans (localZSpan_normalized d.radical _ a))
  have hPS : P ≤ S := hPW.trans c.section_le
  have hSP : S ≤ normalizer (P : Set (FreeAmalgam d.radical)) :=
    root_span_movement_normalized d.radical a (path.walk.getVert 2)
  have himage : c.imageSpace P=⊤ :=
    (root_span_moved_image h d geometry a (path.walk.getVert 2) E hE f hf σ c).trans hwhole
  have honto : Function.Surjective (c.coordinates.comp (inclusion hPW)) := by
    intro v
    obtain ⟨w,hw,he⟩ := (c.mem_imageSpace_iff P v.toAdd).mp (himage.symm ▸ Submodule.mem_top)
    exact ⟨⟨w,hw⟩,Multiplicative.toAdd.injective he⟩
  let cp := c.restrict P hPW hSP honto
  let D := P ⊓ (W ⊓ B d.radical a (geometry.Z_normal a))
  have hSD : S ≤ normalizer (D : Set (FreeAmalgam d.radical)) :=
    (le_inf hSP c.kernel_normalized).trans inf_normalizer_le_normalizer_inf
  have hAS : A ≤ S := path.endpoint_Z_le_start_stabilizer (by omega)
  let := finite_stabilizer d.radical a
  let : Finite P := Finite.of_injective (inclusion hPS) (inclusion_injective _)
  have hi := cp.fixed_index_of_relative_normalizers A hAS (hPS.trans hSD) (hAS.trans hSD)
  change (commutatorPreimage P A D).relIndex P=
    2 ^ fixedCodim (σ.comp f) (A.subgroupOf S) at hi
  have hlo : n ≤ fixedCodim (σ.comp f) (A.subgroupOf S) := by
    change n ≤ Module.finrank (ZMod 2) (_ ⧸ fixedSpace (σ.comp f) (A.subgroupOf S))
    rw [fixedSpace_comp_map]
    change n ≤ fixedCodim σ ((A.subgroupOf S).map f)
    rw [fixedCodim_map_equivariant σ (binarySymplectic Eₙ) eW.groupEquiv.toMonoidHom
      eW.linearEquiv eW.intertwines]
    rw [←hEₙ]
    apply SymplecticConjugatePair.NaturalBounds.natural_fixedCodim_lower Eₙ.card_eq
    exact (((A.subgroupOf S).map f).map_eq_bot_iff_of_injective
      eW.groupEquiv.injective).not.mpr hactor.1.1
  have hfield : Nat.card F ≤ (commutatorPreimage P A D).relIndex P := by
    rw [hi,h.field_card]
    exact Nat.pow_le_pow_right (by decide) hlo
  have hl := path.length_eq_b
  have hZaW : Z d.radical a ≤ W := LocalCommutator.center_Z_le_span path.start_color
    (by rw [SimpleGraph.dist_comm,path.dist_start (by omega)])
  have hUP : U d.radical a ≤ P := commutator_mono hZaW le_rfl
  have hUD : U d.radical a ≤ D := le_inf hUP (le_inf
    ((U_le_Z a).trans hZaW)
    ((U_le_Z a).trans (Escape.EdgeTransfer.Z_le_B (by omega) a path.start_color)))
  have hQ₀S : Q₀ ≤ S := (Subgroup.commutator_le_sup _ _).trans
    (sup_le (fun _ hx => hx.1) (Ltilde_le_stabilizer a))
  have hCU : ⁅C,A⁆ ≤ U d.radical a :=
    commutator_commutatorPreimage_le Q₀ A (U d.radical a) (hQ₀S.trans (U_normalized a))
  have hpre : C ⊓ P ≤ commutatorPreimage P A D :=
    le_commutatorPreimage inf_le_right ((commutator_mono inf_le_left le_rfl).trans (hCU.trans hUD))
  have hi' := relIndex_le_of_le_left hpre (L := P) index_ne_zero_of_finite
  rw [inf_relIndex_right] at hi'
  exact hfield.trans hi'

/-- The actual midpoint orbit, fixed-radius branch and two seed budgets
identify the full original residual with the native midpoint-span movement. -/
theorem Input.replacement_distance_four_original_residual_eq_span_commutator
    {geometry : Geometry d.radical} {a z : Vertex d.radical}
    (path : CriticalPath d.radical geometry a z) (hb : geometry.b d.radical=4)
    (g : FreeAmalgam d.radical) (hg : g ∈ stabilizer d.radical (path.walk.getVert 2))
    (hga : act d.radical g a=z)
    (hfixed : ⁅V d.radical a,Q d.radical a⁆ ≤ fixedCore d.radical a)
    (hfirst : (B d.radical a (geometry.Z_normal a)).relIndex
      (U d.radical (path.walk.getVert 2)) ≤ Nat.card F)
    (hlast : (B d.radical (path.walk.getVert 2) (geometry.Z_normal _)).relIndex
      (U d.radical z) ≤ Nat.card F) :
    ⁅Q d.radical a,Ltilde d.radical a⁆ =
      ⁅localZSpan d.radical (path.walk.getVert 2) a,Ltilde d.radical a⁆ := by
  have hnat := h.replacement_distance_four_root_span_whole d path hb g hg hga hfixed hfirst hlast
  have hlower := original_span_fixed_preimage_lower h d path hb hnat
  have hupper := (h.replacement_distance_four_residual_terminal_fixed_index d
    path hb g hg hga hfixed hfirst hlast).2
  obtain ⟨E,hE,f,hf,hfQ,hrest⟩ := hnat
  let S := stabilizer d.radical a
  let W := localZSpan d.radical (path.walk.getVert 2) a
  let P := ⁅W,Ltilde d.radical a⁆
  let Q₀ := ⁅Q d.radical a,Ltilde d.radical a⁆
  let A := Z d.radical z
  let C := commutatorPreimage Q₀ A (U d.radical a)
  have hl := path.length_eq_b
  have hWQ : W ≤ Q d.radical a := localZSpan_le_Q d.radical path.start_color
    (by rw [SimpleGraph.dist_comm,path.dist_start (by omega)]) (by omega)
  have hPQ : P ≤ Q₀ := commutator_mono hWQ le_rfl
  have hQ₀Q : Q₀ ≤ Q d.radical a := le_normalizer_iff_commutator_le_left.mp
    ((Ltilde_le_stabilizer a).trans (Q_normalized d.radical a))
  have hQa : Q d.radical a ≤ S := fun _ hx => hx.1
  have hQ₀S : Q₀ ≤ S := hQ₀Q.trans hQa
  have hPS : P ≤ S := hPQ.trans hQ₀S
  have hCS : C ≤ S := (commutatorPreimage_le _ _ _).trans hQ₀S
  have hAS : A ≤ S := path.endpoint_Z_le_start_stabilizer (by omega)
  have hSP : S ≤ normalizer (P : Set (FreeAmalgam d.radical)) :=
    root_span_movement_normalized d.radical a (path.walk.getVert 2)
  have hSL : S ≤ normalizer (Ltilde d.radical a : Set (FreeAmalgam d.radical)) := by
    have hh := le_normalizer_map (H := pResidual 2 S) S.subtype
    rw [normalizer_eq_top,←MonoidHom.range_eq_map,range_subtype] at hh
    exact hh
  have hSQ₀ : S ≤ normalizer (Q₀ : Set (FreeAmalgam d.radical)) := by
    intro x hx
    rw [mem_normalizer_iff_map_conj_eq,map_commutator,
      mem_normalizer_iff_map_conj_eq.mp (Q_normalized d.radical a hx),
      mem_normalizer_iff_map_conj_eq.mp (hSL hx)]
  let Qn := Q₀.subgroupOf S
  let Pn := P.subgroupOf S
  let Cn := C.subgroupOf S
  let An := A.subgroupOf S
  let := finite_stabilizer d.radical a
  let : Qn.Normal := normal_subgroupOf_of_le_normalizer hSQ₀
  let : Pn.Normal := normal_subgroupOf_of_le_normalizer hSP
  have hqmap : Qn.map S.subtype=Q₀ := map_subgroupOf_eq_of_le hQ₀S
  have hpmap : Pn.map S.subtype=P := map_subgroupOf_eq_of_le hPS
  have hcmap : Cn.map S.subtype=C := map_subgroupOf_eq_of_le hCS
  have hamap : An.map S.subtype=A := map_subgroupOf_eq_of_le hAS
  have hqnative : Qn=⁅(Q d.radical a).subgroupOf S,pResidual 2 S⁆ := by
    apply Subgroup.map_injective S.subtype_injective
    rw [hqmap,map_commutator,map_subgroupOf_eq_of_le hQa]
    rfl
  have hpQ : IsPGroup 2 ((Q d.radical a).subgroupOf S) :=
    (Q_isPGroup d.radical (h.replacement_two_group d) (h.replacement_core_le d)
      a path.start_color).comap_subtype
  let : ((Q d.radical a).subgroupOf S).Normal := Q_normal d.radical a
  have hmove : ⁅Qn,pResidual 2 S⁆=Qn := by
    rw [hqnative]
    exact commutator_isPPerfect_idempotent _ _ (isPPerfect_pResidual 2) hpQ le_normalizer_of_normal
  have hlarge : 3 < Nat.card E.Carrier := by
    rw [E.card_eq,hE]
    exact (by decide : 3 < 2^2).trans_le (Nat.pow_le_pow_right (by decide) h.nonbinary)
  let := SimpleQuotients.isSimpleGroup hlarge
  let : IsSimpleGroup (Sp E.Carrier) := EvenProjective.equiv.isSimpleGroup
  have hker : IsPGroup 2 f.ker := by
    have hp := Q_isPGroup d.radical (h.replacement_two_group d) (h.replacement_core_le d)
      a path.start_color
    exact (hfQ.symm ▸ hp).of_injective
      (f.ker.equivMapOfInjective S.subtype S.subtype_injective).toMonoidHom
      (f.ker.equivMapOfInjective S.subtype S.subtype_injective).injective
  have hAn : ¬ An ≤ f.ker := by
    intro he
    have hh := map_mono (f := S.subtype) he
    rw [hamap,hfQ] at hh
    have hi := (h.replacement_distance_four_fixed_critical_indices d hb path.start_color hfixed path).2
    have he := relIndex_eq_one.mpr hh
    rw [hi] at he
    exact (ne_of_gt (Finite.one_lt_card (α := F))) he
  have hZaW : Z d.radical a ≤ W := LocalCommutator.center_Z_le_span path.start_color
    (by rw [SimpleGraph.dist_comm,path.dist_start (by omega)])
  have hUP : U d.radical a ≤ P := commutator_mono hZaW le_rfl
  have hCA : ⁅Cn,An⁆ ≤ Pn := by
    apply (map_le_map_iff_of_injective S.subtype_injective).mp
    rw [map_commutator,hcmap,hamap,hpmap]
    exact (commutator_commutatorPreimage_le Q₀ A (U d.radical a)
      (hQ₀S.trans (U_normalized a))).trans hUP
  have hi : Cn.relIndex Qn ≤ Cn.relIndex Pn := by
    rw [relIndex_subgroupOf hQ₀S,relIndex_subgroupOf hPS]
    exact hupper.trans hlower
  have he := residual_eq_of_saturated_fixed_preimage f hf hker Qn Pn Cn An
    (comap_mono hPQ) (comap_mono (commutatorPreimage_le _ _ _)) hi hCA hAn hmove
  have hh := congrArg (Subgroup.map S.subtype) he
  rwa [hqmap,hpmap] at hh

/-- The original full residual and the midpoint span have the same derived
subgroup, and every original residual intersection of index at most q retains it. -/
theorem Input.replacement_distance_four_original_residual_derived
    {geometry : Geometry d.radical} {a z : Vertex d.radical}
    (path : CriticalPath d.radical geometry a z) (hb : geometry.b d.radical=4)
    (g : FreeAmalgam d.radical) (hg : g ∈ stabilizer d.radical (path.walk.getVert 2))
    (hga : act d.radical g a=z)
    (hfixed : ⁅V d.radical a,Q d.radical a⁆ ≤ fixedCore d.radical a)
    (hfirst : (B d.radical a (geometry.Z_normal a)).relIndex
      (U d.radical (path.walk.getVert 2)) ≤ Nat.card F)
    (hlast : (B d.radical (path.walk.getVert 2) (geometry.Z_normal _)).relIndex
      (U d.radical z) ≤ Nat.card F) :
    let W := localZSpan d.radical (path.walk.getVert 2) a
    let Q₀ := ⁅Q d.radical a,Ltilde d.radical a⁆
    ⁅Q₀,Q₀⁆=⁅W,W⁆ ∧ Nat.card (⁅Q₀,Q₀⁆ : Subgroup (FreeAmalgam d.radical)) ≤ Nat.card F ∧
      ∀ Y : Subgroup (FreeAmalgam d.radical), (Y.subgroupOf Q₀).index ≤ Nat.card F →
        ⁅Q₀ ⊓ Y,Q₀ ⊓ Y⁆=⁅Q₀,Q₀⁆ := by
  dsimp only
  rw [h.replacement_distance_four_original_residual_eq_span_commutator d path hb
    g hg hga hfixed hfirst hlast]
  obtain ⟨_,he,hcard,hindex⟩ := h.replacement_distance_four_root_span_derived d
    path hb g hg hga hfixed hfirst hlast
  exact ⟨he.symm,he ▸ hcard,fun Y hi => (hindex Y hi).trans he⟩

