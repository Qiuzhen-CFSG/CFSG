module
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.NonbinarySymplectic.CriticalReduction.Geometry
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Sp4Four.DistanceReduction.RadiusObstruction
public import Theory.GroupAction.SymplecticSmallTwoSection.DegreeBound

/-!
# Radius growth at the original nonbinary field degree

The literal vertex residual maps onto the original symplectic matrix group
with a two-group kernel. Its two-perfectness therefore forces every
normalized radius section of order below q⁴ to be fixed. Applying this to
the whole radius would make the nontrivial edge ball normal in both vertex
stabilizers, contrary to MS3. Hence the actual radius quotient has order at
least q⁴. The full central seed is retained as denominator.

The smaller-subgroup application puts the original section preimage in B,
providing the fixed-kernel step used in the backward-path argument.
Source: MS93 (2.1)(iii), printed p.856, and (5.7)--(5.8), pp.919--920.
-/

public section
open Subgroup Theory.GroupTheory Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.BinaryMS.MS93
open CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality
open CFSG.Quasithin.ChapterC.RankTwo.Sp4Four
namespace CFSG.Quasithin.ChapterC.RankTwo.NonbinarySymplectic
variable {H F : Type*} [Group H] [Finite H] [Field F] [Finite F] [CharP F 2]
variable {K R : Subgroup H} {n : ℕ} (h : Input K R n F)
variable (d : CharacteristicReduction K R)
include h

omit [Finite F] [CharP F 2] in
/-- The actual local residual has the original matrix quotient and a two-group kernel. -/
theorem Input.replacement_residual_projection
    {a : Vertex d.radical} (ha : color d.radical a = false) :
    ∃ r : Ltilde d.radical a →* Matrix.symplecticGroup (Fin 2) F,
      Function.Surjective r ∧ IsPGroup 2 r.ker := by
  let q := QuotientGroup.mk' (pCore 2 d.overgroup)
  obtain ⟨r,hr,hker⟩ :
      ∃ r : Ltilde d.radical a →* (K.subgroupOf d.overgroup).map q,
        Function.Surjective r ∧ IsPGroup 2 r.ker := by
    rw [← h.replacement_residual d]
    exact local_residual_projection d.radical
      (h.replacement_two_group d) (h.replacement_core_le d) q (QuotientGroup.ker_mk' _) ha
  let e := (cComponentTwoCoreQuotientEquiv (h.replacement_component d)).symm.trans
    (h.replacement_quotientEquiv d)
  refine ⟨e.toMonoidHom.comp r,e.surjective.comp hr,?_⟩
  have he : (e.toMonoidHom.comp r).ker = r.ker := by
    ext x
    exact e.map_eq_one_iff
  rwa [he]

omit [Finite F] [CharP F 2] in
/-- The replacement is generated by its residual and the actual edge group. -/
theorem Input.replacement_residual_edge_generation :
    pResidual 2 d.overgroup ⊔ d.radical = ⊤ := by
  rw [h.replacement_residual d]
  apply top_unique
  intro x _
  obtain ⟨k,hk,r,hr,rfl⟩ := h.replacement_product d x
  exact mul_mem (mem_sup_left hk) (mem_sup_right hr)

/-- The residual fixes every normalized radius section smaller than q⁴. -/
theorem Input.replacement_small_radius_commutator
    (geometry : Geometry d.radical) (hb : 2 < geometry.b d.radical)
    {a : Vertex d.radical} (ha : color d.radical a = false)
    (D : Subgroup (FreeAmalgam d.radical)) (hD : D ≤ V d.radical a)
    (hn : Ltilde d.radical a ≤ normalizer (D : Set (FreeAmalgam d.radical)))
    (hi : (Z d.radical a).relIndex D < Nat.card F ^ 4) :
    ⁅D,Ltilde d.radical a⁆ ≤ Z d.radical a := by
  have hDQ := hD.trans (geometry.V_le_Q hb a ha)
  have hDG := hDQ.trans (show Q d.radical a ≤ stabilizer d.radical a from fun _ hx => hx.1)
  let := finite_stabilizer d.radical a
  let : Finite D := Finite.of_injective (inclusion hDG) (inclusion_injective _)
  let : Finite (Ltilde d.radical a) := Finite.of_injective
    (inclusion (Ltilde_le_stabilizer a)) (inclusion_injective _)
  let : ((Z d.radical a).subgroupOf D).Normal :=
    normal_subgroupOf_of_le_normalizer (hDG.trans (Z_normalized d.radical a))
  let := h.quotient_simple
  let : IsSimpleGroup (Matrix.symplecticGroup (Fin 2) F) := h.quotientEquiv.symm.isSimpleGroup
  obtain ⟨q,hq,hker⟩ := h.replacement_residual_projection d ha
  exact commutator_component_le_of_symplectic_section_lt_fourth_power
    (by have := h.nonbinary; omega) h.field_card rfl
    (Ltilde d.radical a) D (Z d.radical a)
    (isPPerfect_embedded_pResidual_of_finite 2 _) q hq hker
    ((Q_isPGroup d.radical (h.replacement_two_group d) (h.replacement_core_le d) a ha).to_le hDQ)
    hi hn ((Ltilde_le_stabilizer a).trans (Z_normalized d.radical a))

/-- The literal preimage B contains that residual-invariant radius subgroup. -/
theorem Input.replacement_small_radius_le_B
    (geometry : Geometry d.radical) (hb : 2 < geometry.b d.radical)
    {a : Vertex d.radical} (ha : color d.radical a = false)
    (D : Subgroup (FreeAmalgam d.radical)) (hD : D ≤ V d.radical a)
    (hn : Ltilde d.radical a ≤ normalizer (D : Set (FreeAmalgam d.radical)))
    (hi : (Z d.radical a).relIndex D < Nat.card F ^ 4) :
    D ≤ B d.radical a (geometry.Z_normal a) :=
  ChapterC.Sp4Four.DistanceReduction.radius_le_B_of_commutator geometry hb ha D hD
    (h.replacement_small_radius_commutator d geometry hb ha D hD hn hi)

/-- MS3 forces the full radius quotient to have order at least q⁴. -/
theorem Input.replacement_radius_index_ge_fourth_power
    (geometry : Geometry d.radical) (hb : 2 < geometry.b d.radical)
    {a t : Vertex d.radical} (ha : color d.radical a = false)
    (hat : Adjacent d.radical a t) :
    Nat.card F ^ 4 ≤ (Z d.radical a).relIndex (V d.radical a) := by
  by_contra! hi
  have hne : Z d.radical a ≠ ⊥ := by
    obtain ⟨z,hz⟩ := criticalPair_exists d.radical a (geometry.exists_critical a ha)
    intro he
    exact hz.2 (he ▸ bot_le)
  exact radius_moving_not_le_Z_of_residual_edge_generation
    (h.replacement_characteristic d) (h.replacement_residual_edge_generation d)
    geometry hb ha hat hne
    (h.replacement_small_radius_commutator d geometry hb ha (V d.radical a) le_rfl
      ((Ltilde_le_stabilizer a).trans (DistanceEight.V_normalized d.radical a)) hi)

end CFSG.Quasithin.ChapterC.RankTwo.NonbinarySymplectic
