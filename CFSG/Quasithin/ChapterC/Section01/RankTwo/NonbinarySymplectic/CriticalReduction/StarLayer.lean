module
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.NonbinarySymplectic.CriticalReduction.CoreDisplacement
public import Theory.ElementaryAbelian.CommutingFamily
public import Theory.ElementaryAbelian.Join

/-!
# The full elementary source star and its exact moved layer

The star contains the entire original Z-layer, including its fixed central
attachment, since the vertex group is transitive on its incident edges.
Thus the first star bound is an equality: [Z-star-alpha,L-alpha] = U-alpha.
When the critical distance is at least four, the star is abelian; its
holomorph generators are elementary, so the entire star is elementary.
These are the actual groups needed for the dual-module argument after the
core-displacement step, without discarding any fixed layer.

Source: Meierfrankenfeld--Stellmacher (1993), (3.4), printed pp.868--869.
-/

public noncomputable section
open scoped IsMulCommutative
open Subgroup Theory.GroupTheory Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.BinaryMS.MS93
open CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality
open CFSG.Quasithin.ChapterC.RankTwo.Sp4Four
namespace CFSG.Quasithin.ChapterC.RankTwo.NonbinarySymplectic
section Star
variable {M : Type*} [Group M] [Finite M] (R : Subgroup M) (Y : Subgroup R)

omit [Finite M] in
private theorem starBeta_le_starAlpha :
    (starSpan R Y).map (embedS R) ≤ sourceStarAlpha R Y := by
  have hh := (sourceStarAlpha_le_iff R Y (sourceStarAlpha R Y)).mp le_rfl (1 : Mbar R)
  have he : (MulAut.conj (1 : FreeAmalgam R)).toMonoidHom = MonoidHom.id _ := by
    apply MonoidHom.ext
    intro x
    change 1*x*1⁻¹=x
    simp
  simpa only [OneMemClass.coe_one,he,Subgroup.map_id] using hh

private theorem starBeta_formula : (starSpan R Y).map (embedS R) =
    (⨆ g : Hbar R, (Y.map (embedS R)).map
      (MulAut.conj (g : FreeAmalgam R)).toMonoidHom) ⊔ Z R (beta R) := by
  simpa only [map_map,embedM_comp_subtype] using starSpan_map_graph R Y

/-- The original full Z-layer is contained in the source star, including
its fixed central attachment. -/
theorem Z_le_sourceStarAlpha : Z R (alpha R) ≤ sourceStarAlpha R Y := by
  have hbeta : Z R (beta R) ≤ sourceStarAlpha R Y := by
    apply (show Z R (beta R) ≤ (starSpan R Y).map (embedS R) from ?_).trans
      (starBeta_le_starAlpha R Y)
    rw [starBeta_formula]
    exact le_sup_right
  rw [Z,if_pos (show color R (alpha R)=false from rfl)]
  apply iSup_le
  intro t
  apply iSup_le
  intro hat
  have ht : color R t = true := by
    have hh := adjacent_color_ne R hat
    change false ≠ color R t at hh
    cases he : color R t <;> simp_all
  have hZt : Z R t = edgeOmega R t := by rw [Z,if_neg (by rw [ht]; decide)]
  rw [←hZt]
  obtain ⟨g,hg,hgt⟩ := stabilizer_transitive_neighbors R (alpha R) (base_adjacent R) hat
  have he := Z_act R g (beta R)
  change act R g (beta R) = t at hgt
  rw [hgt] at he
  rw [he]
  exact (map_mono hbeta).trans_eq
    (mem_normalizer_iff_map_conj_eq.mp
      (sourceStarAlpha_normalized R Y ((stabilizer R (alpha R)).inv_mem hg)))

/-- Abelian source stars generated by an elementary seed are elementary.
The holomorph omega-center is retained among the generators. -/
theorem sourceStarAlpha_elementary_of_commutative
    [IsElementaryAbelian 2 (Y.map (embedS R))]
    [IsMulCommutative (sourceStarAlpha R Y)] :
    IsElementaryAbelian 2 (sourceStarAlpha R Y) := by
  let A := sourceStarAlpha R Y
  let B := (starSpan R Y).map (embedS R)
  let E (g : Hbar R) := (Y.map (embedS R)).map
    (MulAut.conj (g : FreeAmalgam R)).toMonoidHom
  have hBA : B ≤ A := starBeta_le_starAlpha R Y
  have hEB : ∀ g, E g ≤ B := by
    intro g
    rw [show B = (⨆ g : Hbar R, E g) ⊔ Z R (beta R) from starBeta_formula R Y]
    exact (le_iSup E g).trans le_sup_left
  have hEA : ∀ g, E g ≤ A := fun g => (hEB g).trans hBA
  let : ∀ g, IsElementaryAbelian 2 (E g) := fun g => IsElementaryAbelian.map _
  let : IsElementaryAbelian 2 (⨆ g, E g : Subgroup (FreeAmalgam R)) :=
    IsElementaryAbelian.iSup_of_le_centralizer E
      (fun g k => (hEA g).trans (A.le_centralizer.trans (centralizer_le (hEA k))))
  have hZA : Z R (beta R) ≤ A := by
    apply (show Z R (beta R) ≤ B from ?_).trans hBA
    rw [show B = (⨆ g : Hbar R, E g) ⊔ Z R (beta R) from starBeta_formula R Y]
    exact le_sup_right
  let : IsElementaryAbelian 2 (Z R (beta R)) := by
    rw [Z,if_neg (by change ¬ true=false; decide)]
    exact omegaCenter_elementary _
  let : IsElementaryAbelian 2 B := by
    rw [show B = (⨆ g : Hbar R, E g) ⊔ Z R (beta R) from starBeta_formula R Y]
    exact IsElementaryAbelian.sup_of_le_centralizer
      (hZA.trans (A.le_centralizer.trans (centralizer_le (iSup_le hEA))))
  let D (g : Mbar R) := B.map (MulAut.conj (g : FreeAmalgam R)).toMonoidHom
  have hDA : ∀ g, D g ≤ A := (sourceStarAlpha_le_iff R Y A).mp le_rfl
  have hA : A = ⨆ g, D g := le_antisymm
    ((sourceStarAlpha_le_iff R Y _).mpr (fun g => le_iSup D g)) (iSup_le hDA)
  let : ∀ g, IsElementaryAbelian 2 (D g) := fun g => IsElementaryAbelian.map _
  change IsElementaryAbelian 2 A
  rw [hA]
  exact IsElementaryAbelian.iSup_of_le_centralizer D
    (fun g k => (hDA g).trans (A.le_centralizer.trans (centralizer_le (hDA k))))
end Star

variable {H F : Type*} [Group H] [Finite H] [Field F] [Finite F] [CharP F 2]
variable {K R : Subgroup H} {n : ℕ} (h : Input K R n F)
variable (d : CharacteristicReduction K R)
include h

/-- The source star's moved subgroup is exactly the original natural cover. -/
theorem Input.replacement_sourceStarAlpha_commutator_eq_U
    (geometry : Geometry d.radical) (hb : 0 < geometry.b d.radical)
    (Y : Subgroup d.radical) (P : Sylow 2 (Ltilde d.radical (alpha d.radical)))
    (hY : Y.map (embedS d.radical) = componentSylowSeed d.radical (alpha d.radical) P)
    (hn : Q d.radical (beta d.radical) ≤
      normalizer (Y.map (embedS d.radical) : Set (FreeAmalgam d.radical))) :
    ⁅sourceStarAlpha d.radical Y,Ltilde d.radical (alpha d.radical)⁆ =
      U d.radical (alpha d.radical) :=
  le_antisymm (h.replacement_sourceStarAlpha_commutator_le_U d geometry hb Y P hY hn)
    (commutator_mono (Z_le_sourceStarAlpha d.radical Y) le_rfl)

/-- In the only branch requiring exclusion, the entire source star is a
binary module. Its central attachments have not been factored away. -/
theorem Input.replacement_sourceStarAlpha_elementary
    (geometry : Geometry d.radical) (hb : 4 ≤ geometry.b d.radical)
    (Y : Subgroup d.radical) (P : Sylow 2 (Ltilde d.radical (alpha d.radical)))
    (hY : Y.map (embedS d.radical) = componentSylowSeed d.radical (alpha d.radical) P)
    (hn : Q d.radical (beta d.radical) ≤
      normalizer (Y.map (embedS d.radical) : Set (FreeAmalgam d.radical))) :
    IsElementaryAbelian 2 (sourceStarAlpha d.radical Y) := by
  let := h.replacement_sourceStarAlpha_commutative_of_four_le d geometry hb Y P hY hn
  let := h.replacement_vertex_moving_elementary d (a := alpha d.radical) rfl
  let : IsElementaryAbelian 2 (Y.map (embedS d.radical)) := by
    rw [hY]
    exact IsElementaryAbelian.of_le (show componentSylowSeed d.radical (alpha d.radical) P ≤
      U d.radical (alpha d.radical) from inf_le_left)
  exact sourceStarAlpha_elementary_of_commutative d.radical Y

end CFSG.Quasithin.ChapterC.RankTwo.NonbinarySymplectic
