module
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.NonbinarySymplectic.CriticalReduction.RadiusImages
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.NonbinarySymplectic.CriticalReduction.RootImage
public import Theory.SpecificGroups.SymplecticFour.NormalQuadratic

/-!
# Radius images at distance four and beyond

The full radius is generated by its seeds, each normalized by that radius.
Their images in a sufficiently close vertex quotient act quadratically on
the literal natural cover quotient. A seed in the kernel has trivial image;
every other seed forms a critical pair. The normal-quadratic Sylow theorem
therefore bounds the full radius image by q³, even at distance four.
Combining this with the q⁴ radius quotient bound gives kernel index at
least q over the full starting seed. No central attachment is removed.

Source: Meierfrankenfeld--Stellmacher (1993), (5.2), printed p.914.
The next consumer is `RadiusChiefInput`, on the actual critical path.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open Theory.SpecificGroups.SymplecticFour
open Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.BinaryMS.MS93
open CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality
open CFSG.Quasithin.ChapterC.RankTwo.Sp4Four
namespace CFSG.Quasithin.ChapterC.RankTwo.NonbinarySymplectic
variable {H F : Type*} [Group H] [Finite H] [Field F] [Finite F] [CharP F 2]
variable {K R : Subgroup H} {n : ℕ} (h : Input K R n F)
variable (d : CharacteristicReduction K R)
include h

/-- The full radius image has order at most q³, including critical distance four. -/
theorem Input.replacement_radius_image_le_cube
    (geometry : Geometry d.radical) (hb : 4 ≤ geometry.b d.radical)
    {a z : Vertex d.radical} (ha : color d.radical a = false)
    (hz : color d.radical z = false)
    (hd : (cosetGraph d.radical).dist a z + 2 ≤ geometry.b d.radical) :
    (Q d.radical z).relIndex (V d.radical a) ≤ Nat.card F ^ 3 := by
  obtain ⟨E,hE,f,_,hfQ,π,hπ,_,hact⟩ := h.replacement_inner_natural_action d geometry hb hz
  have hEF : Nat.card E.Carrier = Nat.card F := by rw [E.card_eq,hE,h.field_card]
  let S := stabilizer d.radical z
  let V₀ := (V d.radical a).subgroupOf S
  let P := V₀.map f
  have hV := radius_le_stabilizer_of_distance d.radical geometry ha hd
  have hVQ : V d.radical a ≤ Q d.radical a := geometry.V_le_Q (by omega) a ha
  have hcard : Nat.card P = (Q d.radical z).relIndex (V d.radical a) := by
    have hh := SourceComparison.quotient_image_card _ _ _ hV f hfQ
    have he : (f.comp (inclusion hV)).range = P := by
      rw [MonoidHom.range_comp,inclusion_range]
    rwa [he] at hh
  let I := {c : Vertex d.radical // color d.radical c = false ∧
    (cosetGraph d.radical).dist c a ≤ 2}
  have hgenV : V d.radical a = ⨆ c : I, Z d.radical c.val := by
    apply le_antisymm
    · apply (V_le_iff d.radical ha _).mpr
      intro c hc hca
      exact le_iSup_of_le (⟨c,hc,hca⟩ : I) le_rfl
    · exact iSup_le fun c => le_iSup_of_le c.val (le_iSup_of_le c.property.2 le_rfl)
  have hseed (c : I) : Z d.radical c.val ≤ V d.radical a := hgenV ▸ le_iSup (fun c : I => Z d.radical c.val) c
  let C (c : I) := (Z d.radical c.val).subgroupOf S
  let A (c : I) := (C c).map f
  have hCm (c : I) : (C c).map S.subtype = Z d.radical c.val :=
    map_subgroupOf_eq_of_le ((hseed c).trans hV)
  have hgen₀ : V₀ = ⨆ c : I, C c := by
    apply Subgroup.map_injective S.subtype_injective
    rw [map_subgroupOf_eq_of_le hV,Subgroup.map_iSup]
    simpa only [hCm] using hgenV
  have hgenP : P = ⨆ c : I, A c := by
    dsimp only [P]
    rw [hgen₀,Subgroup.map_iSup]
  have hP : IsPGroup 2 P :=
    (((Q_isPGroup d.radical (h.replacement_two_group d)
      (h.replacement_core_le d) a ha).to_le hVQ).comap_subtype).map f
  have helem (c : I) : IsElementaryAbelian 2 (A c) := by
    let := geometry.Z_elementary (by omega) c.val c.property.1
    let := IsElementaryAbelian.subgroupOf (p := 2) ((hseed c).trans hV)
    exact IsElementaryAbelian.map f
  have hn (c : I) : P ≤ normalizer (A c : Set (Sp E.Carrier)) := by
    have hn : V d.radical a ≤ normalizer (Z d.radical c.val : Set (FreeAmalgam d.radical)) :=
      hVQ.trans ((Q_le_stabilizer_of_dist_le_two a c.val ha c.property.1
        (by rw [SimpleGraph.dist_comm]; exact c.property.2)).trans (Z_normalized d.radical c.val))
    exact (map_mono ((comap_mono hn).trans (le_normalizer_comap S.subtype))).trans
      (le_normalizer_map f)
  have hq (c : I) : ∀ x ∈ A c, ∀ y ∈ A c, ∀ v : Vector E.Carrier,
      x • (y • v-v)=y • v-v := by
    have hAS : Z d.radical c.val ≤ S := (hseed c).trans hV
    let δ := f.comp (inclusion hAS)
    have he : δ.range = A c := by
      rw [MonoidHom.range_comp,inclusion_range]
    rw [←he]
    by_cases hCQ : Z d.radical c.val ≤ Q d.radical z
    · have hker : f.ker = (Q d.radical z).subgroupOf S := by
        rw [←hfQ,subgroupOf_map_subtype_eq]
      have hδ (x : Z d.radical c.val) : δ x = 1 := by
        change inclusion hAS x ∈ f.ker
        rw [hker]
        exact hCQ x.property
      rintro x ⟨x,rfl⟩ y ⟨y,rfl⟩ v
      simp only [hδ,one_smul]
    · have hdist : (cosetGraph d.radical).dist c.val z ≤ geometry.b d.radical := by
        have ht := (cosetGraph_connected d.radical).dist_triangle (u := c.val) (v := a) (w := z)
        have hc := c.property.2
        omega
      have hcrit : CriticalPair d.radical c.val z (geometry.exists_critical c.val c.property.1) := by
        refine ⟨le_antisymm ?_ (criticalDistance_le d.radical c.val _ hCQ),hCQ⟩
        rwa [geometry.distance_constant c.val c.property.1]
      let path : CriticalPath d.radical geometry c.val z := CriticalPath.ofPair c.property.1 hcrit
      apply critical_quotient_actor_quadratic path (by omega) π hπ δ
      intro x u
      exact hact (inclusion hAS x) u
  rw [←hcard,←hEF]
  exact NormalQuadratic.generated_card_le_cube (by rw [E.card_eq,hE])
    (by have := h.nonbinary; omega) P hP A hgenP helem hn hq

/-- The full kernel of a radius image has index at least q over the original
central seed, also at distance four. -/
theorem Input.replacement_radius_kernel_index_ge_field
    (geometry : Geometry d.radical) (hb : 4 ≤ geometry.b d.radical)
    {a t z : Vertex d.radical} (ha : color d.radical a = false)
    (hz : color d.radical z = false) (hat : Adjacent d.radical a t)
    (hd : (cosetGraph d.radical).dist a z + 2 ≤ geometry.b d.radical) :
    Nat.card F ≤ (Z d.radical a).relIndex (V d.radical a ⊓ Q d.radical z) := by
  have hlo := h.replacement_radius_index_ge_fourth_power d geometry (by omega) ha hat
  have hup := h.replacement_radius_image_le_cube d geometry hb ha hz hd
  have hZQ : Z d.radical a ≤ Q d.radical z :=
    Z_le_Q_of_dist_lt d.radical a (geometry.exists_critical a ha)
      (by rw [geometry.distance_constant a ha]; change (cosetGraph d.radical).dist a z < geometry.b d.radical; omega)
  have hprod := relIndex_inf_mul_relIndex (Z d.radical a) (Q d.radical z) (V d.radical a)
  rw [inf_eq_left.mpr hZQ,inf_comm (Q d.radical z) (V d.radical a)] at hprod
  have hm := Nat.mul_le_mul_left ((Z d.radical a).relIndex (V d.radical a ⊓ Q d.radical z)) hup
  rw [hprod] at hm
  have hpos : 0 < Nat.card F ^ 3 := pow_pos (Nat.card_pos (α := F)) _
  have he : Nat.card F ^ 4 = Nat.card F * Nat.card F ^ 3 := by ring
  rw [he] at hlo
  nlinarith

end CFSG.Quasithin.ChapterC.RankTwo.NonbinarySymplectic
