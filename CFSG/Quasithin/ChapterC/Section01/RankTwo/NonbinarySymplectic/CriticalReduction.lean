public section
open Subgroup Theory.GroupTheory
open Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.BinaryMS.MS93
namespace CFSG.Quasithin.ChapterC.RankTwo.NonbinarySymplectic
open MSCentralOrbit
variable {H F : Type*} [Group H] [Finite H] [Field F] [Finite F] [CharP F 2]
variable {K R : Subgroup H} {n : ℕ} (h : Input K R n F)
variable (d : CharacteristicReduction K R)

include h

/-- Positivity holds for every geometry witness on the actual replacement. -/
theorem Input.replacement_distance_pos (g : Geometry d.radical) : 0 < g.b d.radical := by
  obtain ⟨g',hpos,_⟩ := h.replacement_positive_even_geometry d
  exact hpos

/-- The replacement critical distance is at least two before any exclusion. -/
theorem Input.replacement_two_le_distance (g : Geometry d.radical) : 2 ≤ g.b d.radical := by
  have hpos := h.replacement_distance_pos d g
  have heven : Even (g.b d.radical) := g.even (alpha d.radical) rfl
  obtain ⟨k,hk⟩ := heven
  omega

/-- The full graph-layer kernel agrees with Q at every original-group vertex. -/
theorem Input.replacement_C_eq_Q {a : Vertex d.radical}
    (ha : color d.radical a = false) : C d.radical a = Q d.radical a :=
  MSCentralOrbit.C_eq_Q d.radical (h.replacement_two_group d)
    (h.replacement_core_le d) (h.replacement_omegaOrbit_centralizer d) a ha

/-- The source edge centralizer condition holds on the replacement graph,
so the critical reversal and offender lemmas apply to this literal pair. -/
theorem Input.replacement_edgeCentralizerCondition : EdgeCentralizerCondition d.radical :=
  MSCentralOrbit.edgeCentralizerCondition d.radical (h.replacement_two_group d)
    (h.replacement_core_le d) (h.replacement_omegaOrbit_centralizer d)

omit [Finite F] [CharP F 2] in
/-- The graph core at its base vertex is the embedded intrinsic component core. -/
theorem Input.replacement_graphCore_eq_intrinsic :
    core d.radical (alpha d.radical) =
      ((blockU (K.subgroupOf d.overgroup)).map (K.subgroupOf d.overgroup).subtype).map
        (embedM d.radical) := by
  let : (K.subgroupOf d.overgroup).Normal := by
    rw [← h.replacement_residual d]
    infer_instance
  exact MSCentralOrbit.graphCore_eq_intrinsic _ _ (h.replacement_two_group d)
    (h.replacement_core_le d) (h.replacement_residual d)

end CFSG.Quasithin.ChapterC.RankTwo.NonbinarySymplectic
