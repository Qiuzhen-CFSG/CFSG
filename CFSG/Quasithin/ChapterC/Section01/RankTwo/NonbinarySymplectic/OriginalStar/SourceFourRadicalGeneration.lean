module
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.NonbinarySymplectic.OriginalStar.SourceFourSectionCentralizer
import all CFSG.Quasithin.ChapterC.Section01.RankTwo.NonbinarySymplectic.OriginalStar.SourceFourEscape
import all CFSG.Quasithin.ChapterC.Section01.RankTwo.NonbinarySymplectic.SaturatedDistanceTwo.SourceFourRadicalGeneration

/-!
# The original radical displacement generated by a hyperplane

A full fixed hyperplane of field index q generates the whole common
displacement under the original midpoint radical. This displacement has
index q squared over the full fixed attachment. These exact identities
supply the factorization and order comparison used in root selection.

Source: Meierfrankenfeld--Stellmacher (1993), (3.7)(4), printed p.875.
The original radical, quotient marking and complete fixed attachments are
retained. Internal imports reuse generic cover and subgroup calculations;
no saturation premise for a characteristic replacement is used.
-/

public noncomputable section
open scoped IsMulCommutative commutatorElement
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open Representation.OneCohomology Representation.SymplecticFourOrthogonalCover
open Theory.SpecificGroups.SymplecticFour
open Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.BinaryMS.MS93
open CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality
namespace CFSG.Quasithin.ChapterC.RankTwo.NonbinarySymplectic.OriginalStar
open DistanceTwoRecognition ChapterB.QuasisimpleSource
variable {H F : Type*} [Group H] [Finite H] [Field F] [Finite F] [CharP F 2]
variable {K R : Subgroup H} {n : ℕ} (h : Input K R n F)
variable (hshort : IsShort K) (hinner : K ⊔ pCore 2 H = ⊤)
variable (hnsyl : ¬ ∃ S : Sylow 2 (Sp F), (S : Subgroup (Sp F)) =
  (R.subgroupOf K).map (componentProjection h))
include h hshort hinner hnsyl

/-- A full hyperplane fixed by a subgroup of the common radical generates
its entire displacement. The original cover and arbitrary plane marking
are retained. -/
theorem original_source_four_large_hyperplane_full_movement
    (g : Geometry R) (hb : g.b R=2)
    {a z t : Vertex R} (path : CriticalPath R g a z)
    (hat : Adjacent R a t) (hzt : Adjacent R z t)
    (hcritical : (2^n)^2 ≤ (Q R z).relIndex (Z R a))
    (P : Subgroup (FreeAmalgam R)) (hP : P ≤ Q R t)
    (hi : (Z R z ⊓ centralizer (P : Set (FreeAmalgam R))).relIndex
      (Z R z)=2^n) :
    ⁅Z R z ⊓ centralizer (P : Set (FreeAmalgam R)),Q R t⁆=
      ⁅Z R a,Z R z⁆ := by
  have ht : color R t=true := by
    apply Bool.eq_true_of_not_eq_false
    intro he
    exact adjacent_color_ne R hat (path.start_color.trans he.symm)
  obtain ⟨⟨cv⟩,_,_,_⟩ := original_source_four_large_plane_cover h hshort hinner hnsyl g hb path hat hzt hcritical
  let C := Z R t
  let V := U R z
  let X₀ := V ⊓ centralizer (P : Set (FreeAmalgam R))
  let X := Z R z ⊓ centralizer (P : Set (FreeAmalgam R))
  have hCT : C ≤ centralizer (Q R t : Set (FreeAmalgam R)) := by
    rw [show C=omegaCenter (Q R t) by simp [C,Z,ht,edgeOmega]]
    exact fun x hx => (mem_omegaCenter_iff.mp hx).2.2
  have hCZ : C ≤ Z R z := Sp4Four.edge_Z_le_endpoint R path.end_color hzt
  let := g.Z_elementary (by omega : 0 < g.b R) z path.end_color
  let := finite_Z R z
  have hgen : Z R z=V ⊔ C :=
    original_Z_eq_moving_sup_edge h hshort hinner g hb path.end_color hzt
  have hiV : (centralizer (P : Set (FreeAmalgam R))).relIndex V=2^n := by
    rw [←central_supplement_fixed_index V C (Z R z) P (U_le_Z z) hCZ hgen
      (hCT.trans (centralizer_le hP)),←inf_relIndex_left]
    exact hi
  have hfull : ⁅V,Q R t⁆ ≤ ⁅X₀,Q R t⁆ :=
    SaturatedDistanceTwo.plane_cover_hyperplane_generation cv
      (Nat.pow_lt_pow_right (by decide : 1 < (2:ℕ)) h.nonbinary) P hP hiV
  have hTZV : V ≤ normalizer (Q R t : Set (FreeAmalgam R)) :=
    (U_le_Z z).trans ((g.omega_bound z path.end_color (by
      rw [g.distance_constant z path.end_color]; change 0 < g.b R; omega)).trans
        ((omegaCenter_le _).trans ((Q_le_adjacent_h R ht hzt).trans (Q R t).le_normalizer)))
  have hZVC : Z R z ≤ V ⊔ centralizer (Q R t : Set (FreeAmalgam R)) :=
    hgen.le.trans (sup_le_sup_left hCT V)
  have hmove : ⁅Q R t,Z R z⁆ ≤ ⁅Q R t,V⁆ :=
    commutator_le_moving_of_inner_mod_centralizer (Q R t) V
      (Z R z) hTZV hZVC
  have hfullZ : ⁅Z R z,Q R t⁆ ≤ ⁅X,Q R t⁆ := by
    calc
      _ = ⁅Q R t,Z R z⁆ := commutator_comm _ _
      _ ≤ ⁅Q R t,V⁆ := hmove
      _ = ⁅V,Q R t⁆ := commutator_comm _ _
      _ ≤ ⁅X₀,Q R t⁆ := hfull
      _ ≤ ⁅X,Q R t⁆ := commutator_mono
        (inf_le_inf_right _ (U_le_Z z)) le_rfl
  apply le_antisymm
  · exact (commutator_mono (show X ≤ Z R z from inf_le_left) le_rfl).trans_eq
      ((commutator_comm _ _).trans (original_source_four_large_full_movement h hshort hinner hnsyl g hb path hat hzt hcritical))
  · rw [←original_source_four_large_full_movement h hshort hinner hnsyl g hb path hat hzt hcritical,
      commutator_comm]
    exact hfullZ

/-- In the large critical-image branch, the full common displacement has
index q squared over the complete attachment, and the corresponding exact
order. No maximal-kernel assumption is needed. -/
theorem original_source_four_large_displacement_order
    (g : Geometry R) (hb : g.b R=2)
    {a z t : Vertex R} (path : CriticalPath R g a z)
    (hat : Adjacent R a t) (hzt : Adjacent R z t)
    (hcritical : (2^n)^2 ≤ (Q R z).relIndex (Z R a)) :
    let A := U R z ⊓ centralizer (Ltilde R z : Set (FreeAmalgam R))
    let D := ⁅Z R a,Z R z⁆
    A ≤ D ∧ A.relIndex D=(2^n)^2 ∧ Nat.card D=(2^n)^2 * Nat.card A := by
  have ht : color R t=true := by
    apply Bool.eq_true_of_not_eq_false
    intro he
    exact adjacent_color_ne R hat (path.start_color.trans he.symm)
  obtain ⟨⟨cv⟩,hi,_,hA⟩ := original_source_four_large_plane_cover h hshort hinner hnsyl g hb path hat hzt hcritical
  let A := U R z ⊓ centralizer (Ltilde R z : Set (FreeAmalgam R))
  let D := ⁅Z R a,Z R z⁆
  have he : D=⁅Z R a,U R z⁆ := by
    apply le_antisymm ?_ (commutator_mono le_rfl (U_le_Z z))
    rw [original_critical_displacement_eq_paired_moving h hshort hinner path hb hat hzt]
    exact commutator_mono (U_le_Z a) le_rfl
  have hAT : Z R a ≤ Q R t :=
    (g.omega_bound a path.start_color (by
      rw [g.distance_constant a path.start_color]; change 0 < g.b R; omega)).trans
      ((omegaCenter_le _).trans (Q_le_adjacent_h R ht hat))
  have hAD : A ≤ D := hA.trans_eq he.symm
  have hiD : A.relIndex D=(2^n)^2 := by
    rw [he]
    exact (SaturatedDistanceTwo.plane_cover_displacement_index cv (Z R a) hAT).trans hi
  refine ⟨hAD,hiD,?_⟩
  have hh := relIndex_mul_relIndex (⊥ : Subgroup (FreeAmalgam R)) A D bot_le hAD
  simpa only [relIndex_bot_left,hiD,mul_comm] using hh.symm


end CFSG.Quasithin.ChapterC.RankTwo.NonbinarySymplectic.OriginalStar
