module
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.NonbinarySymplectic.DistanceTwoRecognition.OriginalLayers

/-!
# An original automorphism supplying the paired minimum kernels

Let U be the full intrinsic core of the original component. Some automorphism
of the ORIGINAL radical R sends U outside the original O₂(H). Otherwise the
subgroup generated by all its automorphic images lies in O₂(H), contains U,
and is normalized by K because [O₂(H),K] = U. It is also characteristic in R,
contradicting original MS3 and the nontriviality of U.

Restrict this actual automorphism to the characteristic minimum subgroup and
transport it through the canonical radical equivalence. Its literal holomorph
element supplies a neighbor of the minimum graph's base edge whose whole
moving group escapes the original vertex core. Distance two and critical
reversal give a critical path with precisely that endpoint. No automorphism
of the minimum radical is extended to R.

For this original automorphism the paired-kernel calculation now has a common
actor: it either preserves the full fixed kernel A or exchanges A with the
normalizer displacement D. In the exchange case the two full subgroups are
disjoint and both have order q. Covariance uses the actual relative normalizers,
their two-cores and the original conjugation maps. The consumer constructs the
critical automorphism from Input; it assumes neither a selected critical actor
nor equality or vanishing of fixed kernels.

This does not exclude the exchange alternative or prove minimum marked
preservation, minimum saturation, the Sylow branch, n = 2 or the final block.
All full fixed attachments and the original field degree remain intact.

Source: Meierfrankenfeld--Stellmacher, Pushing up weak BN-pairs of rank two
(1993), (2.1)(iii), printed p.855, and the paired fixed-kernel comparison in
(3.7)(4), printed p.875. The minimum cut is the separate Section 7 construction,
pp.932--933. This is a comparison for that cut, not the full source (3.7).
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped commutatorElement
open Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.BinaryMS.MS93
open CFSG.Quasithin.ChapterC.BinaryMS.MS93.DistanceEight.PathCentrality
open CFSG.Quasithin.ChapterC.RankTwo.Sp4Four
open CFSG.Quasithin.ChapterC.RankTwo.NonbinarySymplectic.DistanceTwoRecognition
namespace CFSG.Quasithin.ChapterC.RankTwo.NonbinarySymplectic.OriginalStar
variable {H F : Type*} [Group H] [Finite H] [Field F] [Finite F] [CharP F 2]
variable {K R : Subgroup H} {n : ℕ} (h : Input K R n F)
variable (d : CharacteristicReduction K R)
include h

omit [Finite F] [CharP F 2] in
private theorem core_le_minimum : (blockU K).map K.subtype ≤ d.ambient := by
  let := h.component_normal
  have hp : IsPPerfect 2 K := by
    rw [←h.residual_eq]
    exact isPPerfect_pResidual 2
  rw [←d.commutatorCore_eq_intrinsic_of_sup (original_sup h) hp,
    ←map_subgroupOf_eq_of_le (show d.ambient ≤ d.overgroup from le_sup_right)]
  exact map_mono ((commutator_le_left _ _).trans (replacement_core_le h d))

/-- Original MS3 prevents every automorphic image of the full intrinsic core
from remaining inside the original ambient two-core. -/
theorem exists_original_automorphism_moving_core
    (g : Geometry d.radical) (hb : g.b d.radical = 2) :
    ∃ a : MulAut R, ¬ ((((blockU K).map K.subtype).subgroupOf R).map
      a.toMonoidHom).map R.subtype ≤ pCore 2 H := by
  classical
  let U := ((blockU K).map K.subtype).subgroupOf R
  let W : Subgroup R := ⨆ a : MulAut R, U.map a.toMonoidHom
  have hUR : (blockU K).map K.subtype ≤ R :=
    (core_le_minimum h d).trans (map_subtype_le _)
  have hmU : U.map R.subtype = (blockU K).map K.subtype := map_subgroupOf_eq_of_le hUR
  have hUW : U ≤ W := by
    have hh := le_iSup (fun a : MulAut R => U.map a.toMonoidHom) (MulEquiv.refl R)
    change U.map (MonoidHom.id R) ≤ W at hh
    simpa only [Subgroup.map_id] using hh
  have hW : W.Characteristic := by
    apply characteristic_iff_map_le.mpr
    intro a
    rw [show W = ⨆ b : MulAut R, U.map b.toMonoidHom from rfl,Subgroup.map_iSup]
    apply iSup_le
    intro b
    rw [map_map]
    exact le_iSup_of_le (b.trans a) le_rfl
  let := hW
  by_contra hno
  push Not at hno
  have hWQ : W.map R.subtype ≤ pCore 2 H := by
    rw [show W = ⨆ b : MulAut R, U.map b.toMonoidHom from rfl,Subgroup.map_iSup]
    exact iSup_le hno
  have hp : IsPPerfect 2 K := by
    rw [←h.residual_eq]
    exact isPPerfect_pResidual 2
  let := h.component_normal
  have hK : K ≤ normalizer (W.map R.subtype : Set H) := by
    apply le_normalizer_iff_commutator_le_left.mpr
    exact ((commutator_mono hWQ le_rfl).trans_eq
      (MSCentralOrbit.commutatorCore_eq_intrinsic K hp)).trans
      (hmU.symm.trans_le (map_mono hUW))
  have hn : (W.map R.subtype).Normal := by
    apply normalizer_eq_top_iff.mp
    apply top_le_iff.mp
    rw [←original_sup h]
    exact sup_le hK (R.le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image R W))
  have hz := h.characteristic.eq_bot_of_normal W hn
  have hU0 : U = ⊥ := bot_unique (hUW.trans_eq hz)
  have hm0 := congrArg (fun A : Subgroup R => A.map R.subtype) hU0
  rw [hmU,Subgroup.map_bot] at hm0
  exact (short_and_natural_of_distance_two h d g hb).1.blockU_ne_bot
    ((map_eq_bot_iff_of_injective _ K.subtype_injective).mp hm0)

omit h [Finite H] [Field F] [Finite F] [CharP F 2] in
/-- Restriction of an ORIGINAL radical automorphism to the literal minimum radical. -/
@[expose] def minimumAutomorphism (a : MulAut R) : MulAut d.radical := by
  let := d.characteristic
  exact MulAut.congr d.radicalEquiv ((MulAut.characteristic d.subgroup) a)

omit h [Finite H] [Field F] [Finite F] [CharP F 2] in
/-- The same restricted automorphism in the minimum radical's holomorph amalgam. -/
@[expose] def minimumAutomorphismElement (a : MulAut R) : FreeAmalgam d.radical :=
  embedH d.radical (SemidirectProduct.inr (minimumAutomorphism d a))

omit h [Finite H] [Field F] [Finite F] [CharP F 2] in
/-- Restriction preserves the original ambient element and its original automorphic image. -/
theorem minimumAutomorphism_apply (a : MulAut R) (x : d.radical) :
    (((minimumAutomorphism d a) x : d.overgroup) : H) =
      (a ⟨x,(map_subtype_le d.subgroup) x.property⟩ : H) := by
  let := d.characteristic
  obtain ⟨t,rfl⟩ := d.radicalEquiv.surjective x
  change (((d.radicalEquiv (((MulAut.characteristic d.subgroup) a)
    (d.radicalEquiv.symm (d.radicalEquiv t))) : d.radical) : d.overgroup) : H) = _
  rw [d.radicalEquiv.symm_apply_apply,d.radicalEquiv_apply]
  change (a (t:R) : H) = _
  congr 1

omit h [Finite H] [Field F] [Finite F] [CharP F 2] in
/-- Conjugation in the amalgam realizes the actual restriction of the original automorphism. -/
theorem minimumAutomorphismElement_conjugate (a : MulAut R) (x : d.radical) :
    (MulAut.conj (minimumAutomorphismElement d a)) (embedS d.radical x) =
      embedS d.radical (minimumAutomorphism d a x) := by
  have he := congrArg (embedH d.radical)
    (SemidirectProduct.inl_aut (minimumAutomorphism d a) x)
  have hc (y : d.radical) : embedH d.radical (SemidirectProduct.inl y) =
      embedS d.radical y := DFunLike.congr_fun (embedH_comp_inl d.radical) y
  change minimumAutomorphismElement d a * embedS d.radical x *
    (minimumAutomorphismElement d a)⁻¹ = _
  simpa only [MonoidHom.id_apply,map_mul,map_inv,hc,minimumAutomorphismElement] using he.symm


omit [Finite F] [CharP F 2] in
private theorem graph_core_map :
    (((blockU K).map K.subtype).subgroupOf d.overgroup).map (embedM d.radical) =
      core d.radical (alpha d.radical) := by
  let := h.component_normal
  have hp : IsPPerfect 2 K := by
    rw [←h.residual_eq]
    exact isPPerfect_pResidual 2
  have hmU := d.commutatorCore_eq_intrinsic_of_sup (original_sup h) hp
  rw [←hmU,subgroupOf_map_subtype_eq]
  exact (core_alpha d.radical (replacement_isPGroup h d)
    (replacement_core_le h d) (replacement_residual h d)).symm

/-- An ORIGINAL automorphism supplies a critical neighbor of the minimum
replacement, with the literal holomorph element and the full moving core. -/
theorem exists_original_critical_neighbor
    (g : Geometry d.radical) (hb : g.b d.radical = 2) :
    ∃ a : MulAut R,
      let z := act d.radical (minimumAutomorphismElement d a)⁻¹ (alpha d.radical)
      Adjacent d.radical z (beta d.radical) ∧
      ¬ U d.radical z ≤ Q d.radical (alpha d.radical) ∧
      Nonempty (CriticalPath d.radical g (alpha d.radical) z) := by
  classical
  obtain ⟨a,ha⟩ := exists_original_automorphism_moving_core h d g hb
  let w := minimumAutomorphismElement d a
  let z := act d.radical w⁻¹ (alpha d.radical)
  have hw : w ∈ Hbar d.radical := ⟨SemidirectProduct.inr (minimumAutomorphism d a),rfl⟩
  have hwb : act d.radical w⁻¹ (beta d.radical) = beta d.radical := by
    change w⁻¹ ∈ stabilizer d.radical (beta d.radical)
    rw [show stabilizer d.radical (beta d.radical) = Hbar d.radical from stabilizer_h_base _]
    exact inv_mem hw
  have hzb : Adjacent d.radical z (beta d.radical) := by
    rw [←hwb]
    exact (adjacent_act_iff _ _ _ _).mpr (base_adjacent d.radical)
  have hnot : ¬ U d.radical z ≤ Q d.radical (alpha d.radical) := by
    intro hle
    apply ha
    rintro _ ⟨_,⟨r,hr,rfl⟩,rfl⟩
    have hrmin := core_le_minimum h d hr
    let x : d.radical := ⟨⟨r,mem_sup_right hrmin⟩,hrmin⟩
    have hxU : embedS d.radical x ∈ U d.radical (alpha d.radical) := by
      rw [←replacement_core_eq_U_of_distance_two h d g hb rfl,←graph_core_map h d]
      exact ⟨x,hr,DFunLike.congr_fun (embedM_comp_subtype d.radical) x⟩
    have hxz : embedS d.radical (minimumAutomorphism d a x) ∈ U d.radical z := by
      dsimp only [z]
      rw [U_act,inv_inv]
      exact ⟨embedS d.radical x,hxU,minimumAutomorphismElement_conjugate d a x⟩
    have hxq := hle hxz
    have hxq' : (minimumAutomorphism d a x : d.overgroup) ∈ pCore 2 d.overgroup := by
      rw [←Q_alpha_comap d.radical (replacement_isPGroup h d) (replacement_core_le h d)]
      change embedM d.radical (minimumAutomorphism d a x : d.overgroup) ∈ Q d.radical (alpha d.radical)
      rwa [←DFunLike.congr_fun (embedM_comp_subtype d.radical) (minimumAutomorphism d a x)] at hxq
    let := h.component_normal
    rw [d.core_eq_of_sup (original_sup h)] at hxq'
    change (((minimumAutomorphism d a x : d.radical) : d.overgroup) : H) ∈ pCore 2 H at hxq'
    rw [minimumAutomorphism_apply] at hxq'
    exact hxq'
  have hzcolor : color d.radical z = false := by
    dsimp only [z]
    rw [action_preserves_color]
    rfl
  have hZnot : ¬ Z d.radical z ≤ Q d.radical (alpha d.radical) :=
    fun he => hnot ((U_le_Z z).trans he)
  have hdistle : (cosetGraph d.radical).dist z (alpha d.radical) ≤ 2 := by
    have ht := (cosetGraph_connected d.radical).dist_triangle
      (u := z) (v := beta d.radical) (w := alpha d.radical)
    have hab : Adjacent d.radical (alpha d.radical) (beta d.radical) := base_adjacent _
    rw [SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj _ _ _).mpr hzb),
      SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj _ _ _).mpr
        (adjacent_symm _ hab))] at ht
    exact ht
  have hzcrit : CriticalPair d.radical z (alpha d.radical)
      (g.exists_critical z hzcolor) := by
    refine ⟨le_antisymm ?_ (criticalDistance_le _ _ _ hZnot),hZnot⟩
    rw [g.distance_constant z hzcolor]
    exact hdistle.trans_eq hb.symm
  have hacrit := critical_reverse d.radical g
    (MSCentralOrbit.edgeCentralizerCondition d.radical (replacement_isPGroup h d)
      (replacement_core_le h d) (replacement_omegaOrbit_centralizer h d))
    z hzcolor (by rw [g.distance_constant z hzcolor]; change 0 < g.b d.radical; omega)
    (alpha d.radical) rfl hzcrit
  obtain ⟨walk,hwalk⟩ := (cosetGraph_connected d.radical).exists_walk_length_eq_dist
    (alpha d.radical) z
  exact ⟨a,hzb,hnot,⟨⟨rfl,walk,hwalk,hacrit⟩⟩⟩


omit h [Finite H] [Field F] [Finite F] [CharP F 2] in
private theorem minimumAutomorphismElement_fixes_beta (a : MulAut R) :
    act d.radical (minimumAutomorphismElement d a)⁻¹ (beta d.radical) = beta d.radical := by
  change (minimumAutomorphismElement d a)⁻¹ ∈ stabilizer d.radical (beta d.radical)
  rw [show stabilizer d.radical (beta d.radical) = Hbar d.radical from stabilizer_h_base _]
  exact inv_mem (show minimumAutomorphismElement d a ∈ Hbar d.radical from
    ⟨SemidirectProduct.inr (minimumAutomorphism d a),rfl⟩)

omit h [Finite H] [Field F] [Finite F] [CharP F 2] in
private theorem original_overlap_covariance (a : MulAut R) :
    let w := minimumAutomorphismElement d a
    let z := act d.radical w⁻¹ (alpha d.radical)
    let B := fun v : Vertex d.radical =>
      ((normalizer ((Q d.radical (beta d.radical)).subgroupOf (stabilizer d.radical v) :
        Set (stabilizer d.radical v))).pCoreIn 2).map (stabilizer d.radical v).subtype
    let D := fun v : Vertex d.radical =>
      ⁅U d.radical v ⊓ centralizer (Q d.radical (beta d.radical) : Set (FreeAmalgam d.radical)),B v⁆
    (D (alpha d.radical)).map (MulAut.conj w).toMonoidHom = D z := by
  let w := minimumAutomorphismElement d a
  let z := act d.radical w⁻¹ (alpha d.radical)
  let T := Q d.radical (beta d.radical)
  let B := fun v : Vertex d.radical =>
    ((normalizer (T.subgroupOf (stabilizer d.radical v) :
      Set (stabilizer d.radical v))).pCoreIn 2).map (stabilizer d.radical v).subtype
  have hwb := minimumAutomorphismElement_fixes_beta d a
  have hab : Adjacent d.radical (alpha d.radical) (beta d.radical) := base_adjacent _
  have hzb : Adjacent d.radical z (beta d.radical) := by
    rw [←hwb]
    exact (adjacent_act_iff _ _ _ _).mpr hab
  have hB (v : Vertex d.radical) (hv : Adjacent d.radical v (beta d.radical)) :
      B v = (stabilizer d.radical v ⊓ normalizer (T : Set (FreeAmalgam d.radical))).pCoreIn 2 := by
    have hTS : T ≤ stabilizer d.radical v := fun _ hx => hx.2 v (adjacent_symm _ hv)
    dsimp only [B]
    rw [map_pCoreIn_of_injective 2 _ _ (stabilizer d.radical v).subtype_injective,
      ←subgroupOf_normalizer_eq hTS,subgroupOf_map_subtype,inf_comm]
  have hT : T.map (MulAut.conj w).toMonoidHom = T := by
    have hh := Q_act d.radical w⁻¹ (beta d.radical)
    rw [hwb,inv_inv] at hh
    exact hh.symm
  have hS : (stabilizer d.radical (alpha d.radical)).map (MulAut.conj w).toMonoidHom =
      stabilizer d.radical z := by
    rw [show z = act d.radical w⁻¹ (alpha d.radical) from rfl,stabilizer_act,inv_inv]
  have hBm : (B (alpha d.radical)).map (MulAut.conj w).toMonoidHom = B z := by
    rw [hB _ hab,hB _ hzb,map_pCoreIn_of_injective 2 _ _ (MulAut.conj w).injective,
      map_inf _ _ _ (MulAut.conj w).injective,map_equiv_normalizer_eq,hT,hS]
  change (⁅U d.radical (alpha d.radical) ⊓ centralizer (T : Set (FreeAmalgam d.radical)),
    B (alpha d.radical)⁆).map (MulAut.conj w).toMonoidHom =
    ⁅U d.radical z ⊓ centralizer (T : Set (FreeAmalgam d.radical)),B z⁆
  rw [map_commutator,←map_inf_centralizer_of_injective _ (MulAut.conj w).injective,hT,hBm]
  rw [show z = act d.radical w⁻¹ (alpha d.radical) from rfl,U_act,inv_inv]

/-- At a critical neighbor obtained from an ORIGINAL automorphism, unequal
full fixed kernels are actually exchanged with the normalizer overlap by
that same automorphism. -/
theorem original_critical_fixed_kernel_exchange
    (g : Geometry d.radical) (hb : g.b d.radical = 2)
    (hnsyl : ¬ ∃ S : Sylow 2 (Theory.SpecificGroups.SymplecticFour.Sp F),
      (S : Subgroup (Theory.SpecificGroups.SymplecticFour.Sp F)) =
        (R.subgroupOf K).map (componentProjection h))
    (hne : (d.ambient.subgroupOf K).map (componentProjection h) ≠
      (R.subgroupOf K).map (componentProjection h))
    (a : MulAut R)
    (path : CriticalPath d.radical g (alpha d.radical)
      (act d.radical (minimumAutomorphismElement d a)⁻¹ (alpha d.radical))) :
    let S := stabilizer d.radical (alpha d.radical)
    let B := ((normalizer ((Q d.radical (beta d.radical)).subgroupOf S : Set S)).pCoreIn 2).map S.subtype
    let A := U d.radical (alpha d.radical) ⊓
      centralizer (Ltilde d.radical (alpha d.radical) : Set (FreeAmalgam d.radical))
    let D := ⁅U d.radical (alpha d.radical) ⊓
      centralizer (Q d.radical (beta d.radical) : Set (FreeAmalgam d.radical)),B⁆
    let f := (MulAut.conj (minimumAutomorphismElement d a)).toMonoidHom
    A.map f = A ∨ A.map f = D ∧ D.map f = A ∧ Disjoint A D ∧ Nat.card A = 2^n := by
  classical
  let w := minimumAutomorphismElement d a
  let z := act d.radical w⁻¹ (alpha d.radical)
  let A := U d.radical (alpha d.radical) ⊓
    centralizer (Ltilde d.radical (alpha d.radical) : Set (FreeAmalgam d.radical))
  let A' := U d.radical z ⊓ centralizer (Ltilde d.radical z : Set (FreeAmalgam d.radical))
  let B := fun v : Vertex d.radical =>
    ((normalizer ((Q d.radical (beta d.radical)).subgroupOf (stabilizer d.radical v) :
      Set (stabilizer d.radical v))).pCoreIn 2).map (stabilizer d.radical v).subtype
  let D := fun v : Vertex d.radical =>
    ⁅U d.radical v ⊓ centralizer (Q d.radical (beta d.radical) : Set (FreeAmalgam d.radical)),B v⁆
  have hmA : A.map (MulAut.conj w).toMonoidHom = A' := by
    dsimp only [A,A',z]
    rw [←map_inf_centralizer_of_injective _ (MulAut.conj w).injective,U_act,Ltilde_act,inv_inv]
  change A.map (MulAut.conj w).toMonoidHom = A ∨
    A.map (MulAut.conj w).toMonoidHom = D (alpha d.radical) ∧
      (D (alpha d.radical)).map (MulAut.conj w).toMonoidHom = A ∧
      Disjoint A (D (alpha d.radical)) ∧ Nat.card A = 2^n
  rw [hmA]
  by_cases he : A=A'
  · exact Or.inl he.symm
  have hab : Adjacent d.radical (alpha d.radical) (beta d.radical) := base_adjacent _
  have hzb : Adjacent d.radical z (beta d.radical) := by
    rw [←minimumAutomorphismElement_fixes_beta d a]
    exact (adjacent_act_iff _ _ _ _).mpr hab
  have hs := replacement_proper_nonsylow_card h d g hb hnsyl hne
  obtain ⟨hDa,hDz,hdis,hjoin⟩ := replacement_field_sized_unequal_paired_overlaps
    h d path hb hab hzb hs he
  obtain ⟨_,hcard,_,_⟩ :=
    (replacement_field_sized_fixed_kernels_dichotomy h d path hb hab hzb hs).resolve_left he
  refine Or.inr ⟨hDa.symm,(original_overlap_covariance d a).trans hDz,?_,hcard⟩
  change Disjoint (D (alpha d.radical)) (D z) at hdis
  change D z = A at hDz
  rw [hDz] at hdis
  exact hdis.symm

/-- The original MS3 condition supplies the same critical automorphism used
in the full fixed-kernel comparison. No replacement automorphism is extended. -/
theorem exists_original_critical_kernel_comparison
    (g : Geometry d.radical) (hb : g.b d.radical = 2)
    (hnsyl : ¬ ∃ S : Sylow 2 (Theory.SpecificGroups.SymplecticFour.Sp F),
      (S : Subgroup (Theory.SpecificGroups.SymplecticFour.Sp F)) =
        (R.subgroupOf K).map (componentProjection h))
    (hne : (d.ambient.subgroupOf K).map (componentProjection h) ≠
      (R.subgroupOf K).map (componentProjection h)) :
    ∃ a : MulAut R,
      let z := act d.radical (minimumAutomorphismElement d a)⁻¹ (alpha d.radical)
      let S := stabilizer d.radical (alpha d.radical)
      let B := ((normalizer ((Q d.radical (beta d.radical)).subgroupOf S : Set S)).pCoreIn 2).map S.subtype
      let A := U d.radical (alpha d.radical) ⊓
        centralizer (Ltilde d.radical (alpha d.radical) : Set (FreeAmalgam d.radical))
      let D := ⁅U d.radical (alpha d.radical) ⊓
        centralizer (Q d.radical (beta d.radical) : Set (FreeAmalgam d.radical)),B⁆
      let f := (MulAut.conj (minimumAutomorphismElement d a)).toMonoidHom
      Adjacent d.radical z (beta d.radical) ∧
      ¬ U d.radical z ≤ Q d.radical (alpha d.radical) ∧
      Nonempty (CriticalPath d.radical g (alpha d.radical) z) ∧
      (A.map f = A ∨ A.map f = D ∧ D.map f = A ∧ Disjoint A D ∧ Nat.card A = 2^n) := by
  obtain ⟨a,haz,hmove,⟨path⟩⟩ := exists_original_critical_neighbor h d g hb
  exact ⟨a,haz,hmove,⟨path⟩,original_critical_fixed_kernel_exchange h d g hb hnsyl hne a path⟩

end CFSG.Quasithin.ChapterC.RankTwo.NonbinarySymplectic.OriginalStar
