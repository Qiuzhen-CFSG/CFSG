variable {G : Type u} [Group G] [Finite G] {L R : Subgroup G}
local notation "T" => R.subgroupOf (L ⊔ R)

/-- The full vertex group is generated by its residual and the literal edge kernel. -/
theorem local_generation_edge (h : Pair KnownSimple.IsKnownSimple L R)
    {a t : Vertex T} (ha : color T a = false) (hat : Adjacent T a t) :
    Ltilde T a ⊔ Q T t = stabilizer T a := by
  have hgen : L.subgroupOf (L ⊔ R) ⊔ T = ⊤ := by
    rw [← subgroupOf_sup le_sup_left le_sup_right, subgroupOf_self]
  have hbase : Ltilde T (alpha T) ⊔ Q T (beta T) = stabilizer T (alpha T) := by
    rw [Ltilde_alpha, relative_residual h, Q_beta, ← Subgroup.map_sup, hgen,
      ← MonoidHom.range_eq_map]
    exact (stabilizer_m_base T).symm
  obtain ⟨g, ⟨rfl,rfl⟩ | ⟨rfl,rfl⟩⟩ := (adjacent_iff_exists_common T a t).mp hat
  · have hh := congrArg (Subgroup.map (MulAut.conj g⁻¹).toMonoidHom) hbase
    rw [Subgroup.map_sup, ← Ltilde_act, ← Q_act, ← stabilizer_act] at hh
    simpa only [alpha, beta, act_mVertex, act_hVertex, one_mul] using hh
  · cases ha

/-- The moving radius and any incident edge radius generate the whole radius. -/
theorem radius_eq_moving_sup_edge (h : Pair KnownSimple.IsKnownSimple L R)
    {a t : Vertex T} (ha : color T a = false) (hat : Adjacent T a t) :
    V T a = Vcirc T a ⊔ V T t := by
  have htV := edge_radius_le_radius ha hat
  have hn : stabilizer T a ≤ normalizer (Vcirc T a ⊔ V T t : Subgroup (FreeAmalgam T)) := by
    rw [← local_generation_edge h ha hat]
    apply sup_le
    · exact normalizes_sup_of_commutator_le _ _ _
        ((Ltilde_le_stabilizer a).trans (Vcirc_normalized a))
        (commutator_mono htV le_rfl)
    · exact (le_inf
        ((CriticalCriterion.edge_le_stabilizer T ha hat).trans (Vcirc_normalized a))
        ((show Q T t ≤ stabilizer T t from fun _ hx => hx.1).trans (V_normalized t))).trans
        (normalizer_inf_normalizer_le_normalizer_sup _ _)
  have hmov : Vcirc T a ≤ V T a := le_normalizer_iff_commutator_le_left.mp
    ((Ltilde_le_stabilizer a).trans (V_normalized a))
  apply le_antisymm _ (sup_le hmov htV)
  apply radius_le_of_m_ball ha
  intro d hd hdist
  by_cases hda : d = a
  · subst d
    apply (show Z T a ≤ V T t from ?_).trans le_sup_right
    apply le_iSup_of_le a
    exact le_iSup_of_le
      (show (cosetGraph T).dist a t ≤ 2 from
        (SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj T _ _).mpr hat)).le.trans (by decide)) le_rfl
  have htwo : (cosetGraph T).dist a d = 2 := by
    have hne : (cosetGraph T).dist a d ≠ 0 := by
      intro hz
      exact hda ((cosetGraph_connected T).dist_eq_zero_iff.mp hz).symm
    have heven : Even ((cosetGraph T).dist a d) := by
      obtain ⟨w, hw⟩ := (cosetGraph_connected T).exists_walk_length_eq_dist a d
      rw [← hw, walk_even_iff_color_eq, ha, hd]
    rw [Nat.even_iff] at heven
    rw [SimpleGraph.dist_comm] at hdist
    omega
  obtain ⟨u, hau, hdu⟩ := exists_common_neighbor_of_dist_two T a d htwo
  obtain ⟨g, hg, hgu⟩ := stabilizer_transitive_neighbors T a hat hau
  have hVu : V T u ≤ Vcirc T a ⊔ V T t := by
    rw [← hgu, V_act]
    exact (map_mono (show V T t ≤ Vcirc T a ⊔ V T t from le_sup_right)).trans
      (mem_normalizer_iff_map_conj_eq.mp (hn ((stabilizer T a).inv_mem hg))).le
  apply (show Z T d ≤ V T u from ?_).trans hVu
  apply le_iSup_of_le d
  exact le_iSup_of_le
    (show (cosetGraph T).dist d u ≤ 2 from
      (SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj T _ _).mpr hdu)).le.trans (by decide)) le_rfl


/-- The radius group is finite and a two-group, inside its own vertex kernel. -/
theorem radius_isPGroup (h : Pair KnownSimple.IsKnownSimple L R)
    (hb : 2 < (geometry h).b T) (a : Vertex T) (ha : color T a = false) :
    IsPGroup 2 (V T a) :=
  (Q_isPGroup T (edge_two_group h) (core_le_edge h) a ha).of_injective
    (inclusion ((geometry h).V_le_Q hb a ha)) (inclusion_injective _)

/-- The edge radius is an elementary two-group. -/
theorem edge_radius_elementary (h : Pair KnownSimple.IsKnownSimple L R)
    (hb : 2 < (geometry h).b T) (a t : Vertex T)
    (ha : color T a = false) (hat : Adjacent T a t) :
    IsElementaryAbelian 2 (V T t) := by
  let I := {d : Vertex T // Adjacent T d t}
  have heq : V T t = ⨆ d : I, Z T d.val := by
    apply le_antisymm
    · apply radius_le_of_h_neighbors ha hat
      intro d hd
      exact le_iSup_of_le (⟨d,hd⟩ : I) le_rfl
    · apply iSup_le
      intro d
      exact le_iSup_of_le d.val (le_iSup_of_le
        ((SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj T _ _).mpr d.property)).le.trans
          (by decide : 1 ≤ 2)) le_rfl)
  have hcomm := edge_radius_commutative (geometry h) hb a t ha hat
  have hcen := le_centralizer_iff_isMulCommutative.mpr hcomm
  have hZ (d : I) : Z T d.val ≤ V T t := by
    rw [heq]
    exact le_iSup (fun d : I => Z T d.val) d
  have ht : color T t = true := by
    have hn := adjacent_color_ne T hat
    cases hc : color T t <;> simp_all
  have hE (d : I) : IsElementaryAbelian 2 (Z T d.val) := by
    have hd : color T d.val = false := by
      have hn := adjacent_color_ne T d.property
      cases hc : color T d.val <;> simp_all
    exact Z_elementary_of_positive T (geometry h) d.val hd (by
      rw [(geometry h).distance_constant d.val hd]
      change 0 < (geometry h).b T
      omega)
  let := hE
  rw [heq]
  exact IsElementaryAbelian.iSup_of_le_centralizer (fun d : I => Z T d.val)
    (fun d e => (hZ d).trans (hcen.trans (centralizer_le (hZ e))))

/-- Residual commutators generate the entire moving radius. -/
theorem moving_full_commutation (h : Pair KnownSimple.IsKnownSimple L R)
    (hb : 2 < (geometry h).b T) (a : Vertex T) (ha : color T a = false) :
    ⁅Vcirc T a, Ltilde T a⁆ = Vcirc T a := by
  let S := stabilizer T a
  let W := (V T a).subgroupOf S
  let := finite_stabilizer T a
  let : W.Normal := normal_subgroupOf_of_le_normalizer (V_normalized a)
  have hV : V T a ≤ S := ((geometry h).V_le_Q hb a ha).trans (fun _ hx => hx.1)
  have hid := commutator_isPPerfect_idempotent (pResidual 2 S) W
    (isPPerfect_pResidual 2) (radius_isPGroup h hb a ha).comap_subtype
    le_normalizer_of_normal
  have hh := congrArg (Subgroup.map S.subtype) hid
  have hW : W.map S.subtype = V T a := map_subgroupOf_eq_of_le hV
  simpa only [map_commutator, hW, Ltilde, Vcirc] using hh

/-- The whole derived radius is its commutator with the moving radius.
The edge radius supplies an abelian supplement. -/
theorem radius_derived_eq_moving_commutator
    (h : Pair KnownSimple.IsKnownSimple L R)
    (hb : 2 < (geometry h).b T) (a t : Vertex T)
    (ha : color T a = false) (hat : Adjacent T a t) :
    ⁅V T a,V T a⁆ = ⁅Vcirc T a,V T a⁆ := by
  have hm : Vcirc T a ≤ V T a := le_normalizer_iff_commutator_le_left.mp
    ((Ltilde_le_stabilizer a).trans (V_normalized a))
  have he := edge_radius_le_radius ha hat
  have hV : V T a ≤ stabilizer T a :=
    ((geometry h).V_le_Q hb a ha).trans (fun _ hx => hx.1)
  have hn : V T a ≤ normalizer (⁅Vcirc T a,V T a⁆ : Subgroup (FreeAmalgam T)) := by
    intro x hx
    rw [mem_normalizer_iff_map_conj_eq, map_commutator,
      mem_normalizer_iff_map_conj_eq.mp (Vcirc_normalized a (hV hx)),
      mem_normalizer_iff_map_conj_eq.mp ((V T a).le_normalizer hx)]
  have hedge : ⁅V T t,V T a⁆ ≤ ⁅Vcirc T a,V T a⁆ := by
    rw [commutator_comm]
    conv_lhs => lhs; rw [radius_eq_moving_sup_edge h ha hat]
    apply commutator_sup_le_of_relative_normal (V T a) _ _ _ _ hn hm he
    · exact commutator_mono le_rfl he
    · rw [commutator_self_eq_bot_iff.mpr
        (edge_radius_commutative (geometry h) hb a t ha hat)]
      exact bot_le
  apply le_antisymm _ (commutator_mono hm le_rfl)
  conv_lhs => lhs; rw [radius_eq_moving_sup_edge h ha hat]
  exact commutator_sup_le_of_relative_normal (V T a) _ _ _ _ hn hm he le_rfl hedge

/-- Every radius generator is an involution, so the Frattini and derived
subgroups of the actual radius agree. -/
theorem radius_frattini_eq_derived (h : Pair KnownSimple.IsKnownSimple L R)
    (hb : 2 < (geometry h).b T) (a : Vertex T) (ha : color T a = false) :
    (frattini (V T a)).map (V T a).subtype = ⁅V T a,V T a⁆ := by
  have hV : V T a ≤ stabilizer T a :=
    ((geometry h).V_le_Q hb a ha).trans (fun _ hx => hx.1)
  let := CriticalCriterion.finite_of_le_stabilizer T hV
  let : Fact (IsPGroup 2 (V T a)) := ⟨radius_isPGroup h hb a ha⟩
  have hlow := map_mono (f := (V T a).subtype)
    (commutator_le_frattini_of_isPGroup (p := 2) (R := V T a))
  rw [commutator_def, map_commutator, ← MonoidHom.range_eq_map, range_subtype] at hlow
  apply le_antisymm _ hlow
  have hsq : ∀ x ∈ V T a, x ^ 2 ∈ ⁅V T a,V T a⁆ := by
    let I := {d : Vertex T // color T d = false ∧ (cosetGraph T).dist d a ≤ 2}
    have heq : V T a = ⨆ d : I, Z T d.val := by
      apply le_antisymm
      · apply radius_le_of_m_ball ha
        intro d hd hdist
        exact le_iSup_of_le (⟨d,hd,hdist⟩ : I) le_rfl
      · apply iSup_le
        intro d
        exact le_iSup_of_le d.val (le_iSup_of_le d.property.2 le_rfl)
    intro x hx
    rw [heq] at hx
    induction hx using iSup_induction' with
    | hp d x hx =>
      let := Z_elementary_of_positive T (geometry h) d.val d.property.1 (by
        rw [(geometry h).distance_constant d.val d.property.1]
        change 0 < (geometry h).b T
        omega)
      rw [elemPow_eq_one_of_isElementaryAbelian x hx]
      exact one_mem _
    | h1 => simp
    | hmul x y hx hy ihx ihy =>
      have hxV : x ∈ V T a := heq ▸ hx
      have hyV : y ∈ V T a := heq ▸ hy
      have hi : (x*y)^2 = x^2*⁅x⁻¹,y⁆*y^2 := by
        simp [commutatorElement_def,pow_two,mul_assoc]
      rw [hi]
      exact mul_mem (mul_mem ihx
        (commutator_mem_commutator ((V T a).inv_mem hxV) hyV)) ihy
  rw [map_le_iff_le_comap,(radius_isPGroup h hb a ha).frattini_eq_closure_squares]
  apply (closure_le _).mpr
  rintro x ⟨y,rfl⟩
  exact hsq y y.property

open Representation Representation.BinaryOffender Comparison.CriticalImage

private theorem offender_fixed_card (A : Subgroup (Atlas.G2.Model (ZMod 2)))
    (hA : IsOffender rho A) : Nat.card (fixedSpace rho A) = 8 := by
  have hcost : fixedCodim rho A = 3 := by
    obtain ⟨g,rfl⟩ := Atlas.G2.NaturalOffenders.offender_conjugate_elementary
      (F := ZMod 2) (n := 1) (by norm_num) (by decide) A hA
    rw [fixedCodim_map_conj]
    exact Atlas.G2.NaturalOffenders.fixedCodim_elementary (n := 1) (by norm_num)
  have hsum := fixedCodim_add_finrank rho A
  have htotal : Module.finrank (ZMod 2) (Fin 6 → ZMod 2) = 6 := by simp
  rw [hcost, htotal] at hsum
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2), Nat.card_zmod,
    show Module.finrank (ZMod 2) (fixedSpace rho A) = 3 from by omega]
  norm_num

/-- The full critical commutator covers a natural three-space, hence has
at least eight elements, including any fixed central attachment. -/
theorem critical_commutator_card_ge_eight
    (h : Pair KnownSimple.IsKnownSimple L R)
    (e : (L ⧸ pCore 2 L) ≃* commutator (Atlas.G2.Model (ZMod 2)))
    (a z : Vertex T) (ha : color T a = false)
    (hc : CriticalPair T a z ((geometry h).exists_critical a ha)) :
    8 ≤ Nat.card (⁅Z T a,Z T z⁆ : Subgroup (FreeAmalgam T)) := by
  classical
  obtain ⟨da⟩ := endpointModel_knownSimple h e ha
  have hz := critical_endpoint_color T a ha _ hc
  obtain ⟨dz⟩ := endpointModel_knownSimple h e hz
  have hoff := critical_image_offender (geometry h) (edgeCentralizer h e) a z ha
    (positive_even h e).1 hc da dz
  have hcover := critical_fixed_covered (geometry h) (edgeCentralizer h e) a z ha
    (positive_even h e).1 hc da dz
  let D := ⁅Z T a,Z T z⁆
  have hDZ : D ≤ Z T z := Comparison.critical_image_le_endpoint (geometry h) a z ha hc
  let := finite_Z T z
  let : Finite D := Finite.of_injective (inclusion hDZ) (inclusion_injective hDZ)
  have hlift : ∀ w : fixedSpace rho (image dz (Z T a)),
      ∃ x : D, dz.projection ⟨x.val,hDZ x.property⟩ = Multiplicative.ofAdd w.val := by
    intro w
    obtain ⟨x,hx,hxw⟩ := hcover w w.property
    exact ⟨⟨x.val,hx⟩,hxw⟩
  choose f hf using hlift
  have hinj : Function.Injective f := by
    intro x y hxy
    apply Subtype.ext
    have heq := congrArg (fun d : D => dz.projection ⟨d.val,hDZ d.property⟩) hxy
    rw [hf x,hf y] at heq
    exact Multiplicative.ofAdd.injective heq
  calc
    8 = Nat.card (fixedSpace rho (image dz (Z T a))) := (offender_fixed_card _ hoff).symm
    _ ≤ Nat.card D := Nat.card_le_card_of_injective f hinj

/-- At a critical midpoint the moving-radius commutator has at least eight
 elements. This is the literal obstruction to the order-two conclusion on p.879. -/
theorem moving_commutator_card_ge_eight
    (h : Pair KnownSimple.IsKnownSimple L R)
    (e : (L ⧸ pCore 2 L) ≃* commutator (Atlas.G2.Model (ZMod 2)))
    (hb : 2 < (geometry h).b T)
    (a z : Vertex T) (ha : color T a = false)
    (hc : CriticalPair T a z ((geometry h).exists_critical a ha))
    (c : Vertex T) (hcColor : color T c = false)
    (hac : (cosetGraph T).dist a c = 2) (hcz : (cosetGraph T).dist c z = 2) :
    8 ≤ Nat.card (⁅Vcirc T c,V T c⁆ : Subgroup (FreeAmalgam T)) := by
  have haV : Z T a ≤ V T c := le_iSup_of_le a (le_iSup_of_le hac.le le_rfl)
  have hzV : Z T z ≤ V T c := le_iSup_of_le z (le_iSup_of_le
    (by rw [SimpleGraph.dist_comm,hcz]) le_rfl)
  have hD := commutator_mono haV hzV
  obtain ⟨t,hat,hct⟩ := exists_common_neighbor_of_dist_two T a c hac
  rw [radius_derived_eq_moving_commutator h hb c t hcColor hct] at hD
  have hm : Vcirc T c ≤ V T c := le_normalizer_iff_commutator_le_left.mp
    ((Ltilde_le_stabilizer c).trans (V_normalized c))
  have hcomm : ⁅Vcirc T c,V T c⁆ ≤ V T c :=
    (commutator_mono hm le_rfl).trans
      (le_normalizer_iff_commutator_le_left.mp (V T c).le_normalizer)
  let := CriticalCriterion.finite_of_le_stabilizer T
    ((hcomm.trans ((geometry h).V_le_Q hb c hcColor)).trans (fun _ hx => hx.1))
  exact (critical_commutator_card_ge_eight h e a z ha hc).trans (card_le_of_le hD)

/-- A source order-two bound on the moving-radius commutator contradicts
 the actual critical natural quotient. -/
theorem false_of_small_moving_commutator
    (h : Pair KnownSimple.IsKnownSimple L R)
    (e : (L ⧸ pCore 2 L) ≃* commutator (Atlas.G2.Model (ZMod 2)))
    (hb : (geometry h).b T = 4)
    (hsmall : ∀ c : Vertex T, color T c = false →
      Nat.card (⁅Vcirc T c,V T c⁆ : Subgroup (FreeAmalgam T)) ≤ 2) : False := by
  obtain ⟨z,hcrit⟩ := criticalPair_exists T (alpha T) ((geometry h).exists_critical _ rfl)
  have hd : (cosetGraph T).dist (alpha T) z = 4 :=
    hcrit.1.trans (((geometry h).distance_constant (alpha T) rfl).trans hb)
  obtain ⟨t,hat,htz⟩ := exists_adjacent_dist_sub_one T (alpha T) z (by omega)
  obtain ⟨c,htc,hcz⟩ := exists_adjacent_dist_sub_one T t z (by omega)
  have hct : Adjacent T c t := adjacent_symm T htc
  have hcColor : color T c = false := by
    have ht := adjacent_color_ne T hat
    have hc := adjacent_color_ne T htc
    change false ≠ color T t at ht
    cases hc' : color T c <;> cases ht' : color T t <;> simp_all
  have hat1 := SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj T _ _).mpr hat)
  have htc1 := SimpleGraph.dist_eq_one_iff_adj.mpr ((cosetGraph_adj T _ _).mpr htc)
  have h₁ := (cosetGraph_connected T).dist_triangle (u := alpha T) (v := t) (w := c)
  have h₂ := (cosetGraph_connected T).dist_triangle (u := alpha T) (v := c) (w := z)
  have hac : (cosetGraph T).dist (alpha T) c = 2 := by omega
  have hcz2 : (cosetGraph T).dist c z = 2 := by omega
  have hlo := moving_commutator_card_ge_eight h e (by omega) (alpha T) z rfl hcrit
    c hcColor hac hcz2
  have hhi := hsmall c hcColor
  omega

end CFSG.Quasithin.ChapterC.G2Exceptional.Reconstruction.DistanceTwo.DistanceFour
