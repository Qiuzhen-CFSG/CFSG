module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.SectionThree.LocalGroups
public import Theory.GroupTheory.ConjugateSpanNilpotent

/-!
# The literal span collapse in MS93 (5.9)

The source takes the G_mu-orbit span of Z_c and then its conjugate span
under C_{G_c}(H₂). The distance-two geometry puts Q_c in G_mu, so Q_c
normalizes the first span. Once the source has placed the second span
in Q_c and proved its normality and residual displacement bound, the
nilpotent kernel calculation identifies the two spans. Thus the first
span itself is normalized by G_c, as needed for the terminal action step.

Source: Meierfrankenfeld--Stellmacher (1993), (5.9), printed p.921.
The preceding source commutator comparison and local generation are
explicit inputs; this module does not assert them from graph geometry.
-/

@[expose] public section
open Subgroup Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.BinaryMS.MS93
namespace CFSG.Quasithin.ChapterC.Sp4Four.DistanceReduction.StrictIndex
variable {M : Type*} [Group M] [Finite M] {R : Subgroup M}

/-- The literal source subgroup V generated by the G_mu-conjugates of Z_c. -/
noncomputable def sourceSeedSpan (R : Subgroup M) (c mu : Vertex R) : Subgroup (FreeAmalgam R) :=
  conjugateSpanBy (Z R c) (stabilizer R mu)

/-- The literal source subgroup W generated under C_{G_c}(H₂). -/
noncomputable def sourceCentralizerSpan (R : Subgroup M) (c mu : Vertex R) (H₂ : Subgroup (FreeAmalgam R)) :
    Subgroup (FreeAmalgam R) :=
  conjugateSpanBy (sourceSeedSpan R c mu)
    (stabilizer R c ⊓ centralizer (H₂ : Set _))

/-- Distance two supplies the kernel normalization needed for span collapse. -/
theorem sourceSeedSpan_normalized_by_kernel
    {c mu : Vertex R} (hc : color R c = false) (hmu : color R mu = false)
    (hd : (cosetGraph R).dist c mu ≤ 2) :
    Q R c ≤ normalizer (sourceSeedSpan R c mu : Set _) :=
  (Q_le_stabilizer_of_dist_le_two c mu hc hmu hd).trans
    (le_normalizer_conjugateSpanBy (Z R c) (stabilizer R mu))

omit [Finite M] in
/-- The seed span lies in Q_c because each orbit vertex is within four
steps of c. No radius-two containment of the whole span is asserted. -/
theorem sourceSeedSpan_le_Q (geometry : Geometry R) (hb : 4 < geometry.b R)
    {c mu : Vertex R} (hc : color R c = false)
    (hd : (cosetGraph R).dist c mu ≤ 2) : sourceSeedSpan R c mu ≤ Q R c := by
  apply (closure_le _).mpr
  rintro _ ⟨g,hg,z,hz,rfl⟩
  change g * z * g⁻¹ ∈ Q R c
  have hfix : act R g⁻¹ mu = mu := (stabilizer R mu).inv_mem hg
  have htcol : color R (act R g⁻¹ c) = false := by
    rw [action_preserves_color]
    exact hc
  have htmu : (cosetGraph R).dist (act R g⁻¹ c) mu ≤ 2 := by
    have he := dist_act R g⁻¹ c mu
    rw [hfix] at he
    rwa [he]
  have hdist : (cosetGraph R).dist (act R g⁻¹ c) c <
      criticalDistance R (act R g⁻¹ c) (geometry.exists_critical _ htcol) := by
    rw [geometry.distance_constant _ htcol]
    change (cosetGraph R).dist (act R g⁻¹ c) c < geometry.b R
    have htri := (cosetGraph_connected R).dist_triangle
      (u := act R g⁻¹ c) (v := mu) (w := c)
    have hdc : (cosetGraph R).dist mu c ≤ 2 := by rwa [SimpleGraph.dist_comm]
    omega
  apply Z_le_Q_of_dist_lt R (act R g⁻¹ c) (geometry.exists_critical _ htcol) hdist
  rw [Z_act]
  exact ⟨z,hz,by simp only [inv_inv]; rfl⟩

omit [Finite M] in
/-- The second span stays in the same kernel because its conjugators lie
in G_c. -/
theorem sourceCentralizerSpan_le_Q (geometry : Geometry R) (hb : 4 < geometry.b R)
    {c mu : Vertex R} (hc : color R c = false)
    (hd : (cosetGraph R).dist c mu ≤ 2) (H₂ : Subgroup (FreeAmalgam R)) :
    sourceCentralizerSpan R c mu H₂ ≤ Q R c :=
  conjugateSpanBy_le (sourceSeedSpan_le_Q geometry hb hc hd)
    (inf_le_left.trans (Q_normalized R c))

/-- The displayed source comparison and the actual two generators of G_c
make W invariant, before any conclusion W = V is used. -/
theorem sourceCentralizerSpan_normalized_of_comparison
    {c mu : Vertex R} (hc : color R c = false) (hmu : color R mu = false)
    (hd : (cosetGraph R).dist c mu ≤ 2) (H₂ E : Subgroup (FreeAmalgam R))
    (hgen : (stabilizer R c ⊓ centralizer (H₂ : Set _)) ⊔ E = stabilizer R c)
    (hcomm : ⁅sourceCentralizerSpan R c mu H₂,E⁆ ≤
      ⁅sourceCentralizerSpan R c mu H₂,Q R c⁆ ⊔ ⁅Z R c,E⁆) :
    stabilizer R c ≤ normalizer (sourceCentralizerSpan R c mu H₂ : Set _) := by
  let V₀ : Subgroup (FreeAmalgam R) := conjugateSpanBy (Z R c) (stabilizer R mu)
  let C₀ : Subgroup (FreeAmalgam R) := stabilizer R c ⊓ centralizer (H₂ : Set _)
  have hQV : Q R c ≤ normalizer (V₀ : Set _) :=
    (Q_le_stabilizer_of_dist_le_two c mu hc hmu hd).trans
      (le_normalizer_conjugateSpanBy (Z R c) (stabilizer R mu))
  change ⁅conjugateSpanBy V₀ C₀,E⁆ ≤ ⁅conjugateSpanBy V₀ C₀,Q R c⁆ ⊔ ⁅Z R c,E⁆ at hcomm
  change stabilizer R c ≤ normalizer (conjugateSpanBy V₀ C₀ : Set _)
  exact conjugateSpanBy_normalized_of_commutator_comparison
    V₀ C₀ (Q R c) (Z R c) E (stabilizer R c) hQV
    (Q_normalized R c) (Z_normalized R c)
    (le_conjugateSpanBy (Z R c) (stabilizer R mu)) hgen hcomm

/-- The source residual displacement bound forces its two conjugate spans
to agree. Only the actual local kernel needs to be finite. -/
theorem sourceCentralizerSpan_eq_seed
    {c mu : Vertex R} (hc : color R c = false) (hmu : color R mu = false)
    (hd : (cosetGraph R).dist c mu ≤ 2)
    (hp : IsPGroup 2 (Q R c)) (H₂ : Subgroup (FreeAmalgam R))
    (hWQ : sourceCentralizerSpan R c mu H₂ ≤ Q R c)
    (hgen : Ltilde R c ⊔ Q R c = stabilizer R c)
    (hWnorm : stabilizer R c ≤ normalizer (sourceCentralizerSpan R c mu H₂ : Set _))
    (hcomm : ⁅sourceCentralizerSpan R c mu H₂,Ltilde R c⁆ ≤
      ⁅sourceCentralizerSpan R c mu H₂,Q R c⁆ ⊔ Z R c) :
    sourceCentralizerSpan R c mu H₂ = sourceSeedSpan R c mu := by
  let V₀ : Subgroup (FreeAmalgam R) := conjugateSpanBy (Z R c) (stabilizer R mu)
  let C₀ : Subgroup (FreeAmalgam R) := stabilizer R c ⊓ centralizer (H₂ : Set _)
  let := finite_stabilizer R c
  let : Finite (Q R c) := Finite.of_injective
    (inclusion (show Q R c ≤ stabilizer R c from fun _ hx => hx.1))
    (inclusion_injective _)
  have hnil : Group.IsNilpotent (Q R c) := hp.isNilpotent
  have hQV : Q R c ≤ normalizer (V₀ : Set _) :=
    (Q_le_stabilizer_of_dist_le_two c mu hc hmu hd).trans
      (le_normalizer_conjugateSpanBy (Z R c) (stabilizer R mu))
  have hZV : Z R c ≤ V₀ := le_conjugateSpanBy (Z R c) (stabilizer R mu)
  change conjugateSpanBy V₀ C₀ ≤ Q R c at hWQ
  change stabilizer R c ≤ normalizer (conjugateSpanBy V₀ C₀ : Set _) at hWnorm
  change ⁅conjugateSpanBy V₀ C₀,Ltilde R c⁆ ≤ ⁅conjugateSpanBy V₀ C₀,Q R c⁆ ⊔ Z R c at hcomm
  change conjugateSpanBy V₀ C₀ = V₀
  exact @conjugateSpanBy_eq_of_nilpotent_local_generation
    (FreeAmalgam R) inferInstance V₀ C₀ (Q R c) (Z R c)
    (Ltilde R c) (stabilizer R c) hnil hWQ hQV hZV inf_le_left hgen
    hWnorm (Q_normalized R c) (Z_normalized R c) hcomm

/-- The source span V inherits full local invariance after W = V. -/
theorem sourceSeedSpan_normalized_of_displacement
    {c mu : Vertex R} (hc : color R c = false) (hmu : color R mu = false)
    (hd : (cosetGraph R).dist c mu ≤ 2)
    (hp : IsPGroup 2 (Q R c)) (H₂ : Subgroup (FreeAmalgam R))
    (hWQ : sourceCentralizerSpan R c mu H₂ ≤ Q R c)
    (hgen : Ltilde R c ⊔ Q R c = stabilizer R c)
    (hWnorm : stabilizer R c ≤ normalizer (sourceCentralizerSpan R c mu H₂ : Set _))
    (hcomm : ⁅sourceCentralizerSpan R c mu H₂,Ltilde R c⁆ ≤
      ⁅sourceCentralizerSpan R c mu H₂,Q R c⁆ ⊔ Z R c) :
    stabilizer R c ≤ normalizer (sourceSeedSpan R c mu : Set _) := by
  rwa [sourceCentralizerSpan_eq_seed (R := R) hc hmu hd hp H₂ hWQ hgen hWnorm hcomm] at hWnorm

end CFSG.Quasithin.ChapterC.Sp4Four.DistanceReduction.StrictIndex
