module
public import Theory.SpecificGroups.SymplecticFour.Sylow.CentralRootGeometry.TransvectionCommutator
public import Theory.GroupTheory.Commutator.RelativeGeneration
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Sp4Four.CoreReconstruction.PairedOrbit
public import Theory.GroupTheory.Commutator.FaithfulSimpleImage

/-!
# The original secondary commutator from its marked root image

The seed's commutator bound propagates through its local conjugate span.
If the resulting image on the opposite natural layer moves at most a line,
the explicit symplectic Sylow calculation makes that image trivial. This
keeps the specified map and its full kernel. A normal central layer inside
the opposite kernel is then fixed by the faithful simple component; it
vanishes when the original X-layer has no component-fixed attachment.

GenerationTwoSymplecticCommutator applies both results to the original
secondary orbit. Construction of that restricted natural action, the
critical-distance reduction and secondary movement remain separate.
Source: MS93 (3.6), printed p.871.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped commutatorElement
open Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.BinaryMS.MS93
open CFSG.Quasithin.ChapterC.BinaryMS.MS93.NormalizerTransfer
namespace CFSG.Quasithin.ChapterC.RankTwo.Sp4Four.CoreReconstruction
variable {G F : Type*} [Group G] [Field F] [Finite F] [CharP F 2]
open Theory.SpecificGroups.SymplecticFour

/-- Normal generation preserves the source seed's central-layer bound. -/
theorem conjugatesIn_commutator_le (Y H P Z : Subgroup G)
    (hYP : Y ≤ P) (hHP : H ≤ normalizer P) (hHZ : H ≤ normalizer Z)
    (hPZ : P ≤ normalizer Z) (hc : ⁅Y,P⁆ ≤ Z) :
    ⁅conjugatesIn Y H,P⁆ ≤ Z := by
  apply commutator_iSup_le_of_relative_normal P P Z _ hPZ
  · intro h
    exact (map_mono hYP).trans_eq
      (mem_normalizer_iff_map_conj_eq.mp (hHP (H.inv_mem h.property)))
  · intro h
    have hh := map_mono (f := (MulAut.conj (h⁻¹:G)).toMonoidHom) hc
    have heP : P.map (MulAut.conj (h⁻¹:G)).toMonoidHom = P :=
      mem_normalizer_iff_map_conj_eq.mp (hHP (H.inv_mem h.property))
    have heZ : Z.map (MulAut.conj (h⁻¹:G)).toMonoidHom = Z :=
      mem_normalizer_iff_map_conj_eq.mp (hHZ (H.inv_mem h.property))
    rwa [map_commutator,heP,heZ] at hh

/-- A two-group orbit generated by involutions has trivial commutator image
when that image consists of natural transvections. The homomorphism retains
its full kernel; it need not be surjective. -/
theorem conjugatesIn_commutator_le_marked_kernel
    {n : ℕ} (hF : Nat.card F = 2^n) (hn : 1 ≤ n)
    (Y H P Z : Subgroup G) (hp : IsPGroup 2 P)
    [IsElementaryAbelian 2 Y]
    (hYP : Y ≤ P) (hHP : H ≤ normalizer P)
    (hc : ⁅conjugatesIn Y H,P⁆ ≤ Z)
    (f : P →* Sp F)
    (hroot : ∀ z : P, (z:G) ∈ Z →
      Module.finrank F (InvolutionTypes.movedSpace (f z)) ≤ 1) :
    ⁅conjugatesIn Y H,P⁆ ≤ f.ker.map P.subtype := by
  have hAP : conjugatesIn Y H ≤ P := conjugatesIn_le_of_normalized Y H P hYP hHP
  have hPK : P ≤ normalizer (f.ker.map P.subtype) := by
    have hh := f.ker.le_normalizer_map P.subtype
    rwa [normalizer_eq_top,←MonoidHom.range_eq_map,range_subtype] at hh
  apply commutator_iSup_le_of_relative_normal P P (f.ker.map P.subtype) _ hPK
  · intro h
    exact (map_mono hYP).trans_eq
      (mem_normalizer_iff_map_conj_eq.mp (hHP (H.inv_mem h.property)))
  · intro h
    apply commutator_le.mpr
    rintro x ⟨y,hy,rfl⟩ p hpP
    let x : P := ⟨(MulAut.conj (h⁻¹:G)) y,hAP (le_iSup (fun h : H => rightConjugate Y h) h
      (mem_map_of_mem (MulAut.conj (h⁻¹:G)).toMonoidHom hy))⟩
    let p' : P := ⟨p,hpP⟩
    have hx : x^2=1 := by
      apply Subtype.ext
      change ((MulAut.conj (h⁻¹:G)) y)^2 = 1
      rw [←map_pow,elemPow_eq_one_of_isElementaryAbelian y hy,map_one]
    have hcomm : (⁅x,p'⁆ : P).val ∈ Z := hc (commutator_mem_commutator
      (le_iSup (fun h : H => rightConjugate Y h) h
        (mem_map_of_mem (MulAut.conj (h⁻¹:G)).toMonoidHom hy)) hpP)
    have he := CentralRootGeometry.twoGroup_involution_commutator_eq_one hF hn f.range
      (hp.of_surjective f.rangeRestrict f.rangeRestrict_surjective)
      (f x) (f p') ⟨x,rfl⟩ ⟨p',rfl⟩
      (by rw [←map_pow,hx,map_one])
      (by rw [←map_commutatorElement]; exact hroot ⁅x,p'⁆ hcomm)
    exact mem_map_of_mem P.subtype (show ⁅x,p'⁆ ∈ f.ker by
      change f ⁅x,p'⁆ = 1
      rwa [map_commutatorElement])

end CFSG.Quasithin.ChapterC.RankTwo.Sp4Four.CoreReconstruction

namespace CFSG.Quasithin.ChapterC.RankTwo.Sp4Four.CoreReconstruction
open Theory.SpecificGroups.SymplecticFour
variable {M J : Type*} [Group M] [Finite M] [Group J] {R : Subgroup M} {a z : Vertex R}

/-- A normal central layer meeting the opposite kernel is fixed by the
faithful simple component, and hence vanishes in the center-free case. -/
theorem normal_central_layer_eq_bot_of_opposite_kernel
    (N : Subgroup (FreeAmalgam R)) (hNX : N ≤ X R a) (hNQ : N ≤ Q R z)
    (hn : stabilizer R a ≤ normalizer N)
    (hzS : Z R z ≤ stabilizer R a) (hzQ : ¬ Z R z ≤ Q R a)
    (hz : color R z = false)
    (κ : stabilizer R a →* J) (hκ : Function.Surjective κ)
    (hk : κ.ker.map (stabilizer R a).subtype = Q R a)
    [(((Ltilde R a).subgroupOf (stabilizer R a)).map κ).Normal]
    [IsSimpleGroup (((Ltilde R a).subgroupOf (stabilizer R a)).map κ)]
    (hna : ¬ IsMulCommutative (((Ltilde R a).subgroupOf (stabilizer R a)).map κ))
    (hc : centralizer (((Ltilde R a).subgroupOf (stabilizer R a)).map κ : Set J) = ⊥)
    (hfixed : X R a ⊓ centralizer (Ltilde R a : Set (FreeAmalgam R)) = ⊥) : N = ⊥ := by
  let S := stabilizer R a
  let P := N.subgroupOf S
  let C := centralizer (P : Set S)
  let : P.Normal := normal_subgroupOf_of_le_normalizer hn
  let : (C.map κ).Normal := Normal.map inferInstance κ hκ
  have hkC : κ.ker ≤ C := by
    intro x hx n hn
    apply Subtype.ext
    exact Q_le_centralizer_X R a (hk ▸ mem_map_of_mem S.subtype hx) n (hNX hn)
  have hEC : (Z R z).subgroupOf S ≤ C := by
    intro x hx n hn
    apply Subtype.ext
    exact (commutator_eq_bot_iff_le_centralizer.mp (Z_centralizes_Q R z hz)) hx n (hNQ hn)
  have hCne : C.map κ ≠ ⊥ := by
    intro he
    have hCk := (map_eq_bot_iff C).mp he
    apply hzQ
    intro x hx
    exact hk ▸ mem_map_of_mem S.subtype
      (hCk (hEC (show (⟨x,hzS hx⟩ : S) ∈ (Z R z).subgroupOf S from hx)))
  have hLC := simple_normal_le_of_normal_ne_bot_of_centralizer_eq_bot
    (((Ltilde R a).subgroupOf S).map κ) hna hc (C.map κ) hCne
  have hpre := comap_mono (f := κ) hLC
  rw [comap_map_eq,comap_map_eq,sup_of_le_left hkC] at hpre
  have hL : (Ltilde R a).subgroupOf S ≤ C := le_sup_left.trans hpre
  apply le_bot_iff.mp
  rw [←hfixed]
  refine le_inf hNX ?_
  intro n hn k hk
  have hnS : n ∈ S := (hNX.trans ((omegaCenter_le _).trans (fun _ hx => hx.1))) hn
  have hh := hL (show (⟨k,(map_subtype_le _) hk⟩ : S) ∈
      (Ltilde R a).subgroupOf S from hk) ⟨n,hnS⟩ hn
  exact (congrArg Subtype.val hh).symm
end CFSG.Quasithin.ChapterC.RankTwo.Sp4Four.CoreReconstruction
