module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Sp4Four.OuterReduction.HolomorphSpan
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction.SectionThree.LocalGroups
public import Theory.GroupTheory.Commutator.RelativeGeneration

/-!
# The first bad-star reduction on the actual two-edge neighborhood

The source star at alpha is generated by original-vertex conjugates of
the characteristic beta-star. It lies in the original vertex stabilizer
and is normalized there. If its residual commutator escapes Z_alpha,
relative normal generation finds a bad conjugate of the original fixed
seed: the attached central omega conjugates already lie in Z_alpha.
The two literal conjugating elements give adjacent vertices alpha--gamma
and delta--gamma and place the selected seed in U_delta.

Source: MS93 (3.4), first paragraph, p.868. The later choice of a critical
endpoint and its two nonnormalizations still requires (2.1)(vii) and the
source (3.3) comparison; neither conclusion is asserted here.
-/

public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.BinaryMS.MS93
namespace CFSG.Quasithin.ChapterC.RankTwo.Sp4Four
variable {M : Type*} [Group M] [Finite M] (R : Subgroup M)

noncomputable def sourceStarAlpha (Y : Subgroup R) : Subgroup (FreeAmalgam R) :=
  ⨆ g : Mbar R, ((starSpan R Y).map (embedS R)).map
    (MulAut.conj (g : FreeAmalgam R)).toMonoidHom

omit [Finite M] in
/-- Eliminate the source star by bounding each original-vertex conjugate. -/
theorem sourceStarAlpha_le_iff (Y : Subgroup R) (K : Subgroup (FreeAmalgam R)) :
    sourceStarAlpha R Y ≤ K ↔ ∀ g : Mbar R,
      ((starSpan R Y).map (embedS R)).map
        (MulAut.conj (g : FreeAmalgam R)).toMonoidHom ≤ K :=
  iSup_le_iff

omit [Finite M] in
private theorem starBeta_le_Mbar (Y : Subgroup R) :
    (starSpan R Y).map (embedS R) ≤ Mbar R := by
  rw [←embedM_comp_subtype,←map_map]
  exact map_le_range _ _

private theorem starBeta_graph_formula (Y : Subgroup R) :
    (starSpan R Y).map (embedS R) =
      (⨆ h : Hbar R, (Y.map (embedS R)).map (MulAut.conj (h : FreeAmalgam R)).toMonoidHom) ⊔
        Z R (beta R) := by
  simpa only [map_map,embedM_comp_subtype] using starSpan_map_graph R Y

omit [Finite M] in
theorem sourceStarAlpha_normalized (Y : Subgroup R) :
    stabilizer R (alpha R) ≤ normalizer (sourceStarAlpha R Y : Set (FreeAmalgam R)) := by
  rw [alpha,stabilizer_m_base]
  exact le_normalizer_iSup_conjugates _ _

omit [Finite M] in
theorem sourceStarAlpha_le_stabilizer (Y : Subgroup R) :
    sourceStarAlpha R Y ≤ stabilizer R (alpha R) := by
  rw [alpha,stabilizer_m_base]
  exact iSup_conjugates_le_of_le_normalizer _ _ _ (starBeta_le_Mbar R Y)
    (Mbar R).le_normalizer

omit [Finite M] in
private theorem beta_seed_le_alpha : Z R (beta R) ≤ Z R (alpha R) := by
  change edgeOmega R (beta R) ≤ ⨆ b, ⨆ (_ : Adjacent R (alpha R) b), edgeOmega R b
  exact le_iSup_of_le (beta R) (le_iSup_of_le (base_adjacent R) le_rfl)

omit [Finite M] in
private theorem omega_conjugate_le_alpha (g : Mbar R) :
    (Z R (beta R)).map (MulAut.conj (g : FreeAmalgam R)).toMonoidHom ≤ Z R (alpha R) := by
  have hg : (g : FreeAmalgam R) ∈ stabilizer R (alpha R) := by
    simpa only [alpha,stabilizer_m_base] using g.property
  have he := mem_normalizer_iff_map_conj_eq.mp (Z_normalized R (alpha R) hg)
  exact (map_mono (beta_seed_le_alpha R)).trans_eq he

/-- A failure of the star commutator bound already occurs on one literal
transported fixed seed, rather than on its central omega attachment. -/
theorem exists_bad_transported_seed (Y : Subgroup R)
    (hbad : ¬ ⁅sourceStarAlpha R Y,Ltilde R (alpha R)⁆ ≤ Z R (alpha R)) :
    ∃ g : Mbar R, ∃ h : Hbar R,
      ¬ ⁅((Y.map (embedS R)).map (MulAut.conj (h : FreeAmalgam R)).toMonoidHom).map
          (MulAut.conj (g : FreeAmalgam R)).toMonoidHom,
          Ltilde R (alpha R)⁆ ≤ Z R (alpha R) := by
  classical
  by_contra! hall
  apply hbad
  have hM : stabilizer R (alpha R) = Mbar R := stabilizer_m_base R
  have hZn : Mbar R ≤ normalizer (Z R (alpha R) : Set (FreeAmalgam R)) :=
    hM ▸ Z_normalized R (alpha R)
  have hstarM : (⨆ g : Mbar R, ((starSpan R Y).map (embedS R)).map
      (MulAut.conj (g : FreeAmalgam R)).toMonoidHom) ≤ Mbar R := by
    change sourceStarAlpha R Y ≤ Mbar R
    exact (sourceStarAlpha_le_stabilizer R Y).trans hM.le
  apply commutator_iSup_le_of_relative_normal (Mbar R) _ _ _ hZn
  · intro g
    exact (le_iSup (fun g : Mbar R => ((starSpan R Y).map (embedS R)).map (MulAut.conj (g : FreeAmalgam R)).toMonoidHom) g).trans hstarM
  · intro g
    rw [starBeta_graph_formula,Subgroup.map_sup,Subgroup.map_iSup]
    apply commutator_sup_le_of_relative_normal (Mbar R) _ _ _ _ hZn
    · apply iSup_le
      intro h
      have hs : ((Y.map (embedS R)).map (MulAut.conj (h : FreeAmalgam R)).toMonoidHom) ≤
          (starSpan R Y).map (embedS R) := by
        rw [starBeta_graph_formula]
        exact (le_iSup (fun h : Hbar R => (Y.map (embedS R)).map (MulAut.conj (h : FreeAmalgam R)).toMonoidHom) h).trans le_sup_left
      exact (map_mono hs).trans ((le_iSup (fun g : Mbar R => ((starSpan R Y).map (embedS R)).map (MulAut.conj (g : FreeAmalgam R)).toMonoidHom) g).trans
        hstarM)
    · exact (omega_conjugate_le_alpha R g).trans ((Z_le_stabilizer R (alpha R)).trans hM.le)
    · apply commutator_iSup_le_of_relative_normal (Mbar R) _ _ _ hZn
      · intro h
        have hs : ((Y.map (embedS R)).map (MulAut.conj (h : FreeAmalgam R)).toMonoidHom) ≤
            (starSpan R Y).map (embedS R) := by
          rw [starBeta_graph_formula]
          exact (le_iSup (fun h : Hbar R => (Y.map (embedS R)).map (MulAut.conj (h : FreeAmalgam R)).toMonoidHom) h).trans le_sup_left
        exact (map_mono hs).trans ((le_iSup (fun g : Mbar R => ((starSpan R Y).map (embedS R)).map (MulAut.conj (g : FreeAmalgam R)).toMonoidHom) g).trans
          hstarM)
      · exact hall g
    · exact (commutator_mono (omega_conjugate_le_alpha R g) le_rfl).trans
        (le_normalizer_iff_commutator_le_left.mp
          ((Ltilde_le_stabilizer (R := R) _).trans (Z_normalized R _)))

omit [Finite M] in
theorem transported_seed_edges (g : Mbar R) (h : Hbar R) :
    Adjacent R (alpha R) (act R (g : FreeAmalgam R)⁻¹ (beta R)) ∧
    Adjacent R (act R (g : FreeAmalgam R)⁻¹ (act R (h : FreeAmalgam R)⁻¹ (alpha R)))
      (act R (g : FreeAmalgam R)⁻¹ (beta R)) := by
  have hg : (g : FreeAmalgam R) ∈ stabilizer R (alpha R) := by
    simpa only [alpha,stabilizer_m_base] using g.property
  have hh : (h : FreeAmalgam R) ∈ stabilizer R (beta R) := by
    simpa only [beta,stabilizer_h_base] using h.property
  have hga : act R (g : FreeAmalgam R)⁻¹ (alpha R) = alpha R :=
    (stabilizer R (alpha R)).inv_mem hg
  have hhb : act R (h : FreeAmalgam R)⁻¹ (beta R) = beta R :=
    (stabilizer R (beta R)).inv_mem hh
  constructor
  · simpa only [hga] using
      (adjacent_act_iff R (g : FreeAmalgam R)⁻¹ (alpha R) (beta R)).mpr (base_adjacent R)
  · apply (adjacent_act_iff R (g : FreeAmalgam R)⁻¹ _ _).mpr
    simpa only [hhb] using
      (adjacent_act_iff R (h : FreeAmalgam R)⁻¹ (alpha R) (beta R)).mpr (base_adjacent R)

omit [Finite M] in
theorem transported_seed_le_U (Y : Subgroup R) (hY : Y.map (embedS R) ≤ U R (alpha R))
    (g : Mbar R) (h : Hbar R) :
    ((Y.map (embedS R)).map (MulAut.conj (h : FreeAmalgam R)).toMonoidHom).map
      (MulAut.conj (g : FreeAmalgam R)).toMonoidHom ≤
      U R (act R (g : FreeAmalgam R)⁻¹ (act R (h : FreeAmalgam R)⁻¹ (alpha R))) := by
  rw [U_act,U_act,inv_inv,inv_inv]
  exact map_mono (map_mono hY)


/-- The first reduction in (3.4), with the actual two-edge transport and
moving-layer containment retained for the subsequent critical comparison. -/
theorem exists_bad_seed_on_neighbor_pair (Y : Subgroup R)
    (hY : Y.map (embedS R) ≤ U R (alpha R))
    (hbad : ¬ ⁅sourceStarAlpha R Y,Ltilde R (alpha R)⁆ ≤ Z R (alpha R)) :
    ∃ g : Mbar R, ∃ h : Hbar R,
      Adjacent R (alpha R) (act R (g : FreeAmalgam R)⁻¹ (beta R)) ∧
      Adjacent R (act R (g : FreeAmalgam R)⁻¹ (act R (h : FreeAmalgam R)⁻¹ (alpha R)))
        (act R (g : FreeAmalgam R)⁻¹ (beta R)) ∧
      ((Y.map (embedS R)).map (MulAut.conj (h : FreeAmalgam R)).toMonoidHom).map
        (MulAut.conj (g : FreeAmalgam R)).toMonoidHom ≤
        U R (act R (g : FreeAmalgam R)⁻¹ (act R (h : FreeAmalgam R)⁻¹ (alpha R))) ∧
      ¬ ⁅((Y.map (embedS R)).map (MulAut.conj (h : FreeAmalgam R)).toMonoidHom).map
          (MulAut.conj (g : FreeAmalgam R)).toMonoidHom,
          Ltilde R (alpha R)⁆ ≤ Z R (alpha R) := by
  obtain ⟨g,h,hbad⟩ := exists_bad_transported_seed R Y hbad
  obtain ⟨hag,hdg⟩ := transported_seed_edges R g h
  exact ⟨g,h,hag,hdg,transported_seed_le_U R Y hY g h,hbad⟩

end CFSG.Quasithin.ChapterC.RankTwo.Sp4Four
