module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Sp4Four.OuterReduction.CharacteristicCut
public import Theory.GroupTheory.Commutator.ConjugateGeneration

/-!
# The characteristic star span is the literal holomorph orbit span

Conjugation by a holomorph element acts on the embedded radical by an
intrinsic automorphism; conversely, every intrinsic automorphism occurs as
such conjugation. Therefore the characteristic span used for minimality is
exactly the subgroup generated by the actual holomorph conjugates of the
fixed seed, together with the graph's original central omega layer.

Source: MS93 (3.4), p.868. This identifies the two constructions of the
source star without asserting its later geometric commutator bounds.
-/

public section

open Subgroup Stellmacher.PushingUp.AmalgamGraph
open CFSG.Quasithin.ChapterC.BinaryMS.MS93
namespace CFSG.Quasithin.ChapterC.RankTwo.Sp4Four
variable {M : Type*} [Group M] (R : Subgroup M)

private theorem embedS_aut_conj (f : MulAut R) (r : R) :
    embedS R (f r) = embedH R (SemidirectProduct.inr f) * embedS R r *
      (embedH R (SemidirectProduct.inr f))⁻¹ := by
  have h := congrArg (embedH R) (SemidirectProduct.inl_aut f r)
  have hcomp (s : R) : embedH R (SemidirectProduct.inl s) = embedS R s :=
    DFunLike.congr_fun (embedH_comp_inl R) s
  simpa only [MonoidHom.id_apply, map_mul, map_inv, hcomp] using h

private theorem embedS_holomorph_conj (h : Holomorph R) (r : R) :
    embedS R ((h.right.trans (MulAut.conj h.left)) r) =
      embedH R h * embedS R r * (embedH R h)⁻¹ := by
  have hh : embedH R h = embedS R h.left * embedH R (SemidirectProduct.inr h.right) := by
    conv_lhs => rw [←SemidirectProduct.inl_left_mul_inr_right h]
    rw [map_mul]
    exact congrArg (· * embedH R (SemidirectProduct.inr h.right))
      (DFunLike.congr_fun (embedH_comp_inl R) h.left)
  change embedS R (h.left * h.right r * h.left⁻¹) = _
  rw [map_mul,map_mul,map_inv,embedS_aut_conj,hh]
  group

theorem automorphismSpan_map_embedS (Y : Subgroup R) :
    (automorphismSpan Y).map (embedS R) =
      ⨆ h : Hbar R, (Y.map (embedS R)).map (MulAut.conj (h : FreeAmalgam R)).toMonoidHom := by
  let N := ⨆ h : Hbar R, (Y.map (embedS R)).map
    (MulAut.conj (h : FreeAmalgam R)).toMonoidHom
  apply le_antisymm
  · apply map_le_iff_le_comap.mpr
    apply (automorphismSpan_le_iff Y _).mpr
    intro f
    rintro _ ⟨r,hr,rfl⟩
    change embedS R (f r) ∈ N
    rw [embedS_aut_conj]
    apply (le_iSup (fun h : Hbar R => (Y.map (embedS R)).map
      (MulAut.conj (h : FreeAmalgam R)).toMonoidHom)
      ⟨embedH R (SemidirectProduct.inr f),⟨_,rfl⟩⟩)
    exact mem_map_of_mem _ (mem_map_of_mem _ hr)
  · apply iSup_le
    rintro ⟨h,⟨h,rfl⟩⟩
    rintro _ ⟨_,⟨r,hr,rfl⟩,rfl⟩
    change embedH R h * embedS R r * (embedH R h)⁻¹ ∈ _
    rw [←embedS_holomorph_conj]
    exact mem_map_of_mem _ ((map_le_automorphismSpan Y _)
      (mem_map_of_mem _ hr))

theorem starSpan_map_graph [Finite M] (Y : Subgroup R) :
    ((starSpan R Y).map R.subtype).map (embedM R) =
      (⨆ h : Hbar R, (Y.map (embedS R)).map (MulAut.conj (h : FreeAmalgam R)).toMonoidHom) ⊔
        Z R (beta R) := by
  rw [starSpan_map_subtype,Subgroup.map_sup,map_map,embedM_comp_subtype,
    automorphismSpan_map_embedS]
  congr 1
  rw [Z,if_neg (by simp [beta,color,hVertex] : ¬ color R (beta R) = false),edgeOmega,Q_beta,
    omegaCenter_map R (embedM R) (embedM_injective R)]

end CFSG.Quasithin.ChapterC.RankTwo.Sp4Four
