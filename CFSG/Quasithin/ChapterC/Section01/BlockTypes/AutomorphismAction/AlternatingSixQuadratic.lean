module
public import CFSG.Quasithin.ChapterC.Section01.BlockTypes.AutomorphismAction.AlternatingSixQuotient
public import Theory.Representation.BinaryOffender.Defs

/-!
# Quadraticity on the actual alternating-six block quotient

An abelian subgroup A of the local join acts quadratically on U(L)/C_U(L)
whenever U(L) normalizes A. The displacement b(u)u⁻¹ lies in A, so A
centralizes it. The marked module isomorphism and the literal conjugation
formula then give the quadratic identity in the six-letter natural module.

This is used for A=Wᵈ, where W is generated by Ω₁Z(T); elementary abelianness
and local normality supply the hypotheses without identifying W with U(L)
or with the chosen Chapter 12 module.
Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, 3.3.31,
printed p.602, the exclusion of the first-four-letter four-group.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterC.AlternatingSixBlockAction
variable {G : Type*} [Group G] {T : Sylow 2 G} {L : Subgroup G}
  (hTL : (T : Subgroup G) ≤ normalizer (L : Set G))
  {ρ : Actor →* MulAut (Multiplicative Vector)} (m : BlockModuleModel L ρ)
  (hρ : ∀ g v, (ρ g v).toAdd =
    BinaryPermutation.naturalRepresentation (Fin 6) g v.toAdd)

/-- A normal abelian actor has quadratic action on a module subgroup
that normalizes it, on the literal block quotient. -/
theorem joinPermutation_isQuadratic_of_normalizes (A : Subgroup G)
    (hA : IsMulCommutative A)
    (hUA : (blockU L).map L.subtype ≤ normalizer (A : Set G)) :
    Representation.BinaryOffender.IsQuadratic (BinaryPermutation.naturalRepresentation (Fin 6))
      ((A.subgroupOf (L ⊔ (T : Subgroup G))).map (joinPermutation hTL m hρ)) := by
  let := hA
  rintro _ ⟨a, ha, rfl⟩ _ ⟨b, hb, rfl⟩ v
  obtain ⟨u, hu⟩ := m.moduleIso.surjective.comp (QuotientGroup.mk'_surjective (blockFixed L))
    (Multiplicative.ofAdd v)
  dsimp only [Function.comp_apply] at hu
  let f : blockU L →* Multiplicative Vector :=
    m.moduleIso.toMonoidHom.comp (QuotientGroup.mk' (blockFixed L))
  let w : blockU L := MulAut.characteristic (blockU L) (joinAutomorphisms hTL b) u * u⁻¹
  have hwA : (w.val : G) ∈ A := by
    change ((MulAut.characteristic (blockU L) (joinAutomorphisms hTL b) u : L) : G) *
      (u.val : G)⁻¹ ∈ A
    rw [joinAutomorphisms_blockU_coe]
    have hc := (mem_normalizer_iff.mp (hUA (mem_map_of_mem L.subtype u.property))
      ((b : G)⁻¹)).mp (A.inv_mem hb)
    simpa only [mul_assoc, Subgroup.subtype_apply] using A.mul_mem hb hc
  have haw : MulAut.characteristic (blockU L) (joinAutomorphisms hTL a) w = w := by
    apply Subtype.ext
    apply Subtype.ext
    rw [joinAutomorphisms_blockU_coe]
    have hc : (a : G) * (w.val : G) = (w.val : G) * (a : G) :=
      congrArg Subtype.val (IsMulCommutative.is_comm.comm (⟨a,ha⟩ : A) ⟨w.val,hwA⟩)
    rw [hc,mul_inv_cancel_right]
  have hw : (f w).toAdd =
      BinaryPermutation.naturalRepresentation (Fin 6) (joinPermutation hTL m hρ b) v - v := by
    change (f (MulAut.characteristic (blockU L) (joinAutomorphisms hTL b) u * u⁻¹)).toAdd = _
    rw [map_mul,map_inv,toAdd_mul,toAdd_inv]
    rw [← sub_eq_add_neg]
    change (m.moduleIso (QuotientGroup.mk' (blockFixed L)
      (MulAut.characteristic (blockU L) (joinAutomorphisms hTL b) u))).toAdd -
      (m.moduleIso (QuotientGroup.mk' (blockFixed L) u)).toAdd = _
    rw [← joinPermutation_module hTL m hρ b u,hu]
    rfl
  rw [← hw]
  have he := joinPermutation_module hTL m hρ a w
  rw [haw] at he
  exact he
end CFSG.Quasithin.ChapterC.AlternatingSixBlockAction
