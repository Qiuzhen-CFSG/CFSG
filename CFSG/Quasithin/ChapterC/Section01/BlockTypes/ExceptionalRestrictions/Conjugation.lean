module
public import CFSG.Quasithin.ChapterC.Section01.BlockTypes.Basic
public import Theory.GroupTheory.PResidual.SubnormalCoreAction
public import Theory.ElementaryAbelian.VectorSpace
public import Theory.Representation.FirstCohomologyDuality.Indecomposable
public import Mathlib.RepresentationTheory.Irreducible

/-!
# Conjugation and central covers for short groups

The actual U and U/C_U(L) carry binary representations of L/O₂(L).
The subgroup interval in C.1.7 proves irreducibility of the latter, and
p-perfect commutator idempotence makes the quotient projection a central
cover. These are the bridges needed to apply I.1.6 to C.1.22 (pp.123,129).
The commutator proof reuses the argument of Chapter 13's BlockQuotient.
-/

@[expose] public section
open Subgroup Representation Representation.OneCohomology
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.ChapterC.ExceptionalRestrictions
variable {L : Type*} [Group L]

/-- Two-perfection makes the original U generated by its L-commutators. -/
theorem short_commutator (h : IsShort L) : ⁅blockU L, (⊤ : Subgroup L)⁆ = blockU L := by
  let := h.finite
  exact commutator_isPPerfect_idempotent ⊤ (pCore 2 L)
    (h.twoPerfect.of_surjective (topEquiv (G := L)).symm.toMonoidHom
      (topEquiv (G := L)).symm.surjective) pCore_isPGroup le_normalizer_of_normal

/-- Conjugation on the original U, descended through the actual two-core. -/
def uAut (h : IsShort L) : (L ⧸ pCore 2 L) →* MulAut (blockU L) :=
  QuotientGroup.lift _ MulAut.conjNormal (by
    intro g hg
    apply MulEquiv.ext
    intro u
    apply Subtype.ext
    change g * (u : L) * g⁻¹ = u
    rw [← mem_centralizer_iff.mp (h.core_centralizes_blockU hg) u u.property,
      mul_inv_cancel_right])

section Binary
variable [IsElementaryAbelian 2 (blockU L)]

/-- The original block commutator, as a binary representation. -/
def uRepresentation (h : IsShort L) :
    Representation (ZMod 2) (L ⧸ pCore 2 L) (Additive (blockU L)) where
  toFun g := (uAut h g).toMonoidHom.toAdditive.toZModLinearMap 2
  map_one' := by apply LinearMap.ext; intro v; change Additive.ofMul (uAut h 1 v.toMul) = v; rw [map_one]; rfl
  map_mul' g j := by
    apply LinearMap.ext
    intro v
    change Additive.ofMul (uAut h (g * j) v.toMul) = _
    rw [map_mul]
    rfl

/-- The binary action retains the literal conjugation formula. -/
theorem uRepresentation_apply (h : IsShort L) (g : L) (v : Additive (blockU L)) :
    ((uRepresentation h (QuotientGroup.mk' (pCore 2 L) g) v).toMul : L) =
      g * (v.toMul : L) * g⁻¹ := rfl

/-- The original fixed subgroup gives precisely the globally fixed vectors. -/
theorem uRepresentation_fixed (h : IsShort L) (v : Additive (blockU L)) :
    v ∈ fixed (uRepresentation h) ↔ v.toMul ∈ blockFixed L := by
  constructor
  · intro hv
    change (v.toMul : L) ∈ center L
    rw [mem_center_iff]
    intro g
    have he := congrArg (fun w : Additive (blockU L) => (w.toMul : L))
      (hv (QuotientGroup.mk' (pCore 2 L) g))
    rw [uRepresentation_apply] at he
    exact mul_inv_eq_iff_eq_mul.mp he
  · intro hv g
    obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective (pCore 2 L) g
    apply Additive.toMul.injective
    apply Subtype.ext
    change (v.toMul : L) ∈ center L at hv
    rw [uRepresentation_apply, mem_center_iff.mp hv g, mul_inv_cancel_right]

/-- Put a binary subspace back into its original ambient group. -/
def ambientSpace (S : Submodule (ZMod 2) (Additive (blockU L))) : Subgroup L :=
  S.toAddSubgroup.toSubgroup'.map (blockU L).subtype

theorem mem_ambientSpace (S : Submodule (ZMod 2) (Additive (blockU L)))
    (v : Additive (blockU L)) : (v.toMul : L) ∈ ambientSpace S ↔ v ∈ S := by
  constructor
  · rintro ⟨w, hw, he⟩
    have hh : w = v.toMul := Subtype.ext he
    subst w
    exact hw
  · intro hv
    exact ⟨v.toMul, hv, rfl⟩

theorem ambientSpace_normal (h : IsShort L)
    (S : Submodule (ZMod 2) (Additive (blockU L)))
    (hs : ∀ g v, v ∈ S → uRepresentation h g v ∈ S) : (ambientSpace S).Normal := by
  constructor
  rintro x ⟨v, hv, rfl⟩ g
  exact ⟨(uRepresentation h (QuotientGroup.mk' (pCore 2 L) g) (Additive.ofMul v)).toMul,
    hs (QuotientGroup.mk' (pCore 2 L) g) (Additive.ofMul v) hv, uRepresentation_apply h g _⟩

/-- Commutator generation holds for the literal binary action. -/
theorem uRepresentation_moved (h : IsShort L) : Coinvariants.ker (uRepresentation h) = ⊤ := by
  let S := Coinvariants.ker (uRepresentation h)
  have hc : ⁅(⊤ : Subgroup L), blockU L⁆ ≤ ambientSpace S := by
    apply commutator_le.mpr
    intro g _ u hu
    let v : Additive (blockU L) := Additive.ofMul ⟨u, hu⟩
    have hv : uRepresentation h (QuotientGroup.mk' (pCore 2 L) g) v - v ∈ S :=
      Coinvariants.sub_mem_ker _ _
    refine ⟨(uRepresentation h (QuotientGroup.mk' (pCore 2 L) g) v - v).toMul, hv, ?_⟩
    change ((uRepresentation h (QuotientGroup.mk' (pCore 2 L) g) v).toMul : L) / u = _
    rw [div_eq_mul_inv, uRepresentation_apply]
    rfl
  rw [commutator_comm, short_commutator h] at hc
  apply top_unique
  intro v _
  exact (mem_ambientSpace S v).mp (hc v.toMul.property)

variable [IsElementaryAbelian 2 (BlockModule L)]

/-- The binary form of the canonical action on U/C_U(L). -/
noncomputable def moduleRepresentation (h : IsShort L) :
    Representation (ZMod 2) (L ⧸ pCore 2 L) (Additive (BlockModule L)) where
  toFun g := (h.exists_quotient_moduleAction.choose g).toMonoidHom.toAdditive.toZModLinearMap 2
  map_one' := by
    apply LinearMap.ext
    intro v
    change Additive.ofMul (h.exists_quotient_moduleAction.choose 1 v.toMul) = v
    rw [map_one]
    rfl
  map_mul' g j := by
    apply LinearMap.ext
    intro v
    change Additive.ofMul (h.exists_quotient_moduleAction.choose (g * j) v.toMul) = _
    rw [map_mul]
    rfl

/-- The projection is the original quotient homomorphism written additively. -/
def moduleProjection : Additive (blockU L) →ₗ[ZMod 2] Additive (BlockModule L) :=
  (QuotientGroup.mk' (blockFixed L)).toAdditive.toZModLinearMap 2

theorem moduleProjection_surjective : Function.Surjective (moduleProjection (L := L)) :=
  fun v => QuotientGroup.mk'_surjective (blockFixed L) v.toMul

/-- Every action square commutes on the original representatives. -/
theorem moduleProjection_equivariant (h : IsShort L) (g : L ⧸ pCore 2 L)
    (v : Additive (blockU L)) :
    moduleProjection (uRepresentation h g v) = moduleRepresentation h g (moduleProjection v) := by
  obtain ⟨g, rfl⟩ := QuotientGroup.mk'_surjective (pCore 2 L) g
  exact congrArg Additive.ofMul (h.exists_quotient_moduleAction.choose_spec g v.toMul).symm

/-- The central quotient map is an actual intertwining map. -/
noncomputable def projection (h : IsShort L) :
    (uRepresentation h).IntertwiningMap (moduleRepresentation h) :=
  ⟨moduleProjection, fun g => LinearMap.ext (moduleProjection_equivariant h g)⟩

/-- The short-group hypotheses make the central projection a covering module. -/
theorem projection_isCover (h : IsShort L) : IsCover (projection h) := by
  refine ⟨moduleProjection_surjective, ?_, uRepresentation_moved h⟩
  intro v hv
  apply (uRepresentation_fixed h v).mpr
  exact (QuotientGroup.eq_one_iff _).mp hv

/-- The subgroup interval in C.1.7 gives irreducibility of the actual quotient. -/
theorem moduleRepresentation_irreducible (h : IsShort L) :
    IsIrreducible (moduleRepresentation h) := by
  let := h.module_nontrivial
  refine { exists_pair_ne := ⟨⊥, ⊤, ?_⟩, eq_bot_or_eq_top := ?_ }
  · intro he
    have hh := congrArg Subrepresentation.toSubmodule he
    exact bot_ne_top hh
  · intro W
    let S := W.toSubmodule.comap (moduleProjection (L := L))
    have hs : ∀ g v, v ∈ S → uRepresentation h g v ∈ S := by
      intro g v hv
      change moduleProjection (uRepresentation h g v) ∈ W
      rw [moduleProjection_equivariant]
      exact W.apply_mem_toSubmodule g hv
    have hl : blockU L ⊓ center L ≤ ambientSpace S := by
      intro u hu
      apply (mem_ambientSpace S (Additive.ofMul ⟨u, hu.1⟩)).mpr
      change moduleProjection (Additive.ofMul ⟨u, hu.1⟩) ∈ W
      have he : moduleProjection (Additive.ofMul ⟨u, hu.1⟩) = 0 :=
        (QuotientGroup.eq_one_iff _).mpr hu.2
      rw [he]
      exact W.toSubmodule.zero_mem
    rcases h.irreducible.2 (ambientSpace S) (ambientSpace_normal h S hs) hl
      (map_subtype_le _) with he | he
    · left
      apply Subrepresentation.toSubmodule_injective
      apply le_bot_iff.mp
      intro w hw
      obtain ⟨v, rfl⟩ := moduleProjection_surjective w
      have hv : (v.toMul : L) ∈ ambientSpace S := (mem_ambientSpace S v).mpr hw
      rw [he] at hv
      exact (QuotientGroup.eq_one_iff _).mpr hv.2
    · right
      apply Subrepresentation.toSubmodule_injective
      apply top_unique
      intro w _
      obtain ⟨v, rfl⟩ := moduleProjection_surjective w
      exact (mem_ambientSpace S v).mp (by rw [he]; exact v.toMul.property)
end Binary
end CFSG.Quasithin.ChapterC.ExceptionalRestrictions
