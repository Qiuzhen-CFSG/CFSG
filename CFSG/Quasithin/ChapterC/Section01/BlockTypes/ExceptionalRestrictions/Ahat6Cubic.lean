module
public import CFSG.Quasithin.ChapterC.Section01.BlockTypes.ExceptionalRestrictions.Conjugation
public import Theory.Representation.BinaryOffender.CentralSectionSplitting

/-!
# The central cubic relation on an exceptional triple-cover block

A nonidentity central actor fixes exactly the globally fixed vectors, by the
irreducible subgroup interval and faithfulness. Its norm has globally fixed
image and therefore kills every commutator. Since [U,L]=U, the norm vanishes
on the original U. This is the field-recovery step of C.1.22, printed p.129.

The proof is adapted from the checked Chapter 13 covered-six
`FieldModel.CubicNorm`, at the earlier Chapter C boundary. No hexacode or
representation-recognition conclusion is used here.
-/

@[expose] public section
open Subgroup Representation Representation.OneCohomology
open Representation.BinaryOffender
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.ChapterC.ExceptionalRestrictions
variable {K : Type*} [Group K] (h : IsExceptionalAhat6Block K)
variable [IsElementaryAbelian 2 (blockU K)]

/-- The source centralizer equality makes the original quotient action faithful. -/
theorem uRepresentation_faithful : Function.Injective (uRepresentation h.1) := by
  apply (uRepresentation h.1).ker_eq_bot_iff.mp
  apply le_bot_iff.mp
  intro g hg
  obtain ⟨k, rfl⟩ := QuotientGroup.mk'_surjective (pCore 2 K) g
  apply (QuotientGroup.eq_one_iff _).mpr
  rw [← h.centralizer]
  intro u hu
  have he := congrArg (fun f : Module.End (ZMod 2) (Additive (blockU K)) =>
    ((f (Additive.ofMul ⟨u, hu⟩)).toMul : K)) hg
  change ((uRepresentation h.1 (QuotientGroup.mk' (pCore 2 K) k)
    (Additive.ofMul ⟨u, hu⟩)).toMul : K) = u at he
  rw [uRepresentation_apply] at he
  exact (mul_inv_eq_iff_eq_mul.mp he).symm

/-- The original six-space is generated by its actual quotient-action commutators. -/
theorem binaryAction_fully_moved : subspaceCommutator (uRepresentation h.1) ⊤ ⊤ = ⊤ := by
  let S := subspaceCommutator (uRepresentation h.1) ⊤ ⊤
  have hc : ⁅(⊤ : Subgroup K), blockU K⁆ ≤ ambientSpace S := by
    apply commutator_le.mpr
    intro k _ u hu
    let v : Additive (blockU K) := Additive.ofMul ⟨u, hu⟩
    have hv : uRepresentation h.1 (QuotientGroup.mk' (pCore 2 K) k) v - v ∈ S :=
      Submodule.subset_span ⟨_, mem_top _, v, Submodule.mem_top, rfl⟩
    refine ⟨(uRepresentation h.1 (QuotientGroup.mk' (pCore 2 K) k) v - v).toMul, hv, ?_⟩
    change ((uRepresentation h.1 (QuotientGroup.mk' (pCore 2 K) k) v).toMul : K) / u = _
    rw [div_eq_mul_inv, uRepresentation_apply]
    rfl
  rw [commutator_comm, short_commutator h.1] at hc
  apply top_unique
  intro v _
  exact (mem_ambientSpace S v).mp (hc v.toMul.property)

private theorem fixed_of_center (v : Additive (blockU K))
    (hv : (v.toMul : K) ∈ center K) (g : K ⧸ pCore 2 K) : uRepresentation h.1 g v = v := by
  obtain ⟨k, rfl⟩ := QuotientGroup.mk'_surjective (pCore 2 K) g
  apply Additive.toMul.injective
  apply Subtype.ext
  rw [uRepresentation_apply, (mem_center_iff.mp hv k), mul_inv_cancel_right]

/-- A nonidentity central actor has exactly the global fixed vectors. This uses
only irreducibility of U/C_U(K), not irreducibility of U. -/
theorem central_fixed_is_global (z : K ⧸ pCore 2 K)
    (hz : z ∈ center (K ⧸ pCore 2 K)) (hne : z ≠ 1)
    (v : Additive (blockU K)) (hv : uRepresentation h.1 z v = v) :
    v ∈ fixedSpace (uRepresentation h.1) ⊤ := by
  let ρ := uRepresentation h.1
  have hcomm (g : K ⧸ pCore 2 K) (w : Additive (blockU K)) :
      ρ z (ρ g w) = ρ g (ρ z w) := by
    change (ρ z * ρ g) w = (ρ g * ρ z) w
    rw [← map_mul, ← map_mul, (mem_center_iff.mp hz g).symm]
  let S := (ρ z - 1).ker
  have hs : ∀ g w, w ∈ S → ρ g w ∈ S := by
    intro g w hw
    change ρ z w - w = 0 at hw
    change ρ z (ρ g w) - ρ g w = 0
    rw [hcomm, sub_eq_zero.mp hw, sub_self]
  have hlow : blockU K ⊓ center K ≤ ambientSpace S := by
    intro u hu
    apply (mem_ambientSpace S (Additive.ofMul ⟨u, hu.1⟩)).mpr
    change ρ z (Additive.ofMul ⟨u, hu.1⟩) - Additive.ofMul ⟨u, hu.1⟩ = 0
    rw [fixed_of_center h (Additive.ofMul ⟨u, hu.1⟩) hu.2, sub_self]
  have he : ambientSpace S = blockU K ⊓ center K := by
    rcases h.1.irreducible.2 (ambientSpace S) (ambientSpace_normal h.1 S hs)
      hlow (map_subtype_le _) with he | he
    · exact he
    · exfalso
      apply hne
      apply uRepresentation_faithful h
      rw [map_one]
      apply LinearMap.ext
      intro w
      have hw : w ∈ S := (mem_ambientSpace S w).mp (by rw [he]; exact w.toMul.property)
      exact sub_eq_zero.mp hw
  have hvc : (v.toMul : K) ∈ center K := by
    have hm : (v.toMul : K) ∈ ambientSpace S := by
      apply (mem_ambientSpace S v).mpr
      change ρ z v - v = 0
      exact sub_eq_zero.mpr hv
    rw [he] at hm
    exact hm.2
  intro g
  exact fixed_of_center h v hvc g

/-- The cubic norm vanishes on the original U. No fixed-space vanishing is assumed. -/
theorem central_cubic_quadratic (z : K ⧸ pCore 2 K)
    (hz : z ∈ center (K ⧸ pCore 2 K)) (hne : z ≠ 1) (hz3 : z ^ 3 = 1) :
    uRepresentation h.1 z ^ 2 + uRepresentation h.1 z + 1 = 0 := by
  let ρ := uRepresentation h.1
  have hc (v : Additive (blockU K)) : ρ z (ρ z (ρ z v)) = v := by
    have hp : ρ z ^ 3 = 1 := by rw [← map_pow, hz3, map_one]
    simpa only [pow_succ, pow_zero, one_mul, Module.End.mul_apply,
      Module.End.one_apply] using LinearMap.congr_fun hp v
  have hn (v : Additive (blockU K)) : centralCubicNorm ρ z v ∈ fixedSpace ρ ⊤ := by
    apply central_fixed_is_global h z hz hne
    rw [centralCubicNorm_apply, map_add, map_add, hc]
    abel
  have hzero := centralCubicNorm_eq_zero_on_commutator ρ ⊤ ⊤
    (binaryAction_fully_moved h) z (fun g _ => (mem_center_iff.mp hz g).symm)
    (fun v _ => hn v)
  apply LinearMap.ext
  intro v
  exact hzero v Submodule.mem_top

end CFSG.Quasithin.ChapterC.ExceptionalRestrictions
