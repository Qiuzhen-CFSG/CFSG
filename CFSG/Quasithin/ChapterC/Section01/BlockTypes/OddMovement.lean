module
public import Theory.GroupTheory.PResidual.SimpleQuotientCommutator
public import CFSG.Quasithin.ChapterC.Section01.BlockTypes.Basic
public import Theory.SpecificGroups.SL2.ResidualTwoExtension
public import Theory.SpecificGroups.SL2.FieldAutomorphismCore

/-!
# Odd subgroups generate an even natural block by commutators

A nonidentity odd subgroup survives the actual two-core quotient. The
centerless simple SL₂ quotient is generated by its commutators with that
image, and two-perfection lifts generation through the two-core.
This uses the two-residual condition, not a two-core identity.

Source: Aschbacher–Smith 10.2.3(4), printed p.747. The application to the
original Hall intersection is in MovingHall/NaturalTerminal/CommonComponent.
-/

public section
open Subgroup Theory.GroupTheory
open scoped MatrixGroups
namespace CFSG.Quasithin.ChapterC
variable {G : Type*} [Group G] [Finite G]
private instance oddMovementPrimeTwo : Fact (Nat.Prime 2) := ⟨Nat.prime_two⟩

/-- Every nonidentity odd subgroup moves the entire natural block. -/
theorem IsL2EvenBlock.odd_commutator_eq (K A : Subgroup G) {n : ℕ}
    (hK : IsL2EvenBlock K n) (hAK : A ≤ K)
    (hodd : Odd (Nat.card A)) (hne : A ≠ ⊥) : ⁅K,A⁆ = K := by
  obtain ⟨hn,hs,F,_,_,hF,_,ρ,⟨m⟩,_⟩ := hK
  let := Fintype.ofFinite F
  let : CharP F 2 := charP_of_card_eq_prime_pow
    (by simpa only [Nat.card_eq_fintype_card] using hF)
  have hlarge : 3 < Nat.card F := by
    have hp := Nat.pow_le_pow_right (by decide : 0 < 2) (show 2 ≤ n by omega)
    norm_num at hp
    omega
  let : IsQuasisimple SL(2,F) :=
    Theory.SpecificGroups.SL2.ResidualTwoExtension.quasisimple_of_equiv hlarge (MulEquiv.refl _)
  let : IsSimpleGroup SL(2,F) := by
    let : IsSimpleGroup (SL(2,F) ⧸ center SL(2,F)) := IsQuasisimple.simple
    exact ((QuotientGroup.quotientMulEquivOfEq
      (Atlas.RankOneFieldAutomorphisms.sl_center_eq_bot (F := F))).trans
        QuotientGroup.quotientBot).symm.isSimpleGroup
  let R := A.subgroupOf K
  let q := m.quotientIso.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 K))
  have hq : Function.Surjective q := m.quotientIso.surjective.comp (QuotientGroup.mk'_surjective _)
  have hk : q.ker = pCore 2 K := by
    rw [MonoidHom.ker_comp_of_injective _ _ m.quotientIso.injective,QuotientGroup.ker_mk']
  have hdis : Disjoint R (pCore 2 K) := by
    apply disjoint_of_coprime_natCard
    obtain ⟨r,hr⟩ := (pCore_isPGroup (p := 2) (G := K)).exists_card_eq
    rw [hr, Nat.card_congr (subgroupOfEquivOfLe hAK).toEquiv]
    exact hodd.coprime_two_right.pow_right r
  have hR : ¬ R ≤ q.ker := by
    intro he
    have hr : R = ⊥ := disjoint_self.mp (hdis.mono_right (hk ▸ he))
    apply hne
    have hh := congrArg (map K.subtype) hr
    simpa only [R,map_subgroupOf_eq_of_le hAK,Subgroup.map_bot] using hh
  have hh := commutator_top_eq_of_pPerfect_simple_quotient hs.twoPerfect q hq
    (hk ▸ (pCore_isPGroup (p := 2) (G := K)))
    (Atlas.RankOneFieldAutomorphisms.sl_center_eq_bot (F := F)) R hR
  have hm := congrArg (map K.subtype) hh
  simpa only [map_commutator,R,map_subgroupOf_eq_of_le hAK,
    ←MonoidHom.range_eq_map,range_subtype] using hm
end CFSG.Quasithin.ChapterC
