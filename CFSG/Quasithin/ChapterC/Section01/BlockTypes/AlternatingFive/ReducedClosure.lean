module
public import CFSG.Quasithin.ChapterC.Section01.BlockTypes.AlternatingFive.NormalClosure
public import CFSG.Quasithin.ChapterC.Section05.NormalizerControl.NoncubicSource.FullSpan
public import Theory.GroupTheory.ReducedNormal.Equiv

/-!
# Reducedness of the original contained A₅ layer closure

The natural A₅ block supplies a noncentral vector fixed by the normalizing
Sylow. Its orbit generates the whole layer, so the contained-layer normal
closure is generated by Sylow-fixed vectors. The existing B.2.14 source
argument makes its literal centralizer quotient have trivial two-core.
No characteristic-two assumption on the ambient group is needed.

Source: Aschbacher–Smith 10.2.1, printed p.743, applying B.2.14.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterC
variable {G : Type*} [Group G] [Finite G]

/-- The actual normal closure belongs to R₂ of its ambient group. -/
theorem IsAlternatingBlock.normalClosure_layer_reduced (L : Subgroup G) (h : IsAlternatingBlock L 5)
    (T : Sylow 2 G) (hTL : (T : Subgroup G) ≤ normalizer (L : Set G))
    (hU : (blockU L).map L.subtype ≤ pCore 2 G) :
    IsPReduced 2 (normalClosure ((blockU L).map L.subtype : Set G)) := by
  let U := (blockU L).map L.subtype
  let W := normalClosure (U : Set G)
  have hs := h.normalClosure_layer_split L T hTL hU
  have he : conjugateSpanBy U (⊤ : Subgroup G) = W := by
    apply le_antisymm
    · exact conjugateSpanBy_le le_normalClosure (by rw [normalizer_eq_top])
    · have hn : (conjugateSpanBy U (⊤ : Subgroup G)).Normal := by
        apply normalizer_eq_top_iff.mp
        exact top_unique (le_normalizer_conjugateSpanBy U ⊤)
      exact normalClosure_le_normal (le_conjugateSpanBy _ _)
  have h3 : ¬ IsAlternatingBlock L 3 := by
    intro h3
    obtain ⟨e⟩ := h.2.2.quotient_iso
    obtain ⟨e3⟩ := h3.2.2.quotient_iso
    have hc := Nat.card_congr (e.symm.trans e3).toEquiv
    rw [nat_card_alternatingGroup,nat_card_alternatingGroup] at hc
    norm_num at hc
  have hr := Section05.NormalizerControl.noncubic_full_span_reduced
    L (T:Subgroup G) (Or.inr (Or.inr h)) h3
    (hU.trans (pCore_isPGroup.le_sylow_of_normal T)) T.isPGroup' hTL
    ⊤ le_top (T.subtype le_top) (map_subgroupOf_eq_of_le le_top)
    (by change conjugateSpanBy U ⊤ ≤ centralizer (U:Set G)
        rw [he]
        exact hs.2.1.trans (centralizer_le hU))
  have hr' := hr.map_equiv (topEquiv : (⊤:Subgroup G) ≃* G)
  change IsPReduced 2 (((conjugateSpanBy U ⊤).subgroupOf ⊤).map (⊤:Subgroup G).subtype) at hr'
  rwa [map_subgroupOf_eq_of_le le_top,he] at hr'

end CFSG.Quasithin.ChapterC
