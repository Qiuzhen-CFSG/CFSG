module
public import CFSG.Quasithin.ChapterC.Section01.BlockTypes.AlternatingFive.LayerClosureCharacteristic

/-!
# Short overgroups normally generated by an alternating-five block

Suppose a perfect constrained group with quasisimple two-core quotient is
normally generated by an A₅ block normalized by a full Sylow two-subgroup.
If the block's natural layer lies in the ambient two-core, its normal closure
is elementary abelian, centralizes that core, and equals the ambient block
layer. Every proper normal subgroup of this closure is central, so the
ambient group satisfies all five short-group clauses of C.1.7.

The original Chapter 4 nonblock configuration supplies these hypotheses
when its seed is the A₅ block. This avoids whole-core MS classification
for the original Chapter 5 Baumann consumer.
Source: Aschbacher--Smith C.1.7, C.1.13(c), pp.123--125;
the elementary normal-closure argument also appears in 10.2.1, p.743.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterC
variable {G : Type*} [Group G] [Finite G]

/-- The actual layer closure gives every short-group clause in the containing group. -/
theorem IsAlternatingBlock.short_of_normalClosure_eq_top
    (L : Subgroup G) (h : IsAlternatingBlock L 5)
    (T : Sylow 2 G) (hTL : (T : Subgroup G) ≤ normalizer (L : Set G))
    (hU : (blockU L).map L.subtype ≤ pCore 2 G)
    (hgen : normalClosure (L : Set G) = ⊤)
    (hf : generalizedFitting G = pCore 2 G)
    [Group.IsPerfect G] [IsQuasisimple (G ⧸ pCore 2 G)] : IsShort G := by
  let U := (blockU L).map L.subtype
  let W := normalClosure (U : Set G)
  have hs := h.normalClosure_layer_split L T hTL hU
  have he : W = blockU G := h.normalClosure_layer_eq_blockU L T hTL hU hgen
  have hperfect : IsPPerfect 2 G := by
    intro N hN hp
    let := hN
    have ht : Subsingleton (G ⧸ N) := by
      by_contra! hn
      exact Group.IsPerfect.not_isNilpotent (G ⧸ N) hp.isNilpotent
    apply eq_top_iff.mpr
    intro x _
    exact (QuotientGroup.eq_one_iff x).mp (Subsingleton.elim _ _)
  refine ⟨inferInstance,hperfect,hf,he ▸ hs.2.2.1,he ▸ hs.2.1,Or.inl inferInstance,?_,?_⟩
  · apply lt_of_le_of_ne inf_le_left
    intro hz
    have hWZ : W ≤ center G := he.le.trans (hz.ge.trans inf_le_right)
    have hUZ : blockU L ≤ center L := by
      intro x hx
      apply mem_center_iff.mpr
      intro l
      apply Subtype.ext
      exact mem_center_iff.mp (hWZ (le_normalClosure (mem_map_of_mem L.subtype hx))) (l : G)
    exact h.2.1.irreducible.1.ne (inf_eq_left.mpr hUZ)
  · intro N hn hZN hNW
    let := hn
    rcases h.layer_closure_normal_eq_or_central L hgen hs.2.2.2.1 N
      (hNW.trans he.ge) with hN | hz
    · exact Or.inr (hN.trans he)
    · exact Or.inl (le_antisymm (le_inf hNW hz) hZN)
end CFSG.Quasithin.ChapterC

