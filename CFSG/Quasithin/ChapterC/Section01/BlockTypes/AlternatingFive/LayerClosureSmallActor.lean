module
public import CFSG.Quasithin.ChapterC.Section01.BlockTypes.AlternatingFive.LayerClosureRatio
public import CFSG.Quasithin.ChapterC.Section01.BlockTypes.AlternatingFive.LayerClosureChief

/-!
# An A₅ actor forces the original layer to be normal

When the whole faithful actor is A₅, the original A₅ image is all of it
by equality of orders. Thus the whole ambient group is the product of L
with the centralizer of W. Consequently [W,G]=[W,L]≤U(L). Since W is
generated by its ambient commutators, W=U(L).

Source: the rank-one elimination in Aschbacher–Smith 10.2.1, p.743.
-/
public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterC
variable {G : Type*} [Group G] [Finite G]
theorem IsAlternatingBlock.normalClosure_layer_eq_of_alternatingFive_actor (L : Subgroup G) (h : IsAlternatingBlock L 5)
    (T : Sylow 2 G) (hTL : (T:Subgroup G) ≤ normalizer (L:Set G))
    (hU : (blockU L).map L.subtype ≤ pCore 2 G)
    (ha : Nonempty ((G ⧸ centralizer
      (normalClosure ((blockU L).map L.subtype:Set G):Set G)) ≃* alternatingGroup (Fin 5))) :
    normalClosure ((blockU L).map L.subtype:Set G) = (blockU L).map L.subtype := by
  let U := (blockU L).map L.subtype
  let W := normalClosure (U:Set G)
  let C := centralizer (W:Set G)
  let q := QuotientGroup.mk' C
  have hs := h.normalClosure_layer_split L T hTL hU
  obtain ⟨eL⟩ := h.layer_split_quotient_image L W le_normalClosure hs.2.2.2.1 q
    (QuotientGroup.ker_mk' _)
  obtain ⟨ea⟩ := ha
  have him : L.map q = ⊤ := eq_top_of_card_eq _
    ((Nat.card_congr eL.toEquiv).trans (Nat.card_congr ea.toEquiv).symm)
  have hsup : C ⊔ L = ⊤ := by
    have hh := congrArg (Subgroup.comap q) him
    simpa only [comap_map_eq,QuotientGroup.ker_mk',comap_top,sup_comm,q] using hh
  have hgen := h.layer_closure_commutator_top L
  change ⁅W,⊤⁆ = W at hgen
  have he := commutator_eq_of_centralizing_sup hsup (le_refl C)
    (show L ≤ normalizer (W:Set G) from le_normalizer_of_normal)
  have hle : ⁅W,L⁆ ≤ U := by
    have hh := commutator_eq_of_centralizing_sup
      ((sup_comm _ _).trans hs.2.2.2.1.symm)
      (show W ⊓ centralizer (L:Set G) ≤ centralizer (L:Set G) from inf_le_right)
      ((map_subtype_le (blockU L)).trans L.le_normalizer)
    rw [commutator_comm W L,←hh,commutator_comm L U]
    exact le_normalizer_iff_commutator_le_left.mp
      (L.le_normalizer.trans (normalizer_le_normalizer_characteristic_image L (blockU L)))
  change W = U
  exact le_antisymm (hgen ▸ he ▸ hle) le_normalClosure
end CFSG.Quasithin.ChapterC
