module
public import CFSG.Quasithin.ChapterC.Section01.BlockTypes.AlternatingFive.LayerClosureChief
public import Theory.GroupTheory.Commutator.NormalClosure

/-!
# The A₅ layer closure is characteristic in its overcomponent

The projective module split gives [O₂(G),L]≤U(L). If L normally generates
G, normal closure gives [O₂(G),G]≤W. Conversely W is generated by its
commutators with G and lies in O₂(G), so W=[O₂(G),G]=blockU(G).
This identifies the previously chosen closure with a characteristic subgroup.

Source: the normal closure W in Aschbacher–Smith 10.2.1, p.743.
-/
public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterC
variable {G : Type*} [Group G] [Finite G]
theorem IsAlternatingBlock.normalClosure_layer_eq_blockU (L : Subgroup G) (h : IsAlternatingBlock L 5)
    (T : Sylow 2 G) (hTL : (T:Subgroup G) ≤ normalizer (L:Set G))
    (hU : (blockU L).map L.subtype ≤ pCore 2 G)
    (hgen : normalClosure (L:Set G) = ⊤) :
    normalClosure ((blockU L).map L.subtype:Set G) = blockU G := by
  let U := (blockU L).map L.subtype
  let W := normalClosure (U:Set G)
  have hPL : pCore 2 G ≤ normalizer (L:Set G) :=
    (pCore_isPGroup.le_sylow_of_normal T).trans hTL
  have hc : ⁅L,pCore 2 G⁆ ≤ L.pCoreIn 2 := by
    apply le_pCoreIn_of_normalizes
      (pCore_isPGroup.to_le (le_normalizer_iff_commutator_le_right.mp
        (show L ≤ normalizer (pCore 2 G:Set G) from le_normalizer_of_normal)))
      (le_normalizer_iff_commutator_le_left.mp hPL)
      (normalizer_commutator_ge_left L (pCore 2 G))
  have hs := h.two_subgroup_eq_module_sup_centralizer pCore_isPGroup
    le_normalizer_of_normal hU hc
  have hPU : ⁅pCore 2 G,L⁆ ≤ U := by
    have hh := commutator_eq_of_centralizing_sup ((sup_comm _ _).trans hs.symm)
      (show pCore 2 G ⊓ centralizer (L:Set G) ≤ centralizer (L:Set G) from inf_le_right)
      ((map_subtype_le (blockU L)).trans L.le_normalizer)
    rw [commutator_comm (pCore 2 G) L,←hh,commutator_comm L U]
    exact le_normalizer_iff_commutator_le_left.mp
      (L.le_normalizer.trans (normalizer_le_normalizer_characteristic_image L (blockU L)))
  apply le_antisymm
  · have hh := h.layer_closure_commutator_top L
    change ⁅W,⊤⁆ = W at hh
    change W ≤ blockU G
    rw [←hh]
    exact commutator_mono (normalClosure_le_normal hU) le_rfl
  · change ⁅pCore 2 G,⊤⁆ ≤ W
    rw [←hgen]
    exact commutator_normalClosure_le_of_normal (pCore 2 G) L W (hPU.trans le_normalClosure)
end CFSG.Quasithin.ChapterC
