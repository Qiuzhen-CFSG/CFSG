module
public import CFSG.Quasithin.ChapterC.Section01.BlockTypes.AlternatingFive.NormalClosure
public import Theory.GroupTheory.Commutator.CentralizingComplement
public import Theory.GroupTheory.CComponent.Basic
/-!
# The unique noncentral layer of an alternating-five closure

An A₅ block normally generates any C-component containing it, since every
proper subnormal subgroup of a C-component is solvable. For the split normal
closure of its natural layer, block irreducibility then says that every proper
ambient normal subgroup is central. The closure is also generated by its
commutators with the ambient group.

Source: Aschbacher--Smith 10.2.1, printed p.743.
-/
public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterC
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
theorem IsAlternatingBlock.layer_closure_normal_eq_or_central (L : Subgroup G) (hL : IsAlternatingBlock L 5)
    (hgen : normalClosure (L:Set G)=⊤)
    (hs : normalClosure ((blockU L).map L.subtype:Set G) =
      (blockU L).map L.subtype ⊔
        (normalClosure ((blockU L).map L.subtype:Set G) ⊓ centralizer (L:Set G)))
    (N : Subgroup G) [N.Normal]
    (hNW : N ≤ normalClosure ((blockU L).map L.subtype:Set G)) :
    N = normalClosure ((blockU L).map L.subtype:Set G) ∨ N ≤ center G := by
  let U := (blockU L).map L.subtype
  let W := normalClosure (U:Set G)
  have hUL : U ≤ L := map_subtype_le _
  have hLU : L ≤ normalizer (U:Set G) :=
    L.le_normalizer.trans (normalizer_le_normalizer_characteristic_image L (blockU L))
  have hz : blockU L ⊓ center L = ⊥ := by
    rw [←blockFixed_map,hL.blockFixed_eq_bot,Subgroup.map_bot]
  have hNU : (N ⊓ U).subgroupOf L ≤ blockU L := by
    rintro x ⟨_,y,hy,he⟩
    exact (Subtype.ext he : y=x) ▸ hy
  have hnU : ((N ⊓ U).subgroupOf L).Normal :=
    normal_subgroupOf_of_le_normalizer
      ((le_inf le_normalizer_of_normal hLU).trans inf_normalizer_le_normalizer_inf)
  rcases hL.2.1.irreducible.2 ((N ⊓ U).subgroupOf L) hnU
    (by rw [hz]; exact bot_le) hNU with hbot | hfull
  · right
    have hNUbot : N ⊓ U = ⊥ := by
      have hh := congrArg (Subgroup.map L.subtype) hbot
      rwa [map_subgroupOf_eq_of_le (inf_le_right.trans hUL),hz,Subgroup.map_bot] at hh
    have hWU : ⁅W,L⁆ ≤ U := by
      have hh := commutator_eq_of_centralizing_sup
        ((sup_comm _ _).trans hs.symm) (show W ⊓ centralizer (L:Set G) ≤ centralizer (L:Set G) from inf_le_right)
        (hUL.trans L.le_normalizer)
      rw [commutator_comm W L,←hh,commutator_comm L U]
      exact le_normalizer_iff_commutator_le_left.mp hLU
    have hNL : N ≤ centralizer (L:Set G) := by
      apply commutator_eq_bot_iff_le_centralizer.mp
      exact bot_unique ((le_inf (commutator_le_left N L)
        ((commutator_mono hNW le_rfl).trans hWU)).trans hNUbot.le)
    have hGN : (⊤:Subgroup G) ≤ centralizer (N:Set G) := by
      rw [←hgen]
      exact normalClosure_le_normal (le_centralizer_iff.mp hNL)
    have hNG := le_centralizer_iff.mp hGN
    simpa only [coe_top,centralizer_univ] using hNG
  · left
    have hUN : U ≤ N := by
      have hh := map_mono (f:=L.subtype) hfull.symm.le
      exact hh.trans ((map_subgroupOf_eq_of_le (inf_le_right.trans hUL)).le.trans inf_le_left)
    exact le_antisymm hNW (normalClosure_le_normal hUN)

theorem IsAlternatingBlock.normalClosure_eq_top_in_cComponent {X I : Subgroup G} (hIX : I ≤ X)
    (hI : (I.subgroupOf X).IsCComponent) (K : Subgroup I)
    (hK : IsAlternatingBlock K 5) : normalClosure (K:Set I)=⊤ := by
  let e : I.subgroupOf X ≃* I := subgroupOfEquivOfLe hIX
  have htop : (⊤:Subgroup I).IsCComponent := by
    have hh : (⊤:Subgroup (I.subgroupOf X)).IsCComponent := by
      simpa using hI.subgroupOf (le_refl _)
    simpa only [map_top_of_surjective e.toMonoidHom e.surjective] using hh.map_equiv e
  by_contra hn
  have hN : Group.IsSolvable (normalClosure (K:Set I)) := by
    let N := normalClosure (K:Set I)
    have hproper : N.subgroupOf (⊤:Subgroup I) ≠ ⊤ := by
      intro he
      exact hn (top_unique (subgroupOf_eq_top.mp he))
    have hh := htop.isSolvable_of_subnormal_lt_top
      (show (N.subgroupOf (⊤:Subgroup I)).IsSubnormal from
        (inferInstance : (N.subgroupOf (⊤:Subgroup I)).Normal).isSubnormal) hproper
    let := hh
    exact Group.isSolvable_of_surjective
      (f := (subgroupOfEquivOfLe (show N≤⊤ from le_top)).toMonoidHom)
      (subgroupOfEquivOfLe (show N≤⊤ from le_top)).surjective
  let := hN
  let : Group.IsSolvable K := Group.isSolvable_of_isSolvable_injective
    (f := inclusion (show K≤normalClosure (K:Set I) from le_normalClosure))
    (inclusion_injective _)
  obtain ⟨ek⟩ := hK.2.2.quotient_iso
  have ha : Group.IsSolvable (alternatingGroup (Fin 5)) :=
    Group.isSolvable_of_surjective (f:=ek.toMonoidHom) ek.surjective
  let : Group.IsPerfect (alternatingGroup (Fin 5)) :=
    ⟨commutator_alternatingGroup_eq_top (by simp)⟩
  exact Group.IsPerfect.not_isSolvable (alternatingGroup (Fin 5)) ha

/-- The normal closure retains the commutator generation of the block layer. -/
theorem IsAlternatingBlock.layer_closure_commutator_top (L : Subgroup G)
    (hL : IsAlternatingBlock L 5) :
    let W := normalClosure ((blockU L).map L.subtype : Set G)
    ⁅W, (⊤ : Subgroup G)⁆ = W := by
  let U := (blockU L).map L.subtype
  let W := normalClosure (U:Set G)
  have hUL : ⁅U,L⁆ = U := by
    have hi := commutator_isPPerfect_idempotent L (pCoreIn 2 L)
      hL.2.1.twoPerfect (isPGroup_pCoreIn 2 L)
      (L.le_normalizer.trans (normalizer_le_normalizer_characteristic_image L (pCore 2 L)))
    simpa only [pCoreIn, U, blockU, map_commutator, ← MonoidHom.range_eq_map,
      range_subtype] using hi
  apply le_antisymm (commutator_le_left W ⊤)
  apply normalClosure_le_normal
  rw [←hUL]
  exact commutator_mono le_normalClosure le_top

end CFSG.Quasithin.ChapterC
