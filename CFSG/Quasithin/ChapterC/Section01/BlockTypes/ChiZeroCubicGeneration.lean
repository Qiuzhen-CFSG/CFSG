module
public import CFSG.Quasithin.ChapterC.Section01.BlockTypes.ChiZeroQuotient
public import CFSG.Quasithin.ChapterC.Section01.RankOne.ChiProduct.Rank
public import Theory.GroupTheory.PResidual.CubicGenerationModuloTwoCore
public import Theory.GroupTheory.PResidual.NormalSubgroup

/-!
# Cubic generation of the actual chi-zero blocks

Each chi-zero block is two-perfect and its quotient by the two-core is
simple. A cubic element survives this quotient. Thus its cubic closure
covers the simple quotient, and two-perfectness removes the remaining
two-group quotient. This is the generation step used after C.2.5 in the
weight-six centralizer argument, without assuming that a chi-zero block
is itself simple or that its two-core is trivial.

Source: Aschbacher--Smith, C.1.12, C.2.5 and 12.3.6, printed pp.124,145,809.
-/
public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterC
variable {A : Type*} [Group A] [Finite A]

/-- All three chi-zero block types are generated by their cubic elements. -/
theorem IsChiZeroBlock.cubic_generation (h : IsChiZeroBlock A) :
    closure {x : A | orderOf x = 3} = ⊤ := by
  have hchi : IsChiBlock A := h.chi
  have hp : IsPPerfect 2 A := by
    rcases h with ⟨n,hn⟩ | h | h
    · exact hn.2.1.twoPerfect
    · exact h.2.1.twoPerfect
    · exact h.2.1.twoPerfect
  let : IsSimpleGroup (A ⧸ pCore 2 A) := h.quotient_simple
  let C := closure {x : A | orderOf x = 3}
  let q := QuotientGroup.mk' (pCore 2 A)
  let : C.Normal := by
    apply normalizer_eq_top_iff.mp
    apply top_unique
    apply le_normalizer_closure_iff.mpr
    intro g _ x hx
    exact subset_closure ((MulAut.conj g).orderOf_eq x |>.trans hx)
  let : (C.map q).Normal := Subgroup.Normal.map inferInstance q (QuotientGroup.mk'_surjective _)
  obtain ⟨x,hx⟩ := exists_prime_orderOf_dvd_card' (G := A) 3
    (RankOne.ChiProduct.three_dvd_card_of_chi hchi)
  have hxn : x ∉ pCore 2 A := by
    intro hxcore
    have hc := (pCore_isPGroup (p := 2) (G := A)).orderOf_coprime
      (by decide : Nat.Coprime 2 3) (⟨x,hxcore⟩ : pCore 2 A)
    rw [←Subgroup.orderOf_coe,hx] at hc
    norm_num at hc
  have hmap : C.map q = ⊤ := by
    rcases (inferInstance : (C.map q).Normal).eq_bot_or_eq_top with hb | ht
    · have hm := mem_map_of_mem q (show x ∈ C from subset_closure hx)
      rw [hb,mem_bot] at hm
      exact (hxn ((QuotientGroup.eq_one_iff x).mp hm)).elim
    · exact ht
  have hsup : C ⊔ pCore 2 A = ⊤ := by
    have hh := congrArg (comap q) hmap
    simpa only [comap_map_eq,q,QuotientGroup.ker_mk',comap_top] using hh
  have hquot : IsPGroup 2 (A ⧸ C) :=
    isPGroup_quotient_of_sup_eq_top C (pCore 2 A) pCore_isPGroup hsup
  have hres : pResidual 2 A ≤ C := sInf_le ⟨inferInstance,hquot⟩
  rw [(pResidual_eq_top_iff 2 A).mpr hp] at hres
  exact top_unique hres

/-- Literal ambient transport, used by the source point-centralizer proof. -/
theorem IsChiZeroBlock.le_cubic_closure {G : Type*} [Group G] [Finite G]
    {B H : Subgroup G} (h : IsChiZeroBlock B) (hBH : B ≤ H) :
    B ≤ closure {x : G | x ∈ H ∧ orderOf x = 3} := by
  have he := congrArg (map B.subtype) h.cubic_generation
  rw [MonoidHom.map_closure,←MonoidHom.range_eq_map,range_subtype] at he
  rw [←he]
  apply Subgroup.closure_mono
  rintro x ⟨b,hb,rfl⟩
  exact ⟨hBH b.property,(B.orderOf_coe b).trans hb⟩

end CFSG.Quasithin.ChapterC
