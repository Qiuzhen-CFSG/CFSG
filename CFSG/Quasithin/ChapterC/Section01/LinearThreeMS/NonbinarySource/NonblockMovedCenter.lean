module
public import CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness.NonblockMSConstruction

/-!
# Promoting the natural moved center in the original nonblock configuration

Suppose the whole [Z(Q),K] is natural in the original 4.3.8 configuration.
The source W is a nonzero proper subgroup of this moved center, normalized
and generated by L. The established full-quotient marking puts L in a point
or line parabolic residual. A proper invariant additive subgroup of the
natural point module is fixed, contradicting [W,L]=W; hence L is the line
residual. The initial-layer centralizer argument then gives C_Q(K)=1.
Natural first-cohomology splitting identifies the entire center with its
moved subgroup, including at field four.

Thus the fourth row's positive-order fixed factor is excluded without its
disputed ambient-centrality clause. The final theorem transports a supplied
whole doubled-dual quotient by the very same change of basis and applies
the existing MSData constructor, retaining its literal Sylow inequalities.
No whole-section recognition or radical inequality is assumed proved here;
these remain the nonbinary classification obligations.

Source: Aschbacher--Smith original 4.3.8--10, pp.616--617, C.1.34(3)--(4),
pp.136--137, and C.4.7, p.153.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped MatrixGroups commutatorElement
namespace CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness.Nonblock.MovedCenter
open Chapter1.RadicalExclusions.ModelReduction.FullSieve.SourceInterface
open Matrix.PSL3.LinearThree
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  {c : SourceConfiguration T L}

private abbrev movedCenter (c : SourceConfiguration T L) : Subgroup G := ⁅U c,K c⁆

omit [Finite G] in
private theorem fullModule_moved : ⁅W c,L⁆ = W c := by
  have hs : conjugateSpanBy L (c.H ⊓ normalizer (L : Set G)) = L :=
    le_antisymm (conjugateSpanBy_le le_rfl inf_le_right) (le_conjugateSpanBy _ _)
  exact (show W c = ⁅W c,L⁆ from by simpa only [hs] using c.c28.module_commutator).symm


omit [Finite G] in
private theorem movedCenter_normalized : c.H ≤ normalizer (movedCenter c : Set G) := by
  have hz : c.H ≤ normalizer (U c : Set G) :=
    (core_normalized c).trans (normalizer_le_normalizer_characteristic_image (Q c) (center (Q c)))
  intro x hx
  apply mem_normalizer_iff_map_conj_eq.mpr
  change (⁅U c,K c⁆ : Subgroup G).map (MulAut.conj x).toMonoidHom = ⁅U c,K c⁆
  rw [map_commutator]
  exact congrArg₂ (fun B E : Subgroup G => ⁅B,E⁆)
    (mem_normalizer_iff_map_conj_eq.mp (hz hx))
    (mem_normalizer_iff_map_conj_eq.mp (c.normalizer_component.le hx))

private theorem fullModule_le_movedCenter (hf : generalizedFitting c.K = pCore 2 c.K) :
    W c ≤ movedCenter c := by
  rw [←fullModule_moved (c := c)]
  exact commutator_mono (fullModule_le_coreCenter hf) c.le_component

private theorem fullModule_lt_movedCenter (hf : generalizedFitting c.K = pCore 2 c.K) :
    W c < movedCenter c := by
  apply lt_of_le_of_ne (fullModule_le_movedCenter hf)
  intro he
  have hh : c.H ≤ normalizer (W c : Set G) := he ▸ movedCenter_normalized
  exact c.outside (((le_inf le_rfl hh).trans c.c28.module_normalizer).trans inf_le_right)

private theorem natural_moved_line {F : Type*} [Field F]
    (hf : generalizedFitting c.K = pCore 2 c.K)
    (e : (K c ⧸ pCore 2 (K c)) ≃* SL(3,F))
    (hm : HasSectionModel (K c) (movedCenter c) ⊥ (linearThreeActor e)
      (Representation.specialLinearNatural (k := F) 3))
    (hp : (L.subgroupOf (K c)).map (linearThreeActor e) = pointLocalSL F ∨
      (L.subgroupOf (K c)).map (linearThreeActor e) = lineLocalSL F) :
    (L.subgroupOf (K c)).map (linearThreeActor e) = lineLocalSL F := by
  rcases hp with hp | hp
  · exfalso
    rw [HasSectionModel,bot_subgroupOf] at hm
    obtain ⟨_,_,_,hn,a,ha⟩ := hm
    let := hn
    let E : movedCenter c ≃* Multiplicative (Fin 3 → F) :=
      QuotientGroup.quotientBot.symm.trans a
    let B := (((W c).subgroupOf (movedCenter c)).map E.toMonoidHom).toAddSubgroup'
    have hproper : B ≠ ⊤ := by
      intro ht
      apply (fullModule_lt_movedCenter hf).not_ge
      intro x hx
      have hh : (E ⟨x,hx⟩).toAdd ∈ B := ht ▸ trivial
      obtain ⟨w,hw,hew⟩ := hh
      have hwx : w = ⟨x,hx⟩ := E.injective hew
      change (w : G) ∈ W c at hw
      simpa only [hwx] using hw
    have hnW : L ≤ normalizer (W c : Set G) := by
      apply le_normalizer_iff_commutator_le_right.mpr
      rw [commutator_comm,fullModule_moved]
    have hinv : ∀ g ∈ pointLocalSL F, ∀ v ∈ B, g.val.mulVec v ∈ B := by
      intro g hg v hv
      obtain ⟨k,hk,rfl⟩ := hp.ge hg
      obtain ⟨u,hu,rfl⟩ := hv
      let w : movedCenter c := (movedCenter c).normalizerMonoidHom
        ⟨k,movedCenter_normalized ((map_subtype_le _) k.property)⟩ u
      have hw : (w : G) = k * (u : G) * (k : G)⁻¹ := normalizerMonoidHom_apply_apply_coe _ _ _
      have he : (E w).toAdd = (linearThreeActor e k).val.mulVec (E u).toAdd := ha k u w hw
      refine ⟨w,?_,Multiplicative.toAdd.injective he⟩
      change (w : G) ∈ W c
      rw [hw]
      exact (mem_normalizer_iff.mp (hnW hk) u).mp hu
    have hfixed := Representation.SL3ParabolicNatural.point_invariant_fixed B hproper hinv
    have hcomm : ⁅W c,L⁆ = ⊥ := by
      apply commutator_eq_bot_iff_le_centralizer.mpr
      intro w hw l hl
      let u : movedCenter c := ⟨w,fullModule_le_movedCenter hf hw⟩
      let k : K c := ⟨l,c.le_component hl⟩
      let u' : movedCenter c := (movedCenter c).normalizerMonoidHom
        ⟨k,movedCenter_normalized ((map_subtype_le _) k.property)⟩ u
      have hu' : (u' : G) = l*w*l⁻¹ := normalizerMonoidHom_apply_apply_coe _ _ _
      have he : (E u').toAdd = (linearThreeActor e k).val.mulVec (E u).toAdd := ha k u u' hu'
      have hfix := hfixed (linearThreeActor e k) (hp.le (mem_map_of_mem _ hl))
        (E u).toAdd (show (E u).toAdd ∈ B from ⟨u,hw,rfl⟩)
      have hue : u' = u := E.injective (Multiplicative.toAdd.injective (he.trans hfix))
      have hh : l*w*l⁻¹ = w := hu'.symm.trans (congrArg Subtype.val hue)
      exact mul_inv_eq_iff_eq_mul.mp hh
    exact c.c28.module_nontrivial ((fullModule_moved (c := c)).symm.trans hcomm)
  · exact hp

omit [Finite G] in
private theorem natural_reframe {F : Type*} [Field F]
    (a : (Fin 3 → F) ≃ₗ[F] (Fin 3 → F)) (g : SL(3,F)) (v : Fin 3 → F) :
    a (Representation.specialLinearNatural 3 g v) =
      Representation.specialLinearNatural 3 (Matrix.HigherLinear.SubspaceTransport.slConj a g) (a v) := by
  symm
  simpa only [Representation.specialLinearNatural_apply,LinearEquiv.symm_apply_apply,
    Matrix.SpecialLinearGroup.toLin'_apply,Matrix.toLin'_apply] using
    Matrix.HigherLinear.SubspaceTransport.slConj_apply a g (a v)

omit [Finite G] in
private theorem dual_reframe {F : Type*} [Field F]
    (a : (Fin 3 → F) ≃ₗ[F] (Fin 3 → F)) (g : SL(3,F))
    (v : Module.Dual F (Fin 3 → F)) :
    a.symm.dualMap ((Representation.specialLinearNatural (k := F) 3).dual g v) =
      (Representation.specialLinearNatural (k := F) 3).dual
        (Matrix.HigherLinear.SubspaceTransport.slConj a g) (a.symm.dualMap v) := by
  apply LinearMap.ext
  intro x
  change v ((Representation.specialLinearNatural 3 g⁻¹) (a.symm x)) =
    v (a.symm ((Representation.specialLinearNatural 3
      (Matrix.HigherLinear.SubspaceTransport.slConj a g)⁻¹) x))
  rw [←map_inv]
  apply congrArg v
  apply a.injective
  rw [a.apply_symm_apply]
  simpa only [a.apply_symm_apply] using natural_reframe a g⁻¹ (a.symm x)

/-- The original nonblock source promotes a natural moved center to its
whole center. Both parabolic placement and the vanishing fixed factor are
proved, with the same field and an explicit inner change of marking. -/
theorem exists_whole_natural_center {F : Type} [Field F] [Finite F] [CharP F 2]
    (D : Chapter12.Section02.ChosenModule T L V)
    (hf : generalizedFitting c.K = pCore 2 c.K)
    {n : ℕ} (hn : 1 < n) (hF : Nat.card F = 2^n)
    (e : (K c ⧸ pCore 2 (K c)) ≃* SL(3,F))
    (hm : HasSectionModel (K c) ⁅U c,K c⁆ ⊥ (linearThreeActor e)
      (Representation.specialLinearNatural (k := F) 3)) :
    ∃ a : (Fin 3 → F) ≃ₗ[F] (Fin 3 → F),
      let e' := e.trans (Matrix.HigherLinear.SubspaceTransport.slConj a)
      HasSectionModel (K c) (U c) ⊥ (linearThreeActor e')
        (Representation.specialLinearNatural (k := F) 3) ∧
      (L.subgroupOf (K c)).map (linearThreeActor e') = lineLocalSL F ∧
      Q c ⊓ centralizer (K c : Set G) = ⊥ := by
  obtain ⟨a,ha⟩ := nonblock_linearThree_local_frame D hf hn hF e
  let e' := e.trans (Matrix.HigherLinear.SubspaceTransport.slConj a)
  have hm' : HasSectionModel (K c) ⁅U c,K c⁆ ⊥ (linearThreeActor e')
      (Representation.specialLinearNatural (k := F) 3) :=
    hm.transport a.toAddEquiv (fun k v => natural_reframe a (linearThreeActor e k) v)
  have hline := natural_moved_line hf e' hm' ha
  have hz := ms_natural_center_of_moved_and_line c D hf n hn hF e' hm' hline.ge
  exact ⟨a,hz.2,hline,hz.1⟩

/-- A natural moved center already excludes the positive-order fixed factor
of C.1.34(4) in the original nonblock configuration. Ambient centrality is
not needed in this exclusion. -/
theorem fixed_factor_card_ne {F : Type} [Field F] [Finite F] [CharP F 2]
    (D : Chapter12.Section02.ChosenModule T L V)
    (hf : generalizedFitting c.K = pCore 2 c.K)
    {n : ℕ} (hn : 1 < n) (hF : Nat.card F = 2^n)
    (e : (K c ⧸ pCore 2 (K c)) ≃* SL(3,F))
    (hm : HasSectionModel (K c) ⁅U c,K c⁆ ⊥ (linearThreeActor e)
      (Representation.specialLinearNatural (k := F) 3)) :
    Nat.card (Q c ⊓ centralizer (K c : Set G) : Subgroup G) ≠ 2^(2*n) := by
  obtain ⟨a,_,_,hc⟩ := exists_whole_natural_center D hf hn hF e hm
  have hcard := card_eq_one.mpr hc
  have hpos : 1 < 2^(2*n) := one_lt_pow₀ (by decide) (by omega)
  omega

/-- Apply the promoted whole center and the same transported doubled-dual
quotient to the actual MSData constructor. Only the moved-center model,
whole quotient model and original Sylow inequalities remain as inputs. -/
theorem exists_msData_of_moved_sections
    (D : Chapter12.Section02.ChosenModule T L V)
    (hf : generalizedFitting c.K = pCore 2 c.K) (n : ℕ) (hn : 1 < n)
    (F : ChapterB.QuasisimpleSource.BinaryField) (hdegree : F.degree = n)
    (e : (K c ⧸ pCore 2 (K c)) ≃* SL(3,F.Carrier))
    (hm : HasSectionModel (K c) ⁅U c,K c⁆ ⊥ (linearThreeActor e)
      (Representation.specialLinearNatural (k := F.Carrier) 3))
    (hdual : HasSectionModel (K c) (Q c) (U c) (linearThreeActor e)
      ((Representation.specialLinearNatural (k := F.Carrier) 3).dual.prod
        (Representation.specialLinearNatural (k := F.Carrier) 3).dual))
    (hrad : ∀ P : Sylow 2 (K c ⊔ c.I.pCoreIn 2 : Subgroup G),
      c.I.pCoreIn 2 ≤ (P : Subgroup (K c ⊔ c.I.pCoreIn 2 : Subgroup G)).map
        (K c ⊔ c.I.pCoreIn 2 : Subgroup G).subtype →
      MSNotCentralizerCore (K c) (c.I.pCoreIn 2)
        ((P : Subgroup (K c ⊔ c.I.pCoreIn 2 : Subgroup G)).map
          (K c ⊔ c.I.pCoreIn 2 : Subgroup G).subtype)) :
    ∃ d : MSData c n, d.field = F ∧
      (L.subgroupOf (K c)).map (linearThreeActor d.model) = lineLocalSL d.field.Carrier ∧
      ((S c ⊓ L).subgroupOf (K c)).map (linearThreeActor d.model) = unipotentSL d.field.Carrier := by
  have hF : Nat.card F.Carrier = 2^n := F.card_eq.trans (congrArg (2^·) hdegree)
  obtain ⟨a,ha,hline,_⟩ := exists_whole_natural_center D hf hn hF e hm
  let e' := e.trans (Matrix.HigherLinear.SubspaceTransport.slConj a)
  have hdual' : HasSectionModel (K c) (Q c) (U c) (linearThreeActor e')
      ((Representation.specialLinearNatural (k := F.Carrier) 3).dual.prod
        (Representation.specialLinearNatural (k := F.Carrier) 3).dual) := by
    apply hdual.transport (a.symm.dualMap.toAddEquiv.prodCongr a.symm.dualMap.toAddEquiv)
    intro k v
    exact Prod.ext (dual_reframe a (linearThreeActor e k) v.1)
      (dual_reframe a (linearThreeActor e k) v.2)
  exact exists_msData_of_natural_center_sections D hf n hn F hdegree e' ha hdual'
    (Or.inr hline) hrad

end CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness.Nonblock.MovedCenter
