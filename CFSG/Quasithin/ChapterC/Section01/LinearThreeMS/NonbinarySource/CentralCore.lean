module
public import CFSG.Quasithin.ChapterC.Section01.LinearThreeMS.NonbinarySource.WholeCore

/-!
# Whole MS cores centralizing the original two-core

The MS commutator Q is generated by its commutators with K. If Q centralizes
O₂(KR), the proved MS3 exponent theorem places Q in Ω₁(Z(O₂(KR))). Commutator
generation then identifies it with the initial moved subgroup. Conversely,
that initial subgroup always centralizes O₂(KR), giving an exact criterion.

The marked initial classification consequently supplies natural or doubled
natural sections on the whole Q, over the original field and with the full
SL₃ quotient. Its K-fixed subgroup is trivial, and its join centralizer is
exactly O₂(KR). In particular, abelianity of O₂(KR) discharges the criterion.
Abelianity of Q alone is not used to assert centrality in O₂(KR).

These results supply a whole-core branch for the original nonblock consumer.
The noncentral-core sections and the Sylow radical inequalities of C.1.34
remain separate obligations. No whole-core classification is assumed.
Source: Aschbacher--Smith C.1.31--34, printed pp.135--137, and original
4.3.8--10, pp.616--617.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open scoped MatrixGroups IsMulCommutative
namespace CFSG.Quasithin.ChapterC.LinearThreeMS.NonbinarySource
open Chapter1.RadicalExclusions.ModelReduction.FullSieve.SourceInterface
variable {G : Type*} [Group G] [Finite G] {K R : Subgroup G}
variable {n : ℕ} {F : Type} [Field F] [Finite F]
variable (h : LinearThreeMSPair KnownSimple.IsKnownSimple K R n F) (hn : 1 < n)

include h hn

theorem msQ_idempotent : ⁅msQ K R,K⁆ = msQ K R := by
  apply commutator_isPPerfect_idempotent K ((K ⊔ R).pCoreIn 2)
    (component_twoPerfect h hn) (pCore_isPGroup.map (K ⊔ R).subtype)
  exact (le_sup_left : K ≤ K ⊔ R).trans
    ((K ⊔ R).le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image (K ⊔ R) (pCore 2 (K ⊔ R : Subgroup G))))

omit h hn [Finite G] [Finite F] in
theorem msQ_le_joinCore : msQ K R ≤ (K ⊔ R).pCoreIn 2 := by
  rw [← commutator_map_eq_msQ]
  exact map_mono (commutator_le_left _ _)

omit h hn [Finite G] [Finite F] in
theorem initialMoved_centralizes_joinCore :
    initialMoved K R ≤ centralizer ((K ⊔ R).pCoreIn 2 : Set G) := by
  intro x hx y hy
  have he : x ∈ Subgroup.omegaCenterIn ((K ⊔ R).pCoreIn 2) :=
    initialOmega_eq (K := K) (R := R) ▸ initialMoved_le_omega hx
  exact ((mem_omegaCenterIn_iff _ _).mp he).2.1 y hy

/-- Centrality in the original two-core makes the initial moved layer exhaust
all of msQ. Abelianity and exponent two are derived, not assumed. -/
theorem msQ_eq_initialMoved_of_central
    (hz : msQ K R ≤ centralizer ((K ⊔ R).pCoreIn 2 : Set G)) :
    msQ K R = initialMoved K R := by
  have hc : IsMulCommutative (msQ K R) :=
    le_centralizer_iff_isMulCommutative.mp (hz.trans (centralizer_le msQ_le_joinCore))
  let := abelian_msQ_elementary h hn hc
  have hOmega : msQ K R ≤ initialOmega K R := by
    rw [initialOmega_eq]
    intro x hx
    refine (mem_omegaCenterIn_iff _ _).mpr ⟨msQ_le_joinCore hx,hz hx,?_⟩
    exact elemPow_eq_one_of_isElementaryAbelian x hx
  apply le_antisymm _ initialMoved_le_msQ
  rw [← msQ_idempotent h hn]
  exact commutator_mono hOmega le_rfl

/-- Exact criterion for extending the initial module to the whole MS core. -/
theorem msQ_eq_initialMoved_iff :
    msQ K R = initialMoved K R ↔
      msQ K R ≤ centralizer ((K ⊔ R).pCoreIn 2 : Set G) := by
  constructor
  · intro he
    rw [he]
    exact initialMoved_centralizes_joinCore
  · exact msQ_eq_initialMoved_of_central h hn

/-- An abelian join core supplies the centrality criterion. -/
theorem msQ_eq_initialMoved_of_abelian_core
    (hc : IsMulCommutative ((K ⊔ R).pCoreIn 2)) :
    msQ K R = initialMoved K R :=
  msQ_eq_initialMoved_of_central h hn
    (msQ_le_joinCore.trans (le_centralizer_iff_isMulCommutative.mpr hc))

variable [CharP F 2]

/-- The whole core has no fixed component summand in the central-core branch. -/
theorem msQ_fixed_eq_bot_of_central
    (hz : msQ K R ≤ centralizer ((K ⊔ R).pCoreIn 2 : Set G)) :
    msQ K R ⊓ centralizer (K : Set G) = ⊥ := by
  rw [msQ_eq_initialMoved_of_central h hn hz]
  apply bot_unique
  exact (le_inf inf_le_left
    (le_inf (inf_le_left.trans initialMoved_le_omega) inf_le_right)).trans_eq
      (initialMoved_split h hn).2

/-- Complete whole-core section recognition under the explicit centrality
criterion, with the original field and one full SL₃ marking. -/
theorem msQ_section_models_of_central
    (hz : msQ K R ≤ centralizer ((K ⊔ R).pCoreIn 2 : Set G)) :
    ∃ e : (K ⧸ pCore 2 K) ≃* SL(3,F),
      HasSectionModel K (msQ K R) ⊥ (linearThreeActor e)
        (Representation.specialLinearNatural (k := F) 3) ∨
      HasSectionModel K (msQ K R) ⊥ (linearThreeActor e)
        ((Representation.specialLinearNatural (k := F) 3).prod
          (Representation.specialLinearNatural (k := F) 3)) := by
  rw [msQ_eq_initialMoved_of_central h hn hz]
  exact initialMoved_section_models h hn

/-- In particular an abelian join two-core gives whole natural or doubled
natural sections, rather than merely sections of its initial omega layer. -/
theorem msQ_section_models_of_abelian_core
    (hc : IsMulCommutative ((K ⊔ R).pCoreIn 2)) :
    ∃ e : (K ⧸ pCore 2 K) ≃* SL(3,F),
      HasSectionModel K (msQ K R) ⊥ (linearThreeActor e)
        (Representation.specialLinearNatural (k := F) 3) ∨
      HasSectionModel K (msQ K R) ⊥ (linearThreeActor e)
        ((Representation.specialLinearNatural (k := F) 3).prod
          (Representation.specialLinearNatural (k := F) 3)) := by
  rw [msQ_eq_initialMoved_of_abelian_core h hn hc]
  exact initialMoved_section_models h hn

/-- In the central-core branch, the whole-core action has precisely the
original two-core as its kernel. -/
theorem wholeCore_join_centralizer_eq_of_central
    (hz : msQ K R ≤ centralizer ((K ⊔ R).pCoreIn 2 : Set G)) :
    centralizer ((⁅pCore 2 (K ⊔ R : Subgroup G),K.subgroupOf (K ⊔ R)⁆ :
      Subgroup (K ⊔ R : Subgroup G)) : Set (K ⊔ R : Subgroup G)) = pCore 2 (K ⊔ R : Subgroup G) := by
  apply le_antisymm (wholeCore_join_centralizer_le h hn)
  intro x hx q hq
  apply Subtype.ext
  exact (hz ((commutator_map_eq_msQ (K := K) (R := R)) ▸
    mem_map_of_mem (K ⊔ R).subtype hq) x (mem_map_of_mem _ hx)).symm

end CFSG.Quasithin.ChapterC.LinearThreeMS.NonbinarySource
