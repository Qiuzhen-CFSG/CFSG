module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.AbelianCore
public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.MS93.Reduction

/-!
# Central doubled modules force the binary MS commutator core

In a genuine binary MS group, an elementary central module in O₂(J)
which is generated by component commutators and has order greater than eight
forces D = [O₂(J),L] to be abelian. Indeed the characteristic replacement
retains the component and this module. If D were nonabelian, the proved
MS93 common reduction identifies the moving part of its actual omega-center
with the natural module of order eight. The given module lies in that
moving part, a contradiction.

For a module of order 64, the existing abelian-core classification then
bounds |D| by 64, so containment gives equality. No later nonabelian-center
bound or distance-eight source premise is required.

Source: Aschbacher--Smith C.1.34 and the doubled-natural branch of C.1.37,
printed pp.136--143; MS93, Sections 3 and 4.1--4.3, printed pp.859--890.
-/

public section
namespace CFSG.Quasithin.ChapterC.BinaryMS
open Subgroup Stellmacher.PushingUp.AmalgamGraph
open scoped IsMulCommutative
open MS93
universe u
variable {J : Type u} [Group J] [Finite J] {κ : GroupClass.{u}} {L R : Subgroup J}

/-- A central moving elementary module larger than the source natural module
excludes the nonabelian commutator-core branch. -/
theorem Input.commutatorCore_abelian_of_central_module
    (h : Input κ L R) (V : Subgroup J) [IsElementaryAbelian 2 V]
    (hVN : V ≤ pCore 2 J) (hVC : V ≤ centralizer (pCore 2 J : Set J))
    (hVL : ⁅V,L⁆ = V) (hcard : 8 < Nat.card V) :
    IsMulCommutative (commutatorCore L) := by
  classical
  let _ := h.component_normal
  by_contra hD
  obtain ⟨s⟩ := MS93.exists_setup h hD
  obtain ⟨common⟩ := s.commonFacts hD
  have hVLe : V ≤ L := hVL ▸ commutator_le_right V L
  have hVM : V ≤ s.reduction.overgroup := hVLe.trans le_sup_left
  let V₀ := V.subgroupOf s.reduction.overgroup
  let R₀ := s.reduction.radical
  have hV₀ : V₀ ≤ omegaCenter (pCore 2 s.reduction.overgroup) := by
    intro v hv
    apply mem_omegaCenter_iff.mpr
    refine ⟨?_,?_,?_⟩
    · rw [s.reduction.core_eq h]
      exact hVN hv
    · apply Subtype.ext
      exact elemPow_eq_one_of_isElementaryAbelian (p := 2) (A := V) v.val hv
    · intro q hq
      apply Subtype.ext
      have hqJ : (q : J) ∈ pCore 2 J := by
        rw [s.reduction.core_eq h] at hq
        exact hq
      exact hVC hv q hqJ
  have hVZ : V₀.map (embedM R₀) ≤ Z R₀ (alpha R₀) := by
    rw [← common.X_eq_Z (alpha R₀) rfl]
    change V₀.map (embedM R₀) ≤ omegaCenter (Q R₀ (alpha R₀))
    rw [Q_alpha R₀ s.source.two_group s.source.core_le,
      omegaCenter_map _ _ (embedM_injective R₀)]
    exact map_mono hV₀
  have hcomm : ⁅V₀,L.subgroupOf s.reduction.overgroup⁆ = V₀ := by
    apply map_injective s.reduction.overgroup.subtype_injective
    rw [map_commutator, map_subgroupOf_eq_of_le hVM,
      map_subgroupOf_eq_of_le (show L ≤ s.reduction.overgroup from le_sup_left), hVL]
  have hVU : V₀.map (embedM R₀) ≤ U R₀ (alpha R₀) := by
    calc
      V₀.map (embedM R₀) =
          ⁅V₀.map (embedM R₀), (L.subgroupOf s.reduction.overgroup).map (embedM R₀)⁆ := by
        rw [← map_commutator, hcomm]
      _ = ⁅V₀.map (embedM R₀), Ltilde R₀ (alpha R₀)⁆ := by
        rw [s.Ltilde_embedded]
      _ ≤ U R₀ (alpha R₀) := commutator_mono hVZ le_rfl
  let _ : Finite (U R₀ (alpha R₀)) :=
    Finite.of_injective common.natural.equiv common.natural.equiv.injective
  have hsmall := card_le_of_le hVU
  have hVcard : Nat.card (V₀.map (embedM R₀)) = Nat.card V := by
    rw [card_map_of_injective (embedM_injective R₀)]
    exact Nat.card_congr (subgroupOfEquivOfLe hVM).toEquiv
  have hUcard : Nat.card (U R₀ (alpha R₀)) = 8 := by
    rw [Nat.card_congr common.natural.equiv.toEquiv]
    change Nat.card (Fin 3 → ZMod 2) = 8
    norm_num [Nat.card_fun, Nat.card_fin, Nat.card_zmod]
  rw [hVcard,hUcard] at hsmall
  omega

/-- A central moving elementary subgroup of order 64 is the actual binary
MS commutator core. -/
theorem Input.commutatorCore_eq_of_central_sixtyFour
    (h : Input κ L R) (V : Subgroup J) [IsElementaryAbelian 2 V]
    (hVN : V ≤ pCore 2 J) (hVC : V ≤ centralizer (pCore 2 J : Set J))
    (hVL : ⁅V,L⁆ = V) (hcard : Nat.card V = 64) :
    commutatorCore L = V := by
  have hab := h.commutatorCore_abelian_of_central_module V hVN hVC hVL (by omega)
  obtain ⟨d,hd,⟨e⟩⟩ := h.abelianCore_model hab
  have hDcard : Nat.card (commutatorCore L) = 2 ^ d := by
    rw [Nat.card_congr e.toEquiv]
    change Nat.card (Fin d → ZMod 2) = _
    simp only [Nat.card_fun, Nat.card_fin, Nat.card_zmod]
  have hDle : Nat.card (commutatorCore L) ≤ 64 := by
    rcases hd with rfl | rfl | rfl <;> norm_num at hDcard ⊢ <;> omega
  have hle : V ≤ commutatorCore L := hVL ▸ commutator_mono hVN (le_refl L)
  exact (eq_of_le_of_card_ge hle (by omega)).symm

end CFSG.Quasithin.ChapterC.BinaryMS
