module

public import CFSG.Quasithin.ChapterC.Section01.RankTwo.Classification.BinaryCoreBound.Head
public import CFSG.Quasithin.ChapterB.Section02.Baumann.Defs
public import Stellmacher.BaumannNormalizer
public import Theory.GroupTheory.GeneralizedFitting.SelfCentralizingPrimeCore
public import Theory.Representation.SLHigherNaturalFirstCohomology.Elementary

/-!
# The marked doubled-natural source of C.1.37

The inputs are precisely the doubled-natural specialization consumed in
Chapter 15. The subgroup generated by the component and the Baumann subgroup
is normal before any MS hypotheses are constructed. Its two-core is therefore
the intersection with the ambient two-core. Faithfulness of the specified
matrix action identifies that core with the module centralizer.

Source: Aschbacher--Smith, C.1.37, printed pp.141--143, and B.2.18,
printed pp.80--81. This module supplies the common source and structural
reductions; it does not assert the offender or Baumann conclusions.
-/

@[expose] public section
namespace CFSG.Quasithin.ChapterC.DoubledNaturalControl.SourceReduction
open Subgroup Theory.GroupTheory
universe u

abbrev SL := Matrix.SpecialLinearGroup (Fin 3) (ZMod 2)
abbrev DoubleSpace := Fin 2 → Fin 3 → ZMod 2

variable {K : Type u} [Group K]

/-- Literal source data, retaining both compatible quotient markings and the
actual action on the two natural summands. No MS conclusion is assumed. -/
structure SourceData (κ : GroupClass.{u}) (L P U : Subgroup K)
    [L.Normal] [U.Normal] (T : Sylow 2 K) where
  sqtk : IsSQTK κ K
  component : L.IsCComponent
  fitting : generalizedFitting K = pCore 2 K
  generation : L ⊔ (T : Subgroup K) = ⊤
  maximal : IsCoatom P
  sylow_le : (T : Subgroup K) ≤ P
  eK : (K ⧸ pCore 2 K) ≃* SL
  eL : (L ⧸ pCore 2 L) ≃* SL
  quotient_compatible : ∀ l : L,
    eL (QuotientGroup.mk' (pCore 2 L) l) =
    eK (QuotientGroup.mk' (pCore 2 K) l)
  quotient_inner : ∀ k : K, ∃ l : L, ∀ x : L,
    QuotientGroup.mk' (pCore 2 L) (MulAut.conjNormal k x) =
    QuotientGroup.mk' (pCore 2 L) (l * x * l⁻¹)
  elementary : IsElementaryAbelian 2 U
  action_reduced : pCore 2 (K ⧸ centralizer (U : Set K)) = ⊥
  commutator : ⁅U,L⁆ = U
  nontrivial : U ≠ ⊥
  eU : U ≃* Multiplicative DoubleSpace
  action : ∀ k u, Multiplicative.toAdd (eU (MulAut.conjNormal k u)) =
    fun j => Matrix.mulVec (eK (QuotientGroup.mk' (pCore 2 K) k)).val
      (Multiplicative.toAdd (eU u) j)

abbrev Q : Subgroup K := pCore 2 K
noncomputable abbrev R (P : Subgroup K) : Subgroup K := (pCore 2 P).map P.subtype
noncomputable abbrev B (P : Subgroup K) : Subgroup K := ChapterB.baumann (R P)
noncomputable abbrev J (L P : Subgroup K) : Subgroup K := L ⊔ B P
noncomputable abbrev LJ (L P : Subgroup K) : Subgroup (J L P) := L.subgroupOf (J L P)
noncomputable abbrev BJ (L P : Subgroup K) : Subgroup (J L P) := (B P).subgroupOf (J L P)
noncomputable abbrev UJ (L P U : Subgroup K) : Subgroup (J L P) := U.subgroupOf (J L P)
noncomputable abbrev HJ (L P : Subgroup K) : Subgroup (J L P) := P.subgroupOf (J L P)

variable {κ : GroupClass.{u}} {L P U : Subgroup K} [L.Normal] [U.Normal]
  {T : Sylow 2 K} (d : SourceData κ L P U T)

namespace SourceData

/-- The actual ambient quotient projection in the supplied coordinates. -/
noncomputable def ρK : K →* SL := d.eK.toMonoidHom.comp (QuotientGroup.mk' (Q (K := K)))

/-- Its restriction to the literal generated subgroup. -/
noncomputable def ρJ : J L P →* SL := d.ρK.comp (J L P).subtype

/-- The component subgroup is identified with L by the inclusion. -/
noncomputable def eLJ : LJ L P ≃* L := subgroupOfEquivOfLe (show L ≤ J L P from le_sup_left)

/-- The inherited component quotient uses the supplied L-marking. -/
noncomputable def componentEquiv : (LJ L P ⧸ pCore 2 (LJ L P)) ≃* SL :=
  (QuotientGroup.congr _ _ (eLJ (L := L) (P := P))
    (pCore_map_iso 2 (eLJ (L := L) (P := P)))).trans d.eL

include d

theorem componentEquiv_apply (l : LJ L P) :
    d.componentEquiv (QuotientGroup.mk' (pCore 2 (LJ L P)) l) =
      d.eL (QuotientGroup.mk' (pCore 2 L) (eLJ l)) := rfl

theorem component_projection (l : LJ L P) :
    d.componentEquiv (QuotientGroup.mk' (pCore 2 (LJ L P)) l) = d.ρJ (l : J L P) :=
  d.quotient_compatible (eLJ l)

theorem component_surjective : Function.Surjective (d.ρK.comp L.subtype) := by
  intro g
  obtain ⟨l, hl⟩ := QuotientGroup.mk'_surjective (pCore 2 L) (d.eL.symm g)
  refine ⟨l, ?_⟩
  change d.eK (QuotientGroup.mk' (pCore 2 K) l) = g
  rw [← d.quotient_compatible, hl, d.eL.apply_symm_apply]

theorem projection_surjective : Function.Surjective d.ρJ := by
  intro g
  obtain ⟨l, hl⟩ := d.component_surjective g
  exact ⟨⟨l, mem_sup_left l.property⟩, hl⟩

theorem ambient_projection_kernel : d.ρK.ker = Q (K := K) := by
  ext k
  change d.eK (QuotientGroup.mk' (pCore 2 K) k) = 1 ↔ k ∈ pCore 2 K
  rw [d.eK.map_eq_one_iff]
  exact QuotientGroup.eq_one_iff k

omit d in
/-- P normalizes the embedded intrinsic two-core. -/
theorem parabolic_normalizes_radical : P ≤ normalizer (R P : Set K) :=
  le_normalizer.trans (normalizer_le_normalizer_characteristic_image P (pCore 2 P))

/-- The source Sylow subgroup normalizes the actual Baumann subgroup. -/
theorem sylow_normalizes_baumann : (T : Subgroup K) ≤ normalizer (B P : Set K) :=
  d.sylow_le.trans (parabolic_normalizes_radical.trans
    (Stellmacher.normalizer_le_normalizer_baumann (R P)))

/-- Normality precedes and is independent of the MS construction. -/
theorem group_normal : (J L P).Normal := by
  apply normalizer_eq_top_iff.mp
  apply eq_top_iff.mpr
  rw [← d.generation]
  apply sup_le (le_sup_left.trans le_normalizer)
  exact (le_inf (by rw [normalizer_eq_top]; exact le_top)
    d.sylow_normalizes_baumann).trans
      (normalizer_inf_normalizer_le_normalizer_sup L (B P))

variable [Finite K]

/-- The intrinsic core of the generated normal subgroup is the actual
intersection with the ambient core. -/
theorem core_eq_comap : pCore 2 (J L P) = (Q (K := K)).comap (J L P).subtype :=
  pCore_subnormal_eq_comap 2 d.group_normal.isSubnormal

theorem core_map : (pCore 2 (J L P)).map (J L P).subtype = Q ⊓ J L P := by
  rw [d.core_eq_comap, map_comap_eq, range_subtype, inf_comm]

theorem projection_kernel : d.ρJ.ker = pCore 2 (J L P) := by
  rw [d.core_eq_comap, ← d.ambient_projection_kernel]
  rfl

omit [Finite K] in
/-- Generation by component commutators puts U inside L. -/
theorem source_module_le_component : U ≤ L := d.commutator ▸ commutator_le_right U L

omit [Finite K] in
theorem source_module_le : U ≤ J L P := d.source_module_le_component.trans le_sup_left

omit [Finite K] in
theorem source_module_le_core : U ≤ Q (K := K) := by
  let := d.elementary
  exact le_sSup ⟨inferInstance, IsElementaryAbelian.isPGroup 2 U⟩

omit [Finite K] in
theorem core_le_parabolic : Q (K := K) ≤ P :=
  (pCore_isPGroup.le_sylow_of_normal T).trans d.sylow_le

omit [Finite K] in
theorem core_le_radical : Q (K := K) ≤ R P := by
  have h : (Q (K := K)).subgroupOf P ≤ pCore 2 P :=
    le_sSup ⟨inferInstance, pCore_isPGroup.comap_of_injective P.subtype P.subtype_injective⟩
  simpa only [map_subgroupOf_eq_of_le d.core_le_parabolic] using map_mono (f := P.subtype) h

omit [Finite K] in
theorem source_module_le_radical : U ≤ R P := d.source_module_le_core.trans d.core_le_radical

omit [Finite K] in
/-- The prescribed natural action has exactly the prescribed quotient kernel. -/
theorem centralizer_eq_core : centralizer (U : Set K) = Q (K := K) := by
  apply le_antisymm
  · intro k hk
    have hfix (v : Fin 3 → ZMod 2) : Matrix.mulVec (d.ρK k).val v = v := by
      let u := d.eU.symm (Multiplicative.ofAdd (fun _ : Fin 2 => v))
      have hu : MulAut.conjNormal k u = u := by
        apply Subtype.ext
        change k * (u : K) * k⁻¹ = (u : K)
        rw [← mem_centralizer_iff.mp hk u u.property, mul_inv_cancel_right]
      have h := congrFun (d.action k u) (0 : Fin 2)
      rw [hu] at h
      simpa [u, ρK] using h.symm
    have he : d.ρK k = 1 := by
      apply Subtype.ext
      apply Matrix.mulVec_injective
      funext v
      exact (hfix v).trans (Matrix.one_mulVec v).symm
    have hm : k ∈ d.ρK.ker := he
    rwa [d.ambient_projection_kernel] at hm
  · intro k hk
    have he : d.ρK k = 1 := by
      change k ∈ d.ρK.ker
      rwa [d.ambient_projection_kernel]
    apply mem_centralizer_iff.mpr
    intro u hu
    have hc : MulAut.conjNormal k (⟨u, hu⟩ : U) = ⟨u, hu⟩ := by
      apply d.eU.injective
      apply Multiplicative.toAdd.injective
      rw [d.action]
      change (fun j => Matrix.mulVec (d.ρK k).val _) = _
      simp [he]
    have hm := congrArg Subtype.val hc
    change k * u * k⁻¹ = u at hm
    exact (mul_inv_eq_iff_eq_mul.mp hm).symm

omit [Finite K] in
/-- The marked module has its literal cardinality. -/
theorem source_module_card : Nat.card U = 64 := by
  rw [Nat.card_congr d.eU.toEquiv]
  change Nat.card DoubleSpace = 64
  simp [DoubleSpace]

omit [Finite K] in
/-- There is no component-fixed point in either natural summand. -/
theorem source_module_fixed : U ⊓ centralizer (L : Set K) = ⊥ := by
  apply eq_bot_iff.mpr
  rintro u ⟨hu, hc⟩
  let u' : U := ⟨u, hu⟩
  have hv (i : Fin 2) :
      Multiplicative.toAdd (d.eU u') i ∈
        Representation.OneCohomology.fixed (Representation.specialLinearNatural (k := ZMod 2) 3) := by
    intro g
    obtain ⟨l, hl⟩ := d.component_surjective g
    have hconj : MulAut.conjNormal (l : K) u' = u' := by
      apply Subtype.ext
      change (l : K) * u * (l : K)⁻¹ = u
      rw [mem_centralizer_iff.mp hc l l.property, mul_inv_cancel_right]
    have h := congrFun (d.action l u') i
    rw [hconj] at h
    change _ = Matrix.mulVec (d.ρK l).val _ at h
    rw [show d.ρK l = g from hl] at h
    exact h.symm
  have hz : Multiplicative.toAdd (d.eU u') = 0 := by
    funext i
    have h := hv i
    rw [Representation.OneCohomology.SLHigherNatural.fixed_eq_bot (by decide : 2 ≤ 3)] at h
    exact h
  have he : u' = 1 := d.eU.injective (by
    apply Multiplicative.toAdd.injective
    simpa using hz)
  exact congrArg Subtype.val he


/-- The inclusion marking on the source module inside the generated group. -/
noncomputable def eUJ : UJ L P U ≃* U := subgroupOfEquivOfLe d.source_module_le

/-- The doubled-natural coordinates are transported through that inclusion. -/
noncomputable def eDouble : UJ L P U ≃* Multiplicative DoubleSpace := d.eUJ.trans d.eU

omit [Finite K] in
theorem eDouble_apply (u : UJ L P U) : d.eDouble u = d.eU (d.eUJ u) := rfl

omit [Finite K] in
theorem module_map : (UJ L P U).map (J L P).subtype = U :=
  map_subgroupOf_eq_of_le d.source_module_le

omit d [Finite K] [L.Normal] in
theorem module_normal : (UJ L P U).Normal := inferInstance

omit [Finite K] in
theorem module_elementary : IsElementaryAbelian 2 (UJ L P U) := by
  let := d.elementary
  exact IsElementaryAbelian.subgroupOf d.source_module_le

theorem module_le_core : UJ L P U ≤ pCore 2 (J L P) := by
  rw [d.core_eq_comap]
  exact fun _ hu => d.source_module_le_core hu

omit [Finite K] in
theorem module_commutator : ⁅UJ L P U, LJ L P⁆ = UJ L P U := by
  apply map_injective (J L P).subtype_injective
  rw [map_commutator, d.module_map, map_subgroupOf_eq_of_le (show L ≤ J L P from le_sup_left),
    d.commutator]

omit [Finite K] in
theorem module_fixed : UJ L P U ⊓ centralizer (LJ L P : Set (J L P)) = ⊥ := by
  apply eq_bot_iff.mpr
  rintro u ⟨hu, hc⟩
  have hf : (u : K) ∈ centralizer (L : Set K) := by
    apply mem_centralizer_iff.mpr
    intro l hl
    exact congrArg Subtype.val (mem_centralizer_iff.mp hc
      (⟨l, mem_sup_left hl⟩ : J L P) hl)
  have hb : (u : K) ∈ (⊥ : Subgroup K) := d.source_module_fixed ▸ ⟨hu, hf⟩
  exact Subtype.ext hb

omit [Finite K] in
theorem module_card : Nat.card (UJ L P U) = 64 :=
  (Nat.card_congr d.eUJ.toEquiv).trans d.source_module_card

/-- The actual relative centralizer is the intrinsic two-core. -/
theorem module_centralizer : centralizer (UJ L P U : Set (J L P)) = pCore 2 (J L P) := by
  rw [d.core_eq_comap, ← d.centralizer_eq_core]
  ext j
  constructor
  · intro hj
    apply mem_centralizer_iff.mpr
    intro u hu
    exact congrArg Subtype.val (mem_centralizer_iff.mp hj
      (⟨u, d.source_module_le hu⟩ : J L P) hu)
  · intro hj
    apply mem_centralizer_iff.mpr
    intro u hu
    exact Subtype.ext (mem_centralizer_iff.mp hj (u : K) hu)

theorem module_centralizes_core :
    UJ L P U ≤ centralizer (pCore 2 (J L P) : Set (J L P)) := by
  rw [← d.module_centralizer]
  intro u hu n hn
  exact (hn u hu).symm

omit [Finite K] in
/-- Equivariance of the deterministic module marking, for actual conjugation. -/
theorem module_action (j : J L P) (u : UJ L P U) :
    Multiplicative.toAdd (d.eDouble (MulAut.conjNormal j u)) =
      fun i => Matrix.mulVec (d.ρJ j).val (Multiplicative.toAdd (d.eDouble u) i) :=
  d.action (j : K) (d.eUJ u)

/-- Characteristic two for the generated group follows from the marked
module centralizer, independently of Baumann's conclusion. -/
theorem group_fitting : generalizedFitting (J L P) = pCore 2 (J L P) := by
  apply generalizedFitting_eq_pCore_of_selfCentralizing 2
  rw [← d.module_centralizer]
  exact centralizer_le (d.module_le_core.trans_eq d.module_centralizer.symm)

omit [Finite K] in
theorem group_component : (LJ L P).IsCComponent := d.component.subgroupOf le_sup_left

omit d [Finite K] [U.Normal] in
/-- Normality of L makes the generated subgroup the literal product L B. -/
theorem group_product (j : J L P) :
    ∃ l ∈ LJ L P, ∃ b ∈ BJ L P, l * b = j := by
  obtain ⟨l, hl, b, hb, h⟩ := mem_sup_of_normal_left.mp j.property
  exact ⟨⟨l, mem_sup_left hl⟩, hl, ⟨b, mem_sup_right hb⟩, hb, Subtype.ext h⟩

/-- The component is the actual two-residual in the original ambient group. -/
theorem residual_eq : pResidual 2 K = L := by
  let := d.component.perfect
  have hp : IsPPerfect 2 L := by
    intro N hN hq
    let := hN
    have hs : Subsingleton (L ⧸ N) := by
      by_contra! hn
      exact Group.IsPerfect.not_isNilpotent (L ⧸ N) hq.isNilpotent
    apply eq_top_iff.mpr
    intro l _
    exact (QuotientGroup.eq_one_iff l).mp (Subsingleton.elim _ _)
  exact pResidual_eq_of_isPPerfect_sup L (T : Subgroup K) hp T.isPGroup' d.generation

end SourceData
end CFSG.Quasithin.ChapterC.DoubledNaturalControl.SourceReduction
