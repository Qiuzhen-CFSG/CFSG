/-!
# The original star component on the offender-generated actor

The actual C.2.7 offenders prevent the star component from vanishing.
Its quasisimple quotient and two-group supplement identify it with F* of
the star actor. Passing to the normal subgroup generated by best offenders
retains this same component and kills no vectors. B.5.1's generation
hypothesis then holds by construction on the restricted original action.
The original ambient actor is never assumed offender-generated.

Source: Aschbacher--Smith C.2.7, displayed (!), p.146, applying B.5.1.
-/

public section

open Subgroup Theory.GroupTheory Stellmacher Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterC.C27Source
open Chapter1.RadicalExclusions.ModelReduction FullSieve FullSieve.SourceInterface
open ChapterB.QuasisimpleSource
open ChapterB.SourceInduction.HighThreeRank.CoverCentralizer.SourceConstruction
universe u
variable {G : Type u} [Group G] [Finite G]
variable {κ : GroupClass.{u}} {H K R M : Subgroup G}

theorem star_fitting_quasisimple (h : Input κ H R M K) [(K.subgroupOf H).Normal] :
    generalizedFitting (StarQuotient K R) = starImage K R K ∧
      IsQuasisimple (starImage K R K) := by
  obtain ⟨hk,ho⟩ := kernel_offender_of_normal_input h
  have hpR : IsPGroup 2 R := by
    have hh := h.setup.radical.isPGroup.map H.subtype
    rwa [map_subgroupOf_eq_of_le h.setup.radical_le] at hh
  have hp : IsPGroup 2 (starImage K R R) := hpR.comap_subtype.map _
  have hne : starImage K R K ≠ ⊥ := by
    intro hz
    have ht : starImage K R R = ⊤ := by
      simpa only [hz,bot_sup_eq] using starImage_sup_eq_top K R
    let : (starImage K R R).Normal := ht ▸ inferInstance
    have hbot : starImage K R R = ⊥ := le_bot_iff.mp
      ((show starImage K R R ≤ pCore 2 (StarQuotient K R) from
        le_sSup ⟨inferInstance,hp⟩).trans hk.reduced.2.2.le)
    obtain ⟨A,hAR,hA⟩ := ho.best
    exact hA.1.1 (le_bot_iff.mp (hAR.trans hbot.le))
  let : IsQuasisimple (K ⧸ pCore 2 K) := h.quasisimple
  let : Nontrivial (starImage K R K) := (nontrivial_iff_ne_bot _).mpr hne
  let : IsQuasisimple (starImage K R K) := IsQuasisimple.of_surjective
    (coreToStar h.normalizes) (coreToStar_surjective h.normalizes)
  let : (K.subgroupOf (K ⊔ R)).Normal :=
    normal_subgroupOf_of_le_normalizer (sup_le le_normalizer h.normalizes)
  let : (starImage K R K).Normal := Normal.map inferInstance _ (QuotientGroup.mk'_surjective _)
  have hquot : IsPGroup 2 (StarQuotient K R ⧸ starImage K R K) :=
    quotient_isPGroup_of_sup_eq_top _ _ hp (by
      rw [sup_comm (starImage K R R) (starImage K R K)]; exact starImage_sup_eq_top K R)
  exact ⟨generalizedFitting_eq_of_quasisimple_two_quotient _ hquot hk.reduced.2.2,inferInstance⟩

theorem star_offender_fitting (h : Input κ H R M K) [(K.subgroupOf H).Normal] :
    let J := offenderSubgroup (starRepresentation K R)
    starImage K R K ≤ J ∧
    generalizedFitting J = (starImage K R K).subgroupOf J ∧
    pCore 2 J = ⊥ := by
  dsimp only
  let ρ := starRepresentation K R
  let J := offenderSubgroup ρ
  let : J.Normal := offenderSubgroup_normal ρ
  obtain ⟨hfit,hquasi⟩ := star_fitting_quasisimple h
  obtain ⟨hk,ho⟩ := kernel_offender_of_normal_input h
  obtain ⟨A,hAR,hA⟩ := ho.best
  let : IsElementaryAbelian 2 A := hA.1.2
  have hAJ : A ≤ J := hA.le_offenderSubgroup ρ
  have hshape : IsQuasisimple (generalizedFitting (StarQuotient K R)) := hfit ▸ hquasi
  have hf := generalizedFitting_normal_eq_of_quasisimple_or_three hk.reduced.2.2
    (Or.inl hshape) J A (IsElementaryAbelian.isPGroup 2 A) hA.1.1 hAJ
  rw [hfit] at hf
  have hLJ : starImage K R K ≤ J := hf ▸ map_subtype_le _
  have he : generalizedFitting J = (starImage K R K).subgroupOf J := by
    apply map_injective J.subtype_injective
    rw [hf,map_subgroupOf_eq_of_le hLJ]
  have hcore : pCore 2 J = ⊥ := by
    apply ((pCore 2 J).map_eq_bot_iff_of_injective J.subtype_injective).mp
    apply le_bot_iff.mp
    have hm : (pCore 2 J).map J.subtype ≤ pCore 2 (StarQuotient K R) :=
      le_sSup ⟨ConjAct.normal_of_characteristic_of_normal,pCore_isPGroup.map J.subtype⟩
    exact hm.trans hk.reduced.2.2.le
  exact ⟨hLJ,he,hcore⟩



theorem star_offender_hypothesis (hA : SemisimpleInput κ)
    (h : Input κ H R M K) [(K.subgroupOf H).Normal] :
    let ρ := starRepresentation K R
    let J := offenderSubgroup ρ
    QuasisimpleSourceHypothesis (ρ.comp J.subtype) κ
      ((starImage K R K).subgroupOf J) := by
  dsimp only
  let ρ := starRepresentation K R
  let J := offenderSubgroup ρ
  let D := (starImage K R K).subgroupOf J
  obtain ⟨hLJ,hfit,hcore⟩ := star_offender_fitting h
  let e : D ≃* starImage K R K := subgroupOfEquivOfLe hLJ
  let : IsQuasisimple (starImage K R K) := (star_fitting_quasisimple h).2
  let : IsQuasisimple D := IsQuasisimple.of_mulEquiv e.symm
  have hsqK : IsSQTK κ K :=
    (IsSQTK.equiv (subgroupOfEquivOfLe h.component.1)).mp
      (h.setup.sqtk.subgroup (K.subgroupOf H))
  have hsq : IsSQTK κ (starImage K R K) := quasisimple_section_sqtk hA hsqK
    (ChapterA.Section02.IsSectionOf.of_surjective (toStarImage K R) (toStarImage_surjective K R))
  refine ⟨inferInstance,(starRepresentation_injective K R).comp J.subtype_injective,
    inferInstance,(IsSQTK.equiv e).mpr hsq,?_,hcore,offenderSubgroup_restrict_eq_top ρ⟩
  rw [hfit]
  exact (sup_eq_left.mpr (by
    rw [←hfit]
    exact (show center J ≤ fittingSubgroup J from le_sSup ⟨inferInstance,inferInstance⟩).trans
      (fitting_le_generalizedFitting J))).symm
end CFSG.Quasithin.ChapterC.C27Source
