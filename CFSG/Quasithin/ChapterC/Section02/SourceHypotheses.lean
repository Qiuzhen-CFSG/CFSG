module
public import CFSG.Quasithin.Defs
public import CFSG.Quasithin.ChapterA.Section04.Signalizers.SectionCentralizer
public import Theory.GroupTheory.CComponent.Basic
public import Theory.GroupTheory.ConjugateSpanOrder
public import Theory.GroupTheory.CharacteristicNormalizerClosure
public import Theory.GroupTheory.GeneralizedFitting.Defs

/-!
# The genuine local pushing-up hypothesis C.2.8

All subgroups remain in a common ambient group. H is the actual SQTK group;
M0 is the subgroup generated by the MH-conjugates of the given C-component LH.
The characteristic-normalizer closure is computed inside H and compared with
the literal subgroupOf MH. The module is contained in M0 and in the center of
the actual two-core of M0 joined with R. No classification row, recognition
conclusion, or control of an odd normalizer is included.
Source: Aschbacher--Smith,C.2.8, printed p.147.
-/

public section
namespace CFSG.Quasithin.ChapterC
open Subgroup Theory.GroupTheory
universe u
variable {G : Type u} [Group G] [Finite G]

/-- C.2.8, with every relative subgroup and source action expressed in the
same ambient group. Strict MH<H is the additional premise of C.4.8. -/
structure HypothesisC28 (κ : GroupClass.{u}) (H MH LH R V : Subgroup G) : Prop where
  sqtk : IsSQTK κ H
  radical_isTwoGroup : IsPGroup 2 R
  radical_le : R ≤ MH
  local_le : MH ≤ H
  local_fitting : generalizedFitting MH = pCore 2 MH
  core_nontrivial : H.pCoreIn 2 ≠ ⊥
  component_le : LH ≤ MH
  component : (LH.subgroupOf MH).IsCComponent
  section_sylow : ∃ S : Sylow 2 (ChapterA.Section04.twoSectionCentralizer
      (conjugateSpanBy LH MH) MH),
    (S : Subgroup (ChapterA.Section04.twoSectionCentralizer (conjugateSpanBy LH MH) MH)).map
      (ChapterA.Section04.twoSectionCentralizer (conjugateSpanBy LH MH) MH).subtype = R
  characteristic_control : (R.subgroupOf H).characteristicNormalizerClosure ≤ MH.subgroupOf H
  module_nontrivial : V ≠ ⊥
  module_elementary : IsElementaryAbelian 2 V
  module_le : V ≤ conjugateSpanBy LH MH
  module_commutator : V = ⁅V,conjugateSpanBy LH MH⁆
  module_central : V ≤ (center ((conjugateSpanBy LH MH ⊔ R).pCoreIn 2)).map
    ((conjugateSpanBy LH MH ⊔ R).pCoreIn 2).subtype
  module_normalizer : H ⊓ normalizer (V : Set G) ≤ MH
end CFSG.Quasithin.ChapterC
