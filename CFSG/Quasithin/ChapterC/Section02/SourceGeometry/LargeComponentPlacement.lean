public import CFSG.Quasithin.ChapterC.Section02.SourceExtraction.C27.QuasisimpleAction
public import Theory.AtlasPort.LinearGroups.G2.OrderChecks
public import CFSG.Quasithin.ChapterB.Section02.OffenderFactorization

/-!
# Actual large-component placement from the full B.5 conclusion

The exceptional outer actor alternatives of B.5.1 have order at most 8!.
For a larger component, B.5.1 therefore identifies the original subgroup
generated by best offenders with that component. B.2.7 puts the actual
image of J(R) in this subgroup. The Thompson-image placement theorem then
places the full radical-intersection normalizer in the original M_K*.

This argument permits an outer action by R*. It uses the actual moved-section
conclusion of B.5.1, with its source construction and original star action.
Source: Aschbacher--Smith B.5.1(1), pp.99--100, and C.2.7(3), pp.146--147.
-/

public section
open Subgroup Theory.GroupTheory Stellmacher Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterC.C27Source
open Chapter1.RadicalExclusions.ModelReduction FullSieve FullSieve.SourceInterface
open ChapterB.QuasisimpleSource
universe u v

private theorem outerNatural_card_le
    {D : Type u} [Group D] {V : Type v} [AddCommGroup V] [Module (ZMod 2) V]
    (ρ : Representation (ZMod 2) D V) (h : OuterNaturalAction ρ) : Nat.card D ≤ 40320 := by
  rcases h with hs | hg
  · obtain ⟨n,_,hn,⟨e⟩⟩ := hs
    rw [Nat.card_congr e.groupEquiv.toEquiv]
    have hh := Nat.factorial_le hn
    norm_num at hh
    simpa only [Nat.card_eq_fintype_card,Fintype.card_perm,Fintype.card_fin] using hh
  · obtain ⟨e⟩ := hg
    rw [Nat.card_congr e.groupEquiv.toEquiv, Atlas.G2.OrderChecks.binary_order]
    decide

private theorem source_component_eq_top_of_large_card
    {D : Type u} [Group D] [Finite D] {V : Type v}
    [AddCommGroup V] [Module (ZMod 2) V]
    (ρ : Representation (ZMod 2) D V) (L : Subgroup D)
    (c : ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion ρ L)
    (hlarge : 40320 < Nat.card L) : L = ⊤ := by
  cases c.clause_one with
  | irreducible _ _ _ _ he =>
    rcases he with htop | ⟨_,hout⟩
    · exact htop
    · have hc := Nat.card_le_card_of_injective L.subtype L.subtype_injective
      exact (not_lt_of_ge (hc.trans (outerNatural_card_le _ hout)) hlarge).elim
  | doubleThree _ htop _ _ _ => exact htop
  | naturalDual _ _ htop _ => exact htop
  | repeatedNatural _ _ _ _ _ htop _ => exact htop

variable {G : Type u} [Group G] [Finite G]
variable {κ : GroupClass.{u}} {H K R M : Subgroup G}

theorem star_thompson_le_offenderSubgroup
    (h : Input κ H R M K) [(K.subgroupOf H).Normal] :
    starImage K R (elementaryAbelianMaxJ R) ≤ offenderSubgroup (starRepresentation K R) := by
  let D := K ⊔ R
  let R₀ := R.subgroupOf D
  let q := QuotientGroup.mk' (starKernel K R)
  have hQR : pCore 2 D ≤ R₀ := fun x hx => source_joinCore_le_radical h
    (mem_map_of_mem D.subtype hx)
  have hVR : starV K R ≤ R₀ := (map_subtype_le _).trans hQR
  have hn : ¬elementaryAbelianMaxJ R₀ ≤ q.ker := by
    simpa only [q,QuotientGroup.ker_mk'] using thompson_not_le_starKernel_of_normal_input h
  have hbest := (ChapterB.lemma_B_2_7_local (starV K R) q
    (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _) R₀ hVR hn).2
  have hJR : elementaryAbelianMaxJ R ≤ D :=
    (sSup_le fun _ hA => hA.1).trans (show R ≤ D from le_sup_right)
  have hJ : elementaryAbelianMaxJ R₀ = (elementaryAbelianMaxJ R).subgroupOf D := by
    apply map_injective D.subtype_injective
    rw [←elementaryAbelianMaxJ_map_injective D.subtype D.subtype_injective,
      map_subgroupOf_eq_of_le (show R ≤ D from le_sup_right),map_subgroupOf_eq_of_le hJR]
  change ((elementaryAbelianMaxJ R).subgroupOf D).map q ≤ _
  rw [←hJ]
  apply map_le_iff_le_comap.mpr
  apply sSup_le
  intro A hA
  apply map_le_iff_le_comap.mp
  by_cases hz : A.map q = ⊥
  · rw [hz]; exact bot_le
  exact (hbest _ ⟨A,hA,rfl,hz⟩).le_offenderSubgroup _

theorem star_offender_subgroup_eq_component_of_large_order
    (h : Input KnownSimple.IsKnownSimple H R M K) [(K.subgroupOf H).Normal]
    (hlarge : 40320 < Nat.card (starImage K R K)) :
    offenderSubgroup (starRepresentation K R) = starImage K R K := by
  obtain ⟨hCJ,⟨c⟩⟩ := star_moved_section_conclusion h
  let J := offenderSubgroup (starRepresentation K R)
  have hlarge' : 40320 < Nat.card ((starImage K R K).subgroupOf J) := by
    rwa [Nat.card_congr (subgroupOfEquivOfLe hCJ).toEquiv]
  have ht := source_component_eq_top_of_large_card _ _ c hlarge'
  exact le_antisymm (subgroupOf_eq_top.mp ht) hCJ

theorem star_thompson_le_component_of_large_order
    (h : Input KnownSimple.IsKnownSimple H R M K) [(K.subgroupOf H).Normal]
    (hlarge : 40320 < Nat.card (starImage K R K)) :
    starImage K R (elementaryAbelianMaxJ R) ≤ starImage K R K := by
  rw [←star_offender_subgroup_eq_component_of_large_order h hlarge]
  exact star_thompson_le_offenderSubgroup h

theorem star_intersection_placement_of_large_order
    (h : Input KnownSimple.IsKnownSimple H R M K) [(K.subgroupOf H).Normal]
    (hlarge : 40320 < Nat.card (starImage K R K)) :
    IsPRadical 2 ((starImage K R R).subgroupOf (starImage K R K)) ∧
      normalizer ((starImage K R R).subgroupOf (starImage K R K) :
          Set (starImage K R K)) ≤
        (starM K R M).subgroupOf (starImage K R K) := by
  have hi := star_thompson_le_component_of_large_order h hlarge
  exact ⟨star_intersection_radical_of_thompson_inner h hi,
    star_intersection_normalizer_control_of_thompson_inner h hi⟩

end CFSG.Quasithin.ChapterC.C27Source
