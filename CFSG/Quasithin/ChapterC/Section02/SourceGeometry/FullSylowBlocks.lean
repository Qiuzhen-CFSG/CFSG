module
public import CFSG.Quasithin.ChapterC.Section02.SourceGeometry.SylowBlocks
public import CFSG.Quasithin.ChapterC.Section02.SourceConsequences.ShortAction
public import Theory.GroupTheory.CComponent.FullSylowJoin
public import Theory.GroupTheory.CComponent.ConstrainedPrimeJoin
public import Theory.GroupTheory.PRadical.NormalizerRestriction
public import Theory.GroupTheory.CharacteristicNormalizerRestriction

/-!
# Full-Sylow constrained components are chi-zero blocks

C.1.29 decomposes a characteristic-two group into its control subgroup and
actual chi-zero blocks. A C-component different from every block centralizes
each of them: first pass to the actual two-core quotient, then use the
perfect-actor theorem for short groups. The ordered product would put every
component-conjugate of its Sylow subgroup in the control subgroup. A perfect
finite group is generated by those conjugates, by the odd-order theorem,
contradicting escape. Hence the component is one of the genuine blocks.

For C.2.4(1), the full-Sylow join theorem and the constrained-component join
calculation supply the required Sylow subgroup and characteristic two. The
ambient group is only SQTK with trivial odd core; no characteristic-two
hypothesis is imposed on it. The Chapter 15 consumer uses this result to
supply radical normalization in every non-chi-zero component branch.

Source: Aschbacher--Smith C.2.4(1), p.144, C.1.29, p.134, and the application
in 15.1.20(2), pp.1094--1095.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.ChapterC.CatalogueFullSylow
variable {G : Type*} [Group G] [Finite G]

private theorem perfect_twoPerfect {A : Type*} [Group A] [Finite A]
    [Group.IsPerfect A] : IsPPerfect 2 A := by
  intro N hN hp
  let := hN
  by_contra hn
  let : Nontrivial (A ⧸ N) := QuotientGroup.nontrivial_iff.mpr hn
  exact Group.IsPerfect.not_isNilpotent (A ⧸ N) hp.isNilpotent

private theorem component_commutes_block {K B : Subgroup G}
    (hK : K.IsCComponent) [IsQuasisimple (K ⧸ pCore 2 K)]
    (hB : IsBlock B) (hne : K ≠ B) : ⁅B,K⁆ = ⊥ := by
  let := hK.perfect
  let q := QuotientGroup.mk' (pCore 2 G)
  have hcK : IsComponent (G ⧸ pCore 2 G) (K.map q) :=
    ⟨hK.subnormal.quotient,IsQuasisimple.of_mulEquiv (cComponentTwoCoreQuotientEquiv hK)⟩
  have hsubB : (B.map q).IsSubnormal := hB.subnormal.quotient
  have hcomm : ⁅K.map q,B.map q⁆ = ⊥ := by
    rcases hcK.subnormal_dichotomy (B.map q) hsubB with hle | hc
    · rcases hB.short.quotient with hqB | hqB
      · let := hqB
        have hcB : IsComponent (G ⧸ pCore 2 G) (B.map q) :=
          ⟨hsubB,IsQuasisimple.of_mulEquiv (BlockCommutation.coreQuotientEquiv B hB.subnormal)⟩
        exact (hne (BlockCommutation.eq_of_map_eq K B hK.subnormal hB.subnormal
          perfect_twoPerfect hB.short.twoPerfect (hcK.eq_of_le hcB hle))).elim
      · have hcard : Nat.card (B.map q) = 3 :=
          (Nat.card_congr (BlockCommutation.coreQuotientEquiv B hB.subnormal).toEquiv).symm.trans hqB
        let : IsCyclic (B.map q) := isCyclic_of_prime_card hcard
        let := hcK.2
        let : IsSimpleGroup ((K.map q) ⧸ center (K.map q)) := IsQuasisimple.simple
        let : Nontrivial (K.map q) := (QuotientGroup.mk'_surjective (center (K.map q))).nontrivial
        let : Group.IsSolvable (K.map q) :=
          Group.isSolvable_of_isSolvable_injective (inclusion_injective hle)
        exact (Group.IsPerfect.not_isSolvable (K.map q) inferInstance).elim
    · exact hc
  have hc : ⁅B,K⁆ ≤ pCore 2 G := by
    rw [commutator_comm] at hcomm
    simpa only [←map_commutator,Subgroup.map_eq_bot_iff,q,QuotientGroup.ker_mk'] using hcomm
  have hn := BlockCommutation.normalizes_of_commutator_le_core B K hB hc
  exact SourceShortAction.perfect_centralizes_short_of_normalizes B K hB.short hn
    (le_pCoreIn_of_normalizes (pCore_isPGroup.to_le hc)
      (le_normalizer_iff_commutator_le_left.mp hn) (normalizer_commutator_ge_left B K))

private theorem perfect_sylow_normalClosure (A : Type*) [Group A] [Finite A]
    [Group.IsPerfect A] (P : Sylow 2 A) : normalClosure (P : Set A) = ⊤ := by
  let N := normalClosure (P : Set A)
  by_contra hn
  have hodd : Odd (Nat.card (A ⧸ N)) := by
    apply Nat.not_even_iff_odd.mp
    intro he
    exact P.not_dvd_index ((even_iff_two_dvd.mp he).trans
      (index_dvd_of_le (show (P : Subgroup A) ≤ N from le_normalClosure)))
  let : Nontrivial (A ⧸ N) := QuotientGroup.nontrivial_iff.mpr hn
  exact Group.IsPerfect.not_isSolvable (A ⧸ N) (_root_.odd_order_theorem _ hodd)

/-- In the full-Sylow C.1.29 product, every escaping C-component with
quasisimple two-core quotient is one of the actual chi-zero factors. -/
theorem component_chiZero_of_sylow_control
    (hG : IsSQTK KnownSimple.IsKnownSimple G)
    (hf : generalizedFitting G = pCore 2 G)
    (T : Sylow 2 G) (M K : Subgroup G)
    (hcpu : (T : Subgroup G).characteristicNormalizerClosure ≤ M)
    (hK : K.IsCComponent) [IsQuasisimple (K ⧸ pCore 2 K)]
    (hout : ¬ K ≤ M) : IsChiZeroBlock K := by
  classical
  let := hK.perfect
  obtain ⟨r,_,B,hB,_,_,hprod⟩ :=
    RankOne.ChiProduct.SelectedRankOne.ordered_chiZero_product_knownSimple hG hf T M hcpu
  by_contra hn
  have hc (i) : B i ≤ centralizer (K : Set G) :=
    commutator_eq_bot_iff_le_centralizer.mp
      (component_commutes_block hK (hB i).1 (fun he => hn (he.symm ▸ (hB i).2)))
  have hTM : (T : Subgroup G) ≤ M := by
    by_cases ht : (T : Subgroup G) = ⊥
    · rw [ht]; exact bot_le
    · exact T.toSubgroup.le_normalizer.trans
        ((normalizer_le_characteristicNormalizerClosure_self _ ht).trans hcpu)
  obtain ⟨P,hP⟩ := T.exists_subgroupOf_eq_of_subnormal K hK.subnormal
  have hPM : ∀ x ∈ (P : Subgroup K), (x : G) ∈ M := by
    intro x hx
    apply hTM
    change x ∈ (T : Subgroup G).subgroupOf K
    rwa [←hP]
  have hNM : normalClosure (P : Set K) ≤ M.subgroupOf K := by
    rw [normalClosure,closure_le]
    intro y hy
    obtain ⟨x,hx,hxy⟩ := Group.mem_conjugatesOfSet_iff.mp hy
    obtain ⟨k,rfl⟩ := isConj_iff.mp hxy
    obtain ⟨m,b,he⟩ := hprod k
    have hb : (List.ofFn (fun i => (b i : G))).prod ∈ centralizer (K : Set G) :=
      (centralizer (K : Set G)).list_prod_mem (by
        intro a ha
        obtain ⟨i,rfl⟩ := List.mem_ofFn.mp ha
        exact hc i (b i).property)
    change (k : G) * (x : G) * (k : G)⁻¹ ∈ M
    rw [he]
    have hcomm := hb x x.property
    have heq : ((m : G) * (List.ofFn (fun i => (b i : G))).prod) * (x : G) *
        ((m : G) * (List.ofFn (fun i => (b i : G))).prod)⁻¹ =
        (m : G) * (x : G) * (m : G)⁻¹ := by
      calc
        _ = (m : G) * ((List.ofFn (fun i => (b i : G))).prod * (x : G) *
            ((List.ofFn (fun i => (b i : G))).prod)⁻¹) * (m : G)⁻¹ := by group
        _ = _ := by rw [←hcomm,mul_inv_cancel_right]
    rw [heq]
    exact M.mul_mem (M.mul_mem m.property (hPM x hx)) (M.inv_mem m.property)
  rw [perfect_sylow_normalClosure K P] at hNM
  exact hout (fun k hk => hNM (show (⟨k,hk⟩ : K) ∈ ⊤ from mem_top _))
/-- C.2.4(1) on a constrained component. Characteristic two is required
only for K; it is proved on the join with the original radical. -/
theorem constrained_component_chiZero_of_full_sylow
    (hG : IsSQTK KnownSimple.IsKnownSimple G)
    (R M K : Subgroup G) (hr : IsPRadical 2 R)
    (hcpu : R.characteristicNormalizerClosure ≤ M)
    (hK : K.IsCComponent) [IsQuasisimple (K ⧸ pCore 2 K)]
    (ho : pPrimeCore 2 G = ⊥) (hf : generalizedFitting K = pCore 2 K)
    (hout : ¬ K ≤ M) (P : Sylow 2 K)
    (hP : (P : Subgroup K).map K.subtype ≤ R) : IsChiZeroBlock K := by
  let D := K ⊔ R
  let K0 := K.subgroupOf D
  let e : K0 ≃* K := subgroupOfEquivOfLe le_sup_left
  let : IsQuasisimple (K0 ⧸ pCore 2 K0) :=
    IsQuasisimple.of_mulEquiv (QuotientGroup.congr _ _ e (pCore_map_iso 2 e)).symm
  obtain ⟨T,hT⟩ := hK.full_sylow_join hr.isPGroup
    (pCore_le_of_pCore_normalizer_le R hr.isPGroup hr.2.le) P hP
  have hfit : generalizedFitting D = pCore 2 D :=
    generalizedFitting_eq_pCore_of_selfCentralizing 2
      (hK.constrained_join_characteristicTwo hr.isPGroup ho hf)
  have hctl : (T : Subgroup D).characteristicNormalizerClosure ≤ M.subgroupOf D := by
    rw [hT]
    exact characteristicNormalizerClosure_subgroupOf_le le_sup_right hcpu
  have hb := component_chiZero_of_sylow_control (hG.subgroup D) hfit T
    (M.subgroupOf D) K0 hctl (hK.subgroupOf le_sup_left)
    (fun hh => hout (fun k hk => hh (show (⟨k,mem_sup_left hk⟩ : D) ∈ K0 from hk)))
  exact hb.of_mulEquiv e

end CFSG.Quasithin.ChapterC.CatalogueFullSylow
