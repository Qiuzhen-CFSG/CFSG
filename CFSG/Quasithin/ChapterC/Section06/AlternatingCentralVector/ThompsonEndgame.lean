module
public import CFSG.Quasithin.ChapterC.Section06.AlternatingCentralVector.ElementaryPair

/-!
# The stationary Thompson branch of the central-vector argument

The original R is generated by its two maximum elementary subgroups, so
J(R)=R. If NΛ(R) has the same Thompson subgroup, the two-member action and
the normalizer condition make NΛ(R)=Λ. The marked line is already fixed by
the normalizer of R, which finishes C.6.4(10) in this branch.

Source: Aschbacher–Smith C.6.4, printed pp.168–169. The branch with a
strictly larger Thompson subgroup still requires dihedral enlargement.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher
namespace CFSG.Quasithin.ChapterC.Section06.AlternatingCentralVector
variable {G : Type*} [Group G] [Finite G] {K R S Λ : Subgroup G}

/-- R is generated by its maximum elementary subgroups. -/
theorem Input.thompson_eq_self (d : Input K R S Λ) : elementaryAbelianMaxJ R = R := by
  let Q := (K ⊔ S).pCoreIn 2
  obtain ⟨x,hx,_,_,_,_,_,_,hgen⟩ := d.exists_elementary_factorization
  obtain ⟨y,_,hfamily⟩ := d.exists_maximum_elementary_pair
  have hQ : Q ∈ elementaryAbelianMaxSubgroups R := by
    rw [hfamily]
    exact Set.mem_insert _ _
  have hRmap : R.map (MulAut.conj x⁻¹).toMonoidHom = R :=
    mem_normalizer_iff_map_conj_eq.mp ((normalizer (R : Set G)).inv_mem hx.2)
  have hQx := (maxFamily_map_injective_iff (MulAut.conj x⁻¹).toMonoidHom
    (MulAut.conj x⁻¹).injective R Q).mpr hQ
  rw [hRmap] at hQx
  apply le_antisymm (sSup_le fun _ hA => hA.1)
  conv_lhs => rw [hgen]
  exact sup_le (le_sSup hQ) (le_sSup hQx)

/-- The stationary Thompson branch of the central-vector endgame. -/
theorem Input.centrality_of_thompson_normalizer_eq (d : Input K R S Λ)
    (hJ : elementaryAbelianMaxJ (Λ ⊓ normalizer (R : Set G)) = R) :
    ⁅(blockU K).map K.subtype,R⁆ ≤ centralizer ((S ⊔ Λ : Subgroup G) : Set G) := by
  obtain ⟨x,_,hfamily⟩ := d.exists_maximum_elementary_pair
  have hne : (K ⊔ S).pCoreIn 2 ≠ ⊥ := by
    intro hh
    have hU := d.module_le_core
    rw [hh] at hU
    exact d.block.2.1.blockU_ne_bot ((map_injective K.subtype_injective)
      ((bot_unique hU).trans (map_bot K.subtype).symm))
  have heq := twoGroup_eq_of_index_two_thompson_pair Λ
    (Λ ⊓ normalizer (R : Set G)) R ((K ⊔ S).pCoreIn 2) _
    d.Λ_two (le_inf d.proper.le R.le_normalizer) inf_le_left d.normalizer_index
    hfamily (d.control _ hne d.core_le d.normalizes_core)
    (hJ.trans d.thompson_eq_self.symm)
  have hΛR : Λ ≤ normalizer (R : Set G) := heq ▸ inf_le_right
  apply le_centralizer_iff.mpr
  refine sup_le (le_centralizer_iff.mp d.commutator_centralizes_S) ?_
  exact hΛR.trans (le_centralizer_iff.mp d.commutator_centralizes_normalizer)
end CFSG.Quasithin.ChapterC.Section06.AlternatingCentralVector
