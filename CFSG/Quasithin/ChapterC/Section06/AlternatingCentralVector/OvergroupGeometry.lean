module
public import CFSG.Quasithin.ChapterC.Section06.AlternatingCentralVector.MaximalDihedral
public import Theory.GroupTheory.PGroup.ElementaryDihedralGeometry

/-!
# The fixed center and elementary rank of the dihedral overgroups

C.6.4(II) makes the normalizer of Q inside Λ equal to R. Hence the
center of any dihedral overgroup M of R lies in Z(R). Since Q remains
an elementary subgroup of M and already has twice the order of Z(R),
the elementary-by-dihedral order bound forces Z(M)=Z(R). Consequently
Q is maximum elementary in M, and the maximum elementary subgroups
of M generate M.

Source: Aschbacher–Smith C.6.4, printed pp.168–169. These facts supply
the rank and generation premises for the maximal-dihedral enlargement.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher
namespace CFSG.Quasithin.ChapterC.Section06.AlternatingCentralVector
variable {G : Type*} [Group G] [Finite G] {K R S Λ : Subgroup G}

theorem Input.core_normalizer (d : Input K R S Λ) :
    Λ ⊓ normalizer ((K ⊔ S).pCoreIn 2 : Set G) = R := by
  apply d.control _ ?_ d.core_le d.normalizes_core
  intro hh
  have hU := d.module_le_core
  rw [hh] at hU
  exact d.block.2.1.blockU_ne_bot ((map_injective K.subtype_injective)
    ((bot_unique hU).trans (map_bot K.subtype).symm))

theorem Input.core_maximum_in_R (d : Input K R S Λ) :
    (K ⊔ S).pCoreIn 2 ∈ elementaryAbelianMaxSubgroups R := by
  obtain ⟨x,_,hx⟩ := d.exists_maximum_elementary_pair
  rw [hx]
  exact Set.mem_insert _ _

theorem Input.core_card_eq_twice_center (d : Input K R S Λ) :
    Nat.card ((K ⊔ S).pCoreIn 2) = 2 * Nat.card (centerIn R) := by
  obtain ⟨E,_,hE,⟨e⟩⟩ := d.exists_initial_dihedral_model
  let := hE
  rw [centerIn_eq_map_center,card_map_of_injective R.subtype_injective]
  exact elementary_dihedral_max_card_ambient R (n := 2) (by omega) e _ d.core_maximum_in_R

/-- C.6.4(II) and the elementary order bound force all dihedral overgroups
of the source R to have precisely the original center. -/
theorem Input.dihedral_overgroup_center (d : Input K R S Λ)
    (M : Subgroup G) (hM : DihedralOvergroup R Λ M) : centerIn M = centerIn R := by
  obtain ⟨hRM,hMΛ,E,hE,n,hn,⟨e⟩⟩ := hM
  let := hE
  have hle : centerIn M ≤ centerIn R := by
    apply le_inf ?_ (inf_le_right.trans (centralizer_le hRM))
    rw [← d.core_normalizer]
    exact le_inf (inf_le_left.trans hMΛ)
      ((inf_le_right.trans (centralizer_le (d.core_le.trans hRM))).trans
        (Subgroup.centralizer_le_normalizer _))
  apply eq_of_le_of_card_ge hle
  have hbound := elementary_dihedral_card_le_ambient M hn e _
    (d.core_le.trans hRM) d.core_maximum_in_R.2.1
  have hcard : Nat.card (center M) = Nat.card (centerIn M) := by
    rw [centerIn_eq_map_center,card_map_of_injective M.subtype_injective]
  rw [hcard,d.core_card_eq_twice_center] at hbound
  omega

/-- The source Q remains maximum elementary in every dihedral overgroup. -/
theorem Input.core_maximum_in_dihedral_overgroup (d : Input K R S Λ)
    (M : Subgroup G) (hM : DihedralOvergroup R Λ M) :
    (K ⊔ S).pCoreIn 2 ∈ elementaryAbelianMaxSubgroups M := by
  have hZ := d.dihedral_overgroup_center M hM
  obtain ⟨hRM,_,E,hE,n,hn,⟨e⟩⟩ := hM
  let := hE
  refine ⟨d.core_le.trans hRM,d.core_maximum_in_R.2.1,?_⟩
  intro A hAM hA
  have hh := elementary_dihedral_card_le_ambient M hn e A hAM hA
  have hc : Nat.card (center M) = Nat.card (centerIn R) := by
    rw [← hZ,centerIn_eq_map_center,card_map_of_injective M.subtype_injective]
  rwa [hc,← d.core_card_eq_twice_center] at hh

/-- Every model in the maximal family is generated by its maximum elementary
subgroups, as required in the nonstationary Thompson branch. -/
theorem dihedral_overgroup_thompson (M : Subgroup G) (hM : DihedralOvergroup R Λ M) :
    elementaryAbelianMaxJ M = M := by
  obtain ⟨_,_,E,hE,n,hn,⟨e⟩⟩ := hM
  let := hE
  exact elementary_dihedral_maxJ_ambient M hn e

end CFSG.Quasithin.ChapterC.Section06.AlternatingCentralVector
