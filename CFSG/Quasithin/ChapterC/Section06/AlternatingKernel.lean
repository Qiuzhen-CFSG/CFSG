module
public import CFSG.Quasithin.ChapterC.Section06.AlternatingSource
/-!
# The faithful A₅ family action in C.6.1

The full block normalizer acts on the original five-point module. Its
Baumann image is the abelian group generated by two disjoint transpositions.
The four maximum elementary subgroups have distinct images, so Baum(R)
normalizes each one. Conversely, fixing an extra member forces the normalizer
image into that abelian group; its exact kernel lifts this to Baum(R).
Thus [R:J(R)]=2 and the original normalizer obstruction makes the action on
all four members faithful modulo J(R).

Source: Aschbacher--Smith C.6.1, case (beta), printed p.165.
-/

public section
open Subgroup Theory.GroupTheory Stellmacher
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterC.Section05.ConjugateSource
open CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.LocalIndex.Conjugates.AlternatingFamily
variable {G : Type*} [Group G] [Finite G] {R K L : Subgroup G}

private theorem line_stabilizer_in_actor_normalizer (p : FivePerm)
    (hn : p ∈ normalizer (ChapterB.Offenders.D 5 : Set FivePerm))
    (hl : p ∈ normalizer (line 0 : Set FivePerm)) :
    p ∈ ChapterB.Offenders.D 5 := by
  have h0 : p * transposition 0 * p⁻¹ = transposition 0 := by
    have hm := (mem_normalizer_iff_map_conj_eq.mp hl) ▸
      (mem_map_of_mem (MulAut.conj p).toMonoidHom (mem_zpowers (transposition 0)))
    change p * transposition 0 * p⁻¹ ∈ line 0 at hm
    rcases (mem_line _ _).mp hm with he | he
    · have hh := congrArg (MulAut.conj p⁻¹) he
      have hz : transposition 0 = 1 := by simpa [MulAut.conj_apply,mul_assoc] using hh
      exact False.elim ((by decide : transposition 0 ≠ 1) hz)
    · exact he
  have hm : p * transposition 1 * p⁻¹ ∈ ChapterB.Offenders.D 5 := by
    have hh := (mem_normalizer_iff_map_conj_eq.mp hn) ▸
      (mem_map_of_mem (MulAut.conj p).toMonoidHom
        (ChapterB.Offenders.pairSwap_mem (n := 5) (m := 2) 1 (by decide)))
    exact hh
  have h1 := (Enumeration.mem_actor _).mp hm
  have finite_check : ∀ p : FivePerm,
      p * transposition 0 * p⁻¹ = transposition 0 →
      (p * transposition 1 * p⁻¹ = 1 ∨
        p * transposition 1 * p⁻¹ = transposition 0 ∨
        p * transposition 1 * p⁻¹ = transposition 1 ∨
        p * transposition 1 * p⁻¹ = Enumeration.doubleSwap) →
      p = 1 ∨ p = transposition 0 ∨ p = transposition 1 ∨ p = Enumeration.doubleSwap := by
    decide +kernel
  exact (Enumeration.mem_actor _).mpr (finite_check p h0 h1)

theorem AlternatingPairSetup.baumann_normalizes_max_family
    (h : AlternatingPairSetup R K L) (x : G) (hx : x ∈ normalizer (R : Set G))
    (hnc : ¬ (sourceModule K).map (MulAut.conj x⁻¹).toMonoidHom ≤ centralizer (sourceModule K : Set G))
    (hphi : let D := ChapterB.baumann R ⊓ centralizer (K : Set G)
      (frattini D).map D.subtype = ⊥) :
    ∀ A ∈ elementaryAbelianMaxSubgroups R, ChapterB.baumann R ≤ normalizer (A : Set G) := by
  let S := ChapterB.baumann R
  let N := K ⊔ S
  let Q := N.pCoreIn 2
  let W := (sourceModule K).map (MulAut.conj x⁻¹).toMonoidHom ⊔ (S ⊓ centralizer (K : Set G))
  obtain ⟨B₀,B₁,hfam,h0,h1⟩ := h.family_eq_four x hx hnc hphi
  change elementaryAbelianMaxSubgroups R = {Q,W,B₀,B₁} at hfam
  have hQi : actionImage h.action Q = ⊥ := by
    unfold actionImage
    rw [Subgroup.map_eq_bot_iff,h.action_kernel]
    intro q hq
    exact (h.core.le (show (q : G) ∈ Q from hq)).2
  have hWi : actionImage h.action W = ChapterB.Offenders.D 5 := by
    have hVS : (sourceModule K).map (MulAut.conj x⁻¹).toMonoidHom ≤ S :=
      (map_mono h.module_le).trans_eq (mem_normalizer_iff_map_conj_eq.mp
        (normalizer_le_normalizer_baumann R ((normalizer (R : Set G)).inv_mem hx)))
    rw [actionImage_sup h.action (hVS.trans le_sup_right) (inf_le_left.trans le_sup_right)]
    have hd : actionImage h.action (S ⊓ centralizer (K : Set G)) = ⊥ :=
      le_bot_iff.mp ((actionImage_mono h.action (show S ⊓ centralizer (K : Set G) ≤ Q from le_sup_right.trans_eq h.product.symm)).trans hQi.le)
    rw [hd,sup_bot_eq]
    exact h.conjugate_action_image x hx hnc
  have hDbot : ChapterB.Offenders.D 5 ≠ ⊥ := by
    intro he
    have hh := congrArg (fun B : Subgroup FivePerm => Nat.card B) he
    rw [Enumeration.actor_card,Nat.card_unique] at hh
    omega
  have hinj : Set.InjOn (actionImage h.action) (elementaryAbelianMaxSubgroups R) := by
    intro A hA B hB he
    rw [hfam] at hA hB
    simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at hA hB
    change actionImage h.action B₀ = line 0 at h0
    change actionImage h.action B₁ = line 1 at h1
    have h0bot := line_ne_bot 0
    have h1bot := line_ne_bot 1
    have h0D := line_ne_actor 0
    have h1D := line_ne_actor 1
    have h01 := line_zero_ne_one
    rcases hA with rfl | rfl | rfl | rfl <;>
      rcases hB with rfl | rfl | rfl | rfl
    all_goals simp_all only
    all_goals contradiction
  intro A hA g hg
  have hAS : A ≤ S := (baumann_maxFamily R ▸ hA).1
  have hAN : A ≤ N := hAS.trans le_sup_right
  let gN : N := ⟨g,(show S ≤ N from le_sup_right) hg⟩
  have hAiD : actionImage h.action A ≤ ChapterB.Offenders.D 5 := by
    rw [←h.baumann_image]
    exact actionImage_mono h.action hAS
  have hgD : h.action gN ∈ ChapterB.Offenders.D 5 :=
    h.baumann_image ▸ mem_map_of_mem h.action hg
  let := ChapterB.Offenders.Odd.elementary_disjointTranspositions (n := 5) (m := 2) (Or.inl rfl) (by decide)
  have hn : h.action gN ∈ normalizer (actionImage h.action A : Set FivePerm) :=
    ((le_centralizer_iff_isMulCommutative.mpr (inferInstance : IsMulCommutative (ChapterB.Offenders.D 5))).trans
      ((centralizer_le hAiD).trans (Subgroup.centralizer_le_normalizer _))) hgD
  apply mem_normalizer_iff_map_conj_eq.mpr
  change A.map (MulAut.conj g).toMonoidHom = A
  have hAg : A.map (MulAut.conj g).toMonoidHom ∈ elementaryAbelianMaxSubgroups R := by
    have hm := (maxFamily_map_injective_iff (MulAut.conj g).toMonoidHom
      (MulAut.conj g).injective R A).mpr hA
    have he : R.map (MulAut.conj g).toMonoidHom = R :=
      mem_normalizer_iff_map_conj_eq.mp (R.le_normalizer (show g ∈ R from hg.1))
    rwa [he] at hm
  exact hinj hAg hA ((actionImage_conj h.action hAN gN).trans
    (mem_normalizer_iff_map_conj_eq.mp hn))

omit [Finite G] in
private theorem normalizer_image_agrees (h : AlternatingPairSetup R K L)
    (q : normalizer (K : Set G) →* FivePerm)
    (hc : ∀ s : (K ⊔ ChapterB.baumann R : Subgroup G),
      q (inclusion (sup_le K.le_normalizer h.normalizes) s) = h.action s)
    (B : Subgroup G) (hB : B ≤ K ⊔ ChapterB.baumann R) :
    actionImage q B = actionImage h.action B := by
  ext p
  constructor
  · rintro ⟨b,hb,rfl⟩
    let b' : (K ⊔ ChapterB.baumann R : Subgroup G) := ⟨b,hB hb⟩
    exact ⟨b',hb,hc b' |>.symm⟩
  · rintro ⟨b,hb,rfl⟩
    exact ⟨inclusion (sup_le K.le_normalizer h.normalizes) b,hb,hc b⟩

theorem AlternatingPairSetup.extra_family_stabilizer
    (h : AlternatingPairSetup R K L) (hRK : R ≤ normalizer (K : Set G))
    (hfull : R ⊓ centralizer (sourceModule K : Set G) = (K ⊔ ChapterB.baumann R).pCoreIn 2)
    (x : G) (hx : x ∈ normalizer (R : Set G))
    (hnc : ¬ (sourceModule K).map (MulAut.conj x⁻¹).toMonoidHom ≤ centralizer (sourceModule K : Set G))
    (hphi : let D := ChapterB.baumann R ⊓ centralizer (K : Set G)
      (frattini D).map D.subtype = ⊥)
    (B : Subgroup G) (hB : B ∈ elementaryAbelianMaxSubgroups R)
    (hBi : actionImage h.action B = line 0) :
    R ⊓ normalizer (B : Set G) = ChapterB.baumann R := by
  let S := ChapterB.baumann R
  let N := K ⊔ S
  let N' := normalizer (K : Set G)
  have hSN : S ≤ N := le_sup_right
  have hNN' : N ≤ N' := sup_le K.le_normalizer h.normalizes
  have hBS : B ≤ S := (baumann_maxFamily R ▸ hB).1
  obtain ⟨q,hker,hcompat⟩ := h.exists_normalizer_action
  have hSi : actionImage q S = ChapterB.Offenders.D 5 :=
    (normalizer_image_agrees h q hcompat S hSN).trans h.baumann_image
  have hBi' : actionImage q B = line 0 :=
    (normalizer_image_agrees h q hcompat B (hBS.trans hSN)).trans hBi
  apply le_antisymm
  · rintro r ⟨hr,hrB⟩
    let r' : N' := ⟨r,hRK hr⟩
    have hrS : r ∈ normalizer (S : Set G) :=
      normalizer_le_normalizer_baumann R (R.le_normalizer hr)
    have hnD : q r' ∈ normalizer (ChapterB.Offenders.D 5 : Set FivePerm) := by
      apply mem_normalizer_iff_map_conj_eq.mpr
      have he := actionImage_conj q (hSN.trans hNN') r'
      have hrS' : S.map (MulAut.conj (r' : G)).toMonoidHom = S :=
        mem_normalizer_iff_map_conj_eq.mp hrS
      rw [hrS',hSi] at he
      exact he.symm
    have hnB : q r' ∈ normalizer (line 0 : Set FivePerm) := by
      apply mem_normalizer_iff_map_conj_eq.mpr
      have he := actionImage_conj q (hBS.trans (hSN.trans hNN')) r'
      have hrB' : B.map (MulAut.conj (r' : G)).toMonoidHom = B :=
        mem_normalizer_iff_map_conj_eq.mp hrB
      rw [hrB',hBi'] at he
      exact he.symm
    have hrD := line_stabilizer_in_actor_normalizer (q r') hnD hnB
    obtain ⟨s,hs,hes⟩ := (show q r' ∈ actionImage q S from hSi.symm ▸ hrD)
    have hks : s⁻¹*r' ∈ q.ker := by
      change q (s⁻¹*r') = 1
      simp only [map_mul,map_inv,hes,inv_mul_cancel]
    have hcs : (s : G)⁻¹*r ∈ centralizer (sourceModule K : Set G) := hker.le hks
    have hsr : (s : G)⁻¹*r ∈ R := R.mul_mem (R.inv_mem (show (s : G) ∈ R from hs.1)) hr
    have hss : (s : G)⁻¹*r ∈ S := h.core.le (hfull ▸ (show (s : G)⁻¹*r ∈ R ⊓
      centralizer (sourceModule K : Set G) from ⟨hsr,hcs⟩)) |>.1
    have hh := S.mul_mem hs hss
    change (s : G) * ((s : G)⁻¹*r) ∈ S at hh
    simpa only [mul_inv_cancel_left] using hh
  · exact le_inf inf_le_left (h.baumann_normalizes_max_family x hx hnc hphi B hB)

end CFSG.Quasithin.ChapterC.Section05.ConjugateSource

namespace CFSG.Quasithin.ChapterC.Section06
open Section05.BlockAnalysis Section05.ConjugateSource
open CFSG.Quasithin.ChapterE.Section06.InvariantSubspaces.LocalIndex.Conjugates.AlternatingFamily
variable {G : Type*} [Group G] [Finite G] {H M K R L : Subgroup G}

theorem alternating_action_from_original
    (c : OriginalHypotheses H M K R R) (h : AlternatingPairSetup R K L)
    (hi : R.relIndex M = 2) (x : G) (hx : x ∈ M)
    (hnc : ¬ (sourceModule K).map (MulAut.conj x⁻¹).toMonoidHom ≤
      centralizer (sourceModule K : Set G)) :
    (elementaryAbelianMaxJ R).relIndex R = 2 ∧
      (∀ A ∈ elementaryAbelianMaxSubgroups R, elementaryAbelianMaxJ R ≤ normalizer (A : Set G)) ∧
      ∃ B ∈ elementaryAbelianMaxSubgroups R,
        R ⊓ normalizer (B : Set G) = elementaryAbelianMaxJ R := by
  have hRK := c.R_le_H.trans c.normalizes_residual
  have hH : H = K ⊔ R := c.residual_sup_sylow.symm
  have hno (W : Subgroup G) (hWR : W ≤ R) (hHW : H ≤ normalizer (W : Set G))
      (hMW : M ≤ normalizer (W : Set G)) : W = ⊥ :=
    c.no_common_normal W hWR ((normal_subgroupOf_iff_le_normalizer
      (hWR.trans (c.R_le_M.trans le_sup_left))).mpr (sup_le hMW hHW))
  have hphi := h.frattini_eq_bot_of_index_two H M R c.T_le c.R_normal hRK hH hno hi x hx hnc
  have hf := alternating_family_from_original c h hi x hx hnc
  have hJ := hf.2.2.2.2.1
  let Q := (K ⊔ ChapterB.baumann R).pCoreIn 2
  let W := (sourceModule K).map (MulAut.conj x⁻¹).toMonoidHom ⊔
    (ChapterB.baumann R ⊓ centralizer (K : Set G))
  obtain ⟨B,r,hr,hrS,hfam,hBi,hnB,hnB'⟩ := h.family_exchange x (c.R_normal hx) hnc hphi
  have hB : B ∈ elementaryAbelianMaxSubgroups R := by rw [hfam]; simp
  have hfull : R ⊓ centralizer (sourceModule K : Set G) = Q :=
    (original_core_eq_module_centralizer c h.block.2.1).trans hf.1.symm
  have hstab := h.extra_family_stabilizer hRK hfull x (c.R_normal hx) hnc hphi B hB hBi
  have hnormQ : R ≤ normalizer (Q : Set G) := by
    change R ≤ normalizer ((K ⊔ ChapterB.baumann R).pCoreIn 2 : Set G)
    rw [hf.1]
    exact c.R_le_H.trans (H.le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image H (pCore 2 H)))
  have hnormW : R ≤ normalizer (W : Set G) := by
    have he := (h.family_structure hRK x (c.R_normal hx) hnc hphi).1
    change W = Q.map (MulAut.conj x⁻¹).toMonoidHom at he
    rw [he]
    have heR : R.map (MulAut.conj x⁻¹).toMonoidHom = R :=
      mem_normalizer_iff_map_conj_eq.mp (c.R_normal (M.inv_mem hx))
    rw [←heR]
    exact (map_mono hnormQ).trans (le_normalizer_map (MulAut.conj x⁻¹).toMonoidHom)
  have hpair (g : G) (hg : g ∈ R) :
      B.map (MulAut.conj g).toMonoidHom = B ∨
      B.map (MulAut.conj g).toMonoidHom = B.map (MulAut.conj r).toMonoidHom := by
    have heR : R.map (MulAut.conj g).toMonoidHom = R :=
      mem_normalizer_iff_map_conj_eq.mp (R.le_normalizer hg)
    have hh := (maxFamily_map_injective_iff (MulAut.conj g).toMonoidHom
      (MulAut.conj g).injective R B).mpr hB
    rw [heR,hfam] at hh
    simp only [Set.mem_insert_iff,Set.mem_singleton_iff] at hh
    rcases hh with he | he | he | he
    · have hQ : Q.map (MulAut.conj g).toMonoidHom = Q :=
        mem_normalizer_iff_map_conj_eq.mp (hnormQ hg)
      have hBQ : B = Q := map_injective (MulAut.conj g).injective (he.trans hQ.symm)
      exact (hnB (hBQ.symm ▸ hnormQ)).elim
    · have hW : W.map (MulAut.conj g).toMonoidHom = W :=
        mem_normalizer_iff_map_conj_eq.mp (hnormW hg)
      have hBW : B = W := map_injective (MulAut.conj g).injective (he.trans hW.symm)
      exact (hnB (hBW.symm ▸ hnormW)).elim
    · exact Or.inl he
    · exact Or.inr he
  have hmove : B.map (MulAut.conj r).toMonoidHom ≠ B := by
    intro he
    exact hrS (hstab ▸ (show r ∈ R ⊓ normalizer (B : Set G) from
      ⟨hr.1,mem_normalizer_iff_map_conj_eq.mpr he⟩))
  have hiR := normalizer_relIndex_eq_two_of_pair R B
    (B.map (MulAut.conj r).toMonoidHom) hpair r hr.1 hmove
  refine ⟨?_,?_,⟨B,hB,hstab.trans hJ⟩⟩
  · rw [←hJ,←hstab,inf_relIndex_left]
    exact hiR
  · intro A hA
    rw [←hJ]
    exact h.baumann_normalizes_max_family x (c.R_normal hx) hnc hphi A hA

theorem alternating_family_kernel_from_original
    (c : OriginalHypotheses H M K R R) (h : AlternatingPairSetup R K L)
    (Λ : Subgroup G)
    (hcontrol : Λ ⊓ normalizer (H.pCoreIn 2 : Set G) = R)
    (hi : R.relIndex M = 2) (x : G) (hx : x ∈ M)
    (hnc : ¬ (sourceModule K).map (MulAut.conj x⁻¹).toMonoidHom ≤
      centralizer (sourceModule K : Set G)) :
    ∀ g ∈ Λ, (∀ A ∈ elementaryAbelianMaxSubgroups R, g ∈ normalizer (A : Set G)) ↔
      g ∈ elementaryAbelianMaxJ R := by
  obtain ⟨_,hn, B,hB,hstab⟩ := alternating_action_from_original c h hi x hx hnc
  have hQ : H.pCoreIn 2 ∈ elementaryAbelianMaxSubgroups R := by
    obtain ⟨_,_,_,_,_,_,_,A,r,_,_,_,hfamily⟩ := alternating_family_from_original c h hi x hx hnc
    rw [hfamily]
    exact Set.mem_insert _ _
  intro g hg
  constructor
  · intro hall
    have hr : g ∈ R := hcontrol ▸ ⟨hg,hall _ hQ⟩
    exact hstab ▸ ⟨hr,hall B hB⟩
  · intro hj A hA
    exact hn A hA hj

end CFSG.Quasithin.ChapterC.Section06
