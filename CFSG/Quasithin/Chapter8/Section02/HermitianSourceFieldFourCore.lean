/-!
# The field-four pair core

At selected parameter one, E.2.10(6) identifies the two-core with the
product of the two elementary factors. Transporting the native central
quotient to the literal ambient core gives an elementary abelian quotient
of order 2^8 over the original rank-four fixed subgroup. Thus the core
has order 2^12. The fixed-space identity identifies that subgroup with the
center of the core, using the general two-conjugate center calculation.
E.2.13(7) then identifies the kernel of I on that quotient with O₂(I).

Minimality of the original H-star subgroup gives H = ⟨I,T⟩. Consequently
H normalizes the fixed subgroup and its two-residual centralizes it.
These supply core and normalizer inputs for the field-four argument;
they do not prove selection, r = 5, or the final source exclusion.

Source: Aschbacher–Smith E.2.10(1,2,6), E.2.13(7), 8.2.5 and the opening
of 8.2.9, printed pp.222–225, 716–720 (1 March 2004 manuscript, refs/quasithin.pdf).
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
open Representation.HermitianTensorThree Representation.HermitianTensorThree.ImageOuter
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter8.Section02.HermitianSource
open ChapterE Offenders.Parabolic Offenders.Parabolic.Construction
variable {G : Type*} [Group G] [Finite G]
  {V : Subgroup G} [IsElementaryAbelian 2 V] {T : Sylow 2 G}
  {H M I : Subgroup G} {k : ℕ} {i : I} {S : Sylow 2 I}

private theorem selected_one_native_core (s : Selected H T M V I 1 i S) :
    TwoConjugate.P (V.subgroupOf I) (M.subgroupOf I) i⁻¹ = pCore 2 I := by
  have hcard : Nat.card ((V.subgroupOf I).map (QuotientGroup.mk' (localCore M I))) = 2 := by
    let := s.twoConjugate.elementary
    let : IsElementaryAbelian 2 (coreImage I V) := IsElementaryAbelian.map _
    have hn : coreImage I V ≠ ⊥ := by
      intro he
      have hr := s.rank_eq
      rw [he,Representation.BinaryOffender.rank_bot] at hr
      omega
    have hc := (show IsElementaryTwo (coreImage I V) from ⟨hn,inferInstance⟩).card_eq_two_pow_rank
    rw [s.rank_eq] at hc
    rw [← relIndex_ker,QuotientGroup.ker_mk',s.core_eq,←QuotientGroup.ker_mk' (pCore 2 I),relIndex_ker]
    exact hc
  exact (s.twoConjugate.odd_dihedral hcard).1

/-- The literal pair core is generated by its two elementary factors. -/
theorem selected_one_core_product (s : Selected H T M V I 1 i S) :
    I.pCoreIn 2 = (V ⊓ I.pCoreIn 2) ⊔
      (V.map (MulAut.conj i.val⁻¹).toMonoidHom ⊓ I.pCoreIn 2) := by
  have hVI : V ≤ I := s.generate ▸ le_sup_left
  have hb : (TwoConjugate.B (V.subgroupOf I) (M.subgroupOf I)).map I.subtype =
      V ⊓ I.pCoreIn 2 := by
    rw [s.twoConjugate.B_eq_twoCore_inf,map_inf _ _ _ I.subtype_injective,
      map_subgroupOf_eq_of_le hVI,inf_comm]
    rfl
  have hp := congrArg (fun D : Subgroup I => D.map I.subtype) (selected_one_native_core s)
  rw [TwoConjugate.P,Subgroup.map_sup,hb,selected_actor_image I M V hVI S i s.twoConjugate] at hp
  exact hp.symm

private theorem selected_not_le_maximal (s : Selected H T M V I k i S) : ¬ I ≤ M := by
  intro hIM
  have hm : M.subgroupOf I = ⊤ := by
    apply top_unique
    intro x _
    exact hIM x.property
  have hc : localCore M I = ⊤ := by simp [localCore,hm]
  have he : coreImage I V = ⊥ := by
    apply bot_unique
    rintro _ ⟨v,hv,rfl⟩
    exact (QuotientGroup.eq_one_iff v).mpr (by rw [←s.core_eq,hc]; trivial)
  have hr := s.rank_eq
  rw [he,Representation.BinaryOffender.rank_bot] at hr
  have hk := s.positive
  omega

/-- H-star minimality identifies the group generated by the selected I and T. -/
theorem selected_generates_hstar (s : Selected H T M V I k i S)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) M) : I ⊔ (T : Subgroup G) = H := by
  have hle : I ⊔ (T : Subgroup G) ≤ H := sup_le s.family.le_ambient hH.1.1.2
  apply eq_of_le_of_not_lt hle
  intro hlt
  exact selected_not_le_maximal s
    (le_sup_left.trans (Chapter3.HStar.proper_overgroup_le T hH le_sup_right hlt))

private theorem selected_one_native_section (s : Selected H T M V I 1 i S) :
    let := s.twoConjugate.Z_normal
    let q := QuotientGroup.mk' (TwoConjugate.Z (V.subgroupOf I) i⁻¹)
    let A := V.map (MulAut.conj i.val⁻¹).toMonoidHom ⊓ I.pCoreIn 2
    IsElementaryAbelian 2 ((pCore 2 I).map q) ∧
      rank ((pCore 2 I).map q) = 2 * rank (inducedAutomizer V A) := by
  let := s.twoConjugate.Z_normal
  let q := QuotientGroup.mk' (TwoConjugate.Z (V.subgroupOf I) i⁻¹)
  have hp := selected_one_native_core s
  have he := s.twoConjugate.quotient_direct_sum.1
  rw [hp] at he
  let := he
  have hd : rank ((TwoConjugate.P (V.subgroupOf I) (M.subgroupOf I) i⁻¹).map q) =
      2 * Nat.log 2 ((TwoConjugate.Z (V.subgroupOf I) i⁻¹).relIndex
        (TwoConjugate.A (V.subgroupOf I) (M.subgroupOf I) i⁻¹)) := by
    let := s.twoConjugate.quotient_direct_sum.1
    rw [rank,show Nat.card ((TwoConjugate.P (V.subgroupOf I) (M.subgroupOf I) i⁻¹).map q) =
      Nat.card (Additive ((TwoConjugate.P (V.subgroupOf I) (M.subgroupOf I) i⁻¹).map q)) from rfl,
      Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod,Nat.log_pow Nat.one_lt_two]
    exact s.twoConjugate.quotient_core_finrank_eq_twice_actor
  rw [hp] at hd
  have hVI : V ≤ I := s.generate ▸ le_sup_left
  have hi := relIndex_map_map_of_injective (f := I.subtype)
    (TwoConjugate.Z (V.subgroupOf I) i⁻¹)
    (TwoConjugate.A (V.subgroupOf I) (M.subgroupOf I) i⁻¹) I.subtype_injective
  rw [selected_intersection_image I V hVI i,
    selected_actor_image I M V hVI S i s.twoConjugate] at hi
  have hcoreM : (pCore 2 I).map I.subtype ≤ M := by
    rintro _ ⟨a,ha,rfl⟩
    apply (M.subgroupOf I).normalCore_le
    change a ∈ localCore M I
    rwa [s.core_eq]
  have hAN : V.map (MulAut.conj i.val⁻¹).toMonoidHom ⊓ (pCore 2 I).map I.subtype ≤
      normalizer (V : Set G) := inf_le_right.trans
    ((le_inf hcoreM (map_subtype_le _)).trans (s.normalizer_eq ▸ inf_le_right))
  have hr := rank_inducedAutomizer V
    (V.map (MulAut.conj i.val⁻¹).toMonoidHom ⊓ (pCore 2 I).map I.subtype) hAN
  rw [selected_actor_kernel I M V hVI S i s.twoConjugate] at hr
  refine ⟨he,?_⟩
  change rank ((pCore 2 I).map q) = 2 * rank (inducedAutomizer V
    (V.map (MulAut.conj i.val⁻¹).toMonoidHom ⊓ (pCore 2 I).map I.subtype))
  rw [hr,subgroupCorank,hi]
  exact hd


/-- The actual central quotient is elementary abelian of rank eight, and the
original core has order 2^12. -/
theorem selected_one_core_section
    (s : Selected H T M V I 1 i S) (hT : HypothesisE322 V T)
    (n : ℕ) [NeZero n]
    (e : Additive V ≃ₗ[ZMod 2] Space n)
    (j : Automizer V →* binaryNormalizer n) (hj : Function.Injective j)
    (he : ∀ a v, e (automizerRepresentation V a v) =
      overgroupAction n (binaryNormalizer n) (j a) (e v)) :
    let A := V.map (MulAut.conj i.val⁻¹).toMonoidHom ⊓ I.pCoreIn 2
    let U := V ⊓ centralizer (A : Set G)
    ∃ _hU : (U.subgroupOf (I.pCoreIn 2)).Normal,
      IsElementaryAbelian 2 (I.pCoreIn 2 ⧸ U.subgroupOf (I.pCoreIn 2)) ∧
      Nat.card (I.pCoreIn 2 ⧸ U.subgroupOf (I.pCoreIn 2)) = 2^8 ∧
      Nat.card (I.pCoreIn 2) = 2^12 := by
  obtain ⟨hn,hAT,ha,hu,hUeq,_,_,hIC,_,_⟩ := selected_one_fixed_subgroup s hT n e j hj he
  let A := V.map (MulAut.conj i.val⁻¹).toMonoidHom ⊓ I.pCoreIn 2
  let U := V ⊓ centralizer (A : Set G)
  let P := I.pCoreIn 2
  have hPI : P ≤ I := pCoreIn_le 2 I
  have hVI : V ≤ I := s.generate ▸ le_sup_left
  let Zi := TwoConjugate.Z (V.subgroupOf I) i⁻¹
  let := s.twoConjugate.Z_normal
  let q := QuotientGroup.mk' Zi
  let Q := (pCore 2 I).map q
  obtain ⟨helem,hrank⟩ := selected_one_native_section s
  let : IsElementaryAbelian 2 Q := helem
  change rank Q = 2 * rank (inducedAutomizer V A) at hrank
  change rank (inducedAutomizer V A) = 4 at ha
  have hqcard : Nat.card Q = 2^8 := by
    obtain ⟨a,heq⟩ := (IsElementaryAbelian.isPGroup 2 Q).exists_card_eq
    have hr : rank Q = a := by rw [rank,heq,Nat.log_pow Nat.one_lt_two]
    have ha8 : a = 8 := by omega
    simpa only [ha8] using heq
  have hZi : Zi.map I.subtype = U :=
    (selected_intersection_image I V hVI i).trans hUeq.symm
  have hUP : U ≤ P := by
    rw [←hZi]
    exact map_mono ((s.twoConjugate.core_geometry.2.2.trans inf_le_left).trans
      s.twoConjugate.P_le_twoCore)
  have hUN : (U.subgroupOf P).Normal := normal_subgroupOf_of_le_normalizer
    ((hPI.trans hIC).trans (Subgroup.centralizer_le_normalizer _))
  let := hUN
  let f : P →* Q := ((q.comp (inclusion hPI)).codRestrict Q (fun x => by
    apply mem_map_of_mem
    obtain ⟨y,hy,hxy⟩ := x.property
    have hyx : y = inclusion hPI x := Subtype.ext hxy
    exact hyx ▸ hy))
  have hf : Function.Surjective f := by
    rintro ⟨y,a,ha,rfl⟩
    exact ⟨⟨a,mem_map_of_mem I.subtype ha⟩,rfl⟩
  have hk : f.ker = U.subgroupOf P := by
    ext x
    change (⟨q (inclusion hPI x),_⟩ : Q) = 1 ↔ (x : G) ∈ U
    rw [Subtype.ext_iff]
    change ((inclusion hPI x : I) : I ⧸ Zi) = 1 ↔ (x : G) ∈ U
    rw [QuotientGroup.eq_one_iff,←hZi]
    constructor
    · intro hx
      exact mem_map_of_mem I.subtype hx
    · rintro ⟨a,ha,hax⟩
      exact (show a = inclusion hPI x from Subtype.ext hax) ▸ ha
  let ep : (P ⧸ U.subgroupOf P) ≃* Q :=
    (QuotientGroup.quotientMulEquivOfEq hk.symm).trans
      (QuotientGroup.quotientKerEquivOfSurjective f hf)
  have hel : IsElementaryAbelian 2 (P ⧸ U.subgroupOf P) :=
    IsElementaryAbelian.of_injective ep.toMonoidHom ep.injective
  have hc : Nat.card (P ⧸ U.subgroupOf P) = 2^8 :=
    (Nat.card_congr ep.toEquiv).trans hqcard
  have hUcard : Nat.card U = 2^4 := by
    obtain ⟨a,hea⟩ := ((IsElementaryAbelian.isPGroup 2 V).to_le
      (show U ≤ V from inf_le_left)).exists_card_eq
    change rank U = 4 at hu
    rw [rank,hea,Nat.log_pow Nat.one_lt_two] at hu
    simpa only [hu] using hea
  have hPcard := (U.subgroupOf P).card_mul_index
  rw [Nat.card_congr (subgroupOfEquivOfLe hUP).toEquiv,hUcard,
    index_eq_card,hc] at hPcard
  exact ⟨hUN,hel,hc,by norm_num at hPcard ⊢; exact hPcard.symm⟩

/-- H normalizes the original fixed subgroup, and its two-residual centralizes it. -/
theorem selected_one_hstar_normalizer
    (s : Selected H T M V I 1 i S) (hH : H ∈ Chapter3.HStar (T : Subgroup G) M)
    (hT : HypothesisE322 V T) (n : ℕ) [NeZero n]
    (e : Additive V ≃ₗ[ZMod 2] Space n)
    (j : Automizer V →* binaryNormalizer n) (hj : Function.Injective j)
    (he : ∀ a v, e (automizerRepresentation V a v) =
      overgroupAction n (binaryNormalizer n) (j a) (e v)) :
    let A := V.map (MulAut.conj i.val⁻¹).toMonoidHom ⊓ I.pCoreIn 2
    let U := V ⊓ centralizer (A : Set G)
    H ≤ normalizer (U : Set G) ∧ (pResidual 2 H).map H.subtype ≤ centralizer (U : Set G) := by
  obtain ⟨_,_,_,_,_,_,hTN,hIC,_,_⟩ := selected_one_fixed_subgroup s hT n e j hj he
  have hgen := selected_generates_hstar s hH
  refine ⟨?_,Normalizer.residual_centralizes H I T _ hgen T.isPGroup' hIC hTN⟩
  rw [←hgen]
  exact sup_le (hIC.trans (Subgroup.centralizer_le_normalizer _)) hTN


/-- The center of the original two-core is exactly the fixed subgroup U. -/
theorem selected_one_center
    (s : Selected H T M V I 1 i S) (hT : HypothesisE322 V T)
    (n : ℕ) [NeZero n]
    (e : Additive V ≃ₗ[ZMod 2] Space n)
    (j : Automizer V →* binaryNormalizer n) (hj : Function.Injective j)
    (he : ∀ a v, e (automizerRepresentation V a v) =
      overgroupAction n (binaryNormalizer n) (j a) (e v)) :
    let A := V.map (MulAut.conj i.val⁻¹).toMonoidHom ⊓ I.pCoreIn 2
    let U := V ⊓ centralizer (A : Set G)
    (center (pCore 2 I)).map (I.subtype.comp (pCore 2 I).subtype) = U := by
  obtain ⟨_,_,_,_,hUeq,_,_,_,_,_⟩ := selected_one_fixed_subgroup s hT n e j hj he
  let An := TwoConjugate.A (V.subgroupOf I) (M.subgroupOf I) i⁻¹
  let Zn := TwoConjugate.Z (V.subgroupOf I) i⁻¹
  have hVI : V ≤ I := s.generate ▸ le_sup_left
  have hAi := selected_actor_image I M V hVI S i s.twoConjugate
  have hZi := selected_intersection_image I V hVI i
  have hfix : V.subgroupOf I ⊓ centralizer (An : Set I) = Zn := by
    apply Subgroup.map_injective I.subtype_injective
    rw [hZi,←hUeq]
    apply le_antisymm
    · rintro _ ⟨x,hx,rfl⟩
      refine ⟨hx.1,?_⟩
      intro a ha
      rw [←hAi] at ha
      obtain ⟨b,hb,rfl⟩ := ha
      exact congrArg Subtype.val (hx.2 b hb)
    · intro x hx
      refine ⟨⟨x,hVI hx.1⟩,⟨hx.1,?_⟩,rfl⟩
      intro a ha
      exact Subtype.ext (hx.2 a.val (hAi ▸ mem_map_of_mem I.subtype ha))
  have hc := s.twoConjugate.center_P_eq_Z_of_V_fixed hfix
  have hp := selected_one_native_core s
  have hc' : (center (pCore 2 I)).map (pCore 2 I).subtype = Zn := by
    exact (congrArg (fun P : Subgroup I => (center P).map P.subtype) hp).symm.trans hc
  rw [←map_map,hc',hZi]
  exact hUeq.symm

private theorem selected_one_native_section_kernel
    (s : Selected H T M V I 1 i S) :
    let := s.twoConjugate.Z_normal
    centralizerModulo ⊤ (pCore 2 I) (TwoConjugate.Z (V.subgroupOf I) i⁻¹) = pCore 2 I := by
  let := s.twoConjugate.Z_normal
  let q := QuotientGroup.mk' (TwoConjugate.Z (V.subgroupOf I) i⁻¹)
  have hp := selected_one_native_core s
  have hc := s.twoConjugate.quotient_core_centralizer_le s.characteristic_two
  rw [hp] at hc
  have he := s.twoConjugate.quotient_direct_sum.1
  rw [hp] at he
  let := he
  apply le_antisymm
  · simpa only [centralizerModulo,top_inf_eq] using hc
  · intro x hx
    apply mem_centralizerModulo_iff.mpr
    refine ⟨mem_top x,?_⟩
    intro a ha
    apply (QuotientGroup.eq_one_iff _).mp
    change q ⁅a,x⁆ = 1
    rw [map_commutatorElement]
    exact commutatorElement_eq_one_iff_mul_comm.mpr
      (congrArg Subtype.val (mul_comm
        (⟨q a,mem_map_of_mem q ha⟩ : (pCore 2 I).map q)
        (⟨q x,mem_map_of_mem q hx⟩ : (pCore 2 I).map q)))

/-- The kernel of the original action of I on its core modulo U is exactly
its two-core, as required by the field-four tensor argument. -/
theorem selected_one_section_kernel
    (s : Selected H T M V I 1 i S) (hT : HypothesisE322 V T)
    (n : ℕ) [NeZero n]
    (e : Additive V ≃ₗ[ZMod 2] Space n)
    (j : Automizer V →* binaryNormalizer n) (hj : Function.Injective j)
    (he : ∀ a v, e (automizerRepresentation V a v) =
      overgroupAction n (binaryNormalizer n) (j a) (e v)) :
    let A := V.map (MulAut.conj i.val⁻¹).toMonoidHom ⊓ I.pCoreIn 2
    let U := V ⊓ centralizer (A : Set G)
    ∃ _hU : (U.subgroupOf I).Normal,
      centralizerModulo ⊤ (pCore 2 I) (U.subgroupOf I) = pCore 2 I := by
  obtain ⟨_,_,_,_,hUeq,_,_,_,_,_⟩ := selected_one_fixed_subgroup s hT n e j hj he
  let A := V.map (MulAut.conj i.val⁻¹).toMonoidHom ⊓ I.pCoreIn 2
  let U := V ⊓ centralizer (A : Set G)
  let Z := TwoConjugate.Z (V.subgroupOf I) i⁻¹
  have hVI : V ≤ I := s.generate ▸ le_sup_left
  have hZi : Z.map I.subtype = U :=
    (selected_intersection_image I V hVI i).trans hUeq.symm
  have hz : U.subgroupOf I = Z := by
    apply Subgroup.map_injective I.subtype_injective
    rw [map_subgroupOf_eq_of_le (inf_le_left.trans hVI),hZi]
  have hUN : (U.subgroupOf I).Normal := hz ▸ s.twoConjugate.Z_normal
  refine ⟨hUN,?_⟩
  let := s.twoConjugate.Z_normal
  let := hUN
  have hk := selected_one_native_section_kernel s
  apply le_antisymm
  · intro x hx
    apply hk.le
    apply mem_centralizerModulo_iff.mpr
    exact ⟨mem_top x,fun a ha => hz.le ((mem_centralizerModulo_iff.mp hx).2 a ha)⟩
  · intro x hx
    apply mem_centralizerModulo_iff.mpr
    exact ⟨mem_top x,fun a ha => hz.ge
      ((mem_centralizerModulo_iff.mp (hk.ge hx)).2 a ha)⟩

