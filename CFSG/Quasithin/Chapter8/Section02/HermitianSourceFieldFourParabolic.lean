set_option backward.isDefEq.respectTransparency false

/-- The full natural section is generated by the original commutators, retaining U. -/
theorem NaturalSectionAction.commutator_span {R B U : Subgroup G}
    (h : NaturalSectionAction R B U) (hUB : U ≤ B) :
    B = ⁅B,R⁆ ⊔ U := by
  obtain ⟨hRB,hRU,hBU,eB,eR,he⟩ := h
  let := hBU
  let p := eB.toMonoidHom.comp (QuotientGroup.mk' (U.subgroupOf B))
  let C := ⁅B,R⁆ ⊔ U
  let D := (C.subgroupOf B).map p
  have hp : Function.Surjective p := eB.surjective.comp (QuotientGroup.mk'_surjective _)
  have hk : p.ker = U.subgroupOf B := by
    ext x
    change eB (QuotientGroup.mk' (U.subgroupOf B) x) = 1 ↔ _
    rw [eB.map_eq_one_iff]
    exact QuotientGroup.eq_one_iff x
  have hd : D = ⊤ := by
    apply Matrix.SL2.naturalAction_displacements_generate
    intro g w
    obtain ⟨r,hr⟩ := (eR.surjective.comp (QuotientGroup.mk'_surjective (pCore 2 R))) g
    change eR (QuotientGroup.mk' (pCore 2 R) r) = g at hr
    obtain ⟨b,rfl⟩ := hp w
    let b' := B.normalizerMonoidHom (inclusion hRB r) b
    have hc : ((b' * b⁻¹ : B) : G) ∈ C := by
      apply mem_sup_left
      rw [commutator_comm]
      exact commutator_mem_commutator r.property b.property
    refine ⟨b' * b⁻¹,hc,?_⟩
    rw [map_mul,map_inv]
    congr 1
    change eB (QuotientGroup.mk' (U.subgroupOf B) b') = _
    rw [←sectionAction_apply R B U hRB hRU r b,he,hr]
    rfl
  apply le_antisymm
  · intro b hb
    obtain ⟨c,hc,heq⟩ := mem_map.mp (show p ⟨b,hb⟩ ∈ D from hd ▸ mem_top _)
    have hker : c⁻¹ * ⟨b,hb⟩ ∈ p.ker := by
      change p (c⁻¹ * ⟨b,hb⟩) = 1
      rw [map_mul,map_inv,heq,inv_mul_cancel]
    rw [hk] at hker
    have hc' : (c : G) ∈ C := hc
    have hm := C.mul_mem hc' (mem_sup_right hker)
    simpa only [Subgroup.subtype_apply,coe_mul,coe_inv,mul_inv_cancel_left] using hm
  · exact sup_le (le_normalizer_iff_commutator_le_left.mp hRB) hUB

/-- The selected parameter one is the literal index of B₀ in V. -/
theorem selected_one_core_index [Finite G]
    {V H M I : Subgroup G} {T : Sylow 2 G} [IsElementaryAbelian 2 V]
    {i : I} {S : Sylow 2 I} (s : Selected H T M V I 1 i S) :
    (V ⊓ I.pCoreIn 2).relIndex V = 2 := by
  have hVI : V ≤ I := s.generate ▸ le_sup_left
  let := s.twoConjugate.elementary
  let : IsElementaryAbelian 2 (coreImage I V) := IsElementaryAbelian.map _
  have hc : Nat.card (coreImage I V) = 2 ^ rank (coreImage I V) := by
    obtain ⟨d,hd⟩ := (IsElementaryAbelian.isPGroup 2 (coreImage I V)).exists_card_eq
    rw [rank,hd,Nat.log_pow Nat.one_lt_two]
  rw [s.rank_eq,pow_one] at hc
  change Nat.card ((V.subgroupOf I).map (QuotientGroup.mk' (pCore 2 I))) = 2 at hc
  rw [←relIndex_ker,QuotientGroup.ker_mk'] at hc
  have hm := relIndex_map_map_of_injective (pCore 2 I) (V.subgroupOf I) I.subtype_injective
  rw [map_subgroupOf_eq_of_le hVI] at hm
  rw [inf_relIndex_left]
  exact hm.trans hc

/-- The natural section places B₀ in O₂(H) and identifies V’s image as an involution group. -/
theorem selected_one_hstar_core_intersection [Finite G]
    {V H M I L U : Subgroup G} {T : Sylow 2 G} [IsElementaryAbelian 2 V]
    {i : I} {S : Sylow 2 I} (s : Selected H T M V I 1 i S)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) M)
    (hIC : I ≤ centralizer (U : Set G))
    (hTL : (T : Subgroup G) ≤ normalizer (L : Set G))
    (hTU : (T : Subgroup G) ≤ normalizer (U : Set G))
    (hUB : U ≤ V ⊓ I.pCoreIn 2)
    (hcomm : ⁅Normalizer.localResidual L U,centralizer (U : Set G)⁆ ≤
      (Normalizer.localResidual L U).pCoreIn 2)
    (hn : NaturalSectionAction (Normalizer.localResidual L U) (V ⊓ I.pCoreIn 2) U) :
    (Normalizer.localResidual L U).pCoreIn 2 ⊔ U ≤ H.pCoreIn 2 ∧
      V ⊓ I.pCoreIn 2 = V ⊓ H.pCoreIn 2 ∧
      Nat.card ((V.subgroupOf H).map (QuotientGroup.mk' (pCore 2 H))) = 2 := by
  let R := Normalizer.localResidual L U
  let B := V ⊓ I.pCoreIn 2
  have hVI : V ≤ I := s.generate ▸ le_sup_left
  have hgen := selected_generates_hstar s hH
  have hTR := Normalizer.normalizes_localResidual L U (T : Subgroup G) hTL hTU
  have hQT : R.pCoreIn 2 ≤ (T : Subgroup G) :=
    (isPGroup_pCoreIn 2 R).le_sylow_of_normalized T
      (hTR.trans (normalizer_le_normalizer_characteristic_image R (pCore 2 R)))
  have hcore := SmallRows.localCore_join_le_parabolicCore L H I U (T : Subgroup G)
    hgen T.isPGroup' hIC hTL hTU hQT
    ((hUB.trans inf_le_left).trans s.family.le_sylow) hcomm
  have hB : B ≤ H.pCoreIn 2 := by
    change V ⊓ I.pCoreIn 2 ≤ _
    rw [hn.commutator_span hUB]
    apply le_trans (sup_le_sup_right ?_ U) hcore
    rw [commutator_comm]
    exact (commutator_mono le_rfl ((inf_le_left.trans hVI).trans hIC)).trans hcomm
  have hback : V ⊓ H.pCoreIn 2 ≤ B := by
    apply le_inf inf_le_left
    exact (le_inf inf_le_right (inf_le_left.trans hVI)).trans
      (pCoreIn_inf_le_of_normalizes (s.family.le_ambient.trans H.le_normalizer))
  have he : B = V ⊓ H.pCoreIn 2 := le_antisymm (le_inf inf_le_left hB) hback
  refine ⟨hcore,he,?_⟩
  rw [←relIndex_ker,QuotientGroup.ker_mk']
  have hm := relIndex_map_map_of_injective (pCore 2 H) (V.subgroupOf H) H.subtype_injective
  rw [map_subgroupOf_eq_of_le (hVI.trans s.family.le_ambient)] at hm
  rw [←hm,←inf_relIndex_left]
  change (V ⊓ H.pCoreIn 2).relIndex V = 2
  rw [←he]
  exact selected_one_core_index s

/-- The actual SL₂(4) residual and its normalizer bound both odd ranks of H by one. -/
theorem selected_one_hstar_odd_ranks [Finite G]
    {V H M I L U : Subgroup G} {T : Sylow 2 G} [IsElementaryAbelian 2 V]
    {i : I} {S : Sylow 2 I} (s : Selected H T M V I 1 i S)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) M)
    (hTM : (T : Subgroup G) ≤ M)
    (hIC : I ≤ centralizer (U : Set G))
    (hTL : (T : Subgroup G) ≤ normalizer (L : Set G))
    (hTU : (T : Subgroup G) ≤ normalizer (U : Set G))
    (hcomm : ⁅Normalizer.localResidual L U,centralizer (U : Set G)⁆ ≤
      (Normalizer.localResidual L U).pCoreIn 2)
    (hR : Nonempty ((Normalizer.localResidual L U ⧸
      pCore 2 (Normalizer.localResidual L U)) ≃* SL(2,E 1)))
    (hthin : IsStronglyQuasithin (normalizer (U : Set G))) :
    primeRank 3 H ≤ 1 ∧ primeRank 5 H ≤ 1 := by
  have hgen := selected_generates_hstar s hH
  have hIM : ¬ I ≤ M := by
    intro hi
    apply hH.1.2
    rw [←hgen]
    exact sup_le hi hTM
  have hHN : H ≤ normalizer (U : Set G) := by
    rw [←hgen]
    exact sup_le (hIC.trans (Subgroup.centralizer_le_normalizer _)) hTU
  have hjoin : H ⊔ Normalizer.localResidual L U ≤ normalizer (U : Set G) :=
    sup_le hHN ((Normalizer.localResidual_le L U).trans inf_le_right)
  obtain ⟨e⟩ := hR
  exact SmallRows.odd_ranks_of_local_alternating_five T L M H I U hH
    s.family.le_ambient hIM hIC hTL hTU hcomm
    (e.trans OrthogonalFourMinus.AlternatingFive.groupEquiv)
    ((primeRank_mono 3 hjoin).trans (hthin 3 Nat.prime_three (by decide)))
    ((primeRank_mono 5 hjoin).trans (hthin 5 (by decide) (by decide)))

/-- The original pair conjugator places P in O₂(H); the full intersection kernel is P. -/
theorem selected_one_pair_core_in_hstar_core [Finite G]
    {V H M I : Subgroup G} {T : Sylow 2 G} [IsElementaryAbelian 2 V]
    {i : I} {S : Sylow 2 I} (s : Selected H T M V I 1 i S)
    (hB : V ⊓ I.pCoreIn 2 ≤ H.pCoreIn 2) :
    I.pCoreIn 2 = I ⊓ H.pCoreIn 2 := by
  have hIP : I ≤ normalizer (I.pCoreIn 2 : Set G) := I.le_normalizer.trans
    (normalizer_le_normalizer_characteristic_image I (pCore 2 I))
  have hPi : (I.pCoreIn 2).map (MulAut.conj i.val⁻¹).toMonoidHom = I.pCoreIn 2 :=
    mem_normalizer_iff_map_conj_eq.mp (hIP (I.inv_mem i.property))
  have hpair : (V ⊓ I.pCoreIn 2) ⊔ (V ⊓ I.pCoreIn 2).map
      (MulAut.conj i.val⁻¹).toMonoidHom = I.pCoreIn 2 := by
    rw [map_inf _ _ _ (MulAut.conj i.val⁻¹).injective,hPi]
    exact (selected_one_core_product s).symm
  have hHQ : H ≤ normalizer (H.pCoreIn 2 : Set G) := H.le_normalizer.trans
    (normalizer_le_normalizer_characteristic_image H (pCore 2 H))
  have hQi : (H.pCoreIn 2).map (MulAut.conj i.val⁻¹).toMonoidHom = H.pCoreIn 2 :=
    mem_normalizer_iff_map_conj_eq.mp (hHQ (H.inv_mem (s.family.le_ambient i.property)))
  have hPQ : I.pCoreIn 2 ≤ H.pCoreIn 2 := by
    rw [←hpair]
    exact sup_le hB ((map_mono hB).trans_eq hQi)
  refine le_antisymm (le_inf (pCoreIn_le 2 I) hPQ) ?_
  rw [inf_comm]
  exact pCoreIn_inf_le_of_normalizes (s.family.le_ambient.trans H.le_normalizer)

/-- Identify I/O₂(I) with its literal image in H/O₂(H), preserving every representative. -/
theorem selected_one_pair_core_quotient [Finite G]
    {V H M I : Subgroup G} {T : Sylow 2 G} [IsElementaryAbelian 2 V]
    {i : I} {S : Sylow 2 I} (s : Selected H T M V I 1 i S)
    (hB : V ⊓ I.pCoreIn 2 ≤ H.pCoreIn 2) :
    ∃ e : (I ⧸ pCore 2 I) ≃*
        ((I.subgroupOf H).map (QuotientGroup.mk' (pCore 2 H))),
      ∀ x : I, (e (QuotientGroup.mk' (pCore 2 I) x)).val =
        QuotientGroup.mk' (pCore 2 H) (inclusion s.family.le_ambient x) := by
  have hcore := selected_one_pair_core_in_hstar_core s hB
  let J := (I.subgroupOf H).map (QuotientGroup.mk' (pCore 2 H))
  let f : I →* J := ((QuotientGroup.mk' (pCore 2 H)).comp
    (inclusion s.family.le_ambient)).codRestrict J
      (fun x => mem_map_of_mem _ x.property)
  have hf : Function.Surjective f := by
    rintro ⟨y,a,ha,rfl⟩
    exact ⟨⟨a,ha⟩,rfl⟩
  have hk : f.ker = pCore 2 I := by
    ext x
    change (⟨QuotientGroup.mk' (pCore 2 H) (inclusion s.family.le_ambient x),_⟩ : J) = 1 ↔ _
    rw [Subtype.ext_iff]
    change ((inclusion s.family.le_ambient x : H) : H ⧸ pCore 2 H) = 1 ↔ _
    rw [QuotientGroup.eq_one_iff]
    have hI : x ∈ pCore 2 I ↔ (x : G) ∈ I.pCoreIn 2 := by
      change x ∈ pCore 2 I ↔ I.subtype x ∈ (pCore 2 I).map I.subtype
      exact (mem_map_iff_mem (f := I.subtype) I.subtype_injective).symm
    have hH : inclusion s.family.le_ambient x ∈ pCore 2 H ↔ (x : G) ∈ H.pCoreIn 2 := by
      exact (mem_map_iff_mem (f := H.subtype) H.subtype_injective).symm
    rw [hI,hH,hcore]
    exact (and_iff_right x.property).symm
  let e : (I ⧸ pCore 2 I) ≃* J :=
    (QuotientGroup.quotientMulEquivOfEq hk.symm).trans
      (QuotientGroup.quotientKerEquivOfSurjective f hf)
  exact ⟨e,fun _ => rfl⟩

/-- Two-cores commute with the literal local quotient by the elementary U. -/
theorem localImage_twoCore [Finite G] {U X : Subgroup G} [IsElementaryAbelian 2 U]
    (hXN : X ≤ normalizer (U : Set G)) :
    SmallRows.localImage U (X.pCoreIn 2) = (SmallRows.localImage U X).pCoreIn 2 := by
  let N := normalizer (U : Set G)
  have hk : IsPGroup 2 N.subtype.ker := by
    rw [N.subtype.ker_eq_bot N.subtype_injective]
    exact IsPGroup.of_subsingleton 2 _
  have hcore : (X.pCoreIn 2).subgroupOf N = (X.subgroupOf N).pCoreIn 2 := by
    apply map_injective N.subtype_injective
    rw [map_subgroupOf_eq_of_le ((pCoreIn_le 2 X).trans hXN),
      map_pCoreIn_of_ker_isPGroup N.subtype hk,map_subgroupOf_eq_of_le hXN]
  unfold SmallRows.localImage
  rw [hcore,map_pCoreIn_of_ker_isPGroup]
  rw [QuotientGroup.ker_mk']
  exact (IsElementaryAbelian.isPGroup 2 U).comap_subtype

/-- On the original mixed two-core, the source involution displaces only B₀/U.
Both the ambient commutator and the literal quotient-core action are retained. -/
theorem selected_one_hstar_core_displacement [Finite G]
    {V H M I R U : Subgroup G} {T : Sylow 2 G} [IsElementaryAbelian 2 V]
    [IsElementaryAbelian 2 U]
    {i : I} {S : Sylow 2 I} (s : Selected H T M V I 1 i S)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) M)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    (hHN : H ≤ normalizer (U : Set G)) (hRN : R ≤ normalizer (U : Set G))
    (hinter : V ⊓ I.pCoreIn 2 = V ⊓ H.pCoreIn 2) :
    (R ⊔ H).pCoreIn 2 ≤ H.pCoreIn 2 ∧
      ⁅(R ⊔ H).pCoreIn 2,V⁆ ≤ V ⊓ I.pCoreIn 2 ∧
      ⁅(SmallRows.localImage U (R ⊔ H)).pCoreIn 2,SmallRows.localImage U V⁆ ≤
        SmallRows.localImage U (V ⊓ I.pCoreIn 2) := by
  let Y := R ⊔ H
  have hTH : (T : Subgroup G) ≤ H := hH.1.1.2
  have hHQ : H ≤ normalizer (Y.pCoreIn 2 : Set G) :=
    (le_sup_right.trans Y.le_normalizer).trans
      (normalizer_le_normalizer_characteristic_image Y (pCore 2 Y))
  have hQT : Y.pCoreIn 2 ≤ (T : Subgroup G) :=
    (isPGroup_pCoreIn 2 Y).le_sylow_of_normalized T (hTH.trans hHQ)
  have hQH : Y.pCoreIn 2 ≤ H.pCoreIn 2 :=
    le_pCoreIn_of_normalizes (isPGroup_pCoreIn 2 Y) (hQT.trans hTH) hHQ
  have hVH : V ≤ H := (s.generate ▸ le_sup_left).trans s.family.le_ambient
  have hcomm : ⁅Y.pCoreIn 2,V⁆ ≤ V ⊓ I.pCoreIn 2 := by
    rw [hinter]
    exact le_inf (le_normalizer_iff_commutator_le_right.mp (hQT.trans hTV))
      ((le_normalizer_iff_commutator_le_left.mp (hVH.trans hHQ)).trans hQH)
  refine ⟨hQH,hcomm,?_⟩
  rw [←localImage_twoCore (sup_le hRN hHN)]
  unfold SmallRows.localImage
  rw [←map_commutator]
  apply map_mono
  apply (map_le_map_iff_of_injective (normalizer (U : Set G)).subtype_injective).mp
  rw [map_commutator,
    map_subgroupOf_eq_of_le ((hQT.trans hTH).trans hHN),
    map_subgroupOf_eq_of_le (hVH.trans hHN),
    map_subgroupOf_eq_of_le ((inf_le_left.trans hVH).trans hHN)]
  exact hcomm

