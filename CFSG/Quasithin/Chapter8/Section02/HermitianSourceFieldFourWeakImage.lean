module
public import CFSG.Quasithin.Chapter8.Section02.HermitianSourceFieldFourCanonical

/-!
# The whole weak-closure action at field four

Every moving whole conjugate of V inside the original Sylow has the same
saturated plane image. The other whole conjugates have trivial image, so
passing to the subgroup generated by all of them preserves that plane image.
The first isomorphism theorem identifies the quotient of W₀(T,V) by its
literal centralizer of V as elementary abelian of order sixteen. Every moving
whole conjugate generates this quotient, giving the exact join decomposition
with the centralizer kernel.

These statements sharpen the remaining zero-closure configuration and are
applied to the original chosen module in the Chapter 12 companion. They do
not exclude that configuration or complete the argument through 8.2.13.
Source: Aschbacher--Smith E.3.13, E.3.28, H.4.4--5 and 7.5.6,
printed pp.233,237,381--382,701, refs/quasithin.pdf (1 March 2004 manuscript).
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
open Representation.HermitianTensorThree Representation.HermitianTensorThree.ImageOuter
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter8.Section02.HermitianSource
open ChapterE
variable {G : Type*} [Group G] [Finite G]
  (V : Subgroup G) [IsElementaryAbelian 2 V]
  (e : Additive V ≃ₗ[ZMod 2] Space 1)
  (j : Automizer V →* binaryNormalizer 1) (hj : Function.Injective j)
  (he : ∀ a v, e (automizerRepresentation V a v) =
    overgroupAction 1 (binaryNormalizer 1) (j a) (e v))

include hj he in
/-- The entire zeroth weak closure has the same rank-four elementary action
as every moving whole conjugate in the original Sylow. -/
theorem field_four_zero_closure_image
    (T : Sylow 2 G) (hT : HypothesisE322 V T)
    (hFF : ¬ IsFFModule (automizerRepresentation V))
    (hr : 3 ≤ globalR V) (hm : 3 ≤ localM V) (hw : globalW V T = 0) :
    let P := indexedWeakClosure V T 0
    IsElementaryAbelian 2 (inducedAutomizer V P) ∧
      rank (inducedAutomizer V P) = 4 ∧
      ∀ g : G, V.map (MulAut.conj g).toMonoidHom ≤ T →
        ¬ V.map (MulAut.conj g).toMonoidHom ≤ centralizer (V : Set G) →
          inducedAutomizer V P = inducedAutomizer V (V.map (MulAut.conj g).toMonoidHom) := by
  obtain ⟨_,hs,g,hg,hOff,har,_,_⟩ := field_four_zero_weak_closure V e j hj he T hT hFF hr hm hw
  let W := V.map (MulAut.conj g).toMonoidHom
  let P := indexedWeakClosure V T 0
  let A := inducedAutomizer V W
  let : IsElementaryAbelian 2 W := IsElementaryAbelian.map _
  let : IsElementaryAbelian 2 A := inducedAutomizer_elementary V W (hg.trans hT.normalizes)
  have hA : offenderNormalizer V g = W := inf_eq_left.mpr (hg.trans hT.normalizes)
  have hf := (offender_fixedSpaceFamily_of_lt_globalS hOff (by rw [hw,hs]; decide)).2
  rw [hw,hs,hA] at hf
  have hfix := (field_four_third_family_fixed_normal V e j hj he T hT W hg hf).1
  have hall (b : G) (hb : V.map (MulAut.conj b).toMonoidHom ≤ T)
      (hmove : ¬ V.map (MulAut.conj b).toMonoidHom ≤ centralizer (V : Set G)) :
      inducedAutomizer V (V.map (MulAut.conj b).toMonoidHom) = A := by
    let Z := V.map (MulAut.conj b).toMonoidHom
    let : IsElementaryAbelian 2 Z := IsElementaryAbelian.map _
    have hAZ : offenderNormalizer V b = Z := inf_eq_left.mpr (hb.trans hT.normalizes)
    have hoff : IsWOffenderAt V T b := by
      refine ⟨?_,?_⟩
      · intro hc
        exact hmove (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hc))
      · rw [hAZ,hw]
        simp [subgroupCorank,Z]
    have hfamily := (offender_fixedSpaceFamily_of_lt_globalS hoff (by rw [hw,hs]; decide)).2
    rw [hw,hs,hAZ] at hfamily
    have hzr := (field_four_fixed_family_three_rank V e j hj he _ hfamily).1
    have hzf := (field_four_third_family_fixed_normal V e j hj he T hT Z hb hfamily).1
    exact (field_four_saturated_actors_eq V e j hj he T hT Z W hb hg hzr har hzf hfix).1
  have hPN : P ≤ normalizer (V : Set G) := (indexedWeakClosure_le V T 0).trans hT.normalizes
  let q := V.normalizerMonoidHom.rangeRestrict
  have hpre : P ≤ (A.comap q).map (normalizer (V : Set G)).subtype := by
    change indexedWeakClosure V T 0 ≤ _
    rw [weakClosure_eq_sSup_gamma]
    apply sSup_le
    intro Z hZ
    obtain ⟨b,rfl,hb⟩ := (mem_gamma_zero_iff V T Z).mp hZ
    have hbA : inducedAutomizer V (V.map (MulAut.conj b).toMonoidHom) ≤ A := by
      by_cases hc : V.map (MulAut.conj b).toMonoidHom ≤ centralizer (V : Set G)
      · rw [(inducedAutomizer_eq_bot_iff (hb.trans hT.normalizes)).mpr hc]
        exact bot_le
      · exact (hall b hb hc).le
    intro x hx
    exact ⟨⟨x,hb.trans hT.normalizes hx⟩,
      hbA (mem_map_of_mem q hx),rfl⟩
  have hPA : inducedAutomizer V P = A := by
    apply le_antisymm
    · rintro _ ⟨x,hx,rfl⟩
      obtain ⟨a,ha,hax⟩ := hpre hx
      have heq : a = x := Subtype.ext hax
      exact heq ▸ ha
    · exact map_mono (comap_mono (gamma_le_weakClosure
        ((mem_gamma_zero_iff V T W).mpr ⟨g,rfl,hg⟩)))
  dsimp only
  change IsElementaryAbelian 2 (inducedAutomizer V P) ∧ _
  rw [hPA]
  exact ⟨inferInstance,har,fun b hb hc => (hall b hb hc).symm⟩


include hj he in
/-- The entire zeroth weak closure has the literal plane action. Its quotient
by its centralizer of V is elementary abelian of order sixteen. -/
theorem field_four_zero_closure_quotient
    (T : Sylow 2 G) (hT : HypothesisE322 V T)
    (hFF : ¬ IsFFModule (automizerRepresentation V))
    (hr : 3 ≤ globalR V) (hm : 3 ≤ localM V) (hw : globalW V T = 0) :
    let P := indexedWeakClosure V T 0
    (∃ c : Cover 1, ((inducedAutomizer V P).map
      ((binaryNormalizer 1).subtype.comp j)).map
        (MulAut.conj (binaryActionHom 1 c)).toMonoidHom = UnipotentRadicals.plane 1) ∧
      ∃ _hK : ((centralizer (V : Set G)).subgroupOf P).Normal,
        IsElementaryAbelian 2 (P ⧸ (centralizer (V : Set G)).subgroupOf P) ∧
        Nat.card (P ⧸ (centralizer (V : Set G)).subgroupOf P) = 16 := by
  let P := indexedWeakClosure V T 0
  let A := inducedAutomizer V P
  obtain ⟨hA,har,hall⟩ := field_four_zero_closure_image V e j hj he T hT hFF hr hm hw
  let : IsElementaryAbelian 2 A := hA
  have hPN : P ≤ normalizer (V : Set G) :=
    (indexedWeakClosure_le V T 0).trans hT.normalizes
  constructor
  · obtain ⟨_,hs,g,hg,hOff,_,_,_⟩ := field_four_zero_weak_closure V e j hj he T hT hFF hr hm hw
    have hmove : ¬ V.map (MulAut.conj g).toMonoidHom ≤ centralizer (V : Set G) := by
      intro hc
      exact hOff.1 (commutator_eq_bot_iff_le_centralizer.mpr (le_centralizer_iff.mp hc))
    rw [hall g hg hmove]
    have hf := (offender_fixedSpaceFamily_of_lt_globalS hOff (by rw [hw,hs]; decide)).2
    have hnorm : offenderNormalizer V g = V.map (MulAut.conj g).toMonoidHom :=
      inf_eq_left.mpr (hg.trans hT.normalizes)
    rw [hw,hs,hnorm] at hf
    exact (field_four_third_family_plane V e j hj he _ hf).2.2
  · let f := V.normalizerMonoidHom.rangeRestrict.comp (inclusion hPN)
    have hf : f.range = A := by
      rw [MonoidHom.range_comp,Subgroup.inclusion_range]
      rfl
    have hk : f.ker = (centralizer (V : Set G)).subgroupOf P := by
      ext x
      change inclusion hPN x ∈ V.normalizerMonoidHom.rangeRestrict.ker ↔ _
      rw [MonoidHom.ker_rangeRestrict,Subgroup.normalizerMonoidHom_ker]
      rfl
    have hK : ((centralizer (V : Set G)).subgroupOf P).Normal := hk ▸ inferInstance
    let := hK
    let a := ((QuotientGroup.quotientMulEquivOfEq hk.symm).trans
      (QuotientGroup.quotientKerEquivRange f)).trans (MulEquiv.subgroupCongr hf)
    refine ⟨hK,IsElementaryAbelian.of_injective a.toMonoidHom a.injective,?_⟩
    have hne : A ≠ ⊥ := by
      intro hz
      change rank A = 4 at har
      rw [hz,Representation.BinaryOffender.rank_bot] at har
      omega
    have hc := (show IsElementaryTwo A from ⟨hne,inferInstance⟩).card_eq_two_pow_rank
    change rank A = 4 at har
    rw [Nat.card_congr a.toEquiv,hc,har]
    norm_num


include hj he in
/-- Every moving whole conjugate generates the entire weak closure modulo
the literal centralizer kernel. -/
theorem field_four_zero_closure_generated_by_return
    (T : Sylow 2 G) (hT : HypothesisE322 V T)
    (hFF : ¬ IsFFModule (automizerRepresentation V))
    (hr : 3 ≤ globalR V) (hm : 3 ≤ localM V) (hw : globalW V T = 0)
    (g : G) (hg : V.map (MulAut.conj g).toMonoidHom ≤ T)
    (hmove : ¬ V.map (MulAut.conj g).toMonoidHom ≤ centralizer (V : Set G)) :
    let P := indexedWeakClosure V T 0
    P = V.map (MulAut.conj g).toMonoidHom ⊔ (P ⊓ centralizer (V : Set G)) := by
  let W := V.map (MulAut.conj g).toMonoidHom
  let P := indexedWeakClosure V T 0
  have hWP : W ≤ P := gamma_le_weakClosure ((mem_gamma_zero_iff V T W).mpr ⟨g,rfl,hg⟩)
  have hPN : P ≤ normalizer (V : Set G) := (indexedWeakClosure_le V T 0).trans hT.normalizes
  have hWN : W ≤ normalizer (V : Set G) := hg.trans hT.normalizes
  have himage := (field_four_zero_closure_image V e j hj he T hT hFF hr hm hw).2.2 g hg hmove
  let q := V.normalizerMonoidHom.rangeRestrict
  apply le_antisymm ?_ (sup_le hWP inf_le_left)
  intro x hx
  have hqx : q ⟨x,hPN hx⟩ ∈ inducedAutomizer V W :=
    himage ▸ mem_map_of_mem q hx
  obtain ⟨y,hy,hyx⟩ := hqx
  have hkc : (y : G)⁻¹*x ∈ centralizer (V : Set G) := by
    have hk : y⁻¹*⟨x,hPN hx⟩ ∈ q.ker := by
      rw [MonoidHom.mem_ker,map_mul,map_inv,hyx,inv_mul_cancel]
    rw [MonoidHom.ker_rangeRestrict,Subgroup.normalizerMonoidHom_ker] at hk
    exact hk
  have hkp : (y : G)⁻¹*x ∈ P := P.mul_mem (P.inv_mem (hWP hy)) hx
  have hh := (W ⊔ (P ⊓ centralizer (V : Set G))).mul_mem
    (mem_sup_left hy) (mem_sup_right ⟨hkp,hkc⟩)
  change (y : G) * ((y : G)⁻¹ * x) ∈ W ⊔ (P ⊓ centralizer (V : Set G)) at hh
  simpa only [mul_inv_cancel_left] using hh

end CFSG.Quasithin.Chapter8.Section02.HermitianSource
