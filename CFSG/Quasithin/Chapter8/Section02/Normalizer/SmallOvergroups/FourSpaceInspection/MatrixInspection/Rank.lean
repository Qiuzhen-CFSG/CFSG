module

public import Theory.GroupTheory.PrimeRankElementary
public import Theory.ElementaryAbelian.Join

/-!
# The elementary cubic-pair obstruction

Two distinct nontrivial commuting cubic elements, with the second outside
the cyclic group generated by the first, lie in an elementary abelian
subgroup with at least four elements. The elementary-subgroup specification
of prime rank therefore excludes this pair when the cubic rank is at most one.

This is the rank obstruction used by the explicit matrices in the proof of
Aschbacher–Smith 8.2.8(1), printed p.719/PDF p.736.
-/

public section
namespace CFSG.Quasithin.Chapter8.Section02.Normalizer.SmallOvergroups.FourSpaceInspection.MatrixInspection
open Subgroup

theorem cubic_pair_forbidden {G : Type*} [Group G] [Finite G]
    (a b : G) (ha : a ^ 3 = 1) (hb : b ^ 3 = 1) (hab : Commute a b)
    (ha1 : a ≠ 1) (hb1 : b ≠ 1) (hba : b ≠ a) (hba2 : b ≠ a ^ 2)
    (hrank : primeRank 3 G ≤ 1) : False := by
  classical
  let E := zpowers a ⊔ zpowers b
  let : IsElementaryAbelian 3 (zpowers a) := IsElementaryAbelian.zpowers_of_pow_eq_one ha
  let : IsElementaryAbelian 3 (zpowers b) := IsElementaryAbelian.zpowers_of_pow_eq_one hb
  let : IsElementaryAbelian 3 E := IsElementaryAbelian.sup_of_le_centralizer (by
    rintro y ⟨m, rfl⟩
    apply mem_centralizer_iff.mpr
    rintro x ⟨n, rfl⟩
    exact (hab.zpow_zpow n m).eq)
  have hbound : Nat.card E ≤ 3 := (primeRank_le_iff_elementary_card_le G).mp hrank E
    inferInstance
  have haE : a ∈ E := (show zpowers a ≤ E from le_sup_left) (mem_zpowers a)
  have hbE : b ∈ E := (show zpowers b ≤ E from le_sup_right) (mem_zpowers b)
  let aE : E := ⟨a, haE⟩
  let bE : E := ⟨b, hbE⟩
  have haE1 : aE ≠ 1 := fun h => ha1 (congrArg Subtype.val h)
  have hbE1 : bE ≠ 1 := fun h => hb1 (congrArg Subtype.val h)
  have hbEa : bE ≠ aE := fun h => hba (congrArg Subtype.val h)
  have hbEa2 : bE ≠ aE ^ 2 := fun h => hba2 (congrArg Subtype.val h)
  have ha2 : a ^ 2 ≠ 1 := by
    intro h
    have h' : a = 1 := by simpa [pow_succ, h] using ha
    exact ha1 h'
  have ha2a : a ^ 2 ≠ a := by
    intro h
    exact ha1 (mul_right_cancel (show a * a = 1 * a by simpa [pow_two] using h))
  have haE2 : aE ^ 2 ≠ 1 := fun h => ha2 (congrArg Subtype.val h)
  have haE2a : aE ^ 2 ≠ aE := fun h => ha2a (congrArg Subtype.val h)
  let := Fintype.ofFinite E
  have hcard : ({1, aE, aE ^ 2, bE} : Finset E).card = 4 := by
    simp [Ne.symm haE1,
      Ne.symm hbE1, Ne.symm hbEa, Ne.symm hbEa2, Ne.symm haE2, Ne.symm haE2a]
  have hle := Finset.card_le_card (Finset.subset_univ ({1, aE, aE ^ 2, bE} : Finset E))
  rw [hcard, Finset.card_univ, ← Nat.card_eq_fintype_card] at hle
  omega

end CFSG.Quasithin.Chapter8.Section02.Normalizer.SmallOvergroups.FourSpaceInspection.MatrixInspection
