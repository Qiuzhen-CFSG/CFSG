module

public import CFSG.Quasithin.Chapter8.Section02.Normalizer.ParabolicReduction.RankSieve.Basic
public import BenderSuzuki.External.Huppert.II.theorem_6_14
public import Mathlib.GroupTheory.SpecificGroups.Dihedral

/-!
# Odd product orders and the small residual alternatives in 8.2.9

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
manuscript (1 March 2004), printed pp.720–721 (PDF pp.737–738).

An element in a pair subgroup with two-core quotient of order 2p has no
nontrivial odd-order image except order p. This uses the two-power kernel
order, not a map from I/O₂(I) into H/O₂(H); that map is not generally available.
For H⁺ ≃ PSL₂(2), the actual S₃ equivalence gives residual order three.
For O²(H⁺) ≃ C₅, its residual has order five. These supply Basic's prime
residual cover and all four ResidualLift conclusions.

The source-family membership of a subgroup generated by a pair, and the
E.2.2/B.6.8 classification selecting the small alternatives, are not asserted
here. The pair quotient models and small H⁺ alternatives remain explicit.
-/

public section
open Subgroup
open scoped Pointwise
namespace CFSG.Quasithin.Chapter8.Section02.Normalizer.ParabolicReduction.RankSieve.SmallRows
variable {G : Type*} [Group G] [Finite G]

private theorem perm_three_residual_card :
    Nat.card (pResidual 2 (Equiv.Perm (Fin 3))) = 3 := by
  have he : pResidual 2 (Equiv.Perm (Fin 3)) = alternatingGroup (Fin 3) := by
    apply le_antisymm
    · apply sInf_le
      refine ⟨inferInstance, IsPGroup.of_card (n := 1) ?_⟩
      change (alternatingGroup (Fin 3)).index = 2 ^ 1
      simp
    · intro x hx
      have hc : Nat.card (alternatingGroup (Fin 3)) = 3 := by
        rw [nat_card_alternatingGroup, Nat.card_fin]
        rfl
      have hp : x ^ 3 = 1 := congrArg Subtype.val
        (hc ▸ pow_card_eq_one' (x := (⟨x, hx⟩ : alternatingGroup (Fin 3))))
      exact mem_pResidual_of_orderOf_coprime
        ((by decide : Nat.Coprime 2 3).of_dvd_right (orderOf_dvd_of_pow_eq_one hp))
  rw [he, nat_card_alternatingGroup, Nat.card_fin]
  rfl


omit [Finite G] in
/-- The PSL₂(2) alternative has residual of order three, via an actual S₃ marking. -/
theorem residual_card_of_psl2_two {F : Type*} [Field F] [Finite F] (hF : Nat.card F = 2)
    (e : (G ⧸ pCore 2 G) ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 2) F) :
    Nat.card (pResidual 2 (G ⧸ pCore 2 G)) = 3 := by
  obtain ⟨eP⟩ := BenderSuzuki.External.huppert_II_6_14_a_psl2_card_two hF
  let eQ := e.trans eP
  have hc := Nat.card_congr ((pResidual 2 (G ⧸ pCore 2 G)).equivMapOfInjective
    eQ.toMonoidHom eQ.injective).toEquiv
  rw [map_pResidual] at hc
  exact hc.trans perm_three_residual_card


omit [Finite G] in
/-- The cyclic-five residual alternative supplies its literal cardinality. -/
theorem residual_card_of_cyclic_five (e : pResidual 2 (G ⧸ pCore 2 G) ≃* Multiplicative (ZMod 5)) :
    Nat.card (pResidual 2 (G ⧸ pCore 2 G)) = 5 := by
  rw [Nat.card_congr e.toEquiv]
  exact Nat.card_zmod 5


/-- The two-core kernel contributes no odd factors to the order of an image. -/
theorem odd_order_of_pair_quotient_card {Q : Type*} [Group Q] (f : G →* Q) (J : Subgroup G)
    {p : ℕ} (hp : p.Prime) (hcard : Nat.card (J ⧸ pCore 2 J) = 2 * p)
    (x : G) (hx : x ∈ J) (ho : Odd (orderOf (f x))) (hne : orderOf (f x) ≠ 1) :
    orderOf (f x) = p := by
  have hd : orderOf (f x) ∣ Nat.card J :=
    (orderOf_map_dvd (f.comp J.subtype) ⟨x, hx⟩).trans (orderOf_dvd_natCard _)
  obtain ⟨k, hk⟩ := (pCore_isPGroup (p := 2) (G := J)).exists_card_eq
  have hc := (pCore 2 J).card_mul_index
  rw [index_eq_card, hcard, hk, ← mul_assoc] at hc
  rw [← hc] at hd
  have hc2 : Nat.Coprime (orderOf (f x)) (2 ^ k * 2) :=
    (ho.coprime_two_right.pow_right k).mul_right ho.coprime_two_right
  exact ((Nat.dvd_prime hp).mp (hc2.dvd_of_dvd_mul_left hd)).resolve_left hne

/-- Apply the order calculation to the source right conjugate vᵍ=g⁻¹vg
and the literal two-core quotient of the ambient group. -/
theorem pair_product_order (V I : Subgroup G) (g v : G) (hv : v ∈ V)
    (hgen : V ⊔ V.map (MulAut.conj g⁻¹).toMonoidHom = I)
    {p : ℕ} (hp : p.Prime) (hcard : Nat.card (I ⧸ pCore 2 I) = 2 * p) :
    let q := QuotientGroup.mk' (pCore 2 G)
    Odd (orderOf (q v * ((q g)⁻¹ * q v * q g))) →
      orderOf (q v * ((q g)⁻¹ * q v * q g)) ≠ 1 →
      orderOf (q v * ((q g)⁻¹ * q v * q g)) = p := by
  dsimp only
  intro ho hne
  let q := QuotientGroup.mk' (pCore 2 G)
  have hx : v * (g⁻¹ * v * g) ∈ I := by
    rw [← hgen]
    exact mul_mem (mem_sup_left hv)
      (mem_sup_right (mem_map.mpr ⟨v, hv, by simp⟩))
  have he : q (v * (g⁻¹ * v * g)) = q v * ((q g)⁻¹ * q v * q g) := by
    simp only [map_mul, map_inv]
  apply he ▸ odd_order_of_pair_quotient_card q I hp hcard _ hx
  · exact ho
  · exact hne

private theorem card_of_psl2_two {X F : Type*} [Group X] [Field F] [Finite F]
    (hF : Nat.card F = 2) (e : X ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 2) F) :
    Nat.card X = 6 := by
  obtain ⟨eP⟩ := BenderSuzuki.External.huppert_II_6_14_a_psl2_card_two hF
  rw [Nat.card_congr (e.trans eP).toEquiv, Nat.card_eq_fintype_card]
  decide

omit [Finite G] in
/-- Small quotient models give prime residual order without any cover premise. -/
theorem prime_residual_of_small_models {F : Type*} [Field F] [Finite F]
    (hF : Nat.card F = 2)
    (hmodels : Nonempty ((G ⧸ pCore 2 G) ≃*
        Matrix.ProjectiveSpecialLinearGroup (Fin 2) F) ∨
      Nonempty (pResidual 2 (G ⧸ pCore 2 G) ≃* Multiplicative (ZMod 5))) :
    (Nat.card (pResidual 2 (G ⧸ pCore 2 G))).Prime := by
  rcases hmodels with hmodels | hmodels
  · obtain ⟨e⟩ := hmodels
    rw [residual_card_of_psl2_two hF e]
    decide
  · obtain ⟨e⟩ := hmodels
    rw [residual_card_of_cyclic_five e]
    decide

/-- The M₂₂ pair quotient has only order three as a nontrivial odd product order. -/
theorem pair_product_order_three {F : Type*} [Field F] [Finite F]
    (hF : Nat.card F = 2) (V I : Subgroup G) (g v : G) (hv : v ∈ V)
    (hgen : V ⊔ V.map (MulAut.conj g⁻¹).toMonoidHom = I)
    (e : (I ⧸ pCore 2 I) ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 2) F) :
    let q := QuotientGroup.mk' (pCore 2 G)
    Odd (orderOf (q v * ((q g)⁻¹ * q v * q g))) →
      orderOf (q v * ((q g)⁻¹ * q v * q g)) ≠ 1 →
      orderOf (q v * ((q g)⁻¹ * q v * q g)) = 3 :=
  pair_product_order V I g v hv hgen Nat.prime_three (card_of_psl2_two hF e)

/-- The L₃(4) pair alternatives give precisely the permitted odd product orders.
The M₂₂ row uses `pair_product_order_three` instead. -/
theorem pair_product_order_three_or_five {F : Type*} [Field F] [Finite F]
    (hF : Nat.card F = 2) (V I : Subgroup G) (g v : G) (hv : v ∈ V)
    (hgen : V ⊔ V.map (MulAut.conj g⁻¹).toMonoidHom = I)
    (hmodels : Nonempty ((I ⧸ pCore 2 I) ≃*
        Matrix.ProjectiveSpecialLinearGroup (Fin 2) F) ∨
      Nonempty ((I ⧸ pCore 2 I) ≃* DihedralGroup 5)) :
    let q := QuotientGroup.mk' (pCore 2 G)
    Odd (orderOf (q v * ((q g)⁻¹ * q v * q g))) →
      orderOf (q v * ((q g)⁻¹ * q v * q g)) ≠ 1 →
      orderOf (q v * ((q g)⁻¹ * q v * q g)) = 3 ∨
        orderOf (q v * ((q g)⁻¹ * q v * q g)) = 5 := by
  dsimp only
  intro ho hne
  rcases hmodels with hmodels | hmodels
  · obtain ⟨e⟩ := hmodels
    exact Or.inl (pair_product_order_three hF V I g v hv hgen e ho hne)
  · obtain ⟨e⟩ := hmodels
    exact Or.inr (pair_product_order V I g v hv hgen (by decide : Nat.Prime 5)
      (by rw [Nat.card_congr e.toEquiv, DihedralGroup.nat_card]) ho hne)

/-- The actual small H⁺ and I/P markings discharge the quotient-cover premise
of ResidualLift and give its residual equality, normalizations and product. -/
theorem conclusions_of_small_models {F : Type*} [Field F] [Finite F]
    (hF : Nat.card F = 2) (T : Sylow 2 G) (V I A : Subgroup G) (h : G)
    (hh : h ∈ I) (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    (hgen : V ⊔ V.map (MulAut.conj h⁻¹).toMonoidHom = I)
    (hP : A ⊔ (V ⊓ I.pCoreIn 2) = I.pCoreIn 2)
    (hmodels : Nonempty ((G ⧸ pCore 2 G) ≃*
        Matrix.ProjectiveSpecialLinearGroup (Fin 2) F) ∨
      Nonempty (pResidual 2 (G ⧸ pCore 2 G) ≃* Multiplicative (ZMod 5)))
    (hpair : Nonempty ((I ⧸ pCore 2 I) ≃*
        Matrix.ProjectiveSpecialLinearGroup (Fin 2) F) ∨
      Nonempty ((I ⧸ pCore 2 I) ≃* DihedralGroup 5)) :
    (pResidual 2 I).map I.subtype = pResidual 2 G ∧
      (T : Subgroup G) ≤ normalizer ((pResidual 2 I).map I.subtype : Set G) ∧
      (Set.univ : Set G) = (I : Set G) * (T : Set G) ∧
      (T : Subgroup G) ≤ normalizer ((V ⊔ A : Subgroup G) : Set G) := by
  have hr := prime_residual_of_small_models hF hmodels
  rcases hpair with hpair | hpair
  · obtain ⟨e⟩ := hpair
    apply conclusions_of_prime_sieve T V I A h hh hTV hgen hP
      Nat.prime_three (by decide) hr
    rw [card_of_psl2_two hF e]
    decide
  · obtain ⟨e⟩ := hpair
    apply conclusions_of_prime_sieve T V I A h hh hTV hgen hP
      (by decide : Nat.Prime 5) (by decide) hr
    rw [Nat.card_congr e.toEquiv, DihedralGroup.nat_card]
    decide

end CFSG.Quasithin.Chapter8.Section02.Normalizer.ParabolicReduction.RankSieve.SmallRows
