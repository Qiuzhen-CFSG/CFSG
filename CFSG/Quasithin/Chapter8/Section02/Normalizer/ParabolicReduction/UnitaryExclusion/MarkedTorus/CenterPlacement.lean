module

public import CFSG.Quasithin.Chapter8.Section02.Normalizer.ParabolicReduction.UnitaryExclusion.GroupDeductions
public import Theory.SpecificGroups.SU3.MarkedFiveTorus

/-!
# Retaining the original two conjugates in the unitary center placement

Once the original V has image of order four in H/O₂(H) and I⁺ lies in
O²(H⁺), Sylow omega geometry identifies that very image with an embedded
Sylow center. Conjugating that Sylow by the image of h⁻¹ gives the second
center, and mapping I = ⟨V,Vʰ⟩ gives generation by those two centers.
All maps are the original quotient map and residual inclusion.

This reduction does not assume the center placement. Its two remaining
source inputs, the order of V⁺ and the containment I⁺ ≤ O²(H⁺), must be
deduced from the genuine marked L₂(4) branch and the earlier setup.
Source: Aschbacher–Smith, Lemma 8.2.9, printed p.720/PDF p.737.
-/

public section
open Subgroup BenderSuzuki.External BenderSuzuki.MatrixGroups
namespace CFSG.Quasithin.Chapter8.Section02.Normalizer.ParabolicReduction.UnitaryExclusion.MarkedTorus

variable {H E : Type*} [Group H] [Finite H] [Field E] [Finite E]

/-- The literal marked two-conjugate subgroup is generated by Sylow centers
once its elementary image has order four. Both centers retain their original
embedding in H/O₂(H). -/
theorem quotient_pair_centers_of_four
    (J : HermitianForm 3 E) (hJ : J.form = !![0,0,1;0,1,0;1,0,0])
    (hcard : Nat.card E = 16)
    (hfixed : Nat.card {x : E // J.conj x = x} = 4)
    (e : pResidual 2 (H ⧸ pCore 2 H) ≃* ProjectiveSpecialUnitaryMatrixGroup J)
    (V I : Subgroup H) [IsElementaryAbelian 2 V] (h : H) (hh : h ∈ I)
    (hgen : V ⊔ V.map (MulAut.conj h⁻¹).toMonoidHom = I)
    (hfour : Nat.card (V.map (QuotientGroup.mk' (pCore 2 H))) = 4)
    (hI : I.map (QuotientGroup.mk' (pCore 2 H)) ≤ pResidual 2 (H ⧸ pCore 2 H)) :
    ∃ P Q : Sylow 2 (pResidual 2 (H ⧸ pCore 2 H)),
      ((center P).map (P : Subgroup _).subtype).map
          (pResidual 2 (H ⧸ pCore 2 H)).subtype =
        V.map (QuotientGroup.mk' (pCore 2 H)) ∧
      ((center Q).map (Q : Subgroup _).subtype).map
          (pResidual 2 (H ⧸ pCore 2 H)).subtype =
        (V.map (MulAut.conj h⁻¹).toMonoidHom).map (QuotientGroup.mk' (pCore 2 H)) ∧
      I.map (QuotientGroup.mk' (pCore 2 H)) =
        (((center P).map (P : Subgroup _).subtype) ⊔
          ((center Q).map (Q : Subgroup _).subtype)).map
            (pResidual 2 (H ⧸ pCore 2 H)).subtype := by
  let q := QuotientGroup.mk' (pCore 2 H)
  let L := pResidual 2 (H ⧸ pCore 2 H)
  have hVL : V.map q ≤ L := (map_mono (show V ≤ I from hgen ▸ le_sup_left)).trans hI
  let A := (V.map q).subgroupOf L
  let : IsElementaryAbelian 2 (V.map q) := IsElementaryAbelian.map q
  let : IsElementaryAbelian 2 A := IsElementaryAbelian.subgroupOf hVL
  have hAcard : Nat.card A = 4 :=
    (Nat.card_congr (subgroupOfEquivOfLe hVL).toEquiv).trans hfour
  obtain ⟨P, hP⟩ := HermitianForm.MarkedFiveTorus.elementary_four_eq_sylow_center_of_equiv
    J hJ hcard hfixed e A hAcard
  let g : L := ⟨q h⁻¹, hI (mem_map_of_mem q (I.inv_mem hh))⟩
  let Q := P.mapSurjective (f := (MulAut.conj g).toMonoidHom) (MulAut.conj g).surjective
  have hfirst : ((center P).map (P : Subgroup L).subtype).map L.subtype = V.map q := by
    rw [← hP]
    exact map_subgroupOf_eq_of_le hVL
  have hcomp : L.subtype.comp (MulAut.conj g).toMonoidHom =
      (MulAut.conj (q h⁻¹)).toMonoidHom.comp L.subtype := by
    ext x
    rfl
  have hqcomp : (MulAut.conj (q h⁻¹)).toMonoidHom.comp q =
      q.comp (MulAut.conj h⁻¹).toMonoidHom := by
    ext x
    change q h⁻¹ * q x * (q h⁻¹)⁻¹ = q (h⁻¹ * x * (h⁻¹)⁻¹)
    simp only [map_mul, map_inv]
  have hsecond : ((center Q).map (Q : Subgroup L).subtype).map L.subtype =
      (V.map (MulAut.conj h⁻¹).toMonoidHom).map q := by
    change ((center ((P : Subgroup L).map (MulAut.conj g).toMonoidHom)).map
      ((P : Subgroup L).map (MulAut.conj g).toMonoidHom).subtype).map L.subtype = _
    rw [← map_embeddedCenter _ _ (MulAut.conj g).injective, map_map, hcomp,
      ← map_map, hfirst, map_map, hqcomp, ← map_map]
  refine ⟨P, Q, hfirst, hsecond, ?_⟩
  rw [Subgroup.map_sup, hfirst, hsecond, ← Subgroup.map_sup, hgen]

end CFSG.Quasithin.Chapter8.Section02.Normalizer.ParabolicReduction.UnitaryExclusion.MarkedTorus
