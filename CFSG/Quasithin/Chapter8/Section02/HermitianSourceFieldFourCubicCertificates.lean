local instance : DecidableEq (Function.End Bits) := inferInstanceAs (DecidableEq (Bits → Bits))
theorem evenPerm_even : ∀ i, Equiv.Perm.sign (evenPerm i) = 1 := by decide +kernel
theorem pairCertificate_correct : ∀ (x y : Fin 16), x ≠ 0 → y ≠ 0 → x ≠ y →
    let z := pairCertificate x y
    permuteBits (evenPerm z.2) (pairRep z.1).1 = BitVec.ofFin x ∧
    permuteBits (evenPerm z.2) (pairRep z.1).2 = BitVec.ofFin y := by decide +kernel
theorem cert0_correct : ∀ (x y : Fin 16),
    let c : Columns := ![1, 2, BitVec.ofFin x, BitVec.ofFin y]
    let z := cert0 x y
    (z.1 ≠ 0 ∧ applyMatrix c z.1 = 0) ∨
      applyMatrix c = permuteBits (evenPerm z.2.2.1) * allRep z.2.1 *
        permuteBits (evenPerm z.2.2.2) := by decide +kernel
