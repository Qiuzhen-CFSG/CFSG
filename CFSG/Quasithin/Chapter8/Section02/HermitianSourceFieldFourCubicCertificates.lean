/-- Normalize the first two independent columns by an actual even permutation. -/
public theorem orderedPair_marking (x y : Bits) (hx : x ≠ 0) (hy : y ≠ 0) (hxy : x ≠ y) :
    ∃ (i : Fin 7) (σ : Equiv.Perm (Fin 5)), Equiv.Perm.sign σ = 1 ∧
      permuteBits σ (pairRep i).1 = x ∧ permuteBits σ (pairRep i).2 = y := by
  have hp := pairCertificate_correct x.toFin y.toFin
    (fun hh => hx (congrArg BitVec.ofFin hh))
    (fun hh => hy (congrArg BitVec.ofFin hh))
    (fun hh => hxy (congrArg BitVec.ofFin hh))
  exact ⟨_,_,evenPerm_even _,hp⟩
private theorem applyMatrix_zero (c : Columns) : applyMatrix c 0 = 0 := by
  simp [applyMatrix]

/-- Complete matrix certificates after the first two columns are normalized. -/
public theorem normalized_coverage (i : Fin 7) (x y : Fin 16)
    (hi : Function.Injective (applyMatrix ![(pairRep i).1, (pairRep i).2,
      BitVec.ofFin x, BitVec.ofFin y])) :
    ∃ (j : Fin 16) (σ τ : Equiv.Perm (Fin 5)),
      Equiv.Perm.sign σ = 1 ∧ Equiv.Perm.sign τ = 1 ∧
      applyMatrix ![(pairRep i).1, (pairRep i).2, BitVec.ofFin x, BitVec.ofFin y] =
        permuteBits σ * allRep j * permuteBits τ := by
  have eliminate (c : Columns) (h : Function.Injective (applyMatrix c))
      (z : Bits × Fin 16 × Fin 60 × Fin 60)
      (hc : (z.1 ≠ 0 ∧ applyMatrix c z.1 = 0) ∨
        applyMatrix c = permuteBits (evenPerm z.2.2.1) * allRep z.2.1 *
          permuteBits (evenPerm z.2.2.2)) :
      ∃ (j : Fin 16) (σ τ : Equiv.Perm (Fin 5)),
        Equiv.Perm.sign σ = 1 ∧ Equiv.Perm.sign τ = 1 ∧
        applyMatrix c = permuteBits σ * allRep j * permuteBits τ := by
    rcases hc with ⟨hne,hzero⟩ | he
    · exact (hne (h (hzero.trans (applyMatrix_zero c).symm))).elim
    · exact ⟨_,_,_,evenPerm_even _,evenPerm_even _,he⟩
  fin_cases i
  · exact eliminate _ hi _ (cert0_correct x y)
  · exact eliminate _ hi _ (cert1_correct x y)
  · exact eliminate _ hi _ (cert2_correct x y)
  · exact eliminate _ hi _ (cert3_correct x y)
  · exact eliminate _ hi _ (cert4_correct x y)
  · exact eliminate _ hi _ (cert5_correct x y)
  · exact eliminate _ hi _ (cert6_correct x y)


