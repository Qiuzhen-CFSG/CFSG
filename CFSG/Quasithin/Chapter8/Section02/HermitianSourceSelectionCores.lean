/-!
# Core and Borel clauses for Hermitian source selection

A family pair generated by two conjugates of the elementary subgroup is
normalized by the ambient two-core. Characteristic two therefore descends to
the pair. After excluding the symplectic alternative, the actual PSL₂,
Suzuki, and odd dihedral models identify its normal core with its two-core.
For Suzuki the central cover kernel and abelianization are two-groups.

The actual Borel models normalize the specified quotient Sylow; in the
odd dihedral case TI first normalizes the generator image, whose normalizer
is itself. These facts discharge the E.2.9(2), E.2.11(5) core, and E.2.11(3)
quotient-normalization inputs in the original selection construction.

`SelectionRemainingSources` retains witness existence, the trivial-intersection
FF bound, symplectic exclusion, and the center marking as explicit inputs.
The last theorem assembles selection on the same pair, quotient and Sylow.
The literal chosen-orbit application is in
`NonFFSourceNonMathieuHermitianSelectionCores`; no unconditional source
selection or Hermitian exclusion is asserted here.

Source: Aschbacher–Smith, E.2.9(2), E.2.10(6–7), E.2.11 and E.2.14,
printed pp.221–228 (1 March 2004 manuscript, refs/quasithin.pdf).
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation.BinaryOffender
open scoped IsMulCommutative MatrixGroups
namespace CFSG.Quasithin.Chapter8.Section02.HermitianSource
open ChapterE Offenders.Parabolic Offenders.Parabolic.Construction
open BenderSuzuki.PFAppendixIII BenderSuzuki.Converse BenderSuzuki.MatrixGroups
variable {G : Type*} [Group G] [Finite G]

private theorem suzuki_core {X : Type*} [Group X] [Finite X]
    {S : Sylow 2 X} {W N : Subgroup X} {g : X}
    (h : TwoConjugate.Hypotheses S W N g) (m : ℕ) (hm : 0 < m)
    (e : (X ⧸ TwoConjugate.J N) ≃* SuzukiMatrixGroup m) :
    TwoConjugate.J N = pCore 2 X := by
  let := h.core_geometry.1
  let := h.elementary
  let q := QuotientGroup.mk' (TwoConjugate.P W N g)
  have hPJ := h.P_le_J
  let f : (X ⧸ TwoConjugate.P W N g) →* SuzukiMatrixGroup m :=
    QuotientGroup.lift (TwoConjugate.P W N g)
      (e.toMonoidHom.comp (QuotientGroup.mk' (TwoConjugate.J N))) (by
        intro x hx
        exact e.map_eq_one_iff.mpr ((QuotientGroup.eq_one_iff x).mpr (hPJ hx)))
  have hf : Function.Surjective f := by
    intro z
    obtain ⟨y,rfl⟩ := e.surjective z
    obtain ⟨x,rfl⟩ := QuotientGroup.mk'_surjective (TwoConjugate.J N) y
    exact ⟨q x,rfl⟩
  have hk : f.ker = (TwoConjugate.J N).map q := by
    apply comap_injective (QuotientGroup.mk'_surjective (TwoConjugate.P W N g))
    rw [comap_map_eq,QuotientGroup.ker_mk',sup_eq_left.mpr hPJ]
    ext x
    change e (QuotientGroup.mk' (TwoConjugate.J N) x) = 1 ↔ x ∈ TwoConjugate.J N
    rw [e.map_eq_one_iff]
    exact QuotientGroup.eq_one_iff x
  have hc : f.ker ≤ center (X ⧸ TwoConjugate.P W N g) := by
    rw [hk]
    exact (map_mk_le_center_iff _ _).mpr (by
      rw [commutator_comm]; exact h.commutator_J_le_P)
  let := SchurCover.isPerfect m hm
  let c := CentralExtension.derivedCover f hf hc
  have hD := SchurCover.kernel_isTwoGroup hm c
  let π := (QuotientGroup.mk' (commutator (X ⧸ TwoConjugate.P W N g))).comp q
  have hπ : Function.Surjective π := (QuotientGroup.mk'_surjective _).comp
    (QuotientGroup.mk'_surjective _)
  let : IsMulCommutative ((X ⧸ TwoConjugate.P W N g) ⧸
      commutator (X ⧸ TwoConjugate.P W N g)) :=
    Subgroup.Normal.quotient_commutative_iff_commutator_le.mpr le_rfl
  have hAb := CentralExtension.abelian_image_isPGroup_of_sup W (TwoConjugate.W W g)
    (IsElementaryAbelian.isPGroup 2 W)
    ((IsElementaryAbelian.isPGroup 2 W).map (MulAut.conj g).toMonoidHom)
    h.generate π hπ
  have hK := CentralExtension.kernel_isPGroup_of_derived_kernel f hf hc hD hAb
  have hJ : IsPGroup 2 (TwoConjugate.J N) := by
    rw [hk] at hK
    have hp : IsPGroup 2 q.ker := by
      rw [QuotientGroup.ker_mk']
      exact pCore_isPGroup.to_le h.P_le_twoCore
    have hh := hK.comap_of_ker_isPGroup q hp
    rw [comap_map_eq,QuotientGroup.ker_mk',sup_eq_left.mpr hPJ] at hh
    exact hh
  exact le_antisymm (le_sSup ⟨inferInstance,hJ⟩) h.twoCore_le_J

/-- Characteristic two descends to the actual two-conjugate family pair. -/
theorem family_characteristic_two {K : GroupClass} {H T M V I : Subgroup G} {k : ℕ}
    (h : HypothesisE28 K H T M V) (f : Family H T M V I k)
    (hfit : generalizedFitting H = pCore 2 H) :
    generalizedFitting I = pCore 2 I := by
  obtain ⟨S,hS,hP,hM⟩ := h.minimal
  obtain ⟨x,hx,hgen⟩ := f.generate
  have hVI : V ≤ I := hgen ▸ le_sup_left
  have hVH : V ≤ H := hVI.trans f.le_ambient
  let xH : H := ⟨x,f.le_ambient hx⟩
  have hgenH : V.subgroupOf H ⊔ (V.subgroupOf H).map
      (MulAut.conj xH⁻¹).toMonoidHom = I.subgroupOf H := by
    apply map_injective H.subtype_injective
    rw [Subgroup.map_sup,map_subgroupOf_eq_of_le hVH,
      restricted_right_conjugate_image H V hVH xH,
      map_subgroupOf_eq_of_le f.le_ambient,hgen]
  have hSN : (S : Subgroup H) ≤ normalizer (V.subgroupOf H : Set H) := by
    rw [hS,←subgroupOf_normalizer_eq hVH]
    exact comap_mono ((normal_subgroupOf_iff_le_normalizer h.le_sylow).mp h.normal_in_sylow)
  have hn : pCore 2 H ≤ normalizer (I.subgroupOf H : Set H) := by
    rw [←hgenH]
    exact twoCore_le_normalizer_conjugate_join S (V.subgroupOf H) hSN xH⁻¹
  have hh := generalizedFitting_eq_pCore_of_normalized_by_pCore (I.subgroupOf H) hfit hn
  let e := subgroupOfEquivOfLe f.le_ambient
  have he := congrArg (Subgroup.map e.toMonoidHom) hh
  rwa [map_generalizedFitting_equiv,pCore_map_iso] at he


/-- The classified nonsymplectic family has no odd normal-core kernel. -/
theorem family_rank_one_core {K : GroupClass} {H T M V I : Subgroup G} {k : ℕ}
    (h : HypothesisE28 K H T M V) (f : Family H T M V I k)
    (hr : RankOneAlternative (Star M I) (starImage M I M) k) :
    localCore M I = pCore 2 I := by
  let := h.elementary
  obtain ⟨x,hx,hgen⟩ := f.generate
  let i : I := ⟨x,hx⟩
  obtain ⟨S,hS⟩ := f.sylow
  have hp := Family.twoConjugate h f S hS i hgen
  let := hp.elementary
  rcases hr with ⟨hk,e,_⟩ | ⟨m,hm,_,e,_⟩ | ⟨_,p,a,hpprime,ho,_,⟨e⟩⟩
  · exact hp.J_eq_twoCore_of_linear_two k (by omega)
      (GaloisField.card 2 k (by omega))
      (e.trans (Theory.PSL2.sl2QuotientEquiv (BinaryGaloisField k)).symm)
  · exact suzuki_core hp m hm e
  · have hproper : V.subgroupOf I ≠ ⊤ := by
      intro he
      have hn : M.subgroupOf I = ⊤ := by
        apply top_unique
        simpa only [he,normalizer_eq_top] using hp.normalizer_le
      have hc : Nat.card (Star M I) = 1 := by
        change Nat.card (I ⧸ (M.subgroupOf I).normalCore) = 1
        rw [hn,normalCore_eq_self]
        simp
      rw [Nat.card_congr e.toEquiv,DihedralGroup.nat_card] at hc
      omega
    have hcard : Nat.card ((V.subgroupOf I).map
        (QuotientGroup.mk' (localCore M I))) = 2 := by
      let E := (V.subgroupOf I).map (QuotientGroup.mk' (localCore M I))
      have hEp : IsPGroup 2 E := (IsElementaryAbelian.isPGroup 2 (V.subgroupOf I)).map _
      have hne : E ≠ ⊥ := by
        intro he
        have hv : V.subgroupOf I ≤ localCore M I := by
          simpa only [QuotientGroup.ker_mk'] using (Subgroup.map_eq_bot_iff _).mp he
        exact hp.V_not_le_twoCore hproper
          (hp.le_twoCore_of_le_J _ (IsElementaryAbelian.isPGroup 2 _) hv)
      have hd : Nat.card E ∣ 2*p^a := by
        have hh := E.card_subgroup_dvd_card
        rwa [Nat.card_congr e.toEquiv,DihedralGroup.nat_card] at hh
      obtain ⟨b,hb⟩ := hEp.exists_card_eq
      have hcop : Nat.Coprime (Nat.card E) (p^a) := by
        rw [hb]
        exact ho.coprime_two_left.pow b a
      exact ((Nat.dvd_prime Nat.prime_two).mp
        (hcop.dvd_of_dvd_mul_right hd)).resolve_left (fun he => hne (Subgroup.card_eq_one.mp he))
    exact (hp.odd_dihedral hcard).2.1.symm

/-- TI normalizes the generator image; the actual Borel models then normalize
the specified quotient Sylow. This discharges the quotient-normalization
input from E.2.11(3) at selection. -/
theorem family_borel_normalizes {K : GroupClass} {H T M V I : Subgroup G} {k : ℕ}
    [IsElementaryAbelian 2 V]
    (h : HypothesisE28 K H T M V) (f : Family H T M V I k)
    (hr : RankOneAlternative (Star M I) (starImage M I M) k)
    (i : I) (hgen : V ⊔ V.map (MulAut.conj i.val⁻¹).toMonoidHom = I)
    (hTI : ∀ x ∈ M, V ⊓ V.map (MulAut.conj x).toMonoidHom = ⊥ ∨
      V.map (MulAut.conj x).toMonoidHom = V)
    (hNV : normalizer (V : Set G) ≤ M)
    (hZ : V ⊓ V.map (MulAut.conj i.val⁻¹).toMonoidHom ≠ ⊥) :
    starImage M I M ≤ normalizer (starImage M I T : Set (Star M I)) := by
  obtain ⟨S,hS⟩ := f.sylow
  have hp := Family.twoConjugate h f S hS i hgen
  let := hp.elementary
  let q := QuotientGroup.mk' (localCore M I)
  let R := S.mapSurjective (f := q) (QuotientGroup.mk'_surjective _)
  have hR : (R : Subgroup (Star M I)) = starImage M I T := by
    change (S : Subgroup I).map q = _
    rw [hS]
    rfl
  have hRM : (R : Subgroup (Star M I)) ≤ starImage M I M :=
    map_mono (hp.sylow_le_normalizer.trans hp.normalizer_le)
  rw [←hR]
  rcases hr with ⟨hk,e,he⟩ | ⟨m,hm,_,e,he⟩ | ⟨_,p,a,hpprime,ho,_,⟨e⟩⟩
  · let R' := R.mapSurjective (f := e.toMonoidHom) e.surjective
    have hR'M : (R' : Subgroup _) ≤ PBorel (BinaryGaloisField k) :=
      (map_mono (f := e.toMonoidHom) hRM).trans_eq he
    have hn := (selectionModelSources.psl2 k hk R' hR'M).1
    apply (map_le_map_iff_of_injective (f := e.toMonoidHom) e.injective).mp
    rw [map_equiv_normalizer_eq,he]
    exact hn.le
  · let R' := R.mapSurjective (f := e.toMonoidHom) e.surjective
    have hR'M : (R' : Subgroup _) ≤ SuzukiBorelSubgroup m :=
      (map_mono (f := e.toMonoidHom) hRM).trans_eq he
    have hn := (selectionModelSources.suzuki m hm R' hR'M).1
    apply (map_le_map_iff_of_injective (f := e.toMonoidHom) e.injective).mp
    rw [map_equiv_normalizer_eq,he]
    exact hn.le
  · have hVI : V ≤ I := hgen ▸ le_sup_left
    have hn := relative_normalizer I M V i.val hgen hTI hNV hZ
    have hMN : M.subgroupOf I ≤ normalizer (V.subgroupOf I : Set I) := by
      rw [←subgroupOf_normalizer_eq hVI]
      intro x hx
      exact (hn.le ⟨hx,x.property⟩).2
    let E := starImage M I V
    have hEN : starImage M I M ≤ normalizer (E : Set (Star M I)) :=
      (map_mono (f := q) hMN).trans ((V.subgroupOf I).le_normalizer_map q)
    have hproper : V.subgroupOf I ≠ ⊤ := by
      intro he
      have hM : M.subgroupOf I = ⊤ := by
        apply top_unique
        simpa only [he,normalizer_eq_top] using hp.normalizer_le
      have hc : Nat.card (Star M I) = 1 := by
        change Nat.card (I ⧸ (M.subgroupOf I).normalCore) = 1
        rw [hM,normalCore_eq_self]
        simp
      rw [Nat.card_congr e.toEquiv,DihedralGroup.nat_card] at hc
      omega
    have hne : E ≠ ⊥ := by
      intro he
      have hv : V.subgroupOf I ≤ localCore M I := by
        simpa only [QuotientGroup.ker_mk'] using (Subgroup.map_eq_bot_iff _).mp he
      exact hp.V_not_le_twoCore hproper
        (hp.le_twoCore_of_le_J _ (IsElementaryAbelian.isPGroup 2 _) hv)
    have heq := odd_dihedral_two_subgroup_normalizer (p^a) ho.pow e E
      ((IsElementaryAbelian.isPGroup 2 (V.subgroupOf I)).map q) hne
    have hER : E ≤ (R : Subgroup (Star M I)) := map_mono hp.le_sylow
    exact (hEN.trans_eq heq).trans (hER.trans (Subgroup.le_normalizer (H := (R : Subgroup (Star M I)))))

end CFSG.Quasithin.Chapter8.Section02.HermitianSource

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter8.Section02.HermitianSource
open ChapterE Offenders.Parabolic Offenders.Parabolic.Construction
open BenderSuzuki.PFAppendixIII BenderSuzuki.Converse BenderSuzuki.MatrixGroups
open Theory.SpecificGroups.SymplecticFour
variable {G : Type*} [Group G]

/-- The remaining source clauses after deriving E.2.9(2) and the core and
quotient-normalization clauses of E.2.11 on the nonsymplectic pair. These four
clauses remain explicit theorem inputs. -/
structure SelectionRemainingSources [Finite G] (K : GroupClass) : Prop where
  e29 : ∀ H T M V : Subgroup G, HypothesisE28 K H T M V →
    ∃ I k, Family H T M V I k
  e2135 : ∀ {H T M V I : Subgroup G} [IsElementaryAbelian 2 V] {k : ℕ},
    HypothesisE28 K H T M V → generalizedFitting H = pCore 2 H →
    Family H T M V I k → ∀ i : I,
    V ⊔ V.map (MulAut.conj (i.val)⁻¹).toMonoidHom = I →
    V ⊓ V.map (MulAut.conj (i.val)⁻¹).toMonoidHom = ⊥ →
    quadraticRatio ((automizerRepresentation V).comp (inducedAutomizer V H).subtype) ≤ 1
  e2136 : ∀ {H T M V I : Subgroup G} {k : ℕ}, HypothesisE28 K H T M V →
    generalizedFitting H = pCore 2 H → Family H T M V I k →
    (∀ i : I, (V.subgroupOf I).map (MulAut.conj i⁻¹).toMonoidHom ≤ T.subgroupOf I →
      (V.subgroupOf I).map (MulAut.conj i⁻¹).toMonoidHom ≤ centralizer (V.subgroupOf I : Set I)) →
    ∀ n : ℕ, 0 < n → ¬ Nonempty (Star M I ≃* Sp (BinaryGaloisField n))
  e2142_center : ∀ {H T M V I : Subgroup G} {k : ℕ}, HypothesisE28 K H T M V →
    generalizedFitting H = pCore 2 H → Family H T M V I k →
    (∀ x ∈ H ⊓ M, V ⊓ V.map (MulAut.conj x).toMonoidHom = ⊥ ∨
      V.map (MulAut.conj x).toMonoidHom = V) → ∀ i : I,
    V ⊔ V.map (MulAut.conj (i.val)⁻¹).toMonoidHom = I →
    V ⊓ V.map (MulAut.conj (i.val)⁻¹).toMonoidHom ≠ ⊥ →
    starImage M I V = embeddedCenter (starImage M I T)

variable [Finite G]

/-- Source selection with characteristic-two inheritance, normal-core
identification and quotient Sylow normalization discharged on the actual pair. -/
theorem exists_selected_of_remaining_sources {K : GroupClass}
    (earlier : SelectionRemainingSources (G := G) K)
    {H T M V : Subgroup G} [IsElementaryAbelian 2 V]
    (h : HypothesisE28 K H T M V) (hchar : generalizedFitting H = pCore 2 H)
    (hw : 0 < globalW V T)
    (hq : 1 < quadraticRatio ((automizerRepresentation V).comp (inducedAutomizer V M).subtype))
    (hTI : ∀ x ∈ M, V ⊓ V.map (MulAut.conj x).toMonoidHom = ⊥ ∨
      V.map (MulAut.conj x).toMonoidHom = V)
    (hNV : normalizer (V : Set G) ≤ M) :
    ∃ (I : Subgroup G) (k : ℕ) (i : I) (S : Sylow 2 I), Selected H T M V I k i S := by
  obtain ⟨I,k,f⟩ := earlier.e29 H T M V h
  obtain ⟨x,hx,hgen⟩ := f.generate
  let i : I := ⟨x,hx⟩
  obtain ⟨S,hS⟩ := f.sylow
  have hVI : V ≤ I := hgen ▸ le_sup_left
  have hNI : I ⊓ normalizer (V : Set G) ≤ M :=
    (inf_le_inf_right _ f.le_ambient).trans h.normalizer_le
  have hqH := selected_quadraticRatio_gt_one M H V h.normalizer_le hq
  have hZ : V ⊓ V.map (MulAut.conj i.val⁻¹).toMonoidHom ≠ ⊥ := by
    intro hz
    exact (not_le_of_gt hqH) (earlier.e2135 h hchar f i hgen hz)
  have hsp : ¬ SymplecticAlternative (Star M H) (Star M I)
      (starImage M I M) (starImage M I T) (starImage M I V) k := by
    intro hs
    obtain ⟨e,_⟩ := hs.2.2
    exact earlier.e2136 h hchar f (local_conjugates_centralize I T V hVI hw)
      k hs.1 ⟨e⟩
  have hc := family_rank_one_core h f (f.classified.resolve_right hsp)
  obtain ⟨hk,hdvd,hr⟩ := selected_quotient f hc hsp
  have hz := earlier.e2142_center h hchar f (fun x hx => hTI x hx.2) i hgen hZ
  obtain ⟨hzcore,hncore⟩ := core_markings_of_star M I T V hc hz
    (family_borel_normalizes h f (f.classified.resolve_right hsp) i hgen hTI hNV hZ)
  have hTM : T ≤ M := by
    obtain ⟨R,hR,hP,hM⟩ := h.minimal
    intro t ht
    have htm := (ChapterB.minimalParabolicMax_spec R hP).2
    rw [hR,←hM] at htm
    exact htm (show (⟨t,h.le_ambient ht⟩ : H) ∈ T.subgroupOf H from ht)
  obtain ⟨hnorm,hrank⟩ := selected_model_markings selectionModelSources M I T V k S hS hTM hr hzcore hncore
  refine ⟨I,k,i,S,f,hgen,hS,Family.twoConjugate h f S hS i hgen,hc,
    family_characteristic_two h f hchar,hZ,?_,hNI,?_,hk,hdvd,hr,hzcore,hnorm,hrank,
    selected_quadraticRatio_gt_one M I V hNI hq⟩
  · exact intersection_central I V i.val hgen
  · exact relative_normalizer I M V i.val hgen hTI hNV hZ

end CFSG.Quasithin.Chapter8.Section02.HermitianSource
