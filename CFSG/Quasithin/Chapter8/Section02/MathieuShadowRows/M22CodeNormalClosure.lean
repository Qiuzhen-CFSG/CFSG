private theorem seed_not_le_normalClosure_frattini
    {A : Type*} [Group A] [Finite A] (W : Subgroup A) (hW : W ≠ ⊥) :
    ¬ W ≤ (frattini (normalClosure (W : Set A))).map
      (normalClosure (W : Set A)).subtype := by
  let E := normalClosure (W : Set A)
  let F := (frattini E).map E.subtype
  let : E.Normal := normalClosure_normal
  let : F.Normal := by dsimp only [F]; infer_instance
  intro hWF
  have hEF : E ≤ F := normalClosure_le_normal hWF
  have htop : frattini E = ⊤ := by
    apply top_unique
    intro e _
    obtain ⟨f,hf,hfe⟩ := hEF e.property
    exact (Subtype.ext hfe : f = e) ▸ hf
  have htriv : (⊥ : Subgroup E) = ⊤ :=
    frattini_nongenerating (by simpa only [bot_sup_eq] using htop)
  have hEb : E = ⊥ := by
    apply bot_unique
    intro e he
    have hh : (⟨e,he⟩ : E) ∈ (⊥ : Subgroup E) := htriv.symm ▸ mem_top _
    exact congrArg Subtype.val (show (⟨e,he⟩ : E) = 1 from hh)
  exact hW (bot_unique (le_normalClosure.trans hEb.le))

variable {G : Type*} [Group G]

/-- The source five-space has nonzero residual movement before taking any
mixed chief quotient.  This uses its proved moved dimension, not a faithful
model substituted for the original action. -/
theorem m22_section_commutator_not_le
    {B R U : Subgroup G} {f : R →* MathieuCode.M22Quintet.Q}
    (hs : M22FiveSection R B U f) : ¬ ⁅B,R⁆ ≤ U := by
  obtain ⟨hRB,hRU,hBU,r,eB,hrsur,hrker,hrval,hact,hker,
    hEl,ρ,hρ,hd5,hd4,hd1⟩ := hs
  let := hBU
  let := hEl
  intro hc
  have hk : Coinvariants.ker ρ = ⊥ := by
    apply bot_unique
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨a,b⟩,rfl⟩
    have ha : sectionAction R B U hRB hRU a = 1 := by
      apply (mem_sectionAction_ker R B U hRB hRU a).mpr
      intro b
      rw [commutator_comm] at hc
      exact hc (commutator_mem_commutator a.property b.property)
    have hb : ρ a b = b := by
      simpa [ha] using hρ a b.toMul
    change ρ a b - b = 0
    exact sub_eq_zero.mpr hb
  rw [hk,finrank_bot] at hd4
  norm_num at hd4

/-- The moved seed remains nontrivial in the literal local quotient N(U)/U. -/
theorem m22_local_moved_ne_bot
    {B R U : Subgroup G} {f : R →* MathieuCode.M22Quintet.Q}
    (hs : M22FiveSection R B U f)
    (hBN : B ≤ normalizer (U : Set G)) :
    ⁅SmallRows.localImage U B,SmallRows.localImage U R⁆ ≠ ⊥ := by
  have hRN := hs.choose_spec.choose
  intro hw
  apply m22_section_commutator_not_le hs
  rw [commutator_le]
  intro b hb r hr
  let N := normalizer (U : Set G)
  let q := QuotientGroup.mk' (U.subgroupOf N)
  let bN : N := ⟨b,hBN hb⟩
  let rN : N := ⟨r,hRN hr⟩
  have hbq : q bN ∈ SmallRows.localImage U B := ⟨bN,hb,rfl⟩
  have hrq : q rN ∈ SmallRows.localImage U R := ⟨rN,hr,rfl⟩
  have hz := commutator_mem_commutator hbq hrq
  rw [hw] at hz
  have he : q ⁅bN,rN⁆ = 1 := by
    rw [map_commutatorElement]
    exact hz
  exact (QuotientGroup.eq_one_iff ⁅bN,rN⁆).mp he

variable [Finite G]

/-- The actual M22 moved seed normally generates a two-group inside the
original mixed quotient, and its image in that group's Frattini quotient
is nonzero.  All nontriviality and containment inputs are discharged from
the original pair and its literal five-space action. -/
theorem selected_m22_moved_normalClosure
    {V H M I R U : Subgroup G} {T : Sylow 2 G} [IsElementaryAbelian 2 V]
    [IsElementaryAbelian 2 U]
    {i : I} {S : Sylow 2 I} (s : Selected H T M V I 1 i S)
    (hTH : (T : Subgroup G) ≤ H)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    (hHR : H ≤ normalizer (R : Set G))
    (hRP : R ≤ normalizer (I.pCoreIn 2 : Set G))
    (hPH : I.pCoreIn 2 ≤ H.pCoreIn 2)
    (hHU : H ≤ normalizer (U : Set G))
    {f : R →* MathieuCode.M22Quintet.Q}
    (hs : M22FiveSection R (V ⊓ I.pCoreIn 2) U f) :
    let J := SmallRows.localImage U (R ⊔ H)
    let B := SmallRows.localImage U (V ⊓ I.pCoreIn 2)
    let D := SmallRows.localImage U R
    let W := ⁅B.subgroupOf J,D.subgroupOf J⁆
    let E := normalClosure (W : Set J)
    E ≤ pCore 2 J ∧ IsPGroup 2 E ∧ W ≠ ⊥ ∧
      ¬ W ≤ (frattini E).map E.subtype := by
  let J := SmallRows.localImage U (R ⊔ H)
  let B := SmallRows.localImage U (V ⊓ I.pCoreIn 2)
  let D := SmallRows.localImage U R
  let W := ⁅B.subgroupOf J,D.subgroupOf J⁆
  let E := normalClosure (W : Set J)
  have hRU := hs.choose_spec.choose
  have hJU : R ⊔ H ≤ normalizer (U : Set G) := sup_le hRU hHU
  have hBJ : V ⊓ I.pCoreIn 2 ≤ R ⊔ H :=
    inf_le_right.trans ((pCoreIn_le 2 I).trans (s.family.le_ambient.trans le_sup_right))
  have hBJq : B ≤ J := map_mono (subgroupOf_mono _ hBJ)
  have hDJ : D ≤ J := map_mono (subgroupOf_mono _ le_sup_left)
  have hPQ := selected_one_pair_le_mixed_core s hTH hTV hHR hRP hPH
  have hBcore : B ≤ J.pCoreIn 2 := by
    rw [←localImage_twoCore hJU]
    exact map_mono (subgroupOf_mono _ (inf_le_right.trans hPQ))
  have hBcore' : B.subgroupOf J ≤ pCore 2 J := by
    intro b hb
    exact (mem_map_iff_mem J.subtype_injective).mp (hBcore hb)
  have hWcore : W ≤ pCore 2 J :=
    (commutator_mono hBcore' le_rfl).trans (commutator_le_left _ _)
  have hEcore : E ≤ pCore 2 J := normalClosure_le_normal hWcore
  have hW : W ≠ ⊥ := by
    intro hw
    apply m22_local_moved_ne_bot hs (hBJ.trans hJU)
    have hm := congrArg (fun X : Subgroup J => X.map J.subtype) hw
    rw [map_commutator,map_subgroupOf_eq_of_le hBJq,
      map_subgroupOf_eq_of_le hDJ,Subgroup.map_bot] at hm
    exact hm
  exact ⟨hEcore,pCore_isPGroup.to_le hEcore,hW,
    seed_not_le_normalClosure_frattini W hW⟩

/-- The original residual of I acts nontrivially on the Frattini quotient
of the normal closure constructed above.  Its actor map is explicitly the
original quotient map to N(U)/U; no moved-action premise is introduced. -/
theorem selected_m22_normalClosure_frattini_moved
    {V H M I R U : Subgroup G} {T : Sylow 2 G} [IsElementaryAbelian 2 V]
    [IsElementaryAbelian 2 U]
    {i : I} {S : Sylow 2 I} (s : Selected H T M V I 1 i S)
    (hTH : (T : Subgroup G) ≤ H)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    (hHR : H ≤ normalizer (R : Set G))
    (hRP : R ≤ normalizer (I.pCoreIn 2 : Set G))
    (hPH : I.pCoreIn 2 ≤ H.pCoreIn 2)
    (hHU : H ≤ normalizer (U : Set G))
    {f : R →* MathieuCode.M22Quintet.Q}
    (hs : M22FiveSection R (V ⊓ I.pCoreIn 2) U f)
    (hm : M22CodePairMultiplicityAction R I V U i f)
    (hc : Nonempty ((I ⧸ pCore 2 I) ≃* PSL(2,ZMod 2))) :
    let N := normalizer (U : Set G)
    let J := SmallRows.localImage U (R ⊔ H)
    let B := SmallRows.localImage U (V ⊓ I.pCoreIn 2)
    let D := SmallRows.localImage U R
    let W := ⁅B.subgroupOf J,D.subgroupOf J⁆
    let E := normalClosure (W : Set J)
    ∃ δ : pResidual 2 I →* J,
      (∀ a, (δ a : N ⧸ U.subgroupOf N) =
        QuotientGroup.mk' (U.subgroupOf N)
          ⟨(a.val : G),hHU (s.family.le_ambient a.val.property)⟩) ∧
      (quotientAut (frattini E)).comp
        ((MulAut.conjNormal : J →* MulAut E).comp δ) ≠ 1 := by
  let N := normalizer (U : Set G)
  let q := QuotientGroup.mk' (U.subgroupOf N)
  let J := SmallRows.localImage U (R ⊔ H)
  let B := SmallRows.localImage U (V ⊓ I.pCoreIn 2)
  let D := SmallRows.localImage U R
  let W := ⁅B.subgroupOf J,D.subgroupOf J⁆
  let E := normalClosure (W : Set J)
  obtain ⟨hEcore,hE,hW,hWphi⟩ := selected_m22_moved_normalClosure
    s hTH hTV hHR hRP hPH hHU hs
  have hIN : I ≤ N := s.family.le_ambient.trans hHU
  have hIJ : I ≤ R ⊔ H := s.family.le_ambient.trans le_sup_right
  let t : I →* J := (q.comp (inclusion hIN)).codRestrict J (by
    intro a
    exact ⟨inclusion hIN a,hIJ a.property,rfl⟩)
  let δ : pResidual 2 I →* J := t.comp (pResidual 2 I).subtype
  let α : pResidual 2 I →* MulAut E :=
    (MulAut.conjNormal : J →* MulAut E).comp δ
  have hRB := hs.choose
  have hRU := hs.choose_spec.choose
  have hDN : R.subgroupOf N ≤ normalizer ((V ⊓ I.pCoreIn 2).subgroupOf N : Set N) :=
    (subgroupOf_mono N hRB).trans (le_normalizer_comap N.subtype)
  have hDB : D ≤ normalizer (B : Set (N ⧸ U.subgroupOf N)) :=
    (map_mono hDN).trans (le_normalizer_map q)
  have hDB' : D.subgroupOf J ≤ normalizer (B.subgroupOf J : Set J) :=
    (subgroupOf_mono J hDB).trans (le_normalizer_comap J.subtype)
  have hWB : W ≤ B.subgroupOf J :=
    le_normalizer_iff_commutator_le_left.mp hDB'
  have hBP : B ≤ SmallRows.localImage U (I.pCoreIn 2) :=
    map_mono (subgroupOf_mono N inf_le_right)
  have hα : α ≠ 1 := by
    intro htriv
    obtain ⟨a,ha⟩ := m22_residual_cubic_centralizer_modulo hm hc
    obtain ⟨w,hw⟩ := ne_bot_iff_exists_ne_one.mp hW
    let wE : E := inclusion le_normalClosure w
    have hfix : α a wE = wE := by
      rw [htriv]
      rfl
    have hconj : δ a * (w.val : J) * (δ a)⁻¹ = (w.val : J) :=
      congrArg Subtype.val hfix
    have hcomm : ⁅δ a,(w.val : J)⁆ = 1 := by
      rw [commutatorElement_def,hconj,mul_inv_cancel]
    have hwp : (w.val : J).val ∈ SmallRows.localImage U (I.pCoreIn 2) :=
      hBP (hWB w.property)
    obtain ⟨p,hp,hpw⟩ := hwp
    have hcommq := congrArg J.subtype hcomm
    change ⁅q (inclusion hIN a.val), (w.val : J).val⁆ = 1 at hcommq
    rw [←hpw,←map_commutatorElement] at hcommq
    have hpU : (p : G) ∈ U := ha p.val hp
      ((QuotientGroup.eq_one_iff ⁅inclusion hIN a.val,p⁆).mp hcommq)
    have hpq : q p = 1 := (QuotientGroup.eq_one_iff p).mpr hpU
    apply hw
    apply Subtype.ext
    apply Subtype.ext
    exact hpw.symm.trans hpq
  refine ⟨δ,fun _ => rfl,?_⟩
  intro htriv
  exact hα (MulAut.action_eq_one_of_frattini (isPPerfect_pResidual 2) hE α htriv)

/-- An actual active chief interval inside this particular normal closure,
above its Frattini subgroup.  Thus its ambient elementary representation is
a subquotient of the very Frattini module generated by the natural seed. -/
theorem selected_m22_normalClosure_active_chief
    {V H M I R U : Subgroup G} {T : Sylow 2 G} [IsElementaryAbelian 2 V]
    [IsElementaryAbelian 2 U]
    {i : I} {S : Sylow 2 I} (s : Selected H T M V I 1 i S)
    (hTH : (T : Subgroup G) ≤ H)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    (hHR : H ≤ normalizer (R : Set G))
    (hRP : R ≤ normalizer (I.pCoreIn 2 : Set G))
    (hPH : I.pCoreIn 2 ≤ H.pCoreIn 2)
    (hHU : H ≤ normalizer (U : Set G))
    {f : R →* MathieuCode.M22Quintet.Q}
    (hs : M22FiveSection R (V ⊓ I.pCoreIn 2) U f)
    (hm : M22CodePairMultiplicityAction R I V U i f)
    (hc : Nonempty ((I ⧸ pCore 2 I) ≃* PSL(2,ZMod 2))) :
    let N := normalizer (U : Set G)
    let J := SmallRows.localImage U (R ⊔ H)
    let B := SmallRows.localImage U (V ⊓ I.pCoreIn 2)
    let D := SmallRows.localImage U R
    let W := ⁅B.subgroupOf J,D.subgroupOf J⁆
    let E := normalClosure (W : Set J)
    ∃ δ : pResidual 2 I →* J,
      (∀ a, (δ a : N ⧸ U.subgroupOf N) =
        QuotientGroup.mk' (U.subgroupOf N)
          ⟨(a.val : G),hHU (s.family.le_ambient a.val.property)⟩) ∧
      ∃ A C : NoncentralChiefRefinement.NormalNode J,
        (frattini E).map E.subtype ≤ A.val ∧ A ⋖ C ∧ C.val ≤ E ∧
          C.val ≤ pCore 2 J ∧
          (NoncentralChiefRefinement.sectionAction A C).comp δ ≠ 1 := by
  let N := normalizer (U : Set G)
  let J := SmallRows.localImage U (R ⊔ H)
  let B := SmallRows.localImage U (V ⊓ I.pCoreIn 2)
  let D := SmallRows.localImage U R
  let W := ⁅B.subgroupOf J,D.subgroupOf J⁆
  let E := normalClosure (W : Set J)
  obtain ⟨hEcore,hE,hW,hWphi⟩ := selected_m22_moved_normalClosure
    s hTH hTV hHR hRP hPH hHU hs
  obtain ⟨δ,hδ,hmove⟩ := selected_m22_normalClosure_frattini_moved
    s hTH hTV hHR hRP hPH hHU hs hm hc
  let Z : NoncentralChiefRefinement.NormalNode J :=
    ⟨(frattini E).map E.subtype,inferInstanceAs ((frattini E).map E.subtype).Normal⟩
  let Q : NoncentralChiefRefinement.NormalNode J := ⟨E,inferInstanceAs E.Normal⟩
  let K := δ.range
  have hK : IsPPerfect 2 K := (isPPerfect_pResidual 2).of_surjective
    δ.rangeRestrict δ.rangeRestrict_surjective
  have hzq : Z ≤ Q := map_subtype_le _
  have hcomm : ¬ ⁅E,K⁆ ≤ Z.val := by
    intro hh
    apply hmove
    apply MonoidHom.ext
    intro a
    apply MulEquiv.ext
    intro x
    induction x using QuotientGroup.induction_on with
    | H e =>
      change (quotientAut (frattini E)) (MulAut.conjNormal (δ a))
        (QuotientGroup.mk' (frattini E) e) = QuotientGroup.mk' (frattini E) e
      rw [quotientAut_apply_mk]
      apply QuotientGroup.eq_iff_div_mem.mpr
      apply (mem_map_iff_mem E.subtype_injective).mp
      rw [commutator_comm] at hh
      have he := hh (commutator_mem_commutator (show δ a ∈ K from ⟨a,rfl⟩) e.property)
      change (MulAut.conjNormal (δ a) e : J) / (e : J) ∈ Z.val
      rw [MulAut.conjNormal_apply]
      simpa only [commutatorElement_def,div_eq_mul_inv] using he
  obtain ⟨A,C,hZA,hAC,hCE,hKmove⟩ :=
    HermitianSource.moved_chief_of_twoPerfect_subgroup Z Q K hzq hE hK hcomm
  have hCE' : C.val ≤ E := hCE
  refine ⟨δ,hδ,A,C,hZA,hAC,hCE',hCE'.trans hEcore,?_⟩
  intro htriv
  apply hKmove
  rintro _ ⟨a,rfl⟩
  exact DFunLike.congr_fun htriv a

