/-!
# The original M22 four-space survives an actual active chief section

The already-selected chief interval is moved by the original O²(I).
Since I is generated by V and its prescribed i⁻¹-conjugate, V must also
move the interval. Source case I confines this movement to the moved seed.
Irreducibility then puts the entire seed in the chief numerator and makes
its intersection with the chief denominator trivial.

The selected pair, inverse conjugator, normal closure, Frattini denominator,
and literal actor maps are retained. No arbitrary chief factor is assumed
to inherit the residual movement, and no H-kernel premise is needed here.
Source: Aschbacher--Smith 8.2.9, printed p.721, refs/quasithin.pdf.
-/

public noncomputable section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
open scoped IsMulCommutative commutatorElement MatrixGroups
namespace CFSG.Quasithin.Chapter8.Section02.MathieuShadowRows
open ChapterE HermitianSource Offenders.Parabolic.Construction
  Normalizer.SmallOvergroups Normalizer.ParabolicReduction.RankSieve
open MathieuCode.NormalizedShadowRows.M22CodeSection
set_option backward.isDefEq.respectTransparency false

private theorem two_conjugate_action_nontrivial
    {G D : Type*} [Group G] [Group D] (V I : Subgroup G) (i : I)
    (hgen : V ⊔ V.map (MulAut.conj (i.val)⁻¹).toMonoidHom = I)
    (t : I →* D) (ht : t ≠ 1) :
    ∃ v : V, t (inclusion (show V ≤ I from hgen ▸ le_sup_left) v) ≠ 1 := by
  classical
  have hVI : V ≤ I := hgen ▸ le_sup_left
  by_contra! hv
  let K := t.ker
  have hVK : V ≤ K.map I.subtype := by
    intro v hvV
    exact ⟨⟨v,hVI hvV⟩,hv ⟨v,hvV⟩,rfl⟩
  have hIK : I ≤ K.map I.subtype := by
    conv_lhs => rw [←hgen]
    refine sup_le hVK ?_
    rintro _ ⟨v,hvV,rfl⟩
    let vI : I := ⟨v,hVI hvV⟩
    have hkv : vI ∈ K := hv ⟨v,hvV⟩
    refine ⟨i⁻¹*vI*(i⁻¹)⁻¹,(inferInstance : K.Normal).conj_mem vI hkv i⁻¹,?_⟩
    rfl
  apply ht
  apply MonoidHom.ext
  intro x
  obtain ⟨y,hy,hyx⟩ := hIK x.property
  have heq : y = x := Subtype.ext hyx
  exact heq ▸ hy

private theorem m22_five_seed_survives_interval
    {G : Type*} [Group G] (B R U L : Subgroup G)
    (fq : R →* MathieuCode.M22Quintet.Q) (hs : M22FiveSection R B U fq)
    (hBL : B ≤ L) (hRL : R ≤ L) (hLU : L ≤ normalizer (U : Set G))
    (K C : NoncentralChiefRefinement.NormalNode (SmallRows.localImage U L))
    (Vq : Subgroup (SmallRows.localImage U L))
    (hmove : ⁅C.val,Vq⁆ ≤
      ⁅(SmallRows.localImage U B).subgroupOf (SmallRows.localImage U L),
        (SmallRows.localImage U R).subgroupOf (SmallRows.localImage U L)⁆)
    (hne : ¬ ⁅C.val,Vq⁆ ≤ K.val) :
    let J := SmallRows.localImage U L
    let W := ⁅(SmallRows.localImage U B).subgroupOf J,(SmallRows.localImage U R).subgroupOf J⁆
    W ≤ C.val ∧ W ⊓ K.val = ⊥ := by
  obtain ⟨hRB,hRU,hBU,r,eB,hrs,_,_,hact,_,hEl,σ,hσ,_,_,_⟩ := hs
  let := hBU
  let := hEl
  obtain ⟨j,a,hji,hjr,har,hjq,haq,hja⟩ :=
    literal_section_embedding B R U L hRB hRU hBL hRL hLU
  have hjσ (x : R) (b : B ⧸ U.subgroupOf B) :
      j ((σ x (Additive.ofMul b)).toMul) = a x * j b * (a x)⁻¹ := by
    rw [hσ]
    exact hja x b
  let J := SmallRows.localImage U L
  let W := ⁅(SmallRows.localImage U B).subgroupOf J,(SmallRows.localImage U R).subgroupOf J⁆
  have hW : (Coinvariants.ker σ).toAddSubgroup.toSubgroup'.map j = W := by
    rw [moved_image_commutator σ j a hjσ,hjr,har]
  let e : Additive (B ⧸ U.subgroupOf B) ≃ₗ[ZMod 2] Additive MathieuCode.M22Quintet.K :=
    LinearEquiv.ofBijective (eB.toAdditive.toAddMonoidHom.toZModLinearMap 2) eB.bijective
  have he (r' : R) (b : Additive (B ⧸ U.subgroupOf B)) : e (σ r' b) = fiveAction (r r') (e b) :=
    (congrArg (fun w => Additive.ofMul (eB w.toMul)) (hσ r' b.toMul)).trans (hact r' b.toMul)
  exact moved_seed_survives_interval σ r hrs e he j a hjσ W hW K.val C.val Vq hmove hne

variable {G : Type*} [Group G] [Finite G]

/-- The original active chief interval contains the whole moved four-space
and its denominator misses that space. The original selected V moves this
section by normal generation of I from V and its prescribed conjugate. -/
theorem selected_m22_active_chief_seed
    {V H M I R U : Subgroup G} {T : Sylow 2 G} [IsElementaryAbelian 2 V]
    [IsElementaryAbelian 2 U]
    {i : I} {S : Sylow 2 I} (s : Selected H T M V I 1 i S)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) M)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    (hHR : H ≤ normalizer (R : Set G))
    (hRP : R ≤ normalizer (I.pCoreIn 2 : Set G))
    (hPH : I.pCoreIn 2 ≤ H.pCoreIn 2)
    (hHU : H ≤ normalizer (U : Set G))
    (hinter : V ⊓ I.pCoreIn 2 = V ⊓ H.pCoreIn 2)
    {fq : R →* MathieuCode.M22Quintet.Q}
    (hs : M22FiveSection R (V ⊓ I.pCoreIn 2) U fq)
    (hm : M22CodePairMultiplicityAction R I V U i fq)
    (hc : Nonempty ((I ⧸ pCore 2 I) ≃* PSL(2,ZMod 2))) :
    let N := normalizer (U : Set G)
    let J := SmallRows.localImage U (R ⊔ H)
    let B := SmallRows.localImage U (V ⊓ I.pCoreIn 2)
    let D := SmallRows.localImage U R
    let W := ⁅B.subgroupOf J,D.subgroupOf J⁆
    let E := normalClosure (W : Set J)
    let hVI : V ≤ I := s.generate ▸ le_sup_left
    ∃ t : I →* J,
      (∀ x, (t x : N ⧸ U.subgroupOf N) = QuotientGroup.mk' (U.subgroupOf N)
        ⟨x.val,hHU (s.family.le_ambient x.property)⟩) ∧
      ∃ A C : NoncentralChiefRefinement.NormalNode J,
        (frattini E).map E.subtype ≤ A.val ∧ A ⋖ C ∧ C.val ≤ E ∧
          C.val ≤ pCore 2 J ∧
          (NoncentralChiefRefinement.sectionAction A C).comp
            (t.comp (pResidual 2 I).subtype) ≠ 1 ∧
          W ≤ C.val ∧ W ⊓ A.val = ⊥ ∧
          ∃ v : V, NoncentralChiefRefinement.sectionAction A C (t (inclusion hVI v)) ≠ 1 := by
  let N := normalizer (U : Set G)
  let q := QuotientGroup.mk' (U.subgroupOf N)
  let J := SmallRows.localImage U (R ⊔ H)
  let B := SmallRows.localImage U (V ⊓ I.pCoreIn 2)
  let D := SmallRows.localImage U R
  let W := ⁅B.subgroupOf J,D.subgroupOf J⁆
  let E := normalClosure (W : Set J)
  have hTH : (T : Subgroup G) ≤ H := hH.1.1.2
  have hVI : V ≤ I := s.generate ▸ le_sup_left
  have hIN : I ≤ N := s.family.le_ambient.trans hHU
  have hIJ : I ≤ R ⊔ H := s.family.le_ambient.trans le_sup_right
  let t : I →* J := (q.comp (inclusion hIN)).codRestrict J
    (fun x => ⟨inclusion hIN x,hIJ x.property,rfl⟩)
  obtain ⟨δ,hδ,A,C,hφA,hAC,hCE,hCcore,hactive⟩ :=
    selected_m22_normalClosure_active_chief s hTH hTV hHR hRP hPH hHU hs hm hc
  have hδt : δ = t.comp (pResidual 2 I).subtype := by
    apply MonoidHom.ext
    intro x
    apply Subtype.ext
    exact hδ x
  rw [hδt] at hactive
  let F := NoncentralChiefRefinement.sectionAction A C
  have ht : F.comp t ≠ 1 := by
    intro hz
    apply hactive
    apply MonoidHom.ext
    intro x
    exact DFunLike.congr_fun hz x.val
  obtain ⟨v,hv⟩ := two_conjugate_action_nontrivial V I i s.generate (F.comp t) ht
  have hvJ : t (inclusion hVI v) ∈ (SmallRows.localImage U V).subgroupOf J :=
    ⟨inclusion hIN (inclusion hVI v),v.property,rfl⟩
  have hne : ¬ ⁅C.val,(SmallRows.localImage U V).subgroupOf J⁆ ≤ A.val := by
    intro hcomm
    rw [commutator_comm] at hcomm
    apply hv
    apply MulEquiv.ext
    intro x
    induction x using QuotientGroup.induction_on with
    | H c =>
      change NoncentralChiefRefinement.sectionAction A C (t (inclusion hVI v))
        (QuotientGroup.mk' (A.val.subgroupOf C.val) c) =
          QuotientGroup.mk' (A.val.subgroupOf C.val) c
      rw [NoncentralChiefRefinement.sectionAction_mk]
      apply QuotientGroup.eq_iff_div_mem.mpr
      change (MulAut.conjNormal (t (inclusion hVI v)) c : J) / (c : J) ∈ A.val
      rw [MulAut.conjNormal_apply]
      simpa only [commutatorElement_def,div_eq_mul_inv] using
        hcomm (commutator_mem_commutator hvJ c.property)
  have hmove : ⁅C.val,(SmallRows.localImage U V).subgroupOf J⁆ ≤ W :=
    (commutator_mono hCE le_rfl).trans
      (selected_m22_normalClosure_displacement s hH hTV hHR hRP hPH hHU hinter hs)
  have hBL : V ⊓ I.pCoreIn 2 ≤ R ⊔ H :=
    inf_le_right.trans ((pCoreIn_le 2 I).trans hIJ)
  have hseed := m22_five_seed_survives_interval (V ⊓ I.pCoreIn 2) R U (R ⊔ H)
    fq hs hBL le_sup_left (sup_le hs.choose_spec.choose hHU) A C
      ((SmallRows.localImage U V).subgroupOf J) hmove hne
  exact ⟨t,fun _ => rfl,A,C,hφA,hAC,hCE,hCcore,hactive,hseed.1,hseed.2,v,hv⟩

end CFSG.Quasithin.Chapter8.Section02.MathieuShadowRows
