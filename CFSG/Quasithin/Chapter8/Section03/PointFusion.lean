module

public import CFSG.Quasithin.Chapter8.Section03.CentralizerSetup
public import Theory.GroupTheory.ConjugateIntersectionCentralizer
public import Theory.GroupTheory.CharacteristicCentralizerFusion
public import Mathlib.GroupTheory.Commutator.Basic

/-!
# From the centralizer two-core to intersection fusion

The line generated by an involution has normalizer equal to its element
centralizer. Thus the inclusion V ≤ O₂(C_G(z)) lets the non-FF branch of
3.2.10(6) apply to that line. Fusion controlled by N_G(V), from 3.2.10(2),
then transports the result to every intersection point conjugate to z.

The two FSU consequences and the two-core inclusion remain explicit inputs.
This proves their deduction, not those earlier results: qt-3-02-fusion owns
the FSU consequences and the §8.3 source assembly must establish 8.3.12.

Source: Aschbacher--Smith, combined manuscript (1 March 2004), Lemma
8.3.13, printed p.727, using Proposition 3.2.10(2,6), printed pp.583--584.
-/

public section

namespace CFSG.Quasithin.Chapter8.Section03

open Subgroup

/-- The exact core and fusion transport in 8.3.13. The universal implication
`hcoreFusion` is the non-FF branch of 3.2.10(6), with the ambient FSU
hypotheses already specialized to V. -/
theorem lemma_8_3_13_of_core_and_FSU_fusion
    {G : Type*} [Group G] [Finite G] (D : CentralizerSetup G) (V : Subgroup G)
    (hz : orderOf D.z = 2) (hzV : D.z ∈ V)
    (hcore : V ≤ D.Gz.pCoreIn 2)
    (hcontrol : ∀ x ∈ V, IsConj x D.z →
      ∃ m ∈ normalizer (V : Set G), (MulAut.conj m) x = D.z)
    (hcoreFusion : ∀ U : Subgroup G, U ≤ V →
      V ≤ (normalizer (U : Set G)).pCoreIn 2 →
      ∀ g : G, U ≤ V.map (MulAut.conj g).toMonoidHom →
        ⁅V, V.map (MulAut.conj g).toMonoidHom⁆ = ⊥)
    (g x : G) (hxV : x ∈ V)
    (hxg : x ∈ V.map (MulAut.conj g).toMonoidHom) (hxz : IsConj x D.z) :
    V.map (MulAut.conj g).toMonoidHom ≤ centralizer (V : Set G) := by
  apply conjugate_le_centralizer_of_fused_intersection V D.z hcontrol ?_ g x hxV hxg hxz
  intro k hzk
  have hnorm : normalizer (zpowers D.z : Set G) = D.Gz :=
    normalizer_zpowers_eq_centralizer_of_order_two D.z hz
  have hcore' : V ≤ (normalizer (zpowers D.z : Set G)).pCoreIn 2 := by
    rwa [hnorm]
  exact le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp
    (hcoreFusion (zpowers D.z) (zpowers_le.mpr hzV) hcore' k (zpowers_le.mpr hzk)))

end CFSG.Quasithin.Chapter8.Section03
