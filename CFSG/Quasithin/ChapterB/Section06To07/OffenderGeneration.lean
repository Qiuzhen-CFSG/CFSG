module
public import CFSG.Quasithin.ChapterB.Section06To07.Structure.CoreOdd
public import Theory.Representation.BinaryOffender.Stability
public import Theory.GroupTheory.PResidual.PerfectCover

/-!
# Offender generation in a core-free minimal parabolic

The maximal-overgroup core has a normal Sylow two-subgroup O₂(G).
When this is trivial, that core contains no nontrivial two-subgroup.
Consequently every normal subgroup containing a nontrivial two-subgroup
supplements the fixed Sylow subgroup and contains O²(G).

Apply this to an actual best offender and the normal subgroup generated
by its full family. This proves B.6.9(4), and also the version for the
minimal best offenders used in its proof, without representation classification.
Source: Aschbacher–Smith, Lemma B.6.9 and its opening paragraph,
combined manuscript of 1 March 2004, printed pp.115–116.
-/

public section
open Subgroup Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterB
universe u v
variable {G : Type u} [Group G] [Finite G]

theorem minimalParabolic_normal_contains_two_supplements
    (T : Sylow 2 G) (hP : IsMinimalParabolicOver T ⊤)
    (hcore : pCore 2 G = ⊥) (N A : Subgroup G) [N.Normal]
    (hA : IsPGroup 2 A) (hne : A ≠ ⊥) (hAN : A ≤ N) :
    pResidual 2 G ≤ N ∧ N ⊔ (T : Subgroup G) = ⊤ := by
  have hnot : ¬ N ≤ minimalParabolicCore T hP := by
    intro hy
    have haJ : A ≤ minimalParabolicCore T hP := hAN.trans hy
    obtain ⟨S, hS⟩ := minimalParabolic_twoCore_sylow_core T hP
    have hSt : (S : Subgroup (minimalParabolicCore T hP)) = ⊥ := by
      rw [hS, hcore, bot_subgroupOf]
    let : (S : Subgroup (minimalParabolicCore T hP)).Normal := by rw [hSt]; infer_instance
    let : Unique (Sylow 2 (minimalParabolicCore T hP)) := Sylow.unique_of_normal S inferInstance
    obtain ⟨S', hAS⟩ := hA.comap_subtype.exists_le_sylow
    have hS' : S' = S := Subsingleton.elim _ _
    have hbot : A.subgroupOf (minimalParabolicCore T hP) = ⊥ := by
      rw [hS', hSt] at hAS
      exact bot_unique hAS
    apply hne
    have hm := congrArg (map (minimalParabolicCore T hP).subtype) hbot
    simpa only [map_subgroupOf_eq_of_le haJ, Subgroup.map_bot] using hm
  have hr := (minimalParabolic_normal_subgroup_residual_dichotomy T hP N).resolve_left hnot
  have hg := (minimalParabolic_normal_subgroup_dichotomy T hP N).resolve_left hnot
  exact ⟨hr, (sup_comm N (T : Subgroup G)).trans hg⟩

variable {W : Type v} [AddCommGroup W] [Module (ZMod 2) W]

/-- The normal subgroup generated by any actual stable offender family supplements T. -/
theorem stable_offender_generation
    (T : Sylow 2 G) (hP : IsMinimalParabolicOver T ⊤)
    (ρ : Representation (ZMod 2) G W) {P : Set (Subgroup G)}
    (hPstable : IsStable ρ P) (hcore : pCore 2 G = ⊥) :
    pResidual 2 G ≤ generatedBy P ⊤ ∧ generatedBy P ⊤ ⊔ (T : Subgroup G) = ⊤ := by
  let := hPstable.generatedBy_normal
  obtain ⟨A, hA⟩ := hPstable.1
  have hb := hPstable.2.1 A hA
  exact minimalParabolic_normal_contains_two_supplements T hP hcore _ A
    hb.1.2.isPGroup hb.1.1 (le_iSup_of_le A (le_iSup_of_le ⟨hA, le_top⟩ le_rfl))

/-- B.6.9(4), including residual containment, for the original offender subgroup. -/
theorem offender_generation [Module.Finite (ZMod 2) W]
    (T : Sylow 2 G) (hP : IsMinimalParabolicOver T ⊤)
    (ρ : Representation (ZMod 2) G W) (hff : IsFFModule ρ)
    (hcore : pCore 2 G = ⊥) :
    pResidual 2 G ≤ offenderSubgroup ρ ∧ offenderSubgroup ρ ⊔ (T : Subgroup G) = ⊤ := by
  let : (offenderSubgroup ρ).Normal := offenderSubgroup_normal ρ
  obtain ⟨A, hA⟩ := (isFFModule_iff_exists_bestOffender ρ).mp hff
  exact minimalParabolic_normal_contains_two_supplements T hP hcore _ A
    hA.1.2.isPGroup hA.1.1 (le_iSup_of_le A (le_iSup_of_le ⟨hA, le_top⟩ le_rfl))

/-- The minimal-best-offender family has the same residual and Sylow generation property. -/
theorem minimal_best_offender_generation [Module.Finite (ZMod 2) W]
    (T : Sylow 2 G) (hP : IsMinimalParabolicOver T ⊤)
    (ρ : Representation (ZMod 2) G W) (hff : IsFFModule ρ)
    (hcore : pCore 2 G = ⊥) :
    pResidual 2 G ≤ generatedBy {A | IsMinimalBestOffender ρ A} ⊤ ∧
      generatedBy {A | IsMinimalBestOffender ρ A} ⊤ ⊔ (T : Subgroup G) = ⊤ :=
  stable_offender_generation T hP ρ (isStable_minimalBestOffenders ρ hff) hcore

/-- The offender subgroup has exactly the original embedded two-residual. -/
theorem offender_residual_eq [Module.Finite (ZMod 2) W]
    (T : Sylow 2 G) (hP : IsMinimalParabolicOver T ⊤)
    (ρ : Representation (ZMod 2) G W) (hff : IsFFModule ρ)
    (hcore : pCore 2 G = ⊥) :
    (pResidual 2 (offenderSubgroup ρ)).map (offenderSubgroup ρ).subtype = pResidual 2 G := by
  have hle := (offender_generation T hP ρ hff hcore).1
  apply le_antisymm (map_pResidual_le 2 _) ?_
  have hh := embedded_pResidual_mono 2 hle
  rw [(pResidual_eq_top_iff 2 _).mpr (isPPerfect_pResidual 2),
    ← MonoidHom.range_eq_map, range_subtype] at hh
  exact hh

end CFSG.Quasithin.ChapterB
