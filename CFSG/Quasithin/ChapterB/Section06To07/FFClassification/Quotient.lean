module

public import CFSG.Quasithin.ChapterB.Section06To07.Structure.CoreOdd
public import Theory.GroupTheory.MinimalParabolicCentral
import all CFSG.Quasithin.ChapterB.Section06To07.Structure

/-!
# Reduced images of minimal parabolics

A nontrivial image with trivial two-core has kernel in the unique maximal
overgroup core: otherwise the image is generated by its Sylow two-subgroup.
Subgroup correspondence then preserves the unique maximal overgroup.
Nonnormality of the image Sylow follows because the original Sylow
normally generates the minimal parabolic.

This applies to the literal reduced-module centralizer quotient in
Aschbacher–Smith B.6.8(6) and E.2.3, printed pp.114–115 and 216–217
(1 March 2004 manuscript). No condition is imposed on the kernel's order.
-/

public section
open Subgroup
namespace CFSG.Quasithin.ChapterB
variable {G H : Type*} [Group G] [Finite G] [Group H]

theorem minimalParabolic_map_of_kernel_le_core
    (T : Sylow 2 G) (hP : IsMinimalParabolicOver T ⊤)
    (q : G →* H) (hq : Function.Surjective q)
    (hk : q.ker ≤ minimalParabolicCore T hP) :
    IsMinimalParabolicOver (T.mapSurjective hq) ⊤ := by
  let M := minimalParabolicMax T hP
  let B := M.map q
  have hkM : q.ker ≤ M := hk.trans (normalCore_le _)
  have hbpre : B.comap q = M := comap_map_eq_self hkM
  have hb : IsCoatom B := by
    refine ⟨?_, ?_⟩
    · intro he
      apply (minimalParabolicMax_spec T hP).1.ne_top
      change M = ⊤
      rw [← hbpre, he, comap_top]
    · intro C hBC
      have hMC : M < C.comap q := by
        rw [← hbpre]
        exact lt_of_le_of_ne (comap_mono hBC.le)
          (fun he => hBC.ne (comap_injective hq he))
      apply comap_injective hq
      simpa using (minimalParabolicMax_spec T hP).1.2 _ hMC
  apply (isMinimalParabolicOver_top_iff _).mpr
  refine ⟨⟨B, ⟨hb, map_mono (minimalParabolicMax_spec T hP).2⟩, ?_⟩, ?_⟩
  · intro C hC
    apply comap_injective hq
    rw [hbpre]
    exact minimalParabolicMax_unique T hP (isCoatom_comap_of_surjective hq hC.1)
      (map_le_iff_le_comap.mp hC.2)
  · intro hn
    let N := ((T : Subgroup G).map q).comap q
    let : N.Normal := hn.comap q
    have hTN : (T : Subgroup G) ≤ N := le_comap_map q _
    have hN := T.normal_eq_top_of_uniqueMaximal hP.1
      ((isMinimalParabolicOver_top_iff T).mp hP).2 N hTN
    have hNM : N ≤ M := by
      rw [show N = ((T : Subgroup G).map q).comap q from rfl, comap_map_eq]
      exact sup_le (minimalParabolicMax_spec T hP).2 hkM
    rw [hN] at hNM
    exact (minimalParabolicMax_spec T hP).1.ne_top (top_unique hNM)

/-- A nontrivial reduced image of a minimal parabolic is again minimal parabolic. -/
theorem minimalParabolic_reduced_image
    (T : Sylow 2 G) (hP : IsMinimalParabolicOver T ⊤)
    (q : G →* H) (hq : Function.Surjective q)
    (hcore : pCore 2 H = ⊥) (hne : q.ker ≠ ⊤) :
    q.ker ≤ minimalParabolicCore T hP ∧
      IsMinimalParabolicOver (T.mapSurjective hq) ⊤ := by
  have hk : q.ker ≤ minimalParabolicCore T hP := by
    obtain hk | hk := minimalParabolic_normal_subgroup_dichotomy T hP q.ker
    · exact hk
    exfalso
    have hm := congrArg (map q) hk
    have ht : (T : Subgroup G).map q = ⊤ := by
      have hkq : q.ker.map q = ⊥ := Subgroup.map_ker_self q
      simpa only [Subgroup.map_sup, hkq, sup_bot_eq, map_top_of_surjective q hq] using hm
    have hp : IsPGroup 2 (⊤ : Subgroup H) := ht ▸ T.isPGroup'.map q
    have hpc : (⊤ : Subgroup H) ≤ pCore 2 H := le_sSup ⟨inferInstance, hp⟩
    rw [hcore] at hpc
    apply hne
    apply top_unique
    intro x _
    change q x = 1
    exact mem_bot.mp (hpc (mem_top _))
  exact ⟨hk, minimalParabolic_map_of_kernel_le_core T hP q hq hk⟩

end CFSG.Quasithin.ChapterB
