/-!
# Cubic selection in the actual solvable natural factors

The source solvable FF classification expresses the same offender as an
internal product of Sylow subgroups of its actual SL₂(2) factors. Choose a
nontrivial coordinate. The kernel of that coordinate on the offender has
index two and centralizes the selected factor. Its cubic is normalized and
generated by commutators with the offender. The prescribed Sylow subgroup
permutes all factors transitively, so the cubic and that Sylow generate the
whole original group.

A small natural wreath actor is solvable because its two-residual is an
elementary cubic group. Thus this argument handles both single and paired
small natural branches without changing the actual subgroup positions. The
final wrapper applies to the literal image of an original irreducible chief
action and supplies every premise of the source normalizer lift.

Source: Aschbacher–Smith, 3.1.9(5), 15.1.12(4), using B.1.8 and B.6.9.
-/
public section
open Subgroup Representation Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterB.SolvableFFFactors
variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V] {ρ : Representation (ZMod 2) G V}

omit [Finite G] [FiniteDimensional (ZMod 2) V] in
/-- One active coordinate supplies the selection; the other coordinates form
its passive kernel. Sylow transitivity makes its cubic generate all factors. -/
theorem active_factor_selection (d : SolvableFFFactors ρ) (S A : Subgroup G)
    [IsElementaryAbelian 2 A] (hAS : A ≤ S)
    (C : Fin d.count → Subgroup G) (hC : ∀ j, C j ≤ d.factor j)
    (hA : A = ⨆ j, C j) (i : Fin d.count) (hcard : Nat.card (C i)=2)
    (L₀ : Subgroup (d.factor i))
    (hAL : (C i).subgroupOf (d.factor i) ≤ normalizer (L₀ : Set (d.factor i)))
    (hcomm : L₀=⁅L₀,(C i).subgroupOf (d.factor i)⁆)
    (hgen : L₀ ⊔ (C i).subgroupOf (d.factor i)=⊤)
    (htrans : ∀ j, ∃ t ∈ S, (d.factor i).map (MulAut.conj t).toMonoidHom=d.factor j)
    (hYS : offenderSubgroup ρ ⊔ S=⊤) :
    ∃ R L : Subgroup G, R ≤ S ∧ A ≤ normalizer (R : Set G) ∧
      L ≤ normalizer (R : Set G) ∧ A ≤ normalizer (L : Set G) ∧
      R.relIndex A=2 ∧ L=⁅L,A⁆ ∧ L ⊔ S=⊤ := by
  classical
  let eA : ((j : Fin d.count) → C j) ≃* A :=
    (d.subproductEquiv C hC).trans (MulEquiv.subgroupCongr hA.symm)
  let f : A →* C i := (Pi.evalMonoidHom (fun j => C j) i).comp eA.symm.toMonoidHom
  have hf : Function.Surjective f := by
    intro c
    refine ⟨eA (Pi.mulSingle i c),?_⟩
    simp [f]
  have heA (x : (j : Fin d.count) → C j) :
      (eA x : G)=d.subproductInclusion C hC x := rfl
  have hconj (a : A) (z : d.factor i) :
      (a : G)*(z : G)*(a : G)⁻¹ = (f a : G)*(z : G)*(f a : G)⁻¹ := by
    have hprod : d.productInclusion (d.coordinateInclusion C hC (eA.symm a))=(a : G) := by
      change d.subproductInclusion C hC (eA.symm a)=(a : G)
      rw [←heA,eA.apply_symm_apply]
    have hh := d.productInclusion_conj_single (d.coordinateInclusion C hC (eA.symm a)) i z
    rw [hprod] at hh
    exact hh
  let R := f.ker.map A.subtype
  let L := L₀.map (d.factor i).subtype
  have hRA : R ≤ A := map_subtype_le _
  have hCiA : C i ≤ A := hA ▸ le_iSup C i
  have hCi : ((C i).subgroupOf (d.factor i)).map (d.factor i).subtype=C i :=
    map_subgroupOf_eq_of_le (hC i)
  have hAL' : A ≤ normalizer (L : Set G) := by
    apply le_normalizer_iff.mpr
    intro a ha l hl
    obtain ⟨z,hz,rfl⟩ := hl
    change a*(z : G)*a⁻¹ ∈ L
    have hh : a*(z : G)*a⁻¹ = (f ⟨a,ha⟩ : G)*(z : G)*(f ⟨a,ha⟩ : G)⁻¹ := hconj ⟨a,ha⟩ z
    rw [hh]
    let c : d.factor i := ⟨f ⟨a,ha⟩,hC i (f ⟨a,ha⟩).property⟩
    have hc : c∈(C i).subgroupOf (d.factor i) := (f ⟨a,ha⟩).property
    exact mem_map_of_mem (d.factor i).subtype
      (le_normalizer_iff.mp hAL c hc z hz)
  have hLC : L ≤ centralizer (R : Set G) := by
    rintro _ ⟨z,hz,rfl⟩
    apply mem_centralizer_iff.mpr
    rintro _ ⟨a,ha,rfl⟩
    have hfa : f a=1 := MonoidHom.mem_ker.mp ha
    have hh := hconj a z
    rw [hfa] at hh
    have hh' := congrArg (fun x : G => x*(a : G)) hh
    change (a : G)*(z : G)=(z : G)*(a : G)
    simpa only [OneMemClass.coe_one,one_mul,mul_one,inv_one,mul_assoc,inv_mul_cancel] using hh'
  refine ⟨R,L,hRA.trans hAS,?_,hLC.trans (Subgroup.centralizer_le_normalizer _),hAL',?_,?_,?_⟩
  · apply le_normalizer_iff.mpr
    intro a ha r hr
    have hh := congrArg Subtype.val (mul_comm' (⟨a,ha⟩ : A) ⟨r,hRA hr⟩)
    change a*r=r*a at hh
    rwa [hh,mul_inv_cancel_right]
  · change (f.ker.map A.subtype).relIndex A=2
    rw [relIndex,subgroupOf,comap_map_eq_self_of_injective A.subtype_injective,
      index_ker,MonoidHom.range_eq_top.mpr hf,card_top,hcard]
  · have hh := congrArg (map (d.factor i).subtype) hcomm
    rw [map_commutator,hCi] at hh
    exact le_antisymm (hh.le.trans (commutator_mono le_rfl hCiA))
      (le_normalizer_iff_commutator_le_left.mp hAL')
  · let J := L ⊔ S
    have hFi : d.factor i ≤ J := by
      have hh := congrArg (map (d.factor i).subtype) hgen
      rw [Subgroup.map_sup,hCi,←MonoidHom.range_eq_map,range_subtype] at hh
      rw [←hh]
      exact sup_le le_sup_left (hCiA.trans (hAS.trans le_sup_right))
    have hY : offenderSubgroup ρ ≤ J := by
      rw [←d.iSup_factor]
      apply iSup_le
      intro j
      obtain ⟨t,ht,he⟩ := htrans j
      rw [←he]
      rintro _ ⟨x,hx,rfl⟩
      exact J.mul_mem (J.mul_mem ((show S ≤ J from le_sup_right) ht) (hFi hx)) (J.inv_mem ((show S ≤ J from le_sup_right) ht))
    exact top_unique (hYS ▸ sup_le hY le_sup_right)
end CFSG.Quasithin.ChapterB.SolvableFFFactors

namespace CFSG.Quasithin.ChapterB
variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V]

/-- The literal source solvable FF factors select the same offender's inactive
index-two subgroup and an active cubic, including the original Sylow generation. -/
theorem solvable_minimalParabolic_offender_cubic_selection
    (ρ : Representation (ZMod 2) G V) (T : Sylow 2 G)
    (hP : IsMinimalParabolicOver T ⊤) (hsolv : Group.IsSolvable G)
    (hcore : pCore 2 G=⊥) (hf : Function.Injective ρ)
    (A : Subgroup G) (hAT : A ≤ (T : Subgroup G)) (hA : IsOffender ρ A) :
    ∃ R L : Subgroup G, R ≤ (T : Subgroup G) ∧ A ≤ normalizer (R : Set G) ∧
      L ≤ normalizer (R : Set G) ∧ A ≤ normalizer (L : Set G) ∧
      R.relIndex A=2 ∧ L=⁅L,A⁆ ∧ L ⊔ (T : Subgroup G)=⊤ := by
  let : IsElementaryAbelian 2 A := hA.1.2
  obtain ⟨d,ht,_,_,hYS⟩ := source_solvable_minimalParabolic_factors (ρ := ρ) T hP hsolv hcore hf ⟨A,hA⟩
  let D := d.toSolvableFFFactors
  have hs := SolvableFFFactors.not_strong_of_ratio_eq_one d.ratio_one
  have hb := (isBestOffender_iff_of_not_strong ρ hs A).mpr
    ⟨hA.1,le_antisymm hA.2 (Nat.le_of_not_gt (fun h => hs ⟨A,hA.1,h⟩))⟩
  obtain ⟨C,hC,⟨i,hi⟩,hAC⟩ := (D.isBestOffender_iff_sylowProduct hf d.ratio_one A).mp hb
  have hC' (j : Fin D.count) : C j ≤ D.factor j := SolvableFFFactors.IsSylowChoice.le D (hC j)
  have hcard : Nat.card (C i)=2 := by
    rcases hC i with hc | ⟨S,hS⟩
    · exact (hi hc).elim
    · rw [hS]
      exact D.factorSylow_card i S
  have hCiA : C i ≤ A := hAC ▸ le_iSup C i
  let : IsElementaryAbelian 2 (C i) :=
    IsElementaryAbelian.of_injective (inclusion hCiA) (inclusion_injective hCiA)
  let P := (C i).subgroupOf (D.factor i)
  let : IsElementaryAbelian 2 P := IsElementaryAbelian.subgroupOf (hC' i)
  have hPne : P≠⊥ := by
    intro h
    apply hi
    rw [←map_subgroupOf_eq_of_le (hC' i)]
    change P.map (D.factor i).subtype=⊥
    rw [h,Subgroup.map_bot]
  obtain ⟨eS⟩ := SLTwoPermThree.sl2Two_equiv_perm_three
  obtain ⟨L₀,_,_,_,_,_,_,hnL,hcom,hgen⟩ :=
    Theory.SpecificGroups.SymmetricThree.CubicSelection.exists_selection_of_equiv
      ((D.factorModel i).trans eS) P P hPne le_rfl
  apply D.active_factor_selection (T : Subgroup G) A hAT C hC' hAC i hcard L₀ hnL hcom hgen
  · intro j
    obtain ⟨t,htt⟩ := ht i j
    exact ⟨t,t.property,htt⟩
  · exact hYS

omit [FiniteDimensional (ZMod 2) V] in
/-- The actual small natural actor is solvable because its two-residual is
an elementary cubic group and its residual quotient is a two-group. -/
theorem SmallNaturalWreathAction.solvable {ρ : Representation (ZMod 2) G V}
    (h : SmallNaturalWreathAction ρ) : Group.IsSolvable G := by
  let : IsElementaryAbelian 3 (pResidual 2 G) := h.residual_elementary
  let : Group.IsSolvable (pResidual 2 G) := Group.isSolvable_of_comm (fun x y => mul_comm' x y)
  let : Group.IsNilpotent (G ⧸ pResidual 2 G) := (isPGroup_quotient_pResidual 2).isNilpotent
  exact (Group.isSolvable_iff_subgroup_quotient (pResidual 2 G)).mpr ⟨inferInstance,inferInstance⟩

/-- Both the single and paired small natural branches supply the seven exact
model premises for the source lift, on the same original offender. -/
theorem small_natural_offender_cubic_selection
    (ρ : Representation (ZMod 2) G V) (T : Sylow 2 G)
    (hP : IsMinimalParabolicOver T ⊤) (hsmall : SmallNaturalWreathAction ρ)
    (hcore : pCore 2 G=⊥) (hf : Function.Injective ρ)
    (A : Subgroup G) (hAT : A ≤ (T : Subgroup G)) (hA : IsOffender ρ A) :
    ∃ R L : Subgroup G, R ≤ (T : Subgroup G) ∧ A ≤ normalizer (R : Set G) ∧
      L ≤ normalizer (R : Set G) ∧ A ≤ normalizer (L : Set G) ∧
      R.relIndex A=2 ∧ L=⁅L,A⁆ ∧ L ⊔ (T : Subgroup G)=⊤ :=
  solvable_minimalParabolic_offender_cubic_selection ρ T hP hsmall.solvable hcore hf A hAT hA
/-- The complete solvable small-branch geometry on the literal original chief
image and the same original subgroup A. -/
theorem chief_small_natural_image_geometry
    (ρ : Representation (ZMod 2) G V) [IsIrreducible ρ]
    (S : Sylow 2 G) (hS : IsMinimalParabolicOver S ⊤)
    (A : Subgroup G) (hAS : A ≤ (S : Subgroup G))
    (hA : IsOffender (imageRepresentation ρ) (actionSubgroup ρ A))
    (hsmall : SmallNaturalWreathAction (imageRepresentation ρ)) :
    ∃ R L : Subgroup (actionImage ρ),
      R ≤ (S : Subgroup G).map (actionHom ρ) ∧
      A.map (actionHom ρ) ≤ normalizer (R : Set (actionImage ρ)) ∧
      L ≤ normalizer (R : Set (actionImage ρ)) ∧
      A.map (actionHom ρ) ≤ normalizer (L : Set (actionImage ρ)) ∧
      R.relIndex (A.map (actionHom ρ))=2 ∧
      L=⁅L,A.map (actionHom ρ)⁆ ∧ L ⊔ (S : Subgroup G).map (actionHom ρ)=⊤ := by
  let q := actionHom ρ
  have hq : Function.Surjective q := ρ.asGroupHom.rangeRestrict_surjective
  have hc := irreducible_image_twoCore_eq_bot ρ
  have hn : q.ker ≠ ⊤ := by
    intro he
    obtain ⟨a,ha⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hA.1.1
    obtain ⟨g,hg⟩ := hq (a : actionImage ρ)
    apply ha
    apply Subtype.ext
    change (a : actionImage ρ)=1
    rw [←hg]
    exact (show g∈q.ker from he ▸ mem_top g)
  exact small_natural_offender_cubic_selection (imageRepresentation ρ) (S.mapSurjective hq)
    (minimalParabolic_reduced_image S hS q hq hc hn).2 hsmall hc
    (imageRepresentation_injective ρ) (actionSubgroup ρ A) (map_mono hAS) hA

end CFSG.Quasithin.ChapterB
