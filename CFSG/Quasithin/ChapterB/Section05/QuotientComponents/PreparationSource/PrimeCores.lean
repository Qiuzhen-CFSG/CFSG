/-!
# The prime-core branch of B.5.5

If an odd prime core X is noncentral, offender generation supplies an original
best offender A moving it. Coprime action gives Y = [X,A] = [Y,A]. Work inside
H = YA, where Y is normal. Its two-core is exactly C_A(Y), and the P × Q
fixed-space argument identifies this two-core with the kernel on its fixed
space W. The actual W-action image therefore has trivial two-core, contains
an injective image of the nontrivial Y, and retains the original best offender.

The proved solvable B.1.8 theorem identifies the offender-generated subgroup
of this image with a product of actual SL₂(2) factors. The image of Y lies in
that subgroup because Y = [Y,A]. Its prime consequently divides six, and
oddness forces p = 3. This uses neither the false arbitrary-stable-family
clause of B.1.8(5) nor any component or classification input.

The final application to the unchanged B.5.3 hypothesis supplies both the
prime-core centrality and the generalized Fitting identity in B.5.5(2).
No SQTK, nontrivial-group or nonzero-module premise is needed for centrality.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
B.5.5(2), printed p.104; B.1.5(1) and B.1.8, printed pp.69–70.
-/

public section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
open CFSG.Quasithin.ChapterB
namespace CFSG.Quasithin.ChapterB.PreparationSource.PrimeCores
variable {G : Type*} [Group G]

/-- Normal subgroups of distinct prime-power orders commute. -/
private theorem core_centralizes {p : ℕ} [Fact p.Prime] (hp : p ≠ 2)
    (Y : Subgroup G) [Y.Normal] (hY : IsPGroup p Y) :
    pCore 2 G ≤ centralizer (Y : Set G) := by
  apply commutator_eq_bot_iff_le_centralizer.mp
  exact commutator_eq_bot_of_disjoint
    (IsPGroup.disjoint_of_ne 2 p (Ne.symm hp) _ _ pCore_isPGroup hY)

/-- In an odd prime-group extension of an elementary two-group, the two-core
is the centralizer of the odd subgroup in the given complement. -/
private theorem core_eq_centralizer {p : ℕ} [Fact p.Prime] (hp : p ≠ 2)
    (Y A : Subgroup G) [Y.Normal] (hY : IsPGroup p Y)
    (hA : IsElementaryAbelian 2 A) (hgen : Y ⊔ A = ⊤) :
    pCore 2 G = A ⊓ centralizer (Y : Set G) := by
  let := hA
  have ha : IsPGroup 2 A := IsElementaryAbelian.isPGroup 2 A
  have hc := core_centralizes hp Y hY
  have hd : Disjoint Y (pCore 2 G ⊔ A) :=
    IsPGroup.disjoint_of_ne p 2 hp _ _ hY
      (pCore_isPGroup.to_sup_of_normal_left ha)
  apply le_antisymm
  · refine le_inf ?_ hc
    intro q hq
    have hqt : q ∈ Y ⊔ A := hgen.symm ▸ mem_top q
    obtain ⟨y,hy,a,ha',hya⟩ := mem_sup_of_normal_left.mp hqt
    have hy' : y ∈ pCore 2 G ⊔ A := by
      have he : y = q * a⁻¹ := by rw [← hya]; group
      rw [he]
      exact mul_mem (mem_sup_left hq) (inv_mem (mem_sup_right ha'))
    have hy1 : y = 1 := (Subgroup.disjoint_def.mp hd) hy hy'
    have hqa : a = q := by simpa only [hy1,one_mul] using hya
    exact hqa ▸ ha'
  · let B := A ⊓ centralizer (Y : Set G)
    have hcenter : B ≤ center G := by
      apply centralizer_eq_top_iff_subset.mp
      apply top_unique
      rw [← hgen]
      exact sup_le (le_centralizer_iff.mp inf_le_right)
        (le_centralizer_iff.mp (inf_le_left.trans
          (le_centralizer_iff_isMulCommutative.mpr inferInstance)))
    let : B.Normal := ⟨fun b hb g => by
      have he := mem_center_iff.mp (hcenter hb) g
      simpa only [he,mul_inv_cancel_right] using hb⟩
    exact le_sSup ⟨inferInstance,ha.to_le (show B ≤ A from inf_le_left)⟩

variable [Finite G]

/-- The original odd-core commutator is generated by its own commutators
with the same offender. -/
private theorem commutator_idempotent {p : ℕ} [Fact p.Prime] (hp : p ≠ 2)
    (X A : Subgroup G) [X.Normal] (hX : IsPGroup p X)
    (hA : IsPGroup 2 A) : ⁅⁅X,A⁆,A⁆ = ⁅X,A⁆ := by
  have hc := IsPGroup.coprime_card_of_ne 2 p (Ne.symm hp) A X hA hX
  have h := commutator_closure_coprime_idempotent X (A : Set G)
    (by rw [closure_eq]; exact le_normalizer_of_normal)
    (fun a ha => hc.of_dvd_left (A.orderOf_dvd_natCard ha))
  simpa only [closure_eq] using h
end CFSG.Quasithin.ChapterB.PreparationSource.PrimeCores
namespace CFSG.Quasithin.ChapterB.PreparationSource.PrimeCores
variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] (ρ : Representation (ZMod 2) G V)

/-- The concrete B.1.8 factors force a nontrivial odd prime subgroup generated
by its offender commutators to have prime three. -/
private theorem solvable_prime_eq_three (hsolv : Group.IsSolvable G)
    (hcore : pCore 2 G = ⊥) (hf : Function.Injective ρ)
    {p : ℕ} [Fact p.Prime] (hp : p ≠ 2)
    (Y A : Subgroup G) (hY : IsPGroup p Y) (hne : Y ≠ ⊥)
    (hcomm : ⁅Y,A⁆ = Y) (hA : IsBestOffender ρ A) : p = 3 := by
  obtain ⟨d⟩ := solvableFFStructure_nonempty ρ hsolv hcore hf
    ((isFFModule_iff_exists_bestOffender ρ).mpr ⟨A,hA⟩)
  let J := offenderSubgroup ρ
  let : J.Normal := offenderSubgroup_normal ρ
  have hAJ : A ≤ J := le_iSup_of_le A (le_iSup_of_le ⟨hA,le_top⟩ le_rfl)
  have hYJ : Y ≤ J := by
    rw [← hcomm]
    exact (commutator_mono le_rfl hAJ).trans (commutator_le_right _ _)
  obtain ⟨eSL⟩ := SLTwoPermThree.sl2Two_equiv_perm_three
  let e : J ≃* (Fin d.count → Equiv.Perm (Fin 3)) :=
    d.groupProduct.symm.trans (MulEquiv.piCongrRight fun i => (d.factorModel i).trans eSL)
  have hc : Nat.card J = 6 ^ d.count := by
    rw [Nat.card_congr e.toEquiv, Nat.card_fun]
    simp [Nat.card_eq_fintype_card, Fintype.card_perm, Nat.factorial]
  have hd : p ∣ Nat.card Y := by
    rcases hY.card_eq_or_dvd with he | hd
    · exact (hne ((card_eq_one).mp he)).elim
    · exact hd
  have hd6 : p ∣ 6 := (Fact.out : p.Prime).dvd_of_dvd_pow
    (hc ▸ hd.trans (card_dvd_of_le hYJ))
  have he : p ∣ 2 ∨ p ∣ 3 := (Fact.out : p.Prime).dvd_mul.mp hd6
  rcases he with he | he
  · exact (hp ((Nat.prime_dvd_prime_iff_eq (Fact.out : p.Prime) Nat.prime_two).mp he)).elim
  · exact (Nat.prime_dvd_prime_iff_eq (Fact.out : p.Prime) Nat.prime_three).mp he
end CFSG.Quasithin.ChapterB.PreparationSource.PrimeCores
namespace CFSG.Quasithin.ChapterB.PreparationSource.PrimeCores
variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V] (ρ : Representation (ZMod 2) G V)

/-- The literal fixed-space action of H = YA: its kernel is O₂(H), Y injects,
the A-kernel is C_A(Y), and the original offender survives as a best offender. -/
theorem generated_fixedSpace (hf : Function.Injective ρ)
    {p : ℕ} [Fact p.Prime] (hp : p ≠ 2)
    (Y A : Subgroup G) [Y.Normal] (hY : IsPGroup p Y) (hne : Y ≠ ⊥)
    (hcomm : ⁅Y,A⁆ = Y) (hgen : Y ⊔ A = ⊤) (hA : IsBestOffender ρ A) :
    let W := fixedSpace ρ (pCore 2 G)
    let f := invariantActionHom ρ W (fixedSpace_stable_of_normal ρ (pCore 2 G))
    f.ker = pCore 2 G ∧ Function.Injective (f.comp Y.subtype) ∧
      subspaceKernel ρ W A = A ⊓ centralizer (Y : Set G) ∧
      pCore 2 (subspaceActionImage ρ W) = ⊥ ∧
      IsBestOffender (subspaceImageRepresentation ρ W) (restrictedSubgroup ρ W A) := by
  let W := fixedSpace ρ (pCore 2 G)
  let hW := fixedSpace_stable_of_normal ρ (pCore 2 G)
  let f := invariantActionHom ρ W hW
  have hquot : IsPGroup 2 (G ⧸ Y) :=
    quotient_isPGroup_of_sup_eq_top A Y (by let := hA.1.2; exact IsElementaryAbelian.isPGroup 2 A)
      (sup_comm Y A ▸ hgen)
  have hkW := fixedSpace_kernel_eq_twoCore_of_centralizes ρ hf Y hquot
    (core_centralizes hp Y hY)
  have hk : f.ker = pCore 2 G := (invariantActionHom_ker ρ W hW).trans hkW
  have hdis : Disjoint Y (pCore 2 G) :=
    IsPGroup.disjoint_of_ne p 2 hp _ _ hY pCore_isPGroup
  have hfi : Function.Injective (f.comp Y.subtype) := by
    apply (MonoidHom.ker_eq_bot_iff _).mp
    apply bot_unique
    intro y hy
    apply Subtype.ext
    exact (Subgroup.disjoint_def.mp hdis) y.property (hk ▸ hy)
  have hKA : subspaceKernel ρ W A = A ⊓ centralizer (Y : Set G) := by
    have hc := core_eq_centralizer hp Y A hY hA.1.2 hgen
    apply le_antisymm
    · rintro a ⟨ha, hw⟩
      have hq : a ∈ pCore 2 G := hkW ▸ (show a ∈ subspaceKernel ρ W ⊤ from ⟨mem_top _,hw⟩)
      exact hc ▸ hq
    · intro a ha
      have hq : a ∈ pCore 2 G := hc.symm ▸ ha
      exact ⟨ha.1,fun w hw => hw ⟨a,hq⟩⟩
  have hm : ¬ W ≤ fixedSpace ρ A := by
    intro hw
    have hac : A ≤ centralizer (Y : Set G) := by
      intro a ha
      exact (hKA ▸ (show a ∈ subspaceKernel ρ W A from
        ⟨ha,fun w h => hw h ⟨a,ha⟩⟩)).2
    apply hne
    rw [← hcomm,commutator_comm]
    exact commutator_eq_bot_iff_le_centralizer.mpr hac
  exact ⟨hk,hfi,hKA,irreducibleReduction_image_core_eq_bot f
    (invariantActionHom_surjective ρ W hW) hk,
    hA.restricted ρ W (le_top.trans hW) hm⟩

/-- Apply B.1.8 to the actual faithful fixed-space image, retaining the
nontrivial odd subgroup through its injective action. -/
private theorem generated_prime_eq_three (hf : Function.Injective ρ)
    {p : ℕ} [Fact p.Prime] (hp : p ≠ 2)
    (Y A : Subgroup G) [Y.Normal] (hY : IsPGroup p Y) (hne : Y ≠ ⊥)
    (hcomm : ⁅Y,A⁆ = Y) (hgen : Y ⊔ A = ⊤) (hA : IsBestOffender ρ A) : p = 3 := by
  let W := fixedSpace ρ (pCore 2 G)
  let hW := fixedSpace_stable_of_normal ρ (pCore 2 G)
  let f := invariantActionHom ρ W hW
  have hfSurj := invariantActionHom_surjective ρ W hW
  let : Finite (subspaceActionImage ρ W) := Finite.of_surjective f hfSurj
  obtain ⟨_,hfY,_,h2,hbest⟩ := generated_fixedSpace ρ hf hp Y A hY hne hcomm hgen hA
  let : Group.IsNilpotent Y := hY.isNilpotent
  let := hA.1.2
  let : Group.IsNilpotent A := (IsElementaryAbelian.isPGroup 2 A).isNilpotent
  let : Group.IsSolvable G := Group.isSolvable_of_normal_sup_eq_top Y A hgen
  have hsolv : Group.IsSolvable (subspaceActionImage ρ W) :=
    Group.isSolvable_of_surjective hfSurj
  have hne' : Y.map f ≠ ⊥ := by
    intro he
    apply hne
    apply Y.eq_bot_iff_forall.mpr
    intro y hy
    apply congrArg Subtype.val (hfY (a₁ := ⟨y,hy⟩) (a₂ := 1) ?_)
    have hm := mem_map_of_mem f hy
    rw [he,mem_bot] at hm
    simpa only [MonoidHom.comp_apply,coe_subtype,OneMemClass.coe_one,map_one] using hm
  have hc : ⁅Y.map f,restrictedSubgroup ρ W A⁆ = Y.map f := by
    rw [← invariantActionHom_map ρ W hW A, ← map_commutator,hcomm]
  exact solvable_prime_eq_three (subspaceImageRepresentation ρ W) hsolv h2
    (subspaceImageRepresentation_injective ρ W) hp (Y.map f)
    (restrictedSubgroup ρ W A) (hY.map f) hne' hc hbest
end CFSG.Quasithin.ChapterB.PreparationSource.PrimeCores
namespace CFSG.Quasithin.ChapterB.PreparationSource
variable {D V : Type*} [Group D] [Finite D] [AddCommGroup V] [Module (ZMod 2) V]
    (ρ : Representation (ZMod 2) D V)

/-- The independent B.5.5(2) centrality theorem, using only the faithful binary
action, trivial two-core and generation by best offenders. -/
theorem primeCore_central [FiniteDimensional (ZMod 2) V]
    (hf : Function.Injective ρ) (h2 : pCore 2 D = ⊥)
    (hgen : offenderSubgroup ρ = ⊤) :
    ∀ p : ℕ, p.Prime → p ≠ 3 → pCore p D ≤ center D := by
  intro p hp hp3
  let : Fact p.Prime := ⟨hp⟩
  by_cases hp2 : p = 2
  · simpa only [hp2,h2] using (bot_le : (⊥ : Subgroup D) ≤ center D)
  by_contra hn
  obtain ⟨A,hA,hm⟩ := exists_moving_offender ρ hgen (pCore p D) hn
  let Y := ⁅pCore p D,A⁆
  have hY : IsPGroup p Y := pCore_isPGroup.to_le (commutator_le_left _ _)
  have hYA : ⁅Y,A⁆ = Y := PrimeCores.commutator_idempotent hp2 (pCore p D) A
    pCore_isPGroup (by let := hA.1.2; exact IsElementaryAbelian.isPGroup 2 A)
  let H := Y ⊔ A
  let Y₀ := Y.subgroupOf H
  let A₀ := A.subgroupOf H
  let τ := ρ.comp H.subtype
  let : Y₀.Normal := irreducibleReduction_normal Y A hYA
  have hY₀ : IsPGroup p Y₀ := hY.comap_subtype
  have hne : Y₀ ≠ ⊥ := by
    intro he
    apply hm
    have hh := congrArg (fun B : Subgroup H => B.map H.subtype) he
    simpa only [Y₀, map_subgroupOf_eq_of_le (show Y ≤ H from le_sup_left),Subgroup.map_bot] using hh
  have hc : ⁅Y₀,A₀⁆ = Y₀ := by
    apply Subgroup.map_injective H.subtype_injective
    rw [map_commutator]
    change ⁅(Y.subgroupOf H).map H.subtype,(A.subgroupOf H).map H.subtype⁆ =
      (Y.subgroupOf H).map H.subtype
    rw [map_subgroupOf_eq_of_le (show Y ≤ H from le_sup_left),
      map_subgroupOf_eq_of_le (show A ≤ H from le_sup_right),hYA]
  have hg : Y₀ ⊔ A₀ = ⊤ := by
    rw [← Subgroup.subgroupOf_sup (show Y ≤ H from le_sup_left)
      (show A ≤ H from le_sup_right),Subgroup.subgroupOf_self]
  exact hp3 (PrimeCores.generated_prime_eq_three τ (hf.comp H.subtype_injective)
    hp2 Y₀ A₀ hY₀ hne hc hg (hA.subgroupOf ρ (show A ≤ H from le_sup_right)))

/-- Both exact B.5.5(2) fields for the unchanged source B.5.3 hypothesis. -/
theorem source_lemma_B_5_5_2 {K : GroupClass} (hyp : SourceInduction.FFHypothesis K ρ) :
    (∀ p : ℕ, p.Prime → p ≠ 3 → pCore p D ≤ center D) ∧
      generalizedFitting D = (componentLayer D ⊔ pCore 3 D) ⊔ center D := by
  let := hyp.finite_module
  have hc := primeCore_central ρ hyp.faithful hyp.twoCore hyp.generated
  exact ⟨hc,fitting_of_primeCore_central hc⟩
end CFSG.Quasithin.ChapterB.PreparationSource
