module
public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.Complete
public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.SourceInduction.Product
public import CFSG.Quasithin.ChapterB.Section01.ComponentNormalization.Source
public import Theory.Representation.BinaryOffender.GeneratedCore

/-!
# Complete B.5 on the original normal offender subgroup

The subgroup generated by all best offenders is normal. Its characteristic
two-core maps into the ambient two-core, so an ambient trivial two-core is
inherited. Restricting the representation preserves faithfulness and gives
actual offender generation; the SQTK cover is pulled back along the original
quotient map. The unconditional adequate B.5 theorem therefore classifies
this literal action without a model or decomposition input.

Every component generated by its commutators with a best offender lies in
this subgroup. B.1.5(4) makes that component normal in the restricted actor.
Source: Aschbacher–Smith B.1.5(4), B.5.3–6 and13.7.15, pp.69,103–110,943.
-/

public section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
namespace CFSG.Quasithin.ChapterB.SourceInduction
universe u v
variable {G : Type u} [Group G] [Finite G]
  {V : Type v} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

omit [Finite G] [FiniteDimensional (ZMod 2) V] in
/-- The original normal offender subgroup inherits the trivial two-core. -/
theorem offenderSubgroup_twoCore (hcore : pCore 2 G = ⊥) :
    pCore 2 (offenderSubgroup ρ) = ⊥ := by
  let N := offenderSubgroup ρ
  let : N.Normal := offenderSubgroup_normal ρ
  have hle : (pCore 2 N).map N.subtype ≤ pCore 2 G :=
    le_sSup ⟨inferInstance, pCore_isPGroup.map N.subtype⟩
  rw [hcore] at hle
  exact (map_eq_bot_iff_of_injective _ N.subtype_injective).mp (bot_unique hle)

/-- Restricting to the original best-offender subgroup constructs every
B.5 hypothesis, including the actual pulled-back SQTK cover. -/
theorem offenderSubgroup_hypothesis {κ : GroupClass.{u}}
    (hfaith : Function.Injective ρ) (hcore : pCore 2 G = ⊥)
    (c : SQTKQuotient κ G) : FFHypothesis κ (ρ.comp (offenderSubgroup ρ).subtype) where
  finite_module := inferInstance
  faithful := hfaith.comp (offenderSubgroup ρ).subtype_injective
  twoCore := offenderSubgroup_twoCore ρ hcore
  generated := offenderSubgroup_restrict_eq_top ρ
  quotient := ⟨c.subgroup (offenderSubgroup ρ)⟩

/-- Complete B.5 applies to the literal action of the normal offender subgroup. -/
theorem offenderSubgroup_adequateAlternative
    (hfaith : Function.Injective ρ) (hcore : pCore 2 G = ⊥)
    (c : SQTKQuotient KnownSimple.IsKnownSimple G) :
    AdequateAlternative (ρ.comp (offenderSubgroup ρ).subtype) :=
  adequateAlternative_knownSimple _ (offenderSubgroup_hypothesis ρ hfaith hcore c)

/-- A component generated by its commutators with a best offender lies in
the normal offender subgroup and is an ordinary normal component there. -/
theorem moved_component_in_offenderSubgroup
    (hfaith : Function.Injective ρ) {K B : Subgroup G}
    (hK : IsComponent G K) (hB : IsBestOffender ρ B) (hcomm : ⁅K,B⁆ = K) :
    K ≤ offenderSubgroup ρ ∧
      (K.subgroupOf (offenderSubgroup ρ)).Normal ∧
      IsComponent (offenderSubgroup ρ) (K.subgroupOf (offenderSubgroup ρ)) := by
  let N := offenderSubgroup ρ
  let : N.Normal := offenderSubgroup_normal ρ
  have hKN : K ≤ N := by
    rw [← hcomm]
    exact (commutator_mono le_rfl (hB.le_offenderSubgroup ρ)).trans (commutator_le_right K N)
  have hn : (K.subgroupOf N).Normal :=
    normal_subgroupOf_of_le_normalizer (ChapterB.offenderSubgroup_le_normalizer_component ρ hfaith hK)
  let : IsQuasisimple K := hK.2
  have hq : IsQuasisimple (K.subgroupOf N) :=
    IsQuasisimple.of_mulEquiv (subgroupOfEquivOfLe hKN).symm
  exact ⟨hKN,hn,hn.isSubnormal,hq⟩

end CFSG.Quasithin.ChapterB.SourceInduction
