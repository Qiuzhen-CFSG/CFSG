module

public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.SourceInduction.ComponentReduction.PreliminaryActions.Preparation.FixedCore
public import Theory.GroupTheory.PCoreSurjective
public import Theory.GroupTheory.PResidual.NormalSubgroup
public import Theory.Representation.BinaryOffender.Stability

/-!
# The structure of the literal seed quotient

Faithfulness embeds the local kernel in LA/L, making it a two-group. Since
O₂(LA) fixes the seed, the quotient has trivial two-core. The original L is
isomorphic to its literal image L⁺. The quasisimple two-quotient theorem now
gives F*(LA/C_LA(U))=L⁺. Finally [L⁺,A⁺]=L⁺ and normality of the subgroup
generated by all best offenders prove generation of the entire quotient.

This proves the intrinsic group requirements of the B.5.1 hypothesis used
in B.5.9, without assuming its Fitting or generation conclusions.
Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
B.5.5, printed pp.104–105, and B.5.9, printed p.107.
-/

@[expose] public section

set_option backward.isDefEq.respectTransparency false

open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
namespace CFSG.Quasithin.ChapterB.SourceInduction.ComponentReduction.PreliminaryActions.Preparation
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

noncomputable def seedComponentEquiv {A L : Subgroup G} (hLA : ⁅L,A⁆ = L)
    (hf : Function.Injective (seedComponentAction ρ hLA)) : L ≃* seedComponentImage ρ hLA := by
  let f := (seedQuotientMap ρ hLA).subgroupMap (L.subgroupOf (L ⊔ A))
  have hi : Function.Injective f := by
    intro x y h
    apply Subtype.ext
    apply Subtype.ext
    have he := congrArg (fun q : seedComponentImage ρ hLA =>
      seedQuotientAction ρ hLA (q : SeedQuotient ρ hLA)) h
    have hxy : (⟨x.val,x.property⟩ : L) = ⟨y.val,y.property⟩ := hf he
    exact congrArg (fun l : L => (l : G)) hxy
  exact (subgroupOfEquivOfLe (show L ≤ L ⊔ A from le_sup_left)).symm.trans
    (MulEquiv.ofBijective f ⟨hi, (seedQuotientMap ρ hLA).subgroupMap_surjective _⟩)

theorem seedComponentImage_normal {A L : Subgroup G} (hLA : ⁅L,A⁆ = L) :
    (seedComponentImage ρ hLA).Normal := by
  let : (L.subgroupOf (L ⊔ A)).Normal :=
    (normal_subgroupOf_iff_le_normalizer le_sup_left).mpr
      (sup_le L.le_normalizer (le_normalizer_iff_commutator_le_left.mpr hLA.le))
  exact Subgroup.Normal.map inferInstance (seedQuotientMap ρ hLA)
    (QuotientGroup.mk'_surjective _)

theorem seed_images_generate {A L : Subgroup G} (hLA : ⁅L,A⁆ = L) :
    seedComponentImage ρ hLA ⊔ seedOffenderImage ρ hLA = ⊤ := by
  rw [seedComponentImage,seedOffenderImage, ← Subgroup.map_sup,
    ← Subgroup.subgroupOf_sup le_sup_left le_sup_right,Subgroup.subgroupOf_self,
    ← MonoidHom.range_eq_map]
  exact MonoidHom.range_eq_top.mpr (QuotientGroup.mk'_surjective _)

theorem seed_commutator {A L : Subgroup G} (hLA : ⁅L,A⁆ = L) :
    ⁅seedComponentImage ρ hLA, seedOffenderImage ρ hLA⁆ = seedComponentImage ρ hLA := by
  have hc : ⁅L.subgroupOf (L ⊔ A), A.subgroupOf (L ⊔ A)⁆ = L.subgroupOf (L ⊔ A) := by
    apply Subgroup.map_injective (L ⊔ A).subtype_injective
    rw [map_commutator, map_subgroupOf_eq_of_le le_sup_left,
      map_subgroupOf_eq_of_le le_sup_right,hLA]
  rw [seedComponentImage,seedOffenderImage, ← map_commutator,hc]

/-- Killing the fixed two-core kills precisely a two-group kernel, since
that kernel embeds in LA/L once L is faithful. Hence the seed quotient has
trivial two-core; no assertion that prime rank descends is used. -/
theorem seedQuotient_twoCore [Finite G] {A L : Subgroup G}
    (hLA : ⁅L,A⁆ = L) (hf : Function.Injective (seedComponentAction ρ hLA))
    (hA : IsPGroup 2 A) : pCore 2 (SeedQuotient ρ hLA) = ⊥ := by
  let H := L ⊔ A
  let L₀ := L.subgroupOf H
  let τ := (seedSubrepresentation ρ hLA).toRepresentation
  let q := seedQuotientMap ρ hLA
  let : L₀.Normal := (normal_subgroupOf_iff_le_normalizer le_sup_left).mpr
    (sup_le L.le_normalizer (le_normalizer_iff_commutator_le_left.mpr hLA.le))
  have hquot : IsPGroup 2 (H ⧸ L₀) := by
    apply isPGroup_quotient_of_sup_eq_top L₀ (A.subgroupOf H) hA.comap_subtype
    rw [← Subgroup.subgroupOf_sup le_sup_left le_sup_right,Subgroup.subgroupOf_self]
  let f := (QuotientGroup.mk' L₀).comp τ.ker.subtype
  have hi : Function.Injective f := by
    apply (MonoidHom.ker_eq_bot_iff f).mp
    apply (Subgroup.eq_bot_iff_forall _).mpr
    intro x hx
    have hxL : (x : H) ∈ L₀ := (QuotientGroup.eq_one_iff _).mp hx
    have he : (⟨x.val,hxL⟩ : L) = 1 := by
      apply hf
      change τ x.val = τ 1
      simpa only [map_one] using MonoidHom.mem_ker.mp x.property
    apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun l : L => (l : G)) he
  have hp : IsPGroup 2 τ.ker := hquot.of_injective f hi
  have hpk : IsPGroup 2 q.ker := by
    change IsPGroup 2 (QuotientGroup.mk' τ.ker).ker
    rw [QuotientGroup.ker_mk']
    exact hp
  have hcore : pCore 2 H ≤ τ.ker := by
    intro x hx
    apply LinearMap.ext
    intro u
    apply Subtype.ext
    exact (seed_le_fixedCore ρ L A u.property)
      ⟨x, Subgroup.mem_map_of_mem H.subtype hx⟩
  have he := q.comap_pCore_of_ker_isPGroup (QuotientGroup.mk'_surjective _) hpk
  apply Subgroup.comap_injective (QuotientGroup.mk'_surjective τ.ker)
  apply le_antisymm
  · change (pCore 2 (SeedQuotient ρ hLA)).comap q ≤ (⊥ : Subgroup _).comap q
    rw [he]
    change pCore 2 H ≤ (QuotientGroup.mk' τ.ker).ker
    rw [QuotientGroup.ker_mk']
    exact hcore
  · exact Subgroup.comap_mono bot_le

theorem seedQuotient_generated {A L : Subgroup G} (hLA : ⁅L,A⁆ = L)
    (hA : IsBestOffender (seedQuotientAction ρ hLA) (seedOffenderImage ρ hLA)) :
    offenderSubgroup (seedQuotientAction ρ hLA) = ⊤ := by
  let J := offenderSubgroup (seedQuotientAction ρ hLA)
  let : J.Normal := offenderSubgroup_normal _
  have hAJ : seedOffenderImage ρ hLA ≤ J :=
    le_iSup_of_le _ (le_iSup_of_le ⟨hA,le_top⟩ le_rfl)
  have hLJ : seedComponentImage ρ hLA ≤ J := by
    rw [← seed_commutator ρ hLA]
    exact (commutator_mono le_rfl hAJ).trans (commutator_le_right _ _)
  exact top_unique ((seed_images_generate ρ hLA).symm ▸ sup_le hLJ hAJ)

/-- The local quotient has exactly L⁺ as its generalized Fitting subgroup. -/
theorem seedQuotient_fitting [Finite G] {A L : Subgroup G}
    (hLA : ⁅L,A⁆ = L) (hL : IsQuasisimple L)
    (hf : Function.Injective (seedComponentAction ρ hLA)) (hA : IsPGroup 2 A) :
    generalizedFitting (SeedQuotient ρ hLA) = seedComponentImage ρ hLA := by
  let : IsQuasisimple L := hL
  let : IsQuasisimple (seedComponentImage ρ hLA) :=
    IsQuasisimple.of_mulEquiv (seedComponentEquiv ρ hLA hf)
  let : (seedComponentImage ρ hLA).Normal := seedComponentImage_normal ρ hLA
  have hp : IsPGroup 2 (seedOffenderImage ρ hLA) :=
    hA.comap_subtype.map (seedQuotientMap ρ hLA)
  exact generalizedFitting_eq_of_quasisimple_two_quotient _
    (isPGroup_quotient_of_sup_eq_top _ _ hp (seed_images_generate ρ hLA))
    (seedQuotient_twoCore ρ hLA hf hA)

theorem seedQuotient_fitting_sup_center [Finite G] {A L : Subgroup G}
    (hLA : ⁅L,A⁆ = L) (hL : IsQuasisimple L)
    (hf : Function.Injective (seedComponentAction ρ hLA)) (hA : IsPGroup 2 A) :
    generalizedFitting (SeedQuotient ρ hLA) =
      seedComponentImage ρ hLA ⊔ center (SeedQuotient ρ hLA) := by
  have hc : center (SeedQuotient ρ hLA) ≤ generalizedFitting (SeedQuotient ρ hLA) := by
    apply le_trans _ (fitting_le_generalizedFitting _)
    have hn : Group.IsNilpotent (center (SeedQuotient ρ hLA)) := by
      refine ⟨1, ?_⟩
      rw [Subgroup.upperCentralSeries_one_eq_top_iff]
      infer_instance
    exact le_sSup ⟨inferInstance, hn⟩
  have hf := seedQuotient_fitting ρ hLA hL hf hA
  rw [hf] at hc ⊢
  exact (sup_eq_left.mpr hc).symm
end CFSG.Quasithin.ChapterB.SourceInduction.ComponentReduction.PreliminaryActions.Preparation
