module

public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.SourceInduction.Descent
public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.SourceInduction.FactorExtraction.EarlierSources
public import Theory.Representation.BinaryOffender.Stability

/-!
# The complete B.1.9 input to the B.5.8 reduction

The product maps below retain the original subgroup inclusions. The module
sum retains the inclusions of the actual moved spaces, and the offender clause
is an equality with the union of the coordinate Sylow families. In particular
this input does not assume the selected two-factor splitting used in B.5.8.

`EarlierB19` is a universal earlier-source implication, not a theorem. Its
producer is `qt-b01-fitting-structure`; final discharge belongs to
`qt-b05-general-classification`. The other permitted earlier input is
`FactorExtraction.EarlierA131One`, owned by `qt-a-01-section-rank`.

Source: Aschbacher–Smith, combined 1 March 2004 manuscript, B.1.9,
printed pp.71–72, and B.5.8, printed p.106.
-/

@[expose] public section
open Subgroup Representation Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterB.SourceInduction.FittingReduction
open QuasisimpleSource
universe u v
variable {G : Type u} [Group G] {V : Type v} [AddCommGroup V] [Module (ZMod 2) V]

/-- The source's subgroup generated by minimal best offenders. -/
def minimalGenerated (ρ : Representation (ZMod 2) G V) : Subgroup G :=
  generatedBy {A | IsMinimalBestOffender ρ A} ⊤

/-- The actual F=[F(G),J(P*)], not the entire Fitting subgroup. -/
def fittingMoved (ρ : Representation (ZMod 2) G V) : Subgroup G :=
  ⁅fittingSubgroup G, minimalGenerated ρ⁆

/-- All five conclusions of B.1.9 for the original action. -/
structure B19Conclusion (ρ : Representation (ZMod 2) G V) where
  count : ℕ
  factor : Fin count → Subgroup G
  factorModel : ∀ i, factor i ≃* Equiv.Perm (Fin 3)
  groupProduct : (((i : Fin count) → factor i) ×
    generatedBy {A | IsBestOffender ρ A}
      (centralizer (fittingMoved ρ : Set G))) ≃* offenderSubgroup ρ
  groupProduct_single : ∀ i (g : factor i),
    (groupProduct (Pi.mulSingle i g, 1) : G) = g
  groupProduct_residual : ∀ g,
    (groupProduct (1, g) : G) = g
  oddFactor : Fin count → Subgroup G
  oddFactor_eq : ∀ i, oddFactor i = (pPrimeCore 2 (factor i)).map (factor i).subtype
  oddFactorModel : ∀ i, oddFactor i ≃* Multiplicative (ZMod 3)
  oddProduct : ((i : Fin count) → oddFactor i) ≃* fittingMoved ρ
  oddProduct_single : ∀ i (g : oddFactor i), (oddProduct (Pi.mulSingle i g) : G) = g
  fittingProduct : (fittingMoved ρ ×
    ↥(fittingSubgroup G ⊓ centralizer (minimalGenerated ρ : Set G))) ≃* fittingSubgroup G
  fittingProduct_apply : ∀ f c, (fittingProduct (f,c) : G) = (f : G) * (c : G)
  moved_eq : ∀ i, moved ρ (oddFactor i) = moved ρ (factor i)
  dimension : ∀ i, Module.finrank (ZMod 2) (moved ρ (factor i)) = 2
  moduleSum : ((i : Fin count) → moved ρ (factor i)) ≃ₗ[ZMod 2] moved ρ (fittingMoved ρ)
  moduleSum_single : ∀ i (x : moved ρ (factor i)), (moduleSum (Pi.single i x) : V) = x
  noncentral_offenders : ∀ A,
    (IsMinimalBestOffender ρ A ∧ ¬ A ≤ centralizer (fittingSubgroup G : Set G)) ↔
      ∃ i, ∃ S : Sylow 2 (factor i), (S : Subgroup (factor i)).map (factor i).subtype = A
  moved_subgroup_centralizes : ∀ A, IsMinimalBestOffender ρ A →
    ∀ H : Subgroup G, H = ⁅H,A⁆ →
      H ≤ minimalGenerated ρ ⊓ centralizer (fittingSubgroup G : Set G)

/-- Exactly the universal source implication; no counterexample or
classification hypothesis occurs in its domain. -/
def EarlierB19 : Prop :=
  ∀ (G : Type u) [Group G] [Finite G]
    (V : Type v) [AddCommGroup V] [Module (ZMod 2) V] [Module.Finite (ZMod 2) V]
    (ρ : Representation (ZMod 2) G V), Function.Injective ρ → pCore 2 G = ⊥ →
      fittingMoved ρ ≠ ⊥ → Nonempty (B19Conclusion ρ)

/-- A noncentral minimal offender supplies the nontriviality hypothesis
of B.1.9 on the actual commutator subgroup. -/
theorem fittingMoved_ne_bot {ρ : Representation (ZMod 2) G V} {A : Subgroup G}
    (hA : IsMinimalBestOffender ρ A)
    (hn : ¬ A ≤ centralizer (fittingSubgroup G : Set G)) : fittingMoved ρ ≠ ⊥ := by
  intro hz
  have hA_le : A ≤ minimalGenerated ρ :=
    le_iSup_of_le A (le_iSup_of_le ⟨hA,le_top⟩ le_rfl)
  have hc : fittingSubgroup G ≤ centralizer (minimalGenerated ρ : Set G) :=
    commutator_eq_bot_iff_le_centralizer.mp hz
  exact hn (hA_le.trans (le_centralizer_iff.mp hc))

/-- The B.5.8 action satisfies every source hypothesis of B.1.9. -/
theorem FFHypothesis.b19 [Finite G] {K : GroupClass.{u}}
    {ρ : Representation (ZMod 2) G V} (hyp : FFHypothesis K ρ)
    (h19 : EarlierB19.{u,v}) {A : Subgroup G} (hA : IsMinimalBestOffender ρ A)
    (hn : ¬ A ≤ centralizer (fittingSubgroup G : Set G)) : Nonempty (B19Conclusion ρ) := by
  let : Module.Finite (ZMod 2) V := hyp.finite_module
  exact h19 G V ρ hyp.faithful hyp.twoCore (fittingMoved_ne_bot hA hn)

end CFSG.Quasithin.ChapterB.SourceInduction.FittingReduction
