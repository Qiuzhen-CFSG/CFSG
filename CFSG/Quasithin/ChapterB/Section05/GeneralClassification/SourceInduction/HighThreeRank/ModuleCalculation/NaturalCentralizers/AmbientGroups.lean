module

public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.SourceInduction.HighThreeRank.ModuleCalculation.NaturalCentralizers.MovedGeometry
public import Theory.GroupTheory.OddCyclicThreeNormalizer

/-!
# Ambient centralizers from a local symmetric supplement

Once the original three-core has order three, its odd component centralizer
centralizes it. Self-centralization of the generalized Fitting subgroup then
places that centralizer inside the three-core times the ambient center.
A local symmetric supplement and offender generation remove the central
factor: the quotient by the supplement times the three-core has odd order,
whereas it is generated by images of elementary two-subgroups. The remaining
index-two calculation identifies the centralizer of the original three-core.

The supplement and its index remain explicit here. They are supplied by the
normalizer of the actual marked natural or augmentation-core action, not by
an assumed outer configuration or a splitting of the global fixed space.
Source: Aschbacher–Smith, B.5.7, printed p.106, final paragraph.
-/

public section

open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
open CFSG.Quasithin.ChapterB.QuasisimpleSource
namespace CFSG.Quasithin.ChapterB.SourceInduction.HighThreeRank.ModuleCalculation.NaturalCentralizers
universe u v
variable {G : Type u} [Group G] [Finite G] {K : GroupClass.{u}}
variable {V : Type v} [AddCommGroup V] [Module (ZMod 2) V]
variable (ρ : Representation (ZMod 2) G V)

omit [Finite G] in
theorem disjoint_component_centralizer {L : Subgroup G}
    (eL : L ≃* alternatingGroup (Fin 6)) :
    Disjoint L (centralizer (L : Set G)) := by
  apply disjoint_def.mpr
  intro x hxL hxC
  have hz : (⟨x, hxL⟩ : L) ∈ center L := by
    apply mem_center_iff.mpr
    intro l
    exact Subtype.ext (hxC l l.property)
  have hz' := (centerCongr eL ⟨_, hz⟩).property
  change eL ⟨x, hxL⟩ ∈ center (alternatingGroup (Fin 6)) at hz'
  rw [alternatingGroup.center_eq_bot (by simp)] at hz'
  exact congrArg Subtype.val (eL.injective ((mem_bot.mp hz').trans eL.map_one.symm))

theorem centralizer_le_threeCore_sup_center {L : Subgroup G}
    (hL : IsComponent G L) (d : NoncentralContext K G L)
    (eL : L ≃* alternatingGroup (Fin 6))
    (hthree : Nat.card (pCore 3 G) = 3) :
    centralizer (L : Set G) ≤ pCore 3 G ⊔ center G := by
  let : L.Normal := d.normal
  let C := centralizer (L : Set G)
  have hXC : pCore 3 G ≤ C := le_centralizer_iff.mp (component_centralizes_threeCore hL)
  have hCX : C ≤ centralizer (pCore 3 G : Set G) :=
    le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp
      (commutator_eq_bot_of_odd_normalizes_card_three (pCore 3 G) C hthree
        (Nat.coprime_two_left.mpr d.odd_centralizer) le_normalizer_of_normal))
  have hCF : C ≤ centralizer (generalizedFitting G : Set G) := by
    apply le_centralizer_iff.mpr
    rw [d.fitting]
    exact sup_le (sup_le (le_centralizer_iff.mp le_rfl)
      (le_centralizer_iff.mp hCX)) (center_le_centralizer _)
  have hCF' := hCF.trans CFSG.Quasithin.ChapterB.QuasisimpleSections.centralizer_generalizedFitting_le
  rw [d.fitting, sup_assoc] at hCF'
  have hZC : center G ≤ C := center_le_centralizer _
  have hXC' : pCore 3 G ⊔ center G ≤ C := sup_le hXC hZC
  intro c hc
  obtain ⟨l, hl, z, hz, rfl⟩ := mem_sup_of_normal_left.mp (hCF' hc)
  have hlC : l ∈ C := by
    have hh := C.mul_mem hc (C.inv_mem (hXC' hz))
    simpa only [mul_inv_cancel_right] using hh
  have hl1 : l = 1 := disjoint_def.mp (disjoint_component_centralizer eL) hl hlC
  simpa only [hl1, one_mul] using hz

/-- Offender generation excludes any nontrivial odd-order quotient. -/
theorem normal_eq_top_of_odd_index (hyp : FFHypothesis K ρ)
    (N : Subgroup G) [N.Normal] (hodd : Odd N.index) : N = ⊤ := by
  apply top_unique
  rw [← hyp.generated]
  unfold offenderSubgroup generatedBy
  refine iSup_le fun B => iSup_le fun hB => ?_
  let := hB.1.1.2
  let q := QuotientGroup.mk' N
  have hp := (IsElementaryAbelian.isPGroup 2 B).map q
  obtain ⟨n, hn⟩ := hp.exists_card_eq
  have hcop : Nat.Coprime (Nat.card (B.map q)) (Nat.card (G ⧸ N)) := by
    rw [hn]
    exact (Nat.coprime_two_left.mpr hodd).pow_left n
  have hc : Nat.card (B.map q) = 1 := by
    apply Nat.eq_one_of_dvd_one
    rw [← hcop.gcd_eq_one]
    exact Nat.dvd_gcd (dvd_refl _) (card_subgroup_dvd_card (B.map q))
  have hm : B.map q = ⊥ := card_eq_one.mp hc
  have hk := (map_eq_bot_iff B).mp hm
  simpa only [q, QuotientGroup.ker_mk'] using hk

/-- An actual local symmetric supplement removes the remaining central factor. -/
theorem centralizers_of_symmetric_supplement (hyp : FFHypothesis K ρ)
    {L : Subgroup G} (hL : IsComponent G L) (d : NoncentralContext K G L)
    (eL : L ≃* alternatingGroup (Fin 6))
    (hthree : Nat.card (pCore 3 G) = 3)
    (H : Subgroup G)
    (hcover : H ⊔ centralizer (L : Set G) = ⊤)
    (hdisj : Disjoint H (centralizer (L : Set G)))
    (hindex : L.relIndex H = 2) :
    centralizer (L : Set G) = pCore 3 G ∧
      centralizer (pCore 3 G : Set G) = L ⊔ pCore 3 G := by
  let : L.Normal := d.normal
  let X := pCore 3 G
  let C := centralizer (L : Set G)
  let N := H ⊔ X
  have hXC : X ≤ C := le_centralizer_iff.mp (component_centralizes_threeCore hL)
  have hCXZ : C ≤ X ⊔ center G :=
    centralizer_le_threeCore_sup_center hL d eL hthree
  have hNZ : N ⊔ center G = ⊤ := by
    apply top_unique
    rw [← hcover]
    exact sup_le (le_sup_left.trans le_sup_left)
      (hCXZ.trans (sup_le (le_sup_right.trans le_sup_left) le_sup_right))
  let : N.Normal := normalizer_eq_top_iff.mp (top_unique (by
    rw [← hNZ]
    exact sup_le N.le_normalizer
      ((center_le_centralizer _).trans (Subgroup.centralizer_le_normalizer _))))
  have hNC : C ⊔ N = ⊤ := by
    apply top_unique
    rw [← hcover]
    exact sup_le (le_sup_left.trans le_sup_right) le_sup_left
  have hni : N.index = N.relIndex C := by
    rw [← relIndex_top_right, ← hNC, relIndex_sup_right]
  have hodd : Odd N.index := by
    apply Nat.coprime_two_left.mp
    rw [hni]
    exact (Nat.coprime_two_left.mpr d.odd_centralizer).of_dvd_right
      (relIndex_dvd_card N C)
  have hN := normal_eq_top_of_odd_index ρ hyp N hodd
  have hC : C = X := by
    apply le_antisymm _ hXC
    intro c hc
    have hcN : c ∈ H ⊔ X := (show c ∈ N from hN.symm ▸ mem_top c)
    obtain ⟨h, hh, x, hx, rfl⟩ := mem_sup_of_normal_right.mp hcN
    have hhC : h ∈ C := by
      simpa only [mul_inv_cancel_right] using C.mul_mem hc (C.inv_mem (hXC hx))
    have hh1 : h = 1 := disjoint_def.mp hdisj hh hhC
    simpa only [hh1, one_mul] using hx
  refine ⟨hC, ?_⟩
  let M := L ⊔ X
  let : IsCyclic X := isCyclic_of_prime_card hthree
  let : CommGroup X := IsCyclic.commGroup
  have hMX : M ≤ centralizer (X : Set G) :=
    sup_le (component_centralizes_threeCore hL) (le_centralizer X)
  have hMH : H ⊔ M = ⊤ := by
    apply top_unique
    rw [← hN]
    exact sup_le le_sup_left (le_sup_right.trans le_sup_right)
  have hmi : M.index ∣ 2 := by
    have hdiv := relIndex_dvd_of_le_left H (show L ≤ M from le_sup_left)
    rw [hindex] at hdiv
    rwa [← relIndex_sup_right H M, hMH, relIndex_top_right] at hdiv
  have hproper : centralizer (X : Set G) ≠ ⊤ := by
    exact fun he => d.noncentral (centralizer_eq_top_iff_subset.mp he)
  have hcindex : (centralizer (X : Set G)).index = 2 := by
    have hd := (index_dvd_of_le hMX).trans hmi
    exact (Nat.dvd_prime (by decide : Nat.Prime 2)).mp hd |>.resolve_left
      (fun he => hproper (index_eq_one.mp he))
  have hmindex : M.index = 2 := by
    exact (Nat.dvd_prime (by decide : Nat.Prime 2)).mp hmi |>.resolve_left
      (fun he => hproper (top_unique ((index_eq_one.mp he) ▸ hMX)))
  have hrel := relIndex_mul_index hMX
  rw [hcindex, hmindex] at hrel
  have : M.relIndex (centralizer (X : Set G)) = 1 := by omega
  exact le_antisymm (relIndex_eq_one.mp this) hMX

end CFSG.Quasithin.ChapterB.SourceInduction.HighThreeRank.ModuleCalculation.NaturalCentralizers
