module

public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.SourceInduction.HighThreeRank.ModuleCalculation.NaturalReduction.Sections

/-!
# The full six-point action on a nontrivial moved-module cover

The augmentation core and the original moved space are central covers of
the same natural A6-module. Its dual first cohomology has dimension one,
so the universal cover identifies them compatibly with their projections.
The augmentation cover is commutator-generated by the concrete binary
permutation-module structure theorem.

The resulting component intertwiner respects the full actor: for each
ambient element its failure of equivariance lies in the fixed kernel and
vanishes on all component commutators. Those commutators span the moved
space. Thus the original actor isomorphism and alternating marking survive
unchanged. Combining this with the seven-point vanishing in `Sections`
proves the complete moved-space alternative from the marked reduced action.
Constructing that reduced action from the lifted component remains separate.

Source: Aschbacher–Smith, combined 1 March 2004 manuscript, B.5.7, printed
p.106, and I.1.5–6(1), printed p.408. `compare_covers` strengthens the
comparison in `FirstCohomologyDuality/OneDimensionalCover.lean` by retaining
compatibility with both projections. The six-point generation argument is
the degree-six version of `BinaryPermutationNaturalCover.lean`'s A8 proof.
-/

@[expose] public section
open Subgroup Representation Representation.BinaryOffender Representation.OneCohomology
namespace CFSG.Quasithin.ChapterB.SourceInduction.HighThreeRank.ModuleCalculation.NaturalReduction
open QuasisimpleSource
universe u v w z

private theorem compare_covers
    {D N U W : Type*} [Group D] [Finite D]
    [AddCommGroup N] [Module (ZMod 2) N] [FiniteDimensional (ZMod 2) N]
    [AddCommGroup U] [Module (ZMod 2) U] [FiniteDimensional (ZMod 2) U]
    [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]
    {ν : Representation (ZMod 2) D N} {σ : Representation (ZMod 2) D U}
    {τ : Representation (ZMod 2) D W}
    (p : σ.IntertwiningMap ν) (hp : IsCover p)
    (q : τ.IntertwiningMap ν) (hq : IsCover q)
    (hH : Module.finrank (ZMod 2) (H1 ν.dual) = 1)
    (hU : Module.finrank (ZMod 2) U = Module.finrank (ZMod 2) N + 1)
    (hW : Module.finrank (ZMod 2) W = Module.finrank (ZMod 2) N + 1) :
    ∃ f : U ≃ₗ[ZMod 2] W,
      (∀ g v, f (σ g v) = τ g (f v)) ∧ ∀ v, q (f v) = p v := by
  let : FiniteDimensional (ZMod 2) (Module.Dual (ZMod 2) (cocycles ν.dual)) :=
    Subspace.instModuleDualFiniteDimensional
  obtain ⟨a, ha, hap⟩ := exists_universalCover_quotient p hp
  obtain ⟨b, hb, hbq⟩ := exists_universalCover_quotient q hq
  let c := universalCoverProjection ν
  have hc : Function.Surjective c := by
    intro n
    obtain ⟨v, rfl⟩ := hp.1 n
    obtain ⟨x, rfl⟩ := ha v
    exact ⟨x, (hap x).symm⟩
  have hd := c.toLinearMap.finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr hc, finrank_top,
    finrank_ker_universalCoverProjection, hH] at hd
  let A := LinearEquiv.ofBijective a.toLinearMap
    ⟨(LinearMap.injective_iff_surjective_of_finrank_eq_finrank (hU.trans hd).symm).mpr ha, ha⟩
  let B := LinearEquiv.ofBijective b.toLinearMap
    ⟨(LinearMap.injective_iff_surjective_of_finrank_eq_finrank (hW.trans hd).symm).mpr hb, hb⟩
  refine ⟨A.symm.trans B, ?_, ?_⟩
  · intro g v
    have he : A.symm (σ g v) = (universalAction ν.dual).dual g (A.symm v) := by
      apply A.injective
      change A (A.symm (σ g v)) = a ((universalAction ν.dual).dual g (A.symm v))
      rw [A.apply_symm_apply, a.isIntertwining]
      exact congrArg (σ g) (A.apply_symm_apply v).symm
    change B (A.symm (σ g v)) = τ g (B (A.symm v))
    rw [he]
    exact LinearMap.congr_fun (b.isIntertwining' g) (A.symm v)
  · intro v
    change q (b (A.symm v)) = p v
    rw [hbq, ← hap]
    exact congrArg p (A.apply_symm_apply v)

private theorem full_equivariance
    {D N U W : Type*} [Group D]
    [AddCommGroup N] [Module (ZMod 2) N]
    [AddCommGroup U] [Module (ZMod 2) U]
    [AddCommGroup W] [Module (ZMod 2) W]
    {ν : Representation (ZMod 2) D N} {σ : Representation (ZMod 2) D U}
    {τ : Representation (ZMod 2) D W}
    (L : Subgroup D) [L.Normal]
    (p : σ.IntertwiningMap ν) (q : τ.IntertwiningMap ν)
    (hfix : q.toLinearMap.ker ≤ fixedSpace τ L)
    (hgen : Coinvariants.ker (σ.comp L.subtype) = ⊤)
    (f : U ≃ₗ[ZMod 2] W)
    (hf : ∀ l : L, ∀ v, f (σ l v) = τ l (f v))
    (hcompat : ∀ v, q (f v) = p v) :
    ∀ g v, f (σ g v) = τ g (f v) := by
  intro g v
  let d : U →ₗ[ZMod 2] W := f.toLinearMap.comp (σ g) - (τ g).comp f.toLinearMap
  have hd (v : U) : d v ∈ q.toLinearMap.ker := by
    change q (f (σ g v) - τ g (f v)) = 0
    rw [map_sub, hcompat, q.isIntertwining, hcompat, p.isIntertwining, sub_self]
  have hker : Coinvariants.ker (σ.comp L.subtype) ≤ d.ker := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨l, w⟩, rfl⟩
    change d (σ l w - w) = 0
    rw [map_sub, sub_eq_zero]
    let k : L := ⟨g * l * g⁻¹,
      (inferInstance : L.Normal).conj_mem (l : D) l.property g⟩
    have hσ : σ g (σ l w) = σ k (σ g w) := by
      simp only [← Module.End.mul_apply, ← map_mul, k,
        inv_mul_cancel_right]
    have hτ : τ g (τ l (f w)) = τ k (τ g (f w)) := by
      simp only [← Module.End.mul_apply, ← map_mul, k,
        inv_mul_cancel_right]
    change f (σ g (σ l w)) - τ g (f (σ l w)) = d w
    rw [hσ, hf k, hf l, hτ, ← map_sub]
    exact hfix (hd w) k
  have hz : d v = 0 := hker (hgen ▸ Submodule.mem_top)
  exact sub_eq_zero.mp hz

private theorem six_core_generated :
    Coinvariants.ker (BinaryPermutation.alternatingCoreRepresentation (Fin 6)) = ⊤ := by
  let ρ := BinaryPermutation.alternatingCoreRepresentation (Fin 6)
  let C := Coinvariants.ker ρ
  let S := C.map (BinaryPermutation.core (Fin 6)).subtype
  have hS : ∀ g : alternatingGroup (Fin 6), ∀ v ∈ S,
      BinaryPermutation.representation (Fin 6) g.val v ∈ S := by
    intro g v hv
    obtain ⟨u, hu, rfl⟩ := hv
    refine ⟨ρ g u, ?_, rfl⟩
    change ρ g u ∈ Coinvariants.ker ρ
    have hm : Coinvariants.ker ρ ≤ (Coinvariants.ker ρ).comap (ρ g) := by
      apply Submodule.span_le.mpr
      rintro _ ⟨⟨h, w⟩, rfl⟩
      change ρ g (ρ h w - w) ∈ Coinvariants.ker ρ
      have he : ρ g (ρ h w - w) = (ρ (g * h) w - w) - (ρ g w - w) := by
        rw [map_sub, map_mul, Module.End.mul_apply]
        abel
      rw [he]
      exact (Coinvariants.ker ρ).sub_mem (Coinvariants.sub_mem_ker _ _)
        (Coinvariants.sub_mem_ker _ _)
    exact hm hu
  rcases BinaryPermutation.invariant_le_constants_or_core_le
      (by decide : 5 ≤ Fintype.card (Fin 6)) S hS with h | h
  · let g : alternatingGroup (Fin 6) := ⟨Equiv.swap 0 1 * Equiv.swap 1 2, by
      simp [Equiv.Perm.mem_alternatingGroup]⟩
    let v : BinaryPermutation.core (Fin 6) := ⟨Pi.single 0 1 + Pi.single 3 1, by
      simp [BinaryPermutation.mem_core, Finset.sum_add_distrib, CharTwo.add_self_eq_zero]⟩
    have hv : ρ g v - v ∈ C := Coinvariants.sub_mem_ker g v
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp (h ⟨ρ g v - v, hv, rfl⟩)
    have hconst : (ρ g v - v).val 0 = (ρ g v - v).val 4 :=
      (congrFun hc.symm 0).trans (congrFun hc 4)
    have hne : (ρ g v - v).val 0 ≠ (ρ g v - v).val 4 := by decide
    exact (hne hconst).elim
  · apply top_unique
    intro v _
    obtain ⟨u, hu, he⟩ := h v.property
    exact (show u = v from Subtype.ext he) ▸ hu

variable {D : Type u} [Group D] {V : Type v} [AddCommGroup V] [Module (ZMod 2) V]
variable {ρ : Representation (ZMod 2) D V} {L : Subgroup D} (s : MovedSection ρ L)

private noncomputable def sixActor
    (e : MarkedActionEquiv s.action ⊤ L
      (BinaryPermutation.naturalRepresentation (Fin 6)) (alternatingGroup (Fin 6))) :
    D ≃* Equiv.Perm (Fin 6) := Subgroup.topEquiv.symm.trans e.action.groupEquiv

private theorem sixActor_component
    (e : MarkedActionEquiv s.action ⊤ L
      (BinaryPermutation.naturalRepresentation (Fin 6)) (alternatingGroup (Fin 6))) (l : L) :
    sixActor s e l = (e.subgroupEquiv l : Equiv.Perm (Fin 6)) := e.compatible l

private noncomputable def sixCoreProjection
    (e : MarkedActionEquiv s.action ⊤ L
      (BinaryPermutation.naturalRepresentation (Fin 6)) (alternatingGroup (Fin 6))) :
    Representation.IntertwiningMap
      ((BinaryPermutation.coreRepresentation (Fin 6)).comp (sixActor s e).toMonoidHom) s.action :=
  (e.action.linearEquiv.symm.toLinearMap.comp (BinaryPermutation.coreToNatural (Fin 6)))
    |>.intertwiningMap_of_isIntertwiningMap _ _ (by
      intro g v
      apply e.action.linearEquiv.injective
      simp only [LinearMap.comp_apply, LinearEquiv.coe_coe, LinearEquiv.apply_symm_apply]
      have he := e.action.intertwines ⟨g, mem_top g⟩
        (e.action.linearEquiv.symm (BinaryPermutation.coreToNatural (Fin 6) v))
      simp only [LinearEquiv.apply_symm_apply] at he
      exact (BinaryPermutation.coreToNatural_equivariant (sixActor s e g) v).trans he.symm)

private theorem sixCoreProjection_isCover
    (e : MarkedActionEquiv s.action ⊤ L
      (BinaryPermutation.naturalRepresentation (Fin 6)) (alternatingGroup (Fin 6))) :
    IsCover ((sixCoreProjection s e).toLinearMap.intertwiningMap_of_isIntertwiningMap
      (((BinaryPermutation.coreRepresentation (Fin 6)).comp
        (sixActor s e).toMonoidHom).comp L.subtype)
      (s.action.comp L.subtype)
      (fun g v => LinearMap.congr_fun ((sixCoreProjection s e).isIntertwining' g.val) v)) := by
  refine ⟨e.action.linearEquiv.symm.surjective.comp BinaryPermutation.coreToNatural_surjective,
    ?_, ?_⟩
  · intro v hv g
    have hv' : v.val ∈ BinaryPermutation.constants (Fin 6) := by
      apply (Submodule.Quotient.mk_eq_zero _).mp
      have he : BinaryPermutation.coreToNatural (Fin 6) v = 0 :=
        e.action.linearEquiv.symm.injective (hv.trans (map_zero _).symm)
      exact congrArg Subtype.val he
    obtain ⟨c, hc⟩ := Submodule.mem_span_singleton.mp hv'
    apply Subtype.ext
    change BinaryPermutation.representation (Fin 6) (sixActor s e g) v.val = v.val
    rw [← hc, map_smul, BinaryPermutation.permute_allOne]
  · apply top_unique
    rw [← six_core_generated]
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨g, v⟩, rfl⟩
    obtain ⟨l, rfl⟩ := e.subgroupEquiv.surjective g
    have h := Coinvariants.sub_mem_ker
      (ρ := ((BinaryPermutation.coreRepresentation (Fin 6)).comp
        (sixActor s e).toMonoidHom).comp L.subtype) l v
    change BinaryPermutation.coreRepresentation (Fin 6) (sixActor s e l) v - v ∈ _ at h
    rw [sixActor_component] at h
    exact h

/-- A nontrivial six-point cover is the augmentation core under the very same actor marking. -/
theorem six_core_marking [Finite D] [FiniteDimensional (ZMod 2) V] [L.Normal]
    (hi : IsIrrPlus ρ L s.space.toSubmodule)
    (e : MarkedActionEquiv s.action ⊤ L
      (BinaryPermutation.naturalRepresentation (Fin 6)) (alternatingGroup (Fin 6)))
    (hz : s.central.toSubmodule ≠ ⊥) :
    ∃ f : MarkedActionEquiv s.space.toRepresentation ⊤ L
      (BinaryPermutation.coreRepresentation (Fin 6)) (alternatingGroup (Fin 6)),
      f.action.groupEquiv = e.action.groupEquiv ∧ f.subgroupEquiv = e.subgroupEquiv := by
  let τ : Representation (ZMod 2) D (BinaryPermutation.core (Fin 6)) :=
    (BinaryPermutation.coreRepresentation (Fin 6)).comp (sixActor s e).toMonoidHom
  let p : s.space.toRepresentation.IntertwiningMap s.action :=
    s.central.toSubmodule.mkQ.intertwiningMap_of_isIntertwiningMap _ _ (fun _ _ => rfl)
  let q := sixCoreProjection s e
  let qL : Representation.IntertwiningMap (τ.comp L.subtype) (s.action.comp L.subtype) :=
    q.toLinearMap.intertwiningMap_of_isIntertwiningMap _ _
      (fun g v => LinearMap.congr_fun (q.isIntertwining' g.val) v)
  have hp := componentProjection_isCover s hi
  have hq : IsCover qL := sixCoreProjection_isCover s e
  have hH : Module.finrank (ZMod 2) (H1 (Representation.dual (s.action.comp L.subtype))) = 1 :=
    (marked_dual_H1_finrank s (by decide) e).trans
      BinaryPermutation.alternatingSix_natural_finrank_H1
  have hdQ : Module.finrank (ZMod 2) (s.space.toSubmodule ⧸ s.central.toSubmodule) = 4 := by
    rw [e.action.linearEquiv.finrank_eq,
      BinaryPermutation.finrank_natural_even (Fin 6) (by decide)]
    rfl
  obtain ⟨f, hf, hcompat⟩ := compare_covers (componentProjection s) hp qL hq hH
    (by rw [(six_central_finrank s hi e hz).2, hdQ])
    (by rw [BinaryPermutation.finrank_core, hdQ]; rfl)
  have hfull := full_equivariance L p q hq.2.1 hp.2.2 f hf hcompat
  refine ⟨{
    action := {
      groupEquiv := e.action.groupEquiv
      linearEquiv := f
      intertwines g v := hfull g.val v }
    contained := e.contained
    subgroupEquiv := e.subgroupEquiv
    compatible := e.compatible }, rfl, rfl⟩

/-- The full moved-space alternatives follow from the marked reduced action.
The nonzero central line is retained in the augmentation-core branch. -/
theorem moved_action_of_reduced [Finite D] [FiniteDimensional (ZMod 2) V] [L.Normal]
    (hi : IsIrrPlus ρ L s.space.toSubmodule) (hr : ReducedSymmetricAction s) :
    SymmetricMovedAction ρ L s := by
  by_cases hz : s.central.toSubmodule = ⊥
  · exact moved_action_of_central_eq_bot s hr hz
  obtain ⟨n, hn, ⟨e⟩⟩ := hr
  rcases hn with rfl | rfl
  · obtain ⟨f, _, _⟩ := six_core_marking s hi e hz
    exact .coreSix f
  · exact (hz (seven_central_eq_bot s hi e)).elim

end CFSG.Quasithin.ChapterB.SourceInduction.HighThreeRank.ModuleCalculation.NaturalReduction
