module

public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.SourceInduction.ExceptionalExtension.NonsplitCase.Inputs
public import CFSG.Quasithin.ChapterB.Section05.Quasisimple.SourceImplication.ExtensionConsequences.Homogeneity
public import Theory.Representation.GeneralLinearNatural

/-!
# Cohomology of the lower four-dimensional binary natural extension

Assume the literal earlier B.4.8(4) dimension theorem. If a four-dimensional
binary module is generated by its commutators and its quotient by fixed vectors
is the natural SL₃(2)-module, then its first cohomology vanishes.

A nonprincipal cocycle would give a faithful five-dimensional action on
`U × ZMod 2`. Every proper invariant subspace of `U` is fixed: irreducibility
of its fixed quotient gives a supplement, and full commutator generation
removes the fixed summand. This makes the cocycle extension indecomposable;
a fixed vector outside `U × {0}` would make the cocycle principal. The literal
three-step chief flag has dimensions 0, 1, 4, 5. Its middle section is the given
natural quotient and its two outer sections are central. Thus B.4.8(4) gives
the contradiction that dimension five is three or four.

This is the lower four-space, whose whole space is moved. The earlier source
implication remains the authorized explicit parameter; no upper four-space,
FF, splitting, or additional constituent premise is used.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
manuscript (1 March 2004), B.4.8(4), printed p.91; its application in the
nonsplit B.5.6 endgame, printed p.110.
-/

public section
noncomputable section

open Subgroup Representation Representation.BinaryOffender
open CFSG.Quasithin.ChapterB.QuasisimpleSource
open CFSG.Quasithin.ChapterB.QuasisimpleSource.ExtensionConsequences
open Representation.OneCohomology
namespace CFSG.Quasithin.ChapterB.SourceInduction.ExceptionalExtension.Nonsplit
namespace LowerCohomology
universe u v
variable {D : Type u} [Group D] {U : Type v} [AddCommGroup U] [Module (ZMod 2) U]
  (σ : Representation (ZMod 2) D U) (z : cocycles σ)

private def extension : Representation (ZMod 2) D (U × ZMod 2) where
  toFun g :=
    { toFun := fun w => (σ g w.1 + w.2 • z.val g, w.2)
      map_add' := by
        intro x y
        apply Prod.ext
        · dsimp
          rw [map_add, add_smul]
          abel
        · rfl
      map_smul' := by
        intro a w
        apply Prod.ext
        · dsimp
          rw [map_smul, smul_add, smul_smul]
        · rfl }
  map_one' := by
    have hz : z.val 1 = 0 := by
      have h := z.property 1 1
      simpa using h
    apply LinearMap.ext
    intro w
    apply Prod.ext
    · change σ 1 w.1 + w.2 • z.val 1 = w.1
      simp [hz]
    · rfl
  map_mul' g h := by
    apply LinearMap.ext
    intro w
    apply Prod.ext
    · change σ (g * h) w.1 + w.2 • z.val (g * h) =
        σ g (σ h w.1 + w.2 • z.val h) + w.2 • z.val g
      rw [z.property, map_mul, Module.End.mul_apply, map_add, map_smul, smul_add]
      abel
    · rfl

private def base : Subrepresentation (extension σ z) where
  toSubmodule := (LinearMap.snd (ZMod 2) U (ZMod 2)).ker
  apply_mem_toSubmodule _ := fun {_w} hw => hw

private def line : Subrepresentation (extension σ z) where
  toSubmodule := σ.invariants.prod ⊥
  apply_mem_toSubmodule g := by
    rintro ⟨u, a⟩ ⟨hu, ha⟩
    have ha0 : a = 0 := ha
    subst a
    change (σ g u + (0 : ZMod 2) • z.val g) ∈ σ.invariants ∧ (0 : ZMod 2) ∈ (⊥ : Submodule (ZMod 2) (ZMod 2))
    rw [zero_smul, add_zero, hu g]
    exact ⟨hu, Submodule.zero_mem _⟩

private lemma line_le_base : line σ z ≤ base σ z := fun _ h => h.2

private def baseEquiv : (base σ z).toSubmodule ≃ₗ[ZMod 2] U where
  toFun w := w.val.1
  invFun u := ⟨(u, 0), rfl⟩
  left_inv w := by
    apply Subtype.ext
    change (w.val.1, 0) = w.val
    exact Prod.ext rfl w.property.symm
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

private def lineEquiv : (line σ z).toSubmodule ≃ₗ[ZMod 2] σ.invariants where
  toFun w := ⟨w.val.1, w.property.1⟩
  invFun u := ⟨(u.val, 0), u.property, by simp⟩
  left_inv w := by
    apply Subtype.ext
    change (w.val.1, 0) = w.val
    exact Prod.ext rfl w.property.2.symm
  right_inv _ := rfl
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

private def naturalSectionEquiv :
    ((base σ z).toSubmodule ⧸
      (sectionLower (extension σ z) (line σ z) (base σ z)).toSubmodule) ≃ₗ[ZMod 2]
      (U ⧸ σ.invariants) :=
  Submodule.Quotient.equiv _ _ (baseEquiv σ z) (by
    ext u
    constructor
    · rintro ⟨w, hw, rfl⟩
      exact hw.1
    · intro hu
      exact ⟨⟨(u, 0), rfl⟩, ⟨hu, by simp⟩, rfl⟩)

private lemma naturalSectionEquiv_intertwines (g : D) (w) :
    naturalSectionEquiv σ z
      (sectionRepresentation (extension σ z) (line σ z) (base σ z) g w) =
      reducedAction σ g (naturalSectionEquiv σ z w) := by
  induction w using Submodule.Quotient.induction_on with
  | _ w =>
    change σ.invariants.mkQ (σ g w.val.1 + w.val.2 • z.val g) =
      σ.invariants.mkQ (σ g w.val.1)
    have hw : w.val.2 = 0 := w.property
    rw [hw, zero_smul, add_zero]

private lemma naturalSection_natural
    (hn : IsLinearNatural (reducedAction σ) BinaryField.two 3) :
    IsLinearNatural (sectionRepresentation (extension σ z) (line σ z) (base σ z))
      BinaryField.two 3 := by
  obtain ⟨e⟩ := hn
  refine ⟨⟨e.groupEquiv, (naturalSectionEquiv σ z).trans e.linearEquiv, ?_⟩⟩
  intro g w
  exact (congrArg e.linearEquiv (naturalSectionEquiv_intertwines σ z g w)).trans
    (e.intertwines g _)

private lemma extension_faithful
    (hn : IsLinearNatural (reducedAction σ) BinaryField.two 3) :
    Function.Injective (extension σ z) := by
  obtain ⟨e⟩ := hn
  intro g h he
  apply e.groupEquiv.injective
  apply specialLinearNatural_injective 3
  apply LinearMap.ext
  intro w
  obtain ⟨q, rfl⟩ := e.linearEquiv.surjective w
  obtain ⟨u, rfl⟩ := σ.invariants.mkQ_surjective q
  have hu := congrArg (fun f : Module.End (ZMod 2) (U × ZMod 2) => (f (u, 0)).1) he
  change σ g u + (0 : ZMod 2) • z.val g = σ h u + (0 : ZMod 2) • z.val h at hu
  simp only [zero_smul, add_zero] at hu
  change linearNatural BinaryField.two 3 (e.groupEquiv g) _ =
    linearNatural BinaryField.two 3 (e.groupEquiv h) _
  have hq : reducedAction σ g ((QuasisimpleSource.fixed σ).toSubmodule.mkQ u) =
      reducedAction σ h ((QuasisimpleSource.fixed σ).toSubmodule.mkQ u) :=
    congrArg σ.invariants.mkQ hu
  exact (e.intertwines g _).symm.trans
    ((congrArg e.linearEquiv hq).trans (e.intertwines h _))

private lemma subrepresentation_dichotomy
    (hfull : moved σ ⊤ = ⊤)
    (hn : IsLinearNatural (reducedAction σ) BinaryField.two 3)
    (A : Subrepresentation σ) : A ≤ QuasisimpleSource.fixed σ ∨ A = ⊤ := by
  obtain ⟨e⟩ := hn
  let : IsIrreducible (reducedAction σ) :=
    irreducible_of_equiv e (linearNatural_irreducible _ (by decide))
  rcases Subrepresentation.le_or_sup_eq_top_of_irreducible_quotient (QuasisimpleSource.fixed σ) A with h | h
  · exact Or.inl h
  right
  apply Subrepresentation.toSubmodule_injective
  apply top_unique
  rw [← hfull]
  apply subspaceCommutator_le_of_le_sup_fixedSpace σ
  · apply le_subspaceStabilizer
    intro g _ u hu
    exact A.apply_mem_toSubmodule g hu
  · have hf : fixedSpace σ ⊤ = σ.invariants := by
      ext u
      exact ⟨fun hu g => hu ⟨g, by trivial⟩, fun hu g => hu g⟩
    rw [hf, sup_comm]
    exact h.ge

private lemma fixed_extension_mem_base
    (hz : ¬ ∃ u, principal σ u = z)
    {w : U × ZMod 2} (hw : ∀ g, extension σ z g w = w) :
    w ∈ base σ z := by
  by_contra h
  have hw2 : w.2 = 1 := by
    have hd : w.2 = 0 ∨ w.2 = 1 := by
      have hh : ∀ a : ZMod 2, a = 0 ∨ a = 1 := by decide
      exact hh w.2
    exact hd.resolve_left h
  apply hz
  refine ⟨-w.1, ?_⟩
  apply Subtype.ext
  funext g
  have he := congrArg Prod.fst (hw g)
  change σ g w.1 + w.2 • z.val g = w.1 at he
  rw [hw2, one_smul] at he
  change σ g (-w.1) - (-w.1) = z.val g
  rw [map_neg]
  calc
    -σ g w.1 - -w.1 = w.1 - σ g w.1 := by abel
    _ = z.val g := sub_eq_iff_eq_add.mpr (he.symm.trans (add_comm _ _))

private def basePart (A : Subrepresentation (extension σ z)) : Subrepresentation σ where
  toSubmodule := A.toSubmodule.comap (LinearMap.inl (ZMod 2) U (ZMod 2))
  apply_mem_toSubmodule g := by
    intro u hu
    have h := A.apply_mem_toSubmodule g hu
    change (σ g u + (0 : ZMod 2) • z.val g, 0) ∈ A at h
    change (σ g u, 0) ∈ A
    simpa only [zero_smul, add_zero] using h

private lemma base_le_of_basePart_top (A : Subrepresentation (extension σ z))
    (hA : basePart σ z A = ⊤) : base σ z ≤ A := by
  intro w hw
  have h : w.2 = 0 := hw
  have hu : w.1 ∈ basePart σ z A := by rw [hA]; trivial
  change (w.1, 0) ∈ A at hu
  simpa only [← h] using hu

private lemma fixed_dim [FiniteDimensional (ZMod 2) U]
    (hdim : Module.finrank (ZMod 2) U = 4)
    (hn : IsLinearNatural (reducedAction σ) BinaryField.two 3) :
    Module.finrank (ZMod 2) σ.invariants = 1 := by
  obtain ⟨e⟩ := hn
  have hd : Module.finrank (ZMod 2) (U ⧸ σ.invariants) = 3 :=
    e.linearEquiv.finrank_eq.trans (by
      change Module.finrank (ZMod 2) (Fin 3 → ZMod 2) = 3
      exact Module.finrank_fin_fun (ZMod 2))
  have hr := σ.invariants.finrank_quotient_add_finrank
  omega

private lemma complement_eq_bot
    (hz : ¬ ∃ u, principal σ u = z)
    (A B : Subrepresentation (extension σ z))
    (hAB : IsCompl A.toSubmodule B.toSubmodule) (hA : base σ z ≤ A) : B = ⊥ := by
  apply Subrepresentation.toSubmodule_injective
  apply bot_unique
  intro b hb
  have hfix (g : D) : extension σ z g b = b := by
    apply sub_eq_zero.mp
    have hdB := B.toSubmodule.sub_mem (B.apply_mem_toSubmodule g hb) hb
    have hdU : extension σ z g b - b ∈ base σ z := by
      change b.2 - b.2 = 0
      exact sub_self _
    have hd := show extension σ z g b - b ∈ A.toSubmodule ⊓ B.toSubmodule from
      ⟨hA hdU, hdB⟩
    rw [hAB.disjoint.eq_bot] at hd
    exact hd
  have hu := fixed_extension_mem_base σ z hz hfix
  have hm : b ∈ A.toSubmodule ⊓ B.toSubmodule := ⟨hA hu, hb⟩
  rwa [hAB.disjoint.eq_bot] at hm

private lemma extension_indecomposable [FiniteDimensional (ZMod 2) U]
    (hdim : Module.finrank (ZMod 2) U = 4)
    (hfull : moved σ ⊤ = ⊤)
    (hn : IsLinearNatural (reducedAction σ) BinaryField.two 3)
    (hz : ¬ ∃ u, principal σ u = z) : IsIndecomposable (extension σ z) := by
  refine ⟨inferInstance, ?_⟩
  intro A B hAB
  rcases subrepresentation_dichotomy σ hfull hn (basePart σ z A) with ha | ha
  swap
  · exact Or.inr (complement_eq_bot σ z hz A B hAB (base_le_of_basePart_top σ z A ha))
  rcases subrepresentation_dichotomy σ hfull hn (basePart σ z B) with hb | hb
  swap
  · exact Or.inl (complement_eq_bot σ z hz B A hAB.symm (base_le_of_basePart_top σ z B hb))
  exfalso
  have hc : moved σ ⊤ ≤ σ.invariants := by
    apply Submodule.span_le.mpr
    rintro _ ⟨g, _, u, _, rfl⟩
    have hu : (u, (0 : ZMod 2)) ∈ A.toSubmodule ⊔ B.toSubmodule := by
      rw [hAB.sup_eq_top]
      trivial
    obtain ⟨a, hAa, b, hBb, hab⟩ := Submodule.mem_sup.mp hu
    have hda : (extension σ z g a - a).1 ∈ σ.invariants := by
      apply ha
      change ((extension σ z g a - a).1, 0) ∈ A
      have hh := A.toSubmodule.sub_mem (A.apply_mem_toSubmodule g hAa) hAa
      have hzero : (extension σ z g a - a).2 = 0 := sub_self _
      exact (show ((extension σ z g a - a).1, 0) = extension σ z g a - a from
        Prod.ext rfl hzero.symm).symm ▸ hh
    have hdb : (extension σ z g b - b).1 ∈ σ.invariants := by
      apply hb
      change ((extension σ z g b - b).1, 0) ∈ B
      have hh := B.toSubmodule.sub_mem (B.apply_mem_toSubmodule g hBb) hBb
      have hzero : (extension σ z g b - b).2 = 0 := sub_self _
      exact (show ((extension σ z g b - b).1, 0) = extension σ z g b - b from
        Prod.ext rfl hzero.symm).symm ▸ hh
    have he : σ g u - u = (extension σ z g a - a).1 + (extension σ z g b - b).1 := by
      have hm := congrArg (fun w => (extension σ z g w - w).1) hab
      rw [map_add] at hm
      change (σ g a.1 + a.2 • z.val g + (σ g b.1 + b.2 • z.val g)) -
          (a.1 + b.1) = σ g u + (0 : ZMod 2) • z.val g - u at hm
      simp only [zero_smul, add_zero] at hm
      change σ g u - u = (σ g a.1 + a.2 • z.val g - a.1) +
        (σ g b.1 + b.2 • z.val g - b.1)
      rw [← hm]
      abel
    rw [he]
    exact σ.invariants.add_mem hda hdb
  rw [hfull] at hc
  have he := Submodule.finrank_mono hc
  rw [finrank_top, hdim, fixed_dim σ hdim hn] at he
  omega

private lemma cover_of_finrank_succ [FiniteDimensional (ZMod 2) U]
    {A B : Subrepresentation σ} (hAB : A ≤ B)
    (hd : Module.finrank (ZMod 2) B.toSubmodule =
      Module.finrank (ZMod 2) A.toSubmodule + 1) : A ⋖ B := by
  have hlt : A < B := lt_of_le_of_ne hAB (by
    intro he
    have he' := congrArg (fun X : Subrepresentation σ => Module.finrank (ZMod 2) X.toSubmodule) he
    omega)
  refine ⟨hlt, ?_⟩
  intro C hAC hCB
  have h1 := Submodule.finrank_lt_finrank_of_lt (show A.toSubmodule < C.toSubmodule from hAC)
  have h2 := Submodule.finrank_lt_finrank_of_lt (show C.toSubmodule < B.toSubmodule from hCB)
  omega

private lemma middle_cover [FiniteDimensional (ZMod 2) U]
    (hdim : Module.finrank (ZMod 2) U = 4)
    (hfull : moved σ ⊤ = ⊤)
    (hn : IsLinearNatural (reducedAction σ) BinaryField.two 3) :
    line σ z ⋖ base σ z := by
  have hld : Module.finrank (ZMod 2) (line σ z).toSubmodule = 1 :=
    (lineEquiv σ z).finrank_eq.trans (fixed_dim σ hdim hn)
  have hbd : Module.finrank (ZMod 2) (base σ z).toSubmodule = 4 :=
    (baseEquiv σ z).finrank_eq.trans hdim
  refine ⟨lt_of_le_of_ne (line_le_base σ z) (by
    intro he
    have he' := congrArg (fun X : Subrepresentation (extension σ z) =>
      Module.finrank (ZMod 2) X.toSubmodule) he
    omega), ?_⟩
  intro A hCA hAU
  rcases subrepresentation_dichotomy σ hfull hn (basePart σ z A) with ha | ha
  · apply not_le_of_gt hCA
    intro w hw
    have hw0 : w.2 = 0 := hAU.le hw
    refine ⟨?_, hw0⟩
    apply ha
    change (w.1, 0) ∈ A
    simpa only [← hw0] using hw
  · exact (not_le_of_gt hAU) (base_le_of_basePart_top σ z A ha)

private lemma chief_flag [FiniteDimensional (ZMod 2) U]
    (hdim : Module.finrank (ZMod 2) U = 4)
    (hfull : moved σ ⊤ = ⊤)
    (hn : IsLinearNatural (reducedAction σ) BinaryField.two 3) :
    UniqueNoncentralNaturalFactor (extension σ z) := by
  let c : ℕ → Subrepresentation (extension σ z)
    | 0 => ⊥
    | 1 => line σ z
    | 2 => base σ z
    | _ + 3 => ⊤
  have hc : Monotone c := monotone_nat_of_le_succ (by
    intro j
    rcases j with _ | (_ | (_ | j))
    · exact bot_le
    · exact line_le_base σ z
    · exact le_top
    · exact le_rfl)
  refine ⟨3, c, 1, hc, rfl, rfl, ?_, by decide, naturalSection_natural σ z hn, ?_⟩
  · intro j hj
    interval_cases j
    · apply cover_of_finrank_succ (extension σ z) bot_le
      change Module.finrank (ZMod 2) (line σ z).toSubmodule =
        Module.finrank (ZMod 2) (⊥ : Submodule (ZMod 2) (U × ZMod 2)) + 1
      simpa only [finrank_bot, zero_add] using
        (lineEquiv σ z).finrank_eq.trans (fixed_dim σ hdim hn)
    · exact middle_cover σ z hdim hfull hn
    · apply cover_of_finrank_succ (extension σ z) le_top
      change Module.finrank (ZMod 2) (⊤ : Submodule (ZMod 2) (U × ZMod 2)) =
        Module.finrank (ZMod 2) (base σ z).toSubmodule + 1
      rw [finrank_top, Module.finrank_prod, (baseEquiv σ z).finrank_eq]
      simp
  · intro j hj hji g
    interval_cases j
    · apply (sectionRepresentation_trivial_iff _ _ _ g).mpr
      rintro ⟨u, a⟩ ⟨hu, ha⟩
      change extension σ z g (u, a) - (u, a) = 0
      have ha0 : a = 0 := ha
      subst a
      change (σ g u + (0 : ZMod 2) • z.val g, 0) - (u, 0) = 0
      rw [zero_smul, add_zero, hu g, sub_self]
    · exact (hji rfl).elim
    · apply (sectionRepresentation_trivial_iff _ _ _ g).mpr
      intro w _
      change w.2 - w.2 = 0
      exact sub_self _

end LowerCohomology

universe u v
variable {D : Type u} [Group D] {U : Type v} [AddCommGroup U] [Module (ZMod 2) U]
  (σ : Representation (ZMod 2) D U)

/-- The lower four-dimensional binary natural extension has vanishing H¹,
conditionally on the literal earlier B.4.8(4) dimension theorem. -/
theorem lower_four_H1 [Finite D] [FiniteDimensional (ZMod 2) U]
    (h48 : EarlierB48Four.{u,v})
    (hdim : Module.finrank (ZMod 2) U = 4)
    (hfull : moved σ ⊤ = ⊤)
    (hn : IsLinearNatural (reducedAction σ) BinaryField.two 3) :
    Subsingleton (H1 σ) := by
  apply Submodule.Quotient.subsingleton_iff.mpr
  apply top_unique
  intro z _
  change ∃ u, principal σ u = z
  by_contra hz
  have hi := LowerCohomology.extension_indecomposable σ z hdim hfull hn hz
  have hf := LowerCohomology.extension_faithful σ z hn
  have hc := LowerCohomology.chief_flag σ z hdim hfull hn
  obtain ⟨e⟩ := hn
  have hd := h48 D (U × ZMod 2) (LowerCohomology.extension σ z) hf hi ⟨e.groupEquiv⟩ hc
  have h5 : Module.finrank (ZMod 2) (U × ZMod 2) = 5 := by
    rw [Module.finrank_prod, hdim]
    simp
  omega

end CFSG.Quasithin.ChapterB.SourceInduction.ExceptionalExtension.Nonsplit
