variable {D U Q : Type*} [Group D] [AddCommGroup U] [Module (ZMod 2) U]
  [AddCommGroup Q] [Module (ZMod 2) Q]
  {σ : Representation (ZMod 2) D U} {τ : Representation (ZMod 2) D Q}

private theorem central_kernel_H1 [Group.IsPerfect D]
    (p : σ.IntertwiningMap τ) (hs : Function.Surjective p)
    (hc : p.toLinearMap.ker ≤ σ.invariants) [Subsingleton (H1 τ)] :
    Subsingleton (H1 σ) := by
  apply Submodule.Quotient.subsingleton_iff.mpr
  apply top_unique
  intro f _
  let cf : cocycles τ := ⟨fun g => p (f.val g), fun g h => by
    change p (f.val (g*h)) = τ g (p (f.val h)) + p (f.val g)
    rw [f.property, map_add, p.isIntertwining]⟩
  obtain ⟨q, hq⟩ := (classMap_eq_zero_iff τ cf).mp (Subsingleton.elim _ _)
  obtain ⟨u, rfl⟩ := hs q
  let d := f - principal σ u
  have hd (g : D) : d.val g ∈ σ.invariants := by
    apply hc
    have he := congrArg (fun c : cocycles τ => c.val g) hq
    change τ g (p u) - p u = p (f.val g) at he
    change p (f.val g - (σ g u - u)) = 0
    rw [map_sub, map_sub, p.isIntertwining, he, sub_self]
  let h : D →* Multiplicative U :=
    { toFun := fun g => Multiplicative.ofAdd (d.val g)
      map_one' := by
        change d.val 1 = 0
        have he := d.property 1 1
        simpa using he
      map_mul' := fun g t => by
        change d.val (g*t) = d.val g + d.val t
        rw [d.property, hd t g, add_comm] }
  let : Group.IsPerfect h.range := Group.IsPerfect.range h
  have hz (g : D) : d.val g = 0 := by
    have he : (⟨h g, g, rfl⟩ : h.range) = 1 := Subsingleton.elim _ _
    exact congrArg (fun x : h.range => Multiplicative.toAdd x.val) he
  refine ⟨u, ?_⟩
  apply Subtype.ext
  funext g
  exact (sub_eq_zero.mp (hz g)).symm

private theorem range_H1 (i : σ.IntertwiningMap τ) (hi : Function.Injective i)
    [Subsingleton (H1 σ)] : Subsingleton (H1 i.range.toRepresentation) := by
  let l : U ≃ₗ[ZMod 2] i.range.toSubmodule := LinearEquiv.ofInjective i.toLinearMap hi
  have hl (g : D) (v : U) : l (σ g v) = i.range.toRepresentation g (l v) :=
    Subtype.ext (i.isIntertwining σ τ g v)
  exact (H1Congr σ i.range.toRepresentation (MulEquiv.refl D) l hl).symm.injective.subsingleton

private theorem range_fixed_supplement (i : σ.IntertwiningMap τ)
    (hi : Function.Injective i) (ht : HasTrivialQuotient i.range)
    [Subsingleton (H1 σ)] (v : Q) :
    ∃ u : U, ∃ z : Q, z ∈ τ.invariants ∧ i u + z = v := by
  let := range_H1 i hi
  have hv := (extensionClass_eq_zero_iff i.range ht v).mp (Subsingleton.elim _ _)
  obtain ⟨_, ⟨u,rfl⟩, z, hz, he⟩ := Submodule.mem_sup.mp hv
  exact ⟨u,z,hz,he⟩

private theorem central_kernel_disjoint
    (p : σ.IntertwiningMap τ) (hs : Function.Surjective p)
    (hc : p.toLinearMap.ker ≤ σ.invariants) [Subsingleton (H1 τ.dual)] :
    Disjoint (Coinvariants.ker σ) p.toLinearMap.ker := by
  let i : τ.dual.IntertwiningMap σ.dual := dualIntertwining p
  have ht : HasTrivialQuotient i.range := by
    intro g f
    change σ.dual g f - f ∈ p.toLinearMap.dualMap.range
    rw [LinearMap.range_dualMap_eq_dualAnnihilator_ker, Submodule.mem_dualAnnihilator]
    intro w hw
    change f (σ g⁻¹ w) - f w = 0
    rw [(hc hw) g⁻¹, sub_self]
  rw [Submodule.disjoint_def]
  intro x hx hk
  apply (Module.forall_dual_apply_eq_zero_iff (ZMod 2) x).mp
  intro f
  obtain ⟨b,z,hz,rfl⟩ := range_fixed_supplement (σ := τ.dual) (τ := σ.dual) i
    (LinearMap.dualMap_injective_of_surjective (f := p.toLinearMap) hs) ht f
  have hz' : z ∈ (Coinvariants.ker σ).dualAnnihilator := by
    rw [← σ.invariants_dual_eq_commutator_annihilator]
    exact hz
  change b (p x) + z x = 0
  have hzx : z x = 0 := by
    rw [Submodule.mem_dualAnnihilator] at hz'
    exact hz' x hx
  rw [show p x = 0 from hk, map_zero, hzx, add_zero]

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
  {ρ : Representation (ZMod 2) D V}

private theorem central_section_isCompl [Group.IsPerfect D]
    (U : Subrepresentation ρ) (ht : HasTrivialQuotient U)
    (p : U.toRepresentation.IntertwiningMap τ) (hs : Function.Surjective p)
    (hc : p.toLinearMap.ker ≤ U.toRepresentation.invariants)
    (hf : τ.invariants = ⊥) (hgen : Coinvariants.ker τ = ⊤)
    [Subsingleton (H1 τ)] [Subsingleton (H1 τ.dual)] :
    IsCompl (Coinvariants.ker ρ) ρ.invariants := by
  let := central_kernel_H1 p hs hc
  have hv (v : V) : v ∈ U.toSubmodule ⊔ ρ.invariants :=
    (extensionClass_eq_zero_iff U ht v).mp (Subsingleton.elim _ _)
  have hm : Coinvariants.ker ρ = (Coinvariants.ker U.toRepresentation).map U.toSubmodule.subtype := by
    apply le_antisymm
    · apply Submodule.span_le.mpr
      rintro _ ⟨⟨g,v⟩,rfl⟩
      obtain ⟨u,hu,z,hz,rfl⟩ := Submodule.mem_sup.mp (hv v)
      refine ⟨U.toRepresentation g ⟨u,hu⟩ - ⟨u,hu⟩, Coinvariants.sub_mem_ker g _, ?_⟩
      change ρ g u - u = ρ g (u+z) - (u+z)
      rw [map_add, hz g]
      abel
    · apply Submodule.map_le_iff_le_comap.mpr
      apply Submodule.span_le.mpr
      rintro _ ⟨⟨g,v⟩,rfl⟩
      exact Coinvariants.sub_mem_ker g (v : V)
  refine ⟨?_, codisjoint_iff.mpr (top_unique ?_)⟩
  · rw [Submodule.disjoint_def]
    intro v hvm hvf
    rw [hm] at hvm
    obtain ⟨u,hum,rfl⟩ := hvm
    have huf : u ∈ U.toRepresentation.invariants := fun g => Subtype.ext (hvf g)
    have hpu : p u ∈ τ.invariants := by
      intro g
      rw [← p.isIntertwining, huf g]
    rw [hf] at hpu
    exact congrArg Subtype.val (Submodule.disjoint_def.mp
      (central_kernel_disjoint p hs hc) u hum hpu)
  · intro v _
    have hsurj : (Coinvariants.ker U.toRepresentation).map p.toLinearMap = ⊤ := by
      apply top_unique
      rw [← hgen]
      apply Submodule.span_le.mpr
      rintro _ ⟨⟨g,q⟩,rfl⟩
      obtain ⟨u,rfl⟩ := hs q
      exact ⟨U.toRepresentation g u - u, Coinvariants.sub_mem_ker g u,
        by
          change p (U.toRepresentation g u - u) = τ g (p u) - p u
          rw [map_sub, p.isIntertwining]⟩
    obtain ⟨u,hu,z,hz,rfl⟩ := Submodule.mem_sup.mp (hv v)
    have hpu : p ⟨u,hu⟩ ∈ (Coinvariants.ker U.toRepresentation).map p.toLinearMap := by
      rw [hsurj]; trivial
    obtain ⟨m,hm',he⟩ := hpu
    have hdiff : (⟨u,hu⟩ : U.toSubmodule) - m ∈ U.toRepresentation.invariants := by
      apply hc
      change p (⟨u,hu⟩ - m) = 0
      change p m = p ⟨u,hu⟩ at he
      rw [map_sub, he, sub_self]
    refine Submodule.mem_sup.mpr ⟨m, ?_, (u-m)+z, ?_, by abel⟩
    · rw [hm]
      exact ⟨m,hm',rfl⟩
    · intro g
      rw [map_add, hz g]
      exact congrArg (fun x : V => x+z) (congrArg Subtype.val (hdiff g))

end CFSG.Quasithin.ChapterB.SourceInduction.ExceptionalExtension.Nonsplit.SymmetricFive

open Subgroup Representation Representation.BinaryOffender Representation.OneCohomology
open CFSG.Quasithin.ChapterB.QuasisimpleSource
open CFSG.Quasithin.ChapterB.QuasisimpleSource.ExtensionConsequences
open Theory.GroupTheory
namespace CFSG.Quasithin.ChapterB.SourceInduction.ExceptionalExtension.Nonsplit.SymmetricFive
private abbrev natural := BinaryPermutation.alternatingNaturalRepresentation (Fin 5)
private theorem natural_faithful : Function.Injective natural := by
  intro g h he
  apply Subtype.ext
  apply BinaryPermutation.naturalMulAction_injective_of_odd (Fin 5) (by decide)
  apply MulEquiv.ext
  intro v
  exact congrArg Multiplicative.ofAdd (LinearMap.congr_fun he v.toAdd)
private theorem natural_fixed : natural.invariants = ⊥ := by
  let := BinaryPermutation.alternatingNatural_isIrreducible (Ω := Fin 5) (by decide)
  have he : natural.invariants = Representation.invariants
      (natural.comp (⊤ : Subgroup (alternatingGroup (Fin 5))).subtype) := by
    ext v
    exact ⟨fun h g => h g.val, fun h g => h ⟨g,Subgroup.mem_top g⟩⟩
  by_contra hn
  rw [he] at hn
  have hk := le_ker_of_normal_invariants_ne_bot natural ⊤ hn
  rw [(MonoidHom.ker_eq_bot_iff natural).mpr natural_faithful] at hk
  exact top_ne_bot (le_bot_iff.mp hk)
private noncomputable def naturalDual : ActionEquiv natural natural.dual :=
  ⟨MulEquiv.refl _,BinaryPermutation.naturalDualEquiv (Fin 5),
    fun g v => BinaryPermutation.naturalDualEquiv_equivariant (Fin 5) g.val v⟩
private theorem natural_H1 : Subsingleton (H1 natural) :=
  Module.finrank_zero_iff.mp BinaryPermutation.alternatingFive_natural_finrank_H1
private theorem natural_dual_H1 : Subsingleton (H1 natural.dual) := by
  let := natural_H1
  exact (actionSymm naturalDual).H1_subsingleton
private theorem natural_generated : Coinvariants.ker natural = ⊤ := by
  apply (fixed_dual_eq_bot_iff natural).mp
  apply bot_unique
  intro v hv
  obtain ⟨w,rfl⟩ := naturalDual.linearEquiv.surjective v
  have hw : w ∈ natural.invariants := by
    intro g
    apply naturalDual.linearEquiv.injective
    rw [naturalDual.intertwines]
    exact hv g
  rw [natural_fixed] at hw
  change naturalDual.linearEquiv w = 0
  rw [show w = 0 from hw, map_zero]

variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  {ρ : Representation (ZMod 2) G V}
open ComponentReduction
private noncomputable def coreEquiv (c : Conclusion ρ)
    (e : second c ≃* Equiv.Perm (Fin 5)) : secondCore c ≃* alternatingGroup (Fin 5) :=
  ((Subgroup.equivMapOfInjective (generalizedFitting (second c)) (second c).subtype
    Subtype.val_injective).symm.trans (e.subgroupMap _)).trans
    (MulEquiv.subgroupCongr ((map_generalizedFitting_equiv e).trans
      Sporadic.Mathieu.M22ValueBound.SmallQuotients.symmetricFive_generalizedFitting_eq_alternating))
private theorem coreEquiv_apply (c : Conclusion ρ)
    (e : second c ≃* Equiv.Perm (Fin 5)) (g : secondCore c) :
    (coreEquiv c e g).val = e ⟨g.val,secondCore_le c g.property⟩ := by
  change e ((Subgroup.equivMapOfInjective (generalizedFitting (second c))
    (second c).subtype Subtype.val_injective).symm g).val = _
  apply congrArg e
  apply Subtype.ext
  exact congrArg (fun x : secondCore c => (x : G)) ((Subgroup.equivMapOfInjective
    (generalizedFitting (second c)) (second c).subtype
    Subtype.val_injective).apply_symm_apply g)
end CFSG.Quasithin.ChapterB.SourceInduction.ExceptionalExtension.Nonsplit.SymmetricFive

namespace CFSG.Quasithin.ChapterB.SourceInduction.ExceptionalExtension.Nonsplit
open ComponentReduction SymmetricFive
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  {ρ : Representation (ZMod 2) G V}
private def five_compAction {A B C X Y Z : Type*} [Group A] [Group B] [Group C]
    [AddCommGroup X] [Module (ZMod 2) X] [AddCommGroup Y] [Module (ZMod 2) Y]
    [AddCommGroup Z] [Module (ZMod 2) Z]
    {α : Representation (ZMod 2) A X} {β : Representation (ZMod 2) B Y}
    {γ : Representation (ZMod 2) C Z}
    (e : ActionEquiv α β) (f : ActionEquiv β γ) : ActionEquiv α γ :=
  ⟨e.groupEquiv.trans f.groupEquiv,e.linearEquiv.trans f.linearEquiv,
    fun g v => (congrArg f.linearEquiv (e.intertwines g v)).trans (f.intertwines _ _)⟩
private noncomputable def five_dualActionEquiv
    {D E U W : Type*} [Group D] [Group E]
    [AddCommGroup U] [Module (ZMod 2) U] [AddCommGroup W] [Module (ZMod 2) W]
    {σ : Representation (ZMod 2) D U} {τ : Representation (ZMod 2) E W}
    (e : ActionEquiv σ τ) : ActionEquiv σ.dual τ.dual where
  groupEquiv := e.groupEquiv
  linearEquiv := e.linearEquiv.symm.dualMap
  intertwines g f := by
    ext w
    change f (σ g⁻¹ (e.linearEquiv.symm w)) = f (e.linearEquiv.symm (τ (e.groupEquiv g)⁻¹ w))
    congr 1
    apply e.linearEquiv.injective
    rw [e.intertwines, e.linearEquiv.apply_symm_apply, e.linearEquiv.apply_symm_apply,
      e.groupEquiv.map_inv]

/-- The symmetric-five factor forces the source complement for the literal core F*(G₂). -/
theorem symmetricFive_splitAtSecond (c : Conclusion ρ)
    (he : IsExceptional ρ c.first c.sectionData.space)
    (f : FactorModuleConclusion (secondAction c))
    (hn : IsSymmetricNatural (secondFactorAction c f) 5) : SplitAtSecond c := by
  obtain ⟨n⟩ := hn
  let e := five_compAction (secondReducedFactorEquiv c f) n
  let k := coreEquiv c e.groupEquiv
  let τ : Representation (ZMod 2) (secondCore c) (BinaryPermutation.natural (Fin 5)) :=
    natural.comp k.toMonoidHom
  let a : ActionEquiv τ natural := ⟨k,LinearEquiv.refl _ _,fun _ _ => rfl⟩
  let : Group.IsPerfect (alternatingGroup (Fin 5)) :=
    ⟨commutator_alternatingGroup_eq_top (by simp)⟩
  let : Group.IsPerfect (secondCore c) :=
    Group.IsPerfect.ofSurjective (f := k.symm.toMonoidHom) k.symm.surjective
  let := natural_H1
  let := natural_dual_H1
  let := a.H1_subsingleton
  let := (five_dualActionEquiv a).H1_subsingleton
  have hf : τ.invariants = ⊥ := by
    apply bot_unique
    intro v hv
    have h : v ∈ natural.invariants := by
      intro g
      have hg := hv (k.symm g)
      change natural (k (k.symm g)) v = v at hg
      rwa [k.apply_symm_apply] at hg
    rwa [natural_fixed] at h
  have hgen : Coinvariants.ker τ = ⊤ := by
    rw [← natural_generated]
    apply congrArg (Submodule.span (ZMod 2))
    ext v
    constructor
    · rintro ⟨⟨g,w⟩,rfl⟩
      exact ⟨(k g,w),rfl⟩
    · rintro ⟨⟨g,w⟩,rfl⟩
      exact ⟨(k.symm g,w), by change natural (k (k.symm g)) w - w = _; rw [k.apply_symm_apply]⟩
  let U : Subrepresentation (ρ.comp (secondCore c).subtype) :=
    ⟨c.productConfiguration.fixed.toSubmodule,
      fun g _ hv => c.productConfiguration.fixed.apply_mem_toSubmodule g.val hv⟩
  let q := (QuasisimpleSource.fixed (secondAction c)).toSubmodule.mkQ
  let p : U.toRepresentation.IntertwiningMap τ :=
    (e.linearEquiv.toLinearMap.comp q).intertwiningMap_of_isIntertwiningMap _ _ (by
      intro g v
      change e.linearEquiv ((reducedAction (secondAction c))
        ⟨g.val,secondCore_le c g.property⟩ (q v)) = natural (k g) (e.linearEquiv (q v))
      have hh := e.intertwines ⟨g.val,secondCore_le c g.property⟩ (q v)
      rw [hh]
      change BinaryPermutation.naturalRepresentation (Fin 5)
        (e.groupEquiv ⟨g.val,secondCore_le c g.property⟩) _ =
          BinaryPermutation.naturalRepresentation (Fin 5) (k g).val _
      rw [coreEquiv_apply])
  have hs : Function.Surjective p := e.linearEquiv.surjective.comp
    (Representation.invariants (secondAction c)).mkQ_surjective
  have hc : p.toLinearMap.ker ≤ U.toRepresentation.invariants := by
    intro v hv
    have hz : q v = 0 := e.linearEquiv.injective (by
      change e.linearEquiv (q v) = e.linearEquiv 0
      rw [map_zero]
      exact hv)
    have hvf := (Submodule.Quotient.mk_eq_zero (Representation.invariants (secondAction c))).mp hz
    intro g
    exact hvf ⟨g.val,secondCore_le c g.property⟩
  have ht : HasTrivialQuotient U := by
    intro g v
    exact second_moved_le_fixed c he (Submodule.subset_span
      ⟨g.val,secondCore_le c g.property,v,Submodule.mem_top,rfl⟩)
  have hspl := central_section_isCompl U ht p hs hc hf hgen
  have hm : Coinvariants.ker (ρ.comp (secondCore c).subtype) = moved ρ (secondCore c) := by
    apply congrArg (Submodule.span (ZMod 2))
    ext v
    constructor
    · rintro ⟨⟨g,w⟩,rfl⟩
      exact ⟨g.val,g.property,w,Submodule.mem_top,rfl⟩
    · rintro ⟨g,hg,w,_,rfl⟩
      exact ⟨(⟨g,hg⟩,w),rfl⟩
  rw [hm] at hspl
  exact hspl

/-- Discharge the ordinary consumer’s symmetric-five exclusion directly from nonsplitting. -/
theorem not_symmetricFive_of_nonsplit (c : Conclusion ρ)
    (he : IsExceptional ρ c.first c.sectionData.space)
    (f : FactorModuleConclusion (secondAction c)) (hns : ¬SplitAtSecond c) :
    ¬ IsSymmetricNatural (secondFactorAction c f) 5 :=
  fun hn => hns (symmetricFive_splitAtSecond c he f hn)
end CFSG.Quasithin.ChapterB.SourceInduction.ExceptionalExtension.Nonsplit
