module
public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.SeedPlaneActor
public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.OffenderSubgroup
public import CFSG.Quasithin.ChapterB.Section01.MinimalPlaneComponent

/-!
# Full component catalogue and Irr⁺ for minimal plane offenders

The literal normal subgroup generated by all best offenders inherits the
ambient trivial two-core and the given SQTK cover. The selected moved
component lies normally in it. Restriction preserves the actual minimal
best offender and its whole-displacement bound, so the prepared seed
classification gives the original small actor catalogue. The independent
minimal-plane argument gives Irr⁺ for the full component moved space.
No classification, generation, section or model conclusion is assumed.

Source: Aschbacher–Smith13.7.15(1–2), printed pp.943–944.
-/

public section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
namespace CFSG.Quasithin.ChapterB.SourceInduction
open QuasisimpleSource ComponentReduction.PreliminaryActions
universe u v
variable {G : Type u} [Group G] [Finite G]
  {V : Type v} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

/-- The complete component actor catalogue in the original ambient action. -/
theorem component_actor_of_minimal_plane
    (hf : Function.Injective ρ) (hcore : pCore 2 G = ⊥)
    (cover : SQTKQuotient KnownSimple.IsKnownSimple G)
    {K A : Subgroup G} (hK : IsComponent G K) (hA : IsMinimalBestOffender ρ A)
    (hKA : ⁅K,A⁆ = K) (hd : Module.finrank (ZMod 2) (moved ρ A) ≤ 2) :
    SmallMoved.ActorList K := by
  let N := offenderSubgroup ρ
  have hAN : A ≤ N := hA.1.le_offenderSubgroup ρ
  obtain ⟨hKN,_,hKNs⟩ := moved_component_in_offenderSubgroup ρ hf hK hA.1 hKA
  have hA₀ : IsMinimalBestOffender (ρ.comp N.subtype) (A.subgroupOf N) := by
    let : IsElementaryAbelian 2 A := hA.1.1.2
    apply Preparation.minimal_of_injective_image ρ N.subtype N.subtype_injective
      (IsElementaryAbelian.subgroupOf hAN)
    rwa [map_subgroupOf_eq_of_le hAN]
  have hcomm : ⁅K.subgroupOf N,A.subgroupOf N⁆ = K.subgroupOf N := by
    apply map_injective N.subtype_injective
    rw [map_commutator, map_subgroupOf_eq_of_le hKN, map_subgroupOf_eq_of_le hAN,hKA]
  have hd₀ : Module.finrank (ZMod 2) (moved (ρ.comp N.subtype) (A.subgroupOf N)) ≤ 2 := by
    change Module.finrank (ZMod 2) (subspaceCommutator (ρ.comp N.subtype) ⊤ (A.subgroupOf N)) ≤ 2
    rw [subspaceCommutator_comp_map,map_subgroupOf_eq_of_le hAN]
    exact hd
  have hc := ff_component_actor_of_plane (ρ.comp N.subtype)
    (offenderSubgroup_hypothesis ρ hf hcore cover) hKNs hA₀ hcomm hd₀
  exact SmallMoved.ActorList.of_mulEquiv hc (subgroupOfEquivOfLe hKN).symm

/-- Both original13.7.15(1–2) conclusions hold on the original component and
whole moved space, without a model, classifier or section hypothesis. -/
theorem component_irrPlus_and_actor_of_minimal_plane
    (hf : Function.Injective ρ) (hcore : pCore 2 G = ⊥)
    (cover : SQTKQuotient KnownSimple.IsKnownSimple G)
    {K A : Subgroup G} (hK : IsComponent G K) (hA : IsMinimalBestOffender ρ A)
    (hKA : ⁅K,A⁆ = K) (hd : Module.finrank (ZMod 2) (moved ρ A) ≤ 2) :
    IsIrrPlus ρ K (moved ρ K) ∧ SmallMoved.ActorList K := by
  let : IsQuasisimple K := hK.2
  exact ⟨ChapterB.component_irrPlus_of_minimal_plane ρ hf hA hKA hd,
    component_actor_of_minimal_plane ρ hf hcore cover hK hA hKA hd⟩
end CFSG.Quasithin.ChapterB.SourceInduction
