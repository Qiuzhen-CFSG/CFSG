module
public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.Complete
public import CFSG.Quasithin.ChapterB.Section05.Quasisimple.SourceImplication.SmallMoved.Complete
public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.SourceInduction.ComponentReduction.PreliminaryActions.Preparation
public import Theory.Representation.BinaryOffender.MovedDimension

/-!
# Complete source classification on a selected component seed

The actual B.5.9 seed quotient is faithful, has trivial two-core and
quasisimple generalized Fitting subgroup, and is generated by offenders.
Full A supplies the component's SQTK property through its actual cover;
proved A.3.6 and B.4.2 instantiate all preparation and B.5.1 inputs. The
seed inclusion transports the original whole-displacement plane bound.
The complete small-moved sieve then returns the actor catalogue on the
original component, using the proved compatible component isomorphism.

Source: Aschbacher–Smith B.5.1, B.5.5, B.5.9 and13.7.15(1), pp.99–107,943.
-/

public section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
namespace CFSG.Quasithin.ChapterB.SourceInduction
open QuasisimpleSource ComponentReduction ComponentReduction.PreliminaryActions
universe u v
variable {G : Type u} [Group G] [Finite G]
  {V : Type v} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

private theorem componentSource : Preparation.ComponentInput.{u,v} KnownSimple.IsKnownSimple :=
  PreparationSource.componentInput_of_classification_sources
    (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
    (ChapterA.SQTKStructure.a36Input_of_theoremsAC
      (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
      (fun _ _ _ => ChapterA.Section02.theoremC_knownSimple))
    SourceClassification.irreducibleClassification_knownSimple

private theorem quasisimpleSource :
    ProjectiveLine.QuasisimpleClassificationInput.{u,v} KnownSimple.IsKnownSimple :=
  QuasisimpleSource.SourceCompletion.knownSimple_quasisimpleClassificationInput
    (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
    (ChapterA.SQTKStructure.a36Input_of_theoremsAC
      (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
      (fun _ _ _ => ChapterA.Section02.theoremC_knownSimple))
    SourceClassification.irreducibleClassification_knownSimple nonbinaryG2RootPairInput

omit [Finite G] in
/-- The whole plane bound descends through the literal seed kernel quotient. -/
theorem seedOffender_moved_le {K A : Subgroup G} (hKA : ⁅K,A⁆ = K)
    (hd : Module.finrank (ZMod 2) (moved ρ A) ≤ 2) :
    Module.finrank (ZMod 2) (moved (seedQuotientAction ρ hKA)
      (seedOffenderImage ρ hKA)) ≤ 2 := by
  have he := moved_finrank_map_le_of_embedding (ρ.comp (K ⊔ A).subtype)
    (seedQuotientAction ρ hKA) (seedQuotientMap ρ hKA)
    (naturalSeedSpace ρ K A).subtype (naturalSeedSpace ρ K A).subtype_injective
    (fun _ _ => rfl) (A.subgroupOf (K ⊔ A))
  change Module.finrank (ZMod 2) (moved (seedQuotientAction ρ hKA)
    (seedOffenderImage ρ hKA)) ≤
      Module.finrank (ZMod 2) (subspaceCommutator (ρ.comp (K ⊔ A).subtype) ⊤
        (A.subgroupOf (K ⊔ A))) at he
  rw [subspaceCommutator_comp_map, map_subgroupOf_eq_of_le (show A ≤ K ⊔ A from le_sup_right)] at he
  exact he.trans hd

/-- Complete B.5 on the prepared actual component seed gives the original
small actor catalogue, with all universal earlier inputs discharged. -/
theorem ff_component_actor_of_plane (hyp : FFHypothesis KnownSimple.IsKnownSimple ρ)
    {K A : Subgroup G} (hK : IsComponent G K) (hA : IsMinimalBestOffender ρ A)
    (hKA : ⁅K,A⁆ = K) (hd : Module.finrank (ZMod 2) (moved ρ A) ≤ 2) :
    SmallMoved.ActorList K := by
  have hs := PreparationSource.component_sqtk ρ
    (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple) hyp hK
  have hp := Preparation.prepared_of_component_rank ρ componentSource hyp hA hK hKA
    hs.stronglyQuasithin
  obtain ⟨q⟩ := quasisimpleSource _ _ (seedQuotientAction ρ hKA) (seedComponentImage ρ hKA) hp.source
  have hm := SmallMoved.source_actor_of_plane (seedQuotientAction ρ hKA)
    (hp.minimal.1.isOffender _) (seedOffender_moved_le ρ hKA hd) q.sectionData q.clause_one
  exact SmallMoved.ActorList.of_mulEquiv hm (Preparation.seedComponentEquiv ρ hKA hp.component_faithful)
end CFSG.Quasithin.ChapterB.SourceInduction
