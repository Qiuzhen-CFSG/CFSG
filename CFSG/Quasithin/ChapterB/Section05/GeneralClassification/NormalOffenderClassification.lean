module
public import Theory.Representation.BinaryOffender.NormalClosure
public import CFSG.Quasithin.ChapterB.Section05.OuterSixThreeShape.NoncentralFitting
public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.ComponentPlane

/-!
# Classification of the normal closure of a selected best offender

The literal normal closure is generated by its conjugate best offenders and
inherits the ambient trivial two-core. Complete B.5 applies through the
pulled-back SQTK cover. The moved component lies normally in this actor.
If the selected offender centralizes the ambient Fitting subgroup, its normal
closure has central Fitting subgroup, excluding the outer A₆–C₃ branch.
The source plane sieve handles the quasisimple branch, leaving precisely the
two actual product-module structures with all their original maps.

Source: Aschbacher–Smith13.7.14–15 and B.5.6, printed pp.943–944,105.
-/

public section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
namespace CFSG.Quasithin.ChapterB.SourceInduction
open QuasisimpleSource
universe u v
variable {G : Type u} [Group G] [Finite G]
  {V : Type v} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

/-- Classify the actual normal closure of the selected best offender. -/
theorem normalClosure_adequateAlternative
    (hfaith : Function.Injective ρ) (hcore : pCore 2 G = ⊥)
    (c : SQTKQuotient KnownSimple.IsKnownSimple G)
    {B : Subgroup G} (hB : IsBestOffender ρ B) :
    NontrivialAdequateAlternative (ρ.comp (normalClosure (B : Set G)).subtype) := by
  let N := normalClosure (B : Set G)
  have hBN : B ≤ N := subset_normalClosure
  have h : FFHypothesis KnownSimple.IsKnownSimple (ρ.comp N.subtype) := {
    finite_module := inferInstance
    faithful := hfaith.comp N.subtype_injective
    twoCore := normal_subgroup_twoCore_eq_bot N hcore
    generated := normalClosure_offenderSubgroup ρ hB
    quotient := ⟨c.subgroup N⟩ }
  exact (adequateAlternative_knownSimple _ h).of_ff _
    ⟨B.subgroupOf N,(hB.isOffender ρ).subgroupOf ρ hBN⟩

/-- The selected moved component is normal in this original normal closure. -/
theorem moved_component_in_normalClosure
    (hfaith : Function.Injective ρ) {K B : Subgroup G}
    (hK : IsComponent G K) (hB : IsBestOffender ρ B) (hcomm : ⁅K,B⁆ = K) :
    K ≤ normalClosure (B : Set G) ∧
      (K.subgroupOf (normalClosure (B : Set G))).Normal ∧
      IsComponent (normalClosure (B : Set G)) (K.subgroupOf (normalClosure (B : Set G))) := by
  let N := normalClosure (B : Set G)
  let J := offenderSubgroup ρ
  let : J.Normal := offenderSubgroup_normal ρ
  have hNJ : N ≤ J := normalClosure_le_normal (hB.le_offenderSubgroup ρ)
  have hKN : K ≤ N := by
    rw [← hcomm]
    exact (commutator_mono le_rfl (show B ≤ N from subset_normalClosure)).trans (commutator_le_right K N)
  have hn : (K.subgroupOf N).Normal := normal_subgroupOf_of_le_normalizer
    (hNJ.trans (ChapterB.offenderSubgroup_le_normalizer_component ρ hfaith hK))
  let : IsQuasisimple K := hK.2
  have hq : IsQuasisimple (K.subgroupOf N) := IsQuasisimple.of_mulEquiv (subgroupOfEquivOfLe hKN).symm
  exact ⟨hKN,hn,hn.isSubnormal,hq⟩

/-- The literal component and plane bound give the source conclusions or
one of the two genuine product-module cases. The outer case is excluded by
central Fitting, proved from the original selected offender. -/
theorem component_plane_of_fitting_centralizing_offender
    (hfaith : Function.Injective ρ) (hcore : pCore 2 G = ⊥)
    (c : SQTKQuotient KnownSimple.IsKnownSimple G)
    {K B : Subgroup G} (hK : IsComponent G K) (hB : IsBestOffender ρ B)
    (hcomm : ⁅K,B⁆ = K) (hc : B ≤ centralizer (fittingSubgroup G : Set G))
    (hd : Module.finrank (ZMod 2) (moved ρ B) ≤ 2) :
    let N := normalClosure (B : Set G)
    (IsIrrPlus (ρ.comp N.subtype) (K.subgroupOf N)
      (moved (ρ.comp N.subtype) (K.subgroupOf N)) ∧ SmallMoved.ActorList (K.subgroupOf N)) ∨
      Nonempty (SourceTwoFactorCase (ρ.comp N.subtype)) ∨
      Nonempty (HyperplaneCase (ρ.comp N.subtype)) := by
  let N := normalClosure (B : Set G)
  obtain ⟨_,_,hKN⟩ := moved_component_in_normalClosure ρ hfaith hK hB hcomm
  have hBN : B ≤ N := subset_normalClosure
  have hdim : Module.finrank (ZMod 2) (moved (ρ.comp N.subtype) (B.subgroupOf N)) ≤ 2 := by
    change Module.finrank (ZMod 2) (subspaceCommutator (ρ.comp N.subtype) ⊤ (B.subgroupOf N)) ≤ 2
    rw [subspaceCommutator_comp_map, map_subgroupOf_eq_of_le hBN]
    exact hd
  have hclass := normalClosure_adequateAlternative ρ hfaith hcore c hB
  rcases component_plane_of_adequate (ρ.comp N.subtype) hKN
      ((hB.isOffender ρ).subgroupOf ρ hBN) hdim hclass with h | hr
  · exact Or.inl h
  change Nonempty (SourceTwoFactorCase (ρ.comp N.subtype)) ∨
    Nonempty (OuterSixThreeShape N) ∨ Nonempty (HyperplaneCase (ρ.comp N.subtype)) at hr
  rcases hr with h | hr
  · exact Or.inr (Or.inl h)
  · rcases hr with ho | hh
    · obtain ⟨a⟩ := ho
      exact (no_outerSixThree_of_fitting_le_center (normalClosure_fitting_le_center B hc) a).elim
    · exact Or.inr (Or.inr hh)

end CFSG.Quasithin.ChapterB.SourceInduction
