module
public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.OffenderSubgroup
public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.SourceInduction.RankOneComparison
public import Theory.GroupTheory.ReducedNormal.Defs
public import Stellmacher.CentralizerQuotientRepresentation

/-!
# Three-free actors cannot have failure-of-factorization modules

Every nontrivial adequate B.5 alternative has positive three-rank, as
witnessed by its actual factor or group isomorphism. Apply the complete
known-simple classification to the normal subgroup generated by best
offenders to exclude FF-modules for three-free actors with trivial two-core.

For a reduced normal elementary subgroup U, its centralizer quotient has
trivial two-core. A normal three-free subgroup has a normal three-free image
there. If it contains J(S), any maximum elementary subgroup of S moving U
would give an offender in that image. Thus J(S) centralizes U.
The original nonsingular-centralizer application is in Chapter12's
Section06.Nonsingular.SmallThompson.

Source: Aschbacher--Smith, combined manuscript (1 March 2004),
B.2.7 and B.5.6, printed pp.76 and105, applied in12.6.11, p.825.
-/

public section
open scoped IsMulCommutative
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
namespace CFSG.Quasithin.ChapterB.SourceInduction
open QuasisimpleSource
private theorem linear_three_rank_pos (F : BinaryField) {d : ℕ} (hd : 2 ≤ d) :
    0 < primeRank 3 (Matrix.SpecialLinearGroup (Fin d) F.Carrier) := by
  have h3 := Theory.SpecificGroups.Classical.EvenDerivedThree.three_dvd_card_psl_commutator
    (F := F.Carrier) (i := (⟨0, by omega⟩ : Fin d)) (j := (⟨1, by omega⟩ : Fin d))
    (Fin.ne_of_val_ne (by change (0 : ℕ) ≠ 1; decide))
  apply Nat.pos_of_ne_zero
  intro hz
  exact PrimeRank.eq_zero_iff_not_dvd_card.mp hz
    ((h3.trans (card_subgroup_dvd_card _)).trans
      (Subgroup.card_dvd_of_surjective (QuotientGroup.mk' (center
        (Matrix.SpecialLinearGroup (Fin d) F.Carrier)))
        (QuotientGroup.mk'_surjective _)))

variable {D V : Type*} [Group D] [Finite D] [AddCommGroup V] [Module (ZMod 2) V]
    {ρ : Representation (ZMod 2) D V}

/-- Every nontrivial classification alternative has a genuine cubic subgroup. -/
theorem NontrivialAdequateAlternative.three_rank_pos
    (h : NontrivialAdequateAlternative ρ) : 0 < primeRank 3 D := by
  cases h with
  | quasisimple hq c =>
    have hp : 0 < primeRank 3 (generalizedFitting D) := by
      cases c.clause_one with
      | irreducible _ _ _ c _ => exact HighThreeRank.CoverCentralizer.action_case_rank_pos c
      | doubleThree F _ e _ _ =>
        rw [primeRank_equiv 3 e.groupEquiv]
        exact linear_three_rank_pos F (by decide)
      | naturalDual d hd _ h =>
        obtain ⟨e⟩ := h
        rw [primeRank_equiv 3 e.groupEquiv]
        exact linear_three_rank_pos BinaryField.two (by omega)
      | repeatedNatural d r hd _ _ _ h =>
        obtain ⟨e⟩ := h
        rw [primeRank_equiv 3 e.groupEquiv]
        exact linear_three_rank_pos BinaryField.two (by omega)
    exact hp.trans_le (primeRank_subgroup_le 3 _)
  | symmetricThree c =>
    apply Nat.pos_of_ne_zero
    intro hz
    apply PrimeRank.eq_zero_iff_not_dvd_card.mp hz
    rw [Nat.card_congr c.equiv.toEquiv, Nat.card_eq_fintype_card, Fintype.card_perm]
    decide
  | twoFactors c => exact (by decide : 0 < 2).trans_le c.two_le_three_rank
  | outerSixThree c => exact (by decide : 0 < 2).trans_le (outerShape_two_le_three_rank c)
  | hyperplane c => exact (by decide : 0 < 2).trans_le c.two_le_three_rank

variable [FiniteDimensional (ZMod 2) V]

/-- A faithful reduced action of a three-free SQTK quotient has no FF-offender. -/
theorem no_ff_of_three_free
    (hfaith : Function.Injective ρ) (hcore : pCore 2 D = ⊥)
    (c : SQTKQuotient KnownSimple.IsKnownSimple D)
    (hthree : Nat.Coprime 3 (Nat.card D)) : ¬ IsFFModule ρ := by
  intro hff
  obtain ⟨A,hA⟩ := (isFFModule_iff_exists_bestOffender ρ).mp hff
  have hJ : offenderSubgroup ρ ≠ ⊥ := fun hz =>
    hA.1.1 (bot_unique ((hA.le_offenderSubgroup ρ).trans_eq hz))
  let : Nontrivial (offenderSubgroup ρ) := (nontrivial_iff_ne_bot _).mpr hJ
  have hp := ((offenderSubgroup_adequateAlternative ρ hfaith hcore c).of_nontrivial _).three_rank_pos
  have hz : primeRank 3 D = 0 := PrimeRank.eq_zero_iff_not_dvd_card.mpr
    (Nat.prime_three.coprime_iff_not_dvd.mp hthree)
  have hh := (primeRank_subgroup_le 3 (offenderSubgroup ρ))
  omega

private theorem no_ff_on_three_free_normal
    (hfaith : Function.Injective ρ) (hcore : pCore 2 D = ⊥)
    (c : SQTKQuotient KnownSimple.IsKnownSimple D)
    (B : Subgroup D) [B.Normal] (hthree : Nat.Coprime 3 (Nat.card B)) :
    ¬ IsFFModule (ρ.comp B.subtype) := by
  have hBcore : pCore 2 B = ⊥ := by
    have hle : (pCore 2 B).map B.subtype ≤ pCore 2 D :=
      le_sSup ⟨inferInstance,pCore_isPGroup.map B.subtype⟩
    rw [hcore] at hle
    exact (map_eq_bot_iff_of_injective _ B.subtype_injective).mp (bot_unique hle)
  exact no_ff_of_three_free (ρ := ρ.comp B.subtype)
    (hfaith.comp B.subtype_injective) hBcore (c.subgroup B) hthree

end CFSG.Quasithin.ChapterB.SourceInduction

namespace CFSG.Quasithin.ChapterB.SourceInduction
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory Stellmacher
variable {A : Type*} [Group A] [Finite A]

/-- B.2.7 and B.5.6 force Thompson centralization on the original reduced subgroup. -/
theorem thompson_centralizes_reduced_of_three_free_normal
    (U : Subgroup A) (hr : IsPReduced 2 U)
    (hsq : IsSQTK KnownSimple.IsKnownSimple A)
    (S C : Subgroup A) [C.Normal] (hUS : U ≤ S)
    (hJC : elementaryAbelianMaxJ S ≤ C)
    (hthree : Nat.Coprime 3 (Nat.card C)) :
    elementaryAbelianMaxJ S ≤ centralizer (U : Set A) := by
  let := hr.normal
  let := hr.elementary
  let D := A ⧸ centralizer (U : Set A)
  let q := QuotientGroup.mk' (centralizer (U : Set A))
  let ρ : Representation (ZMod 2) D (Additive U) := NormalElementaryQuotient.representation U q (QuotientGroup.mk'_surjective _)
    (QuotientGroup.ker_mk' _)
  let B := C.map q
  let : B.Normal := (inferInstance : C.Normal).map q (QuotientGroup.mk'_surjective _)
  let c : SQTKQuotient KnownSimple.IsKnownSimple D := {
    Cover := A
    kernel := centralizer (U : Set A)
    sqtk := hsq
    equiv := MulEquiv.refl D }
  have hfaith : Function.Injective ρ :=
    NormalElementaryQuotient.representation_injective U q
      (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _)
  have hthreeB : Nat.Coprime 3 (Nat.card B) :=
    hthree.coprime_dvd_right
      (card_dvd_of_surjective (q.subgroupMap C) (q.subgroupMap_surjective C))
  have hno : ¬ IsFFModule (ρ.comp B.subtype) :=
    no_ff_on_three_free_normal (D := D) (V := Additive U) (ρ := ρ) hfaith hr.quotient_pCore_eq_bot c B hthreeB
  apply sSup_le
  intro E hE
  by_contra hn
  have hn' : ¬ E ≤ q.ker := by simpa only [q,QuotientGroup.ker_mk'] using hn
  have he : IsOffender ρ (E.map q) := NormalElementaryQuotient.maxElementary_isOffender U q
    (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _) S E hUS hE hn'
  have hEB : E.map q ≤ B := map_mono ((le_sSup hE).trans hJC)
  exact hno ⟨(E.map q).subgroupOf B,he.subgroupOf ρ hEB⟩
end CFSG.Quasithin.ChapterB.SourceInduction

