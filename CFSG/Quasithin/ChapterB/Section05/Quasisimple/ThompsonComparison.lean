module
public import CFSG.Quasithin.ChapterB.Section05.Quasisimple.SourceCompletion.AlternatingSixMoved
public import CFSG.Quasithin.ChapterB.InternalThompsonAction
public import Theory.GroupTheory.GeneralizedFitting.SimpleTwoQuotient
public import Theory.Representation.NormalElementaryQuotient.IrrPlusCommutator

/-!
# Comparing elementary modules in the local A₆ action

A core-faithful elementary module inside a two-local group acquires an FF
witness when its component is generated by Thompson commutators. If the
component image is A₆ and the quotient over it is a two-group, B.5.1 makes
the moved space Irr⁺. Every contained noncentral invariant subgroup then
has the same commutator, retaining the literal subgroup inclusions.
Source: Aschbacher--Smith, B.5.1 and12.6.11, printed pp.99--103 and825.
-/
public section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender Stellmacher
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterB
variable {A : Type*} [Group A] [Finite A]

/-- Thompson generation constructs an FF witness on any specified normal
elementary subgroup moved by the component. -/
theorem ff_of_thompson_generated_movement (U B S : Subgroup A)
    [U.Normal] [IsElementaryAbelian 2 U]
    (hUS : U ≤ S) (hgen : B = ⁅B,elementaryAbelianMaxJ S⁆)
    (hm : ⁅U,B⁆ ≠ ⊥) : IsFFModule (InternalThompsonAction.action U) := by
  let q := InternalThompsonAction.actionMk U
  let ρ := InternalThompsonAction.action U
  let J := elementaryAbelianMaxJ S
  by_contra hff
  have hJker : J ≤ q.ker := by
    apply sSup_le
    intro E hE
    apply (map_eq_bot_iff E).mp
    by_contra he
    exact hff ((isFFModule_iff_exists_bestOffender ρ).mpr ⟨_,
      NormalElementaryQuotient.maxElementary_isBestOffender U q
        (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _) S E hUS hE he⟩)
  have hBker : B ≤ q.ker := by
    rw [hgen]
    exact (commutator_mono le_rfl hJker).trans (commutator_le_right _ _)
  apply hm
  rw [commutator_comm]
  apply commutator_eq_bot_iff_le_centralizer.mpr
  simpa only [q,InternalThompsonAction.actionMk,QuotientGroup.ker_mk'] using hBker

/-- A core-faithful local FF module with A₆ component has an Irr⁺ moved space. -/
theorem local_card360_moved_irrPlus
    (U B S : Subgroup A) [U.Normal] [B.Normal]
    [IsElementaryAbelian 2 U] (hUS : U ≤ S)
    (hcentral : centralizer (U : Set A) = pCore 2 A)
    (hgen : B = ⁅B,elementaryAbelianMaxJ S⁆)
    (hm : ⁅U,B⁆ ≠ ⊥)
    (hsq : IsSQTK KnownSimple.IsKnownSimple
      (B.map (InternalThompsonAction.actionMk U)))
    (he : Nonempty ((B.map (InternalThompsonAction.actionMk U)) ≃* alternatingGroup (Fin 6)))
    (hquot : IsPGroup 2 (InternalThompsonAction.ActionQuotient U ⧸
      B.map (InternalThompsonAction.actionMk U))) :
    IsIrrPlus (InternalThompsonAction.action U)
      (B.map (InternalThompsonAction.actionMk U))
      (subspaceCommutator (InternalThompsonAction.action U) ⊤
        (B.map (InternalThompsonAction.actionMk U))) := by
  let q := InternalThompsonAction.actionMk U
  let C := B.map q
  let : C.Normal := (inferInstance : B.Normal).map q (QuotientGroup.mk'_surjective _)
  obtain ⟨e⟩ := he
  let : IsSimpleGroup (alternatingGroup (Fin 6)) := alternatingGroup.isSimpleGroup (by simp)
  let : IsSimpleGroup C := e.isSimpleGroup
  let : IsQuasisimple (alternatingGroup (Fin 6)) := {
    toIsPerfect := ⟨commutator_alternatingGroup_eq_top (by simp)⟩
    simple := ((QuotientGroup.quotientMulEquivOfEq
      (alternatingGroup.center_eq_bot (by simp))).trans QuotientGroup.quotientBot).isSimpleGroup }
  let : IsQuasisimple C := IsQuasisimple.of_mulEquiv e.symm
  have hcard : Nat.card C = 360 := by
    rw [Nat.card_congr e.toEquiv,nat_card_alternatingGroup]
    norm_num [Nat.factorial]
  have hcore : pCore 2 (InternalThompsonAction.ActionQuotient U) = ⊥ := by
    change pCore 2 (A ⧸ centralizer (U : Set A)) = ⊥
    let eQ := QuotientGroup.quotientMulEquivOfEq hcentral
    apply (map_eq_bot_iff_of_injective _ (f := eQ.toMonoidHom) eQ.injective).mp
    rw [pCore_map_iso 2 eQ,pCore_quotient_pCore_eq_bot 2]
  have hC := centralizer_eq_bot_of_simple_two_quotient C
    (Group.IsPerfect.not_isMulCommutative C) hquot hcore
  have hff := ff_of_thompson_generated_movement U B S hUS hgen hm
  exact QuasisimpleSource.SourceCompletion.ff_card360_moved_irrPlus
    (InternalThompsonAction.action U) C hcard hC hsq
    (InternalThompsonAction.action_faithful U) hff
end CFSG.Quasithin.ChapterB
