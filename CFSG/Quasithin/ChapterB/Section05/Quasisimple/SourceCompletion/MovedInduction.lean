/-!
# The original moved module and strict submodule induction

The binary outer-group calculation and the source offender generation imply
F*(G)=L. The actual moved submodule is faithful, still generated by offenders,
and still satisfies every original B.5.1 hypothesis. Perfectness makes it
commutator-generated; failure of Irr⁺ transports through its literal inclusion.

Applying the single-natural-chief theorem to this action, then the proved
dual-cohomology descent, constructs a chief flag with no central factors.
Its nonzero proper terms are faithful, commutator-generated and fixed-point-free.
Each supports the genuine B.5.1 induction with dimension strictly below the
original V. No universal B.5.1 classifier or semisimplicity premise is assumed.

Source: Aschbacher--Smith, B.5.1, printed pp.99--102: observation β,
U=[V,L], and the maximal-submodule step in the binary degree-four/five branches.
The remaining reconstruction of the full direct sum and G=L is separate.
-/

public section

open Representation Representation.BinaryOffender Theory.GroupTheory Subgroup
open scoped ENNReal MatrixGroups IsMulCommutative
namespace CFSG.Quasithin.ChapterB.QuasisimpleSource.SourceCompletion
universe u v
variable {G : Type u} {V : Type v} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

/-- Source observation β identifies F* with L in the actual binary rows,
using the proved cyclic outer group and the original offender generation. -/
theorem binary_source_fitting {K : CFSG.Quasithin.GroupClass.{u}} {L : Subgroup G}
    (h : QuasisimpleSourceHypothesis ρ K L) {d : ℕ} (hd : d = 4 ∨ d = 5)
    (mark : L ≃* SL(d,ZMod 2)) : generalizedFitting G = L := by
  let : IsQuasisimple L := h.quasisimple
  let : L.Normal := component_normal_of_fitting_eq_sup_center L h.fitting
  let : IsCyclic (MulAut.Outer (BinaryLinear.OuterCyclic.LinearGroup d)) :=
    BinaryLinear.OuterCyclic.linear_outer_isCyclic hd
  let : IsCyclic (MulAut.Outer L) := (MulAut.outerCongr
    (mark.trans (BinaryLinear.OuterCyclic.slEquivLinear d))).isCyclic.mpr inferInstance
  let T : Sylow 2 G := Classical.choice inferInstance
  have hgen := IrreducibleBranch.whole_eq_component_sylow_of_outer_abelian
    ρ L h.fitting h.generated T
  let q := QuotientGroup.mk' L
  have hLq : L.map q = ⊥ := by
    apply (Subgroup.map_eq_bot_iff L).mpr
    intro l hl
    exact (QuotientGroup.eq_one_iff l).mpr hl
  have hTq : (T : Subgroup G).map q = ⊤ := by
    have hm := congrArg (fun H : Subgroup G => H.map q) hgen
    rw [Subgroup.map_sup,hLq,bot_sup_eq,← MonoidHom.range_eq_map,
      MonoidHom.range_eq_top.mpr (QuotientGroup.mk'_surjective L)] at hm
    exact hm
  have hsurj : Function.Surjective (q.comp (T : Subgroup G).subtype) := by
    apply MonoidHom.range_eq_top.mp
    rw [MonoidHom.range_comp,Subgroup.range_subtype,hTq]
  exact generalizedFitting_eq_of_quasisimple_two_quotient L
    (T.isPGroup'.of_surjective _ hsurj) h.twoCore

/-- Restriction to the literal moved space preserves the complete source
hypothesis when the generalized Fitting subgroup is the component itself. -/
theorem moved_source_hypothesis {K : CFSG.Quasithin.GroupClass.{u}} {L : Subgroup G}
    (h : QuasisimpleSourceHypothesis ρ K L) (s : MovedSection ρ L)
    (hfit : generalizedFitting G = L) :
    QuasisimpleSourceHypothesis s.space.toRepresentation K L := by
  let := h.finite_module
  have hfL : Function.Injective (s.space.toRepresentation.comp L.subtype) := by
    intro x y hxy
    apply IrreducibleBranch.component_faithful h s
    apply LinearMap.ext
    intro q
    induction q using Submodule.Quotient.induction_on with
    | _ v => exact congrArg s.central.toSubmodule.mkQ (LinearMap.congr_fun hxy v)
  have hf : Function.Injective s.space.toRepresentation := by
    apply IrreducibleBranch.faithful_of_fitting_restriction
    rwa [hfit]
  refine ⟨inferInstance,hf,h.quasisimple,h.sqtk,h.fitting,h.twoCore,?_⟩
  apply top_unique
  rw [← h.generated]
  apply iSup_le
  intro A
  apply iSup_le
  rintro ⟨hA,_⟩
  exact (bestOffender_on_subrepresentation ρ s.space hA).le_offenderSubgroup _

omit [Finite G] in
/-- A perfect component generates its own moved space by commutators. -/
theorem moved_commutator_top {L : Subgroup G} [L.Normal] [Group.IsPerfect L]
    (s : MovedSection ρ L) : subspaceCommutator s.space.toRepresentation ⊤ L = ⊤ := by
  let J := s.space
  let D := subspaceCommutator ρ J.toSubmodule L
  have hJstab : L ≤ subspaceStabilizer ρ J.toSubmodule := by
    apply le_subspaceStabilizer
    intro k hk v hv
    exact J.apply_mem_toSubmodule k hv
  have hDstab : L ≤ subspaceStabilizer ρ D :=
    subspaceCommutator_invariant ρ J.toSubmodule L
  have hDle : D ≤ J.toSubmodule :=
    subspaceCommutator_le_of_invariant ρ hJstab
  let Drep : Subrepresentation (ρ.comp L.subtype) :=
    ⟨D, fun k _ hv => (hDstab k.property _).2 hv⟩
  let qρ := Drep.quotientRepresentation
  have hqC : subspaceCommutator qρ ⊤ (⊤ : Subgroup L) ≤ fixedSpace qρ ⊤ := by
    apply Submodule.span_le.mpr
    rintro _ ⟨x, _, v, _, rfl⟩ k
    induction v using Submodule.Quotient.induction_on with
    | _ w =>
      change qρ k (qρ x (Drep.toSubmodule.mkQ w) - Drep.toSubmodule.mkQ w) =
        qρ x (Drep.toSubmodule.mkQ w) - Drep.toSubmodule.mkQ w
      rw [map_sub, Subrepresentation.quotientRepresentation_mk,
        Subrepresentation.quotientRepresentation_mk]
      apply (Submodule.Quotient.eq D).mpr
      have hdJ : ρ x.val w - w ∈ J.toSubmodule := by
        rw [show J.toSubmodule = moved ρ L from s.space_eq]
        exact Submodule.subset_span ⟨x.val,x.property,w,Submodule.mem_top,rfl⟩
      exact Submodule.subset_span
        ⟨k.val,k.val.property,ρ x.val w - w,hdJ,by
          simp only [map_sub,← Module.End.mul_apply]
          rfl⟩
  have hqfix : (⊤ : Submodule (ZMod 2) (V ⧸ D)) ≤ fixedSpace qρ (⊤ : Subgroup L) :=
    le_fixedSpace_of_commutator_le_fixedSpace qρ (⊤ : Subgroup L) ⊤
      (le_subspaceStabilizer qρ ⊤ (by simp)) hqC
  have hJleD : J.toSubmodule ≤ D := by
    rw [show J.toSubmodule = moved ρ L from s.space_eq]
    apply Submodule.span_le.mpr
    rintro _ ⟨x,hx,v,_,rfl⟩
    exact (Submodule.Quotient.eq D).mp (hqfix (show Drep.toSubmodule.mkQ v ∈
      (⊤ : Submodule (ZMod 2) (V ⧸ D)) from Submodule.mem_top) ⟨⟨x,hx⟩,by trivial⟩)
  have hD : D = J.toSubmodule := le_antisymm hDle hJleD
  apply top_unique
  intro v _
  have hle : D ≤ (subspaceCommutator J.toRepresentation ⊤ L).map J.toSubmodule.subtype := by
    apply Submodule.span_le.mpr
    rintro _ ⟨k,hk,w,hw,rfl⟩
    exact ⟨J.toRepresentation k ⟨w,hw⟩ - ⟨w,hw⟩,
      Submodule.subset_span ⟨k,hk,⟨w,hw⟩,Submodule.mem_top,rfl⟩,rfl⟩
  obtain ⟨w,hw,he⟩ := hle (show v.val ∈ D from hD.symm ▸ v.property)
  exact (Subtype.ext he : w = v) ▸ hw

/-- The original failure of Irr⁺ persists on the literal moved action. -/
theorem moved_not_irrPlus {K : CFSG.Quasithin.GroupClass.{u}} {L : Subgroup G}
    (h : QuasisimpleSourceHypothesis ρ K L) (s : MovedSection ρ L)
    (hnot : ¬ IsIrrPlus ρ L (moved ρ L)) :
    ¬ IsIrrPlus s.space.toRepresentation L (moved s.space.toRepresentation L) := by
  let : IsQuasisimple L := h.quasisimple
  let : L.Normal := component_normal_of_fitting_eq_sup_center L h.fitting
  have hm : moved s.space.toRepresentation L = ⊤ := moved_commutator_top ρ s
  intro hi
  rw [hm] at hi
  have hi' : IsIrrPlus s.space.toRepresentation (L.map (MonoidHom.id G)) ⊤ := by
    simpa only [Subgroup.map_id] using hi
  have hh := IsIrrPlus.map_embedding ρ s.space.toRepresentation (MonoidHom.id G)
    s.space.toSubmodule.subtype s.space.toSubmodule.subtype_injective
    (fun _ _ => rfl) L ⊤ hi'
  rw [Submodule.map_top,Submodule.range_subtype,s.space_eq] at hh
  exact hnot hh

omit [Finite G] in
private theorem moved_local_commutator {L : Subgroup G} [L.Normal] [Group.IsPerfect L]
    (s : MovedSection ρ L) (A : Subgroup G)
    (hfit : generalizedFitting ↥(L ⊔ A) = L.subgroupOf (L ⊔ A)) :
    Coinvariants.ker ((s.space.toRepresentation.comp (L ⊔ A).subtype).comp
      (generalizedFitting ↥(L ⊔ A)).subtype) = ⊤ := by
  have hg := moved_commutator_top ρ s
  have hspan : subspaceCommutator s.space.toRepresentation ⊤ L ≤ Coinvariants.ker
      ((s.space.toRepresentation.comp (L ⊔ A).subtype).comp
        (generalizedFitting ↥(L ⊔ A)).subtype) := by
    rw [hfit]
    apply Submodule.span_le.mpr
    rintro _ ⟨g,hg,v,_,rfl⟩
    exact Coinvariants.sub_mem_ker
      (ρ := (s.space.toRepresentation.comp (L ⊔ A).subtype).comp
        (L.subgroupOf (L ⊔ A)).subtype) ⟨⟨g,(show L ≤ L ⊔ A from le_sup_left) hg⟩,hg⟩ v
  exact top_unique (hg ▸ hspan)

private theorem binary_fullyMoved_source_pure
    {K : CFSG.Quasithin.GroupClass.{u}} (hK : IrreducibleBranch.ContainsSimpleTwoGroups K)
    (earlier : SourceInduction.ProjectiveLine.IrreducibleClassificationInput.{u,v} K)
    {L : Subgroup G} (h : QuasisimpleSourceHypothesis ρ K L)
    (hnot : ¬ IsIrrPlus ρ L (moved ρ L))
    {d : ℕ} (hd : d = 4 ∨ d = 5) (mark : L ≃* SL(d,ZMod 2))
    (hm : subspaceCommutator ρ ⊤ L = ⊤) :
    ∃ A : Subgroup G, IsMinimalBestOffender ρ A ∧
      ∃ f : ReducibleChiefFlag (ρ.comp (L ⊔ A).subtype) (generalizedFitting ↥(L ⊔ A)),
        f.noncentral = Finset.range f.length ∧
        (∀ i < f.length,
          let τ := sectionRepresentation (ρ.comp (L ⊔ A).subtype) (f.chain i) (f.chain (i+1))
          Function.Injective τ ∧ IsIrreducible (τ.comp (generalizedFitting ↥(L ⊔ A)).subtype) ∧
            IsLinearNatural (τ.comp (generalizedFitting ↥(L ⊔ A)).subtype) BinaryField.two d) ∧
        ∀ i ≤ f.length,
          Coinvariants.ker ((f.chain i).toRepresentation.comp (generalizedFitting ↥(L ⊔ A)).subtype) = ⊤ ∧
          Representation.invariants ((f.chain i).toRepresentation.comp
            (generalizedFitting ↥(L ⊔ A)).subtype) = ⊥ := by
  let := h.finite_module
  let : IsQuasisimple L := h.quasisimple
  let : L.Normal := component_normal_of_fitting_eq_sup_center L h.fitting
  obtain ⟨A,hA,f,hn⟩ := binary_source_single_chiefs ρ hK earlier h hnot hd mark
  let H := L ⊔ A
  let σ := ρ.comp H.subtype
  have hfitH : generalizedFitting H = L.subgroupOf H :=
    IrreducibleBranch.local_generalizedFitting L A h.fitting h.twoCore (hA.1.1.2.isPGroup 2 A)
  have hmH : Coinvariants.ker (σ.comp (generalizedFitting H).subtype) = ⊤ := by
    have hspan : subspaceCommutator ρ ⊤ L ≤ Coinvariants.ker
        (σ.comp (generalizedFitting H).subtype) := by
      rw [hfitH]
      apply Submodule.span_le.mpr
      rintro _ ⟨g,hg,v,_,rfl⟩
      exact Coinvariants.sub_mem_ker
        (ρ := σ.comp (L.subgroupOf H).subtype) ⟨⟨g,(show L ≤ H from le_sup_left) hg⟩,hg⟩ v
    exact top_unique (hm ▸ hspan)
  obtain ⟨hindices,hpure⟩ := binary_flag_pure σ (generalizedFitting H) f hmH
    (fun i hi => ⟨d,by omega,(hn i hi).2.2⟩)
  exact ⟨A,hA,f,hindices,fun i hi => hn i (hindices ▸ Finset.mem_range.mpr hi),hpure⟩

/-- The original binary source module supplies a central-free natural chief
flag on its literal moved submodule, with all terms fully moved and fixed-point-free. -/
theorem binary_moved_pure_flag
    {K : CFSG.Quasithin.GroupClass.{u}} (hK : IrreducibleBranch.ContainsSimpleTwoGroups K)
    (earlier : SourceInduction.ProjectiveLine.IrreducibleClassificationInput.{u,v} K)
    {L : Subgroup G} (h : QuasisimpleSourceHypothesis ρ K L)
    (hnot : ¬ IsIrrPlus ρ L (moved ρ L))
    {d : ℕ} (hd : d = 4 ∨ d = 5) (mark : L ≃* SL(d,ZMod 2))
    :
    ∃ s : MovedSection ρ L, ∃ A : Subgroup G,
      IsMinimalBestOffender s.space.toRepresentation A ∧
      ∃ f : ReducibleChiefFlag (s.space.toRepresentation.comp (L ⊔ A).subtype)
          (generalizedFitting ↥(L ⊔ A)),
        f.noncentral = Finset.range f.length ∧
        (∀ i < f.length,
          let τ := sectionRepresentation (s.space.toRepresentation.comp (L ⊔ A).subtype)
            (f.chain i) (f.chain (i+1))
          Function.Injective τ ∧ IsIrreducible (τ.comp (generalizedFitting ↥(L ⊔ A)).subtype) ∧
            IsLinearNatural (τ.comp (generalizedFitting ↥(L ⊔ A)).subtype) BinaryField.two d) ∧
        ∀ i ≤ f.length,
          Coinvariants.ker ((f.chain i).toRepresentation.comp
            (generalizedFitting ↥(L ⊔ A)).subtype) = ⊤ ∧
          Representation.invariants ((f.chain i).toRepresentation.comp
            (generalizedFitting ↥(L ⊔ A)).subtype) = ⊥ := by
  let := h.finite_module
  let : IsQuasisimple L := h.quasisimple
  let : L.Normal := component_normal_of_fitting_eq_sup_center L h.fitting
  obtain ⟨s⟩ : Nonempty (MovedSection ρ L) := ⟨h.movedSection ρ⟩
  exact ⟨s,binary_fullyMoved_source_pure s.space.toRepresentation hK earlier
    (moved_source_hypothesis ρ h s (binary_source_fitting ρ h hd mark))
    (moved_not_irrPlus ρ h s hnot) hd mark (moved_commutator_top ρ s)⟩

/-- On the original binary B.5.1 domain, the literal moved module has a
central-free natural chief flag and every nonzero proper term supports the
strict smaller-dimension B.5.1 induction. All passage-to-moved hypotheses are
proved, and the original component and offender subgroups are retained. -/
theorem binary_moved_reconstruction
    {K : CFSG.Quasithin.GroupClass.{u}} (hK : IrreducibleBranch.ContainsSimpleTwoGroups K)
    (earlier : SourceInduction.ProjectiveLine.IrreducibleClassificationInput.{u,v} K)
    {L : Subgroup G} (h : QuasisimpleSourceHypothesis ρ K L)
    (hnot : ¬ IsIrrPlus ρ L (moved ρ L))
    {d : ℕ} (hd : d = 4 ∨ d = 5) (mark : L ≃* SL(d,ZMod 2))
    (ih : SmallerDimensionInput.{u,v} K (Module.finrank (ZMod 2) V)) :
    ∃ s : MovedSection ρ L, ∃ A : Subgroup G,
      IsMinimalBestOffender s.space.toRepresentation A ∧
      ∃ f : ReducibleChiefFlag (s.space.toRepresentation.comp (L ⊔ A).subtype)
          (generalizedFitting ↥(L ⊔ A)),
        f.noncentral = Finset.range f.length ∧
        (∀ i < f.length,
          let τ := sectionRepresentation (s.space.toRepresentation.comp (L ⊔ A).subtype)
            (f.chain i) (f.chain (i+1))
          Function.Injective τ ∧ IsIrreducible (τ.comp (generalizedFitting ↥(L ⊔ A)).subtype) ∧
            IsLinearNatural (τ.comp (generalizedFitting ↥(L ⊔ A)).subtype) BinaryField.two d) ∧
        ∀ i, 0 < i → i < f.length →
          Function.Injective (f.chain i).toRepresentation ∧
          Coinvariants.ker ((f.chain i).toRepresentation.comp
            (generalizedFitting ↥(L ⊔ A)).subtype) = ⊤ ∧
          Representation.invariants ((f.chain i).toRepresentation.comp
            (generalizedFitting ↥(L ⊔ A)).subtype) = ⊥ ∧
          LocalSourceConclusion (f.chain i).toRepresentation (generalizedFitting ↥(L ⊔ A))
            (A.subgroupOf (L ⊔ A)) := by
  let := h.finite_module
  let : IsQuasisimple L := h.quasisimple
  let : L.Normal := component_normal_of_fitting_eq_sup_center L h.fitting
  obtain ⟨s,A,hA,f,hindices,hn,hpure⟩ := binary_moved_pure_flag ρ hK earlier h hnot hd mark
  let H := L ⊔ A
  let μ := s.space.toRepresentation
  let σ := μ.comp H.subtype
  have hp : IsPGroup 2 A := hA.1.1.2.isPGroup 2 A
  have hfitH : generalizedFitting H = L.subgroupOf H :=
    IrreducibleBranch.local_generalizedFitting L A h.fitting h.twoCore hp
  refine ⟨s,A,hA,f,hindices,hn,?_⟩
  intro i hi0 hi
  have hfi := faithful_submodule_of_section σ (f.chain 0) (f.chain 1) (f.chain i)
    (f.monotone (by omega)) (hn 0 (by omega)).1
  refine ⟨hfi,(hpure i (by omega)).1,(hpure i (by omega)).2,?_⟩
  let : IsQuasisimple (L.subgroupOf H) :=
    IsQuasisimple.of_mulEquiv (subgroupOfEquivOfLe (show L ≤ H from le_sup_left)).symm
  let : IsQuasisimple (generalizedFitting H) := hfitH.symm ▸ inferInstance
  have hs : IsSQTK K (generalizedFitting H) := by
    rw [hfitH]
    exact (IsSQTK.equiv (subgroupOfEquivOfLe (show L ≤ H from le_sup_left))).mpr h.sqtk
  have hcore : pCore 2 H = ⊥ :=
    IrreducibleBranch.local_twoCore_eq_bot L H h.fitting h.twoCore le_sup_left
  have ihu : SmallerDimensionInput.{u,v} K (Module.finrank (ZMod 2) s.space.toSubmodule) := by
    intro D _ _ W _ _ _ δ C hdim hh
    exact ih D W δ C (hdim.trans_le s.space.toSubmodule.finrank_le) hh
  exact recursive_faithful_flag_term σ ihu hs hcore f
    (hA.1.subgroupOf μ le_sup_right) hi hfi

