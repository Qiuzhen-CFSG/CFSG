module
public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.Complete
public import Theory.GroupTheory.GeneralizedFitting.NormalQuasisimpleImage
public import Theory.GroupTheory.GeneralizedFitting.SimpleSocleStructure
public import Theory.Representation.BinaryOffender.GeneratedCore

/-!
# Full B.5.1 on an FF actor with a faithful simple normal subgroup

The subgroup generated by best offenders is normal and nontrivial. A
self-centralizing simple normal subgroup lies inside it, remains
self-centralizing there, and is its generalized Fitting subgroup. Restriction
to the actual offender subgroup supplies the generation hypothesis of B.5.1.
All six proved known-simple B.5.1 clauses therefore apply to the original
module, without assuming that the whole original actor is offender-generated.

Source: Aschbacher--Smith B.5.1 and the application in C.2.7, pp.99--103,146.
-/

public section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterB.QuasisimpleSource.SourceCompletion
universe u v
variable {G : Type u} [Group G] [Finite G]
variable {V : Type v} [AddCommGroup V] [Module (ZMod 2) V] [Module.Finite (ZMod 2) V]

theorem ff_socle_source_conclusion
    (ρ : Representation (ZMod 2) G V) (L : Subgroup G)
    [L.Normal] [IsSimpleGroup L] [IsQuasisimple L]
    (hC : centralizer (L : Set G) = ⊥)
    (hsq : IsSQTK KnownSimple.IsKnownSimple L)
    (hf : Function.Injective ρ) (hff : IsFFModule ρ) :
    L ≤ offenderSubgroup ρ ∧
    Nonempty (SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
      (ρ.comp (offenderSubgroup ρ).subtype) (L.subgroupOf (offenderSubgroup ρ))) := by
  let J := offenderSubgroup ρ
  let : J.Normal := offenderSubgroup_normal ρ
  have hLJ : L ≤ J := simple_normal_le_of_normal_ne_bot_of_centralizer_eq_bot L
    (Group.IsPerfect.not_isMulCommutative L) hC J (offenderSubgroup_ne_bot_of_ff ρ hff)
  let D := L.subgroupOf J
  let e : D ≃* L := subgroupOfEquivOfLe hLJ
  let : IsQuasisimple D := IsQuasisimple.of_mulEquiv e.symm
  let : IsSimpleGroup D := e.isSimpleGroup
  have hCD : centralizer (D : Set J) = ⊥ := by
    apply bot_unique
    intro x hx
    have hm : (x : G) ∈ centralizer (L : Set G) := by
      intro y hy
      exact congrArg Subtype.val (mem_centralizer_iff.mp hx ⟨y,hLJ hy⟩ hy)
    exact mem_bot.mpr (Subtype.ext (mem_bot.mp (hC ▸ hm)))
  have hfit : generalizedFitting J = D := generalizedFitting_eq_of_quasisimple_centralizer D hCD
  have hcore : pCore 2 J = ⊥ := SimpleSocle.pCore_eq_bot (SimpleSocle.radical_eq_bot D hCD) 2
  have hh : QuasisimpleSourceHypothesis (ρ.comp J.subtype) KnownSimple.IsKnownSimple D := by
    refine ⟨inferInstance, hf.comp J.subtype_injective, inferInstance,
      (IsSQTK.equiv e).mpr hsq, ?_, hcore, offenderSubgroup_restrict_eq_top ρ⟩
    rw [hfit]
    exact (sup_eq_left.mpr (by
      rw [← hfit]
      exact (show center J ≤ fittingSubgroup J from le_sSup ⟨inferInstance,inferInstance⟩).trans
        (fitting_le_generalizedFitting J))).symm
  refine ⟨hLJ,?_⟩
  exact knownSimple_quasisimpleClassificationInput
    (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
    (ChapterA.SQTKStructure.a36Input_of_theoremsAC
      (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
      (fun _ _ _ => ChapterA.Section02.theoremC_knownSimple))
    SourceClassification.irreducibleClassification_knownSimple
    SourceInduction.nonbinaryG2RootPairInput J V (ρ.comp J.subtype) D hh

end CFSG.Quasithin.ChapterB.QuasisimpleSource.SourceCompletion

