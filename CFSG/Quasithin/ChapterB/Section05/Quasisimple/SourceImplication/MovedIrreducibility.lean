module
public import CFSG.Quasithin.ChapterB.Section05.Quasisimple.SourceImplication.IrreducibleBranch.QuotientAction
public import Theory.Representation.BinaryOffender.PerfectMoved

/-!
# Recovering Irr⁺ from the actual moved quotient

For a perfect component, its moved space is generated by its commutators.
Identifying the two literal fixed-subspace quotient conventions then transports
irreducibility back to Irr⁺. This is the converse to the quotient-action bridge
used in B.5.1 and allows block irreducibility to select its irreducible branch.
Source: Aschbacher–Smith B.5.1, printed p.99.
-/
public section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterB.QuasisimpleSource
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  {ρ : Representation (ZMod 2) G V} {C : Subgroup G}

/-- Irreducibility of the literal moved/fixed action gives Irr⁺ on its moved space. -/
theorem MovedSection.irrPlus_of_irreducible [Group.IsPerfect C]
    (s : MovedSection ρ C) (hi : IsIrreducible (s.action.comp C.subtype)) :
    IsIrrPlus ρ C s.space.toSubmodule := by
  have hs : C ≤ subspaceStabilizer ρ s.space.toSubmodule :=
    le_subspaceStabilizer ρ _ (fun c _ v hv => s.space.apply_mem_toSubmodule c hv)
  refine ⟨hs,?_,?_⟩
  · rw [s.space_eq]
    exact subspaceCommutator_idempotent_of_perfect ρ C
  · have hc : s.central.toSubmodule =
        (fixedSpace ρ C).comap s.space.toSubmodule.subtype := by
      rw [s.central_eq]
      ext v
      constructor
      · intro hv g
        exact congrArg Subtype.val (hv g)
      · intro hv g
        exact Subtype.ext (hv g)
    let e : RepEquiv (s.action.comp C.subtype)
        (centralQuotientRepresentation ρ C s.space.toSubmodule hs) :=
      ⟨Submodule.Quotient.equiv _ _ (LinearEquiv.refl (ZMod 2) _)
        (by simpa using hc), by
          intro g
          apply LinearMap.ext
          intro v
          induction v using Submodule.Quotient.induction_on with | _ v => rfl⟩
    exact e.symm.irreducible_of_euqiv hi
end CFSG.Quasithin.ChapterB.QuasisimpleSource
