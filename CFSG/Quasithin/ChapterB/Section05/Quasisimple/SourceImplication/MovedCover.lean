module

public import CFSG.Quasithin.ChapterB.Section05.Quasisimple.SourceImplication.Geometry
public import Theory.Representation.FirstCohomologyDuality
/-!
# The marked central cover of an Irr-plus moved section

Project the original moved space onto its literal central quotient, then
apply the specified action equivalence. Irr-plus makes this projection a
cover: its kernel is fixed and its domain is generated by commutators.
The acting-group and quotient identifications are retained in the map.

Source: Aschbacher--Smith I.1.5, printed p.408; used by MS93 (3.2)(vi).
-/

@[expose] public section
open Subgroup Representation Representation.BinaryOffender Representation.OneCohomology
namespace CFSG.Quasithin.ChapterB.QuasisimpleSource.MovedSection
variable {G H V W : Type*} [Group G] [Group H]
  [AddCommGroup V] [Module (ZMod 2) V] [AddCommGroup W] [Module (ZMod 2) W]
  {ρ : Representation (ZMod 2) G V} {τ : Representation (ZMod 2) H W}
  {L : Subgroup G}
noncomputable def coverAction (s : MovedSection ρ L)
    (e : ActionEquiv (s.action.comp L.subtype) τ) :
    Representation (ZMod 2) H s.space.toSubmodule :=
  s.space.toRepresentation.comp (L.subtype.comp e.groupEquiv.symm.toMonoidHom)
noncomputable def coverProjection (s : MovedSection ρ L)
    (e : ActionEquiv (s.action.comp L.subtype) τ) :
    (coverAction s e).IntertwiningMap τ :=
  (e.linearEquiv.toLinearMap.comp s.central.toSubmodule.mkQ).intertwiningMap_of_isIntertwiningMap
    _ _ (fun g v => by
      simp only [LinearMap.comp_apply]
      change e.linearEquiv ((s.action.comp L.subtype) (e.groupEquiv.symm g)
        (s.central.toSubmodule.mkQ v)) = _
      rw [e.intertwines, e.groupEquiv.apply_symm_apply]
      rfl)
theorem coverProjection_isCover (s : MovedSection ρ L)
    (hi : IsIrrPlus ρ L s.space.toSubmodule)
    (e : ActionEquiv (s.action.comp L.subtype) τ) :
    IsCover (coverProjection s e) := by
  refine ⟨e.linearEquiv.surjective.comp (Submodule.mkQ_surjective _), ?_, ?_⟩
  · intro v hv g
    have hz : s.central.toSubmodule.mkQ v = 0 :=
      e.linearEquiv.injective (hv.trans e.linearEquiv.map_zero.symm)
    have hmem := (Submodule.Quotient.mk_eq_zero _).mp hz
    rw [s.central_eq] at hmem
    exact hmem (e.groupEquiv.symm g)
  · have hm : s.space.toSubmodule ≤
        (Coinvariants.ker (coverAction s e)).map s.space.toSubmodule.subtype := by
      conv_lhs => rw [← hi.choose_spec.1]
      apply Submodule.span_le.mpr
      rintro _ ⟨g,hg,v,hv,rfl⟩
      let a : L := ⟨g,hg⟩
      refine ⟨coverAction s e (e.groupEquiv a) ⟨v,hv⟩ - ⟨v,hv⟩,
        Coinvariants.sub_mem_ker _ _, ?_⟩
      change (ρ (e.groupEquiv.symm (e.groupEquiv a)) v - v) = ρ g v - v
      rw [e.groupEquiv.symm_apply_apply]
    apply top_unique
    intro v _
    obtain ⟨w,hw,he⟩ := hm v.property
    rwa [show w = v from Subtype.ext he] at hw
end CFSG.Quasithin.ChapterB.QuasisimpleSource.MovedSection
