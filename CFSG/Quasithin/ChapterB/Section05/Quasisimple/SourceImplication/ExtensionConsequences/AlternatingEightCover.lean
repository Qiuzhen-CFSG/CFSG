module
public import CFSG.Quasithin.ChapterB.Section05.Quasisimple.SourceImplication.Geometry
public import Theory.Representation.BinaryPermutationEightCover.Recognition

/-!
# Augmentation coordinates on the literal moved A₈ section

An Irr⁺ moved section is generated by its component commutators. Its
projection to the central quotient is a perfect central cover. A nonzero
fixed vector makes the kernel nontrivial, so an A₈ natural marking of
that quotient lifts to the whole seven-dimensional augmentation core.
The same actor marking and the literal central quotient map are preserved.

Source: Aschbacher–Smith B.5.1(2), I.1.5–6 and Lemma 12.3.3,
printed pp.99,408,808. The actual C.2.7 application supplies the original
fixed involution; selecting the A₈ row remains with that application.
-/

@[expose] public noncomputable section
open Subgroup Representation Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterB.QuasisimpleSource.MovedSection
variable {D W : Type*} [Group D] [AddCommGroup W] [Module (ZMod 2) W]
  [FiniteDimensional (ZMod 2) W]
  {ρ : Representation (ZMod 2) D W} {C : Subgroup D}

/-- Coordinates on the full moved section above the supplied natural
quotient marking, with the original projection retained. -/
structure AugmentationCoordinates (s : MovedSection ρ C)
    (a : ActionEquiv (s.action.comp C.subtype) (alternatingNatural 8)) where
  coordinates : s.space.toSubmodule ≃ₗ[ZMod 2] BinaryPermutation.core (Fin 8)
  intertwines : ∀ c : C, ∀ w, coordinates (s.space.toRepresentation c.val w) =
    BinaryPermutation.alternatingCoreRepresentation (Fin 8) (a.groupEquiv c) (coordinates w)
  projection : ∀ w, BinaryPermutation.coreToNatural (Fin 8) (coordinates w) =
    a.linearEquiv (s.central.toSubmodule.mkQ w)

theorem alternatingEight_core_coordinates (s : MovedSection ρ C)
    (hi : IsIrrPlus ρ C s.space.toSubmodule)
    (a : ActionEquiv (s.action.comp C.subtype) (alternatingNatural 8))
    {z : W} (hz : z ∈ s.space.toSubmodule) (hzf : z ∈ fixedSpace ρ C) (hz0 : z ≠ 0) :
    ∃ E : s.space.toSubmodule ≃ₗ[ZMod 2] BinaryPermutation.core (Fin 8),
      (∀ c : C, ∀ w, E (s.space.toRepresentation c.val w) =
        BinaryPermutation.alternatingCoreRepresentation (Fin 8) (a.groupEquiv c) (E w)) ∧
      ∀ w, BinaryPermutation.coreToNatural (Fin 8) (E w) =
        a.linearEquiv (s.central.toSubmodule.mkQ w) := by
  let p := a.linearEquiv.toLinearMap.comp s.central.toSubmodule.mkQ
  have hgen : subspaceCommutator s.space.toRepresentation ⊤ C = ⊤ := by
    let U := subspaceCommutator s.space.toRepresentation ⊤ C
    have hm : s.space.toSubmodule ≤ U.map s.space.toSubmodule.subtype := by
      conv_lhs => rw [← hi.choose_spec.1]
      apply Submodule.span_le.mpr
      rintro _ ⟨g,hg,v,hv,rfl⟩
      exact ⟨s.space.toRepresentation g ⟨v,hv⟩ - ⟨v,hv⟩,
        Submodule.subset_span ⟨g,hg,⟨v,hv⟩,Submodule.mem_top,rfl⟩,rfl⟩
    apply top_unique
    intro v _
    obtain ⟨w,hw,he⟩ := hm v.property
    rwa [show w = v from Subtype.ext he] at hw
  have hker : p.ker ≤ fixedSpace s.space.toRepresentation C := by
    intro w hw
    change a.linearEquiv (s.central.toSubmodule.mkQ w) = 0 at hw
    have he : s.central.toSubmodule.mkQ w = 0 :=
      a.linearEquiv.injective (by simpa only [map_zero] using hw)
    have hm := (Submodule.Quotient.mk_eq_zero _).mp he
    rwa [s.central_eq] at hm
  have hzker : s.central.toSubmodule.mkQ ⟨z,hz⟩ = 0 := by
    apply (Submodule.Quotient.mk_eq_zero _).mpr
    rw [s.central_eq]
    intro c
    exact Subtype.ext (hzf c)
  apply BinaryPermutation.EightCover.core_equiv_of_marked_cover
    s.space.toRepresentation C a.groupEquiv p
  · intro c w
    exact a.intertwines c (s.central.toSubmodule.mkQ w)
  · exact a.linearEquiv.surjective.comp (Submodule.mkQ_surjective _)
  · exact hker
  · exact hgen
  · intro hp
    apply hz0
    have he : p ⟨z,hz⟩ = p 0 := by
      change a.linearEquiv (s.central.toSubmodule.mkQ ⟨z,hz⟩) = _
      rw [hzker,map_zero,map_zero]
    exact congrArg Subtype.val (hp he)

theorem augmentationCoordinates_nonempty (s : MovedSection ρ C)
    (hi : IsIrrPlus ρ C s.space.toSubmodule)
    (a : ActionEquiv (s.action.comp C.subtype) (alternatingNatural 8))
    {z : W} (hz : z ∈ s.space.toSubmodule) (hzf : z ∈ fixedSpace ρ C) (hz0 : z ≠ 0) :
    Nonempty (s.AugmentationCoordinates a) := by
  obtain ⟨E,ha,hq⟩ := s.alternatingEight_core_coordinates hi a hz hzf hz0
  exact ⟨⟨E,ha,hq⟩⟩

end CFSG.Quasithin.ChapterB.QuasisimpleSource.MovedSection
