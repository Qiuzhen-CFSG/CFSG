module

public import CFSG.Quasithin.ChapterB.Section01.ComponentRecognition.KnownFFTypes.Classical.OddLinearUnitary.LinearExclusion.SourceBounds
public import Theory.Representation.CentralizerField
public import Theory.GroupAction.PerfectCentralQuotient
public import Theory.GroupTheory.SolvableOuterQuotient

/-!
# Lifting the small-prime actor generators through the literal central quotient

Conjugation on F*(G)/Z(F*(G)) is faithful on every elementary two-actor:
a square-one element in its kernel centralizes the irreducible component and
is trivial by Schur's lemma. The full kernel is cyclic, since it embeds in
the units of the finite endomorphism field. It centralizes the component,
but need not be central in G. Perfectness recovers the component from its
image in any subgroup generated by lifted actors.

The final theorem lifts a whole elementary actor, including a four-group
with diagonal outer elements. It requires neither containment of that actor
in F*(G) nor absolute irreducibility. The private commutator argument is
adapted from `BinaryOffender.CubicConjugateDimension.CentralCover`.
Source: GM02, Proposition 4.1, manuscript pp.8--9; Aschbacher--Smith K.2.
-/

public section
namespace CFSG.Quasithin.ChapterB.ComponentRecognition.KnownFFTypes.Classical.OddLinearUnitary.LinearExclusion.RankOneSmall.PrimeDegreeEight
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open scoped commutatorElement IsMulCommutative

private theorem lift_abelian_kernel {G D : Type*} [Group G] [Group D]
    (f : G →* D) (H J : Subgroup G) [Group.IsPerfect H]
    [IsMulCommutative f.ker]
    (hc : f.ker ≤ centralizer (H : Set G))
    (h : H.map f ≤ J.map f) : H ≤ J := by
  rw [← commutator_eq_self (H := H)]
  apply commutator_le.mpr
  intro x hx y hy
  obtain ⟨a, ha, hfa⟩ := h (mem_map_of_mem f hx)
  obtain ⟨b, hb, hfb⟩ := h (mem_map_of_mem f hy)
  let k := a * x⁻¹
  let l := b * y⁻¹
  have hk : k ∈ f.ker := by simp only [k, MonoidHom.mem_ker, map_mul, map_inv, hfa, mul_inv_cancel]
  have hl : l ∈ f.ker := by simp only [l, MonoidHom.mem_ker, map_mul, map_inv, hfb, mul_inv_cancel]
  have hkx : Commute k x := (mem_centralizer_iff.mp (hc hk) x hx).symm
  have hky : Commute k y := (mem_centralizer_iff.mp (hc hk) y hy).symm
  have hlx : Commute l x := (mem_centralizer_iff.mp (hc hl) x hx).symm
  have hly : Commute l y := (mem_centralizer_iff.mp (hc hl) y hy).symm
  have hkl : Commute k l := congrArg Subtype.val (mul_comm (⟨k, hk⟩ : f.ker) ⟨l, hl⟩)
  have hkly := hkl.mul_right hky
  have hkcomm : Commute k ⁅x,l*y⁆ := by
    rw [commutatorElement_def]
    exact ((hkx.mul_right hkly).mul_right hkx.inv_right).mul_right hkly.inv_right
  have hlcomm : Commute l ⁅x,y⁆ := by
    rw [commutatorElement_def]
    exact ((hlx.mul_right hly).mul_right hlx.inv_right).mul_right hly.inv_right
  have he : ⁅k*x,l*y⁆ = ⁅x,y⁆ := by
    rw [commutatorElement_mul_left_eq_conj_mul, hkly.commutator_eq,
      mul_one, hkcomm.eq, mul_inv_cancel_right,
      commutatorElement_mul_right_eq_mul_conj, hlx.symm.commutator_eq,
      one_mul, hlcomm.eq, mul_inv_cancel_right]
  have hea : k*x = a := by simp [k]
  have heb : l*y = b := by simp [l]
  rw [hea, heb] at he
  rw [← he, commutatorElement_def]
  exact J.mul_mem (J.mul_mem (J.mul_mem ha hb) (J.inv_mem ha)) (J.inv_mem hb)


universe u v w
variable {G : Type u} {V : Type v} {S : Type w}
  [Group G] [Finite G] [Group S] [AddCommGroup V]
  [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]

/-- Conjugation on the specified model of the component's actual central quotient. -/
@[expose] def quotientAction
    (e : (generalizedFitting G) ⧸ center (generalizedFitting G) ≃* S) :
    G →* MulAut S :=
  (MulAut.centralQuotientAction e).comp (MulAut.conjNormal (H := generalizedFitting G))

variable (ρ : Representation (ZMod 2) G V) (h : SourceAction ρ)
  (e : (generalizedFitting G) ⧸ center (generalizedFitting G) ≃* S)
include h

omit [FiniteDimensional (ZMod 2) V] in
private theorem quotientAction_kernel (g : G) :
    g ∈ (quotientAction e).ker ↔ g ∈ centralizer (generalizedFitting G : Set G) := by
  let : IsQuasisimple (generalizedFitting G) := h.quasisimple
  change MulAut.centralQuotientAction e (MulAut.conjNormal g) = 1 ↔ _
  rw [← map_one (MulAut.centralQuotientAction e),
    (MulAut.centralQuotientAction_injective e).eq_iff]
  change g ∈ (MulAut.conjNormal (H := generalizedFitting G)).ker ↔ _
  rw [MulAut.conjNormal_ker_eq_centralizer]

private theorem quotientAction_cyclic_kernel : IsCyclic (quotientAction e).ker := by
  let : IsIrreducible (ρ.comp (generalizedFitting G).subtype) := h.irreducible
  let σ := ρ.comp (generalizedFitting G).subtype
  let f := quotientAction e
  let C := CentralizerField.linearCentralizer σ
  let : IsCyclic (IntertwiningMap σ σ)ˣ := CentralizerField.units_isCyclic σ
  let : IsCyclic C := isCyclic_of_injective (CentralizerField.centralizerUnitsEquiv σ).toMonoidHom
    (CentralizerField.centralizerUnitsEquiv σ).injective
  let j : f.ker →* C := (ρ.asGroupHom.comp f.ker.subtype).codRestrict C (by
    intro g
    apply mem_centralizer_iff.mpr
    rintro _ ⟨l, rfl⟩
    change ρ.asGroupHom (l : G) * ρ.asGroupHom (g : G) =
      ρ.asGroupHom (g : G) * ρ.asGroupHom (l : G)
    rw [← map_mul, ← map_mul]
    exact congrArg ρ.asGroupHom
      ((quotientAction_kernel ρ h e g).mp g.property l l.property))
  have hj : Function.Injective j := by
    intro x y hx
    apply Subtype.ext
    apply h.faithful
    exact congrArg (fun c : C => c.val.val) hx
  exact isCyclic_of_injective j hj

omit [FiniteDimensional (ZMod 2) V] in
private theorem quotientAction_elementary_injective (A : Subgroup G)
    [IsElementaryAbelian 2 A] :
    Function.Injective ((quotientAction e).subgroupMap A) := by
  apply ((quotientAction e).subgroupMap A).ker_eq_bot_iff.mp
  apply le_bot_iff.mp
  intro a ha
  apply Subtype.ext
  let : IsIrreducible (ρ.comp (generalizedFitting G).subtype) := h.irreducible
  apply BinaryIrreducibleCentralizer.centralizing_square_one_eq_one ρ
    (generalizedFitting G) h.faithful
    (elemPow_eq_one_of_isElementaryAbelian (a : G) a.property)
  apply (quotientAction_kernel ρ h e a).mp
  exact congrArg Subtype.val ha

omit [FiniteDimensional (ZMod 2) V] in
/-- The quotient action preserves the cardinality of the original elementary actor. -/
theorem source_elementary_image_card (A : Subgroup G) [IsElementaryAbelian 2 A] :
    Nat.card (A.map (quotientAction e)) = Nat.card A := by
  let eA := MulEquiv.ofBijective ((quotientAction e).subgroupMap A)
    ⟨quotientAction_elementary_injective ρ h e A,
      (quotientAction e).subgroupMap_surjective A⟩
  exact (Nat.card_congr eA.toEquiv).symm

omit h ρ in
private theorem quotientAction_inner (l : generalizedFitting G) :
    quotientAction e (l : G) = MulAut.conj (e (QuotientGroup.mk' _ l)) := by
  change MulAut.centralQuotientAction e (MulAut.conjNormal (l : G)) = _
  rw [MulAut.conjNormal_val]
  exact MulAut.centralQuotientAction_conj e l

omit h ρ in
private theorem map_conjugate (A : Subgroup G) (g : G) :
    (A.map (MulAut.conj g).toMonoidHom).map (quotientAction e) =
      (A.map (quotientAction e)).map (MulAut.conj (quotientAction e g)).toMonoidHom := by
  rw [map_map, map_map]
  congr 1
  ext a
  simp only [MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom, MulAut.conj_apply,
    map_mul, map_inv]

/-- Inner conjugate generation of the image actor lifts to the original G.
The conjugators are lifted from the specified simple carrier to F*(G). -/
theorem source_lift_actor_generation (A : Subgroup G) {n : ℕ}
    (c : Fin n → S)
    (hgen : (MulAut.conj : S →* MulAut S).range ≤
      ⨆ i, (A.map (quotientAction e)).map
        (MulAut.conj (MulAut.conj (c i))).toMonoidHom) :
    ∃ d : Fin n → G, generalizedFitting G ≤
      ⨆ i, A.map (MulAut.conj (d i)).toMonoidHom := by
  let : IsQuasisimple (generalizedFitting G) := h.quasisimple
  let f := quotientAction e
  let : IsCyclic f.ker := quotientAction_cyclic_kernel ρ h e
  have hsurj : Function.Surjective
      (fun l : generalizedFitting G => e (QuotientGroup.mk' _ l)) :=
    e.surjective.comp (QuotientGroup.mk'_surjective (center (generalizedFitting G)))
  choose d hd using fun i => hsurj (c i)
  refine ⟨fun i => (d i : G), ?_⟩
  apply lift_abelian_kernel f
  · intro x hx
    exact (quotientAction_kernel ρ h e x).mp hx
  · rw [Subgroup.map_iSup]
    dsimp only [f]
    simp_rw [map_conjugate e, quotientAction_inner e, hd]
    apply le_trans _ hgen
    rintro _ ⟨l, hl, rfl⟩
    exact ⟨e (QuotientGroup.mk' _ ⟨l, hl⟩),
      (quotientAction_inner e ⟨l, hl⟩).symm⟩

end CFSG.Quasithin.ChapterB.ComponentRecognition.KnownFFTypes.Classical.OddLinearUnitary.LinearExclusion.RankOneSmall.PrimeDegreeEight
