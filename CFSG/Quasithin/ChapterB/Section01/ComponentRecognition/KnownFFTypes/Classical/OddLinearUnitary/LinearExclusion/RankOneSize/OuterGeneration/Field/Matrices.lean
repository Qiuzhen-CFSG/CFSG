module

public import CFSG.Quasithin.ChapterB.Section01.ComponentRecognition.KnownFFTypes.Classical.OddLinearUnitary.LinearExclusion.RankOneSize.OuterGeneration.Models

/-!
# Four conjugates of the pure coefficient automorphism

Take the PSL₂ images of 1, the upper and lower transvections with parameter a,
and diag(z,z⁻¹). The subgroup generated by their four conjugates of σ contains
σ itself. Multiplying the other conjugates by σ⁻¹ gives the upper and lower
root elements with parameter a - σ(a), and diag(w,w⁻¹), where w = z / σ(z).
Conjugating the upper root by this diagonal element, and the lower root by its
inverse, supplies the parameter w²(a - σ(a)) in both root groups.

If these two parameters additively span the field, the subgroup contains both
full root groups. Transvection generation of SL₂ then gives the literal
canonical PSL₂ range. All four conjugators are images of determinant-one
matrices; no conjugator in an ambient automorphism group is substituted.

Source: Guralnick--Malle, Classification of 2F-modules I, Proposition 4.1,
manuscript pp.8--9, as used in Aschbacher--Smith K.2, printed p.453.
-/

public section
open GorensteinWalter Subgroup Matrix
open scoped MatrixGroups
namespace CFSG.Quasithin.ChapterB.ComponentRecognition.KnownFFTypes.Classical.OddLinearUnitary.LinearExclusion.RankOneSize.OuterGeneration.FieldCalculation
variable {F : Type*} [Field F]

private noncomputable def upper (a : F) : SL(2, F) := SpecialLinearGroup.transvection zero_ne_one a
private noncomputable def lower (a : F) : SL(2, F) := SpecialLinearGroup.transvection one_ne_zero a
private noncomputable def diagonal (z : Fˣ) : SL(2, F) := SpecialLinearGroup.diag2 z z.ne_zero
/-- The literal canonical embedding of PSL₂ in PΓL₂. -/
@[expose] noncomputable def pslInclusion : PSL2 F →* PGammaL2 F :=
  SemidirectProduct.inl.comp ProjectiveSpecialLinearGroup.toPGL
private noncomputable def q : SL(2, F) →* PSL2 F := QuotientGroup.mk' (center _)
private noncomputable def j : SL(2, F) →* PGammaL2 F := pslInclusion.comp q

private lemma upper_add (a b : F) : upper (a + b) = upper a * upper b :=
  SpecialLinearGroup.transvection_add _ _ _
private lemma lower_add (a b : F) : lower (a + b) = lower a * lower b :=
  SpecialLinearGroup.transvection_add _ _ _
private lemma upper_neg (a : F) : upper (-a) = (upper a)⁻¹ :=
  (SpecialLinearGroup.transvection_inv _ _).symm
private lemma lower_neg (a : F) : lower (-a) = (lower a)⁻¹ :=
  (SpecialLinearGroup.transvection_inv _ _).symm

private lemma field_upper (σ : F ≃+* F) (a : F) :
    SpecialLinearGroup.map σ.toRingHom (upper a) = upper (σ a) := by
  ext i k
  fin_cases i <;> fin_cases k <;>
    simp [upper, SpecialLinearGroup.transvection_coe]
private lemma field_lower (σ : F ≃+* F) (a : F) :
    SpecialLinearGroup.map σ.toRingHom (lower a) = lower (σ a) := by
  ext i k
  fin_cases i <;> fin_cases k <;>
    simp [lower, SpecialLinearGroup.transvection_coe]
private lemma field_diagonal (σ : F ≃+* F) (z : Fˣ) :
    SpecialLinearGroup.map σ.toRingHom (diagonal z) =
      diagonal (Units.map σ.toMonoidHom z) := by
  ext i k
  fin_cases i <;> fin_cases k <;>
    simp [diagonal, SpecialLinearGroup.diag2_coe']
private lemma diagonal_mul (z w : Fˣ) : diagonal (z * w) = diagonal z * diagonal w := by
  ext i k
  fin_cases i <;> fin_cases k <;>
    simp [diagonal, SpecialLinearGroup.diag2_coe', mul_comm]
private lemma diagonal_inv (z : Fˣ) : diagonal z⁻¹ = (diagonal z)⁻¹ := by
  simpa only [diagonal, Units.val_inv_eq_inv_val] using
    (SpecialLinearGroup.diag2_inv (z : F) z.ne_zero).symm
private lemma diagonal_conj_upper (z : Fˣ) (a : F) :
    diagonal z * upper a * (diagonal z)⁻¹ = upper ((z : F) ^ 2 * a) := by
  rw [← diagonal_inv]
  ext i k
  fin_cases i <;> fin_cases k <;>
    simp [diagonal, upper, SpecialLinearGroup.diag2_coe',
      SpecialLinearGroup.transvection_coe, Matrix.mul_apply, Fin.sum_univ_two,
      pow_two, mul_assoc, mul_comm, mul_left_comm]
private lemma diagonal_inv_conj_lower (z : Fˣ) (a : F) :
    (diagonal z)⁻¹ * lower a * diagonal z = lower ((z : F) ^ 2 * a) := by
  rw [← diagonal_inv]
  ext i k
  fin_cases i <;> fin_cases k <;>
    simp [diagonal, lower, SpecialLinearGroup.diag2_coe',
      SpecialLinearGroup.transvection_coe, Matrix.mul_apply, Fin.sum_univ_two,
      pow_two, mul_assoc, mul_comm, mul_left_comm]

private lemma conjugate_j (σ : F ≃+* F) (A : SL(2, F)) :
    (SemidirectProduct.inr σ : PGammaL2 F) * j A * (SemidirectProduct.inr σ)⁻¹ =
      j (SpecialLinearGroup.map σ.toRingHom A) := by
  change SemidirectProduct.inr σ *
    SemidirectProduct.inl (ProjectiveSpecialLinearGroup.toPGL (q A)) *
      (SemidirectProduct.inr σ)⁻¹ = _
  rw [← map_inv, ← SemidirectProduct.inl_aut, ← psl2FieldAut_toPGL,
    psl2FieldAut_apply]
  rw [show q A = QuotientGroup.mk' (center _) A from rfl, psl2RingEquiv_mk]
  rfl

private lemma displacement_j (σ : F ≃+* F) (A : SL(2, F)) :
    j A * (SemidirectProduct.inr σ : PGammaL2 F) * (j A)⁻¹ *
      (SemidirectProduct.inr σ)⁻¹ = j (A * (SpecialLinearGroup.map σ.toRingHom A)⁻¹) := by
  rw [map_mul, map_inv, ← conjugate_j]
  group

/-- Four explicit PSL₂ conjugators generate the canonical PSL₂ range whenever
the root displacement and its torus conjugate span the coefficient field. -/
theorem generated_of_parameters (σ : F ≃+* F) (a : F) (z : Fˣ)
    (hspan : ∀ x : F, ∃ n m : ℕ,
      x = n • (a - σ a) + m • (((z : F) / σ z) ^ 2 * (a - σ a))) :
    ∃ c : Fin 4 → PSL2 F, pGammaL2PSLRange F ≤
      Subgroup.closure (Set.range fun i => pslInclusion (c i) * SemidirectProduct.inr σ * (pslInclusion (c i))⁻¹) := by
  let c : Fin 4 → PSL2 F := ![1, q (upper a), q (lower a), q (diagonal z)]
  let H := Subgroup.closure (Set.range fun i => pslInclusion (c i) * SemidirectProduct.inr σ * (pslInclusion (c i))⁻¹)
  have hc (i : Fin 4) : pslInclusion (c i) * SemidirectProduct.inr σ * (pslInclusion (c i))⁻¹ ∈ H :=
    Subgroup.subset_closure ⟨i, rfl⟩
  have hs : (SemidirectProduct.inr σ : PGammaL2 F) ∈ H := by
    simpa [c] using hc 0
  have hd (A : SL(2, F)) (hA : q A ∈ Set.range c) :
      j (A * (SpecialLinearGroup.map σ.toRingHom A)⁻¹) ∈ H := by
    obtain ⟨i, hi⟩ := hA
    rw [← displacement_j]
    exact H.mul_mem (by simpa [j, ← hi] using hc i) (H.inv_mem hs)
  let v := a - σ a
  let w : Fˣ := z / Units.map σ.toMonoidHom z
  have hwval : (w : F) = (z : F) / σ z := by simp [w]
  have hu : j (upper v) ∈ H := by
    have := hd (upper a) ⟨1, rfl⟩
    simpa only [field_upper, ← upper_neg, ← upper_add, ← sub_eq_add_neg] using this
  have hl : j (lower v) ∈ H := by
    have := hd (lower a) ⟨2, rfl⟩
    simpa only [field_lower, ← lower_neg, ← lower_add, ← sub_eq_add_neg] using this
  have hw : j (diagonal w) ∈ H := by
    have := hd (diagonal z) ⟨3, rfl⟩
    simpa only [field_diagonal, ← diagonal_inv, ← diagonal_mul, ← div_eq_mul_inv] using this
  have hu' : j (upper ((w : F) ^ 2 * v)) ∈ H := by
    rw [← diagonal_conj_upper, map_mul, map_mul, map_inv]
    exact H.mul_mem (H.mul_mem hw hu) (H.inv_mem hw)
  have hl' : j (lower ((w : F) ^ 2 * v)) ∈ H := by
    rw [← diagonal_inv_conj_lower, map_mul, map_mul, map_inv]
    exact H.mul_mem (H.mul_mem (H.inv_mem hw) hl) hw
  have root_mem (r : F → SL(2, F)) (hadd : ∀ x y, r (x + y) = r x * r y)
      (hzero : r 0 = 1) (hv : j (r v) ∈ H) (hv' : j (r ((w : F) ^ 2 * v)) ∈ H)
      (x : F) : j (r x) ∈ H := by
    have hn (b : F) (hb : j (r b) ∈ H) (n : ℕ) : j (r (n • b)) ∈ H := by
      induction n with
      | zero => simp only [zero_nsmul, hzero, map_one]; exact H.one_mem
      | succ n ih =>
        rw [succ_nsmul, hadd, map_mul]
        exact H.mul_mem ih hb
    obtain ⟨n, m, hm⟩ := hspan x
    rw [← hwval] at hm
    rw [hm, hadd, map_mul]
    exact H.mul_mem (hn _ hv n) (hn _ hv' m)
  refine ⟨c, ?_⟩
  rintro x ⟨b, rfl⟩
  obtain ⟨A, rfl⟩ := QuotientGroup.mk'_surjective (center (SL(2, F))) b
  change j A ∈ H
  apply Matrix.SL2.transvection_induction (fun A => j A ∈ H) ?_ ?_ A
  · intro i k hik b
    fin_cases i <;> fin_cases k
    · exact False.elim (hik rfl)
    · exact root_mem upper upper_add (by exact SpecialLinearGroup.transvection_coeff_zero _) hu hu' b
    · exact root_mem lower lower_add (by exact SpecialLinearGroup.transvection_coeff_zero _) hl hl' b
    · exact False.elim (hik rfl)
  · intro A B hA hB
    rw [map_mul]
    exact H.mul_mem hA hB
end CFSG.Quasithin.ChapterB.ComponentRecognition.KnownFFTypes.Classical.OddLinearUnitary.LinearExclusion.RankOneSize.OuterGeneration.FieldCalculation
