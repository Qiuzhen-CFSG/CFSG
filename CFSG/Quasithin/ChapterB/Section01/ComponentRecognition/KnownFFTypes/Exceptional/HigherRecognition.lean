module

public import Theory.Representation.BinaryOffender.QuasisimpleNormalizer
public import CFSG.Quasithin.ChapterB.Section01.ComponentRecognition.KnownFFTypes.Exceptional.HigherRecognition.Models

/-!
# Higher exceptional inputs to general binary FF recognition

Pass from the full linear normalizer to the subgroup generated by the actual
component image and one offender. Its generalized Fitting subgroup is proved
to be exactly that image. The original central quotient is transported through
the perfect central cover, so all eight higher exceptional carrier branches
reach the faithful action without altering a quotient or field convention.

The source's remaining representation exclusions split into the even split,
even twisted and odd-field branches. They are not proved in this module.
In particular, the reduction below is not a proof of B.1.13. The original
F-module list has no surviving higher exceptional rows; see
`HigherRecognition/Source.md` for the checked source and its hypotheses.

Source: Aschbacher–Smith B.1.13, printed pp.73–74; Guralnick–Malle,
*Classification of 2F-modules*, I, Proposition 4.6; II, Theorem B, §§8–9.
-/

public section

open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open Representation.BinaryOffender.QuasisimpleNormalizer

namespace CFSG.Quasithin.ChapterB.ComponentRecognition.KnownFFTypes.Exceptional.Higher

variable {L W : Type*} [Group L] [IsQuasisimple L]
  [AddCommGroup W] [Module (ZMod 2) W]
  (σ : Representation (ZMod 2) L W)

/-- The catalogue follows the literal central-cover equivalence to the image. -/
theorem supplement_quotient_cases (hk : σ.ker ≤ center L)
    (hQ : IsHigherQuotient (L ⧸ center L)) (A : Subgroup (linearNormalizer σ)) :
    IsEvenSplitQuotient (component σ A ⧸ center (component σ A)) ∨
      IsEvenTwistedQuotient (component σ A ⧸ center (component σ A)) ∨
      IsOddQuotient (component σ A ⧸ center (component σ A)) :=
  higher_quotient_cases (hQ.of_mulEquiv (cover σ hk A).quotientCenterEquiv.symm)

/-- Apply the proved normalizer reduction to every higher exceptional input.
The resulting module is faithful, irreducible on both the supplement and its
quasisimple F*, and still FF. No representation exclusion is assumed here. -/
theorem exists_higher_ff_supplement [FiniteDimensional (ZMod 2) W]
    [IsIrreducible σ] (hk : σ.ker ≤ center L)
    (hQ : IsHigherQuotient (L ⧸ center L))
    (hff : IsFFModule (normalizerRepresentation σ)) :
    ∃ A : Subgroup (linearNormalizer σ),
      IsOffender (normalizerRepresentation σ) A ∧
      Finite (supplement σ A) ∧
      (component σ A).Normal ∧ IsQuasisimple (component σ A) ∧
      generalizedFitting (supplement σ A) = component σ A ∧
      Function.Injective (linearAction (supplement σ A)) ∧
      IsIrreducible (linearAction (supplement σ A)) ∧
      IsIrreducible ((linearAction (supplement σ A)).comp (component σ A).subtype) ∧
      IsFFModule (linearAction (supplement σ A)) ∧
      Nonempty (L ⧸ center L ≃* component σ A ⧸ center (component σ A)) ∧
      (IsEvenSplitQuotient (component σ A ⧸ center (component σ A)) ∨
        IsEvenTwistedQuotient (component σ A ⧸ center (component σ A)) ∨
        IsOddQuotient (component σ A ⧸ center (component σ A))) := by
  obtain ⟨A, hA⟩ := hff
  exact ⟨A, hA, supplement_finite σ A, component_normal σ A,
    component_quasisimple σ hk A, supplement_fitting σ hk A hA.1.2,
    linearAction_injective _, supplement_irreducible σ A, component_irreducible σ A,
    supplement_ff σ A hA, ⟨(cover σ hk A).quotientCenterEquiv⟩,
    supplement_quotient_cases σ hk hQ A⟩

end CFSG.Quasithin.ChapterB.ComponentRecognition.KnownFFTypes.Exceptional.Higher
