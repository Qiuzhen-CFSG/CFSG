module

public import CFSG.Quasithin.ChapterB.Section01.ComponentRecognition.KnownFFTypes.Sporadic.Leech.HigmanMcLaughlinSuzuki.SourceDegree.AbsoluteWindow.FortyExclusion.AlgebraCertificate.ActionKernel
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.HS.EvenLocalCandidates.SylowCatalogue.Enumeration

/-!
# The universal HS module with a two-subgroup-fixed generating vector

Let R be the literal binary HS algebra, I its five-center norm ideal, and P
the already enumerated order-512 subgroup. The left module R/L, where
L = I + sum of the left ideals R(p - 1), is generated by a P-fixed vector
and is annihilated by I. The fixed-vector relations generate a left ideal;
they are not imposed on every vector as two-sided relations.

A small action whose kernel is nilpotent relative to this universal action
can supply the finite calculation for `NormCertificate`. The two explicit
nilpotence bounds compose in `of_cosetNorm_action`. If the universal module
itself has dimension below forty, `of_cosetNorm_bound` is the direct route.
Neither a dimension bound nor kernel nilpotence is asserted here.

Source application: Guralnick--Malle, Classification of 2F-modules I,
Proposition 5.1, HS paragraph, author-preprint p.16; Aschbacher--Smith K.4,
printed p.457. The existing enumeration checks P on the actual carrier.
-/

@[expose] public section
open scoped BigOperators MonoidAlgebra
namespace CFSG.Quasithin.ChapterB.ComponentRecognition.KnownFFTypes.Sporadic.Leech.HigmanSims.AbsoluteWindow.FortyExclusion.AlgebraCertificate

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]

/-- The already enumerated order-512 subgroup of the actual HS carrier. -/
abbrev twoSubgroup : Subgroup KnownSimple.SporadicName.hs.Carrier :=
  _root_.Sporadic.LeechRelated.HS.EvenLocalCandidates.subgroup

theorem twoSubgroup_isPGroup : IsPGroup 2 twoSubgroup :=
  IsPGroup.of_card
    _root_.Sporadic.LeechRelated.HS.EvenLocalCandidates.SylowCatalogueData.subgroup_card

/-- These are left-ideal relations: P fixes only the generating vector. -/
noncomputable def cosetNormRelations : Ideal BinaryAlgebra :=
  fiveNormIdeal.asIdeal ⊔ Ideal.span (Set.range fun p : twoSubgroup =>
    MonoidAlgebra.single p.val (1 : ZMod 2) - 1)

abbrev CosetNormModule := RestrictScalars (ZMod 2) BinaryAlgebra
  (BinaryAlgebra ⧸ cosetNormRelations)

noncomputable def cosetNormRepresentation :
    Representation (ZMod 2) KnownSimple.SporadicName.hs.Carrier CosetNormModule :=
  Representation.ofModule (BinaryAlgebra ⧸ cosetNormRelations)

noncomputable instance cosetNormModule_finite : Finite CosetNormModule := by
  let : Finite KnownSimple.SporadicName.hs.Carrier :=
    inferInstanceAs (Finite _root_.Sporadic.LeechRelated.HS.Carrier)
  let : Finite BinaryAlgebra := Finite.of_injective
    (fun x : BinaryAlgebra => (x.coeff : KnownSimple.SporadicName.hs.Carrier → ZMod 2))
    (DFunLike.coe_injective.comp MonoidAlgebra.coeff_injective)
  let : Finite (BinaryAlgebra ⧸ cosetNormRelations) :=
    Finite.of_surjective _ (Submodule.Quotient.mk_surjective cosetNormRelations)
  exact Finite.of_injective
    (RestrictScalars.addEquiv (ZMod 2) BinaryAlgebra
      (BinaryAlgebra ⧸ cosetNormRelations))
    (RestrictScalars.addEquiv (ZMod 2) BinaryAlgebra
      (BinaryAlgebra ⧸ cosetNormRelations)).injective

noncomputable def cosetNormVector (x : BinaryAlgebra) : CosetNormModule :=
  (RestrictScalars.addEquiv (ZMod 2) BinaryAlgebra _).symm (Submodule.Quotient.mk x)

theorem cosetNormVector_eq_zero_iff (x : BinaryAlgebra) :
    cosetNormVector x = 0 ↔ x ∈ cosetNormRelations := by
  change (Submodule.Quotient.mk x : BinaryAlgebra ⧸ cosetNormRelations) = 0 ↔ _
  exact Submodule.Quotient.mk_eq_zero cosetNormRelations

theorem cosetNormVector_surjective : Function.Surjective cosetNormVector := by
  intro v
  exact Submodule.Quotient.mk_surjective cosetNormRelations v

theorem cosetNorm_action_vector (x y : BinaryAlgebra) :
    cosetNormRepresentation.asAlgebraHom x (cosetNormVector y) =
      cosetNormVector (x * y) := by
  simp only [cosetNormRepresentation, Representation.ofModule_asAlgebraHom_apply_apply,
    cosetNormVector, AddEquiv.apply_symm_apply]
  rfl

theorem normIdeal_le_cosetKernel :
    fiveNormIdeal ≤ TwoSidedIdeal.ker cosetNormRepresentation.asAlgebraHom := by
  intro x hx
  apply (TwoSidedIdeal.mem_ker _).mpr
  apply LinearMap.ext
  intro v
  obtain ⟨y, rfl⟩ := cosetNormVector_surjective v
  rw [cosetNorm_action_vector, LinearMap.zero_apply]
  exact (cosetNormVector_eq_zero_iff _).mpr
    ((show fiveNormIdeal.asIdeal ≤ cosetNormRelations from le_sup_left)
      (fiveNormIdeal.mul_mem_right x y hx))

theorem cosetNorm_seed_fixed (p : twoSubgroup) :
    cosetNormRepresentation p.val (cosetNormVector 1) = cosetNormVector 1 := by
  have h : cosetNormVector (MonoidAlgebra.single p.val 1 - 1) = 0 :=
    (cosetNormVector_eq_zero_iff _).mpr
      ((show Ideal.span _ ≤ cosetNormRelations from le_sup_right)
        (Ideal.subset_span ⟨p, rfl⟩))
  have he : cosetNormRepresentation.asAlgebraHom (MonoidAlgebra.single p.val 1)
      (cosetNormVector 1) = cosetNormVector (MonoidAlgebra.single p.val 1) := by
    rw [cosetNorm_action_vector, mul_one]
  rw [Representation.asAlgebraHom_single, one_smul] at he
  rw [he]
  change (Submodule.Quotient.mk _ : BinaryAlgebra ⧸ cosetNormRelations) =
    Submodule.Quotient.mk _
  change (Submodule.Quotient.mk (_ - _) : BinaryAlgebra ⧸ cosetNormRelations) = 0 at h
  simpa only [Submodule.Quotient.mk_sub, sub_eq_zero] using h

set_option backward.isDefEq.respectTransparency false in
noncomputable def of_cosetNorm_bound
    (hd : Module.finrank (ZMod 2) CosetNormModule < 40)
    (r : ℕ)
    (hr : ∀ xs : List BinaryAlgebra, xs.length = r →
      (∀ x ∈ xs, cosetNormRepresentation.asAlgebraHom x = 0) →
        xs.prod ∈ fiveNormIdeal) : NormCertificate := by
  letI := RestrictScalars.module (ZMod 2) BinaryAlgebra
    (BinaryAlgebra ⧸ cosetNormRelations)
  exact of_nilpotentAction cosetNormRepresentation (by nlinarith) r hr

/-- A smaller action may retain a nilpotent kernel relative to the universal
fixed-vector action; no semisimplicity of that universal module is needed. -/
noncomputable def of_cosetNorm_action
    (ρ : Representation (ZMod 2) KnownSimple.SporadicName.hs.Carrier V)
    (hd : Module.finrank (ZMod 2) V * Module.finrank (ZMod 2) V < 1600)
    (r s : ℕ)
    (hr : ∀ xs : List BinaryAlgebra, xs.length = r →
      (∀ x ∈ xs, cosetNormRepresentation.asAlgebraHom x = 0) →
        xs.prod ∈ fiveNormIdeal)
    (hs : ∀ xs : List BinaryAlgebra, xs.length = s →
      (∀ x ∈ xs, ρ.asAlgebraHom x = 0) →
        cosetNormRepresentation.asAlgebraHom xs.prod = 0) : NormCertificate :=
  of_nilpotentAction ρ hd (r * s) (by
    intro xs hlen hmem
    exact nilpotent_products_trans fiveNormIdeal
      (TwoSidedIdeal.ker cosetNormRepresentation.asAlgebraHom)
      (TwoSidedIdeal.ker ρ.asAlgebraHom) r s
      (fun ys hy hm => hr ys hy (fun x hx => (TwoSidedIdeal.mem_ker _).mp (hm x hx)))
      (fun ys hy hm => (TwoSidedIdeal.mem_ker _).mpr
        (hs ys hy (fun x hx => (TwoSidedIdeal.mem_ker _).mp (hm x hx))))
      xs hlen (fun x hx => (TwoSidedIdeal.mem_ker _).mpr (hmem x hx)))

end CFSG.Quasithin.ChapterB.ComponentRecognition.KnownFFTypes.Sporadic.Leech.HigmanSims.AbsoluteWindow.FortyExclusion.AlgebraCertificate
