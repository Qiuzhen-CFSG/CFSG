module

public import CFSG.Quasithin.ChapterB.Section01.ComponentRecognition.KnownFFTypes.Sporadic.Leech.HigmanMcLaughlinSuzuki.SourceDegree.TraceField.PowerFusion.Three.CubicCoverage
public import CFSG.Quasithin.ChapterB.Section01.ComponentRecognition.KnownFFTypes.Sporadic.Leech.HigmanMcLaughlinSuzuki.SourceDegree.TraceField.PowerFusion.Three.CentralizerBound.Level6

/-! The exact literal centralizer of the distinguished HS cubic.

The six kernel-checked residual transitions enumerate precisely 360 commuting
permutations.  The final theorem identifies that enumeration with the literal
subgroup `Subgroup.centralizer {cubic}` and hence supplies the divisibility
needed by the odd-three fusion assembly.  Source: ATLAS HSG1-p100B0, class 3A.
-/

@[expose] public section
namespace Sporadic.LeechRelated.HS.ThreePowerFusion
open Theory.GroupTheory
open Sporadic.LeechRelated.HS.OrderCertificate
open CentralizerCertificate Subgroup
open Sporadic.LeechRelated.HS.ThreePowerFusion
set_option maxRecDepth 100000
set_option Elab.async false

private def id0 (i : Fin 360) : Fin 100 :=
  ⟨( >>> (7 * i.val)) % 128 % 100,
    Nat.mod_lt _ (by decide)⟩

private def id1 (i : Fin 360) : Fin 22 :=
  ⟨( >>> (7 * i.val)) % 128 % 22,
    Nat.mod_lt _ (by decide)⟩

private def id2 (i : Fin 360) : Fin 21 :=
  ⟨( >>> (7 * i.val)) % 128 % 21,
    Nat.mod_lt _ (by decide)⟩

private def id3 (i : Fin 360) : Fin 20 :=
  ⟨( >>> (7 * i.val)) % 128 % 20,
    Nat.mod_lt _ (by decide)⟩

private def id4 (i : Fin 360) : Fin 16 :=
  ⟨( >>> (7 * i.val)) % 128 % 16,
    Nat.mod_lt _ (by decide)⟩

private def id5 (i : Fin 360) : Fin 3 :=
  ⟨( >>> (7 * i.val)) % 128 % 3,
    Nat.mod_lt _ (by decide)⟩

private def decodeTag (t : Nat) : Nat :=
  ( >>> (9 * t)) % 512

private def raw6 (i : Fin 360) : Perm :=
  rep0 (id0 i) * rep1 (id1 i) * rep2 (id2 i) * rep3 (id3 i) * rep4 (id4 i) * rep5 (id5 i)

private theorem raw6_eq_prefix6 : ∀ i : Fin 360, raw6 i = prefix6 i := by
  have h : ∀ (i : Fin 360) (x : Fin 100), raw6 i x = prefix6 i x := by
    apply allFin₂
    decide +kernel
  intro i
  exact Equiv.ext (h i)

private theorem rep0_generated (r : Fin 100) : rep0 r ∈ generated := by
  rw [← Sporadic.LeechRelated.HS.NormalizerIndex.H0_eq_generated]
  exact rep0_mem r

private theorem rep1_generated (r : Fin 22) : rep1 r ∈ generated := by
  rw [← Sporadic.LeechRelated.HS.NormalizerIndex.H0_eq_generated]
  exact H1_le (rep1_mem r)

private theorem rep2_generated (r : Fin 21) : rep2 r ∈ generated := by
  rw [← Sporadic.LeechRelated.HS.NormalizerIndex.H0_eq_generated]
  exact H1_le (H2_le (rep2_mem r))

private theorem rep3_generated (r : Fin 20) : rep3 r ∈ generated := by
  rw [← Sporadic.LeechRelated.HS.NormalizerIndex.H0_eq_generated]
  exact H1_le (H2_le (H3_le (rep3_mem r)))

private theorem rep4_generated (r : Fin 16) : rep4 r ∈ generated := by
  rw [← Sporadic.LeechRelated.HS.NormalizerIndex.H0_eq_generated]
  exact H1_le (H2_le (H3_le (H4_le (rep4_mem r))))

private theorem rep5_generated (r : Fin 3) : rep5 r ∈ generated := by
  rw [← Sporadic.LeechRelated.HS.NormalizerIndex.H0_eq_generated]
  exact H1_le (H2_le (H3_le (H4_le (H5_le (rep5_mem r)))))

private theorem raw6_generated (i : Fin 360) : raw6 i ∈ generated := by
  change (((((rep0 (id0 i) * rep1 (id1 i)) * rep2 (id2 i)) * rep3 (id3 i)) *
    rep4 (id4 i)) * rep5 (id5 i)) ∈ generated
  exact generated.mul_mem (generated.mul_mem (generated.mul_mem
    (generated.mul_mem (generated.mul_mem (rep0_generated _) (rep1_generated _))
      (rep2_generated _)) (rep3_generated _)) (rep4_generated _)) (rep5_generated _)

private theorem prefix6_generated (i : Fin 360) : prefix6 i ∈ generated := by
  rw [← raw6_eq_prefix6 i]
  exact raw6_generated i

private theorem prefix6_commute : ∀ i : Fin 360,
    (cubic : Perm) * prefix6 i = prefix6 i * (cubic : Perm) := by
  have h : ∀ (i : Fin 360) (x : Fin 100),
      (cubicTable * prefix6 i) x = (prefix6 i * cubicTable) x := by
    apply allFin₂
    decide +kernel
  intro i
  rw [← cubicTable_eq]
  exact Equiv.ext (h i)

private theorem centralizing_mem (g : Perm) (hg : g ∈ H0)
    (hc : ∀ a ∈ cubicLetters, a * g = g * a) :
    ∃ i : Fin 360, g = prefix6 i := by
  have h0 : ∃ i, ∃ h ∈ H0, g = prefix0 i * h := ⟨0, g, hg, (one_mul g).symm⟩
  have h1 := advance H0 H1 prefix0 prefix1 rep0 color1 base1
    (fun _ hh => decompose gen0 inv0 inv0_spec gen1 inv1 inv1_spec
      rep0 act0 factor0 0 rep0_base step0 hh)
    (fun _ hh => residual1_spec hh)
    (fun i j ht => ⟨next1 i j, transition1 i j ht⟩) hc h0
  have h2 := advance H1 H2 prefix1 prefix2 rep1 color2 base2
    (fun _ hh => decompose gen1 inv1 inv1_spec gen2 inv2 inv2_spec
      rep1 act1 factor1 0 rep1_base step1 hh)
    (fun _ hh => residual2_spec hh)
    (fun i j ht => ⟨next2 i j, transition2 i j ht⟩) hc h1
  have h3 := advance H2 H3 prefix2 prefix3 rep2 color3 base3
    (fun _ hh => decompose gen2 inv2 inv2_spec gen3 inv3 inv3_spec
      rep2 act2 factor2 0 rep2_base step2 hh)
    (fun _ hh => residual3_spec hh)
    (fun i j ht => ⟨next3 i j, transition3 i j ht⟩) hc h2
  have h4 := advance H3 H4 prefix3 prefix4 rep3 color4 base4
    (fun _ hh => decompose gen3 inv3 inv3_spec gen4 inv4 inv4_spec
      rep3 act3 factor3 0 rep3_base step3 hh)
    (fun _ hh => residual4_spec hh)
    (fun i j ht => ⟨next4 i j, transition4 i j ht⟩) hc h3
  have h5 := advance H4 H5 prefix4 prefix5 rep4 color5 base5
    (fun _ hh => decompose gen4 inv4 inv4_spec gen5 inv5 inv5_spec
      rep4 act4 factor4 0 rep4_base step4 hh)
    (fun _ hh => residual5_spec hh)
    (fun i j ht => ⟨next5 i j, transition5 i j ht⟩) hc h4
  have h6 := advance H5 H6 prefix5 prefix6 rep5 color6 base6
    (fun _ hh => decompose gen5 inv5 inv5_spec gen6 inv6 inv6_spec
      rep5 act5 factor5 0 rep5_base step5 hh)
    (fun _ hh => residual6_spec hh)
    (fun i j ht => ⟨next6 i j, transition6 i j ht⟩) hc h5
  obtain ⟨i, h, hh, he⟩ := h6
  have hone : h = 1 := by
    change h ∈ wordSubgroup gen6 inv6 inv6_spec at hh
    rw [wordSubgroup_fin_zero_eq_bot, mem_bot] at hh
    exact hh
  rw [hone, mul_one] at he
  exact ⟨i, he⟩

private def prefixCarrier (i : Fin 360) : cubicCentralizer :=
  ⟨⟨prefix6 i, prefix6_generated i⟩,
    mem_centralizer_singleton_iff.mpr (Subtype.ext (prefix6_commute i).symm)⟩

private def tag (i : Fin 360) : Nat :=
  100 * (prefix6 i 0).val + (prefix6 i 2).val

private theorem decode_tag : ∀ i : Fin 360, decodeTag (tag i) = i.val := by
  apply allFin
  decide +kernel

private theorem tag_injective : Function.Injective tag := by
  intro i j h
  apply Fin.ext
  rw [← decode_tag i, ← decode_tag j, h]

private theorem prefixCarrier_injective : Function.Injective prefixCarrier := by
  intro i j h
  apply tag_injective
  exact congrArg (fun z : cubicCentralizer =>
    100 * ((z.val : Perm) 0).val + ((z.val : Perm) 2).val) h

private theorem carrier_commutation (x y : Carrier) (h : x * y = y * x) :
    (x : Perm) * (y : Perm) = (y : Perm) * (x : Perm) :=
  congrArg (fun z : Carrier => (z : Perm)) h

private theorem prefixCarrier_surjective : Function.Surjective prefixCarrier := by
  intro g
  have hg : (g.val : Perm) ∈ H0 := generated_le g.val.property
  have hc0 : (g : Carrier) * cubic = cubic * (g : Carrier) :=
    (mem_centralizer_singleton_iff (g := cubic) (k := (g : Carrier))).mp g.property
  have hc1 := carrier_commutation (g : Carrier) cubic hc0
  have hc : ∀ a ∈ cubicLetters, a * (g.val : Perm) = (g.val : Perm) * a := by
    intro a ha
    have he : a = (cubic : Perm) := (List.mem_singleton.mp ha).trans cubicTable_eq
    calc
      a * (g.val : Perm) = (cubic : Perm) * (g.val : Perm) :=
        congrArg (fun p : Perm => p * (g.val : Perm)) he
      _ = (g.val : Perm) * (cubic : Perm) := hc1.symm
      _ = (g.val : Perm) * a := congrArg (fun p : Perm => (g.val : Perm) * p) he.symm
  obtain ⟨i, hi⟩ := centralizing_mem (g.val : Perm) hg hc
  refine ⟨i, ?_⟩
  apply Subtype.ext
  apply Subtype.ext
  exact hi.symm

/-- The literal centralizer of `cubic` has order exactly 360. -/
public theorem cubicCentralizer_card : Nat.card cubicCentralizer = 360 := by
  let e : Fin 360 ≃ cubicCentralizer := Equiv.ofBijective prefixCarrier
    ⟨prefixCarrier_injective, prefixCarrier_surjective⟩
  rw [← Nat.card_congr e]
  norm_num

/-- The requested divisibility bound for the literal cubic centralizer. -/
public theorem cubicCentralizer_card_dvd : Nat.card cubicCentralizer ∣ 360 := by
  simp only [cubicCentralizer_card, dvd_refl]

end Sporadic.LeechRelated.HS.ThreePowerFusion
