module

public import CFSG.Quasithin.ChapterB.Section01.ComponentRecognition.KnownFFTypes.Sporadic.Leech.HigmanMcLaughlinSuzuki.SourceDegree.AbsoluteWindow.FixedSpace.Inputs
public import Theory.Representation.HigmanSims.LargeModels.ScalarExtension
import Mathlib.Tactic.FinCases

/-!
# Assembly of the seven larger HS models

Four absolutely irreducible binary models, a trace-separated finite-field
pair of degree 896, and an absolutely irreducible binary model of degree 1408
give the exact seven-model input to modular saturation. Scalar extension
preserves irreducibility and the separating trace. Dimension excludes every
other equivalence. The intrinsic and chapter carriers agree definitionally:
both are the subgroup generated by the published HSG1-p100B0 permutations.

The three finite construction inputs remain explicit. This conditional
assembly does not assert `largeModelsExist`; its model calculations must
still be supplied. The result is the precise `LargeModelsExist` argument of
`fiveCenterFixedFreeInWindow_of_binary_model_and_saturation`.

Sources: Guralnick--Malle, *Classification of 2F-modules I*, Proposition 5.1,
HS paragraph, preprint p.16; the HS characteristic-two ATLAS candidates
listed in `Theory.Representation.HigmanSims.LargeModels.Inputs`.
-/

public section
namespace CFSG.Quasithin.ChapterB.ComponentRecognition.KnownFFTypes.Sporadic.Leech.HigmanSims.AbsoluteWindow.FixedSpace

open Representation.HigmanSims.LargeModels
universe v

private theorem largeDegree_collision {i j : Fin 7} (hij : i ≠ j)
    (hd : largeDegree i = largeDegree j) :
    (i = 3 ∧ j = 4) ∨ (i = 4 ∧ j = 3) := by
  have h : ∀ i j : Fin 7, i ≠ j → largeDegree i = largeDegree j →
      (i = 3 ∧ j = 4) ∨ (i = 4 ∧ j = 3) := by decide
  exact h i j hij hd

/-- Finite-field constructions supply all seven irreducible actions and
their inequivalence over every algebraically closed characteristic-two field.
The two degree-896 actions are separated by their producer's trace witness. -/
theorem largeModelsExist_of_finite_models
    (hbinary : BinaryModelsExist) (hpair : TraceSeparatedPairExists)
    (hrestricted : RestrictedModelExists) : LargeModelsExist.{v} := by
  intro hs F _ _ _
  obtain ⟨σ, hi⟩ := binaryModels_over_field hbinary hs F
  obtain ⟨τ₁, τ₂, hi₁, hi₂, hne⟩ := traceSeparatedPair_over_field hpair hs F
  obtain ⟨υ, hiυ⟩ := restrictedModel_over_field hrestricted hs F
  let ρ : ∀ i, Representation F KnownSimple.SporadicName.hs.Carrier
      (Fin (largeDegree i) → F) := fun i => match i with
    | ⟨0, _⟩ => σ 0
    | ⟨1, _⟩ => σ 1
    | ⟨2, _⟩ => σ 2
    | ⟨3, _⟩ => τ₁
    | ⟨4, _⟩ => τ₂
    | ⟨5, _⟩ => σ 3
    | ⟨6, _⟩ => υ
  refine ⟨ρ, ?_, ?_⟩
  · intro i
    fin_cases i
    · exact hi 0
    · exact hi 1
    · exact hi 2
    · exact hi₁
    · exact hi₂
    · exact hi 3
    · exact hiυ
  · intro i j hij
    refine ⟨fun e => ?_⟩
    have hd := e.toLinearEquiv.finrank_eq
    simp only [Module.finrank_fintype_fun_eq_card, Fintype.card_fin] at hd
    rcases largeDegree_collision hij hd with ⟨rfl, rfl⟩ | ⟨rfl, rfl⟩
    · exact hne.false e
    · exact hne.false e.symm

end CFSG.Quasithin.ChapterB.ComponentRecognition.KnownFFTypes.Sporadic.Leech.HigmanSims.AbsoluteWindow.FixedSpace
