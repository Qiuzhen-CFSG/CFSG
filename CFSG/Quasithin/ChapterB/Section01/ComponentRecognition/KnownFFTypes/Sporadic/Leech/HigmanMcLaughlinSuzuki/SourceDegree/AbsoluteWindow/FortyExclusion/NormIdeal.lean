module

public import CFSG.Quasithin.ChapterB.Section01.ComponentRecognition.KnownFFTypes.Sporadic.Leech.HigmanMcLaughlinSuzuki.SourceDegree.AbsoluteWindow.Contracts
public import Mathlib.RingTheory.TwoSidedIdeal.Operations
public import Mathlib.RingTheory.TwoSidedIdeal.Kernel

/-!
# A finite algebra route to excluding absolute HS degree forty

The norm of the literal five-center annihilates every module satisfying the
fixed-space hypothesis. If a two-sided ideal is nilpotent modulo the norm ideal,
it also annihilates every irreducible such module. A spanning family for the
quotient by that ideal therefore spans the representation image over every
characteristic-two field. Absolute irreducibility makes this the full
endomorphism algebra, whose dimension is the square of the module dimension.

`NormCertificate` specifies the remaining finite calculation in the binary
algebra of the actual degree-100 HS carrier. It permits a nilpotent kernel;
semisimplicity of the entire norm quotient is not assumed. No certificate is
constructed here. The sibling `FortyExclusion` module applies the proved bound
to the exact source contract, conditional on constructing this certificate.

Source: Guralnick--Malle, *Classification of 2F-modules I*, Proposition 5.1,
HS paragraph, author-preprint p.16; Hiss--Malle, corrected low-degree table;
Aschbacher--Smith K.4, printed p.457. This algebra argument reduces the remaining
character calculation to a finite certificate rather than assuming that table.
-/

@[expose] public section
open scoped BigOperators MonoidAlgebra
namespace CFSG.Quasithin.ChapterB.ComponentRecognition.KnownFFTypes.Sporadic.Leech.HigmanSims.AbsoluteWindow
namespace FortyExclusion

/-- The group algebra of the actual HS carrier over the prime field. -/
abbrev BinaryAlgebra := (ZMod 2)[KnownSimple.SporadicName.hs.Carrier]

/-- The sum over the actual image of the extraspecial five-subgroup center. -/
noncomputable def fiveNorm : BinaryAlgebra := by
  classical
  let : Finite KnownSimple.SporadicName.hs.Carrier :=
    inferInstanceAs (Finite _root_.Sporadic.LeechRelated.HS.Carrier)
  let := Fintype.ofFinite fiveCenter
  exact ∑ z : fiveCenter, MonoidAlgebra.single z.val 1

/-- The two-sided ideal generated by the marked center norm. -/
noncomputable def fiveNormIdeal : TwoSidedIdeal BinaryAlgebra :=
  TwoSidedIdeal.span {fiveNorm}

variable {K W : Type*} [Field K] [CharP K 2]
  [AddCommGroup W] [Module K W]

/-- Binary group-algebra elements act by extending their coefficients to K. -/
noncomputable def binaryAction
    (τ : Representation K KnownSimple.SporadicName.hs.Carrier W) :
    BinaryAlgebra →+* Module.End K W :=
  τ.asAlgebraHom.toRingHom.comp
    (MonoidAlgebra.mapRingHom _ (ZMod.castHom (dvd_refl 2) K))

@[simp] theorem binaryAction_single
    (τ : Representation K KnownSimple.SporadicName.hs.Carrier W)
    (g : KnownSimple.SporadicName.hs.Carrier) (c : ZMod 2) :
    binaryAction τ (MonoidAlgebra.single g c) =
      (ZMod.castHom (dvd_refl 2) K c) • τ g := by
  simp [binaryAction, MonoidAlgebra.mapRingHom_single]

/-- The norm image consists of fixed vectors, hence vanishes under the permitted hypothesis. -/
theorem fiveNorm_action_eq_zero
    (τ : Representation K KnownSimple.SporadicName.hs.Carrier W)
    (hfix : Representation.invariants (τ.comp fiveCenter.subtype) = ⊥) :
    binaryAction τ fiveNorm = 0 := by
  classical
  let : Finite KnownSimple.SporadicName.hs.Carrier :=
    inferInstanceAs (Finite _root_.Sporadic.LeechRelated.HS.Carrier)
  let := Fintype.ofFinite fiveCenter
  have he : binaryAction τ fiveNorm = ∑ z : fiveCenter, τ z.val := by
    simp [fiveNorm]
  rw [he]
  apply LinearMap.ext
  intro v
  have hv : (∑ z : fiveCenter, τ z.val) v ∈
      Representation.invariants (τ.comp fiveCenter.subtype) := by
    intro g
    change τ g.val ((∑ z : fiveCenter, τ z.val) v) = _
    simp only [LinearMap.sum_apply, map_sum]
    calc
      ∑ z : fiveCenter, τ g.val (τ z.val v) =
          ∑ z : fiveCenter, τ (g * z).val v := by
        apply Finset.sum_congr rfl
        intro z _
        simp [map_mul, Module.End.mul_apply]
      _ = ∑ z : fiveCenter, τ z.val v :=
        Equiv.sum_comp (Equiv.mulLeft g) (fun z : fiveCenter => τ z.val v)
  simpa only [hfix, Submodule.mem_bot, LinearMap.zero_apply] using hv

/-- The fixed-space hypothesis annihilates the whole literal norm ideal. -/
theorem fiveNormIdeal_le_kernel
    (τ : Representation K KnownSimple.SporadicName.hs.Carrier W)
    (hfix : Representation.invariants (τ.comp fiveCenter.subtype) = ⊥) :
    fiveNormIdeal ≤ TwoSidedIdeal.ker (binaryAction τ) := by
  apply TwoSidedIdeal.span_le.mpr
  rintro x (rfl : x = fiveNorm)
  exact (TwoSidedIdeal.mem_ker (binaryAction τ)).mpr (fiveNorm_action_eq_zero τ hfix)

/-- The remaining calculation takes place entirely in the finite binary group
algebra. Products of a fixed number of elements of `ideal` must belong to the
literal norm ideal, and fewer than 1600 actual group elements must span modulo
`ideal`. There is no representation-theoretic conclusion among these fields. -/
structure NormCertificate where
  ideal : TwoSidedIdeal BinaryAlgebra
  exponent : ℕ
  nilpotent : ∀ xs : List BinaryAlgebra, xs.length = exponent →
    (∀ x ∈ xs, x ∈ ideal) → xs.prod ∈ fiveNormIdeal
  size : ℕ
  size_lt : size < 1600
  basis : Fin size → KnownSimple.SporadicName.hs.Carrier
  spanning : ∀ g : KnownSimple.SporadicName.hs.Carrier,
    ∃ c : Fin size → ZMod 2,
      MonoidAlgebra.single g 1 -
        ∑ i, MonoidAlgebra.single (basis i) (c i) ∈ ideal

private theorem kernel_le_of_nilpotent
    (τ : Representation K KnownSimple.SporadicName.hs.Carrier W)
    [τ.IsIrreducible] (J : TwoSidedIdeal BinaryAlgebra) (n : ℕ)
    (hn : ∀ xs : List BinaryAlgebra, xs.length = n →
      (∀ x ∈ xs, x ∈ J) → binaryAction τ xs.prod = 0) :
    J ≤ TwoSidedIdeal.ker (binaryAction τ) := by
  let U : Subrepresentation τ := {
    toSubmodule := {
      carrier := {v | ∀ x ∈ J, binaryAction τ x v = 0}
      zero_mem' := by simp
      add_mem' := by intro v w hv hw x hx; simp [map_add, hv x hx, hw x hx]
      smul_mem' := by intro c v hv x hx; simp [map_smul, hv x hx] }
    apply_mem_toSubmodule := by
      intro g v hv x hx
      have he := hv (x * MonoidAlgebra.single g 1) (J.mul_mem_right _ _ hx)
      simpa only [map_mul, binaryAction_single, map_one, one_smul,
        Module.End.mul_apply] using he }
  rcases eq_bot_or_eq_top U with hU | hU
  · have kill (v : W) (hv : ∀ x ∈ J, binaryAction τ x v = 0) : v = 0 := by
      have hm : v ∈ U := hv
      rwa [hU] at hm
    induction n with
    | zero =>
      have he := hn [] rfl (by simp)
      simp only [List.prod_nil, map_one] at he
      intro x hx
      apply (TwoSidedIdeal.mem_ker (binaryAction τ)).mpr
      calc
        binaryAction τ x = binaryAction τ x * 1 := (mul_one _).symm
        _ = 0 := by rw [he, mul_zero]
    | succ n ih =>
      apply ih
      intro xs hlen hmem
      apply LinearMap.ext
      intro v
      apply kill
      intro x hx
      have he := hn (x :: xs) (by simp [hlen]) (by simpa using And.intro hx hmem)
      exact LinearMap.congr_fun (by simpa only [List.prod_cons, map_mul] using he) v
  · intro x hx
    apply (TwoSidedIdeal.mem_ker (binaryAction τ)).mpr
    apply LinearMap.ext
    intro v
    have hv : v ∈ U := hU.symm ▸ (show v ∈ (⊤ : Subrepresentation τ) from by trivial)
    exact hv x hx

/-- Nilpotence modulo the norm ideal kills the certificate ideal on a simple module. -/
theorem certificateIdeal_le_kernel
    (C : NormCertificate)
    (τ : Representation K KnownSimple.SporadicName.hs.Carrier W)
    [τ.IsIrreducible]
    (hfix : Representation.invariants (τ.comp fiveCenter.subtype) = ⊥) :
    C.ideal ≤ TwoSidedIdeal.ker (binaryAction τ) :=
  kernel_le_of_nilpotent τ C.ideal C.exponent
    (fun xs hlen hmem => (TwoSidedIdeal.mem_ker (binaryAction τ)).mp
      (fiveNormIdeal_le_kernel τ hfix (C.nilpotent xs hlen hmem)))

omit [CharP K 2] in
private theorem span_eq_top_of_absolutelyIrreducible
    [FiniteDimensional K W]
    (τ : Representation K KnownSimple.SporadicName.hs.Carrier W)
    (hi : τ.IsAbsolutelyIrreducible) :
    Submodule.span K (Set.range τ) = ⊤ := by
  let := hi
  let := Representation.IsAbsolutelyIrreducible.irreducible_of_isAbsolutelyIrreducible τ
  have hd := Representation.jacobson_density_surjective_rep τ
    ((Representation.isAbsolutelyIrreducible_iff_surjective τ).mp hi)
  have heq := Algebra.adjoin_eq_span K (Set.range τ)
  rw [← MonoidHom.coe_mrange τ, Submonoid.closure_eq] at heq
  rw [MonoidHom.coe_mrange, hd] at heq
  exact heq.symm

/-- The actual consumer of the algebra certificate: absolute density bounds the squared degree. -/
theorem finrank_sq_le_certificate_size
    [FiniteDimensional K W] (C : NormCertificate)
    (τ : Representation K KnownSimple.SporadicName.hs.Carrier W)
    (hi : τ.IsAbsolutelyIrreducible)
    (hfix : Representation.invariants (τ.comp fiveCenter.subtype) = ⊥) :
    Module.finrank K W * Module.finrank K W ≤ C.size := by
  classical
  let := hi
  let := Representation.IsAbsolutelyIrreducible.irreducible_of_isAbsolutelyIrreducible τ
  have hk := certificateIdeal_le_kernel C τ hfix
  have hspan : Submodule.span K (Set.range (fun i => τ (C.basis i))) = ⊤ := by
    apply top_unique
    rw [← span_eq_top_of_absolutelyIrreducible τ hi]
    apply Submodule.span_le.mpr
    rintro _ ⟨g, rfl⟩
    obtain ⟨c, hc⟩ := C.spanning g
    have he := (TwoSidedIdeal.mem_ker (binaryAction τ)).mp (hk hc)
    simp only [map_sub, map_sum, binaryAction_single, map_one, one_smul, sub_eq_zero] at he
    rw [he]
    apply Submodule.sum_mem
    intro i _
    exact Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  have hd := finrank_le_of_span_eq_top hspan
  simpa only [Module.finrank_linearMap, Fintype.card_fin] using hd

end FortyExclusion
end CFSG.Quasithin.ChapterB.ComponentRecognition.KnownFFTypes.Sporadic.Leech.HigmanSims.AbsoluteWindow
