namespace Sporadic.LeechRelated.HS.ThreePowerFusion.CentralizerCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option Elab.async false

def next4 (i : Fin 2160) (j : Fin 20) : Fin 1080 :=
  ⟨( >>> (11 * (20 * i.val + j.val))) % 2048 % 1080,
    Nat.mod_lt _ (by decide)⟩

private theorem transition4_block0 : ∀ (i : Fin 30) (j : Fin 20),
    screen color4 base4 (prefix3 (finProdFinEquiv ((0 : Fin 72), i)) * rep3 j) = true →
    prefix3 (finProdFinEquiv ((0 : Fin 72), i)) * rep3 j = prefix4 (next4 (finProdFinEquiv ((0 : Fin 72), i)) j) := by
  apply transition_check
  decide +kernel

