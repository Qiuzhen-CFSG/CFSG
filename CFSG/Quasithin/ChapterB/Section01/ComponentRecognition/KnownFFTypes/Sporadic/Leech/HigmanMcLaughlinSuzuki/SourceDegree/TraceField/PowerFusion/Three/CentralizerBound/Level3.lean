theorem transition3 : ∀ (i : Fin 360) (j : Fin 21),
    screen color3 base3 (prefix2 i * rep2 j) = true →
    prefix2 i * rep2 j = prefix3 (next3 i j) := by
  intro i
  obtain ⟨⟨b, h⟩, rfl⟩ := (@finProdFinEquiv 12 30).surjective i
  fin_cases b
  · exact transition3_block0 h
  · exact transition3_block1 h
  · exact transition3_block2 h
  · exact transition3_block3 h
  · exact transition3_block4 h
  · exact transition3_block5 h
  · exact transition3_block6 h
  · exact transition3_block7 h
  · exact transition3_block8 h
  · exact transition3_block9 h
  · exact transition3_block10 h
  · exact transition3_block11 h

