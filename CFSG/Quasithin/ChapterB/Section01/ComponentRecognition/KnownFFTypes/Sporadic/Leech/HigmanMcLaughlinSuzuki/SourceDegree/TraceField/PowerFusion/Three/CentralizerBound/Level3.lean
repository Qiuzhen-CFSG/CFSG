import Mathlib.Tactic.FinCases

/-! Exhaustive, blockwise transitions for HS cubic-centralizer stage 3.
Source: ATLAS HSG1-p100B0 and the checked HS OrderBound chain.
The blocks cover all input indices through `finProdFinEquiv`. -/

@[expose] public section
namespace Sporadic.LeechRelated.HS.ThreePowerFusion.CentralizerCertificate
open Theory.GroupTheory OrderCertificate
set_option maxRecDepth 100000
set_option Elab.async false

def next3 (i : Fin 360) (j : Fin 21) : Fin 2160 :=
  ⟨( >>> (12 * (21 * i.val + j.val))) % 4096 % 2160,
    Nat.mod_lt _ (by decide)⟩

private theorem transition3_block0 : ∀ (i : Fin 30) (j : Fin 21),
    screen color3 base3 (prefix2 (finProdFinEquiv ((0 : Fin 12), i)) * rep2 j) = true →
    prefix2 (finProdFinEquiv ((0 : Fin 12), i)) * rep2 j = prefix3 (next3 (finProdFinEquiv ((0 : Fin 12), i)) j) := by
  apply transition_check
  decide +kernel

