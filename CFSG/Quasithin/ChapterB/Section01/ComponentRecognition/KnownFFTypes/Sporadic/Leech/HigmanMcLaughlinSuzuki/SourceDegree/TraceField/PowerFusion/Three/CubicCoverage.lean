module

public import CFSG.Quasithin.ChapterB.Section01.ComponentRecognition.KnownFFTypes.Sporadic.Leech.HigmanMcLaughlinSuzuki.SourceDegree.TraceField.PowerFusion.Three.Words
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.HS.AutomorphismNormalizerIndex.CarrierOrder
public import Theory.GroupTheory.PrimeRankFixedJoin
public import Theory.GroupTheory.PrimeCyclicCoverage
import Mathlib.Tactic.IntervalCases

/-!
# The cubic class of the literal HS carrier

The two explicit commuting cubics generate an elementary abelian group of
order nine. The certified carrier order makes it Sylow. Sylow conjugacy and
the eight checked word conjugators therefore cover every cubic element.
The same subgroup excludes order nine, including nine as a divisor of an
element order. These facts feed the odd-order fusion reduction in `Three`.

Source: ATLAS HSG1-p100B0, class 3A; the nine-group witnesses are those of
`HS.ThreeRank`, with complete fusion words in the sibling `Words` module.
-/

@[expose] public section
namespace Sporadic.LeechRelated.HS.ThreePowerFusion
open Subgroup
open scoped Pointwise

/-- The actual centralizer of the distinguished cubic in the HS carrier. -/
abbrev cubicCentralizer : Subgroup Carrier := centralizer ({cubic} : Set Carrier)

/-- The explicit nine-group generated by the two commuting cubic words. -/
def nineGroup : Subgroup Carrier := zpowers cubic ⊔ zpowers cubicMate

private theorem mate_not_mem : cubicMate ∉ zpowers cubic := by
  intro hm
  rw [mem_zpowers_iff_mem_range_orderOf, cubic_order] at hm
  obtain ⟨k, hk, he⟩ := Finset.mem_image.mp hm
  have hk' : k < 3 := Finset.mem_range.mp hk
  have hh := congrArg (fun z : Carrier => inclusion z 0) he
  interval_cases k <;>
    simp only [pow_zero, pow_one, map_one, Equiv.Perm.one_apply,
      witness_images.1, witness_images.2.1, witness_images.2.2] at hh <;> contradiction

private theorem mate_ne_one : cubicMate ≠ 1 := by
  intro h
  apply mate_not_mem
  rw [h]
  exact (zpowers cubic).one_mem

private theorem mate_order : orderOf cubicMate = 3 :=
  orderOf_eq_prime cubicMate_cube mate_ne_one

private theorem cubic_centralized : zpowers cubic ≤ centralizer ({cubicMate} : Set Carrier) := by
  rw [zpowers_le]
  exact mem_centralizer_singleton_iff.mpr cubic_commute.eq

private theorem mate_centralizes : zpowers cubicMate ≤ centralizer (zpowers cubic : Set Carrier) := by
  apply zpowers_le.mpr
  intro e he
  exact mem_centralizer_singleton_iff.mp (cubic_centralized he)

/-- The displayed nine-group has exactly nine elements. -/
theorem nineGroup_card : Nat.card nineGroup = 9 := by
  let : IsElementaryAbelian 3 (zpowers cubic) :=
    IsElementaryAbelian.zpowers_of_pow_eq_one cubic_cube
  exact (IsElementaryAbelian.fixed_join_card (n := 1) (zpowers cubic) cubicMate
    mate_order ((zpowers cubic).disjoint_zpowers_of_prime_order_not_mem
      cubicMate mate_order mate_not_mem) cubic_centralized
    (by rw [Nat.card_zpowers, cubic_order]; rfl)).2

/-- The index of the explicit nine-group is prime to three. -/
theorem nineGroup_index : ¬ 3 ∣ nineGroup.index := by
  have h := nineGroup.card_mul_index
  rw [nineGroup_card, NormalizerIndex.card_carrier] at h
  have hi : nineGroup.index = 4928000 := by omega
  rw [hi]
  decide

/-- The explicit elementary nine-group is a Sylow three-subgroup of HS. -/
def sylowThree : Sylow 3 Carrier := by
  exact (IsPGroup.of_card (p := 3) (n := 2) nineGroup_card).toSylow nineGroup_index

private theorem nineGroup_words (z : Carrier) (hz : z ∈ nineGroup) :
    ∃ i j : Fin 3, z = cubic ^ i.val * cubicMate ^ j.val := by
  have hprod : z ∈ (zpowers cubic : Set Carrier) * (zpowers cubicMate : Set Carrier) := by
    rw [← coe_mul_of_right_le_normalizer_left _ _
      (mate_centralizes.trans (centralizer_le_normalizer _))]
    exact hz
  obtain ⟨u, hu, v, hv, huv⟩ := hprod
  change u ∈ zpowers cubic at hu
  change v ∈ zpowers cubicMate at hv
  rw [mem_zpowers_iff_mem_range_orderOf, cubic_order] at hu
  rw [mem_zpowers_iff_mem_range_orderOf, mate_order] at hv
  obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp hu
  obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hv
  exact ⟨⟨i, Finset.mem_range.mp hi⟩, ⟨j, Finset.mem_range.mp hj⟩, huv.symm⟩

private theorem nineGroup_cube (z : Carrier) (hz : z ∈ nineGroup) : z ^ 3 = 1 := by
  obtain ⟨i, j, rfl⟩ := nineGroup_words z hz
  rw [(cubic_commute.pow_pow _ _).mul_pow, ← pow_mul, Nat.mul_comm i.val,
    pow_mul, cubic_cube, one_pow, ← pow_mul, Nat.mul_comm j.val,
    pow_mul, cubicMate_cube, one_pow, mul_one]

private theorem conjugate_into_nineGroup (z : Carrier) (hz : IsPGroup 3 (zpowers z)) :
    ∃ c : Carrier, c * z * c⁻¹ ∈ nineGroup := by
  obtain ⟨Q, hQ⟩ := hz.exists_le_sylow
  obtain ⟨c, hc⟩ := MulAction.exists_smul_eq Carrier Q sylowThree
  refine ⟨c, ?_⟩
  change c * z * c⁻¹ ∈ sylowThree
  rw [← hc]
  change c * z * c⁻¹ ∈ (↑(c • Q) : Set Carrier)
  rw [Sylow.coe_smul]
  exact ⟨z, hQ (mem_zpowers z), rfl⟩

/-- Every order-three element is in the one explicitly certified cubic class. -/
theorem cubic_class (z : Carrier) (hz : orderOf z = 3) : IsConj cubic z := by
  obtain ⟨c, hc⟩ := conjugate_into_nineGroup z
    (IsPGroup.of_card (by rw [Nat.card_zpowers, hz]; rfl : Nat.card (zpowers z) = 3 ^ 1))
  obtain ⟨i, j, hij⟩ := nineGroup_words _ hc
  have hn : i ≠ 0 ∨ j ≠ 0 := by
    by_contra h
    push Not at h
    rcases h with ⟨rfl, rfl⟩
    have hz1 : z = 1 := by
      have he : (MulAut.conj c) z = 1 := by simpa using hij
      exact (MulAut.conj c).injective (he.trans (map_one _).symm)
    simp [hz1] at hz
  have h : IsConj cubic (c * z * c⁻¹) := hij ▸ cubic_fusion i j hn
  exact h.trans (isConj_iff.mpr ⟨c, rfl⟩).symm

/-- All order-three elements of the literal carrier are conjugate to their squares. -/
theorem orderThree_square (z : Carrier) (hz : orderOf z = 3) : IsConj z (z ^ 2) :=
  ((cubic_class z hz).symm.trans cubic_square).trans ((cubic_class z hz).pow 2)

/-- There are no elements of order nine in the literal carrier. -/
theorem order_ne_nine (z : Carrier) : orderOf z ≠ 9 := by
  intro hz
  obtain ⟨c, hc⟩ := conjugate_into_nineGroup z
    (IsPGroup.of_card (by rw [Nat.card_zpowers, hz]; rfl : Nat.card (zpowers z) = 3 ^ 2))
  have hp : (c * z * c⁻¹) ^ 3 = 1 := nineGroup_cube _ hc
  have hd := orderOf_dvd_of_pow_eq_one hp
  have ho : orderOf (c * z * c⁻¹) = 9 :=
    (MulEquiv.orderOf_eq (MulAut.conj c) z).trans hz
  rw [ho] at hd
  norm_num at hd

/-- Nine does not divide any element order. -/
theorem nine_not_dvd_order (z : Carrier) : ¬ 9 ∣ orderOf z := by
  intro h
  exact order_ne_nine (z ^ (orderOf z / 9))
    (orderOf_pow_orderOf_div (orderOf_pos z).ne' h)

end Sporadic.LeechRelated.HS.ThreePowerFusion
