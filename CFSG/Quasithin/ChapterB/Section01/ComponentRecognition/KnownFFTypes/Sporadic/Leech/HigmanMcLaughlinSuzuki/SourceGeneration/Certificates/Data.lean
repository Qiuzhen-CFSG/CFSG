/-!
# Five-conjugate HS generation data

Four representatives use the exact ATLAS carrier and the previously marked
inner and outer involutions. Conjugating words use the original carrier
generators. Recovery words express both original generators as products of
five conjugates. These definitions are untrusted candidates; the separate
checks prove each recovery identity in Lean's kernel.

Source: GM02 Proposition 5.1; ATLAS HSG1-p100B0. Reproduction and the
right-action to left-action convention are documented in `source/README.md`.
-/

@[expose] public section
namespace CFSG.Quasithin.ChapterB.ComponentRecognition.KnownFFTypes.Sporadic.Leech.HigmanSims.SourceGeneration.Certificates
open Subgroup Theory.GroupTheory
open _root_.Sporadic.LeechRelated.HS
open CFSG.Quasithin.Chapter16.OtherPreliminaries.JankoTwoHigmanSims

/-- The two inner and two outer permutations, in their existing marking. -/
def representative : Fin 4 → Equiv.Perm (Fin 100) :=
  ![inclusion EvenLocalCandidates.e0, inclusion HSInner.ClassCoverage.t,
    HSOuter.elementaryPermutation, HSOuter.symmetricPermutation]

/-- The already certified packed versions of the original ATLAS generators. -/
def letter : Fin 3 → Carrier :=
  ![⟨OrderCertificate.p0, OrderCertificate.a_eq_generator.symm ▸ generatorAElement.property⟩,
    ⟨OrderCertificate.p1, OrderCertificate.b_eq_generator.symm ▸ generatorBElement.property⟩,
    ⟨OrderCertificate.p1, OrderCertificate.b_eq_generator.symm ▸ generatorBElement.property⟩⁻¹]

def conjugatorWord0 : Fin 5 → List (Fin 3) :=
  ![[], [0], [1], [0, 1], [1, 0]]

def conjugatorWord1 : Fin 5 → List (Fin 3) :=
  ![[], [0], [1], [0, 1], [1, 0]]

def conjugatorWord2 : Fin 5 → List (Fin 3) :=
  ![[], [0], [1], [0, 1], [1, 0]]

def conjugatorWord3 : Fin 5 → List (Fin 3) :=
  ![[], [0, 1, 1, 1, 1, 1, 2, 0], [1, 1, 1, 2, 0, 1, 1, 0], [2, 2, 0, 1, 2, 2, 0, 0], [0, 1, 1, 2, 0, 1, 1, 2]]

def conjugatorWord : Fin 4 → Fin 5 → List (Fin 3) :=
  ![conjugatorWord0, conjugatorWord1, conjugatorWord2, conjugatorWord3]

def conjugator (r : Fin 4) (i : Fin 5) : Carrier := evalWord letter (conjugatorWord r i)

def generator (r : Fin 4) (i : Fin 5) : Equiv.Perm (Fin 100) :=
  inclusion (conjugator r i) * representative r * (inclusion (conjugator r i))⁻¹

def recoveryA : Fin 4 → List (Fin 5) :=
  ![[0, 1, 0, 1, 0],
    [3, 2, 1, 0, 1, 0, 2, 4, 2, 1, 0, 4, 2, 1, 2, 4, 0, 1, 2, 4, 0, 2, 3, 0, 1, 0, 1, 3, 1, 0, 4, 2, 1, 4],
    [4, 2, 0, 3, 2, 0, 3, 1, 4, 2, 3, 4, 3, 2, 1, 4, 1, 0, 3, 4, 1, 0, 1, 4, 3, 0, 1, 3, 2, 4, 2, 3, 1, 3, 2, 4, 2, 3, 0, 1, 0, 1],
    [3, 2, 0, 2, 1, 2, 3, 0, 2, 1, 4, 1, 2, 1, 4, 3]]

def recoveryB : Fin 4 → List (Fin 5) :=
  ![[1, 4, 3, 4, 3, 1, 0, 4, 3, 1, 4, 1, 3, 4, 3, 0, 3, 4, 0, 4, 1, 4, 0, 1, 0, 4],
    [4, 3, 2, 3, 2, 4, 0, 2, 3, 4, 1, 3, 0, 2, 3, 0, 3, 1, 3, 4, 3],
    [1, 0, 3, 4, 1, 0, 1, 4, 3, 0, 1, 4, 3, 0, 1, 0, 4, 0, 1, 3, 2, 0, 3, 2, 0, 2, 0, 2, 4, 0],
    [3, 2, 0, 2, 0, 1, 0, 1, 3, 1, 0, 3, 2, 3, 1, 3, 0, 2, 3, 4, 3, 2, 4, 2]]


