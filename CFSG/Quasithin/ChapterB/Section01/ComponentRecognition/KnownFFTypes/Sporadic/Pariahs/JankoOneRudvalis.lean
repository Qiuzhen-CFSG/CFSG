module

public import CFSG.Quasithin.ChapterB.Section01.ComponentRecognition.KnownFFTypes.Sporadic.Pariahs.Geometry
public import CFSG.Quasithin.ChapterB.Section01.ComponentRecognition.KnownFFTypes.Sporadic.Pariahs.Transfer
public import CFSG.Quasithin.ChapterG.Section07.SporadicLocal.PrimeEleven
public import CFSG.Quasithin.ChapterG.Section07.SporadicLocal.Rudvalis
public import Theory.SpecificGroups.Janko1.Model.ThreeConjugates
public import Theory.SpecificGroups.Rudvalis.Model.ThreeConjugates
public import Theory.GroupTheory.ThreeConjugateAutomorphisms.Inner
public import Theory.GroupAction.InnerInvolutionGeometry

/-!
# J₁ and Rudvalis automorphism geometry for the sporadic module argument

The actual J₁ matrix group has one involution class, generated by three
conjugates of its standard involution. Its checked inner automorphism theorem
passes this to involutory automorphisms. The established automorphism two-rank
bound is three. Both assertions use the precise carrier of the full known-simple
catalogue, and the central-cover application uses the literal central quotient.
For Rudvalis, the two involution classes have checked generating triples.
Stabilizer-class invariance and permutation self-normalization prove that every
automorphism is inner, while the intrinsic rank certificate gives the bound six.
The source supplies simplicity and perfectness through the quotient equivalence.

Source: Revin–Zavarnitsine, arXiv:2505.05173v2, Theorem 1; Aschbacher–Smith,
G.7 and K.4, printed pp.347–348 and 457–460. These are group geometry results,
not a module classification or a complete exclusion.
-/

public section
namespace CFSG.Quasithin.ChapterB.ComponentRecognition.KnownFFTypes.Sporadic.Pariahs
open Subgroup Theory.GroupTheory Representation.BinaryOffender
universe u v

/-- Every nonidentity involutory automorphism of the actual J₁ carrier has
three inner conjugates generating its inner automorphism group. -/
theorem j1_threeConjugateAutomorphisms [IsSimpleGroup Janko1.Model] :
    ThreeConjugateAutomorphisms Janko1.Model :=
  threeConjugateAutomorphisms_of_inner
    (MulAut.conj_injective_of_center_eq_bot (center_eq_bot_of_simple_perfect))
    (fun t _ => Janko1.OuterCertificate.aut_inner t)
    Janko1.three_involution_conjugates

/-- The full J₁ simple-model geometry, with no module-classification premise. -/
theorem simpleGeometry_j1 : SimpleGeometry .j1 3 := by
  intro _ hs _
  change IsSimpleGroup Janko1.Model at hs
  exact ⟨j1_threeConjugateAutomorphisms,
    ChapterG.Section07.SporadicLocal.j1_automorphism_twoRank_le_three⟩

/-- J₁ geometry transfers to every faithful irreducible binary central cover. -/
theorem geometry_j1 : Geometry.{u,v} .j1 3 :=
  geometry_of_simpleGeometry .j1 3 simpleGeometry_j1

/-- The rank bound on the actual cover and generation in its literal linear
normalizer, using the supplied central quotient map. -/
theorem j1_centralCover_geometry
    {L : Type u} {V : Type v} [Group L] [Finite L] [IsQuasisimple L]
    [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (ρ : Representation (ZMod 2) L V) (hf : Function.Injective ρ)
    (hi : ρ.IsIrreducible) (e : L ⧸ center L ≃* Janko1.Model) :
    NormalizerThreeConjugates ρ ∧ primeRank 2 (MulAut L) ≤ 3 := by
  exact ⟨(geometry_j1 ρ hf hi ⟨e⟩).1,
    ChapterG.Section07.SporadicLocal.j1_centralQuotient_automorphism_twoRank_le_three e⟩

/-- Three inner conjugates of every nonidentity involutory automorphism of
the actual Rudvalis carrier generate its inner automorphism group. -/
theorem ru_threeConjugateAutomorphisms [IsSimpleGroup Rudvalis.Model]
    [Group.IsPerfect Rudvalis.Model] : ThreeConjugateAutomorphisms Rudvalis.Model :=
  threeConjugateAutomorphisms_of_inner
    (MulAut.conj_injective_of_center_eq_bot center_eq_bot_of_simple_perfect)
    (fun t _ => Chapter1.XiEmbedding.OuterModels.rudvalis_conj_surjective t)
    Rudvalis.three_involution_conjugates

/-- The full Rudvalis simple-model geometry, with all action and rank inputs
discharged for the actual catalogue carrier. -/
theorem simpleGeometry_ru : SimpleGeometry .ru 6 := by
  intro _ hs hp
  change IsSimpleGroup Rudvalis.Model at hs
  change Group.IsPerfect Rudvalis.Model at hp
  exact ⟨ru_threeConjugateAutomorphisms,
    ChapterG.Section07.SporadicLocal.ru_automorphism_twoRank_le_six⟩

/-- Rudvalis geometry on every faithful irreducible binary central cover. -/
theorem geometry_ru : Geometry.{u,v} .ru 6 :=
  geometry_of_simpleGeometry .ru 6 simpleGeometry_ru

/-- Generation in the cover's literal linear normalizer and the rank bound
on its automorphisms, retaining the supplied central quotient map. -/
theorem ru_centralCover_geometry
    {L : Type u} {V : Type v} [Group L] [Finite L] [IsQuasisimple L]
    [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (ρ : Representation (ZMod 2) L V) (hf : Function.Injective ρ)
    (hi : ρ.IsIrreducible) (e : L ⧸ center L ≃* Rudvalis.Model) :
    NormalizerThreeConjugates ρ ∧ primeRank 2 (MulAut L) ≤ 6 := by
  let : IsSimpleGroup (L ⧸ center L) := IsQuasisimple.simple
  exact ⟨(geometry_ru ρ hf hi ⟨e⟩).1,
    ChapterG.Section07.SporadicLocal.ru_centralQuotient_automorphism_twoRank_le_six e⟩

end CFSG.Quasithin.ChapterB.ComponentRecognition.KnownFFTypes.Sporadic.Pariahs
