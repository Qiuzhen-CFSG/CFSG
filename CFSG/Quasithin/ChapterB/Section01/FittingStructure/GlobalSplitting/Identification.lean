module

public import CFSG.Quasithin.ChapterB.Section01.FittingStructure.GlobalSplitting.Factors
public import CFSG.Quasithin.ChapterB.Section01.FittingStructure.GlobalSplitting.Models
public import Theory.Representation.GoldschmidtONan.Basic
public import Theory.Representation.RegularCyclicNormalClosure.Seed
public import Theory.Representation.BinaryOffender.IrreducibleMovedGeneration
public import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Card
public import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Basic

/-!
# Identification of the groups sharing a cubic plane

Every generator of G_X normalizes X and has its full displacement in [V,X].
Consequently G_X preserves C_V(X), and each displacement on that complement
lies both in C_V(X) and [V,X]. Odd-order splitting makes it zero. Thus G_X
acts faithfully on [V,X], since it fixes the complementary space pointwise.
The plane has dimension two, so |G_X|≤|GL₂(2)|=6. The local subgroup XA
already has order six and lies in G_X, proving G_X=XA.

This argument uses no claimed ambient normality of an individual plane
kernel. The complement is invariant under the exact group G_X whose kernel
is being computed. Distinct groups G_X fix one another's supports, and
faithfulness makes them commute.

Source: Aschbacher–Smith, B.1.9, printed p.71, identification of Gᵢ.
-/

public section

open Subgroup Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterB.FittingStructure
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

private theorem moved_eq_displacement (X : Subgroup G) :
    subspaceCommutator ρ ⊤ X =
      Representation.RegularCyclicNormalClosure.displacementSpan ρ X ⊤ := by
  unfold subspaceCommutator Representation.RegularCyclicNormalClosure.displacementSpan
  congr 1
  ext v
  simp only [eq_comm]

private theorem moved_mono {X Y : Subgroup G} (h : X ≤ Y) :
    subspaceCommutator ρ ⊤ X ≤ subspaceCommutator ρ ⊤ Y := by
  apply Submodule.span_mono
  rintro _ ⟨a, ha, v, hv, rfl⟩
  exact ⟨a, h ha, v, hv, rfl⟩

theorem planeGroup_normalizes_cubic (X : Subgroup G) :
    planeGroup ρ X ≤ normalizer (X : Set G) := by
  refine iSup_le fun A => iSup_le fun hA => ?_
  rw [← hA.1.2.2]
  exact normalizer_commutator_ge_right _ _

variable [Finite G]

/-- The displacement of the generated source group is exactly the cubic plane. -/
theorem planeGroup_support_eq (hlocal : LocalPlaneLaw ρ)
    {X : Subgroup G} (hX : X ∈ minimalMovedFactors ρ) :
    subspaceCommutator ρ ⊤ (planeGroup ρ X) = subspaceCommutator ρ ⊤ X := by
  apply le_antisymm
  · unfold planeGroup generatedBy
    simp only [Representation.BinaryGroupAction.moved_iSup]
    refine iSup_le fun A => iSup_le fun hA => ?_
    obtain ⟨d⟩ := hlocal A hA.1.1 hA.1.2.1
    calc
      subspaceCommutator ρ ⊤ A ≤
          subspaceCommutator ρ ⊤ (⁅fittingSubgroup G, A⁆ ⊔ A) := moved_mono ρ le_sup_right
      _ = subspaceCommutator ρ ⊤ X := by rw [← d.support_eq, hA.1.2.2]
  · exact moved_mono ρ (cubic_le_planeGroup ρ hX)

/-- The coprime complement belongs to the original binary module. -/
theorem cubic_fixed_moved_complement (hlocal : LocalPlaneLaw ρ)
    {X : Subgroup G} (hX : X ∈ minimalMovedFactors ρ) :
    IsCompl (fixedSpace ρ X) (subspaceCommutator ρ ⊤ X) := by
  rw [moved_eq_displacement]
  apply Representation.GoldschmidtONan.isCompl_fixed_moved_of_odd
  rw [(minimalMovedFactors_subset_small ρ hlocal hX).2.1]
  decide

/-- Every element generated by offenders sharing X fixes C_V(X) pointwise. -/
theorem planeGroup_fixes_cubic_complement (hlocal : LocalPlaneLaw ρ)
    {X : Subgroup G} (hX : X ∈ minimalMovedFactors ρ) :
    fixedSpace ρ X ≤ fixedSpace ρ (planeGroup ρ X) := by
  have hs := fixedSpace_invariant_normalizer ρ (planeGroup_normalizes_cubic ρ X)
  intro v hv g
  apply sub_eq_zero.mp
  have hm : ρ (g : G) v - v ∈ subspaceCommutator ρ ⊤ X := by
    rw [← planeGroup_support_eq ρ hlocal hX]
    exact Submodule.subset_span ⟨g, g.property, v, Submodule.mem_top, rfl⟩
  exact (cubic_fixed_moved_complement ρ hlocal hX).disjoint.le_bot
    ⟨(fixedSpace ρ X).sub_mem ((hs g.property v).2 hv) hv, hm⟩

/-- The kernel on the plane is trivial because the same group fixes the
complement. No normal-kernel assertion in G is needed. -/
theorem planeGroup_faithful_support (hρ : Function.Injective ρ) (hlocal : LocalPlaneLaw ρ)
    {X : Subgroup G} (hX : X ∈ minimalMovedFactors ρ)
    {g : G} (hg : g ∈ planeGroup ρ X)
    (hfix : ∀ v ∈ subspaceCommutator ρ ⊤ X, ρ g v = v) : g = 1 := by
  apply hρ
  ext v
  obtain ⟨c, hc, w, hw, rfl⟩ := Submodule.mem_sup.mp
    (show v ∈ fixedSpace ρ X ⊔ subspaceCommutator ρ ⊤ X by
      rw [(cubic_fixed_moved_complement ρ hlocal hX).sup_eq_top]
      trivial)
  have hgc : ρ g c = c := planeGroup_fixes_cubic_complement ρ hlocal hX hc ⟨g, hg⟩
  rw [map_add, hgc, hfix w hw]
  simp

variable [FiniteDimensional (ZMod 2) V]

theorem planeGroup_card_le_six (hρ : Function.Injective ρ) (hlocal : LocalPlaneLaw ρ)
    {X : Subgroup G} (hX : X ∈ minimalMovedFactors ρ) :
    Nat.card (planeGroup ρ X) ≤ 6 := by
  let W := subspaceCommutator ρ ⊤ X
  have hs : planeGroup ρ X ≤ subspaceStabilizer ρ W := by
    dsimp only [W]
    rw [← planeGroup_support_eq ρ hlocal hX]
    exact subspaceCommutator_invariant ρ ⊤ _
  let σ := (invariantSubspace ρ (planeGroup ρ X) W hs).toRepresentation
  have hσ : Function.Injective σ.asGroupHom := by
    apply (injective_iff_map_eq_one _).mpr
    intro g hg
    apply Subtype.ext
    apply planeGroup_faithful_support ρ hρ hlocal hX g.property
    intro w hw
    exact congrArg Subtype.val
      (LinearMap.congr_fun (congrArg Units.val hg) (⟨w, hw⟩ : W))
  have hd : Module.finrank (ZMod 2) W = 2 :=
    (minimalMovedFactors_subset_small ρ hlocal hX).2.2
  let b := Module.finBasisOfFinrankEq (ZMod 2) W hd
  let f := (Matrix.GeneralLinearGroup.toLin' b).symm.toMonoidHom.comp σ.asGroupHom
  have hf : Function.Injective f := (Matrix.GeneralLinearGroup.toLin' b).symm.injective.comp hσ
  have hdiv := card_dvd_of_injective f hf
  have hGL : Nat.card (Matrix.GeneralLinearGroup (Fin 2) (ZMod 2)) = 6 := by
    rw [Matrix.card_GL_field]
    norm_num [Fin.prod_univ_succ]
  rw [hGL] at hdiv
  exact Nat.le_of_dvd (by decide) hdiv

/-- The source identification Gᵢ=FᵢA, for every member of its defining family. -/
theorem planeGroup_eq_local (hρ : Function.Injective ρ) (hlocal : LocalPlaneLaw ρ)
    {X A : Subgroup G} (hA : A ∈ planeOffenders ρ X) :
    planeGroup ρ X = X ⊔ A := by
  obtain ⟨d⟩ := hlocal A hA.1 hA.2.1
  have hc : Nat.card ↥(X ⊔ A) = 6 := by rw [← hA.2.2]; exact d.local_card
  apply (eq_of_le_of_card_ge (localFactor_le_planeGroup ρ hA) ?_).symm
  rw [hc]
  exact planeGroup_card_le_six ρ hρ hlocal ⟨A, hA.1, hA.2.1, hA.2.2.symm⟩

/-- Distinct source Gᵢ fix one another's actual supports. -/
theorem planeGroups_cross_fixed (hρ : Function.Injective ρ) (hlocal : LocalPlaneLaw ρ)
    {X Y : Subgroup G} (hX : X ∈ minimalMovedFactors ρ)
    (hY : Y ∈ minimalMovedFactors ρ) (hne : X ≠ Y) :
    subspaceCommutator ρ ⊤ (planeGroup ρ Y) ≤ fixedSpace ρ (planeGroup ρ X) := by
  rw [planeGroup_support_eq ρ hlocal hY]
  exact (minimalMovedFactors_cross_fixed ρ hρ hlocal hX hY hne).trans
    (planeGroup_fixes_cubic_complement ρ hlocal hX)

/-- The source Gᵢ commute as subgroups of the original G. -/
theorem planeGroups_commute (hρ : Function.Injective ρ) (hlocal : LocalPlaneLaw ρ)
    {X Y : Subgroup G} (hX : X ∈ minimalMovedFactors ρ)
    (hY : Y ∈ minimalMovedFactors ρ) (hne : X ≠ Y) :
    planeGroup ρ X ≤ centralizer (planeGroup ρ Y : Set G) := by
  intro x hx y hy
  exact (Representation.RegularCyclicNormalClosure.commute_of_cross_fixed hρ
    (fun a ha v hv => planeGroups_cross_fixed ρ hρ hlocal hX hY hne
      ((moved_eq_displacement ρ _).symm ▸ hv) ⟨a, ha⟩)
    (fun a ha v hv => planeGroups_cross_fixed ρ hρ hlocal hY hX hne.symm
      ((moved_eq_displacement ρ _).symm ▸ hv) ⟨a, ha⟩) hx hy).symm.eq

end CFSG.Quasithin.ChapterB.FittingStructure
