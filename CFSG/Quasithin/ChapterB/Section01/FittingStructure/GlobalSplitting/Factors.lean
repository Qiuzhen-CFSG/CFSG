module

public import CFSG.Quasithin.ChapterB.Section01.FittingStructure.GlobalSplitting.CubicProduct

/-!
# The source groups generated by offenders with a common cubic factor

For X=[F(G),A]≠1, define G_X to be generated by exactly the minimal best
offenders with that same commutator. Conjugation transports this family and
its generated subgroup. In particular F(G) normalizes G_X, so X≤G_X.
We also split the generating family of J* into its centralizing members and
these actual G_X. These facts do not presume the outstanding identification
G_X=XA, or a product decomposition.

Source: Aschbacher–Smith, B.1.9, printed p.71, definition of Pᵢ* and Gᵢ.
-/

@[expose] public section

open Subgroup Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterB.FittingStructure
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

/-- The literal source family Pᵢ*, indexed by its cubic subgroup. -/
def planeOffenders (X : Subgroup G) : Set (Subgroup G) :=
  {A | IsMinimalBestOffender ρ A ∧ ⁅fittingSubgroup G, A⁆ ≠ ⊥ ∧
    ⁅fittingSubgroup G, A⁆ = X}

/-- The source Gᵢ, defined by generation rather than an abstract model. -/
def planeGroup (X : Subgroup G) : Subgroup G := generatedBy (planeOffenders ρ X) ⊤

theorem offender_le_planeGroup {X A : Subgroup G} (hA : A ∈ planeOffenders ρ X) :
    A ≤ planeGroup ρ X :=
  le_iSup_of_le A (le_iSup_of_le ⟨hA, le_top⟩ le_rfl)

theorem planeGroup_le_minimalGenerated (X : Subgroup G) :
    planeGroup ρ X ≤ minimalGenerated ρ := by
  exact iSup_le fun A => iSup_le fun hA => minimal_le ρ hA.1.1

theorem planeOffenders_map_conj {X A : Subgroup G}
    (hA : A ∈ planeOffenders ρ X) (g : G) :
    A.map (MulAut.conj g).toMonoidHom ∈
      planeOffenders ρ (X.map (MulAut.conj g).toMonoidHom) := by
  have he : ⁅fittingSubgroup G, A.map (MulAut.conj g).toMonoidHom⁆ =
      ⁅fittingSubgroup G, A⁆.map (MulAut.conj g).toMonoidHom := by
    rw [map_commutator]
    congr 1
    exact (Normal.map_conj_eq (fittingSubgroup G) g).symm
  refine ⟨hA.1.map_conj ρ g, ?_, ?_⟩
  · rw [he]
    exact fun hz => hA.2.1
      ((map_eq_bot_iff_of_injective _ (MulAut.conj g).injective).mp hz)
  · rw [he, hA.2.2]

theorem planeGroup_map_conj_le (X : Subgroup G) (g : G) :
    (planeGroup ρ X).map (MulAut.conj g).toMonoidHom ≤
      planeGroup ρ (X.map (MulAut.conj g).toMonoidHom) := by
  unfold planeGroup generatedBy
  simp only [Subgroup.map_iSup]
  exact iSup_le fun A => iSup_le fun hA =>
    le_iSup_of_le (A.map (MulAut.conj g).toMonoidHom)
      (le_iSup_of_le ⟨planeOffenders_map_conj ρ hA.1 g, le_top⟩ le_rfl)

variable [Finite G]

theorem normalizer_le_normalizer_planeGroup (X : Subgroup G) :
    normalizer (X : Set G) ≤ normalizer (planeGroup ρ X : Set G) := by
  intro g hg
  apply mem_normalizer_iff_map_conj_eq.mpr
  change (planeGroup ρ X).map (MulAut.conj g).toMonoidHom = planeGroup ρ X
  have hle := planeGroup_map_conj_le ρ X g
  have hg' : X.map (MulAut.conj g).toMonoidHom = X :=
    mem_normalizer_iff_map_conj_eq.mp hg
  rw [hg'] at hle
  exact eq_of_le_of_card_ge hle (by rw [card_map_of_injective (MulAut.conj g).injective])

theorem fitting_normalizes_planeGroup {X : Subgroup G} (hX : X ∈ minimalMovedFactors ρ) :
    fittingSubgroup G ≤ normalizer (planeGroup ρ X : Set G) := by
  obtain ⟨A, _, _, rfl⟩ := hX
  exact (normalizer_commutator_ge_left _ _).trans (normalizer_le_normalizer_planeGroup ρ _)

/-- The odd commutator really lies in the subgroup generated by its offender
family. This uses normalization by F(G), not an assumed model identification. -/
theorem cubic_le_planeGroup {X : Subgroup G} (hX : X ∈ minimalMovedFactors ρ) :
    X ≤ planeGroup ρ X := by
  obtain ⟨A, hA, hn, he⟩ := hX
  have hAG : A ≤ planeGroup ρ X := offender_le_planeGroup ρ ⟨hA, hn, he.symm⟩
  calc
    X = ⁅fittingSubgroup G, A⁆ := he
    _ ≤ ⁅fittingSubgroup G, planeGroup ρ X⁆ := commutator_mono le_rfl hAG
    _ ≤ planeGroup ρ X :=
      le_normalizer_iff_commutator_le_right.mp
        (fitting_normalizes_planeGroup ρ ⟨A, hA, hn, he⟩)

theorem localFactor_le_planeGroup {X A : Subgroup G} (hA : A ∈ planeOffenders ρ X) :
    X ⊔ A ≤ planeGroup ρ X :=
  sup_le (cubic_le_planeGroup ρ ⟨A, hA.1, hA.2.1, hA.2.2.symm⟩)
    (offender_le_planeGroup ρ hA)

/-- The complete J* generating family, split using the literal Fitting
centralizer. No assertion about arbitrary stable-family saturation is used. -/
theorem minimalGenerated_eq_planeGroups_sup :
    minimalGenerated ρ = (⨆ i, planeGroup ρ (cubicFactor ρ i)) ⊔
      generatedBy {A | IsMinimalBestOffender ρ A}
        (centralizer (fittingSubgroup G : Set G)) := by
  apply le_antisymm
  · refine iSup_le fun A => iSup_le fun hA => ?_
    by_cases hn : ⁅fittingSubgroup G, A⁆ = ⊥
    · apply le_sup_of_le_right
      exact le_iSup_of_le A (le_iSup_of_le ⟨hA.1,
        le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hn)⟩ le_rfl)
    · have hm : ⁅fittingSubgroup G, A⁆ ∈ minimalMovedFactors ρ := ⟨A, hA.1, hn, rfl⟩
      obtain ⟨i, hi⟩ := (range_cubicFactor ρ).symm ▸ hm
      exact (offender_le_planeGroup ρ ⟨hA.1, hn, hi.symm⟩).trans
        ((le_iSup (fun j => planeGroup ρ (cubicFactor ρ j)) i).trans le_sup_left)
  · refine sup_le (iSup_le fun i => planeGroup_le_minimalGenerated ρ _) ?_
    exact iSup_le fun A => iSup_le fun hA => minimal_le ρ hA.1

end CFSG.Quasithin.ChapterB.FittingStructure
