module

public import CFSG.Quasithin.ChapterB.Section01.FittingStructure.GlobalSplitting.BestOffenderSplitting.Basic
public import Theory.Representation.BinaryOffender.Restriction
public import Theory.ElementaryAbelian.Quotient
public import Mathlib.GroupTheory.NoncommCoprod

/-!
# Projecting a best offender to the Fitting centralizer

Let E be generated by the actual source groups Gᵢ. The unique factorization
in E C_G(E) gives a homomorphism from a subgroup normalizing every Gᵢ to
C_G(E). Its image D is elementary abelian when the original subgroup is.

For a best offender B, restrict its action to U = C_V(F). The groups B and D
have literally the same image on U, since E fixes U. Each Gᵢ acts as the full
linear group on its binary plane, so its centralizer fixes that plane. Thus
D fixes W = [V,F]. The odd order of F gives V = U ⊕ W; faithfulness then
identifies D with its image on U. Every subgroup of D has its original weight
equal to its restricted weight plus dim W. The restriction theorem therefore
makes nontrivial D a best offender for the original representation.

The normalization of the Gᵢ remains explicit. The final export applies the
projection to every best offender to supply the generated-subgroup inclusion
used by the owner of B.1.9(1).

Source: Aschbacher–Smith, B.1.9(1), printed p.71 (PDF p.82), using the
restriction comparison B.7.1, printed pp.118–119.
-/

public section

open Subgroup Representation.BinaryOffender
open Theory.GroupTheory.NormalSymmetricThreePairRank
namespace CFSG.Quasithin.ChapterB.FittingStructure
variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V] (ρ : Representation (ZMod 2) G V)

private theorem centralizer_fixes_plane (hρ : Function.Injective ρ) (hlocal : LocalPlaneLaw ρ)
    {X : Subgroup G} (hX : X ∈ minimalMovedFactors ρ) :
    subspaceCommutator ρ ⊤ X ≤ fixedSpace ρ (centralizer (planeGroup ρ X : Set G)) := by
  let W := subspaceCommutator ρ ⊤ X
  let H := planeGroup ρ X
  have hs : H ≤ subspaceStabilizer ρ W := by
    dsimp only [W, H]
    rw [← planeGroup_support_eq ρ hlocal hX]
    exact subspaceCommutator_invariant ρ ⊤ _
  let σ := (invariantSubspace ρ H W hs).toRepresentation
  have hi : Function.Injective σ.asGroupHom := by
    apply (injective_iff_map_eq_one _).mpr
    intro g hg
    apply Subtype.ext
    apply planeGroup_faithful_support ρ hρ hlocal hX g.property
    intro w hw
    exact congrArg Subtype.val
      (LinearMap.congr_fun (congrArg Units.val hg) (⟨w, hw⟩ : W))
  let basis := Module.finBasisOfFinrankEq (ZMod 2) W
    (minimalMovedFactors_subset_small ρ hlocal hX).2.2
  let e := Matrix.GeneralLinearGroup.toLin' basis
  let f := e.symm.toMonoidHom.comp σ.asGroupHom
  have hf : Function.Surjective f := by
    apply ((Nat.bijective_iff_injective_and_card f).mpr ⟨e.symm.injective.comp hi, ?_⟩).2
    change Nat.card H = Nat.card (Matrix.GeneralLinearGroup (Fin 2) (ZMod 2))
    rw [planeGroup_card ρ hρ hlocal hX, Matrix.card_GL_field]
    norm_num [Fin.prod_univ_succ]
  have hsurj : Function.Surjective σ.asGroupHom := by
    intro a
    obtain ⟨k, hk⟩ := hf (e.symm a)
    exact ⟨k, e.symm.injective hk⟩
  have hcs : centralizer (H : Set G) ≤ subspaceStabilizer ρ W := by
    apply subspaceCommutator_invariant_normalizer ρ (le_subspaceStabilizer ρ ⊤ (by simp))
    exact (centralizer_le (cubic_le_planeGroup ρ hX)).trans (centralizer_le_normalizer _)
  intro w hw c
  let τ := (invariantSubspace ρ (centralizer (H : Set G)) W hcs).toRepresentation
  obtain ⟨k, hk⟩ := hsurj (τ.asGroupHom c)
  have hkc (v : W) : ρ (k : G) v = ρ (c : G) v :=
    congrArg Subtype.val (LinearMap.congr_fun (congrArg Units.val hk) v)
  have hcentral (x : H) : x * k = k * x := by
    apply hi
    apply Units.ext
    ext v
    change ρ ((x : G) * k) v = ρ ((k : G) * x) v
    simp only [map_mul, Module.End.mul_apply]
    change ρ (x : G) (ρ (k : G) v) = ρ (k : G) (ρ (x : G) v)
    rw [hkc v, hkc ⟨ρ (x : G) v, (hs x.property v).2 v.property⟩]
    simpa only [map_mul, Module.End.mul_apply] using
      LinearMap.congr_fun (congrArg ρ (c.property x x.property)) (v : V)
  obtain ⟨m⟩ := planeGroup_model ρ hρ hlocal hX
  have hk1 : k = 1 := by
    apply m.injective
    rw [map_one]
    apply symmetricThree_center_trivial
    intro y
    obtain ⟨x, rfl⟩ := m.surjective y
    simpa only [map_mul] using congrArg m (hcentral x)
  change ρ (c : G) w = w
  rw [← hkc ⟨w, hw⟩, hk1]
  simp

/-- The common centralizer fixes the actual Fitting moved space pointwise. -/
theorem centralizer_planeGenerated_fixes_moved (hρ : Function.Injective ρ)
    (hlocal : LocalPlaneLaw ρ) :
    subspaceCommutator ρ ⊤ (fittingMoved ρ) ≤
      fixedSpace ρ (centralizer (planeGenerated ρ : Set G)) := by
  rw [← cubicSupports_iSup]
  refine iSup_le fun i => ?_
  exact (centralizer_fixes_plane ρ hρ hlocal (cubicFactor_mem ρ i)).trans
    (fixedSpace_antitone ρ (centralizer_le
      (show planeGroup ρ (cubicFactor ρ i) ≤ planeGenerated ρ from
        le_iSup (fun j => planeGroup ρ (cubicFactor ρ j)) i)))

omit [FiniteDimensional (ZMod 2) V] in
/-- The generated plane factors fix the actual Fitting fixed space. -/
theorem planeGenerated_fixes_fixed (hlocal : LocalPlaneLaw ρ) :
    fixedSpace ρ (fittingMoved ρ) ≤ fixedSpace ρ (planeGenerated ρ) := by
  let U := fixedSpace ρ (fittingMoved ρ)
  have hE : planeGenerated ρ ≤ subspaceKernel ρ U ⊤ := by
    refine iSup_le fun i g hg => ⟨Subgroup.mem_top g, ?_⟩
    intro v hv
    exact planeGroup_fixes_cubic_complement ρ hlocal (cubicFactor_mem ρ i)
      (fixedSpace_antitone ρ (cubicFactor_le ρ i) hv) ⟨g, hg⟩
  exact (le_fixedSpace_subspaceKernel ρ U ⊤).trans (fixedSpace_antitone ρ hE)

/-- The two spaces used for the source projection are complementary in V. -/
theorem fitting_fixed_moved_complement (hρ : Function.Injective ρ)
    (hlocal : LocalPlaneLaw ρ) :
    IsCompl (fixedSpace ρ (fittingMoved ρ))
      (subspaceCommutator ρ ⊤ (fittingMoved ρ)) := by
  have he : subspaceCommutator ρ ⊤ (fittingMoved ρ) =
      Representation.RegularCyclicNormalClosure.displacementSpan ρ (fittingMoved ρ) ⊤ := by
    unfold subspaceCommutator Representation.RegularCyclicNormalClosure.displacementSpan
    congr 1
    ext v
    simp only [eq_comm]
  rw [he]
  apply Representation.GoldschmidtONan.isCompl_fixed_moved_of_odd
  rw [fittingMoved_card ρ hρ hlocal]
  exact (show Odd 3 by decide).pow


/-- The unique centralizer coordinate is a homomorphism on any common normalizer. -/
theorem exists_centralizer_projection (hρ : Function.Injective ρ) (hlocal : LocalPlaneLaw ρ)
    (B : Subgroup G)
    (hn : ∀ i, B ≤ normalizer (planeGroup ρ (cubicFactor ρ i) : Set G)) :
    ∃ p : B →* G, ∀ b : B,
      p b ∈ centralizer (planeGenerated ρ : Set G) ∧
        ∃ k ∈ planeGenerated ρ, (b : G) = k * p b := by
  classical
  let E := planeGenerated ρ
  let C := centralizer (E : Set G)
  let m : E × C →* G := E.subtype.noncommCoprod C.subtype
    (fun k c => (c.property k k.property : (k : G) * c = c * k))
  have hm : Function.Injective m := by
    apply (injective_iff_map_eq_one _).mpr
    rintro ⟨k, c⟩ h
    change (k : G) * (c : G) = 1 at h
    have he : (k : G) = (c : G)⁻¹ := eq_inv_of_mul_eq_one_left h
    have hk : (k : G) ∈ E ⊓ C := ⟨k.property, he ▸ C.inv_mem c.property⟩
    rw [planeGenerated_inf_centralizer_eq_bot ρ hρ hlocal] at hk
    have hk1 : k = 1 := Subtype.ext hk
    have hc1 : c = 1 := by
      apply Subtype.ext
      simpa only [hk1, OneMemClass.coe_one, one_mul] using h
    exact Prod.ext hk1 hc1
  have hex (b : B) : ∃ q : E × C, m q = b := by
    obtain ⟨k, hk, c, hc, he⟩ := normalizing_planeGroups_decomposition ρ hρ hlocal b
      (fun i => hn i b.property)
    exact ⟨(⟨k, hk⟩, ⟨c, hc⟩), he.symm⟩
  choose q hq using hex
  let lift : B →* E × C :=
    { toFun := q
      map_one' := hm (by rw [hq, map_one]; rfl)
      map_mul' := fun a b => hm (by rw [map_mul, hq, hq, hq]; rfl) }
  let p : B →* G := C.subtype.comp ((MonoidHom.snd E C).comp lift)
  refine ⟨p, fun b => ⟨(q b).2.property, (q b).1, (q b).1.property, ?_⟩⟩
  exact (hq b).symm


omit [Finite G] in
private theorem weight_restricted_add (hρ : Function.Injective ρ)
    (U W : Submodule (ZMod 2) V) (hUW : IsCompl U W)
    (A : Subgroup G) (hA : A ≤ subspaceStabilizer ρ U) (hW : W ≤ fixedSpace ρ A) :
    weight ρ A = weight (subspaceImageRepresentation ρ U) (restrictedSubgroup ρ U A) +
      Module.finrank (ZMod 2) W := by
  have hker : subspaceKernel ρ U A = ⊥ := by
    apply le_bot_iff.mp
    intro g hg
    change g = 1
    apply hρ
    ext v
    obtain ⟨u, hu, w, hw, rfl⟩ := Submodule.mem_sup.mp
      (show v ∈ U ⊔ W by rw [hUW.sup_eq_top]; trivial)
    rw [map_add, hg.2 u hu, (show ρ g w = w from hW hw ⟨g, hg.1⟩)]
    simp
  have hr : rank (restrictedSubgroup ρ U A) = rank A := by
    have hc := card_subspaceKernel_mul_image ρ U A hA
    rw [hker, Subgroup.card_bot, one_mul] at hc
    exact congrArg (Nat.log 2) hc
  have hsum : W ⊔ (U ⊓ fixedSpace ρ A) = fixedSpace ρ A := by
    apply le_antisymm (sup_le hW inf_le_right)
    intro v hv
    obtain ⟨u, hu, w, hw, he⟩ := Submodule.mem_sup.mp
      (show v ∈ U ⊔ W by rw [hUW.sup_eq_top]; trivial)
    have huA : u ∈ fixedSpace ρ A := by
      have := (fixedSpace ρ A).sub_mem hv (hW hw)
      simpa only [← he, add_sub_cancel_right] using this
    exact Submodule.mem_sup.mpr ⟨w, hw, u, ⟨hu, huA⟩, (add_comm w u).trans he⟩
  have hinf : W ⊓ (U ⊓ fixedSpace ρ A) = ⊥ :=
    (hUW.disjoint.symm.mono_right inf_le_left).eq_bot
  have hd := W.finrank_sup_add_finrank_inf_eq (U ⊓ fixedSpace ρ A)
  rw [hsum, hinf, finrank_bot, add_zero] at hd
  have hi := (restrictedFixedSpaceEquiv ρ U A hA).finrank_eq
  unfold weight
  omega

omit [Finite G] in
private theorem best_of_restricted (hρ : Function.Injective ρ)
    (U W : Submodule (ZMod 2) V) (hUW : IsCompl U W)
    (D : Subgroup G) (hDe : IsElementaryTwo D)
    (hD : D ≤ subspaceStabilizer ρ U) (hW : W ≤ fixedSpace ρ D)
    (hb : IsBestOffender (subspaceImageRepresentation ρ U) (restrictedSubgroup ρ U D)) :
    IsBestOffender ρ D := by
  refine ⟨hDe, fun A hA => ?_⟩
  rw [weight_restricted_add ρ hρ U W hUW A (hA.trans hD)
    (hW.trans (fixedSpace_antitone ρ hA)), weight_restricted_add ρ hρ U W hUW D hD hW]
  apply Nat.add_le_add_right
  apply hb.2
  exact restrictedSubgroup_mono ρ U hA


/-- A best offender normalizing every source plane group projects to a trivial
subgroup or a best offender of the original representation in the common centralizer. -/
theorem bestOffender_centralizer_projection (hρ : Function.Injective ρ)
    (hlocal : LocalPlaneLaw ρ) {B : Subgroup G} (hB : IsBestOffender ρ B)
    (hn : ∀ i, B ≤ normalizer (planeGroup ρ (cubicFactor ρ i) : Set G)) :
    ∃ D : Subgroup G, (D = ⊥ ∨ IsBestOffender ρ D) ∧
      D ≤ centralizer (planeGenerated ρ : Set G) ∧ B ≤ planeGenerated ρ ⊔ D := by
  obtain ⟨p, hp⟩ := exists_centralizer_projection ρ hρ hlocal B hn
  let D := p.range
  have hDC : D ≤ centralizer (planeGenerated ρ : Set G) := by
    rintro _ ⟨b, rfl⟩
    exact (hp b).1
  have hBD : B ≤ planeGenerated ρ ⊔ D := by
    intro b hb
    obtain ⟨k, hk, he⟩ := (hp ⟨b, hb⟩).2
    change b = k * p ⟨b, hb⟩ at he
    rw [he]
    exact mul_mem ((le_sup_left : planeGenerated ρ ≤ planeGenerated ρ ⊔ D) hk)
      ((le_sup_right : D ≤ planeGenerated ρ ⊔ D) ⟨⟨b, hb⟩, rfl⟩)
  refine ⟨D, ?_, hDC, hBD⟩
  by_cases hDbot : D = ⊥
  · exact Or.inl hDbot
  apply Or.inr
  let _ : IsElementaryAbelian 2 B := hB.1.2
  have hDe : IsElementaryTwo D :=
    ⟨hDbot, IsElementaryAbelian.of_surjective p.rangeRestrict p.rangeRestrict_surjective⟩
  let U := fixedSpace ρ (fittingMoved ρ)
  let W := subspaceCommutator ρ ⊤ (fittingMoved ρ)
  have hc : IsCompl U W := fitting_fixed_moved_complement ρ hρ hlocal
  have hs (A : Subgroup G) : A ≤ subspaceStabilizer ρ U :=
    fixedSpace_invariant_normalizer ρ le_normalizer_of_normal
  have hW : W ≤ fixedSpace ρ D :=
    (centralizer_planeGenerated_fixes_moved ρ hρ hlocal).trans (fixedSpace_antitone ρ hDC)
  have hact (b : B) (u : U) : ρ (b : G) u = ρ (p b) u := by
    obtain ⟨k, hk, he⟩ := (hp b).2
    rw [he, map_mul, Module.End.mul_apply]
    exact planeGenerated_fixes_fixed ρ hlocal
      ((hs D (show p b ∈ D from ⟨b, rfl⟩) u).2 u.property) ⟨k, hk⟩
  have himage : restrictedSubgroup ρ U B = restrictedSubgroup ρ U D := by
    ext z
    constructor
    · rintro ⟨b, hb, rfl⟩
      refine ⟨⟨p ⟨b, hb⟩, hs D (show p ⟨b, hb⟩ ∈ D from ⟨⟨b, hb⟩, rfl⟩)⟩,
        ⟨⟨b, hb⟩, rfl⟩, ?_⟩
      apply subspaceImageRepresentation_injective ρ U
      ext u
      exact (hact ⟨b, hb⟩ u).symm
    · rintro ⟨d, hd, rfl⟩
      obtain ⟨b, hb⟩ := hd
      refine ⟨⟨b, hs B b.property⟩, b.property, ?_⟩
      apply subspaceImageRepresentation_injective ρ U
      ext u
      change ρ (b : G) u = ρ (d : G) u
      change p b = (d : G) at hb
      rw [← hb]
      exact hact b u
  have hnon : ¬ U ≤ fixedSpace ρ B := by
    intro hfix
    apply hDbot
    apply le_bot_iff.mp
    rintro g ⟨b, rfl⟩
    change p b = 1
    apply hρ
    ext v
    obtain ⟨u, hu, w, hw, rfl⟩ := Submodule.mem_sup.mp
      (show v ∈ U ⊔ W by rw [hc.sup_eq_top]; trivial)
    rw [map_add, ← hact b ⟨u, hu⟩, (show ρ (b : G) u = u from hfix hu b),
      (show ρ (p b) w = w from hW hw ⟨p b, ⟨b, rfl⟩⟩)]
    simp
  apply best_of_restricted ρ hρ U W hc D hDe (hs D) hW
  rw [← himage]
  exact hB.restricted ρ U (hs B) hnon

/-- The projection lands in the centralizer required in B.1.9(1). -/
theorem bestOffender_fitting_centralizer_projection (hρ : Function.Injective ρ)
    (hlocal : LocalPlaneLaw ρ) {B : Subgroup G} (hB : IsBestOffender ρ B)
    (hn : ∀ i, B ≤ normalizer (planeGroup ρ (cubicFactor ρ i) : Set G)) :
    ∃ D : Subgroup G, (D = ⊥ ∨ IsBestOffender ρ D) ∧
      D ≤ centralizer (fittingMoved ρ : Set G) ∧ B ≤ planeGenerated ρ ⊔ D := by
  obtain ⟨D, hb, hc, hle⟩ := bestOffender_centralizer_projection ρ hρ hlocal hB hn
  exact ⟨D, hb, hc.trans (centralizer_le (fittingMoved_le_planeGenerated ρ)), hle⟩

/-- The literal generated-subgroup inclusion consumed by the B.1.9 assembly. -/
theorem offenderSubgroup_le_planeGenerated_sup_centralizingBestGenerated
    (hρ : Function.Injective ρ) (hlocal : LocalPlaneLaw ρ)
    (hn : ∀ B, IsBestOffender ρ B →
      ∀ i, B ≤ normalizer (planeGroup ρ (cubicFactor ρ i) : Set G)) :
    offenderSubgroup ρ ≤ planeGenerated ρ ⊔ centralizingBestGenerated ρ := by
  refine iSup_le fun B => iSup_le fun hB => ?_
  obtain ⟨D, hb, hc, hle⟩ :=
    bestOffender_fitting_centralizer_projection ρ hρ hlocal hB.1 (hn B hB.1)
  apply hle.trans (sup_le_sup_left ?_ _)
  rcases hb with rfl | hb
  · exact bot_le
  · exact le_iSup_of_le D (le_iSup_of_le ⟨hb, hc⟩ le_rfl)


