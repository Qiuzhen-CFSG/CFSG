module

public import CFSG.Quasithin.ChapterB.Section01.FittingStructure.GlobalSplitting.BestOffenderSplitting.Normalization.LocalAction

/-!
# The two-core of the literal local action image

Let E be generated by the source S₃ plane groups and W=[V,F]. Normality
of E in G and O₂(G)=1 imply O₂(E)=1. Since E acts faithfully on W, the
normal two-core of the image of E B on W intersects the image of E trivially
and therefore centralizes it. Faithfulness lifts this centralization to E.

An element centralizing a source plane group fixes its plane: the faithful
S₃ action is all of GL₂(2), so its commuting plane action is represented by
a central element of S₃ and is the identity. The cubic planes span W, so
the local image's faithful representation kills its whole two-core.

This argument works for every subgroup B; neither the best-offender condition
nor nontriviality of F is needed for this step. The action image is exactly
the one defined in LocalAction, used by the normalization consumers.

Source: Aschbacher–Smith, B.1.9(1), final proof paragraph,
printed p.71 (PDF p.82), combined manuscript of 1 March 2004.
-/

public section

open Subgroup Representation.BinaryOffender
open Theory.GroupTheory.NormalSymmetricThreePairRank
namespace CFSG.Quasithin.ChapterB.FittingStructure.BestOffenderNormalization
variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V] (ρ : Representation (ZMod 2) G V)

private theorem centralizing_plane_fixes (hρ : Function.Injective ρ)
    (hlocal : LocalPlaneLaw ρ) {X : Subgroup G} (hX : X ∈ minimalMovedFactors ρ)
    {g : G} (hg : g ∈ centralizer (planeGroup ρ X : Set G)) :
    ∀ v ∈ subspaceCommutator ρ ⊤ X, ρ g v = v := by
  let K := planeGroup ρ X
  let W := subspaceCommutator ρ ⊤ X
  have hs : K ≤ subspaceStabilizer ρ W := by
    dsimp only [W, K]
    rw [← planeGroup_support_eq ρ hlocal hX]
    exact subspaceCommutator_invariant ρ ⊤ _
  let σ : Representation (ZMod 2) K W := (invariantSubspace ρ K W hs).toRepresentation
  have hi : Function.Injective σ.asGroupHom := by
    apply (injective_iff_map_eq_one _).mpr
    intro k hk
    apply Subtype.ext
    apply planeGroup_faithful_support ρ hρ hlocal hX k.property
    intro w hw
    exact congrArg Subtype.val
      (LinearMap.congr_fun (congrArg Units.val hk) (⟨w, hw⟩ : W))
  have hd : Module.finrank (ZMod 2) W = 2 :=
    (minimalMovedFactors_subset_small ρ hlocal hX).2.2
  let b := Module.finBasisOfFinrankEq (ZMod 2) W hd
  have hc : Nat.card (Module.End (ZMod 2) W)ˣ = 6 := by
    rw [← Nat.card_congr (Matrix.GeneralLinearGroup.toLin' b).toEquiv,
      Matrix.card_GL_field]
    norm_num [Fin.prod_univ_succ]
  let : Finite (Module.End (ZMod 2) W)ˣ :=
    Finite.of_equiv _ (Matrix.GeneralLinearGroup.toLin' b).toEquiv
  have hsurj : Function.Surjective σ.asGroupHom := by
    exact ((Nat.bijective_iff_injective_and_card _).mpr
      ⟨hi, (planeGroup_card ρ hρ hlocal hX).trans hc.symm⟩).2
  have hgw : g ∈ subspaceStabilizer ρ W := by
    have hn := subspaceCommutator_invariant_normalizer ρ (X := K)
      (le_subspaceStabilizer ρ ⊤ (fun _ _ _ _ => Submodule.mem_top))
      (centralizer_le_normalizer (K : Set G)) hg
    simpa only [K, planeGroup_support_eq ρ hlocal hX] using hn
  let u := (stabilizerRepresentation ρ W).asGroupHom ⟨g, hgw⟩
  obtain ⟨k, hk⟩ := hsurj u
  have he (w : W) : ρ (k : G) (w : V) = ρ g (w : V) :=
    congrArg Subtype.val (LinearMap.congr_fun (congrArg Units.val hk) w)
  have hcomm (a : K) : a * k = k * a := by
    apply hi
    apply Units.ext
    ext w
    change ρ ((a : G) * (k : G)) (w : V) = ρ ((k : G) * (a : G)) (w : V)
    simp only [map_mul, Module.End.mul_apply]
    rw [he w, he ⟨ρ (a : G) w, (hs a.property w).2 w.property⟩]
    rw [← Module.End.mul_apply, ← Module.End.mul_apply, ← map_mul, ← map_mul,
      hg a a.property]
  obtain ⟨e⟩ := planeGroup_model ρ hρ hlocal hX
  have hk1 : k = 1 := by
    apply e.injective
    rw [map_one]
    apply symmetricThree_center_trivial
    intro a
    obtain ⟨a, rfl⟩ := e.surjective a
    simpa only [map_mul] using congrArg e (hcomm a)
  intro v hv
  have he' := (he ⟨v, hv⟩).symm
  simpa only [hk1, OneMemClass.coe_one, map_one, Module.End.one_apply] using he'

private theorem centralizing_generated_fixes (hρ : Function.Injective ρ)
    (hlocal : LocalPlaneLaw ρ) {g : G}
    (hg : g ∈ centralizer (planeGenerated ρ : Set G)) :
    ∀ v ∈ support ρ, ρ g v = v := by
  have hh : support ρ ≤ LinearMap.ker (ρ g - LinearMap.id) := by
    rw [support, ← cubicSupports_iSup]
    refine iSup_le fun i v hv => ?_
    exact sub_eq_zero.mpr (centralizing_plane_fixes ρ hρ hlocal (cubicFactor_mem ρ i)
      (centralizer_le (planeGroup_le_planeGenerated ρ (cubicFactor_mem ρ i)) hg) v hv)
  intro v hv
  exact sub_eq_zero.mp (hh hv)

omit [FiniteDimensional (ZMod 2) V] in
private theorem generated_twoCore (hcore : pCore 2 G = ⊥) :
    pCore 2 (planeGenerated ρ) = ⊥ := by
  have hh : (pCore 2 (planeGenerated ρ)).map (planeGenerated ρ).subtype ≤ pCore 2 G :=
    le_sSup ⟨inferInstance, pCore_isPGroup.map _⟩
  rw [hcore] at hh
  exact ((pCore 2 (planeGenerated ρ)).map_eq_bot_iff_of_injective
    (planeGenerated ρ).subtype_injective).mp (bot_unique hh)


/-- The literal local image has trivial two-core. In fact this holds for every
subgroup B, without the best-offender or nonzero Fitting-moved hypotheses. -/
theorem actionImage_twoCore_eq_bot (hρ : Function.Injective ρ)
    (hcore : pCore 2 G = ⊥) (hlocal : LocalPlaneLaw ρ) (B : Subgroup G) :
    pCore 2 (actionImage ρ B) = ⊥ := by
  let E := planeGenerated ρ
  have hEL : E ≤ localGroup ρ B := le_sup_left
  let f : E →* actionImage ρ B := (actionHom ρ B).comp (inclusion hEL)
  have hfi : Function.Injective f := by
    intro x y he
    exact (inclusion_injective hEL) (actionHom_eq_of_mem_planeGenerated ρ hρ hlocal B
      (inclusion hEL x) (inclusion hEL y) x.property y.property he)
  have hr : f.range = (E.subgroupOf (localGroup ρ B)).map (actionHom ρ B) := by
    ext a
    constructor
    · rintro ⟨e, rfl⟩
      exact ⟨inclusion hEL e, e.property, rfl⟩
    · rintro ⟨e, he, rfl⟩
      exact ⟨⟨e, he⟩, rfl⟩
  have hn : f.range.Normal := by
    rw [hr]
    exact (inferInstance : (E.subgroupOf (localGroup ρ B)).Normal).map _
      (actionHom_surjective ρ B)
  let := hn
  have hp : (pCore 2 (actionImage ρ B)).comap f ≤ pCore 2 E :=
    le_sSup ⟨inferInstance, pCore_isPGroup.comap_of_injective f hfi⟩
  have hb : (pCore 2 (actionImage ρ B)).comap f ≤ ⊥ :=
    hp.trans_eq (generated_twoCore ρ hcore)
  have hint : pCore 2 (actionImage ρ B) ⊓ f.range ≤ ⊥ := by
    rintro a ⟨ha, e, rfl⟩
    have he : e = 1 := hb ha
    simpa only [he, map_one] using (one_mem (⊥ : Subgroup (actionImage ρ B)))
  have hcent : pCore 2 (actionImage ρ B) ≤ centralizer (f.range : Set (actionImage ρ B)) :=
    commutator_eq_bot_iff_le_centralizer.mp
      (bot_unique ((commutator_le_inf _ _).trans hint))
  apply bot_unique
  intro a ha
  obtain ⟨g, rfl⟩ := actionHom_surjective ρ B a
  have hg : (g : G) ∈ centralizer (E : Set G) := by
    intro x hx
    let xE : E := ⟨x, hx⟩
    let xH := inclusion hEL xE
    let yH := g * xH * g⁻¹
    have hy : (yH : G) ∈ planeGenerated ρ :=
      (planeGenerated_normal ρ).conj_mem x hx g
    have he : actionHom ρ B yH = actionHom ρ B xH := by
      have hh := hcent ha (f xE) ⟨xE, rfl⟩
      change actionHom ρ B xH * actionHom ρ B g =
        actionHom ρ B g * actionHom ρ B xH at hh
      simp only [yH, map_mul, map_inv]
      rw [← hh, mul_assoc, mul_inv_cancel, mul_one]
    have he' := actionHom_eq_of_mem_planeGenerated ρ hρ hlocal B yH xH hy hx he
    have hconj : (g : G) * x * (g : G)⁻¹ = x := congrArg Subtype.val he'
    exact (mul_inv_eq_iff_eq_mul.mp hconj).symm
  change actionHom ρ B g = 1
  apply imageRepresentation_injective ρ B
  ext w
  exact centralizing_generated_fixes ρ hρ hlocal hg w w.property

end CFSG.Quasithin.ChapterB.FittingStructure.BestOffenderNormalization
