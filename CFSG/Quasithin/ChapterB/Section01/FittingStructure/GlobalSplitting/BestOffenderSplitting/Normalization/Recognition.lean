module

public import CFSG.Quasithin.ChapterB.Section01.SolvableStructure.SourceTheorems
public import Theory.Representation.BinaryOffender.GeneratedCore

/-!
# Recognizing a normally generated source plane in solvable FF factors

An injective order-six image normally generated by a minimal best offender
is one of the actual B.1.8 factors. Minimal-offender classification puts its
actor in a factor Sylow subgroup. Normal generation first places its whole
image in J, then in that factor, whose order is also six. Relative factor
normality therefore makes all of J normalize this image.

The application to the source groups is in the parent Normalization module.
Only B.1.8(1)–(4) are used; the false arbitrary-family assertion is unused.
Source: Aschbacher–Smith, B.1.8 and B.1.9(1), printed pp.70–71.
-/

public section

open Subgroup Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterB.FittingStructure.BestOffenderNormalization
variable {H U K : Type*} [Group H] [Finite H] [AddCommGroup U] [Module (ZMod 2) U]
  [FiniteDimensional (ZMod 2) U] [Group K]
  (σ : Representation (ZMod 2) H U)

theorem offenderSubgroup_normalizes_six_image
    (hs : Group.IsSolvable H) (hc : pCore 2 H = ⊥) (hf : Function.Injective σ)
    (f : K →* H) (hfi : Function.Injective f) (hcard : Nat.card K = 6)
    (A : Subgroup K) (hgen : normalClosure (A : Set K) = ⊤)
    (hA : IsMinimalBestOffender σ (A.map f)) :
    offenderSubgroup σ ≤ normalizer (f.range : Set H) := by
  obtain ⟨d, _, hm, _⟩ := source_lemma_B_1_8_corrected σ hs hc hf
    ⟨A.map f, hA.1.isOffender σ⟩
  obtain ⟨i, S, hi⟩ := (hm (A.map f)).mp hA
  have hAf : A.map f ≤ d.factor i := hi ▸ d.toSolvableFFFactors.factorSylow_le i S
  let : (offenderSubgroup σ).Normal := offenderSubgroup_normal σ
  have hAJ : A ≤ (offenderSubgroup σ).comap f :=
    map_le_iff_le_comap.mp (hA.1.le_offenderSubgroup σ)
  have hKJ : ∀ k : K, f k ∈ offenderSubgroup σ := by
    intro k
    exact normalClosure_le_normal hAJ (hgen ▸ mem_top k)
  let fJ : K →* offenderSubgroup σ := f.codRestrict _ hKJ
  let N := ((d.factor i).subgroupOf (offenderSubgroup σ)).comap fJ
  let : ((d.factor i).subgroupOf (offenderSubgroup σ)).Normal :=
    d.toSolvableFFFactors.factor_normal_in_offenderSubgroup i
  have hAN : A ≤ N := by
    intro a ha
    exact hAf (mem_map_of_mem f ha)
  have hKN : (⊤ : Subgroup K) ≤ N := by
    rw [← hgen]
    exact normalClosure_le_normal hAN
  have hr : f.range ≤ d.factor i := by
    rintro x ⟨k, rfl⟩
    exact hKN (mem_top k)
  have he : f.range = d.factor i := eq_of_le_of_card_ge hr (by
    rw [d.toSolvableFFFactors.factor_card,
      ← Nat.card_congr (MonoidHom.ofInjective hfi).toEquiv, hcard])
  rw [he]
  exact (normal_subgroupOf_iff_le_normalizer
    (d.toSolvableFFFactors.factor_le_offenderSubgroup i)).mp
    (d.toSolvableFFFactors.factor_normal_in_offenderSubgroup i)

end CFSG.Quasithin.ChapterB.FittingStructure.BestOffenderNormalization
