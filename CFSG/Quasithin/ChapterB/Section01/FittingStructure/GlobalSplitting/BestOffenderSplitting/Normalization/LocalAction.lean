module

public import CFSG.Quasithin.ChapterB.Section01.FittingStructure.GlobalSplitting.BestOffenderSplitting.Basic
public import Theory.GroupTheory.NormalizedSupConsequences
public import Theory.Representation.BinaryOffender.MovedSpaceTransport
public import Theory.GroupTheory.SylowNormalizerCommutingFamily

/-!
# The local action for arbitrary best-offender normalization

Let E be generated by the source plane groups and W=[V,F]. Conjugation
permutes the source cubic subgroups and hence normalizes E. The commuting
S₃ factors make E solvable, so E B is solvable for every elementary B.
We construct its literal image on W and its faithful image representation.

The action of E on W is faithful: each plane group fixes C_V(F), and
odd-order splitting gives V=C_V(F)⊕W. These facts will lift normalization
from the local image back to the original source groups. Triviality of the
local image's two-core is a separate obligation; it is not asserted here.

Source: Aschbacher–Smith, B.1.9(1), final proof paragraph,
printed p.71 (PDF p.82), combined manuscript of 1 March 2004.
-/

@[expose] public section

open Subgroup Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterB.FittingStructure.BestOffenderNormalization
variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

noncomputable def support : Submodule (ZMod 2) V :=
  subspaceCommutator ρ ⊤ (fittingMoved ρ)

noncomputable def localGroup (B : Subgroup G) : Subgroup G := planeGenerated ρ ⊔ B

noncomputable def localRepresentation (B : Subgroup G) :
    Representation (ZMod 2) (localGroup ρ B) V := ρ.comp (localGroup ρ B).subtype

noncomputable abbrev actionImage (B : Subgroup G) :=
  subspaceActionImage (localRepresentation ρ B) (support ρ)

noncomputable def imageRepresentation (B : Subgroup G) :
    Representation (ZMod 2) (actionImage ρ B) (support ρ) :=
  subspaceImageRepresentation (localRepresentation ρ B) (support ρ)

omit [Finite G] in
theorem support_stable : (⊤ : Subgroup G) ≤ subspaceStabilizer ρ (support ρ) := by
  apply subspaceCommutator_invariant_normalizer ρ
  · exact le_subspaceStabilizer ρ ⊤ (fun _ _ _ _ => Submodule.mem_top)
  · exact le_normalizer_of_normal

theorem local_support_stable (B : Subgroup G) :
    (⊤ : Subgroup (localGroup ρ B)) ≤
      subspaceStabilizer (localRepresentation ρ B) (support ρ) := by
  intro g _
  exact support_stable ρ (mem_top (g : G))

noncomputable def actionHom (B : Subgroup G) : localGroup ρ B →* actionImage ρ B :=
  (subgroupActionHom (localRepresentation ρ B) (support ρ) ⊤
    (local_support_stable ρ B)).comp Subgroup.topEquiv.symm.toMonoidHom

theorem actionHom_surjective (B : Subgroup G) : Function.Surjective (actionHom ρ B) := by
  intro x
  obtain ⟨g, rfl⟩ := (stabilizerRepresentation (localRepresentation ρ B)
    (support ρ)).asGroupHom.rangeRestrict_surjective x
  exact ⟨g, rfl⟩

theorem actionHom_apply (B : Subgroup G) (g : localGroup ρ B) (w : support ρ) :
    (imageRepresentation ρ B (actionHom ρ B g) w : V) = ρ g w := rfl

theorem imageRepresentation_injective (B : Subgroup G) :
    Function.Injective (imageRepresentation ρ B) :=
  subspaceImageRepresentation_injective _ _

theorem restricted_eq_map (B : Subgroup G) (A : Subgroup (localGroup ρ B)) :
    restrictedSubgroup (localRepresentation ρ B) (support ρ) A = A.map (actionHom ρ B) := by
  ext x
  constructor
  · rintro ⟨a, ha, rfl⟩
    exact ⟨a, ha, rfl⟩
  · rintro ⟨a, ha, rfl⟩
    exact ⟨⟨a, local_support_stable ρ B (mem_top a)⟩, ha, rfl⟩

theorem planeGroup_le_planeGenerated {X : Subgroup G} (hX : X ∈ minimalMovedFactors ρ) :
    planeGroup ρ X ≤ planeGenerated ρ := by
  obtain ⟨i, rfl⟩ := (range_cubicFactor ρ).symm ▸ hX
  exact le_iSup (fun j => planeGroup ρ (cubicFactor ρ j)) i

instance planeGenerated_normal : (planeGenerated ρ).Normal := by
  apply normalizer_eq_top_iff.mp
  apply top_unique
  intro g _
  apply mem_normalizer_iff_map_conj_eq.mpr
  apply eq_of_le_of_card_ge
  · change (⨆ i, planeGroup ρ (cubicFactor ρ i)).map (MulAut.conj g).toMonoidHom ≤ _
    rw [Subgroup.map_iSup]
    exact iSup_le fun i => (planeGroup_map_conj_le ρ _ g).trans
      (planeGroup_le_planeGenerated ρ (minimalMovedFactors_map_conj ρ (cubicFactor_mem ρ i) g))
  · rw [card_map_of_injective (MulAut.conj g).injective]

variable [FiniteDimensional (ZMod 2) V]

theorem planeGenerated_solvable (hρ : Function.Injective ρ) (hlocal : LocalPlaneLaw ρ) :
    Group.IsSolvable (planeGenerated ρ) := by
  classical
  let H := fun i => planeGroup ρ (cubicFactor ρ i)
  have hcomm : Pairwise fun i j => ∀ x y : G, x ∈ H i → y ∈ H j → Commute x y := by
    intro i j hij x y hx hy
    exact (mem_centralizer_iff.mp (planeGroups_commute ρ hρ hlocal
      (cubicFactor_mem ρ i) (cubicFactor_mem ρ j)
      (fun he => hij (cubicFactor_injective ρ he)) hx) y hy).symm
  let : Group.IsSolvable (Equiv.Perm (Fin 3)) := by
    let : Group.IsSolvable (alternatingGroup (Fin 3)) := Group.isSolvable_of_comm (by decide)
    apply Group.isSolvable_of_ker_le_range (alternatingGroup (Fin 3)).subtype Equiv.Perm.sign
    rw [Subgroup.range_subtype, ← alternatingGroup_eq_sign_ker]
  let hs : ∀ i, Group.IsSolvable (H i) := fun i => by
    obtain ⟨e⟩ := planeGroup_model ρ hρ hlocal (cubicFactor_mem ρ i)
    exact Group.isSolvable_of_isSolvable_injective (f := e.toMonoidHom) e.injective
  let : Group.IsSolvable ((i : Fin (cubicCount ρ)) → H i) := Group.isSolvable_finite_pi _
  let f := Subgroup.noncommPiCoprod hcomm
  have hr : f.range = planeGenerated ρ := Subgroup.noncommPiCoprod_range
  rw [← hr]
  exact Group.isSolvable_of_surjective f.rangeRestrict_surjective

theorem localGroup_solvable (hρ : Function.Injective ρ) (hlocal : LocalPlaneLaw ρ)
    {B : Subgroup G} (hB : IsElementaryTwo B) : Group.IsSolvable (localGroup ρ B) := by
  let := hB.2
  let := planeGenerated_solvable ρ hρ hlocal
  exact Group.isSolvable_sup_of_normalizes _ _ le_normalizer_of_normal

theorem actionImage_solvable (hρ : Function.Injective ρ) (hlocal : LocalPlaneLaw ρ)
    {B : Subgroup G} (hB : IsElementaryTwo B) : Group.IsSolvable (actionImage ρ B) := by
  let := localGroup_solvable ρ hρ hlocal hB
  exact Group.isSolvable_of_surjective (actionHom_surjective ρ B)

omit [FiniteDimensional (ZMod 2) V] in
theorem plane_support_le {X : Subgroup G} (hX : X ∈ minimalMovedFactors ρ) :
    subspaceCommutator ρ ⊤ X ≤ support ρ := by
  obtain ⟨i, rfl⟩ := (range_cubicFactor ρ).symm ▸ hX
  rw [support, ← cubicSupports_iSup]
  exact le_iSup (fun j => subspaceCommutator ρ ⊤ (cubicFactor ρ j)) i

omit [FiniteDimensional (ZMod 2) V] in
theorem planeGenerated_fixes_complement (hlocal : LocalPlaneLaw ρ) :
    fixedSpace ρ (fittingMoved ρ) ≤ fixedSpace ρ (planeGenerated ρ) := by
  have hk : planeGenerated ρ ≤ subspaceKernel ρ (fixedSpace ρ (fittingMoved ρ)) ⊤ := by
    refine iSup_le fun i g hg => ⟨mem_top g, fun v hv => ?_⟩
    apply planeGroup_fixes_cubic_complement ρ hlocal (cubicFactor_mem ρ i) _ ⟨g, hg⟩
    exact fun x => hv ⟨x, cubicFactor_le ρ i x.property⟩
  exact fun v hv g => (hk g.property).2 v hv

theorem planeGenerated_faithful_support (hρ : Function.Injective ρ)
    (hlocal : LocalPlaneLaw ρ) {g : G} (hg : g ∈ planeGenerated ρ)
    (hfix : ∀ w ∈ support ρ, ρ g w = w) : g = 1 := by
  have hs : fixedSpace ρ (fittingMoved ρ) ⊔ support ρ = ⊤ := by
    have ho : Odd (Nat.card (fittingMoved ρ)) := by
      rw [fittingMoved_card ρ hρ hlocal]
      exact Odd.pow (by decide : Odd 3)
    have hc := Representation.GoldschmidtONan.isCompl_fixed_moved_of_odd (ρ := ρ) ho
    convert hc.sup_eq_top using 2
    unfold support subspaceCommutator Representation.RegularCyclicNormalClosure.displacementSpan
    congr 1
    ext v
    simp only [eq_comm]
  apply hρ
  ext v
  obtain ⟨c, hc, w, hw, rfl⟩ := Submodule.mem_sup.mp (hs ▸ Submodule.mem_top (x := v))
  have hgc : ρ g c = c := planeGenerated_fixes_complement ρ hlocal hc ⟨g, hg⟩
  rw [map_add, hgc, hfix w hw]
  simp

/-- Equality in the action image lifts on E, with its original inclusion. -/
theorem actionHom_eq_of_mem_planeGenerated (hρ : Function.Injective ρ)
    (hlocal : LocalPlaneLaw ρ) (B : Subgroup G) (x y : localGroup ρ B)
    (hx : (x : G) ∈ planeGenerated ρ) (hy : (y : G) ∈ planeGenerated ρ)
    (he : actionHom ρ B x = actionHom ρ B y) : x = y := by
  apply inv_mul_eq_one.mp
  apply Subtype.ext
  apply planeGenerated_faithful_support ρ hρ hlocal
    ((planeGenerated ρ).mul_mem ((planeGenerated ρ).inv_mem hx) hy)
  intro w hw
  have he' : actionHom ρ B (x⁻¹ * y) = 1 := by
    rw [map_mul, map_inv, he, inv_mul_cancel]
  have hh := congrArg (fun a => imageRepresentation ρ B a ⟨w, hw⟩) he'
  exact congrArg Subtype.val hh

end CFSG.Quasithin.ChapterB.FittingStructure.BestOffenderNormalization
