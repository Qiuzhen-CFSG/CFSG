module

public import CFSG.Quasithin.ChapterB.Section01.FittingStructure.GlobalSplitting.Sylows
public import Theory.GroupTheory.NormalSymmetricThreePairRank.Inner
public import Mathlib.Data.Fintype.Perm

/-!
# The commuting centralizer factor in B.1.9

Write E for the subgroup generated by the actual source groups Gᵢ, and R for
J_P(C_G(F)). An involution centralizing a cubic Fᵢ normalizes its associated
Gᵢ. Its induced involutive automorphism of S₃ fixes the cubic pointwise and
is therefore trivial. Thus R centralizes E. The commuting S₃ factors make
E centerless, so E and R have trivial intersection.

We also prove that an element normalizing every Gᵢ is a product of an
element of E and an element centralizing E. Each factor automorphism is
inner; multiplying the inner conjugators under the literal subgroup
inclusions gives the required element of E. These constructions do not
assume that an arbitrary best offender normalizes every Gᵢ, or that its
projection to the centralizer is a best offender. Those are separate
obligations before the equality J(G,V)=E R can be asserted.

Source: Aschbacher–Smith, B.1.9(1), printed p.71 (PDF p.82).
-/

public section

open Subgroup Representation.BinaryOffender
open Theory.GroupTheory.NormalSymmetricThreePairRank
namespace CFSG.Quasithin.ChapterB.FittingStructure

private theorem cubic_involution_commute (k x : Equiv.Perm (Fin 3))
    (hk : k ^ 2 = 1) (hx : x ^ 3 = 1) (hne : x ≠ 1)
    (hc : k * x = x * k) : k = 1 := by
  have hall : ∀ a b : Equiv.Perm (Fin 3),
      (a ^ 2 = 1 ∧ b ^ 3 = 1 ∧ b ≠ 1 ∧ a * b = b * a) → a = 1 := by
    decide +kernel
  exact hall k x ⟨hk, hx, hne, hc⟩

private theorem involutive_aut_fix_cubic (α : MulAut (Equiv.Perm (Fin 3)))
    (hsq : α ^ 2 = 1) (x : Equiv.Perm (Fin 3))
    (hx : x ^ 3 = 1) (hne : x ≠ 1) (hfix : α x = x) : α = 1 := by
  obtain ⟨k, rfl⟩ := symmetricThree_aut_inner α
  have hk : k ^ 2 = 1 := by
    apply symmetricThree_center_trivial
    intro y
    have he := congrArg (fun f : MulAut (Equiv.Perm (Fin 3)) => f y) hsq
    change k * (k * y * k⁻¹) * k⁻¹ = y at he
    have hc : k ^ 2 * y * (k ^ 2)⁻¹ = y := by
      simpa only [pow_two, mul_inv_rev, mul_assoc] using he
    exact (mul_inv_eq_iff_eq_mul.mp hc).symm
  have hc : k * x = x * k := mul_inv_eq_iff_eq_mul.mp hfix
  rw [cubic_involution_commute k x hk hx hne hc, map_one]

variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V] (ρ : Representation (ZMod 2) G V)

theorem involution_centralizing_cubic_centralizes_planeGroup (hρ : Function.Injective ρ) (hlocal : LocalPlaneLaw ρ)
    {X : Subgroup G} (hX : X ∈ minimalMovedFactors ρ)
    {b : G} (hb : b ^ 2 = 1) (hc : b ∈ centralizer (X : Set G)) :
    b ∈ centralizer (planeGroup ρ X : Set G) := by
  have hn : b ∈ normalizer (planeGroup ρ X : Set G) :=
    normalizer_le_normalizer_planeGroup ρ X (centralizer_le_normalizer _ hc)
  let bn : normalizer (planeGroup ρ X : Set G) := ⟨b, hn⟩
  let α : MulAut (planeGroup ρ X) := (planeGroup ρ X).normalizerMonoidHom bn
  have hs : α ^ 2 = 1 := by
    dsimp only [α]
    rw [← map_pow, show bn ^ 2 = 1 from Subtype.ext hb, map_one]
  obtain ⟨e⟩ := planeGroup_model ρ hρ hlocal hX
  let β : MulAut (Equiv.Perm (Fin 3)) := MulAut.congr e α
  have hsβ : β ^ 2 = 1 := by
    change (MulAut.congr e) α ^ 2 = 1
    rw [← map_pow, hs, map_one]
  have hcard : Nat.card X = 3 := (minimalMovedFactors_subset_small ρ hlocal hX).2.1
  have hxne : X ≠ ⊥ := by
    intro he
    simp [he] at hcard
  obtain ⟨x, hx, hx1⟩ := (X.bot_or_exists_ne_one.resolve_left hxne)
  let xg : planeGroup ρ X := ⟨x, cubic_le_planeGroup ρ hX hx⟩
  have hx3 : x ^ 3 = 1 := by
    have he := pow_card_eq_one' (x := (⟨x, hx⟩ : X))
    rw [hcard] at he
    exact congrArg Subtype.val he
  have hβ : β = 1 := by
    apply involutive_aut_fix_cubic β hsβ (e xg)
    · rw [← map_pow, show xg ^ 3 = 1 from Subtype.ext hx3, map_one]
    · intro he
      apply hx1
      exact congrArg Subtype.val (e.injective (he.trans e.map_one.symm))
    · change e (α (e.symm (e xg))) = e xg
      rw [e.symm_apply_apply]
      apply congrArg e
      apply Subtype.ext
      change b * x * b⁻¹ = x
      exact mul_inv_eq_iff_eq_mul.mpr (hc x hx).symm
  have hα : α = 1 := (MulAut.congr e).injective (hβ.trans (map_one _).symm)
  intro y hy
  have he := congrArg Subtype.val (congrArg (fun f : MulAut (planeGroup ρ X) =>
    f ⟨y, hy⟩) hα)
  change b * y * b⁻¹ = y at he
  exact (mul_inv_eq_iff_eq_mul.mp he).symm

/-- The subgroup E in B.1.9(1), with the original inclusions. -/
@[expose] noncomputable def planeGenerated : Subgroup G :=
  ⨆ i, planeGroup ρ (cubicFactor ρ i)

/-- The residual source group J_P(C_G(F)). -/
@[expose] noncomputable def centralizingBestGenerated : Subgroup G :=
  generatedBy {A | IsBestOffender ρ A} (centralizer (fittingMoved ρ : Set G))

omit [FiniteDimensional (ZMod 2) V] in
theorem planeGenerated_le_offenderSubgroup : planeGenerated ρ ≤ offenderSubgroup ρ := by
  exact iSup_le fun i => (planeGroup_le_minimalGenerated ρ _).trans (minimalGenerated_le ρ)

omit [Finite G] [FiniteDimensional (ZMod 2) V] in
theorem centralizingBestGenerated_le_offenderSubgroup :
    centralizingBestGenerated ρ ≤ offenderSubgroup ρ := by
  exact iSup_le fun A => iSup_le fun hA =>
    le_iSup_of_le A (le_iSup_of_le ⟨hA.1, le_top⟩ le_rfl)

omit [FiniteDimensional (ZMod 2) V] in
theorem fittingMoved_le_planeGenerated : fittingMoved ρ ≤ planeGenerated ρ := by
  rw [← cubicFactor_iSup]
  exact iSup_mono fun i => cubic_le_planeGroup ρ (cubicFactor_mem ρ i)

omit [Finite G] [FiniteDimensional (ZMod 2) V] in
theorem centralizingBestGenerated_le_centralizer_fittingMoved :
    centralizingBestGenerated ρ ≤ centralizer (fittingMoved ρ : Set G) := by
  exact iSup_le fun A => iSup_le fun hA => hA.2

theorem elementary_centralizing_cubic_centralizes_planeGroup
    (hρ : Function.Injective ρ) (hlocal : LocalPlaneLaw ρ)
    {X A : Subgroup G} (hX : X ∈ minimalMovedFactors ρ)
    (hA : IsElementaryTwo A) (hc : A ≤ centralizer (X : Set G)) :
    A ≤ centralizer (planeGroup ρ X : Set G) := by
  let _ : IsElementaryAbelian 2 A := hA.2
  intro b hb
  exact involution_centralizing_cubic_centralizes_planeGroup ρ hρ hlocal hX
    (elemPow_eq_one_of_isElementaryAbelian b hb) (hc hb)

theorem centralizingBestGenerated_le_centralizer_planeGenerated
    (hρ : Function.Injective ρ) (hlocal : LocalPlaneLaw ρ) :
    centralizingBestGenerated ρ ≤ centralizer (planeGenerated ρ : Set G) := by
  rw [le_centralizer_iff]
  refine iSup_le fun i => ?_
  rw [le_centralizer_iff]
  refine iSup_le fun A => iSup_le fun hA => ?_
  apply elementary_centralizing_cubic_centralizes_planeGroup ρ hρ hlocal
    (cubicFactor_mem ρ i) hA.1.1
  exact hA.2.trans (centralizer_le (cubicFactor_le ρ i))

/-- A normalizing element acts by an inner automorphism of the actual S3 factor. -/
theorem normalizing_planeGroup_inner (hρ : Function.Injective ρ) (hlocal : LocalPlaneLaw ρ)
    {X : Subgroup G} (hX : X ∈ minimalMovedFactors ρ) (b : G)
    (hn : b ∈ normalizer (planeGroup ρ X : Set G)) :
    ∃ k : planeGroup ρ X, ∀ x : planeGroup ρ X,
      b * (x : G) * b⁻¹ = (k * x * k⁻¹ : planeGroup ρ X) := by
  let α : MulAut (planeGroup ρ X) := (planeGroup ρ X).normalizerMonoidHom ⟨b, hn⟩
  obtain ⟨e⟩ := planeGroup_model ρ hρ hlocal hX
  let β : MulAut (Equiv.Perm (Fin 3)) := MulAut.congr e α
  obtain ⟨k, hk⟩ := symmetricThree_aut_inner β
  refine ⟨e.symm k, fun x => ?_⟩
  have hx : α x = e.symm k * x * (e.symm k)⁻¹ := by
    apply e.injective
    have he := DFunLike.congr_fun hk (e x)
    change e (α (e.symm (e x))) = k * e x * k⁻¹ at he
    simpa only [e.symm_apply_apply, map_mul, map_inv, e.apply_symm_apply] using he
  exact congrArg Subtype.val hx

theorem normalizing_planeGroups_decomposition
    (hρ : Function.Injective ρ) (hlocal : LocalPlaneLaw ρ) (b : G)
    (hn : ∀ i, b ∈ normalizer (planeGroup ρ (cubicFactor ρ i) : Set G)) :
    ∃ k ∈ planeGenerated ρ, ∃ c ∈ centralizer (planeGenerated ρ : Set G), b = k * c := by
  classical
  let H := fun i => planeGroup ρ (cubicFactor ρ i)
  have hcomm : Pairwise fun i j => ∀ x y : G, x ∈ H i → y ∈ H j → Commute x y := by
    intro i j hij x y hx hy
    exact (mem_centralizer_iff.mp (planeGroups_commute ρ hρ hlocal
      (cubicFactor_mem ρ i) (cubicFactor_mem ρ j)
      (fun he => hij (cubicFactor_injective ρ he)) hx) y hy).symm
  choose k hk using fun i => normalizing_planeGroup_inner ρ hρ hlocal
    (cubicFactor_mem ρ i) b (hn i)
  let f := Subgroup.noncommPiCoprod hcomm
  have hkf (i) (x : H i) : f k * (x : G) * (f k)⁻¹ = (k i * x * (k i)⁻¹ : H i) := by
    have hsingle : k * Pi.mulSingle i x * k⁻¹ = Pi.mulSingle i (k i * x * (k i)⁻¹) := by
      ext j
      by_cases hji : j = i
      · subst j
        simp
      · simp [Pi.mulSingle_eq_of_ne hji]
    have he := congrArg f hsingle
    simpa only [map_mul, map_inv, f, Subgroup.noncommPiCoprod_mulSingle] using he
  let c : G := (f k)⁻¹ * b
  have hcf (i) (x : G) (hx : x ∈ H i) : x * c = c * x := by
    have he := (hk i ⟨x, hx⟩).trans (hkf i ⟨x, hx⟩).symm
    have hh := congrArg (fun z : G => (f k)⁻¹ * z * b) he
    simpa [c, mul_assoc] using hh.symm
  have hEc : planeGenerated ρ ≤ centralizer ({c} : Set G) := by
    refine iSup_le fun i x hx y hy => ?_
    obtain rfl := Set.mem_singleton_iff.mp hy
    exact (hcf i x hx).symm
  refine ⟨f k, ?_, c, ?_, ?_⟩
  · change f k ∈ ⨆ i, H i
    rw [← Subgroup.noncommPiCoprod_range (hcomm := hcomm)]
    exact ⟨k, rfl⟩
  · intro x hx
    exact ((hEc hx) c rfl).symm
  · dsimp only [c]
    group

/-- The common plane normalizer acts through E and its centralizer. -/
theorem le_planeGenerated_sup_centralizer_of_normalizing
    (hρ : Function.Injective ρ) (hlocal : LocalPlaneLaw ρ) (B : Subgroup G)
    (hn : ∀ i, B ≤ normalizer (planeGroup ρ (cubicFactor ρ i) : Set G)) :
    B ≤ planeGenerated ρ ⊔ centralizer (planeGenerated ρ : Set G) := by
  intro b hb
  obtain ⟨k, hk, c, hc, rfl⟩ := normalizing_planeGroups_decomposition ρ hρ hlocal b
    (fun i => hn i hb)
  exact mul_mem
    ((le_sup_left : planeGenerated ρ ≤ planeGenerated ρ ⊔
      centralizer (planeGenerated ρ : Set G)) hk)
    ((le_sup_right : centralizer (planeGenerated ρ : Set G) ≤ planeGenerated ρ ⊔
      centralizer (planeGenerated ρ : Set G)) hc)

/-- The actual generated product of the source S3 factors is centerless. -/
theorem planeGenerated_inf_centralizer_eq_bot
    (hρ : Function.Injective ρ) (hlocal : LocalPlaneLaw ρ) :
    planeGenerated ρ ⊓ centralizer (planeGenerated ρ : Set G) = ⊥ := by
  classical
  let H := fun i => planeGroup ρ (cubicFactor ρ i)
  have hcomm : Pairwise fun i j => ∀ x y : G, x ∈ H i → y ∈ H j → Commute x y := by
    intro i j hij x y hx hy
    exact (mem_centralizer_iff.mp (planeGroups_commute ρ hρ hlocal
      (cubicFactor_mem ρ i) (cubicFactor_mem ρ j)
      (fun he => hij (cubicFactor_injective ρ he)) hx) y hy).symm
  let f := Subgroup.noncommPiCoprod hcomm
  apply le_bot_iff.mp
  intro z hz
  have hz' : z ∈ f.range := by
    rw [Subgroup.noncommPiCoprod_range]
    exact hz.1
  obtain ⟨k, rfl⟩ := hz'
  have hk (i) : k i = 1 := by
    obtain ⟨e⟩ := planeGroup_model ρ hρ hlocal (cubicFactor_mem ρ i)
    have hc (x : H i) : x * k i = k i * x := by
      have hsingle : k * Pi.mulSingle i x * k⁻¹ = Pi.mulSingle i (k i * x * (k i)⁻¹) := by
        ext j
        by_cases hji : j = i
        · subst j
          simp
        · simp [Pi.mulSingle_eq_of_ne hji]
      have he := congrArg f hsingle
      simp only [map_mul, map_inv, f, Subgroup.noncommPiCoprod_mulSingle] at he
      have hzx : (x : G) * f k = f k * x := hz.2 x ((le_iSup H i) x.property)
      have hconj : f k * (x : G) * (f k)⁻¹ = x := mul_inv_eq_iff_eq_mul.mpr hzx.symm
      have hki : k i * x * (k i)⁻¹ = x := Subtype.ext (he.symm.trans hconj)
      exact (mul_inv_eq_iff_eq_mul.mp hki).symm
    apply e.injective
    rw [map_one]
    apply symmetricThree_center_trivial
    intro y
    obtain ⟨x, rfl⟩ := e.surjective y
    exact (map_mul e x (k i)).symm.trans ((congrArg e (hc x)).trans (map_mul e _ _))
  have he : k = 1 := funext hk
  change f k = 1
  rw [he, map_one]

/-- E and the source residual J_P(C_G(F)) have trivial intersection. -/
theorem planeGenerated_inf_centralizingBestGenerated_eq_bot
    (hρ : Function.Injective ρ) (hlocal : LocalPlaneLaw ρ) :
    planeGenerated ρ ⊓ centralizingBestGenerated ρ = ⊥ := by
  apply le_bot_iff.mp
  exact (inf_le_inf_left _ (centralizingBestGenerated_le_centralizer_planeGenerated
    ρ hρ hlocal)).trans_eq (planeGenerated_inf_centralizer_eq_bot ρ hρ hlocal)

end CFSG.Quasithin.ChapterB.FittingStructure
