/-!
# Global Fitting splitting from local planes

Assuming the local-plane law from the first paragraph of B.1.9, construct
all fields of its Decomposition contract. The literal source groups Gᵢ,
generated by the minimal offenders sharing Fᵢ, are independent S₃ factors.
Their inclusion product, together with J_P(C_G(F)), is the actual J(G,V).
The embedded odd cores form F, and F × C_F(G)(J*) is the original Fitting
subgroup. The rank-two supports have an inclusion-compatible linear sum,
and all noncentral minimal offenders are exactly the embedded Sylow-two
subgroups of the Gᵢ. The re-exported projective models identify them with L₂(2).

The imported commutator control also proves [J*,A] ≤ F for each such A,
and centrality proves F ≤ Z(F(G)). These are the precise inputs consumed by
the parent's conclusion_of_decomposition for clause (5). LocalPlaneLaw is
an explicit hypothesis here; its source proof and unconditional B.1.9
assembly remain with the parent FittingStructure task.

Source: Aschbacher–Smith, B.1.9, printed pp.71–72 (PDF pp.82–83).
-/

public section

namespace CFSG.Quasithin.ChapterB.FittingStructure
open Subgroup Representation.BinaryOffender
variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V] (ρ : Representation (ZMod 2) G V)

/-- All the global constructions in B.1.9(1–4), conditional only on the
local-plane law supplied by the first paragraph of the source proof. -/
theorem nonempty_decomposition_of_localPlaneLaw
    (hρ : Function.Injective ρ) (hcore : pCore 2 G = ⊥)
    (hF : fittingMoved ρ ≠ ⊥) (hlocal : LocalPlaneLaw ρ) :
    Nonempty (Decomposition ρ) := by
  obtain ⟨e, he, hr⟩ := exists_offenderProduct ρ hρ hcore hlocal
  obtain ⟨f, hf⟩ := exists_fittingProduct ρ hρ hcore hlocal
  obtain ⟨l, hl⟩ := exists_planeGroupSum ρ hρ hlocal
  refine ⟨{
    count := cubicCount ρ
    count_pos := cubicCount_pos ρ hF
    factor := fun i => planeGroup ρ (cubicFactor ρ i)
    factorModel := fun i => Classical.choice (planeGroup_model ρ hρ hlocal (cubicFactor_mem ρ i))
    groupProduct := e
    groupProduct_single := he
    groupProduct_residual := hr
    oddFactor := cubicFactor ρ
    oddFactor_eq := fun i => planeGroup_oddCore_eq ρ hρ hlocal (cubicFactor_mem ρ i)
    oddFactorModel := cubicFactorModel ρ hlocal
    oddProduct := cubicProduct ρ hρ hlocal
    oddProduct_single := cubicProduct_single ρ hρ hlocal
    fittingProduct := f
    fittingProduct_apply := hf
    moved_eq := fun i => (planeGroup_support_eq ρ hlocal (cubicFactor_mem ρ i)).symm
    dimension := ?_
    moduleSum := l
    moduleSum_single := hl
    noncentral_offenders := noncentral_minimal_iff_planeGroup_sylow ρ hρ hlocal }⟩
  intro i
  rw [planeGroup_support_eq ρ hlocal (cubicFactor_mem ρ i)]
  exact cubicFactor_dimension ρ hlocal i

end CFSG.Quasithin.ChapterB.FittingStructure
