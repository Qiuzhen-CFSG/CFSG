module

public import CFSG.Quasithin.ChapterB.Section01.FittingStructure.MinimalPlanes.FixedKernel
public import Theory.GroupTheory.PResidualCommutator
public import Theory.GroupTheory.NormalizedSupConsequences

/-!
# The local group in the Fitting fixed-space reduction

For F_A=[F(G),A] and elementary abelian A, coprime action gives
[F_A,A]=F_A. The group H=F_A A is solvable and normally generated by A.
Its odd-index subgroup A is Sylow, so its two-core lies in A and centralizes
F_A. Conversely C_A(F_A) is central in H. This identifies the intrinsic
local two-core with the literal relative centralizer used in B.1.9.

Source: Aschbacher–Smith, B.1.9, first proof paragraph,
printed p.71 (PDF p.82), combined manuscript of 1 March 2004.
-/

@[expose] public section

open Subgroup Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterB.FittingStructure.MinimalPlanes
variable {G : Type*} [Group G]

def localOdd (A : Subgroup G) : Subgroup (localGroup A) :=
  (oddPart A).subgroupOf (localGroup A)

theorem localGroup_normalizes_oddPart (A : Subgroup G) :
    localGroup A ≤ normalizer (oddPart A : Set G) :=
  sup_le (oddPart A).le_normalizer (normalizer_commutator_ge_right _ _)

instance localOdd_normal (A : Subgroup G) : (localOdd A).Normal :=
  normal_subgroupOf_of_le_normalizer (localGroup_normalizes_oddPart A)

theorem localGroup_centralizes_kernelActor {A : Subgroup G} (hA : IsElementaryTwo A) :
    localGroup A ≤ centralizer (kernelActor A : Set G) := by
  apply sup_le
  · exact le_centralizer_iff.mp (show kernelActor A ≤ centralizer (oddPart A : Set G) from inf_le_right)
  · let := hA.2
    exact (le_centralizer_iff_isMulCommutative.mpr inferInstance).trans
      (centralizer_le (show kernelActor A ≤ A from inf_le_left))

instance kernelActor_normal {A : Subgroup G} [IsElementaryAbelian 2 A] :
    ((kernelActor A).subgroupOf (localGroup A)).Normal := by
  apply normal_subgroupOf_of_le_normalizer
  apply (centralizer_le_normalizer _).trans' (sup_le ?_ ?_)
  · exact le_centralizer_iff.mp (show kernelActor A ≤ centralizer (oddPart A : Set G) from inf_le_right)
  · exact (le_centralizer_iff_isMulCommutative.mpr inferInstance).trans
      (centralizer_le (show kernelActor A ≤ A from inf_le_left))

variable [Finite G]

theorem oddPart_idempotent (hcore : pCore 2 G = ⊥) {A : Subgroup G}
    (hA : IsElementaryTwo A) : ⁅oddPart A, A⁆ = oddPart A := by
  let := hA.2
  have hc : Nat.Coprime (Nat.card A) (Nat.card (fittingSubgroup G)) := by
    obtain ⟨n, hn⟩ := (IsPGroup.iff_card (p := 2)).mp (IsElementaryAbelian.isPGroup 2 A)
    rw [hn]
    apply Nat.Coprime.pow_left
    exact Nat.Coprime.of_dvd_right
      (card_dvd_of_le (fitting_le_pPrimeCore_of_pCore_eq_bot 2 hcore))
      (pPrimeCore_coprime_card (p := 2) (G := G))
  have h := commutator_closure_coprime_idempotent (fittingSubgroup G) (A : Set G)
    (by simpa only [Subgroup.closure_eq] using (le_normalizer_of_normal (H := fittingSubgroup G) (K := A)))
    (fun a ha => hc.of_dvd_left (by
      have ht := orderOf_dvd_natCard (⟨a, ha⟩ : A)
      rwa [← Subgroup.orderOf_coe] at ht))
  simpa only [Subgroup.closure_eq, oddPart] using h

theorem localOdd_commutator (hcore : pCore 2 G = ⊥) {A : Subgroup G}
    (hA : IsElementaryTwo A) : ⁅localOdd A, localActor A⁆ = localOdd A := by
  apply map_injective (localGroup A).subtype_injective
  rw [map_commutator]
  change ⁅((oddPart A).subgroupOf (localGroup A)).map (localGroup A).subtype,
    (A.subgroupOf (localGroup A)).map (localGroup A).subtype⁆ =
    ((oddPart A).subgroupOf (localGroup A)).map (localGroup A).subtype
  rw [map_subgroupOf_eq_of_le (show oddPart A ≤ localGroup A from le_sup_left),
    map_subgroupOf_eq_of_le (show A ≤ localGroup A from le_sup_right)]
  exact oddPart_idempotent hcore hA

omit [Finite G] in
theorem localOdd_sup_localActor (A : Subgroup G) : localOdd A ⊔ localActor A = ⊤ := by
  rw [localOdd, localActor, ← subgroupOf_sup (show oddPart A ≤ localGroup A from le_sup_left)
    (show A ≤ localGroup A from le_sup_right)]
  exact subgroupOf_self _

theorem localActor_normally_generates (hcore : pCore 2 G = ⊥) {A : Subgroup G}
    (hA : IsElementaryTwo A) : normalClosure (localActor A : Set (localGroup A)) = ⊤ := by
  apply top_unique
  rw [← localOdd_sup_localActor A]
  apply sup_le ?_ le_normalClosure
  rw [← localOdd_commutator hcore hA]
  exact (commutator_mono le_rfl le_normalClosure).trans (commutator_le_right _ _)

theorem localGroup_solvable {A : Subgroup G} (hA : IsElementaryTwo A) :
    Group.IsSolvable (localGroup A) := by
  let := hA.2
  let : Group.IsSolvable (oddPart A) := Group.isSolvable_of_isSolvable_injective
    (f := inclusion (show oddPart A ≤ fittingSubgroup G from commutator_le_left _ _))
    (inclusion_injective _)
  exact Group.isSolvable_sup_of_normalizes _ _ (normalizer_commutator_ge_right _ _)

theorem localActor_index_odd (hcore : pCore 2 G = ⊥) (A : Subgroup G) :
    Odd (localActor A).index := by
  change Odd (A.relIndex (oddPart A ⊔ A))
  rw [relIndex_sup_of_normalizes (oddPart A) A (normalizer_commutator_ge_right _ _)]
  exact (oddPart_odd hcore A).of_dvd_nat (relIndex_dvd_card _ _)

theorem localGroup_twoCore (hcore : pCore 2 G = ⊥) {A : Subgroup G}
    (hA : IsElementaryTwo A) :
    pCore 2 (localGroup A) = (kernelActor A).subgroupOf (localGroup A) := by
  let := hA.2
  have hpA : IsPGroup 2 (localActor A) := (IsElementaryAbelian.isPGroup 2 A).comap_subtype
  have hQA : pCore 2 (localGroup A) ≤ localActor A :=
    pCore_isPGroup.le_sylow_of_normal (hpA.toSylow (localActor_index_odd hcore A).not_two_dvd_nat)
  have ho : Odd (Nat.card (localOdd A)) := by
    change Odd (Nat.card ((oddPart A).subgroupOf (localGroup A)))
    rw [Nat.card_congr (subgroupOfEquivOfLe (show oddPart A ≤ localGroup A from le_sup_left)).toEquiv]
    exact oddPart_odd hcore A
  have hd : Disjoint (pCore 2 (localGroup A)) (localOdd A) := by
    apply disjoint_of_coprime_natCard
    obtain ⟨n, hn⟩ := (IsPGroup.iff_card (p := 2)).mp (pCore_isPGroup (p := 2) (G := localGroup A))
    rw [hn]
    exact ho.coprime_two_left.pow_left n
  have hc : pCore 2 (localGroup A) ≤ centralizer (localOdd A : Set (localGroup A)) :=
    commutator_eq_bot_iff_le_centralizer.mp (commutator_eq_bot_of_disjoint hd)
  apply le_antisymm
  · intro q hq
    refine ⟨hQA hq, ?_⟩
    change (q : G) ∈ centralizer (oddPart A : Set G)
    rw [mem_centralizer_iff]
    intro f hf
    exact congrArg Subtype.val (mem_centralizer_iff.mp (hc hq)
      ⟨f, (show oddPart A ≤ localGroup A from le_sup_left) hf⟩ hf)
  · exact le_sSup ⟨inferInstance, (IsElementaryAbelian.isPGroup 2 A).to_le inf_le_left |>.comap_subtype⟩

end CFSG.Quasithin.ChapterB.FittingStructure.MinimalPlanes
