module

public import Theory.Representation.BinaryOffender.Stability
public import Theory.Representation.BinaryOffender.SubspaceAction
public import Theory.GroupTheory.Fitting.Core
public import Mathlib.Algebra.Group.Pi.Basic
public import Theory.GroupTheory.Commutator.NormalGeneration

/-!
# The source families and contracts for B.1.9

Here J* is generated by the actual equal-weight minimal best offenders,
and F is the literal commutator [F(G),J*]. We prove normality, generation
of F by its nonzero individual commutators, conjugation stability of that
family, and the centralizing-offender case of B.1.9(5).

`MinimalFittingPlane` records the local output of the first paragraph of
the source proof. `Decomposition` records precisely clauses (1)–(4), using
actual symmetric groups of degree three and inclusion-compatible group
products and linear sums. `Conclusion` adds (5). These records and the
universal `SourceTheorem` are contracts, not assertions that witnesses exist.
The local planes, global splitting, and universal source implication still
have to be constructed from faithfulness and the trivial two-core.

Source: Aschbacher–Smith, combined 1 March 2004 manuscript, B.1.9,
printed pp.71–72 (PDF pp.82–83).
-/

@[expose] public section

open Subgroup Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterB.FittingStructure
universe u v
variable {G : Type u} {V : Type v} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

def minimalGenerated : Subgroup G :=
  generatedBy {A | IsMinimalBestOffender ρ A} ⊤

def fittingMoved : Subgroup G := ⁅fittingSubgroup G, minimalGenerated ρ⁆

def smallFittingFactors : Set (Subgroup G) :=
  {X | X ≤ fittingSubgroup G ∧ Nat.card X = 3 ∧
    Module.finrank (ZMod 2) (subspaceCommutator ρ ⊤ X) = 2}

def minimalMovedFactors : Set (Subgroup G) :=
  {X | ∃ A, IsMinimalBestOffender ρ A ∧ ⁅fittingSubgroup G, A⁆ ≠ ⊥ ∧
    X = ⁅fittingSubgroup G, A⁆}

structure MinimalFittingPlane (A : Subgroup G) where
  actor_card : Nat.card A = 2
  odd_card : Nat.card ↥(⁅fittingSubgroup G, A⁆ : Subgroup G) = 3
  dimension : Module.finrank (ZMod 2) (subspaceCommutator ρ ⊤ ⁅fittingSubgroup G, A⁆) = 2
  support_eq : subspaceCommutator ρ ⊤ ⁅fittingSubgroup G, A⁆ =
    subspaceCommutator ρ ⊤ (⁅fittingSubgroup G, A⁆ ⊔ A)
  fixed_sum : subspaceCommutator ρ ⊤ ⁅fittingSubgroup G, A⁆ ⊔ fixedSpace ρ A = ⊤
  model : ↥(⁅fittingSubgroup G, A⁆ ⊔ A) ≃* Equiv.Perm (Fin 3)
  faithful_support : ∀ g ∈ ⁅fittingSubgroup G, A⁆ ⊔ A,
    (∀ w ∈ subspaceCommutator ρ ⊤ ⁅fittingSubgroup G, A⁆, ρ g w = w) → g = 1

def LocalPlaneLaw : Prop :=
  ∀ A, IsMinimalBestOffender ρ A → ⁅fittingSubgroup G, A⁆ ≠ ⊥ →
    Nonempty (MinimalFittingPlane ρ A)

structure Decomposition where
  count : ℕ
  count_pos : 0 < count
  factor : Fin count → Subgroup G
  factorModel : ∀ i, factor i ≃* Equiv.Perm (Fin 3)
  groupProduct : (((i : Fin count) → factor i) ×
    generatedBy {A | IsBestOffender ρ A}
      (centralizer (fittingMoved ρ : Set G))) ≃* offenderSubgroup ρ
  groupProduct_single : ∀ i (g : factor i),
    (groupProduct (Pi.mulSingle i g, 1) : G) = g
  groupProduct_residual : ∀ g, (groupProduct (1, g) : G) = g
  oddFactor : Fin count → Subgroup G
  oddFactor_eq : ∀ i, oddFactor i = (pPrimeCore 2 (factor i)).map (factor i).subtype
  oddFactorModel : ∀ i, oddFactor i ≃* Multiplicative (ZMod 3)
  oddProduct : ((i : Fin count) → oddFactor i) ≃* fittingMoved ρ
  oddProduct_single : ∀ i (g : oddFactor i), (oddProduct (Pi.mulSingle i g) : G) = g
  fittingProduct : (fittingMoved ρ ×
    ↥(fittingSubgroup G ⊓ centralizer (minimalGenerated ρ : Set G))) ≃* fittingSubgroup G
  fittingProduct_apply : ∀ f c, (fittingProduct (f,c) : G) = (f : G) * (c : G)
  moved_eq : ∀ i, subspaceCommutator ρ ⊤ (oddFactor i) =
    subspaceCommutator ρ ⊤ (factor i)
  dimension : ∀ i, Module.finrank (ZMod 2) (subspaceCommutator ρ ⊤ (factor i)) = 2
  moduleSum : ((i : Fin count) → subspaceCommutator ρ ⊤ (factor i)) ≃ₗ[ZMod 2]
    subspaceCommutator ρ ⊤ (fittingMoved ρ)
  moduleSum_single : ∀ i (x : subspaceCommutator ρ ⊤ (factor i)),
    (moduleSum (Pi.single i x) : V) = x
  noncentral_offenders : ∀ A,
    (IsMinimalBestOffender ρ A ∧ ⁅fittingSubgroup G, A⁆ ≠ ⊥) ↔
      ∃ i, ∃ S : Sylow 2 (factor i), (S : Subgroup (factor i)).map (factor i).subtype = A

structure Conclusion extends Decomposition ρ where
  moved_subgroup_centralizes : ∀ A, IsMinimalBestOffender ρ A →
    ∀ K : Subgroup G, K = ⁅K, A⁆ →
      K ≤ minimalGenerated ρ ⊓ centralizer (fittingSubgroup G : Set G)

def SourceTheorem : Prop :=
  ∀ (G : Type u) [Group G] [Finite G]
    (V : Type v) [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
    (ρ : Representation (ZMod 2) G V), Function.Injective ρ → pCore 2 G = ⊥ →
      fittingMoved ρ ≠ ⊥ → Nonempty (Conclusion ρ)

theorem minimal_le {A : Subgroup G} (hA : IsMinimalBestOffender ρ A) :
    A ≤ minimalGenerated ρ :=
  le_iSup_of_le A (le_iSup_of_le ⟨hA, le_top⟩ le_rfl)

theorem minimalGenerated_le : minimalGenerated ρ ≤ offenderSubgroup ρ := by
  exact iSup_le fun A => iSup_le fun hA =>
    le_iSup_of_le A (le_iSup_of_le ⟨hA.1.1, le_top⟩ le_rfl)

instance minimalGenerated_normal : (minimalGenerated ρ).Normal :=
  generatedBy_normal_of_conj _ (fun _ hA g => hA.map_conj ρ g)

instance fittingMoved_normal : (fittingMoved ρ).Normal := by
  unfold fittingMoved
  infer_instance

theorem fittingMoved_le : fittingMoved ρ ≤ fittingSubgroup G ⊓ minimalGenerated ρ :=
  commutator_le_inf _ _

theorem fittingMoved_ne_bot_iff : fittingMoved ρ ≠ ⊥ ↔
    ∃ A, IsMinimalBestOffender ρ A ∧ ⁅fittingSubgroup G, A⁆ ≠ ⊥ := by
  classical
  simp only [ne_eq, fittingMoved, commutator_comm (fittingSubgroup G),
    commutator_eq_bot_iff_le_centralizer, minimalGenerated, generatedBy,
    iSup_le_iff, not_forall, exists_prop, and_true, le_top, Set.mem_ofPred_eq]

theorem moved_by_minimal_le {A K : Subgroup G} (hA : IsMinimalBestOffender ρ A)
    (hK : K = ⁅K, A⁆) : K ≤ minimalGenerated ρ := by
  rw [hK]
  exact (commutator_mono le_rfl (minimal_le ρ hA)).trans (commutator_le_right _ _)

theorem moved_by_best_le {A K : Subgroup G} (hA : IsBestOffender ρ A)
    (hK : K = ⁅K, A⁆) : K ≤ offenderSubgroup ρ := by
  let : (offenderSubgroup ρ).Normal := offenderSubgroup_normal ρ
  have hAJ : A ≤ offenderSubgroup ρ :=
    le_iSup_of_le A (le_iSup_of_le ⟨hA, le_top⟩ le_rfl)
  rw [hK]
  exact (commutator_mono le_rfl hAJ).trans (commutator_le_right _ _)

theorem moved_by_centralizing_le {A K : Subgroup G}
    (hA : A ≤ centralizer (fittingSubgroup G : Set G)) (hK : K = ⁅K, A⁆) :
    K ≤ centralizer (fittingSubgroup G : Set G) := by
  rw [hK]
  exact (commutator_mono le_rfl hA).trans (commutator_le_right _ _)

theorem minimal_centralizing_case {A K : Subgroup G} (hA : IsMinimalBestOffender ρ A)
    (hc : A ≤ centralizer (fittingSubgroup G : Set G)) (hK : K = ⁅K, A⁆) :
    K ≤ minimalGenerated ρ ⊓ centralizer (fittingSubgroup G : Set G) :=
  le_inf (moved_by_minimal_le ρ hA hK) (moved_by_centralizing_le hc hK)

end CFSG.Quasithin.ChapterB.FittingStructure

namespace CFSG.Quasithin.ChapterB.FittingStructure
open Subgroup Representation.BinaryOffender
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

theorem fittingMoved_eq_iSup : fittingMoved ρ =
    ⨆ A : Subgroup G, ⨆ (_ : IsMinimalBestOffender ρ A), ⁅fittingSubgroup G, A⁆ := by
  simp only [fittingMoved, minimalGenerated, generatedBy,
    Subgroup.commutator_iSup_of_normal_left, le_top, and_true, Set.mem_ofPred_eq]

theorem fittingMoved_eq_sSup : fittingMoved ρ = sSup (minimalMovedFactors ρ) := by
  classical
  rw [fittingMoved_eq_iSup]
  apply le_antisymm
  · refine iSup_le fun A => iSup_le fun hA => ?_
    by_cases hz : ⁅fittingSubgroup G, A⁆ = ⊥
    · rw [hz]; exact bot_le
    · exact le_sSup ⟨A, hA, hz, rfl⟩
  · refine sSup_le ?_
    rintro X ⟨A, hA, _, rfl⟩
    exact le_iSup_of_le A (le_iSup_of_le hA le_rfl)

theorem minimalMovedFactors_nonempty (hF : fittingMoved ρ ≠ ⊥) :
    (minimalMovedFactors ρ).Nonempty := by
  obtain ⟨A, hA, hn⟩ := (fittingMoved_ne_bot_iff ρ).mp hF
  exact ⟨⁅fittingSubgroup G, A⁆, A, hA, hn, rfl⟩

theorem minimal_centralization_of_fittingMoved_eq_bot (hF : fittingMoved ρ = ⊥)
    {A K : Subgroup G} (hA : IsMinimalBestOffender ρ A) (hK : K = ⁅K, A⁆) :
    K ≤ minimalGenerated ρ ⊓ centralizer (fittingSubgroup G : Set G) := by
  have hc : fittingSubgroup G ≤ centralizer (minimalGenerated ρ : Set G) :=
    commutator_eq_bot_iff_le_centralizer.mp hF
  exact minimal_centralizing_case ρ hA
    ((minimal_le ρ hA).trans (le_centralizer_iff.mp hc)) hK

end CFSG.Quasithin.ChapterB.FittingStructure

namespace CFSG.Quasithin.ChapterB.FittingStructure
open Subgroup Representation.BinaryOffender
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

theorem minimalMovedFactors_map_conj {X : Subgroup G}
    (hX : X ∈ minimalMovedFactors ρ) (g : G) :
    X.map (MulAut.conj g).toMonoidHom ∈ minimalMovedFactors ρ := by
  obtain ⟨A, hA, hn, rfl⟩ := hX
  have he : (⁅fittingSubgroup G, A⁆).map (MulAut.conj g).toMonoidHom =
      ⁅fittingSubgroup G, A.map (MulAut.conj g).toMonoidHom⁆ := by
    rw [map_commutator]
    congr 1
    exact Normal.map_conj_eq (fittingSubgroup G) g
  refine ⟨A.map (MulAut.conj g).toMonoidHom, hA.map_conj ρ g, ?_, he⟩
  rw [← he]
  exact fun hz => hn ((map_eq_bot_iff_of_injective _ (MulAut.conj g).injective).mp hz)

end CFSG.Quasithin.ChapterB.FittingStructure
