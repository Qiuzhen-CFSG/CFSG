module
public import CFSG.Quasithin.ChapterB.Section01.SolvableStructure.SourceTheorems
public import CFSG.Quasithin.ChapterB.Section01.FittingStructure.Basic
/-!
# Full offender normalization from one moving best offender

In the faithful action on C_V(O₂(KT)), the solvable FF classification writes
a best offender as a product of factor Sylow groups. A subgroup of order three
moved by this offender lies in one active factor, hence equals its odd core.
All best offenders normalize this core. Normalization lifts because the normal
three-group generated by K's T-conjugates is disjoint from the two-core kernel.

Source: Aschbacher--Smith B.1.8, B.1.12 and the C.1.27 application, pp.70,73,133.
-/
public section
open Subgroup Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterB.ThreeConjugates
variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V] {ρ : Representation (ZMod 2) G V}

omit [FiniteDimensional (ZMod 2) V] in
/-- An order-three subgroup moved by one best offender is one factor odd core. -/
theorem single_best_three_coordinate (d : SolvableFFStructure ρ)
    (K A : Subgroup G) (hcard : Nat.card K = 3) (hA : IsBestOffender ρ A)
    (hm : K = ⁅K,A⁆) : ∃ i, K = d.toSolvableFFFactors.factorOddCore i := by
  classical
  obtain ⟨B,hB,_,he⟩ := (d.classifier A).mp hA
  have hn : K ≠ ⊥ := by intro h; rw [h,card_bot] at hcard; omega
  have hactive : ∃ i, ⁅K,B i⁆ ≠ ⊥ := by
    by_contra! h
    apply hn
    rw [hm]
    apply commutator_eq_bot_iff_le_centralizer.mpr
    rw [he]
    exact le_centralizer_iff.mp (iSup_le fun i =>
      le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp (h i)))
  obtain ⟨i,hi⟩ := hactive
  have hBi : B i ≤ A := he ▸ le_iSup B i
  rcases hB i with hb | ⟨R,hR⟩
  · exact (hi (by rw [hb,commutator_bot_right])).elim
  have hKJ := FittingStructure.moved_by_best_le ρ hA hm
  have hnorm : K ≤ normalizer (d.factor i) := hKJ.trans
    ((normal_subgroupOf_iff_le_normalizer (d.toSolvableFFFactors.factor_le_offenderSubgroup i)).mp
      (d.toSolvableFFFactors.factor_normal_in_offenderSubgroup i))
  have hCF : ⁅K,B i⁆ ≤ d.factor i :=
    (commutator_mono le_rfl (hR ▸ d.toSolvableFFFactors.factorSylow_le i R)).trans
      (le_normalizer_iff_commutator_le_right.mp hnorm)
  have hCK : ⁅K,B i⁆ ≤ K := (commutator_mono le_rfl hBi).trans hm.ge
  have hcdiv := card_dvd_of_le hCK
  rw [hcard] at hcdiv
  have hceq : Nat.card ↥(⁅K,B i⁆ : Subgroup G) = 3 :=
    ((Nat.dvd_prime Nat.prime_three).mp hcdiv).resolve_left
      (fun h => hi (card_eq_one.mp h))
  have heq : ⁅K,B i⁆ = K := eq_of_le_of_card_ge hCK (by rw [hcard,hceq])
  exact ⟨i,d.toSolvableFFFactors.eq_factorOddCore_of_card_three hcard (heq ▸ hCF)⟩

omit [FiniteDimensional (ZMod 2) V] in
/-- All best offenders normalize that actual odd core. -/
theorem single_best_three_normalized (d : SolvableFFStructure ρ)
    (K A : Subgroup G) (hcard : Nat.card K = 3) (hA : IsBestOffender ρ A)
    (hm : K = ⁅K,A⁆) : offenderSubgroup ρ ≤ normalizer (K : Set G) := by
  obtain ⟨i,rfl⟩ := single_best_three_coordinate d K A hcard hA hm
  intro g hg
  apply mem_normalizer_iff_map_conj_eq.mpr
  apply d.toSolvableFFFactors.factorOddCore_map_conj
  exact mem_normalizer_iff_map_conj_eq.mp
    (((normal_subgroupOf_iff_le_normalizer
      (d.toSolvableFFFactors.factor_le_offenderSubgroup i)).mp
      (d.toSolvableFFFactors.factor_normal_in_offenderSubgroup i)) hg)


omit [Finite G] in
private theorem normalizer_reflect_of_normal_disjoint
    {D : Type*} [Group D] (f : G →* D) (R K : Subgroup G) [R.Normal]
    (hKR : K ≤ R) (hd : Disjoint R f.ker) {g : G}
    (hg : f g ∈ normalizer (K.map f : Set D)) : g ∈ normalizer (K : Set G) := by
  have hreflect : R ⊓ (K.map f).comap f ≤ K := by
    rintro x ⟨hx,hfx⟩
    obtain ⟨k,hk,he⟩ := hfx
    have heq : k⁻¹*x = 1 := mem_bot.mp (hd.eq_bot ▸
      (show k⁻¹*x ∈ R ⊓ f.ker from ⟨R.mul_mem (R.inv_mem (hKR hk)) hx, by
        change f (k⁻¹*x)=1
        rw [map_mul,map_inv,he,inv_mul_cancel]⟩))
    exact (inv_mul_eq_one.mp heq) ▸ hk
  apply mem_normalizer_iff.mpr
  intro k
  constructor
  · intro hk
    apply hreflect
    refine ⟨(inferInstance : R.Normal).conj_mem k (hKR hk) g, ?_⟩
    change f (g*k*g⁻¹) ∈ K.map f
    simpa only [map_mul,map_inv] using
      (mem_normalizer_iff.mp hg (f k)).mp (mem_map_of_mem f hk)
  · intro hk
    have hr : k ∈ R := by
      have h := (inferInstance : R.Normal).conj_mem (g*k*g⁻¹) (hKR hk) g⁻¹
      simpa only [inv_inv,inv_mul_cancel_left,mul_assoc,mul_inv_cancel_right,inv_mul_cancel,mul_one] using h
    apply hreflect
    refine ⟨hr, ?_⟩
    apply (mem_normalizer_iff.mp hg (f k)).mpr
    simpa only [map_mul,map_inv] using mem_map_of_mem f hk

/-- One actual moving offender suffices for full local offender normalization. -/
theorem single_best_local_three_normalized
    (hf : Function.Injective ρ) (K T A : Subgroup G)
    (hK : (K.subgroupOf (K ⊔ T)).IsSubnormal) (hcard : Nat.card K = 3)
    (hT : IsPGroup 2 T) (hA : IsBestOffender ρ A) (hAT : A ≤ T)
    (hm : K = ⁅K,A⁆) : localOffenderSubgroup ρ T ≤ normalizer (K : Set G) := by
  let H := K ⊔ T
  let KH := K.subgroupOf H
  let AH := A.subgroupOf H
  let σ := localRepresentation ρ K T
  let U := localFixedSpace ρ K T
  let f := localActionHom ρ K T
  let τ := subspaceImageRepresentation σ U
  have hAH : A ≤ H := hAT.trans le_sup_right
  have hAb : IsBestOffender σ AH := hA.subgroupOf ρ hAH
  have hKm : KH = ⁅KH,AH⁆ := by
    apply map_injective H.subtype_injective
    rw [map_commutator, map_subgroupOf_eq_of_le (show K ≤ H from le_sup_left),
      map_subgroupOf_eq_of_le hAH]
    exact hm
  have hc : Nat.card (KH.map f) = 3 := localImageThree_card ρ hf K T hK hcard hT
  have hfm : KH.map f = ⁅KH.map f,AH.map f⁆ := by rw [← map_commutator,← hKm]
  have hAn : AH.map f ≠ ⊥ := by
    intro he
    have hh := hfm
    rw [he,commutator_bot_right] at hh
    rw [hh,card_bot] at hc
    omega
  have best_image (B : Subgroup H) (hb : IsBestOffender σ B) (hn : B.map f ≠ ⊥) :
      IsBestOffender τ (B.map f) := by
    have hnu : ¬ U ≤ fixedSpace σ B := by
      intro hh
      apply hn
      apply bot_unique
      rintro _ ⟨b,hb,rfl⟩
      apply subspaceImageRepresentation_injective σ U
      ext u
      exact hh u.property ⟨b,hb⟩
    have hs : B ≤ subspaceStabilizer σ U := le_top.trans (fixedSpace_stable σ _)
    have he : restrictedSubgroup σ U B = B.map f :=
      local_restrictedSubgroup_eq_map ρ K T B
    rw [← he]
    exact hb.restricted σ U hs hnu
  have hAff := best_image AH hAb hAn
  obtain ⟨d⟩ := solvableFFStructure_nonempty τ (localActionImage_solvable ρ K T hK hcard hT)
    (localActionImage_twoCore ρ hf K T hK hcard hT)
    (subspaceImageRepresentation_injective σ U)
    ((isFFModule_iff_exists_bestOffender τ).mpr ⟨_,hAff⟩)
  have hnorm := single_best_three_normalized d (KH.map f) (AH.map f) hc hAff hfm
  let R := (conjugateClosure K T).subgroupOf H
  let : R.Normal := conjugateClosure_normal K T
  have hKR : KH ≤ R := fun _ hk => le_conjugateClosure K T hk
  have hR3 : IsPGroup 3 R := (conjugateClosure_isThreeGroup K T hK hcard).comap_subtype
  have hker : f.ker = pCore 2 H := localActionHom_ker ρ hf K T hK hcard hT
  have hd : Disjoint R f.ker := hR3.disjoint_of_coprime
    (hker.symm ▸ pCore_isPGroup) (by decide : Nat.Coprime 3 2)
  have hnlocal : offenderSubgroup σ ≤ normalizer (KH : Set H) := by
    refine iSup_le fun B => iSup_le fun hB => ?_
    intro b hb
    have hbest := hB.1
    apply normalizer_reflect_of_normal_disjoint f R KH hKR hd
    by_cases hz : B.map f = ⊥
    · have hfb : f b = 1 := mem_bot.mp (hz ▸ mem_map_of_mem f hb)
      rw [hfb]
      exact one_mem _
    · have hBj : B.map f ≤ offenderSubgroup τ :=
        le_iSup_of_le (B.map f)
          (le_iSup_of_le ⟨best_image B hbest hz,le_top⟩ le_rfl)
      exact hnorm (hBj (mem_map_of_mem f hb))
  have hlocal := (localOffenderSubgroup_le_global ρ K T).trans hnlocal
  apply le_normalizer_iff.mpr
  intro t ht k hk
  have htH : t ∈ H := ((localOffenderSubgroup_le ρ T).trans le_sup_right) ht
  exact (mem_normalizer_iff.mp (hlocal (show (⟨t,htH⟩ : H) ∈
    (localOffenderSubgroup ρ T).subgroupOf H from ht))
      (⟨k,(show K ≤ H from le_sup_left) hk⟩ : H)).mp hk

end CFSG.Quasithin.ChapterB.ThreeConjugates
