module

public import CFSG.Quasithin.ChapterB.Section01.SolvableStructure.ThreeConjugates.Lifting

/-!
# The literal quotient and its induced action

The verified first-isomorphism equivalence embeds M/O₂(M) in the fixed-space
action image, with image the subgroup generated by the transferred stable
family. Its equations on representatives identify the induced T-action with
actual conjugation, and identify the quotient image of each K-conjugate.
These equations prevent changing the quotient or its marked subgroups during
transport of the concrete factors.

Source: Aschbacher–Smith, B.1.12, printed p. 73 (PDF p. 84).
-/

@[expose] public section

open Subgroup Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterB.ThreeConjugates
universe u v
variable {G : Type u} {V : Type v} [Group G] [Finite G] [AddCommGroup V]
  [Module (ZMod 2) V] (ρ : Representation (ZMod 2) G V)
  [FiniteDimensional (ZMod 2) V]
  (hf : Function.Injective ρ) (K : Subgroup G) (T : Sylow 2 G)
  (hK : (K.subgroupOf (K ⊔ (T : Subgroup G))).IsSubnormal) (hcard : Nat.card K = 3)
  (hcomm : K = ⁅K, localOffenderSubgroup ρ (T : Subgroup G)⁆)

/-- The literal M/O₂(M) embedded in the fixed-space action image. -/
noncomputable def mixedImageEmbedding :
    (mixedSubgroup ρ K (T : Subgroup G) ⧸ pCore 2 (mixedSubgroup ρ K (T : Subgroup G))) →*
      subspaceActionImage (localRepresentation ρ K (T : Subgroup G))
        (localFixedSpace ρ K (T : Subgroup G)) :=
  (generatedBy (localImageFamily ρ K (T : Subgroup G)) ⊤).subtype.comp
    (mixedActionQuotientEquiv ρ hf K T hK hcard hcomm).toMonoidHom

theorem mixedImageEmbedding_injective :
    Function.Injective (mixedImageEmbedding ρ hf K T hK hcard hcomm) :=
  Subtype.val_injective.comp (mixedActionQuotientEquiv ρ hf K T hK hcard hcomm).injective

theorem mixedImageEmbedding_range :
    (mixedImageEmbedding ρ hf K T hK hcard hcomm).range =
      generatedBy (localImageFamily ρ K (T : Subgroup G)) ⊤ := by
  rw [mixedImageEmbedding, MonoidHom.range_comp,
    MonoidHom.range_eq_top.mpr (mixedActionQuotientEquiv ρ hf K T hK hcard hcomm).surjective]
  rw [← MonoidHom.range_eq_map, Subgroup.range_subtype]

@[simp] theorem mixedImageEmbedding_mk (m : mixedSubgroup ρ K (T : Subgroup G)) :
    mixedImageEmbedding ρ hf K T hK hcard hcomm
      (QuotientGroup.mk' (pCore 2 (mixedSubgroup ρ K (T : Subgroup G))) m) =
        mixedActionHom ρ K (T : Subgroup G) m :=
  mixedActionQuotientEquiv_mk ρ hf K T hK hcard hcomm m

/-- The quotient action is the conjugation induced by the actual image of T. -/
theorem mixedImageEmbedding_action (t : T)
    (x : mixedSubgroup ρ K (T : Subgroup G) ⧸ pCore 2 (mixedSubgroup ρ K (T : Subgroup G))) :
    mixedImageEmbedding ρ hf K T hK hcard hcomm (mixedQuotientAction ρ K (T : Subgroup G) t x) =
      let s := localActionHom ρ K (T : Subgroup G)
        (inclusion (show (T : Subgroup G) ≤ K ⊔ (T : Subgroup G) from le_sup_right) t)
      s * mixedImageEmbedding ρ hf K T hK hcard hcomm x * s⁻¹ := by
  obtain ⟨m, rfl⟩ := QuotientGroup.mk'_surjective (pCore 2 (mixedSubgroup ρ K (T : Subgroup G))) x
  rw [mixedQuotientAction_mk, mixedImageEmbedding_mk, mixedImageEmbedding_mk]
  dsimp only
  change localActionHom ρ K (T : Subgroup G) _ =
    localActionHom ρ K (T : Subgroup G) _ * localActionHom ρ K (T : Subgroup G) _ *
      (localActionHom ρ K (T : Subgroup G) _)⁻¹
  rw [← map_inv, ← map_mul, ← map_mul]
  rfl

/-- Subgroup transport is compatible with the induced quotient automorphism. -/
theorem mixedImageEmbedding_map_action (t : T)
    (A : Subgroup (mixedSubgroup ρ K (T : Subgroup G) ⧸
      pCore 2 (mixedSubgroup ρ K (T : Subgroup G)))) :
    (A.map (mixedQuotientAction ρ K (T : Subgroup G) t).toMonoidHom).map
      (mixedImageEmbedding ρ hf K T hK hcard hcomm) =
    (A.map (mixedImageEmbedding ρ hf K T hK hcard hcomm)).map
      (MulAut.conj (localActionHom ρ K (T : Subgroup G)
        (inclusion (show (T : Subgroup G) ≤ K ⊔ (T : Subgroup G) from le_sup_right) t))).toMonoidHom := by
  rw [Subgroup.map_map, Subgroup.map_map]
  congr 1
  apply MonoidHom.ext
  intro x
  exact mixedImageEmbedding_action ρ hf K T hK hcard hcomm t x

/-- The image of the prescribed quotient subgroup is its faithful odd-core image. -/
theorem quotientConjugate_image (c : conjugateFamily K (T : Subgroup G)) :
    (quotientConjugate ρ K (T : Subgroup G) c).map
      (mixedImageEmbedding ρ hf K T hK hcard hcomm) =
        localImageOf ρ K (T : Subgroup G) c := by
  have hcomp : (mixedImageEmbedding ρ hf K T hK hcard hcomm).comp
      (QuotientGroup.mk' (pCore 2 (mixedSubgroup ρ K (T : Subgroup G)))) =
        mixedActionHom ρ K (T : Subgroup G) :=
    MonoidHom.ext (mixedImageEmbedding_mk ρ hf K T hK hcard hcomm)
  rw [quotientConjugate, Subgroup.map_map, hcomp]
  ext x
  constructor
  · rintro ⟨a, ha, rfl⟩
    exact ⟨inclusion (mixedSubgroup_le ρ K (T : Subgroup G)) a, ha, rfl⟩
  · rintro ⟨a, ha, rfl⟩
    have ham : (a : G) ∈ mixedSubgroup ρ K (T : Subgroup G) :=
      (show conjugateClosure K (T : Subgroup G) ≤ mixedSubgroup ρ K (T : Subgroup G) from le_sup_right)
        (conjugate_le_closure _ _ c ha)
    exact ⟨⟨a, ham⟩, ha, rfl⟩

end CFSG.Quasithin.ChapterB.ThreeConjugates
