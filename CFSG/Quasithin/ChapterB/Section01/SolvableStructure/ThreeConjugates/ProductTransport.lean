module

public import CFSG.Quasithin.ChapterB.Section01.SolvableStructure.OffenderProducts.Internal
public import Theory.PPrimeCore

/-!
# Transport of the concrete solvable FF products

An injective action map reflects commutation. Independent coordinate images
then make the finite product of prescribed inclusions injective; generation
makes it surjective. Pulling the concrete factors back through an embedding
onto the offender subgroup preserves both their models and their intrinsic
odd cores. The B.1.12 assembly applies these constructions to K₀ and M/O₂(M).

Source: Aschbacher–Smith, B.1.12, printed p. 73 (PDF p. 84).
-/

public section

open Subgroup Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterB.ThreeConjugates

section Product
variable {D W E I : Type*} [Group D] [AddCommGroup W] [Module (ZMod 2) W]
  {σ : Representation (ZMod 2) D W} (d : SolvableFFFactors σ)
  [Group E] [Fintype I] {A : I → Type*} [∀ i, Group (A i)]
  (f : E →* D) (hf : Function.Injective f) (j : I → Fin d.count)
  (hj : Function.Injective j) (inc : ∀ i, A i →* E)
  (hi : ∀ i, Function.Injective (inc i))
  (hfac : ∀ i, (f.comp (inc i)).range ≤ d.factor (j i))

omit [Fintype I] in
include hf hj hfac in
private theorem coordinateCommute :
    Pairwise fun i k => ∀ (x : A i) (y : A k), Commute (inc i x) (inc k y) := by
  intro i k hik x y
  apply Commute.of_map hf
  exact d.factor_commute (hj.ne hik)
    ⟨_, hfac i ⟨x, rfl⟩⟩ ⟨_, hfac k ⟨y, rfl⟩⟩

/-- Transport independent concrete coordinates through an injective group map.
The resulting equivalence agrees with each prescribed inclusion. -/
noncomputable def coordinateProduct (hgen : (⨆ i, (inc i).range) = ⊤) :
    ((i : I) → A i) ≃* E := by
  have hc : Pairwise fun i k => ∀ (x : A i) (y : A k), Commute (inc i x) (inc k y) := by
    exact coordinateCommute d f hf j hj inc hfac
  let F := MonoidHom.noncommPiCoprod inc hc
  have hF : Function.Injective F := by
    have hind : iSupIndep (fun i => (f.comp (inc i)).range) :=
      (d.factors_independent.comp hj).mono hfac
    have hm := MonoidHom.injective_noncommPiCoprod_of_iSupIndep
      (fun i => f.comp (inc i))
      (hcomm := fun i k hik x y => (hc hik x y).map f) hind (fun i => hf.comp (hi i))
    intro x y he
    apply hm
    rw [← MonoidHom.comp_noncommPiCoprod inc (hcomm := hc)]
    change f (F x) = f (F y)
    exact congrArg f he
  have hs : Function.Surjective F := MonoidHom.range_eq_top.mp
    ((MonoidHom.noncommPiCoprod_range inc).trans hgen)
  exact MulEquiv.ofBijective F ⟨hF, hs⟩

@[simp] theorem coordinateProduct_single [DecidableEq I]
    (hgen : (⨆ i, (inc i).range) = ⊤) (i : I) (a : A i) :
    coordinateProduct d f hf j hj inc hi hfac hgen (Pi.mulSingle i a) = inc i a :=
  MonoidHom.noncommPiCoprod_mulSingle inc
    (hcomm := coordinateCommute d f hf j hj inc hfac) i a

end Product

section Pullback
variable {D W E : Type*} [Group D] [AddCommGroup W] [Module (ZMod 2) W]
  {σ : Representation (ZMod 2) D W} (d : SolvableFFFactors σ) [Group E]
  (f : E →* D) (hf : Function.Injective f) (hr : f.range = offenderSubgroup σ)

/-- Pull back a concrete factor along the identified quotient image. -/
@[expose] def pulledFactor (i : Fin d.count) : Subgroup E := (d.factor i).comap f

include hr in
/-- Each pulled-back factor has its actual factor as its action image. -/
theorem pulledFactor_map (i : Fin d.count) : (pulledFactor d f i).map f = d.factor i := by
  rw [pulledFactor, Subgroup.map_comap_eq, hr, inf_eq_right]
  exact d.factor_le_offenderSubgroup i

/-- The multiplicative equivalence is induced by the literal action map. -/
@[expose] noncomputable def pulledFactorEquiv (i : Fin d.count) : pulledFactor d f i ≃* d.factor i :=
  MulEquiv.ofBijective (f.subgroupComap (d.factor i)) ⟨fun x y h =>
    Subtype.ext (hf (congrArg Subtype.val h)), by
      intro x
      obtain ⟨y, hy⟩ := (show (x : D) ∈ f.range from hr ▸ d.factor_le_offenderSubgroup i x.property)
      exact ⟨⟨y, (show f y ∈ d.factor i from hy.symm ▸ x.property)⟩, Subtype.ext hy⟩⟩

@[simp] theorem pulledFactorEquiv_apply (i : Fin d.count) (x : pulledFactor d f i) :
    (pulledFactorEquiv d f hf hr i x : D) = f x := rfl

include hf hr in
/-- Intrinsic odd cores commute with this isomorphism and the actual inclusions. -/
theorem pulledFactor_oddCore (i : Fin d.count) :
    ((pPrimeCore 2 (pulledFactor d f i)).map (pulledFactor d f i).subtype).map f =
      (pPrimeCore 2 (d.factor i)).map (d.factor i).subtype := by
  have he : f.comp (pulledFactor d f i).subtype =
      (d.factor i).subtype.comp (pulledFactorEquiv d f hf hr i).toMonoidHom := rfl
  rw [Subgroup.map_map, he, ← Subgroup.map_map, pPrimeCore_map_iso]

include hf hr in
/-- The whole quotient is generated by the pulled-back factors. -/
theorem iSup_pulledFactor : (⨆ i, pulledFactor d f i) = ⊤ := by
  apply Subgroup.map_injective hf
  rw [Subgroup.map_iSup]
  simp only [pulledFactor_map d f hr, d.iSup_factor, ← MonoidHom.range_eq_map]
  exact hr.symm

end Pullback
end CFSG.Quasithin.ChapterB.ThreeConjugates
