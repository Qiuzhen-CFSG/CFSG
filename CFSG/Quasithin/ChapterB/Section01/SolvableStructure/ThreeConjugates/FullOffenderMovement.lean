module
public import CFSG.Quasithin.ChapterB.Section01.SolvableStructure.ThreeConjugates.SingleOffender
public import CFSG.Quasithin.ChapterB.Section01.ComponentNormalization.Source
/-!
# Enlarging a moving offender family to all local best offenders

A quasisimple local component is normalized by every best offender. In the
cyclic-three case one member of the moving family acts nontrivially, hence
moves the whole subgroup; the single-offender theorem gives the same full
normalization. Containment of the original family then proves equality of
the commutator with the subgroup generated by all best offenders in T.

Source: Aschbacher--Smith B.1.5(4), B.1.12 and C.1.27, pp.68,73,133.
-/
public section
open Subgroup Theory.GroupTheory Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterB.ThreeConjugates
variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V] (ρ : Representation (ZMod 2) G V)

/-- B.1.5(4) on the actual local overgroup. -/
theorem local_best_normalizes_quasisimple (hf : Function.Injective ρ)
    (K T : Subgroup G) (hq : IsQuasisimple K)
    (hs : (K.subgroupOf (K ⊔ T)).IsSubnormal) :
    localOffenderSubgroup ρ T ≤ normalizer (K : Set G) := by
  let H := K ⊔ T
  let KH := K.subgroupOf H
  let : IsQuasisimple KH := IsQuasisimple.of_mulEquiv (subgroupOfEquivOfLe
    (show K ≤ H from le_sup_left)).symm
  have hKH : IsComponent H KH := ⟨hs,inferInstance⟩
  have hn := offenderSubgroup_le_normalizer_component (localRepresentation ρ K T)
    (hf.comp H.subtype_injective) hKH
  have hlocal := (localOffenderSubgroup_le_global ρ K T).trans hn
  apply le_normalizer_iff.mpr
  intro t ht k hk
  have htH : t ∈ H := ((localOffenderSubgroup_le ρ T).trans le_sup_right) ht
  exact (mem_normalizer_iff.mp (hlocal (show (⟨t,htH⟩ : H) ∈
    (localOffenderSubgroup ρ T).subgroupOf H from ht))
      (⟨k,(show K ≤ H from le_sup_left) hk⟩ : H)).mp hk

/-- Movement by any family of local best offenders extends to the full family. -/
theorem full_best_movement_of_family (hf : Function.Injective ρ)
    (K T : Subgroup G) (hk : IsQuasisimple K ∨ Nat.card K = 3)
    (hs : (K.subgroupOf (K ⊔ T)).IsSubnormal) (hT : IsPGroup 2 T)
    (P : Set (Subgroup G)) (hP : ∀ A ∈ P, IsBestOffender ρ A ∧ A ≤ T)
    (hm : K = ⁅K,generatedBy P ⊤⁆) : K = ⁅K,localOffenderSubgroup ρ T⁆ := by
  have hPJ : generatedBy P ⊤ ≤ localOffenderSubgroup ρ T := by
    exact iSup_le fun A => iSup_le fun hA =>
      le_iSup_of_le A (le_iSup_of_le (hP A hA.1) le_rfl)
  have hnorm : localOffenderSubgroup ρ T ≤ normalizer (K : Set G) := by
    rcases hk with hq | hc
    · exact local_best_normalizes_quasisimple ρ hf K T hq hs
    have hn : K ≠ ⊥ := by intro he; rw [he,card_bot] at hc; omega
    have ha : ∃ A ∈ P, ⁅K,A⁆ ≠ ⊥ := by
      by_contra! h
      apply hn
      rw [hm]
      apply commutator_eq_bot_iff_le_centralizer.mpr
      apply le_centralizer_iff.mp
      exact iSup_le fun A => iSup_le fun hA =>
        le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp (h A hA.1))
    obtain ⟨A,hA,ha⟩ := ha
    have hgen : A ≤ generatedBy P (⊤ : Subgroup G) := by
      exact le_iSup_of_le A (le_iSup_of_le ⟨hA, le_top⟩ le_rfl)
    have hAK : ⁅K,A⁆ ≤ K := (commutator_mono le_rfl hgen).trans hm.ge
    have hd := card_dvd_of_le hAK
    rw [hc] at hd
    have hcardA : Nat.card ↥(⁅K,A⁆ : Subgroup G) = 3 :=
      ((Nat.dvd_prime Nat.prime_three).mp hd).resolve_left (fun h => ha (card_eq_one.mp h))
    have he : K = ⁅K,A⁆ := (eq_of_le_of_card_ge hAK (by rw [hcardA,hc])).symm
    exact single_best_local_three_normalized hf K T A hs hc hT (hP A hA).1 (hP A hA).2 he
  exact le_antisymm (hm.le.trans (commutator_mono le_rfl hPJ))
    (le_normalizer_iff_commutator_le_left.mp hnorm)
end CFSG.Quasithin.ChapterB.ThreeConjugates
