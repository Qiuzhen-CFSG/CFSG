module

public import Theory.GroupTheory.Fitting.PrimeComplementCentralizer
public import Theory.Representation.BinaryOffender.FaithfulRankOne
public import Theory.Representation.BinaryOffender.TwoCoreFixedSpace
public import Theory.GroupAction.AbelianCoprimeFullFixedGeneration
public import Theory.GroupAction.SubgroupConjugation
public import Theory.GroupTheory.CharacteristicCentralizerFusion

/-!
# Minimal offenders and generation in solvable binary representations

For a finite solvable group with trivial two-core and a faithful binary
representation, every equal-weight minimal best offender has rank one,
and every best offender is generated by its minimal best offenders.

Put Q = O₂′(G). Fitting self-centralization makes every elementary
abelian two-subgroup A faithful on Q. Coprime fixed-point generation detects
any nonidentity b in A on C_Q(B), for an index-two subgroup B of A avoiding b.
If C_V(B) = C_V(A), then [C_Q(B), A] fixes C_V(B). The P × Q lemma makes this
commutator a two-group; since it lies in Q, it is trivial, a contradiction.
Thus the fixed space strictly increases, and best-offender maximality gives
equal weight. Minimality now forces B = 1.

For generation, when A has rank greater than one, first choose such a B,
then detect a nonidentity element of B to obtain a different hyperplane C.
Both hyperplanes are best offenders, B ⊔ C = A, and induction on subgroup
order finishes the proof. In particular, the existence of a second
hyperplane is proved using faithfulness on Q.

Source: Kurzweil–Stellmacher, *The Theory of Finite Groups*, 9.3.2,
printed pp. 240–241, PDF pp. 253–254 in `refs/original/kurzweil.pdf`.
Only S1 and S2 of that section are needed for this step; the ambient group
need not be generated by offenders. These results supply the offender step
of Aschbacher–Smith B.1.8(1)–(3); constructing the factors remains separate.
-/

public section

open Subgroup Representation.BinaryOffender
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.ChapterB.Glauberman
variable {G V : Type*} [Group G] [Finite G]
  [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]

private theorem detecting_hyperplane (A Q : Subgroup G)
    [IsElementaryAbelian 2 A] [Q.Normal]
    (hcop : Nat.Coprime 2 (Nat.card Q)) {b : G} (hb : b ∈ A)
    (hbQ : b ∉ centralizer (Q : Set G)) :
    ∃ B : Subgroup G, B ≤ A ∧ B.relIndex A = 2 ∧ b ∉ B ∧
      b ∉ centralizer (Q ⊓ centralizer (B : Set G) : Set G) := by
  classical
  let _ : Fact (IsPGroup 2 A) := ⟨IsElementaryAbelian.isPGroup 2 A⟩
  let _ : MulDistribMulAction A Q :=
    conjMulDistribMulActionOfLeNormalizer A Q le_normalizer_of_normal
  have hgen := iSup_fixedPoints_cyclicQuot_eq_top_of_coprime_abelian_pGroup_action
    (G := Q) (A := A) 2 hcop
  have hex : ∃ Y : Subgroup A, IsCyclic (A ⧸ Y) ∧
      b ∉ centralizer (Q ⊓ centralizer (Y.map A.subtype : Set G) : Set G) := by
    by_contra! hn
    apply hbQ
    intro x hx
    have htop : (⊤ : Subgroup Q) ≤ (centralizer ({b} : Set G)).subgroupOf Q := by
      rw [← hgen]
      refine iSup₂_le fun Y hY => ?_
      intro z hz
      have hzY : (z : G) ∈ Q ⊓ centralizer (Y.map A.subtype : Set G) := by
        refine ⟨z.property, ?_⟩
        rintro y ⟨y, hy, rfl⟩
        have hf := congrArg Subtype.val (hz (⟨y, hy⟩ : Y))
        change (y : G) * (z : G) * (y : G)⁻¹ = (z : G) at hf
        exact mul_inv_eq_iff_eq_mul.mp hf
      exact mem_centralizer_singleton_iff.mpr ((hn Y hY) z hzY)
    exact mem_centralizer_singleton_iff.mp (htop (mem_top (⟨x, hx⟩ : Q)))
  obtain ⟨Y, hY, hbY⟩ := hex
  let B := Y.map A.subtype
  have hBA : B ≤ A := map_subtype_le Y
  have hbB : b ∉ B := fun h => hbY (le_centralizer_iff.mpr inf_le_right h)
  have hi : B.relIndex A = 2 := by
    have hd : B.relIndex A ∣ 2 := by
      have hd' : Y.index ∣ 2 := by
        rw [index_eq_card, ← hY.exponent_eq_card]
        exact (Group.exponent_quotient_dvd Y).trans
          (IsElementaryAbelian.exponent_dvd_p 2 A)
      simpa only [B, relIndex, subgroupOf, comap_map_eq, A.ker_subtype, sup_bot_eq] using hd'
    apply ((Nat.dvd_prime Nat.prime_two).mp hd).resolve_left
    exact fun h => hbB (relIndex_eq_one.mp h hb)
  exact ⟨B, hBA, hi, hbB, hbY⟩

omit [Finite G] in
private theorem fixedSpace_lt_of_detecting
    (ρ : Representation (ZMod 2) G V) (hρ : Function.Injective ρ)
    (A B Q : Subgroup G) [IsElementaryAbelian 2 A] [Q.Normal]
    (hcop : Nat.Coprime 2 (Nat.card Q)) (hBA : B ≤ A)
    (hdetect : ¬ A ≤ centralizer (Q ⊓ centralizer (B : Set G) : Set G)) :
    fixedSpace ρ A < fixedSpace ρ B := by
  refine lt_of_le_of_ne (fixedSpace_antitone ρ hBA) ?_
  intro heq
  let C := Q ⊓ centralizer (B : Set G)
  have hAB : A ≤ centralizer (B : Set G) :=
    A.le_centralizer.trans (centralizer_le hBA)
  have hAN : A ≤ normalizer (C : Set G) :=
    (le_inf le_normalizer_of_normal
      ((hAB.trans (centralizer_le_normalizer _)).trans
        (normalizer_le_normalizer_centralizer B))).trans inf_normalizer_le_normalizer_inf
  have hcommC : ⁅C, A⁆ ≤ C := le_normalizer_iff_commutator_le_left.mp hAN
  have hBcomm : ⁅B, ⁅C, A⁆⁆ = ⊥ := by
    apply commutator_eq_bot_iff_le_centralizer.mpr
    exact le_centralizer_iff.mpr (hcommC.trans inf_le_right)
  have hstable : ∀ c ∈ C, ∀ v ∈ fixedSpace ρ B, ρ c v ∈ fixedSpace ρ B := by
    intro c hc v hv b
    change ρ b (ρ c v) = ρ c v
    rw [← Module.End.mul_apply, ← map_mul, hc.2 b b.property, map_mul,
      Module.End.mul_apply, show ρ b v = v from hv b]
  have hfix : ⁅C, A⁆ ≤ subspaceKernel ρ (fixedSpace ρ B) ⊤ := by
    apply commutator_le.mpr
    intro c hc a ha
    refine ⟨mem_top _, ?_⟩
    intro v hv
    have haiv : ρ a⁻¹ v = v := (heq.symm ▸ hv) ⟨a⁻¹, A.inv_mem ha⟩
    have haxiv : ρ a (ρ c⁻¹ v) = ρ c⁻¹ v :=
      (heq.symm ▸ hstable c⁻¹ (C.inv_mem hc) v hv) ⟨a, ha⟩
    simp only [commutatorElement_def, map_mul, Module.End.mul_apply, haiv, haxiv]
    simp only [← Module.End.mul_apply, ← map_mul, mul_inv_cancel, map_one, Module.End.one_apply]
  have hp := isPGroup_of_commuting_fixes_fixedSpace ρ hρ B ⁅C, A⁆
    ((IsElementaryAbelian.isPGroup 2 A).to_le hBA) hBcomm hfix
  have hodd : Nat.Coprime 2 (Nat.card (⁅C, A⁆ : Subgroup G)) :=
    hcop.of_dvd_right (card_dvd_of_le (hcommC.trans inf_le_left))
  have hbot : ⁅C, A⁆ = ⊥ := by
    apply eq_bot_of_card_eq
    exact hp.card_eq_or_dvd.resolve_right (Nat.Prime.coprime_iff_not_dvd Nat.prime_two |>.mp hodd)
  apply hdetect
  exact le_centralizer_iff.mpr (commutator_eq_bot_iff_le_centralizer.mp hbot)


private theorem rank_hyperplane {A B : Subgroup G} (hA : IsElementaryTwo A)
    (hBA : B ≤ A) (hi : B.relIndex A = 2) : rank A = rank B + 1 := by
  let _ : IsElementaryAbelian 2 A := hA.2
  have hc : Nat.card B * 2 = Nat.card A := by
    simpa only [relIndex_bot_left, hi] using relIndex_mul_relIndex ⊥ B A bot_le hBA
  obtain ⟨n, hn⟩ := ((IsElementaryAbelian.isPGroup 2 A).to_le hBA).exists_card_eq
  rw [rank, ← hc, hn, ← pow_succ, Nat.log_pow (by decide : 1 < 2)]
  simp only [rank, hn, Nat.log_pow (by decide : 1 < 2)]

private theorem two_subgroup_faithful_on_oddCore
    (hsolv : Group.IsSolvable G) (hcore : pCore 2 G = ⊥)
    {A : Subgroup G} (hA : IsPGroup 2 A) :
    A ⊓ centralizer (pPrimeCore 2 G : Set G) = ⊥ := by
  by_contra hne
  exact not_le_centralizer_pPrimeCore_of_isPGroup 2 hsolv hcore
    (hA.to_le inf_le_left) hne inf_le_right

/-- An element of an elementary two-subgroup detects an index-two subgroup
with a strictly larger fixed space, and lies outside that hyperplane. -/
theorem exists_offender_hyperplane_avoiding
    (ρ : Representation (ZMod 2) G V) (hρ : Function.Injective ρ)
    (hsolv : Group.IsSolvable G) (hcore : pCore 2 G = ⊥)
    {A : Subgroup G} (hA : IsElementaryTwo A)
    {b : G} (hb : b ∈ A) (hbne : b ≠ 1) :
    ∃ B : Subgroup G, B ≤ A ∧ B.relIndex A = 2 ∧ b ∉ B ∧
      rank A = rank B + 1 ∧ fixedSpace ρ A < fixedSpace ρ B := by
  let _ : IsElementaryAbelian 2 A := hA.2
  have hfaith := two_subgroup_faithful_on_oddCore hsolv hcore
    (IsElementaryAbelian.isPGroup 2 A)
  have hbQ : b ∉ centralizer (pPrimeCore 2 G : Set G) :=
    fun hc => hbne (hfaith.le ⟨hb, hc⟩)
  obtain ⟨B, hBA, hi, hbB, hdetect⟩ := detecting_hyperplane A (pPrimeCore 2 G)
    pPrimeCore_coprime_card hb hbQ
  exact ⟨B, hBA, hi, hbB, rank_hyperplane hA hBA hi,
    fixedSpace_lt_of_detecting ρ hρ A B (pPrimeCore 2 G) pPrimeCore_coprime_card hBA
      (fun hc => hdetect (hc hb))⟩

/-- Equal-weight minimal best offenders have rank one in a faithful binary
representation of a finite solvable group with trivial two-core. -/
theorem minimalBestOffender_rank_one
    (ρ : Representation (ZMod 2) G V) (hρ : Function.Injective ρ)
    (hsolv : Group.IsSolvable G) (hcore : pCore 2 G = ⊥)
    {A : Subgroup G} (hA : IsMinimalBestOffender ρ A) : rank A = 1 := by
  obtain ⟨b, hb, hbne⟩ := A.bot_or_exists_ne_one.resolve_left hA.1.1.1
  obtain ⟨B, hBA, _, _, hr, hf⟩ :=
    exists_offender_hyperplane_avoiding ρ hρ hsolv hcore hA.1.1 hb hbne
  exact hA.rank_one_of_hyperplane ρ hBA hr hf

omit [Finite G] in
private theorem hyperplane_sup_eq {A B C : Subgroup G}
    (hBA : B ≤ A) (hCA : C ≤ A) (hi : C.relIndex A = 2)
    {b : G} (hb : b ∈ B) (hbC : b ∉ C) : B ⊔ C = A := by
  have hm := relIndex_mul_relIndex C (B ⊔ C) A le_sup_right (sup_le hBA hCA)
  rw [hi] at hm
  have hp : (C.relIndex (B ⊔ C) * (B ⊔ C).relIndex A).Prime := hm ▸ Nat.prime_two
  rcases Nat.prime_mul_iff.mp hp with ⟨_, hr⟩ | ⟨_, hl⟩
  · exact le_antisymm (sup_le hBA hCA) (relIndex_eq_one.mp hr)
  · exact (hbC (relIndex_eq_one.mp hl (mem_sup_left hb))).elim

/-- Every best offender is generated by the minimal best offenders contained
in it. Minimality is the original equal-weight minimality. -/
theorem bestOffender_generatedBy_minimal
    (ρ : Representation (ZMod 2) G V) (hρ : Function.Injective ρ)
    (hsolv : Group.IsSolvable G) (hcore : pCore 2 G = ⊥)
    {A : Subgroup G} (hA : IsBestOffender ρ A) :
    generatedBy {B | IsMinimalBestOffender ρ B} A = A := by
  classical
  induction hc : Nat.card A using Nat.strong_induction_on generalizing A with
  | h n ih =>
    apply le_antisymm (iSup₂_le fun B hB => hB.2)
    by_cases hrank : rank A = 1
    · obtain ⟨B, hB, he⟩ := hA.exists_minimal ρ
      have hrB := minimalBestOffender_rank_one ρ hρ hsolv hcore hB
      have hEq : B = A := eq_of_le_of_card_ge he.1 (by
        rw [hA.1.card_eq_two_pow_rank, hB.1.1.card_eq_two_pow_rank, hrank, hrB])
      subst B
      exact le_iSup_of_le A (le_iSup_of_le ⟨hB, le_rfl⟩ le_rfl)
    obtain ⟨a, ha, hane⟩ := A.bot_or_exists_ne_one.resolve_left hA.1.1
    obtain ⟨B, hBA, hiB, _, hrB, hfB⟩ :=
      exists_offender_hyperplane_avoiding ρ hρ hsolv hcore hA.1 ha hane
    have hBne : B ≠ ⊥ := by
      intro h
      simp only [h, Representation.BinaryOffender.rank_bot, zero_add] at hrB
      exact hrank hrB
    obtain ⟨b, hb, hbne⟩ := B.bot_or_exists_ne_one.resolve_left hBne
    obtain ⟨C, hCA, hiC, hbC, hrC, hfC⟩ :=
      exists_offender_hyperplane_avoiding ρ hρ hsolv hcore hA.1 (hBA hb) hbne
    have hCne : C ≠ ⊥ := by
      intro h
      simp only [h, Representation.BinaryOffender.rank_bot, zero_add] at hrC
      exact hrank hrC
    have hBbest := hA.of_equalWeightLE ρ (hA.1.of_le hBA hBne)
      (hA.equalWeightLE_of_hyperplane ρ hBA hrB hfB)
    have hCbest := hA.of_equalWeightLE ρ (hA.1.of_le hCA hCne)
      (hA.equalWeightLE_of_hyperplane ρ hCA hrC hfC)
    have hsmall (D : Subgroup G) (hDA : D ≤ A) (hiD : D.relIndex A = 2) :
        Nat.card D < n := by
      have hd : Nat.card D * 2 = Nat.card A := by
        simpa only [relIndex_bot_left, hiD] using
          relIndex_mul_relIndex ⊥ D A bot_le hDA
      have := Nat.card_pos (α := D)
      omega
    have hgenB := ih (Nat.card B) (hsmall B hBA hiB) hBbest rfl
    have hgenC := ih (Nat.card C) (hsmall C hCA hiC) hCbest rfl
    have hgen_mono (D : Subgroup G) (hDA : D ≤ A) :
        generatedBy {E | IsMinimalBestOffender ρ E} D ≤
          generatedBy {E | IsMinimalBestOffender ρ E} A := by
      exact iSup₂_le fun E hE =>
        le_iSup_of_le E (le_iSup_of_le ⟨hE.1, hE.2.trans hDA⟩ le_rfl)
    calc
      A = B ⊔ C := (hyperplane_sup_eq hBA hCA hiC hb hbC).symm
      _ ≤ generatedBy {E | IsMinimalBestOffender ρ E} A :=
        sup_le (hgenB.ge.trans (hgen_mono B hBA)) (hgenC.ge.trans (hgen_mono C hCA))

/-- The equality case of the offender inequality, source 9.3.2(a).
This applies the rank-one result to strict Thompson replacement. -/
theorem bestOffender_fixedCodim_eq_rank
    (ρ : Representation (ZMod 2) G V) (hρ : Function.Injective ρ)
    (hsolv : Group.IsSolvable G) (hcore : pCore 2 G = ⊥)
    {A : Subgroup G} (hA : IsBestOffender ρ A) : fixedCodim ρ A = rank A :=
  hA.fixedCodim_eq_rank_of_minimal_rank_one ρ hρ
    (fun _ hB => minimalBestOffender_rank_one ρ hρ hsolv hcore hB)

end CFSG.Quasithin.ChapterB.Glauberman
