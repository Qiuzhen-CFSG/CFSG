module

public import CFSG.Quasithin.ChapterB.Section01.SolvableStructure.Glauberman.LocalBlock
public import Theory.Representation.BinaryOffender.Stability
public import Theory.Representation.BinaryOffender.FaithfulRankOne
public import Theory.GroupTheory.Fitting.PrimeComplementCentralizer
public import Theory.GroupTheory.PResidualCommutator

public import Mathlib.GroupTheory.IsSubnormal

/-!
# Reductions for the local solvable FF factors

The normal subgroup generated by the best offenders has trivial two-core
when the ambient group does. Its odd core is the intersection with the
ambient odd core. Coprime commutator idempotence then identifies the actual
commutators with an offender before and after this restriction; mere core
containment would not suffice.

A rank-one minimal best offender has order two and moves precisely one
binary dimension. The pair construction below fixes the literal subgroups
and equivariant output for the next source step. No pair witness or support
separation theorem is assumed to exist by these definitions.

Source: Kurzweil–Stellmacher, *The Theory of Finite Groups*, §9.3,
9.3.2–9.3.6, printed pp.240–246, PDF pp.253–259 of
`refs/original/kurzweil.pdf`. These are prerequisites for the existence of
`SolvableFFLocalBlock`, not a proof of its existence.
-/

@[expose] public section

open Subgroup Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterB.Glauberman.BlockConstruction
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

theorem offender_le {A : Subgroup G} (hA : IsBestOffender ρ A) :
    A ≤ offenderSubgroup ρ :=
  le_iSup_of_le A (le_iSup_of_le ⟨hA, le_top⟩ le_rfl)

theorem minimal_generates
    (hgen : ∀ A, IsBestOffender ρ A →
      generatedBy {B | IsMinimalBestOffender ρ B} A = A) :
    generatedBy {B | IsMinimalBestOffender ρ B} ⊤ = offenderSubgroup ρ := by
  apply le_antisymm
  · exact iSup_le fun A => iSup_le fun hA => offender_le ρ hA.1.1
  · refine iSup_le fun A => iSup_le fun hA => ?_
    rw [← hgen A hA.1]
    exact iSup_le fun B => iSup_le fun hB =>
      le_iSup_of_le B (le_iSup_of_le ⟨hB.1, le_top⟩ le_rfl)

theorem offender_pCore_eq_bot (hcore : pCore 2 G = ⊥) :
    pCore 2 (offenderSubgroup ρ) = ⊥ := by
  let H := offenderSubgroup ρ
  let : H.Normal := offenderSubgroup_normal ρ
  have hn : ((pCore 2 H).map H.subtype).Normal :=
    ConjAct.normal_of_characteristic_of_normal
  have hl : (pCore 2 H).map H.subtype ≤ pCore 2 G :=
    le_sSup ⟨hn, pCore_isPGroup.map H.subtype⟩
  apply (map_eq_bot_iff_of_injective _ H.subtype_injective).mp
  exact le_bot_iff.mp (hcore ▸ hl)

theorem oddCore_restriction [Finite G] :
    (pPrimeCore 2 (offenderSubgroup ρ)).map (offenderSubgroup ρ).subtype =
      pPrimeCore 2 G ⊓ offenderSubgroup ρ := by
  let H := offenderSubgroup ρ
  let : H.Normal := offenderSubgroup_normal ρ
  apply le_antisymm
  · exact le_inf (pPrimeCore_map_subtype_le_pPrimeCore_of_normal 2 H) (map_subtype_le _)
  · have hc : (pPrimeCore 2 G).comap H.subtype ≤ pPrimeCore 2 H := by
      apply le_sSup
      exact ⟨inferInstance, (pPrimeCore_coprime_card (p := 2) (G := G)).of_dvd_right
        ((pPrimeCore 2 G).card_comap_dvd_of_injective H.subtype H.subtype_injective)⟩
    rintro x ⟨hx, hh⟩
    exact ⟨⟨x, hh⟩, hc hx, rfl⟩

theorem commutator_le_offender {A : Subgroup G} (hA : IsBestOffender ρ A) :
    ⁅pPrimeCore 2 G, A⁆ ≤ offenderSubgroup ρ := by
  let := offenderSubgroup_normal ρ
  exact (commutator_mono le_rfl (offender_le ρ hA)).trans (commutator_le_right _ _)

theorem factor_le_offender {A : Subgroup G} (hA : IsBestOffender ρ A) :
    ⁅pPrimeCore 2 G, A⁆ ⊔ A ≤ offenderSubgroup ρ :=
  sup_le (commutator_le_offender ρ hA) (offender_le ρ hA)

private theorem commutator_idempotent [Finite G] {A : Subgroup G}
    (hA : IsElementaryTwo A) :
    ⁅⁅pPrimeCore 2 G, A⁆, A⁆ = ⁅pPrimeCore 2 G, A⁆ := by
  have hc : Nat.Coprime (Nat.card A) (Nat.card (pPrimeCore 2 G)) := by
    rw [hA.card_eq_two_pow_rank]
    exact (pPrimeCore_coprime_card (p := 2) (G := G)).pow_left _
  have h := commutator_closure_coprime_idempotent (pPrimeCore 2 G) (A : Set G)
    (by rw [closure_eq, normalizer_eq_top]; exact le_top)
    (fun a ha => hc.of_dvd_left (A.orderOf_dvd_natCard ha))
  simpa only [closure_eq] using h

theorem oddCore_commutator_restriction [Finite G] {A : Subgroup G}
    (hA : IsBestOffender ρ A) :
    ⁅(pPrimeCore 2 (offenderSubgroup ρ)).map (offenderSubgroup ρ).subtype, A⁆ =
      ⁅pPrimeCore 2 G, A⁆ := by
  rw [oddCore_restriction]
  apply le_antisymm (commutator_mono inf_le_left le_rfl)
  rw [← commutator_idempotent hA.1]
  exact commutator_mono
    (le_inf (commutator_le_left _ _) (commutator_le_offender ρ hA)) le_rfl

theorem intrinsic_commutator_map [Finite G] {A : Subgroup G}
    (hA : IsBestOffender ρ A) :
    (⁅pPrimeCore 2 (offenderSubgroup ρ), A.subgroupOf (offenderSubgroup ρ)⁆).map
      (offenderSubgroup ρ).subtype = ⁅pPrimeCore 2 G, A⁆ := by
  rw [map_commutator, map_subgroupOf_eq_of_le (offender_le ρ hA)]
  exact oddCore_commutator_restriction ρ hA

theorem minimal_card [Finite G] {A : Subgroup G}
    (hA : IsMinimalBestOffender ρ A) (hrank : rank A = 1) : Nat.card A = 2 := by
  simpa only [hrank, pow_one] using hA.1.1.card_eq_two_pow_rank

theorem minimal_fixedCodim [FiniteDimensional (ZMod 2) V]
    (hρ : Function.Injective ρ) {A : Subgroup G}
    (hA : IsMinimalBestOffender ρ A) (hrank : rank A = 1) : fixedCodim ρ A = 1 := by
  have := fixedCodim_pos_of_faithful ρ hρ hA.1.1.1
  have := (hA.1.isOffender ρ).2
  omega

private theorem moved_finrank_eq_fixedCodim_of_card_two [FiniteDimensional (ZMod 2) V]
    {A : Subgroup G} (hcard : Nat.card A = 2) :
    Module.finrank (ZMod 2) (subspaceCommutator ρ ⊤ A) = fixedCodim ρ A := by
  obtain ⟨a, ha, hall⟩ := (Nat.card_eq_two_iff' (1 : A)).mp hcard
  have hcases (b : A) : b = 1 ∨ b = a := by
    by_cases hb : b = 1
    · exact Or.inl hb
    · exact Or.inr (hall b hb)
  let d := ρ (a : G) - LinearMap.id
  have hrange : subspaceCommutator ρ ⊤ A = LinearMap.range d := by
    apply le_antisymm
    · apply Submodule.span_le.mpr
      rintro v ⟨b, hb, w, _, rfl⟩
      rcases hcases ⟨b, hb⟩ with he | he
      · have hb1 : b = 1 := congrArg Subtype.val he
        simp only [hb1, map_one, Module.End.one_apply, sub_self]
        exact Submodule.zero_mem _
      · have hba : b = (a : G) := congrArg Subtype.val he
        exact ⟨w, by simp [d, hba]⟩
    · rintro v ⟨w, rfl⟩
      exact Submodule.subset_span ⟨a, a.property, w, Submodule.mem_top, rfl⟩
  have hker : LinearMap.ker d = fixedSpace ρ A := by
    ext v
    change ρ (a : G) v - v = 0 ↔ ∀ b : A, ρ (b : G) v = v
    rw [sub_eq_zero]
    constructor
    · intro hv b
      rcases hcases b with rfl | rfl
      · simp
      · exact hv
    · intro hv
      exact hv a
  have hr := d.finrank_range_add_finrank_ker
  have hc := fixedCodim_add_finrank ρ A
  rw [hker, ← hrange] at hr
  omega

theorem minimal_moved_finrank [Finite G] [FiniteDimensional (ZMod 2) V]
    (hρ : Function.Injective ρ) {A : Subgroup G}
    (hA : IsMinimalBestOffender ρ A) (hrank : rank A = 1) :
    Module.finrank (ZMod 2) (subspaceCommutator ρ ⊤ A) = 1 := by
  rw [moved_finrank_eq_fixedCodim_of_card_two ρ (minimal_card ρ hA hrank)]
  exact minimal_fixedCodim ρ hρ hA hrank

theorem minimal_moved_ne_bot (hρ : Function.Injective ρ) {A : Subgroup G}
    (hA : IsMinimalBestOffender ρ A) : subspaceCommutator ρ ⊤ A ≠ ⊥ := by
  intro hbot
  have hf := (subspaceCommutator_eq_bot_iff ρ ⊤ A).mp hbot
  apply hA.1.1.1
  apply A.eq_bot_iff_forall.mpr
  intro a ha
  apply hρ
  ext v
  simpa using hf (Submodule.mem_top) ⟨a, ha⟩

theorem exists_noncentral_odd [Finite G] (hsolv : Group.IsSolvable G)
    (hcore : pCore 2 G = ⊥) {A : Subgroup G} (hA : IsMinimalBestOffender ρ A) :
    ∃ x ∈ pPrimeCore 2 G, x ∉ centralizer (A : Set G) := by
  let : IsElementaryAbelian 2 A := hA.1.1.2
  have hnc := not_le_centralizer_pPrimeCore_of_isPGroup 2 hsolv hcore
    (IsElementaryAbelian.isPGroup 2 A) hA.1.1.1
  by_contra! h
  apply hnc
  exact le_centralizer_iff.mp h


/-- The actual group generated by an offender and its conjugate. We use
left conjugation `x A x⁻¹`; replacing x by x⁻¹ recovers the book convention. -/
def conjugatePair (A : Subgroup G) (x : G) : Subgroup G :=
  A ⊔ A.map (MulAut.conj x).toMonoidHom

/-- The pair-level output of 9.3.3, including the literal cubic odd subgroup
and its support. The splitting follows from that odd action and rank one. -/
structure PairData (A : Subgroup G) (x : G) where
  model : conjugatePair A x ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod 2)
  naturalEquiv : subspaceCommutator ρ ⊤ (conjugatePair A x) ≃ₗ[ZMod 2]
    (Fin 2 → ZMod 2)
  naturalEquiv_action : ∀ (g : conjugatePair A x)
      (v : subspaceCommutator ρ ⊤ (conjugatePair A x)),
    ρ (g : G) (v : V) = (naturalEquiv.symm
      (Representation.specialLinearNatural 2 (model g) (naturalEquiv v)) : V)
  complement : IsCompl (subspaceCommutator ρ ⊤ (conjugatePair A x))
    (fixedSpace ρ (conjugatePair A x))
  odd_card : Nat.card ↥(conjugatePair A x ⊓ pPrimeCore 2 G) = 3
  odd_support : subspaceCommutator ρ ⊤ (conjugatePair A x ⊓ pPrimeCore 2 G) =
    subspaceCommutator ρ ⊤ (conjugatePair A x)

/-- The precise special case of 9.3.5 needed here: two subnormal cubic
subgroups with binary plane supports have equal or independent supports.
Subnormality is inside K, not inside the ambient group. -/
def CubicSupportSeparation (K : Subgroup G) : Prop :=
  ∀ X Y : Subgroup G, X ≤ K → Y ≤ K →
    (X.subgroupOf K).IsSubnormal → (Y.subgroupOf K).IsSubnormal →
    Nat.card X = 3 → Nat.card Y = 3 →
    Module.finrank (ZMod 2) (subspaceCommutator ρ ⊤ X) = 2 →
    Module.finrank (ZMod 2) (subspaceCommutator ρ ⊤ Y) = 2 →
    subspaceCommutator ρ ⊤ X = subspaceCommutator ρ ⊤ Y ∨
      Disjoint (subspaceCommutator ρ ⊤ X) (subspaceCommutator ρ ⊤ Y) ∧
        subspaceCommutator ρ ⊤ X ≤ fixedSpace ρ Y ∧
        subspaceCommutator ρ ⊤ Y ≤ fixedSpace ρ X

end CFSG.Quasithin.ChapterB.Glauberman.BlockConstruction
