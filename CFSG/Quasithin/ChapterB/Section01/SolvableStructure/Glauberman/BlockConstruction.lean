module

public import CFSG.Quasithin.ChapterB.Section01.SolvableStructure.Glauberman.LocalBlock
public import CFSG.Quasithin.ChapterB.Section01.SolvableStructure.Glauberman.BlockConstruction.Basic
public import CFSG.Quasithin.ChapterB.Section01.SolvableStructure.Glauberman.BlockConstruction.PairRecognition
public import CFSG.Quasithin.ChapterB.Section01.SolvableStructure.Glauberman.BlockConstruction.SupportSeparation
public import CFSG.Quasithin.ChapterB.Section01.SolvableStructure.Glauberman.BlockConstruction.OddCommutators

/-!
# Constructing a local solvable FF factor

For a rank-one minimal best offender A, the literal factor [O₂′(G), A]A
is generated by the conjugate pairs ⟨A, xAx⁻¹⟩. Their cubic odd subgroups
are subnormal inside O₂′(G). Support separation forces their binary planes
to agree, since all contain the nonzero line [V,A].

The odd commutator acts faithfully on that plane, so its odd order divides
|GL₂(2)| = 6. Its cubic pair subgroup therefore equals the full commutator,
and the full factor equals one recognized pair. This supplies the actual
SL₂(2) isomorphism, equivariant natural module and fixed-space complement.
For two minimal offenders, equal supports force equality of the odd groups
and then of the factors; separated supports give mutual pointwise fixation
and centralization. Thus every field of `SolvableFFLocalBlock` is constructed.

The earlier conditional support APIs are preserved. Their pair recognition,
relative subnormality and support separation premises are discharged in the
final construction. Normality and subnormality of the cubic groups are only
used relative to the odd core. The best-offender generation premise is
retained for the parent assembly but is not needed for an individual block.

Source: Kurzweil–Stellmacher, *The Theory of Finite Groups*, 9.3.3–9.3.6,
printed pp.241–246, PDF pp.254–259 of `refs/original/kurzweil.pdf`, supporting
Aschbacher–Smith B.1.8(1)–(3).
-/

public section

open Subgroup Representation.BinaryOffender
open scoped commutatorElement
namespace CFSG.Quasithin.ChapterB.Glauberman.BlockConstruction
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V)

/-- Every odd-core conjugate pair lies in the prescribed factor. -/
theorem pair_le_factor (A : Subgroup G) {x : G} (hx : x ∈ pPrimeCore 2 G) :
    conjugatePair A x ≤ ⁅pPrimeCore 2 G, A⁆ ⊔ A := by
  apply sup_le le_sup_right
  rintro _ ⟨a, ha, rfl⟩
  have hc : ⁅x, a⁆ ∈ ⁅pPrimeCore 2 G, A⁆ ⊔ A :=
    (le_sup_left : ⁅pPrimeCore 2 G, A⁆ ≤ ⁅pPrimeCore 2 G, A⁆ ⊔ A)
      (commutator_mem_commutator hx ha)
  have ha' : a ∈ ⁅pPrimeCore 2 G, A⁆ ⊔ A :=
    (le_sup_right : A ≤ ⁅pPrimeCore 2 G, A⁆ ⊔ A) ha
  have hm := (⁅pPrimeCore 2 G, A⁆ ⊔ A).mul_mem hc ha'
  simpa only [commutatorElement_def, mul_assoc, inv_mul_cancel, mul_one,
    MulAut.conj_apply, MulEquiv.toMonoidHom_eq_coe, MonoidHom.coe_coe] using hm

/-- Exact generation by all odd-core conjugate pairs, including centralizing ones. -/
theorem factor_eq_iSup_pairs (A : Subgroup G) :
    ⁅pPrimeCore 2 G, A⁆ ⊔ A = ⨆ x : pPrimeCore 2 G, conjugatePair A x := by
  apply le_antisymm
  · have hA : A ≤ ⨆ x : pPrimeCore 2 G, conjugatePair A x :=
      le_sup_left.trans (le_iSup (fun x : pPrimeCore 2 G => conjugatePair A x) 1)
    apply sup_le ?_ hA
    apply commutator_le.mpr
    intro x hx a ha
    have hh : x * a * x⁻¹ ∈ ⨆ x : pPrimeCore 2 G, conjugatePair A x := by
      apply le_iSup (fun x : pPrimeCore 2 G => conjugatePair A x) ⟨x, hx⟩
      exact (le_sup_right : A.map (MulAut.conj x).toMonoidHom ≤ conjugatePair A x)
        (mem_map_of_mem _ ha)
    have hm := (⨆ x : pPrimeCore 2 G, conjugatePair A x).mul_mem hh
      ((⨆ x : pPrimeCore 2 G, conjugatePair A x).inv_mem (hA ha))
    exact hm
  · exact iSup_le fun x => pair_le_factor A x.property

/-- A centralizing conjugator contributes just the original offender. -/
theorem pair_eq_left_of_centralizing (A : Subgroup G) {x : G}
    (hx : x ∈ centralizer (A : Set G)) : conjugatePair A x = A := by
  apply le_antisymm ?_ le_sup_left
  apply sup_le le_rfl
  rintro _ ⟨a, ha, rfl⟩
  have hc : a * x = x * a := mem_centralizer_iff.mp hx a ha
  change x * a * x⁻¹ ∈ A
  rw [← hc, mul_assoc, mul_inv_cancel, mul_one]
  exact ha

private theorem moved_mono {A B : Subgroup G} (h : A ≤ B) :
    subspaceCommutator ρ ⊤ A ≤ subspaceCommutator ρ ⊤ B := by
  apply Submodule.span_mono
  rintro v ⟨a, ha, w, hw, rfl⟩
  exact ⟨a, h ha, w, hw, rfl⟩

private theorem moved_iSup {ι : Type*} (B : ι → Subgroup G) :
    subspaceCommutator ρ ⊤ (⨆ i, B i) = ⨆ i, subspaceCommutator ρ ⊤ (B i) := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨b, hb, v, _, rfl⟩
    have hh : ∀ v : V, ρ b v - v ∈ ⨆ i, subspaceCommutator ρ ⊤ (B i) := by
      refine Subgroup.iSup_induction B
        (C := fun b => ∀ v : V, ρ b v - v ∈ ⨆ i, subspaceCommutator ρ ⊤ (B i))
        hb ?_ ?_ ?_
      · intro i b hb v
        exact le_iSup (fun i => subspaceCommutator ρ ⊤ (B i)) i
          (Submodule.subset_span ⟨b, hb, v, Submodule.mem_top, rfl⟩)
      · intro v
        simp
      · intro a b ha hb v
        have hh := (⨆ i, subspaceCommutator ρ ⊤ (B i)).add_mem (ha (ρ b v)) (hb v)
        simpa only [map_mul, Module.End.mul_apply, sub_add_sub_cancel] using hh
    exact hh v
  · exact iSup_le fun i => moved_mono ρ (le_iSup B i)

/-- The equivariant natural-module witness gives the actual support dimension. -/
theorem PairData.moved_finrank {A : Subgroup G} {x : G} (d : PairData ρ A x) :
    Module.finrank (ZMod 2) (subspaceCommutator ρ ⊤ (conjugatePair A x)) = 2 := by
  simpa using d.naturalEquiv.finrank_eq

/-- The common nonzero offender line excludes disjoint pair supports. -/
theorem pair_support_eq_of_separation (hρ : Function.Injective ρ)
    {A : Subgroup G} (hA : IsMinimalBestOffender ρ A) {x y : G}
    (dx : PairData ρ A x) (dy : PairData ρ A y)
    (hxsub : ((conjugatePair A x ⊓ pPrimeCore 2 G).subgroupOf
      (pPrimeCore 2 G)).IsSubnormal)
    (hysub : ((conjugatePair A y ⊓ pPrimeCore 2 G).subgroupOf
      (pPrimeCore 2 G)).IsSubnormal)
    (hsep : CubicSupportSeparation ρ (pPrimeCore 2 G)) :
    subspaceCommutator ρ ⊤ (conjugatePair A x) =
      subspaceCommutator ρ ⊤ (conjugatePair A y) := by
  have hdx : Module.finrank (ZMod 2)
      (subspaceCommutator ρ ⊤ (conjugatePair A x ⊓ pPrimeCore 2 G)) = 2 := by
    rw [dx.odd_support]
    exact dx.moved_finrank ρ
  have hdy : Module.finrank (ZMod 2)
      (subspaceCommutator ρ ⊤ (conjugatePair A y ⊓ pPrimeCore 2 G)) = 2 := by
    rw [dy.odd_support]
    exact dy.moved_finrank ρ
  have hh := hsep _ _ inf_le_right inf_le_right hxsub hysub dx.odd_card dy.odd_card hdx hdy
  rw [dx.odd_support, dy.odd_support] at hh
  rcases hh with he | ⟨hd, _, _⟩
  · exact he
  · have haX : subspaceCommutator ρ ⊤ A ≤
        subspaceCommutator ρ ⊤ (conjugatePair A x) := moved_mono ρ le_sup_left
    have haY : subspaceCommutator ρ ⊤ A ≤
        subspaceCommutator ρ ⊤ (conjugatePair A y) := moved_mono ρ le_sup_left
    exact (minimal_moved_ne_bot ρ hρ hA
      (le_bot_iff.mp ((le_inf haX haY).trans hd.le_bot))).elim

/-- The literal full factor has the support of any noncentral conjugate pair. -/
theorem factor_support_eq_pair (hρ : Function.Injective ρ)
    {A : Subgroup G} (hA : IsMinimalBestOffender ρ A)
    (hpairs : ∀ x ∈ pPrimeCore 2 G, x ∉ centralizer (A : Set G) →
      Nonempty (PairData ρ A x))
    (hsub : ∀ x ∈ pPrimeCore 2 G, x ∉ centralizer (A : Set G) →
      ((conjugatePair A x ⊓ pPrimeCore 2 G).subgroupOf (pPrimeCore 2 G)).IsSubnormal)
    (hsep : CubicSupportSeparation ρ (pPrimeCore 2 G))
    {x : G} (hx : x ∈ pPrimeCore 2 G) (hxc : x ∉ centralizer (A : Set G)) :
    subspaceCommutator ρ ⊤ (⁅pPrimeCore 2 G, A⁆ ⊔ A) =
      subspaceCommutator ρ ⊤ (conjugatePair A x) := by
  obtain ⟨dx⟩ := hpairs x hx hxc
  apply le_antisymm
  · rw [factor_eq_iSup_pairs, moved_iSup]
    apply iSup_le
    intro y
    by_cases hyc : (y : G) ∈ centralizer (A : Set G)
    · rw [pair_eq_left_of_centralizing A hyc]
      exact moved_mono ρ le_sup_left
    · obtain ⟨dy⟩ := hpairs y y.property hyc
      exact (pair_support_eq_of_separation ρ hρ hA dy dx
        (hsub y y.property hyc) (hsub x hx hxc) hsep).le
  · exact moved_mono ρ (pair_le_factor A hx)

/-- Conditional plane-support conclusion for the actual local factor. -/
theorem factor_moved_finrank [Finite G] (hsolv : Group.IsSolvable G)
    (hcore : pCore 2 G = ⊥) (hρ : Function.Injective ρ)
    {A : Subgroup G} (hA : IsMinimalBestOffender ρ A)
    (hpairs : ∀ x ∈ pPrimeCore 2 G, x ∉ centralizer (A : Set G) →
      Nonempty (PairData ρ A x))
    (hsub : ∀ x ∈ pPrimeCore 2 G, x ∉ centralizer (A : Set G) →
      ((conjugatePair A x ⊓ pPrimeCore 2 G).subgroupOf (pPrimeCore 2 G)).IsSubnormal)
    (hsep : CubicSupportSeparation ρ (pPrimeCore 2 G)) :
    Module.finrank (ZMod 2) (subspaceCommutator ρ ⊤ (⁅pPrimeCore 2 G, A⁆ ⊔ A)) = 2 := by
  obtain ⟨x, hx, hxc⟩ := exists_noncentral_odd ρ hsolv hcore hA
  rw [factor_support_eq_pair ρ hρ hA hpairs hsub hsep hx hxc]
  obtain ⟨dx⟩ := hpairs x hx hxc
  exact dx.moved_finrank ρ


private theorem support_sup (X Y : Subgroup G) :
    subspaceCommutator ρ ⊤ (X ⊔ Y) =
      subspaceCommutator ρ ⊤ X ⊔ subspaceCommutator ρ ⊤ Y := by
  let W := subspaceCommutator ρ ⊤ X ⊔ subspaceCommutator ρ ⊤ Y
  let T : Subgroup G := {
    carrier := {g | ∀ v, ρ g v - v ∈ W}
    one_mem' := by intro v; simp
    mul_mem' := by
      intro a b ha hb v
      have hh := W.add_mem (ha (ρ b v)) (hb v)
      simpa only [map_mul, Module.End.mul_apply, sub_add_sub_cancel] using hh
    inv_mem' := by
      intro a ha v
      have hh := W.neg_mem (ha (ρ a⁻¹ v))
      simpa only [← Module.End.mul_apply, ← map_mul, mul_inv_cancel, map_one,
        Module.End.one_apply, neg_sub] using hh }
  have hT : X ⊔ Y ≤ T := by
    apply sup_le
    · intro x hx v
      exact Submodule.mem_sup_left (Submodule.subset_span ⟨x, hx, v, trivial, rfl⟩)
    · intro y hy v
      exact Submodule.mem_sup_right (Submodule.subset_span ⟨y, hy, v, trivial, rfl⟩)
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨g, hg, v, _, rfl⟩
    exact hT hg v
  · exact sup_le (moved_mono ρ le_sup_left) (moved_mono ρ le_sup_right)

private theorem fixed_sup (X Y : Subgroup G) :
    fixedSpace ρ (X ⊔ Y) = fixedSpace ρ X ⊓ fixedSpace ρ Y := by
  apply le_antisymm
  · exact le_inf (fixedSpace_antitone ρ le_sup_left) (fixedSpace_antitone ρ le_sup_right)
  · intro v hv g
    have hle : X ⊔ Y ≤ subspaceKernel ρ (Submodule.span (ZMod 2) {v}) ⊤ := by
      apply sup_le
      · intro x hx
        refine ⟨mem_top _, ?_⟩
        intro w hw
        obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp hw
        rw [map_smul, show ρ x v = v from hv.1 ⟨x, hx⟩]
      · intro y hy
        refine ⟨mem_top _, ?_⟩
        intro w hw
        obtain ⟨a, rfl⟩ := Submodule.mem_span_singleton.mp hw
        rw [map_smul, show ρ y v = v from hv.2 ⟨y, hy⟩]
    exact (hle g.property).2 v (Submodule.subset_span (Set.mem_singleton v))

private theorem odd_split (X : Subgroup G) [Finite X] (hodd : Odd (Nat.card X)) :
    IsCompl (subspaceCommutator ρ ⊤ X) (fixedSpace ρ X) := by
  have he : subspaceCommutator ρ ⊤ X =
      Representation.RegularCyclicNormalClosure.displacementSpan ρ X ⊤ := by
    unfold subspaceCommutator Representation.RegularCyclicNormalClosure.displacementSpan
    congr 1
    ext v
    simp only [eq_comm]
  rw [he]
  exact (Representation.GoldschmidtONan.isCompl_fixed_moved_of_odd hodd).symm

private theorem split_plane_card [FiniteDimensional (ZMod 2) V]
    (hρ : Function.Injective ρ) (X : Subgroup G)
    (hc : IsCompl (subspaceCommutator ρ ⊤ X) (fixedSpace ρ X))
    (hd : Module.finrank (ZMod 2) (subspaceCommutator ρ ⊤ X) = 2) : Nat.card X ∣ 6 := by
  let σ := (invariantSubspace ρ X (subspaceCommutator ρ ⊤ X)
      (subspaceCommutator_invariant ρ ⊤ X)).toRepresentation
  have hf : Function.Injective σ.asGroupHom := by
    apply (injective_iff_map_eq_one _).mpr
    intro x hx
    apply Subtype.ext
    apply hρ
    ext v
    obtain ⟨w, hw, c, hc', rfl⟩ := Submodule.mem_sup.mp
      (show v ∈ subspaceCommutator ρ ⊤ X ⊔ fixedSpace ρ X by
        rw [hc.sup_eq_top]; trivial)
    have hwfix : ρ (x : G) w = w := congrArg Subtype.val
      (LinearMap.congr_fun (congrArg Units.val hx) ⟨w, hw⟩)
    simp only [map_add, show ρ (x : G) c = c from hc' x, hwfix, Subgroup.coe_one, map_one, Module.End.one_apply]
  let b := Module.finBasisOfFinrankEq (ZMod 2) (subspaceCommutator ρ ⊤ X) hd
  let f := (Matrix.GeneralLinearGroup.toLin' b).symm.toMonoidHom.comp σ.asGroupHom
  have hf' : Function.Injective f := (Matrix.GeneralLinearGroup.toLin' b).symm.injective.comp hf
  have hdiv := Subgroup.card_dvd_of_injective f hf'
  have hGL : Nat.card (Matrix.GeneralLinearGroup (Fin 2) (ZMod 2)) = 6 := by
    rw [Matrix.card_GL_field]
    norm_num [Fin.prod_univ_succ]
  exact hGL ▸ hdiv

private theorem odd_plane_card_le_three [FiniteDimensional (ZMod 2) V]
    (hρ : Function.Injective ρ) (X : Subgroup G) [Finite X] (hodd : Odd (Nat.card X))
    (hd : Module.finrank (ZMod 2) (subspaceCommutator ρ ⊤ X) = 2) : Nat.card X ≤ 3 := by
  have hdvd := split_plane_card ρ hρ X (odd_split ρ X hodd) hd
  have hhi := Nat.le_of_dvd (by decide : 0 < 6) hdvd
  interval_cases hn : Nat.card X <;> norm_num [hn, Nat.odd_iff] at *

private theorem odd_subgroup (X : Subgroup G) [Finite G] (hX : X ≤ pPrimeCore 2 G) :
    Odd (Nat.card X) :=
  ((pPrimeCore_coprime_card (p := 2) (G := G)).of_dvd_right (card_dvd_of_le hX)).odd_of_left

private theorem odd_eq_of_support_eq [Finite G] [FiniteDimensional (ZMod 2) V]
    (hρ : Function.Injective ρ) {X Y : Subgroup G}
    (hX : X ≤ pPrimeCore 2 G) (hY : Y ≤ pPrimeCore 2 G)
    (hcX : Nat.card X = 3) (hcY : Nat.card Y = 3)
    (hd : Module.finrank (ZMod 2) (subspaceCommutator ρ ⊤ X) = 2)
    (he : subspaceCommutator ρ ⊤ X = subspaceCommutator ρ ⊤ Y) : X = Y := by
  have hj : Nat.card ↥(X ⊔ Y) ≤ 3 := by
    apply odd_plane_card_le_three ρ hρ _ (odd_subgroup _ (sup_le hX hY))
    rw [support_sup, he, sup_idem, ← he, hd]
  have hxe : X = X ⊔ Y := eq_of_le_of_card_ge le_sup_left (hcX ▸ hj)
  have hye : Y = X ⊔ Y := eq_of_le_of_card_ge le_sup_right (hcY ▸ hj)
  exact hxe.trans hye.symm

private theorem fixed_eq_of_split [FiniteDimensional (ZMod 2) V]
    {X Y : Subgroup G} (hle : Y ≤ X)
    (hX : IsCompl (subspaceCommutator ρ ⊤ X) (fixedSpace ρ X))
    (hY : IsCompl (subspaceCommutator ρ ⊤ Y) (fixedSpace ρ Y))
    (he : subspaceCommutator ρ ⊤ X = subspaceCommutator ρ ⊤ Y) :
    fixedSpace ρ X = fixedSpace ρ Y := by
  apply Submodule.eq_of_le_of_finrank_eq (fixedSpace_antitone ρ hle)
  have hx := (subspaceCommutator ρ ⊤ X).finrank_sup_add_finrank_inf_eq (fixedSpace ρ X)
  have hy := (subspaceCommutator ρ ⊤ Y).finrank_sup_add_finrank_inf_eq (fixedSpace ρ Y)
  rw [hX.sup_eq_top, hX.inf_eq_bot] at hx
  rw [hY.sup_eq_top, hY.inf_eq_bot] at hy
  rw [he] at hx
  simp only [finrank_bot, add_zero] at hx hy
  omega

private theorem split_eq_of_support_fixed_eq [Finite G] [FiniteDimensional (ZMod 2) V]
    (hρ : Function.Injective ρ) {X Y : Subgroup G}
    (hcX : Nat.card X = 6) (hcY : Nat.card Y = 6)
    (hX : IsCompl (subspaceCommutator ρ ⊤ X) (fixedSpace ρ X))
    (hd : Module.finrank (ZMod 2) (subspaceCommutator ρ ⊤ X) = 2)
    (he : subspaceCommutator ρ ⊤ X = subspaceCommutator ρ ⊤ Y)
    (hf : fixedSpace ρ X = fixedSpace ρ Y) : X = Y := by
  have hs : subspaceCommutator ρ ⊤ (X ⊔ Y) = subspaceCommutator ρ ⊤ X := by
    rw [support_sup, ← he, sup_idem]
  have hfs : fixedSpace ρ (X ⊔ Y) = fixedSpace ρ X := by
    rw [fixed_sup, ← hf, inf_idem]
  have hj := split_plane_card ρ hρ (X ⊔ Y) (by rwa [hs, hfs]) (by rwa [hs])
  have hjle := Nat.le_of_dvd (by decide : 0 < 6) hj
  exact (eq_of_le_of_card_ge le_sup_left (hcX ▸ hjle)).trans
    (eq_of_le_of_card_ge le_sup_right (hcY ▸ hjle)).symm

private theorem centralizes_of_cross_fixed (hρ : Function.Injective ρ) {X Y : Subgroup G}
    (hXY : subspaceCommutator ρ ⊤ X ≤ fixedSpace ρ Y)
    (hYX : subspaceCommutator ρ ⊤ Y ≤ fixedSpace ρ X) :
    Y ≤ centralizer (X : Set G) := by
  intro y hy x hx
  apply hρ
  ext v
  have h1 := hYX (Submodule.subset_span ⟨y, hy, v, Submodule.mem_top, rfl⟩) ⟨x, hx⟩
  have h2 := hXY (Submodule.subset_span ⟨x, hx, v, Submodule.mem_top, rfl⟩) ⟨y, hy⟩
  change ρ x (ρ y v - v) = ρ y v - v at h1
  change ρ y (ρ x v - v) = ρ x v - v at h2
  rw [map_sub] at h1 h2
  simp only [map_mul, Module.End.mul_apply]
  exact add_right_cancel ((sub_eq_sub_iff_add_eq_add.mp h1).trans
    ((add_comm _ _).trans (sub_eq_sub_iff_add_eq_add.mp h2).symm))


/-- The full factor and its odd commutator are a single conjugate pair and
its literal cubic intersection. All three source-step premises are discharged. -/
theorem factor_pair_identification [Finite G] [FiniteDimensional (ZMod 2) V]
    (hsolv : Group.IsSolvable G) (hρ : Function.Injective ρ)
    {A : Subgroup G} (hA : IsMinimalBestOffender ρ A) (hrank : rank A = 1)
    {x : G} (hx : x ∈ pPrimeCore 2 G) (hxc : x ∉ centralizer (A : Set G)) :
    ⁅pPrimeCore 2 G, A⁆ ⊔ A = conjugatePair A x ∧
      ⁅pPrimeCore 2 G, A⁆ = conjugatePair A x ⊓ pPrimeCore 2 G := by
  have hpairs : ∀ y ∈ pPrimeCore 2 G, y ∉ centralizer (A : Set G) →
      Nonempty (PairData ρ A y) := fun _ hy hyc => pairData_nonempty ρ hρ hA hrank hy hyc
  have hcard : ∀ y ∈ pPrimeCore 2 G, y ∉ centralizer (A : Set G) →
      Nat.card ↥(conjugatePair A y ⊓ pPrimeCore 2 G) = 3 := by
    intro y hy hyc
    obtain ⟨d⟩ := hpairs y hy hyc
    exact d.odd_card
  obtain ⟨d⟩ := hpairs x hx hxc
  have hs := factor_support_eq_pair ρ hρ hA hpairs
    (fun _ hy hyc => pair_odd_isSubnormal hsolv A (minimal_card ρ hA hrank) hcard hy hyc)
    (cubic_support_separation ρ hρ _ (pPrimeCore_coprime_card (p := 2) (G := G)).odd_of_left)
    hx hxc
  have hoddle := pair_odd_le_commutator A hx hxc d.odd_card
  have hm : subspaceCommutator ρ ⊤ ⁅pPrimeCore 2 G, A⁆ =
      subspaceCommutator ρ ⊤ (conjugatePair A x) := by
    apply le_antisymm ((moved_mono ρ le_sup_left).trans hs.le)
    rw [← d.odd_support]
    exact moved_mono ρ hoddle
  have hc : Nat.card ↥⁅pPrimeCore 2 G, A⁆ ≤ 3 :=
    odd_plane_card_le_three ρ hρ _ (odd_subgroup _ (commutator_le_left _ _))
      (hm ▸ d.moved_finrank ρ)
  have he : ⁅pPrimeCore 2 G, A⁆ = conjugatePair A x ⊓ pPrimeCore 2 G :=
    (eq_of_le_of_card_ge hoddle (d.odd_card ▸ hc)).symm
  refine ⟨le_antisymm ?_ (pair_le_factor A hx), he⟩
  rw [he]
  exact sup_le inf_le_left le_sup_left

/-- The cubic odd subgroup and its conjugate pair have the same fixed space. -/
theorem PairData.fixedSpace_odd [Finite G] [FiniteDimensional (ZMod 2) V]
    {A : Subgroup G} {x : G} (d : PairData ρ A x) :
    fixedSpace ρ (conjugatePair A x ⊓ pPrimeCore 2 G) =
      fixedSpace ρ (conjugatePair A x) := by
  exact (fixed_eq_of_split ρ inf_le_left d.complement
    (odd_split ρ _ (odd_subgroup _ inf_le_right)) d.odd_support.symm).symm

/-- Two recognized pairs attached to minimal offenders have equal factors,
or fix each other's supports and centralize one another. -/
theorem minimal_pair_alternative [Finite G] [FiniteDimensional (ZMod 2) V]
    (hsolv : Group.IsSolvable G) (hρ : Function.Injective ρ)
    {A B : Subgroup G} (hA : IsMinimalBestOffender ρ A) (hB : IsMinimalBestOffender ρ B)
    (hrankA : rank A = 1) (hrankB : rank B = 1)
    {x y : G} (hx : x ∈ pPrimeCore 2 G) (hxc : x ∉ centralizer (A : Set G))
    (hy : y ∈ pPrimeCore 2 G) (hyc : y ∉ centralizer (B : Set G))
    (dx : PairData ρ A x) (dy : PairData ρ B y) :
    conjugatePair B y = conjugatePair A x ∨
      conjugatePair B y ≤ centralizer (conjugatePair A x : Set G) ∧
        subspaceCommutator ρ ⊤ (conjugatePair A x) ≤ fixedSpace ρ (conjugatePair B y) := by
  have hsub {C : Subgroup G} (hC : IsMinimalBestOffender ρ C) (hrankC : rank C = 1)
      {z : G} (hz : z ∈ pPrimeCore 2 G) (hzc : z ∉ centralizer (C : Set G)) :
      ((conjugatePair C z ⊓ pPrimeCore 2 G).subgroupOf (pPrimeCore 2 G)).IsSubnormal := by
    apply pair_odd_isSubnormal hsolv C (minimal_card ρ hC hrankC) _ hz hzc
    intro t ht htc
    obtain ⟨d⟩ := pairData_nonempty ρ hρ hC hrankC ht htc
    exact d.odd_card
  have hdimX : Module.finrank (ZMod 2)
      (subspaceCommutator ρ ⊤ (conjugatePair A x ⊓ pPrimeCore 2 G)) = 2 := by
    rw [dx.odd_support]
    exact dx.moved_finrank ρ
  have hdimY : Module.finrank (ZMod 2)
      (subspaceCommutator ρ ⊤ (conjugatePair B y ⊓ pPrimeCore 2 G)) = 2 := by
    rw [dy.odd_support]
    exact dy.moved_finrank ρ
  have hsep := cubic_support_separation ρ hρ (pPrimeCore 2 G)
    (pPrimeCore_coprime_card (p := 2) (G := G)).odd_of_left
    _ _ inf_le_right inf_le_right (hsub hA hrankA hx hxc) (hsub hB hrankB hy hyc)
    dx.odd_card dy.odd_card hdimX hdimY
  rcases hsep with he | ⟨_, hxy, hyx⟩
  · have heQ := odd_eq_of_support_eq ρ hρ inf_le_right inf_le_right
      dx.odd_card dy.odd_card hdimX he
    have hf : fixedSpace ρ (conjugatePair A x) = fixedSpace ρ (conjugatePair B y) := by
      rw [← dx.fixedSpace_odd ρ, ← dy.fixedSpace_odd ρ, heQ]
    rw [dx.odd_support, dy.odd_support] at he
    left
    exact (split_eq_of_support_fixed_eq ρ hρ
      ((Nat.card_congr dx.model.toEquiv).trans PairRecognition.sl_card)
      ((Nat.card_congr dy.model.toEquiv).trans PairRecognition.sl_card)
      dx.complement (dx.moved_finrank ρ) he hf).symm
  · rw [dx.odd_support, dy.fixedSpace_odd ρ] at hxy
    rw [dy.odd_support, dx.fixedSpace_odd ρ] at hyx
    exact Or.inr ⟨centralizes_of_cross_fixed ρ hρ hxy hyx, hxy⟩

/-- The conditional local construction from rank-one minimal offenders.
The generated-by-minimal-offenders hypothesis is retained for the chapter's
assembly interface; the individual local factor needs only rank-one control. -/
theorem localBlock_nonempty [Finite G] [FiniteDimensional (ZMod 2) V]
    (hsolv : Group.IsSolvable G) (hcore : pCore 2 G = ⊥) (hρ : Function.Injective ρ)
    (hrank : ∀ A, IsMinimalBestOffender ρ A → rank A = 1)
    (_hgen : ∀ A, IsBestOffender ρ A → generatedBy {B | IsMinimalBestOffender ρ B} A = A)
    {A : Subgroup G} (hA : IsMinimalBestOffender ρ A) :
    Nonempty (CFSG.Quasithin.ChapterB.SolvableFFLocalBlock ρ A) := by
  obtain ⟨x, hx, hxc⟩ := exists_noncentral_odd ρ hsolv hcore hA
  obtain ⟨dx⟩ := pairData_nonempty ρ hρ hA (hrank A hA) hx hxc
  have he := (factor_pair_identification ρ hsolv hρ hA (hrank A hA) hx hxc).1
  refine ⟨{
    factor := conjugatePair A x
    factor_eq := he.symm
    factor_le := he ▸ factor_le_offender ρ hA.1
    factorModel := dx.model
    naturalEquiv := dx.naturalEquiv
    naturalEquiv_action := dx.naturalEquiv_action
    complement := dx.complement
    minimal_offenders := ?_ }⟩
  intro B hB
  obtain ⟨y, hy, hyc⟩ := exists_noncentral_odd ρ hsolv hcore hB
  obtain ⟨dy⟩ := pairData_nonempty ρ hρ hB (hrank B hB) hy hyc
  rcases minimal_pair_alternative ρ hsolv hρ hA hB (hrank A hA) (hrank B hB)
    hx hxc hy hyc dx dy with hsame | ⟨hc, hf⟩
  · exact Or.inl (hsame ▸ (le_sup_left : B ≤ conjugatePair B y))
  · exact Or.inr ⟨le_sup_left.trans hc, hf.trans (fixedSpace_antitone ρ le_sup_left)⟩

end CFSG.Quasithin.ChapterB.Glauberman.BlockConstruction
