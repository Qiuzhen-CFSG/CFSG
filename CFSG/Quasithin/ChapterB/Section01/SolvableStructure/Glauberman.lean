/-!
# The solvable binary FF-module theorem

The source is Aschbacher–Smith B.1.8(1)–(3), printed p. 70 (PDF p. 81).
It cites Glauberman, *Failure of factorization in p-solvable groups*,
Quart. J. Math. Oxford 24 (1973), 71–77, and Aschbacher, *Finite Group
Theory*, 32.3. The source requires a finite solvable group with trivial
two-core and a faithful finite-dimensional binary FF-module.

The imported construction gives the internal product of actual SL₂(2)
subgroups and the internal sum of their natural two-dimensional supports.
Strict replacement and the proved rank-one theorem give q = 1 and exclude
all strong offenders. The actual quotient equivalence SL₂(2) → PSL₂(2)
identifies each concrete factor model with the source model L₂(2).

The local proof route is also available in Kurzweil–Stellmacher, *The Theory
of Finite Groups*, 9.3.2–9.3.7, printed pp. 240–246 (PDF pp. 253–259 in
`refs/original/kurzweil.pdf`). First use coprime fixed-point generation and
the P × Q lemma to find an equal-weight hyperplane in each best offender.
This proves that minimal best offenders have rank one and that best offenders
are generated by them. Then construct the local factors [O₂′(G), A]A.
Distinct local blocks fix one another's supports. Their fixed-space
complements and faithfulness make both the groups and supports independent;
best-offender generation gives their joins. The assembly constructs every
field of `SolvableFFFactors` and discharges the additional premise of the
preserved numerical reduction. No factorization or local-block witness is
assumed in `source_lemma_B_1_8_1_3`.
-/

public section

namespace CFSG.Quasithin.ChapterB

open Representation.BinaryOffender

variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  {ρ : Representation (ZMod 2) G V}

/-- Each constructed matrix factor is the actual projective group `L₂(2)`.
This is a model conversion, not an existence assertion for the factors. -/
@[expose] noncomputable def SolvableFFFactors.factorProjectiveModel
    (F : SolvableFFFactors ρ) (i : Fin F.count) :
    F.factor i ≃* Matrix.ProjectiveSpecialLinearGroup (Fin 2) (ZMod 2) :=
  (F.factorModel i).trans Matrix.SpecialLinearGroup.sl2TwoEquivPSL2Two

/-- The factor identification uses the canonical central quotient map. -/
theorem SolvableFFFactors.factorProjectiveModel_apply
    (F : SolvableFFFactors ρ) (i : Fin F.count) (g : F.factor i) :
    F.factorProjectiveModel i g = QuotientGroup.mk (F.factorModel i g) := rfl

namespace Glauberman

/-- Conditional numerical assembly: faithfulness, FF and rank-one minimal
best offenders imply `q = 1` and exclude every strong offender. -/
theorem numerical_conclusions_of_minimal_rank_one [Finite G]
    [FiniteDimensional (ZMod 2) V]
    (hρ : Function.Injective ρ) (hff : IsFFModule ρ)
    (hrank : ∀ A, IsMinimalBestOffender ρ A → rank A = 1) :
    quadraticRatio ρ = 1 ∧ ∀ A, ¬ IsStrongOffender ρ A := by
  refine ⟨quadraticRatio_eq_one_of_minimalBestOffender_rank_one ρ hρ hff hrank,
    fun A hA => ?_⟩
  exact not_isStrongFFModule_of_minimalBestOffender_rank_one ρ hρ hrank ⟨A, hA⟩

/-- B.1.8(3): the source hypotheses imply q = 1 and exclude strong offenders. -/
theorem numerical_conclusions [Finite G] [FiniteDimensional (ZMod 2) V]
    (hsolv : Group.IsSolvable G) (hcore : pCore 2 G = ⊥)
    (hρ : Function.Injective ρ) (hff : IsFFModule ρ) :
    quadraticRatio ρ = 1 ∧ ∀ A, ¬ IsStrongOffender ρ A :=
  numerical_conclusions_of_minimal_rank_one hρ hff
    (fun _ hA => minimalBestOffender_rank_one ρ hρ hsolv hcore hA)

/-- B.1.8(1)–(3), with the original source hypotheses. The constructed factors
give literal internal group and support decompositions and equivariant natural
module identifications. `SolvableFFFactors.factorProjectiveModel` identifies
each factor with L₂(2) through the canonical central quotient. -/
theorem source_lemma_B_1_8_1_3 [Finite G] [FiniteDimensional (ZMod 2) V]
    (hsolv : Group.IsSolvable G) (hcore : pCore 2 G = ⊥)
    (hρ : Function.Injective ρ) (hff : IsFFModule ρ) :
    Nonempty (SolvableFFFactors ρ) ∧ quadraticRatio ρ = 1 ∧
      ∀ A, ¬ IsStrongOffender ρ A :=
  ⟨factors_nonempty ρ hsolv hcore hρ hff, numerical_conclusions hsolv hcore hρ hff⟩

end Glauberman
end CFSG.Quasithin.ChapterB
