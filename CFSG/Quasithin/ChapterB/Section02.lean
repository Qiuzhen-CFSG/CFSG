module

public import Theory.Representation.FixedSpaceCodimension
public import Mathlib.Algebra.Field.ZMod

/-!+# B.2: Basic Failure of Factorization

This module currently supplies Lemma B.2.17, the dimension argument used twice
in Baumann's Argument. The fixed space of a generated subgroup is the
intersection of the generating fixed spaces. Its quotient embeds diagonally
in the product of their quotients, forcing equality in all dimension bounds.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
1 March 2004 manuscript, B.2.17, printed pp. 79–80.
-/

namespace CFSG.Quasithin.ChapterB

variable {G V ι : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V] [Fintype ι]

/-- B.2.17: Thompson's fixed-space dimension argument. Here `⨆ i, X i`
is the subgroup `I` generated by the finite family of subgroups `X i`. -/
public theorem lemma_B_2_17 (ρ : Representation (ZMod 2) G V)
    (X : ι → Subgroup G) (L : Subgroup G) (hL : L ≤ ⨆ i, X i)
    (hdim : (∑ i, Module.finrank (ZMod 2)
      (V ⧸ Representation.invariants (ρ.comp (X i).subtype))) ≤
      Module.finrank (ZMod 2) (V ⧸ Representation.invariants (ρ.comp L.subtype))) :
    Representation.invariants (ρ.comp L.subtype) =
        Representation.invariants (ρ.comp (⨆ i, X i).subtype) ∧
      Module.finrank (ZMod 2) (V ⧸ Representation.invariants (ρ.comp L.subtype)) =
        ∑ i, Module.finrank (ZMod 2)
          (V ⧸ Representation.invariants (ρ.comp (X i).subtype)) :=
  ρ.invariants_eq_and_codimension_eq_of_sum_le X L hL hdim

end CFSG.Quasithin.ChapterB
