module
public import CFSG.Quasithin.ChapterB.InternalThompsonAction
public import Theory.GroupTheory.ElementaryThompsonPrimeRank

/-!
# FF from Thompson generation at equal two-rank

Suppose P <= S have equal two-rank and B is generated by its commutators
with J(P). If B moves a normal elementary subgroup U <= S, the actual
centralizer quotient acting on U is FF. Otherwise all maximum elementary
subgroups of S centralize U, so J(P), and then B, centralize U as well.

Source: Aschbacher--Smith, B.2.4--7 and 12.6.15, combined manuscript of
1 March 2004, printed pp.75--77 and 826.
-/

public section
open Subgroup Representation Representation.BinaryOffender Stellmacher
open scoped IsMulCommutative

namespace CFSG.Quasithin.ChapterB
variable {A : Type*} [Group A] [Finite A]

theorem ff_of_thompson_generated_movement_of_primeRank_eq (U B P S : Subgroup A)
    [U.Normal] [IsElementaryAbelian 2 U]
    (hUS : U ≤ S) (hPS : P ≤ S) (hr : primeRank 2 P = primeRank 2 S)
    (hgen : B = ⁅B,elementaryAbelianMaxJ P⁆) (hm : ⁅U,B⁆ ≠ ⊥) :
    IsFFModule (InternalThompsonAction.action U) := by
  let q := InternalThompsonAction.actionMk U
  let ρ := InternalThompsonAction.action U
  by_contra hff
  have hJker : elementaryAbelianMaxJ S ≤ q.ker := by
    apply sSup_le
    intro E hE
    apply (map_eq_bot_iff E).mp
    by_contra he
    exact hff ((isFFModule_iff_exists_bestOffender ρ).mpr ⟨_,
      NormalElementaryQuotient.maxElementary_isBestOffender U q
        (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _) S E hUS hE he⟩)
  have hBker : B ≤ q.ker := by
    rw [hgen]
    exact (commutator_mono le_rfl
      ((elementaryAbelianMaxJ_le_of_primeRank_eq P S hPS hr).trans hJker)).trans
        (commutator_le_right _ _)
  apply hm
  rw [commutator_comm]
  apply commutator_eq_bot_iff_le_centralizer.mpr
  simpa only [q,InternalThompsonAction.actionMk,QuotientGroup.ker_mk'] using hBker
end CFSG.Quasithin.ChapterB
