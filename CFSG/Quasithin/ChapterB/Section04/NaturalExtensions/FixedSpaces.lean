module

public import Theory.Representation.SLThreeCentralExtension.Involutions
public import Theory.Representation.SLThreeCentralExtension.Sylow
public import Theory.Representation.BinaryOffender.SubspaceAction

/-!
# Natural binary SL₃ extensions: cohomology and fixed spaces

This module proves B.4.8(1), the involution clauses of B.4.8(2)–(3), and
the Sylow fixed-space clause of (2). Every conclusion concerns the original
representation, with its actual equivariant natural quotient or submodule.
The quotient case is commutator generated by indecomposability; in the
submodule case, a nonzero fixed space would split off. Three conjugate
involutions and duality then give the rank-two displacement calculation.
The orbit theorem gives the Sylow fixed-line assertion.

The central-quotient dimension bound below is a separate useful case. The
general unique-noncentral-chief-factor bound B.4.8(4), the offender
classification and ratios in (2)–(3), and B.4.9 still require proofs.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
B.4.8–9, printed pp.91–95.
-/

public section
open Representation Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterB.NaturalExtensions
open BinaryLinearThree
open Representation.OneCohomology
variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V] (ρ : Representation (ZMod 2) BinaryLinearThree.Group V)

private theorem moved_eq_fixed_of_range_eq (a : BinaryLinearThree.Group) (ha : orderOf a = 2)
    (he : LinearMap.range (ρ a - LinearMap.id) = fixedSpace ρ (Subgroup.zpowers a)) :
    subspaceCommutator ρ ⊤ (Subgroup.zpowers a) = fixedSpace ρ (Subgroup.zpowers a) := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨g,hg,v,_,rfl⟩ b
    exact (involution_actor_rank_and_fixedCodim ρ a ha).2.2.1 b b.property g hg v
  · rw [← he]
    rintro _ ⟨v,rfl⟩
    exact Submodule.subset_span ⟨a,Subgroup.mem_zpowers a,v,Submodule.mem_top,rfl⟩

/-- B.4.8(1): the previously computed natural first cohomology has two elements. -/
theorem natural_H1_card : Nat.card (H1 W) = 2 := by
  rw [Module.natCard_eq_pow_finrank (K := ZMod 2), Nat.card_zmod,
    SLHigherNatural.finrank_H1_sl3_two]
  rfl

/-- A central indecomposable natural quotient has dimension three or four.
This does not assert B.4.8(4), which also allows central factors above the natural factor. -/
theorem central_quotient_dimension
    (p : ρ.IntertwiningMap W) (hp : Function.Surjective p)
    (hfixed : p.toLinearMap.ker ≤ OneCohomology.fixed ρ)
    (hind : ∀ A B : Submodule (ZMod 2) V,
      (∀ g v, v ∈ A → ρ g v ∈ A) →
      (∀ g v, v ∈ B → ρ g v ∈ B) → IsCompl A B → A = ⊥ ∨ B = ⊥) :
    Module.finrank (ZMod 2) V = 3 ∨ Module.finrank (ZMod 2) V = 4 := by
  have hk := SLThreeCentralExtension.finrank_kernel_le_one p hp hfixed hind
  have hd := p.toLinearMap.finrank_range_add_finrank_ker
  rw [LinearMap.range_eq_top.mpr hp, finrank_top, Module.finrank_fin_fun] at hd
  omega

/-- The involution clauses of B.4.8(2), on the original central extension. -/
theorem central_quotient_involutions
    (p : ρ.IntertwiningMap W) (hp : Function.Surjective p)
    (hfixed : p.toLinearMap.ker ≤ OneCohomology.fixed ρ)
    (hind : ∀ A B : Submodule (ZMod 2) V,
      (∀ g v, v ∈ A → ρ g v ∈ A) →
      (∀ g v, v ∈ B → ρ g v ∈ B) → IsCompl A B → A = ⊥ ∨ B = ⊥)
    (hdim : Module.finrank (ZMod 2) V = 4)
    (a : BinaryLinearThree.Group) (ha : orderOf a = 2) :
    subspaceCommutator ρ ⊤ (Subgroup.zpowers a) = fixedSpace ρ (Subgroup.zpowers a) ∧
      Module.finrank (ZMod 2) (fixedSpace ρ (Subgroup.zpowers a)) = 2 := by
  have hm := (isCover_of_indecomposable p hp hfixed
    SLThreeCentralExtension.commutator_eq_top hind).2.2
  have hc := NaturalExtension.involution_codim_of_commutator_top ρ hdim hm a ha
  obtain ⟨he,hr⟩ := NaturalExtension.involution_range_eq_fixed ρ hdim a ha hc
  exact ⟨moved_eq_fixed_of_range_eq ρ a ha he,hr⟩

/-- The involution clauses of B.4.8(3), including containment in the literal natural submodule. -/
theorem natural_submodule_involutions
    (N : Subrepresentation ρ) (e : Representation.Equiv N.toRepresentation W)
    (hm : Coinvariants.ker ρ ≤ N.toSubmodule)
    (hind : ∀ A B : Submodule (ZMod 2) V,
      (∀ g v, v ∈ A → ρ g v ∈ A) →
      (∀ g v, v ∈ B → ρ g v ∈ B) → IsCompl A B → A = ⊥ ∨ B = ⊥)
    (hdim : Module.finrank (ZMod 2) V = 4)
    (a : BinaryLinearThree.Group) (ha : orderOf a = 2) :
    subspaceCommutator ρ ⊤ (Subgroup.zpowers a) = fixedSpace ρ (Subgroup.zpowers a) ∧
      Module.finrank (ZMod 2) (fixedSpace ρ (Subgroup.zpowers a)) = 2 ∧
      fixedSpace ρ (Subgroup.zpowers a) ≤ N.toSubmodule := by
  have hz := NaturalExtension.invariants_eq_bot_of_natural_submodule ρ hdim N e hind
  have hc := NaturalExtension.involution_codim_of_fixed_zero ρ hdim hz a ha
  obtain ⟨he,hr⟩ := NaturalExtension.involution_range_eq_fixed ρ hdim a ha hc
  refine ⟨moved_eq_fixed_of_range_eq ρ a ha he,hr,?_⟩
  rw [← he]
  rintro _ ⟨v,rfl⟩
  exact hm (Coinvariants.sub_mem_ker a v)
/-- The Sylow fixed-space clause of B.4.8(2), with the fixed kernel constructed
from the actual natural quotient and the four-dimensional hypothesis. -/
theorem central_quotient_sylow
    (p : ρ.IntertwiningMap W) (hp : Function.Surjective p)
    (hfixed : p.toLinearMap.ker ≤ OneCohomology.fixed ρ)
    (hind : ∀ A B : Submodule (ZMod 2) V,
      (∀ g v, v ∈ A → ρ g v ∈ A) →
      (∀ g v, v ∈ B → ρ g v ∈ B) → IsCompl A B → A = ⊥ ∨ B = ⊥)
    (hdim : Module.finrank (ZMod 2) V = 4)
    (T : Sylow 2 BinaryLinearThree.Group) :
    fixedSpace ρ (T : Subgroup BinaryLinearThree.Group) = ρ.invariants := by
  have hkdim : Module.finrank (ZMod 2) p.toLinearMap.ker = 1 := by
    have hd := p.toLinearMap.finrank_range_add_finrank_ker
    rw [LinearMap.range_eq_top.mpr hp, finrank_top, Module.finrank_fin_fun, hdim] at hd
    omega
  have hkcard : Nat.card p.toLinearMap.ker = 2 := by
    rw [Module.natCard_eq_pow_finrank (K := ZMod 2), Nat.card_zmod, hkdim]
    rfl
  obtain ⟨z,hz,hu⟩ := (Nat.card_eq_two_iff' (0 : p.toLinearMap.ker)).mp hkcard
  have hz' : (z : V) ≠ 0 := fun he => hz (Subtype.ext he)
  have hker (x : V) : p x = 0 ↔ x = 0 ∨ x = z := by
    constructor
    · intro hx
      by_cases hx0 : x = 0
      · exact Or.inl hx0
      · exact Or.inr (congrArg Subtype.val (hu ⟨x,hx⟩
          (fun he => hx0 (congrArg Subtype.val he))))
    · rintro (rfl | rfl)
      · exact map_zero _
      · exact z.property
  have hT := SLThreeCentralExtension.sylow_fixed_eq_kernel ρ p z hz' hker
    (fun g => hfixed z.property g) hdim hind T
  apply le_antisymm
  · rw [hT]
    exact hfixed
  · intro v hv t
    exact hv t
/-- The fixed plane upstairs is exactly the preimage of the transvection center
downstairs. This identifies the actual planes needed for the offender calculation. -/
theorem central_quotient_involution_fixed_preimage
    (p : ρ.IntertwiningMap W) (hp : Function.Surjective p)
    (hfixed : p.toLinearMap.ker ≤ OneCohomology.fixed ρ)
    (hind : ∀ A B : Submodule (ZMod 2) V,
      (∀ g v, v ∈ A → ρ g v ∈ A) →
      (∀ g v, v ∈ B → ρ g v ∈ B) → IsCompl A B → A = ⊥ ∨ B = ⊥)
    (hdim : Module.finrank (ZMod 2) V = 4)
    (a : BinaryLinearThree.Group) (ha : orderOf a = 2) :
    fixedSpace ρ (Subgroup.zpowers a) =
      (LinearMap.range (W a - LinearMap.id)).comap p.toLinearMap := by
  have hm := (isCover_of_indecomposable p hp hfixed
    SLThreeCentralExtension.commutator_eq_top hind).2.2
  have hc := NaturalExtension.involution_codim_of_commutator_top ρ hdim hm a ha
  have hr := (NaturalExtension.involution_range_eq_fixed ρ hdim a ha hc).1
  ext v
  constructor
  · intro hv
    rw [← hr] at hv
    obtain ⟨w,hw⟩ := hv
    refine ⟨p w, ?_⟩
    change W a (p w) - p w = p v
    have h := congrArg p hw
    change p (ρ a w - w) = p v at h
    simpa only [map_sub, p.isIntertwining] using h
  · rintro ⟨w,hw⟩
    obtain ⟨x,hx⟩ := hp w
    have hk : v - (ρ a x - x) ∈ p.toLinearMap.ker := by
      change p (v - (ρ a x - x)) = 0
      rw [map_sub, map_sub, p.isIntertwining, hx]
      change p v - (W a w - w) = 0
      exact sub_eq_zero.mpr hw.symm
    have h1 : v - (ρ a x - x) ∈ fixedSpace ρ (Subgroup.zpowers a) :=
      fun g => hfixed hk g
    have h2 : ρ a x - x ∈ fixedSpace ρ (Subgroup.zpowers a) := hr ▸ ⟨x,rfl⟩
    simpa using (fixedSpace ρ (Subgroup.zpowers a)).add_mem h1 h2
end CFSG.Quasithin.ChapterB.NaturalExtensions
