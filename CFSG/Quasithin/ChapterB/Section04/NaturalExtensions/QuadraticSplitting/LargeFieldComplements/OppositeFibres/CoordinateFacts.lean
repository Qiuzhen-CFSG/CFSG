module
public import CFSG.Quasithin.ChapterB.Section04.NaturalExtensions.QuadraticSplitting.LargeFieldComplements.OppositeFibres.Commutators
public import CFSG.Quasithin.ChapterB.Section04.NaturalExtensions.QuadraticSplitting.AxisGeometry

/-!
# Opposite fixed lines and coordinate commutators in B.4.9(1)

The opposite marking identifies a vector of the original natural submodule
with a covector in quotient coordinates by applying the transpose of the
inverse recorded basis change. Fixation by the quotient axis roots forces
this covector onto the coordinate line, which the literal Levi fixes.
Thus K centralizes the original C_U(Q), with no identification of the two
natural markings.

Every axis root is an actual commutator of a Levi root and another axis
root. Additivity of the shear parameters then proves [K,Q] = Q in G.
Both calculations work over every binary field, including F₄, without
quadraticity or fixed lifting. The final three applications discharge the
two matrix premises of the opposite-fibre construction; upstairs
quadraticity and fixed lifts remain explicit source inputs.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
B.4.9(1), printed p.93 (PDF p.104). The root commutator formula is reused
from the attributed ATLAS port
`Theory.AtlasPort.ExceptionalIsomorphisms.Elementary`.
-/

@[expose] public section

open Representation Representation.BinaryOffender Matrix
open scoped commutatorElement
namespace CFSG.Quasithin.ChapterB.NaturalExtensions.QuadraticSplitting
open QuasisimpleSource CFSG.Quasithin.ChapterK.Linear.Natural
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  {F : BinaryField} {ρ : Representation (ZMod 2) G V}

section MatrixFacts
variable {n : ℕ} {d : DoubleNatural F n ρ} (m : QuotientCoordinates d) (j : Fin n)

private lemma root_apply {i k : Fin n} (hik : i ≠ k) (a : F.Carrier)
    (v : Fin n → F.Carrier) :
    linearNatural F n (SpecialLinearGroup.transvection hik a) v =
      v + Pi.single i (a * v k) := by
  change (Matrix.transvection i k a).mulVec v = _
  ext r
  simp [Matrix.transvection, Matrix.add_mulVec, Matrix.single_mulVec_eq, Pi.single_apply]

private lemma root_mem_K {i k : Fin n} (hik : i ≠ k) (hij : i ≠ j)
    (hkj : k ≠ j) (a : F.Carrier) :
    m.action.groupEquiv.symm (SpecialLinearGroup.transvection hik a) ∈ m.K j := by
  apply m.mem_K_of_coordinateFixer j
  · intro v
    rw [MulEquiv.apply_symm_apply, root_apply]
    simp [Pi.single_eq_of_ne hij.symm]
  · rw [MulEquiv.apply_symm_apply, root_apply]
    simp [Pi.single_eq_of_ne hkj]

private lemma root_mem_Q {i : Fin n} (hij : i ≠ j) (a : F.Carrier) :
    m.action.groupEquiv.symm (SpecialLinearGroup.transvection hij a) ∈ m.Q j := by
  rw [m.largeField_mem_Q, MulEquiv.apply_symm_apply]
  exact transvection_mem_hyperplaneCentralizer F n j i hij a

private lemma root_mem_commutator (hn : 3 ≤ n) {i : Fin n} (hij : i ≠ j)
    (a : F.Carrier) :
    m.action.groupEquiv.symm (SpecialLinearGroup.transvection hij a) ∈ ⁅m.K j, m.Q j⁆ := by
  obtain ⟨k,hki,hkj⟩ := Fin.exists_ne_and_ne_of_two_lt i j (by omega)
  have h := Subgroup.commutator_mem_commutator
    (root_mem_K m j hki.symm hij hkj a) (root_mem_Q m j hkj 1)
  rw [← map_commutatorElement, Atlas.elementary_commutator hij hki.symm hkj, mul_one] at h
  exact h

private lemma shear_single {i : Fin n} (hij : i ≠ j) (a : F.Carrier) :
    shear F n j ⟨Pi.single i a, by simp [mem_coordinateHyperplane, hij.symm]⟩ =
      SpecialLinearGroup.transvection hij a := by
  apply natural_injective F n
  apply LinearMap.ext
  intro v
  rw [shear_apply, root_apply]
  congr 1
  ext k
  by_cases hk : k = i
  · subst k; simp [mul_comm]
  · simp [hk]

/-- The full quotient axis group is generated by its commutators with the
literal Levi. No orientation or field-degree restriction is required. -/
theorem QuotientCoordinates.axis_commutator_eq (hn : 3 ≤ n) : ⁅m.K j, m.Q j⁆ = m.Q j := by
  apply le_antisymm
  · apply Subgroup.commutator_le.mpr
    intro k hk q hq
    exact (m.Q j).mul_mem (m.largeField_K_normalizes_Q j k hk q hq) ((m.Q j).inv_mem hq)
  · intro q hq
    obtain ⟨w,hw⟩ := centralizer_eq_shear F n j ((m.largeField_mem_Q j q).mp hq)
    have hsum (s : Finset (Fin n)) (f : Fin n → coordinateHyperplane F n j)
        (hf : ∀ i ∈ s, m.action.groupEquiv.symm (shear F n j (f i)) ∈ ⁅m.K j,m.Q j⁆) :
        m.action.groupEquiv.symm (shear F n j (∑ i ∈ s, f i)) ∈ ⁅m.K j,m.Q j⁆ := by
      induction s using Finset.induction_on with
      | empty => simp [shear_zero]
      | @insert i s hi ih =>
        rw [Finset.sum_insert hi, shear_add, map_mul]
        exact (⁅m.K j,m.Q j⁆).mul_mem (hf i (Finset.mem_insert_self _ _))
          (ih (fun k hk => hf k (Finset.mem_insert_of_mem hk)))
    let f : Fin n → coordinateHyperplane F n j := fun i =>
      ⟨Pi.single i (w.val i), by
        by_cases hi : i = j
        · subst i
          change (Pi.single j (w.val j) : Fin n → F.Carrier) j = 0
          rw [Pi.single_eq_same]
          exact w.property
        · simp only [mem_coordinateHyperplane, Pi.single_eq_of_ne (Ne.symm hi)]⟩
    have he : (∑ i, f i) = w := by
      apply Subtype.ext
      ext k
      simp [f]
    have h := hsum Finset.univ f (by
      intro i _
      by_cases hi : i = j
      · subst i
        have hf0 : f j = 0 := by
          apply Subtype.ext
          simp [f, show w.val j = 0 from w.property]
        rw [hf0, shear_zero, map_one]
        exact (⁅m.K j,m.Q j⁆).one_mem
      · change m.action.groupEquiv.symm (shear F n j ⟨Pi.single i (w.val i), _⟩) ∈ _
        rw [shear_single j hi]
        exact root_mem_commutator m j hn hi _)
    rw [he, hw, MulEquiv.symm_apply_apply] at h
    exact h

private lemma sl_transpose_mul (A B : SpecialLinearGroup (Fin n) F.Carrier) :
    SpecialLinearGroup.transpose (A * B) =
      SpecialLinearGroup.transpose B * SpecialLinearGroup.transpose A := by
  apply Subtype.ext
  exact Matrix.transpose_mul _ _

private lemma sl_transpose_transpose (A : SpecialLinearGroup (Fin n) F.Carrier) :
    SpecialLinearGroup.transpose (SpecialLinearGroup.transpose A) = A := by
  apply Subtype.ext
  exact Matrix.transpose_transpose _

private lemma original_fixed_iff_transposed
    (hop : ∀ g, m.action.groupEquiv g = m.basisChange *
      SpecialLinearGroup.transpose ((d.natural.groupEquiv g)⁻¹) * m.basisChange⁻¹)
    (u : d.space) (g : G) :
    ρ g (u : V) = u ↔
      linearNatural F n (SpecialLinearGroup.transpose (m.action.groupEquiv g))
        (linearNatural F n (SpecialLinearGroup.transpose m.basisChange⁻¹)
          (d.natural.linearEquiv u)) =
        linearNatural F n (SpecialLinearGroup.transpose m.basisChange⁻¹)
          (d.natural.linearEquiv u) := by
  have hrel : SpecialLinearGroup.transpose (m.action.groupEquiv g) *
      SpecialLinearGroup.transpose m.basisChange⁻¹ =
      SpecialLinearGroup.transpose m.basisChange⁻¹ * (d.natural.groupEquiv g)⁻¹ := by
    rw [← sl_transpose_mul]
    have he : m.basisChange⁻¹ * m.action.groupEquiv g =
        SpecialLinearGroup.transpose ((d.natural.groupEquiv g)⁻¹) * m.basisChange⁻¹ := by
      rw [hop]
      group
    rw [he, sl_transpose_mul, sl_transpose_transpose]
  have hn : linearNatural F n (d.natural.groupEquiv g) (d.natural.linearEquiv u) =
      d.natural.linearEquiv u ↔ ρ g (u : V) = u := by
    rw [← d.natural.intertwines]
    constructor
    · intro h
      exact congrArg Subtype.val (d.natural.linearEquiv.injective h)
    · intro h
      exact congrArg d.natural.linearEquiv (Subtype.ext h)
  rw [← Module.End.mul_apply, ← map_mul, hrel, map_mul, Module.End.mul_apply,
    ((linearNatural F n).apply_bijective _).1.eq_iff, inv_apply_eq_iff]
  exact hn.symm.trans eq_comm

private lemma transpose_root {i k : Fin n} (hik : i ≠ k) (a : F.Carrier) :
    SpecialLinearGroup.transpose (SpecialLinearGroup.transvection hik a) =
      SpecialLinearGroup.transvection hik.symm a := by
  apply Subtype.ext
  simp [SpecialLinearGroup.coe_transpose, SpecialLinearGroup.transvection_coe,
    Matrix.transpose_add, Matrix.transpose_single]

/-- In the opposite orientation, the literal Levi fixes the Q-fixed vectors
in the original natural submodule, after the recorded change of basis. -/
theorem QuotientCoordinates.opposite_original_fixedSpace_le_K
    (hop : ∀ g, m.action.groupEquiv g = m.basisChange *
      SpecialLinearGroup.transpose ((d.natural.groupEquiv g)⁻¹) * m.basisChange⁻¹) :
    d.space.toSubmodule ⊓ fixedSpace ρ (m.Q j) ≤ fixedSpace ρ (m.K j) := by
  intro v hv k
  let u : d.space := ⟨v,hv.1⟩
  let z := linearNatural F n (SpecialLinearGroup.transpose m.basisChange⁻¹)
    (d.natural.linearEquiv u)
  have hz (i : Fin n) (hij : i ≠ j) : z i = 0 := by
    let q := m.action.groupEquiv.symm (SpecialLinearGroup.transvection hij (1 : F.Carrier))
    have hq : q ∈ m.Q j := root_mem_Q m j hij 1
    have h := (original_fixed_iff_transposed m hop u q).mp (hv.2 ⟨q,hq⟩)
    change linearNatural F n (SpecialLinearGroup.transpose (m.action.groupEquiv q)) z = z at h
    dsimp only [q] at h
    rw [MulEquiv.apply_symm_apply, transpose_root, root_apply] at h
    have hj := congrFun h j
    simp only [Pi.add_apply, Pi.single_eq_same, one_mul] at hj
    exact add_left_cancel (hj.trans (add_zero _).symm)
  have hze : z = z j • (Pi.single j 1 : Fin n → F.Carrier) := by
    ext i
    by_cases hi : i = j
    · subst i; simp
    · simp [hi, hz i hi]
  apply (original_fixed_iff_transposed m hop u k).mpr
  change linearNatural F n (SpecialLinearGroup.transpose (m.action.groupEquiv k)) z = z
  have he : linearNatural F n (SpecialLinearGroup.transpose (m.action.groupEquiv k))
      (Pi.single j 1) = Pi.single j 1 := by
    have hk := m.K_le_coordinateFixer j k.property
    ext i
    have h := hk (Pi.single i 1)
    change ((m.action.groupEquiv k).val).mulVec (Pi.single i 1) j = _ at h
    change ((m.action.groupEquiv k).val.transpose).mulVec (Pi.single j 1) i = _
    simpa only [Matrix.mulVec_single_one, Matrix.col_apply, Matrix.transpose_apply,
      Pi.single_apply, eq_comm] using h
  rw [hze]
  change specialLinearNatural n _ (z j • Pi.single j 1) = _
  rw [map_smul]
  change z j • linearNatural F n _ (Pi.single j 1) = _
  rw [he]

end MatrixFacts

variable {d : DoubleNatural F 3 ρ} (m : QuotientCoordinates d) (j : Fin 3)

/-- The opposite marking discharges both matrix premises of the canonical
fibre inclusion. Only upstairs quadraticity and the indicated fixed vector
are assumed. -/
theorem opposite_marked_coordinate_fixedSpace_le_fibre
    (hop : ∀ g, m.action.groupEquiv g = m.basisChange *
      SpecialLinearGroup.transpose ((d.natural.groupEquiv g)⁻¹) * m.basisChange⁻¹)
    (hq : IsQuadratic ρ (m.Q j))
    (v : V) (hfixed : v ∈ fixedSpace ρ (m.K j))
    (hv : d.space.toSubmodule.mkQ v = m.lineVector j) :
    fixedSpace ρ (m.K j) ≤
      displacementFibre ρ (m.K j) (m.Q j) (displacementSpace ρ (m.Q j) hq v) := by
  exact opposite_coordinate_fixedSpace_le_fibre m j hq
    (m.opposite_original_fixedSpace_le_K j hop)
    (m.axis_commutator_eq j (by decide)) v hfixed hv

/-- Actual fixed lifts cover the quotient line through the canonical fibre,
with the opposite fixed-line and commutator calculations discharged. -/
theorem opposite_marked_coordinate_fibre_covers
    (hop : ∀ g, m.action.groupEquiv g = m.basisChange *
      SpecialLinearGroup.transpose ((d.natural.groupEquiv g)⁻¹) * m.basisChange⁻¹)
    (hq : IsQuadratic ρ (m.Q j)) (hf : m.FixedLifts j)
    (v : V) (hfixed : v ∈ fixedSpace ρ (m.K j))
    (hv : d.space.toSubmodule.mkQ v = m.lineVector j) :
    m.line j ≤ (displacementFibre ρ (m.K j) (m.Q j)
      (displacementSpace ρ (m.Q j) hq v)).map d.space.toSubmodule.mkQ := by
  exact opposite_coordinate_fibre_covers m j hq hf
    (m.opposite_original_fixedSpace_le_K j hop)
    (m.axis_commutator_eq j (by decide)) v hfixed hv

/-- The original natural submodule has a KQ-invariant complement in the
opposite orientation, given the source's quadraticity and fixed lifts.
The final torus and source assembly remain with the enclosing branch. -/
theorem opposite_marked_coordinate_complement
    (hop : ∀ g, m.action.groupEquiv g = m.basisChange *
      SpecialLinearGroup.transpose ((d.natural.groupEquiv g)⁻¹) * m.basisChange⁻¹)
    (hq : IsQuadratic ρ (m.Q j)) (hf : m.FixedLifts j) :
    ∃ C : Submodule (ZMod 2) V, IsCompl d.space.toSubmodule C ∧
      m.K j ⊔ m.Q j ≤ subspaceStabilizer ρ C := by
  exact opposite_coordinate_complement m j hq hf
    (m.opposite_original_fixedSpace_le_K j hop)
    (m.axis_commutator_eq j (by decide))

end CFSG.Quasithin.ChapterB.NaturalExtensions.QuadraticSplitting
