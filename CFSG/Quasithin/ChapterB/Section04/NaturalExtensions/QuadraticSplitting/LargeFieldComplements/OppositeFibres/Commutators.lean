module
public import CFSG.Quasithin.ChapterB.Section04.NaturalExtensions.QuadraticSplitting.LargeFieldComplements.Fibre
public import CFSG.Quasithin.ChapterB.Section04.NaturalExtensions.QuadraticSplitting.LargeFieldComplements.Geometry
public import CFSG.Quasithin.ChapterB.Section04.NaturalExtensions.QuadraticSplitting.LargeFieldComplements.FixedDecomposition
public import Theory.Representation.BinaryOffender.MovedSpaceTransport
public import Theory.Representation.BinaryOffender.FixedQuotientKernel
/-!
# Opposite fibres from conjugation commutators

Quadraticity turns the displacement map into a homomorphism. Pulling a
subspace back through that homomorphism shows that Q = [K,Q] forces every
displacement of a K-fixed vector into its K-commutator space. Combined with
the actual fixed-space decomposition, this proves the opposite fibre claim
from two precise matrix facts: K fixes C_U(Q), and Q = [K,Q].

The same canonical commutator description makes W invariant under every
common normalizer of K and Q. No defining-field scalars on V are used.
Source: Aschbacher–Smith B.4.9(1), printed p.93 (1 March 2004 manuscript).
The matrix facts remain explicit until the opposite-coordinate assembly.
-/

@[expose] public section
open Representation Representation.BinaryOffender
open scoped commutatorElement
namespace CFSG.Quasithin.ChapterB.NaturalExtensions.QuadraticSplitting
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  (ρ : Representation (ZMod 2) G V) (K Q : Subgroup G)
  (hq : IsQuadratic ρ Q)

/-- Pullback of the displacement homomorphism converts group generation
into generation of its entire image by action commutators. -/
theorem opposite_displacement_le_of_commutators (v : V) (hv : v ∈ fixedSpace ρ K)
    (hn : ∀ k ∈ K, ∀ x ∈ Q, k * x * k⁻¹ ∈ Q)
    (hgen : ⁅K,Q⁆ = Q) (D : Submodule (ZMod 2) V)
    (hD : subspaceCommutator ρ (displacementSpace ρ Q hq v) K ≤ D) :
    displacementSpace ρ Q hq v ≤ D := by
  let δ := displacementHom ρ Q hq v
  let J : Subgroup Q := Subgroup.toAddSubgroup.symm (D.toAddSubgroup.comap δ)
  let B : Subgroup G := J.map Q.subtype
  have hc : ⁅K,Q⁆ ≤ B := by
    apply Subgroup.commutator_le.mpr
    intro k hk q hq'
    let qQ : Q := ⟨q,hq'⟩
    let c : Q := ⟨k*q*k⁻¹, hn k hk q hq'⟩
    refine ⟨c*qQ⁻¹, ?_, rfl⟩
    change δ (Additive.ofMul (c*qQ⁻¹)) ∈ D
    rw [ofMul_mul, ofMul_inv, map_add, map_neg]
    simp only [← sub_eq_add_neg]
    change (ρ (k*q*k⁻¹) v-v) - (ρ q v-v) ∈ D
    have he : ρ (k*q*k⁻¹) v-v = ρ k (ρ q v-v) := by
      have hi : ρ k⁻¹ v = v := hv ⟨k⁻¹,K.inv_mem hk⟩
      have hkf : ρ k v = v := hv ⟨k,hk⟩
      simp only [map_mul, Module.End.mul_apply, hi, map_sub, hkf]
    rw [he]
    apply hD
    exact Submodule.subset_span ⟨k,hk,ρ q v-v,
      (mem_displacementSpace ρ Q hq v _).mpr ⟨qQ,rfl⟩,rfl⟩
  have hQB : Q ≤ B := hgen ▸ hc
  intro w hw
  obtain ⟨q,rfl⟩ := (mem_displacementSpace ρ Q hq v w).mp hw
  obtain ⟨x,hx,hxq⟩ := hQB q.property
  have hxe : x = q := Subtype.ext hxq
  subst x
  exact hx


/-- The displacement space of a fixed vector is generated by K-commutators. -/
theorem opposite_displacement_eq_commutator (v : V) (hv : v ∈ fixedSpace ρ K)
    (hn : ∀ k ∈ K, ∀ x ∈ Q, k * x * k⁻¹ ∈ Q)
    (hgen : ⁅K,Q⁆ = Q) :
    subspaceCommutator ρ (displacementSpace ρ Q hq v) K =
      displacementSpace ρ Q hq v := by
  apply le_antisymm
  · apply subspaceCommutator_le_of_invariant ρ
    apply le_subspaceStabilizer
    exact displacementSpace_invariant ρ Q hq v K hn (fun k hk => hv ⟨k,hk⟩)
  · exact opposite_displacement_le_of_commutators ρ K Q hq v hv hn hgen _ le_rfl

/-- The central summand of C_V(Q) disappears on taking K-commutators. -/
theorem opposite_fixed_commutator
    (A W : Submodule (ZMod 2) V)
    (hdecomp : fixedSpace ρ Q = A ⊔ W)
    (hA : A ≤ fixedSpace ρ K)
    (hW : subspaceCommutator ρ W K = W) :
    subspaceCommutator ρ (fixedSpace ρ Q) K = W := by
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨k,hk,z,hz,rfl⟩
    rw [hdecomp] at hz
    obtain ⟨a,ha,w,hw,rfl⟩ := Submodule.mem_sup.mp hz
    have hka : ρ k a = a := hA ha ⟨k,hk⟩
    rw [map_add, hka, add_sub_add_left_eq_sub]
    rw [← hW]
    exact Submodule.subset_span ⟨k,hk,w,hw,rfl⟩
  · rw [← hW]
    apply subspaceCommutator_mono_left ρ _ K
    rw [hdecomp]
    exact le_sup_right

include hq in
/-- Every K-fixed vector belongs to the zero-adjoined fibre of a subspace
containing [C_V(Q),K], provided Q is generated by its K-commutators. -/
theorem opposite_fixedSpace_le_fibre (W : Submodule (ZMod 2) V)
    (hn : ∀ k ∈ K, ∀ x ∈ Q, k * x * k⁻¹ ∈ Q)
    (hgen : ⁅K,Q⁆ = Q)
    (hW : subspaceCommutator ρ (fixedSpace ρ Q) K ≤ W) :
    fixedSpace ρ K ≤ displacementFibre ρ K Q W := by
  intro v hv
  refine ⟨hv, fun q => ?_⟩
  apply opposite_displacement_le_of_commutators ρ K Q hq v hv hn hgen W
  · exact (subspaceCommutator_mono_left ρ
      (displacementSpace_le_fixed ρ Q hq v) K).trans hW
  · exact (mem_displacementSpace ρ Q hq v _).mpr ⟨q,rfl⟩

/-- The canonical commutator space is invariant under the common normalizer. -/
theorem opposite_commutator_normalizer (H : Subgroup G)
    (hK : H ≤ Subgroup.normalizer K) (hQ : H ≤ Subgroup.normalizer Q) :
    H ≤ subspaceStabilizer ρ (subspaceCommutator ρ (fixedSpace ρ Q) K) := by
  exact subspaceCommutator_invariant_normalizer ρ
    (hQ.trans (normalizer_le_stabilizer_fixedSpace ρ Q)) hK

open QuasisimpleSource
variable {F : BinaryField} {ρ}
  {d : DoubleNatural F 3 ρ} (m : QuotientCoordinates d) (j : Fin 3)

/-- Literal DoubleNatural application. The two pending coordinate calculations
are fixation of the original C_U(Q) and commutator generation of Q. -/
theorem opposite_coordinate_fixed_commutator
    (hq : IsQuadratic ρ (m.Q j))
    (hU : d.space.toSubmodule ⊓ fixedSpace ρ (m.Q j) ≤ fixedSpace ρ (m.K j))
    (hgen : ⁅m.K j,m.Q j⁆ = m.Q j)
    (v : V) (hfixed : v ∈ fixedSpace ρ (m.K j))
    (hv : d.space.toSubmodule.mkQ v = m.lineVector j) :
    subspaceCommutator ρ (fixedSpace ρ (m.Q j)) (m.K j) =
      displacementSpace ρ (m.Q j) hq v := by
  exact opposite_fixed_commutator ρ (m.K j) (m.Q j) _ _
    (m.largeField_fixed_decomposition j (by decide) hq v hv) hU
    (opposite_displacement_eq_commutator ρ (m.K j) (m.Q j) hq v hfixed
      (m.largeField_K_normalizes_Q j) hgen)

/-- The full fixed space lies in each canonical displacement fibre. -/
theorem opposite_coordinate_fixedSpace_le_fibre
    (hq : IsQuadratic ρ (m.Q j))
    (hU : d.space.toSubmodule ⊓ fixedSpace ρ (m.Q j) ≤ fixedSpace ρ (m.K j))
    (hgen : ⁅m.K j,m.Q j⁆ = m.Q j)
    (v : V) (hfixed : v ∈ fixedSpace ρ (m.K j))
    (hv : d.space.toSubmodule.mkQ v = m.lineVector j) :
    fixedSpace ρ (m.K j) ≤
      displacementFibre ρ (m.K j) (m.Q j) (displacementSpace ρ (m.Q j) hq v) := by
  exact opposite_fixedSpace_le_fibre ρ (m.K j) (m.Q j) hq _
    (m.largeField_K_normalizes_Q j) hgen
    (opposite_coordinate_fixed_commutator m j hq hU hgen v hfixed hv).le

/-- Fixed lifts now cover the entire quotient line through the actual fibre. -/
theorem opposite_coordinate_fibre_covers
    (hq : IsQuadratic ρ (m.Q j)) (hf : m.FixedLifts j)
    (hU : d.space.toSubmodule ⊓ fixedSpace ρ (m.Q j) ≤ fixedSpace ρ (m.K j))
    (hgen : ⁅m.K j,m.Q j⁆ = m.Q j)
    (v : V) (hfixed : v ∈ fixedSpace ρ (m.K j))
    (hv : d.space.toSubmodule.mkQ v = m.lineVector j) :
    m.line j ≤ (displacementFibre ρ (m.K j) (m.Q j)
      (displacementSpace ρ (m.Q j) hq v)).map d.space.toSubmodule.mkQ := by
  exact hf.trans (Submodule.map_mono
    (opposite_coordinate_fixedSpace_le_fibre m j hq hU hgen v hfixed hv))

/-- A complement in the original extension, conditional only on the two
coordinate facts in addition to quadraticity and fixed lifting. -/
theorem opposite_coordinate_complement
    (hq : IsQuadratic ρ (m.Q j)) (hf : m.FixedLifts j)
    (hU : d.space.toSubmodule ⊓ fixedSpace ρ (m.Q j) ≤ fixedSpace ρ (m.K j))
    (hgen : ⁅m.K j,m.Q j⁆ = m.Q j) :
    ∃ C : Submodule (ZMod 2) V, IsCompl d.space.toSubmodule C ∧
      m.K j ⊔ m.Q j ≤ subspaceStabilizer ρ C := by
  obtain ⟨v,hfixed,hv⟩ := m.exists_fixed_lineVector j hf
  exact complement_of_fibre_covers ρ (m.K j) (m.Q j) d.space
    (displacementSpace ρ (m.Q j) hq v) (m.axis j) (m.line j)
    (m.largeField_axis_isCompl_line j)
    (m.largeField_displacement_disjoint j hq v hv)
    (m.largeField_displacement_map j hq v hv)
    (m.largeField_displacement_stable j hq v hfixed)
    (displacementSpace_le_fixed ρ (m.Q j) hq v)
    (opposite_coordinate_fibre_covers m j hq hf hU hgen v hfixed hv)

end CFSG.Quasithin.ChapterB.NaturalExtensions.QuadraticSplitting
