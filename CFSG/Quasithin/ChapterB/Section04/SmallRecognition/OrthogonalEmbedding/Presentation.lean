module

public import CFSG.Quasithin.ChapterB.Section04.SmallRecognition.SourceActions
public import Mathlib.LinearAlgebra.Finsupp.LinearCombination
public import Mathlib.LinearAlgebra.Isomorphisms

/-!
# Permutation-module descent for the orthogonal point orbit

Equality of the marked vector stabilizers gives an injective map between the
actual orbits. Ordered-line transitivity transports one local three-point
relation to all lines. When these relations generate the point-evaluation
kernel, the orbit map descends to a linear map from the actual six-space.
Two-point coverage proves equivariance and injectivity directly, without
irreducibility of either representation or a global spanning hypothesis.

These are conditional algebraic reductions. The parabolic seed must still
supply the first line relation, and the concrete orthogonal model must supply
line transitivity, the kernel presentation and two-point coverage.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
manuscript (1 March 2004), Lemma B.4.13, printed pp.97–98.
-/

@[expose] public noncomputable section
open Representation
open scoped MatrixGroups
namespace CFSG.Quasithin.ChapterB.SmallRecognition.OrthogonalEmbedding

variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]

/-- The actual orbit of the marked vector in the split quadratic six-space. -/
abbrev PointOrbit (e : G ≃* PSL(4, ZMod 2)) (x : OrthogonalSpace) :=
  ↥(Set.range fun g => orthogonalAction e g x)

/-- A model orbit point together with its acting group element. -/
def orbitPoint (e : G ≃* PSL(4, ZMod 2)) (x : OrthogonalSpace) (g : G) :
    PointOrbit e x := ⟨orthogonalAction e g x, g, rfl⟩

/-- The map from the orbit permutation module to the actual orthogonal space. -/
noncomputable def pointEvaluation (e : G ≃* PSL(4, ZMod 2)) (x : OrthogonalSpace) :
    (PointOrbit e x →₀ ZMod 2) →ₗ[ZMod 2] OrthogonalSpace :=
  Finsupp.linearCombination (ZMod 2) Subtype.val

/-- The subspace generated by the three-point line relations in the orbit. -/
def lineRelations (e : G ≃* PSL(4, ZMod 2)) (x : OrthogonalSpace) :
    Submodule (ZMod 2) (PointOrbit e x →₀ ZMod 2) :=
  Submodule.span (ZMod 2) {t | ∃ p q r : PointOrbit e x,
    p.val + q.val = r.val ∧
      t = Finsupp.single p 1 + Finsupp.single q 1 - Finsupp.single r 1}

/-- The target orbit satisfies every three-point relation of the model orbit. -/
def RespectsLines (e : G ≃* PSL(4, ZMod 2))
    (ρ : Representation (ZMod 2) G V) (v : V) (x : OrthogonalSpace) : Prop :=
  ∀ g h k : G,
    orthogonalAction e g x + orthogonalAction e h x = orthogonalAction e k x →
      ρ g v + ρ h v = ρ k v

/-- One model line through the marked point satisfies its relation in the target. -/
def HasLineRelation (e : G ≃* PSL(4, ZMod 2))
    (ρ : Representation (ZMod 2) G V) (v : V) (x : OrthogonalSpace) : Prop :=
  ∃ a b : G, x + orthogonalAction e a x = orthogonalAction e b x ∧
    v + ρ a v = ρ b v

/-- Ordered model lines are conjugate, with the first line based at the marked point. -/
def LineTransitive (e : G ≃* PSL(4, ZMod 2)) (x : OrthogonalSpace) : Prop :=
  ∀ a b g h k : G,
    x + orthogonalAction e a x = orthogonalAction e b x →
    orthogonalAction e g x + orthogonalAction e h x = orthogonalAction e k x →
    ∃ t : G, orthogonalAction e t x = orthogonalAction e g x ∧
      orthogonalAction e (t * a) x = orthogonalAction e h x

private theorem eq_fixed (ρ : Representation (ZMod 2) G V) (v : V) (g h : G) :
    ρ g v = ρ h v ↔ h⁻¹ * g ∈ vectorStabilizer ρ v := by
  change ρ g v = ρ h v ↔ ρ (h⁻¹ * g) v = v
  rw [map_mul, Module.End.mul_apply]
  constructor
  · intro he
    rw [he, ρ.inv_self_apply]
  · intro he
    have hh := congrArg (ρ h) he
    simpa only [ρ.self_inv_apply] using hh

/-- Equality of stabilizers identifies exactly the equal pairs in the two orbits. -/
theorem orbit_eq_iff (e : G ≃* PSL(4, ZMod 2))
    (ρ : Representation (ZMod 2) G V) (v : V) (x : OrthogonalSpace)
    (hs : vectorStabilizer ρ v = vectorStabilizer (orthogonalAction e) x)
    (g h : G) :
    orthogonalAction e g x = orthogonalAction e h x ↔ ρ g v = ρ h v := by
  rw [eq_fixed, eq_fixed, hs]

/-- Transport one local line relation to every line using the actual group action. -/
theorem respectsLines_of_one_line (e : G ≃* PSL(4, ZMod 2))
    (ρ : Representation (ZMod 2) G V) (v : V) (x : OrthogonalSpace)
    (hs : vectorStabilizer ρ v = vectorStabilizer (orthogonalAction e) x)
    (htrans : LineTransitive e x) (hline : HasLineRelation e ρ v x) :
    RespectsLines e ρ v x := by
  obtain ⟨a,b,hab,hv⟩ := hline
  intro g h k hghk
  obtain ⟨t,ht,hta⟩ := htrans a b g h k hab hghk
  have htb : orthogonalAction e (t * b) x = orthogonalAction e k x := by
    rw [map_mul, Module.End.mul_apply, ← hab, map_add, ht]
    have hta' : orthogonalAction e t (orthogonalAction e a x) =
        orthogonalAction e h x := by
      simpa only [map_mul, Module.End.mul_apply] using hta
    rw [hta', hghk]
  have ht' := (orbit_eq_iff e ρ v x hs t g).mp ht
  have hta' := (orbit_eq_iff e ρ v x hs (t * a) h).mp hta
  have htb' := (orbit_eq_iff e ρ v x hs (t * b) k).mp htb
  have hh := congrArg (ρ t) hv
  rw [map_add, ← Module.End.mul_apply, ← map_mul,
    ← Module.End.mul_apply, ← map_mul, ht', hta', htb'] at hh
  exact hh

/-- Evaluate at a chosen representative; stabilizer equality makes this independent of the choice. -/
noncomputable def orbitValue (e : G ≃* PSL(4, ZMod 2))
    (ρ : Representation (ZMod 2) G V) (v : V) (x : OrthogonalSpace)
    (p : PointOrbit e x) : V := ρ p.property.choose v

/-- The orbit value agrees with the original target action at every representative. -/
theorem orbitValue_point (e : G ≃* PSL(4, ZMod 2))
    (ρ : Representation (ZMod 2) G V) (v : V) (x : OrthogonalSpace)
    (hs : vectorStabilizer ρ v = vectorStabilizer (orthogonalAction e) x)
    (g : G) : orbitValue e ρ v x (orbitPoint e x g) = ρ g v := by
  apply (orbit_eq_iff e ρ v x hs _ g).mp
  exact (orbitPoint e x g).property.choose_spec

/-- Equality of stabilizers makes the induced map on model orbit points injective. -/
theorem orbitValue_injective (e : G ≃* PSL(4, ZMod 2))
    (ρ : Representation (ZMod 2) G V) (v : V) (x : OrthogonalSpace)
    (hs : vectorStabilizer ρ v = vectorStabilizer (orthogonalAction e) x) :
    Function.Injective (orbitValue e ρ v x) := by
  intro p q hpq
  apply Subtype.ext
  have he := (orbit_eq_iff e ρ v x hs p.property.choose q.property.choose).mpr hpq
  simpa only [p.property.choose_spec, q.property.choose_spec] using he

/-- Every three-point line relation vanishes under model evaluation. -/
theorem lineRelations_le_ker (e : G ≃* PSL(4, ZMod 2)) (x : OrthogonalSpace) :
    lineRelations e x ≤ LinearMap.ker (pointEvaluation e x) := by
  apply Submodule.span_le.mpr
  rintro t ⟨p,q,r,he,rfl⟩
  change pointEvaluation e x _ = 0
  simp only [map_sub, map_add, pointEvaluation, Finsupp.linearCombination_single, one_smul]
  exact sub_eq_zero.mpr he

/-- The target line relations annihilate the literal relation subspace. -/
theorem lineRelations_le_target_ker (e : G ≃* PSL(4, ZMod 2))
    (ρ : Representation (ZMod 2) G V) (v : V) (x : OrthogonalSpace)
    (hline : RespectsLines e ρ v x) :
    lineRelations e x ≤
      LinearMap.ker (Finsupp.linearCombination (ZMod 2) (orbitValue e ρ v x)) := by
  apply Submodule.span_le.mpr
  rintro t ⟨p,q,r,he,rfl⟩
  change Finsupp.linearCombination (ZMod 2) (orbitValue e ρ v x) _ = 0
  simp only [map_sub, map_add, Finsupp.linearCombination_single, one_smul]
  apply sub_eq_zero.mpr
  apply hline p.property.choose q.property.choose r.property.choose
  simpa only [p.property.choose_spec, q.property.choose_spec, r.property.choose_spec] using he

/-- Descend the orbit map through the line presentation and prove the resulting marked intertwiner injective. -/
theorem exists_intertwiner_of_presentation (e : G ≃* PSL(4, ZMod 2))
    (ρ : Representation (ZMod 2) G V) (v : V) (x : OrthogonalSpace)
    (hs : vectorStabilizer ρ v = vectorStabilizer (orthogonalAction e) x)
    (hcover : ∀ w : OrthogonalSpace, ∃ p q : PointOrbit e x, w = p.val - q.val)
    (hker : LinearMap.ker (pointEvaluation e x) ≤ lineRelations e x)
    (hline : RespectsLines e ρ v x) :
    ∃ f : IntertwiningMap (orthogonalAction e) ρ, Function.Injective f ∧ f x = v := by
  classical
  let ψ := pointEvaluation e x
  let φ := Finsupp.linearCombination (ZMod 2) (orbitValue e ρ v x)
  have hψ : Function.Surjective ψ := by
    intro w
    obtain ⟨p,q,hpq⟩ := hcover w
    refine ⟨Finsupp.single p 1 - Finsupp.single q 1, ?_⟩
    simpa only [ψ, pointEvaluation, map_sub, Finsupp.linearCombination_single, one_smul]
      using hpq.symm
  let f : OrthogonalSpace →ₗ[ZMod 2] V :=
    ((LinearMap.ker ψ).liftQ φ (hker.trans (lineRelations_le_target_ker e ρ v x hline))).comp
      (ψ.quotKerEquivOfSurjective hψ).symm.toLinearMap
  have hf (t : PointOrbit e x →₀ ZMod 2) : f (ψ t) = φ t := by
    simp [f, LinearMap.quotKerEquivOfSurjective_symm_apply]
  have hfp (p : PointOrbit e x) : f p.val = orbitValue e ρ v x p := by
    simpa only [ψ, pointEvaluation, φ, Finsupp.linearCombination_single, one_smul]
      using hf (Finsupp.single p 1)
  have hfg (g : G) : f (orthogonalAction e g x) = ρ g v :=
    (hfp (orbitPoint e x g)).trans (orbitValue_point e ρ v x hs g)
  have hfx : f x = v := by simpa only [map_one, Module.End.one_apply] using hfg 1
  have hintertwines (g : G) (w : OrthogonalSpace) :
      f (orthogonalAction e g w) = ρ g (f w) := by
    obtain ⟨p,q,rfl⟩ := hcover w
    obtain ⟨a,ha⟩ := p.property
    obtain ⟨b,hb⟩ := q.property
    rw [← ha, ← hb, map_sub, map_sub, map_sub, map_sub, hfg a, hfg b]
    have hmul (a : G) : f (orthogonalAction e g (orthogonalAction e a x)) =
        ρ g (ρ a v) := by
      rw [← Module.End.mul_apply, ← map_mul, hfg, map_mul, Module.End.mul_apply]
    rw [hmul a, hmul b]
  let F : IntertwiningMap (orthogonalAction e) ρ := {
    toLinearMap := f
    isIntertwining' := fun g => LinearMap.ext (hintertwines g) }
  refine ⟨F, ?_, hfx⟩
  apply LinearMap.ker_eq_bot.mp
  apply LinearMap.ker_eq_bot'.mpr
  intro w hw
  obtain ⟨p,q,rfl⟩ := hcover w
  change f (p.val - q.val) = 0 at hw
  rw [map_sub, hfp, hfp] at hw
  have hpq := orbitValue_injective e ρ v x hs (sub_eq_zero.mp hw)
  rw [hpq, sub_self]

end CFSG.Quasithin.ChapterB.SmallRecognition.OrthogonalEmbedding
