module
public import CFSG.Quasithin.ChapterK.Section01To04.Exceptional.CubicSourceExclusionsTrialityComplete
public import CFSG.Quasithin.Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.ExternalModules.FFSections.SourceOrbit.ActionImage.Structure
public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.WeakClosureBounds.GenerationOne.RepresentationReduction.SourceRestrictions.FaithfulSections
public import CFSG.Quasithin.Chapter15.Section03.AbelianAmalgam.WeakClosureBounds.GenerationOne.OriginalModule.Normal.Restriction
public import Theory.Representation.BinaryOffender.QuadraticComponentSection
public import Theory.Representation.BinaryOffender.QuadraticImageBound

/-!
# A retained quadratic actor on a normal triality component

Restrict to the subgroup generated by the component and the actual quadratic
actor. Faithful conjugation keeps the actor's rank on a surviving component
section. Its faithful image has the same generalized Fitting component, so
the original triality cubic exclusion applies. No small ratio is inferred
for an arbitrary subgroup or for an image that loses actor rank.

Source: Aschbacher--Smith F.9.18(3--4), p.325, and K.3, p.457.
-/

public section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterB.SmallRatioClassification
open Chapter15.Section03.AbelianAmalgam.GenerationOne.RepresentationReduction.SourceRestrictions
open Chapter15.Section03.AbelianAmalgam.GenerationOne.RepresentationReduction.SourceRestrictions.FFExclusions.ModelRigidity
open Chapter15.Section03.AbelianAmalgam.GenerationOne.OriginalModule.Normal
open Chapter13.Section08.ComponentSieve.FieldComponents.HigherFieldReduction.ExternalModules.FFSections.SourceOrbit.ActionImage.Structure
universe u
variable {G V : Type u} [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
    [Finite V]

private theorem triality_quadratic_supplement_false
    (ρ : Representation (ZMod 2) G V) (K A : Subgroup G)
    [K.Normal] [IsQuasisimple K] (hZ : center K = ⊥)
    (hs : IsSQTK KnownSimple.IsKnownSimple G) (hgen : K ⊔ A = ⊤)
    {n : ℕ} (hn : 1 ≤ n)
    (hm : Triality.Standard.IsTrialityGroupAt (2^n) (K ⧸ center K))
    (hA : IsElementaryTwo A) (hq : IsQuadratic ρ A)
    (hc : fixedCodim ρ A ≤ 2 * rank A)
    (hAC : A ⊓ centralizer (K : Set G) = ⊥) (hk : ¬ K ≤ ρ.ker) : False := by
  let : FiniteDimensional (ZMod 2) V := Module.Finite.of_finite
  obtain ⟨U,N,hi,hk,hq,hc⟩ := exists_component_irreducible_quadratic_section
    ρ K A hZ hgen hA hq hc hAC hk
  let : Finite (U ⧸ N.toSubmodule) := Module.finite_of_finite (ZMod 2)
  let σ := N.quotientRepresentation
  have hsurvive : ¬ K ≤ (actionHom σ).ker := by
    intro h
    apply hk
    intro k hk
    exact LinearMap.ext ((actionHom_eq_one_iff σ k).mp (h hk))
  have hfaith := faithful_on_section_of_central_kernel σ K A hAC
    (central_kernel_of_quasisimple σ K (by
      intro h
      apply hk
      intro k hk
      exact LinearMap.ext (h k hk)))
  have hbound : quadraticRatio (imageRepresentation σ) ≤ 2 := by
    apply (quadraticRatio_le_two_iff _).mpr
    refine ⟨actionSubgroup σ A,hA.actionSubgroup σ hfaith,
      quadratic_actionSubgroup σ hq,?_⟩
    rw [fixedCodim_actionSubgroup,actionSubgroup_rank σ A hfaith]
    exact hc
  let := hA.2
  have hquot : IsPGroup 2 (G ⧸ K) :=
    isPGroup_quotient_of_sup_eq_top K A (IsElementaryAbelian.isPGroup 2 A) hgen
  obtain ⟨hqs,hirr,hfit⟩ := image_structure σ K hsurvive hquot hi
  let e : K ≃* generalizedFitting (actionImage σ) :=
    (componentEquiv σ K hsurvive hZ).trans (MulEquiv.subgroupCongr hfit.symm)
  have hsource : ChapterK.RankOne.SourceHypotheses (imageRepresentation σ)
      (generalizedFitting (actionImage σ)) :=
    ⟨image_sqtk σ K hsurvive hs hquot hZ,rfl,hfit.symm ▸ hqs,
      imageRepresentation_injective σ,hfit.symm ▸ hirr,
      (Representation.BinaryOffender.cubicRatio_le_quadraticRatio _).trans hbound⟩
  exact ChapterK.Exceptional.CubicSourceExclusions.triality_cubic_source_false hsource hn
    (hm.of_mulEquiv (centralQuotientCongr e).symm)

/-- A normal centerless triality component cannot admit the same faithful
quadratic actor with fixed codimension at most twice its original rank. -/
theorem triality_excluded_of_faithful_quadratic_actor
    (ρ : Representation (ZMod 2) G V) (K A : Subgroup G)
    [K.Normal] [IsQuasisimple K] (hZ : center K = ⊥)
    (hs : IsSQTK KnownSimple.IsKnownSimple G) (hf : Function.Injective ρ)
    {n : ℕ} (hn : 1 ≤ n)
    (hm : Triality.Standard.IsTrialityGroupAt (2^n) (K ⧸ center K))
    (hA : IsElementaryTwo A) (hq : IsQuadratic ρ A)
    (hc : fixedCodim ρ A ≤ 2 * rank A)
    (hAC : A ⊓ centralizer (K : Set G) = ⊥) : False := by
  let : IsQuasisimple (K.subgroupOf (K ⊔ A)) := componentInSup_quasisimple K A
  apply triality_quadratic_supplement_false (ρ.comp (K ⊔ A).subtype)
    (K.subgroupOf (K ⊔ A)) (A.subgroupOf (K ⊔ A))
    (componentInSup_center K A hZ) (hs.subgroup (K ⊔ A))
    (componentInSup_generated K A) hn
    (hm.of_mulEquiv (centralQuotientCongr (componentInSupEquiv K A)))
    (actorInSup_elementary K A hA) (actorInSup_quadratic ρ K A hq)
    (actorInSup_bound ρ K A hc) (actorInSup_faithful K A hAC)
  intro hh
  have hK : K = ⊥ := by
    apply bot_unique
    intro k hk
    exact hf ((show ρ k = 1 from hh
      (show (⟨k,(le_sup_left : K ≤ K ⊔ A) hk⟩ : ↥(K ⊔ A)) ∈
        K.subgroupOf (K ⊔ A) from hk)).trans (map_one ρ).symm)
  let : IsSimpleGroup (K ⧸ center K) := IsQuasisimple.simple
  let : Nontrivial K := (QuotientGroup.mk'_surjective (center K)).nontrivial
  exact (Subgroup.nontrivial_iff_ne_bot K).mp inferInstance hK

end CFSG.Quasithin.ChapterB.SmallRatioClassification
