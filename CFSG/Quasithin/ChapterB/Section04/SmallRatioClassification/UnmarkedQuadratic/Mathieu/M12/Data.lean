def bit (n k : Nat) : ZMod 2 := if n.testBit k then 1 else 0
def baseMatrix (i : Fin 2) : Matrix (Fin 10) (Fin 10) (ZMod 2) :=
  fun r c => bit (baseRows i r) c.val
def prefixMatrix (i : Fin 90) : Matrix (Fin 10) (Fin 10) (ZMod 2) :=
  fun r c => bit prefixMatrixTable[i.val]! (10*r.val+c.val)
def prefixParent (i : Fin 90) : Fin 90 :=
  ⟨prefixParentTable[i.val]! % 90, Nat.mod_lt _ (by decide)⟩
def prefixLast (i : Fin 90) : Fin 2 :=
  ⟨prefixLastTable[i.val]! % 2, Nat.mod_lt _ (by decide)⟩
def prefixWord (i : Fin 90) : List (Fin 2) :=
  prefixWordTable[i.val]!.map (fun j => ⟨j % 2, Nat.mod_lt _ (by decide)⟩)
def generatorEnd (j : Fin 3) : Fin 90 :=
  ⟨generatorEndTable[j.val]! % 90, Nat.mod_lt _ (by decide)⟩
def matrix (i : Fin 128) : Matrix (Fin 10) (Fin 10) (ZMod 2) :=
  fun r c => bit matrixTable[i.val]! (10*r.val+c.val)
def generatorMatrix (i : Fin 3) : Matrix (Fin 10) (Fin 10) (ZMod 2) :=
  fun r c => bit generatorTable[i.val]! (10*r.val+c.val)
def parent (i : Fin 128) : Fin 128 := ⟨parentTable[i.val]! % 128, Nat.mod_lt _ (by decide)⟩
def last (i : Fin 128) : Fin 3 := ⟨lastTable[i.val]! % 3, Nat.mod_lt _ (by decide)⟩
def vertex (v : Fin 36) : Fin 128 := ⟨vertexTable[v.val]! % 128, Nat.mod_lt _ (by decide)⟩
def squareIndex (i : Fin 128) : Fin 36 := ⟨squareIndexTable[i.val]! % 36, Nat.mod_lt _ (by decide)⟩
def displacement (v : Fin 36) := matrix (vertex v) - 1
def adjacent (v w : Fin 36) : Bool := adjacencyTable[v.val]!.testBit w.val
def nonedge (v w : Fin 36) : Nat := (nonedgeTable[v.val]! >>> (8*w.val)) % 256
def pair (v w : Fin 36) : Nat := (pairTable[v.val]! >>> (6*w.val)) % 64
def rowIndex (v w : Fin 36) (j : Fin 5) : Nat :=
  (selectedTable[pair v w]! >>> (5*j.val)) % 32
def selected (v w : Fin 36) : Matrix (Fin 5) (Fin 10) (ZMod 2) :=
  fun r c => if rowIndex v w r < 10 then
    displacement (min v w) ⟨rowIndex v w r % 10, Nat.mod_lt _ (by decide)⟩ c
  else displacement (max v w) ⟨rowIndex v w r % 10, Nat.mod_lt _ (by decide)⟩ c
def rightInverse (v w : Fin 36) : Matrix (Fin 10) (Fin 5) (ZMod 2) :=
  fun r c => bit inverseTable[pair v w]! (10*c.val+r.val)
