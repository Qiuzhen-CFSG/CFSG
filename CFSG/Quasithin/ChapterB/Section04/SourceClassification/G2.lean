module

public import CFSG.Quasithin.ChapterB.Section04.SourceClassification.G2Recognition
public import Theory.Representation.G2NaturalNormalizerOffenders
public import Theory.Representation.G2NaturalOffenders
public import Theory.Representation.BinaryOffender.GeneratedCore
public import CFSG.Quasithin.ChapterB.Section05.GeneralClassification.SourceInduction.QuasisimpleContract

/-!
# The full ordinary G₂ branch of B.4.2

The genuine central-cover and cubic-degree theorems recognize the natural
six-space from the source central quotient. Its full binary normalizer has
no outer offenders. The concrete root geometry then gives rank and fixed
codimension 3n for every original ambient offender. Thus the quadratic
ratio is one and the normal subgroup generated by best offenders is the
simple layer itself.

The final exports start from the literal central-quotient family and the
original faithful irreducible source action. Cover, model, degree, scalar
semilinearity and offender geometry are conclusions of proved producers.
Source: Aschbacher–Smith B.4.2(4), B.4.6(13), and K.3.
-/

public section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open CFSG.Quasithin.ChapterB.QuasisimpleSource
namespace CFSG.Quasithin.ChapterB.SourceClassification
variable {G V : Type*} [Group G] [Finite G] [AddCommGroup V]
  [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
  {ρ : Representation (ZMod 2) G V} {L : Subgroup G}

omit [FiniteDimensional (ZMod 2) V] in
theorem g2_offender_le (h : ChapterK.RankOne.SourceHypotheses ρ L)
    (F : BinaryField) (hF : 1 < F.degree)
    (M : ActionEquiv (ρ.comp L.subtype) (binaryG2 F))
    {A : Subgroup G} (hA : IsOffender ρ A) : A ≤ L := by
  rcases F with @⟨K, hField, hFinite, hChar, hAlg, n, hn, hcard⟩
  have hAlgEq : hAlg = ZMod.algebra K 2 := Subsingleton.elim _ _
  subst hAlg
  let : Algebra (ZMod 2) K := ZMod.algebra K 2
  let := h.layer_normal
  exact Atlas.G2.Natural.Normalizer.ambient_offender_le K ρ L M.groupEquiv
    M.linearEquiv (fun g v => M.intertwines g v) h.faithful
    (by change 1 < n at hF; omega) hcard hA

omit [FiniteDimensional (ZMod 2) V] in
theorem g2_offender_rank_codim (h : ChapterK.RankOne.SourceHypotheses ρ L)
    (F : BinaryField) (hF : 1 < F.degree)
    (M : ActionEquiv (ρ.comp L.subtype) (binaryG2 F))
    {A : Subgroup G} (hA : IsOffender ρ A) :
    rank A = 3 * F.degree ∧ fixedCodim ρ A = 3 * F.degree := by
  have hAL := g2_offender_le h F hF M hA
  have hB := hA.subgroupOf ρ hAL
  have hC := hB.map_equivariant (ρ.comp L.subtype) (binaryG2 F)
    M.groupEquiv.toMonoidHom M.groupEquiv.injective M.linearEquiv M.intertwines
  have hr := Atlas.G2.NaturalOffenders.natural_offender_rank F.card_eq F.degree_pos _ hC
  have hd := Atlas.G2.NaturalOffenders.natural_offender_fixedCodim F.card_eq F.degree_pos _ hC
  rw [rank_map_injective, rank_subgroupOf hAL] at hr
  · rw [← fixedCodim_map_equivariant _ _ _ M.linearEquiv M.intertwines,
      fixedCodim_subgroupOf ρ hAL] at hd
    exact ⟨hr, hd⟩
  · exact M.groupEquiv.injective

theorem g2_generated (h : ChapterK.RankOne.SourceHypotheses ρ L)
    (hff : IsFFModule ρ) (F : BinaryField) (hF : 1 < F.degree)
    (M : ActionEquiv (ρ.comp L.subtype) (binaryG2 F)) : offenderSubgroup ρ = L := by
  let := h.layer_normal
  let J := offenderSubgroup ρ
  let : J.Normal := offenderSubgroup_normal ρ
  have hJL : J ≤ L := by
    apply iSup_le
    intro A
    apply iSup_le
    rintro ⟨hA, _⟩
    exact g2_offender_le h F hF M (hA.isOffender ρ)
  have hne : J ≠ ⊥ := offenderSubgroup_ne_bot_of_ff ρ hff
  have hq : 2 < Nat.card F.Carrier := by
    rw [F.card_eq]
    simpa using Nat.pow_lt_pow_right (by decide : 1 < 2) hF
  let : IsSimpleGroup (Atlas.G2.Model F.Carrier) := Atlas.G2.isSimple hq
  let : IsSimpleGroup L := (MulEquiv.isSimpleGroup_congr M.groupEquiv).mpr inferInstance
  rcases (inferInstance : (J.subgroupOf L).Normal).eq_bot_or_eq_top with hb | ht
  · exact (hne (by simpa only [hb, Subgroup.map_bot] using (map_subgroupOf_eq_of_le hJL).symm)).elim
  · apply le_antisymm hJL
    intro x hx
    exact (show (⟨x,hx⟩ : L) ∈ J.subgroupOf L from ht.symm ▸ mem_top _)

theorem g2_case (h : ChapterK.RankOne.SourceHypotheses ρ L) (hff : IsFFModule ρ)
    (F : BinaryField) (hF : 1 < F.degree)
    (e : L ⧸ center L ≃* Atlas.G2.Model F.Carrier) :
    SourceInduction.ProjectiveLine.IrreducibleActionCase ρ L (offenderSubgroup ρ) := by
  obtain ⟨M⟩ := g2_natural_action h F hF e
  refine .g2 F hF (g2_generated h hff F hF M) M ?_ ?_
  · intro A hA
    exact (g2_offender_rank_codim h F hF M (hA.isOffender ρ)).1
  · apply quadraticRatio_eq_one_of_no_strong ρ hff
    intro A hA
    have hb := g2_offender_rank_codim h F hF M ⟨hA.1,hA.2.le⟩
    have hs := hA.2
    omega
theorem g2_model_case (h : ChapterK.RankOne.SourceHypotheses ρ L) (hff : IsFFModule ρ)
    {r : ℕ} (hr : 2 ≤ r) (hm : ClassificationModels.IsG2At (L ⧸ center L) (2 ^ r)) :
    SourceInduction.ProjectiveLine.IrreducibleActionCase ρ L (offenderSubgroup ρ) := by
  obtain ⟨F,_,_,hcard,⟨e⟩⟩ := hm
  let : Fintype F := Fintype.ofFinite F
  let : CharP F 2 := charP_of_card_eq_prime_pow
    (show Fintype.card F = 2 ^ r by simpa only [Nat.card_eq_fintype_card] using hcard)
  let : Algebra (ZMod 2) F := ZMod.algebra F 2
  let K : BinaryField := { Carrier := F, degree := r, degree_pos := by omega, card_eq := hcard }
  exact g2_case h hff K (by change 1 < r; omega) e

theorem g2_of_bestOffender (hsq : IsSQTK KnownSimple.IsKnownSimple G)
    (hfit : generalizedFitting G = L) (hL : IsQuasisimple L)
    (hf : Function.Injective ρ) (hi : IsIrreducible (ρ.comp L.subtype))
    {A : Subgroup G} (hA : IsBestOffender ρ A)
    {r : ℕ} (hr : 2 ≤ r) (hm : ClassificationModels.IsG2At (L ⧸ center L) (2 ^ r)) :
    SourceInduction.ProjectiveLine.IrreducibleActionCase ρ L (offenderSubgroup ρ) :=
  g2_model_case (source_hypotheses_of_bestOffender hsq hfit hL hf hi hA)
    ⟨A,hA.isOffender ρ⟩ hr hm
end CFSG.Quasithin.ChapterB.SourceClassification
