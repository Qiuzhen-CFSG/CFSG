module
public import CFSG.Quasithin.ChapterB.Section03.Offenders.Odd.SevenThompson
public import CFSG.Quasithin.ChapterB.Section03.Offenders.Odd
public import Theory.Representation.NormalElementaryQuotient.BestOffender
public import Theory.Representation.BinaryOffender.FixedCodimTransport
public import Theory.GroupAction.NormalPChiefSeries.Linear

/-!
# The complete Thompson image on the deleted seven-point module

The faithful action contains A₇. A nontrivial maximum elementary image is
in the disjoint-transposition family, so it contains an odd permutation
and the full action is S₇. B.3.2 bounds all maximum elementary images by
a common group of three disjoint transpositions. Kernel conjugacy places
conjugates of one such image back inside the original Sylow and supplies
every transposition in that group, proving equality with the Thompson image.

Source: Aschbacher–Smith B.3.2(4), pp.83–84, used in 5.1.13, p.637.
-/

public noncomputable section
open scoped IsMulCommutative
open Subgroup Representation Representation.BinaryOffender Stellmacher
namespace CFSG.Quasithin.ChapterB.Offenders
variable {H : Type*} [Group H] [Finite H]

private theorem caseA_contains_swap {A : Subgroup (Equiv.Perm (Fin 7))}
    (hA : CaseAFamily 7 A) : ∃ s ∈ A, s.IsSwap := by
  obtain ⟨m,hm,hm3,g,rfl⟩ := hA
  refine ⟨(MulAut.conj g) (pairSwap 7 0),
    mem_map_of_mem _ (pairSwap_mem (n := 7) (m := m) (0 : Fin 3) (by change 0 < m; omega)),?_⟩
  exact ⟨g 0,g 1,g.injective.ne (by decide),Equiv.symm_trans_swap_trans 0 1 g⟩

/-- The actual six-dimensional conjugation action is onto S₇, and the
Thompson image is the full group generated by three disjoint transpositions. -/
theorem seven_thompson_image
    (U : Subgroup H) [U.Normal] [IsElementaryAbelian 2 U]
    (q : H →* Equiv.Perm (Fin 7)) (hk : q.ker = centralizer (U : Set H))
    (hAlt : alternatingGroup (Fin 7) ≤ q.range)
    (P : Sylow 2 H) (hUP : U ≤ P)
    (hj : ¬ elementaryAbelianMaxJ (P : Subgroup H) ≤ q.ker)
    (l : Additive U ≃ₗ[ZMod 2] BinaryPermutation.core (Fin 7))
    (hl : ∀ g v, l (Additive.ofMul (MulAut.conjNormal g v.toMul)) =
      BinaryPermutation.coreRepresentation (Fin 7) (q g) (l v)) :
    Function.Surjective q ∧ ∃ g : Equiv.Perm (Fin 7),
      (elementaryAbelianMaxJ (P : Subgroup H)).map q =
        (D 7).map (MulAut.conj g).toMonoidHom := by
  let r := q.rangeRestrict
  have hkr : r.ker = centralizer (U : Set H) := q.ker_rangeRestrict.trans hk
  let ρ := NormalElementaryQuotient.representation U r q.rangeRestrict_surjective hkr
  let σ := BinaryPermutation.coreRepresentation (Fin 7)
  have he : ∀ g v, l (ρ g v) = σ g.val (l v) := by
    intro g v
    obtain ⟨g,rfl⟩ := q.rangeRestrict_surjective g
    have hr : ρ (r g) v = Additive.ofMul (MulAut.conjNormal g v.toMul) := by
      apply Additive.toMul.injective
      apply Subtype.ext
      exact NormalElementaryQuotient.representation_apply U r q.rangeRestrict_surjective hkr g v
    rw [hr]
    exact hl g v
  have hfam (A : Subgroup H) (hA : A ∈ elementaryAbelianMaxSubgroups (P : Subgroup H))
      (hne : A.map q ≠ ⊥) : CaseAFamily 7 (A.map q) := by
    have hmap : (A.map r).map q.range.subtype = A.map q := by rw [map_map]; rfl
    have hne' : A.map r ≠ ⊥ := by intro he; rw [←hmap,he,Subgroup.map_bot] at hne; exact hne rfl
    have hb := NormalElementaryQuotient.maxElementary_isBestOffender U r
      q.rangeRestrict_surjective hkr P A hUP hA hne'
    have hc := hb.map_of_fixedCodim ρ σ q.range.subtype q.range.subtype_injective
      (fixedCodim_map_equivariant ρ σ q.range.subtype l he)
    rw [hmap] at hc
    exact (Odd.isBestOffender_core_iff_caseAFamily (Or.inr rfl) _).mp hc
  obtain ⟨A,hA,hne⟩ : ∃ A ∈ elementaryAbelianMaxSubgroups (P : Subgroup H), A.map q ≠ ⊥ := by
    by_contra! hn
    exact hj (sSup_le fun A hA => (map_eq_bot_iff A).mp (hn A hA))
  obtain ⟨s,hs,hss⟩ := caseA_contains_swap (hfam A hA hne)
  have hq : Function.Surjective q := by
    apply MonoidHom.range_eq_top.mp
    apply top_unique
    rw [←Equiv.Perm.closure_isSwap]
    apply (closure_le _).mpr
    intro t ht
    have hts := hAlt (Equiv.Perm.mul_mem_alternatingGroup_of_isSwap ht hss)
    have hsr := map_le_range q A hs
    simpa using q.range.mul_mem hts (q.range.inv_mem hsr)
  obtain ⟨R,hDR,_⟩ := Odd.exists_sylow_containing_D (Or.inr rfl : 7 = 5 ∨ 7 = 7)
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq (Equiv.Perm (Fin 7)) R (P.mapSurjective hq)
  have hgmap : (R : Subgroup (Equiv.Perm (Fin 7))).map (MulAut.conj g).toMonoidHom =
      (P : Subgroup H).map q := congrArg (fun S : Sylow 2 (Equiv.Perm (Fin 7)) =>
        (S : Subgroup (Equiv.Perm (Fin 7)))) hg
  have hcancel (B : Subgroup (Equiv.Perm (Fin 7))) :
      (B.map (MulAut.conj g⁻¹).toMonoidHom).map (MulAut.conj g).toMonoidHom = B := by
    change (B.conjBy g⁻¹).conjBy g = B
    rw [conjBy_conjBy,mul_inv_cancel,conjBy_one]
  refine ⟨hq,g,le_antisymm ?_ ?_⟩
  · apply map_le_iff_le_comap.mpr
    apply sSup_le
    intro E hE
    apply map_le_iff_le_comap.mp
    by_cases hzero : E.map q = ⊥
    · rw [hzero]; exact bot_le
    have hER : (E.map q).map (MulAut.conj g⁻¹).toMonoidHom ≤ R := by
      apply (map_le_map_iff_of_injective (f := (MulAut.conj g).toMonoidHom)
        (MulAut.conj g).injective).mp
      rw [hcancel,hgmap]
      exact map_mono hE.1
    have hbest : IsBestOffender σ (E.map q) :=
      (Odd.isBestOffender_core_iff_caseAFamily (Or.inr rfl) _).mpr (hfam E hE hzero)
    have hb := Odd.caseAFamily_le_D_of_le_sylow (Or.inr rfl) R hDR
      ((Odd.isBestOffender_core_iff_caseAFamily (Or.inr rfl) _).mp (hbest.map_conj σ g⁻¹)) hER
    have hh := map_mono (f := (MulAut.conj g).toMonoidHom) hb
    rwa [hcancel] at hh
  · apply map_le_iff_le_comap.mpr
    apply (closure_le _).mpr
    rintro t ⟨i,hi,rfl⟩
    apply swap_mem_thompson_image_of_caseAFamily P q hq A hA (hfam A hA hne)
    · let x : Fin 7 := ⟨2*i.val,by omega⟩
      let y : Fin 7 := ⟨2*i.val+1,by omega⟩
      exact ⟨g x,g y,g.injective.ne (by intro he; have := congrArg Fin.val he; dsimp [x,y] at this; omega),
        Equiv.symm_trans_swap_trans x y g⟩
    · rw [←hgmap]
      exact mem_map_of_mem _ (hDR (pairSwap_mem i hi))
end CFSG.Quasithin.ChapterB.Offenders
