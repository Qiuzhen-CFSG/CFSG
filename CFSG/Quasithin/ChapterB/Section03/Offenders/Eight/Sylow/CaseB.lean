module

public import CFSG.Quasithin.ChapterB.Section03.Offenders.Eight.Canonical.Hyperplanes.Bases
public import CFSG.Quasithin.ChapterB.Section03.Offenders.Eight.Sylow
import Mathlib.GroupTheory.Perm.Cycle.Type

/-!
# Case-(b) generators in the degree-eight Sylow

Every canonical case-(b) group is generated by its transpositions and double
transpositions. For arbitrary hyperplanes, the three binary basis words have
support of size one or two among the independent swaps. Conjugacy preserves
these cycle types. Inside a two-subgroup containing `D`, the transpositions
already lie in `D`, giving the upper containment in the source's generation
formula.

In the canonical Sylow every double transposition lies in `D`, the exceptional
group, or its opposite-block conjugate. The finite normal-form check establishes
this without enumerating the subgroup lattice. These three groups are the
best-offender witnesses used for the reverse containment.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
Proposition B.3.2(5),(6), printed pp. 83–84.
-/

@[expose] public section

namespace CFSG.Quasithin.ChapterB.Offenders.Eight

private def small (s : Perm) : Prop := s.IsSwap ∨ IsConj (kleinFirst 8 (by decide)) s

private theorem small_iff (s : Perm) : small s ↔
    s.cycleType = {2} ∨ s.cycleType = (kleinFirst 8 (by decide)).cycleType := by
  simp only [small, Equiv.Perm.isSwap_iff_cycleType, Equiv.Perm.isConj_iff_cycleType_eq,
    eq_comm (a := (kleinFirst 8 (by decide)).cycleType)]

private theorem small_conj {s : Perm} (hs : small s) (g : Perm) :
    small ((MulAut.conj g) s) := by
  rw [small_iff] at hs ⊢
  change (g * s * g⁻¹).cycleType = {2} ∨
    (g * s * g⁻¹).cycleType = (kleinFirst 8 (by decide)).cycleType
  simpa only [Equiv.Perm.cycleType_conj] using hs

private theorem small_pair (i : Fin 4) : small (pairSwap 8 i) := by
  apply (small_iff _).mpr
  exact Or.inl (by revert i; decide +kernel)

private theorem small_mapped_closure (S : Set Perm) (hS : ∀ s ∈ S, small s) (g : Perm) :
    (Subgroup.closure S).map (MulAut.conj g).toMonoidHom ≤
      Subgroup.closure {s | s ∈ (Subgroup.closure S).map (MulAut.conj g).toMonoidHom ∧
        small s} := by
  apply Subgroup.map_le_iff_le_comap.mpr
  apply (Subgroup.closure_le _).mpr
  intro s hs
  exact Subgroup.subset_closure
    ⟨Subgroup.mem_map.mpr ⟨s, Subgroup.subset_closure hs, rfl⟩, small_conj (hS s hs) g⟩

private theorem hyperplane_small (H : Subgroup Perm) (hH : H ⋖ D 8) (g : Perm) :
    H.map (MulAut.conj g).toMonoidHom ≤
      Subgroup.closure {s | s ∈ H.map (MulAut.conj g).toMonoidHom ∧ small s} := by
  obtain ⟨m, hm, rfl⟩ := hyperplane_eq_kernel hH
  rw [hyperplaneKernel_closure_basis m hm]
  apply small_mapped_closure
  have ht : ∀ m : Fin 16, ∀ i : Fin 3,
      (dWords (hyperplaneBasisIndices m i)).cycleType = {2} ∨
      (dWords (hyperplaneBasisIndices m i)).cycleType = (kleinFirst 8 (by decide)).cycleType := by
    decide +kernel
  intro s hs
  simp only [hyperplaneBasisGenerators, Finset.mem_coe, Finset.mem_insert,
    Finset.mem_singleton] at hs
  rcases hs with rfl | rfl | rfl
  · exact (small_iff _).mpr (ht m 0)
  · exact (small_iff _).mpr (ht m 1)
  · exact (small_iff _).mpr (ht m 2)

theorem caseBFamily_le_smallClosure {A : Subgroup Perm} (hA : CaseBFamily 8 (by decide) A) :
    A ≤ Subgroup.closure {s | s ∈ A ∧ (s.IsSwap ∨ IsConj (kleinFirst 8 (by decide)) s)} := by
  rcases hA with ⟨m, _, _, g, rfl⟩ | ⟨g, rfl⟩ | ⟨g, rfl⟩ | ⟨H, hH, _, g, rfl⟩
  · apply small_mapped_closure
    rintro s ⟨i, _, rfl⟩
    exact small_pair i
  · apply small_mapped_closure
    rintro s (hs | ⟨i, _, rfl⟩)
    · rcases hs with rfl | hs
      · exact Or.inr (IsConj.refl _)
      · rw [Set.mem_singleton_iff] at hs
        subst s
        exact Or.inr (Equiv.Perm.isConj_of_cycleType_eq (by decide +kernel))
    · exact small_pair i
  · exact hyperplane_small _ evenPart_covBy_D g
  · exact hyperplane_small H hH g

theorem caseBFamily_le_D_sup_doubleSwaps {P A : Subgroup Perm} (hP : IsPGroup 2 P)
    (hD : D 8 ≤ P) (hA : CaseBFamily 8 (by decide) A) (hAP : A ≤ P) :
    A ≤ D 8 ⊔ Subgroup.closure {s | IsConj (kleinFirst 8 (by decide)) s ∧ s ∈ P} := by
  apply (caseBFamily_le_smallClosure hA).trans
  apply (Subgroup.closure_le _).mpr
  rintro s ⟨hsA, hs | hs⟩
  · exact Subgroup.mem_sup_left (isSwap_mem_D_of_isPGroup hP hD hs (hAP hsA))
  · exact Subgroup.mem_sup_right (Subgroup.subset_closure ⟨hs, hAP hsA⟩)

def oppositeExceptional : Subgroup Perm :=
  (exceptional 8 (by decide)).map (MulAut.conj halfSwap).toMonoidHom

theorem oppositeExceptional_le_canonicalSylow : oppositeExceptional ≤ canonicalSylow := by
  apply Subgroup.map_le_iff_le_comap.mpr
  intro s hs
  exact canonicalSylow.mul_mem
    (canonicalSylow.mul_mem (sylowGenerators_mem 6) (exceptional_le_canonicalSylow hs))
    (canonicalSylow.inv_mem (sylowGenerators_mem 6))

set_option maxRecDepth 10000 in
set_option maxHeartbeats 1000000 in
private theorem doubleSwap_word : ∀ i : Fin 128,
    (sylowWord i).cycleType = (kleinFirst 8 (by decide)).cycleType → ∃ j : Fin 16,
      dWords j = sylowWord i ∨ exceptionalWords j = sylowWord i ∨
        (MulAut.conj halfSwap) (exceptionalWords j) = sylowWord i := by decide +kernel

theorem doubleSwap_mem_D_or_exceptional {s : Perm} (hs : s ∈ canonicalSylow)
    (hd : IsConj (kleinFirst 8 (by decide)) s) :
    s ∈ D 8 ∨ s ∈ exceptional 8 (by decide) ∨ s ∈ oppositeExceptional := by
  obtain ⟨i, rfl⟩ := (mem_canonicalTwoSubgroup s).mp hs
  obtain ⟨j, hj | hj | hj⟩ := doubleSwap_word i
    (Equiv.Perm.isConj_iff_cycleType_eq.mp hd).symm
  · exact Or.inl ((mem_D_iff _).mpr ⟨j, hj⟩)
  · exact Or.inr (Or.inl ((mem_exceptional_iff _).mpr ⟨j, hj⟩))
  · exact Or.inr (Or.inr (Subgroup.mem_map.mpr
      ⟨exceptionalWords j, (mem_exceptional_iff _).mpr ⟨j, rfl⟩, hj⟩))

end CFSG.Quasithin.ChapterB.Offenders.Eight
