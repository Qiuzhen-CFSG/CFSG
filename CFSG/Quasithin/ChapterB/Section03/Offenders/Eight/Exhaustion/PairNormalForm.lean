module

public import CFSG.Quasithin.ChapterB.Section03.Offenders.Defs
public import CFSG.Quasithin.ChapterB.Section03.Offenders.FixedTests
import Mathlib.GroupTheory.Perm.Cycle.Type
import Mathlib.Data.Set.Card

/-!
# Normal form for independent pair flips

A permutation subgroup with singleton or pair orbits, containing the swap of
any two points in an orbit, is conjugate to the standard group `A_m`.

Choose the involution that exchanges the points of every pair orbit. Support
induction recovers the original subgroup as the group generated by its
individual swaps. The involution has cycle type consisting of `m` copies of
`2`, so cycle-type conjugacy identifies it with the standard product of `m`
adjacent swaps. Conjugating their generated groups gives the required normal
form, with the conjugacy orientation of `IsConjugateTo`.

The small finite checks concern only the five standard representatives in degree
eight; subgroup generation and conjugacy are proved structurally. This adapts
the proof in `Offenders.Odd.FullClassification.PairNormalForm`, preserving that
module and its public interface.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
1 March 2004 manuscript, Proposition B.3.2(1), printed pp. 83–84.
-/

public section

namespace CFSG.Quasithin.ChapterB.Offenders.EightExhaustion
open Equiv

private theorem orbit_eq_pair {n : ℕ} (A : Subgroup (Perm (Fin n)))
    (hsmall : ∀ x : Fin n, Nat.card (MulAction.orbit A x) ≤ 2)
    {x y : Fin n} (hy : y ∈ MulAction.orbit A x) (hne : y ≠ x) :
    MulAction.orbit A x = {x, y} := by
  symm
  apply Set.eq_of_subset_of_ncard_le (ht := Set.toFinite _)
  · intro z hz
    rcases hz with rfl | hz
    · exact MulAction.mem_orbit_self _
    · rcases hz with rfl; exact hy
  · simpa only [Set.ncard_pair (Ne.symm hne), ← Nat.card_coe_set_eq] using hsmall x

private theorem exists_orbit_involution {n : ℕ} (A : Subgroup (Perm (Fin n)))
    (hsmall : ∀ x : Fin n, Nat.card (MulAction.orbit A x) ≤ 2) :
    ∃ t : Perm (Fin n), t ^ 2 = 1 ∧
      ∀ x y, y ∈ MulAction.orbit A x ↔ y = x ∨ y = t x := by
  classical
  let f : Fin n → Fin n := fun x =>
    if h : ∃ y, y ∈ MulAction.orbit A x ∧ y ≠ x then h.choose else x
  have hf (x : Fin n) : f x ∈ MulAction.orbit A x := by
    dsimp [f]
    split_ifs with h
    · exact h.choose_spec.1
    · exact MulAction.mem_orbit_self _
  have hfne (x : Fin n) (h : ∃ y, y ∈ MulAction.orbit A x ∧ y ≠ x) : f x ≠ x := by
    simpa [f, h] using h.choose_spec.2
  have horb (x y : Fin n) : y ∈ MulAction.orbit A x ↔ y = x ∨ y = f x := by
    by_cases h : ∃ y, y ∈ MulAction.orbit A x ∧ y ≠ x
    · rw [orbit_eq_pair A hsmall (hf x) (hfne x h)]
      simp
    · have he : f x = x := by simp [f, h]
      rw [he, or_self]
      exact ⟨fun hy => Classical.byContradiction (fun hn => h ⟨y, hy, hn⟩),
        fun hy => hy ▸ MulAction.mem_orbit_self _⟩
  have hinv : Function.Involutive f := by
    intro x
    by_cases h : f x = x
    · rw [h, h]
    · have hx : x ∈ MulAction.orbit A (f x) := MulAction.mem_orbit_symm.mpr (hf x)
      exact ((horb (f x) x).mp hx).resolve_left (Ne.symm h) |>.symm
  refine ⟨hinv.toPerm, ?_, horb⟩
  apply Equiv.ext
  intro x
  exact hinv x

private def flipGroup {n : ℕ} (t : Perm (Fin n)) : Subgroup (Perm (Fin n)) :=
  Subgroup.closure {p | ∃ x, t x ≠ x ∧ p = swap x (t x)}

private theorem swap_mem_flipGroup {n : ℕ} (t : Perm (Fin n)) (x : Fin n) :
    swap x (t x) ∈ flipGroup t := by
  classical
  by_cases h : t x = x
  · rw [h, swap_self]; exact (flipGroup t).one_mem
  · exact Subgroup.subset_closure ⟨x, h, rfl⟩

private theorem eq_flipGroup {n : ℕ} (A : Subgroup (Perm (Fin n))) (t : Perm (Fin n))
    (horb : ∀ x y, y ∈ MulAction.orbit A x ↔ y = x ∨ y = t x)
    (hswap : ∀ x y : Fin n, y ∈ MulAction.orbit A x → swap x y ∈ A) :
    A = flipGroup t := by
  classical
  apply le_antisymm
  · intro p hp
    have hgen : ∀ q ∈ A, ∀ x, swap x (q x) ∈ flipGroup t := by
      intro q hq x
      rcases (horb x (q x)).mp (MulAction.mem_orbit x (⟨q, hq⟩ : A)) with hx | hx
      · rw [hx, swap_self]; exact (flipGroup t).one_mem
      · rw [hx]; exact swap_mem_flipGroup t x
    suffices ∀ k, ∀ q ∈ A, q.support.card = k → q ∈ flipGroup t from this _ p hp rfl
    intro k
    induction k using Nat.strong_induction_on with
    | h k ih =>
      intro q hq hk
      by_cases hq1 : q = 1
      · simp [hq1]
      obtain ⟨x, hx⟩ : ∃ x, q x ≠ x := by
        by_contra! h
        exact hq1 (Equiv.ext h)
      have hswA : swap x (q x) ∈ A := hswap x (q x)
        (MulAction.mem_orbit x (⟨q, hq⟩ : A))
      have hlt := Perm.card_support_swap_mul hx
      have hmem := ih _ (hk ▸ hlt) (swap x (q x) * q) (A.mul_mem hswA hq) rfl
      exact ((flipGroup t).mul_mem_cancel_left (hgen q hq x)).mp hmem
  · apply (Subgroup.closure_le _).mpr
    rintro p ⟨x, hx, rfl⟩
    exact hswap x (t x) ((horb x (t x)).mpr (Or.inr rfl))

private theorem flipGroup_conj {n : ℕ} (t g : Perm (Fin n)) :
    flipGroup (g * t * g⁻¹) = (flipGroup t).map (MulAut.conj g).toMonoidHom := by
  classical
  rw [flipGroup, flipGroup, MonoidHom.map_closure]
  congr 1
  ext p
  constructor
  · rintro ⟨x, hx, rfl⟩
    refine ⟨swap (g⁻¹ x) (t (g⁻¹ x)), ⟨g⁻¹ x, ?_, rfl⟩, ?_⟩
    · intro he
      apply hx
      change g (t (g⁻¹ x)) = x
      rw [he]
      exact g.apply_symm_apply x
    · simp [MulAut.conj_apply, ← swap_apply_apply]
  · rintro ⟨p, ⟨x, hx, rfl⟩, rfl⟩
    refine ⟨g x, ?_, ?_⟩
    · simpa using hx
    · simp [MulAut.conj_apply, ← swap_apply_apply]

private def standardFlip (n m : ℕ) : Perm (Fin n) :=
  (List.ofFn fun i : Fin (n / 2) => if i.val < m then pairSwap n i else 1).prod

private theorem standardFlip_cycleType {n m : ℕ} (hn : n = 8)
    (hm : m ≤ n / 2) : (standardFlip n m).cycleType = Multiset.replicate m 2 := by
  subst n; interval_cases m <;> decide

private theorem flipGroup_standardFlip {n m : ℕ} (hn : n = 8)
    (hm : m ≤ n / 2) : flipGroup (standardFlip n m) = disjointTranspositions n m := by
  have hf : ∀ x, standardFlip n m x ≠ x → ∃ i : Fin (n / 2),
      i.val < m ∧ swap x (standardFlip n m x) = pairSwap n i := by
    subst n; interval_cases m <;> decide
  have hr : ∀ i : Fin (n / 2), i.val < m → ∃ x,
      standardFlip n m x ≠ x ∧ pairSwap n i = swap x (standardFlip n m x) := by
    subst n; interval_cases m <;> decide
  unfold flipGroup disjointTranspositions
  congr 1
  ext p
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact hf x hx
  · rintro ⟨i, hi, rfl⟩
    exact hr i hi

/-- Independent swaps on singleton and pair orbits give precisely the family `A_m`. -/
theorem caseAFamily_of_pair_orbits {n : ℕ} (hn : n = 8)
    (A : Subgroup (Perm (Fin n))) (hA : A ≠ ⊥)
    (hsmall : ∀ x : Fin n, Nat.card (MulAction.orbit A x) ≤ 2)
    (hswap : ∀ x y : Fin n, y ∈ MulAction.orbit A x → swap x y ∈ A) :
    CaseAFamily n A := by
  classical
  obtain ⟨t, ht, horb⟩ := exists_orbit_involution A hsmall
  have hAt : A = flipGroup t := eq_flipGroup A t horb hswap
  have ht1 : t ≠ 1 := by
    intro he
    apply hA
    rw [hAt, he]
    simp [flipGroup]
  let m := t.cycleType.card
  have hm0 : 1 ≤ m := Perm.card_cycleType_pos.mpr ht1
  have htype : t.cycleType = Multiset.replicate m 2 :=
    Perm.cycleType_of_pow_prime_eq_one ht
  have hm : m ≤ n / 2 := by
    have h := t.sum_cycleType_le
    rw [htype, Multiset.sum_replicate] at h
    simp only [nsmul_eq_mul, Nat.cast_id, Fintype.card_fin] at h
    omega
  have hc : IsConj (standardFlip n m) t := Perm.isConj_iff_cycleType_eq.mpr
    ((standardFlip_cycleType hn hm).trans htype.symm)
  obtain ⟨g, hg⟩ := isConj_iff.mp hc
  refine ⟨m, hm0, hm, g, ?_⟩
  rw [hAt, ← hg, flipGroup_conj, flipGroup_standardFlip hn hm]

end CFSG.Quasithin.ChapterB.Offenders.EightExhaustion
