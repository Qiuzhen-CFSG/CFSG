module
public import CFSG.Quasithin.ChapterB.Section03.Offenders.Defs
public import Theory.Representation.BinaryPermutation.FiveDihedralRecognition
public import Theory.GroupTheory.PGroup.DihedralSquareAutomorphisms
import Mathlib.Tactic.FinCases

/-!
# The five-point disjoint-transposition action and dihedral recognition

The exact group `Offenders.D 5` is generated by (0 1) and (2 3), so the
intrinsic five-core recognition theorem applies to the original action.
Its second wrapper applies the proved odd-automorphism theorem to the
literal ambient normalizer and every subgroup above the embedded center.

Source: Aschbacher–Smith, Lemma 5.1.7(1), printed pp.633–634. In that
application S is Baum(T), V is the A5 core, C is C_S(L), and W is Q^g.
The earlier source argument supplies centrality, the kernel, elementary W,
and generation; the decomposition is proved here from those data.
-/

namespace CFSG.Quasithin.ChapterB.Offenders
open Subgroup BinaryPermutation

private theorem D_five_eq_pair_closure : D 5 =
    closure ({Equiv.swap 0 1, Equiv.swap 2 3} : Set (Equiv.Perm (Fin 5))) := by
  apply congrArg Subgroup.closure
  ext g
  constructor
  · rintro ⟨i, _, rfl⟩
    fin_cases i <;> simp [pairSwap]
  · intro hg
    rcases hg with rfl | hg
    · exact ⟨0, by decide, rfl⟩
    · have hg : g = Equiv.swap 2 3 := hg
      subst g
      exact ⟨1, by decide, rfl⟩

/-- Recognition with the literal disjoint-transposition group from B.3.2. -/
public theorem dihedral_square_of_core_action {S : Type*} [Group S]
    (V C W : Subgroup S) [IsElementaryAbelian 2 W]
    (hCZ : C ≤ center S) (hd : Disjoint V C)
    (q : S →* Equiv.Perm (Fin 5)) (hr : q.range = D 5)
    (hk : q.ker = V ⊔ C) (hgen : V ⊔ C ⊔ W = ⊤)
    (m : Multiplicative (core (Fin 5)) ≃* V)
    (he : ∀ (s : S) (x : core (Fin 5)),
      (m (.ofAdd (coreRepresentation (Fin 5) (q s) x)) : S) =
        s * (m (.ofAdd x) : S) * s⁻¹) :
    Nonempty (S ≃* C × (DihedralGroup 4 × DihedralGroup 4)) :=
  FiveCoreDihedralSquare.recognize V C W hCZ hd q (hr.trans D_five_eq_pair_closure)
    hk hgen m he
/-- The literal normalizer's two-residual preserves every subgroup above the
embedded center, with the two-dihedral decomposition constructed from the
marked action rather than supplied as an extra witness. -/
public theorem pResidual_normalizer_le_of_core_action
    {G : Type*} [Group G] [Finite G] (S Q : Subgroup G)
    (V C W : Subgroup S) [IsElementaryAbelian 2 W] [IsElementaryAbelian 2 C]
    (hCZ : C ≤ center S) (hd : Disjoint V C)
    (q : S →* Equiv.Perm (Fin 5)) (hr : q.range = D 5)
    (hk : q.ker = V ⊔ C) (hgen : V ⊔ C ⊔ W = ⊤)
    (m : Multiplicative (core (Fin 5)) ≃* V)
    (he : ∀ (s : S) (x : core (Fin 5)),
      (m (.ofAdd (coreRepresentation (Fin 5) (q s) x)) : S) =
        s * (m (.ofAdd x) : S) * s⁻¹)
    (hQS : Q ≤ S) (hZ : (center S).map S.subtype ≤ Q) :
    (pResidual 2 (normalizer (S : Set G))).map (normalizer (S : Set G)).subtype ≤
      normalizer (Q : Set G) := by
  obtain ⟨e⟩ := dihedral_square_of_core_action V C W hCZ hd q hr hk hgen m he
  exact pResidual_normalizer_le_normalizer_of_dihedral_square S Q e hQS hZ
end CFSG.Quasithin.ChapterB.Offenders
