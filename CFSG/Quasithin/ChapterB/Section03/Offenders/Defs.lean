module

public import Theory.Representation.BinaryPermutation
public import Theory.Representation.BinaryOffender.Basic
public import Mathlib.GroupTheory.SpecificGroups.Alternating

/-!
# The subgroup families in Proposition B.3.2

We use zero-based coordinates for the disjoint transpositions `(0 1), (2 3), …`.
The exceptional group replaces the first two transpositions by the regular
Klein four group on the first four points. Hyperplanes are defined by the cover
relation in the subgroup lattice, so none of the hyperplanes omitted in
Aschbacher's earlier list are lost.

These are concrete subgroup definitions, not assumptions about offenders.
The classification and dimension calculations are developed separately.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
1 March 2004 manuscript, Proposition B.3.2, printed pp. 83–84.
-/

@[expose] public section

namespace CFSG.Quasithin.ChapterB.Offenders

open Representation.BinaryOffender

/-- The `i`th disjoint transposition, with zero-based indexing. -/
def pairSwap (n : ℕ) (i : Fin (n / 2)) : Equiv.Perm (Fin n) :=
  Equiv.swap ⟨2 * i.val, by omega⟩ ⟨2 * i.val + 1, by omega⟩

/-- The group `A_m` generated by the first `m` disjoint transpositions.
The classification uses `1 ≤ m ≤ n / 2`; the definition also allows `m = 0`. -/
def disjointTranspositions (n m : ℕ) : Subgroup (Equiv.Perm (Fin n)) :=
  Subgroup.closure {g | ∃ i : Fin (n / 2), i.val < m ∧ g = pairSwap n i}

/-- The full disjoint-transposition group `D`. -/
abbrev D (n : ℕ) : Subgroup (Equiv.Perm (Fin n)) :=
  disjointTranspositions n (n / 2)

/-- The first Klein-four generator `(0 1)(2 3)`. -/
def kleinFirst (n : ℕ) (hn : 4 ≤ n) : Equiv.Perm (Fin n) :=
  Equiv.swap ⟨0, by omega⟩ ⟨1, by omega⟩ *
    Equiv.swap ⟨2, by omega⟩ ⟨3, by omega⟩

/-- The second Klein-four generator `(0 2)(1 3)`. -/
def kleinSecond (n : ℕ) (hn : 4 ≤ n) : Equiv.Perm (Fin n) :=
  Equiv.swap ⟨0, by omega⟩ ⟨2, by omega⟩ *
    Equiv.swap ⟨1, by omega⟩ ⟨3, by omega⟩

/-- The exceptional group `A_0`, with Klein-four action on the first four points. -/
def exceptional (n : ℕ) (hn : 4 ≤ n) : Subgroup (Equiv.Perm (Fin n)) :=
  Subgroup.closure ({kleinFirst n hn, kleinSecond n hn} ∪
    {g | ∃ i : Fin (n / 2), 2 ≤ i.val ∧ g = pairSwap n i})

/-- The even part `D ∩ A_n`. -/
def evenPart (n : ℕ) : Subgroup (Equiv.Perm (Fin n)) :=
  D n ⊓ alternatingGroup (Fin n)

/-- Conjugacy of an ambient subgroup to a specified representative. -/
def IsConjugateTo {n : ℕ} (A B : Subgroup (Equiv.Perm (Fin n))) : Prop :=
  ∃ g : Equiv.Perm (Fin n), A = B.map (MulAut.conj g).toMonoidHom

/-- The disjoint-transposition family in case (a) of B.3.2. -/
def CaseAFamily (n : ℕ) (A : Subgroup (Equiv.Perm (Fin n))) : Prop :=
  ∃ m, 1 ≤ m ∧ m ≤ n / 2 ∧ IsConjugateTo A (disjointTranspositions n m)

/-- The hyperplane family `H`, with `D ∩ A_n` listed separately as in the source. -/
def HyperplaneFamily (n : ℕ) (A : Subgroup (Equiv.Perm (Fin n))) : Prop :=
  ∃ B, B ⋖ D n ∧ B ≠ evenPart n ∧ IsConjugateTo A B

/-- The family in case (b), before the additional degree-eight regular groups. -/
def CaseBFamily (n : ℕ) (hn : 4 ≤ n) (A : Subgroup (Equiv.Perm (Fin n))) : Prop :=
  CaseAFamily n A ∨ IsConjugateTo A (exceptional n hn) ∨
    IsConjugateTo A (evenPart n) ∨ HyperplaneFamily n A

/-- The additional regular `E_8` groups of B.3.2(3),(6).
Regularity is stated directly as existence of a unique transporter. -/
def IsRegularEight (A : Subgroup (Equiv.Perm (Fin 8))) : Prop :=
  IsElementaryTwo A ∧ Nat.card A = 8 ∧ A ≤ alternatingGroup (Fin 8) ∧
    ∀ x y : Fin 8, ∃! a : A, a.val x = y

theorem pairSwap_mem {n m : ℕ} (i : Fin (n / 2)) (hi : i.val < m) :
    pairSwap n i ∈ disjointTranspositions n m :=
  Subgroup.subset_closure ⟨i, hi, rfl⟩

theorem disjointTranspositions_mono {n a b : ℕ} (h : a ≤ b) :
    disjointTranspositions n a ≤ disjointTranspositions n b := by
  apply Subgroup.closure_mono
  rintro g ⟨i, hi, rfl⟩
  exact ⟨i, hi.trans_le h, rfl⟩

@[simp] theorem disjointTranspositions_zero (n : ℕ) :
    disjointTranspositions n 0 = ⊥ := by
  simp [disjointTranspositions]

theorem disjointTranspositions_le_D (n m : ℕ) :
    disjointTranspositions n m ≤ D n := by
  apply Subgroup.closure_mono
  rintro g ⟨i, _, rfl⟩
  exact ⟨i, i.isLt, rfl⟩

theorem IsConjugateTo.refl {n : ℕ} (A : Subgroup (Equiv.Perm (Fin n))) :
    IsConjugateTo A A := by
  refine ⟨1, ?_⟩
  change A = A.map (MonoidHom.id _)
  simp

theorem caseAFamily_disjointTranspositions {n m : ℕ} (hm : 1 ≤ m) (hmn : m ≤ n / 2) :
    CaseAFamily n (disjointTranspositions n m) :=
  ⟨m, hm, hmn, IsConjugateTo.refl _⟩

end CFSG.Quasithin.ChapterB.Offenders
