module

public import CFSG.Quasithin.ChapterB.Section03.Offenders.Six
public import CFSG.Quasithin.ChapterB.Section03.Offenders.Odd
public import CFSG.Quasithin.ChapterB.Section03.Offenders.Eight.Complete

/-!
# Subgroups generated by binary permutation offenders

In case (a), all offenders in a Sylow containing `D` lie in `D`, which is itself
an offender. For the degree-six core and natural modules, `D` and the exceptional
offender generate the entire canonical Sylow. In degree eight the core gives
`D` together with all double transpositions in the Sylow; the regular elementary
eight group supplies the remaining generators for the natural module.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
Proposition B.3.2(4)–(6), printed pp. 83–84.
-/

public section
namespace CFSG.Quasithin.ChapterB.Offenders
open BinaryPermutation Representation.BinaryOffender

private theorem member_le_generated {G : Type*} [Group G]
    {P : Set (Subgroup G)} {A T : Subgroup G} (hA : A ∈ P) (hAT : A ≤ T) :
    A ≤ generatedBy P T := le_iSup_of_le A (le_iSup_of_le ⟨hA, hAT⟩ le_rfl)

private theorem generated_le {G : Type*} [Group G]
    {P : Set (Subgroup G)} {T K : Subgroup G}
    (h : ∀ A, A ∈ P → A ≤ T → A ≤ K) : generatedBy P T ≤ K :=
  iSup_le fun A => iSup_le fun hA => h A hA.1 hA.2

private theorem generated_eq {G : Type*} [Group G]
    {P : Set (Subgroup G)} {T K : Subgroup G} (hK : K ∈ P) (hKT : K ≤ T)
    (h : ∀ A, A ∈ P → A ≤ T → A ≤ K) : generatedBy P T = K :=
  le_antisymm (generated_le h) (member_le_generated hK hKT)

namespace Odd

theorem generatedBy_full {n : ℕ} (hn : n = 5 ∨ n = 7)
    (T : Sylow 2 (Equiv.Perm (Fin n))) (hD : D n ≤ T) :
    generatedBy {A | IsBestOffender (representation (Fin n)) A} T = D n := by
  apply generated_eq
    ((isBestOffender_full_iff_caseAFamily hn _).mpr
      (caseAFamily_disjointTranspositions (by rcases hn with rfl | rfl <;> decide) le_rfl)) hD
  intro A hA hAT
  exact caseAFamily_le_D_of_le_sylow hn T hD
    ((isBestOffender_full_iff_caseAFamily hn A).mp hA) hAT

theorem generatedBy_core {n : ℕ} (hn : n = 5 ∨ n = 7)
    (T : Sylow 2 (Equiv.Perm (Fin n))) (hD : D n ≤ T) :
    generatedBy {A | IsBestOffender (coreRepresentation (Fin n)) A} T = D n := by
  simpa only [isBestOffender_core_iff_full hn] using generatedBy_full hn T hD

theorem generatedBy_deleted {n : ℕ} (hn : n = 5 ∨ n = 7)
    (T : Sylow 2 (Equiv.Perm (Fin n))) (hD : D n ≤ T) :
    generatedBy {A | IsBestOffender (deletedRepresentation (Fin n)) A} T = D n := by
  simpa only [isBestOffender_deleted_iff_full hn] using generatedBy_full hn T hD

theorem generatedBy_natural {n : ℕ} (hn : n = 5 ∨ n = 7)
    (T : Sylow 2 (Equiv.Perm (Fin n))) (hD : D n ≤ T) :
    generatedBy {A | IsBestOffender (naturalRepresentation (Fin n)) A} T = D n := by
  simpa only [isBestOffender_natural_iff_full hn] using generatedBy_full hn T hD

end Odd

namespace Six

theorem generatedBy_full :
    generatedBy {A | IsBestOffender (representation (Fin 6)) A} sylowCarrier = D 6 := by
  apply generated_eq ((isBestOffender_full_iff _).mpr
    (caseAFamily_disjointTranspositions (by decide) (by decide))) D_le_sylowCarrier
  intro A hA hAT
  exact caseAFamily_le_D_of_le_sylowCarrier ((isBestOffender_full_iff A).mp hA) hAT

theorem generatedBy_deleted :
    generatedBy {A | IsBestOffender (deletedRepresentation (Fin 6)) A} sylowCarrier = D 6 := by
  simpa only [isBestOffender_deleted_iff, isBestOffender_full_iff] using generatedBy_full

theorem generatedBy_core :
    generatedBy {A | IsBestOffender (coreRepresentation (Fin 6)) A} sylowCarrier =
      sylowCarrier := by
  apply le_antisymm (generated_le (fun _ _ h => h))
  apply sup_le
  · exact member_le_generated ((isBestOffender_core_iff _).mpr
      (Or.inl (caseAFamily_disjointTranspositions (by decide) (by decide)))) D_le_sylowCarrier
  · exact member_le_generated ((isBestOffender_core_iff _).mpr
      (Or.inr (Or.inl (IsConjugateTo.refl _)))) exceptional_le_sylowCarrier

theorem generatedBy_natural :
    generatedBy {A | IsBestOffender (naturalRepresentation (Fin 6)) A} sylowCarrier =
      sylowCarrier := by
  simpa only [isBestOffender_natural_iff, isBestOffender_core_iff] using generatedBy_core

/-- In degree six the source's double-transposition formula equals the whole Sylow. -/
theorem D_sup_doubleSwaps :
    D 6 ⊔ Subgroup.closure {s | IsConj (kleinFirst 6 (by decide)) s ∧ s ∈ sylowCarrier} =
      sylowCarrier := by
  apply le_antisymm
  · exact sup_le D_le_sylowCarrier ((Subgroup.closure_le _).mpr (fun _ h => h.2))
  · apply sup_le le_sup_left
    apply (Subgroup.closure_le _).mpr
    rintro s ((rfl | hs) | ⟨i, _, rfl⟩)
    · exact Subgroup.mem_sup_right (Subgroup.subset_closure
        ⟨IsConj.refl _, exceptional_le_sylowCarrier (Subgroup.subset_closure (Or.inl (Or.inl rfl)))⟩)
    · rw [Set.mem_singleton_iff] at hs
      subst s
      exact Subgroup.mem_sup_right (Subgroup.subset_closure
        ⟨Equiv.Perm.isConj_of_cycleType_eq (by decide +kernel),
          exceptional_le_sylowCarrier (Subgroup.subset_closure
            (Or.inl (Or.inr (Set.mem_singleton _))))⟩)
    · exact Subgroup.mem_sup_left (pairSwap_mem i i.isLt)

theorem generatedBy_core_source :
    generatedBy {A | IsBestOffender (coreRepresentation (Fin 6)) A} sylowCarrier =
      D 6 ⊔ Subgroup.closure {s | IsConj (kleinFirst 6 (by decide)) s ∧ s ∈ sylowCarrier} := by
  rw [generatedBy_core, D_sup_doubleSwaps]

theorem generatedBy_natural_source :
    generatedBy {A | IsBestOffender (naturalRepresentation (Fin 6)) A} sylowCarrier =
      D 6 ⊔ Subgroup.closure {s | IsConj (kleinFirst 6 (by decide)) s ∧ s ∈ sylowCarrier} := by
  rw [generatedBy_natural, D_sup_doubleSwaps]

end Six

namespace Eight

theorem generatedBy_full :
    generatedBy {A | IsBestOffender (representation (Fin 8)) A} canonicalSylow = D 8 := by
  apply generated_eq (isBestOffender_full_of_caseAFamily
    (caseAFamily_disjointTranspositions (by decide) (by decide))) D_le_canonicalSylow
  exact fun _ hA hAT => bestOffender_full_le_D canonicalSylow.isPGroup' D_le_canonicalSylow hAT hA

theorem generatedBy_deleted :
    generatedBy {A | IsBestOffender (deletedRepresentation (Fin 8)) A} canonicalSylow = D 8 := by
  simpa only [isBestOffender_deleted_iff, isBestOffender_full_iff] using generatedBy_full

theorem generatedBy_core :
    generatedBy {A | IsBestOffender (coreRepresentation (Fin 8)) A} canonicalSylow =
      D 8 ⊔ Subgroup.closure {s | IsConj (kleinFirst 8 (by decide)) s ∧ s ∈ canonicalSylow} := by
  apply le_antisymm
  · exact generated_le (fun _ hA hAT => bestOffender_core_le_D_sup_doubleSwaps
      canonicalSylow.isPGroup' D_le_canonicalSylow hAT hA)
  · apply sup_le
    · exact member_le_generated (isBestOffender_core_of_caseAFamily
        (caseAFamily_disjointTranspositions (by decide) (by decide))) D_le_canonicalSylow
    · apply (Subgroup.closure_le _).mpr
      rintro s ⟨hd, hs⟩
      obtain ⟨A, hsA, hAT, hA, _⟩ := doubleSwap_mem_bestOffender hs hd
      exact member_le_generated hA hAT hsA

theorem generatedBy_natural :
    generatedBy {A | IsBestOffender (naturalRepresentation (Fin 8)) A} canonicalSylow =
      (canonicalSylow : Subgroup Perm) := by
  apply le_antisymm (generated_le (fun _ _ h => h))
  apply canonicalSylow_le_of_D_exceptional_regular
  · exact member_le_generated (isBestOffender_natural_of_caseAFamily
      (caseAFamily_disjointTranspositions (by decide) (by decide))) D_le_canonicalSylow
  · exact member_le_generated isBestOffender_exceptional_natural exceptional_le_canonicalSylow
  · exact member_le_generated isBestOffender_natural_standardRegular standardRegular_le_canonicalSylow

end Eight
end CFSG.Quasithin.ChapterB.Offenders
