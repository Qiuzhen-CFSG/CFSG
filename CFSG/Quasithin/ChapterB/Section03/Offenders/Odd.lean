module

public import CFSG.Quasithin.ChapterB.Section03.Offenders.Defs
public import CFSG.Quasithin.ChapterB.Section03.Offenders.FixedTests
public import CFSG.Quasithin.ChapterB.Section03.Offenders.Odd.Representatives
public import CFSG.Quasithin.ChapterB.Section03.Offenders.Odd.FullClassification
public import CFSG.Quasithin.ChapterB.Section03.Offenders.Odd.Sylow
public import Theory.Representation.BinaryPermutation.OddOffenderTransport

/-!
# Binary permutation offenders in degrees five and seven

The four modules have identical fixed codimensions for every subgroup in odd
degree. Thus best offending and strong offending transfer between them.
The concrete disjoint-transposition groups have rank and fixed codimension
`m` on all four modules, as required by B.3.2(1).

The orbit bound excludes strong offenders. Its equality cases are exactly the
conjugates of `A_m`, giving the exhaustive best-offender classification on all
four modules. The Sylow containment result is re-exported for the parent’s
assembly of the subgroup generated by best offenders.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
1 March 2004 manuscript, Proposition B.3.2, printed pp. 83–84.
-/

public section

namespace CFSG.Quasithin.ChapterB.Offenders.Odd

open BinaryPermutation Representation.BinaryOffender
open Representation.BinaryOffender.OddTransport

private theorem odd_card {n : ℕ} (hn : n = 5 ∨ n = 7) :
    Odd (Fintype.card (Fin n)) := by
  rcases hn with rfl | rfl <;> decide

/-- Passing to the core preserves best offending in the odd degrees. -/
theorem isBestOffender_core_iff_full {n : ℕ} (hn : n = 5 ∨ n = 7)
    (A : Subgroup (Equiv.Perm (Fin n))) :
    IsBestOffender (coreRepresentation (Fin n)) A ↔
      IsBestOffender (representation (Fin n)) A :=
  isBestOffender_iff_of_fixedCodim_eq _ _
    (fixedCodim_core_eq_full_odd (Fin n) (odd_card hn)) A

/-- Passing to the deleted module preserves best offending in the odd degrees. -/
theorem isBestOffender_deleted_iff_full {n : ℕ} (hn : n = 5 ∨ n = 7)
    (A : Subgroup (Equiv.Perm (Fin n))) :
    IsBestOffender (deletedRepresentation (Fin n)) A ↔
      IsBestOffender (representation (Fin n)) A :=
  isBestOffender_iff_of_fixedCodim_eq _ _
    (fixedCodim_deleted_eq_full_odd (Fin n) (odd_card hn)) A

/-- Passing to the natural module preserves best offending in the odd degrees. -/
theorem isBestOffender_natural_iff_full {n : ℕ} (hn : n = 5 ∨ n = 7)
    (A : Subgroup (Equiv.Perm (Fin n))) :
    IsBestOffender (naturalRepresentation (Fin n)) A ↔
      IsBestOffender (representation (Fin n)) A :=
  isBestOffender_iff_of_fixedCodim_eq _ _
    (fixedCodim_natural_eq_full_odd (Fin n) (odd_card hn)) A

/-- Strong offending also transfers between the core and full modules. -/
theorem isStrongOffender_core_iff_full {n : ℕ} (hn : n = 5 ∨ n = 7)
    (A : Subgroup (Equiv.Perm (Fin n))) :
    IsStrongOffender (coreRepresentation (Fin n)) A ↔
      IsStrongOffender (representation (Fin n)) A := by
  rw [IsStrongOffender, IsStrongOffender,
    fixedCodim_core_eq_full_odd (Fin n) (odd_card hn)]

/-- Strong offending also transfers between the deleted and full modules. -/
theorem isStrongOffender_deleted_iff_full {n : ℕ} (hn : n = 5 ∨ n = 7)
    (A : Subgroup (Equiv.Perm (Fin n))) :
    IsStrongOffender (deletedRepresentation (Fin n)) A ↔
      IsStrongOffender (representation (Fin n)) A := by
  rw [IsStrongOffender, IsStrongOffender,
    fixedCodim_deleted_eq_full_odd (Fin n) (odd_card hn)]

/-- Strong offending also transfers between the natural and full modules. -/
theorem isStrongOffender_natural_iff_full {n : ℕ} (hn : n = 5 ∨ n = 7)
    (A : Subgroup (Equiv.Perm (Fin n))) :
    IsStrongOffender (naturalRepresentation (Fin n)) A ↔
      IsStrongOffender (representation (Fin n)) A := by
  rw [IsStrongOffender, IsStrongOffender,
    fixedCodim_natural_eq_full_odd (Fin n) (odd_card hn)]

/-- B.3.2(1) for the core. -/
theorem fixedCodim_core_disjointTranspositions {n m : ℕ} (hn : n = 5 ∨ n = 7)
    (hm : m ≤ n / 2) :
    fixedCodim (coreRepresentation (Fin n)) (disjointTranspositions n m) = m := by
  rw [fixedCodim_core_eq_full_odd (Fin n) (odd_card hn),
    fixedCodim_full_disjointTranspositions hn hm]

/-- B.3.2(1) for the deleted module. -/
theorem fixedCodim_deleted_disjointTranspositions {n m : ℕ} (hn : n = 5 ∨ n = 7)
    (hm : m ≤ n / 2) :
    fixedCodim (deletedRepresentation (Fin n)) (disjointTranspositions n m) = m := by
  rw [fixedCodim_deleted_eq_full_odd (Fin n) (odd_card hn),
    fixedCodim_full_disjointTranspositions hn hm]

/-- B.3.2(1) for the natural module. -/
theorem fixedCodim_natural_disjointTranspositions {n m : ℕ} (hn : n = 5 ∨ n = 7)
    (hm : m ≤ n / 2) :
    fixedCodim (naturalRepresentation (Fin n)) (disjointTranspositions n m) = m := by
  rw [fixedCodim_natural_eq_full_odd (Fin n) (odd_card hn),
    fixedCodim_full_disjointTranspositions hn hm]

/-- Every nontrivial `A_m` is an offender on all four modules. -/
theorem isOffender_disjointTranspositions {n m : ℕ} (hn : n = 5 ∨ n = 7)
    (hm0 : 1 ≤ m) (hm : m ≤ n / 2) :
    IsOffender (representation (Fin n)) (disjointTranspositions n m) ∧
    IsOffender (coreRepresentation (Fin n)) (disjointTranspositions n m) ∧
    IsOffender (deletedRepresentation (Fin n)) (disjointTranspositions n m) ∧
    IsOffender (naturalRepresentation (Fin n)) (disjointTranspositions n m) := by
  have he := isElementaryTwo_disjointTranspositions hn hm0 hm
  simp only [IsOffender, he, rank_disjointTranspositions hn hm,
    fixedCodim_full_disjointTranspositions hn hm, fixedCodim_core_disjointTranspositions hn hm,
    fixedCodim_deleted_disjointTranspositions hn hm, fixedCodim_natural_disjointTranspositions hn hm,
    le_refl, and_self]

/-- No subgroup is a strong offender on the full module in the odd degrees. -/
theorem not_isStrongOffender_full {n : ℕ} (hn : n = 5 ∨ n = 7)
    (A : Subgroup (Equiv.Perm (Fin n))) :
    ¬ IsStrongOffender (representation (Fin n)) A := by
  rintro ⟨hA, hlt⟩
  exact (not_lt_of_ge (rank_le_fixedCodim_full_of_elementary hn A hA)) hlt

/-- No subgroup is a strong offender on the core in the odd degrees. -/
theorem not_isStrongOffender_core {n : ℕ} (hn : n = 5 ∨ n = 7)
    (A : Subgroup (Equiv.Perm (Fin n))) :
    ¬ IsStrongOffender (coreRepresentation (Fin n)) A :=
  fun hA => not_isStrongOffender_full hn A ((isStrongOffender_core_iff_full hn A).mp hA)

/-- No subgroup is a strong offender on the deleted module in the odd degrees. -/
theorem not_isStrongOffender_deleted {n : ℕ} (hn : n = 5 ∨ n = 7)
    (A : Subgroup (Equiv.Perm (Fin n))) :
    ¬ IsStrongOffender (deletedRepresentation (Fin n)) A :=
  fun hA => not_isStrongOffender_full hn A ((isStrongOffender_deleted_iff_full hn A).mp hA)

/-- No subgroup is a strong offender on the natural module in the odd degrees. -/
theorem not_isStrongOffender_natural {n : ℕ} (hn : n = 5 ∨ n = 7)
    (A : Subgroup (Equiv.Perm (Fin n))) :
    ¬ IsStrongOffender (naturalRepresentation (Fin n)) A :=
  fun hA => not_isStrongOffender_full hn A ((isStrongOffender_natural_iff_full hn A).mp hA)

/-- The full module is not a strong FF-module in the odd degrees. -/
theorem not_isStrongFFModule_full {n : ℕ} (hn : n = 5 ∨ n = 7) :
    ¬ IsStrongFFModule (representation (Fin n)) := by
  rintro ⟨A, hA⟩
  exact not_isStrongOffender_full hn A hA

/-- B.3.2(4), case (a1): the full-module best offenders are exactly case (a). -/
theorem isBestOffender_full_iff_caseAFamily {n : ℕ} (hn : n = 5 ∨ n = 7)
    (A : Subgroup (Equiv.Perm (Fin n))) :
    IsBestOffender (representation (Fin n)) A ↔ CaseAFamily n A := by
  rw [isBestOffender_iff_of_not_strong _ (not_isStrongFFModule_full hn),
    elementary_and_fixedCodim_full_eq_rank_iff_caseAFamily hn]

/-- B.3.2(4), case (a1): the core best offenders are exactly case (a). -/
theorem isBestOffender_core_iff_caseAFamily {n : ℕ} (hn : n = 5 ∨ n = 7)
    (A : Subgroup (Equiv.Perm (Fin n))) :
    IsBestOffender (coreRepresentation (Fin n)) A ↔ CaseAFamily n A :=
  (isBestOffender_core_iff_full hn A).trans (isBestOffender_full_iff_caseAFamily hn A)

/-- B.3.2(4), case (a1): the deleted-module best offenders are exactly case (a). -/
theorem isBestOffender_deleted_iff_caseAFamily {n : ℕ} (hn : n = 5 ∨ n = 7)
    (A : Subgroup (Equiv.Perm (Fin n))) :
    IsBestOffender (deletedRepresentation (Fin n)) A ↔ CaseAFamily n A :=
  (isBestOffender_deleted_iff_full hn A).trans (isBestOffender_full_iff_caseAFamily hn A)

/-- B.3.2(4), case (a1): the natural-module best offenders are exactly case (a). -/
theorem isBestOffender_natural_iff_caseAFamily {n : ℕ} (hn : n = 5 ∨ n = 7)
    (A : Subgroup (Equiv.Perm (Fin n))) :
    IsBestOffender (naturalRepresentation (Fin n)) A ↔ CaseAFamily n A :=
  (isBestOffender_natural_iff_full hn A).trans (isBestOffender_full_iff_caseAFamily hn A)

/-- Every nontrivial `A_m` is a best offender on all four modules. -/
theorem isBestOffender_disjointTranspositions {n m : ℕ} (hn : n = 5 ∨ n = 7)
    (hm0 : 1 ≤ m) (hm : m ≤ n / 2) :
    IsBestOffender (representation (Fin n)) (disjointTranspositions n m) ∧
    IsBestOffender (coreRepresentation (Fin n)) (disjointTranspositions n m) ∧
    IsBestOffender (deletedRepresentation (Fin n)) (disjointTranspositions n m) ∧
    IsBestOffender (naturalRepresentation (Fin n)) (disjointTranspositions n m) := by
  have hA := caseAFamily_disjointTranspositions hm0 hm
  exact ⟨(isBestOffender_full_iff_caseAFamily hn _).mpr hA,
    (isBestOffender_core_iff_caseAFamily hn _).mpr hA,
    (isBestOffender_deleted_iff_caseAFamily hn _).mpr hA,
    (isBestOffender_natural_iff_caseAFamily hn _).mpr hA⟩

end CFSG.Quasithin.ChapterB.Offenders.Odd
