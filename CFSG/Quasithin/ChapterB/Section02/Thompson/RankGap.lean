module
public import CFSG.Quasithin.ChapterB.Section02.Thompson
public import Theory.ElementaryAbelian.Injective
public import Mathlib.GroupTheory.Index

/-!
# Thompson containment across a gap of one in two-rank

If Q lies in S and its two-rank is at most one below that of S, every
maximum elementary subgroup of Q lies in J₁(S). In the equal-rank case
use J₀(S) ≤ J₁(S); in the other case it belongs to the defining family.
An index at most two gives the required rank bound by intersecting a
maximum elementary subgroup of S with Q and counting its cosets.

The source application rules out a moving minimal parabolic whose two-core
is generated by its maximum elementary subgroups and has small Sylow index.

Source: Aschbacher--Smith, B.2.2--3, printed pp.74--75, applied to the
original residual step in15.1.14(1), printed p.1091.
-/

public section
open Subgroup Stellmacher
namespace CFSG.Quasithin.ChapterB
variable {G : Type*} [Group G] [Finite G]

/-- A gap of at most one in two-rank puts J(Q) in J₁(S). -/
theorem maxJ_le_thompson_one_of_rank_gap (Q S : Subgroup G) (hQS : Q ≤ S)
    (hr : 1 < twoRank S) (hgap : twoRank S ≤ twoRank Q + 1) :
    elementaryAbelianMaxJ Q ≤ thompsonJ S 1 := by
  have hle : twoRank Q ≤ twoRank S :=
    Nat.log_mono_right (elementaryAbelianMaxOrder_le_and_j_le_of_eq Q S hQS).1
  by_cases he : twoRank Q = twoRank S
  · have hord : elementaryAbelianMaxOrder Q = elementaryAbelianMaxOrder S := by
      rw [maxOrder_eq_two_pow_rank, maxOrder_eq_two_pow_rank, he]
    exact ((elementaryAbelianMaxOrder_le_and_j_le_of_eq Q S hQS).2 hord).trans
      (by simpa only [thompsonJ_zero] using lemma_B_2_3_1 S (by omega : 0 ≤ 1) hr)
  · apply sSup_le
    intro A hA
    apply le_sSup
    apply (mem_thompsonFamily_iff_rank S A 1).mpr
    refine ⟨hA.1.trans hQS, hA.2.1, ?_⟩
    rw [elementaryAbelianMaxSubgroups_card_eq Q A hA]
    change twoRank Q + 1 = twoRank S
    omega

/-- Relative index at most two increases two-rank by at most one. -/
theorem twoRank_le_add_one_of_relIndex_le_two (Q S : Subgroup G)
    (hi : Q.relIndex S ≤ 2) : twoRank S ≤ twoRank Q + 1 := by
  obtain ⟨A,hA⟩ := elementaryAbelianMaxSubgroups_nonempty S
  let : IsElementaryAbelian 2 A := hA.2.1
  let : IsElementaryAbelian 2 ↥(A ⊓ Q) := IsElementaryAbelian.of_injective
    (Subgroup.inclusion (show A ⊓ Q ≤ A from inf_le_left)) (Subgroup.inclusion_injective _)
  obtain ⟨B,hB⟩ := elementaryAbelianMaxSubgroups_nonempty Q
  have hcard : Nat.card ↥(A ⊓ Q) ≤ elementaryAbelianMaxOrder Q := by
    rw [← elementaryAbelianMaxSubgroups_card_eq Q B hB]
    exact hB.2.2 _ inf_le_right inferInstance
  have hidx : Q.relIndex A ≤ 2 :=
    (Subgroup.relIndex_le_of_le_right hA.1
      (Subgroup.index_ne_zero_of_finite (H := Q.subgroupOf S))).trans hi
  have he := Subgroup.relIndex_mul_relIndex (⊥ : Subgroup G) (A ⊓ Q) A
    bot_le inf_le_left
  simp only [Subgroup.relIndex_bot_left, Subgroup.inf_relIndex_left] at he
  have hp : 2 ^ twoRank S ≤ 2 ^ (twoRank Q + 1) := by
    rw [← maxOrder_eq_two_pow_rank, ← elementaryAbelianMaxSubgroups_card_eq S A hA, ← he,
      pow_add, pow_one, ← maxOrder_eq_two_pow_rank]
    exact Nat.mul_le_mul hcard hidx
  exact (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mp hp

end CFSG.Quasithin.ChapterB
