module
public import CFSG.Quasithin.ChapterB.Section02.Thompson
public import CFSG.Quasithin.ChapterB.Section02.RankLifting
public import Theory.Representation.NormalElementaryQuotient
public import Theory.GroupAction.NormalPChiefSeries.FixedCodimension
public import Theory.Representation.BinaryOffender.EquivariantOffender
public import Theory.GroupTheory.OddPrimeSectionCentralizers.FullCentralizer

/-!
# Near-maximum elementary actors in a faithful normal action

The rank comparison of B.2.4 bounds the fixed codimension of the literal
image of a near-maximum elementary subgroup by its image rank plus one.
If X = [X,J₁(S)] moves a normal odd p-subgroup, some such elementary
subgroup contains a moving involution. The rank-two section centralizer
theorem makes its fixed p-subgroup cyclic. The prime-rank hypothesis
stays on the original cover, while the action uses its exact centralizer
quotient; no arbitrary quotient-rank comparison is used.

Source: Aschbacher–Smith B.2.4(1), A.1.31(1), and the representation
reduction in 14.5.11, printed pp.75,27–28,1015–1016, refs/quasithin.pdf.
-/

public noncomputable section
open scoped IsMulCommutative
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory NoncentralChiefRefinement
namespace CFSG.Quasithin.ChapterB
variable {E D : Type*} [Group E] [Finite E] [Group D] [Finite D]

omit [Finite D] in
/-- A near-maximum elementary actor has fixed codimension at most its image rank plus one. -/
theorem near_maximum_action_codimension
    (S V : Subgroup E) [V.Normal] [IsElementaryAbelian 2 V]
    (hVS : V ≤ S) (q : E →* D) (hq : Function.Surjective q)
    (hk : q.ker = centralizer (V : Set E))
    {A : Subgroup E} (hA : A ∈ thompsonFamily S 1) (hne : A.map q ≠ ⊥) :
    fixedCodim (NormalElementaryQuotient.representation V q hq hk) (A.map q) ≤
      rank (A.map q) + 1 := by
  let : IsElementaryAbelian 2 A := hA.2.1
  have ha := (mem_thompsonFamily_iff_rank S A 1).mp hA
  have hb := lemma_B_2_4_1 S V A hVS hA.1 1 (by
    change Nat.log 2 (Nat.card A) = twoRank S - 1
    omega) q hk hne
  have hc := fixedCodim_map_equivariant (normalRepresentation V)
    (NormalElementaryQuotient.representation V q hq hk) q
    (LinearEquiv.refl (ZMod 2) (Additive V))
    (by
      intro g v
      apply Additive.toMul.injective
      apply Subtype.ext
      exact (NormalElementaryQuotient.representation_apply V q hq hk g v).symm) A
  rw [normalRepresentation_fixedCodim_eq_rank_difference] at hc
  change fixedCodim (NormalElementaryQuotient.representation V q hq hk) (A.map q) ≤
    Nat.log 2 (Nat.card (A.map q)) + 1
  omega

omit [Finite D] in
/-- A residual generated by its J₁ commutators detects a moving involution
in an actual near-maximum elementary subgroup. -/
theorem exists_near_maximum_moving_involution
    (S : Subgroup E) (q : E →* D) (X R : Subgroup D) [R.Normal]
    (hcomm : ⁅X,(thompsonJ S 1).map q⁆ = X)
    (hm : ¬ X ≤ centralizer (R : Set D)) :
    ∃ A ∈ thompsonFamily S 1, ∃ t : D,
      t ∈ A.map q ∧ orderOf t = 2 ∧ t ∉ centralizer (R : Set D) := by
  classical
  have hj : ¬ (thompsonJ S 1).map q ≤ centralizer (R : Set D) := by
    intro hj
    apply hm
    rw [←hcomm]
    exact (commutator_mono le_rfl hj).trans (commutator_le_right X (centralizer (R : Set D)))
  have hA : ∃ A ∈ thompsonFamily S 1, ¬ A.map q ≤ centralizer (R : Set D) := by
    by_contra! hh
    apply hj
    apply map_le_iff_le_comap.mpr
    exact sSup_le fun A hA => map_le_iff_le_comap.mp (hh A hA)
  obtain ⟨A,hA,ha⟩ := hA
  obtain ⟨t,ht,hm⟩ := SetLike.not_le_iff_exists.mp ha
  let : IsElementaryAbelian 2 A := hA.2.1
  let : IsElementaryAbelian 2 (A.map q) := IsElementaryAbelian.map q
  have htne : t ≠ 1 := fun he => hm (he ▸ one_mem _)
  exact ⟨A,hA,t,ht,orderOf_eq_prime (elemPow_eq_one_of_isElementaryAbelian t ht) htne,hm⟩
/-- The moved odd subgroup has cyclic involution centralizer, with prime rank
measured on the original covering group and action codimension on the literal module. -/
theorem near_maximum_prime_movement
    (S V : Subgroup E) [V.Normal] [IsElementaryAbelian 2 V]
    (hVS : V ≤ S) (q : E →* D) (hq : Function.Surjective q)
    (hk : q.ker = centralizer (V : Set E))
    (X R : Subgroup D) [R.Normal] {p : ℕ} [Fact p.Prime]
    (hp : Odd p) (hrank : primeRank p E ≤ 2) (hR : IsPGroup p R)
    (hcomm : ⁅X,(thompsonJ S 1).map q⁆ = X)
    (hm : ¬ X ≤ centralizer (R : Set D)) :
    ∃ A ∈ thompsonFamily S 1,
      IsElementaryTwo (A.map q) ∧
      fixedCodim (NormalElementaryQuotient.representation V q hq hk) (A.map q) ≤
        rank (A.map q) + 1 ∧
      ∃ t : D, t ∈ A.map q ∧ orderOf t = 2 ∧ t ∉ centralizer (R : Set D) ∧
        IsCyclic (R ⊓ centralizer ({t} : Set D) : Subgroup D) ∧
        primeRank p (centralizer ({t} : Set D)) ≤ 1 := by
  obtain ⟨A,hA,t,ht,ht2,htR⟩ := exists_near_maximum_moving_involution S q X R hcomm hm
  have hne : A.map q ≠ ⊥ := by
    intro hz
    exact htR (show t ∈ centralizer (R : Set D) from by
      have h1 := mem_bot.mp (hz ▸ ht)
      simpa only [h1] using (one_mem (centralizer (R : Set D))))
  let : IsElementaryAbelian 2 A := hA.2.1
  refine ⟨A,hA,⟨hne,IsElementaryAbelian.map q⟩,
    near_maximum_action_codimension S V hVS q hq hk hA hne,t,ht,ht2,htR,?_,?_⟩
  · exact cyclic_pSubgroup_in_involution_centralizer_of_surjective_rank_two hp q hq hrank
      R hR t ht2 htR _ (hR.to_le inf_le_left) inf_le_right
  · exact primeRank_involutionCentralizer_le_one_of_surjective_rank_le_two hp q hq hrank
      R hR t ht2 htR
end CFSG.Quasithin.ChapterB
