module
public import CFSG.Quasithin.ChapterB.Section02.RelativeThompsonFactors
public import CFSG.Quasithin.ChapterB.Section01.SolvableStructure.OffenderProducts.SylowGeneration
public import Theory.GroupTheory.ElementaryThompsonRelative

/-!
# The Sylow subgroup of the relative Thompson span

The printed use of B.1.8(5) in 13.4.8 needs a specific Sylow conclusion;
it cannot use the false general equality of a stable family with its
saturation. Here the original Sylow normalizes R, hence J(R). The proved
solvable FF classification has at most two symmetric-three factors.

If the image of J(R) has order two, a nontrivial offender in it identifies
it with a single factor Sylow. The original Sylow normalizes that factor,
and the factor-permutation generation theorem makes the factor ambient
normal. Thus it is exactly the normal span of J(R)'s image. If the image
has larger order, it already fills a Sylow subgroup of the whole factor
product, hence of its normal span. Both arguments retain the literal
centralizer quotient and the actual original Thompson subgroup.

This proves the Sylow assertion used on printed p.905, conditional on the
source noncentrality, solvability and normality of R in T. It neither
identifies the centralizer kernel with O₂ of the span nor selects one
factor. Those local-product obligations remain with the 13.4.8 owner.
Source: Aschbacher–Smith, B.1.8, B.2.10 and 13.4.8, printed pp.70,77,905.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher Representation.BinaryOffender Representation
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterB
variable {G W : Type*} [Group G] [Finite G] [AddCommGroup W] [Module (ZMod 2) W]
  [FiniteDimensional (ZMod 2) W] {ρ : Representation (ZMod 2) G W}

private theorem small_two_subgroup_sylow (J N : Subgroup G) (hJN : J ≤ N)
    (hJ : IsPGroup 2 J) (hN : Nat.card N = 6 ∨ Nat.card N = 36)
    (hlarge : 2 < Nat.card J) :
    ∃ P : Sylow 2 N, (P : Subgroup N).map N.subtype = J := by
  obtain ⟨P, hP⟩ := (hJ.of_equiv (subgroupOfEquivOfLe hJN).symm).exists_le_sylow
  have hcJ : Nat.card (J.subgroupOf N) = Nat.card J :=
    Nat.card_congr (subgroupOfEquivOfLe hJN).toEquiv
  have hdiv := card_dvd_of_le hP
  have hcP : Nat.card P = 2 ∨ Nat.card P = 4 := by
    rw [P.card_eq_multiplicity]
    rcases hN with h | h
    · rw [h, show Nat.factorization 6 2 = 1 from by decide +kernel]
      exact Or.inl rfl
    · rw [h, show Nat.factorization 36 2 = 2 from by decide +kernel]
      exact Or.inr rfl
  have hle := Nat.le_of_dvd (Nat.card_pos (α := P)) hdiv
  have he : J.subgroupOf N = (P : Subgroup N) := by
    apply eq_of_le_of_card_ge hP
    rw [hcJ] at hdiv hle ⊢
    rcases hcP with hcP | hcP
    · omega
    · rw [hcP] at hdiv ⊢
      have hposs := (Nat.dvd_prime_pow Nat.prime_two).mp
        (show Nat.card J ∣ 2 ^ 2 from hdiv)
      obtain ⟨k, hk, he⟩ := hposs
      interval_cases k
      · change Nat.card J = 1 at he
        omega
      · change Nat.card J = 2 at he
        omega
      · change Nat.card J = 4 at he
        exact he.ge
  exact ⟨P, by rw [← he, map_subgroupOf_eq_of_le hJN]⟩

omit [FiniteDimensional (ZMod 2) W] in
private theorem factor_normal_of_sylow_normalizes_choice
    (d : SolvableFFFactors ρ) (hc : d.count = 1 ∨ d.count = 2)
    (T : Sylow 2 G) (i : Fin d.count) (P : Sylow 2 (d.factor i))
    (hn : (T : Subgroup G) ≤ normalizer (d.factorSylow i P : Set G)) :
    (d.factor i).Normal := by
  have hTN : (T : Subgroup G) ≤ normalizer (d.factor i : Set G) := by
    intro t ht
    have hj := mem_normalizer_iff_map_conj_eq.mp (hn ht)
    have hJj : d.factorSylow i P ≤ d.factor (d.factorConjugation t i) := by
      rw [← d.factor_map_conj, ← hj]
      exact map_mono (d.factorSylow_le i P)
    have hi : d.factorConjugation t i = i := by
      by_contra hne
      have hh := (d.factors_independent.pairwiseDisjoint (Ne.symm hne)).mono
        (d.factorSylow_le i P) hJj
      exact d.factorSylow_ne_bot i P (disjoint_self.mp hh)
    apply mem_normalizer_iff_map_conj_eq.mpr
    change (d.factor i).map (MulAut.conj t).toMonoidHom = d.factor i
    rw [d.factor_map_conj, hi]
  apply normalizer_eq_top_iff.mp
  apply top_unique
  rw [← d.sylow_factor_generation hc T]
  refine sup_le (sup_le ?_ ?_) hTN
  · exact (normal_subgroupOf_iff_le_normalizer (d.factor_le_offenderSubgroup i)).mp
      (d.factor_normal_in_offenderSubgroup i)
  · exact (centralizer_le (d.factor_le_offenderSubgroup i)).trans
      (Subgroup.centralizer_le_normalizer _)

omit [FiniteDimensional (ZMod 2) W] in
/-- A nontrivial two-subgroup generated by best offenders and normalized by
the original Sylow is Sylow in its actual normal span, for at most two factors. -/
theorem best_generated_normal_span_sylow
    (d : ThreeConjugates.SolvableFFStructure ρ)
    (hc : d.count = 1 ∨ d.count = 2) (T : Sylow 2 G)
    (F : Set (Subgroup G)) (hF : F.Nonempty)
    (hbest : ∀ A ∈ F, IsBestOffender ρ A)
    (hJ : IsPGroup 2 (generatedBy F ⊤))
    (hn : (T : Subgroup G) ≤ normalizer (generatedBy F ⊤ : Set G)) :
    ∃ P : Sylow 2 (conjugateSpanBy (generatedBy F ⊤) ⊤),
      (P : Subgroup _).map (conjugateSpanBy (generatedBy F ⊤) ⊤).subtype =
        generatedBy F ⊤ := by
  let J := generatedBy F ⊤
  let I := conjugateSpanBy J ⊤
  let := offenderSubgroup_normal ρ
  have hJD : J ≤ offenderSubgroup ρ := by
    apply iSup_le
    intro A
    apply iSup_le
    rintro ⟨hA, _⟩
    exact ((d.classifier A).mp (hbest A hA)).le_offenderSubgroup _
  have hID : I ≤ offenderSubgroup ρ :=
    conjugateSpanBy_le hJD le_normalizer_of_normal
  by_cases hsmall : Nat.card J ≤ 2
  · obtain ⟨A, hA⟩ := hF
    obtain ⟨choices, hchoices, ⟨i, hi⟩, he⟩ := (d.classifier A).mp (hbest A hA)
    obtain hb | ⟨P, hP⟩ := hchoices i
    · exact (hi hb).elim
    have hPJ : d.toSolvableFFFactors.factorSylow i P ≤ J := by
      apply le_trans _ (le_generatedBy_top_of_mem hA)
      rw [he, ← hP]
      exact le_iSup choices i
    have heJ : J = d.toSolvableFFFactors.factorSylow i P :=
      (eq_of_le_of_card_ge hPJ (by rw [d.toSolvableFFFactors.factorSylow_card]; exact hsmall)).symm
    have hnormal : (d.factor i).Normal :=
      factor_normal_of_sylow_normalizes_choice d.toSolvableFFFactors hc T i P (heJ ▸ hn)
    let := hnormal
    have heI : I = d.factor i := by
      apply le_antisymm
      · exact conjugateSpanBy_le (heJ ▸ d.toSolvableFFFactors.factorSylow_le i P)
          le_normalizer_of_normal
      · rw [← d.toSolvableFFFactors.factorSylow_conjugates_generate i P]
        apply iSup_le
        intro g
        rw [← heJ]
        change J.map (MulAut.conj g.val).toMonoidHom ≤ conjugateSpanBy J ⊤
        rw [conjugateSpanBy_eq_iSup_conj]
        exact le_iSup_of_le (⟨g.val, mem_top _⟩ : (⊤ : Subgroup G)) le_rfl
    have heCard : Nat.card (J.subgroupOf I) = 2 ^ (Nat.card I).factorization 2 := by
      rw [Nat.card_congr (subgroupOfEquivOfLe (le_conjugateSpanBy J ⊤)).toEquiv,
        heJ, d.toSolvableFFFactors.factorSylow_card, heI,
        d.toSolvableFFFactors.factor_card]
      decide +kernel
    exact ⟨Sylow.ofCard _ heCard, map_subgroupOf_eq_of_le (le_conjugateSpanBy J ⊤)⟩
  · have hDcard : Nat.card (offenderSubgroup ρ) = 6 ∨
        Nat.card (offenderSubgroup ρ) = 36 := by
      rw [← Nat.card_congr d.groupProduct.toEquiv, Nat.card_pi]
      simp only [d.toSolvableFFFactors.factor_card, Finset.prod_const,
        Finset.card_univ, Fintype.card_fin]
      rcases hc with hc | hc <;> rw [hc] <;> norm_num
    obtain ⟨P, hP⟩ := small_two_subgroup_sylow J (offenderSubgroup ρ) hJD hJ hDcard
      (Nat.lt_of_not_ge hsmall)
    have hPI : (P : Subgroup (offenderSubgroup ρ)) ≤ I.subgroupOf (offenderSubgroup ρ) := by
      intro x hx
      exact le_conjugateSpanBy J ⊤ (hP ▸ mem_map_of_mem (offenderSubgroup ρ).subtype hx)
    let Q := P.subtype hPI
    let e := subgroupOfEquivOfLe hID
    change ∃ P : Sylow 2 I, (P : Subgroup I).map I.subtype = J
    have hes : Function.Surjective e.toMonoidHom := e.surjective
    refine ⟨Q.mapSurjective (f := e.toMonoidHom) hes, ?_⟩
    rw [Sylow.coe_mapSurjective, map_map]
    have he : I.subtype.comp e.toMonoidHom =
        (offenderSubgroup ρ).subtype.comp (I.subgroupOf (offenderSubgroup ρ)).subtype := by
      ext x
      rfl
    rw [he, ← map_map, Sylow.coe_subtype, map_subgroupOf_eq_of_le hPI, hP]

variable {H : Type*} [Group H] [Finite H]

/-- The actual relative Thompson image is Sylow in its normal span. -/
theorem relative_thompson_span_sylow
    (V R : Subgroup G) [V.Normal] [IsElementaryAbelian 2 V]
    (T : Sylow 2 G) (hVR : V ≤ R) (hRT : R ≤ T)
    (hnR : (T : Subgroup G) ≤ normalizer (R : Set G))
    (q : G →* H) (hq : Function.Surjective q)
    (hker : q.ker = centralizer (V : Set G))
    (hmove : ¬ elementaryAbelianMaxJ R ≤ q.ker)
    (hsolv : Group.IsSolvable G) (hcore : pCore 2 H = ⊥)
    (hrank : primeRank 3 G ≤ 2) :
    let I := (conjugateSpanBy (elementaryAbelianMaxJ R) ⊤).map q
    ∃ P : Sylow 2 I, (P : Subgroup I).map I.subtype = (elementaryAbelianMaxJ R).map q := by
  let := hsolv
  let ρ : Representation (ZMod 2) H (Additive V) :=
    NormalElementaryQuotient.representation V q hq hker
  let F := maxOffenderImages R V q
  have hlocal := lemma_B_2_7_local V q hq hker R hVR hmove
  have hs : Group.IsSolvable H := Group.isSolvable_of_surjective (f := q) hq
  have hfaith : Function.Injective ρ :=
    NormalElementaryQuotient.representation_injective V q hq hker
  have hff : IsFFModule ρ := hlocal.1
  have hd : Nonempty (ThreeConjugates.SolvableFFStructure ρ) :=
    solvableFFStructure_nonempty (G := H) (V := Additive V) ρ hs hcore hfaith hff
  obtain ⟨d⟩ := hd
  have hF : F.Nonempty := by
    by_contra he
    have he : F = ∅ := Set.not_nonempty_iff_eq_empty.mp he
    apply hmove
    apply (Subgroup.map_eq_bot_iff _).mp
    rw [maxOffenderImages_generated R V q]
    change generatedBy F ⊤ = ⊥
    simp [he, generatedBy]
  have hgen : generatedBy F ⊤ = (elementaryAbelianMaxJ R).map q :=
    (maxOffenderImages_generated R V q).symm
  have hJle : elementaryAbelianMaxJ R ≤ T := (sSup_le fun _ hA => hA.1).trans hRT
  have hJp : IsPGroup 2 (generatedBy F ⊤) := by
    rw [hgen]
    exact (T.isPGroup'.to_le hJle).map q
  have hn : ((T.mapSurjective hq : Sylow 2 H) : Subgroup H) ≤
      normalizer (generatedBy F ⊤ : Set H) := by
    rw [Sylow.coe_mapSurjective, hgen]
    exact (map_mono (hnR.trans (normalizer_le_normalizer_elementaryAbelianMaxJ R))).trans
      ((elementaryAbelianMaxJ R).le_normalizer_map q)
  have hs := best_generated_normal_span_sylow d
    (d.toSolvableFFFactors.count_eq_one_or_two_of_surjective_threeRank q hq hrank)
    (T.mapSurjective hq) F hF hlocal.2 hJp hn
  rw [hgen] at hs
  dsimp only
  rw [map_conjugateSpanBy, map_top_of_surjective q hq]
  exact hs

end CFSG.Quasithin.ChapterB
