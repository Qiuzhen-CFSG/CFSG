module

public import Stellmacher.ElementaryAbelianMaxJFixedCenter
public import Stellmacher.BaumannIntermediate
public import Stellmacher.ElementaryAbelianMaxOrderSpecification
public import Theory.ElementaryAbelian.FixedOrderGeneration
public import Theory.GroupTheory.PGroup.OmegaAmbient
public import Mathlib.Data.Nat.Log

/-!
# B.2.2–3: Thompson variants and Baumann subgroups

The rank of a largest elementary abelian two-subgroup is the base-two logarithm
of its order. The rank-indexed family at index zero is proved to equal the
existing Stellmacher maximum-order family, so both constructions give the same
Thompson subgroup. Subgroups of any fixed positive rank generate each larger
elementary abelian group; this proves monotonicity of the Thompson variants.
Centralizing involutions and the maximal-order comparison then prove the
omega-center identities and heredity assertions.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
1 March 2004 manuscript, Definitions B.2.2 and Lemma B.2.3, printed pp. 74–75.
All subgroups below are viewed in one common ambient finite group. The results
hold, in particular, when `S` is a two-group as in the source.
-/

namespace CFSG.Quasithin.ChapterB

open Stellmacher
open scoped IsMulCommutative
variable {G : Type*} [Group G] [Finite G]

/-- The maximum elementary abelian two-rank `m₂(S)`, computed from maximum order. -/
@[expose] public noncomputable def twoRank (S : Subgroup G) : ℕ :=
  Nat.log 2 (elementaryAbelianMaxOrder S)

/-- B.2.2: elementary abelian subgroups of rank `m₂(S) - i`.
The bound on `i` excludes negative ranks instead of truncating them to zero. -/
@[expose] public noncomputable def thompsonFamily (S : Subgroup G) (i : ℕ) :
    Set (Subgroup G) :=
  {A | A ≤ S ∧ IsElementaryAbelian 2 A ∧ i ≤ twoRank S ∧
    Nat.card A = 2 ^ (twoRank S - i)}

/-- B.2.2: the subgroup generated by the rank-indexed family. -/
@[expose] public noncomputable def thompsonJ (S : Subgroup G) (i : ℕ) : Subgroup G :=
  sSup (thompsonFamily S i)

/-- The fixed center `α(S) = Ω₁(Z(J(S)))`. -/
@[expose] public noncomputable def thompsonAlpha (S : Subgroup G) : Subgroup G :=
  omegaOneCenterAmbient (elementaryAbelianMaxJ S)

/-- B.2.2: the Baumann subgroup `C_S(α(S))`. -/
@[expose] public noncomputable def baumann (S : Subgroup G) : Subgroup G :=
  S ⊓ Subgroup.centralizer (thompsonAlpha S : Set G)

/-- The maximum elementary order is exactly two to the maximum rank. -/
public theorem maxOrder_eq_two_pow_rank (S : Subgroup G) :
    elementaryAbelianMaxOrder S = 2 ^ twoRank S := by
  obtain ⟨A, hA⟩ := elementaryAbelianMaxSubgroups_nonempty S
  let : IsElementaryAbelian 2 A := hA.2.1
  obtain ⟨n, hn⟩ := (IsElementaryAbelian.isPGroup 2 A).exists_card_eq
  have h := (elementaryAbelianMaxSubgroups_card_eq S A hA).symm.trans hn
  simp [twoRank, h, Nat.log_pow (by decide : 1 < 2)]

/-- Rank formulation of B.2.2: for elementary abelian groups the rank is
`log₂` of the order. Writing the rank equation additively avoids truncated
subtraction and also handles indices exceeding the maximum rank. -/
public theorem mem_thompsonFamily_iff_rank (S A : Subgroup G) (i : ℕ) :
    A ∈ thompsonFamily S i ↔ A ≤ S ∧ IsElementaryAbelian 2 A ∧
      Nat.log 2 (Nat.card A) + i = twoRank S := by
  constructor
  · rintro ⟨hAS, he, hi, hc⟩
    refine ⟨hAS, he, ?_⟩
    rw [hc, Nat.log_pow (by decide : 1 < 2)]
    omega
  · rintro ⟨hAS, he, hr⟩
    let : IsElementaryAbelian 2 A := he
    obtain ⟨n, hn⟩ := (IsElementaryAbelian.isPGroup 2 A).exists_card_eq
    rw [hn, Nat.log_pow (by decide : 1 < 2)] at hr
    exact ⟨hAS, he, by omega, by rw [hn]; congr 1; omega⟩

/-- The zero-index family agrees with the existing maximum-order family. -/
public theorem thompsonFamily_zero (S : Subgroup G) :
    thompsonFamily S 0 = elementaryAbelianMaxSubgroups S := by
  ext A
  constructor
  · rintro ⟨hAS, hAe, _, hcard⟩
    refine ⟨hAS, hAe, ?_⟩
    intro B hBS hBe
    obtain ⟨C, hC⟩ := elementaryAbelianMaxSubgroups_nonempty S
    calc
      Nat.card B ≤ Nat.card C := hC.2.2 B hBS hBe
      _ = elementaryAbelianMaxOrder S := elementaryAbelianMaxSubgroups_card_eq S C hC
      _ = Nat.card A := by simpa [maxOrder_eq_two_pow_rank] using hcard.symm
  · intro hA
    exact ⟨hA.1, hA.2.1, Nat.zero_le _, by
      simpa using (elementaryAbelianMaxSubgroups_card_eq S A hA).trans (maxOrder_eq_two_pow_rank S)⟩

/-- In particular, `J₀` is the existing elementary Thompson subgroup. -/
public theorem thompsonJ_zero (S : Subgroup G) :
    thompsonJ S 0 = elementaryAbelianMaxJ S := by
  rw [thompsonJ, thompsonFamily_zero, elementaryAbelianMaxJ]

/-- The fixed center uses precisely the rank-zero Thompson subgroup. -/
public theorem thompsonAlpha_eq (S : Subgroup G) :
    thompsonAlpha S = omegaOneCenterAmbient (thompsonJ S 0) := by
  rw [thompsonJ_zero, thompsonAlpha]

/-- Every Thompson variant lies in the original subgroup. -/
public theorem thompsonJ_le (S : Subgroup G) (i : ℕ) : thompsonJ S i ≤ S :=
  sSup_le fun _ hA => hA.1

private theorem elementary_le_J (S A : Subgroup G) (i : ℕ)
    (hi : i < twoRank S) (hAS : A ≤ S) [IsElementaryAbelian 2 A]
    (hc : 2 ^ (twoRank S - i) ≤ Nat.card A) : A ≤ thompsonJ S i := by
  intro x hx
  obtain ⟨B, hBA, hBe, hBcard, hxB⟩ :=
    IsElementaryAbelian.exists_two_power_subgroup_mem A (by omega) hc x hx
  exact (le_sSup (show B ∈ thompsonFamily S i from
    ⟨hBA.trans hAS, hBe, hi.le, hBcard⟩)) hxB

/-- B.2.3(1): `Jᵢ(S) ≤ Jⱼ(S)` for `0 ≤ i ≤ j < m₂(S)`. -/
public theorem lemma_B_2_3_1 (S : Subgroup G) {i j : ℕ}
    (hij : i ≤ j) (hj : j < twoRank S) : thompsonJ S i ≤ thompsonJ S j := by
  apply sSup_le
  intro A hA
  let : IsElementaryAbelian 2 A := hA.2.1
  apply elementary_le_J S A j hj hA.1
  rw [hA.2.2.2]
  exact (Nat.pow_le_pow_iff_right (by decide : 1 < 2)).mpr (by omega)

/-- An intermediate subgroup containing `J₀(S)` has the same maximum rank. -/
public theorem twoRank_eq_of_intermediate (S R : Subgroup G)
    (hJR : elementaryAbelianMaxJ S ≤ R) (hRS : R ≤ S) : twoRank R = twoRank S := by
  unfold twoRank
  congr 1
  exact le_antisymm
    (elementaryAbelianMaxOrder_le_and_j_le_of_eq R S hRS).1
    (elementaryAbelianMaxOrder_le_and_j_le_of_maxJ_le S R hJR).1

/-- B.2.3(3): Thompson variants are inherited by intermediate subgroups. -/
public theorem lemma_B_2_3_3 (S R : Subgroup G) {i : ℕ}
    (hi : i < twoRank S) (hJR : thompsonJ S i ≤ R) (hRS : R ≤ S) :
    thompsonJ S i = thompsonJ R i := by
  have h0 : elementaryAbelianMaxJ S ≤ R := by
    rw [← thompsonJ_zero]
    exact (lemma_B_2_3_1 S (Nat.zero_le i) hi).trans hJR
  have hr := twoRank_eq_of_intermediate S R h0 hRS
  have hf : thompsonFamily S i = thompsonFamily R i := by
    ext A
    constructor
    · intro hA
      exact ⟨(le_sSup hA).trans hJR, hA.2.1, hr ▸ hA.2.2⟩
    · intro hA
      exact ⟨hA.1.trans hRS, hA.2.1, hr ▸ hA.2.2⟩
  rw [thompsonJ, hf, thompsonJ]

omit [Finite G] in
private theorem omegaCenter_le_omegaCentralizer (S K : Subgroup G) (hKS : K ≤ S) :
    omegaOneCenterAmbient K ≤ omegaOneAmbient (S ⊓ Subgroup.centralizer (K : Set G)) := by
  intro x hx
  obtain ⟨hxK, hxp, hxc⟩ := (mem_omegaOneCenterAmbient_iff K x).mp hx
  exact (omegaOneAmbient_le_iff _ _).mp le_rfl x
    ⟨hKS hxK, Subgroup.mem_centralizer_iff.mpr hxc⟩ hxp

private theorem omegaCentralizer_eq_of_maxJ_le (S K : Subgroup G)
    (hJK : elementaryAbelianMaxJ S ≤ K) (hKS : K ≤ S) :
    omegaOneAmbient (S ⊓ Subgroup.centralizer (K : Set G)) =
      omegaOneCenterAmbient K := by
  apply le_antisymm _ (omegaCenter_le_omegaCentralizer S K hKS)
  apply (omegaOneAmbient_le_iff _ _).mpr
  intro x hx hp
  let : IsElementaryAbelian 2 (Subgroup.zpowers x) :=
    IsElementaryAbelian.zpowers_of_pow_eq_one hp
  have hx0 : x ∈ omegaOneCenterAmbient (elementaryAbelianMaxJ S) :=
    elementary_centralizer_maxJ_le_omegaCenter S (Subgroup.zpowers x)
      (Subgroup.zpowers_le.mpr hx.1)
      (Subgroup.zpowers_le.mpr ((Subgroup.centralizer_le hJK) hx.2))
      (Subgroup.mem_zpowers x)
  have hxJ := ((mem_omegaOneCenterAmbient_iff _ _).mp hx0).1
  exact (mem_omegaOneCenterAmbient_iff K x).mpr
    ⟨hJK hxJ, hp, Subgroup.mem_centralizer_iff.mp hx.2⟩

/-- The omega-centralizer identity for the ordinary Thompson subgroup,
including groups of two-rank zero. -/
public theorem omegaCentralizer_thompson (S : Subgroup G) :
    omegaOneAmbient (S ⊓ Subgroup.centralizer (elementaryAbelianMaxJ S : Set G)) =
      thompsonAlpha S :=
  omegaCentralizer_eq_of_maxJ_le S _ le_rfl
    (sSup_le fun _ hA => hA.1)

/-- B.2.3(2): omega-centers decrease, and the omega-centralizer equals the
omega-center, throughout the indicated range of indices. -/
public theorem lemma_B_2_3_2 (S : Subgroup G) {i j : ℕ}
    (hij : i ≤ j) (hj : j < twoRank S) :
    omegaOneCenterAmbient (thompsonJ S j) ≤
        omegaOneAmbient (S ⊓ Subgroup.centralizer (thompsonJ S i : Set G)) ∧
      omegaOneAmbient (S ⊓ Subgroup.centralizer (thompsonJ S i : Set G)) =
        omegaOneCenterAmbient (thompsonJ S i) := by
  have heq (k : ℕ) (hk : k < twoRank S) :
      omegaOneAmbient (S ⊓ Subgroup.centralizer (thompsonJ S k : Set G)) =
        omegaOneCenterAmbient (thompsonJ S k) := by
    apply omegaCentralizer_eq_of_maxJ_le S _ _ (thompsonJ_le S k)
    rw [← thompsonJ_zero]
    exact lemma_B_2_3_1 S (Nat.zero_le k) hk
  refine ⟨?_, heq i (hij.trans_lt hj)⟩
  rw [← heq j hj]
  exact omegaOneAmbient_mono (inf_le_inf_left S
    (Subgroup.centralizer_le (lemma_B_2_3_1 S hij hj)))

/-- B.2.3(4): Baumann subgroups are inherited through intermediate subgroups. -/
public theorem lemma_B_2_3_4 (S R : Subgroup G)
    (hBR : baumann S ≤ R) (hRS : R ≤ S) : baumann S = baumann R :=
  (baumann_eq_of_intermediate S R hBR hRS).symm

/-- B.2.3(5): centralizing an elementary subgroup that centralizes `J(S)`
preserves the Baumann subgroup. -/
public theorem lemma_B_2_3_5 (S U : Subgroup G) [IsElementaryAbelian 2 U]
    (hUS : U ≤ S) (hJU : elementaryAbelianMaxJ S ≤ Subgroup.centralizer (U : Set G)) :
    baumann S = baumann (S ⊓ Subgroup.centralizer (U : Set G)) := by
  have hU : U ≤ thompsonAlpha S := elementary_centralizer_maxJ_le_omegaCenter S U
    hUS (Subgroup.le_centralizer_iff.mp hJU)
  apply lemma_B_2_3_4 S _ _ inf_le_left
  exact inf_le_inf_left S (Subgroup.centralizer_le hU)

private theorem involution_centralizing_max_mem (S A : Subgroup G)
    (hA : A ∈ elementaryAbelianMaxSubgroups S) (x : G)
    (hxS : x ∈ S) (hxC : x ∈ Subgroup.centralizer (A : Set G)) (hp : x ^ 2 = 1) :
    x ∈ A := by
  let : IsElementaryAbelian 2 A := hA.2.1
  let : IsElementaryAbelian 2 (Subgroup.zpowers x) :=
    IsElementaryAbelian.zpowers_of_pow_eq_one hp
  have he : IsElementaryAbelian 2 ↥(A ⊔ Subgroup.zpowers x) :=
    IsElementaryAbelian.sup_of_le_centralizer (Subgroup.zpowers_le.mpr hxC)
  have hEq : A = A ⊔ Subgroup.zpowers x := Subgroup.eq_of_le_of_card_ge le_sup_left
    (hA.2.2 _ (sup_le hA.1 (Subgroup.zpowers_le.mpr hxS)) he)
  exact (show Subgroup.zpowers x ≤ A from hEq ▸ le_sup_right) (Subgroup.mem_zpowers x)

/-- B.2.3(6): a maximum-rank elementary subgroup is its own omega-centralizer. -/
public theorem lemma_B_2_3_6 (S A : Subgroup G) (hA : A ∈ thompsonFamily S 0) :
    A = omegaOneAmbient (S ⊓ Subgroup.centralizer (A : Set G)) := by
  rw [thompsonFamily_zero] at hA
  let : IsElementaryAbelian 2 A := hA.2.1
  apply le_antisymm
  · intro x hx
    apply (omegaOneAmbient_le_iff _ _).mp le_rfl x
    · refine ⟨hA.1 hx, Subgroup.mem_centralizer_iff.mpr ?_⟩
      intro a ha
      exact congrArg Subtype.val (mul_comm (⟨a, ha⟩ : A) ⟨x, hx⟩)
    · exact elemPow_eq_one_of_isElementaryAbelian x hx
  · exact (omegaOneAmbient_le_iff _ _).mpr fun x hx hp =>
      involution_centralizing_max_mem S A hA x hx.1 hx.2 hp

/-- B.2.3(7): the fixed center is the intersection of the maximum-rank family. -/
public theorem lemma_B_2_3_7 (S : Subgroup G) :
    omegaOneAmbient (S ⊓ Subgroup.centralizer (elementaryAbelianMaxJ S : Set G)) =
        thompsonAlpha S ∧
      thompsonAlpha S = sInf (thompsonFamily S 0) := by
  refine ⟨omegaCentralizer_thompson S, le_antisymm ?_ ?_⟩
  · apply le_sInf
    intro A hA
    rw [lemma_B_2_3_6 S A hA, ← omegaCentralizer_thompson S]
    apply omegaOneAmbient_mono
    apply inf_le_inf_left
    apply Subgroup.centralizer_le
    rw [← thompsonJ_zero]
    exact le_sSup hA
  · obtain ⟨A, hA⟩ := elementaryAbelianMaxSubgroups_nonempty S
    have hAf : A ∈ thompsonFamily S 0 := by rwa [thompsonFamily_zero]
    let : IsElementaryAbelian 2 A := hA.2.1
    intro x hx
    have hxA : x ∈ A := (sInf_le hAf) hx
    have hxJ : x ∈ elementaryAbelianMaxJ S := (le_sSup hA) hxA
    apply (mem_omegaOneCenterAmbient_iff _ _).mpr
    refine ⟨hxJ, elemPow_eq_one_of_isElementaryAbelian x hxA, ?_⟩
    have hcent : elementaryAbelianMaxJ S ≤ Subgroup.centralizer ({x} : Set G) := by
      apply sSup_le
      intro B hB
      let : IsElementaryAbelian 2 B := hB.2.1
      have hxB : x ∈ B := (sInf_le (show B ∈ thompsonFamily S 0 by
        rwa [thompsonFamily_zero])) hx
      intro b hb
      rw [Subgroup.mem_centralizer_singleton_iff]
      exact congrArg Subtype.val (mul_comm (⟨b, hb⟩ : B) ⟨x, hxB⟩)
    intro q hq
    exact Subgroup.mem_centralizer_singleton_iff.mp (hcent hq)

/-- The maximum elementary rank is invariant under ambient automorphisms. -/
public theorem twoRank_map_equiv (e : G ≃* G) (S : Subgroup G) :
    twoRank (S.map e.toMonoidHom) = twoRank S := by
  simp only [twoRank, elementaryAbelianMaxOrder_map_equiv]

private theorem family_map_mem (e : G ≃* G) (S A : Subgroup G) (i : ℕ)
    (hA : A ∈ thompsonFamily S i) :
    A.map e.toMonoidHom ∈ thompsonFamily (S.map e.toMonoidHom) i := by
  let : IsElementaryAbelian 2 A := hA.2.1
  refine ⟨Subgroup.map_mono hA.1, IsElementaryAbelian.map e.toMonoidHom, ?_, ?_⟩
  · simpa only [twoRank_map_equiv] using hA.2.2.1
  · simpa only [twoRank_map_equiv, Subgroup.card_map_of_injective (f := e.toMonoidHom) e.injective]
      using hA.2.2.2

omit [Finite G] in
private theorem map_inverse_cancel (e : G ≃* G) (A : Subgroup G) :
    (A.map e.toMonoidHom).map e.symm.toMonoidHom = A := by
  rw [Subgroup.map_map]
  have h : e.symm.toMonoidHom.comp e.toMonoidHom = MonoidHom.id G := by
    ext x
    simp
  rw [h, Subgroup.map_id]

/-- Thompson variants commute with ambient automorphisms. This extends the
existing transport proof for the maximum-order Thompson subgroup. -/
public theorem thompsonJ_map_equiv (e : G ≃* G) (S : Subgroup G) (i : ℕ) :
    thompsonJ (S.map e.toMonoidHom) i = (thompsonJ S i).map e.toMonoidHom := by
  apply le_antisymm
  · apply sSup_le
    intro A hA
    have hback := family_map_mem e.symm (S.map e.toMonoidHom) A i hA
    rw [map_inverse_cancel] at hback
    have hle : A.map e.symm.toMonoidHom ≤ thompsonJ S i := le_sSup hback
    have hmap := Subgroup.map_mono (f := e.toMonoidHom) hle
    have hc := map_inverse_cancel e.symm A
    simp only [MulEquiv.symm_symm] at hc
    rwa [hc] at hmap
  · rw [Subgroup.map_le_iff_le_comap]
    apply sSup_le
    intro A hA
    exact Subgroup.map_le_iff_le_comap.mp (le_sSup (family_map_mem e S A i hA))

/-- The characteristic assertion following B.2.2, stated intrinsically. -/
public theorem thompsonJ_characteristic (i : ℕ) :
    (thompsonJ (⊤ : Subgroup G) i).Characteristic := by
  rw [Subgroup.characteristic_iff_map_eq]
  intro e
  rw [← thompsonJ_map_equiv, Subgroup.map_top_of_surjective _ e.surjective]

omit [Finite G] in
/-- The fixed center of the Thompson subgroup is characteristic. -/
public theorem thompsonAlpha_characteristic :
    (thompsonAlpha (⊤ : Subgroup G)).Characteristic := by
  rw [Subgroup.characteristic_iff_map_eq]
  intro e
  change (omegaOneCenterAmbient (elementaryAbelianMaxJ (⊤ : Subgroup G))).map
    e.toMonoidHom = _
  rw [← omegaOneCenterAmbient_map_injective e.toMonoidHom e.injective,
    ← elementaryAbelianMaxJ_map_equiv, Subgroup.map_top_of_surjective _ e.surjective]
  rfl

omit [Finite G] in
/-- The Baumann subgroup is characteristic, as asserted after B.2.2. -/
public theorem baumann_characteristic : (baumann (⊤ : Subgroup G)).Characteristic := by
  let : (thompsonAlpha (⊤ : Subgroup G)).Characteristic := thompsonAlpha_characteristic
  simpa only [baumann, top_inf_eq] using
    (inferInstance : (Subgroup.centralizer (thompsonAlpha (⊤ : Subgroup G) : Set G)).Characteristic)

end CFSG.Quasithin.ChapterB
