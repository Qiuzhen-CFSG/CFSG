module
public import CFSG.Quasithin.ChapterB.Section01.SolvableStructure.SourceTheorems
public import CFSG.Quasithin.ChapterB.Section02.SolvableActionFactors.Subproduct
public import Theory.GroupTheory.PResidual.PerfectCover
public import Theory.GroupTheory.NormalSymmetricThreeMarked
public import Theory.GroupTheory.NormalSymmetricThreePairRank.TwoPerfect

/-!
# Two-perfect actors in a solvable FF action

A two-perfect subgroup generated by its commutators with an offender
subgroup lies in the full offender group. In three-rank at most two, the
solvable FF theorem identifies that group with S₃ or S₃×S₃. A two-perfect
{2,3}-actor centralizes the first subgroup: in the single-factor case it
centralizes the characteristic cubic, while in the pair case it lies in
the pair and both two-perfect subgroups lie in the commuting cubics.

The original representation and actual internal factors are retained.
The second amalgam in 13.4.7 applies this to the images of L₁ and Y₂.
Source: Aschbacher--Smith B.1.8, p.70; 13.4.7(3), p.903.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterB
universe u
variable {G : Type u} [Group G] [Finite G]

private theorem cube_comm_three : ∀ a b : Equiv.Perm (Fin 3),
    a ^ 3 = 1 → b ^ 3 = 1 → a * b = b * a := by decide +kernel

omit [Finite G] in
private theorem perfect_actors_commute_in_pair
    (I L R : Subgroup G) (e : I ≃* (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3)))
    (hpL : IsPPerfect 2 L) (hpR : IsPPerfect 2 R) (hLI : L ≤ I) (hRI : R ≤ I) :
    R ≤ centralizer (L : Set G) := by
  intro r hr l hl
  have hL := NormalSymmetricThreePairRank.cube_eq_one_of_le_pair I e L hpL hLI ⟨l,hl⟩
  have hR := NormalSymmetricThreePairRank.cube_eq_one_of_le_pair I e R hpR hRI ⟨r,hr⟩
  have hl3 : (e ⟨l,hLI hl⟩) ^ 3 = 1 := by
    rw [←map_pow]
    exact (congrArg e (show (⟨l,hLI hl⟩ : I) ^ 3 = 1 from
      Subtype.ext (congrArg (fun x : L => (x : G)) hL))).trans e.map_one
  have hr3 : (e ⟨r,hRI hr⟩) ^ 3 = 1 := by
    rw [←map_pow]
    exact (congrArg e (show (⟨r,hRI hr⟩ : I) ^ 3 = 1 from
      Subtype.ext (congrArg (fun x : R => (x : G)) hR))).trans e.map_one
  have hc : e ⟨l,hLI hl⟩ * e ⟨r,hRI hr⟩ = e ⟨r,hRI hr⟩ * e ⟨l,hLI hl⟩ := by
    apply Prod.ext
    · exact cube_comm_three _ _ (congrArg Prod.fst hl3) (congrArg Prod.fst hr3)
    · exact cube_comm_three _ _ (congrArg Prod.snd hl3) (congrArg Prod.snd hr3)
  have hh : (⟨l,hLI hl⟩ : I) * ⟨r,hRI hr⟩ = ⟨r,hRI hr⟩ * ⟨l,hLI hl⟩ :=
    e.injective (by simpa only [map_mul] using hc)
  exact congrArg Subtype.val hh

/-- In the solvable action, the two-perfect actor centralizes every
Thompson-generated two-perfect subgroup of the actual FF subgroup. -/
theorem solvable_ff_thompson_actor_centralizes
    {E : Type*} [AddCommGroup E] [Module (ZMod 2) E]
    [FiniteDimensional (ZMod 2) E]
    (ρ : Representation (ZMod 2) G E) (hs : Group.IsSolvable G)
    (hcore : pCore 2 G = ⊥) (hf : Function.Injective ρ) (hff : IsFFModule ρ)
    (L R J : Subgroup G) (hpL : IsPPerfect 2 L) (hpR : IsPPerfect 2 R)
    (hJ : J ≤ offenderSubgroup ρ) (hm : ⁅L,J⁆ = L)
    (hrank : primeRank 3 G ≤ 2)
    (horder : ∃ m n : ℕ, Nat.card R ∣ 2 ^ m * 3 ^ n) :
    R ≤ centralizer (L : Set G) := by
  let I := offenderSubgroup ρ
  let : I.Normal := offenderSubgroup_normal ρ
  have hLI : L ≤ I := hm.symm.le.trans
    ((commutator_mono le_rfl hJ).trans (commutator_le_right _ _))
  obtain ⟨d⟩ := solvableFFStructure_nonempty ρ hs hcore hf hff
  let d₀ := d.toSolvableFFFactors
  have hn := d₀.count_eq_one_or_two_of_surjective_threeRank (MonoidHom.id G)
    Function.surjective_id hrank
  have hi : (⨆ i ∈ (Set.univ : Set (Fin d₀.count)), d₀.factor i : Subgroup G) = I := by
    simpa only [Set.mem_univ,iSup_pos] using d₀.iSup_factor
  have hiN : (Set.univ : Set (Fin d₀.count)).Nonempty := ⟨⟨0,d₀.count_pos⟩,Set.mem_univ _⟩
  have he := d₀.nonempty_subproduct_models hn Set.univ hiN
  rw [hi] at he
  rcases he with he | he
  · obtain ⟨e⟩ := he
    have hLR : L ≤ (pResidual 2 I).map I.subtype := by
      have hh := embedded_pResidual_mono 2 hLI
      rwa [(pResidual_eq_top_iff 2 L).mpr hpL,←MonoidHom.range_eq_map,range_subtype] at hh
    exact (NormalSymmetricThreeMarked.centralizes_residual I e R hpR).trans
      (centralizer_le hLR)
  · obtain ⟨e⟩ := he
    exact perfect_actors_commute_in_pair I L R e hpL hpR hLI
      (NormalSymmetricThreePairRank.le_pair_of_twoPerfect I e R hpR hrank horder)


end CFSG.Quasithin.ChapterB
