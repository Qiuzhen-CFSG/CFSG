module

public import CFSG.Quasithin.ChapterB.Section02.Baumann.Basic
public import Theory.GroupTheory.PResidual.FrattiniGeneration
public import Theory.GroupTheory.PResidual.NormalSubgroup

/-!
# The preliminary conjugacy reduction in Baumann's argument

Write L = O²(G), H = LR, Q = C_R(V), J = J(R), and I = ⟨Xᵢ⟩.
Under (a)–(d), each Xᵢ lies in H. Taking the actual residual of I and
using Frattini nongeneration in L/O₂(L) gives L ≤ IO₂(L) ≤ IQ. Since
Q is normal in H and R normalizes J, the H-conjugates of J are precisely
its I-conjugates. This equality does not use hypothesis (e), and is needed
before (e) is established in B.2.19.

The full-rank, self-Thompson condition puts each Xᵢ inside an L-conjugate
of J, hence inside an I-conjugate of J. With (e), namely J ≤ I, it follows
that I is generated by the H-conjugates of J and is normal in H. Finally
H/I is a two-group, so the two-perfect subgroup L lies in I. All normality
assertions are relative to H; the ambient group need not equal LR.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
manuscript of 1 March 2004, proof of B.2.18, printed pp.80–81, through the
paragraph introducing W.
-/

namespace CFSG.Quasithin.ChapterB.BaumannArgument
open Stellmacher Subgroup
variable {G : Type*} [Group G] [Finite G] {ι : Type*} [Fintype ι]

omit [Finite G] in
private theorem map_conj_mul (A : Subgroup G) (g h : G) :
    (A.map (MulAut.conj h).toMonoidHom).map (MulAut.conj g).toMonoidHom =
      A.map (MulAut.conj (g * h)).toMonoidHom := by
  exact A.conjBy_conjBy h g

omit [Finite G] in
private theorem map_conj_inv_cancel (A : Subgroup G) (g : G) :
    (A.map (MulAut.conj g).toMonoidHom).map (MulAut.conj g⁻¹).toMonoidHom = A := by
  rw [map_conj_mul, inv_mul_cancel]
  have hf : (MulAut.conj (1 : G)).toMonoidHom = MonoidHom.id G := by
    ext x
    simp
  rw [hf, map_id]

omit [Finite G] in
private theorem map_conj_eq {A : Subgroup G} {g : G} (hg : g ∈ normalizer (A : Set G)) :
    A.map (MulAut.conj g).toMonoidHom = A :=
  mem_normalizer_iff_map_conj_eq.mp hg

omit [Finite G] in
private theorem normalizes_maxJ (R : Subgroup G) :
    R ≤ normalizer (elementaryAbelianMaxJ R : Set G) := by
  intro r hr
  apply mem_normalizer_iff_map_conj_eq.mpr
  change (elementaryAbelianMaxJ R).map (MulAut.conj r).toMonoidHom = _
  rw [← elementaryAbelianMaxJ_map_equiv,
    map_conj_eq (R.le_normalizer hr)]

/-- Every generator lies in the source local overgroup LR. -/
public theorem generated_le_join (V R : Subgroup G) [V.Normal]
    (X : ι → Subgroup G) (h : HypothesesAD V R X) :
    (⨆ i, X i) ≤ pResidual 2 G ⊔ R := by
  apply iSup_le
  intro i
  obtain ⟨l, hl, hXi⟩ := h.conjugate_into i
  have hlH : l ∈ pResidual 2 G ⊔ R :=
    (show pResidual 2 G ≤ pResidual 2 G ⊔ R from le_sup_left) hl
  have heq := map_conj_eq
    ((pResidual 2 G ⊔ R).le_normalizer ((pResidual 2 G ⊔ R).inv_mem hlH))
  have hm := map_mono (f := (MulAut.conj l⁻¹).toMonoidHom)
    (hXi.trans (show R ≤ pResidual 2 G ⊔ R from le_sup_right))
  rwa [map_conj_inv_cancel, heq] at hm

/-- The full-rank Thompson generators can be conjugated into J(R). -/
public theorem conjugate_generators_into_maxJ (V R : Subgroup G) [V.Normal]
    (X : ι → Subgroup G) (h : HypothesesAD V R X) (i : ι) :
    ∃ l ∈ pResidual 2 G,
      (X i).map (MulAut.conj l).toMonoidHom ≤ elementaryAbelianMaxJ R := by
  obtain ⟨l, hl, hXi⟩ := h.conjugate_into i
  refine ⟨l, hl, ?_⟩
  have heq : elementaryAbelianMaxOrder ((X i).map (MulAut.conj l).toMonoidHom) =
      elementaryAbelianMaxOrder R := by
    rw [maxOrder_eq_two_pow_rank, maxOrder_eq_two_pow_rank,
      twoRank_map_equiv, h.rank_eq i]
  have hJ := (elementaryAbelianMaxOrder_le_and_j_le_of_eq _ _ hXi).2 heq
  rwa [elementaryAbelianMaxJ_map_equiv, h.self_thompson i] at hJ

/-- The residual is covered by the generated subgroup and C_R(V), before
hypothesis (e) or normality of the generated subgroup is available. -/
public theorem residual_le_generated_sup_centralizer (V R : Subgroup G) [V.Normal]
    (X : ι → Subgroup G) (h : HypothesesAD V R X) :
    pResidual 2 G ≤ (⨆ i, X i) ⊔ (R ⊓ centralizer (V : Set G)) := by
  have hi : (pResidual 2 G).map (actionMap V) ≤ (⨆ i, X i).map (actionMap V) := by
    rw [Subgroup.map_iSup]
    exact h.image_generation
  have hk : pResidual 2 G ⊓ (actionMap V).ker ≤ coreFrattini (pResidual 2 G) := by
    rw [actionMap_ker]
    exact h.centralizer_le_frattini
  exact (pResidual_le_sup_of_frattini_kernel 2 (⨆ i, X i) (actionMap V)
    (pCore 2 (pResidual 2 G)) hi hk).trans (sup_le_sup_left h.core_le _)

/-- The preliminary conjugacy equality uses only (a)–(d), as required by B.2.19. -/
public theorem conjugates_join_eq_generated (V R : Subgroup G) [V.Normal]
    (X : ι → Subgroup G) (h : HypothesesAD V R X) :
    conjugatesBy (pResidual 2 G ⊔ R) (elementaryAbelianMaxJ R) =
      conjugatesBy (⨆ i, X i) (elementaryAbelianMaxJ R) := by
  have hcover := residual_le_generated_sup_centralizer V R X h
  let L := pResidual 2 G
  let I := ⨆ i, X i
  let Q := R ⊓ centralizer (V : Set G)
  have hIH := generated_le_join V R X h
  have hHN : L ⊔ R ≤ normalizer (Q : Set G) :=
    (normal_subgroupOf_iff_le_normalizer (inf_le_left.trans le_sup_right)).mp
      (centralizer_normal_in_join V R L h.normalizes)
  apply Set.Subset.antisymm
  · rintro D ⟨g, hg, rfl⟩
    obtain ⟨l, hl, r, hr, rfl⟩ := mem_sup_of_normal_left.mp hg
    have hlIQ : l ∈ I ⊔ Q := hcover hl
    rw [← SetLike.mem_coe, coe_mul_of_left_le_normalizer_right I Q (hIH.trans hHN)] at hlIQ
    obtain ⟨i, hi, q, hq, rfl⟩ := hlIQ
    refine ⟨i, hi, ?_⟩
    rw [← map_conj_mul, map_conj_eq (normalizes_maxJ R hr),
      ← map_conj_mul, map_conj_eq (normalizes_maxJ R hq.1)]
  · rintro D ⟨i, hi, rfl⟩
    exact ⟨i, hIH hi, rfl⟩

/-- Each generator has an I-conjugate inside J(R); this too needs only (a)–(d). -/
public theorem internal_conjugate_generators (V R : Subgroup G) [V.Normal]
    (X : ι → Subgroup G) (h : HypothesesAD V R X) (i : ι) :
    ∃ g ∈ (⨆ i, X i),
      (X i).map (MulAut.conj g).toMonoidHom ≤ elementaryAbelianMaxJ R := by
  obtain ⟨l, hl, hXi⟩ := conjugate_generators_into_maxJ V R X h i
  have hm := map_mono (f := (MulAut.conj l⁻¹).toMonoidHom) hXi
  rw [map_conj_inv_cancel] at hm
  have hmem : (elementaryAbelianMaxJ R).map (MulAut.conj l⁻¹).toMonoidHom ∈
      conjugatesBy (pResidual 2 G ⊔ R) (elementaryAbelianMaxJ R) :=
    ⟨l⁻¹, (show pResidual 2 G ≤ pResidual 2 G ⊔ R from le_sup_left)
      ((pResidual 2 G).inv_mem hl), rfl⟩
  rw [conjugates_join_eq_generated V R X h] at hmem
  obtain ⟨g, hg, hge⟩ := hmem
  rw [hge] at hm
  refine ⟨g⁻¹, (⨆ i, X i).inv_mem hg, ?_⟩
  have hmap := map_mono (f := (MulAut.conj g⁻¹).toMonoidHom) hm
  rwa [map_conj_inv_cancel] at hmap

/-- Hypothesis (e) identifies I with the normal closure inside LR. -/
public theorem generated_eq_sSup_conjugates (V R : Subgroup G) [V.Normal]
    (X : ι → Subgroup G) (h : HypothesesAD V R X)
    (hJI : elementaryAbelianMaxJ R ≤ ⨆ i, X i) :
    (⨆ i, X i) = sSup (conjugatesBy (pResidual 2 G ⊔ R) (elementaryAbelianMaxJ R)) := by
  apply le_antisymm
  · apply iSup_le
    intro i
    obtain ⟨l, hl, hXi⟩ := conjugate_generators_into_maxJ V R X h i
    have hm := map_mono (f := (MulAut.conj l⁻¹).toMonoidHom) hXi
    rw [map_conj_inv_cancel] at hm
    exact hm.trans (le_sSup ⟨l⁻¹,
      (show pResidual 2 G ≤ pResidual 2 G ⊔ R from le_sup_left)
        ((pResidual 2 G).inv_mem hl), rfl⟩)
  · rw [conjugates_join_eq_generated V R X h]
    apply sSup_le
    rintro D ⟨g, hg, rfl⟩
    have hm := map_mono (f := (MulAut.conj g).toMonoidHom) hJI
    rwa [map_conj_eq ((⨆ i, X i).le_normalizer hg)] at hm

omit [Finite G] in
private theorem conjugates_normal (H J I : Subgroup G) (hIH : I ≤ H)
    (hI : I = sSup (conjugatesBy H J)) : (I.subgroupOf H).Normal := by
  apply (normal_subgroupOf_iff_le_normalizer hIH).mpr
  apply le_normalizer_iff.mpr
  intro g hg x hx
  have hm : I.map (MulAut.conj g).toMonoidHom ≤ I := by
    rw [hI]
    apply map_le_iff_le_comap.mpr
    apply sSup_le
    rintro D ⟨d, hd, rfl⟩
    apply map_le_iff_le_comap.mp
    rw [map_conj_mul]
    exact le_sSup ⟨g * d, H.mul_mem hg hd, rfl⟩
  exact hm (mem_map_of_mem (MulAut.conj g).toMonoidHom hx)

/-- Under (e), I is normal in LR, without claiming normality in G. -/
public theorem generated_normal_in_join (V R : Subgroup G) [V.Normal]
    (X : ι → Subgroup G) (h : HypothesesAD V R X)
    (hJI : elementaryAbelianMaxJ R ≤ ⨆ i, X i) :
    ((⨆ i, X i).subgroupOf (pResidual 2 G ⊔ R)).Normal :=
  conjugates_normal _ _ _ (generated_le_join V R X h)
    (generated_eq_sSup_conjugates V R X h hJI)

/-- The normal subgroup I contains the two-residual of G. This uses the
actual two-group quotient H/I and the two-perfectness of L. -/
public theorem residual_le_generated (V R : Subgroup G) [V.Normal]
    (X : ι → Subgroup G) (h : HypothesesAD V R X)
    (hJI : elementaryAbelianMaxJ R ≤ ⨆ i, X i) :
    pResidual 2 G ≤ ⨆ i, X i := by
  have hIH := generated_le_join V R X h
  have hcover := residual_le_generated_sup_centralizer V R X h
  have hnormal := generated_normal_in_join V R X h hJI
  let L := pResidual 2 G
  let H := L ⊔ R
  let I := ⨆ i, X i
  have hLH : L ≤ H := le_sup_left
  have hRH : R ≤ H := le_sup_right
  have hIR : I ⊔ R = H := by
    apply le_antisymm (sup_le hIH hRH)
    exact sup_le (hcover.trans (sup_le_sup_left inf_le_left I)) le_sup_right
  let _ : (I.subgroupOf H).Normal := hnormal
  have htop : I.subgroupOf H ⊔ R.subgroupOf H = ⊤ := by
    apply map_injective H.subtype_injective
    rw [Subgroup.map_sup, map_subgroupOf_eq_of_le hIH, map_subgroupOf_eq_of_le hRH,
      hIR, ← MonoidHom.range_eq_map, H.range_subtype]
  have hp : IsPGroup 2 (H ⧸ I.subgroupOf H) :=
    isPGroup_quotient_of_sup_eq_top (I.subgroupOf H) (R.subgroupOf H)
      (h.R_two.comap_subtype (K := H)) htop
  let e := (subgroupOfEquivOfLe hLH).symm
  have hperfect : IsPPerfect 2 (L.subgroupOf H) :=
    (isPPerfect_pResidual (G := G) 2).of_surjective e.toMonoidHom e.surjective
  have hLi : L.subgroupOf H ≤ I.subgroupOf H :=
    (le_pResidual_of_isPPerfect _ hperfect).trans (sInf_le ⟨inferInstance, hp⟩)
  intro x hx
  exact hLi (show (⟨x, hLH hx⟩ : H) ∈ L.subgroupOf H from hx)

end CFSG.Quasithin.ChapterB.BaumannArgument
