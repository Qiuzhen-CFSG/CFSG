module

public import CFSG.Quasithin.ChapterB.Section02.OffenderFactorization
public import CFSG.Quasithin.ChapterB.Section01.SolvableStructure.SourceTheorems
public import CFSG.Quasithin.ChapterB.Section02.SolvableActionFactors.Subproduct
public import Theory.GroupTheory.ConjugateSpanSylow

/-!
# The relative Thompson span in a solvable binary action

For a normal elementary abelian module V and V≤R, take the faithful
centralizer quotient q. If J(R) acts nontrivially, B.2.10 supplies the
nonempty stable family of conjugates of images of A(R). We identify its
generated subgroup with the image of the literal normal span ⟨J(R)^G⟩.

The proved solvable FF theorem decomposes that subgroup into selected
commuting S₃ factors. The original three-rank bound limits the factor
family to two via the section obstruction, without asserting that prime
rank is monotone under arbitrary quotients. Thus the actual image of the
Thompson span is isomorphic to S₃ or S₃×S₃. The centralizer kernel is
retained; this does not identify the image with I/O₂(I).

Source: Aschbacher–Smith, B.1.8(5), B.2.10(1), and the stable-family
step of 13.4.8, printed pp. 70, 77, and 905. The 13.4.8 noncentrality and
single-factor arguments remain with qt-d-1341-solvable-source.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory Stellmacher Representation.BinaryOffender
open Representation
open scoped IsMulCommutative
namespace CFSG.Quasithin.ChapterB
variable {G H : Type*} [Group G] [Finite G] [Group H] [Finite H]

/-- The literal normal span has exactly the subgroup generated by the relative family. -/
theorem relative_thompson_span_image
    (V R : Subgroup G) [V.Normal] [IsElementaryAbelian 2 V] (hVR : V ≤ R)
    (q : G →* H) (hq : Function.Surjective q)
    (hker : q.ker = centralizer (V : Set G))
    (hJ : ¬ elementaryAbelianMaxJ R ≤ q.ker) :
    (conjugateSpanBy (elementaryAbelianMaxJ R) ⊤).map q =
      generatedBy (relativeMaxOffenderImages R V q) ⊤ := by
  have := (relativeMaxOffenderImages_generated_facts V R hVR q hq hker hJ).1
  rw [map_conjugateSpanBy, map_top_of_surjective q hq]
  apply le_antisymm
  · apply conjugateSpanBy_le ?_ le_normalizer_of_normal
    rw [map_le_iff_le_comap]
    apply sSup_le
    intro A hA
    apply map_le_iff_le_comap.mp
    by_cases hb : A.map q = ⊥
    · rw [hb]
      exact bot_le
    · apply le_generatedBy_top_of_mem
      refine ⟨A, hA, 1, ?_, hb⟩
      have hc : (MulAut.conj (1 : H)).toMonoidHom = MonoidHom.id H := by
        ext x
        simp
      rw [hc, map_id]
  · apply iSup_le
    intro E
    apply iSup_le
    rintro ⟨⟨A, hA, h, he, _⟩, _⟩
    rw [← he, conjugateSpanBy_eq_iSup_conj]
    apply le_iSup_of_le ⟨h, trivial⟩
    exact map_mono (map_mono (le_sSup hA))

private theorem stable_subgroup_models
    {W : Type*} [AddCommGroup W] [Module (ZMod 2) W] [FiniteDimensional (ZMod 2) W]
    (ρ : Representation (ZMod 2) H W)
    (hsolv : Group.IsSolvable H) (hcore : pCore 2 H = ⊥)
    (hfaith : Function.Injective ρ) (hff : IsFFModule ρ)
    (P : Set (Subgroup H)) (hP : IsStable ρ P)
    (q : G →* H) (hq : Function.Surjective q) (hrank : primeRank 3 G ≤ 2) :
    Nonempty ((generatedBy P ⊤) ≃* Equiv.Perm (Fin 3)) ∨
      Nonempty ((generatedBy P ⊤) ≃* (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3))) := by
  obtain ⟨d⟩ := solvableFFStructure_nonempty ρ hsolv hcore hfaith hff
  let S := d.toSolvableFFFactors.stableFactorSet P
  have hS : S.Nonempty :=
    d.toSolvableFFFactors.stableFactorSet_nonempty hfaith d.ratio_one hP
  have he : generatedBy P ⊤ = ⨆ i ∈ S, d.factor i :=
    d.toSolvableFFFactors.stable_generatedBy_eq hfaith d.ratio_one hP
  rw [he]
  exact d.toSolvableFFFactors.nonempty_subproduct_models
    (d.toSolvableFFFactors.count_eq_one_or_two_of_surjective_threeRank q hq hrank) S hS

/-- The faithful image of the actual Thompson span has one or two symmetric-three factors. -/
theorem relative_thompson_span_models
    (V R : Subgroup G) [V.Normal] [IsElementaryAbelian 2 V] (hVR : V ≤ R)
    (q : G →* H) (hq : Function.Surjective q)
    (hker : q.ker = centralizer (V : Set G))
    (hJ : ¬ elementaryAbelianMaxJ R ≤ q.ker)
    (hsolv : Group.IsSolvable G) (hcore : pCore 2 H = ⊥)
    (hrank : primeRank 3 G ≤ 2) :
    Nonempty (((conjugateSpanBy (elementaryAbelianMaxJ R) ⊤).map q) ≃*
      Equiv.Perm (Fin 3)) ∨
    Nonempty (((conjugateSpanBy (elementaryAbelianMaxJ R) ⊤).map q) ≃*
      (Equiv.Perm (Fin 3) × Equiv.Perm (Fin 3))) := by
  let := hsolv
  let ρ := NormalElementaryQuotient.representation V q hq hker
  have hs := lemma_B_2_10_relative V R hVR q hq hker hJ
  have hff : IsFFModule ρ := hs.1
  have hstable : IsStable ρ (relativeMaxOffenderImages R V q) := hs.2.1
  have hfaith : Function.Injective ρ :=
    NormalElementaryQuotient.representation_injective V q hq hker
  rw [relative_thompson_span_image V R hVR q hq hker hJ]
  exact stable_subgroup_models (W := Additive V) ρ
    (Group.isSolvable_of_surjective hq) hcore
    hfaith hff (relativeMaxOffenderImages R V q) hstable q hq hrank

end CFSG.Quasithin.ChapterB
