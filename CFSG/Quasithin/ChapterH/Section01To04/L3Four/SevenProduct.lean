public import Theory.AtlasPort.ExceptionalIsomorphisms.Simplicity

/-!
# Displacement with a fixed-free commuting group of order seven

Let F*(M) be the actual PSL₃(4), and let M × A act faithfully on a binary
module, with |A| = 7 and every nonidentity element of A fixed-point-free.
Every involution in M moves at least nine dimensions.

Restrict to the subgroup generated by F*(M) and the involution. Select a
simple product section detecting the perfect residual. Displacement below
nine preserves a simple residual constituent, since H.4.7 gives degree at
least nine; generation makes that restriction irreducible. The Schur field
then has order at most four. The order-seven action forces three copies,
and the H.4.7 involution bound contributes three dimensions on each.

Source: Aschbacher–Smith 5.1.17, printed p.641, using H.4.7, pp.382–383
(refs/quasithin.pdf). The Chapter6 DisplacementThree extension applies this
to the literal U/Z₁; no source seed geometry is assumed constructed here.
-/

public noncomputable section

open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open scoped MatrixGroups MonoidAlgebra
namespace CFSG.Quasithin.ChapterH.Section01To04.L3Four
variable {M A V : Type*} [Group M] [Finite M] [Group A] [Finite A]
  [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]

omit [Finite M] in
private theorem simple_model_structure (e : Matrix.PSL3Four.PSL ≃* M) :
    IsSimpleGroup M ∧ Group.IsPerfect M ∧ IsQuasisimple M := by
  let : IsSimpleGroup Matrix.PSL3Four.PSL := Atlas.psl_simple_high_rank 3 (by decide)
  let : Group.IsPerfect Matrix.PSL3Four.PSL := Atlas.psl_perfect 3 (by decide)
  let : IsSimpleGroup M := e.symm.isSimpleGroup
  let : Group.IsPerfect M := Group.IsPerfect.ofSurjective (f := e.toMonoidHom) e.surjective
  have hc : center M = ⊥ :=
    (IsSimpleGroup.eq_bot_or_eq_top_of_normal (center M) inferInstance).resolve_right
      (fun h => Group.IsPerfect.not_isMulCommutative M (center_eq_top_iff.mp h))
  exact ⟨inferInstance,inferInstance,⟨((QuotientGroup.quotientMulEquivOfEq hc).trans
    QuotientGroup.quotientBot).isSimpleGroup⟩⟩

omit [Finite M] in
private theorem simple_model_dimension (e : Matrix.PSL3Four.PSL ≃* M)
    (ρ : Representation (ZMod 2) M V) (hi : IsIrreducible ρ) (hf : Function.Injective ρ) :
    9 ≤ Module.finrank (ZMod 2) V := by
  let : IsQuasisimple M := (simple_model_structure e).2.2
  have ht : generalizedFitting M = ⊤ := generalizedFitting_eq_top_of_quasisimple
  let f : Matrix.PSL3Four.PSL ≃* generalizedFitting M :=
    e.trans (topEquiv.symm.trans (MulEquiv.subgroupCongr ht).symm)
  have hsur : Function.Surjective (generalizedFitting M).subtype := by
    intro m
    exact ⟨⟨m,ht ▸ mem_top m⟩,rfl⟩
  let : IsIrreducible (ρ.comp (generalizedFitting M).subtype) :=
    (irreducible_comp_surjective_iff _ hsur ρ).mpr hi
  rcases source_dimension_cases Matrix.PSL3Four.card_F f ρ hf with h | h | h <;> omega

set_option backward.isDefEq.respectTransparency false in
/-- Small displacement forces restriction to the actual simple residual to remain irreducible. -/
theorem generated_small_displacement_irreducible
    (e : Matrix.PSL3Four.PSL ≃* generalizedFitting M)
    (ρ : Representation (ZMod 2) M V) (hi : IsIrreducible ρ) (hf : Function.Injective ρ)
    (y : M) (hgen : generalizedFitting M ⊔ zpowers y = ⊤)
    (hsmall : fixedCodim ρ (zpowers y) < 9) :
    IsIrreducible (ρ.comp (generalizedFitting M).subtype) := by
  let K := generalizedFitting M
  let : IsSimpleGroup K := (simple_model_structure e).1
  have hn : ¬ K ≤ ρ.ker := by
    intro h
    have hz : K = ⊥ := bot_unique (h.trans ((MonoidHom.ker_eq_bot_iff _).mpr hf).le)
    exact (Subgroup.nontrivial_iff_ne_bot K).mp inferInstance hz
  apply SevenMultiplicity.restriction_irreducible_of_small_displacement ρ hi K y hgen
  intro J hJ
  have hfaith := SevenMultiplicity.simple_constituent_faithful ρ hi K hn J hJ
  have hd := simple_model_dimension e J.toRepresentation hJ hfaith
  rw [fixedCodim_zpowers_eq_displacement_rank] at hsmall
  exact lt_of_lt_of_le hsmall hd

set_option backward.isDefEq.respectTransparency false in
/-- Three-copy displacement on a homogeneous residual module. -/
theorem generated_homogeneous_seven_displacement
    (e : Matrix.PSL3Four.PSL ≃* generalizedFitting M)
    (σ : Representation (ZMod 2) M V) (τ : Representation (ZMod 2) A V)
    (I : Subrepresentation σ) (hI : IsIrreducible I.toRepresentation)
    (hhom : Homogeneous.homogeneousPart I ⊤ = ⊤)
    (hfaith : Function.Injective I.toRepresentation)
    (hcomm : ∀ a m v, τ a (σ m v) = σ m (τ a v))
    (hcard : Nat.card A = 7)
    (hfree : ∀ a : A, a ≠ 1 → ∀ v, τ a v = v → v = 0)
    (y : M) (hy : orderOf y = 2) (hgen : generalizedFitting M ⊔ zpowers y = ⊤) :
    9 ≤ fixedCodim σ (zpowers y) := by
  by_contra! hsmall
  have hmono := fixedCodim_subrepresentation_le σ I (zpowers y)
  have hir := generated_small_displacement_irreducible e I.toRepresentation hI hfaith y hgen
    (lt_of_le_of_lt hmono hsmall)
  let := hI
  let := hir
  have hSchur := source_schurField_card Matrix.PSL3Four.card_F e I.toRepresentation hfaith
  let : Nontrivial A := Finite.one_lt_card_iff_nontrivial.mp (by omega)
  obtain ⟨a,ha⟩ := exists_ne (1 : A)
  have ha7 : a ^ 7 = 1 := by rw [← hcard]; exact pow_card_eq_one'
  have hτ : τ a ≠ 1 := by
    intro hz
    let : Nontrivial I.toSubmodule := Subrepresentation.irreducible_module_nontrivial I.toRepresentation
    obtain ⟨v,hv⟩ := exists_ne (0 : I.toSubmodule)
    apply hv
    apply Subtype.ext
    exact hfree a ha v (LinearMap.congr_fun hz (v : V))
  have htriple := SevenMultiplicity.triple_fixedCodim_le_of_order_seven σ I hI hhom hSchur
    τ hcomm a ha7 hτ y
  have hthree := source_psl3Four_involution_displacement_ge_three e I.toRepresentation hfaith y hy
  rw [Module.End.one_eq_id, ← fixedCodim_zpowers_eq_displacement_rank] at hthree
  omega

set_option backward.isDefEq.respectTransparency false in
/-- The order-seven calculation for a group generated by its PSL₃(4) socle and the involution. -/
theorem generated_seven_product_displacement
    (e : Matrix.PSL3Four.PSL ≃* generalizedFitting M)
    (ρ : Representation (ZMod 2) (M × A) V) (hρ : Function.Injective ρ)
    (hcard : Nat.card A = 7)
    (hfree : ∀ a : A, a ≠ 1 → ∀ v, ρ (1,a) v = v → v = 0)
    (y : M) (hy : orderOf y = 2) (hgen : generalizedFitting M ⊔ zpowers y = ⊤) :
    9 ≤ fixedCodim ρ (zpowers (y,1)) := by
  let K := generalizedFitting M
  have hs := simple_model_structure e
  let : IsSimpleGroup K := hs.1
  let : Group.IsPerfect K := hs.2.1
  let R := K.map (MonoidHom.inl M A)
  let : Group.IsPerfect R := Group.IsPerfect.map _
  have hR : R ≠ ⊥ := by
    intro hz
    have hK : K = ⊥ := (K.map_eq_bot_iff_of_injective (fun x y h => congrArg Prod.fst h)).mp hz
    exact (Subgroup.nontrivial_iff_ne_bot K).mp inferInstance hK
  have hn : ¬ R ≤ ρ.ker := fun h =>
    hR (bot_unique (h.trans ((MonoidHom.ker_eq_bot_iff ρ).mpr hρ).le))
  obtain ⟨U,N,hi,hn,hfreeN,hd,hh⟩ := SevenMultiplicity.exists_product_section ρ R hn hfree
  let ψ := N.quotientRepresentation
  let σ := ψ.comp (MonoidHom.inl M A)
  let τ := ψ.comp (MonoidHom.inr M A)
  let := hi
  let : Nontrivial (U.toSubmodule ⧸ N.toSubmodule) :=
    Subrepresentation.irreducible_module_nontrivial ψ
  obtain ⟨I,hI⟩ := Subrepresentation.irreducible_subrepresentation_of_finite_dimensional σ
  have hhom := hh I hI
  have hfaith : Function.Injective I.toRepresentation := by
    apply SevenMultiplicity.faithful_constituent_of_surviving_simple σ K
      (SimpleSocle.centralizer_eq_bot (Group.IsPerfect.not_isMulCommutative K)) _ I hhom
    intro hk
    apply hn
    rintro _ ⟨k,hkK,rfl⟩
    exact hk hkK
  have heq : fixedCodim σ (zpowers y) = fixedCodim ψ (zpowers (y,1)) := by
    unfold fixedCodim
    rw [fixedSpace_comp_map,MonoidHom.map_zpowers]
    rfl
  have hcomm (a : A) (m : M) (v : U.toSubmodule ⧸ N.toSubmodule) :
      τ a (σ m v) = σ m (τ a v) := by
    change ψ (1,a) (ψ (m,1) v) = ψ (m,1) (ψ (1,a) v)
    simp only [← Module.End.mul_apply,← map_mul,Prod.mk_mul_mk,one_mul,mul_one]
  have hb := generated_homogeneous_seven_displacement e σ τ I hI hhom hfaith
    hcomm hcard hfreeN y hy hgen
  exact hb.trans (heq.le.trans (hd y))
end CFSG.Quasithin.ChapterH.Section01To04.L3Four

namespace CFSG.Quasithin.ChapterH.Section01To04.L3Four
variable {M A V : Type*} [Group M] [Finite M] [Group A] [Finite A]
  [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]

set_option backward.isDefEq.respectTransparency false in
/-- Every involution in the first factor moves at least nine dimensions when
a commuting group of order seven acts fixed-point-freely. -/
theorem seven_product_displacement
    (e : Matrix.PSL3Four.PSL ≃* generalizedFitting M)
    (ρ : Representation (ZMod 2) (M × A) V) (hρ : Function.Injective ρ)
    (hcard : Nat.card A = 7)
    (hfree : ∀ a : A, a ≠ 1 → ∀ v, ρ (1,a) v = v → v = 0)
    (y : M) (hy : orderOf y = 2) :
    9 ≤ fixedCodim ρ (zpowers (y,1)) := by
  let K := generalizedFitting M
  let J := K ⊔ zpowers y
  have hKJ : K ≤ J := le_sup_left
  let D := K.subgroupOf J
  let f : D ≃* K := subgroupOfEquivOfLe hKJ
  have hs := simple_model_structure e
  let : IsSimpleGroup K := hs.1
  let : Group.IsPerfect K := hs.2.1
  let : IsQuasisimple K := hs.2.2
  let : IsQuasisimple D := IsQuasisimple.of_mulEquiv f.symm
  have hc : centralizer (D : Set J) = ⊥ := by
    apply le_bot_iff.mp
    intro x hx
    have hh : (x : M) ∈ centralizer (K : Set M) := by
      rw [mem_centralizer_iff]
      intro k hk
      exact congrArg Subtype.val (mem_centralizer_iff.mp hx ⟨k,hKJ hk⟩ hk)
    rw [SimpleSocle.centralizer_eq_bot (Group.IsPerfect.not_isMulCommutative K),mem_bot] at hh
    exact Subtype.ext hh
  have hfit : generalizedFitting J = D := generalizedFitting_eq_of_quasisimple_centralizer D hc
  let eJ : Matrix.PSL3Four.PSL ≃* generalizedFitting J :=
    e.trans (f.symm.trans (MulEquiv.subgroupCongr hfit).symm)
  let t : J := ⟨y,mem_sup_right (mem_zpowers y)⟩
  have hgen : generalizedFitting J ⊔ zpowers t = ⊤ := by
    rw [hfit]
    apply map_injective J.subtype_injective
    rw [Subgroup.map_sup,map_subgroupOf_eq_of_le hKJ,MonoidHom.map_zpowers,← MonoidHom.range_eq_map,range_subtype]
    rfl
  let ι : J × A →* M × A := J.subtype.prodMap (MonoidHom.id A)
  have hι : Function.Injective ι := by
    intro a b h
    apply Prod.ext
    · exact Subtype.ext (congrArg Prod.fst h)
    · exact congrArg (fun z : M × A => z.2) h
  have hb := generated_seven_product_displacement eJ (ρ.comp ι) (hρ.comp hι) hcard
    (fun a ha v hv => hfree a ha v hv) t ((Subgroup.orderOf_coe t).symm.trans hy) hgen
  convert hb using 1
  unfold fixedCodim
  rw [fixedSpace_comp_map,MonoidHom.map_zpowers]
  rfl
end CFSG.Quasithin.ChapterH.Section01To04.L3Four
