module

public import CFSG.Quasithin.ChapterH.Section05To09.NaturalDual.SourceFiveActors.Radical

/-!
# Outer involutions on the source natural-plus-dual module

The constructed marked model transports the single outer-involution class,
the actual relative S₆ centralizer and its representation. The fixed-space
comparison retains the literal map w ↦ w + t.w. Its decomposition uses the
actual source commutator, with a compatible equivalence from the natural
four-dimensional S₆ module.

Source: Aschbacher–Smith H.9.2(1), printed p.390.
-/

@[expose] public section
open BinaryNaturalDual BinaryNaturalDual.ModelOrbits
open Theory.GroupTheory Theory.SpecificGroups.SymmetricSix
namespace CFSG.Quasithin.ChapterH.NaturalDual.SourceFiveActors
variable {M V : Type*} [Group M] [AddCommGroup V] [Module (ZMod 2) V]
  (S : SourceSetup 5 M V)

include S in
/-- Any two outer involutions of the original group are conjugate in that group. -/
theorem outer_conjugate (s t : M) (hs : s ^ 2 = 1) (ht : t ^ 2 = 1)
    (hsout : s ∉ componentLayer M) (htout : t ∉ componentLayer M) :
    ∃ a : M, MulAut.conj a s = t := by
  obtain ⟨a,ha⟩ := BinaryNaturalDual.FiveActors.outer_conjugate (S.model.group s)
    (S.model.group t) (by simpa only [map_pow, map_one] using congrArg S.model.group hs)
    (by simpa only [map_pow, map_one] using congrArg S.model.group ht)
    (fun h => hsout ((S.model.inner_iff s).mp h))
    (fun h => htout ((S.model.inner_iff t).mp h))
  refine ⟨S.model.group.symm a, S.model.group.injective ?_⟩
  simpa only [MulAut.conj_apply, map_mul, map_inv, S.model.group.apply_symm_apply] using ha

/-- C_V(t), expressed using the cyclic actor generated by t. -/
noncomputable def involutionFixed (t : M) : Submodule (ZMod 2) V :=
  S.fixed (Subgroup.zpowers t)

/-- The exact ambient commutator [C_V(t),C_L(t)]. -/
noncomputable def centralizerMoving (t : M) : Submodule (ZMod 2) V :=
  commutator S (involutionFixed S t) (centralizer S t)

variable (t : M) (ht : t ^ 2 = 1) (hout : t ∉ componentLayer M)

include ht in
theorem model_square : (S.model.group t) ^ 2 = 1 := by
  simpa only [map_pow, map_one] using congrArg S.model.group ht

include hout in
theorem model_outer : S.model.group t ∉ BinaryNaturalDual.FiveActors.L :=
  fun h => hout ((S.model.inner_iff t).mp h)

include ht hout

theorem involutionFixed_map :
    (involutionFixed S t).map S.model.coordinates.toLinearMap =
      BinaryNaturalDual.fixedSpace (AdaptedPair.linearAction
        (AutomorphismModel.coordinateAction S.degree) (S.model.group t)) := by
  rw [involutionFixed, S.fixed_map, MonoidHom.map_zpowers]
  exact (BinaryNaturalDual.FiveActors.outer_fixed_eq_cyclic_fixedSpace _ _
    (model_square S t ht) (model_outer S t hout)).symm

/-- The source fixed space and the coordinate fixed space, under the same model. -/
noncomputable def fixedEquiv : involutionFixed S t ≃ₗ[ZMod 2]
    BinaryNaturalDual.fixedSpace (AdaptedPair.linearAction
      (AutomorphismModel.coordinateAction S.degree) (S.model.group t)) :=
  (S.model.coordinates.submoduleMap (involutionFixed S t)).trans
    (LinearEquiv.ofEq _ _ (involutionFixed_map S t ht hout))

@[simp] theorem fixedEquiv_apply (v : involutionFixed S t) :
    (fixedEquiv S t ht hout v : CoordinateSpace 5) = S.model.coordinates v := rfl

/-- The literal diagonal map on the original natural summand. -/
noncomputable def diagonal : S.natural ≃ₗ[ZMod 2] involutionFixed S t :=
  S.naturalCoordinates.trans
    ((BinaryNaturalDual.FiveActors.ModuleGeometry.diagonal
      (AutomorphismModel.coordinateAction S.degree) (S.model.group t)
      (model_square S t ht) (model_outer S t hout)).trans (fixedEquiv S t ht hout).symm)

theorem diagonal_apply (w : S.natural) :
    (diagonal S t ht hout w : V) = (w : V) + S.representation t w := by
  apply S.model.coordinates.injective
  change (fixedEquiv S t ht hout (diagonal S t ht hout w) : CoordinateSpace 5) = _
  simp only [diagonal, LinearEquiv.trans_apply, LinearEquiv.apply_symm_apply,
    BinaryNaturalDual.FiveActors.ModuleGeometry.diagonal_apply,
    map_add, S.model.equivariant, S.model.natural_marking]

theorem diagonal_equivariant (a : centralizer S t) (w : S.natural) :
    (diagonal S t ht hout (naturalAction S ⟨a.val,a.property.1⟩ w) : V) =
      S.representation a.val (diagonal S t ht hout w) := by
  rw [diagonal_apply, naturalAction_apply, diagonal_apply, map_add]
  congr 1
  have h := congrArg (fun g : M => S.representation g (w : V))
    (Subgroup.mem_centralizer_singleton_iff.mp a.property.2)
  simpa only [map_mul, Module.End.mul_apply] using h.symm

/-- The source fixed space equals the actual cyclic commutator [V,t]. -/
theorem involutionFixed_eq_commutator :
    involutionFixed S t = commutator S ⊤ (Subgroup.zpowers t) := by
  apply Submodule.map_injective_of_injective S.model.coordinates.injective
  rw [involutionFixed_map S t ht hout, commutator_map, MonoidHom.map_zpowers]
  simpa using BinaryNaturalDual.FiveActors.outer_fixed_eq_cyclic_commutator
    (AutomorphismModel.coordinateAction S.degree) (S.model.group t)
    (model_square S t ht) (model_outer S t hout)

theorem involutionFixed_finrank : Module.finrank (ZMod 2) (involutionFixed S t) = 5 :=
  (fixedEquiv S t ht hout).finrank_eq.trans
    (BinaryNaturalDual.FiveActors.ModuleGeometry.fixed_finrank _ _
      (model_square S t ht) (model_outer S t hout))

theorem centralizerMoving_map :
    (centralizerMoving S t).map S.model.coordinates.toLinearMap =
      BinaryNaturalDual.FiveActors.ModuleGeometry.ambientCommutator
        (AutomorphismModel.coordinateAction S.degree) (S.model.group t) := by
  rw [centralizerMoving, commutator_map, involutionFixed_map S t ht hout, centralizer_map]
  exact (BinaryNaturalDual.FiveActors.ambientCommutator_eq_subspaceCommutator _ _).symm

/-- A natural-module equivalence to the actual ambient source commutator. -/
noncomputable def movingEquiv : centralizerMoving S t ≃ₗ[ZMod 2]
    BinaryNaturalDual.FiveActors.ModuleGeometry.ambientCommutator
      (AutomorphismModel.coordinateAction S.degree) (S.model.group t) :=
  (S.model.coordinates.submoduleMap (centralizerMoving S t)).trans
    (LinearEquiv.ofEq _ _ (centralizerMoving_map S t ht hout))

@[simp] theorem movingEquiv_apply (v : centralizerMoving S t) :
    (movingEquiv S t ht hout v : CoordinateSpace 5) = S.model.coordinates v := rfl

/-- Full source decomposition, including the group and representation comparisons. -/
theorem outer_decomposition :
    ∃ (v : involutionFixed S t) (e : centralizer S t ≃* S6)
      (η : NaturalModule ≃ₗ[ZMod 2] centralizerMoving S t),
      S.quadratic (v : V) = 1 ∧
      (∀ a : centralizer S t, S.representation a.val v = v) ∧
      involutionFixed S t = Submodule.span (ZMod 2) {(v : V)} ⊔ centralizerMoving S t ∧
      Disjoint (Submodule.span (ZMod 2) {(v : V)}) (centralizerMoving S t) ∧
      Module.finrank (ZMod 2) (Submodule.span (ZMod 2) {(v : V)}) = 1 ∧
      Module.finrank (ZMod 2) (centralizerMoving S t) = 4 ∧
      ∀ (a : centralizer S t) (w : NaturalModule),
        (η (polarAction (e a) w) : V) = S.representation a.val (η w) := by
  let d := AutomorphismModel.coordinateAction S.degree
  let t' := S.model.group t
  obtain ⟨v,e,η,hq,hfix,_hcompl,hsum,hdis,hline,hdim,hη⟩ :=
    BinaryNaturalDual.FiveActors.ModuleGeometry.outer_fixed_decomposition d t'
      (model_square S t ht) (model_outer S t hout)
  let v' := (fixedEquiv S t ht hout).symm v
  let e' := (centralizerEquiv S t).trans e
  let J := Submodule.equivMapOfInjective
    (BinaryNaturalDual.fixedSpace (AdaptedPair.linearAction d t')).subtype
    (BinaryNaturalDual.fixedSpace (AdaptedPair.linearAction d t')).injective_subtype
    (BinaryNaturalDual.FiveActors.ModuleGeometry.centralizerCommutator d t')
  let η' := η.trans (J.trans (movingEquiv S t ht hout).symm)
  have hv : S.model.coordinates (v' : V) = (v : CoordinateSpace 5) :=
    congrArg Subtype.val ((fixedEquiv S t ht hout).apply_symm_apply v)
  have hη' (w : NaturalModule) :
      S.model.coordinates (η' w : V) = ((η w : BinaryNaturalDual.fixedSpace
        (AdaptedPair.linearAction d t')) : CoordinateSpace 5) :=
    congrArg Subtype.val ((movingEquiv S t ht hout).apply_symm_apply (J (η w)))
  have hspan : (Submodule.span (ZMod 2) {(v' : V)}).map S.model.coordinates.toLinearMap =
      Submodule.span (ZMod 2) {(v : CoordinateSpace 5)} := by
    rw [Submodule.map_span, Set.image_singleton]
    exact congrArg (fun z : CoordinateSpace 5 => Submodule.span (ZMod 2) {z}) hv
  refine ⟨v',e',η',?_,?_,?_,?_,?_,?_,?_⟩
  · rw [S.quadratic_apply, hv]
    exact hq
  · intro a
    apply S.model.coordinates.injective
    rw [S.model.equivariant, hv]
    exact hfix (centralizerEquiv S t a)
  · apply Submodule.map_injective_of_injective S.model.coordinates.injective
    rw [involutionFixed_map S t ht hout, Submodule.map_sup, hspan,
      centralizerMoving_map S t ht hout]
    exact hsum
  · apply (disjoint_iff).mpr
    apply Submodule.map_injective_of_injective S.model.coordinates.injective
    rw [Submodule.map_inf _ S.model.coordinates.injective, hspan,
      centralizerMoving_map S t ht hout, disjoint_iff.mp hdis, Submodule.map_bot]
  · have h := (S.model.coordinates.submoduleMap
      (Submodule.span (ZMod 2) {(v' : V)})).finrank_eq
    rw [hspan, hline] at h
    exact h
  · exact (movingEquiv S t ht hout).finrank_eq.trans (J.finrank_eq.symm.trans hdim)
  · intro a w
    apply S.model.coordinates.injective
    rw [hη', S.model.equivariant, hη']
    exact hη (centralizerEquiv S t a) w

end CFSG.Quasithin.ChapterH.NaturalDual.SourceFiveActors
