module

public import CFSG.Quasithin.ChapterH.Section13To16.CocodeLocal.Octad.Geometry
public import Theory.Representation.MathieuCodeRestriction.CocodeLocal.Octad.Involutions

/-!
# Native representative calculations for H.14.4(3) and H.15.2(5)

The imported native representatives have order two and respectively an octad
and an empty fixed set on the twenty-four points. Their literal cocode fixed
codimensions are four and five. In the first case, the pointwise centralizer
of the fixed space is exactly the cyclic group generated by the involution.
Conjugation and literal restriction along the M23 point embedding transport
these results. Class coverage and the characterization of two-central
involutions are separate inputs to the source-theorem assembly.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
H.14.4(3) and H.15.2(5), printed pp.397–399.
-/

public section

noncomputable section
namespace CFSG.Quasithin.ChapterH.Section13To16.CocodeLocal

open Sporadic.Mathieu MathieuCode Representation.BinaryOffender

/-- The rank-four branch, conditional only on native conjugacy to the
verified octad-fixing representative. -/
theorem involution_octad_fixedCodim (x : M24)
    (hx : IsConj CocodeOctad.Involutions.z x) :
    fixedCodim cocodeRepresentation (Subgroup.zpowers x) = 4 :=
  CocodeOctad.Involutions.fixedCodim_of_isConj_z x hx

/-- The rank-five branch for a conjugate of the verified fixed-point-free
native representative. -/
theorem involution_fixedPointFree_fixedCodim (x : M24)
    (hx : IsConj CocodeOctad.Involutions.t x) :
    fixedCodim cocodeRepresentation (Subgroup.zpowers x) = 5 :=
  CocodeOctad.Involutions.fixedCodim_of_isConj_t x hx

/-- The genuine pointwise centralizer assertion transported by conjugacy. -/
theorem involution_octad_pointwiseCentralizer (x : M24)
    (hx : IsConj CocodeOctad.Involutions.z x) :
    subspaceKernel cocodeRepresentation
      (fixedSpace cocodeRepresentation (Subgroup.zpowers x)) ⊤ = Subgroup.zpowers x :=
  CocodeOctad.Involutions.pointwiseCentralizer_of_isConj_z x hx

/-- Restriction to the actual M23 point stabilizer preserves the fixed codimension. -/
theorem m23_involution_fixedCodim (x : M23)
    (hx : IsConj CocodeOctad.Involutions.z (pointEmbedding x)) :
    fixedCodim m23CocodeRepresentation (Subgroup.zpowers x) = 4 :=
  CocodeOctad.Involutions.m23_fixedCodim_of_isConj_z x hx

/-- The centralizer is pointwise in the native M23 actor as well. -/
theorem m23_involution_pointwiseCentralizer (x : M23)
    (hx : IsConj CocodeOctad.Involutions.z (pointEmbedding x)) :
    subspaceKernel m23CocodeRepresentation
      (fixedSpace m23CocodeRepresentation (Subgroup.zpowers x)) ⊤ = Subgroup.zpowers x :=
  CocodeOctad.Involutions.m23_pointwiseCentralizer_of_isConj_z x hx

end CFSG.Quasithin.ChapterH.Section13To16.CocodeLocal
