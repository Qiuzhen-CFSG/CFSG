module

public import CFSG.Quasithin.ChapterH.Section13To16.Defs
public import Theory.Representation.MathieuCodeRestriction.CocodeLocal
public import Theory.Representation.BinaryOffender.SubspaceAction

/-!
# Geometric subspaces for the local cocode flags

The octad space is generated by classes of pairs inside the octad. The
sextet and trio spaces are generated by pairs lying inside one part of the
respective partition. Thus the proposed flag terms are concrete subspaces
of the native Golay quotient, independently of all dimension and action
calculations. Fixed spaces and kernels retain the intrinsic two-cores of
the actual native stabilizers.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
H.15.2–3 and H.15.6–8, printed pp.398–402. The middle section of H.15.6
is `V₉/V₃`: the printed `V₉/V` is incompatible with its flag.
-/

@[expose] public section

noncomputable section
namespace CFSG.Quasithin.ChapterH.Section13To16.CocodeLocal

open Sporadic.Mathieu Sporadic.Mathieu.M24LocalGeometry
open Sporadic.Mathieu.M24LocalGeometry.PairOvergroups
open MathieuCode Representation.BinaryOffender

/-- The image of the even subsets of the octad, generated by its pairs. -/
def octadPairSpace (O : Octad) : Submodule (ZMod 2) Cocode :=
  supportedPairSpace O.val

/-- The geometric middle term of the sextet flag. -/
def sextetPairSpace (S : Sextet) : Submodule (ZMod 2) Cocode :=
  ⨆ B ∈ S.parts, supportedPairSpace B

/-- The geometric middle term of the trio flag. -/
def trioPairSpace (T : Trio) : Submodule (ZMod 2) Cocode :=
  ⨆ B ∈ T.parts, supportedPairSpace B

/-- The bottom nonzero term of the sextet flag, specified intrinsically. -/
def sextetFixedSpace (S : Sextet) : Submodule (ZMod 2) Cocode :=
  fixedSpace cocodeRepresentation (sextetKernel S)

/-- The bottom nonzero term of the trio flag, specified intrinsically. -/
def trioFixedSpace (T : Trio) : Submodule (ZMod 2) Cocode :=
  fixedSpace cocodeRepresentation (trioKernel T)

/-- Refining the trio partition gives containment of its geometric pair spaces. -/
theorem sextetPairSpace_le_trioPairSpace (S : Sextet) (T : Trio)
    (hrefines : ∀ B ∈ S.parts, ∃ O ∈ T.parts, B ⊆ O) :
    sextetPairSpace S ≤ trioPairSpace T := by
  refine iSup_le fun B => iSup_le fun hB => ?_
  obtain ⟨O, hO, hBO⟩ := hrefines B hB
  exact le_iSup_of_le O (le_iSup_of_le hO (supportedPairSpace_mono hBO))

/-- The chosen trio pairs consecutive tetrads of the chosen sextet. -/
theorem standardSextet_refines_standardTrio :
    ∀ B ∈ standardSextet.parts, ∃ O ∈ standardTrio.parts, B ⊆ O := by
  intro B hB
  obtain ⟨i, _, rfl⟩ := Finset.mem_image.mp hB
  let j : Fin 3 := ⟨i.val / 2, by omega⟩
  refine ⟨standardTrioOctad j, Finset.mem_image.mpr ⟨j, Finset.mem_univ _, rfl⟩, ?_⟩
  fin_cases i <;> decide +kernel

/-- The geometric containment underlying H.15.8 for the compatible markings. -/
theorem standard_sextetPairSpace_le_trioPairSpace :
    sextetPairSpace standardSextet ≤ trioPairSpace standardTrio :=
  sextetPairSpace_le_trioPairSpace _ _ standardSextet_refines_standardTrio

end CFSG.Quasithin.ChapterH.Section13To16.CocodeLocal
