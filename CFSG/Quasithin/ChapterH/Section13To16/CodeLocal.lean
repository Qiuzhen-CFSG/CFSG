module

public import CFSG.Quasithin.ChapterH.Section13To16.CodeLocal.Spaces
public import Theory.Representation.MathieuCodeRestriction.CodeLocal.FixedLift

/-!+# The native octad fixed line in H.16.2

The source kernel is the intrinsic two-core of the octad stabilizer, mapped
into M24. Its equality with the actual pointwise restriction kernel connects
the native Golay calculation to this source convention. For an octad through
the distinguished point, the entire kernel lies in the native M23 embedding,
so restriction retains exactly the same fixed space.

Source: Aschbacher--Smith, H.16.2(1), printed p.402, and the restrictions
in H.16.4 and H.16.8, printed pp.403,405. The higher chief factors and the
common-four calculations are separate obligations.
-/

public section

namespace CFSG.Quasithin.ChapterH.Section13To16

open Sporadic.Mathieu Sporadic.Mathieu.M24LocalGeometry
open Representation.BinaryOffender

/-- The source octad two-core is exactly its native pointwise restriction kernel. -/
theorem octadKernel_eq_pointwiseKernel (O : Octad) :
    octadKernel O = MathieuCode.octadPointwiseKernel O :=
  MathieuCode.octad_core_map_eq_pointwise O

/-- The source octad kernel fixes precisely the line generated by the octad word. -/
theorem octadKernel_fixedSpace_eq_span (O : Octad) :
    fixedSpace MathieuCode.codeRepresentation (octadKernel O) =
      Submodule.span (ZMod 2) {MathieuCode.octadVector O} := by
  rw [octadKernel_eq_pointwiseKernel]
  exact MathieuCode.octad_fixedSpace_eq_span O

/-- The fixed-line dimension of H.16.2(1), with the source two-core convention. -/
theorem octadKernel_fixedSpace_finrank (O : Octad) :
    Module.finrank (ZMod 2)
      (fixedSpace MathieuCode.codeRepresentation (octadKernel O)) = 1 := by
  rw [octadKernel_eq_pointwiseKernel]
  exact MathieuCode.octad_fixedSpace_finrank O

/-- An octad through the distinguished point has its whole kernel in native M23. -/
theorem m23OctadKernel_map (O : Octad) (hO : (0 : Fin 24) ∈ O.val) :
    (m23OctadKernel O).map MathieuCode.pointEmbedding = octadKernel O := by
  apply Subgroup.map_comap_eq_self
  rw [MathieuCode.pointEmbedding_range, octadKernel_eq_pointwiseKernel]
  intro g hg
  exact (MathieuCode.mem_octadPointwiseKernel O g).mp hg 0 hO

/-- Restriction to native M23 retains the entire octad-kernel fixed space. -/
theorem m23OctadKernel_fixedSpace (O : Octad) (hO : (0 : Fin 24) ∈ O.val) :
    fixedSpace MathieuCode.m23CodeRepresentation (m23OctadKernel O) =
      fixedSpace MathieuCode.codeRepresentation (octadKernel O) := by
  change fixedSpace (MathieuCode.codeRepresentation.comp MathieuCode.pointEmbedding)
    (m23OctadKernel O) = _
  rw [fixedSpace_comp_map, m23OctadKernel_map O hO]

/-- The heptad restriction has the same one-dimensional code fixed space. -/
theorem m23OctadKernel_fixedSpace_finrank (O : Octad) (hO : (0 : Fin 24) ∈ O.val) :
    Module.finrank (ZMod 2)
      (fixedSpace MathieuCode.m23CodeRepresentation (m23OctadKernel O)) = 1 := by
  rw [m23OctadKernel_fixedSpace O hO, octadKernel_fixedSpace_finrank]

end CFSG.Quasithin.ChapterH.Section13To16
