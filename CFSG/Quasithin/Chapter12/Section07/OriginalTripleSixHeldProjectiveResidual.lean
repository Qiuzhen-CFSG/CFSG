module

public import CFSG.Quasithin.Chapter12.Section07.OriginalTripleSixHeldProjectiveExtension
import Theory.GroupTheory.PResidual.FiniteLocalPair
import Theory.GroupTheory.PResidual.PerfectImage

/-!
# The actual two-residual of the original component normalizer

The already marked PGL3(4) extension is precisely the inverse image of the
inner-diagonal subgroup under the full normalizer action. That subgroup is
normal of index dividing four. The extension is two-perfect, since it is
generated by the perfect component and the original two-residual X.
Thus it is the literal two-residual of the full component normalizer.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter12.Section07
open Section02 ChapterB.QuasisimpleSource
open Matrix.PSL3.OuterSolvable Matrix.PSL3Four.OuterThreeStructure
open Theory.GroupAction.ComponentRankAction
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {K U : Subgroup G}

/-- The original B X is the full two-residual in N_G(B), with its exact
ambient embedding and an index dividing four. -/
theorem original_tripleSix_held_projective_residual
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T K)
    (structural : Structural1222At KnownSimple.IsKnownSimple T)
    (D : ChosenModule T K U)
    (a : ActionEquiv D.quotientAction Hexacode.evenAction) (t : U) (ht : t ≠ 1)
    (heven : 2 ∣ (centralizer ({(t : G)} : Set G)).relIndex K)
    (hB : let H := centralizer ({(t : G)} : Set G)
      let Lt := (pResidual 2 (K ⊓ H : Subgroup G)).map (K ⊓ H).subtype
      IsComponent H ((conjugateSpanBy Lt H).subgroupOf H))
    (hcenter :
      let Lt := (pResidual 2 (K ⊓ centralizer ({(t : G)} : Set G) : Subgroup G)).map
        (K ⊓ centralizer ({(t : G)} : Set G)).subtype
      centerIn (conjugateSpanBy Lt (centralizer ({(t : G)} : Set G))) = tripleSixPoint D a t)
    (e :
      let Lt := (pResidual 2 (K ⊓ centralizer ({(t : G)} : Set G) : Subgroup G)).map
        (K ⊓ centralizer ({(t : G)} : Set G)).subtype
      let B := conjugateSpanBy Lt (centralizer ({(t : G)} : Set G))
      B ⧸ center B ≃* Matrix.PSL3Four.PSL) :
    let H := centralizer ({(t : G)} : Set G)
    let Lt := (pResidual 2 (K ⊓ H : Subgroup G)).map (K ⊓ H).subtype
    let B := conjugateSpanBy Lt H
    let X := tripleSixScalarResidual K
    let N := normalizer (B : Set G)
    (pResidual 2 N).map N.subtype = B ⊔ X ∧ (B ⊔ X).relIndex N ∣ 4 := by
  let H := centralizer ({(t : G)} : Set G)
  let Lt := (pResidual 2 (K ⊓ H : Subgroup G)).map (K ⊓ H).subtype
  let B := conjugateSpanBy Lt H
  let X := tripleSixScalarResidual K
  let W := B ⊔ X
  let N := normalizer (B : Set G)
  let A := W.subgroupOf N
  let J := innerDiagonal Matrix.PSL3Four.F
  let ρ := action B e
  obtain ⟨hWN,f,hf,_,hmark⟩ := original_tripleSix_held_projective_extension
    h structural D a t ht heven hB hcenter e
  let : Group.IsPerfect Lt := tripleSixPointCentralizerResidual_perfect D a t ht heven
  let : Group.IsPerfect B := conjugateSpanBy_isPerfect Lt H
  obtain ⟨hCB,_,_,_⟩ := original_tripleSix_held_component_normalizer
    h structural D a t ht heven hB hcenter e
  have hV : tripleSixPoint D a t ≤ B := by
    rw [←hcenter]
    exact inf_le_left
  have hkA : ρ.ker ≤ A := by
    rw [show ρ = action B e from rfl,ker_eq,hCB]
    exact subgroupOf_mono N (hV.trans le_sup_left)
  have hAJ : A.map ρ = J := by
    apply le_antisymm
    · rintro _ ⟨n,hn,rfl⟩
      let w : W := ⟨n,hn⟩
      have hwmark : (pglEquiv (f w)).val = ρ n := hmark w
      rw [←hwmark]
      exact (pglEquiv (f w)).property
    · intro j hj
      obtain ⟨w,hw⟩ := hf (pglEquiv.symm ⟨j,hj⟩)
      refine ⟨inclusion hWN w,w.property,?_⟩
      rw [←hmark w,hw,pglEquiv.apply_symm_apply]
  have hJr : J ≤ ρ.range := hAJ ▸ A.map_le_range ρ
  have hpre : J.comap ρ = A := by
    rw [←hAJ,comap_map_eq_self hkA]
  have hd : A.index ∣ 4 := by
    rw [←hpre,index_comap]
    exact (relIndex_dvd_index_of_le hJr).trans diagonal_index_dvd_four
  have hJn : J.Normal := by
    apply normalizer_eq_top_iff.mp
    apply top_unique
    rw [←standard_eq_top_of_two_power_card Matrix.PSL3Four.F (m := 2)
      (by decide) (by simpa using Matrix.PSL3Four.card_F)]
    exact standard_le_normalizer_innerDiagonal
  let := hJn
  let : A.Normal := hpre ▸ inferInstanceAs (J.comap ρ).Normal
  have hXp : IsPPerfect 2 X := by
    let Z := centralPreimage (pCore 2 K)
    let R := (pResidual 2 Z).map Z.subtype
    let ex := R.equivMapOfInjective K.subtype K.subtype_injective
    exact (isPPerfect_embedded_pResidual_of_finite 2 Z).of_surjective ex.toMonoidHom ex.surjective
  have hBp : IsPPerfect 2 B :=
    (pResidual_eq_top_iff 2 B).mp (pResidual_eq_top_of_isPerfect 2)
  have hWp : IsPPerfect 2 W := isPPerfect_sup B X hBp hXp
  have hAp : IsPPerfect 2 A := hWp.of_surjective
    (subgroupOfEquivOfLe hWN).symm.toMonoidHom (subgroupOfEquivOfLe hWN).symm.surjective
  have hquot : IsPGroup 2 (N ⧸ A) := IsPGroup.of_card_dvd_pow (n := 2) hd
  have hr : pResidual 2 N = A := pResidual_eq_of_isPPerfect A hAp hquot
  refine ⟨?_,hd⟩
  rw [hr,map_subgroupOf_eq_of_le hWN]

end CFSG.Quasithin.Chapter12.Section07
