module

public import CFSG.Quasithin.Chapter12.Section07.OriginalTripleSixCentralClosureConfiguration
public import CFSG.Quasithin.Chapter12.Section07.OriginalTripleSixContainedCubicResidual
import Theory.ElementaryAbelian.EightQuotientRank

/-!
# The faithful action on the original central closure quotient

The action kernel is exactly C_H(W/<z>), with the original R, L1, H and W.
The reduced G.2.2 image makes its faithful quotient have trivial two-core.
The original U has nontrivial image, of order at most sixteen; its whole
image is generated by commutators with the actual non-scalar residual L1.

Source: Aschbacher--Smith12.7.15(1),(4), printed p.843.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter12.Section07
open Section02 ChapterB.QuasisimpleSource Atlas.Codes
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {K U : Subgroup G}

/-- The full faithful quotient of the literal closure action, including the
unchanged whole-module image and its genuine cubic generation. -/
theorem original_tripleSix_central_closure_action
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T K)
    (structural : Structural1222At KnownSimple.IsKnownSimple T)
    (D : ChosenModule T K U) (a : ActionEquiv D.quotientAction Hexacode.evenAction)
    (z : U) (hz : z ≠ 1)
    (hzT : (T : Subgroup G) ≤ centralizer ({(z:G)} : Set G))
    (hnot : ¬ U ≤ (centralizer ({(z:G)} : Set G)).pCoreIn 2) :
    let C := centralizer ({(z:G)} : Set G)
    let J := tripleSixWeightFourResidual K z
    let R := conjugateSpanBy U C
    let H := R ⊔ J ⊔ (T : Subgroup G)
    let V1 := tripleSixPoint D a z
    let W := conjugateSpanBy V1 R
    ∃ (N : Subgroup H) (hN : N.Normal),
      letI := hN
      (∀ x : H, x ∈ N ↔ ∀ w ∈ W, ⁅w,(x:G)⁆ ∈ zpowers (z:G)) ∧
      pCore 2 (H ⧸ N) = ⊥ ∧
      (V1.subgroupOf H) ≤ N ∧
      let q := QuotientGroup.mk' N
      let A := (U.subgroupOf H).map q
      A ≠ ⊥ ∧ IsElementaryAbelian 2 A ∧ Nat.card A ≤ 16 ∧
        A = ⁅A,(J.subgroupOf H).map q⁆ := by
  let C := centralizer ({(z:G)} : Set G)
  let J := tripleSixWeightFourResidual K z
  let R := conjugateSpanBy U C
  let H := R ⊔ J ⊔ (T : Subgroup G)
  let V1 := tripleSixPoint D a z
  let W := conjugateSpanBy V1 R
  let Z := zpowers (z:G)
  have hc := original_tripleSix_central_closure_configuration h structural D a z hz hzT hnot
  change H ≤ C ∧ W = conjugateSpanBy V1 H ∧ W ≤ H.pCoreIn 2 ∧
    (frattini W).map W.subtype ≤ Z ∧ ⁅W,H.pCoreIn 2⁆ ≤ Z ∧
    ¬ U ≤ H.pCoreIn 2 ∧ ¬ ⁅U,W⁆ ≤ Z at hc
  have hTH : (T : Subgroup G) ≤ H := le_sup_right
  have hUH : U ≤ H := D.le_sylow.trans hTH
  have hJH : J ≤ H := le_sup_right.trans le_sup_left
  have hp := tripleSixPoint_properties D a z hz
  have hVH : V1 ≤ H := hp.2.1.trans hUH
  have hVW : V1 ≤ W := le_conjugateSpanBy V1 R
  let S : ChapterG.Section02.Setup G :=
    {V:=V1,V₁:=Z,L:=tripleSixScalarResidual K,T:=T,H:=H}
  have hs : S.Hypothesis :=
    original_tripleSix_central_point_g21_at h D a z hz hzT H hTH hc.1
  let : (S.V₁.subgroupOf S.G₁).Normal := S.point_normal
  let f : H →* S.tilde H :=
    { toFun x := ⟨QuotientGroup.mk' (S.V₁.subgroupOf S.G₁)
        ⟨x,hs.H_le x.property⟩,⟨⟨x,hs.H_le x.property⟩,x.property,rfl⟩⟩
      map_one' := Subtype.ext (map_one _)
      map_mul' x y := Subtype.ext (map_mul (QuotientGroup.mk' (S.V₁.subgroupOf S.G₁))
        (⟨x,hs.H_le x.property⟩ : S.G₁) ⟨y,hs.H_le y.property⟩) }
  have hf : Function.Surjective f := by
    rintro ⟨y,x,hx,rfl⟩
    exact ⟨⟨x,hx⟩,rfl⟩
  have hfk : f.ker = Z.subgroupOf H := by
    ext x
    change f x = 1 ↔ x.val ∈ Z
    rw [Subtype.ext_iff]
    exact QuotientGroup.eq_one_iff (⟨x,hs.H_le x.property⟩ : S.G₁)
  let B := (W.subgroupOf H).map f
  have hB : B = (S.tilde S.U).subgroupOf (S.tilde S.H) := by
    have hW : W = S.U := hc.2.1
    rw [show B = (W.subgroupOf H).map f from rfl,hW]
    ext y
    constructor
    · rintro ⟨x,hx,rfl⟩
      exact ⟨⟨x,hs.H_le x.property⟩,hx,rfl⟩
    · rintro ⟨x,hx,hxy⟩
      exact ⟨⟨x,hs.U_le_H hx⟩,hx,Subtype.ext hxy⟩
  have hr : IsPReduced 2 B := hB.symm ▸ hs.tilde_U_reduced
  let : B.Normal := hr.normal
  let E := centralizer (B : Set (S.tilde H))
  let N := E.comap f
  let : N.Normal := inferInstance
  have hmem (x : H) : x ∈ N ↔ ∀ w ∈ W, ⁅w,(x:G)⁆ ∈ Z := by
    constructor
    · intro hx w hw
      let wH : H := ⟨w,(hc.2.2.1.trans (pCoreIn_le 2 H)) hw⟩
      have he : f ⁅wH,x⁆ = 1 := by
        rw [map_commutatorElement,commutatorElement_eq_one_iff_mul_comm]
        exact mem_centralizer_iff.mp hx _ (mem_map_of_mem f hw)
      have hm : ⁅wH,x⁆ ∈ f.ker := he
      rw [hfk] at hm
      exact hm
    · intro hx
      apply mem_centralizer_iff.mpr
      rintro _ ⟨w,hw,rfl⟩
      apply commutatorElement_eq_one_iff_mul_comm.mp
      rw [←map_commutatorElement]
      exact show ⁅w,x⁆ ∈ f.ker from hfk.symm ▸ hx w hw
  let g := (QuotientGroup.mk' E).comp f
  have hg : Function.Surjective g := (QuotientGroup.mk'_surjective E).comp hf
  have hgk : g.ker = N := by rw [←MonoidHom.comap_ker,QuotientGroup.ker_mk']
  let e : (H ⧸ N) ≃* ((S.tilde H) ⧸ E) :=
    (QuotientGroup.quotientMulEquivOfEq hgk.symm).trans
      (QuotientGroup.quotientKerEquivOfSurjective g hg)
  have hcore : pCore 2 (H ⧸ N) = ⊥ := by
    rw [←pCore_map_iso 2 e.symm,hr.quotient_pCore_eq_bot,Subgroup.map_bot]
  have hVN : V1.subgroupOf H ≤ N := by
    intro v hv
    apply (hmem v).mpr
    intro w hw
    exact hc.2.2.2.2.1 (commutator_mem_commutator hw (hc.2.2.1 (hVW hv)))
  let q := QuotientGroup.mk' N
  let A := (U.subgroupOf H).map q
  have hAne : A ≠ ⊥ := by
    intro he
    have hUN : U.subgroupOf H ≤ N := by
      simpa only [q,QuotientGroup.ker_mk'] using (Subgroup.map_eq_bot_iff _).mp he
    apply hc.2.2.2.2.2.2
    rw [commutator_comm]
    apply commutator_le.mpr
    intro w hw u hu
    exact (hmem ⟨u,hUH hu⟩).mp (hUN hu) w hw
  let := D.elementary
  let : IsElementaryAbelian 2 (U.subgroupOf H) := IsElementaryAbelian.subgroupOf hUH
  have hAelem : IsElementaryAbelian 2 A := IsElementaryAbelian.map q
  have hcardU : Nat.card (U.subgroupOf H) = 64 :=
    (Nat.card_congr (subgroupOfEquivOfLe hUH).toEquiv).trans
      ((Nat.card_congr (tripleSixPointCoordinates D a).toEquiv).trans hexacode_card)
  have hcardV : Nat.card (V1.subgroupOf H) = 4 :=
    (Nat.card_congr (subgroupOfEquivOfLe hVH).toEquiv).trans hp.2.2.1
  have hsize : Nat.card A ≤ 16 := by
    have hmul := IsElementaryAbelian.card_inf_ker_mul_card_map (U.subgroupOf H) q
    rw [hcardU,QuotientGroup.ker_mk'] at hmul
    have hsmall : 4 ≤ Nat.card (U.subgroupOf H ⊓ N : Subgroup H) := by
      rw [←hcardV]
      exact card_le_of_le (le_inf (comap_mono hp.2.1) hVN)
    have hh := Nat.mul_le_mul_right (Nat.card A) hsmall
    change _ * Nat.card A = 64 at hmul
    rw [hmul] at hh
    omega
  have hgen : U.subgroupOf H = ⁅U.subgroupOf H,J.subgroupOf H⁆ ⊔ V1.subgroupOf H := by
    apply map_injective H.subtype_injective
    rw [Subgroup.map_sup,map_commutator,map_subgroupOf_eq_of_le hUH,
      map_subgroupOf_eq_of_le hJH,map_subgroupOf_eq_of_le hVH]
    exact (original_tripleSix_weightFour_cubic_residual D a z hz hzT).2.2.2.2.1
  have hmove : A = ⁅A,(J.subgroupOf H).map q⁆ := by
    have he := congrArg (map q) hgen
    have hv : (V1.subgroupOf H).map q = ⊥ := (Subgroup.map_eq_bot_iff _).mpr (by
      simpa only [q,QuotientGroup.ker_mk'] using hVN)
    rw [Subgroup.map_sup,map_commutator,hv,sup_bot_eq] at he
    exact he
  exact ⟨N,inferInstance,hmem,hcore,hVN,hAne,hAelem,hsize,hmove⟩

end CFSG.Quasithin.Chapter12.Section07
