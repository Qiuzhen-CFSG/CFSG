module

public import CFSG.Quasithin.Chapter12.Section07.OriginalTripleSixHeldOppositeRows
public import CFSG.Quasithin.Chapter12.Section07.OriginalTripleSixHeldLocalKernelNormalizer
public import Theory.Representation.BinaryInternalFixedSpaceCodimension.ExtraspecialPlaneAction

/-!
# The original extraspecial kernel in the opposite normalizer image

The actual marked dihedral kernel P acts on the same opposite plane W used
by the complete actor sieve. Its image is elementary of order8 and fixes
exactly the original line generated by z. The original P, z and N_G(P) are
constructed from the escaping-point source, and all six-space actor rows
remain marked. No ambient normalizer comparison is added as a premise.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter12.Section07
open Section02 ChapterB.QuasisimpleSource
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {K U : Subgroup G}

theorem original_tripleSix_escaping_kernel_image
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T K)
    (structural : Structural1222At KnownSimple.IsKnownSimple T)
    (D : ChosenModule T K U)
    (a : ActionEquiv D.quotientAction Hexacode.evenAction) (t : U) (ht : t≠1)
    (heven : 2∣(centralizer ({(t:G)} : Set G)).relIndex K)
    (hout : ¬centralizer ({(t:G)} : Set G)≤normalizer (K : Set G)) :
    ∃ π : T→*DihedralGroup 4, Function.Surjective π ∧
      let P := π.ker.map (T : Subgroup G).subtype
      let Y := normalizer (P : Set G)
      P≤(T : Subgroup G) ∧ (T : Subgroup G)≤Y ∧ Nat.card P=128 ∧ IsExtraspecial 2 P ∧
      Nonempty (P≃*DihedralCentralProductThree.Model) ∧
      Nat.card (U⊓P : Subgroup G)=16 ∧ Nat.card ((U.subgroupOf T).map π)=4 ∧
      ∃ z : G, orderOf z=2 ∧ z∈U ∧
        centerIn P=zpowers z ∧ centerIn (T : Subgroup G)=zpowers z ∧
        centralizer (P : Set G)=zpowers z ∧ Y≤centralizer ({z} : Set G) ∧
        normalizer (K : Set G)⊓centralizer ({z} : Set G)≤Y ∧
        let H := centralizer ({(t:G)} : Set G)
        let Lt := (pResidual 2 (K⊓H : Subgroup G)).map (K⊓H).subtype
        let B := conjugateSpanBy Lt H
        ∃ k∈K, ∃ S : Sylow 2 B, ∃ W : Subgroup G,
          ∃ hWe : IsElementaryAbelian 2 W, letI := hWe
          let Bk := B.map (MulAut.conj k).toMonoidHom
          let R := ((S : Subgroup B).map B.subtype).map (MulAut.conj k).toMonoidHom
          let L := (normalizer (W.subgroupOf Bk : Set Bk)).map Bk.subtype
          let I := normalizer (W : Set G)
          let ρ := BinaryInternalFixedSpaceCodimension.representation W I le_rfl
          let τ := imageRepresentation ρ
          let A := actionSubgroup ρ (P.subgroupOf I)
          let C := actionSubgroup ρ (L.subgroupOf I)
          let J := offenderSubgroup τ
          let F := generalizedFitting J
          U≤R ∧ W≤R ∧ R≤(T : Subgroup G) ∧ U⊔W=R ∧
          Nat.card W=64 ∧ (T : Subgroup G)≤normalizer (R : Set G)⊓I ∧
          centralizer (W : Set G)=W ∧ I.pCoreIn 2=W ∧
          (actionHom ρ).ker=W.subgroupOf I ∧
          Nat.card (W⊓P : Subgroup G)=16 ∧ centerIn P≤W ∧
          (U⊓P : Subgroup G)≠W⊓P ∧
          Module.finrank (ZMod 2) (Additive W)=6 ∧
          (∀ Q : Sylow 2 (actionImage ρ), Nat.card Q=16) ∧
          Function.Injective τ ∧ τ.IsIrreducible ∧
          Nonempty (C≃*alternatingGroup (Fin 5)) ∧ C≤J ∧ fixedSpace τ C≠⊥ ∧
          IsElementaryAbelian 2 A ∧ Nat.card A=8 ∧
          Module.finrank (ZMod 2) (fixedSpace τ A)=1 ∧
          (∀ v : Additive W, v∈fixedSpace τ A ↔ (v.toMul:G)∈zpowers z) ∧
          ((IsQuasisimple F ∧
            Nonempty (ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
              (τ.comp J.subtype) F) ∧
            (Nonempty (F≃*alternatingGroup (Fin 6)) ∨
              Nonempty (F≃*alternatingGroup (Fin 7)) ∨
              Nonempty (center F≃*Multiplicative (ZMod 3)) ∧
                Nonempty ((F ⧸ center F)≃*alternatingGroup (Fin 6)))) ∨
            Nonempty (ChapterB.OuterSixThreeShape J)) := by
  obtain ⟨π,hπ,hPT,hTY,hPc,hEx,hmodel,hUP,hUimage,z,hz,hzU,hZP,hZT,hCP,hYC,hMY,_,_⟩ :=
    original_tripleSix_escaping_local_kernel_normalizer h structural D a t ht heven hout
  let P := π.ker.map (T : Subgroup G).subtype
  let eP := π.ker.equivMapOfInjective (T : Subgroup G).subtype (T : Subgroup G).subtype_injective
  let : IsExtraspecial 2 P := hEx
  let : IsExtraspecial 2 π.ker := IsExtraspecial.of_mulEquiv eP.symm hEx
  have hPker : Nat.card π.ker=128 := by
    have hh := hPc
    rw [card_map_of_injective (T : Subgroup G).subtype_injective] at hh
    exact hh
  let H := centralizer ({(t:G)} : Set G)
  let Lt := (pResidual 2 (K⊓H : Subgroup G)).map (K⊓H).subtype
  let B := conjugateSpanBy Lt H
  obtain ⟨k,hk,S,W,hWe,hUR,hWR,hRT,_,hWc,hgen,_,_,hTN,_,_,hCW,hcore,hker,
    hdim,hsyl,hf,hi,_,_,_,heC,_,_,_,hCJ,hfix,hWP,hZW,hneq,rows⟩ :=
    original_tripleSix_escaping_opposite_rows h structural D a t ht heven hout π hPker
  let := hWe
  let Bk := B.map (MulAut.conj k).toMonoidHom
  let L := (normalizer (W.subgroupOf Bk : Set Bk)).map Bk.subtype
  let I := normalizer (W : Set G)
  let ρ := BinaryInternalFixedSpaceCodimension.representation W I le_rfl
  let τ := imageRepresentation ρ
  let A := actionSubgroup ρ (P.subgroupOf I)
  obtain ⟨hAe,hAc,hAd,hAf⟩ := BinaryInternalFixedSpaceCodimension.extraspecial_plane_action
    T P W hPT (hWR.trans hRT) (hTN.trans inf_le_right) hPc
    (by rwa [inf_comm]) hZW (hCP.trans hZP.symm) hCW
  have hline (v : Additive W) : v∈fixedSpace τ A ↔ (v.toMul:G)∈zpowers z := by
    rw [←hZP]
    exact hAf v
  exact ⟨π,hπ,hPT,hTY,hPc,hEx,hmodel,hUP,hUimage,z,hz,hzU,hZP,hZT,hCP,hYC,hMY,
    k,hk,S,W,hWe,hUR,hWR,hRT,hgen,hWc,hTN,hCW,hcore,hker,hWP,hZW,hneq,
    hdim,hsyl,hf,hi,heC,hCJ,hfix,hAe,hAc,hAd,hline,rows⟩

end CFSG.Quasithin.Chapter12.Section07
