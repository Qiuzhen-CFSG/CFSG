module

public import CFSG.Quasithin.Chapter12.Section07.OriginalTripleSixCentralClosureScalarCore
public import CFSG.Quasithin.Chapter12.Section07.OriginalTripleSixCentralClosureScalar
public import CFSG.Quasithin.Chapter12.Section07.OriginalTripleSixScalarResidual
public import Theory.GroupTheory.CharacteristicCentralizerSylow
public import Theory.GroupTheory.PResidual.FiniteLocalPair

/-!
# The original chosen module is the scalar commutator layer

The literal scalar residual contains an actual cubic lift which acts
fixed-point-freely on the unchanged chosen module U.  The commutator map of
that lift is therefore onto U.  Since U lies in the actual two-core of KT,
this gives the forward inclusion needed after the scalar bound, without
identifying U with the odd residual itself.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter12.Section07
open Section02 ChapterB.QuasisimpleSource Atlas.Codes
open Theory.SpecificGroups.SymmetricSix
open ChapterE
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {K U : Subgroup G}

/-- The unchanged chosen module is generated by commutators with the literal
scalar residual. -/
theorem original_tripleSix_central_closure_scalar_commutator
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T K)
    (structural : Structural1222At KnownSimple.IsKnownSimple T)
    (D : ChosenModule T K U) (a : ActionEquiv D.quotientAction Hexacode.evenAction)
    (z : U) (hz : z ≠ 1)
    (hzT : (T : Subgroup G) ≤ centralizer ({(z : G)} : Set G))
    (hnot : ¬ U ≤ (centralizer ({(z : G)} : Set G)).pCoreIn 2)
    (houter : ¬ inducedAutomizer U (conjugateSpanBy (tripleSixPoint D a z)
      (conjugateSpanBy U (centralizer ({(z : G)} : Set G)))) ≤ inducedAutomizer U K) :
    U ≤ ⁅(K ⊔ (T : Subgroup G)).pCoreIn 2,tripleSixScalarResidual K⁆ := by
  let _ := h
  let _ := structural
  let _ := hz
  let _ := hzT
  let _ := hnot
  let _ := houter
  let X := tripleSixScalarResidual K
  let M := K ⊔ (T : Subgroup G)
  let Q := M.pCoreIn 2
  have hXK : X ≤ K := map_subtype_le _
  have hXM : X ≤ M := hXK.trans le_sup_left
  have hMQ : M ≤ normalizer (Q : Set G) := M.le_normalizer.trans
    (normalizer_le_normalizer_characteristic_image M (pCore 2 M))
  have hXQ : X ≤ normalizer (Q : Set G) := hXM.trans hMQ
  have hUQ : U ≤ Q := by
    exact D.le_componentCore.trans (pCoreIn_mono_of_normalizes le_sup_left
      (sup_le K.le_normalizer D.sylow_normalizes_component))
  have hUM : U ≤ M := D.le_component.trans le_sup_left
  have hUX : U ≤ normalizer (X : Set G) :=
    hUM.trans (sup_le K.le_normalizer D.sylow_normalizes_component) |>.trans
      ((normalizer_le_normalizer_characteristic_image K
        (centralPreimage (pCore 2 K))).trans
        (normalizer_le_normalizer_characteristic_map K.subtype K.subtype_injective
          (centralPreimage (pCore 2 K)) (pResidual 2 (centralPreimage (pCore 2 K)))))
  have hscalar : ∃ c : X, ∀ u : U, Commute c.val u → u = 1 := by
    have hz0 : hexEvenZ ∈ center HexEvenAutomorphisms := by
      rw [←Hexacode.even_kernel_eq_center,hexEvenCoordinate_kernel]
      exact mem_zpowers _
    obtain ⟨cK,hcK,hc⟩ := (tripleSixScalarResidual_image D a).symm ▸
      (show hexEvenZ ∈ center HexEvenAutomorphisms from hz0)
    let c : X := ⟨cK.val,hcK⟩
    refine ⟨c,?_⟩
    intro u hu
    have hcu : cK.val ∈ centralizer ({(u : G)} : Set G) :=
      mem_centralizer_singleton_iff.mpr hu.eq
    have hf := (tripleSixPoint_actor_fixes_iff D a u cK).mpr hcu
    change Hexacode.evenAction
      (a.groupEquiv (QuotientGroup.mk' (pCore 2 K) cK))
        (tripleSixPointCoordinates D a u).toAdd =
      (tripleSixPointCoordinates D a u).toAdd at hf
    rw [show a.groupEquiv (QuotientGroup.mk' (pCore 2 K) cK) =
      Atlas.Codes.hexEvenZ from hc] at hf
    have hv := (Hexacode.scalar_fixed_iff _).mp hf
    exact (tripleSixPointCoordinates D a).injective
      (show tripleSixPointCoordinates D a u =
        tripleSixPointCoordinates D a 1 from hv.trans
          (tripleSixPointCoordinates D a).map_one.symm)
  obtain ⟨c,hfree⟩ := hscalar
  have hXU : X ≤ normalizer (U : Set G) := hXK.trans D.normalizes
  let e := U.normalizerMonoidHom ⟨c.val,hXU c.property⟩
  have hff : MonoidHom.FixedPointFree e := by
    intro u hu
    apply hfree u
    apply (mul_inv_eq_iff_eq_mul).mp
    exact congrArg Subtype.val hu
  apply le_trans _ (commutator_mono hUQ le_rfl)
  intro u hu
  obtain ⟨v,hv⟩ := hff.commutatorMap_surjective ⟨u,hu⟩
  have heq : ⁅(v : G),c.val⁆ = u := by
    have hh := congrArg Subtype.val hv
    simpa only [MonoidHom.commutatorMap_apply,coe_div,coe_mul,coe_inv,e,
      normalizerMonoidHom_apply_apply_coe,div_eq_mul_inv,mul_assoc,
      mul_inv_rev,inv_inv,commutatorElement_def] using hh
  exact heq ▸ commutator_mem_commutator v.property c.property

/- The scalar residual commutator is exactly the original chosen module. -/
theorem original_tripleSix_central_closure_scalar_commutator_eq
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T K)
    (structural : Structural1222At KnownSimple.IsKnownSimple T)
    (D : ChosenModule T K U) (a : ActionEquiv D.quotientAction Hexacode.evenAction)
    (z : U) (hz : z ≠ 1)
    (hzT : (T : Subgroup G) ≤ centralizer ({(z : G)} : Set G))
    (hnot : ¬ U ≤ (centralizer ({(z : G)} : Set G)).pCoreIn 2)
    (houter : ¬ inducedAutomizer U (conjugateSpanBy (tripleSixPoint D a z)
      (conjugateSpanBy U (centralizer ({(z : G)} : Set G)))) ≤ inducedAutomizer U K) :
    ⁅(K ⊔ (T : Subgroup G)).pCoreIn 2,tripleSixScalarResidual K⁆ = U := by
  apply le_antisymm
  · exact original_tripleSix_central_closure_scalar_core
      h structural D a z hz hzT hnot houter
  · exact original_tripleSix_central_closure_scalar_commutator
      h structural D a z hz hzT hnot houter

end CFSG.Quasithin.Chapter12.Section07
