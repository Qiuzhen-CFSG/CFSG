module

public import CFSG.Quasithin.Chapter12.Section07.OriginalTripleSixPushingUpAt
public import CFSG.Quasithin.Chapter12.Section07.OriginalTripleSixPointFixed
public import CFSG.Quasithin.ChapterC.Section03.OrdinaryPlacement.InnerRadicalNormalizer
public import Theory.SpecificGroups.Rudvalis.ComponentFacts
public import Theory.SpecificGroups.Rudvalis.Multiplier.Universe
public import Theory.SpecificGroups.Rudvalis.Model.InvolutionCentralizers.ThreePart
public import Theory.ElementaryAbelian.EightQuotientRank
public import Theory.GroupTheory.PrimeOrderLift
public import Theory.GroupTheory.InvolutionCentralizerControl

/-!
# The original Rudvalis radical normalizer fixes a central-class point

The actual covering kernel is the line generated by t. The original field
point therefore projects to an involution. Its normalizer contains the
normalizer of the actual radical intersection: the inner automorphism
theorem puts that normalizer in the original local subgroup, which preserves
U and Lt and hence their fixed field point. The actual A₅ residual supplies
a cubic in its centralizer, ruling out the other Rudvalis involution class.

Source: Aschbacher--Smith C.2.2, C.3.3 and 12.7.5, pp.144,149,840.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation PerfectCentralCovering
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter12.Section07
open Section02 ChapterB.QuasisimpleSource
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {K U : Subgroup G}

/-- All radical, module and point markings are produced from the original
configuration and its specified Rudvalis quotient. -/
theorem original_tripleSix_point_ordinary_ru_radical_control_at
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T K)
    (structural : Structural1222At KnownSimple.IsKnownSimple T)
    (D : ChosenModule T K U)
    (a : ActionEquiv D.quotientAction Hexacode.evenAction) (t : U) (ht : t ≠ 1)
    (heven : 2 ∣ (centralizer ({(t : G)} : Set G)).relIndex K)
    (J : Subgroup (centralizer ({(t : G)} : Set G)))
    (hJ : IsComponent (centralizer ({(t : G)} : Set G)) J)
    (e : J ⧸ center J ≃* Rudvalis.Model) :
    let H := centralizer ({(t : G)} : Set G)
    let Q := (K ⊔ (T : Subgroup G)).pCoreIn 2
    let q := e.toMonoidHom.comp (QuotientGroup.mk' (center J))
    let P := ((Q.subgroupOf H).subgroupOf J).map q
    let E := ((U.subgroupOf H).subgroupOf J).map q
    P.IsPRadical 2 ∧ IsElementaryAbelian 2 E ∧ 32 ≤ Nat.card E ∧
      E ≤ centerIn P ∧ ∃ z : Rudvalis.Model, orderOf z = 2 ∧
        IsConj z (Rudvalis.b ^ 2) ∧ normalizer (P : Set Rudvalis.Model) ≤
          centralizer ({z} : Set Rudvalis.Model) := by
  let H := centralizer ({(t : G)} : Set G)
  let M := normalizer (K : Set G) ⊓ H
  let C := K ⊓ H
  let Lt := (pResidual 2 C).map C.subtype
  let Q := (K ⊔ (T : Subgroup G)).pCoreIn 2
  let V := tripleSixPoint D a t
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (center J))
  let P0 := (Q.subgroupOf H).subgroupOf J
  let A := (U.subgroupOf H).subgroupOf J
  let W := (V.subgroupOf H).subgroupOf J
  let C0 := (M.subgroupOf H).subgroupOf J
  let P := P0.map q
  let E := A.map q
  let F := W.map q
  change P.IsPRadical 2 ∧ IsElementaryAbelian 2 E ∧ 32 ≤ Nat.card E ∧
    E ≤ centerIn P ∧ ∃ z : Rudvalis.Model, orderOf z = 2 ∧
      IsConj z (Rudvalis.b ^ 2) ∧ normalizer (P : Set Rudvalis.Model) ≤
        centralizer ({z} : Set Rudvalis.Model)
  have h28 := original_tripleSix_pushingUp_at h structural D a t ht heven
  let := hJ.2
  let : IsSimpleGroup (J ⧸ center J) := IsQuasisimple.simple
  let : IsSimpleGroup Rudvalis.Model := e.symm.isSimpleGroup
  have hi (α : MulAut J) : α ∈ MulAut.innerSubgroup J := by
    rw [←MulAut.comap_inner_centralQuotientAction e]
    exact Rudvalis.component_conj_surjective (MulAut.centralQuotientAction e α)
  have hNP0 : normalizer (P0 : Set J) ≤ C0 :=
    h28.ordinary_radical_normalizer_le_local_of_inner J hJ hi
  have hq : Function.Surjective q := e.surjective.comp (QuotientGroup.mk'_surjective _)
  have hker : q.ker = center J := by
    rw [MonoidHom.ker_comp_of_injective _ _ e.injective,QuotientGroup.ker_mk']
  have hZ : center J = pCore 2 J :=
    IsQuasisimple.center_eq_pCore (hJ.1.pPrimeCore_eq_bot h28.oddCore_eq_bot J)
  have hkp : IsPGroup 2 q.ker := by rw [hker,hZ]; exact pCore_isPGroup
  let cover : Cover J Rudvalis.Model := {
    toMonoidHom := q
    surjective := hq
    isPerfect := inferInstance
    ker_le_center := hker.le }
  have hkc : Nat.card q.ker ≤ 2 :=
    Rudvalis.Multiplier.cover_kernel_card_le_two_any_universe cover
  have hP0 : P0.IsPRadical 2 := h28.ordinary_radical_intersection_isRadical J hJ
  have hkP : q.ker ≤ P0 := by
    rw [hker,hZ]
    exact pCore_le_of_pCore_normalizer_le P0 hP0.isPGroup hP0.2.le
  have hPn : P ≠ ⊥ := by
    intro he
    have hc : P0 ≤ center J := hker ▸ (map_eq_bot_iff P0).mp he
    apply h28.ordinary_radical_intersection_not_centralizes J hJ
    intro r hr j hj
    exact congrArg (fun x : J => (x : H))
      (mem_center_iff.mp (hc (show (⟨r,hr.2⟩ : J) ∈ P0 from hr.1)) ⟨j,hj⟩)
  have hP : P.IsPRadical 2 :=
    ⟨hPn,map_normalizer_core_of_p_kernel P0 hP0.isPGroup hP0.2 q hq hkP⟩
  have hUL : U ≤ Lt := (tripleSixPointCentralizerResidual_commutator D a t ht heven).2
  have hLH : Lt ≤ H := (map_subtype_le _).trans inf_le_right
  have hUH : U ≤ H := hUL.trans hLH
  have hLJ : Lt.subgroupOf H ≤ J := h28.ordinary_component_contains_original J hJ
  have hUJ : U.subgroupOf H ≤ J := (subgroupOf_mono H hUL).trans hLJ
  have hV := tripleSixPoint_properties D a t ht
  have hVU : V ≤ U := hV.2.1
  have hVH : V ≤ H := hVU.trans hUH
  have hVJ : V.subgroupOf H ≤ J := (subgroupOf_mono H hVU).trans hUJ
  have hWA : W ≤ A := subgroupOf_mono J (subgroupOf_mono H hVU)
  let : IsElementaryAbelian 2 U := D.elementary
  let : IsElementaryAbelian 2 (U.subgroupOf H) := IsElementaryAbelian.subgroupOf hUH
  let : IsElementaryAbelian 2 A := IsElementaryAbelian.subgroupOf hUJ
  let : IsElementaryAbelian 2 E := IsElementaryAbelian.map q
  let : IsElementaryAbelian 2 W :=
    IsElementaryAbelian.of_injective (inclusion hWA) (inclusion_injective hWA)
  let : IsElementaryAbelian 2 F := IsElementaryAbelian.map q
  have hAc : Nat.card A = 64 :=
    (Nat.card_congr ((subgroupOfEquivOfLe hUJ).trans
      (subgroupOfEquivOfLe hUH)).toEquiv).trans
      ((Nat.card_congr (tripleSixPointCoordinates D a).toEquiv).trans Atlas.Codes.hexacode_card)
  have hWc : Nat.card W = 4 :=
    (Nat.card_congr ((subgroupOfEquivOfLe hVJ).trans
      (subgroupOfEquivOfLe hVH)).toEquiv).trans hV.2.2.1
  let tJ : J := ⟨⟨t,hUH t.property⟩,hUJ t.property⟩
  have htW : tJ ∈ W := hV.1
  have htker : tJ ∈ q.ker := by
    rw [hker]
    apply mem_center_iff.mpr
    intro x
    exact Subtype.ext (Subtype.ext (mem_centralizer_singleton_iff.mp x.val.property))
  have htJ1 : tJ ≠ 1 := fun he => ht (Subtype.ext
    (congrArg (fun x : J => ((x : H) : G)) he))
  have htJ2 : tJ ^ 2 = 1 :=
    elemPow_eq_one_of_isElementaryAbelian (p := 2) tJ (hWA htW)
  have htJo : orderOf tJ = 2 := orderOf_eq_prime htJ2 htJ1
  have hzcard : Nat.card (zpowers tJ) = 2 := (Nat.card_zpowers tJ).trans htJo
  have hline : zpowers tJ = q.ker :=
    eq_of_le_of_card_ge (zpowers_le.mpr htker) (by rw [hzcard]; exact hkc)
  have hkW : q.ker ≤ W := by rw [←hline]; exact zpowers_le.mpr htW
  have hkcard : Nat.card q.ker = 2 := by rw [←hline]; exact hzcard
  have hFc : Nat.card F = 2 := by
    have hh := IsElementaryAbelian.card_inf_ker_mul_card_map W q
    rw [inf_eq_right.mpr hkW,hkcard,hWc] at hh
    change 2 * Nat.card F = 4 at hh
    omega
  have hEc : 32 ≤ Nat.card E := by
    have hh := IsElementaryAbelian.card_inf_ker_mul_card_map A q
    rw [inf_eq_right.mpr (hkW.trans hWA),hkcard,hAc] at hh
    change 2 * Nat.card E = 64 at hh
    omega
  have hAP : A ≤ P0 := subgroupOf_mono J
    ((h28.ordinary_module_placement J hJ).1.trans inf_le_left)
  have hEcenter : E ≤ centerIn P := by
    rw [centerIn_eq_map_center]
    rintro y ⟨u,hu,rfl⟩
    refine ⟨⟨q u,mem_map_of_mem q (hAP hu)⟩,mem_center_iff.mpr ?_,rfl⟩
    rintro ⟨y,⟨r,hr,he⟩⟩
    apply Subtype.ext
    change y * q u = q u * y
    rw [←he,←map_mul,←map_mul]
    apply congrArg q
    obtain ⟨w,hw,he⟩ := h28.module_le_center_radical hu
    apply Subtype.ext
    apply Subtype.ext
    have hh := congrArg Q.subtype (mem_center_iff.mp hw ⟨r,hr⟩)
    change (r : G) * (w : G) = (w : G) * (r : G) at hh
    change (w : G) = (u : G) at he
    change (r : G) * (u : G) = (u : G) * (r : G)
    rwa [he] at hh
  have hMU : M ≤ normalizer (U : Set G) :=
    h.source_point_normalizes_chosen_at structural D t.property
      (fun he => ht (Subtype.ext he)) le_rfl
  have hMC : M ≤ normalizer (C : Set G) :=
    (le_inf inf_le_left (inf_le_right.trans H.le_normalizer)).trans
      inf_normalizer_le_normalizer_inf
  have hML : M ≤ normalizer (Lt : Set G) :=
    hMC.trans (normalizer_le_normalizer_characteristic_image C (pResidual 2 C))
  have hMV : M ≤ normalizer (V : Set G) := by
    rw [show V = U ⊓ centralizer (Lt : Set G) from
      (tripleSixPoint_residual_fixed D a t ht heven).symm]
    exact (le_inf hMU (hML.trans (normalizer_le_normalizer_centralizer Lt))).trans
      inf_normalizer_le_normalizer_inf
  have hCW : C0 ≤ normalizer (W : Set J) := by
    intro j hj
    apply mem_normalizer_iff.mpr
    intro w
    change (w : G) ∈ V ↔ (j : G) * (w : G) * (j : G)⁻¹ ∈ V
    exact (mem_normalizer_iff.mp (hMV hj)) (w : G)
  have hN : (normalizer (P0 : Set J)).map q = normalizer (P : Set Rudvalis.Model) := by
    have he : (normalizer (P : Set Rudvalis.Model)).comap q = normalizer (P0 : Set J) := by
      rw [comap_normalizer_eq_of_surjective _ hq,comap_map_eq_self hkP]
    rw [←he,map_comap_eq_self_of_surjective hq]
  have hNF : normalizer (P : Set Rudvalis.Model) ≤ centralizer (F : Set Rudvalis.Model) := by
    apply le_trans ?_ (normalizer_le_centralizer_of_card_two F hFc)
    rw [←hN]
    exact (map_mono (hNP0.trans hCW)).trans (W.le_normalizer_map q)
  let : Nontrivial F := Finite.one_lt_card_iff_nontrivial.mp (by rw [hFc]; decide)
  obtain ⟨z,hz⟩ := exists_ne (1 : F)
  have hz1 : (z : Rudvalis.Model) ≠ 1 := fun he => hz (Subtype.ext he)
  have hz2 : (z : Rudvalis.Model) ^ 2 = 1 := elemPow_eq_one_of_isElementaryAbelian _ z.property
  have hzo : orderOf (z : Rudvalis.Model) = 2 := orderOf_eq_prime hz2 hz1
  have hNz : normalizer (P : Set Rudvalis.Model) ≤ centralizer ({(z : Rudvalis.Model)} : Set Rudvalis.Model) :=
    hNF.trans (centralizer_le (Set.singleton_subset_iff.mpr z.property))
  have hthreeL : 3 ∣ Nat.card Lt := by
    have hh := card_quotient_dvd_card (pCore 2 Lt)
    rw [Nat.card_congr (tripleSixPointResidualQuotientEquiv D a t ht heven).toEquiv,
      nat_card_alternatingGroup] at hh
    norm_num at hh
    exact (show 3 ∣ 60 by decide).trans hh
  obtain ⟨x,hx⟩ := exists_prime_orderOf_dvd_card' (G := Lt) 3 hthreeL
  let xJ : J := ⟨⟨x,hLH x.property⟩,hLJ x.property⟩
  have hxJo : orderOf xJ = 3 := by
    exact (Subgroup.orderOf_coe xJ).symm.trans
      ((Subgroup.orderOf_coe (xJ : H)).symm.trans ((Subgroup.orderOf_coe x).trans hx))
  have hxqo : orderOf (q xJ) = 3 :=
    (q.orderOf_map_eq_of_coprime_of_isPGroup_ker hkp xJ (by rw [hxJo]; decide)).trans hxJo
  have hxF : q xJ ∈ centralizer (F : Set Rudvalis.Model) := by
    rintro y ⟨w,hw,rfl⟩
    rw [←map_mul,←map_mul]
    apply congrArg q
    apply Subtype.ext
    apply Subtype.ext
    exact hV.2.2.2.2 ((map_subtype_le (pResidual 2 C)) x.property) w hw
  have hxC : q xJ ∈ centralizer ({(z : Rudvalis.Model)} : Set Rudvalis.Model) :=
    (centralizer_le (Set.singleton_subset_iff.mpr z.property)) hxF
  have hthreeC : 3 ∣ Nat.card (centralizer ({(z : Rudvalis.Model)} : Set Rudvalis.Model)) := by
    have hh := orderOf_dvd_natCard (⟨q xJ,hxC⟩ : centralizer ({(z : Rudvalis.Model)} : Set Rudvalis.Model))
    rwa [←Subgroup.orderOf_coe,hxqo] at hh
  have hclass : IsConj (z : Rudvalis.Model) (Rudvalis.b ^ 2) := by
    rcases Rudvalis.InvolutionCentralizers.centralizer_representatives z hzo with hc | hc
    · exact hc.1
    · obtain ⟨f⟩ := hc.2
      rw [Nat.card_congr f.toEquiv] at hthreeC
      exact (Rudvalis.InvolutionCentralizers.second_centralizer_not_three hthreeC).elim
  exact ⟨hP,inferInstance,hEc,hEcenter,z,hzo,hclass,hNz⟩

end CFSG.Quasithin.Chapter12.Section07
