/-!
# The unchanged original module in a proposed Held quotient

The full ordinary center meets the original elementary 64 in a nontrivial
subgroup of the original fixed four-group. Its exact image consequently has
order16 or32. The entire image is generated by commutators with the image of
the original point residual. These statements retain the full quotient map;
they do not identify this image with a native Held local module.

Source: Aschbacher--Smith12.7.4--5, printed pp.839--840, and C.3.3--4,
printed pp.149--150.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter12.Section07
open Section02 ChapterB.QuasisimpleSource
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {K U : Subgroup G}

/-- The literal full-central-quotient image has order16 or32, is elementary,
and retains the original complete commutator generation. -/
theorem original_tripleSix_ordinary_held_image
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T K)
    (structural : Structural1222At KnownSimple.IsKnownSimple T)
    (D : ChosenModule T K U)
    (a : ActionEquiv D.quotientAction Hexacode.evenAction) (t : U) (ht : t ≠ 1)
    (heven : 2 ∣ (centralizer ({(t : G)} : Set G)).relIndex K)
    (J : Subgroup (centralizer ({(t : G)} : Set G)))
    (hJ : IsComponent (centralizer ({(t : G)} : Set G)) J)
    (e : J ⧸ center J ≃* Held.He) :
    let H := centralizer ({(t : G)} : Set G)
    let Lt := (pResidual 2 (K ⊓ H : Subgroup G)).map (K ⊓ H).subtype
    let j := H.subtype.comp J.subtype
    let q := e.toMonoidHom.comp (QuotientGroup.mk' (center J))
    let E := (U.comap j).map q
    let B := (Lt.comap j).map q
    IsElementaryAbelian 2 E ∧ (Nat.card E = 16 ∨ Nat.card E = 32) ∧
      ⁅E,B⁆ = E ∧ E ≤ B.pCoreIn 2 := by
  let H := centralizer ({(t : G)} : Set G)
  let Lt := (pResidual 2 (K ⊓ H : Subgroup G)).map (K ⊓ H).subtype
  let j := H.subtype.comp J.subtype
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (center J))
  let W := U.comap j
  let A := Lt.comap j
  let C := W ⊓ center J
  have hj : Function.Injective j := H.subtype_injective.comp J.subtype_injective
  have hjr : j.range = J.map H.subtype := by rw [MonoidHom.range_comp,range_subtype]
  have hc := original_tripleSix_pushingUp_at h structural D a t ht heven
  have hLH : Lt ≤ H := (map_subtype_le _).trans inf_le_right
  have hLJ : Lt ≤ J.map H.subtype := by
    have hh := map_mono (f := H.subtype) (hc.ordinary_component_contains_original J hJ)
    rwa [map_subgroupOf_eq_of_le hLH] at hh
  obtain ⟨hcomm,hUL⟩ := tripleSixPointCentralizerResidual_commutator D a t ht heven
  have hWmap : W.map j = U := map_comap_eq_self ((hUL.trans hLJ).trans_eq hjr.symm)
  have hAmap : A.map j = Lt := map_comap_eq_self (hLJ.trans_eq hjr.symm)
  let w : W ≃* U := (W.equivMapOfInjective j hj).trans (MulEquiv.subgroupCongr hWmap)
  have hWc : Nat.card W = 64 := by
    rw [Nat.card_congr w.toEquiv]
    exact (Nat.card_congr (tripleSixPointCoordinates D a).toEquiv).trans
      Atlas.Codes.hexacode_card
  let := D.elementary
  let : IsElementaryAbelian 2 W := IsElementaryAbelian.comap_of_injective j hj U
  have hCl : C.map j ≤ tripleSixPoint D a t := by
    rintro _ ⟨x,hx,rfl⟩
    rw [←tripleSixPoint_residual_fixed D a t ht heven]
    refine ⟨hx.1,?_⟩
    intro l hl
    have hlA : l ∈ A.map j := hAmap.symm ▸ (show l ∈ Lt from hl)
    obtain ⟨y,hy,he⟩ := hlA
    rw [←he]
    exact congrArg j (mem_center_iff.mp hx.2 y)
  have hCd : Nat.card C ∣ 4 := by
    have hh := card_dvd_of_le hCl
    rw [card_map_of_injective hj,(tripleSixPoint_properties D a t ht).2.2.1] at hh
    exact hh
  have hCt : C ≠ ⊥ := by
    have htJ : (t : G) ∈ J.map H.subtype := hLJ (hUL t.property)
    let tJ : J := ⟨⟨t,(hUL.trans hLH) t.property⟩,
      (mem_map_iff_mem H.subtype_injective).mp htJ⟩
    have htC : tJ ∈ C := by
      refine ⟨t.property,mem_center_iff.mpr ?_⟩
      intro x
      apply Subtype.ext
      apply Subtype.ext
      exact mem_centralizer_singleton_iff.mp x.val.property
    intro hz
    have he := congrArg j (mem_bot.mp (hz ▸ htC))
    exact ht (Subtype.ext (show (t : G) = 1 from he))
  have hCc : Nat.card C = 2 ∨ Nat.card C = 4 := by
    have hn : Nat.card C ≠ 1 := fun hh => hCt (Subgroup.card_eq_one.mp hh)
    have hd : Nat.card C ∈ Nat.divisors 4 := Nat.mem_divisors.mpr ⟨hCd,by decide⟩
    have hdiv : Nat.divisors 4 = {1,2,4} := by decide
    rw [hdiv] at hd
    simp only [Finset.mem_insert,Finset.mem_singleton] at hd
    exact hd.resolve_left hn
  have hk : q.ker = center J := by
    rw [MonoidHom.ker_comp_of_injective _ _ e.injective,QuotientGroup.ker_mk']
  have hprod := IsElementaryAbelian.card_inf_ker_mul_card_map W q
  rw [hk,hWc] at hprod
  change Nat.card C * Nat.card (W.map q) = 64 at hprod
  have hEc : Nat.card (W.map q) = 16 ∨ Nat.card (W.map q) = 32 := by
    rcases hCc with hh | hh <;> rw [hh] at hprod <;> omega
  have hWA : ⁅W,A⁆ = W := by
    apply map_injective hj
    rw [map_commutator,hWmap,hAmap]
    exact hcomm.symm
  have hEB : ⁅W.map q,A.map q⁆ = W.map q := by rw [←map_commutator,hWA]
  let : IsElementaryAbelian 2 (W.map q) := IsElementaryAbelian.map q
  refine ⟨inferInstance,hEc,hEB,?_⟩
  exact le_pCoreIn_of_normalizes (IsElementaryAbelian.isPGroup 2 (W.map q))
    (map_mono (comap_mono hUL)) (le_normalizer_iff_commutator_le_left.mpr hEB.le)

/-- The actor in the same Held quotient retains its perfectness and its
literal quotient by the whole two-core. -/
theorem original_tripleSix_ordinary_held_actor
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T K)
    (structural : Structural1222At KnownSimple.IsKnownSimple T)
    (D : ChosenModule T K U)
    (a : ActionEquiv D.quotientAction Hexacode.evenAction) (t : U) (ht : t ≠ 1)
    (heven : 2 ∣ (centralizer ({(t : G)} : Set G)).relIndex K)
    (J : Subgroup (centralizer ({(t : G)} : Set G)))
    (hJ : IsComponent (centralizer ({(t : G)} : Set G)) J)
    (e : J ⧸ center J ≃* Held.He) :
    let H := centralizer ({(t : G)} : Set G)
    let Lt := (pResidual 2 (K ⊓ H : Subgroup G)).map (K ⊓ H).subtype
    let j := H.subtype.comp J.subtype
    let q := e.toMonoidHom.comp (QuotientGroup.mk' (center J))
    let B := (Lt.comap j).map q
    Group.IsPerfect B ∧ Nonempty ((B ⧸ pCore 2 B) ≃* alternatingGroup (Fin 5)) := by
  let H := centralizer ({(t : G)} : Set G)
  let Lt := (pResidual 2 (K ⊓ H : Subgroup G)).map (K ⊓ H).subtype
  let j := H.subtype.comp J.subtype
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (center J))
  let A := Lt.comap j
  have hc := original_tripleSix_pushingUp_at h structural D a t ht heven
  have hLH : Lt ≤ H := (map_subtype_le _).trans inf_le_right
  have hLJ := hc.ordinary_component_contains_original J hJ
  let b : A ≃* Lt := (subgroupOfEquivOfLe hLJ).trans (subgroupOfEquivOfLe hLH)
  let := tripleSixPointCentralizerResidual_perfect D a t ht heven
  let : Group.IsPerfect A := Group.IsPerfect.ofSurjective
    (f := b.symm.toMonoidHom) b.symm.surjective
  let bQ : (A ⧸ pCore 2 A) ≃* alternatingGroup (Fin 5) :=
    (QuotientGroup.congr _ _ b (pCore_map_iso 2 b)).trans
      (tripleSixPointResidualQuotientEquiv D a t ht heven)
  let : IsSimpleGroup (alternatingGroup (Fin 5)) := alternatingGroup.isSimpleGroup (by simp)
  let : IsSimpleGroup (A ⧸ pCore 2 A) := bQ.isSimpleGroup
  let := hJ.2
  have hz : center J = pCore 2 J :=
    IsQuasisimple.center_eq_pCore (hJ.1.pPrimeCore_eq_bot hc.oddCore_eq_bot J)
  have hk : IsPGroup 2 q.ker := by
    rw [MonoidHom.ker_comp_of_injective _ _ e.injective,QuotientGroup.ker_mk',hz]
    exact pCore_isPGroup
  let f := q.subgroupMap A
  have hfk : IsPGroup 2 f.ker := by
    rw [show f = q.subgroupMap A from rfl,ker_subgroupMap]
    exact hk.comap_subtype
  let : Group.IsNilpotent f.ker := hfk.isNilpotent
  exact ⟨Group.IsPerfect.map q,
    ⟨(PerfectCoreTwoExtension.solvableKernelQuotientEquiv f (q.subgroupMap_surjective A)).symm.trans bQ⟩⟩

private theorem sectionCentralizer_map_fixed
    {X Y : Type*} [Group X] [Finite X] [Group Y] [Finite Y]
    (f : X →* Y) (hf : Function.Surjective f)
    (hk : f.ker ≤ center X) (hp : IsPGroup 2 f.ker)
    (A W : Subgroup X) [Group.IsPerfect A]
    (hc : ChapterA.Section04.twoSectionCentralizer A ⊤ ≤ centralizer (W : Set X)) :
    ChapterA.Section04.twoSectionCentralizer (A.map f) ⊤ ≤
      centralizer (W.map f : Set Y) := by
  intro y hy
  obtain ⟨x,rfl⟩ := hf y
  have hn : x ∈ normalizer (A : Set X) := by
    rw [←comap_normalizer_map_eq_of_perfect f hk A]
    exact hy.2.1
  have hx : x ∈ ChapterA.Section04.twoSectionCentralizer A ⊤ := by
    refine ⟨mem_top _,hn,?_⟩
    intro a ha
    rw [←inf_comap_pCoreIn_eq_of_ker_isPGroup 2 f A hp]
    refine ⟨?_,?_⟩
    · exact (le_normalizer_iff_commutator_le_right.mp le_rfl)
        (commutator_mem_commutator hn ha)
    · change f ⁅x,a⁆ ∈ (A.map f).pCoreIn 2
      rw [map_commutatorElement]
      exact hy.2.2 _ (mem_map_of_mem f ha)
  intro w hw
  obtain ⟨v,hv,rfl⟩ := hw
  exact (f.map_mul v x).symm.trans ((congrArg f (hc hx v hv)).trans (f.map_mul x v))

/-- Every element of the actual Held section centralizer fixes the entire
image of U. Normalizer reflection uses the perfect original residual and
the full ordinary center, and the two-core is transported through that same map. -/
theorem original_tripleSix_ordinary_held_sectionCentralizer
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T K)
    (structural : Structural1222At KnownSimple.IsKnownSimple T)
    (D : ChosenModule T K U)
    (a : ActionEquiv D.quotientAction Hexacode.evenAction) (t : U) (ht : t ≠ 1)
    (heven : 2 ∣ (centralizer ({(t : G)} : Set G)).relIndex K)
    (J : Subgroup (centralizer ({(t : G)} : Set G)))
    (hJ : IsComponent (centralizer ({(t : G)} : Set G)) J)
    (e : J ⧸ center J ≃* Held.He) :
    let H := centralizer ({(t : G)} : Set G)
    let Lt := (pResidual 2 (K ⊓ H : Subgroup G)).map (K ⊓ H).subtype
    let j := H.subtype.comp J.subtype
    let q := e.toMonoidHom.comp (QuotientGroup.mk' (center J))
    ChapterA.Section04.twoSectionCentralizer ((Lt.comap j).map q) ⊤ ≤
      centralizer ((U.comap j).map q : Set Held.He) := by
  let H := centralizer ({(t : G)} : Set G)
  let Mt := normalizer (K : Set G) ⊓ H
  let Lt := (pResidual 2 (K ⊓ H : Subgroup G)).map (K ⊓ H).subtype
  let j := H.subtype.comp J.subtype
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (center J))
  let A := Lt.comap j
  let W := U.comap j
  have hj : Function.Injective j := H.subtype_injective.comp J.subtype_injective
  have hjr : j.range = J.map H.subtype := by rw [MonoidHom.range_comp,range_subtype]
  have hc := original_tripleSix_pushingUp_at h structural D a t ht heven
  have hLH : Lt ≤ H := (map_subtype_le _).trans inf_le_right
  have hLJ := hc.ordinary_component_contains_original J hJ
  have hLJg : Lt ≤ J.map H.subtype := by
    have hh := map_mono (f := H.subtype) hLJ
    rwa [map_subgroupOf_eq_of_le hLH] at hh
  have hAmap : A.map j = Lt := map_comap_eq_self (hLJg.trans_eq hjr.symm)
  let b : A ≃* Lt := (subgroupOfEquivOfLe hLJ).trans (subgroupOfEquivOfLe hLH)
  let := tripleSixPointCentralizerResidual_perfect D a t ht heven
  let : Group.IsPerfect A := Group.IsPerfect.ofSurjective
    (f := b.symm.toMonoidHom) b.symm.surjective
  have hfixed : ChapterA.Section04.twoSectionCentralizer A ⊤ ≤ centralizer (W : Set J) := by
    intro x hx
    have hnorm : j x ∈ normalizer (Lt : Set G) := by
      rw [←hAmap]
      exact A.le_normalizer_map j (mem_map_of_mem j hx.2.1)
    have hM : j x ∈ Mt := by
      have hh := hc.normalizer_span_eq
      rw [(tripleSixPointResidual_component D a t ht heven).2.2.2] at hh
      change H ⊓ normalizer (Lt : Set G) = Mt at hh
      exact hh ▸ (show j x ∈ H ⊓ normalizer (Lt : Set G) from ⟨x.val.property,hnorm⟩)
    have hx' : j x ∈ ChapterA.Section04.twoSectionCentralizer Lt Mt := by
      refine ⟨hM,hnorm,?_⟩
      intro l hl
      obtain ⟨y,hy,he⟩ := hAmap.symm ▸ (show l ∈ Lt from hl)
      have hcore : (A.pCoreIn 2).map j = Lt.pCoreIn 2 := by
        rw [map_pCoreIn_of_ker_isPGroup j (by rw [j.ker_eq_bot hj]; exact IsPGroup.of_bot),hAmap]
      rw [←he,←map_commutatorElement,←hcore]
      exact mem_map_of_mem j (hx.2.2 y hy)
    have hh := tripleSixPoint_twoSectionCentralizer_le h structural D a t ht heven hx'
    intro w hw
    apply hj
    simpa only [map_mul] using hh (j w) hw
  let := hJ.2
  have hz : center J = pCore 2 J :=
    IsQuasisimple.center_eq_pCore (hJ.1.pPrimeCore_eq_bot hc.oddCore_eq_bot J)
  have hk : q.ker = center J := by
    rw [MonoidHom.ker_comp_of_injective _ _ e.injective,QuotientGroup.ker_mk']
  exact sectionCentralizer_map_fixed q
    (e.surjective.comp (QuotientGroup.mk'_surjective _)) hk.le
    (by rw [hk,hz]; exact pCore_isPGroup) A W hfixed

end CFSG.Quasithin.Chapter12.Section07
