module
public import CFSG.Quasithin.Chapter12.Section02.ModuleClassification.Actions

/-!
# Indecomposability of the actual chosen module

An Irr⁺ module is generated by commutators and is irreducible modulo its
fixed space. Every proper invariant subspace is therefore fixed. If a
complementary summand is fixed, all commutators lie in the other summand,
which must be the whole module. This proves indecomposability before any
model is classified, including the four-dimensional alternative of 12.2.2.
The action is the original quotient L/O₂(L) on the original chosen space.
Source: Aschbacher--Smith A.1.40 and 12.2.2(3b), printed pp.31 and 795.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter12.Section02.ChosenModule
open ChapterB.QuasisimpleSource
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  (D : ChosenModule T L V)

/-- Irr⁺ descends through the original component two-core projection. -/
theorem quotientAction_irrPlus : IsIrrPlus D.quotientAction ⊤ ⊤ := by
  let H := L ⊔ (T : Subgroup G)
  let X := L.subgroupOf H
  let f : X →* (⊤ : Subgroup (L ⧸ pCore 2 L)) :=
    Subgroup.topEquiv.symm.toMonoidHom.comp
      ((QuotientGroup.mk' (pCore 2 L)).comp (subgroupOfEquivOfLe le_sup_left).toMonoidHom)
  have hf : Function.Surjective f := Subgroup.topEquiv.symm.surjective.comp
    ((QuotientGroup.mk'_surjective _).comp (subgroupOfEquivOfLe le_sup_left).surjective)
  apply D.irrPlus.isIrrPlus.of_intertwining (reducedRepresentation H) D.quotientAction
    f hf D.space.subtype (Submodule.injective_subtype _)
  · intro x v
    rfl
  · simp only [Submodule.map_top, Submodule.range_subtype]

/-- No nontrivial invariant direct summand can split off from the chosen V. -/
theorem quotientAction_indecomposable : IsIndecomposable D.quotientAction := by
  have hi := D.quotientAction_irrPlus
  have hn : Nontrivial D.space :=
    Submodule.nontrivial_iff_ne_bot.mpr (D.irrPlus.isIrrPlus.ne_bot _)
  refine ⟨hn,?_⟩
  intro A B hAB
  have hA : (⊤ : Subgroup (L ⧸ pCore 2 L)) ≤
      subspaceStabilizer D.quotientAction A.toSubmodule :=
    le_subspaceStabilizer _ _ (fun g _ v hv => A.apply_mem_toSubmodule g hv)
  have hB : (⊤ : Subgroup (L ⧸ pCore 2 L)) ≤
      subspaceStabilizer D.quotientAction B.toSubmodule :=
    le_subspaceStabilizer _ _ (fun g _ v hv => B.apply_mem_toSubmodule g hv)
  rcases hi.eq_or_le_fixedSpace D.quotientAction hA le_top with hAt | hAf
  · right
    apply Subrepresentation.toSubmodule_injective
    exact eq_bot_of_top_isCompl (hAt ▸ hAB)
  · have htB : (⊤ : Submodule (ZMod 2) D.space) ≤ B.toSubmodule := by
      rw [← hi.choose_spec.1]
      apply subspaceCommutator_le_of_le_sup_fixedSpace D.quotientAction hB
      rw [← hAB.sup_eq_top]
      exact sup_le (hAf.trans le_sup_right) le_sup_left
    left
    apply Subrepresentation.toSubmodule_injective
    exact eq_bot_of_isCompl_top ((top_unique htB) ▸ hAB)

end CFSG.Quasithin.Chapter12.Section02.ChosenModule
