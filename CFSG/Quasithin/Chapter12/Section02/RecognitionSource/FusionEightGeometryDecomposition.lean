module

public import CFSG.Quasithin.Chapter12.Section02.RecognitionSource.FusionEightGeometryModule
public import CFSG.Quasithin.Chapter12.Section02.RecognitionSource.FusionEightGeometry
public import CFSG.Quasithin.Chapter12.Section02.ReductionSource.Fundamental
public import Theory.GroupTheory.PCoreImage

/-!
# Subgroup preparation for the corrected A₈ fixed supplement

Write E = Ω₁Z(C_T(v)), W = ⟨Eᴸ⟩ and U = C_V(C_T(v)). The original
chosen module is contained in W and generated by its L-commutators.
Consequently it is contained in [W,L], including its nontrivial fixed line.
Reducedness of W also makes O₂(L) centralize W. These are the literal
subgroup inputs to the FF classification and displacement-cocycle argument.

The final theorem isolates the Sylow supplement needed for T-centralization.
It does not assume that C_T(v) is a full Sylow of LT. In particular this
module makes no application of B.2.13, whose full-Sylow hypothesis is missing
in the printed argument. Source: Aschbacher--Smith 12.2.16, printed p.800;
compare B.2.13, printed p.78.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter12.Section02.RecognitionSource
namespace AlternatingEightFusion
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {L V : Subgroup G}
variable (C : AlternatingEightFusion T L V)

/-- The whole point-fixed core, retaining all its vectors. -/
abbrev pointCore : Subgroup G := V ⊓ centralizer (C.pointSylow : Set G)

omit [Finite G] in
/-- Intersecting the actual omega-center with V gives the full point-fixed core. -/
theorem pointCore_eq_inf_omega (D : ChosenModule T L V) :
    C.pointCore = V ⊓ omegaCenterIn C.pointSylow := by
  let := D.elementary
  apply le_antisymm
  · intro w hw
    exact ⟨hw.1, (mem_omegaCenterIn_iff _ _).mpr
      ⟨C.chosen_le_pointSylow D hw.1, hw.2,
        elemPow_eq_one_of_isElementaryAbelian _ hw.1⟩⟩
  · intro w hw
    exact ⟨hw.1, ((mem_omegaCenterIn_iff _ _).mp hw.2).2.1⟩

omit [Finite G] in
theorem pointCore_le_omega (D : ChosenModule T L V) :
    C.pointCore ≤ omegaCenterIn C.pointSylow := by
  rw [C.pointCore_eq_inf_omega D]
  exact inf_le_right

omit [Finite G] in
/-- Reducedness is relative to LT; its core centralizes the original ambient W. -/
theorem joinCore_centralizes_pointSpan (R : C.PointSpanModule) :
    (L ⊔ (T : Subgroup G)).pCoreIn 2 ≤ centralizer (C.pointSpan : Set G) := by
  let H := L ⊔ (T : Subgroup G)
  have hWH : C.pointSpan ≤ H := R.le_sylow.trans le_sup_right
  have hc := le_centralizer_iff.mp R.reduced.le_centralizer_pCore
  rintro _ ⟨a, ha, rfl⟩ w hw
  exact congrArg (fun x : H => (x : G)) (hc ha ⟨w, hWH hw⟩ hw)

omit [Finite G] in
/-- The original two-core quotient acts on W, with no change of quotient kernel. -/
theorem componentCore_centralizes_pointSpan (D : ChosenModule T L V)
    (R : C.PointSpanModule) :
    L.pCoreIn 2 ≤ centralizer (C.pointSpan : Set G) :=
  (pCoreIn_mono_of_normalizes le_sup_left
    (sup_le L.le_normalizer D.sylow_normalizes_component)).trans
      (C.joinCore_centralizes_pointSpan R)

omit [Finite G] in
/-- The chosen Irr⁺ subgroup lies in the actual moved point span. -/
theorem chosen_le_pointSpan_commutator (D : ChosenModule T L V) :
    V ≤ ⁅C.pointSpan, L⁆ := by
  calc
    V = ⁅V, L⁆ := D.eq_commutator
    _ ≤ ⁅C.pointSpan, L⁆ := commutator_mono (C.chosen_le_pointSpan D) le_rfl

omit [Finite G] in
/-- The fixed line prevents the moved space from having a disjoint L-fixed complement.
This is the hypothesis selecting clause (2) of B.5.1. -/
theorem pointSpan_moved_inf_fixed_ne_bot (D : ChosenModule T L V) :
    ⁅C.pointSpan, L⁆ ⊓ centralizer (L : Set G) ≠ ⊥ := by
  intro he
  exact C.z_ne (mem_bot.mp (he ▸
    (show (C.z : G) ∈ ⁅C.pointSpan, L⁆ ⊓ centralizer (L : Set G) from
      ⟨C.chosen_le_pointSpan_commutator D C.z.property, C.z_fixed⟩)))

omit [Finite G] in
/-- The exact Sylow supplement suffices for the requested T-centralization. -/
theorem pointFixed_centralizes_sylow_of_supplement
    (hs : (T : Subgroup G) ≤ C.pointSylow ⊔ ((T : Subgroup G) ⊓ L)) :
    C.pointFixed ≤ centralizer ((T : Subgroup G) : Set G) := by
  apply le_centralizer_iff.mp
  apply hs.trans
  apply sup_le
  · apply le_centralizer_iff.mp
    intro x hx
    exact ((mem_omegaCenterIn_iff _ _).mp hx.1).2.1
  · apply le_centralizer_iff.mp
    exact (inf_le_right : C.pointFixed ≤ centralizer (L : Set G)).trans
      (centralizer_le inf_le_right)

end AlternatingEightFusion
end CFSG.Quasithin.Chapter12.Section02.RecognitionSource
