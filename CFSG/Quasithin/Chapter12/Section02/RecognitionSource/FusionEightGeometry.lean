module

public import CFSG.Quasithin.Chapter12.Section02.RecognitionSource.FusionAlternatingEight
public import CFSG.Quasithin.Chapter1.Section02.Uniqueness.SourceKnownSimple
public import Theory.GroupTheory.FourGroupNormalizerIndex
public import Theory.GroupTheory.NormalizingInvolutionCard

/-!
# The conditional terminal geometry in the A₈ fusion branch

Put Zᵥ = Ω₁Z(C_T(v)) and Z_L = C_{Zᵥ}(L). If the preceding module analysis
gives Zᵥ = ⟨v⟩ Z_L and T centralizes Z_L, the actual known-simple uniqueness
theorem gives disjoint conjugates of Z_L. Since Z_L is a hyperplane in Zᵥ,
it has order two and is generated by the original constant involution z.
Consequently Zᵥ ≤ V, and the existing fixed-line fusion theorem contradicts
the supplied outside conjugator.

The two geometric premises remain explicit. This proves the terminal
deduction, not the source theorem: the printed route to those premises has
the seed obstruction checked in `FusionEightGeometrySeed`.
Source: Aschbacher--Smith 12.2.16, last paragraph, printed p.800.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter12.Section02.RecognitionSource
namespace AlternatingEightFusion
universe u
variable {G : Type u} [Group G] [Finite G]
variable {T : Sylow 2 G} {L V : Subgroup G}
variable (C : AlternatingEightFusion T L V)

/-- The literal L-fixed part of the point-Sylow central omega. -/
abbrev pointFixed : Subgroup G := omegaCenterIn C.pointSylow ⊓ centralizer (L : Set G)

omit [Finite G] in
private theorem point_ne_one : (C.v : G) ≠ 1 := by
  intro he
  have hv : C.v = 1 := Subtype.ext he
  have hw := C.weight_two
  rw [hv, map_one] at hw
  norm_num at hw

omit [Finite G] in
private theorem point_ne_fixed : (C.v : G) ≠ (C.z : G) := by
  intro he
  have hv : C.v = C.z := Subtype.ext he
  have hw := C.weight_two
  rw [hv] at hw
  have heq : (Finset.univ.filter fun i : Fin 8 =>
      (C.vectorEquiv C.z).toAdd.val i ≠ 0) = Finset.univ := by
    apply Finset.filter_true_of_mem
    intro i _
    rw [C.constant]
    exact one_ne_zero
  rw [heq] at hw
  norm_num at hw

omit [Finite G] in
private theorem point_not_mem_pointFixed : (C.v : G) ∉ C.pointFixed := by
  intro hv
  exact (C.fixed_line C.v C.v.property hv.2).elim C.point_ne_one C.point_ne_fixed

/-- Known-simple uniqueness supplies the actual disjoint conjugates needed at the endpoint. -/
theorem pointFixed_disjoint_conjugate
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (structural : Structural1222 KnownSimple.IsKnownSimple.{u})
    (hT : C.pointFixed ≤ centralizer ((T : Subgroup G) : Set G)) :
    C.pointFixed ⊓ C.pointFixed.map (MulAut.conj C.g).toMonoidHom = ⊥ := by
  have horbit : componentOrbit L (T : Subgroup G) = L :=
    le_antisymm (iSup_conjugates_le_of_le_normalizer L T L le_rfl
      (structural G T L h).1) (le_componentOrbit L T)
  have hu := Chapter1.Section02.nonsolvable_uniqueness_knownSimple
    h.simpleQTKE T h.maximal_faithful.1
  have hd := hu.centralizer_intersection C.g (by simpa only [horbit] using C.outside)
  change (omegaCenterIn (T : Subgroup G) ⊓ centralizer (componentOrbit L T : Set G)) ⊓
    (omegaCenterIn (T : Subgroup G) ⊓ centralizer (componentOrbit L T : Set G)).map
      (MulAut.conj C.g).toMonoidHom = ⊥ at hd
  rw [horbit] at hd
  have hle : C.pointFixed ≤ omegaCenterIn (T : Subgroup G) ⊓ centralizer (L : Set G) := by
    intro x hx
    have hh := (mem_omegaCenterIn_iff _ _).mp hx.1
    exact ⟨(mem_omegaCenterIn_iff _ _).mpr ⟨hh.1.1, hT hx, hh.2.2⟩, hx.2⟩
  exact bot_unique ((inf_le_inf hle (map_mono hle)).trans hd.le)

/-- The printed decomposition and T-centralization imply the requested containment.
These two premises still require a valid preceding source argument. -/
theorem omega_le_of_pointFixed_decomposition
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L) (D : ChosenModule T L V)
    (structural : Structural1222 KnownSimple.IsKnownSimple.{u})
    (hsplit : omegaCenterIn C.pointSylow = C.pointFixed ⊔ zpowers (C.v : G))
    (hT : C.pointFixed ≤ centralizer ((T : Subgroup G) : Set G)) :
    omegaCenterIn C.pointSylow ≤ V := by
  let := D.elementary
  have hz : (C.z : G) ∈ C.pointFixed :=
    ⟨C.fixed_mem_pointSylow_omega h D structural, C.z_fixed⟩
  have hne : C.pointFixed ≠ ⊥ := fun he => C.z_ne (mem_bot.mp (he ▸ hz))
  have hvN : (C.v : G) ∈ normalizer (C.pointFixed : Set G) := by
    apply Subgroup.centralizer_le_normalizer
    intro x hx
    exact (hT hx C.v (D.le_sylow C.v.property)).symm
  have hcard := card_sup_zpowers_of_normalizing_involution C.pointFixed (C.v : G)
    (elemPow_eq_one_of_isElementaryAbelian _ C.v.property) C.point_not_mem_pointFixed hvN
  rw [← hsplit] at hcard
  have hi : C.pointFixed.relIndex (omegaCenterIn C.pointSylow) = 2 := by
    have hh := relIndex_mul_relIndex (⊥ : Subgroup G) C.pointFixed
      (omegaCenterIn C.pointSylow) bot_le inf_le_left
    rw [relIndex_bot_left, relIndex_bot_left, hcard] at hh
    have hp : 0 < Nat.card C.pointFixed := Nat.card_pos
    nlinarith
  have hc := (card_eq_two_of_disjoint_conjugate_hyperplane C.pointFixed
    (omegaCenterIn C.pointSylow) inf_le_left hne hi C.g
    (normalizer_le_normalizer_omegaCenterIn C.pointSylow C.normalizes)
    (C.pointFixed_disjoint_conjugate h structural hT)).1
  have hzcard : Nat.card (zpowers (C.z : G)) = 2 := by
    rw [Nat.card_zpowers]
    exact orderOf_eq_prime (elemPow_eq_one_of_isElementaryAbelian _ C.z.property) C.z_ne
  have he : zpowers (C.z : G) = C.pointFixed :=
    eq_of_le_of_card_ge (zpowers_le.mpr hz) (by rw [hc, hzcard])
  rw [hsplit, ← he]
  exact sup_le (zpowers_le.mpr C.z.property) (zpowers_le.mpr C.v.property)

/-- The terminal deduction applied to the actual adjusted outside conjugator. -/
theorem false_of_pointFixed_decomposition
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L) (D : ChosenModule T L V)
    (structural : Structural1222 KnownSimple.IsKnownSimple.{u}) (hnone : NoEscape L V)
    (hsplit : omegaCenterIn C.pointSylow = C.pointFixed ⊔ zpowers (C.v : G))
    (hT : C.pointFixed ≤ centralizer ((T : Subgroup G) : Set G)) : False := by
  exact C.false_of_omega_le h D structural hnone
    (C.omega_le_of_pointFixed_decomposition h D structural hsplit hT)

end AlternatingEightFusion
end CFSG.Quasithin.Chapter12.Section02.RecognitionSource
