module

public import CFSG.Quasithin.Chapter12.Section02.ModuleClassification.Irreducibility
public import Theory.Representation.G2OrthogonalCover.Universal

/-!
# Reconstructing the original seven-dimensional Weyl module

The given marking of V/C_V(L) reindexes the original L/O₂(L) action by
G₂(2)′. The literal central quotient is a central cover: its kernel is fixed,
and the chosen Irr⁺ module is generated by commutators. The universal
trace-zero cover therefore maps onto V over the specified projection.

The central quotient has dimension six and the original fixed space is
nonzero, whereas the covering seven-space bounds the dimension above by
seven. Equality makes the covering map an isomorphism. Both the original
actor marking and the given natural projection are retained.

Source: Aschbacher–Smith, 12.2.2(3f), p.795, and 12.2.16, p.800,
using the universal cover in I.2.3, p.413. No full G₂ action is assumed.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open Representation.OneCohomology Atlas.G2.Natural
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter12.Section02.RecognitionSource
open ChapterB.QuasisimpleSource
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}

namespace G2WeylModel

abbrev Fixed (D : ChosenModule T L V) :=
  (fixedSpace (reducedRepresentation (L ⊔ (T : Subgroup G)))
    (L.subgroupOf (L ⊔ (T : Subgroup G)))).comap D.space.subtype

variable (D : ChosenModule T L V)
    (e : ActionEquiv D.centralQuotientAction
      ((g2Natural (ZMod 2)).comp (commutator (Atlas.G2.Model (ZMod 2))).subtype))

def action : Representation (ZMod 2) (commutator (Atlas.G2.Model (ZMod 2))) D.space :=
  D.quotientAction.comp e.groupEquiv.symm.toMonoidHom

theorem action_apply (q : L ⧸ pCore 2 L) (v : D.space) :
    action D e (e.groupEquiv q) v = D.quotientAction q v := by
  change D.quotientAction (e.groupEquiv.symm (e.groupEquiv q)) v = _
  rw [e.groupEquiv.symm_apply_apply]

def projection : (action D e).IntertwiningMap (OrthogonalCover.binaryNatural (ZMod 2)) :=
  (e.linearEquiv.toLinearMap.comp (Fixed D).mkQ).intertwiningMap_of_isIntertwiningMap _ _ (by
    intro g v
    obtain ⟨q,rfl⟩ := e.groupEquiv.surjective g
    change e.linearEquiv ((Fixed D).mkQ (action D e (e.groupEquiv q) v)) = _
    rw [action_apply]
    obtain ⟨l,rfl⟩ := QuotientGroup.mk'_surjective (pCore 2 L) q
    exact e.intertwines (QuotientGroup.mk' (pCore 2 L) l) ((Fixed D).mkQ v))

theorem projection_apply (v : D.space) :
    projection D e v = e.linearEquiv (Submodule.Quotient.mk v) := rfl

theorem kernel_fixed : (projection D e).toLinearMap.ker ≤ OneCohomology.fixed (action D e) := by
  intro v hv g
  obtain ⟨q,rfl⟩ := e.groupEquiv.surjective g
  obtain ⟨l,rfl⟩ := QuotientGroup.mk'_surjective (pCore 2 L) q
  rw [action_apply]
  have hvC : v ∈ Fixed D := by
    apply (Submodule.Quotient.mk_eq_zero (Fixed D)).mp
    exact e.linearEquiv.injective ((show e.linearEquiv ((Fixed D).mkQ v) = 0 from hv).trans
      (map_zero e.linearEquiv).symm)
  exact Subtype.ext (hvC ((subgroupOfEquivOfLe
    (show L ≤ L ⊔ (T : Subgroup G) from le_sup_left)).symm l))

theorem generated : Coinvariants.ker (action D e) = ⊤ := by
  have hle : subspaceCommutator D.quotientAction ⊤ ⊤ ≤ Coinvariants.ker (action D e) := by
    apply Submodule.span_le.mpr
    rintro _ ⟨q, _, v, _, rfl⟩
    have hh := Coinvariants.sub_mem_ker (ρ := action D e) (e.groupEquiv q) v
    rwa [action_apply] at hh
  rw [D.quotientAction_irrPlus.choose_spec.1] at hle
  exact top_unique hle

theorem isCover : IsCover (projection D e) :=
  ⟨e.linearEquiv.surjective.comp (Fixed D).mkQ_surjective,kernel_fixed D e,generated D e⟩

omit e [Finite G] in
theorem fixed_ne_bot (hne : V ⊓ centralizer (L : Set G) ≠ ⊥) : Fixed D ≠ ⊥ := by
  obtain ⟨z,hzne⟩ := Subgroup.ne_bot_iff_exists_ne_one.mp hne
  have hz := z.property
  have hz1 : (z : G) ≠ 1 := fun he => hzne (Subtype.ext he)
  let v := (D.spaceEquiv.symm ⟨z,hz.1⟩).toAdd
  have hv : (v.val.toMul.val : G) = z :=
    (D.spaceEquiv_apply v).symm.trans
      (congrArg Subtype.val (D.spaceEquiv.apply_symm_apply ⟨z,hz.1⟩))
  have hvC : v ∈ Fixed D := by
    intro l
    apply Additive.toMul.injective
    apply Subtype.ext
    apply Subtype.ext
    change (l.val.val : G) * (v.val.toMul.val : G) * (l.val.val : G)⁻¹ = (v.val.toMul.val : G)
    rw [hv]
    exact mul_inv_eq_iff_eq_mul.mpr (hz.2 _ l.property)
  intro he
  have hv0 : v = 0 := (Submodule.mem_bot (R := ZMod 2)).mp (he ▸ hvC)
  exact hz1 (hv.symm.trans (congrArg (fun w : D.space => (w.val.toMul.val : G)) hv0))

end G2WeylModel

/-- The nontrivial original fixed space forces its universal Weyl quotient
map to be an isomorphism, retaining the specified actor and projection. -/
theorem g2_weyl_model (D : ChosenModule T L V)
    (hne : V ⊓ centralizer (L : Set G) ≠ ⊥)
    (e : ActionEquiv D.centralQuotientAction
      ((g2Natural (ZMod 2)).comp (commutator (Atlas.G2.Model (ZMod 2))).subtype)) :
    ∃ a : ActionEquiv D.quotientAction (OrthogonalCover.action (ZMod 2)),
      a.groupEquiv = e.groupEquiv ∧
      ∀ w : D.space, mk (ZMod 2) (a.linearEquiv w) =
        e.linearEquiv (Submodule.Quotient.mk w) := by
  obtain ⟨f,hf,hover⟩ := OrthogonalCover.exists_quotient (ZMod 2)
    (G2WeylModel.projection D e) (G2WeylModel.isCover D e)
  let C := G2WeylModel.Fixed D
  have hpos : 0 < Module.finrank (ZMod 2) C :=
    Module.finrank_pos_iff.mpr (Submodule.nontrivial_iff_ne_bot.mpr (G2WeylModel.fixed_ne_bot D hne))
  have hdq : Module.finrank (ZMod 2) (D.space ⧸ C) = 6 :=
    e.linearEquiv.finrank_eq.trans (finrank_space (ZMod 2))
  have hsum := C.finrank_quotient_add_finrank
  have hupper := LinearMap.finrank_le_finrank_of_surjective hf
  rw [OrthogonalCover.finrank_traceZero] at hupper
  have hd : Module.finrank (ZMod 2) D.space = 7 := by omega
  have hi : Function.Injective f :=
    (LinearMap.injective_iff_surjective_of_finrank_eq_finrank
      ((OrthogonalCover.finrank_traceZero (ZMod 2)).trans hd.symm)).mpr hf
  let a := LinearEquiv.ofBijective f.toLinearMap ⟨hi,hf⟩
  refine ⟨{ groupEquiv := e.groupEquiv, linearEquiv := a.symm, intertwines := ?_ }, rfl, ?_⟩
  · intro q v
    apply a.injective
    change a (a.symm (D.quotientAction q v)) =
      f (OrthogonalCover.binaryAction (ZMod 2) (e.groupEquiv q) (a.symm v))
    rw [a.apply_symm_apply, f.isIntertwining, G2WeylModel.action_apply]
    exact congrArg (D.quotientAction q) (a.apply_symm_apply v).symm
  · intro w
    have hh := hover (a.symm w)
    change e.linearEquiv (C.mkQ (a (a.symm w))) = _ at hh
    rw [a.apply_symm_apply] at hh
    exact hh.symm


end CFSG.Quasithin.Chapter12.Section02.RecognitionSource
