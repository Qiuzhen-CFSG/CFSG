module
public import CFSG.Quasithin.Chapter12.Section02.RecognitionSource.LocalConfigurationRigidityKernelHyperplane
public import Theory.GroupTheory.PrimeDihedralShear
public import Theory.ElementaryAbelian.Join

/-!
# The literal fixed supplement before the dimensional branches

The actual kernel Q=C_T(V) acts on U by shears across U∩V, so its action
has square one. The image of the prime-order P is normal in the image
of H on U. An involutive shear fixing U∩V either fixes this image or
inverts it. Since U is generated by U∩V and a P-conjugate, the shear
is trivial or equals the action of the original inverter in V.
Consequently Q=V C_T(I), without assuming a cocycle model or a split
over C_T(L). This also proves elementarity of Q and the literal
hyperplane-centralizer decomposition in all dimensions.

Source: Aschbacher--Smith, original 12.2.25, printed p.805, first paragraph.
The dimension-three kernel consumer is LocalConfigurationRigidityKernelD3;
final source assembly remains with qt-d-12213-local-rigidity.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative Pointwise commutatorElement
namespace CFSG.Quasithin.Chapter12.Section02.RecognitionSource
universe u
variable {G : Type u} [Group G] [Finite G]
variable {T : Sylow 2 G} {L V H P U : Subgroup G} {d : ℕ}
namespace RigidityKernel

omit [Finite G] in
/-- The literal kernel acts on U by shears across U ∩ V. -/
theorem kernel_core_commutator_le
    (C : CyclicLocalAnalysis T L V d H P U)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G)) :
    ⁅(T : Subgroup G) ⊓ centralizer (V : Set G), U⁆ ≤ U ⊓ V := by
  have hnorm : (T : Subgroup G) ≤ normalizer
      (((T : Subgroup G) ⊓ centralizer (V : Set G) : Subgroup G) : Set G) :=
    (le_inf (T : Subgroup G).le_normalizer
      (hTV.trans (normalizer_le_normalizer_centralizer V))).trans
        inf_normalizer_le_normalizer_inf
  rw [← C.action_kernel]
  exact le_inf
    (le_normalizer_iff_commutator_le_right.mp (inf_le_left.trans C.sylow_normalizes_core))
    ((le_normalizer_iff_commutator_le_left.mp (C.core_le_sylow.trans hnorm)).trans inf_le_right)

omit [Finite G] in
/-- Each kernel square centralizes U. This is a genuine consequence of the
literal subgroup action, not an assumed cocycle model. -/
theorem kernel_square_centralizes_core
    (C : CyclicLocalAnalysis T L V d H P U)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    {q : G} (hq : q ∈ (T : Subgroup G) ⊓ centralizer (V : Set G)) :
    q ^ 2 ∈ centralizer (U : Set G) := by
  let := C.elementary
  intro u hu
  let w := ⁅q,u⁆
  have hw : w ∈ U ⊓ V := kernel_core_commutator_le C hTV (commutator_mem_commutator hq hu)
  have hw2 : w ^ 2 = 1 := elemPow_eq_one_of_isElementaryAbelian (A := U) w hw.1
  have hc : q*w = w*q := (hq.2 w hw.2).symm
  have hwu : q*u*q⁻¹ = w*u := by dsimp [w]; group
  have he : q^2*u*(q^2)⁻¹ = u := by
    calc
      q^2*u*(q^2)⁻¹ = q*(q*u*q⁻¹)*q⁻¹ := by simp only [pow_two]; group
      _ = q*(w*u)*q⁻¹ := by rw [hwu]
      _ = w*(q*u*q⁻¹) := by rw [← mul_assoc q w u,hc]; group
      _ = w*(w*u) := by rw [hwu]
      _ = u := by rw [← mul_assoc, ← pow_two, hw2, one_mul]
  exact (mul_inv_eq_iff_eq_mul.mp he).symm

/-- A kernel element has on U either the trivial action or the action of
an element of the original V. -/
theorem kernel_action_twist
    (D : ChosenModule T L V) (A : NaturalLocalAnalysis T L V d)
    (C : CyclicLocalAnalysis T L V d H P U)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    {q : G} (hq : q ∈ (T : Subgroup G) ⊓ centralizer (V : Set G)) :
    ∃ v ∈ V, v * q ∈ centralizer (U : Set G) := by
  classical
  let := C.elementary
  let := D.elementary
  have hPH : P ≤ H := by rw [C.overgroup]; exact le_sup_left
  have hUH : U ≤ H := C.core_le_sylow.trans C.sylow_le_overgroup
  let f : H →* MulAut U := U.normalizerMonoidHom.comp (inclusion C.overgroup_normalizes_core)
  have hf (x : H) (u : U) : (f x u : G) = (x : G) * (u : G) * (x : G)⁻¹ := rfl
  let fP : P →* MulAut U := f.comp (inclusion hPH)
  have hfP : Function.Injective fP := by
    apply fP.ker_eq_bot_iff.mp
    apply bot_unique
    intro p hp
    apply mem_bot.mpr
    apply Subtype.ext
    apply mem_bot.mp
    rw [← C.odd_centralizer_core_eq_bot (by have := A.dimension.1; omega)]
    refine ⟨p.property, ?_⟩
    intro u hu
    have he := congrArg (fun a : MulAut U => (a ⟨u,hu⟩ : G)) (MonoidHom.mem_ker.mp hp)
    change (p : G) * u * (p : G)⁻¹ = u at he
    exact (mul_inv_eq_iff_eq_mul.mp he).symm
  let F := fP.range
  have hFcard : (Nat.card F).Prime := by
    rw [← Nat.card_congr (MonoidHom.ofInjective hfP).toEquiv]
    exact C.prime_order
  have hUker : U.subgroupOf H ≤ f.ker := by
    intro u hu
    apply MonoidHom.mem_ker.mpr
    apply MulEquiv.ext
    intro w
    apply Subtype.ext
    change (u : G) * (w : G) * (u : G)⁻¹ = w
    have hc : (u : G) * (w : G) = (w : G) * (u : G) :=
      (le_centralizer U (show (u : G) ∈ U from hu) w w.property).symm
    rw [hc, mul_inv_cancel_right]
  have hres : ((P ⊔ U).subgroupOf H).map f = F := by
    rw [subgroupOf_sup hPH hUH, Subgroup.map_sup, ((U.subgroupOf H).map_eq_bot_iff).mpr hUker, sup_bot_eq]
    change (P.subgroupOf H).map f = (f.comp (inclusion hPH)).range
    rw [MonoidHom.range_comp, inclusion_range]
  have hnorm : ∀ x : H, f x ∈ normalizer (F : Set (MulAut U)) := by
    intro x
    rw [← hres]
    apply ((P ⊔ U).subgroupOf H).le_normalizer_map f
    apply mem_map_of_mem
    let : ((P ⊔ U).subgroupOf H).Normal :=
      normal_subgroupOf_of_le_normalizer C.overgroup_normalizes_residual
    exact le_normalizer_of_normal (mem_top x)
  obtain ⟨g,hg,hg1,_,hgen⟩ := C.pair
  obtain ⟨v,hv,hvU,hvinv⟩ := C.inverted
  let vH : H := ⟨v,C.sylow_le_overgroup (D.le_sylow hv)⟩
  let qH : H := ⟨q,C.sylow_le_overgroup hq.1⟩
  let gH : H := ⟨g,hPH hg⟩
  let W := (U ⊓ V).subgroupOf U
  have hWgen : W ⊔ W.map (f gH).toMonoidHom = ⊤ := by
    apply (map_injective U.subtype_injective)
    rw [Subgroup.map_sup, map_map, ← MonoidHom.range_eq_map, range_subtype]
    have he : U.subtype.comp (f gH).toMonoidHom =
        (MulAut.conj g).toMonoidHom.comp U.subtype := rfl
    rw [he, ← map_map, map_subgroupOf_eq_of_le inf_le_left]
    exact hgen.symm
  have hv2 : f vH ^ 2 = 1 := by
    rw [← map_pow]
    have he : vH ^ 2 = 1 := Subtype.ext (elemPow_eq_one_of_isElementaryAbelian (A := V) v hv)
    rw [he,map_one]
  have hvW : ∀ w ∈ W, f vH w = w := by
    intro w hw
    apply Subtype.ext
    change v * (w : G) * v⁻¹ = w
    rw [← (le_centralizer V hv) w hw.2, mul_inv_cancel_right]
  have hvF : ∀ p ∈ F, f vH * p * (f vH)⁻¹ = p⁻¹ := by
    rintro _ ⟨p,rfl⟩
    change f vH * f (inclusion hPH p) * (f vH)⁻¹ = (f (inclusion hPH p))⁻¹
    rw [← map_inv, ← map_mul, ← map_mul, ← map_inv]
    apply congrArg f
    exact Subtype.ext (hvinv p p.property)
  have hq2 : f qH ^ 2 = 1 := by
    rw [← map_pow]
    apply MulEquiv.ext
    intro w
    apply Subtype.ext
    change q^2 * (w : G) * (q^2)⁻¹ = w
    rw [← kernel_square_centralizes_core C hTV hq w w.property,mul_inv_cancel_right]
  have hqW : ∀ w ∈ W, f qH w = w := by
    intro w hw
    apply Subtype.ext
    change q * (w : G) * q⁻¹ = w
    rw [← hq.2 w hw.2,mul_inv_cancel_right]
  rcases MulAut.prime_dihedral_shear F hFcard W (f gH) ⟨⟨g,hg⟩,rfl⟩
    hWgen (f vH) hv2 hvW hvF (f qH) hq2 (hnorm qH) hqW with hqtriv | hqv
  · refine ⟨1,V.one_mem,?_⟩
    rw [one_mul]
    intro u hu
    have he := congrArg (fun a : MulAut U => (a ⟨u,hu⟩ : G)) hqtriv
    change q * u * q⁻¹ = u at he
    exact (mul_inv_eq_iff_eq_mul.mp he).symm
  · refine ⟨v,hv,?_⟩
    have he : f (vH*qH) = 1 := by rw [map_mul,hqv,← pow_two,hv2]
    intro u hu
    have hh := congrArg (fun a : MulAut U => (a ⟨u,hu⟩ : G)) he
    change (v*q) * u * (v*q)⁻¹ = u at hh
    exact (mul_inv_eq_iff_eq_mul.mp hh).symm

/-- The literal kernel is V times its fixed subgroup on the cyclic pair.
This precedes, and does not assume, either cohomology branch. -/
theorem kernel_pair_split
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (D : ChosenModule T L V) (structural : Structural1222.{u} KnownSimple.IsKnownSimple)
    (A : NaturalLocalAnalysis T L V d) (C : CyclicLocalAnalysis T L V d H P U)
    (hnone : NoEscape L V) :
    (T : Subgroup G) ⊓ centralizer (V : Set G) =
      V ⊔ ((T : Subgroup G) ⊓ centralizer (cyclicPairJoin P U V : Set G)) := by
  let := D.elementary
  let E := (T : Subgroup G) ⊓ centralizer (cyclicPairJoin P U V : Set G)
  have hVQ : V ≤ (T : Subgroup G) ⊓ centralizer (V : Set G) :=
    le_inf D.le_sylow (le_centralizer V)
  have hEQ : E ≤ (T : Subgroup G) ⊓ centralizer (V : Set G) :=
    le_inf inf_le_left (inf_le_right.trans (centralizer_le
      (show V ≤ cyclicPairJoin P U V from le_sup_right)))
  apply le_antisymm _ (sup_le hVQ hEQ)
  intro q hq
  obtain ⟨v,hv,hvq⟩ := kernel_action_twist D A C
    (((structural G T L h).2.2 V D).1) hq
  have hvqQ := ((T : Subgroup G) ⊓ centralizer (V : Set G)).mul_mem (hVQ hv) hq
  have hvqJ : v*q ∈ (T : Subgroup G) ⊓ centralizer ((U ⊔ V : Subgroup G) : Set G) :=
    ⟨hvqQ.1, le_centralizer_iff.mp (sup_le
      (le_centralizer_iff.mp (show zpowers (v*q) ≤ centralizer (U : Set G) from
        zpowers_le.mpr hvq))
      (le_centralizer_iff.mp (show zpowers (v*q) ≤ centralizer (V : Set G) from
        zpowers_le.mpr hvqQ.2))) (mem_zpowers (v*q))⟩
  have hx : v*q ∈ V ⊔ E := (show (U ⊓ V) ⊔ E ≤ V ⊔ E from
    sup_le (inf_le_right.trans le_sup_left) le_sup_right)
    ((join_centralizer_split h D structural A C hnone).le hvqJ)
  simpa only [inv_mul_cancel_left] using (V ⊔ E).mul_mem (mem_sup_left (V.inv_mem hv)) hx

/-- The whole Sylow kernel is elementary before the dimensional split. -/
theorem kernel_elementary
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (D : ChosenModule T L V) (structural : Structural1222.{u} KnownSimple.IsKnownSimple)
    (A : NaturalLocalAnalysis T L V d) (C : CyclicLocalAnalysis T L V d H P U)
    (hnone : NoEscape L V) :
    IsElementaryAbelian 2 ↥((T : Subgroup G) ⊓ centralizer (V : Set G)) := by
  let := D.elementary
  let R := (T : Subgroup G) ⊓ centralizer (U : Set G)
  let E := (T : Subgroup G) ⊓ centralizer (cyclicPairJoin P U V : Set G)
  let : IsElementaryAbelian 2 R := radical_elementary h D structural A C hnone
  let : IsElementaryAbelian 2 E := IsElementaryAbelian.of_le
    (show E ≤ R from le_inf inf_le_left (inf_le_right.trans
      (centralizer_le (show U ≤ cyclicPairJoin P U V from le_sup_right.trans le_sup_left))))
  rw [kernel_pair_split h D structural A C hnone]
  exact IsElementaryAbelian.sup_of_le_centralizer
    (show E ≤ centralizer (V : Set G) from inf_le_right.trans
      (centralizer_le (show V ≤ cyclicPairJoin P U V from le_sup_right)))

/-- The source hyperplane centralizer with the original pair factor, in
all dimensions. No cohomology or component-centralizer split is assumed. -/
theorem hyperplane_pair_split
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (D : ChosenModule T L V) (structural : Structural1222.{u} KnownSimple.IsKnownSimple)
    (A : NaturalLocalAnalysis T L V d) (C : CyclicLocalAnalysis T L V d H P U)
    (hnone : NoEscape L V) :
    (T : Subgroup G) ⊓ centralizer ((U ⊓ V : Subgroup G) : Set G) =
      U ⊔ V ⊔ ((T : Subgroup G) ⊓ centralizer (cyclicPairJoin P U V : Set G)) := by
  rw [hyperplane_centralizer_eq_core_sup_kernel h D structural A C,
    kernel_pair_split h D structural A C hnone,sup_assoc]

end RigidityKernel
