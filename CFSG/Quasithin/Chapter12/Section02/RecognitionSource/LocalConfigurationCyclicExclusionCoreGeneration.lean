module
public import CFSG.Quasithin.Chapter12.Section02.RecognitionSource.LocalConfigurationCyclicExclusionCoreInvolutions
public import Theory.GroupTheory.Commutator.SimpleImageDisplacement
public import Theory.GroupTheory.PGroup.OmegaAmbient

/-!
# The terminal extraspecial contradiction in 12.2.23

Write R=O₂(L). The elementary subgroup W has nontrivial image in the
simple natural actor L/R. Its commutator with R is generated by involutions,
so displacement transfer and [R,L]=R give Ω₁(R)=R. For any involution t of R,
⟨t,v⟩ is elementary and centralizes Φ(P) modulo O₂(H). The faithful
star-quotient action bounds its image by two, forcing t∈O₂(H)V.

Consequently R≤O₂(H)V. As W centralizes O₂(H) and [W,V]≤V, another
application of displacement transfer gives [R,L]≤V. This contradicts
|W∩R|=16 and |V|=8. The argument uses the original quotient maps and
relative normality, and proves the terminal implication without requiring
a reconstruction of the full L₃(2) core module or a fixed orbit generator.
LocalConfigurationCyclicSource applies it to the original cyclic-block
consumer and discharges the last extraspecial premise.
Source: Aschbacher–Smith, 12.2.23, printed pp.803–804.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative Pointwise commutatorElement
namespace CFSG.Quasithin.Chapter12.Section02.RecognitionSource
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {L V H P U W : Subgroup G} {d p : ℕ} {g v : G}
namespace InvariantOddLocalAnalysis
variable (S : InvariantOddLocalAnalysis T L V d p H P U W g v)
include S

omit S in
private theorem core_transfer
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (D : ChosenModule T L V) (A : NaturalLocalAnalysis T L V d)
    (E Z : Subgroup G) (hEL : E ≤ L) (hZL : Z ≤ L)
    (hLZ : L ≤ normalizer (Z : Set G)) (hE : ¬ E ≤ L.pCoreIn 2)
    (hdisp : ⁅L.pCoreIn 2,E⁆ ≤ Z) : ⁅L.pCoreIn 2,L⁆ ≤ Z := by
  let a := V.normalizerMonoidHom.comp (inclusion D.normalizes)
  let : IsSimpleGroup (MulAut V) := A.simple_aut h.quasisimple
  let : (Z.subgroupOf L).Normal := normal_subgroupOf_of_le_normalizer hLZ
  have hmap : (E.subgroupOf L).map a ≠ ⊥ := by
    intro hz
    apply hE
    intro x hx
    have hh : (⟨x,hEL hx⟩ : L) ∈ a.ker := (Subgroup.map_eq_bot_iff _).mp hz hx
    rw [A.componentAut_ker D] at hh
    exact mem_map_of_mem L.subtype hh
  have hk : IsPGroup 2 a.ker := by rw [A.componentAut_ker D]; exact pCore_isPGroup
  have hp : IsPPerfect 2 (⊤ : Subgroup L) :=
    h.maximal_faithful.2.1.2.1.of_surjective
      (Subgroup.topEquiv : (⊤ : Subgroup L) ≃* L).symm.toMonoidHom
      (Subgroup.topEquiv : (⊤ : Subgroup L) ≃* L).symm.surjective
  have hb := commutator_le_of_pPerfect_simple_image a (A.componentAut_surjective D) hk
    (pCore 2 L) (Z.subgroupOf L) ⊤ (E.subgroupOf L) hp hmap (by
      apply (map_le_map_iff_of_injective L.subtype_injective).mp
      simpa only [pCoreIn, map_commutator, map_subgroupOf_eq_of_le hEL,
        map_subgroupOf_eq_of_le hZL] using hdisp)
  have hh := map_mono (f := L.subtype) hb
  simpa only [pCoreIn, map_commutator, ← MonoidHom.range_eq_map, L.range_subtype,
    map_subgroupOf_eq_of_le hZL] using hh

/-- The component core is generated by its involutions, before module recognition. -/
theorem extraspecial_core_omega
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (D : ChosenModule T L V) (A : NaturalLocalAnalysis T L V d)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    (he : IsExtraspecial p P)
    (hf : W ⊓ centralizer (((frattini P).map P.subtype : Subgroup G) : Set G) = ⊥)
    (hd : d = 3) (hW : Nat.card W = 64) :
    omegaOneAmbient (L.pCoreIn 2) = L.pCoreIn 2 := by
  let := S.elementary
  let R := L.pCoreIn 2
  let Z := omegaOneAmbient R
  have hRL : R ≤ L := pCoreIn_le 2 L
  have hLR : L ≤ normalizer (R : Set G) :=
    L.le_normalizer.trans (normalizer_le_normalizer_characteristic_image L (pCore 2 L))
  have hRT : R ≤ (T : Subgroup G) := by
    exact (pCoreIn_mono_of_normalizes le_sup_left
      (sup_le L.le_normalizer D.sylow_normalizes_component)).trans
      (by
        simpa only [Sylow.coe_subtype, map_subgroupOf_eq_of_le
          (show (T : Subgroup G) ≤ L ⊔ (T : Subgroup G) from le_sup_right)] using
          pCoreIn_le_sylow (L ⊔ (T : Subgroup G)) (T.subtype le_sup_right))
  have hLZ : L ≤ normalizer (Z : Set G) := by
    let : (omega₁ R (p := 2)).Characteristic := omega₁_characteristic R
    exact hLR.trans (normalizer_le_normalizer_characteristic_image R (omega₁ R (p := 2)))
  have hnot : ¬ W ≤ R := by
    intro hh
    have hc := S.extraspecial_module_intersection_component_core_card D A hTV he hf hd hW
    rw [inf_eq_left.mpr hh, hW] at hc
    omega
  have hb : ⁅R,W⁆ ≤ W ⊓ R := le_inf
    (le_normalizer_iff_commutator_le_right.mp (hRT.trans (S.hstar.1.1.2.trans S.normalizes)))
    (le_normalizer_iff_commutator_le_left.mp
      ((S.extraspecial_module_le_component D A hTV he hf hd).trans hLR))
  have hEZ : W ⊓ R ≤ Z := by
    intro x hx
    exact (omegaOneAmbient_le_iff R Z).mp le_rfl x hx.2
      (elemPow_eq_one_of_isElementaryAbelian x hx.1)
  have hbound := core_transfer h D A W Z
    (S.extraspecial_module_le_component D A hTV he hf hd)
    ((omegaOneAmbient_le R).trans hRL) hLZ hnot (hb.trans hEZ)
  rw [S.extraspecial_component_core_generated h D A hTV he hf hd hW] at hbound
  exact le_antisymm (omegaOneAmbient_le R) hbound

/-- Each involution of the component core lies in the original H-core times V. -/
theorem extraspecial_core_involution_le_hstar_core_sup
    (D : ChosenModule T L V) (A : NaturalLocalAnalysis T L V d)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    (he : IsExtraspecial p P) (hc : Nat.card P = p ^ 3) (hp : p = 3)
    (hf : W ⊓ centralizer (((frattini P).map P.subtype : Subgroup G) : Set G) = ⊥)
    (hd : d = 3) (t : G) (htR : t ∈ L.pCoreIn 2) (ht2 : t ^ 2 = 1) :
    t ∈ H.pCoreIn 2 ⊔ V := by
  have hRQ : L.pCoreIn 2 ≤ (L ⊔ (T : Subgroup G)).pCoreIn 2 :=
    pCoreIn_mono_of_normalizes le_sup_left
      (sup_le L.le_normalizer D.sylow_normalizes_component)
  have hQT : (L ⊔ (T : Subgroup G)).pCoreIn 2 ≤ (T : Subgroup G) := by
    simpa only [Sylow.coe_subtype, map_subgroupOf_eq_of_le
      (show (T : Subgroup G) ≤ L ⊔ (T : Subgroup G) from le_sup_right)] using
      pCoreIn_le_sylow (L ⊔ (T : Subgroup G)) (T.subtype le_sup_right)
  have ht := hQT (hRQ htR)
  have htv : Commute t v := (D.core_centralizes (hRQ htR) v S.inverter_mem).symm
  let E := zpowers t ⊔ zpowers v
  let := D.elementary
  let : IsElementaryAbelian 2 (zpowers t) := IsElementaryAbelian.zpowers_of_pow_eq_one ht2
  let : IsElementaryAbelian 2 (zpowers v) :=
    IsElementaryAbelian.zpowers_of_pow_eq_one (elemPow_eq_one_of_isElementaryAbelian v S.inverter_mem)
  have hcv : zpowers v ≤ centralizer (zpowers t : Set G) := by
    apply zpowers_le.mpr
    intro x hx
    obtain ⟨n, rfl⟩ := mem_zpowers_iff.mp hx
    exact (htv.zpow_left n).eq
  let : IsElementaryAbelian 2 E := IsElementaryAbelian.sup_of_le_centralizer hcv
  have hET : E ≤ (T : Subgroup G) :=
    sup_le (zpowers_le.mpr ht) (zpowers_le.mpr (D.le_sylow S.inverter_mem))
  have hER : E ≤ L.pCoreIn 2 := sup_le (zpowers_le.mpr htR)
    (zpowers_le.mpr (D.le_componentCore S.inverter_mem))
  have hdisp : ⁅E,(frattini P).map P.subtype⁆ ≤
      ⁅L.pCoreIn 2,(frattini P).map P.subtype⁆ := commutator_mono hER le_rfl
  let q := QuotientGroup.mk' (pCore 2 H)
  let F := (E.subgroupOf H).map q
  have hFle : Nat.card F ≤ 2 := S.extraspecial_elementary_quotient_card_le_two he hc hp E hET
    (hdisp.trans (by
      rw [S.extraspecial_component_core_displacement D A hTV he hf hd]
      exact inf_le_left.trans S.in_core))
  let tH : H := ⟨t, S.hstar.1.1.2 ht⟩
  let vH : H := ⟨v, S.hstar.1.1.2 (D.le_sylow S.inverter_mem)⟩
  have hvF : q vH ∈ F := mem_map_of_mem q
    (show vH ∈ E.subgroupOf H from (le_sup_right : zpowers v ≤ E) (mem_zpowers v))
  have htF : q tH ∈ F := mem_map_of_mem q
    (show tH ∈ E.subgroupOf H from (le_sup_left : zpowers t ≤ E) (mem_zpowers t))
  have hvne : q vH ≠ 1 := fun hh => S.inverter_not_mem_hstar_core
    (mem_map_of_mem H.subtype ((QuotientGroup.eq_one_iff vH).mp hh))
  have hFcard : Nat.card F = 2 := by
    have : Nontrivial F := ⟨⟨⟨q vH, hvF⟩, 1, fun hh => hvne (congrArg Subtype.val hh)⟩⟩
    have hh : 1 < Nat.card F := Finite.one_lt_card
    omega
  obtain ⟨z, hz, hu⟩ := (Nat.card_eq_two_iff' (1 : F)).mp hFcard
  by_cases ht1 : q tH = 1
  · exact mem_sup_left (mem_map_of_mem H.subtype ((QuotientGroup.eq_one_iff tH).mp ht1))
  · have hsame : q tH = q vH := congrArg Subtype.val
      ((hu ⟨q tH, htF⟩ (fun hh => ht1 (congrArg Subtype.val hh))).trans
        (hu ⟨q vH, hvF⟩ (fun hh => hvne (congrArg Subtype.val hh))).symm)
    have hprod : t * v⁻¹ ∈ H.pCoreIn 2 := by
      refine ⟨tH * vH⁻¹, ?_, rfl⟩
      change tH * vH⁻¹ ∈ pCore 2 H
      apply (QuotientGroup.eq_one_iff _).mp
      change q (tH * vH⁻¹) = 1
      rw [map_mul, map_inv, hsame, mul_inv_cancel]
    have hh := (H.pCoreIn 2 ⊔ V).mul_mem (mem_sup_left hprod)
      (mem_sup_right S.inverter_mem)
    simpa only [inv_mul_cancel_right] using hh

/-- The extraspecial branch is impossible. Involution generation and the
faithful star-quotient action replace the terminal module reconstruction. -/
theorem extraspecial_false_of_core_involutions
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (D : ChosenModule T L V) (A : NaturalLocalAnalysis T L V d)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    (he : IsExtraspecial p P) (hc : Nat.card P = p ^ 3)
    (hf : W ⊓ centralizer (((frattini P).map P.subtype : Subgroup G) : Set G) = ⊥)
    (hp : p = 3) (hd : d = 3) (hW : Nat.card W = 64) : False := by
  let R := L.pCoreIn 2
  have hRH : R ≤ H.pCoreIn 2 ⊔ V := by
    change L.pCoreIn 2 ≤ H.pCoreIn 2 ⊔ V
    rw [← S.extraspecial_core_omega h D A hTV he hf hd hW]
    exact (omegaOneAmbient_le_iff _ _).mpr fun t ht ht2 =>
      S.extraspecial_core_involution_le_hstar_core_sup D A hTV he hc hp hf hd t ht ht2
  have hHQ : H.pCoreIn 2 ≤ (T : Subgroup G) := by
    intro x hx
    obtain ⟨y, hy, rfl⟩ := pCoreIn_le_sylow H (T.subtype S.hstar.1.1.2) hx
    exact hy
  have hHV : H.pCoreIn 2 ⊔ V ≤ normalizer (V : Set G) :=
    (sup_le hHQ D.le_sylow).trans hTV
  have hCW : ⁅H.pCoreIn 2,W⁆ ≤ V := by
    rw [commutator_comm, commutator_eq_bot_iff_le_centralizer.mpr
      (S.extraspecial_binary_three_module_centralizes_core A he hc hf hp hW)]
    exact bot_le
  have hVW : ⁅V,W⁆ ≤ V := by rw [commutator_comm, S.transvections]; exact inf_le_right
  have hdisp : ⁅R,W⁆ ≤ V := (commutator_mono hRH le_rfl).trans
    (commutator_sup_le_of_relative_normal (H.pCoreIn 2 ⊔ V) (H.pCoreIn 2) V W V
      hHV le_sup_left le_sup_right hCW hVW)
  have hnot : ¬ W ≤ R := by
    intro hh
    have hk := S.extraspecial_module_intersection_component_core_card D A hTV he hf hd hW
    rw [inf_eq_left.mpr hh, hW] at hk
    omega
  have hbound := core_transfer h D A W V
    (S.extraspecial_module_le_component D A hTV he hf hd) D.le_component
    D.normalizes hnot hdisp
  rw [S.extraspecial_component_core_generated h D A hTV he hf hd hW] at hbound
  have hcard := card_le_of_le ((inf_le_right : W ⊓ R ≤ R).trans hbound)
  rw [S.extraspecial_module_intersection_component_core_card D A hTV he hf hd hW] at hcard
  have hv : Nat.card V = 8 := by
    obtain ⟨_,e,_⟩ := A.natural
    rw [Nat.card_congr e.toEquiv, hd]
    norm_num
  omega

end InvariantOddLocalAnalysis
end CFSG.Quasithin.Chapter12.Section02.RecognitionSource
