/-- The original cocode is generated by its commutators with L_z. Relative
normality then puts the whole original V in L_z and its intrinsic two-core. -/
theorem sourceOrbit_m24_le_centralizer_residual
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1) :
    ⁅D.sourceOrbit,localResidual L z⁆ = D.sourceOrbit ∧
      D.sourceOrbit ≤ localResidual L z ∧ D.sourceOrbit ≤ localTwoCore L z := by
  obtain ⟨S,hS⟩ := D.sourceOrbit_m24_central_sextet h hmany hV hq hnon a E hE z hz hne
  let q := a.toMonoidHom.comp D.mathieuComponentAutomizer
  have hsur : Function.Surjective q := a.surjective.comp
    (D.sourceOrbit_largeMathieu_component_surjective h.toHypothesis1221
      (D.sourceOrbit_chapterK_of_many h hmany hnon hV) (.inr hq))
  have hm : subspaceCommutator cocodeRepresentation ⊤
      ((solvableResidual (cocodeVectorStabilizer cocodeRepresentation
        (E (Additive.ofMul z)))).map
        (cocodeVectorStabilizer cocodeRepresentation (E (Additive.ofMul z))).subtype) = ⊤ := by
    rw [hS,sextetVector_stabilizer]
    exact MathieuSextet.native_residual_cocode_moved S
  obtain ⟨_,_,_,_,hmove⟩ := MathieuPairs.pair_residual_lift D.sourceOrbit L
    D.sourceOrbit_component_normalizes cocodeRepresentation q hsur E
    (fun l v => hE (D.mathieuComponentAutomizer l) v) cocode_faithful z hm
  have hWL : D.sourceOrbit ≤ L := hV ▸ D.le_component
  have hWC : D.sourceOrbit ≤ centralizer ({(z : G)} : Set G) := by
    intro w hw
    exact mem_centralizer_singleton_iff.mpr
      (congrArg Subtype.val (mul_comm' (⟨w,hw⟩ : D.sourceOrbit) z))
  have hWN : D.sourceOrbit ≤ normalizer (localResidual L z : Set G) :=
    (le_inf (hWL.trans L.le_normalizer) hWC).trans (MathieuSextet.residual_normalized L z)
  have hWR : D.sourceOrbit ≤ localResidual L z := by
    exact hmove.symm.le.trans (le_normalizer_iff_commutator_le_right.mp hWN)
  refine ⟨hmove,hWR,?_⟩
  exact le_pCoreIn_of_normalizes (IsElementaryAbelian.isPGroup 2 D.sourceOrbit)
    hWR (((localResidual_le L z).trans inf_le_left).trans D.sourceOrbit_component_normalizes)

/-- The literal L_z action and whole two-core image mark V_z as the
seven-dimensional native pair space. No containment or displacement premise
is added to the original cocode branch. -/
theorem sourceOrbit_m24_centralizer_commutator_marking
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1) :
    ∃ S : Sextet, E (Additive.ofMul z) = sextetVector S ∧
      (∀ w : D.sourceOrbit, (w : G) ∈ commutatorSpace L D.sourceOrbit z ↔
        E (Additive.ofMul w) ∈ ⨆ B ∈ S.parts, supportedPairSpace B) ∧
      (∀ w : D.sourceOrbit, (w : G) ∈ ⁅commutatorSpace L D.sourceOrbit z,localTwoCore L z⁆ ↔
        E (Additive.ofMul w) ∈ sextetTetradLine S) := by
  obtain ⟨S,r,hS,hr,hker,hcore,hrval⟩ :=
    D.sourceOrbit_m24_centralizer_core_action h hmany hV hq hnon a E hE z hz hne
  let W := D.sourceOrbit
  let R := localResidual L z
  let Q := localTwoCore L z
  let q := a.toMonoidHom.comp D.mathieuComponentAutomizer
  have hRL : R ≤ L := (localResidual_le L z).trans inf_le_left
  let j : R →* L := inclusion hRL
  have he : (sextetStabilizer S).subtype.comp r = q.comp j :=
    MonoidHom.ext hrval
  have hQ : Q.subgroupOf L = (pCore 2 R).map j := by
    ext l
    change (l : G) ∈ (pCore 2 R).map R.subtype ↔ l ∈ (pCore 2 R).map j
    constructor
    · rintro ⟨x,hx,he⟩
      exact ⟨x,hx,Subtype.ext he⟩
    · rintro ⟨x,hx,he⟩
      exact ⟨x,hx,congrArg Subtype.val he⟩
  have hmap : (Q.subgroupOf L).map q =
      (nativeTranslation S).range.map (sextetStabilizer S).subtype := by
    rw [hQ,map_map,←he,←map_map,hcore,nativeQuotient_kernel]
  have hWL : W ≤ L := (show D.sourceOrbit ≤ L from hV ▸ D.le_component)
  have htop : ((AddSubgroup.toZModSubmodule 2 (W.subgroupOf W).toAddSubgroup).map
      E.toLinearMap) = ⊤ := by
    apply top_unique
    intro v _
    obtain ⟨w,rfl⟩ := E.surjective v
    exact ⟨w,w.toMul.property,rfl⟩
  have hfirst (w : W) : (w : G) ∈ commutatorSpace L W z ↔
      E (Additive.ofMul w) ∈ ⨆ B ∈ S.parts, supportedPairSpace B := by
    have hm := MathieuSextet.marked_commutator_mem W L hWL
      D.sourceOrbit_component_normalizes q E (fun l w => hE (D.mathieuComponentAutomizer l) _)
      Q W ((localTwoCore_le L z).trans hRL) le_rfl w
    rw [htop,hmap,MathieuSextet.native_translation_moved] at hm
    exact hm
  have hpair : ((AddSubgroup.toZModSubmodule 2
      ((commutatorSpace L W z).subgroupOf W).toAddSubgroup).map E.toLinearMap) =
      ⨆ B ∈ S.parts, supportedPairSpace B := by
    ext v
    constructor
    · rintro ⟨w,hw,rfl⟩
      exact (hfirst w.toMul).mp hw
    · intro hv
      obtain ⟨w,rfl⟩ := E.surjective v
      exact ⟨w,(hfirst w.toMul).mpr hv,rfl⟩
  refine ⟨S,hS,hfirst,?_⟩
  intro w
  have hm := MathieuSextet.marked_commutator_mem W L hWL
    D.sourceOrbit_component_normalizes q E (fun l w => hE (D.mathieuComponentAutomizer l) _)
    Q (commutatorSpace L W z) ((localTwoCore_le L z).trans hRL)
    (commutatorSpace_le L W z D.sourceOrbit_component_normalizes) w
  rw [hpair,hmap,MathieuSextet.native_translation_pair_moved] at hm
  exact hm


omit [Finite G] in
private theorem marked_card (W H : Subgroup G) [IsElementaryAbelian 2 W]
    (F : Additive W ≃ₗ[ZMod 2] Cocode) (P : Submodule (ZMod 2) Cocode)
    (hHW : H ≤ W) (hmem : ∀ w : W, w.val ∈ H ↔ F (Additive.ofMul w) ∈ P) :
    Nat.card H = Nat.card P := by
  let e : H ≃ P := {
    toFun := fun x => ⟨F (Additive.ofMul (⟨x,hHW x.property⟩ : W)),
      (hmem _).mp x.property⟩
    invFun := fun v => ⟨(F.symm v).toMul,
      (hmem _).mpr (by
        change F (F.symm v) ∈ P
        rw [F.apply_symm_apply]; exact v.property)⟩
    left_inv := fun x => by
      apply Subtype.ext
      change ((F.symm (F _)).toMul : G) = _
      rw [F.symm_apply_apply]
      rfl
    right_inv := fun v => by
      apply Subtype.ext
      exact F.apply_symm_apply v }
  exact Nat.card_congr e

/-- The literal source series has orders 2, 128 and 2048, and its second
commutator is the original central involution line. In particular both
inclusions in Z<V_z<V are strict. -/
theorem sourceOrbit_m24_centralizer_commutator_series
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1) :
    Nat.card (commutatorSpace L D.sourceOrbit z) = 128 ∧
      Nat.card D.sourceOrbit = 2048 ∧
      ⁅commutatorSpace L D.sourceOrbit z,localTwoCore L z⁆ = zpowers (z : G) ∧
      zpowers (z : G) < commutatorSpace L D.sourceOrbit z ∧
      commutatorSpace L D.sourceOrbit z < D.sourceOrbit := by
  obtain ⟨S,hS,hfirst,hsecond⟩ :=
    D.sourceOrbit_m24_centralizer_commutator_marking h hmany hV hq hnon a E hE z hz hne
  let W := D.sourceOrbit
  let U := commutatorSpace L W z
  let Q := localTwoCore L z
  have hUW : U ≤ W := commutatorSpace_le L W z D.sourceOrbit_component_normalizes
  have hcard : Nat.card U = 128 := by
    rw [marked_card W U E (⨆ B ∈ S.parts, supportedPairSpace B) hUW hfirst,
      Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod,sextetPairSpan_finrank]
    decide
  have hWcard : Nat.card W = 2048 := by
    have he : Nat.card W = Nat.card Cocode :=
      (Nat.card_congr (Additive.ofMul : W ≃ Additive W)).trans
        (Nat.card_congr E.toEquiv)
    rw [he,Module.natCard_eq_pow_finrank (K := ZMod 2),Nat.card_zmod,finrank_cocode]
    decide
  have hCW : ⁅U,Q⁆ ≤ W := (commutator_mono hUW le_rfl).trans hUW
  have hC : ⁅U,Q⁆ = zpowers (z : G) := by
    apply le_antisymm
    · intro x hx
      let w : W := ⟨x,hCW hx⟩
      obtain ⟨c,hc⟩ := Submodule.mem_span_singleton.mp ((hsecond w).mp hx)
      change c • sextetVector S = E (Additive.ofMul w) at hc
      rw [←hS] at hc
      fin_cases c
      · change (0 : ZMod 2) • E (Additive.ofMul z) = E (Additive.ofMul w) at hc
        rw [zero_smul] at hc
        have he : w = 1 := congrArg Additive.toMul
          (E.injective (hc.symm.trans E.map_zero.symm))
        change (w : G) ∈ zpowers (z : G)
        rw [he]
        exact (zpowers (z : G)).one_mem
      · have he : w = z := congrArg Additive.toMul (E.injective (by simpa using hc.symm))
        exact (congrArg Subtype.val he).symm ▸ mem_zpowers (z : G)
    · apply zpowers_le.mpr
      apply (hsecond z).mpr
      rw [hS]
      exact Submodule.subset_span (Set.mem_singleton _)
  have hZU : zpowers (z : G) ≤ U := by
    rw [←hC]
    exact commutator_mono hUW le_rfl
  have hZcard : Nat.card (zpowers (z : G)) = 2 := by
    rw [Nat.card_zpowers]
    exact orderOf_eq_prime
      (elemPow_eq_one_of_isElementaryAbelian (p := 2) (z : G) z.property)
      (fun he => hne (Subtype.ext he))
  refine ⟨hcard,hWcard,hC,lt_of_le_of_ne hZU ?_,lt_of_le_of_ne hUW ?_⟩
  · intro he
    have hc := congrArg (fun K : Subgroup G => Nat.card K) he
    rw [hZcard,hcard] at hc
    contradiction
  · intro he
    have hc := congrArg (fun K : Subgroup G => Nat.card K) he
    rw [hcard,hWcard] at hc
    contradiction


/-- The original two-core modulo the entire original V is the full
64-element hexacode translation group, through a surjection with literal
kernel V∩O₂(L_z). The preceding containment theorem proves V≤O₂(L_z). -/
theorem sourceOrbit_m24_centralizer_twoCore_quotient
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1) :
    D.sourceOrbit ≤ localTwoCore L z ∧
      ∃ f : localTwoCore L z →* Multiplicative Atlas.Codes.hexacode,
        Function.Surjective f ∧ f.ker = D.sourceOrbit.subgroupOf (localTwoCore L z) := by
  have hWQ := (D.sourceOrbit_m24_le_centralizer_residual h hmany hV hq hnon a E hE z hz hne).2.2
  obtain ⟨S,r,_,_,hker,hcore,_⟩ :=
    D.sourceOrbit_m24_centralizer_core_action h hmany hV hq hnon a E hE z hz hne
  let R := localResidual L z
  let Q := localTwoCore L z
  let e : pCore 2 R ≃* Q := (pCore 2 R).equivMapOfInjective R.subtype R.subtype_injective
  let b : pCore 2 R →* sextetStabilizer S := r.comp (pCore 2 R).subtype
  have hb : b.range = (nativeTranslation S).range := by
    rw [MonoidHom.range_comp,range_subtype,hcore,nativeQuotient_kernel]
  let c : b.range ≃* Multiplicative Atlas.Codes.hexacode :=
    (MulEquiv.subgroupCongr hb).trans (MonoidHom.ofInjective (nativeTranslation_injective S)).symm
  let f : Q →* Multiplicative Atlas.Codes.hexacode :=
    c.toMonoidHom.comp (b.rangeRestrict.comp e.symm.toMonoidHom)
  refine ⟨hWQ,f,c.surjective.comp (b.rangeRestrict_surjective.comp e.symm.surjective),?_⟩
  have hk : f.ker = b.ker.comap e.symm.toMonoidHom := by
    rw [MonoidHom.ker_comp_of_injective _ _ c.injective]
    change b.rangeRestrict.ker.comap e.symm.toMonoidHom = _
    rw [MonoidHom.ker_rangeRestrict]
  have hbk : b.ker = r.ker.subgroupOf (pCore 2 R) := rfl
  rw [hk,hbk,hker]
  ext x
  change ((e.symm x).val : G) ∈ D.sourceOrbit ↔ (x : G) ∈ D.sourceOrbit
  have he : ((e.symm x).val : G) = (x : G) :=
    congrArg (fun y : Q => (y : G)) (e.apply_symm_apply x)
  rw [he]

/-- The source commutator series retains the original Sylow normalization:
L_z T normalizes both its two-core and V_z. -/
theorem sourceOrbit_m24_centralizer_series_normalized
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1) :
    localResidual L z ⊔ (T : Subgroup G) ≤ normalizer (localTwoCore L z : Set G) ∧
      localResidual L z ⊔ (T : Subgroup G) ≤
        normalizer (commutatorSpace L D.sourceOrbit z : Set G) := by
  obtain ⟨_,_,_,_,_,_,_,_,hT⟩ :=
    D.sourceOrbit_m24_centralizer_residual h hmany hV hq hnon a E hE z hz hne
  have hQ := (sup_le (localResidual L z).le_normalizer hT).trans
    (normalizer_le_normalizer_characteristic_image (localResidual L z) (pCore 2 _))
  have hW := sup_le (((localResidual_le L z).trans inf_le_left).trans
    D.sourceOrbit_component_normalizes) D.sourceOrbit_weakClosure_setup.normalizes
  refine ⟨hQ,?_⟩
  intro g hg
  rw [mem_normalizer_iff_map_conj_eq]
  change (⁅D.sourceOrbit,localTwoCore L z⁆).map (MulAut.conj g).toMonoidHom = _
  have hwg : D.sourceOrbit.map (MulAut.conj g).toMonoidHom = D.sourceOrbit :=
    mem_normalizer_iff_map_conj_eq.mp (hW hg)
  have hqg : (localTwoCore L z).map (MulAut.conj g).toMonoidHom = localTwoCore L z :=
    mem_normalizer_iff_map_conj_eq.mp (hQ hg)
  rw [map_commutator,hwg,hqg]
  rfl


/-- The original two-core action on V_z has exactly V as kernel. Together
with the marked 64-element quotient and the central-line displacements,
this retains the faithful source transvection action. -/
theorem sourceOrbit_m24_centralizer_transvection_kernel
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1) :
    localTwoCore L z ⊓ centralizer (commutatorSpace L D.sourceOrbit z : Set G) =
      D.sourceOrbit := by
  have hWQ := (D.sourceOrbit_m24_le_centralizer_residual h hmany hV hq hnon a E hE z hz hne).2.2
  obtain ⟨S,r,hS,_,hker,hcore,hrval⟩ :=
    D.sourceOrbit_m24_centralizer_core_action h hmany hV hq hnon a E hE z hz hne
  obtain ⟨S',hS',hfirst,_⟩ :=
    D.sourceOrbit_m24_centralizer_commutator_marking h hmany hV hq hnon a E hE z hz hne
  have hSS : S' = S := sextetVector_injective (hS'.symm.trans hS)
  subst S'
  let R := localResidual L z
  let Q := localTwoCore L z
  let U := commutatorSpace L D.sourceOrbit z
  have hRL : R ≤ L := (localResidual_le L z).trans inf_le_left
  have hUW : U ≤ D.sourceOrbit := commutatorSpace_le L D.sourceOrbit z D.sourceOrbit_component_normalizes
  apply le_antisymm
  · intro x hx
    let xr : R := ⟨x,localTwoCore_le L z hx.1⟩
    have hxc : xr ∈ pCore 2 R := by
      obtain ⟨y,hy,hyx⟩ := hx.1
      exact (show y = xr from Subtype.ext hyx) ▸ hy
    have him : r xr ∈ (nativeTranslation S).range := by
      rw [←nativeQuotient_kernel,←hcore]
      exact mem_map_of_mem r hxc
    obtain ⟨t,ht⟩ := him
    have ht1 : t = 1 := by
      apply MathieuSextet.native_translation_pair_faithful S t
      intro v hv
      obtain ⟨w,rfl⟩ := E.surjective v
      have hw : (w.toMul : G) ∈ U := (hfirst w.toMul).mpr hv
      have hm : automizerRepresentation D.sourceOrbit
          (D.mathieuComponentAutomizer ⟨x,hRL xr.property⟩) w = w := by
        apply Additive.toMul.injective
        apply Subtype.ext
        change x * (w.toMul : G) * x⁻¹ = (w.toMul : G)
        rw [mul_inv_eq_iff_eq_mul]
        exact (mem_centralizer_iff.mp hx.2 _ hw).symm
      rw [ht,hrval]
      exact (hE (D.mathieuComponentAutomizer ⟨x,hRL xr.property⟩) w).symm.trans
        (congrArg E hm)
    have hr1 : r xr = 1 := by rw [←ht,ht1,map_one]
    have hw : xr ∈ D.sourceOrbit.subgroupOf R := hker ▸ hr1
    exact hw
  · intro x hx
    refine ⟨hWQ hx,?_⟩
    intro u hu
    exact congrArg Subtype.val (mul_comm' (⟨u,hUW hu⟩ : D.sourceOrbit) ⟨x,hx⟩)


/-- The common fixed group of the full original two-core on V_z is
exactly the original central involution line, as required in 8.2.12. -/
theorem sourceOrbit_m24_centralizer_transvection_fixed
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1) :
    commutatorSpace L D.sourceOrbit z ⊓ centralizer (localTwoCore L z : Set G) = zpowers (z : G) := by
  obtain ⟨S,r,hS,_,_,hcore,hrval⟩ :=
    D.sourceOrbit_m24_centralizer_core_action h hmany hV hq hnon a E hE z hz hne
  obtain ⟨S',hS',hfirst,hsecond⟩ :=
    D.sourceOrbit_m24_centralizer_commutator_marking h hmany hV hq hnon a E hE z hz hne
  have hSS : S'=S := sextetVector_injective (hS'.symm.trans hS)
  subst S'
  obtain ⟨_,_,hcomm,hZU,_⟩ :=
    D.sourceOrbit_m24_centralizer_commutator_series h hmany hV hq hnon a E hE z hz hne
  let R := localResidual L z
  let Q := localTwoCore L z
  let U := commutatorSpace L D.sourceOrbit z
  have hRL : R ≤ L := (localResidual_le L z).trans inf_le_left
  have hUW : U ≤ D.sourceOrbit := commutatorSpace_le L D.sourceOrbit z D.sourceOrbit_component_normalizes
  apply le_antisymm
  · intro w hw
    let wv : D.sourceOrbit := ⟨w,hUW hw.1⟩
    have hf : E (Additive.ofMul wv) ∈ sextetTetradLine S := by
      apply (MathieuSextet.native_translation_pair_fixed S _ ((hfirst wv).mp hw.1)).mp
      intro t
      have him : nativeTranslation S t ∈ (pCore 2 R).map r := by
        rw [hcore,nativeQuotient_kernel]
        exact ⟨t,rfl⟩
      obtain ⟨x,hx,hxt⟩ := him
      have hxQ : (x : G) ∈ Q := mem_map_of_mem R.subtype hx
      have hm : automizerRepresentation D.sourceOrbit
          (D.mathieuComponentAutomizer ⟨x,hRL x.property⟩) (Additive.ofMul wv) =
            Additive.ofMul wv := by
        apply Additive.toMul.injective
        apply Subtype.ext
        change (x : G) * w * (x : G)⁻¹ = w
        rw [mul_inv_eq_iff_eq_mul]
        exact hw.2 x hxQ
      rw [←hxt,hrval]
      exact (hE (D.mathieuComponentAutomizer ⟨x,hRL x.property⟩) (Additive.ofMul wv)).symm.trans
        (congrArg E hm)
    exact hcomm.le ((hsecond wv).mpr hf)
  · intro w hw
    refine ⟨hZU.le hw,?_⟩
    apply (zpowers_le.mpr (show (z : G) ∈ centralizer (Q : Set G) from ?_)) hw
    intro x hx
    exact mem_centralizer_singleton_iff.mp ((localResidual_le L z) (localTwoCore_le L z hx)).2

end CFSG.Quasithin.Chapter12.Section02.ChosenModule
