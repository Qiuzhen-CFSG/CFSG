module
public import CFSG.Quasithin.Chapter12.Section02.ReductionSource.SeedAlternativesMovedExhaustionQuotient
public import CFSG.Quasithin.Chapter3.Section02.ChosenSource325.MovedExhaustionSections

/-!
# The original local action on W and U/W

Write M = N_G(L), U = componentOrbit V M and W = componentOrbit V T.
The local actor is the image of the literal subgroup LT in Aut_M(U).
Its section is W inside U, and its quotient is U/W. If U is larger than W,
an actor in the original Sylow image that is faithful on the component
is faithful on both sections. The two actual actor images have the same
rank as the original actor. A cubic budget then makes one of these images
an FF offender.

The final application chooses the starred actor under the original hmany
standing guard and gives a nontrivial component centralizer or one of these
two marked offenders. This is a source D.3.9(1) reduction for D.3.13; the
FF model exclusions, centralizing-actor exclusion and U = W remain with
qt-baumann-fsu. No central cover is replaced by a simple quotient.
Source: Aschbacher--Smith D.3.9--13, printed pp.199--202, and3.2.5, p.580.
-/

public noncomputable section
open scoped IsMulCommutative ENNReal
namespace CFSG.Quasithin.Chapter12.Section02.ChosenModule
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open Chapter3.Section02.ChosenSource325 ChapterD
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}

/-- The literal image of LT on the full normalizer orbit U. -/
@[expose] def normalizerLocalActor (_D : ChosenModule T L V) :
    Subgroup (internalActionImage (normalizer (L : Set G))
      (componentOrbit V (normalizer (L : Set G))) (le_normalizer_componentOrbit _ _)) :=
  ((L ⊔ (T : Subgroup G)).subgroupOf (normalizer (L : Set G))).map
    (internalHom (normalizer (L : Set G))
      (componentOrbit V (normalizer (L : Set G))) (le_normalizer_componentOrbit _ _))

/-- The local actor is generated by the component image and the original
Sylow image, with both maps inherited from the same action on U. -/
theorem normalizerLocalActor_eq_component_sup_sylow (D : ChosenModule T L V) :
    let M := normalizer (L : Set G)
    let U := componentOrbit V M
    let hn := le_normalizer_componentOrbit V M
    D.normalizerLocalActor = (L.subgroupOf M).map (internalHom M U hn) ⊔
      (internalSylow T M U hn D.sylow_normalizes_component : Subgroup _) := by
  dsimp only [normalizerLocalActor]
  rw [subgroupOf_sup L.le_normalizer D.sylow_normalizes_component]
  exact Subgroup.map_sup _ _ _

/-- LT stabilizes the original Sylow orbit inside the possibly larger U. -/
theorem normalizerLocalActor_stabilizes_section
    (D : ChosenModule T L V) (h : Hypothesis1221 KnownSimple.IsKnownSimple T L) :
    letI := D.normalizerOrbit_elementary h
    let M := normalizer (L : Set G)
    let U := componentOrbit V M
    let hn := le_normalizer_componentOrbit V M
    D.normalizerLocalActor ≤ subspaceStabilizer (UniqueFactor.imageRepresentation M U hn)
      (internalSection U (componentOrbit V (T : Subgroup G))) := by
  let := D.normalizerOrbit_elementary h
  rw [D.normalizerLocalActor_eq_component_sup_sylow]
  exact sup_le (D.normalizer_sylow_section_component_invariant h)
    (internalSylow_section_stable T _ _ _ (le_normalizer_componentOrbit _ _)
      D.sylow_normalizes_component (le_normalizer_componentOrbit V T))

/-- W as a subrepresentation of the literal LT image acting on U. -/
@[expose] def normalizerLocalSection
    (D : ChosenModule T L V) (h : Hypothesis1221 KnownSimple.IsKnownSimple T L) :
    letI := D.normalizerOrbit_elementary h
    let M := normalizer (L : Set G)
    let U := componentOrbit V M
    Subrepresentation ((UniqueFactor.imageRepresentation M U
      (le_normalizer_componentOrbit V M)).comp D.normalizerLocalActor.subtype) := by
  let := D.normalizerOrbit_elementary h
  exact invariantSubspace _ D.normalizerLocalActor _ (D.normalizerLocalActor_stabilizes_section h)

/-- Under strict orbit enlargement, component faithfulness gives two faithful
section actions of the same elementary actor and an offender on one of them. -/
theorem normalizer_sections_of_faithful_component_actor
    (D : ChosenModule T L V) (h : Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (hc : V ⊓ centralizer (L : Set G) = ⊥)
    (hne : componentOrbit V (normalizer (L : Set G)) ≠ componentOrbit V (T : Subgroup G)) :
    letI := D.normalizerOrbit_elementary h
    let M := normalizer (L : Set G)
    let U := componentOrbit V M
    let hn := le_normalizer_componentOrbit V M
    let ρ := UniqueFactor.imageRepresentation M U hn
    let K := (L.subgroupOf M).map (internalHom M U hn)
    let S := D.normalizerLocalSection h
    ∀ A : Subgroup (internalActionImage M U hn),
      A ≤ internalSylow T M U hn D.sylow_normalizes_component →
      IsElementaryTwo A → fixedCodim ρ A ≤ 2 * rank A →
      A ⊓ centralizer (K : Set (internalActionImage M U hn)) = ⊥ →
      let B := A.subgroupOf D.normalizerLocalActor
      (∀ a ∈ B, (∀ v, S.toRepresentation a v = v) → a = 1) ∧
      (∀ a ∈ B, (∀ v, S.quotientRepresentation a v = v) → a = 1) ∧
      rank (actionSubgroup S.toRepresentation B) = rank A ∧
      rank (actionSubgroup S.quotientRepresentation B) = rank A ∧
      (IsOffender (imageRepresentation S.toRepresentation) (actionSubgroup S.toRepresentation B) ∨
        IsOffender (imageRepresentation S.quotientRepresentation)
          (actionSubgroup S.quotientRepresentation B)) := by
  let := D.normalizerOrbit_elementary h
  let M := normalizer (L : Set G)
  let U := componentOrbit V M
  let W := componentOrbit V (T : Subgroup G)
  let hn := le_normalizer_componentOrbit V M
  let ρ := UniqueFactor.imageRepresentation M U hn
  let f := internalHom M U hn
  let K := (L.subgroupOf M).map f
  let : (L.subgroupOf M).Normal := normal_subgroupOf_of_le_normalizer le_rfl
  let : K.Normal := Normal.map inferInstance f
    (UniqueFactor.actionHom M U hn).rangeRestrict_surjective
  let := D.normalizer_component_quasisimple h hc
  have hWU : W ≤ U := iSup_conjugates_le_of_le_normalizer V T U
    (le_componentOrbit V M) (D.sylow_normalizes_component.trans hn)
  have hproper : internalSection U W ≠ ⊤ := by
    intro he
    apply hne
    apply le_antisymm _ hWU
    intro v hv
    have hh : Additive.ofMul (⟨v,hv⟩ : U) ∈ internalSection U W := by rw [he]; trivial
    exact hh
  have hnon : ¬ internalSection U W ≤ fixedSpace ρ K := by
    intro hf
    exact D.normalizer_seed_not_fixed h hc ((show internalSection U V ≤ internalSection U W
      from fun _ hv => le_componentOrbit V T hv).trans hf)
  dsimp only
  intro A hAS hA hb hk
  have hAP : A ≤ D.normalizerLocalActor := by
    rw [D.normalizerLocalActor_eq_component_sup_sylow]
    exact hAS.trans le_sup_right
  have hf := faithful_sections_of_component_centralizer_eq_bot ρ K
    (D.normalizer_component_fully_moved h hc) (internalSection U W)
    (D.normalizer_sylow_section_component_invariant h) hnon hproper
    D.normalizerLocalActor (D.normalizerLocalActor_stabilizes_section h) A hk
  have ho := offender_section_or_quotient_of_faithful_component_actor ρ K
    (D.normalizer_component_fully_moved h hc) (internalSection U W)
    (D.normalizer_sylow_section_component_invariant h) hnon hproper
    D.normalizerLocalActor (D.normalizerLocalActor_stabilizes_section h) A hAP hA hb hk
  let S := D.normalizerLocalSection h
  let B := A.subgroupOf D.normalizerLocalActor
  refine ⟨hf.1,hf.2,?_,?_,ho⟩
  · exact (actionSubgroup_rank S.toRepresentation B hf.1).trans (rank_subgroupOf hAP)
  · exact (actionSubgroup_rank S.quotientRepresentation B hf.2).trans (rank_subgroupOf hAP)

/-- The original standing guard supplies a starred actor whose component
centralizer is nontrivial or whose literal image offends on W or on U/W. -/
theorem exists_normalizer_centralizer_or_section_offender_of_many
    (D : ChosenModule T L V) (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hc : V ⊓ centralizer (L : Set G) = ⊥)
    (hne : componentOrbit V (normalizer (L : Set G)) ≠ componentOrbit V (T : Subgroup G)) :
    letI := D.normalizerOrbit_elementary h.toHypothesis1221
    let M := normalizer (L : Set G)
    let U := componentOrbit V M
    let hn := le_normalizer_componentOrbit V M
    let ρ := UniqueFactor.imageRepresentation M U hn
    let K := (L.subgroupOf M).map (internalHom M U hn)
    let S := D.normalizerLocalSection h.toHypothesis1221
    ∃ A : Subgroup (internalActionImage M U hn),
      A ≤ internalSylow T M U hn D.sylow_normalizes_component ∧ A ∈ QhatStar ρ ∧
      (A ⊓ centralizer (K : Set (internalActionImage M U hn)) ≠ ⊥ ∨
        (IsOffender (imageRepresentation S.toRepresentation)
          (actionSubgroup S.toRepresentation (A.subgroupOf D.normalizerLocalActor)) ∨
        IsOffender (imageRepresentation S.quotientRepresentation)
          (actionSubgroup S.quotientRepresentation (A.subgroupOf D.normalizerLocalActor)))) := by
  classical
  let := D.normalizerOrbit_elementary h.toHypothesis1221
  let M := normalizer (L : Set G)
  let U := componentOrbit V M
  let hn := le_normalizer_componentOrbit V M
  let ρ := UniqueFactor.imageRepresentation M U hn
  let K := (L.subgroupOf M).map (internalHom M U hn)
  obtain ⟨A,hAS,hA,_⟩ := D.exists_normalizer_starred_in_sylow_of_many h hmany
  refine ⟨A,hAS,hA,?_⟩
  by_cases hk : A ⊓ centralizer (K : Set (internalActionImage M U hn)) = ⊥
  · right
    exact (D.normalizer_sections_of_faithful_component_actor h.toHypothesis1221 hc hne
      A hAS hA.1.2.1
      ((actionRatio_le_nat_iff ρ hA.1.2.1 2).mp (hA.1.2.2.2.le.trans hA.1.1)) hk).2.2.2.2
  · exact Or.inl hk

/-- Excluding FF on both exact sections discharges the nontrivial-centralizer
premise. The two exclusions remain local model obligations of qt-baumann-fsu. -/
theorem normalizer_starred_centralizer_ne_bot_of_nonFF_sections
    (D : ChosenModule T L V) (h : Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (hc : V ⊓ centralizer (L : Set G) = ⊥)
    (hne : componentOrbit V (normalizer (L : Set G)) ≠ componentOrbit V (T : Subgroup G))
    (hW : letI := D.normalizerOrbit_elementary h
      ¬ IsFFModule (imageRepresentation (D.normalizerLocalSection h).toRepresentation))
    (hQ : letI := D.normalizerOrbit_elementary h
      ¬ IsFFModule (imageRepresentation (D.normalizerLocalSection h).quotientRepresentation)) :
    letI := D.normalizerOrbit_elementary h
    let M := normalizer (L : Set G)
    let U := componentOrbit V M
    let hn := le_normalizer_componentOrbit V M
    let ρ := UniqueFactor.imageRepresentation M U hn
    let K := (L.subgroupOf M).map (internalHom M U hn)
    ∀ A : Subgroup (internalActionImage M U hn),
      A ≤ internalSylow T M U hn D.sylow_normalizes_component → A ∈ QhatStar ρ →
      A ⊓ centralizer (K : Set (internalActionImage M U hn)) ≠ ⊥ := by
  let := D.normalizerOrbit_elementary h
  dsimp only
  intro A hAS hA hk
  have hb := (actionRatio_le_nat_iff _ hA.1.2.1 2).mp (hA.1.2.2.2.le.trans hA.1.1)
  rcases (D.normalizer_sections_of_faithful_component_actor h hc hne A hAS hA.1.2.1 hb hk).2.2.2.2
      with ho | ho
  · exact hW ⟨_,ho⟩
  · exact hQ ⟨_,ho⟩

end CFSG.Quasithin.Chapter12.Section02.ChosenModule
