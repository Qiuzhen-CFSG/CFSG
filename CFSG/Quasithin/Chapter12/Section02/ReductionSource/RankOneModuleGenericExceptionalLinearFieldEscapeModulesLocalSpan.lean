module
public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleGenericExceptionalLinearFieldEscapeModulesLocalSpan
public import CFSG.Quasithin.Chapter12.Section02.ReductionSource.RankOneModuleGenericExceptionalLinearFieldEscapeModulesLocalCore
public import CFSG.Quasithin.Chapter12.Section02.ReductionSource.RankOneModuleGenericExceptionalLinearFieldEscapeModules

/-!
# The elementary original H-span inside a contrary centralizer span

The surviving opposite-image centralizer factor fixes the original H-span
modulo the point. A nonidentity element of the opposite image fixes no
vector outside W/S₂ in the natural S₃ quotient. Hence the H-span lies
in W, inside the core S that centralizes the original plane. Since the
H-span is generated by that plane, it is abelian and therefore elementary.
This includes the case where both opposite factors are nontrivial.

Thus the literal faithful action of H/O₂(H) on its own span modulo ⟨z⟩
can now be constructed, and the previously proved strict ratio applies.
The abelianness of the larger C_G(z)-span remains open: neither the
local elementary conclusion nor its strict ratio supplies the global
intersecting-conjugate commutativity needed by F.9.16.

Source: Aschbacher--Smith G.2.3 and 5.1.23, printed pp.333--334,645--646,
refs/quasithin.pdf. Final assembly remains qt-d-1222-linear-field-cubic-escape;
existence of the earlier cubic local data retains its separate producer.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter12.Section02.ChosenModule
open Chapter6.Source.RankOneGeneric CubicEscape ChapterG.Section02.Setup
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V H A B C : Subgroup G} {n : ℕ} {z : G}

/-- A contrary centralizer span puts the original H-span in its opposite core. -/
theorem linear_cubic_nonabelian_local_span_le_W
    (D : ChosenModule T L V)
    (h : Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hK : residual H ∈ Chapter1.LStar G (T : Subgroup G))
    (hnf : ¬ ChapterA.Section04.IsFaithfulSignalizerType (residual H))
    (hlinear : ClassicalGroup.IsPSL ((pResidual 2 H) ⧸ pCore 2 (pResidual 2 H)) 3 4)
    (hpsl : ClassicalGroup.IsPSL (L ⧸ pCore 2 L) 2 (2 ^ n))
    (c : LinearFieldCartan T L H A B C n)
    (d : CubicEscape.LocalData T H C z) (hn : 1 < n)
    (hne : ¬ IsMulCommutative (conjugateSpanBy (CubicEscape.plane C z)
      (centralizer ({z} : Set G))))
    (g : G) (hg : g ∈ C) (hgn : g ∉ normalizer (zpowers z : Set G)) :
    (setup T H C z).U ≤ (setup T (centralizer ({z} : Set G)) C z).W g := by
  let S := setup T (centralizer ({z} : Set G)) C z
  let s := linear_cubic_centralizer_setup h d
  let b := d.binaryNaturalData c D.sylow_normalizes_component hpsl s hne
  let E := ((conjugate (S.W g) g).subgroupOf S.H).map (SpanAction.projection s)
  let Q := ((H.pCoreIn 2).subgroupOf S.H).map (SpanAction.projection s)
  obtain ⟨_,hf,hfix⟩ := linear_cubic_nonabelian_opposite_local_core
    D h hH hK hnf hlinear hpsl c d hn hne g hg hgn
  exact d.local_span_le_W_of_opposite_fixer s b g hg hgn (E ⊓ Q) inf_le_left hf hfix

/-- The original H-span is elementary without assuming the larger span abelian. -/
theorem linear_cubic_local_span_elementary
    (D : ChosenModule T L V)
    (h : Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hK : residual H ∈ Chapter1.LStar G (T : Subgroup G))
    (hnf : ¬ ChapterA.Section04.IsFaithfulSignalizerType (residual H))
    (hlinear : ClassicalGroup.IsPSL ((pResidual 2 H) ⧸ pCore 2 (pResidual 2 H)) 3 4)
    (hpsl : ClassicalGroup.IsPSL (L ⧸ pCore 2 L) 2 (2 ^ n))
    (c : LinearFieldCartan T L H A B C n)
    (d : CubicEscape.LocalData T H C z) (hn : 1 < n)
 :
    IsElementaryAbelian 2 (conjugateSpanBy (CubicEscape.plane C z) H) := by
  have hc : IsMulCommutative (conjugateSpanBy (CubicEscape.plane C z) H) := by
    by_cases hab : IsMulCommutative (conjugateSpanBy (CubicEscape.plane C z)
      (centralizer ({z} : Set G)))
    · let := hab
      exact d.span_abelian
    · let s := linear_cubic_centralizer_setup h d
      let b := d.binaryNaturalData c D.sylow_normalizes_component hpsl s hab
      obtain ⟨g,hg,hgn⟩ := d.exists_moving_cubic
      exact local_span_abelian_of_le_W s b g hg hgn
        (linear_cubic_nonabelian_local_span_le_W D h hH hK hnf hlinear hpsl c d hn hab g hg hgn)
  let := hc
  let : IsElementaryAbelian 2 (plane C z) := d.g2.elementary
  exact conjugateSpanBy_elementary_of_commutative _ _

/-- Construct the literal local action and apply the checked strict endpoint. -/
theorem linear_cubic_exists_local_action_strict
    (D : ChosenModule T L V)
    (h : Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) (normalizer (L : Set G)))
    (hK : residual H ∈ Chapter1.LStar G (T : Subgroup G))
    (hnf : ¬ ChapterA.Section04.IsFaithfulSignalizerType (residual H))
    (hlinear : ClassicalGroup.IsPSL ((pResidual 2 H) ⧸ pCore 2 (pResidual 2 H)) 3 4)
    (hpsl : ClassicalGroup.IsPSL (L ⧸ pCore 2 L) 2 (2 ^ n))
    (c : LinearFieldCartan T L H A B C n)
    (d : CubicEscape.LocalData T H C z) (hn : 1 < n)
 :
    ∃ hU : IsElementaryAbelian 2 (conjugateSpanBy (CubicEscape.plane C z) H),
      let : IsElementaryAbelian 2 (setup T H C z).U := hU
      ∃ a : Chapter15.Section03.AbelianAmalgam.LocalQuotientAction H
        (conjugateSpanBy (CubicEscape.plane C z) H) (zpowers z),
        2 < quadraticRatio a.representation := by
  let hU := linear_cubic_local_span_elementary D h hH hK hnf hlinear hpsl c d hn
  let : IsElementaryAbelian 2 (setup T H C z).U := hU
  exact ⟨hU,d.localSpanAction,
    linear_cubic_quadraticRatio_gt_two h hH hlinear z hU d.localSpanAction⟩

end CFSG.Quasithin.Chapter12.Section02.ChosenModule
