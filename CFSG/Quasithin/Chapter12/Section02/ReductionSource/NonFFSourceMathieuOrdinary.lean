module
public import CFSG.Quasithin.Chapter7.NormalizedSource.MathieuOrdinary
public import CFSG.Quasithin.Chapter12.Section02.ReductionSource.NonFFSourceMathieuPointControl
public import Theory.SpecificGroups.SporadicTrivialMultipliers.TwoPrimary.Janko



/-!
# The full covering component at an escaping M24 cocode point

The literal M22 residual and the original moved module force a central
quotient of two-rank at least ten. The proved Mathieu local exclusions
remove every rank-two Lie alternative, leaving J4. The original distinguished
vector remains in the center of that full component; no central covering
kernel is removed. Its intersection with the original module is exactly the
line generated by that vector, and the module image has order 1024.

The final theorem excludes this original escaping component using the proved
J4 two-primary covering theorem. The remaining M22/M24 source branches and
final ambient recognition remain with qt-d-1222-nonff-mathieu.
Source: Aschbacher--Smith C.3.1 and 8.1.1, printed pp.149--151 and712--713,
refs/quasithin.pdf.
-/

public noncomputable section
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open scoped IsMulCommutative
open Sporadic.Mathieu MathieuCode
namespace CFSG.Quasithin.Chapter12.Section02.ChosenModule
open Chapter7.NormalizedSource Chapter7.NormalizedSource.MathieuPairs ChapterE
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
    (D : ChosenModule T L V)

/-- The same escaping distinguished vector lies in the center of an actual
ordinary J4 cover. The entire original module and residual lie in that cover. -/
theorem sourceOrbit_m24_escaping_janko_cover_of_many
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (x : D.sourceOrbit) (hx : E (Additive.ofMul x) ∈ weightTwoOrbit)
    (hout : ¬ centralizer ({(x : G)} : Set G) ≤ normalizer (L : Set G)) :
    let H := centralizer ({(x : G)} : Set G)
    let M := normalizer (L : Set G)
    let B := (solvableResidual (L ⊓ H : Subgroup G)).map (L ⊓ H).subtype
    ∃ K : Subgroup H, IsComponent H K ∧ K.Normal ∧
      ¬ K ≤ (H ⊓ M).subgroupOf H ∧ B.subgroupOf H ≤ K ∧
      D.sourceOrbit.subgroupOf H ≤ K ∧
      ¬ D.sourceOrbit.subgroupOf H ≤ centralizer (K : Set H) ∧
      IsPGroup 2 (center K) ∧ center K ≠ ⊥ ∧
      (x : G) ∈ ((center K).map K.subtype).map H.subtype ∧
      Nonempty ((K ⧸ center K) ≃* Janko4.Model) := by
  let H := centralizer ({(x : G)} : Set G)
  let M := normalizer (L : Set G)
  let C := L ⊓ H
  let B := (solvableResidual C).map C.subtype
  obtain ⟨hc,⟨e⟩⟩ := D.sourceOrbit_m24_hypothesisC28_of_many h hmany hV hq hnon a E hE x hx
  obtain ⟨K,hK,hnK,hKo,hBK,hWK,hWn,hz,hxZ⟩ :=
    D.sourceOrbit_m24_escaping_ordinary_of_many h hmany hV hq hnon a E hE x hx hout
  have hn : H ⊓ M ≤ normalizer (B : Set G) :=
    ((le_inf inf_le_right (inf_le_left.trans H.le_normalizer)).trans
      inf_normalizer_le_normalizer_inf).trans
        (normalizer_le_normalizer_characteristic_image C (solvableResidual C))
  let := hK.2
  have hzp : IsPGroup 2 (center K) := by
    rw [IsQuasisimple.center_eq_pCore (hK.1.pPrimeCore_eq_bot hc.oddCore_eq_bot K)]
    exact pCore_isPGroup
  exact ⟨K,hK,hnK,hKo,hBK,hWK,hWn,hzp,hz,hxZ,
    m22_seed_ordinary_central_quotient hc hn e K hK⟩

/-- The original distinguished involution generates the complete kernel of
the original module in the escaping component's central quotient. -/
theorem sourceOrbit_m24_escaping_janko_kernel_of_many
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (x : D.sourceOrbit) (hx : E (Additive.ofMul x) ∈ weightTwoOrbit)
    (hout : ¬ centralizer ({(x : G)} : Set G) ≤ normalizer (L : Set G)) :
    let H := centralizer ({(x : G)} : Set G)
    let B := (solvableResidual (L ⊓ H : Subgroup G)).map (L ⊓ H).subtype
    ∃ (K : Subgroup H) (hBK : B ≤ K.map H.subtype)
      (hWB : D.sourceOrbit ≤ B),
      IsComponent H K ∧ K.Normal ∧ IsPGroup 2 (center K) ∧ center K ≠ ⊥ ∧
      Nonempty ((K ⧸ center K) ≃* Janko4.Model) ∧
      let f := (QuotientGroup.mk' (center (K.map H.subtype))).comp (inclusion (hWB.trans hBK))
      Nat.card f.range = 1024 ∧ Nat.card f.ker = 2 ∧ f.ker = zpowers x := by
  let H := centralizer ({(x : G)} : Set G)
  let M := normalizer (L : Set G)
  let C := L ⊓ H
  let B := (solvableResidual C).map C.subtype
  obtain ⟨hc,⟨e⟩⟩ := D.sourceOrbit_m24_hypothesisC28_of_many h hmany hV hq hnon a E hE x hx
  obtain ⟨K,hK,hnK,_,hBK,_,_,hzp,hz,hxZ,he⟩ :=
    D.sourceOrbit_m24_escaping_janko_cover_of_many h hmany hV hq hnon a E hE x hx hout
  let J := K.map H.subtype
  have hBJ : B ≤ J := by
    intro b hb
    exact ⟨⟨b,((map_subtype_le (solvableResidual C)).trans inf_le_right) hb⟩,hBK hb,rfl⟩
  have hn : H ⊓ M ≤ normalizer (B : Set G) :=
    ((le_inf inf_le_right (inf_le_left.trans H.le_normalizer)).trans
      inf_normalizer_le_normalizer_inf).trans
        (normalizer_le_normalizer_characteristic_image C (solvableResidual C))
  have hspan : conjugateSpanBy B (H ⊓ M) = B :=
    le_antisymm (conjugateSpanBy_le le_rfl hn) (le_conjugateSpanBy B (H ⊓ M))
  have hWB : D.sourceOrbit ≤ B := hspan ▸ hc.module_le
  have hmove : D.sourceOrbit = ⁅D.sourceOrbit,B⁆ := hspan ▸ hc.module_commutator
  have hcard : Nat.card D.sourceOrbit = 2048 := by
    have hh := Module.natCard_eq_pow_finrank (K := ZMod 2) (V := Additive D.sourceOrbit)
    change Nat.card D.sourceOrbit = _ at hh
    rw [Nat.card_zmod,E.finrank_eq,finrank_cocode] at hh
    exact hh
  have hx1 : x ≠ 1 := by
    intro hx1
    apply weightTwoOrbit_nonzero hx
    rw [hx1]
    exact E.map_zero
  have hxJ : inclusion (hWB.trans hBJ) x ∈ center J := by
    apply mem_center_iff.mpr
    intro k
    obtain ⟨y,hy,hey⟩ := k.property
    obtain ⟨z,⟨c,hc,hcz⟩,hcx⟩ := hxZ
    have hxx : ((c : K) : H).val = (x : G) :=
      (congrArg H.subtype hcz).trans hcx
    apply Subtype.ext
    change (k : G) * (x : G) = (x : G) * (k : G)
    rw [←hxx,←hey]
    exact congrArg (fun z : K => ((z : H) : G)) (mem_center_iff.mp hc ⟨y,hy⟩)
  let : Group.IsPerfect B := Group.IsPerfect.map _
  exact ⟨K,hBJ,hWB,hK,hnK,hzp,hz,he,
    m22_residual_eleven_space_kernel B J D.sourceOrbit hBJ hWB hc.module_nontrivial
      hmove e hcard x hx1 hxJ⟩

/-- The original escaping component contradicts J4 two-primary covering
rigidity at its entire center, with no order-two bound on that center. -/
theorem sourceOrbit_m24_escaping_janko_cover_impossible_of_many
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (x : D.sourceOrbit) (hx : E (Additive.ofMul x) ∈ weightTwoOrbit)
    (hout : ¬ centralizer ({(x : G)} : Set G) ≤ normalizer (L : Set G)) : False := by
  obtain ⟨K,hK,_,_,_,_,_,h2,hz,_,⟨e⟩⟩ :=
    D.sourceOrbit_m24_escaping_janko_cover_of_many h hmany hV hq hnon a E hE x hx hout
  let := hK.2
  exact hz (Janko4.TwoPrimary.center_eq_bot_of_quotient_equiv e h2)

end CFSG.Quasithin.Chapter12.Section02.ChosenModule
