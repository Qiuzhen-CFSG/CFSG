module
public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleRecognitionIdentificationLocalOvergroupAction
public import CFSG.Quasithin.Chapter12.Section02.ReductionSource.RankOneModuleRecognitionIdentificationLocalSylowPair

/-!
# Chapter 12 transitivity on the original sixteen

The literal source overgroup generated by N_L(T∩L) and C_G(z) preserves
the original closure and is transitive on its fifteen nonidentity elements.
All normalizer premises are discharged using the marked Chapter 12 setup.
Source: Aschbacher--Smith, 6.2.11, printed p.686. The faithful-image
recognition and the generation-two H-star contradiction remain outstanding.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory
open CFSG.Quasithin.Chapter6.Source CFSG.Quasithin.Chapter6.Source.RankOneRecognition
namespace CFSG.Quasithin.Chapter12.Section02.RankOneModule
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V : Subgroup G} {n : ℕ} {z : G}

/-- The original ambient group acts transitively on the original four-space. -/
theorem source_local_four_intersection_transitive_action
    (D : ChosenModule T L V) (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (h611 : Hypothesis611 KnownSimple.IsKnownSimple T L
      (normalizer (L : Set G)) (wholeReduced T L) n)
    (hnatural : Conclusion6127 (T : Subgroup G) L
      (normalizer (L : Set G)) (wholeReduced T L) n)
    (hz : z ∈ ZS (T : Subgroup G) L (wholeReduced T L)) (ho : orderOf z = 2)
    (hT : (T : Subgroup G) ≤ centralizer ({z} : Set G))
    (hcard : Nat.card (commutatorLayer T L ⊓ (centralizer ({z} : Set G)).pCoreIn 2 : Subgroup G) = 4) :
    let U := sourceClosure (T : Subgroup G) L (wholeReduced T L) z
    let X := (L ⊓ normalizer (((T : Subgroup G) ⊓ L : Subgroup G) : Set G)) ⊔
      centralizer ({z} : Set G)
    X ≤ normalizer (U : Set G) ∧ ∀ u ∈ U, u ≠ 1 → ∃ g ∈ X, g * z * g⁻¹ = u := by
  have hp := (source_local_layer_normalizers D h h611 hnatural).1
  exact ⟨source_local_four_intersection_generated_action D h h611 hnatural hz ho hT hcard,
    fun _ hu hune => LocalQuotientAction.four_generated_overgroup_transitive
      h611 hnatural hz ho hT hp hcard hu hune⟩

end CFSG.Quasithin.Chapter12.Section02.RankOneModule
