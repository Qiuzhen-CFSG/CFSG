module
public import CFSG.Quasithin.Chapter12.Section02.ReductionSource.SeedAlternativesMovedExhaustionBinaryRatio
public import CFSG.Quasithin.Chapter3.Section02.ChosenSource325.MovedExhaustionBinaryMultiplicity

/-!
# Exactly two marked local pairs in a hypothetical larger normalizer orbit

Every nonzero image of the literal LT-action on U contains its original
simple local module W. The existing exclusion of three successive copies
therefore identifies U/W with W. The component restriction is semisimple,
being generated by the conjugates of the original simple seed; it follows
that U is the direct sum of two copies of W as a component module.

The last theorem preserves the actual component marking and identifies its
action with two copies of the natural-plus-dual SL4(2) or SL5(2) module.
These are the coordinates needed for the remaining multiplicity centralizer
embedding. That calculation, U = W, and the original Source325 assembly
remain with qt-baumann-fsu. All original hypotheses, including hmany, and
the literal local and quotient actions are retained.
Source: Aschbacher--Smith D.3.9(1), D.3.13, and3.2.5,
printed pp.199--202,580; refs/quasithin.pdf.
-/

public noncomputable section

namespace CFSG.Quasithin.Chapter12.Section02.ChosenModule
open Subgroup Theory.GroupTheory Representation Representation.BinaryOffender
open Representation.BinaryOffender.Homogeneous
open Chapter3.Section02.ChosenSource325 ChapterB.QuasisimpleSource ChapterD
open scoped IsMulCommutative
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}

/-- Every nonzero image of the literal local actor on U contains W. -/
theorem normalizer_local_embeds_in_nonzero_image
    {X : Type*} [AddCommGroup X] [Module (ZMod 2) X] [FiniteDimensional (ZMod 2) X]
    (D : ChosenModule T L V) (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hc : V ⊓ centralizer (L : Set G) = ⊥)
    (hm : V < componentOrbit V (T : Subgroup G)) :
    letI := D.normalizerOrbit_elementary h.toHypothesis1221
    let M := normalizer (L : Set G)
    let U := componentOrbit V M
    let ρ := UniqueFactor.imageRepresentation M U (le_normalizer_componentOrbit V M)
    let S := D.normalizerLocalSection h.toHypothesis1221
    ∀ (δ : Representation (ZMod 2) D.normalizerLocalActor X)
      (q : Representation.IntertwiningMap (ρ.comp D.normalizerLocalActor.subtype) δ), q ≠ 0 →
      ∃ i : S.toRepresentation.IntertwiningMap δ, Function.Injective i := by
  let := D.normalizerOrbit_elementary h.toHypothesis1221
  let := D.elementary
  let M := normalizer (L : Set G)
  let U := componentOrbit V M
  let hn := le_normalizer_componentOrbit V M
  let ρ := UniqueFactor.imageRepresentation M U hn
  let j := internalHom M U hn
  let K := (L.subgroupOf M).map j
  let : (L.subgroupOf M).Normal := normal_subgroupOf_of_le_normalizer le_rfl
  let : K.Normal := Normal.map inferInstance j
    (UniqueFactor.actionHom M U hn).rangeRestrict_surjective
  let I := internalImageSubrepresentation hn D.normalizes
  obtain ⟨hmodel,t,ht,hnt,hpair⟩ := D.sylowMovedModel_of_moved_of_many h hmany hc hm
  let g : M := ⟨t,D.sylow_normalizes_component ht⟩
  let Vt := V.map (MulAut.conj t).toMonoidHom
  let J := conjugateSubrepresentationOrderIso ρ K (j g) I
  have hVU : V ≤ U := le_componentOrbit V M
  have hVtW : Vt ≤ componentOrbit V (T : Subgroup G) := by rw [hpair]; exact le_sup_right
  have hWU : componentOrbit V (T : Subgroup G) ≤ U :=
    iSup_conjugates_le_of_le_normalizer V T U hVU (D.sylow_normalizes_component.trans hn)
  have hVtU := hVtW.trans hWU
  let : IsElementaryAbelian 2 Vt := IsElementaryAbelian.of_injective
    (inclusion hVtU) (inclusion_injective hVtU)
  have hJ : J.toSubmodule = internalSection U Vt := by
    rw [conjugateSubrepresentationOrderIso_toSubmodule]
    exact internalSection_map_action hn hVU g
  have hLVt : L ≤ normalizer (Vt : Set G) := normalizes_conjugate D.normalizes g
  have hJI : J = internalImageSubrepresentation hn hLVt := Subrepresentation.toSubmodule_injective hJ
  let W := invariantSubspace ρ K (internalSection U (componentOrbit V (T : Subgroup G)))
    (D.normalizer_sylow_section_component_invariant h.toHypothesis1221)
  have hIW : I ≤ W := fun _ hv => le_componentOrbit V T hv
  have hJW : J ≤ W := by
    intro v hv
    change v ∈ J.toSubmodule at hv
    rw [hJ] at hv
    exact hVtW hv
  have hspan : I.toSubmodule ⊔ J.toSubmodule = W.toSubmodule := by
    rw [hJ]
    change internalSection U V ⊔ internalSection U Vt = internalSection U (componentOrbit V (T : Subgroup G))
    rw [hpair,internalSection_sup U V Vt hVU hVtU]
  let P := D.normalizerLocalActor
  let S : Subrepresentation (ρ.comp P.subtype) := D.normalizerLocalSection h.toHypothesis1221
  let σ : Representation (ZMod 2) P (internalSection U (componentOrbit V (T : Subgroup G))) := S.toRepresentation
  let Q : Representation (ZMod 2) P (Additive U ⧸ S.toSubmodule) := S.quotientRepresentation
  let S₂ := internalSylow T M U hn D.sylow_normalizes_component
  have hKS : P = K ⊔ (S₂ : Subgroup _) := D.normalizerLocalActor_eq_component_sup_sylow
  have hKP : K ≤ P := hKS ▸ le_sup_left
  have hSP : (S₂ : Subgroup _) ≤ P := hKS ▸ le_sup_right
  let Kp := K.subgroupOf P
  let Sp : Sylow 2 P := S₂.subtype hSP
  let ek : Kp ≃* K := subgroupOfEquivOfLe hKP
  have hquot : IsPGroup 2 (P ⧸ Kp) := by
    apply quotient_isPGroup_of_sup_eq_top (Sp : Subgroup P) Kp Sp.isPGroup'
    change (S₂ : Subgroup _).subgroupOf P ⊔ K.subgroupOf P = ⊤
    rw [sup_comm,←subgroupOf_sup hKP hSP,←hKS,subgroupOf_self]
  let Ip : Subrepresentation (σ.comp Kp.subtype) :=
    ⟨I.toSubmodule.comap W.toSubmodule.subtype,fun k v hv => I.apply_mem_toSubmodule (ek k) hv⟩
  let Jp : Subrepresentation (σ.comp Kp.subtype) :=
    ⟨J.toSubmodule.comap W.toSubmodule.subtype,fun k v hv => J.apply_mem_toSubmodule (ek k) hv⟩
  let ei : Ip.toSubmodule ≃ₗ[ZMod 2] I.toSubmodule :=
    Submodule.comapSubtypeEquivOfLe hIW
  have hspan' : Ip.toSubmodule ⊔ Jp.toSubmodule = ⊤ := by
    apply top_unique
    intro v _
    have hv : v.val ∈ I.toSubmodule ⊔ J.toSubmodule := hspan.symm ▸ v.property
    obtain ⟨x,hx,y,hy,hxy⟩ := Submodule.mem_sup.mp hv
    exact Submodule.mem_sup.mpr ⟨⟨x,hIW hx⟩,hx,⟨y,hJW hy⟩,hy,Subtype.ext hxy⟩
  have hd : Disjoint Ip.toSubmodule Jp.toSubmodule := by
    apply Submodule.disjoint_def.mpr
    intro v hv hw
    change v.val ∈ J.toSubmodule at hw
    rw [hJ] at hw
    exact Subtype.ext (Additive.toMul.injective (Subtype.ext
      ((D.moved_conjugate_inf_eq_bot h.toHypothesis1221 hc ht hnt).le ⟨hv,hw⟩)))
  let cp : IsCompl Ip.toSubmodule Jp.toSubmodule := ⟨hd,codisjoint_iff.mpr hspan'⟩
  change ∀ (δ : Representation (ZMod 2) P X)
    (q : Representation.IntertwiningMap (ρ.comp P.subtype) δ), q ≠ 0 →
    ∃ i : σ.IntertwiningMap δ, Function.Injective i
  intro δ q hq
  have hiI : IsIrreducible I.toRepresentation := internalImageSubrepresentation_irreducible
    hn D.normalizes (internalSubrepresentation_irreducible hn L.le_normalizer
      hVU D.normalizes D.ne_bot (D.seed_invariant_subgroup_eq hc))
  have hjJ : IsIrreducible J.toRepresentation :=
    (normalTypeAction ρ K).conjugate_irreducible I hiI (j g)
  let ej : Jp.toSubmodule ≃ₗ[ZMod 2] J.toSubmodule :=
    Submodule.comapSubtypeEquivOfLe hJW
  have hip : IsIrreducible Ip.toRepresentation := by
    have he : Nonempty (Ip.toRepresentation.Equiv (I.toRepresentation.comp ek.toMonoidHom)) :=
      ⟨.mk ei (by intro k; rfl)⟩
    obtain ⟨a⟩ := he
    apply (RepEquiv.irreducible_euqiv ⟨a.toLinearEquiv,a.isIntertwining'⟩).mpr
    exact (irreducible_comp_surjective_iff ek.toMonoidHom ek.surjective _).mpr hiI
  have hjp : IsIrreducible Jp.toRepresentation := by
    let a : Jp.toRepresentation.Equiv (J.toRepresentation.comp ek.toMonoidHom) :=
      .mk ej (by intro k; rfl)
    apply (RepEquiv.irreducible_euqiv ⟨a.toLinearEquiv,a.isIntertwining'⟩).mpr
    exact (irreducible_comp_surjective_iff ek.toMonoidHom ek.surjective _).mpr hjJ
  have hle (r : M) : V.map (MulAut.conj r.val).toMonoidHom ≤ U :=
    le_iSup (fun x : M => V.map (MulAut.conj x.val).toMonoidHom) r
  let R (r : M) : Subrepresentation ((ρ.comp P.subtype).comp Kp.subtype) :=
    (internalImageSubrepresentation hn (normalizes_conjugate D.normalizes r)).compActors ek.toMonoidHom
  have hspanR : (⨆ r, (R r).toSubmodule) = ⊤ := by
    let B := ⨆ r, (R r).toSubmodule
    let N : Subgroup G := B.toAddSubgroup.toSubgroup'.map U.subtype
    have hUN : U ≤ N := by
      refine iSup_le fun r => ?_
      rintro _ ⟨v,hv,rfl⟩
      let w : Additive U := Additive.ofMul ⟨r.val*v*r.val⁻¹,hle r ⟨v,hv,rfl⟩⟩
      have hw : w ∈ B := (le_iSup (fun r => (R r).toSubmodule) r) ⟨v,hv,rfl⟩
      exact ⟨w.toMul,hw,rfl⟩
    apply top_unique
    intro v _
    obtain ⟨w,hw,he⟩ := hUN v.toMul.property
    exact (show Additive.ofMul w = v from congrArg Additive.ofMul (Subtype.ext he)) ▸ hw
  have htypes (r : M) : Nonempty (Ip.toRepresentation.Equiv (R r).toRepresentation) ∨
      Nonempty (Jp.toRepresentation.Equiv (R r).toRepresentation) := by
    let : IsElementaryAbelian 2 (V.map (MulAut.conj r.val).toMonoidHom) :=
      IsElementaryAbelian.of_le (hle r)
    rcases D.normalizer_two_types_of_moved_of_many h hmany hc hm t ht hnt r r.property with hr | hr
    · obtain ⟨e,he⟩ := same_internalImageSubrepresentation hn hVU (hle r) D.normalizes
        (normalizes_conjugate D.normalizes r) hr
      exact Or.inl ⟨.mk (ei.trans e) (by intro k; apply LinearMap.ext; intro v; exact he (ek k) (ei v))⟩
    · obtain ⟨e,he⟩ := same_internalImageSubrepresentation hn hVtU (hle r) hLVt
        (normalizes_conjugate D.normalizes r) hr
      have hsame : SameModule J (internalImageSubrepresentation hn
          (normalizes_conjugate D.normalizes r)) := hJI.symm ▸ ⟨e,he⟩
      obtain ⟨e',he'⟩ := hsame
      exact Or.inr ⟨.mk (ej.trans e') (by intro k; apply LinearMap.ext; intro v; exact he' (ek k) (ej v))⟩
  let : IsIrreducible σ := D.normalizer_local_section_irreducible h hmany hc hm
  exact embedding_of_two_type_span Kp hquot σ (ρ.comp P.subtype) δ Ip Jp hip hjp cp R
    hspanR htypes q hq


/-- In a strict enlargement the entire quotient U/W is the original local
module W, with the full LT actor retained. Thus the chief filtration has
exactly two terms, rather than just at most two isomorphism types. -/
theorem normalizer_local_quotient_equiv_of_strict
    (D : ChosenModule T L V) (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hc : V ⊓ centralizer (L : Set G) = ⊥)
    (hm : V < componentOrbit V (T : Subgroup G))
    (hne : componentOrbit V (normalizer (L : Set G)) ≠ componentOrbit V (T : Subgroup G)) :
    letI := D.normalizerOrbit_elementary h.toHypothesis1221
    let S := D.normalizerLocalSection h.toHypothesis1221
    Nonempty (S.toRepresentation.Equiv S.quotientRepresentation) := by
  let := D.normalizerOrbit_elementary h.toHypothesis1221
  let M := normalizer (L : Set G)
  let U := componentOrbit V M
  let : AddCommGroup (Additive U) := inferInstance
  let : Module (ZMod 2) (Additive U) := inferInstance
  let ρ := UniqueFactor.imageRepresentation M U (le_normalizer_componentOrbit V M)
  let P := D.normalizerLocalActor
  let S : Subrepresentation (ρ.comp P.subtype) := D.normalizerLocalSection h.toHypothesis1221
  obtain ⟨i,hi⟩ := D.normalizer_local_quotient_embedding_of_strict h hmany hc hm hne
  apply quotient_equiv_of_no_three_sections (ρ.comp P.subtype) S i hi
  · intro B hB
    have hBt : B.toSubmodule ≠ ⊤ := fun he => hB (Subrepresentation.toSubmodule_injective he)
    let : Nontrivial ((Additive U ⧸ S.toSubmodule) ⧸ B.toSubmodule) :=
      Submodule.Quotient.nontrivial_iff.mpr hBt
    let q : Representation.IntertwiningMap (ρ.comp P.subtype) B.quotientRepresentation := {
      toLinearMap := B.toSubmodule.mkQ.comp S.toSubmodule.mkQ
      isIntertwining' _ := rfl }
    have hq : q ≠ 0 := by
      intro hz
      obtain ⟨v,hv⟩ := exists_ne (0 : (Additive U ⧸ S.toSubmodule) ⧸ B.toSubmodule)
      obtain ⟨w,rfl⟩ := B.toSubmodule.mkQ_surjective v
      obtain ⟨x,rfl⟩ := S.toSubmodule.mkQ_surjective w
      exact hv (congrArg (fun q : Representation.IntertwiningMap (ρ.comp P.subtype) B.quotientRepresentation => q x) hz)
    exact D.normalizer_local_embeds_in_nonzero_image h hmany hc hm B.quotientRepresentation q hq
  · exact D.normalizer_no_three_local_sections_of_strict h hmany hc hm hne

/-- The actual normalizer orbit has precisely twice the local dimension
in the hypothetical strict-enlargement branch. -/
theorem normalizer_finrank_eq_two_mul_local_of_strict
    (D : ChosenModule T L V) (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hc : V ⊓ centralizer (L : Set G) = ⊥)
    (hm : V < componentOrbit V (T : Subgroup G))
    (hne : componentOrbit V (normalizer (L : Set G)) ≠ componentOrbit V (T : Subgroup G)) :
    letI := D.normalizerOrbit_elementary h.toHypothesis1221
    let U := componentOrbit V (normalizer (L : Set G))
    Module.finrank (ZMod 2) (Additive U) =
      2 * Module.finrank (ZMod 2) (internalSection U (componentOrbit V (T : Subgroup G))) := by
  let := D.normalizerOrbit_elementary h.toHypothesis1221
  let S := D.normalizerLocalSection h.toHypothesis1221
  obtain ⟨e⟩ := D.normalizer_local_quotient_equiv_of_strict h hmany hc hm hne
  have he := e.toLinearEquiv.finrank_eq
  have hd := Submodule.finrank_quotient_add_finrank S.toSubmodule
  change Module.finrank (ZMod 2) _ = Module.finrank (ZMod 2) (_ ⧸ S.toSubmodule) at he
  rw [←he] at hd
  change Module.finrank (ZMod 2) _ = 2 * Module.finrank (ZMod 2) S.toSubmodule
  simpa only [two_mul] using hd.symm


/-- The full orbit is semisimple for its literal component image, because
it is generated by conjugates of the original simple seed. -/
theorem normalizer_component_semisimple
    (D : ChosenModule T L V) (h : Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (hc : V ⊓ centralizer (L : Set G) = ⊥) :
    letI := D.normalizerOrbit_elementary h
    let M := normalizer (L : Set G)
    let U := componentOrbit V M
    let hn := le_normalizer_componentOrbit V M
    let K := (L.subgroupOf M).map (internalHom M U hn)
    Representation.IsSemisimpleRepresentation
      ((UniqueFactor.imageRepresentation M U hn).comp K.subtype) := by
  let := D.normalizerOrbit_elementary h
  let M := normalizer (L : Set G)
  let U := componentOrbit V M
  let hn := le_normalizer_componentOrbit V M
  let ρ := UniqueFactor.imageRepresentation M U hn
  let j := internalHom M U hn
  let K := (L.subgroupOf M).map j
  let : (L.subgroupOf M).Normal := normal_subgroupOf_of_le_normalizer le_rfl
  let : K.Normal := Normal.map inferInstance j
    (UniqueFactor.actionHom M U hn).rangeRestrict_surjective
  let I := internalImageSubrepresentation hn D.normalizes
  have hi : IsIrreducible I.toRepresentation := internalImageSubrepresentation_irreducible
    hn D.normalizes (internalSubrepresentation_irreducible hn L.le_normalizer
      (le_componentOrbit V M) D.normalizes D.ne_bot (D.seed_invariant_subgroup_eq hc))
  let := simple_asSubmodule I hi
  apply (isSemisimpleRepresentation_iff_isSemisimpleModule_asModule _).mpr
  apply normal_restriction_semisimple_of_generating_family ρ K (fun _ : Unit => I)
    (fun _ => inferInstance)
  intro B hB
  let N : Subgroup G := B.toSubmodule.toAddSubgroup.toSubgroup'.map U.subtype
  have hUN : U ≤ N := by
    refine iSup_le fun r => ?_
    rintro _ ⟨v,hv,rfl⟩
    let w : Additive U := ρ (j r) (Additive.ofMul ⟨v,le_componentOrbit V M hv⟩)
    have hw : w ∈ B := B.apply_mem_toSubmodule (j r) (hB () hv)
    exact ⟨w.toMul,hw,rfl⟩
  apply Subrepresentation.toSubmodule_injective
  apply top_unique
  intro v _
  obtain ⟨w,hw,he⟩ := hUN v.toMul.property
  exact (show Additive.ofMul w = v from congrArg Additive.ofMul (Subtype.ext he)) ▸ hw

/-- In a strict enlargement the original component acts on exactly two
copies of the marked local pair. This is the splitting needed by the
multiplicity-two centralizer calculation. -/
theorem normalizer_component_double_local_of_strict
    (D : ChosenModule T L V) (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hc : V ⊓ centralizer (L : Set G) = ⊥)
    (hm : V < componentOrbit V (T : Subgroup G))
    (hne : componentOrbit V (normalizer (L : Set G)) ≠ componentOrbit V (T : Subgroup G)) :
    letI := D.normalizerOrbit_elementary h.toHypothesis1221
    let M := normalizer (L : Set G)
    let U := componentOrbit V M
    let hn := le_normalizer_componentOrbit V M
    let K := (L.subgroupOf M).map (internalHom M U hn)
    let τ := D.normalizerLocalComponentAction h.toHypothesis1221
    Nonempty (Representation.Equiv
      ((UniqueFactor.imageRepresentation M U hn).comp K.subtype) (τ.prod τ)) := by
  let := D.normalizerOrbit_elementary h.toHypothesis1221
  let M := normalizer (L : Set G)
  let U := componentOrbit V M
  let : AddCommGroup (Additive U) := inferInstance
  let : Module (ZMod 2) (Additive U) := inferInstance
  let hn := le_normalizer_componentOrbit V M
  let ρ := UniqueFactor.imageRepresentation M U hn
  let K := (L.subgroupOf M).map (internalHom M U hn)
  let P := D.normalizerLocalActor
  have hKP : K ≤ P := by
    change K ≤ D.normalizerLocalActor
    rw [D.normalizerLocalActor_eq_component_sup_sylow]
    exact le_sup_left
  let W : Subrepresentation (ρ.comp K.subtype) := invariantSubspace ρ K
    (internalSection U (componentOrbit V (T : Subgroup G)))
    (D.normalizer_sylow_section_component_invariant h.toHypothesis1221)
  obtain ⟨e⟩ := D.normalizer_local_quotient_equiv_of_strict h hmany hc hm hne
  let a : W.toRepresentation.Equiv W.quotientRepresentation :=
    .mk e.toLinearEquiv (by intro k; exact e.isIntertwining' ⟨k.val,hKP k.property⟩)
  exact split_double_of_quotient_equiv (ρ.comp K.subtype) W
    (D.normalizer_component_semisimple h.toHypothesis1221 hc) a


/-- The multiplicity-two conclusion retains the precise binary model and
the original component marking on the whole normalizer orbit. -/
theorem normalizer_double_naturalDual_of_strict
    (D : ChosenModule T L V) (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hc : V ⊓ centralizer (L : Set G) = ⊥)
    (hm : V < componentOrbit V (T : Subgroup G))
    (hne : componentOrbit V (normalizer (L : Set G)) ≠ componentOrbit V (T : Subgroup G)) :
    letI := D.normalizerOrbit_elementary h.toHypothesis1221
    let M := normalizer (L : Set G)
    let U := componentOrbit V M
    let hn := le_normalizer_componentOrbit V M
    let K := (L.subgroupOf M).map (internalHom M U hn)
    ∃ d : ℕ, (d = 4 ∨ d = 5) ∧
      Nonempty (ActionEquiv ((UniqueFactor.imageRepresentation M U hn).comp K.subtype)
        ((naturalPlusDual d).prod (naturalPlusDual d))) := by
  let := D.normalizerOrbit_elementary h.toHypothesis1221
  let M := normalizer (L : Set G)
  let U := componentOrbit V M
  let : AddCommGroup (Additive U) := inferInstance
  let : Module (ZMod 2) (Additive U) := inferInstance
  let : AddCommGroup (internalSection U (componentOrbit V (T : Subgroup G))) := inferInstance
  let : Module (ZMod 2) (internalSection U (componentOrbit V (T : Subgroup G))) := inferInstance
  let hn := le_normalizer_componentOrbit V M
  let K := (L.subgroupOf M).map (internalHom M U hn)
  let ρ := (UniqueFactor.imageRepresentation M U hn).comp K.subtype
  let τ := D.normalizerLocalComponentAction h.toHypothesis1221
  obtain ⟨e⟩ := D.normalizer_component_double_local_of_strict h hmany hc hm hne
  obtain ⟨d,hd,⟨a⟩⟩ := (D.normalizer_strict_binary_centralizer_obstruction h hmany hc hm hne).1
  let b : ActionEquiv (τ.prod τ) ((naturalPlusDual d).prod (naturalPlusDual d)) := {
    groupEquiv := a.groupEquiv
    linearEquiv := a.linearEquiv.prodCongr a.linearEquiv
    intertwines k v := Prod.ext (a.intertwines k v.1) (a.intertwines k v.2) }
  exact ⟨d,hd,⟨{
    groupEquiv := b.groupEquiv
    linearEquiv := e.toLinearEquiv.trans b.linearEquiv
    intertwines k v := (congrArg b.linearEquiv (LinearMap.congr_fun (e.isIntertwining' k) v)).trans
      (b.intertwines k (e v)) }⟩⟩

end CFSG.Quasithin.Chapter12.Section02.ChosenModule
