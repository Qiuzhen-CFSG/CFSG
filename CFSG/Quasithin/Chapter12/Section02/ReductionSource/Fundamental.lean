module
public import CFSG.Quasithin.Chapter12.Section02.SourceHypotheses
public import CFSG.Quasithin.Chapter3.Section02.Setup
public import Theory.Representation.BinaryOffender.AmbientSectionTransport
public import Theory.GroupTheory.ReducedNormal.SubspaceGroupConsequences
/-!
# The chosen Section 12.2 module in the Fundamental Setup

The relative normalization in the original Irr⁺ choice implies T normalizes
L in G. Thus L₀=L, and the same reduced subspace defines the Fundamental
Setup with seed exactly V. Its T-orbit and normalizer-orbit are the original
subgroups, with no replacement of the action or its inclusions. Full
commutator generation also places V in the literal O₂(L).

These identities let the genuine earlier FSU theorems act on a Section 12.2
choice. The model list and the normalization of V itself are not assumed or
claimed here.
Source: Aschbacher--Smith, combined manuscript, 1 March 2004,
Hypothesis 3.2.1 and Theorem 12.2.2, pp.579 and 794--795.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
open Representation.BinaryOffender Representation.BinaryOffender.Homogeneous
namespace CFSG.Quasithin.Chapter12.Section02.ChosenModule
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  (D : ChosenModule T L V)
include D

omit [Finite G] in
/-- Relative normalization in the choice gives ambient T-normalization of L. -/
theorem sylow_normalizes_component : (T : Subgroup G) ≤ normalizer (L : Set G) := by
  have hn := map_normalizes L (L ⊔ (T : Subgroup G)) le_sup_left
    ((T : Subgroup G).subgroupOf (L ⊔ (T : Subgroup G))) D.irrPlus.normalizes
  simpa only [map_subgroupOf_eq_of_le le_sup_right] using hn

omit [Finite G] in
/-- The original T-conjugate closure of L is L. -/
theorem localOrbit_eq : Chapter3.Section02.localOrbit T L = L :=
  le_antisymm (iSup_conjugates_le_of_le_normalizer L T L le_rfl
    D.sylow_normalizes_component) (le_componentOrbit L T)

omit [Finite G] in
/-- The chosen subgroup is generated by its actual L-commutators. -/
theorem eq_commutator : V = ⁅V, L⁆ := by
  have he := ReducedNormal.subspaceImage_eq_commutator
    (L ⊔ (T : Subgroup G)) D.space L le_sup_left D.irrPlus.invariant
    D.irrPlus.isIrrPlus.choose_spec.1
  change subspaceImage (L ⊔ (T : Subgroup G)) D.space =
    ⁅subspaceImage (L ⊔ (T : Subgroup G)) D.space, L⁆ at he
  rwa [D.image_eq] at he

omit [Finite G] in
/-- The chosen subgroup lies in the original component. -/
theorem le_component : V ≤ L := by
  rw [← D.image_eq]
  exact ReducedNormal.subspaceImage_le_of_full_commutator _ L
    (sup_le L.le_normalizer D.sylow_normalizes_component) D.space
    D.irrPlus.isIrrPlus.choose_spec.1

omit [Finite G] in
/-- The same chosen subgroup lies in the literal two-core of L. -/
theorem le_componentCore : V ≤ L.pCoreIn 2 := by
  let := D.elementary
  exact le_pCoreIn_of_normalizes (IsElementaryAbelian.isPGroup 2 V)
    D.le_component D.normalizes

private def fundamentalSetupAux {K : GroupClass.{u}} {L₀ : Subgroup G}
    (he : Chapter3.Section02.localOrbit T L = L₀) (D₀ : ChosenModule T L₀ V)
    (h : Hypothesis1221 K T L) : Chapter3.Section02.FundamentalSetup K T L := by
  subst L₀
  exact ⟨h.simpleQTKE, h.maximal_faithful.1, h.maximal_faithful.2,
    h.quasisimple, D₀.space, D₀.irrPlus⟩

omit D in
private theorem fundamentalSetupAux_seed {K : GroupClass.{u}} {L₀ : Subgroup G}
    (he : Chapter3.Section02.localOrbit T L = L₀) (D₀ : ChosenModule T L₀ V)
    (h : Hypothesis1221 K T L) : (fundamentalSetupAux he D₀ h).seed = V := by
  subst L₀
  exact D₀.image_eq

/-- The actual chosen subspace supplies the original Fundamental Setup. -/
def fundamentalSetup {K : GroupClass.{u}} (h : Hypothesis1221 K T L) :
    Chapter3.Section02.FundamentalSetup K T L :=
  fundamentalSetupAux D.localOrbit_eq D h

/-- The original seed is exactly V. -/
theorem fundamentalSetup_seed {K : GroupClass.{u}} (h : Hypothesis1221 K T L) :
    (D.fundamentalSetup h).seed = V := fundamentalSetupAux_seed D.localOrbit_eq D h

/-- The FSU module is the actual T-orbit of V. -/
theorem fundamentalSetup_module {K : GroupClass.{u}} (h : Hypothesis1221 K T L) :
    (D.fundamentalSetup h).moduleSubgroup = componentOrbit V (T : Subgroup G) := by
  rw [Chapter3.Section02.FundamentalSetup.moduleSubgroup, D.fundamentalSetup_seed]

/-- The full FSU module is the actual normalizer-orbit of V. -/
theorem fundamentalSetup_fullModule {K : GroupClass.{u}} (h : Hypothesis1221 K T L) :
    (D.fundamentalSetup h).fullModule = componentOrbit V (normalizer (L : Set G)) := by
  rw [(D.fundamentalSetup h).fullModule_eq_seed_orbit, D.fundamentalSetup_seed]
  rw [Chapter3.Section02.FundamentalSetup.maximalLocal, D.localOrbit_eq]
end CFSG.Quasithin.Chapter12.Section02.ChosenModule
