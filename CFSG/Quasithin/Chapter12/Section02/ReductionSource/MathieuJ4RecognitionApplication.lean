/-- The exact original marked M₂₄ inputs now construct AS91 (4.1): the
quasisimple cubic centralizer in H/⟨z⟩ and its actual six-dimensional GF(4)
module. The sole extra source input remains the full cubic quotient hquot.
Ambient recognition still requires the later local geometry and cycle base. -/
theorem sourceOrbit_m24_cubic_structure
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1)
    (hquot : Nonempty (Recognition.JankoFour.CubicAutomorphismQuotient
      ((centralizer ({(z : G)} : Set G)) ⧸
        pCore 2 (centralizer ({(z : G)} : Set G))))) :
    let ht := D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot
    letI := ht.extraspecial
    ∃ (e : Recognition.JankoFour.CubicAutomorphismQuotient
        ((centralizer ({(z : G)} : Set G)) ⧸ Recognition.JankoFour.core (z : G)))
      (X : Sylow 3 (Recognition.JankoFour.LocalGeometry.CubicLift.subgroup e)),
      Nat.card X = 3 ∧
      (∀ g : centralizer ({(z : G)} : Set G), ∃ q : Recognition.JankoFour.core (z : G),
        ∃ n : normalizer (cubicSylowImage e X : Set (centralizer ({(z : G)} : Set G))),
          (q : centralizer ({(z : G)} : Set G)) * n = g) ∧
      (centralizer (cubicSylowImage e X : Set (centralizer ({(z : G)} : Set G)))).subgroupOf
        (Recognition.JankoFour.core (z : G)) = center (Recognition.JankoFour.core (z : G)) ∧
      IsQuasisimple (cubicCentralizer e X) ∧
      Nonempty (cubicCentralizer e X ≃* M22TripleCover) ∧
      (center (cubicCentralizer e X)).map (cubicCentralizer e X).subtype =
        (cubicSylowImage e X).map (QuotientGroup.mk' (center (centralizer ({(z : G)} : Set G)))) ∧
      letI := coreFieldModule ht e X
      Module.finrank F (CoreSpace (z := (z : G))) = 6 ∧
      (cubicCentralizerFieldRepresentation ht e X).IsIrreducible ∧
      Function.Injective (cubicCentralizerFieldRepresentation ht e X) ∧
      (∀ g v, cubicCentralizerFieldRepresentation ht e X g v =
        coreBinaryRepresentation ht (centerToCoreProjection ht g.val) v) ∧
      letI := fieldModule M22TripleCover.binaryRepresentation M22TripleCover.binaryRepresentation_faithful
      Nonempty (Representation.Equiv (cubicCentralizerFieldRepresentation ht e X)
        ((fieldRepresentation M22TripleCover.binaryRepresentation M22TripleCover.binaryRepresentation_faithful).comp
          (cubicCentralizerTripleEquiv ht e X).toMonoidHom)) := by
  exact source_cubic_structure
    (D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot)

/-- The exact marked M₂₄ data produce actual noncentral core involutions
covering all centralizer classes, with only the original full cubic quotient
as additional input. This applies the orbit-cover part of AS91 (4.2). -/
theorem sourceOrbit_m24_involution_cover
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1)
    (hquot : Nonempty (Recognition.JankoFour.CubicAutomorphismQuotient
      ((centralizer ({(z : G)} : Set G)) ⧸
        pCore 2 (centralizer ({(z : G)} : Set G))))) :
    ∃ r₁ r₂ : Recognition.JankoFour.core (z : G),
      orderOf r₁ = 2 ∧ orderOf r₂ = 2 ∧
      r₁ ∉ center (Recognition.JankoFour.core (z : G)) ∧
      r₂ ∉ center (Recognition.JankoFour.core (z : G)) ∧ r₁ ≠ r₂ ∧
      ∀ r : Recognition.JankoFour.core (z : G), orderOf r = 2 →
        r ∉ center (Recognition.JankoFour.core (z : G)) →
        IsConj (r : centralizer ({(z : G)} : Set G))
          (r₁ : centralizer ({(z : G)} : Set G)) ∨
        IsConj (r : centralizer ({(z : G)} : Set G))
          (r₂ : centralizer ({(z : G)} : Set G)) := by
  exact source_involution_cover
    (D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot)

