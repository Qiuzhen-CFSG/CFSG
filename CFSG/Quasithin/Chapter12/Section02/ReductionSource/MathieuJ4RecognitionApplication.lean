theorem sourceOrbit_m24_native_stabilizers
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1)
    (hquot : Nonempty (Recognition.JankoFour.CubicAutomorphismQuotient
      ((centralizer ({(z : G)} : Set G)) ⧸
        pCore 2 (centralizer ({(z : G)} : Set G))))) :
    let ht := D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot
    letI := ht.extraspecial
    ∃ (e : Recognition.JankoFour.CubicAutomorphismQuotient
        ((centralizer ({(z : G)} : Set G)) ⧸ Recognition.JankoFour.core (z : G)))
      (X : Sylow 3 (Recognition.JankoFour.LocalGeometry.CubicLift.subgroup e)),
      Function.Bijective (coreAmbientHom ht e X) ∧
      e.projection.ker.map (coreAmbientHom ht e X) =
        Janko4.InvolutionCentralizers.First.QuotientExtension.scalarSubgroup ∧
      (∀ g, coreAmbientAutEquiv ht e X (e.projection g) =
        Janko4.InvolutionCentralizers.First.QuotientExtension.quotientConjugation
          (coreAmbientHom ht e X g)) ∧
      ∃ r₁ r₂ : Recognition.JankoFour.core (z : G),
        orderOf r₁ = 2 ∧ orderOf r₂ = 2 ∧
        r₁ ∉ center (Recognition.JankoFour.core (z : G)) ∧
        r₂ ∉ center (Recognition.JankoFour.core (z : G)) ∧
        ¬ IsConj (r₁ : centralizer ({(z : G)} : Set G))
          (r₂ : centralizer ({(z : G)} : Set G)) ∧
        Nonempty ((centralizer ({(r₁ : centralizer ({(z : G)} : Set G))} :
          Set (centralizer ({(z : G)} : Set G)))).map
            (QuotientGroup.mk' (Recognition.JankoFour.core (z : G))) ≃*
              nativeVectorStabilizer (VectorOrbits.decode 4)) ∧
        Nonempty ((centralizer ({(r₂ : centralizer ({(z : G)} : Set G))} :
          Set (centralizer ({(z : G)} : Set G)))).map
            (QuotientGroup.mk' (Recognition.JankoFour.core (z : G))) ≃*
              nativeVectorStabilizer (VectorOrbits.decode 7)) ∧
        (∀ r : Recognition.JankoFour.core (z : G),
          r ∉ center (Recognition.JankoFour.core (z : G)) →
          Function.Injective (e.projection.comp (coreVectorStabilizer ht r).subtype)) ∧
        ∀ r : Recognition.JankoFour.core (z : G), orderOf r = 2 →
          r ∉ center (Recognition.JankoFour.core (z : G)) →
          IsConj (r : centralizer ({(z : G)} : Set G))
            (r₁ : centralizer ({(z : G)} : Set G)) ∨
          IsConj (r : centralizer ({(z : G)} : Set G))
            (r₂ : centralizer ({(z : G)} : Set G)) := by
  exact source_involution_native_stabilizers
