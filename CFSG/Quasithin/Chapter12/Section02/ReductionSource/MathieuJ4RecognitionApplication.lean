/-- The marked M₂₄ branch supplies exactly the original type-J₄ hypotheses
once the full centralizer cubic quotient has been constructed. -/
theorem sourceOrbit_m24_isTypeJ4
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1)
    (hquot : Nonempty (Recognition.JankoFour.CubicAutomorphismQuotient
      ((centralizer ({(z : G)} : Set G)) ⧸
        pCore 2 (centralizer ({(z : G)} : Set G))))) :
    Recognition.JankoFour.IsTypeJ4 (z : G) := by
  let C := centralizer ({(z : G)} : Set G)
  have hz2 : orderOf (z : G) = 2 := orderOf_eq_prime
    (elemPow_eq_one_of_isElementaryAbelian (p := 2) (z : G) z.property)
    (fun he => hne (Subtype.ext he))
  have hTC : (T : Subgroup G) ≤ C :=
    fun t ht => mem_centralizer_singleton_iff.mpr (hz t ht)
  have hself : centralizer (pCore 2 C : Set C) ≤ pCore 2 C :=
    Chapter1.mem_He_iff.mp (Chapter1.twoLocal_mem_He_of_sylow_le T
      (h.simpleQTKE.evenCharacteristic T) (isTwoLocal_involution_centralizer hz2) hTC)
  have hcore : pCore 2 C = sourceClosure L D.sourceOrbit z := by
    apply map_injective C.subtype_injective
    exact D.sourceOrbit_m24_centralizer_core_eq_closure h hmany hV hq hnon a E hE z hz hne
  obtain ⟨hextra, hcard, _⟩ :=
    D.sourceOrbit_m24_centralizer_extraspecial h hmany hV hq hnon a E hE z hz hne
  apply Recognition.JankoFour.isTypeJ4_of_twoCore hz2 hself
  · rwa [hcore]
  · change Nat.card (pCore 2 C) = 2 ^ 13
    rw [hcore, hcard]
    norm_num
  · exact hquot
  · obtain ⟨⟨l, hl, hlne⟩, _⟩ :=
      D.sourceOrbit_m24_not_weakly_closed_in_closure h hmany hV hq hnon a E hE z hz hne
    exact ⟨(l : G), hcore ▸ hl, hlne⟩

open Recognition.JankoFour.SourceRecognition

/-- The exact marked M₂₄ inputs construct the source orthogonal action and
its simple/triple-cover alternative, including the fixed-core conclusion in
the triple branch. This is a local module application, not ambient recognition. -/
theorem sourceOrbit_m24_module_alternative
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1)
    (hquot : Nonempty (Recognition.JankoFour.CubicAutomorphismQuotient
      ((centralizer ({(z : G)} : Set G)) ⧸
        pCore 2 (centralizer ({(z : G)} : Set G))))) :
    let ht := D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot
    letI := ht.extraspecial
    ∃ e : Recognition.JankoFour.CubicAutomorphismQuotient
        ((centralizer ({(z : G)} : Set G)) ⧸ Recognition.JankoFour.core (z : G)),
      Function.Injective (innerDerivedRepresentation ht e) ∧
      Module.finrank (ZMod 2) (CoreSpace (z := (z : G))) = 12 ∧
      (coreQuadraticForm (z := (z : G))).polarBilin.Nondegenerate ∧
      (coreQuadraticForm (z := (z : G))).polarBilin.IsAlt ∧
      (∀ x v, coreQuadraticForm (innerDerivedRepresentation ht e x v) = coreQuadraticForm v) ∧
      (Nonempty ((_root_.commutator (innerPreimage e)) ≃* M22) ∨
        ∃ ec : (_root_.commutator (innerPreimage e)) ≃* M22TripleCover,
          (innerDerivedRepresentation ht e).IsIrreducible ∧
          Nonempty (Representation.Equiv (innerDerivedRepresentation ht e)
            (M22TripleCover.representationOfEquiv ec)) ∧
          ∀ X : Sylow 3 (Recognition.JankoFour.LocalGeometry.CubicLift.subgroup e),
            (centralizer (cubicSylowImage e X : Set (centralizer ({(z : G)} : Set G)))).subgroupOf
              (Recognition.JankoFour.core (z : G)) = center (Recognition.JankoFour.core (z : G))) := by
  exact source_module_alternative
    (D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot)

