module

public import CFSG.Quasithin.Chapter12.Section02.ReductionSource.MathieuJ4RecognitionApplication
public import Theory.GroupTheory.Recognition.JankoFour.SourceRecognition.ThreeSpace.RootActions

/-!
# The original Mathieu application of the radical root coordinates

The existing marked M₂₄ source inputs and full cubic quotient construct the
same three-space, its four-dimensional pair section and three-copy radical
coordinates. The original K/R marking acts on these coordinates by the
specified binary shear and swaps, while the same S/R acts diagonally. The
full Fano-line stabilizers are generated by the two original point-core
images and fix the corresponding pair section pointwise.

This discharges the line-stabilizer and root-coordinate steps in the tensor
argument without adding source premises. Full tensor identification and
ambient J₄ recognition are still separate obligations.

Source: Aschbacher–Smith 8.2.12–14, printed pp.722–723;
Aschbacher–Segev (1991), (4.4), pp.597–598, DOI 10.1007/BF01232280.
-/

public section
open Subgroup Representation Representation.BinaryOffender Theory.GroupTheory
open Sporadic.Mathieu MathieuCode
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter12.Section02.ChosenModule
open ChapterE Chapter7.NormalizedSource Chapter8.Section02.Centralizer
open Recognition.JankoFour.SourceRecognition
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  (D : ChosenModule T L V)

/-- Actual root coordinates, with the original quotient actions and no new input. -/
theorem sourceOrbit_m24_three_space_root_coordinates
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1)
    (hquot : Nonempty (Recognition.JankoFour.CubicAutomorphismQuotient
      ((centralizer ({(z : G)} : Set G)) ⧸
        pCore 2 (centralizer ({(z : G)} : Set G))))) :
    let ht := D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot
    ∃ (cubic : Recognition.JankoFour.CubicAutomorphismQuotient
        (centralizer ({(z : G)} : Set G) ⧸ Recognition.JankoFour.core (z : G)))
      (X : Sylow 3 (Recognition.JankoFour.LocalGeometry.CubicLift.subgroup cubic))
      (d : ThreeSpaceData (z : G) cubic X),
      letI := d.R_normal_in_S_intrinsic
      letI := d.R_normal_in_normalizer
      (∀ t u : d.space, ∀ ht : (t : G) ≠ 1, ∀ hu : (u : G) ≠ 1, t ≠ u →
        d.lineStabilizer t u = d.pointTransvections t ht ⊔ d.pointTransvections u hu) ∧
      (∀ t u : d.space, (t : G) ≠ 1 → (u : G) ≠ 1 → t ≠ u →
        ∀ a ∈ d.lineStabilizer t u, ∀ v : d.R ⧸ center d.R,
          v ∈ d.coreSection t.val ⊓ d.coreSection u.val →
            d.linearRadicalAction ht a v = v) ∧
      ∃ f : d.multiplicitySpace × (d.multiplicitySpace × d.multiplicitySpace) ≃*
          (d.R ⧸ center d.R),
        (∀ w, f (w,1,1) = (w : d.R ⧸ center d.R)) ∧
        (∀ a : d.S ⧸ d.R.subgroupOf d.S, ∀ u v w : d.multiplicitySpace,
          f (d.multiplicityAction ht a u,d.multiplicityAction ht a v,d.multiplicityAction ht a w) =
            d.SRadicalAction ht a (f (u,v,w))) ∧
        (∀ u v w : d.multiplicitySpace,
          d.linearRadicalAction ht d.markedShear (f (u,v,w)) = f (u,v,v*w)) ∧
        (∀ u v w : d.multiplicitySpace,
          d.linearRadicalAction ht (d.markedPermutation (Equiv.swap 0 1)) (f (u,v,w)) = f (u,w,v)) ∧
        (∀ u v w : d.multiplicitySpace,
          d.linearRadicalAction ht (d.markedPermutation (Equiv.swap 1 2)) (f (u,v,w)) = f (v,u,w)) := by
  let ht := D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot
  obtain ⟨cubic,X,⟨d⟩⟩ := source_three_space_data_exists ht
  refine ⟨cubic,X,d,?_,?_,d.exists_multiplicity_coordinates_root_actions ht⟩
  · intro t u ht1 hu1 htu
    exact d.lineStabilizer_eq_pointTransvections_sup ht t u ht1 hu1 htu
  · intro t u ht1 hu1 htu a ha v hv
    exact d.lineStabilizer_fixes_pairSection ht t u ht1 hu1 htu a ha v hv

end CFSG.Quasithin.Chapter12.Section02.ChosenModule
end
