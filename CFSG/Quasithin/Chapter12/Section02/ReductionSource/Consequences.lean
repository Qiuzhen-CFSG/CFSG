module
public import CFSG.Quasithin.Chapter12.Section02.ReductionSource.Fundamental
public import CFSG.Quasithin.Chapter3.Section02.ModuleConsequences
public import CFSG.Quasithin.Chapter3.Section02.ReducedOrbit
/-!
# Earlier FSU consequences on the original Section 12.2 choice

The same chosen V, not an independently selected constituent, is the seed of
the normalized Fundamental Setup. The genuine source A and C theorems give
the earlier uniqueness theorem, so its normalizer orbit is reduced and
commutator generated. If the actual relative centralizer is trivial, V is
TI under the original N_G(L). The trivial-centralizer condition is precisely
the relevant earlier branch; this file does not assert the full module list.
Source: Aschbacher--Smith, combined manuscript, 1 March 2004,
3.2.2(2)--(5), p.579, applied in Theorem 12.2.2, pp.794--795.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter12.Section02.ChosenModule
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  (D : ChosenModule T L V) (h : Hypothesis1221 KnownSimple.IsKnownSimple T L)
  (hA : ∀ (X : Type u) [Group X] [Finite X],
    ChapterA.Section02.TheoremA KnownSimple.IsKnownSimple X)
  (hC : ∀ (X : Type u) [Group X] [Finite X],
    ChapterA.Section02.TheoremC KnownSimple.IsKnownSimple X)
include D h hA hC

/-- The full normalizer orbit lies in the actual reduced-two family. -/
theorem normalizerOrbit_reduced :
    IsPReduced 2 ((componentOrbit V (normalizer (L : Set G))).subgroupOf
      (normalizer (L : Set G))) := by
  have hr := (D.fundamentalSetup h).fullModule_reduced_of_theoremsAC hA hC
  rw [D.fundamentalSetup_fullModule h] at hr
  change IsPReduced 2 ((componentOrbit V (normalizer (L : Set G))).subgroupOf
    (normalizer (Chapter3.Section02.localOrbit T L : Set G))) at hr
  rwa [D.localOrbit_eq] at hr

/-- The full original orbit is generated by L-commutators. -/
theorem normalizerOrbit_eq_commutator :
    componentOrbit V (normalizer (L : Set G)) =
      ⁅componentOrbit V (normalizer (L : Set G)), L⁆ := by
  have hr := (D.fundamentalSetup h).fullModule_eq_commutator
    (Chapter1.Section02.nonsolvable_uniqueness_of_theoremsAC hA hC
      h.simpleQTKE T h.maximal_faithful.1)
  rwa [D.fundamentalSetup_fullModule h, D.localOrbit_eq] at hr

/-- In the fixed-free source branch, the chosen V is TI under N_G(L). -/
theorem ti_of_centralizer_eq_bot
    (hc : V ⊓ centralizer (L : Set G) = ⊥) (g : G)
    (hg : g ∈ normalizer (L : Set G)) :
    V ⊓ V.map (MulAut.conj g).toMonoidHom = ⊥ ∨
      V.map (MulAut.conj g).toMonoidHom = V := by
  have hg' : g ∈ (D.fundamentalSetup h).maximalLocal := by
    change g ∈ normalizer (Chapter3.Section02.localOrbit T L : Set G)
    rwa [D.localOrbit_eq]
  have hc' : (D.fundamentalSetup h).seed ⊓
      centralizer (Chapter3.Section02.localOrbit T L : Set G) = ⊥ := by
    rwa [D.fundamentalSetup_seed h, D.localOrbit_eq]
  have hr := (D.fundamentalSetup h).seed_ti_under_maximalLocal
    (Chapter1.Section02.nonsolvable_uniqueness_of_theoremsAC hA hC
      h.simpleQTKE T h.maximal_faithful.1) hc' ⟨g, hg'⟩
  simpa only [D.fundamentalSetup_seed h] using hr
end CFSG.Quasithin.Chapter12.Section02.ChosenModule
