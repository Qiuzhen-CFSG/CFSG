module
public import CFSG.Quasithin.Chapter6.SourceReduction.RankOneModuleRecognitionIdentificationLocalSylowPair
public import CFSG.Quasithin.Chapter12.Section02.ReductionSource.RankOneModuleRecognitionIdentificationLocalCoreIdentification

/-!
# Chapter 12 original Sylow pair and ambient four-space action

The actual component Sylow has two maximum elementary subgroups: the
chosen-module layer and the original centralizer closure. Its normalizer
inside L preserves both. Thus the literal source L₀ generated by this
normalizer and C_G(z) acts on the same original sixteen.

Source: Aschbacher--Smith, 6.2.11, printed p.686. The later A₇ recognition
and construction of the contradictory H-star subgroup remain to be proved.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory
open scoped commutatorElement IsMulCommutative
open CFSG.Quasithin.Chapter6.Source CFSG.Quasithin.Chapter6.Source.RankOneRecognition
namespace CFSG.Quasithin.Chapter12.Section02.RankOneModule
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V : Subgroup G} {n : ℕ} {z : G}

/-- The original component Sylow's two maximum elementary subgroups. -/
theorem source_local_four_intersection_sylow_pair
    (D : ChosenModule T L V) (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (h611 : Hypothesis611 KnownSimple.IsKnownSimple T L
      (normalizer (L : Set G)) (wholeReduced T L) n)
    (hnatural : Conclusion6127 (T : Subgroup G) L
      (normalizer (L : Set G)) (wholeReduced T L) n)
    (hz : z ∈ ZS (T : Subgroup G) L (wholeReduced T L)) (ho : orderOf z = 2)
    (hT : (T : Subgroup G) ≤ centralizer ({z} : Set G))
    (hcard : Nat.card (commutatorLayer T L ⊓ (centralizer ({z} : Set G)).pCoreIn 2 : Subgroup G) = 4) :
    Stellmacher.elementaryAbelianMaxSubgroups ((T : Subgroup G) ⊓ L) =
      {sourceClosure (T : Subgroup G) L (wholeReduced T L) z, commutatorLayer T L} := by
  obtain ⟨hp, hNL⟩ := source_local_layer_normalizers D h h611 hnatural
  exact LocalQuotientAction.four_component_sylow_maximum_family h611 hnatural hz ho hT hp hNL hcard

/-- The actual overgroup in the source A₇ argument preserves the original closure. -/
theorem source_local_four_intersection_generated_action
    (D : ChosenModule T L V) (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (h611 : Hypothesis611 KnownSimple.IsKnownSimple T L
      (normalizer (L : Set G)) (wholeReduced T L) n)
    (hnatural : Conclusion6127 (T : Subgroup G) L
      (normalizer (L : Set G)) (wholeReduced T L) n)
    (hz : z ∈ ZS (T : Subgroup G) L (wholeReduced T L)) (ho : orderOf z = 2)
    (hT : (T : Subgroup G) ≤ centralizer ({z} : Set G))
    (hcard : Nat.card (commutatorLayer T L ⊓ (centralizer ({z} : Set G)).pCoreIn 2 : Subgroup G) = 4) :
    (L ⊓ normalizer (((T : Subgroup G) ⊓ L : Subgroup G) : Set G)) ⊔ centralizer ({z} : Set G) ≤
      normalizer (sourceClosure (T : Subgroup G) L (wholeReduced T L) z : Set G) := by
  obtain ⟨hp, hNL⟩ := source_local_layer_normalizers D h h611 hnatural
  exact LocalQuotientAction.four_generated_overgroup_normalizes_closure h611 hnatural hz ho hT hp hNL hcard

end CFSG.Quasithin.Chapter12.Section02.RankOneModule
