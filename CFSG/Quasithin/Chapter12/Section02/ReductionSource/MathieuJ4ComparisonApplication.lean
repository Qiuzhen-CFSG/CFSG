/-- The full kernel on the original Q/Z(Q), with an actual correcting
core element and the actual central twist, for the unchanged Mathieu inputs. -/
theorem sourceOrbit_m24_overlap_core_kernel
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1)
    (hquot : Nonempty (Recognition.JankoFour.CubicAutomorphismQuotient
      ((centralizer ({(z : G)} : Set G)) ⧸
        pCore 2 (centralizer ({(z : G)} : Set G)))))
    (data : SourceIncidence.LocalData
      (D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot))
    (f : MulAut (PlaneOverlap data))
    (hf : quotientAut (center (core (z : G))) (overlapCoreAut data f) = 1) :
    overlapPlaneTwist data ^ 2 = 1 ∧ overlapPlaneTwist data ≠ 1 ∧
      (∃ q : core (z : G),
        f = MulAut.conj (⟨q.val,(LocalGeometry.LocalSubgroups.core_le_twoThreeCore
          (D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot)).trans
          (overlap_cubicLift_le data) q.property⟩ : PlaneOverlap data) ∨
        f = MulAut.conj (⟨q.val,(LocalGeometry.LocalSubgroups.core_le_twoThreeCore
          (D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot)).trans
          (overlap_cubicLift_le data) q.property⟩ : PlaneOverlap data) * overlapPlaneTwist data) :=
  ⟨overlapPlaneTwist_sq data,overlapPlaneTwist_ne_one data,
    overlap_core_quotient_kernel data f hf⟩

/-- The original Mathieu overlap has a constructed inner/Todd reduction
with the same cubic fixed pointwise. Its remaining section action commutes
with all actual overlap actors; no automorphism classification is assumed. -/
theorem sourceOrbit_m24_overlap_module_reduction
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1)
    (hquot : Nonempty (Recognition.JankoFour.CubicAutomorphismQuotient
      ((centralizer ({(z : G)} : Set G)) ⧸
        pCore 2 (centralizer ({(z : G)} : Set G)))))
    (data : SourceIncidence.LocalData
      (D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot))
    (f : MulAut (PlaneOverlap data)) :
    ∃ (x : PlaneOverlap data) (b : MulAut (PlaneOverlap data)),
      (∀ y, overlapCoreProjection data (b y)=overlapCoreProjection data y) ∧
      (∀ y : overlapCubic data, b y.val=y.val) ∧
      (∀ y, Commute (overlapSectionAut data b) (overlapSectionAction data y)) ∧
      (overlapSectionAut data b=1 → b=1 ∨ b=overlapPlaneTwist data) ∧
      (f=MulAut.conj x*b ∨
        f=MulAut.conj x*planeOverlapToddTwist data (cubicFixedWord data)*b) :=
  overlap_automorphism_module_reduction data f

