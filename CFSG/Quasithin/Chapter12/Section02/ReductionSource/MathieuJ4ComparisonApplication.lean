    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1)
    (hquot : Nonempty (Recognition.JankoFour.CubicAutomorphismQuotient
      ((centralizer ({(z : G)} : Set G)) ⧸
        pCore 2 (centralizer ({(z : G)} : Set G)))))
    (data : SourceIncidence.LocalData
      (D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot))
    (cubic : CubicNormalizerData data)
    (native : SourceIncidence.LocalData model_isTypeJ4)
    (nativeCubic : CubicNormalizerData native) :
    let hJ := D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot
    letI := hJ.extraspecial
    letI := model_isTypeJ4.extraspecial
    ∃ (φ : cubicCentralizerInH data.e data.X ≃* cubicCentralizerInH native.e native.X)
      (ψ : core (z : G) ≃* core Janko4.a) (Φ : planeEven data.e ≃* planeEven native.e),
      (∀ c, cubicNativeProjection model_isTypeJ4 native.e native.X (φ c) =
        cubicNativeProjection hJ data.e data.X c) ∧
      φ (cubicMarker data.e data.X) = cubicMarker native.e native.X ∧
      (∀ q, Additive.ofMul (QuotientGroup.mk' (center (core Janko4.a)) (ψ q)) =
        coreSpaceComparison hJ data.e data.X model_isTypeJ4 native.e native.X
          (Additive.ofMul (QuotientGroup.mk' (center (core (z : G))) q))) ∧
      ψ (coreMarker hJ) = coreMarker model_isTypeJ4 ∧
      (∀ q : core (z : G), ∀ hq : q.val ∈ planeEven data.e,
        (Φ ⟨q.val,hq⟩ : Recognition.JankoFour.centralizer Janko4.a) = ψ q) ∧
      ∀ c : cubicCentralizerInH data.e data.X, ∀ hc : c.val ∈ planeEven data.e,
        (Φ ⟨c.val,hc⟩ : Recognition.JankoFour.centralizer Janko4.a) = (φ c).val := by
  let hJ := D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot
  let := hJ.extraspecial
  let := model_isTypeJ4.extraspecial
  exact exists_planeEven_equiv hJ data.e data.X model_isTypeJ4 native.e native.X
    cubic.perfect nativeCubic.perfect

/-- The two source automorphisms on the original marked plane and point groups. -/
theorem sourceOrbit_m24_overlap_twists
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1)
    (hquot : Nonempty (Recognition.JankoFour.CubicAutomorphismQuotient
      ((centralizer ({(z : G)} : Set G)) ⧸
        pCore 2 (centralizer ({(z : G)} : Set G)))))
    (data : SourceIncidence.LocalData
      (D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot))
    (cubic : CubicNormalizerData data) :
    let hJ := D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot
    orderOf (planeTwist hJ data.e) = 2 ∧
      (¬ ∃ x : Recognition.JankoFour.centralizer (z : G), planeTwist hJ data.e = MulAut.conj x) ∧
      (∀ q : core (z : G), planeTwist hJ data.e q.val = q.val) ∧
      (data.P.M.subgroupOf (Recognition.JankoFour.centralizer (z : G))).map
          (planeTwist hJ data.e).toMonoidHom =
        data.P.M.subgroupOf (Recognition.JankoFour.centralizer (z : G)) ∧
      planeEven data.e = pResidual 2 (Recognition.JankoFour.centralizer (z : G)) ∧
      orderOf (pointTwist data toddOddWord) = 2 ∧
      (¬ ∃ m : data.P.M, pointTwist data toddOddWord = MulAut.conj m) ∧
      (∀ m, data.P.projection (pointTwist data toddOddWord m) = data.P.projection m) ∧
      (pointTwist data toddOddWord ⟨(z : G),marker_mem_point data⟩ : G) = z ∧
      ((Recognition.JankoFour.centralizer (z : G)).subgroupOf data.P.M).map
          (pointTwist data toddOddWord).toMonoidHom =
        (Recognition.JankoFour.centralizer (z : G)).subgroupOf data.P.M := by
  let hJ := D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot
  exact ⟨orderOf_eq_prime (planeTwist_sq hJ data.e) (planeTwist_ne_one hJ data.e),
    planeTwist_not_inner hJ data.e,planeTwist_fixes_core hJ data.e,
    planeTwist_point_overlap hJ data,
    planeEven_eq_twoResidual hJ data.e data.X cubic.perfect,
    pointOddTwist_order data,pointOddTwist_not_inner data,
    pointTwist_projection data toddOddWord,pointTwist_marker data toddOddWord,
    pointTwist_overlap data toddOddWord⟩

/-- Compare the actual plane central quotients in the original Mathieu branch.
