/-- Both original local maps are constructed and agree on every ambient
intersection element. The plane map retains its six-cover restriction and
both central attachments; the point map retains its literal M24 quotient.
The full edge-reversal equation is a further Section 8 obligation. -/
theorem sourceOrbit_m24_compatible_local_comparison
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1)
    (hquot : Nonempty (Recognition.JankoFour.CubicAutomorphismQuotient
      ((centralizer ({(z : G)} : Set G)) ⧸
        pCore 2 (centralizer ({(z : G)} : Set G)))))
    (data : SourceIncidence.LocalData
      (D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot))
    (cubic : CubicNormalizerData data)
    (native : SourceIncidence.LocalData model_isTypeJ4)
    (nativeCubic : CubicNormalizerData native) :
    let hJ := D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot
    ∃ (C : cubicCentralizerInH data.e data.X ≃* cubicCentralizerInH native.e native.X)
      (n : cubicNormalizerInH native.e native.X) (g : M24)
      (φM : data.P.M ≃* native.P.M)
      (φH : Recognition.JankoFour.centralizer (z : G) ≃* Recognition.JankoFour.centralizer Janko4.a),
      (∀ c, cubicNativeProjection model_isTypeJ4 native.e native.X (C c)=
        cubicNativeProjection hJ data.e data.X c) ∧
      φH planeMarker=planeMarker ∧
      (∀ c : cubicCentralizerInH data.e data.X,
        φH c.val=(cubicNormalizerAction native.e native.X n (C c)).val) ∧
      (core (z : G)).map φH.toMonoidHom=core Janko4.a ∧
      (cubicSylowImage data.e data.X).map φH.toMonoidHom=cubicSylowImage native.e native.X ∧
      (∀ m, native.P.projection (φM m)=g*data.P.projection m*g⁻¹) ∧
      (∀ (k : G) (hkM : k ∈ data.P.M) (hkH : k ∈ Recognition.JankoFour.centralizer (z : G)),
        (φM ⟨k,hkM⟩ : Janko4.Model)=(φH ⟨k,hkH⟩ : Janko4.Model)) :=
  exists_compatible_local_equivs data native cubic nativeCubic

/-- The actual earlier-source Input supplies its original edge. Construct
an outer Todd correction preserving its entire pointwise edge fixer, with
the cubic normalizer formula and original embeddings retained. -/
theorem sourceOrbit_m24_edge_preserving_correction
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1)
    (hquot : Nonempty (Recognition.JankoFour.CubicAutomorphismQuotient
      ((centralizer ({(z : G)} : Set G)) ⧸
        pCore 2 (centralizer ({(z : G)} : Set G)))))
    (data : SourceIncidence.LocalData
      (D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot))
    : let c := D.sourceOrbit_m24_source_input h hmany hV hq hnon a E hE z hz hne hquot data
    ∃ (Y : Sylow 3 (lineCentralPoint data)) (w : Full) (v : Cocode),
      let U := (Y : Subgroup (lineCentralPoint data)).map (lineCentralPoint data).subtype
      w ∉ Core ∧
      pointTwist data w=MulAut.conj (data.P.toddEquiv (SemidirectProduct.inl (Multiplicative.ofAdd v))) *
        pointTwist data toddOddWord ∧
      pointTwist data w ^ 2=1 ∧
      (∀ u : U.subgroupOf data.P.M, pointTwist data w u.val=u.val) ∧
      (¬ ∃ x : pointOverlap data, overlapToddTwist data w=MulAut.conj x) ∧
      c.system.edgeGroup.subgroupOf data.P.M = data.d.K.subgroupOf data.P.M ⊔
        (data.d.S.subgroupOf data.P.M ⊓ normalizer (U.subgroupOf data.P.M : Set data.P.M)) ∧
      (c.system.edgeGroup.subgroupOf data.P.M).map (pointTwist data w).toMonoidHom =
        c.system.edgeGroup.subgroupOf data.P.M := by
  let c := D.sourceOrbit_m24_source_input h hmany hV hq hnon a E hE z hz hne hquot data
  have hedge : c.system.edgeGroup=lineEdgeGroup data c.t :=
    LocalGeometry.edgeGroup_eq (z : G) c.P.M c.t c.t_plane c.t_not_point c.t_sq
      c.faithful c.generate c.vertex_maximal c.plane_maximal c.edge_fixer
  change ∃ (Y : Sylow 3 (lineCentralPoint data)) (w : Full) (v : Cocode), _
  rw [hedge]
  exact exists_edge_preserving_Todd_twist data c.t c.t_line c.t_not_point

