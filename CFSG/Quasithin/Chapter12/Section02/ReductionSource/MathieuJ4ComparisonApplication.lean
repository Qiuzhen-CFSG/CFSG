/-- The literal six-cover comparison for the unchanged marked Mathieu inputs. -/
theorem sourceOrbit_m24_cubicCentralizer_comparison
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1)
    (hquot : Nonempty (Recognition.JankoFour.CubicAutomorphismQuotient
      ((centralizer ({(z : G)} : Set G)) ⧸
        pCore 2 (centralizer ({(z : G)} : Set G)))))
    (data : SourceIncidence.LocalData
      (D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot))
    (cubic : CubicNormalizerData data)
    (native : SourceIncidence.LocalData model_isTypeJ4)
    (nativeCubic : CubicNormalizerData native) :
    ∃ φ : cubicCentralizerInH data.e data.X ≃* cubicCentralizerInH native.e native.X,
      (∀ x, SourceComparison.cubicCentralizerProjection model_isTypeJ4 native.e native.X (φ x) =
        SourceComparison.cubicCentralizerProjection
          (D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot) data.e data.X x) ∧
      ((cubicSylowImage data.e data.X).subgroupOf (cubicCentralizerInH data.e data.X)).map
          φ.toMonoidHom =
        (cubicSylowImage native.e native.X).subgroupOf (cubicCentralizerInH native.e native.X) ∧
      φ (cubicMarker data.e data.X) = cubicMarker native.e native.X ∧
      cubicNormalizerInH data.e data.X = cubicCentralizerInH data.e data.X ⊔ zpowers cubic.s ∧
      cubicNormalizerInH native.e native.X = cubicCentralizerInH native.e native.X ⊔
        zpowers nativeCubic.s := by
  let hJ := D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot
  obtain ⟨φ,hφ,hscalar,hmarker⟩ := exists_cubicCentralizer_equiv hJ data.e data.X cubic.perfect
    model_isTypeJ4 native.e native.X nativeCubic.perfect
  exact ⟨φ,hφ,hscalar,hmarker,
    cubicNormalizer_eq_sup hJ data.e data.X cubic.s cubic.s_mem cubic.s_not_mem cubic.s_sq,
    cubicNormalizer_eq_sup model_isTypeJ4 native.e native.X nativeCubic.s
      nativeCubic.s_mem nativeCubic.s_not_mem nativeCubic.s_sq⟩

/-- The actual point groups are compared with the same sextet and cocode
marking; the plane overlap is carried as a literal embedded subgroup. -/
theorem sourceOrbit_m24_point_comparison
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1)
    (hquot : Nonempty (Recognition.JankoFour.CubicAutomorphismQuotient
      ((centralizer ({(z : G)} : Set G)) ⧸
        pCore 2 (centralizer ({(z : G)} : Set G)))))
    (data : SourceIncidence.LocalData
      (D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot))
    (native : SourceIncidence.LocalData model_isTypeJ4) :
    ∃ (g : M24) (φ : data.P.M ≃* native.P.M),
      g • data.sextet.parts = native.sextet.parts ∧
      (∀ m, native.P.projection (φ m) = g * data.P.projection m * g⁻¹) ∧
      (φ ⟨(z : G),marker_mem_point data⟩ : Janko4.Model) = Janko4.a ∧
      ((Recognition.JankoFour.centralizer (z : G)).subgroupOf data.P.M).map φ.toMonoidHom =
        (Recognition.JankoFour.centralizer Janko4.a).subgroupOf native.P.M :=
  exists_point_equiv data native

/-- A single Todd conjugator aligns the actual trio and sextet and all three
point overlaps, with the original cocode marker retained. -/
theorem sourceOrbit_m24_point_flag_comparison
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1)
    (hquot : Nonempty (Recognition.JankoFour.CubicAutomorphismQuotient
      ((centralizer ({(z : G)} : Set G)) ⧸
        pCore 2 (centralizer ({(z : G)} : Set G)))))
    (data : SourceIncidence.LocalData
      (D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot))
    (native : SourceIncidence.LocalData model_isTypeJ4) :
    ∃ (g : M24) (φ : data.P.M ≃* native.P.M),
      g • data.trio.parts = native.trio.parts ∧
      g • data.sextet.parts = native.sextet.parts ∧
      (∀ m, native.P.projection (φ m) = g * data.P.projection m * g⁻¹) ∧
      (φ ⟨(z : G),marker_mem_point data⟩ : Janko4.Model) = Janko4.a ∧
      ((Recognition.JankoFour.centralizer (z : G)).subgroupOf data.P.M).map φ.toMonoidHom =
        (Recognition.JankoFour.centralizer Janko4.a).subgroupOf native.P.M ∧
      (data.L.G₂.subgroupOf data.P.M).map φ.toMonoidHom = native.L.G₂.subgroupOf native.P.M ∧
      ((Recognition.JankoFour.centralizer (z : G) ⊓ data.L.G₂).subgroupOf data.P.M).map
          φ.toMonoidHom =
        (Recognition.JankoFour.centralizer Janko4.a ⊓ native.L.G₂).subgroupOf native.P.M :=
  exists_point_flag_equiv data native

/-- The actual six-cover comparison intertwines every original normalizer actor. -/
theorem sourceOrbit_m24_cubicNormalizer_actions
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1)
    (hquot : Nonempty (Recognition.JankoFour.CubicAutomorphismQuotient
      ((centralizer ({(z : G)} : Set G)) ⧸
        pCore 2 (centralizer ({(z : G)} : Set G)))))
    (data : SourceIncidence.LocalData
      (D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot))
    (cubic : CubicNormalizerData data)
    (native : SourceIncidence.LocalData model_isTypeJ4)
    (nativeCubic : CubicNormalizerData native) :
    ∃ φ : cubicCentralizerInH data.e data.X ≃* cubicCentralizerInH native.e native.X,
      (∀ c, SourceComparison.cubicCentralizerProjection model_isTypeJ4 native.e native.X (φ c) =
        SourceComparison.cubicCentralizerProjection
          (D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot) data.e data.X c) ∧
      ((cubicSylowImage data.e data.X).subgroupOf (cubicCentralizerInH data.e data.X)).map
        φ.toMonoidHom = (cubicSylowImage native.e native.X).subgroupOf
          (cubicCentralizerInH native.e native.X) ∧
      φ (cubicMarker data.e data.X) = cubicMarker native.e native.X ∧
      (∀ n : cubicNormalizerInH data.e data.X, ∃ n' : cubicNormalizerInH native.e native.X,
        cubicNormalizerProjection native.e native.X n' = cubicNormalizerProjection data.e data.X n ∧
        ∀ c, φ (cubicNormalizerAction data.e data.X n c) =
          cubicNormalizerAction native.e native.X n' (φ c)) :=
  exists_cubicCentralizer_equiv_equivariant
    (D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot)
    data.e data.X cubic.perfect model_isTypeJ4 native.e native.X nativeCubic.perfect

/-- The comparison uses the same native six-cover and quadratic core-module markings. -/
theorem sourceOrbit_m24_cubicCore_comparison
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1)
    (hquot : Nonempty (Recognition.JankoFour.CubicAutomorphismQuotient
      ((centralizer ({(z : G)} : Set G)) ⧸
        pCore 2 (centralizer ({(z : G)} : Set G)))))
    (data : SourceIncidence.LocalData
      (D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot))
    (cubic : CubicNormalizerData data)
    (native : SourceIncidence.LocalData model_isTypeJ4)
    (nativeCubic : CubicNormalizerData native) :
    let hJ := D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot
    letI := hJ.extraspecial
    letI := model_isTypeJ4.extraspecial
    ∃ φ : cubicCentralizerInH data.e data.X ≃* cubicCentralizerInH native.e native.X,
      (∀ c, cubicNativeProjection model_isTypeJ4 native.e native.X (φ c) =
        cubicNativeProjection hJ data.e data.X c) ∧
      φ (cubicMarker data.e data.X) = cubicMarker native.e native.X ∧
      (∀ c, QuotientGroup.mk' (core Janko4.a) (φ c).val =
        coreQuotientComparison hJ data.e data.X model_isTypeJ4 native.e native.X
          (QuotientGroup.mk' (core (z : G)) c.val)) ∧
      (∀ c v, coreSpaceComparison hJ data.e data.X model_isTypeJ4 native.e native.X
        (coreBinaryRepresentation hJ (QuotientGroup.mk' (core (z : G)) c.val) v) =
          coreBinaryRepresentation model_isTypeJ4 (QuotientGroup.mk' (core Janko4.a) (φ c).val)
            (coreSpaceComparison hJ data.e data.X model_isTypeJ4 native.e native.X v)) := by
  let hJ := D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot
  let := hJ.extraspecial
  let := model_isTypeJ4.extraspecial
  exact exists_cubicCentralizer_equiv_core hJ data.e data.X cubic.perfect
    model_isTypeJ4 native.e native.X nativeCubic.perfect

/-- The original extraspecial core and perfect six-cover are compared together,
with full six-cover equivariance and both central involutions retained. -/
theorem sourceOrbit_m24_cubicCoreGroup_comparison
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hmany : 1 < (maximalTwoLocalOvergroups (T : Subgroup G)).ncard)
    (hV : V = D.sourceOrbit)
    (hq : Nonempty ((D.orbitComponent ⧸ center D.orbitComponent) ≃* M24))
    (hnon : ¬ IsFFModule D.sourceOrbitNormalizerRepresentation)
    (a : Automizer D.sourceOrbit ≃* M24)
    (E : Additive D.sourceOrbit ≃ₗ[ZMod 2] Cocode)
    (hE : ∀ b v, E (automizerRepresentation D.sourceOrbit b v) =
      cocodeRepresentation (a b) (E v))
    (z : D.sourceOrbit) (hz : (z : G) ∈ centralizer (T : Set G)) (hne : z ≠ 1)
    (hquot : Nonempty (Recognition.JankoFour.CubicAutomorphismQuotient
      ((centralizer ({(z : G)} : Set G)) ⧸
        pCore 2 (centralizer ({(z : G)} : Set G)))))
    (data : SourceIncidence.LocalData
      (D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot))
    (cubic : CubicNormalizerData data)
    (native : SourceIncidence.LocalData model_isTypeJ4)
    (nativeCubic : CubicNormalizerData native) :
    let hJ := D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot
    letI := hJ.extraspecial
    letI := model_isTypeJ4.extraspecial
    ∃ (φ : cubicCentralizerInH data.e data.X ≃* cubicCentralizerInH native.e native.X)
      (ψ : core (z : G) ≃* core Janko4.a),
      (∀ c, cubicNativeProjection model_isTypeJ4 native.e native.X (φ c) =
        cubicNativeProjection hJ data.e data.X c) ∧
      φ (cubicMarker data.e data.X) = cubicMarker native.e native.X ∧
      (∀ q, Additive.ofMul (QuotientGroup.mk' (center (core Janko4.a)) (ψ q)) =
        coreSpaceComparison hJ data.e data.X model_isTypeJ4 native.e native.X
          (Additive.ofMul (QuotientGroup.mk' (center (core (z : G))) q))) ∧
      ψ (coreMarker hJ) = coreMarker model_isTypeJ4 ∧
      ∀ c : cubicCentralizerInH data.e data.X, ∀ q : core (z : G),
        ψ (MulAut.conjNormal c.val q) = MulAut.conjNormal (φ c).val (ψ q) := by
  let hJ := D.sourceOrbit_m24_isTypeJ4 h hmany hV hq hnon a E hE z hz hne hquot
  let := hJ.extraspecial
  let := model_isTypeJ4.extraspecial
  exact exists_cubic_coreGroup_equiv hJ data.e data.X model_isTypeJ4 native.e native.X
    cubic.perfect nativeCubic.perfect

/-- Glue the original core and six-cover comparisons to O²(H), preserving
the literal subgroup restrictions and native quotient coordinates. -/
