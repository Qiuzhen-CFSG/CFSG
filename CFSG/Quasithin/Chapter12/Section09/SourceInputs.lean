/-!
# Independent source obligations for the larger binary linear rows

The two natural reductions are the conclusions of 12.5.1 and 12.6.34 on
all original chosen modules. The natural branch keeps the preference for
n=5 from the opening of 12.9: when n=4, no maximal faithful member with
PSL₅(2) quotient is available. Final assembly proves the n=5 exclusion
first and supplies it to the n=4 branch.

The terminal configuration records the actual H, its S₃ core quotient and
a moving conjugate of the unchanged seed. Its existence is an obligation,
not part of Hypothesis 12.8.1. The natural-branch input also retains the
separate abelian point-span and Sylow hyperplane conclusions. The theorem
below applies the proved terminal argument to those inputs; it does not
assert that the source inputs have been constructed.

Source: Aschbacher--Smith, 12.5.1, 12.6.34 and 12.9.1--9,
printed pp.816--838 and857--864.
-/

@[expose] public section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter12.Section09
open Section02 Section08 Section08.InvariantFlag
universe u

/-- The natural-module reduction for a specified quotient degree. For d=5
this is 12.5.1; for d=4 it is the core-quotient form of 12.6.34. -/
def NaturalReduction (K : GroupClass.{u}) (d : ℕ) : Prop :=
  ∀ (X : Type u) [Group X] [Finite X] (T : Sylow 2 X) (L V : Subgroup X),
    Hypothesis1223 K T L → (D : ChosenModule T L V) →
      ClassicalGroup.IsPSL (L ⧸ pCore 2 L) d 2 → NaturalModule D d

/-- The prioritized choice used in 12.9.2. This is vacuous when n=5.
The final assembly, not the original source hypothesis, supplies it for n=4. -/
def PreferredDimension {G : Type u} [Group G] [Finite G]
    (K : GroupClass.{u}) (T : Sylow 2 G) (n : ℕ) : Prop :=
  n = 4 → ∀ I : Subgroup G, Hypothesis1223 K T I →
    ¬ ClassicalGroup.IsPSL (I ⧸ pCore 2 I) 5 2

variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G}
  {L V : Subgroup G} {n : ℕ}

/-- The actual subgroup and moving conjugate constructed on pp.863--864.
The plane span is a fixed expression, not an arbitrary auxiliary module. -/
structure TerminalConfiguration (F : InvariantFlag T V n) (L : Subgroup G) where
  H : Subgroup G
  sylow_le : (T : Subgroup G) ≤ H
  point_le : H ≤ F.H
  quotient : Nonempty ((H ⧸ pCore 2 H) ≃* Equiv.Perm (Fin 3))
  g : G
  conjugate_le : conjugate V g ≤ H
  span_normalizes : conjugateSpanBy (F.Vi 2) H ≤ normalizer (conjugate V g : Set G)
  moves_plane : ¬ conjugate V g ≤ normalizer (F.Vi 2 : Set G)
  hyperplane_normalizes : conjugate V g ⊓ normalizer (L : Set G) ≤ normalizer (V : Set G)
  hyperplane_index : (conjugate V g ⊓ normalizer (L : Set G)).relIndex (conjugate V g) = 2

/-- The remaining natural-module branch, with the earlier universal results
and the four-dimensional natural reduction explicit. Its conclusion must
be constructed by the local and fusion proofs, not supplied as a record
projection from the original hypotheses. -/
def NaturalBranchInput (K : GroupClass.{u}) : Prop :=
  ∀ (X : Type u) [Group X] [Finite X] (T : Sylow 2 X) (L V : Subgroup X) (n : ℕ),
    HigherRankHypothesis K T L V n → n = 4 ∨ n = 5 →
    PreferredDimension K T n → EarlierSetupResults K → NaturalReduction K 4 →
      ∃ F : InvariantFlag T V n, IsMulCommutative F.U ∧
        SylowHyperplaneControl T L V ∧ Nonempty (TerminalConfiguration F L)

/-- Conditional natural-branch assembly. In particular, the local source
producer must still prove NaturalBranchInput before this excludes any row. -/
theorem natural_branch_contradiction {K : GroupClass.{u}}
    (source : NaturalBranchInput K) (earlier : EarlierSetupResults K)
    (four : NaturalReduction K 4) (h : HigherRankHypothesis K T L V n)
    (hn : n = 4 ∨ n = 5) (preferred : PreferredDimension K T n) : False := by
  obtain ⟨F, hab, hyperplanes, ⟨d⟩⟩ := source G T L V n h hn preferred earlier four
  exact terminal_contradiction_of_sylow_hyperplanes h earlier F hab hyperplanes
    d.H d.point_le d.g d.conjugate_le d.span_normalizes d.moves_plane
    d.hyperplane_normalizes d.hyperplane_index

end CFSG.Quasithin.Chapter12.Section09
