module

public import CFSG.Quasithin.ChapterF.Section09.Basic
public import CFSG.Quasithin.Chapter1.Defs
public import Theory.Representation.BinaryPermutation.TerminalOrthogonal.EightCoordinates

/-!
# Marked six-dimensional data for the nonabelian case of Section 12.6

The coordinate map is an actual group isomorphism to the additive natural
six-dimensional section of the eight-point binary permutation module. The
point line is generated by the marked element, and its perpendicular is
computed with the polar form of the half-weight quadratic form. Both
conjugate spans and the two-core are subgroups of the original ambient group.
No irreducibility, kernel bound, or abelianness of a conjugate span is part
of these definitions.

Source: Aschbacher–Smith, combined manuscript (1 March 2004), the setup
preceding Lemma 12.6.24, printed p.830.
-/

@[expose] public section
open Subgroup
namespace CFSG.Quasithin.Chapter12.Section06.Nonabelian
variable (G : Type*) [Group G]

/-- Marked coordinates, with the source's actual point inside V. Action
compatibility and the earlier section hypotheses are separate proof inputs. -/
structure Setup where
  T : Sylow 2 G
  L : Subgroup G
  M : Subgroup G
  V : Subgroup G
  coordinates : V ≃* Multiplicative (BinaryPermutation.natural (Fin 8))
  z : V

namespace Setup
variable {G} (D : Setup G)

def V₁ : Subgroup G := zpowers D.z.val

/-- The literal perpendicular to the point line in the marked six-space. -/
noncomputable def V₅ : Subgroup G :=
  (((BinaryPermutation.TerminalOrthogonal.Eight.form.polarBilin
    (D.coordinates D.z).toAdd).ker.toAddSubgroup.toSubgroup').map
      D.coordinates.symm.toMonoidHom).map D.V.subtype

def Gz : Subgroup G := centralizer (D.V₁ : Set G)
def G₅ : Subgroup G := normalizer (D.V₅ : Set G)
def LT : Subgroup G := D.L ⊔ (D.T : Subgroup G)
noncomputable def L₁ : Subgroup G :=
  (pResidual 2 (D.L ⊓ D.Gz : Subgroup G)).map (D.L ⊓ D.Gz).subtype

/-- The actual source family: membership in H(L₁T) includes a nontrivial
intrinsic two-core, not merely containment of L₁T. -/
noncomputable def Hz : Set (Subgroup G) :=
  {H | H ∈ Chapter1.HOver G (D.L₁ ⊔ (D.T : Subgroup G) : Set G) ∧
    H ≤ D.Gz ∧ ¬ H ≤ D.M}

noncomputable def R₁ : Subgroup G := (D.L₁ ⊔ (D.T : Subgroup G)).pCoreIn 2

def QH (H : Subgroup G) : Subgroup G := H.pCoreIn 2
noncomputable def UH (H : Subgroup G) : Subgroup G := conjugateSpanBy D.V₅ H
def VH (H : Subgroup G) : Subgroup G := conjugateSpanBy D.V H

/-- The star quotient uses the intrinsic two-core of H. -/
abbrev Hstar (H : Subgroup G) := H ⧸ pCore 2 H

def star (H A : Subgroup G) : Subgroup (Hstar H) :=
  (A.subgroupOf H).map (QuotientGroup.mk' (pCore 2 H))

/-- The exact F.9 tuple, with V₊ = V₁-perpendicular. Its Hypothesis record
is a conclusion still to be constructed by the amalgam argument. -/
noncomputable def f9 (H : Subgroup G) : ChapterF.Section09.Setup G :=
  ⟨D.T, D.L, D.V, D.V₅, D.V₁, H⟩

/-- Elementarity follows from the actual coordinates. -/
theorem elementary : IsElementaryAbelian 2 D.V := by
  refine {
    toIsMulCommutative := ⟨⟨fun x y => D.coordinates.injective ?_⟩⟩
    exponent_dvd_p := ?_ }
  · simp only [map_mul, mul_comm]
  · apply Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr
    intro x
    apply D.coordinates.injective
    rw [map_pow, map_one]
    apply Multiplicative.toAdd.injective
    change 2 • (D.coordinates x).toAdd = 0
    rw [← Nat.cast_smul_eq_nsmul (ZMod 2),
      ZMod.natCast_self, zero_smul]

theorem V₅_le : D.V₅ ≤ D.V := map_subtype_le _

/-- Membership in the perpendicular uses the actual marked coordinates. -/
theorem mem_V₅_iff (v : D.V) :
    v.val ∈ D.V₅ ↔ BinaryPermutation.TerminalOrthogonal.Eight.form.polarBilin
      (D.coordinates D.z).toAdd (D.coordinates v).toAdd = 0 := by
  constructor
  · rintro ⟨w, ⟨a, ha, he⟩, hw⟩
    have hw' : w = v := Subtype.ext hw
    have hae : D.coordinates.symm a = v := he.trans hw'
    have he' : a = D.coordinates v := by
      simpa only [D.coordinates.apply_symm_apply] using congrArg D.coordinates hae
    change BinaryPermutation.TerminalOrthogonal.Eight.form.polarBilin
      (D.coordinates D.z).toAdd a.toAdd = 0 at ha
    rwa [he'] at ha
  · intro hv
    exact ⟨v, ⟨D.coordinates v, hv, D.coordinates.symm_apply_apply v⟩, rfl⟩

/-- In characteristic two the point line lies in its perpendicular. -/
theorem V₁_le_V₅ : D.V₁ ≤ D.V₅ := by
  apply zpowers_le.mpr
  apply (D.mem_V₅_iff D.z).mpr
  rw [QuadraticMap.polarBilin_apply_apply, QuadraticMap.polar_self]
  simp [nsmul_eq_mul]

/-- A nonidentity marked point is the source involution. -/
theorem point_card (hz : D.z ≠ 1) : Nat.card D.V₁ = 2 := by
  let : IsElementaryAbelian 2 D.V := D.elementary
  change Nat.card (zpowers D.z.val) = 2
  rw [Nat.card_zpowers]
  exact orderOf_eq_prime (elemPow_eq_one_of_isElementaryAbelian D.z.val D.z.property)
    (fun he => hz (Subtype.ext he))

/-- The ambient point centralizer is exactly C_G(z). -/
theorem Gz_eq : D.Gz = centralizer ({D.z.val} : Set G) := by
  change centralizer (zpowers D.z.val : Set G) = _
  rw [zpowers_eq_closure, centralizer_closure]

end Setup
end CFSG.Quasithin.Chapter12.Section06.Nonabelian
