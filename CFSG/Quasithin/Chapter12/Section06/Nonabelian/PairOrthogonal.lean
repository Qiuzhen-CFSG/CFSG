module
public import CFSG.Quasithin.ChapterF.Section09.ConjugatePair.Action
public import Theory.GroupTheory.ExtraspecialSquare

/-!
# The square-action generators of an original F.9 pair

Choose an element outside the index-two seed and use its given conjugate
for the second generator. The two seeds act by inner automorphisms on their
extraspecial join, hence trivially on its central quotient. The pair image
is therefore generated by those two involutions. Each displacement lifts
to the corresponding elementary seed, so it is singular for the square form.

The extraspeciality premise is constructed and discharged in
NaturalSource.PairOrthogonal. The statement retains the same original
element and its literal conjugate, rather than only naming a group family.
Source: Aschbacher--Smith F.9.5(5--6.ii), printed pp.319--320.
-/

public section
namespace CFSG.Quasithin.Chapter12.Section06.Nonabelian
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative commutatorElement
open ChapterF.Section09.Setup.Hypothesis
variable {G : Type*} [Group G] [Finite G] {D : ChapterF.Section09.Setup G}

/-- The original pair is generated by two involutions whose displacements
are singular for the square form on the actual extraspecial seed quotient. -/
theorem pair_square_generators (h : D.Hypothesis)
    (hi : D.Vplus.relIndex D.V = 2)
    (g : G) (hg : g ∈ D.H)
    (hn : ¬ IsPGroup 2 (D.V ⊔ D.V.map (MulAut.conj g).toMonoidHom : Subgroup G))
    (hs : IsExtraspecial 2 (D.Vplus ⊔ D.Vplus.map (MulAut.conj g).toMonoidHom : Subgroup G)) :
    let I := D.V ⊔ D.V.map (MulAut.conj g).toMonoidHom
    let P := D.Vplus ⊔ D.Vplus.map (MulAut.conj g).toMonoidHom
    let := hs
    let n := h.pair_normalizes_seed_join hi g hg hn
    let α := (ExtraspecialSquare.isometryAction P).comp (seedConjugation I P n)
    ∃ a b : (ExtraspecialSquare.form P).isometrySubgroup, a^2=1 ∧ b^2=1 ∧
      (∀ v, ExtraspecialSquare.form P (a.val v-v)=0) ∧
      (∀ v, ExtraspecialSquare.form P (b.val v-v)=0) ∧
      α.range = zpowers a ⊔ zpowers b ∧
      ∃ v : D.V, v.val ∉ D.Vplus ∧
        a = α ⟨v.val,mem_sup_left v.property⟩ ∧
        b = α ⟨(MulAut.conj g) v.val,
          mem_sup_right (mem_map_of_mem (MulAut.conj g).toMonoidHom v.property)⟩ := by
  dsimp only
  let := h.elementary
  let f := (MulAut.conj g).toMonoidHom
  let I := D.V ⊔ D.V.map f
  let P := D.Vplus ⊔ D.Vplus.map f
  let : IsExtraspecial 2 P := hs
  have hVI : D.V ≤ I := le_sup_left
  have hBI : D.V.map f ≤ I := le_sup_right
  let n := h.pair_normalizes_seed_join hi g hg hn
  let α := (ExtraspecialSquare.isometryAction P).comp (seedConjugation I P n)
  have hvn : ¬ D.V ≤ D.Vplus := by
    intro hv
    have he : D.Vplus = D.V := le_antisymm h.plus_le hv
    rw [he,relIndex_self] at hi
    omega
  obtain ⟨v,hv,hvn⟩ := Set.not_subset.mp hvn
  let a : I := ⟨v,hVI hv⟩
  let b : I := ⟨f v,hBI (mem_map_of_mem f hv)⟩
  have hbn : f v ∉ D.Vplus.map f := by
    rintro ⟨w,hw,he⟩
    exact hvn ((MulAut.conj g).injective he ▸ hw)
  have hseedAll : P.subgroupOf I ≤ α.ker := by
    intro x hx
    apply (ExtraspecialSquare.isometryAction_eq_one_iff P _).mpr
    ext u
    obtain ⟨p,rfl⟩ := QuotientGroup.mk'_surjective (center P) u
    rw [quotientAut_apply_mk]
    apply QuotientGroup.eq_iff_div_mem.mpr
    have hh : seedConjugation I P n x p / p = ⁅(⟨x,hx⟩ : P),p⁆ := by
      apply Subtype.ext
      simp only [div_eq_mul_inv,commutatorElement_def]
      rfl
    rw [hh]
    exact ExtraspecialSquare.commutator_mem_center P _ _
  have hseed : (D.Vplus.subgroupOf I) ≤ α.ker :=
    (subgroupOf_mono I (show D.Vplus ≤ P from le_sup_left)).trans hseedAll
  have hseedg : ((D.Vplus.map f).subgroupOf I) ≤ α.ker :=
    (subgroupOf_mono I (show D.Vplus.map f ≤ P from le_sup_right)).trans hseedAll
  have haimage : (D.V.subgroupOf I).map α = zpowers (α a) :=
    image_eq_zpowers_of_index_two (D.V.subgroupOf I) (D.Vplus.subgroupOf I) α
      (subgroupOf_mono I h.plus_le) (by rw [relIndex_subgroupOf hVI];exact hi) hseed a hv hvn
  have hbimage : ((D.V.map f).subgroupOf I).map α = zpowers (α b) :=
    image_eq_zpowers_of_index_two ((D.V.map f).subgroupOf I) ((D.Vplus.map f).subgroupOf I) α
      (subgroupOf_mono I (map_mono h.plus_le))
      (by rw [relIndex_subgroupOf hBI,relIndex_map_map_of_injective _ _ (MulAut.conj g).injective];exact hi)
      hseedg b (mem_map_of_mem f hv) hbn
  have hgen : α.range = zpowers (α a) ⊔ zpowers (α b) := by
    rw [MonoidHom.range_eq_map,←haimage,←hbimage,←Subgroup.map_sup,
      ←subgroupOf_sup hVI hBI,subgroupOf_self]
  have ha2 : a^2=1 := Subtype.ext (elemPow_eq_one_of_isElementaryAbelian v hv)
  have hb2 : b^2=1 := by
    apply Subtype.ext
    change (f v)^2=1
    rw [←map_pow,elemPow_eq_one_of_isElementaryAbelian v hv,map_one]
  have hPQ : P ≤ D.QH := sup_le ((le_conjugateSpanBy _ _).trans h.UH_le_QH)
    ((pair_seed_conjugate_le_closure (D := D) g hg).trans h.UH_le_QH)
  have hcomm := h.core_module_commutator_le_seed hi (pair_module_not_le_core (D := D) g hg hn)
  have hcommg : ⁅D.QH,D.V.map f⁆ ≤ D.Vplus.map f := by
    have hm := map_mono (f := f) hcomm
    have hQ : D.QH.map f = D.QH :=
      mem_normalizer_iff_map_conj_eq.mp (H_normalizes_QH (D := D) hg)
    rwa [map_commutator,hQ] at hm
  have hsing (x : I) (W : Subgroup G) (helem : IsElementaryAbelian 2 W)
      (hbound : ∀ p ∈ P, ⁅(x:G),p⁆ ∈ W) :
      ∀ v, ExtraspecialSquare.form P ((α x).val v-v)=0 := by
    apply ExtraspecialSquare.singular_displacement P (seedConjugation I P n x)
    intro p
    apply Subtype.ext
    change (((x:G)*(p:G)*(x:G)⁻¹)*(p:G)⁻¹)^2=1
    let := helem
    exact elemPow_eq_one_of_isElementaryAbelian _ (hbound p p.property)
  refine ⟨α a,α b,by rw [←map_pow,ha2,map_one],by rw [←map_pow,hb2,map_one],?_,?_,hgen,⟨v,hv⟩,hvn,rfl,rfl⟩
  · apply hsing a D.Vplus (IsElementaryAbelian.of_le h.plus_le)
    intro p hp'
    rw [←commutatorElement_inv]
    exact D.Vplus.inv_mem (hcomm (commutator_mem_commutator (hPQ hp') hv))
  · let : IsElementaryAbelian 2 (D.V.map f) := IsElementaryAbelian.map f
    apply hsing b (D.Vplus.map f) (IsElementaryAbelian.of_le (map_mono h.plus_le))
    intro p hp'
    rw [←commutatorElement_inv]
    exact (D.Vplus.map f).inv_mem
      (hcommg (commutator_mem_commutator (hPQ hp') (mem_map_of_mem f hv)))

end CFSG.Quasithin.Chapter12.Section06.Nonabelian
