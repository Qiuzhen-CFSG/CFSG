module
public import CFSG.Quasithin.Chapter12.Section06.Nonsingular.OriginalHigmanSimsImageGeometry
public import Theory.ElementaryAbelian.EightQuotientRank

/-!
# The original large intersection has a large HS action image

The kernel of the original module action is the actual line generated by
the nonsingular point, of order two. The kernel-image formula therefore
sends an original intersection of order greater than eight to a subgroup
of order greater than four in the intersection of the two action images.
The full central kernel is retained throughout the calculation.
Source: Aschbacher--Smith 12.6.12 and 12.6.20, printed pp.825--826,828--829.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter12.Section06
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {L V : Subgroup G} [IsElementaryAbelian 2 V]

/-- A large actual module intersection has image of order greater than four
under the unchanged point-component action. -/
theorem SourceHypothesis.nonsingular_hs_image_intersection_card_gt_four
    (H : SourceHypothesis KnownSimple.IsKnownSimple T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) (v : V) (hv : D.Nonsingular v)
    (hK : IsQuasisimple (Kv (v : G)))
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    (hnot : ¬ Kv (v : G) ≤ M L)
    (e : ((Kv (v : G)) ⧸ center (Kv (v : G))) ≃* Sporadic.LeechRelated.HS.Carrier)
    (c : Gv (v : G))
    (hlarge : 8 < Nat.card (V ⊓ V.map (MulAut.conj (c : G)).toMonoidHom : Subgroup G)) :
    let a := nonsingularModelAction (v : G) e
    let E := (V.subgroupOf (Gv (v : G))).map a
    4 < Nat.card (E ⊓ E.map (MulAut.conj (a c)).toMonoidHom :
      Subgroup (MulAut Sporadic.LeechRelated.HS.Carrier)) := by
  let := hK
  let A := Gv (v : G)
  let a := nonsingularModelAction (v : G) e
  let U := V.subgroupOf A
  let B := V ⊓ V.map (MulAut.conj (c : G)).toMonoidHom
  let B₀ := B.subgroupOf A
  have hBA : B ≤ A := inf_le_left.trans (V_le_Gv v)
  have hBcard : 8 < Nat.card B₀ := by
    rw [Nat.card_congr (subgroupOfEquivOfLe hBA).toEquiv]
    exact hlarge
  have hline := (H.nonsingular_hs_original_geometry D v hv hK hTV hnot e).2.1
  have hv2 : orderOf (v : G) = 2 := orderOf_eq_prime
    (elemPow_eq_one_of_isElementaryAbelian _ v.property)
    (fun he => nonsingular_ne_one D hv (Subtype.ext he))
  have hker : Nat.card (B₀ ⊓ a.ker : Subgroup A) ≤ 2 := by
    have hle : (B₀ ⊓ a.ker).map A.subtype ≤ zpowers (v : G) := by
      rintro _ ⟨x,hx,rfl⟩
      rw [nonsingularModelAction_ker] at hx
      exact hline ▸ ⟨hx.1.1,hx.2⟩
    have hh := Nat.card_le_card_of_injective (inclusion hle) (inclusion_injective hle)
    rw [card_map_of_injective A.subtype_injective,Nat.card_zpowers,hv2] at hh
    exact hh
  have hprod := IsElementaryAbelian.card_inf_ker_mul_card_map B₀ a
  have hmap : 4 < Nat.card (B₀.map a) := by nlinarith
  have himage : B₀.map a ≤ U.map a ⊓ (U.map a).map (MulAut.conj (a c)).toMonoidHom := by
    rintro _ ⟨x,hx,rfl⟩
    refine ⟨mem_map_of_mem a hx.1,?_⟩
    obtain ⟨y,hy,he⟩ := hx.2
    let z : A := ⟨y,(V_le_Gv v) hy⟩
    refine ⟨a z,mem_map_of_mem a hy,?_⟩
    have hz : c*z*c⁻¹=x := Subtype.ext he
    change a c * a z * (a c)⁻¹ = a x
    rw [←map_inv,←map_mul,←map_mul,hz]
  exact hmap.trans_le (Nat.card_le_card_of_injective (inclusion himage) (inclusion_injective himage))

end CFSG.Quasithin.Chapter12.Section06
