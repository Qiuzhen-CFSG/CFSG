module

public import CFSG.Quasithin.Chapter12.Section06.Nonsingular.OriginalHigmanSimsCoreSpanNative
public import CFSG.Quasithin.Chapter12.Section06.Nonsingular.OriginalHigmanSimsCoreSpanTransfer
public import CFSG.Quasithin.Chapter12.Section06.Nonsingular.OriginalHigmanSimsGlobalCoreSpan
public import Theory.GroupTheory.QuotientIntersection

/-!
# The whole common residual core vanishes in the original singular star

The native point core is generated by conjugates of its intersection with
one actual pure sixteen. The full central covering kernel lies in that
intersection upstairs. The original polar hyperplane has index two in V;
its intersection with the moved module already lies in the local point
core. As the whole moved module escapes that core, this intersection is
exactly the seed needed for generation. Conjugation inside the actual
singular centralizer puts the entire common residual core in its full
ambient two-core.

No local core is replaced by an image, and nonsingular centralizer control
is not assumed. The remaining comparison concerns the resulting actual A5
subgroup and its ordinary normal overcomponent.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter12.Section06
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V : Subgroup G} [IsElementaryAbelian 2 V]

/-- The complete intrinsic core of the original common HS residual lies
in the complete core of the actual singular centralizer. -/
theorem SourceHypothesis.nonsingular_hs_common_core_le_singular_core
    (H : SourceHypothesis KnownSimple.IsKnownSimple T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) (hZ : ZV L V = ⊥)
    (v : V) (hv : D.Nonsingular v) (hK : IsQuasisimple (Kv (v : G)))
    (e : ((Kv (v : G)) ⧸ center (Kv (v : G))) ≃* Sporadic.LeechRelated.HS.Carrier)
    (S : Sylow 2 (Gv (v : G))) (z : V) (hz0 : z ≠ 1)
    (hz : (z : G) ∈ (center ((S : Subgroup (Gv (v : G))).map
      (Gv (v : G)).subtype)).map ((S : Subgroup (Gv (v : G))).map
      (Gv (v : G)).subtype).subtype)
    (hznot : (z : G) ∉ centralizer (Kv (v : G) : Set G))
    (hpolar : (D.fullSetup hZ T z).V₅ ≤ (Gv (z : G)).pCoreIn 2) :
    let B := Gv (v : G) ⊓ Gv (z : G)
    let J := (primeToResidual 3 B).map B.subtype
    J.pCoreIn 2 ≤ (Gv (z : G)).pCoreIn 2 := by
  classical
  let C := Kv (v : G)
  let W := (Vv L V (v : G)).subgroupOf C
  let q := e.toMonoidHom.comp (QuotientGroup.mk' (center C))
  let A := (Gv (z : G)).subgroupOf C
  let a := nonsingularModelAction (v : G) e
  let E := D.fullSetup hZ T z
  let X := Gv (z : G)
  let i : A →* G := C.subtype.comp A.subtype
  let W₀ := Vv L V (v : G)
  have hWC := (H.nonsingular_component_rank D v hv).1
  have hWA : W ≤ A := fun x hx => (V_le_Gv z) ((Vv_le_V H.chosen.normalizes _) hx)
  obtain ⟨j,hj,_,ha,_,himage,_,_,_,_,_,_⟩ :=
    H.nonsingular_hs_selected_centralizer_image D v hv hK e S z hz
      (elemPow_eq_one_of_isElementaryAbelian (z : G) z.property) hznot
  have hjW : j ∈ W.map q := by
    have hjE : MulAut.conj j ∈ (V.subgroupOf (Gv (v : G))).map a := by
      rw [←ha ((V_le_Gv v) z.property)]
      exact mem_map_of_mem a z.property
    have hi := (H.nonsingular_hs_original_inner_part D v hv hK e).2.2.1
    have hh : MulAut.conj j ∈ ((Vv L V (v : G)).subgroupOf (Gv (v : G))).map a :=
      hi ▸ ⟨hjE,⟨j,rfl⟩⟩
    rw [nonsingularModelAction_map (v : G) e _ hWC] at hh
    obtain ⟨y,⟨x,hx,rfl⟩,hxj⟩ := hh
    exact ⟨x,hx,(MulAut.conj_injective_of_center_eq_bot
      Sporadic.LeechRelated.HS.BlockNormalizer.center_carrier_eq_bot) hxj⟩
  let := Vv_elementary H.chosen.normalizes (v : G)
  let : IsElementaryAbelian 2 W := IsElementaryAbelian.subgroupOf hWC
  let : IsElementaryAbelian 2 (W.map q) := IsElementaryAbelian.map q
  have hcard : Nat.card (W.map q) = 16 := by
    rw [show W.map q = (W.map (QuotientGroup.mk' (center C))).map e.toMonoidHom from
      (map_map _ _ _).symm,card_map_of_injective e.injective]
    exact H.nonsingular_hs_moved_image_card D v hv ⟨e⟩
  obtain ⟨p,hp⟩ := H.nonsingular_hs_moved_image_fixed_point D v hv hK e
  have hpure : ∀ x ∈ W.map q, ∃ p : Fin 100, (x : Equiv.Perm (Fin 100)) p = p := by
    rintro x ⟨y,hy,rfl⟩
    exact ⟨p,hp y hy⟩
  have hne : j ≠ 1 := by
    intro hh
    rw [hh,orderOf_one] at hj
    omega
  let F := centralizer ({j} : Set Sporadic.LeechRelated.HS.Carrier)
  let r : A →* F := (MulEquiv.subgroupCongr himage).toMonoidHom.comp (q.subgroupMap A)
  have hr : Function.Surjective r := (MulEquiv.subgroupCongr himage).surjective.comp
    (q.subgroupMap_surjective A)
  have hqk : q.ker = center C := by
    rw [MonoidHom.ker_comp_of_injective _ _ e.injective,QuotientGroup.ker_mk']
  have hrk : r.ker = (center C).comap A.subtype := by
    ext x
    change (⟨q x.val,?_⟩ : F) = 1 ↔ x.val ∈ center C
    rw [Subtype.ext_iff]
    exact show q x.val = 1 ↔ x.val ∈ center C from by rw [←hqk]; rfl
  have hk : IsPGroup 2 r.ker := by
    rw [hrk]
    apply IsPGroup.comap_subtype
    apply IsPGroup.of_card_dvd_pow (n := 1)
    rw [H.nonsingular_hs_ru_center_card D v hv hK (.inl ⟨e⟩)]
    decide
  have hkW : r.ker ≤ W.subgroupOf A := by
    rw [hrk]
    intro x hx
    have hh : q x.val ∈ W.map q := by rw [show q x.val = 1 from (show x.val ∈ q.ker from hqk.symm ▸ hx)]; exact one_mem _
    exact (H.nonsingular_hs_moved_full_preimage D v hv hK e).le hh
  have hmapW : (W.subgroupOf A).map r = (W.map q).subgroupOf F := by
    ext x
    constructor
    · rintro ⟨w,hw,rfl⟩
      exact mem_map_of_mem q hw
    · rintro ⟨w,hw,hew⟩
      exact ⟨⟨w,hWA hw⟩,hw,Subtype.ext hew⟩
  have hmapCore : (pCore 2 A).map r = pCore 2 F := by
    rw [←r.comap_pCore_of_ker_isPGroup hr hk,map_comap_eq_self_of_surjective hr]
  have hkCore : r.ker ≤ pCore 2 A := le_sSup ⟨inferInstance,hk⟩
  let seed := W.subgroupOf A ⊓ pCore 2 A
  have hmapSeed : seed.map r = (W.map q).subgroupOf F ⊓ pCore 2 F := by
    rw [show seed.map r = (W.subgroupOf A).map r ⊓ (pCore 2 A).map r from
      map_inf_of_ker_le r _ _ hkCore,hmapW,hmapCore]
  have hspan : pCore 2 A ≤ conjugateSpanBy seed (primeToResidual 3 A) := by
    apply OriginalHigmanSimsCoreSpanTransfer.le_conjugateSpanBy_of_image_le r seed
      (primeToResidual 3 A) (pCore 2 A) (le_inf hkW hkCore)
    rw [hmapCore,hmapSeed,map_primeToResidual_of_surjective 3 r hr]
    exact (OriginalHigmanSimsCoreSpanNative.pure_sixteen_core_span_intrinsic
      (W.map q) inferInstance hcard hpure j hjW hne).ge
  let N := (pCore 2 A).map i
  have hWnot : ¬ W₀ ≤ N := by
    intro hn
    apply OriginalHigmanSimsGlobalNative.pure_sixteen_not_le_point_core
      (W.map q) inferInstance hcard hpure j hjW hne
    rintro x ⟨w,hw,rfl⟩
    obtain ⟨k,hk,he⟩ := hn hw
    have hew : k.val = w := Subtype.ext he
    change q w ∈ F.pCoreIn 2
    rw [←hew]
    exact mem_map_of_mem F.subtype (hmapCore ▸ mem_map_of_mem r hk)
  have hWU : W₀ ⊓ E.V₅ ≤ N := by
    intro x hx
    let xA : A := ⟨⟨x,hWC hx.1⟩,(V_le_Gv z) (Vv_le_V H.chosen.normalizes _ hx.1)⟩
    let f : A →* X := {
      toFun := fun x => ⟨x.val.val,x.property⟩
      map_one' := rfl
      map_mul' := fun _ _ => rfl }
    have hf : Function.Injective f := fun x y he => Subtype.ext (Subtype.ext
      (congrArg (fun a : X => (a : G)) he))
    have hpre : (pCore 2 X).comap f ≤ pCore 2 A :=
      le_sSup ⟨inferInstance,pCore_isPGroup.comap_of_injective f hf⟩
    obtain ⟨b,hb,heb⟩ := hpolar hx.2
    have hxcore : xA ∈ (pCore 2 X).comap f := by
      change f xA ∈ pCore 2 X
      exact (show f xA = b from Subtype.ext heb.symm) ▸ hb
    exact ⟨xA,hpre hxcore,rfl⟩
  have hseed : W₀ ⊓ N ≤ E.V₅ :=
    OriginalHigmanSimsCoreSpanTransfer.inf_le_of_half_card_and_not_le
      V W₀ E.V₅ N (Vv_le_V H.chosen.normalizes _) E.V₅_le
      (by rw [show Nat.card V = 2^6 from E.space_card,E.perpendicular_card hz0]; decide)
      hWU hWnot
  have hseedN : seed.map i ≤ X.pCoreIn 2 := by
    rintro _ ⟨x,hx,rfl⟩
    exact hpolar (hseed ⟨hx.1,mem_map_of_mem i hx.2⟩)
  have hactor : (primeToResidual 3 A).map i ≤ X := by
    rintro _ ⟨x,_,rfl⟩
    exact x.property
  have hN : N ≤ X.pCoreIn 2 := by
    have hh := map_mono (f := i) hspan
    rw [map_conjugateSpanBy] at hh
    exact hh.trans (conjugateSpanBy_le hseedN (hactor.trans
      (X.le_normalizer.trans (normalizer_le_normalizer_characteristic_image X (pCore 2 X)))))
  let B := Gv (v : G) ⊓ X
  let J := (primeToResidual 3 B).map B.subtype
  have hres : (primeToResidual 3 A).map i = J := by
    rw [show (primeToResidual 3 A).map i = ((primeToResidual 3 A).map A.subtype).map C.subtype
      from (map_map _ _ _).symm,map_embedded_primeToResidual_of_hom,subgroupOf_map_subtype,
      inf_comm X C]
    exact H.nonsingular_hs_intersection_primeToResidual D v hv hK e X
  have hi : Function.Injective i := C.subtype_injective.comp A.subtype_injective
  have hip : IsPGroup 2 i.ker := by rw [i.ker_eq_bot hi]; exact IsPGroup.of_subsingleton 2 _
  have hpc : J.pCoreIn 2 ≤ N := by
    rw [←hres,←map_pCoreIn_of_ker_isPGroup i hip]
    apply map_mono
    have hh := pCoreIn_mono_of_normalizes (p := 2)
      (show primeToResidual 3 A ≤ (⊤ : Subgroup A) from le_top)
      (show (⊤ : Subgroup A) ≤ normalizer (primeToResidual 3 A : Set A) from le_normalizer_of_normal)
    have ht : (⊤ : Subgroup A).pCoreIn 2 = pCore 2 A :=
      pCore_map_iso 2 (topEquiv (G := A))
    exact hh.trans_eq ht
  exact hpc.trans hN

end CFSG.Quasithin.Chapter12.Section06
