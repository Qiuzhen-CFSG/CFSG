module
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.HS.ElementaryFixedPoint
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.HS.RankOneFourNormalizer.Centralizer

/-!
# The two pure sixteen-subgroups in the marked HS Sylow

An elementary subgroup of order sixteen whose elements fix degree-100
letters is one of two explicit subgroups after Sylow conjugation. Twenty
remaining eligible rows have an eight-color commuting bound. The two
sixteen-subgroups are conjugate inside the actual marked Sylow.
All finite equations use the existing kernel-checked ATLAS row enumeration.
Source: the HS inspection in Aschbacher--Smith12.6.12, pp.825--826.
-/

public section
namespace CFSG.Quasithin.Chapter12.Section06.OriginalHigmanSimsImageIntersectionsNative
open Subgroup Theory.GroupTheory Sporadic.LeechRelated.HS
open EvenLocalCandidates EvenLocalCandidates.SylowCatalogueData BlockNormalizer
open scoped IsMulCommutative
set_option maxRecDepth 10000

@[expose] def candidateRow (i0 : Fin 2) (i1 : Fin 16) : Fin 512 :=
  ⟨(480770595482189236022250985984781559993570116768597059544960143480306210016581741184000 >>> (9 * (16 * i0.val + i1.val))) % 512 % 512, Nat.mod_lt _ (by decide)⟩

private def candidateProduct (i0 : Fin 2) (i1 : Fin 256) : Fin 16 :=
  ⟨( >>> (4 * (256 * i0.val + i1.val))) % 16 % 16, Nat.mod_lt _ (by decide)⟩

private def candidateCode (i0 : Fin 2) (i1 : Fin 512) : Fin 16 :=
  ⟨( >>> (4 * (512 * i0.val + i1.val))) % 16 % 16, Nat.mod_lt _ (by decide)⟩

private def badRow (i0 : Fin 20) : Fin 512 :=
  ⟨(1388530993234757156005395904886796643589221829488680449 >>> (9 * (i0.val))) % 512 % 512, Nat.mod_lt _ (by decide)⟩

private def badCode (i0 : Fin 512) : Fin 20 :=
  ⟨( >>> (5 * (i0.val))) % 32 % 20, Nat.mod_lt _ (by decide)⟩

private def centralRow (i0 : Fin 20) (i1 : Fin 16) : Fin 512 :=
  ⟨( >>> (9 * (16 * i0.val + i1.val))) % 512 % 512, Nat.mod_lt _ (by decide)⟩

private def centralCode (i0 : Fin 20) (i1 : Fin 512) : Fin 16 :=
  ⟨( >>> (4 * (512 * i0.val + i1.val))) % 16 % 16, Nat.mod_lt _ (by decide)⟩

private def color (i0 : Fin 20) (i1 : Fin 16) : Fin 8 :=
  ⟨(9666088163811468795107765908916510972814054109785192962402361750019256628787325631328990275280275076581466714620745592311533307896992805811249859421861470182406813540889188740948257214615126791005817399744547472223463845324207804670886942710297982021136219548987036741931573177046682453640 >>> (3 * (16 * i0.val + i1.val))) % 8 % 8, Nat.mod_lt _ (by decide)⟩

private def conjugateCode (i0 : Fin 16) : Fin 16 :=
  ⟨(10227460037163520320 >>> (4 * (i0.val))) % 16 % 16, Nat.mod_lt _ (by decide)⟩

private theorem eq_of_two_points {x y : Carrier} (hx : x ∈ subgroup) (hy : y ∈ subgroup)
    (h₁ : (x : Equiv.Perm (Fin 100)) 1 = (y : Equiv.Perm (Fin 100)) 1)
    (h₄ : (x : Equiv.Perm (Fin 100)) 4 = (y : Equiv.Perm (Fin 100)) 4) : x = y := by
  obtain ⟨i,rfl⟩ := element_surjective hx
  obtain ⟨j,rfl⟩ := element_surjective hy
  apply congrArg element
  apply Fin.ext
  rw [←decode_point i,←decode_point j]
  simp only [element_point] at h₁ h₄
  rw [h₁,h₄]

private theorem candidate_injective : ∀ k : Fin 2, Function.Injective (candidateRow k) := by
  decide +kernel
private theorem candidate_zero : ∀ k : Fin 2, candidateRow k 0 = 0 := by decide +kernel
private theorem candidate_product_points : ∀ (k : Fin 2) (i j : Fin 16) (p : Fin 2),
    point (candidateRow k (candidateProduct k ⟨16*i.val+j.val,by omega⟩)) (![1,4] p) =
      point (candidateRow k i) (point (candidateRow k j) (![1,4] p)) := by
  apply allFin
  decide +kernel
private theorem candidate_square_points : ∀ (k : Fin 2) (i : Fin 16) (p : Fin 2),
    point (candidateRow k i) (point (candidateRow k i) (![1,4] p)) = (![1,4] p) := by
  apply allFin
  decide +kernel
private theorem candidate_commute_points : ∀ (k : Fin 2) (i j : Fin 16) (p : Fin 2),
    point (candidateRow k i) (point (candidateRow k j) (![1,4] p)) =
      point (candidateRow k j) (point (candidateRow k i) (![1,4] p)) := by
  apply allFin
  decide +kernel

private theorem candidate_square (k : Fin 2) (i : Fin 16) :
    element (candidateRow k i) ^ 2 = 1 := by
  apply eq_of_two_points (subgroup.pow_mem (element_mem _) _) subgroup.one_mem
  · simpa only [pow_two,Subgroup.coe_mul,Equiv.Perm.mul_apply,Subgroup.coe_one,Equiv.Perm.one_apply,element_point,Matrix.cons_val_zero,Matrix.cons_val_one,Matrix.head_cons]
      using candidate_square_points k i 0
  · simpa only [pow_two,Subgroup.coe_mul,Equiv.Perm.mul_apply,Subgroup.coe_one,Equiv.Perm.one_apply,element_point,Matrix.cons_val_zero,Matrix.cons_val_one,Matrix.head_cons]
      using candidate_square_points k i 1

@[expose] def candidate (k : Fin 2) : Subgroup Carrier where
  carrier := Set.range (fun i : Fin 16 => element (candidateRow k i))
  one_mem' := ⟨0,by change element (candidateRow k 0) = 1; rw [candidate_zero]; rfl⟩
  mul_mem' := by
    rintro x y ⟨i,rfl⟩ ⟨j,rfl⟩
    refine ⟨candidateProduct k ⟨16*i.val+j.val,by omega⟩,?_⟩
    apply eq_of_two_points (element_mem _) (subgroup.mul_mem (element_mem _) (element_mem _))
    · simpa only [Subgroup.coe_mul,Equiv.Perm.mul_apply,Subgroup.coe_one,Equiv.Perm.one_apply,element_point,Matrix.cons_val_zero,Matrix.cons_val_one,Matrix.head_cons]
        using candidate_product_points k i j 0
    · simpa only [Subgroup.coe_mul,Equiv.Perm.mul_apply,Subgroup.coe_one,Equiv.Perm.one_apply,element_point,Matrix.cons_val_zero,Matrix.cons_val_one,Matrix.head_cons]
        using candidate_product_points k i j 1
  inv_mem' := by
    rintro x ⟨i,rfl⟩
    refine ⟨i,?_⟩
    exact (inv_eq_of_mul_eq_one_left (by simpa only [pow_two] using candidate_square k i)).symm

theorem candidate_le_sylow (k : Fin 2) : candidate k ≤ subgroup := by
  rintro _ ⟨i,rfl⟩
  exact element_mem _

theorem candidate_card (k : Fin 2) : Nat.card (candidate k) = 16 := by
  let f : Fin 16 → candidate k := fun i => ⟨element (candidateRow k i),⟨i,rfl⟩⟩
  have hi : Function.Injective f := fun i j h =>
    candidate_injective k (element_injective (congrArg Subtype.val h))
  have hs : Function.Surjective f := by rintro ⟨x,i,rfl⟩; exact ⟨i,rfl⟩
  exact (Nat.card_congr (Equiv.ofBijective f ⟨hi,hs⟩)).symm.trans (Nat.card_fin 16)

theorem candidate_elementary (k : Fin 2) : IsElementaryAbelian 2 (candidate k) := by
  refine { toIsMulCommutative := ⟨⟨?_⟩⟩, exponent_dvd_p := ?_ }
  · rintro ⟨x,i,rfl⟩ ⟨y,j,rfl⟩
    apply Subtype.ext
    apply eq_of_two_points (subgroup.mul_mem (element_mem _) (element_mem _))
      (subgroup.mul_mem (element_mem _) (element_mem _))
    · simpa only [Subgroup.coe_mul,Equiv.Perm.mul_apply,Subgroup.coe_one,Equiv.Perm.one_apply,element_point,Matrix.cons_val_zero,Matrix.cons_val_one,Matrix.head_cons]
        using candidate_commute_points k i j 0
    · simpa only [Subgroup.coe_mul,Equiv.Perm.mul_apply,Subgroup.coe_one,Equiv.Perm.one_apply,element_point,Matrix.cons_val_zero,Matrix.cons_val_one,Matrix.head_cons]
        using candidate_commute_points k i j 1
  · apply Monoid.exponent_dvd_iff_forall_pow_eq_one.mpr
    rintro ⟨x,i,rfl⟩
    exact Subtype.ext (candidate_square k i)

@[expose] def markedW : Subgroup Carrier := candidate 0

theorem markedW_card : Nat.card markedW = 16 := candidate_card 0
theorem markedW_elementary : IsElementaryAbelian 2 markedW := candidate_elementary 0

private def commutes (i j : Fin 512) : Prop :=
  point i (point j 1) = point j (point i 1) ∧ point i (point j 4) = point j (point i 4)
private instance (i j : Fin 512) : Decidable (commutes i j) := inferInstanceAs (Decidable (_ ∧ _))
private theorem bad_coverage : ∀ i : Fin 512,
    point i (point i 1) = 1 → point i (point i 4) = 4 →
    (∃ p : Fin 100, point i p = p) →
    (∀ k : Fin 2, candidateRow k (candidateCode k i) ≠ i) → badRow (badCode i) = i := by
  apply allFin
  decide +kernel
private theorem central_coverage : ∀ (b : Fin 20) (i : Fin 512),
    point i (point i 1) = 1 → point i (point i 4) = 4 →
    (∃ p : Fin 100, point i p = p) → commutes (badRow b) i →
    centralRow b (centralCode b i) = i := by
  apply allFin₂
  decide +kernel
private theorem color_separation : ∀ (b : Fin 20) (i j : Fin 16),
    color b i = color b j → commutes (centralRow b i) (centralRow b j) → i = j := by
  apply allFin
  decide +kernel

/-- Every sufficiently large pure elementary subgroup of the marked Sylow
is contained in the union of the two displayed sixteen-subgroups. -/
private theorem sylow_pure_le_union (W : Subgroup Carrier) (hWS : W ≤ subgroup)
    (hW : IsElementaryAbelian 2 W) (hc : 8 < Nat.card W)
    (hp : ∀ x ∈ W, ∃ p : Fin 100, (x : Equiv.Perm (Fin 100)) p = p) :
    ∀ x ∈ W, x ∈ candidate 0 ∨ x ∈ candidate 1 := by
  let := hW
  let row (x : W) : Fin 512 := enumeration.symm ⟨x,hWS x.property⟩
  have row_spec (x : W) : element (row x) = x :=
    congrArg Subtype.val (enumeration.apply_symm_apply ⟨x,hWS x.property⟩)
  have square_point (x : W) (p : Fin 100) : point (row x) (point (row x) p) = p := by
    have hs : (x : Carrier)^2=1 := elemPow_eq_one_of_isElementaryAbelian _ x.property
    rw [←row_spec x] at hs
    simpa only [pow_two,Subgroup.coe_mul,Equiv.Perm.mul_apply,Subgroup.coe_one,Equiv.Perm.one_apply,element_point,Matrix.cons_val_zero,Matrix.cons_val_one,Matrix.head_cons]
      using congrArg (fun a : Carrier => (a : Equiv.Perm (Fin 100)) p) hs
  have fixed_point (x : W) : ∃ p : Fin 100, point (row x) p = p := by
    obtain ⟨p,hp⟩ := hp x x.property
    exact ⟨p,by rw [←element_point,row_spec]; exact hp⟩
  have commute_rows (x y : W) : commutes (row x) (row y) := by
    have hh : (x : Carrier)*(y : Carrier) = (y : Carrier)*(x : Carrier) :=
      congrArg Subtype.val (mul_comm x y)
    rw [←row_spec x,←row_spec y] at hh
    constructor
    · simpa only [Subgroup.coe_mul,Equiv.Perm.mul_apply,Subgroup.coe_one,Equiv.Perm.one_apply,element_point,Matrix.cons_val_zero,Matrix.cons_val_one,Matrix.head_cons]
        using congrArg (fun a : Carrier => (a : Equiv.Perm (Fin 100)) 1) hh
    · simpa only [Subgroup.coe_mul,Equiv.Perm.mul_apply,Subgroup.coe_one,Equiv.Perm.one_apply,element_point,Matrix.cons_val_zero,Matrix.cons_val_one,Matrix.head_cons]
        using congrArg (fun a : Carrier => (a : Equiv.Perm (Fin 100)) 4) hh
  intro x hx
  by_contra hnot
  have hn0 : x ∉ candidate 0 := fun h => hnot (.inl h)
  have hn1 : x ∉ candidate 1 := fun h => hnot (.inr h)
  let u : W := ⟨x,hx⟩
  have bad : badRow (badCode (row u)) = row u := by
    apply bad_coverage _ (square_point u 1) (square_point u 4) (fixed_point u)
    intro k he
    have hm : x ∈ candidate k := ⟨candidateCode k (row u),by change element (candidateRow k (candidateCode k (row u))) = x; rw [he,row_spec]⟩
    fin_cases k
    · exact hn0 hm
    · exact hn1 hm
  let b := badCode (row u)
  have central (y : W) : centralRow b (centralCode b (row y)) = row y := by
    apply central_coverage _ _ (square_point y 1) (square_point y 4) (fixed_point y)
    rw [show badRow b = row u from bad]
    exact commute_rows u y
  let f : W → Fin 8 := fun y => color b (centralCode b (row y))
  have hf : Function.Injective f := by
    intro y z he
    have hij := color_separation b (centralCode b (row y)) (centralCode b (row z)) he
      (by rw [central,central]; exact commute_rows y z)
    have hr : row y = row z := by rw [←central y,←central z,hij]
    exact Subtype.ext ((row_spec y).symm.trans ((congrArg element hr).trans (row_spec z)))
  have hb : Nat.card W ≤ 8 := by
    simpa only [Nat.card_fin] using Nat.card_le_card_of_injective f hf
  omega

/-- The two displayed subgroups exhaust pure elementary sixteen-subgroups
of the actual marked Sylow. -/
theorem sylow_pure_sixteen (W : Subgroup Carrier) (hWS : W ≤ subgroup)
    (hW : IsElementaryAbelian 2 W) (hc : Nat.card W = 16)
    (hp : ∀ x ∈ W, ∃ p : Fin 100, (x : Equiv.Perm (Fin 100)) p = p) :
    W = candidate 0 ∨ W = candidate 1 := by
  have hu := sylow_pure_le_union W hWS hW (by omega) hp
  have hle : W ≤ candidate 0 ∨ W ≤ candidate 1 := by
    by_cases h : W ≤ candidate 0
    · exact .inl h
    · right
      obtain ⟨x,hx,hx0⟩ := SetLike.not_le_iff_exists.mp h
      have hx1 := (hu x hx).resolve_left hx0
      intro y hy
      by_contra hy1
      have hy0 := (hu y hy).resolve_right hy1
      rcases hu (x*y) (W.mul_mem hx hy) with hm | hm
      · exact hx0 (by simpa using (candidate 0).mul_mem hm ((candidate 0).inv_mem hy0))
      · exact hy1 (by simpa using (candidate 1).mul_mem ((candidate 1).inv_mem hx1) hm)
  rcases hle with h | h
  · exact .inl (eq_of_le_of_card_ge h (by rw [hc,candidate_card]))
  · exact .inr (eq_of_le_of_card_ge h (by rw [hc,candidate_card]))

private theorem conjugate_point : ∀ (i : Fin 16) (p : Fin 100),
    (element 3 : Equiv.Perm (Fin 100))
      (point (candidateRow 0 i) ((element 3 : Equiv.Perm (Fin 100))⁻¹ p)) =
      point (candidateRow 1 (conjugateCode i)) p := by
  apply allFin₂
  decide +kernel

theorem candidate_conjugate :
    (candidate 0).map (MulAut.conj (element 3)).toMonoidHom = candidate 1 := by
  apply eq_of_le_of_card_ge
  · rintro _ ⟨x,⟨i,rfl⟩,rfl⟩
    refine ⟨conjugateCode i,?_⟩
    apply Subtype.ext
    apply Equiv.ext
    intro p
    change (element (candidateRow 1 (conjugateCode i)) : Equiv.Perm (Fin 100)) p =
      ((element 3 : Equiv.Perm (Fin 100)) * (element (candidateRow 0 i) : Equiv.Perm (Fin 100)) *
        (element 3 : Equiv.Perm (Fin 100))⁻¹) p
    simpa only [MulAut.conj_apply,Subgroup.coe_mul,Subgroup.coe_inv,
      Equiv.Perm.mul_apply,Subgroup.coe_one,Equiv.Perm.one_apply,element_point,Matrix.cons_val_zero,Matrix.cons_val_one,Matrix.head_cons] using (conjugate_point i p).symm
  · rw [card_map_of_injective (MulAut.conj (element 3)).injective,candidate_card,candidate_card]

/-- Pure elementary sixteen-subgroups of the actual HS carrier form one
conjugacy class; purity is retained as a genuine hypothesis. -/
theorem pure_sixteen_conjugate (W : Subgroup Carrier) (hW : IsElementaryAbelian 2 W)
    (hc : Nat.card W = 16)
    (hp : ∀ x ∈ W, ∃ p : Fin 100, (x : Equiv.Perm (Fin 100)) p = p) :
    ∃ g : Carrier, W.map (MulAut.conj g).toMonoidHom = markedW := by
  let := hW
  obtain ⟨P,hWP⟩ := (IsElementaryAbelian.isPGroup 2 W).exists_le_sylow
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq Carrier P baseSylow
  let c := MulAut.conj g
  have hP : (P : Subgroup Carrier).map c.toMonoidHom = subgroup :=
    congrArg Sylow.toSubgroup hg
  let U := W.map c.toMonoidHom
  have hU : U ≤ subgroup := hP ▸ map_mono hWP
  have he : IsElementaryAbelian 2 U := IsElementaryAbelian.map _
  have hcard : Nat.card U = 16 := (card_map_of_injective c.injective).trans hc
  have hfix : ∀ x ∈ U, ∃ p : Fin 100, (x : Equiv.Perm (Fin 100)) p = p := by
    rintro _ ⟨x,hx,rfl⟩
    obtain ⟨p,hp⟩ := hp x hx
    refine ⟨(g : Equiv.Perm (Fin 100)) p,?_⟩
    change ((g : Equiv.Perm (Fin 100)) * (x : Equiv.Perm (Fin 100)) *
      (g : Equiv.Perm (Fin 100))⁻¹) ((g : Equiv.Perm (Fin 100)) p) = _
    simp only [Equiv.Perm.mul_apply,Equiv.Perm.inv_def,Equiv.symm_apply_apply,hp]
  rcases sylow_pure_sixteen U hU he hcard hfix with h | h
  · exact ⟨g,h⟩
  · refine ⟨(element 3)⁻¹*g,?_⟩
    have hh := congrArg (map (MulAut.conj (element 3)⁻¹).toMonoidHom) (h.trans candidate_conjugate.symm)
    simp only [U,map_map] at hh
    have hcomp : (MulAut.conj (element 3)⁻¹).toMonoidHom.comp c.toMonoidHom =
        (MulAut.conj ((element 3)⁻¹*g)).toMonoidHom := by
      apply MonoidHom.ext
      intro x
      change (element 3)⁻¹ * (g*x*g⁻¹) * ((element 3)⁻¹)⁻¹ =
        ((element 3)⁻¹*g)*x*((element 3)⁻¹*g)⁻¹
      group
    have hid : (MulAut.conj (element 3)⁻¹).toMonoidHom.comp
        (MulAut.conj (element 3)).toMonoidHom = MonoidHom.id Carrier := by
      apply MonoidHom.ext
      intro x
      change (element 3)⁻¹ * (element 3*x*(element 3)⁻¹) * ((element 3)⁻¹)⁻¹ = x
      group
    rw [hcomp,hid,Subgroup.map_id] at hh
    exact hh

end CFSG.Quasithin.Chapter12.Section06.OriginalHigmanSimsImageIntersectionsNative
