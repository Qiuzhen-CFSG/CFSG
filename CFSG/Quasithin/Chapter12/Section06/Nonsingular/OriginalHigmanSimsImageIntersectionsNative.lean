module
public import CFSG.Quasithin.Chapter12.Section06.Nonsingular.OriginalHigmanSimsImageIntersectionsPureCentralizer
public import CFSG.Quasithin.Chapter12.Section06.Nonsingular.OriginalHigmanSimsImageIntersectionsTransitivity
public import CFSG.Quasithin.Chapter12.Section06.Nonsingular.OriginalHigmanSimsImageIntersectionsOrbit
import all CFSG.Quasithin.Chapter12.Section06.Nonsingular.OriginalHigmanSimsImageIntersectionsOrbit
import all CFSG.Quasithin.Chapter12.Section06.Nonsingular.OriginalHigmanSimsNative
import all Theory.SpecificGroups.LeechRelated.AtlasCarriers.HS.OrdinaryLocal
import all Theory.SpecificGroups.ExceptionalOuterDisplacements.HS.Outer.Automorphisms
public import Theory.GroupTheory.AutomorphismTowerSimple

/-!
# The full automorphism centralizer of the pure HS sixteen-subgroup

The marked subgroup has a specified outer involution in its centralizer.
Its inner centralizer is exactly the sixteen-subgroup, and the full outer
quotient has order two. Hence the displayed thirty-two permutations give
the entire automorphism centralizer, retaining the actual degree100 action.

The centralizer of the marked inner involution is generated by the two
previously verified native words together with that outer involution. These
preserve the ten-row orbit certificate. This proves the overlap bound for
all automorphisms fixing the marked involution, with no coverage hypothesis.
Source: Aschbacher--Smith12.6.12, printed pp.825--826.
-/

public noncomputable section
namespace CFSG.Quasithin.Chapter12.Section06.OriginalHigmanSimsImageIntersectionsNative
open Subgroup Theory.GroupTheory Sporadic.LeechRelated.HS
open EvenLocalCandidates EvenLocalCandidates.SylowCatalogueData BlockNormalizer
open Theory.SpecificGroups.ExceptionalOuterDisplacements.HS.Outer
open Certificate
set_option maxRecDepth 100000

@[expose] def markedE : Subgroup (MulAut Carrier) :=
  centralizer (markedW.map (MulAut.conj : Carrier →* MulAut Carrier) : Set (MulAut Carrier))

private theorem inner_injective : Function.Injective (MulAut.conj : Carrier →* MulAut Carrier) :=
  MulAut.conj_injective_of_center_eq_bot center_carrier_eq_bot

private theorem mem_markedE (α : MulAut Carrier) : α ∈ markedE ↔ ∀ x ∈ markedW, α x = x := by
  constructor
  · intro h x hx
    apply inner_injective
    have hc := h (MulAut.conj x) (mem_map_of_mem _ hx)
    have hh : MulAut.conj (α x) = α * MulAut.conj x * α⁻¹ := by ext y; simp
    rw [hh,←hc,mul_inv_cancel_right]
  · intro h a ha
    obtain ⟨x,hx,rfl⟩ := ha
    have hh : α * MulAut.conj x * α⁻¹ = MulAut.conj (α x) := by ext y; simp
    rw [h x hx] at hh
    exact (mul_inv_eq_iff_eq_mul.mp hh).symm

private theorem first_inner (i : Fin 16) :
    permutation 0 ⟨i.val,by omega⟩ = (element (candidateRow 0 i) : Equiv.Perm (Fin 100)) := by
  apply Equiv.ext
  have h : ∀ (i : Fin 16) (p : Fin 100),
      letter 0 ⟨i.val,by omega⟩ p = point (candidateRow 0 i) p := by
    apply allFin
    decide +kernel
  intro p
  change letter 0 ⟨i.val,by omega⟩ p = _
  simpa only [element_point] using h i p

private theorem first_outer (i : Fin 16) :
    permutation 0 ⟨i.val+16,by omega⟩ =
      (element (candidateRow 0 i) : Equiv.Perm (Fin 100)) * outer := by
  apply Equiv.ext
  have h : ∀ (i : Fin 16) (p : Fin 100),
      letter 0 ⟨i.val+16,by omega⟩ p = point (candidateRow 0 i) (outer p) := by
    apply allFin
    decide +kernel
  intro p
  change letter 0 ⟨i.val+16,by omega⟩ p = _
  simpa only [element_point,Equiv.Perm.mul_apply] using h i p

private theorem outer_normalizes : outer ∈ PermutationNormalizer := by
  apply graphGroup_le_permutationNormalizer
  rw [NormalizerIndex.mem_graphGroup_iff]
  apply allFin
  decide +kernel

private theorem outer_sign : Equiv.Perm.sign outer = -1 := by decide +kernel
private theorem outer_not_inner : outer ∉ generated := by
  intro h
  have hh := generated_le_sign_ker h
  change Equiv.Perm.sign outer = 1 at hh
  rw [outer_sign] at hh
  exact (by decide : (-1 : ℤˣ) ≠ 1) hh

private theorem outer_square : outer * outer = 1 := permutation_square 16

private theorem outer_commutes (x : Carrier) (hx : x ∈ markedW) :
    (x : Equiv.Perm (Fin 100)) * outer = outer * x := by
  obtain ⟨i,rfl⟩ := hx
  apply Equiv.ext
  have h : ∀ (i : Fin 16) (p : Fin 100),
      point (candidateRow 0 i) (outer p) = outer (point (candidateRow 0 i) p) := by
    apply allFin
    decide +kernel
  intro p
  simpa only [element_point,Equiv.Perm.mul_apply] using h i p

private theorem first_le_normalizer : first ≤ PermutationNormalizer := by
  rintro x ⟨i,rfl⟩
  by_cases hi : i.val < 16
  · rw [first_inner ⟨i.val,hi⟩]
    exact generated.le_normalizer (element _).property
  · have he : i = ⟨(i.val-16)+16,by omega⟩ := Fin.ext (by change i.val = (i.val-16)+16; omega)
    rw [he,first_outer ⟨i.val-16,by omega⟩]
    exact PermutationNormalizer.mul_mem (generated.le_normalizer (element _).property) outer_normalizes

private theorem inner_le_first {x : Carrier} (hx : x ∈ markedW) :
    (x : Equiv.Perm (Fin 100)) ∈ first := by
  obtain ⟨i,rfl⟩ := hx
  exact ⟨⟨i.val,by omega⟩,first_inner i⟩

private theorem first_fixes {n : Equiv.Perm (Fin 100)} (hn : n ∈ first)
    (x : Carrier) (hx : x ∈ markedW) : (x : Equiv.Perm (Fin 100)) * n = n * x := by
  let := markedW_elementary
  have hw (j : Fin 16) : (x : Equiv.Perm (Fin 100)) * (element (candidateRow 0 j)) =
      (element (candidateRow 0 j) : Equiv.Perm (Fin 100)) * x :=
    congrArg Subtype.val (setLike_mul_comm hx (show element (candidateRow 0 j) ∈ markedW from ⟨j,rfl⟩))
  obtain ⟨i,rfl⟩ := hn
  by_cases hi : i.val < 16
  · rw [first_inner ⟨i.val,hi⟩]
    exact hw _
  · have he : i = ⟨(i.val-16)+16,by omega⟩ := Fin.ext (by change i.val = (i.val-16)+16; omega)
    rw [he,first_outer ⟨i.val-16,by omega⟩]
    rw [←mul_assoc,hw,mul_assoc,outer_commutes x hx,←mul_assoc]

private theorem normalizer_fixing_mem_first (n : PermutationNormalizer)
    (hn : ∀ x ∈ markedW, (x : Equiv.Perm (Fin 100)) * n.val = n.val * x) : n.val ∈ first := by
  have inner_case (a : Equiv.Perm (Fin 100)) (ha : a ∈ generated)
      (hfix : ∀ x ∈ markedW, (x : Equiv.Perm (Fin 100)) * a = a * x) : a ∈ first := by
    let g : Carrier := ⟨a,ha⟩
    apply inner_le_first (x := g)
    rw [←markedW_centralizer]
    intro x hx
    exact Subtype.ext (hfix x hx)
  by_cases h : n.val ∈ generated
  · exact inner_case n.val h hn
  · let y : PermutationNormalizer := ⟨outer,outer_normalizes⟩
    have hi : n*y ∈ generated.subgroupOf PermutationNormalizer :=
      ((generated.subgroupOf PermutationNormalizer).mul_mem_iff_of_index_two
        permutationNormalizer_relative_index).mpr (iff_of_false h outer_not_inner)
    have hf : n.val * outer ∈ first := inner_case _ hi (by
      intro x hx
      calc
        (x : Equiv.Perm (Fin 100)) * (n.val*outer) = (n.val*x)*outer := by rw [←mul_assoc,hn x hx]
        _ = n.val*(outer*x) := by rw [mul_assoc,outer_commutes x hx]
        _ = (n.val*outer)*x := (mul_assoc _ _ _).symm)
    have hy : outer ∈ first := ⟨16,rfl⟩
    have hm := first.mul_mem hf hy
    simpa only [mul_assoc,outer_square,mul_one] using hm

private theorem normalizer_action_mem (n : PermutationNormalizer) :
    generated.normalizerMonoidHom n ∈ markedE ↔ n.val ∈ first := by
  rw [mem_markedE]
  constructor
  · intro h
    apply normalizer_fixing_mem_first n
    intro x hx
    have hh := congrArg Subtype.val (h x hx)
    change n.val * x.val * n.val⁻¹ = x.val at hh
    exact (mul_inv_eq_iff_eq_mul.mp hh).symm
  · intro hn x hx
    apply Subtype.ext
    change n.val*x.val*n.val⁻¹=x.val
    rw [←first_fixes hn x hx,mul_inv_cancel_right]

private def firstN : Subgroup PermutationNormalizer := first.subgroupOf PermutationNormalizer
private theorem firstN_map : firstN.map generated.normalizerMonoidHom = markedE := by
  apply le_antisymm
  · rintro _ ⟨n,hn,rfl⟩
    exact (normalizer_action_mem n).mpr hn
  · intro α hα
    obtain ⟨n,rfl⟩ := fullAutomorphismEquiv.surjective α
    exact ⟨n,(normalizer_action_mem n).mp hα,rfl⟩

theorem markedE_card : Nat.card markedE = 32 := by
  rw [←firstN_map,card_map_of_injective normalizer_action_injective]
  have h := Nat.card_congr (subgroupOfEquivOfLe first_le_normalizer).toEquiv
  change Nat.card firstN = Nat.card first at h
  rw [h,←orbit_zero,orbit_card]

private def liftHom : MulAut Carrier →* Equiv.Perm (Fin 100) :=
  PermutationNormalizer.subtype.comp fullAutomorphismEquiv.symm.toMonoidHom

private theorem lift_injective : Function.Injective liftHom :=
  Subtype.val_injective.comp fullAutomorphismEquiv.symm.injective

private theorem markedE_lift : markedE.map liftHom = first := by
  rw [←firstN_map,Subgroup.map_map]
  have he : liftHom.comp generated.normalizerMonoidHom = PermutationNormalizer.subtype := by
    apply MonoidHom.ext
    intro n
    exact congrArg Subtype.val (fullAutomorphismEquiv.symm_apply_apply n)
  rw [he]
  exact map_subgroupOf_eq_of_le first_le_normalizer

private theorem map_conjugate {A B : Type*} [Group A] [Group B]
    (f : A →* B) (H : Subgroup A) (a : A) :
    (H.map (MulAut.conj a).toMonoidHom).map f =
      (H.map f).map (MulAut.conj (f a)).toMonoidHom := by
  rw [Subgroup.map_map,Subgroup.map_map]
  congr 1
  apply MonoidHom.ext
  intro x
  change f (a*x*a⁻¹)=f a*f x*(f a)⁻¹
  simp only [map_mul,map_inv]

private theorem map_conj_mul (H : Subgroup (Equiv.Perm (Fin 100)))
    (a b : Equiv.Perm (Fin 100)) :
    H.map (MulAut.conj (a*b)).toMonoidHom =
      (H.map (MulAut.conj b).toMonoidHom).map (MulAut.conj a).toMonoidHom := by
  rw [Subgroup.map_map]
  congr 1

private theorem map_conj_inverse {H K : Subgroup (Equiv.Perm (Fin 100))}
    {a : Equiv.Perm (Fin 100)} (h : H.map (MulAut.conj a).toMonoidHom = K) :
    K.map (MulAut.conj a⁻¹).toMonoidHom = H := by
  rw [←h,←map_conj_mul,inv_mul_cancel]
  change H.map (MonoidHom.id _) = H
  exact Subgroup.map_id H

private def preserving : Subgroup (Equiv.Perm (Fin 100)) where
  carrier := {g | (∀ k : Fin 10, ∃ l, (orbit k).map (MulAut.conj g).toMonoidHom = orbit l) ∧
    (∀ l : Fin 10, ∃ k, (orbit k).map (MulAut.conj g).toMonoidHom = orbit l)}
  one_mem' := by
    constructor <;> intro k <;> refine ⟨k,?_⟩ <;>
      change (orbit k).map (MonoidHom.id _) = orbit k <;> exact Subgroup.map_id _
  mul_mem' := by
    rintro a b ⟨ha,ha'⟩ ⟨hb,hb'⟩
    constructor
    · intro k
      obtain ⟨l,hl⟩ := hb k
      obtain ⟨m,hm⟩ := ha l
      exact ⟨m,by rw [map_conj_mul,hl,hm]⟩
    · intro m
      obtain ⟨l,hl⟩ := ha' m
      obtain ⟨k,hk⟩ := hb' l
      exact ⟨k,by rw [map_conj_mul,hk,hl]⟩
  inv_mem' := by
    rintro a ⟨ha,ha'⟩
    constructor
    · intro l
      obtain ⟨k,hk⟩ := ha' l
      exact ⟨k,map_conj_inverse hk⟩
    · intro k
      obtain ⟨l,hl⟩ := ha k
      exact ⟨l,map_conj_inverse hl⟩

private theorem generator_preserves (j : Fin 3) : generator j ∈ preserving := by
  constructor
  · intro k
    exact ⟨next k j,transition k j⟩
  · intro l
    obtain ⟨k,rfl⟩ := (Finite.surjective_of_injective (transition_injective j)) l
    exact ⟨k,transition k j⟩

private theorem local_preserves (x : localGroup 0) : (x.val : Equiv.Perm (Fin 100)) ∈ preserving := by
  let f : localGroup 0 →* Equiv.Perm (Fin 100) := inclusion.comp (localGroup 0).subtype
  have h : (⊤ : Subgroup (localGroup 0)) ≤ preserving.comap f := by
    rw [←OriginalHigmanSimsNative.pair_generates,Subgroup.closure_le]
    intro a ha
    rcases Set.mem_insert_iff.mp ha with rfl | ha
    · change (OriginalHigmanSimsNative.triple).val.val ∈ preserving
      rw [←generator_triple]
      exact generator_preserves 0
    · rcases Set.mem_singleton_iff.mp ha with rfl
      change (OriginalHigmanSimsNative.eight).val.val ∈ preserving
      rw [←generator_eight]
      exact generator_preserves 1
  exact h (mem_top x)

private theorem fixing_point_preserves (n : PermutationNormalizer)
    (hn : n.val * (e0 : Equiv.Perm (Fin 100)) = (e0 : Equiv.Perm (Fin 100)) * n.val) :
    n.val ∈ preserving := by
  have inner_case (a : Equiv.Perm (Fin 100)) (ha : a ∈ generated)
      (hc : a*(e0 : Equiv.Perm (Fin 100))=(e0 : Equiv.Perm (Fin 100))*a) : a ∈ preserving := by
    let x : Carrier := ⟨a,ha⟩
    have hx : x ∈ localGroup 0 := by
      rw [OrdinaryLocal.first_eq_centralizer,mem_centralizer_singleton_iff]
      exact Subtype.ext hc
    exact local_preserves ⟨x,hx⟩
  by_cases h : n.val ∈ generated
  · exact inner_case n.val h hn
  · let y : PermutationNormalizer := ⟨outer,outer_normalizes⟩
    have hi : n*y ∈ generated.subgroupOf PermutationNormalizer :=
      ((generated.subgroupOf PermutationNormalizer).mul_mem_iff_of_index_two
        permutationNormalizer_relative_index).mpr (iff_of_false h outer_not_inner)
    have hc := outer_commutes e0 marked_point_mem
    have hm : n.val*outer ∈ preserving := inner_case _ hi (by
      calc
        (n.val*outer)*(e0 : Equiv.Perm (Fin 100)) = n.val*((e0 : Equiv.Perm (Fin 100))*outer) := by rw [mul_assoc,←hc]
        _ = ((e0 : Equiv.Perm (Fin 100))*n.val)*outer := by rw [←mul_assoc,hn]
        _ = (e0 : Equiv.Perm (Fin 100))*(n.val*outer) := mul_assoc _ _ _)
    have hy : outer ∈ preserving := generator_outer ▸ generator_preserves 2
    simpa only [mul_assoc,outer_square,mul_one] using preserving.mul_mem hm hy

/-- All automorphisms fixing the marked inner involution obey the exact
native overlap bound; the ten-row coverage is proved, not assumed. -/
theorem markedE_conjugate_overlap (α : MulAut Carrier) (ha : α e0 = e0) :
    markedE = markedE.map (MulAut.conj α).toMonoidHom ∨
      Nat.card (markedE ⊓ markedE.map (MulAut.conj α).toMonoidHom : Subgroup (MulAut Carrier)) ≤ 4 := by
  let n := fullAutomorphismEquiv.symm α
  have hn : n.val * (e0 : Equiv.Perm (Fin 100)) = (e0 : Equiv.Perm (Fin 100))*n.val := by
    have hh : generated.normalizerMonoidHom n e0 = e0 := by
      change fullAutomorphismEquiv n e0 = e0
      rw [fullAutomorphismEquiv.apply_symm_apply]
      exact ha
    have hv := congrArg Subtype.val hh
    change n.val*(e0 : Equiv.Perm (Fin 100))*n.val⁻¹=(e0 : Equiv.Perm (Fin 100)) at hv
    exact mul_inv_eq_iff_eq_mul.mp hv
  obtain ⟨k,hk⟩ := (fixing_point_preserves n hn).1 0
  rw [orbit_zero] at hk
  have hconj : (markedE.map (MulAut.conj α).toMonoidHom).map liftHom = orbit k := by
    rw [map_conjugate,markedE_lift]
    exact hk
  by_cases hzero : k=0
  · left
    apply map_injective lift_injective
    rw [markedE_lift,hconj,hzero,orbit_zero]
  · right
    have hkpos : 0 < k.val := Nat.pos_of_ne_zero (fun hh => hzero (Fin.ext hh))
    have he : k = ⟨(k.val-1)+1,by omega⟩ := Fin.ext (by change k.val = (k.val-1)+1; omega)
    have hb := orbit_intersection_bound ⟨k.val-1,by omega⟩
    rw [←he] at hb
    rw [←card_map_of_injective lift_injective,Subgroup.map_inf _ _ _ lift_injective,
      markedE_lift,hconj]
    exact hb

end CFSG.Quasithin.Chapter12.Section06.OriginalHigmanSimsImageIntersectionsNative
