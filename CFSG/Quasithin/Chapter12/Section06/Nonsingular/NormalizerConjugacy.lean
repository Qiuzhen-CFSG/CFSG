/-!
# The original Sylow conjugator and canonical residual

The actual A8 quotient makes L perfect and generated by its three-elements.
Together with the prime-to-three normalizer index, this gives the exact
identity O^{3′}(N_G(L))=L of source 12.6.1(5).

After the original Thompson argument makes L centralize Z=Ω₁Z(T), uniqueness
puts C_G(z) in M=N_G(L) for every nonidentity z in Z. A Sylow conjugator
carries the original nonsingular involution into Z. Functoriality of the
literal composite residual O^{3′}(C_G(v)^∞) then identifies its conjugate
with L. The preferred-point application uses the proved ambient Sylow in
the contrary normalizer branch. It also carries K_v S onto LT and retains
the conjugate of the original L_v as a proper subgroup of L.

All conjugations here are the direct maps x ↦ g*x*g⁻¹. The subsequent
alignment of L_v and R_v remains for 12.6.16(1) and normalizer escape.
HS/J4 exclusions, the remaining local canonical-module arguments, blocks,
splitting and fixed-space elimination remain; neither 12.6.2 nor 12.6.23
is asserted. Earlier invariance/TI retain producer qt-d-1222-source and
final source discharge remains with qt-d-12634-source.
Source: Aschbacher--Smith 12.6.1(5,6) and 12.6.16--17, printed pp.823,826--827,
combined manuscript of 1 March 2004.
-/

public section
set_option backward.isDefEq.respectTransparency false
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter12.Section06
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {L V : Subgroup G} [IsElementaryAbelian 2 V]

/-- Direct conjugation preserves the literal composite centralizer residual. -/
theorem Kv_map_conjugation (v g : G) :
    (Kv v).map (MulAut.conj g).toMonoidHom = Kv (MulAut.conj g v) := by
  have hk (x : G) : Kv x = perfectPrimeResidual 3 (Gv x) :=
    (perfectPrimeResidual_eq 3 (Gv x)).symm
  rw [hk, map_perfectPrimeResidual, Gv, map_pointCentralizer]
  exact (hk _).symm

/-- The original A8 component is fixed by the composite three-residual. -/
theorem SourceHypothesis.component_perfectPrimeResidual
    (H : SourceHypothesis KnownSimple.IsKnownSimple T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) :
    perfectPrimeResidual 3 L = L := by
  let := Chapter1.mem_L_isPerfect H.source.maximal_faithful.1.1
  let e := D.coreQuotientEquiv H.chosen H.source.quasisimple
  let : IsSimpleGroup (alternatingGroup (Fin 8)) := alternatingGroup.isSimpleGroup (by simp)
  let : IsSimpleGroup (Star L) := e.isSimpleGroup
  have hd : 3 ∣ Nat.card (Star L) := by
    rw [Nat.card_congr e.toEquiv,nat_card_alternatingGroup,Nat.card_fin]
    decide
  have hp : IsPPerfect 2 L := by
    intro N hN hq
    let := hN
    by_contra hne
    let : Nontrivial (L ⧸ N) := QuotientGroup.nontrivial_iff.mpr hne
    let : Group.IsPerfect (L ⧸ N) := Group.IsPerfect.ofSurjective (QuotientGroup.mk'_surjective N)
    let : Group.IsNilpotent (L ⧸ N) := hq.isNilpotent
    exact Group.IsPerfect.not_isSolvable (L ⧸ N) inferInstance
  exact perfectPrimeResidual_eq_self 3 L
    (primeToResidual_eq_top_of_simple_quotient 3 2 (pCore 2 L)
      pCore_isPGroup hp hd)

/-- The original prime-to-three residual of M is exactly L. -/
theorem SourceHypothesis.normalizer_primeToResidual
    (H : SourceHypothesis KnownSimple.IsKnownSimple T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) :
    (primeToResidual 3 (M L)).map (M L).subtype = L := by
  have hidx := Section02.RecognitionSource.FusionReducibleNormalizer.alternatingEight_normalizer_index_coprime_three
    H.source H.chosen (D.coreQuotientEquiv H.chosen H.source.quasisimple)
  apply le_antisymm
  · exact (map_mono (primeToResidual_le _ hidx)).trans_eq
      (map_subgroupOf_eq_of_le L.le_normalizer)
  · calc
      L = perfectPrimeResidual 3 L := (H.component_perfectPrimeResidual D).symm
      _ ≤ (primeToResidual 3 L).map L.subtype :=
        embedded_primeToResidual_mono 3 (map_subtype_le _)
      _ ≤ (primeToResidual 3 (M L)).map (M L).subtype :=
        embedded_primeToResidual_mono 3 L.le_normalizer

/-- At a point centralized by L with centralizer in M, the canonical residual is L. -/
theorem SourceHypothesis.Kv_eq_of_centralizer_bounds
    (H : SourceHypothesis KnownSimple.IsKnownSimple T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes)
    (z : G) (hL : L ≤ Gv z) (hM : Gv z ≤ M L) : Kv z = L := by
  apply le_antisymm
  · rw [← Kv_primeToResidual z]
    exact (embedded_primeToResidual_mono 3 ((Kv_le_Gv z).trans hM)).trans_eq
      (H.normalizer_primeToResidual D)
  · calc
      L = perfectPrimeResidual 3 L := (H.component_perfectPrimeResidual D).symm
      _ ≤ perfectPrimeResidual 3 (Gv z) := perfectPrimeResidual_mono 3 hL
      _ = Kv z := perfectPrimeResidual_eq 3 (Gv z)

omit [IsElementaryAbelian 2 V] in
/-- Uniqueness controls each nontrivial central-omega point when L centralizes Z. -/
theorem SourceHypothesis.central_omega_point_control
    (H : SourceHypothesis KnownSimple.IsKnownSimple T L V)
    (hLZ : L ≤ centralizer (Z T : Set G))
    (z : G) (hz : z ∈ Z T) (hne : z ≠ 1) : Gv z ≤ M L := by
  have hzcenter : z ∈ (center (T : Subgroup G)).map (T : Subgroup G).subtype :=
    omegaOneAmbient_le _ hz
  obtain ⟨zT,hzT,he⟩ := hzcenter
  have hzLT : zpowers z ≤ LT T L := zpowers_le.mpr (mem_sup_right (he ▸ zT.property))
  have hLT : LT T L ≤ Gv z := by
    apply sup_le
    · intro l hl
      exact (mem_centralizer_singleton_iff).mpr
        ((mem_centralizer_iff.mp (hLZ hl) z hz).symm)
    · intro t ht
      apply mem_centralizer_singleton_iff.mpr
      exact he ▸ congrArg Subtype.val ((mem_center_iff.mp hzT) ⟨t,ht⟩)
  have hne' : zpowers z ≠ ⊥ := by
    intro he
    exact hne (mem_bot.mp (he ▸ mem_zpowers z))
  have hcent : Gv z ≤ centralizer (zpowers z : Set G) := by
    apply le_centralizer_iff.mpr
    apply zpowers_le.mpr
    intro x hx
    exact (mem_centralizer_singleton_iff.mp hx)
  exact (hcent.trans (Subgroup.centralizer_le_normalizer _)).trans
    (H.chosen.normal_subgroup_normalizer_le H.source.toHypothesis1221 hzLT hne'
      (hLT.trans (hcent.trans (Subgroup.centralizer_le_normalizer _))))

/-- Transport an involution centralized by an ambient Sylow into the original
central omega, retaining the exact Sylow conjugator. -/
theorem exists_sylow_conjugator_into_Z (P T : Sylow 2 G)
    (v : G) (hv2 : v ^ 2 = 1) (hP : (P : Subgroup G) ≤ Gv v) :
    ∃ g : G, (P : Subgroup G).map (MulAut.conj g).toMonoidHom = (T : Subgroup G) ∧
      MulAut.conj g v ∈ Z T := by
  have hp : IsPGroup 2 (zpowers v) := IsPGroup.of_card_dvd_pow (n := 1) (by
    rw [Nat.card_zpowers, pow_one]
    exact orderOf_dvd_of_pow_eq_one hv2)
  have hc : v ∈ centralizer (P : Set G) := by
    intro x hx
    exact (mem_centralizer_singleton_iff.mp (hP hx))
  have hvP : v ∈ (P : Subgroup G) := by
    have hh : v ∈ zpowers v ⊓ normalizer (P : Set G) :=
      ⟨mem_zpowers v,Subgroup.centralizer_le_normalizer _ hc⟩
    rw [hp.inf_normalizer_sylow P] at hh
    exact hh.2
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq G P T
  have hmap : (P : Subgroup G).map (MulAut.conj g).toMonoidHom = (T : Subgroup G) :=
    congrArg Sylow.toSubgroup hg
  refine ⟨g,hmap,?_⟩
  have hvT : MulAut.conj g v ∈ (T : Subgroup G) := hmap ▸ mem_map_of_mem _ hvP
  have hz : (⟨MulAut.conj g v,hvT⟩ : (T : Subgroup G)) ∈ center (T : Subgroup G) := by
    apply mem_center_iff.mpr
    intro t
    have ht : (t : G) ∈ (P : Subgroup G).map (MulAut.conj g).toMonoidHom := hmap.symm ▸ t.property
    obtain ⟨x,hx,he⟩ := ht
    apply Subtype.ext
    change (t : G) * MulAut.conj g v = MulAut.conj g v * (t : G)
    rw [←he]
    change MulAut.conj g x * MulAut.conj g v = MulAut.conj g v * MulAut.conj g x
    exact ((MulAut.conj g).map_mul x v).symm.trans
      ((congrArg (MulAut.conj g) (mem_centralizer_iff.mp hc x hx)).trans
        ((MulAut.conj g).map_mul v x))
  apply (omegaOneAmbient_le_iff _ _).mp le_rfl (MulAut.conj g v)
    (mem_map_of_mem (T : Subgroup G).subtype hz)
  rw [←map_pow,hv2,map_one]

/-- The ambient Sylow conjugator carries the canonical nonsingular residual onto L. -/
theorem SourceHypothesis.nonsingular_sylow_component_conjugacy
    (H : SourceHypothesis KnownSimple.IsKnownSimple T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes)
    (hLZ : L ≤ centralizer (Z T : Set G))
    (v : V) (hv : D.Nonsingular v) (P : Sylow 2 G)
    (hP : (P : Subgroup G) ≤ Gv (v : G)) :
    ∃ g : G, (P : Subgroup G).map (MulAut.conj g).toMonoidHom = (T : Subgroup G) ∧
      MulAut.conj g (v : G) ∈ Z T ∧
      Gv (MulAut.conj g (v : G)) ≤ M L ∧
      (Kv (v : G)).map (MulAut.conj g).toMonoidHom = L := by
  obtain ⟨g,hg,hz⟩ := exists_sylow_conjugator_into_Z P T (v : G)
    (elemPow_eq_one_of_isElementaryAbelian (v : G) v.property) hP
  have hne : MulAut.conj g (v : G) ≠ 1 := by
    intro he
    have hh : v = 1 := Subtype.ext ((MulAut.conj g).map_eq_one_iff.mp he)
    exact nonsingular_ne_one D hv hh
  have hM := H.central_omega_point_control hLZ _ hz hne
  have hL : L ≤ Gv (MulAut.conj g (v : G)) := by
    intro l hl
    exact mem_centralizer_singleton_iff.mpr ((mem_centralizer_iff.mp (hLZ hl) _ hz).symm)
  refine ⟨g,hg,hz,hM,?_⟩
  rw [Kv_map_conjugation]
  exact H.Kv_eq_of_centralizer_bounds D _ hL hM

/-- The preferred-point application supplies the ambient Sylow in the
contrary normalizer branch. The earlier 12.6.1(6) centralization is supplied by the original Thompson generation. -/
theorem SourceHypothesis.exists_preferred_nonsingular_normalizer_conjugacy_of_fixed
    (H : SourceHypothesis KnownSimple.IsKnownSimple T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    (hTI : ∀ g ∈ M L, V ⊓ V.map (MulAut.conj g).toMonoidHom = ⊥ ∨
      V.map (MulAut.conj g).toMonoidHom = V)
    (hz : ZV L V ≠ ⊥)
    (v : V) (hv : D.Nonsingular v) (he : ¬ Gv (v : G) ≤ M L) :
    ∃ w : V, D.Nonsingular w ∧ ¬ Gv (w : G) ≤ M L ∧
      Chapter1.IsSylowIn 2 (Tv T (w : G)) (Mv L (w : G)) ∧
      (Tv T (w : G)).relIndex (T : Subgroup G) = 4 ∧
      Lv L (w : G) < Kv (w : G) ∧ ¬ Kv (w : G) ≤ M L ∧
      V ⊓ centralizer (Kv (w : G) : Set G) = zpowers (w : G) ∧
      ¬ IsQuasisimple (Kv (w : G)) ∧
      (normalizer (Rv T L (w : G) : Set G) ≤ M L →
        ∃ S : Sylow 2 (Gv (w : G)), ∃ g : G,
          let S₀ := (S : Subgroup (Gv (w : G))).map (Gv (w : G)).subtype
          Tv T (w : G) ≤ S₀ ∧
          S₀.map (MulAut.conj g).toMonoidHom = (T : Subgroup G) ∧
          MulAut.conj g (w : G) ∈ Z T ∧
          Gv (MulAut.conj g (w : G)) ≤ M L ∧
          (Kv (w : G)).map (MulAut.conj g).toMonoidHom = L ∧
          (Kv (w : G) ⊔ S₀).map (MulAut.conj g).toMonoidHom = LT T L ∧
          (Lv L (w : G)).map (MulAut.conj g).toMonoidHom < L) := by
  obtain ⟨w,hw,he,hs,hi,hlt,hnot,hline,hnq,hm⟩ :=
    H.exists_preferred_nonsingular_normalizer_line_of_fixed D hTV hTI hz v hv he
  refine ⟨w,hw,he,hs,hi,hlt,hnot,hline,hnq,fun hNM => ?_⟩
  have hJ := H.nonsingular_thompson_not_le_core_of_not_quasisimple D w hw hTV hnq hs hi hnot
  have hgen := (H.nonsingular_thompson_generation D w hw hTV hs hJ).2.2
  have hLZ := H.component_centralizes_Z_of_thompson_generation D hz hgen
  obtain ⟨_,_,S,hTS,⟨P,hP⟩,_⟩ := hm hNM
  have hPG : (P : Subgroup G) ≤ Gv (w : G) := hP ▸ map_subtype_le _
  obtain ⟨g,hg,hz,hM,hK⟩ := H.nonsingular_sylow_component_conjugacy D hLZ w hw P hPG
  rw [hP] at hg
  refine ⟨S,g,hTS,hg,hz,hM,hK,?_,?_⟩
  · rw [Subgroup.map_sup,hK,hg]
    rfl
  · have hh := (map_lt_map_iff_of_injective (f := (MulAut.conj g).toMonoidHom)
      (MulAut.conj g).injective).mpr hlt
    simpa only [hK] using hh

end CFSG.Quasithin.Chapter12.Section06
