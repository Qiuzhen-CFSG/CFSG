module
public import CFSG.Quasithin.Chapter12.Section06.Nonsingular.OriginalHigmanSimsResidualInvolutions
public import CFSG.Quasithin.ChapterA.Section03.SQTKStructure.NoncentralFitting.TwoRank
public import Theory.SpecificGroups.SL2.OddCoreAndRank

/-!
# An involution-generated perfect source excludes noncentral Fitting components

The noncentral alternatives have Fitting quotient SL2(p), p>3. Its
involutions are scalar. A perfect source generated by involutions thus
maps trivially into that quotient, and then trivially into the solvable
Fitting subgroup. This supplies the ordinary-component reduction for the
actual native HS residual without a rank-two image assumption.
-/

public section
open Subgroup Theory.GroupTheory
open scoped MatrixGroups
namespace CFSG.Quasithin.Chapter12.Section06.OriginalHigmanSimsResidualOrdinary

private theorem involution_central_slTwo
    {F : Type*} [Field F] (hF : (2 : F) ≠ 0)
    (x : SL(2,F)) (hx : x^2=1) : x ∈ center SL(2,F) := by
  have hd : (Matrix.SpecialLinearGroup.toGL x).det = 1 := by
    apply Units.ext
    exact x.property
  rcases Matrix.GeneralLinearGroup.eq_one_or_neg_one_of_sq_eq_one_of_det_eq_one hF
      (Matrix.SpecialLinearGroup.toGL x) (by rw [←map_pow,hx,map_one]) hd with he | he
  · have hx1 : x = 1 := Matrix.SpecialLinearGroup.toGL_injective (by simpa using he)
    rw [hx1]
    exact one_mem _
  · have hxm : x = -1 := Subtype.ext (congrArg Units.val he)
    rw [hxm]
    apply Subgroup.mem_center_iff.mpr
    intro y
    apply Subtype.ext
    simp

private theorem involution_source_maps_trivially_slTwo
    {A F : Type*} [Group A] [Group.IsPerfect A] [Field F]
    (hgen : closure {a : A | a^2=1} = ⊤) (hF : (2 : F) ≠ 0)
    (f : A →* SL(2,F)) : f.range = ⊥ := by
  have ht : (⊤ : Subgroup A) ≤ (center SL(2,F)).comap f := by
    rw [←hgen,Subgroup.closure_le]
    intro a ha
    exact involution_central_slTwo hF (f a) (by rw [←map_pow,ha,map_one])
  have hc : f.range ≤ center SL(2,F) := by
    rintro _ ⟨a,rfl⟩
    exact ht (mem_top a)
  let : Group.IsPerfect f.range := Group.IsPerfect.range f
  let : IsMulCommutative f.range :=
    ⟨⟨fun a b => Subtype.ext ((mem_center_iff.mp (hc a.property) b).symm)⟩⟩
  exact eq_bot_of_subsingleton _

/-- A nontrivial image of an involution-generated perfect group in a
core-free SQTK C-component forces that component to be quasisimple. -/
theorem quasisimple_of_perfect_involution_source
    {G A : Type*} [Group G] [Finite G] [Group A] [Group.IsPerfect A]
    {κ : GroupClass} (hG : IsSQTK κ G) (hO : pCore 2 G = ⊥)
    {K : Subgroup G} (hK : K.IsCComponent)
    (hgen : closure {a : A | a^2=1} = ⊤)
    (f : A →* K) (hf : f.range ≠ ⊥) : IsQuasisimple K := by
  have hfit : fittingSubgroup K ≤ center K := by
    by_contra hn
    obtain ⟨p,hp,hp3,⟨e⟩⟩ :=
      ChapterA.Section03.NoncentralFitting.primeSL2FittingQuotient_of_noncentral
        ChapterA.RankActions.primeSL2CoverRigidity hG hO hK hn
    let : Fact p.Prime := ⟨hp⟩
    have hp2 : (2 : ZMod p) ≠ 0 := by
      intro he
      exact Nat.not_dvd_of_pos_of_lt (by decide : 0 < 2) (by omega : 2 < p)
        ((ZMod.natCast_eq_zero_iff 2 p).mp he)
    let q := e.toMonoidHom.comp (QuotientGroup.mk' (fittingSubgroup K))
    have hq := involution_source_maps_trivially_slTwo hgen hp2 (q.comp f)
    have hle : f.range ≤ fittingSubgroup K := by
      rintro _ ⟨a,rfl⟩
      have hh : q (f a) = 1 := mem_bot.mp (hq ▸ (show q (f a) ∈ (q.comp f).range from ⟨a,rfl⟩))
      apply (QuotientGroup.eq_one_iff _).mp
      exact e.injective (hh.trans e.map_one.symm)
    let : Group.IsPerfect f.range := Group.IsPerfect.range f
    let : Nontrivial f.range := (Subgroup.nontrivial_iff_ne_bot _).mpr hf
    let : Group.IsSolvable f.range :=
      Group.isSolvable_of_isSolvable_injective (inclusion_injective hle)
    exact Group.IsPerfect.not_isSolvable f.range inferInstance
  have hs : solvableRadical K = center K := by
    apply le_antisymm (solvableRadical_le_center_of_fitting_le_center hfit)
    exact le_solvableRadical (center K) inferInstance
      (Group.isSolvable_of_comm (fun a b => Subtype.ext (mem_center_iff.mp a.property b).symm))
  let := hK.perfect
  let := hK.isSimpleGroup_quotient_solvableRadical
  exact ⟨(QuotientGroup.quotientMulEquivOfEq hs).symm.isSimpleGroup⟩

end CFSG.Quasithin.Chapter12.Section06.OriginalHigmanSimsResidualOrdinary
