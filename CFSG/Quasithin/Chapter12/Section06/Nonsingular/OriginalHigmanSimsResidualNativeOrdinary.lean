module
public import CFSG.Quasithin.Chapter12.Section06.Nonsingular.OriginalHigmanSimsResidualOrdinary
import all CFSG.Quasithin.Chapter12.Section06.Nonsingular.OriginalHigmanSimsSingularComponents

/-!
# Native common-residual images lie only in ordinary SQTK components

The actual native HS point residual is perfect and generated by its own
involutions. Its nontrivial image therefore excludes the odd-Fitting
SL2 alternatives. This statement concerns the actual residual, without
postulating a rank-two elementary subgroup in its image.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter12.Section06.OriginalHigmanSimsResidualOrdinary
open Sporadic.LeechRelated.HS Theory.GroupTheory.DoubleCoverCentralizer

/-- The exact native HS point residual supplies the perfect involution
source in every nontrivial image inside an SQTK C-component. -/
theorem quasisimple_of_native_residual_image
    {G : Type*} [Group G] [Finite G]
    {κ : GroupClass} (hG : IsSQTK κ G) (hO : pCore 2 G = ⊥)
    {K : Subgroup G} (hK : K.IsCComponent)
    (j : Carrier) (hj : orderOf j = 2) (hjc : TwoCentral j)
    (f : primeToResidual 3 (centralizer ({j} : Set Carrier)) →* K)
    (hf : f.range ≠ ⊥) : IsQuasisimple K := by
  let C := centralizer ({j} : Set Carrier)
  let R := primeToResidual 3 C
  obtain ⟨e⟩ := OriginalHigmanSimsSingularComponents.twoCentral_core_quotient_symmetricFive
    j hj hjc
  let : Group.IsPerfect R := (residual_of_symmetricFive_core_quotient e).1
  have hgen : closure {x : R | x^2=1} = ⊤ := by
    apply Subgroup.map_injective R.subtype_injective
    rw [MonoidHom.map_closure,← MonoidHom.range_eq_map,subtype_range]
    change _ = primeToResidual 3 (centralizer ({j} : Set Carrier))
    rw [OriginalHigmanSimsResidualInvolutions.twoCentral_residual_generated j hj hjc]
    congr 1
    ext x
    constructor
    · rintro ⟨y,hy,rfl⟩
      exact ⟨y.property,congrArg Subtype.val hy⟩
    · rintro ⟨hx,hx2⟩
      exact ⟨⟨x,hx⟩,Subtype.ext hx2,rfl⟩
  exact quasisimple_of_perfect_involution_source hG hO hK hgen f hf

end CFSG.Quasithin.Chapter12.Section06.OriginalHigmanSimsResidualOrdinary
