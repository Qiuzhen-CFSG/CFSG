module
public import CFSG.Quasithin.Chapter12.Section06.Nonsingular.OriginalHigmanSimsGlobalNative
public import CFSG.Quasithin.Chapter12.Section06.Nonsingular.OriginalHigmanSimsNative
import all CFSG.Quasithin.Chapter12.Section06.Nonsingular.OriginalHigmanSimsNative
import all Theory.SpecificGroups.LeechRelated.AtlasCarriers.HS.LocalGeneration
public import Theory.GroupTheory.ConjugateSpanSylow
public import Theory.GroupTheory.PResidual.PrimeToMonotone
public import Theory.GroupTheory.Fitting.Centralizer

/-!
# The native HS point core is generated by the pure seed

The intersection of the marked pure sixteen-subgroup with the actual point
core contains eight displayed elements. Conjugating this seed by two explicit
cubic elements generates every row of the core. The existing marked Sylow
catalogue makes this exhaustive; fixing the two letter-pairs at0 and2 already
identifies its64 core rows. Each generator equation is checked on the two
letters that distinguish Sylow rows. Cubic order puts both actors in the
actual prime-to-three residual, without identifying that residual abstractly.

Conjugation transports the resulting equality to any pure elementary
sixteen-subgroup and any of its nonidentity points, preserving the full
point centralizer, two-core, and embedded residual.
Source: Aschbacher--Smith12.6.12, printed pp.825--826; GLS3 Table5.3m.
-/

public section
namespace CFSG.Quasithin.Chapter12.Section06.OriginalHigmanSimsCoreSpanNative
open Subgroup Theory.GroupTheory Sporadic.LeechRelated.HS
open EvenLocalCandidates EvenLocalCandidates.SylowCatalogueData BlockNormalizer
open EvenLocalCandidates.CentralInvolutionCore
open OriginalHigmanSimsImageIntersectionsNative
set_option maxRecDepth 10000

private abbrev C : Subgroup Carrier := localGroup 0
private abbrev Q : Subgroup Carrier := C.pCoreIn 2
private abbrev J : Subgroup Carrier := (primeToResidual 3 C).map C.subtype
private abbrev U : Subgroup Carrier := conjugateSpanBy (markedW ⊓ Q) J

private def seedRow (i : Fin 8) : Fin 512 :=
  ⟨(4565117697958349378560 >>> (9*i.val)) % 512 % 512,Nat.mod_lt _ (by decide)⟩

private def seedCode (i : Fin 8) : Fin 16 :=
  ⟨(3989402912 >>> (4*i.val)) % 16 % 16,Nat.mod_lt _ (by decide)⟩

private def generatorRow (i : Fin 24) : Fin 512 :=
  ⟨(62330025177562524615195344887121950759908273882902669822595175424 >>> (9*i.val)) % 512 % 512,Nat.mod_lt _ (by decide)⟩

private def coreRow (i : Fin 64) : Fin 512 :=
  ⟨(227019879188409781231239707490695705976946349480758689486985370887220163961115639097896048425829444143614169390414233443389616429280026110630413767958963378533689238292534272 >>> (9*i.val)) % 512 % 512,Nat.mod_lt _ (by decide)⟩

private def coreCode (i : Fin 512) : Fin 64 :=
  ⟨( >>> (6*i.val)) % 64 % 64,Nat.mod_lt _ (by decide)⟩

private def parent (i : Fin 64) : Fin 64 :=
  ⟨(25017146418577014935115587729956027129781769095833540207768445632660159435906214915158910072426721197782048387891200 >>> (6*i.val)) % 64 % 64,Nat.mod_lt _ (by decide)⟩

private def step (i : Fin 64) : Fin 24 :=
  ⟨(1511486209977719402958558897571297068763250090476486298970867437983214697932559864720735802066976 >>> (5*i.val)) % 32 % 24,Nat.mod_lt _ (by decide)⟩

private def seedLocal (i : Fin 8) : C :=
  ⟨element (seedRow i),LocalGeneration.sylow_le_member 0 (element_mem _)⟩

private theorem seed_mem (i : Fin 8) : (seedLocal i).val ∈ markedW ⊓ Q := by
  constructor
  · refine ⟨seedCode i,?_⟩
    change element (candidateRow 0 (seedCode i)) = element (seedRow i)
    have h : ∀ i : Fin 8, candidateRow 0 (seedCode i) = seedRow i := by decide +kernel
    rw [h]
  · refine ⟨seedLocal i,?_,rfl⟩
    rw [←LocalGeneration.first_core_eq]
    apply (mem_core_iff _).mpr
    have h : ∀ (i : Fin 8) (p : Fin 100), (e0 : Equiv.Perm (Fin 100)) p = p →
        point (seedRow i) p = p ∨ point (seedRow i) p = twin p := by
      apply SylowCatalogueData.allFin
      decide +kernel
    intro p hp
    simpa only [seedLocal,element_point] using h i p hp

private def actor (i : Fin 2) : C :=
  (MulAut.conj ((OriginalHigmanSimsNative.eight)⁻¹ ^ (2*i.val+1)))
    OriginalHigmanSimsNative.triple

private theorem actor_residual (i : Fin 2) : (actor i).val ∈ J := by
  refine ⟨actor i,mem_primeToResidual_of_pow (n := 1) ?_,rfl⟩
  change actor i ^ 3 = 1
  unfold actor
  rw [←map_pow,OriginalHigmanSimsNative.triple_cube,map_one]

private def generatorWord (i : Fin 24) : C :=
  if hi : i.val < 8 then seedLocal ⟨i.val,hi⟩
  else (actor ⟨i.val/8-1,by omega⟩) * seedLocal ⟨i.val%8,Nat.mod_lt _ (by decide)⟩ *
    (actor ⟨i.val/8-1,by omega⟩)⁻¹

private theorem generator_word (i : Fin 24) :
    (generatorWord i).val = element (generatorRow i) := by
  apply Subtype.ext
  apply Equiv.ext
  have h : ∀ (i : Fin 24) (p : Fin 100),
      (generatorWord i).val.val p = point (generatorRow i) p := by
    apply SylowCatalogueData.allFin
    decide +kernel
  intro p
  simpa only [element_point] using h i p

private theorem generator_mem (i : Fin 24) : element (generatorRow i) ∈ U := by
  rw [←generator_word]
  unfold generatorWord
  split
  · exact le_conjugateSpanBy _ _ (seed_mem _)
  · exact subset_closure ⟨_,actor_residual _,_,seed_mem _,rfl⟩

private theorem eq_of_two_points {x y : Carrier} (hx : x ∈ subgroup) (hy : y ∈ subgroup)
    (h1 : (x : Equiv.Perm (Fin 100)) 1 = (y : Equiv.Perm (Fin 100)) 1)
    (h4 : (x : Equiv.Perm (Fin 100)) 4 = (y : Equiv.Perm (Fin 100)) 4) : x=y := by
  obtain ⟨i,rfl⟩ := element_surjective hx
  obtain ⟨j,rfl⟩ := element_surjective hy
  apply congrArg element
  apply Fin.ext
  rw [←decode_point i,←decode_point j]
  simp only [element_point] at h1 h4
  rw [h1,h4]

private theorem parent_lt : ∀ i : Fin 64, i.val ≠ 0 → (parent i).val < i.val := by
  decide +kernel

private theorem row_product (i : Fin 64) (hi : i.val ≠ 0) :
    element (coreRow i) = element (coreRow (parent i)) * element (generatorRow (step i)) := by
  have h : ∀ (i : Fin 64) (p : Fin 2), i.val ≠ 0 →
      point (coreRow i) (![1,4] p) =
        point (coreRow (parent i)) (point (generatorRow (step i)) (![1,4] p)) := by
    apply SylowCatalogueData.allFin
    decide +kernel
  apply eq_of_two_points (element_mem _) (subgroup.mul_mem (element_mem _) (element_mem _))
  · simpa only [Subgroup.coe_mul,Equiv.Perm.mul_apply,element_point,
      Matrix.cons_val_zero] using h i 0 hi
  · simpa only [Subgroup.coe_mul,Equiv.Perm.mul_apply,element_point,
      Matrix.cons_val_one,Matrix.cons_val_zero,Matrix.head_cons] using h i 1 hi

private theorem rows_mem (i : Fin 64) : element (coreRow i) ∈ U := by
  have h : ∀ n : ℕ, ∀ hn : n < 64, element (coreRow ⟨n,hn⟩) ∈ U := by
    intro n
    induction n using Nat.strong_induction_on with
    | h n ih =>
      intro hn
      by_cases hz : n=0
      · subst n
        have hzero : coreRow 0 = 0 := by decide +kernel
        change element (coreRow 0) ∈ U
        rw [hzero]
        exact U.one_mem
      · rw [row_product ⟨n,hn⟩ hz]
        exact U.mul_mem (ih _ (parent_lt ⟨n,hn⟩ hz) _) (generator_mem _)
  exact h i.val i.isLt

private theorem core_coverage : ∀ i : Fin 512,
    (point i 0 = 0 ∨ point i 0 = twin 0) →
    (point i 2 = 2 ∨ point i 2 = twin 2) → coreRow (coreCode i) = i := by
  apply SylowCatalogueData.allFin
  decide +kernel

private theorem marked_core_le_span : Q ≤ U := by
  intro x hx
  have hs : x ∈ subgroup := by
    have h := pCoreIn_le_sylow C (baseSylow.subtype (LocalGeneration.sylow_le_member 0)) hx
    obtain ⟨y,hy,rfl⟩ := h
    exact hy
  obtain ⟨i,rfl⟩ := element_surjective hs
  obtain ⟨y,hy,hye⟩ := hx
  have hc : y ∈ core := LocalGeneration.first_core_eq ▸ hy
  have h0 := (mem_core_iff y).mp hc 0 (by decide +kernel)
  have h2 := (mem_core_iff y).mp hc 2 (by decide +kernel)
  have hy0 := congrArg (fun a : Carrier => (a : Equiv.Perm (Fin 100)) 0) hye
  have hy2 := congrArg (fun a : Carrier => (a : Equiv.Perm (Fin 100)) 2) hye
  change y.val.val 0 = (element i : Equiv.Perm (Fin 100)) 0 at hy0
  change y.val.val 2 = (element i : Equiv.Perm (Fin 100)) 2 at hy2
  simp only [element_point] at hy0 hy2
  rw [hy0] at h0
  rw [hy2] at h2
  rw [←core_coverage i h0 h2]
  exact rows_mem _

private theorem marked_core_span :
    conjugateSpanBy (markedW ⊓ Q) J = Q := by
  apply le_antisymm _ marked_core_le_span
  apply conjugateSpanBy_le inf_le_right
  exact (map_subtype_le _).trans (C.le_normalizer.trans
    (normalizer_le_normalizer_characteristic_image C (pCore 2 C)))

/-- The full point two-core is generated by the residual-conjugates of
its intersection with the supplied pure elementary sixteen-subgroup. -/
theorem pure_sixteen_core_span
    (W : Subgroup Carrier) (hW : IsElementaryAbelian 2 W) (hcard : Nat.card W = 16)
    (hp : ∀ x ∈ W, ∃ p : Fin 100, (x : Equiv.Perm (Fin 100)) p = p)
    (j : Carrier) (hj : j ∈ W) (hne : j ≠ 1) :
    let F := centralizer ({j} : Set Carrier)
    conjugateSpanBy (W ⊓ F.pCoreIn 2) ((primeToResidual 3 F).map F.subtype) = F.pCoreIn 2 := by
  obtain ⟨g,hg⟩ := pure_sixteen_conjugate W hW hcard hp
  have hjW : (MulAut.conj g) j ∈ markedW := hg ▸ mem_map_of_mem _ hj
  have hjne : (MulAut.conj g) j ≠ 1 := by
    intro he
    exact hne ((MulAut.conj g).injective (he.trans (map_one (MulAut.conj g)).symm))
  obtain ⟨k,hk,hkj⟩ := markedW_point_transitive _ hjW hjne
  let α : MulAut Carrier := MulAut.conj k * MulAut.conj g
  have hmark : W.map α.toMonoidHom = markedW := by
    change W.map ((MulAut.conj k).toMonoidHom.comp (MulAut.conj g).toMonoidHom) = markedW
    rw [←Subgroup.map_map,hg]
    exact mem_normalizer_iff_map_conj_eq.mp hk
  have hpoint : α j = e0 := hkj
  have hcent : (centralizer ({j} : Set Carrier)).map α.toMonoidHom = C := by
    rw [map_centralizer_equiv,Set.image_singleton,hpoint,←LocalGeneration.first_eq_centralizer]
  dsimp only
  apply map_injective (f := α.toMonoidHom) α.injective
  rw [map_conjugateSpanBy,Subgroup.map_inf _ _ _ α.injective,hmark,
    map_pCoreIn_of_injective 2 _ _ α.injective,hcent,
    map_embedded_primeToResidual 3 _ α,hcent]
  exact marked_core_span

/-- The same generation equality inside the literal point centralizer,
retaining its intrinsic core and intrinsic residual for covering maps. -/
theorem pure_sixteen_core_span_intrinsic
    (W : Subgroup Carrier) (hW : IsElementaryAbelian 2 W) (hcard : Nat.card W = 16)
    (hp : ∀ x ∈ W, ∃ p : Fin 100, (x : Equiv.Perm (Fin 100)) p = p)
    (j : Carrier) (hj : j ∈ W) (hne : j ≠ 1) :
    let F := centralizer ({j} : Set Carrier)
    conjugateSpanBy (W.subgroupOf F ⊓ pCore 2 F) (primeToResidual 3 F) = pCore 2 F := by
  let := hW
  let F := centralizer ({j} : Set Carrier)
  have hWF : W ≤ F := by
    intro x hx
    exact mem_centralizer_singleton_iff.mpr (setLike_mul_comm hx hj)
  change conjugateSpanBy (W.subgroupOf F ⊓ pCore 2 F) (primeToResidual 3 F) = pCore 2 F
  apply map_injective (f := F.subtype) F.subtype_injective
  rw [map_conjugateSpanBy,Subgroup.map_inf _ _ _ F.subtype_injective,
    map_subgroupOf_eq_of_le hWF]
  exact pure_sixteen_core_span W hW hcard hp j hj hne

end CFSG.Quasithin.Chapter12.Section06.OriginalHigmanSimsCoreSpanNative
