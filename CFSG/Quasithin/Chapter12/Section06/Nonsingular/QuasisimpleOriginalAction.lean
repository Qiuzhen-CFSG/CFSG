module
public import CFSG.Quasithin.Chapter12.Section06.Nonsingular.QuasisimpleJankoFourCentralLine
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.HS.AutomorphismTwoRank

/-!
# The original V-action in the HS branch

Retain the conjugation action of the full original V on K_v/Z(K_v),
transported through the supplied model isomorphism. Its kernel is the
original component centralizer. Its commutator with the L_v-image is the
literal image of V_v, and V centralizes that moved image.

In the HS row, the original corank bound and the native automorphism
rank bound force this action to have order 32. Consequently C_V(K_v)
and C_V(L_v) coincide. If K_v escapes M, source normalizer uniqueness
then forces C_V(L)=1. The original coordinates give |V|=64. The intrinsic
HS rank bound identifies the inner part of the action with the order-16
moved image; thus V meets K_v in precisely V_v. Both C_V(K_v) and the
ambient image of Z(K_v) are the original line generated by v.

The preferred-point application retains the original Sylow and component
premises and the compatible covering catalogue. With nontrivial original
fixed space this excludes HS, leaving only Ru and J4. The HS branch with
trivial fixed space, the other two exclusions, blocks, splitting and the
full fixed-space argument remain open; neither 12.6.2 nor 12.6.23 is
asserted. Earlier invariance and TI retain producer qt-d-1222-source and
final discharge owner qt-d-12634-source.

Source: Aschbacher--Smith, proof of 12.6.12, printed pp.825--826; the
native HS automorphism-rank estimate is the one used in G.7.3(2), p.348.
-/

public section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter12.Section06
variable {G : Type*} [Group G] [Finite G]
variable {F : Type*} [Group F]

/-- The literal point-centralizer action on the specified central-quotient model. -/
@[expose] def nonsingularModelAction (v : G)
    (e : ((Kv v) ⧸ center (Kv v)) ≃* F) : Gv v →* MulAut F :=
  (MulAut.centralQuotientAction e).comp ((Kv v).normalizerMonoidHom.comp
    (inclusion ((normal_subgroupOf_iff_le_normalizer (Kv_le_Gv v)).mp (Kv_normalIn_Gv v))))

omit [Finite G] in
theorem nonsingularModelAction_on_component (v : G)
    (e : ((Kv v) ⧸ center (Kv v)) ≃* F) (x : Kv v) :
    nonsingularModelAction v e (inclusion (Kv_le_Gv v) x) =
      MulAut.conj (e (QuotientGroup.mk' (center (Kv v)) x)) := by
  unfold nonsingularModelAction
  rw [MonoidHom.comp_apply,MonoidHom.comp_apply]
  have hinner : (Kv v).normalizerMonoidHom (inclusion
      ((normal_subgroupOf_iff_le_normalizer (Kv_le_Gv v)).mp (Kv_normalIn_Gv v))
      (inclusion (Kv_le_Gv v) x)) = MulAut.conj x := by
    ext y
    rfl
  rw [hinner,MulAut.centralQuotientAction_conj]

omit [Finite G] in
theorem nonsingularModelAction_ker (v : G) [Group.IsPerfect (Kv v)]
    (e : ((Kv v) ⧸ center (Kv v)) ≃* F) :
    (nonsingularModelAction v e).ker = (centralizer (Kv v : Set G)).subgroupOf (Gv v) := by
  ext x
  change MulAut.centralQuotientAction e ((Kv v).normalizerMonoidHom
    (inclusion ((normal_subgroupOf_iff_le_normalizer (Kv_le_Gv v)).mp (Kv_normalIn_Gv v)) x)) = 1 ↔ _
  rw [← (MulAut.centralQuotientAction e).map_one,
    (MulAut.centralQuotientAction_injective e).eq_iff]
  change inclusion _ x ∈ (Kv v).normalizerMonoidHom.ker ↔ _
  rw [normalizerMonoidHom_ker]
  rfl

variable {T : Sylow 2 G} {L V : Subgroup G} [IsElementaryAbelian 2 V]

/-- The full original V-action retains its centralizer kernel and its literal moved subgroup. -/
theorem SourceHypothesis.nonsingular_original_model_action
    {K : GroupClass} (H : SourceHypothesis K T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) (v : V) (hv : D.Nonsingular v)
    (hK : IsQuasisimple (Kv (v : G)))
    (e : ((Kv (v : G)) ⧸ center (Kv (v : G))) ≃* F) :
    let a := nonsingularModelAction (v : G) e
    let E := (V.subgroupOf (Gv (v : G))).map a
    let B := ((Lv L (v : G)).subgroupOf (Gv (v : G))).map a
    let W := ((Vv L V (v : G)).subgroupOf (Gv (v : G))).map a
    IsElementaryAbelian 2 E ∧
      Nat.card E = (centralizer (Kv (v : G) : Set G)).relIndex V ∧
      32 ≤ Nat.card E ∧ ⁅E,B⁆ = W ∧ W ≤ E ∧
      B ≤ normalizer (E : Set (MulAut F)) ∧
      E ≤ centralizer (W : Set (MulAut F)) := by
  let := hK
  let : Finite F := Finite.of_equiv ((Kv (v : G)) ⧸ center (Kv (v : G))) e.toEquiv
  let A := Gv (v : G)
  let a := nonsingularModelAction (v : G) e
  let E := (V.subgroupOf A).map a
  let B := ((Lv L (v : G)).subgroupOf A).map a
  let W := ((Vv L V (v : G)).subgroupOf A).map a
  let r := a.comp (inclusion (V_le_Gv v))
  have hr : r.range = E := by rw [MonoidHom.range_comp,inclusion_range]
  have hk : r.ker = (centralizer (Kv (v : G) : Set G)).subgroupOf V := by
    rw [←MonoidHom.comap_ker,nonsingularModelAction_ker]
    rfl
  have he : IsElementaryAbelian 2 E := hr ▸
    IsElementaryAbelian.of_surjective r.rangeRestrict r.rangeRestrict_surjective
  let := he
  have hc : Nat.card E = (centralizer (Kv (v : G) : Set G)).relIndex V := by
    rw [←hr,←index_ker,hk]
    rfl
  have hl : 32 ≤ Nat.card E := by
    have hlog := H.nonsingular_component_centralizer_corank D v hv
    rw [←hc] at hlog
    exact (Nat.pow_le_pow_right (by decide : 0 < (2 : ℕ)) hlog).trans
      (Nat.pow_log_le_self 2 Nat.card_pos.ne')
  have hm : ⁅E,B⁆ = W := by
    rw [←map_commutator]
    congr 1
    apply map_injective A.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le (V_le_Gv v),
      map_subgroupOf_eq_of_le (Lv_le_Gv L (v : G)),
      map_subgroupOf_eq_of_le ((Vv_le_V H.chosen.normalizes _).trans (V_le_Gv v))]
    rfl
  have hWE : W ≤ E := map_mono (comap_mono (Vv_le_V H.chosen.normalizes _))
  refine ⟨he,hc,hl,hm,hWE,?_,?_⟩
  · apply (map_mono (f := a) ?_).trans (le_normalizer_map a)
    rw [←subgroupOf_normalizer_eq (V_le_Gv v)]
    exact comap_mono ((Lv_le_L L _).trans H.chosen.normalizes)
  · intro x hx w hw
    exact setLike_mul_comm (hWE hw) hx

omit [Finite G] in
/-- Restriction to a subgroup of K_v agrees with the literal central projection and inner action. -/
theorem nonsingularModelAction_map (v : G)
    (e : ((Kv v) ⧸ center (Kv v)) ≃* F) (W : Subgroup G) (hW : W ≤ Kv v) :
    (W.subgroupOf (Gv v)).map (nonsingularModelAction v e) =
      ((W.subgroupOf (Kv v)).map (QuotientGroup.mk' (center (Kv v)))).map
        (MulAut.conj.comp e.toMonoidHom) := by
  let j := inclusion (Kv_le_Gv v)
  have he : (W.subgroupOf (Kv v)).map j = W.subgroupOf (Gv v) := by
    apply map_injective (Gv v).subtype_injective
    rw [map_map]
    change (W.subgroupOf (Kv v)).map (Kv v).subtype = _
    rw [map_subgroupOf_eq_of_le hW,map_subgroupOf_eq_of_le (hW.trans (Kv_le_Gv v))]
  rw [←he,map_map,map_map]
  congr 1
  exact MonoidHom.ext (nonsingularModelAction_on_component v e)

/-- In the HS row the full original action has exactly 32 elements, and the
local and component centralizers have exactly the same intersection with V. -/
theorem SourceHypothesis.nonsingular_hs_original_centralizer
    {K : GroupClass} (H : SourceHypothesis K T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) (v : V) (hv : D.Nonsingular v)
    (hK : IsQuasisimple (Kv (v : G)))
    (e : ((Kv (v : G)) ⧸ center (Kv (v : G))) ≃* Sporadic.LeechRelated.HS.Carrier) :
    Nat.card ((V.subgroupOf (Gv (v : G))).map (nonsingularModelAction (v : G) e)) = 32 ∧
      V ⊓ centralizer (Kv (v : G) : Set G) = V ⊓ centralizer (Lv L (v : G) : Set G) := by
  let E := (V.subgroupOf (Gv (v : G))).map (nonsingularModelAction (v : G) e)
  obtain ⟨he,hcard,hl,_⟩ := H.nonsingular_original_model_action D v hv hK e
  have hu := (primeRank_le_iff_elementary_card_le (MulAut Sporadic.LeechRelated.HS.Carrier)).mp
    Sporadic.LeechRelated.HS.automorphism_twoRank_le_five E he
  have hE : Nat.card E = 32 := Nat.le_antisymm hu hl
  refine ⟨hE,?_⟩
  let C := (centralizer (Kv (v : G) : Set G)).subgroupOf V
  let B := (centralizer (Lv L (v : G) : Set G)).subgroupOf V
  have hCB : C ≤ B := comap_mono (centralizer_le (Lv_le_Kv_of_A6 L _
    (Classical.choice (D.nonsingular_local_quotient H.chosen H.source.quasisimple v hv))))
  have hCi : C.index = 32 := hcard.symm.trans hE
  have hBi : 32 ≤ B.index :=
    (Nat.pow_le_pow_right (by decide : 0 < (2 : ℕ))
      (D.nonsingular_local_centralizer_corank H.chosen v hv)).trans
      (Nat.pow_log_le_self 2 (index_ne_zero_of_finite : B.index ≠ 0))
  have heq : C = B := by
    by_contra hh
    have hi := index_strictAnti (lt_of_le_of_ne hCB hh)
    omega
  have hh := congrArg (map V.subtype) heq
  simpa only [C,B,subgroupOf,map_comap_eq,range_subtype,inf_comm] using hh

/-- The HS branch has no nontrivial original L-fixed space at an escaping component. -/
theorem SourceHypothesis.nonsingular_hs_fixed_eq_bot
    (H : SourceHypothesis KnownSimple.IsKnownSimple T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) (v : V) (hv : D.Nonsingular v)
    (hK : IsQuasisimple (Kv (v : G)))
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    (hnot : ¬ Kv (v : G) ≤ M L)
    (e : ((Kv (v : G)) ⧸ center (Kv (v : G))) ≃* Sporadic.LeechRelated.HS.Carrier) :
    ZV L V = ⊥ := by
  by_contra hz
  have hn : normalizer (ZV L V : Set G) ≤ M L :=
    H.chosen.normal_subgroup_normalizer_le H.source.toHypothesis1221
      (inf_le_left.trans (H.chosen.le_component.trans le_sup_left)) hz
      ((D.join_centralizes_fixed H.chosen hTV).trans (Subgroup.centralizer_le_normalizer _))
  apply hnot
  have hZC : ZV L V ≤ centralizer (Kv (v : G) : Set G) := by
    have heq := (H.nonsingular_hs_original_centralizer D v hv hK e).2
    have hzB : ZV L V ≤ V ⊓ centralizer (Lv L (v : G) : Set G) :=
      inf_le_inf le_rfl (centralizer_le (Lv_le_L L _))
    exact (hzB.trans heq.ge).trans inf_le_right
  exact (Subgroup.le_centralizer_iff.mp hZC).trans
    ((Subgroup.centralizer_le_normalizer _).trans hn)

/-- The original HS action has precisely the moved image as its inner part,
with index two. This uses the actual component projection throughout. -/
theorem SourceHypothesis.nonsingular_hs_original_inner_part
    {K : GroupClass} (H : SourceHypothesis K T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) (v : V) (hv : D.Nonsingular v)
    (hK : IsQuasisimple (Kv (v : G)))
    (e : ((Kv (v : G)) ⧸ center (Kv (v : G))) ≃* Sporadic.LeechRelated.HS.Carrier) :
    let a := nonsingularModelAction (v : G) e
    let E := (V.subgroupOf (Gv (v : G))).map a
    let W := ((Vv L V (v : G)).subgroupOf (Gv (v : G))).map a
    Nat.card E = 32 ∧ Nat.card W = 16 ∧
      E ⊓ MulAut.innerSubgroup Sporadic.LeechRelated.HS.Carrier = W ∧
      W.relIndex E = 2 := by
  let F := Sporadic.LeechRelated.HS.Carrier
  let a := nonsingularModelAction (v : G) e
  let E := (V.subgroupOf (Gv (v : G))).map a
  let W := ((Vv L V (v : G)).subgroupOf (Gv (v : G))).map a
  let C := Kv (v : G)
  let q := QuotientGroup.mk' (center C)
  let j := (MulAut.conj : F →* MulAut F).comp e.toMonoidHom
  have hi : Function.Injective (MulAut.conj : F →* MulAut F) :=
    MulAut.conj_injective_of_center_eq_bot Sporadic.LeechRelated.HS.BlockNormalizer.center_carrier_eq_bot
  have hWC := (H.nonsingular_component_rank D v hv).1
  have hWmap : W = (((Vv L V (v : G)).subgroupOf C).map q).map j :=
    nonsingularModelAction_map (v : G) e _ hWC
  have hj : Function.Injective j := fun x y h => e.injective (hi h)
  have hWcard : Nat.card W = 16 := by
    rw [hWmap,card_map_of_injective hj]
    exact H.nonsingular_hs_moved_image_card D v hv ⟨e⟩
  obtain ⟨he,_,_,_,hWE,_,_⟩ := H.nonsingular_original_model_action D v hv hK e
  let := he
  have hEcard := (H.nonsingular_hs_original_centralizer D v hv hK e).1
  let U := E.comap (MulAut.conj : F →* MulAut F)
  have hu : IsElementaryAbelian 2 U := IsElementaryAbelian.comap_of_injective _ hi E
  have hUcard := (primeRank_le_iff_elementary_card_le F).mp
    Sporadic.LeechRelated.HS.twoRank_le_four U hu
  have hm : U.map (MulAut.conj : F →* MulAut F) = E ⊓ MulAut.innerSubgroup F := by
    simpa only [inf_comm] using map_comap_eq (MulAut.conj : F →* MulAut F) E
  have hIcard : Nat.card (E ⊓ MulAut.innerSubgroup F : Subgroup (MulAut F)) ≤ 16 := by
    rw [←hm,card_map_of_injective hi]
    exact hUcard
  have hWI : W ≤ MulAut.innerSubgroup F := by
    rw [hWmap]
    rintro _ ⟨x,_,rfl⟩
    exact ⟨e x,rfl⟩
  have hIW : E ⊓ MulAut.innerSubgroup F = W :=
    (eq_of_le_of_card_ge (le_inf hWE hWI) (hWcard ▸ hIcard)).symm
  refine ⟨hEcard,hWcard,hIW,?_⟩
  have hc := (W.subgroupOf E).card_mul_index
  rw [Nat.card_congr (subgroupOfEquivOfLe hWE).toEquiv,hWcard,hEcard] at hc
  change 16 * W.relIndex E = 16 * 2 at hc
  exact Nat.eq_of_mul_eq_mul_left (by decide : 0 < 16) hc

/-- In the escaping HS row the original module has order 64, its intersection
with the component is exactly V_v, and v generates both its component
centralizer and the ambient image of the component center. -/
theorem SourceHypothesis.nonsingular_hs_original_geometry
    (H : SourceHypothesis KnownSimple.IsKnownSimple T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) (v : V) (hv : D.Nonsingular v)
    (hK : IsQuasisimple (Kv (v : G)))
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    (hnot : ¬ Kv (v : G) ≤ M L)
    (e : ((Kv (v : G)) ⧸ center (Kv (v : G))) ≃* Sporadic.LeechRelated.HS.Carrier) :
    Nat.card V = 64 ∧
      V ⊓ centralizer (Kv (v : G) : Set G) = zpowers (v : G) ∧
      V ⊓ Kv (v : G) = Vv L V (v : G) ∧
      (center (Kv (v : G))).map (Kv (v : G)).subtype = zpowers (v : G) := by
  let := hK
  let C := Kv (v : G)
  let A := Gv (v : G)
  let a := nonsingularModelAction (v : G) e
  have hz := H.nonsingular_hs_fixed_eq_bot D v hv hK hTV hnot e
  have hfix : (fixedSeed L V H.chosen.normalizes).toSubmodule = ⊥ := by
    apply bot_unique
    intro w hw
    have hh := (mem_fixedSeed_iff L V H.chosen.normalizes w).mp hw
    rw [hz,mem_bot] at hh
    exact (show w = 0 from Additive.toMul.injective (Subtype.ext hh))
  let q := (fixedSeed L V H.chosen.normalizes).toSubmodule.mkQ
  have hq : Function.Bijective q :=
    ⟨LinearMap.ker_eq_bot.mp (by rw [Submodule.ker_mkQ,hfix]),Submodule.mkQ_surjective _⟩
  let c := (LinearEquiv.ofBijective q hq).trans D.coordinates
  have hV : Nat.card V = 64 := by
    change Nat.card (Additive V) = 64
    rw [Nat.card_congr c.toEquiv,Module.natCard_eq_pow_finrank (K := ZMod 2),
      BinaryPermutation.finrank_natural_even (Fin 8) (by decide),Nat.card_zmod]
    decide
  have ha : Nat.card ((V.subgroupOf A).map a) = 32 :=
    (H.nonsingular_hs_original_centralizer D v hv hK e).1
  have hci : (centralizer (C : Set G)).relIndex V = 32 :=
    (H.nonsingular_original_model_action D v hv hK e).2.1.symm.trans ha
  have hVC : Nat.card ((centralizer (C : Set G)).subgroupOf V) = 2 := by
    have hh := ((centralizer (C : Set G)).subgroupOf V).card_mul_index
    change Nat.card ((centralizer (C : Set G)).subgroupOf V) *
      (centralizer (C : Set G)).relIndex V = Nat.card V at hh
    rw [hci,hV] at hh
    omega
  have hcent : V ⊓ centralizer (C : Set G) = zpowers (v : G) := by
    have hle : zpowers (v : G) ≤ V ⊓ centralizer (C : Set G) := by
      apply zpowers_le.mpr
      refine ⟨v.property,?_⟩
      intro x hx
      exact mem_centralizer_singleton_iff.mp (Kv_le_Gv (v : G) hx)
    apply (eq_of_le_of_card_ge hle ?_).symm
    have hh : Nat.card (V ⊓ centralizer (C : Set G) : Subgroup G) = 2 := by
      have heq : ((centralizer (C : Set G)).subgroupOf V).map V.subtype =
          V ⊓ centralizer (C : Set G) := by
        rw [subgroupOf,map_comap_eq,range_subtype]
      rw [←heq,card_map_of_injective V.subtype_injective,hVC]
    have hv2 : orderOf (v : G) = 2 := orderOf_eq_prime
      (elemPow_eq_one_of_isElementaryAbelian _ v.property)
      (fun he => nonsingular_ne_one D hv (Subtype.ext he))
    rw [hh,Nat.card_zpowers,hv2]
  have hline := D.local_fixed_line_of_fixed_eq_bot H.chosen v hv hz
  have hWC : Vv L V (v : G) ≤ C := (H.nonsingular_component_rank D v hv).1
  have hvW : (v : G) ∈ Vv L V (v : G) :=
    (show ZV (Lv L (v : G)) (Vv L V (v : G)) ≤ Vv L V (v : G) from inf_le_left)
      (hline ▸ mem_zpowers (v : G))
  have hZ : (center C).map C.subtype = zpowers (v : G) := by
    rw [←H.nonsingular_hs_fixed_line_eq_center D v hv hK ⟨e⟩]
    have hZC : ZV (Lv L (v : G)) (Vv L V (v : G)) ≤ C := inf_le_left.trans hWC
    rw [map_subgroupOf_eq_of_le hZC,hline]
  refine ⟨hV,hcent,?_,hZ⟩
  apply le_antisymm ?_ (le_inf (Vv_le_V H.chosen.normalizes _) hWC)
  rintro x ⟨hxV,hxC⟩
  have hxa : a ⟨x,(V_le_Gv v) hxV⟩ ∈
      (V.subgroupOf A).map a ⊓ MulAut.innerSubgroup Sporadic.LeechRelated.HS.Carrier := by
    refine ⟨mem_map_of_mem a hxV,?_⟩
    rw [show (⟨x,(V_le_Gv v) hxV⟩ : A) = inclusion (Kv_le_Gv (v : G)) ⟨x,hxC⟩ from rfl,
      nonsingularModelAction_on_component]
    exact ⟨e (QuotientGroup.mk' (center C) ⟨x,hxC⟩),rfl⟩
  rw [(H.nonsingular_hs_original_inner_part D v hv hK e).2.2.1] at hxa
  obtain ⟨w,hw,he⟩ := hxa
  have hk : (⟨x,(V_le_Gv v) hxV⟩ : A) / w ∈ a.ker := by
    rw [MonoidHom.mem_ker,map_div,he]
    exact _root_.div_self' _
  rw [nonsingularModelAction_ker] at hk
  have hxc : x / (w : G) ∈ V ⊓ centralizer (C : Set G) :=
    ⟨V.div_mem hxV (Vv_le_V H.chosen.normalizes _ hw),hk⟩
  rw [hcent] at hxc
  have hxW : x / (w : G) ∈ Vv L V (v : G) := (zpowers_le.mpr hvW) hxc
  have hh : x / (w : G) * (w : G) ∈ Vv L V (v : G) :=
    (Vv L V (v : G)).mul_mem hxW hw
  simpa only [_root_.div_mul_cancel] using hh

/-- With nontrivial original fixed space, the HS alternative is impossible.
The remaining Ru comparison still commutes with the literal central map. -/
theorem SourceHypothesis.nonsingular_nontrivial_fixed_cover_models
    (H : SourceHypothesis KnownSimple.IsKnownSimple T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) (v : V) (hv : D.Nonsingular v)
    (hK : IsQuasisimple (Kv (v : G)))
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    (hnot : ¬ Kv (v : G) ≤ M L) (hz : ZV L V ≠ ⊥) :
    (∃ (e : ((Kv (v : G)) ⧸ center (Kv (v : G))) ≃* Rudvalis.Model)
      (f : Kv (v : G) ≃* Rudvalis.Multiplier.DoubleCover.Carrier),
      ∀ x, Rudvalis.Multiplier.DoubleCover.covering.toMonoidHom (f x) =
        e (QuotientGroup.mk' (center (Kv (v : G))) x)) ∨
      Nonempty (((Kv (v : G)) ⧸ center (Kv (v : G))) ≃* Janko4.Model) := by
  rcases H.nonsingular_quasisimple_marked_cover_models D v hv hK with hhs | hrest
  · obtain ⟨hp,e,f,hf⟩ := hhs
    exact (hz (H.nonsingular_hs_fixed_eq_bot D v hv hK hTV hnot e)).elim
  · exact hrest

/-- The preferred escaping point retains the source catalogue, and its HS
branch has trivial original fixed space and the exact outer action.
Nontrivial original fixed space leaves only Ru and J4, with the covering map retained. -/
theorem SourceHypothesis.exists_preferred_nonsingular_hs_original_action
    (H : SourceHypothesis KnownSimple.IsKnownSimple T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    (hTI : ∀ g ∈ M L, V ⊓ V.map (MulAut.conj g).toMonoidHom = ⊥ ∨
      V.map (MulAut.conj g).toMonoidHom = V)
    (v : V) (hv : D.Nonsingular v) (he : ¬ Gv (v : G) ≤ M L) :
    ∃ w : V, D.Nonsingular w ∧ ¬ Gv (w : G) ≤ M L ∧
