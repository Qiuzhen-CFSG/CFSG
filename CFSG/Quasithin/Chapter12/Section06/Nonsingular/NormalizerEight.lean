module
public import CFSG.Quasithin.Chapter12.Section06.Nonsingular.NormalizerFive
public import Theory.SpecificGroups.Alternating.EightSectionExtension

/-!
# The original symmetric-eight extension and ambient Sylow

In the contrary normalizer branch of 12.6.17, the checked SL4(2) quotient
identifies the actual K_v image as a self-centralizing normal A8 in
K_v S/O2(K_v S). The literal L_v image normalizes the nontrivial two-subgroup
R_v*. Its A6 section supplies a factor five. Faithful conjugation therefore
identifies the whole quotient with S8 and R_v* with a transposition subgroup.
The same two-local calculation makes the original L_v image itself A6.

The transposition normalizer gives a lower bound of four for the quotient
Sylow index. Combined with the original upper bound, the index is exactly
four. The two-core lies in T_v, so lifting preserves this equality. The
selected Sylow S of G_v consequently has the same order as the original T
and is an ambient Sylow. All maps use the original two-core quotient.

The preferred-point application retains V and C_V(L), and discharges
nonquasisimplicity when that original fixed space is nontrivial. The module
comparison and the 12.6.16 conjugacy argument remain for normalizer escape.
The HS/J4 exclusions, general canonical-module arguments, blocks, splitting
and fixed-space elimination also remain; neither 12.6.2 nor 12.6.23 is asserted.
Earlier invariance/TI retain producer qt-d-1222-source; final discharge
remains with qt-d-12634-source.
Source: Aschbacher--Smith, combined manuscript of 1 March 2004,
12.6.16--17, printed pp.826--827.
-/

public noncomputable section
namespace CFSG.Quasithin.Chapter12.Section06
open Subgroup Theory.GroupTheory
open scoped MatrixGroups
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {L V : Subgroup G} [IsElementaryAbelian 2 V]

/-- The original contrary normalizer branch is an S8 extension. Its original
R_v image is generated by a transposition, and the source Sylow bound is sharp. -/
theorem SourceHypothesis.nonsingular_normalizer_symmetric_quotient
    (H : SourceHypothesis KnownSimple.IsKnownSimple T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) (v : V) (hv : D.Nonsingular v)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    (hnot : ¬ IsQuasisimple (Kv (v : G)))
    (hs : Chapter1.IsSylowIn 2 (Tv T (v : G)) (Mv L (v : G)))
    (hi : (Tv T (v : G)).relIndex (T : Subgroup G) = 4)
    (he : ¬ Kv (v : G) ≤ M L)
    (hNM : normalizer (Rv T L (v : G) : Set G) ≤ M L)
    (S : Sylow 2 (Gv (v : G)))
    (hTS : Tv T (v : G) ≤ (S : Subgroup (Gv (v : G))).map (Gv (v : G)).subtype) :
    let S₀ := (S : Subgroup (Gv (v : G))).map (Gv (v : G)).subtype
    let J := Kv (v : G) ⊔ S₀
    let B := starImage J (Kv (v : G))
    let R₀ := starImage J (Rv T L (v : G))
    (∃ e : Star J ≃* Equiv.Perm (Fin 8),
      B.map e.toMonoidHom = alternatingGroup (Fin 8) ∧
      ∃ t : Equiv.Perm (Fin 8), t.IsSwap ∧ R₀.map e.toMonoidHom = zpowers t) ∧
    pCore 2 (starImage J (Lv L (v : G))) = ⊥ ∧
    Nonempty (starImage J (Lv L (v : G)) ≃* alternatingGroup (Fin 6)) ∧
    (starImage J (Tv T (v : G))).relIndex (starImage J S₀) = 4 := by
  obtain ⟨e₄⟩ := H.nonsingular_normalizer_binary_four D v hv hTV hnot hs hi he hNM
  let S₀ := (S : Subgroup (Gv (v : G))).map (Gv (v : G)).subtype
  let C := Kv (v : G)
  let J := C ⊔ S₀
  let C₀ := C.subgroupOf J
  let P₀ := S₀.subgroupOf J
  let q := QuotientGroup.mk' (pCore 2 J)
  let B := starImage J C
  let A := starImage J (Lv L (v : G))
  let R₀ := starImage J (Rv T L (v : G))
  have hJG : J ≤ Gv (v : G) := sup_le (Kv_le_Gv _) (map_subtype_le _)
  have hnC : J ≤ normalizer (C : Set G) :=
    hJG.trans ((normal_subgroupOf_iff_le_normalizer (Kv_le_Gv _)).mp (Kv_normalIn_Gv _))
  let : C₀.Normal := normal_subgroupOf_of_le_normalizer hnC
  let : B.Normal := (inferInstance : C₀.Normal).map q (QuotientGroup.mk'_surjective _)
  have hc : C₀.IsCComponent :=
    (H.nonsingular_canonical_component D v hv).1.subgroupOf_of_le le_sup_left hJG
  let b : C₀ ≃* C := subgroupOfEquivOfLe (show C ≤ J from le_sup_left)
  let c : B ≃* Star C := (cComponentTwoCoreQuotientEquiv hc).symm.trans
    (QuotientGroup.congr _ _ b (pCore_map_iso 2 b))
  let eB : B ≃* alternatingGroup (Fin 8) := c.trans (e₄.trans
    ((BinaryLinear.OuterCyclic.projectiveEquivSL (by decide : 0 < 4)).symm.trans
      Atlas.Comparisons.Exceptional.alt8EquivPSL4Two.symm))
  obtain ⟨_,_,_,hq,hsi⟩ := H.nonsingular_canonical_component D v hv
  let : IsQuasisimple (Star C) := hq
  let : IsSimpleGroup (Star C) := hsi
  let : IsQuasisimple B := IsQuasisimple.of_mulEquiv c.symm
  let : IsSimpleGroup B := c.isSimpleGroup
  have hp : IsPGroup 2 P₀ := (S.isPGroup'.map _).comap_subtype
  have hgen : C₀ ⊔ P₀ = ⊤ := by
    apply map_injective J.subtype_injective
    rw [Subgroup.map_sup,map_subgroupOf_eq_of_le (show C ≤ J from le_sup_left),
      map_subgroupOf_eq_of_le (show S₀ ≤ J from le_sup_right),
      ←MonoidHom.range_eq_map,range_subtype]
  have hquot : IsPGroup 2 (Star J ⧸ B) :=
    isPGroup_quotient_of_sup_eq_top B (P₀.map q) (hp.map q) (by
      change C₀.map q ⊔ P₀.map q = ⊤
      rw [←Subgroup.map_sup,hgen,map_top_of_surjective q (QuotientGroup.mk'_surjective _)])
  have hcent : centralizer (B : Set (Star J)) = ⊥ :=
    centralizer_eq_bot_of_simple_two_quotient B (Group.IsPerfect.not_isMulCommutative B)
      hquot (pCore_quotient_pCore_eq_bot 2)
  obtain ⟨hlt,⟨eA⟩,_,hAR,_,hPN,P,hPe,hPP,hPi⟩ :=
    H.nonsingular_normalizer_local_embedding D v hv hs hi he hNM S hTS
  obtain ⟨_,hR,hRp,_⟩ := H.nonsingular_normalizer_local_image D v hv hs he hNM S hTS
  have h5 : 5 ∣ Nat.card A := by
    apply dvd_trans _ (card_quotient_dvd_card (pCore 2 A))
    rw [Nat.card_congr eA.toEquiv,nat_card_alternatingGroup,Nat.card_fin]
    decide
  obtain ⟨e,_,hB,t,ht,hRt,_⟩ :=
    Theory.SpecificGroups.Alternating.EightSectionExtension.exists_symmetric_equiv
      B A R₀ eB hcent hlt.le h5 hRp hR hAR
  have hAcore := Theory.SpecificGroups.Alternating.EightSectionExtension.twoCore_eq_bot_of_five
    B A eB hlt.le h5
  let a : A ≃* alternatingGroup (Fin 6) := QuotientGroup.quotientBot.symm.trans
    ((QuotientGroup.quotientMulEquivOfEq hAcore.symm).trans eA)
  refine ⟨⟨e,hB,t,ht,hRt⟩,hAcore,⟨a⟩,?_⟩
  rw [←hPe]
  apply le_antisymm hPi
  exact (Theory.SpecificGroups.Alternating.EightSectionExtension.four_le_normalizer_index
    B A R₀ eB hcent hlt.le h5 hRp hR hAR P).trans
      (relIndex_le_of_le_left hPN index_ne_zero_of_finite)

/-- Equality of the literal quotient indices promotes the selected local
Sylow to an ambient Sylow. No identification of S with T_v is made. -/
theorem SourceHypothesis.nonsingular_normalizer_ambient_sylow
    (H : SourceHypothesis KnownSimple.IsKnownSimple T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) (v : V) (hv : D.Nonsingular v)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    (hnot : ¬ IsQuasisimple (Kv (v : G)))
    (hs : Chapter1.IsSylowIn 2 (Tv T (v : G)) (Mv L (v : G)))
    (hi : (Tv T (v : G)).relIndex (T : Subgroup G) = 4)
    (he : ¬ Kv (v : G) ≤ M L)
    (hNM : normalizer (Rv T L (v : G) : Set G) ≤ M L)
    (S : Sylow 2 (Gv (v : G)))
    (hTS : Tv T (v : G) ≤ (S : Subgroup (Gv (v : G))).map (Gv (v : G)).subtype) :
    let S₀ := (S : Subgroup (Gv (v : G))).map (Gv (v : G)).subtype
    (Tv T (v : G)).relIndex S₀ = 4 ∧
      ∃ P : Sylow 2 G, (P : Subgroup G) = S₀ := by
  let S₀ := (S : Subgroup (Gv (v : G))).map (Gv (v : G)).subtype
  let J := Kv (v : G) ⊔ S₀
  let A := Tv T (v : G)
  let q := QuotientGroup.mk' (pCore 2 J)
  have hR := H.nonsingular_R_eq_Rv_of_normalizer D v hv hs hNM S hTS
  have hcore := core_le_R_of_sylow L (Kv (v : G)) (v : G) S (Kv_le_Gv _)
  rw [hR] at hcore
  obtain ⟨P₀,hP₀⟩ := hs.restrict
    (show A ≤ LT T L ⊓ Gv (v : G) from inf_le_inf le_sup_right le_rfl)
    (show LT T L ⊓ Gv (v : G) ≤ Mv L (v : G) from
      inf_le_inf (sup_le L.le_normalizer H.chosen.sylow_normalizes_component) le_rfl)
  have hRT : Rv T L (v : G) ≤ A := (pCoreIn_le_sylow _ P₀).trans hP₀.le
  have hkA : q.ker ≤ A.subgroupOf J := by
    rw [QuotientGroup.ker_mk']
    intro x hx
    exact hRT (hcore (mem_map_of_mem J.subtype hx))
  have hkS : q.ker ≤ S₀.subgroupOf J := hkA.trans (comap_mono hTS)
  have hfour := (H.nonsingular_normalizer_symmetric_quotient D v hv hTV hnot hs hi he hNM S hTS).2.2.2
  change ((A.subgroupOf J).map q).relIndex ((S₀.subgroupOf J).map q) = 4 at hfour
  rw [relIndex_map_map,sup_eq_left.mpr hkA,sup_eq_left.mpr hkS,
    relIndex_subgroupOf (show S₀ ≤ J from le_sup_right)] at hfour
  refine ⟨hfour,?_⟩
  have h1 := (A.subgroupOf S₀).card_mul_index
  rw [Nat.card_congr (subgroupOfEquivOfLe hTS).toEquiv] at h1
  change Nat.card A * A.relIndex S₀ = Nat.card S₀ at h1
  have h2 := (A.subgroupOf (T : Subgroup G)).card_mul_index
  rw [Nat.card_congr (subgroupOfEquivOfLe (show A ≤ (T : Subgroup G) from inf_le_left)).toEquiv] at h2
  change Nat.card A * A.relIndex (T : Subgroup G) = Nat.card T at h2
  have hecard : Nat.card S₀ = Nat.card T := by
    rw [←h1,hfour,←h2]
    exact congrArg (Nat.card A * ·) hi.symm
  obtain ⟨P,hSP⟩ := (S.isPGroup'.map (Gv (v : G)).subtype).exists_le_sylow
  exact ⟨P,(eq_of_le_of_card_ge hSP (by rw [hecard,Nat.card_congr (P.equiv T).toEquiv])).symm⟩
end CFSG.Quasithin.Chapter12.Section06

namespace CFSG.Quasithin.Chapter12.Section06
open Subgroup Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {L V : Subgroup G} [IsElementaryAbelian 2 V]

/-- At the original preferred escaping point with nontrivial C_V(L), the
contrary normalizer branch supplies an ambient Sylow and the actual S8 action. -/
theorem SourceHypothesis.exists_preferred_nonsingular_normalizer_symmetric_of_fixed
    (H : SourceHypothesis KnownSimple.IsKnownSimple T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    (hTI : ∀ g ∈ M L, V ⊓ V.map (MulAut.conj g).toMonoidHom = ⊥ ∨
      V.map (MulAut.conj g).toMonoidHom = V)
    (hz : ZV L V ≠ ⊥)
    (v : V) (hv : D.Nonsingular v) (he : ¬ Gv (v : G) ≤ M L) :
    ∃ w : V, D.Nonsingular w ∧ ¬ Gv (w : G) ≤ M L ∧
      Chapter1.IsSylowIn 2 (Tv T (w : G)) (Mv L (w : G)) ∧
      (Tv T (w : G)).relIndex (T : Subgroup G) = 4 ∧
      Lv L (w : G) < Kv (w : G) ∧ ¬ Kv (w : G) ≤ M L ∧
      V ⊓ centralizer (Kv (w : G) : Set G) = zpowers (w : G) ∧
      ¬ IsQuasisimple (Kv (w : G)) ∧
      (normalizer (Rv T L (w : G) : Set G) ≤ M L →
        ∃ S : Sylow 2 (Gv (w : G)),
          let S₀ := (S : Subgroup (Gv (w : G))).map (Gv (w : G)).subtype
          let J := Kv (w : G) ⊔ S₀
          let B := starImage J (Kv (w : G))
          let R₀ := starImage J (Rv T L (w : G))
          Tv T (w : G) ≤ S₀ ∧
          Chapter1.IsSylowIn 2 (S₀ ⊓ normalizer (Lv L (w : G) : Set G))
            (Gv (w : G) ⊓ normalizer (Lv L (w : G) : Set G)) ∧
          (Tv T (w : G)).relIndex S₀ = 4 ∧
          (∃ P : Sylow 2 G, (P : Subgroup G) = S₀) ∧
          R L (Kv (w : G)) S₀ (w : G) = Rv T L (w : G) ∧
          R₀ ≠ ⊥ ∧
          pCore 2 (starImage J (Lv L (w : G))) = ⊥ ∧
          Nonempty (starImage J (Lv L (w : G)) ≃* alternatingGroup (Fin 6)) ∧
          ∃ e : Star J ≃* Equiv.Perm (Fin 8),
            B.map e.toMonoidHom = alternatingGroup (Fin 8) ∧
            ∃ t : Equiv.Perm (Fin 8), t.IsSwap ∧ R₀.map e.toMonoidHom = zpowers t) := by
  obtain ⟨w,hw,he,hs,hi,hlt,hnot,hline,hnq,_⟩ :=
    H.exists_preferred_nonsingular_normalizer_binary_four_of_fixed D hTV hTI hz v hv he
  refine ⟨w,hw,he,hs,hi,hlt,hnot,hline,hnq,fun hNM => ?_⟩
  obtain ⟨S,hTS,hN⟩ := exists_sylow_with_Lv_normalizer T L
    H.chosen.sylow_normalizes_component (w : G)
  obtain ⟨hSi,hSyl⟩ := H.nonsingular_normalizer_ambient_sylow D w hw hTV hnq hs hi hnot hNM S hTS
  obtain ⟨hmodel,hcore,hlocal,_⟩ :=
    H.nonsingular_normalizer_symmetric_quotient D w hw hTV hnq hs hi hnot hNM S hTS
  exact ⟨S,hTS,hN,hSi,hSyl,
    H.nonsingular_R_eq_Rv_of_normalizer D w hw hs hNM S hTS,
    (H.nonsingular_normalizer_local_image D w hw hs hnot hNM S hTS).2.1,
    hcore,hlocal,hmodel⟩
end CFSG.Quasithin.Chapter12.Section06
