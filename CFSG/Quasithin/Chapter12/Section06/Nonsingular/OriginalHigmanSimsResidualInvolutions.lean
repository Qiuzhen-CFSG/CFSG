module
public import CFSG.Quasithin.Chapter12.Section06.Nonsingular.OriginalHigmanSimsSingularComponents
import all CFSG.Quasithin.Chapter12.Section06.Nonsingular.OriginalHigmanSimsSingularComponents
import all CFSG.Quasithin.Chapter12.Section06.Nonsingular.OriginalHigmanSimsNative
import all Theory.SpecificGroups.LeechRelated.AtlasCarriers.HS.OrdinaryLocal
import all Theory.SpecificGroups.LeechRelated.AtlasCarriers.HS.LocalGeneration
import all Theory.SpecificGroups.LeechRelated.AtlasCarriers.HS.EvenLocalCandidates.CentralInvolutionCore
import all Theory.GroupTheory.CentralizerEquivBounds

/-!
# Involution generation of the actual native HS point residual

The marked cubic generator is the product of two involutions in its own
cubic residual. Their short words are checked on all one hundred original
permutation letters. The involution-generated subgroup is normal in the
whole centralizer, whose quotient is cyclic; perfectness then proves the
asserted generation. Sylow-center conjugacy preserves the exact residual.
-/

public section
open Subgroup Theory.GroupTheory Theory.GroupTheory.DoubleCoverCentralizer
namespace CFSG.Quasithin.Chapter12.Section06.OriginalHigmanSimsResidualInvolutions
open Sporadic.LeechRelated.HS
open EvenLocalCandidates BlockNormalizer EvenLocalCandidates.CentralInvolutionCore
open OriginalHigmanSimsNative
set_option maxRecDepth 10000

private def conjugateTriple (i : ℕ) : localGroup 0 :=
  eight ^ (-(i : ℤ)) * triple * eight ^ (i : ℤ)

private def inverter : localGroup 0 :=
  conjugateTriple 1 * triple⁻¹ * conjugateTriple 4 * triple^2 * conjugateTriple 6

private theorem inverter_square : inverter ^ 2 = 1 := by
  apply Subtype.ext
  apply Subtype.ext
  apply Equiv.ext
  apply allFin
  decide +kernel

private theorem inverter_triple_square : (inverter * triple) ^ 2 = 1 := by
  apply Subtype.ext
  apply Subtype.ext
  apply Equiv.ext
  apply allFin
  decide +kernel

private theorem marked_generated :
    primeToResidual 3 (localGroup 0) =
      closure {x : localGroup 0 | x ∈ primeToResidual 3 (localGroup 0) ∧ x^2=1} := by
  let R := primeToResidual 3 (localGroup 0)
  let N := closure {x : localGroup 0 | x ∈ R ∧ x^2=1}
  have hNR : N ≤ R := by
    rw [Subgroup.closure_le]
    exact fun _ h => h.1
  have hn : (⊤ : Subgroup (localGroup 0)) ≤ normalizer (N : Set (localGroup 0)) := by
    apply le_normalizer_closure_iff.mpr
    intro a _ x hx
    apply Subgroup.subset_closure
    refine ⟨(inferInstance : R.Normal).conj_mem x hx.1 a,?_⟩
    change ((MulAut.conj a) x)^2 = 1
    rw [←map_pow,hx.2,map_one]
  let : N.Normal := normalizer_eq_top_iff.mp (top_unique hn)
  have ht : triple ∈ R := mem_primeToResidual_of_pow (p := 3) (n := 1) triple_cube
  have hc (i : ℕ) : conjugateTriple i ∈ R := by
    simpa only [conjugateTriple,←zpow_neg,neg_neg] using
      (inferInstance : R.Normal).conj_mem triple ht (eight ^ (-(i : ℤ)))
  have hx : inverter ∈ R :=
    R.mul_mem (R.mul_mem (R.mul_mem (R.mul_mem (hc 1) (R.inv_mem ht)) (hc 4))
      (R.pow_mem ht 2)) (hc 6)
  have hxN : inverter ∈ N := subset_closure ⟨hx,inverter_square⟩
  have hxtN : inverter * triple ∈ N :=
    subset_closure ⟨R.mul_mem hx ht,inverter_triple_square⟩
  have htN : triple ∈ N := by
    have he := N.mul_mem (N.inv_mem hxN) hxtN
    simpa only [inv_mul_cancel_left] using he
  let q := QuotientGroup.mk' N
  let : IsCyclic ((localGroup 0) ⧸ N) := by
    apply isCyclic_iff_exists_zpowers_eq_top.mpr
    refine ⟨q eight,top_unique ?_⟩
    intro x _
    obtain ⟨y,rfl⟩ := QuotientGroup.mk'_surjective N x
    have hle : closure ({triple,eight} : Set (localGroup 0)) ≤
        (zpowers (q eight)).comap q := by
      rw [closure_le]
      rintro y (rfl | rfl)
      · change q triple ∈ zpowers (q eight)
        rw [show q triple = 1 from (QuotientGroup.eq_one_iff _).mpr htN]
        exact one_mem _
      · exact mem_zpowers _
    exact hle (pair_generates ▸ mem_top y)
  let : Group.IsPerfect R :=
    (residual_of_symmetricFive_core_quotient
      LocalGeneration.firstQuotient).1
  let : Group.IsPerfect (R.map q) := Group.IsPerfect.map q
  let : IsMulCommutative (R.map q) := inferInstance
  have hzero : R.map q = ⊥ := Subgroup.eq_bot_of_subsingleton _
  have hRN : R ≤ N := by
    simpa only [q,QuotientGroup.ker_mk'] using (Subgroup.map_eq_bot_iff _).mp hzero
  exact le_antisymm hRN hNR

/-- Every native two-central HS point residual is generated by its own
involutions. Both the centralizer and the residual are the literal ones. -/
theorem twoCentral_residual_generated (j : Carrier)
    (hj : orderOf j = 2) (hc : TwoCentral j) :
    primeToResidual 3 (centralizer ({j} : Set Carrier)) =
      closure {x : centralizer ({j} : Set Carrier) |
        x ∈ primeToResidual 3 (centralizer ({j} : Set Carrier)) ∧ x^2=1} := by
  have hzP : e0 ∈ baseSylow :=
    elementary_le_subgroup 0 (subset_closure ⟨0,by simp,rfl⟩)
  have hz : TwoCentral e0 := by
    refine ⟨baseSylow,hzP,mem_center_iff.mpr ?_⟩
    intro x
    apply Subtype.ext
    exact mem_centralizer_singleton_iff.mp
      (OrdinaryLocal.first_eq_centralizer ▸ LocalGeneration.sylow_le_member 0 x.property)
  obtain ⟨g,hg⟩ := isConj_iff.mp (hc.isConj_of_center_card_two hz
    (fun he => by rw [he,orderOf_one] at hj; omega) e0_nontrivial OrdinaryLocal.sylow_center_card_two)
  let a := MulAut.conj g
  have he : (centralizer ({j} : Set Carrier)).map a.toMonoidHom = localGroup 0 := by
    rw [centralizer_equiv_image,Set.image_singleton]
    change centralizer ({g*j*g⁻¹} : Set Carrier) = _
    rw [hg,←OrdinaryLocal.first_eq_centralizer]
  let d := ((centralizer ({j} : Set Carrier)).equivMapOfInjective a.toMonoidHom a.injective).trans
    (MulEquiv.subgroupCongr he)
  apply (Subgroup.map_injective (f := d.toMonoidHom) d.injective)
  rw [map_primeToResidual,MonoidHom.map_closure,marked_generated]
  congr 1
  symm
  ext x
  constructor
  · rintro ⟨y,⟨hy,hy2⟩,rfl⟩
    exact ⟨(map_primeToResidual (p := 3) d) ▸ mem_map_of_mem d.toMonoidHom hy,
      by rw [←map_pow,hy2,map_one]⟩
  · rintro ⟨hx,hx2⟩
    refine ⟨d.symm x,⟨?_,?_⟩,d.apply_symm_apply x⟩
    · exact (map_primeToResidual (p := 3) d.symm) ▸ mem_map_of_mem d.symm.toMonoidHom hx
    · rw [←map_pow,hx2,map_one]

end CFSG.Quasithin.Chapter12.Section06.OriginalHigmanSimsResidualInvolutions
