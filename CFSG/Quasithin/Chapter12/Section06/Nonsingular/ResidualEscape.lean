module
public import CFSG.Quasithin.Chapter12.Section06.Nonsingular.ReducedEquality
public import CFSG.Quasithin.Chapter12.Section02.RecognitionSource.FusionReducibleNormalizerAmbientResidual

/-!
# Strict local residual enlargement and escape from the normalizer

The original A₈ component has index prime to three in M=N_G(L).
The canonical K_v is generated by its prime-to-three residual, so K_v≤M
would imply K_v≤L. Its two-perfectness then puts it in O²(C_L(v))=L_v.
The strict-enlargement theorem therefore gives K_v not contained in M,
completing both clauses of12.6.11 at the same preferred escaping point.

The literal terminal contradiction now receives this escaping-component
premise from strict enlargement. Its block, splitting, index and displacement
premises still require source proofs by this owner. Neither12.6.2 nor12.6.23
is asserted. Earlier T-invariance and TI retain producer qt-d-1222-source
and final discharge owner qt-d-12634-source.

Source: Aschbacher--Smith,12.6.1(5),12.6.11 and the concluding argument
of Theorem12.6.2, printed pp.822,825 and828.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter12.Section06
variable {G : Type*} [Group G] [Finite G]

/-- The canonical K_v is generated by its own prime-to-three residual. -/
theorem Kv_primeToResidual (v : G) :
    (primeToResidual 3 (Kv v)).map (Kv v).subtype = Kv v := by
  let A := Gv v
  let C := solvableResidual A
  let f := A.subtype.comp C.subtype
  have hh := congrArg (map f)
    (embedded_primeToResidual_eq_of_normal 3 (primeToResidual 3 C) le_rfl)
  rw [map_embedded_primeToResidual_of_hom] at hh
  have hK : Kv v = (primeToResidual 3 C).map f := by
    simp only [Kv,map_map,f,C,A]
  rw [hK]
  exact hh

variable {T : Sylow 2 G} {L V : Subgroup G} [IsElementaryAbelian 2 V]

/-- The canonical K_v can remain in M only when it equals the original L_v.
The three-prime normalizer index and K_v's two-perfectness give the two
containments, retaining the literal prime-to-three and two-residuals. -/
theorem SourceHypothesis.Kv_eq_Lv_of_le_normalizer
    (H : SourceHypothesis KnownSimple.IsKnownSimple T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) (v : V) (hv : D.Nonsingular v)
    (hKM : Kv (v : G) ≤ M L) : Kv (v : G) = Lv L (v : G) := by
  have hidx := Section02.RecognitionSource.FusionReducibleNormalizer.alternatingEight_normalizer_index_coprime_three
    H.source H.chosen (D.coreQuotientEquiv H.chosen H.source.quasisimple)
  have hres : (primeToResidual 3 (M L)).map (M L).subtype ≤ L := by
    exact (map_mono (primeToResidual_le _ hidx)).trans_eq
      (map_subgroupOf_eq_of_le L.le_normalizer)
  have hKL : Kv (v : G) ≤ L := by
    rw [←Kv_primeToResidual (v : G)]
    exact (embedded_primeToResidual_mono 3 hKM).trans hres
  have hKC : Kv (v : G) ≤ CLv L (v : G) := le_inf hKL (Kv_le_Gv _)
  let e := subgroupOfEquivOfLe hKC
  have hp : IsPPerfect 2 ((Kv (v : G)).subgroupOf (CLv L (v : G))) :=
    (Kv_isPPerfect (v : G)).of_surjective e.symm.toMonoidHom e.symm.surjective
  have hle := map_mono (f := (CLv L (v : G)).subtype)
    (le_pResidual_of_isPPerfect _ hp)
  rw [map_subgroupOf_eq_of_le hKC] at hle
  exact le_antisymm hle
    (Lv_le_Kv_of_A6 L (v : G)
      (Classical.choice (D.nonsingular_local_quotient H.chosen H.source.quasisimple v hv)))
end CFSG.Quasithin.Chapter12.Section06

namespace CFSG.Quasithin.Chapter12.Section06
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {L V : Subgroup G} [IsElementaryAbelian 2 V]

/-- Both clauses of12.6.11 at the source-preferred escaping point. The
literal module comparison and the normalizer residual index are proved. -/
theorem SourceHypothesis.exists_preferred_nonsingular_residual_escape
    (H : SourceHypothesis KnownSimple.IsKnownSimple T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    (hTI : ∀ g ∈ M L, V ⊓ V.map (MulAut.conj g).toMonoidHom = ⊥ ∨
      V.map (MulAut.conj g).toMonoidHom = V)
    (v : V) (hv : D.Nonsingular v) (he : ¬ Gv (v : G) ≤ M L) :
    ∃ w : V, D.Nonsingular w ∧ ¬ Gv (w : G) ≤ M L ∧
      Chapter1.IsSylowIn 2 (Tv T (w : G)) (Mv L (w : G)) ∧
      (Tv T (w : G)).relIndex (T : Subgroup G) = 4 ∧
      Lv L (w : G) < Kv (w : G) ∧ ¬ Kv (w : G) ≤ M L := by
  obtain ⟨w,hw,he,hs,hi,hlt⟩ :=
    H.exists_preferred_nonsingular_residual_strict D hTV hTI v hv he
  exact ⟨w,hw,he,hs,hi,hlt,fun hKM => hlt.ne
    (H.Kv_eq_Lv_of_le_normalizer D w hw hKM).symm⟩

/-- The literal terminal consumer now needs only strict residual enlargement;
12.6.11's second clause supplies its escaping-component premise. The block,
splitting, index and displacement inputs remain with this source owner. -/
theorem SourceHypothesis.nonsingular_terminal_contradiction_of_residual_strict
    (H : SourceHypothesis KnownSimple.IsKnownSimple T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) (S : Subgroup G)
    (v : V) (hv : D.Nonsingular v)
    (hlt : Lv L (v : G) < Kv (v : G))
    (hcore : Rv T L (v : G) = (Kv (v : G) ⊔ S).pCoreIn 2)
    (hQ : IsElementaryAbelian 2 (Q T L))
    (hindex : (Q T L).relIndex (Rv T L (v : G)) = 2)
    (r : G) (hr : r ∈ Rv T L (v : G))
    (hcomm : ⁅Rv T L (v : G), zpowers r⁆ = zpowers (v : G)) : False :=
  H.nonsingular_terminal_contradiction D S v hv
    (fun hKM => hlt.ne (H.Kv_eq_Lv_of_le_normalizer D v hv hKM).symm)
    hcore hQ hindex r hr hcomm
end CFSG.Quasithin.Chapter12.Section06
