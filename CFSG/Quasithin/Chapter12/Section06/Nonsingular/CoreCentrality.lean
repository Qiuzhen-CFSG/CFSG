module
public import CFSG.Quasithin.Chapter12.Section06.Nonsingular.MovedModule
public import CFSG.Quasithin.Chapter12.Section06.Nonsingular.LocalCore
public import Theory.Representation.BinaryPermutation.SixCommutant

/-!
# Centrality and reducedness of the nonsingular moved module

The actual A₆ core marking identifies the conjugation kernel on V_v with
O₂(L_v). An element normalizing V_v and centralizing L_v/O₂(L_v) commutes
with the faithful A₆ action, so the six-letter rigidity theorem makes it
centralize V_v. Conversely, centralizing V_v detects trivial action on that
same quotient. Applying both directions inside C_LT(v) gives
C_{C_LT(v)}(V_v)=R_v and V_v≤Ω₁(Z(R_v)).

The literal V_v is reduced both in L_v and in C_LT(v), and is generated by
its L_v-commutators. Thus [O₂(L_v),L_v] and [R₂(L_v),L_v] are nontrivial,
providing the module inputs used in the component sieve and block argument.
Every marking is the original conjugation action; V and its projection to
V/C_V(L) are those in MovedModule.

The C_LT(v) conclusions retain the earlier T-invariance of V, whose source
assembly belongs to qt-d-1222-source. No component-recognition, block or
fixed-space-elimination result is assumed or asserted here; those arguments
still remain in the assembly of 12.6.2 and 12.6.23.

Source: Aschbacher--Smith, combined manuscript (1 March 2004), the paragraph
preceding 12.6.6, p.824, and its uses in 12.6.12--13, pp.825--826.
-/

public section

open Subgroup Theory.GroupTheory Representation BinaryPermutation BinaryPermutation.EightNonsingular
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter12.Section06
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
private theorem marked_core_centralizer
    (A W : Subgroup G) [IsElementaryAbelian 2 W]
    (hn : A ≤ normalizer (W : Set G))
    (β : A →* alternatingGroup (Fin 6)) (hβ : Function.Surjective β)
    (hk : β.ker = pCore 2 A)
    (E : core (Fin 6) ≃ₗ[ZMod 2] Additive W)
    (hE : ∀ a w, E (alternatingCoreRepresentation (Fin 6) (β a) w) =
      seedRepresentation A W hn a (E w)) :
    coreQuotientCentralizer A ⊓ normalizer (W : Set G) ≤ centralizer (W : Set G) := by
  rintro r ⟨hr,hrW⟩
  obtain ⟨hrA,hcomm⟩ := (mem_coreQuotientCentralizer_iff A r).mp hr
  let aR := A.normalizerMonoidHom ⟨r,hrA⟩
  have hβR (a : A) : β (aR a) = β a := by
    apply div_eq_one.mp
    rw [← map_div]
    change aR a / a ∈ β.ker
    rw [hk]
    obtain ⟨c,hc,he⟩ := hcomm a a.property
    have he' : c = aR a / a := by
      apply Subtype.ext
      change (c : G) = r * (a : G) * r⁻¹ / (a : G)
      simpa only [div_eq_mul_inv,commutatorElement_def,subtype_apply] using he
    exact he' ▸ hc
  let wR := W.normalizerMonoidHom ⟨r,hrW⟩
  let α : Additive W ≃ₗ[ZMod 2] Additive W :=
    LinearEquiv.ofBijective (wR.toAdditive.toAddMonoidHom.toZModLinearMap 2) wR.toAdditive.bijective
  let f := E.trans (α.trans E.symm)
  have hEf (w) : E (f w) = α (E w) := E.apply_symm_apply _
  have hα (a : A) (w : Additive W) :
      α (seedRepresentation A W hn a w) =
        seedRepresentation A W hn (aR a) (α w) := by
    apply Additive.toMul.injective
    apply Subtype.ext
    change r * ((a : G) * (w.toMul : G) * (a : G)⁻¹) * r⁻¹ =
      (r * (a : G) * r⁻¹) * (r * (w.toMul : G) * r⁻¹) * (r * (a : G) * r⁻¹)⁻¹
    group
  have hf : f = LinearEquiv.refl _ _ := by
    apply SixCommutant.commuting_eq_refl
    intro g w
    obtain ⟨a,rfl⟩ := hβ g
    apply E.injective
    change E (f (alternatingCoreRepresentation (Fin 6) (β a) w)) =
      E (alternatingCoreRepresentation (Fin 6) (β a) (f w))
    rw [hEf,hE,hα,←hEf,←hE,hβR]
  apply mem_centralizer_iff.mpr
  intro w hw
  obtain ⟨x,hx⟩ := E.surjective (Additive.ofMul (show W from ⟨w,hw⟩))
  have hh := hEf x
  rw [hf] at hh
  change E x = α (E x) at hh
  rw [hx] at hh
  have hval := congrArg (fun z : Additive W => (z.toMul : G)) hh
  change w = r*w*r⁻¹ at hval
  exact (mul_inv_eq_iff_eq_mul.mp hval.symm).symm

omit [Finite G] in
private theorem marked_core_centralizer_reverse
    (A W : Subgroup G) [IsElementaryAbelian 2 W]
    (hn : A ≤ normalizer (W : Set G))
    (β : A →* alternatingGroup (Fin 6)) (hk : β.ker = pCore 2 A)
    (E : core (Fin 6) ≃ₗ[ZMod 2] Additive W)
    (hE : ∀ a w, E (alternatingCoreRepresentation (Fin 6) (β a) w) =
      seedRepresentation A W hn a (E w)) :
    normalizer (A : Set G) ⊓ centralizer (W : Set G) ≤ coreQuotientCentralizer A := by
  rintro r ⟨hrA,hrW⟩
  let aR := A.normalizerMonoidHom ⟨r,hrA⟩
  let rW : normalizer (W : Set G) := ⟨r,Subgroup.centralizer_le_normalizer _ hrW⟩
  have hrmap : W.normalizerMonoidHom rW = 1 := by
    apply MulEquiv.ext
    intro w
    apply Subtype.ext
    change r * (w : G) * r⁻¹ = w
    rw [←mem_centralizer_iff.mp hrW w w.property,mul_inv_cancel_right]
  have haR (a : A) : conjugation A W hn (aR a) = conjugation A W hn a := by
    calc
      _ = W.normalizerMonoidHom (rW * inclusion hn a * rW⁻¹) := by
        rfl
      _ = _ := by rw [map_mul,map_mul,map_inv,hrmap,one_mul,inv_one,mul_one]; rfl
  have hβR (a : A) : β (aR a) = β a := by
    apply SixCommutant.action_injective
    apply LinearMap.ext
    intro w
    apply E.injective
    rw [hE,hE]
    exact congrArg (fun f : MulAut W => Additive.ofMul (f (E w).toMul)) (haR a)
  apply (mem_coreQuotientCentralizer_iff A r).mpr
  refine ⟨hrA,?_⟩
  intro a ha
  let a' : A := ⟨a,ha⟩
  have hm : aR a' / a' ∈ pCore 2 A := by
    rw [←hk]
    change β (aR a' / a') = 1
    rw [map_div,hβR,div_self']
  refine ⟨aR a' / a',hm,?_⟩
  change r*a*r⁻¹/a = ⁅r,a⁆
  rw [div_eq_mul_inv,commutatorElement_def]

variable {T : Sylow 2 G} {L V : Subgroup G} [IsElementaryAbelian 2 V]

/-- The quotient-action centralizer acts trivially on the actual moved module when it normalizes it. -/
theorem OrthogonalMarking.local_moved_centralizer
    (chosen : Section02.ChosenModule T L V)
    (D : OrthogonalMarking L V chosen.normalizes) (hq : IsQuasisimple (Star L))
    (v : V) (hv : D.Nonsingular v) :
    coreQuotientCentralizer (Lv L (v : G)) ⊓ normalizer (Vv L V (v : G) : Set G) ≤
      centralizer (Vv L V (v : G) : Set G) := by
  obtain ⟨i,j,hij,hp⟩ := nonsingular_pair _ hv
  let := Vv_elementary chosen.normalizes (v : G)
  obtain ⟨E,hE,_⟩ := D.local_core_marking chosen v i j hij hp
  exact marked_core_centralizer _ _ (Lv_normalizes_Vv L V (v : G))
    (D.localSixMap v i j hij hp) (D.localSixMap_surjective v i j hij hp)
    (D.localSixMap_ker chosen hq v i j hij hp) E hE

/-- Faithfulness of the actual moved core detects trivial action on the local two-core quotient. -/
theorem OrthogonalMarking.local_moved_centralizer_reverse
    (chosen : Section02.ChosenModule T L V)
    (D : OrthogonalMarking L V chosen.normalizes) (hq : IsQuasisimple (Star L))
    (v : V) (hv : D.Nonsingular v) :
    normalizer (Lv L (v : G) : Set G) ⊓ centralizer (Vv L V (v : G) : Set G) ≤
      coreQuotientCentralizer (Lv L (v : G)) := by
  obtain ⟨i,j,hij,hp⟩ := nonsingular_pair _ hv
  let := Vv_elementary chosen.normalizes (v : G)
  obtain ⟨E,hE,_⟩ := D.local_core_marking chosen v i j hij hp
  exact marked_core_centralizer_reverse _ _ (Lv_normalizes_Vv L V (v : G))
    (D.localSixMap v i j hij hp) (D.localSixMap_ker chosen hq v i j hij hp) E hE

/-- The kernel on V_v is exactly the original O₂(L_v), through the original six-letter marking. -/
theorem OrthogonalMarking.local_moved_actionKernel
    (chosen : Section02.ChosenModule T L V)
    (D : OrthogonalMarking L V chosen.normalizes) (hq : IsQuasisimple (Star L))
    (v : V) (hv : D.Nonsingular v) :
    (conjugation (Lv L (v : G)) (Vv L V (v : G)) (Lv_normalizes_Vv L V (v : G))).ker =
      pCore 2 (Lv L (v : G)) := by
  obtain ⟨i,j,hij,hp⟩ := nonsingular_pair _ hv
  let := Vv_elementary chosen.normalizes (v : G)
  obtain ⟨E,hE,_⟩ := D.local_core_marking chosen v i j hij hp
  rw [←D.localSixMap_ker chosen hq v i j hij hp]
  ext a
  change conjugation _ _ _ a = 1 ↔ D.localSixMap v i j hij hp a = 1
  constructor
  · intro ha
    apply SixCommutant.action_injective
    rw [map_one]
    apply LinearMap.ext
    intro w
    apply E.injective
    change E (alternatingCoreRepresentation (Fin 6) (D.localSixMap v i j hij hp a) w) = E w
    rw [hE]
    exact congrArg (fun f : MulAut (Vv L V (v : G)) => Additive.ofMul (f (E w).toMul)) ha
  · intro ha
    apply MulEquiv.ext
    intro w
    obtain ⟨x,hx⟩ := E.surjective (Additive.ofMul w)
    have he := hE a x
    rw [ha,map_one] at he
    change E x = seedRepresentation _ _ _ a (E x) at he
    rw [hx] at he
    exact (congrArg Additive.toMul he).symm

/-- The original moved subgroup is generated by its own L_v-commutators. -/
theorem OrthogonalMarking.local_moved_generated
    (chosen : Section02.ChosenModule T L V)
    (D : OrthogonalMarking L V chosen.normalizes) (v : V) (hv : D.Nonsingular v) :
    ⁅Vv L V (v : G),Lv L (v : G)⁆ = Vv L V (v : G) := by
  obtain ⟨i,j,hij,hp⟩ := nonsingular_pair _ hv
  obtain ⟨F,hF,hFR,he,_⟩ := D.local_core_image chosen v i j hij hp
  let W : Submodule (ZMod 2) (Additive V) := AddSubgroup.toZModSubmodule 2
    ((⁅Vv L V (v : G),Lv L (v : G)⁆).subgroupOf V).toAddSubgroup
  have hgen : Coinvariants.ker (alternatingCoreRepresentation (Fin 6)) ≤ W.comap F := by
    apply Submodule.span_le.mpr
    rintro _ ⟨⟨a,w⟩,rfl⟩
    obtain ⟨l,rfl⟩ := D.localSixMap_surjective v i j hij hp a
    change (F (alternatingCoreRepresentation (Fin 6)
      (D.localSixMap v i j hij hp l) w - w)).toMul.val ∈ ⁅Vv L V (v : G),Lv L (v : G)⁆
    rw [map_sub,he]
    change (l : G) * (F w).toMul.val * (l : G)⁻¹ / (F w).toMul.val ∈ _
    rw [div_eq_mul_inv]
    change ⁅(l : G),(F w).toMul.val⁆ ∈ _
    rw [commutator_comm]
    exact commutator_mem_commutator l.property (hFR.le ⟨Multiplicative.ofAdd w,rfl⟩)
  rw [alternatingSix_core_generated] at hgen
  apply le_antisymm (le_normalizer_iff_commutator_le_left.mp (Lv_normalizes_Vv L V (v : G)))
  intro x hx
  obtain ⟨w,rfl⟩ := hFR.ge hx
  exact hgen Submodule.mem_top

omit [Finite G] [IsElementaryAbelian 2 V] in
theorem normalizes_Vv_of_normalizes (A : Subgroup G) (v : G)
    (hAV : A ≤ normalizer (V : Set G)) (hAL : A ≤ normalizer (Lv L v : Set G)) :
    A ≤ normalizer (Vv L V v : Set G) := by
  intro a ha
  rw [mem_normalizer_iff_map_conj_eq]
  change (⁅V,Lv L v⁆).map (MulAut.conj a) = ⁅V,Lv L v⁆
  rw [map_commutator,mem_normalizer_iff_map_conj_eq.mp (hAV ha),
    mem_normalizer_iff_map_conj_eq.mp (hAL ha)]

omit [Finite G] [IsElementaryAbelian 2 V] in
theorem Vv_le_Rv (chosen : Section02.ChosenModule T L V) (v : V) :
    Vv L V (v : G) ≤ Rv T L (v : G) :=
  (Vv_le_V chosen.normalizes _).trans (chosen.le_core.trans (Q_le_Rv chosen v))

/-- The original R_v centralizes V_v; only the earlier T-invariance premise is retained. -/
theorem SourceHypothesis.Rv_centralizes_moved
    {K : GroupClass} (H : SourceHypothesis K T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) (v : V) (hv : D.Nonsingular v)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G)) :
    Rv T L (v : G) ≤ centralizer (Vv L V (v : G) : Set G) := by
  have hRH : Rv T L (v : G) ≤ LT T L ⊓ Gv (v : G) := pCoreIn_le 2 _
  have hRV : Rv T L (v : G) ≤ normalizer (V : Set G) :=
    (hRH.trans inf_le_left).trans (sup_le H.chosen.normalizes hTV)
  have hRL : Rv T L (v : G) ≤ normalizer (Lv L (v : G) : Set G) :=
    (hRH.trans (inf_le_inf (sup_le L.le_normalizer H.chosen.sylow_normalizes_component) le_rfl)).trans
      (Mv_le_normalizer_Lv L (v : G))
  obtain ⟨e⟩ := D.nonsingular_local_quotient H.chosen H.source.quasisimple v hv
  have hRC : Rv T L (v : G) ≤ coreQuotientCentralizer (Lv L (v : G)) := by
    rw [Rv_eq_inf_coreQuotientCentralizer T L H.chosen.sylow_normalizes_component _
      (Lv_coreQuotient_center_eq_bot_of_A6 L (v : G) e)]
    exact inf_le_right
  exact (le_inf hRC (normalizes_Vv_of_normalizes _ _ hRV hRL)).trans
    (D.local_moved_centralizer H.chosen H.source.quasisimple v hv)

/-- The omega-center containment preceding source 12.6.6, on the literal ambient subgroups. -/
theorem SourceHypothesis.moved_le_omega_center_Rv
    {K : GroupClass} (H : SourceHypothesis K T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) (v : V) (hv : D.Nonsingular v)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G)) :
    Vv L V (v : G) ≤ omegaOneAmbient ((center (Rv T L (v : G))).map
      (Rv T L (v : G)).subtype) := by
  let := Vv_elementary H.chosen.normalizes (v : G)
  rw [← omegaOneAmbient_eq_self (Vv L V (v : G))]
  apply omegaOneAmbient_mono
  intro w hw
  refine ⟨⟨w,Vv_le_Rv H.chosen v hw⟩,?_,rfl⟩
  change (⟨w,Vv_le_Rv H.chosen v hw⟩ : Rv T L (v : G)) ∈ center (Rv T L (v : G))
  rw [mem_center_iff]
  intro r
  apply Subtype.ext
  exact (mem_centralizer_iff.mp (H.Rv_centralizes_moved D v hv hTV r.property) w hw).symm
/-- The full kernel inside C_LT(v) is its original two-core R_v. -/
theorem SourceHypothesis.local_moved_centralizer_eq_core
    {K : GroupClass} (H : SourceHypothesis K T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) (v : V) (hv : D.Nonsingular v)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G)) :
    (LT T L ⊓ Gv (v : G)) ⊓ centralizer (Vv L V (v : G) : Set G) = Rv T L (v : G) := by
  apply le_antisymm
  · obtain ⟨e⟩ := D.nonsingular_local_quotient H.chosen H.source.quasisimple v hv
    rw [Rv_eq_inf_coreQuotientCentralizer T L H.chosen.sylow_normalizes_component _
      (Lv_coreQuotient_center_eq_bot_of_A6 L (v : G) e)]
    apply le_inf inf_le_left
    apply le_trans _ (D.local_moved_centralizer_reverse H.chosen H.source.quasisimple v hv)
    apply inf_le_inf _ le_rfl
    exact (inf_le_inf (sup_le L.le_normalizer H.chosen.sylow_normalizes_component) le_rfl).trans
      (Mv_le_normalizer_Lv L (v : G))
  · exact le_inf (pCoreIn_le 2 _) (H.Rv_centralizes_moved D v hv hTV)

/-- The source R₂-family membership inside the original C_LT(v). -/
theorem SourceHypothesis.local_moved_isReduced
    {K : GroupClass} (H : SourceHypothesis K T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) (v : V) (hv : D.Nonsingular v)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G)) :
    IsPReduced 2 ((Vv L V (v : G)).subgroupOf (LT T L ⊓ Gv (v : G))) := by
  let J := LT T L ⊓ Gv (v : G)
  let W := Vv L V (v : G)
  have hWJ : W ≤ J := (Vv_le_Rv H.chosen v).trans (pCoreIn_le 2 _)
  have hn : J ≤ normalizer (W : Set G) :=
    normalizes_Vv_of_normalizes J _
      (inf_le_left.trans (sup_le H.chosen.normalizes hTV))
      ((inf_le_inf (sup_le L.le_normalizer H.chosen.sylow_normalizes_component) le_rfl).trans
        (Mv_le_normalizer_Lv L (v : G)))
  let hnormal : (W.subgroupOf J).Normal := (normal_subgroupOf_iff_le_normalizer hWJ).mpr hn
  let := Vv_elementary H.chosen.normalizes (v : G)
  let : IsElementaryAbelian 2 (W.subgroupOf J) := IsElementaryAbelian.subgroupOf hWJ
  have hcentral : centralizer (W.subgroupOf J : Set J) = pCore 2 J := by
    have he := congrArg (fun B : Subgroup G => B.subgroupOf J)
      (H.local_moved_centralizer_eq_core D v hv hTV)
    have hcore : (Rv T L (v : G)).subgroupOf J = pCore 2 J :=
      comap_map_eq_self_of_injective J.subtype_injective _
    rw [hcore] at he
    rw [←he]
    ext x
    change (∀ y ∈ W.subgroupOf J, y*x = x*y) ↔ ((x : G) ∈ J ∧ (x : G) ∈ centralizer (W : Set G))
    constructor
    · intro hx
      refine ⟨x.property,mem_centralizer_iff.mpr ?_⟩
      intro w hw
      exact congrArg Subtype.val (hx ⟨w,hWJ hw⟩ hw)
    · rintro ⟨_,hx⟩ y hy
      exact Subtype.ext (mem_centralizer_iff.mp hx y hy)
  refine ⟨hnormal,inferInstance,?_⟩
  change pCore 2 (J ⧸ centralizer (W.subgroupOf J : Set J)) = ⊥
  let e := QuotientGroup.quotientMulEquivOfEq hcentral
  have hm := pCore_map_iso 2 e
  rw [pCore_quotient_pCore_eq_bot 2] at hm
  exact (map_eq_bot_iff_of_injective _ e.injective).mp hm

/-- The literal moved subgroup lies in the ambient image of R₂(C_LT(v)). -/
theorem SourceHypothesis.moved_le_reduced_localCentralizer
    {K : GroupClass} (H : SourceHypothesis K T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) (v : V) (hv : D.Nonsingular v)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G)) :
    Vv L V (v : G) ≤ (reducedTwoSubgroup (LT T L ⊓ Gv (v : G) : Subgroup G)).map
      (LT T L ⊓ Gv (v : G)).subtype := by
  have hh := map_mono (f := (LT T L ⊓ Gv (v : G)).subtype)
    (H.local_moved_isReduced D v hv hTV).le_reducedPSubgroup
  rwa [map_subgroupOf_eq_of_le ((Vv_le_Rv H.chosen v).trans (pCoreIn_le 2 _))] at hh

/-- Reducedness inside L_v requires no ambient Sylow-invariance premise. -/
theorem OrthogonalMarking.local_residual_moved_isReduced
    (chosen : Section02.ChosenModule T L V)
    (D : OrthogonalMarking L V chosen.normalizes) (hq : IsQuasisimple (Star L))
    (v : V) (hv : D.Nonsingular v) :
    IsPReduced 2 ((Vv L V (v : G)).subgroupOf (Lv L (v : G))) := by
  let A := Lv L (v : G)
  let W := Vv L V (v : G)
  have hWA : W ≤ A := Vv_le_Lv chosen v
  let hn : (W.subgroupOf A).Normal :=
    (normal_subgroupOf_iff_le_normalizer hWA).mpr (Lv_normalizes_Vv L V (v : G))
  let := Vv_elementary chosen.normalizes (v : G)
  let : IsElementaryAbelian 2 (W.subgroupOf A) := IsElementaryAbelian.subgroupOf hWA
  have hcentral : centralizer (W.subgroupOf A : Set A) = pCore 2 A := by
    rw [←D.local_moved_actionKernel chosen hq v hv,conjugation_ker]
    ext a
    change (∀ w ∈ W.subgroupOf A, w*a = a*w) ↔ (a : G) ∈ centralizer (W : Set G)
    constructor
    · intro ha
      apply mem_centralizer_iff.mpr
      intro w hw
      exact congrArg Subtype.val (ha ⟨w,hWA hw⟩ hw)
    · intro ha w hw
      exact Subtype.ext (mem_centralizer_iff.mp ha w hw)
  refine ⟨hn,inferInstance,?_⟩
  let e := QuotientGroup.quotientMulEquivOfEq hcentral
  have hm := pCore_map_iso 2 e
  rw [pCore_quotient_pCore_eq_bot 2] at hm
  exact (map_eq_bot_iff_of_injective _ e.injective).mp hm

/-- The actual V_v lies in the actual R₂(L_v), as used in 12.6.13. -/
theorem OrthogonalMarking.moved_le_reduced_Lv
    (chosen : Section02.ChosenModule T L V)
    (D : OrthogonalMarking L V chosen.normalizes) (hq : IsQuasisimple (Star L))
    (v : V) (hv : D.Nonsingular v) :
    Vv L V (v : G) ≤ (reducedTwoSubgroup (Lv L (v : G))).map (Lv L (v : G)).subtype := by
  have hh := map_mono (f := (Lv L (v : G)).subtype)
    (D.local_residual_moved_isReduced chosen hq v hv).le_reducedPSubgroup
  rwa [map_subgroupOf_eq_of_le (Vv_le_Lv chosen v)] at hh

/-- The noncentral core and reduced-module inputs used in 12.6.12 and 12.6.13. -/
theorem SourceHypothesis.nonsingular_local_core_moved
    {K : GroupClass} (H : SourceHypothesis K T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) (v : V) (hv : D.Nonsingular v) :
    ⁅(Lv L (v : G)).pCoreIn 2,Lv L (v : G)⁆ ≠ ⊥ ∧
      ⁅(reducedTwoSubgroup (Lv L (v : G))).map (Lv L (v : G)).subtype,Lv L (v : G)⁆ ≠ ⊥ := by
  have hne : Vv L V (v : G) ≠ ⊥ := by
    intro he
    have hc := D.nonsingular_moved_card H.chosen v hv
    rw [he,card_bot] at hc
    norm_num at hc
  have hgen := D.local_moved_generated H.chosen v hv
  have hbound (B : Subgroup G) (hB : Vv L V (v : G) ≤ B) : ⁅B,Lv L (v : G)⁆ ≠ ⊥ := by
    intro hb
    apply hne
    apply le_bot_iff.mp
    rw [←hgen]
    exact (commutator_mono hB le_rfl).trans_eq hb
  exact ⟨hbound _ (Vv_le_core_Lv H.chosen v),
    hbound _ (D.moved_le_reduced_Lv H.chosen H.source.quasisimple v hv)⟩
end CFSG.Quasithin.Chapter12.Section06
