namespace CFSG.Quasithin.Chapter12.Section06
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
private theorem local_centralizer_restrict (J X : Subgroup G) (hX : X ≤ J) :
    (centralizer (X.subgroupOf J : Set J)).map J.subtype = J ⊓ centralizer (X : Set G) := by
  ext x
  constructor
  · rintro ⟨x,hx,rfl⟩
    refine ⟨x.property,?_⟩
    intro y hy
    exact congrArg J.subtype (hx ⟨y,hX hy⟩ hy)
  · rintro ⟨hx,hc⟩
    refine ⟨⟨x,hx⟩,?_,rfl⟩
    intro y hy
    exact Subtype.ext (hc y hy)

omit [Finite G] in
private theorem perfect_commutator_idempotent (Y B : Subgroup G)
    [Y.Normal] [B.Normal] [Group.IsPerfect B] : ⁅⁅Y,B⁆,B⁆ = ⁅Y,B⁆ := by
  apply le_antisymm (commutator_le_left _ _)
  have h := commutator_commutator_le_of_rotate
    (H₁ := B) (H₂ := B) (H₃ := Y) (K := ⁅⁅Y,B⁆,B⁆)
    (by rw [commutator_comm B Y]) le_rfl
  simpa only [commutator_eq_self,commutator_comm B Y] using h

variable {T : Sylow 2 G} {L V : Subgroup G} [IsElementaryAbelian 2 V]

/-- The source B.5 comparison identifies the literal reduced commutator
with the original preferred-point moved subgroup. -/
theorem SourceHypothesis.reduced_point_commutator_eq
    (H : SourceHypothesis KnownSimple.IsKnownSimple T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) (v : V) (hv : D.Nonsingular v)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    (hTv : Chapter1.IsSylowIn 2 (Tv T (v : G)) (Mv L (v : G)))
    (hn : Gv (v : G) ≤ normalizer (Lv L (v : G) : Set G))
    (hc : Gv (v : G) ⊓ centralizer (Vv L V (v : G) : Set G) ≤ M L)
    (hg : Lv L (v : G) = ⁅Lv L (v : G),elementaryAbelianMaxJ (Tv T (v : G))⁆) :
    ⁅(reducedTwoSubgroup (Gv (v : G))).map (Gv (v : G)).subtype,Lv L (v : G)⁆ =
      Vv L V (v : G) := by
  let A := Gv (v : G)
  let J := LT T L ⊓ A
  let R₂ := reducedTwoSubgroup A
  let Y₀ := R₂.map A.subtype
  let Z₀ := ⁅Y₀,Lv L (v : G)⁆
  let W₀ := Vv L V (v : G)
  let X₀ := W₀ ⊔ Z₀
  let B := (Lv L (v : G)).subgroupOf J
  let Y := Y₀.subgroupOf J
  let Z := Z₀.subgroupOf J
  let W := W₀.subgroupOf J
  let X := X₀.subgroupOf J
  let S := (Tv T (v : G)).subgroupOf J
  have hBJ : Lv L (v : G) ≤ J :=
    le_inf ((Lv_le_L L _).trans le_sup_left) (Lv_le_Gv L _)
  have hSJ : Tv T (v : G) ≤ J := inf_le_inf le_sup_right le_rfl
  have hYJ : Y₀ ≤ J := (H.reduced_point_le_local_core v hTv hn hc).2.trans (pCoreIn_le 2 _)
  have hnY : A ≤ normalizer (Y₀ : Set G) := by
    simpa only [normalizer_eq_top,←MonoidHom.range_eq_map,range_subtype] using
      R₂.le_normalizer_map A.subtype
  have hZY : Z₀ ≤ Y₀ := le_normalizer_iff_commutator_le_left.mp ((Lv_le_Gv L _).trans hnY)
  have hZJ := hZY.trans hYJ
  have hWJ : W₀ ≤ J := (Vv_le_Rv H.chosen v).trans (pCoreIn_le 2 _)
  have hXJ : X₀ ≤ J := sup_le hWJ hZJ
  let : B.Normal := normal_subgroupOf_of_le_normalizer (inf_le_right.trans hn)
  let : Y.Normal := normal_subgroupOf_of_le_normalizer (inf_le_right.trans hnY)
  have hB : B.map J.subtype = Lv L (v : G) := map_subgroupOf_eq_of_le hBJ
  have hY : Y.map J.subtype = Y₀ := map_subgroupOf_eq_of_le hYJ
  have hZ : Z.map J.subtype = Z₀ := map_subgroupOf_eq_of_le hZJ
  have hW : W.map J.subtype = W₀ := map_subgroupOf_eq_of_le hWJ
  have hX : X.map J.subtype = X₀ := map_subgroupOf_eq_of_le hXJ
  have hZeq : Z = ⁅Y,B⁆ := by
    apply map_injective J.subtype_injective
    rw [map_commutator,hZ,hY,hB]
  let : Z.Normal := hZeq ▸ inferInstance
  let : W.Normal := (H.local_moved_isReduced D v hv hTV).normal
  let : IsElementaryAbelian 2 R₂ := isPReduced_reducedPSubgroup.elementary
  have hff := H.reduced_point_ff D v hv hTv hn hc hg
  have hsqA : IsSQTK KnownSimple.IsKnownSimple A := H.source.simpleQTKE.twoLocal_sqtk
    (isTwoLocal_involution_centralizer (orderOf_eq_prime
      (elemPow_eq_one_of_isElementaryAbelian _ v.property)
      (fun hh => nonsingular_ne_one D hv (Subtype.ext hh))))
  let cover : ChapterB.SourceInduction.SQTKQuotient KnownSimple.IsKnownSimple
      (ChapterB.InternalThompsonAction.ActionQuotient R₂) := {
    Cover := A
    kernel := centralizer (R₂ : Set A)
    sqtk := hsqA
    equiv := MulEquiv.refl _ }
  have hclass := ChapterB.SourceInduction.offenderSubgroup_adequateAlternative
    (ChapterB.InternalThompsonAction.action R₂)
    (ChapterB.InternalThompsonAction.action_faithful R₂)
    isPReduced_reducedPSubgroup.quotient_pCore_eq_bot cover
  have hirr := H.reduced_point_moved_irrPlus D v hv hn hff.2 hclass
  obtain ⟨hXR,hXe,hXn,hXC⟩ := H.reduced_moved_common_module D v hv hTV hTv hn hc hirr
  let : IsElementaryAbelian 2 X₀ := hXe
  let : IsElementaryAbelian 2 X := IsElementaryAbelian.subgroupOf hXJ
  let : X.Normal := hXn
  let q := ChapterB.InternalThompsonAction.actionMk X
  let C := B.map q
  let : C.Normal := (inferInstance : B.Normal).map q (QuotientGroup.mk'_surjective _)
  have hcentral : centralizer (X : Set J) = pCore 2 J := by
    apply map_injective J.subtype_injective
    rw [local_centralizer_restrict J X₀ hXJ]
    exact hXC
  have hker : (q.subgroupMap B).ker = pCore 2 B := by
    rw [Subgroup.ker_subgroupMap,QuotientGroup.ker_mk',hcentral]
    exact (pCore_eq_comap_of_normal 2 B).symm
  let eB := subgroupOfEquivOfLe hBJ
  obtain ⟨e₆⟩ := D.nonsingular_local_quotient H.chosen H.source.quasisimple v hv
  let eC : C ≃* alternatingGroup (Fin 6) :=
    (QuotientGroup.quotientKerEquivOfSurjective (q.subgroupMap B)
      (q.subgroupMap_surjective B)).symm.trans
      ((QuotientGroup.quotientMulEquivOfEq hker).trans
        ((QuotientGroup.congr _ _ eB (pCore_map_iso 2 eB)).trans e₆))
  let : Group.IsPerfect (Lv L (v : G)) := Lv_isPerfect_of_A6 L (v : G) e₆
  let : Group.IsPerfect B := Group.IsPerfect.ofSurjective (f := eB.symm.toMonoidHom) eB.symm.surjective
  let : Group.IsPerfect C := Group.IsPerfect.ofSurjective
    (f := q.subgroupMap B) (q.subgroupMap_surjective B)
  have hsqC : IsSQTK KnownSimple.IsKnownSimple C := by
    refine ⟨?_,?_⟩
    · intro p hp ho
      rw [primeRank_equiv p eC,GLS3.Chapter5.PRank.alternating_primeRank_of_odd_prime 6 p hp
        (by intro he; subst p; norm_num at ho)]
      have hpne : p ≠ 2 := by intro he; subst p; norm_num at ho
      have hp3 : 3 ≤ p := by have := hp.two_le; omega
      exact (Nat.div_le_div_left hp3 (by decide)).trans (by decide)
    · have hsqJ := hsqA.subgroup (J.subgroupOf A)
      have hJ : J ≤ A := inf_le_right
      have hkJ : IsKGroup KnownSimple.IsKnownSimple J :=
        (IsKGroup.equiv (subgroupOfEquivOfLe hJ)).mp hsqJ.isKGroup
      exact (hkJ.subgroup B).of_surjective (q.subgroupMap B) (q.subgroupMap_surjective B)
  have hquot : IsPGroup 2 (ChapterB.InternalThompsonAction.ActionQuotient X ⧸ C) := by
    have hp := localCentralizer_quotient_Lv_isPGroup T L H.chosen.sylow_normalizes_component (v : G)
    let f := QuotientGroup.map B C q (le_comap_map q B)
    exact hp.of_surjective f (QuotientGroup.map_surjective_of_surjective B C q
      ((QuotientGroup.mk'_surjective C).comp (QuotientGroup.mk'_surjective _)) _)
  have hgen : B = ⁅B,elementaryAbelianMaxJ S⁆ := by
    apply map_injective J.subtype_injective
    rw [map_commutator,hB,←elementaryAbelianMaxJ_map_injective J.subtype J.subtype_injective,
      map_subgroupOf_eq_of_le hSJ]
    exact hg
  have hXS : X ≤ S := by
    obtain ⟨P,hP⟩ := hTv.restrict hSJ
      (show J ≤ Mv L (v : G) from
        inf_le_inf (sup_le L.le_normalizer H.chosen.sylow_normalizes_component) le_rfl)
    exact comap_mono (hXR.trans ((pCoreIn_le_sylow _ P).trans hP.le))
  have hWgen : ⁅W,B⁆ = W := by
    apply map_injective J.subtype_injective
    rw [map_commutator,hW,hB]
    exact D.local_moved_generated H.chosen v hv
  have hWne : W ≠ ⊥ := by
    intro he
    have hh := D.nonsingular_moved_card H.chosen v hv
    have hz : W₀ = ⊥ := hW.symm.trans (by rw [he,Subgroup.map_bot])
    change Nat.card W₀ = 2^5 at hh
    rw [hz,Subgroup.card_bot] at hh
    omega
  have hWX : W ≤ X := comap_mono le_sup_left
  have hZX : Z ≤ X := comap_mono le_sup_right
  have hm : ⁅X,B⁆ ≠ ⊥ := by
    intro hz
    exact hWne (bot_unique (hWgen ▸ (commutator_mono hWX le_rfl).trans_eq hz))
  have hi := ChapterB.local_card360_moved_irrPlus X B S hXS hcentral hgen hm hsqC ⟨eC⟩ hquot
  have heW : ⁅X,B⁆ = W := le_antisymm
    (NormalElementaryQuotient.commutator_le_of_noncentral_invariant X W B hWX
      le_normalizer_of_normal q (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _)
      hi (by rwa [hWgen]))
    (hWgen ▸ commutator_mono hWX le_rfl)
  have hZgen : ⁅Z,B⁆ = Z := by rw [hZeq,perfect_commutator_idempotent Y B]
  have hZne : Z ≠ ⊥ := by
    intro hz
    apply H.reduced_point_moved D v hv hn
    exact hZ.symm.trans (by rw [hz,Subgroup.map_bot])
  have heZ : ⁅X,B⁆ = Z := le_antisymm
    (NormalElementaryQuotient.commutator_le_of_noncentral_invariant X Z B hZX
      le_normalizer_of_normal q (QuotientGroup.mk'_surjective _) (QuotientGroup.ker_mk' _)
      hi (by rwa [hZgen]))
    (hZgen ▸ commutator_mono hZX le_rfl)
  exact hZ.symm.trans ((congrArg (map J.subtype) (heZ.symm.trans heW)).trans hW)
end CFSG.Quasithin.Chapter12.Section06

namespace CFSG.Quasithin.Chapter12.Section06
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {L V : Subgroup G} [IsElementaryAbelian 2 V]

/-- Source12.6.11's strict enlargement at the actual preferred escaping
point, with both Thompson cases and the module comparison discharged. -/
theorem SourceHypothesis.exists_preferred_nonsingular_residual_strict
    (H : SourceHypothesis KnownSimple.IsKnownSimple T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    (hTI : ∀ g ∈ M L, V ⊓ V.map (MulAut.conj g).toMonoidHom = ⊥ ∨
      V.map (MulAut.conj g).toMonoidHom = V)
    (v : V) (hv : D.Nonsingular v) (he : ¬ Gv (v : G) ≤ M L) :
    ∃ w : V, D.Nonsingular w ∧ ¬ Gv (w : G) ≤ M L ∧
      Chapter1.IsSylowIn 2 (Tv T (w : G)) (Mv L (w : G)) ∧
      (Tv T (w : G)).relIndex (T : Subgroup G) = 4 ∧
      Lv L (w : G) < Kv (w : G) := by
  obtain ⟨w,hw,he,hs,hi,hred⟩ :=
    H.exists_preferred_nonsingular_Kv_reductions D hTV hTI v hv he
  refine ⟨w,hw,he,hs,hi,lt_of_le_of_ne (Lv_le_Kv_of_A6 L (w : G)
    (Classical.choice (D.nonsingular_local_quotient H.chosen H.source.quasisimple w hw))) ?_⟩
  intro heq
  have hn : Gv (w : G) ≤ normalizer (Lv L (w : G) : Set G) := by
    rw [heq]
    exact (normal_subgroupOf_iff_le_normalizer (Kv_le_Gv _)).mp (Kv_normalIn_Gv _)
  have hc : Gv (w : G) ⊓ centralizer (Vv L V (w : G) : Set G) ≤ M L :=
    (inf_le_inf le_rfl (Subgroup.centralizer_le_normalizer _)).trans (hred heq).2.2.1
  have hJ : ¬ elementaryAbelianMaxJ (Tv T (w : G)) ≤ Q T L := by
    intro hJ
    exact H.small_thompson_moves_normal_overmodule D w hw hs hJ he hc
      (componentOrbit (Vv L V (w : G)) (Gv (w : G)))
      (le_componentOrbit _ _) (le_normalizer_componentOrbit _ _)
      (H.small_thompson_closure_centralized D w hw hTV hs hJ heq)
  have hg := (H.nonsingular_thompson_generation D w hw hTV hs hJ).2.1
  have heW := H.reduced_point_commutator_eq D w hw hTV hs hn hc hg
  let A := Gv (w : G)
  let U := reducedTwoSubgroup A
  let B := (Lv L (w : G)).subgroupOf A
  let : B.Normal := normal_subgroupOf_of_le_normalizer hn
  have hW : (⁅U,B⁆ : Subgroup A).map A.subtype = Vv L V (w : G) := by
    rw [map_commutator,map_subgroupOf_eq_of_le (Lv_le_Gv L (w : G))]
    exact heW
  have hnW : A ≤ normalizer (Vv L V (w : G) : Set G) := by
    rw [←hW]
    simpa only [normalizer_eq_top,←MonoidHom.range_eq_map,range_subtype] using
      (⁅U,B⁆ : Subgroup A).le_normalizer_map A.subtype
  exact (hred heq).2.2.2 (normal_subgroupOf_of_le_normalizer hnW)
end CFSG.Quasithin.Chapter12.Section06
