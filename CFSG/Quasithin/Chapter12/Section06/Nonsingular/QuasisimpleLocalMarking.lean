module
public import CFSG.Quasithin.Chapter12.Section06.Nonsingular.CoreCentrality
public import Theory.GroupTheory.CentralQuotientLocalMarking
public import Theory.GroupTheory.PCoreFrattiniTransport
public import Theory.SpecificGroups.Alternating.TwoThreeCycles

/-!
# The original nonsingular local marking modulo the ambient center

Pass L_v and V_v through their inclusions in the literal K_v and its
canonical central quotient. The kernel on L_v lies in O₂(L_v), since the
A₆ quotient is centerless. Hence that quotient and the three-rank survive.
The nontrivial moved elementary group V_v cannot vanish modulo Z(K_v),
and its image is still normalized and generated by the perfect local image.
These supply the actual two-local marking used in the catalogue inspection.

Source: Aschbacher--Smith, Lemma 12.6.12, printed pp.825--826.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter12.Section06
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {L V : Subgroup G} [IsElementaryAbelian 2 V]

/-- The A₆ quotient and nontrivial moved subgroup survive the literal projection. -/
theorem SourceHypothesis.nonsingular_centralQuotient_local_marking
    {K : GroupClass} (H : SourceHypothesis K T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) (v : V) (hv : D.Nonsingular v) :
    let C := Kv (v : G)
    let P := (Lv L (v : G)).subgroupOf C
    let W := (Vv L V (v : G)).subgroupOf C
    let q := QuotientGroup.mk' (center C)
    Group.IsPerfect (P.map q) ∧
      Nonempty (((P.map q) ⧸ pCore 2 (P.map q)) ≃* alternatingGroup (Fin 6)) ∧
      2 ≤ primeRank 3 (P.map q) ∧ W.map q ≠ ⊥ ∧
      IsElementaryAbelian 2 (W.map q) ∧
      W.map q = ⁅W.map q,P.map q⁆ ∧
      P.map q ≤ normalizer (W.map q : Set (C ⧸ center C)) := by
  let C := Kv (v : G)
  let P := (Lv L (v : G)).subgroupOf C
  let W := (Vv L V (v : G)).subgroupOf C
  let q := QuotientGroup.mk' (center C)
  obtain ⟨eA⟩ := D.nonsingular_local_quotient H.chosen H.source.quasisimple v hv
  have hLC : Lv L (v : G) ≤ C := Lv_le_Kv_of_A6 L (v : G) eA
  have hWC : Vv L V (v : G) ≤ C := (Vv_le_Lv H.chosen v).trans hLC
  let eP : P ≃* Lv L (v : G) := subgroupOfEquivOfLe hLC
  let eW : W ≃* Vv L V (v : G) := subgroupOfEquivOfLe hWC
  let eQ : (P ⧸ pCore 2 P) ≃* alternatingGroup (Fin 6) :=
    (QuotientGroup.congr _ _ eP (pCore_map_iso 2 eP)).trans eA
  let : Group.IsPerfect (Lv L (v : G)) := Lv_isPerfect_of_A6 L (v : G) eA
  let : Group.IsPerfect P := Group.IsPerfect.ofSurjective
    (f := eP.symm.toMonoidHom) eP.symm.surjective
  have hc : center (P ⧸ pCore 2 P) = ⊥ := by
    apply bot_unique
    intro x hx
    have he : eQ x ∈ center (alternatingGroup (Fin 6)) := by
      apply mem_center_iff.mpr
      intro y
      obtain ⟨z,rfl⟩ := eQ.surjective y
      simpa only [map_mul] using congrArg eQ (mem_center_iff.mp hx z)
    rw [alternatingGroup.center_eq_bot (by simp),mem_bot] at he
    exact mem_bot.mpr (eQ.injective (he.trans eQ.map_one.symm))
  have hp : IsPGroup 2 (q.subgroupMap P).ker := pCore_isPGroup.to_le
    (CentralQuotientLocalMarking.subgroupMap_ker_le_pCore 2 P hc)
  let eR := ((q.subgroupMap P).pCoreQuotientEquiv (q.subgroupMap_surjective P) hp).symm.trans eQ
  have hr : 2 ≤ primeRank 3 (P.map q) := by
    rw [CentralQuotientLocalMarking.primeRank_map P hc (by decide : Odd 3),
      ←primeRank_quotient_eq_of_isTwoGroup 3 (by decide) (pCore 2 P) pCore_isPGroup,
      primeRank_equiv 3 eQ]
    exact alternatingGroup.TwoThreeCycles.two_le_primeRank (by decide)
  have hne : W ≠ ⊥ := by
    intro he
    have hh : Vv L V (v : G) = ⊥ := by
      have hm := congrArg (map C.subtype) he
      simpa only [W,map_subgroupOf_eq_of_le hWC,Subgroup.map_bot] using hm
    have hhcard := D.nonsingular_moved_card H.chosen v hv
    rw [hh,card_bot] at hhcard
    norm_num at hhcard
  let := Vv_elementary H.chosen.normalizes (v : G)
  have he : IsElementaryAbelian 2 W :=
    IsElementaryAbelian.of_injective eW.toMonoidHom eW.injective
  have hm : W = ⁅W,P⁆ := by
    apply map_injective C.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le hWC,map_subgroupOf_eq_of_le hLC]
    exact (D.local_moved_generated H.chosen v hv).symm
  obtain ⟨hperfect,hne,hele,hmove,hnorm⟩ :=
    CentralQuotientLocalMarking.moved_image P W hne he hm
  exact ⟨hperfect,⟨eR⟩,hr,hne,hele,hmove,hnorm⟩
end CFSG.Quasithin.Chapter12.Section06
