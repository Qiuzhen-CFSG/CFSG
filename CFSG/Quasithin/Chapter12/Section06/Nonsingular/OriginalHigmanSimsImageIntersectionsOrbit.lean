    inverseLetter k i (letter k i p) = p := by
  apply allFin
  decide +kernel

def permutation (k : Fin 10) (i : Fin 32) : Equiv.Perm (Fin 100) :=
  tablePerm (letter k i) (inverseLetter k i) (letter_left k i)
    (rightInverse_of_leftInverse_fin (letter_left k i))

theorem rep_left : ∀ (k : Fin 10) (p : Fin 100), repInverseLetter k (repLetter k p) = p := by
  apply allFin
  decide +kernel

def representative (k : Fin 10) : Equiv.Perm (Fin 100) :=
  tablePerm (repLetter k) (repInverseLetter k) (rep_left k)
    (rightInverse_of_leftInverse_fin (rep_left k))

def outer : Equiv.Perm (Fin 100) := permutation 0 16

def generatorLetter (j : Fin 3) (p : Fin 100) : Fin 100 :=
  ⟨( >>> (7*(100*j.val+p.val))) % 128 % 100,Nat.mod_lt _ (by decide)⟩

def generatorInverseLetter (j : Fin 3) (p : Fin 100) : Fin 100 :=
  ⟨( >>> (7*(100*j.val+p.val))) % 128 % 100,Nat.mod_lt _ (by decide)⟩

theorem generator_left : ∀ (j : Fin 3) (p : Fin 100),
    generatorInverseLetter j (generatorLetter j p) = p := by
  apply allFin
  decide +kernel

def generator (j : Fin 3) : Equiv.Perm (Fin 100) :=
  tablePerm (generatorLetter j) (generatorInverseLetter j) (generator_left j)
    (rightInverse_of_leftInverse_fin (generator_left j))

private theorem generator_triple : generator 0 = (OriginalHigmanSimsNative.triple).val.val := by
  apply Equiv.ext
  apply allFin
  decide +kernel
private theorem generator_eight : generator 1 = (OriginalHigmanSimsNative.eight).val.val := by
  apply Equiv.ext
  apply allFin
  decide +kernel
theorem generator_outer : generator 2 = outer := by
  apply Equiv.ext
  apply allFin
  decide +kernel

theorem permutation_injective (k : Fin 10) : Function.Injective (permutation k) := by
  have h : ∀ (k : Fin 10) (i j : Fin 32),
      letter k i (separatingPoint k 0) = letter k j (separatingPoint k 0) →
      letter k i (separatingPoint k 1) = letter k j (separatingPoint k 1) → i=j := by
    apply allFin
    decide +kernel
  intro i j hij
  exact h k i j (congrArg (fun p => p (separatingPoint k 0)) hij)
    (congrArg (fun p => p (separatingPoint k 1)) hij)

theorem permutation_zero : permutation 0 0 = 1 := by
  apply Equiv.ext
  apply allFin
  decide +kernel

theorem permutation_square (i : Fin 32) : permutation 0 i * permutation 0 i = 1 := by
  apply Equiv.ext
  have h : ∀ (i : Fin 32) (p : Fin 100), letter 0 i (letter 0 i p) = p := by
    apply allFin
    decide +kernel
  exact h i

theorem permutation_product (i j : Fin 32) :
    permutation 0 (product i j) = permutation 0 i * permutation 0 j := by
  apply Equiv.ext
  have h : ∀ (i j : Fin 32) (p : Fin 100),
      letter 0 (product i j) p = letter 0 i (letter 0 j p) := by
    apply allFin
    decide +kernel
  exact h i j

def first : Subgroup (Equiv.Perm (Fin 100)) where
  carrier := Set.range (permutation 0)
  one_mem' := ⟨0,permutation_zero⟩
  mul_mem' := by
    rintro x y ⟨i,rfl⟩ ⟨j,rfl⟩
    exact ⟨product i j,permutation_product i j⟩
  inv_mem' := by
    rintro x ⟨i,rfl⟩
    exact ⟨i,(inv_eq_of_mul_eq_one_left (permutation_square i)).symm⟩

def orbit (k : Fin 10) : Subgroup (Equiv.Perm (Fin 100)) :=
  first.map (MulAut.conj (representative k)).toMonoidHom

theorem conjugate_letter (k : Fin 10) (i : Fin 32) :
    (MulAut.conj (representative k)) (permutation 0 i) = permutation k i := by
  apply Equiv.ext
  have h : ∀ (k : Fin 10) (i : Fin 32) (p : Fin 100),
      repLetter k (letter 0 i (repInverseLetter k p)) = letter k i p := by
    apply allFin
    decide +kernel
  exact h k i

theorem mem_orbit (k : Fin 10) (x : Equiv.Perm (Fin 100)) :
    x ∈ orbit k ↔ ∃ i, permutation k i = x := by
  constructor
  · rintro ⟨_,⟨i,rfl⟩,rfl⟩
    exact ⟨i,conjugate_letter k i |>.symm⟩
  · rintro ⟨i,rfl⟩
    exact ⟨_,⟨i,rfl⟩,conjugate_letter k i⟩

theorem orbit_card (k : Fin 10) : Nat.card (orbit k) = 32 := by
  let f : Fin 32 → orbit k := fun i => ⟨permutation k i,(mem_orbit k _).mpr ⟨i,rfl⟩⟩
  have hi : Function.Injective f := fun i j h => permutation_injective k (congrArg Subtype.val h)
  have hs : Function.Surjective f := by
    intro x
    obtain ⟨i,hi⟩ := (mem_orbit k x).mp x.property
    exact ⟨i,Subtype.ext hi⟩
  exact (Nat.card_congr (Equiv.ofBijective f ⟨hi,hs⟩)).symm.trans (Nat.card_fin 32)

theorem orbit_zero : orbit 0 = first := by
  have hr : representative 0 = 1 := by
    apply Equiv.ext
    apply allFin
    decide +kernel
  simp only [orbit,hr,map_one]
  exact Subgroup.map_id first

theorem transition (k : Fin 10) (j : Fin 3) :
    (orbit k).map (MulAut.conj (generator j)).toMonoidHom = orbit (next k j) := by
  apply eq_of_le_of_card_ge
  · rintro _ ⟨x,hx,rfl⟩
    obtain ⟨i,rfl⟩ := (mem_orbit k x).mp hx
    apply (mem_orbit _ _).mpr
    refine ⟨code k j i,?_⟩
    apply Equiv.ext
    have h : ∀ (k : Fin 10) (j : Fin 3) (i : Fin 32) (p : Fin 100),
        letter (next k j) (code k j i) p =
          generator j (letter k i ((generator j)⁻¹ p)) := by
      apply allFin
      decide +kernel
    exact h k j i
  · rw [card_map_of_injective (MulAut.conj (generator j)).injective,orbit_card,orbit_card]

theorem transition_injective (j : Fin 3) : Function.Injective (fun k => next k j) := by
  have h : ∀ j : Fin 3, Function.Injective (fun k => next k j) := by decide +kernel
  exact h j

private theorem intersection_cover : ∀ (k : Fin 9) (i j : Fin 32),
    (∀ p : Fin 100, letter 0 i p = letter ⟨k.val+1,by omega⟩ j p) →
    allowed k (allowedCode k i) = i := by
  apply allFin
  decide +kernel

theorem orbit_intersection_bound (k : Fin 9) :
    Nat.card (first ⊓ orbit ⟨k.val+1,by omega⟩ : Subgroup (Equiv.Perm (Fin 100))) ≤ 4 := by
  let K : Fin 10 := ⟨k.val+1,by omega⟩
  have exists_row (x : (first ⊓ orbit K : Subgroup (Equiv.Perm (Fin 100)))) :
      ∃ i : Fin 32, permutation 0 i = x := x.property.1
  let f (x : (first ⊓ orbit K : Subgroup (Equiv.Perm (Fin 100)))) : Fin 32 := Classical.choose (exists_row x)
  have hf (x : (first ⊓ orbit K : Subgroup (Equiv.Perm (Fin 100)))) : permutation 0 (f x) = x := Classical.choose_spec (exists_row x)
  let c (x : (first ⊓ orbit K : Subgroup (Equiv.Perm (Fin 100)))) : Fin 4 := allowedCode k (f x)
  have hc (x : (first ⊓ orbit K : Subgroup (Equiv.Perm (Fin 100)))) : allowed k (c x) = f x := by
    obtain ⟨j,hj⟩ := (mem_orbit K x).mp x.property.2
    exact intersection_cover k (f x) j (fun p => congrArg (fun a => a p) ((hf x).trans hj.symm))
  have hinj : Function.Injective c := by
    intro x y he
    apply Subtype.ext
    rw [←hf x,←hf y,←hc x,←hc y,he]
  simpa only [Nat.card_fin] using Nat.card_le_card_of_injective c hinj

