module
public import CFSG.Quasithin.Chapter12.Section06.Nonsingular.NormalityReduction
public import Theory.GroupTheory.ElementaryThompsonRelative
public import Theory.GroupTheory.PCoreQuotientJoinAction
public import Theory.GroupTheory.PerfectNormalImage

/-!
# Global Thompson generation in the original orthogonal case

Nontrivial Thompson action on L/O₂(L) has full image because that quotient
is the actual A₈. Perfectness of L removes the solvable kernel. If the local
residual is generated by J(T_v), Thompson heredity rules out J(T)≤Q: that
would force L_v into its two-core, contradicting its A₆ quotient.

These are the global generation implication and clause (2) of
Aschbacher--Smith, Lemma 12.6.7, printed p.824. The local generation assertion
of 12.6.6 still requires its offender argument.
-/

public section
open Subgroup Theory.GroupTheory Stellmacher
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter12.Section06
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {L V : Subgroup G}

/-- Thompson movement outside the original two-core generates L. -/
theorem SourceHypothesis.eq_commutator_thompson_of_not_le_core
    {K : GroupClass} (H : SourceHypothesis K T L V)
    (hJ : ¬ elementaryAbelianMaxJ (T : Subgroup G) ≤ Q T L) :
    L = ⁅L,elementaryAbelianMaxJ (T : Subgroup G)⁆ := by
  let := H.chosen.elementary
  obtain ⟨D⟩ := H.orthogonal
  let := Chapter1.mem_L_isPerfect H.source.maximal_faithful.1.1
  let J := elementaryAbelianMaxJ (T : Subgroup G)
  let C := ⁅L,J⁆
  have hJT : J ≤ (T : Subgroup G) := sSup_le (fun _ h => h.1)
  have hTL := H.chosen.sylow_normalizes_component
  have hCL : C ≤ L := le_normalizer_iff_commutator_le_left.mp (hJT.trans hTL)
  let N := C.subgroupOf L
  let : N.Normal := normal_subgroupOf_of_le_normalizer (normalizer_commutator_ge_left L J)
  let e := D.coreQuotientEquiv H.chosen H.source.quasisimple
  let f := e.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 L))
  have hf : Function.Surjective f := e.surjective.comp (QuotientGroup.mk'_surjective _)
  have hk : f.ker = pCore 2 L := by
    rw [MonoidHom.ker_comp_of_injective _ _ e.injective,QuotientGroup.ker_mk']
  let : Group.IsNilpotent f.ker := (hk ▸ pCore_isPGroup).isNilpotent
  let : IsSimpleGroup (alternatingGroup (Fin 8)) := alternatingGroup.isSimpleGroup (by simp)
  let : (N.map f).Normal := (inferInstance : N.Normal).map f hf
  rcases (inferInstance : (N.map f).Normal).eq_bot_or_eq_top with hn | hn
  · exfalso
    have hN := (Subgroup.map_eq_bot_iff N).mp hn
    rw [hk] at hN
    apply hJ
    intro j hj
    let jH : (L ⊔ (T : Subgroup G) : Subgroup G) := ⟨j,mem_sup_right (hJT hj)⟩
    have hjker : jH ∈ (pCoreJoinAction 2 hTL).ker := by
      apply MulEquiv.ext
      intro x
      obtain ⟨l,rfl⟩ := QuotientGroup.mk'_surjective (pCore 2 L) x
      rw [pCoreJoinAction_mk]
      let b : L := L.normalizerMonoidHom (inclusion (sup_le L.le_normalizer hTL) jH) l
      have hb : b*l⁻¹ ∈ pCore 2 L := by
        apply hN
        change ⁅j,(l : G)⁆ ∈ C
        change ⁅j,(l : G)⁆ ∈ ⁅L,J⁆
        rw [commutator_comm]
        exact commutator_mem_commutator hj l.property
      have he := (QuotientGroup.eq_one_iff (b*l⁻¹)).mpr hb
      change QuotientGroup.mk' (pCore 2 L) (b*l⁻¹) = 1 at he
      rw [map_mul,map_inv] at he
      exact mul_inv_eq_one.mp he
    have hcore := (pCoreJoinAction_kernel 2 hTL T.isPGroup'
      (D.coreQuotient_center_eq_bot H.chosen H.source.quasisimple)) ▸ hjker
    exact mem_map_of_mem (LT T L).subtype hcore
  · have ht := eq_top_of_perfect_of_solvable_kernel_image f N hn
    apply le_antisymm ?_ hCL
    intro l hl
    exact (show (⟨l,hl⟩ : L) ∈ N from ht ▸ mem_top _)

end CFSG.Quasithin.Chapter12.Section06

namespace CFSG.Quasithin.Chapter12.Section06
variable {G : Type*} [Group G] [Finite G]
variable {T : Sylow 2 G} {L V : Subgroup G}

/-- Source 12.6.7(2), retaining the original local and global Thompson groups. -/
theorem SourceHypothesis.eq_commutator_thompson_of_local
    [IsElementaryAbelian 2 V]
    {K : GroupClass} (H : SourceHypothesis K T L V)
    (D : OrthogonalMarking L V H.chosen.normalizes) (v : V) (hv : D.Nonsingular v)
    (hlocal : Lv L (v : G) = ⁅Lv L (v : G),elementaryAbelianMaxJ (Tv T (v : G))⁆) :
    L = ⁅L,elementaryAbelianMaxJ (T : Subgroup G)⁆ := by
  apply H.eq_commutator_thompson_of_not_le_core
  intro hJ
  have hJTv := elementaryAbelianMaxJ_eq_of_intermediate (T : Subgroup G) (Tv T (v : G))
    (hJ.trans (Q_le_Tv H.chosen v)) inf_le_left
  have hsmall : elementaryAbelianMaxJ (Tv T (v : G)) ≤ Q T L := by
    rw [hJTv]
    exact hJ
  obtain ⟨⟨e⟩,_,_,_⟩ := D.nonsingular_local_structure H.chosen H.source.quasisimple v hv
  have hc : Rv T L (v : G) ≤ coreQuotientCentralizer (Lv L (v : G)) :=
    (Rv_eq_inf_coreQuotientCentralizer T L H.chosen.sylow_normalizes_component _
      (Lv_coreQuotient_center_eq_bot_of_A6 _ _ e)).le.trans inf_le_right
  have hcomm : ⁅Lv L (v : G),elementaryAbelianMaxJ (Tv T (v : G))⁆ ≤
      (Lv L (v : G)).pCoreIn 2 := by
    rw [commutator_comm]
    apply commutator_le.mpr
    intro a ha b hb
    exact ((mem_coreQuotientCentralizer_iff _ _).mp
      (hc (Q_le_Rv H.chosen v (hsmall ha)))).2 b hb
  have hp : IsPGroup 2 (Lv L (v : G)) :=
    (isPGroup_pCoreIn 2 _).to_le (hlocal.le.trans hcomm)
  let : Group.IsNilpotent (Lv L (v : G)) := hp.isNilpotent
  let : Group.IsSolvable (alternatingGroup (Fin 6)) :=
    Group.isSolvable_of_surjective (f := e.toMonoidHom.comp
      (QuotientGroup.mk' (pCore 2 (Lv L (v : G)))))
      (e.surjective.comp (QuotientGroup.mk'_surjective _))
  let : Group.IsPerfect (alternatingGroup (Fin 6)) :=
    ⟨commutator_alternatingGroup_eq_top (by simp)⟩
  exact Group.IsPerfect.not_isSolvable (alternatingGroup (Fin 6)) inferInstance

end CFSG.Quasithin.Chapter12.Section06
