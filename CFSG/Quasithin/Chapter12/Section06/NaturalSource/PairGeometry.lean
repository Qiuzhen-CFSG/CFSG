module
public import CFSG.Quasithin.Chapter12.Section06.NaturalSource.IntersectingPairs
public import CFSG.Quasithin.Chapter12.Section06.Nonabelian.PairSeed

/-!
# Original non-two conjugate pairs in 12.6.26

The literal original F.9 application and the proved intersecting-pair
condition construct the extraspecial seed generated by V5 and V5^g.
Its center is V1, its order is 512 and its central quotient has order256.
The kernel of the pair action on that quotient is exactly the pair's
intersection with O2(H), using H's intrinsic core and the same point.

Only the earlier fixed-space, point-invariance, intersection and
nonsingular-centralizer conclusions remain explicit here. The
orthogonal plus marking, dihedral orders, odd-core exclusions and the
abelian span of 12.6.26 still require proof; this is their actual seed.
Source: Aschbacher--Smith, 12.6.26, printed pp.831--832.
-/

public section
namespace CFSG.Quasithin.Chapter12.Section06
open Subgroup Theory.GroupTheory
open scoped commutatorElement
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V : Subgroup G} [IsElementaryAbelian 2 V]
  (S : SourceHypothesis KnownSimple.IsKnownSimple T L V)
  (D : OrthogonalMarking L V S.chosen.normalizes) (hZ : ZV L V = ⊥) (z : V)

/-- The actual original pair seed and central action kernel, with no pair-geometry premise. -/
theorem SourceHypothesis.original_non_two_pair_geometry
    (hz : z ≠ 1)
    (hTV : (T : Subgroup G) ≤ normalizer (V : Set G))
    (hTz : (T : Subgroup G) ≤ normalizer ((D.fullSetup hZ T z).V₁ : Set G))
    (hbound : ∀ g : G, g ∉ normalizer (V : Set G) →
      Nat.card (V ⊓ V.map (MulAut.conj g).toMonoidHom : Subgroup G) ≤ 2 ^ 3)
    (hns : ∀ w : V, D.Nonsingular w → Gv w.val ≤ M L)
    {H : Subgroup G} (hH : H ∈ (D.fullSetup hZ T z).Hz)
    (g : G) (hg : g ∈ H)
    (hn : ¬ IsPGroup 2 (V ⊔ V.map (MulAut.conj g).toMonoidHom : Subgroup G)) :
    let E := D.fullSetup hZ T z
    let P := E.pairSeed g
    (center P).map P.subtype = E.V₁ ∧ Nat.card P = 2 ^ 9 ∧
      IsExtraspecial 2 P ∧ Nat.card (P ⧸ center P) = 2 ^ 8 ∧
      commutatorPreimage (V ⊔ V.map (MulAut.conj g).toMonoidHom) P E.V₁ =
        (V ⊔ V.map (MulAut.conj g).toMonoidHom) ⊓ H.pCoreIn 2 := by
  let E := D.fullSetup hZ T z
  let P := E.pairSeed g
  have h := S.original_f9_of_earlier_geometry D hZ z hz hTV hTz hbound hH
  have hC := S.original_perpendicular_centralizer D hZ z hz hTV hTz hbound
  have hout : ¬ E.Gz ≤ M L := fun hh => hH.2.2 (hH.2.1.trans hh)
  have hp : ∀ a ∈ H, E.V₁ < V ⊓ V.map (MulAut.conj a).toMonoidHom →
      IsPGroup 2 (V ⊔ V.map (MulAut.conj a).toMonoidHom : Subgroup G) :=
    fun a _ => S.original_intersecting_pair_isTwoGroup D hZ z hz hTV hTz hbound hout hns a
  obtain ⟨hc,hcard,hs⟩ := E.pair_seed_structure h hz hp hC g hg hn
  have hcZ : ⁅V,H ⊓ centralizer (E.V₅ : Set G)⁆ ≤ E.V₁ := by
    rw [hC,commutator_comm,commutator_eq_bot_iff_le_centralizer.mpr inf_le_right]
    exact bot_le
  have hquot : Nat.card (P ⧸ center P) = 2 ^ 8 := by
    have hh := card_eq_card_quotient_mul_card_subgroup (center P)
    rw [hcard,hs.center_order_p] at hh
    omega
  exact ⟨hc,hcard,hs,hquot,Nonabelian.pair_seed_kernel_of_extraspecial h hcZ g hg hs hc⟩

end CFSG.Quasithin.Chapter12.Section06
