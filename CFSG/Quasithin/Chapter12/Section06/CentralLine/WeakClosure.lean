module

public import CFSG.Quasithin.ChapterE.Section03.Offenders.Transport

/-!
# The weak-closure deductions in 12.6.22

The centralizer span used in the permutation calculation normalizes the
original conjugate by the actual r-parameter. The W₁ and w conclusions follow
from the two preceding clauses of 12.6.22, using Sylow transport inside N_G(V).
None of these bridges assumes weak closure of V or a trivial central line.

Source: Aschbacher–Smith, combined manuscript (1 March 2004),
Lemma 12.6.22, printed p.829. The eight-point permutation calculation still
has to establish W₀-centralization and the small-corank normalization clause.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter12.Section06.CentralLine
open Subgroup ChapterE
variable {G : Type*} [Group G]

/-- The literal subgroup generated by C_V(B), for B ≤ A of corank at most
three in Vᵍ, used in the proof of 12.6.22. -/
def centralizerSpan (V A : Subgroup G) (g : G) : Subgroup G :=
  ⨆ (B : Subgroup G) (_ : B ≤ A ∧
    subgroupCorank (V.map (MulAut.conj g).toMonoidHom) B ≤ 3),
    V ⊓ centralizer (B : Set G)

/-- The E.3.32 argument applies to the whole generated span, retaining its
literal subgroups and the actual corank in Vᵍ. -/
theorem centralizerSpan_le {V A : Subgroup G} {g : G}
    (hA : A ≤ V.map (MulAut.conj g).toMonoidHom) (hr : 4 ≤ globalR V) :
    centralizerSpan V A g ≤ V ⊓
      normalizer (V.map (MulAut.conj g).toMonoidHom : Set G) := by
  apply iSup_le
  intro B
  apply iSup_le
  rintro ⟨hBA, hB⟩
  apply le_inf inf_le_left
  apply inf_le_right.trans
  apply centralizer_le_normalizer_of_corank_lt_globalR (hBA.trans hA)
  rw [globalR_map_equiv]
  exact lt_of_lt_of_le (by exact_mod_cast (show subgroupCorank
    (V.map (MulAut.conj g).toMonoidHom) B < 4 by omega)) hr

/-- Both relative normalizer containments give the source's actual
[A,U] ≤ V ∩ Vᵍ. No ambient normality of either module is used. -/
theorem commutator_centralizerSpan_le {V A : Subgroup G} {g : G}
    (hA : A ≤ V.map (MulAut.conj g).toMonoidHom)
    (hAN : A ≤ normalizer (V : Set G)) (hr : 4 ≤ globalR V) :
    ⁅A, centralizerSpan V A g⁆ ≤ V ⊓ V.map (MulAut.conj g).toMonoidHom := by
  have hU := centralizerSpan_le hA hr
  apply le_inf
  · exact (commutator_mono le_rfl (hU.trans inf_le_left)).trans
      (le_normalizer_iff_commutator_le_right.mp hAN)
  · exact (commutator_mono hA le_rfl).trans
      (le_normalizer_iff_commutator_le_left.mp (hU.trans inf_le_right))

variable [Finite G]

/-- From 12.6.22(1–2), every corank-zero or corank-one weak-closure generator
centralizes V. The quotient uses N_G(V); in the source's central-line case
12.2.2(3) identifies this normalizer with M. -/
theorem weakClosure_le_of_small_corank_normalizes
    {V : Subgroup G} [IsElementaryAbelian 2 V] {T : Sylow 2 G}
    (hTN : (T : Subgroup G) ≤ normalizer (V : Set G))
    (hW0 : indexedWeakClosure V T 0 ≤ centralizer (V : Set G))
    (hsmall : ∀ g : G, subgroupCorank (V.map (MulAut.conj g).toMonoidHom)
      (offenderNormalizer V g) ≤ 1 →
      V.map (MulAut.conj g).toMonoidHom ≤ normalizer (V : Set G))
    {i : ℕ} (hi : i ≤ 1) :
    indexedWeakClosure V T i ≤ (T : Subgroup G) ⊓ centralizer (V : Set G) := by
  apply le_inf (indexedWeakClosure_le V T i)
  rw [weakClosure_eq_sSup_gamma]
  apply sSup_le
  rintro A ⟨⟨g, hAW, hindex⟩, hAT⟩
  let W := V.map (MulAut.conj g).toMonoidHom
  let _ : IsElementaryAbelian 2 W := IsElementaryAbelian.map _
  have hAB : A ≤ offenderNormalizer V g := le_inf hAW (hAT.trans hTN)
  have hcor : subgroupCorank W A = i := by
    unfold subgroupCorank
    rw [hindex, Nat.log_pow (by decide)]
  have hcor' := offender_corank_add hAB
    (show offenderNormalizer V g ≤ W from inf_le_left)
  have hsmall' : subgroupCorank W (offenderNormalizer V g) ≤ 1 := by omega
  have hWC := (conjugate_normalization_equivalences_of_weakClosure_zero hTN hW0 g).1.mp
    (hsmall g hsmall')
  exact hAW.trans hWC

/-- The complete numerical deduction 12.6.22(1–2) ⇒ 12.6.22(3), also
exporting the W₁ containment needed by later E.3 applications. -/
theorem W1_and_globalW_of_small_corank_normalizes
    {V : Subgroup G} [IsElementaryAbelian 2 V] {T : Sylow 2 G}
    (hTN : (T : Subgroup G) ≤ normalizer (V : Set G))
    (hW0 : indexedWeakClosure V T 0 ≤ centralizer (V : Set G))
    (hsmall : ∀ g : G, subgroupCorank (V.map (MulAut.conj g).toMonoidHom)
      (offenderNormalizer V g) ≤ 1 →
      V.map (MulAut.conj g).toMonoidHom ≤ normalizer (V : Set G)) :
    indexedWeakClosure V T 1 ≤ (T : Subgroup G) ⊓ centralizer (V : Set G) ∧
      1 < globalW V T := by
  refine ⟨weakClosure_le_of_small_corank_normalizes hTN hW0 hsmall le_rfl, ?_⟩
  have htwo : 2 ≤ globalW V T := by
    apply le_iInf
    intro j
    apply le_iInf
    intro hj
    have hj' : 2 ≤ j := by
      by_contra! hn
      exact hj (weakClosure_le_of_small_corank_normalizes hTN hW0 hsmall (by omega))
    exact_mod_cast hj'
  exact lt_of_lt_of_le (by decide : (1 : ℕ∞) < 2) htwo

end CFSG.Quasithin.Chapter12.Section06.CentralLine
