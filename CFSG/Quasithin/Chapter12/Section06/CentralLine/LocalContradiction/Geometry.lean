module

public import CFSG.Quasithin.Chapter12.Section06.Setup
public import CFSG.Quasithin.Chapter12.Section06.CentralLine.WeakClosure
public import CFSG.Quasithin.Chapter3.Section01.LocalGeometry
public import Theory.GroupTheory.ConjugateSpanOrder
public import Theory.GroupTheory.PResidual.SylowSupplement
public import Mathlib.Order.Minimal

/-!
# Literal local groups and actors for Lemma 12.6.23

The source seed is Z = Ω₁(Z(T)). Its H-conjugate span is distinct from
C_V(L). The quotient below is H/C_H(⟨Zᴴ⟩), defined as the kernel quotient of
conjugation. We select an actual conjugate Vᵍ from the zeroth weak closure
and use the global r-parameter to prove its reverse normalization and the
resulting commutator bound. The equality of the action kernel with O₂(H)
remains a separate earlier local-structure input.

Source: Aschbacher–Smith, combined manuscript (1 March 2004),
Lemma 12.6.23, printed pp.829–830.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter12.Section06.CentralLine.LocalContradiction
open Subgroup Theory.GroupTheory ChapterE
open scoped IsMulCommutative
variable {G : Type*} [Group G]

/-- The actual local module, generated by the Sylow-center seed Z. -/
def localSpan (T : Sylow 2 G) (H : Subgroup G) : Subgroup G :=
  conjugateSpanBy (Z T) H

/-- The ambient image of O²(H), separate from O₂(H). -/
def localResidual (H : Subgroup G) : Subgroup G :=
  (pResidual 2 H).map H.subtype

theorem sylowSeed_le (T : Sylow 2 G) : Z T ≤ (T : Subgroup G) :=
  (omegaOneAmbient_le _).trans (map_subtype_le _)

theorem localSpan_le {T : Sylow 2 G} {H : Subgroup G}
    (hTH : (T : Subgroup G) ≤ H) : localSpan T H ≤ H :=
  conjugateSpanBy_le_self ((sylowSeed_le T).trans hTH)

theorem normalizes_localSpan (T : Sylow 2 G) (H : Subgroup G) :
    H ≤ normalizer (localSpan T H : Set G) :=
  le_normalizer_conjugateSpanBy _ _

theorem localSpan_normalIn {T : Sylow 2 G} {H : Subgroup G}
    (hTH : (T : Subgroup G) ≤ H) : ((localSpan T H).subgroupOf H).Normal :=
  (normal_subgroupOf_iff_le_normalizer (localSpan_le hTH)).mpr
    (normalizes_localSpan T H)

theorem localResidual_normalIn (H : Subgroup G) :
    ((localResidual H).subgroupOf H).Normal := by
  apply (normal_subgroupOf_iff_le_normalizer (map_subtype_le _)).mpr
  simpa only [localResidual, normalizer_eq_top, ← MonoidHom.range_eq_map,
    range_subtype] using (pResidual 2 H).le_normalizer_map H.subtype

/-- The literal source factorization H=O²(H)T. -/
theorem residual_sup_sylow [Finite G] {T : Sylow 2 G} {H : Subgroup G}
    (hTH : (T : Subgroup G) ≤ H) : localResidual H ⊔ (T : Subgroup G) = H := by
  have h := congrArg (Subgroup.map H.subtype) (pResidual_sup_sylow_eq_top (T.subtype hTH))
  simpa only [Subgroup.map_sup, Sylow.coe_subtype, map_subgroupOf_eq_of_le hTH,
    ← MonoidHom.range_eq_map, range_subtype, localResidual] using h

/-- The needed Borel containment follows from its two-residual containment;
this does not assume Borel normality in H. -/
theorem borel_le_LT_of_residual [Finite G] {T : Sylow 2 G} {H M L : Subgroup G}
    (hTH : (T : Subgroup G) ≤ H) (hTM : (T : Subgroup G) ≤ M)
    (hres : localResidual (H ⊓ M) ≤ L) : H ⊓ M ≤ LT T L := by
  rw [← residual_sup_sylow (le_inf hTH hTM)]
  exact sup_le (hres.trans le_sup_left) le_sup_right

/-- Conjugation by H on the literal span. -/
def localConjugation (T : Sylow 2 G) (H : Subgroup G) :
    H →* MulAut (localSpan T H) :=
  conjugation H (localSpan T H) (normalizes_localSpan T H)

/-- The quotient is by C_H(V_H); no two-core equality is implicit. -/
abbrev LocalQuotient (T : Sylow 2 G) (H : Subgroup G) :=
  H ⧸ (localConjugation T H).ker

/-- The literal image of A ∩ H in the local action quotient. -/
def localImage (T : Sylow 2 G) (H A : Subgroup G) : Subgroup (LocalQuotient T H) :=
  (A.subgroupOf H).map (QuotientGroup.mk' (localConjugation T H).ker)

theorem localConjugation_ker (T : Sylow 2 G) (H : Subgroup G) :
    (localConjugation T H).ker = (centralizer (localSpan T H : Set G)).subgroupOf H :=
  conjugation_ker _ _ _

theorem localImage_eq_bot_iff {T : Sylow 2 G} {H A : Subgroup G} (hAH : A ≤ H) :
    localImage T H A = ⊥ ↔ A ≤ centralizer (localSpan T H : Set G) := by
  rw [localImage, Subgroup.map_eq_bot_iff, QuotientGroup.ker_mk', localConjugation_ker]
  constructor
  · intro h a ha
    exact h (show (⟨a, hAH ha⟩ : H) ∈ A.subgroupOf H from ha)
  · intro h a ha
    exact h ha

/-- Restriction of the literal action quotient map to an actor A ≤ H. -/
def localActorMap {T : Sylow 2 G} {H A : Subgroup G} (hAH : A ≤ H) :
    A →* LocalQuotient T H :=
  (QuotientGroup.mk' (localConjugation T H).ker).comp (inclusion hAH)

theorem localActorMap_ker {T : Sylow 2 G} {H A : Subgroup G} (hAH : A ≤ H) :
    (localActorMap (T := T) hAH).ker =
      (centralizer (localSpan T H : Set G)).subgroupOf A := by
  ext a
  change (QuotientGroup.mk' (localConjugation T H).ker)
    (inclusion hAH a) = 1 ↔ _
  change inclusion hAH a ∈ (QuotientGroup.mk' (localConjugation T H).ker).ker ↔ _
  rw [QuotientGroup.ker_mk', localConjugation_ker]
  rfl

/-- The quotient rank really is the corank of the centralizer in this actor. -/
theorem localImage_card {T : Sylow 2 G} {H A : Subgroup G} (hAH : A ≤ H) :
    Nat.card (localImage T H A) =
      (centralizer (localSpan T H : Set G)).relIndex A := by
  rw [localImage, ← Subgroup.relIndex_ker, QuotientGroup.ker_mk', localConjugation_ker]
  change ((centralizer (localSpan T H : Set G)).comap H.subtype).relIndex
    (A.subgroupOf H) = _
  rw [relIndex_comap, map_subgroupOf_eq_of_le hAH]

/-- After the local-structure theorem identifies O₂(H) with C_H(V_H),
the action kernel is precisely the source subgroup B=A ∩ O₂(H). -/
theorem localActorMap_ker_eq_core_intersection {T : Sylow 2 G} {H A : Subgroup G}
    (hAH : A ≤ H)
    (hcore : H.pCoreIn 2 = H ⊓ centralizer (localSpan T H : Set G)) :
    (localActorMap (T := T) hAH).ker = (A ⊓ H.pCoreIn 2).subgroupOf A := by
  rw [localActorMap_ker, hcore]
  ext a
  exact ⟨fun ha => ⟨a.property, hAH a.property, ha⟩, fun ha => ha.2.2⟩

theorem core_intersection_corank {T : Sylow 2 G} {H A : Subgroup G} (hAH : A ≤ H)
    (hcore : H.pCoreIn 2 = H ⊓ centralizer (localSpan T H : Set G)) :
    subgroupCorank A (A ⊓ H.pCoreIn 2) =
      Representation.BinaryOffender.rank (localImage T H A) := by
  unfold subgroupCorank Representation.BinaryOffender.rank
  rw [localImage_card hAH, hcore, ← inf_assoc,
    inf_eq_left.mpr hAH, inf_relIndex_left]

/-- Finite minimization constructs a member of the actual Chapter 3 family. -/
theorem exists_HStar_below [Finite G] {T : Sylow 2 G} {M J : Subgroup G}
    (hJ : J ∈ Chapter1.HOver G (T : Set G)) (hJM : ¬ J ≤ M) :
    ∃ H ≤ J, H ∈ Chapter3.HStar (T : Subgroup G) M :=
  exists_minimal_le_of_wellFoundedLT
    (fun Y => Y ∈ Chapter1.HOver G (T : Set G) ∧ ¬ Y ≤ M) J ⟨hJ, hJM⟩

/-- Noncentralization of W₀ selects a whole conjugate, with nontrivial image
under the actual local quotient map. No actor witness is assumed. -/
theorem exists_conjugate_actor {T : Sylow 2 G} {H V : Subgroup G}
    (hTH : (T : Subgroup G) ≤ H)
    (hW : ¬ indexedWeakClosure V T 0 ≤ centralizer (localSpan T H : Set G)) :
    ∃ g : G, V.map (MulAut.conj g).toMonoidHom ≤ (T : Subgroup G) ∧
      V.map (MulAut.conj g).toMonoidHom ≤ indexedWeakClosure V T 0 ∧
      ¬ V.map (MulAut.conj g).toMonoidHom ≤ centralizer (localSpan T H : Set G) ∧
      localImage T H (V.map (MulAut.conj g).toMonoidHom) ≠ ⊥ := by
  have hg : ∃ A ∈ gamma V T 0, ¬ A ≤ centralizer (localSpan T H : Set G) := by
    by_contra! h
    apply hW
    rw [weakClosure_eq_sSup_gamma]
    exact sSup_le h
  obtain ⟨A, hA, hn⟩ := hg
  obtain ⟨g, rfl, hAT⟩ := (mem_gamma_zero_iff V T A).mp hA
  exact ⟨g, hAT, gamma_le_weakClosure hA, hn,
    fun hz => hn ((localImage_eq_bot_iff (hAT.trans hTH)).mp hz)⟩

/-- E.3.15 supplies H-normalization of W₀ if W₀ centralizes V_H.
The E.3.34 normalizer bound then excludes this possibility for H outside M. -/
theorem weakClosure_not_centralizing [Finite G]
    {T : Sylow 2 G} {M V H : Subgroup G}
    (hTH : (T : Subgroup G) ≤ H) (hHM : ¬ H ≤ M)
    (hcore : H.pCoreIn 2 = H ⊓ centralizer (localSpan T H : Set G))
    (hN : normalizer (indexedWeakClosure V T 0 : Set G) ≤ M) :
    ¬ indexedWeakClosure V T 0 ≤ centralizer (localSpan T H : Set G) := by
  intro hW
  have hWcore : indexedWeakClosure V T 0 ≤ H.pCoreIn 2 := by
    rw [hcore]
    exact le_inf ((indexedWeakClosure_le V T 0).trans hTH) hW
  have hcoreN : H ≤ normalizer (H.pCoreIn 2 : Set G) := by
    simpa only [pCoreIn, normalizer_eq_top, ← MonoidHom.range_eq_map,
      range_subtype] using (pCore 2 H).le_normalizer_map H.subtype
  have hnorm := normalizer_le_weakClosure_normalizer_of_two_overgroup V H
    (T.subtype hTH) (H.pCoreIn 2) 0 (isPGroup_pCoreIn 2 H) (pCoreIn_le 2 H)
    (by simpa only [Sylow.coe_subtype, map_subgroupOf_eq_of_le hTH] using hWcore)
  simp only [Sylow.coe_subtype, map_subgroupOf_eq_of_le hTH] at hnorm
  exact hHM (hcoreN.trans (hnorm.trans hN))

/-- In the Borel H ∩ M, the source equality C_T(V)=O₂(LT) and
H ∩ M ≤ LT put every weak-closure generator in its actual two-core. -/
theorem weakClosure_le_borel_core {T : Sylow 2 G} {L M V H : Subgroup G}
    (hTH : (T : Subgroup G) ≤ H) (hTM : (T : Subgroup G) ≤ M)
    (hHM : H ⊓ M ≤ LT T L)
    (hQ : (T : Subgroup G) ⊓ centralizer (V : Set G) = Q T L)
    (hW : indexedWeakClosure V T 0 ≤ centralizer (V : Set G)) :
    indexedWeakClosure V T 0 ≤ (H ⊓ M).pCoreIn 2 := by
  have hWQ : indexedWeakClosure V T 0 ≤ Q T L := by
    rw [← hQ]
    exact le_inf (indexedWeakClosure_le V T 0) hW
  exact hWQ.trans (Chapter3.twoCore_le_of_sylow_le T (le_inf hTH hTM) hHM)

/-- Application to the actual selected conjugate A=Vᵍ, in the same Borel. -/
theorem exists_conjugate_actor_in_borel_core
    {T : Sylow 2 G} {L M V H : Subgroup G}
    (hTH : (T : Subgroup G) ≤ H) (hTM : (T : Subgroup G) ≤ M)
    (hHM : H ⊓ M ≤ LT T L)
    (hQ : (T : Subgroup G) ⊓ centralizer (V : Set G) = Q T L)
    (hW : indexedWeakClosure V T 0 ≤ centralizer (V : Set G))
    (hn : ¬ indexedWeakClosure V T 0 ≤ centralizer (localSpan T H : Set G)) :
    ∃ g : G, V.map (MulAut.conj g).toMonoidHom ≤ (T : Subgroup G) ∧
      V.map (MulAut.conj g).toMonoidHom ≤ (H ⊓ M).pCoreIn 2 ∧
      localImage T H (V.map (MulAut.conj g).toMonoidHom) ≠ ⊥ := by
  obtain ⟨g, hAT, hAW, _, hne⟩ := exists_conjugate_actor hTH hn
  exact ⟨g, hAT, hAW.trans (weakClosure_le_borel_core hTH hTM hHM hQ hW), hne⟩

/-- The r ≥ 4 step, using B=A ∩ O₂(H) with its literal corank. Both
normalizer inclusions are relative; neither A nor V_H is ambient normal. -/
theorem conjugate_actor_normalization_and_commutator
    {T : Sylow 2 G} {H V : Subgroup G} {g : G}
    (hAH : V.map (MulAut.conj g).toMonoidHom ≤ H)
    (hQ : H.pCoreIn 2 ≤ centralizer (localSpan T H : Set G))
    (hr : 4 ≤ globalR V)
    (hk : subgroupCorank (V.map (MulAut.conj g).toMonoidHom)
      (V.map (MulAut.conj g).toMonoidHom ⊓ H.pCoreIn 2) ≤ 2) :
    localSpan T H ≤ normalizer (V.map (MulAut.conj g).toMonoidHom : Set G) ∧
      ⁅V.map (MulAut.conj g).toMonoidHom, localSpan T H⁆ ≤
        V.map (MulAut.conj g).toMonoidHom ⊓ localSpan T H := by
  have hCB : localSpan T H ≤ centralizer
      (V.map (MulAut.conj g).toMonoidHom ⊓ H.pCoreIn 2 : Set G) :=
    le_centralizer_iff.mp (inf_le_right.trans hQ)
  have hn := centralizer_le_normalizer_of_corank_lt_globalR
    (show V.map (MulAut.conj g).toMonoidHom ⊓ H.pCoreIn 2 ≤
      V.map (MulAut.conj g).toMonoidHom from inf_le_left) (by
        rw [globalR_map_equiv]
        exact lt_of_lt_of_le (by exact_mod_cast (show subgroupCorank
          (V.map (MulAut.conj g).toMonoidHom)
          (V.map (MulAut.conj g).toMonoidHom ⊓ H.pCoreIn 2) < 4 by omega)) hr)
  have hnormal := hCB.trans hn
  exact ⟨hnormal, le_inf
    (le_normalizer_iff_commutator_le_left.mp hnormal)
    (le_normalizer_iff_commutator_le_right.mp
      (hAH.trans (normalizes_localSpan T H)))⟩

/-- The same r-step stated with the genuine quotient-image rank k.
The kernel comparison above discharges the corank conversion. -/
theorem conjugate_actor_normalization_of_image_rank
    {T : Sylow 2 G} {H V : Subgroup G} {g : G}
    (hAH : V.map (MulAut.conj g).toMonoidHom ≤ H)
    (hcore : H.pCoreIn 2 = H ⊓ centralizer (localSpan T H : Set G))
    (hr : 4 ≤ globalR V)
    (hk : Representation.BinaryOffender.rank
      (localImage T H (V.map (MulAut.conj g).toMonoidHom)) ≤ 2) :
    localSpan T H ≤ normalizer (V.map (MulAut.conj g).toMonoidHom : Set G) ∧
      ⁅V.map (MulAut.conj g).toMonoidHom, localSpan T H⁆ ≤
        V.map (MulAut.conj g).toMonoidHom ⊓ localSpan T H :=
  conjugate_actor_normalization_and_commutator hAH
    (hcore ▸ inf_le_right) hr (by rwa [core_intersection_corank hAH hcore])

/-- Combined source-facing actor selection: neither escape of W₀ nor the
noncentralizing conjugate is an input. The local core and Borel containment
are the outstanding local-structure consequences of Corollary 12.3.2. -/
theorem local_actor_exists [Finite G]
    {T : Sylow 2 G} {L M V H : Subgroup G}
    (hH : H ∈ Chapter3.HStar (T : Subgroup G) M)
    (hTM : (T : Subgroup G) ≤ M) (hHM : H ⊓ M ≤ LT T L)
    (hQ : (T : Subgroup G) ⊓ centralizer (V : Set G) = Q T L)
    (hW : indexedWeakClosure V T 0 ≤ centralizer (V : Set G))
    (hcore : H.pCoreIn 2 = H ⊓ centralizer (localSpan T H : Set G))
    (hN : normalizer (indexedWeakClosure V T 0 : Set G) ≤ M) :
    ∃ g : G, V.map (MulAut.conj g).toMonoidHom ≤ (T : Subgroup G) ∧
      V.map (MulAut.conj g).toMonoidHom ≤ (H ⊓ M).pCoreIn 2 ∧
      localImage T H (V.map (MulAut.conj g).toMonoidHom) ≠ ⊥ :=
  exists_conjugate_actor_in_borel_core hH.1.1.2 hTM hHM hQ hW
    (weakClosure_not_centralizing hH.1.1.2 hH.1.2 hcore hN)

/-- The commutator bound gives quadraticity on the actual conjugation module.
No representation-transport or quadraticity certificate is assumed. -/
theorem quadratic_of_commutator_le_actor {A U : Subgroup G}
    [IsElementaryAbelian 2 A] [IsElementaryAbelian 2 U]
    (hn : A ≤ normalizer (U : Set G)) (hc : ⁅A, U⁆ ≤ A) :
    Representation.BinaryOffender.IsQuadratic (seedRepresentation A U hn) ⊤ := by
  intro a _ b _ v
  apply Additive.toMul.injective
  apply Subtype.ext
  change (a : G) * ((b : G) * (v.toMul : G) * (b : G)⁻¹ / (v.toMul : G)) *
      (a : G)⁻¹ = (b : G) * (v.toMul : G) * (b : G)⁻¹ / (v.toMul : G)
  simp only [div_eq_mul_inv]
  have hd : (b : G) * (v.toMul : G) * (b : G)⁻¹ * (v.toMul : G)⁻¹ ∈ A :=
    hc (commutator_mem_commutator b.property v.toMul.property)
  have he := congrArg Subtype.val (mul_comm a (⟨_, hd⟩ : A))
  simp only [Subgroup.coe_mul] at he
  rw [he, mul_inv_cancel_right]


/-- Application of quadraticity to the selected conjugate and the literal V_H.
The r-argument, rather than a supplied quadratic-action hypothesis, proves it. -/
theorem conjugate_actor_quadratic
    {T : Sylow 2 G} {H V : Subgroup G} {g : G}
    [IsElementaryAbelian 2 V] [IsElementaryAbelian 2 (localSpan T H)]
    (hAH : V.map (MulAut.conj g).toMonoidHom ≤ H)
    (hcore : H.pCoreIn 2 = H ⊓ centralizer (localSpan T H : Set G))
    (hr : 4 ≤ globalR V)
    (hk : Representation.BinaryOffender.rank
      (localImage T H (V.map (MulAut.conj g).toMonoidHom)) ≤ 2) :
    Representation.BinaryOffender.IsQuadratic
      (seedRepresentation (V.map (MulAut.conj g).toMonoidHom) (localSpan T H)
        (hAH.trans (normalizes_localSpan T H))) ⊤ := by
  let _ : IsElementaryAbelian 2 (V.map (MulAut.conj g).toMonoidHom) :=
    IsElementaryAbelian.map _
  exact quadratic_of_commutator_le_actor _
    ((conjugate_actor_normalization_of_image_rank hAH hcore hr hk).2.trans inf_le_left)


end CFSG.Quasithin.Chapter12.Section06.CentralLine.LocalContradiction
