module
public import CFSG.Quasithin.Chapter12.Section05.NaturalSource.Local.PointCore.ComponentIntersection
public import Theory.GroupTheory.CComponent.SevenCoverTheta
public import Theory.GroupTheory.PResidual.PrimePowerGeneration

/-!
# The original first-node residual in the central A₇ point row

The genuine cubic-actor theorem puts every order-three element of G₁ in
the relatively normal point component with central quotient A₇. The
original P has quotient S₃ modulo its two-core, so nine does not divide
its order. Its prime-to-three residual is therefore generated by cubics,
proving the literal Y ≤ K₁.

The original two-block quotient and Sylow restriction now give index 63
for the point-parabolic intersection. The triple cover has order 7560,
so that same intersection has order 504 and index 15. No coordinate or
quotient marking is replaced. PointRemainingRefinement connects these
facts to the original full catalogue.

Excluding this remaining model, the general normalizer containments and
quasisimple strict enlargement remain with qt-d-1251-local; final exterior
assembly belongs to qt-d-1251-source.
Source: Aschbacher--Smith 12.5.3, printed pp.817--818, and A.3.18, pp.51--52.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped MatrixGroups
namespace CFSG.Quasithin.Chapter12.Section05.NaturalSource
open Section02 Chapter1.Section02.LocalModels
universe u
variable {G : Type u} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  {D : ChosenModule T L V}
namespace SylowExteriorMarking
variable (s : SylowExteriorMarking D)

/-- In the central A₇ row every original point-normalizer cubic lies in K₁. -/
theorem cubic_mem_point_component_of_seven_cover
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L) {K : Subgroup G}
    (hK : K ∈ Chapter1.cComponentsIn (s.marking.Gi 1))
    (hN : (K.subgroupOf (s.marking.Gi 1)).Normal)
    (hm : IsAlternatingCover (K ⧸ pCore 2 K) 7)
    {x : G} (hx : x ∈ s.marking.Gi 1) (h3 : orderOf x = 3) : x ∈ K := by
  let H := s.marking.Gi 1
  let C := K.subgroupOf H
  let a := subgroupOfEquivOfLe hK.1
  let e := QuotientGroup.congr _ _ a (pCore_map_iso 2 a)
  let : IsQuasisimple (K ⧸ pCore 2 K) := hm.1
  let : IsQuasisimple (C ⧸ pCore 2 C) := IsQuasisimple.of_mulEquiv e.symm
  let : C.Normal := hN
  obtain ⟨b⟩ := hm.2.2
  have he : (center (C ⧸ pCore 2 C)).map e.toMonoidHom = center (K ⧸ pCore 2 K) := by
    ext x
    constructor
    · rintro ⟨y,hy,rfl⟩
      exact (centerCongr e ⟨y,hy⟩).property
    · intro hx
      exact ⟨e.symm x,(centerCongr e.symm ⟨x,hx⟩).property,e.apply_symm_apply x⟩
  exact SevenCComponentTheta.order_three_mem_of_central_quotient_seven C hK.2
    ((QuotientGroup.congr _ _ e he).trans b)
    ((h.simpleQTKE.twoLocal_sqtk (s.marking.Gi_twoLocal 1 (.inl rfl))).stronglyQuasithin
      3 Nat.prime_three (by decide))
    ((H.orderOf_coe ⟨x,hx⟩).symm.trans h3)

/-- The central A₇ cover contains the actual first-node residual, without a new model premise. -/
theorem Y_le_point_component_of_seven_cover
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L) {K : Subgroup G}
    (hK : K ∈ Chapter1.cComponentsIn (s.marking.Gi 1))
    (hN : (K.subgroupOf (s.marking.Gi 1)).Normal)
    (hm : IsAlternatingCover (K ⧸ pCore 2 K) 7) : s.Y ≤ K := by
  have h9 : ¬9 ∣ Nat.card s.P := by
    obtain ⟨e⟩ := SLTwoPermThree.sl2Two_equiv_perm_three
    have hc := SymmetricThreeTwoCore.card_eq (s.PCoreEquiv.trans e)
    obtain ⟨n,hn⟩ := (pCore_isPGroup (p := 2) (G := s.P)).exists_card_eq
    intro hd
    rw [hc,hn] at hd
    have hh := ((by decide : Nat.Coprime 9 2).pow_right n).dvd_of_dvd_mul_right hd
    norm_num at hh
  rw [s.Y_eq_primeToThree, map_le_iff_le_comap, primeToResidual_eq_closure_prime_power]
  apply (closure_le _).mpr
  rintro x ⟨n,hn⟩
  obtain ⟨k,_,hk⟩ := (Nat.dvd_prime_pow Nat.prime_three).mp (orderOf_dvd_of_pow_eq_one hn)
  have hk1 : k ≤ 1 := by
    by_contra hh
    exact h9 ((pow_dvd_pow 3 (by omega : 2 ≤ k)).trans (hk ▸ _root_.orderOf_dvd_natCard x))
  interval_cases k
  · have hx : x = 1 := orderOf_eq_one_iff.mp (by simpa using hk)
    exact hx ▸ one_mem _
  · exact s.cubic_mem_point_component_of_seven_cover h hK hN hm
      ((s.P_le_M₁.trans inf_le_right) x.property)
      ((s.P.orderOf_coe x).trans (by simpa using hk))

/-- The original parabolic intersection has its full Sylow and index 63 also in the triple cover. -/
theorem pointComponentParabolic_sylow_index_of_seven_cover
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L) {K : Subgroup G}
    (hK : K ∈ Chapter1.cComponentsIn (s.marking.Gi 1)) (hLK : s.marking.Li 1 ≤ K)
    (hN : (K.subgroupOf (s.marking.Gi 1)).Normal)
    (hm : IsAlternatingCover (K ⧸ pCore 2 K) 7) :
    ∃ S : Sylow 2 (s.pointCoreImage K), (S : Subgroup _) ≤ s.pointComponentParabolic K ∧
      (S : Subgroup _).relIndex (s.pointComponentParabolic K) = 63 :=
  s.pointComponentParabolic_sylow_index hK.1 hN hLK
    (s.Y_le_point_component_of_seven_cover h hK hN hm)

/-- The same literal parabolic has order 504 and index 15 in the central A₇ cover. -/
theorem pointComponentParabolic_card_index_of_seven_cover
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L) {K : Subgroup G}
    (hK : K ∈ Chapter1.cComponentsIn (s.marking.Gi 1)) (hLK : s.marking.Li 1 ≤ K)
    (hN : (K.subgroupOf (s.marking.Gi 1)).Normal)
    (hm : IsAlternatingCover (K ⧸ pCore 2 K) 7) :
    Nat.card (s.pointComponentParabolic K) = 504 ∧ (s.pointComponentParabolic K).index = 15 := by
  let C := s.pointCoreImage K
  let e := s.pointComponentCoreEquivImage hK.1 hN
  obtain ⟨a⟩ := hm.2.1
  obtain ⟨b⟩ := hm.2.2
  have hz : Nat.card (center (K ⧸ pCore 2 K)) = 3 := by simpa using Nat.card_congr a.toEquiv
  have hc : Nat.card C = 7560 := by
    rw [←Nat.card_congr e.toEquiv,card_eq_card_quotient_mul_card_subgroup (center (K ⧸ pCore 2 K)),
      Nat.card_congr b.toEquiv,hz,nat_card_alternatingGroup]
    norm_num [Nat.factorial]
  obtain ⟨S,hSJ,hi⟩ := s.pointComponentParabolic_sylow_index_of_seven_cover h hK hLK hN hm
  have hs : (S : Subgroup C).index = 945 := by
    have hh := (S : Subgroup C).index_mul_card
    rw [S.card_eq_multiplicity,hc,show (Nat.factorization 7560) 2 = 3 from by decide +kernel] at hh
    omega
  have hj : (s.pointComponentParabolic K).index = 15 := by
    have hh := relIndex_mul_index hSJ
    rw [hi,hs] at hh
    omega
  refine ⟨?_,hj⟩
  have hh := (s.pointComponentParabolic K).card_mul_index
  rw [hj,hc] at hh
  omega

end SylowExteriorMarking
end CFSG.Quasithin.Chapter12.Section05.NaturalSource
