module

public import CFSG.Quasithin.Chapter12.Section08.Actions
public import Theory.GroupTheory.ConjugateSpanSylow
public import Theory.GroupTheory.LocalNormalizerUniqueness
public import Theory.Representation.ElementaryPerfectSplit
public import Theory.SpecificGroups.BinaryLinear.OuterCyclic.Model

/-!
# The literal orbit span and its marked quotient action

The image of U_J = ⟨V^J⟩ in G₁/V₁ is generated by the orbit of the
actual image of V, both as a group and as a binary vector space. If L₁
is normal in J, its characteristic two-core fixes all conjugates whenever
it fixes the seed. A faithful natural marking of the seed therefore gives
exactly O₂(L₁) as the kernel on Ũ_J, and constructs the action of the
literal quotient L₁/O₂(L₁).

`NaturalSeedMarking` specifies the earlier natural-action input with an
actual quotient equivalence and a pointwise intertwining equation. Its
actor is GL_(n-1)(2)′, retaining the cyclic-three convention when n=3.
It assumes neither homogeneity nor equivalence of conjugate seed modules.
The latter is the remaining Sylow/model step of the homogeneity argument.

Source: Aschbacher–Smith, combined manuscript of 1 March 2004,
Notation 12.8.2 and Lemma 12.8.5(1), printed pp.849–850 (PDF pp.866–867).
The elementary quotient is an explicit earlier-source input. Constructing
the seed marking from the ambient natural action and proving seed rigidity
remain separate obligations for the source homogeneity assembly.
-/

@[expose] public section

open Subgroup
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter12.Section08.InvariantFlag
variable {G : Type*} [Group G] {T : Sylow 2 G} {V : Subgroup G} {n : ℕ}
variable (F : InvariantFlag T V n)

/-- The image of the actual local span is the conjugate span of the actual images. -/
theorem tilde_UH_eq_span [IsMulCommutative V] (J : Subgroup G) (hJH : J ≤ F.H) :
    F.tilde (F.UH J) = conjugateSpanBy (F.tilde V) (F.tilde J) := by
  have hVH : V ≤ F.H := (le_conjugateSpanBy V F.H).trans F.U_le_H
  have hsub : (F.UH J).subgroupOf F.H =
      conjugateSpanBy (V.subgroupOf F.H) (J.subgroupOf F.H) := by
    apply Subgroup.map_injective F.H.subtype_injective
    rw [map_subgroupOf_eq_of_le (F.UH_le_H J hJH), map_conjugateSpanBy,
      map_subgroupOf_eq_of_le hVH, map_subgroupOf_eq_of_le hJH]
    rfl
  change ((F.UH J).subgroupOf F.H).map F.tildeProjection = _
  rw [hsub, map_conjugateSpanBy]
  rfl

/-- The literal seed inside every local quotient span. -/
def localSeedInclusion (J : Subgroup G)
    [IsElementaryAbelian 2 (F.tilde V)] [IsElementaryAbelian 2 (F.tilde (F.UH J))] :
    Additive (F.tilde V) →ₗ[ZMod 2] Additive (F.tilde (F.UH J)) :=
  (inclusion (map_mono (show V.subgroupOf F.H ≤ (F.UH J).subgroupOf F.H from
    fun _ hx => le_conjugateSpanBy V J hx))).toAdditive.toZModLinearMap 2

theorem localSeedInclusion_injective (J : Subgroup G)
    [IsElementaryAbelian 2 (F.tilde V)] [IsElementaryAbelian 2 (F.tilde (F.UH J))] :
    Function.Injective (F.localSeedInclusion J) := by
  intro a b h
  apply Additive.toMul.injective
  apply Subtype.ext
  exact congrArg (fun u : Additive (F.tilde (F.UH J)) => (u.toMul : F.G₁tilde)) h

/-- The binary representation of the actual local overgroup on its quotient span. -/
noncomputable def localSpanRepresentation (J : Subgroup G) (hJH : J ≤ F.H)
    [IsElementaryAbelian 2 (F.tilde (F.UH J))] :
    Representation (ZMod 2) J (Additive (F.tilde (F.UH J))) :=
  Representation.elementaryRepresentation (F.localTildeAction J hJH)

/-- The seed representation of the actual two-residual L₁. -/
noncomputable def localSeedRepresentation (L : Subgroup G)
    (hLV : L ≤ normalizer (V : Set G)) [IsElementaryAbelian 2 (F.tilde V)] :
    Representation (ZMod 2) (F.Li L 1) (Additive (F.tilde V)) :=
  Representation.elementaryRepresentation (F.tildeAction (F.Li L 1) V
    ((F.Li_le L 1).trans inf_le_right) ((F.Li_le L 1).trans (inf_le_left.trans hLV)))

theorem localSeedInclusion_equivariant (L J : Subgroup G)
    (hLV : L ≤ normalizer (V : Set G)) (hJH : J ≤ F.H) (hKJ : F.Li L 1 ≤ J)
    [IsElementaryAbelian 2 (F.tilde V)] [IsElementaryAbelian 2 (F.tilde (F.UH J))]
    (k : F.Li L 1) (v : Additive (F.tilde V)) :
    F.localSeedInclusion J (F.localSeedRepresentation L hLV k v) =
      F.localSpanRepresentation J hJH (inclusion hKJ k) (F.localSeedInclusion J v) := by
  apply Additive.toMul.injective
  apply Subtype.ext
  rfl

/-- The literal quotient span is linearly generated by the orbit of its seed. -/
theorem localSeed_orbit_span [IsMulCommutative V] (J : Subgroup G) (hJH : J ≤ F.H)
    [IsElementaryAbelian 2 (F.tilde V)] [IsElementaryAbelian 2 (F.tilde (F.UH J))] :
    Submodule.span (ZMod 2) {u | ∃ j v,
      F.localSpanRepresentation J hJH j (F.localSeedInclusion J v) = u} = ⊤ := by
  let S := Submodule.span (ZMod 2) {u | ∃ j v,
    F.localSpanRepresentation J hJH j (F.localSeedInclusion J v) = u}
  let P : Subgroup (F.tilde (F.UH J)) := S.toAddSubgroup.toSubgroup'
  have hspan : conjugateSpanBy (F.tilde V) (F.tilde J) ≤
      P.map (F.tilde (F.UH J)).subtype := by
    apply (closure_le _).mpr
    rintro _ ⟨a, ha, v, hv, rfl⟩
    obtain ⟨j, hj⟩ := F.tildeMap_surjective J hJH ⟨a, ha⟩
    let w := F.localSpanRepresentation J hJH j
      (F.localSeedInclusion J (Additive.ofMul ⟨v, hv⟩))
    refine mem_map.mpr ⟨w.toMul, ?_, ?_⟩
    · change w ∈ S
      exact Submodule.subset_span ⟨j, Additive.ofMul ⟨v, hv⟩, rfl⟩
    · change F.tildeProjection ⟨j, hJH j.property⟩ * v *
        (F.tildeProjection ⟨j, hJH j.property⟩)⁻¹ = _
      have he := congrArg Subtype.val hj
      change F.tildeProjection ⟨j, hJH j.property⟩ = a at he
      rw [he]
  apply top_unique
  intro u _
  have hu : (u.toMul : F.G₁tilde) ∈ conjugateSpanBy (F.tilde V) (F.tilde J) :=
    F.tilde_UH_eq_span J hJH ▸ u.toMul.property
  obtain ⟨w, hw, he⟩ := hspan hu
  have he' : w = u.toMul := Subtype.ext he
  change Additive.ofMul w ∈ S at hw
  simpa only [he', ofMul_toMul, S] using hw

/-- A normalized subgroup fixing the seed modulo V₁ fixes its whole local span. -/
theorem tilde_core_centralizes_span [IsMulCommutative V] (L J : Subgroup G)
    (hJH : J ≤ F.H) (hJK : J ≤ normalizer (F.Li L 1 : Set G))
    (hseed : F.tilde ((F.Li L 1).pCoreIn 2) ≤ centralizer (F.tilde V : Set F.G₁tilde)) :
    F.tilde ((F.Li L 1).pCoreIn 2) ≤ centralizer (F.tilde (F.UH J) : Set F.G₁tilde) := by
  rw [F.tilde_UH_eq_span J hJH]
  apply le_centralizer_conjugateSpanBy_of_normalizes _ _ _ _ hseed
  exact F.tilde_normalizes J _
    (hJK.trans (normalizer_le_normalizer_characteristic_image (F.Li L 1) (pCore 2 (F.Li L 1))))

/-- Conjugation by the local overgroup on its normal L₁, in the left-action convention. -/
def localConjugation (L J : Subgroup G) (hJK : J ≤ normalizer (F.Li L 1 : Set G)) :
    J →* MulAut (F.Li L 1) :=
  (F.Li L 1).normalizerMonoidHom.comp
    (J.subtype.codRestrict _ (fun j => hJK j.property))

@[simp] theorem localConjugation_apply (L J : Subgroup G)
    (hJK : J ≤ normalizer (F.Li L 1 : Set G)) (j : J) (k : F.Li L 1) :
    (F.localConjugation L J hJK j k : G) = (j : G) * k * (j : G)⁻¹ := rfl

/-- The actual ambient natural-action marking from 12.8.1. This specifies
L/O₂(L) on V; it does not assume the induced marking on V/V₁. -/
structure AmbientNaturalMarking (L : Subgroup G)
    (hLV : L ≤ normalizer (V : Set G)) (d : ℕ) [IsElementaryAbelian 2 V] where
  quotientEquiv : (L ⧸ pCore 2 L) ≃* BinaryLinear.OuterCyclic.LinearGroup d
  coordinates : Additive V ≃ₗ[ZMod 2] (Fin d → ZMod 2)
  equivariant : ∀ (l : L) (v : Additive V),
    coordinates (Additive.ofMul ⟨(l : G) * v.toMul * (l : G)⁻¹,
      (mem_normalizer_iff.mp (hLV l.property) v.toMul).mp v.toMul.property⟩) =
        quotientEquiv (QuotientGroup.mk' (pCore 2 L) l) (coordinates v)

/-- The source marking uses the derived linear group, including C₃ in dimension two. -/
structure NaturalSeedMarking (L : Subgroup G)
    (hLV : L ≤ normalizer (V : Set G)) [IsElementaryAbelian 2 (F.tilde V)] where
  quotientEquiv : (F.Li L 1 ⧸ pCore 2 (F.Li L 1)) ≃*
    commutator (BinaryLinear.OuterCyclic.LinearGroup (n - 1))
  coordinates : Additive (F.tilde V) ≃ₗ[ZMod 2] (Fin (n - 1) → ZMod 2)
  equivariant : ∀ k v, coordinates (F.localSeedRepresentation L hLV k v) =
    (quotientEquiv (QuotientGroup.mk' (pCore 2 (F.Li L 1)) k)).val (coordinates v)


namespace NaturalSeedMarking
variable {F} {L : Subgroup G} {hLV : L ≤ normalizer (V : Set G)}
variable [IsElementaryAbelian 2 (F.tilde V)]
variable (D : F.NaturalSeedMarking L hLV)
include D

/-- The marked natural action has exactly the intrinsic two-core as kernel. -/
theorem seedAction_ker :
    (F.tildeAction (F.Li L 1) V ((F.Li_le L 1).trans inf_le_right)
      ((F.Li_le L 1).trans (inf_le_left.trans hLV))).ker = pCore 2 (F.Li L 1) := by
  ext k
  rw [MonoidHom.mem_ker]
  constructor
  · intro hk
    have he : D.quotientEquiv (QuotientGroup.mk' (pCore 2 (F.Li L 1)) k) = 1 := by
      apply Subtype.ext
      apply LinearEquiv.ext
      intro v
      obtain ⟨v, rfl⟩ := D.coordinates.surjective v
      have h := D.equivariant k v
      change D.coordinates (Additive.ofMul (F.tildeAction _ _ _ _ k v.toMul)) = _ at h
      rw [hk] at h
      exact h.symm
    have he' : QuotientGroup.mk' (pCore 2 (F.Li L 1)) k = 1 :=
      D.quotientEquiv.injective (he.trans D.quotientEquiv.map_one.symm)
    exact (QuotientGroup.eq_one_iff k).mp he'
  · intro hk
    have he : QuotientGroup.mk' (pCore 2 (F.Li L 1)) k = 1 :=
      (QuotientGroup.eq_one_iff k).mpr hk
    apply MulEquiv.ext
    intro v
    apply Additive.ofMul.injective
    apply D.coordinates.injective
    have h := D.equivariant k (Additive.ofMul v)
    rw [he, map_one] at h
    exact h

/-- The embedded two-core centralizes the literal image of the seed. -/
theorem tilde_core_centralizes_seed :
    F.tilde ((F.Li L 1).pCoreIn 2) ≤ centralizer (F.tilde V : Set F.G₁tilde) := by
  rintro q ⟨a, ha, rfl⟩
  obtain ⟨k, hk, he⟩ := ha
  have hker : k ∈ (F.tildeAction (F.Li L 1) V ((F.Li_le L 1).trans inf_le_right)
      ((F.Li_le L 1).trans (inf_le_left.trans hLV))).ker := by
    rw [D.seedAction_ker]
    exact hk
  rw [F.tildeAction_ker] at hker
  have he' : (⟨k, (F.Li_le L 1 k.property).2⟩ : F.H) = a := Subtype.ext he
  change F.tildeProjection ⟨k, (F.Li_le L 1 k.property).2⟩ ∈
    centralizer (F.tilde V : Set F.G₁tilde) at hker
  rw [he'] at hker
  exact hker

/-- Normality in the actual local overgroup extends the marked seed kernel
exactly to the action on its full conjugate span. -/
theorem localAction_ker [IsMulCommutative V] (J : Subgroup G) (hJH : J ≤ F.H)
    (hKJ : F.Li L 1 ≤ J) (hJK : J ≤ normalizer (F.Li L 1 : Set G)) :
    ((F.localTildeAction J hJH).comp (inclusion hKJ)).ker = pCore 2 (F.Li L 1) := by
  apply le_antisymm
  · intro k hk
    rw [← D.seedAction_ker, MonoidHom.mem_ker]
    rw [MonoidHom.mem_ker] at hk
    ext v
    have hv : (v : F.G₁tilde) ∈ F.tilde (F.UH J) :=
      map_mono (show V.subgroupOf F.H ≤ (F.UH J).subgroupOf F.H from
        fun _ hx => le_conjugateSpanBy V J hx) v.property
    have he := congrArg (fun e : MulAut (F.tilde (F.UH J)) => (e ⟨v, hv⟩ : F.G₁tilde)) hk
    exact he
  · intro k hk
    have hc := F.tilde_core_centralizes_span L J hJH hJK D.tilde_core_centralizes_seed
    have hq : F.tildeProjection ⟨k, (F.Li_le L 1 k.property).2⟩ ∈
        F.tilde ((F.Li L 1).pCoreIn 2) :=
      mem_map.mpr ⟨⟨k, (F.Li_le L 1 k.property).2⟩, mem_map.mpr ⟨k, hk, rfl⟩, rfl⟩
    rw [MonoidHom.mem_ker]
    ext u
    change F.tildeProjection ⟨k, hJH (hKJ k.property)⟩ * u *
      (F.tildeProjection ⟨k, hJH (hKJ k.property)⟩)⁻¹ = u
    exact mul_inv_eq_iff_eq_mul.mpr (hc hq u u.property).symm

/-- The local span action genuinely factors through L₁/O₂(L₁). -/
noncomputable def quotientSpanAction [IsMulCommutative V] (J : Subgroup G) (hJH : J ≤ F.H)
    (hKJ : F.Li L 1 ≤ J) (hJK : J ≤ normalizer (F.Li L 1 : Set G)) :
    (F.Li L 1 ⧸ pCore 2 (F.Li L 1)) →* MulAut (F.tilde (F.UH J)) :=
  QuotientGroup.lift (pCore 2 (F.Li L 1))
    ((F.localTildeAction J hJH).comp (inclusion hKJ))
    (le_of_eq (D.localAction_ker J hJH hKJ hJK).symm)

@[simp] theorem quotientSpanAction_mk [IsMulCommutative V] (J : Subgroup G) (hJH : J ≤ F.H)
    (hKJ : F.Li L 1 ≤ J) (hJK : J ≤ normalizer (F.Li L 1 : Set G)) (k : F.Li L 1) :
    D.quotientSpanAction J hJH hKJ hJK (QuotientGroup.mk' (pCore 2 (F.Li L 1)) k) =
      F.localTildeAction J hJH (inclusion hKJ k) := rfl

/-- Transport of the quotient action to the marked derived linear group. -/
noncomputable def modelSpanAction [IsMulCommutative V] (J : Subgroup G) (hJH : J ≤ F.H)
    (hKJ : F.Li L 1 ≤ J) (hJK : J ≤ normalizer (F.Li L 1 : Set G)) :
    commutator (BinaryLinear.OuterCyclic.LinearGroup (n - 1)) →*
      MulAut (F.tilde (F.UH J)) :=
  (D.quotientSpanAction J hJH hKJ hJK).comp D.quotientEquiv.symm.toMonoidHom

@[simp] theorem modelSpanAction_quotientEquiv [IsMulCommutative V]
    (J : Subgroup G) (hJH : J ≤ F.H) (hKJ : F.Li L 1 ≤ J)
    (hJK : J ≤ normalizer (F.Li L 1 : Set G)) (k : F.Li L 1) :
    D.modelSpanAction J hJH hKJ hJK
      (D.quotientEquiv (QuotientGroup.mk' (pCore 2 (F.Li L 1)) k)) =
        F.localTildeAction J hJH (inclusion hKJ k) := by
  simp only [modelSpanAction, MonoidHom.comp_apply, MulEquiv.coe_toMonoidHom,
    MulEquiv.symm_apply_apply, quotientSpanAction_mk]

end NaturalSeedMarking

end CFSG.Quasithin.Chapter12.Section08.InvariantFlag
