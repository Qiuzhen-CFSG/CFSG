module

public import CFSG.Quasithin.Chapter12.Section03.SourceAlternatingSeven.TerminalComponentProperCubics
public import Theory.Representation.BinarySevenCode.WeightFourCubics
public import Theory.Alternating.SevenCoverCubicLifts
public import Theory.GroupTheory.PResidual.OddCubicGeneration
public import Theory.GroupTheory.PrimeOrderLift
public import Theory.GroupTheory.NormalCentralQuotientAction

/-!
# Cubic generation of the original weight-four residual

Odd-order elements of C_L(e) act as cubic permutations on the weight-four
point. Their images in L/O₂(L) have central cubes, and the ordinary and
triple A₇ cover calculations make those cubes trivial. The two-group kernel
preserves odd orders. Thus every odd-order element of O²(C_L(e)) has cube
one, proving generation by its own cubic elements.

The final application puts this literal residual inside the same maximal
overcomponent when the point-centralizer component equals it. It discharges
the generation premise of TerminalComponentProperCubics without excluding
the triple cover or changing the original point action.

Source: Aschbacher--Smith, Notation 12.2.5, 12.2.8 and 12.3.12,
printed pp.796, 798 and 811.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter12.Section03.SourceAlternatingSeven
open Section02 BinarySevenCode
universe u
variable {G : Type u} [Group G] [Finite G]
variable {T : Sylow 2 G} {L V : Subgroup G}
variable {S : Setup T L V} {D : S.LocalAnalysis}
namespace TerminalPoint
variable (P : TerminalPoint S D)

/-- Odd-order elements of the original weight-four centralizer have cube one. -/
theorem pointCentralizer_odd_cube (x : (L ⊓ P.pointCentralizer : Subgroup G))
    (hx : Odd (orderOf x)) : x ^ 3 = 1 := by
  let l : L := ⟨x,x.property.1⟩
  let q := QuotientGroup.mk' (pCore 2 L)
  let e : ((L ⧸ pCore 2 L) ⧸ center (L ⧸ pCore 2 L)) ≃* alternatingGroup (Fin 7) :=
    (centralPreimageQuotientEquiv (pCore 2 L)).symm.trans S.quotient
  have horder : orderOf l = orderOf x :=
    (L.orderOf_coe l).symm.trans ((L ⊓ P.pointCentralizer).orderOf_coe x)
  have hfix : evenRepresentation (S.projection l).val (D.model.coordinates P.point).toAdd =
      (D.model.coordinates P.point).toAdd := by
    have hc : V.normalizerMonoidHom ⟨l,S.chosen.normalizes l.property⟩ P.point = P.point := by
      apply Subtype.ext
      exact mul_inv_eq_iff_eq_mul.mpr (mem_centralizer_singleton_iff.mp x.property.2)
    have hh := D.model.equivariant ⟨l,S.chosen.normalizes l.property⟩ P.point
    rw [D.component_action, hc] at hh
    exact hh.symm
  have ha3 := weight_four_stabilizer_odd_cube (D.model.coordinates P.point).toAdd
    P.weight_four (S.projection l).val hfix
    ((horder.symm ▸ hx).of_dvd_nat (orderOf_map_dvd
      ((alternatingGroup (Fin 7)).subtype.comp S.projection) l))
  have hz3 : (q l) ^ 3 ∈ center (L ⧸ pCore 2 L) := by
    rw [← map_pow]
    change l ^ 3 ∈ (center (L ⧸ pCore 2 L)).comap q
    apply (QuotientGroup.eq_one_iff _).mp
    apply S.quotient.injective
    change S.projection (l ^ 3) = S.quotient 1
    rw [map_pow,map_one]
    exact Subtype.ext ha3
  let : IsQuasisimple (L ⧸ pCore 2 L) := S.hypothesis.quasisimple
  have hq3 := GLS3.Chapter5.OddCentralCovers.cube_eq_one_of_cube_mem_center
    (pCore_quotient_pCore_eq_bot (G := L) 2) e (q l) hz3
  have ho : orderOf (q l) = orderOf x :=
    (q.orderOf_map_eq_of_coprime_of_isPGroup_ker
      (by rw [QuotientGroup.ker_mk']; exact pCore_isPGroup) l
      (Nat.coprime_two_left.mpr (horder.symm ▸ hx))).trans horder
  exact orderOf_dvd_iff_pow_eq_one.mp (ho ▸ orderOf_dvd_of_pow_eq_one hq3)

/-- The literal O²(C_L(e)) is generated by its own cubic elements. -/
theorem Le_cubic_generated :
    closure {x : G | x ∈ P.Le ∧ orderOf x = 3} = P.Le := by
  have hp : IsPPerfect 2 P.Le :=
    isPPerfect_embedded_pResidual_of_finite 2 (L ⊓ P.pointCentralizer)
  have hc (x : P.Le) (hx : Odd (orderOf x)) : x ^ 3 = 1 := by
    have hle : P.Le ≤ L ⊓ P.pointCentralizer := map_subtype_le _
    let y : (L ⊓ P.pointCentralizer : Subgroup G) := ⟨x,hle x.property⟩
    have ho : orderOf y = orderOf x :=
      ((L ⊓ P.pointCentralizer).orderOf_coe y).symm.trans (P.Le.orderOf_coe x)
    exact Subtype.ext (congrArg (fun z : (L ⊓ P.pointCentralizer : Subgroup G) => (z : G)) (P.pointCentralizer_odd_cube y (ho.symm ▸ hx)))
  have he := congrArg (map P.Le.subtype)
    (cubic_closure_eq_top_of_twoPerfect_of_odd_cube hp hc)
  rw [MonoidHom.map_closure, ← MonoidHom.range_eq_map, range_subtype] at he
  have hs : P.Le.subtype '' {x : P.Le | orderOf x = 3} =
      {x : G | x ∈ P.Le ∧ orderOf x = 3} := by
    ext x
    constructor
    · rintro ⟨y,hy,rfl⟩
      exact ⟨y.property,(P.Le.orderOf_coe y).trans hy⟩
    · rintro ⟨hx,h3⟩
      exact ⟨⟨x,hx⟩,(P.Le.orderOf_coe ⟨x,hx⟩).symm.trans h3,rfl⟩
  rwa [hs] at he

variable {P}

/-- The original cubic generators discharge the 12.2.8 containment. -/
theorem Overcomponents.Le_le_of_eq_maximal (F : P.Overcomponents)
    {W : Subgroup G} (SY : Setup T F.Y W) (hEY : F.E = F.Y) : P.Le ≤ F.Y :=
  F.Le_le_of_eq_maximal_of_cubic_generation SY hEY P.Le_cubic_generated.ge

end TerminalPoint
end CFSG.Quasithin.Chapter12.Section03.SourceAlternatingSeven
