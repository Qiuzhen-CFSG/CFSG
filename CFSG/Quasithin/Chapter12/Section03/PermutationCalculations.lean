module

public import Theory.Representation.BinarySevenCode.PermutationAction
public import CFSG.Quasithin.ChapterB.Section03.Offenders.Odd

/-!
# Permutation calculations for eliminating A₇

The literal even-word action, its natural-module comparison, and the standard
fixed-vector and commutator calculations are re-exported here. The two
commutator obstructions in 12.3.10 are applied both in the even-word model and
in the quotient model used by the binary permutation API.

The proved B.3.2 classification supplies the other finite-module input to
12.3.7: a best offender is generated by transpositions, has rank equal to
fixed codimension, and forces any overgroup containing A₇ to equal S₇.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
1 March 2004 manuscript, §12.3, printed pp. 808–811.
Orbit transitivity, stabilizer isomorphisms, and the exhaustive elementary
subgroup classification still require their separate geometric proofs;
the ambient-group identifications belong to the §12.3 assembly.
-/

public section

namespace CFSG.Quasithin.Chapter12.Section03
open BinarySevenCode Representation.BinaryOffender
open CFSG.Quasithin.ChapterB.Offenders

theorem natural_bestOffender_contains_transposition
    (A : Subgroup (Equiv.Perm (Fin 7)))
    (hA : IsBestOffender (BinaryPermutation.naturalRepresentation (Fin 7)) A) :
    ∃ a ∈ A, a.IsSwap := by
  obtain ⟨m, hm, _, g, rfl⟩ :=
    (Odd.isBestOffender_natural_iff_caseAFamily (Or.inr rfl) A).mp hA
  refine ⟨(MulAut.conj g) (pairSwap 7 0),
    Subgroup.mem_map_of_mem _ (pairSwap_mem 0 (by change 0 < m; omega)), ?_⟩
  refine ⟨g 0, g 1, g.injective.ne (by decide), ?_⟩
  exact Equiv.symm_trans_swap_trans (0 : Fin 7) 1 g

theorem natural_bestOffender_not_le_alternating
    (A : Subgroup (Equiv.Perm (Fin 7)))
    (hA : IsBestOffender (BinaryPermutation.naturalRepresentation (Fin 7)) A) :
    ¬ A ≤ alternatingGroup (Fin 7) := by
  obtain ⟨a, ha, hs⟩ := natural_bestOffender_contains_transposition A hA
  intro h
  have he := (Equiv.Perm.mem_alternatingGroup.mp (h ha)).symm.trans hs.sign_eq
  exact (by decide : (1 : ℤˣ) ≠ -1) he

theorem overgroup_eq_symmetric_of_natural_bestOffender
    (H A : Subgroup (Equiv.Perm (Fin 7)))
    (hH : alternatingGroup (Fin 7) ≤ H) (hAH : A ≤ H)
    (hA : IsBestOffender (BinaryPermutation.naturalRepresentation (Fin 7)) A) : H = ⊤ := by
  obtain ⟨a, ha, hs⟩ := natural_bestOffender_contains_transposition A hA
  apply top_unique
  intro g _
  by_cases hg : g ∈ alternatingGroup (Fin 7)
  · exact hH hg
  · have ha' : a ∉ alternatingGroup (Fin 7) := by
      intro h
      have he := (Equiv.Perm.mem_alternatingGroup.mp h).symm.trans hs.sign_eq
      exact (by decide : (1 : ℤˣ) ≠ -1) he
    have hag : a * g ∈ alternatingGroup (Fin 7) := by
      rw [Subgroup.mul_mem_iff_of_index_two alternatingGroup.index_eq_two]
      exact iff_of_false ha' hg
    have hm := H.mul_mem (H.inv_mem (hAH ha)) (hH hag)
    simpa only [inv_mul_cancel_left] using hm

/-- Equality of offender rank and fixed codimension used in 12.3.7. -/
theorem natural_bestOffender_fixedCodim_eq_rank
    (A : Subgroup (Equiv.Perm (Fin 7)))
    (hA : IsBestOffender (BinaryPermutation.naturalRepresentation (Fin 7)) A) :
    fixedCodim (BinaryPermutation.naturalRepresentation (Fin 7)) A = rank A := by
  rw [BinaryPermutation.fixedCodim_natural_eq_full_odd (Fin 7) (by decide)]
  exact (Odd.elementary_and_fixedCodim_full_eq_rank_of_caseAFamily (Or.inr rfl)
    ((Odd.isBestOffender_natural_iff_caseAFamily (Or.inr rfl) A).mp hA)).2

/-- The degree-seven best offenders are generated by their transpositions. -/
theorem natural_bestOffender_generated_by_transpositions
    (A : Subgroup (Equiv.Perm (Fin 7)))
    (hA : IsBestOffender (BinaryPermutation.naturalRepresentation (Fin 7)) A) :
    Subgroup.closure {a | a ∈ A ∧ a.IsSwap} = A := by
  apply le_antisymm ((Subgroup.closure_le _).mpr (fun _ ha => ha.1))
  obtain ⟨m, _, _, g, rfl⟩ :=
    (Odd.isBestOffender_natural_iff_caseAFamily (Or.inr rfl) A).mp hA
  apply Subgroup.map_le_iff_le_comap.mpr
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨i, hi, rfl⟩
  apply Subgroup.subset_closure
  refine ⟨Subgroup.mem_map_of_mem _ (pairSwap_mem i hi), ?_⟩
  let a : Fin 7 := ⟨2 * i.val, by omega⟩
  let b : Fin 7 := ⟨2 * i.val + 1, by omega⟩
  refine ⟨g a, g b, ?_, Equiv.symm_trans_swap_trans a b g⟩
  apply g.injective.ne
  intro h
  have hh := congrArg Fin.val h
  dsimp [a, b] at hh
  omega

/-- The weight-two obstruction in the first representative case of 12.3.10. -/
theorem first_offender_obstruction :
    ∃ v ∈ subspaceCommutator evenRepresentation (fixedSpaceSpan evenRepresentation A1) A1,
      v ≠ 0 ∧ BinarySevenCode.weight v.val ≠ 4 := by
  refine ⟨e2, e2_mem_commutator_fixedSpaceSpan_A1, representative_nonzero.1, ?_⟩
  rw [representative_weights.1]
  decide

/-- The nonzero double commutator in the second representative case of 12.3.10. -/
theorem second_offender_obstruction :
    subspaceCommutator evenRepresentation
      (subspaceCommutator evenRepresentation (fixedSpaceSpan evenRepresentation A2) A2) A2 ≠ ⊥ := by
  intro h
  have hm := e4_mem_double_commutator_fixedSpaceSpan_A2
  rw [h, Submodule.mem_bot] at hm
  exact representative_nonzero.2.1 hm

/-- The first obstruction on the actual natural quotient model. -/
theorem natural_first_offender_obstruction :
    ∃ v ∈ subspaceCommutator (BinaryPermutation.naturalRepresentation (Fin 7))
        (fixedSpaceSpan (BinaryPermutation.naturalRepresentation (Fin 7)) A1) A1,
      v ≠ 0 ∧ BinarySevenCode.weight (evenWordsEquivNatural.symm v).val ≠ 4 := by
  have h := commutator_fixedSpaceSpan_has_weight_two_transport
    (BinaryPermutation.naturalRepresentation (Fin 7)) (MonoidHom.id _) (fun _ _ h => h)
    evenWordsEquivNatural evenWordsEquivNatural_equivariant
  simp only [Subgroup.map_id] at h
  obtain ⟨v, hv, hne, hw⟩ := h
  exact ⟨v, hv, hne, by rw [hw]; decide⟩

/-- The second obstruction on the actual natural quotient model. -/
theorem natural_second_offender_obstruction :
    subspaceCommutator (BinaryPermutation.naturalRepresentation (Fin 7))
      (subspaceCommutator (BinaryPermutation.naturalRepresentation (Fin 7))
        (fixedSpaceSpan (BinaryPermutation.naturalRepresentation (Fin 7)) A2) A2) A2 ≠ ⊥ := by
  simpa only [Subgroup.map_id] using double_commutator_fixedSpaceSpan_ne_bot_transport
    (BinaryPermutation.naturalRepresentation (Fin 7)) (MonoidHom.id _) (fun _ _ h => h)
    evenWordsEquivNatural evenWordsEquivNatural_equivariant

end CFSG.Quasithin.Chapter12.Section03
