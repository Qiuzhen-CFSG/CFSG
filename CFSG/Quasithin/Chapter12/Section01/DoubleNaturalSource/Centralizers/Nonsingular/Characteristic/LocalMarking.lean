module
public import CFSG.Quasithin.Chapter12.Section01.DoubleNaturalSource.Centralizers.Nonsingular.Characteristic.MovingRank
public import Theory.GroupTheory.CentralQuotientLocalMarking
public import Theory.GroupTheory.PCoreFrattiniTransport

/-!
# The original local action in the component central quotient

Project the literal point residual and moving subgroup to K/Z(K). The
kernel on the residual lies in its two-core, since its L_(n-1)(2) quotient
is centerless. The same simple quotient survives, and the nontrivial
moving subgroup stays elementary, normalized and generated by its residual
commutators. These are the original local data used in `BenderExclusion`
and `FiveRankTwo`; neither map is replaced by an abstract family tag.

Source: Aschbacher--Smith, 12.1.1, printed p.788.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter12.Section02.ChosenModule
open Chapter12.Section01.DoubleNaturalSource
open BinaryNaturalDual.ModelOrbits.AutomorphismModel BinaryLinear.OuterCyclic
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}

/-- The point residual and moving subgroup retain their source structure under the canonical central quotient. -/
theorem doubleNatural_adapted_component_local_marking
    (h : Hypothesis1223 KnownSimple.IsKnownSimple T L) (D : ChosenModule T L V)
    {n : ℕ} (B : DoubledBranch T L V n) :
    letI := D.doubledOrbit_elementary h
    ∀ S : B.SourceModel, ∀ w : componentOrbit V (T : Subgroup G), B.AdaptedPoint S w →
      ∀ K : Subgroup G, IsComponentIn K (B.pointCentralizer w) →
        let P := (B.pointResidual w).subgroupOf K
        let U := (⁅componentOrbit V (T : Subgroup G),B.pointResidual w⁆).subgroupOf K
        let q := QuotientGroup.mk' (center K)
        Group.IsPerfect (P.map q) ∧
        Nonempty (((P.map q) ⧸ pCore 2 (P.map q)) ≃*
          Matrix.ProjectiveSpecialLinearGroup (Fin (n-1)) (ZMod 2)) ∧
        U.map q ≠ ⊥ ∧ IsElementaryAbelian 2 (U.map q) ∧
        U.map q = ⁅U.map q,P.map q⁆ ∧
        P.map q ≤ normalizer (U.map q : Set (K ⧸ center K)) := by
  let := D.doubledOrbit_elementary h
  intro S w hw K hK
  let R := B.pointResidual w
  let W := componentOrbit V (T : Subgroup G)
  let P := R.subgroupOf K
  let U := (⁅W,R⁆).subgroupOf K
  let q := QuotientGroup.mk' (center K)
  have hRK : R ≤ K :=
    (D.doubleNatural_adapted_ordinary_component_contains_residual h B S w hw K hK).1
  have hUR : ⁅W,R⁆ ≤ R := D.doubleNatural_moving_le_residual h B w
  have hUK : ⁅W,R⁆ ≤ K := hUR.trans hRK
  have hUW : ⁅W,R⁆ ≤ W :=
    le_normalizer_iff_commutator_le_left.mp (B.pointResidual_normalizes_orbit w)
  have hRM : R ≤ B.localPointCentralizer w :=
    le_inf (B.pointResidual_le_normalizer w) ((B.pointResidual_le w).trans inf_le_right)
  let eR := subgroupOfEquivOfLe hRK
  let eM := subgroupOfEquivOfLe hRM
  let := (S.nonsingular_residual_local_cComponent w hw.nonsingular).perfect
  let : Group.IsPerfect R := Group.IsPerfect.ofSurjective (f := eM.toMonoidHom) eM.surjective
  let : Group.IsPerfect P := Group.IsPerfect.ofSurjective (f := eR.symm.toMonoidHom) eR.symm.surjective
  obtain ⟨e₀⟩ := (S.nonsingular_residual_kernel_and_quotient w hw.nonsingular).2
  let eQ := (QuotientGroup.congr _ _ eR (pCore_map_iso 2 eR)).trans e₀
  have hn : 0 < n - 1 := by have := B.degree; omega
  let e := eQ.trans (projectiveEquivLinear hn)
  have hc : center (P ⧸ pCore 2 P) = ⊥ := by
    apply bot_unique
    intro x hx
    have he : e x ∈ center (LinearGroup (n-1)) := by
      apply mem_center_iff.mpr
      intro y
      obtain ⟨z,rfl⟩ := e.surjective y
      simpa only [map_mul] using congrArg e (mem_center_iff.mp hx z)
    rw [linear_center_eq_bot hn,mem_bot] at he
    exact mem_bot.mpr (e.injective (he.trans e.map_one.symm))
  have hp : IsPGroup 2 (q.subgroupMap P).ker := pCore_isPGroup.to_le
    (CentralQuotientLocalMarking.subgroupMap_ker_le_pCore 2 P hc)
  let eP := ((q.subgroupMap P).pCoreQuotientEquiv (q.subgroupMap_surjective P) hp).symm.trans eQ
  have hne : U ≠ ⊥ := by
    intro he
    have hm := congrArg (map K.subtype) he
    have hb : ⁅W,R⁆ = ⊥ := by
      simpa only [U,map_subgroupOf_eq_of_le hUK,Subgroup.map_bot] using hm
    have hcard := S.nonsingular_moving_card w hw.nonsingular
    change Nat.card (⁅W,R⁆ : Subgroup G) = _ at hcard
    rw [hb,card_bot] at hcard
    have hpos : 0 < 2*(n-1) := by omega
    have hpow : 1 < 2^(2*(n-1)) := one_lt_pow₀ (by decide : 1 < (2 : ℕ)) (by omega)
    omega
  let i : U →* W := (inclusion hUW).comp (subgroupOfEquivOfLe hUK).toMonoidHom
  have he : IsElementaryAbelian 2 U := IsElementaryAbelian.of_injective i
    ((inclusion_injective hUW).comp (subgroupOfEquivOfLe hUK).injective)
  have hm : U = ⁅U,P⁆ := by
    apply map_injective K.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le hUK,map_subgroupOf_eq_of_le hRK]
    exact (commutator_isPPerfect_idempotent R W (B.pointResidual_isPPerfect w)
      (IsElementaryAbelian.isPGroup 2 W) (B.pointResidual_normalizes_orbit w)).symm
  obtain ⟨hperf,hne,hele,hmove,hnorm⟩ := CentralQuotientLocalMarking.moved_image P U hne he hm
  exact ⟨hperf,⟨eP⟩,hne,hele,hmove,hnorm⟩

end CFSG.Quasithin.Chapter12.Section02.ChosenModule
