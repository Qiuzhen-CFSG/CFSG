module

public import CFSG.Quasithin.Chapter12.Section01.DoubleNaturalSource.Centralizers.Pure.Sylows.Four.SourceDistanceFourAction
public import CFSG.Quasithin.Chapter12.Section01.DoubleNaturalSource.Centralizers.Pure.Core.Identification

/-!
# The original natural four-space inside the intrinsic residual core

The whole natural summand is generated by its commutators with the literal
point residual. It is a normal elementary subgroup of that residual, hence
lies in its two-core and then in its intrinsic commutator core. The resulting
embedding retains the original point-stabilizer action on every vector.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative commutatorElement
namespace CFSG.Quasithin.Chapter12.Section01.DoubleNaturalSource.DoubledBranch.SourceModel
open ChapterC BinaryLinear BinaryLinear.OuterCyclic Theory.LinearAlgebra
open BinaryNaturalDual.VectorStabilizers BinaryNaturalDual.VectorStabilizers.Pure
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  {B : DoubledBranch T L V 4}
  [IsElementaryAbelian 2 (componentOrbit V (T : Subgroup G))]
  (S : B.SourceModel)

omit [Finite G] in
private theorem naturalEmbedding_mem (v : Space 4) :
    ((S.setup.naturalEmbedding v).toMul : G) ∈ B.naturalSummand :=
  (B.mem_naturalSummand _).mpr ((S.natural_marking _).mp
    (S.setup.naturalCoordinates.symm v).property)

include S in
theorem distanceFourNatural_le_block
    (hNM : normalizer (componentOrbit V (T : Subgroup G) : Set G) = normalizer (L : Set G))
    (w : componentOrbit V (T : Subgroup G)) (hw : w ≠ 1)
    (hp : (B.coordinates w).toAdd.2 = 0) :
    B.naturalSummand ≤ (blockU (B.pointResidual w)).map (B.pointResidual w).subtype := by
  let A := B.naturalSummand
  let X := B.pointResidual w
  have hAX : A ≤ X := le_sup_left.trans (S.pure_moving_le_residual hNM w hw hp)
  have hcomm : ⁅A, X⁆ = A := (S.pure_residual_commutators hNM w hw hp).1
  have hn : X ≤ normalizer (A : Set G) := le_normalizer_iff_commutator_le_left.mpr hcomm.le
  have hcore : A ≤ X.pCoreIn 2 := le_pCoreIn_of_normalizes
    ((IsElementaryAbelian.isPGroup 2 (componentOrbit V (T : Subgroup G))).to_le B.naturalSummand_le)
    hAX hn
  change A ≤ (⁅pCore 2 X, (⊤ : Subgroup X)⁆).map X.subtype
  rw [map_commutator, ← MonoidHom.range_eq_map, range_subtype, ← hcomm]
  exact commutator_mono hcore le_rfl

def distanceFourNaturalInResidual
    (hNM : normalizer (componentOrbit V (T : Subgroup G) : Set G) = normalizer (L : Set G))
    (w : componentOrbit V (T : Subgroup G)) (hw : w ≠ 1)
    (hp : (B.coordinates w).toAdd.2 = 0) :
    Multiplicative (Space 4) →* B.pointResidual w where
  toFun v := ⟨(S.setup.naturalEmbedding v.toAdd).toMul,
    (le_sup_left.trans (S.pure_moving_le_residual hNM w hw hp))
      ((B.mem_naturalSummand _).mpr ((S.natural_marking _).mp
        (S.setup.naturalCoordinates.symm v.toAdd).property))⟩
  map_one' := by
    apply Subtype.ext
    change ((S.setup.naturalEmbedding 0).toMul : G) = 1
    rw [map_zero]
    rfl
  map_mul' u v := by
    apply Subtype.ext
    change ((S.setup.naturalEmbedding (u.toAdd + v.toAdd)).toMul : G) = _
    rw [map_add]
    rfl

theorem distanceFourNaturalInResidual_injective
    (hNM : normalizer (componentOrbit V (T : Subgroup G) : Set G) = normalizer (L : Set G))
    (w : componentOrbit V (T : Subgroup G)) (hw : w ≠ 1)
    (hp : (B.coordinates w).toAdd.2 = 0) :
    Function.Injective (S.distanceFourNaturalInResidual hNM w hw hp) := by
  intro u v huv
  apply Multiplicative.toAdd.injective
  apply S.setup.naturalCoordinates.symm.injective
  apply Subtype.ext
  apply Additive.toMul.injective
  apply Subtype.ext
  exact congrArg (B.pointResidual w).subtype huv

theorem distanceFourNaturalInResidual_mem_block
    (hNM : normalizer (componentOrbit V (T : Subgroup G) : Set G) = normalizer (L : Set G))
    (w : componentOrbit V (T : Subgroup G)) (hw : w ≠ 1)
    (hp : (B.coordinates w).toAdd.2 = 0) (v : Multiplicative (Space 4)) :
    S.distanceFourNaturalInResidual hNM w hw hp v ∈ blockU (B.pointResidual w) := by
  have hv := S.distanceFourNatural_le_block hNM w hw hp (naturalEmbedding_mem S v.toAdd)
  obtain ⟨a, ha, he⟩ := hv
  have he' : a = S.distanceFourNaturalInResidual hNM w hw hp v := Subtype.ext he
  exact he' ▸ ha

def distanceFourNaturalIntoBlock
    (hNM : normalizer (componentOrbit V (T : Subgroup G) : Set G) = normalizer (L : Set G))
    (w : componentOrbit V (T : Subgroup G)) (hw : w ≠ 1)
    (hp : (B.coordinates w).toAdd.2 = 0) :
    Multiplicative (Space 4) →* blockU (B.pointResidual w) :=
  (S.distanceFourNaturalInResidual hNM w hw hp).codRestrict _
    (S.distanceFourNaturalInResidual_mem_block hNM w hw hp)

theorem distanceFourNaturalIntoBlock_injective
    (hNM : normalizer (componentOrbit V (T : Subgroup G) : Set G) = normalizer (L : Set G))
    (w : componentOrbit V (T : Subgroup G)) (hw : w ≠ 1)
    (hp : (B.coordinates w).toAdd.2 = 0) :
    Function.Injective (S.distanceFourNaturalIntoBlock hNM w hw hp) := by
  intro u v huv
  apply S.distanceFourNaturalInResidual_injective hNM w hw hp
  exact congrArg Subtype.val huv

theorem distanceFourNaturalIntoBlock_equivariant
    (hNM : normalizer (componentOrbit V (T : Subgroup G) : Set G) = normalizer (L : Set G))
    (w : componentOrbit V (T : Subgroup G)) (hw : w ≠ 1)
    (hp : (B.coordinates w).toAdd.2 = 0)
    (l : B.pointResidual w) (v : Space 4) :
    MulAut.conjNormal l (S.distanceFourNaturalIntoBlock hNM w hw hp (Multiplicative.ofAdd v)) =
      S.distanceFourNaturalIntoBlock hNM w hw hp
        (Multiplicative.ofAdd ((S.distanceFourPointAction w hw hp l).val v)) := by
  apply Subtype.ext
  apply Subtype.ext
  have he := S.setup.pure_natural_action
    (⟨Additive.ofMul w, (S.natural_marking w).mpr hp⟩ : S.setup.natural)
    hw (S.distanceFourResidualAction w l) v
  rw [S.representation_eq] at he
  exact congrArg (fun z => (z.toMul : G)) he

end CFSG.Quasithin.Chapter12.Section01.DoubleNaturalSource.DoubledBranch.SourceModel
