module

public import CFSG.Quasithin.Chapter12.Section01.DoubleNaturalSource.Centralizers.Pure.Core.Action
public import Theory.GroupTheory.PCoreCentralQuotientImage

/-!
# Pure-point sections in a self-centralizing two-core

The line displacement calculated from H.9 puts the natural summand into the
core after quotienting by the actual central point line. The fixed dual
hyperplane lies in the center of that core. Self-centralization of the ambient
point core remains the component-exclusion input.

Source: Aschbacher--Smith, 12.1.6, printed p.791.
-/

public section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative

private theorem core_contains_of_central_commutator
    {K : Type*} [Group K] [Finite K] (A Z : Subgroup K) [Z.Normal]
    (hZ : Z ≤ center K)
    (hc : centralizer (pCore 2 K : Set K) ≤ pCore 2 K)
    (hA : ⁅A, pCore 2 K⁆ ≤ Z) : A ≤ pCore 2 K := by
  let q := QuotientGroup.mk' Z
  have hcomm : ⁅A.map q, (pCore 2 K).map q⁆ = ⊥ := by
    rw [← map_commutator]
    exact (Subgroup.map_eq_bot_iff _).mpr (by simpa only [q, QuotientGroup.ker_mk'] using hA)
  have hm : A.map q ≤ (pCore 2 K).map q :=
    (commutator_eq_bot_iff_le_centralizer.mp hcomm).trans
      (centralizer_image_pCore_le_of_central_quotient Z hZ hc)
  have hZQ : Z ≤ pCore 2 K := (hZ.trans (center_le_centralizer _)).trans hc
  have he : ((pCore 2 K).map q).comap q = pCore 2 K := by
    rw [comap_map_eq, QuotientGroup.ker_mk', sup_eq_left.mpr hZQ]
  exact (map_le_iff_le_comap.mp hm).trans_eq he

namespace CFSG.Quasithin.Chapter12.Section01.DoubleNaturalSource.DoubledBranch
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G} {n : ℕ}
  {B : DoubledBranch T L V n}
  [IsElementaryAbelian 2 (componentOrbit V (T : Subgroup G))]
namespace SourceModel
variable (S : B.SourceModel)

omit [Finite G] in
private theorem orbit_le_pointCentralizer
    (w : componentOrbit V (T : Subgroup G)) :
    componentOrbit V (T : Subgroup G) ≤ centralizer ({(w : G)} : Set G) := by
  intro x hx
  apply mem_centralizer_singleton_iff.mpr
  exact congrArg Subtype.val (mul_comm (⟨x,hx⟩ : componentOrbit V (T : Subgroup G)) w)

include S in
/-- Characteristic two and the proved line displacement force the original
natural summand into the full point core. The quotient is by the actual
central subgroup generated by w. -/
theorem pure_natural_le_core_of_characteristicTwo
    (hNM : normalizer (componentOrbit V (T : Subgroup G) : Set G) = normalizer (L : Set G))
    (hs : B.PurePointSylows) (w : componentOrbit V (T : Subgroup G))
    (hw : w ≠ 1) (hp : (B.coordinates w).toAdd.2 = 0)
    (hc : centralizer (pCore 2 (centralizer ({(w : G)} : Set G)) : Set
        (centralizer ({(w : G)} : Set G))) ≤ pCore 2 (centralizer ({(w : G)} : Set G))) :
    B.naturalSummand ≤ B.purePointCore w := by
  let H := centralizer ({(w : G)} : Set G)
  let Z := (zpowers (w : G)).subgroupOf H
  have hAH : B.naturalSummand ≤ H := B.naturalSummand_le.trans (orbit_le_pointCentralizer w)
  have hHZ : H ≤ centralizer (zpowers (w : G) : Set G) := by
    rw [zpowers_eq_closure, centralizer_closure]
  have hZ : Z ≤ center H := by
    intro z hz
    apply mem_center_iff.mpr
    intro a
    exact Subtype.ext (hHZ a.property z hz).symm
  let : Z.Normal := ⟨by
    intro z hz a
    have he := mem_center_iff.mp (hZ hz) a
    simpa only [he, mul_inv_cancel_right] using hz⟩
  have hcomm : ⁅B.naturalSummand.subgroupOf H, pCore 2 H⁆ ≤ Z := by
    intro x hx
    have hm := mem_map_of_mem H.subtype hx
    rw [map_commutator, map_subgroupOf_eq_of_le hAH] at hm
    exact S.purePointCore_natural_commutator hNM hs w hw hp hm
  have hi := core_contains_of_central_commutator (B.naturalSummand.subgroupOf H) Z hZ hc hcomm
  have hm := map_mono (f := H.subtype) hi
  rwa [map_subgroupOf_eq_of_le hAH] at hm

/-- The marked dual hyperplane is central in the literal point core once
its self-centralization has been established by the component argument. -/
theorem pure_dualHyperplane_le_core_of_characteristicTwo
    (hNM : normalizer (componentOrbit V (T : Subgroup G) : Set G) = normalizer (L : Set G))
    (hs : B.PurePointSylows) (w : componentOrbit V (T : Subgroup G))
    (hw : w ≠ 1) (hp : (B.coordinates w).toAdd.2 = 0)
    (hc : centralizer (pCore 2 (centralizer ({(w : G)} : Set G)) : Set
        (centralizer ({(w : G)} : Set G))) ≤ pCore 2 (centralizer ({(w : G)} : Set G))) :
    S.pureDualHyperplane w hp ≤ B.purePointCore w ⊓
      centralizer (B.purePointCore w : Set G) := by
  have hfix := le_centralizer_iff.mp (S.purePointCore_centralizes_dualHyperplane hNM hs w hw hp)
  refine le_inf ?_ hfix
  intro x hx
  have hxH := orbit_le_pointCentralizer w
    (B.dualSummand_le (S.pureDualHyperplane_le_dualSummand w hp hx))
  refine ⟨⟨x,hxH⟩, hc ?_, rfl⟩
  intro q hq
  exact Subtype.ext (hfix hx q (mem_map_of_mem _ hq))

end SourceModel
end CFSG.Quasithin.Chapter12.Section01.DoubleNaturalSource.DoubledBranch
