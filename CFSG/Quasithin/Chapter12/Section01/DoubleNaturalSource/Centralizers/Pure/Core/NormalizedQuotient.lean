module

public import CFSG.Quasithin.Chapter12.Section01.DoubleNaturalSource.Centralizers.Pure.Core.Quotient
public import CFSG.Quasithin.Chapter12.Section01.DoubleNaturalSource.Centralizers.Pure.Sylows.Orders.Pure
public import Theory.SpecificGroups.Rudvalis.Model.SylowOvergroups.TwoLocalOrder
public import Theory.GroupTheory.Commutator.RelativeGeneration
public import Mathlib.GroupTheory.Schreier

/-!
# The original moved image is Sylow-normalized

The moved subgroup U equals the commutator of the doubled orbit with the
pure-point residual, so the original normalizer point centralizer normalizes
U. Intersect the proved ambient point Sylow with the normal component and
pass through its literal two-core quotient. The resulting Sylow normalizes
the original elementary image, whose order is 2^(2n-2).

The native Rudvalis catalogue has six possible normal elementary subgroups,
each generated by at most five involutions. Its bound of 32 contradicts the
source image order, which is at least 64. Core.Complete supplies every local
premise from the original chosen-module hypotheses.

Source: Aschbacher--Smith 12.1.6, printed p.791; the imported Rudvalis
catalogue preserves its native ATLAS words and source attribution.
-/

public section
open Subgroup Theory.GroupTheory
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter12.Section01.DoubleNaturalSource.DoubledBranch.SourceModel
open Rudvalis.SylowOvergroups.RadicalCoverage.LocalCover

private theorem rudvalis_catalogue_card (i : Fin 6) [IsElementaryAbelian 2 (elementary i)] :
    Nat.card (elementary i) ≤ 32 := by
  classical
  let c := elementaryGenerator
  let s : Finset Rudvalis.Model := ![{c 0}, {c 0,c 1}, {c 0,c 1,c 2},
    {c 0,c 1,c 2,c 3}, {c 0,c 1,c 2,c 3,c 4}, {c 0,c 1,c 2,c 3,c 5}] i
  have he : closure (s : Set Rudvalis.Model) = elementary i := by
    fin_cases i <;> simp [s,elementary,c]
  have hsc : s.card ≤ 5 := by
    fin_cases i <;> simp [s,Finset.card_insert_eq_ite] <;> split_ifs <;> omega
  have hr : Group.rank (elementary i) ≤ 5 := by
    rw [←he]
    exact (rank_closure_finset_le_card s).trans hsc
  let : CommGroup (elementary i) := IsMulCommutative.instCommGroup
  have hd := card_dvd_exponent_pow_rank' (elementary i)
    (Monoid.exponent_dvd_iff_forall_pow_eq_one.mp (IsElementaryAbelian.exponent_dvd_p 2 (elementary i)))
  exact (Nat.le_of_dvd (pow_pos (by decide) _) hd).trans
    (Nat.pow_le_pow_right (by decide : 1 ≤ 2) hr)

/-- A Sylow-normalized elementary subgroup of Rudvalis has order at most 32. -/
private theorem pure_rudvalis_normal_elementary_bound
    (P : Sylow 2 Rudvalis.Model) (E : Subgroup Rudvalis.Model)
    [IsElementaryAbelian 2 E]
    (hn : (P : Subgroup Rudvalis.Model) ≤ normalizer (E : Set Rudvalis.Model)) :
    Nat.card E ≤ 32 := by
  by_cases hE : E = ⊥
  · simp [hE]
  have hi : ¬ 2 ∣ localP.index := by
    intro hh
    apply Rudvalis.SylowOvergroups.RadicalCoverage.SylowCertificate.not_two_pow_fifteen_dvd_card_model
    rw [←localP.card_mul_index,IntrinsicSylow.localP_card]
    exact Nat.mul_dvd_mul_left 16384 hh
  let Q := IntrinsicSylow.localP_isPGroup.toSylow hi
  have hEP : E ≤ (P : Subgroup Rudvalis.Model) := sup_eq_left.mp
    (P.is_maximal' (P.isPGroup'.to_sup_of_normal_right'
      (IsElementaryAbelian.isPGroup 2 E) hn) le_sup_left)
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq Rudvalis.Model P Q
  let f := (MulAut.conj g).toMonoidHom
  let A := E.map f
  let : IsElementaryAbelian 2 A := IsElementaryAbelian.map f
  have hP : (P : Subgroup Rudvalis.Model).map f = localP := congrArg Sylow.toSubgroup hg
  have hAn : localP ≤ normalizer (A : Set Rudvalis.Model) := by
    rw [←hP]
    exact (map_mono hn).trans (le_normalizer_map f)
  have hAne : A ≠ ⊥ := fun he => hE ((map_eq_bot_iff_of_injective _ (MulAut.conj g).injective).mp he)
  obtain ⟨i,he⟩ := elementaryCatalogue A hAne (hP ▸ map_mono hEP) hAn inferInstance
  have hb : Nat.card A ≤ 32 := by
    rw [he]
    let : IsElementaryAbelian 2 (elementary i) := he ▸ inferInstanceAs (IsElementaryAbelian 2 A)
    exact rudvalis_catalogue_card i
  rwa [card_map_of_injective (MulAut.conj g).injective] at hb
end CFSG.Quasithin.Chapter12.Section01.DoubleNaturalSource.DoubledBranch.SourceModel
namespace CFSG.Quasithin.Chapter12.Section01.DoubleNaturalSource.DoubledBranch.SourceModel
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G} {n : ℕ}
  {B : DoubledBranch T L V n}
  [IsElementaryAbelian 2 (componentOrbit V (T : Subgroup G))]
  (S : B.SourceModel)

omit [Finite G] in
private theorem pure_natural_sup_dual :
    B.naturalSummand ⊔ B.dualSummand = componentOrbit V (T : Subgroup G) := by
  apply le_antisymm (sup_le B.naturalSummand_le B.dualSummand_le)
  intro x hx
  let v : componentOrbit V (T : Subgroup G) := ⟨x,hx⟩
  have ht : Additive.ofMul v ∈ B.naturalSpace ⊔ B.dualSpace := by
    rw [B.natural_dual_complement.sup_eq_top]; trivial
  obtain ⟨a,ha,b,hb,he⟩ := Submodule.mem_sup.mp ht
  have he' : (a.toMul : G) * (b.toMul : G) = x := congrArg (fun c => (c.toMul : G)) he
  rw [← he']
  exact (B.naturalSummand ⊔ B.dualSummand).mul_mem
    ((le_sup_left : B.naturalSummand ≤ B.naturalSummand ⊔ B.dualSummand) ⟨a.toMul,ha,rfl⟩)
    ((le_sup_right : B.dualSummand ≤ B.naturalSummand ⊔ B.dualSummand) ⟨b.toMul,hb,rfl⟩)

/-- The source moved subgroup is the commutator of the whole doubled orbit. -/
theorem pure_moving_eq_commutator
    (hNM : normalizer (componentOrbit V (T : Subgroup G) : Set G) = normalizer (L : Set G))
    (w : componentOrbit V (T : Subgroup G)) (hw : w ≠ 1)
    (hp : (B.coordinates w).toAdd.2 = 0) :
    B.naturalSummand ⊔ S.pureDualHyperplane w hp =
      ⁅componentOrbit V (T : Subgroup G),B.pointResidual w⁆ := by
  let W := componentOrbit V (T : Subgroup G)
  let U := B.naturalSummand ⊔ S.pureDualHyperplane w hp
  have hUW : U ≤ W := sup_le B.naturalSummand_le
    ((S.pureDualHyperplane_le_dualSummand w hp).trans B.dualSummand_le)
  have hWU : W ≤ normalizer (U : Set G) := by
    apply le_trans _ (Subgroup.centralizer_le_normalizer _)
    intro x hx y hy
    exact congrArg Subtype.val (mul_comm (⟨y,hUW hy⟩ : W) ⟨x,hx⟩)
  obtain ⟨hc₁,hc₂⟩ := S.pure_residual_commutators hNM w hw hp
  apply le_antisymm
  · apply sup_le
    · rw [←hc₁]
      exact commutator_mono B.naturalSummand_le le_rfl
    · rw [←hc₂]
      exact commutator_mono B.dualSummand_le le_rfl
  · rw [←pure_natural_sup_dual (B := B)]
    exact commutator_sup_le_of_relative_normal W _ _ _ U hWU
      B.naturalSummand_le B.dualSummand_le (hc₁.le.trans le_sup_left)
      (hc₂.le.trans le_sup_right)

/-- The whole original normalizer point centralizer normalizes U. -/
theorem pure_moving_normalized
    (hNM : normalizer (componentOrbit V (T : Subgroup G) : Set G) = normalizer (L : Set G))
    (w : componentOrbit V (T : Subgroup G)) (hw : w ≠ 1)
    (hp : (B.coordinates w).toAdd.2 = 0) :
    B.localPointCentralizer w ≤ normalizer
      ((B.naturalSummand ⊔ S.pureDualHyperplane w hp : Subgroup G) : Set G) := by
  rw [S.pure_moving_eq_commutator hNM w hw hp]
  intro x hx
  rw [mem_normalizer_iff_map_conj_eq,map_commutator,
    mem_normalizer_iff_map_conj_eq.mp (hNM.symm ▸ hx.1),
    mem_normalizer_iff_map_conj_eq.mp (B.localPointCentralizer_normalizes_residual w hx)]

/-- In the actual component quotient, U is normalized by an ambient Sylow.
The quotient map, subgroup and order all retain their source markings. -/
theorem pure_component_quotient_sylow_normalized
    (hTM : (T : Subgroup G) ≤ normalizer (L : Set G))
    (hNM : normalizer (componentOrbit V (T : Subgroup G) : Set G) = normalizer (L : Set G))
    (hs : S.MarkedAmbientSylow hTM)
    (w : componentOrbit V (T : Subgroup G)) (hw : w ≠ 1)
    (hp : (B.coordinates w).toAdd.2 = 0)
    (hfix : (⟨Additive.ofMul w,(S.natural_marking w).mpr hp⟩ : S.setup.natural) ∈
      S.setup.naturalFixed (S.setup.naturalSylowNormalizer
        ((T.subtype hTM).mapSurjective B.actionProjection_surjective)))
    (K : Subgroup (B.pointCentralizer w)) [K.Normal]
    (hX : (B.pointResidual w).subgroupOf (B.pointCentralizer w) ≤ K)
    (hU : B.naturalSummand ⊔ S.pureDualHyperplane w hp ≤ K.map (B.pointCentralizer w).subtype)
    (hc : center K = pCore 2 K) :
    let A := ((B.naturalSummand ⊔ S.pureDualHyperplane w hp).subgroupOf
      (B.pointCentralizer w)).subgroupOf K
    let E := A.map (QuotientGroup.mk' (pCore 2 K))
    IsElementaryAbelian 2 E ∧ Nat.card E = 2^(2*n-2) ∧
      ∃ P : Sylow 2 (K ⧸ pCore 2 K),
        (P : Subgroup _) ≤ normalizer (E : Set (K ⧸ pCore 2 K)) := by
  let H := B.pointCentralizer w
  let U := B.naturalSummand ⊔ S.pureDualHyperplane w hp
  let j : K →* G := H.subtype.comp K.subtype
  let A := U.comap j
  let q := QuotientGroup.mk' (pCore 2 K)
  obtain ⟨hE,hcard,_⟩ := S.pure_component_quotient_card_rank w hw hp K hX hU hc
  refine ⟨hE,hcard,?_⟩
  obtain ⟨P₁,hP₀⟩ := hs w hw hp hfix
  let P₀ : Sylow 2 H := P₁
  have hPm : (P₀ : Subgroup H).map H.subtype = B.pointSylow w :=
    hP₀.trans (S.marked_centralizer_eq hTM w hw hp hfix).symm
  obtain ⟨P,hP⟩ := P₀.exists_subgroupOf_eq_of_normal K
  refine ⟨P.mapSurjective (QuotientGroup.mk'_surjective _),?_⟩
  change (P : Subgroup K).map q ≤ normalizer (A.map q : Set (K ⧸ pCore 2 K))
  apply le_trans (map_mono (f := q) ?_) (le_normalizer_map q)
  apply le_trans _ (U.le_normalizer_comap j)
  intro x hx
  have hxP : (x : H) ∈ (P₀ : Subgroup H) := by
    rw [hP] at hx
    exact hx
  have hxM : j x ∈ B.localPointCentralizer w := by
    have ht := hPm ▸ mem_map_of_mem H.subtype hxP
    exact ⟨hTM ht.1,ht.2⟩
  exact S.pure_moving_normalized hNM w hw hp hxM

/-- The source component quotient cannot be Rudvalis: its marked elementary
subgroup has order at least 64 and is normalized by a full Sylow. -/
theorem pure_component_not_rudvalis
    (hTM : (T : Subgroup G) ≤ normalizer (L : Set G))
    (hNM : normalizer (componentOrbit V (T : Subgroup G) : Set G) = normalizer (L : Set G))
    (hs : S.MarkedAmbientSylow hTM)
    (w : componentOrbit V (T : Subgroup G)) (hw : w ≠ 1)
    (hp : (B.coordinates w).toAdd.2 = 0)
    (hfix : (⟨Additive.ofMul w,(S.natural_marking w).mpr hp⟩ : S.setup.natural) ∈
      S.setup.naturalFixed (S.setup.naturalSylowNormalizer
        ((T.subtype hTM).mapSurjective B.actionProjection_surjective)))
    (K : Subgroup (B.pointCentralizer w)) [K.Normal]
    (hX : (B.pointResidual w).subgroupOf (B.pointCentralizer w) ≤ K)
    (hU : B.naturalSummand ⊔ S.pureDualHyperplane w hp ≤ K.map (B.pointCentralizer w).subtype)
    (hc : center K = pCore 2 K) (e : (K ⧸ pCore 2 K) ≃* Rudvalis.Model) : False := by
  let A := ((B.naturalSummand ⊔ S.pureDualHyperplane w hp).subgroupOf
    (B.pointCentralizer w)).subgroupOf K
  let E := A.map (QuotientGroup.mk' (pCore 2 K))
  obtain ⟨hE,hcard,P,hP⟩ := S.pure_component_quotient_sylow_normalized
    hTM hNM hs w hw hp hfix K hX hU hc
  let : IsElementaryAbelian 2 E := hE
  let : IsElementaryAbelian 2 (E.map e.toMonoidHom) := IsElementaryAbelian.map _
  have hb := pure_rudvalis_normal_elementary_bound (P.mapSurjective e.surjective)
    (E.map e.toMonoidHom) ((map_mono hP).trans (le_normalizer_map e.toMonoidHom))
  rw [card_map_of_injective e.injective,hcard] at hb
  rcases B.degree with rfl | rfl <;> norm_num at hb
end CFSG.Quasithin.Chapter12.Section01.DoubleNaturalSource.DoubledBranch.SourceModel
