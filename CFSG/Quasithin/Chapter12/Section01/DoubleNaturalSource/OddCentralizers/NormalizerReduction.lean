/-!
# Full-orbit reductions for the doubled odd-normalizer argument

For an odd actor fixing W, the literal residual C_L(A)^infinity covers
L modulo O₂(L), generates W by commutators, and contains W in its own
two-core. Since |W| > 8, A.1.26/28 makes W centralize the odd core of N(A).
The already proved N(W)=N(L) places that odd core in N(L) without a
fixed-residual uniqueness assumption.

If the residual is not unique, the actual pushing-up pair has W in
O₂(J). If N(A) has trivial two-core, generalized-Fitting detection and
perfect action select an outside component with [K,W]=K. Characteristic
abelian reduction preserves any escaping normalizer of an arbitrary
odd-order actor. The original seed V is never identified with W.

These are reductions in the remaining 4.4.3 argument, not its normalizer
conclusion. Their original degree-five consumer is
ReductionSource.DoubleNaturalExcludedOddNormalizers.
Source: Aschbacher--Smith, 4.4.5--10, pp.620--621, and 12.1.9(1), p.793.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
open scoped Pointwise IsMulCommutative
open CFSG.Quasithin.Chapter12.Section01.DoubleNaturalSource
namespace CFSG.Quasithin.Chapter12.Section02.ChosenModule
open Chapter4 Chapter4.Section04 Chapter4.Section04.NormalizedRankOneOddControl
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  (D : ChosenModule T L V) (h : Hypothesis1223 KnownSimple.IsKnownSimple T L)
  {n : ℕ} (B : DoubledBranch T L V n)
include D h

/-- The full original orbit is generated by its L-commutators. -/
theorem doubledOrbit_commutator_component :
    componentOrbit V (T : Subgroup G) = ⁅componentOrbit V (T : Subgroup G), L⁆ := by
  simpa only [D.fundamentalSetup_module] using
    (D.fundamentalSetup h.toHypothesis1221).module_commutator_component D.sylow_normalizes_component

/-- Remark 4.4.2 for the full orbit and the literal quotient L/O₂(L). -/
theorem doubledOrbit_relative_centralizer_le_sectionCentralizer :
    normalizer (L : Set G) ⊓ centralizer (componentOrbit V (T : Subgroup G) : Set G) ≤
      sectionCentralizer L := by
  let := h.quasisimple
  let F := D.fundamentalSetup h.toHypothesis1221
  have hn : L ≤ normalizer (componentOrbit V (T : Subgroup G) : Set G) := by
    simpa only [F, D.fundamentalSetup_module, D.localOrbit_eq] using F.orbit_normalizes_module
  have hc : L.pCoreIn 2 ≤ centralizer (componentOrbit V (T : Subgroup G) : Set G) := by
    have hle : L.pCoreIn 2 ≤ (L ⊔ (T : Subgroup G)).pCoreIn 2 :=
      pCoreIn_mono_of_normalizes le_sup_left
        (sup_le L.le_normalizer D.sylow_normalizes_component)
    apply hle.trans
    simpa only [F, D.fundamentalSetup_module, Chapter3.Section02.localJoin, D.localOrbit_eq] using
      F.core_centralizes_module
  apply relative_module_centralizer_le_sectionCentralizer L _ hn hc _
    (D.doubledOrbit_commutator_component h)
  simpa only [F, D.fundamentalSetup_module] using F.module_ne_bot

/-- The actual fixed residual covers L and contains the whole orbit in its two-core. -/
theorem doubledOrbit_oddActorResidual_cover (A : Subgroup G)
    (hA : A ≤ normalizer (L : Set G) ⊓ centralizer (componentOrbit V (T : Subgroup G) : Set G))
    (ho : Odd (Nat.card A)) :
    (L : Set G) = (oddActorResidual L A : Set G) * (L.pCoreIn 2 : Set G) ∧
    componentOrbit V (T : Subgroup G) = ⁅componentOrbit V (T : Subgroup G), oddActorResidual L A⁆ ∧
    componentOrbit V (T : Subgroup G) ≤ (oddActorResidual L A).pCoreIn 2 ∧
    (oddActorResidual L A).pCoreIn 2 ≠ ⊥ := by
  let W := componentOrbit V (T : Subgroup G)
  let F := D.fundamentalSetup h.toHypothesis1221
  let : Group.IsPerfect L := Chapter1.mem_L_isPerfect h.maximal_faithful.1.1
  have hs := hA.trans (D.doubledOrbit_relative_centralizer_le_sectionCentralizer h)
  have hc : (L : Set G) = (oddActorResidual L A : Set G) * (L.pCoreIn 2 : Set G) :=
    (chosen_oddActorResidual_cover h.toHypothesis1221 D A (hA.trans inf_le_left)
      ((le_sectionCentralizer_iff A L).mp hs).2 ho
      ((hA.trans inf_le_right).trans (centralizer_le (le_componentOrbit V T)))).1
  have hWL : W ≤ L := by
    simpa only [F, D.fundamentalSetup_module, D.localOrbit_eq] using F.module_le_orbit
  have hLW : L ≤ normalizer (W : Set G) := by
    simpa only [F, D.fundamentalSetup_module, D.localOrbit_eq] using F.orbit_normalizes_module
  have hQW : L.pCoreIn 2 ≤ centralizer (W : Set G) := by
    apply (pCoreIn_mono_of_normalizes (show L ≤ L ⊔ (T : Subgroup G) from le_sup_left)
      (sup_le L.le_normalizer D.sylow_normalizes_component)).trans
    simpa only [F, D.fundamentalSetup_module, Chapter3.Section02.localJoin, D.localOrbit_eq] using
      F.core_centralizes_module
  have he : W = ⁅W,oddActorResidual L A⁆ := (D.doubledOrbit_commutator_component h).trans
    (commutator_eq_of_product_centralizing_factor hc (le_centralizer_iff.mp hQW))
  have hWC : W ≤ L ⊓ centralizer (A : Set G) :=
    le_inf hWL (le_centralizer_iff.mp (hA.trans inf_le_right))
  have hWF : W ≤ normalizer (oddActorResidual L A : Set G) :=
    (le_inf (hWL.trans L.le_normalizer)
      (hWC.trans inf_le_right |>.trans (Subgroup.centralizer_le_normalizer _))).trans
        (normalizes_oddActorResidual L A)
  have hWF' : W ≤ oddActorResidual L A := he ▸ le_normalizer_iff_commutator_le_right.mp hWF
  let := D.doubledOrbit_elementary h
  have hcore : W ≤ (oddActorResidual L A).pCoreIn 2 := le_pCoreIn_of_normalizes
    (IsElementaryAbelian.isPGroup 2 W) hWF' (((oddActorResidual_le L A).trans inf_le_left).trans hLW)
  have hne : W ≠ ⊥ := by simpa only [F, D.fundamentalSetup_module] using F.module_ne_bot
  exact ⟨hc,he,hcore,fun hb => hne (bot_unique (hb ▸ hcore))⟩

include B in
/-- The doubled orbit has order at least 256. -/
theorem doubledOrbit_card_gt_eight : 8 < Nat.card (componentOrbit V (T : Subgroup G)) := by
  let := D.doubledOrbit_elementary h
  have hc : Nat.card (componentOrbit V (T : Subgroup G)) = 2 ^ (2 * n) := by
    have hh := Module.natCard_eq_pow_finrank (K := ZMod 2)
      (V := Additive (componentOrbit V (T : Subgroup G)))
    rw [Nat.card_congr Additive.toMul, B.finrank_eq, Nat.card_zmod] at hh
    exact hh
  rw [hc]
  rcases B.degree with rfl | rfl <;> norm_num

omit D h [Finite G] [Group G] in
private theorem perfect_twoPerfect {H : Type*} [Group H] [Finite H] [Group.IsPerfect H] :
    IsPPerfect 2 H := by
  intro N hN hp
  let := hN
  have hs : Subsingleton (H ⧸ N) := by
    by_contra! hn
    exact Group.IsPerfect.not_isNilpotent (H ⧸ N) hp.isNilpotent
  apply eq_top_iff.mpr
  intro g _
  exact (QuotientGroup.eq_one_iff g).mp (Subsingleton.elim _ _)

include B in
/-- Source 4.4.8 for the full orbit: its normalizer equality places the odd core in M. -/
theorem doubledOrbit_oddNormalizer_oddCore (A : Subgroup G)
    (hA : A ≤ normalizer (L : Set G) ⊓ centralizer (componentOrbit V (T : Subgroup G) : Set G))
    (ho : Odd (Nat.card A)) :
    ⁅componentOrbit V (T : Subgroup G),
      (pPrimeCore 2 (normalizer (A : Set G))).map (normalizer (A : Set G)).subtype⁆ = ⊥ ∧
    (pPrimeCore 2 (normalizer (A : Set G))).map (normalizer (A : Set G)).subtype ≤
      normalizer (L : Set G) := by
  let W := componentOrbit V (T : Subgroup G)
  let N := normalizer (A : Set G)
  let F := oddActorResidual L A
  have hFN : F ≤ N := ((oddActorResidual_le L A).trans inf_le_right).trans
    (Subgroup.centralizer_le_normalizer _)
  have hWN : W ≤ N := (le_centralizer_iff.mp (hA.trans inf_le_right)).trans
    (Subgroup.centralizer_le_normalizer _)
  obtain ⟨_,he,_,_⟩ := D.doubledOrbit_oddActorResidual_cover h A hA ho
  let : Group.IsPerfect F := oddActorResidual_isPerfect L A
  let : Group.IsPerfect (F.subgroupOf N) := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe hFN).symm.toMonoidHom) (subgroupOfEquivOfLe hFN).symm.surjective
  let := D.doubledOrbit_elementary h
  let : IsElementaryAbelian 2 (W.subgroupOf N) := IsElementaryAbelian.subgroupOf hWN
  have heN : W.subgroupOf N = ⁅W.subgroupOf N,F.subgroupOf N⁆ := by
    apply map_injective N.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le hWN,map_subgroupOf_eq_of_le hFN]
    exact he
  have hcN : 8 < Nat.card (W.subgroupOf N) := by
    rw [Nat.card_congr (subgroupOfEquivOfLe hWN).toEquiv]
    exact D.doubledOrbit_card_gt_eight h B
  have hh := ChapterA.large_elementary_commutator_centralizes_oddCore
    (h.simpleQTKE.quasithin.subgroup N) (F.subgroupOf N) (W.subgroupOf N)
      perfect_twoPerfect hcN heN
  have hc : ⁅W,(pPrimeCore 2 N).map N.subtype⁆ = ⊥ := by
    simpa only [map_commutator,map_subgroupOf_eq_of_le hWN,Subgroup.map_bot] using
      congrArg (Subgroup.map N.subtype) hh
  refine ⟨hc,?_⟩
  rw [← D.doubledOrbit_normalizer_eq h B.orbit_eq]
  exact (le_centralizer_iff.mp (commutator_eq_bot_iff_le_centralizer.mp hc)).trans
    (Subgroup.centralizer_le_normalizer _)


/-- The full orbit, not just its seed, lies in the core of the two actual normalizers' intersection. -/
theorem doubledOrbit_oddNormalizer_intersection_core (A : Subgroup G)
    (hA : A ≤ normalizer (L : Set G) ⊓ centralizer (componentOrbit V (T : Subgroup G) : Set G))
    (ho : Odd (Nat.card A)) :
    componentOrbit V (T : Subgroup G) ≤
      (normalizer (L : Set G) ⊓ normalizer (A : Set G)).pCoreIn 2 := by
  have hc := (D.doubledOrbit_oddActorResidual_cover h A hA ho).2.2.1
  have hF : oddActorResidual L A ≤ normalizer (L : Set G) ⊓ normalizer (A : Set G) :=
    le_inf (((oddActorResidual_le L A).trans inf_le_left).trans L.le_normalizer)
      (((oddActorResidual_le L A).trans inf_le_right).trans (Subgroup.centralizer_le_normalizer _))
  exact hc.trans (pCoreIn_mono_of_normalizes hF (normalizes_oddActorResidual L A))

include B in
/-- The proper odd normalizer with trivial two-core has an actual component moved by the whole doubled orbit. -/
theorem doubledOrbit_oddNormalizer_moved_component (A : Subgroup G)
    [IsMulCommutative A] (hne : A ≠ ⊥)
    (hA : A ≤ normalizer (L : Set G) ⊓ centralizer (componentOrbit V (T : Subgroup G) : Set G))
    (ho : Odd (Nat.card A)) (hcore : pCore 2 (normalizer (A : Set G)) = ⊥) :
    ∃ K : Subgroup (normalizer (A : Set G)),
      IsComponent (normalizer (A : Set G)) K ∧
      ⁅K,(componentOrbit V (T : Subgroup G)).subgroupOf (normalizer (A : Set G))⁆ ≠ ⊥ ∧
      ¬ K.map (normalizer (A : Set G)).subtype ≤ normalizer (L : Set G) ∧
      pCore 2 K = ⊥ ∧ IsQuasithin K ∧ KnownSimple.IsKnownSimple (K ⧸ center K) := by
  let := D.doubledOrbit_elementary h
  let W := componentOrbit V (T : Subgroup G)
  let N := normalizer (A : Set G)
  let Y := (normalizer (L : Set G)).subgroupOf N
  have hWN : W ≤ N := (le_centralizer_iff.mp (hA.trans inf_le_right)).trans
    (Subgroup.centralizer_le_normalizer _)
  have hk : IsPGroup 2 N.subtype.ker := by
    rw [N.subtype.ker_eq_bot N.subtype_injective]
    exact IsPGroup.of_bot
  have hvY : W.subgroupOf N ≤ Y.pCoreIn 2 := by
    apply (Subgroup.map_le_map_iff_of_injective N.subtype_injective).mp
    rw [map_subgroupOf_eq_of_le hWN,map_pCoreIn_of_ker_isPGroup N.subtype hk]
    simpa only [Y,subgroupOf_map_subtype,N] using
      D.doubledOrbit_oddNormalizer_intersection_core h A hA ho
  have hvne : W.subgroupOf N ≠ ⊥ := by
    intro hb
    have hh := congrArg (Subgroup.map N.subtype) hb
    rw [map_subgroupOf_eq_of_le hWN,Subgroup.map_bot] at hh
    have hn := (D.doubledOrbit_E322 h).nontrivial
    exact hn hh
  have hvodd : ⁅W.subgroupOf N,pPrimeCore 2 N⁆ = ⊥ := by
    apply map_injective N.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le hWN,Subgroup.map_bot]
    exact (D.doubledOrbit_oddNormalizer_oddCore h B A hA ho).1
  have hWp : IsPGroup 2 (W.subgroupOf N) := (IsElementaryAbelian.isPGroup 2 W).comap_subtype
  obtain ⟨K,hK,hm,hout⟩ := exists_component_moved_outside_of_centralizes_oddCore
    (W.subgroupOf N) Y hWp hvne hcore hvodd hvY
  have hout' : ¬ K.map N.subtype ≤ normalizer (L : Set G) :=
    fun he => hout (map_le_iff_le_comap.mp he)
  have hKcore : pCore 2 K = ⊥ := by
    rw [pCore_subnormal_eq_comap 2 hK.1,hcore,MonoidHom.comap_bot]
    exact K.subtype.ker_eq_bot K.subtype_injective
  obtain ⟨_,hqt,hkg⟩ := oddNormalizer_properQTK h.simpleQTKE A hne
  let : IsQuasisimple K := hK.2
  let : IsSimpleGroup (K ⧸ center K) := IsQuasisimple.simple
  exact ⟨K,hK,hm,hout',hKcore,hqt.subgroup K,hkg.simple_quotient K (center K)⟩

include B in
/-- Perfect residual generation makes the whole doubled orbit normalize and
fully move the detected component. -/
theorem doubledOrbit_oddNormalizer_full_component (A : Subgroup G)
    [IsMulCommutative A] (hne : A ≠ ⊥)
    (hA : A ≤ normalizer (L : Set G) ⊓ centralizer (componentOrbit V (T : Subgroup G) : Set G))
    (ho : Odd (Nat.card A)) (hcore : pCore 2 (normalizer (A : Set G)) = ⊥) :
    ∃ K : Subgroup (normalizer (A : Set G)),
      IsComponent (normalizer (A : Set G)) K ∧
      ⁅K,(componentOrbit V (T : Subgroup G)).subgroupOf (normalizer (A : Set G))⁆ = K ∧
      ¬ K.map (normalizer (A : Set G)).subtype ≤ normalizer (L : Set G) ∧
      pCore 2 K = ⊥ ∧ IsQuasithin K ∧ KnownSimple.IsKnownSimple (K ⧸ center K) ∧
      (oddActorResidual L A).subgroupOf (normalizer (A : Set G)) ≤
        normalizer (K : Set (normalizer (A : Set G))) ∧
      (componentOrbit V (T : Subgroup G)).subgroupOf (normalizer (A : Set G)) ≤
        normalizer (K : Set (normalizer (A : Set G))) := by
  obtain ⟨K,hK,hm,hout,hKcore,hqt,hclass⟩ :=
    D.doubledOrbit_oddNormalizer_moved_component h B A hne hA ho hcore
  let W := componentOrbit V (T : Subgroup G)
  let N := normalizer (A : Set G)
  let F := oddActorResidual L A
  have hFN : F ≤ N := ((oddActorResidual_le L A).trans inf_le_right).trans
    (Subgroup.centralizer_le_normalizer _)
  have hWN : W ≤ N := (le_centralizer_iff.mp (hA.trans inf_le_right)).trans
    (Subgroup.centralizer_le_normalizer _)
  let : Group.IsPerfect F := oddActorResidual_isPerfect L A
  let : Group.IsPerfect (F.subgroupOf N) := Group.IsPerfect.ofSurjective
    (f := (subgroupOfEquivOfLe hFN).symm.toMonoidHom) (subgroupOfEquivOfLe hFN).symm.surjective
  have he : W.subgroupOf N = ⁅W.subgroupOf N,F.subgroupOf N⁆ := by
    apply map_injective N.subtype_injective
    rw [map_commutator,map_subgroupOf_eq_of_le hWN,map_subgroupOf_eq_of_le hFN]
    exact (D.doubledOrbit_oddActorResidual_cover h A hA ho).2.1
  let : IsQuasisimple K := hK.2
  let : IsSimpleGroup (K ⧸ center K) := IsQuasisimple.simple
  let : Nontrivial K := (QuotientGroup.mk'_surjective (center K)).nontrivial
  have heven : 2 ∣ Nat.card K := by
    by_contra hn
    exact Group.IsPerfect.not_isSolvable K
      (_root_.odd_order_theorem K (Nat.not_even_iff_odd.mp (by
        simpa only [even_iff_two_dvd] using hn)))
  obtain ⟨hFK,hWK⟩ := hK.perfect_commutator_normalizes_of_quasithin
    (h.simpleQTKE.quasithin.subgroup N) heven (F.subgroupOf N) (W.subgroupOf N) he
  exact ⟨K,hK,hK.commutator_eq_self_of_normalizes hWK hm,hout,hKcore,hqt,hclass,hFK,hWK⟩

/-- The nonunique residual branch supplies the original pushing-up counterexample with the entire orbit inside its core. -/
theorem doubledOrbit_oddNormalizer_pushingUp (A : Subgroup G)
    (hA : A ≤ normalizer (L : Set G) ⊓ centralizer (componentOrbit V (T : Subgroup G) : Set G))
    (ho : Odd (Nat.card A))
    (hnot : ¬ UniqueMaximalOvergroup (oddActorResidual L A) (normalizer (L : Set G))) :
    ∃ J H : Subgroup G,
      J ∈ muStar (normalizer (L : Set G)) L
        (coveringOvergroup (normalizer (L : Set G)) L (oddActorResidual L A)) ∧
      PushLE L (oddActorResidual L A) J ∧
      IsMaximalTwoLocal H ∧ J ≤ H ∧ ¬ H ≤ normalizer (L : Set G) ∧
      IsSQTK KnownSimple.IsKnownSimple H ∧
      componentOrbit V (T : Subgroup G) ≤ J.pCoreIn 2 ∧
      J.pCoreIn 2 ≤ sectionCentralizerIn (normalizer (L : Set G)) L := by
  obtain ⟨hc,_,hW,hne⟩ := D.doubledOrbit_oddActorResidual_cover h A hA ho
  have hI := ((oddActorResidual_le L A).trans inf_le_left).trans L.le_normalizer
  have hM : UniqueMaximalOvergroup (L ⊔ (T : Subgroup G)) (normalizer (L : Set G)) :=
    ⟨(D.doubledNormalizer_unique h).1,sup_le L.le_normalizer D.sylow_normalizes_component,
      (D.doubledNormalizer_unique h).2⟩
  obtain ⟨hs,_⟩ := coveringOvergroup_eta L.le_normalizer le_rfl hI hc.subset hne
  obtain ⟨J,H,hJ,hIJ,hH,hJH,hHM,hSQ⟩ := maximal_counterexample_of_component_cover
    h.simpleQTKE hM.1 L.le_normalizer le_rfl hI hc.subset hne hnot
  let : Group.IsPerfect L := Chapter1.mem_L_isPerfect h.maximal_faithful.1.1
  have hNL : (L.subgroupOf (normalizer (L : Set G))).Normal :=
    (normal_subgroupOf_iff_le_normalizer L.le_normalizer).mpr le_rfl
  exact ⟨J,H,hJ,hIJ,hH,hJH,hHM,hSQ,hW.trans hIJ.1,
    core_le_sectionCentralizer_of_eta L.le_normalizer hNL perfect_twoPerfect hs.1 hJ.1.1⟩

end CFSG.Quasithin.Chapter12.Section02.ChosenModule

namespace CFSG.Quasithin.Chapter12.Section01.DoubleNaturalSource
variable {G : Type*} [Group G] [Finite G]

/-- Characteristic abelian reduction preserves an escaping full normalizer.
The ambient subgroup A is the image of a characteristic subgroup of X. -/
theorem exists_abelian_of_not_oddNormalizerControl {W M : Subgroup G}
    (hnot : ¬ OddNormalizerControl W M) :
    ∃ X : Subgroup G, ∃ A : Subgroup X,
      A.Characteristic ∧ IsMulCommutative (A.map X.subtype) ∧
      A.map X.subtype ≠ ⊥ ∧ Odd (Nat.card (A.map X.subtype)) ∧
      A.map X.subtype ≤ M ⊓ centralizer (W : Set G) ∧
      normalizer (X : Set G) ≤ normalizer (A.map X.subtype : Set G) ∧
      ¬ normalizer (A.map X.subtype : Set G) ≤ M := by
  classical
  unfold OddNormalizerControl at hnot
  push Not at hnot
  obtain ⟨X,hne,ho,hXM,hXW,hout⟩ := hnot
  let : Nontrivial X := (Subgroup.nontrivial_iff_ne_bot X).mpr hne
  let : Group.IsSolvable X := odd_order_theorem X ho
  obtain ⟨A,hchar,hcomm,hA⟩ := Group.exists_nontrivial_abelian_characteristic X
  let := hchar
  let := hcomm
  have hn := normalizer_le_normalizer_characteristic_image X A
  refine ⟨X,A,hchar,inferInstance,?_,?_,(map_subtype_le A).trans (le_inf hXM hXW),hn,?_⟩
  · exact fun he => hA ((A.map_eq_bot_iff_of_injective X.subtype_injective).mp he)
  · exact ho.of_dvd_nat (card_dvd_of_le (map_subtype_le A))
  · exact fun he => hout (hn.trans he)

end CFSG.Quasithin.Chapter12.Section01.DoubleNaturalSource

