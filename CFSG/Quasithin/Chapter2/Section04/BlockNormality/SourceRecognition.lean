module
public import CFSG.Quasithin.Chapter2.Section04.BlockNormality.SourceFactors
public import CFSG.Quasithin.Chapter2.Section04.BlockNormality.ChiZeroEmbedding
public import CFSG.Quasithin.ChapterA.Section03.SourceComponents.Containment
public import CFSG.Quasithin.ChapterA.Section03.SourceComponents.ModelInputs.TheoremC
public import CFSG.Quasithin.ChapterE.Section06.Hyperplanes.Enlargement.BlockInspection.CommutationSource
/-!
# Nonsolvable selected blocks are normal under the core normalizer

Reselect the subgroup generated by the actual containing C-component and
original Sylow subgroup. It stays in Γₑ₀, and C.1.29 produces its literal block
decomposition. Complete C.1.9 and the proved Sylow orbit exhaustion identify
the containing component as χ₀. A.3.12's proved χ₀ specialization then identifies
it with the selected block, and the Sylow-conjugate product is normal.

The endpoint retains the genuine universal A, C and C.1.29 source inputs and
the original unique-maximal-two-local setup. C's model outer/parity inputs
and all additional recognition, commutation and orbit premises are discharged.
The solvable selected A₃ case is a separate source branch.

Source: Aschbacher–Smith, Lemma 2.4.6, printed p.528, using 2.3.8(4),
C.1.29, A.3.8(3), A.3.12 and 1.2.4.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter2
open ChapterE.Section06.Hyperplanes.Enlargement.BlockInspection
universe u
variable {G : Type u} [Group G] [Finite G] {κ : GroupClass} {M N : Subgroup G}

private theorem local_sqtk_of_mem_H
    (hG : IsSimpleQTKE κ G) {H : Subgroup G} (hH : H ∈ Chapter1.H G) : IsSQTK κ H := by
  have hn : IsTwoLocal (normalizer (twoCore H : Set G)) :=
    ⟨twoCore H, hH, isPGroup_pCoreIn 2 H, rfl⟩
  have hsq := (hG.twoLocal_sqtk hn).subgroup (H.subgroupOf (normalizer (twoCore H : Set G)))
  exact (IsSQTK.equiv (subgroupOfEquivOfLe (le_normalizer_twoCore H))).mp hsq

/-- Reselect the component-plus-Sylow subgroup before applying C.1.29. -/
theorem chiZero_cComponent_of_gammaEvenZero
    (hG : IsSimpleQTKE κ G) (source : LocalC129Input κ G)
    (T : Sylow 2 G) (hTM : (T : Subgroup G) ≤ M)
    (hunique : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M)
    (hN : N ∈ gammaEvenZero (Chapter1.He G) M) (P : Sylow 2 N)
    (hpair : ((P : Subgroup N).map N.subtype,N) ∈ localPairsIn (Chapter1.He G) M N)
    {K : Subgroup N} (hK : K.IsCComponent) (hout : ¬ K.map N.subtype ≤ M) :
    ChapterC.IsChiZeroBlock K := by
  let A := K.map N.subtype
  let S := (P : Subgroup N).map N.subtype
  let J := A ⊔ S
  have hJN : J ≤ N := sup_le (map_subtype_le _) (map_subtype_le _)
  have hJM : ¬ J ≤ M := fun h => hout (le_sup_left.trans h)
  obtain ⟨hJ,hpairJ,R,hR⟩ := sylow_overgroup_in_gammaEvenZero hN P hpair
    (show S ≤ J from le_sup_right) hJN hJM
  obtain ⟨d⟩ := lemma_2_3_8_4_of_localC129 hG source T hTM hunique hJ.1 hJ.2
    hpairJ R hR.ge
  have hKa : (A.subgroupOf N).IsCComponent := by
    simpa only [A, subgroupOf, comap_map_eq_self_of_injective N.subtype_injective] using hK
  have hKJ : (A.subgroupOf J).IsCComponent := hKa.subgroupOf_of_le le_sup_left hJN
  have hgen : A.subgroupOf J ⊔ (R : Subgroup J) = ⊤ := by
    apply map_injective J.subtype_injective
    rw [Subgroup.map_sup, map_subgroupOf_eq_of_le (show A ≤ J from le_sup_left), hR,
      ← MonoidHom.range_eq_map, range_subtype]
  have hout' : ¬ A.subgroupOf J ≤ M.subgroupOf J := by
    intro h
    apply hout
    have hm := map_mono (f := J.subtype) h
    rw [map_subgroupOf_eq_of_le (show A ≤ J from le_sup_left)] at hm
    exact hm.trans (map_comap_le J.subtype M)
  have hJh : J ∈ Chapter1.H G := (hJ.1.elim (fun h => h.1.1) (fun h => h.1)).1
  have hf : generalizedFitting J = pCore 2 J :=
    generalizedFitting_eq_pCore_of_selfCentralizing 2 (Chapter1.mem_He_iff.mp hJ.2)
  have hmodel := d.chiZero_of_cComponent_generated (source_blockCommutationInput G) (local_sqtk_of_mem_H hG hJh)
    hf R hKJ hgen hout'
  let e : A.subgroupOf J ≃* K := (subgroupOfEquivOfLe (show A ≤ J from le_sup_left)).trans
    (K.equivMapOfInjective N.subtype N.subtype_injective).symm
  exact ChapterE.Section06.Hyperplanes.Enlargement.BlockInspection.Lifting.CharacteristicTwoBlocks.chiZero_of_mulEquiv hmodel e
/-- The original 2.4.6 assertion for a nonsolvable selected χ₀ block.
Only genuine earlier universal source inputs remain. -/
theorem MinimalBlockSetup.coreNormalizer_normalizes_L0_of_not_three
    (d : MinimalBlockSetup M)
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hA : ∀ (X : Type u) [Group X] [Finite X],
      ChapterA.Section02.TheoremA KnownSimple.IsKnownSimple X)
    (hC : ∀ (X : Type u) [Group X] [Finite X],
      ChapterA.Section02.TheoremC KnownSimple.IsKnownSimple X)
    (source : LocalC129Input KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hunique : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M)
    (h3 : ¬ ChapterC.IsAlternatingBlock d.block 3) :
    normalizer (twoCore d.H : Set G) ≤ normalizer (d.L0.map d.H.subtype : Set G) := by
  let N := normalizer (twoCore d.H : Set G)
  let B := (d.block.map d.H.subtype).subgroupOf N
  have hMe : M ∈ Chapter1.He G := Chapter1.mem_He_iff.mpr (hG.evenCharacteristic T M hM hTM)
  obtain ⟨hNg,_hcore,P,hP⟩ := lemma_2_4_3_1 hG.evenCharacteristic hMe
    d.mem_gammaEvenZero d.full_pair d.S le_rfl
  have hBN : d.block.map d.H.subtype ≤ N :=
    (map_subtype_le _).trans (le_normalizer_twoCore d.H)
  have hBmap : B.map N.subtype = d.block.map d.H.subtype := map_subgroupOf_eq_of_le hBN
  have hBL : B ∈ Chapter1.L N (P : Subgroup N) := by
    apply (Chapter1.mem_L_map_iff N.subtype N.subtype_injective).mp
    rw [hBmap,hP]
    exact d.ambient_block_mem_L_of_not_three h3
  have hgam := hNg.1.elim (fun h => h.1.1) (fun h => h.1)
  have hNh : N ∈ Chapter1.H G := hgam.1
  have hQsq := Chapter1.Section02.uniqueness_local_quotient_sqtk hG hNh
  obtain ⟨K,⟨hK,hBK⟩,_⟩ := Chapter1.Section02.lemma_1_2_4_containment_of_A_3_12
    (fun X _ _ hs ho Q C hClocal =>
      ChapterA.Section03.SourceComponents.containment hA
        (ChapterA.Section03.SourceComponents.source_model_inputs_of_theoremC hC) hs ho Q C hClocal)
    hQsq P hBL
  have hpair : ((P : Subgroup N).map N.subtype,N) ∈ localPairsIn (Chapter1.He G) M N := by
    refine ⟨⟨?_,hNg.2,hgam.1,map_subtype_le _,gamma_not_le hgam⟩,le_rfl⟩
    rw [hP]
    exact d.full_pair.1.1
  have hout : ¬ K.map N.subtype ≤ M := by
    intro hm
    have hb := (map_mono (f := N.subtype) hBK).trans hm
    rw [hBmap] at hb
    exact d.outside hb
  have hmodel := chiZero_cComponent_of_gammaEvenZero hG source T hTM hunique
    hNg P hpair hK hout
  exact d.coreNormalizer_normalizes_L0_of_chiZero_overgroup hG T hM hTM h3 K hK hBK hmodel
end CFSG.Quasithin.Chapter2
