module
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Single.CenterPairSource
public import Theory.GroupTheory.ConjugateSubgroupClosureTransport
/-!
# Whole-subgroup generation of conjugate Sylow centers

In the nontrivial-center branch, the two original conjugates Z and Zˣ
generate Z(R). Hence Z(R), and each ambient conjugate of it, is its own
whole-Z-subgroup closure. These are the generated subgroups to which
2.4.20(6) is applied in the involution-fusion argument of 2.4.21.

Source: Aschbacher–Smith, 2.4.16(2), 2.4.20(6), 2.4.21, pp.533–536.
-/
public section
open Subgroup
namespace CFSG.Quasithin.Chapter2.LinearShadows.Single
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}

/-- In the nontrivial-center branch, Z(R) is generated by its whole Z-conjugates. -/
theorem source_distinguished_center_closure
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hST : (d.S : Subgroup d.H).map d.H.subtype < (T : Subgroup G))
    (hsingle : d.L0 = d.block) {n : ℕ} (hL : ChapterC.IsL2EvenBlock d.block n)
    (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hunique : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M)
    (hz : center (d.block.map d.H.subtype) ≠ ⊥) :
    let R := Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)
    conjugateSubgroupClosure (distinguishedZ d) (R ⊓ centralizer (R : Set G)) =
      R ⊓ centralizer (R : Set G) := by
  let Z := distinguishedZ d
  let R := Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)
  let A := R ⊓ centralizer (R : Set G)
  obtain ⟨x,hxT,hxS⟩ := SetLike.exists_of_lt hST
  have hp := source_distinguished_center_pair d hG T hST hsingle hL hM hTM hunique hz x hxT hxS
  apply le_antisymm (conjugateSubgroupClosure_le_self _ _)
  have hZ : Z ≤ conjugateSubgroupClosure Z A := by
    have he : Z.map (MulAut.conj (1:G)).toMonoidHom=Z := conjBy_one Z
    have hm : Z.map (MulAut.conj (1:G)).toMonoidHom ≤ A :=
      he.le.trans (le_sup_left.trans hp.2.le)
    exact he.ge.trans (map_conj_le_conjugateSubgroupClosure Z 1 hm)
  have hW := map_conj_le_conjugateSubgroupClosure Z x⁻¹
    (le_sup_right.trans hp.2.le)
  exact hp.2.ge.trans (sup_le hZ hW)

theorem source_distinguished_conjugate_center_closure
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hST : (d.S : Subgroup d.H).map d.H.subtype < (T : Subgroup G))
    (hsingle : d.L0 = d.block) {n : ℕ} (hL : ChapterC.IsL2EvenBlock d.block n)
    (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hunique : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M)
    (hz : center (d.block.map d.H.subtype) ≠ ⊥) (g : G) :
    let R := Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)
    let A := (R ⊓ centralizer (R : Set G)).map (MulAut.conj g).toMonoidHom
    conjugateSubgroupClosure (distinguishedZ d) A = A := by
  dsimp only
  rw [←map_conj_conjugateSubgroupClosure,
    source_distinguished_center_closure d hG T hST hsingle hL hM hTM hunique hz]
end CFSG.Quasithin.Chapter2.LinearShadows.Single
