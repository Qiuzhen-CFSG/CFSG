module
public import CFSG.Quasithin.Chapter2.Section04.Source
public import Theory.SpecificGroups.SL2.TwoCoreBorel
public import Theory.GroupTheory.SylowNormalRestriction
public import Mathlib.GroupTheory.SchurZassenhaus
public import Theory.GroupTheory.Hall.OddNormalProducts
public import Mathlib.GroupTheory.SpecificGroups.Cyclic
/-!
# The original Borel torus in the single linear-block branch

For the selected minimal parabolic with L₀=L, normal restriction picks the
literal Sylow intersection S∩L. Its normalizer is precisely M∩L: the SL₂
quotient proves one containment, and uniqueness of the maximal overgroup
of S proves the other. Schur–Zassenhaus now chooses the original odd Hall
complement D. The diagonal quotient identifies D with the field's units,
so D is cyclic of order 2^n−1 and is nontrivial.

Source: Aschbacher–Smith, §2.4.1 and the proof of 2.4.8(5), printed pp.529–530.
The later construction of the joint torus generated by D and Dˣ remains
separate from this choice of the original Borel complement.
-/

public section
open Subgroup
open scoped MatrixGroups
namespace CFSG.Quasithin.Chapter2.LinearShadows.Single
open Matrix.SpecialLinearGroup
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}

theorem source_intersection_borel
    (d : MinimalBlockSetup M) (hsingle : d.L0 = d.block)
    {n : ℕ} (hL : ChapterC.IsL2EvenBlock d.block n) :
    ∃ P : Sylow 2 d.block,
      (P : Subgroup d.block).map d.block.subtype = (d.S : Subgroup d.H) ⊓ d.block ∧
      normalizer (P : Set d.block) = (M.subgroupOf d.H).subgroupOf d.block := by
  let : d.block.Normal := hsingle ▸ d.L0_normal
  obtain ⟨P,hP⟩ := d.S.exists_sylow_map_eq_inf_of_normal d.block
  obtain ⟨_,_,F,_,_,hF,_,τ,⟨m⟩,_⟩ := hL
  let := Fintype.ofFinite F
  let : CharP F 2 := charP_of_card_eq_prime_pow
    (by simpa only [Nat.card_eq_fintype_card] using hF)
  let q : d.block →* SL(2,F) := m.quotientIso.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 d.block))
  have hq : Function.Surjective q := m.quotientIso.surjective.comp (QuotientGroup.mk'_surjective _)
  have hk : q.ker = pCore 2 d.block := by
    ext x
    exact m.quotientIso.map_eq_one_iff.trans (QuotientGroup.eq_one_iff _)
  let B := M.subgroupOf d.H
  have hSB : (d.S : Subgroup d.H) ≤ B := by
    intro x hx
    exact d.full_pair.1.1.2.1 (mem_map_of_mem d.H.subtype hx)
  have hPB : (P : Subgroup d.block) ≤ B.subgroupOf d.block := by
    intro x hx
    exact hSB ((hP ▸ mem_map_of_mem d.block.subtype hx).1)
  have hB : B.subgroupOf d.block ≠ ⊤ := by
    intro he
    exact d.outside (map_le_iff_le_comap.mpr (subgroupOf_eq_top.mp he))
  have hBN := proper_overgroup_le_sylow_normalizer_of_two_kernel q hq P
    (hk ▸ pCore_isPGroup.le_sylow_of_normal P) _ hPB hB
  let N := normalizer ((P : Subgroup d.block).map d.block.subtype : Set d.H)
  have hNP : normalizer (P : Set d.block) = N.subgroupOf d.block := by
    dsimp only [N]
    rw [subgroupOf_normalizer_eq (map_subtype_le (P : Subgroup d.block))]
    simp only [subgroupOf,comap_map_eq_self_of_injective d.block.subtype_injective,P.coe_coe]
  have hN : N ≠ ⊤ := by
    intro he
    apply sylow_normalizer_ne_top_of_surjective q hq P
    rw [hNP,he]
    exact comap_top _
  have hSN : (d.S : Subgroup d.H) ≤ N := by
    dsimp only [N]
    rw [hP]
    exact (le_inf (d.S : Subgroup d.H).le_normalizer le_normalizer_of_normal).trans
      inf_normalizer_le_normalizer_inf
  have hNB : N ≤ B := d.minimal_parabolic.1.le_maximal
    ⟨hSB,d.intersection_maximal.covBy_top⟩ hSN (lt_top_iff_ne_top.mpr hN)
  exact ⟨P,hP,le_antisymm (hNP ▸ comap_mono hNB) hBN⟩


/-- The source chooses its odd Hall subgroup inside the literal L∩M,
with the original Sylow intersection as a normal complement. -/
theorem source_borel_complement
    (d : MinimalBlockSetup M) (hsingle : d.L0 = d.block)
    {n : ℕ} (hL : ChapterC.IsL2EvenBlock d.block n) :
    ∃ (P : Sylow 2 d.block) (D : Subgroup d.block),
      (P : Subgroup d.block).map d.block.subtype = (d.S : Subgroup d.H) ⊓ d.block ∧
      normalizer (P : Set d.block) = (M.subgroupOf d.H).subgroupOf d.block ∧
      D ≤ (M.subgroupOf d.H).subgroupOf d.block ∧ Odd (Nat.card D) ∧
      Disjoint (P : Subgroup d.block) D ∧
      (P : Subgroup d.block) ⊔ D = (M.subgroupOf d.H).subgroupOf d.block ∧
      IsHallSubgroup OddHall.oddPrimes (D.subgroupOf ((M.subgroupOf d.H).subgroupOf d.block)) := by
  obtain ⟨P,hP,hB⟩ := source_intersection_borel d hsingle hL
  let B := (M.subgroupOf d.H).subgroupOf d.block
  have hPB : (P : Subgroup d.block) ≤ B := by
    dsimp only [B]
    rw [←hB]
    exact le_normalizer
  let Q := P.subtype hPB
  have hBN : B ≤ normalizer ((P : Subgroup d.block) : Set d.block) := by
    simpa only [P.coe_coe] using hB.ge
  let : (Q : Subgroup B).Normal := (normal_subgroupOf_iff_le_normalizer hPB).mpr hBN
  obtain ⟨C,hC⟩ := exists_right_complement'_of_coprime Q.card_coprime_index
  let D := C.map B.subtype
  have hDodd : Odd (Nat.card D) := by
    rw [card_map_of_injective B.subtype_injective,←hC.symm.index_eq_card]
    exact Nat.not_even_iff_odd.mp (fun h => Q.not_dvd_index (even_iff_two_dvd.mp h))
  have hgen : (P : Subgroup d.block) ⊔ D = B := by
    have he := congrArg (Subgroup.map B.subtype) hC.sup_eq_top
    simpa only [Subgroup.map_sup,Q,Sylow.coe_subtype,map_subgroupOf_eq_of_le hPB,
      ←MonoidHom.range_eq_map,range_subtype] using he
  have hdis : Disjoint (P : Subgroup d.block) D := by
    have hd := disjoint_map B.subtype_injective hC.disjoint
    simpa only [Q,Sylow.coe_subtype,map_subgroupOf_eq_of_le hPB] using hd
  have hDN : D ≤ normalizer ((P : Subgroup d.block) : Set d.block) :=
    (map_subtype_le _).trans hBN
  exact ⟨P,D,hP,hB,map_subtype_le _,hDodd,hdis,hgen,
    OddHall.oddHall_of_normalized_sup P.isPGroup' (Nat.coprime_two_left.mpr hDodd) hDN hgen⟩
/-- The complement selected in the source is the cyclic split torus of
order 2^n−1, even before the two-core has been absorbed into the block. -/
theorem source_borel_complement_properties
    (d : MinimalBlockSetup M) {n : ℕ} (hL : ChapterC.IsL2EvenBlock d.block n)
    (P : Sylow 2 d.block) (D : Subgroup d.block)
    (hDN : D ≤ normalizer (P : Set d.block))
    (hd : Disjoint (P : Subgroup d.block) D)
    (hgen : (P : Subgroup d.block) ⊔ D = normalizer (P : Set d.block)) :
    IsCyclic D ∧ Nat.card D = 2^n - 1 ∧ D ≠ ⊥ := by
  obtain ⟨hn,_,F,_,_,hF,_,τ,⟨m⟩,_⟩ := hL
  let := Fintype.ofFinite F
  let : CharP F 2 := charP_of_card_eq_prime_pow
    (by simpa only [Nat.card_eq_fintype_card] using hF)
  let q : d.block →* SL(2,F) := m.quotientIso.toMonoidHom.comp (QuotientGroup.mk' (pCore 2 d.block))
  have hq : Function.Surjective q := m.quotientIso.surjective.comp (QuotientGroup.mk'_surjective _)
  have hk : q.ker = pCore 2 d.block := by
    ext x
    exact m.quotientIso.map_eq_one_iff.trans (QuotientGroup.eq_one_iff _)
  obtain ⟨e⟩ := sylow_normalizer_complement_equiv_units q hq P
    (hk ▸ pCore_isPGroup.le_sylow_of_normal P) D hDN hd hgen
  have hc : Nat.card D = 2^n - 1 := by
    rw [Nat.card_congr e.toEquiv, Nat.card_units, hF]
  refine ⟨isCyclic_of_injective e.toMonoidHom e.injective, hc, ?_⟩
  intro he
  have hlarge : 2^2 ≤ 2^n := Nat.pow_le_pow_right (by decide) (by omega)
  rw [he, Nat.card_eq_fintype_card] at hc
  norm_num at hc
  omega

/-- The literal D chosen at the start of the single linear-block source
branch, including its Hall property, cyclic structure and nontriviality. -/
theorem source_borel_torus
    (d : MinimalBlockSetup M) (hsingle : d.L0 = d.block)
    {n : ℕ} (hL : ChapterC.IsL2EvenBlock d.block n) :
    ∃ (P : Sylow 2 d.block) (D : Subgroup d.block),
      (P : Subgroup d.block).map d.block.subtype = (d.S : Subgroup d.H) ⊓ d.block ∧
      normalizer (P : Set d.block) = (M.subgroupOf d.H).subgroupOf d.block ∧
      D ≤ (M.subgroupOf d.H).subgroupOf d.block ∧ Odd (Nat.card D) ∧
      Disjoint (P : Subgroup d.block) D ∧
      (P : Subgroup d.block) ⊔ D = (M.subgroupOf d.H).subgroupOf d.block ∧
      IsHallSubgroup OddHall.oddPrimes (D.subgroupOf ((M.subgroupOf d.H).subgroupOf d.block)) ∧
      IsCyclic D ∧ Nat.card D = 2^n - 1 ∧ D ≠ ⊥ := by
  obtain ⟨P,D,hP,hB,hDB,hodd,hd,hgen,hHall⟩ := source_borel_complement d hsingle hL
  have hDN : D ≤ normalizer (P : Set d.block) := hB.symm ▸ hDB
  have hgen' : (P : Subgroup d.block) ⊔ D = normalizer (P : Set d.block) := hgen.trans hB.symm
  exact ⟨P,D,hP,hB,hDB,hodd,hd,hgen,hHall,source_borel_complement_properties d hL P D hDN hd hgen'⟩

end CFSG.Quasithin.Chapter2.LinearShadows.Single
