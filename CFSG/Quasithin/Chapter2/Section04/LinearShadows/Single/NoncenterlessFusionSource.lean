/-!
# Involution fusion in the nontrivial-center single-block case

The outside-involution exclusion first places every fused involution in S.
The actual inside fixed-derived calculation and the normalizer Sylow
argument exclude the distinguished-Z class outside R. For the remaining
Delta class, the actual fixed subgroup is generated by individual elements
fused into Z. Sylow transport and normality of R in M place that fixed
subgroup in a conjugate of R. A nonidentity distinguished point and the TI
property then force the whole distinguished subgroup into the centralizer
of the involution, contradicting the original identity C_S(Z)=R.

The final theorem invokes both inside calculations with their literal
source actions and subgroups. No fixed-derived, generation, or model
premise remains in its statement.

Source: Aschbacher–Smith, original 2.4.21, printed pp.535–536.
-/

public section
open Subgroup
namespace CFSG.Quasithin.Chapter2.LinearShadows.Single
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}

/-- A nonidentity distinguished point lying in a conjugate of R brings the whole Z with it. -/
theorem source_noncenterless_point_forces_distinguished_le
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hST : (d.S : Subgroup d.H).map d.H.subtype < (T : Subgroup G))
    (hsingle : d.L0 = d.block) {n : ℕ} (hL : ChapterC.IsL2EvenBlock d.block n)
    (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hunique : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M)
    (hz : center (d.block.map d.H.subtype)≠⊥)
    (g z : G) (hzZ : z∈distinguishedZ d) (hz1 : z≠1)
    (hzR : z∈(Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)).conjBy g) :
    distinguishedZ d≤(Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)).conjBy g := by
  let R := Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)
  let Z := distinguishedZ d
  obtain ⟨w,hw,he⟩ := hzR
  have hwz : IsConj w z := isConj_iff.mpr ⟨g,he⟩
  obtain ⟨k,hk,hkw⟩ := source_noncenterless_fused_conjugate_cover d hG T hST hsingle hL hM hTM hunique hz w hw ⟨z,hzZ,hwz⟩
  have hkle : Z.conjBy (g*k)≤R.conjBy g := by
    rw [conjBy_mul]
    exact map_mono hk
  have hzk : z∈Z.conjBy (g*k) := by
    rw [conjBy_mul]
    exact ⟨w,hkw,he⟩
  have hh := (source_distinguished_TI d hG T hST hsingle hL hM hTM hunique).conjugate_eq_of_common_point
    (g*k) 1 z hz1 hzk (by change z∈Z.conjBy 1;rw [conjBy_one];exact hzZ)
  change Z.conjBy (g*k)=Z.conjBy 1 at hh
  rw [conjBy_one] at hh
  exact hh.ge.trans hkle

/-- Element generation of the fixed subgroup closes the delta-class branch. -/
private theorem source_noncenterless_delta_fusion_exclusion_of_element_generation
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hST : (d.S : Subgroup d.H).map d.H.subtype < (T : Subgroup G))
    (hsingle : d.L0 = d.block) {n : ℕ} (hL : ChapterC.IsL2EvenBlock d.block n)
    (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hunique : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M)
    (hz : center (d.block.map d.H.subtype)≠⊥)
    (x : G) (hxT : x∈T) (hxS : x∉(d.S : Subgroup d.H).map d.H.subtype)
    (u : G) (hu : u∈distinguishedDelta d x)
    (a g : G) (ha : a=g*u*g⁻¹)
    (haS : a∈(d.S : Subgroup d.H).map d.H.subtype)
    (haR : a∉Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype))
    (hbound : ∀z∈distinguishedZ d, ∀t∈T, IsConj t z → t∈Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype))
    (hgen : ∀z∈distinguishedZ d,z≠1→
      closure {v | v∈Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype) ⊓ centralizer ({a} : Set G) ∧ IsConj z v}=
      Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype) ⊓ centralizer ({a} : Set G)) : False := by
  let S := (d.S : Subgroup d.H).map d.H.subtype
  let R := Stellmacher.elementaryAbelianMaxJ S
  let L := d.block.map d.H.subtype
  let Z := distinguishedZ d
  let I := R ⊓ centralizer ({a} : Set G)
  have hb := source_distinguished_elementary d hG T hST hsingle hL hM hTM hunique
  have hZn : Z≠⊥ := by
    rw [show Z=distinguishedZ d from rfl,distinguishedZ_of_center_ne_bot d hz]
    exact (map_eq_bot_iff_of_injective _ L.subtype_injective).not.mpr hz
  have hZS : Z≤S := (hb.2.2.1.trans inf_le_left).trans (sSup_le fun _ h=>h.1)
  have hfixed := inf_centerIn_ne_bot (d.S.isPGroup'.map d.H.subtype) hZn hZS hb.2.2.2
  obtain ⟨z,hzfix,hz1⟩ := (Z⊓centerIn S).bot_or_exists_ne_one.resolve_left hfixed
  have hzZ : z∈Z := hzfix.1
  have hzI : z∈I := ⟨hb.2.2.1 hzZ |>.1,mem_centralizer_singleton_iff.mpr ((hzfix.2.2 a haS).symm)⟩
  let : IsElementaryAbelian 2 Z := hb.1
  have hz2 : z^2=1 := elemPow_eq_one_of_isElementaryAbelian z hzZ
  have hIR : I≤R.conjBy g := fused_generated_subgroup_le_conjugate T M R hTM
    (source_noncenterless_thompson_normal d hG T hST hsingle hL hM hTM hunique hz)
    z hz2 (hbound z hzZ) u a g ha
    (source_distinguished_delta_central d hG T hST hsingle hL hM hTM hunique hz x hxT hxS u hu).2.2.1
    I inf_le_right (hgen z hzZ hz1)
  have hZR : Z≤R.conjBy g := source_noncenterless_point_forces_distinguished_le d hG T hST hsingle hL hM hTM hunique hz g z hzZ hz1 (hIR hzI)
  have hRC : R.conjBy g≤centralizer ({a} : Set G) := by
    rintro v ⟨r,hr,rfl⟩
    apply mem_centralizer_singleton_iff.mpr
    rw [ha]
    exact (show Commute r u from hu.1.2 r hr).map (MulAut.conj g).toMonoidHom
  have haC : a∈centralizer (Z : Set G) := by
    intro z hzZ
    exact mem_centralizer_singleton_iff.mp (hRC (hZR hzZ))
  exact haR ((source_distinguished_sylow_centralizer_eq d hG T hST hsingle hL hM hTM hunique).le ⟨haS,haC⟩)

/-- Assembly of the two source fusion classes from the actual inside-involution outputs. -/
private theorem source_noncenterless_involution_fusion_contained_of_inside
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hST : (d.S : Subgroup d.H).map d.H.subtype < (T : Subgroup G))
    (hsingle : d.L0 = d.block) {n : ℕ} (hL : ChapterC.IsL2EvenBlock d.block n)
    (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hunique : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M)
    (hz : center (d.block.map d.H.subtype)≠⊥)
    (x : G) (hxT : x∈T) (hxS : x∉(d.S : Subgroup d.H).map d.H.subtype)
    (hcases : ∀a∈(d.S : Subgroup d.H).map d.H.subtype,
      a∉Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)→a^2=1→
      let I := Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)⊓centralizer ({a} : Set G)
      distinguishedZ d⊓centralizer ({a} : Set G)≤⁅I,I⁆ ∨ ∃u,u∈distinguishedDelta d x ∧ u∈⁅I,I⁆)
    (hgens : ∀a∈(d.S : Subgroup d.H).map d.H.subtype,
      a∉Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)→a^2=1→
      ∀z∈distinguishedZ d,z≠1→
      closure {v | v∈Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype) ⊓ centralizer ({a} : Set G) ∧ IsConj z v}=
      Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype) ⊓ centralizer ({a} : Set G)) :
    let R := Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)
    ∀r∈R,r^2=1→∀a∈T,IsConj r a→a∈R := by
  let S := (d.S : Subgroup d.H).map d.H.subtype
  let R := Stellmacher.elementaryAbelianMaxJ S
  let Z := distinguishedZ d
  have hb := source_distinguished_elementary d hG T hST hsingle hL hM hTM hunique
  let : IsElementaryAbelian 2 Z := hb.1
  have hbound : ∀z∈Z,∀a∈T,IsConj a z→a∈R := by
    intro z hzZ a haT haz
    by_contra haR
    have hz2 : z^2=1 := elemPow_eq_one_of_isElementaryAbelian z hzZ
    have ha2 : a^2=1 := isConj_one_left.mp (by simpa only [hz2] using IsConj.pow 2 haz)
    have haS := source_noncenterless_fused_involution_mem_sylow d hG T hST hsingle hL hM hTM hunique hz a haT ha2 ⟨z,(hb.2.2.1 hzZ).1,haz⟩
    obtain ⟨g,hg⟩ := isConj_iff.mp haz.symm
    exact source_noncenterless_z_conjugate_exclusion_of_fixed_derived d hG T hST hsingle hL hM hTM hunique hz x hxT hxS a g haS haR ha2 ⟨z,hzZ,hg⟩ (hcases a haS haR ha2)
  change ∀r∈R,r^2=1→∀a∈T,IsConj r a→a∈R
  intro r hr hr2 a haT hra
  by_contra haR
  have ha2 : a^2=1 := isConj_one_right.mp (by simpa only [hr2] using IsConj.pow 2 hra)
  have hr1 : r≠1 := by
    intro he
    have ha1 : a=1 := isConj_one_right.mp (he ▸ hra)
    exact haR (ha1 ▸ R.one_mem)
  have haS := source_noncenterless_fused_involution_mem_sylow d hG T hST hsingle hL hM hTM hunique hz a haT ha2 ⟨r,hr,hra.symm⟩
  rcases lemma_2_4_20_3 d hG T hST hsingle hL hM hTM hunique hz x hxT hxS r hr hr2 hr1 with
    ⟨z,hzZ,hz1,hrz⟩ | ⟨u,huA,huZ,huZx,hru⟩
  · exact haR (hbound z hzZ a haT (hra.symm.trans hrz))
  · obtain ⟨g,hg⟩ := isConj_iff.mp (hra.symm.trans hru).symm
    exact source_noncenterless_delta_fusion_exclusion_of_element_generation d hG T hST hsingle hL hM hTM hunique hz x hxT hxS u ⟨huA,huZ,huZx⟩ a g hg.symm haS haR hbound (hgens a haS haR ha2)


/-- Original noncenterless involution fusion closure, with both inside calculations discharged. -/
theorem source_noncenterless_involution_fusion_contained
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hST : (d.S : Subgroup d.H).map d.H.subtype < (T : Subgroup G))
    (hsingle : d.L0 = d.block) {n : ℕ} (hL : ChapterC.IsL2EvenBlock d.block n)
    (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hunique : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M)
    (c : CyclicTorusSetup d T n)
    (hz : center (d.block.map d.H.subtype)≠⊥) :
    let R := Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)
    ∀r∈R,r^2=1→∀a∈T,IsConj r a→a∈R := by
  let R := Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)
  obtain ⟨x,hxT,hxS,_⟩ := c.outside
  apply source_noncenterless_involution_fusion_contained_of_inside d hG T hST hsingle hL hM hTM hunique hz x hxT hxS
  · intro a haS haR ha2
    have haOrder : orderOf a=2 := orderOf_eq_prime_iff.mpr ⟨ha2,fun he=>haR (he ▸ R.one_mem)⟩
    rcases source_noncenterless_inside_fixed_derived d hG T hST hsingle hL hM hTM hunique c hz a haS haOrder haR x hxT hxS with hfix | ⟨_,u,hu,hud⟩
    · exact Or.inl hfix
    · exact Or.inr ⟨u,hu,hud⟩
  · intro a haS haR ha2 z hzZ hz1
    exact source_noncenterless_inside_fixed_generation d hG T hST hsingle hL hM hTM hunique c hz a haS ha2 haR z hzZ hz1

end CFSG.Quasithin.Chapter2.LinearShadows.Single
