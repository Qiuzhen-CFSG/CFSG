module
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Single.DistinguishedGeometrySource
public import Theory.GroupTheory.ConjugateSubgroupClosureTransport
/-!
# Generated two-subgroups in the maximal local subgroup

Place a two-subgroup of M in its chosen Sylow T by an M-conjugation.
Whole-subgroup closure commutes with this conjugation, and the original
2.4.19 closure in T is R. Normality of R in M transports the containment
back. The normality premise is exactly the preceding 2.4.20(4) input.

Source: Aschbacher–Smith, 2.4.20(6), printed p.535.
-/
public section
open Subgroup
namespace CFSG.Quasithin.Chapter2.LinearShadows.Single
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}

/-- The Sylow transport in original 2.4.20(6): any two-subgroup of M
which is generated by whole conjugates of Z lies in R once R is M-normal. -/
theorem source_distinguished_generated_two_subgroup_le
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hST : (d.S : Subgroup d.H).map d.H.subtype < (T : Subgroup G))
    (hsingle : d.L0 = d.block) {n : ℕ} (hL : ChapterC.IsL2EvenBlock d.block n)
    (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hunique : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M)
    (hMR : M ≤ normalizer (Stellmacher.elementaryAbelianMaxJ
      ((d.S : Subgroup d.H).map d.H.subtype) : Set G))
    (X : Subgroup G) (hX : IsPGroup 2 X) (hXM : X ≤ M)
    (hgen : conjugateSubgroupClosure (distinguishedZ d) X = X) :
    X ≤ Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype) := by
  let Z := distinguishedZ d
  let R := Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)
  obtain ⟨P,hXP⟩ := (hX.comap_subtype : IsPGroup 2 (X.subgroupOf M)).exists_le_sylow
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq M P (T.subtype hTM)
  have hx : (X.subgroupOf M).map (MulAut.conj g).toMonoidHom ≤
      (T.subtype hTM : Subgroup M) := by
    rw [← hg]
    exact map_mono hXP
  have hf : M.subtype.comp (MulAut.conj g).toMonoidHom =
      (MulAut.conj (g:G)).toMonoidHom.comp M.subtype := by ext a; rfl
  have hamb := map_mono (f := M.subtype) hx
  rw [map_map,hf,←map_map,map_subgroupOf_eq_of_le hXM,Sylow.coe_subtype,
    map_subgroupOf_eq_of_le hTM] at hamb
  have hmap : X.map (MulAut.conj (g:G)).toMonoidHom ≤ R := by
    rw [←hgen,map_conj_conjugateSubgroupClosure]
    exact (conjugateSubgroupClosure_mono hamb).trans_eq
      (source_distinguished_weak_closure_eq d hG T hST hsingle hL hM hTM hunique)
  have hR : R.map (MulAut.conj (g:G)).toMonoidHom = R :=
    mem_normalizer_iff_map_conj_eq.mp (hMR g.property)
  intro a ha
  apply (mem_map_iff_mem (f := (MulAut.conj (g:G)).toMonoidHom) (MulAut.conj (g:G)).injective).mp
  rw [hR]
  exact hmap (mem_map_of_mem (MulAut.conj (g:G)).toMonoidHom ha)
end CFSG.Quasithin.Chapter2.LinearShadows.Single
