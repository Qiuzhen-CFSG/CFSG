module
public import Theory.GroupAction.BinaryCyclicQuotientFixedKernel
public import Theory.GroupAction.SubgroupQuotientFullAction
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Single.FieldFixedFusionSource
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Single.CenterFixedCardSource
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Single.DistinguishedGeometrySource
/-!
# The original fixed-plane action kernel

The cyclic field complement acts faithfully on the literal quotient
U/Z(R). Otherwise its unique involution acts trivially there, forcing
its displacement image, of order 2^n, into a fixed center of order 2^(n/2).
The square-root fixed count on Z(R) also lifts every fixed quotient element
to C_U(s). The binary cyclic action theorem therefore puts an original
field actor trivial on C_U(s)/C_Z(R)(s) in the subgroup generated by s.

Every action, quotient and commutator uses the original embedded subgroups.
This removes the fixed-plane kernel premise in the single linear terminal
argument of Aschbacher–Smith, Chapter 2, Section 4, printed pp.537–539.
-/

public section
open Subgroup
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter2.LinearShadows.Single
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}

theorem source_centerless_field_fixed_plane_kernel
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hST : (d.S : Subgroup d.H).map d.H.subtype < (T : Subgroup G))
    (hsingle : d.L0 = d.block) {n : ℕ} (hL : ChapterC.IsL2EvenBlock d.block n)
    (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hu : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M)
    (c : CyclicTorusSetup d T n) (hZ : center (d.block.map d.H.subtype) = ⊥)
    (s : T) (hs : (s:G) ∈ (d.S : Subgroup d.H).map d.H.subtype ⊓ normalizer (c.hall:Set G))
    (hs2 : orderOf s=2)
    (hsR : (s:G) ∉ Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype))
    (f : G) (hf : f ∈ (d.S : Subgroup d.H).map d.H.subtype ⊓ normalizer (c.hall:Set G))
    (hcomm : ∀ u ∈ ChapterC.Section05.ConjugateSource.sourceModule (d.block.map d.H.subtype) ⊓
        centralizer ({(s:G)}:Set G),
      f*u*f⁻¹*u⁻¹ ∈ (Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype) ⊓
        centralizer (Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype) : Set G)) ⊓
        centralizer ({(s:G)}:Set G)) : f ∈ zpowers (s:G) := by
  let S := (d.S : Subgroup d.H).map d.H.subtype
  let R := Stellmacher.elementaryAbelianMaxJ S
  let U := ChapterC.Section05.ConjugateSource.sourceModule (d.block.map d.H.subtype)
  let Z := R ⊓ centralizer (R:Set G)
  let F := S ⊓ normalizer (c.hall:Set G)
  have hUQ : U=twoCore d.H := (lemma_2_4_8_2 d hG T hST hsingle hL hM hTM hu).2
  let : IsElementaryAbelian 2 U := hUQ.symm ▸ (d.core_source hG T hST).2.2.2.1
  let : IsCyclic F := c.field_cyclic
  have hFT : F ≤ (T:Subgroup G) := inf_le_left.trans hST.le
  have hFp : IsPGroup 2 F := T.isPGroup'.to_le hFT
  have hFU : F ≤ normalizer (U:Set G) := by
    rw [hUQ]
    exact inf_le_left.trans ((map_subtype_le _).trans (le_normalizer_twoCore d.H))
  have hZd := source_distinguished_elementary d hG T hST hsingle hL hM hTM hu
  rw [distinguishedZ_of_centerless d hZ] at hZd
  change IsElementaryAbelian 2 Z ∧ Nat.card Z=2^n ∧ Z≤R⊓centralizer (R:Set G) ∧
    S≤normalizer (Z:Set G) at hZd
  let : IsElementaryAbelian 2 Z := hZd.1
  have hFZ : F ≤ normalizer (Z:Set G) := inf_le_left.trans hZd.2.2.2
  obtain ⟨x,hxT,hxS,_⟩ := c.outside
  have hZU : Z ≤ U := (source_absorbed_center_pair d hG T hST hsingle hL hM hTM hu x hxT hxS).ge.trans inf_le_left
  let N := Z.subgroupOf U
  let : N.Normal := inferInstance
  let ρ : F →* MulAut U := U.normalizerMonoidHom.comp (inclusion hFU)
  let sF : F := ⟨s,hs⟩
  have hsF : orderOf sF=2 := (orderOf_coe sF).symm.trans ((orderOf_coe s).trans hs2)
  let hN : ∀ a : F, ∀ v ∈ N, ρ a v ∈ N := fun a v hv =>
    (mem_normalizer_iff.mp (hFZ a.property) v.val).mp hv
  obtain ⟨β,hβ'⟩ := exists_quotient_conjugation_action F U Z hFU hFZ (inferInstance : N.Normal)
  have hβ : ∀ a : F, ∀ v : U, β a (QuotientGroup.mk' N v)=QuotientGroup.mk' N (ρ a v) := hβ'
  let α := (ρ sF).toMonoidHom
  let CU := α.eqLocus (MonoidHom.id U)
  let CN := (α.restrict (hN sF)).eqLocus (MonoidHom.id N)
  let eU : CU ≃ (U⊓centralizer ({(s:G)}:Set G) : Subgroup G) :=
    { toFun := fun u => ⟨u.val,u.val.property,by
        apply mem_centralizer_singleton_iff.mpr
        have he := congrArg Subtype.val u.property
        change (s:G)*(u.val:G)*(s:G)⁻¹=(u.val:G) at he
        exact (mul_inv_eq_iff_eq_mul.mp he).symm⟩
      invFun := fun u => ⟨⟨u,u.property.1⟩,Subtype.ext
        (mul_inv_eq_iff_eq_mul.mpr (mem_centralizer_singleton_iff.mp u.property.2).symm)⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  let eN : CN ≃ (Z⊓centralizer ({(s:G)}:Set G) : Subgroup G) :=
    { toFun := fun z => ⟨((z.val:U):G),z.val.property,by
        apply mem_centralizer_singleton_iff.mpr
        have he := congrArg (fun v:N => ((v:U):G)) z.property
        change (s:G)*((z.val:U):G)*(s:G)⁻¹=((z.val:U):G) at he
        exact (mul_inv_eq_iff_eq_mul.mp he).symm⟩
      invFun := fun z => ⟨⟨⟨z,hZU z.property.1⟩,z.property.1⟩,by
        apply Subtype.ext
        apply Subtype.ext
        exact mul_inv_eq_iff_eq_mul.mpr (mem_centralizer_singleton_iff.mp z.property.2).symm⟩
      left_inv := fun _ => rfl
      right_inv := fun _ => rfl }
  have hsord : orderOf (s:G)=2 := (orderOf_coe s).trans hs2
  have hcU : Nat.card CU=2^n := (Nat.card_congr eU).trans
    (source_centerless_field_plane_card d hG T hST hsingle hL hM hTM hu c hZ s hs hsord)
  have hUc : Nat.card U=(2^n)^2 := by
    have hh := source_field_core_centralizer_card_square d hG T hST hsingle hL hM hTM hu c s hs hsord
    rw [←hUQ,←Nat.card_congr eU,hcU] at hh
    exact hh.symm
  have hsnon : (s:G)∉centralizer (Z:Set G) := by
    intro h
    have hSC := source_distinguished_sylow_centralizer_eq d hG T hST hsingle hL hM hTM hu
    rw [distinguishedZ_of_centerless d hZ] at hSC
    exact hsR (hSC.le ⟨hs.1,h⟩)
  obtain ⟨m,hm,hn,hcm⟩ := source_centerless_center_involution_fixed_card d hG T hST hsingle hL hM hTM hu c hZ
    s s.property (by simpa only [hsord] using pow_orderOf_eq_one (s:G)) hsnon
  have hcN : Nat.card CN=2^m := (Nat.card_congr eN).trans hcm
  have hNsq : Nat.card CN^2=Nat.card N := by
    rw [hcN,Nat.card_congr (subgroupOfEquivOfLe hZU).toEquiv,hZd.2.1,hn,←pow_mul]
    congr 1
    omega
  have hbound : Nat.card U > Nat.card CU * Nat.card CN := by
    rw [hUc,hcU,hcN,pow_two]
    apply Nat.mul_lt_mul_of_pos_left _ (by positivity)
    apply Nat.pow_lt_pow_right (by decide : 1<2)
    omega
  have he := BinaryCyclicAction.mem_zpowers_of_fixed_quotient_displacement ρ N hN β hβ hFp sF hsF hbound hNsq
    (⟨f,hf⟩:F) (by
      intro u hu
      change f*(u:G)*f⁻¹/(u:G)∈Z
      have hus : (u:G)∈centralizer ({(s:G)}:Set G) := by
        apply mem_centralizer_singleton_iff.mpr
        have he := congrArg Subtype.val hu
        change (s:G)*(u:G)*(s:G)⁻¹=(u:G) at he
        exact (mul_inv_eq_iff_eq_mul.mp he).symm
      rw [div_eq_mul_inv]
      exact (hcomm (u:G) ⟨u.property,hus⟩).1)
  obtain ⟨k,hk⟩ := he
  exact ⟨k,congrArg Subtype.val hk⟩
end CFSG.Quasithin.Chapter2.LinearShadows.Single
