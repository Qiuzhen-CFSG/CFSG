module
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Single.ConjugateTorusSource
public import Theory.GroupTheory.Hall.ConjugateTorusConstruction
/-!
# The original joint Hall torus and Frattini factorization

Starting with the selected nontrivial Borel torus D, its outside conjugate
normalizes RD. The index-two Sylow geometry makes RDDˣ invariant under T
with Sylow subgroup R. Choose an odd Hall subgroup B containing D and
apply Hall conjugacy to obtain T=R N_T(B). An outside normalizing element
can then be chosen, and the resulting B is generated by D and Dˣ, each
normal in B. It is Hall in the actual group generated by T and D.

This is the original Hall/Frattini construction in 2.4.8(5). The source's
subsequent abelianity, common fixed subgroup and two-core absorption steps
remain to be established; none is assumed here.

Source: Aschbacher–Smith 2.4.8(5), printed p.530, second and third paragraphs.
-/

public section
open Subgroup
open scoped Pointwise
namespace CFSG.Quasithin.Chapter2.LinearShadows.Single
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}

theorem source_joint_hall_torus
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G)
    (hST : (d.S : Subgroup d.H).map d.H.subtype < (T : Subgroup G))
    (hsingle : d.L0 = d.block) {n : ℕ} (hL : ChapterC.IsL2EvenBlock d.block n)
    (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hunique : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M) :
    let S := (d.S : Subgroup d.H).map d.H.subtype
    let L := d.block.map d.H.subtype
    let R := Stellmacher.elementaryAbelianMaxJ S
    ∃ D B : Subgroup G, D ≤ M ⊓ L ∧ D ≤ B ∧ IsCyclic D ∧ Nat.card D = 2^n-1 ∧ D ≠ ⊥ ∧
      Odd (Nat.card B) ∧ IsHallSubgroup OddHall.oddPrimes (B.subgroupOf ((T : Subgroup G) ⊔ D)) ∧
      (T : Subgroup G) ⊔ D = (T : Subgroup G) ⊔ B ∧
      B ≤ normalizer (R : Set G) ∧
      ((T : Subgroup G) ⊔ B) ≤ normalizer ((R ⊔ B : Subgroup G) : Set G) ∧
      S ≤ normalizer ((R ⊔ D : Subgroup G) : Set G) ∧
      (T : Set G) = (R : Set G) * (((T : Subgroup G) ⊓ normalizer (B : Set G) : Subgroup G) : Set G) ∧
      ∃ x ∈ T, x ∉ S ∧ x ∈ normalizer (B : Set G) ∧
        B = D ⊔ D.map (MulAut.conj x⁻¹).toMonoidHom ∧ B ≤ normalizer (D : Set G) ∧
        B ≤ normalizer (D.map (MulAut.conj x⁻¹).toMonoidHom : Set G) ∧
        D.map (MulAut.conj x⁻¹).toMonoidHom ≤ normalizer (L : Set G) := by
  let S := (d.S : Subgroup d.H).map d.H.subtype
  let L := d.block.map d.H.subtype
  let R := Stellmacher.elementaryAbelianMaxJ S
  obtain ⟨D,hDM,hodd,hcyc,hcard,hne,_hgen,hDR,hSA,hDx⟩ :=
    source_ambient_borel_conjugate_torus d hG T hST hsingle hL hM hTM hunique
  have hK := hL.of_mulEquiv (equivMapOfInjective d.block d.H.subtype d.H.subtype_injective)
  have hglobal := d.lemma_2_4_8_1 hG T hST hsingle hK
  have hRS : R ≤ S := sSup_le fun _ h => h.1
  have hR : IsPGroup 2 R := T.isPGroup'.to_le (hRS.trans hST.le)
  let := hcyc
  have hDsolv : Group.IsSolvable D := inferInstance
  have hconj (x : G) (hx : x ∈ T) (hxS : x ∉ S) :
      D.map (MulAut.conj x).toMonoidHom ≤ normalizer ((R ⊔ D : Subgroup G) : Set G) := by
    have hxi : x⁻¹ ∉ S := fun hh => hxS (by simpa only [inv_inv] using S.inv_mem hh)
    simpa only [inv_inv] using (hDx x⁻¹ (T.inv_mem hx) hxi).2
  obtain ⟨K,B,hDB,hBK,hBodd,hHall,hRB,hTK,hKR,_hKA,hfrat,x,hxT,hxS,hxB,hKE⟩ :=
    OddHall.exists_joint_hall_of_index_two S T R D hST hglobal.1 hR hRS hglobal.2.2
      hDsolv hodd hDR hSA hconj
  have hpair := OddHall.hall_pair_generation R D K B hR hBodd hDB hBK hKR x hxB
    (hconj x hxT hxS) hKE
  have hKJ : K ≤ (T : Subgroup G) ⊔ D := by
    rw [hKE]
    apply sup_le (sup_le ((hRS.trans hST.le).trans le_sup_left) le_sup_right)
    rintro _ ⟨z,hz,rfl⟩
    exact ((T : Subgroup G) ⊔ D).mul_mem
      (((T : Subgroup G) ⊔ D).mul_mem (mem_sup_left hxT) (mem_sup_right hz))
      (((T : Subgroup G) ⊔ D).inv_mem (mem_sup_left hxT))
  have hTJ : (T : Subgroup G) ⊔ D = (T : Subgroup G) ⊔ B :=
    le_antisymm (sup_le le_sup_left (hDB.trans le_sup_right))
      (sup_le le_sup_left (hBK.trans hKJ))
  have hKT : K ⊔ (T : Subgroup G) = (T : Subgroup G) ⊔ D := by
    apply le_antisymm (sup_le hKJ le_sup_left)
    exact sup_le le_sup_right ((hDB.trans hBK).trans le_sup_left)
  have hHall' := OddHall.hall_in_two_extension K T B T.isPGroup' hTK hBK hHall
  rw [hKT] at hHall'
  have hnormal : ((T : Subgroup G) ⊔ B) ≤ normalizer ((R ⊔ B : Subgroup G) : Set G) := by
    rw [hRB]
    exact sup_le hTK (hBK.trans K.le_normalizer)
  refine ⟨D,B,hDM,hDB,hcyc,hcard,hne,hBodd,hHall',hTJ,hBK.trans hKR,hnormal,hSA,hfrat,
    x⁻¹,T.inv_mem hxT,?_,(normalizer (B : Set G)).inv_mem hxB,?_,hpair.2.1,?_,?_⟩
  · intro hh
    exact hxS (by simpa only [inv_inv] using S.inv_mem hh)
  · simpa only [inv_inv] using hpair.1
  · simpa only [inv_inv] using hpair.2.2
  · have hxi : x⁻¹ ∉ S := fun hh => hxS (by simpa only [inv_inv] using S.inv_mem hh)
    exact (hDx x⁻¹ (T.inv_mem hxT) hxi).1

end CFSG.Quasithin.Chapter2.LinearShadows.Single
