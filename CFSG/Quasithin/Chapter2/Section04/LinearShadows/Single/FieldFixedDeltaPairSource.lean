module
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Single.InsideFixedNonabelianSource
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Single.InsideFixedProductSource
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Single.NonsingularFusionSource
/-!
# A noncommuting pair in the prescribed inside involution class

A nonzero fixed vector in the radical of the orthogonal core has nonzero
quadratic value. Adding it corrects any singular fixed vector to a
nonsingular vector without changing its image modulo the block center.
The literal module fusion identifies each corrected noncentral vector
with the prescribed Δ-class.

Apply this to both elementary factors of C_R(s). They are contained in
the subgroup generated by that class together with Z(R). If the class
subgroup were abelian, C_R(s) would be abelian, contrary to the original
fixed-derived calculation. Thus two actual class elements fail to commute.
This argument includes q=4, where nonsingular vectors need not span the
whole fixed orthogonal module.

Source: Aschbacher–Smith, 2.4.12(2), 2.4.21 and the odd branch of
2.4.24(2), printed pp.532,536,540.
-/
public section
open Subgroup
namespace CFSG.Quasithin.Chapter2.LinearShadows.Single
open ChapterC.Section05.ConjugateSource
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}
private theorem core_fixed_le_of_delta_and_center
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hST : (d.S : Subgroup d.H).map d.H.subtype < (T : Subgroup G))
    (hsingle : d.L0 = d.block) {n : ℕ} (hL : ChapterC.IsL2EvenBlock d.block n)
    (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hunique : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M)
    (c : CyclicTorusSetup d T n) (hz : center (d.block.map d.H.subtype)≠⊥)
    (a : G) (haS : a∈(d.S:Subgroup d.H).map d.H.subtype) (ha2 : orderOf a=2)
    (haR : a∉Stellmacher.elementaryAbelianMaxJ ((d.S:Subgroup d.H).map d.H.subtype))
    (x : G) (hxT : x∈T) (hxS : x∉(d.S:Subgroup d.H).map d.H.subtype)
    (hxB : x∈normalizer (c.hall:Set G)) (v : G) (hv : v∈distinguishedDelta d x)
    (K : Subgroup G) (hZK : distinguishedZ d≤K)
    (hdelta : ∀ r∈sourceModule (d.block.map d.H.subtype)⊓centralizer ({a}:Set G),
      IsConj r v → r∈K) :
    sourceModule (d.block.map d.H.subtype)⊓centralizer ({a}:Set G)≤K := by
  let L := d.block.map d.H.subtype
  let U := sourceModule L
  have hK := hL.of_mulEquiv (equivMapOfInjective d.block d.H.subtype d.H.subtype_injective)
  have hcore : (pCore 2 L).map L.subtype=U := by
    rw [source_block_core_eq_module d hG T hST hsingle];rfl
  have hcenter : center L≤pCore 2 L := by
    rw [source_block_core_eq_module d hG T hST hsingle]
    exact hK.center_le_module (source_block_core_eq_module d hG T hST hsingle)
  have ha' : a^2=1 := by simpa only [ha2] using pow_orderOf_eq_one a
  obtain ⟨b,hb,hbval,ho,⟨e⟩⟩ := source_inside_orthogonal_involution_coordinates
    d hG T hST hsingle hL hM hTM hunique hz a haS ha' haR
  obtain ⟨hZE,hZcard,hZR,hZN⟩ := source_distinguished_elementary d hG T hST hsingle hL hM hTM hunique
  let : IsElementaryAbelian 2 (distinguishedZ d) := hZE
  have hZne : distinguishedZ d≠⊥ := by
    intro he
    rw [he,card_bot] at hZcard
    have hn := hL.1
    have hh : 1<2^n := Nat.one_lt_pow (by omega) (by decide)
    omega
  obtain ⟨z,hzZ,hz1,hza⟩ := exists_nonidentity_fixed_of_elementary_normalizer
    (distinguishedZ d) hZne a ha' (hZN haS)
  have hzC : z∈centralizer ({a}:Set G) := mem_centralizer_singleton_iff.mpr hza.eq.symm
  have hzZ' := hzZ
  rw [distinguishedZ_of_center_ne_bot d hz] at hzZ'
  obtain ⟨zL,hzL,hzval⟩ := hzZ'
  let zQ : pCore 2 L := ⟨zL,hcenter hzL⟩
  have hzform : Representation.SL2OrthogonalCover.form (e.core zQ).toAdd≠0 := by
    intro he
    have hp := (Representation.SL2OrthogonalCover.mem_polar_ker _).mp (e.center_mem_radical zQ hzL)
    have h0 : (e.core zQ).toAdd 0=0 := by
      rw [Representation.SL2OrthogonalCover.form_apply,hp.1,hp.2,zero_mul,add_zero] at he
      exact (pow_eq_zero_iff (by decide)).mp he
    have he0 : (e.core zQ).toAdd=0 := by ext i;fin_cases i <;> simp [h0,hp.1,hp.2]
    have hq : zQ=1 := e.core.injective (by apply Multiplicative.toAdd.injective;simpa using he0)
    exact hz1 (hzval.symm.trans (congrArg (fun q:pCore 2 L=>((q:L):G)) hq))
  intro r hr
  obtain ⟨rL,hrQ,hrval⟩ := hcore.ge hr.1
  let rQ : pCore 2 L := ⟨rL,hrQ⟩
  have hr' : ((rQ:L):G)=r := hrval
  by_cases hrc : (rQ:L)∈center L
  · apply hZK
    rw [distinguishedZ_of_center_ne_bot d hz]
    exact ⟨rL,hrc,hrval⟩
  have hconj (q:pCore 2 L) (hqf:Representation.SL2OrthogonalCover.form (e.core q).toAdd≠0)
      (hqc:(q:L)∉center L) : IsConj ((q:L):G) v :=
    source_nonsingular_noncentral_fused_delta d hG T hST hsingle hL hM hTM hunique c hz
      x hxT hxS hxB e q hqf hqc v hv
  by_cases hrf : Representation.SL2OrthogonalCover.form (e.core rQ).toAdd≠0
  · exact hdelta r hr (hr' ▸ hconj rQ hrf hrc)
  push Not at hrf
  have hprodform : Representation.SL2OrthogonalCover.form (e.core (rQ*zQ)).toAdd≠0 := by
    have hp := (Representation.SL2OrthogonalCover.mem_polar_ker _).mp (e.center_mem_radical zQ hzL)
    rw [map_mul]
    change Representation.SL2OrthogonalCover.form ((e.core rQ).toAdd+(e.core zQ).toAdd)≠0
    have he : Representation.SL2OrthogonalCover.form ((e.core rQ).toAdd+(e.core zQ).toAdd)=
        Representation.SL2OrthogonalCover.form (e.core rQ).toAdd+Representation.SL2OrthogonalCover.form (e.core zQ).toAdd := by
      simp only [Representation.SL2OrthogonalCover.form_apply,Pi.add_apply,hp.1,hp.2,add_zero,zero_mul,CharTwo.add_sq]
      ring
    rw [he,hrf,zero_add]
    exact hzform
  have hprodnc : (rQ*zQ:L)∉center L := by
    intro hh
    exact hrc ((center L).mul_mem_cancel_right hzL |>.mp hh)
  have hprodval : ((rQ*zQ:L):G)=r*z := by change L.subtype rL*L.subtype zL=r*z;rw [hrval,hzval]
  have hzU : z∈U := hcore.le ⟨zL,hcenter hzL,hzval⟩
  have hrzK : r*z∈K := hdelta (r*z) ⟨U.mul_mem hr.1 hzU,(centralizer _).mul_mem hr.2 hzC⟩
    (hprodval ▸ hconj (rQ*zQ) hprodform hprodnc)
  exact K.mul_mem_cancel_right (hZK hzZ) |>.mp hrzK

theorem source_field_fixed_noncommuting_delta_pair
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hST : (d.S : Subgroup d.H).map d.H.subtype < (T : Subgroup G))
    (hsingle : d.L0 = d.block) {n : ℕ} (hL : ChapterC.IsL2EvenBlock d.block n)
    (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hunique : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M)
    (c : CyclicTorusSetup d T n)
    (s : G) (hs : s∈(d.S:Subgroup d.H).map d.H.subtype⊓normalizer (c.hall:Set G))
    (hs2 : orderOf s=2)
    (hsR : s∉Stellmacher.elementaryAbelianMaxJ ((d.S:Subgroup d.H).map d.H.subtype))
    (hz : center (d.block.map d.H.subtype)≠⊥)
    (x : G) (hxT : x∈T) (hxS : x∉(d.S:Subgroup d.H).map d.H.subtype)
    (hxB : x∈normalizer (c.hall:Set G)) (u : G) (hu : u∈distinguishedDelta d x) :
    let I := Stellmacher.elementaryAbelianMaxJ ((d.S:Subgroup d.H).map d.H.subtype)⊓centralizer ({s}:Set G)
    ∃ r t:G, r∈I ∧ t∈I ∧ IsConj r u ∧ IsConj t u ∧ ¬Commute r t := by
  classical
  let S := (d.S:Subgroup d.H).map d.H.subtype
  let R := Stellmacher.elementaryAbelianMaxJ S
  let U := sourceModule (d.block.map d.H.subtype)
  let I := R⊓centralizer ({s}:Set G)
  let Z := R⊓centralizer (R:Set G)
  let H := closure {v:G | v∈I ∧ IsConj v u}
  let K := H⊔Z
  have hHI : H≤I := (closure_le _).mpr fun _ h=>h.1
  have hHR : H≤R := hHI.trans inf_le_left
  have hZR : distinguishedZ d≤Z :=
    (source_distinguished_elementary d hG T hST hsingle hL hM hTM hunique).2.2.1
  have ht := d.lemma_2_4_8_1 hG T hST hsingle
    (hL.of_mulEquiv (equivMapOfInjective d.block d.H.subtype d.H.subtype_injective))
  have hTNZ : (T:Subgroup G)≤normalizer (Z:Set G) :=
    (le_inf ht.2.2 (ht.2.2.trans (normalizer_le_normalizer_centralizer _))).trans
      (le_normalizer_inf inf_le_left inf_le_right)
  let α := MulAut.conj x
  let β := MulAut.conj x⁻¹
  let s' := α s
  have hβα (v:G) : β (α v)=v := by
    change x⁻¹*(x*v*x⁻¹)*(x⁻¹)⁻¹=v;group
  have hs'S : s'∈S := (mem_normalizer_iff.mp (ht.2.1 hxT) s).mp hs.1
  have hs'R : s'∉R := fun h=>hsR ((mem_normalizer_iff.mp (ht.2.2 hxT) s).mpr h)
  have hs'2 : orderOf s'=2 := by rw [MulEquiv.orderOf_eq,hs2]
  have hbs : β s'=s := hβα s
  have hcentral (v:G) : v∈centralizer ({s'}:Set G) ↔ β v∈centralizer ({s}:Set G) := by
    simp only [mem_centralizer_singleton_iff]
    constructor
    · intro hv
      have hh := congrArg β hv
      simpa only [map_mul,hbs] using hh
    · intro hv
      apply β.injective
      simpa only [map_mul,hbs] using hv
  have hp := (source_absorbed_sylow_family d hG T hST hsingle hL hM hTM hunique).2.2.2 x hxT hxS
  have hUR : U≤R := le_sup_left.trans hp.1.ge
  have hVR : U.map β.toMonoidHom≤R := le_sup_right.trans hp.1.ge
  have hUK : U⊓centralizer ({s}:Set G)≤K :=
    core_fixed_le_of_delta_and_center d hG T hST hsingle hL hM hTM hunique c hz
      s hs.1 hs2 hsR x hxT hxS hxB u hu K (hZR.trans le_sup_right) (by
        intro r hr hru
        exact (le_sup_left : H≤K) (subset_closure ⟨⟨hUR hr.1,hr.2⟩,hru⟩))
  have hU'K : U⊓centralizer ({s'}:Set G)≤K.comap β.toMonoidHom :=
    core_fixed_le_of_delta_and_center d hG T hST hsingle hL hM hTM hunique c hz
      s' hs'S hs'2 hs'R x hxT hxS hxB u hu (K.comap β.toMonoidHom) (by
        intro z hz
        exact (le_sup_right : Z≤K) ((mem_normalizer_iff.mp (hTNZ (T.inv_mem hxT)) z).mp (hZR hz))) (by
        intro r hr hru
        exact (le_sup_left : H≤K) (subset_closure ⟨⟨hVR (mem_map_of_mem β.toMonoidHom hr.1),(hcentral r).mp hr.2⟩,
          (isConj_iff.mpr ⟨x⁻¹,rfl⟩).symm.trans hru⟩))
  have hIK : I≤K := by
    have hs' : s^2=1 := by simpa only [hs2] using pow_orderOf_eq_one s
    have he : I=(U⊓centralizer ({s}:Set G))⊔(U.map β.toMonoidHom⊓centralizer ({s}:Set G)) :=
      source_noncenterless_inside_fixed_product d hG T hST hsingle hL hM hTM hunique c hz x hxT hxS s hs.1 hs' hsR
    rw [he]
    refine sup_le hUK ?_
    intro r hr
    obtain ⟨v,hv,rfl⟩ := hr.1
    exact hU'K ⟨hv,(hcentral v).mpr hr.2⟩
  have hHnot : ¬IsMulCommutative H := by
    intro hc
    have hHC : H≤centralizer (H:Set G) := le_centralizer_iff_isMulCommutative.mpr hc
    have hZC : Z≤centralizer (Z:Set G) := inf_le_right.trans (centralizer_le inf_le_left)
    have hHZ : H≤centralizer (Z:Set G) := le_centralizer_iff.mpr
      (inf_le_right.trans (centralizer_le hHR))
    have hKC : K≤centralizer (K:Set G) := sup_le
      (le_centralizer_iff.mpr (sup_le hHC (le_centralizer_iff.mp hHZ)))
      (le_centralizer_iff.mpr (sup_le hHZ hZC))
    exact source_noncenterless_inside_fixed_nonabelian d hG T hST hsingle hL hM hTM hunique c s hs.1 hs2 hsR hz
      (le_centralizer_iff_isMulCommutative.mp (hIK.trans (hKC.trans (centralizer_le hIK))))
  by_contra hn
  apply hHnot
  apply isMulCommutative_closure
  intro r hr t ht
  by_contra hrt
  exact hn ⟨r,t,hr.1,ht.1,hr.2,ht.2,hrt⟩
end CFSG.Quasithin.Chapter2.LinearShadows.Single
