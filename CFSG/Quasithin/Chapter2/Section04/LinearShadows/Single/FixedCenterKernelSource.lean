module
public import Theory.GroupAction.BinaryCyclicFixedKernel
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Single.CenterFieldKernelSource

/-!
# The field complement kernel on a fixed center

Let F be the original cyclic complement N_S(B), and let s be its involution.
The pointwise stabilizer in F of C_Z(s), for the literal distinguished
subgroup Z of Notation 2.4.15, is contained in the group generated by s.

The original 2.4.17 kernel C_S(Z) = R and the splitting S = RF make the
F-action faithful. The general binary cyclic-action theorem then gives the
bound directly, using no field coordinates or additional action hypotheses.

Source: Aschbacher–Smith, Chapter 2, Section 4, the cyclic field-complement
fixed-center argument following 2.4.17, printed pp.534–537.
-/

public section
open Subgroup
namespace CFSG.Quasithin.Chapter2.LinearShadows.Single
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}

/-- An element of the original cyclic complement fixing C_Z(s) lies in ⟨s⟩. -/
theorem source_field_fixed_center_centralizer_le_zpowers
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hST : (d.S : Subgroup d.H).map d.H.subtype < (T : Subgroup G))
    (hsingle : d.L0 = d.block) {n : ℕ} (hL : ChapterC.IsL2EvenBlock d.block n)
    (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hunique : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M)
    (c : CyclicTorusSetup d T n) (s : G)
    (hsF : s ∈ (d.S : Subgroup d.H).map d.H.subtype ⊓ normalizer (c.hall : Set G))
    (hs : orderOf s = 2)
    (_hsR : s ∉ Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)) :
    ((d.S : Subgroup d.H).map d.H.subtype ⊓ normalizer (c.hall : Set G)) ⊓
      centralizer ((distinguishedZ d ⊓ centralizer ({s} : Set G) : Subgroup G) : Set G) ≤
        zpowers s := by
  let S := (d.S : Subgroup d.H).map d.H.subtype
  let R := Stellmacher.elementaryAbelianMaxJ S
  let Z := distinguishedZ d
  let F := S ⊓ normalizer (c.hall : Set G)
  have hZ := source_distinguished_elementary d hG T hST hsingle hL hM hTM hunique
  let : IsElementaryAbelian 2 Z := hZ.1
  let : IsCyclic F := c.field_cyclic
  have hFN : F ≤ normalizer (Z : Set G) := inf_le_left.trans hZ.2.2.2
  let ρ := Z.normalizerMonoidHom.comp (inclusion hFN)
  have hρ : Function.Injective ρ := by
    apply ρ.ker_eq_bot_iff.mp
    apply eq_bot_iff.mpr
    intro f hf
    have hfC : (f : G) ∈ centralizer (Z : Set G) := by
      apply mem_centralizer_iff.mpr
      intro z hz
      have he := congrArg Subtype.val (MulEquiv.congr_fun (MonoidHom.mem_ker.mp hf) ⟨z,hz⟩)
      change (f:G) * z * (f:G)⁻¹ = z at he
      exact (mul_inv_eq_iff_eq_mul.mp he).symm
    have hfR : (f : G) ∈ R := by
      have hCS : S ⊓ centralizer (Z : Set G) = R :=
        source_distinguished_sylow_centralizer_eq d hG T hST hsingle hL hM hTM hunique
      exact hCS ▸ (show (f:G) ∈ S ⊓ centralizer (Z : Set G) from ⟨f.property.1,hfC⟩)
    exact Subtype.ext (congrArg (fun x : S => (x:G)) (disjoint_def.mp c.split_sylow.disjoint
      (x := ⟨f,f.property.1⟩) hfR f.property))
  have hF2 : IsPGroup 2 F := T.isPGroup'.to_le (inf_le_left.trans hST.le)
  rintro f ⟨hfF,hfC⟩
  have hf := BinaryCyclicAction.mem_zpowers_of_fixes_involution_fixed ρ hρ hF2
    (⟨s,hsF⟩ : F) (by simpa using hs) (⟨f,hfF⟩ : F) (by
      intro v hv
      have hsfix := congrArg Subtype.val hv
      change s * (v:G) * s⁻¹ = (v:G) at hsfix
      have hvs : (v:G) ∈ centralizer ({s} : Set G) :=
        mem_centralizer_singleton_iff.mpr (mul_inv_eq_iff_eq_mul.mp hsfix).symm
      apply Subtype.ext
      change f * (v:G) * f⁻¹ = (v:G)
      exact mul_inv_eq_iff_eq_mul.mpr ((mem_centralizer_iff.mp hfC) v ⟨v.property,hvs⟩).symm)
  obtain ⟨k,hk⟩ := hf
  exact ⟨k,congrArg Subtype.val hk⟩

end CFSG.Quasithin.Chapter2.LinearShadows.Single
