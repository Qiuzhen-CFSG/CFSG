module
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Single.SingularGeometrySource
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Single.InsideOrthogonalCoordinatesSource
public import Theory.Representation.SL2OrthogonalCover.FixedSingularSpan
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Single.InsideFixedProductSource
/-!
# Element-conjugate generation for an inside involution

For an involution a in S outside R, the fixed vectors in the actual orthogonal
core are generated by fixed singular vectors. The original outside center
identifies those nonzero singular vectors with the ambient conjugacy class of
any prescribed nonidentity z in the distinguished center. Applying this to
the two conjugate cores and correcting products by center coboundaries proves
that C_R(a) is generated by its individual elements conjugate to z.

This is the literal element-generation statement used in the final
nontrivial-center branch of Aschbacher–Smith, Lemma 2.4.21, printed p.536.
-/
public section
open Subgroup
namespace CFSG.Quasithin.Chapter2.LinearShadows.Single
open ChapterC.Section05.ConjugateSource
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}

theorem source_noncenterless_inside_core_fixed_generation
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hST : (d.S : Subgroup d.H).map d.H.subtype < (T : Subgroup G))
    (hsingle : d.L0 = d.block) {n : ℕ} (hL : ChapterC.IsL2EvenBlock d.block n)
    (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hunique : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M)
    (c : CyclicTorusSetup d T n) (hz : center (d.block.map d.H.subtype) ≠ ⊥)
    (a : G) (haS : a∈(d.S : Subgroup d.H).map d.H.subtype) (ha2 : a^2=1)
    (haR : a∉Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype))
    (z : G) (hzZ : z∈distinguishedZ d) (hz1 : z≠1) :
    let U := sourceModule (d.block.map d.H.subtype)
    U ⊓ centralizer ({a} : Set G) ≤ closure {v : G | v∈U ⊓ centralizer ({a} : Set G) ∧ IsConj z v} := by
  let L := d.block.map d.H.subtype
  let U := sourceModule L
  let I := U ⊓ centralizer ({a} : Set G)
  let H := closure {v : G | v∈I ∧ IsConj z v}
  change I ≤ H
  obtain ⟨b,hb,hbval,ho,⟨e⟩⟩ := source_inside_orthogonal_involution_coordinates
    d hG T hST hsingle hL hM hTM hunique hz a haS ha2 haR
  have hcore : (pCore 2 L).map L.subtype=U := by
    rw [source_block_core_eq_module d hG T hST hsingle]
    rfl
  let q : Multiplicative (Representation.SL2OrthogonalCover.Space e.F) →* G :=
    L.subtype.comp ((pCore 2 L).subtype.comp e.core.symm.toMonoidHom)
  have hfix (u : pCore 2 L) : e.actor (e.core u).toAdd=(e.core u).toAdd ↔
      ((u : L) : G)∈centralizer ({a} : Set G) := by
    rw [←e.core_equivariant]
    constructor
    · intro he
      have he' : MulAut.characteristic (pCore 2 L) b u=u := e.core.injective he
      have hv := congrArg (fun t : pCore 2 L => ((t : L) : G)) he'
      change (b u.val : G)=_ at hv
      rw [hbval] at hv
      exact mem_centralizer_singleton_iff.mpr (mul_inv_eq_iff_eq_mul.mp hv).symm
    · intro hu
      apply congrArg (fun t : pCore 2 L => (e.core t).toAdd)
      apply Subtype.ext
      apply Subtype.ext
      change (b u.val : G)=((u : L) : G)
      rw [hbval]
      exact mul_inv_eq_iff_eq_mul.mpr (mem_centralizer_singleton_iff.mp hu).symm
  have hsing (v : Representation.SL2OrthogonalCover.Space e.F)
      (hv : e.actor v=v) (hvf : Representation.SL2OrthogonalCover.form v=0) :
      q (Multiplicative.ofAdd v)∈H := by
    by_cases hv0 : v=0
    · subst v
      change q 1∈H
      rw [map_one]
      exact H.one_mem
    let u := e.core.symm (Multiplicative.ofAdd v)
    have hev : (e.core u).toAdd=v := e.core.apply_symm_apply _
    have huU : ((u : L) : G)∈U := hcore.le (mem_map_of_mem L.subtype u.property)
    have huC : ((u : L) : G)∈centralizer ({a} : Set G) :=
      (hfix u).mp (by rwa [hev])
    have hu1 : u≠1 := by
      intro hh
      apply hv0
      rw [←hev,hh,map_one]
      rfl
    exact subset_closure ⟨⟨huU,huC⟩,source_singular_fused_distinguished
      d hG T hST hsingle hL hM hTM hunique c hz e u (by rwa [hev]) hu1 z hzZ hz1⟩
  have hF : 2<Nat.card e.F := by
    rw [e.card]
    exact lt_of_lt_of_le (by decide : 2<2^2) (Nat.pow_le_pow_right (by decide) hL.1)
  have houter : ¬∃g,MulAut.congr e.quotient (quotientAut (pCore 2 L) b)=MulAut.conj g := by
    rwa [MulAut.congr_inner_iff]
  intro r hr
  obtain ⟨u,hu,hur⟩ := hcore.ge hr.1
  let w : pCore 2 L := ⟨u,hu⟩
  have hw : e.actor (e.core w).toAdd=(e.core w).toAdd :=
    (hfix w).mpr (by change L.subtype u ∈ _;rw [hur];exact hr.2)
  have hh := Representation.SL2OrthogonalCover.outer_fixed_image_mem_of_singular hF
    (MulAut.congr e.quotient (quotientAut (pCore 2 L) b)) e.actor
    e.normalizer_equivariant houter e.actor_involutive q H hsing (e.core w).toAdd hw
  change L.subtype (e.core.symm (e.core w)).val∈H at hh
  rw [e.core.symm_apply_apply] at hh
  exact hur ▸ hh


theorem source_noncenterless_inside_fixed_generation
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hST : (d.S : Subgroup d.H).map d.H.subtype < (T : Subgroup G))
    (hsingle : d.L0 = d.block) {n : ℕ} (hL : ChapterC.IsL2EvenBlock d.block n)
    (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hunique : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M)
    (c : CyclicTorusSetup d T n) (hz : center (d.block.map d.H.subtype) ≠ ⊥)
    (a : G) (haS : a∈(d.S : Subgroup d.H).map d.H.subtype) (ha2 : a^2=1)
    (haR : a∉Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype))
    (z : G) (hzZ : z∈distinguishedZ d) (hz1 : z≠1) :
    let R := Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)
    closure {v : G | v∈R ⊓ centralizer ({a} : Set G) ∧ IsConj z v} =
      R ⊓ centralizer ({a} : Set G) := by
  let S := (d.S : Subgroup d.H).map d.H.subtype
  let R := Stellmacher.elementaryAbelianMaxJ S
  let U := sourceModule (d.block.map d.H.subtype)
  let I := R ⊓ centralizer ({a} : Set G)
  let H := closure {v : G | v∈I ∧ IsConj z v}
  change H = I
  obtain ⟨x,hxT,hxS,_⟩ := c.outside
  let α := MulAut.conj x
  let β := MulAut.conj x⁻¹
  let a' := α a
  have hβα (v : G) : β (α v)=v := by
    change x⁻¹*(x*v*x⁻¹)*(x⁻¹)⁻¹=v
    group
  have hαβ (v : G) : α (β v)=v := by
    change x*(x⁻¹*v*(x⁻¹)⁻¹)*x⁻¹=v
    group
  have ht := d.lemma_2_4_8_1 hG T hST hsingle
    (hL.of_mulEquiv (equivMapOfInjective d.block d.H.subtype d.H.subtype_injective))
  have ha'S : a'∈S := (mem_normalizer_iff.mp (ht.2.1 hxT) a).mp haS
  have ha'R : a'∉R := fun hh => haR ((mem_normalizer_iff.mp (ht.2.2 hxT) a).mpr hh)
  have ha'2 : a'^2=1 := by rw [←map_pow,ha2,map_one]
  have hUR : U ≤ R := le_sup_left.trans
    ((source_absorbed_sylow_family d hG T hST hsingle hL hM hTM hunique).2.2.2 x hxT hxS).1.ge
  have hVR : U.map β.toMonoidHom ≤ R := le_sup_right.trans
    ((source_absorbed_sylow_family d hG T hST hsingle hL hM hTM hunique).2.2.2 x hxT hxS).1.ge
  have hba : β a'=a := hβα a
  have hcentral (v : G) : v∈centralizer ({a'} : Set G) ↔ β v∈centralizer ({a} : Set G) := by
    simp only [mem_centralizer_singleton_iff]
    constructor
    · intro hv
      have hh := congrArg β hv
      simpa only [map_mul,hba] using hh
    · intro hv
      apply β.injective
      simpa only [map_mul,hba] using hv
  apply le_antisymm ((closure_le _).mpr fun v hv => hv.1)
  change I ≤ H
  have hprod : I = (U ⊓ centralizer ({a} : Set G)) ⊔ (U.map β.toMonoidHom ⊓ centralizer ({a} : Set G)) :=
    source_noncenterless_inside_fixed_product d hG T hST hsingle hL hM hTM hunique c hz x hxT hxS a haS ha2 haR
  rw [hprod]
  apply sup_le
  · exact (source_noncenterless_inside_core_fixed_generation d hG T hST hsingle hL hM hTM hunique
      c hz a haS ha2 haR z hzZ hz1).trans (closure_mono fun v hv =>
        ⟨⟨hUR hv.1.1,hv.1.2⟩,hv.2⟩)
  · have hc : closure {v : G | v∈U⊓centralizer ({a'} : Set G) ∧ IsConj z v} ≤ H.comap β.toMonoidHom := by
      apply (closure_le _).mpr
      intro v hv
      exact subset_closure ⟨⟨hVR (mem_map_of_mem β.toMonoidHom hv.1.1),(hcentral v).mp hv.1.2⟩,
        hv.2.trans (isConj_iff.mpr ⟨x⁻¹,rfl⟩)⟩
    intro r hr
    obtain ⟨v,hv,rfl⟩ := hr.1
    exact hc ((source_noncenterless_inside_core_fixed_generation d hG T hST hsingle hL hM hTM hunique
      c hz a' ha'S ha'2 ha'R z hzZ hz1) ⟨hv,(hcentral v).mpr hr.2⟩)
end CFSG.Quasithin.Chapter2.LinearShadows.Single
