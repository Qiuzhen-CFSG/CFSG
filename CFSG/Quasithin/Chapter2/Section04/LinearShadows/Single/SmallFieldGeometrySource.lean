/-!
# The two small-field fixed groups in the original single block

At field degree two, the original outside fixed group has order eight,
a two-element omega subgroup and nontrivial derived subgroup, hence is quaternion.
The field-fixed group is generated by two distinct elementary four-groups;
the actual maximum-elementary family excludes commutativity.
These are the two model inputs for the nonfusion argument on printed p.539
of Aschbacher--Smith, combined manuscript of 1 March 2004.
-/
public section
open Subgroup
namespace CFSG.Quasithin.Chapter2.LinearShadows.Single
open ChapterC.Section05.ConjugateSource
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}
private theorem quaternion_of_card_eight_omega_two (I : Subgroup G)
    (hI : Nat.card I=8) (hω : Nat.card (omegaOneAmbient I)=2)
    (hder : ⁅I,I⁆≠⊥) : Nonempty (I ≃* QuaternionGroup 2) := by
  have htwo : IsPGroup 2 I := (IsPGroup.iff_card).mpr ⟨3,hI⟩
  have hnc : ¬ IsCyclic I := by
    intro hc
    let : IsCyclic I := hc
    apply hder
    exact commutator_eq_bot_iff_le_centralizer.mpr I.le_centralizer
  have hfour (E : Subgroup I) (he : IsElementaryAbelian 2 E) : Nat.card E≠4 := by
    let : IsElementaryAbelian 2 E := he
    let A := E.map I.subtype
    let : IsElementaryAbelian 2 A := IsElementaryAbelian.map I.subtype
    have hA : A≤omegaOneAmbient I := by
      rw [←omegaOneAmbient_eq_self A]
      exact omegaOneAmbient_mono (map_subtype_le E)
    have hh := card_le_of_le hA
    rw [hω,show Nat.card A=Nat.card E from card_map_of_injective I.subtype_injective] at hh
    omega
  obtain ⟨n,hn,⟨e⟩⟩ := (htwo.isCyclic_or_quaternion_of_no_elementary_four hfour).resolve_left hnc
  have hc : 4 * 2^(n-2)=8 := by
    rw [←hI,Nat.card_congr e.toEquiv,Nat.card_eq_fintype_card,QuaternionGroup.card]
  have hp : 2^(n-2)=2^1 := by omega
  have hn3 : n=3 := by
    have he := (Nat.pow_right_injective (by decide : 1<2)) hp
    omega
  subst n
  exact ⟨e⟩

theorem source_centerless_small_field_outside_quaternion
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hST : (d.S : Subgroup d.H).map d.H.subtype < (T : Subgroup G))
    (hsingle : d.L0 = d.block) (hL : ChapterC.IsL2EvenBlock d.block 2)
    (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hu : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M)
    (c : CyclicTorusSetup d T 2) (hZ : center (d.block.map d.H.subtype) = ⊥)
    (i : G) (hiT : i∈T) (hiS : i∉(d.S : Subgroup d.H).map d.H.subtype)
    (hi2 : orderOf i=2)
    (hiZ : i∉centralizer ((Stellmacher.elementaryAbelianMaxJ
      ((d.S : Subgroup d.H).map d.H.subtype) ⊓ centralizer
      (Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype) : Set G)):Set G)) :
    Nonempty ((Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype) ⊓
      centralizer ({i}:Set G) : Subgroup G) ≃* QuaternionGroup 2) := by
  let R := Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)
  let Z := R ⊓ centralizer (R:Set G)
  let I := R ⊓ centralizer ({i}:Set G)
  let Zi := Z ⊓ centralizer ({i}:Set G)
  have hiP : i^2=1 := by simpa only [hi2] using pow_orderOf_eq_one i
  obtain ⟨m,hm,hn,hZi,hI,hder,_⟩ := source_centerless_outside_noncentral_fixed_data
    d hG T hST hsingle hL hM hTM hu c hZ i hiT hiS hiP hiZ
  have hm1 : m=1 := by omega
  subst m
  have hω := source_outside_fixed_omega d hG T hST hsingle hL hM hTM hu i hiT hiS
  change Nat.card Zi=2^1 at hZi
  change Nat.card I=2^(3*1) at hI
  change ⁅I,I⁆=Zi at hder
  change omegaOneAmbient I=Zi at hω
  norm_num only [Nat.reduceMul,Nat.reducePow,pow_one] at hZi hI
  apply quaternion_of_card_eight_omega_two I hI
  · rw [hω]
    exact hZi
  · intro he
    have hh : Nat.card Zi=1 := by rw [←hder,he]; exact card_bot
    omega
theorem source_centerless_small_field_fixed_pair
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hST : (d.S : Subgroup d.H).map d.H.subtype < (T : Subgroup G))
    (hsingle : d.L0 = d.block) (hL : ChapterC.IsL2EvenBlock d.block 2)
    (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hu : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M)
    (c : CyclicTorusSetup d T 2) (hZ : center (d.block.map d.H.subtype) = ⊥)
    (s : T) (hs : (s:G)∈(d.S : Subgroup d.H).map d.H.subtype ⊓ normalizer (c.hall:Set G))
    (hs2 : orderOf s=2)
    (hsR : (s:G)∉Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype))
    (x : G) (hxT : x∈T) (hxS : x∉(d.S : Subgroup d.H).map d.H.subtype)
    (hxs : x∈centralizer ({(s:G)}:Set G)) :
    let R := Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)
    let P := R ⊓ centralizer ({(s:G)}:Set G)
    let A := sourceModule (d.block.map d.H.subtype) ⊓ centralizer ({(s:G)}:Set G)
    let B := A.map (MulAut.conj x⁻¹).toMonoidHom
    Nat.card P=8 ∧ IsKleinFour A ∧ IsKleinFour B ∧ A≠B ∧ A⊔B=P ∧
      ¬IsMulCommutative P := by
  let L := d.block.map d.H.subtype
  let R := Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)
  let Z := R ⊓ centralizer (R:Set G)
  let U := sourceModule L
  let C := centralizer ({(s:G)}:Set G)
  let P := R⊓C
  let A := U⊓C
  let e := MulAut.conj x⁻¹
  let B := A.map e.toMonoidHom
  let V := U.map e.toMonoidHom
  have hC : C.map e.toMonoidHom=C := by
    exact mem_normalizer_iff_map_conj_eq.mp (C.le_normalizer (C.inv_mem hxs))
  have hB : B=V⊓C := by dsimp only [B,A,V]; rw [map_inf _ _ _ e.injective,hC]
  have hgen : R=U⊔V := (source_absorbed_sylow_family d hG T hST hsingle hL hM hTM hu).2.2.2 x hxT hxS |>.1
  have hpair : U⊓V=Z := source_absorbed_center_pair d hG T hST hsingle hL hM hTM hu x hxT hxS
  have hAP : A≤P := le_inf (inf_le_left.trans (le_sup_left.trans_eq hgen.symm)) inf_le_right
  have hBP : B≤P := by rw [hB]; exact le_inf (inf_le_left.trans (le_sup_right.trans_eq hgen.symm)) inf_le_right
  have hK := hL.of_mulEquiv (equivMapOfInjective d.block d.H.subtype d.H.subtype_injective)
  let : IsElementaryAbelian 2 (ChapterC.blockU L) := hK.2.1.elementary
  let : IsElementaryAbelian 2 U := IsElementaryAbelian.map L.subtype
  let : IsElementaryAbelian 2 A := IsElementaryAbelian.of_injective
    (inclusion (show A≤U from inf_le_left)) (inclusion_injective _)
  let : IsElementaryAbelian 2 B := IsElementaryAbelian.map e.toMonoidHom
  obtain ⟨m,hm,hn,hZs,hP⟩ := source_centerless_field_fixed_orders d hG T hST hsingle hL
    hM hTM hu c hZ s hs hs2 hsR
  have hm1 : m=1 := by omega
  subst m
  change Nat.card P=2^(3*1) at hP
  change Nat.card (Z⊓C : Subgroup G)=2^1 at hZs
  have hPc : Nat.card P=8 := by norm_num only [Nat.reduceMul,Nat.reducePow] at hP; exact hP
  have hAc : Nat.card A=4 := source_centerless_field_plane_card d hG T hST hsingle hL
    hM hTM hu c hZ s hs ((orderOf_coe s).trans hs2)
  have hBc : Nat.card B=4 := (card_map_of_injective e.injective).trans hAc
  have hAB : A⊓B=Z⊓C := by
    rw [hB,←hpair]
    ext a
    simp only [A,mem_inf]
    tauto
  have hRU : R≤normalizer (U:Set G) :=
    (source_core_absorption d hG T hST hsingle hL hM hTM hu).1.trans
      (L.le_normalizer.trans (normalizer_le_normalizer_characteristic_image L (ChapterC.blockU L)))
  have hBA : B≤normalizer (A:Set G) :=
    (le_inf (hBP.trans inf_le_left |>.trans hRU) (hBP.trans inf_le_right |>.trans C.le_normalizer)).trans
      inf_normalizer_le_normalizer_inf
  have hprod := card_mul_eq_card_inf_mul_card_sup_of_normalizes A B hBA
  rw [hAc,hBc,hAB,hZs] at hprod
  have hJ : A⊔B=P := eq_of_le_of_card_ge (sup_le hAP hBP) (by rw [hPc]; norm_num at hprod; omega)
  have hne : A≠B := by
    intro he
    have heq : A=P := by simpa only [he,sup_idem] using hJ
    have hh := congrArg (fun D : Subgroup G=>Nat.card D) heq
    omega
  let : Nontrivial A := (Finite.one_lt_card_iff_nontrivial).mp (by omega : 1 < Nat.card A)
  let : Nontrivial B := (Finite.one_lt_card_iff_nontrivial).mp (by omega : 1 < Nat.card B)
  refine ⟨hPc,⟨hAc,IsElementaryAbelian.exponent_eq_prime (p:=2)⟩,
    ⟨hBc,IsElementaryAbelian.exponent_eq_prime (p:=2)⟩,hne,hJ,?_⟩
  intro hc
  let : IsMulCommutative P := hc
  have hcentral : B≤centralizer (A:Set G) := hBP.trans
    (P.le_centralizer.trans (centralizer_le hAP))
  let : IsElementaryAbelian 2 P := hJ ▸ IsElementaryAbelian.sup_of_le_centralizer hcentral
  have hmax := source_field_fixed_maximum_pair d hG T hST hsingle hL hM hTM hu
    (s:G) x hxT hxS hxs
  have hAm : A∈Stellmacher.elementaryAbelianMaxSubgroups P := by
    rw [hmax]
    exact Set.mem_insert _ _
  have hh := hAm.2.2 P le_rfl inferInstance
  rw [hPc,hAc] at hh
  omega
end CFSG.Quasithin.Chapter2.LinearShadows.Single
