module
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Single.SmallFieldSplitSource
public import Theory.GroupTheory.DihedralExchangedFour
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Single.CenterlessCentralizerSource
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Single.Models
public import Theory.GroupTheory.SaturatedCentralizerTransport
/-!
# The original small-field nonfusion conclusion

At degree two the original field-fixed core is generated by two distinct
Klein four-groups exchanged by the source split involution. Its extension is
therefore dihedral of order sixteen, and the field involution centralizer is
C₂ × D₁₆. The original outside fixed group is quaternion of order eight.
Sylow conjugacy transports it into the field centralizer under any proposed
fusion, contradicting the concrete quaternion obstruction.

Source: Aschbacher--Smith, combined manuscript of 1 March 2004, printed p.539.
-/
public section
open Subgroup
namespace CFSG.Quasithin.Chapter2.LinearShadows.Single
open ChapterC.Section05.ConjugateSource
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}
theorem source_centerless_small_field_centralizer_model
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hST : (d.S : Subgroup d.H).map d.H.subtype < (T : Subgroup G))
    (hsingle : d.L0 = d.block) (hL : ChapterC.IsL2EvenBlock d.block 2)
    (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hu : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M)
    (c : CyclicTorusSetup d T 2) (hZ : center (d.block.map d.H.subtype) = ⊥)
    (s : T) (hs : (s:G)∈(d.S : Subgroup d.H).map d.H.subtype ⊓ normalizer (c.hall:Set G))
    (hs2 : orderOf s=2)
    (hsR : (s:G)∉Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype))
    : Nonempty (((T:Subgroup G) ⊓ centralizer ({(s:G)}:Set G) : Subgroup G) ≃*
      Multiplicative (ZMod 2) × DihedralGroup 8) := by
  let S := (d.S : Subgroup d.H).map d.H.subtype
  let R := Stellmacher.elementaryAbelianMaxJ S
  let Ts := (T:Subgroup G) ⊓ centralizer ({(s:G)}:Set G)
  let P := R ⊓ centralizer ({(s:G)}:Set G)
  let A := sourceModule (d.block.map d.H.subtype) ⊓ centralizer ({(s:G)}:Set G)
  obtain ⟨x,hxT,hxS,hx2,hxs,⟨eTs⟩⟩ := source_centerless_small_field_centralizer_split
    d hG T hST hsingle hL hM hTM hu c hZ s hs hs2 hsR
  let B := A.map (MulAut.conj x⁻¹).toMonoidHom
  let J := P ⊔ zpowers x
  obtain ⟨hPc,hA,hB,hne,hgen,hnc⟩ := source_centerless_small_field_fixed_pair
    d hG T hST hsingle hL hM hTM hu c hZ s hs hs2 hsR x hxT hxS hxs
  change Nat.card P=8 at hPc
  change IsKleinFour A at hA
  change IsKleinFour B at hB
  change A≠B at hne
  change A⊔B=P at hgen
  change ¬IsMulCommutative P at hnc
  have hRS : R≤S := sSup_le fun _ h=>h.1
  have hxP : x∉P := fun h=>hxS (hRS h.1)
  have hxpow : x^2=1 := by simpa only [hx2] using pow_orderOf_eq_one x
  have hmap : A.map (MulAut.conj x).toMonoidHom=B := by
    dsimp only [B]
    rw [inv_eq_self_of_orderOf_eq_two hx2]
  let : IsKleinFour A := hA
  let : IsKleinFour B := hB
  obtain ⟨eJ⟩ := DihedralGroup.equiv_of_exchanged_klein_pair P J A B
    hPc hnc (le_sup_left.trans_eq hgen) (le_sup_right.trans_eq hgen) hne hgen
    x hxpow hxP hmap rfl
  exact ⟨eTs.trans (MulEquiv.prodCongr (MulEquiv.refl _) eJ)⟩

theorem source_centerless_small_field_not_conj
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hST : (d.S : Subgroup d.H).map d.H.subtype < (T : Subgroup G))
    (hsingle : d.L0 = d.block) (hL : ChapterC.IsL2EvenBlock d.block 2)
    (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hu : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M)
    (c : CyclicTorusSetup d T 2) (hZ : center (d.block.map d.H.subtype) = ⊥)
    (s : T) (hs : (s:G)∈(d.S : Subgroup d.H).map d.H.subtype ⊓ normalizer (c.hall:Set G))
    (hs2 : orderOf s=2)
    (hsR : (s:G)∉Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype))
    (i : G) (hiT : i∈T) (hiS : i∉(d.S : Subgroup d.H).map d.H.subtype)
    (hi2 : orderOf i=2)
    (hiZ : i∉centralizer ((Stellmacher.elementaryAbelianMaxJ
      ((d.S : Subgroup d.H).map d.H.subtype) ⊓ centralizer
      (Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype) : Set G)):Set G))
    : ¬IsConj i (s:G) := by
  let S := (d.S : Subgroup d.H).map d.H.subtype
  let R := Stellmacher.elementaryAbelianMaxJ S
  let I := R ⊓ centralizer ({i}:Set G)
  let Ts := (T:Subgroup G) ⊓ centralizer ({(s:G)}:Set G)
  have hTsModel := source_centerless_small_field_centralizer_model d hG T hST hsingle hL
    hM hTM hu c hZ s hs hs2 hsR
  have hRT : R≤(T:Subgroup G) := (sSup_le fun _ h=>h.1).trans hST.le
  obtain ⟨eI⟩ := source_centerless_small_field_outside_quaternion d hG T hST hsingle hL
    hM hTM hu c hZ i hiT hiS hi2 hiZ
  obtain ⟨hTsTwo,hTsC,hmax⟩ := Chapter1.isSylowIn_iff.mp
    (source_centerless_field_centralizer_sylow d hG T hST hsingle hL hM hTM hu c hZ s hs hs2 hsR)
  intro his
  obtain ⟨g,_,hgI⟩ := exists_conj_into_saturated_centralizer (s:G) i Ts I hTsTwo
    (T.isPGroup'.to_le (inf_le_left.trans hRT)) hTsC inf_le_right hmax his
  let I' := I.map (MulAut.conj g).toMonoidHom
  let eMap := equivMapOfInjective I (MulAut.conj g).toMonoidHom (MulAut.conj g).injective
  exact false_of_quaternion_centralizer_in_small_field I' Ts hgI
    ⟨eMap.symm.trans eI⟩ hTsModel
end CFSG.Quasithin.Chapter2.LinearShadows.Single
