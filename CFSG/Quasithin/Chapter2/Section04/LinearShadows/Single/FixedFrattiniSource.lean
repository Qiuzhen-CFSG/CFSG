module
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Single.FieldInvolutionGeometrySource
public import Theory.GroupTheory.ElementaryPairQuadratic
public import Theory.Frattini.BinarySquares
/-!
# Frattini bound for the original fixed Thompson supplement

The actual Thompson group is generated by two elementary planes with
central commutators. Its squares therefore lie in its center. Adjoining
a commuting involution preserves this square bound, so the binary Frattini
subgroup of the fixed supplement lies in the fixed center.

Source: Aschbacher–Smith, the single linear block argument, p.539.
-/
public section
open Subgroup
open scoped Pointwise
namespace CFSG.Quasithin.Chapter2.LinearShadows.Single
open ChapterC.Section05.ConjugateSource
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}
theorem source_fixed_central_supplement_frattini_le
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hST : (d.S : Subgroup d.H).map d.H.subtype < (T : Subgroup G))
    (hsingle : d.L0 = d.block) {n : ℕ} (hL : ChapterC.IsL2EvenBlock d.block n)
    (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hu : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M)
    (s : G) (hsT : s∈T) (hs2 : s^2=1) :
    let R := Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)
    let Z := R⊓centralizer (R:Set G)
    let K := (R⊓centralizer ({s}:Set G))⊔zpowers s
    (frattini K).map K.subtype≤Z⊓centralizer ({s}:Set G) := by
  let L := d.block.map d.H.subtype
  let R := Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)
  let Z := R⊓centralizer (R:Set G)
  let U := sourceModule L
  obtain ⟨x,hxT,hxS⟩ := SetLike.exists_of_lt hST
  let V := U.map (MulAut.conj x⁻¹).toMonoidHom
  have hgen : U⊔V=R := (source_absorbed_sylow_family d hG T hST hsingle hL hM hTM hu).2.2.2 x hxT hxS |>.1.symm
  have hRU : R≤normalizer (U:Set G) :=
    (source_core_absorption d hG T hST hsingle hL hM hTM hu).1.trans
      (L.le_normalizer.trans (normalizer_le_normalizer_characteristic_image L (ChapterC.blockU L)))
  have hgeom := source_thompson_root_geometry d hG T hST hsingle hL hM hTM hu
  have hder : ⁅R,R⁆≤Z := hgeom.2.2.1
  have hUQ : U=twoCore d.H := (lemma_2_4_8_2 d hG T hST hsingle hL hM hTM hu).2
  let : IsElementaryAbelian 2 U := hUQ.symm ▸ (d.core_source hG T hST).2.2.2.1
  let : IsElementaryAbelian 2 V := IsElementaryAbelian.map (MulAut.conj x⁻¹).toMonoidHom
  have hN : (Z.subgroupOf R).Normal := normal_subgroupOf_of_le_normalizer
    ((le_centralizer_iff.mp (show Z≤centralizer (R:Set G) from inf_le_right)).trans
      (Subgroup.centralizer_le_normalizer _))
  let := hN
  let : IsElementaryAbelian 2 (R ⧸ Z.subgroupOf R) := elementary_pair_quotient R U V Z hgen hRU hder hN
  have hsq (r:G)(hr:r∈R) : r^2∈Z := by
    have hh := Monoid.exponent_dvd_iff_forall_pow_eq_one.mp
      (IsElementaryAbelian.exponent_dvd_p 2 (R ⧸ Z.subgroupOf R))
      ((QuotientGroup.mk' (Z.subgroupOf R)) ⟨r,hr⟩)
    rw [←map_pow] at hh
    exact (QuotientGroup.eq_one_iff (N:=Z.subgroupOf R) (x:=(⟨r,hr⟩:R)^2)).mp hh
  let C := centralizer ({s}:Set G)
  let Rs := R⊓C
  let K := Rs⊔zpowers s
  have hRK : Rs≤K := le_sup_left
  have hKc : K≤C := sup_le inf_le_right (zpowers_le.mpr (mem_centralizer_singleton_iff.mpr rfl))
  have hKT : K≤(T:Subgroup G) := sup_le
    (inf_le_left.trans ((sSup_le fun _ h=>h.1).trans hST.le)) (zpowers_le.mpr hsT)
  have hKp := T.isPGroup'.to_le hKT
  change (frattini K).map K.subtype≤Z⊓C
  rw [map_le_iff_le_comap,hKp.frattini_eq_closure_squares]
  apply (closure_le _).mpr
  rintro _ ⟨k,rfl⟩
  refine ⟨?_,C.pow_mem (hKc k.property) 2⟩
  have hzC : zpowers s≤centralizer (Rs:Set G) := by
    apply zpowers_le.mpr
    intro r hr
    exact mem_centralizer_singleton_iff.mp hr.2
  have hkprod : (k:G)∈(Rs:Set G)*(zpowers s:Set G) := by
    rw [←coe_mul_of_right_le_normalizer_left Rs (zpowers s)
      (hzC.trans (Subgroup.centralizer_le_normalizer _))]
    exact k.property
  obtain ⟨r,hr,y,hy,he⟩ := hkprod
  have hyr : Commute r y := mem_centralizer_iff.mp (hzC hy) r hr
  have hy2 : y^2=1 := by
    obtain ⟨j,rfl⟩ := hy
    rw [←zpow_natCast,←zpow_mul,Int.mul_comm,zpow_mul,zpow_natCast,hs2,one_zpow]
  change (k:G)^2∈Z
  rw [←he,hyr.mul_pow,hy2,mul_one]
  exact hsq r hr.1
end CFSG.Quasithin.Chapter2.LinearShadows.Single
