module
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Double.BorelSource
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Double.OddNormalizerSource
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Double.FamilySource
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Double.TorusAbelian
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Double.Saturation
public import Theory.GroupTheory.Hall.ConjugateTorusConstruction
/-!
# Hall saturation of the original square torus

The four-member family makes every outside conjugate of the constructed
Borel torus normalize the original core. Odd actors fix both blocks, so
the conjugate normalizes the Borel product. Hall conjugacy produces an
invariant odd Hall group generated by the two tori. Rank-one rigidity on
each factor makes it abelian; its exponent and the full square torus order,
together with the strongly quasithin rank bound, force it to be the
original torus. This gives the literal Frattini factorization in M₀.

Source: Aschbacher--Smith, Section 2.4, printed p.540.
-/
public section
open Subgroup Theory.GroupTheory
open scoped Pointwise
namespace CFSG.Quasithin.Chapter2.LinearDouble
open ChapterC.Section05.ConjugateSource LinearShadows.Double
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}

omit [Finite G] in
private theorem paired_borel_product
    (d : MinimalBlockSetup M) {M₀ : Subgroup G} {n : ℕ}
    (c : DoubleLinearSourceSetup d M₀ n)
    (b : PairedBorelData M ((d.S : Subgroup d.H).map d.H.subtype)
      (Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype))
      (d.block.map d.H.subtype) c.second d.H n)
    (hdec : let R := Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)
      R = ((R ⊓ d.block.map d.H.subtype) ⊔ (R ⊓ c.second)) ⊔
        (R ⊓ centralizer ((d.block.map d.H.subtype ⊔ c.second : Subgroup G) : Set G)))
    (hCQ : let R := Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)
      R ⊓ centralizer ((d.block.map d.H.subtype ⊔ c.second : Subgroup G) : Set G) ≤ twoCore d.H)
    (hQR : twoCore d.H ≤ Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)) :
    Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype) ⊔ b.torus =
      ((M ⊓ d.block.map d.H.subtype) ⊔ (M ⊓ c.second)) ⊔ twoCore d.H := by
  let R := Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)
  change R ⊔ b.torus = _
  change R = _ at hdec
  apply le_antisymm
  · apply sup_le
    · rw [hdec]
      exact sup_le (sup_le
        (((le_sup_left.trans_eq b.first.sylow_sup_torus).trans le_sup_left).trans le_sup_left)
        (((le_sup_left.trans_eq b.second.sylow_sup_torus).trans le_sup_right).trans le_sup_left))
        (hCQ.trans le_sup_right)
    · exact sup_le ((b.first.le_intersection.trans le_sup_left).trans le_sup_left)
        ((b.second.le_intersection.trans le_sup_right).trans le_sup_left)
  · apply sup_le _ (hQR.trans le_sup_left)
    rw [←b.first.sylow_sup_torus,←b.second.sylow_sup_torus]
    exact sup_le (sup_le (inf_le_left.trans le_sup_left) (le_sup_left.trans le_sup_right))
      (sup_le (inf_le_left.trans le_sup_left) (le_sup_right.trans le_sup_right))

/-- The original index-two group is the product of J(S) and the normalizer
of its constructed square torus. All Hall and abelian-product premises are
discharged on the literal paired Borel data. -/
theorem source_torus_frattini
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hu : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M)
    (hST : (d.S : Subgroup d.H).map d.H.subtype < (T : Subgroup G))
    {M₀ : Subgroup G} {n : ℕ} (c : DoubleLinearSourceSetup d M₀ n)
    (hL : ChapterC.IsL2EvenBlock (d.block.map d.H.subtype) n)
    (hSM : (d.S : Subgroup d.H).map d.H.subtype ≤ M₀) (hMT : M₀ ≤ (T : Subgroup G))
    (hi : ((d.S : Subgroup d.H).map d.H.subtype).relIndex M₀ = 2)
    (b : PairedBorelData M ((d.S : Subgroup d.H).map d.H.subtype)
      (Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype))
      (d.block.map d.H.subtype) c.second d.H n) :
    let R := Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)
    (M₀ : Set G) = (R : Set G) * ((M₀ ⊓ normalizer (b.torus : Set G) : Subgroup G) : Set G) := by
  let S := (d.S : Subgroup d.H).map d.H.subtype
  let R := Stellmacher.elementaryAbelianMaxJ S
  let L₁ := d.block.map d.H.subtype
  let D := b.torus
  change S.relIndex M₀ = 2 at hi
  have hRS : R ≤ S := sSup_le fun _ h => h.1
  have hR : IsPGroup 2 R := T.isPGroup'.to_le (hRS.trans hST.le)
  have hMS : M₀ ≤ normalizer (S : Set G) :=
    (normal_subgroupOf_iff_le_normalizer hSM).mp (normal_of_index_eq_two hi)
  have hMR : M₀ ≤ normalizer (R : Set G) := by
    intro x hx
    apply mem_normalizer_iff_map_conj_eq.mpr
    change R.map (MulAut.conj x).toMonoidHom = R
    have hs : S.map (MulAut.conj x).toMonoidHom = S :=
      mem_normalizer_iff_map_conj_eq.mp (hMS hx)
    rw [←Stellmacher.elementaryAbelianMaxJ_map_equiv,hs]
  have hD : IsMulCommutative D := b.abelian
  let := hD
  let : CommGroup D := IsMulCommutative.instCommGroup
  have hInt₁ : D ⊓ L₁ = b.first.torus := b.first_intersection
  have hInt₂ : D ⊓ c.second = b.second.torus := b.second_intersection
  have hDM : D ≤ M := sup_le (b.first.le_intersection.trans inf_le_left)
    (b.second.le_intersection.trans inf_le_left)
  have hDL₀ : D ≤ d.L0.map d.H.subtype := (sup_le_sup
    (b.first.le_intersection.trans inf_le_right) (b.second.le_intersection.trans inf_le_right)).trans_eq c.join
  have hDQ : D ≤ normalizer (twoCore d.H : Set G) :=
    hDL₀.trans ((map_subtype_le _).trans (le_normalizer_twoCore _))
  have hSQ : S ≤ normalizer (twoCore d.H : Set G) := (map_subtype_le _).trans (le_normalizer_twoCore _)
  have hQR : twoCore d.H ≤ R := le_sSup (d.core_source hG T hST).2.2
  have hdec := (source_decomposition d hG T hST c hL hSM hMT hi).1
  have hCQ : R ⊓ centralizer ((L₁ ⊔ c.second : Subgroup G) : Set G) ≤ twoCore d.H := by
    rw [c.join]
    exact (inf_le_inf hRS le_rfl).trans (le_sup_right.trans_eq (d.core_source hG T hST).2.1.symm)
  have hRD := paired_borel_product d c b hdec hCQ hQR
  have hector (x : G) (hx : x ∈ M₀) (hxS : x ∉ S) :
      D.map (MulAut.conj x).toMonoidHom ≤ normalizer (twoCore d.H : Set G) :=
    c.outside_conjugate_le_core_normalizer hi b.normalizes_R hDQ x hx hxS
  have hconj (x : G) (hx : x ∈ M₀) (hxS : x ∉ S) :
      D.map (MulAut.conj x).toMonoidHom ≤ normalizer ((R ⊔ D : Subgroup G) : Set G) := by
    let E := D.map (MulAut.conj x).toMonoidHom
    have hEM : E ≤ M := (map_mono hDM).trans_eq
      (mem_normalizer_iff_map_conj_eq.mp (M.le_normalizer (hTM (hMT hx))))
    have hEQ := hector x hx hxS
    have hoE : Odd (Nat.card E) := by rw [card_map_of_injective (MulAut.conj x).injective]; exact b.odd
    have hEL := odd_coreNormalizer_normalizes_pair d hG T hM hTM hu c hL E hEQ hoE
    rw [hRD]
    apply (le_inf ?_ hEQ).trans (normalizer_inf_normalizer_le_normalizer_sup _ _)
    apply (le_inf ?_ ?_).trans (normalizer_inf_normalizer_le_normalizer_sup _ _)
    · exact (le_inf (hEM.trans M.le_normalizer) (hEL.trans inf_le_left)).trans inf_normalizer_le_normalizer_inf
    · exact (le_inf (hEM.trans M.le_normalizer) (hEL.trans inf_le_right)).trans inf_normalizer_le_normalizer_inf
  have hlt : S < M₀ := lt_of_le_of_ne hSM (by
    intro he
    have hh : S.relIndex M₀ = 1 := relIndex_eq_one.mpr he.ge
    omega)
  obtain ⟨K,B,hDB,hBK,hBodd,_,_,_,hKR,_,hfrat,x,hxM,hxS,hxB,hKE⟩ :=
    OddHall.exists_joint_hall_of_index_two S M₀ R D hlt hi hR hRS hMR
      inferInstance b.odd b.normalizes_R b.sylow_normalizes hconj
  have hp := OddHall.hall_pair_generation R D K B hR hBodd hDB hBK hKR x hxB
    (hconj x hxM hxS) hKE
  have hBQ : B ≤ normalizer (twoCore d.H : Set G) := by
    apply hBK.trans
    rw [hKE]
    exact sup_le (sup_le (hRS.trans hSQ) hDQ) (hector x hxM hxS)
  have hBL := odd_coreNormalizer_normalizes_pair d hG T hM hTM hu c hL B hBQ hBodd
  have hBabel : IsMulCommutative B := by
    apply double_conjugate_torus_abelian_of_intersections L₁ c.second R B D x⁻¹
      hL c.second_type b.first.sylow b.second.sylow b.first.sylow_eq b.second.sylow_eq
      (hBL.trans inf_le_left) (hBL.trans inf_le_right) (hBK.trans hKR) hp.2.1
    · rw [hInt₁,hInt₂]
      rfl
    · simpa only [inv_inv] using hp.1.symm
    · simpa only [inv_inv] using hp.2.2
    · rw [hInt₁]; exact b.first.odd
    · rw [hInt₂]; exact b.second.odd
    · rw [hInt₁]; exact b.first.card
    · rw [hInt₂]; exact b.second.card
  have hQne : twoCore d.H ≠ ⊥ := (d.mem_gammaEvenZero.1.elim (fun h => h.1.1) (fun h => h.1)).1
  have hsq := hG.twoLocal_sqtk (show IsTwoLocal (normalizer (twoCore d.H : Set G)) from
    ⟨twoCore d.H,hQne,isPGroup_pCoreIn 2 d.H,rfl⟩)
  have hoddm : Odd (2^n-1) := by rw [←b.first.card]; exact b.first.odd
  have hsat := eq_conjugate_of_square_torus D x⁻¹ hoddm b.pow_eq_one b.card
    (by rw [inv_inv,←hp.1]; exact hBabel)
    (by
      rw [inv_inv,←hp.1]
      exact hsq.stronglyQuasithin.of_injective (inclusion hBQ) (inclusion_injective hBQ))
  have hBD : B = D := by simpa only [inv_inv,←hp.1] using hsat.1.symm
  simpa only [hBD] using hfrat
end CFSG.Quasithin.Chapter2.LinearDouble
