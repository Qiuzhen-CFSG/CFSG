module
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Double.TorusSource
public import Theory.GroupTheory.DisjointCommutingProduct

/-!
# Outside involutions on the two original Sylow factors

The invariant square torus supplies a direct product of Sylow factors and
normalizes each factor with its chosen outside element. The two core
generators split into their intersections with these factors. An index-two
coset calculation then shows that every outside involution exchanges the
factors, or preserves both and exchanges their two natural modules.

Source: Aschbacher–Smith, proof of 2.4.7, printed p.540.
-/

@[expose] public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter2.LinearDouble
open ChapterC.Section05.ConjugateSource LinearShadows.Double
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}

omit [Finite G] in
private theorem factor_intersection (L₁ L₂ A B : Subgroup G)
    (hd : Disjoint L₁ L₂) (hc : L₁ ≤ centralizer (L₂ : Set G))
    (hA : A ≤ L₁) (hB : B ≤ L₂) : (A ⊔ B) ⊓ L₁ = A := by
  obtain ⟨e,he⟩ := exists_mulEquiv_prod_sup_of_disjoint_of_commuting A B
    (hd.mono hA hB) (hA.trans (hc.trans (centralizer_le hB)))
  apply le_antisymm _ (le_inf le_sup_left hA)
  intro z hz
  let w := e.symm ⟨z,hz.1⟩
  have hw : (w.1 : G) * (w.2 : G) = z :=
    (he w.1 w.2).symm.trans (congrArg Subtype.val (e.apply_symm_apply ⟨z,hz.1⟩))
  have hb : (w.2 : G) ∈ L₁ := by
    have hh := L₁.mul_mem (L₁.inv_mem (hA w.1.property)) hz.2
    rwa [←hw,inv_mul_cancel_left] at hh
  have hb1 : (w.2 : G) = 1 := disjoint_def.mp hd hb (hB w.2.property)
  rw [hb1,mul_one] at hw
  exact hw ▸ w.1.property

omit [Finite G] in
private theorem map_conj_normalizer (P : Subgroup G) {x : G}
    (hx : x ∈ normalizer (P : Set G)) :
    P.map (MulAut.conj x⁻¹).toMonoidHom = P :=
  mem_normalizer_iff_map_conj_eq.mp ((normalizer (P : Set G)).inv_mem hx)

/-- Each Sylow factor is generated by its original and opposite natural modules. -/
theorem SourceTorusData.factor_pairs
    {d : MinimalBlockSetup M} {M₀ : Subgroup G} {n : ℕ}
    {c : DoubleLinearSourceSetup d M₀ n} (td : SourceTorusData c)
    (hi : ((d.S : Subgroup d.H).map d.H.subtype).relIndex M₀ = 2) :
    let R := Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)
    let U₁ := sourceModule (d.block.map d.H.subtype)
    let U₂ := sourceModule c.second
    U₁ ⊔ U₁.map (MulAut.conj td.x⁻¹).toMonoidHom = R ⊓ (d.block.map d.H.subtype) ∧
    U₂ ⊔ U₂.map (MulAut.conj td.x⁻¹).toMonoidHom = R ⊓ c.second := by
  let := c.field₁_field
  let := c.field₂_field
  let S := (d.S : Subgroup d.H).map d.H.subtype
  let R := Stellmacher.elementaryAbelianMaxJ S
  let L₁ := d.block.map d.H.subtype
  let L₂ := c.second
  let U₁ := sourceModule L₁
  let U₂ := sourceModule L₂
  let V₁ := U₁.map (MulAut.conj td.x⁻¹).toMonoidHom
  let V₂ := U₂.map (MulAut.conj td.x⁻¹).toMonoidHom
  have hU₁ : U₁ ≤ R ⊓ L₁ := le_inf
    (c.marked₁.module_le.trans_eq (c.core_span hi).1) (map_subtype_le _)
  have hU₂ : U₂ ≤ R ⊓ L₂ := le_inf
    (c.marked₂.module_le.trans_eq (c.core_span hi).1) (map_subtype_le _)
  have hV₁ : V₁ ≤ R ⊓ L₁ := (map_mono hU₁).trans_eq
    (map_conj_normalizer _ td.geometry.fixes_first_sylow)
  have hV₂ : V₂ ≤ R ⊓ L₂ := (map_mono hU₂).trans_eq
    (map_conj_normalizer _ td.geometry.fixes_second_sylow)
  have hgen : R = (U₁ ⊔ V₁) ⊔ (U₂ ⊔ V₂) := by
    have hh := (c.core_span hi).2
    rw [←td.core_mark,td.geometry.core,Subgroup.map_sup] at hh
    exact hh.trans (by ac_rfl)
  have hc : L₁ ≤ centralizer (L₂ : Set G) := le_centralizer_iff.mp c.commutes
  constructor
  · change U₁ ⊔ V₁ = R ⊓ L₁
    rw [hgen]
    exact (factor_intersection L₁ L₂ _ _ td.geometry.blocks_disjoint hc
      (sup_le (hU₁.trans inf_le_right) (hV₁.trans inf_le_right))
      (sup_le (hU₂.trans inf_le_right) (hV₂.trans inf_le_right))).symm
  · change U₂ ⊔ V₂ = R ⊓ L₂
    rw [hgen,sup_comm (U₁ ⊔ V₁)]
    exact (factor_intersection L₂ L₁ _ _ td.geometry.blocks_disjoint.symm c.commutes
      (sup_le (hU₂.trans inf_le_right) (hV₂.trans inf_le_right))
      (sup_le (hU₁.trans inf_le_right) (hV₁.trans inf_le_right))).symm

omit [Finite G] in
private theorem outside_core_map (S M₀ Q : Subgroup G) (hi : S.relIndex M₀ = 2)
    (hn : S ≤ normalizer (Q : Set G)) (x a : G)
    (hx : x ∈ M₀) (hxS : x ∉ S) (ha : a ∈ M₀) (haS : a ∉ S) :
    Q.conjBy a⁻¹ = Q.conjBy x⁻¹ := by
  have hs : a*x⁻¹ ∈ S := by
    exact (S.subgroupOf M₀).mul_mem_iff_of_index_two hi |>.mpr
      (show (⟨a,ha⟩ : M₀) ∈ S.subgroupOf M₀ ↔
        (⟨x⁻¹,M₀.inv_mem hx⟩ : M₀) ∈ S.subgroupOf M₀ from
          iff_of_false haS (fun hh => hxS (S.inv_mem_iff.mp hh)))
  have he : Q.conjBy (a*x⁻¹)⁻¹ = Q := map_conj_normalizer Q (hn hs)
  have hh := congrArg (fun A : Subgroup G => A.conjBy x⁻¹) he
  simpa only [conjBy_conjBy,mul_inv_rev,inv_inv,←mul_assoc,inv_mul_cancel,one_mul] using hh

/-- Outside involutions either exchange the two Sylow factors, or preserve both
and exchange each natural module with its prescribed opposite. -/
theorem SourceTorusData.outside_action
    {d : MinimalBlockSetup M} {M₀ : Subgroup G} {n : ℕ}
    {c : DoubleLinearSourceSetup d M₀ n} (td : SourceTorusData c)
    (hi : ((d.S : Subgroup d.H).map d.H.subtype).relIndex M₀ = 2)
    (a : G) (ha : a ∈ M₀) (haS : a ∉ (d.S : Subgroup d.H).map d.H.subtype)
    (ha2 : a^2=1) :
    let R := Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype)
    let R₁ := R ⊓ (d.block.map d.H.subtype)
    let R₂ := R ⊓ c.second
    R₁.conjBy a = R₂ ∨
      (R₁.conjBy a = R₁ ∧ R₂.conjBy a = R₂ ∧
        (sourceModule (d.block.map d.H.subtype)).conjBy a =
          (sourceModule (d.block.map d.H.subtype)).map (MulAut.conj td.x⁻¹).toMonoidHom ∧
        (sourceModule c.second).conjBy a =
          (sourceModule c.second).map (MulAut.conj td.x⁻¹).toMonoidHom) := by
  let := c.field₁_field
  let := c.field₂_field
  let S := (d.S : Subgroup d.H).map d.H.subtype
  let R := Stellmacher.elementaryAbelianMaxJ S
  let L₁ := d.block.map d.H.subtype
  let L₂ := c.second
  let R₁ := R ⊓ L₁
  let R₂ := R ⊓ L₂
  let U₁ := sourceModule L₁
  let U₂ := sourceModule L₂
  let V₁ := U₁.map (MulAut.conj td.x⁻¹).toMonoidHom
  let V₂ := U₂.map (MulAut.conj td.x⁻¹).toMonoidHom
  have hai : a⁻¹=a := inv_eq_of_mul_eq_one_left (by simpa only [pow_two] using ha2)
  have hs : a*td.x⁻¹ ∈ S := by
    exact (S.subgroupOf M₀).mul_mem_iff_of_index_two hi |>.mpr
      (show (⟨a,ha⟩ : M₀) ∈ S.subgroupOf M₀ ↔
        (⟨td.x⁻¹,M₀.inv_mem td.x_mem⟩ : M₀) ∈ S.subgroupOf M₀ from
          iff_of_false haS (fun hh => td.x_outside (S.inv_mem_iff.mp hh)))
  have hsR : R.conjBy (a*td.x⁻¹) = R := by
    change R.map (MulAut.conj (a*td.x⁻¹)).toMonoidHom = R
    have he : S.map (MulAut.conj (a*td.x⁻¹)).toMonoidHom = S :=
      mem_normalizer_iff_map_conj_eq.mp (le_normalizer hs)
    rw [←Stellmacher.elementaryAbelianMaxJ_map_equiv,he]
  have hperm₁ : R₁.conjBy a = R₁ ∨ R₁.conjBy a = R₂ := by
    have he : R₁.conjBy a = R₁.conjBy (a*td.x⁻¹) := by
      rw [conjBy_mul,show R₁.conjBy td.x⁻¹ = R₁ from
        map_conj_normalizer R₁ td.geometry.fixes_first_sylow]
    rw [he]
    change (R ⊓ L₁).map _ = R₁ ∨ (R ⊓ L₁).map _ = R₂
    rw [map_inf _ _ _ (MulAut.conj _).injective]
    change R.conjBy _ ⊓ L₁.conjBy _ = R₁ ∨ R.conjBy _ ⊓ L₁.conjBy _ = R₂
    rw [hsR]
    rcases c.permutes _ hs with h|h
    · exact Or.inl (by rw [h])
    · exact Or.inr (by rw [h])
  rcases hperm₁ with h₁|h₁
  swap
  · exact Or.inl h₁
  have h₂ : R₂.conjBy a = R₂ := by
    have he : R₂.conjBy a = R₂.conjBy (a*td.x⁻¹) := by
      rw [conjBy_mul,show R₂.conjBy td.x⁻¹ = R₂ from
        map_conj_normalizer R₂ td.geometry.fixes_second_sylow]
    have hp : R₂.conjBy a = R₂ ∨ R₂.conjBy a = R₁ := by
      rw [he]
      change (R ⊓ L₂).map _ = R₂ ∨ (R ⊓ L₂).map _ = R₁
      rw [map_inf _ _ _ (MulAut.conj _).injective]
      change R.conjBy _ ⊓ L₂.conjBy _ = R₂ ∨ R.conjBy _ ⊓ L₂.conjBy _ = R₁
      rw [hsR]
      rcases c.permutes_second _ hs with h|h
      · exact Or.inl (by rw [h])
      · exact Or.inr (by rw [h])
    rcases hp with h|h
    · exact h
    have heq : R₂=R₁ := by
      have hh := congrArg (fun A : Subgroup G => A.conjBy a⁻¹) (h.trans h₁.symm)
      simpa only [conjBy_inv] using hh
    have hdis : Disjoint R₁ R₂ := td.geometry.disjoint
    rw [heq] at hdis
    exact False.elim (td.geometry.nontrivial_first (disjoint_self.mp hdis))
  have hc : L₁ ≤ centralizer (L₂ : Set G) := le_centralizer_iff.mp c.commutes
  have hU₁ : U₁ ≤ R₁ := le_sup_left.trans_eq (td.factor_pairs hi).1
  have hU₂ : U₂ ≤ R₂ := le_sup_left.trans_eq (td.factor_pairs hi).2
  have hV₁ : V₁ ≤ R₁ := le_sup_right.trans_eq (td.factor_pairs hi).1
  have hV₂ : V₂ ≤ R₂ := le_sup_right.trans_eq (td.factor_pairs hi).2
  have hRcomm : R₁ ≤ centralizer (R₂ : Set G) :=
    inf_le_right.trans (hc.trans (centralizer_le inf_le_right))
  have hQ₁ : twoCore d.H ⊓ R₁ = U₁ := by
    rw [td.geometry.core]
    exact factor_intersection R₁ R₂ _ _ td.geometry.disjoint hRcomm hU₁ hU₂
  have hQ₂ : twoCore d.H ⊓ R₂ = U₂ := by
    rw [td.geometry.core,sup_comm]
    exact factor_intersection R₂ R₁ _ _ td.geometry.disjoint.symm
      (le_centralizer_iff.mp hRcomm) hU₂ hU₁
  have hQx : (twoCore d.H).conjBy a = V₁ ⊔ V₂ := by
    rw [←hai,outside_core_map S M₀ (twoCore d.H) hi
      ((map_subtype_le _).trans (le_normalizer_twoCore _)) td.x a td.x_mem
      td.x_outside ha haS]
    exact congrArg (Subgroup.map (MulAut.conj td.x⁻¹).toMonoidHom) td.geometry.core |>.trans
      (Subgroup.map_sup _ _ _)
  refine Or.inr ⟨h₁,h₂,?_,?_⟩
  · change U₁.conjBy a = V₁
    rw [←hQ₁]
    change (twoCore d.H ⊓ R₁).map _ = V₁
    rw [map_inf _ _ _ (MulAut.conj a).injective]
    change (twoCore d.H).conjBy a ⊓ R₁.conjBy a = V₁
    rw [hQx,h₁]
    exact factor_intersection R₁ R₂ _ _ td.geometry.disjoint hRcomm hV₁ hV₂
  · change U₂.conjBy a = V₂
    rw [←hQ₂]
    change (twoCore d.H ⊓ R₂).map _ = V₂
    rw [map_inf _ _ _ (MulAut.conj a).injective]
    change (twoCore d.H).conjBy a ⊓ R₂.conjBy a = V₂
    rw [hQx,h₂,sup_comm]
    exact factor_intersection R₂ R₁ _ _ td.geometry.disjoint.symm
      (le_centralizer_iff.mp hRcomm) hV₂ hV₁
end CFSG.Quasithin.Chapter2.LinearDouble
