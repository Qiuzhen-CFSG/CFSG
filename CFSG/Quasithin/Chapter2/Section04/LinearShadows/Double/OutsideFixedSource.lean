module
public import CFSG.Quasithin.Chapter2.Section04.LinearShadows.Double.OutsideGeometrySource
public import CFSG.Quasithin.ChapterC.Section05.ConjugateSource.RankOne.PairFixedRank
public import Theory.GroupTheory.DisjointCommutingProduct.FixedRank

/-!
# Fixed rank of the original outside involutions

Each Sylow factor is generated by two natural elementary modules. The
rank-one fixed-point calculation puts every involution in one of those
modules and bounds their intersection by the field degree. An outside
involution exchanging the Sylow factors has its fixed subgroup embedded
in one factor. If it preserves them, its fixed involutions lie in the two
module intersections. Both cases give the bound twice the field degree.

Source: Aschbacher–Smith, proof of 2.4.7, printed p.540.
-/

@[expose] public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter2.LinearDouble
open ChapterC.Section05.ConjugateSource LinearShadows.Double
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}

/-- The fixed-rank estimate for every outside involution of the actual
index-two overgroup, using the constructed invariant square torus. -/
theorem SourceTorusData.outside_fixed_rank
    {d : MinimalBlockSetup M} {M₀ : Subgroup G} {n : ℕ}
    {c : DoubleLinearSourceSetup d M₀ n} (td : SourceTorusData c)
    (hL : ChapterC.IsL2EvenBlock (d.block.map d.H.subtype) n)
    (hi : ((d.S : Subgroup d.H).map d.H.subtype).relIndex M₀ = 2)
    (a : G) (ha : a ∈ M₀) (haS : a ∉ (d.S : Subgroup d.H).map d.H.subtype)
    (ha2 : a^2=1) :
    primeRank 2 (Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype) ⊓
      centralizer ({a} : Set G) : Subgroup G) ≤ 2*n := by
  let := c.field₁_field
  let := c.field₂_field
  let S := (d.S : Subgroup d.H).map d.H.subtype
  let R := Stellmacher.elementaryAbelianMaxJ S
  let L₁ := d.block.map d.H.subtype
  let L₂ := c.second
  let R₁ := R ⊓ L₁
  let R₂ := R ⊓ L₂
  have hBR : RankOne.S S = R := (c.core_span hi).1
  have hp₁ := c.marked₁.pair_fixed_rank hL td.borel.first.sylow td.x
    (by rw [td.borel.first.sylow_eq,hBR]; exact inf_le_left)
    (by rw [td.borel.first.sylow_eq]; exact (td.factor_pairs hi).1)
    (by rw [td.borel.first.sylow_eq]; exact td.geometry.fixes_first_sylow)
    td.geometry.centerless_first td.geometry.core_first
  have hp₂ := c.marked₂.pair_fixed_rank c.second_type td.borel.second.sylow td.x
    (by rw [td.borel.second.sylow_eq,hBR]; exact inf_le_left)
    (by rw [td.borel.second.sylow_eq]; exact (td.factor_pairs hi).2)
    (by rw [td.borel.second.sylow_eq]; exact td.geometry.fixes_second_sylow)
    td.geometry.centerless_second td.geometry.core_second
  rw [td.borel.first.sylow_eq] at hp₁
  rw [td.borel.second.sylow_eq] at hp₂
  have hc : R₁ ≤ centralizer (R₂ : Set G) := inf_le_right.trans
    ((le_centralizer_iff.mp c.commutes).trans (centralizer_le inf_le_right))
  change primeRank 2 (R ⊓ centralizer ({a} : Set G) : Subgroup G) ≤ 2*n
  have hspan : R = R₁ ⊔ R₂ := td.geometry.span
  rw [hspan]
  rcases td.outside_action hi a ha haS ha2 with hswap | ⟨h₁,h₂,hs₁,hs₂⟩
  · exact (primeRank_inf_centralizer_le_of_swap R₁ R₂ td.geometry.disjoint hc
      a ha2 hswap 2).trans hp₁.2.1
  · apply Nat.le_trans (primeRank_inf_centralizer_le_of_preserves R₁ R₂ _ _ _ _
      td.geometry.disjoint hc a ha2 h₁ h₂ hs₁ hs₂ hp₁.1 hp₂.1)
    rw [two_mul]
    dsimp only [RankOne.U,sourceModule] at hp₁ hp₂ ⊢
    exact Nat.add_le_add hp₁.2.2 hp₂.2.2

end CFSG.Quasithin.Chapter2.LinearDouble
namespace CFSG.Quasithin.Chapter2
open LinearDouble
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}

/-- The original hypotheses construct the torus and prove the outside fixed-rank
bound without independent module, product, or fixed-point premises. -/
theorem DoubleLinearSourceSetup.outside_fixed_rank_from_original
    {d : MinimalBlockSetup M} {M₀ : Subgroup G} {n : ℕ}
    (c : DoubleLinearSourceSetup d M₀ n)
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hu : ∀ K : Subgroup G, IsMaximalTwoLocal K → (T : Subgroup G) ≤ K → K = M)
    (hST : (d.S : Subgroup d.H).map d.H.subtype < (T : Subgroup G))
    (hL : ChapterC.IsL2EvenBlock (d.block.map d.H.subtype) n)
    (hSM : (d.S : Subgroup d.H).map d.H.subtype ≤ M₀) (hMT : M₀ ≤ (T : Subgroup G))
    (hi : ((d.S : Subgroup d.H).map d.H.subtype).relIndex M₀ = 2)
    (a : G) (ha : a ∈ M₀) (haS : a ∉ (d.S : Subgroup d.H).map d.H.subtype)
    (ha2 : a^2=1) :
    primeRank 2 (Stellmacher.elementaryAbelianMaxJ ((d.S : Subgroup d.H).map d.H.subtype) ⊓
      centralizer ({a} : Set G) : Subgroup G) ≤ 2*n := by
  obtain ⟨td⟩ := c.torus_data hG T hM hTM hu hST hL hSM hMT hi
  exact td.outside_fixed_rank hL hi a ha haS ha2
end CFSG.Quasithin.Chapter2
