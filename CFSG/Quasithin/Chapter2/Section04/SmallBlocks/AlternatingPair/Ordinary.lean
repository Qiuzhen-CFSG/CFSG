module
public import CFSG.Quasithin.Chapter2.Section04.SmallBlocks.AlternatingPair.InvolutionMarks
public import CFSG.Quasithin.ChapterA.Section03.SQTKStructure.NoncentralFitting.TwoRank
public import Theory.GroupTheory.CComponent.InverterOddCore
public import Theory.GroupTheory.CComponent.PersistentSubgroup
public import Theory.GroupTheory.PrimeRankElementary

/-! The actual C-component containing the paired A₅ block is ordinary.
The faithful sixteen-element module makes its two-core quotient quasisimple.
The original 1.1.5 involution then gives ordinary status or trivial odd core.
In the latter branch, the proved starred persistence theorem in the subgroup
generated by L and a full Sylow subgroup forces centrality of O₂(K), yielding
quasisimplicity. The final export keeps the literal inclusions and original
ModelAction115 actor. Source: Aschbacher–Smith 2.4.25, printed p.542. -/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter2
open ChapterC ChapterC.Section05.ConjugateSource AlternatingFixedPhi
variable {G : Type*} [Group G] [Finite G] {M M₀ : Subgroup G} {d : MinimalBlockSetup M}

theorem AlternatingPairSourceSetup.phi_ordinary_component
    (c : AlternatingPairSourceSetup d M₀)
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hu : ∀ N : Subgroup G, IsMaximalTwoLocal N → (T : Subgroup G) ≤ N → N = M)
    (hST : (d.S : Subgroup d.H).map d.H.subtype ≤ (T : Subgroup G))
    (hSM : (d.S : Subgroup d.H).map d.H.subtype ≤ M₀)
    (hMT : M₀ ≤ (T : Subgroup G))
    (hi : ((d.S : Subgroup d.H).map d.H.subtype).relIndex M₀ = 2) :
    let S := (d.S : Subgroup d.H).map d.H.subtype
    let L := d.block.map d.H.subtype
    let GI := normalizer (Phi S L : Set G)
    ∃ K : Subgroup GI, IsComponent GI K ∧ L.subgroupOf GI ≤ K ∧
      SI S L ≤ normalizer (K.map GI.subtype : Set G) := by
  let S := (d.S : Subgroup d.H).map d.H.subtype
  let L := d.block.map d.H.subtype
  let GI := normalizer (Phi S L : Set G)
  let R := SI S L
  let B := L.subgroupOf GI
  let q := QuotientGroup.mk' (pCore 2 GI)
  have henv := c.phi_normalizer_source hG T hM hTM hu hST hSM hMT hi
  have hLG : L ≤ GI := henv.2.2.2.1.trans (Subgroup.centralizer_le_normalizer _)
  have hRG : R ≤ GI := (normalizer_Phi_eq c.marked₁ c.marked₂).ge.trans inf_le_right
  obtain ⟨K,hK,hBK,hNK⟩ := c.phi_normalized_cComponent hG T hM hTM hu hST hSM hMT hi
  have hlocal := c.stabilizer_local_component
    (c.stabilizer_base hG T hM hTM hu hST hSM hMT hi).2.2.1
  have hBn : ¬ Group.IsSolvable B := by
    intro hh
    let := hh
    exact Chapter1.mem_L_not_isSolvable hlocal (Group.isSolvable_of_surjective
      (f := (subgroupOfEquivOfLe hLG).toMonoidHom) (subgroupOfEquivOfLe hLG).surjective)
  have hd : Disjoint B (pCore 2 GI) := by
    apply disjoint_def.mpr
    intro x hx hq
    exact Subtype.ext (disjoint_def.mp c.block_disjoint_phi_core hx
      (mem_map_of_mem GI.subtype hq))
  have hRn : R.subgroupOf GI ≤ normalizer (K : Set GI) := by
    intro r hr
    apply mem_normalizer_iff.mpr
    intro k
    have hh := mem_normalizer_iff.mp (hNK hr) (k:G)
    change GI.subtype k ∈ K.map GI.subtype ↔
      GI.subtype (r*k*r⁻¹) ∈ K.map GI.subtype at hh
    simpa only [mem_map_iff_mem GI.subtype_injective] using hh
  obtain ⟨hQ,⟨e⟩,_,_,_⟩ := c.phi_quotient_marks hG T hM hTM hu hST hSM hMT hi
  let U := sourceModule L
  let : IsElementaryAbelian 2 U := c.marked₁.block.2.1.elementary.map L.subtype
  have hrU : 2 ≤ primeRank 2 U := by
    by_contra hn
    have hr : primeRank 2 U ≤ 1 := by omega
    have hc := (primeRank_le_iff_elementary_card_le U).mp hr ⊤
      (IsElementaryAbelian.of_injective (⊤ : Subgroup U).subtype (⊤ : Subgroup U).subtype_injective)
    rw [card_top,c.marked₁.module_card] at hc
    norm_num at hc
  let f : U →* K.map q := (inclusion (map_mono hBK)).comp
    (e.toMonoidHom.comp (inclusion (show U ≤ L from map_subtype_le _)))
  have hfi : Function.Injective f := by
    intro u v he
    have hh := congrArg (fun w : K.map q => (w : GI ⧸ pCore 2 GI)) he
    have hh' : e (inclusion (show U ≤ L from map_subtype_le _) u) =
        e (inclusion (show U ≤ L from map_subtype_le _) v) := Subtype.ext hh
    exact inclusion_injective (show U ≤ L from map_subtype_le _) (e.injective hh')
  let : Group.IsNilpotent (pCore 2 GI) := pCore_isNilpotent
  let : IsQuasisimple (K.map q) := ChapterA.Section03.NoncentralFitting.quasisimple_of_two_le_two_rank
    hQ (pCore_quotient_pCore_eq_bot 2) (hK.map_quotient (pCore 2 GI))
    (hrU.trans (_root_.primeRank_le_of_injective 2 f hfi))
  let : IsQuasisimple (K ⧸ pCore 2 K) :=
    IsQuasisimple.of_mulEquiv (cComponentTwoCoreQuotientEquiv hK).symm
  obtain ⟨P,z,h115⟩ := c.phi_involution_marks hG T hM hTM hu hST hSM hMT hi
  let zI : GI := ⟨z,h115.mem_intersection.1⟩
  have hcomp : IsComponent GI K := by
    rcases hK.component_or_oddCore_eq_bot_of_inverter zI (fun b hb =>
        Subtype.ext (h115.central b (mem_map_of_mem GI.subtype
          ((pCore_isPGroup.le_sylow_of_normal P) hb))))
      (fun b hb => Subtype.ext (h115.inverts_oddCore b hb)) with hh|ho
    · exact hh
    apply hK.component_of_persistence_of_oddCore_eq_bot ho hBK hBn hd
      ((c.marked₁.twoGroup.to_le (show R ≤ S from inf_le_left)).comap_subtype) hRn
    intro X hcX PX hRP hgen
    let XA := X.map GI.subtype
    let eX : X ≃* XA := X.equivMapOfInjective GI.subtype GI.subtype_injective
    let PA : Sylow 2 XA := PX.mapSurjective (f:=eX.toMonoidHom) eX.surjective
    have hPA : (PA : Subgroup XA).map XA.subtype =
        ((PX : Subgroup X).map X.subtype).map GI.subtype := by
      ext g
      constructor
      · rintro ⟨v,hv,rfl⟩
        obtain ⟨u,hu,rfl⟩ := hv
        exact mem_map_of_mem GI.subtype (mem_map_of_mem X.subtype hu)
      · rintro ⟨v,⟨u,hu,rfl⟩,rfl⟩
        exact ⟨eX u,mem_map_of_mem eX.toMonoidHom hu,rfl⟩
    have hXA : XA ∈ Chapter1.He G := Chapter1.mem_He_iff.mpr
      ((Theory.Quasithin.centralizer_pCore_le_iff 2 eX).mp hcX)
    have hRPA : R ≤ (PA : Subgroup XA).map XA.subtype := by
      rw [hPA]
      intro r hr
      exact mem_map_of_mem GI.subtype (hRP (show (⟨r,hRG hr⟩:GI)∈R.subgroupOf GI from hr))
    have hgenA : XA = L ⊔ (PA : Subgroup XA).map XA.subtype := by
      rw [hPA,←map_subgroupOf_eq_of_le hLG,←Subgroup.map_sup,←hgen]
    have hLA := c.stabilizer_persistence hG T hM hTM hu hST hSM hMT hi XA hXA PA hRPA hgenA
    have hh := hLA.map_equiv eX.symm
    have he : (L.subgroupOf XA).map eX.symm.toMonoidHom = B.subgroupOf X := by
      ext x
      rw [mem_map_equiv]
      rfl
    exact he ▸ hh
  exact ⟨K,hcomp,hBK,hNK⟩

theorem AlternatingPairSourceSetup.phi_ordinary_component_catalogue
    (c : AlternatingPairSourceSetup d M₀)
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hu : ∀ N : Subgroup G, IsMaximalTwoLocal N → (T : Subgroup G) ≤ N → N = M)
    (hST : (d.S : Subgroup d.H).map d.H.subtype ≤ (T : Subgroup G))
    (hSM : (d.S : Subgroup d.H).map d.H.subtype ≤ M₀)
    (hMT : M₀ ≤ (T : Subgroup G))
    (hi : ((d.S : Subgroup d.H).map d.H.subtype).relIndex M₀ = 2) :
    let S := (d.S : Subgroup d.H).map d.H.subtype
    let L := d.block.map d.H.subtype
    let GI := normalizer (Phi S L : Set G)
    ∃ (K : Subgroup GI) (P : Sylow 2 GI) (z : G),
      IsComponent GI K ∧ L.subgroupOf GI ≤ K ∧
      SI S L ≤ normalizer (K.map GI.subtype : Set G) ∧
      Chapter1.Lemma115Hypotheses GI P M z ∧
      K.map GI.subtype = ⁅K.map GI.subtype,zpowers z⁆ ∧
      ¬ K.map GI.subtype ≤ M ∧ Chapter15.Section03.Candidates.ComponentStructure.HasModelAction115 K z := by
  obtain ⟨K,hK,hLK,hNK⟩ := c.phi_ordinary_component hG T hM hTM hu hST hSM hMT hi
  obtain ⟨P,z,h115⟩ := c.phi_involution_marks hG T hM hTM hu hST hSM hMT hi
  exact ⟨K,P,z,hK,hLK,hNK,h115,
    Chapter1.lemma_1_1_5_three_knownSimple hG _ P M z h115 K hK⟩

end CFSG.Quasithin.Chapter2
