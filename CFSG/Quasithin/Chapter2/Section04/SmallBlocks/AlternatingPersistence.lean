module
public import CFSG.Quasithin.Chapter2.Section04.BlockNormality.SourceRecognition
public import CFSG.Quasithin.Chapter2.Section01To03.LocalStructure.C129Complete
public import CFSG.Quasithin.Chapter1.Section02.LocalComponents.IndexTwoSource

public import CFSG.Quasithin.ChapterA.Section03.SourceEmbeddings.ChiZeroHalfSylow

/-!
# The starred local-persistence claim in the paired A₅ argument

Let R be the original subgroup of index two in the selected Sylow subgroup.
For a local overgroup generated by the original block and a Sylow containing
R, equality of that Sylow with R proves persistence directly. Otherwise the
index and the maximal selected two-part put the overgroup in Γₑ⁰. The source
index-two enclosure theorem places the block inside a C-component, and the
original local recognition makes that component a χ₀ block. Half-Sylow
rigidity proves equality, preserving the actual subgroup inclusions.

Source: Aschbacher–Smith 2.4.25, printed p.542, using 2.4.3(2), 1.2.5 and
2.3.8(4). The argument proves the required persistence without an additional
intrinsic A₅ non-enlargement premise.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter2
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}

omit [Finite G] in
private theorem persistence_card_index {A B : Subgroup G} (h : A ≤ B) :
    Nat.card A * A.relIndex B = Nat.card B := by
  have hc := (A.subgroupOf B).card_mul_index
  rwa [Nat.card_congr (subgroupOfEquivOfLe h).toEquiv] at hc

private theorem persistence_double_card {A B : Subgroup G} (h : A < B) :
    2 * Nat.card A ≤ Nat.card B := by
  have hne : A.relIndex B ≠ 1 := fun he => h.not_ge (relIndex_eq_one.mp he)
  have hn : A.relIndex B ≠ 0 := (A.subgroupOf B).index_ne_zero_of_finite
  have hi : 2 ≤ A.relIndex B := by omega
  calc
    2 * Nat.card A ≤ A.relIndex B * Nat.card A := Nat.mul_le_mul_right _ hi
    _ = Nat.card B := by rw [Nat.mul_comm, persistence_card_index h.le]

/-- The strict-Sylow case in the starred claim of 2.4.25 stays in the
original selected family and retains its actual index-two local base. -/
theorem MinimalBlockSetup.alternating_persistence_selection
    (d : MinimalBlockSetup M) {R X : Subgroup G}
    (hRS : R ≤ (d.S : Subgroup d.H).map d.H.subtype)
    (hi : R.relIndex ((d.S : Subgroup d.H).map d.H.subtype) = 2)
    (hR : R ∈ beta M) (hX : X ∈ Chapter1.He G)
    (P : Sylow 2 X) (hRP : R < (P : Subgroup X).map X.subtype)
    (hLX : d.block.map d.H.subtype ≤ X) :
    X ∈ gammaEvenZero (Chapter1.He G) M ∧
      R.relIndex ((P : Subgroup X).map X.subtype) = 2 ∧
      ((P : Subgroup X).map X.subtype,X) ∈ localPairsIn (Chapter1.He G) M X := by
  have hout : ¬ X ≤ M := fun h => d.outside (hLX.trans h)
  have hcore : twoCore X ≠ ⊥ := by
    intro hz
    change X ⊓ centralizer (twoCore X : Set G) ≤ twoCore X at hX
    rw [hz, centralizer_eq_top_iff_subset.mpr (show (⊥ : Subgroup G) ≤ center G from bot_le), inf_top_eq] at hX
    exact hout (hX.trans bot_le)
  have hpair : (R,X) ∈ localPairsIn (Chapter1.He G) M X :=
    ⟨⟨hR,hX,hcore,hRP.le.trans (map_subtype_le _),hout⟩,le_rfl⟩
  have hgamma : X ∈ gammaEven (Chapter1.He G) M := ⟨⟨hcore,⟨(R,X),hpair⟩⟩,hX⟩
  have hcardS : Nat.card ((d.S : Subgroup d.H).map d.H.subtype) = 2 * Nat.card R := by
    have hh := persistence_card_index hRS
    rw [hi] at hh
    exact hh.symm.trans (Nat.mul_comm _ _)
  have hbound : twoPart d.H ≤ twoPart X := by
    rw [←sylow_image_card d.H d.S,←sylow_image_card X P,hcardS]
    exact persistence_double_card hRP
  obtain ⟨hcard,hsel⟩ := lemma_2_4_3_2 d.mem_gammaEvenZero hgamma hbound
  have hiP : R.relIndex ((P : Subgroup X).map X.subtype) = 2 := by
    have hh := persistence_card_index hRP.le
    rw [sylow_image_card X P,hcard,←sylow_image_card d.H d.S,hcardS] at hh
    have hpos : 0 < Nat.card R := Nat.card_pos
    nlinarith
  have hPb : (P : Subgroup X).map X.subtype ∈ beta M :=
    beta_mono hR hRP.le (P.isPGroup'.map X.subtype)
  exact ⟨hsel,hiP,⟨⟨hPb,hX,hcore,map_subtype_le _,hout⟩,le_rfl⟩⟩

/-- Exact source enclosure before the A₅ non-enlargement step. -/
theorem MinimalBlockSetup.alternating_persistence_enclosure
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hTM : (T : Subgroup G) ≤ M)
    (hu : ∀ N : Subgroup G, IsMaximalTwoLocal N → (T : Subgroup G) ≤ N → N = M)
    {R X : Subgroup G}
    (hRS : R ≤ (d.S : Subgroup d.H).map d.H.subtype)
    (hi : R.relIndex ((d.S : Subgroup d.H).map d.H.subtype) = 2)
    (hR : R ∈ beta M)
    (hL : d.block.map d.H.subtype ∈ Chapter1.L G R)
    (hX : X ∈ Chapter1.He G) (P : Sylow 2 X)
    (hRP : R ≤ (P : Subgroup X).map X.subtype)
    (hgen : X = d.block.map d.H.subtype ⊔ (P : Subgroup X).map X.subtype) :
    ((d.block.map d.H.subtype).subgroupOf X).IsCComponent ∨
      ∃ K : Subgroup X, K.IsCComponent ∧
        (d.block.map d.H.subtype).subgroupOf X ≤ K ∧ ChapterC.IsChiZeroBlock K := by
  have hLX : d.block.map d.H.subtype ≤ X := hgen ▸ le_sup_left
  by_cases he : R = (P : Subgroup X).map X.subtype
  · left
    have h := hL.1
    change ((d.block.map d.H.subtype).subgroupOf (d.block.map d.H.subtype ⊔ R)).IsCComponent at h
    rwa [he,←hgen] at h
  · right
    obtain ⟨hsel,hiP,hpair⟩ := d.alternating_persistence_selection hRS hi hR hX P
      (lt_of_le_of_ne hRP he) hLX
    have hRX : R ≤ X := hRP.trans (map_subtype_le _)
    have hlocal : (d.block.map d.H.subtype).subgroupOf X ∈
        Chapter1.L X (R.subgroupOf X) :=
      (Chapter1.mem_LIn_iff_subgroupOf hRX hLX).mp ⟨hLX,hL⟩
    have hRPin : R.subgroupOf X ≤ (P : Subgroup X) := by
      simpa only [subgroupOf,map_comap_eq_self,comap_map_eq_self_of_injective X.subtype_injective]
        using (comap_mono (f := X.subtype) hRP)
    have hiPin : (R.subgroupOf X).relIndex (P : Subgroup X) ≤ 2 := by
      rw [←relIndex_map_map_of_injective (R.subgroupOf X) (P : Subgroup X) X.subtype_injective,
        map_subgroupOf_eq_of_le hRX,hiP]
    have hXH : X ∈ Chapter1.H G := (hsel.1.elim (fun h => h.1.1) (fun h => h.1)).1
    obtain ⟨K,hK,_⟩ := Chapter1.Section02.index_le_two_local_component_source
      (Chapter1.Section02.uniqueness_local_quotient_sqtk hG hXH) P hRPin hiPin hlocal
    have hout : ¬ K.map X.subtype ≤ M := by
      intro hm
      have hh := (map_mono (f := X.subtype) hK.2).trans hm
      rw [map_subgroupOf_eq_of_le hLX] at hh
      exact d.outside hh
    exact ⟨K,hK.1,hK.2,chiZero_cComponent_of_gammaEvenZero hG localC129Input_knownSimple
      T hTM hu hsel P hpair hK.1 hout⟩
end CFSG.Quasithin.Chapter2

namespace CFSG.Quasithin.Chapter2
open Subgroup Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}

/-- The starred local-persistence claim of original 2.4.25, printed p.542.
The index-two source actor suffices for the χ₀ non-enlargement step. -/
theorem MinimalBlockSetup.alternating_persistence
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hTM : (T : Subgroup G) ≤ M)
    (hu : ∀ N : Subgroup G, IsMaximalTwoLocal N → (T : Subgroup G) ≤ N → N = M)
    {R X : Subgroup G}
    (hRS : R ≤ (d.S : Subgroup d.H).map d.H.subtype)
    (hi : R.relIndex ((d.S : Subgroup d.H).map d.H.subtype) = 2)
    (hR : R ∈ beta M)
    (hL : d.block.map d.H.subtype ∈ Chapter1.L G R)
    (hX : X ∈ Chapter1.He G) (P : Sylow 2 X)
    (hRP : R ≤ (P : Subgroup X).map X.subtype)
    (hgen : X = d.block.map d.H.subtype ⊔ (P : Subgroup X).map X.subtype) :
    ((d.block.map d.H.subtype).subgroupOf X).IsCComponent := by
  obtain h | ⟨K,hK,hLK,hmodel⟩ :=
    d.alternating_persistence_enclosure hG T hTM hu hRS hi hR hL hX P hRP hgen
  · exact h
  have hLX : d.block.map d.H.subtype ≤ X := hgen ▸ le_sup_left
  have hRX : R ≤ X := hRP.trans (map_subtype_le _)
  have hlocal : (d.block.map d.H.subtype).subgroupOf X ∈
      Chapter1.L X (R.subgroupOf X) :=
    (Chapter1.mem_LIn_iff_subgroupOf hRX hLX).mp ⟨hLX,hL⟩
  have hRPin : R.subgroupOf X ≤ (P : Subgroup X) := by
    simpa only [subgroupOf,comap_map_eq_self_of_injective X.subtype_injective]
      using (comap_mono (f := X.subtype) hRP)
  have hiP : R.relIndex ((P : Subgroup X).map X.subtype) ≤ 2 := by
    by_cases he : R = (P : Subgroup X).map X.subtype
    · rw [he,relIndex_self]
      decide
    · exact (d.alternating_persistence_selection hRS hi hR hX P
        (lt_of_le_of_ne hRP he) hLX).2.1.le
  have hiPin : (R.subgroupOf X).relIndex (P : Subgroup X) ≤ 2 := by
    rw [←relIndex_map_map_of_injective (R.subgroupOf X) (P : Subgroup X) X.subtype_injective,
      map_subgroupOf_eq_of_le hRX]
    exact hiP
  have he := ChapterA.Section03.SourceEmbeddings.eq_of_chiZero_containing_component_half_sylow
    P hRPin hiPin hlocal.1 hK hLK hmodel
  exact he.symm ▸ hK
end CFSG.Quasithin.Chapter2
