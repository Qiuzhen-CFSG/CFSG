module
public import CFSG.Quasithin.Chapter2.Section04.SmallBlocks.AlternatingAffineMarkingSource
public import Theory.SpecificGroups.BinaryFiveAffine.SylowInvolutions
/-!
# The selected pair involution in the single alternating-five case

The marked affine model carries the actual Sylow subgroup to its standard
wreath subgroup. Its pair vector selects an involution in the natural module
and the extraspecial Borel core. Its Sylow centralizer is the Thompson
subgroup, whose center is generated by that pair and the central involution.

The latter mark spans the actual extraspecial center and is central in the
ambient Sylow subgroup. Every conclusion uses the same affine equivalence,
so later centralizer and residual calculations retain the natural coordinates.

Source: Aschbacher–Smith (2.4.29), printed p.545.
-/
@[expose] public section
open Subgroup Stellmacher
namespace CFSG.Quasithin.Chapter2
open ChapterC
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}

private theorem embeddedCenter_map {A B : Type*} [Group A] [Group B]
    (U : Subgroup A) (f : A →* B) (hf : Function.Injective f) :
    ((center U).map U.subtype).map f = (center (U.map f)).map (U.map f).subtype := by
  rw [map_map]
  ext b
  constructor
  · rintro ⟨u,hu,rfl⟩
    refine ⟨⟨f u,mem_map_of_mem f u.property⟩,mem_center_iff.mpr ?_,rfl⟩
    rintro ⟨w,⟨v,hv,he⟩⟩
    apply Subtype.ext
    change w*f u=f u*w
    rw [←he,←map_mul,←map_mul]
    exact congrArg (f.comp U.subtype) ((mem_center_iff.mp hu) ⟨v,hv⟩)
  · rintro ⟨w,hw,rfl⟩
    obtain ⟨u,hu,he⟩ := w.property
    refine ⟨⟨u,hu⟩,mem_center_iff.mpr ?_,he⟩
    intro v
    apply Subtype.ext
    apply hf
    have hh := congrArg Subtype.val ((mem_center_iff.mp hw)
      ⟨f v,mem_map_of_mem f v.property⟩)
    change f (v:A)*(w:B)=(w:B)*f (v:A) at hh
    change f ((v:A)*u)=f (u*(v:A))
    simpa only [map_mul,he] using hh

private theorem mappedCentralizer_singleton {A B : Type*} [Group A] [Group B]
    (U : Subgroup A) (f : A →* B) (hf : Function.Injective f) (u:A) :
    (U ⊓ centralizer ({u}:Set A)).map f =
      U.map f ⊓ centralizer ({f u}:Set B) := by
  ext b
  constructor
  · rintro ⟨v,⟨hv,hc⟩,rfl⟩
    refine ⟨mem_map_of_mem f hv,mem_centralizer_singleton_iff.mpr ?_⟩
    simpa only [map_mul] using congrArg f (mem_centralizer_singleton_iff.mp hc)
  · rintro ⟨⟨v,hv,rfl⟩,hc⟩
    refine ⟨v,⟨hv,mem_centralizer_singleton_iff.mpr ?_⟩,rfl⟩
    apply hf
    simpa only [map_mul] using mem_centralizer_singleton_iff.mp hc

theorem MinimalBlockSetup.single_alternating_marked_involutions
    (d : MinimalBlockSetup M) (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (T : Sylow 2 G) (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hu : ∀ N : Subgroup G, IsMaximalTwoLocal N → (T : Subgroup G) ≤ N → N = M)
    (hST : (d.S : Subgroup d.H).map d.H.subtype < (T : Subgroup G))
    (hsingle : d.L0 = d.block)
    (hA : IsAlternatingBlock (d.block.map d.H.subtype) 5)
    (hD : (T : Subgroup G) ⊓ centralizer (d.block.map d.H.subtype : Set G) = ⊥) :
    let B := M ⊓ d.block.map d.H.subtype
    let K := (pResidual 2 B).map B.subtype
    let P := K.pCoreIn 2
    let R := (d.S : Subgroup d.H).map d.H.subtype
    let U := ((blockU d.block).map d.block.subtype).map d.H.subtype
    let J := elementaryAbelianMaxJ R
    let Z := (center P).map P.subtype
    ∃ eH : d.H ≃* BinaryFiveAffine.W,
      ((blockU d.block).map d.block.subtype).map eH.toMonoidHom=BinaryFiveAffine.vectorGroup ∧
      (d.S : Subgroup d.H).map eH.toMonoidHom=(BinaryFiveAffine.standardSylow : Subgroup BinaryFiveAffine.W) ∧
      let u : G := (eH.symm BinaryFiveAffine.t : d.H)
      let s : G := (eH.symm BinaryFiveAffine.standardSwap : d.H)
      let z : G := (eH.symm BinaryFiveAffine.standardZ : d.H)
      u∈U ∧ orderOf u=2 ∧ u∈(center J).map J.subtype ∧ u∉Z ∧
      s∈R ∧ s∉J ∧ R ⊓ centralizer ({u}:Set G)=J ∧
      Z=zpowers z ∧ z=u*s*u*s⁻¹ ∧
      (center J).map J.subtype=zpowers u ⊔ zpowers z ∧
      Z≤(center (T:Subgroup G)).map (T:Subgroup G).subtype ∧
      u∈P ∧ Nat.card (center J)=4 ∧ IsElementaryAbelian 2 (center J) := by
  let B := M ⊓ d.block.map d.H.subtype
  let K := (pResidual 2 B).map B.subtype
  let P := K.pCoreIn 2
  let R := (d.S : Subgroup d.H).map d.H.subtype
  let U := ((blockU d.block).map d.block.subtype).map d.H.subtype
  let J := elementaryAbelianMaxJ R
  let Z := (center P).map P.subtype
  obtain ⟨e,hU,hS⟩ := d.single_alternating_marked_affine_model hG T hM hTM hu hST hsingle hA hD
  let f : BinaryFiveAffine.W →* G := d.H.subtype.comp e.symm.toMonoidHom
  have hf : Function.Injective f := d.H.subtype_injective.comp e.symm.injective
  have hRm : (BinaryFiveAffine.standardSylow:Subgroup BinaryFiveAffine.W).map f=R := by
    change _ = (d.S:Subgroup d.H).map d.H.subtype
    rw [←hS,map_map]
    have hh : f.comp e.toMonoidHom=d.H.subtype := by apply MonoidHom.ext; intro x; simp [f]
    rw [hh]
  have hUm : BinaryFiveAffine.vectorGroup.map f=U := by
    rw [←hU,map_map]
    have hh : f.comp e.toMonoidHom=d.H.subtype := by apply MonoidHom.ext; intro x; simp [f]
    rw [hh]
  have hJm : BinaryFiveAffine.sylowBase.map f=J := by
    rw [←BinaryFiveAffine.thompson_standardSylow,
      ←elementaryAbelianMaxJ_map_injective f hf,hRm]
  have hZRc : Nat.card (center R)=2 := by
    let ee : R ≃* (BinaryFiveAffine.standardSylow:Subgroup BinaryFiveAffine.W) :=
      (MulEquiv.subgroupCongr hRm).symm.trans
        (((BinaryFiveAffine.standardSylow:Subgroup BinaryFiveAffine.W).equivMapOfInjective f hf).symm)
    exact (Nat.card_congr (centerCongr ee).toEquiv).trans BinaryFiveAffine.center_standardSylow_card
  have hZeq : Z=(center R).map R.subtype := by
    have hle : Z≤(center R).map R.subtype := by
      have hh := (d.single_alternating_sylow_geometry hG T hM hTM hu hST hsingle hA).1
      change Z=(frattini R ⊓ center R).map R.subtype at hh
      rw [hh]
      exact map_mono inf_le_right
    apply eq_of_le_of_card_ge hle
    obtain ⟨hp⟩ := d.single_alternating_borel_core_quaternion hG T hST hsingle hA
    rw [card_map_of_injective P.subtype_injective,hp.center_card,
      card_map_of_injective R.subtype_injective,hZRc]
  have hZm : (zpowers BinaryFiveAffine.standardZ).map f=Z := by
    rw [←BinaryFiveAffine.center_standardSylow_eq_zpowers,embeddedCenter_map _ f hf,hRm,←hZeq]
  refine ⟨e,hU,hS,?_,?_,?_,?_,?_,?_,?_,?_,?_,?_,?_,?_,?_,?_⟩
  · change f BinaryFiveAffine.t∈U
    rw [←hUm]
    exact mem_map_of_mem f BinaryFiveAffine.t_mem_vectorGroup
  · change orderOf (f BinaryFiveAffine.t)=2
    rw [orderOf_injective f hf,BinaryFiveAffine.t_order]
  · change f BinaryFiveAffine.t∈(center J).map J.subtype
    rw [←hJm,←embeddedCenter_map _ f hf]
    exact mem_map_of_mem f BinaryFiveAffine.t_mem_center_sylowBase
  · change f BinaryFiveAffine.t∉Z
    rw [←hZm,←BinaryFiveAffine.center_standardSylow_eq_zpowers]
    intro hh
    obtain ⟨v,hv,he⟩ := hh
    exact BinaryFiveAffine.t_not_mem_sylowCenter (hf he ▸ hv)
  · change f BinaryFiveAffine.standardSwap∈R
    rw [←hRm]
    exact mem_map_of_mem f BinaryFiveAffine.standardSwap_mem
  · change f BinaryFiveAffine.standardSwap∉J
    rw [←hJm]
    intro hh
    obtain ⟨v,hv,he⟩ := hh
    exact BinaryFiveAffine.standardSwap_not_mem_base (hf he ▸ hv)
  · change R ⊓ centralizer ({f BinaryFiveAffine.t}:Set G)=J
    rw [←hRm,←mappedCentralizer_singleton _ f hf]
    change ((BinaryFiveAffine.standardSylow:Subgroup BinaryFiveAffine.W) ⊓ BinaryFiveAffine.centralizer).map f=J
    rw [BinaryFiveAffine.standardSylow_centralizer_t,hJm]
  · change Z=zpowers (f BinaryFiveAffine.standardZ)
    rw [←hZm,MonoidHom.map_zpowers]
  · change f BinaryFiveAffine.standardZ=f BinaryFiveAffine.t*f BinaryFiveAffine.standardSwap*
      f BinaryFiveAffine.t*(f BinaryFiveAffine.standardSwap)⁻¹
    exact by simp only [BinaryFiveAffine.standardZ,map_mul,map_inv]
  · change (center J).map J.subtype=zpowers (f BinaryFiveAffine.t) ⊔ zpowers (f BinaryFiveAffine.standardZ)
    rw [←hJm,←embeddedCenter_map _ f hf,BinaryFiveAffine.center_base_eq,Subgroup.map_sup,
      MonoidHom.map_zpowers,MonoidHom.map_zpowers]
  · exact (d.single_alternating_sylow_geometry hG T hM hTM hu hST hsingle hA).2.1
  · change f BinaryFiveAffine.t∈P
    obtain ⟨hPR,hRP⟩ := d.single_borel_core_placement hsingle
    let Q := P.subgroupOf R
    let eQ : Q≃*P := subgroupOfEquivOfLe hPR
    let : Q.Normal := (normal_subgroupOf_iff_le_normalizer hPR).mpr hRP
    obtain ⟨hp⟩ := d.single_alternating_borel_core_quaternion hG T hST hsingle hA
    let hq := hp.map eQ.symm
    let : IsExtraspecial 2 Q := hq.extraspecial
    let er : (BinaryFiveAffine.standardSylow:Subgroup BinaryFiveAffine.W)≃*R :=
      ((BinaryFiveAffine.standardSylow:Subgroup BinaryFiveAffine.W).equivMapOfInjective f hf).trans
        (MulEquiv.subgroupCongr hRm)
    have hr : BinaryFiveAffine.sylowEmbedding BinaryFiveAffine.pairSquareRoot∈
        (BinaryFiveAffine.standardSylow:Subgroup BinaryFiveAffine.W) := ⟨_,rfl⟩
    let x := er ⟨BinaryFiveAffine.sylowEmbedding BinaryFiveAffine.pairSquareRoot,hr⟩
    have hs := BinaryFiveAffine.square_mem_normal_extraspecial_of_equiv er.symm Q hq.card x
    change ((x^2:R):G)∈P at hs
    have he : ((x^2:R):G)=f BinaryFiveAffine.t := by
      change (f (BinaryFiveAffine.sylowEmbedding BinaryFiveAffine.pairSquareRoot))^2=f BinaryFiveAffine.t
      rw [←map_pow,BinaryFiveAffine.pairSquareRoot_square]
    rwa [he] at hs
  · let ej : BinaryFiveAffine.sylowBase≃*J :=
      (BinaryFiveAffine.sylowBase.equivMapOfInjective f hf).trans (MulEquiv.subgroupCongr hJm)
    exact (Nat.card_congr (centerCongr ej).toEquiv).symm.trans BinaryFiveAffine.center_base_card
  · let ej : BinaryFiveAffine.sylowBase≃*J :=
      (BinaryFiveAffine.sylowBase.equivMapOfInjective f hf).trans (MulEquiv.subgroupCongr hJm)
    let : IsElementaryAbelian 2 (center BinaryFiveAffine.sylowBase) := BinaryFiveAffine.center_base_elementary
    exact IsElementaryAbelian.of_injective (centerCongr ej).symm.toMonoidHom (centerCongr ej).symm.injective

end CFSG.Quasithin.Chapter2
