module
public import CFSG.Quasithin.Chapter2.Section04.DoubleA3.CentralProduct
public import CFSG.Quasithin.Chapter2.Section01To03.LocalStructure.Centers
public import CFSG.Quasithin.Chapter1.Section01

/-!
# The original central involution in both fixed-line centralizers

The literal normal two-subgroup generated by each fixed involution and the
original ambient Sylow group satisfy 1.1.6. The product of the two marked
involutions therefore supplies 1.1.5 for both centralizers, with the same
original maximal two-local group and no additional source assumptions.

Source: Aschbacher–Smith, the setup after 2.4.30, printed p.547.
-/

@[expose] public section
open Subgroup Stellmacher
namespace CFSG.Quasithin.Chapter2.DoubleA3
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}

private theorem marked_centralizer_setup
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (T : Sylow 2 G)
    (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hu : ∀ N : Subgroup G, IsMaximalTwoLocal N → (T : Subgroup G) ≤ N → N = M)
    (i : G) (hi : orderOf i = 2) (P : Sylow 2 (centralizer ({i} : Set G)))
    (hPT : (P : Subgroup _).map (centralizer ({i} : Set G)).subtype ≤ (T : Subgroup G))
    (z : G) (hz : orderOf z = 2) (hzT : z ∈ (T : Subgroup G))
    (hc : z ∈ centralizer (T : Set G)) :
    Chapter1.Lemma115Hypotheses (centralizer ({i} : Set G)) P M z := by
  let B := zpowers i
  let C := centralizer ({i} : Set G)
  have hBne : B ≠ ⊥ := zpowers_ne_bot.mpr (by intro he; simp [he] at hi)
  have hB : IsPGroup 2 B := IsPGroup.of_card (n := 1) (by simpa only [B,Nat.card_zpowers,pow_one] using hi)
  have hBC : B ≤ C := zpowers_le.mpr (mem_centralizer_singleton_iff.mpr rfl)
  have hCC : centralizer (B : Set G) = C := by
    change centralizer (zpowers i : Set G) = centralizer ({i} : Set G)
    rw [zpowers_eq_closure,centralizer_closure]
  have hCN : C ≤ normalizer (B : Set G) := hCC ▸ Subgroup.centralizer_le_normalizer _
  have hCM : centralizer ({z} : Set G) ≤ M := by
    apply centralizer_le_of_M_central_involution T hTM hu hz (T.subtype hTM)
    intro t ht
    have htT : t ∈ (T : Subgroup G) := by
      simpa only [Sylow.coe_subtype,map_subgroupOf_eq_of_le hTM] using ht
    exact hc t htT
  exact Chapter1.lemma_1_1_6 hBne hB hBC hCC.le hCN P T hPT hz hzT hc hM hCM
    (fun N hN hTN => Chapter1.mem_He_iff.mpr (hG.evenCharacteristic T N hN hTN))

 theorem SourceCentralizerGeometry.lemma115
    {d : MinimalBlockSetup M} {T : Sylow 2 G} {c : SourcePairCoordinates d T}
    (g : SourceCentralizerGeometry c)
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G) (hM : IsMaximalTwoLocal M)
    (hTM : (T : Subgroup G) ≤ M)
    (hu : ∀ N : Subgroup G, IsMaximalTwoLocal N → (T : Subgroup G) ≤ N → N = M) :
    Chapter1.Lemma115Hypotheses (centralizer ({g.z₁} : Set G)) g.P₁ M (g.z₁*g.z₂) ∧
      Chapter1.Lemma115Hypotheses (centralizer ({g.z₂} : Set G)) g.P₂ M (g.z₁*g.z₂) := by
  have hU₁R : c.U₁ ≤ sourceR d := c.baumann ▸ c.first.module_le
  have hU₂R : c.U₂ ≤ sourceR d := c.baumann ▸ c.second.module_le
  have hRT : sourceR d ≤ (T : Subgroup G) :=
    (sSup_le (fun _ h => h.1)).trans c.original.T_le
  have hzT : g.z₁*g.z₂ ∈ (T : Subgroup G) :=
    (T : Subgroup G).mul_mem (hRT (hU₁R g.first_mem)) (hRT (hU₂R g.second_mem))
  exact ⟨marked_centralizer_setup hG T hM hTM hu g.z₁ g.order_first g.P₁
    (g.first_intersection ▸ inf_le_left) _ g.product_order hzT g.product_centralizes_sylow,
    marked_centralizer_setup hG T hM hTM hu g.z₂ g.order_second g.P₂
    (g.second_intersection ▸ inf_le_left) _ g.product_order hzT g.product_centralizes_sylow⟩
end CFSG.Quasithin.Chapter2.DoubleA3
