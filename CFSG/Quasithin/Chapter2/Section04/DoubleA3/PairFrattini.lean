module
public import CFSG.Quasithin.Chapter2.Section04.DoubleA3.Centralizers
public import Theory.Frattini.BinarySquares

/-!
# The Thompson Frattini subgroup in the paired cubic case

The source product is generated by the two conjugate module pairs and a
central elementary supplement. Squares of each module pair belong to its
common fixed line, so Φ(R) is exactly the join of the two order-two lines.
That join lies in the original module sum and is disjoint from its residual
centralizer. Thus Φ(R) meets Z(H) trivially. Reselecting a paired cubic local
group inside an involution centralizer uses this last identity in source31.

Source: Aschbacher–Smith 2.4.30 and its following paragraph, printed p.547.
-/

@[expose] public section
open Subgroup Stellmacher
open scoped Pointwise
namespace CFSG.Quasithin.Chapter2.DoubleA3
open ChapterC.Section05.BlockAnalysis ChapterC.Section05.ConjugateSource
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}
namespace SourcePairCoordinates
variable {d : MinimalBlockSetup M} {T : Sylow 2 G} (c : SourcePairCoordinates d T)

theorem product :
    twoCore d.H = (c.U₁ ⊔ c.U₂) ⊔ c.D ∧
      sourceR d = ((c.U₁ ⊔ c.V₁) ⊔ (c.U₂ ⊔ c.V₂)) ⊔ c.D ∧
      c.D ≤ centralizer (sourceR d : Set G) ∧ IsElementaryAbelian 2 c.D := by
  let S := (d.S : Subgroup d.H).map d.H.subtype
  let K := d.block.map d.H.subtype
  have hno (W : Subgroup G) (hWR : W ≤ S) (hHW : d.H ≤ normalizer (W : Set G))
      (hMW : (T : Subgroup G) ≤ normalizer (W : Set G)) : W = ⊥ :=
    c.original.no_common_normal W hWR ((normal_subgroupOf_iff_le_normalizer
      (hWR.trans (c.original.R_le_M.trans le_sup_left))).mpr (sup_le hMW hHW))
  have hRK := c.original.R_le_H.trans c.original.normalizes_residual
  have hH : d.H = (K ⊔ c.L) ⊔ S := c.original.residual_sup_sylow.symm
  have ht : ∃ t : (T : Subgroup G), (t : G) ∈ S ∧ K.conjBy (t : G) = c.L :=
    ⟨⟨c.s,c.original.T_le c.s_mem⟩,c.s_mem,c.exchange⟩
  have hp := c.first.two_block_source_product c.second c.commute d.H T S c.original.T_le
    c.original.R_normal hRK hH hno c.x c.x_mem c.index c.pair ht c.noncommuting
  have he := c.first.source_two_block_terminal_equalities c.second c.original.R_twoGroup c.commute
    d.H T S le_rfl c.original.T_le c.original.R_normal hRK hH hno
    c.x c.x_mem c.index c.pair ht c.noncommuting
  have hcore : RankOne.S S ⊓ centralizer ((RankOne.U K ⊔ RankOne.U c.L : Subgroup G) : Set G) = twoCore d.H :=
    he.2.1.symm.trans c.core
  have hD : RankOne.S S ⊓ centralizer ((K ⊔ c.L : Subgroup G) : Set G) = c.D := he.2.2.symm
  dsimp only at hp
  rw [hcore,hD] at hp
  have hspan : sourceR d = ((c.U₁ ⊔ c.V₁) ⊔ (c.U₂ ⊔ c.V₂)) ⊔ c.D := by
    have hh := hp.2.2.1
    change ChapterB.baumann S = _ at hh
    rw [c.baumann,Subgroup.map_sup] at hh
    exact hh.trans (by
      change ((c.U₁ ⊔ c.U₂) ⊔ (c.V₁ ⊔ c.V₂)) ⊔ c.D = _
      ac_rfl)
  have hDe : IsElementaryAbelian 2 c.D := by
    let : IsElementaryAbelian 2 (twoCore d.H) := hp.2.2.2.2.2
    exact IsElementaryAbelian.of_le (hp.1 ▸ (show c.D ≤ (c.U₁ ⊔ c.U₂) ⊔ c.D from le_sup_right))
  have hDC : c.D ≤ centralizer (sourceR d : Set G) := by
    let := hDe
    rw [hspan]
    apply le_centralizer_iff.mpr
    have hU : c.U₁ ⊔ c.U₂ ≤ centralizer (c.D : Set G) :=
      le_centralizer_iff.mp (inf_le_right.trans (centralizer_le (sup_le_sup (map_subtype_le _) (map_subtype_le _))))
    have hV : c.V₁ ⊔ c.V₂ ≤ centralizer (c.D : Set G) := by
      have hh := le_centralizer_iff.mp hp.2.1
      rw [Subgroup.map_sup] at hh
      exact hh
    exact sup_le (sup_le (sup_le (le_sup_left.trans hU) (le_sup_left.trans hV))
      (sup_le (le_sup_right.trans hU) (le_sup_right.trans hV))) (le_centralizer c.D)
  exact ⟨hp.1,hspan,hDC,hDe⟩

 theorem first_commutator : ⁅c.U₁,c.V₁⁆ = c.U₁ ⊓ centralizer (sourceR d : Set G) :=
  (c.first.commutator_eq_fixed (c.original.R_normal c.x_mem) c.noncommuting).2.trans
    c.first_fixed_line.2.1.symm

 theorem second_commutator : ⁅c.U₂,c.V₂⁆ = c.U₂ ⊓ centralizer (sourceR d : Set G) :=
  (c.second.commutator_eq_fixed (c.original.R_normal c.x_mem)
    (RankOne.second_noncommuting c.orbit)).2.trans c.second_fixed_line.2.1.symm

 theorem fixed_lines_le_frattini :
    (c.U₁ ⊓ centralizer (sourceR d : Set G)) ⊔
      (c.U₂ ⊓ centralizer (sourceR d : Set G)) ≤ (frattini (sourceR d)).map (sourceR d).subtype := by
  have hRS : sourceR d ≤ (d.S : Subgroup d.H).map d.H.subtype := sSup_le (fun _ h => h.1)
  let : Fact (IsPGroup 2 (sourceR d)) := ⟨(d.S.isPGroup'.map d.H.subtype).to_le hRS⟩
  have hc : ⁅sourceR d,sourceR d⁆ ≤ (frattini (sourceR d)).map (sourceR d).subtype := by
    have hh := map_mono (commutator_le_frattini_of_isPGroup (R := sourceR d) (p := 2))
      (f := (sourceR d).subtype)
    rwa [commutator_def,map_commutator,←MonoidHom.range_eq_map,range_subtype] at hh
  have hU₁ : c.U₁ ≤ sourceR d := c.baumann ▸ c.first.module_le
  have hU₂ : c.U₂ ≤ sourceR d := c.baumann ▸ c.second.module_le
  have hV₁ : c.V₁ ≤ sourceR d := c.baumann ▸ c.first.conjugate_le (c.original.R_normal c.x_mem)
  have hV₂ : c.V₂ ≤ sourceR d := c.baumann ▸ c.second.conjugate_le (c.original.R_normal c.x_mem)
  rw [←c.first_commutator,←c.second_commutator]
  exact sup_le ((commutator_mono hU₁ hV₁).trans hc) ((commutator_mono hU₂ hV₂).trans hc)

omit [Finite G] in
private theorem square_mem_commutator {A B : Subgroup G}
    [IsElementaryAbelian 2 A] [IsElementaryAbelian 2 B]
    (hAB : A ≤ normalizer (B : Set G)) {x : G} (hx : x ∈ A ⊔ B) :
    x ^ 2 ∈ ⁅A,B⁆ := by
  have hm : x ∈ (A : Set G) * (B : Set G) := by
    rw [←coe_mul_of_left_le_normalizer_right A B hAB]
    exact hx
  obtain ⟨a,ha,b,hb,rfl⟩ := hm
  have ha2 : a * a = 1 := by simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) a ha
  have hb2 : b * b = 1 := by simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) b hb
  have hai : a⁻¹ = a := by
    calc
      a⁻¹ = a⁻¹ * (a*a) := by rw [ha2,mul_one]
      _ = a := inv_mul_cancel_left a a
  have hbi : b⁻¹ = b := by
    calc
      b⁻¹ = b⁻¹ * (b*b) := by rw [hb2,mul_one]
      _ = b := inv_mul_cancel_left b b
  simpa only [commutatorElement_def,hai,hbi,pow_two,mul_assoc] using commutator_mem_commutator ha hb

 theorem frattini_eq_fixed_lines :
    (frattini (sourceR d)).map (sourceR d).subtype =
      (c.U₁ ⊓ centralizer (sourceR d : Set G)) ⊔
        (c.U₂ ⊓ centralizer (sourceR d : Set G)) := by
  apply le_antisymm ?_ c.fixed_lines_le_frattini
  let P := (c.U₁ ⊓ centralizer (sourceR d : Set G)) ⊔
    (c.U₂ ⊓ centralizer (sourceR d : Set G))
  have hRS : sourceR d ≤ (d.S : Subgroup d.H).map d.H.subtype := sSup_le (fun _ h => h.1)
  have hRp : IsPGroup 2 (sourceR d) := (d.S.isPGroup'.map d.H.subtype).to_le hRS
  rw [map_le_iff_le_comap,hRp.frattini_eq_closure_squares]
  apply (closure_le _).mpr
  rintro _ ⟨r,rfl⟩
  change (r : G)^2 ∈ P
  let : IsElementaryAbelian 2 c.U₁ := c.first.elementary
  let : IsElementaryAbelian 2 c.U₂ := c.second.elementary
  let : IsElementaryAbelian 2 c.V₁ := IsElementaryAbelian.map (MulAut.conj c.x⁻¹).toMonoidHom
  let : IsElementaryAbelian 2 c.V₂ := IsElementaryAbelian.map (MulAut.conj c.x⁻¹).toMonoidHom
  let : IsElementaryAbelian 2 c.D := c.product.2.2.2
  let F₁ := c.U₁ ⊔ c.V₁
  let F₂ := c.U₂ ⊔ c.V₂
  have hF₁R : F₁ ≤ sourceR d := c.product.2.1 ▸ (le_sup_left.trans le_sup_left)
  have hF₂R : F₂ ≤ sourceR d := c.product.2.1 ▸ (le_sup_right.trans le_sup_left)
  have hFC : F₁ ≤ centralizer (F₂ : Set G) :=
    commutator_eq_bot_iff_le_centralizer.mp
      (FourModuleOrbit.conjugate_factors_commute c.orbit.toInputs)
  have hFD : F₁ ⊔ F₂ ≤ centralizer (c.D : Set G) :=
    le_centralizer_iff.mp (c.product.2.2.1.trans (centralizer_le (sup_le hF₁R hF₂R)))
  have hr : (r : G) ∈ ((F₁ ⊔ F₂ : Subgroup G) : Set G) * (c.D : Set G) := by
    rw [←coe_mul_of_left_le_normalizer_right _ _ (hFD.trans (Subgroup.centralizer_le_normalizer _))]
    exact c.product.2.1 ▸ r.property
  obtain ⟨q,hq,e,he,hqe⟩ := hr
  have hqecomm : Commute q e := (hFD hq e he).symm
  have hqprod : q ∈ (F₁ : Set G) * (F₂ : Set G) := by
    rw [←coe_mul_of_left_le_normalizer_right _ _ (hFC.trans (Subgroup.centralizer_le_normalizer _))]
    exact hq
  obtain ⟨a,ha,b,hb,hab⟩ := hqprod
  have habcomm : Commute a b := (hFC ha b hb).symm
  rw [←hqe,hqecomm.mul_pow,elemPow_eq_one_of_isElementaryAbelian e he,mul_one,←hab,habcomm.mul_pow]
  have hA : a^2 ∈ c.U₁ ⊓ centralizer (sourceR d : Set G) := by
    rw [←c.first_commutator]
    exact square_mem_commutator (A := c.U₁) (B := c.V₁) (c.first.module_le.trans
      (c.first.conjugate_normalized (c.original.R_normal c.x_mem))) ha
  have hB : b^2 ∈ c.U₂ ⊓ centralizer (sourceR d : Set G) := by
    rw [←c.second_commutator]
    exact square_mem_commutator (A := c.U₂) (B := c.V₂) (c.second.module_le.trans
      (c.second.conjugate_normalized (c.original.R_normal c.x_mem))) hb
  exact P.mul_mem (mem_sup_left hA) (mem_sup_right hB)

omit [Finite G] in
theorem module_join_disjoint_residual_centralizer :
    Disjoint (c.U₁ ⊔ c.U₂) (centralizer ((d.block.map d.H.subtype ⊔ c.L : Subgroup G) : Set G)) := by
  have hcomm : c.U₁ ≤ centralizer (c.U₂ : Set G) := le_centralizer_iff.mp
    ((map_subtype_le _).trans (c.commute.trans (centralizer_le (map_subtype_le _))))
  apply disjoint_def.mpr
  intro u hu huc
  have hprod : u ∈ (c.U₁ : Set G) * (c.U₂ : Set G) := by
    rw [←coe_mul_of_left_le_normalizer_right _ _ (hcomm.trans (Subgroup.centralizer_le_normalizer _))]
    exact hu
  obtain ⟨u₁,hu₁,u₂,hu₂,rfl⟩ := hprod
  have h₂K : u₂ ∈ centralizer (d.block.map d.H.subtype : Set G) := c.commute ((map_subtype_le _) hu₂)
  have h₁K : u₁ ∈ centralizer (d.block.map d.H.subtype : Set G) := by
    have hh := (centralizer (d.block.map d.H.subtype : Set G)).mul_mem
      ((centralizer_le (show d.block.map d.H.subtype ≤ d.block.map d.H.subtype ⊔ c.L from le_sup_left)) huc)
      ((centralizer (d.block.map d.H.subtype : Set G)).inv_mem h₂K)
    simpa only [mul_inv_cancel_right] using hh
  have he₁ : u₁ = 1 := disjoint_def.mp
    (RankOne.cubic_module_disjoint c.cubic_first (centralizer (d.block.map d.H.subtype : Set G)) le_rfl) hu₁ h₁K
  have h₂L : u₂ ∈ centralizer (c.L : Set G) := by
    have hh := (centralizer_le (show c.L ≤ d.block.map d.H.subtype ⊔ c.L from le_sup_right)) huc
    simpa only [he₁,one_mul] using hh
  have he₂ : u₂ = 1 := disjoint_def.mp
    (RankOne.cubic_module_disjoint c.cubic_second (centralizer (c.L : Set G)) le_rfl) hu₂ h₂L
  simp only [he₁,he₂,one_mul]

include c in
/-- The marked Thompson Frattini subgroup contains no nontrivial element
central in the original paired-cubic local group. This is the source31 consumer. -/
theorem frattini_inf_center_eq_bot :
    (frattini (sourceR d)).map (sourceR d).subtype ⊓ (center d.H).map d.H.subtype = ⊥ := by
  have hPhi : (frattini (sourceR d)).map (sourceR d).subtype ≤ c.U₁ ⊔ c.U₂ := by
    rw [c.frattini_eq_fixed_lines]
    exact sup_le_sup inf_le_left inf_le_left
  have hcent : (center d.H).map d.H.subtype ≤
      centralizer ((d.block.map d.H.subtype ⊔ c.L : Subgroup G) : Set G) := by
    rintro _ ⟨a,ha,rfl⟩ b hb
    have hbH : b ∈ d.H := (c.residual ▸ map_subtype_le d.L0) hb
    exact congrArg Subtype.val (mem_center_iff.mp ha ⟨b,hbH⟩)
  exact disjoint_iff.mp (c.module_join_disjoint_residual_centralizer.mono hPhi hcent)

end SourcePairCoordinates

namespace SourceCentralizerGeometry
variable {d : MinimalBlockSetup M} {T : Sylow 2 G} {c : SourcePairCoordinates d T}
    (g : SourceCentralizerGeometry c)

theorem involutions_mem_frattini :
    g.z₁ ∈ (frattini (sourceR d)).map (sourceR d).subtype ∧
      g.z₂ ∈ (frattini (sourceR d)).map (sourceR d).subtype :=
  ⟨c.fixed_lines_le_frattini (mem_sup_left ⟨g.first_mem,g.first_fixed⟩),
   c.fixed_lines_le_frattini (mem_sup_right ⟨g.second_mem,g.second_fixed⟩)⟩

theorem frattini_eq_pair :
    (frattini (sourceR d)).map (sourceR d).subtype = zpowers g.z₁ ⊔ zpowers g.z₂ := by
  have h₁ : zpowers g.z₁ = c.U₁ ⊓ centralizer (sourceR d : Set G) :=
    eq_of_le_of_card_ge (zpowers_le.mpr ⟨g.first_mem,g.first_fixed⟩) (by
      rw [Nat.card_zpowers,g.order_first,c.first_fixed_line.1])
  have h₂ : zpowers g.z₂ = c.U₂ ⊓ centralizer (sourceR d : Set G) :=
    eq_of_le_of_card_ge (zpowers_le.mpr ⟨g.second_mem,g.second_fixed⟩) (by
      rw [Nat.card_zpowers,g.order_second,c.second_fixed_line.1])
  rw [c.frattini_eq_fixed_lines,←h₁,←h₂]
end SourceCentralizerGeometry

end CFSG.Quasithin.Chapter2.DoubleA3
