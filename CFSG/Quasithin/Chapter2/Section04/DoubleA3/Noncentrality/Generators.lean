module
public import CFSG.Quasithin.Chapter2.Section04.DoubleA3.Noncentrality.TwoRank
public import CFSG.Quasithin.Chapter2.Section04.DoubleA3.CoreDihedral

/-!
# The actual generators and marked component Sylow

The rank-four bound removes the residual central factor in the original
Thompson decomposition. Its two dihedral factors lie in the corresponding
components. Thus R lies in their product, the original exchange actor has
square in that product, and the whole generated group is generated by that
product and the two original actors. The first dihedral factor is a Sylow
subgroup of the first PSL₃(2) component; the original fixed involution is a
nontrivial central involution of this literal Sylow subgroup.

These statements retain the chosen original groups and actors and supply the
inputs for the paired-action recognition and its Sylow marking.

Source: Aschbacher–Smith, Lemma 2.4.34, printed p.548, through the original
Sylow and component-product identification.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter2.DoubleA3.Noncentrality
open ChapterC.Section05.ConjugateSource
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}
variable {d : MinimalBlockSetup M} {T : Sylow 2 G}

/-- The Thompson subgroup lies in the component pair, which together with the
original two actors generates the whole source group. -/
theorem source_pair_generators
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hu : ∀ N : Subgroup G, IsMaximalTwoLocal N → (T : Subgroup G) ≤ N → N = M)
    (c : SourcePairCoordinates d T) (g : SourceCentralizerGeometry c)
    (K : Subgroup G) (hK : IsComponentIn K (centralizer ({g.z₂} : Set G)))
    (hE : K = (componentLayer (centralizer ({g.z₂} : Set G))).map
      (centralizer ({g.z₂} : Set G)).subtype)
    (ho : pPrimeCore 2 (centralizer ({g.z₂} : Set G)) = ⊥)
    (hfirst : d.block.map d.H.subtype ≤ K)
    (hmodel : Nonempty (K ≃* alternatingGroup (Fin 6)) ∨ Nonempty (K ≃* Matrix.PSL3Two.PSL))
    (hcomm : c.U₂ ≤ centralizer (K : Set G)) :
    let Ks := K.map (MulAut.conj c.s⁻¹).toMonoidHom
    let J := K ⊔ Ks
    sourceR d ≤ J ∧ c.s ^ 2 ∈ J ∧
      J ⊔ (T : Subgroup G) = (J ⊔ zpowers c.x) ⊔ zpowers c.s ∧
      c.U₁ ⊔ c.V₁ ≤ K ∧ c.U₂ ⊔ c.V₂ ≤ Ks := by
  let Ks := K.map (MulAut.conj c.s⁻¹).toMonoidHom
  let J := K ⊔ Ks
  obtain ⟨_,_,_,_,hxK,hxKs,hsK,_⟩ := source_commuting_components c g K hK hE ho hfirst hmodel hcomm
  obtain ⟨_,_,_,hrank⟩ := source_pair_two_rank hG hu c g K hK hE ho hfirst hmodel hcomm
  have hLs : c.L ≤ Ks := by
    change c.L ≤ K.map (MulAut.conj c.s⁻¹).toMonoidHom
    rw [←hsK,←c.exchange]
    exact map_mono hfirst
  have hUK : c.U₁ ≤ K := (map_subtype_le _).trans hfirst
  have hUsKs : c.U₂ ≤ Ks := (map_subtype_le _).trans hLs
  have hVK : c.V₁ ≤ K := by
    rintro v ⟨u,hu,rfl⟩
    exact ((normalizer (K : Set G)).inv_mem hxK u).mp (hUK hu)
  have hVsKs : c.V₂ ≤ Ks := by
    rintro v ⟨u,hu,rfl⟩
    exact ((normalizer (Ks : Set G)).inv_mem hxKs u).mp (hUsKs hu)
  have hR : sourceR d ≤ J := by
    rw [(c.rank_four_geometry hrank).2.2.1]
    exact sup_le ((sup_le hUK hVK).trans le_sup_left) ((sup_le hUsKs hVsKs).trans le_sup_right)
  refine ⟨hR,hR c.exchange_square_mem,?_,sup_le hUK hVK,sup_le hUsKs hVsKs⟩
  rw [g.sylow_span,←sup_assoc,←sup_assoc,sup_eq_left.mpr hR]


/-- The literal first dihedral factor is a Sylow subgroup of the first
component, with the original involution central in it. -/
theorem source_first_sylow_mark
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hu : ∀ N : Subgroup G, IsMaximalTwoLocal N → (T : Subgroup G) ≤ N → N = M)
    (c : SourcePairCoordinates d T) (g : SourceCentralizerGeometry c)
    (K : Subgroup G) (hK : IsComponentIn K (centralizer ({g.z₂} : Set G)))
    (hE : K = (componentLayer (centralizer ({g.z₂} : Set G))).map
      (centralizer ({g.z₂} : Set G)).subtype)
    (ho : pPrimeCore 2 (centralizer ({g.z₂} : Set G)) = ⊥)
    (hfirst : d.block.map d.H.subtype ≤ K)
    (hmodel : Nonempty (K ≃* alternatingGroup (Fin 6)) ∨ Nonempty (K ≃* Matrix.PSL3Two.PSL))
    (hcomm : c.U₂ ≤ centralizer (K : Set G)) :
    ∃ S : Sylow 2 K,
      (S : Subgroup K).map K.subtype = c.U₁ ⊔ c.V₁ ∧
      (S : Subgroup K).map K.subtype ≤ (T : Subgroup G) ∧
      ∃ z : S, ((z : K) : G) = g.z₁ ∧ z ∈ center S ∧ orderOf z = 2 := by
  obtain ⟨_,⟨eK⟩,_,_⟩ := source_pair_two_rank hG hu c g K hK hE ho hfirst hmodel hcomm
  obtain ⟨_,_,_,hFK,_⟩ := source_pair_generators hG hu c g K hK hE ho hfirst hmodel hcomm
  let F := c.U₁ ⊔ c.V₁
  have hFcard : Nat.card F = 8 := by
    obtain ⟨eF⟩ := c.factors_dihedral.1
    rw [Nat.card_congr eF.toEquiv,DihedralGroup.nat_card]
  have hcard : Nat.card (F.subgroupOf K) = 2 ^ (Nat.card K).factorization 2 := by
    rw [Nat.card_congr (subgroupOfEquivOfLe hFK).toEquiv,hFcard,
      Nat.card_congr eK.toEquiv,Matrix.PSL3Two.card_PSL]
    decide +kernel
  let S := Sylow.ofCard (F.subgroupOf K) hcard
  have hSF : (S : Subgroup K).map K.subtype = F := map_subgroupOf_eq_of_le hFK
  have hFT : F ≤ (T : Subgroup G) := by
    have hUT : c.U₁ ≤ (T : Subgroup G) :=
      (c.first.module_le.trans inf_le_left).trans c.original.T_le
    apply sup_le hUT
    rintro v ⟨u,hu,rfl⟩
    exact ((T : Subgroup G).le_normalizer ((T : Subgroup G).inv_mem c.x_mem) u).mp (hUT hu)
  have hFR : F ≤ sourceR d := c.product.2.1 ▸ (le_sup_left.trans le_sup_left)
  let zK : K := ⟨g.z₁,hFK (mem_sup_left g.first_mem)⟩
  let z : S := ⟨zK,mem_sup_left g.first_mem⟩
  refine ⟨S,hSF,hSF ▸ hFT,z,rfl,?_,?_⟩
  · apply mem_center_iff.mpr
    intro a
    apply Subtype.ext
    apply Subtype.ext
    exact g.first_fixed a (hFR a.property)
  · exact (Subgroup.orderOf_coe z).symm.trans ((Subgroup.orderOf_coe zK).symm.trans g.order_first)

end CFSG.Quasithin.Chapter2.DoubleA3.Noncentrality