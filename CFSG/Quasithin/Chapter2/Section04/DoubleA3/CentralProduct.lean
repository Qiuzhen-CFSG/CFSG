module
public import CFSG.Quasithin.Chapter2.Section04.DoubleA3.PairFrattini

/-!
# The central product involution and Sylow generators

The exchange actor has square in the Thompson subgroup and exchanges the
two fixed involutions. Their product is therefore a central involution of
the original Sylow group, generated by R and the two marked actors.

Source: Aschbacher–Smith, 2.4.30 and the setup preceding 2.4.31,
printed p.547.
-/

@[expose] public section
open Subgroup Stellmacher
namespace CFSG.Quasithin.Chapter2.DoubleA3
open ChapterC.Section05.BlockAnalysis ChapterC.Section05.ConjugateSource
variable {G : Type*} [Group G] [Finite G] {M : Subgroup G}

private theorem index_two_generated (R N : Subgroup G) (hRN : R ≤ N)
    (hi : R.relIndex N = 2) (x : G) (hx : x ∈ N) (hxR : x ∉ R) : N = R ⊔ zpowers x := by
  let P := R ⊔ zpowers x
  have hPN : P ≤ N := sup_le hRN (zpowers_le.mpr hx)
  have hiRP : 2 ≤ R.relIndex P := by
    have hp : 0 < R.relIndex P := Nat.pos_of_ne_zero index_ne_zero_of_finite
    have hn : R.relIndex P ≠ 1 := fun he => hxR (relIndex_eq_one.mp he (mem_sup_right (mem_zpowers x)))
    omega
  have hm := relIndex_mul_relIndex R P N le_sup_left hPN
  rw [hi] at hm
  have hp : 0 < P.relIndex N := Nat.pos_of_ne_zero index_ne_zero_of_finite
  have hPNi : P.relIndex N = 1 := by nlinarith
  exact le_antisymm (relIndex_eq_one.mp hPNi) hPN

namespace SourcePairCoordinates
variable {d : MinimalBlockSetup M} {T : Sylow 2 G} (c : SourcePairCoordinates d T)

include c in
 theorem thompson_index : (sourceR d).relIndex ((d.S : Subgroup d.H).map d.H.subtype) = 2 := by
  have h := ChapterC.Section06.cubic_pair_index_from_original c.original c.first c.second
    c.cubic_first c.cubic_second c.commute c.pair
    ⟨⟨c.s,c.original.T_le c.s_mem⟩,c.s_mem,c.exchange⟩ c.core c.index c.x c.x_mem c.noncommuting
  rw [c.baumann] at h
  exact h.1

 theorem exchange_square_mem : c.s ^ 2 ∈ sourceR d :=
  ((sourceR d).subgroupOf ((d.S : Subgroup d.H).map d.H.subtype)).sq_mem_of_index_two
    c.thompson_index ⟨c.s,c.s_mem⟩

end SourcePairCoordinates
namespace SourceCentralizerGeometry
variable {d : MinimalBlockSetup M} {T : Sylow 2 G} {c : SourcePairCoordinates d T}
    (g : SourceCentralizerGeometry c)

include g in
 theorem sylow_span : (T : Subgroup G) = (sourceR d ⊔ zpowers c.x) ⊔ zpowers c.s := by
  have hsC : c.s ∉ centralizer ({g.z₁} : Set G) := by
    intro hs
    have hh : c.s * g.z₁ * c.s⁻¹ = g.z₁ := by rw [mem_centralizer_singleton_iff.mp hs,mul_inv_cancel_right]
    exact g.distinct (hh.symm.trans g.exchange)
  have hPs : c.s ∉ (g.P₁ : Subgroup _).map (centralizer ({g.z₁} : Set G)).subtype :=
    fun hs => hsC ((map_subtype_le _) hs)
  have hh := index_two_generated _ (T : Subgroup G)
    (g.first_intersection ▸ (show (T : Subgroup G) ⊓ centralizer ({g.z₁} : Set G) ≤ T from inf_le_left))
    g.first_sylow_index c.s (c.original.T_le c.s_mem) hPs
  rwa [g.first_span] at hh

 theorem exchange_second : c.s * g.z₂ * c.s⁻¹ = g.z₁ := by
  rw [←g.exchange]
  calc
    c.s * (c.s * g.z₁ * c.s⁻¹) * c.s⁻¹ = c.s^2 * g.z₁ * (c.s^2)⁻¹ := by simp only [pow_two,mul_inv_rev,mul_assoc]
    _ = g.z₁ := by rw [g.first_fixed (c.s^2) c.exchange_square_mem,mul_inv_cancel_right]

 theorem product_centralizes_sylow : g.z₁ * g.z₂ ∈ centralizer (T : Set G) := by
  have hU₂R : c.U₂ ≤ sourceR d := by
    have h := c.second.module_le
    change c.U₂ ≤ ChapterB.baumann ((d.S : Subgroup d.H).map d.H.subtype) at h
    rwa [c.baumann] at h
  have hz₂R : g.z₂ ∈ sourceR d := hU₂R g.second_mem
  have hc : g.z₂ * g.z₁ = g.z₁ * g.z₂ := g.first_fixed g.z₂ hz₂R
  have hs : c.s ∈ centralizer ({g.z₁*g.z₂} : Set G) := by
    apply mem_centralizer_singleton_iff.mpr
    apply mul_inv_eq_iff_eq_mul.mp
    change (MulAut.conj c.s) (g.z₁*g.z₂) = g.z₁*g.z₂
    rw [map_mul]
    change (c.s*g.z₁*c.s⁻¹)*(c.s*g.z₂*c.s⁻¹)=_
    rw [g.exchange,g.exchange_second,hc]
  have hx : c.x ∈ centralizer ({g.z₁*g.z₂} : Set G) :=
    mem_centralizer_singleton_iff.mpr
      ((show Commute c.x g.z₁ from mem_centralizer_singleton_iff.mp g.x_first).mul_right
        (show Commute c.x g.z₂ from mem_centralizer_singleton_iff.mp g.x_second))
  have hR : sourceR d ≤ centralizer ({g.z₁*g.z₂} : Set G) := by
    intro r hr
    exact mem_centralizer_singleton_iff.mpr
      ((show Commute r g.z₁ from g.first_fixed r hr).mul_right
        (show Commute r g.z₂ from g.second_fixed r hr))
  have hT : (T : Subgroup G) ≤ centralizer ({g.z₁*g.z₂} : Set G) := by
    rw [g.sylow_span]
    exact sup_le (sup_le hR (zpowers_le.mpr hx)) (zpowers_le.mpr hs)
  intro t ht
  exact mem_centralizer_singleton_iff.mp (hT ht)

omit [Finite G] in
 theorem product_order : orderOf (g.z₁ * g.z₂) = 2 := by
  have hU₂R : c.U₂ ≤ sourceR d := by
    have h := c.second.module_le
    change c.U₂ ≤ ChapterB.baumann ((d.S : Subgroup d.H).map d.H.subtype) at h
    rwa [c.baumann] at h
  have hz₂R : g.z₂ ∈ sourceR d := hU₂R g.second_mem
  have hc : Commute g.z₁ g.z₂ := (g.first_fixed g.z₂ hz₂R).symm
  have hz₁2 : g.z₁^2=1 := g.order_first ▸ pow_orderOf_eq_one g.z₁
  have hz₂2 : g.z₂^2=1 := g.order_second ▸ pow_orderOf_eq_one g.z₂
  have hprod : (g.z₁*g.z₂)^2=1 := by rw [hc.mul_pow,hz₁2,hz₂2,one_mul]
  have hne : g.z₁*g.z₂ ≠ 1 := by
    intro he
    apply g.distinct
    have hh := congrArg (fun a : G => a*g.z₂) he
    simpa only [mul_assoc,←pow_two,hz₂2,mul_one,one_mul] using hh
  exact ((Nat.dvd_prime Nat.prime_two).mp (orderOf_dvd_of_pow_eq_one hprod)).resolve_left
    (fun h => hne (orderOf_eq_one_iff.mp h))

end SourceCentralizerGeometry
end CFSG.Quasithin.Chapter2.DoubleA3
