module

public import CFSG.Quasithin.Chapter2.Section05.A6ShadowConstruction.NormalizerGeometry.FourGroupChoice.Square
public import CFSG.Quasithin.Chapter2.Section05.A6ShadowConstruction.NormalizerGeometry.FourGroupChoice.Dihedral

/-!
# The obstruction to crossing-square membership

Source: Aschbacher–Smith, combined manuscript of 1 March 2004, printed
pp.554 and 569–570, the construction following Lemma 2.5.27.

Put `B = S_K S_Kˣ` and `R = ⟨S,x⟩`. The disjoint commuting dihedral factors
have product order 64, so `B` has index two in `S`. Consequently all squares
in `S`, and in particular `x⁴`, belong to `B`. The crossing element normalizes
`B`, `|R| = 256`, and `|R/B| = 4`. If the desired membership `x² ∈ B` fails,
its image has order four and gives an actual isomorphism `R/B ≃ C₄`.

The global largest-pair hypothesis puts `T` in `β(M)`. It also prevents any
characteristic-two overgroup of `N_H(E)` from containing a two-subgroup
properly above `N_S(E)`. These are deductions from the genuine local-family
definitions. The latter result requires `J ∈ He`; it does not supply that
condition for a new normalizer. All normality assertions are relative.

The final order calculation is also equivalent to square membership:
`|⟨B,x⟩| = 128` holds exactly when `x² ∈ B`; otherwise this generated
subgroup is all of `R`, of order 256.

This module does not exclude the cyclic quotient from `Setup` alone. The
descendant `SquareMembership.Fusion` supplies a source route using the omitted
full-centralizer input `C_G(t) ≤ H` from 2.5.22(2) and concrete A₆ identities. The root `FourGroupChoice` module is intentionally
not imported, so it can later consume the completed square argument.
-/

namespace CFSG.Quasithin.Chapter2.A6ShadowConstruction.SquareMembership
open Subgroup
variable {G : Type*} [Group G] [Finite G]

/-- The product of the two commuting inner Sylow factors. -/
@[expose] public def base (d : Setup G) : Subgroup G := d.sk ⊔ conjugate d.x d.sk
/-- The two-group generated by the source Sylow subgroup and the crossing element. -/
@[expose] public def crossing (d : Setup G) : Subgroup G := d.S ⊔ zpowers d.x

omit [Finite G] in
/-- Both inner factors lie in the source Sylow subgroup. -/
public theorem base_le_s (d : Setup G) : base d ≤ d.S :=
  sup_le inf_le_left (CoreReduction.conjugate_le d inf_le_left)

/-- Disjointness and the proved dihedral model give product order 64. -/
public theorem base_card (d : Setup G) : Nat.card (base d) = 64 := by
  have hc : Nat.card (conjugate d.x d.sk) = 8 := by
    unfold conjugate
    rw [MulEquiv.toMonoidHom_eq_coe,
      ← Nat.card_congr ((MulAut.conj d.x⁻¹).subgroupMap d.sk).toEquiv]
    exact d.sk_card
  obtain ⟨f, _⟩ := exists_mulEquiv_prod_sup_of_disjoint_of_commuting d.sk
    (conjugate d.x d.sk) d.disjoint_sk_conjugate d.sk_centralizes_conjugate
  change Nat.card (d.sk ⊔ conjugate d.x d.sk : Subgroup G) = 64
  rw [← Nat.card_congr f.toEquiv, Nat.card_prod, d.sk_card, hc]

/-- The factor product has index two in the source Sylow subgroup. -/
public theorem base_index (d : Setup G) (r : CoreReduction d) :
    ((base d).subgroupOf d.S).index = 2 := by
  have h := ((base d).subgroupOf d.S).card_mul_index
  rw [Nat.card_congr (subgroupOfEquivOfLe (base_le_s d)).toEquiv,
    base_card, r.card_s] at h
  omega

/-- Every square in `S` lies in the factor product. -/
public theorem s_squares (d : Setup G) (r : CoreReduction d) {s : G} (hs : s ∈ d.S) :
    s ^ 2 ∈ base d :=
  sq_mem_of_index_two (base_index d r) (⟨s, hs⟩ : d.S)

/-- The fourth power lies in the factor product; this does not prove the square does. -/
public theorem crossing_fourth (d : Setup G) (r : CoreReduction d) : d.x ^ 4 ∈ base d := by
  simpa only [← pow_mul] using s_squares d r d.square_mem

omit [Finite G] in
/-- The generated crossing group lies in the given ambient two-group. -/
public theorem crossing_le_t (d : Setup G) : crossing d ≤ d.T :=
  sup_le d.s_le_t (zpowers_le.mpr d.x_mem)

/-- The specified crossing element, regarded as an element of `⟨S,x⟩`. -/
@[expose] public def crossingElement (d : Setup G) : crossing d := ⟨d.x, mem_sup_right (mem_zpowers _)⟩

omit [Finite G] in
/-- Normality of `S` is relative to the crossing group. -/
public theorem normal_s (d : Setup G) : (d.S.subgroupOf (crossing d)).Normal := by
  apply (normal_subgroupOf_iff_le_normalizer (show d.S ≤ crossing d from le_sup_left)).mpr
  exact sup_le d.S.le_normalizer (zpowers_le.mpr d.x_normalizes)

/-- Normality of the factor product is relative to the crossing group. -/
public theorem normal_base (d : Setup G) (r : CoreReduction d) :
    ((base d).subgroupOf (crossing d)).Normal := by
  apply (normal_subgroupOf_iff_le_normalizer ((base_le_s d).trans le_sup_left)).mpr
  have hS : d.S ≤ normalizer (base d : Set G) :=
    (normal_subgroupOf_iff_le_normalizer (base_le_s d)).mp
      (normal_of_index_eq_two (base_index d r))
  exact sup_le hS (zpowers_le.mpr d.crossing_normalizes_factor_product)

omit [Finite G] in
private theorem adjoin_index_two (U : Subgroup G) (x : G)
    (hn : x ∈ normalizer (U : Set G)) (hout : x ∉ U) (hsq : x ^ 2 ∈ U) :
    (U.subgroupOf (U ⊔ zpowers x)).index = 2 := by
  let R := U ⊔ zpowers x
  let N := U.subgroupOf R
  let y : R := ⟨x, mem_sup_right (mem_zpowers x)⟩
  let : N.Normal := (normal_subgroupOf_iff_le_normalizer (show U ≤ R from le_sup_left)).mpr
    (sup_le U.le_normalizer (zpowers_le.mpr hn))
  let q := QuotientGroup.mk' N
  have hy2 : (q y) ^ 2 = 1 := by
    rw [← map_pow]
    exact (QuotientGroup.eq_one_iff _).mpr hsq
  have hy1 : q y ≠ 1 := fun h => hout ((QuotientGroup.eq_one_iff y).mp h)
  have hord : orderOf (q y) = 2 := orderOf_eq_prime hy2 hy1
  have hgen : N ⊔ zpowers y = ⊤ := by
    apply map_injective R.subtype_injective
    rw [Subgroup.map_sup, subgroupOf_map_subtype,
      inf_eq_left.mpr (show U ≤ R from le_sup_left), MonoidHom.map_zpowers,
      ← MonoidHom.range_eq_map, range_subtype]
    rfl
  have hqgen : zpowers (q y) = ⊤ := by
    have h := congrArg (fun J : Subgroup R => J.map q) hgen
    rw [Subgroup.map_sup, MonoidHom.map_zpowers, ← MonoidHom.range_eq_map,
      QuotientGroup.range_mk'] at h
    have hN : N.map q = ⊥ := by
      calc
        N.map q = q.ker.map q := congrArg (fun J => J.map q) (QuotientGroup.ker_mk' N).symm
        _ = ⊥ := Subgroup.map_ker_self q
    simpa only [hN, bot_sup_eq] using h
  change N.index = 2
  rw [N.index_eq_card,
    ← Nat.card_congr (Subgroup.topEquiv : (⊤ : Subgroup (R ⧸ N)) ≃* _).toEquiv,
    ← hqgen, Nat.card_zpowers, hord]

omit [Finite G] in
/-- The crossing group has index two over `S`, using the actual square relation. -/
public theorem crossing_index (d : Setup G) : (d.S.subgroupOf (crossing d)).index = 2 :=
  adjoin_index_two d.S d.x d.x_normalizes d.x_outside d.square_mem

omit [Finite G] in
/-- The crossing group has order 256. -/
public theorem crossing_card (d : Setup G) (r : CoreReduction d) : Nat.card (crossing d) = 256 := by
  have h := (d.S.subgroupOf (crossing d)).card_mul_index
  rw [Nat.card_congr (subgroupOfEquivOfLe (show d.S ≤ crossing d from le_sup_left)).toEquiv,
    crossing_index, r.card_s] at h
  exact h.symm

/-- The quotient by the factor product has order four. -/
public theorem quotient_card (d : Setup G) (r : CoreReduction d) :
    Nat.card (crossing d ⧸ (base d).subgroupOf (crossing d)) = 4 := by
  have h := ((base d).subgroupOf (crossing d)).card_eq_card_quotient_mul_card_subgroup
  rw [Nat.card_congr (subgroupOfEquivOfLe (show base d ≤ crossing d from (base_le_s d).trans le_sup_left)).toEquiv,
    base_card, crossing_card d r] at h
  omega

/-- Failure of square membership produces a genuine cyclic-four quotient.
This identifies the remaining obstruction; it does not exclude it. -/
public theorem cyclic_quotient_of_square_notMem (d : Setup G) (r : CoreReduction d)
    (hbad : d.x ^ 2 ∉ base d) :
    let := normal_base d r
    Nonempty ((crossing d ⧸ (base d).subgroupOf (crossing d)) ≃* Multiplicative (ZMod 4)) := by
  let N := (base d).subgroupOf (crossing d)
  let : N.Normal := normal_base d r
  let y := QuotientGroup.mk' N (crossingElement d)
  have hy2 : y ^ 2 ≠ 1 := by
    rw [← map_pow]
    exact fun h => hbad ((QuotientGroup.eq_one_iff (crossingElement d ^ 2)).mp h)
  have hy4 : y ^ 4 = 1 := by
    rw [← map_pow]
    exact (QuotientGroup.eq_one_iff _).mpr (crossing_fourth d r)
  have ho : orderOf y = 4 := orderOf_eq_prime_pow (p := 2) (n := 1) hy2 hy4
  let : IsCyclic (crossing d ⧸ N) :=
    isCyclic_iff_exists_orderOf_eq_natCard.mpr ⟨y, ho.trans (quotient_card d r).symm⟩
  exact ⟨mulEquivOfCyclicCardEq (by simpa using quotient_card d r)⟩

/-- The global local-pair hypothesis passes to the containing two-group `T`. -/
public theorem t_mem_beta (d : Setup G) (E : Subgroup G) [IsKleinFour E] (hE : E ≤ d.sk) :
    d.T ∈ beta d.M := by
  have hp := (d.largestPairs E hE inferInstance).1
  exact beta_mono hp.1 (inf_le_left.trans d.s_le_t) d.twoT

/-- The given ambient two-group lies in `M`, as forced by its beta subgroup. -/
public theorem t_le_m (d : Setup G) (E : Subgroup G) [IsKleinFour E] (hE : E ≤ d.sk) :
    d.T ≤ d.M := (t_mem_beta d E hE).2.1

/-- Global maximality forbids a larger two-subgroup above the local base
in any characteristic-two overgroup of the specified local normalizer. -/
public theorem largest_base_in_characteristicTwo (d : Setup G) (E : Subgroup G)
    [IsKleinFour E] (hE : E ≤ d.sk) (J W : Subgroup G)
    (hJ : J ∈ Chapter1.He G)
    (hLJ : d.H ⊓ normalizer (E : Set G) ≤ J)
    (hUW : d.S ⊓ normalizer (E : Set G) ≤ W)
    (hW : IsPGroup 2 W) (hWJ : W ≤ J) :
    W = d.S ⊓ normalizer (E : Set G) := by
  obtain ⟨hp, hmax⟩ := d.largestPairs E hE inferInstance
  have hJM : ¬ J ≤ d.M := fun h => hp.2.2.2.2 (hLJ.trans h)
  have hcore : twoCore J ≠ ⊥ := by
    intro hzero
    change J ⊓ centralizer (twoCore J : Set G) ≤ twoCore J at hJ
    rw [hzero] at hJ
    have hbot : J ≤ ⊥ := by
      intro j hj
      exact hJ ⟨hj, by intro a ha; have h : a = 1 := ha; simp only [h, one_mul, mul_one]⟩
    exact hJM (hbot.trans bot_le)
  have hpair : (W, J) ∈ localPairs (Chapter1.He G) d.M :=
    ⟨beta_mono hp.1 hUW hW, hJ, hcore, hWJ, hJM⟩
  exact (eq_of_le_of_card_ge hUW (hmax W ⟨J, hpair⟩)).symm

/-- The asserted order in the terminal source paragraph follows once the square
belongs to the factor product. -/
public theorem base_adjoin_card_of_square_mem (d : Setup G) (h : d.x ^ 2 ∈ base d) :
    Nat.card (base d ⊔ zpowers d.x : Subgroup G) = 128 := by
  have hi := adjoin_index_two (base d) d.x d.crossing_normalizes_factor_product
    (fun hx => d.x_outside (base_le_s d hx)) h
  have hc := ((base d).subgroupOf (base d ⊔ zpowers d.x)).card_mul_index
  rw [Nat.card_congr (subgroupOfEquivOfLe
    (show base d ≤ base d ⊔ zpowers d.x from le_sup_left)).toEquiv,
    base_card, hi] at hc
  exact hc.symm

/-- In the remaining branch, adjoining the crossing element to the factor
product already generates all of `⟨S,x⟩`. -/
public theorem base_adjoin_eq_of_square_notMem (d : Setup G) (r : CoreReduction d)
    (hbad : d.x ^ 2 ∉ base d) : base d ⊔ zpowers d.x = crossing d := by
  apply le_antisymm (sup_le_sup (base_le_s d) le_rfl)
  refine sup_le ?_ le_sup_right
  intro s hs
  by_cases hsb : s ∈ base d
  · exact mem_sup_left hsb
  · have hm : s * (d.x ^ 2)⁻¹ ∈ base d := by
      let a : d.S := ⟨s, hs⟩
      let b : d.S := ⟨d.x ^ 2, d.square_mem⟩
      exact ((base d).subgroupOf d.S).mul_mem_iff_of_index_two
        (base_index d r) |>.mpr (show a ∈ (base d).subgroupOf d.S ↔
          b⁻¹ ∈ (base d).subgroupOf d.S from iff_of_false hsb
            (fun h => hbad (by simpa using (base d).inv_mem h)))
    have hm' := (base d ⊔ zpowers d.x).mul_mem (mem_sup_left hm)
      (mem_sup_right ((zpowers d.x).pow_mem (mem_zpowers d.x) 2))
    simpa only [mul_assoc, inv_mul_cancel, mul_one] using hm'

/-- Failure of square membership gives order 256, rather than the source's
required order 128, for the same generated subgroup. -/
public theorem base_adjoin_card_of_square_notMem (d : Setup G) (r : CoreReduction d)
    (hbad : d.x ^ 2 ∉ base d) :
    Nat.card (base d ⊔ zpowers d.x : Subgroup G) = 256 := by
  rw [base_adjoin_eq_of_square_notMem d r hbad, crossing_card d r]

/-- The order assertion in the terminal paragraph is exactly the outstanding
square-membership obligation. -/
public theorem base_adjoin_card_iff_square_mem (d : Setup G) (r : CoreReduction d) :
    Nat.card (base d ⊔ zpowers d.x : Subgroup G) = 128 ↔ d.x ^ 2 ∈ base d := by
  constructor
  · intro hcard
    by_contra hbad
    have h := base_adjoin_card_of_square_notMem d r hbad
    omega
  · exact base_adjoin_card_of_square_mem d


end CFSG.Quasithin.Chapter2.A6ShadowConstruction.SquareMembership
