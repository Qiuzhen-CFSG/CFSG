/-!
# Original persistence at the central-core involution

Apply 2.5.6 to the actual subgroup generated by the central-core involution.
The exceptional M₁₁ orbit and the original full Sylow generate a new source
setup in Γ*. An aligned largest pair lets the proved 2.5.15 M₁₁ exclusion
rule it out. This proves 2.5.18(1) and supplies the previously explicit
component premise in the ordinary-component construction of 2.5.19.

The original Γ* hypothesis is retained: it is fixed by Notation 2.5.9 and
is stronger than the Γ₀ field of MathieuSourceSetup.
Source: Aschbacher–Smith 2.5.18–19, printed pp.560–561.
-/
public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter2.Section05.Overcomponents
open ComponentRefinement ComponentSelection ComponentSelection.NonEnlargement
open A6Shadow.Frattini

private theorem mathieu_not_bender {C:Type*} [Group C] [Finite C]
    (e:C≃*Sporadic.Mathieu.M11) : ¬ClassificationModels.IsBenderModel C := by
  intro hb
  let Q:Sylow 2 C:=default
  have hm:IsSmallRemainingComponent C:=Or.inr (Or.inr (Or.inr (Or.inl ⟨e⟩)))
  obtain ⟨F,_,hF⟩:=(hm.sylowTwoShape Q).exists_four_le Q
  let :=hF
  obtain ⟨a⟩:=(Sporadic.Mathieu.m11_four_structure_of_equiv e F).2
  exact SylowIntersection.not_of_symmetric_four_embedding
    ((normalizer (F:Set C)).subtype.comp a.symm.toMonoidHom)
    (Subtype.val_injective.comp a.symm.injective) (bender_sylow_eq_of_inf_ne_bot hb)

private theorem mathieu_overcomponent_false {G:Type*} [Group G] [Finite G]
    {H K M C:Subgroup G} {S:Sylow 2 H} {z:G}
    (c:MathieuSourceSetup H K M S z)
    (hG:IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hempty:gammaEvenZero (Chapter1.He G) M=∅)
    (hgen:H=K⊔(S:Subgroup H).map H.subtype)
    (hstar:H∈gammaStar (Chapter1.He G) M)
    (t:G) (ht:orderOf t=2) (htY:t∈(S:Subgroup H).map H.subtype)
    (hHt:H≤centralizer ({t}:Set G))
    (P:Sylow 2 (centralizer ({t}:Set G)))
    (hP:(P:Subgroup (centralizer ({t}:Set G))).map (centralizer ({t}:Set G)).subtype=
      (S:Subgroup H).map H.subtype)
    (hC:IsComponentIn C (centralizer ({t}:Set G))) (hKC:K≤C)
    (e:C≃*Sporadic.Mathieu.M11) : False := by
  let Y:=(S:Subgroup H).map H.subtype
  let J:=centralizer ({t}:Set G)
  let X:=C⊔Y
  have hYX:Y≤X:=le_sup_right
  have hXJ:X≤J:=sup_le hC.1 ((map_subtype_le _).trans hHt)
  have hHX:H≤X:=by rw [hgen];exact sup_le_sup hKC le_rfl
  have htx:t∈X:=hYX htY
  have hcore:twoCore X≠⊥ := by
    have hE:zpowers t≤twoCore X := by
      apply le_pCoreIn_of_normalizes
      · exact IsPGroup.of_card (n:=1) (by simpa only [Nat.card_zpowers,pow_one] using ht)
      · exact zpowers_le.mpr htx
      · apply hXJ.trans
        change centralizer ({t}:Set G)≤_
        rw [←centralizer_closure,←zpowers_eq_closure]
        exact Subgroup.centralizer_le_normalizer _
    intro hh
    have ht1:t=1:=mem_bot.mp (hh ▸ hE (mem_zpowers t))
    simp [ht1] at ht
  obtain ⟨hX,_,hs,_⟩:=gammaZero_overgroup c.gamma hHX hcore
  have hXS:X∈gammaStar (Chapter1.He G) M:=hs hstar
  obtain ⟨Q,hQ⟩:=(show Chapter1.IsSylowIn 2 Y J from ⟨P,hP⟩).restrict hYX hXJ
  have hCX:IsComponentIn C X:=hC.restrict le_sup_left hXJ
  obtain ⟨cX⟩:=exists_setup_of_same_sylow c.T c.maximal c.sylow_le c.unique
    (ComponentSelection.MathieuSourceSetup.sourceTuple c) hX Q hQ hCX
  let : (C.subgroupOf X).Normal:=small_component_normal hG.quasithin hX _ hCX.2
    (Or.inr ⟨(subgroupOfEquivOfLe hCX.1).trans e⟩)
  have hYM:Y≤M:=(c.sylow_lt.le).trans c.sylow_le
  obtain ⟨U,L,hpair,hUS,_,hbig,_⟩:=exists_saturated_pair_aligned hX Q (hQ ▸ hYM)
  exact mathieu_component_false_of_source cX hG hempty
    (by rw [hQ]) (mathieu_not_bender e) ⟨hpair,hbig hXS⟩ hUS e

/-- Original source 2.5.18(1), for any actual central-core involution t.
The largest-base source hypothesis is used to invoke the original M₁₁ exclusion. -/
theorem source_component_in_centralizer_t {G:Type*} [Group G] [Finite G]
    {H K M:Subgroup G} {S:Sylow 2 H} {z:G}
    (c:MathieuSourceSetup H K M S z)
    (hG:IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hempty:gammaEvenZero (Chapter1.He G) M=∅)
    (hgen:H=K⊔(S:Subgroup H).map H.subtype)
    (hb:¬ClassificationModels.IsBenderModel K)
    (hstar:H∈gammaStar (Chapter1.He G) M)
    (t:G) (ht:orderOf t=2) (htC:t∈twoCore H)
    (htZ:t∈centerIn ((S:Subgroup H).map H.subtype)) :
    IsComponentIn K (centralizer ({t}:Set G)) := by
  let E:=zpowers t
  have hE:E≠⊥:=zpowers_ne_bot.mpr (by intro he;simp [he] at ht)
  have hEC:E≤twoCore H:=zpowers_le.mpr htC
  have hSE:(S:Subgroup H).map H.subtype≤normalizer (E:Set G) := by
    apply le_trans ?_ (centralizer_le_normalizer E)
    change (S:Subgroup H).map H.subtype≤centralizer (zpowers t:Set G)
    rw [zpowers_eq_closure,centralizer_closure]
    intro y hy
    exact mem_centralizer_singleton_iff.mpr (htZ.2 y hy)
  have hJ:normalizer (E:Set G)=centralizer ({t}:Set G) := by
    apply le_antisymm
    · have he:Nat.card E=2:=by rw [Nat.card_zpowers];exact ht
      have hc:=normalizer_le_centralizer_of_card_two E he
      simpa only [E,zpowers_eq_closure,centralizer_closure] using hc
    · rw [←centralizer_closure,←zpowers_eq_closure]
      exact centralizer_le_normalizer E
  obtain ⟨_,hPs,_,hcase⟩:=ComponentSelection.MathieuSourceSetup.lemma_2_5_6
    c hG hempty hgen hb hE hEC hSE
  rw [hJ] at hPs hcase
  obtain ⟨P,hP⟩:=hPs
  rcases hcase with h|⟨_,_,_,hC,⟨e⟩⟩
  · exact h
  · have hHt: H≤centralizer ({t}:Set G):=
      (ComponentSelection.MathieuSourceSetup.central_core_involution_centralizer c hgen t ht htC htZ).1
    exact (mathieu_overcomponent_false c hG hempty hgen hstar t ht htZ.1 hHt
      P hP hC (le_componentOrbit K (centralizer ({t}:Set G))) e).elim
/-- The initial ordinary-component alternatives of 2.5.19, now entirely from
its original source hypotheses. The actual central-core involution is kept
explicit so later fusion arguments use the same marks. -/
theorem source_ordinary_pumpup {G:Type*} [Group G] [Finite G]
    {H K M:Subgroup G} {S:Sylow 2 H} {z:G}
    (c:MathieuSourceSetup H K M S z)
    (hG:IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hempty:gammaEvenZero (Chapter1.He G) M=∅)
    (hgen:H=K⊔(S:Subgroup H).map H.subtype)
    (hb:¬ClassificationModels.IsBenderModel K)
    (hstar:H∈gammaStar (Chapter1.He G) M)
    (t i:G) (ht:orderOf t=2) (htC:t∈twoCore H)
    (htZ:t∈centerIn ((S:Subgroup H).map H.subtype))
    (hi:orderOf i=2) (hiS:i∈(S:Subgroup H).map H.subtype)
    (hiK:i∈centralizer (K:Set G)) :
    ∃htI:t∈centralizer ({i}:Set G),
      let Gi:=centralizer ({i}:Set G)
      let tI:Gi:=⟨t,htI⟩
      let D:=K.subgroupOf Gi
      let X:=componentOrbit D (oddELayer Gi)
      (IsComponent Gi X ∧ X.map (MulAut.conj tI).toMonoidHom=X) ∨
        ∃J:Subgroup Gi,IsComponent Gi J ∧ J≠J.map (MulAut.conj tI).toMonoidHom ∧
          X=J⊔J.map (MulAut.conj tI).toMonoidHom ∧
          Nonempty ((J⧸oddTwoCore J)≃*(K⧸oddTwoCore K)) := by
  have hti:Commute t i := (htZ.2 i hiS).symm
  have hKi:K≤centralizer ({i}:Set G) := fun k hk =>
    mem_centralizer_singleton_iff.mpr (hiK k hk)
  exact source_twoComponent_pumpup_ordinary c hG hempty hgen hb t i ht hti hKi
    (source_component_in_centralizer_t c hG hempty hgen hb hstar t ht htC htZ) hi
end CFSG.Quasithin.Chapter2.Section05.Overcomponents
