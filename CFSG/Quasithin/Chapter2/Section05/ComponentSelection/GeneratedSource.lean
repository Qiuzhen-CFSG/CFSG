module
public import CFSG.Quasithin.Chapter2.Section05.ComponentSelection.SourceInduction

/-!
# The original component-generated source group

Starting with any source Gamma-zero group and its prescribed Sylow, pass
to the normalizer of its actual two-core. This constructs the required
normalizer presentation. The proved component descent then supplies a
non-Bender component whose join with that same Sylow retains both stars.
The component is restricted to the join, and the original Sylow remains
Sylow in both the join and its intersection with M.

The genuine earlier 2.5.2 model input remains explicit, as in SourceInduction.
Source: Aschbacher--Smith, the definition and nonemptiness of Gamma-plus
following 2.5.3(4), printed pp.553--554.
-/

public section
namespace CFSG.Quasithin.Chapter2.Section05.ComponentSelection
open Subgroup Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G] {M H : Subgroup G}

/-- The source passage to a group generated by an actual non-Bender component
and the original Sylow. Normalizer presentation is constructed from O₂(H). -/
theorem exists_component_generated_source_of_models
    {C : GroupClass} (hG : IsSimpleQTKE C G)
    (T₀ : Sylow 2 G) (hM : IsMaximalTwoLocal M) (hT₀M : (T₀ : Subgroup G) ≤ M)
    (hunique : ∀ N : Subgroup G, IsMaximalTwoLocal N → (T₀ : Subgroup G) ≤ N → N = M)
    (hH : H ∈ gammaZero (Chapter1.He G) M)
    (hempty : gammaEvenZero (Chapter1.He G) M = ∅)
    (hmodels : NonBenderSourceModels M)
    (S : Sylow 2 H) (hSM : (S : Subgroup H).map H.subtype ≤ M) :
    ∃ X K : Subgroup G,
      X ∈ gammaZero (Chapter1.He G) M ∧
      (H ∈ gammaStar (Chapter1.He G) M → X ∈ gammaStar (Chapter1.He G) M) ∧
      (H ∈ gammaMax (Chapter1.He G) M → X ∈ gammaMax (Chapter1.He G) M) ∧
      IsComponentIn K X ∧ ¬ ClassificationModels.IsBenderModel K ∧
      Chapter1.IsSylowIn 2 ((S : Subgroup H).map H.subtype) X ∧
      Chapter1.IsSylowIn 2 ((S : Subgroup H).map H.subtype) (X ⊓ M) ∧
      X = K ⊔ (S : Subgroup H).map H.subtype := by
  obtain ⟨U,HU,hpair,hUS,_,_,_⟩ := exists_saturated_pair_aligned hH S hSM
  let N := normalizer (twoCore H : Set G)
  obtain ⟨hN,⟨R,hR⟩,_,hs,hm⟩ := lemma_2_3_9_1 hH hpair S hUS
  let B : Fin 1 → Subgroup G := fun _ => twoCore H
  have hBN : ∀ i, B i ≤ N := fun _ => (twoCore H).le_normalizer
  have hNnorm : N = ⨅ i, normalizer (B i : Set G) := by simp [B,N]
  obtain ⟨D,hD,hno,hX,hstar,hmax⟩ := lemma_2_5_3_four_of_source_models hG T₀ hM hT₀M
    hunique hN hempty hmodels B (fun _ => isPGroup_pCoreIn 2 H) hBN hNnorm
    R (hR.symm ▸ hSM)
  let K := D.map N.subtype
  let A := (S : Subgroup H).map H.subtype
  let X := K ⊔ A
  have hAN : A ≤ N := by
    change (S : Subgroup H).map H.subtype ≤ N
    rw [← hR]
    exact map_subtype_le (R : Subgroup N)
  have hXN : X ≤ N := sup_le (map_subtype_le D) hAN
  have hKN : IsComponentIn K N := by
    refine ⟨map_subtype_le D,?_⟩
    change IsComponent N ((D.map N.subtype).comap N.subtype)
    rwa [comap_map_eq_self_of_injective N.subtype_injective]
  have hXX : K ⊔ (R : Subgroup N).map N.subtype = X := by rw [hR]
  refine ⟨X,K,hXX ▸ hX,fun h => hXX ▸ hstar (hs h),fun h => hXX ▸ hmax (hm h),
    hKN.restrict le_sup_left hXN,?_,?_,?_,rfl⟩
  · intro hb
    exact hno (hb.of_mulEquiv (D.equivMapOfInjective N.subtype N.subtype_injective))
  · exact (show Chapter1.IsSylowIn 2 A N from ⟨R,hR⟩).restrict le_sup_right hXN
  · exact (show Chapter1.IsSylowIn 2 A N from ⟨R,hR⟩).restrict
      (le_inf le_sup_right hSM) (inf_le_left.trans hXN)

end CFSG.Quasithin.Chapter2.Section05.ComponentSelection
