module
public import CFSG.Quasithin.Chapter2.Section05.ComponentSelection.PersistenceAlternativesSource
public import CFSG.Quasithin.Chapter2.Section05.ComponentSelection.NonEnlargement.MathieuModels
public import CFSG.Quasithin.Chapter2.Section05.ComponentSelection.SmallNormality
/-!
# The A₆ and orbit conclusions in the exceptional source alternative

The surviving source catalogue forces K≃A₆ inside a strictly larger M₁₁.
Cubic rank makes K normal in the original H, hence K=K₀. The ordinary
containing M₁₁ is likewise normal in N(E); its simplicity identifies it
with the literal orbit generated by the N(E)-conjugates of K.
Source: Aschbacher–Smith 2.5.6(2), printed p.554.
-/
public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter2.Section05.ComponentSelection
open ComponentRefinement
variable {G : Type*} [Group G] [Finite G]
private theorem six_normal {H K:Subgroup G} {S:Sylow 2 H} {M:Subgroup G} {z:G}
    (c:MathieuSourceSetup H K M S z) (hG:IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (e:K≃*alternatingGroup (Fin 6)) : (K.subgroupOf H).Normal := by
  let a := (subgroupOfEquivOfLe c.component_le).trans e
  have hr : 2≤primeRank 3 (K.subgroupOf H) := by
    rw [primeRank_equiv 3 a]
    exact alternatingGroup.TwoThreeCycles.two_le_primeRank (by decide)
  have hz : center (K.subgroupOf H)=⊥ := by
    apply eq_bot_iff.mpr
    intro x hx
    have hh : a x∈center (alternatingGroup (Fin 6)) := ((centerCongr a) ⟨x,hx⟩).property
    rw [alternatingGroup.center_eq_bot (by simp),mem_bot] at hh
    exact mem_bot.mpr (a.injective (hh.trans (map_one a).symm))
  have hcore : pCore 2 H≠⊥ := by
    intro he
    have hn := (c.gamma.elim (fun h=>h.1.1) (fun h=>h.1)).1
    exact hn (by simp only [twoCore,he,Subgroup.map_bot])
  exact c.component.normal_of_centerless_primeRank hz hr
    (Theory.Quasithin.primeRank_subgroup_le_two_of_normal_two_subgroup hG.quasithin H
      (pCore 2 H) hcore pCore_isPGroup 3 (by decide) (by decide))

omit [Finite G] in
private theorem orbit_eq_simple_containing {K C J:Subgroup G}
    (hKC:K≤C) (hCJ:C≤J) (hK:K≠⊥) [(C.subgroupOf J).Normal] [IsSimpleGroup C] :
    componentOrbit K J=C := by
  let D := componentOrbit K J
  have hJC : J≤normalizer (C:Set G) := (normal_subgroupOf_iff_le_normalizer hCJ).mp inferInstance
  have hDC : D≤C := iSup_conjugates_le_of_le_normalizer K J C hKC hJC
  have hn : (D.subgroupOf C).Normal :=
    (normal_subgroupOf_iff_le_normalizer hDC).mpr (hCJ.trans (le_normalizer_componentOrbit K J))
  rcases hn.eq_bot_or_eq_top with he | he
  · have hb : D=⊥ := by
      have hh := congrArg (Subgroup.map C.subtype) he
      simpa only [map_subgroupOf_eq_of_le hDC,Subgroup.map_bot] using hh
    exact (hK (le_bot_iff.mp ((le_componentOrbit K J).trans hb.le))).elim
  · exact le_antisymm hDC (subgroupOf_eq_top.mp he)

theorem MathieuSourceSetup.exceptional_alternating_six_orbit
    {H K M E:Subgroup G} {S:Sylow 2 H} {z:G}
    (c:MathieuSourceSetup H K M S z)
    (hG:IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hempty:gammaEvenZero (Chapter1.He G) M=∅)
    (hgen:H=K⊔(S:Subgroup H).map H.subtype)
    (hb:¬ClassificationModels.IsBenderModel K)
    (hE:E≠⊥) (hEC:E≤((S:Subgroup H).map H.subtype)⊓centralizer (K:Set G))
    (hSE:(S:Subgroup H).map H.subtype≤normalizer (E:Set G))
    (hne:¬IsComponentIn K (normalizer (E:Set G))) :
    Nonempty (K≃*alternatingGroup (Fin 6)) ∧ (K.subgroupOf H).Normal ∧
      componentOrbit K ((S:Subgroup H).map H.subtype)=K ∧
      IsComponentIn (componentOrbit K (normalizer (E:Set G))) (normalizer (E:Set G)) ∧
      Nonempty (componentOrbit K (normalizer (E:Set G))≃*Sporadic.Mathieu.M11) := by
  obtain ⟨C,hC,hKC,hm⟩ := (MathieuSourceSetup.component_or_mathieu_in_normalizer c hG hempty
    hgen hb hE hEC hSE).resolve_left hne
  have ha := NonEnlargement.small_model_in_mathieu hKC
    (MathieuSourceSetup.small_remaining_component c hG hempty hgen hb) hm
  have ha : Nonempty (K≃*alternatingGroup (Fin 6)) := ha.resolve_left (fun he=>hne (he.symm ▸ hC))
  obtain ⟨e⟩ := ha
  have hn := six_normal c hG e
  let : (K.subgroupOf H).Normal := hn
  have ho : componentOrbit K ((S:Subgroup H).map H.subtype)=K :=
    le_antisymm (iSup_conjugates_le_of_le_normalizer _ _ _ le_rfl
      ((map_subtype_le _).trans ((normal_subgroupOf_iff_le_normalizer c.component_le).mp hn)))
      (le_componentOrbit _ _)
  obtain ⟨hJ,_,_⟩ := centralizer_subgroup_normalizer (MathieuSourceSetup.sourceTuple c) hgen hE hEC hSE
  let a := subgroupOfEquivOfLe hC.1
  have hnC := small_component_normal hG.quasithin hJ (C.subgroupOf (normalizer (E:Set G))) hC.2
    (Or.inr (hm.map (fun e=>a.trans e)))
  let := hnC
  obtain ⟨eC⟩ := hm
  let : IsSimpleGroup Sporadic.Mathieu.M11 := Sporadic.Mathieu.m11_isSimpleGroup
  let : IsSimpleGroup C := eC.isSimpleGroup
  have hclosure := orbit_eq_simple_containing hKC hC.1 (show K≠⊥ from
    (show IsComponentIn K H from ⟨c.component_le,c.component⟩).ne_bot)
  exact ⟨⟨e⟩,hn,ho,hclosure.symm ▸ hC,⟨(MulEquiv.subgroupCongr hclosure).trans eC⟩⟩
end CFSG.Quasithin.Chapter2.Section05.ComponentSelection
