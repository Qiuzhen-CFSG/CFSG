module
public import CFSG.Quasithin.Chapter2.Section05.ComponentSelection.SourceModels
public import CFSG.Quasithin.Chapter2.Section05.ComponentFusion
public import Theory.GroupTheory.GeneralizedFitting.ComponentSylowCore
public import Theory.GroupTheory.GeneralizedFitting.SylowNormalizedComponent
public import Theory.Quasithin.NormalTwoRank

/-! # The component-generated source tuple and conjugate cores
The proved original component descent supplies a group generated by its
non-Bender component and the prescribed Sylow. Select its actual ambient
Sylow and central involution, and use the normalizer condition in a finite
two-group to construct the outside crossing element with square in S.
For K₀=⟨K^S⟩ the literal centralizer factor is O₂(H); the existing source
normalizer argument makes its right conjugate disjoint and commuting.
The multiplication isomorphism retains the actual embedded factors.
Source: Aschbacher--Smith 2.5.4--5, printed p.554. -/
public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter2.Section05.ComponentSelection
variable {G : Type*} [Group G] [Finite G]
private theorem exists_crossing {S T : Subgroup G} (hT : IsPGroup 2 T) (hlt : S<T) :
    ∃ x:G, x∈T ∧ x∉S ∧ x∈normalizer (S:Set G) ∧ x^2∈S := by
  let P := S.subgroupOf T
  let := hT.isNilpotent
  have hP : P≠⊤ := by
    intro he
    have ht : T≤S := by
      intro t ht
      have : (⟨t,ht⟩:T)∈P := he ▸ mem_top _
      exact this
    exact hlt.not_ge ht
  have hPN := Group.normalizerCondition_of_isNilpotent P (lt_of_le_of_ne le_top hP)
  let N := normalizer (P:Set T)
  let U := P.subgroupOf N
  let : U.Normal := inferInstance
  have hU : U≠⊤ := by
    intro he
    apply hPN.not_ge
    intro x hx
    have : (⟨x,hx⟩:N)∈U := he ▸ mem_top _
    exact this
  let : Nontrivial (N ⧸ U) := QuotientGroup.nontrivial_iff.mpr hU
  have hp : IsPGroup 2 (N ⧸ U) := (hT.to_subgroup N).to_quotient U
  have hd : 2 ∣ Nat.card (N ⧸ U) := hp.card_eq_or_dvd.resolve_left (by
    have := Finite.one_lt_card (α := N ⧸ U)
    omega)
  obtain ⟨y,hy⟩ := exists_prime_orderOf_dvd_card' (G := N ⧸ U) 2 hd
  obtain ⟨x,hx⟩ := QuotientGroup.mk'_surjective U y
  have hxout : x∉U := by
    intro h
    have hy1 : y=1 := hx.symm.trans ((QuotientGroup.eq_one_iff _).mpr h)
    simp [hy1] at hy
  have hxsq : x^2∈U := by
    apply (QuotientGroup.eq_one_iff _).mp
    change QuotientGroup.mk' U (x^2)=1
    rw [map_pow,hx,← hy,pow_orderOf_eq_one]
  refine ⟨((x:T):G),(x:T).property,hxout,?_,hxsq⟩
  have hnorm := P.le_normalizer_map T.subtype (mem_map_of_mem T.subtype x.property)
  rw [map_subgroupOf_eq_of_le hlt.le] at hnorm
  exact hnorm


/-- Construct the literal component-generated marked tuple and its outside
normalizer element from the original Gamma-zero input. -/
theorem exists_generated_crossing_tuple
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    {M H : Subgroup G} (sourceC : LocalC129Input KnownSimple.IsKnownSimple G)
    (T₀ : Sylow 2 G) (hM : IsMaximalTwoLocal M) (hT₀M : (T₀ : Subgroup G)≤M)
    (hunique : ∀ N : Subgroup G, IsMaximalTwoLocal N → (T₀ : Subgroup G)≤N → N=M)
    (hH : H∈gammaZero (Chapter1.He G) M)
    (hempty : gammaEvenZero (Chapter1.He G) M=∅)
    (S₀ : Sylow 2 H) (hSM : (S₀ : Subgroup H).map H.subtype≤M) :
    ∃ X K : Subgroup G, ∃ S : Sylow 2 X, ∃ T : Sylow 2 G, ∃ z x : G,
      SourceTuple M X ((S : Subgroup X).map X.subtype) (T : Subgroup G) z ∧
      (H∈gammaStar (Chapter1.He G) M → X∈gammaStar (Chapter1.He G) M) ∧
      (H∈gammaMax (Chapter1.He G) M → X∈gammaMax (Chapter1.He G) M) ∧
      IsComponentIn K X ∧ ¬ ClassificationModels.IsBenderModel K ∧
      X=K⊔(S : Subgroup X).map X.subtype ∧
      (S : Subgroup X).map X.subtype=(S₀ : Subgroup H).map H.subtype ∧
      x∈T ∧ x∉(S : Subgroup X).map X.subtype ∧
      x∈normalizer ((S : Subgroup X).map X.subtype : Set G) ∧
      x^2∈(S : Subgroup X).map X.subtype := by
  obtain ⟨X,K,hX,hs,hm,hK,hno,hSX,hSXM,hgen⟩ :=
    exists_component_generated_source hG sourceC T₀ hM hT₀M hunique hH hempty S₀ hSM
  obtain ⟨S,hS⟩ := hSX
  have hSM' : (S : Subgroup X).map X.subtype≤M := hS.symm ▸ hSM
  obtain ⟨U,HU,hpair,hUS,_,_,_⟩ := exists_saturated_pair_aligned hX S hSM'
  have hMe : M∈Chapter1.He G := Chapter1.mem_He_iff.mpr (hG.evenCharacteristic T₀ M hM hT₀M)
  obtain ⟨T,hTM,hST,hZS,_⟩ := lemma_2_3_9_3 T₀ hT₀M hunique hMe hX hpair S hUS
  have hTne : (T : Subgroup G)≠⊥ := ne_of_gt (lt_of_le_of_lt bot_le hST)
  let : Nontrivial T := (Subgroup.nontrivial_iff_ne_bot _).mpr hTne
  let : Nontrivial (center T) := T.isPGroup'.center_nontrivial
  have hd : 2∣Nat.card (center T) :=
    ((T.isPGroup'.to_subgroup (center T)).card_eq_or_dvd.resolve_left
      (by have := Finite.one_lt_card (α := center T); omega))
  obtain ⟨z,hz⟩ := exists_prime_orderOf_dvd_card' (G := center T) 2 hd
  have hzo : orderOf ((z:T):G)=2 :=
    (Subgroup.orderOf_coe (z:T)).trans ((Subgroup.orderOf_coe z).trans hz)
  obtain ⟨x,hxT,hxS,hxN,hx2⟩ := exists_crossing T.isPGroup' hST
  refine ⟨X,K,S,T,z,x,?_,hs,hm,hK,hno,?_,hS,hxT,hxS,hxN,hx2⟩
  · refine ⟨hX,?_,?_,hZS,hST,hzo,mem_map_of_mem _ z.property⟩
    · exact ⟨hSXM.choose,hSXM.choose_spec.trans hS.symm⟩
    · refine ⟨T.subtype hTM,?_⟩
      simp only [Sylow.coe_subtype,map_subgroupOf_eq_of_le hTM]
  · rwa [hS]

/-- Original 2.5.5 for the actual orbit K₀, with right conjugation.
Only the selected tuple and its literal component-Sylow generation are inputs. -/
theorem generated_orbit_disjoint
    {M H K S T : Subgroup G} {z x : G}
    (d : SourceTuple M H S T z) (hgen : H=K⊔S)
    (hxT : x∈T) (hxS : x∉S) (hxN : x∈normalizer (S:Set G)) (hx2 : x^2∈S) :
    let Q := S⊓centralizer (componentOrbit K S : Set G)
    Disjoint Q (Q.conjBy x⁻¹) ∧ Q≤centralizer (Q.conjBy x⁻¹ : Set G) ∧
      ∃ e : Q×Q.conjBy x⁻¹ ≃* (Q⊔Q.conjBy x⁻¹ : Subgroup G),
        ∀ a b, (e (a,b):G)=(a:G)*(b:G) := by
  let D := componentOrbit K S
  have hH : H=D⊔S := hgen.trans (componentOrbit_sup K S).symm
  have hd := centralizer_factor_disjoint d hH (le_normalizer_componentOrbit K S)
    (T.inv_mem hxT) (by simpa only [S.inv_mem_iff] using hxS)
    ((normalizer (S:Set G)).inv_mem hxN) (by simpa only [inv_pow] using S.inv_mem hx2)
  have hn : S≤normalizer (S⊓centralizer (D:Set G) : Set G) := by
    intro s hs
    exact fun a => and_congr (S.le_normalizer hs a)
      ((normalizer_le_normalizer_centralizer D (le_normalizer_componentOrbit K S hs)) a)
  obtain ⟨_,hc,e,he⟩ := conjugate_pair_direct_product
    (show S⊓centralizer (D:Set G)≤S from inf_le_left) le_rfl
    ((normalizer (S:Set G)).inv_mem hxN) hn hd
  exact ⟨hd,hc,e,he⟩


/-- Identify the actual ambient centralizer factor with the two-core. -/
theorem generated_orbit_core {H K : Subgroup G}
    (hK : IsComponentIn K H) (S : Sylow 2 H)
    (hgen : H=K⊔(S:Subgroup H).map H.subtype) :
    (S:Subgroup H).map H.subtype ⊓
      centralizer (componentOrbit K ((S:Subgroup H).map H.subtype):Set G)=twoCore H := by
  let D := componentOrbit (K.subgroupOf H) (S:Subgroup H)
  have hg : K.subgroupOf H⊔(S:Subgroup H)=⊤ := by
    apply map_injective H.subtype_injective
    rw [Subgroup.map_sup,map_subgroupOf_eq_of_le hK.1,← hgen]
    rw [← MonoidHom.range_eq_map,H.range_subtype]
  have hc := hK.2.sylow_centralizer_orbit_eq_pCore S hg
  have hm : D.map H.subtype=componentOrbit K ((S:Subgroup H).map H.subtype) := by
    rw [map_componentOrbit,map_subgroupOf_eq_of_le hK.1]
  have he : ((S:Subgroup H)⊓centralizer (D:Set H)).map H.subtype=
      (S:Subgroup H).map H.subtype⊓centralizer (D.map H.subtype:Set G) := by
    ext x
    constructor
    · rintro ⟨x,⟨hs,hc⟩,rfl⟩
      refine ⟨mem_map_of_mem H.subtype hs,?_⟩
      rintro y ⟨y,hy,rfl⟩
      exact congrArg Subtype.val (hc y hy)
    · rintro ⟨⟨x,hx,rfl⟩,hc⟩
      refine ⟨x,⟨hx,?_⟩,rfl⟩
      intro y hy
      exact Subtype.ext (hc y (mem_map_of_mem H.subtype hy))
  rw [← hm,← he,hc]
  rfl

/-- At most two original component conjugates, from ambient quasithinness. -/
theorem source_component_normal_or_index_two {M H K : Subgroup G}
    (hqt : IsQuasithin G) (hH : H∈gammaZero (Chapter1.He G) M)
    (hK : IsComponentIn K H) :
    (K.subgroupOf H).Normal ∨ (normalizer (K.subgroupOf H:Set H)).index=2 := by
  apply hK.2.normal_or_index_two_of_odd_rank_le_two
  have hQ : pCore 2 H≠⊥ := by
    intro he
    have hn := (hH.elim (fun h=>h.1.1) (fun h=>h.1)).1
    exact hn (by simp only [twoCore,he,Subgroup.map_bot])
  exact Theory.Quasithin.primeRank_subgroup_le_two_of_normal_two_subgroup
    hqt H (pCore 2 H) hQ pCore_isPGroup

/-- Both original 2.5.5 clauses, with the factor identified as O₂(H). -/
theorem generated_twoCore_disjoint
    {M H K T : Subgroup G} {z x : G}
    (S : Sylow 2 H) (d : SourceTuple M H ((S:Subgroup H).map H.subtype) T z)
    (hK : IsComponentIn K H) (hgen : H=K⊔(S:Subgroup H).map H.subtype)
    (hxT : x∈T) (hxS : x∉(S:Subgroup H).map H.subtype)
    (hxN : x∈normalizer ((S:Subgroup H).map H.subtype:Set G))
    (hx2 : x^2∈(S:Subgroup H).map H.subtype) :
    Disjoint (twoCore H) ((twoCore H).conjBy x⁻¹) ∧
      twoCore H≤centralizer ((twoCore H).conjBy x⁻¹:Set G) ∧
      ∃ e : twoCore H×(twoCore H).conjBy x⁻¹ ≃*
        (twoCore H⊔(twoCore H).conjBy x⁻¹ : Subgroup G),
        ∀ a b, (e (a,b):G)=(a:G)*(b:G) := by
  have hh := generated_orbit_disjoint d hgen hxT hxS hxN hx2
  dsimp only at hh
  rwa [generated_orbit_core hK S hgen] at hh
/-- The original superscript-star choice in 2.5.9 exists, with its genuine
component, marked tuple, crossing element and the two conjugate cores.
All construction inputs except the independent earlier C.1.29 are discharged. -/
theorem exists_star_generated_configuration
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    {M : Subgroup G} (sourceC : LocalC129Input KnownSimple.IsKnownSimple G)
    (T₀ : Sylow 2 G) (hM : IsMaximalTwoLocal M) (hT₀M : (T₀ : Subgroup G)≤M)
    (hunique : ∀ N : Subgroup G, IsMaximalTwoLocal N → (T₀ : Subgroup G)≤N → N=M)
    (hdelta : (delta (Chapter1.He G) M).Nonempty)
    (hempty : gammaEvenZero (Chapter1.He G) M=∅) :
    ∃ H K : Subgroup G, ∃ S : Sylow 2 H, ∃ T : Sylow 2 G, ∃ z x : G,
      H∈gammaStar (Chapter1.He G) M ∧
      SourceTuple M H ((S:Subgroup H).map H.subtype) (T:Subgroup G) z ∧
      IsComponentIn K H ∧ ¬ ClassificationModels.IsBenderModel K ∧
      H=K⊔(S:Subgroup H).map H.subtype ∧
      x∈T ∧ x∉(S:Subgroup H).map H.subtype ∧
      x∈normalizer ((S:Subgroup H).map H.subtype:Set G) ∧
      x^2∈(S:Subgroup H).map H.subtype ∧
      (S:Subgroup H).map H.subtype⊓
        centralizer (componentOrbit K ((S:Subgroup H).map H.subtype):Set G)=twoCore H ∧
      Disjoint (twoCore H) ((twoCore H).conjBy x⁻¹) ∧
      twoCore H≤centralizer ((twoCore H).conjBy x⁻¹:Set G) := by
  obtain ⟨H,hH⟩ := (gammaZero_nonempty_of_delta T₀ hT₀M hunique hdelta).1
  let P : Sylow 2 (H⊓M:Subgroup G) := Classical.choice inferInstance
  obtain ⟨S,hS⟩ := (intersection_sylow hH.1.1 P).2
  have hSM : (S:Subgroup H).map H.subtype≤M := by
    rw [hS]
    exact (map_subtype_le _).trans inf_le_right
  obtain ⟨X,K,R,T,z,x,d,hs,_,hK,hn,hgen,_,hxT,hxS,hxN,hx2⟩ :=
    exists_generated_crossing_tuple hG sourceC T₀ hM hT₀M hunique (Or.inl hH) hempty S hSM
  obtain ⟨hd,hc,_⟩ := generated_twoCore_disjoint R d hK hgen hxT hxS hxN hx2
  exact ⟨X,K,R,T,z,x,hs hH,d,hK,hn,hgen,hxT,hxS,hxN,hx2,
    generated_orbit_core hK R hgen,hd,hc⟩

end CFSG.Quasithin.Chapter2.Section05.ComponentSelection
