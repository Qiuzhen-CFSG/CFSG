module
public import Theory.SpecificGroups.PSL3Three.InvolutionResidualFixer
public import Theory.Mathieu.M11.Properties.InvolutionResidual
/-!
# The literal local model facts in Lemma 2.5.15

For the source component K isomorphic to PSL₃(3) or M₁₁, the embedded
O²(C_K(z)) is SL₂(3), has centralizer <z>, and receives every automorphism
from the original C_K(z). The ambient adjustment theorem applies this to
the actual component-normalizing element x and the actual inclusion K→G.
For PSL₃(3), the full pointwise fixer is generated by an outer order-four
automorphism with square conjugation by the original z.

Source: Aschbacher--Smith, Lemma 2.5.15, printed pp.558--559. These facts
discharge the concrete-model assertions in its first paragraph. The source
assembly retains the original normal-component and marked-element producers;
no ambient component or source marking is inferred from a model isomorphism.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter2.Section05.ComponentSelection
variable {G : Type*} [Group G]

noncomputable def localResidualCentralizerEquiv (K : Subgroup G)
    (hK : Nonempty (K ≃* Matrix.PSL3Three.PSL) ∨ Nonempty (K ≃* Sporadic.Mathieu.M11))
    (z : K) (hz : orderOf z = 2) :
    centralizer ({z} : Set K) ≃* Matrix.GeneralLinearGroup (Fin 2) (ZMod 3) := by
  refine Classical.choice ?_
  rcases hK with h | h
  · obtain ⟨e⟩ := h
    exact ⟨(CentralizerSmallKernelTransport.centralizerEquiv e z).trans
      (Matrix.PSL3Three.involutionCentralizerEquivGL (e z) ((e.orderOf_eq z).trans hz))⟩
  · obtain ⟨e⟩ := h
    exact ⟨(CentralizerSmallKernelTransport.centralizerEquiv e z).trans
      (Sporadic.Mathieu.m11InvolutionCentralizerEquivGL (e z) ((e.orderOf_eq z).trans hz))⟩

/-- The literal local subgroup K_z in the two models surviving at 2.5.15. -/
theorem linear_three_or_mathieu_local_residual (K : Subgroup G)
    (hK : Nonempty (K ≃* Matrix.PSL3Three.PSL) ∨ Nonempty (K ≃* Sporadic.Mathieu.M11))
    (z : K) (hz : orderOf z = 2) :
    let R := (pResidual 2 (centralizer ({z} : Set K))).map
      (centralizer ({z} : Set K)).subtype
    Nonempty (R ≃* Matrix.SpecialLinearGroup (Fin 2) (ZMod 3)) ∧
      centralizer (R : Set K) = zpowers z ∧
      Function.Surjective (GLTwoThreeLocal.action z) := by
  let e := localResidualCentralizerEquiv K hK z hz
  exact ⟨⟨GLTwoThreeLocal.residualEquivSL z e⟩,
    GLTwoThreeLocal.centralizer_residual z e hz, GLTwoThreeLocal.action_surjective z e⟩

/-- The adjustment of the source element x by C_K(z), on the actual ambient
carrier. The component-normalizer hypothesis is supplied by normality in H. -/
theorem local_residual_adjust_ambient (K : Subgroup G)
    (hK : Nonempty (K ≃* Matrix.PSL3Three.PSL) ∨ Nonempty (K ≃* Sporadic.Mathieu.M11))
    (z : K) (hz : orderOf z = 2) (x : G)
    (hxK : x ∈ normalizer (K : Set G)) (hxz : Commute x (z : G)) :
    ∃ c : centralizer ({z} : Set K),
      ((c.val : K) : G)⁻¹ * x ∈
        centralizer ((GLTwoThreeLocal.residual z).map K.subtype : Set G) := by
  let a := K.normalizerMonoidHom ⟨x, hxK⟩
  have haz : a z = z := by
    apply Subtype.ext
    change x * (z : G) * x⁻¹ = (z : G)
    rw [hxz.eq, mul_inv_cancel_right]
  obtain ⟨c, hc⟩ := GLTwoThreeLocal.adjust_to_fix_residual z
    (localResidualCentralizerEquiv K hK z hz) a haz
  refine ⟨c, ?_⟩
  rintro r ⟨s, hs, rfl⟩
  have h := congrArg (fun k : K => (k : G)) (hc s hs)
  change (c.val : G)⁻¹ * (x * (s : G) * x⁻¹) * ((c.val : G)⁻¹)⁻¹ = (s : G) at h
  have he : ((c.val : G)⁻¹ * x) * (s : G) * ((c.val : G)⁻¹ * x)⁻¹ = (s : G) := by
    convert h using 1
    group
  exact (mul_inv_eq_iff_eq_mul.mp he).symm

/-- The order-four automorphism marking on the actual source component. -/
theorem linear_three_local_residual_fixer (K : Subgroup G)
    (e : K ≃* Matrix.PSL3Three.PSL) (z : K) (hz : orderOf z = 2) :
    ∃ y : MulAut K, y ∉ MulAut.innerSubgroup K ∧ orderOf y = 4 ∧
      y ^ 2 = MulAut.conj z ∧
      fixingSubgroup (MulAut K)
        (((pResidual 2 (centralizer ({z} : Set K))).map
          (centralizer ({z} : Set K)).subtype) : Set K) = zpowers y :=
  Matrix.PSL3Three.involution_residual_fixer_cyclic_four_of_equiv e z hz

end CFSG.Quasithin.Chapter2.Section05.ComponentSelection
