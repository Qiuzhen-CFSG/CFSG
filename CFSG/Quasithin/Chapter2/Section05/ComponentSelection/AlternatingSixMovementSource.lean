module
public import CFSG.Quasithin.Chapter2.Section05.ComponentSelection.SymplecticBinaryBorel
public import CFSG.Quasithin.Chapter2.Section05.ComponentSelection.ModelSource
/-! # Actual A₆ source movement of an elementary four-group
The source Sylow action already exchanges the two S₄ parabolics of its
A₆ component. Their characteristic two-cores are elementary four-groups
inside the original component Sylow. If the cores were equal, they would
be normal in the A₆ generated by the parabolics, contradicting simplicity.
This supplies the genuine diagram-movement premise in source 2.5.8(4).
Source: Aschbacher--Smith, printed pp.551,556--557.
-/
public section
namespace CFSG.Quasithin.Chapter2.Section05.ComponentSelection
open Subgroup Theory.GroupTheory Theory.SpecificGroups.SymmetricSix
variable {G : Type*} [Group G] [Finite G] {M H : Subgroup G}

theorem alternating_six_four_movement_source
    (hH : H ∈ gammaZero (Chapter1.He G) M)
    (hempty : gammaEvenZero (Chapter1.He G) M = ∅)
    (S : Sylow 2 H) (hSM : (S : Subgroup H).map H.subtype ≤ M)
    (D : Subgroup H) (hD : IsComponent H D) (hout : ¬ D.map H.subtype ≤ M)
    (e₀ : D ≃* A6) :
    ∃ E : Subgroup D, IsKleinFour E ∧ E ≤ (S : Subgroup H).subgroupOf D ∧
      ∃ s : normalizer (D : Set H), (s : H) ∈ S ∧
        E.map (D.normalizerMonoidHom s).toMonoidHom ≠ E := by
  obtain ⟨R,hR⟩ := S.exists_subgroupOf_eq_of_subnormal D hD.1
  let P := R.mapSurjective (f := e₀.toMonoidHom) e₀.surjective
  obtain ⟨g,hg⟩ := MulAction.exists_smul_eq A6 P a6BorelSylow
  let e := e₀.trans (MulAut.conj g)
  have hU : ((S : Subgroup H).subgroupOf D).map e.toMonoidHom = a6Borel := by
    have hh := congrArg Sylow.toSubgroup hg
    change ((R : Subgroup D).map e₀.toMonoidHom).map (MulAut.conj g).toMonoidHom = a6Borel at hh
    rw [map_map,hR] at hh
    exact hh
  obtain ⟨_,s,hs,hsP,hsQ⟩:=alternating_six_aligned_borel_source hH hempty S hSM D hD hout e hU
  let A:=a6DuadStabilizer.comap e.toMonoidHom
  let B:=a6SynthemeStabilizer.comap e.toMonoidHom
  let E:=A.pCoreIn 2
  have hEim:E.map e.toMonoidHom=a6DuadStabilizer.pCoreIn 2:=by
    rw [map_pCoreIn_of_injective 2 A _ e.injective,map_comap_eq_self_of_surjective e.surjective]
  let eE:E≃*pCore 2 a6DuadStabilizer:=
    ((E.equivMapOfInjective e.toMonoidHom e.injective).trans (MulEquiv.subgroupCongr hEim)).trans
      ((pCore 2 a6DuadStabilizer).equivMapOfInjective a6DuadStabilizer.subtype a6DuadStabilizer.subtype_injective).symm
  have hEc:Nat.card E=4:=(Nat.card_congr eE.toEquiv).trans a6DuadCore_card
  let : Nontrivial E := Finite.one_lt_card_iff_nontrivial.mp (by omega)
  let := a6DuadCore_elementary
  have hEe:IsElementaryAbelian 2 E:={
    is_comm.comm := fun x y => eE.injective (by
      simpa only [map_mul] using IsMulCommutative.is_comm.comm (eE x) (eE y))
    exponent_dvd_p := by
      rw [Monoid.exponent_eq_of_mulEquiv eE]
      exact IsElementaryAbelian.exponent_dvd_p 2 _ }
  let :=hEe
  let hE4:IsKleinFour E:=⟨hEc,IsElementaryAbelian.exponent_eq_prime⟩
  have hRA:(R:Subgroup D)≤A:=by
    rw [hR]
    exact map_le_iff_le_comap.mp (hU ▸ a6Borel_le_duadStabilizer)
  have hER:E≤(R:Subgroup D):=by
    have hh:=pCoreIn_le_sylow A (R.subtype hRA)
    simpa only [Sylow.coe_subtype,map_subgroupOf_eq_of_le hRA] using hh
  refine ⟨E,hE4,hR ▸ hER,s,hs,?_⟩
  intro he
  change A.map (D.normalizerMonoidHom s).toMonoidHom = B at hsP
  have hcore:A.pCoreIn 2=B.pCoreIn 2:=by
    rw [←hsP,←map_pCoreIn_of_injective 2 A (D.normalizerMonoidHom s).toMonoidHom (D.normalizerMonoidHom s).injective]
    exact he.symm
  have hAB:A⊔B=⊤:=by
    apply map_injective (f:=e.toMonoidHom) e.injective
    rw [Subgroup.map_sup,map_comap_eq_self_of_surjective e.surjective,
      map_comap_eq_self_of_surjective e.surjective,a6_parabolics_sup,
      map_top_of_surjective _ e.surjective]
  have hAN:A≤normalizer (E:Set D):=le_normalizer_twoCore A
  have hBN:B≤normalizer (E:Set D):=by
    change B≤normalizer (A.pCoreIn 2:Set D)
    rw [hcore]
    exact le_normalizer_twoCore B
  let : E.Normal:=normalizer_eq_top_iff.mp (top_unique (hAB ▸ sup_le hAN hBN))
  let : IsSimpleGroup A6:=alternatingGroup.isSimpleGroup (by simp)
  let : IsSimpleGroup D:=e.isSimpleGroup
  rcases IsSimpleGroup.eq_bot_or_eq_top_of_normal E inferInstance with hh|hh
  · have hc:=E.eq_bot_iff_card.mp hh
    omega
  · have hc:Nat.card E=Nat.card A6:=(Nat.card_congr (MulEquiv.subgroupCongr hh).toEquiv).trans
      ((Nat.card_congr (topEquiv:(⊤:Subgroup D)≃*D).toEquiv).trans (Nat.card_congr e.toEquiv))
    rw [AlternatingSix.ShadowLocal.card_A6] at hc
    omega

open ComponentRefinement
variable {L : Subgroup G} {S : Sylow 2 H} {z : G}

/-- The moving four-group and actor on the literal original ambient component. -/
theorem MathieuSourceSetup.alternating_six_four_movement
    (c : MathieuSourceSetup H L M S z)
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hempty : gammaEvenZero (Chapter1.He G) M = ∅)
    (e : L ≃* A6) :
    ∃ E : Subgroup L, IsKleinFour E ∧
      E ≤ ((S : Subgroup H).map H.subtype).subgroupOf L ∧
      ∃ s ∈ (S : Subgroup H).map H.subtype, s ∈ normalizer (L : Set G) ∧
        (E.map L.subtype).conjBy s ≠ E.map L.subtype := by
  let D:=L.subgroupOf H
  let eD:D≃*L:=subgroupOfEquivOfLe c.component_le
  have hDL:D.map H.subtype=L:=map_subgroupOf_eq_of_le c.component_le
  have hout:¬D.map H.subtype≤M:=((c.hypotheses115 hG).component_inputs D c.component).1
  obtain ⟨F,hF,hFS,s,hs,hm⟩:=alternating_six_four_movement_source c.gamma hempty S
    (c.hypotheses115 hG).mem_HeOver.2.2 D c.component hout (eD.trans e)
  let E:=F.map eD.toMonoidHom
  let eF:=F.equivMapOfInjective eD.toMonoidHom eD.injective
  let :=hF
  have hE:IsKleinFour E:={
    card_four := (Nat.card_congr eF.toEquiv).symm.trans IsKleinFour.card_four
    exponent_two := (Monoid.exponent_eq_of_mulEquiv eF).symm.trans IsKleinFour.exponent_two }
  have hES:E≤((S:Subgroup H).map H.subtype).subgroupOf L:=by
    rintro _ ⟨f,hf,rfl⟩
    exact mem_map_of_mem H.subtype (hFS hf)
  have hsN:(s:H).val∈normalizer (L:Set G):=by
    rw [←hDL]
    exact D.le_normalizer_map H.subtype (mem_map_of_mem H.subtype s.property)
  refine ⟨E,hE,hES,(s:H),mem_map_of_mem H.subtype hs,hsN,?_⟩
  intro he
  apply hm
  apply map_injective (f:=H.subtype.comp D.subtype)
    (H.subtype_injective.comp D.subtype_injective)
  have hFE:F.map (H.subtype.comp D.subtype)=E.map L.subtype:=by
    rw [show E=F.map eD.toMonoidHom from rfl,map_map]
    rfl
  have hconj:(F.map (D.normalizerMonoidHom s).toMonoidHom).map
      (H.subtype.comp D.subtype)=(E.map L.subtype).conjBy (s:H).val:=by
    rw [←hFE,conjBy,map_map,map_map]
    rfl
  rw [hconj,hFE]
  exact he
end CFSG.Quasithin.Chapter2.Section05.ComponentSelection
