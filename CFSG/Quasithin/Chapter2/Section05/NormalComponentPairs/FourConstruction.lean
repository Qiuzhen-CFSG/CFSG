module

public import CFSG.Quasithin.Chapter2.Section05.NormalComponentPairs.NormalizerSource
public import CFSG.Quasithin.Chapter2.Section05.NormalComponentPairs.RankBound
public import Theory.GroupTheory.CentralSylowNormalClosure
public import CFSG.Quasithin.Chapter2.Section05.ComponentSelection.CentralProjectionSource
public import CFSG.Quasithin.Chapter2.Section05.ComponentSelection.SmallSourceClassification

/-!
# The actual four-group generated by the projected central involution

For a largest local pair (U,L) with U ≤ S, source 2.5.10 puts Z(S) inside U.
The normal closure of the projected involution zK in L is elementary and
lies in O₂(L), by characteristic two. Normality of K puts that closure in K.
The original small Sylow shape bounds its order by four. It cannot have
order two: L would then centralize zK and t, hence z, contradicting L ≰ M.
Thus it is a normal four-group contained in S ∩ K.

The explicit t,zK hypotheses are exactly preceding source 2.5.8(4) and
2.5.11(1--2), whose assembly producer retains the original tuple. No local
pair classification or normalizer equality is assumed.
Source: Aschbacher--Smith 2.5.12, printed pp.557--558.
-/

public section
namespace CFSG.Quasithin.Chapter2.Section05
open ClassificationModels
open Subgroup Theory.GroupTheory A6Shadow.Frattini ComponentSelection
variable {G : Type*} [Group G] [Finite G] {κ : GroupClass}
  {M H K Y U L : Subgroup G} {t z zK : G}

/-- The moving projected involution constructs the source four-group. -/
theorem largest_pair_exists_normal_four
    (hG : IsSimpleQTKE κ G) (T : Sylow 2 G)
    (hM : IsMaximalTwoLocal M) (hTM : (T : Subgroup G) ≤ M)
    (hp : (U, L) ∈ largestLocalPairs M H) (hUY : U ≤ Y)
    (hKn : H ≤ normalizer (K : Set G))
    (hshape : SourceSylowTwoShape (Y.subgroupOf K))
    (hzK : orderOf zK = 2) (hzKK : zK ∈ K) (hzKY : zK ∈ centerIn Y)
    (ht : H ≤ centralizer ({t} : Set G))
    (hzspan : z ∈ zpowers t ⊔ zpowers zK)
    (hzM : centralizer ({z} : Set G) ≤ M) :
    ∃ E : Subgroup G, E ≤ Y ⊓ K ∧ IsKleinFour E ∧
      L ≤ normalizer (E : Set G) ∧ E ≤ twoCore L ∧ zK ∈ E := by
  obtain ⟨P, hP⟩ := (largest_pair_sylows hG T hM hTM hp).2.2
  have hzKU : zK ∈ U := largest_pair_center_le hG T hM hTM hp hUY hzKY
  have hzKL : zK ∈ L := hp.1.1.2.2.2.1 hzKU
  let w : L := ⟨zK, hzKL⟩
  let Z := zpowers w
  let W := normalClosure (Z : Set L)
  let E := W.map L.subtype
  have hw : orderOf w = 2 := by simpa only [w, Subgroup.orderOf_mk] using hzK
  have hc : Z ≤ centralizer (P : Set L) := by
    apply zpowers_le.mpr
    intro p hpP
    apply Subtype.ext
    exact hzKY.2 p.val (hUY (hP ▸ mem_map_of_mem L.subtype hpP))
  have hchar := Chapter1.mem_He_iff.mp hp.1.1.2.1
  let : IsElementaryAbelian 2 Z := IsElementaryAbelian.zpowers_of_pow_eq_one
    (by rw [← hw]; exact pow_orderOf_eq_one w)
  obtain ⟨hWe, hWcore⟩ := central_sylow_normalClosure_elementary P Z hc hchar
  let : IsElementaryAbelian 2 W := hWe
  have hEcore : E ≤ twoCore L := Subgroup.map_mono hWcore
  have hEU : E ≤ U := hEcore.trans (hP ▸ pCoreIn_le_sylow L P)
  have hEY : E ≤ Y := hEU.trans hUY
  let : (K.subgroupOf L).Normal := ⟨by
    intro k hk l
    exact (hKn (hp.1.2 l.property) k.val).mp hk⟩
  have hWK : W ≤ K.subgroupOf L := normalClosure_le_normal (zpowers_le.mpr hzKK)
  have hEK : E ≤ K := by
    rintro _ ⟨w, hw, rfl⟩
    exact hWK hw
  have hEe : IsElementaryAbelian 2 E := IsElementaryAbelian.map L.subtype
  have hcardE : Nat.card E ≤ 4 := hshape.component_elementary_card_le_four
    Y K E hEY hEK hEe
  have hcardW : Nat.card W ≤ 4 := by
    rwa [Subgroup.card_map_of_injective L.subtype_injective] at hcardE
  have hmove : w ∉ center L := by
    intro hwc
    have hzt : t ∈ centralizer (L : Set G) := by
      intro l hl
      exact mem_centralizer_singleton_iff.mp (ht (hp.1.2 hl))
    have hzkw : zK ∈ centralizer (L : Set G) := by
      intro l hl
      exact congrArg Subtype.val (mem_center_iff.mp hwc ⟨l, hl⟩)
    have hzz : z ∈ centralizer (L : Set G) :=
      (sup_le (zpowers_le.mpr hzt) (zpowers_le.mpr hzkw)) hzspan
    apply hp.1.1.2.2.2.2
    intro l hl
    exact hzM (mem_centralizer_singleton_iff.mpr (hzz l hl))
  obtain ⟨hfour, _⟩ := moving_involution_normalClosure_four P w hw hc hchar hmove hcardW
  let f : W ≃* E := W.equivMapOfInjective L.subtype L.subtype_injective
  have hEf : IsKleinFour E := ⟨(Nat.card_congr f.toEquiv).symm.trans hfour.card_four,
    (Monoid.exponent_eq_of_mulEquiv f).symm.trans hfour.exponent_two⟩
  have hn : L ≤ normalizer (E : Set G) := by
    have hh := W.le_normalizer_map L.subtype
    rw [normalizer_eq_top, ← MonoidHom.range_eq_map, range_subtype] at hh
    exact hh
  exact ⟨E, le_inf hEY hEK, hEf, hn, hEcore,
    mem_map_of_mem L.subtype (le_normalClosure (mem_zpowers w))⟩

/-- The four-group construction on the literal original source tuple, with
all projection and rank premises discharged by earlier source theorems. -/
theorem largest_pair_exists_normal_four_of_source
    {S : Sylow 2 H}
    (c : ComponentRefinement.MathieuSourceSetup H K M S z)
    [(K.subgroupOf H).Normal]
    (hG : IsSimpleQTKE KnownSimple.IsKnownSimple G)
    (hempty : gammaEvenZero (Chapter1.He G) M = ∅)
    (hgen : H = K ⊔ (S : Subgroup H).map H.subtype)
    (hb : ¬ IsBenderModel K)
    (hp : (U, L) ∈ largestLocalPairs M H)
    (hUS : U ≤ (S : Subgroup H).map H.subtype) :
    ∃ E : Subgroup G, E ≤ (S : Subgroup H).map H.subtype ⊓ K ∧
      IsKleinFour E ∧ L ≤ normalizer (E : Set G) ∧ E ≤ twoCore L := by
  obtain ⟨t, zK, ht, hzspan, hzK, hzKM, _⟩ :=
    ComponentSelection.MathieuSourceSetup.normal_component_central_projection c hG hempty hgen
  obtain ⟨E, hES, hE, hLN, hEc, _⟩ := largest_pair_exists_normal_four hG c.T
    c.maximal c.sylow_le hp hUS
    ((normal_subgroupOf_iff_le_normalizer c.component_le).mp inferInstance)
    (ComponentSelection.MathieuSourceSetup.small_source_structure c hG hempty hgen hb).2.2.2
    hzK hzKM.1 hzKM.2 ht hzspan (c.hypotheses115 hG).centralizer_le
  exact ⟨E, hES, hE, hLN, hEc⟩

end CFSG.Quasithin.Chapter2.Section05
