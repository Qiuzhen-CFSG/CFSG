module

public import CFSG.Quasithin.Chapter2.Section01To03.ComponentRefinement.LieType.Ree.TitsLocal.BlockLayers.ComponentOrbit

/-!
# The Tits second-overgroup block obstruction

The actual component orbit supplies a normal direct-power base with
two-group quotient in the overgroup generated by the second parabolic and S.
Two-perfection puts a relative block in this base. Its coordinate actions
on the two-cores would have square-one commutators, contrary to the checked
second-parabolic actor calculation. Thus this overgroup has no relative block.

This discharges the coordinate-section premise of the block-layer calculation
for Aschbacher–Smith 2.3.9(7), printed p.526. The result uses only the local
setup, the actual Tits equivalence, and the identified invariant right
parabolic. The marking, involution projection, left-parabolic identification,
HeOver membership, movement and escape assumptions are unnecessary here.
Constructing the invariant pair and proving its HeOver membership remain
with the source-theorem assembly owner.
-/

public section

namespace CFSG.Quasithin.Chapter2.ComponentRefinement.LieType.Ree

open Subgroup ChapterC

variable {G : Type*} [Group G] {H L M : Subgroup G} {S : Sylow 2 H} {z : G}

/-- No subgroup subnormal in the actual second overgroup is short. -/
theorem titsSecondOver_not_short (h : LocalSetup H L M S z)
    (e : L ≃* Tits.ParrottGroup)
    (d : InvariantPair L ((S : Subgroup H).map H.subtype))
    (hr : d.right = titsSecond e) (B : Subgroup d.rightOver)
    (hs : B.IsSubnormal) : ¬ IsShort B := by
  let := h.finite
  obtain ⟨c⟩ := tits_secondCoreSection h e d hr
  exact tits_not_short_of_secondCoreSection c B hs

/-- The requested normal two-layer conclusion follows from exclusion of the
relative block. There is no additional coordinate-section premise. -/
theorem titsSecondOver_layers (h : LocalSetup H L M S z)
    (e : L ≃* Tits.ParrottGroup)
    (d : InvariantPair L ((S : Subgroup H).map H.subtype))
    (hr : d.right = titsSecond e) (B : Subgroup d.rightOver)
    (hb : IsBlock B) : HasNoncentralTwoLayer B := by
  exact (titsSecondOver_not_short h e d hr B hb.subnormal hb.short).elim

/-- The exact escaping-block interface consumed by
`false_of_right_calculations`, with the structural premise discharged. -/
theorem titsSecondOver_escaping_layers (h : LocalSetup H L M S z)
    (e : L ≃* Tits.ParrottGroup)
    (d : InvariantPair L ((S : Subgroup H).map H.subtype))
    (hr : d.right = titsSecond e) :
    ∀ B : Subgroup d.rightOver, IsBlock B →
      B.map d.rightOver.subtype =
        ⁅B.map d.rightOver.subtype,
          Stellmacher.elementaryAbelianMaxJ ((S : Subgroup H).map H.subtype)⁆ →
      ¬ B.map d.rightOver.subtype ≤ M → HasNoncentralTwoLayer B := by
  intro B hb _ _
  exact titsSecondOver_layers h e d hr B hb

end CFSG.Quasithin.Chapter2.ComponentRefinement.LieType.Ree

end
