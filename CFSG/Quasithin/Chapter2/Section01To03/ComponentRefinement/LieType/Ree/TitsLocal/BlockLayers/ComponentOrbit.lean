module

public import Theory.SpecificGroups.Tits.RelativeSecondBlockLayers.ComponentOrbit
public import Theory.GroupTheory.ComponentLocalDirectPower
public import Theory.GroupTheory.ComponentLocalOrbitCore
public import CFSG.Quasithin.Chapter2.Section01To03.ComponentRefinement.LieType.Ree.TitsLocal.Marking
public import CFSG.Quasithin.Chapter2.Section01To03.ComponentRefinement.LieType.Ree.TitsLocal.BlockLayers

/-!
# The second Tits parabolic across the component orbit

The base is generated by the actual Sylow-conjugates of the right parabolic.
It is normal in the overgroup generated by that parabolic and the Sylow
subgroup, with two-group quotient. The component remains subnormal relative
to H throughout the construction; the Sylow subgroup may permute components.

The checked Tits equivalence gives a trivial component center. Stabilizer
invariance identifies parabolics in the same component, while distinct
components commute and are independent. The resulting direct-power
equivalence supplies surjective parabolic coordinates, exact two-core
images, and trivial common kernel. No marking, involution-projection, or
local characteristic-two hypothesis is required for this construction.

This constructs the structural section used by `tits_layers_of_secondCoreSection`
in the parabolic argument of Aschbacher–Smith 2.3.9(7), printed p.526.
-/

@[expose] public section

open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter2.ComponentRefinement.LieType.Ree

variable {G : Type*} [Group G] {H L M A : Subgroup G} {S : Sylow 2 H} {z : G}

/-- The actual conjugate-generated base, restricted to the right overgroup. -/
def titsSecondOrbitBase (d : InvariantPair L A) : Subgroup d.rightOver :=
  (componentOrbit (d.right.map L.subtype) A).subgroupOf d.rightOver

/-- Construct every field of the section, with its base identified as the
actual parabolic orbit. Only right-parabolic identification is needed. -/
theorem exists_tits_secondCoreSection (h : LocalSetup H L M S z)
    (e : L ≃* Tits.ParrottGroup)
    (d : InvariantPair L ((S : Subgroup H).map H.subtype))
    (hr : d.right = titsSecond e) :
    ∃ c : TitsSecondCoreSection d.rightOver, c.base = titsSecondOrbitBase d := by
  let := h.finite
  let A := (S : Subgroup H).map H.subtype
  let P := d.right.map L.subtype
  let F := P.subgroupOf H
  have hPH : P ≤ H := (map_subtype_le d.right).trans h.component_le
  have hFL : F ≤ L.subgroupOf H := fun _ hx => map_subtype_le d.right hx
  have hinv : (S : Subgroup H) ⊓ normalizer (L.subgroupOf H : Set H) ≤
      normalizer (F : Set H) := by
    rw [← subgroupOf_normalizer_eq h.component_le]
    change (S : Subgroup H) ⊓ (normalizer (L : Set G)).subgroupOf H ≤
      normalizer (P.subgroupOf H : Set H)
    rw [← subgroupOf_normalizer_eq hPH]
    intro x hx
    exact d.invariant_right ⟨mem_map_of_mem H.subtype hx.1, hx.2⟩
  have hZ : center (L.subgroupOf H) = ⊥ :=
    Tits.RelativeSylowMarking.center_eq_bot
      ((subgroupOfEquivOfLe h.component_le).trans (titsAtlasEquiv e))
  obtain ⟨n, ⟨ep⟩⟩ := h.component.local_orbit_equiv_power hZ hFL hinv
  have hmap : (componentOrbit F (S : Subgroup H)).map H.subtype =
      componentOrbit P A := by
    rw [map_componentOrbit, map_subgroupOf_eq_of_le hPH]
  let eo : componentOrbit F (S : Subgroup H) ≃* componentOrbit P A :=
    ((componentOrbit F (S : Subgroup H)).equivMapOfInjective
      H.subtype H.subtype_injective).trans (MulEquiv.subgroupCongr hmap)
  let er : d.right ≃* Tits.ExceptionalParabolics.second :=
    (MulEquiv.subgroupCongr hr).trans
      ((titsAtlasEquiv e).symm.subgroupMap Tits.ExceptionalParabolics.second).symm
  let ef : F ≃* Tits.ExceptionalParabolics.second :=
    (subgroupOfEquivOfLe hPH).trans
      ((d.right.equivMapOfInjective L.subtype L.subtype_injective).symm.trans er)
  let N := titsSecondOrbitBase d
  let en : N ≃* (Fin n → Tits.ExceptionalParabolics.second) :=
    (subgroupOfEquivOfLe (componentOrbit_le_sup P A)).trans
      (eo.symm.trans (ep.trans (MulEquiv.piCongrRight fun _ => ef)))
  let : N.Normal := componentOrbit_normal_subgroupOf_sup P A
  have hq : IsPGroup 2 (d.rightOver ⧸ N) :=
    local_orbit_quotient_isPGroup P A (S.isPGroup'.map H.subtype)
  refine ⟨{
    base := N
    normal := inferInstance
    quotient_two := hq
    count := n
    projection := Tits.RelativeSecondBlockLayers.ComponentOrbit.projection en
    surjective := Tits.RelativeSecondBlockLayers.ComponentOrbit.projection_surjective en
    core_image := Tits.RelativeSecondBlockLayers.ComponentOrbit.projection_core_image en
    kernel_two := ?_ }, rfl⟩
  rw [Tits.RelativeSecondBlockLayers.ComponentOrbit.iInf_projection_ker_eq_bot]
  exact IsPGroup.of_bot

/-- The section required by the existing Tits second-parabolic block theorem. -/
theorem tits_secondCoreSection (h : LocalSetup H L M S z)
    (e : L ≃* Tits.ParrottGroup)
    (d : InvariantPair L ((S : Subgroup H).map H.subtype))
    (hr : d.right = titsSecond e) : Nonempty (TitsSecondCoreSection d.rightOver) := by
  obtain ⟨c, _⟩ := exists_tits_secondCoreSection h e d hr
  exact ⟨c⟩

end CFSG.Quasithin.Chapter2.ComponentRefinement.LieType.Ree

end
