module

public import CFSG.Quasithin.Chapter2.Section01To03.ComponentRefinement.LieType.Binary.RelativeBlocks.FlagGeometry
public import CFSG.Quasithin.Chapter2.Section01To03.ComponentRefinement.LieType.Binary.RelativeBlocks.MiddleFlag.MatrixObstruction
public import Theory.GroupTheory.ComponentLocalDirectPower

/-!
# No blocks in the degree-five middle-flag overgroup

A flag of types {2,3} has exactly a two-space contained in a three-space.
Transport through the actual binary linear model identifies its stabilizer
with the intersection of their two parabolics, with block sizes 2,1,2.

The centerless-component orbit theorem embeds every short subnormal block
of the full-S overgroup into a finite power of that matrix group. This keeps
subnormality relative to the displayed overgroup and allows S to permute
components; it does not assert that S normalizes the original component.

The matrix obstruction uses the two abelian self-centralizing radicals
at the constituent subspaces. Their intersection is generated by mutual
commutators, contradicting two-perfection and irreducibility for a short
subnormal group. Combining these results excludes every block of the
full-S middle-flag overgroup, and in particular every escaping block
required by the relative-block calculation.

Source: Aschbacher–Smith 2.3.9(7), printed pp.525–526; the actual short-group
and block definitions are C.1.7, printed p.123.
-/

@[expose] public section

open Subgroup
namespace CFSG.Quasithin.Chapter2.ComponentRefinement.LieType.Binary

/-- Dimensions uniquely identify the two constituents of the middle flag. -/
theorem middle_flag_pair (F : Flag 5) (hF : F.types = {2, 3}) :
    ∃ W₂ W₃ : Space 5, F.spaces = {W₂, W₃} ∧
      Module.finrank (ZMod 2) W₂ = 2 ∧ Module.finrank (ZMod 2) W₃ = 3 ∧ W₂ ≤ W₃ := by
  classical
  have ht₂ : 2 ∈ F.types := by rw [hF]; simp
  have ht₃ : 3 ∈ F.types := by rw [hF]; simp
  obtain ⟨W₂, hm₂, hd₂⟩ := Finset.mem_image.mp ht₂
  obtain ⟨W₃, hm₃, hd₃⟩ := Finset.mem_image.mp ht₃
  have unique (W W' : Space 5) (hW : W ∈ F.spaces) (hW' : W' ∈ F.spaces)
      (hd : Module.finrank (ZMod 2) W = Module.finrank (ZMod 2) W') : W = W' := by
    rcases F.chain W hW W' hW' with hle | hle
    · exact Submodule.eq_of_le_of_finrank_eq hle hd
    · exact (Submodule.eq_of_le_of_finrank_eq hle hd.symm).symm
  refine ⟨W₂, W₃, ?_, hd₂, hd₃, ?_⟩
  · apply Finset.Subset.antisymm
    · intro W hW
      have hd : Module.finrank (ZMod 2) W ∈ F.types := Finset.mem_image.mpr ⟨W, hW, rfl⟩
      rw [hF] at hd
      simp only [Finset.mem_insert, Finset.mem_singleton] at hd ⊢
      exact hd.elim (fun hd => Or.inl (unique W W₂ hW hm₂ (hd.trans hd₂.symm)))
        (fun hd => Or.inr (unique W W₃ hW hm₃ (hd.trans hd₃.symm)))
    · intro W hW
      simp only [Finset.mem_insert, Finset.mem_singleton] at hW
      exact hW.elim (fun h => h ▸ hm₂) (fun h => h ▸ hm₃)
  · rcases F.chain W₂ hm₂ W₃ hm₃ with hle | hle
    · exact hle
    · have hd := Submodule.finrank_mono hle
      omega

variable {G : Type*} [Group G] {H L M : Subgroup G} {S : Sylow 2 H} {z : G}
  {n : ℕ} [NeZero n]

/-- The literal matrix image of a two-constituent flag stabilizer. -/
theorem flagStabilizer_pair_map (e : L ≃* PSL n) (F : Flag n) (W W' : Space n)
    (hF : F.spaces = {W, W'}) :
    (flagStabilizer e F).map (linearModel e).toMonoidHom =
      BinaryLinear.parabolic W ⊓ BinaryLinear.parabolic W' := by
  classical
  ext g
  rw [mem_map_equiv, mem_flagStabilizer, hF]
  simp only [Finset.mem_insert, Finset.mem_singleton, forall_eq_or_imp, forall_eq,
    MulEquiv.apply_symm_apply, mem_inf]
  rfl

/-- Preserve every block as a subnormal embedded group in a finite power of the
intrinsic flag stabilizer; no ambient normality of the component is used. -/
theorem block_embedding_in_flag_power (h : LocalSetup H L M S z)
    (e : L ≃* PSL n) (F : Flag n)
    (hinv : FlagInvariant e ((S : Subgroup H).map H.subtype) F)
    (B : Subgroup (flagOvergroup e F ((S : Subgroup H).map H.subtype)))
    (hB : ChapterC.IsBlock B) :
    ∃ (k : ℕ) (f : B →* (Fin k → flagStabilizer e F)),
      Function.Injective f ∧ f.range.IsSubnormal := by
  let := h.finite
  let K := ambientFlagStabilizer e F
  let K' := K.subgroupOf H
  have hKH : K ≤ H := (ambientFlagStabilizer_le e F).trans h.component_le
  have hK'L : K' ≤ L.subgroupOf H := fun _ hx => ambientFlagStabilizer_le e F hx
  have hinv' : (S : Subgroup H) ⊓ normalizer (L.subgroupOf H : Set H) ≤
      normalizer (K' : Set H) := by
    rw [← subgroupOf_normalizer_eq h.component_le]
    change (S : Subgroup H) ⊓ (normalizer (L : Set G)).subgroupOf H ≤
      normalizer (K.subgroupOf H : Set H)
    rw [← subgroupOf_normalizer_eq hKH]
    intro x hx
    exact hinv ⟨mem_map_of_mem H.subtype hx.1, hx.2⟩
  let P' := K' ⊔ (S : Subgroup H)
  have hmap : P'.map H.subtype = flagOvergroup e F ((S : Subgroup H).map H.subtype) := by
    rw [Subgroup.map_sup, map_subgroupOf_eq_of_le hKH]
    rfl
  let eP := (P'.equivMapOfInjective H.subtype H.subtype_injective).trans
    (MulEquiv.subgroupCongr hmap)
  let eK : K' ≃* flagStabilizer e F := (subgroupOfEquivOfLe hKH).trans
    ((flagStabilizer e F).equivMapOfInjective L.subtype L.subtype_injective).symm
  let g := eP.symm.toMonoidHom.comp B.subtype
  have hg : Function.Injective g := eP.symm.injective.comp B.subtype_injective
  have hs : g.range.IsSubnormal := by
    rw [MonoidHom.range_comp, B.range_subtype]
    exact hB.subnormal.map eP.symm.surjective
  have hZ := center_eq_bot ((subgroupOfEquivOfLe h.component_le).trans e)
  obtain ⟨k, f, hf, hs⟩ := h.component.local_adjoin_embedding hZ hK'L hinv'
    S.isPGroup' hB.short.twoPerfect g hg hs
  let E : (Fin k → K') ≃* (Fin k → flagStabilizer e F) :=
    MulEquiv.piCongrRight (fun _ => eK)
  refine ⟨k, E.toMonoidHom.comp f, E.injective.comp hf, ?_⟩
  rw [MonoidHom.range_comp]
  exact hs.map E.surjective

/-- The degree-five middle flag gives a literal matrix embedding into powers
of the parabolic with successive dimensions 2, 1, 2. -/
theorem middle_flag_block_embedding (h : LocalSetup H L M S z)
    (e : L ≃* PSL 5) (F : Flag 5) (htypes : F.types = {2, 3})
    (hinv : FlagInvariant e ((S : Subgroup H).map H.subtype) F)
    (B : Subgroup (flagOvergroup e F ((S : Subgroup H).map H.subtype)))
    (hB : ChapterC.IsBlock B) :
    ∃ W₂ W₃ : Space 5, Module.finrank (ZMod 2) W₂ = 2 ∧
      Module.finrank (ZMod 2) W₃ = 3 ∧ W₂ ≤ W₃ ∧
      ∃ (k : ℕ) (f : B →* (Fin k →
        (BinaryLinear.parabolic W₂ ⊓ BinaryLinear.parabolic W₃ : Subgroup _))),
        Function.Injective f ∧ f.range.IsSubnormal := by
  obtain ⟨W₂, W₃, hspaces, hd₂, hd₃, hle⟩ := middle_flag_pair F htypes
  obtain ⟨k, f, hf, hs⟩ := block_embedding_in_flag_power h e F hinv B hB
  let eK := ((linearModel e).subgroupMap (flagStabilizer e F)).trans
    (MulEquiv.subgroupCongr (flagStabilizer_pair_map e F W₂ W₃ hspaces))
  let E := MulEquiv.piCongrRight (fun _ : Fin k => eK)
  refine ⟨W₂, W₃, hd₂, hd₃, hle, k, E.toMonoidHom.comp f, E.injective.comp hf, ?_⟩
  rw [MonoidHom.range_comp]
  exact hs.map E.surjective

/-- The full-S middle-flag overgroup has no short subnormal block. Only flag
invariance and the two constituent dimensions are needed beyond the local
setup and the actual model isomorphism. -/
theorem not_isBlock_of_middle_flag (h : LocalSetup H L M S z)
    (e : L ≃* PSL 5) (F : Flag 5) (htypes : F.types = {2, 3})
    (hinv : FlagInvariant e ((S : Subgroup H).map H.subtype) F)
    (B : Subgroup (flagOvergroup e F ((S : Subgroup H).map H.subtype))) :
    ¬ ChapterC.IsBlock B := by
  intro hB
  obtain ⟨W₂, W₃, hd₂, hd₃, hle, k, f, hf, hs⟩ :=
    middle_flag_block_embedding h e F htypes hinv B hB
  exact not_isShort_of_middle_flag_power W₂ W₃ hd₂ hd₃ hle k f hf hs hB.short

end CFSG.Quasithin.Chapter2.ComponentRefinement.LieType.Binary

end
