module

public import CFSG.Quasithin.Chapter2.Section01To03.ComponentRefinement.LieType.Binary.Geometry
public import CFSG.Quasithin.Chapter2.Section01To03.ComponentRefinement.LieType.Binary.RelativeBlocks.MiddleFlag.MatrixObstruction.RadicalCriterion
public import Theory.SpecificGroups.BinaryLinear.NestedRadicals

/-!
# No short subnormal group in powers of the binary 2–1–2 parabolic

Let W₂ < W₃ have dimensions two and three in a binary five-space. The
radicals at W₂ and W₃ are abelian self-centralizing normal two-subgroups
of the common flag stabilizer. Their intersection is generated by their
mutual commutators, by the rank-one calculation in `NestedRadicals`.
The radical-pair criterion therefore excludes an injective subnormal
image of any short group in every finite power of this stabilizer.

The domain of the embedding is retained throughout. This supplies the
matrix obstruction for the middle-flag embedding; the source-theorem
assembly belongs to the parent `MiddleFlag` development.

Source: Aschbacher–Smith 2.3.9(7), printed pp.525–526, and the genuine
short-group definition C.1.7, printed p.123.
-/

public section

open Subgroup
namespace CFSG.Quasithin.Chapter2.ComponentRefinement.LieType.Binary

/-- The 2–1–2 flag parabolic has no short subnormal embedded group in any finite power. -/
theorem not_isShort_of_middle_flag_power
    (W₂ W₃ : Space 5) (hd₂ : Module.finrank (ZMod 2) W₂ = 2)
    (hd₃ : Module.finrank (ZMod 2) W₃ = 3) (h₂₃ : W₂ ≤ W₃)
    {D : Type*} [Group D] (k : ℕ)
    (f : D →* (Fin k → (BinaryLinear.parabolic W₂ ⊓ BinaryLinear.parabolic W₃ : Subgroup _)))
    (hf : Function.Injective f) (hs : f.range.IsSubnormal) : ¬ ChapterC.IsShort D := by
  let : Finite (BinaryLinear.GL (Vector 5)) := Finite.of_injective
    (fun g : BinaryLinear.GL (Vector 5) => (g : Vector 5 → Vector 5)) DFunLike.coe_injective
  let Q := BinaryLinear.parabolic W₂ ⊓ BinaryLinear.parabolic W₃
  let R := (BinaryLinear.radical W₂).subgroupOf Q
  let S := (BinaryLinear.radical W₃).subgroupOf Q
  have hRQ : BinaryLinear.radical W₂ ≤ Q := le_inf
    (BinaryLinear.radical_le_parabolic W₂) (BinaryLinear.radical_le_nested_parabolic h₂₃)
  have hSQ : BinaryLinear.radical W₃ ≤ Q := le_inf
    (BinaryLinear.radical_le_smaller_parabolic h₂₃) (BinaryLinear.radical_le_parabolic W₃)
  let : R.Normal := normal_subgroupOf_of_le_normalizer
    ((show Q ≤ BinaryLinear.parabolic W₂ from inf_le_left).trans
      (BinaryLinear.parabolic_le_normalizer W₂))
  let : S.Normal := normal_subgroupOf_of_le_normalizer
    ((show Q ≤ BinaryLinear.parabolic W₃ from inf_le_right).trans
      (BinaryLinear.parabolic_le_normalizer W₃))
  have hmR : R.map Q.subtype = BinaryLinear.radical W₂ := map_subgroupOf_eq_of_le hRQ
  have hmS : S.map Q.subtype = BinaryLinear.radical W₃ := map_subgroupOf_eq_of_le hSQ
  have haR : ⁅R, R⁆ = ⊥ := by
    apply map_injective Q.subtype_injective
    rw [map_commutator, hmR, BinaryLinear.radical_commutative, Subgroup.map_bot]
  have haS : ⁅S, S⁆ = ⊥ := by
    apply map_injective Q.subtype_injective
    rw [map_commutator, hmS, BinaryLinear.radical_commutative, Subgroup.map_bot]
  have hW₂ : W₂ ≠ ⊥ ∧ W₂ ≠ ⊤ := by
    constructor
    · intro he
      rw [he, finrank_bot] at hd₂
      omega
    · intro he
      rw [he, finrank_top, Module.finrank_fin_fun] at hd₂
      omega
  have hW₃ : W₃ ≠ ⊥ ∧ W₃ ≠ ⊤ := by
    constructor
    · intro he
      rw [he, finrank_bot] at hd₃
      omega
    · intro he
      rw [he, finrank_top, Module.finrank_fin_fun] at hd₃
      omega
  have central (W : Space 5) (hW : W ≠ ⊥ ∧ W ≠ ⊤) (hWQ : BinaryLinear.radical W ≤ Q) :
      centralizer ((BinaryLinear.radical W).subgroupOf Q : Set Q) ≤
        (BinaryLinear.radical W).subgroupOf Q := by
    intro g hg
    apply BinaryLinear.centralizer_radical_le hW.1 hW.2
    rw [mem_centralizer_iff]
    intro r hr
    have hh := mem_centralizer_iff.mp hg (⟨r, hWQ hr⟩ : Q) hr
    exact congrArg Subtype.val hh
  have hlt : W₂ < W₃ := lt_of_le_of_ne h₂₃ (by
    intro he
    have he' := congrArg (fun W : Space 5 => Module.finrank (ZMod 2) W) he
    omega)
  have hRS : R ⊓ S ≤ ⁅R, S⁆ := by
    apply (map_le_map_iff_of_injective Q.subtype_injective).mp
    rw [map_inf _ _ _ Q.subtype_injective, map_commutator, hmR, hmS]
    exact BinaryLinear.radical_inf_le_commutator_of_finrank_two hd₂ hlt
  exact ChapterC.not_isShort_of_radical_pair_power R S
    (BinaryLinear.radical_two W₂).comap_subtype (BinaryLinear.radical_two W₃).comap_subtype
    haR haS (central W₂ hW₂ hRQ) (central W₃ hW₃ hSQ) hRS k f hf hs

end CFSG.Quasithin.Chapter2.ComponentRefinement.LieType.Binary
