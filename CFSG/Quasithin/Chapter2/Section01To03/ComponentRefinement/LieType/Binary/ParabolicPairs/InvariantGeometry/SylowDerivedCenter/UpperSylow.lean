module

public import CFSG.Quasithin.Chapter2.Section01To03.ComponentRefinement.LieType.Binary.ParabolicPairs.InvariantGeometry.SylowDerivedCenter.Coordinates
public import Theory.Representation.SL5TenDimensionalFirstCohomology.Classification.SeedExtraction.HeckeAction.FixedSpace
public import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Card

/-!
# Positive binary roots form a Sylow subgroup of SL₅(2)

The existing positive-root subgroup is a 2-group. Products of its ten root
transvections, in decreasing row order, recover ten freely chosen binary
parameters in their upper entries: the chosen order makes all cross terms
vanish. This gives at least 1024 elements. The actual SL/GL equivalence and
finite-field GL order formula give |SL₅(2)| = 9999360 = 2¹⁰ · 9765, so a
Sylow overgroup has exactly 1024 elements and must equal the root subgroup.

This supplies the Sylow input to the degree-five derived-center calculation
in the binary case of Aschbacher–Smith 2.3.9(7), printed pp.525–526. The
invariant-parabolic convention is on printed p.216; the derived-center and
geometric conclusions are separate from the Sylow assertion proved here.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter2.ComponentRefinement.LieType.Binary
open Representation.SL5TenDimensional.Classification.HeckeAction

-- Decreasing row order prevents products of two off-diagonal entries.
private def upperWord (f : Fin 10 → ZMod 2) : SL 5 :=
  Matrix.SpecialLinearGroup.transvection (show (3 : Fin 5) ≠ 4 by decide) (f 0) *
  Matrix.SpecialLinearGroup.transvection (show (2 : Fin 5) ≠ 3 by decide) (f 1) *
  Matrix.SpecialLinearGroup.transvection (show (2 : Fin 5) ≠ 4 by decide) (f 2) *
  Matrix.SpecialLinearGroup.transvection (show (1 : Fin 5) ≠ 2 by decide) (f 3) *
  Matrix.SpecialLinearGroup.transvection (show (1 : Fin 5) ≠ 3 by decide) (f 4) *
  Matrix.SpecialLinearGroup.transvection (show (1 : Fin 5) ≠ 4 by decide) (f 5) *
  Matrix.SpecialLinearGroup.transvection (show (0 : Fin 5) ≠ 1 by decide) (f 6) *
  Matrix.SpecialLinearGroup.transvection (show (0 : Fin 5) ≠ 2 by decide) (f 7) *
  Matrix.SpecialLinearGroup.transvection (show (0 : Fin 5) ≠ 3 by decide) (f 8) *
  Matrix.SpecialLinearGroup.transvection (show (0 : Fin 5) ≠ 4 by decide) (f 9)

private def upperEntries (A : SL 5) : Fin 10 → ZMod 2 :=
  ![A.val 3 4, A.val 2 3, A.val 2 4, A.val 1 2, A.val 1 3,
    A.val 1 4, A.val 0 1, A.val 0 2, A.val 0 3, A.val 0 4]

private theorem sl_transvection_val {i j : Fin 5} (h : i ≠ j) (c : ZMod 2) :
    (Matrix.SpecialLinearGroup.transvection h c).val = Matrix.transvection i j c := rfl

private theorem upperEntries_word (f : Fin 10 → ZMod 2) :
    upperEntries (upperWord f) = f := by
  funext k
  fin_cases k <;>
    simp [upperEntries, upperWord, sl_transvection_val] <;>
    simp [Matrix.transvection]

private theorem root_mem {i j : Fin 5} (hij : i < j) (c : ZMod 2) :
    Matrix.SpecialLinearGroup.transvection (ne_of_lt hij) c ∈ upperRootSubgroup := by
  rcases (by decide : ∀ c : ZMod 2, c = 0 ∨ c = 1) c with rfl | rfl
  · simpa only [Matrix.SpecialLinearGroup.transvection_coeff_zero] using upperRootSubgroup.one_mem
  · exact Subgroup.subset_closure ⟨i, j, hij, rfl⟩

private theorem upperWord_mem (f : Fin 10 → ZMod 2) : upperWord f ∈ upperRootSubgroup := by
  unfold upperWord
  repeat first
  | apply upperRootSubgroup.mul_mem
  | exact root_mem (by decide) _

private theorem sl_five_card : Nat.card (SL 5) = 9999360 := by
  let e := (slEquivLinear 5).trans
    (Matrix.GeneralLinearGroup.toLin.trans
      (LinearMap.GeneralLinearGroup.generalLinearEquiv (ZMod 2) (Vector 5))).symm
  rw [Nat.card_congr e.toEquiv, Matrix.card_GL_field]
  decide

private theorem upper_card_ge : 1024 ≤ Nat.card upperRootSubgroup := by
  let f : (Fin 10 → ZMod 2) → upperRootSubgroup := fun c => ⟨upperWord c, upperWord_mem c⟩
  have hf : Function.Injective f := by
    intro a b hab
    have h := congrArg (fun g : upperRootSubgroup => upperEntries g.val) hab
    exact (upperEntries_word a).symm.trans (h.trans (upperEntries_word b))
  have hc := Nat.card_le_card_of_injective f hf
  simpa only [Nat.card_fun, Nat.card_zmod, Nat.card_fin, show 2 ^ 10 = 1024 by decide] using hc

private theorem sylow_card (P : Sylow 2 (SL 5)) : Nat.card P = 1024 := by
  rw [P.card_eq_multiplicity, sl_five_card]
  have hfac : Nat.factorization 9999360 2 = 10 := by
    rw [show 9999360 = 2 ^ 10 * 9765 by decide,
      Nat.factorization_mul (by decide) (by decide), Finsupp.add_apply,
      Nat.factorization_pow_self Nat.prime_two,
      Nat.factorization_eq_zero_of_not_dvd (by decide : ¬ 2 ∣ 9765), add_zero]
  norm_num [hfac]

/-- The subgroup generated by all positive binary root transvections is Sylow in SL₅(2). -/
theorem exists_five_upperRoot_sylow :
    ∃ P : Sylow 2 (SL 5), (P : Subgroup (SL 5)) = upperRootSubgroup := by
  obtain ⟨P, hP⟩ := upperRootSubgroup_isPGroup.exists_le_sylow
  refine ⟨P, (Subgroup.eq_of_le_of_card_ge hP ?_).symm⟩
  exact (sylow_card P).le.trans upper_card_ge

end CFSG.Quasithin.Chapter2.ComponentRefinement.LieType.Binary

end
