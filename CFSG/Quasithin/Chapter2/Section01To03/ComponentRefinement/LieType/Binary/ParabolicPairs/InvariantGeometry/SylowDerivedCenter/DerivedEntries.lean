module

public import CFSG.Quasithin.Chapter2.Section01To03.ComponentRefinement.LieType.Binary.ParabolicPairs.InvariantGeometry.SylowDerivedCenter.Coordinates
public import Theory.Representation.SL5TenDimensionalFirstCohomology.Classification.SeedExtraction.HeckeAction.FixedSpace
/-!
# The rectangular center of the binary upper-root derived subgroup

Let `U` be the subgroup of SL₅(2) generated by its positive root
transvections. Every element of `[U,U]` is upper unitriangular with zero
first superdiagonal. The six remaining roots are commutators of positive
roots. Commuting with the roots at (0,2) and (2,4) forces the two entries
at (2,4) and (0,2) to vanish. Conversely, the four rectangular roots commute
with every derived element, and their products realize every matrix in
`FiveRectangle`.

The unitriangular closure argument adapts the private calculation in
`HeckeAction.FixedSpace`; the root commutator calculation follows the
matrix argument in `BinaryLinear.Perfect`. No Sylow assumption or full
unitriangular generation theorem is needed.

This is the concrete derived-center input to the invariant middle-parabolic
pair used in Aschbacher–Smith 2.3.9(7), printed pp.525–526; the invariant
parabolic convention is on printed p.216. The geometric interpretation is
proved separately in `SylowDerivedCenter.Coordinates`.
-/

@[expose] public section

namespace CFSG.Quasithin.Chapter2.ComponentRefinement.LieType.Binary
open Subgroup
open scoped commutatorElement
open Representation.SL5TenDimensional.Classification.HeckeAction

private abbrev U : Subgroup (SL 5) := upperRootSubgroup
private abbrev D : Subgroup (SL 5) := ⁅U, U⁆

private def Unitriangular (A : Matrix (Fin 5) (Fin 5) (ZMod 2)) : Prop :=
  A.BlockTriangular id ∧ ∀ i, A i i = 1

private theorem unitriangular_mul {A B : Matrix (Fin 5) (Fin 5) (ZMod 2)}
    (hA : Unitriangular A) (hB : Unitriangular B) : Unitriangular (A * B) := by
  refine ⟨hA.1.mul hB.1, ?_⟩
  intro i
  rw [Matrix.mul_apply, Finset.sum_eq_single i]
  · rw [hA.2, hB.2, one_mul]
  · intro j _ hji
    by_cases h : j < i
    · rw [hA.1 h, zero_mul]
    · rw [hB.1 (lt_of_le_of_ne (le_of_not_gt h) (Ne.symm hji)), mul_zero]
  · simp

private theorem unitriangular_transvection (i j : Fin 5) (hij : i < j) (c : ZMod 2) :
    Unitriangular (Matrix.SpecialLinearGroup.transvection (ne_of_lt hij) c).1 := by
  refine ⟨Matrix.blockTriangular_transvection (b := id) hij.le c, ?_⟩
  intro k
  simp only [Matrix.SpecialLinearGroup.transvection_coe, Matrix.add_apply, Matrix.one_apply_eq]
  have h : Matrix.single i j c k k = 0 := by
    by_cases hk : k = i
    · subst k; simp [(ne_of_lt hij).symm]
    · simp [Ne.symm hk]
  rw [h, add_zero]

private theorem upperRoot_unitriangular {g : SL 5} (hg : g ∈ upperRootSubgroup) :
    Unitriangular g.1 := by
  induction hg using Subgroup.closure_induction'' with
  | mem g hg =>
    obtain ⟨i, j, hij, rfl⟩ := hg
    exact unitriangular_transvection i j hij 1
  | inv_mem g hg =>
    obtain ⟨i, j, hij, rfl⟩ := hg
    rw [Matrix.SpecialLinearGroup.transvection_inv]
    exact unitriangular_transvection i j hij (-1)
  | one => exact ⟨Matrix.blockTriangular_one, fun i => Matrix.one_apply_eq i⟩
  | mul g h _ _ hg hh => exact unitriangular_mul hg hh

private theorem firstSuper_mul {A B : SL 5} (hA : A ∈ U) (hB : B ∈ U)
    (i j : Fin 5) (hij : j.val = i.val + 1) :
    (A * B).val i j = A.val i j + B.val i j := by
  obtain ⟨ha, ha1⟩ := upperRoot_unitriangular hA
  obtain ⟨hb, hb1⟩ := upperRoot_unitriangular hB
  have hne : i ≠ j := by intro he; subst j; omega
  change (A.val * B.val) i j = _
  rw [Matrix.mul_apply, Finset.sum_eq_add_of_mem i j
    (Finset.mem_univ _) (Finset.mem_univ _) hne]
  · rw [ha1, hb1, one_mul, mul_one, add_comm]
  · intro k _ hk
    by_cases hki : k < i
    · rw [show A.val i k = 0 from ha hki, zero_mul]
    · have hik : j < k := by
        have hki' : k.val ≠ i.val := fun he => hk.1 (Fin.ext he)
        have hkj' : k.val ≠ j.val := fun he => hk.2 (Fin.ext he)
        change ¬k.val < i.val at hki
        change j.val < k.val
        omega
      rw [show B.val k j = 0 from hb hik, mul_zero]

private theorem firstSuper_inv {A : SL 5} (hA : A ∈ U)
    (i j : Fin 5) (hij : j.val = i.val + 1) :
    A⁻¹.val i j = - A.val i j := by
  have h := firstSuper_mul hA (U.inv_mem hA) i j hij
  have hne : i ≠ j := by intro he; subst j; omega
  simp only [mul_inv_cancel, Matrix.SpecialLinearGroup.coe_one,
    Matrix.one_apply_ne hne] at h
  exact eq_neg_of_add_eq_zero_right h.symm

private def firstSuperKernel : Subgroup (SL 5) where
  carrier := {A | A ∈ U ∧ ∀ i j : Fin 5, j.val = i.val + 1 → A.val i j = 0}
  one_mem' := ⟨U.one_mem, by
    intro i j hij
    exact Matrix.one_apply_ne (by intro he; subst j; omega)⟩
  mul_mem' := by
    rintro A B ⟨hA, ha⟩ ⟨hB, hb⟩
    exact ⟨U.mul_mem hA hB, fun i j hij => by
      rw [firstSuper_mul hA hB i j hij, ha i j hij, hb i j hij, add_zero]⟩
  inv_mem' := by
    rintro A ⟨hA, ha⟩
    exact ⟨U.inv_mem hA, fun i j hij => by
      rw [firstSuper_inv hA i j hij, ha i j hij, neg_zero]⟩

private theorem derived_le_firstSuperKernel : D ≤ firstSuperKernel := by
  apply commutator_le.mpr
  intro A hA B hB
  refine ⟨Subgroup.commutator_le_self U (commutator_mem_commutator hA hB), ?_⟩
  intro i j hij
  rw [commutatorElement_def,
    firstSuper_mul (U.mul_mem (U.mul_mem hA hB) (U.inv_mem hA)) (U.inv_mem hB) i j hij,
    firstSuper_mul (U.mul_mem hA hB) (U.inv_mem hA) i j hij,
    firstSuper_mul hA hB i j hij, firstSuper_inv hA i j hij, firstSuper_inv hB i j hij]
  abel

private theorem derived_entries {A : SL 5} (hA : A ∈ D) (i j : Fin 5)
    (hij : j.val ≤ i.val + 1) : A.val i j = (1 : Matrix (Fin 5) (Fin 5) (ZMod 2)) i j := by
  obtain ⟨hU, hsuper⟩ := derived_le_firstSuperKernel hA
  obtain ⟨htri, hdiag⟩ := upperRoot_unitriangular hU
  by_cases hji : j < i
  · rw [htri hji, Matrix.one_apply_ne (ne_of_gt hji)]
  by_cases he : i = j
  · subst j; rw [hdiag, Matrix.one_apply_eq]
  · have heq : j.val = i.val + 1 := by
      have he' : i.val ≠ j.val := fun h => he (Fin.ext h)
      change ¬j.val < i.val at hji
      omega
    rw [hsuper i j heq, Matrix.one_apply_ne he]

private theorem root_mem_upper (i j : Fin 5) (hij : i < j) (c : ZMod 2) :
    Matrix.SpecialLinearGroup.transvection (ne_of_lt hij) c ∈ U := by
  obtain rfl | rfl := (by decide : ∀ c : ZMod 2, c = 0 ∨ c = 1) c
  · simp
  · exact Subgroup.subset_closure ⟨i, j, hij, rfl⟩

private theorem root_mem_derived (i k j : Fin 5) (hik : i < k) (hkj : k < j)
    (c : ZMod 2) :
    Matrix.SpecialLinearGroup.transvection (ne_of_lt (hik.trans hkj)) c ∈ D := by
  have hik' := ne_of_lt hik
  have hkj' := ne_of_lt hkj
  have hij' := ne_of_lt (hik.trans hkj)
  let x := Matrix.SpecialLinearGroup.transvection hik' c
  let y := Matrix.SpecialLinearGroup.transvection hkj' (1 : ZMod 2)
  let z := Matrix.SpecialLinearGroup.transvection hij' c
  have hchain : x * y = y * z * x := by
    apply Subtype.ext
    simp [x, y, z, Matrix.SpecialLinearGroup.transvection_coe, mul_add, add_mul,
      Matrix.single_mul_single_of_ne _ _ _ _ hij'.symm,
      add_assoc, add_comm, add_left_comm]
  have hcomm : y * z = z * y := by
    apply Subtype.ext
    simp [y, z, Matrix.SpecialLinearGroup.transvection_coe, mul_add, add_mul,
      Matrix.single_mul_single_of_ne _ _ _ _ hij'.symm,
      Matrix.single_mul_single_of_ne _ _ _ _ hkj'.symm, add_comm, add_left_comm]
  have he : ⁅x, y⁆ = z := by
    rw [commutatorElement_def, hchain, hcomm]
    simp [mul_assoc]
  change z ∈ D
  rw [← he]
  exact commutator_mem_commutator (root_mem_upper i k hik c) (root_mem_upper k j hkj 1)

private theorem central_24_zero {A : SL 5} (hA : A ∈ centralizer (D : Set (SL 5))) :
    A.val 2 4 = 0 := by
  have hc := hA _ (root_mem_derived 0 1 2 (by decide) (by decide) 1)
  have he := congrArg (fun g : SL 5 => g.val 0 4) hc
  change (Matrix.transvection (0 : Fin 5) 2 (1 : ZMod 2) * A.val) 0 4 =
    (A.val * Matrix.transvection (0 : Fin 5) 2 (1 : ZMod 2)) 0 4 at he
  rw [Matrix.transvection_mul_apply_same,
    Matrix.mul_transvection_apply_of_ne (i := (0 : Fin 5)) (j := 2) 0 4 (by decide) 1 A.val,
    one_mul] at he
  exact add_eq_left.mp he

private theorem central_02_zero {A : SL 5} (hA : A ∈ centralizer (D : Set (SL 5))) :
    A.val 0 2 = 0 := by
  have hc := hA _ (root_mem_derived 2 3 4 (by decide) (by decide) 1)
  have he := congrArg (fun g : SL 5 => g.val 0 4) hc
  change (Matrix.transvection (2 : Fin 5) 4 (1 : ZMod 2) * A.val) 0 4 =
    (A.val * Matrix.transvection (2 : Fin 5) 4 (1 : ZMod 2)) 0 4 at he
  rw [Matrix.transvection_mul_apply_of_ne (i := (2 : Fin 5)) (j := 4) 0 4 (by decide) 1 A.val,
    Matrix.mul_transvection_apply_same, one_mul] at he
  exact add_eq_left.mp he.symm

private theorem rectangle_of_derivedCenter {A : SL 5} (hA : A ∈ derivedCenter U) :
    FiveRectangle A := by
  have hd := derived_entries hA.1
  have h02 := central_02_zero hA.2
  have h24 := central_24_zero hA.2
  intro i j hij
  fin_cases i <;> fin_cases j <;>
    first | exact hd _ _ (by decide) | simpa using h02 | simpa using h24 |
      norm_num at hij

private theorem rectangle_mem_derived {A : SL 5} (hA : FiveRectangle A) : A ∈ D := by
  dsimp only [FiveRectangle] at hA
  let t03 := Matrix.SpecialLinearGroup.transvection (by decide : (0 : Fin 5) ≠ 3) (A.val 0 3)
  let t04 := Matrix.SpecialLinearGroup.transvection (by decide : (0 : Fin 5) ≠ 4) (A.val 0 4)
  let t13 := Matrix.SpecialLinearGroup.transvection (by decide : (1 : Fin 5) ≠ 3) (A.val 1 3)
  let t14 := Matrix.SpecialLinearGroup.transvection (by decide : (1 : Fin 5) ≠ 4) (A.val 1 4)
  have he : A = t03 * t04 * t13 * t14 := by
    apply Subtype.ext
    dsimp only [t03, t04, t13, t14]
    simp only [Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.transvection_coe]
    simp only [mul_add, add_mul, one_mul, mul_one,
      Matrix.single_mul_single_of_ne _ _ _ _ (by decide : (3 : Fin 5) ≠ 0),
      Matrix.single_mul_single_of_ne _ _ _ _ (by decide : (3 : Fin 5) ≠ 1),
      Matrix.single_mul_single_of_ne _ _ _ _ (by decide : (4 : Fin 5) ≠ 1),
      add_zero]
    ext i j
    fin_cases i <;> fin_cases j <;>
      simp [hA, Matrix.single]
  rw [he]
  exact D.mul_mem (D.mul_mem (D.mul_mem
    (root_mem_derived 0 1 3 (by decide) (by decide) _)
    (root_mem_derived 0 1 4 (by decide) (by decide) _))
    (root_mem_derived 1 2 3 (by decide) (by decide) _))
    (root_mem_derived 1 2 4 (by decide) (by decide) _)

private theorem rectangle_commutes_derived {A B : SL 5} (hA : FiveRectangle A)
    (hB : B ∈ D) : B * A = A * B := by
  dsimp only [FiveRectangle] at hA
  have hd := derived_entries hB
  apply Subtype.ext
  change B.val * A.val = A.val * B.val
  ext i j
  fin_cases i <;> fin_cases j <;>
    simp [Matrix.mul_apply, Fin.sum_univ_succ, hA, hd, add_comm] <;>
    norm_num [Matrix.one_apply, Fin.succ, Fin.ext_iff]

/-- The center of the actual positive-root derived subgroup consists of precisely
its four rectangular entries in rows zero and one and columns three and four. -/
theorem mem_derivedCenter_upperRootSubgroup_iff_fiveRectangle (A : SL 5) :
    A ∈ derivedCenter upperRootSubgroup ↔ FiveRectangle A := by
  constructor
  · exact rectangle_of_derivedCenter
  · intro hA
    exact ⟨rectangle_mem_derived hA, fun B hB => rectangle_commutes_derived hA hB⟩

end CFSG.Quasithin.Chapter2.ComponentRefinement.LieType.Binary
