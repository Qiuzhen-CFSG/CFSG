module

public import Theory.GroupTheory.Perm.PrimeDegreeNormalizer
public import Mathlib.GroupTheory.GroupAction.Jordan
public import Mathlib.GroupTheory.Solvable
public import Mathlib.Data.ZMod.Basic
import Mathlib.Tactic.NormNum

/-!
# The order alternative in primitive degree seven

A nonsolvable simple subgroup of S₇ lies in A₇. Jordan's three-cycle theorem
shows that a primitive subgroup not containing A₇ has no three-cycle. An
explicit Sylow 3-subgroup of S₇ is generated by two disjoint three-cycles;
Sylow conjugacy therefore excludes nine from the subgroup order.

Transitivity supplies the prime divisor seven. The faithful prime-degree
action makes its Sylow 7-subgroup self-centralizing, and its normalizer has
order seven times a divisor of six. Transfer excludes a trivial automizer,
while simplicity excludes a normal Sylow subgroup. Transfer at two also
excludes a Sylow 2-subgroup of order two. The remaining divisor and Sylow
congruence calculation gives order 168.

Source: the condition K calculation for the alternating examples in
Aschbacher–Smith, Theorem 0.1.2(3), printed p.4, and Main Hypothesis (K),
printed p.482. This is an elementary order bound for the faithful simple
case, with no assumption of a primitive subgroup list or model recognition.
-/

namespace CFSG.Quasithin.MainConverse

open Equiv.Perm Subgroup MulAction

private abbrev CyclePair := Multiplicative (ZMod 3) × Multiplicative (ZMod 3)

private def leftThreeCycle : Equiv.Perm (Fin 7) := Equiv.swap 0 1 * Equiv.swap 0 2

private def rightThreeCycle : Equiv.Perm (Fin 7) := Equiv.swap 3 4 * Equiv.swap 3 5

/-- The two cyclic factors rotate disjoint triples and fix the seventh point. -/
private def disjointThreeCyclesHom : CyclePair →* Equiv.Perm (Fin 7) where
  toFun a := leftThreeCycle ^ a.1.toAdd.val * rightThreeCycle ^ a.2.toAdd.val
  map_one' := by decide
  map_mul' := by decide

private theorem disjointThreeCyclesHom_injective :
    Function.Injective disjointThreeCyclesHom := by decide

private theorem card_disjointThreeCycles_range : Nat.card disjointThreeCyclesHom.range = 9 := by
  rw [Nat.card_congr (MonoidHom.ofInjective disjointThreeCyclesHom_injective).symm.toEquiv]
  norm_num [Nat.card_prod, Nat.card_eq_fintype_card]

private def standardSylowThree : Sylow 3 (Equiv.Perm (Fin 7)) := by
  let : Fact (Nat.Prime 3) := ⟨by decide⟩
  exact Sylow.ofCard disjointThreeCyclesHom.range (by
    rw [card_disjointThreeCycles_range, Nat.card_perm, Nat.card_fin]
    decide +kernel)

private theorem leftThreeCycle_mem_standardSylowThree : leftThreeCycle ∈ standardSylowThree := by
  change leftThreeCycle ∈ disjointThreeCyclesHom.range
  exact ⟨(Multiplicative.ofAdd 1, 1), by decide⟩

/-- Sylow conjugacy and Jordan's theorem exclude a factor of nine. -/
private theorem nine_not_dvd_card (U : Subgroup (Equiv.Perm (Fin 7)))
    (hp : IsPreprimitive U (Fin 7))
    (ha : ¬ alternatingGroup (Fin 7) ≤ U) : ¬ 9 ∣ Nat.card U := by
  classical
  let : Fact (Nat.Prime 3) := ⟨by decide⟩
  intro h9
  obtain ⟨H, hH⟩ := Sylow.exists_subgroup_card_pow_prime 3 (n := 2) h9
  let K := H.map U.subtype
  have hK : Nat.card K = 9 := by
    rw [Subgroup.card_map_of_injective U.subtype_injective, hH]
    norm_num
  let T : Sylow 3 (Equiv.Perm (Fin 7)) :=
    Sylow.ofCard K (by rw [hK, Nat.card_perm, Nat.card_fin]; decide +kernel)
  obtain ⟨g, hg⟩ := exists_smul_eq (Equiv.Perm (Fin 7)) standardSylowThree T
  have hmem : g * leftThreeCycle * g⁻¹ ∈ K := by
    have hm := Subgroup.smul_mem_pointwise_smul leftThreeCycle (MulAut.conj g)
      (standardSylowThree : Subgroup _) leftThreeCycle_mem_standardSylowThree
    change g * leftThreeCycle * g⁻¹ ∈ (g • standardSylowThree : Sylow 3 (Equiv.Perm (Fin 7))) at hm
    rwa [hg] at hm
  have hKU : K ≤ U := by
    rintro _ ⟨a, _, rfl⟩
    exact a.property
  apply ha
  apply alternatingGroup_le_of_isPreprimitive_of_isThreeCycle_mem hp _ (hKU hmem)
  change (g * leftThreeCycle * g⁻¹).cycleType = {3}
  rw [cycleType_conj]
  exact isThreeCycle_swap_mul_swap_same (by decide) (by decide) (by decide)

private theorem le_alternating_of_simple_nonsolvable
    (U : Subgroup (Equiv.Perm (Fin 7))) [IsSimpleGroup U]
    (hns : ¬ Group.IsSolvable U) : U ≤ alternatingGroup (Fin 7) := by
  let s := sign.comp U.subtype
  rcases (inferInstance : s.ker.Normal).eq_bot_or_eq_top with hb | ht
  · exact (hns (Group.isSolvable_of_isSolvable_injective
      ((MonoidHom.ker_eq_bot_iff s).mp hb))).elim
  · intro a ha
    apply mem_alternatingGroup.mpr
    exact show s ⟨a, ha⟩ = 1 from
      MonoidHom.mem_ker.mp (ht ▸ (show (⟨a, ha⟩ : U) ∈ (⊤ : Subgroup U) from trivial))

private theorem card_ne_prime_of_nonsolvable {G : Type*} [Group G] [Finite G]
    (hns : ¬ Group.IsSolvable G) (p : ℕ) [Fact p.Prime] : Nat.card G ≠ p := by
  intro hc
  let : IsCyclic G := isCyclic_of_prime_card hc
  let : CommGroup G := IsCyclic.commGroup
  exact hns inferInstance

/-- A Sylow subgroup of order two has trivial automizer, contradicting transfer. -/
private theorem four_dvd_card_of_simple_of_two_dvd
    {G : Type*} [Group G] [Finite G] [IsSimpleGroup G]
    (hG : Nat.card G ≠ 2) (hd : 2 ∣ Nat.card G) : 4 ∣ Nat.card G := by
  by_contra hn
  let : Fact (Nat.Prime 2) := ⟨by decide⟩
  let P : Sylow 2 G := Classical.choice inferInstance
  have hP := P.card_eq_prime_of_dvd_of_not_sq_dvd hd hn
  have hm := P.centralizer_relIndex_normalizer_dvd_prime_sub_one hP
  have hm1 := P.centralizer_relIndex_normalizer_ne_one_of_simple hP hG
  exact hm1 (Nat.dvd_one.mp hm)

/-- The divisor calculation retains only 168 once both transfer obstructions
and the Sylow seven normalizer conditions are imposed. -/
private theorem remaining_order_arithmetic : ∀ n ∈ Nat.divisors 2520, ∀ m ∈ Nat.divisors 6,
    ¬ 9 ∣ n → (2 ∣ n → 4 ∣ n) → m ≠ 1 →
    7 * m ∣ n → n / 7 % 7 = m % 7 → n ≠ 7 * m → n = 168 := by decide +kernel

/-- A nonsolvable simple primitive subgroup of S₇ which does not contain A₇
has order 168. This discharges the order premise of the primitive-seven
simple-quotient assembly; recognition of the group is a separate result. -/
public theorem primitiveSeven_simple_card_eq_168 (U : Subgroup (Equiv.Perm (Fin 7)))
    (hp : IsPreprimitive U (Fin 7)) (hs : IsSimpleGroup U)
    (hns : ¬ Group.IsSolvable U) (ha : ¬ alternatingGroup (Fin 7) ≤ U) :
    Nat.card U = 168 := by
  classical
  let : IsPreprimitive U (Fin 7) := hp
  let : IsSimpleGroup U := hs
  let : Fact (Nat.Prime 7) := ⟨by decide⟩
  have h7 : 7 ∣ Nat.card U := by
    simpa only [index_stabilizer_of_transitive, Nat.card_fin] using
      (stabilizer U (0 : Fin 7)).index_dvd_card
  have h2520 : Nat.card U ∣ 2520 := by
    have hA : Nat.card (alternatingGroup (Fin 7)) = 2520 := by
      rw [nat_card_alternatingGroup, Nat.card_fin]
      decide +kernel
    exact hA ▸ card_dvd_of_le (le_alternating_of_simple_nonsolvable U hns)
  have h49 : ¬ 7 ^ 2 ∣ Nat.card U := fun h => (by decide : ¬ 49 ∣ 2520) (h.trans h2520)
  let P : Sylow 7 U := Classical.choice inferInstance
  have hP := P.card_eq_prime_of_dvd_of_not_sq_dvd h7 h49
  have hC := Theory.GroupTheory.prime_degree_sylow_self_centralizing
    U.subtype U.subtype_injective P hP
  let m := (centralizer (P : Set U)).relIndex (normalizer (P : Set U))
  have hm : m ∣ 6 := P.centralizer_relIndex_normalizer_dvd_prime_sub_one hP
  have hne7 := card_ne_prime_of_nonsolvable hns 7
  have hm1 : m ≠ 1 := P.centralizer_relIndex_normalizer_ne_one_of_simple hP hne7
  have hN : Nat.card (normalizer (P : Set U)) = 7 * m :=
    P.normalizer_card_of_self_centralizing hP hC
  have hNd : 7 * m ∣ Nat.card U := hN ▸ (normalizer (P : Set U)).card_subgroup_dvd_card
  have hmod := P.card_div_prime_modEq_of_normalizer_card hN
  have hne : Nat.card U ≠ 7 * m := by
    intro he
    have hnt : normalizer (P : Set U) = ⊤ :=
      Subgroup.eq_top_of_card_eq _ (hN.trans he.symm)
    have hn : (P : Subgroup U).Normal := Subgroup.normalizer_eq_top_iff.mp hnt
    rcases hn.eq_bot_or_eq_top with hb | ht
    · have : Nat.card P = 1 := by rw [hb, card_bot]
      omega
    · have : Nat.card P = Nat.card U := by
        rw [ht, card_top]
      exact hne7 (this.symm.trans hP)
  have htwo : 2 ∣ Nat.card U → 4 ∣ Nat.card U :=
    four_dvd_card_of_simple_of_two_dvd (fun he => (by decide : ¬ 7 ∣ 2) (he ▸ h7))
  exact remaining_order_arithmetic _ (Nat.mem_divisors.mpr ⟨h2520, by decide⟩)
    _ (Nat.mem_divisors.mpr ⟨hm, by decide⟩) (nine_not_dvd_card U hp ha) htwo hm1 hNd hmod hne

end CFSG.Quasithin.MainConverse
