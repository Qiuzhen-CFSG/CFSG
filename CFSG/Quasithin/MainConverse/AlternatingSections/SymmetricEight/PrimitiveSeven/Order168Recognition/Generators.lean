module

public import Mathlib.GroupTheory.Perm.Cycle.Type
public import Mathlib.Data.Fin.VecNotation

/-!
# Generators for the two binary-plane groups on seven letters

Fix the cycle (0 1 2 3 4 5 6). The two double transpositions below generate
its two overgroups isomorphic to PSL₃(2). The recognition argument checks
short words in a seven-cycle and an even involution, and then compares
these concrete permutation groups with the binary matrix group.

This supports the condition (K) calculation for the alternating examples in
Aschbacher–Smith, Theorem 0.1.2(3), printed p.4, and Main Hypothesis (K),
printed p.482. The model identifications are proved separately.
-/

@[expose] public section

namespace CFSG.Quasithin.MainConverse.Order168Recognition

abbrev Perm := Equiv.Perm (Fin 7)

/-- The fixed seven-cycle. -/
def cycle : Perm where
  toFun := ![1, 2, 3, 4, 5, 6, 0]
  invFun := ![6, 0, 1, 2, 3, 4, 5]
  left_inv := by decide
  right_inv := by decide

/-- The two involutions marking the two binary planes. -/
def involution (b : Bool) : Perm :=
  if b then Equiv.swap 2 4 * Equiv.swap 5 6
  else Equiv.swap 2 3 * Equiv.swap 4 6

/-- The actual permutation subgroup generated by the displayed elements. -/
def seed (b : Bool) : Subgroup Perm := Subgroup.closure {cycle, involution b}

/-- Evaluate a word, with `false` denoting the first generator. -/
def word {G : Type*} [Group G] (x y : G) (w : List Bool) : G :=
  (w.map (fun b => if b then y else x)).prod

/-- A subgroup containing the generators contains each evaluated word. -/
theorem word_mem {G : Type*} [Group G] (H : Subgroup G) {x y : G}
    (hx : x ∈ H) (hy : y ∈ H) (w : List Bool) : word x y w ∈ H := by
  apply H.list_prod_mem
  intro z hz
  obtain ⟨b, _, rfl⟩ := List.mem_map.mp hz
  split <;> assumption

end CFSG.Quasithin.MainConverse.Order168Recognition
