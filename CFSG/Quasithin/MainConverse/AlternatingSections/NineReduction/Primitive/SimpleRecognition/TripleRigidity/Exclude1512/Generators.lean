module

public import Mathlib.GroupTheory.Perm.Cycle.Type
public import Mathlib.Data.Fin.VecNotation

/-!
# A seven-cycle and two involutions on nine letters

These explicit permutations are used in the order-1512 exclusion. After
normalizing a seven-cycle, triple transitivity supplies an involution fixing
2 and interchanging 0 and 3. Its other six moved letters have fifteen possible
pairings. The finite word calculation and the orders of the two surviving
generated subgroups are separate proof obligations.

Application: condition K for the alternating case of Aschbacher–Smith,
`refs/quasithin.pdf`, printed pp.4 and 482. No recognition or order assertion
is included in these definitions.
-/

@[expose] public section

namespace CFSG.Quasithin.MainConverse.NineReduction.Exclude1512

abbrev Perm := Equiv.Perm (Fin 9)

/-- The seven-cycle `(2 3 4 5 6 7 8)`. -/
def cycle : Perm where
  toFun := ![0, 1, 3, 4, 5, 6, 7, 8, 2]
  invFun := ![0, 1, 8, 2, 3, 4, 5, 6, 7]
  left_inv := by decide
  right_inv := by decide

/-- The two surviving pairings after the normalization at 0, 2 and 3. -/
def involution (b : Bool) : Perm :=
  Equiv.swap 0 3 * Equiv.swap 1 8 *
    if b then Equiv.swap 4 6 * Equiv.swap 5 7
    else Equiv.swap 4 5 * Equiv.swap 6 7

/-- The actual subgroup generated by the displayed permutations. -/
def seed (b : Bool) : Subgroup Perm :=
  Subgroup.closure {cycle, involution b}

theorem cycle_order : orderOf cycle = 7 := by
  let : Fact (Nat.Prime 7) := ⟨by decide⟩
  exact orderOf_eq_prime (by decide) (by decide)

end CFSG.Quasithin.MainConverse.NineReduction.Exclude1512
