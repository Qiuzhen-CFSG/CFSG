module

public import Mathlib.GroupTheory.GroupAction.MultipleTransitivity
public import Mathlib.GroupTheory.Perm.Cycle.Type
public import Mathlib.Data.ZMod.Basic
public import Mathlib.GroupTheory.Sylow

/-!
# The three-part of a degree-nine triple stabilizer

The ambient pointwise stabilizer of `{0,1,2}` has order `6! = 720`.
Its explicit Sylow 3-subgroup is generated by disjoint cycles on `{3,4,5}`
and `{6,7,8}`. If nine divides the order of a subgroup's triple stabilizer,
a subgroup of order nine maps onto an ambient Sylow subgroup. Sylow conjugacy
then forces a three-cycle into the original group.

The argument uses the actual faithful permutation action and makes no
primitivity or classification assumption. It supplies an order bound for
condition K in the alternating case of Aschbacher–Smith,
*The Classification of Quasithin Groups*, `refs/quasithin.pdf`, printed pp.4 and 482.
The explicit homomorphism identities are checked by the kernel.
-/

open Equiv Equiv.Perm MulAction Subgroup
open scoped Pointwise
namespace CFSG.Quasithin.MainConverse.NineReduction

private abbrev ambientTriple := fixingSubgroup (Perm (Fin 9)) ({0, 1, 2} : Set (Fin 9))
private abbrev triple (G : Type*) [Group G] [MulAction G (Fin 9)] := fixingSubgroup G ({0, 1, 2} : Set (Fin 9))

private theorem card_ambientTriple : Nat.card ambientTriple = 720 := by
  have hs : ({0, 1, 2} : Set (Fin 9)).ncard = 3 := by simp
  have hi := IsMultiplyPretransitive.index_of_fixingSubgroup_eq
    (G := Perm (Fin 9)) ({0, 1, 2} : Set (Fin 9)) (hs ▸ Equiv.Perm.isMultiplyPretransitive (Fin 9) 3)
  norm_num [hs, Nat.choose, Nat.factorial] at hi
  have hc := ambientTriple.index_mul_card
  rw [hi, Nat.card_perm, Nat.card_fin] at hc
  norm_num [Nat.factorial] at hc
  omega

private def tripleInclusion (G : Type*) [Group G] [MulAction G (Fin 9)] :
    triple G →* ambientTriple where
  toFun g := ⟨toPermHom G (Fin 9) g.val, g.property⟩
  map_one' := Subtype.ext (map_one _)
  map_mul' _ _ := Subtype.ext (map_mul _ _ _)

private theorem tripleInclusion_injective (G : Type*) [Group G] [MulAction G (Fin 9)]
    [FaithfulSMul G (Fin 9)] : Function.Injective (tripleInclusion G) := by
  intro a b h
  exact Subtype.ext (toPerm_injective (congrArg (fun g : ambientTriple => g.val) h))

/-- A faithful degree-nine triple stabilizer embeds into the ambient group of order 720. -/
public theorem nine_fixing_triple_card_dvd (G : Type*) [Group G] [MulAction G (Fin 9)]
    [FaithfulSMul G (Fin 9)] : Nat.card (fixingSubgroup G ({0, 1, 2} : Set (Fin 9))) ∣ 720 := by
  simpa [card_ambientTriple] using Subgroup.card_dvd_of_injective
    (tripleInclusion G) (tripleInclusion_injective G)

private abbrev CyclePair := Multiplicative (ZMod 3) × Multiplicative (ZMod 3)
private def leftThree : Perm (Fin 9) := swap 3 4 * swap 3 5
private def rightThree : Perm (Fin 9) := swap 6 7 * swap 6 8
private def cyclePairHom : CyclePair →* Perm (Fin 9) where
  toFun a := leftThree ^ a.1.toAdd.val * rightThree ^ a.2.toAdd.val
  map_one' := by decide
  map_mul' := by decide

private theorem cyclePairHom_mem : ∀ a, cyclePairHom a ∈ ambientTriple := by
  intro a
  rw [mem_fixingSubgroup_iff]
  intro x hx
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hx
  have he : ∀ a : CyclePair, cyclePairHom a (0 : Fin 9) = 0 ∧
      cyclePairHom a (1 : Fin 9) = 1 ∧ cyclePairHom a (2 : Fin 9) = 2 := by decide
  rcases hx with rfl | rfl | rfl
  · exact (he a).1
  · exact (he a).2.1
  · exact (he a).2.2

private def cyclePairToTriple : CyclePair →* ambientTriple :=
  cyclePairHom.codRestrict ambientTriple cyclePairHom_mem

private theorem cyclePairHom_injective : Function.Injective cyclePairHom := by decide
private theorem cyclePairToTriple_injective : Function.Injective cyclePairToTriple := by
  intro a b h
  apply cyclePairHom_injective
  exact congrArg Subtype.val h

private theorem card_cyclePair_range : Nat.card cyclePairToTriple.range = 9 := by
  rw [Nat.card_congr (MonoidHom.ofInjective cyclePairToTriple_injective).symm.toEquiv]
  norm_num [Nat.card_prod, Nat.card_eq_fintype_card]

private def standardSylowThree : Sylow 3 ambientTriple := by
  let : Fact (Nat.Prime 3) := ⟨by decide⟩
  exact Sylow.ofCard cyclePairToTriple.range (by
    rw [card_cyclePair_range, card_ambientTriple]
    decide +kernel)

private def leftInTriple : ambientTriple := cyclePairToTriple (Multiplicative.ofAdd 1, 1)
private theorem left_mem_sylow : leftInTriple ∈ standardSylowThree :=
  ⟨(Multiplicative.ofAdd 1, 1), rfl⟩

/-- A nine-point group with no three-cycles has no factor nine in a triple stabilizer. -/
public theorem nine_not_dvd_fixing_triple_card (G : Type*) [Group G] [Finite G]
    [MulAction G (Fin 9)] [FaithfulSMul G (Fin 9)]
    (hno : ∀ g : G, ¬ (toPermHom G (Fin 9) g).IsThreeCycle) :
    ¬ 9 ∣ Nat.card (fixingSubgroup G ({0, 1, 2} : Set (Fin 9))) := by
  classical
  let : Fact (Nat.Prime 3) := ⟨by decide⟩
  intro h9
  obtain ⟨P, hP⟩ := Sylow.exists_subgroup_card_pow_prime 3 (n := 2) h9
  let K := P.map (tripleInclusion G)
  have hK : Nat.card K = 9 := by
    rw [Subgroup.card_map_of_injective (tripleInclusion_injective G), hP]
    norm_num
  let T : Sylow 3 ambientTriple := Sylow.ofCard K (by
    rw [hK, card_ambientTriple]
    decide +kernel)
  obtain ⟨g, hg⟩ := exists_smul_eq ambientTriple standardSylowThree T
  have hmem : g * leftInTriple * g⁻¹ ∈ K := by
    have hm := Subgroup.smul_mem_pointwise_smul leftInTriple (MulAut.conj g)
      (standardSylowThree : Subgroup _) left_mem_sylow
    change g * leftInTriple * g⁻¹ ∈ (g • standardSylowThree : Sylow 3 ambientTriple) at hm
    rwa [hg] at hm
  obtain ⟨a, _, ha⟩ := hmem
  apply hno a.val
  have hval := congrArg Subtype.val ha
  change (toPermHom G (Fin 9) a.val) = (g.val * leftInTriple.val * g.val⁻¹) at hval
  change (toPermHom G (Fin 9) a.val).cycleType = {3}
  rw [hval, cycleType_conj]
  change leftThree.cycleType = {3}
  exact isThreeCycle_swap_mul_swap_same (by decide) (by decide) (by decide)

end CFSG.Quasithin.MainConverse.NineReduction
