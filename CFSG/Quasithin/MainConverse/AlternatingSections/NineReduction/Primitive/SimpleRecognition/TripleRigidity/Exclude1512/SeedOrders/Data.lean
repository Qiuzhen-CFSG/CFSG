/-- Extract one base-nine digit as a point of the permutation domain. -/
def digit (n : Nat) (x : Fin 9) : Fin 9 :=
  ⟨n / 9 ^ x.val % 9, Nat.mod_lt _ (by decide)⟩

def row (i : Fin 504) : Fin 9 → Fin 9 := digit (images i.val)
def inverseRow (i : Fin 504) : Fin 9 → Fin 9 := digit (inverseImages i.val)
def parent (i : Fin 504) : Fin 504 := Fin.ofNat 504 ((parents i.val) / 2)
def letter (i : Fin 504) : Bool := (parents i.val) % 2 == 1

def next (i : Fin 504) (b : Bool) : Fin 504 :=
  Fin.ofNat 504 (if b then nextInvolution i.val else nextCycle i.val)
def prev (i : Fin 504) (b : Bool) : Fin 504 :=
  Fin.ofNat 504 (if b then nextInvolution i.val else prevCycle i.val)

def indexOfTriple (f : Fin 9 → Fin 9) : Nat :=
  tripleLookup (81 * (f 0).val + 9 * (f 1).val + (f 2).val)

