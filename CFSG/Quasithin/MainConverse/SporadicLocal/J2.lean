module

public import CFSG.Quasithin.MainConverse.SporadicLocal.Criteria
public import CFSG.Quasithin.MainConverse.SporadicLocal.J2.ThreeSylow
public import CFSG.Quasithin.MainConverse.SporadicLocal.J2.EvenSetup
public import CFSG.Quasithin.MainConverse.SporadicLocal.J2.EvenCharacteristic

/-!
# Quasithinness and even characteristic of J₂

The actual ATLAS degree-100 carrier is strongly quasithin: its Sylow
three-subgroups have order 27 and are nonabelian, while every other odd
prime cube is excluded by its proved order.

Its checked Sylow two-subgroup has center generated by the first central
involution, whose actual centralizer has a self-centralizing two-core.
The Sylow-local centralizer criterion covers every two-local containing
this Sylow subgroup, and Sylow conjugacy gives condition E.

Together these prove QT and E across the exact catalogue equivalence,
without additional local data, simplicity, nonabelianness or proper-K
premises. The conditional local-cover assembly is preserved as a separate API.

Source: Aschbacher–Smith, Theorem 0.1.2(5), printed p.4, repeated as
Theorem 0.1.1(5) on p.482; GLS3, Table 5.3g.
The carrier is `Sporadic.LeechRelated.J2.Carrier`.
-/

namespace CFSG.Quasithin.MainConverse.SporadicLocal
open Subgroup
open Sporadic.LeechRelated.J2.ExceptionalParabolics

/-- Strong quasithinness of the unchanged degree-100 Hall–Janko carrier. -/
public theorem j2_stronglyQuasithin :
    IsStronglyQuasithin ClassificationModels.SporadicName.j2.Carrier :=
  J2Rank.stronglyQuasithin

/-- Quasithinness transports across the actual catalogue equivalence. -/
public theorem j2_quasithin_of_equiv
    {G : Type*} [Group G] [Finite G]
    (e : G ≃* ClassificationModels.SporadicName.j2.Carrier) : IsQuasithin G := by
  change G ≃* Sporadic.LeechRelated.J2.Carrier at e
  have hG : IsStronglyQuasithin G := by
    intro p hp ho
    exact (Theory.GroupTheory.primeRank_le_of_injective p e.toMonoidHom e.injective).trans
      (J2Rank.stronglyQuasithin p hp ho)
  exact hG.quasithin

/-- Even characteristic of the unchanged degree-100 Hall–Janko carrier. -/
public theorem j2_evenCharacteristic :
    IsEvenCharacteristic ClassificationModels.SporadicName.j2.Carrier :=
  J2Even.evenCharacteristic

/-- The J₂ converse: QT and E transport across the actual catalogue equivalence. -/
public theorem j2_qt_e_of_equiv
    {G : Type*} [Group G] [Finite G]
    (e : G ≃* ClassificationModels.SporadicName.j2.Carrier) :
    IsQuasithin G ∧ IsEvenCharacteristic G :=
  ⟨j2_quasithin_of_equiv e, J2Even.evenCharacteristic_of_equiv e⟩

/-- Retained conditional assembly through explicit local-cover and radical-centralizer data. -/
public theorem j2_qt_and_even_of_local_data
    {G : Type*} [Group G] [Finite G]
    (e : G ≃* ClassificationModels.SporadicName.j2.Carrier)
    (hcover : J2Even.SylowLocalCover)
    (hc : centralizer (Seed.q₂.subgroupOf Seed.p₂ : Set Seed.p₂) ≤
      Seed.q₂.subgroupOf Seed.p₂) : IsQuasithin G ∧ IsEvenCharacteristic G := by
  refine ⟨j2_quasithin_of_equiv e, ?_⟩
  change G ≃* Sporadic.LeechRelated.J2.Carrier at e
  exact evenCharacteristic_of_model_equiv e (J2Even.evenCharacteristic_of_cover hcover hc)

end CFSG.Quasithin.MainConverse.SporadicLocal
