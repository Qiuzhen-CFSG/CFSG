/-!
# Quasithinness and even characteristic of Held

Source: Aschbacher–Smith, Theorem 0.1.2(5), printed pp.4 and 482;
GLS3 Table 5.3p. The carrier is the actual degree-2058 ATLAS Held group.

The concrete carrier is strongly quasithin. Its checked graph preservation
and pair-stabilizer divisibility bound the odd part of its order. Only 3
and 7 can divide that bound to the third power, and the retained nonabelian
subgroups have the proved orders 27 and 343. They are Sylow, giving the
global odd-rank bound and hence QT. The exact two-part of the ambient order
is unnecessary. QT transports across the actual catalogue equivalence
without any additional order, simplicity, graph or local-cover premises.

For E the actual central involution in max5 has a centralizer containing
max5 with index at most two. The checked graph centralizer of its embedded
word-defined core is generated by that involution. This gives a
self-centralizing two-core with center of order two in the involution
centralizer. Sylow promotion and the Sylow-local criterion establish E.
The unconditional QT/E conclusions transport through actual Held and
catalogue equivalences. The earlier conditional local-cover assemblies
remain available as separate sufficient routes.
-/

namespace CFSG.Quasithin.MainConverse.SporadicLocal

open Subgroup

private theorem odd_prime_power_dvd_odd_factor {p n k : ℕ} (hp : p.Prime)
    (ho : Odd p) (hd : p ^ n ∣ 2 ^ k * (3 ^ 3 * 5 ^ 2 * 7 ^ 3 * 17)) :
    p ^ n ∣ 3 ^ 3 * 5 ^ 2 * 7 ^ 3 * 17 := by
  have hne : p ≠ 2 := by
    rintro rfl
    exact ho.not_two_dvd_nat (dvd_refl 2)
  exact (Nat.coprime_pow_primes n k hp (by decide) hne).dvd_of_dvd_mul_left hd

private theorem held_odd_cube_prime {p : ℕ} (hp : p.Prime)
    (hd : p ^ 3 ∣ 3 ^ 3 * 5 ^ 2 * 7 ^ 3 * 17) : p = 3 ∨ p = 7 := by
  have hpd : p ∣ 3 ^ 3 * 5 ^ 2 * 7 ^ 3 * 17 :=
    (dvd_pow_self p (by decide : 3 ≠ 0)).trans hd
  simp only [hp.dvd_mul] at hpd
  have hcases : p = 3 ∨ p = 5 ∨ p = 7 ∨ p = 17 := by
    rcases hpd with ((h3 | h5) | h7) | h17
    · exact Or.inl (Nat.prime_eq_prime_of_dvd_pow hp (by decide) h3)
    · exact Or.inr (Or.inl (Nat.prime_eq_prime_of_dvd_pow hp (by decide) h5))
    · exact Or.inr (Or.inr (Or.inl (Nat.prime_eq_prime_of_dvd_pow hp (by decide) h7)))
    · exact Or.inr (Or.inr (Or.inr
        ((Nat.prime_dvd_prime_iff_eq hp (by decide)).mp h17)))
  rcases hcases with rfl | rfl | rfl | rfl
  · exact Or.inl rfl
  · norm_num at hd
  · exact Or.inr rfl
  · norm_num at hd

/-- The concrete odd subgroups and an odd-part divisibility bound imply all
odd-rank bounds. The power of two need not be determined. -/
public theorem he_stronglyQuasithin_of_order_dvd_and_odd_subgroups
    {k : ℕ} (hcard : Nat.card Held.He ∣ 2 ^ k * (3 ^ 3 * 5 ^ 2 * 7 ^ 3 * 17))
    (h3 : ∃ P : Subgroup Held.He, Nat.card P = 27 ∧ ¬ IsMulCommutative P)
    (h7 : ∃ P : Subgroup Held.He, Nat.card P = 343 ∧ ¬ IsMulCommutative P) :
    IsStronglyQuasithin Held.He := by
  intro p hp ho
  let : Fact p.Prime := ⟨hp⟩
  by_cases hd : p ^ 3 ∣ Nat.card Held.He
  · rcases held_odd_cube_prime hp
      (odd_prime_power_dvd_odd_factor hp ho (hd.trans hcard)) with rfl | rfl
    · obtain ⟨P, hc, hna⟩ := h3
      apply primeRank_le_two_of_nonabelian_subgroup_cube P hc hna
      intro hd
      have he := odd_prime_power_dvd_odd_factor hp ho (hd.trans hcard)
      norm_num at he
    · obtain ⟨P, hc, hna⟩ := h7
      apply primeRank_le_two_of_nonabelian_subgroup_cube P hc hna
      intro hd
      have he := odd_prime_power_dvd_odd_factor hp ho (hd.trans hcard)
      norm_num at he
  · exact primeRank_le_two_of_cube_not_dvd hd

/-- QT transports from the actual Held carrier under the precise odd-order
inputs. No independent simplicity certification of the carrier is required. -/
public theorem he_quasithin_of_equiv_of_order_dvd_and_odd_subgroups
    {G : Type*} [Group G] [Finite G] (e : G ≃* Held.He)
    {k : ℕ} (hcard : Nat.card Held.He ∣ 2 ^ k * (3 ^ 3 * 5 ^ 2 * 7 ^ 3 * 17))
    (h3 : ∃ P : Subgroup Held.He, Nat.card P = 27 ∧ ¬ IsMulCommutative P)
    (h7 : ∃ P : Subgroup Held.He, Nat.card P = 343 ∧ ¬ IsMulCommutative P) :
    IsQuasithin G := by
  have hG : IsStronglyQuasithin G := by
    intro p hp ho
    exact (Theory.GroupTheory.primeRank_le_of_injective p e.toMonoidHom e.injective).trans
      (he_stronglyQuasithin_of_order_dvd_and_odd_subgroups hcard h3 h7 p hp ho)
  exact hG.quasithin

/-- A conjugacy cover by the three literal candidates yields E once their
intrinsic normal self-centralizing two-subgroups have been constructed. -/
public theorem he_evenCharacteristic_of_candidate_cover
    (T : Sylow 2 Held.He)
    (hcores : ∀ i : Fin 3, ∃ Q : Subgroup (Held.TwoLocalCandidates.subgroup i),
      Q.Normal ∧ IsPGroup 2 Q ∧
        centralizer (Q : Set (Held.TwoLocalCandidates.subgroup i)) ≤ Q)
    (hcover : ∀ M : Subgroup Held.He, IsMaximalTwoLocal M → (T : Subgroup Held.He) ≤ M →
      ∃ (i : Fin 3) (g : Held.He),
        M = (Held.TwoLocalCandidates.subgroup i).map (MulAut.conj g).toMonoidHom) :
    IsEvenCharacteristic Held.He := by
  classical
  choose Q hn hp hc using hcores
  apply evenCharacteristic_of_local_normal_cover T Held.TwoLocalCandidates.subgroup
    Q hn hp hc
  intro M hM hTM
  obtain ⟨i, g, he⟩ := hcover M hM hTM
  exact ⟨i, ⟨(MulEquiv.subgroupCongr he).trans
    ((MulAut.conj g).subgroupMap (Held.TwoLocalCandidates.subgroup i)).symm⟩⟩

/-- Conditional final assembly through a genuine Held equivalence. Every
concrete premise must still be discharged before this proves the source case. -/
public theorem he_qt_e_of_order_odd_subgroups_and_candidate_cover
    {G : Type*} [Group G] [Finite G] (e : G ≃* Held.He)
    {k : ℕ} (hcard : Nat.card Held.He ∣ 2 ^ k * (3 ^ 3 * 5 ^ 2 * 7 ^ 3 * 17))
    (h3 : ∃ P : Subgroup Held.He, Nat.card P = 27 ∧ ¬ IsMulCommutative P)
    (h7 : ∃ P : Subgroup Held.He, Nat.card P = 343 ∧ ¬ IsMulCommutative P)
    (T : Sylow 2 Held.He)
    (hcores : ∀ i : Fin 3, ∃ Q : Subgroup (Held.TwoLocalCandidates.subgroup i),
      Q.Normal ∧ IsPGroup 2 Q ∧
        centralizer (Q : Set (Held.TwoLocalCandidates.subgroup i)) ≤ Q)
    (hcover : ∀ M : Subgroup Held.He, IsMaximalTwoLocal M → (T : Subgroup Held.He) ≤ M →
      ∃ (i : Fin 3) (g : Held.He),
        M = (Held.TwoLocalCandidates.subgroup i).map (MulAut.conj g).toMonoidHom) :
    IsQuasithin G ∧ IsEvenCharacteristic G := by
  exact ⟨he_quasithin_of_equiv_of_order_dvd_and_odd_subgroups e hcard h3 h7,
    evenCharacteristic_of_model_equiv e
      (he_evenCharacteristic_of_candidate_cover T hcores hcover)⟩

/-- The two concrete cardinalities, graph invariance and the shared pair bound
suffice for the global odd-rank assertion; noncommutativity is already proved. -/
public theorem he_stronglyQuasithin_of_graph_pair_bound_and_odd_orders
    (hgraph : Held.permutationGroup ≤ Held.NormalizerGraph.preservingGroup)
    (hpair : Nat.card Held.LocalPairs.SylowGeometry.ThreePrimeOvergroups.pairStabilizer ∣
      2 ^ 11 * 3 ^ 2)
    (h3 : Nat.card Held.OddCubeCandidates.three = 27)
    (h7 : Nat.card Held.OddCubeCandidates.seven = 343) :
    IsStronglyQuasithin Held.He :=
  he_stronglyQuasithin_of_order_dvd_and_odd_subgroups
    (Held.OddOrderBound.card_dvd_of_graph_and_pair_bound hgraph hpair)
    ⟨_, h3, Held.OddCubeCandidates.three_not_commutative⟩
    ⟨_, h7, Held.OddCubeCandidates.seven_not_commutative⟩

/-- Final assembly with precisely the remaining concrete obligations. This
conditional theorem is not the completed Held source case. -/
public theorem he_qt_e_of_graph_pair_bound_odd_orders_and_candidate_cover
    {G : Type*} [Group G] [Finite G] (e : G ≃* Held.He)
    (hgraph : Held.permutationGroup ≤ Held.NormalizerGraph.preservingGroup)
    (hpair : Nat.card Held.LocalPairs.SylowGeometry.ThreePrimeOvergroups.pairStabilizer ∣
      2 ^ 11 * 3 ^ 2)
    (h3 : Nat.card Held.OddCubeCandidates.three = 27)
    (h7 : Nat.card Held.OddCubeCandidates.seven = 343)
    (T : Sylow 2 Held.He)
    (hcores : ∀ i : Fin 3, ∃ Q : Subgroup (Held.TwoLocalCandidates.subgroup i),
      Q.Normal ∧ IsPGroup 2 Q ∧
        centralizer (Q : Set (Held.TwoLocalCandidates.subgroup i)) ≤ Q)
    (hcover : ∀ M : Subgroup Held.He, IsMaximalTwoLocal M → (T : Subgroup Held.He) ≤ M →
      ∃ (i : Fin 3) (g : Held.He),
        M = (Held.TwoLocalCandidates.subgroup i).map (MulAut.conj g).toMonoidHom) :
    IsQuasithin G ∧ IsEvenCharacteristic G :=
  he_qt_e_of_order_odd_subgroups_and_candidate_cover e
    (Held.OddOrderBound.card_dvd_of_graph_and_pair_bound hgraph hpair)
    ⟨_, h3, Held.OddCubeCandidates.three_not_commutative⟩
    ⟨_, h7, Held.OddCubeCandidates.seven_not_commutative⟩ T hcores hcover

/-- Every odd prime rank of the actual degree-2058 Held carrier is at most two. -/
public theorem he_stronglyQuasithin : IsStronglyQuasithin Held.He := by
  have hgraph :=
    Held.Realization.MarkedConjugacy.Seventeen.permutationGroup_le_preservingGroup
  exact he_stronglyQuasithin_of_graph_pair_bound_and_odd_orders hgraph
    (Held.LocalPairs.SylowGeometry.ThreePrimeOvergroups.pairStabilizer_card_dvd hgraph)
    Held.OddCubeCandidates.card_three Held.OddCubeCandidates.card_seven

/-- Quasithinness transports across an actual equivalence to the Held carrier. -/
public theorem he_quasithin_of_equiv
    {G : Type*} [Group G] [Finite G] (e : G ≃* Held.He) : IsQuasithin G := by
  have hG : IsStronglyQuasithin G := by
    intro p hp ho
    exact (Theory.GroupTheory.primeRank_le_of_injective p e.toMonoidHom e.injective).trans
      (he_stronglyQuasithin p hp ho)
  exact hG.quasithin

/-- The Held entry of the fixed catalogue supplies the same actual carrier. -/
public theorem he_quasithin_of_catalogue_equiv
    {G : Type*} [Group G] [Finite G]
    (e : G ≃* ClassificationModels.SporadicName.he.Carrier) : IsQuasithin G := by
  change G ≃* Held.He at e
  exact he_quasithin_of_equiv e

/-- The actual degree-2058 Held carrier has even characteristic. -/
public theorem he_evenCharacteristic : IsEvenCharacteristic Held.He :=
  HeEven.evenCharacteristic_of_graph_core_bound
    Held.TwoLocalCandidates.Cores.Max5Centralizer.graphCentralizer_le_zpowers

/-- Even characteristic transports through an actual Held equivalence. -/
public theorem he_evenCharacteristic_of_equiv
    {G : Type*} [Group G] [Finite G] (e : G ≃* Held.He) :
    IsEvenCharacteristic G :=
  evenCharacteristic_of_model_equiv e he_evenCharacteristic

/-- The Held catalogue entry has the same even-characteristic conclusion. -/
public theorem he_evenCharacteristic_of_catalogue_equiv
    {G : Type*} [Group G] [Finite G]
    (e : G ≃* ClassificationModels.SporadicName.he.Carrier) :
    IsEvenCharacteristic G := by
  change G ≃* Held.He at e
  exact he_evenCharacteristic_of_equiv e

/-- Both local conclusions of the Held case hold on its concrete carrier. -/
public theorem he_qt_e : IsQuasithin Held.He ∧ IsEvenCharacteristic Held.He :=
  ⟨he_stronglyQuasithin.quasithin, he_evenCharacteristic⟩

/-- The Held case of the source converse, under the actual model equivalence. -/
public theorem he_qt_e_of_equiv
    {G : Type*} [Group G] [Finite G] (e : G ≃* Held.He) :
    IsQuasithin G ∧ IsEvenCharacteristic G :=
  ⟨he_quasithin_of_equiv e, he_evenCharacteristic_of_equiv e⟩

/-- The Held entry of the full catalogue discharges QT and E without local premises. -/
public theorem he_qt_e_of_catalogue_equiv
    {G : Type*} [Group G] [Finite G]
    (e : G ≃* ClassificationModels.SporadicName.he.Carrier) :
    IsQuasithin G ∧ IsEvenCharacteristic G :=
  ⟨he_quasithin_of_catalogue_equiv e, he_evenCharacteristic_of_catalogue_equiv e⟩

end CFSG.Quasithin.MainConverse.SporadicLocal
