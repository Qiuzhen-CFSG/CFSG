/-!
# Short conjugating words and their two-letter keys

The binary sentinel encodings select 8722 words of length at most 30 from
`Coverage/source/involution-orbit.json`, in increasing order of their proposed
keys. Each code occupies 31 bits and each key 26 bits. These definitions are
only data: `Checks` certifies the actual word images and adjacent inequalities.
Source: the fixed ATLAS J3G1-p6156B0 permutations; GLS3 Table 5.3h, p.269.
Generated by `source/generate.py`; the generator and JSON are untrusted.
-/

namespace CFSG.Quasithin.MainConverse.SporadicLocal.J3Coverage.InvolutionCertificate
open Sporadic.Janko3.OrderCertificate

@[expose] public def wordData : Nat := 

@[expose] public def keyData : Nat := 

/-- The binary code of the i-th selected conjugating word. -/
@[expose] public def wordCode (i : Nat) : Nat :=
  (wordData >>> (31 * i)) % 2147483648

/-- The proposed packed images of letters 0 and 1, in increasing order. -/
@[expose] public def imageKey (i : Nat) : Nat :=
  (keyData >>> (26 * i)) % 67108864

/-- A checked row records the actual point key and the next strict inequality. -/
@[expose] public def RowCorrect (i : Nat) : Prop :=
  wordKey (wordCode i) = imageKey i ∧ (i + 1 < 8722 → imageKey i < imageKey (i + 1))

public instance (i : Nat) : Decidable (RowCorrect i) :=
  inferInstanceAs (Decidable (_ ∧ _))

/-- Exhaustive checking in bounded batches keeps kernel memory bounded. -/
@[expose] public def checkBlock (b : Nat) : Bool :=
  checkFin (fun j : Fin 128 => decide (128 * b + j.val < 8722 → RowCorrect (128 * b + j.val)))

end CFSG.Quasithin.MainConverse.SporadicLocal.J3Coverage.InvolutionCertificate
