module

public import CFSG.Quasithin.MainConverse.SporadicLocal.J3.Coverage.RepresentativeCalculations.CentralizerIntersections.Basic

/-!
# Witness data for the three intersections in the fixed J₃ centralizer

Rows use the certified six-coordinate `CRep` enumeration. Four-bit word lengths
and two-bit letters encode words in FOUR selected centralizer rows. Length 15
marks an excluded row. These data alone assert no identities: the companion
certificates check the positive words and all exclusions in the kernel.

Source: GLS 3, Table 5.3h, p.269; the ATLAS action and the discovery data retained
in `RepresentativeCalculations/source/finite-calculations.json`.
-/

namespace CFSG.Quasithin.MainConverse.SporadicLocal.J3Coverage.RepresentativeCalculations.Intersections
open Sporadic.Janko3.TwoLocal.CentralizerCertificate
set_option maxRecDepth 100000
set_option Elab.async false

@[expose] public def rowNumber (r : CIndex) : Nat :=
  (((((r.1.val * 5 + r.2.1.val) * 2 + r.2.2.1.val) * 3 +
    r.2.2.2.1.val) * 2 + r.2.2.2.2.1.val) * 2 + r.2.2.2.2.2.val)

@[expose] public def decodeWord (n : Nat) : List (Fin 4) :=
  (List.range (n % 16)).map (fun j => ⟨(n >>> (4 + 2*j)) % 4, Nat.mod_lt _ (by decide)⟩)

@[expose] public def selectedE : Fin 4 → CIndex :=
  ![(0,0,1,1,0,0), (3,4,1,2,1,1), (13,0,0,0,0,0), (1,2,1,2,0,0)]

@[expose] public def localWordE : Fin 4 → List (Fin 7) :=
  ![[3], [5, 4, 0, 4], [4, 6, 0, 5, 6, 0], [5, 1, 6, 4, 6, 0]]

@[expose] public def wordPackedE : Nat :=
  

@[expose] public def wordCodeE (r : CIndex) : Nat :=
  (wordPackedE >>> (20 * rowNumber r)) % 1048576

@[expose] public def goodE (r : CIndex) : Prop := wordCodeE r % 16 < 15
public instance goodEDecidable (r : CIndex) : Decidable (goodE r) :=
  inferInstanceAs (Decidable (_ < _))

@[expose] public def wordE (r : CIndex) : List (Fin 4) := decodeWord (wordCodeE r)

@[expose] public def outsidePackedE : Nat :=
  

@[expose] public def outsideE (r : CIndex) : Fin 4 :=
  ⟨(outsidePackedE >>> (2 * rowNumber r)) % 4, Nat.mod_lt _ (by decide)⟩

@[expose] public def selectedU : Fin 4 → CIndex :=
  ![(0,0,1,1,0,0), (9,0,0,0,0,0), (10,0,0,0,0,0), (3,4,1,2,1,1)]

@[expose] public def localWordU : Fin 4 → List (Fin 8) :=
  ![[2, 2], [4, 6, 0], [7, 7, 6, 7, 7], [3, 1, 0]]

@[expose] public def wordPackedU : Nat :=
  

@[expose] public def wordCodeU (r : CIndex) : Nat :=
  (wordPackedU >>> (20 * rowNumber r)) % 1048576

@[expose] public def goodU (r : CIndex) : Prop := wordCodeU r % 16 < 15
public instance goodUDecidable (r : CIndex) : Decidable (goodU r) :=
  inferInstanceAs (Decidable (_ < _))

@[expose] public def wordU (r : CIndex) : List (Fin 4) := decodeWord (wordCodeU r)

@[expose] public def outsidePackedU : Nat :=
  

@[expose] public def outsideU (r : CIndex) : Fin 4 :=
  ⟨(outsidePackedU >>> (2 * rowNumber r)) % 4, Nat.mod_lt _ (by decide)⟩

@[expose] public def maskPackedB : Nat :=
  

@[expose] public def maskCodeB (r : CIndex) : Nat :=
  (maskPackedB >>> (5 * rowNumber r)) % 32
@[expose] public def maskB (r : CIndex) : Fin 16 :=
  ⟨maskCodeB r % 16, Nat.mod_lt _ (by decide)⟩
@[expose] public def goodB (r : CIndex) : Prop := maskCodeB r < 16
public instance goodBDecidable (r : CIndex) : Decidable (goodB r) :=
  inferInstanceAs (Decidable (_ < _))

end CFSG.Quasithin.MainConverse.SporadicLocal.J3Coverage.RepresentativeCalculations.Intersections
