/-- The enumerated model element, forgetting its Sylow membership proof. -/
@[expose] public def element (i : Fin 128) : Model := sylowEnumeration i

public theorem element_mem (i : Fin 128) : element i ∈ sylowCandidate :=
  (sylowEnumeration i).property

public theorem element_injective : Function.Injective element := by
  intro i j h
  exact sylowEnumeration_injective (Subtype.ext h)

public theorem element_zero : element 0 = 1 := rfl

private def fastGenerator (i : Fin 5) : Equiv.Perm (Fin 6156) :=
  evalWord fastL0Gen (sylowWord0 i) * evalWord L1Gen (sylowWord1 i) *
    evalWord L2Gen (sylowWord2 i)

private theorem fastGenerator_eq (i : Fin 5) :
    fastGenerator i = embedding (sylowGenerator i) := by
  rw [fastGenerator, fastL0Gen_eq]
  rfl

/-- Applying the generator indices recursively to a word. -/
@[expose] public def wordIndex (w : List (Fin 5)) (j : Fin 128) : Fin 128 :=
  w.foldr (fun k r => mulIndex ⟨k.val + 1, by omega⟩ r) j

set_option maxHeartbeats 8000000 in
private theorem generator_point : ∀ (k : Fin 5) (j : Fin 128),
    fastGenerator k (sylowEnumerationPoint j) =
      sylowEnumerationPoint (mulIndex ⟨k.val + 1, by omega⟩ j) := by
  apply allFin₂
  decide +kernel

private theorem generator_mul (hS : Nat.card sylowCandidate = 128)
    (k : Fin 5) (j : Fin 128) :
    sylowGenerator k * element j = element (mulIndex ⟨k.val + 1, by omega⟩ j) := by
  apply sylowCandidate_eq_of_point_eq hS
    (sylowCandidate.mul_mem (sylowGenerator_mem k) (element_mem j)) (element_mem _)
  simp only [map_mul, Equiv.Perm.mul_apply, element, sylowEnumeration_point]
  rw [← fastGenerator_eq]
  exact generator_point k j

private theorem word_mul (hS : Nat.card sylowCandidate = 128)
    (w : List (Fin 5)) (j : Fin 128) :
    evalWord sylowGenerator w * element j = element (wordIndex w j) := by
  induction w with
  | nil => exact one_mul _
  | cons k w ih =>
    change (sylowGenerator k * evalWord sylowGenerator w) * element j = _
    rw [mul_assoc, ih, generator_mul hS]
    rfl

set_option maxHeartbeats 8000000 in
private theorem wordIndex_table : ∀ i j : Fin 128,
    wordIndex (sylowEnumerationWord i) j = mulIndex i j := by
  apply allFin₂
  decide +kernel

/-- Every tabulated product is a genuine product in the concrete model. -/
public theorem element_mul (hS : Nat.card sylowCandidate = 128) (i j : Fin 128) :
    element (mulIndex i j) = element i * element j := by
  rw [← wordIndex_table]
  exact (word_mul hS (sylowEnumerationWord i) j).symm

private theorem inverse_table : ∀ i : Fin 128, mulIndex i (invIndex i) = 0 := by
  decide +kernel

/-- Every tabulated inverse is the genuine inverse. -/
public theorem element_inv (hS : Nat.card sylowCandidate = 128) (i : Fin 128) :
    element (invIndex i) = (element i)⁻¹ := by
  apply eq_inv_of_mul_eq_one_right
  rw [← element_mul hS, inverse_table, element_zero]

/-- Left conjugation on indices, matching `MulAut.conj`. -/
@[expose] public def conjIndex (s i : Fin 128) : Fin 128 :=
  mulIndex (mulIndex s i) (invIndex s)

public theorem element_conj (hS : Nat.card sylowCandidate = 128) (s i : Fin 128) :
    element (conjIndex s i) = (MulAut.conj (element s)) (element i) := by
  simp only [conjIndex, element_mul hS, element_inv hS, MulAut.conj_apply]

