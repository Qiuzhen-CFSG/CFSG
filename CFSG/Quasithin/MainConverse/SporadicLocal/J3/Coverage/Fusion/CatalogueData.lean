@[expose] public def extensionIndex (i : Fin 141) (x : Fin 128) : Fin 141 :=
  ⟨((extensionPacked i >>> (8 * x.val)) % 256) % 141, Nat.mod_lt _ (by decide)⟩

public theorem catalogueSet_zero : catalogueSet 0 = {0} := by decide +kernel

set_option maxHeartbeats 8000000 in
public theorem zero_mem_catalogueSet (i : Fin 141) : 0 ∈ catalogueSet i := by
  have h : ∀ j : Fin 141, 0 ∈ catalogueSet j := by decide +kernel
  exact h i

private def listMask : List (Fin 128) → Nat
  | [] => 0
  | x :: xs => (1 <<< x.val) ||| listMask xs
private theorem single_test (i j : Fin 128) :
    (1 <<< i.val).testBit j.val = true ↔ j = i := by
  simp only [Nat.testBit_shiftLeft, Bool.and_eq_true, decide_eq_true_eq,
    Nat.testBit_one_eq_true_iff_self_eq_zero, Fin.ext_iff]
  omega
private theorem listMask_test (xs : List (Fin 128)) (j : Fin 128) :
    (listMask xs).testBit j.val = true ↔ j ∈ xs := by
  induction xs with
  | nil => simp [listMask]
  | cons x xs ih =>
    simp only [listMask, Nat.testBit_or, Bool.or_eq_true, single_test, ih, List.mem_cons]
private theorem listMask_eq (xs ys : List (Fin 128)) (h : listMask xs = listMask ys) :
    xs.toFinset = ys.toFinset := by
  ext j
  simp only [List.mem_toFinset, ← listMask_test, h]

set_option maxHeartbeats 8000000 in
/-- The exhaustive extension check. The set on the right is exactly the
old set together with its translate by the newly adjoined involution. -/
public theorem extension_spec : ∀ (i : Fin 141) (x : Fin 128),
    mulIndex x x = 0 → (∀ y ∈ catalogueSet i, mulIndex x y = mulIndex y x) →
    catalogueSet (extensionIndex i x) =
      catalogueSet i ∪ (catalogueSet i).image (mulIndex x) := by
  have checked : ∀ (i : Fin 141) (x : Fin 128),
      mulIndex x x = 0 →
      (catalogueList i).all (fun y => decide (mulIndex x y = mulIndex y x)) = true →
      listMask (catalogueList (extensionIndex i x)) =
        listMask (catalogueList i ++ (catalogueList i).map (mulIndex x)) := by
    apply allFin₂
    decide +kernel
  intro i x hsq hcomm
  have hm := checked i x hsq (List.all_eq_true.mpr (fun y hy =>
    decide_eq_true (hcomm y (List.mem_toFinset.mpr hy))))
  have heq := listMask_eq _ _ hm
  ext j
  have hj := Finset.ext_iff.mp heq j
  simpa only [catalogueSet, List.mem_toFinset, List.mem_append, List.mem_map,
    Finset.mem_union, Finset.mem_image] using hj

/-- The subgroup generated by one row of indices, inside the actual model. -/
@[expose] public def generated (s : Finset (Fin 128)) : Subgroup Model :=
  closure (element '' (s : Set (Fin 128)))

@[expose] public def catalogueSubgroup (i : Fin 141) : Subgroup Model :=
  generated (catalogueSet i)

public theorem element_mem_generated {s : Finset (Fin 128)} {i : Fin 128}
    (hi : i ∈ s) : element i ∈ generated s :=
  subset_closure ⟨i, hi, rfl⟩

public theorem generated_le {s : Finset (Fin 128)} {A : Subgroup Model}
    (h : ∀ i ∈ s, element i ∈ A) : generated s ≤ A := by
  apply (closure_le A).mpr
  rintro _ ⟨i, hi, rfl⟩
  exact h i hi

public theorem catalogueSubgroup_zero : catalogueSubgroup 0 = ⊥ := by
  apply le_antisymm
  · apply generated_le
    intro i hi
    rw [catalogueSet_zero, Finset.mem_singleton] at hi
    subst i
    exact element_zero ▸ (⊥ : Subgroup Model).one_mem
  · exact bot_le

end CFSG.Quasithin.MainConverse.SporadicLocal.J3Coverage.Fusion
