/-- Products of subsets of a list of indices. -/
@[expose] public def indexSpan : List (Fin 128) → List (Fin 128)
  | [] => [0]
  | x :: xs => indexSpan xs ++ (indexSpan xs).map (mulIndex x)

set_option maxHeartbeats 8000000 in
public theorem class_span : ∀ c : Fin 28,
    classSet c = (indexSpan
      ((representativeBasis (alignedClass c)).map (generatorImage c))).toFinset := by
  apply allFin
  decide +kernel

set_option maxHeartbeats 8000000 in
public theorem generatorImage_mem_class : ∀ (c : Fin 28) (j : Fin 4),
    j ∈ representativeBasis (alignedClass c) → generatorImage c j ∈ classSet c := by
  decide +kernel

