/-- Every listed Sylow fusion witness is verified using the certified
multiplication and inverse tables. -/
public theorem catalogue_conjugation : ∀ i : Fin 140,
    catalogueSet i.succ = (classSet (catalogueClass i)).image
      (conjIndex (catalogueConjugator i)) := by
  apply allFin
  decide +kernel

