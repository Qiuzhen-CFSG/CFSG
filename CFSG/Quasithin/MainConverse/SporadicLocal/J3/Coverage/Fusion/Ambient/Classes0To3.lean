/-!
# Ambient J₃ fusion: Sylow classes 0–3

Each nonidentity packed map is checked against its fixed ambient word on
all 6156 letters. The commuting squares then give the selected generator
images in the concrete model. Empty conjugator words reduce to identity.

Source: GLS, Number 3, Table 5.3h, printed p.269; ATLAS J3G1-p6156B0.
Generated by `Ambient/source/generate.py`; its output is untrusted until
the Lean kernel checks the certificates.
-/

namespace CFSG.Quasithin.MainConverse.SporadicLocal.J3Coverage.Fusion
open Sporadic.Janko3 Sporadic.Janko3.TwoLocal Sporadic.Janko3.OrderCertificate
set_option maxRecDepth 100000
set_option Elab.async false

private def conjugatorPacked0 : Nat := 

private def conjugatorMap0 (x : Fin 6156) : Fin 6156 :=
  ⟨(conjugatorPacked0 >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

set_option maxHeartbeats 800000 in
private theorem conjugatorMap0_eq : ∀ x,
    conjugatorMap0 x = fastConjugator 0 x := by
  apply allLetters
  decide +kernel

set_option maxHeartbeats 800000 in
private theorem square0_0 : ∀ x,
    conjugatorMap0 (fastElement (elementaryGeneratorIndex 0) x) =
      fastElement (generatorImage 0 0) (conjugatorMap0 x) := by
  apply allLetters
  decide +kernel

/-- The selected generator images for Sylow class 0. -/
public theorem ambient_generator_images_0 (j : Fin 4)
    (_hj : j ∈ representativeBasis (alignedClass 0)) :
    (MulAut.conj (ambientConjugator 0)) (elementaryGenerator j) =
      element (generatorImage 0 j) := by
  fin_cases j
  · exact generator_image_of_pointwise 0 0 (fun x => by
      simpa only [conjugatorMap0_eq] using square0_0 x)
  · simp [representativeBasis, alignedClass] at _hj
  · simp [representativeBasis, alignedClass] at _hj
  · simp [representativeBasis, alignedClass] at _hj

