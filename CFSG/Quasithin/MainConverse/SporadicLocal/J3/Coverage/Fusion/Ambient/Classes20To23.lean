import Mathlib.Tactic.FinCases

/-!
# Ambient J₃ fusion: Sylow classes 20–23

Each nonidentity packed map is checked against its fixed ambient word on
all 6156 letters. The commuting squares then give the selected generator
images in the concrete model. Empty conjugator words reduce to identity.

Source: GLS, Number 3, Table 5.3h, printed p.269; ATLAS J3G1-p6156B0.
Generated by `Ambient/source/generate.py`; its output is untrusted until
the Lean kernel checks the certificates.
-/

namespace CFSG.Quasithin.MainConverse.SporadicLocal.J3Coverage.Fusion
open Sporadic.Janko3 Sporadic.Janko3.TwoLocal Sporadic.Janko3.OrderCertificate
set_option maxRecDepth 100000
set_option Elab.async false

private def conjugatorPacked20 : Nat := 

private def conjugatorMap20 (x : Fin 6156) : Fin 6156 :=
  ⟨(conjugatorPacked20 >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

set_option maxHeartbeats 800000 in
private theorem conjugatorMap20_eq : ∀ x,
    conjugatorMap20 x = fastConjugator 20 x := by
  apply allLetters
  decide +kernel

set_option maxHeartbeats 800000 in
private theorem square20_0 : ∀ x,
    conjugatorMap20 (fastElement (elementaryGeneratorIndex 0) x) =
      fastElement (generatorImage 20 0) (conjugatorMap20 x) := by
  apply allLetters
  decide +kernel

set_option maxHeartbeats 800000 in
private theorem square20_1 : ∀ x,
    conjugatorMap20 (fastElement (elementaryGeneratorIndex 1) x) =
      fastElement (generatorImage 20 1) (conjugatorMap20 x) := by
  apply allLetters
  decide +kernel

/-- The selected generator images for Sylow class 20. -/
public theorem ambient_generator_images_20 (j : Fin 4)
    (_hj : j ∈ representativeBasis (alignedClass 20)) :
    (MulAut.conj (ambientConjugator 20)) (elementaryGenerator j) =
      element (generatorImage 20 j) := by
  fin_cases j
  · exact generator_image_of_pointwise 20 0 (fun x => by
      simpa only [conjugatorMap20_eq] using square20_0 x)
  · exact generator_image_of_pointwise 20 1 (fun x => by
      simpa only [conjugatorMap20_eq] using square20_1 x)
  · simp [representativeBasis, alignedClass] at _hj
  · simp [representativeBasis, alignedClass] at _hj

/-- The selected generator images for Sylow class 21. -/
public theorem ambient_generator_images_21 (j : Fin 4)
    (_hj : j ∈ representativeBasis (alignedClass 21)) :
    (MulAut.conj (ambientConjugator 21)) (elementaryGenerator j) =
      element (generatorImage 21 j) := by
  fin_cases j
  · simp [representativeBasis, alignedClass] at _hj
  · exact generator_image_of_pointwise 21 1 (fun _ => rfl)
  · exact generator_image_of_pointwise 21 2 (fun _ => rfl)
  · exact generator_image_of_pointwise 21 3 (fun _ => rfl)

