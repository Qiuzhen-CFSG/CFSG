module

public import CFSG.Quasithin.MainConverse.SporadicLocal.J3.Coverage.Fusion.AmbientSetup
import Mathlib.Tactic.FinCases

/-!
# Ambient J₃ fusion: Sylow classes 12–15

Each nonidentity packed map is checked against its fixed ambient word on
all 6156 letters. The commuting squares then give the selected generator
images in the concrete model. Empty conjugator words reduce to identity.

Source: GLS, Number 3, Table 5.3h, printed p.269; ATLAS J3G1-p6156B0.
Generated by `Ambient/source/generate.py`; its output is untrusted until
the Lean kernel checks the certificates.
-/

namespace CFSG.Quasithin.MainConverse.SporadicLocal.J3Coverage.Fusion
open Sporadic.Janko3 Sporadic.Janko3.TwoLocal Sporadic.Janko3.OrderCertificate
set_option maxRecDepth 100000
set_option Elab.async false

private def conjugatorPacked12 : Nat := 

private def conjugatorMap12 (x : Fin 6156) : Fin 6156 :=
  ⟨(conjugatorPacked12 >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

set_option maxHeartbeats 800000 in
private theorem conjugatorMap12_eq : ∀ x,
    conjugatorMap12 x = fastConjugator 12 x := by
  apply allLetters
  decide +kernel

set_option maxHeartbeats 800000 in
private theorem square12_0 : ∀ x,
    conjugatorMap12 (fastElement (elementaryGeneratorIndex 0) x) =
      fastElement (generatorImage 12 0) (conjugatorMap12 x) := by
  apply allLetters
  decide +kernel

set_option maxHeartbeats 800000 in
private theorem square12_1 : ∀ x,
    conjugatorMap12 (fastElement (elementaryGeneratorIndex 1) x) =
      fastElement (generatorImage 12 1) (conjugatorMap12 x) := by
  apply allLetters
  decide +kernel

/-- The selected generator images for Sylow class 12. -/
public theorem ambient_generator_images_12 (j : Fin 4)
    (_hj : j ∈ representativeBasis (alignedClass 12)) :
    (MulAut.conj (ambientConjugator 12)) (elementaryGenerator j) =
      element (generatorImage 12 j) := by
  fin_cases j
  · exact generator_image_of_pointwise 12 0 (fun x => by
      simpa only [conjugatorMap12_eq] using square12_0 x)
  · exact generator_image_of_pointwise 12 1 (fun x => by
      simpa only [conjugatorMap12_eq] using square12_1 x)
  · simp [representativeBasis, alignedClass] at _hj
  · simp [representativeBasis, alignedClass] at _hj

