module

public import CFSG.Quasithin.MainConverse.SporadicLocal.J3.Coverage.Fusion.AmbientSetup
import Mathlib.Tactic.FinCases

/-!
# Ambient J₃ fusion: Sylow classes 24–27

Each nonidentity packed map is checked against its fixed ambient word on
all 6156 letters. The commuting squares then give the selected generator
images in the concrete model. Empty conjugator words reduce to identity.

Source: GLS, Number 3, Table 5.3h, printed p.269; ATLAS J3G1-p6156B0.
Generated by `Ambient/source/generate.py`; its output is untrusted until
the Lean kernel checks the certificates.
-/

namespace CFSG.Quasithin.MainConverse.SporadicLocal.J3Coverage.Fusion
open Sporadic.Janko3 Sporadic.Janko3.TwoLocal Sporadic.Janko3.OrderCertificate
set_option maxRecDepth 100000
set_option Elab.async false

private def conjugatorPacked24 : Nat := 

private def conjugatorMap24 (x : Fin 6156) : Fin 6156 :=
  ⟨(conjugatorPacked24 >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

set_option maxHeartbeats 800000 in
private theorem conjugatorMap24_eq : ∀ x,
    conjugatorMap24 x = fastConjugator 24 x := by
  apply allLetters
  decide +kernel

set_option maxHeartbeats 800000 in
private theorem square24_1 : ∀ x,
    conjugatorMap24 (fastElement (elementaryGeneratorIndex 1) x) =
      fastElement (generatorImage 24 1) (conjugatorMap24 x) := by
  apply allLetters
  decide +kernel

set_option maxHeartbeats 800000 in
private theorem square24_2 : ∀ x,
    conjugatorMap24 (fastElement (elementaryGeneratorIndex 2) x) =
      fastElement (generatorImage 24 2) (conjugatorMap24 x) := by
  apply allLetters
  decide +kernel

set_option maxHeartbeats 800000 in
private theorem square24_3 : ∀ x,
    conjugatorMap24 (fastElement (elementaryGeneratorIndex 3) x) =
      fastElement (generatorImage 24 3) (conjugatorMap24 x) := by
  apply allLetters
  decide +kernel

/-- The selected generator images for Sylow class 24. -/
public theorem ambient_generator_images_24 (j : Fin 4)
    (_hj : j ∈ representativeBasis (alignedClass 24)) :
    (MulAut.conj (ambientConjugator 24)) (elementaryGenerator j) =
      element (generatorImage 24 j) := by
  fin_cases j
  · simp [representativeBasis, alignedClass] at _hj
  · exact generator_image_of_pointwise 24 1 (fun x => by
      simpa only [conjugatorMap24_eq] using square24_1 x)
  · exact generator_image_of_pointwise 24 2 (fun x => by
      simpa only [conjugatorMap24_eq] using square24_2 x)
  · exact generator_image_of_pointwise 24 3 (fun x => by
      simpa only [conjugatorMap24_eq] using square24_3 x)

