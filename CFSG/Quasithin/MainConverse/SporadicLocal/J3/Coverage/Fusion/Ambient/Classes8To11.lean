/-!
# Ambient J₃ fusion: Sylow classes 8–11

Each nonidentity packed map is checked against its fixed ambient word on
all 6156 letters. The commuting squares then give the selected generator
images in the concrete model. Empty conjugator words reduce to identity.

Source: GLS, Number 3, Table 5.3h, printed p.269; ATLAS J3G1-p6156B0.
Generated by `Ambient/source/generate.py`; its output is untrusted until
the Lean kernel checks the certificates.
-/

namespace CFSG.Quasithin.MainConverse.SporadicLocal.J3Coverage.Fusion
open Sporadic.Janko3 Sporadic.Janko3.TwoLocal Sporadic.Janko3.OrderCertificate
set_option maxRecDepth 100000
set_option Elab.async false

private def conjugatorPacked8 : Nat := 

private def conjugatorMap8 (x : Fin 6156) : Fin 6156 :=
  ⟨(conjugatorPacked8 >>> (13 * x.val)) % 8192 % 6156, Nat.mod_lt _ (by decide)⟩

set_option maxHeartbeats 800000 in
private theorem conjugatorMap8_eq : ∀ x,
    conjugatorMap8 x = fastConjugator 8 x := by
  apply allLetters
  decide +kernel

set_option maxHeartbeats 800000 in
private theorem square8_0 : ∀ x,
    conjugatorMap8 (fastElement (elementaryGeneratorIndex 0) x) =
      fastElement (generatorImage 8 0) (conjugatorMap8 x) := by
  apply allLetters
  decide +kernel

set_option maxHeartbeats 800000 in
private theorem square8_1 : ∀ x,
    conjugatorMap8 (fastElement (elementaryGeneratorIndex 1) x) =
      fastElement (generatorImage 8 1) (conjugatorMap8 x) := by
  apply allLetters
  decide +kernel

/-- The selected generator images for Sylow class 8. -/
public theorem ambient_generator_images_8 (j : Fin 4)
    (_hj : j ∈ representativeBasis (alignedClass 8)) :
    (MulAut.conj (ambientConjugator 8)) (elementaryGenerator j) =
      element (generatorImage 8 j) := by
  fin_cases j
  · exact generator_image_of_pointwise 8 0 (fun x => by
      simpa only [conjugatorMap8_eq] using square8_0 x)
  · exact generator_image_of_pointwise 8 1 (fun x => by
      simpa only [conjugatorMap8_eq] using square8_1 x)
  · simp [representativeBasis, alignedClass] at _hj
  · simp [representativeBasis, alignedClass] at _hj

