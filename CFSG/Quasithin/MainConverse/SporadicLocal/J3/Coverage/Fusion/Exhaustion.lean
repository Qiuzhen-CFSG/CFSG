module

public import CFSG.Quasithin.MainConverse.SporadicLocal.J3.Coverage.Fusion.CatalogueData

/-!
# Exhausting elementary subgroups of the fixed Sylow candidate

Choose a largest catalogue subset contained in the given elementary subgroup.
If it omits an element, that element is an involution commuting with every
entry. The checked extension row is a larger catalogue subset still contained
in the subgroup, a contradiction. Surjectivity of the Sylow enumeration then
identifies the actual subgroup with the subgroup generated by that row.

Source: the computational route to GLS, Number 3, Table 5.3h, printed p.269.
-/

namespace CFSG.Quasithin.MainConverse.SporadicLocal.J3Coverage.Fusion
open Subgroup Sporadic.Janko3 Sporadic.Janko3.TwoLocal

/-- Every nontrivial elementary subgroup in the fixed Sylow candidate is
one of the 140 nontrivial catalogue rows. -/
public theorem elementary_eq_catalogue (hS : Nat.card sylowCandidate = 128)
    (A : Subgroup Model) (hAS : A ≤ sylowCandidate) (hA : A ≠ ⊥)
    (hEA : IsElementaryAbelian 2 A) :
    ∃ i : Fin 140, A = catalogueSubgroup i.succ := by
  classical
  let : IsElementaryAbelian 2 A := hEA
  let eligible : Finset (Fin 141) :=
    Finset.univ.filter (fun i => ∀ j ∈ catalogueSet i, element j ∈ A)
  have hzero : (0 : Fin 141) ∈ eligible := by
    simp only [eligible, Finset.mem_filter, Finset.mem_univ, true_and]
    intro j hj
    rw [catalogueSet_zero, Finset.mem_singleton] at hj
    subst j
    exact element_zero ▸ A.one_mem
  obtain ⟨i, hi, hmax⟩ :=
    eligible.exists_max_image (fun i => (catalogueSet i).card) ⟨0, hzero⟩
  have hiA : ∀ j ∈ catalogueSet i, element j ∈ A := (Finset.mem_filter.mp hi).2
  have hfull (j : Fin 128) (hjA : element j ∈ A) : j ∈ catalogueSet i := by
    have hsq : mulIndex j j = 0 := by
      apply element_injective
      rw [element_mul hS, element_zero]
      simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) _ hjA
    have hcomm : ∀ k ∈ catalogueSet i, mulIndex j k = mulIndex k j := by
      intro k hk
      apply element_injective
      rw [element_mul hS, element_mul hS]
      exact setLike_mul_comm hjA (hiA k hk)
    have hext := extension_spec i j hsq hcomm
    have hsub : catalogueSet i ⊆ catalogueSet (extensionIndex i j) := by
      rw [hext]
      exact Finset.subset_union_left
    have heA : extensionIndex i j ∈ eligible := by
      simp only [eligible, Finset.mem_filter, Finset.mem_univ, true_and]
      intro k hk
      rw [hext, Finset.mem_union, Finset.mem_image] at hk
      rcases hk with hk | ⟨l, hl, rfl⟩
      · exact hiA k hk
      · rw [element_mul hS]
        exact A.mul_mem hjA (hiA l hl)
    have heq := Finset.eq_of_subset_of_card_le hsub (hmax _ heA)
    rw [heq, hext]
    apply Finset.mem_union_right
    apply Finset.mem_image.mpr
    refine ⟨0, zero_mem_catalogueSet i, ?_⟩
    apply element_injective
    rw [element_mul hS, element_zero, mul_one]
  have hEq : A = catalogueSubgroup i := by
    apply le_antisymm
    · intro x hx
      obtain ⟨j, hj⟩ := sylowEnumeration_surjective hS ⟨x, hAS hx⟩
      have hej : element j = x := congrArg Subtype.val hj
      rw [← hej]
      exact element_mem_generated (hfull j (hej.symm ▸ hx))
    · exact generated_le hiA
  have hine : i ≠ 0 := by
    intro he
    exact hA (hEq.trans (he ▸ catalogueSubgroup_zero))
  let k : Fin 140 := ⟨i.val - 1, by have := i.isLt; omega⟩
  have hk : k.succ = i := by
    apply Fin.ext
    have : i.val ≠ 0 := fun h => hine (Fin.ext h)
    dsimp [k]
    omega
  exact ⟨k, hk.symm ▸ hEq⟩

end CFSG.Quasithin.MainConverse.SporadicLocal.J3Coverage.Fusion
