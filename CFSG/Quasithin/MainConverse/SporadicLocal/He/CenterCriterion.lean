module

public import CFSG.Quasithin.Defs
public import Theory.SpecificGroups.Held.TwoLocalCandidates.CentralInvolutionBounds
public import Theory.SpecificGroups.Held.TwoLocalCandidates.Cores.Structure
public import Theory.SpecificGroups.Held.Automorphisms.Realization.MarkedConjugacy.SeventeenSylow.Preservation
public import Theory.GroupTheory.CenterTwoCoreSylowPromotion
public import Theory.GroupTheory.SylowLocalCentralizerCriterion
public import Mathlib.GroupTheory.IndexNormal
public import Mathlib.GroupTheory.GroupAction.ConjAct
import Mathlib.Tactic

/-!
# Held even characteristic from the actual max5 core centralizer

Let z be the fourth power of the first literal max5 generator and C its
centralizer in Held. The certified bounds |max5| >= 21504 and |C| <= 43008
make max5 normal in C. Its word-defined normal two-subgroup therefore lies
in O2(C), by first passing through the characteristic two-core of max5.
The smaller word-defined core is not assumed normal in C.

The sole remaining input bounds the full graph centralizer of that core
by the cyclic group generated by z. Faithfulness then shows that O2(C) is
self-centralizing in C and has center of order two. Sylow promotion gives
an actual ambient Sylow subgroup whose center is generated by z, and the
Sylow-local centralizer criterion yields even characteristic. All maps are
the given subgroup inclusions and the fixed degree-2058 representation.

Source: Aschbacher–Smith, Theorem 0.1.2(5), printed pp.4 and 482;
GLS3 Table 5.3p. The finite max5 and graph certificates are imported from
CentralInvolutionBounds. The parent Held module supplies the final graph
core-centralizer theorem and assembles the unconditional source case.
-/

namespace CFSG.Quasithin.MainConverse.SporadicLocal.HeEven

open Subgroup Held Held.TwoLocalCandidates
open Held.TwoLocalCandidates.Cores
open Held.TwoLocalCandidates.CentralInvolutionBounds

private abbrev z : Held.He := max5First ^ 4
private abbrev C : Subgroup Held.He := centralizer ({z} : Set Held.He)
private abbrev N : Subgroup C := (subgroup 2).subgroupOf C
private abbrev zC : C := ⟨z, mem_centralizer_singleton_iff.mpr rfl⟩
private theorem candidate_le_centralizer : subgroup 2 ≤ C := max5_le_centralizer
private abbrev incl : subgroup 2 →* C := inclusion candidate_le_centralizer

private theorem centralizer_card_le : Nat.card C ≤ 43008 := by
  have hle : C.map representation ≤ NormalizerGraph.preservingGroup ⊓
      centralizer ({representation z} : Set (Equiv.Perm (Fin 2058))) := by
    rintro _ ⟨x, hx, rfl⟩
    constructor
    · exact Realization.MarkedConjugacy.Seventeen.permutationGroup_le_preservingGroup x.property
    · apply mem_centralizer_singleton_iff.mpr
      simpa only [map_mul] using congrArg representation
        (mem_centralizer_singleton_iff.mp hx)
  have hcard := Nat.card_le_card_of_injective
    (inclusion hle) (inclusion_injective hle)
  rw [card_map_of_injective representation_injective] at hcard
  exact hcard.trans graph_centralizer_card_le

private theorem max5_normal_in_centralizer : N.Normal := by
  have hcard : Nat.card N = Nat.card (subgroup 2) :=
    Nat.card_congr (subgroupOfEquivOfLe candidate_le_centralizer).toEquiv
  have hmul := N.card_mul_index
  have hlower : 21504 ≤ Nat.card (subgroup 2) := max5_card_lower_bound
  have hupper := centralizer_card_le
  have hpos : 0 < N.index := Nat.pos_of_ne_zero N.index_ne_zero_of_finite
  have hindex : N.index ≤ 2 := by
    rw [hcard] at hmul
    have hprod : 21504 * N.index ≤ 43008 :=
      (Nat.mul_le_mul_right N.index hlower).trans (hmul.le.trans hupper)
    omega
  rcases (show N.index = 1 ∨ N.index = 2 by omega) with h | h
  · exact normal_of_index_eq_one h
  · exact normal_of_index_eq_two h

private theorem coreImage_le_twoCore : (core 2).map incl ≤ pCore 2 C := by
  let : N.Normal := max5_normal_in_centralizer
  let e : subgroup 2 ≃* N := (subgroupOfEquivOfLe candidate_le_centralizer).symm
  have hnormal : ((core 2).map e.toMonoidHom).Normal :=
    (core_normal 2).map e.toMonoidHom e.surjective
  have hq : (core 2).map e.toMonoidHom ≤ pCore 2 N :=
    le_sSup ⟨hnormal, (core_isPGroup 2).map e.toMonoidHom⟩
  have hk : (pCore 2 N).map N.subtype ≤ pCore 2 C :=
    le_sSup ⟨inferInstance, pCore_isPGroup.map N.subtype⟩
  have he : N.subtype.comp e.toMonoidHom = incl := by ext x; rfl
  calc
    (core 2).map incl = ((core 2).map e.toMonoidHom).map N.subtype := by
      rw [map_map, he]
    _ ≤ (pCore 2 N).map N.subtype := map_mono hq
    _ ≤ pCore 2 C := hk

private theorem generator_zero_coe : (coreGenerator 2 0 : Held.He) = z := by
  apply representation_injective
  exact (Tables2.p2_eq).symm.trans p2_eq_representation

private theorem centralInvolution_mem_twoCore : zC ∈ pCore 2 C := by
  apply coreImage_le_twoCore
  refine ⟨coreGenerator 2 0, coreGenerator_mem 2 0, ?_⟩
  exact Subtype.ext generator_zero_coe

private theorem centralInvolution_mem_center : zC ∈ center C := by
  apply mem_center_iff.mpr
  intro x
  exact Subtype.ext (mem_centralizer_singleton_iff.mp x.property)

private theorem coreCentralizer_le_cyclic
    (h : NormalizerGraph.preservingGroup ⊓
      centralizer ((core 2).map (embedding 2) : Set (Equiv.Perm (Fin 2058))) ≤
        zpowers (representation (max5First ^ 4))) :
    centralizer (pCore 2 C : Set C) ≤ zpowers zC := by
  intro x hx
  have hxgraph : representation (x : Held.He) ∈ NormalizerGraph.preservingGroup ⊓
      centralizer ((core 2).map (embedding 2) : Set (Equiv.Perm (Fin 2058))) := by
    constructor
    · exact Realization.MarkedConjugacy.Seventeen.permutationGroup_le_preservingGroup x.val.property
    · rintro _ ⟨y, hy, rfl⟩
      have hh := hx (incl y) (coreImage_le_twoCore (mem_map_of_mem incl hy))
      have hh' : (y : Held.He) * (x : Held.He) = (x : Held.He) * (y : Held.He) :=
        congrArg (fun c : C => (c : Held.He)) hh
      change representation (y : Held.He) * representation (x : Held.He) =
        representation (x : Held.He) * representation (y : Held.He)
      exact (map_mul representation _ _).symm.trans
        ((congrArg representation hh').trans (map_mul representation _ _))
  obtain ⟨k, hk⟩ := mem_zpowers_iff.mp (h hxgraph)
  refine mem_zpowers_iff.mpr ⟨k, ?_⟩
  apply Subtype.ext
  apply representation_injective
  change representation (z ^ k) = representation (x : Held.He)
  rw [map_zpow]
  exact hk

private theorem centralizer_core_properties
    (h : NormalizerGraph.preservingGroup ⊓
      centralizer ((core 2).map (embedding 2) : Set (Equiv.Perm (Fin 2058))) ≤
        zpowers (representation (max5First ^ 4))) :
    Nat.card (center (pCore 2 C)) = 2 ∧ HasCharacteristicTwo C := by
  have hz : zpowers zC ≤ pCore 2 C := zpowers_le.mpr centralInvolution_mem_twoCore
  have hb := coreCentralizer_le_cyclic h
  have hself : centralizer (pCore 2 C : Set C) ≤ pCore 2 C := hb.trans hz
  have hreverse : zpowers zC ≤ centralizer (pCore 2 C : Set C) := by
    apply zpowers_le.mpr
    intro x _
    exact mem_center_iff.mp centralInvolution_mem_center x
  have heq : (center (pCore 2 C)).map (pCore 2 C).subtype = zpowers zC :=
    (centralizer_eq_mapped_center_of_le _ hself).symm.trans (le_antisymm hb hreverse)
  refine ⟨?_, hself⟩
  rw [← card_map_of_injective (pCore 2 C).subtype_injective, heq, Nat.card_zpowers]
  exact (orderOf_coe zC).symm.trans orderOf_centralInvolution

private theorem evenCharacteristic_of_center_two_core
    {G : Type*} [Group G] [Finite G] (z : G) (hz : orderOf z = 2)
    (hc : Nat.card (center (pCore 2 (centralizer ({z} : Set G)))) = 2)
    (hself : HasCharacteristicTwo (centralizer ({z} : Set G))) :
    IsEvenCharacteristic G := by
  classical
  let T : Sylow 2 (centralizer ({z} : Set G)) := default
  obtain ⟨S, hS⟩ := (centralizer_structure_of_center_two_core z
    hz hc hself).2.2 T
  have hcenter : (center (S : Subgroup G)).map (S : Subgroup G).subtype =
      zpowers z := by
    rw [hS]
    exact mapped_sylow_center_of_center_two_core z hz hc hself T
  apply IsEvenCharacteristicAt.all (T := S)
  intro M hM hSM
  obtain ⟨Q, hQ, hp, rfl⟩ := hM.1
  apply normalizer_core_selfCentralizing_of_sylow_centralizers S Q hp hQ hSM
  intro x hx ho
  change HasCharacteristicTwo (centralizer ({(x : G)} : Set G))
  have hxc : (x : G) ∈ zpowers z := by
    rw [← hcenter]
    exact ⟨x, hx, rfl⟩
  rw [mem_zpowers_iff_mem_range_orderOf, hz] at hxc
  obtain ⟨i, hi, he⟩ := Finset.mem_image.mp hxc
  have hlt : i < 2 := Finset.mem_range.mp hi
  have he : (x : G) = 1 ∨ (x : G) = z := by
    rcases (show i = 0 ∨ i = 1 by omega) with rfl | rfl
    · exact Or.inl (by simpa using he.symm)
    · exact Or.inr (by simpa using he.symm)
  rcases he with he | he
  · have hx1 : x = 1 := Subtype.ext he
    simp [hx1] at ho
  · exact (congrArg (fun t : G =>
      HasCharacteristicTwo (centralizer ({t} : Set G))) he).mpr hself

/-- The only remaining finite input is the graph centralizer bound for the
actual max5 core. All ambient Sylow and characteristic-two inputs follow. -/
public theorem evenCharacteristic_of_graph_core_bound
    (h : NormalizerGraph.preservingGroup ⊓
      centralizer ((core 2).map (embedding 2) : Set (Equiv.Perm (Fin 2058))) ≤
        zpowers (representation (max5First ^ 4))) : IsEvenCharacteristic Held.He := by
  obtain ⟨hc, hself⟩ := centralizer_core_properties h
  exact evenCharacteristic_of_center_two_core z orderOf_centralInvolution hc hself

end CFSG.Quasithin.MainConverse.SporadicLocal.HeEven
