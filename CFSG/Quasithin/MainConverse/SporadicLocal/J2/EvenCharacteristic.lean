module

public import CFSG.Quasithin.MainConverse.SporadicLocal.J2.EvenSetup
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.ExceptionalParabolics.SecondParabolic.SylowCenter
public import Theory.GroupTheory.SylowLocalCentralizerCriterion

/-!
# Even characteristic of the Hall–Janko carrier

The center of the checked Sylow two-subgroup is generated by the actual
involution `FirstFusion.t`. Its centralizer is exactly `Seed.l₁`, whose
two-core is already proved self-centralizing. The Sylow-local centralizer
criterion therefore proves characteristic two for every two-local containing
this Sylow subgroup. Sylow conjugacy supplies condition E for the whole group.

This proves the even-characteristic branch of the J₂ converse directly on the
unchanged degree-100 carrier. It requires no local-cover or second-centralizer
premise; the general criterion handles the arbitrary local normalizer.

Source: Aschbacher–Smith, Theorem 0.1.2(5), printed pp.4 and 482. The actual
Sylow-center certificate is recorded with the carrier facts used for 16.3.4,
printed p.1178 / PDF p.1195; the first-centralizer calculation is the one used
for 16.1.5(8).
-/

public section
namespace CFSG.Quasithin.MainConverse.SporadicLocal.J2Even
open Subgroup
open Sporadic.LeechRelated.J2 Sporadic.LeechRelated.J2.ExceptionalParabolics
open Sporadic.LeechRelated.J2.GeneratorPair

/-- Every central involution of the actual chosen Sylow subgroup is the first Seed involution. -/
theorem sylow_central_involution_eq (z : sylowTwo)
    (hz : z ∈ center sylowTwo) (ho : orderOf z = 2) :
    (z : Carrier) = FirstFusion.t := by
  classical
  have hm : (z : Carrier) ∈ zpowers FirstFusion.t := by
    rw [← SecondParabolic.center_s]
    exact mem_map_of_mem Seed.s.subtype hz
  rw [mem_zpowers_iff_mem_range_orderOf, SecondParabolic.central_involution_order] at hm
  obtain ⟨n, hn, he⟩ := Finset.mem_image.mp hm
  have hlt : n < 2 := Finset.mem_range.mp hn
  have hn : n = 0 ∨ n = 1 := by omega
  rcases hn with rfl | rfl
  · have hz1 : z = 1 := Subtype.ext (by simpa using he.symm)
    simp [hz1] at ho
  · simpa using he.symm

/-- The centralizer required by the Sylow-local criterion is the certified first local group. -/
theorem sylow_central_involution_characteristicTwo (z : sylowTwo)
    (hz : z ∈ center sylowTwo) (ho : orderOf z = 2) :
    HasCharacteristicTwo (centralizer ({(z : Carrier)} : Set Carrier)) := by
  rw [sylow_central_involution_eq z hz ho]
  exact first_characteristicTwo

/-- The unchanged degree-100 Hall–Janko carrier has even characteristic. -/
theorem evenCharacteristic : IsEvenCharacteristic Carrier := by
  apply IsEvenCharacteristicAt.all (T := sylowTwo)
  intro M hM hTM
  obtain ⟨Q, hQ, hp, rfl⟩ := hM.1
  exact normalizer_core_selfCentralizing_of_sylow_centralizers
    sylowTwo Q hp hQ hTM sylow_central_involution_characteristicTwo

/-- Condition E transports through the actual J₂ catalogue equivalence. -/
theorem evenCharacteristic_of_equiv
    {G : Type*} [Group G] [Finite G]
    (e : G ≃* ClassificationModels.SporadicName.j2.Carrier) :
    IsEvenCharacteristic G := by
  change G ≃* Carrier at e
  exact evenCharacteristic_of_model_equiv e evenCharacteristic

end CFSG.Quasithin.MainConverse.SporadicLocal.J2Even
