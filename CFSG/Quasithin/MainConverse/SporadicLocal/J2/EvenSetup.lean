module

public import CFSG.Quasithin.MainConverse.SporadicLocal.Criteria
public import CFSG.Quasithin.Chapter16.Section01To02.OtherPreliminaries.JankoTwoHigmanSims.J2Inner.CentralAction

/-!
# The two Sylow-containing Hall–Janko local candidates

The fixed subgroup of order 128 is Sylow in the actual degree-100 carrier.
The first candidate is the central involution centralizer; its normal
self-centralizing two-kernel is already proved. For the second candidate,
the full normalizer of `Seed.q₂`, relative normality and the two-group
property are already proved, and self-centralization remains explicit.

`SylowLocalCover` asks for coverage of every maximal two-local containing
this Sylow subgroup by actual isomorphisms to the two candidates. This
coverage and the second centralizer calculation are still obligations.
The conditional assembly is not the completed J₂ source theorem.

Source: Aschbacher–Smith, Theorem 0.1.2(5), printed pp.4 and 482;
GLS3, Table 5.3g. The first centralizer calculation is reused from the
literal carrier calculation for 16.1.5(8), with intrinsic normality.
-/

@[expose] public section
namespace CFSG.Quasithin.MainConverse.SporadicLocal.J2Even
open Subgroup
open Sporadic.LeechRelated.J2 Sporadic.LeechRelated.J2.ExceptionalParabolics

/-- The certified Sylow subgroup generated by the seven fixed Seed words. -/
abbrev sylowTwo : Sylow 2 Carrier := SecondParabolic.sylow FirstParabolic.card_l₁

/-- The exhaustive cover required by condition E at the fixed Sylow subgroup. -/
def SylowLocalCover : Prop :=
  ∀ M : Subgroup Carrier, IsMaximalTwoLocal M → (sylowTwo : Subgroup Carrier) ≤ M →
    Nonempty (M ≃* Seed.l₁) ∨ Nonempty (M ≃* Seed.p₂)

/-- The first local candidate has a self-centralizing intrinsic two-core. -/
theorem first_characteristicTwo : HasCharacteristicTwo Seed.l₁ := by
  obtain ⟨Q, hn, hp, hc⟩ :=
    CFSG.Quasithin.Chapter16.OtherPreliminaries.JankoTwoHigmanSims.J2Inner.t_selfCentralizing
  have hQ : Q ≤ pCore 2 Seed.l₁ := le_sSup ⟨hn, hp⟩
  exact fun x hx => hQ (hc ((centralizer_le hQ) hx))

/-- The remaining radical-centralizer check suffices for the second candidate. -/
theorem second_characteristicTwo
    (hc : centralizer (Seed.q₂.subgroupOf Seed.p₂ : Set Seed.p₂) ≤
      Seed.q₂.subgroupOf Seed.p₂) : HasCharacteristicTwo Seed.p₂ := by
  have hp : IsPGroup 2 (Seed.q₂.subgroupOf Seed.p₂) :=
    PairNormalizer.q₂_isPGroup.of_equiv (subgroupOfEquivOfLe Seed.q₂.le_normalizer).symm
  have hQ : Seed.q₂.subgroupOf Seed.p₂ ≤ pCore 2 Seed.p₂ :=
    le_sSup ⟨PairNormalizer.q₂_normal_in_p₂, hp⟩
  exact fun x hx => hQ (hc ((centralizer_le hQ) hx))

/-- Conditional assembly, retaining both outstanding concrete local inputs. -/
theorem evenCharacteristic_of_cover
    (hcover : SylowLocalCover)
    (hc : centralizer (Seed.q₂.subgroupOf Seed.p₂ : Set Seed.p₂) ≤
      Seed.q₂.subgroupOf Seed.p₂) : IsEvenCharacteristic Carrier := by
  apply IsEvenCharacteristicAt.all (T := sylowTwo)
  intro M hM hTM
  rcases hcover M hM hTM with h | h
  · obtain ⟨e⟩ := h
    exact first_characteristicTwo.of_equiv e.symm
  · obtain ⟨e⟩ := h
    exact (second_characteristicTwo hc).of_equiv e.symm

end CFSG.Quasithin.MainConverse.SporadicLocal.J2Even
