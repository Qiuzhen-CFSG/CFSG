public theorem q4_map (x : Fin 4060) : q4Map x = q₄.val x := by
  change q4Map x = firstMap (q₂.val (firstInvMap x))
  exact (q4_map_check x).trans (congrArg firstMap (q2_map (firstInvMap x)))

@[expose] public def seedMap : Fin 5 → Fin 4060 → Fin 4060 :=
  ![q0Map, q1Map, q2Map, q3Map, q4Map]

public theorem seedMap_eq (i : Fin 5) (x : Fin 4060) :
    seedMap i x = (seedGenerator i).val x := by
  fin_cases i
  · exact q0_map x
  · exact q1_map x
  · exact q2_map x
  · exact q3_map x
  · exact q4_map x

@[expose] public def wordMap (t : Fin 64) (x : Fin 4060) : Fin 4060 :=
  q0Map^[t.val % 4] (q1Map^[t.val / 4 % 2] (q2Map^[t.val / 8 % 2]
    (q3Map^[t.val / 16 % 2] (q4Map^[t.val / 32 % 2] x))))

public theorem wordMap_eq (t : Fin 64) (x : Fin 4060) :
    wordMap t x = (seedWord t).val x := by
  have h₀ : q0Map = fun x : Fin 4060 => q₀ • x := funext q0_map
  have h₁ : q1Map = fun x : Fin 4060 => q₁ • x := funext q1_map
  have h₂ : q2Map = fun x : Fin 4060 => q₂ • x := funext q2_map
  have h₃ : q3Map = fun x : Fin 4060 => q₃ • x := funext q3_map
  have h₄ : q4Map = fun x : Fin 4060 => q₄ • x := funext q4_map
  simp only [wordMap, h₀, h₁, h₂, h₃, h₄, smul_iterate_apply, seedWord]
  rfl

