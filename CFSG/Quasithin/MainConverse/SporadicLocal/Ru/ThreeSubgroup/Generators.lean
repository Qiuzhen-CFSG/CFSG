module

public import Theory.SpecificGroups.Rudvalis.Model.Basic
public import Theory.SpecificGroups.Rudvalis.Model.OuterStabilizer.TitsEmbedding.Relations.Letters

/-!
# Two concrete three-elements in Rudvalis

The two retained words in the certified point-stabilizer generators are checked
against their packed permutation tables on all 4060 letters. Thus both elements
belong to the original ATLAS carrier. Their cubes are also checked pointwise.
The following enumeration certificate establishes the generated subgroup order.

Source: Wilson–Nickerson–Bray, ATLAS `RuG1-p4060B0`, as retained and attributed
in `Theory/SpecificGroups/Rudvalis/Model/PermutationData.lean`. Inverse point
maps convert the right action to Lean's left action, preserving word order.
The three-local context is GLS3, Table 5.3r, p.279, row 3A. See `source/README.md`.
-/

namespace CFSG.Quasithin.MainConverse.SporadicLocal.RuRank.ThreeCertificate
open Rudvalis Theory.GroupTheory
open Rudvalis.OuterStabilizer.TitsEmbedding
open Rudvalis.OuterStabilizer.TitsEmbedding.RelationCertificate

set_option maxRecDepth 100000
set_option maxHeartbeats 2000000

@[expose] public def xMapPacked : Nat := 
@[expose] public def xMap (i : Fin 4060) : Fin 4060 :=
  ⟨(xMapPacked >>> (12 * i.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

private theorem x_left : ∀ i, xMap (xMap (xMap i)) = i := by
  apply Data.allFin
  decide +kernel

@[expose] public def xPerm : Equiv.Perm (Fin 4060) :=
  tablePerm xMap (fun i => xMap (xMap i)) (by exact x_left)
    (by exact rightInverse_of_leftInverse_fin x_left)

@[expose] public def xWord : List (Fin 4) := [3, 3, 2, 1, 0, 3, 0, 0, 0, 0, 0, 0, 3, 3, 2, 3, 2, 1, 2, 1, 0, 0, 0, 3, 2, 1, 0, 1, 0, 3]

public theorem xPerm_eq_word : xPerm = evalWord permutationLetter xWord := by
  apply Equiv.ext
  apply Data.allFin
  decide +kernel

private theorem xPerm_mem : xPerm ∈ modelSubgroup := by
  rw [xPerm_eq_word, word_eq]
  exact (evalWord letter xWord).property

@[expose] public def x : Model := ⟨xPerm, by exact xPerm_mem⟩

@[expose] public def yMapPacked : Nat := 
@[expose] public def yMap (i : Fin 4060) : Fin 4060 :=
  ⟨(yMapPacked >>> (12 * i.val)) % 4096 % 4060, Nat.mod_lt _ (by decide)⟩

private theorem y_left : ∀ i, yMap (yMap (yMap i)) = i := by
  apply Data.allFin
  decide +kernel

@[expose] public def yPerm : Equiv.Perm (Fin 4060) :=
  tablePerm yMap (fun i => yMap (yMap i)) (by exact y_left)
    (by exact rightInverse_of_leftInverse_fin y_left)

@[expose] public def yWord : List (Fin 4) := [1, 2, 3, 2, 3, 0, 1, 2, 2, 2, 1, 2, 2, 3, 2, 2, 3, 0, 1, 0, 1, 0, 3, 3, 0, 0, 1, 0, 0, 3, 2, 3, 3, 3, 0, 3, 2, 1, 1, 2, 3, 2]

public theorem yPerm_eq_word : yPerm = evalWord permutationLetter yWord := by
  apply Equiv.ext
  apply Data.allFin
  decide +kernel

private theorem yPerm_mem : yPerm ∈ modelSubgroup := by
  rw [yPerm_eq_word, word_eq]
  exact (evalWord letter yWord).property

@[expose] public def y : Model := ⟨yPerm, by exact yPerm_mem⟩

end CFSG.Quasithin.MainConverse.SporadicLocal.RuRank.ThreeCertificate
