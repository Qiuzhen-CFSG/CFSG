module
public import CFSG.Quasithin.Chapter4.Section03.A5.SourceSetup
/-!
# The original A₅ module is the full source pushing-up module

For a normalized component in C.2.8, the full module W is elementary,
normal in L and generated by its L-commutators. Thus W lies in O₂(L)
and then in [O₂(L),L]. In the actual Baumann-escape application this
characteristic subgroup is exactly the original V. The source conjugator
normalizes L and therefore preserves V, so the opposite containment is
also literal: W=V. The resulting C.2.8 configuration retains the unchanged
original A₅ action and needs no new module identification.

Source: Aschbacher–Smith 4.3.2, printed p.613, specialized to the genuine
A₅-block supplied in the proof of 5.1.7, printed pp.630–631.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter4.Section03.A5
variable {G : Type*} [Group G] [Finite G]
variable {H M L R W : Subgroup G}

omit [Finite G] in
/-- The normalized C.2.8 module is contained in the intrinsic commutator layer. -/
theorem module_le_blockU (h : ChapterC.HypothesisC28 KnownSimple.IsKnownSimple H M L R W)
    (hML : M ≤ normalizer (L : Set G)) : W ≤ (ChapterC.blockU L).map L.subtype := by
  have hspan : conjugateSpanBy L M = L := le_antisymm
    (conjugateSpanBy_le le_rfl hML) (le_conjugateSpanBy L M)
  have hWL : W ≤ L := hspan ▸ h.module_le
  have hcomm : W = ⁅W,L⁆ := by simpa only [hspan] using h.module_commutator
  have hLW : L ≤ normalizer (W : Set G) :=
    le_normalizer_iff_commutator_le_left.mpr hcomm.ge
  let := h.module_elementary
  have hWcore : W ≤ L.pCoreIn 2 :=
    le_pCoreIn_of_normalizes (IsElementaryAbelian.isPGroup 2 W) hWL hLW
  rw [hcomm]
  have hb : (ChapterC.blockU L).map L.subtype = ⁅L.pCoreIn 2,L⁆ := by
    rw [ChapterC.blockU, map_commutator, ← MonoidHom.range_eq_map, range_subtype]
    rfl
  rw [hb]
  exact commutator_mono hWcore le_rfl

end CFSG.Quasithin.Chapter4.Section03.A5

namespace CFSG.Quasithin.Chapter13.Section05.A5Source.Context
open Chapter4
variable {G : Type*} [Group G] [Finite G]
  {T : Sylow 2 G} {L V V₁ V₂ V₃ : Subgroup G}
  (d : Context T L V V₁ V₂ V₃)
include d

/-- The original block layer is exactly the full module of the selected source configuration. -/
theorem source_C28_module_of_blockU
    (hV : (ChapterC.blockU L).map L.subtype = V)
    (hnot : ¬ UniqueMaximalOvergroup L (normalizer (L : Set G))) :
    ∃ J H : Subgroup G,
      J ∈ muStar (normalizer (L : Set G)) L
        (coveringOvergroup (normalizer (L : Set G)) L L) ∧
      L ≤ J ∧ IsMaximalTwoLocal H ∧ J ≤ H ∧
      ¬ H ≤ normalizer (L : Set G) ∧ H ⊓ normalizer (L : Set G) < H ∧
      ChapterC.HypothesisC28 KnownSimple.IsKnownSimple H (H ⊓ normalizer (L : Set G))
        L (J.pCoreIn 2) V := by
  obtain ⟨J,H,S,hJ,hLJ,hH,hJH,hout,hlt,hRS,hC,c,hQ,hVW⟩ :=
    d.source_C28_of_not_unique hnot
  have hc : (c : G) ∈ normalizer (L : Set G) := c.property.1
  have hNV : normalizer (L : Set G) ≤ normalizer (V : Set G) := by
    rw [← hV]
    exact normalizer_le_normalizer_characteristic_image L (ChapterC.blockU L)
  have hVconj : V.map (MulAut.conj (c : G)).toMonoidHom = V :=
    mem_normalizer_iff_map_conj_eq.mp (hNV hc)
  rw [hVconj] at hVW
  have hWV := Chapter4.Section03.A5.module_le_blockU hC inf_le_right
  rw [hV] at hWV
  have he := le_antisymm hWV hVW
  rw [he] at hC
  exact ⟨J,H,hJ,hLJ,hH,hJH,hout,hlt,hC⟩
end CFSG.Quasithin.Chapter13.Section05.A5Source.Context
