module
public import CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness.NonblockEndgameRootFrattini
public import Theory.GroupTheory.PCoreFrattiniDisplacement
/-!
# The special component core covers the original radical modulo Q

The original point-local transvections generate U through commutators, so
U lies in K₂. Since U=Z₂(R₂), its action on P=O₂(K_Z) has displacement in
Z_S=Φ(P). Burnside's exact Frattini action kernel and characteristic two
therefore put U inside P. If P were contained in Q, U would lie in Z(P)=Z_S,
contradicting their orders 64 and four.

The original radical quotient R₂/Q is the natural SL₂(4) module. The nonzero
image of P is invariant under that literal action, hence is the full quotient.
Thus PQ=R₂ and |P:P∩Q|=16. Coprime action then makes C_P(X) nontrivial for
the original cubic; irreducibility of the fixed-radical action identifies it
with all of C_R₂(X), of order sixteen.

These conclusions retain the original core, intersections and quotient maps.
They do not identify P with R₂ or prove strict enlargement of K₂ by P.
Construction of MSData and SecondarySourceData, that strict enlargement,
the remaining terminal exclusion and discharge of the independent nonbinary
input remain with qt-d-1222-rankone-uniqueness-nonblock.
Source: Aschbacher--Smith, C.1.34(3), pp.136--137, and original 4.3.2,
printed pp.617--619; Burnside's basis theorem and the natural SL₂ action.
-/

public section
open Subgroup Theory.GroupTheory
open scoped commutatorElement MatrixGroups
namespace CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness.Nonblock
open Matrix.PSL3.LinearThree Matrix.SpecialLinearGroup
open Chapter1.RadicalExclusions.ModelReduction.FullSieve.SourceInterface
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  {c : SourceConfiguration T L} {n : ℕ} {d : MSData c n}
namespace RootCoordinates
variable (m : RootCoordinates d)
include m

/-- The original natural center is generated by secondary commutators. -/
theorem center_le_secondary (hn : 1 < n) : U c ≤ secondary c := by
  have hUN : U c ≤ normalizer (secondary c : Set G) := by
    apply le_trans _ original_root_normalizer_normalizes_secondary
    apply le_inf
    · exact (map_subtype_le _).trans ((core_le_sylow c).trans inf_le_right)
    · exact ((le_centralizer (U c)).trans (centralizer_le d.root_le_center)).trans
        (Subgroup.centralizer_le_normalizer _)
  have hmoved : ⁅secondary c,U c⁆ ≤ secondary c :=
    le_normalizer_iff_commutator_le_left.mp hUN
  have haxis (i : Fin 3) (a : d.field.Carrier) :
      (m.coordinates.symm (Multiplicative.ofAdd (Pi.single i a)) : G) ∈ secondary c := by
    obtain ⟨j,hij,hj⟩ : ∃ j : Fin 3, i ≠ j ∧ j ≠ 0 := by
      fin_cases i
      · exact ⟨1,by decide,by decide⟩
      · exact ⟨2,by decide,by decide⟩
      · exact ⟨1,by decide,by decide⟩
    let g := transvection hij a
    have hg : g ∈ pointLocalSL d.field.Carrier := by
      rw [mem_pointLocalSL_iff]
      simp [g,transvection_coe,hj]
    obtain ⟨k,hk⟩ := m.secondaryProjection_surjective hn ⟨g,hg⟩
    let u := m.coordinates.symm (Multiplicative.ofAdd (Pi.single j 1))
    let u' := (U c).normalizerMonoidHom
      ⟨k,d.natural.2.1 (secondary_le_original k.property)⟩ u
    have hu' : (u' : G) = (k : G) * (u : G) * (k : G)⁻¹ :=
      normalizerMonoidHom_apply_apply_coe _ _ _
    have he := m.compatible ⟨k,secondary_le_original k.property⟩ u u' hu'
    have hkg := congrArg Subtype.val hk
    rw [m.secondaryProjection_apply] at hkg
    rw [hkg] at he
    have hc : (m.coordinates (u' * u⁻¹)).toAdd = Pi.single i a := by
      rw [map_mul,map_inv,toAdd_mul,toAdd_inv,he]
      simp only [u,m.coordinates.apply_symm_apply,toAdd_ofAdd]
      rw [←sub_eq_add_neg]
      change Representation.specialLinearNatural 3 g (Pi.single j 1) - Pi.single j 1 = _
      rw [Representation.OneCohomology.SLHigherNatural.action_transvection,add_sub_cancel_left]
      simp
    have hz : m.coordinates.symm (Multiplicative.ofAdd (Pi.single i a)) = u' * u⁻¹ := by
      apply m.coordinates.injective
      apply Multiplicative.toAdd.injective
      exact (m.coordinates.apply_symm_apply _ |> congrArg Multiplicative.toAdd).trans hc.symm
    rw [hz,Subgroup.coe_mul,Subgroup.coe_inv,hu']
    exact hmoved (commutator_mem_commutator k.property u.property)
  intro u hu
  let v := (m.coordinates ⟨u,hu⟩).toAdd
  have hv : v = Pi.single 0 (v 0) + Pi.single 1 (v 1) + Pi.single 2 (v 2) := by
    ext i
    fin_cases i <;> simp
  have hh := (secondary c).mul_mem ((secondary c).mul_mem (haxis 0 (v 0))
    (haxis 1 (v 1))) (haxis 2 (v 2))
  have he : (m.coordinates.symm (Multiplicative.ofAdd v) : G) = u := by
    exact congrArg Subtype.val (m.coordinates.symm_apply_apply ⟨u,hu⟩)
  rw [←he,hv,ofAdd_add,ofAdd_add,map_mul,map_mul,Subgroup.coe_mul,Subgroup.coe_mul]
  exact hh

/-- A secondary-invariant subgroup of R₂ is contained in Q or covers R₂/Q. -/
theorem radical_invariant_sup_core (hn : 1 < n)
    (D : Chapter12.Section02.ChosenModule T L V) (s : SecondarySourceData c n)
    (A : Subgroup G) (hA : A ≤ R₂ c)
    (hN : secondary c ≤ normalizer (A : Set G)) :
    A ≤ Q c ∨ Q c ⊔ A = R₂ c := by
  let f := m.radicalCoordinates hn D s
  let B := A.subgroupOf (R₂ c)
  let E := B.map f
  have hinv : ∀ g v, v ∈ E → Matrix.SL2.naturalAction d.field.Carrier g v ∈ E := by
    intro g v hv
    obtain ⟨k,rfl⟩ := m.secondaryLinear_surjective hn g
    obtain ⟨a,ha,rfl⟩ := hv
    let b : R₂ c := ⟨(k : G)*(a : G)*(k : G)⁻¹,
      hA ((mem_normalizer_iff.mp (hN k.property) (a : G)).mp ha)⟩
    refine ⟨b,(mem_normalizer_iff.mp (hN k.property) (a : G)).mp ha,?_⟩
    exact m.radicalCoordinates_conjugate hn D s k a b rfl
  rcases Matrix.SL2.naturalAction_irreducible d.field.Carrier E hinv with hb | ht
  · left
    intro a ha
    have hh : f (⟨a,hA ha⟩ : R₂ c) = 1 := mem_bot.mp (hb.le (mem_map_of_mem f ha))
    exact (m.radicalCoordinates_ker hn D s).le hh
  · right
    have he := congrArg (comap f) ht
    rw [comap_map_eq,comap_top,m.radicalCoordinates_ker hn D s] at he
    have hh := congrArg (map (R₂ c).subtype) he
    rw [Subgroup.map_sup,map_subgroupOf_eq_of_le hA,
      map_subgroupOf_eq_of_le (core_le_radical c),←MonoidHom.range_eq_map,range_subtype] at hh
    exact (sup_comm _ _).trans hh
end RootCoordinates

namespace RootCoordinates
variable {d : MSData c 2} (m : RootCoordinates d)
  (s : SecondarySourceData c 2) (D : Chapter12.Section02.ChosenModule T L V)
  (h : Chapter12.Section02.Hypothesis1223 KnownSimple.IsKnownSimple T L)
  (e : (s.component ⧸ pCore 2 s.component) ≃* Matrix.PSL3Four.PSL)
include m s D h e

/-- Frattini detection puts the original natural center in the component core. -/
theorem center_le_component_core :
    U c ≤ (s.component.map (rootNormalizer c).subtype).pCoreIn 2 := by
  let M := s.component.map (rootNormalizer c).subtype
  have hU : U c ≤ M := (m.center_le_secondary (by decide)).trans s.secondary_le
  obtain ⟨_,hF,_,_⟩ := d.linearFour_special_root m s D h e
  apply le_pCoreIn_of_frattini_displacement M (U c) hU
    (SourceEndgame.unitaryFive_component_core_selfCentralizing s D h)
  rw [hF]
  exact (commutator_mono le_rfl (s.component_core_le D)).trans
    (m.center_radical_commutator_le_root (by decide) D)

/-- The component core cannot lie in Q: its center is too small to contain U. -/
theorem component_core_not_le_original_core :
    ¬ (s.component.map (rootNormalizer c).subtype).pCoreIn 2 ≤ Q c := by
  intro hPQ
  let P := (s.component.map (rootNormalizer c).subtype).pCoreIn 2
  have hUP : U c ≤ P := m.center_le_component_core s D h e
  have hUZ : U c ≤ (center P).map P.subtype := by
    intro u hu
    refine ⟨⟨u,hUP hu⟩,?_,rfl⟩
    apply Subgroup.mem_center_iff.mpr
    intro p
    apply Subtype.ext
    obtain ⟨z,hz,rfl⟩ := hu
    exact congrArg (fun x : Q c => (x : G)) (Subgroup.mem_center_iff.mp hz ⟨p,hPQ p.property⟩)
  obtain ⟨_,_,hZ,_⟩ := d.linearFour_special_root m s D h e
  have hb := Nat.card_le_card_of_injective (inclusion (hUZ.trans hZ.le))
    (inclusion_injective (hUZ.trans hZ.le))
  have hUcard : Nat.card (U c) = 64 := by
    rw [card_map_of_injective (Q c).subtype_injective,d.center_card]
    norm_num
  have hRcard : Nat.card (root c) ≤ 4 := by
    simpa only [d.field.card_eq,d.degree_eq,Nat.reducePow] using m.root_card_le
  omega

/-- The component core surjects onto the original natural radical quotient. -/
theorem component_core_sup_original_core :
    Q c ⊔ (s.component.map (rootNormalizer c).subtype).pCoreIn 2 = R₂ c := by
  have hN : secondary c ≤ normalizer
      ((s.component.map (rootNormalizer c).subtype).pCoreIn 2 : Set G) :=
    s.secondary_le.trans ((s.component.map (rootNormalizer c).subtype).le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image _ (pCore 2 _)))
  exact (m.radical_invariant_sup_core (by decide) D s _ (s.component_core_le D) hN).resolve_left
    (m.component_core_not_le_original_core s D h e)
/-- The exact original quotient deficit, now on the component core itself. -/
theorem component_core_intersection_index :
    let P := (s.component.map (rootNormalizer c).subtype).pCoreIn 2
    (Q c ⊓ P).relIndex P = 16 := by
  let P := (s.component.map (rootNormalizer c).subtype).pCoreIn 2
  have hPR : P ≤ R₂ c := s.component_core_le D
  have hQR : Q c ≤ R₂ c := core_le_radical c
  have hN : R₂ c ≤ normalizer (Q c : Set G) :=
    ((radical_le_sylow c).trans inf_le_right).trans (core_normalized c)
  let : ((Q c).subgroupOf (R₂ c)).Normal := normal_subgroupOf_of_le_normalizer hN
  have hi := relIndex_sup_left (P.subgroupOf (R₂ c)) ((Q c).subgroupOf (R₂ c))
  rw [←subgroupOf_sup hQR hPR,m.component_core_sup_original_core s D h e,
    relIndex_subgroupOf le_rfl,relIndex_subgroupOf hPR,
    m.radical_relIndex_core (by decide) D s] at hi
  exact (inf_relIndex_right (Q c) P).trans hi.symm
/-- The entire original cubic-fixed radical already lies in the component core. -/
theorem component_core_cubic_fixed
    (X : Subgroup G) (hX : Nat.card X = 3) (hXK : X ≤ (K c).coreCenterIn 2)
    (hXr : X ≤ rootNormalizer c) (hfix : Q c ⊓ Subgroup.centralizer (X : Set G) = ⊥)
    (hcomm : ⁅secondary c,X⁆ ≤ (secondary c).pCoreIn 2) :
    let P := (s.component.map (rootNormalizer c).subtype).pCoreIn 2
    P ⊓ Subgroup.centralizer (X : Set G) = R₂ c ⊓ Subgroup.centralizer (X : Set G) := by
  let M := s.component.map (rootNormalizer c).subtype
  let P := M.pCoreIn 2
  have hNP : rootNormalizer c ≤ normalizer (P : Set G) :=
    s.component_normalized.trans (normalizer_le_normalizer_characteristic_image M (pCore 2 M))
  have hN : secondary c ⊓ Subgroup.centralizer (X : Set G) ≤ normalizer (P : Set G) :=
    (inf_le_left.trans (s.secondary_le.trans (map_subtype_le _))).trans hNP
  apply (m.invariant_cubic_fixed_subgroup s D X hX hXK hfix hcomm P
    (s.component_core_le D) hN).resolve_left
  intro hb
  have hp : IsPGroup 2 P := isPGroup_pCoreIn 2 M
  let : Group.IsNilpotent P := hp.isNilpotent
  have hcop : Nat.Coprime (Nat.card X) (Nat.card P) := by
    obtain ⟨j,hj⟩ := hp.exists_card_eq
    rw [hX,hj]
    exact (by decide : Nat.Coprime 3 2).pow_right j
  have hd := eq_commutator_sup_centralizer_of_solvable_coprime P X (hXr.trans hNP)
    inferInstance hcop
  rw [hb,sup_bot_eq] at hd
  apply m.component_core_not_le_original_core s D h e
  change P ≤ Q c
  rw [hd]
  exact (commutator_mono (s.component_core_le D) le_rfl).trans_eq
    (m.radical_cubic_commutator D s X hXK
      (d.cubic_core_moved X hX (hXK.trans (coreCenterIn_le 2 _)) hfix))
end RootCoordinates

/-- The special component core contains the original natural center, escapes
Q, and covers the entire original radical modulo Q. This retains MSData and
SecondarySourceData as inputs to the nonblock source assembly. -/
theorem MSData.linearFour_component_core_coverage (d : MSData c 2)
    (m : RootCoordinates d) (s : SecondarySourceData c 2)
    (D : Chapter12.Section02.ChosenModule T L V)
    (h : Chapter12.Section02.Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (e : (s.component ⧸ pCore 2 s.component) ≃* Matrix.PSL3Four.PSL) :
    let P := (s.component.map (rootNormalizer c).subtype).pCoreIn 2
    U c ≤ P ∧ ¬ P ≤ Q c ∧ Q c ⊔ P = R₂ c ∧ (Q c ⊓ P).relIndex P = 16 :=
  ⟨m.center_le_component_core s D h e,m.component_core_not_le_original_core s D h e,
    m.component_core_sup_original_core s D h e,m.component_core_intersection_index s D h e⟩
/-- The source cubic realizes all sixteen fixed radical elements inside
O₂(K_Z), with the original root and original cubic retained. -/
theorem MSData.linearFour_component_core_fixed_radical (d : MSData c 2)
    (m : RootCoordinates d) (s : SecondarySourceData c 2)
    (D : Chapter12.Section02.ChosenModule T L V)
    (h : Chapter12.Section02.Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (e : (s.component ⧸ pCore 2 s.component) ≃* Matrix.PSL3Four.PSL) :
    let P := (s.component.map (rootNormalizer c).subtype).pCoreIn 2
    ∃ X : Subgroup G, Nat.card X = 3 ∧ X ≤ (K c).coreCenterIn 2 ∧
      X ≤ rootNormalizer c ∧ Q c ⊓ Subgroup.centralizer (X : Set G) = ⊥ ∧
      P ⊓ Subgroup.centralizer (X : Set G) = R₂ c ⊓ Subgroup.centralizer (X : Set G) ∧
      Nat.card (P ⊓ Subgroup.centralizer (X : Set G) : Subgroup G) = 16 := by
  obtain ⟨X,hX,hXK,hr,hfix,_,_,_,hcomm,_,_⟩ := d.exists_source_cubic_root D
  have he := m.component_core_cubic_fixed s D h e X hX hXK hr hfix hcomm
  refine ⟨X,hX,hXK,hr,hfix,he,?_⟩
  rw [he]
  exact m.radical_cubic_fixed_card D s X hX hXK hfix
end CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness.Nonblock
