module
public import CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness.NonblockEndgameSieveActions
public import Theory.GroupTheory.Commutator.SimpleSubnormal

/-!
# Literal image groups in the nonblock automorphism sieve

The secondary group and radical are mapped by the specified conjugation action
on the full component quotient. Normalization and the radical commutator identity
survive these maps. Perfectness supplies a precise sufficient condition for the
source's centralization step: the image of O₂(K₂) must centralize the image of K₂.
That condition is a separate local-model obligation, not a consequence asserted
from centralization modulo O₂(K₂).

Source: Aschbacher–Smith, original 4.3.14–16 and the following elimination,
printed p.618.
-/

@[expose] public section
noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness.Nonblock.EndgameSieve
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
variable {c : SourceConfiguration T L} {n : ℕ}

/-- The literal K₂-star inside the automorphisms of the full quotient. -/
def SecondaryData.secondaryImage (s : SecondaryData c n) :
    Subgroup (MulAut (s.component ⧸ pCore 2 s.component)) :=
  ((secondary c).subgroupOf (rootNormalizer c)).map s.action

/-- The literal R₂-star for the source two-local normalizer. -/
def SecondaryData.radicalImage (s : SecondaryData c n) :
    Subgroup (MulAut (s.component ⧸ pCore 2 s.component)) :=
  ((R₂ c).subgroupOf (rootNormalizer c)).map s.action

/-- The image of the original O₂(K₂), before identifying an image two-core. -/
def SecondaryData.secondaryCoreImage (s : SecondaryData c n) :
    Subgroup (MulAut (s.component ⧸ pCore 2 s.component)) :=
  (((secondary c).pCoreIn 2).subgroupOf (rootNormalizer c)).map s.action

/-- The original component's image, using the same action as R₂-star. -/
def SecondaryData.componentImage (s : SecondaryData c n) :
    Subgroup (MulAut (s.component ⧸ pCore 2 s.component)) :=
  s.component.map s.action

/-- The actual action image of the group generated by K_Z, R₂ and Y. -/
def SecondaryData.ambientImage (s : SecondaryData c n) :
    Subgroup (MulAut (s.component ⧸ pCore 2 s.component)) :=
  (SecondaryData.componentImage s) ⊔ (SecondaryData.radicalImage s) ⊔ (SecondaryData.torusImage s)

/-- The literal group G₀ = K_Z R₂ Y, inside the root normalizer. -/
def SecondaryData.localGroup (s : SecondaryData c n) : Subgroup (rootNormalizer c) :=
  s.component ⊔ (R₂ c).subgroupOf (rootNormalizer c) ⊔
    s.torus.subgroupOf (rootNormalizer c)

omit [Finite G] in
/-- G₀-star is obtained by the specified action, with no new quotient marking. -/
theorem SecondaryData.localGroup_image (s : SecondaryData c n) :
    (SecondaryData.localGroup s).map s.action = (SecondaryData.ambientImage s) := by
  change (s.component ⊔ (R₂ c).subgroupOf (rootNormalizer c) ⊔
    s.torus.subgroupOf (rootNormalizer c)).map s.action = _
  rw [Subgroup.map_sup, Subgroup.map_sup]
  rfl

omit [Finite G] in
/-- K_Z-star is exactly the inner group of its full quotient. -/
theorem SecondaryData.componentImage_eq_inner (s : SecondaryData c n) :
    (SecondaryData.componentImage s) = MulAut.innerSubgroup (s.component ⧸ pCore 2 s.component) := by
  let := s.normal
  ext a
  constructor
  · rintro ⟨x, hx, rfl⟩
    exact ⟨QuotientGroup.mk' (pCore 2 s.component) ⟨x, hx⟩,
      (normalQuotientAction_inner s.component (pCore 2 s.component) ⟨x, hx⟩).symm⟩
  · rintro ⟨q, rfl⟩
    obtain ⟨x, rfl⟩ := QuotientGroup.mk'_surjective (pCore 2 s.component) q
    exact ⟨x, x.property,
      normalQuotientAction_inner s.component (pCore 2 s.component) x⟩

omit [Finite G] in
private theorem subgroupOf_normalizes {A B H : Subgroup G}
    (h : A ≤ normalizer (B : Set G)) :
    A.subgroupOf H ≤ normalizer (B.subgroupOf H : Set H) := by
  intro a ha
  apply mem_normalizer_iff.mpr
  intro b
  exact mem_normalizer_iff.mp (h ha) b.val

omit [Finite G] in
/-- K₂ normalizes R₂ since R₂ is the two-core of K₂S. -/
theorem secondary_normalizes_radical (c : SourceConfiguration T L) :
    secondary c ≤ normalizer (R₂ c : Set G) :=
  (le_sup_left : secondary c ≤ secondary c ⊔ S c).trans
    ((secondary c ⊔ S c).le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image (secondary c ⊔ S c)
        (pCore 2 (secondary c ⊔ S c : Subgroup G))))

omit [Finite G] in
/-- The radical normalizer clause controls the original R₂, before quotienting. -/
theorem SecondaryData.radical_normalizes_secondary (s : SecondaryData c n) :
    R₂ c ≤ normalizer (secondary c : Set G) :=
  (R₂ c).le_normalizer.trans (s.radical_normalizer.trans inf_le_right)

omit [Finite G] in
/-- The two original normalizing actions pass to their literal images. -/
theorem SecondaryData.image_normalization (s : SecondaryData c n) :
    (SecondaryData.secondaryImage s) ≤ normalizer ((SecondaryData.radicalImage s) : Set _) ∧
      (SecondaryData.radicalImage s) ≤ normalizer ((SecondaryData.secondaryImage s) : Set _) ∧
      (SecondaryData.torusImage s) ≤ normalizer ((SecondaryData.radicalImage s) : Set _) ∧
      (SecondaryData.torusImage s) ≤ normalizer ((SecondaryData.secondaryImage s) : Set _) := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact (map_mono (subgroupOf_normalizes (secondary_normalizes_radical c))).trans
      (((R₂ c).subgroupOf (rootNormalizer c)).le_normalizer_map s.action)
  · exact (map_mono (subgroupOf_normalizes (SecondaryData.radical_normalizes_secondary s))).trans
      (((secondary c).subgroupOf (rootNormalizer c)).le_normalizer_map s.action)
  · exact (map_mono (subgroupOf_normalizes s.torus_normalizes_radical)).trans
      (((R₂ c).subgroupOf (rootNormalizer c)).le_normalizer_map s.action)
  · exact (map_mono (subgroupOf_normalizes (SecondaryData.torus_normalizes_secondary s))).trans
      (((secondary c).subgroupOf (rootNormalizer c)).le_normalizer_map s.action)

/-- The image of the solvable residual is still perfect. -/
theorem SecondaryData.secondaryImage_perfect (s : SecondaryData c n) :
    Group.IsPerfect (SecondaryData.secondaryImage s) := by
  let := secondary_perfect c
  let e := subgroupOfEquivOfLe (s.secondary_le.trans (map_subtype_le _))
  let : Group.IsPerfect ((secondary c).subgroupOf (rootNormalizer c)) :=
    Group.IsPerfect.ofSurjective (f := e.symm.toMonoidHom) e.symm.surjective
  exact Group.IsPerfect.map s.action

omit [Finite G] in
/-- The original radical gives a nontrivial two-subgroup of automorphisms. -/
theorem SecondaryData.radicalImage_two (s : SecondaryData c n) :
    IsPGroup 2 (SecondaryData.radicalImage s) ∧ (SecondaryData.radicalImage s) ≠ ⊥ := by
  exact ⟨((isPGroup_pCoreIn 2 (secondary c ⊔ S c)).comap_subtype).map s.action,
    s.radical_action⟩

omit [Finite G] in
/-- The full radical movement identity remains true in the action image. -/
theorem SecondaryData.radicalImage_moved (s : SecondaryData c n) :
    ⁅(SecondaryData.radicalImage s), (SecondaryData.torusImage s)⁆ = (SecondaryData.radicalImage s) := by
  change ⁅((R₂ c).subgroupOf (rootNormalizer c)).map s.action,
    (s.torus.subgroupOf (rootNormalizer c)).map s.action⁆ = _
  rw [← map_commutator, s.radical_restricted_moved]
  rfl

/-- The precise centrality premise needed to lift the source's torus action. -/
def SecondaryData.CoreImageCentral (s : SecondaryData c n) : Prop :=
  (SecondaryData.secondaryCoreImage s) ≤ centralizer ((SecondaryData.secondaryImage s) : Set _)

/-- Perfectness lifts centralization once the original core image is central.
No centrality of that image is inferred from the quotient action alone. -/
theorem SecondaryData.torusImage_centralizes_of_coreImageCentral
    (s : SecondaryData c n) (hc : (SecondaryData.CoreImageCentral s)) :
    (SecondaryData.torusImage s) ≤ centralizer ((SecondaryData.secondaryImage s) : Set _) := by
  let := (SecondaryData.secondaryImage_perfect s)
  apply commutator_eq_bot_iff_le_centralizer.mp
  apply commutator_eq_bot_of_iterated_eq_bot
  apply commutator_eq_bot_iff_le_centralizer.mpr
  rw [commutator_comm]
  exact (SecondaryData.secondary_action_commutator s).trans hc

/-- A model-centralizer exclusion kills the actual torus image by Cauchy.
The prime divides the original torus order; no prime-order preimage is assumed. -/
theorem SecondaryData.torusImage_eq_bot_of_prime_centralizer
    (s : SecondaryData c n) (hn : 0 < n)
    (hc : (SecondaryData.CoreImageCentral s))
    (hexclude : ∀ p : ℕ, p.Prime → Odd p → p ∣ 2 ^ n - 1 →
      ∀ a ∈ (SecondaryData.torusImage s), a ∈ centralizer ((SecondaryData.secondaryImage s) : Set _) →
        orderOf a ≠ p) : (SecondaryData.torusImage s) = ⊥ := by
  by_contra hne
  have hcard : Nat.card (SecondaryData.torusImage s) ≠ 1 := fun he =>
    hne ((SecondaryData.torusImage s).eq_bot_of_card_eq he)
  obtain ⟨p, hp, hpd⟩ := Nat.exists_prime_and_dvd hcard
  have hd := hpd.trans (SecondaryData.torusImage_card_dvd s)
  have ho : Odd (2 ^ n - 1) := by
    rw [Nat.odd_iff]
    have h2 := Nat.mod_eq_zero_of_dvd (dvd_pow_self 2 (Nat.ne_of_gt hn))
    have hpos : 0 < (2 : ℕ) ^ n := pow_pos (by decide) _
    omega
  let : Fact p.Prime := ⟨hp⟩
  obtain ⟨a, ha⟩ := exists_prime_orderOf_dvd_card' (G := (SecondaryData.torusImage s)) p hpd
  apply hexclude p hp (ho.of_dvd_nat hd) hd a a.property
    ((SecondaryData.torusImage_centralizes_of_coreImageCentral s) hc a.property)
  simpa only [Subgroup.orderOf_coe] using ha

end CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness.Nonblock.EndgameSieve
end
