module
public import CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness.OrdinaryRootFF.BestOffender
public import CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness.OrdinaryRootFF.OddRankRestrictions
public import CFSG.Quasithin.ChapterB.Section05.Quasisimple.SourceCompletion.FFQuasisimple

/-!
# Full source classification on the actual secondary image

Restrict the original centralizer-quotient map to K_Z. Reducedness kills its
two-core, and nontriviality of the marked point-local image makes the resulting
image quasisimple. Normality gives its trivial two-core. The proved A.2.1
semisimple-section theorem supplies SQTK on this very image. Its faithful FF
action is generated by best offenders: a proper normal offender subgroup
would be central and would contain a nontrivial normal elementary two-group.

These facts discharge every hypothesis of the complete B.5.1 producer,
including its earlier A.2, A.3, B.4.2 and G2 inputs. The conclusion retains
all action equivalences and the original module U. The exceptional-case
exclusion and comparison with the embedded point local are subsequent steps.

Source: Aschbacher–Smith 4.3.6, p.615; B.5.1, pp.99–103; A.2.1, p.32.
-/

@[expose] public noncomputable section
open Subgroup Theory.GroupTheory Representation.BinaryOffender
open scoped IsMulCommutative
namespace CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness.OrdinaryRootFF
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L : Subgroup G}
  {c : SourceConfiguration T L} {n : ℕ} (m : OrdinarySymplecticMarking c n)

/-- Restriction of the original quotient map, with its actual image as codomain. -/
def secondaryProjection (KZ : Subgroup G) (hKN : KZ ≤ m.rootNormalizer) :
    KZ →* image m KZ :=
  ((projection m).subgroupMap (KZ.subgroupOf m.rootNormalizer)).comp
    (subgroupOfEquivOfLe hKN).symm.toMonoidHom

omit [Finite G] in
theorem secondaryProjection_surjective (KZ : Subgroup G) (hKN : KZ ≤ m.rootNormalizer) :
    Function.Surjective (secondaryProjection m KZ hKN) :=
  ((projection m).subgroupMap_surjective _).comp (subgroupOfEquivOfLe hKN).symm.surjective

omit [Finite G] in
theorem secondaryCore_le_projection_kernel
    (hr : IsPReduced 2 (moduleSubgroup m)) (KZ : Subgroup G)
    (hKN : KZ ≤ m.rootNormalizer)
    (hnormal : m.rootNormalizer ≤ normalizer (KZ : Set G)) :
    pCore 2 KZ ≤ (secondaryProjection m KZ hKN).ker := by
  intro k hk
  apply Subtype.ext
  apply core_le_kernel m hr
  have hm := secondaryCore_le_rootCore m hKN hnormal (mem_map_of_mem KZ.subtype hk)
  change (k : G) ∈ (pCore 2 m.rootNormalizer).map m.rootNormalizer.subtype at hm
  obtain ⟨z, hz, hez⟩ := hm
  exact (Subtype.ext hez : z = ((subgroupOfEquivOfLe hKN).symm k).val) ▸ hz

omit [Finite G] in
theorem secondary_image_ne_bot (hn : 1 < n)
    (hUN : m.rootSpan ≤ m.rootNormalizer) (hcore : m.second.pCoreIn 2 ≤ m.rootSpan)
    (KZ : Subgroup G) (hJK : m.second ≤ KZ) : image m KZ ≠ ⊥ := by
  intro he
  exact second_image_ne_bot m hn hUN hcore
    (bot_unique ((image_mono m hJK).trans_eq he))

omit [Finite G] in
theorem secondary_image_normal (KZ : Subgroup G)
    (hnormal : m.rootNormalizer ≤ normalizer (KZ : Set G)) :
    (image m KZ).Normal := by
  let : (KZ.subgroupOf m.rootNormalizer).Normal :=
    normal_subgroupOf_of_le_normalizer hnormal
  exact Normal.map inferInstance (projection m) (QuotientGroup.mk'_surjective _)

omit [Finite G] in
theorem secondary_image_quasisimple (hn : 1 < n)
    (hr : IsPReduced 2 (moduleSubgroup m))
    (hUN : m.rootSpan ≤ m.rootNormalizer) (hcore : m.second.pCoreIn 2 ≤ m.rootSpan)
    (KZ : Subgroup G) (hKN : KZ ≤ m.rootNormalizer) (hJK : m.second ≤ KZ)
    (hquasi : IsQuasisimple (KZ ⧸ pCore 2 KZ))
    (hnormal : m.rootNormalizer ≤ normalizer (KZ : Set G)) :
    IsQuasisimple (image m KZ) := by
  let := hquasi
  let : Nontrivial (image m KZ) := (nontrivial_iff_ne_bot _).mpr
    (secondary_image_ne_bot m hn hUN hcore KZ hJK)
  exact IsQuasisimple.of_surjective
    (QuotientGroup.lift (pCore 2 KZ) (secondaryProjection m KZ hKN)
      (secondaryCore_le_projection_kernel m hr KZ hKN hnormal))
    (QuotientGroup.lift_surjective_of_surjective _ _
      (secondaryProjection_surjective m KZ hKN) _)

theorem secondary_image_pCore_eq_bot
    (hr : IsPReduced 2 (moduleSubgroup m)) (KZ : Subgroup G)
    (hnormal : m.rootNormalizer ≤ normalizer (KZ : Set G)) :
    pCore 2 (image m KZ) = ⊥ := by
  let := secondary_image_normal m KZ hnormal
  rw [pCore_subnormal_eq_comap 2 (inferInstance : (image m KZ).Normal).isSubnormal,
    actor_pCore_eq_bot m hr]
  exact (MonoidHom.ker_eq_bot_iff (image m KZ).subtype).mpr (image m KZ).subtype_injective

theorem secondary_image_sqtk (hn : 1 < n)
    (h : Chapter12.Section02.Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hr : IsPReduced 2 (moduleSubgroup m))
    (hUN : m.rootSpan ≤ m.rootNormalizer) (hcore : m.second.pCoreIn 2 ≤ m.rootSpan)
    (KZ : Subgroup G) (hKN : KZ ≤ m.rootNormalizer) (hJK : m.second ≤ KZ)
    (hquasi : IsQuasisimple (KZ ⧸ pCore 2 KZ))
    (hnormal : m.rootNormalizer ≤ normalizer (KZ : Set G)) :
    IsSQTK KnownSimple.IsKnownSimple (image m KZ) := by
  let := secondary_image_quasisimple m hn hr hUN hcore KZ hKN hJK hquasi hnormal
  have hs : IsSQTK KnownSimple.IsKnownSimple KZ :=
    (IsSQTK.equiv (subgroupOfEquivOfLe hKN)).mp
      ((h.simpleQTKE.twoLocal_sqtk (m.rootNormalizer_twoLocal hn)).subgroup
        (KZ.subgroupOf m.rootNormalizer))
  exact ChapterB.SourceInduction.HighThreeRank.CoverCentralizer.SourceConstruction.quasisimple_section_sqtk
    (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple) hs
    (ChapterA.Section02.IsSectionOf.of_surjective (secondaryProjection m KZ hKN)
      (secondaryProjection_surjective m KZ hKN))

/-- The noncubic Cartan rank bound passes through the same action projection,
using cyclic Sylow subgroups rather than assuming rank monotonicity for quotients. -/
theorem secondary_image_primeRank_le_one_of_ne_three (hn : 1 < n)
    (h : Chapter12.Section02.Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (KZ : Subgroup G) (hK : KZ ≤ centralizer (m.root : Set G))
    (hJK : m.second ≤ KZ)
    (hcomp : (KZ.subgroupOf (centralizer (m.root : Set G))).IsCComponent)
    (hquasi : IsQuasisimple (KZ ⧸ pCore 2 KZ))
    (hnormal : m.rootNormalizer ≤ normalizer (KZ : Set G))
    (p : ℕ) (hp : p.Prime) (ho : Odd p) (hd : p ∣ 2 ^ n - 1) (hp3 : p ≠ 3) :
    primeRank p (image m KZ) ≤ 1 := by
  let : Fact p.Prime := ⟨hp⟩
  let P : Sylow p KZ := Classical.choice inferInstance
  have hr := primeRank_le_one_of_ne_three m hn h KZ hK hJK hcomp hquasi hnormal
    p hp ho hd hp3
  have hKN := hK.trans (Subgroup.centralizer_le_normalizer _)
  exact P.primeRank_le_one_of_surjective (P.isCyclic_of_odd_of_primeRank_le_one ho hr)
    (secondaryProjection m KZ hKN) (secondaryProjection_surjective m KZ hKN)

private theorem quasisimple_offender_generated
    {H V : Type*} [Group H] [Finite H] [IsQuasisimple H]
    [AddCommGroup V] [Module (ZMod 2) V] [Module.Finite (ZMod 2) V]
    (ρ : Representation (ZMod 2) H V) (hcore : pCore 2 H = ⊥) (hff : IsFFModule ρ) :
    offenderSubgroup ρ = ⊤ := by
  let : (offenderSubgroup ρ).Normal := offenderSubgroup_normal ρ
  rcases IsQuasisimple.normal_le_center_or_eq_top (offenderSubgroup ρ) with hc | ht
  · obtain ⟨A,hA⟩ := (isFFModule_iff_exists_bestOffender ρ).mp hff
    have hAc := (hA.le_offenderSubgroup ρ).trans hc
    let : A.Normal := ⟨fun a ha g => by
      rw [mem_center_iff.mp (hAc ha) g, mul_inv_cancel_right]
      exact ha⟩
    let := hA.1.2
    have hle : A ≤ pCore 2 H := le_sSup ⟨inferInstance,IsElementaryAbelian.isPGroup 2 A⟩
    exact (hA.1.1 (bot_unique (hle.trans_eq hcore))).elim
  · exact ht

theorem secondary_source_classification (hn : 1 < n)
    (h : Chapter12.Section02.Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (hr : IsPReduced 2 (moduleSubgroup m))
    (hUN : m.rootSpan ≤ m.rootNormalizer) (hcore : m.second.pCoreIn 2 ≤ m.rootSpan)
    (hQ : m.rootCore = m.second.pCoreIn 2 ⊔
      (m.rootCore ⊓ centralizer (c.ordinaryModule : Set G)))
    (KZ : Subgroup G) (hKN : KZ ≤ m.rootNormalizer) (hJK : m.second ≤ KZ)
    (hquasi : IsQuasisimple (KZ ⧸ pCore 2 KZ))
    (hnormal : m.rootNormalizer ≤ normalizer (KZ : Set G)) :
    letI := hr.elementary
    Nonempty (ChapterB.SourceInduction.ProjectiveLine.QuasisimpleSourceConclusion
      ((representation m hr).comp (image m KZ).subtype) ⊤) := by
  let := hr.elementary
  let σ := (representation m hr).comp (image m KZ).subtype
  let := secondary_image_quasisimple m hn hr hUN hcore KZ hKN hJK hquasi hnormal
  let : IsQuasisimple (⊤ : Subgroup (image m KZ)) := IsQuasisimple.of_mulEquiv topEquiv.symm
  have hs := secondary_image_sqtk m hn h hr hUN hcore KZ hKN hJK hquasi hnormal
  have hpc := secondary_image_pCore_eq_bot m hr KZ hnormal
  have hB := fullModule_isBestOffender m hn hr hUN hcore hQ
  have hBK := image_mono m ((m.fullModule_le_second hn).trans hJK)
  have hff : IsFFModule σ := ⟨(image m c.ordinaryModule).subgroupOf (image m KZ),
    (hB.subgroupOf (representation m hr) hBK).isOffender _⟩
  have hh : ChapterB.QuasisimpleSource.QuasisimpleSourceHypothesis σ
      KnownSimple.IsKnownSimple ⊤ := by
    refine ⟨inferInstance,(representation_injective m hr).comp (image m KZ).subtype_injective,
      inferInstance,(IsSQTK.equiv topEquiv).mpr hs,?_,hpc,
      quasisimple_offender_generated σ hpc hff⟩
    rw [generalizedFitting_eq_top_of_quasisimple,top_sup_eq]
  exact ChapterB.QuasisimpleSource.SourceCompletion.knownSimple_quasisimpleClassificationInput
    (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
    (ChapterA.SQTKStructure.a36Input_of_theoremsAC
      (fun _ _ _ => ChapterA.Section02.theoremA_knownSimple)
      (fun _ _ _ => ChapterA.Section02.theoremC_knownSimple))
    ChapterB.SourceClassification.irreducibleClassification_knownSimple
    ChapterB.SourceInduction.nonbinaryG2RootPairInput
    (image m KZ) (Additive (moduleSubgroup m)) σ ⊤ hh

end CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness.OrdinaryRootFF
