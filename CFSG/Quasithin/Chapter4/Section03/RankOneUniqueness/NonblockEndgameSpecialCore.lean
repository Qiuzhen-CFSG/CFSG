module
public import CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness.NonblockEndgameCoreCoverage
public import Theory.Representation.SL3.PointRadicalDualDisplacement

/-!
# Excluding the special core in the original linear-four endgame

Put P=O₂(K_Z). The preceding source calculations give P'=Z_S and PQ=R₂.
Hence [R₂,P∩Q]≤U: P contributes only its central commutator, and Q'=U.
On each original dual summand of Q/U, the vectors fixed by the point radical
are generated by point-local displacements. Since U≤K₂, this puts P∩Q
inside K₂ through the original quotient map.

The cubic-fixed radical is the natural SL₂(4) module for C_K₂(X). Its
commutators with this actor generate it and lie in K₂, so C_R₂(X)≤K₂.
Coprime decomposition P=[P,X]C_P(X), with [P,X]≤P∩Q, now gives P≤K₂.
This contradicts the original strict core-enlargement clause of 4.3.14(3).
The argument retains every determinant twist and uses the actual component
core, not an elementary numerator substituted for its Frattini quotient.

NonblockEndgameSourceAssembly connects this exclusion to the completed
model sieve and unitary-five branch. MSData, simultaneous markings and
strict core enlargement still require construction by
qt-d-1222-rankone-uniqueness-nonblock; the independently owned nonbinary
classification retains its producer and final discharge.
Source: Aschbacher--Smith, C.1.34(3), pp.136--137, and original
4.3.14(3), 4.3.16 and conclusion of 4.3.2, pp.617--619.
-/

public section
open Subgroup Theory.GroupTheory
open scoped commutatorElement MatrixGroups
namespace CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness.Nonblock
open Matrix.PSL3.LinearThree Matrix.SpecialLinearGroup Representation.SL3ParabolicNatural
open Chapter1.RadicalExclusions.ModelReduction.FullSieve.SourceInterface
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}
  {c : SourceConfiguration T L} {n : ℕ} {d : MSData c n}
namespace RootCoordinates
variable (m : RootCoordinates d)
include m

/-- Original core elements fixed modulo U by the radical lie in the secondary residual. -/
theorem core_radical_displacement_le_secondary (hn : 1 < n)
    (D : Chapter12.Section02.ChosenModule T L V) (s : SecondarySourceData c n)
    (A : Subgroup G) (hAQ : A ≤ Q c) (hcomm : ⁅R₂ c,A⁆ ≤ U c) :
    A ≤ secondary c := by
  obtain ⟨p,hp,hk,he,_⟩ := d.exists_elementary_dual_lifts
  let B := (((secondary c ⊓ Q c).subgroupOf (Q c)).map p).toAddSubgroup'
  have hRN : R₂ c ≤ normalizer (secondary c : Set G) :=
    (R₂ c).le_normalizer.trans (s.radical_normalizer.trans inf_le_right)
  have hB (g : Matrix.SpecialLinearGroup (Fin 3) d.field.Carrier)
      (hg : g ∈ pointLocalSL d.field.Carrier) (v) :
      (((Representation.specialLinearNatural 3).dual.prod
        (Representation.specialLinearNatural 3).dual) g v - v) ∈ B := by
    obtain ⟨k,hkg⟩ := m.secondaryProjection_surjective hn ⟨g,hg⟩
    have hkg' := congrArg Subtype.val hkg
    rw [m.secondaryProjection_apply] at hkg'
    obtain ⟨q,hq⟩ := hp (Multiplicative.ofAdd v)
    let k' : K c := ⟨k,secondary_le_original k.property⟩
    let q' : Q c := ⟨(k:G)*(q:G)*(k:G)⁻¹,
      (mem_normalizer_iff.mp (d.doubleDual.2.1 k'.property) q).mp q.property⟩
    have hz : ((q' * q⁻¹ : Q c) : G) ∈ secondary c :=
      le_normalizer_iff_commutator_le_left.mp ((core_le_radical c).trans hRN)
        (commutator_mem_commutator k.property q.property)
    refine ⟨q' * q⁻¹,⟨hz,(q' * q⁻¹).property⟩,?_⟩
    change p (q' * q⁻¹) = Multiplicative.ofAdd _
    apply Multiplicative.toAdd.injective
    rw [map_mul,map_inv,toAdd_mul,toAdd_inv,he k' q q' rfl,hkg',hq]
    simp only [toAdd_ofAdd,sub_eq_add_neg]
  intro a ha
  let q : Q c := ⟨a,hAQ ha⟩
  have hv (g : pointRadicalSL d.field.Carrier) :
      (((Representation.specialLinearNatural 3).dual.prod
        (Representation.specialLinearNatural 3).dual) g.val.val (p q).toAdd) = (p q).toAdd := by
    obtain ⟨r,hr⟩ := m.radicalPoint_surjective hn D s g
    let k : K c := ⟨r,m.radical_le_original hn D s.core_eq r.property⟩
    let q' : Q c := ⟨(r:G)*a*(r:G)⁻¹,
      (mem_normalizer_iff.mp (d.doubleDual.2.1 k.property) a).mp (hAQ ha)⟩
    have hz : q' * q⁻¹ ∈ p.ker := by
      rw [hk]
      exact hcomm (commutator_mem_commutator r.property ha)
    have hpq : p q' = p q := by
      have hh : p (q' * q⁻¹) = 1 := hz
      rw [map_mul,map_inv] at hh
      exact mul_inv_eq_one.mp hh
    have hkg : linearThreeActor d.model k = g.val.val :=
      congrArg (fun z : pointRadicalSL d.field.Carrier => z.val.val) hr
    have hh := he k q q' rfl
    rw [hpq,hkg] at hh
    exact hh.symm
  have hqB := doubledDual_pointRadical_fixed_mem B hB (p q).toAdd hv
  obtain ⟨b,hb,hbq⟩ := hqB
  change p b = p q at hbq
  have hz : b⁻¹*q ∈ p.ker := by
    change p (b⁻¹*q) = 1
    rw [map_mul,map_inv,hbq,inv_mul_cancel]
  have hzK : ((b⁻¹*q : Q c) : G) ∈ secondary c :=
    m.center_le_secondary hn (by
      have hh : b⁻¹*q ∈ (U c).subgroupOf (Q c) := hk ▸ hz
      exact hh)
  have hh := (secondary c).mul_mem hb.1 hzK
  simpa only [Subgroup.coe_mul,Subgroup.coe_inv,Subgroup.subtype_apply,mul_inv_cancel_left] using hh
end RootCoordinates

namespace RootCoordinates
variable {d : MSData c 2} (m : RootCoordinates d)
  (s : SecondarySourceData c 2) (D : Chapter12.Section02.ChosenModule T L V)
  (X : Subgroup G) (hX : Nat.card X = 3) (hXK : X ≤ (K c).coreCenterIn 2)
  (hfix : Q c ⊓ centralizer (X : Set G) = ⊥)
  (hcomm : ⁅secondary c,X⁆ ≤ (secondary c).pCoreIn 2)
include m s D hX hXK hfix hcomm

/-- The original cubic-fixed complement lies in K₂ under its actual natural action. -/
theorem cubic_fixed_radical_le_secondary :
    R₂ c ⊓ centralizer (X : Set G) ≤ secondary c := by
  let F := R₂ c ⊓ centralizer (X : Set G)
  let A := F ⊓ secondary c
  have hN : secondary c ⊓ centralizer (X : Set G) ≤ normalizer (A : Set G) :=
    (le_inf (fixedSecondary_normalizes_fixedRadical X)
      (inf_le_left.trans (secondary c).le_normalizer)).trans inf_normalizer_le_normalizer_inf
  rcases m.fixedRadical_invariant_subgroup s D X hX hXK hfix hcomm A inf_le_left hN with hb | ht
  · let e := m.fixedRadicalCoordinates D s X hX hXK hfix
    let r := e.symm (Multiplicative.ofAdd (![0,1] : Fin 2 → d.field.Carrier))
    let g : Matrix.SpecialLinearGroup (Fin 2) d.field.Carrier :=
      ⟨!![1,1;0,1],by simp [Matrix.det_fin_two]⟩
    obtain ⟨k,hk⟩ := m.fixedSecondaryLinear_surjective X hX hcomm g
    let r' := fixedRadicalAction X k r
    have hz : ((r' * r⁻¹ : F) : G) ∈ A := by
      refine ⟨(r' * r⁻¹).property,?_⟩
      exact le_normalizer_iff_commutator_le_left.mp
        ((R₂ c).le_normalizer.trans (s.radical_normalizer.trans inf_le_right))
        (commutator_mem_commutator k.property.1 r.property.1)
    have hz1 : r' * r⁻¹ = 1 := Subtype.ext (mem_bot.mp (hb ▸ hz))
    have he := m.fixedRadical_action_natural D s X hX hXK hfix k r
    have hr' : r' = r := mul_inv_eq_one.mp hz1
    change e r' = Matrix.SL2.naturalAction d.field.Carrier (m.fixedSecondaryLinear X k) (e r) at he
    rw [hr',hk,show e r = Multiplicative.ofAdd (![0,1] : Fin 2 → d.field.Carrier) from
      e.apply_symm_apply _] at he
    have hh := congrArg (fun v => v.toAdd 0) he
    change (0 : d.field.Carrier) = (g.val.mulVec (![0,1] : Fin 2 → d.field.Carrier)) 0 at hh
    simp [g,Matrix.mulVec,dotProduct,Fin.sum_univ_two] at hh
  · exact ht.ge.trans inf_le_right
end RootCoordinates

namespace RootCoordinates
variable {d : MSData c 2} (m : RootCoordinates d)
  (s : SecondarySourceData c 2) (D : Chapter12.Section02.ChosenModule T L V)
  (h : Chapter12.Section02.Hypothesis1223 KnownSimple.IsKnownSimple T L)
  (e : (s.component ⧸ pCore 2 s.component) ≃* Matrix.PSL3Four.PSL)
include m s D h e

/-- The class-two identity and original radical coverage place P∩Q in K₂. -/
theorem component_core_intersection_le_secondary :
    Q c ⊓ (s.component.map (rootNormalizer c).subtype).pCoreIn 2 ≤ secondary c := by
  let P := (s.component.map (rootNormalizer c).subtype).pCoreIn 2
  let A := Q c ⊓ P
  have hPP : ⁅P,P⁆ ≤ U c := by
    obtain ⟨hp,_,_,_⟩ := d.linearFour_special_root m s D h e
    rw [map_subtype_commutator] at hp
    exact hp.le.trans d.root_le_center
  have hQQ : ⁅Q c,Q c⁆ ≤ U c := by
    have hh := d.core_derived_eq_center
    rw [map_subtype_commutator] at hh
    exact hh.le
  have hQ : Q c ≤ commutatorPreimage (R₂ c) A (U c) :=
    le_commutatorPreimage (core_le_radical c) ((commutator_mono le_rfl inf_le_left).trans hQQ)
  have hP : P ≤ commutatorPreimage (R₂ c) A (U c) :=
    le_commutatorPreimage (s.component_core_le D) ((commutator_mono le_rfl inf_le_right).trans hPP)
  have hR : R₂ c ≤ commutatorPreimage (R₂ c) A (U c) :=
    (m.component_core_sup_original_core s D h e).ge.trans (sup_le hQ hP)
  have hRU : R₂ c ≤ normalizer (U c : Set G) :=
    (m.radical_le_original (by decide) D s.core_eq).trans d.natural.2.1
  exact m.core_radical_displacement_le_secondary (by decide) D s A inf_le_left
    ((le_commutatorPreimage_iff (R₂ c) A (U c) (R₂ c) hRU).mp hR).2

/-- The actual cubic decomposition places the entire special component core in K₂. -/
theorem component_core_le_secondary :
    (s.component.map (rootNormalizer c).subtype).pCoreIn 2 ≤ secondary c := by
  let M := s.component.map (rootNormalizer c).subtype
  let P := M.pCoreIn 2
  obtain ⟨X,hX,hXK,hr,hfix,_,_,_,hcomm,_,_⟩ := d.exists_source_cubic_root D
  have hNP : rootNormalizer c ≤ normalizer (P : Set G) :=
    s.component_normalized.trans (normalizer_le_normalizer_characteristic_image M (pCore 2 M))
  have hp : IsPGroup 2 P := isPGroup_pCoreIn 2 M
  let : Group.IsNilpotent P := hp.isNilpotent
  have hcop : Nat.Coprime (Nat.card X) (Nat.card P) := by
    obtain ⟨j,hj⟩ := hp.exists_card_eq
    rw [hX,hj]
    exact (by decide : Nat.Coprime 3 2).pow_right j
  have hd := eq_commutator_sup_centralizer_of_solvable_coprime P X (hr.trans hNP)
    inferInstance hcop
  change P ≤ secondary c
  rw [hd]
  apply sup_le
  · apply le_trans _ (m.component_core_intersection_le_secondary s D h e)
    exact le_inf
      ((commutator_mono (s.component_core_le D) le_rfl).trans_eq
        (m.radical_cubic_commutator D s X hXK
          (d.cubic_core_moved X hX (hXK.trans (coreCenterIn_le 2 _)) hfix)))
      (le_normalizer_iff_commutator_le_left.mp (hr.trans hNP))
  · exact (inf_le_inf_right _ (s.component_core_le D)).trans
      (m.cubic_fixed_radical_le_secondary s D X hX hXK hfix hcomm)
end RootCoordinates

/-- The original linear-four branch contradicts strict secondary-core enlargement.
All MS and secondary premises remain explicit for the source assembly owner. -/
theorem MSData.linearFour_false_of_source (d : MSData c 2) (m : RootCoordinates d)
    (s : SecondarySourceData c 2) (D : Chapter12.Section02.ChosenModule T L V)
    (h : Chapter12.Section02.Hypothesis1223 KnownSimple.IsKnownSimple T L)
    (e : (s.component ⧸ pCore 2 s.component) ≃* Matrix.PSL3Four.PSL) : False := by
  exact s.core_enlarges.not_ge (sup_le (m.component_core_le_secondary s D h e) le_rfl)
end CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness.Nonblock
