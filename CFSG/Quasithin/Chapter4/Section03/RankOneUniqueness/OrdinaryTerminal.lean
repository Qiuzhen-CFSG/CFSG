module
public import CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness.OrdinaryModel
public import Theory.GroupTheory.ConjugateSpanFixedFactor

/-!
# The terminal group calculation in original 4.3.6

Once the root-normalizer FF-module calculation gives its fixed-factor
decomposition, normal generation by the full module makes Q_Z normalize
K₂. The secondary component K_Z has the same image modulo Q_Z and is
generated by its conjugates of K₂, so K_Z = K₂. Normality in G_Z now forces
T to normalize K₂. Together with T-invariance of L and K = ⟨L,K₂⟩,
this contradicts the strict Sylow intersection T ∩ H < T.

The literal root-normalizer application keeps the earlier geometry and
FF-module conclusions explicit. It does not assert original 4.3.6 until
those premises and the symplectic marking have been constructed.
Source: Aschbacher--Smith 4.3.6, printed pp.614--615.
-/

public section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}

omit [Finite G] in
/-- A second generator of K cannot be normalized by the original Sylow T. -/
theorem SourceConfiguration.ordinary_second_not_normalized
    (c : SourceConfiguration T L) (D : Chapter12.Section02.ChosenModule T L V)
    {J : Subgroup G} (hgen : L ⊔ J = c.K.map c.H.subtype) :
    ¬ (T : Subgroup G) ≤ normalizer (J : Set G) := by
  intro hn
  have hTK : (T : Subgroup G) ≤ normalizer (c.K.map c.H.subtype : Set G) := by
    rw [←hgen]
    exact (le_inf D.sylow_normalizes_component hn).trans
      (normalizer_inf_normalizer_le_normalizer_sup L J)
  have hTH : (T : Subgroup G) ≤ c.H := hTK.trans c.normalizer_component.ge
  exact c.sylow_strict.ne (inf_eq_left.mpr hTH)

omit [Finite G] in
/-- The terminal group calculation in original 4.3.6. KZ is generated by
its conjugates of J, has the same image modulo Q, and is normalized by T. -/
theorem SourceConfiguration.ordinary_false_of_terminal_data
    (c : SourceConfiguration T L) (D : Chapter12.Section02.ChosenModule T L V)
    (A J Q U KZ : Subgroup G)
    (hgen : L ⊔ J = c.K.map c.H.subtype)
    (hJU : J ≤ normalizer (U : Set G))
    (hJQ : J ≤ normalizer (Q : Set G))
    (hQU : Q ≤ normalizer (U : Set G))
    (hUJ : U ≤ J)
    (hQ : Q = U ⊔ (Q ⊓ centralizer (A : Set G)))
    (hJ : conjugateSpanBy A J = J)
    (hJKZ : J ≤ KZ)
    (hKZ : conjugateSpanBy J KZ = KZ)
    (himage : KZ ≤ J ⊔ Q)
    (hTKZ : (T : Subgroup G) ≤ normalizer (KZ : Set G)) : False := by
  have hQJ := normalizes_of_fixed_factor_and_conjugate_generation A J Q U hJU hJQ hQU hUJ hQ hJ
  have hn : KZ ≤ normalizer (J : Set G) :=
    himage.trans (sup_le J.le_normalizer hQJ)
  have he : KZ = J := le_antisymm
    (hKZ ▸ conjugateSpanBy_le (le_refl J) hn) hJKZ
  exact c.ordinary_second_not_normalized D hgen (he ▸ hTKZ)

end CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness

namespace CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness
open Subgroup Theory.GroupTheory
variable {G : Type*} [Group G] [Finite G] {T : Sylow 2 G} {L V : Subgroup G}

omit [Finite G] in
/-- Original 4.3.6 after the concrete root geometry and FF-module calculation.
All remaining premises concern the literal root normalizer and full source
module. In particular neither KZ = K₂ nor normalization of K₂ is assumed. -/
theorem SourceConfiguration.ordinary_false_of_root_normalizer
    (c : SourceConfiguration T L) (D : Chapter12.Section02.ChosenModule T L V)
    {n : ℕ} (m : OrdinarySymplecticMarking c n) (KZ : Subgroup G)
    (hT : (T : Subgroup G) ≤ m.rootNormalizer)
    (hgen : L ⊔ m.second = c.K.map c.H.subtype)
    (hseed : conjugateSpanBy c.ordinaryModule m.second = m.second)
    (hU : m.rootSpan = m.second.pCoreIn 2)
    (hQ : m.rootCore = m.second.pCoreIn 2 ⊔
      (m.rootCore ⊓ centralizer (c.ordinaryModule : Set G)))
    (hKZ : conjugateSpanBy m.second KZ = KZ)
    (himage : KZ ≤ m.second ⊔ m.rootCore)
    (hnormal : m.rootNormalizer ≤ normalizer (KZ : Set G)) : False := by
  have hJN : m.second ≤ m.rootNormalizer :=
    (map_subtype_le _).trans inf_le_right
  have hQN : m.rootCore ≤ m.rootNormalizer := pCoreIn_le 2 _
  have hNU : m.rootNormalizer ≤ normalizer (m.rootSpan : Set G) :=
    le_normalizer_conjugateSpanBy _ _
  have hNQ : m.rootNormalizer ≤ normalizer (m.rootCore : Set G) :=
    m.rootNormalizer.le_normalizer.trans
      (normalizer_le_normalizer_characteristic_image _ (pCore 2 _))
  exact c.ordinary_false_of_terminal_data D c.ordinaryModule m.second m.rootCore
    m.rootSpan KZ hgen (hJN.trans hNU) (hJN.trans hNQ) (hQN.trans hNU)
    (hU.le.trans (pCoreIn_le 2 m.second)) (by rwa [hU]) hseed
    ((le_conjugateSpanBy m.second KZ).trans_eq hKZ) hKZ himage (hT.trans hnormal)

end CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness
