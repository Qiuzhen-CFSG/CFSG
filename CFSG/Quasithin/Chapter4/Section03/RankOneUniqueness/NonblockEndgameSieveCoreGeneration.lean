module
public import CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness.NonblockEndgameSieveExclusionsUnitary
public import Theory.SpecificGroups.PSL2.BinaryPerfectCentralizer

/-!
# Nonblock model rows from moved-core generation

Assume R is generated by Q and [R,X], where X is the actual perfect inner
secondary image and only Q satisfies [Q,Y] = Q. In binary PSL₂, the cyclic
centralizer argument kills Q; triviality of the secondary two-core then
kills [R,X]. In PSU₃, core movement puts Q inside the inner group, and
generation puts all of R there. The perfect-normalizer argument excludes
that two-subgroup. Faithful descent through the full SU₃ central cover
preserves every input, including generation and core movement.

These are sufficient model lemmas, not a proof that the proposed generation
identity holds in the source configuration. They replace uses of universal
radical movement in the conditional row exclusions. Their literal-action
applications are in `NonblockEndgameSieveSourceImages`.
Source: Aschbacher–Smith, original 4.3.16 and its elimination, printed p.618;
see the movement correction in `docs/quasithin-proof-basis.md`.
-/

public section
noncomputable section
open Subgroup Theory.GroupTheory BenderSuzuki.MatrixGroups
namespace CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness.Nonblock.EndgameSieve

/-- Core movement and secondary generation exclude the projective unitary arrangement. -/
theorem unitary_generated_twoGroup_eq_bot {U : Type*} [Group U] [Finite U]
    {n : ℕ} (hn : 1 < n) (hm : ClassicalGroup.IsPSU U 3 (2 ^ n))
    (X : Subgroup (MulAut U)) [Group.IsPerfect X] (hne : X ≠ ⊥)
    (hiX : X ≤ MulAut.innerSubgroup U)
    (R Q Y : Subgroup (MulAut U)) (hR : IsPGroup 2 R) (hQR : Q ≤ R)
    (hXR : X ≤ normalizer (R : Set (MulAut U))) (hmove : ⁅Q,Y⁆ = Q)
    (hgen : Q ⊔ ⁅R,X⁆ = R) : R = ⊥ := by
  obtain ⟨F,_,_,J,hc,hconj,⟨e⟩⟩ := hm
  obtain ⟨C,hC⟩ := ChapterF.Source.Unitary.FormTransport.exists_standard_basis J n (by omega) hc hconj
  let J₀ := ChapterF.Source.Unitary.FormTransport.standardForm J
  let b := e.trans (ChapterF.Source.Unitary.FormTransport.projectiveEquiv J C hC)
  let A := MulAut.congr b
  let V := ProjectiveSpecialUnitaryMatrixGroup J₀
  let : Finite V := Finite.of_surjective b b.surjective
  have hf : Nat.card {x : F // J₀.conj x = x} = 2 ^ n :=
    FiniteField.card_fixed_of_quadratic_frobenius J₀.conj 2 n (by omega) hc hconj
  let : IsSimpleGroup V := BenderSuzuki.External.huppert_II_10_13 J₀ (2 ^ n)
    (lt_of_lt_of_le (by decide : 2 < 2 ^ 2) (Nat.pow_le_pow_right (by decide) (by omega))) hc hf
  let X' := X.map A.toMonoidHom
  let R' := R.map A.toMonoidHom
  let Q' := Q.map A.toMonoidHom
  let Y' := Y.map A.toMonoidHom
  let : Group.IsPerfect X' := Group.IsPerfect.map _
  have hx : X' ≠ ⊥ := fun he => hne ((X.map_eq_bot_iff_of_injective A.injective).mp he)
  have hix : X' ≤ MulAut.innerSubgroup V := by
    rintro _ ⟨x,hx,rfl⟩
    obtain ⟨g,rfl⟩ := hiX hx
    exact ⟨b g,MulAut.congr_conj b g |>.symm⟩
  have hr : IsPGroup 2 R' := hR.map _
  have hn' : X' ≤ normalizer (R' : Set (MulAut V)) :=
    (map_mono hXR).trans (R.le_normalizer_map _)
  have hm' : ⁅Q',Y'⁆ = Q' := by
    change ⁅Q.map A.toMonoidHom,Y.map A.toMonoidHom⁆ = Q.map A.toMonoidHom
    rw [← map_commutator,hmove]
  have hiq := HermitianForm.EvenSemilinear.moved_twoGroup_le_inner J₀ rfl
    (by omega : 2 ≤ n) hc hconj Q' Y' ((hR.to_le hQR).map _) hm'
  have hg' : Q' ⊔ ⁅R',X'⁆ = R' := by
    change Q.map A.toMonoidHom ⊔ ⁅R.map A.toMonoidHom,X.map A.toMonoidHom⁆ = _
    rw [← map_commutator, ← Subgroup.map_sup, hgen]
  have hir : R' ≤ MulAut.innerSubgroup V := by
    rw [← hg']
    exact sup_le hiq ((commutator_mono le_rfl hix).trans (commutator_le_right _ _))
  have hz := HermitianForm.EvenProjectiveComparison.center_eq_bot J₀ (by omega : 0 < n) hc hconj
  have he := inner_twoGroup_eq_bot_of_perfect_normalizer hz
    (ChapterF.Source.Unitary.two_normalizer_solvable (by omega : 0 < n)
      (show ClassicalGroup.IsPSU V 3 (2 ^ n) from ⟨F,inferInstance,inferInstance,J₀,hc,hconj,⟨MulEquiv.refl _⟩⟩))
    X' hx hix R' hr hir hn'
  exact (R.map_eq_bot_iff_of_injective A.injective).mp he

/-- Faithful descent of the special unitary cover preserves the same exclusion. -/
theorem special_unitary_generated_twoGroup_eq_bot {U : Type*} [Group U] [Finite U]
    [Group.IsPerfect U] {n : ℕ} (hn : 1 < n)
    (hm : Chapter1.Section02.LocalModels.IsSU U 3 (2 ^ n))
    (X : Subgroup (MulAut U)) [Group.IsPerfect X] (hne : X ≠ ⊥)
    (hiX : X ≤ MulAut.innerSubgroup U)
    (R Q Y : Subgroup (MulAut U)) (hR : IsPGroup 2 R) (hQR : Q ≤ R)
    (hXR : X ≤ normalizer (R : Set (MulAut U))) (hmove : ⁅Q,Y⁆ = Q)
    (hgen : Q ⊔ ⁅R,X⁆ = R) : R = ⊥ := by
  obtain ⟨F,_,_,J,hc,hconj,⟨e⟩⟩ := hm
  let V := ProjectiveSpecialUnitaryMatrixGroup J
  let : Group.IsPerfect J.specialSubgroup := Group.IsPerfect.ofSurjective (f := e.toMonoidHom) e.surjective
  let : Finite V := Finite.of_surjective J.specialToProjective J.specialToProjective_surjective
  let f : PerfectCentralCovering.Cover J.specialSubgroup V := {
    toMonoidHom := J.specialToProjective
    surjective := J.specialToProjective_surjective
    isPerfect := inferInstance
    ker_le_center := J.specialToProjective_ker_le_center }
  have hk : f.toMonoidHom.ker = center J.specialSubgroup :=
    J.specialToProjective_ker_eq_center
      (HermitianForm.EvenProjectiveComparison.center_eq_bot J (by omega) hc hconj)
  let A : MulAut U →* MulAut V := (f.autMap hk).comp (MulAut.congr e).toMonoidHom
  have hA : Function.Injective A := (f.autMap_injective hk).comp (MulAut.congr e).injective
  have hinner (g : U) : A (MulAut.conj g) = MulAut.conj (f.toMonoidHom (e g)) := by
    change f.autMap hk (MulAut.congr e (MulAut.conj g)) = _
    rw [MulAut.congr_conj]
    ext v
    obtain ⟨x,rfl⟩ := f.surjective v
    rw [f.autMap_apply]
    simp only [MulAut.conj_apply,map_mul,map_inv]
  let X' := X.map A
  let R' := R.map A
  let Q' := Q.map A
  let Y' := Y.map A
  let : Group.IsPerfect X' := Group.IsPerfect.map _
  have hx : X' ≠ ⊥ := fun he => hne ((X.map_eq_bot_iff_of_injective hA).mp he)
  have hix : X' ≤ MulAut.innerSubgroup V := by
    rintro _ ⟨x,hx,rfl⟩
    obtain ⟨g,rfl⟩ := hiX hx
    exact ⟨f.toMonoidHom (e g),(hinner g).symm⟩
  have hn' : X' ≤ normalizer (R' : Set (MulAut V)) :=
    (map_mono hXR).trans (R.le_normalizer_map _)
  have hm' : ⁅Q',Y'⁆ = Q' := by
    change ⁅Q.map A,Y.map A⁆ = Q.map A
    rw [← map_commutator,hmove]
  have hg' : Q' ⊔ ⁅R',X'⁆ = R' := by
    change Q.map A ⊔ ⁅R.map A,X.map A⁆ = _
    rw [← map_commutator, ← Subgroup.map_sup, hgen]
  have he := unitary_generated_twoGroup_eq_bot hn
    (show ClassicalGroup.IsPSU V 3 (2 ^ n) from ⟨F,inferInstance,inferInstance,J,hc,hconj,⟨MulEquiv.refl _⟩⟩)
    X' hx hix R' Q' Y' (hR.map _) (map_mono hQR) hn' hm' hg'
  exact (R.map_eq_bot_iff_of_injective hA).mp he



/-- A perfect inner subgroup in any binary PSL₂ model has trivial embedded two-core. -/
theorem binary_inner_twoCore_eq_bot {U : Type*} [Group U] [Finite U]
    {m : ℕ} (hm : ClassicalGroup.IsPSL U 2 (2 ^ m))
    (X : Subgroup (MulAut U)) [Group.IsPerfect X]
    (hiX : X ≤ MulAut.innerSubgroup U) : X.pCoreIn 2 = ⊥ := by
  obtain ⟨F,_,_,hF,⟨e⟩⟩ := hm
  let : Fintype F := Fintype.ofFinite F
  let : CharP F 2 := charP_of_card_eq_prime_pow (by simpa only [Nat.card_eq_fintype_card] using hF)
  let A := MulAut.congr e
  let X' := X.map A.toMonoidHom
  let : Group.IsPerfect X' := Group.IsPerfect.map _
  have hi : X' ≤ MulAut.innerSubgroup (Theory.PSL2.Group F) := by
    rintro _ ⟨x,hx,rfl⟩
    obtain ⟨g,rfl⟩ := hiX hx
    exact ⟨e g,(MulAut.congr_conj e g).symm⟩
  have hcore := Theory.PSL2.perfect_inner_subgroup_twoCore_eq_bot X' hi
  apply ((X.pCoreIn 2).map_eq_bot_iff_of_injective (f := A.toMonoidHom) A.injective).mp
  rw [map_pCoreIn_of_injective 2 _ _ A.injective]
  change (pCore 2 X').map X'.subtype = ⊥
  rw [hcore,Subgroup.map_bot]

/-- Binary rank one excludes a radical generated by its moved core and secondary
commutators. Movement of the whole radical is not assumed. -/
theorem binary_generated_twoGroup_eq_bot {U : Type*} [Group U] [Finite U]
    {m : ℕ} (hm : ClassicalGroup.IsPSL U 2 (2 ^ m))
    (X : Subgroup (MulAut U)) [Group.IsPerfect X] (hne : X ≠ ⊥)
    (hiX : X ≤ MulAut.innerSubgroup U)
    (R Q Y : Subgroup (MulAut U)) (hR : IsPGroup 2 R) (hQR : Q ≤ R)
    (hXQ : X ≤ normalizer (Q : Set (MulAut U)))
    (hXR : X ≤ normalizer (R : Set (MulAut U)))
    (hRX : R ≤ normalizer (X : Set (MulAut U)))
    (hY : Y ≤ centralizer (X : Set (MulAut U)))
    (hmove : ⁅Q,Y⁆ = Q) (hgen : Q ⊔ ⁅R,X⁆ = R) : R = ⊥ := by
  obtain ⟨F,_,_,hF,⟨e⟩⟩ := hm
  let : Fintype F := Fintype.ofFinite F
  let : CharP F 2 := charP_of_card_eq_prime_pow (by simpa only [Nat.card_eq_fintype_card] using hF)
  let A := MulAut.congr e
  let X' := X.map A.toMonoidHom
  let R' := R.map A.toMonoidHom
  let Q' := Q.map A.toMonoidHom
  let Y' := Y.map A.toMonoidHom
  let : Group.IsPerfect X' := Group.IsPerfect.map _
  have hx : X' ≠ ⊥ := fun he => hne ((X.map_eq_bot_iff_of_injective A.injective).mp he)
  have hi : X' ≤ MulAut.innerSubgroup (Theory.PSL2.Group F) := by
    rintro _ ⟨x,hx,rfl⟩
    obtain ⟨g,rfl⟩ := hiX hx
    exact ⟨e g,(MulAut.congr_conj e g).symm⟩
  let b := MonoidHom.ofInjective
    (MulAut.conj_injective_of_center_eq_bot (GorensteinWalter.psl2_center_eq_bot F))
  let f : X' →* Theory.PSL2.Group F := b.symm.toMonoidHom.comp (inclusion hi)
  have hf (x : X') : MulAut.conj (f x) = (x : MulAut (Theory.PSL2.Group F)) :=
    congrArg (MulAut.innerSubgroup (Theory.PSL2.Group F)).subtype (b.apply_symm_apply (inclusion hi x))
  let H := f.range
  let : Group.IsPerfect H := Group.IsPerfect.range _
  have hmap : H.map MulAut.conj = X' := by
    ext a
    constructor
    · rintro ⟨_,⟨x,rfl⟩,rfl⟩
      rw [hf]
      exact x.property
    · intro ha
      exact ⟨f ⟨a,ha⟩,⟨⟨a,ha⟩,rfl⟩,hf ⟨a,ha⟩⟩
  have hnH : H ≠ ⊥ := by
    intro he
    rw [he,Subgroup.map_bot] at hmap
    exact hx hmap.symm
  have hXQ' : X' ≤ normalizer (Q' : Set _) :=
    (map_mono hXQ).trans (Q.le_normalizer_map _)
  have hXR' : X' ≤ normalizer (R' : Set _) :=
    (map_mono hXR).trans (R.le_normalizer_map _)
  have hRX' : R' ≤ normalizer (X' : Set _) :=
    (map_mono hRX).trans (X.le_normalizer_map _)
  have hY' : Y' ≤ centralizer (X' : Set _) :=
    (map_mono hY).trans (map_centralizer_le_centralizer_image _ _)
  have hm' : ⁅Q',Y'⁆ = Q' := by
    change ⁅Q.map A.toMonoidHom,Y.map A.toMonoidHom⁆ = _
    rw [← map_commutator,hmove]
  have hQ : Q' = ⊥ := Theory.PSL2.twoGroup_eq_bot_of_moved_by_centralizer H hnH
    Q' Y' ((hR.to_le hQR).map _) (by rwa [hmap])
    (by rw [hmap]; exact (map_mono hQR).trans hRX') (by rwa [hmap]) hm'
  have hcore := Theory.PSL2.perfect_inner_subgroup_twoCore_eq_bot X' hi
  have hcomm : ⁅R',X'⁆ = ⊥ := by
    rw [commutator_comm]
    apply bot_unique
    simpa only [hcore,Subgroup.map_bot] using
      commutator_le_pCore_of_mutual_normalization X' R' (hR.map _) hXR' hRX'
  have hg' : Q' ⊔ ⁅R',X'⁆ = R' := by
    change Q.map A.toMonoidHom ⊔ ⁅R.map A.toMonoidHom,X.map A.toMonoidHom⁆ = _
    rw [← map_commutator,← Subgroup.map_sup,hgen]
  apply (R.map_eq_bot_iff_of_injective (f := A.toMonoidHom) A.injective).mp
  change R' = ⊥
  rw [← hg',hQ,hcomm,bot_sup_eq]

end CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness.Nonblock.EndgameSieve
