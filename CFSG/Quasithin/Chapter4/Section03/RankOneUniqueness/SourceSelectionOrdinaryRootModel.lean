module
public import CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness.SourceSelectionOrdinaryRootCore
public import CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness.OrdinaryRootSecondary.Model
public import Theory.SpecificGroups.SymplecticFour.RootTori
public import CFSG.Quasithin.ChapterA.Section03.SQTKStructure.NoncentralFitting.TwoRank
public import Theory.GroupTheory.RankOneSylowExtension
public import Theory.SpecificGroups.PSL2.RootTwoRank
public import Theory.SpecificGroups.PSL2.AutomorphismModel
public import Theory.GroupTheory.PResidual.NormalSubgroup
import Mathlib.Tactic.FinCases

/-!
# The secondary root model before full-normalizer identification

The middle-block SL₂ embedding and the long-root scalar torus are transported
through the marked ordinary component. The scalar factor is faithful on the
root and centralizes the Levi. Perfectness and the elementary two-kernel show
that the Levi normally generates the full point residual. Its simple image
survives every containing two-core quotient, excluding the odd-SL₂ alternatives
of source 1.2.1(4). A containing C-component is normally generated by the actual
second subgroup; no equality between those two subgroups is assumed.

This extends OrdinaryRootSecondary.Model to the raw OutsideChoice, preserving
the original subgroup maps and requiring no full-normalizer identity.

Source: Aschbacher--Smith 4.3.6, printed pp.614--615, using 1.2.1 and A.3.6.
-/

public section
open Subgroup Theory.GroupTheory
open scoped MatrixGroups
namespace CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness
open Theory.SpecificGroups.SymplecticFour
variable {G : Type*} [Group G] {T : Sylow 2 G} {L : Subgroup G}
namespace OutsideSymplecticMarking
variable {c : OutsideChoice T L} {K0 : Subgroup c.H} {n : ℕ}

abbrev pointLeviHom {F : Type*} [_root_.Field F] :=
  OrdinarySymplecticMarking.pointLeviHom (F := F)

@[expose] noncomputable def leviEmbedding (m : OutsideSymplecticMarking c K0 n) :
    Matrix.SpecialLinearGroup (Fin 2) m.Field →* G :=
  m.modelEmbedding.comp (pointLocal.subtype.comp pointLeviHom)

theorem leviEmbedding_injective (m : OutsideSymplecticMarking c K0 n) :
    Function.Injective m.leviEmbedding := by
  apply m.modelEmbedding_injective.comp
  apply pointLocal.subtype_injective.comp
  intro a b hab
  exact (pointQuotient_pointLevi a).symm.trans
    ((congrArg pointQuotient hab).trans (pointQuotient_pointLevi b))

theorem leviEmbedding_range_le_second (m : OutsideSymplecticMarking c K0 n) (hn : 1 < n) :
    m.leviEmbedding.range ≤ m.second := by
  rw [← m.pointLocal_image hn]
  rintro x ⟨a, rfl⟩
  exact mem_map_of_mem m.modelEmbedding (pointLevi a).property

@[expose] noncomputable def cartan (m : OutsideSymplecticMarking c K0 n) : Subgroup G :=
  (RootTori.torus (F := m.Field) 0).map m.modelEmbedding

noncomputable def cartanEquiv (m : OutsideSymplecticMarking c K0 n) :
    m.cartan ≃* Multiplicative (ZMod (2 ^ n - 1)) :=
  ((RootTori.torus (F := m.Field) 0).equivMapOfInjective
    m.modelEmbedding m.modelEmbedding_injective).symm.trans (RootTori.cyclicEquiv 0 m.card)

theorem cartan_le_rootNormalizer (m : OutsideSymplecticMarking c K0 n) :
    m.cartan ≤ m.rootNormalizer := by
  apply le_normalizer_iff.mpr
  rintro y ⟨a, ha, rfl⟩ z hz
  rw [← m.root_image] at hz ⊢
  obtain ⟨b, hb, rfl⟩ := hz
  rw [← map_inv, ← map_mul, ← map_mul]
  exact mem_map_of_mem _ ((mem_normalizer_iff.mp (RootTori.torus_le_normalizer 0 ha) b).mp hb)

theorem cartan_faithful (m : OutsideSymplecticMarking c K0 n) :
    m.cartan ⊓ centralizer (m.root : Set G) = ⊥ := by
  apply eq_bot_iff.mpr
  rintro x ⟨⟨a, ha, rfl⟩, hc⟩
  have hz : a ∈ centralizer (RootSubgroup.group (F := m.Field) 0 : Set (Sp m.Field)) := by
    intro b hb
    apply m.modelEmbedding_injective
    simpa only [map_mul] using hc (m.modelEmbedding b) (m.root_image ▸ mem_map_of_mem _ hb)
  have ha1 : a = 1 := mem_bot.mp
    (RootTori.centralizer_inf_torus (F := m.Field) 0 ▸ ⟨hz, ha⟩)
  simpa only [ha1, map_one] using (one_mem (⊥ : Subgroup G))

theorem cartan_centralizes_levi (m : OutsideSymplecticMarking c K0 n) :
    m.cartan ≤ centralizer (m.leviEmbedding.range : Set G) := by
  rintro x ⟨a, ⟨s, rfl⟩, rfl⟩ b ⟨A, rfl⟩
  change m.modelEmbedding (pointLevi A) * m.modelEmbedding (RootTori.parameter 0 s) =
    m.modelEmbedding (RootTori.parameter 0 s) * m.modelEmbedding (pointLevi A)
  rw [← map_mul, ← map_mul]
  congr 1
  apply Subtype.ext
  ext i j
  change (pointLeviMatrix A * (RootTori.element 0 s).val) i j =
    ((RootTori.element 0 s).val * pointLeviMatrix A) i j
  change (pointLeviMatrix A * (diagonalTorus s 1).val) i j =
    ((diagonalTorus s 1).val * pointLeviMatrix A) i j
  simp only [diagonalTorus, Matrix.diagonal_mul, Matrix.mul_diagonal]
  rcases i with i | i <;> rcases j with j | j <;>
    fin_cases i <;> fin_cases j <;> simp [pointLeviMatrix, Matrix.fromBlocks]

theorem second_le_rootCentralizer (m : OutsideSymplecticMarking c K0 n) (hn : 1 < n) :
    m.second ≤ centralizer (m.root : Set G) := by
  rw [← m.pointLocal_image hn, ← m.root_image]
  exact (map_mono (show pointLocal ≤ centralizer
    (RootSubgroup.group (F := m.Field) 0 : Set (Sp m.Field)) by
      rw [RootNormalizerResidual.centralizer_zero_eq])).trans
    (map_centralizer_le_centralizer_image _ _)

theorem second_perfect (m : OutsideSymplecticMarking c K0 n) (hn : 1 < n) :
    Group.IsPerfect m.second := by
  rw [← m.pointLocal_image hn]
  let := pointLocal_perfect m.card hn
  exact Group.IsPerfect.map m.modelEmbedding

theorem levi_simple (m : OutsideSymplecticMarking c K0 n) (hn : 1 < n) :
    IsSimpleGroup (Matrix.SpecialLinearGroup (Fin 2) m.Field) := by
  have hfour : 4 ≤ Nat.card m.Field := by
    rw [m.card]
    exact (show 4 = 2 ^ 2 by decide) ▸ Nat.pow_le_pow_right (by decide) (by omega)
  let := Matrix.ProjectiveSpecialLinearGroup.rank_two_simple hfour
  exact (Theory.PSL2.sl2QuotientEquiv m.Field).isSimpleGroup

theorem levi_perfect (m : OutsideSymplecticMarking c K0 n) (hn : 1 < n) :
    Group.IsPerfect (Matrix.SpecialLinearGroup (Fin 2) m.Field) := by
  let := pointLocal_perfect m.card hn
  exact Group.IsPerfect.ofSurjective (f := pointQuotient) pointQuotient_surjective

theorem second_ne_bot (m : OutsideSymplecticMarking c K0 n) (hn : 1 < n) :
    m.second ≠ ⊥ := by
  let := m.levi_simple hn
  let f := m.leviEmbedding.codRestrict m.second (fun a =>
    m.leviEmbedding_range_le_second hn ⟨a, rfl⟩)
  have hf : Function.Injective f := fun a b hab =>
    m.leviEmbedding_injective (congrArg (fun z : m.second => (z : G)) hab)
  exact (nontrivial_iff_ne_bot _).mp hf.nontrivial

theorem levi_two_rank (m : OutsideSymplecticMarking c K0 n) :
    n ≤ primeRank 2 (Matrix.SpecialLinearGroup (Fin 2) m.Field) := by
  rw [primeRank_equiv 2 (Theory.PSL2.sl2QuotientEquiv m.Field)]
  exact Theory.PSL2.root_two_rank_ge m.Field m.card

/-- The split Levi normally generates the full perfect point residual,
including its noncentral two-core. -/
theorem levi_generates_second (m : OutsideSymplecticMarking c K0 n) (hn : 1 < n) :
    conjugateSpanBy m.leviEmbedding.range m.second = m.second := by
  let P := pointLocal (F := m.Field)
  let A : Subgroup P := (pointLeviHom (F := m.Field)).range
  let N : Subgroup P := conjugateSpanBy A ⊤
  let f : P →* Matrix.SpecialLinearGroup (Fin 2) m.Field := pointQuotient
  let : N.Normal := normalizer_eq_top_iff.mp
    (top_unique (le_normalizer_conjugateSpanBy A ⊤))
  have him : N.map f = ⊤ := by
    apply eq_top_iff.mpr
    intro a _
    exact mem_map.mpr ⟨pointLevi a, le_conjugateSpanBy A ⊤ ⟨a, rfl⟩,
      pointQuotient_pointLevi a⟩
  have hs : N ⊔ f.ker = ⊤ := by
    rw [← comap_map_eq, him, comap_top]
  have htwo : IsPGroup 2 (P ⧸ N) :=
    isPGroup_quotient_of_sup_eq_top N f.ker
      (IsElementaryAbelian.isPGroup 2 (pointRadical (F := m.Field))) hs
  let := htwo.isNilpotent
  let := pointLocal_perfect m.card hn
  have hN : N = ⊤ := top_unique (by
    rw [← solvableResidual_eq_top (G := P)]
    exact solvableResidual_le_of_solvable_quotient N)
  let j := m.modelEmbedding.comp P.subtype
  have hj : (⊤ : Subgroup P).map j = m.second := by
    rw [← MonoidHom.range_eq_map, MonoidHom.range_comp, range_subtype]
    exact m.pointLocal_image hn
  have hA : A.map j = m.leviEmbedding.range := by
    rw [← MonoidHom.range_comp]
    rfl
  have he := congrArg (map j) hN
  change (conjugateSpanBy A ⊤).map j = (⊤ : Subgroup P).map j at he
  simpa only [map_conjugateSpanBy, hA, hj] using he

/-- Every prime in the scalar factor also occurs in the actual Levi.
This retains an embedding, rather than just a quotient order calculation. -/
theorem scalar_prime_dvd_levi (m : OutsideSymplecticMarking c K0 n) {p : ℕ}
    (hp : p ∣ 2 ^ n - 1) : p ∣ Nat.card m.leviEmbedding.range := by
  have hd : Nat.card m.Fieldˣ ∣ Nat.card (Matrix.SpecialLinearGroup (Fin 2) m.Field) :=
    card_dvd_of_injective (BenderSuzuki.Converse.torHom m.Field)
      BenderSuzuki.Converse.torHom_injective
  rw [Nat.card_units, m.card] at hd
  rw [← Nat.card_congr (MonoidHom.ofInjective m.leviEmbedding_injective).toEquiv]
  exact hp.trans hd

/-- The actual binary Levi survives the two-core of every containing group. -/
theorem levi_injective_mod_twoCore [Finite G] (m : OutsideSymplecticMarking c K0 n) (hn : 1 < n)
    (J : Subgroup G) (hJ : m.second ≤ J) :
    Function.Injective ((QuotientGroup.mk' (pCore 2 J)).comp
      (m.leviEmbedding.codRestrict J (fun a =>
        hJ (m.leviEmbedding_range_le_second hn ⟨a, rfl⟩)))) := by
  let := m.levi_simple hn
  let := m.levi_perfect hn
  let := pCore_isNilpotent (p := 2) (G := J)
  apply RankOneSylowExtension.simple_quotient_injective
    (Group.IsPerfect.not_isSolvable _) _ _ (pCore 2 J)
  intro x y hxy
  exact m.leviEmbedding_injective (congrArg (fun z : J => (z : G)) hxy)

/-- The source Levi complement excludes both noncentral-Fitting alternatives
for a C-component containing the literal second subgroup. -/
theorem containing_component_quasisimple [Finite G]
    (m : OutsideSymplecticMarking c K0 n) (hn : 1 < n)
    (J KZ : Subgroup G) (hKJ : KZ ≤ J) (hsecond : m.second ≤ KZ)
    (hcomponent : (KZ.subgroupOf J).IsCComponent)
    (hQ : IsSQTK KnownSimple.IsKnownSimple (J ⧸ pCore 2 J)) :
    IsQuasisimple (KZ ⧸ pCore 2 KZ) := by
  let B := KZ.subgroupOf J
  let q := QuotientGroup.mk' (pCore 2 J)
  let C := B.map q
  let j : Matrix.SpecialLinearGroup (Fin 2) m.Field →* J :=
    m.leviEmbedding.codRestrict J (fun a =>
      hKJ (hsecond (m.leviEmbedding_range_le_second hn ⟨a, rfl⟩)))
  have hj : Function.Injective (q.comp j) :=
    m.levi_injective_mod_twoCore hn J (hsecond.trans hKJ)
  let f : Matrix.SpecialLinearGroup (Fin 2) m.Field →* C :=
    (q.comp j).codRestrict C (fun a =>
      mem_map_of_mem q (hsecond (m.leviEmbedding_range_le_second hn ⟨a, rfl⟩)))
  have hf : Function.Injective f := fun a b hab => hj (congrArg Subtype.val hab)
  let := pCore_isNilpotent (p := 2) (G := J)
  let : IsQuasisimple C :=
    ChapterA.Section03.NoncentralFitting.quasisimple_of_two_le_two_rank hQ
      (pCore_quotient_pCore_eq_bot 2) (hcomponent.map_quotient (pCore 2 J))
      ((show 2 ≤ n by omega).trans ((m.levi_two_rank).trans
        (Theory.GroupTheory.primeRank_le_of_injective 2 f hf)))
  let : IsQuasisimple (B ⧸ pCore 2 B) :=
    IsQuasisimple.of_mulEquiv (cComponentTwoCoreQuotientEquiv hcomponent).symm
  let e : B ≃* KZ := subgroupOfEquivOfLe hKJ
  exact IsQuasisimple.of_mulEquiv (QuotientGroup.congr _ _ e (pCore_map_iso 2 e))

private theorem normal_generation {H : Type*} [Group H] [Finite H]
    {A B : Subgroup H} (hB : B.IsCComponent) (hAB : A ≤ B)
    [Group.IsPerfect A] (hne : A ≠ ⊥) : conjugateSpanBy A B = B := by
  let X := conjugateSpanBy A B
  have hXB : X ≤ B := conjugateSpanBy_le hAB B.le_normalizer
  have hn : (X.subgroupOf B).Normal :=
    normal_subgroupOf_of_le_normalizer (le_normalizer_conjugateSpanBy A B)
  have hs : X.IsSubnormal := by
    have hh := hn.isSubnormal.trans' hB.subnormal
    simpa only [map_subgroupOf_eq_of_le hXB] using hh
  have hp : Group.IsPerfect X := conjugateSpanBy_isPerfect A B
  have hx : X ≠ ⊥ := fun he => hne (bot_unique (he ▸ le_conjugateSpanBy A B))
  exact le_antisymm hXB (hB.minimal X hXB hx hp hs)

/-- A containing C-component is generated by the conjugates of the actual
perfect point residual; equality with that residual is not asserted. -/
theorem second_generates_containing_component [Finite G]
    (m : OutsideSymplecticMarking c K0 n) (hn : 1 < n)
    (J KZ : Subgroup G) (hKJ : KZ ≤ J) (hsecond : m.second ≤ KZ)
    (hcomponent : (KZ.subgroupOf J).IsCComponent) :
    conjugateSpanBy m.second KZ = KZ := by
  have hAJ : m.second ≤ J := hsecond.trans hKJ
  let := m.second_perfect hn
  let : Group.IsPerfect (m.second.subgroupOf J) :=
    Group.IsPerfect.ofSurjective (f := (subgroupOfEquivOfLe hAJ).symm.toMonoidHom)
      (subgroupOfEquivOfLe hAJ).symm.surjective
  have hne : m.second.subgroupOf J ≠ ⊥ := by
    intro he
    apply m.second_ne_bot hn
    simpa only [map_subgroupOf_eq_of_le hAJ, Subgroup.map_bot] using
      congrArg (map J.subtype) he
  have he := normal_generation hcomponent
    (show m.second.subgroupOf J ≤ KZ.subgroupOf J from comap_mono hsecond) hne
  simpa only [map_conjugateSpanBy, map_subgroupOf_eq_of_le hAJ,
    map_subgroupOf_eq_of_le hKJ] using congrArg (map J.subtype) he

end OutsideSymplecticMarking
end CFSG.Quasithin.Chapter4.Section03.RankOneUniqueness
