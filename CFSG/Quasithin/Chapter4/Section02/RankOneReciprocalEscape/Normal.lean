/-!
# Normality of the reversed component and its C.2.7 input

The original centerless component quotient supplies an odd prime and makes
its entire reciprocal conjugate span generated by p-elements. If the outside
component were nonnormal, its index-two normalizer would contain this perfect
span. Schreier's theorem then makes the nontrivial quotient action inner, so
p divides that component. Two distinct component conjugates, together with
the normal original component, would exceed the ambient p-rank bound.

Thus the outside component is normal in M=N_G(L). The actual original radical
normalizes it, supplying every field of the reversed C.2.7 input. We apply the
proved kernel, offender and group-model theorems on their literal star quotient.
These conclusions do not yet prove containment of the other H-conjugate in K
or the final Suzuki contradiction.

Source: Aschbacher--Smith, 4.2.10(2) and the following paragraph, printed p.610;
C.2.7(1--3), pp.145--147.
-/

public noncomputable section
open Subgroup Theory.GroupTheory
namespace CFSG.Quasithin.Chapter4.Section02.RankOneReciprocalEscape
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
/-- Taking the literal conjugate span preserves generation by p-elements. -/
theorem primeToResidual_span_eq_top (p : ℕ) [Fact p.Prime] (L H : Subgroup G)
    (hp : primeToResidual p L = ⊤) : primeToResidual p (conjugateSpanBy L H) = ⊤ := by
  let X := conjugateSpanBy L H
  let R := (primeToResidual p X).map X.subtype
  have hLX : L ≤ X := le_conjugateSpanBy L H
  have hLR : L ≤ R := by
    have hh := embedded_primeToResidual_mono p hLX
    simpa only [hp,←MonoidHom.range_eq_map,range_subtype] using hh
  have hHR : H ≤ normalizer (R : Set G) :=
    (le_normalizer_conjugateSpanBy L H).trans
      (normalizer_le_normalizer_characteristic_image X (primeToResidual p X))
  have hXR : X ≤ R := conjugateSpanBy_le hLR hHR
  apply map_injective X.subtype_injective
  rw [←MonoidHom.range_eq_map,range_subtype]
  exact le_antisymm (map_subtype_le _) hXR

private theorem quotient_sqtk (hG : IsSQTK KnownSimple.IsKnownSimple G) :
    IsSQTK KnownSimple.IsKnownSimple (G ⧸ pCore 2 G) := by
  refine ⟨?_,hG.isKGroup.quotient _⟩
  intro p hp ho
  let : Fact p.Prime := ⟨hp⟩
  exact (primeRank_quotient_le_of_isTwoGroup p ho _ pCore_isPGroup).trans
    (hG.stronglyQuasithin p hp ho)

/-- A perfect p-generated actor moving a component forces p into its
intrinsic quotient. A normal complementary component then forces normality
by the ambient odd-rank bound. -/
theorem normal_component_of_moved_prime_generated_span
    (hG : IsSQTK KnownSimple.IsKnownSimple G)
    (B K X : Subgroup G) (hB : B.IsCComponent) (hK : K.IsCComponent)
    [B.Normal] [Group.IsPerfect X] [IsQuasisimple (K ⧸ pCore 2 K)]
    (hne : K ≠ B) {p : ℕ} [Fact p.Prime] (ho : Odd p) (hpB : p ∣ Nat.card B)
    (hpX : primeToResidual p X = ⊤) (hmoved : ¬ ⁅X,K⁆ ≤ pCore 2 G) : K.Normal := by
  by_contra hn
  have hz := coreQuotient_center_eq_bot_of_nonnormal hG hK hn
  have hindex := (Chapter1.Section02.proposition_1_2_1_three_index_knownSimple
    (quotient_sqtk hG) hK).resolve_left hn
  have hXK : X ≤ normalizer (K : Set G) :=
    le_of_isPerfect_of_index_le_two X _ hindex.1.le
  let a : X →* MulAut (K ⧸ pCore 2 K) :=
    ((quotientAut (pCore 2 K)).comp K.normalizerMonoidHom).comp (inclusion hXK)
  have ha : a.range ≠ ⊥ := by
    intro he
    apply hmoved
    apply le_trans ?_ (pCoreIn_le_of_subnormal 2 hK.subnormal)
    apply commutator_le.mpr
    intro x hx k hk
    have hax : a ⟨x,hx⟩ = 1 := mem_bot.mp (he ▸ (show a ⟨x,hx⟩ ∈ a.range from ⟨_,rfl⟩))
    have hfix := DFunLike.congr_fun hax (QuotientGroup.mk' (pCore 2 K) ⟨k,hk⟩)
    simp only [a,MonoidHom.comp_apply,quotientAut_apply_mk,MulAut.one_apply] at hfix
    have hq := QuotientGroup.eq_iff_div_mem.mp hfix
    refine ⟨(K.normalizerMonoidHom (inclusion hXK ⟨x,hx⟩) ⟨k,hk⟩) / ⟨k,hk⟩,hq,?_⟩
    simp [div_eq_mul_inv,commutatorElement_def]
  let : Group.IsSolvable (MulAut.Outer (K ⧸ pCore 2 K)) :=
    ChapterA.Section03.SourceComponents.quasisimple_section_outer_solvable hG
      (ChapterA.Section02.IsSectionOf.quotient_subgroup K (pCore 2 K))
  let : Group.IsPerfect a.range := Group.IsPerfect.range a
  obtain ⟨f,hfi,_⟩ := MulAut.perfect_subgroup_exists_inner_lift a.range hz
  have hpA : p ∣ Nat.card a.range := by
    by_contra hnot
    have hker := primeToResidual_le_ker a.rangeRestrict
      ((Fact.out : p.Prime).coprime_iff_not_dvd.mpr hnot)
    apply ha
    apply MonoidHom.range_eq_bot_iff.mpr
    apply MonoidHom.ext
    intro x
    exact congrArg Subtype.val (show a.rangeRestrict x = 1 from hker (hpX ▸ mem_top x))
  have hpK : p ∣ Nat.card K :=
    (hpA.trans (card_dvd_of_injective f hfi)).trans
      (card_dvd_of_surjective (QuotientGroup.mk' (pCore 2 K)) (QuotientGroup.mk'_surjective _))
  have hKpos : 0 < primeRank p K := Nat.pos_of_ne_zero
    (fun he => PrimeRank.eq_zero_iff_not_dvd_card.mp he hpK)
  have hBpos : 0 < primeRank p B := Nat.pos_of_ne_zero
    (fun he => PrimeRank.eq_zero_iff_not_dvd_card.mp he hpB)
  have hcomm := (Chapter1.Section02.proposition_1_2_1_two_of_A_3_7
    (fun Y _ _ => ChapterA.Section03.CComponentCommutation.universal_A_3_7 Y)
    (quotient_sqtk hG) hK hB hne).1.trans inf_le_left
  exact hn (hK.normal_of_coprime_core_center_rank_complement ho B
    (by rw [hz]; simp) hcomm (by
      have hh := hG.stronglyQuasithin p (Fact.out) ho
      omega))

/-- The actual outside component is normal in M=N_G(L). The odd prime is
chosen in the original simple quotient and is propagated through the
reciprocal span, rather than postulated for the selected component. -/
theorem reciprocal_component_normal {L H : Subgroup G}
    (hH : IsSQTK KnownSimple.IsKnownSimple H)
    (hM : IsSQTK KnownSimple.IsKnownSimple (normalizer (L : Set G)))
    (hd : ReciprocalData L H) [IsQuasisimple (L ⧸ pCore 2 L)]
    (K : Subgroup (normalizer (L : Set G))) (hK : K.IsCComponent)
    [IsQuasisimple (K ⧸ pCore 2 K)]
    (hout : ¬ K ≤ H.subgroupOf (normalizer (L : Set G)))
    (hmoved : ¬ ⁅(conjugateSpanBy L H).subgroupOf (normalizer (L : Set G)),K⁆ ≤
      pCore 2 (normalizer (L : Set G))) : K.Normal := by
  let M := normalizer (L : Set G)
  let B := L.subgroupOf M
  let X := (conjugateSpanBy L H).subgroupOf M
  have hLH : L ≤ H := hd.1 ▸ (map_subtype_le _).trans inf_le_right
  let a : (L.subgroupOf H) ≃* L := subgroupOfEquivOfLe hLH
  let b : B ≃* L := subgroupOfEquivOfLe L.le_normalizer
  have ht : (⊤ : Subgroup L).IsCComponent := by
    simpa only [subgroupOf_self,map_top_of_surjective a.toMonoidHom a.surjective]
      using (hd.2.1.subgroupOf le_rfl).map_equiv a
  have htB : (⊤ : Subgroup B).IsCComponent := by
    simpa only [map_top_of_surjective b.symm.toMonoidHom b.symm.surjective]
      using ht.map_equiv b.symm
  let : B.Normal := (normal_subgroupOf_iff_le_normalizer L.le_normalizer).mpr le_rfl
  have hB : B.IsCComponent := by
    simpa only [←MonoidHom.range_eq_map,range_subtype]
      using htB.map_subtype (inferInstance : B.Normal).isSubnormal
  have hne : K ≠ B := fun he => hout (he ▸ comap_mono hLH)
  have hz := reciprocal_coreQuotient_center_eq_bot hH hd
  let : IsSimpleGroup ((L ⧸ pCore 2 L) ⧸ center (L ⧸ pCore 2 L)) := IsQuasisimple.simple
  let : IsSimpleGroup (L ⧸ pCore 2 L) :=
    ((QuotientGroup.quotientMulEquivOfEq hz).trans QuotientGroup.quotientBot).symm.isSimpleGroup
  obtain ⟨p,hp,ho,_,hdiv⟩ := Perfect.exists_odd_prime_ne_dvd_card (L ⧸ pCore 2 L) Nat.prime_two
  let : Fact p.Prime := ⟨hp⟩
  let : Group.IsPerfect (⊤ : Subgroup L) := ht.perfect
  let : Group.IsPerfect L := Group.IsPerfect.ofSurjective
    (f := (topEquiv : (⊤ : Subgroup L) ≃* L).toMonoidHom) topEquiv.surjective
  let : Group.IsPerfect (conjugateSpanBy L H) := conjugateSpanBy_isPerfect L H
  let x := subgroupOfEquivOfLe (hd.2.2.2.2.1.trans inf_le_right)
  let : Group.IsPerfect X := Group.IsPerfect.ofSurjective
    (f := x.symm.toMonoidHom) x.symm.surjective
  have hperfect : IsPPerfect 2 L := by
    intro N hN hquot
    let := hN
    have hs : Subsingleton (L ⧸ N) := by
      by_contra! hn
      exact Group.IsPerfect.not_isNilpotent (L ⧸ N) hquot.isNilpotent
    apply eq_top_iff.mpr
    intro l _
    exact (QuotientGroup.eq_one_iff l).mp (Subsingleton.elim _ _)
  have hpL := primeToResidual_eq_top_of_simple_quotient p 2 (pCore 2 L)
    pCore_isPGroup hperfect hdiv
  have hpX : primeToResidual p X = ⊤ := by
    have hh := map_primeToResidual (p := p) x.symm
    rw [primeToResidual_span_eq_top p L H hpL,
      map_top_of_surjective x.symm.toMonoidHom x.symm.surjective] at hh
    exact hh.symm
  have hpB : p ∣ Nat.card B := by
    rw [Nat.card_congr b.toEquiv]
    exact hdiv.trans (card_dvd_of_surjective (QuotientGroup.mk' (pCore 2 L))
      (QuotientGroup.mk'_surjective _))
  exact normal_component_of_moved_prime_generated_span hM B K X hB hK hne ho hpB hpX hmoved

/-- The same ambient witnesses with the actual outside component normal in M. -/
@[expose] def ReciprocalNormalCase (L V A : Subgroup G) : Prop :=
  ∃ J H W : Subgroup G, Witness L V A J H W ∧
    ((generalizedFitting (H ⧸ pCore 2 H)).comap
      (QuotientGroup.mk' (pCore 2 H)) ≤ (normalizer (L : Set G)).subgroupOf H →
      ReciprocalData L H ∧
      twoFittingCore (normalizer (L : Set G)) ≤ H.subgroupOf (normalizer (L : Set G)) ∧
      center (L ⧸ pCore 2 L) = ⊥ ∧
      ∃ K : Subgroup (normalizer (L : Set G)),
        K.IsCComponent ∧ IsQuasisimple (K ⧸ pCore 2 K) ∧
        generalizedFitting K = pCore 2 K ∧ ¬ K ≤ H.subgroupOf (normalizer (L : Set G)) ∧
        (¬ ⁅(conjugateSpanBy L H).subgroupOf (normalizer (L : Set G)),K⁆ ≤
          pCore 2 (normalizer (L : Set G))) ∧ K.Normal ∧
        ∀ p : ℕ, p.Prime → Odd p → p ∣ Nat.card L → primeRank p K ≤ 1)

/-- The original fixed residual gives normality, rather than assuming it as
an extra input for the subsequent C.2.7 application. -/
theorem reciprocal_normal_case_of_not_unique {T : Sylow 2 G} {L V : Subgroup G}
    (h : Chapter12.Section02.Hypothesis1221 KnownSimple.IsKnownSimple T L)
    (D : Chapter12.Section02.ChosenModule T L V)
    (hM : UniqueMaximalOvergroup (L ⊔ (T : Subgroup G)) (normalizer (L : Set G)))
    (A : Subgroup G) (hAN : A ≤ normalizer (L : Set G))
    (hcomm : ⁅A,L⁆ ≤ L.pCoreIn 2) (ho : Odd (Nat.card A))
    (hAV : A ≤ centralizer (V : Set G))
    (hnot : ¬ UniqueMaximalOvergroup (Section04.oddActorResidual L A) (normalizer (L : Set G))) :
    ReciprocalNormalCase L V A := by
  obtain ⟨J,H,W,hw,hr⟩ := reciprocal_rank_case_of_not_unique h D hM A hAN hcomm ho hAV hnot
  refine ⟨J,H,W,hw,?_⟩
  intro hf
  obtain ⟨hd,hfit,hz,K,hK,hq,hfK,hout,hmoved,hrank⟩ := hr hf
  let := h.quasisimple
  let := hq
  exact ⟨hd,hfit,hz,K,hK,hq,hfK,hout,hmoved,
    reciprocal_component_normal hw.2.2.2.2.2.2.1.sqtk
      (h.simpleQTKE.twoLocal_sqtk hM.1.1) hd K hK hout hmoved,hrank⟩

