omit [Finite G] in
/-- The proved normality supplies the literal reversed C.2.7 source input;
normality is in M=N_G(L), and the component is mapped by M's inclusion. -/
theorem reciprocal_source_input {L H : Subgroup G} (hd : ReciprocalData L H)
    (K : Subgroup (normalizer (L : Set G))) (hK : K.IsCComponent)
    [IsQuasisimple (K ⧸ pCore 2 K)] [K.Normal]
    (hfK : generalizedFitting K = pCore 2 K)
    (hout : ¬ K ≤ H.subgroupOf (normalizer (L : Set G))) :
    Input KnownSimple.IsKnownSimple (normalizer (L : Set G)) (H.pCoreIn 2)
      (H ⊓ normalizer (L : Set G)) (K.map (normalizer (L : Set G)).subtype) := by
  let M := normalizer (L : Set G)
  let B := K.map M.subtype
  let e : K ≃* B := K.equivMapOfInjective M.subtype M.subtype_injective
  have hB : B.subgroupOf M = K := K.comap_map_eq_self_of_injective M.subtype_injective
  have hqB : IsQuasisimple (B ⧸ pCore 2 B) :=
    IsQuasisimple.of_mulEquiv (QuotientGroup.congr _ _ e (pCore_map_iso 2 e))
  have hfB : generalizedFitting B = pCore 2 B := by
    rw [←map_generalizedFitting_equiv e,hfK,pCore_map_iso]
  obtain ⟨_,_,_,_,_,_,_,hs,_,_⟩ := hd
  refine ⟨hs,⟨map_subtype_le _,hB.symm ▸ hK⟩,hqB,hfB,?_,?_⟩
  · intro hh
    exact hout (fun k hk => (hh (mem_map_of_mem M.subtype hk)).1)
  · have hn : M ≤ normalizer (B : Set G) := by
      have hh := K.le_normalizer_map M.subtype
      simpa only [normalizer_eq_top,←MonoidHom.range_eq_map,range_subtype] using hh
    exact hs.radical_le.trans hn

/-- The genuine kernel, offender and complete group-model conclusions of
C.2.7 apply to the unchanged reversed component and radical. -/
theorem reciprocal_source_conclusions {L H : Subgroup G} (hd : ReciprocalData L H)
    (K : Subgroup (normalizer (L : Set G))) (hK : K.IsCComponent)
    [IsQuasisimple (K ⧸ pCore 2 K)] [K.Normal]
    (hfK : generalizedFitting K = pCore 2 K)
    (hout : ¬ K ≤ H.subgroupOf (normalizer (L : Set G))) :
    let B := K.map (normalizer (L : Set G)).subtype
    KernelConclusion B (H.pCoreIn 2) ∧ OffenderConclusion B (H.pCoreIn 2) ∧
      ChapterC.C27Source.StarModels.Model (starImage B (H.pCoreIn 2) B) := by
  have hi := reciprocal_source_input hd K hK hfK hout
  exact ⟨(ChapterC.C27Source.kernel_offender_from_source hi).1,
    (ChapterC.C27Source.kernel_offender_from_source hi).2,
    ChapterC.C27Source.star_model_from_source hi⟩

