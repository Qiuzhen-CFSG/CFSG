module
public import CFSG.Quasithin.Chapter4.Section02.Unitary.FundamentalHypothesis
public import Theory.GroupTheory.PResidual.SubnormalCoreAction
public import CFSG.Quasithin.ChapterA.Section04.Signalizers.NormalizerAction
import Mathlib.Tactic
/-!
# The full module in the original pushing-up argument

The module in 4.2.4 and C.2.8 is the commutator of the actor with the
omega-one center of a Sylow section centralizer. The chosen irreducible
module embeds in it after actual section-centralizer conjugation. This
proves nontriviality while retaining the marking needed by the unitary row;
it does not identify the chosen module with the full module prematurely.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*,
4.2.1–4.2.4 and Hypothesis C.2.8.
-/
@[expose] public section
namespace CFSG.Quasithin.Chapter4.Section02.Unitary
open Subgroup Stellmacher
open scoped Pointwise
variable {G : Type*} [Group G] [Finite G]

/-- The full module used in4.2.4 and C.2.8, prior to any exceptional row. -/
noncomputable def fullModule (L Rplus : Subgroup G) : Subgroup G := ⁅omegaOneCenterAmbient Rplus,L⁆

omit [Finite G] in
/-- The full module uses the same literal embeddings under conjugation. -/
theorem fullModule_map (L Rplus : Subgroup G) (e : G ≃* G) :
    (fullModule L Rplus).map e.toMonoidHom =
      fullModule (L.map e.toMonoidHom) (Rplus.map e.toMonoidHom) := by
  rw [fullModule,fullModule,map_commutator,omegaOneCenterAmbient_map_injective _ e.injective]

omit [Finite G] in
private theorem omega_normalized (R : Subgroup G) :
    normalizer (R : Set G) ≤ normalizer (omegaOneCenterAmbient R : Set G) := by
  intro g hg
  apply mem_normalizer_iff_map_conj_eq.mpr
  rw [← omegaOneCenterAmbient_map_injective _ (MulAut.conj g).injective,
    mem_normalizer_iff_map_conj_eq.mp hg]

omit [Finite G] in
/-- Every source Sylow section centralizer is normalized by the actual actor. -/
theorem sectionSylow_normalized {M L : Subgroup G}
    (hLM : L ≤ M) (hLN : (L.subgroupOf M).Normal) (hL : IsPPerfect 2 L)
    (S : Sylow 2 (sectionCentralizerIn M L)) :
    L ≤ normalizer ((S : Subgroup (sectionCentralizerIn M L)).map
      (sectionCentralizerIn M L).subtype : Set G) := by
  let R := (S : Subgroup (sectionCentralizerIn M L)).map (sectionCentralizerIn M L).subtype
  have hs : ∃ S' : Sylow 2 (ChapterA.Section04.twoSectionCentralizer L M),
      (S' : Subgroup (ChapterA.Section04.twoSectionCentralizer L M)).map
        (ChapterA.Section04.twoSectionCentralizer L M).subtype = R := by
    rw [← sectionCentralizerIn_eq_twoSectionCentralizer]
    exact ⟨S,rfl⟩
  exact ((ChapterA.Section04.isMaximalTwoSignalizer_iff _ _ _).mp
    ((ChapterA.Section04.maximal_signalizer_iff_sylow L M R hLM hLN.isSubnormal hL).mpr hs)).1.normalizes

/-- The full module is elementary and generated by its actual L action. -/
theorem fullModule_data {L Rplus : Subgroup G}
    (hL : IsPPerfect 2 L) (hLR : L ≤ normalizer (Rplus : Set G)) :
    fullModule L Rplus ≤ omegaOneCenterAmbient Rplus ∧
      IsElementaryAbelian 2 (fullModule L Rplus) ∧
      fullModule L Rplus = ⁅fullModule L Rplus,L⁆ := by
  have hn := hLR.trans (omega_normalized Rplus)
  have hle : fullModule L Rplus ≤ omegaOneCenterAmbient Rplus :=
    le_normalizer_iff_commutator_le_left.mp hn
  let := omegaOneCenterAmbient_elementaryAbelian Rplus
  exact ⟨hle,IsElementaryAbelian.of_le hle,
    (commutator_isPPerfect_idempotent L (omegaOneCenterAmbient Rplus) hL
      (IsElementaryAbelian.isPGroup 2 _) hn).symm⟩

omit [Finite G] in
/-- The actual chosen module lies in the full module for the original
local core O2(LT). Only an inclusion is asserted. -/
theorem chosen_le_fullModule {T : Sylow 2 G} {L V : Subgroup G}
    (D : Chapter12.Section02.ChosenModule T L V) :
    V ≤ fullModule L ((L ⊔ (T : Subgroup G)).pCoreIn 2) := by
  let := D.elementary
  have hVO : V ≤ omegaOneCenterAmbient ((L ⊔ (T : Subgroup G)).pCoreIn 2) := by
    intro v hv
    apply (mem_omegaOneCenterAmbient_iff _ v).mpr
    refine ⟨D.le_core hv,?_,?_⟩
    · exact elemPow_eq_one_of_isElementaryAbelian (p := 2) v hv
    · intro q hq
      exact (mem_centralizer_iff.mp (D.core_centralizes hq) v hv).symm
  exact D.eq_commutator.trans_le (commutator_mono hVO le_rfl)

/-- Comparing any source Sylow section centralizer with O2(LT) transports
the original chosen module, not an unmarked module of equal dimension. -/
theorem exists_fullModule_comparison {K : GroupClass} {T : Sylow 2 G} {L V : Subgroup G}
    (h : Chapter12.Section02.Hypothesis1221 K T L)
    (D : Chapter12.Section02.ChosenModule T L V)
    (hM : UniqueMaximalOvergroup (L ⊔ (T : Subgroup G)) (normalizer (L : Set G)))
    (S : Sylow 2 (sectionCentralizerIn (normalizer (L : Set G)) L)) :
    ∃ c : sectionCentralizerIn (normalizer (L : Set G)) L,
      ((L ⊔ (T : Subgroup G)).pCoreIn 2).map (MulAut.conj (c : G)).toMonoidHom =
        (S : Subgroup (sectionCentralizerIn (normalizer (L : Set G)) L)).map
          (sectionCentralizerIn (normalizer (L : Set G)) L).subtype ∧
      V.map (MulAut.conj (c : G)).toMonoidHom ≤
        fullModule L ((S : Subgroup (sectionCentralizerIn (normalizer (L : Set G)) L)).map
          (sectionCentralizerIn (normalizer (L : Set G)) L).subtype) := by
  let C := sectionCentralizerIn (normalizer (L : Set G)) L
  have hyp := source_hypothesis411 h hM
  have hs := ChapterA.Section04.sylow_core_sectionCentralizer T L hyp.plus_perfect
    D.sylow_normalizes_component
  rw [← sectionCentralizerIn_eq_twoSectionCentralizer] at hs
  obtain ⟨S0,hS0⟩ := hs
  obtain ⟨c,hc⟩ := MulAction.exists_smul_eq C S0 S
  have hmap : ((L ⊔ (T : Subgroup G)).pCoreIn 2).map (MulAut.conj (c : G)).toMonoidHom =
      (S : Subgroup C).map C.subtype := by
    rw [← hS0,← hc]
    change ((S0 : Subgroup C).map C.subtype).map (MulAut.conj (c : G)).toMonoidHom =
      ((S0 : Subgroup C).map (MulAut.conj c).toMonoidHom).map C.subtype
    rw [map_map,map_map]
    rfl
  have hLc : L.map (MulAut.conj (c : G)).toMonoidHom = L :=
    mem_normalizer_iff_map_conj_eq.mp c.property.1
  refine ⟨c,hmap,?_⟩
  have hv := map_mono (f := (MulAut.conj (c : G)).toMonoidHom) (chosen_le_fullModule D)
  rwa [fullModule_map,hLc,hmap] at hv

/-- Nontriviality of the full source module follows from the original
Irr-plus choice and literal Sylow conjugation. -/
theorem fullModule_ne_bot_of_chosen {K : GroupClass} {T : Sylow 2 G} {L V : Subgroup G}
    (h : Chapter12.Section02.Hypothesis1221 K T L)
    (D : Chapter12.Section02.ChosenModule T L V)
    (hM : UniqueMaximalOvergroup (L ⊔ (T : Subgroup G)) (normalizer (L : Set G)))
    (S : Sylow 2 (sectionCentralizerIn (normalizer (L : Set G)) L)) :
    fullModule L ((S : Subgroup (sectionCentralizerIn (normalizer (L : Set G)) L)).map
      (sectionCentralizerIn (normalizer (L : Set G)) L).subtype) ≠ ⊥ := by
  obtain ⟨c,_,hV⟩ := exists_fullModule_comparison h D hM S
  intro he
  apply D.ne_bot
  exact (V.map_eq_bot_iff_of_injective (MulAut.conj (c : G)).injective).mp
    (bot_unique (he ▸ hV))
end CFSG.Quasithin.Chapter4.Section02.Unitary
