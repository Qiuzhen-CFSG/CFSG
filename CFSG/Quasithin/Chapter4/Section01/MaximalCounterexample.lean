module
public import CFSG.Quasithin.Chapter4.Section01.TerminalCalculations
public import CFSG.Quasithin.Chapter4.Section01.NormalizerUniqueness
public import Mathlib.Data.Set.Finite.Lemmas
import Mathlib.Tactic

/-!
# Selecting an actual maximal pushing-up counterexample

The literal cover modulo O2(L) supplies eta. Among the counterexamples above
it, maximize the order of the actual two-core. This produces mu-star while
preserving both comparisons in the source relation. Failure of uniqueness
then supplies an outside maximal two-local, which is genuinely SQTK under
the original simple QTKE hypothesis.

This is the selection step of4.2.13, not the C.4.8 classification of that
counterexample. Source: Aschbacher--Smith, printed pp.606,610--611.
-/

@[expose] public section
namespace CFSG.Quasithin.Chapter4
open Subgroup
open scoped Pointwise
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
/-- The actual two-core acts trivially on its component quotient. -/
theorem componentCore_le_sectionCentralizer {L M : Subgroup G} (hLM : L ≤ M) :
    L.pCoreIn 2 ≤ sectionCentralizerIn M L := by
  refine le_inf ((pCoreIn_le 2 L).trans hLM) ?_
  apply (le_sectionCentralizer_iff _ _).mpr
  refine ⟨(pCoreIn_le 2 L).trans L.le_normalizer, ?_⟩
  exact le_normalizer_iff_commutator_le_left.mp
    (L.le_normalizer.trans (normalizer_le_normalizer_characteristic_image L (pCore 2 L)))

/-- The source M-minus generated by I and the section centralizer. -/
def coveringOvergroup (M L I : Subgroup G) : Subgroup G := I ⊔ sectionCentralizerIn M L

omit [Finite G] in
/-- Construct eta from a literal cover modulo O2(L), as supplied by the
actual odd-actor residual in 4.4.5. -/
theorem coveringOvergroup_eta {L M I : Subgroup G} (hLM : L ≤ M)
    (hML : M ≤ normalizer (L : Set G)) (hIM : I ≤ M)
    (hcover : (L : Set G) ⊆ (I : Set G) * (L.pCoreIn 2 : Set G))
    (hcore : I.pCoreIn 2 ≠ ⊥) :
    coveringOvergroup M L I ∈ sigma M L ∧ I ∈ eta M L (coveringOvergroup M L I) := by
  have hC : sectionCentralizerIn M L ≤ M := inf_le_left
  have hLC : L ≤ coveringOvergroup M L I := by
    intro l hl
    obtain ⟨i,hi,q,hq,rfl⟩ := hcover hl
    exact mul_mem_sup hi (componentCore_le_sectionCentralizer hLM hq)
  have hn : I ≤ normalizer (sectionCentralizerIn M L : Set G) :=
    hIM.trans (sectionCentralizerIn_normalized hML)
  refine ⟨⟨sup_le hIM hC,sup_le hLC le_sup_right⟩,le_sup_left,?_,hcover,hcore⟩
  exact (coe_mul_of_left_le_normalizer_right I (sectionCentralizerIn M L) hn).symm

omit [Finite G] in
/-- The source comparison preserves the literal core and component intersection. -/
theorem PushLE.trans {L I J K : Subgroup G}
    (h : PushLE L I J) (h' : PushLE L J K) : PushLE L I K :=
  ⟨h.1.trans h'.1, h.2.trans h'.2⟩

/-- Maximize the order of the actual two-core above a given counterexample. -/
theorem exists_muStar_of_mu {M Mplus Mminus I : Subgroup G}
    (hI : I ∈ mu M Mplus Mminus) :
    ∃ J : Subgroup G, J ∈ muStar M Mplus Mminus ∧ PushLE Mplus I J := by
  classical
  let s : Set (Subgroup G) := {J | J ∈ mu M Mplus Mminus ∧ PushLE Mplus I J}
  have hn : s.Nonempty := ⟨I,hI,le_rfl,le_rfl⟩
  obtain ⟨J,hJ,hmax⟩ := Set.exists_max_image s
    (fun J => Nat.card (J.pCoreIn 2)) (Set.toFinite s) hn
  refine ⟨J,⟨hJ.1,?_⟩,hJ.2⟩
  intro K hK hJK hlt
  have hc := hmax K ⟨hK,hJ.2.trans hJK⟩
  exact hlt.ne (Subgroup.eq_of_le_of_card_ge hlt.le hc)

omit [Finite G] in
/-- Failure of literal maximal-two-local uniqueness is exactly an outside
counterexample once the covering subgroup is already in eta. -/
theorem mem_mu_of_eta_not_unique {M Mplus Mminus I : Subgroup G}
    (hM : IsMaximalTwoLocal M) (hminus : Mminus ≤ M)
    (hI : I ∈ eta M Mplus Mminus) (hnot : ¬ UniqueMaximalOvergroup I M) :
    I ∈ mu M Mplus Mminus := by
  refine ⟨hI,?_⟩
  by_contra hn
  exact hnot (uniqueMaximalOvergroup_of_no_outside hM (hI.1.trans hminus) hn)

/-- The first maximal-counterexample reduction in 4.2.13, including a genuine
maximal two-local H carrying the full SQTK hypothesis. -/
theorem maximal_counterexample_of_not_unique {κ : GroupClass} (hG : IsSimpleQTKE κ G)
    {M Mplus Mminus I : Subgroup G}
    (hM : IsMaximalTwoLocal M) (hminus : Mminus ≤ M)
    (hI : I ∈ eta M Mplus Mminus) (hnot : ¬ UniqueMaximalOvergroup I M) :
    ∃ J H : Subgroup G, J ∈ muStar M Mplus Mminus ∧ PushLE Mplus I J ∧
      IsMaximalTwoLocal H ∧ J ≤ H ∧ ¬ H ≤ M ∧ IsSQTK κ H := by
  obtain ⟨J,hJ,hIJ⟩ := exists_muStar_of_mu (mem_mu_of_eta_not_unique hM hminus hI hnot)
  obtain ⟨H,hH,hJH,hHM⟩ := exists_maximal_outside_of_mu hJ.1
  exact ⟨J,H,hJ,hIJ,hH,hJH,hHM,hG.twoLocal_sqtk hH.1⟩

/-- A contradiction for all actual maximal pushing-up counterexamples suffices
for the original eta member; no maximality premise remains on that member. -/
theorem unique_of_maximal_counterexamples {κ : GroupClass} (hG : IsSimpleQTKE κ G)
    {M Mplus Mminus I : Subgroup G}
    (hM : IsMaximalTwoLocal M) (hminus : Mminus ≤ M)
    (hI : I ∈ eta M Mplus Mminus)
    (hclosed : ∀ J H : Subgroup G, J ∈ muStar M Mplus Mminus → PushLE Mplus I J →
      IsMaximalTwoLocal H → J ≤ H → ¬ H ≤ M → IsSQTK κ H → False) :
    UniqueMaximalOvergroup I M := by
  by_contra hn
  obtain ⟨J,H,hJ,hIJ,hH,hJH,hHM,hSQ⟩ := maximal_counterexample_of_not_unique hG hM hminus hI hn
  exact hclosed J H hJ hIJ hH hJH hHM hSQ

/-- Literal 4.4.5-to-4.2.13 consumer: the residual cover supplies eta, and
failure of uniqueness produces a maximal counterexample with its genuine
SQTK overgroup. Nothing is assumed about the eventual classification row. -/
theorem maximal_counterexample_of_component_cover {κ : GroupClass}
    (hG : IsSimpleQTKE κ G) {M L I : Subgroup G}
    (hM : IsMaximalTwoLocal M) (hLM : L ≤ M)
    (hML : M ≤ normalizer (L : Set G)) (hIM : I ≤ M)
    (hcover : (L : Set G) ⊆ (I : Set G) * (L.pCoreIn 2 : Set G))
    (hcore : I.pCoreIn 2 ≠ ⊥) (hnot : ¬ UniqueMaximalOvergroup I M) :
    ∃ J H : Subgroup G,
      J ∈ muStar M L (coveringOvergroup M L I) ∧ PushLE L I J ∧
      IsMaximalTwoLocal H ∧ J ≤ H ∧ ¬ H ≤ M ∧ IsSQTK κ H := by
  obtain ⟨hs,heta⟩ := coveringOvergroup_eta hLM hML hIM hcover hcore
  exact maximal_counterexample_of_not_unique hG hM hs.1 heta hnot

end CFSG.Quasithin.Chapter4
