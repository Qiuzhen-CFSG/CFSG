module
public import CFSG.Quasithin.Chapter4.Section01.CharacteristicIntersection
public import Stellmacher.OmegaOneCenterMap
import Mathlib.Tactic
/-!
# The original module control in maximal pushing up

The proved core bounds and characteristic-two intersection put V inside
Z(O2(I)). For the full omega-center commutator, the Sylow-core normalizer
normalizes both factors and hence V;4.1.2 controls its ambient normalizer.
Finally the actual residual cover removes the centralizing core factor.
These discharge all three clauses of4.1.5 from the original4.1.1 hypotheses.
Source: Aschbacher--Smith, printed pp.607--608.
-/

public section
namespace CFSG.Quasithin.Chapter4
open Subgroup Stellmacher
variable {G : Type*} [Group G] [Finite G]

omit [Finite G] in
private theorem omega_normalized (R : Subgroup G) :
    normalizer (R : Set G) ≤ normalizer (omegaOneCenterAmbient R : Set G) := by
  intro g hg
  apply mem_normalizer_iff_map_conj_eq.mpr
  rw [← omegaOneCenterAmbient_map_injective _ (MulAut.conj g).injective,
    mem_normalizer_iff_map_conj_eq.mp hg]

omit [Finite G] in
private theorem omega_le_centralizer {R V : Subgroup G} (h : V ≤ omegaOneCenterAmbient R) :
    V ≤ centralizer (R : Set G) := by
  intro v hv r hr
  exact ((mem_omegaOneCenterAmbient_iff R v).mp (h hv)).2.2 r hr

/-- Full4.1.5(1), with all4.1.4 core/intersection premises discharged. -/
theorem lemma_4_1_5_1 {K : GroupClass} {T : Sylow 2 G}
    {M X Mminus I V : Subgroup G} (hyp : Hypothesis411 K T M X)
    (hminus : Mminus ∈ sigma M X) (hI : I ∈ muStar M X Mminus)
    (S : Sylow 2 (sectionCentralizerIn M X))
    (hR : I.pCoreIn 2 ≤ (S : Subgroup (sectionCentralizerIn M X)).map
      (sectionCentralizerIn M X).subtype)
    (hV : V ≤ omegaOneCenterAmbient ((S : Subgroup (sectionCentralizerIn M X)).map
      (sectionCentralizerIn M X).subtype)) :
    V ≤ (center (I.pCoreIn 2)).map (I.pCoreIn 2).subtype := by
  obtain ⟨H,hH,hIH,hout⟩ := exists_maximal_outside_of_mu hI.1
  have hh := Chapter1.mem_H_of_isTwoLocal hH.1
  have hc := (lemma_4_1_4_5 hyp hminus hI hh hIH hout).2.2
  have hVM : V ≤ M := by
    intro v hv
    exact ((map_subtype_le _).trans inf_le_left)
      (((mem_omegaOneCenterAmbient_iff _ v).mp (hV hv)).1)
  exact le_center_of_local_core_bounds hH hVM
    ((omega_le_centralizer hV).trans (centralizer_le hR))
    (hc.1.trans hc.2) hc.2 (intersection_mem_He_of_muStar hyp hminus hI hh hIH hout)

/-- Full4.1.5(2): the nontrivial full commutator module has its original
ambient normalizer inside M. No normalizer premise on V is retained. -/
theorem lemma_4_1_5_2 {K : GroupClass} {T : Sylow 2 G}
    {M X V : Subgroup G} (hyp : Hypothesis411 K T M X)
    (S : Sylow 2 (sectionCentralizerIn M X)) (hne : V ≠ ⊥)
    (hV : V ≤ omegaOneCenterAmbient ((S : Subgroup (sectionCentralizerIn M X)).map
      (sectionCentralizerIn M X).subtype))
    (heq : V = ⁅omegaOneCenterAmbient ((S : Subgroup (sectionCentralizerIn M X)).map
      (sectionCentralizerIn M X).subtype),X⁆) :
    normalizer (V : Set G) ≤ M := by
  let R := (S : Subgroup (sectionCentralizerIn M X)).map (sectionCentralizerIn M X).subtype
  have hp := (omegaOneCenterAmbient_elementaryAbelian R).isPGroup.to_le hV
  have hMX := (normal_subgroupOf_iff_le_normalizer hyp.plus_le).mp hyp.plus_normal
  have hNV : M ⊓ normalizer (R : Set G) ≤ normalizer (V : Set G) := by
    intro g hg
    rw [heq]
    apply mem_normalizer_iff_map_conj_eq.mpr
    rw [map_commutator,mem_normalizer_iff_map_conj_eq.mp (omega_normalized R hg.2),
      mem_normalizer_iff_map_conj_eq.mp (hMX hg.1)]
  exact normalizer_le_of_unique_maximalTwoLocal (lemma_4_1_2 hyp S).2.2 hp hne hNV

/-- Full4.1.5(3): the same module is generated by the actual residual
Hplus, with its source covering equality and core containment proved. -/
theorem lemma_4_1_5_3 {K : GroupClass} {T : Sylow 2 G}
    {M X Mminus I H V : Subgroup G} (hyp : Hypothesis411 K T M X)
    (hI : I ∈ eta M X Mminus) (hIH : I ≤ H)
    (S : Sylow 2 (sectionCentralizerIn M X))
    (hV : V ≤ omegaOneCenterAmbient ((S : Subgroup (sectionCentralizerIn M X)).map
      (sectionCentralizerIn M X).subtype)) (heq : V = ⁅V,X⁆) :
    V = ⁅V,(pResidual 2 (X ⊓ H : Subgroup G)).map (X ⊓ H).subtype⁆ := by
  have hXQ : X.pCoreIn 2 ≤ (S : Subgroup (sectionCentralizerIn M X)).map
      (sectionCentralizerIn M X).subtype := by
    apply (le_pCoreIn_of_normalizes (isPGroup_pCoreIn 2 X)
      (componentCore_le_sectionCentralizer hyp.plus_le) ?_).trans
      (pCoreIn_le_sylow _ S)
    exact ((le_sectionCentralizer_iff (sectionCentralizerIn M X) X).mp inf_le_right).1.trans
      (normalizer_le_normalizer_characteristic_image X (pCore 2 X))
  exact commutator_eq_of_residual_cover (lemma_4_1_4_3 hyp hI hIH).1
    hXQ (omega_le_centralizer hV) heq
end CFSG.Quasithin.Chapter4
