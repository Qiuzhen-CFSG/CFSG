module
public import CFSG.Quasithin.Chapter4.Section01.NormalizerStep
import Mathlib.Tactic
/-!
# Characteristic-normalizer control from maximal pushing up

Apply the common Sylow normalizer-growth step inside N_{Mminus}(R).
If its Sylow grows R, maximality gives a uniqueness subgroup that normalizes R;
otherwise R was already Sylow in the full section centralizer and4.1.2 applies.
Both cases control all nontrivial characteristic-subgroup normalizers of R.
The same growth inside an actual outside overgroup contradicts mu-star directly,
forcing R to be Sylow in its X-section centralizer.
Source: Aschbacher--Smith,4.1.4(2),(4), printed p.607.
-/

public section
namespace CFSG.Quasithin.Chapter4
open Subgroup
open scoped Pointwise
variable {G : Type*} [Group G] [Finite G]

/-- The full source C(G,R), generated by all nontrivial characteristic
normalizers of R=O2(I), is contained in M. -/
theorem lemma_4_1_4_2 {K : GroupClass} {T : Sylow 2 G}
    {M X Mminus I : Subgroup G} (hyp : Hypothesis411 K T M X)
    (hminus : Mminus ∈ sigma M X) (hI : I ∈ muStar M X Mminus) :
    (I.pCoreIn 2).characteristicNormalizerClosure ≤ M := by
  let R := I.pCoreIn 2
  let A := Mminus ⊓ normalizer (R : Set G)
  let C := sectionCentralizerIn M X
  let D := sectionCentralizerIn A X
  let S : Sylow 2 D := Sylow.nonempty.some
  let R1 := (S : Subgroup D).map D.subtype
  have hMX := (normal_subgroupOf_iff_le_normalizer hyp.plus_le).mp hyp.plus_normal
  have hRC : R ≤ C := lemma_4_1_4_1 hyp hminus hI
  have hIA : I ≤ A := le_inf hI.1.1.1 (I.le_normalizer.trans
    (normalizer_le_normalizer_characteristic_image I (pCore 2 I)))
  obtain ⟨heta,hrel,hRR1,hRcore⟩ := sectionSylow_normalizer_eta hMX hminus.1
    hI.1.1 hIA inf_le_left inf_le_right hRC S
  by_cases he : R1 = R
  · have hDC : D ≤ C := le_inf ((inf_le_left.trans inf_le_left).trans hminus.1) inf_le_right
    have hNC : C ⊓ normalizer (R : Set G) ≤ D := by
      intro x hx
      exact ⟨⟨(le_sup_right.trans hminus.2) hx.1,hx.2⟩,hx.1.2⟩
    obtain ⟨U,hU⟩ := exists_sylow_eq_of_relative_normalizer_le ⟨S,he⟩ hDC hNC
    have hu := lemma_4_1_2 hyp U
    rw [hU] at hu
    exact characteristicNormalizerClosure_le_of_unique_maximalTwoLocal hu.2.2
      (isPGroup_pCoreIn 2 I) inf_le_right
  · have hlt : R < (A ⊓ normalizer (R1 : Set G)).pCoreIn 2 :=
      lt_of_lt_of_le (lt_of_le_of_ne hRR1 (Ne.symm he)) hRcore
    have hu := uniqueMaximalOvergroup_of_no_outside hyp.maximal
      (heta.1.trans hminus.1) (no_outside_of_muStar hI heta hrel hlt)
    exact characteristicNormalizerClosure_le_of_unique_maximalTwoLocal hu.2.2
      (isPGroup_pCoreIn 2 I) (inf_le_left.trans inf_le_right)

/-- Inside an actual outside overgroup the maximal-core condition forces
the literal R to be Sylow in the original X-section centralizer. -/
theorem core_sylow_sectionCentralizer_outside {K : GroupClass} {T : Sylow 2 G}
    {M X Mminus I H : Subgroup G} (hyp : Hypothesis411 K T M X)
    (hminus : Mminus ∈ sigma M X) (hI : I ∈ muStar M X Mminus)
    (hH : H ∈ Chapter1.H G) (hIH : I ≤ H) (hout : ¬ H ≤ M) :
    ∃ S : Sylow 2 (sectionCentralizerIn (H ⊓ M) X),
      (S : Subgroup (sectionCentralizerIn (H ⊓ M) X)).map
        (sectionCentralizerIn (H ⊓ M) X).subtype = I.pCoreIn 2 := by
  let R := I.pCoreIn 2
  let A := (H ⊓ Mminus) ⊓ normalizer (R : Set G)
  let C := sectionCentralizerIn (H ⊓ M) X
  let D := sectionCentralizerIn A X
  let S : Sylow 2 D := Sylow.nonempty.some
  let R1 := (S : Subgroup D).map D.subtype
  have hMX := (normal_subgroupOf_iff_le_normalizer hyp.plus_le).mp hyp.plus_normal
  have hRC := lemma_4_1_4_1 hyp hminus hI
  have hIA : I ≤ A := le_inf (le_inf hIH hI.1.1.1) (I.le_normalizer.trans
    (normalizer_le_normalizer_characteristic_image I (pCore 2 I)))
  obtain ⟨heta,hrel,hRR1,hRcore⟩ := sectionSylow_normalizer_eta hMX hminus.1
    hI.1.1 hIA (inf_le_left.trans inf_le_right) inf_le_right hRC S
  have he : R1 = R := by
    by_contra hn
    have hmu : A ⊓ normalizer (R1 : Set G) ∈ mu M X Mminus :=
      ⟨heta,H,⟨hH,inf_le_left.trans (inf_le_left.trans inf_le_left)⟩,hout⟩
    exact hI.2 _ hmu hrel (lt_of_lt_of_le (lt_of_le_of_ne hRR1 (Ne.symm hn)) hRcore)
  have hDC : D ≤ C := by
    intro x hx
    exact ⟨⟨hx.1.1.1,hminus.1 hx.1.1.2⟩,hx.2⟩
  have hNC : C ⊓ normalizer (R : Set G) ≤ D := by
    intro x hx
    exact ⟨⟨⟨hx.1.1.1,(le_sup_right.trans hminus.2) ⟨hx.1.1.2,hx.1.2⟩⟩,hx.2⟩,hx.1.2⟩
  exact exists_sylow_eq_of_relative_normalizer_le ⟨S,he⟩ hDC hNC
end CFSG.Quasithin.Chapter4
