module

public import CFSG.Quasithin.ChapterK.Section01To04.Alternating.NaturalOffenders.Transport
public import CFSG.Quasithin.ChapterB.Section03.Offenders.Odd
public import Theory.Representation.BinaryOffender.RatioFromStrong

/-!
# The symmetric-five endpoint of the orthogonal branch

The odd-degree permutation calculation gives precisely the conjugates of
the groups generated by one or two disjoint transpositions. Their conjugates
generate S₅, and the absence of strong offenders gives quadratic ratio one.
An actual action equivalence transports all three conclusions to the original
group and representation, including the literal offender-generated subgroup.

Source: Aschbacher–Smith, B.3.2(4), B.4.2(5), and K.3.1.2,
printed pp.84, 86 and 454.
-/

@[expose] public section
namespace CFSG.Quasithin.ChapterK.RankOne.FivePoint
open BinaryPermutation Representation Representation.BinaryOffender
open ChapterB.Offenders ChapterB.QuasisimpleSource

/-- The five-point binary natural module has quadratic ratio one. -/
theorem symmetric_quadraticRatio : quadraticRatio (naturalRepresentation (Fin 5)) = 1 :=
  quadraticRatio_eq_one_of_no_strong _
    ⟨_, (Odd.isOffender_disjointTranspositions (Or.inl rfl) (m := 1)
      (by decide) (by decide)).2.2.2⟩
    (Odd.not_isStrongOffender_natural (Or.inl rfl))

/-- All of S₅ is generated by the actual best offenders. -/
theorem symmetric_offenderSubgroup : offenderSubgroup (naturalRepresentation (Fin 5)) = ⊤ := by
  let N := offenderSubgroup (naturalRepresentation (Fin 5))
  let : N.Normal := offenderSubgroup_normal _
  have hbest := (Odd.isBestOffender_natural_iff_caseAFamily (Or.inl rfl) _).mpr
    (caseAFamily_disjointTranspositions (n := 5) (m := 1) (by decide) (by decide))
  apply top_unique
  rw [← Equiv.Perm.closure_isSwap]
  apply (Subgroup.closure_le _).mpr
  rintro g ⟨a, b, hab, rfl⟩
  have ht : pairSwap 5 0 ∈ N :=
    hbest.le_offenderSubgroup _ (pairSwap_mem 0 (by decide))
  have hc : IsConj (pairSwap 5 0) (Equiv.swap a b) :=
    Equiv.Perm.isConj_swap (by decide) hab
  obtain ⟨c, hc⟩ := isConj_iff.mp hc
  exact hc ▸ Subgroup.Normal.conj_mem (inferInstance : N.Normal) _ ht c

private theorem conjugate_pairSwap (g : Equiv.Perm (Fin 5)) (i : Fin (5 / 2)) :
    ((MulAut.conj g) (pairSwap 5 i)).IsSwap := by
  let a : Fin 5 := ⟨2 * i.val, by omega⟩
  let b : Fin 5 := ⟨2 * i.val + 1, by omega⟩
  refine ⟨g a, g b, ?_, ?_⟩
  · apply g.injective.ne
    intro he
    have := congrArg Fin.val he
    dsimp [a, b] at this
    omega
  · exact Equiv.symm_trans_swap_trans a b g

private theorem symmetric_generated_by_swaps {A : Subgroup (Equiv.Perm (Fin 5))}
    (hA : IsBestOffender (naturalRepresentation (Fin 5)) A) :
    A = Subgroup.closure {a | a ∈ A ∧ a.IsSwap} := by
  refine le_antisymm ?_ ((Subgroup.closure_le _).mpr fun _ ha => ha.1)
  obtain ⟨m, _, _, g, rfl⟩ :=
    (Odd.isBestOffender_natural_iff_caseAFamily (Or.inl rfl) A).mp hA
  apply Subgroup.map_le_iff_le_comap.mpr
  apply (Subgroup.closure_le _).mpr
  rintro _ ⟨i, hi, rfl⟩
  apply Subgroup.subset_closure
  exact ⟨⟨pairSwap 5 i, pairSwap_mem i hi, rfl⟩, conjugate_pairSwap g i⟩

variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  {ρ : Representation (ZMod 2) G V}

/-- B.3.2(4) on the original actor: best offenders are exactly the mapped
conjugates of the one- and two-transposition groups. -/
theorem bestOffender_iff (e : ActionEquiv ρ (naturalRepresentation (Fin 5)))
    (A : Subgroup G) : IsBestOffender ρ A ↔
      CaseAFamily 5 (A.map e.groupEquiv.toMonoidHom) := by
  rw [← Odd.isBestOffender_natural_iff_caseAFamily (Or.inl rfl)]
  constructor
  · exact Alternating.NaturalOffenders.best_map e
  · intro h
    have ht := Alternating.NaturalOffenders.best_map
      (Alternating.NaturalOffenders.reverse e) h
    have hi : e.groupEquiv.symm.toMonoidHom.comp e.groupEquiv.toMonoidHom =
        MonoidHom.id G := by ext g; exact e.groupEquiv.symm_apply_apply g
    simpa only [Alternating.NaturalOffenders.reverse, Subgroup.map_map, hi,
      Subgroup.map_id] using ht

/-- In the original group every best offender is generated by elements which
are transpositions under the actual action marking; its generators commute. -/
theorem generated_by_commuting_transpositions
    (e : ActionEquiv ρ (naturalRepresentation (Fin 5)))
    {A : Subgroup G} (hA : IsBestOffender ρ A) :
    A = Subgroup.closure {a | a ∈ A ∧ (e.groupEquiv a).IsSwap} ∧
      ∀ a ∈ A, ∀ b ∈ A, Commute a b := by
  constructor
  · apply Subgroup.map_injective (f := e.groupEquiv.toMonoidHom) e.groupEquiv.injective
    rw [MonoidHom.map_closure,
      symmetric_generated_by_swaps (Alternating.NaturalOffenders.best_map e hA)]
    congr 1
    ext p
    constructor
    · rintro ⟨⟨a, ha, rfl⟩, hp⟩
      exact ⟨a, ⟨ha, hp⟩, rfl⟩
    · rintro ⟨a, ⟨ha, hp⟩, rfl⟩
      exact ⟨⟨a, ha, rfl⟩, hp⟩
  · let : IsElementaryAbelian 2 A := hA.1.2
    intro a ha b hb
    exact setLike_mul_comm ha hb

/-- The S₅ part of B.4.2(5), with every clause on the original representation. -/
theorem symmetric_conclusion (e : ActionEquiv ρ (naturalRepresentation (Fin 5))) :
    quadraticRatio ρ = 1 ∧ offenderSubgroup ρ = ⊤ ∧
      (∀ A : Subgroup G, IsBestOffender ρ A ↔
        CaseAFamily 5 (A.map e.groupEquiv.toMonoidHom)) ∧
      ∀ A : Subgroup G, IsBestOffender ρ A →
        A = Subgroup.closure {a | a ∈ A ∧ (e.groupEquiv a).IsSwap} ∧
          ∀ a ∈ A, ∀ b ∈ A, Commute a b :=
  ⟨(Alternating.quadraticRatio_eq e).trans symmetric_quadraticRatio,
    Alternating.NaturalOffenders.generated_eq_top e symmetric_offenderSubgroup,
    bestOffender_iff e, fun _ => generated_by_commuting_transpositions e⟩

end CFSG.Quasithin.ChapterK.RankOne.FivePoint
