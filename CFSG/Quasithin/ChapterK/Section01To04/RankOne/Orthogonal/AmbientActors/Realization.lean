module

public import CFSG.Quasithin.ChapterK.Section01To04.RankOne.Orthogonal.AmbientActors.LayerGeometry
public import Theory.Representation.OrthogonalFourMinusRankOne.AmbientActions.ScalarCentralizer

/-!
# Realization of the pure outer involution on the Hermitian space

A pure half-degree field lift conjugates the marked SL₂ matrices entrywise.
Transporting its actual action through the given binary coordinates therefore
intertwines the Hermitian representation with its field twist. Scalar-centralizer
rigidity and the involution equation identify this transported action pointwise
with canonical conjugation, without assuming that it is already K-linear.

Consequently the actual lift acts as the trace transvection. Its moved set is
exactly the nonsingular K-line generated by the off-diagonal unit matrix and
has K-dimension one. The source application constructs such a lift from even
layer index, installing normality from the original source hypotheses. All
statements retain the given marked group equivalence and binary intertwiner,
and apply to every positive s, including s=1.

Source: Aschbacher–Smith, K.3.1.2, printed p.454 of `refs/quasithin.pdf`,
combined manuscript of 1 March 2004. Global actor placement and ratio assembly
belong to the ambient-classification consumer.
-/

@[expose] public noncomputable section
namespace CFSG.Quasithin.ChapterK.RankOne
open Representation
open Representation.OrthogonalFourMinus.FiniteModel
open Representation.OrthogonalFourMinus.HermitianEquiv
open Representation.OrthogonalFourMinus.RankOne
open Representation.OrthogonalFourMinus.RankOne.AmbientActions
variable {G V : Type*} [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  {s : ℕ} [NeZero s] {ρ : Representation (ZMod 2) G V} {L : Subgroup G}
local instance realizationFixedAlgebra : Algebra (ZMod 2) (fixedField s) := ZMod.algebra _ 2
local instance realizationBinarySpace : Module (ZMod 2) (Space s) :=
  Module.compHom (Space s) (algebraMap (ZMod 2) (fixedField s))
namespace OrthogonalModel
variable (M : OrthogonalModel s ρ L) [L.Normal]

/-- A pure field involution acts as canonical conjugation in the actual marked coordinates. -/
theorem coordinates_pure_involution {t : G} (ht2 : t ^ 2 = 1)
    (ht : M.ambientAut t = Theory.PSL2.fieldAut (conjugation s)) (v : V) :
    M.coordinates (ρ t v) = conjugationLinear s (M.coordinates v) := by
  let T : Space s →+ Space s := M.coordinates.toAddEquiv.toAddMonoidHom.comp
    ((ρ t).toAddMonoidHom.comp M.coordinates.symm.toAddEquiv.toAddMonoidHom)
  have hT2 : Function.Involutive T := by
    intro X
    change M.coordinates (ρ t (M.coordinates.symm
      (M.coordinates (ρ t (M.coordinates.symm X))))) = X
    rw [M.coordinates.symm_apply_apply, ← Module.End.mul_apply, ← map_mul,
      ← pow_two, ht2, map_one, Module.End.one_apply, M.coordinates.apply_symm_apply]
  have hT (A : Matrix.SpecialLinearGroup (Fin 2) (Field s)) (X : Space s) :
      T (action s A X) = action s
        (Matrix.SpecialLinearGroup.map (conjugation s).toRingHom A) (T X) := by
    have he := M.conjugate_modelEmbedding ht A
    have he' : t * M.modelEmbedding A =
        M.modelEmbedding (Theory.PSL2.sl2FieldAut (conjugation s) A) * t :=
      (mul_inv_eq_iff_eq_mul).mp he
    change M.coordinates (ρ t (M.coordinates.symm (action s A X))) = _
    have hi : M.coordinates.symm (action s A X) =
        ρ (M.modelEmbedding A) (M.coordinates.symm X) := by
      apply M.coordinates.injective
      rw [M.coordinates.apply_symm_apply, M.modelEmbedding_intertwines,
        M.coordinates.apply_symm_apply]
      rfl
    rw [hi, ← Module.End.mul_apply, ← map_mul, he', map_mul, Module.End.mul_apply,
      M.modelEmbedding_intertwines]
    rfl
  have he := involutive_field_lift_eq_conjugation s T hT2 hT (M.coordinates v)
  change M.coordinates (ρ t (M.coordinates.symm (M.coordinates v))) = _ at he
  rwa [M.coordinates.symm_apply_apply] at he

/-- The literal action in the marked coordinates is the specified K-transvection. -/
theorem coordinates_pure_involution_transvection {t : G} (ht2 : t ^ 2 = 1)
    (ht : M.ambientAut t = Theory.PSL2.fieldAut (conjugation s)) (v : V) :
    M.coordinates (ρ t v) =
      LinearEquiv.transvection (traceFunctional_movedVector s) (M.coordinates v) := by
  rw [M.coordinates_pure_involution ht2 ht, conjugationLinear_eq_transvection]

/-- The moved vectors of the actual lift have the canonical trace coordinates. -/
theorem coordinates_pure_involution_displacement {t : G} (ht2 : t ^ 2 = 1)
    (ht : M.ambientAut t = Theory.PSL2.fieldAut (conjugation s)) (v : V) :
    M.coordinates (ρ t v - v) = traceFunctional s (M.coordinates v) • movedVector s := by
  rw [map_sub, M.coordinates_pure_involution ht2 ht, conjugation_displacement]

/-- The actual moved set is a K-line, not merely a subspace containing it. -/
theorem coordinates_pure_involution_moved_range {t : G} (ht2 : t ^ 2 = 1)
    (ht : M.ambientAut t = Theory.PSL2.fieldAut (conjugation s)) :
    Set.range (fun v : V => M.coordinates (ρ t v - v)) =
      (Submodule.span (fixedField s) {movedVector s} : Set (Space s)) := by
  ext X
  constructor
  · rintro ⟨v, rfl⟩
    change M.coordinates (ρ t v - v) ∈ Submodule.span (fixedField s) {movedVector s}
    rw [M.coordinates_pure_involution_displacement ht2 ht]
    exact Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_singleton _))
  · intro hX
    obtain ⟨c, rfl⟩ := Submodule.mem_span_singleton.mp hX
    obtain ⟨Y, hY⟩ := traceFunctional_surjective s c
    refine ⟨M.coordinates.symm Y, ?_⟩
    change M.coordinates (ρ t (M.coordinates.symm Y) - M.coordinates.symm Y) = _
    rw [M.coordinates_pure_involution_displacement ht2 ht,
      M.coordinates.apply_symm_apply, hY]

/-- The moved space of the original action has K-dimension one. -/
theorem coordinates_pure_involution_moved_finrank {t : G} (ht2 : t ^ 2 = 1)
    (ht : M.ambientAut t = Theory.PSL2.fieldAut (conjugation s)) :
    Module.finrank (fixedField s)
      (Submodule.span (fixedField s)
        (Set.range (fun v : V => M.coordinates (ρ t v - v)))) = 1 := by
  rw [M.coordinates_pure_involution_moved_range ht2 ht, Submodule.span_eq]
  exact finrank_span_singleton (movedVector_ne_zero s)

/-- Every nonzero moved vector of the original involution is nonsingular. -/
theorem coordinates_pure_involution_moved_nonsingular {t : G} (ht2 : t ^ 2 = 1)
    (ht : M.ambientAut t = Theory.PSL2.fieldAut (conjugation s))
    {X : Space s} (hX : X ∈ Set.range (fun v : V => M.coordinates (ρ t v - v)))
    (hne : X ≠ 0) : form s X ≠ 0 := by
  apply moved_line_nonsingular s _ hne
  rw [conjugation_moved_range]
  rwa [M.coordinates_pure_involution_moved_range ht2 ht] at hX

end OrthogonalModel

/-- Even index supplies the actual outer involution and its pointwise realization,
with the marked group equivalence and binary intertwiner unchanged. -/
theorem SourceHypotheses.orthogonal_outer_realization [Finite G]
    (h : SourceHypotheses ρ L) (M : OrthogonalModel s ρ L) (heven : Even L.index) :
    let : L.Normal := h.layer_normal
    ∃ t : G, t ^ 2 = 1 ∧ t ∉ L ∧
      M.ambientAut t = Theory.PSL2.fieldAut (conjugation s) ∧
      (∀ v, M.coordinates (ρ t v) = conjugationLinear s (M.coordinates v)) ∧
      (∀ v, M.coordinates (ρ t v) =
        LinearEquiv.transvection (traceFunctional_movedVector s) (M.coordinates v)) ∧
      Set.range (fun v : V => M.coordinates (ρ t v - v)) =
        (Submodule.span (fixedField s) {movedVector s} : Set (Space s)) ∧
      (∀ X ∈ Set.range (fun v : V => M.coordinates (ρ t v - v)),
        X ≠ 0 → form s X ≠ 0) := by
  let : L.Normal := h.layer_normal
  obtain ⟨t, ht2, htL, ht⟩ := M.exists_outer_involution h heven
  exact ⟨t, ht2, htL, ht, M.coordinates_pure_involution ht2 ht,
    M.coordinates_pure_involution_transvection ht2 ht,
    M.coordinates_pure_involution_moved_range ht2 ht,
    fun _ hX hne => M.coordinates_pure_involution_moved_nonsingular ht2 ht hX hne⟩

end CFSG.Quasithin.ChapterK.RankOne
