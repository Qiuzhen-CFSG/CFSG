module

public import CFSG.Quasithin.ChapterK.Section01To04.RankOne.Source
public import CFSG.Quasithin.ChapterK.Section01To04.RankOne.Natural
public import Theory.SpecificGroups.PSL2.AutomorphismModel
public import Theory.GroupTheory.GeneralizedFitting.ComponentCalculus
public import Theory.Representation.BinaryOffender.GeneratedCore

/-!
# Global generation by the natural SL₂ offenders

The subgroup generated by best offenders is normal, nontrivial and contained
in the natural layer. The actual SL₂ identification makes that layer
centerless; quasisimplicity therefore makes the generated subgroup the whole
layer. This applies the model calculations to the source's literal ambient
representation and discharges the global generation clause of B.4.2(1).

Source: Aschbacher–Smith, combined manuscript (1 March 2004), K.3.1.1,
printed p.454, and B.4.2(1), printed p.86. Recognition remains independent.
-/

public section
open Theory.GroupTheory Representation Representation.BinaryOffender
namespace CFSG.Quasithin.ChapterK.RankOne
universe u v
variable {G : Type u} {V : Type v} [Group G] [Finite G]
  [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
  {F : Type*} [Field F] [Finite F] [Algebra (ZMod 2) F]
  {ρ : Representation (ZMod 2) G V} {L : Subgroup G}

/-- The global best-offender subgroup in B.4.2(1) is the whole natural layer. -/
theorem SourceHypotheses.natural_offenderSubgroup_eq_layer
    (h : SourceHypotheses ρ L) (M : NaturalModel (F := F) ρ L)
    (hF : 2 < Nat.card F) : offenderSubgroup ρ = L := by
  let : L.Normal := h.layer_normal
  let : IsQuasisimple L := h.quasisimple
  let : CharP F 2 := charP_of_injective_algebraMap (algebraMap (ZMod 2) F).injective 2
  let J := offenderSubgroup ρ
  let : J.Normal := offenderSubgroup_normal ρ
  have hJL : J ≤ L := by
    apply iSup_le
    intro A
    apply iSup_le
    rintro ⟨hA, _⟩
    obtain ⟨P, hP⟩ := Representation.SL2NaturalOffenders.exists_sylow
      hF L M.groupEquiv M.coordinateAction (M.coordinateAction_injective h.faithful)
      M.coordinateAction_natural ((M.offender_iff A).mp (hA.isOffender ρ))
    exact hP ▸ Subgroup.map_subtype_le (P : Subgroup L)
  have hJne : J ≠ ⊥ := offenderSubgroup_ne_bot_of_ff ρ
    ((isFFModule_iff_quadraticRatio_le_one ρ).mpr
      (M.ratios_eq_one hF h.faithful).1.le)
  have hc : Subgroup.center L = ⊥ := by
    apply (Subgroup.center L).eq_bot_iff_forall.mpr
    intro x hx
    have he : M.groupEquiv x ∈
        Subgroup.center (Matrix.SpecialLinearGroup (Fin 2) F) := by
      apply Subgroup.mem_center_iff.mpr
      intro y
      obtain ⟨z, rfl⟩ := M.groupEquiv.surjective y
      simpa only [map_mul] using congrArg M.groupEquiv (Subgroup.mem_center_iff.mp hx z)
    have he1 : M.groupEquiv x = 1 := by
      simpa only [Theory.PSL2.sl2_center_eq_bot, Subgroup.mem_bot] using he
    exact M.groupEquiv.injective (he1.trans M.groupEquiv.map_one.symm)
  rcases IsQuasisimple.normal_le_center_or_eq_top (J.subgroupOf L) with hcentral | htop
  · exfalso
    apply hJne
    apply J.eq_bot_iff_forall.mpr
    intro x hx
    have hz := hcentral (show (⟨x, hJL hx⟩ : L) ∈ J.subgroupOf L from hx)
    have hx1 : (⟨x, hJL hx⟩ : L) = 1 := by simpa only [hc, Subgroup.mem_bot] using hz
    exact congrArg Subtype.val hx1
  · apply le_antisymm hJL
    intro x hx
    have hm : (⟨x, hx⟩ : L) ∈ J.subgroupOf L := htop.symm ▸ Subgroup.mem_top _
    exact hm

end CFSG.Quasithin.ChapterK.RankOne
