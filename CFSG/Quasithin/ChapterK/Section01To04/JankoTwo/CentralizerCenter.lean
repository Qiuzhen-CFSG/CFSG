module

public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.ExceptionalParabolics.FirstParabolic.IntrinsicStructure
public import Theory.SpecificGroups.LeechRelated.AtlasCarriers.J2.ExceptionalParabolics.SecondParabolic.SylowCenter
public import CFSG.Quasithin.ChapterK.Section01To04.JankoTwo.RootIntersection

/-!
# The actual 2-central J₂ centralizer has cyclic center

The checked five-point quotient is A₅, so a central element belongs to its
kernel, the actual radical. This radical lies in the checked Sylow subgroup,
whose center is the cyclic group generated by the specified involution.
Thus the center of the full involution centralizer is exactly that line.

The concluding application pulls an ambient root group back along any
injective embedding of this same degree-100 carrier. It supplies K.4.5's
literal root-intersection bound, with no arbitrary replacement group.
Source: Aschbacher–Smith, K.4.5, printed p.460.
-/

public section
namespace CFSG.Quasithin.ChapterK.JankoTwo
open Subgroup Sporadic.LeechRelated.J2
open Sporadic.LeechRelated.J2.GeneratorPair
open Sporadic.LeechRelated.J2.ExceptionalParabolics
open Sporadic.LeechRelated.J2.ExceptionalParabolics.Seed
open Sporadic.LeechRelated.J2.ExceptionalParabolics.FirstParabolic
open Sporadic.LeechRelated.J2.ExceptionalParabolics.FirstParabolic.QuotientActions

/-- The source's 2-central involution z is `FirstFusion.t`, not `GeneratorPair.a`. -/
theorem centralizer_center :
    (center (centralizer ({FirstFusion.t} : Set Carrier))).map
      (centralizer ({FirstFusion.t} : Set Carrier)).subtype = zpowers FirstFusion.t := by
  change (center l₁).map l₁.subtype = zpowers FirstFusion.t
  apply le_antisymm
  · rintro _ ⟨x, hx, rfl⟩
    change (x : Carrier) ∈ zpowers FirstFusion.t
    have hx' : (x : l₁) ∈ center l₁ := hx
    have him : innerAction (x : l₁) ∈ center (alternatingGroup (Fin 5)) := by
      apply mem_center_iff.mpr
      intro y
      obtain ⟨u, rfl⟩ := innerAction_surjective y
      rw [← map_mul, ← map_mul]
      exact congrArg innerAction (mem_center_iff.mp hx' u)
    have hker : (x : l₁) ∈ innerAction.ker := by
      rw [alternatingGroup.center_eq_bot (by simp), mem_bot] at him
      exact him
    rw [innerAction_ker card_radical] at hker
    have hxs : (x : Carrier) ∈ s := radical_le_s hker
    rw [← SecondParabolic.center_s]
    refine ⟨⟨x, hxs⟩, mem_center_iff.mpr ?_, rfl⟩
    intro y
    apply Subtype.ext
    exact congrArg (fun g : l₁ => (g : Carrier))
      (mem_center_iff.mp hx' ⟨y, SecondParabolic.s_le_l₁ y.property⟩)
  · apply zpowers_le.mpr
    refine ⟨⟨FirstFusion.t, mem_centralizer_singleton_iff.mpr rfl⟩,
      mem_center_iff.mpr ?_, rfl⟩
    intro x
    exact Subtype.ext (mem_centralizer_singleton_iff.mp x.property)

/-- The center calculation discharges the smaller-group premise of the
actual root-intersection argument. -/
theorem root_intersection_le_cyclic {M : Type*} [Group M]
    (f : Carrier →* M) (hf : Function.Injective f) (R : Subgroup M)
    (hR : R ≤ centralizer (centralizer ({f FirstFusion.t} : Set M) : Set M)) :
    R.comap f ≤ zpowers FirstFusion.t :=
  root_comap_le_zpowers f hf FirstFusion.t R hR centralizer_center.le

/-- For the actual ambient fixed-space root, the intersection is exactly
order two, rather than merely an abstract subgroup of that order. -/
theorem root_intersection_eq_cyclic {M U : Type*} [Group M]
    [AddCommGroup U] [Module (ZMod 2) U]
    (σ : Representation (ZMod 2) M U) (f : Carrier →* M)
    (hf : Function.Injective f) (R : Subgroup M)
    (hR : R ≤ centralizer (centralizer ({f FirstFusion.t} : Set M) : Set M))
    (hroot : Representation.BinaryOffender.subspaceKernel σ
      (Representation.BinaryOffender.fixedSpace σ (zpowers (f FirstFusion.t))) ⊤ = R) :
    R.comap f = zpowers FirstFusion.t := by
  apply root_comap_eq_zpowers f hf FirstFusion.t R hR centralizer_center.le
  rw [← hroot]
  refine ⟨mem_top _, ?_⟩
  intro v hv
  exact hv ⟨f FirstFusion.t, mem_zpowers _⟩

end CFSG.Quasithin.ChapterK.JankoTwo
