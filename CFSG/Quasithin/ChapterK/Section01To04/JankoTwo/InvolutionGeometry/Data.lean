def table (i : Fin 256) : Equiv.Perm (Fin 100) :=
  if i.val < 128 then sTable ⟨i.val % 128, Nat.mod_lt _ (by decide)⟩
  else sTable ⟨i.val % 128, Nat.mod_lt _ (by decide)⟩ * outerTable

def squareKeys (p : Equiv.Perm (Fin 100)) : Prop :=
  p (p 0) = 0 ∧ p (p 1) = 1 ∧ p (p 2) = 2

instance (p : Equiv.Perm (Fin 100)) : Decidable (squareKeys p) := inferInstanceAs
  (Decidable (_ ∧ _ ∧ _))

def commuteKeys (p q : Equiv.Perm (Fin 100)) : Prop :=
  p (q 0) = q (p 0) ∧ p (q 1) = q (p 1) ∧ p (q 2) = q (p 2)

instance (p q : Equiv.Perm (Fin 100)) : Decidable (commuteKeys p q) := inferInstanceAs
  (Decidable (_ ∧ _ ∧ _))

