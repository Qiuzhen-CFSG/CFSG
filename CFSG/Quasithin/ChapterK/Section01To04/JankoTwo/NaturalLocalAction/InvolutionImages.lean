/-!
# The images of the two marked J₂ involutions

For the literal degree-100 carrier and every injective marked embedding, the
involution `FirstFusion.t` is long-root and `GeneratorPair.a` is short-root.
The only additional inputs are four universal root-geometry clauses of B.4.6,
recorded explicitly in `B46RootFacts`; neither particular J₂ comparison is an
input. The Chapter K assembly must discharge this record from the earlier
universal G₂ theorem. This module proves the conditional
embedding comparison, not B.4.6 or the final K.4.5 module theorem.

Write w = abab⁻¹. The checked carrier relations give w¹² = 1, w⁴ ≠ 1 and
1 ≠ t = w⁶ = (w³)². In the short-root centralizer, the explicit C-coordinate
of a square vanishes. Thus t cannot be short-root. If a were long-root,
both four-groups generated by t and either a or bab⁻¹ would consist of
long-root elements: multiplication by t on either generator is conjugation
by w⁻³. B.4.6(11) fuses each group into the A–B root plane. The plane lies
in the two-core of the centralizer of each of its nonidentity elements,
using B.4.6(5) and the already proved local-core calculation. Consequently
both factors of w lie in O₂(C(t)), contradicting w¹² = 1 and w⁴ ≠ 1.

All cores are relative cores mapped into the actual octonion group. The
marked-module applications use `D.carrierEmbedding` directly and derive
finiteness of K from `D.fieldDegree`.

Source: Aschbacher–Smith, *The Classification of Quasithin Groups*, combined
1 March 2004 manuscript, K.4.5, printed p.460/PDF p.471; earlier root geometry
is B.4.6(5), (6), (11), printed pp.88–89/PDF pp.99–100. The code's `local₁`
(short-Weyl side) is the source's long-root centralizer, while `parabolic₂`
(long-Weyl side) is the source's P₁. Roots A and C retain the licensed ATLAS
port's long- and short-root conventions; see LICENSES/ATLAS.txt and
LICENSES/ATLAS-CITATION.cff. The existing carrier word relations use the retained
ATLAS `J2G1-p100B0` tables; the additional dihedral identities are proved
algebraically.
-/

public section

open Subgroup Atlas.G2 Atlas.G2.LieParabolicSetup
open Atlas.G2.EvenInvolutionGeometry Atlas.G2.PairStabilizer
open Atlas.G2.ShortRootProducts.CentralizerCore
open Theory.GroupTheory
open scoped MatrixGroups
namespace CFSG.Quasithin.ChapterK.JankoTwo.NaturalLocalAction.InvolutionImages
variable {K : Type*} [Field K] [CharP K 2]

/-- The universal parts of B.4.6 used in the embedding comparison.
These source inputs must be supplied independently of the J₂ embedding. -/
structure B46RootFacts (K : Type*) [Field K] [CharP K 2] : Prop where
  /-- B.4.6(5): the two classes exhaust the nonidentity involutions. -/
  involutions : ∀ x : Model K, x ^ 2 = 1 → x ≠ 1 →
    IsLongRootElement x ∨ IsShortRootElement x
  /-- B.4.6(5): the literal long-root centralizer on the short-Weyl side. -/
  longCentralizer : ∀ r : K, r ≠ 0 →
    centralizer ({rootA r} : Set (Model K)) = local₁
  /-- The containment in the long-Weyl parabolic furnished by B.4.6(6). -/
  shortCentralizer : ∀ r : K, r ≠ 0 →
    centralizer ({rootC r} : Set (Model K)) ≤ parabolic₂
  /-- B.4.6(11): an all-long-root subgroup is conjugate into the A–B plane. -/
  longFusion : ∀ B : Subgroup (Model K),
    (∀ x ∈ B, x ≠ 1 → IsLongRootElement x) →
    ∃ g : Model K, B.map (MulAut.conj g).toMonoidHom ≤ longRootLocal

private theorem rootC_ne_square (h : B46RootFacts K) {r : K} (hr : r ≠ 0)
    (x : Model K) : x ^ 2 ≠ rootC r := by
  intro he
  have hc : x ∈ centralizer ({rootC r} : Set (Model K)) := by
    rw [← he]
    exact mem_centralizer_singleton_iff.mpr (Commute.self_pow x 2).eq
  obtain ⟨p, c, M, rfl⟩ := parabolic_centralizer_factor r hr (h.shortCentralizer r hr hc) hc
  have hh := congrArg (fun g : Model K => g.val (Atlas.SplitOctonion.basisVector 7) 3) he
  simp [pow_two, longRootHom, rootA, rootB, rootC,
    Atlas.G2.Explicit.rootAEquiv, Atlas.G2.Explicit.rootBEquiv, Atlas.G2.Explicit.rootCEquiv,
    Atlas.G2.Explicit.rootALinear, Atlas.G2.Explicit.rootBLinear, Atlas.G2.Explicit.rootCLinear,
    Atlas.G2.Explicit.rootAApply, Atlas.G2.Explicit.rootBApply, Atlas.G2.Explicit.rootCApply,
    blockHom, blockEquiv, blockLinear, Atlas.SplitOctonion.basisVector,
    CharTwo.neg_eq, CharTwo.add_self_eq_zero] at hh
  exact hr hh.symm

private theorem short_ne_square (h : B46RootFacts K) {z : Model K}
    (hz : IsShortRootElement z) (x : Model K) : x ^ 2 ≠ z := by
  obtain ⟨g, r, hr, rfl⟩ := hz
  intro he
  apply rootC_ne_square h hr ((MulAut.conj g).symm x)
  have hh := congrArg (MulAut.conj g).symm he
  simpa only [map_pow, MulEquiv.symm_apply_apply] using hh

omit [CharP K 2] in
private theorem long_conj {z : Model K} (hz : IsLongRootElement z) (g : Model K) :
    IsLongRootElement (MulAut.conj g z) := by
  obtain ⟨k, r, hr, rfl⟩ := hz
  refine ⟨g * k, r, hr, ?_⟩
  rw [map_mul, MulAut.mul_apply]

omit [CharP K 2] in
private theorem plane_le_radical : longRootLocal (F := K) ≤ radical₁ := by
  rintro _ ⟨p, rfl⟩
  exact ⟨![p.toAdd.1, p.toAdd.2, 0, 0, 0, 0], rfl,
    by simp [unipotentProduct, longRootHom]⟩

private theorem plane_root_witness {z : Model K} (hz : z ∈ longRootLocal) (hne : z ≠ 1) :
    ∃ (g : Model K) (r : K), g ∈ normalizer (longRootLocal (F := K) : Set (Model K)) ∧
      r ≠ 0 ∧ z = MulAut.conj g (rootA r) := by
  obtain ⟨p, rfl⟩ := hz
  by_cases hb : p.toAdd.2 = 0
  · refine ⟨1, p.toAdd.1, one_mem _, ?_, ?_⟩
    · intro ha
      exact hne (by simp [longRootHom, ha, hb])
    · simp [longRootHom, hb]
  · refine ⟨rootE (p.toAdd.1 / p.toAdd.2) * weylR, p.toAdd.2, ?_, hb, ?_⟩
    · apply mul_mem _ weylR_mem_longRootNormalizer
      apply unipotent_le_longRootNormalizer
      simpa [unipotentProduct] using
        (unipotentProduct_mem ![0, 0, 0, 0, p.toAdd.1 / p.toAdd.2, 0])
    · rw [map_mul, MulAut.mul_apply,
        show MulAut.conj weylR (rootA p.toAdd.2) = rootB p.toAdd.2 from weylR_rootA _,
        ShortRootProducts.rootE_conjugate_rootB, div_mul_cancel₀ _ hb]
      rfl

private theorem plane_le_centralizer_core [Finite K] (h : B46RootFacts K)
    {z : Model K} (hz : z ∈ longRootLocal) (hne : z ≠ 1) :
    longRootLocal ≤ (centralizer ({z} : Set (Model K))).pCoreIn 2 := by
  obtain ⟨g, r, hg, hr, rfl⟩ := plane_root_witness hz hne
  rw [← map_centralizer_singleton (MulAut.conj g) (rootA r),
    ← map_pCoreIn_of_injective 2 _ _ (MulAut.conj g).injective,
    h.longCentralizer r hr, local₁_pCore]
  intro x hx
  refine ⟨(MulAut.conj g).symm x, plane_le_radical ?_, (MulAut.conj g).apply_symm_apply x⟩
  exact (mem_normalizer_iff''.mp hg x).mp hx

private theorem long_subgroup_le_centralizer_core [Finite K] (h : B46RootFacts K)
    (B : Subgroup (Model K)) (hB : ∀ x ∈ B, x ≠ 1 → IsLongRootElement x)
    {z : Model K} (hz : z ∈ B) (hne : z ≠ 1) :
    B ≤ (centralizer ({z} : Set (Model K))).pCoreIn 2 := by
  obtain ⟨g, hg⟩ := h.longFusion B hB
  have hn : MulAut.conj g z ≠ 1 := by simpa using hne
  have hle := plane_le_centralizer_core h (hg (mem_map_of_mem _ hz)) hn
  intro x hx
  have hm := hle (hg (mem_map_of_mem _ hx))
  change MulAut.conj g x ∈ (centralizer ({MulAut.conj g z} : Set (Model K))).pCoreIn 2 at hm
  rw [← map_centralizer_singleton (MulAut.conj g) z,
    ← map_pCoreIn_of_injective 2 _ _ (MulAut.conj g).injective] at hm
  obtain ⟨y, hy, he⟩ := hm
  exact (MulAut.conj g).injective he ▸ hy

namespace Native
open Sporadic.LeechRelated.J2 Sporadic.LeechRelated.J2.GeneratorPair

private def w : Sporadic.LeechRelated.J2.Carrier := a * b * a * b⁻¹
private def c : Sporadic.LeechRelated.J2.Carrier := MulAut.conj b a

private theorem w_eq : w = a * c := by simp [w, c, MulAut.conj_apply, mul_assoc]
private theorem c_sq : c ^ 2 = 1 := by rw [c, ← map_pow, a_pow_two, map_one]

private theorem reflection_geometry (s : Sporadic.LeechRelated.J2.Carrier)
    (hi : MulAut.conj s w = w⁻¹) :
    Commute s FirstFusion.t ∧
      s * FirstFusion.t = MulAut.conj ((w ^ 3)⁻¹) s := by
  have htinv : FirstFusion.t⁻¹ = FirstFusion.t :=
    inv_eq_of_mul_eq_one_left (by simpa only [pow_two] using FirstFusion.t_pow_two)
  have ht : MulAut.conj s FirstFusion.t = FirstFusion.t⁻¹ := by
    change MulAut.conj s (w ^ 6) = (w ^ 6)⁻¹
    rw [map_pow, hi, inv_pow]
  refine ⟨mul_inv_eq_iff_eq_mul.mp (ht.trans htinv), ?_⟩
  have hm : s * w ^ 3 = (w ^ 3)⁻¹ * s := by
    apply mul_inv_eq_iff_eq_mul.mp
    change MulAut.conj s (w ^ 3) = (w ^ 3)⁻¹
    rw [map_pow, hi, inv_pow]
  change s * w ^ 6 = (w ^ 3)⁻¹ * s * ((w ^ 3)⁻¹)⁻¹
  rw [inv_inv, ← hm, mul_assoc, ← pow_add]

private theorem word_geometry :
    Commute a FirstFusion.t ∧ Commute c FirstFusion.t ∧
    a * FirstFusion.t = MulAut.conj ((w ^ 3)⁻¹) a ∧
    c * FirstFusion.t = MulAut.conj ((w ^ 3)⁻¹) c := by
  have haa : a * a = 1 := by simpa only [pow_two] using a_pow_two
  have hcc : c * c = 1 := by simpa only [pow_two] using c_sq
  have hai : a⁻¹ = a := inv_eq_iff_mul_eq_one.mpr haa
  have hci : c⁻¹ = c := inv_eq_iff_mul_eq_one.mpr hcc
  have ha : MulAut.conj a w = w⁻¹ := by
    change a * w * a⁻¹ = w⁻¹
    rw [w_eq, mul_inv_rev, hai, hci, ← mul_assoc a a c, haa, one_mul]
  have hc : MulAut.conj c w = w⁻¹ := by
    change c * w * c⁻¹ = w⁻¹
    rw [w_eq, mul_inv_rev, hai, hci, mul_assoc c (a * c) c, mul_assoc a c c, hcc, mul_one]
  exact ⟨(reflection_geometry a ha).1, (reflection_geometry c hc).1,
    (reflection_geometry a ha).2, (reflection_geometry c hc).2⟩

variable [Finite K] (h : B46RootFacts K)
  (f : Sporadic.LeechRelated.J2.Carrier →* Model K) (hf : Function.Injective f)
include h hf

omit [Finite K] in
private theorem t_long : IsLongRootElement (f FirstFusion.t) := by
  have hne : f FirstFusion.t ≠ 1 := by
    intro he
    exact FirstFusion.t_ne_one (hf (he.trans (map_one f).symm))
  rcases h.involutions (f FirstFusion.t)
    (by rw [← map_pow, FirstFusion.t_pow_two, map_one]) hne with ht | ht
  · exact ht
  · exact False.elim (short_ne_square h ht (f (w ^ 3)) (by
      rw [← map_pow, ← pow_mul]
      rfl))

private theorem long_pair_core (x : Sporadic.LeechRelated.J2.Carrier)
    (hsq : x ^ 2 = 1) (hc : Commute x FirstFusion.t)
    (hxt : x * FirstFusion.t = MulAut.conj ((w ^ 3)⁻¹) x)
    (hx : IsLongRootElement (f x)) :
    f x ∈ (centralizer ({f FirstFusion.t} : Set (Model K))).pCoreIn 2 := by
  let B := closure ({f x, f FirstFusion.t} : Set (Model K))
  have ht : IsLongRootElement (f FirstFusion.t) := t_long h f hf
  have hxt' : IsLongRootElement (f x * f FirstFusion.t) := by
    have he : f x * f FirstFusion.t = MulAut.conj (f ((w ^ 3)⁻¹)) (f x) := by
      rw [← map_mul, hxt]
      change f ((w ^ 3)⁻¹ * x * ((w ^ 3)⁻¹)⁻¹) =
        f ((w ^ 3)⁻¹) * f x * (f ((w ^ 3)⁻¹))⁻¹
      simp only [map_mul, map_inv]
    rw [he]
    exact long_conj hx _
  have hB : ∀ z ∈ B, z ≠ 1 → IsLongRootElement z := by
    intro z hz hne
    have hfsq : f x * f x = 1 := by rw [← map_mul, ← pow_two, hsq, map_one]
    have htsq : f FirstFusion.t * f FirstFusion.t = 1 := by
      rw [← map_mul, ← pow_two, FirstFusion.t_pow_two, map_one]
    rcases (mem_closure_pair_iff _ _ hfsq htsq (hc.map f) z).mp hz with
      he | rfl | rfl | rfl
    · exact False.elim (hne he)
    · exact hx
    · exact ht
    · exact hxt'
  have htmem : f FirstFusion.t ∈ B := subset_closure (by simp)
  have hne : f FirstFusion.t ≠ 1 := by
    intro he
    exact FirstFusion.t_ne_one (hf (he.trans (map_one f).symm))
  exact long_subgroup_le_centralizer_core h B hB htmem hne (subset_closure (by simp))

private theorem a_not_long : ¬ IsLongRootElement (f a) := by
  intro ha
  have hc : IsLongRootElement (f c) := by
    have he : f c = MulAut.conj (f b) (f a) := by
      simp only [c, MulAut.conj_apply, map_mul, map_inv]
    rw [he]
    exact long_conj ha _
  let Q := (centralizer ({f FirstFusion.t} : Set (Model K))).pCoreIn 2
  have haQ : f a ∈ Q := long_pair_core h f hf a a_pow_two word_geometry.1
    word_geometry.2.2.1 ha
  have hcQ : f c ∈ Q := long_pair_core h f hf c c_sq word_geometry.2.1
    word_geometry.2.2.2 hc
  have hwQ : f w ∈ Q := by rw [w_eq, map_mul]; exact Q.mul_mem haQ hcQ
  let u : Q := ⟨f w, hwQ⟩
  have hu12 : u ^ 12 = 1 := by
    apply Subtype.ext
    change (f w) ^ 12 = 1
    rw [← map_pow, show w ^ 12 = 1 from comm_word_pow_twelve, map_one]
  have hu4 : u ^ 4 = 1 := by
    apply ((isPGroup_pCoreIn 2 _).powEquiv (by decide : Nat.Coprime 2 3)).injective
    change (u ^ 4) ^ 3 = (1 : Q) ^ 3
    rw [← pow_mul, hu12, one_pow]
  apply comm_word_pow_four_ne
  apply hf
  have he := congrArg Subtype.val hu4
  change (f w) ^ 4 = 1 at he
  simpa only [w, map_pow, map_one] using he

private theorem a_short : IsShortRootElement (f a) := by
  have hne : a ≠ 1 := by
    intro he
    exact comm_word_pow_four_ne (by simp [he])
  have hfne : f a ≠ 1 := by
    intro he
    exact hne (hf (he.trans (map_one f).symm))
  exact (h.involutions (f a) (by rw [← map_pow, a_pow_two, map_one]) hfne).resolve_left
    (a_not_long h f hf)

end Native

end CFSG.Quasithin.ChapterK.JankoTwo.NaturalLocalAction.InvolutionImages

namespace CFSG.Quasithin.ChapterK.JankoTwo.MarkedModule
open NaturalLocalAction.InvolutionImages
open Sporadic.LeechRelated.J2.GeneratorPair
variable {K G V : Type*} [Field K] [CharP K 2] [Algebra (ZMod 2) K]
  [Group G] [AddCommGroup V] [Module (ZMod 2) V]
  {ρ : Representation (ZMod 2) G V}
  (D : MarkedModule (K := K) ρ) (h : B46RootFacts K)
include h

/-- K.4.5: the literal embedded 2-central J₂ involution belongs to the
long-root class. Its nonidentity square root rules out the short-root class. -/
theorem carrierEmbedding_t_isLongRootElement :
    IsLongRootElement (D.carrierEmbedding FirstFusion.t) :=
  Native.t_long h D.carrierEmbedding D.carrierEmbedding_injective

/-- K.4.5: the literal embedded noncentral J₂ involution belongs to the
short-root class. The long-root possibility contradicts the native generator
word relations inside the actual ambient involution-centralizer two-core. -/
theorem carrierEmbedding_a_isShortRootElement :
    IsShortRootElement (D.carrierEmbedding a) := by
  let : Module.Finite (ZMod 2) K := Module.finite_of_finrank_eq_succ D.fieldDegree
  let : Finite K := Module.finite_of_finite (ZMod 2)
  exact Native.a_short h D.carrierEmbedding D.carrierEmbedding_injective

end CFSG.Quasithin.ChapterK.JankoTwo.MarkedModule
