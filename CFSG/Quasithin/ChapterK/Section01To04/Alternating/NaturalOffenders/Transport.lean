module

public import CFSG.Quasithin.ChapterK.Section01To04.Alternating.ActionTransport
public import Theory.Representation.BinaryOffender.GeneratedCore

/-!
# Transport for the natural alternating offender branches

A quasiequivalence preserves best-offender weights on every subgroup. Mapping
both ways therefore identifies the subgroups generated by all best offenders.
These transport facts are used with the literal natural identifications in
K.1 (Aschbacher–Smith, combined manuscript, printed p.452).
-/

@[expose] public section

open Subgroup Representation Representation.BinaryOffender
open CFSG.Quasithin.ChapterB.QuasisimpleSource
namespace CFSG.Quasithin.ChapterK.Alternating.NaturalOffenders
variable {G H V W : Type*} [Group G] [Group H]
  [AddCommGroup V] [Module (ZMod 2) V] [AddCommGroup W] [Module (ZMod 2) W]
  {ρ : Representation (ZMod 2) G V} {σ : Representation (ZMod 2) H W}

def reverse (e : ActionEquiv ρ σ) : ActionEquiv σ ρ where
  groupEquiv := e.groupEquiv.symm
  linearEquiv := e.linearEquiv.symm
  intertwines g w := by
    apply e.linearEquiv.injective
    rw [e.linearEquiv.apply_symm_apply, e.intertwines,
      e.groupEquiv.apply_symm_apply, e.linearEquiv.apply_symm_apply]

theorem weight_map (e : ActionEquiv ρ σ) (A : Subgroup G) :
    weight σ (A.map e.groupEquiv.toMonoidHom) = weight ρ A := by
  unfold weight
  rw [rank_map_injective _ e.groupEquiv.injective,
    ← fixedSpace_map_equivariant ρ σ _ e.linearEquiv e.intertwines,
    LinearEquiv.finrank_map_eq]

theorem best_map (e : ActionEquiv ρ σ) {A : Subgroup G}
    (hA : IsBestOffender ρ A) : IsBestOffender σ (A.map e.groupEquiv.toMonoidHom) := by
  let : IsElementaryAbelian 2 A := hA.1.2
  refine ⟨⟨?_, IsElementaryAbelian.map _⟩, ?_⟩
  · exact fun hz => hA.1.1
      ((A.map_eq_bot_iff_of_injective e.groupEquiv.injective).mp hz)
  · intro B hB
    let s := e.groupEquiv.mapSubgroup
    have hBA : s.symm B ≤ A := s.symm_apply_le.mpr hB
    have hw : weight σ B = weight ρ (s.symm B) := by
      have h := weight_map e (s.symm B)
      change weight σ (s (s.symm B)) = _ at h
      simpa only [s.apply_symm_apply] using h
    rw [weight_map, hw]
    exact hA.2 _ hBA

theorem generated_map_le (e : ActionEquiv ρ σ) :
    (offenderSubgroup ρ).map e.groupEquiv.toMonoidHom ≤ offenderSubgroup σ := by
  unfold offenderSubgroup generatedBy
  simp only [Subgroup.map_iSup]
  exact iSup_le fun A => iSup_le fun hA =>
    (best_map e hA.1).le_offenderSubgroup σ

theorem generated_map (e : ActionEquiv ρ σ) :
    (offenderSubgroup ρ).map e.groupEquiv.toMonoidHom = offenderSubgroup σ := by
  apply le_antisymm (generated_map_le e)
  have h := Subgroup.map_mono (f := e.groupEquiv.toMonoidHom)
    (generated_map_le (reverse e))
  have hi : e.groupEquiv.toMonoidHom.comp e.groupEquiv.symm.toMonoidHom =
      MonoidHom.id H := by ext g; exact e.groupEquiv.apply_symm_apply g
  simpa only [reverse, Subgroup.map_map, hi, Subgroup.map_id] using h

theorem generated_eq_top (e : ActionEquiv ρ σ) (h : offenderSubgroup σ = ⊤) :
    offenderSubgroup ρ = ⊤ := by
  apply Subgroup.map_injective (f := e.groupEquiv.toMonoidHom) e.groupEquiv.injective
  rw [generated_map, h]
  exact (Subgroup.map_top_of_surjective _ e.groupEquiv.surjective).symm

end CFSG.Quasithin.ChapterK.Alternating.NaturalOffenders
