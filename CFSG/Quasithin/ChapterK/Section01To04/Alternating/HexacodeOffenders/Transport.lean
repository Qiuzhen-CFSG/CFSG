module

public import CFSG.Quasithin.ChapterK.Section01To04.Alternating.ActionTransport
public import Theory.Representation.BinaryOffender.GeneratedCore

/-!
# Transport of the literal hexacode offender conclusion

An action equivalence transports the whole subgroup lattice and each fixed
space. Thus it transports all the weight comparisons defining bestness,
the subgroup generated by best offenders, and pointwise subspace kernels.
These facts retain both parts of a quasiequivalence, as needed in K.1.3
(Aschbacher–Smith, combined manuscript, printed p.453).
-/

@[expose] public section
open Subgroup Representation Representation.BinaryOffender

namespace CFSG.Quasithin.ChapterK.Alternating.HexacodeOffenders
open ChapterB.QuasisimpleSource

variable {G H V W : Type*} [Group G] [Group H]
  [AddCommGroup V] [Module (ZMod 2) V] [AddCommGroup W] [Module (ZMod 2) W]
  {ρ : Representation (ZMod 2) G V} {σ : Representation (ZMod 2) H W}

/-- Inverse coordinates on both the actors and the module. -/
def reverse (e : ActionEquiv ρ σ) : ActionEquiv σ ρ where
  groupEquiv := e.groupEquiv.symm
  linearEquiv := e.linearEquiv.symm
  intertwines g w := by
    apply e.linearEquiv.injective
    rw [e.linearEquiv.apply_symm_apply, e.intertwines,
      e.groupEquiv.apply_symm_apply, e.linearEquiv.apply_symm_apply]

/-- The actual fixed-space isomorphism preserves offender weight. -/
theorem weight_map (e : ActionEquiv ρ σ) (A : Subgroup G) :
    weight σ (A.map e.groupEquiv.toMonoidHom) = weight ρ A := by
  unfold weight
  rw [rank_map_injective _ e.groupEquiv.injective]
  congr 1
  exact (e.linearEquiv.ofSubmodules _ _
    (fixedSpace_map_equivariant ρ σ _ e.linearEquiv e.intertwines A)).finrank_eq.symm

/-- Transport every comparison with a subgroup, not only the offender inequality. -/
theorem bestOffender_map (e : ActionEquiv ρ σ) {A : Subgroup G}
    (hA : IsBestOffender ρ A) : IsBestOffender σ (A.map e.groupEquiv.toMonoidHom) := by
  let : IsElementaryAbelian 2 A := hA.1.2
  refine ⟨⟨?_, IsElementaryAbelian.map _⟩, ?_⟩
  · exact fun h => hA.1.1 ((A.map_eq_bot_iff_of_injective e.groupEquiv.injective).mp h)
  intro B hB
  let E := e.groupEquiv.mapSubgroup
  have hle : E.symm B ≤ A := E.symm_apply_le.mpr hB
  have hw : weight σ B = weight ρ (E.symm B) := by
    have h := weight_map e (E.symm B)
    change weight σ (E (E.symm B)) = _ at h
    simpa only [E.apply_symm_apply] using h
  rw [hw, weight_map]
  exact hA.2 _ hle

/-- Bestness is equivalent under an actual action equivalence. -/
theorem bestOffender_map_iff (e : ActionEquiv ρ σ) (A : Subgroup G) :
    IsBestOffender σ (A.map e.groupEquiv.toMonoidHom) ↔ IsBestOffender ρ A := by
  refine ⟨fun h => ?_, bestOffender_map e⟩
  have hh := bestOffender_map (reverse e) h
  have hi : e.groupEquiv.symm.toMonoidHom.comp e.groupEquiv.toMonoidHom =
      MonoidHom.id G := by ext g; exact e.groupEquiv.symm_apply_apply g
  simpa only [reverse, Subgroup.map_map, hi, Subgroup.map_id] using hh

/-- The generated subgroup, with its actual embedding, also transports. -/
theorem offenderSubgroup_map (e : ActionEquiv ρ σ) :
    (offenderSubgroup ρ).map e.groupEquiv.toMonoidHom = offenderSubgroup σ := by
  apply le_antisymm
  · rw [offenderSubgroup, generatedBy, Subgroup.map_iSup]
    apply iSup_le
    intro A
    rw [Subgroup.map_iSup]
    apply iSup_le
    rintro ⟨hA, _⟩
    exact (bestOffender_map e hA).le_offenderSubgroup σ
  · apply iSup_le
    intro B
    apply iSup_le
    rintro ⟨hB, _⟩
    let E := e.groupEquiv.mapSubgroup
    have hA : IsBestOffender ρ (E.symm B) := by
      apply (bestOffender_map_iff e _).mp
      change IsBestOffender σ (E (E.symm B))
      rwa [E.apply_symm_apply]
    calc
      B = (E.symm B).map e.groupEquiv.toMonoidHom := (E.apply_symm_apply B).symm
      _ ≤ (offenderSubgroup ρ).map e.groupEquiv.toMonoidHom :=
        Subgroup.map_mono (hA.le_offenderSubgroup ρ)

/-- Pointwise kernels transport on the precise inverse-image subspace. -/
theorem subspaceKernel_map (e : ActionEquiv ρ σ) (P : Submodule (ZMod 2) W) :
    (subspaceKernel ρ (P.comap e.linearEquiv.toLinearMap) ⊤).map
      e.groupEquiv.toMonoidHom = subspaceKernel σ P ⊤ := by
  ext h
  constructor
  · rintro ⟨g, ⟨_, hg⟩, rfl⟩
    refine ⟨Subgroup.mem_top _, ?_⟩
    intro w hw
    obtain ⟨v, rfl⟩ := e.linearEquiv.surjective w
    exact (e.intertwines g v).symm.trans (congrArg e.linearEquiv (hg v hw))
  · rintro ⟨_, hh⟩
    refine ⟨e.groupEquiv.symm h, ⟨Subgroup.mem_top _, ?_⟩,
      e.groupEquiv.apply_symm_apply h⟩
    intro v hv
    apply e.linearEquiv.injective
    rw [e.intertwines, e.groupEquiv.apply_symm_apply]
    exact hh (e.linearEquiv v) hv

end CFSG.Quasithin.ChapterK.Alternating.HexacodeOffenders
