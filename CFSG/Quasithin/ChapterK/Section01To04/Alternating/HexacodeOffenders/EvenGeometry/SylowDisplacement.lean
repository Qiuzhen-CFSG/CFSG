module
public import CFSG.Quasithin.ChapterK.Section01To04.Alternating.HexacodeOffenders.EvenGeometry.Sylow
import all CFSG.Quasithin.ChapterK.Section01To04.Alternating.HexacodeOffenders.EvenGeometry.Sylow
public import Theory.Representation.BinaryOffender.SubspaceAction
public import Mathlib.GroupTheory.Commutator.Basic

/-!
# The whole even Sylow action modulo its fixed plane

Every displacement of the actual dihedral Sylow fixes the good four-group
pointwise. The systematic encoder checks this on all 64 codewords. The two
displayed involutions generate the Sylow, and its commutator with the good
four-group is its central subgroup generated by z.

The `import all` is an intentional internal proof split: the unchanged
Sylow owner keeps its finite word definitions unexposed. This file uses
those bodies only in proofs and publishes no new definition.
-/

public section
open Atlas.Codes Representation Subgroup Representation.BinaryOffender
open scoped commutatorElement
namespace CFSG.Quasithin.ChapterK.Alternating.HexacodeOffenders.EvenGeometry.SylowModel

set_option maxRecDepth 8192 in
set_option maxHeartbeats 2000000 in
private theorem parameter_displacement (p : Bits) (q : Fin 3 → K) :
    Monomial.act z.val.val
      (Monomial.act (word p).val.val (systematicEncoder q)-systematicEncoder q) =
      Monomial.act (word p).val.val (systematicEncoder q)-systematicEncoder q ∧
    Monomial.act t.val.val
      (Monomial.act (word p).val.val (systematicEncoder q)-systematicEncoder q) =
      Monomial.act (word p).val.val (systematicEncoder q)-systematicEncoder q := by
  revert p q
  decide +kernel

/-- Every actual Sylow displacement lies in the plane fixed by the good
four-group, on the whole original hexacode module. -/
theorem sylow_displacement_mem_planeFixed
    (g : HexEvenAutomorphisms) (hg : g ∈ sylowGroup) (v : hexacode) :
    Hexacode.evenAction g v-v ∈ fixedSpace Hexacode.evenAction planeGroup := by
  obtain ⟨p,rfl⟩ := hg
  apply (mem_fixedSpace_plane _).mpr
  have h := parameter_displacement p (hexProjection firstThree v)
  rw [systematic_reconstruct] at h
  exact ⟨Subtype.ext h.1,Subtype.ext h.2⟩

/-- The full commutator span with D8 is fixed pointwise by its plane group. -/
theorem sylow_subspaceCommutator_le_planeFixed :
    subspaceCommutator Hexacode.evenAction ⊤ sylowGroup ≤
      fixedSpace Hexacode.evenAction planeGroup := by
  apply Submodule.span_le.mpr
  rintro _ ⟨g,hg,v,_,rfl⟩
  exact sylow_displacement_mem_planeFixed g hg v

private theorem commutator_word (p q : Bits) :
    ⁅word p,word q⁆ = word (p.2.1*q.2.2+p.2.2*q.2.1,0,0) := by
  simp only [commutatorElement_def,←word_inv,←word_mul]
  congr 1
  revert p q
  decide +kernel

private theorem s_mem : s ∈ sylowGroup := by
  exact ⟨(0,1,0),by simp [word]⟩

private theorem t_mem_plane : t ∈ planeGroup := by
  exact ⟨(0,1),by simp [secondWord,word]⟩

/-- The actual cross-pair generator is an involution. -/
theorem s_square : s^2=1 := by
  have h := word_mul (0,1,0) (0,1,0)
  simpa [mulBits,word,pow_two] using h.symm

/-- The actual pair-preserving generator is an involution. -/
theorem t_square : t^2=1 := by
  have h := word_mul (0,0,1) (0,0,1)
  simpa [mulBits,word,pow_two] using h.symm

/-- The commutator of the two original involutions is the displayed central
involution. -/
theorem commutator_s_t : ⁅s,t⁆=z := by
  simpa [word] using commutator_word (0,1,0) (0,0,1)

/-- The actual dihedral Sylow is generated by these two involutions. -/
theorem sylowGroup_eq_involution_sup : sylowGroup=zpowers s ⊔ zpowers t := by
  apply le_antisymm
  · have hs : s ∈ zpowers s ⊔ zpowers t :=
      (le_sup_left : zpowers s ≤ zpowers s ⊔ zpowers t) (mem_zpowers s)
    have ht : t ∈ zpowers s ⊔ zpowers t :=
      (le_sup_right : zpowers t ≤ zpowers s ⊔ zpowers t) (mem_zpowers t)
    have hz : z ∈ zpowers s ⊔ zpowers t := by
      rw [←commutator_s_t,commutatorElement_def]
      exact (zpowers s ⊔ zpowers t).mul_mem
        ((zpowers s ⊔ zpowers t).mul_mem
          ((zpowers s ⊔ zpowers t).mul_mem hs ht)
          ((zpowers s ⊔ zpowers t).inv_mem hs))
        ((zpowers s ⊔ zpowers t).inv_mem ht)
    rintro _ ⟨p,rfl⟩
    exact (zpowers s ⊔ zpowers t).mul_mem
      ((zpowers s ⊔ zpowers t).mul_mem (pow_mem hz _) (pow_mem hs _))
      (pow_mem ht _)
  · exact sup_le (zpowers_le.mpr s_mem)
      (zpowers_le.mpr (planeGroup_le_sylow t_mem_plane))

private theorem sylow_commutator_le : ⁅sylowGroup,sylowGroup⁆ ≤ zpowers z := by
  apply commutator_le.mpr
  rintro _ ⟨p,rfl⟩ _ ⟨q,rfl⟩
  rw [commutator_word]
  simp [word]

/-- Commuting the whole Sylow with the good four-group produces precisely z. -/
theorem sylow_commutator_plane_eq : ⁅sylowGroup,planeGroup⁆=zpowers z := by
  apply le_antisymm ((commutator_mono le_rfl planeGroup_le_sylow).trans sylow_commutator_le)
  apply zpowers_le.mpr
  rw [←commutator_s_t]
  exact commutator_mem_commutator s_mem t_mem_plane

/-- The ambient commutator of the actual Sylow is the same central subgroup. -/
theorem sylow_commutator_self_eq : ⁅sylowGroup,sylowGroup⁆=zpowers z := by
  apply le_antisymm sylow_commutator_le
  rw [←sylow_commutator_plane_eq]
  exact commutator_mono le_rfl planeGroup_le_sylow

end CFSG.Quasithin.ChapterK.Alternating.HexacodeOffenders.EvenGeometry.SylowModel
