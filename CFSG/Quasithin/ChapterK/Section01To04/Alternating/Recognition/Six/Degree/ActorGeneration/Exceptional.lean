module

public import CFSG.Quasithin.ChapterK.Section01To04.Alternating.Recognition.Six.Degree.ActorGeneration.Contracts
public import Theory.Alternating.proposition_5_2_7_8

/-!
# Three inner conjugates of an exceptional involution of A₆

For the canonical exceptional automorphism `t`, put `c = (01)(04)` and
`d = t(c) = (01)(02)(35)(34)`. The elements `a = c d⁻¹` and `b = c⁻¹ d`
generate A₆: four five-letter words in `a`, `b` and their inverses give all
star three-cycles based at `0,1`. The action on `c` and the four word identities
are checked by kernel reduction; generation uses the structural star-cycle
closure theorem.

The subgroup generated by the three inner conjugates of `t` indexed by
`1,c,c⁻¹` contains `Inn(a)` and `Inn(b)`, hence all of `Inn(A₆)`. The proved
exceptional-involution conjugacy theorem reduces every involution outside
the literal natural S₆ subgroup to this calculation. Its coordinate change
acts on A₆ itself, so the transported conjugators still lie in A₆.

This discharges `ExceptionalInvolutionGeneration`, the finite exceptional
input to `ActorGenerationProof.exceptional_actor_generation` in `Transport`.
Source: the group-generation route to Aschbacher–Smith K.1.1, printed p.452
(PDF p.463), citing GM02 Theorem 6.2/Table 6.3. Exceptional conjugacy is the
GLS Volume 3, Proposition 5.2.7 calculation in `proposition_5_2_7_8`.
-/

open Equiv Subgroup GLS3.Chapter5 AlternatingSix.ShadowLocal
namespace CFSG.Quasithin.ChapterK.Alternating.SixDegreeReduction.ActorGenerationProof

private def c : A6 := ⟨swap 0 1 * swap 0 4, by rw [Perm.mem_alternatingGroup]; decide +kernel⟩
private def d : A6 := ⟨(swap 0 1 * swap 0 2) * (swap 3 5 * swap 3 4), by
  rw [Perm.mem_alternatingGroup]; decide +kernel⟩

private theorem canonical_c : canonicalExceptionalAut c = d := by
  apply Subtype.ext
  change twistPerm canonicalTwistPerm c.val = d.val
  apply Equiv.ext
  intro i
  rw [← twistFn_equiv canonicalTwistPerm c.val]
  fin_cases i <;> decide +kernel

private def a : A6 := c * d⁻¹
private def b : A6 := c⁻¹ * d

private def word : List (Fin 4) → A6
  | [] => 1
  | i :: w => (if i = 0 then a else if i = 1 then b else if i = 2 then a⁻¹ else b⁻¹) * word w

private theorem word_mem (H : Subgroup A6) (ha : a ∈ H) (hb : b ∈ H)
    (w : List (Fin 4)) : word w ∈ H := by
  induction w with
  | nil => exact H.one_mem
  | cons i w ih =>
    apply H.mul_mem ?_ ih
    fin_cases i
    · exact ha
    · exact hb
    · exact H.inv_mem ha
    · exact H.inv_mem hb

private theorem seed_generates (H : Subgroup A6) (ha : a ∈ H) (hb : b ∈ H) : H = ⊤ := by
  have hstar (i : Fin 6) (hi0 : i ≠ 0) (hi1 : i ≠ 1) :
      (⟨swap 0 1 * swap 0 i,
        (Perm.isThreeCycle_swap_mul_swap_same (by decide) hi0.symm hi1.symm).mem_alternatingGroup⟩ : A6) ∈ H := by
    fin_cases i
    · exact (hi0 rfl).elim
    · exact (hi1 rfl).elim
    · convert word_mem H ha hb [0, 1, 1, 2, 1] using 1
      apply Subtype.ext
      change (swap 0 1 * swap 0 2 : Perm (Fin 6)) = (word [0, 1, 1, 2, 1]).val
      decide +kernel
    · convert word_mem H ha hb [0, 0, 3, 0, 1] using 1
      apply Subtype.ext
      change (swap 0 1 * swap 0 3 : Perm (Fin 6)) = (word [0, 0, 3, 0, 1]).val
      decide +kernel
    · convert word_mem H ha hb [1, 0, 3, 2, 1] using 1
      apply Subtype.ext
      change (swap 0 1 * swap 0 4 : Perm (Fin 6)) = (word [1, 0, 3, 2, 1]).val
      decide +kernel
    · convert word_mem H ha hb [2, 3, 0, 3, 3] using 1
      apply Subtype.ext
      change (swap 0 1 * swap 0 5 : Perm (Fin 6)) = (word [2, 3, 0, 3, 3]).val
      decide +kernel
  apply top_unique
  rw [← starThreeCycles_closure_eq_top (a := (0 : Fin 6)) (b := 1) (by decide)]
  apply (Subgroup.closure_le _).mpr
  rintro x ⟨i, hi0, hi1, hi⟩
  have heq : x = (⟨swap 0 1 * swap 0 i,
      (Perm.isThreeCycle_swap_mul_swap_same (by decide) hi0.symm hi1.symm).mem_alternatingGroup⟩ : A6) :=
    Subtype.ext hi
  rw [heq]
  exact hstar i hi0 hi1

private theorem twist_product (t : AutA6) (x : A6) :
    (MulAut.conj x * t * (MulAut.conj x)⁻¹) * t⁻¹ =
      MulAut.conj (x * (t x)⁻¹) := by
  calc
    _ = MulAut.conj x * (t * MulAut.conj x * t⁻¹)⁻¹ := by group
    _ = MulAut.conj x * (MulAut.conj (t x))⁻¹ := by rw [mulAut_conj_transport]
    _ = _ := by rw [map_mul, map_inv]

private theorem canonical_generation :
    ∃ cs : Fin 3 → A6,
      AlternatingSix.ShadowLocal.inner ≤ ⨆ i,
        zpowers (MulAut.conj (cs i) * canonicalExceptionalAut * (MulAut.conj (cs i))⁻¹) := by
  let cs : Fin 3 → A6 := ![1, c, c⁻¹]
  let H : Subgroup AutA6 := ⨆ i,
    zpowers (MulAut.conj (cs i) * canonicalExceptionalAut * (MulAut.conj (cs i))⁻¹)
  have hcs (i : Fin 3) :
      MulAut.conj (cs i) * canonicalExceptionalAut * (MulAut.conj (cs i))⁻¹ ∈ H :=
    (le_iSup (fun i => zpowers (MulAut.conj (cs i) * canonicalExceptionalAut *
      (MulAut.conj (cs i))⁻¹)) i) (mem_zpowers _)
  have ht : canonicalExceptionalAut ∈ H := by simpa [cs] using hcs 0
  have hx (i : Fin 3) : MulAut.conj (cs i * (canonicalExceptionalAut (cs i))⁻¹) ∈ H := by
    rw [← twist_product]
    exact H.mul_mem (hcs i) (H.inv_mem ht)
  have ha : MulAut.conj a ∈ H := by simpa [cs, a, canonical_c] using hx 1
  have hb : MulAut.conj b ∈ H := by simpa [cs, b, canonical_c] using hx 2
  have htop : H.comap MulAut.conj = ⊤ := seed_generates _ ha hb
  refine ⟨cs, ?_⟩
  rintro _ ⟨x, rfl⟩
  exact (show x ∈ H.comap MulAut.conj from htop ▸ mem_top x)

/-- Every involution outside the natural S₆ has three conjugates by elements
of A₆ whose generated subgroup contains the literal inner automorphism subgroup. -/
public theorem exceptionalInvolutionGeneration : ExceptionalInvolutionGeneration := by
  intro t ht hn
  obtain ⟨σ, hσ⟩ := exceptionalAut_eq_twist t hn
  obtain ⟨τ, hτ⟩ := exceptionalTwistAut_conjugate_canonical σ (hσ ▸ ht)
  let e : MulAut A6 := MulAut.conjNormal τ
  have he : t = MulAut.congr e canonicalExceptionalAut := by
    rw [hσ, hτ]
    apply MulEquiv.ext
    intro x
    rfl
  obtain ⟨cs, hcs⟩ := canonical_generation
  refine ⟨fun i => e (cs i), ?_⟩
  rintro _ ⟨x, rfl⟩
  have hx := hcs (show MulAut.conj (e.symm x) ∈ AlternatingSix.ShadowLocal.inner from
    ⟨e.symm x, rfl⟩)
  have hm := Subgroup.mem_map_of_mem (MulAut.congr e).toMonoidHom hx
  rw [Subgroup.map_iSup] at hm
  simp only [MonoidHom.map_zpowers, MulEquiv.coe_toMonoidHom, map_mul, map_inv,
    MulAut.congr_conj, e.apply_symm_apply, ← he] at hm
  exact hm

end CFSG.Quasithin.ChapterK.Alternating.SixDegreeReduction.ActorGenerationProof
