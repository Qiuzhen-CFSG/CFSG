private theorem involution_fixes_displacement {G V : Type*} [Group G] [AddCommGroup V]
    [Module (ZMod 2) V] (ρ : Representation (ZMod 2) G V)
    {a : G} (ha : a * a = 1) (v : V) : ρ a (ρ a v - v) = ρ a v - v := by
  have hn (w : V) : -w = w := by
    apply neg_eq_of_add_eq_zero_left
    calc
      w + w = ((1 : ZMod 2) + 1) • w := by rw [add_smul, one_smul]
      _ = 0 := by rw [show (1 : ZMod 2) + 1 = 0 by decide, zero_smul]
  rw [map_sub]
  have h : ρ a (ρ a v) = v := by
    change (ρ a * ρ a) v = v
    rw [← map_mul, ha, map_one]
    rfl
  rw [h, sub_eq_add_neg, sub_eq_add_neg, hn, hn, add_comm]

@[expose] noncomputable def octadPair (z d : M24) : Subgroup M24 := Subgroup.closure {z, d}

private theorem pair_le {H : Subgroup M24} {z d : M24} (hz : z ∈ H) (hd : d ∈ H) :
    octadPair z d ≤ H := by
  apply (Subgroup.closure_le _).mpr
  intro x hx
  rcases hx with rfl | rfl <;> assumption

private theorem z_mem_pair (z d : M24) : z ∈ octadPair z d :=
  Subgroup.subset_closure (by simp)

private theorem d_mem_pair (z d : M24) : d ∈ octadPair z d :=
  Subgroup.subset_closure (by simp)

private theorem pair_card_rank {H : Subgroup M24} (hH : IsElementaryAbelian 2 H)
    {z d : M24} (hz : z ∈ H) (hz1 : z ≠ 1) (hd : d ∈ H)
    (hdz : d ∉ Subgroup.zpowers z) :
    Nat.card (octadPair z d) = 4 ∧ rank (octadPair z d) = 2 := by
  let _ := hH
  have hz2 := elemPow_eq_one_of_isElementaryAbelian (p := 2) z hz
  have hd2 := elemPow_eq_one_of_isElementaryAbelian (p := 2) d hd
  have hc : Commute z d := congrArg Subtype.val (mul_comm (⟨z,hz⟩ : H) ⟨d,hd⟩)
  have hcard := (Subgroup.isKleinFour_closure_pair z d
    (by simpa only [pow_two] using hz2) (by simpa only [pow_two] using hd2)
    hz1 (fun he => hdz (he ▸ (Subgroup.zpowers z).one_mem))
    (fun he => hdz (he ▸ Subgroup.mem_zpowers z)) hc).card_four
  refine ⟨hcard, ?_⟩
  rw [rank, show Nat.card (octadPair z d) = 4 from hcard]
  decide

/-- The source central involution has order two in the literal M24. -/
theorem octad_involution_order (O : Octad) (z : M24)
    (hz : z ∈ octadKernel O) (hz1 : z ≠ 1) : orderOf z = 2 := by
  let _ : IsElementaryAbelian 2 (octadKernel O) :=
    M24ChapterHStabilizers.OctadAction.ambientCore_elementary O
  exact orderOf_eq_prime (elemPow_eq_one_of_isElementaryAbelian (p := 2) z hz) hz1

/-- The displacement space is the actual Vz, using only H.16.2(6)'s dimension. -/
theorem octad_involution_displacement (O : Octad) (z : M24)
    (hz : z ∈ octadKernel O) (hz1 : z ≠ 1)
    (hdim : Module.finrank (ZMod 2) (codeOctadInvolutionFixed O z) = 4) :
    LinearMap.range (displacement codeRepresentation z) = codeOctadInvolutionFixed O z := by
  have ho := octad_involution_order O z hz hz1
  have hz2 : z * z = 1 := by simpa only [ho, pow_two] using pow_orderOf_eq_one z
  have hle : LinearMap.range (displacement codeRepresentation z) ≤
      codeOctadInvolutionFixed O z := by
    rintro _ ⟨v, rfl⟩
    refine ⟨Submodule.subset_span ⟨z, hz, v, Submodule.mem_top, rfl⟩, ?_⟩
    apply (mem_fixedSpace_zpowers_iff _ _ _).mpr
    exact involution_fixes_displacement codeRepresentation hz2 v
  have hfix := octad_kernel_involution_fixed_finrank O z
    (show z ∈ octadPointwiseKernel O by
      rwa [← octad_core_map_eq_pointwise O]) hz1
  have hsum := fixedCodim_add_finrank codeRepresentation (Subgroup.zpowers z)
  rw [hfix, finrank_code, fixedCodim_zpowers_eq_displacement_rank] at hsum
  change Module.finrank (ZMod 2) (LinearMap.range (displacement codeRepresentation z)) + 7 = 11 at hsum
  exact Submodule.eq_of_le_of_finrank_eq hle (by rw [hdim]; omega)

/-- Cyclic commutator form of K.4.3(2). -/
theorem octad_involution_commutator (O : Octad) (z : M24)
    (hz : z ∈ octadKernel O) (hz1 : z ≠ 1)
    (hdim : Module.finrank (ZMod 2) (codeOctadInvolutionFixed O z) = 4) :
    subspaceCommutator codeRepresentation ⊤ (Subgroup.zpowers z) =
      codeOctadInvolutionFixed O z := by
  rw [← octad_involution_displacement O z hz hz1 hdim]
  apply le_antisymm
  · apply Submodule.span_le.mpr
    rintro _ ⟨a, ha, v, _, rfl⟩
    have ho := octad_involution_order O z hz hz1
    obtain ⟨i, hi, rfl⟩ := Finset.mem_image.mp ((mem_zpowers_iff_mem_range_orderOf).mp ha)
    have hi := Finset.mem_range.mp hi
    rw [ho] at hi
    interval_cases i
    · simp
    · exact ⟨v, by simp [displacement]⟩
  · rintro _ ⟨v, rfl⟩
    exact Submodule.subset_span ⟨z, Subgroup.mem_zpowers z, v, Submodule.mem_top, rfl⟩

/-- z fixes Vz pointwise by the definition of Vz. -/
theorem octad_involution_mem_centralizer (O : Octad) (z : M24) :
    z ∈ codeOctadInvolutionCentralizer O z := by
  refine ⟨Subgroup.mem_top _, ?_⟩
  intro v hv
  exact (mem_fixedSpace_zpowers_iff _ _ _).mp hv.2

/-- Quadraticity on either the code or its dual puts the entire actor in Dz. -/
theorem quadratic_le_octad_centralizer (O : Octad) (z : M24)
    (hz : z ∈ octadKernel O) (hz1 : z ≠ 1)
    (hdim : Module.finrank (ZMod 2) (codeOctadInvolutionFixed O z) = 4)
    (A : Subgroup M24) (hzA : z ∈ A)
    (hquad : IsQuadratic codeRepresentation A ∨ IsQuadratic codeRepresentation.dual A) :
    A ≤ codeOctadInvolutionCentralizer O z := by
  have hq : IsQuadratic codeRepresentation A := hquad.elim id
    ((quadratic_iff_dual codeRepresentation A).mpr)
  intro a ha
  refine ⟨Subgroup.mem_top _, ?_⟩
  intro v hv
  rw [← octad_involution_displacement O z hz hz1 hdim] at hv
  obtain ⟨w, rfl⟩ := hv
  exact hq a ha z hzA w

/-- The actual M22 actor lies in Dz even though it need not be quadratic on U. -/
theorem m22_quadratic_image_le_octad_centralizer (O : Octad)
    (A : Subgroup m22PairStabilizer) (x : m22PairStabilizer)
    (hx : x ∈ A) (hx2 : orderOf x = 2) (h0 : x.val • (0 : Fin 24) = 0)
    (hxO : x.val ∈ octadKernel O)
    (hdim : Module.finrank (ZMod 2) (codeOctadInvolutionFixed O x.val) = 4)
    (hquad : IsQuadratic m22OuterCodeRepresentation A) :
    A.map m22PairStabilizer.subtype ≤ codeOctadInvolutionCentralizer O x.val := by
  have hx1 : x.val ≠ 1 := by
    intro he
    have : x = 1 := Subtype.ext he
    simp [this] at hx2
  rintro _ ⟨a, ha, rfl⟩
  refine ⟨Subgroup.mem_top _, ?_⟩
  intro v hv
  rw [← octad_involution_displacement O x.val hxO hx1 hdim,
    ← m22_retained_inner_displacement x hx2 h0] at hv
  obtain ⟨w, hw, rfl⟩ := hv
  exact congrArg Subtype.val (hquad a ha x hx ⟨w,hw⟩)

/-- K.4.3(1)'s intersection follows from H.16.2(7) and the native four-group
fixed dimensions. No intersection hypothesis is used. -/
theorem octad_centralizer_inf_kernel (O : Octad) (z : M24)
    (hz : z ∈ octadKernel O) (hz1 : z ≠ 1)
    (hfixed : ∀ B : Subgroup M24, z ∈ B → B ≤ codeOctadInvolutionCentralizer O z →
      Module.finrank (ZMod 2) (fixedSpace codeRepresentation B) = 8 - rank B) :
    codeOctadInvolutionCentralizer O z ⊓ octadKernel O = Subgroup.zpowers z := by
  apply le_antisymm
  · rintro d ⟨hdD, hdK⟩
    by_contra hdz
    have hEK := pair_le hz hdK
    obtain ⟨hc, hr⟩ := pair_card_rank
      (M24ChapterHStabilizers.OctadAction.ambientCore_elementary O) hz hz1 hdK hdz
    have hfour := octad_kernel_four_fixed_finrank O (octadPair z d)
      (by rwa [← octad_core_map_eq_pointwise O]) hc
    have hsix := hfixed (octadPair z d) (z_mem_pair z d)
      (pair_le (octad_involution_mem_centralizer O z) hdD)
    rw [hr] at hsix
    omega
  · exact Subgroup.zpowers_le.mpr ⟨octad_involution_mem_centralizer O z, hz⟩

/-- The four-group in K.4.3 has fixed dimension six by H.16.2(7). -/
theorem octad_pair_rank_fixed (O : Octad) (z d : M24)
    (hz1 : z ≠ 1) (hd : d ∈ codeOctadInvolutionCentralizer O z)
    (hdz : d ∉ Subgroup.zpowers z)
    (hD : IsElementaryAbelian 2 (codeOctadInvolutionCentralizer O z))
    (hfixed : ∀ B : Subgroup M24, z ∈ B → B ≤ codeOctadInvolutionCentralizer O z →
      Module.finrank (ZMod 2) (fixedSpace codeRepresentation B) = 8 - rank B) :
    rank (octadPair z d) = 2 ∧
      Module.finrank (ZMod 2) (fixedSpace codeRepresentation (octadPair z d)) = 6 := by
  have hr := (pair_card_rank hD (octad_involution_mem_centralizer O z) hz1 hd hdz).2
  refine ⟨hr, ?_⟩
  rw [hfixed _ (z_mem_pair z d) (pair_le (octad_involution_mem_centralizer O z) hd), hr]

/-- The pair centralizes both displacement images. This establishes quadraticity
on the ambient code for these particular pairs, without any restriction argument. -/
theorem octad_pair_quadratic_commutator (O : Octad) (z d : M24)
    (hz : z ∈ octadKernel O) (hz1 : z ≠ 1)
    (hdim : Module.finrank (ZMod 2) (codeOctadInvolutionFixed O z) = 4)
    (hd : d ∈ codeOctadInvolutionCentralizer O z)
    (hD : IsElementaryAbelian 2 (codeOctadInvolutionCentralizer O z)) :
    IsQuadratic codeRepresentation (octadPair z d) ∧
      subspaceCommutator codeRepresentation ⊤ (octadPair z d) =
        LinearMap.range (displacement codeRepresentation z) ⊔
          LinearMap.range (displacement codeRepresentation d) := by
  let _ := hD
  have hzD := octad_involution_mem_centralizer O z
  have hz2 : z * z = 1 := by
    simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) z hzD
  have hd2 : d * d = 1 := by
    simpa only [pow_two] using elemPow_eq_one_of_isElementaryAbelian (p := 2) d hd
  have hcomm : Commute z d := congrArg Subtype.val
    (mul_comm (⟨z,hzD⟩ : codeOctadInvolutionCentralizer O z) ⟨d,hd⟩)
  have hdi (v : Code) : codeRepresentation d (displacement codeRepresentation z v) =
      displacement codeRepresentation z v := by
    apply hd.2
    rw [← octad_involution_displacement O z hz hz1 hdim]
    exact ⟨v,rfl⟩
  have hzi (v : Code) : codeRepresentation z (displacement codeRepresentation d v) =
      displacement codeRepresentation d v := by
    have h := hdi v
    change codeRepresentation d (codeRepresentation z v - v) = codeRepresentation z v - v at h
    rw [map_sub] at h
    have hc : codeRepresentation z (codeRepresentation d v) =
        codeRepresentation d (codeRepresentation z v) := by
      change (codeRepresentation z * codeRepresentation d) v =
        (codeRepresentation d * codeRepresentation z) v
      rw [← map_mul, ← map_mul, hcomm.eq]
    change codeRepresentation z (codeRepresentation d v - v) = codeRepresentation d v - v
    rw [map_sub, hc, sub_eq_iff_eq_add.mp h]
    abel
  let W := LinearMap.range (displacement codeRepresentation z) ⊔
    LinearMap.range (displacement codeRepresentation d)
  have hzfix : ∀ v ∈ W, codeRepresentation z v = v := by
    intro v hv
    obtain ⟨i, ⟨u,rfl⟩, j, ⟨w,rfl⟩, rfl⟩ := Submodule.mem_sup.mp hv
    rw [map_add, hzi]
    exact congrArg (fun a => a + displacement codeRepresentation d w)
      (involution_fixes_displacement codeRepresentation hz2 u)
  have hdfix : ∀ v ∈ W, codeRepresentation d v = v := by
    intro v hv
    obtain ⟨i, ⟨u,rfl⟩, j, ⟨w,rfl⟩, rfl⟩ := Submodule.mem_sup.mp hv
    rw [map_add, hdi]
    exact congrArg (fun a => displacement codeRepresentation z u + a)
      (involution_fixes_displacement codeRepresentation hd2 w)
  have hcases (a : M24) (ha : a ∈ octadPair z d) : a = 1 ∨ a = z ∨ a = d ∨ a = z * d :=
    (Subgroup.mem_closure_pair_iff z d hz2 hd2 hcomm a).mp ha
  have hfixed : W ≤ fixedSpace codeRepresentation (octadPair z d) := by
    intro v hv a
    change codeRepresentation a.val v = v
    rcases hcases a.val a.property with h | h | h | h <;>
      simp only [h, map_one, Module.End.one_apply, map_mul, Module.End.mul_apply,
        hzfix v hv, hdfix v hv]
  have hI : LinearMap.range (displacement codeRepresentation z) ≤ W := le_sup_left
  have hJ : LinearMap.range (displacement codeRepresentation d) ≤ W := le_sup_right
  have heq : subspaceCommutator codeRepresentation ⊤ (octadPair z d) = W := by
    apply le_antisymm
    · apply Submodule.span_le.mpr
      rintro _ ⟨a,ha,v,_,rfl⟩
      rcases hcases a ha with rfl | rfl | rfl | rfl
      · simp
      · exact hI ⟨v,rfl⟩
      · exact hJ ⟨v,rfl⟩
      · have he : codeRepresentation (z * d) v - v =
            displacement codeRepresentation z (codeRepresentation d v) +
              displacement codeRepresentation d v := by
          simp only [displacement, LinearMap.sub_apply, LinearMap.id_apply, map_mul,
            Module.End.mul_apply]
          abel
        rw [he]
        exact W.add_mem (hI ⟨codeRepresentation d v,rfl⟩) (hJ ⟨v,rfl⟩)
    · apply sup_le
      · rintro _ ⟨v,rfl⟩
        exact Submodule.subset_span ⟨z,z_mem_pair z d,v,Submodule.mem_top,rfl⟩
      · rintro _ ⟨v,rfl⟩
        exact Submodule.subset_span ⟨d,d_mem_pair z d,v,Submodule.mem_top,rfl⟩
  refine ⟨?_,heq⟩
  intro a ha b hb v
  have hv : codeRepresentation b v - v ∈ subspaceCommutator codeRepresentation ⊤
      (octadPair z d) := Submodule.subset_span ⟨b,hb,v,Submodule.mem_top,rfl⟩
  rw [heq] at hv
  exact hfixed hv ⟨a,ha⟩

/-- A noncyclic elementary subgroup of the literal pair stabilizer contains
an inner involution. Evaluation at 0 otherwise embeds it in the two-point pair. -/
theorem m22_exists_inner_involution (A : Subgroup m22PairStabilizer)
    (hA : IsElementaryTwo A) (hr : 1 < rank A) :
    ∃ x : m22PairStabilizer, x ∈ A ∧ orderOf x = 2 ∧ x.val • (0 : Fin 24) = 0 := by
  classical
  let _ := hA.2
  by_contra! hn
  have hfix (x : A) (hx : x.val.val • (0 : Fin 24) = 0) : x = 1 := by
    by_contra hx1
    have hv1 : x.val ≠ 1 := fun he => hx1 (Subtype.ext he)
    have ho : orderOf x.val = 2 := orderOf_eq_prime
      (elemPow_eq_one_of_isElementaryAbelian (p := 2) x.val x.property) hv1
    exact hn x.val x.property ho hx
  let f : A → m22Pair := fun x => ⟨x.val.val • (0 : Fin 24),
    MulAction.mem_stabilizer_finset'.mp x.val.property (by simp [m22Pair])⟩
  have hf : Function.Injective f := by
    intro a b hab
    have he : a.val.val • (0 : Fin 24) = b.val.val • (0 : Fin 24) := congrArg Subtype.val hab
    have hba : b⁻¹ * a = 1 := hfix (b⁻¹ * a) (by
      change (b.val.val⁻¹ * a.val.val) • (0 : Fin 24) = 0
      rw [mul_smul,he,inv_smul_smul])
    exact (inv_mul_eq_one.mp hba).symm
  have hc : Nat.card A ≤ 2 := (Nat.card_le_card_of_injective f hf).trans_eq (by
    rw [Nat.card_eq_fintype_card, Fintype.card_coe]
    decide)
  have hlog := Nat.log_mono_right (b := 2) hc
  change rank A ≤ 1 at hlog
  omega

/-- An involution with a fixed point belongs to the pointwise kernel of its
actual fixed octad. The fixed octad is obtained by native M24 conjugation. -/
theorem fixed_involution_octad (x : M24) (hx : orderOf x = 2)
    (hf : ∃ i : Fin 24, x • i = i) :
    ∃ O : Octad, x ∈ octadKernel O ∧ ∀ i : Fin 24, x • i = i ↔ i ∈ O.val := by
  classical
  have hc : IsConj CocodeOctad.Involutions.z x := by
    rcases M24InvolutionCentralizers.involution_classes x hx with hz | ht
    · exact hz
    · obtain ⟨g,hg⟩ := isConj_iff.mp ht
      obtain ⟨i,hi⟩ := hf
      change g * CocodeOctad.Involutions.t * g⁻¹ = x at hg
      rw [← hg] at hi
      have h := congrArg (fun j : Fin 24 => g⁻¹ • j) hi
      exact (CocodeOctad.Involutions.t_fixedPointFree (g⁻¹ • i)
        (by simpa only [mul_smul,inv_smul_smul] using h)).elim
  obtain ⟨g,hg⟩ := isConj_iff.mp hc
  change g * CocodeOctad.Involutions.z * g⁻¹ = x at hg
  let O : Octad := ⟨g • LinearFourCore.seedOctad.val, by
    have h := (mem_M24_iff g.val).mp g.property
    change g.val • LinearFourCore.seedOctad.val ∈ (m24Blocks : Set (Finset (Fin 24)))
    rw [← h]
    exact Set.smul_mem_smul_set LinearFourCore.seedOctad.property⟩
  have hfixed (i : Fin 24) : x • i = i ↔ i ∈ O.val := by
    change x • i = i ↔ i ∈ g • LinearFourCore.seedOctad.val
    rw [Finset.mem_smul_finset]
    constructor
    · intro hi
      refine ⟨g⁻¹ • i, ?_, smul_inv_smul _ _⟩
      apply (CocodeOctad.Involutions.z_fixed_iff _).mp
      rw [← hg] at hi
      have h := congrArg (fun j : Fin 24 => g⁻¹ • j) hi
      simpa only [mul_smul,inv_smul_smul] using h
    · rintro ⟨j,hj,rfl⟩
      rw [← hg]
      simp only [mul_smul,inv_smul_smul,(CocodeOctad.Involutions.z_fixed_iff _).mpr hj]
  refine ⟨O, ?_, hfixed⟩
  change x ∈ (pCore 2 (octadStabilizer O)).map (octadStabilizer O).subtype
  rw [octad_core_map_eq_pointwise]
  exact (mem_octadPointwiseKernel O x).mpr (fun i hi => (hfixed i).mpr hi)

/-- Native placement for the M22 consumer: the marked pair is in the octad,
and the ambient image of the restricted actor lies in its Dz. The only module
input is the earlier H.16.2(6) dimension of Vz. -/
theorem m22_quadratic_native_placement
    (hdim : ∀ (O : Octad) (z : M24), z ∈ octadKernel O → z ≠ 1 →
      Module.finrank (ZMod 2) (codeOctadInvolutionFixed O z) = 4)
    (A : Subgroup m22PairStabilizer) (hA : A ∈ quadraticSubgroups m22OuterCodeRepresentation) :
    ∃ (O : Octad) (x : m22PairStabilizer), x ∈ A ∧ orderOf x = 2 ∧
      x.val • (0 : Fin 24) = 0 ∧ x.val ∈ octadKernel O ∧
      (0 : Fin 24) ∈ O.val ∧ (9 : Fin 24) ∈ O.val ∧
      A.map m22PairStabilizer.subtype ≤ codeOctadInvolutionCentralizer O x.val := by
  obtain ⟨x,hx,hx2,h0⟩ := m22_exists_inner_involution A hA.1 hA.2.1
  have horder : orderOf x.val = 2 :=
    (orderOf_injective m22PairStabilizer.subtype Subtype.val_injective x).trans hx2
  have hx1 : x.val ≠ 1 := by intro he; simp [he] at horder
  obtain ⟨O,hxO,hfixed⟩ := fixed_involution_octad x.val horder ⟨0,h0⟩
  have h9 : x.val • (9 : Fin 24) = 9 := by
    obtain ⟨u,hu⟩ := (m22ToPairStabilizer_mem_range_iff_fixed_zero x).mpr h0
    rw [← hu]
    exact m22Embedding_fixed_nine u
  exact ⟨O,x,hx,hx2,h0,hxO,(hfixed 0).mp h0,(hfixed 9).mp h9,
    m22_quadratic_image_le_octad_centralizer O A x hx hx2 h0 hxO
      (hdim O x.val hxO hx1) hA.2.2⟩

private theorem m22_rank_le_two_of_point_stabilizer
    (A : Subgroup m22PairStabilizer) (x : m22PairStabilizer) (hx2 : orderOf x = 2)
    (hpoint : ∀ a ∈ A, a.val • (0 : Fin 24) = 0 → a.val ∈ Subgroup.zpowers x.val) :
    rank A ≤ 2 := by
  classical
  let f : MulAction.orbit A (0 : Fin 24) → m22Pair := fun i => ⟨i.val, by
    obtain ⟨a,ha⟩ := i.property
    rw [← ha]
    exact MulAction.mem_stabilizer_finset'.mp a.val.property (by simp [m22Pair])⟩
  have hf : Function.Injective f := fun a b h => Subtype.ext (congrArg (fun i : m22Pair => i.val) h)
  have ho : Nat.card (MulAction.orbit A (0 : Fin 24)) ≤ 2 :=
    (Nat.card_le_card_of_injective f hf).trans_eq (by
      rw [Nat.card_eq_fintype_card,Fintype.card_coe]
      decide)
  let k : MulAction.stabilizer A (0 : Fin 24) → Subgroup.zpowers x.val := fun a =>
    ⟨a.val.val.val, hpoint a.val.val a.val.property a.property⟩
  have hk : Function.Injective k := by
    intro a b h
    apply Subtype.ext
    apply Subtype.ext
    apply Subtype.ext
    exact congrArg (fun i : Subgroup.zpowers x.val => i.val) h
  have hs : Nat.card (MulAction.stabilizer A (0 : Fin 24)) ≤ 2 :=
    (Nat.card_le_card_of_injective k hk).trans_eq (by
      rw [Nat.card_zpowers]
      exact (orderOf_injective m22PairStabilizer.subtype Subtype.val_injective x).trans hx2)
  have hc := Nat.card_congr (MulAction.orbitProdStabilizerEquivGroup A (0 : Fin 24))
  rw [Nat.card_prod] at hc
  have hb : Nat.card A ≤ 4 := by nlinarith
  exact Nat.log_mono_right hb

/-- The M22 code consumer needs only the point-stabilizer part of the remaining
Dz action on the octad. Orbit-stabilizer gives rank two; H.16.2(7) gives six fixed
dimensions on the actual ambient image. -/
theorem m22_code_geometry_of_point_stabilizers
    (hdim : ∀ (O : Octad) (z : M24), z ∈ octadKernel O → z ≠ 1 →
      Module.finrank (ZMod 2) (codeOctadInvolutionFixed O z) = 4)
    (hfixed : ∀ (O : Octad) (z : M24), z ∈ octadKernel O → z ≠ 1 →
      ∀ B : Subgroup M24, z ∈ B → B ≤ codeOctadInvolutionCentralizer O z →
        Module.finrank (ZMod 2) (fixedSpace codeRepresentation B) = 8 - rank B)
    (hpoint : ∀ (O : Octad) (z : M24), z ∈ octadKernel O → z ≠ 1 →
      ∀ a ∈ codeOctadInvolutionCentralizer O z, ∀ i ∈ O.val,
        a • i = i → a ∈ Subgroup.zpowers z) :
    ∀ A ∈ quadraticSubgroups m22OuterCodeRepresentation,
      rank A = 2 ∧ Module.finrank (ZMod 2)
        (fixedSpace codeRepresentation (A.map m22PairStabilizer.subtype)) = 6 := by
  intro A hA
  obtain ⟨O,x,hx,hx2,h0,hxO,hO0,_,hAD⟩ := m22_quadratic_native_placement hdim A hA
  have hx1 : x.val ≠ 1 := by
    intro he
    have : x = 1 := Subtype.ext he
    simp [this] at hx2
  have hrle := m22_rank_le_two_of_point_stabilizer A x hx2 (by
    intro a ha hf
    exact hpoint O x.val hxO hx1 a.val (hAD (Subgroup.mem_map_of_mem _ ha)) 0 hO0 hf)
  have hr : rank A = 2 := by have := hA.2.1; omega
  have hrmap : rank (A.map m22PairStabilizer.subtype) = 2 := by
    rw [rank, Subgroup.card_map_of_injective Subtype.val_injective]
    exact hr
  refine ⟨hr, ?_⟩
  rw [hfixed O x.val hxO hx1 _ (Subgroup.mem_map_of_mem _ hx) hAD, hrmap]

/-- The cocode consumer uses the same point-stabilizer geometry and the remaining
six-dimensional ambient displacement span. Both maps are the literal M22 maps. -/
theorem m22_cocode_geometry_of_point_stabilizers_and_spans
    (hdim : ∀ (O : Octad) (z : M24), z ∈ octadKernel O → z ≠ 1 →
      Module.finrank (ZMod 2) (codeOctadInvolutionFixed O z) = 4)
    (hfixed : ∀ (O : Octad) (z : M24), z ∈ octadKernel O → z ≠ 1 →
      ∀ B : Subgroup M24, z ∈ B → B ≤ codeOctadInvolutionCentralizer O z →
        Module.finrank (ZMod 2) (fixedSpace codeRepresentation B) = 8 - rank B)
    (hpoint : ∀ (O : Octad) (z : M24), z ∈ octadKernel O → z ≠ 1 →
      ∀ a ∈ codeOctadInvolutionCentralizer O z, ∀ i ∈ O.val,
        a • i = i → a ∈ Subgroup.zpowers z)
    (hspan : ∀ (O : Octad) (z d : M24), z ∈ octadKernel O → z ≠ 1 →
      d ∈ codeOctadInvolutionCentralizer O z → d ∉ Subgroup.zpowers z →
        Module.finrank (ZMod 2) (LinearMap.range (displacement codeRepresentation z) ⊔
          LinearMap.range (displacement codeRepresentation d) : Submodule (ZMod 2) Code) = 6) :
    ∀ A ∈ quadraticSubgroups m22OuterCodeRepresentation,
      rank A = 2 ∧ ∃ x d : m22PairStabilizer,
        x ∈ A ∧ d ∈ A ∧ orderOf x = 2 ∧ x.val • (0 : Fin 24) = 0 ∧
        Module.finrank (ZMod 2) (LinearMap.range (displacement codeRepresentation x.val) ⊔
          LinearMap.range (displacement codeRepresentation d.val) : Submodule (ZMod 2) Code) = 6 := by
  intro A hA
  have hr := (m22_code_geometry_of_point_stabilizers hdim hfixed hpoint A hA).1
  obtain ⟨O,x,hx,hx2,h0,hxO,_,_,hAD⟩ := m22_quadratic_native_placement hdim A hA
  have hx1 : x.val ≠ 1 := by
    intro he
    have : x = 1 := Subtype.ext he
    simp [this] at hx2
  have hex : ∃ d : m22PairStabilizer, d ∈ A ∧ d.val ∉ Subgroup.zpowers x.val := by
    by_contra! hn
    have hle : A.map m22PairStabilizer.subtype ≤ Subgroup.zpowers x.val := by
      rintro _ ⟨d,hd,rfl⟩
      exact hn d hd
    have hc := Subgroup.card_le_of_le hle
    have hox : orderOf x.val = 2 :=
      (orderOf_injective m22PairStabilizer.subtype Subtype.val_injective x).trans hx2
    rw [Subgroup.card_map_of_injective Subtype.val_injective, Nat.card_zpowers, hox] at hc
    have hlog := Nat.log_mono_right (b := 2) hc
    change rank A ≤ 1 at hlog
    omega
  obtain ⟨d,hd,hdz⟩ := hex
  exact ⟨hr,x,d,hx,hd,hx2,h0,hspan O x.val d.val hxO hx1
    (hAD (Subgroup.mem_map_of_mem _ hd)) hdz⟩

/-- Once the orthogonal-quotient calculation supplies six independent
commutator directions, H.16.2(7) forces equality with the fixed six-space.
The dual codimension then follows from annihilator duality. -/
theorem octad_pair_spaces_of_span_lower (O : Octad) (z d : M24)
    (hz : z ∈ octadKernel O) (hz1 : z ≠ 1)
    (hdim : Module.finrank (ZMod 2) (codeOctadInvolutionFixed O z) = 4)
    (hd : d ∈ codeOctadInvolutionCentralizer O z) (hdz : d ∉ Subgroup.zpowers z)
    (hD : IsElementaryAbelian 2 (codeOctadInvolutionCentralizer O z))
    (hfixed : ∀ B : Subgroup M24, z ∈ B → B ≤ codeOctadInvolutionCentralizer O z →
      Module.finrank (ZMod 2) (fixedSpace codeRepresentation B) = 8 - rank B)
    (hspan : 6 ≤ Module.finrank (ZMod 2)
      (LinearMap.range (displacement codeRepresentation z) ⊔
        LinearMap.range (displacement codeRepresentation d) : Submodule (ZMod 2) Code)) :
    fixedSpace codeRepresentation (octadPair z d) =
        subspaceCommutator codeRepresentation ⊤ (octadPair z d) ∧
      Module.finrank (ZMod 2)
        (LinearMap.range (displacement codeRepresentation z) ⊔
          LinearMap.range (displacement codeRepresentation d) : Submodule (ZMod 2) Code) = 6 ∧
      fixedCodim codeRepresentation.dual (octadPair z d) = 6 := by
  obtain ⟨hq,hcomm⟩ := octad_pair_quadratic_commutator O z d hz hz1 hdim hd hD
  have hfix := (octad_pair_rank_fixed O z d hz1 hd hdz hD hfixed).2
  have hle : subspaceCommutator codeRepresentation ⊤ (octadPair z d) ≤
      fixedSpace codeRepresentation (octadPair z d) := by
    apply Submodule.span_le.mpr
    rintro _ ⟨b,hb,v,_,rfl⟩ a
    exact hq a.val a.property b hb v
  have hbound := Submodule.finrank_mono hle
  rw [hcomm, hfix] at hbound
  have hspan_eq := Nat.le_antisymm hbound hspan
  refine ⟨(Submodule.eq_of_le_of_finrank_eq hle ?_).symm,hspan_eq,?_⟩
  · rw [hcomm,hspan_eq,hfix]
  · rw [fixedCodim_dual_eq_commutator,hcomm,hspan_eq]

end CFSG.Quasithin.ChapterK.Mathieu.OctadGeometry
