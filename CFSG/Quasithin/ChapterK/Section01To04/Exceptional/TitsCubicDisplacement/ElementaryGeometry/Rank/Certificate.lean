module

public import Theory.SpecificGroups.Tits.ConverseLocalCoverage.DoubleCosetCover.Data

/-!
# A checked coloring of the square-one candidates in the Tits Sylow subgroup

Among the 2048 certified normal forms, squaring and evaluating at point zero
leaves 144 candidates. A packed retraction certifies this cover. A coloring
with 32 colors separates any distinct candidates whose products agree at
point zero. In particular, it separates distinct commuting involutions.
Only necessary pointwise conditions are used, so no assertion that an
arbitrary point test detects permutation equality is needed.

The data are reproduced by `source/generate.py` from the existing certified
Parrott packed maps. Both finite assertions below are checked by the kernel.
Source: GM04 Table 13, internal p.53, and Lemma 8.8, p.57; the actual Sylow
normal forms come from Parrott (1972), p.683.
-/

@[expose] public section
namespace CFSG.Quasithin.ChapterK.Exceptional.TitsCubicDisplacement.ElementaryGeometry.RankCertificate
open Tits.ConverseLocalCoverage.DoubleCosetCertificate Tits.Atlas1600OrderCertificate

def candidatesData : Nat := 
def locationData : Nat := 
def colorData : Nat := 5510260279296930627426296157640829096976563686104950302869513045087905803537883360559041107202348645863700470905094597104897333973379634430731237278159025810357438975819847004726942357699916844989134332406487897653504
def candidate (i : Fin 144) : Fin 2048 :=
  ⟨(candidatesData >>> (11 * i.val)) % 2048, Nat.mod_lt _ (by decide)⟩
def locate (n : Fin 2048) : Fin 144 :=
  ⟨((locationData >>> (8 * n.val)) % 256) % 144, Nat.mod_lt _ (by decide)⟩
def color (i : Fin 144) : Fin 32 :=
  ⟨(colorData >>> (5 * i.val)) % 32, Nat.mod_lt _ (by decide)⟩
def squareTest (n : Fin 2048) : Bool :=
  fastNormalForm n (fastNormalForm n 0) == 0
def commuteTest (i j : Fin 144) : Bool :=
  fastNormalForm (candidate i) (fastNormalForm (candidate j) 0) ==
    fastNormalForm (candidate j) (fastNormalForm (candidate i) 0)

set_option maxRecDepth 20000 in
/-- Every possible square-one normal form occurs in the candidate list. -/
theorem candidate_locate (n : Fin 2048) :
    squareTest n = true → candidate (locate n) = n := by
  revert n
  apply allFin
  decide +kernel

set_option maxRecDepth 20000 in
/-- Equal colors and commuting point images force equal candidate indices. -/
theorem color_separates (i j : Fin 144) :
    color i = color j → commuteTest i j = true → i = j := by
  revert i j
  apply allFin₂
  decide +kernel

end CFSG.Quasithin.ChapterK.Exceptional.TitsCubicDisplacement.ElementaryGeometry.RankCertificate
