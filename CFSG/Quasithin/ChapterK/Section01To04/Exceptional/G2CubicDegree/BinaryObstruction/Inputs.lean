module

public import Theory.Representation.BinaryOffender.NormalizerConjugateBound
public import Theory.AtlasPort.LinearGroups.G2.Basic

/-!
# The concrete inputs to the binary G₂ cubic obstruction

These interfaces keep the two remaining calculations separate: displacement
of inner and outer involutions on the actual irreducible action, and an
involution supplement to a rank-three elementary subgroup in its full linear
normalizer. Neither interface assumes the desired cubic fixed-space bound.

The generation witness permits the common-fixed-space argument in
Guralnick--Malle, Classification of 2F-modules I, Proposition 4.3, pp.10--11.
The literal action image is used, including in the inner-involution definition.
-/

@[expose] public section
namespace CFSG.Quasithin.ChapterK.Exceptional.G2CubicDegree.BinaryObstruction
open Subgroup Representation Representation.BinaryOffender

abbrev Derived := commutator (Atlas.G2.Model (ZMod 2))

variable {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]

/-- An involution acting by an actual element of the derived component. -/
def innerInvolution (σ : Representation (ZMod 2) Derived V)
    (t : linearNormalizer σ) : Prop :=
  ∃ x : Derived, x ^ 2 = 1 ∧ t.val = σ.asGroupHom x

/-- The two individual-involution calculations in GM Part I, Proposition 4.3. -/
structure InvolutionBounds (σ : Representation (ZMod 2) Derived V) : Prop where
  inner_fixedCodim_ge_five :
    ∀ t : linearNormalizer σ, t ≠ 1 → t ^ 2 = 1 → innerInvolution σ t →
      5 ≤ fixedCodim (normalizerRepresentation σ) (zpowers t)
  outer_fixedCodim_ge_six :
    ∀ t : linearNormalizer σ, t ≠ 1 → t ^ 2 = 1 → ¬ innerInvolution σ t →
      6 ≤ fixedCodim (normalizerRepresentation σ) (zpowers t)

/-- The component is contained in the group generated by a rank-three actor
and one involution of the same full linear normalizer. -/
def RankThreeGeneration (σ : Representation (ZMod 2) Derived V) : Prop :=
  ∀ A : Subgroup (linearNormalizer σ), IsElementaryTwo A → rank A = 3 →
    ∃ t : linearNormalizer σ, t ^ 2 = 1 ∧ normalizerActor σ ≤ A ⊔ zpowers t

end CFSG.Quasithin.ChapterK.Exceptional.G2CubicDegree.BinaryObstruction
