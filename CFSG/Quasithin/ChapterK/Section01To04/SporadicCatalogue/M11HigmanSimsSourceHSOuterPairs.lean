module
public import CFSG.Quasithin.ChapterK.Section01To04.SporadicCatalogue.M11HigmanSimsSourceHSOuterSymmetricInvolution
public import Theory.Representation.GeneratedSubgroupInvariants
public import Theory.SpecificGroups.SymmetricEight.ElementaryPairFive
/-!
# Both HS outer bounds from two actual centralizer conjugates

Let t be a symmetric outer involution in an elementary actor A of rank at
least four. The inner intersection has rank at least three. The marked S₈
centralizer supplies c centralizing t and an inner element x of order five
in the group generated by A and its conjugate by c.

The two fixed spaces lie in C_V(t), and their intersection lies in C_V(x).
Thus twice the displacement of A is at least the sum of the displacements of
t and x. The proved bounds six and sixteen give displacement at least eleven.
No representation-model comparison or splitting of a filtration is needed.

This proves both symmetric actor bounds. The existing elementary-centralizer
closure argument then proves the elementary branch, including rank five.
The final source exclusion retains only degree-window recognition.

Source: Guralnick--Malle, Classification of 2F-modules I, Proposition 5.1,
HS paragraph, author-preprint pp.16--17; Aschbacher--Smith K.4,
printed p.457/PDF p.468. The S₈ argument explicitly includes regular E₈ actors.
-/

public section
open Subgroup Theory.GroupTheory Representation.BinaryOffender
open CFSG.Quasithin.ChapterB.ComponentRecognition.KnownFFTypes.Sporadic.Leech
open HigmanSims Twenty
open Sporadic.LeechRelated.HS (Carrier)
namespace CFSG.Quasithin.ChapterK.SporadicCatalogue
universe u v
variable {G : Type u} {V : Type v} [Group G] [Finite G]
  [AddCommGroup V] [Module (ZMod 2) V] [FiniteDimensional (ZMod 2) V]
  {ρ : Representation (ZMod 2) G V}
omit [Finite G] in
private theorem pair_dimension {A : Subgroup G} {t c x : G}
    (ht : t ∈ A) (hc : c ∈ centralizer ({t} : Set G))
    (hx : x ∈ A ⊔ A.map (MulAut.conj c).toMonoidHom) :
    fixedCodim ρ (zpowers x) + fixedCodim ρ (zpowers t) ≤ 2 * fixedCodim ρ A := by
  let B := A.map (MulAut.conj c).toMonoidHom
  have htB : t ∈ B := by
    refine ⟨t, ht, ?_⟩
    change c * t * c⁻¹ = t
    rw [mem_centralizer_singleton_iff.mp hc]
    simp only [mul_inv_cancel_right]
  have hs : fixedSpace ρ A ⊔ fixedSpace ρ B ≤ fixedSpace ρ (zpowers t) :=
    sup_le (fixedSpace_antitone ρ (zpowers_le.mpr ht))
      (fixedSpace_antitone ρ (zpowers_le.mpr htB))
  have hi : fixedSpace ρ A ⊓ fixedSpace ρ B ≤ fixedSpace ρ (zpowers x) := by
    have he : fixedSpace ρ (A ⊔ B) = fixedSpace ρ A ⊓ fixedSpace ρ B :=
      ρ.invariants_comp_sup A B
    rw [← he]
    exact fixedSpace_antitone ρ (zpowers_le.mpr hx)
  have hsum := (fixedSpace ρ A).finrank_sup_add_finrank_inf_eq (fixedSpace ρ B)
  have hsm := Submodule.finrank_mono hs
  have him := Submodule.finrank_mono hi
  have hA := fixedCodim_add_finrank ρ A
  have hB := fixedCodim_add_finrank ρ B
  have ht' := fixedCodim_add_finrank ρ (zpowers t)
  have hx' := fixedCodim_add_finrank ρ (zpowers x)
  have he : fixedCodim ρ B = fixedCodim ρ A := fixedCodim_map_conj ρ A c
  omega

private theorem symmetric_pair_bound (h : HigmanSims.SourceHypotheses ρ)
    (hd : Module.finrank (ZMod 2) V = 20)
    (e : generalizedFitting G ⧸ center (generalizedFitting G) ≃* Carrier)
    {A : Subgroup G} {t c x : G} (htA : t ∈ A) (htS : IsSymmetricOuter e t)
    (hc : c ∈ centralizer ({t} : Set G))
    (hx : x ∈ A ⊔ A.map (MulAut.conj c).toMonoidHom)
    (hxL : x ∈ generalizedFitting G) (hx5 : orderOf x = 5) :
    11 ≤ fixedCodim ρ A := by
  have hp := pair_dimension (ρ := ρ) htA hc hx
  have ht := higmanSims_symmetric_outer_involution_bound h hd e htS
  have hx' := higmanSims_inner_order_five_bound h hd hxL hx5
  omega

/-- Every symmetric outer elementary actor of rank at least four moves
at least eleven dimensions in the original degree-twenty source module. -/
theorem higmanSims_symmetric_outer_actor_bound
    (h : HigmanSims.SourceHypotheses ρ)
    (hd : Module.finrank (ZMod 2) V = 20)
    (e : generalizedFitting G ⧸ center (generalizedFitting G) ≃* Carrier)
    {A : Subgroup G} (hA : IsElementaryTwo A) (hr : 4 ≤ rank A)
    {t : G} (htA : t ∈ A) (htS : IsSymmetricOuter e t) :
    11 ≤ fixedCodim ρ A := by
  let := hA.2
  let K := Symmetric.innerCentralizer t
  let D := A ⊓ generalizedFitting G
  have hAC : A ≤ centralizer ({t} : Set G) := by
    intro a ha
    exact mem_centralizer_singleton_iff.mpr (congrArg Subtype.val
      ((IsMulCommutative.is_comm (M := A)).comm (⟨a, ha⟩ : A) ⟨t, htA⟩))
  have hDK : D ≤ K := le_inf (inf_le_left.trans hAC) inf_le_right
  have hDr : 3 ≤ rank D := by
    have hb := rank_le_inner_rank_add_one h hA
    change rank A ≤ rank D + 1 at hb
    omega
  have hDne : D ≠ ⊥ := by
    intro he
    rw [he, Representation.BinaryOffender.rank_bot] at hDr
    omega
  have hD := hA.of_le (show D ≤ A from inf_le_left) hDne
  let := hD.2
  obtain ⟨_, k, _, _⟩ := HSOuterCalculations.symmetric_marked_centralizer h e htS
  let B := (D.subgroupOf K).map k.toMonoidHom
  let : IsElementaryAbelian 2 (D.subgroupOf K) := IsElementaryAbelian.subgroupOf hDK
  let : IsElementaryAbelian 2 B := IsElementaryAbelian.map k.toMonoidHom
  have hcard : 8 ≤ Nat.card B := by
    rw [card_map_of_injective k.injective,
      Nat.card_congr (subgroupOfEquivOfLe hDK).toEquiv, hD.card_eq_two_pow_rank]
    exact Nat.pow_le_pow_right (by decide : 1 ≤ 2) hDr
  obtain ⟨c,x,hx,ho⟩ := Theory.SpecificGroups.SymmetricEight.ElementaryPairFive.exists_order_five_in_pair B hcard
  let φ : Equiv.Perm (Fin 8) →* G := K.subtype.comp k.symm.toMonoidHom
  have hφC : φ c ∈ centralizer ({t} : Set G) := (k.symm c).property.1
  have hφL : φ x ∈ generalizedFitting G := (k.symm x).property.2
  have hφB {y : Equiv.Perm (Fin 8)} (hy : y ∈ B) : φ y ∈ A := by
    obtain ⟨z,hz,rfl⟩ := hy
    change ((k.symm (k z) : K) : G) ∈ A
    rw [k.symm_apply_apply]
    exact hz.1
  have hφx : φ x ∈ A ⊔ A.map (MulAut.conj (φ c)).toMonoidHom := by
    let J := A ⊔ A.map (MulAut.conj (φ c)).toMonoidHom
    have hle : B ⊔ B.map (MulAut.conj c).toMonoidHom ≤ J.comap φ := by
      apply sup_le
      · intro y hy
        exact Subgroup.mem_sup_left (hφB hy)
      · rintro y ⟨z,hz,rfl⟩
        change φ (c * z * c⁻¹) ∈ J
        rw [map_mul,map_mul,map_inv]
        exact Subgroup.mem_sup_right (mem_map_of_mem (MulAut.conj (φ c)).toMonoidHom (hφB hz))
    exact hle hx
  have hφ5 : orderOf (φ x) = 5 :=
    (orderOf_injective φ (K.subtype_injective.comp k.symm.injective) x).trans ho
  exact symmetric_pair_bound h hd e htA htS hφC hφx hφL hφ5
/-- Both symmetric outer actor bounds, on the original source module.
The proof uses two actual centralizer conjugates and an inner five-element. -/
theorem higmanSims_symmetric_outer_estimates (h : HigmanSims.SourceHypotheses ρ)
    (hd : Module.finrank (ZMod 2) V = 20)
    (e : generalizedFitting G ⧸ center (generalizedFitting G) ≃* Carrier) :
    SymmetricOuterEstimates ρ e := by
  constructor
  · intro t _ htS
    exact higmanSims_symmetric_outer_involution_bound h hd e htS
  · intro A hA hr t htA htS
    exact (by decide : 10 ≤ 11).trans
      (higmanSims_symmetric_outer_actor_bound h hd e hA hr.ge htA htS)
  · intro A hA hr t htA htS
    exact higmanSims_symmetric_outer_actor_bound h hd e hA (by omega) htA htS

omit [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V] in
/-- The degree-twenty outer estimates for every original HS source action
and every literal central-quotient marking, with both branches discharged. -/
theorem higmanSims_outer_estimates : HigmanSimsOuterEstimates.{u,v} := by
  intro G V _ _ _ _ _ ρ h hd e
  have hS := higmanSims_symmetric_outer_estimates h hd e
  exact ⟨higmanSims_elementary_outer_estimates_of_symmetric h hd e hS, hS⟩

omit [Group G] [Finite G] [AddCommGroup V] [Module (ZMod 2) V]
  [FiniteDimensional (ZMod 2) V] in
/-- The source HS exclusion now needs only degree-window recognition.
The inner and both outer displacement calculations have been proved. -/
theorem sourceExclusion_hs_of_degree
    (hdegree : HigmanSimsDegreeWindow.{u,v}) : SourceExclusion.{u,v} .hs :=
  sourceExclusion_hs_of_degree_and_outer hdegree higmanSims_outer_estimates

/-- The degree-only HS exclusion on the original rank-one source component. -/
theorem not_hs_of_rankOne_source_of_degree
    (hdegree : HigmanSimsDegreeWindow.{u,v}) {L : Subgroup G}
    (h : RankOne.SourceHypotheses ρ L)
    (he : Nonempty (L ⧸ center L ≃* KnownSimple.SporadicName.hs.Carrier)) : False :=
  not_hs_of_rankOne_source_of_degree_and_outer hdegree higmanSims_outer_estimates h he

end CFSG.Quasithin.ChapterK.SporadicCatalogue
