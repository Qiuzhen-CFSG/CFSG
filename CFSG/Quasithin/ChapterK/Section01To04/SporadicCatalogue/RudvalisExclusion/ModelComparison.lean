module

public import CFSG.Quasithin.ChapterK.Section01To04.SporadicCatalogue.RudvalisExclusion.Contracts
public import CFSG.Quasithin.ChapterK.Section01To04.SporadicCatalogue.RudvalisExclusion.ModelComparison.Orbit

/-!
# The marked Rudvalis matrix/permutation comparison

The subgroup generated by the two pairs of standard generators projects onto
both prescribed generated groups. Equivariance extends from the generators
to this subgroup. Since the certified orbit spans the vector space, its
permutation projection is injective; since its labels are distinct, its
matrix projection is injective. Composing the two projection equivalences
produces `standardComparison`, without group-order or simplicity assumptions.

The resulting matrix-group permutation action is faithful, has exactly the
original generated permutation image, and acts on the literal orbit vectors.
The comparison also intertwines `standardRepresentation` with the existing
permutation action on those vectors.

Source: Wilson--Nickerson--Bray, ATLAS degree-28 binary and degree-4060
permutation representations of Ru. The original files, attribution, and
inverse-action conventions are retained in `source/README.md` and
`Theory/SpecificGroups/Rudvalis/Model/PermutationData.lean`. This discharges
the marked carrier comparison in `Contracts.StandardComparison`; the parent
source exclusion retains its separate recognition and normalizer obligations.
-/

namespace CFSG.Quasithin.ChapterK.SporadicCatalogue.RudvalisExclusion.ModelComparison
abbrev Operators := (Module.End (ZMod 2) Space)ˣ
abbrev Permutations := Equiv.Perm (Fin 4060)
def pairedGroup : Subgroup (Permutations × Operators) :=
  Subgroup.closure {(Rudvalis.aPerm, generatorA), (Rudvalis.bPerm, generatorB)}
def leftProjection : pairedGroup →* Permutations :=
  (MonoidHom.fst _ _).comp pairedGroup.subtype
def rightProjection : pairedGroup →* Operators :=
  (MonoidHom.snd _ _).comp pairedGroup.subtype
lemma left_range : leftProjection.range = Rudvalis.modelSubgroup := by
  rw [leftProjection, MonoidHom.range_comp, Subgroup.range_subtype, pairedGroup,
    MonoidHom.map_closure, Set.image_insert_eq, Set.image_singleton]
  rfl
lemma right_range : rightProjection.range = standardGroup := by
  rw [rightProjection, MonoidHom.range_comp, Subgroup.range_subtype, pairedGroup,
    MonoidHom.map_closure, Set.image_insert_eq, Set.image_singleton]
  rfl
lemma paired_equivariance (g : pairedGroup) (i : Fin 4060) :
    g.val.2.val (orbitVector i) = orbitVector (g.val.1 i) := by
  have h : ∀ p ∈ pairedGroup, ∀ j, p.2.val (orbitVector j) = orbitVector (p.1 j) := by
    intro p hp
    induction hp using Subgroup.closure_induction with
    | mem p hp =>
      rcases hp with rfl | hp
      · exact generatorA_equivariant
      · obtain rfl := Set.mem_singleton_iff.mp hp
        exact generatorB_equivariant
    | one => intro j; rfl
    | mul p q hp hq ihp ihq =>
      intro j
      change p.2.val (q.2.val (orbitVector j)) = orbitVector (p.1 (q.1 j))
      rw [ihq, ihp]
    | inv p hp ih =>
      intro j
      have he := congrArg (fun v => p.2.inv v) (ih (p.1⁻¹ j))
      have hc (v : Space) : p.2.inv (p.2.val v) = v :=
        congrArg (fun f : Module.End (ZMod 2) Space => f v) p.2.inv_val
      rw [hc] at he
      change orbitVector (p.1⁻¹ j) = p.2.inv (orbitVector (p.1 (p.1.symm j))) at he
      rw [p.1.apply_symm_apply] at he
      exact he.symm
  exact h g.val g.property i
lemma left_injective : Function.Injective leftProjection := by
  intro g h he
  apply Subtype.ext
  apply Prod.ext he
  apply Units.ext
  apply LinearMap.ext_on_range orbitVector_span
  intro i
  change g.val.2.val (orbitVector i) = h.val.2.val (orbitVector i)
  rw [paired_equivariance g, paired_equivariance h]
  exact congrArg orbitVector (congrArg (fun p : Permutations => p i) he)
lemma right_injective : Function.Injective rightProjection := by
  intro g h he
  apply Subtype.ext
  apply Prod.ext _ he
  apply Equiv.ext
  intro i
  apply orbitVector_injective
  change orbitVector (g.val.1 i) = orbitVector (h.val.1 i)
  rw [← paired_equivariance g, ← paired_equivariance h]
  exact congrArg (fun u : Operators => u.val (orbitVector i)) he

def toPermutation : pairedGroup →* Rudvalis.Model :=
  leftProjection.codRestrict Rudvalis.modelSubgroup
    (fun g => left_range ▸ (show leftProjection g ∈ leftProjection.range from ⟨g, rfl⟩))
def toMatrix : pairedGroup →* standardGroup :=
  rightProjection.codRestrict standardGroup
    (fun g => right_range ▸ (show rightProjection g ∈ rightProjection.range from ⟨g, rfl⟩))
lemma toPermutation_bijective : Function.Bijective toPermutation := by
  constructor
  · intro g h he
    exact left_injective (congrArg Subtype.val he)
  · intro p
    have hp : p.val ∈ leftProjection.range := left_range.symm ▸ p.property
    obtain ⟨g, hg⟩ := hp
    exact ⟨g, Subtype.ext hg⟩
lemma toMatrix_bijective : Function.Bijective toMatrix := by
  constructor
  · intro g h he
    exact right_injective (congrArg Subtype.val he)
  · intro p
    have hp : p.val ∈ rightProjection.range := right_range.symm ▸ p.property
    obtain ⟨g, hg⟩ := hp
    exact ⟨g, Subtype.ext hg⟩
noncomputable def permutationEquiv : pairedGroup ≃* Rudvalis.Model :=
  MulEquiv.ofBijective toPermutation toPermutation_bijective
noncomputable def matrixEquiv : pairedGroup ≃* standardGroup :=
  MulEquiv.ofBijective toMatrix toMatrix_bijective
public noncomputable def comparison : Rudvalis.Model ≃* standardGroup :=
  permutationEquiv.symm.trans matrixEquiv
public theorem comparison_a : (comparison Rudvalis.a).val = generatorA := by
  let p : pairedGroup := ⟨(Rudvalis.aPerm, generatorA),
    Subgroup.subset_closure (Set.mem_insert _ _)⟩
  have hp : permutationEquiv p = Rudvalis.a := rfl
  change (matrixEquiv (permutationEquiv.symm Rudvalis.a)).val = generatorA
  rw [← hp, permutationEquiv.symm_apply_apply]
  rfl
public theorem comparison_b : (comparison Rudvalis.b).val = generatorB := by
  let p : pairedGroup := ⟨(Rudvalis.bPerm, generatorB),
    Subgroup.subset_closure (Set.mem_insert_of_mem _ (Set.mem_singleton _))⟩
  have hp : permutationEquiv p = Rudvalis.b := rfl
  change (matrixEquiv (permutationEquiv.symm Rudvalis.b)).val = generatorB
  rw [← hp, permutationEquiv.symm_apply_apply]
  rfl

/-- The carrier comparison intertwines the actual standard representation
with the permutation action on the certified orbit. -/
public theorem comparison_equivariant (g : Rudvalis.Model) (i : Fin 4060) :
    standardRepresentation (comparison g) (orbitVector i) = orbitVector (g • i) := by
  have h := paired_equivariance (permutationEquiv.symm g) i
  have he : (permutationEquiv.symm g).val.1 = g.val :=
    congrArg Subtype.val (permutationEquiv.apply_symm_apply g)
  rw [he] at h
  exact h

/-- The matrix group acts faithfully on the certified 4060 orbit vectors. -/
public noncomputable def matrixPermutationAction : standardGroup →* Equiv.Perm (Fin 4060) :=
  leftProjection.comp matrixEquiv.symm.toMonoidHom

public theorem matrixPermutationAction_injective : Function.Injective matrixPermutationAction :=
  left_injective.comp matrixEquiv.symm.injective

public theorem matrixPermutationAction_range : matrixPermutationAction.range = Rudvalis.modelSubgroup := by
  rw [matrixPermutationAction, MonoidHom.range_comp, (MonoidHom.range_eq_top_of_surjective _ matrixEquiv.symm.surjective),
    ← MonoidHom.range_eq_map, left_range]

public theorem matrixPermutationAction_equivariant (g : standardGroup) (i : Fin 4060) :
    g.val.val (orbitVector i) = orbitVector (matrixPermutationAction g i) := by
  have h := paired_equivariance (matrixEquiv.symm g) i
  have he : (matrixEquiv.symm g).val.2 = g.val :=
    congrArg Subtype.val (matrixEquiv.apply_symm_apply g)
  rw [he] at h
  exact h

end CFSG.Quasithin.ChapterK.SporadicCatalogue.RudvalisExclusion.ModelComparison

namespace CFSG.Quasithin.ChapterK.SporadicCatalogue.RudvalisExclusion
/-- The concrete degree-28 binary module and the 4060-point carrier are
isomorphic, with both original standard generators marked. -/
public theorem standardComparison : StandardComparison :=
  ⟨ModelComparison.comparison, ModelComparison.comparison_a, ModelComparison.comparison_b⟩
end CFSG.Quasithin.ChapterK.SporadicCatalogue.RudvalisExclusion
