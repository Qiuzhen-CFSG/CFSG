module

public import Theory.Representation.BinaryOffender.NormalizerExtension
public import Mathlib.LinearAlgebra.Matrix.ToLin

/-!
# The explicit binary degree-28 action used in the Rudvalis calculation

The two invertible operators are the inverse transposes of the ATLAS matrices
`RuG1-f2r28B0`. This converts the original right action on row vectors to a
left action on columns while preserving products of words. The unmodified
matrices and the translator are retained in `source/`. The three inverse
identities below are checked by the kernel.

The generated matrix group and its full linear normalizer are concrete finite
groups. Their identification with the permutation carrier `Rudvalis.Model`,
small-module recognition, and the cubic exclusion are separate obligations;
none is built into these definitions.

Source: Wilson--Nickerson--Bray, ATLAS of Finite Group Representations,
https://brauer.maths.qmul.ac.uk/Atlas/v3/matrep/RuG1-f2r28B0 .
Application: Guralnick--Malle, Classification of 2F-modules I, Proposition 5.1
(Ru case) and Theorem 6.6; Aschbacher--Smith K.4, printed p.457.
-/

@[expose] public section
namespace CFSG.Quasithin.ChapterK.SporadicCatalogue.RudvalisExclusion

abbrev Space := Fin 28 → ZMod 2

-- BEGIN GENERATED TABLES
def matrixA : Matrix (Fin 28) (Fin 28) (ZMod 2) :=
  fun i j => if (17892069405080725233809404069213242783727217330809150723743462073674774264756932515053951864342985201552972630859977504029533133693030127255604495118366871494092208836030720977223173993426067029739298187703034945540962585637779211313917 : ℕ).testBit (28 * i.val + j.val) then 1 else 0

def matrixB : Matrix (Fin 28) (Fin 28) (ZMod 2) :=
  fun i j => if (46003239502499321416388190389543409855213991199371377933238801957134556573023758882471770672805646105747338883231265037618916388878476367659054638531936125358403167353787102298270584836071476835914014795236566395735950148993821744280891 : ℕ).testBit (28 * i.val + j.val) then 1 else 0

def matrixBInv : Matrix (Fin 28) (Fin 28) (ZMod 2) :=
  fun i j => if (31309014388451769187932618042381163483205778514426936471172591101623756601988942795884231024462694631127552245084428347364604318071501360884012918728247980947639478908844621134981009335589554406436335286094303061088135856571153206278609 : ℕ).testBit (28 * i.val + j.val) then 1 else 0
-- END GENERATED TABLES

theorem matrixA_mul_self : matrixA * matrixA = 1 := by decide +kernel

theorem matrixB_mul_inv : matrixB * matrixBInv = 1 := by decide +kernel

theorem matrixB_inv_mul : matrixBInv * matrixB = 1 := by decide +kernel

def generatorA : (Module.End (ZMod 2) Space)ˣ where
  val := Matrix.toLin' matrixA
  inv := Matrix.toLin' matrixA
  val_inv := by
    change (Matrix.toLin' matrixA).comp (Matrix.toLin' matrixA) = LinearMap.id
    rw [← Matrix.toLin'_mul, matrixA_mul_self, Matrix.toLin'_one]
  inv_val := by
    change (Matrix.toLin' matrixA).comp (Matrix.toLin' matrixA) = LinearMap.id
    rw [← Matrix.toLin'_mul, matrixA_mul_self, Matrix.toLin'_one]

def generatorB : (Module.End (ZMod 2) Space)ˣ where
  val := Matrix.toLin' matrixB
  inv := Matrix.toLin' matrixBInv
  val_inv := by
    change (Matrix.toLin' matrixB).comp (Matrix.toLin' matrixBInv) = LinearMap.id
    rw [← Matrix.toLin'_mul, matrixB_mul_inv, Matrix.toLin'_one]
  inv_val := by
    change (Matrix.toLin' matrixBInv).comp (Matrix.toLin' matrixB) = LinearMap.id
    rw [← Matrix.toLin'_mul, matrixB_inv_mul, Matrix.toLin'_one]

/-- The actual group generated by the two checked operators. -/
def standardGroup : Subgroup (Module.End (ZMod 2) Space)ˣ :=
  Subgroup.closure {generatorA, generatorB}

/-- Its tautological faithful action. -/
def standardRepresentation : Representation (ZMod 2) standardGroup Space :=
  (Units.coeHom _).comp standardGroup.subtype

instance : Finite standardGroup := by
  let : Finite (Module.End (ZMod 2) Space) := Finite.of_injective
    (fun f : Module.End (ZMod 2) Space => (f : Space → Space)) DFunLike.coe_injective
  infer_instance

instance : Finite (Representation.BinaryOffender.linearNormalizer standardRepresentation) := by
  let : Finite (Module.End (ZMod 2) Space) := Finite.of_injective
    (fun f : Module.End (ZMod 2) Space => (f : Space → Space)) DFunLike.coe_injective
  infer_instance

theorem standardRepresentation_injective : Function.Injective standardRepresentation := by
  intro x y h
  exact Subtype.ext (Units.ext h)

theorem finrank_space : Module.finrank (ZMod 2) Space = 28 := by
  simp [Space]

end CFSG.Quasithin.ChapterK.SporadicCatalogue.RudvalisExclusion
