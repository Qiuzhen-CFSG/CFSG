def sortedLabels : Nat := 

def search (x lo hi : Nat) : Nat → Nat
  | 0 => 4060
  | n+1 =>
    let mid := (lo+hi)/2
    let key := (sortedKeys >>> (28*mid)) % 2^28
    if x = key then (sortedLabels >>> (12*mid)) % 4096
    else if x < key then search x lo mid n else search x (mid+1) hi n

def labelOf (x : Nat) : Nat := search x 0 4060 12

