module

public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.ThreeCubicSieve.Outer.Tensors.AdjointWords.Exchange
public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.ThreeCubicSieve.Outer.Tensors.Realization.Actors

public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.ThreeCubicSieve.Outer.Tensors.AdjointWords.OuterModels.Coordinates
public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.ThreeCubicSieve.Outer.Tensors.Realization.Words.Forms

/-!
# Graph-or-exchange models for outer adjoint-word involutions

The public actor-lifting theorem, applied to the cyclic group generated by the
specified involution, lifts that same operator through the genuine central
quotient of its action image. A half-turn form gives paired component
coordinates and hence literal tensor interchange by absolute Schur rigidity.
A graph form gives the exact graph-action equation consumed independently by
`GraphModels`.

Binary automorphism coverage gives the graph or half-turn normal form,
including degrees one and two. The involution equation excludes inner,
odd-diagonal and scalar possibilities on the actual action image. The final
theorem discharges the normal-form input and constructs the published
`OuterModels` without a natural-word coordinate or companion-selection premise.
Source: GM, Classification of 2F-modules II, Proposition 4.8 steps 2–5,
manuscript pp.26–28; Aschbacher–Smith K.3.2, printed pp.454–456.
-/

public noncomputable section
open Representation Representation.BinaryOffender Subgroup
open Representation.BinaryOffender.SchurNormalizer
open CFSG.Quasithin.ChapterB.QuasisimpleSource
open scoped MatrixGroups
namespace CFSG.Quasithin.ChapterK.Linear.Recognition.ThreeCubicSieve.Outer.Tensors.AdjointWords.OuterModels
variable {B : BinaryField} {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V]
    {σ : Representation (ZMod 2) SL(3,B.Carrier) V} [IsIrreducible σ]

/-- Lift the specified outer involution, retaining its original operator.
The cyclic specialization uses the actual image and its central quotient,
without asserting faithfulness of the SL₃ action or normalizer conjugation. -/
theorem involution_lift (hk : σ.ker ≤ center _) (t : linearNormalizer σ)
    (ht : t ^ 2 = 1) (hout : t.val ∉ actionImage σ) :
    Nonempty (Realization.LiftedInvolution B σ t) := by
  classical
  have htne : t ≠ 1 := by
    intro h
    apply hout
    rw [h]
    exact (actionImage σ).one_mem
  have horder : orderOf t = 2 := by
    rcases (Nat.dvd_prime (by decide : Nat.Prime 2)).mp
      (orderOf_dvd_of_pow_eq_one ht) with h | h
    · exact (htne (orderOf_eq_one_iff.mp h)).elim
    · exact h
  have hA : IsElementaryTwo (zpowers t) := by
    refine ⟨?_, IsElementaryAbelian.zpowers_of_pow_eq_one ht⟩
    intro he
    apply htne
    have h := mem_zpowers t
    simpa only [he, mem_bot] using h
  have ho : ¬ (zpowers t).map (linearNormalizer σ).subtype ≤ actionImage σ := by
    intro he
    exact hout (he (mem_map.mpr ⟨t, mem_zpowers t, rfl⟩))
  obtain ⟨u, hu, L, _⟩ := Realization.lifted_outer_actors B σ hk (zpowers t) hA ho
  have hut : u.val = t := by
    have hm := u.property
    have hfin : IsOfFinOrder t := isOfFinOrder_iff_pow_eq_one.mpr ⟨2, by decide, ht⟩
    rw [hfin.mem_zpowers_iff_mem_range_orderOf, horder] at hm
    obtain ⟨i, hi, he⟩ := Finset.mem_image.mp hm
    have hi := Finset.mem_range.mp hi
    interval_cases i
    · have hue : u.val = 1 := by simpa only [pow_zero] using he.symm
      exact (hu (by rw [hue]; exact (actionImage σ).one_mem)).elim
    · simpa only [pow_one] using he.symm
  exact ⟨hut ▸ L⟩

end CFSG.Quasithin.ChapterK.Linear.Recognition.ThreeCubicSieve.Outer.Tensors.AdjointWords.OuterModels


namespace CFSG.Quasithin.ChapterK.Linear.Recognition.ThreeCubicSieve.Outer.Tensors.AdjointWords
open Representation.SL3.BinaryDefiningFactors

variable {B : BinaryField} {V : Type*} [AddCommGroup V] [Module (ZMod 2) V]
    [FiniteDimensional (ZMod 2) V]
    {σ : Representation (ZMod 2) SL(3,B.Carrier) V} [IsIrreducible σ]

/-- The field and graph-field half-turn cases act by actual tensor interchange.
Word pairing and the component equivalence are proved, then absolute Schur
rigidity recovers the original extended operator. -/
theorem exchangeRealization_of_halfTurn (M : RepeatedModel B σ)
    (ha : 0 < adjointCount M.block) {t : linearNormalizer σ}
    (hs : IsSchurLinear σ t) (L : Realization.LiftedInvolution B σ t)
    (H : Realization.HalfTurnForm B L.automorphism) :
    Nonempty (ExchangeRealization B σ t hs) := by
  obtain ⟨P⟩ := OuterModels.pairedCoordinates_of_halfTurn M H ha
    (H.word_pair M (L.word_character_fixed hs M))
  exact ⟨exchangeRealization_of_pairedCoordinates L hs P⟩

/-- Separate the outer-type normal form from the coordinate construction.
The actual lift, paired positions, tensor coordinates, and recovery of the
original operator are discharged in this application. -/
theorem outerModels_of_involutionForms (hk : σ.ker ≤ center _)
    (hforms : Realization.OuterInvolutionForms B σ) : OuterModels B σ := by
  intro M _ ha _ t ht hout hs
  obtain ⟨L⟩ := OuterModels.involution_lift hk t ht hout
  rcases hforms t hout hs L with hgraph | hfield
  · obtain ⟨c, hc⟩ := hgraph
    left
    refine ⟨c, fun g => ?_⟩
    have h := L.intertwines g
    simpa only [hc, MulAut.mul_apply] using h
  · obtain ⟨H⟩ := hfield
    exact Or.inr (exchangeRealization_of_halfTurn M ha hs L H)

/-- Every outer Schur-linear involution on an actual pure-adjoint repeated
model has the literal graph action or is actual tensor interchange on the
original Schur extension. Central kernels and the two smallest fields are
retained, and no additional operator-model premise remains. -/
theorem outer_models (hk : σ.ker ≤ center _) : OuterModels B σ :=
  outerModels_of_involutionForms hk (Realization.outer_involution_forms B σ hk)

end CFSG.Quasithin.ChapterK.Linear.Recognition.ThreeCubicSieve.Outer.Tensors.AdjointWords
