module

public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.BinaryCubicSieve.FiveDisplacement.Inner.EndNode.Levi.Irreducibility.GeometryData
public import CFSG.Quasithin.ChapterK.Section01To04.Linear.Recognition.BinaryCubicSieve.FiveDisplacement.Inner.EndNode.Levi.Highest

/-!
# Opposite-parabolic geometry in the actual binary SL₅ group

For each end node, the relative two-core has identity diagonal blocks and
is a product of four positive root transvections. Every positive root lies
either across the block boundary, hence in this two-core, or inside a
block, hence in the common Levi subgroup. Inverse transpose gives the
opposite containment and preserves that literal intersection.

The marked SL₄ quotient is generated by its root transvections. Each is
the image of the corresponding root in the actual Levi intersection, so
the restricted relative quotient map is surjective. These four statements
supply the geometry premises of the Smith–Timmesfeld argument, independently
of the Curtis fixed-line theorem.

Source: GLS, Volume 3, Theorem 2.8.11, `refs/KGroup/GLS3/chapter2.tex`,
printed pp.95–96; Guralnick–Malle, Classification of 2F-modules II,
Theorem 3.1 and Proposition 4.7(2). The four-root coordinate calculation
follows the radical calculation in the adjacent `Highest` module.
-/

public noncomputable section
namespace CFSG.Quasithin.ChapterK.Linear.Recognition.BinaryCubicSieve.FiveDisplacement.Inner.EndNode.Levi.Irreducibility
open Representation
open BinaryLinear.OuterCyclic BinaryLinear.FiveFlagGeometry
open BinaryLinear.FiveFlagGeometry.SylowOvergroups
open BinaryLinear.SmallParabolicLevi BinaryLinear.SmallParabolicLevi.TwoNodes
open SL5TenDimensional.Classification.HeckeAction

private def radicalRow (e : Fin 2) (i : Fin 4) : Fin 5 :=
  if e = 0 then 0 else i.castSucc
private def radicalColumn (e : Fin 2) (i : Fin 4) : Fin 5 :=
  if e = 0 then i.succ else 4
private theorem radical_lt (e : Fin 2) (i : Fin 4) :
    radicalRow e i < radicalColumn e i := by revert e i; decide
private def radicalRoot (e : Fin 2) (i : Fin 4) (c : ZMod 2) : SL5TenDimensional.Group :=
  Matrix.SpecialLinearGroup.transvection (ne_of_lt (radical_lt e i)) c
private def radicalWord (e : Fin 2) (c : Fin 4 → ZMod 2) : SL5TenDimensional.Group :=
  radicalRoot e 0 (c 0) * radicalRoot e 1 (c 1) *
    radicalRoot e 2 (c 2) * radicalRoot e 3 (c 3)

private theorem radicalWord_apply (e : Fin 2) (c : Fin 4 → ZMod 2) (i j : Fin 5) :
    (radicalWord e c).val i j =
      if label e i < label e j then
        if e = 0 then c ⟨j.val - 1, by have := j.isLt; omega⟩
        else c ⟨i.val % 4, Nat.mod_lt _ (by decide)⟩
      else if i = j then 1 else 0 := by
  fin_cases e <;> fin_cases i <;> fin_cases j <;>
    simp [radicalWord, radicalRoot, radicalRow, radicalColumn, label, node,
      Matrix.SpecialLinearGroup.coe_mul, Matrix.SpecialLinearGroup.transvection_coe,
      Matrix.mul_apply, Fin.sum_univ_succ, Matrix.single,
      Matrix.one_apply]

private theorem radical_eq_word (e : Fin 2) (g : parabolic e) (hg : g ∈ radical e) :
    g.val = radicalWord e (fun i => g.val.val (radicalRow e i) (radicalColumn e i)) := by
  apply Subtype.ext
  ext i j
  rw [radicalWord_apply]
  have hd := radical_diagonal e g hg
  have hz := (mem_parabolic_iff e g).mp g.property
  fin_cases e <;> fin_cases i <;> fin_cases j <;>
    simp [label, node, radicalRow, radicalColumn] <;>
    first | exact hd _ _ (by decide) | exact hz _ _ (by decide) (by decide)

/-- The actual relative radical is generated by positive roots. -/
theorem radicalImage_le_upper (e : Fin 2) : radicalImage e ≤ upper := by
  rintro g ⟨a, ha, rfl⟩
  change a.val ∈ upper
  rw [radical_eq_word e a ha]
  have hr (i : Fin 4) (c : ZMod 2) : radicalRoot e i c ∈ upper := by
    rcases (by decide : ∀ c : ZMod 2, c = 0 ∨ c = 1) c with rfl | rfl
    · simp [radicalRoot, Matrix.SpecialLinearGroup.transvection_coeff_zero]
    · exact Subgroup.subset_closure ⟨radicalRow e i, radicalColumn e i,
        radical_lt e i, rfl⟩
  exact upper.mul_mem (upper.mul_mem (upper.mul_mem (hr _ _) (hr _ _)) (hr _ _)) (hr _ _)

private theorem graph_involutive (g : SL5TenDimensional.Group) :
    graphSL 5 (graphSL 5 g) = g :=
  (graphSL 5).left_inv g

private theorem transpose_root (i j : Fin 5) (hij : i ≠ j) (c : ZMod 2) :
    Matrix.SpecialLinearGroup.transpose (Matrix.SpecialLinearGroup.transvection hij c) =
      Matrix.SpecialLinearGroup.transvection hij.symm c := by
  apply Subtype.ext
  ext a b
  simp [Matrix.SpecialLinearGroup.transpose, Matrix.SpecialLinearGroup.transvection_coe,
    Matrix.transpose_apply, Matrix.single, Matrix.one_apply, and_comm]

private theorem graph_root (i j : Fin 5) (hij : i ≠ j) (c : ZMod 2) :
    graphSL 5 (Matrix.SpecialLinearGroup.transvection hij c) =
      Matrix.SpecialLinearGroup.transvection hij.symm (-c) := by
  change (Matrix.SpecialLinearGroup.transpose _)⁻¹ = _
  rw [transpose_root, Matrix.SpecialLinearGroup.transvection_inv]

private theorem root_mem_parabolic (e : Fin 2) (i j : Fin 5) (hij : i ≠ j)
    (c : ZMod 2) (hlabel : label e i ≤ label e j) :
    Matrix.SpecialLinearGroup.transvection hij c ∈ parabolic e := by
  apply (mem_parabolic_iff e _).mpr
  intro r s hr hs
  exact Matrix.blockTriangular_transvection hlabel c ((label_lt_iff e r s).mpr ⟨hr, hs⟩)

private theorem root_mem_levi (e : Fin 2) (i j : Fin 5) (hij : i ≠ j)
    (c : ZMod 2) (hlabel : label e i = label e j) :
    Matrix.SpecialLinearGroup.transvection hij c ∈ leviSubgroup e := by
  refine ⟨root_mem_parabolic e i j hij c hlabel.le, ?_⟩
  refine ⟨graphSL 5 (Matrix.SpecialLinearGroup.transvection hij c), ?_, graph_involutive _⟩
  rw [graph_root]
  exact root_mem_parabolic e j i hij.symm (-c) hlabel.symm.le

private theorem root_mem_radicalImage (e : Fin 2) (i j : Fin 5) (hij : i ≠ j)
    (c : ZMod 2) (hlabel : label e i < label e j) :
    Matrix.SpecialLinearGroup.transvection hij c ∈ radicalImage e := by
  let g : parabolic e := ⟨Matrix.SpecialLinearGroup.transvection hij c,
    root_mem_parabolic e i j hij c hlabel.le⟩
  refine ⟨g, ?_, rfl⟩
  apply (QuotientGroup.eq_one_iff g).mp
  apply (quotientEquiv e).injective
  rw [map_one]
  apply Subtype.ext
  ext a b
  change (quotientEquiv e (QuotientGroup.mk' (radical e) g)).val a b =
    (1 : Matrix (Fin 4) (Fin 4) (ZMod 2)) a b
  rw [quotientEquiv_mk_val]
  have ha := (indexEquiv e a).property
  have hb := (indexEquiv e b).property
  have hne : ¬(includedCoordinate e a = i ∧ includedCoordinate e b = j) := by
    rintro ⟨hia, hjb⟩
    change label e (includedCoordinate e a) = largeBlock e at ha
    change label e (includedCoordinate e b) = largeBlock e at hb
    rw [hia] at ha
    rw [hjb] at hb
    exact (ne_of_lt hlabel) (ha.trans hb.symm)
  simp [g, Matrix.SpecialLinearGroup.transvection_coe, Matrix.single,
    Matrix.one_apply, (includedCoordinate_injective e).eq_iff]
  intro hia hjb
  exact (hne ⟨hia.symm, hjb.symm⟩).elim

/-- Positive roots split between the relative radical and the common Levi subgroup. -/
theorem upper_le_radicalImage_sup_leviSubgroup (e : Fin 2) :
    upper ≤ radicalImage e ⊔ leviSubgroup e := by
  change upperRootSubgroup ≤ _
  rw [upperRootSubgroup, Subgroup.closure_le]
  rintro g ⟨i, j, hij, rfl⟩
  rcases (label_monotone e hij.le).lt_or_eq with hlt | heq
  · exact (le_sup_left : radicalImage e ≤ radicalImage e ⊔ leviSubgroup e)
      (root_mem_radicalImage e i j (ne_of_lt hij) 1 hlt)
  · exact (le_sup_right : leviSubgroup e ≤ radicalImage e ⊔ leviSubgroup e)
      (root_mem_levi e i j (ne_of_lt hij) 1 heq)

private theorem graph_leviSubgroup (e : Fin 2) :
    (leviSubgroup e).map (graphSL 5).toMonoidHom = leviSubgroup e := by
  apply le_antisymm
  · rintro g ⟨x, hx, rfl⟩
    obtain ⟨y, hy, hyx⟩ := hx.2
    refine ⟨?_, Subgroup.mem_map_of_mem _ hx.1⟩
    change graphSL 5 x ∈ parabolic e
    change graphSL 5 y = x at hyx
    rw [← hyx, graph_involutive]
    exact hy
  · intro g hg
    refine ⟨graphSL 5 g, ?_, graph_involutive _⟩
    obtain ⟨y, hy, hyg⟩ := hg.2
    refine ⟨?_, Subgroup.mem_map_of_mem _ hg.1⟩
    change graphSL 5 g ∈ parabolic e
    change graphSL 5 y = g at hyg
    rw [← hyg, graph_involutive]
    exact hy

/-- Inverse transpose gives the opposite positive-root decomposition. -/
theorem lower_le_oppositeRadical_sup_leviSubgroup (e : Fin 2) :
    lower ≤ oppositeRadical e ⊔ leviSubgroup e := by
  have h := Subgroup.map_mono (f := (graphSL 5).toMonoidHom)
    (upper_le_radicalImage_sup_leviSubgroup e)
  rwa [Subgroup.map_sup, graph_leviSubgroup] at h

/-- Every element of the literal relative quotient has a representative in the Levi intersection. -/
theorem leviToQuotient_surjective (e : Fin 2) : Function.Surjective (leviToQuotient e) := by
  intro q
  let f := (quotientEquiv e).toMonoidHom.comp (leviToQuotient e)
  have hrange : ∀ g, g ∈ f.range := by
    intro g
    apply Matrix.SpecialLinearGroup.diagonal_transvection_induction' (fun g => g ∈ f.range) g
    · intro i j hij c hc
      have hc1 : c = 1 := (by decide : ∀ c : ZMod 2, c ≠ 0 → c = 1) c hc
      have hd : Matrix.SpecialLinearGroup.diag2n hij c hc = 1 := by
        apply Subtype.ext
        simp [Matrix.SpecialLinearGroup.diag2n_coe, hc1]
      rw [hd]
      exact f.range.one_mem
    · intro i j hij c
      let l : leviSubgroup e := ⟨(root e i j hij c).val,
        root_mem_levi e _ _ (fun h => hij (includedCoordinate_injective e h)) c
          ((indexEquiv e i).property.trans (indexEquiv e j).property.symm)⟩
      exact ⟨l, quotientEquiv_root e i j hij c⟩
    · intro a b ha hb
      exact f.range.mul_mem ha hb
  obtain ⟨l, hl⟩ := hrange (quotientEquiv e q)
  exact ⟨l, (quotientEquiv e).injective hl⟩

end CFSG.Quasithin.ChapterK.Linear.Recognition.BinaryCubicSieve.FiveDisplacement.Inner.EndNode.Levi.Irreducibility
